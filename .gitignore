# 1C:Enterprise Configuration Project
# Gitignore for BASERP25 XML Configuration

# System files
Thumbs.db
Desktop.ini
.DS_Store

# IDE and editor files
.vscode/
.idea/
*.sublime-*
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Logs
*.log

# 1C specific temporary files
*.ind
*.lock

# Build and cache directories
/build/
/cache/
/temp/

# Configuration database files (if present)
*.1CD
*.dt
*.cf

# Windows shortcuts
*.lnk

# Archives
*.zip
*.rar
*.7z
*.tar
*.gz

# Claude Desktop worktrees
.claude/

# Файлы обмена 1С (чтобы больше не попадали)
_Rarzrabotki/ExChange/**/*.xml

# Windows NUL device artifact
nul

# v8 project config — содержит пароли БД, не коммитим
.v8-project.json

# Сторонние репо склоновані всередину дерева — не комітимо у BASERP25
_Rarzrabotki/cc-1c-skills/

# Эталонные 1С-проекты с GitHub (research рабочих мест) — чужие .git, не комітимо
_Rarzrabotki/Рабочие места/GitHub/
__pycache__/
