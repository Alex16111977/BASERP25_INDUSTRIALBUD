КонецФункции

// Послуга для рядка «Приобретения» відсотків.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - «Відсотки за користування позикою» або порожня ссылка, якщо її немає.
//
Функция НоменклатураПроцентов() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ном.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Ном
	|ГДЕ
	|	Ном.Наименование = &Наименование
	|	И НЕ Ном.ЭтоГруппа
	|	И НЕ Ном.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ном.Ссылка";
	Запрос.УстановитьПараметр("Наименование", НаименованиеНоменклатурыПроцентов());

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Номенклатура.ПустаяСсылка();

КонецФункции

// Відсотки за період інтервалами (алгоритм — як РасчетЗаймовСотрудникам типової конфігурації, конвенція — як Excel):
// відсотки дня = залишок тіла на КІНЕЦЬ дня × ставка / 100 / БазаДнейВГоду(); день видачі рахується, день повернення — ні.
// Інтервал — максимальний відрізок суміжних днів з незмінними залишком і ставкою; дні з нульовим залишком пропускаються.
//
// Параметры:
//  ОстатокНаНачало - Число - залишок тіла на початок ДатаНачала.
//  Движения - ТаблицаЗначений - колонки Дата, Сумма (+ видача, − повернення) у межах періоду.
//  Ставки - ТаблицаЗначений - колонки Период, Ставка (%); перший рядок діє з ДатаНачала.
//  ДатаНачала - Дата - перший день періоду.
//  ДатаОкончания - Дата - останній день періоду.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ДатаНачала, ДатаОкончания, Дней, Остаток, Ставка, Сумма (Сумма без округлення).
//
Функция РассчитатьПроцентыПоИнтервалам(ОстатокНаНачало, Движения, Ставки, ДатаНачала, ДатаОкончания) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ДатаНачала", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Результат.Колонки.Добавить("ДатаОкончания", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Результат.Колонки.Добавить("Дней", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Остаток", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Ставка", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));

	СекундВДне = 86400;
	БазаГода = БазаДнейВГоду();
	День = НачалоДня(ДатаНачала);
	Конец = НачалоДня(ДатаОкончания);
	Интервал = Неопределено;

	Пока День <= Конец Цикл

		Остаток = ОстатокНаНачало;
		Для Каждого Движение Из Движения Цикл
			Если НачалоДня(Движение.Дата) <= День Тогда
				Остаток = Остаток + Движение.Сумма;
			КонецЕсли;
		КонецЦикла;
		Остаток = Окр(Остаток, 2);

		Ставка = 0;
		Для Каждого СтрокаСтавки Из Ставки Цикл
			Если НачалоДня(СтрокаСтавки.Период) <= День Или Ставка = 0 Тогда
				Ставка = СтрокаСтавки.Ставка;
			КонецЕсли;
		КонецЦикла;

		Если Интервал <> Неопределено
			И Интервал.Остаток = Остаток
			И Интервал.Ставка = Ставка
			И Интервал.ДатаОкончания = День - СекундВДне Тогда
			Интервал.ДатаОкончания = День;
			Интервал.Дней = Интервал.Дней + 1;
			Интервал.Сумма = Остаток * Ставка / 100 / БазаГода * Интервал.Дней;
		ИначеЕсли Остаток <> 0 Тогда
			Интервал = Результат.Добавить();
			Интервал.ДатаНачала = День;
			Интервал.ДатаОкончания = День;
			Интервал.Дней = 1;
			Интервал.Остаток = Остаток;
			Интервал.Ставка = Ставка;
			Интервал.Сумма = Остаток * Ставка / 100 / БазаГода;
		КонецЕсли;

		День = День + СекундВДне;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Виплати відсотків, що відносяться до місяця нарахування: документи місяця M+1 (виплати серпня — витрати липня).
// Беруться рядки розшифровки проведених непомічених РКО і списань по договорах з видом «Проценты».
//
// Параметры:
//  Организация - СправочникСсылка.Организации - організація.
//  МесяцНачисления - Дата - будь-яка дата місяця нарахування.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Договор, Документ, Дата, Сумма.
//
Функция ВыплатыПроцентов(Организация, МесяцНачисления) Экспорт

	Период = ПериодВыплат(МесяцНачисления);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Р.ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов) КАК Договор,
	|	Р.Ссылка КАК Документ,
	|	Р.Ссылка.Дата КАК Дата,
	|	СУММА(Р.Сумма) КАК Сумма
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер.РасшифровкаПлатежа КАК Р
	|ГДЕ
	|	Р.Ссылка.Проведен
	|	И НЕ Р.Ссылка.ПометкаУдаления
	|	И Р.Ссылка.Организация = &Организация
	|	И Р.Ссылка.Дата МЕЖДУ &НачалоВыплат И &КонецВыплат
	|	И ВЫРАЗИТЬ(Р.ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов).А_ВидКредитногоДоговора = ЗНАЧЕНИЕ(Перечисление.А_ВидыКредитныхДоговоров.Проценты)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Р.ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов),
	|	Р.Ссылка,
	|	Р.Ссылка.Дата
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Р.ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов),
	|	Р.Ссылка,
	|	Р.Ссылка.Дата,
	|	СУММА(Р.Сумма)
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК Р
	|ГДЕ
	|	Р.Ссылка.Проведен
	|	И НЕ Р.Ссылка.ПометкаУдаления
	|	И Р.Ссылка.Организация = &Организация
	|	И Р.Ссылка.Дата МЕЖДУ &НачалоВыплат И &КонецВыплат
	|	И ВЫРАЗИТЬ(Р.ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов).А_ВидКредитногоДоговора = ЗНАЧЕНИЕ(Перечисление.А_ВидыКредитныхДоговоров.Проценты)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Р.ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов),
	|	Р.Ссылка,
	|	Р.Ссылка.Дата";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоВыплат", Период.Начало);
	Запрос.УстановитьПараметр("КонецВыплат", Период.Конец);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Період виплат, що відносяться до місяця нарахування M: увесь місяць M+1 включно з межами
// (виплати серпня — витрати липня).
//
// Параметры:
//  МесяцНачисления - Дата - будь-яка дата місяця нарахування.
//
// Возвращаемое значение:
//  Структура - Начало (початок місяця M+1), Конец (кінець місяця M+1).
//
Функция ПериодВыплат(МесяцНачисления) Экспорт

	Начало = НачалоМесяца(КонецМесяца(МесяцНачисления) + 1);
	Возврат Новый Структура("Начало, Конец", Начало, КонецМесяца(Начало));

КонецФункции

// Тіло кредитів Воронцова за місяць по підрозділах-позичальниках (договори пар «ЦО → позичальник»,
// ключ — А_ПодразделениеОказаниеУслугПодразделению договору тіла).
//
// Параметры:
//  Организация - СправочникСсылка.Организации - організація.
//  МесяцНачисления - Дата - будь-яка дата місяця.
//
// Возвращаемое значение:
//  Структура - Остатки (ТаблицаЗначений: Контрагент, Подразделение, Остаток — на початок місяця),
//              Движения (ТаблицаЗначений: Контрагент, Подразделение, Дата, Сумма — по днях місяця).
//
Функция ДвиженияТелаКредитов(Организация, МесяцНачисления) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(МесяцНачисления));
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(МесяцНачисления));

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Ост.ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов).Контрагент КАК Контрагент,
	|	ВЫРАЗИТЬ(Ост.ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов).А_ПодразделениеОказаниеУслугПодразделению КАК Подразделение,
	|	СУММА(Ост.ПредоплатаРеглОстаток - Ост.ДолгРеглОстаток) КАК Остаток
	|ИЗ
	|	РегистрНакопления.РасчетыСПоставщикамиПоСрокам.Остатки(
	|			&НачалоПериода,
	|			ВЫРАЗИТЬ(ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов).А_ВидКредитногоДоговора = ЗНАЧЕНИЕ(Перечисление.А_ВидыКредитныхДоговоров.ТелоКредита)
	|				И ВЫРАЗИТЬ(ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов).Организация = &Организация) КАК Ост
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Ост.ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов).Контрагент,
	|	ВЫРАЗИТЬ(Ост.ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов).А_ПодразделениеОказаниеУслугПодразделению";
	Остатки = Запрос.Выполнить().Выгрузить();

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Об.ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов).Контрагент КАК Контрагент,
	|	ВЫРАЗИТЬ(Об.ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов).А_ПодразделениеОказаниеУслугПодразделению КАК Подразделение,
	|	НАЧАЛОПЕРИОДА(Об.Период, ДЕНЬ) КАК Дата,
	|	СУММА(Об.ПредоплатаРеглОборот - Об.ДолгРеглОборот) КАК Сумма
	|ИЗ
	|	РегистрНакопления.РасчетыСПоставщикамиПоСрокам.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			День,
	|			ВЫРАЗИТЬ(ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов).А_ВидКредитногоДоговора = ЗНАЧЕНИЕ(Перечисление.А_ВидыКредитныхДоговоров.ТелоКредита)
	|				И ВЫРАЗИТЬ(ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов).Организация = &Организация) КАК Об
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Об.ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов).Контрагент,
	|	ВЫРАЗИТЬ(Об.ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов).А_ПодразделениеОказаниеУслугПодразделению,
	|	НАЧАЛОПЕРИОДА(Об.Период, ДЕНЬ)
	|
	|ИМЕЮЩИЕ
	|	СУММА(Об.ПредоплатаРеглОборот - Об.ДолгРеглОборот) <> 0";
	Движения = Запрос.Выполнить().Выгрузить();

	Возврат Новый Структура("Остатки, Движения", Остатки, Движения);

КонецФункции

// Ставки договорів відсотків на місяць: зріз на початок місяця і зміни всередині місяця.
// Договір без запису на початок місяця отримує СтавкаПоУмолчанию() з початку місяця.
//
// Параметры:
//  Договоры - Массив - договори відсотків.
//  МесяцНачисления - Дата - будь-яка дата місяця.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Договор, Период, Ставка; впорядковано за договором і періодом.
//
Функция СтавкиДоговоров(Договоры, МесяцНачисления) Экспорт

	НачалоМесяца = НачалоМесяца(МесяцНачисления);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ср.Договор КАК Договор,
	|	&НачалоМесяца КАК Период,
	|	Ср.Ставка КАК Ставка
	|ИЗ
	|	РегистрСведений.А_ПроцентныеСтавкиКредитов.СрезПоследних(&НачалоМесяца, Договор В (&Договоры)) КАК Ср
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Ст.Договор,
	|	Ст.Период,
	|	Ст.Ставка
	|ИЗ
	|	РегистрСведений.А_ПроцентныеСтавкиКредитов КАК Ст
	|ГДЕ
	|	Ст.Договор В (&Договоры)
	|	И Ст.Период > &НачалоМесяца
	|	И Ст.Период <= &КонецМесяца
	|
	|УПОРЯДОЧИТЬ ПО
	|	Договор,
	|	Период";
	Запрос.УстановитьПараметр("Договоры", Договоры);
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца);
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца(НачалоМесяца));
	Результат = Запрос.Выполнить().Выгрузить();

	Для Каждого Договор Из Договоры Цикл
		Отбор = Новый Структура("Договор, Период", Договор, НачалоМесяца);
		Если Результат.НайтиСтроки(Отбор).Количество() = 0 Тогда
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Договор = Договор;
			НоваяСтрока.Период = НачалоМесяца;
			НоваяСтрока.Ставка = СтавкаПоУмолчанию();
		КонецЕсли;
	КонецЦикла;
	Результат.Сортировать("Договор, Период");

	Возврат Результат;

КонецФункции

// Виплати з позначкою «%%» у коментарі за місяць M+1, які не переоформлені на договір відсотків
// (без рядка розшифровки з договором виду «Проценты»; передачі між касами/рахунками не враховуються).
// Документ їх не змінює — лише попереджає: інакше витрата задвоїться.
//
// Параметры:
//  Организация - СправочникСсылка.Организации - організація.
//  МесяцНачисления - Дата - будь-яка дата місяця нарахування.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Документ, Дата, Подразделение, Сумма, Комментарий.
//
Функция НепереоформленныеВыплатыПроцентов(Организация, МесяцНачисления) Экспорт

	Период = ПериодВыплат(МесяцНачисления);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Документ,
	|	Д.Дата КАК Дата,
	|	Д.Подразделение КАК Подразделение,
	|	Д.СуммаДокумента КАК Сумма,
	|	ВЫРАЗИТЬ(Д.Комментарий КАК СТРОКА(500)) КАК Комментарий
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер КАК Д
	|ГДЕ
	|	Д.Проведен
	|	И НЕ Д.ПометкаУдаления
	|	И Д.Организация = &Организация
	|	И Д.Дата МЕЖДУ &НачалоВыплат И &КонецВыплат
	|	И Д.ХозяйственнаяОперация <> ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствВДругуюКассу)
	|	И ВЫРАЗИТЬ(Д.Комментарий КАК СТРОКА(500)) ПОДОБНО ""%~%~%%"" СПЕЦСИМВОЛ ""~""
	|	И НЕ Д.Ссылка В
	|				(ВЫБРАТЬ
	|					Р.Ссылка
	|				ИЗ
	|					Документ.РасходныйКассовыйОрдер.РасшифровкаПлатежа КАК Р
	|				ГДЕ
	|					ВЫРАЗИТЬ(Р.ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов).А_ВидКредитногоДоговора = ЗНАЧЕНИЕ(Перечисление.А_ВидыКредитныхДоговоров.Проценты))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Д.Ссылка,
	|	Д.Дата,
	|	Д.Подразделение,
	|	Д.СуммаДокумента,
	|	ВЫРАЗИТЬ(Д.Комментарий КАК СТРОКА(500))
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств КАК Д
	|ГДЕ
	|	Д.Проведен
	|	И НЕ Д.ПометкаУдаления
	|	И Д.Организация = &Организация
	|	И Д.Дата МЕЖДУ &НачалоВыплат И &КонецВыплат
	|	И Д.ХозяйственнаяОперация <> ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПеречислениеДенежныхСредствНаДругойСчет)
	|	И ВЫРАЗИТЬ(Д.Комментарий КАК СТРОКА(500)) ПОДОБНО ""%~%~%%"" СПЕЦСИМВОЛ ""~""
	|	И НЕ Д.Ссылка В
	|				(ВЫБРАТЬ
	|					Р.Ссылка
	|				ИЗ
	|					Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК Р
	|				ГДЕ
	|					ВЫРАЗИТЬ(Р.ОбъектРасчетов.Договор КАК Справочник.ДоговорыКонтрагентов).А_ВидКредитногоДоговора = ЗНАЧЕНИЕ(Перечисление.А_ВидыКредитныхДоговоров.Проценты))";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоВыплат", Период.Начало);
	Запрос.УстановитьПараметр("КонецВыплат", Период.Конец);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Перевіряє, чи договір уже нараховано за місяць іншим документом: непоміченим документом нарахування
// або проведеним непоміченим «Приобретением», створеним іншим документом (навіть поміченим на вилучення).
//
// Параметры:
//  Организация - СправочникСсылка.Организации - організація.
//  МесяцНачисления - Дата - будь-яка дата місяця.
//  Договор - СправочникСсылка.ДоговорыКонтрагентов - договір відсотків.
//  ИсключитьДокумент - ДокументСсылка.А_НачислениеПроцентовПоКредитам, Неопределено - поточний документ.
//
// Возвращаемое значение:
//  Строка - представлення конфліктного документа; "" — конфлікту немає.
//
Функция ЕстьДругоеНачисление(Организация, МесяцНачисления, Договор, ИсключитьДокумент) Экспорт

	НачалоМесяца = НачалоМесяца(МесяцНачисления);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПРЕДСТАВЛЕНИЕ(Н.Ссылка) КАК Документ
	|ИЗ
	|	Документ.А_НачислениеПроцентовПоКредитам.Начисления КАК Н
	|ГДЕ
	|	Н.Договор = &Договор
	|	И Н.Ссылка.Организация = &Организация
	|	И Н.Ссылка.МесяцНачисления = &НачалоМесяца
	|	И НЕ Н.Ссылка.ПометкаУдаления
	|	И Н.Ссылка <> &ИсключитьДокумент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПРЕДСТАВЛЕНИЕ(П.Ссылка)
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК П
	|ГДЕ
	|	П.Договор = &Договор
	|	И П.Организация = &Организация
	|	И П.Проведен
	|	И НЕ П.ПометкаУдаления
	|	И П.А_НачислениеПроцентовПоКредитам <> ЗНАЧЕНИЕ(Документ.А_НачислениеПроцентовПоКредитам.ПустаяСсылка)
	|	И П.А_НачислениеПроцентовПоКредитам <> &ИсключитьДокумент
	|	И П.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца";
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца);
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца(НачалоМесяца));
	Запрос.УстановитьПараметр("ИсключитьДокумент", ?(ЗначениеЗаполнено(ИсключитьДокумент), ИсключитьДокумент,
		Документы.А_НачислениеПроцентовПоКредитам.ПустаяСсылка()));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Документ;
	КонецЕсли;
	Возврат "";

КонецФункции

// Договори відсотків організації (контрагент — кредитор, підрозділ — позичальник).
//
// Параметры:
//  Организация - СправочникСсылка.Организации - організація.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Договор, Контрагент, Подразделение.
//
Функция ДоговорыПроцентов(Организация) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Дог.Ссылка КАК Договор,
	|	Дог.Контрагент КАК Контрагент,
	|	Дог.Подразделение КАК Подразделение
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Дог
	|ГДЕ
	|	Дог.А_ВидКредитногоДоговора = ЗНАЧЕНИЕ(Перечисление.А_ВидыКредитныхДоговоров.Проценты)
	|	И Дог.Организация = &Организация
	|	И НЕ Дог.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дог.Наименование";
	Запрос.УстановитьПараметр("Организация", Организация);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Дані для заповнення документа нарахування за місяць: рядок на кожен договір відсотків організації,
// де є сума за формулою або виплата в місяці M+1.
//
// Параметры:
//  Организация - СправочникСсылка.Организации - організація.
//  МесяцНачисления - Дата - будь-яка дата місяця.
//  СпособЗаполнения - ПеречислениеСсылка.А_СпособыРасчетаПроцентов - спосіб для рядків.
//
// Возвращаемое значение:
//  Структура - Начисления, Расшифровка (ТаблицаЗначений з колонками однойменних ТЧ документа), Предупреждения
//              (результат НепереоформленныеВыплатыПроцентов).
//
Функция ДанныеЗаполнения(Организация, МесяцНачисления, СпособЗаполнения) Экспорт

	Начало = НачалоМесяца(МесяцНачисления);
	Конец = КонецМесяца(Начало);

	Начисления = Новый ТаблицаЗначений;
	Для Каждого Колонка Из СтрРазделить("Договор,Контрагент,Подразделение,Ставка,ОстатокТела,СуммаПоФормуле,СуммаВыплат,СпособРасчета,СуммаКНачислению", ",") Цикл
		Начисления.Колонки.Добавить(Колонка);
	КонецЦикла;
	Расшифровка = Новый ТаблицаЗначений;
	Для Каждого Колонка Из СтрРазделить("Договор,ВидСтроки,ДатаНачала,ДатаОкончания,Дней,Остаток,Ставка,Сумма,ДокументОплаты", ",") Цикл
		Расшифровка.Колонки.Добавить(Колонка);
	КонецЦикла;

	Договоры = ДоговорыПроцентов(Организация);
	Выплаты = ВыплатыПроцентов(Организация, Начало);
	Тело = ДвиженияТелаКредитов(Организация, Начало);
	Ставки = СтавкиДоговоров(Договоры.ВыгрузитьКолонку("Договор"), Начало);

	Для Каждого Дог Из Договоры Цикл

		ОтборТела = Новый Структура("Контрагент, Подразделение", Дог.Контрагент, Дог.Подразделение);
		Остаток = 0;
		Для Каждого СтрокаОстатка Из Тело.Остатки.НайтиСтроки(ОтборТела) Цикл
			Остаток = Остаток + СтрокаОстатка.Остаток;
		КонецЦикла;
		Движения = Тело.Движения.Скопировать(ОтборТела, "Дата, Сумма");
		СтавкиДоговора = Ставки.Скопировать(Новый Структура("Договор", Дог.Договор), "Период, Ставка");

		Интервалы = РассчитатьПроцентыПоИнтервалам(Остаток, Движения, СтавкиДоговора, Начало, Конец);
		СуммаПоФормуле = Окр(Интервалы.Итог("Сумма"), 2);
		ВыплатыДоговора = Выплаты.НайтиСтроки(Новый Структура("Договор", Дог.Договор));
		СуммаВыплат = 0;
		Для Каждого Выплата Из ВыплатыДоговора Цикл
			СуммаВыплат = СуммаВыплат + Выплата.Сумма;
		КонецЦикла;
		Если СуммаПоФормуле = 0 И СуммаВыплат = 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Начисления.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Дог);
		НоваяСтрока.Ставка = СтавкиДоговора[СтавкиДоговора.Количество() - 1].Ставка;
		НоваяСтрока.ОстатокТела = Остаток + Движения.Итог("Сумма");
		НоваяСтрока.СуммаПоФормуле = СуммаПоФормуле;
		НоваяСтрока.СуммаВыплат = СуммаВыплат;
		НоваяСтрока.СпособРасчета = СпособЗаполнения;
		НоваяСтрока.СуммаКНачислению = ?(СпособЗаполнения = Перечисления.А_СпособыРасчетаПроцентов.ПоВыплате,
			СуммаВыплат, СуммаПоФормуле);

		Для Каждого Интервал Из Интервалы Цикл
			СтрокаРасшифровки = Расшифровка.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРасшифровки, Интервал);
			СтрокаРасшифровки.Договор = Дог.Договор;
			СтрокаРасшифровки.ВидСтроки = "Інтервал";
			СтрокаРасшифровки.Сумма = Окр(Интервал.Сумма, 2);
		КонецЦикла;
		Для Каждого Выплата Из ВыплатыДоговора Цикл
			СтрокаРасшифровки = Расшифровка.Добавить();
			СтрокаРасшифровки.Договор = Дог.Договор;
			СтрокаРасшифровки.ВидСтроки = "Виплата";
			СтрокаРасшифровки.ДатаНачала = НачалоДня(Выплата.Дата);
			СтрокаРасшифровки.Сумма = Выплата.Сумма;
			СтрокаРасшифровки.ДокументОплаты = Выплата.Документ;
		КонецЦикла;

	КонецЦикла;

	Возврат Новый Структура("Начисления, Расшифровка, Предупреждения",
		Начисления, Расшифровка, НепереоформленныеВыплатыПроцентов(Организация, Начало));

КонецФункции

// Значення реквізитів «Приобретения» для рядка нарахування (шапка і рядок послуги).
// Невидимі поля — за _Rarzrabotki/notebook/knowledge/document_hidden_fields.md (ПриобретениеТоваровУслуг):
// А_ВведенВЕРП/А_Обработан (інакше обмін перезапише Товары), Курс = Кратность = 1 (інакше взаєморозрахунки = 0),
// ВалютаВзаиморасчетов = Валюта, ГруппаФинансовогоУчета з договору, ставка ПДВ «Без ПДВ». Зразок полів — ОУМП.
//
// Параметры:
//  ДокументНачисления - ДокументОбъект.А_НачислениеПроцентовПоКредитам - документ-розрахунок.
//  СтрокаНачисления - СтрокаТабличнойЧасти - рядок ТЧ «Начисления».
//
// Возвращаемое значение:
//  Структура - Шапка (Структура реквізитів ПТУ), Товар (Структура реквізитів рядка «Товары»).
//
Функция ПараметрыПриобретения(ДокументНачисления, СтрокаНачисления) Экспорт

	Договор = СтрокаНачисления.Договор;
	Сумма = СтрокаНачисления.СуммаКНачислению;
	Валюта = ?(ЗначениеЗаполнено(Договор.ВалютаВзаиморасчетов), Договор.ВалютаВзаиморасчетов,
		Справочники.Валюты.НайтиПоКоду("980"));
	Месяц = НачалоМесяца(ДокументНачисления.МесяцНачисления);

	Шапка = Новый Структура;
	Шапка.Вставить("А_ВведенВЕРП", Истина);
	Шапка.Вставить("А_Обработан", Истина);
	Шапка.Вставить("А_Необновлять", Истина);
	Шапка.Вставить("Дата", КонецМесяца(Месяц));
	Шапка.Вставить("Организация", ДокументНачисления.Организация);
	Шапка.Вставить("Контрагент", Договор.Контрагент);
	Шапка.Вставить("Партнер", Договор.Партнер);
	Шапка.Вставить("Договор", Договор);
	Шапка.Вставить("Валюта", Валюта);
	Шапка.Вставить("ВалютаВзаиморасчетов", Валюта);
	Шапка.Вставить("Подразделение", Договор.Подразделение);
	Шапка.Вставить("ПорядокРасчетов", Договор.ПорядокРасчетов);
	Шапка.Вставить("ГруппаФинансовогоУчета", Договор.ГруппаФинансовогоУчета);
	Шапка.Вставить("НаправлениеДеятельности", Договор.НаправлениеДеятельности);
	Шапка.Вставить("НалогообложениеНДС", Договор.НалогообложениеНДС);
	Шапка.Вставить("ХозяйственнаяОперация", Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика);
	Шапка.Вставить("ЦенаВключаетНДС", Истина);
	Шапка.Вставить("ВариантПриемкиТоваров", Перечисления.ВариантыПриемкиТоваров.РазделенаТолькоПоНакладным);
	Шапка.Вставить("СпособДоставки", Перечисления.СпособыДоставки.СиламиПоставщикаДоНашегоСклада);
	Шапка.Вставить("Курс", 1);
	Шапка.Вставить("Кратность", 1);
	Шапка.Вставить("СуммаДокумента", Сумма);
	Шапка.Вставить("СуммаВзаиморасчетов", Сумма);
	Шапка.Вставить("ФормаОплаты", Перечисления.ФормыОплаты.Наличная);
	Шапка.Вставить("А_НачислениеПроцентовПоКредитам", ДокументНачисления.Ссылка);
	Шапка.Вставить("Комментарий", СтрШаблон("Відсотки за %1 (%2 № %3)", Формат(Месяц, "ДФ='MMMM yyyy'; Л=uk_UA"),
		"Нарахування відсотків", ДокументНачисления.Номер));

	Товар = Новый Структура;
	Товар.Вставить("Номенклатура", НоменклатураПроцентов());
	Товар.Вставить("Количество", 1);
	Товар.Вставить("КоличествоУпаковок", 1);
	Товар.Вставить("Цена", Сумма);
	Товар.Вставить("Сумма", Сумма);
	Товар.Вставить("СуммаСНДС", Сумма);
	Товар.Вставить("СуммаВзаиморасчетов", Сумма);
	Товар.Вставить("СтавкаНДС", НДСКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.БезНДС));
	Товар.Вставить("СуммаНДС", 0);
	Товар.Вставить("КодСтроки", 1);
	Товар.Вставить("Подразделение", Договор.Подразделение);
	Товар.Вставить("СписатьНаРасходы", Истина);
	Товар.Вставить("СтатьяРасходов", СтатьяРасходовПроцентов());

	Возврат Новый Структура("Шапка, Товар", Шапка, Товар);

КонецФункции

// Найменування послуги відсотків.
//
// Возвращаемое значение:
//  Строка - найменування.
//
Функция НаименованиеНоменклатурыПроцентов() Экспорт

	Возврат "Відсотки за користування позикою";

КонецФункции

#КонецОбласти
