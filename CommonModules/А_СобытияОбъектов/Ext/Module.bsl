Процедура А_ДоработкаСправочникиПередЗаписью(Источник, Отказ) Экспорт
	
	Если ТипЗнч(Источник)=Тип("СправочникОбъект.ДоговорыКонтрагентов") Тогда
		
		ДоговорыКонтрагентовПередЗаписью(Источник, Отказ);
		
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.Номенклатура") Тогда
		
		НоменклатураПередЗаписью(Источник, Отказ);
		
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.СтатьиДвиженияДенежныхСредств") Тогда
		
		СтатьиДвиженияДенежныхСредствПередЗаписью(Источник, Отказ);  
		
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.Сотрудники") Тогда
		
		СотрудникиПередЗаписью(Источник, Отказ);
    ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.Склады") Тогда
		
		СкладыПередЗаписью(Источник, Отказ);  
		
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.Кассы") Тогда
		
		КассыПередЗаписью(Источник, Отказ);  
		
    ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.БанковскиеСчетаОрганизаций") Тогда
		
		БанковскиеСчетаОрганизацийПередЗаписью(Источник, Отказ); 
		
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.Партнеры") Тогда
		
		ПартнерыПередЗаписью(Источник, Отказ);   
		
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.Контрагенты") Тогда
		
		КонтрагентыПередЗаписью(Источник, Отказ);
		
	ИначеЕсли ТипЗнч(Источник)=Тип("ПланВидовХарактеристикОбъект.СтатьиРасходов") Тогда
		
		СтатьиРасходовПередЗаписью(Источник, Отказ);

	КонецЕсли; 
	
КонецПроцедуры
 
 Процедура ПартнерыПередЗаписью(Источник, Отказ) Экспорт
	 
	 Если ЗначениеЗаполнено(Источник.А_Подразделение) Тогда
		 Источник.Наименование = СокрЛП(Источник.А_Подразделение);
		 Источник.НаименованиеПолное = СокрЛП(Источник.А_Подразделение);
	 КонецЕсли;	      
	 
	 Если ЗначениеЗаполнено(Источник.ЮрФизЛицо) Тогда
		 Источник.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
	 КонецЕсли;	      

КонецПроцедуры

Процедура КонтрагентыПередЗаписью(Источник, Отказ) Экспорт
	
	 Если Источник.ЭтоГруппа Тогда
	  
	  	 Возврат;
	  
	 КонецЕсли; 
	Если ЗначениеЗаполнено(Источник.ВариантРаспределенияРасходовРегл) Тогда
		Источник.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
	КонецЕсли;	      
	
	Если ЗначениеЗаполнено(Источник.ЮридическоеФизическоеЛицо) Тогда
		Источник.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
	КонецЕсли;	      
	
КонецПроцедуры

Процедура СтатьиРасходовПередЗаписью(Источник, Отказ) Экспорт	
	
	 Если Источник.ЭтоГруппа Тогда
	  
	  	 Возврат;
	  
	 КонецЕсли; 
	Если Источник.ВариантРаспределенияРасходовРегл=Перечисления.ВариантыРаспределенияРасходов.НаРасходыБудущихПериодов
		И НЕ ЗначениеЗаполнено(Источник.А_СтатьяРасходовДляРасходовБудущегоПериода) Тогда
		Источник.А_СтатьяРасходовДляРасходовБудущегоПериода = ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоКоду("0Ц-000026"); //Услуги сторонних организаций
	КонецЕсли;	   
	
КонецПроцедуры
  

Процедура БанковскиеСчетаОрганизацийПередЗаписью(Источник, Отказ) Экспорт
	 
      

КонецПроцедуры

Процедура КассыПередЗаписью(Источник, Отказ) Экспорт
	  Если Источник.ЭтоГруппа Тогда
	  
	  	 Возврат;
	  
	 КонецЕсли; 
	 
	  РазрешитьПлатежиБезУказанияЗаявок = Истина;
	  
		Если ЗначениеЗаполнено(Источник.А_ПодразделениеКазна) 
		И ЗначениеЗаполнено(Источник.А_НаправлениеДеятельности)
		 Тогда
		
		
	Источник.Подразделение =  А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны(Источник.А_НаправлениеДеятельности,Источник.А_ПодразделениеКазна); 		
	КонецЕсли;	      

КонецПроцедуры



 
Процедура СкладыПередЗаписью(Источник, Отказ) Экспорт
	
	Если НЕ Источник.ЭтоГруппа
		И ЗначениеЗаполнено(Источник.А_ПодразделениеПринудительно)
		 Тогда
		
		Источник.Подразделение = Источник.А_ПодразделениеПринудительно;
		
	КонецЕсли;	      

КонецПроцедуры


Процедура СтатьиДвиженияДенежныхСредствПередЗаписью(Источник, Отказ) Экспорт
	
	Если ЗначениеЗаполнено(Источник.Родитель)
		И ЗначениеЗаполнено(Источник.Родитель.А_ТипПоказателя) Тогда
		
		Источник.А_ТипПоказателя = Источник.Родитель.А_ТипПоказателя;
		
	КонецЕсли;	      

КонецПроцедуры


Процедура СотрудникиПередЗаписью(Источник, Отказ) Экспорт
	
	Если НЕ (Источник.ЭтоГруппа) Тогда
		
		Источник.А_КодПоДРФО = Источник.ФизическоеЛицо.КодПоДРФО;
		
	КонецЕсли;	      

КонецПроцедуры


Процедура НоменклатураПередЗаписью(Источник, Отказ) Экспорт
	
	Если ЗначениеЗаполнено(Источник.ВидНоменклатуры)
		И ЗначениеЗаполнено(Источник.ВидНоменклатуры.ГруппаФинансовогоУчета) Тогда
		
		Источник.ГруппаФинансовогоУчета = Источник.ВидНоменклатуры.ГруппаФинансовогоУчета;
		
	КонецЕсли;	      

КонецПроцедуры


Процедура ДоговорыКонтрагентовПередЗаписью(Источник, Отказ) Экспорт
	
	Источник.ВариантОформленияЗакупок = Перечисления.ВариантыОформленияЗакупок.НеРазделять;
	Источник.ХозяйственнаяОперация = Справочники.ДоговорыКонтрагентов.ХозяйственнаяОперация(Источник.ТипДоговора,Источник.ВариантОформленияЗакупок);
	
	Если Источник.А_НеОбновлятьГруппаФинансовогоУчета Тогда
		Возврат;
	КонецЕсли;
	
	ТипДоговора = Источник.ТипДоговора;
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	ЭтоНацВалюта = (Источник.ВалютаВзаиморасчетов = ВалютаРегУчета);
	
	ИмяГруппы = "";
	
	Если ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем Тогда
		ИмяГруппы = ?(ЭтоНацВалюта, 
		"Расчеты с покупателями в национальной валюте",
		"Расчеты с покупателями в иностранной валюте");
		
	ИначеЕсли ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком
		ИЛИ ТипДоговора = Перечисления.ТипыДоговоров.Импорт Тогда
		ИмяГруппы = ?(ЭтоНацВалюта,
		"Расчеты с поставщиками в национальной валюте",
		"Расчеты с поставщиками в иностранной валюте");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяГруппы) Тогда
		ГруппаФинансовогоУчета = Справочники.ГруппыФинансовогоУчетаРасчетов.НайтиПоНаименованию(ИмяГруппы);
		Если ЗначениеЗаполнено(ГруппаФинансовогоУчета) 
			И НЕ ЗначениеЗаполнено(Источник.ГруппаФинансовогоУчета)  Тогда
			Источник.ГруппаФинансовогоУчета = ГруппаФинансовогоУчета;
		КонецЕсли;
	КонецЕсли;
	
	
	Если ЗначениеЗаполнено(Источник.А_Подразделение) И ЗначениеЗаполнено(Источник.А_НаправлениеДеятельности) Тогда
		
		Источник.Подразделение =  А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны(Источник.А_НаправлениеДеятельности,Источник.А_Подразделение); 	
		
	КонецЕсли;

	Если ЗначениеЗаполнено(Источник.А_ПодразделениеБанк) И ЗначениеЗаполнено(Источник.А_НаправлениеДеятельностиБанк) Тогда
		
		Источник.Подразделение =  А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны(Источник.А_НаправлениеДеятельностиБанк,Источник.А_ПодразделениеБанк); 	
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Источник.Партнер.А_Подразделение)
		И ЗначениеЗаполнено(Источник.А_ПодразделениеОказаниеУслугПодразделению) И ЗначениеЗаполнено(Источник.А_СтатьяДвиженияДенежныхСредствОказаниеУслугПодразделению) Тогда
		
		Источник.Наименование = СокрЛП(Источник.А_ПодразделениеОказаниеУслугПодразделению)+"-->"+СокрЛП(Источник.А_СтатьяДвиженияДенежныхСредствОказаниеУслугПодразделению)+"("+СокрЛП(Источник.ТипДоговора)+")";
		Источник.СтатьяДвиженияДенежныхСредств = Источник.А_СтатьяДвиженияДенежныхСредствОказаниеУслугПодразделению;
	КонецЕсли;   
	
КонецПроцедуры

Процедура А_ПроверкаНаРазрешенияПроведенияВУчете(Источник,РежимЗаписи) Экспорт

	 Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
		Если НЕ ТипЗнч(Источник)=Тип("ДокументОбъект.ЗаказПоставщику") Тогда
			
			Если ЗначениеЗаполнено(Источник.Организация)
				И НачалоДня(Источник.Дата)<НачалоДня(Источник.Организация.А_ДатаНачалоВеденияУчета)Тогда
				
				РежимЗаписи = РежимЗаписиДокумента.Запись;
				   
			КонецЕсли;	
			
		КонецЕсли;   
		
		
		Если ЗначениеЗаполнено(Источник.Организация)
			И НЕ Источник.Организация.А_ВБалансе Тогда
			
			РежимЗаписи = РежимЗаписиДокумента.Запись;
			
		КонецЕсли;	
		
		
		ДоступныеРеквизиты = Источник.Метаданные().Реквизиты;
		Если ДоступныеРеквизиты.Найти("А_ОрганизацияБухгалтерия") <> Неопределено Тогда
			
			Если ЗначениеЗаполнено(Источник.А_ОрганизацияБухгалтерия)
				И НЕ Источник.А_ОрганизацияБухгалтерия.А_ВБалансе Тогда
				
				РежимЗаписи = РежимЗаписиДокумента.Запись;
				
			КонецЕсли;	
		КонецЕсли;
		
		
		Если    ТипЗнч(Источник)=Тип("ДокументОбъект.ПриобретениеТоваровУслуг")
			ИЛИ ТипЗнч(Источник)=Тип("ДокументОбъект.СписаниеНедостачТоваров") 
			ИЛИ ТипЗнч(Источник)=Тип("ДокументОбъект.ВнутреннееПотреблениеТоваров")
			ИЛИ ТипЗнч(Источник)=Тип("ДокументОбъект.СборкаТоваров")
			Тогда
			Если ЗначениеЗаполнено(Источник.Склад)
				И Источник.Склад.А_ЭтоОбмен Тогда
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			КонецЕсли;	
		ИначеЕсли    ТипЗнч(Источник)=Тип("ДокументОбъект.ПриобретениеУслугПрочихАктивов") Тогда
			Если Источник.Расходы.Количество()>0 Тогда
				ДокументПартии = Источник.Расходы[0].АналитикаРасходов;	  
				Если ЗначениеЗаполнено(ДокументПартии) 
					И ТипЗнч(ДокументПартии) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
					
					Если ЗначениеЗаполнено(ДокументПартии.Склад)
						И ДокументПартии.Склад.А_ЭтоОбмен Тогда
						РежимЗаписи = РежимЗаписиДокумента.Запись;
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;  
		
		Если    ТипЗнч(Источник)=Тип("ДокументОбъект.ПринятиеКУчетуОС")
			Тогда
			Если ЗначениеЗаполнено(Источник.А_Склад)
				И Источник.А_Склад.А_ЭтоОбмен Тогда
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			КонецЕсли;	
		КонецЕсли; 
		
		Если ТипЗнч(Источник)=Тип("ДокументОбъект.ПриходныйКассовыйОрдер")
			ИЛИ ТипЗнч(Источник)=Тип("ДокументОбъект.РасходныйКассовыйОрдер") Тогда
			
			Если  ЗначениеЗаполнено(Источник.Касса)
				И ЗначениеЗаполнено(Источник.Касса.А_НаправлениеДеятельности)
				И НЕ Источник.Касса.А_НаправлениеДеятельности.А_ИспользоватьНаправлениеПроводитьВУчете
				Тогда
				
				РежимЗаписи = РежимЗаписиДокумента.Запись;	
				
			КонецЕсли;
			
		КонецЕсли;
		
		ПроверкаПодразделенияВДокументеНаСовпадение(Источник);
КонецПроцедуры

Процедура А_ДоработкаДокументыПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
			
	А_ПроверкаНаРазрешенияПроведенияВУчете(Источник,РежимЗаписи);
	
	Если ТипЗнч(Источник)=Тип("ДокументОбъект.ЗаказПоставщику") Тогда
		
		ЗаказПоставщику_ПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения);
	ИначеЕсли ТипЗнч(Источник)=Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") Тогда
		
		СписаниеБезналичныхДенежныхСредств_ПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения);
		
	ИначеЕсли ТипЗнч(Источник)=Тип("ДокументОбъект.ПриходныйКассовыйОрдер") Тогда
		
		ПриходныйКассовыйОрдер_ПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения);
		
	ИначеЕсли ТипЗнч(Источник)=Тип("ДокументОбъект.РасходныйКассовыйОрдер") Тогда
		
		РасходныйКассовыйОрдер_ПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения);
		
	ИначеЕсли ТипЗнч(Источник)=Тип("ДокументОбъект.ПриобретениеТоваровУслуг") Тогда
		
		ПриобретениеТоваровУслуг_ПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения);

	КонецЕсли; 
	
КонецПроцедуры

Процедура А_ДоработкаСправочникиПриЗаписи(Источник, Отказ) Экспорт
	
	Если ТипЗнч(Источник)=Тип("СправочникОбъект.ФизическиеЛица") Тогда
		
		ФизическиеЛицаПриЗаписи(Источник, Отказ);  
		
		ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.Склады") Тогда
		
		СкладыПриЗаписи(Источник, Отказ); 
		
		ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.СтруктураПредприятия") Тогда
		
		СтруктураПредприятияПриЗаписи(Источник, Отказ);
		ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.БанковскиеСчетаОрганизаций") Тогда
		
		БанковскиеСчетаОрганизацийПриЗаписи(Источник, Отказ); 
		ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.Кассы") Тогда
		
		КассыПриЗаписи(Источник, Отказ);
        ИначеЕсли ТипЗнч(Источник)=Тип("ПланВидовХарактеристикОбъект.СтатьиРасходов") Тогда
		
		СтатьиРасходовПриЗаписи(Источник, Отказ);   
		
	КонецЕсли; 
	              
КонецПроцедуры

 
Процедура СтатьиРасходовПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если  ЗначениеЗаполнено(Источник.А_СтатьяДвиженияДенежныхСредств) 
		 Тогда
		
	Спр = Источник.А_СтатьяДвиженияДенежныхСредств.ПолучитьОбъект();	
	Спр.А_СтатьяРасходов = Источник.Ссылка;  
	Спр.ОбменДанными.Загрузка = Истина;
	Спр.Записать();
	КонецЕсли;	

КонецПроцедуры

 
Процедура КассыПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ВалютаДенежныхСредств = Константы.ВалютаРегламентированногоУчета.Получить() Тогда
		СчетУчета = ПланыСчетов.Хозрасчетный.КассаВНациональнойВалюте;	
	Иначе       
		СчетУчета = ПланыСчетов.Хозрасчетный.КассаВИностраннойВалюте;
	КонецЕсли;
	
	
	
	// Проверка существования записи 
	МенеджерЗаписи = РегистрыСведений.ПорядокОтраженияНаСчетахУчета.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ВидСчета = Перечисления.ВидыСчетовРеглУчета.ДенежныеСредства;
	МенеджерЗаписи.Организация = Справочники.Организации.ПустаяСсылка();
	МенеджерЗаписи.АналитикаУчета = Источник.Ссылка;
	МенеджерЗаписи.МестоУчета = Неопределено;
	МенеджерЗаписи.Прочитать();
	
