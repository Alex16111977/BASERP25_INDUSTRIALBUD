		ДоговорыКонтрагентовПередЗаписью(Источник, Отказ);
		
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.Номенклатура") Тогда
		
		НоменклатураПередЗаписью(Источник, Отказ);
		
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.СтатьиДвиженияДенежныхСредств") Тогда
		
		СтатьиДвиженияДенежныхСредствПередЗаписью(Источник, Отказ);  
		
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.Сотрудники") Тогда
		
		СотрудникиПередЗаписью(Источник, Отказ);
    ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.Склады") Тогда
		
		СкладыПередЗаписью(Источник, Отказ);
