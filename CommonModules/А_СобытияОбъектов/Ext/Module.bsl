Процедура ДоговорыКонтрагентовПриЗаписи(Источник, Отказ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Договор",Источник.Ссылка);
	Запрос.УстановитьПараметр("Подразделение",Источник.Подразделение);

	Запрос.Текст = "ВЫБРАТЬ
	               |	ОбъектыРасчетов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
	               |ГДЕ
	               |	ОбъектыРасчетов.Договор = &Договор
	               |	И ОбъектыРасчетов.Подразделение <> &Подразделение";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Спр = Выборка.Ссылка.ПолучитьОбъект();	
		Спр.Подразделение = Источник.Подразделение;
		Спр.Записать();
		
	КонецЦикла;
	
	
КонецПроцедуры




