Процедура ОбновитьПодразделениеПоВнутригрупповомуДоговору(ЗаказСсылка) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ИменаРеквизитов = Новый Структура;
	ИменаРеквизитов.Вставить("ПодразделениеЗаказа",   "Подразделение");
	ИменаРеквизитов.Вставить("ПодразделениеДоговора", "Договор.Подразделение");
	ИменаРеквизитов.Вставить("ЭтоВнутригрупповое",    "Договор.Подразделение.А_ЭтоВнутригрупповое");
	
	Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаказСсылка, ИменаРеквизитов);
	
	Если Данные.ЭтоВнутригрупповое = Истина
		И Данные.ПодразделениеЗаказа <> Данные.ПодразделениеДоговора Тогда
		
		ДокОбъект = ЗаказСсылка.ПолучитьОбъект();
		ДокОбъект.Подразделение = Данные.ПодразделениеДоговора;
		ДокОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриобретениеТоваровУслуг_ПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	
	ОбновитьПодразделениеПоВнутригрупповомуДоговору(Источник.ЗаказПоставщику);
	  
	// 1. Установка подразделения из ЗаказаПоставщику или из Договора
	//    (кроме закупки через подотчётное лицо)
	Если ЗначениеЗаполнено(Источник.Договор)
		И ЗначениеЗаполнено(Источник.Договор.Подразделение)
		И Источник.ХозяйственнаяОперация <> Перечисления.ХозяйственныеОперации.ЗакупкаЧерезПодотчетноеЛицо Тогда
		
	
		Если ЗначениеЗаполнено(Источник.ЗаказПоставщику) Тогда
			Источник.Подразделение = Источник.ЗаказПоставщику.Подразделение;
			ИсточникЗначения       = Источник.ЗаказПоставщику;
		Иначе
			Источник.Подразделение = Источник.Договор.Подразделение;
			ИсточникЗначения       = Источник.Договор;
		КонецЕсли;

		//ТекстСообщения = СтрШаблон(
		//	"В "+СокрЛП(Источник.Ссылка)+" Подразделение установлено из %1 = %2",
		//	СокрЛП(ИсточникЗначения),
		//	СокрЛП(Источник.Подразделение));
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Источник, "Подразделение");
         КонецЕсли;


	// 2. Принудительная статья ДДС из договора + проставление статьи расходов
	//    в строки списания на расходы
	Если ЗначениеЗаполнено(Источник.Договор)
		И ЗначениеЗаполнено(Источник.Договор.А_СтатьяДвиженияДенежныхСредствОснавнаяПринудительно) Тогда

		СтатьяДДС = Источник.Договор.А_СтатьяДвиженияДенежныхСредствОснавнаяПринудительно;
		Источник.А_СтатьяДвиженияДенежныхСредств = СтатьяДДС;

		//ТекстСообщения = СтрШаблон(
		//	"В "+СокрЛП(Источник.Ссылка)+" Принудительно статья денег и затрат установлена из %1 = %2",
		//	СокрЛП(Источник.Договор),
		//	СокрЛП(СтатьяДДС));
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Источник, "А_СтатьяДвиженияДенежныхСредств");

		СтатьяРасходов = СтатьяДДС.А_СтатьяРасходов;
		Для Каждого СтрокаТЗ Из Источник.Товары Цикл
			Если СтрокаТЗ.СписатьНаРасходы Тогда
				СтрокаТЗ.СтатьяРасходов = СтатьяРасходов;
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;  
	
	Если Источник.А_Распределение.Количество()=0 
		и Источник.А_Услуги.Количество()>0 Тогда
		
		Для каждого СтрокаТабличнойЧасти Из Источник.Товары Цикл
			СтрокаТабличнойЧасти.Подразделение 	=Источник.Подразделение;		
			
		КонецЦикла; 
	КонецЕсли;

КонецПроцедуры

	
 Процедура СписаниеБезналичныхДенежныхСредств_ПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	 
	 Источник.ПроведеноБанком	    = Истина;
	 Источник.ДатаПроведенияБанком	= Источник.Дата; 
	 
	 Если  ЗначениеЗаполнено(Источник.А_ОрганизацияБухгалтерия) Тогда
		 
		 Если  Источник.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыПоЗарплатномуПроекту
			 ИЛИ Источник.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СнятиеНаличныхДенежныхСредств
			 Тогда
			 
			 Источник.Подразделение = Источник.А_ОрганизацияБухгалтерия.А_ПодразделениеЗарплатаБух; 
			 
		 ИначеЕсли Источник.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеречислениеВБюджет  Тогда
			 
			 Если Источник.А_СчетУчетаБухгалтерия = Планысчетов.Хозрасчетный.РасчетыПоНДФЛ //6411   
				 ИЛИ Источник.А_СчетУчетаБухгалтерия = Планысчетов.Хозрасчетный.РасчетыПоОбязательнымПлатежам //642
				 ИЛИ Источник.А_СчетУчетаБухгалтерия = Планысчетов.Хозрасчетный.РасчетыПоПенсионномуОбеспечению //651
				 Тогда			 
				 Источник.Подразделение = Источник.А_ОрганизацияБухгалтерия.А_ПодразделениеЗарплатаБух; 
			 КонецЕсли; 
			 
		 КонецЕсли; 
		 
	 КонецЕсли;

 КонецПроцедуры
 
  	
 Процедура ПоступлениеБезналичныхДенежныхСредств_ПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	 
