 Процедура ПроверкаПодразделенияВДокументеНаСовпадение(Источник) Экспорт

	Если Не (
		ТипЗнч(Источник) = Тип("ДокументОбъект.ПриходныйКассовыйОрдер")
		Или ТипЗнч(Источник) = Тип("ДокументОбъект.РасходныйКассовыйОрдер")
		Или ТипЗнч(Источник) = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств")
		Или ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств")
	) Тогда
		Возврат;
	КонецЕсли;

	Источник.А_НеСовпадаетПодразделение = Ложь;
	Источник.А_НеСовпадаетНаправление = Ложь;

   
	Для каждого СтрокаТЗ Из Источник.РасшифровкаПлатежа Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТЗ.ОбъектРасчетов)
			Или Не ЗначениеЗаполнено(СтрокаТЗ.ОбъектРасчетов.Договор) Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаТЗ.ОбъектРасчетов.Договор.Подразделение <> Источник.Подразделение Тогда
			Источник.А_НеСовпадаетПодразделение = Истина;
		КонецЕсли;
		
		Если СтрокаТЗ.ОбъектРасчетов.Договор.Подразделение.А_НаправлениеДеятельности <> Источник.Подразделение.А_НаправлениеДеятельности Тогда
			Источник.А_НеСовпадаетНаправление = Истина;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

 Процедура СписаниеБезналичныхДенежныхСредств_ПриЗаписи(Источник, Отказ) Экспорт
	 
	// Возврат;   
	 
	Если Источник.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеречислениеДенежныхСредствНаДругойСчет 
		 Тогда    
		
		А_Привилегированный.СоздатьПоступлениеБезналичныхДенежныхСредствПоСписаниеБезналичныхДенежныхСредств(Источник.Ссылка);   
		
	ИначеЕсли Источник.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СнятиеНаличныхДенежныхСредств Тогда  
		
       А_Привилегированный.А_СоздатьПриходныйКассовыйОрдерПоСписаниеБезналичныхДенежныхСредств(Источник.Ссылка); 
	   
	ИначеЕсли Источник.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыПоЗарплатномуПроекту Тогда
		Если Источник.ОбменДанными.Загрузка Тогда
			Возврат;
		КонецЕсли;
		Если  Источник.проведен Тогда

			Для каждого СтрокаТЗ Из Источник.РасшифровкаПлатежа Цикл

				Если НЕ ЗначениеЗаполнено(СтрокаТЗ.Ведомость) Тогда
					Продолжить;
				КонецЕсли;
				ДокВедомость=СтрокаТЗ.Ведомость.ПолучитьОбъект();
				Если ДокВедомость = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ДокВедомость.УстановитьПометкуУдаления(Ложь);
				ДокВедомость.Записать(РежимЗаписиДокумента.Проведение);

			КонецЦикла;
		Иначе
			Для каждого СтрокаТЗ Из Источник.РасшифровкаПлатежа Цикл

				Если НЕ ЗначениеЗаполнено(СтрокаТЗ.Ведомость) Тогда
					Продолжить;
				КонецЕсли;
				ДокВедомость=СтрокаТЗ.Ведомость.ПолучитьОбъект();
				Если ДокВедомость = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ДокВедомость.Записать(РежимЗаписиДокумента.ОтменаПроведения);

			КонецЦикла;
		КонецЕсли; 
	ИначеЕсли Источник.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику
		И Источник.Проведен Тогда
        Для каждого СтрокаТЗ Из Источник.РасшифровкаПлатежа Цикл
			Если ЗначениеЗаполнено(СтрокаТЗ.ОбъектРасчетов)
				И ТипЗнч(СтрокаТЗ.ОбъектРасчетов.Объект) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			 
			 ДокЗаказ = СтрокаТЗ.ОбъектРасчетов.Объект.ПолучитьОбъект();	
			 ДокЗаказ.А_СтатьяДвиженияДенежныхСредств = СтрокаТЗ.СтатьяДвиженияДенежныхСредств; 
			 Если ЗначениеЗаполнено(СтрокаТЗ.А_Договор) Тогда
			    ДокЗаказ.А_ДоговорИзБанка = СтрокаТЗ.А_Договор;  
				ДокЗаказ.Договор          = СтрокаТЗ.А_Договор; 
			 КонецЕсли; 
			 ДокЗаказ.ОбменДанными.Загрузка = Истина;
			 ДокЗаказ.Записать();
			 КонецЕсли;
			
		
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Источник.А_ФинАгент) Тогда
	 СоздатьДокументОказаниеУслугМеждуПодразделениямиПоРаспределению(Источник);
	КонецЕсли;
   	
 КонецПроцедуры
 
 
 
  Процедура ПринятиеКУчетуОС_ПриЗаписи(Источник, Отказ) Экспорт
	 
 
		
		А_Привилегированный.СоздатьВнутреннееПотреблениеТоваров_По_ПринятиеКУчетуОС(Источник.Ссылка);   
		
	   	
КонецПроцедуры

 Процедура СоздатьДокументОказаниеУслугМеждуПодразделениямиПоРаспределению(Источник) Экспорт
 
	 Если Источник.Проведен И Источник.А_Распределение.Количество()>0 Тогда
		 ДенежныйДокумент = Источник.Ссылка;
		 ЗапросСуществующая = Новый Запрос;
		 ЗапросСуществующая.УстановитьПараметр("ДенежныйДокумент",ДенежныйДокумент);
		 ЗапросСуществующая.Текст =  "ВЫБРАТЬ
		                             |	А_ОказаниеУслугМеждуПодразделениями.Ссылка КАК Ссылка,
		                             |	А_ОказаниеУслугМеждуПодразделениями.Проведен КАК Проведен,
		                             |	А_ОказаниеУслугМеждуПодразделениями.ПометкаУдаления КАК ПометкаУдаления
		                             |ИЗ
		                             |	Документ.А_ОказаниеУслугМеждуПодразделениями КАК А_ОказаниеУслугМеждуПодразделениями
		                             |ГДЕ
		                             |	А_ОказаниеУслугМеждуПодразделениями.ДенежныйДокумент = &ДенежныйДокумент";
		 РезультатСуществующая = ЗапросСуществующая.Выполнить();
		 ЭтоОбновлениеДокумента= НЕ РезультатСуществующая.Пустой();
		 
		 Если ЭтоОбновлениеДокумента Тогда
			 ВыборкаСуществующая = РезультатСуществующая.Выбрать();
			 ВыборкаСуществующая.Следующий();
			 ДокОказаниеУслугМеждуПодразделениями = ВыборкаСуществующая.Ссылка.ПолучитьОбъект();
			 Если ВыборкаСуществующая.Проведен Тогда
				 ДокОказаниеУслугМеждуПодразделениями.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			 КонецЕсли;
			 Если ВыборкаСуществующая.ПометкаУдаления Тогда
				 ДокОказаниеУслугМеждуПодразделениями.УстановитьПометкуУдаления(Ложь);
			 КонецЕсли;
			 ДокОказаниеУслугМеждуПодразделениями.А_Распределение.Очистить();
		 Иначе
			 ДокОказаниеУслугМеждуПодразделениями = Документы.А_ОказаниеУслугМеждуПодразделениями.СоздатьДокумент();
		 КонецЕсли;      
		 
		 ДокОказаниеУслугМеждуПодразделениями.Дата = Источник.Дата;
		 ДокОказаниеУслугМеждуПодразделениями.Организация = Источник.Организация;
		 ДокОказаниеУслугМеждуПодразделениями.ДенежныйДокумент = ДенежныйДокумент;
		 ДокОказаниеУслугМеждуПодразделениями.А_Обработан = Ложь;
		 ДокОказаниеУслугМеждуПодразделениями.А_Распределение.Загрузить(ДенежныйДокумент.А_Распределение.Выгрузить());
		 
		 Комментарий = СокрЛП(Источник.Контрагент); 
		 ДоступныеРеквизиты = Источник.Метаданные().Реквизиты;
		 Если ДоступныеРеквизиты.Найти("НазначениеПлатежа") <> Неопределено Тогда
			 Комментарий = Комментарий + " "+ СокрЛП(Источник.НазначениеПлатежа);	
		 КонецЕсли;
		 ДокОказаниеУслугМеждуПодразделениями.Комментарий = Комментарий;
		 ДокОказаниеУслугМеждуПодразделениями.Записать(РежимЗаписиДокумента.Проведение);
		 

	 КонецЕсли;
 
 КонецПроцедуры
 
 Процедура  ОбновитьАвансовыйОтчетПослеОбмена(АвансовыйОтчетСсылка) Экспорт

	//Если АвансовыйОтчетСсылка.А_Обработан Тогда
	//	Возврат;
	//КонецЕсли; 
	
	АвансовыйОтчетОбъект = АвансовыйОтчетСсылка.ПолучитьОбъект();
	//АвансовыйОтчетОбъект.ОбменДанными.Загрузка = Истина;
	
	ЗапросПриобретениеТоваровУслуг = Новый Запрос;
	ЗапросПриобретениеТоваровУслуг.УстановитьПараметр("ДокументОснование",АвансовыйОтчетСсылка);
	ЗапросПриобретениеТоваровУслуг.Текст =   "ВЫБРАТЬ
	|	ПриобретениеТоваровУслуг.Ссылка
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
	|ГДЕ
	|	ПриобретениеТоваровУслуг.А_АвансовыйОтчет = &ДокументОснование";
	
	
	Выборка = ЗапросПриобретениеТоваровУслуг.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокПриобретениеТоваровУслуг = Выборка.Ссылка.ПолучитьОбъект(); 
		ДокПриобретениеТоваровУслуг.УстановитьПометкуУдаления(Истина);
	КонецЦикла;

	Если  АвансовыйОтчетСсылка.А_Товары.Количество()=0 
		ИЛИ НЕ АвансовыйОтчетСсылка.Проведен 
		
		Тогда
	 Возврат;	
	КонецЕсли; 
	
	
	// 3. Групування по Контрагент + ДоговорКонтрагента
	ТаблицаТоваров = АвансовыйОтчетСсылка.А_Товары.Выгрузить();;

	// Отримати унікальні комбінації Контрагент + Договор
	ТаблицаГрупп = ТаблицаТоваров.Скопировать(, "Контрагент, ДоговорКонтрагента");
	ТаблицаГрупп.Свернуть("Контрагент, ДоговорКонтрагента");


	КоличествоСозданных = 0;

	// 4. Цикл створення документів
	Для Каждого ГруппаТоваров Из ТаблицаГрупп Цикл

		Попытка
			// Фільтрація рядків для поточної групи
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Контрагент", ГруппаТоваров.Контрагент);
			СтруктураОтбора.Вставить("ДоговорКонтрагента", ГруппаТоваров.ДоговорКонтрагента);

			НайденныеСтроки = ТаблицаТоваров.НайтиСтроки(СтруктураОтбора);

			Если НайденныеСтроки.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;

			// Створення нового документа
			
			
			ЗапросПриобретениеТоваровУслуг = Новый Запрос;
			ЗапросПриобретениеТоваровУслуг.УстановитьПараметр("ДокументОснование",АвансовыйОтчетСсылка);
			ЗапросПриобретениеТоваровУслуг.УстановитьПараметр("Контрагент",ГруппаТоваров.Контрагент);
			ЗапросПриобретениеТоваровУслуг.УстановитьПараметр("Договор",ГруппаТоваров.ДоговорКонтрагента);
			
			
			ЗапросПриобретениеТоваровУслуг.Текст =   "ВЫБРАТЬ
			|	ПриобретениеТоваровУслуг.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
			|ГДЕ
			|	ПриобретениеТоваровУслуг.А_АвансовыйОтчет = &ДокументОснование
			|	И ПриобретениеТоваровУслуг.Контрагент = &Контрагент
			|	И ПриобретениеТоваровУслуг.Договор = &Договор";
			
			
			Выборка = ЗапросПриобретениеТоваровУслуг.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				НовыйДокумент = Выборка.Ссылка.ПолучитьОбъект(); 
				НовыйДокумент.УстановитьПометкуУдаления(Ложь); 
			Иначе
				НовыйДокумент = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
			КонецЕсли;
	
	
			// Заповнення шапки
			НовыйДокумент.Дата = АвансовыйОтчетОбъект.Дата;
			НовыйДокумент.Организация = АвансовыйОтчетОбъект.Организация;
			НовыйДокумент.А_ОрганизацияБухгалтерия = АвансовыйОтчетОбъект.А_ОрганизацияБухгалтерия;
			НовыйДокумент.Контрагент = ГруппаТоваров.Контрагент;
			НовыйДокумент.Договор = ГруппаТоваров.ДоговорКонтрагента;
			НовыйДокумент.Склад = АвансовыйОтчетОбъект.А_Склад;
			НовыйДокумент.НаправлениеДеятельности = АвансовыйОтчетОбъект.А_НаправлениеДеятельности;
			НовыйДокумент.А_НаправлениеДеятельности = АвансовыйОтчетОбъект.А_НаправлениеДеятельности;
			НовыйДокумент.А_Подразделение = АвансовыйОтчетОбъект.А_Подразделение;
			НовыйДокумент.Подразделение = АвансовыйОтчетОбъект.Подразделение;
			НовыйДокумент.АвансовыйОтчет = АвансовыйОтчетСсылка;
			НовыйДокумент.Валюта = АвансовыйОтчетОбъект.Валюта;    
			НовыйДокумент.ВалютаВзаиморасчетов = АвансовыйОтчетОбъект.Валюта; 
			НовыйДокумент.ЦенаВключаетНДС = АвансовыйОтчетОбъект.ЦенаВключаетНДС;
			НовыйДокумент.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаЧерезПодотчетноеЛицо;
            НовыйДокумент.А_ВведенВЕРП = Истина;
			НовыйДокумент.А_АвансовыйОтчет = АвансовыйОтчетСсылка;  
			НовыйДокумент.ПодотчетноеЛицо  = АвансовыйОтчетОбъект.ПодотчетноеЛицо;
			НовыйДокумент.Партнер = ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(ГруппаТоваров.Контрагент);
            НовыйДокумент.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаТолькоПоНакладным;
			НовыйДокумент.СпособДоставки        = Перечисления.СпособыДоставки.СиламиПоставщикаДоНашегоСклада;
			
			НовыйДокумент.Курс = 1; 
			НовыйДокумент.Кратность = 1; 
			
			// Номер і дата вхідного документа з першого рядка групи
			ПервыйРядок = НайденныеСтроки[0];
			НовыйДокумент.НомерВходящегоДокумента = ПервыйРядок.НомерВходящегоДокумента;
			НовыйДокумент.ДатаВходящегоДокумента = ПервыйРядок.ДатаВходящегоДокумента;
            НовыйДокумент.Товары.Очистить();
			СуммаДокумента = 0;
             // Счетчик для КодСтроки
	КодСтроки = 0;

            // Получаем склад из шапки документа для заполнения строк
	СкладИзШапки = НовыйДокумент.Склад;

			// Заповнення табличної частини Товары
			Для Каждого СтрокаТовара Из НайденныеСтроки Цикл
                 КодСтроки = КодСтроки + 1;

				НоваяСтрока = НовыйДокумент.Товары.Добавить();
				НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура;
				НоваяСтрока.Упаковка = СтрокаТовара.ЕдиницаИзмерения;
				НоваяСтрока.КоличествоУпаковок = СтрокаТовара.Количество;

				// Количество = Количество * Коэффициент
				Коэффициент = ?(СтрокаТовара.Коэффициент = 0, 1, СтрокаТовара.Коэффициент);
				НоваяСтрока.Количество = СтрокаТовара.Количество * Коэффициент;

				НоваяСтрока.Цена = СтрокаТовара.Цена;
				НоваяСтрока.Сумма = СтрокаТовара.Сумма;

				// Перетворення СтавкаНДС: Перечисление -> Справочник  
				Если НовыйДокумент.Контрагент.ПлательщикНДС Тогда
				 НоваяСтрока.СтавкаНДС = НДСКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(СтрокаТовара.СтавкаНДС);
				Иначе	
				 НоваяСтрока.СтавкаНДС = НДСКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НеНДС);
				КонецЕсли;
				

				НоваяСтрока.СуммаНДС = СтрокаТовара.СуммаНДС;
				
				// === Расчетные поля сумм с учетом ЦенаВключаетНДС ===
		Если НовыйДокумент.ЦенаВключаетНДС Тогда
			// Цена включает НДС: Сумма в источнике = СуммаСНДС (сумма с НДС)
			НоваяСтрока.СуммаСНДС = СтрокаТовара.Сумма;
		Иначе
			// Цена без НДС: Сумма в источнике = сумма без НДС
			НоваяСтрока.СуммаСНДС = СтрокаТовара.Сумма + СтрокаТовара.СуммаНДС;
		КонецЕсли;
		
				НоваяСтрока.НалоговоеНазначение = СтрокаТовара.НалоговоеНазначение;

				СуммаДокумента = СуммаДокумента + СтрокаТовара.Сумма + СтрокаТовара.СуммаНДС;
				
				
				НоваяСтрока.СуммаВзаиморасчетов = НоваяСтрока.СуммаСНДС;
		

		// === Склад из шапки документа ===
		НоваяСтрока.Склад = СкладИзШапки;

		// === ИдентификаторСтроки - генерируем новый GUID ===
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);

		// === КодСтроки - автоинкремент ===
		НоваяСтрока.КодСтроки = КодСтроки;


			КонецЦикла;

			// Встановлення суми документа
			НовыйДокумент.СуммаДокумента = СуммаДокумента;

			// Запис документа  проведення      
			Если АвансовыйОтчетСсылка.Проведен Тогда
			 НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			Иначе	
			 НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			

			КоличествоСозданных = КоличествоСозданных + 1;

			// Виведення повідомлення про створений документ
			Сообщить("Створено документ: " + НовыйДокумент.Ссылка + " для контрагента: " + ГруппаТоваров.Контрагент);

		Исключение
			Сообщить("Помилка при створенні документа для " + ГруппаТоваров.Контрагент + ": " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

	КонецЦикла;

	//АвансовыйОтчетОбъект.А_Обработан = Истина;
	//АвансовыйОтчетОбъект.Записать();    
	
КонецПроцедуры

Процедура АвансовыйОтчет_ПриЗаписи(Источник, Отказ) Экспорт

    ОбновитьАвансовыйОтчетПослеОбмена(Источник.Ссылка);	
	
КонецПроцедуры
 
Процедура ПоступлениеБезналичныхДенежныхСредств_ПриЗаписи(Источник, Отказ) Экспорт

	Если Источник.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеДенежныхСредствСДругогоСчета 
		 Тогда    
		
		А_Привилегированный.СоздатьСписаниеБезналичныхДенежныхСредствПоПоступлениеБезналичныхДенежныхСредств(Источник.Ссылка);   
		
			
	КонецЕсли;
	
	СоздатьДокументОказаниеУслугМеждуПодразделениямиПоРаспределению(Источник);
 КонецПроцедуры
 
 Процедура РасходныйКассовыйОрдер_ПриЗаписи(Источник, Отказ) Экспорт

	СоздатьДокументОказаниеУслугМеждуПодразделениямиПоРаспределению(Источник); 
	
	Если Источник.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыЧерезКассу Тогда
		
		Если ЗначениеЗаполнено(Источник.Ведомость) Тогда
			
			Если Источник.Ведомость.А_Необновлять <> Источник.Проведен Тогда
				
				ДокВедомость = Источник.Ведомость.ПолучитьОбъект();
				ДокВедомость.ОбменДанными.Загрузка = Истина;
				ДокВедомость.А_Необновлять = Источник.Проведен;
				ДокВедомость.Записать();	
				
				Если ЗначениеЗаполнено(Источник.Ведомость.А_РаспределениеФ2) Тогда
					
					ДокРаспределениеФ2 = Источник.Ведомость.А_РаспределениеФ2.ПолучитьОбъект();
					ДокРаспределениеФ2.ОбменДанными.Загрузка = Истина;
					ДокРаспределениеФ2.Закрытый = Источник.Проведен;
					ДокРаспределениеФ2.А_Необновлять = Источник.Проведен;
					ДокРаспределениеФ2.Записать();	
					
				КонецЕсли;  
				
			КонецЕсли;
			
			
		КонецЕсли;	
	
	КонецЕсли;
	
 КонецПроцедуры

Процедура А_ДоработкаДокументыПриЗаписи(Источник, Отказ) Экспорт
	
	// Возврат;
	Если ТипЗнч(Источник)=Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") Тогда
		 
		СписаниеБезналичныхДенежныхСредств_ПриЗаписи(Источник, Отказ);
		
	ИначеЕсли ТипЗнч(Источник)=Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств") Тогда
		 
		ПоступлениеБезналичныхДенежныхСредств_ПриЗаписи(Источник, Отказ);
	ИначеЕсли ТипЗнч(Источник)=Тип("ДокументОбъект.РасходныйКассовыйОрдер") Тогда
		 
		РасходныйКассовыйОрдер_ПриЗаписи(Источник, Отказ);

	ИначеЕсли ТипЗнч(Источник)=Тип("ДокументОбъект.АвансовыйОтчет") Тогда
		 
		АвансовыйОтчет_ПриЗаписи(Источник, Отказ);
	
    ИначеЕсли ТипЗнч(Источник)=Тип("ДокументОбъект.ПринятиеКУчетуОС") Тогда
		 
		ПринятиеКУчетуОС_ПриЗаписи(Источник, Отказ);

	КонецЕсли; 

 КонецПроцедуры


