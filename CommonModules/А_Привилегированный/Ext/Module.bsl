// Параметры:
//   ТЗ - ТаблицаЗначений - исходная таблица
//   ИмяПоля - Строка - имя колонки для проверки
//   ОператорСравнения - Строка - "=", "<>", ">", "<", ">=", "<="
//   Значение - Произвольный - значение для сравнения
//
// Возвращает: ТаблицаЗначений - очищенная таблица
//       

//// Удалить где Сумма = 0
//А_ОчиститьТЗ_ПоУсловию(ТЗ, "Сумма", "=", 0);

//// Удалить где Количество <= 0
//А_ОчиститьТЗ_ПоУсловию(ТЗ, "Количество", "<=", 0);

//// Удалить пустые ссылки
//А_ОчиститьТЗ_ПоУсловию(ТЗ, "Номенклатура", "=", Справочники.Номенклатура.ПустаяСсылка());

Функция А_ОчиститьТЗ_ПоУсловию(ТЗ, ИмяПоля, ОператорСравнения = "=", Значение = 0) Экспорт
    
    Сч = 0;
    Пока Сч < ТЗ.Количество() Цикл
        СтрокаТаблицы = ТЗ.Получить(Сч);
        ЗначениеПоля = СтрокаТаблицы[ИмяПоля];
        
        УдалитьСтроку = Ложь;
        
        Если ОператорСравнения = "=" Тогда
            УдалитьСтроку = (ЗначениеПоля = Значение);
        ИначеЕсли ОператорСравнения = "<>" Тогда
            УдалитьСтроку = (ЗначениеПоля <> Значение);
        ИначеЕсли ОператорСравнения = ">" Тогда
            УдалитьСтроку = (ЗначениеПоля > Значение);
        ИначеЕсли ОператорСравнения = "<" Тогда
            УдалитьСтроку = (ЗначениеПоля < Значение);
        ИначеЕсли ОператорСравнения = ">=" Тогда
            УдалитьСтроку = (ЗначениеПоля >= Значение);
        ИначеЕсли ОператорСравнения = "<=" Тогда
            УдалитьСтроку = (ЗначениеПоля <= Значение);
        КонецЕсли;
        
        Если УдалитьСтроку Тогда
            ТЗ.Удалить(СтрокаТаблицы);
        Иначе
            Сч = Сч + 1;
        КонецЕсли;
    КонецЦикла;
    
    Возврат ТЗ;
    
КонецФункции


// Створює/оновлює елемент Справочник.Партнеры (+ Контрагент при першому створенні)
// для підрозділу СтруктураПредприятия. Підтримує ієрархію (рекурсивно створює батьків).
// Викликається з підписки СтруктураПредприятияПриЗаписи — при перейменуванні підрозділу
// одночасно оновлюється Наименование відповідного Партнера.
//
// Параметри:
//   ПодразделениеСсылка - СправочникСсылка.СтруктураПредприятия
//
// Повертає: СправочникСсылка.Партнеры
Функция ОбеспечитьПартнераПоПодразделению(ПодразделениеСсылка) Экспорт

	Если НЕ ЗначениеЗаполнено(ПодразделениеСсылка) Тогда
		Возврат Справочники.Партнеры.ПустаяСсылка();
	КонецЕсли;

	// Корнева група партнерів-підрозділів
	ГруппаПідрозділи = Справочники.Партнеры.НайтиПоКоду("0Ц-00000011");

	// === Один запит — отримати все потрібне за раз (без lazy-load) ===
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Подр.Родитель      КАК РодительПодразделения,
	|	Подр.Наименование  КАК НаименованиеПодразделения,
	|	ЕСТЬNULL(Партн.Ссылка, ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка))   КАК СуществующаяСсылка,
	|	ЕСТЬNULL(Партн.Родитель, ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)) КАК СуществующийРодитель,
	|	ЕСТЬNULL(Партн.Наименование, """")    КАК СуществующееНаименование
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК Подр
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партн
	|		ПО Партн.А_Подразделение = Подр.Ссылка
	|ГДЕ
	|	Подр.Ссылка = &Подразделение";
	Запрос.УстановитьПараметр("Подразделение", ПодразделениеСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Справочники.Партнеры.ПустаяСсылка();
	КонецЕсли;

	// === Рекурсивно отримати/створити батька ===
	РодительПартнера = ГруппаПідрозділи;
	Если ЗначениеЗаполнено(Выборка.РодительПодразделения) Тогда
		РодительПартнера = ОбеспечитьПартнераПоПодразделению(Выборка.РодительПодразделения);
	КонецЕсли;

	НаименованиеПодразделения = Выборка.НаименованиеПодразделения;

	// === Гілка 1: партнер ВЖЕ існує — оновити при потребі ===
	Если ЗначениеЗаполнено(Выборка.СуществующаяСсылка) Тогда
		ПотрібноОновити = (Выборка.СуществующийРодитель    <> РодительПартнера)
		               ИЛИ (Выборка.СуществующееНаименование <> НаименованиеПодразделения);

		Если ПотрібноОновити Тогда
			ПартнерОбъект = Выборка.СуществующаяСсылка.ПолучитьОбъект();
			Если ПартнерОбъект <> Неопределено Тогда
				ПартнерОбъект.Заблокировать();
				ПартнерОбъект.Родитель           = РодительПартнера;
				ПартнерОбъект.Наименование       = НаименованиеПодразделения;
				ПартнерОбъект.НаименованиеПолное = НаименованиеПодразделения;
				ПартнерОбъект.Записать();
			КонецЕсли;
		КонецЕсли;

		Возврат Выборка.СуществующаяСсылка;
	КонецЕсли;

	// === Гілка 2: партнер відсутній — створити (+ контрагент при першому створенні) ===
	НовыйПартнер = Справочники.Партнеры.СоздатьЭлемент();
	НовыйПартнер.Наименование       = НаименованиеПодразделения;
	НовыйПартнер.НаименованиеПолное  = НаименованиеПодразделения;
	НовыйПартнер.Родитель            = РодительПартнера;
	НовыйПартнер.А_Подразделение     = ПодразделениеСсылка;
	НовыйПартнер.Клиент              = Истина;
	НовыйПартнер.Поставщик           = Истина;
	НовыйПартнер.ПрочиеОтношения     = Истина;
	НовыйПартнер.ЮрФизЛицо           = Перечисления.КомпанияЧастноеЛицо.Компания;
	НовыйПартнер.Записать();

	НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
	НовыйКонтрагент.Наименование       = НаименованиеПодразделения;
	НовыйКонтрагент.НаименованиеПолное = НаименованиеПодразделения;
	НовыйКонтрагент.Партнер            = НовыйПартнер.Ссылка;
	НовыйКонтрагент.ЮрФизЛицо          = Перечисления.ЮрФизЛицо.ЮрЛицо;
	НовыйКонтрагент.Записать();

	Возврат НовыйПартнер.Ссылка;

КонецФункции

// Возвращает РЕАЛЬНОГО партнёра для контрагента (никогда не "Неизвестный"/пустой).
// Используется и обработкой замены, и обработчиком записи контрагента (Часть A — профилактика обмена).
// Приоритет: 0) текущий реальный партнёр контрагента 1) партнёр головного контрагента
//            2) партнёр-тёзка по наименованию 3) партнёр контрагента с тем же ЕДРПОУ/налоговым
//            4) создать зеркального партнёра по данным контрагента.
//
// Параметры:
//   КонтрагентСсылка - СправочникСсылка.Контрагенты - ссылка (может быть пустой/новой)
//   Реквизиты - Структура - НЕОБЯЗАТЕЛЬНО, in-memory реквизиты (для нового контрагента в ПередЗаписью):
//       Наименование, НаименованиеПолное, ЮрФизЛицо, КодПоЕДРПОУ, НалоговыйНомер, ГоловнойКонтрагент, Партнер
//   Создавать - Булево - создавать ли зеркального партнёра, если не нашли (Истина — полный автомат)
//
// Возвращаемое значение:
//   СправочникСсылка.Партнеры - реальный партнёр, либо ПустаяСсылка если Создавать=Ложь и не найден.
Функция ОбеспечитьРеальногоПартнераПоКонтрагенту(КонтрагентСсылка, Реквизиты = Неопределено, Создавать = Истина) Экспорт

	Неизв = Справочники.Партнеры.НеизвестныйПартнер;

	Если Реквизиты = Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(КонтрагентСсылка) Тогда
			Возврат ?(Создавать, Неизв, Справочники.Партнеры.ПустаяСсылка());
		КонецЕсли;
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КонтрагентСсылка,
			"Наименование,НаименованиеПолное,ЮрФизЛицо,КодПоЕДРПОУ,НалоговыйНомер,ГоловнойКонтрагент,Партнер");
	КонецЕсли;

	// 0. Текущий партнёр контрагента уже реальный
	Если А_ЭтоРеальныйПартнер(Реквизиты.Партнер, Неизв) Тогда
		Возврат Реквизиты.Партнер;
	КонецЕсли;

	// 1. Партнёр головного контрагента
	Если ЗначениеЗаполнено(Реквизиты.ГоловнойКонтрагент) Тогда
		ПартнерГоловного = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реквизиты.ГоловнойКонтрагент, "Партнер");
		Если А_ЭтоРеальныйПартнер(ПартнерГоловного, Неизв) Тогда
			Возврат ПартнерГоловного;
		КонецЕсли;
	КонецЕсли;

	// 2. Партнёр-тёзка по наименованию
	Если ЗначениеЗаполнено(Реквизиты.Наименование) Тогда
		Тезка = Справочники.Партнеры.НайтиПоНаименованию(Реквизиты.Наименование, Истина);
		Если А_ЭтоРеальныйПартнер(Тезка, Неизв) Тогда
			Возврат Тезка;
		КонецЕсли;
	КонецЕсли;

	// 3. Партнёр другого контрагента с тем же ЕДРПОУ/налоговым номером
	Кандидат = А_НайтиПартнераПоНалоговым(КонтрагентСсылка, Реквизиты, Неизв);
	Если А_ЭтоРеальныйПартнер(Кандидат, Неизв) Тогда
		Возврат Кандидат;
	КонецЕсли;

	Если НЕ Создавать Тогда
		Возврат Справочники.Партнеры.ПустаяСсылка();
	КонецЕсли;

	// 4. Создать зеркального партнёра
	НовыйПартнер = Справочники.Партнеры.СоздатьЭлемент();
	НовыйПартнер.Наименование      = Реквизиты.Наименование;
	НовыйПартнер.НаименованиеПолное = ?(ЗначениеЗаполнено(Реквизиты.НаименованиеПолное),
	                                    Реквизиты.НаименованиеПолное, Реквизиты.Наименование);
	Если Реквизиты.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо
		ИЛИ Реквизиты.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель Тогда
		НовыйПартнер.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
	Иначе
		НовыйПартнер.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
	КонецЕсли;
	НовыйПартнер.Клиент          = Истина;
	НовыйПартнер.Поставщик       = Истина;
	НовыйПартнер.ПрочиеОтношения = Истина;
	НовыйПартнер.Записать();

	Возврат НовыйПартнер.Ссылка;

КонецФункции

Функция А_ЭтоРеальныйПартнер(Партнер, Неизв) Экспорт
	Возврат ЗначениеЗаполнено(Партнер) И Партнер <> Неизв
		И НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Партнер, "ПометкаУдаления");
КонецФункции

Функция А_НайтиПартнераПоНалоговым(КонтрагентСсылка, Реквизиты, Неизв)
	Если НЕ ЗначениеЗаполнено(Реквизиты.КодПоЕДРПОУ) И НЕ ЗначениеЗаполнено(Реквизиты.НалоговыйНомер) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	К.Партнер КАК Партнер
	|ИЗ
	|	Справочник.Контрагенты КАК К
	|ГДЕ
	|	К.Ссылка <> &Контрагент
	|	И К.Партнер <> &Неизв
	|	И НЕ К.Партнер.ПометкаУдаления
	|	И ((К.КодПоЕДРПОУ = &ЕДРПОУ И &ЕстьЕДРПОУ) ИЛИ (К.НалоговыйНомер = &НН И &ЕстьНН))";
	Запрос.УстановитьПараметр("Контрагент", ?(ЗначениеЗаполнено(КонтрагентСсылка), КонтрагентСсылка, Справочники.Контрагенты.ПустаяСсылка()));
	Запрос.УстановитьПараметр("Неизв", Неизв);
	Запрос.УстановитьПараметр("ЕДРПОУ", Реквизиты.КодПоЕДРПОУ);
	Запрос.УстановитьПараметр("ЕстьЕДРПОУ", ЗначениеЗаполнено(Реквизиты.КодПоЕДРПОУ));
	Запрос.УстановитьПараметр("НН", Реквизиты.НалоговыйНомер);
	Запрос.УстановитьПараметр("ЕстьНН", ЗначениеЗаполнено(Реквизиты.НалоговыйНомер));
	Выб = Запрос.Выполнить().Выбрать();
	Возврат ?(Выб.Следующий(), Выб.Партнер, Неопределено);
КонецФункции


// Створює/оновлює елемент Справочник.ПодразделенияОрганизаций для управлінської організації
// (А_ПолучитьОрганизациюУпр), прив'язаний до підрозділу СтруктураПредприятия через А_Подразделение.
// Підтримує ієрархію — рекурсивно створює батьків.
//
// Параметри:
//   ПодразделениеСсылка - СправочникСсылка.СтруктураПредприятия
//
// Повертає: СправочникСсылка.ПодразделенияОрганизаций
Функция ОбеспечитьПодразделенияОрганизацийПоПодразделению(ПодразделениеСсылка) Экспорт

	Если НЕ ЗначениеЗаполнено(ПодразделениеСсылка) Тогда
		Возврат Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
	КонецЕсли;

	ОрганизацияВладелец = А_ПолучитьОрганизациюУпр();
	Если НЕ ЗначениеЗаполнено(ОрганизацияВладелец) Тогда
		Возврат Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
	КонецЕсли;

	// === Один запит — отримати все потрібне за раз (без lazy-load) ===
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Подр.Родитель      КАК РодительПодразделения,
	|	Подр.Наименование  КАК НаименованиеПодразделения,
	|	ЕСТЬNULL(ПодрОрг.Ссылка, ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка))   КАК СуществующаяСсылка,
	|	ЕСТЬNULL(ПодрОрг.Родитель, ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка)) КАК СуществующийРодитель,
	|	ЕСТЬNULL(ПодрОрг.Наименование, """")    КАК СуществующееНаименование
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК Подр
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодразделенияОрганизаций КАК ПодрОрг
	|		ПО ПодрОрг.А_Подразделение = Подр.Ссылка
	|			И ПодрОрг.Владелец = &Владелец
	|ГДЕ
	|	Подр.Ссылка = &Подразделение";
	Запрос.УстановитьПараметр("Подразделение", ПодразделениеСсылка);
	Запрос.УстановитьПараметр("Владелец",      ОрганизацияВладелец);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
	КонецЕсли;

	// === Рекурсивно отримати/створити батька ===
	РодительПодразделения = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
	Если ЗначениеЗаполнено(Выборка.РодительПодразделения) Тогда
		РодительПодразделения = ОбеспечитьПодразделенияОрганизацийПоПодразделению(Выборка.РодительПодразделения);
	КонецЕсли;

	НаименованиеПодразделения = Выборка.НаименованиеПодразделения;

	// === Гілка 1: елемент ВЖЕ існує — оновити при потребі ===
	Если ЗначениеЗаполнено(Выборка.СуществующаяСсылка) Тогда
		ПотрібноОновити = (Выборка.СуществующийРодитель    <> РодительПодразделения)
		               ИЛИ (Выборка.СуществующееНаименование <> НаименованиеПодразделения);

		Если ПотрібноОновити Тогда
			Объект = Выборка.СуществующаяСсылка.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				Объект.Заблокировать();
				Объект.Родитель     = РодительПодразделения;
				Объект.Наименование = НаименованиеПодразделения;
				Объект.Записать();
			КонецЕсли;
		КонецЕсли;

		Возврат Выборка.СуществующаяСсылка;
	КонецЕсли;

	// === Гілка 2: елемент відсутній — створити ===
	НовыйОбъект = Справочники.ПодразделенияОрганизаций.СоздатьЭлемент();
	НовыйОбъект.Владелец         = ОрганизацияВладелец;
	НовыйОбъект.Наименование     = НаименованиеПодразделения;
	НовыйОбъект.Родитель         = РодительПодразделения;
	НовыйОбъект.А_Подразделение  = ПодразделениеСсылка;
	НовыйОбъект.ДатаСоздания     = ТекущаяДатаСеанса();
	НовыйОбъект.Сформировано     = Истина;
	НовыйОбъект.Записать();

	Возврат НовыйОбъект.Ссылка;

КонецФункции


