Процедура А_СоздатьПриходныйКассовыйОрдерПоСписаниеБезналичныхДенежныхСредств(ДокументОснование) Экспорт
	
	Если ДокументОснование.ХозяйственнаяОперация <> Перечисления.ХозяйственныеОперации.СнятиеНаличныхДенежныхСредств Тогда
		Возврат;
	КонецЕсли;  
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование",ДокументОснование);
	Запрос.Текст =   "ВЫБРАТЬ
	|	ПриходныйКассовыйОрдер.Ссылка
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|ГДЕ
	|	ПриходныйКассовыйОрдер.А_СписаниеБезналичныхДенежныхСредств = &ДокументОснование";
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока   Выборка.Следующий() Цикл
		ДокПКО = Выборка.Ссылка.ПолучитьОбъект(); 
		ДокПКО.УстановитьПометкуУдаления(Истина);
	КонецЦикла;
	
	
	Если НЕ ДокументОснование.Проведен
		Тогда
		Возврат ;
	КонецЕсли;
	
	ЗапросПоиска = Новый Запрос;
	ЗапросПоиска.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПриходныйКассовыйОрдер.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|ГДЕ
	|	ПриходныйКассовыйОрдер.А_СписаниеБезналичныхДенежныхСредств = &ДокументОснование";
	
	ЗапросПоиска.УстановитьПараметр("ДокументОснование", ДокументОснование.Ссылка);
	Выборка = ЗапросПоиска.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДокПКО = Выборка.Ссылка.ПолучитьОбъект(); 
		ДокПКО.УстановитьПометкуУдаления(Ложь); 
	Иначе
		ДокПКО = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент(); 	
	КонецЕсли;
	
	ДокПКО.А_СписаниеБезналичныхДенежныхСредств = ДокументОснование;
	ДокПКО.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ИнкассацияДенежныхСредствИзБанка;
	ДокПКО.Дата = ДокументОснование.Дата;   
	ДокПКО.А_Необновлять = Истина;                         
	ДокПКО.А_ВведенВЕРП = Истина; 
	ДокПКО.Организация =  ДокументОснование.Организация;
	ДокПКО.А_ОрганизацияБухгалтерия =  ДокументОснование.А_ОрганизацияБухгалтерия;
	ДокПКО.Касса =  ДокументОснование.КассаПолучатель;
	ДокПКО.Подразделение =  ДокументОснование.Подразделение;
	ДокПКО.СтатьяДвиженияДенежныхСредств =  Справочники.СтатьиДвиженияДенежныхСредств.ПеречислениеДенежныхСредствНаДругойСчет; //Внутреннее перемещение (приход)
	ДокПКО.СуммаДокумента =  ДокументОснование.СуммаДокумента;
	ДокПКО.Валюта = ДокументОснование.БанковскийСчет.ВалютаДенежныхСредств ;
	ДокПКО.БанковскийСчет =  ДокументОснование.БанковскийСчет;
	ДокПКО.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

