
#Область ПрограммныйИнтерфейс

// Массовая установка состояния визы для списка заказов поставщикам.
//
// Калька типового ОбщегоНазначенияУТВызовСервера.УстановитьСтатусДокументов (:23-130):
// тот же контракт (возврат числа обработанных), те же построчные проверки, та же блокировка
// объекта и те же кликабельные сообщения с привязкой к документу.
// Ошибка одного документа НЕ прерывает обработку остальных и НЕ откатывает уже поставленные визы —
// поэтому пакет намеренно НЕ заворачивается в одну транзакцию.
//
// Клиентская обвязка — типовая:
//   ВыделенныеСтроки = ОбщегоНазначенияУТКлиент.ПроверитьПолучитьВыделенныеВСпискеСсылки(Элементы.Список);
//   ...ПоказатьВопрос...
//   Обработано = А_ВизированиеВызовСервера.УстановитьВизуДокументов(ВыделенныеСтроки, "Утвержден");
//   ОбщегоНазначенияУТКлиент.ОповеститьПользователяОбУстановкеСтатуса(Элементы.Список, Обработано, ...);
//
// Параметры:
//  МассивДокументов - Массив - ДокументСсылка.ЗаказПоставщику
//  ИмяСостояния     - Строка - имя значения Перечисление.А_Визы_Состояния
//                     ("Утвержден", "Отклонено", "Черновик", "Анулировано")
//                     либо "Предварительная" — отложенная виза (пустая ссылка состояния)
//  ДопПараметры     - Структура - Виза_Причина и пр. (см. А_ВизированиеСервер.УстановитьСостояние)
//
// Возвращаемое значение:
//  Число - количество документов, у которых виза была изменена.
//
Функция УстановитьВизуДокументов(Знач МассивДокументов, Знач ИмяСостояния, Знач ДопПараметры = Неопределено) Экспорт

	КоличествоОбработанных = 0;

	Если МассивДокументов = Неопределено ИЛИ МассивДокументов.Количество() = 0 Тогда
		Возврат КоличествоОбработанных;
	КонецЕсли;

	Если ИмяСостояния = "Предварительная" Тогда
		НовоеСостояние = Перечисления.А_Визы_Состояния.ПустаяСсылка();
	Иначе
		НовоеСостояние = Перечисления.А_Визы_Состояния[ИмяСостояния];
	КонецЕсли;

	ШаблонВнеКонтура    = НСтр("ru='Заказ %Документ% вне контура визирования (создан обменом) — виза недоступна.'");
	ШаблонПомечен       = НСтр("ru='Заказ %Документ% помечен на удаление. Невозможно изменить визу.'");
	ШаблонНеПроведен    = НСтр("ru='Заказ %Документ% не проведен. Невозможно изменить визу.'");
	ШаблонСовпадает     = НСтр("ru='У заказа %Документ% уже установлено состояние визы ""%Состояние%"".'");
	ШаблонНедоступно    = НСтр("ru='Вам недоступно состояние визы ""%Состояние%"" для заказа %Документ%.'");
	ШаблонЗаблокировать = НСтр("ru='Не удалось заблокировать %Документ%. %ОписаниеОшибки%'");
	ШаблонЗаписать      = НСтр("ru='Не удалось записать %Документ%. %ОписаниеОшибки%'");

	Выборка = ВыборкаПроверки(МассивДокументов, НовоеСостояние);

	Пока Выборка.Следующий() Цикл

		// --- Универсальные проверки (как в типовом движке) ---------------------
		Если НЕ Выборка.ВКонтуре Тогда
			СообщитьОДокументе(ШаблонВнеКонтура, Выборка);
			Продолжить;
		КонецЕсли;

		Если Выборка.ПометкаУдаления Тогда
			СообщитьОДокументе(ШаблонПомечен, Выборка);
			Продолжить;
		КонецЕсли;

		Если НЕ Выборка.Проведен Тогда
			СообщитьОДокументе(ШаблонНеПроведен, Выборка);
			Продолжить;
		КонецЕсли;

		Если Выборка.СостояниеСовпадает Тогда
			СообщитьОДокументе(ШаблонСовпадает, Выборка, НовоеСостояние);
			Продолжить;
		КонецЕсли;

		// --- Права на это состояние -------------------------------------------
		Доступные = А_ВизированиеСервер.ДоступныеСостояния(Выборка.Ссылка, ДопПараметры);
		Если Доступные.Состояния.НайтиПоЗначению(НовоеСостояние) = Неопределено Тогда
			СообщитьОДокументе(ШаблонНедоступно, Выборка, НовоеСостояние);
			Продолжить;
		КонецЕсли;

		// --- Захват объекта ----------------------------------------------------
		Попытка
			ЗаблокироватьДанныеДляРедактирования(Выборка.Ссылка);
		Исключение
			СообщитьОбОшибке(ШаблонЗаблокировать, Выборка, ИнформацияОбОшибке());
			Продолжить;
		КонецПопытки;

		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();

		// --- Изменение визы (движок документ НЕ пишет) -------------------------
		РезультатВизы = А_ВизированиеСервер.УстановитьСостояние(ДокОбъект, НовоеСостояние, ДопПараметры);

		Если НЕ РезультатВизы.Успех Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(РезультатВизы.ТекстОшибки, Выборка.Ссылка);
			РазблокироватьДанныеДляРедактирования(Выборка.Ссылка);
			Продолжить;
		КонецЕсли;

		// --- Запись (её делает ИМЕННО ЭТОТ движок, ровно один раз) -------------
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КоличествоОбработанных = КоличествоОбработанных + 1;
		Исключение
			СообщитьОбОшибке(ШаблонЗаписать, Выборка, ИнформацияОбОшибке());
		КонецПопытки;

		РазблокироватьДанныеДляРедактирования(Выборка.Ссылка);

	КонецЦикла;

	Возврат КоличествоОбработанных;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выборка проверки перед сменой визы.
// Аналог Документы.ЗаказПоставщику.СформироватьЗапросПроверкиПриСменеСтатуса.
//
Функция ВыборкаПроверки(МассивДокументов, НовоеСостояние)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(Т.Ссылка) КАК Представление,
	|	Т.Проведен КАК Проведен,
	|	Т.ПометкаУдаления КАК ПометкаУдаления,
	|	Т.А_Виза_Состояние КАК ТекущееСостояние,
	|	ВЫБОР
	|		КОГДА Т.А_Виза_Состояние = &НовоеСостояние
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СостояниеСовпадает,
	|	ВЫБОР
	|		КОГДА Т.А_Виза_Состояние = ЗНАЧЕНИЕ(Перечисление.А_Визы_Состояния.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ВКонтуре
	|ИЗ
	|	Документ.ЗаказПоставщику КАК Т
	|ГДЕ
	|	Т.Ссылка В (&МассивДокументов)";

	Запрос.УстановитьПараметр("НовоеСостояние", НовоеСостояние);
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);

	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат.Выбрать();

КонецФункции

Процедура СообщитьОДокументе(Шаблон, Выборка, Состояние = Неопределено)

	Текст = СтрЗаменить(Шаблон, "%Документ%", Выборка.Представление);
	Если Состояние <> Неопределено Тогда
		Текст = СтрЗаменить(Текст, "%Состояние%", Строка(Состояние));
	КонецЕсли;

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, Выборка.Ссылка);

КонецПроцедуры

Процедура СообщитьОбОшибке(Шаблон, Выборка, ИнфоОбОшибке)

	Текст = СтрЗаменить(Шаблон, "%Документ%", Выборка.Представление);
	Текст = СтрЗаменить(Текст, "%ОписаниеОшибки%", КраткоеПредставлениеОшибки(ИнфоОбОшибке));

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, Выборка.Ссылка);

КонецПроцедуры

#КонецОбласти
