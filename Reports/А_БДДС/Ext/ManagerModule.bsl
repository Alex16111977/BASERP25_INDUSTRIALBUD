// См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов.
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
    
    // Описание основного варианта
    НастройкиОтчета.ОпределитьНастройкиФормы = Истина;
    
    // Размещение в разделах командного интерфейса
    НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "");
    НастройкиВарианта.Описание = НСтр("ru='БДДС план-факт анализ';uk='БДДС план-факт аналіз'");
    НастройкиВарианта.Размещение.Вставить(Метаданные.Подсистемы.Казначейство); // указать нужную подсистему
    
КонецПроцедуры

