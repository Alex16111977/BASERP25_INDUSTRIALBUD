		<query>ВЫБРАТЬ
	СК.СотрудникЕРП.ФизическоеЛицо КАК ФизЛицо,
	МИНИМУМ(СК.Ссылка) КАК Сотрудник
ПОМЕСТИТЬ МостФЛ
ИЗ
	Справочник.А_СотрудникиКазна КАК СК
ГДЕ
	НЕ СК.ПометкаУдаления
	И НЕ СК.ЭтоГруппа
	И НЕ СК.СотрудникЕРП.ФизическоеЛицо = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
СГРУППИРОВАТЬ ПО
	СК.СотрудникЕРП.ФизическоеЛицо
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Т.Подразделение КАК Подразделение,
	Т.Сотрудник КАК Сотрудник,
	Т.Направление КАК Направление,
	Т.Регистратор КАК Регистратор,
	СУММА(Т.ЧасыФакт) КАК ФактЧасы
ПОМЕСТИТЬ ТзФакт
ИЗ
	РегистрНакопления.А_ДанныеТабелирования КАК Т
ГДЕ
	(Т.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
			ИЛИ &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
СГРУППИРОВАТЬ ПО
	Т.Подразделение,
	Т.Сотрудник,
	Т.Направление,
	Т.Регистратор
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Работы.Ссылка.Подразделение КАК Подразделение,
	Работы.Ссылка КАК Ссылка,
	Работы.Работа КАК Работа,
	СУММА(Работы.Количество) КАК ПланЧасы,
	СУММА(Работы.Сумма) КАК ПланСумма
ПОМЕСТИТЬ ТзПлан
ИЗ
	Справочник.А_СтруктураСебестоимости.Работы КАК Работы
ГДЕ
	НЕ Работы.Ссылка.ПометкаУдаления
СГРУППИРОВАТЬ ПО
	Работы.Ссылка.Подразделение,
	Работы.Ссылка,
	Работы.Работа
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВЗ.Подразделение КАК Подразделение,
	МостФЛ.Сотрудник КАК Сотрудник,
	ВЗ.Регистратор КАК Регистратор,
	СУММА(ВЗ.СуммаВзаиморасчетов) КАК ФактСумма
ПОМЕСТИТЬ ТзФактЗП
ИЗ
	РегистрНакопления.А_ВзаиморасчетыССотрудниками КАК ВЗ
		ЛЕВОЕ СОЕДИНЕНИЕ МостФЛ КАК МостФЛ
		ПО ВЗ.ФизическоеЛицо = МостФЛ.ФизЛицо
ГДЕ
	ВЗ.Регистратор ССЫЛКА Документ.ОтражениеЗарплатыВФинансовомУчете
	И ВЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	И (ВЗ.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
			ИЛИ &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
СГРУППИРОВАТЬ ПО
	ВЗ.Подразделение,
	МостФЛ.Сотрудник,
	ВЗ.Регистратор
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТзПлан.Подразделение КАК Подразделение,
	НЕОПРЕДЕЛЕНО КАК Сотрудник,
	НЕОПРЕДЕЛЕНО КАК Направление,
	ТзПлан.Работа КАК Работа,
	ТзПлан.Ссылка КАК Документ,
	ТзПлан.ПланЧасы КАК ПланЧасы,
	ТзПлан.ПланСумма КАК ПланСумма,
	0 КАК ФактЧасы,
	0 КАК ФактСумма
ПОМЕСТИТЬ СводнаяТаблица
ИЗ
	ТзПлан КАК ТзПлан

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ТзФакт.Подразделение,
	ТзФакт.Сотрудник,
	ТзФакт.Направление,
	НЕОПРЕДЕЛЕНО,
	ТзФакт.Регистратор,
	0,
	0,
	ТзФакт.ФактЧасы,
	0
ИЗ
	ТзФакт КАК ТзФакт

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ТзФактЗП.Подразделение,
	ТзФактЗП.Сотрудник,
	НЕОПРЕДЕЛЕНО,
	НЕОПРЕДЕЛЕНО,
	ТзФактЗП.Регистратор,
	0,
	0,
	0,
	ТзФактЗП.ФактСумма
ИЗ
	ТзФактЗП КАК ТзФактЗП
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СводнаяТаблица.Подразделение КАК Подразделение,
	СводнаяТаблица.Сотрудник КАК Сотрудник,
	СводнаяТаблица.Направление КАК Направление,
	СводнаяТаблица.Работа КАК Работа,
	СводнаяТаблица.Документ КАК Документ,
	СУММА(СводнаяТаблица.ПланЧасы) КАК ПланЧасы,
	СУММА(СводнаяТаблица.ПланСумма) КАК ПланСумма,
	СУММА(СводнаяТаблица.ФактЧасы) КАК ФактЧасы,
	СУММА(СводнаяТаблица.ФактСумма) КАК ФактСумма,
	СУММА(СводнаяТаблица.ФактЧасы) - СУММА(СводнаяТаблица.ПланЧасы) КАК РазницаЧасов,
	СУММА(СводнаяТаблица.ФактСумма) - СУММА(СводнаяТаблица.ПланСумма) КАК РазницаСумма,
	ВЫБОР
		КОГДА СУММА(СводнаяТаблица.ПланЧасы) = 0
			ТОГДА NULL
		ИНАЧЕ СУММА(СводнаяТаблица.ФактЧасы) / СУММА(СводнаяТаблица.ПланЧасы) * 100
	КОНЕЦ КАК ПроцентВыполнения,
	ВЫБОР
		КОГДА СУММА(СводнаяТаблица.ПланСумма) = 0
			ТОГДА NULL
		ИНАЧЕ СУММА(СводнаяТаблица.ФактСумма) / СУММА(СводнаяТаблица.ПланСумма) * 100
	КОНЕЦ КАК ПроцентВыполненияСумма
ИЗ
	СводнаяТаблица КАК СводнаяТаблица
СГРУППИРОВАТЬ ПО
	СводнаяТаблица.Подразделение,
	СводнаяТаблица.Сотрудник,
	СводнаяТаблица.Направление,
	СводнаяТаблица.Работа,
	СводнаяТаблица.Документ

УПОРЯДОЧИТЬ ПО
	Подразделение,
	Сотрудник</query>
