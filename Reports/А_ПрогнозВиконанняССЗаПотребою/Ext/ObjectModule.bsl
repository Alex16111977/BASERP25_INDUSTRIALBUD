		Таблица.Колонки.Добавить(Ресурс, ТипКол);
	КонецЦикла;
	Для Каждого Ресурс Из СтрРазделить("ПланГрн,КупленоГрн,ПослеГрн,ЗалишокСС,ПотребаГрн,ЗалишокПотребы,НеДокупаем,"
		+ "ПрогнозПотреба,ЭкономияПотреба,ЭкономияПроцент,ПрогнозСС,ЭкономияСС,РазницаМетодов,ЦенаПлан,ЦенаПотребы,ЦенаФакт,ОтношениеЦен,"
		+ "ОплаченоНеНадійшло,Оплачено,Борг", ",") Цикл
		Таблица.Колонки.Добавить(Ресурс, ТипСумма);
	КонецЦикла;
	Возврат Таблица;

