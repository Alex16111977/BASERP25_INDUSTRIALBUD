#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// «Прогноз виконання СС за потребою»: прогноз = закуплено на дату + залишок потреби директора
// (документ А_ПотребаЗавершенняПроекту); економія = план СС − прогноз. План і закупки — з «План-факт»
// (Отчеты.А_ПланФактныйПроизводствоПолный.ПолучитьДанные), ключ групи — як КлючГруппыПланНаФакт.

#Область СлужебныйПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	МассивНазначений = Новый Массив;
	МассивНазначений.Добавить("");
	ИмяОтчета = Метаданные().Представление();
	ПараметрыРегистрации.Вставить("Вид", "ДополнительныйОтчет");
	ПараметрыРегистрации.Вставить("Назначение", МассивНазначений);
	ПараметрыРегистрации.Вставить("Наименование", ИмяОтчета);
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация", "Прогноз виконання СС: закуплено + залишок потреби директора, економія до СС");
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Команда = Команды.Добавить();
	Команда.Представление = ИмяОтчета;
	Команда.Идентификатор = Метаданные().ПолноеИмя();
	Команда.Использование = "ОткрытиеФормы";
	Команда.ПоказыватьОповещение = Истина;
	ПараметрыРегистрации.Вставить("Команды", Команды);
	Возврат ПараметрыРегистрации;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СформироватьОтчет(ДокументРезультат, ДанныеРасшифровки);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Формирует отчёт в табличный документ (экспорт — для приёмки через COM).
//
// Параметры:
//   ДокументРезультат - ТабличныйДокумент
//   ДанныеРасшифровки - ДанныеРасшифровкиКомпоновкиДанных, Неопределено
//
Процедура СформироватьОтчет(ДокументРезультат, ДанныеРасшифровки = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	ДатаОтчета = ЗначениеДатыОтчета(Настройки);
	ДанныеОтчета = ПолучитьДанные(ДатаОтчета);
	УстановитьУкраинскуюШапку(Настройки, ?(ЗначениеЗаполнено(ДатаОтчета), ДатаОтчета, ТекущаяДатаСеанса()));

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, Новый Структура("Детали", ДанныеОтчета), ДанныеРасшифровки, Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	ЗаменитьТекстЯчеек(ДокументРезультат, "Итого", "Разом");

КонецПроцедуры

// Данные отчёта: строки План СС / Закупівля / Залишок за СС / Потреба / Залишок потреби по проектам,
// у которых есть проведённый документ потребы на дату.
//
// Параметры:
//   ДатаОтчета - Дата - пустая: текущая дата сеанса.
//
// Возвращаемое значение:
//   ТаблицаЗначений - см. СоздатьПустуюТаблицу.
//
Функция ПолучитьДанные(ДатаОтчета) Экспорт

	МоментОтчета = КонецДня(?(ЗначениеЗаполнено(ДатаОтчета), ДатаОтчета, ТекущаяДатаСеанса()));
	Результат = СоздатьПустуюТаблицу();
	ДокументыПотребы = ПоследниеДокументыПотребы(МоментОтчета);
	Если ДокументыПотребы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ДанныеПланФакт = Отчеты.А_ПланФактныйПроизводствоПолный.Создать().ПолучитьДанные(
		Новый СтандартныйПериод(Дата(2000, 1, 1), МоментОтчета));
	ДатыЗакупок = ДатыЗакупок(ДанныеПланФакт);

	Группы = Новый Соответствие;
	Для Каждого СтрокаПФ Из ДанныеПланФакт Цикл
		Если СтрокаПФ.Блок <> "2. Матеріали" Тогда
			Продолжить;
		КонецЕсли;
		ДокументПотребы = ДокументыПотребы[СтрокаПФ.Подразделение];
		Если ДокументПотребы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Группа = ГруппаПоКлючу(Группы, КлючГруппы(СтрокаПФ.Подразделение, СтрокаПФ.ОбщееНазвание, СтрокаПФ.Номенклатура, СтрокаПФ.Аналитика),
			СтрокаПФ.Подразделение, ДокументПотребы);
		ДобавитьСтрокуПланФакт(Группа, СтрокаПФ, ДатыЗакупок, ДокументПотребы.МоментСписка);
	КонецЦикла;

	СтрокиПотребы = СтрокиПотребы(ДокументыПотребы);
	Для Каждого СтрокаПотребы Из СтрокиПотребы Цикл
		ДокументПотребы = ДокументыПотребы[СтрокаПотребы.Подразделение];
		Если ЗначениеЗаполнено(СтрокаПотребы.ОбщееНазвание) Тогда
			Ключ = КлючГруппы(СтрокаПотребы.Подразделение, СтрокаПотребы.ОбщееНазвание, Неопределено, Неопределено);
		Иначе
			Ключ = Строка(СтрокаПотребы.Подразделение.УникальныйИдентификатор()) + "|ТЕКСТ|"
				+ Документы.А_ПотребаЗавершенняПроекту.НормализоватьТекст(
					?(ЗначениеЗаполнено(СтрокаПотребы.НазваниеСС), СтрокаПотребы.НазваниеСС, СтрокаПотребы.НазваниеТовара));
		КонецЕсли;
		Группа = ГруппаПоКлючу(Группы, Ключ, СтрокаПотребы.Подразделение, ДокументПотребы);
		Если Не ЗначениеЗаполнено(Группа.ОбщееНазвание) И ЗначениеЗаполнено(СтрокаПотребы.ОбщееНазвание) Тогда
			Группа.ОбщееНазвание = СтрокаПотребы.ОбщееНазвание;
		КонецЕсли;
		Если Группа.Имя = "" Тогда
			Группа.Имя = ?(ЗначениеЗаполнено(СтрокаПотребы.ОбщееНазвание), СокрЛП(СтрокаПотребы.ОбщееНазвание.Наименование),
				СокрЛП(?(ЗначениеЗаполнено(СтрокаПотребы.НазваниеСС), СтрокаПотребы.НазваниеСС, СтрокаПотребы.НазваниеТовара)));
		КонецЕсли;
		Группа.ПотребаГрн = Группа.ПотребаГрн + СтрокаПотребы.Сумма;
		Группа.ПотребаКолСС = Группа.ПотребаКолСС + СтрокаПотребы.КоличествоСС;
		Группа.ПотребаКолФайла = Группа.ПотребаКолФайла + СтрокаПотребы.Количество;
		Группа.СтрокиПотребы.Добавить(СтрокаПотребы);
	КонецЦикла;

	// Оплата по заказам поставщику: только информация, в прогноз не входит.
	Оплаты = ДанныеОплатЗаказов(ДанныеПланФакт, МоментОтчета);
	ДобавитьСтрокиСчетов(Группы, ДокументыПотребы, Оплаты, МоментОтчета);

	СвязатьСкладеныеНазвания(Группы, СтрокиПотребы);
	РассчитатьЗалишокПотребы(Группы);
	ЗаполнитьПризнакиГрупп(Группы, ДокументыПотребы);
	ВывестиСтроки(Группы, Результат, Оплаты);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Шапка не зависит от языка сеанса: стандартные «Параметры:/Отбор:» платформа печатает на языке сеанса,
// поэтому дата и отбор выводятся в заголовке украинским текстом.
Процедура УстановитьУкраинскуюШапку(Настройки, ДатаОтчета)

	ПараметрЗаголовка = Настройки.ПараметрыВывода.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Заголовок"));
	Заголовок = ?(ПараметрЗаголовка = Неопределено, "", Строка(ПараметрЗаголовка.Значение));
	Заголовок = Заголовок + " на " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy");
	ОписаниеОтбора = ОписаниеОтбора(Настройки.Отбор);
	Если ОписаниеОтбора <> "" Тогда
		Заголовок = Заголовок + ". Відбір: " + ОписаниеОтбора;
	КонецЕсли;
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("Заголовок", Заголовок);
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьПараметрыДанных", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);

КонецПроцедуры

Функция ОписаниеОтбора(Отбор)

	Виды = Новый Соответствие;
	Виды.Вставить(ВидСравненияКомпоновкиДанных.Равно, "=");
	Виды.Вставить(ВидСравненияКомпоновкиДанных.НеРавно, "≠");
	Виды.Вставить(ВидСравненияКомпоновкиДанных.Больше, ">");
	Виды.Вставить(ВидСравненияКомпоновкиДанных.БольшеИлиРавно, "≥");
	Виды.Вставить(ВидСравненияКомпоновкиДанных.Меньше, "<");
	Виды.Вставить(ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, "≤");
	Виды.Вставить(ВидСравненияКомпоновкиДанных.ВСписке, "у списку");
	Виды.Вставить(ВидСравненияКомпоновкиДанных.НеВСписке, "не у списку");
	Виды.Вставить(ВидСравненияКомпоновкиДанных.ВИерархии, "в ієрархії");
	Виды.Вставить(ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии, "у списку з ієрархією");
	Виды.Вставить(ВидСравненияКомпоновкиДанных.Содержит, "містить");
	Виды.Вставить(ВидСравненияКомпоновкиДанных.Заполнено, "заповнено");
	Виды.Вставить(ВидСравненияКомпоновкиДанных.НеЗаполнено, "не заповнено");
	Части = Новый Массив;
	Для Каждого Элемент Из Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) <> Тип("ЭлементОтбораКомпоновкиДанных") Или Не Элемент.Использование Тогда
			Продолжить;
		КонецЕсли;
		Поле = Отбор.ДоступныеПоляОтбора.НайтиПоле(Элемент.ЛевоеЗначение);
		ИмяПоля = ?(Поле = Неопределено, Строка(Элемент.ЛевоеЗначение), Поле.Заголовок);
		Вид = Виды[Элемент.ВидСравнения];
		Значение = Элемент.ПравоеЗначение;
		Если ТипЗнч(Значение) = Тип("СписокЗначений") Тогда
			Значения = Новый Массив;
			Для Каждого ЭлементСписка Из Значение Цикл
				Значения.Добавить(Строка(ЭлементСписка.Значение));
			КонецЦикла;
			Значение = СтрСоединить(Значения, ", ");
		КонецЕсли;
		Части.Добавить(СокрЛП(ИмяПоля + " " + ?(Вид = Неопределено, Строка(Элемент.ВидСравнения), Вид) + " " + Строка(Значение)));
	КонецЦикла;
	Возврат СтрСоединить(Части, "; ");

КонецФункции

Процедура ЗаменитьТекстЯчеек(ТабДок, Было, Стало)

	Область = ТабДок.НайтиТекст(Было, , , , Истина);
	Пока Область <> Неопределено Цикл
		Область.Текст = Стало;
		Область = ТабДок.НайтиТекст(Было, Область, , , Истина);
	КонецЦикла;

КонецПроцедуры

Функция ЗначениеДатыОтчета(Настройки)

	Параметр = Настройки.ПараметрыДанных.Элементы.Найти("ДатаОтчета");
	Если Параметр = Неопределено Или Не Параметр.Использование Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Значение = Параметр.Значение;
	Если ТипЗнч(Значение) = Тип("СтандартнаяДатаНачала") Тогда
		Значение = Значение.Дата;
	КонецЕсли;
	Возврат ?(ТипЗнч(Значение) = Тип("Дата"), Значение, Дата(1, 1, 1));

КонецФункции

// Подразделение → Структура(Ссылка, Дата, МоментСписка): последний проведённый документ потребы с датой не позже момента.
// МассивЗакупок с датой позже момента документа (с точностью до секунды) списывают потребу.
Функция ПоследниеДокументыПотребы(МоментОтчета)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокПотр.Ссылка КАК Ссылка,
	|	ДокПотр.Подразделение КАК Подразделение,
	|	ДокПотр.Дата КАК Дата,
	|	ДокПотр.Номер КАК Номер
	|ИЗ
	|	Документ.А_ПотребаЗавершенняПроекту КАК ДокПотр
	|ГДЕ
	|	ДокПотр.Проведен
	|	И НЕ ДокПотр.ПометкаУдаления
	|	И ДокПотр.Дата <= &МоментОтчета
	|	И ДокПотр.Подразделение <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокПотр.Подразделение,
	|	ДокПотр.МоментВремени УБЫВ";
	Запрос.УстановитьПараметр("МоментОтчета", МоментОтчета);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат[Выборка.Подразделение] = Неопределено Тогда
			Результат.Вставить(Выборка.Подразделение, Новый Структура("Ссылка, Дата, МоментСписка, Текст",
				Выборка.Ссылка, Выборка.Дата, Выборка.Дата,
				"список від " + Формат(Выборка.Дата, "ДФ='dd.MM.yyyy HH:mm'") + " (№ " + СокрЛП(Выборка.Номер) + ")"));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СтрокиПотребы(ДокументыПотребы)

	Ссылки = Новый Массив;
	Для Каждого Элемент Из ДокументыПотребы Цикл
		Ссылки.Добавить(Элемент.Значение.Ссылка);
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтрПотр.Ссылка КАК Ссылка,
	|	СтрПотр.Ссылка.Подразделение КАК Подразделение,
	|	СтрПотр.НомерСтроки КАК НомерСтроки,
	|	СтрПотр.НазваниеТовара КАК НазваниеТовара,
	|	СтрПотр.НазваниеСС КАК НазваниеСС,
	|	СтрПотр.ОбщееНазвание КАК ОбщееНазвание,
	|	СтрПотр.Количество КАК Количество,
	|	СтрПотр.Единица КАК Единица,
	|	СтрПотр.КоличествоСС КАК КоличествоСС,
	|	СтрПотр.ЕдиницаСС КАК ЕдиницаСС,
	|	СтрПотр.Сумма КАК Сумма,
	|	СтрПотр.Дома КАК Дома,
	|	СтрПотр.Предупреждение КАК Предупреждение
	|ИЗ
	|	Документ.А_ПотребаЗавершенняПроекту.Потреба КАК СтрПотр
	|ГДЕ
	|	СтрПотр.Ссылка В (&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтрПотр.Ссылка,
	|	СтрПотр.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ДатыЗакупок(ДанныеПланФакт)

	МассивЗакупок = Новый Массив;
	ТипЗакупки = Тип("ДокументСсылка.ПриобретениеТоваровУслуг");
	Для Каждого СтрокаПФ Из ДанныеПланФакт Цикл
		Если ТипЗнч(СтрокаПФ.Документ) = ТипЗакупки И ЗначениеЗаполнено(СтрокаПФ.Документ) Тогда
			МассивЗакупок.Добавить(СтрокаПФ.Документ);
		КонецЕсли;
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокЗак.Ссылка КАК Ссылка,
	|	ДокЗак.Дата КАК Дата
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК ДокЗак
	|ГДЕ
	|	ДокЗак.Ссылка В (&Закупки)";
	Запрос.УстановитьПараметр("Закупки", МассивЗакупок);
	Даты = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Даты.Вставить(Выборка.Ссылка, Выборка.Дата);
	КонецЦикла;
	Возврат Даты;

КонецФункции

// Ключ группы — как КлючГруппыПланНаФакт отчёта «План-факт»: подразделение + СокрЛП(имя загальної назви).
Функция КлючГруппы(Подразделение, ОбщееНазвание, Номенклатура, Аналитика)

	КлючПодр = Строка(Подразделение.УникальныйИдентификатор()) + "|";
	Если ЗначениеЗаполнено(ОбщееНазвание) Тогда
		ИмяОН = СокрЛП(ОбщееНазвание.Наименование);
		Если ИмяОН = "" Тогда
			ИмяОН = Строка(ОбщееНазвание.УникальныйИдентификатор());
		КонецЕсли;
		Возврат КлючПодр + "ОН|" + ИмяОН;
	КонецЕсли;
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат КлючПодр + "НОМ|" + Строка(Номенклатура.УникальныйИдентификатор());
	КонецЕсли;
	Если ТипЗнч(Аналитика) = Тип("Строка") И СокрЛП(Аналитика) <> "" Тогда
		Возврат КлючПодр + "НОМТЕКСТ|" + ВРег(СокрЛП(Аналитика));
	КонецЕсли;
	Возврат КлючПодр + "НОМ|";

КонецФункции

Функция ГруппаПоКлючу(Группы, Ключ, Подразделение, ДокументПотребы)

	Группа = Группы[Ключ];
	Если Группа <> Неопределено Тогда
		Возврат Группа;
	КонецЕсли;
	Группа = Новый Структура;
	Группа.Вставить("Ключ", Ключ);
	Группа.Вставить("Подразделение", Подразделение);
	Группа.Вставить("ДокументПотребы", ДокументПотребы.Ссылка);
	Группа.Вставить("СписокПотребы", ДокументПотребы.Текст);
	Группа.Вставить("ОбщееНазвание", Справочники.А_ОбщиеНазванияНоменклатуры.ПустаяСсылка());
	Группа.Вставить("Имя", "");
	Группа.Вставить("Этап", Неопределено);
	Группа.Вставить("ЕстьПлан", Ложь);
	Группа.Вставить("МаксПланГрн", -1);
	Группа.Вставить("ЕдиницаПлана", "");
	Для Каждого Ресурс Из СтрРазделить("ПланКол,ПланГрн,КупленоКол,КупленоГрн,ПослеКол,ПослеГрн,ЗалишокСС,ПотребаГрн,ПотребаКолСС,ПотребаКолФайла,ЗалишокПотребы,НеДокупаем", ",") Цикл
		Группа.Вставить(Ресурс, 0);
	КонецЦикла;
	Группа.Вставить("ЕдиницыПосле", Новый Соответствие);
	Группа.Вставить("СтрокиПФ", Новый Массив);
	Группа.Вставить("СтрокиПотребы", Новый Массив);
	Группа.Вставить("СтрокиСчетов", Новый Массив);
	Группа.Вставить("НаборСписания", Ключ);
	Группа.Вставить("ОзнакаСС", "");
	Группа.Вставить("ЕтапНазва", "");
	Группы.Вставить(Ключ, Группа);
	Возврат Группа;

КонецФункции

Процедура ДобавитьСтрокуПланФакт(Группа, СтрокаПФ, ДатыЗакупок, МоментСписка)

	ЭтоПлан = ТипЗнч(СтрокаПФ.Документ) = Тип("СправочникСсылка.А_СтруктураСебестоимости");
	ЭтоЗакупка = ТипЗнч(СтрокаПФ.Документ) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") И ЗначениеЗаполнено(СтрокаПФ.Документ);
	ПослеСписка = ЭтоЗакупка И ДатыЗакупок[СтрокаПФ.Документ] <> Неопределено И ДатыЗакупок[СтрокаПФ.Документ] > МоментСписка;

	Группа.ПланКол = Группа.ПланКол + СтрокаПФ.ПланКол;
	Группа.ПланГрн = Группа.ПланГрн + СтрокаПФ.ПланГрн;
	Группа.КупленоКол = Группа.КупленоКол + СтрокаПФ.ФактКол;
	Группа.КупленоГрн = Группа.КупленоГрн + СтрокаПФ.ФактГрн;
	Группа.ЗалишокСС = Группа.ЗалишокСС + СтрокаПФ.ПланНаФактГрн;
	Если ПослеСписка Тогда
		Группа.ПослеКол = Группа.ПослеКол + СтрокаПФ.ФактКол;
		Группа.ПослеГрн = Группа.ПослеГрн + СтрокаПФ.ФактГрн;
		Группа.ЕдиницыПосле.Вставить(Документы.А_ПотребаЗавершенняПроекту.НормализоватьТекст(Строка(СтрокаПФ.Единица)), Истина);
	КонецЕсли;
	Если ЭтоПлан Тогда
		Группа.ЕстьПлан = Истина;
		Если СтрокаПФ.ПланГрн > Группа.МаксПланГрн Тогда
			Группа.МаксПланГрн = СтрокаПФ.ПланГрн;
			Группа.Этап = СтрокаПФ.Этап;
			Группа.ЕдиницаПлана = Документы.А_ПотребаЗавершенняПроекту.НормализоватьТекст(Строка(СтрокаПФ.Единица));
			Если ЗначениеЗаполнено(СтрокаПФ.ОбщееНазвание) Тогда
				Группа.ОбщееНазвание = СтрокаПФ.ОбщееНазвание;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Не ЗначениеЗаполнено(Группа.ОбщееНазвание) И ЗначениеЗаполнено(СтрокаПФ.ОбщееНазвание) Тогда
		Группа.ОбщееНазвание = СтрокаПФ.ОбщееНазвание;
	КонецЕсли;
	Если Группа.Имя = "" Тогда
		Если ЗначениеЗаполнено(СтрокаПФ.ОбщееНазвание) Тогда
			Группа.Имя = СокрЛП(СтрокаПФ.ОбщееНазвание.Наименование);
		Иначе
			Группа.Имя = НСтр("ru = '(без загальної назви) '; uk = '(без загальної назви) '") + СокрЛП(Строка(СтрокаПФ.Аналитика));
		КонецЕсли;
	КонецЕсли;
	Вид = ?(ЭтоПлан, "План СС", ?(ЭтоЗакупка, ?(ПослеСписка, "Закупівля після списку", "Закупівля"), "Залишок за СС"));
	Группа.СтрокиПФ.Добавить(Новый Структура("Строка, Вид, ПослеСписка", СтрокаПФ, Вид, ПослеСписка));

КонецПроцедуры

// Складена назва «A / B»: группы частей объединяются в один набор списания (закупки любой части списывают строку),
// и части не попадают в «Не докуповуємо».
Процедура СвязатьСкладеныеНазвания(Группы, СтрокиПотребы)

	Для Каждого СтрокаПотребы Из СтрокиПотребы Цикл
		Если СтрНайти(СтрокаПотребы.НазваниеСС, "/") = 0 Или Не ЗначениеЗаполнено(СтрокаПотребы.ОбщееНазвание) Тогда
			Продолжить;
		КонецЕсли;
		КлючСтроки = КлючГруппы(СтрокаПотребы.Подразделение, СтрокаПотребы.ОбщееНазвание, Неопределено, Неопределено);
		КлючПодр = Строка(СтрокаПотребы.Подразделение.УникальныйИдентификатор()) + "|ОН|";
		Для Каждого Часть Из Документы.А_ПотребаЗавершенняПроекту.ЧастиСкладеногоНазвания(СтрокаПотребы.НазваниеСС) Цикл
			ГруппаЧасти = Группы[КлючПодр + Часть];
			Если ГруппаЧасти <> Неопределено Тогда
				ОбъединитьНаборы(Группы, КлючСтроки, ГруппаЧасти.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция КореньНабора(Группы, Ключ)

	Текущий = Ключ;
	Пока Группы[Текущий].НаборСписания <> Текущий Цикл
		Текущий = Группы[Текущий].НаборСписания;
	КонецЦикла;
	Возврат Текущий;

КонецФункции

Процедура ОбъединитьНаборы(Группы, КлючА, КлючБ)

	КореньА = КореньНабора(Группы, КлючА);
	КореньБ = КореньНабора(Группы, КлючБ);
	Если КореньА <> КореньБ Тогда
		Группы[КореньБ].НаборСписания = КореньА;
	КонецЕсли;

КонецПроцедуры

// Залишок потреби: закупки после даты списка списывают потребу той же загальної назви
// (по количеству — только для однородных строк с сопоставимыми единицами и правдоподобной ценой, иначе по деньгам).
Процедура РассчитатьЗалишокПотребы(Группы)

	Наборы = Новый Соответствие;
	Для Каждого Элемент Из Группы Цикл
		Корень = КореньНабора(Группы, Элемент.Ключ);
		Если Наборы[Корень] = Неопределено Тогда
			Наборы.Вставить(Корень, Новый Массив);
		КонецЕсли;
		Наборы[Корень].Добавить(Элемент.Значение);
	КонецЦикла;

	Для Каждого Элемент Из Наборы Цикл
		Члены = Элемент.Значение;
		ПотребаГрн = 0;
		ПослеГрн = 0;
		Для Каждого Член Из Члены Цикл
			ПотребаГрн = ПотребаГрн + Член.ПотребаГрн;
			ПослеГрн = ПослеГрн + Член.ПослеГрн;
		КонецЦикла;
		Если ПотребаГрн <= 0 Тогда
			Для Каждого Член Из Члены Цикл
				Член.НеДокупаем = ?(Члены.Количество() = 1, Член.ЗалишокСС, 0);
			КонецЦикла;
			Продолжить;
		КонецЕсли;

		Залишок = Неопределено;
		Если ПослеГрн = 0 Тогда
			Залишок = ПотребаГрн;
		ИначеЕсли Члены.Количество() = 1 Тогда
			Залишок = ЗалишокПоКоличеству(Члены[0]);
		КонецЕсли;
		Если Залишок = Неопределено Тогда
			Залишок = Макс(0, ПотребаГрн - ПослеГрн);
		КонецЕсли;
		Залишок = Окр(Залишок, 2);
		РаспределитьЗалишок(Члены, ПотребаГрн, Залишок);

		Если Члены.Количество() = 1 Тогда
			Член = Члены[0];
			Если Член.ЕстьПлан И Член.ПланКол > 0 И Член.ПотребаКолСС > 0 И ЕдиницаПотребыКакВПлане(Член) Тогда
				// Недокупленное по СС количество сверх потребы: сумма, от покупки которой директор отказывается.
				ЗалКолСС = Член.ПотребаКолСС * Член.ЗалишокПотребы / Член.ПотребаГрн;
				Член.НеДокупаем = Макс(0, Окр(Член.ЗалишокСС - ЗалКолСС * Член.ПланГрн / Член.ПланКол, 2));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Списание по количеству; Неопределено — условия не выполнены, считать по деньгам.
Функция ЗалишокПоКоличеству(Группа)

	Если Группа.ПослеКол <= 0 Или Группа.ЕдиницыПосле.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЕдиницаПосле = "";
	Для Каждого Элемент Из Группа.ЕдиницыПосле Цикл
		ЕдиницаПосле = Элемент.Ключ;
	КонецЦикла;

	ЕдиницаСС = "";
	ЕдиницаФайла = "";
	Для Каждого СтрокаПотребы Из Группа.СтрокиПотребы Цикл
		Если СтрНайти(СтрокаПотребы.Предупреждение, "Одиниця") > 0 Или СтрНайти(СтрокаПотребы.Предупреждение, "кількість") > 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		ЕдиницаСС = Документы.А_ПотребаЗавершенняПроекту.НормализоватьТекст(Строка(СтрокаПотребы.ЕдиницаСС));
		ЕдиницаФайла = Документы.А_ПотребаЗавершенняПроекту.НормализоватьТекст(СтрокаПотребы.Единица);
	КонецЦикла;
	Если ЕдиницаПосле = ЕдиницаСС И Группа.ПотребаКолСС > 0 Тогда
		ПотребаКол = Группа.ПотребаКолСС;
		ПоляКоличества = "КоличествоСС";
	ИначеЕсли ЕдиницаПосле = ЕдиницаФайла И Группа.ПотребаКолФайла > 0 Тогда
		ПотребаКол = Группа.ПотребаКолФайла;
		ПоляКоличества = "Количество";
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	ЦенаПотребы = Группа.ПотребаГрн / ПотребаКол;
	Для Каждого СтрокаПотребы Из Группа.СтрокиПотребы Цикл
		Кол = СтрокаПотребы[ПоляКоличества];
		Если Кол <= 0 Или Не ЦенаВПределах(СтрокаПотребы.Сумма / Кол, ЦенаПотребы, 0.95, 1.05) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Если Не ЦенаВПределах(Группа.ПослеГрн / Группа.ПослеКол, ЦенаПотребы, 0.67, 1.5) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ПоляКоличества = "КоличествоСС" И Группа.ПланКол > 0 И Группа.ЕдиницаПлана = ЕдиницаСС
		И Не ЦенаВПределах(ЦенаПотребы, Группа.ПланГрн / Группа.ПланКол, 0.67, 1.5) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Макс(0, ПотребаКол - Группа.ПослеКол) * ЦенаПотребы;

КонецФункции

Функция ЕдиницаПотребыКакВПлане(Группа)

	Для Каждого СтрокаПотребы Из Группа.СтрокиПотребы Цикл
		Если Документы.А_ПотребаЗавершенняПроекту.НормализоватьТекст(Строка(СтрокаПотребы.ЕдиницаСС)) <> Группа.ЕдиницаПлана Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ЦенаВПределах(Цена, База, Нижний, Верхний)

	Если База <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Цена >= База * Нижний И Цена <= База * Верхний;

КонецФункции

Процедура РаспределитьЗалишок(Члены, ПотребаГрн, Залишок)

	Остаток = Залишок;
	Последний = Неопределено;
	Для Каждого Член Из Члены Цикл
		Если Член.ПотребаГрн > 0 Тогда
			Последний = Член;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Член Из Члены Цикл
		Если Член.ПотребаГрн <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Член = Последний Тогда
			Член.ЗалишокПотребы = Остаток;
		Иначе
			Член.ЗалишокПотребы = Окр(Залишок * Член.ПотребаГрн / ПотребаГрн, 2);
			Остаток = Остаток - Член.ЗалишокПотребы;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьПризнакиГрупп(Группы, ДокументыПотребы)

	ИменаСС = Новый Соответствие;
	Для Каждого Элемент Из ДокументыПотребы Цикл
		ИменаСС.Вставить(Элемент.Ключ, Документы.А_ПотребаЗавершенняПроекту.ОбщиеНазванияПроектаПоИмени(Элемент.Ключ));
	КонецЦикла;
	Для Каждого Элемент Из Группы Цикл
		Группа = Элемент.Значение;
		ИменаПроекта = ИменаСС[Группа.Подразделение];
		ВСС = ЗначениеЗаполнено(Группа.ОбщееНазвание) И ИменаПроекта[СокрЛП(Группа.ОбщееНазвание.Наименование)] <> Неопределено;
		Если ВСС Тогда
			Группа.ОзнакаСС = ?(Группа.ПланГрн = 0, НСтр("ru = 'У кошторисі СС (план 0)'; uk = 'У кошторисі СС (план 0)'"),
				НСтр("ru = 'У кошторисі СС'; uk = 'У кошторисі СС'"));
		ИначеЕсли ЗначениеЗаполнено(Группа.ОбщееНазвание) Тогда
			Группа.ОзнакаСС = НСтр("ru = 'Поза СС: є в довіднику'; uk = 'Поза СС: є в довіднику'");
		ИначеЕсли СтрНачинаетсяС(Документы.А_ПотребаЗавершенняПроекту.НормализоватьТекст(Группа.Имя), "монтаж") Тогда
			Группа.ОзнакаСС = НСтр("ru = 'Поза СС: робота'; uk = 'Поза СС: робота'");
		Иначе
			Группа.ОзнакаСС = НСтр("ru = 'Поза СС: немає в довіднику'; uk = 'Поза СС: немає в довіднику'");
		КонецЕсли;
		Если Группа.ЕстьПлан Тогда
			Группа.ЕтапНазва = ?(ЗначениеЗаполнено(Группа.Этап), СокрЛП(Строка(Группа.Этап)), НСтр("ru = 'Без етапу'; uk = 'Без етапу'"));
		Иначе
			Группа.ЕтапНазва = НСтр("ru = 'Поза кошторисом СС'; uk = 'Поза кошторисом СС'");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиСтроки(Группы, Результат, Оплаты)

	Для Каждого Элемент Из Группы Цикл
		Группа = Элемент.Значение;
		Для Каждого ОписаниеСтроки Из Группа.СтрокиПФ Цикл
			СтрокаПФ = ОписаниеСтроки.Строка;
			НоваяСтрока = НоваяСтрокаГруппы(Результат, Группа, ОписаниеСтроки.Вид);
			НоваяСтрока.Аналитика = Лев(СокрЛП(Строка(СтрокаПФ.Аналитика)), 250);
			НоваяСтрока.Документ = СтрокаПФ.Документ;
			НоваяСтрока.ПланКол = СтрокаПФ.ПланКол;
			НоваяСтрока.ПланГрн = СтрокаПФ.ПланГрн;
			НоваяСтрока.КупленоКол = СтрокаПФ.ФактКол;
			НоваяСтрока.КупленоГрн = СтрокаПФ.ФактГрн;
			НоваяСтрока.ЗалишокСС = СтрокаПФ.ПланНаФактГрн;
			Если ОписаниеСтроки.ПослеСписка Тогда
				НоваяСтрока.ПослеГрн = СтрокаПФ.ФактГрн;
			КонецЕсли;
			Если СтрНачинаетсяС(ОписаниеСтроки.Вид, "Закупівля") Тогда
				ЗаполнитьОплатуЗакупки(НоваяСтрока, СтрокаПФ, Оплаты);
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрокаСчета Из Группа.СтрокиСчетов Цикл
			НоваяСтрока = НоваяСтрокаГруппы(Результат, Группа, "Рахунок оплачений, не надійшов");
			НоваяСтрока.Аналитика = Лев(СтрокаСчета.Название, 250);
			НоваяСтрока.Документ = СтрокаСчета.Заказ;
			НоваяСтрока.ОплаченоНеНадійшло = СтрокаСчета.Сумма;
		КонецЦикла;
		Для Каждого СтрокаПотребы Из Группа.СтрокиПотребы Цикл
			НоваяСтрока = НоваяСтрокаГруппы(Результат, Группа, "Потреба");
			НоваяСтрока.Аналитика = Лев(СокрЛП(СтрокаПотребы.НазваниеТовара), 250);
			НоваяСтрока.Документ = СтрокаПотребы.Ссылка;
			НоваяСтрока.Дома = СтрокаПотребы.Дома;
			НоваяСтрока.ПотребаКол = СтрокаПотребы.КоличествоСС;
			НоваяСтрока.ПотребаГрн = СтрокаПотребы.Сумма;
		КонецЦикла;
		Если Группа.ЗалишокПотребы <> 0 Или Группа.НеДокупаем <> 0 Тогда
			НоваяСтрока = НоваяСтрокаГруппы(Результат, Группа, "Залишок потреби");
			НоваяСтрока.ЗалишокПотребы = Группа.ЗалишокПотребы;
			НоваяСтрока.НеДокупаем = Группа.НеДокупаем;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция НоваяСтрокаГруппы(Результат, Группа, ВидРядка)

	НоваяСтрока = Результат.Добавить();
	НоваяСтрока.Подразделение = Группа.Подразделение;
	НоваяСтрока.ДокументПотребы = Группа.ДокументПотребы;
	НоваяСтрока.СписокПотребы = Группа.СписокПотребы;
	НоваяСтрока.ЕтапНазва = Группа.ЕтапНазва;
	НоваяСтрока.НазваЗагальна = Группа.Имя;
	НоваяСтрока.ОбщееНазвание = Группа.ОбщееНазвание;
	НоваяСтрока.ОзнакаСС = Группа.ОзнакаСС;
	НоваяСтрока.ВидРядка = ВидРядка;
	Возврат НоваяСтрока;

