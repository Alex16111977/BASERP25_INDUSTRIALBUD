#КонецОбласти

#Область ОплатаЗаказов

// Оплата заказов поставщику — только информация (в прогноз и экономию не входит). Спек:
// docs/superpowers/specs/2026-10-15-tovary-schetov-kazna-oplata-design.md.
// Оплаты[Заказ] = Структура(Счет, Оплачено, Получено, ПолученоПоКлючу); заказы — из закупок «План-факт» и регистра
// А_ТоварыСчетовПоставщиков (строки счетов Казны, распознанные из сканов).
Функция ДанныеОплатЗаказов(ДанныеПланФакт, МоментОтчета)

	ПТУ = Новый Массив;
	Для Каждого СтрокаПФ Из ДанныеПланФакт Цикл
		Если ТипЗнч(СтрокаПФ.Документ) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") И ЗначениеЗаполнено(СтрокаПФ.Документ) Тогда
			ПТУ.Добавить(СтрокаПФ.Документ);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПТУ", ПТУ);
	Запрос.УстановитьПараметр("Момент", МоментОтчета);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	П.Ссылка КАК ПТУ,
	|	П.ЗаказПоставщику КАК Заказ
	|ПОМЕСТИТЬ ВТ_ЗаказыПТУ
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК П
	|ГДЕ
	|	П.Ссылка В (&ПТУ)
	|	И П.ЗаказПоставщику <> ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Р.ЗаказПоставщику КАК Заказ,
	|	СУММА(Р.Сумма) КАК Счет
	|ПОМЕСТИТЬ ВТ_Счета
	|ИЗ
	|	РегистрСведений.А_ТоварыСчетовПоставщиков КАК Р
	|ГДЕ
	|	Р.ЗаказПоставщику <> ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)
	|	И Р.ДатаСчета <= &Момент
	|
	|СГРУППИРОВАТЬ ПО
	|	Р.ЗаказПоставщику
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Заказ КАК Заказ
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	ВТ_ЗаказыПТУ КАК ВТ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТ.Заказ
	|ИЗ
	|	ВТ_Счета КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Р.ОбъектРасчетов.Объект КАК Документ.ЗаказПоставщику) КАК Заказ,
	|	Р.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_Оплаты
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК Р
	|ГДЕ
	|	Р.Ссылка.Проведен
	|	И Р.Ссылка.Дата <= &Момент
	|	И ТИПЗНАЧЕНИЯ(Р.ОбъектРасчетов.Объект) = ТИП(Документ.ЗаказПоставщику)
	|	И Р.ОбъектРасчетов.Объект В
	|			(ВЫБРАТЬ
	|				ВТ.Заказ
	|			ИЗ
	|				ВТ_Заказы КАК ВТ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Р.ОбъектРасчетов.Объект КАК Документ.ЗаказПоставщику),
	|	Р.Сумма
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер.РасшифровкаПлатежа КАК Р
	|ГДЕ
	|	Р.Ссылка.Проведен
	|	И Р.Ссылка.Дата <= &Момент
	|	И ТИПЗНАЧЕНИЯ(Р.ОбъектРасчетов.Объект) = ТИП(Документ.ЗаказПоставщику)
	|	И Р.ОбъектРасчетов.Объект В
	|			(ВЫБРАТЬ
	|				ВТ.Заказ
	|			ИЗ
	|				ВТ_Заказы КАК ВТ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Заказ КАК Заказ,
	|	ЕСТЬNULL(Сч.Счет, 0) КАК Счет,
	|	ЕСТЬNULL(Опл.Оплачено, 0) КАК Оплачено
	|ИЗ
	|	ВТ_Заказы КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Счета КАК Сч
	|		ПО ВТ.Заказ = Сч.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			О.Заказ КАК Заказ,
	|			СУММА(О.Сумма) КАК Оплачено
	|		ИЗ
	|			ВТ_Оплаты КАК О
	|		СГРУППИРОВАТЬ ПО
	|			О.Заказ) КАК Опл
	|		ПО ВТ.Заказ = Опл.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка.ЗаказПоставщику КАК Заказ,
	|	Т.Номенклатура.А_ОбщееНазваниеНоменклатуры КАК ОбщееНазвание,
	|	Т.Номенклатура КАК Номенклатура,
	|	СУММА(Т.СуммаСНДС) КАК Получено
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Проведен
	|	И Т.Ссылка.Дата <= &Момент
	|	И Т.Ссылка.ЗаказПоставщику В
	|			(ВЫБРАТЬ
	|				ВТ.Заказ
	|			ИЗ
	|				ВТ_Заказы КАК ВТ)
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Ссылка.ЗаказПоставщику,
	|	Т.Номенклатура.А_ОбщееНазваниеНоменклатуры,
	|	Т.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ПТУ КАК ПТУ,
	|	ВТ.Заказ КАК Заказ
	|ИЗ
	|	ВТ_ЗаказыПТУ КАК ВТ";
	Пакет = Запрос.ВыполнитьПакет();

	Оплаты = Новый Соответствие;
	Выборка = Пакет[4].Выбрать();
	Пока Выборка.Следующий() Цикл
		Оплаты.Вставить(Выборка.Заказ, Новый Структура("Счет, Оплачено, Получено, ПолученоПоКлючу",
			Выборка.Счет, Выборка.Оплачено, 0, Новый Соответствие));
	КонецЦикла;
	Выборка = Пакет[5].Выбрать();
	Пока Выборка.Следующий() Цикл
		Данные = Оплаты[Выборка.Заказ];
		Если Данные = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Данные.Получено = Данные.Получено + Выборка.Получено;
		КлючТовара = КлючТовараЗаказа(Выборка.ОбщееНазвание, Выборка.Номенклатура, "");
		Данные.ПолученоПоКлючу.Вставить(КлючТовара, ЕстьЗначение(Данные.ПолученоПоКлючу[КлючТовара]) + Выборка.Получено);
	КонецЦикла;
	ЗаказыПТУ = Новый Соответствие;
	Выборка = Пакет[6].Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаказыПТУ.Вставить(Выборка.ПТУ, Выборка.Заказ);
	КонецЦикла;
	Оплаты.Вставить("ЗаказыПТУ", ЗаказыПТУ);
	Возврат Оплаты;

КонецФункции

Функция ЕстьЗначение(Значение)
	Возврат ?(Значение = Неопределено, 0, Значение);
КонецФункции

// Ключ товара внутри заказа: общее название, иначе номенклатура, иначе текст из счёта.
Функция КлючТовараЗаказа(ОбщееНазвание, Номенклатура, Название)

	Если ЗначениеЗаполнено(ОбщееНазвание) Тогда
		Возврат "ОН|" + ВРег(СокрЛП(ОбщееНазвание.Наименование));
	КонецЕсли;
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "НОМ|" + Строка(Номенклатура.УникальныйИдентификатор());
	КонецЕсли;
	Возврат "ТЕКСТ|" + Документы.А_ПотребаЗавершенняПроекту.НормализоватьТекст(Название);

КонецФункции

// Документ потребы подразделения или ближайшего родителя («15 м», «30 м» → «МД IRC 2026»).
Функция ДокументПотребыПодразделения(ДокументыПотребы, Подразделение)

	Текущее = Подразделение;
	Пока ЗначениеЗаполнено(Текущее) Цикл
		Документ = ДокументыПотребы[Текущее];
		Если Документ <> Неопределено Тогда
			Возврат Новый Структура("Подразделение, Документ", Текущее, Документ);
		КонецЕсли;
		Текущее = Текущее.Родитель;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Строки счетов Казны: «Оплачено, не надійшло» = (сумма строки − поступления по заказу того же товара) × доля оплаты.
Процедура ДобавитьСтрокиСчетов(Группы, ДокументыПотребы, Оплаты, МоментОтчета)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Момент", МоментОтчета);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.ЗаказПоставщику КАК Заказ,
	|	Р.Подразделение КАК Подразделение,
	|	Р.Номенклатура КАК Номенклатура,
	|	Р.Номенклатура.А_ОбщееНазваниеНоменклатуры КАК ОбщееНазвание,
	|	Р.НазваниеВСчете КАК Название,
	|	Р.Сумма КАК Сумма
	|ИЗ
	|	РегистрСведений.А_ТоварыСчетовПоставщиков КАК Р
	|ГДЕ
	|	Р.ЗаказПоставщику <> ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)
	|	И Р.ДатаСчета <= &Момент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Р.ДатаСчета,
	|	Р.СчетКазнаУИД,
	|	Р.НомерПозиции";
	Выборка = Запрос.Выполнить().Выбрать();
	ОстатокПолучено = Новый Соответствие;   // Заказ|КлючТовара → ещё не распределённое поступление
	Пока Выборка.Следующий() Цикл
		Привязка = ДокументПотребыПодразделения(ДокументыПотребы, Выборка.Подразделение);
		Данные = Оплаты[Выборка.Заказ];
		Если Привязка = Неопределено Или Данные = Неопределено Или Данные.Счет <= 0 Тогда
			Продолжить;
		КонецЕсли;
		КлючТовара = КлючТовараЗаказа(Выборка.ОбщееНазвание, Выборка.Номенклатура, Выборка.Название);
		КлючОстатка = Строка(Выборка.Заказ.УникальныйИдентификатор()) + "|" + КлючТовара;
		Остаток = ОстатокПолучено[КлючОстатка];
		Если Остаток = Неопределено Тогда
			Остаток = ЕстьЗначение(Данные.ПолученоПоКлючу[КлючТовара]);
		КонецЕсли;
		НеНадійшло = Макс(0, Выборка.Сумма - Остаток);
		ОстатокПолучено.Вставить(КлючОстатка, Макс(0, Остаток - Выборка.Сумма));
		Сумма = Окр(НеНадійшло * Мин(1, Данные.Оплачено / Данные.Счет), 2);
		Если Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ОбщееНазвание) Или ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			Ключ = КлючГруппы(Привязка.Подразделение, Выборка.ОбщееНазвание, Выборка.Номенклатура, Неопределено);
		Иначе
			Ключ = Строка(Привязка.Подразделение.УникальныйИдентификатор()) + "|ТЕКСТ|"
				+ Документы.А_ПотребаЗавершенняПроекту.НормализоватьТекст(Выборка.Название);
		КонецЕсли;
		Группа = ГруппаПоКлючу(Группы, Ключ, Привязка.Подразделение, Привязка.Документ);
		Если Не ЗначениеЗаполнено(Группа.ОбщееНазвание) И ЗначениеЗаполнено(Выборка.ОбщееНазвание) Тогда
			Группа.ОбщееНазвание = Выборка.ОбщееНазвание;
		КонецЕсли;
		Если Группа.Имя = "" Тогда
			Группа.Имя = ?(ЗначениеЗаполнено(Выборка.ОбщееНазвание), СокрЛП(Выборка.ОбщееНазвание.Наименование),
				СокрЛП(Выборка.Название));
		КонецЕсли;
		Группа.СтрокиСчетов.Добавить(Новый Структура("Заказ, Название, Сумма", Выборка.Заказ, Выборка.Название, Сумма));
	КонецЦикла;

КонецПроцедуры

// Строка закупки: Оплачено = сумма × min(1, оплачено по заказу / получено по заказу); Борг = сумма − Оплачено.
Процедура ЗаполнитьОплатуЗакупки(НоваяСтрока, СтрокаПФ, Оплаты)

	Заказ = Оплаты["ЗаказыПТУ"][СтрокаПФ.Документ];
	Данные = ?(Заказ = Неопределено, Неопределено, Оплаты[Заказ]);
	Если Данные = Неопределено Или Данные.Получено <= 0 Тогда
		Возврат;
	КонецЕсли;
	НоваяСтрока.Оплачено = Окр(СтрокаПФ.ФактГрн * Мин(1, Данные.Оплачено / Данные.Получено), 2);
	НоваяСтрока.Борг = СтрокаПФ.ФактГрн - НоваяСтрока.Оплачено;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
