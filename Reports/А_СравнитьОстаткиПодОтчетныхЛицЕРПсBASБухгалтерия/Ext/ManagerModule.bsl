// См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов.
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
    
    // Описание основного варианта
    НастройкиОтчета.ОпределитьНастройкиФормы = Истина;
    
    // Размещение в разделах командного интерфейса
    НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "А_СравнитьОстаткиПодОтчетныхЛицЕРПсBASБухгалтерия");
    НастройкиВарианта.Описание = НСтр("ru='Сравнить остатки подотчетных лиц ЕРП с Бухгалтерия';uk='Порівняти залишки підзвітних осіб ЕРП з Бухгалтерія'");
    НастройкиВарианта.Размещение.Вставить(Метаданные.Подсистемы.ФинансовыйРезультатИКонтроллинг); // указать нужную подсистему
    
КонецПроцедуры

