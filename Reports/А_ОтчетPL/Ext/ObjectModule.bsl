#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	УстановитьПривилегированныйРежим(Истина);

	// Берём только период — отбор по Организации/Подразделению делает сама СКД на готовом наборе.
	ПараметрПериод = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Период").Значение;
	НачалоПериода = НачалоДня(ПараметрПериод.ДатаНачала);
	КонецПериода = КонецДня(ПараметрПериод.ДатаОкончания);

	ПараметрВД = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ВключатьДочерние");
	ВключатьДочерние = ?(ПараметрВД <> Неопределено, ПараметрВД.Значение, Ложь);

	// 3 окремі Boolean-параметри для фільтра розділів (default = усі Истина — поточна поведінка).
	П_PL    = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПоказPL");
	П_ЕРП   = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПоказЕРП");
	П_Казна = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПоказКазна");
	ПоказPL    = ?(П_PL    <> Неопределено, П_PL.Значение,    Истина);
	ПоказЕРП   = ?(П_ЕРП   <> Неопределено, П_ЕРП.Значение,   Истина);
	ПоказКазна = ?(П_Казна <> Неопределено, П_Казна.Значение, Истина);

	ТаблицаДанных = ПолучитьОбъединенныеДанные(НачалоПериода, КонецПериода, ВключатьДочерние,
		ПоказPL, ПоказЕРП, ПоказКазна);

	// Аналитика1 (строка) — представление аналитики для группировки в СКД.
	// Логика по требованию финансиста (2026-05-21):
	//   - для ЕРП/Каса-строк (СуммаЕРП<>0 или СуммаКазны<>0) — СокрЛП(Аналитика)
	//   - для PL-строк (Ф1/Ф2/PL) — СокрЛП(Комментарий) (обрезанный до 1000 символов в SQL)
	Если ТаблицаДанных.Колонки.Найти("Аналитика1") = Неопределено Тогда
		ТаблицаДанных.Колонки.Добавить("Аналитика1", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Для Каждого Стр Из ТаблицаДанных Цикл
		Если Стр.СуммаЕРП <> 0
			ИЛИ Стр.СуммаДДСизКазныРасход <> 0
			ИЛИ Стр.СуммаДДСизКазныПриход <> 0 Тогда
			Стр.Аналитика1 = СокрЛП(Строка(Стр.Аналитика));
		Иначе
			Стр.Аналитика1 = СокрЛП(Строка(Стр.Комментарий));
		КонецЕсли;
	КонецЦикла;

	ВнешниеНаборыДанных = Новый Структура("Данные", ТаблицаДанных);

	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает ссылку на ДДС, у которой установлен флаг А_ПриёмникСебестоимостиПродажPL.
// Если такой нет — возвращает ПустаяСсылка (тогда CoGS не появляется в отчёте).
//
// Используется для маркировки "Приёмника CoGS" — финансист ставит флаг на одной ДДС,
// и вся себестоимость продаж за период вешается на ту PL-статью, в ТЧ Статьи которой
// добавлена эта ДДС.
//
Функция ПолучитьДДСПриёмникCoGS()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ссылка
	|ИЗ
	|	Справочник.СтатьиДвиженияДенежныхСредств
	|ГДЕ
	|	А_ПриёмникСебестоимостиПродажPL
	|	И НЕ ПометкаУдаления";

	Рез = Запрос.Выполнить().Выгрузить();
	Если Рез.Количество() = 0 Тогда
		Возврат Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
	КонецЕсли;

	Возврат Рез[0].Ссылка;

КонецФункции

// Собираем ВСЁ за период без серверной фильтрации по Организации/Подразделению —
// финальный отбор делает СКД через настройки варианта.
//
// АРХИТЕКТУРА ИСТОЧНИКОВ (после доработки 2026-04-25):
//   PL     — Документ.А_ОтчетPL.ДанныеОтчета
//   ЕРП Дх — РегистрНакопления.ВыручкаИСебестоимостьПродаж (Виручка з Реалізацій,
//            СтатьяДоходов хардкодом = "ВыручкаОтПродаж")
//          + РегистрНакопления.ПрочиеДоходы (інші доходи: Курсові, ФінДіяльність)
//   ЕРП Рх — РегистрНакопления.ПрочиеРасходы (ВСЕ расходы, первичный регистр)
//            включая ЗП (из документа ОтражениеЗарплатыВФинансовомУчете),
//            амортизацию, аренду, материалы, услуги и т.д.
//   ЕРП CoGS — РегистрНакопления.ВыручкаИСебестоимостьПродаж (СтоимостьУпрБезНДС),
//              ДДС = маркер з Справочник.СтатьиДвиженияДенежныхСредств.А_ПриёмникСебестоимостиПродажPL.
//
// Перехід Виручки з ФинансовыеРезультаты на ВыручкаИСебестоимостьПродаж зроблено
// 2026-04-25: ФР писалося документом РасчетСебестоимостиТоваров (закриваюча
// агрегація — 56.9M з 63M Виручки), що ламало drill-down. ВиР пише тільки Реалізації.
//
Функция ПолучитьОбъединенныеДанные(НачалоПериода, КонецПериода, ВключатьДочерние = Ложь,
	ПоказPL = Истина, ПоказЕРП = Истина, ПоказКазна = Истина) Экспорт

	Запрос = Новый Запрос;

	Запрос.Текст =
	"// ======================================================================
	|// PL-данные из документа (1 строка на PL-статью × Подразделение × Документ)
	|ВЫБРАТЬ
	|	ТЧ.Ссылка КАК Документ,
	|	ТЧ.Ссылка.Подразделение КАК Подразделение,
	|	ТЧ.Ссылка.ПодразделениеСтрока КАК ПодразделениеСтрока,
	|	ТЧ.Статья КАК СтатьяPL,
	|	ТЧ.Статья.Группа КАК Группа,
	|	СУММА(ТЧ.СуммаФома1) КАК СуммаФ1,
	|	СУММА(ТЧ.СуммаФорма2) КАК СуммаФ2,
	|	СУММА(ТЧ.Сумма) КАК СуммаPL,
	|	МАКСИМУМ(ВЫРАЗИТЬ(ТЧ.Комментарий КАК Строка(1000))) КАК Комментарий
	|ПОМЕСТИТЬ втPL
	|ИЗ Документ.А_ОтчетPL.ДанныеОтчета КАК ТЧ
	|ГДЕ ТЧ.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ ТЧ.Ссылка.ПометкаУдаления
	|	И ТЧ.Ссылка.ВключатьДочерние = &ВключатьДочерние
	|СГРУППИРОВАТЬ ПО
	|	ТЧ.Ссылка, ТЧ.Ссылка.Подразделение, ТЧ.Ссылка.ПодразделениеСтрока,
	|	ТЧ.Статья, ТЧ.Статья.Группа
	|;
	|
	|// ======================================================================
	|// Связь PL-статья → ДДС (все строки ТЧ Статьи).
	|// Уникальность (одна ДДС в одной PL) гарантирована модулем объекта А_Статьи_PL.
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтатьиТЧ.Ссылка КАК СтатьяPL,
	|	СтатьиТЧ.СтатьяДвиженияДенежныхСредств КАК ДДС
	|ПОМЕСТИТЬ втPL_ДДС
	|ИЗ Справочник.А_Статьи_PL.Статьи КАК СтатьиТЧ
	|ГДЕ НЕ СтатьиТЧ.Ссылка.ПометкаУдаления
	|	И СтатьиТЧ.СтатьяДвиженияДенежныхСредств <> ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|;
	|
	|// ======================================================================
	|// ЕРП-расходы с детализацией до регистратора (как в АнализДоходовРасходов).
	|// Источник: ПрочиеРасходы (первичный регистр всех расходов включая ЗП).
	|// +Контрагент (з шапки документа-регістратора — тільки для основних типів).
	|// +Аналитика (Контрагент / ПодотчетноеЛицо / А_ФизическоеЛицо в зависимости от типа регистратора).
	|// Источник переведён на прямую таблицу регистра (вместо .Обороты), чтобы
	|// иметь доступ к реквизиту А_ФизическоеЛицо для расшифровки ОЗП по ФизЛицу.
	|// Семантика СуммаЕРП = СУММА(Сумма) ТОЛЬКО по ВидДвижения=Приход —
	|// 1-в-1 как было `Р.СуммаПриход` через `.Обороты()`. ВАЖНО: НЕ вычитать Расход,
	|// иначе для подразделений с перераспределением (РаспределениеПрочихЗатрат)
	|// оборот=0, суммы исчезают из PL-отчёта.
	|ВЫБРАТЬ
	|	Р.Подразделение КАК Подразделение,
	|	Р.СтатьяРасходов.А_СтатьяДвиженияДенежныхСредств КАК ДДС,
	|	Р.Регистратор КАК Документ,
	|	ВЫБОР
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ПриобретениеТоваровУслуг
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ПриобретениеТоваровУслуг).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.РасходныйКассовыйОрдер
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.РасходныйКассовыйОрдер).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.СписаниеБезналичныхДенежныхСредств
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.СписаниеБезналичныхДенежныхСредств).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.АктВыполненныхРабот
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.АктВыполненныхРабот).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ВозвратТоваровПоставщику
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ВозвратТоваровПоставщику).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ПриходныйКассовыйОрдер).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ПоступлениеБезналичныхДенежныхСредств
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ПоступлениеБезналичныхДенежныхСредств).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ВозвратТоваровОтКлиента
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ВозвратТоваровОтКлиента).Контрагент
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Р.Регистратор ССЫЛКА Документ.АвансовыйОтчет
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.АвансовыйОтчет).ПодотчетноеЛицо
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ОтражениеЗарплатыВФинансовомУчете
	|			ТОГДА Р.А_ФизическоеЛицо
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ПриобретениеТоваровУслуг
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ПриобретениеТоваровУслуг).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.РасходныйКассовыйОрдер
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.РасходныйКассовыйОрдер).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.СписаниеБезналичныхДенежныхСредств
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.СписаниеБезналичныхДенежныхСредств).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.АктВыполненныхРабот
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.АктВыполненныхРабот).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ВозвратТоваровПоставщику
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ВозвратТоваровПоставщику).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ПриходныйКассовыйОрдер).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ПоступлениеБезналичныхДенежныхСредств
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ПоступлениеБезналичныхДенежныхСредств).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ВозвратТоваровОтКлиента
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ВозвратТоваровОтКлиента).Контрагент
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК Аналитика,
	|	СУММА(Р.Сумма) КАК СуммаЕРП,
	|	СУММА(ВЫБОР КОГДА Р.ФормаPL = ЗНАЧЕНИЕ(Перечисление.А_ФормыPL.Форма2) ТОГДА 0 ИНАЧЕ Р.Сумма КОНЕЦ) КАК СуммаЕРПФ1,
	|	СУММА(ВЫБОР КОГДА Р.ФормаPL = ЗНАЧЕНИЕ(Перечисление.А_ФормыPL.Форма2) ТОГДА Р.Сумма ИНАЧЕ 0 КОНЕЦ) КАК СуммаЕРПФ2
	|ПОМЕСТИТЬ втЕРП_Расх_Детали
	|ИЗ РегистрНакопления.ПрочиеРасходы КАК Р
	|ГДЕ Р.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Р.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И Р.СтатьяРасходов <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка)
	|	И Р.СтатьяРасходов.А_СтатьяДвиженияДенежныхСредств <> ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|СГРУППИРОВАТЬ ПО
	|	Р.Подразделение, Р.СтатьяРасходов.А_СтатьяДвиженияДенежныхСредств, Р.Регистратор,
	|	ВЫБОР
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ПриобретениеТоваровУслуг
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ПриобретениеТоваровУслуг).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.РасходныйКассовыйОрдер
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.РасходныйКассовыйОрдер).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.СписаниеБезналичныхДенежныхСредств
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.СписаниеБезналичныхДенежныхСредств).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.АктВыполненныхРабот
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.АктВыполненныхРабот).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ВозвратТоваровПоставщику
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ВозвратТоваровПоставщику).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ПриходныйКассовыйОрдер).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ПоступлениеБезналичныхДенежныхСредств
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ПоступлениеБезналичныхДенежныхСредств).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ВозвратТоваровОтКлиента
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ВозвратТоваровОтКлиента).Контрагент
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
