	|ПОМЕСТИТЬ втЕРП_ПоPL_Расх
	|ИЗ втЕРП_Расх_Детали КАК ЕРПР
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ втPL_ДДС КАК PLДДС ПО PLДДС.ДДС = ЕРПР.ДДС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕРПР.Подразделение КАК Подразделение,
	|	ЕРПР.Подразделение.А_НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ВЫРАЗИТЬ("""" КАК Строка(150)) КАК ПодразделениеСтрока,
	|	PLДДС.СтатьяPL.Группа КАК Группа,
	|	PLДДС.СтатьяPL КАК СтатьяPL,
	|	ЕРПР.ДДС КАК ДДС,
	|	0 КАК СуммаФ1,
	|	0 КАК СуммаФ2,
	|	0 КАК СуммаPL,
	|	ЕРПР.СуммаЕРП КАК СуммаЕРП,
	|	-ЕРПР.СуммаЕРП КАК Разница,
	|	ЕРПР.Документ КАК Документ,
	|	ВЫРАЗИТЬ("""" КАК Строка(1000)) КАК Комментарий,
	|	0 КАК СуммаДДСизКазныРасход,
	|	0 КАК СуммаДДСизКазныПриход,
	|	ЕРПР.Контрагент КАК Контрагент,
	|	ЕРПР.Контрагент КАК Аналитика,
	|	ЕРПР.СуммаЕРП,
	|	0,
	|	-ЕРПР.СуммаЕРП,
	|	0
	|ИЗ втЕРП_CoGS_Детали КАК ЕРПР
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ втPL_ДДС КАК PLДДС ПО PLДДС.ДДС = ЕРПР.ДДС
	|;
	|
	|// ЕРП-детали доходов, привязанные к PL через СтатьяДоходов из справочника А_Статьи_PL.
	|ВЫБРАТЬ
	|	ЕРПД.Подразделение КАК Подразделение,
	|	ЕРПД.Подразделение.А_НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ВЫРАЗИТЬ("""" КАК Строка(150)) КАК ПодразделениеСтрока,
	|	PLДДС.СтатьяPL.Группа КАК Группа,
	|	PLДДС.СтатьяPL КАК СтатьяPL,
	|	PLДДС.ДДС КАК ДДС,
	|	0 КАК СуммаФ1,
	|	0 КАК СуммаФ2,
	|	0 КАК СуммаPL,
	|	СУММА(ЕРПД.СуммаЕРП) КАК СуммаЕРП,
	|	-СУММА(ЕРПД.СуммаЕРП) КАК Разница,
	|	ЕРПД.Документ КАК Документ,
	|	ВЫРАЗИТЬ("""" КАК Строка(1000)) КАК Комментарий,
	|	0 КАК СуммаДДСизКазныРасход,
	|	0 КАК СуммаДДСизКазныПриход,
	|	ЕРПД.Контрагент КАК Контрагент,
	|	ЕРПД.Контрагент КАК Аналитика,
	|	СУММА(ЕРПД.СуммаЕРП) КАК СуммаЕРПФ1,
	|	0 КАК СуммаЕРПФ2,
	|	-СУММА(ЕРПД.СуммаЕРП) КАК РазницаФ1,
	|	0 КАК РазницаФ2
	|ПОМЕСТИТЬ втЕРП_ПоPL_Доходы
	|ИЗ втЕРП_Доходы_Детали КАК ЕРПД
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ втPL_ДДС КАК PLДДС
	|		ПО PLДДС.ДДС = ЕРПД.СтатьяДоходов.А_СтатьяДвиженияДенежныхСредств
	|СГРУППИРОВАТЬ ПО
	|	ЕРПД.Подразделение, ЕРПД.Подразделение.А_НаправлениеДеятельности,
	|	PLДДС.СтатьяPL, PLДДС.СтатьяPL.Группа, PLДДС.ДДС, ЕРПД.Документ, ЕРПД.Контрагент
	|;
	|
	|// ======================================================================
	|// ЕРП без PL: ДДС/СтатьяДоходов не привязаны ни к одной А_Статьи_PL (аномалия).
	|ВЫБРАТЬ
	|	ЕРПР.Подразделение,
	|	ЕРПР.Подразделение.А_НаправлениеДеятельности,
	|	ВЫРАЗИТЬ("""" КАК Строка(150)),
	|	NULL, NULL,
	|	ЕРПР.ДДС,
	|	0, 0, 0,
	|	ЕРПР.СуммаЕРП,
	|	-ЕРПР.СуммаЕРП,
	|	ЕРПР.Документ,
	|	ВЫРАЗИТЬ("""" КАК Строка(1000)),
	|	0,
	|	0,
	|	ЕРПР.Контрагент,
	|	ЕРПР.Аналитика,
	|	ЕРПР.СуммаЕРПФ1,
	|	ЕРПР.СуммаЕРПФ2,
	|	-ЕРПР.СуммаЕРПФ1,
	|	-ЕРПР.СуммаЕРПФ2
	|ПОМЕСТИТЬ втЕРП_БезPL_Расх
	|ИЗ втЕРП_Расх_Детали КАК ЕРПР
	|ГДЕ НЕ ЕРПР.ДДС В (ВЫБРАТЬ PLД.ДДС ИЗ втPL_ДДС КАК PLД)
	|;
	|
	|ВЫБРАТЬ
	|	ЕРПД.Подразделение,
	|	ЕРПД.Подразделение.А_НаправлениеДеятельности,
	|	ВЫРАЗИТЬ("""" КАК Строка(150)),
	|	NULL, NULL, NULL,
	|	0, 0, 0,
	|	ЕРПД.СуммаЕРП,
	|	-ЕРПД.СуммаЕРП,
	|	ЕРПД.Документ,
	|	ВЫРАЗИТЬ("""" КАК Строка(1000)),
	|	0,
	|	0,
	|	ЕРПД.Контрагент,
	|	ЕРПД.Контрагент,
	|	ЕРПД.СуммаЕРП,
	|	0,
	|	-ЕРПД.СуммаЕРП,
	|	0
	|ПОМЕСТИТЬ втЕРП_БезPL_Доход
	|ИЗ втЕРП_Доходы_Детали КАК ЕРПД
	|ГДЕ НЕ ЕРПД.СтатьяДоходов.А_СтатьяДвиженияДенежныхСредств В
	|	(ВЫБРАТЬ PLД.ДДС ИЗ втPL_ДДС КАК PLД)
	|;
	|
	|// ======================================================================
	|// Каса прив'язана до PL через ДДС (довідка для фінансиста — касовий метод)
	|// Документ — поле з регістра (парний ERP-документ або сам Перенос рухів з Казни)
	|ВЫБРАТЬ
	|	К.Подразделение                                                              КАК Подразделение,
	|	К.Подразделение.А_НаправлениеДеятельности                                    КАК НаправлениеДеятельности,
	|	ВЫРАЗИТЬ("""" КАК Строка(150))                                               КАК ПодразделениеСтрока,
	|	PLДДС.СтатьяPL.Группа                                                        КАК Группа,
	|	PLДДС.СтатьяPL                                                               КАК СтатьяPL,
	|	К.ДДС                                                                        КАК ДДС,
	|	0 КАК СуммаФ1, 0 КАК СуммаФ2, 0 КАК СуммаPL,
	|	0 КАК СуммаЕРП, 0 КАК Разница,
	|	К.Документ                                                                   КАК Документ,
	|	ВЫРАЗИТЬ("""" КАК Строка(1000))                                              КАК Комментарий,
	|	К.СуммаКазнаРасход                                                           КАК СуммаДДСизКазныРасход,
	|	К.СуммаКазнаПриход                                                           КАК СуммаДДСизКазныПриход,
	|	К.Контрагент                                                                 КАК Контрагент,
	|	К.Контрагент                                                                 КАК Аналитика,
	|	0 КАК СуммаЕРПФ1,
	|	0 КАК СуммаЕРПФ2,
	|	0 КАК РазницаФ1,
	|	0 КАК РазницаФ2
	|ПОМЕСТИТЬ втКазна_ПоPL
	|ИЗ втКазна_ПоПодрДДС КАК К
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ втPL_ДДС КАК PLДДС ПО PLДДС.ДДС = К.ДДС
	|;
	|
	|// Каса БЕЗ зв'язку з PL (внутрішньогрупові, транзит — для повноти аналітики)
	|ВЫБРАТЬ
	|	К.Подразделение,
	|	К.Подразделение.А_НаправлениеДеятельности,
	|	ВЫРАЗИТЬ("""" КАК Строка(150)),
	|	NULL,
	|	NULL,
	|	К.ДДС,
	|	0, 0, 0, 0, 0,
	|	К.Документ,
	|	ВЫРАЗИТЬ("""" КАК Строка(1000)),
	|	К.СуммаКазнаРасход,
	|	К.СуммаКазнаПриход,
	|	К.Контрагент,
	|	К.Контрагент,
	|	0,
	|	0,
	|	0,
	|	0
	|ПОМЕСТИТЬ втКазна_БезPL
	|ИЗ втКазна_ПоПодрДДС КАК К
	|ГДЕ НЕ К.ДДС В (ВЫБРАТЬ PLД.ДДС ИЗ втPL_ДДС КАК PLД)
	|;
	|
	|// ======================================================================
	|// Финальное объединение
	|ВЫБРАТЬ * ИЗ втPL_Строки      ГДЕ &ПоказPL
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ * ИЗ втЕРП_ПоPL_Расх  ГДЕ &ПоказЕРП
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ * ИЗ втЕРП_ПоPL_Доходы ГДЕ &ПоказЕРП
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ * ИЗ втЕРП_БезPL_Расх ГДЕ &ПоказЕРП
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ * ИЗ втЕРП_БезPL_Доход ГДЕ &ПоказЕРП
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ * ИЗ втКазна_ПоPL    ГДЕ &ПоказКазна
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ * ИЗ втКазна_БезPL   ГДЕ &ПоказКазна
	|";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("ВключатьДочерние", ВключатьДочерние);
	Запрос.УстановитьПараметр("ДДСCoGS", ПолучитьДДСПриёмникCoGS());
	Запрос.УстановитьПараметр("ПоказPL", ПоказPL);
	Запрос.УстановитьПараметр("ПоказЕРП", ПоказЕРП);
	Запрос.УстановитьПараметр("ПоказКазна", ПоказКазна);

	Возврат Запрос.Выполнить().Выгрузить();

