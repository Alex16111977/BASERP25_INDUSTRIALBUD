
#Область ПрограммныйИнтерфейс

// Загружает строки работ в ТЧ Работы переданной структуры себестоимости.
// СтруктураСеб - СправочникСсылка.А_СтруктураСебестоимости
// МассивСтрок  - Массив структур {Этап:Строка, Работа:Строка, Количество:Число}
// Возврат      - Структура с протоколом загрузки.
Функция ЗагрузитьРаботыИзМассива(СтруктураСеб, МассивСтрок) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Загружено", 0);
	Результат.Вставить("СозданоРабот", 0);
	Результат.Вставить("СозданоЭтапов", 0);
	Результат.Вставить("Пропущено", 0);
	Результат.Вставить("Ошибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");

	Если НЕ ЗначениеЗаполнено(СтруктураСеб) Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Не указана структура себестоимости";
		Возврат Результат;
	КонецЕсли;

	ГруппаРоботи = НайтиГруппуРоботи();
	Если НЕ ЗначениеЗаполнено(ГруппаРоботи) Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Не найдена группа номенклатуры _Роботи (код 0Ц-00000016)";
		Возврат Результат;
	КонецЕсли;

	Образец = НайтиОбразецРаботы(ГруппаРоботи);
	Если НЕ ЗначениеЗаполнено(Образец) Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Не найден образец работы (артикул 1.1.1) в группе _Роботи";
		Возврат Результат;
	КонецЕсли;
	ОбъектОбразца = Образец.ПолучитьОбъект();

	КэшЭтапов = ПостроитьКэшЭтапов();
	КэшРабот  = ПостроитьКэшРабот(ГруппаРоботи);

	НачатьТранзакцию();
	Попытка
		ОбъектСеб = СтруктураСеб.ПолучитьОбъект();
		ОбъектСеб.Работы.Очистить();

		Для Каждого СтрокаДанных Из МассивСтрок Цикл
			НаимРаботы = СокрЛП("" + СтрокаДанных.Работа);
			Если ПустаяСтрока(НаимРаботы) Тогда
				Результат.Пропущено = Результат.Пропущено + 1;
				Продолжить;
			КонецЕсли;

			Этап  = ПолучитьИлиСоздатьЭтап(СтрокаДанных.Этап, КэшЭтапов, Результат);
			Работа = ПолучитьИлиСоздатьРаботу(НаимРаботы, ГруппаРоботи, ОбъектОбразца, КэшРабот, Результат);

			НоваяСтрока = ОбъектСеб.Работы.Добавить();
			НоваяСтрока.Этап = Этап;
			НоваяСтрока.Работа = Работа;
			НоваяСтрока.Количество = ПолучитьЧисло(СтрокаДанных, "Количество");
			НоваяСтрока.Цена = ПолучитьЧисло(СтрокаДанных, "Цена");
			НоваяСтрока.Сумма = ПолучитьЧисло(СтрокаДанных, "Сумма");
			Результат.Загружено = Результат.Загружено + 1;
		КонецЦикла;

		ОбъектСеб.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("ЗагрузкаРаботВСС.Ошибка",
			УровеньЖурналаРегистрации.Ошибка, , СтруктураСеб, Результат.ТекстОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// === Режим «Загрузка выполнения» (документы А_ВыполнениеРаботМодулей из листов «ЗВіт (dd.mm)») ===

// Создаёт/обновляет и проводит документы-снимки выполнения по листам Excel.
// Параметры - Структура:
//   СтруктураСеб                 - СправочникСсылка.А_СтруктураСебестоимости
//   Листы                        - Массив структур {ИмяЛиста: Строка, Строки: Массив структур {Наименование, ТекстФакта}}
//   Год                          - Число (год дат документов)
//   Время                        - Дата (время документов, часть «время»)
//   Проводить                    - Булево
//   КоличествоМодулейПоУмолчанию - Число (ставится в СС при А_КоличествоМодулей = 0)
// Возврат - Структура: Ошибка, ТекстОшибки, Сообщения (Массив строк),
//   Документы (Массив структур {Лист, Дата, Ссылка, Строк, ЕВ, Действие}).
Функция ЗагрузитьВыполнениеИзДанных(Параметры) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Ошибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Сообщения", Новый Массив);
	Результат.Вставить("Документы", Новый Массив);

	СтруктураСеб = Параметры.СтруктураСеб;
	Если НЕ ЗначениеЗаполнено(СтруктураСеб) Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Не указана структура себестоимости";
		Возврат Результат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Параметры.Год) Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Не указан год дат документов";
		Возврат Результат;
	КонецЕсли;

	ТаблицаЛистов = Новый ТаблицаЗначений;
	ТаблицаЛистов.Колонки.Добавить("ИмяЛиста");
	ТаблицаЛистов.Колонки.Добавить("Дата");
	ТаблицаЛистов.Колонки.Добавить("Строки");
	Для Каждого ОписаниеЛиста Из Параметры.Листы Цикл
		ДатаЛиста = РазобратьДатуЛиста(ОписаниеЛиста.ИмяЛиста, Параметры.Год, Параметры.Время);
		Если ДатаЛиста = Неопределено Тогда
			Результат.Сообщения.Добавить(
				СтрШаблон("Лист «%1»: дата в имени не распознана — пропущен", ОписаниеЛиста.ИмяЛиста));
			Продолжить;
		КонецЕсли;
		СтрокаЛиста = ТаблицаЛистов.Добавить();
		СтрокаЛиста.ИмяЛиста = ОписаниеЛиста.ИмяЛиста;
		СтрокаЛиста.Дата     = ДатаЛиста;
		СтрокаЛиста.Строки   = ОписаниеЛиста.Строки;
	КонецЦикла;
	Если ТаблицаЛистов.Количество() = 0 Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Нет ни одного листа с распознанной датой «ЗВіт (дд.мм)»";
		Возврат Результат;
	КонецЕсли;
	// Снимки проводить строго в хронологическом порядке (дельта против предыдущего).
	ТаблицаЛистов.Сортировать("Дата Возр");

	// Домиковый режим (КоличествоДомов > 1): на лист-дату - по документу на каждый
	// домик-подразделение, строки ТЧ с НомерМодуля = номер домика (ключи РС не пересекаются).
	КоличествоДомов = СтруктураСеб.КоличествоДомов;
	Домики = Неопределено;
	Если КоличествоДомов > 1 Тогда
		Домики = ПодразделенияДомиковСС(СтруктураСеб, КоличествоДомов, Результат);
		Если Домики = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		КоличествоМодулей = КоличествоДомов;
		Результат.Сообщения.Добавить(
			СтрШаблон("Режим по домам: %1 документов на каждый лист (КоличествоДомов у СС)",
				Формат(КоличествоДомов, "ЧГ=0")));
	Иначе
		КоличествоМодулей = ОбеспечитьКоличествоМодулейСС(
			СтруктураСеб, Параметры.КоличествоМодулейПоУмолчанию, Результат);
		Если КоличествоМодулей = 0 Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	РаботыСС = РаботыСтруктурыСебестоимости(СтруктураСеб);
	Если РаботыСС.Количество() = 0 Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "У структуры себестоимости пуста табличная часть Работы";
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Для Каждого СтрокаЛиста Из ТаблицаЛистов Цикл
			ПроцентыРабот = ПроцентыРаботЛиста(СтрокаЛиста, РаботыСС, КоличествоМодулей, Результат);
			Если КоличествоДомов > 1 Тогда
				Для НомерДомика = 1 По КоличествоДомов Цикл
					ОписаниеДок = ЗагрузитьСнимокЛиста(СтрокаЛиста, СтруктураСеб,
						КоличествоМодулей, РаботыСС, ПроцентыРабот, Параметры.Проводить,
						Результат, НомерДомика, Домики.Получить(НомерДомика));
					Результат.Документы.Добавить(ОписаниеДок);
				КонецЦикла;
			Иначе
				ОписаниеДок = ЗагрузитьСнимокЛиста(СтрокаЛиста, СтруктураСеб,
					КоличествоМодулей, РаботыСС, ПроцентыРабот, Параметры.Проводить,
					Результат, 0, Неопределено);
				Результат.Документы.Добавить(ОписаниеДок);
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = ОписаниеОшибки();
		Результат.Документы.Очистить();
		ЗаписьЖурналаРегистрации("ЗагрузкаВыполненияРаботМодулей.Ошибка",
			УровеньЖурналаРегистрации.Ошибка, , СтруктураСеб, Результат.ТекстОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Анализ листов без записи (предпросмотр): дата и сопоставление работ с СС.
// Параметры - как у ЗагрузитьВыполнениеИзДанных (Время/Проводить/КоличествоМодулей не используются).
// Возврат - Структура: Ошибка, ТекстОшибки,
//   Листы (Массив структур {ИмяЛиста, Дата, СтрокВсего, Сопоставлено}).
Функция ПроанализироватьЛисты(Параметры) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Ошибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Листы", Новый Массив);

	Если НЕ ЗначениеЗаполнено(Параметры.СтруктураСеб) Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Не указана структура себестоимости";
		Возврат Результат;
	КонецЕсли;

	РаботыСС = РаботыСтруктурыСебестоимости(Параметры.СтруктураСеб);

	Для Каждого ОписаниеЛиста Из Параметры.Листы Цикл
		Сопоставлено = 0;
		Для Каждого СтрокаДанных Из ОписаниеЛиста.Строки Цикл
			Если РаботыСС.Получить(НормКлючРаботы(СтрокаДанных.Наименование)) <> Неопределено Тогда
				Сопоставлено = Сопоставлено + 1;
			КонецЕсли;
		КонецЦикла;
		ОписаниеРезультата = Новый Структура;
		ОписаниеРезультата.Вставить("ИмяЛиста", ОписаниеЛиста.ИмяЛиста);
		ОписаниеРезультата.Вставить("Дата",
			РазобратьДатуЛиста(ОписаниеЛиста.ИмяЛиста, Параметры.Год, Параметры.Время));
		ОписаниеРезультата.Вставить("СтрокВсего", ОписаниеЛиста.Строки.Количество());
		ОписаниеРезультата.Вставить("Сопоставлено", Сопоставлено);
		Результат.Листы.Добавить(ОписаниеРезультата);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Разбирает текст «Факт виконання робіт по проекту» в массив накопленных процентов по модулям.
// Форматы (эталон - парс_проценты в test_vrm_e2e.py):
//   «5 модулів --100%;1 модуль --50% 2 модулі --30%» -> сегменты заполняют модули М1..М_N, хвост нули;
//   «4 модуля 50%» (без дефисов) -> то же; «0%»/«P%» без числа модулей -> все модули P;
//   нераспознанное («в роботі», «не ставляться», пусто) -> Неопределено.
Функция РазобратьПроцентыФакта(Знач ТекстФакта, Знач КоличествоМодулей) Экспорт

	Текст = СокрЛП("" + ТекстФакта);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// 1) Сегментный формат: тройки токенов «число, модул*, число%» (скан со сдвигом, как regex-поиск).
	Токены = ТокеныТекстаФакта(Текст);
	Сегменты = Новый Массив;
	Индекс = 0;
	Пока Индекс <= Токены.ВГраница() - 2 Цикл
		КоличествоВСегменте = ЧислоИзТокена(Токены[Индекс]);
		Процент = ПроцентИзТокена(Токены[Индекс + 2]);
		Если КоличествоВСегменте <> Неопределено
			И СтрНачинаетсяС(НРег(Токены[Индекс + 1]), "модул")
			И Процент <> Неопределено Тогда
			Сегменты.Добавить(Новый Структура("Количество, Процент", КоличествоВСегменте, Процент));
			Индекс = Индекс + 3;
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Если Сегменты.Количество() > 0 Тогда
		Проценты = Новый Массив;
		Для Каждого Сегмент Из Сегменты Цикл
			Для Счетчик = 1 По Сегмент.Количество Цикл
				Если Проценты.Количество() < КоличествоМодулей Тогда
					Проценты.Добавить(Сегмент.Процент);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Пока Проценты.Количество() < КоличествоМодулей Цикл
			Проценты.Добавить(0);
		КонецЦикла;
		Возврат Проценты;
	КонецЕсли;

	// 2) Одиночный «P%» - весь текст целиком (дефисы и прочий мусор -> не формат).
	Если СтрЗаканчиваетсяНа(Текст, "%") Тогда
		Процент = ЧислоИзТокена(СокрЛП(Лев(Текст, СтрДлина(Текст) - 1)));
		Если Процент <> Неопределено Тогда
			Проценты = Новый Массив;
			Для Счетчик = 1 По КоличествоМодулей Цикл
				Проценты.Добавить(Процент);
			КонецЦикла;
			Возврат Проценты;
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Дата документа из имени листа: «ЗВіт (дд.мм)» - день.месяц из скобок,
// «ЗВіт дд.мм» (без скобок) - первый пробельный токен вида «дд.мм»; + Год + время.
// ВремяДок - Дата (берётся часть «время») ИЛИ Число секунд от полуночи
// (числом передают COM-клиенты: маршалинг дат через win32com сдвигает значение).
// Не распозналось (нет «дд.мм», невалидная дата) -> Неопределено.
Функция РазобратьДатуЛиста(Знач ИмяЛиста, Знач Год, Знач ВремяДок) Экспорт

	ИмяЛиста = "" + ИмяЛиста;
	ПозицияОткрытия = СтрНайти(ИмяЛиста, "(");
	ПозицияЗакрытия = СтрНайти(ИмяЛиста, ")");

	ДеньМесяц = Неопределено;
	Если ПозицияОткрытия > 0 И ПозицияЗакрытия > ПозицияОткрытия Тогда
		ДеньМесяц = ДеньМесяцИзТекста(
			Сред(ИмяЛиста, ПозицияОткрытия + 1, ПозицияЗакрытия - ПозицияОткрытия - 1));
	Иначе
		Для Каждого Токен Из СтрРазделить(ИмяЛиста, " ", Ложь) Цикл
			ДеньМесяц = ДеньМесяцИзТекста(Токен);
			Если ДеньМесяц <> Неопределено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ДеньМесяц = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	СекундыВремени = 0;
	Если ТипЗнч(ВремяДок) = Тип("Число") Тогда
		СекундыВремени = ВремяДок;
	ИначеЕсли ЗначениеЗаполнено(ВремяДок) Тогда
		СекундыВремени = ВремяДок - НачалоДня(ВремяДок);
	КонецЕсли;

	Попытка
		Возврат Дата(Год, ДеньМесяц.Месяц, ДеньМесяц.День) + СекундыВремени;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает числовое значение поля структуры по имени (пусто/не число -> 0).
Функция ПолучитьЧисло(СтрокаДанных, ИмяПоля)
	Если НЕ СтрокаДанных.Свойство(ИмяПоля) Тогда
		Возврат 0;
	КонецЕсли;
	Значение = СтрокаДанных[ИмяПоля];
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

// Нормализация: убрать концевые пробелы + схлопнуть любые серии пробелов в один.
Функция НормализоватьНаименование(Знач Текст) Экспорт
	Текст = СокрЛП("" + Текст);
	Пока Найти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция НайтиГруппуРоботи()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура
	|ГДЕ Код = &Код И ЭтоГруппа";
	Запрос.УстановитьПараметр("Код", "0Ц-00000016");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция НайтиОбразецРаботы(ГруппаРоботи)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура
	|ГДЕ Артикул = &Арт И НЕ ЭтоГруппа И Родитель В ИЕРАРХИИ(&Гр)";
	Запрос.УстановитьПараметр("Арт", "1.1.1");
	Запрос.УстановитьПараметр("Гр", ГруппаРоботи);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Кэш этапов: НРег(нормализованное наименование) -> Ссылка.
Функция ПостроитьКэшЭтапов()
	Кэш = Новый Соответствие;
	Запрос = Новый Запрос("ВЫБРАТЬ Наименование, Ссылка ИЗ Справочник.А_ЭтапыРабот");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = НРег(НормализоватьНаименование(Выборка.Наименование));
		Если Кэш.Получить(Ключ) = Неопределено Тогда
			Кэш.Вставить(Ключ, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Кэш;
КонецФункции

// Кэш работ в _Роботи: НРег(нормализованное наименование) -> Ссылка.
Функция ПостроитьКэшРабот(ГруппаРоботи)
	Кэш = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Наименование, Ссылка ИЗ Справочник.Номенклатура
	|ГДЕ НЕ ЭтоГруппа И Родитель В ИЕРАРХИИ(&Гр)";
	Запрос.УстановитьПараметр("Гр", ГруппаРоботи);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = НРег(НормализоватьНаименование(Выборка.Наименование));
		Если Кэш.Получить(Ключ) = Неопределено Тогда
			Кэш.Вставить(Ключ, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Кэш;
КонецФункции

Функция ПолучитьИлиСоздатьЭтап(Знач Наим, КэшЭтапов, Результат)
	НормИмя = НормализоватьНаименование(Наим);
	Если ПустаяСтрока(НормИмя) Тогда
		Возврат Справочники.А_ЭтапыРабот.ПустаяСсылка();
	КонецЕсли;
	Ключ = НРег(НормИмя);
	Найденное = КэшЭтапов.Получить(Ключ);
	Если Найденное <> Неопределено Тогда
		Возврат Найденное;
	КонецЕсли;

	НовыйЭтап = Справочники.А_ЭтапыРабот.СоздатьЭлемент();
	НовыйЭтап.Наименование = НормИмя;
	НовыйЭтап.Записать();
	КэшЭтапов.Вставить(Ключ, НовыйЭтап.Ссылка);
	Результат.СозданоЭтапов = Результат.СозданоЭтапов + 1;
	Возврат НовыйЭтап.Ссылка;
КонецФункции

Функция ПолучитьИлиСоздатьРаботу(Знач Наим, ГруппаРоботи, ОбъектОбразца, КэшРабот, Результат)
	НормИмя = НормализоватьНаименование(Наим);
	Ключ = НРег(НормИмя);
	Найденное = КэшРабот.Получить(Ключ);
	Если Найденное <> Неопределено Тогда
		Возврат Найденное;
	КонецЕсли;

	НоваяРабота = Справочники.Номенклатура.СоздатьЭлемент();
	ЗаполнитьЗначенияСвойств(НоваяРабота, ОбъектОбразца, ,
		"Код,Артикул,Наименование,НаименованиеПолное,Ссылка,Родитель,Владелец,ПометкаУдаления,Предопределенный,ИмяПредопределенныхДанных");
	НоваяРабота.Наименование = НормИмя;
	НоваяРабота.НаименованиеПолное = НормИмя;
	НоваяРабота.Родитель = ГруппаРоботи;
	НоваяРабота.Записать();
	КэшРабот.Вставить(Ключ, НоваяРабота.Ссылка);
	Результат.СозданоРабот = Результат.СозданоРабот + 1;
	Возврат НоваяРабота.Ссылка;
КонецФункции

// === Служебные режима «Загрузка выполнения» ===

// Ключ сопоставления работ Excel<->СС: нормализация + удаление апострофов + нижний регистр
// (эталон норм() в test_vrm_e2e.py). Отдельно от НормализоватьНаименование:
// поведение старого режима загрузки работ в СС не меняем.
Функция НормКлючРаботы(Знач Наименование)
	Текст = НормализоватьНаименование(Наименование);
	Текст = СтрЗаменить(Текст, "'", "");
	Текст = СтрЗаменить(Текст, "’", "");
	Возврат НРег(Текст);
КонецФункции

// Токены текста факта: «;» и дефисы приравниваются к пробелам.
Функция ТокеныТекстаФакта(Знач Текст)
	Текст = СтрЗаменить(Текст, ";", " ");
	Текст = СтрЗаменить(Текст, "-", " ");
	Возврат СтрРазделить(Текст, " ", Ложь);
КонецФункции

// «100» / «1,5» / «1.5» -> Число; прочее -> Неопределено.
Функция ЧислоИзТокена(Знач Токен)
	Токен = СтрЗаменить(СокрЛП(Токен), ",", ".");
	Если ПустаяСтрока(Токен) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Число(Токен);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// «100%» -> 100; прочее -> Неопределено.
Функция ПроцентИзТокена(Знач Токен)
	Токен = СокрЛП(Токен);
	Если НЕ СтрЗаканчиваетсяНа(Токен, "%") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ЧислоИзТокена(Лев(Токен, СтрДлина(Токен) - 1));
КонецФункции

// N модулей для документов: из СС; при А_КоличествоМодулей = 0 устанавливает значение
// по умолчанию и записывает СС (требование задачи: без этого проценты лягут на 1 модуль).
// Возврат 0 = ошибка (описана в Результат).
Функция ОбеспечитьКоличествоМодулейСС(СтруктураСеб, Знач МодулейПоУмолчанию, Результат)

	ТекущееКоличество = СтруктураСеб.А_КоличествоМодулей;
	Если ТекущееКоличество > 0 Тогда
		Возврат ТекущееКоличество;
	КонецЕсли;

	Если НЕ МодулейПоУмолчанию > 0 Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки =
			"У структуры себестоимости А_КоличествоМодулей = 0 и не задано количество модулей по умолчанию";
		Возврат 0;
	КонецЕсли;

	ОбъектСС = СтруктураСеб.ПолучитьОбъект();
	ОбъектСС.А_КоличествоМодулей = МодулейПоУмолчанию;
	ОбъектСС.Записать();
	Результат.Сообщения.Добавить(
		СтрШаблон("У структуры себестоимости «%1» установлено количество модулей: %2",
			СтруктураСеб, Формат(МодулейПоУмолчанию, "ЧГ=0")));
	Возврат МодулейПоУмолчанию;

КонецФункции

// Работы СС: НормКлючРаботы(Наименование) -> Структура {Работа, Этап, План (на все модули)}.
// Запрос проверен Python COM на BaseERPRazr (test_vrm_razr_red.py).
Функция РаботыСтруктурыСебестоимости(СтруктураСеб)

	Результат = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СС", СтруктураСеб);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.Работа КАК Работа,
	|	Р.Работа.Наименование КАК Наименование,
	|	МАКСИМУМ(Р.Этап) КАК Этап,
	|	СУММА(Р.Количество) КАК План
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Работы КАК Р
	|ГДЕ
	|	Р.Ссылка = &СС
	|СГРУППИРОВАТЬ ПО
	|	Р.Работа,
	|	Р.Работа.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = НормКлючРаботы(Выборка.Наименование);
		Если Результат.Получить(Ключ) = Неопределено Тогда
			Результат.Вставить(Ключ,
				Новый Структура("Работа, Этап, План", Выборка.Работа, Выборка.Этап, Выборка.План));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Существующий документ-снимок по СС и дню даты (идемпотентность повторных загрузок
// устойчива к смене параметра «Время»); Подразделение <> Неопределено добавляет отбор
// (домиковый режим: на одну дату несколько документов разных подразделений).
// Запросы проверены Python COM (test_vrm_razr_red.py, test_vrm_irs_red.py).
Функция НайтиДокументСнимка(СтруктураСеб, ДатаСнимка, Знач Подразделение = Неопределено)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СС", СтруктураСеб);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ДатаСнимка));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ДатаСнимка));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Д.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.А_ВыполнениеРаботМодулей КАК Д
	|ГДЕ
	|	Д.СтруктураСебестоимости = &СС
	|	И Д.Дата МЕЖДУ &НачалоДня И &КонецДня
	|УПОРЯДОЧИТЬ ПО
	|	Д.Дата";
	Если Подразделение <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Д.Дата МЕЖДУ",
			"И Д.Подразделение = &Подразделение
			|	И Д.Дата МЕЖДУ");
		Запрос.УстановитьПараметр("Подразделение", Подразделение);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Организация документов: первая непомеченная по наименованию (в базе одна собственная;
// консистентно с эталонными документами BaseERP). Запрос проверен Python COM.
Функция ПерваяОрганизация()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	О.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК О
	|ГДЕ
	|	НЕ О.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	О.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Проценты по строкам листа: НормКлючРаботы -> массив процентов модулей 1..N.
// Работы, не найденные в СС, - сообщение в протокол (один раз на лист) и пропуск.
Функция ПроцентыРаботЛиста(СтрокаЛиста, РаботыСС, КоличествоМодулей, Результат)

	ПроцентыРабот = Новый Соответствие;
	Для Каждого СтрокаДанных Из СтрокаЛиста.Строки Цикл
		Ключ = НормКлючРаботы(СтрокаДанных.Наименование);
		Если ПустаяСтрока(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Если РаботыСС.Получить(Ключ) = Неопределено Тогда
			Результат.Сообщения.Добавить(
				СтрШаблон("Лист «%1»: работа «%2» не найдена в СС — строка пропущена",
					СтрокаЛиста.ИмяЛиста, СокрЛП(СтрокаДанных.Наименование)));
			Продолжить;
		КонецЕсли;
		Проценты = РазобратьПроцентыФакта(СтрокаДанных.ТекстФакта, КоличествоМодулей);
		Если Проценты = Неопределено Тогда
			// «в роботі», «не ставляться», пусто - снимок фиксирует нули.
			Проценты = Новый Массив;
			Для Счетчик = 1 По КоличествоМодулей Цикл
				Проценты.Добавить(0);
			КонецЦикла;
		КонецЕсли;
		ПроцентыРабот.Вставить(Ключ, Проценты);
	КонецЦикла;
	Возврат ПроцентыРабот;

КонецФункции

// Get-or-create документа-снимка одного листа: шапка, полная перезапись ТЧ, запись
// с проведением по флагу. НомерДомика = 0 - обычный режим (все модули 1..N в одном
// документе, Подразделение из СС); НомерДомика > 0 - домиковый режим (одна строка
// НомерМодуля = НомерДомика на работу, Подразделение = ПодразделениеДомика).
// Возврат - Структура {Лист, Дата, Ссылка, Строк, ЕВ, Действие, Подразделение} для протокола.
Функция ЗагрузитьСнимокЛиста(СтрокаЛиста, СтруктураСеб, КоличествоМодулей, РаботыСС,
	ПроцентыРабот, Знач Проводить, Результат, Знач НомерДомика, Знач ПодразделениеДомика)

	Если НомерДомика > 0 Тогда
		ПодразделениеДок = ПодразделениеДомика;
		ОтборПодразделения = ПодразделениеДомика;
		МеткаЛиста = СтрШаблон("Лист «%1», дом №%2", СтрокаЛиста.ИмяЛиста,
			Формат(НомерДомика, "ЧГ=0"));
	Иначе
		ПодразделениеДок = СтруктураСеб.Подразделение;
		ОтборПодразделения = Неопределено;
		МеткаЛиста = СтрШаблон("Лист «%1»", СтрокаЛиста.ИмяЛиста);
	КонецЕсли;

	ДокСсылка = НайтиДокументСнимка(СтруктураСеб, СтрокаЛиста.Дата, ОтборПодразделения);
	Если ДокСсылка <> Неопределено Тогда
		ДокОбъект = ДокСсылка.ПолучитьОбъект();
		Действие = "обновлён";
	Иначе
		ДокОбъект = Документы.А_ВыполнениеРаботМодулей.СоздатьДокумент();
		Действие = "создан";
	КонецЕсли;

	ДокОбъект.Дата = СтрокаЛиста.Дата;
	ДокОбъект.Организация = ПерваяОрганизация();
	ДокОбъект.СтруктураСебестоимости = СтруктураСеб;
	ДокОбъект.Подразделение = ПодразделениеДок;
	ДокОбъект.КоличествоМодулей = КоличествоМодулей;
	Если НомерДомика > 0 Тогда
		ДокОбъект.Комментарий = СтрШаблон("Загружено из Excel, лист «%1», дом №%2",
			СтрокаЛиста.ИмяЛиста, Формат(НомерДомика, "ЧГ=0"));
	Иначе
		ДокОбъект.Комментарий = СтрШаблон("Загружено из Excel, лист «%1»", СтрокаЛиста.ИмяЛиста);
	КонецЕсли;

	ДокОбъект.Работы.Очистить();
	ЧасыВсего = 0;
	Для Каждого КлючИОписание Из РаботыСС Цикл
		Проценты = ПроцентыРабот.Получить(КлючИОписание.Ключ);
		Если Проценты = Неопределено Тогда
			Продолжить; // работы СС нет в листе - в снимок не пишем (эталонное поведение)
		КонецЕсли;
		ОписаниеРаботы = КлючИОписание.Значение;
		ПланМодуля = ОписаниеРаботы.План / КоличествоМодулей;
		Если НомерДомика > 0 Тогда
			ЧасыВсего = ЧасыВсего + ДобавитьСтрокуВыполнения(ДокОбъект, ОписаниеРаботы,
				НомерДомика, ПланМодуля, Проценты[НомерДомика - 1]);
		Иначе
			Для НомерМодуля = 1 По КоличествоМодулей Цикл
				ЧасыВсего = ЧасыВсего + ДобавитьСтрокуВыполнения(ДокОбъект, ОписаниеРаботы,
					НомерМодуля, ПланМодуля, Проценты[НомерМодуля - 1]);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Если Проводить Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;

	ОписаниеДок = Новый Структура;
	ОписаниеДок.Вставить("Лист", СтрокаЛиста.ИмяЛиста);
	ОписаниеДок.Вставить("Дата", СтрокаЛиста.Дата);
	ОписаниеДок.Вставить("Ссылка", ДокОбъект.Ссылка);
	ОписаниеДок.Вставить("Строк", ДокОбъект.Работы.Количество());
	ОписаниеДок.Вставить("ЕВ", ЧасыВсего);
	ОписаниеДок.Вставить("Действие", Действие);
	ОписаниеДок.Вставить("Подразделение", "" + ПодразделениеДок);
	Результат.Сообщения.Добавить(
		СтрШаблон("%1: документ %2 %3, строк ТЧ %4, EV-часов %5",
			МеткаЛиста, ДокОбъект.Ссылка, Действие,
			Формат(ДокОбъект.Работы.Количество(), "ЧГ=0"), Формат(ЧасыВсего, "ЧДЦ=2")));
	Возврат ОписаниеДок;

КонецФункции

// Добавляет строку ТЧ Работы; возврат - ЧасыВыполнение строки.
Функция ДобавитьСтрокуВыполнения(ДокОбъект, ОписаниеРаботы, Знач НомерМодуля, Знач ПланМодуля, Знач Процент)

	НоваяСтрока = ДокОбъект.Работы.Добавить();
	НоваяСтрока.Работа          = ОписаниеРаботы.Работа;
	НоваяСтрока.Этап            = ОписаниеРаботы.Этап;
	НоваяСтрока.НомерМодуля     = НомерМодуля;
	НоваяСтрока.ПланЧасыМодуля  = ПланМодуля;
	НоваяСтрока.Процент         = Процент;
	НоваяСтрока.ЧасыВыполнение  = ПланМодуля * Процент / 100;
	Возврат НоваяСтрока.ЧасыВыполнение;

КонецФункции

// «дд.мм» -> Структура {День, Месяц}; прочее -> Неопределено.
Функция ДеньМесяцИзТекста(Знач Текст)

	Части = СтрРазделить(СокрЛП("" + Текст), ".", Ложь);
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДеньМесяца  = ЧислоИзТокена(Части[0]);
	НомерМесяца = ЧислоИзТокена(Части[1]);
	Если ДеньМесяца = Неопределено ИЛИ НомерМесяца = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("День, Месяц", ДеньМесяца, НомерМесяца);

КонецФункции

// Подразделения-домики: дети подразделения СС с номером после «№» в наименовании.
// Возврат - Соответствие НомерДомика -> СправочникСсылка.СтруктураПредприятия,
// либо Неопределено (ошибка описана в Результат). Запрос проверен Python COM (test_vrm_irs_red.py).
Функция ПодразделенияДомиковСС(СтруктураСеб, Знач КоличествоДомов, Результат)

	Родитель = СтруктураСеб.Подразделение;
	Если НЕ ЗначениеЗаполнено(Родитель) Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "У структуры себестоимости не заполнено подразделение";
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Родитель", Родитель);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Ссылка КАК Ссылка,
	|	П.Наименование КАК Наименование
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК П
	|ГДЕ
	|	П.Родитель = &Родитель
	|УПОРЯДОЧИТЬ ПО
	|	П.Наименование";

	Домики = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НомерДомика = НомерПослеЗнакаНомера(Выборка.Наименование);
		Если НомерДомика > 0 И Домики.Получить(НомерДомика) = Неопределено Тогда
			Домики.Вставить(НомерДомика, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Ненайденные = "";
	Для НомерДомика = 1 По КоличествоДомов Цикл
		Если Домики.Получить(НомерДомика) = Неопределено Тогда
			Ненайденные = Ненайденные + ?(Ненайденные = "", "", ", ") + "№" + Формат(НомерДомика, "ЧГ=0");
		КонецЕсли;
	КонецЦикла;
	Если Ненайденные <> "" Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = СтрШаблон(
			"Не найдены подразделения-дома %1 (дети подразделения «%2» с «№N» в наименовании)",
			Ненайденные, Родитель);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Домики;

КонецФункции

// Число сразу после «№» в наименовании; нет «№» или цифр - 0.
Функция НомерПослеЗнакаНомера(Знач Наименование)

	Наименование = "" + Наименование;
	Позиция = СтрНайти(Наименование, "№");
	Если Позиция = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Цифры = "";
	Для Индекс = Позиция + 1 По СтрДлина(Наименование) Цикл
		ТекСимвол = Сред(Наименование, Индекс, 1);
		Если ТекСимвол >= "0" И ТекСимвол <= "9" Тогда
			Цифры = Цифры + ТекСимвол;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Цифры) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Число(Цифры);

КонецФункции

#КонецОбласти
