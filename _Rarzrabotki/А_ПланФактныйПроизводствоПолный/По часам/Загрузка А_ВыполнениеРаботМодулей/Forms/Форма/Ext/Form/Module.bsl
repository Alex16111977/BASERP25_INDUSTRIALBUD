
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Дефолты нового режима; сохранённые пользователем настройки восстановятся поверх.
	Объект.Год = 2026;
	Объект.ВремяДокумента = Дата(1, 1, 1, 9, 0, 0);
	Объект.Проводить = Истина;
	Объект.КоличествоМодулейПоУмолчанию = 8;

КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "Excel (*.xlsx)|*.xlsx|Excel 97-2003 (*.xls)|*.xls|Все файлы (*.*)|*.*";
	Диалог.Заголовок = "Выберите файл Excel";
	Если ЗначениеЗаполнено(Объект.ИмяФайла) Тогда
		Диалог.ПолноеИмяФайла = Объект.ИмяФайла;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ИмяФайлаВыборЗавершение", ЭтотОбъект);
	Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаВыборЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		Объект.ИмяФайла = ВыбранныеФайлы[0];
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ЗагрузитьРаботы(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.ИмяФайла) Тогда
		Сообщить("Не указан путь к файлу Excel (реквизит «Имя файла»)");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ДокСтруктураСебестоимости) Тогда
		Сообщить("Не выбрана структура себестоимости");
		Возврат;
	КонецЕсли;

	МассивСтрок = ПрочитатьExcelВМассив(Объект.ИмяФайла);
	Если МассивСтрок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Протокол = ЗагрузитьНаСервере(МассивСтрок);
	ВывестиПротокол(Протокол);

КонецПроцедуры

&НаКлиенте
Функция ПрочитатьExcelВМассив(ИмяФайла)

	Попытка
		Excel = Новый COMОбъект("Excel.Application");
	Исключение
		Сообщить("Не удалось запустить Excel: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	МассивСтрок = Новый Массив;
	Попытка
		Excel.Workbooks.Open(ИмяФайла);
		Лист = Excel.WorkSheets(1);
		ВсегоСтрок = Лист.Cells(1, 1).SpecialCells(11).Row;

		Для Ряд = 2 По ВсегоСтрок Цикл
			НаимРаботы = СокрЛП("" + Лист.Cells(Ряд, 2).Text);
			Если ПустаяСтрока(НаимРаботы) Тогда
				Продолжить;
			КонецЕсли;

			Стр = Новый Структура("Этап, Работа, Количество, Цена, Сумма");
			Стр.Этап = СокрЛП("" + Лист.Cells(Ряд, 1).Text);
			Стр.Работа = НаимРаботы;
			Стр.Количество = ЧислоИзЯчейки(Лист.Cells(Ряд, 3).Value);
			Стр.Цена = ЧислоИзЯчейки(Лист.Cells(Ряд, 4).Value);
			Стр.Сумма = ЧислоИзЯчейки(Лист.Cells(Ряд, 5).Value);
			МассивСтрок.Добавить(Стр);
		КонецЦикла;

		Excel.ActiveWorkbook.Close(Ложь);
		Excel.Quit();
		Excel = Неопределено;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Попытка
			Excel.Quit();
		Исключение
		КонецПопытки;
		Excel = Неопределено;
		Сообщить("Ошибка чтения Excel: " + ТекстОшибки);
		Возврат Неопределено;
	КонецПопытки;

	Возврат МассивСтрок;

КонецФункции

&НаКлиенте
Функция ЧислоИзЯчейки(Значение)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

&НаСервере
Функция ЗагрузитьНаСервере(МассивСтрок)
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектОбработки.ЗагрузитьРаботыИзМассива(
		ОбъектОбработки.ДокСтруктураСебестоимости, МассивСтрок);
КонецФункции

&НаКлиенте
Процедура ВывестиПротокол(Протокол)
	Если Протокол.Ошибка Тогда
		Сообщить("ОШИБКА загрузки: " + Протокол.ТекстОшибки);
		Возврат;
	КонецЕсли;
	Сообщить("Загрузка завершена.");
	Сообщить("  Загружено строк: " + Протокол.Загружено);
	Сообщить("  Создано работ:   " + Протокол.СозданоРабот);
	Сообщить("  Создано этапов:  " + Протокол.СозданоЭтапов);
	Сообщить("  Пропущено пустых: " + Протокол.Пропущено);
КонецПроцедуры

#Область ЗагрузкаВыполнения

&НаКлиенте
Процедура ПрочитатьФайл(Команда)

	Если НЕ ПроверитьПараметрыВыполнения() Тогда
		Возврат;
	КонецЕсли;
	Листы = ПрочитатьЛистыВыполнения(Объект.ИмяФайла);
	Если Листы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Листы.Количество() = 0 Тогда
		Сообщить("В файле нет листов снимков «ЗВіт …»");
		Возврат;
	КонецЕсли;
	ПоказатьАнализНаСервере(Листы);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВыполнение(Команда)

	Если НЕ ПроверитьПараметрыВыполнения() Тогда
		Возврат;
	КонецЕсли;
	Листы = ПрочитатьЛистыВыполнения(Объект.ИмяФайла);
	Если Листы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Листы.Количество() = 0 Тогда
		Сообщить("В файле нет листов снимков «ЗВіт …»");
		Возврат;
	КонецЕсли;

	Протокол = ЗагрузитьВыполнениеНаСервере(Листы);
	Если Протокол.Ошибка Тогда
		Сообщить("ОШИБКА загрузки выполнения: " + Протокол.ТекстОшибки);
	Иначе
		Сообщить("Загрузка выполнения завершена. Документов: " + Протокол.Документы.Количество());
	КонецЕсли;
	Для Каждого ТекстСообщения Из Протокол.Сообщения Цикл
		Сообщить(ТекстСообщения);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ПроверитьПараметрыВыполнения()

	Если НЕ ЗначениеЗаполнено(Объект.ИмяФайла) Тогда
		Сообщить("Не указан путь к файлу Excel (реквизит «Имя файла»)");
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ДокСтруктураСебестоимости) Тогда
		Сообщить("Не выбрана структура себестоимости");
		Возврат Ложь;
	КонецЕсли;
	Если Объект.Год = 0 Тогда
		Сообщить("Не указан год дат документов");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Читает все листы снимков («ЗВіт (дд.мм)», «ЗВіт дд.мм») в массив структур
// {ИмяЛиста, Строки: {Наименование, ТекстФакта}}. Колонка A - наименование работы;
// колонка «Факт виконання робіт по проекту» ищется по заголовку строки 1
// (позиция плавает между файлами), fallback - G.
&НаКлиенте
Функция ПрочитатьЛистыВыполнения(ИмяФайла)

	Попытка
		Excel = Новый COMОбъект("Excel.Application");
	Исключение
		Сообщить("Не удалось запустить Excel: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Листы = Новый Массив;
	Попытка
		Excel.DisplayAlerts = Ложь;
		Excel.Workbooks.Open(ИмяФайла, , Истина);
		Для НомерЛиста = 1 По Excel.ActiveWorkbook.Sheets.Count Цикл
			Лист = Excel.ActiveWorkbook.Sheets(НомерЛиста);
			ИмяЛиста = "" + Лист.Name;
			ИмяЛистаНРег = НРег(СокрЛП(ИмяЛиста));
			Если НЕ СтрНачинаетсяС(ИмяЛистаНРег, НРег("ЗВіт")) ИЛИ ИмяЛистаНРег = НРег("ЗВіт") Тогда
				Продолжить; // «Зразок», текущий «ЗВіт» без даты и прочие листы не грузим
			КонецЕсли;
			КолонкаФакта = 7;
			Для НомерКолонки = 1 По 15 Цикл
				Если СтрНайти(НРег("" + Лист.Cells(1, НомерКолонки).Text), НРег("Факт виконання робіт")) > 0 Тогда
					КолонкаФакта = НомерКолонки;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			ВсегоСтрок = Лист.Cells(1, 1).SpecialCells(11).Row;
			Строки = Новый Массив;
			Для Ряд = 2 По ВсегоСтрок Цикл
				Наименование = СокрЛП("" + Лист.Cells(Ряд, 1).Text);
				Если ПустаяСтрока(Наименование) Тогда
					Продолжить;
				КонецЕсли;
				Если СтрНайти(Наименование, "Загальна") > 0 ИЛИ НРег(Наименование) = "табель" Тогда
					Продолжить; // итоговые строки листа - не работы
				КонецЕсли;
				СтрокаЛиста = Новый Структура("Наименование, ТекстФакта");
				СтрокаЛиста.Наименование = Наименование;
				СтрокаЛиста.ТекстФакта = СокрЛП("" + Лист.Cells(Ряд, КолонкаФакта).Text);
				Строки.Добавить(СтрокаЛиста);
			КонецЦикла;
			ОписаниеЛиста = Новый Структура("ИмяЛиста, Строки", ИмяЛиста, Строки);
			Листы.Добавить(ОписаниеЛиста);
		КонецЦикла;
		Excel.ActiveWorkbook.Close(Ложь);
		Excel.Quit();
		Excel = Неопределено;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Попытка
			Excel.ActiveWorkbook.Close(Ложь);
		Исключение
		КонецПопытки;
		Попытка
			Excel.Quit();
		Исключение
		КонецПопытки;
		Excel = Неопределено;
		Сообщить("Ошибка чтения Excel: " + ТекстОшибки);
		Возврат Неопределено;
	КонецПопытки;

	Возврат Листы;

КонецФункции

&НаСервере
Процедура ПоказатьАнализНаСервере(Листы)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Анализ = ОбъектОбработки.ПроанализироватьЛисты(ПараметрыЗагрузкиВыполнения(Листы));

	ЛистыФайла.Очистить();
	Если Анализ.Ошибка Тогда
		Сообщить("Анализ файла: " + Анализ.ТекстОшибки);
		Возврат;
	КонецЕсли;
	Для Каждого ОписаниеЛиста Из Анализ.Листы Цикл
		СтрокаТаблицы = ЛистыФайла.Добавить();
		СтрокаТаблицы.Лист = ОписаниеЛиста.ИмяЛиста;
		Если ОписаниеЛиста.Дата <> Неопределено Тогда
			СтрокаТаблицы.Дата = ОписаниеЛиста.Дата;
		КонецЕсли;
		СтрокаТаблицы.СтрокВсего = ОписаниеЛиста.СтрокВсего;
		СтрокаТаблицы.Сопоставлено = ОписаниеЛиста.Сопоставлено;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ЗагрузитьВыполнениеНаСервере(Листы)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектОбработки.ЗагрузитьВыполнениеИзДанных(ПараметрыЗагрузкиВыполнения(Листы));

КонецФункции

&НаСервере
Функция ПараметрыЗагрузкиВыполнения(Листы)

	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("СтруктураСеб", Объект.ДокСтруктураСебестоимости);
	ПараметрыЗагрузки.Вставить("Листы", Листы);
	ПараметрыЗагрузки.Вставить("Год", Объект.Год);
	ПараметрыЗагрузки.Вставить("Время", Объект.ВремяДокумента);
	ПараметрыЗагрузки.Вставить("Проводить", Объект.Проводить);
	ПараметрыЗагрузки.Вставить("КоличествоМодулейПоУмолчанию", Объект.КоличествоМодулейПоУмолчанию);
	Возврат ПараметрыЗагрузки;

КонецФункции

#КонецОбласти
