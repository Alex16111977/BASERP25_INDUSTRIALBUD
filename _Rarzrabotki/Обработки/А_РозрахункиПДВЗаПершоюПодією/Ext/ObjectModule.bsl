#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Обробка «Розрахунки ПДВ за першою подією (вирівнювання 6442)» — BAS Бухгалтерія.
//
// Рішення «перша/друга подія» приймає НалоговыйУчет.ДвиженияПоРегистрамНалоговогоУчетаУпрощенныйНалоговыйУчет
// за залишками РН ПриобретенияНалоговыйУчет на МоментВремени документа:
//     ПС = max(надходження, оплати)_після − max(надходження, оплати)_до.
// Документ, проведений у базі РАНІШЕ свого «сусіда» з ранішою датою, не бачить його і лишається першою подією →
// задвоєння 6442. РН ПриобретенияНалоговыйУчет пишеться однаково за будь-якого порядку проведення, тому «правильну»
// ПС кожного документа можна перерахувати хронологічним проходом і порівняти з фактом — РН
// ОжидаемыйИПодтвержденныйНДСПриобретений (КодОперации = ОжидаемыйНДС). Розбіжні документи перепроводяться.
// Перепроведення не лишає документ у черзі обміну з ЕРП, якщо до перепроведення його там не було.
// Промт/спека: docs\superpowers\prompts\PROMPT_А_РозрахункиПДВЗаПершоюПодією_6442.md

#Область ПрограммныйИнтерфейс

// Реєстрація в підсистемі «Додаткові звіти та обробки» БСП 3.0.1.
//
// Возвращаемое значение:
//  Структура - параметри реєстрації.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.0.1.437");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Информация = НСтр("ru='Выравнивание счёта 6442: задвоение НДС первого события при проведении документов не по порядку.';uk='Вирівнювання рахунку 6442: задвоєння ПДВ першої події при проведенні документів не по порядку.'");

	ВызовМетода = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	ДобавитьКоманду(ПараметрыРегистрации.Команды, НСтр("ru='Расчёты НДС по первому событию (6442)';uk='Розрахунки ПДВ за першою подією (6442)'"),
		"Открыть", ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы(), Ложь);
	ДобавитьКоманду(ПараметрыРегистрации.Команды, НСтр("ru='Ночное: умное выравнивание 6442';uk='Нічне: розумне вирівнювання 6442'"),
		"НочьВыравнивание", ВызовМетода, Ложь);
	ДобавитьКоманду(ПараметрыРегистрации.Команды, НСтр("ru='Ночное: перепровести НДС-документы текущего месяца';uk='Нічне: перепровести ПДВ-документи поточного місяця'"),
		"НочьМесяц", ВызовМетода, Ложь);
	ДобавитьКоманду(ПараметрыРегистрации.Команды, НСтр("ru='Служебная: перепроведение в фоне';uk='Службова: перепроведення у фоні'"),
		"ФонПерепровести", ВызовМетода, Истина);

	Возврат ПараметрыРегистрации;

КонецФункции

// Обробник серверних команд БСП (регламентне завдання «Запуск додаткових обробок» і фон із форми).
//
// Параметры:
//  ИдентификаторКоманды - Строка - ідентифікатор з СведенияОВнешнейОбработке().
//  ПараметрыВыполнения - Структура - ДополнительнаяОбработкаСсылка, РезультатВыполнения та параметри команди.
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполнения = Неопределено) Экспорт

	Если ИдентификаторКоманды = "НочьВыравнивание" Тогда
		Итог = НочноеВыравнивание();
	ИначеЕсли ИдентификаторКоманды = "НочьМесяц" Тогда
		Итог = НочноеПерепроведениеМесяца();
	ИначеЕсли ИдентификаторКоманды = "ФонПерепровести" Тогда
		РазрешитьЗакрытыйПериод = ПараметрыВыполнения.РазрешитьЗакрытыйПериод;
		Итог = ПерепровестиДокументы(ПараметрыВыполнения.Документы, Истина);
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru='Неизвестная команда %1';uk='Невідома команда %1'"), ИдентификаторКоманды);
	КонецЕсли;

	Если ТипЗнч(ПараметрыВыполнения) = Тип("Структура")
		И ПараметрыВыполнения.Свойство("РезультатВыполнения")
		И ТипЗнч(ПараметрыВыполнения.РезультатВыполнения) = Тип("Структура") Тогда
		ПараметрыВыполнения.РезультатВыполнения.Вставить("Итог", Итог);
	КонецЕсли;

КонецПроцедуры

// Детектор: ключі та документи, де факт ПДВ першої події розходиться з очікуваним (ТЧ Ключи, Документы).
// Відмітки користувача та статуси зберігаються між повторними аналізами.
//
// Возвращаемое значение:
//  Структура - КлючейСРасхождением, ДокументовСРасхождением, Отклонение, ВсегоДокументов.
//
Функция Анализировать() Экспорт

	ЗаполнитьПериодПоУмолчанию();
	ГраницаЗапрета = ГраницаЗапретаИзменения();

	Сохраненное = СохранитьОтметкиИСтатусы();
	Ключи.Очистить();
	Документы.Очистить();

	Запрос = Новый Запрос;
	УстановитьПараметрыОтбора(Запрос);

	Запрос.Текст = ТекстЗапросаВходящиеОстатки();
	Остатки = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Остатки.Вставить(КлючСтроки(Выборка), Новый Структура("Поступление, Оплата", Выборка.Поступление, Выборка.Оплата));
	КонецЦикла;

	Запрос.Текст = ТекстЗапросаФактПервогоСобытия();
	Факт = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Факт.Вставить(КлючСтроки(Выборка) + "#" + XMLСтрока(Выборка.Регистратор), Выборка.СуммаНДС);
	КонецЦикла;

	Итог = Новый Структура("КлючейСРасхождением, ДокументовСРасхождением, Отклонение, ВсегоДокументов", 0, 0, 0, 0);
	Контекст = Новый Структура("Факт, Итог, Сохраненное", Факт, Итог, Сохраненное);

	Запрос.Текст = ТекстЗапросаДвижения();
	Выборка = Запрос.Выполнить().Выбрать();
	Состояние = Неопределено;
	Пока Выборка.Следующий() Цикл
		КлючИД = КлючСтроки(Выборка);
		Если Состояние = Неопределено ИЛИ Состояние.КлючИД <> КлючИД Тогда
			ЗавершитьКлюч(Состояние, Контекст);
			Состояние = НовоеСостояниеКлюча(Выборка, КлючИД, Остатки);
		КонецЕсли;
		Если Выборка.ЭтоЗакрытие Тогда
			// «Закриття місяця» згортає обидві сторони — змінює стан без очікуваної ПС.
			ЗавершитьДокумент(Состояние, Контекст);
			Состояние.Поступление = Состояние.Поступление + Выборка.ДельтаПоступление;
			Состояние.Оплата = Состояние.Оплата + Выборка.ДельтаОплата;
			Продолжить;
		КонецЕсли;
		Если Состояние.Документ = Неопределено ИЛИ Состояние.Документ.Документ <> Выборка.Регистратор Тогда
			ЗавершитьДокумент(Состояние, Контекст);
			Состояние.Документ = Новый Структура("Документ, Дата, ДельтаПоступление, ДельтаОплата",
				Выборка.Регистратор, Выборка.Период, 0, 0);
		КонецЕсли;
		Состояние.Документ.ДельтаПоступление = Состояние.Документ.ДельтаПоступление + Выборка.ДельтаПоступление;
		Состояние.Документ.ДельтаОплата = Состояние.Документ.ДельтаОплата + Выборка.ДельтаОплата;
	КонецЦикла;
	ЗавершитьКлюч(Состояние, Контекст);

	ЗаполнитьСальдо6442();
	Ключи.Сортировать("Отклонение Убыв");

	Возврат Итог;

КонецФункции

// Відмічені документи ТЧ Документы (у т.ч. приховані відбором форми), без повторів.
//
// Возвращаемое значение:
//  Массив - ДокументСсылка.
//
Функция ОтмеченныеДокументы() Экспорт

	Результат = Новый Массив;
	Для Каждого СтрДок Из Документы Цикл
		Если СтрДок.Отметка И Результат.Найти(СтрДок.Документ) = Неопределено Тогда
			Результат.Добавить(СтрДок.Документ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Перепроводить документи в хронологічному порядку (ядро для форми, фону і ночі).
//
// Параметры:
//  СписокДокументов - Массив - ДокументСсылка.
//  СообщатьПрогресс - Булево - слати ДлительныеОперации.СообщитьПрогресс (лише у фоновому завданні).
//
// Возвращаемое значение:
//  ТаблицаЗначений - протокол: Документ, Дата, ВидДокумента, Статус, Успех, БылВОчередиОбмена, СнятСОчереди.
//
Функция ПерепровестиДокументы(Знач СписокДокументов, СообщатьПрогресс = Ложь) Экспорт

	ГраницаЗапрета = ГраницаЗапретаИзменения();
	Узлы = УзлыОбменаЕРП();
	ТаблицаПротокола = НоваяТаблицаПротокола();

	Порядок = Новый ТаблицаЗначений;
	Порядок.Колонки.Добавить("Документ");
	Порядок.Колонки.Добавить("Дата");
	Для Каждого ДокСсылка Из СписокДокументов Цикл
		Если ЗначениеЗаполнено(ДокСсылка) Тогда
			НоваяСтрока = Порядок.Добавить();
			НоваяСтрока.Документ = ДокСсылка;
			НоваяСтрока.Дата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокСсылка, "Дата");
		КонецЕсли;
	КонецЦикла;
	Порядок.Сортировать("Дата");

	Всего = Порядок.Количество();
	ВФоне = СообщатьПрогресс И ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание() <> Неопределено;
	Номер = 0;
	Для Каждого СтрПорядок Из Порядок Цикл
		Номер = Номер + 1;
		Рез = ПерепровестиДокумент(СтрПорядок.Документ, Узлы);
		ЗаполнитьЗначенияСвойств(ТаблицаПротокола.Добавить(), Рез);
		Если ВФоне И (Номер % 10 = 0 ИЛИ Номер = Всего) Тогда
			ДлительныеОперации.СообщитьПрогресс(Цел(Номер * 100 / Всего),
				СтрШаблон(НСтр("ru='Перепроведено %1 из %2';uk='Перепроведено %1 з %2'"), Номер, Всего));
		КонецЕсли;
	КонецЦикла;

	Возврат ТаблицаПротокола;

КонецФункции

// Точка входу фонового завдання БСП (ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки): перепроведення
// списку документів у серверному контексті; протокол — у тимчасове сховище.
//
// Параметры:
//  Параметры - Структура - Документы (Массив), РазрешитьЗакрытыйПериод (Булево).
//  АдресРезультата - Строка - адреса тимчасового сховища.
//
Процедура ПерепровестиВФоне(Параметры, АдресРезультата) Экспорт

	РазрешитьЗакрытыйПериод = Параметры.РазрешитьЗакрытыйПериод;
	ТаблицаПротокола = ПерепровестиДокументы(Параметры.Документы, Истина);
	Если ЗначениеЗаполнено(АдресРезультата) И ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		ПоместитьВоВременноеХранилище(ТаблицаПротокола, АдресРезультата);
	КонецЕсли;
	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон(НСтр("ru='Перепроведение в фоне: документов %1, успешно %2, снято с очереди обмена %3.';uk='Перепроведення у фоні: документів %1, успішно %2, знято з черги обміну %3.'"),
			ТаблицаПротокола.Количество(), ТаблицаПротокола.НайтиСтроки(Новый Структура("Успех", Истина)).Количество(), ПосчитатьСнятые(ТаблицаПротокола)));
	ЗаписатьОшибкиПротокола(ТаблицаПротокола);

КонецПроцедуры

// Застосовує протокол перепроведення до ТЧ Документы і повторює аналіз; виправлені ключі лишаються в таблиці
// зі статусом «Виправлено».
//
// Параметры:
//  ТаблицаПротокола - ТаблицаЗначений - результат ПерепровестиДокументы().
//
// Возвращаемое значение:
//  Структура - результат Анализировать() + Перепроведено, Ошибок, Пропущено, СнятоСОчереди.
//
Функция ПослеПерепроведения(ТаблицаПротокола) Экспорт

	СтатусыДокументов = Новый Соответствие;
	Для Каждого СтрПрот Из ТаблицаПротокола Цикл
		СтатусыДокументов.Вставить(СтрПрот.Документ, СтрПрот.Статус);
	КонецЦикла;
	ПерепроведенныеКлючи = Новый Соответствие;
	Для Каждого СтрДок Из Документы Цикл
		Статус = СтатусыДокументов.Получить(СтрДок.Документ);
		Если Статус <> Неопределено Тогда
			СтрДок.Статус = Статус;
			СтрДок.Отметка = Ложь;
			ПерепроведенныеКлючи.Вставить(СтрДок.КлючИД, Истина);
		КонецЕсли;
	КонецЦикла;

	СтарыеКлючи = Ключи.Выгрузить();
	СтарыеДокументы = Документы.Выгрузить();
	Итог = Анализировать();

	Для Каждого СтрКлюч Из Ключи Цикл
		Если ПерепроведенныеКлючи.Получить(СтрКлюч.КлючИД) <> Неопределено Тогда
			СтрКлюч.Статус = СтрШаблон(НСтр("ru='Осталось расхождение: %1 док.';uk='Лишилась розбіжність: %1 док.'"),
				СтрКлюч.ДокументовСРасхождением);
		КонецЕсли;
	КонецЦикла;
	// Виправлені ключі зникають з аналізу — повертаємо їх рядками «Виправлено» для наочності.
	Для Каждого СтрКлюч Из СтарыеКлючи Цикл
		Если ПерепроведенныеКлючи.Получить(СтрКлюч.КлючИД) = Неопределено
			ИЛИ Ключи.Найти(СтрКлюч.КлючИД, "КлючИД") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Ключи.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрКлюч);
		НоваяСтрока.Отметка = Ложь;
		НоваяСтрока.Статус = СтатусИсправлено();
		Для Каждого СтрДок Из СтарыеДокументы.НайтиСтроки(Новый Структура("КлючИД", СтрКлюч.КлючИД)) Цикл
			ЗаполнитьЗначенияСвойств(Документы.Добавить(), СтрДок);
		КонецЦикла;
	КонецЦикла;

	Итог.Вставить("Перепроведено", ТаблицаПротокола.НайтиСтроки(Новый Структура("Успех", Истина)).Количество());
	Итог.Вставить("Ошибок", 0);
	Итог.Вставить("Пропущено", 0);
	Итог.Вставить("СнятоСОчереди", ТаблицаПротокола.НайтиСтроки(Новый Структура("СнятСОчереди", Истина)).Количество());
	Для Каждого СтрПрот Из ТаблицаПротокола Цикл
		Если СтрНачинаетсяС(СтрПрот.Статус, ПрефиксОшибки()) Тогда
			Итог.Ошибок = Итог.Ошибок + 1;
		ИначеЕсли НЕ СтрПрот.Успех Тогда
			Итог.Пропущено = Итог.Пропущено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Перепроводить відмічені документи синхронно (форма без реєстрації в БСП, тести).
//
// Возвращаемое значение:
//  Структура - див. ПослеПерепроведения().
//
Функция ПерепровестиОтмеченные() Экспорт

	Возврат ПослеПерепроведения(ПерепровестиДокументы(ОтмеченныеДокументы()));

КонецФункции

// Документи механізму ПДВ першої події за період (реєстратори РН ПриобретенияНалоговыйУчет, крім «Закриття місяця»).
//
// Возвращаемое значение:
//  ТаблицаЗначений - Документ, Дата.
//
Функция ДокументыМеханизмаЗаПериод() Экспорт

	ЗаполнитьПериодПоУмолчанию();
	Запрос = Новый Запрос(ТекстЗапросаДокументыПериода());
	УстановитьПараметрыОтбора(Запрос);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Заповнює ТЧ Протокол документами періоду без перепроведення (попередній перегляд).
//
// Возвращаемое значение:
//  Структура - Всего, ВЗакрытомПериоде, ПоВидам (Соответствие Вид → Количество).
//
Функция ЗаполнитьПротоколПериода() Экспорт

	ГраницаЗапрета = ГраницаЗапретаИзменения();
	Протокол.Очистить();
	Итог = Новый Структура("Всего, ВЗакрытомПериоде, ПоВидам", 0, 0, Новый Соответствие);
	Для Каждого СтрДок Из ДокументыМеханизмаЗаПериод() Цикл
		НоваяСтрока = Протокол.Добавить();
		НоваяСтрока.Документ = СтрДок.Документ;
		НоваяСтрока.Дата = СтрДок.Дата;
		НоваяСтрока.ВидДокумента = СтрДок.Документ.Метаданные().Синоним;
		Если ЭтоЗакрытыйПериод(СтрДок.Дата) Тогда
			НоваяСтрока.Статус = НСтр("ru='Закрытый период — не перепроводится';uk='Закритий період — не перепроводиться'");
			Итог.ВЗакрытомПериоде = Итог.ВЗакрытомПериоде + 1;
		Иначе
			НоваяСтрока.Статус = НСтр("ru='К перепроведению';uk='До перепроведення'");
		КонецЕсли;
		Итог.Всего = Итог.Всего + 1;
		Итог.ПоВидам.Вставить(НоваяСтрока.ВидДокумента, ?(Итог.ПоВидам[НоваяСтрока.ВидДокумента] = Неопределено, 0,
			Итог.ПоВидам[НоваяСтрока.ВидДокумента]) + 1);
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Документи ТЧ Протокол, які можна перепровести (не закритий період без дозволу, ще не перепроведені).
//
// Возвращаемое значение:
//  Массив - ДокументСсылка.
//
Функция ДокументыПротоколаКПерепроведению() Экспорт

	Результат = Новый Массив;
	Для Каждого СтрПрот Из Протокол Цикл
		Если (НЕ ЭтоЗакрытыйПериод(СтрПрот.Дата) ИЛИ РазрешитьЗакрытыйПериод)
			И НЕ СтрНачинаетсяС(СтрПрот.Статус, ПрефиксУспеха()) Тогда
			Результат.Добавить(СтрПрот.Документ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Переносить результат перепроведення в ТЧ Протокол.
//
// Параметры:
//  Результат - ТаблицаЗначений - результат ПерепровестиДокументы().
//
Процедура ПрименитьПротоколПериода(Результат) Экспорт

	Для Каждого СтрРез Из Результат Цикл
		СтрПрот = Протокол.Найти(СтрРез.Документ, "Документ");
		Если СтрПрот = Неопределено Тогда
			СтрПрот = Протокол.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрПрот, СтрРез);
	КонецЦикла;

КонецПроцедуры

// Нічна команда: аналіз з початку минулого місяця → перепроведення розбіжних документів відкритого періоду →
// повторний аналіз → для ключів із залишком розбіжності — «хвіст» ключа від першого розбіжного документа.
//
// Возвращаемое значение:
//  Строка - підсумок (також пишеться в журнал реєстрації).
//
Функция НочноеВыравнивание() Экспорт

	Организация = Справочники.Организации.ПустаяСсылка();
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	ДатаНачала = НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -1));
	ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	РазрешитьЗакрытыйПериод = Ложь;

	До = Анализировать();
	Протокол1 = ПерепровестиДокументы(ОтмеченныеДокументы());
	После = ПослеПерепроведения(Протокол1);

	// Гіпотеза H1: достатньо перепровести розбіжні документи. Якщо ні — хвіст ключа від першого розбіжного.
	Хвост = Новый Массив;
	Для Каждого СтрКлюч Из Ключи Цикл
		Если СтрКлюч.ДокументовСРасхождением = 0 ИЛИ СтрКлюч.Статус = СтатусИсправлено() Тогда
			Продолжить;
		КонецЕсли;
		ПосляПершого = Ложь;
		Для Каждого СтрДок Из Документы.НайтиСтроки(Новый Структура("КлючИД", СтрКлюч.КлючИД)) Цикл
			ПосляПершого = ПосляПершого ИЛИ СтрДок.ЕстьРасхождение;
			Если ПосляПершого И НЕ СтрДок.ЗакрытыйПериод И Хвост.Найти(СтрДок.Документ) = Неопределено Тогда
				Хвост.Добавить(СтрДок.Документ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Протокол2 = Неопределено;
	Если Хвост.Количество() > 0 Тогда
		Протокол2 = ПерепровестиДокументы(Хвост);
		После = ПослеПерепроведения(Протокол2);
	КонецЕсли;

	Текст = СтрШаблон(НСтр("ru='Ночное выравнивание 6442 (%1). До: ключей %2, документов %3, лишний НДС %4. Перепроведено: %5 + хвост %6. После: ключей %7, документов %8, лишний НДС %9. Снято с очереди обмена: %10.';uk='Нічне вирівнювання 6442 (%1). До: ключів %2, документів %3, зайвий ПДВ %4. Перепроведено: %5 + хвіст %6. Після: ключів %7, документів %8, зайвий ПДВ %9. Знято з черги обміну: %10.'"),
		Формат(ДатаНачала, "ДЛФ=D") + " – " + Формат(ДатаОкончания, "ДЛФ=D"),
		До.КлючейСРасхождением, До.ДокументовСРасхождением, Формат(До.Отклонение, "ЧДЦ=2; ЧН=0"),
		Протокол1.Количество(), Хвост.Количество(),
		После.КлючейСРасхождением, После.ДокументовСРасхождением, Формат(После.Отклонение, "ЧДЦ=2; ЧН=0"),
		ПосчитатьСнятые(Протокол1) + ПосчитатьСнятые(Протокол2));
	ЗаписатьВЖурнал(Текст, Протокол1, Протокол2);
	Возврат Текст;

КонецФункции

// Нічна команда: перепроведення всіх документів механізму ПДВ поточного місяця (відкритий період) + контрольний аналіз.
//
// Возвращаемое значение:
//  Строка - підсумок (також пишеться в журнал реєстрації).
//
Функция НочноеПерепроведениеМесяца() Экспорт

	Организация = Справочники.Организации.ПустаяСсылка();
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	ДатаНачала = НачалоМесяца(ТекущаяДатаСеанса());
	ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	РазрешитьЗакрытыйПериод = Ложь;

	СписокДокументов = ДокументыМеханизмаЗаПериод().ВыгрузитьКолонку("Документ");
	Протокол1 = ПерепровестиДокументы(СписокДокументов);

	ДатаНачала = НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -1));
	После = Анализировать();

	Текст = СтрШаблон(НСтр("ru='Ночное перепроведение НДС-документов %1 – %2: документов %3, успешно %4, снято с очереди обмена %5. Контроль (с %6): ключей с расхождением %7, документов %8, лишний НДС %9.';uk='Нічне перепроведення ПДВ-документів %1 – %2: документів %3, успішно %4, знято з черги обміну %5. Контроль (з %6): ключів з розбіжністю %7, документів %8, зайвий ПДВ %9.'"),
		Формат(НачалоМесяца(ТекущаяДатаСеанса()), "ДЛФ=D"), Формат(ДатаОкончания, "ДЛФ=D"),
		Протокол1.Количество(), Протокол1.НайтиСтроки(Новый Структура("Успех", Истина)).Количество(),
		ПосчитатьСнятые(Протокол1), Формат(ДатаНачала, "ДЛФ=D"),
		После.КлючейСРасхождением, После.ДокументовСРасхождением, Формат(После.Отклонение, "ЧДЦ=2; ЧН=0"));
	ЗаписатьВЖурнал(Текст, Протокол1);
	Возврат Текст;

КонецФункции

// Загальна дата заборони змін «Для всіх користувачів» (БСП ДатыЗапретаИзменения); порожня — заборони немає.
//
// Возвращаемое значение:
//  Дата
//
Функция ГраницаЗапретаИзменения() Экспорт

	Запрос = Новый Запрос(ТекстЗапросаДатаЗапрета());
	Результат = Дата(1, 1, 1);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДатаЗапрета = Выборка.ДатаЗапрета;
		Попытка
			ДатаЗапрета = ДатыЗапретаИзмененияСлужебный.ДатаЗапретаПоОписанию(Выборка.ОписаниеДатыЗапрета, Выборка.ДатаЗапрета);
		Исключение
			// відносна дата не розпізналась — лишаємо збережену
		КонецПопытки;
		Результат = Макс(Результат, ДатаЗапрета);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Журнал реєстрації цієї обробки за 30 днів.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Дата, Уровень, Комментарий.
//
Функция ПрочитатьЖурнал() Экспорт

	Журнал = Новый ТаблицаЗначений;
	Отбор = Новый Структура("Событие, ДатаНачала", ИмяСобытияЖурнала(), ТекущаяДатаСеанса() - 30 * 86400);
	ВыгрузитьЖурналРегистрации(Журнал, Отбор, "Дата, Уровень, Комментарий");
	Журнал.Сортировать("Дата Убыв");
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Дата");
	Результат.Колонки.Добавить("Уровень");
	Результат.Колонки.Добавить("Комментарий");
	Для Каждого СтрЖурнал Из Журнал Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Дата = СтрЖурнал.Дата;
		НоваяСтрока.Уровень = Строка(СтрЖурнал.Уровень);
		НоваяСтрока.Комментарий = СтрЖурнал.Комментарий;
	КонецЦикла;
	Возврат Результат;

КонецФункции

