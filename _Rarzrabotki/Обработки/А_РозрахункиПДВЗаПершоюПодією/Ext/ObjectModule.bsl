// Сальдо 6442 на кінець періоду по (Організація, Договір, Документ розрахунків = угода або порожньо).
Процедура ЗаполнитьСальдо6442()

	Если Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Договоры = Новый Массив;
	Для Каждого СтрКлюч Из Ключи Цикл
		Если Договоры.Найти(СтрКлюч.ДоговорКонтрагента) = Неопределено Тогда
			Договоры.Добавить(СтрКлюч.ДоговорКонтрагента);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос(ТекстЗапросаСальдо6442());
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(ДатаОкончания), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Счет6442", ПланыСчетов.Хозрасчетный.НалоговыйКредитНеподтвержденный);
	Запрос.УстановитьПараметр("Договоры", Договоры);
	Сальдо = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = XMLСтрока(Выборка.Организация) + "|" + XMLСтрока(Выборка.ДоговорКонтрагента) + "|"
			+ ?(ЗначениеЗаполнено(Выборка.ДокументРасчетов), XMLСтрока(Выборка.ДокументРасчетов), "");
		Сальдо.Вставить(Ключ, ?(Сальдо[Ключ] = Неопределено, 0, Сальдо[Ключ]) + Выборка.Сальдо);
	КонецЦикла;
	Для Каждого СтрКлюч Из Ключи Цикл
		Ключ = XMLСтрока(СтрКлюч.Организация) + "|" + XMLСтрока(СтрКлюч.ДоговорКонтрагента) + "|"
			+ ?(ЗначениеЗаполнено(СтрКлюч.Сделка), XMLСтрока(СтрКлюч.Сделка), "");
		СтрКлюч.Сальдо6442 = ?(Сальдо[Ключ] = Неопределено, 0, Сальдо[Ключ]);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Перепроведение

// Перепроводить один документ як штатне групове перепроведення; не лишає документ у черзі обміну з ЕРП,
// якщо до перепроведення його там не було (перевірка і зняття — в одній транзакції з проведенням).
Функция ПерепровестиДокумент(ДокСсылка, Узлы)

	Рез = Новый Структура("Документ, Дата, ВидДокумента, Статус, Успех, БылВОчередиОбмена, СнятСОчереди",
		ДокСсылка, Дата(1, 1, 1), ДокСсылка.Метаданные().Синоним, "", Ложь, Ложь, Ложь);
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокСсылка, "Дата, Проведен, ПометкаУдаления");
	Рез.Дата = Реквизиты.Дата;
	Если Реквизиты.ПометкаУдаления ИЛИ НЕ Реквизиты.Проведен Тогда
		Рез.Статус = НСтр("ru='Пропущено: документ не проведён';uk='Пропущено: документ не проведений'");
		Возврат Рез;
	КонецЕсли;
	Если ЭтоЗакрытыйПериод(Реквизиты.Дата) И НЕ РазрешитьЗакрытыйПериод Тогда
		Рез.Статус = СтрШаблон(НСтр("ru='Пропущено: закрытый период (запрет по %1)';uk='Пропущено: закритий період (заборона по %1)'"),
			Формат(ГраницаЗапрета, "ДЛФ=D"));
		Возврат Рез;
	КонецЕсли;

	УзлыДокумента = Новый Массив;
	Если Метаданные.ПланыОбмена.ОбменУправлениеПредприятиемБухгалтерия20.Состав.Содержит(ДокСсылка.Метаданные()) Тогда
		УзлыДокумента = Узлы;
	КонецЕсли;

	ПолучитьСообщенияПользователю(Истина);
	НачатьТранзакцию();
	Попытка
		БылЗарегистрирован = Новый Соответствие;
		Для Каждого Узел Из УзлыДокумента Цикл
			БылЗарегистрирован.Вставить(Узел, ПланыОбмена.ИзменениеЗарегистрировано(Узел, ДокСсылка));
		КонецЦикла;

		ДокОбъект = ДокСсылка.ПолучитьОбъект();
		ДокОбъект.ДополнительныеСвойства.Вставить("ГрупповоеПерепроведение", Истина);
		ДокОбъект.ДополнительныеСвойства.Вставить("ПроведенВХронологическойПоследовательности", Ложь);
		Если НЕ ДокОбъект.ПроверитьЗаполнение() Тогда
			ВызватьИсключение ТекстСообщений(НСтр("ru='Не прошла проверка заполнения';uk='Не пройшла перевірка заповнення'"));
		КонецЕсли;
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);

		Для Каждого Узел Из УзлыДокумента Цикл
			Если БылЗарегистрирован[Узел] Тогда
				Рез.БылВОчередиОбмена = Истина;
			ИначеЕсли ПланыОбмена.ИзменениеЗарегистрировано(Узел, ДокСсылка) Тогда
				ПланыОбмена.УдалитьРегистрациюИзменений(Узел, ДокСсылка);
				Рез.СнятСОчереди = Истина;
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
		Рез.Успех = Истина;
		Рез.Статус = ПрефиксУспеха() + ?(Рез.СнятСОчереди, НСтр("ru=', снят с очереди обмена ЕРП';uk=', знято з черги обміну ЕРП'"), "")
			+ ?(Рез.БылВОчередиОбмена, НСтр("ru=', уже был в очереди ЕРП';uk=', вже був у черзі ЕРП'"), "");
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Рез.Статус = ПрефиксОшибки() + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщения = ТекстСообщений("");
		Если ЗначениеЗаполнено(Сообщения) И СтрНайти(Рез.Статус, Сообщения) = 0 Тогда
			Рез.Статус = Рез.Статус + " " + Сообщения;
		КонецЕсли;
	КонецПопытки;
	Возврат Рез;

КонецФункции

