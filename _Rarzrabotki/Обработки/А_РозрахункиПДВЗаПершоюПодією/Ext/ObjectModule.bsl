Функция ЗаписатьОшибкиПротокола(ТаблицаПротокола)

	Ошибок = 0;
	Для Каждого СтрПрот Из ТаблицаПротокола Цикл
		Если СтрНачинаетсяС(СтрПрот.Статус, ПрефиксОшибки()) Тогда
			Ошибок = Ошибок + 1;
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , СтрПрот.Документ,
				Строка(СтрПрот.Документ) + ": " + СтрПрот.Статус);
		КонецЕсли;
	КонецЦикла;
	Возврат Ошибок;

