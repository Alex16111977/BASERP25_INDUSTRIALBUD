Процедура ЗаписатьВЖурнал(Текст, Протокол1, Протокол2 = Неопределено)

	Ошибок = ЗаписатьОшибкиПротокола(Протокол1);
	Если Протокол2 <> Неопределено Тогда
		Ошибок = Ошибок + ЗаписатьОшибкиПротокола(Протокол2);
	КонецЕсли;
	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(),
		?(Ошибок > 0, УровеньЖурналаРегистрации.Предупреждение, УровеньЖурналаРегистрации.Информация), , ,
		Текст + ?(Ошибок > 0, СтрШаблон(НСтр("ru=' Ошибок: %1 (см. записи уровня «Ошибка»).';uk=' Помилок: %1 (див. записи рівня «Помилка»).'"), Ошибок), ""));

