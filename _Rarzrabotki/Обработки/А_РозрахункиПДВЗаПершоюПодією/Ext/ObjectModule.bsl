#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Детектор

Процедура ЗаполнитьПериодПоУмолчанию()

	Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = НачалоГода(ТекущаяДатаСеанса());
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = ТекущаяДатаСеанса();
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьПараметрыОтбора(Запрос)

	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Гривня", Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("ОтборОрганизация", ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОтборКонтрагент", ЗначениеЗаполнено(Контрагент));
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ОтборДоговор", ЗначениеЗаполнено(ДоговорКонтрагента));
	Запрос.УстановитьПараметр("ДоговорКонтрагента", ДоговорКонтрагента);

КонецПроцедуры

// Рядковий ключ залишків РН ПриобретенияНалоговыйУчет (8 вимірів) — однаковий для Выборки, рядка ТЧ і Структуры.
Функция КлючСтроки(Данные)

	Сделка = Данные.Сделка;
	Возврат XMLСтрока(Данные.Организация)
		+ "|" + XMLСтрока(Данные.ДоговорКонтрагента)
		+ "|" + ?(ЗначениеЗаполнено(Сделка), XMLТипЗнч(Сделка).ИмяТипа + ":" + XMLСтрока(Сделка), "")
		+ "|" + XMLСтрока(Данные.ВозвратнаяТара)
		+ "|" + XMLСтрока(Данные.СтавкаНДС)
		+ "|" + XMLСтрока(Данные.ДляХозяйственнойДеятельности)
		+ "|" + XMLСтрока(Данные.ВидДеятельностиНДС)
		+ "|" + XMLСтрока(Данные.Амортизируется);

КонецФункции

Функция НовоеСостояниеКлюча(Выборка, КлючИД, Остатки)

	Состояние = Новый Структура("КлючИД, Организация, ДоговорКонтрагента, Сделка, ВозвратнаяТара, СтавкаНДС,
		|ДляХозяйственнойДеятельности, ВидДеятельностиНДС, Амортизируется");
	ЗаполнитьЗначенияСвойств(Состояние, Выборка);
	Состояние.КлючИД = КлючИД;
	Вход = Остатки.Получить(КлючИД);
	Состояние.Вставить("Поступление", ?(Вход = Неопределено, 0, Вход.Поступление));
	Состояние.Вставить("Оплата", ?(Вход = Неопределено, 0, Вход.Оплата));
	Состояние.Вставить("Документ", Неопределено);
	Состояние.Вставить("Документы", Новый Массив);
	Состояние.Вставить("ЕстьРасхождение", Ложь);
	Возврат Состояние;

КонецФункции

// Закриває поточний документ ключа: очікувана ПС = max(після) − max(до), факт — з ОиП.
Процедура ЗавершитьДокумент(Состояние, Контекст)

	Если Состояние = Неопределено ИЛИ Состояние.Документ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Док = Состояние.Документ;
	Состояние.Документ = Неопределено;

	МаксДо = Макс(Состояние.Поступление, Состояние.Оплата);
	Состояние.Поступление = Состояние.Поступление + Док.ДельтаПоступление;
	Состояние.Оплата = Состояние.Оплата + Док.ДельтаОплата;
	Ожидаемо = Макс(Состояние.Поступление, Состояние.Оплата) - МаксДо;
	ФактПС = Контекст.Факт.Получить(Состояние.КлючИД + "#" + XMLСтрока(Док.Документ));
	ФактПС = ?(ФактПС = Неопределено, 0, ФактПС);

	Док.Вставить("ОжидаемоПС", Ожидаемо);
	Док.Вставить("ФактПС", ФактПС);
	Док.Вставить("Отклонение", ФактПС - Ожидаемо);
	Док.Вставить("ЕстьРасхождение", Макс(ФактПС - Ожидаемо, Ожидаемо - ФактПС) > 0.05);
	Состояние.Документы.Добавить(Док);
	Если Док.ЕстьРасхождение Тогда
		Состояние.ЕстьРасхождение = Истина;
	КонецЕсли;

КонецПроцедуры

// Закриває ключ: у ТЧ потрапляють лише ключі, де є хоч один розбіжний документ (+ усі документи ключа — контекст).
Процедура ЗавершитьКлюч(Состояние, Контекст)

	Если Состояние = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗавершитьДокумент(Состояние, Контекст);
	Если НЕ Состояние.ЕстьРасхождение Тогда
		Возврат;
	КонецЕсли;

	Итог = Контекст.Итог;
	Сохраненное = Контекст.Сохраненное;
	СтрКлюч = Ключи.Добавить();
	ЗаполнитьЗначенияСвойств(СтрКлюч, Состояние, "КлючИД, Организация, ДоговорКонтрагента, Сделка, ВозвратнаяТара, СтавкаНДС,
		|ДляХозяйственнойДеятельности, ВидДеятельностиНДС, Амортизируется");
	СтрКлюч.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Состояние.ДоговорКонтрагента, "Владелец");
	ЕстьОтмеченные = Ложь;
	Для Каждого Док Из Состояние.Документы Цикл
		СтрДок = Документы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрДок, Док);
		СтрДок.КлючИД = Состояние.КлючИД;
		СтрДок.НДСПоступление = Док.ДельтаПоступление;
		СтрДок.НДСОплата = Док.ДельтаОплата;
		СтрДок.Событие = ОписаниеСобытия(Док.ДельтаПоступление, Док.ДельтаОплата);
		СтрДок.ЗакрытыйПериод = ЭтоЗакрытыйПериод(Док.Дата);
		КлючДок = Состояние.КлючИД + "#" + XMLСтрока(Док.Документ);
		Если Сохраненное.Отметки[КлючДок] <> Неопределено Тогда
			СтрДок.Отметка = Сохраненное.Отметки[КлючДок];
		Иначе
			СтрДок.Отметка = Док.ЕстьРасхождение И (НЕ СтрДок.ЗакрытыйПериод ИЛИ РазрешитьЗакрытыйПериод);
		КонецЕсли;
		Если Сохраненное.Статусы[КлючДок] <> Неопределено Тогда
			СтрДок.Статус = Сохраненное.Статусы[КлючДок];
		КонецЕсли;
		ЕстьОтмеченные = ЕстьОтмеченные ИЛИ СтрДок.Отметка;

		СтрКлюч.ОжидаемоПС = СтрКлюч.ОжидаемоПС + Док.ОжидаемоПС;
		СтрКлюч.ФактПС = СтрКлюч.ФактПС + Док.ФактПС;
		СтрКлюч.ДокументовВсего = СтрКлюч.ДокументовВсего + 1;
		Если Док.ЕстьРасхождение Тогда
			СтрКлюч.ДокументовСРасхождением = СтрКлюч.ДокументовСРасхождением + 1;
			Если НЕ ЗначениеЗаполнено(СтрКлюч.ПервыйДокумент) Тогда
				СтрКлюч.ПервыйДокумент = Док.Документ;
				СтрКлюч.ЗакрытыйПериод = СтрДок.ЗакрытыйПериод;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	СтрКлюч.Отклонение = СтрКлюч.ФактПС - СтрКлюч.ОжидаемоПС;
	СтрКлюч.Отметка = ЕстьОтмеченные;

	Итог.КлючейСРасхождением = Итог.КлючейСРасхождением + 1;
	Итог.ДокументовСРасхождением = Итог.ДокументовСРасхождением + СтрКлюч.ДокументовСРасхождением;
	Итог.Отклонение = Итог.Отклонение + СтрКлюч.Отклонение;
	Итог.ВсегоДокументов = Итог.ВсегоДокументов + СтрКлюч.ДокументовВсего;

КонецПроцедуры

