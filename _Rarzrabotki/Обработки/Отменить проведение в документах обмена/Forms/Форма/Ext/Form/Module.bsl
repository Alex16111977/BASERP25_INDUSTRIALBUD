// =========== ОТМЕНА ПРОВЕДЕНИЯ ПО СКЛАДАМ ОБМЕНА ===========

&НаСервере
Функция ПолучитьДокументыОбменаНаСервере(НачПериода, КонПериода)  
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачПериода", НачПериода);
	Запрос.УстановитьПараметр("КонПериода", КонПериода);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыНаСкладах.Регистратор КАК Регистратор,
	|	ТоварыНаСкладах.Период КАК Период
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах КАК ТоварыНаСкладах
	|ГДЕ
	|	ТоварыНаСкладах.Склад.А_ЭтоОбмен
	|	И (ТоварыНаСкладах.Регистратор ССЫЛКА Документ.СписаниеНедостачТоваров
	|		ИЛИ ТоварыНаСкладах.Регистратор ССЫЛКА Документ.ПриобретениеТоваровУслуг)
	|	И ТоварыНаСкладах.Период МЕЖДУ &НачПериода И &КонПериода
	|СГРУППИРОВАТЬ ПО
	|	ТоварыНаСкладах.Регистратор,
	|	ТоварыНаСкладах.Период
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Регистратор, Период", Выборка.Регистратор, Выборка.Период));
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ОтменитьПроведениеДокументаНаСервере(СсылкаНаДокумент)
	Попытка
		Док = СсылкаНаДокумент.ПолучитьОбъект();
		Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ОтменитьПроведениеПоСкладамОбмена(Команда)
	Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Укажите период!");
		Возврат;
	КонецЕсли;
	
	МассивДокументов = ПолучитьДокументыОбменаНаСервере(ДатаНачала, КонецДня(ДатаОкончания));
	ВсегоДокументов = МассивДокументов.Количество();
	
	Если ВсегоДокументов = 0 Тогда
		ПоказатьПредупреждение(, "Документы по складам обмена не найдены за период");
		Возврат;
	КонецЕсли;
	
	КоличествоОшибок = 0;
	
	Для НомерТекущего = 0 По ВсегоДокументов - 1 Цикл
		ДанныеДокумента = МассивДокументов[НомерТекущего];
		Процент = Окр((НомерТекущего + 1) / ВсегоДокументов * 100, 0);
		
		Состояние(
			"Отмена проведения: " + (НомерТекущего + 1) + " из " + ВсегоДокументов,
			Процент,
			"Дата: " + Формат(ДанныеДокумента.Период, "ДЛФ=D")
		);
		
		ОбработкаПрерыванияПользователя();
		
		Если НЕ ОтменитьПроведениеДокументаНаСервере(ДанныеДокумента.Регистратор) Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;
	КонецЦикла;
	
	ПоказатьПредупреждение(, "Готово! Обработано: " + ВсегоДокументов + ", ошибок: " + КоличествоОшибок);
КонецПроцедуры

// =========== ПЕРЕПРОВЕДЕНИЕ ДОКУМЕНТОВ ПО ТОВАРАМ НА СКЛАДАХ ===========

&НаСервере
Функция ПолучитьДокументыТоварыНаСкладахНаСервере(НачПериода, КонПериода)  
	
		Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачПериода", НачПериода);
	Запрос.УстановитьПараметр("КонПериода", КонПериода);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Номенклатура КАК Номенклатура
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВложенныйЗапрос.Организация КАК Организация,
	|		ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|		ВложенныйЗапрос.ВидЗапасов КАК ВидЗапасов,
	|		СУММА(ВложенныйЗапрос.КоличествоКонечныйОстаток) КАК КоличествоКонечныйОстаток
	|	ИЗ
	|		(ВЫБРАТЬ
	|			ТоварыОрганизацийОстаткиИОбороты.Организация КАК Организация,
	|			АналитикиУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|			ТоварыОрганизацийОстаткиИОбороты.ВидЗапасов КАК ВидЗапасов,
	|			СУММА(ТоварыОрганизацийОстаткиИОбороты.КоличествоКонечныйОстаток) КАК КоличествоКонечныйОстаток
	|		ИЗ
	|			РегистрНакопления.ТоварыОрганизаций.ОстаткиИОбороты(&НачПериода, &КонПериода, , , ) КАК ТоварыОрганизацийОстаткиИОбороты
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК АналитикиУчетаНоменклатуры
	|				ПО ТоварыОрганизацийОстаткиИОбороты.АналитикаУчетаНоменклатуры = АналитикиУчетаНоменклатуры.Ссылка
	|		
	|		СГРУППИРОВАТЬ ПО
	|			АналитикиУчетаНоменклатуры.Номенклатура,
	|			ТоварыОрганизацийОстаткиИОбороты.Организация,
	|			ТоварыОрганизацийОстаткиИОбороты.ВидЗапасов) КАК ВложенныйЗапрос
	|	ГДЕ
	|		ВложенныйЗапрос.КоличествоКонечныйОстаток < 0
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВложенныйЗапрос.Организация,
	|		ВложенныйЗапрос.Номенклатура,
	|		ВложенныйЗапрос.ВидЗапасов) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Номенклатура";
	

	 МасНоменклатура = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура"); 

	 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачПериода", НачПериода);
	Запрос.УстановитьПараметр("КонПериода", КонПериода);
		Запрос.УстановитьПараметр("МасНоменклатура", МасНоменклатура);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыНаСкладах.Регистратор КАК Регистратор,
	|	ТоварыНаСкладах.Период КАК Период
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах КАК ТоварыНаСкладах
	|ГДЕ
	|	ТоварыНаСкладах.Период МЕЖДУ &НачПериода И &КонПериода
	|	И ТоварыНаСкладах.Номенклатура В(&МасНоменклатура)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыНаСкладах.Регистратор,
	|	ТоварыНаСкладах.Период
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Регистратор, Период", Выборка.Регистратор, Выборка.Период));
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ПерепровестиДокументНаСервере(СсылкаНаДокумент)
	Попытка
		Док = СсылкаНаДокумент.ПолучитьОбъект();
		НачатьТранзакцию();
		Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Док.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
		Возврат Истина;
	Исключение
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ПерепровестиДокументыПоТоварамНаСкладах(Команда)
	Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Укажите период!");
		Возврат;
	КонецЕсли;
	
	МассивДокументов = ПолучитьДокументыТоварыНаСкладахНаСервере(ДатаНачала, КонецДня(ДатаОкончания));
	ВсегоДокументов = МассивДокументов.Количество();
	
	Если ВсегоДокументов = 0 Тогда
		ПоказатьПредупреждение(, "Документы не найдены за период");
		Возврат;
	КонецЕсли;
	
	КоличествоОшибок = 0;
	
	Для НомерТекущего = 0 По ВсегоДокументов - 1 Цикл
		ДанныеДокумента = МассивДокументов[НомерТекущего];
		Процент = Окр((НомерТекущего + 1) / ВсегоДокументов * 100, 0);
		
		Состояние(
			": " + (НомерТекущего + 1) + " из " + Формат(ВсегоДокументов,"ЧГ=0"),
			Процент,
			"Дата: " + Формат(ДанныеДокумента.Период, "ДЛФ=D")
		);
		
		ОбработкаПрерыванияПользователя();
		
		Если НЕ ПерепровестиДокументНаСервере(ДанныеДокумента.Регистратор) Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;
	КонецЦикла;
	
	ПоказатьПредупреждение(, "Готово! Обработано: " + ВсегоДокументов + ", ошибок: " + КоличествоОшибок);
КонецПроцедуры
