
// =============================================================
// Заполнение прибыли по подразделениям в КорректировкаРегистров
// Логика: Актив - Пассив = дисбаланс по подразделению
//         Статья "Прибыли и убытки" выравнивает до 0
// Сторно: старые движения документа очищаются автоматически
// =============================================================

&НаСервере
Процедура ЗаполнитьДокументНаСервере()
	
	Если Объект.ДокКорректировкаРегистров.Пустая() Тогда
		Сообщить("ОШИБКА: Не указан документ КорректировкаРегистров!");
		Возврат;
	КонецЕсли;
	
	// --- 1. Определяем конец периода из документа ---
	ДокСсылка = Объект.ДокКорректировкаРегистров;
	КонецПериода = КонецДня(ДокСсылка.Дата);
	
	Сообщить("Период: " + Формат(КонецПериода, "ДФ=dd.MM.yyyy"));
	
	// --- 2. Статья "Прибыли и убытки" ---
	СтатьяПрибыль = ПланыВидовХарактеристик.СтатьиАктивовПассивов
		.НайтиПоНаименованию("Прибыли и убытки", Истина);
	Если СтатьяПрибыль.Пустая() Тогда
		Сообщить("ОШИБКА: Статья 'Прибыли и убытки' не найдена в ПланеВидовХарактеристик!");
		Возврат;
	КонецЕсли;
	
	// --- 3. Дисбаланс по подразделениям (ВСЕ статьи КРОМЕ "Прибыли и убытки") ---
	// Дисбаланс > 0: активы > пассивы → нужен пассив (Расход по "Прибыль")
	// Дисбаланс < 0: пассивы > активы → нужен актив  (Приход по "Прибыль" = убыток)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|   Ост.Организация             КАК Организация,
		|   Ост.Подразделение           КАК Подразделение,
		|   Ост.НаправлениеДеятельности КАК НаправлениеДеятельности,
		|   СУММА(Ост.СуммаОстаток)     КАК Дисбаланс
		|ИЗ
		|   РегистрНакопления.ПрочиеАктивыПассивы.Остатки(&КонецПериода, ) КАК Ост
		|ГДЕ
		|   Ост.Статья <> &СтатьяПрибыль
		|СГРУППИРОВАТЬ ПО
		|   Ост.Организация,
		|   Ост.Подразделение,
		|   Ост.НаправлениеДеятельности";
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("СтатьяПрибыль", СтатьяПрибыль);
	ТаблДисбаланс = Запрос.Выполнить().Выгрузить();
	
	// --- 4. Контрольная сумма ---
	ОбщийДисбаланс = 0;
	Для Каждого Стр Из ТаблДисбаланс Цикл
		ОбщийДисбаланс = ОбщийДисбаланс + Стр.Дисбаланс;
	КонецЦикла;
	Сообщить("Контрольная сумма дисбаланса: " + Окр(ОбщийДисбаланс, 2)
		+ " | Строк: " + ТаблДисбаланс.Количество());
	
	// --- 5. Снимаем проведение, очищаем движения ---
	ДокОбъект = ДокСсылка.ПолучитьОбъект();
	Если ДокОбъект.Проведен Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Сообщить("Проведение отменено (сторно старых движений)");
	КонецЕсли;
	
	// Очищаем только регистр ПрочиеАктивыПассивы
	ДокОбъект.Движения.ПрочиеАктивыПассивы.Записывать = Истина;
	ДокОбъект.Движения.ПрочиеАктивыПассивы.Очистить();
	
	// --- 6. Заполняем новые движения по подразделениям ---
	КоличествоСтрок = 0;
	Для Каждого Стр Из ТаблДисбаланс Цикл
		
		Если Стр.Дисбаланс = 0 Тогда
			Продолжить; // Баланс выровнен — запись не нужна
		КонецЕсли;
		
		НовДвиж = ДокОбъект.Движения.ПрочиеАктивыПассивы.Добавить();
		НовДвиж.Период                  = КонецПериода;
		НовДвиж.Организация             = Стр.Организация;
		НовДвиж.Подразделение           = Стр.Подразделение;
		НовДвиж.НаправлениеДеятельности = Стр.НаправлениеДеятельности;
		НовДвиж.Статья                  = СтатьяПрибыль;
		НовДвиж.Сумма        = Окр(Абс(Стр.Дисбаланс), 2);
		
		// Дисбаланс > 0: Актив > Пассив → добавляем Пассив = Расход
		// Дисбаланс < 0: Пассив > Актив → добавляем Актив  = Приход (убыток)
		Если Стр.Дисбаланс > 0 Тогда
			НовДвиж.ВидДвижения = ВидДвиженияНакопления.Расход;
		Иначе
			НовДвиж.ВидДвижения = ВидДвиженияНакопления.Приход;
		КонецЕсли;
		
		КоличествоСтрок = КоличествоСтрок + 1;
		Сообщить("  " + Стр.Организация + " | " + Стр.Подразделение + " | " + Стр.НаправлениеДеятельности
			+ ": Дисбаланс=" + Окр(Стр.Дисбаланс, 2) + "  → " + НовДвиж.ВидДвижения);
		
	КонецЦикла;
	
	// --- 7. Проводим документ ---
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
	Сообщить("=== ГОТОВО! Строк записано: " + КоличествоСтрок + " ===");
	
	// --- 8. Контрольная проверка остатков ---
	ЗапросПроверка = Новый Запрос;
	ЗапросПроверка.Текст =
		"ВЫБРАТЬ
		|   Ост.Организация.Наименование             КАК Организация,
		|   Ост.Подразделение.Наименование           КАК Подразделение,
		|   Ост.НаправлениеДеятельности.Наименование КАК Направление,
		|   СУММА(Ост.СуммаОстаток)                  КАК Итого
		|ИЗ
		|   РегистрНакопления.ПрочиеАктивыПассивы.Остатки(&КонецПериода, ) КАК Ост
		|СГРУППИРОВАТЬ ПО
		|   Ост.Организация,
		|   Ост.Подразделение,
		|   Ост.НаправлениеДеятельности
		|ИМЕЮЩИЕ
		|   СУММА(Ост.СуммаОстаток) <> 0";
	ЗапросПроверка.УстановитьПараметр("КонецПериода", КонецПериода);
	РезПроверки = ЗапросПроверка.Выполнить().Выгрузить();
	
	Если РезПроверки.Количество() = 0 Тогда
		Сообщить("✓ БАЛАНС ВЫРОВНЕН! Все комбинации (Орг + Подр + Направление) = 0");
	Иначе
		Сообщить("⚠ ВНИМАНИЕ: Остались ненулевые комбинации:");
		Для Каждого Стр Из РезПроверки Цикл
			Сообщить("  " + Стр.Организация + " | " + Стр.Подразделение + " | " + Стр.Направление + ": " + Окр(Стр.Итого, 2));
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)
	ЗаполнитьДокументНаСервере();
КонецПроцедуры
