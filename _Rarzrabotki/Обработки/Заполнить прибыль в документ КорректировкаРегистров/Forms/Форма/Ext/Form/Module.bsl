
// =============================================================
// Заполнение прибыли по подразделениям в КорректировкаРегистров
// Логика: Актив - Пассив = дисбаланс по (Орг, Подр, НаправлениеДеятельности)
//         Статья "Прибыли и убытки" выравнивает до 0
// ПОРЯДОК ВАЖЕН: сначала очистить старые движения → потом читать дисбаланс
// =============================================================

&НаСервере
Процедура ЗаполнитьДокументНаСервере()

	Если Объект.ДокКорректировкаРегистров.Пустая() Тогда
		Сообщить("ОШИБКА: Не указан документ КорректировкаРегистров!");
		Возврат;
	КонецЕсли;

	// --- 1. Определяем конец периода из документа ---
	ДокСсылка = Объект.ДокКорректировкаРегистров;
	КонецПериода = КонецДня(ДокСсылка.Дата);

	Сообщить("Период: " + Формат(КонецПериода, "ДФ=dd.MM.yyyy"));

	// --- 2. Статья "Прибыли и убытки" ---
	СтатьяПрибыль = ПланыВидовХарактеристик.СтатьиАктивовПассивов
		.НайтиПоНаименованию("Прибыли и убытки", Истина);
	Если СтатьяПрибыль.Пустая() Тогда
		Сообщить("ОШИБКА: Статья 'Прибыли и убытки' не найдена в ПланеВидовХарактеристик!");
		Возврат;
	КонецЕсли;

	// --- 3. СНАЧАЛА очищаем старые движения документа ---
	// Это критически важно: ОстаткиИОбороты(&П, &П) показывает движения за период,
	// и старые записи нашего документа исказят дисбаланс.
	// Очищаем → сохраняем → ПОТОМ читаем чистый дисбаланс.
	ДокОбъект = ДокСсылка.ПолучитьОбъект();
	ДокОбъект.Движения.ПрочиеАктивыПассивы.Прочитать();
	СтарыхДвижений = ДокОбъект.Движения.ПрочиеАктивыПассивы.Количество();
	ДокОбъект.Движения.ПрочиеАктивыПассивы.Записывать = Истина;
	ДокОбъект.Движения.ПрочиеАктивыПассивы.Очистить();
	ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Сообщить("Старые движения удалены из регистра: " + СтарыхДвижений + " записей");

	// --- 4. Дисбаланс по (Орг, Подразделение, НаправлениеДеятельности) ---
	// Теперь в регистре нет наших старых записей — читаем чистый дисбаланс.
	// Дисбаланс > 0: активы > пассивы → нужен пассив (Расход по "Прибыль")
	// Дисбаланс < 0: пассивы > активы → нужен актив  (Приход по "Прибыль" = убыток)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПрочиеАктивыПассивыОстаткиИОбороты.Организация             КАК Организация,
		|	ПрочиеАктивыПассивыОстаткиИОбороты.Подразделение           КАК Подразделение,
		|	ПрочиеАктивыПассивыОстаткиИОбороты.НаправлениеДеятельности КАК НаправлениеДеятельности,
		|	СУММА(ПрочиеАктивыПассивыОстаткиИОбороты.СуммаКонечныйОстаток) КАК Дисбаланс
		|ИЗ
		|	РегистрНакопления.ПрочиеАктивыПассивы.ОстаткиИОбороты(&КонецПериода, &КонецПериода, , , ) КАК ПрочиеАктивыПассивыОстаткиИОбороты
		|ГДЕ
		|	ПрочиеАктивыПассивыОстаткиИОбороты.Статья <> &СтатьяПрибыль
		|СГРУППИРОВАТЬ ПО
		|	ПрочиеАктивыПассивыОстаткиИОбороты.Организация,
		|	ПрочиеАктивыПассивыОстаткиИОбороты.Подразделение,
		|	ПрочиеАктивыПассивыОстаткиИОбороты.НаправлениеДеятельности
		|ИМЕЮЩИЕ
		|	СУММА(ПрочиеАктивыПассивыОстаткиИОбороты.СуммаКонечныйОстаток) <> 0";
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("СтатьяПрибыль", СтатьяПрибыль);
	ТаблДисбаланс = Запрос.Выполнить().Выгрузить();

	// --- 5. Контрольная сумма ---
	ОбщийДисбаланс = 0;
	Для Каждого Стр Из ТаблДисбаланс Цикл
		ОбщийДисбаланс = ОбщийДисбаланс + Стр.Дисбаланс;
	КонецЦикла;
	Сообщить("Дисбаланс для выравнивания: " + Окр(ОбщийДисбаланс, 2)
		+ " | Строк к заполнению: " + ТаблДисбаланс.Количество());

	// --- 6. Заполняем новые движения ---
	КоличествоСтрок = 0;
	Для Каждого Стр Из ТаблДисбаланс Цикл

		Если Стр.Дисбаланс = 0 Тогда
			Продолжить;
		КонецЕсли;

		НовДвиж = ДокОбъект.Движения.ПрочиеАктивыПассивы.Добавить();
		НовДвиж.Период                  = КонецПериода;
		НовДвиж.Организация             = Стр.Организация;
		НовДвиж.Подразделение           = Стр.Подразделение;
		НовДвиж.НаправлениеДеятельности = Стр.НаправлениеДеятельности;
		НовДвиж.Статья                  = СтатьяПрибыль;
		НовДвиж.Сумма                   = Окр(?(Стр.Дисбаланс > 0, Стр.Дисбаланс, -Стр.Дисбаланс), 2);

		// Дисбаланс > 0: Актив > Пассив → добавляем Пассив = Расход
		// Дисбаланс < 0: Пассив > Актив → добавляем Актив  = Приход (убыток)
		Если Стр.Дисбаланс > 0 Тогда
			НовДвиж.ВидДвижения = ВидДвиженияНакопления.Расход;
		Иначе
			НовДвиж.ВидДвижения = ВидДвиженияНакопления.Приход;
		КонецЕсли;

		КоличествоСтрок = КоличествоСтрок + 1;
		Сообщить("  " + Стр.Подразделение
			+ ": Дисбаланс=" + Окр(Стр.Дисбаланс, 2) + "  → " + НовДвиж.ВидДвижения);

	КонецЦикла;

	// --- 7. Записываем документ (КорректировкаРегистров пишется без проведения) ---
	ДокОбъект.Записать(РежимЗаписиДокумента.Запись);

	Сообщить("=== ГОТОВО! Строк записано: " + КоличествоСтрок + " ===");

	// --- 8. Контрольная проверка: сумма по (Орг, Подр, Направление) должна быть = 0 ---
	ЗапросПроверка = Новый Запрос;
	ЗапросПроверка.Текст =
		"ВЫБРАТЬ
		|	Ост.Организация.Наименование             КАК Организация,
		|	Ост.Подразделение.Наименование           КАК Подразделение,
		|	Ост.НаправлениеДеятельности.Наименование КАК Направление,
		|	СУММА(Ост.СуммаКонечныйОстаток)          КАК Итого
		|ИЗ
		|	РегистрНакопления.ПрочиеАктивыПассивы.ОстаткиИОбороты(&КонецПериода, &КонецПериода, , , ) КАК Ост
		|СГРУППИРОВАТЬ ПО
		|	Ост.Организация,
		|	Ост.Подразделение,
		|	Ост.НаправлениеДеятельности
		|ИМЕЮЩИЕ
		|	СУММА(Ост.СуммаКонечныйОстаток) <> 0";
	ЗапросПроверка.УстановитьПараметр("КонецПериода", КонецПериода);
	РезПроверки = ЗапросПроверка.Выполнить().Выгрузить();

	Если РезПроверки.Количество() = 0 Тогда
		Сообщить("OK БАЛАНС ВИРИВНЕНО! Всі комбінації (Орг + Підрозділ + Напрямок) = 0");
	Иначе
		Сообщить("!! УВАГА: Залишились ненульові комбінації:");
		Для Каждого Стр Из РезПроверки Цикл
			НаправлСтр = ?(ПустаяСтрока(Стр.Направление), "<пусто>", Стр.Направление);
			Сообщить("  " + Стр.Подразделение + " | " + НаправлСтр + ": " + Окр(Стр.Итого, 2));
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)
	ЗаполнитьДокументНаСервере();
КонецПроцедуры
