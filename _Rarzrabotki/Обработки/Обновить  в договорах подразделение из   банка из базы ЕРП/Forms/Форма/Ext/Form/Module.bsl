
&НаСервере
Процедура ЗаполнитьВДоговорахПодразделениеИзБанкаНаСервере()

	// 1. Запит до документів СписаниеБезналичныхДенежныхСредств та ПоступлениеБезналичныхДенежныхСредств
	// Договір беремо з РасшифровкаПлатежа.А_Договор (в шапці Договор часто пустий!)
	// А_Подразделение та А_НаправлениеДеятельности беремо з шапки документа
	// Групуємо по Договір + Підрозділ + Напрямок та рахуємо кількість документів
	// Потім обираємо НАЙЧАСТІШЕ підрозділ/напрямок для кожного договору
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РП.А_Договор КАК Договор,
	|	Док.А_Подразделение КАК Подразделение,
	|	Док.А_НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Док.Ссылка) КАК КолДокументов
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК РП
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеБезналичныхДенежныхСредств КАК Док
	|		ПО РП.Ссылка = Док.Ссылка
	|ГДЕ
	|	Док.Проведен
	|	И РП.А_Договор <> ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|	И (Док.А_Подразделение <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ИЛИ Док.А_НаправлениеДеятельности <> ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка))
	|	И Док.Дата МЕЖДУ &Дата1 И &Дата2
	|
	|СГРУППИРОВАТЬ ПО
	|	РП.А_Договор,
	|	Док.А_Подразделение,
	|	Док.А_НаправлениеДеятельности
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РП.А_Договор,
	|	Док.А_Подразделение,
	|	Док.А_НаправлениеДеятельности,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Док.Ссылка)
	|ИЗ
	|	Документ.ПоступлениеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК РП
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеБезналичныхДенежныхСредств КАК Док
	|		ПО РП.Ссылка = Док.Ссылка
	|ГДЕ
	|	Док.Проведен
	|	И РП.А_Договор <> ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|	И (Док.А_Подразделение <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ИЛИ Док.А_НаправлениеДеятельности <> ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка))
	|	И Док.Дата МЕЖДУ &Дата1 И &Дата2
	|
	|СГРУППИРОВАТЬ ПО
	|	РП.А_Договор,
	|	Док.А_Подразделение,
	|	Док.А_НаправлениеДеятельности";

	// 2. Виконання запиту напряму в поточній базі
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата1", Дата(2025,12,1));
	Запрос.УстановитьПараметр("Дата2", КонецДня(ТекущаяДата()));
	Запрос.Текст = ТекстЗапроса;

	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		Таблица = РезультатЗапроса.Выгрузить();
	Исключение
		Сообщить("Помилка виконання запиту: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Сообщить("Отримано рядків з запиту: " + Таблица.Количество());

	// 3. Лічильники для статистики
	КоличествоОбновленных = 0;
	КоличествоПропущенных = 0;

	// 4. Підрахунок частоти: для кожного договору зберігаємо лічильники по підрозділу та напрямку
	// СоответствиеДоговоров[Договор] = Структура(СчетчикПодр, СчетчикНапр)
	// СчетчикПодр[Подразделение] = сума КолДокументов
	// СчетчикНапр[Направление] = сума КолДокументов
	СоответствиеДоговоров = Новый Соответствие;

	Для Каждого СтрокаТЗ Из Таблица Цикл

		Договор = СтрокаТЗ.Договор;

		Если НЕ ЗначениеЗаполнено(Договор) Тогда
			Продолжить;
		КонецЕсли;

		ДанныеДоговора = СоответствиеДоговоров.Получить(Договор);

		Если ДанныеДоговора = Неопределено Тогда
			ДанныеДоговора = Новый Структура("СчетчикПодр, СчетчикНапр",
				Новый Соответствие, Новый Соответствие);
			СоответствиеДоговоров.Вставить(Договор, ДанныеДоговора);
		КонецЕсли;

		// Додаємо кількість документів до лічильника підрозділу
		Если ЗначениеЗаполнено(СтрокаТЗ.Подразделение) Тогда
			ТекущееКол = ДанныеДоговора.СчетчикПодр.Получить(СтрокаТЗ.Подразделение);
			Если ТекущееКол = Неопределено Тогда
				ТекущееКол = 0;
			КонецЕсли;
			ДанныеДоговора.СчетчикПодр.Вставить(СтрокаТЗ.Подразделение, ТекущееКол + СтрокаТЗ.КолДокументов);
		КонецЕсли;

		// Додаємо кількість документів до лічильника напрямку
		Если ЗначениеЗаполнено(СтрокаТЗ.НаправлениеДеятельности) Тогда
			ТекущееКол = ДанныеДоговора.СчетчикНапр.Получить(СтрокаТЗ.НаправлениеДеятельности);
			Если ТекущееКол = Неопределено Тогда
				ТекущееКол = 0;
			КонецЕсли;
			ДанныеДоговора.СчетчикНапр.Вставить(СтрокаТЗ.НаправлениеДеятельности, ТекущееКол + СтрокаТЗ.КолДокументов);
		КонецЕсли;

	КонецЦикла;

	// 5. Обробка: для кожного договору обираємо найчастіше підрозділ/напрямок та записуємо
	Для Каждого КлючЗначение Из СоответствиеДоговоров Цикл

		Договор = КлючЗначение.Ключ;
		ДанныеДоговора = КлючЗначение.Значение;

		// 5.1. Знаходимо найчастіше підрозділ
		ПодразделениеНовое = Неопределено;
		МаксКолПодр = 0;
		Для Каждого КлючКол Из ДанныеДоговора.СчетчикПодр Цикл
			Если КлючКол.Значение > МаксКолПодр Тогда
				МаксКолПодр = КлючКол.Значение;
				ПодразделениеНовое = КлючКол.Ключ;
			КонецЕсли;
		КонецЦикла;

		// 5.2. Знаходимо найчастіше напрямок
		НаправлениеНовое = Неопределено;
		МаксКолНапр = 0;
		Для Каждого КлючКол Из ДанныеДоговора.СчетчикНапр Цикл
			Если КлючКол.Значение > МаксКолНапр Тогда
				МаксКолНапр = КлючКол.Значение;
				НаправлениеНовое = КлючКол.Ключ;
			КонецЕсли;
		КонецЦикла;

		// 5.3. Перевірка чи є що оновлювати
		Если НЕ ЗначениеЗаполнено(ПодразделениеНовое) И НЕ ЗначениеЗаполнено(НаправлениеНовое) Тогда
			КоличествоПропущенных = КоличествоПропущенных + 1;
			Продолжить;
		КонецЕсли;

		// 5.4. Перевірка чи змінилися значення
		БылиИзменения = Ложь;

		Если ЗначениеЗаполнено(ПодразделениеНовое) И Договор.А_ПодразделениеБанк <> ПодразделениеНовое Тогда
			БылиИзменения = Истина;
		КонецЕсли;

		Если ЗначениеЗаполнено(НаправлениеНовое) И Договор.А_НаправлениеДеятельностиБанк <> НаправлениеНовое Тогда
			БылиИзменения = Истина;
		КонецЕсли;

		Если НЕ БылиИзменения Тогда
			КоличествоПропущенных = КоличествоПропущенных + 1;
			Продолжить;
		КонецЕсли;

		// 5.5. Запис в договір
		Попытка
			Спр = Договор.ПолучитьОбъект();

			Если ЗначениеЗаполнено(ПодразделениеНовое) Тогда
				Спр.А_ПодразделениеБанк = ПодразделениеНовое;
			КонецЕсли;

			Если ЗначениеЗаполнено(НаправлениеНовое) Тогда
				Спр.А_НаправлениеДеятельностиБанк = НаправлениеНовое;
			КонецЕсли;

			Спр.ОбменДанными.Загрузка = Истина;

			Если ЗначениеЗаполнено(Спр.А_ПодразделениеБанк) И ЗначениеЗаполнено(Спр.А_НаправлениеДеятельностиБанк) Тогда

				Спр.Подразделение = А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны(Спр.А_НаправлениеДеятельностиБанк, Спр.А_ПодразделениеБанк);

			КонецЕсли;

			Спр.Записать();

			КоличествоОбновленных = КоличествоОбновленных + 1;

		Исключение
			Сообщить("Помилка оновлення договору " + Договор + ": " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	// 6. Виведення статистики
	Сообщить("===============================================");
	Сообщить("Оновлено договорів: " + КоличествоОбновленных);
	Если КоличествоПропущенных > 0 Тогда
		Сообщить("Пропущено (без змін або не знайдено підрозділ/напрямок): " + КоличествоПропущенных);
	КонецЕсли;
	Сообщить("Всього оброблено унікальних договорів: " + СоответствиеДоговоров.Количество());

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВДоговорахПодразделениеИзБанка(Команда)
	ЗаполнитьВДоговорахПодразделениеИзБанкаНаСервере();
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьВДоговорахПодразделениеИзБанка1(Команда)
	ЗаполнитьВДоговорахПодразделениеИзБанкаНаСервере();
КонецПроцедуры
