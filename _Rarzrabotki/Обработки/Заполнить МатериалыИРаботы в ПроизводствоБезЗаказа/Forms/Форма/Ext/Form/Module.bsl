////////////////////////////////////////////////////////////////////////////////
// Обробка: Заповнити МатериалыИРаботы в ПроизводствоБезЗаказа
// Призначення: Заповнює ТЧ "МатериалыИРаботы" в документі "ПроизводствоБезЗаказа"
//              матеріалами з регістра "МатериалыИРаботыВПроизводстве"
//
// ВАЖЛИВО: Це правильний підхід замість використання СписаниеЗатратНаВыпуск!
//          СписаниеЗатратНаВыпуск вимагає посилання на документ ВыпускПродукции,
//          який НЕ створюється при використанні ПроизводствоБезЗаказа.
//          При проведенні ПроизводствоБезЗаказа з заповненою ТЧ МатериалыИРаботы
//          списання матеріалів відбувається НАПРЯМУ у цьому ж документі.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Встановлення значення за замовчуванням
	Объект.ОчищатьТЧ = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура ЗаполнитьМатериалы(Команда)

	// Валідація вибору документа
	Если НЕ ЗначениеЗаполнено(Объект.ДокПроизводствоБезЗаказа) Тогда
		ПоказатьПредупреждение(, "Виберіть документ ""Виробництво без замовлення""!");
		Возврат;
	КонецЕсли;

	// Підтвердження дії
	ТекстВопроса = "Заповнити табличну частину ""Матеріали і роботи"" в обраному документі?";
	Если Объект.ОчищатьТЧ Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС + "УВАГА: Існуючі дані будуть очищені!";
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьМатериалыЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМатериалыЗавершение(Результат, ДопПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	// Виклик серверної процедури
	РезультатЗаполнения = ЗаполнитьМатериалыНаСервере();

	Если РезультатЗаполнения.Успешно Тогда
		ПоказатьПредупреждение(,
			"Документ успішно заповнено!" + Символы.ПС +
			"Додано рядків: " + РезультатЗаполнения.КоличествоСтрок);

		// Відкриття документа для перевірки
		Если ЗначениеЗаполнено(Объект.ДокПроизводствоБезЗаказа) Тогда
			ПоказатьЗначение(, Объект.ДокПроизводствоБезЗаказа);
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(, "Помилка: " + РезультатЗаполнения.ОписаниеОшибки);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПросмотрМатериалов(Команда)

	// Попередній перегляд матеріалів без заповнення
	Если НЕ ЗначениеЗаполнено(Объект.ДокПроизводствоБезЗаказа) Тогда
		ПоказатьПредупреждение(, "Виберіть документ ""Виробництво без замовлення""!");
		Возврат;
	КонецЕсли;

	ТаблицаМатериалов = ПолучитьМатериалыДляПросмотра();

	Если ТаблицаМатериалов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не знайдено матеріалів у регістрі за обраними параметрами!");
	Иначе
		Сообщить("Знайдено матеріалів: " + ТаблицаМатериалов.Количество());
		Для Каждого Строка Из ТаблицаМатериалов Цикл
			Сообщить(" - " + Строка.Номенклатура + " (" + Строка.Характеристика + "): " + Строка.Количество);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СерверныеПроцедуры

&НаСервере
Функция ЗаполнитьМатериалыНаСервере()

	Результат = Новый Структура("Успешно, КоличествоСтрок, ОписаниеОшибки", Ложь, 0, "");

	ПроизводствоБезЗаказаСсылка = Объект.ДокПроизводствоБезЗаказа;

	// Отримання матеріалів з регістра
	ТаблицаМатериалов = ПолучитьМатериалыИзРегистра(ПроизводствоБезЗаказаСсылка);

	Если ТаблицаМатериалов.Количество() = 0 Тогда
		Результат.ОписаниеОшибки = "Не знайдено матеріалів у регістрі ""Матеріали і роботи у виробництві"" за підрозділом "
			+ Строка(ПроизводствоБезЗаказаСсылка.Подразделение) + " за місяць документа!";
		Возврат Результат;
	КонецЕсли;

	Попытка
		// Отримання об'єкта документа для редагування
		ДокОбъект = ПроизводствоБезЗаказаСсылка.ПолучитьОбъект();

		Если ДокОбъект = Неопределено Тогда
			Результат.ОписаниеОшибки = "Не вдалося отримати об'єкт документа для редагування!";
			Возврат Результат;
		КонецЕсли;

		// Блокування об'єкта
		ДокОбъект.Заблокировать();

		// Очищення ТЧ якщо потрібно
		Если Объект.ОчищатьТЧ Тогда
			ДокОбъект.МатериалыИРаботы.Очистить();
			Сообщить("Табличну частину МатериалыИРаботы очищено");
		КонецЕсли;

		// Заповнення ТЧ МатериалыИРаботы
		КоличествоДобавленных = 0;
		Для Каждого СтрокаМатериала Из ТаблицаМатериалов Цикл

			// Перевірка чи вже є такий рядок (якщо не очищаємо)
			Если НЕ Объект.ОчищатьТЧ Тогда
				СтруктураПоиска = Новый Структура;
				СтруктураПоиска.Вставить("Номенклатура", СтрокаМатериала.Номенклатура);
				СтруктураПоиска.Вставить("Характеристика", СтрокаМатериала.Характеристика);

				НайденныеСтроки = ДокОбъект.МатериалыИРаботы.НайтиСтроки(СтруктураПоиска);
				Если НайденныеСтроки.Количество() > 0 Тогда
					// Оновлюємо кількість в існуючому рядку
					НайденныеСтроки[0].Количество = НайденныеСтроки[0].Количество + СтрокаМатериала.Количество;
					НайденныеСтроки[0].КоличествоУпаковок = НайденныеСтроки[0].КоличествоУпаковок + СтрокаМатериала.Количество;
					Сообщить("Оновлено кількість для: " + Строка(СтрокаМатериала.Номенклатура));
					КоличествоДобавленных = КоличествоДобавленных + 1;
					Продолжить;
				КонецЕсли;
			КонецЕсли;

			// Додавання нового рядка
			НоваяСтрока = ДокОбъект.МатериалыИРаботы.Добавить();

			// Обов'язкові поля
			НоваяСтрока.Номенклатура = СтрокаМатериала.Номенклатура;
			НоваяСтрока.Характеристика = СтрокаМатериала.Характеристика;
			НоваяСтрока.Количество = СтрокаМатериала.Количество;
			НоваяСтрока.КоличествоУпаковок = СтрокаМатериала.Количество;

			// Склад - беремо з підрозділу або перший склад організації
			// (в документі немає реквізиту СкладМатериалов)
			Попытка
				Если ЗначениеЗаполнено(ДокОбъект.Подразделение.СкладПоУмолчанию) Тогда
					НоваяСтрока.Склад = ДокОбъект.Подразделение.СкладПоУмолчанию;
				КонецЕсли;
			Исключение
				// Реквізит відсутній - пропускаємо
			КонецПопытки;

			// Підрозділ
			Если ЗначениеЗаполнено(СтрокаМатериала.Подразделение) Тогда
				НоваяСтрока.Подразделение = СтрокаМатериала.Подразделение;
			Иначе
				НоваяСтрока.Подразделение = ДокОбъект.Подразделение;
			КонецЕсли;

			// Додаткові поля з регістра
			НоваяСтрока.Назначение = СтрокаМатериала.Назначение;
			НоваяСтрока.Серия = СтрокаМатериала.Серия;

			// Тип номенклатури (для правильного проведення)
			Попытка
				НоваяСтрока.ТипНоменклатуры = СтрокаМатериала.Номенклатура.ТипНоменклатуры;
			Исключение
				// Реквізит відсутній - пропускаємо
			КонецПопытки;

			// Номер групи витрат - беремо з першого виробу або 1
			Попытка
				Если ДокОбъект.ВыходныеИзделия.Количество() > 0 Тогда
					НоваяСтрока.НомерГруппыЗатрат = ДокОбъект.ВыходныеИзделия[0].НомерГруппыЗатрат;
				Иначе
					НоваяСтрока.НомерГруппыЗатрат = 1;
				КонецЕсли;
			Исключение
				// Реквізит відсутній - пропускаємо
			КонецПопытки;

			КоличествоДобавленных = КоличествоДобавленных + 1;
			Сообщить("Додано: " + Строка(СтрокаМатериала.Номенклатура) + " - " + СтрокаМатериала.Количество);

		КонецЦикла;

		// Запис документа БЕЗ проведення (користувач сам проведе після перевірки)
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		Сообщить("Документ записано. Перевірте дані та проведіть документ вручну.");

		Результат.Успешно = Истина;
		Результат.КоличествоСтрок = КоличествоДобавленных;

	Исключение
		Результат.ОписаниеОшибки = "Помилка при заповненні: " + ОписаниеОшибки();
		Сообщить(Результат.ОписаниеОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПолучитьМатериалыДляПросмотра()

	Возврат ПолучитьМатериалыИзРегистра(Объект.ДокПроизводствоБезЗаказа);

КонецФункции

&НаСервере
Функция ПолучитьМатериалыИзРегистра(ПроизводствоБезЗаказаСсылка)

	// Запит до регістра МатериалыИРаботыВПроизводстве
	// Отримуємо залишки матеріалів, які були передані у виробництво
	// і ще не списані
	// ВАЖЛИВО: В .Остатки() доступні ТІЛЬКИ вимірювання та ресурси!
	// СтатьяКалькуляции та АналитикаУчетаНоменклатуры - це реквізити, їх немає в остатках
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	МатериалыИРаботыВПроизводстве.Номенклатура КАК Номенклатура,
		|	МатериалыИРаботыВПроизводстве.Характеристика КАК Характеристика,
		|	МатериалыИРаботыВПроизводстве.Подразделение КАК Подразделение,
		|	МатериалыИРаботыВПроизводстве.Серия КАК Серия,
		|	МатериалыИРаботыВПроизводстве.Назначение КАК Назначение,
		|	МатериалыИРаботыВПроизводстве.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.МатериалыИРаботыВПроизводстве.Остатки(
		|		,
		|		Организация = &Организация
		|			И Подразделение = &Подразделение) КАК МатериалыИРаботыВПроизводстве
		|ГДЕ
		|	МатериалыИРаботыВПроизводстве.КоличествоОстаток > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура,
		|	Характеристика";

	Запрос.УстановитьПараметр("Организация", ПроизводствоБезЗаказаСсылка.Организация);
	Запрос.УстановитьПараметр("Подразделение", ПроизводствоБезЗаказаСсылка.Подразделение);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти
