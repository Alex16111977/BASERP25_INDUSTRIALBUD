       ////////////////////////////////////////////////////////////////////////////////
// Обновление начислений в документе НачислениеЗарплаты по данным из базы ЗУП
// 
// ИСТОЧНИК ДАННЫХ:
//   - База ЗУП: регистр А_НастройкиПодключенияБаз, идентификатор "zup_2"
//   - Документ: НачислениеЗарплатыРаботникам (ВСЕ за месяц)
//   - ТЧ: Начисления, Удержания
//
// ЦЕЛЕВОЙ ОБЪЕКТ (ERP):
//   - Документ: НачислениеЗарплаты (ОДИН выбранный)
//   - ТЧ: А_Начисления, А_Удержания, А_НачисленияБух → Начисления, Удержания, ФизическиеЛица
//
// ЛОГИКА ЗАПОЛНЕНИЯ:
//   1. А_Начисления → Начисления (все записи)
//   2. А_Удержания → Удержания (все записи)
//   3. А_НачисленияБух → Начисления (ТОЛЬКО ФизЛица которых НЕТ в А_Начисления,
//      суммируя по ФизЛицо по всем организациям)
//
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьНачисленияИзЗУП(Команда)
	
	ОчиститьСообщения();
	
	Если НЕ ЗначениеЗаполнено(Объект.ДокНачислениеЗарплаты) Тогда
		ПоказатьПредупреждение(, "Выберите документ НачислениеЗарплаты!");
		Возврат;
	КонецЕсли;
	
	Результат = ЗаполнитьНачисленияИзЗУПНаСервере();
	
	Если Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Сообщение);
	Иначе
		ПоказатьПредупреждение(, "Ошибка: " + Результат.Сообщение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основная серверная процедура
&НаСервере
Функция ЗаполнитьНачисленияИзЗУПНаСервере()
	
	Результат = Новый Структура("Успех, Сообщение", Ложь, "");
	
	СоединениеЗУП = Неопределено;
	
	Попытка
		
		// 1. Подключаемся к базе ЗУП
		СоединениеЗУП = ПодключитьсяКБазеЗУП();
		
		Если СоединениеЗУП = Неопределено Тогда
			Результат.Сообщение = "Не удалось подключиться к базе ЗУП!";
			Возврат Результат;
		КонецЕсли;
		
		// 2. Получаем ВСЕ начисления и удержания из ЗУП за месяц
		ДанныеЗУП = ПолучитьДанныеИзЗУП(СоединениеЗУП);
		
		Если ДанныеЗУП = Неопределено Тогда
			Результат.Сообщение = СтрШаблон(
				"Не найдено данных в ЗУП за %1",
				Формат(Объект.ДокНачислениеЗарплаты.МесяцНачисления, "ДФ='ММММ гггг'"));
			СоединениеЗУП = Неопределено;
			Возврат Результат;
		КонецЕсли;
		
		// 3. Подготовка соответствия ФизЛиц по КодПоДРФО
		СоответствиеФизЛиц = ПодготовитьСоответствиеФизЛиц();
		
		// 4. Заполняем транзитные ТЧ (А_Начисления, А_Удержания)
		РезультатЗаполнения = ЗаполнитьДокументERP(Объект.ДокНачислениеЗарплаты, ДанныеЗУП, СоответствиеФизЛиц);
		
		// 5. Заполняем основные ТЧ (Начисления, Удержания, ФизическиеЛица)
		РезультатОсновныхТЧ = ЗаполнитьОсновныеТабличныеЧасти(Объект.ДокНачислениеЗарплаты);
		
		// 6. Отключаемся от ЗУП
		СоединениеЗУП = Неопределено;
		
		Результат.Успех = Истина;
		Результат.Сообщение = СтрШаблон(
			"Документ №%1 заполнен данными за %2:
			|• Загружено в А_Начисления: %3
			|• Загружено в А_Удержания: %4
			|• Заполнено Начисления (из А_Начисления): %5
			|• Заполнено Начисления (из А_НачисленияБух): %6
			|• Заполнено Удержания: %7
			|• Физических лиц: %8
			|• Документов ЗУП обработано: %9",
			СокрЛП(Объект.ДокНачислениеЗарплаты.Номер),
			Формат(Объект.ДокНачислениеЗарплаты.МесяцНачисления, "ДФ='ММММ гггг'"),
			РезультатЗаполнения.КолНачислений,
			РезультатЗаполнения.КолУдержаний,
			РезультатОсновныхТЧ.КолНачислений,
			РезультатОсновныхТЧ.КолНачисленийБух,
			РезультатОсновныхТЧ.КолУдержаний,
			РезультатОсновныхТЧ.КолФизЛиц,
			ДанныеЗУП.КолДокументов);
		
	Исключение
		СоединениеЗУП = Неопределено;
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#Область ПодключениеКЗУП

// Подключение к базе ЗУП через COM
&НаСервере
Функция ПодключитьсяКБазеЗУП()
	
	Попытка
		
		Connector = Новый COMОбъект("V83.COMConnector");
		
		// Строка подключения к ЗУП
		СтрокаСоединения = А_ПодключенияБазСервер.СтрокаПодключения("zup_2");
		V8 = Connector.Connect(СтрокаСоединения);
		
		Возврат V8;
		
	Исключение
		Сообщить("Ошибка подключения к ЗУП: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Получение ВСЕХ данных из ЗУП за месяц
&НаСервере
Функция ПолучитьДанныеИзЗУП(СоединениеЗУП)
	
	Попытка
		
		НачалоПериода = НачалоМесяца(Объект.ДокНачислениеЗарплаты.МесяцНачисления);
		КонецПериода = КонецМесяца(Объект.ДокНачислениеЗарплаты.МесяцНачисления);
		
		// Структура для результата
		Данные = Новый Структура("Начисления, Удержания, КолДокументов");
		Данные.Начисления = Новый Массив;
		Данные.Удержания = Новый Массив;
		Данные.КолДокументов = 0;
		
		// Запрос начислений из ВСЕХ документов за месяц
		ТекстЗапросаНачисления = 
		"ВЫБРАТЬ
		|	Начисления.Физлицо.КодПоДРФО КАК КодПоДРФО,
		|	Начисления.ВидРасчета.Наименование КАК ВидРасчета,
		|	Начисления.ВидРасчета.Код КАК КодВидРасчета,
		|	Начисления.Результат КАК Сумма
		|ИЗ
		|	Документ.НачислениеЗарплатыРаботникам.Начисления КАК Начисления
		|ГДЕ
		|	Начисления.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Начисления.Ссылка.Проведен = ИСТИНА
		|	И Начисления.Результат <> 0";
		
		ЗапросНачисления = СоединениеЗУП.NewObject("Запрос");
		ЗапросНачисления.Текст = ТекстЗапросаНачисления;
		ЗапросНачисления.УстановитьПараметр("НачалоПериода", НачалоПериода);
		ЗапросНачисления.УстановитьПараметр("КонецПериода", КонецПериода);
		
		РезультатНачисления = ЗапросНачисления.Выполнить();
		ВыборкаНачисления = РезультатНачисления.Выбрать();
		
		Пока ВыборкаНачисления.Следующий() Цикл
			СтрокаНачисления = Новый Структура("КодПоДРФО, ВидРасчета, КодВидРасчета, Сумма");
			СтрокаНачисления.КодПоДРФО = СокрЛП(ВыборкаНачисления.КодПоДРФО);
			СтрокаНачисления.ВидРасчета = СокрЛП(ВыборкаНачисления.ВидРасчета);
			СтрокаНачисления.КодВидРасчета = СокрЛП(ВыборкаНачисления.КодВидРасчета);
			СтрокаНачисления.Сумма = ВыборкаНачисления.Сумма;
			Данные.Начисления.Добавить(СтрокаНачисления);
		КонецЦикла;
		
		// Запрос удержаний из ВСЕХ документов за месяц
		ТекстЗапросаУдержания = 
		"ВЫБРАТЬ
		|	Удержания.Физлицо.КодПоДРФО КАК КодПоДРФО,
		|	Удержания.ВидРасчета.Наименование КАК ВидРасчета,
		|	Удержания.ВидРасчета.Код КАК КодВидРасчета,
		|	Удержания.Результат КАК Сумма
		|ИЗ
		|	Документ.НачислениеЗарплатыРаботникам.Удержания КАК Удержания
		|ГДЕ
		|	Удержания.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Удержания.Ссылка.Проведен = ИСТИНА
		|	И Удержания.Результат <> 0";
		
		ЗапросУдержания = СоединениеЗУП.NewObject("Запрос");
		ЗапросУдержания.Текст = ТекстЗапросаУдержания;
		ЗапросУдержания.УстановитьПараметр("НачалоПериода", НачалоПериода);
		ЗапросУдержания.УстановитьПараметр("КонецПериода", КонецПериода);
		
		РезультатУдержания = ЗапросУдержания.Выполнить();
		ВыборкаУдержания = РезультатУдержания.Выбрать();
		
		Пока ВыборкаУдержания.Следующий() Цикл
			СтрокаУдержания = Новый Структура("КодПоДРФО, ВидРасчета, КодВидРасчета, Сумма");
			СтрокаУдержания.КодПоДРФО = СокрЛП(ВыборкаУдержания.КодПоДРФО);
			СтрокаУдержания.ВидРасчета = СокрЛП(ВыборкаУдержания.ВидРасчета);
			СтрокаУдержания.КодВидРасчета = СокрЛП(ВыборкаУдержания.КодВидРасчета);
			СтрокаУдержания.Сумма = ВыборкаУдержания.Сумма;
			Данные.Удержания.Добавить(СтрокаУдержания);
		КонецЦикла;
		
		// Подсчёт количества документов ЗУП
		ТекстЗапросаКоличество = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Док.Ссылка) КАК Количество
		|ИЗ
		|	Документ.НачислениеЗарплатыРаботникам КАК Док
		|ГДЕ
		|	Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Док.Проведен = ИСТИНА";
		
		ЗапросКоличество = СоединениеЗУП.NewObject("Запрос");
		ЗапросКоличество.Текст = ТекстЗапросаКоличество;
		ЗапросКоличество.УстановитьПараметр("НачалоПериода", НачалоПериода);
		ЗапросКоличество.УстановитьПараметр("КонецПериода", КонецПериода);
		
		РезультатКоличество = ЗапросКоличество.Выполнить();
		ВыборкаКоличество = РезультатКоличество.Выбрать();
		Если ВыборкаКоличество.Следующий() Тогда
			Данные.КолДокументов = ВыборкаКоличество.Количество;
		КонецЕсли;
		
		// Проверка что есть данные
		Если Данные.Начисления.Количество() = 0 И Данные.Удержания.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Возврат Данные;
		
	Исключение
		Сообщить("Ошибка получения данных из ЗУП: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область РаботаСДаннымиERP

// Подготовка соответствия физлиц по КодПоДРФО
&НаСервере
Функция ПодготовитьСоответствиеФизЛиц()
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ФизическиеЛица.Ссылка КАК Ссылка,
	|	ФизическиеЛица.КодПоДРФО КАК КодПоДРФО
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|ГДЕ
	|	ФизическиеЛица.КодПоДРФО <> """"";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		КодДРФО = СокрЛП(Выборка.КодПоДРФО);
		Если ЗначениеЗаполнено(КодДРФО) Тогда
			Результат.Вставить(КодДРФО, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Заполнение транзитных ТЧ документа ERP данными из ЗУП (А_Начисления, А_Удержания)
&НаСервере
Функция ЗаполнитьДокументERP(СсылкаДокумента, ДанныеЗУП, СоответствиеФизЛиц)
	
	Результат = Новый Структура("КолНачислений, КолУдержаний", 0, 0);
	
	ДокОбъект = СсылкаДокумента.ПолучитьОбъект();
	
	Если ДокОбъект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Очищаем транзитные табличные части
	ДокОбъект.А_Начисления.Очистить();
	ДокОбъект.А_Удержания.Очистить();
	
	// Заполняем А_Начисления
	Для Каждого СтрокаНачисления Из ДанныеЗУП.Начисления Цикл
		
		// Ищем физлицо по КодПоДРФО
		ФизЛицо = СоответствиеФизЛиц[СтрокаНачисления.КодПоДРФО];
		
		Если ФизЛицо = Неопределено Тогда
			Сообщить("Не найдено физлицо с КодПоДРФО: " + СтрокаНачисления.КодПоДРФО);
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДокОбъект.А_Начисления.Добавить();
		НоваяСтрока.ФизЛицо = ФизЛицо;
		НоваяСтрока.Сумма = СтрокаНачисления.Сумма;
		НоваяСтрока.ВидРасчета = СтрокаНачисления.ВидРасчета;
		НоваяСтрока.КодВидРасчета = СтрокаНачисления.КодВидРасчета;
		
		Результат.КолНачислений = Результат.КолНачислений + 1;
		
	КонецЦикла;
	
	// Заполняем А_Удержания
	Для Каждого СтрокаУдержания Из ДанныеЗУП.Удержания Цикл
		
		// Ищем физлицо по КодПоДРФО
		ФизЛицо = СоответствиеФизЛиц[СтрокаУдержания.КодПоДРФО];
		
		Если ФизЛицо = Неопределено Тогда
			Сообщить("Не найдено физлицо с КодПоДРФО: " + СтрокаУдержания.КодПоДРФО);
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДокОбъект.А_Удержания.Добавить();
		НоваяСтрока.ФизЛицо = ФизЛицо;
		НоваяСтрока.Сумма = СтрокаУдержания.Сумма;
		НоваяСтрока.ВидРасчета = СтрокаУдержания.ВидРасчета;
		НоваяСтрока.КодВидРасчета = СтрокаУдержания.КодВидРасчета;
		
		Результат.КолУдержаний = Результат.КолУдержаний + 1;
		
	КонецЦикла;
	
	// Записываем документ БЕЗ проведения (сохраняем текущий статус)
	ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	
	Возврат Результат;
	
КонецФункции

// Заполнение основных ТЧ (Начисления, Удержания, ФизическиеЛица) 
// из транзитных А_Начисления, А_Удержания + А_НачисленияБух
&НаСервере
Функция ЗаполнитьОсновныеТабличныеЧасти(СсылкаДокумента)
	
	Результат = Новый Структура("КолНачислений, КолНачисленийБух, КолУдержаний, КолФизЛиц", 0, 0, 0, 0);
	
	ДокОбъект = СсылкаДокумента.ПолучитьОбъект();
	
	Если ДокОбъект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Устанавливаем реквизиты шапки
	ДокОбъект.Организация = А_Привилегированный.А_ПолучитьОрганизациюУпр();
	ДокОбъект.МесяцНачисления = НачалоМесяца(ДокОбъект.Дата);
	ДокОбъект.ПорядокВыплаты = Перечисления.ХарактерВыплатыЗарплаты.Зарплата;
	
	// Очищаем основные ТЧ
	ДокОбъект.Начисления.Очистить();
	ДокОбъект.Удержания.Очистить();
	ДокОбъект.ФизическиеЛица.Очистить();
	
	// Подготовка таблицы для сбора уникальных физлиц
	ТЗ_ФизическиеЛица = ДокОбъект.ФизическиеЛица.Выгрузить();
	
	// Период начисления
	ДатаНачала = НачалоМесяца(ДокОбъект.Дата);
	ДатаОкончания = КонецМесяца(ДокОбъект.Дата);
	
	// =========================================================================
	// ЭТАП 1: Собираем набор ФизЛиц из А_Начисления (для исключения дублей)
	// =========================================================================
	ФизЛицаИзАНачисления = Новый Соответствие;
	
	Для Каждого СтрокаИсточник Из ДокОбъект.А_Начисления Цикл
		ФизЛицаИзАНачисления.Вставить(СтрокаИсточник.ФизЛицо, Истина);
	КонецЦикла;
	
	// =========================================================================
	// ЭТАП 2: Заполняем ТЧ Начисления из А_Начисления
	// =========================================================================
	Для Каждого СтрокаИсточник Из ДокОбъект.А_Начисления Цикл
		
		// Находим сотрудника по физлицу
		Сотрудник = А_Привилегированный.А_НайтиСотрудникаПоФизЛицу(СтрокаИсточник.ФизЛицо);
		
		Если НЕ ЗначениеЗаполнено(Сотрудник) Тогда
			Сообщить("Не найден сотрудник для физлица: " + СтрокаИсточник.ФизЛицо);
			Продолжить;
		КонецЕсли;
		
		// Находим вид расчета (начисление) по коду
		Начисление = А_Привилегированный.А_НайтиВидРасчетаПоКоду(СтрокаИсточник.КодВидРасчета, Истина);
		
		Если НЕ ЗначениеЗаполнено(Начисление) Тогда
			Сообщить("Не найден вид начисления с кодом: " + СтрокаИсточник.КодВидРасчета);
			Продолжить;
		КонецЕсли;
		
		СтрокаНачисления = ДокОбъект.Начисления.Добавить();
		СтрокаНачисления.Сотрудник = Сотрудник;
		СтрокаНачисления.Результат = СтрокаИсточник.Сумма;
		СтрокаНачисления.Начисление = Начисление;
		СтрокаНачисления.ДатаНачала = ДатаНачала;
		СтрокаНачисления.ДатаОкончания = ДатаОкончания;
		
		Результат.КолНачислений = Результат.КолНачислений + 1;
		
		// Добавляем физлицо в таблицу
		СтрокаФизЛица = ТЗ_ФизическиеЛица.Добавить();
		СтрокаФизЛица.ФизическоеЛицо = СтрокаИсточник.ФизЛицо;
		
	КонецЦикла;
	
	// =========================================================================
	// ЭТАП 3: Обрабатываем А_НачисленияБух - суммируем по ФизЛицо
	//         ТОЛЬКО для тех, кого НЕТ в А_Начисления
	// =========================================================================
	
	// Соответствие для суммирования: ФизЛицо -> Структура(Сумма, КодВидРасчета, ВидРасчета)
	СуммыИзБух = Новый Соответствие;
	
	Для Каждого СтрокаБух Из ДокОбъект.А_НачисленияБух Цикл
		
		// Проверяем: если ФизЛицо УЖЕ есть в А_Начисления - пропускаем
		Если ФизЛицаИзАНачисления[СтрокаБух.ФизЛицо] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		// Суммируем по ФизЛицо
		ДанныеФизЛица = СуммыИзБух[СтрокаБух.ФизЛицо];
		
		Если ДанныеФизЛица = Неопределено Тогда
			// Первая запись для этого ФизЛица
			ДанныеФизЛица = Новый Структура("Сумма, КодВидРасчета, ВидРасчета");
			ДанныеФизЛица.Сумма = СтрокаБух.Сумма;
			ДанныеФизЛица.КодВидРасчета = СтрокаБух.КодВидРасчета;
			ДанныеФизЛица.ВидРасчета = СтрокаБух.ВидРасчета;
			СуммыИзБух.Вставить(СтрокаБух.ФизЛицо, ДанныеФизЛица);
		Иначе
			// Добавляем к существующей сумме
			ДанныеФизЛица.Сумма = ДанныеФизЛица.Сумма + СтрокаБух.Сумма;
		КонецЕсли;
		
	КонецЦикла;
	
	// Добавляем суммированные данные в ТЧ Начисления
	Для Каждого КлючЗначение Из СуммыИзБух Цикл
		
		ФизЛицо = КлючЗначение.Ключ;
		ДанныеФизЛица = КлючЗначение.Значение;
		
		// Находим сотрудника по физлицу
		Сотрудник = А_Привилегированный.А_НайтиСотрудникаПоФизЛицу(ФизЛицо);
		
		Если НЕ ЗначениеЗаполнено(Сотрудник) Тогда
			Сообщить("(Бух) Не найден сотрудник для физлица: " + ФизЛицо);
			Продолжить;
		КонецЕсли;
		
		// Находим вид расчета (начисление) по коду
		Начисление = А_Привилегированный.А_НайтиВидРасчетаПоКоду(ДанныеФизЛица.КодВидРасчета, Истина);
		
		Если НЕ ЗначениеЗаполнено(Начисление) Тогда
			Сообщить("(Бух) Не найден вид начисления с кодом: " + ДанныеФизЛица.КодВидРасчета);
			Продолжить;
		КонецЕсли;
		
		СтрокаНачисления = ДокОбъект.Начисления.Добавить();
		СтрокаНачисления.Сотрудник = Сотрудник;
		СтрокаНачисления.Результат = ДанныеФизЛица.Сумма;
		СтрокаНачисления.Начисление = Начисление;
		СтрокаНачисления.ДатаНачала = ДатаНачала;
		СтрокаНачисления.ДатаОкончания = ДатаОкончания;
		
		Результат.КолНачисленийБух = Результат.КолНачисленийБух + 1;
		
		// Добавляем физлицо в таблицу
		СтрокаФизЛица = ТЗ_ФизическиеЛица.Добавить();
		СтрокаФизЛица.ФизическоеЛицо = ФизЛицо;
		
	КонецЦикла;
	
	// =========================================================================
	// ЭТАП 4: Заполняем ТЧ Удержания из А_Удержания
	// =========================================================================
	Для Каждого СтрокаИсточник Из ДокОбъект.А_Удержания Цикл
		
		// Находим вид расчета (удержание) по коду
		Удержание = А_Привилегированный.А_НайтиВидРасчетаПоКоду(СтрокаИсточник.КодВидРасчета, Ложь);
		
		Если НЕ ЗначениеЗаполнено(Удержание) Тогда
			// Пропускаем удержания без соответствия (как в оригинале)
			Продолжить;
		КонецЕсли;
		
		СтрокаУдержания = ДокОбъект.Удержания.Добавить();
		СтрокаУдержания.ФизическоеЛицо = СтрокаИсточник.ФизЛицо;
		СтрокаУдержания.Результат = СтрокаИсточник.Сумма;
		СтрокаУдержания.Удержание = Удержание;
		СтрокаУдержания.ДатаНачала = ДатаНачала;
		СтрокаУдержания.ДатаОкончания = ДатаОкончания;
		
		Результат.КолУдержаний = Результат.КолУдержаний + 1;
		
		// Добавляем физлицо в таблицу
		СтрокаФизЛица = ТЗ_ФизическиеЛица.Добавить();
		СтрокаФизЛица.ФизическоеЛицо = СтрокаИсточник.ФизЛицо;
		
	КонецЦикла;
	
	// =========================================================================
	// ЭТАП 5: Сворачиваем таблицу физлиц и загружаем в документ
	// =========================================================================
	ТЗ_ФизическиеЛица.Свернуть("ФизическоеЛицо");
	ДокОбъект.ФизическиеЛица.Загрузить(ТЗ_ФизическиеЛица);
	
	Результат.КолФизЛиц = ДокОбъект.ФизическиеЛица.Количество();
	
	// Устанавливаем признак обработки
	ДокОбъект.А_Обработан = Истина;
	
	// Записываем документ БЕЗ проведения
	ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти