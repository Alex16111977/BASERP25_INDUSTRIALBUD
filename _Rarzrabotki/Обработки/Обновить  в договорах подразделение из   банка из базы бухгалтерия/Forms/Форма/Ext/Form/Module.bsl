
&НаСервере
Процедура ЗаполнитьВДоговорахПодразделениеИзБанкаНаСервере()

	// 1. Параметри підключення до бухгалтерської бази
	СтрокаПодключенияБух = "Srvr=""SQLSERVER"";Ref=""BuhBud"";Usr=""cfo"";Pwd=""2442""";

	// 2. Створення COM-конектора
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияБух));
	Исключение
		Сообщить("Помилка підключення до бази BuhBud: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	// 3. Формування тексту запиту для BuhBud
	// Отримуємо з документів СписаниеСРасчетногоСчета та ПоступлениеНаРасчетныйСчет
	// ідентифікатори договору, підрозділу та напрямку
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СписаниеСРасчетногоСчета.ДоговорКонтрагента.А_ИдКод КАК ДоговорИдКод,
	|	МАКСИМУМ(СписаниеСРасчетногоСчета.Подразделение.А_ИдКод) КАК ПодразделениеИдКод,
	|	МАКСИМУМ(СписаниеСРасчетногоСчета.Направление.А_ИдКод) КАК НаправлениеИдКод
	|ИЗ
	|	Документ.СписаниеСРасчетногоСчета КАК СписаниеСРасчетногоСчета
	|ГДЕ
	|	СписаниеСРасчетногоСчета.Проведен
	|	И СписаниеСРасчетногоСчета.ДоговорКонтрагента <> ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|	И (СписаниеСРасчетногоСчета.Подразделение <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		ИЛИ СписаниеСРасчетногоСчета.Направление <> ЗНАЧЕНИЕ(Справочник.Направления.ПустаяСсылка))
	|
	|СГРУППИРОВАТЬ ПО
	|	СписаниеСРасчетногоСчета.ДоговорКонтрагента.А_ИдКод
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеНаРасчетныйСчет.ДоговорКонтрагента.А_ИдКод,
	|	МАКСИМУМ(ПоступлениеНаРасчетныйСчет.Подразделение.А_ИдКод),
	|	МАКСИМУМ(ПоступлениеНаРасчетныйСчет.Направление.А_ИдКод)
	|ИЗ
	|	Документ.ПоступлениеНаРасчетныйСчет КАК ПоступлениеНаРасчетныйСчет
	|ГДЕ
	|	ПоступлениеНаРасчетныйСчет.Проведен
	|	И ПоступлениеНаРасчетныйСчет.ДоговорКонтрагента <> ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|	И (ПоступлениеНаРасчетныйСчет.Подразделение <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		ИЛИ ПоступлениеНаРасчетныйСчет.Направление <> ЗНАЧЕНИЕ(Справочник.Направления.ПустаяСсылка))
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеНаРасчетныйСчет.ДоговорКонтрагента.А_ИдКод";

	// 4. Виконання запиту в бухгалтерській базі
	Попытка
		Запрос = V83.NewObject("Запрос");
		Запрос.Текст = ТекстЗапроса;
		РезультатЗапроса = Запрос.Выполнить();
		ТЗ = РезультатЗапроса.Выгрузить();
	Исключение
		V83 = Неопределено;
		V8 = Неопределено;
		Сообщить("Помилка виконання запиту в базі BuhBud: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	// 5. Серіалізація таблиці значень для передачі через COM
	Попытка
		стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗ);
	Исключение
		V83 = Неопределено;
		V8 = Неопределено;
		Сообщить("Помилка серіалізації даних: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	// 6. Відключення від бухгалтерської бази
	V83 = Неопределено;
	V8 = Неопределено;

	// 7. Десеріалізація таблиці значень в поточній базі
	Таблица = ЗначениеИзСтрокиВнутр(стр_ТЗ);

	// 8. Лічильники для статистики
	КоличествоОбновленных = 0;
	КоличествоПропущенных = 0;
	КоличествоНеНайденных = 0;

	// 9. Згортання результатів по договору (беремо перший непустий підрозділ/напрямок)
	СоответствиеДоговоров = Новый Соответствие;

	Для Каждого СтрокаТЗ Из Таблица Цикл

		ДоговорИдКод = СокрЛП(СтрокаТЗ.ДоговорИдКод);

		// Пропускаємо пусті ідентифікатори
		Если ПустаяСтрока(ДоговорИдКод) Тогда
			Продолжить;
		КонецЕсли;

		// Якщо договір вже оброблений - перевіряємо чи можна доповнити
		ДанныеДоговора = СоответствиеДоговоров.Получить(ДоговорИдКод);

		Если ДанныеДоговора = Неопределено Тогда
			// Новий договір - додаємо
			ДанныеДоговора = Новый Структура("ПодразделениеИдКод, НаправлениеИдКод",
				СокрЛП(СтрокаТЗ.ПодразделениеИдКод),
				СокрЛП(СтрокаТЗ.НаправлениеИдКод));
			СоответствиеДоговоров.Вставить(ДоговорИдКод, ДанныеДоговора);
		Иначе
			// Договір вже є - доповнюємо пусті значення
			Если ПустаяСтрока(ДанныеДоговора.ПодразделениеИдКод) И НЕ ПустаяСтрока(СтрокаТЗ.ПодразделениеИдКод) Тогда
				ДанныеДоговора.ПодразделениеИдКод = СокрЛП(СтрокаТЗ.ПодразделениеИдКод);
			КонецЕсли;
			Если ПустаяСтрока(ДанныеДоговора.НаправлениеИдКод) И НЕ ПустаяСтрока(СтрокаТЗ.НаправлениеИдКод) Тогда
				ДанныеДоговора.НаправлениеИдКод = СокрЛП(СтрокаТЗ.НаправлениеИдКод);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	// 10. Обробка згрупованих даних та запис в ERP
	Для Каждого КлючЗначение Из СоответствиеДоговоров Цикл

		ДоговорИдКод = КлючЗначение.Ключ;
		ДанныеДоговора = КлючЗначение.Значение;

		// 10.1. Пошук договору в ERP по А_ИдКод
		ДоговорЕРП = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("А_ИдКод", ДоговорИдКод);

		Если НЕ ЗначениеЗаполнено(ДоговорЕРП) Тогда
			КоличествоНеНайденных = КоличествоНеНайденных + 1;
			Продолжить;
		КонецЕсли;

		// 10.2. Пошук підрозділу в ERP по А_ИдКод
		ПодразделениеЕРП = Неопределено;
		Если НЕ ПустаяСтрока(ДанныеДоговора.ПодразделениеИдКод) Тогда
			ПодразделениеЕРП = Справочники.СтруктураПредприятия.НайтиПоРеквизиту("А_ИдКод", ДанныеДоговора.ПодразделениеИдКод);
		КонецЕсли;

		// 10.3. Пошук напрямку в ERP по А_ИдКод
		НаправлениеЕРП = Неопределено;
		Если НЕ ПустаяСтрока(ДанныеДоговора.НаправлениеИдКод) Тогда
			НаправлениеЕРП = Справочники.НаправленияДеятельности.НайтиПоРеквизиту("А_ИдКод", ДанныеДоговора.НаправлениеИдКод);
		КонецЕсли;

		// 10.4. Перевірка чи є що оновлювати
		Если НЕ ЗначениеЗаполнено(ПодразделениеЕРП) И НЕ ЗначениеЗаполнено(НаправлениеЕРП) Тогда
			КоличествоПропущенных = КоличествоПропущенных + 1;
			Продолжить;
		КонецЕсли;

		// 10.5. Перевірка чи змінилися значення
		БылиИзменения = Ложь;

		Если ЗначениеЗаполнено(ПодразделениеЕРП) И ДоговорЕРП.А_ПодразделениеБанк <> ПодразделениеЕРП Тогда
			БылиИзменения = Истина;
		КонецЕсли;

		Если ЗначениеЗаполнено(НаправлениеЕРП) И ДоговорЕРП.А_НаправлениеДеятельностиБанк <> НаправлениеЕРП Тогда
			БылиИзменения = Истина;
		КонецЕсли;

		Если НЕ БылиИзменения Тогда
			КоличествоПропущенных = КоличествоПропущенных + 1;
			Продолжить;
		КонецЕсли;

		// 10.6. Запис в договір
		Попытка
			Спр = ДоговорЕРП.ПолучитьОбъект();

			Если ЗначениеЗаполнено(ПодразделениеЕРП) Тогда
				Спр.А_ПодразделениеБанк = ПодразделениеЕРП;
			КонецЕсли;

			Если ЗначениеЗаполнено(НаправлениеЕРП) Тогда
				Спр.А_НаправлениеДеятельностиБанк = НаправлениеЕРП;
			КонецЕсли;

			Спр.ОбменДанными.Загрузка = Истина;
			Спр.Записать();

			КоличествоОбновленных = КоличествоОбновленных + 1;

		Исключение
			Сообщить("Помилка оновлення договору " + ДоговорЕРП + ": " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	// 11. Виведення статистики
	Сообщить("===============================================");
	Сообщить("Оновлено договорів: " + КоличествоОбновленных);
	Если КоличествоПропущенных > 0 Тогда
		Сообщить("Пропущено (без змін або не знайдено підрозділ/напрямок): " + КоличествоПропущенных);
	КонецЕсли;
	Если КоличествоНеНайденных > 0 Тогда
		Сообщить("Договорів не знайдено в ERP: " + КоличествоНеНайденных);
	КонецЕсли;
	Сообщить("Всього оброблено унікальних договорів: " + СоответствиеДоговоров.Количество());

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВДоговорахПодразделениеИзБанка(Команда)
	ЗаполнитьВДоговорахПодразделениеИзБанкаНаСервере();
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьВДоговорахПодразделениеИзБанка1(Команда)
	ЗаполнитьВДоговорахПодразделениеИзБанкаНаСервере();
КонецПроцедуры
  