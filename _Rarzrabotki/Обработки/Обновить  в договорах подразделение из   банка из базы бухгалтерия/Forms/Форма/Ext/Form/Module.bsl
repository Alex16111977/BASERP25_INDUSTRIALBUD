
&НаСервере
Процедура ЗаполнитьВДоговорахПодразделениеИзБанкаНаСервере()
       Запрос = Новый Запрос;    
	   Запрос.УстановитьПараметр("А_ПодразделениеКазна", Справочники.СтруктураПредприятия.ПустаяСсылка()  );
	   Запрос.УстановитьПараметр("А_НаправлениеДеятельностиКазна", Справочники.НаправленияДеятельности.ПустаяСсылка()  );
	   Запрос.УстановитьПараметр("А_Договор", Справочники.ДоговорыКонтрагентов.ПустаяСсылка()  );

	   Запрос.Текст =
	    "ВЫБРАТЬ
	    |	СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.А_Договор КАК А_Договор,
	    |	МАКСИМУМ(СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.А_ПодразделениеКазна) КАК А_ПодразделениеКазна,
	    |	МАКСИМУМ(СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.А_НаправлениеДеятельностиКазна) КАК А_НаправлениеДеятельностиКазна
	    |ИЗ
	    |	Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа
	    |ГДЕ
	    |	СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.Проведен
	    |	И СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.А_ПодразделениеКазна <> &А_ПодразделениеКазна
	    |	И СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.А_НаправлениеДеятельностиКазна <> &А_НаправлениеДеятельностиКазна
	    |	И СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.А_Договор <> &А_Договор
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.А_Договор
	    |
	    |ОБЪЕДИНИТЬ ВСЕ
	    |
	    |ВЫБРАТЬ
	    |	ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.А_Договор,
	    |	МАКСИМУМ(ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.А_ПодразделениеКазна),
	    |	МАКСИМУМ(ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.А_НаправлениеДеятельностиКазна)
	    |ИЗ
	    |	Документ.ПоступлениеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа
	    |ГДЕ
	    |	ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.Проведен
	    |	И ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.А_ПодразделениеКазна <> &А_ПодразделениеКазна
	    |	И ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.А_НаправлениеДеятельностиКазна <> &А_НаправлениеДеятельностиКазна
	    |	И ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.А_Договор <> &А_Договор
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.А_Договор";
	
	 Выборка = Запрос.Выполнить().Выбрать();
	 Пока Выборка.Следующий() Цикл
	 
		Спр = Выборка.А_Договор.ПолучитьОбъект();
		Спр.А_ПодразделениеБанк = Выборка.А_ПодразделениеКазна;
		Спр.А_НаправлениеДеятельностиБанк = Выборка.А_НаправлениеДеятельностиКазна;
		Спр.Записать();
		 
	 
	 КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВДоговорахПодразделениеИзБанка(Команда)
	ЗаполнитьВДоговорахПодразделениеИзБанкаНаСервере();
КонецПроцедуры
