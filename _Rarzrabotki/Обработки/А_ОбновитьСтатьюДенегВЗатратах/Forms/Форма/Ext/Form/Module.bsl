
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) Тогда
		ПоказатьПредупреждение(, "Укажите начало периода для анализа");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.КонецПериода) Тогда
		ПоказатьПредупреждение(, "Укажите конец периода для анализа");
		Возврат;
	КонецЕсли;

	ЗаполнитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	Если Объект.Результаты.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Таблица пуста. Сначала заполните таблицу.");
		Возврат;
	КонецЕсли;

	КоличествоОтмеченных = 0;
	Для Каждого Строка Из Объект.Результаты Цикл
		Если Строка.Записать Тогда
			КоличествоОтмеченных = КоличествоОтмеченных + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоОтмеченных = 0 Тогда
		ПоказатьПредупреждение(, "Нет отмеченных строк для записи.");
		Возврат;
	КонецЕсли;

	КоличествоЗаписанных = ЗаписатьНаСервере();

	ПоказатьПредупреждение(, "Записано статей ДДС в статьи затрат: " + КоличествоЗаписанных);

КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)

	ОчиститьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере()

	Объект.Результаты.Очистить();

	// Структура для накопления статистики: СтатьяЗатрат -> Соответствие[СтатьяДДС -> Количество]
	СтатистикаПоСтатьям = Новый Соответствие;

	// Запрос для получения данных из документов СписаниеБезналичныхДенежныхСредств
	// и связанных заказов поставщику
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СписаниеДС.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
	|	ЗаказПоставщикуТовары.СтатьяРасходов КАК СтатьяЗатрат
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК СписаниеДС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	|		ПО СписаниеДС.ОбъектРасчетов = ЗаказПоставщикуТовары.Ссылка
	|ГДЕ
	|	СписаниеДС.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И СписаниеДС.Ссылка.Проведен = ИСТИНА
	|	И ЗаказПоставщикуТовары.СтатьяРасходов <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка)
	|	И СписаниеДС.СтатьяДвиженияДенежныхСредств <> ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Объект.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Объект.КонецПериода));

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл

		СтатьяЗатрат = Выборка.СтатьяЗатрат;
		СтатьяДДС = Выборка.СтатьяДДС;

		// Получаем или создаем соответствие для статьи затрат
		СтатьиДДСПоЗатрате = СтатистикаПоСтатьям.Получить(СтатьяЗатрат);
		Если СтатьиДДСПоЗатрате = Неопределено Тогда
			СтатьиДДСПоЗатрате = Новый Соответствие;
			СтатистикаПоСтатьям.Вставить(СтатьяЗатрат, СтатьиДДСПоЗатрате);
		КонецЕсли;

		// Увеличиваем счетчик для статьи ДДС
		ТекущееКоличество = СтатьиДДСПоЗатрате.Получить(СтатьяДДС);
		Если ТекущееКоличество = Неопределено Тогда
			ТекущееКоличество = 0;
		КонецЕсли;
		СтатьиДДСПоЗатрате.Вставить(СтатьяДДС, ТекущееКоличество + 1);

	КонецЦикла;

	// Анализируем статистику и заполняем таблицу результатов
	// Добавляем только те статьи затрат, где есть УНИКАЛЬНЫЙ максимум СтатьиДДС
	Для Каждого КлючЗначение Из СтатистикаПоСтатьям Цикл

		СтатьяЗатрат = КлючЗначение.Ключ;
		СтатьиДДСПоЗатрате = КлючЗначение.Значение;

		// Находим максимальное количество и статью ДДС с этим количеством
		МаксКоличество = 0;
		СтатьяДДСМакс = Неопределено;
		КоличествоМаксимумов = 0;

		Для Каждого СтатьяДДСКоличество Из СтатьиДДСПоЗатрате Цикл

			Если СтатьяДДСКоличество.Значение > МаксКоличество Тогда
				МаксКоличество = СтатьяДДСКоличество.Значение;
				СтатьяДДСМакс = СтатьяДДСКоличество.Ключ;
				КоличествоМаксимумов = 1;
			ИначеЕсли СтатьяДДСКоличество.Значение = МаксКоличество Тогда
				КоличествоМаксимумов = КоличествоМаксимумов + 1;
			КонецЕсли;

		КонецЦикла;

		// Добавляем в результаты только если максимум УНИКАЛЬНЫЙ (одна статья ДДС имеет максимум)
		Если КоличествоМаксимумов = 1 И СтатьяДДСМакс <> Неопределено Тогда

			// Получаем текущее значение статьи ДДС в статье затрат
			ТекущаяСтатьяДДС = ПолучитьТекущуюСтатьюДДС(СтатьяЗатрат);

			// Добавляем только если текущая статья ДДС отличается от найденной или пуста
			Если ТекущаяСтатьяДДС <> СтатьяДДСМакс Тогда
				НоваяСтрока = Объект.Результаты.Добавить();
				НоваяСтрока.СтатьяЗатрат = СтатьяЗатрат;
				НоваяСтрока.СтатьяДДС = СтатьяДДСМакс;
				НоваяСтрока.КоличествоСовпадений = МаксКоличество;
				НоваяСтрока.ТекущаяСтатьяДДС = ТекущаяСтатьяДДС;
				НоваяСтрока.Записать = Истина; // По умолчанию отмечаем для записи
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	// Сортируем по количеству совпадений (по убыванию)
	Объект.Результаты.Сортировать("КоличествоСовпадений УБЫВ");

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекущуюСтатьюДДС(СтатьяЗатрат)

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтатьяЗатрат, "А_СтатьяДвиженияДенежныхСредств");

КонецФункции

&НаСервере
Функция ЗаписатьНаСервере()

	КоличествоЗаписанных = 0;

	Для Каждого Строка Из Объект.Результаты Цикл

		Если НЕ Строка.Записать Тогда
			Продолжить;
		КонецЕсли;

		Попытка

			СтатьяЗатратОбъект = Строка.СтатьяЗатрат.ПолучитьОбъект();
			СтатьяЗатратОбъект.А_СтатьяДвиженияДенежныхСредств = Строка.СтатьяДДС;
			СтатьяЗатратОбъект.Записать();

			// Обновляем отображение текущей статьи ДДС
			Строка.ТекущаяСтатьяДДС = Строка.СтатьяДДС;
			Строка.Записать = Ложь; // Снимаем отметку после записи

			КоличествоЗаписанных = КоличествоЗаписанных + 1;

		Исключение

			Сообщить("Ошибка записи статьи затрат """ + Строка.СтатьяЗатрат + """: " + ОписаниеОшибки());

		КонецПопытки;

	КонецЦикла;

	Возврат КоличествоЗаписанных;

КонецФункции

&НаСервере
Процедура ОчиститьНаСервере()

	Объект.Результаты.Очистить();

КонецПроцедуры

#КонецОбласти
