
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДатаНачала = НачалоМесяца(ТекущаяДата()) - 86400 * 120;
	ДатаОкончания = КонецДня(ТекущаяДата());
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПерепровестиВсе(Команда)

	Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Укажите период!");
		Возврат;
	КонецЕсли;

	Документы = ПолучитьДокументыНаСервере();
	ВсегоДокументов = Документы.Количество();

	Если ВсегоДокументов = 0 Тогда
		Сообщить("Документы для обработки не найдены.");
		Возврат;
	КонецЕсли;

	Сообщить("Найдено " + Строка(ВсегоДокументов) + " документов. Начинаю перепроведение...");

	Ошибок = 0;

	Для Индекс = 0 По ВсегоДокументов - 1 Цикл

		ДанныеДокумента = Документы[Индекс];

		Результат = ПерепровестиДокументНаСервере(ДанныеДокумента.Ссылка);

		Если НЕ Результат.Успех Тогда
			Ошибок = Ошибок + 1;
			Сообщить("ОШИБКА: " + Строка(ДанныеДокумента.Ссылка) + " — " + Результат.Сообщение);
		КонецЕсли;

		Обработано = Индекс + 1;
		Осталось   = ВсегоДокументов - Обработано;
		Процент    = Окр(Обработано / ВсегоДокументов * 100, 1);

		Состояние(
			"док: " + Строка(Обработано)
			+ " из " + Строка(ВсегоДокументов)
			+ " (" + Строка(Процент) + "%)"
			+ ", дата: " + Формат(ДанныеДокумента.Дата, "ДФ=dd.MM.yyyy")
			+ ", осталось: " + Строка(Осталось)
			+ ", ошибок: " + Строка(Ошибок)
		);

	КонецЦикла;

	Сообщить("Завершено. Обработано: " + Строка(ВсегоДокументов - Ошибок)
		+ ", ошибок: " + Строка(Ошибок) + " из " + Строка(ВсегоДокументов));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыНаСервере

&НаСервере
Функция ПолучитьДокументыНаСервере()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЗ.Регистратор КАК Ссылка,
	|	ВЗ.Регистратор.Дата КАК Дата
	|ИЗ
	|	РегистрНакопления.РасчетыСПоставщиками КАК ВЗ
	|ГДЕ
	|	ВЗ.Период >= &ДатаНачала
	|	И ВЗ.Период <= &ДатаОкончания
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЗ.Регистратор,
	|	ВЗ.Регистратор.Дата
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентами КАК ВЗ
	|ГДЕ
	|	ВЗ.Период >= &ДатаНачала
	|	И ВЗ.Период <= &ДатаОкончания
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

	Выборка = Запрос.Выполнить().Выбрать();
	МассивДокументов = Новый Массив;

	Пока Выборка.Следующий() Цикл
		МассивДокументов.Добавить(Новый Структура("Ссылка, Дата", Выборка.Ссылка, Выборка.Дата));
	КонецЦикла;

	Возврат МассивДокументов;

КонецФункции

&НаСервере
Функция ПерепровестиДокументНаСервере(СсылкаДок)

	Результат = Новый Структура("Успех, Сообщение", Ложь, "");

	Попытка
		Док = СсылкаДок.ПолучитьОбъект();
		Если Док = Неопределено Тогда
			Результат.Сообщение = "Документ не найден";
			Возврат Результат;
		КонецЕсли;

		НачатьТранзакцию();
		Попытка
			Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Док.Записать(РежимЗаписиДокумента.Проведение);
			ЗафиксироватьТранзакцию();
			Результат.Успех = Истина;
		Исключение
			ОтменитьТранзакцию();
			Результат.Сообщение = ИнформацияОбОшибке().Описание;
		КонецПопытки;
	Исключение
		Результат.Сообщение = ИнформацияОбОшибке().Описание;
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти
