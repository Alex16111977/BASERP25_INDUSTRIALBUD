#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

	// Процедура завантажує залишки ОС з бухгалтерської бази BuhBud
	// через COM-підключення.
	// МОЛ та Підрозділ (Местонахождение) беруться з реєстру МестонахождениеОСБухгалтерскийУчет.
	//
	Процедура ЗагрузитьОстаткиОС() Экспорт

		// 1. Перевірка заповнення дати
		Если НЕ ЗначениеЗаполнено(ДатаОстатков) Тогда
			ВызватьИсключение "Не вказана дата залишків!";
		КонецЕсли;

		// 2. Отримання кодів ЄДРПОУ організацій з флагом А_ВБалансе
		ЗапросОрганизаций = Новый Запрос;
		ЗапросОрганизаций.Текст =
		"ВЫБРАТЬ
		|	Организации.КодПоЕДРПОУ КАК КодПоЕДРПОУ
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.А_ВБалансе = ИСТИНА
		|	И Организации.КодПоЕДРПОУ <> """"";

		масКодПоЕДРПОУ = Новый Массив;
		ВыборкаОрганизаций = ЗапросОрганизаций.Выполнить().Выбрать();
		Пока ВыборкаОрганизаций.Следующий() Цикл
			масКодПоЕДРПОУ.Добавить(ВыборкаОрганизаций.КодПоЕДРПОУ);
		КонецЦикла;

		Если масКодПоЕДРПОУ.Количество() = 0 Тогда
			Сообщить("Немає організацій з флагом А_ВБалансе!");
			Возврат;
		КонецЕсли;

		// 3. COM-підключення до BuhBud
		СтрокаПодключенияБух = "Srvr=""SQLSERVER"";Ref=""BuhBud"";Usr=""cfo"";Pwd=""2442""";

		V8 = Новый COMОбъект("V83.COMConnector");

		Попытка
			V83 = V8.Connect(СокрЛП(СтрокаПодключенияБух));
		Исключение
			ВызватьИсключение "Помилка підключення до бази BuhBud: " + ОписаниеОшибки();
		КонецПопытки;

		// 4. Передача масиву ЄДРПОУ в контекст COM
		масКодПоЕДРПОУ_V83 = V83.NewObject("Массив");
		Для Каждого КодЕДРПОУ Из масКодПоЕДРПОУ Цикл
			масКодПоЕДРПОУ_V83.Добавить(КодЕДРПОУ);
		КонецЦикла;

		// 5. Запит залишків ОС з бухгалтерського регістру
		// Рахунки 10 (ОсновныеСредства) + 1121 (МНМА індивідуально) — первісна вартість (Дт залишок)
		// Рахунки 131 (ИзносОС) + 1321 (ИзносМНМА індивідуально) — накопичена амортизація (Кт залишок)
		// МОЛ та Підрозділ (Местонахождение) — з реєстру МестонахождениеОСБухгалтерскийУчет
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ВЗ.ОСКод КАК ОСКод,
		|	ВЗ.ОСНаименование КАК ОСНаименование,
		|	ВЗ.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ВЗ.СчетУчетаОС КАК СчетУчетаОС,
		|	ВЗ.ПервоначальнаяСтоимость КАК ПервоначальнаяСтоимость,
		|	ЕСТЬNULL(Аморт.НакопленнаяАмортизация, 0) КАК НакопленнаяАмортизация,
		|	ВЗ.ПервоначальнаяСтоимость - ЕСТЬNULL(Аморт.НакопленнаяАмортизация, 0) КАК ТекущаяСтоимость,
		|	ВЗ.СрокИспользования КАК СрокИспользования,
		|	ВЗ.ОрганизацияКодПоЕДРПОУ КАК ОрганизацияКодПоЕДРПОУ,
		|	ВЗ.МОЛ_ИдКод КАК МОЛ_ИдКод,
		|	ВЗ.СчетАмортизацииКод КАК СчетАмортизацииКод,
		|	ВЗ.НалоговаяГруппаОСНаим КАК НалоговаяГруппаОСНаим,
		|	ВЗ.Подразделение_Наим КАК Подразделение_Наим,
		|	ВЗ.ОС_А_ИдКод КАК ОС_А_ИдКод
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВЫРАЗИТЬ(ОстаткиОС.Субконто1 КАК Справочник.ОсновныеСредства).Код КАК ОСКод,
		|		ВЫРАЗИТЬ(ОстаткиОС.Субконто1 КАК Справочник.ОсновныеСредства).Наименование КАК ОСНаименование,
		|		ПервоначСведения.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|		ПараметрыАморт.СрокПолезногоИспользования КАК СрокИспользования,
		|		СчетаУчетаОС.СчетНачисленияАмортизации.Код КАК СчетАмортизацииКод,
		|		ПервоначСведенияНУ.НалоговаяГруппаОС.Наименование КАК НалоговаяГруппаОСНаим,
		|		МестонахождениеОС.МОЛ.КодПоДРФО КАК МОЛ_ИдКод,
		|		МестонахождениеОС.Местонахождение.Наименование КАК Подразделение_Наим,
		|		ОстаткиОС.Счет.Код КАК СчетУчетаОС,
		|		СУММА(ОстаткиОС.СуммаОстатокДт) КАК ПервоначальнаяСтоимость,
		|		ОстаткиОС.Организация.КодПоЕДРПОУ КАК ОрганизацияКодПоЕДРПОУ,
		|		ВЫРАЗИТЬ(ОстаткиОС.Субконто1 КАК Справочник.ОсновныеСредства).А_ИдКод КАК ОС_А_ИдКод
		|	ИЗ
		|		РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			&Дата,
		|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОсновныеСредства))
		|				ИЛИ Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.МалоценныеНеоборотныеМатериальныеАктивыИндивидуально),
		|			,
		|		) КАК ОстаткиОС
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестонахождениеОСБухгалтерскийУчет.СрезПоследних(
		|			&Дата,
		|		) КАК МестонахождениеОС
		|		ПО ВЫРАЗИТЬ(ОстаткиОС.Субконто1 КАК Справочник.ОсновныеСредства) = МестонахождениеОС.ОсновноеСредство
		|			И ОстаткиОС.Организация = МестонахождениеОС.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних(
		|			&Дата,
		|		) КАК ПервоначСведения
		|		ПО ВЫРАЗИТЬ(ОстаткиОС.Субконто1 КАК Справочник.ОсновныеСредства) = ПервоначСведения.ОсновноеСредство
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(
		|			&Дата,
		|		) КАК ПараметрыАморт
		|		ПО ВЫРАЗИТЬ(ОстаткиОС.Субконто1 КАК Справочник.ОсновныеСредства) = ПараметрыАморт.ОсновноеСредство
		|			И ОстаткиОС.Организация = ПараметрыАморт.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СчетаБухгалтерскогоУчетаОС.СрезПоследних(
		|			&Дата,
		|		) КАК СчетаУчетаОС
		|		ПО ВЫРАЗИТЬ(ОстаткиОС.Субконто1 КАК Справочник.ОсновныеСредства) = СчетаУчетаОС.ОсновноеСредство
		|			И ОстаткиОС.Организация = СчетаУчетаОС.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПервоначальныеСведенияОСНалоговыйУчет.СрезПоследних(
		|			&Дата,
		|		) КАК ПервоначСведенияНУ
		|		ПО ВЫРАЗИТЬ(ОстаткиОС.Субконто1 КАК Справочник.ОсновныеСредства) = ПервоначСведенияНУ.ОсновноеСредство
		|	ГДЕ
		|		ОстаткиОС.Организация.КодПоЕДРПОУ В(&масКодПоЕДРПОУ)
		|		И ОстаткиОС.СуммаОстатокДт > 0
		|	СГРУППИРОВАТЬ ПО
		|		ВЫРАЗИТЬ(ОстаткиОС.Субконто1 КАК Справочник.ОсновныеСредства).Код,
		|		ВЫРАЗИТЬ(ОстаткиОС.Субконто1 КАК Справочник.ОсновныеСредства).Наименование,
		|		ПервоначСведения.ИнвентарныйНомер,
		|		ПараметрыАморт.СрокПолезногоИспользования,
		|		СчетаУчетаОС.СчетНачисленияАмортизации.Код,
		|		ПервоначСведенияНУ.НалоговаяГруппаОС.Наименование,
		|		МестонахождениеОС.МОЛ.КодПоДРФО,
		|		МестонахождениеОС.Местонахождение.Наименование,
		|		ОстаткиОС.Счет.Код,
		|		ОстаткиОС.Организация.КодПоЕДРПОУ,
		|		ВЫРАЗИТЬ(ОстаткиОС.Субконто1 КАК Справочник.ОсновныеСредства).А_ИдКод) КАК ВЗ
		|	ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|		ВЫРАЗИТЬ(ОстаткиАморт.Субконто1 КАК Справочник.ОсновныеСредства).Код КАК ОСКод,
		|		СУММА(ОстаткиАморт.СуммаОстатокКт) КАК НакопленнаяАмортизация,
		|		ОстаткиАморт.Организация.КодПоЕДРПОУ КАК ОрганизацияКодПоЕДРПОУ
		|	ИЗ
		|		РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			&Дата,
		|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ИзносОсновныхСредств))
		|				ИЛИ Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ИзносДругихНеоборотныхМатериальныхАктивовИндивидуально),
		|			,
		|		) КАК ОстаткиАморт
		|	ГДЕ
		|		ОстаткиАморт.Организация.КодПоЕДРПОУ В(&масКодПоЕДРПОУ)
		|		И ОстаткиАморт.СуммаОстатокКт > 0
		|	СГРУППИРОВАТЬ ПО
		|		ВЫРАЗИТЬ(ОстаткиАморт.Субконто1 КАК Справочник.ОсновныеСредства).Код,
		|		ОстаткиАморт.Организация.КодПоЕДРПОУ) КАК Аморт
		|	ПО ВЗ.ОСКод = Аморт.ОСКод
		|		И ВЗ.ОрганизацияКодПоЕДРПОУ = Аморт.ОрганизацияКодПоЕДРПОУ";

		// 6. Виконання запиту
		Попытка
			Запрос = V83.NewObject("Запрос");
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("Дата", КонецДня(ДатаОстатков));
			Запрос.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);

			РезультатЗапроса = Запрос.Выполнить();
			ТЗОстатки = РезультатЗапроса.Выгрузить();
		Исключение
			V83 = Неопределено;
			V8 = Неопределено;
			ВызватьИсключение "Помилка виконання запиту в базі BuhBud: " + ОписаниеОшибки();
		КонецПопытки;

		// 7. Серіалізація для передачі через COM
		Попытка
			стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗОстатки);
		Исключение
			V83 = Неопределено;
			V8 = Неопределено;
			ВызватьИсключение "Помилка серіалізації даних: " + ОписаниеОшибки();
		КонецПопытки;

		// 8. Закриття COM-з'єднання
		V83 = Неопределено;
		V8 = Неопределено;

		// 9. Десеріалізація в поточній базі
		ТаблицаОстатков = ЗначениеИзСтрокиВнутр(стр_ТЗ);

		// 10. Очистка табличної частини
		ОС.Очистить();

		// 10.1. Підготовка запиту для пошуку А_ПодразделенияОрганизаций по наименуванню + ЄДРПОУ
		// Шукаємо по ЄДРПОУ з рядка (не з шапки), бо ОС можуть належати різним організаціям
		ЗапросПодрОрг = Новый Запрос;
		ЗапросПодрОрг.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	П.Ссылка КАК Ссылка,
		|	П.Подразделение КАК Подразделение
		|ИЗ
		|	Справочник.А_ПодразделенияОрганизаций КАК П
		|ГДЕ
		|	П.Наименование = &Наименование
		|	И П.Организация.КодПоЕДРПОУ = &КодПоЕДРПОУ
		|	И НЕ П.ПометкаУдаления";

		// 11. Заповнення табличної частини
		СчетчикЗагружено = 0;
		СчетчикНеНайденоПодр = 0;

		Для Каждого СтрокаТЗ Из ТаблицаОстатков Цикл

			НоваяСтрока = ОС.Добавить();
			НоваяСтрока.ОСКод = СокрЛП(СтрокаТЗ.ОСКод);
			НоваяСтрока.ОСНаименование = СокрЛП(СтрокаТЗ.ОСНаименование);
			НоваяСтрока.ИнвентарныйНомер = СокрЛП(СтрокаТЗ.ИнвентарныйНомер);
			НоваяСтрока.СчетУчетаОС = СокрЛП(СтрокаТЗ.СчетУчетаОС);
			НоваяСтрока.ПервоначальнаяСтоимость = СтрокаТЗ.ПервоначальнаяСтоимость;
			НоваяСтрока.НакопленнаяАмортизация = СтрокаТЗ.НакопленнаяАмортизация;
			НоваяСтрока.ТекущаяСтоимость = СтрокаТЗ.ТекущаяСтоимость;
			НоваяСтрока.СрокИспользования = СтрокаТЗ.СрокИспользования;
			НоваяСтрока.ОрганизацияКодПоЕДРПОУ = СокрЛП(СтрокаТЗ.ОрганизацияКодПоЕДРПОУ);
			НоваяСтрока.МОЛ_ИдКод = СокрЛП(СтрокаТЗ.МОЛ_ИдКод);
			НоваяСтрока.Подразделение_Наим = СокрЛП(СтрокаТЗ.Подразделение_Наим);
			НоваяСтрока.СчетАмортизацииКод = СокрЛП(СтрокаТЗ.СчетАмортизацииКод);
			НоваяСтрока.НалоговаяГруппаОСНаим = СокрЛП(СтрокаТЗ.НалоговаяГруппаОСНаим);
			НоваяСтрока.ОС_А_ИдКод = СокрЛП(СтрокаТЗ.ОС_А_ИдКод);

			// 11.1. Пошук А_ПодразделенияОрганизаций в ERP по наименуванню + ЄДРПОУ з BuhBud
			Если НЕ ПустаяСтрока(СокрЛП(СтрокаТЗ.Подразделение_Наим)) И НЕ ПустаяСтрока(СокрЛП(СтрокаТЗ.ОрганизацияКодПоЕДРПОУ)) Тогда
				ЗапросПодрОрг.УстановитьПараметр("Наименование", СокрЛП(СтрокаТЗ.Подразделение_Наим));
				ЗапросПодрОрг.УстановитьПараметр("КодПоЕДРПОУ", СокрЛП(СтрокаТЗ.ОрганизацияКодПоЕДРПОУ));
				РезПодрОрг = ЗапросПодрОрг.Выполнить();
				Если НЕ РезПодрОрг.Пустой() Тогда
					ВыборкаПодрОрг = РезПодрОрг.Выбрать();
					ВыборкаПодрОрг.Следующий();
					НоваяСтрока.ПодразделенияОрганизаций = ВыборкаПодрОрг.Ссылка;
					Если ЗначениеЗаполнено(ВыборкаПодрОрг.Подразделение) Тогда
						НоваяСтрока.Подразделение = ВыборкаПодрОрг.Подразделение;
					КонецЕсли;
				Иначе
					СчетчикНеНайденоПодр = СчетчикНеНайденоПодр + 1;
					Сообщить("А_ПодразделенияОрганизаций не знайдено в ERP: """ + СокрЛП(СтрокаТЗ.Подразделение_Наим) + """");
				КонецЕсли;
			КонецЕсли;
			
			Если СокрЛП(НоваяСтрока.СчетУчетаОС)="1091"
				или СокрЛП(НоваяСтрока.СчетУчетаОС)="1092" Тогда
			 НоваяСтрока.СчетУчетаОС="109";
		 КонецЕсли;  
		 
		 
		 Если ЗначениеЗаполнено(НоваяСтрока.ПодразделенияОрганизаций) Тогда
						НоваяСтрока.Подразделение = НоваяСтрока.ПодразделенияОрганизаций.Подразделение;
					КонецЕсли;

			НоваяСтрока.Организация = Справочники.Организации.НайтиПоРеквизиту("КодПоЕДРПОУ",СокрЛП(НоваяСтрока.ОрганизацияКодПоЕДРПОУ));		
			
					
			
			СчетчикЗагружено = СчетчикЗагружено + 1;

		КонецЦикла;

		Сообщить("Завантажено ОС: " + СчетчикЗагружено + " позицій");
		Если СчетчикНеНайденоПодр > 0 Тогда
			Сообщить("Не знайдено підрозділів в ERP: " + СчетчикНеНайденоПодр);
		КонецЕсли;

	КонецПроцедуры

	// Процедура створює документи "ВводОстатковВнеоборотныхАктивов" в ERP.
	// Для кожного Підрозділу — окремий документ (аналогічно переносу залишків номенклатури по складах).
	//
	Процедура СоздатьДокументВводаОстатковОС() Экспорт

		// 1. Перевірки
		Если НЕ ЗначениеЗаполнено(Организация) Тогда
			ВызватьИсключение "Не обрана організація!";
		КонецЕсли;

		Если ОС.Количество() = 0 Тогда
			ВызватьИсключение "Таблична частина ОС порожня! Спочатку завантажте залишки.";
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(ДатаОстатков) Тогда
			ВызватьИсключение "Не вказана дата залишків!";
		КонецЕсли;

		// 2. Дата документа
		ДатаДокумента = КонецДня(ДатаОстатков);

		// 3. Групування по підрозділах (А_ПодразделенияОрганизаций)
		ОСТаблица = ОС.Выгрузить();
		ПодразделенияТаблица = ОСТаблица.Скопировать(, "Подразделение_Наим, ПодразделенияОрганизаций, Подразделение");
		ПодразделенияТаблица.Свернуть("Подразделение_Наим, ПодразделенияОрганизаций, Подразделение");

		// 4. Загальні значення для всіх документів
		НалоговоеНазначение = Справочники.НалоговыеНазначенияАктивовИЗатрат.НДС_Облагаемая;
		МетодАмортизации = Перечисления.СпособыНачисленияАмортизацииОС.Линейный;
		НаправлениеДеятельности = Справочники.НаправленияДеятельности.НайтиПоНаименованию("Основний", Истина);
		СтатьяРасходовАмортизации = ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоКоду("0Ц-000038");  //Амортизація ОЗ
		СчетДооценокОСЕРП = ПланыСчетов.Хозрасчетный.НайтиПоКоду("411");

		СчетчикДокументов = 0;
		ОбщийСчетчикСтрок = 0;
		ОбщийСчетчикОшибок = 0;

		// 5. Цикл по підрозділах — для кожного свій документ
		Для Каждого СтрокаПодразделения Из ПодразделенияТаблица Цикл

			ПодразделениеНаим = СтрокаПодразделения.Подразделение_Наим;
			ПодрОрг = СтрокаПодразделения.ПодразделенияОрганизаций;    // А_ПодразделенияОрганизаций
			ПодразделениеЕРП = СтрокаПодразделения.Подразделение;       // СтруктураПредприятия

			// 5.2. Перевірка наявності існуючого документа (Організація + А_ПодразделениеБух + Дата)
			ЗапросПроверки = Новый Запрос;
			Если ЗначениеЗаполнено(ПодрОрг) Тогда
				ЗапросПроверки.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Док.Ссылка КАК Ссылка
				|ИЗ
				|	Документ.ВводОстатковВнеоборотныхАктивов КАК Док
				|ГДЕ
				|	Док.Организация = &Организация
				|	И Док.А_ПодразделениеБух = &ПодрОрг
				|	И Док.Дата = &Дата";
				ЗапросПроверки.УстановитьПараметр("ПодрОрг", ПодрОрг);
			Иначе
				ЗапросПроверки.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Док.Ссылка КАК Ссылка
				|ИЗ
				|	Документ.ВводОстатковВнеоборотныхАктивов КАК Док
				|ГДЕ
				|	Док.Организация = &Организация
				|	И Док.А_ПодразделениеБух = ЗНАЧЕНИЕ(Справочник.А_ПодразделенияОрганизаций.ПустаяСсылка)
				|	И Док.Дата = &Дата";
			КонецЕсли;

			ЗапросПроверки.УстановитьПараметр("Организация", Организация);
			ЗапросПроверки.УстановитьПараметр("Дата", ДатаДокумента);

			РезультатПроверки = ЗапросПроверки.Выполнить();

			ЭтоОбновление = Ложь;

			Если НЕ РезультатПроверки.Пустой() Тогда
				ВыборкаПроверки = РезультатПроверки.Выбрать();
				ВыборкаПроверки.Следующий();
				ДокументОбъект = ВыборкаПроверки.Ссылка.ПолучитьОбъект();
				ДокументОбъект.ОС.Очистить();
				ДокументОбъект.Комментарий = "Оновлено обробкою переносу залишків ОС " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
				ЭтоОбновление = Истина;
			Иначе
				ДокументОбъект = Документы.ВводОстатковВнеоборотныхАктивов.СоздатьДокумент();
				ДокументОбъект.Комментарий = "Створено обробкою переносу залишків ОС " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
			КонецЕсли;

			// 5.3. Заповнення шапки документа
			ДокументОбъект.Дата = ДатаДокумента;
			ДокументОбъект.Организация = Организация;
			ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВводОстатковОсновныхСредств;

			// А_ПодразделениеБух — підрозділ з бухгалтерської бази
			Если ЗначениеЗаполнено(ПодрОрг) Тогда
				ДокументОбъект.А_ПодразделениеБух = ПодрОрг;
			КонецЕсли;

			// Подразделение (СтруктураПредприятия) — зв'язка з А_ПодразделенияОрганизаций.Подразделение
			Если ЗначениеЗаполнено(ПодразделениеЕРП) Тогда
				ДокументОбъект.Подразделение = ПодразделениеЕРП;
			КонецЕсли;

			// 5.4. Фільтрація рядків для поточного підрозділу
			Если ЗначениеЗаполнено(ПодрОрг) Тогда
				СтрокиПодразделения = ОСТаблица.НайтиСтроки(Новый Структура("ПодразделенияОрганизаций", ПодрОрг));
			Иначе
				СтрокиПодразделения = ОСТаблица.НайтиСтроки(Новый Структура("Подразделение_Наим", ПодразделениеНаим));
			КонецЕсли;

			// 5.5. Заповнення ТЧ "ОС"
			СчетчикСтрок = 0;
			СчетчикОшибок = 0;

			Для Каждого СтрокаОС Из СтрокиПодразделения Цикл

				// Пошук ОбъектЭксплуатации в ERP по А_ИдКод (маппінг BuhBud ОсновныеСредства.А_ИдКод = ERP ОбъектыЭксплуатации.А_ИдКод)
				ОбъектЭксплуатацииЕРП = Неопределено;

				Если НЕ ПустаяСтрока(СокрЛП(СтрокаОС.ОС_А_ИдКод)) Тогда
					ОбъектЭксплуатацииЕРП = Справочники.ОбъектыЭксплуатации.НайтиПоРеквизиту(
						"А_ИдКод", СокрЛП(СтрокаОС.ОС_А_ИдКод));
				КонецЕсли;

				Если НЕ ЗначениеЗаполнено(ОбъектЭксплуатацииЕРП) Тогда
					СчетчикОшибок = СчетчикОшибок + 1;
					ОбщийСчетчикОшибок = ОбщийСчетчикОшибок + 1;
					Сообщить("НЕ ЗНАЙДЕНО ОС в ERP: " + СокрЛП(СтрокаОС.ОСНаименование)
						+ " (код: " + СокрЛП(СтрокаОС.ОСКод)
						+ ", А_ИдКод: " + СокрЛП(СтрокаОС.ОС_А_ИдКод)
						+ ", інв.№: " + СокрЛП(СтрокаОС.ИнвентарныйНомер) + ")");
					Продолжить;
				КонецЕсли;

				// Рахунок обліку ОС
				СчетУчетаЕРП = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СокрЛП(СтрокаОС.СчетУчетаОС));
				// Рахунок амортизації — з BuhBud (СчетаБухгалтерскогоУчетаОС) або 131 за замовчуванням
				Если НЕ ПустаяСтрока(СокрЛП(СтрокаОС.СчетАмортизацииКод)) Тогда
					СчетАмортизацииЕРП = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СокрЛП(СтрокаОС.СчетАмортизацииКод));
				Иначе
					СчетАмортизацииЕРП = ПланыСчетов.Хозрасчетный.НайтиПоКоду("131");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ОбъектЭксплуатацииЕРП) Тогда
					
					СпрОС = ОбъектЭксплуатацииЕРП.ПолучитьОбъект();
					СпрОС.А_ОрганизацияБухгалтерия = СтрокаОС.Организация;
					СпрОС.А_СчетУчетаБух = СчетУчетаЕРП; 
					СпрОС.Записать();
					
				КонецЕсли; 
			
				// Додавання рядка в ТЧ "ОС" документа
				НоваяСтрокаДок = ДокументОбъект.ОС.Добавить();

				НоваяСтрокаДок.ОсновноеСредство = ОбъектЭксплуатацииЕРП;
				НоваяСтрокаДок.ПервоначальнаяСтоимостьБУ = СтрокаОС.ПервоначальнаяСтоимость;
				НоваяСтрокаДок.НакопленнаяАмортизацияБУ = СтрокаОС.ПервоначальнаяСтоимость;
				НоваяСтрокаДок.ТекущаяСтоимостьБУ = СтрокаОС.ПервоначальнаяСтоимость;
				НоваяСтрокаДок.СчетУчета = СчетУчетаЕРП;
				НоваяСтрокаДок.СчетАмортизации = СчетАмортизацииЕРП;
				НоваяСтрокаДок.МетодНачисленияАмортизацииБУ = Перечисления.СпособыНачисленияАмортизацииОС.Линейный;
				// Для рахунку 1121 (МНМА) — примусово метод амортизації 100%
				Если СокрЛП(СтрокаОС.СчетУчетаОС) = "1121" Тогда
					НоваяСтрокаДок.МетодНачисленияАмортизацииБУ = Перечисления.СпособыНачисленияАмортизацииОС._100;
				КонецЕсли;
				НоваяСтрокаДок.СрокИспользованияБУ=1;
				НоваяСтрокаДок.НалоговоеНазначение = НалоговоеНазначение;
				//НоваяСтрокаДок.СпособНачисленияАмортизацииНУ = МетодАмортизации;
				НоваяСтрокаДок.НачислятьАмортизациюБУ = Истина;
				НоваяСтрокаДок.СпособНачисленияАмортизацииНУ = НоваяСтрокаДок.МетодНачисленияАмортизацииБУ; 
				НоваяСтрокаДок.СрокИспользованияНУ=НоваяСтрокаДок.СрокИспользованияБУ;

				Если ЗначениеЗаполнено(СчетДооценокОСЕРП) Тогда
					НоваяСтрокаДок.СчетУчетаДооценокОС = СчетДооценокОСЕРП;
				КонецЕсли;

				// НалоговаяГруппаОС — пошук за найменуванням з BuhBud (ПервоначальныеСведенияОСНалоговыйУчет)
				Если НЕ ПустаяСтрока(СокрЛП(СтрокаОС.НалоговаяГруппаОСНаим)) Тогда
					НалГруппаОС = Справочники.НалоговыеГруппыОсновныхСредств.НайтиПоНаименованию(
						СокрЛП(СтрокаОС.НалоговаяГруппаОСНаим), Истина);
					Если ЗначениеЗаполнено(НалГруппаОС) Тогда
						НоваяСтрокаДок.НалоговаяГруппаОС = НалГруппаОС;
					КонецЕсли;
				КонецЕсли;

				НоваяСтрокаДок.ИнвентарныйНомер = СокрЛП(СтрокаОС.ИнвентарныйНомер);

				// Строк корисного використання (міс.)
				//Если СтрокаОС.СрокИспользования > 0 Тогда
				//	НоваяСтрокаДок.СрокИспользованияБУ = СтрокаОС.СрокИспользования;
				//Иначе
				//	НоваяСтрокаДок.СрокИспользованияБУ = 60;
				//КонецЕсли;

				// Дата прийняття до обліку
				НоваяСтрокаДок.ДатаПринятияКУчету = ДатаДокумента;

				// Напрям діяльності
				Если ЗначениеЗаполнено(НаправлениеДеятельности) Тогда
					НоваяСтрокаДок.НаправлениеДеятельности = НаправлениеДеятельности;
				КонецЕсли;

				// Стаття витрат амортизації
				Если ЗначениеЗаполнено(СтатьяРасходовАмортизации) Тогда
					НоваяСтрокаДок.СтатьяРасходовАмортизации = СтатьяРасходовАмортизации;
				КонецЕсли;

				// МОЛ — пошук ФізичноїОсоби в ERP по КодПоДРФО
				Если НЕ ПустаяСтрока(СокрЛП(СтрокаОС.МОЛ_ИдКод)) Тогда
					ФизЛицоМОЛ = Справочники.ФизическиеЛица.НайтиПоРеквизиту("КодПоДРФО", СокрЛП(СтрокаОС.МОЛ_ИдКод));
					Если ЗначениеЗаполнено(ФизЛицоМОЛ) Тогда
						НоваяСтрокаДок.МОЛ = ФизЛицоМОЛ;
					Иначе
						Сообщить("МОЛ не знайдено в ERP для ОС: " + СокрЛП(СтрокаОС.ОСНаименование)
							+ " (КодПоДРФО: " + СокрЛП(СтрокаОС.МОЛ_ИдКод) + ")");
					КонецЕсли;
				КонецЕсли;

				СчетчикСтрок = СчетчикСтрок + 1;
				ОбщийСчетчикСтрок = ОбщийСчетчикСтрок + 1;

			КонецЦикла;

			// 5.6. Запис документа БЕЗ проведення
			Если СчетчикСтрок > 0 Тогда
				Попытка
					ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
					СчетчикДокументов = СчетчикДокументов + 1;

					ПодрНаим = ?(ПустаяСтрока(СокрЛП(ПодразделениеНаим)), "<без підрозділу>", СокрЛП(ПодразделениеНаим));
					ИнфоПодр = ?(ЗначениеЗаполнено(ПодрОрг), " | А_ПідрБух: " + Строка(ПодрОрг), "");

					Если ЭтоОбновление Тогда
						Сообщить("Оновлено документ [" + ПодрНаим + ИнфоПодр + "]: " + ДокументОбъект.Ссылка + " (рядків ОС: " + СчетчикСтрок + ")");
					Иначе
						Сообщить("Створено документ [" + ПодрНаим + ИнфоПодр + "]: " + ДокументОбъект.Ссылка + " (рядків ОС: " + СчетчикСтрок + ")");
					КонецЕсли;
				Исключение    
					ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);

					Сообщить("ПОМИЛКА запису документа [" + СокрЛП(ПодразделениеНаим) + "]: " + ОписаниеОшибки());
				КонецПопытки;
			Иначе
				Сообщить("Підрозділ """ + СокрЛП(ПодразделениеНаим) + """ — жоден ОС не знайдено в ERP, документ не створено.");
			КонецЕсли;

		КонецЦикла;

		// 6. Підсумок
		Сообщить("===============================================");
		Сообщить("Створено/оновлено документів: " + СчетчикДокументов);
		Сообщить("Оброблено рядків ОС: " + ОбщийСчетчикСтрок);
		Если ОбщийСчетчикОшибок > 0 Тогда
			Сообщить("Не знайдено в ERP: " + ОбщийСчетчикОшибок);
		КонецЕсли;

	КонецПроцедуры

#КонецЕсли
