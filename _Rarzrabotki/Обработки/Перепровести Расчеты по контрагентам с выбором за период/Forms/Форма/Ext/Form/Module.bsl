
&НаСервере
Функция ПолучитьСписокДокументовНаСервере()

	// Первичные документы, писавшие в регистры расчётов за период по выбранным
	// контрагентам. Операционные регистры (РасчетыСКлиентами/РасчетыСПоставщиками)
	// дают первичник через .Регистратор; регистры "ПоСрокам" — через .ДокументРегистратор
	// (их .Регистратор — служебный РегистраторРасчётов, перепроводить его нельзя).
	// Пустая ТЧ контрагентов = перепровести по всем контрагентам за период.
	МассивКонтрагентов = Объект.ТабличнаяЧастьКонтрагенты.Выгрузить().ВыгрузитьКолонку("Партнер");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Регистратор КАК Регистратор,
	|	МИНИМУМ(ВложенныйЗапрос.Дата) КАК Дата
	|ИЗ
	|	(ВЫБРАТЬ
	|		Рег.Регистратор КАК Регистратор,
	|		МИНИМУМ(Рег.Регистратор.Дата) КАК Дата
	|	ИЗ
	|		РегистрНакопления.РасчетыСКлиентами КАК Рег
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК АП
	|			ПО Рег.АналитикаУчетаПоПартнерам = АП.КлючАналитики
	|	ГДЕ
	|		Рег.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	|		И (НЕ &ФильтроватьПоКонтрагентам
	|				ИЛИ АП.Партнер В ИЕРАРХИИ (&масКонтрагент))
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Рег.Регистратор
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Рег.Регистратор,
	|		МИНИМУМ(Рег.Регистратор.Дата)
	|	ИЗ
	|		РегистрНакопления.РасчетыСПоставщиками КАК Рег
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК АП
	|			ПО Рег.АналитикаУчетаПоПартнерам = АП.КлючАналитики
	|	ГДЕ
	|		Рег.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	|		И (НЕ &ФильтроватьПоКонтрагентам
	|				ИЛИ АП.Партнер В ИЕРАРХИИ (&масКонтрагент))
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Рег.Регистратор
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Рег.ДокументРегистратор,
	|		МИНИМУМ(Рег.ДокументРегистратор.Дата)
	|	ИЗ
	|		РегистрНакопления.РасчетыСКлиентамиПоСрокам КАК Рег
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК АП
	|			ПО Рег.АналитикаУчетаПоПартнерам = АП.КлючАналитики
	|	ГДЕ
	|		Рег.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	|		И (НЕ &ФильтроватьПоКонтрагентам
	|				ИЛИ АП.Партнер В ИЕРАРХИИ (&масКонтрагент))
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Рег.ДокументРегистратор
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Рег.ДокументРегистратор,
	|		МИНИМУМ(Рег.ДокументРегистратор.Дата)
	|	ИЗ
	|		РегистрНакопления.РасчетыСПоставщикамиПоСрокам КАК Рег
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК АП
	|			ПО Рег.АналитикаУчетаПоПартнерам = АП.КлючАналитики
	|	ГДЕ
	|		Рег.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	|		И (НЕ &ФильтроватьПоКонтрагентам
	|				ИЛИ АП.Партнер В ИЕРАРХИИ (&масКонтрагент))
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Рег.ДокументРегистратор) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Регистратор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

	Запрос.УстановитьПараметр("НачалоПериода", Объект.НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(Объект.ОкончаниеПериода));
	Запрос.УстановитьПараметр("ФильтроватьПоКонтрагентам", МассивКонтрагентов.Количество() > 0);
	Запрос.УстановитьПараметр("масКонтрагент", МассивКонтрагентов);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Регистратор) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Регистратор, Дата", Выборка.Регистратор, Выборка.Дата));
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПерепровестиДокументНаСервере(СсылкаНаДокумент)

	Попытка
		Док = СсылкаНаДокумент.ПолучитьОбъект();
		Если Док = Неопределено Тогда
			Возврат "Битая ссылка / документ удалён";
		КонецЕсли;
		НачатьТранзакцию();
		// Одиночная запись режимом Проведение атомарно перепроводит документ и
		// триггерит подписки событий, включая создание РегистраторРасчётов
		// (защита от обнуления РСКПС/РСППС в новой архитектуре взаиморасчётов).
		Док.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
		Возврат "";
	Исключение
		ОтменитьТранзакцию();
		Возврат ОписаниеОшибки();
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ПерепровестиДокументыПоРасчетам(Команда)

	МассивДокументов = ПолучитьСписокДокументовНаСервере();
	ВсегоДокументов = МассивДокументов.Количество();

	Если ВсегоДокументов = 0 Тогда
		ПоказатьПредупреждение(, "Не найдено документов по расчётам с контрагентами за указанный период.");
		Возврат;
	КонецЕсли;

	КоличествоУспешных = 0;
	КоличествоОшибок = 0;

	Для НомерТекущего = 0 По ВсегоДокументов - 1 Цикл

		ДанныеДокумента = МассивДокументов[НомерТекущего];
		Процент = Окр((НомерТекущего + 1) / ВсегоДокументов * 100, 0);

		Состояние(
			"П: " + (НомерТекущего + 1) + " из " + ВсегоДокументов
				+ " (" + Процент + "%)"
				+ " | Ок: " + КоличествоУспешных + ", Ошибок: " + КоличествоОшибок,
			Процент,
			"Дата: " + Формат(ДанныеДокумента.Дата, "ДЛФ=D"));

		ОбработкаПрерыванияПользователя();

		ОписаниеОш = ПерепровестиДокументНаСервере(ДанныеДокумента.Регистратор);

		Если ОписаниеОш = "" Тогда
			КоличествоУспешных = КоличествоУспешных + 1;
		Иначе
			КоличествоОшибок = КоличествоОшибок + 1;
			Сообщить("Ошибка: " + Строка(ДанныеДокумента.Регистратор) + " — " + ОписаниеОш);
		КонецЕсли;

	КонецЦикла;

	ПоказатьПредупреждение(, "Перепроведение завершено. Успешно: " + КоличествоУспешных
		+ ", ошибок: " + КоличествоОшибок
		+ ", всего: " + ВсегоДокументов);

КонецПроцедуры
