#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Карта счёта -> Структура{СтатьяПАП (ПВХ.СтатьиАктивовПассивов); ЕстьСубконтоКонтрагент (Булево)}.
// 6853 «Расчёты по исполнительным документам» — ПАССИВ -> статья ПрочиеПассивы + субконто Контрагент-взыскатель.
// 378  «Расчёты с госцелевыми фондами»        — ПАССИВ -> статья ЦелевоеФинансирование, без субконто.
// Обе статьи АктивПассив=Пассив -> знак ПАП ?(Сальдо>0, Расход, Приход) (подтверждено pretest'ом).
// Статья ПрочиеПассивы — ПРЕДОПРЕДЕЛЁННЫЙ ЭЛЕМЕНТ (НЕ группа, НЕ НайтиПоНаименованию — есть тёзка-группа).
Функция _СтатьяИСубконтоПоСчету(КодСчета)
	Код = СокрЛП(КодСчета);
	Рез = Новый Структура("СтатьяПАП, ЕстьСубконтоКонтрагент", Неопределено, Ложь);
	Если Код = "6853" Тогда
		Рез.СтатьяПАП = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ПрочиеПассивы;
		Рез.ЕстьСубконтоКонтрагент = Истина;
	ИначеЕсли Код = "378" Тогда
		Рез.СтатьяПАП = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ЦелевоеФинансирование;
	КонецЕсли;
	Возврат Рез;
КонецФункции

// Маппинг контрагента-взыскателя BuhBud->ERP: КодПоЕДРПОУ -> А_ИдКод -> Наименование (точное).
// (pretest: ЕДРПОУ покрывает ВДВС и ФОП-виконавців 3/3.) Не найден -> ПустаяСсылка (строка без субконто).
Функция _НайтиКонтрагента(КодЕДРПОУ, Наим)
	Если НЕ ПустаяСтрока(КодЕДРПОУ) Тогда
		К = Справочники.Контрагенты.НайтиПоРеквизиту("КодПоЕДРПОУ", СокрЛП(КодЕДРПОУ));
		Если ЗначениеЗаполнено(К) Тогда Возврат К; КонецЕсли;
		К = Справочники.Контрагенты.НайтиПоРеквизиту("А_ИдКод", СокрЛП(КодЕДРПОУ));
		Если ЗначениеЗаполнено(К) Тогда Возврат К; КонецЕсли;
	КонецЕсли;
	Если НЕ ПустаяСтрока(Наим) Тогда
		К = Справочники.Контрагенты.НайтиПоНаименованию(СокрЛП(Наим), Истина);
		Если ЗначениеЗаполнено(К) Тогда Возврат К; КонецЕсли;
	КонецЕсли;
	Возврат Справочники.Контрагенты.ПустаяСсылка();
КонецФункции

// Вставляет субконто Контрагент по первому виду субконто счёта типа Справочник.Контрагенты.
// КоллекцияСубконто - Движение.СубконтоКт или .СубконтоДт.
Процедура _ЗаполнитьСубконтоКонтрагент(КоллекцияСубконто, Счет, Контрагент)
	Если НЕ ЗначениеЗаполнено(Счет) ИЛИ НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;
	ТипКонтр = Тип("СправочникСсылка.Контрагенты");
	Для Каждого ВС Из Счет.ВидыСубконто Цикл
		Если ВС.ВидСубконто.ТипЗначения.СодержитТип(ТипКонтр) Тогда
			КоллекцияСубконто.Вставить(ВС.ВидСубконто, Контрагент);
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Загружает сальдо счетов 6853/378 из BuhBud в табличную часть Остатки.
Процедура ЗагрузитьОстатки() Экспорт

	Если НЕ ЗначениеЗаполнено(ОкончаниеПериода) Тогда
		ВызватьИсключение "Не указана дата остатков (ОкончаниеПериода)!";
	КонецЕсли;

	// ERP-side: ЕДРПОУ организаций «в балансе» (в BuhBud реквизита А_ВБалансе НЕТ)
	ЗапросОрг = Новый Запрос;
	ЗапросОрг.Текст =
	"ВЫБРАТЬ
	|	Орг.КодПоЕДРПОУ КАК ЕДРПОУ
	|ИЗ
	|	Справочник.Организации КАК Орг
	|ГДЕ
	|	Орг.А_ВБалансе
	|	И Орг.КодПоЕДРПОУ <> """"";
	СписокЕДРПОУ = ЗапросОрг.Выполнить().Выгрузить().ВыгрузитьКолонку("ЕДРПОУ");
	Если СписокЕДРПОУ.Количество() = 0 Тогда
		ВызватьИсключение "Нет организаций с признаком А_ВБалансе.";
	КонецЕсли;

	// Подключение к BuhBud
	СтрокаПодключения = А_ПодключенияБазСервер.СтрокаПодключения("bas_industrialbud");
	V8 = Новый COMОбъект("V83.COMConnector");
	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключения));
	Исключение
		ВызватьИсключение "Ошибка подключения к BuhBud: " + ОписаниеОшибки();
	КонецПопытки;

	// КодВзыскателя/НаимВзыскателя — через ВЫРАЗИТЬ(Субконто1 КАК Контрагенты) (для 6853;
	// у 378 субконто = «Статьи деклараций» -> ВЫРАЗИТЬ даёт NULL, маппинг не выполняется).
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Ост.Организация.КодПоЕДРПОУ КАК ЕДРПОУ,
	|	Ост.Счет.Код КАК КодСчета,
	|	ПРЕДСТАВЛЕНИЕ(Ост.Субконто1) КАК ВидСубконтоНаим,
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Контрагенты).КодПоЕДРПОУ КАК КодВзыскателя,
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Контрагенты).Наименование КАК НаимВзыскателя,
	|	Ост.СуммаКонечныйОстатокКт - Ост.СуммаКонечныйОстатокДт КАК Сальдо
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(%%ГРАНИЦА%%, %%ГРАНИЦА%%, , , Счет.Код В (&Счета), , ) КАК Ост
	|ГДЕ
	|	Ост.Организация.КодПоЕДРПОУ В (&СписокЕДРПОУ)
	|	И (Ост.СуммаКонечныйОстатокКт - Ост.СуммаКонечныйОстатокДт) <> 0";

	// Границу конца суток строим ДАТАВРЕМЯ-ЛИТЕРАЛОМ прямо в тексте запроса BuhBud, а не &Дата-параметром:
	// детерминированная граница без маршалинга 1С-Даты через COM-границу ERP<->BuhBud (маршалинг даты
	// через COMConnector зависит от часовых поясов сеансов — литерал от этого свободен; данные исп.листов
	// чувствительны к дате посуточно). ДАТАВРЕМЯ параметры не принимает -> интерполируем целые Год/Мес/День;
	// Формат ЧГ=0 — без разделителей разрядов (иначе год "2 025" сломает запрос).
	ГраницаДВ = "ДАТАВРЕМЯ(" + Формат(Год(ОкончаниеПериода), "ЧГ=0") + ", "
		+ Формат(Месяц(ОкончаниеПериода), "ЧГ=0") + ", "
		+ Формат(День(ОкончаниеПериода), "ЧГ=0") + ", 23, 59, 59)";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%%ГРАНИЦА%%", ГраницаДВ);

	Попытка
		Запрос = V83.NewObject("Запрос");
		Запрос.Текст = ТекстЗапроса;

		МассивСчетов = V83.NewObject("Массив");
		Для Каждого Код Из СтрРазделить("6853,378", ",", Ложь) Цикл
			МассивСчетов.Добавить(СокрЛП(Код));
		КонецЦикла;
		Запрос.УстановитьПараметр("Счета", МассивСчетов);

		МассивЕДРПОУ = V83.NewObject("Массив");
		Для Каждого Е Из СписокЕДРПОУ Цикл
			МассивЕДРПОУ.Добавить(СокрЛП(Е));
		КонецЦикла;
		Запрос.УстановитьПараметр("СписокЕДРПОУ", МассивЕДРПОУ);

		ТЗ = Запрос.Выполнить().Выгрузить();
		стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗ);
	Исключение
		V83 = Неопределено;
		V8 = Неопределено;
		ВызватьИсключение "Ошибка запроса BuhBud: " + ОписаниеОшибки();
	КонецПопытки;

	ТаблицаОстатков = ЗначениеИзСтрокиВнутр(стр_ТЗ);
	V83 = Неопределено;
	V8 = Неопределено;

	Остатки.Очистить();
	СчетчикПропущеноОрг = 0;
	СчетчикБезВзыскателя = 0;
	Для Каждого СтрТЗ Из ТаблицаОстатков Цикл

		ОргERP = Справочники.Организации.НайтиПоРеквизиту("КодПоЕДРПОУ", СокрЛП(СтрТЗ.ЕДРПОУ));
		Если НЕ ЗначениеЗаполнено(ОргERP) Тогда
			СчетчикПропущеноОрг = СчетчикПропущеноОрг + 1;
			Продолжить;
		КонецЕсли;

		Карта = _СтатьяИСубконтоПоСчету(СтрТЗ.КодСчета);
		Если Карта.СтатьяПАП = Неопределено Тогда
			Продолжить; // неизвестный счёт — пропуск
		КонецЕсли;

		НС = Остатки.Добавить();
		НС.ОрганизацияБух  = ОргERP;
		НС.КодСчета        = СокрЛП(СтрТЗ.КодСчета);
		НС.Счет            = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СокрЛП(СтрТЗ.КодСчета));
		НС.СтатьяПАП       = Карта.СтатьяПАП;
		НС.Подразделение   = ОргERP.А_ПодразделениеЗарплатаБух;
		НС.ВидСубконтоНаим = СтрТЗ.ВидСубконтоНаим;
		НС.СуммаСальдо     = СтрТЗ.Сальдо;

		Если Карта.ЕстьСубконтоКонтрагент Тогда
			НС.Контрагент = _НайтиКонтрагента(СтрТЗ.КодВзыскателя, СтрТЗ.НаимВзыскателя);
			Если НЕ ЗначениеЗаполнено(НС.Контрагент) Тогда
				СчетчикБезВзыскателя = СчетчикБезВзыскателя + 1;
				Сообщить("Взыскатель не найден в ERP: """ + СокрЛП(СтрТЗ.ВидСубконтоНаим)
					+ """ (орг " + Строка(ОргERP) + ") — строка перенесена без субконто.");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Загружено позиций: " + Остатки.Количество());
	Если СчетчикПропущеноОрг > 0 Тогда
		Сообщить("Пропущено (организация не найдена в ERP по ЕДРПОУ): " + СчетчикПропущеноОрг);
	КонецЕсли;
	Если СчетчикБезВзыскателя > 0 Тогда
		Сообщить("Без сопоставленного взыскателя (Контрагент): " + СчетчикБезВзыскателя);
	КонецЕсли;

КонецПроцедуры

// Создаёт/обновляет два документа-приёмника:
//   1) КорректировкаРегистров — движения Движения.ПрочиеАктивыПассивы (ПАП, одноногая, агрегат)
//   2) ОперацияБух            — движения Движения.Хозрасчетный (Дт00/Кт<счёт> + субконто 6853)
Процедура СоздатьДокументы() Экспорт

	Если Остатки.Количество() = 0 Тогда
		ВызватьИсключение "Таблица остатков пуста — сначала «Загрузить остатки».";
	КонецЕсли;
	ДатаДок = КонецДня(ОкончаниеПериода);

	// 1) ПАП через КорректировкаРегистров — агрегат по Орг×Подр×СтатьяПАП (одноногая)
	ДокКР = _ПолучитьИлиСоздатьКР(ДатаДок);
	НаборПАП = ДокКР.Движения.ПрочиеАктивыПассивы;
	НаборПАП.Записывать = Истина;
	НаборПАП.Очистить();
	Если ДокКР.ТаблицаРегистров.Найти("ПрочиеАктивыПассивы", "Имя") = Неопределено Тогда
		ДокКР.ТаблицаРегистров.Добавить().Имя = "ПрочиеАктивыПассивы";
	КонецЕсли;

	ТЗАгр = Остатки.Выгрузить(, "ОрганизацияБух,Подразделение,СтатьяПАП,СуммаСальдо");
	ТЗАгр.Свернуть("ОрганизацияБух,Подразделение,СтатьяПАП", "СуммаСальдо");
	Для Каждого СтрА Из ТЗАгр Цикл
		Если СтрА.СуммаСальдо = 0 Тогда Продолжить; КонецЕсли;
		Абс = ?(СтрА.СуммаСальдо > 0, СтрА.СуммаСальдо, -СтрА.СуммаСальдо);
		ДвП = НаборПАП.Добавить();
		ДвП.Период        = ДатаДок;
		ДвП.Активность    = Истина;
		// Обе статьи Пассив: рост Кт-долга (Сальдо>0) -> Расход; Дт-сальдо (Сальдо<0) -> Приход.
		ДвП.ВидДвижения   = ?(СтрА.СуммаСальдо > 0, ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
		ДвП.Организация   = СтрА.ОрганизацияБух;
		ДвП.Подразделение = СтрА.Подразделение;
		ДвП.Статья        = СтрА.СтатьяПАП;
		ДвП.Источник      = Перечисления.ИсточникиУправленческогоБаланса.ПустаяСсылка();
		ДвП.ВидИсточника  = Перечисления.ВидыИсточниковДвижений.ПустаяСсылка();
		ДвП.Сумма         = Абс;
		// Аналитика — пусто (получатель в ПАП не разворачивается)
	КонецЦикла;

	// 2) Хозрасчетный через ОперацияБух — построчно (Дт00/Кт<счёт>; для 6853 + субконто Контрагент)
	ДокОБ = _ПолучитьИлиСоздатьОБ(ДатаДок);
	НаборХР = ДокОБ.Движения.Хозрасчетный;
	НаборХР.Записывать = Истина;
	НаборХР.Очистить();
	Счет00 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("00");
	Для Каждого СтрН Из Остатки Цикл
		Если СтрН.СуммаСальдо = 0 ИЛИ НЕ ЗначениеЗаполнено(СтрН.Счет) Тогда Продолжить; КонецЕсли;
		Абс = ?(СтрН.СуммаСальдо > 0, СтрН.СуммаСальдо, -СтрН.СуммаСальдо);
		ЕстьКонтр = (СокрЛП(СтрН.КодСчета) = "6853");
		ДвХ = НаборХР.Добавить();
		ДвХ.Период      = ДатаДок;
		ДвХ.Активность  = Истина;
		ДвХ.Организация = СтрН.ОрганизацияБух;
		ДвХ.Содержание  = "Ввод начального остатка (исп.листы/фонды)";
		Если СтрН.СуммаСальдо > 0 Тогда
			// Кредитовое сальдо (долг взыскателю/фонду): Дт00 / Кт<счёт>
			ДвХ.СчетДт = Счет00;
			ДвХ.СчетКт = СтрН.Счет;
			Если ЕстьКонтр Тогда
				_ЗаполнитьСубконтоКонтрагент(ДвХ.СубконтоКт, СтрН.Счет, СтрН.Контрагент);
			КонецЕсли;
		Иначе
			// Дебетовое сальдо (дебиторка фонда/переплата): Дт<счёт> / Кт00
			ДвХ.СчетДт = СтрН.Счет;
			ДвХ.СчетКт = Счет00;
			Если ЕстьКонтр Тогда
				_ЗаполнитьСубконтоКонтрагент(ДвХ.СубконтоДт, СтрН.Счет, СтрН.Контрагент);
			КонецЕсли;
		КонецЕсли;
		ДвХ.Сумма = Абс;
	КонецЦикла;

	ДокКР.Записать(РежимЗаписиДокумента.Запись);
	ДокОБ.Записать(РежимЗаписиДокумента.Проведение);
	ДокументКорректировкаРегистров = ДокКР.Ссылка;
	ДокументОперацияБух = ДокОБ.Ссылка;

	Сообщить("Создан/обновлён ПАП: " + Строка(ДокументКорректировкаРегистров));
	Сообщить("Создан/обновлён бухучёт: " + Строка(ДокументОперацияБух));

КонецПроцедуры

Функция _ПолучитьИлиСоздатьКР(ДатаДок)
	Если ЗначениеЗаполнено(ДокументКорректировкаРегистров) Тогда
		// Загружаем в ВЫБРАННЫЙ на форме документ (его движения будут очищены и перезаписаны)
		Док = ДокументКорректировкаРегистров.ПолучитьОбъект();
	Иначе
		Док = Документы.КорректировкаРегистров.СоздатьДокумент();
		Док.Операция = Перечисления.ОперацииКорректировкиРегистров.РучнаяКорректировка;
	КонецЕсли;
	Док.Дата = ДатаДок;
	Если ЗначениеЗаполнено(Организация) Тогда
		Док.Организация = Организация;
	КонецЕсли;
	Возврат Док;
КонецФункции

Функция _ПолучитьИлиСоздатьОБ(ДатаДок)
	Если ЗначениеЗаполнено(ДокументОперацияБух) Тогда
		// Загружаем в ВЫБРАННЫЙ на форме документ (его движения будут очищены и перезаписаны)
		Док = ДокументОперацияБух.ПолучитьОбъект();
	Иначе
		Док = Документы.ОперацияБух.СоздатьДокумент();
	КонецЕсли;
	Док.Дата = ДатаДок;
	// ОперацияБух требует непустую шапочную Организацию для проведения (регл.учёт).
	// Движения Хозрасчетного несут собственную Организацию per-row (ОрганизацияБух);
	// приоритет: форма > уже заданная у документа > собственная управленческая (ТОВ ІНДАСТРІАЛБУД).
	Если ЗначениеЗаполнено(Организация) Тогда
		Док.Организация = Организация;
	ИначеЕсли НЕ ЗначениеЗаполнено(Док.Организация) Тогда
		Док.Организация = Справочники.Организации.НайтиПоРеквизиту("КодПоЕДРПОУ", "40645273");
	КонецЕсли;
	Возврат Док;
КонецФункции

#КонецЕсли
