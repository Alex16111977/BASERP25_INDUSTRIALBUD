&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		Объект.ОкончаниеПериода = КонецМесяца(Дата(2025,11,1)); // 30.11.2025 по умолчанию
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОстатки(Команда)
	ЗагрузитьОстаткиНаСервере();
	Сообщить("Загружено строк остатков: " + Объект.Остатки.Количество());
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьОстаткиНаСервере()
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ОбъектОбработки.ЗагрузитьОстатки();
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументы(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		Предупреждение("Укажите дату остатков (ОкончаниеПериода)."); Возврат;
	КонецЕсли;
	Если Объект.Остатки.Количество() = 0 Тогда
		Предупреждение("Сначала «Загрузить остатки»."); Возврат;
	КонецЕсли;
	СоздатьДокументыНаСервере();
	Сообщить("Готово. КорректировкаРегистров=" + Строка(Объект.ДокументКорректировкаРегистров)
		+ "; ОперацияБух=" + Строка(Объект.ДокументОперацияБух));
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыНаСервере()
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ОбъектОбработки.СоздатьДокументы();
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");
КонецПроцедуры
