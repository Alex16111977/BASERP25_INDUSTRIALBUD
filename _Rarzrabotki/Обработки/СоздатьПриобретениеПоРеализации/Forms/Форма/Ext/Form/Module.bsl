
&НаСервере
Процедура СоздатьПриобритениеНаСервере()

	ДокРеализация = Объект.ДокРеализацияТоваровУслуг;

	Если НЕ ЗначениеЗаполнено(ДокРеализация) Тогда
		Сообщить("Не выбран документ реализации!");
		Возврат;
	КонецЕсли;

	// Получаем данные шапки реализации
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка,
	|	Док.Дата,
	|	Док.Организация,
	|	Док.Контрагент,
	|	Док.Партнер,
	|	Док.Договор,
	|	Док.Договор.А_ДоговорПоставщика КАК ДоговорПоставщика,
	|	Док.Валюта,
	|	Док.ВалютаВзаиморасчетов,
	|	Док.ЦенаВключаетНДС,
	|	Док.Склад,
	|	Док.Подразделение,
	|	Док.СуммаДокумента,
	|	Док.НаправлениеДеятельности,
	|	Док.Комментарий,
	|	Док.БанковскийСчетОрганизации,
	|	Док.БанковскийСчетКонтрагента,
	|	Док.Курс,
	|	Док.Кратность,
	|	Док.Договор.А_ДоговорПоставщика.ПорядокРасчетов КАК ПорядокРасчетовПоставщика,
	|	Док.Договор.А_ДоговорПоставщика.Подразделение КАК ПодразделениеДоговора
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Док
	|ГДЕ
	|	Док.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", ДокРеализация);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Сообщить("Документ реализации не найден!");
		Возврат;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	// Проверяем договор поставщика
	ДоговорПоставщика = Выборка.ДоговорПоставщика;
	Если НЕ ЗначениеЗаполнено(ДоговорПоставщика) Тогда
		Сообщить("В договоре """ + Строка(Выборка.Договор) + """ не заполнен реквизит А_ДоговорПоставщика!");
		Возврат;
	КонецЕсли;

	// Ищем существующий документ Приобретение по этой реализации
	ЗапросПриобретение = Новый Запрос;
	ЗапросПриобретение.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Док.Ссылка КАК Ссылка,
	|	Док.Проведен КАК Проведен,
	|	Док.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК Док
	|ГДЕ
	|	Док.А_РеализацияТоваровУслуг = &Ссылка";

	ЗапросПриобретение.УстановитьПараметр("Ссылка", ДокРеализация);
	РезультатПриобретение = ЗапросПриобретение.Выполнить();
	ЭтоОбновление = НЕ РезультатПриобретение.Пустой();

	// Получаем ТЧ Товары реализации
	ЗапросТовары = Новый Запрос;
	ЗапросТовары.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура,
	|	Товары.Характеристика,
	|	Товары.Назначение,
	|	Товары.Упаковка,
	|	Товары.КоличествоУпаковок,
	|	Товары.Количество,
	|	Товары.Цена,
	|	Товары.Сумма,
	|	Товары.СтавкаНДС,
	|	Товары.СуммаНДС,
	|	Товары.СуммаСНДС,
	|	Товары.Склад,
	|	Товары.Серия,
	|	Товары.СуммаВзаиморасчетов
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка";

	ЗапросТовары.УстановитьПараметр("Ссылка", ДокРеализация);
	РезультатТовары = ЗапросТовары.Выполнить();

	// Создаём или получаем существующий документ Приобретение
	Если ЭтоОбновление Тогда
		ВыборкаПриобретение = РезультатПриобретение.Выбрать();
		ВыборкаПриобретение.Следующий();
		НовыйДок = ВыборкаПриобретение.Ссылка.ПолучитьОбъект();
		Если ВыборкаПриобретение.Проведен Тогда
			НовыйДок.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		Если ВыборкаПриобретение.ПометкаУдаления Тогда
			НовыйДок.УстановитьПометкуУдаления(Ложь);
		КонецЕсли;
		НовыйДок.Товары.Очистить();
	Иначе
		НовыйДок = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
	КонецЕсли;

	// Заполняем шапку
	НовыйДок.Дата                    = Выборка.Дата;
	НовыйДок.Организация             = Выборка.Организация;
	НовыйДок.Контрагент              = Выборка.Контрагент;
	НовыйДок.Партнер                 = Выборка.Партнер;
	НовыйДок.Договор                 = ДоговорПоставщика;
	НовыйДок.Валюта                  = Выборка.Валюта;
	НовыйДок.ВалютаВзаиморасчетов    = Выборка.ВалютаВзаиморасчетов;
	НовыйДок.ЦенаВключаетНДС         = Выборка.ЦенаВключаетНДС;
	НовыйДок.Склад                   = Выборка.Склад;
	НовыйДок.Подразделение           = Выборка.ПодразделениеДоговора;
	НовыйДок.СуммаДокумента          = Выборка.СуммаДокумента;
	НовыйДок.НаправлениеДеятельности = Выборка.НаправлениеДеятельности;
	НовыйДок.Комментарий             = Выборка.Комментарий;
	НовыйДок.БанковскийСчетОрганизации  = Выборка.БанковскийСчетОрганизации;
	НовыйДок.БанковскийСчетКонтрагента  = Выборка.БанковскийСчетКонтрагента;
	НовыйДок.Курс                    = Выборка.Курс;
	НовыйДок.Кратность               = Выборка.Кратность;

	НовыйДок.ХозяйственнаяОперация   = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	НовыйДок.ПорядокРасчетов         = Выборка.ПорядокРасчетовПоставщика;
	НовыйДок.А_РеализацияТоваровУслуг = ДокРеализация;

	// Заполняем ТЧ Товары
	КодСтроки = 0;
	СкладИзШапки = Выборка.Склад;
	ПодразделениеДоговора = Выборка.ПодразделениеДоговора;

	ВыборкаТовары = РезультатТовары.Выбрать();
	Пока ВыборкаТовары.Следующий() Цикл

		КодСтроки = КодСтроки + 1;

		НоваяСтрока = НовыйДок.Товары.Добавить();

		// Прямой перенос из реализации
		НоваяСтрока.Номенклатура       = ВыборкаТовары.Номенклатура;
		НоваяСтрока.Характеристика     = ВыборкаТовары.Характеристика;
		НоваяСтрока.Назначение          = ВыборкаТовары.Назначение;
		НоваяСтрока.Упаковка            = ВыборкаТовары.Упаковка;
		НоваяСтрока.КоличествоУпаковок  = ВыборкаТовары.КоличествоУпаковок;
		НоваяСтрока.Количество          = ВыборкаТовары.Количество;
		НоваяСтрока.Цена                = ВыборкаТовары.Цена;
		НоваяСтрока.Сумма               = ВыборкаТовары.Сумма;
		НоваяСтрока.СтавкаНДС           = ВыборкаТовары.СтавкаНДС;
		НоваяСтрока.СуммаНДС            = ВыборкаТовары.СуммаНДС;
		НоваяСтрока.СуммаСНДС           = ВыборкаТовары.СуммаСНДС;
		НоваяСтрока.Серия               = ВыборкаТовары.Серия;

		// Расчётные/дополнительные реквизиты
		НоваяСтрока.СуммаВзаиморасчетов     = ВыборкаТовары.СуммаСНДС;
		НоваяСтрока.СуммаНДСВзаиморасчетов  = ВыборкаТовары.СуммаНДС;
		НоваяСтрока.КодСтроки               = КодСтроки;
		НоваяСтрока.ИдентификаторСтроки      = Строка(Новый УникальныйИдентификатор);
		НоваяСтрока.НалоговоеНазначение      = Справочники.НалоговыеНазначенияАктивовИЗатрат.НДС_Облагаемая;
		НоваяСтрока.Склад                    = СкладИзШапки;
		НоваяСтрока.Подразделение            = ПодразделениеДоговора;
        НоваяСтрока.СписатьНаРасходы         = Истина;
	КонецЦикла;

	// Записываем документ без проведения
	НовыйДок.Записать(РежимЗаписиДокумента.Запись);

	Если ЭтоОбновление Тогда
		Сообщить("Обновлен документ: Приобретение товаров и услуг " + НовыйДок.Номер + " от " + Формат(НовыйДок.Дата, "ДФ=dd.MM.yyyy"));
	Иначе
		Сообщить("Создан документ: Приобретение товаров и услуг " + НовыйДок.Номер + " от " + Формат(НовыйДок.Дата, "ДФ=dd.MM.yyyy"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьПриобритение(Команда)
	СоздатьПриобритениеНаСервере();
КонецПроцедуры
