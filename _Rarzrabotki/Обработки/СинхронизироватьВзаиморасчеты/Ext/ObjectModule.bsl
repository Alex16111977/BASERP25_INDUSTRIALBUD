// ===========================================================================
// Обробка: СинхронизироватьВзаиморасчеты
// Призначення: Контроль розбіжностей ВЗАЄМОРОЗРАХУНКІВ по контрагентах ERP ↔ BuhBud
// Розділ: Взаєморозрахунки (РасчетыСКлиентами + РасчетыСПоставщиками ↔ рах. 36x/63x/685x/377x/60x/684/655)
// ===========================================================================
// Фаза 1: Порівняння залишків (Контрагент×Договір×Валюта, нетування сторін як у звіті-донорі)
// Фаза 2: Аналіз документів (через СоответствияОбъектовИнформационныхБаз по Регістратору)
// Фаза 3: Синхронізація (розпровести/провести/перепровести в ЕРП / на обмін в BuhBud)
// ===========================================================================

#Область ОбщиеФункции

// Підключення до BuhBud через COM
//
Функция ПодключитьсяКBuhBud() Экспорт

	СтрокаПодключенияBuhBud = А_ПодключенияБазСервер.СтрокаПодключения("bas_industrialbud");
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияBuhBud));
	Исключение
		Сообщить("Помилка підключення до BuhBud: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Возврат V83;

КонецФункции

// Масив ЕДРПОУ організацій з ознакою А_ВБалансе — для фільтру запитів BuhBud.
// Повертає V83-масив (для передачі у COM-запит).
//
Функция СписокЕДРПОУ_V83(V83) Экспорт

	ЗапросОрг = Новый Запрос;
	ЗапросОрг.Текст =
	"ВЫБРАТЬ
	|	Организации.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.А_ВБалансе = ИСТИНА
	|	И Организации.КодПоЕДРПОУ <> """"";

	масV83 = V83.NewObject("Массив");
	Выборка = ЗапросОрг.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		масV83.Добавить(Выборка.КодПоЕДРПОУ);
	КонецЦикла;
	Возврат масV83;

КонецФункции

// Масив рахунків взаєморозрахунків BuhBud (36x/63x/685x/377x/60x/684/655) — V83-масив.
//
Функция СписокСчетовРасчетов_V83(V83) Экспорт

	мас = V83.NewObject("Массив");
	мас.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСОтечественнымиПокупателями);            // 361
	мас.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСИностраннымиПокупателями);              // 362
	мас.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСОтечественнымиПоставщиками);            // 631
	мас.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСИностраннымиПоставщиками);              // 632
	мас.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСДругимиКредиторамиВНациональнойВалюте); // 6851
	мас.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСДругимиКредиторамиВИностраннойВалюте);  // 6852
	Попытка
		мас.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыПоДолгосрочнымФинансовымИнвестициямУчастиеВКапиталеВалюта); // 6855
	Исключение КонецПопытки;
	Попытка
		Сч6855 = V83.ПланыСчетов.Хозрасчетный.НайтиПоНаименованию("Розрахунки з іншими кредиторами (ПФД Отримана)");
		Если Сч6855 <> Неопределено И НЕ Сч6855.Пустая() Тогда
			мас.Добавить(Сч6855);
		КонецЕсли;
	Исключение КонецПопытки;
	мас.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСДругимиДебиторамиВНациональнойВалюте);  // 3771
	мас.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСДругимиДебиторамиВИностраннойВалюте);   // 3772
	мас.Добавить(V83.ПланыСчетов.Хозрасчетный.КраткосрочныеКредитыБанковВНациональнойВалюте); // 601
	мас.Добавить(V83.ПланыСчетов.Хозрасчетный.КраткосрочныеКредитыБанковВИностраннойВалюте);  // 602
	мас.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыПоНачисленнымПроцентам);                 // 684
	мас.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыПоСтрахованиюИмущества);                 // 655
	Возврат мас;

КонецФункции

#КонецОбласти

// ===========================================================================
// ФАЗА 1: Порівняння залишків
// ===========================================================================

#Область Фаза1_СверкаОстатков

// Головна функція Фази 1 — порівняння залишків взаєморозрахунків
//
Функция СравнитьОстатки() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ТаблицаРасхождений.Очистить();
	ТаблицаДокументов.Очистить();
	ТаблицаКонтрагентов.Очистить();

	V83 = ПодключитьсяКBuhBud();
	Если V83 = Неопределено Тогда
		Возврат "Помилка підключення до BuhBud";
	КонецЕсли;

	Попытка
		СравнитьОстатки_Взаиморасчеты(V83);
	Исключение
		Сообщить("Помилка при порівнянні залишків: " + ОписаниеОшибки());
	КонецПопытки;

	V83 = Неопределено;

	ЗаполнитьСводПоКонтрагентам();

	Возврат "Оброблено. Контрагентів з розбіжностями: " + Строка(ТаблицаКонтрагентов.Количество())
		+ ", позицій: " + Строка(ТаблицаРасхождений.Количество());

КонецФункции

// Згортка ТаблицаРасхождений (позиції Контрагент×Договір×Валюта) у звід по контрагентах.
// Кількість договорів та Σ|Різниця| (суми між валютами НЕ підсумовуємо як меру, лише |Δ|).
//
Процедура ЗаполнитьСводПоКонтрагентам()

	ТаблицаКонтрагентов.Очистить();

	Индекс = Новый Соответствие; // КонтрагентКлюч -> рядок
	Для Каждого СтрРасх Из ТаблицаРасхождений Цикл
		Ключ = СокрЛП(СтрРасх.КонтрагентКлюч);

		СтрК = Индекс.Получить(Ключ);
		Если СтрК = Неопределено Тогда
			СтрК = ТаблицаКонтрагентов.Добавить();
			СтрК.Контрагент      = СтрРасх.Контрагент;
			СтрК.КонтрагентКлюч  = Ключ;
			СтрК.Синхронизировать = Истина;
			Индекс.Вставить(Ключ, СтрК);
		КонецЕсли;

		СтрК.Договоров    = СтрК.Договоров + 1;
		СтрК.СуммаРазницы = СтрК.СуммаРазницы + ?(СтрРасх.Разница < 0, -СтрРасх.Разница, СтрРасх.Разница);
	КонецЦикла;

КонецПроцедуры

Процедура СравнитьОстатки_Взаиморасчеты(V83)

	НачП = НачалоПериода;
	КонП = КонецДня(ОкончаниеПериода);

	ТЗ_ЕРП = ПолучитьОстаткиЕРП(НачП, КонП);
	ТЗ_Бух = ПолучитьОстаткиBuhBud(V83, НачП, КонП);
	СвестиТаблицы_Взаиморасчеты(ТЗ_ЕРП, ТЗ_Бух);

КонецПроцедуры

// Залишки ERP: UNION РасчетыСКлиентами + РасчетыСПоставщиками через АналитикаУчетаПоПартнерам.
// Нетування сторін у одну позицію Контрагент×Договір×Валюта (як у звіті-донорі).
//
Функция ПолучитьОстаткиЕРП(НачП, КонП)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МИНИМУМ(ВЗ.Сторона) КАК Сторона,
	|	ВЗ.Контрагент КАК Контрагент,
	|	ВЗ.КонтрагентИдКод КАК КонтрагентИдКод,
	|	ВЗ.Договор КАК Договор,
	|	ВЗ.ДоговорИдКод КАК ДоговорИдКод,
	|	ВЗ.ВалютаСсылка КАК ВалютаСсылка,
	|	ВЗ.ВалютаКод КАК ВалютаКод,
	|	СУММА(ВЗ.НачОстаток) КАК НачОстаток,
	|	СУММА(ВЗ.Приход) КАК Приход,
	|	СУММА(ВЗ.Расход) КАК Расход,
	|	СУММА(ВЗ.КонОстаток) КАК КонОстаток
	|ИЗ
	|	(ВЫБРАТЬ
	|		1 КАК Сторона,
	|		регА.Контрагент КАК Контрагент,
	|		регА.Контрагент.А_ИдКод КАК КонтрагентИдКод,
	|		регА.Договор КАК Договор,
	|		регА.Договор.А_ИдКод КАК ДоговорИдКод,
	|		регА.Договор.ВалютаВзаиморасчетов КАК ВалютаСсылка,
	|		регА.Договор.ВалютаВзаиморасчетов.Код КАК ВалютаКод,
	|		Расч.СуммаНачальныйОстаток КАК НачОстаток,
	|		Расч.СуммаПриход КАК Приход,
	|		Расч.СуммаРасход КАК Расход,
	|		Расч.СуммаКонечныйОстаток КАК КонОстаток
	|	ИЗ
	|		РегистрНакопления.РасчетыСКлиентами.ОстаткиИОбороты(&НачП, &КонП, , , ) КАК Расч
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК регА
	|			ПО Расч.АналитикаУчетаПоПартнерам = регА.КлючАналитики
	|	ГДЕ
	|		(&ФильтрКонтрагент ИЛИ регА.Контрагент = &Контрагент)
	|		И (&ФильтрДоговор ИЛИ регА.Договор = &Договор)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		2,
	|		регА.Контрагент,
	|		регА.Контрагент.А_ИдКод,
	|		регА.Договор,
	|		регА.Договор.А_ИдКод,
	|		регА.Договор.ВалютаВзаиморасчетов,
	|		регА.Договор.ВалютаВзаиморасчетов.Код,
	|		Расч.СуммаНачальныйОстаток,
	|		Расч.СуммаПриход,
	|		Расч.СуммаРасход,
	|		Расч.СуммаКонечныйОстаток
	|	ИЗ
	|		РегистрНакопления.РасчетыСПоставщиками.ОстаткиИОбороты(&НачП, &КонП, , , ) КАК Расч
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК регА
	|			ПО Расч.АналитикаУчетаПоПартнерам = регА.КлючАналитики
	|	ГДЕ
	|		(&ФильтрКонтрагент ИЛИ регА.Контрагент = &Контрагент)
	|		И (&ФильтрДоговор ИЛИ регА.Договор = &Договор)) КАК ВЗ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЗ.Контрагент,
	|	ВЗ.КонтрагентИдКод,
	|	ВЗ.Договор,
	|	ВЗ.ДоговорИдКод,
	|	ВЗ.ВалютаСсылка,
	|	ВЗ.ВалютаКод";

	Запрос.УстановитьПараметр("НачП", НачП);
	Запрос.УстановитьПараметр("КонП", КонП);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("ФильтрКонтрагент", НЕ ЗначениеЗаполнено(Контрагент));
	Запрос.УстановитьПараметр("ФильтрДоговор", НЕ ЗначениеЗаполнено(Договор));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Залишки BuhBud через COM (Хозрасчетный, розрахункові рахунки), динамічне субконто.
// Валютна логіка: грн -> СуммаХХХ, валюта -> ВалютнаяСуммаХХХ (як у звіті-донорі).
//
Функция ПолучитьОстаткиBuhBud(V83, НачП, КонП)

	Запрос = V83.NewObject("Запрос");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЗ.КонтрагентИдКод КАК КонтрагентИдКод,
	|	ВЗ.ДоговорИдКод КАК ДоговорИдКод,
	|	ВЗ.ВалютаКод КАК ВалютаКод,
	|	СУММА(ВЗ.НачОстаток) КАК НачОстаток,
	|	СУММА(ВЗ.Приход) КАК Приход,
	|	СУММА(ВЗ.Расход) КАК Расход,
	|	СУММА(ВЗ.КонОстаток) КАК КонОстаток
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВЫБОР
	|			КОГДА ПозК.НомерСтроки = 1 ТОГДА ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Контрагенты).А_ИдКод
	|			КОГДА ПозК.НомерСтроки = 2 ТОГДА ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.Контрагенты).А_ИдКод
	|			КОГДА ПозК.НомерСтроки = 3 ТОГДА ВЫРАЗИТЬ(Ост.Субконто3 КАК Справочник.Контрагенты).А_ИдКод
	|			ИНАЧЕ """"
	|		КОНЕЦ КАК КонтрагентИдКод,
	|		ВЫБОР
	|			КОГДА ПозД.НомерСтроки = 1 ТОГДА ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
	|			КОГДА ПозД.НомерСтроки = 2 ТОГДА ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
	|			КОГДА ПозД.НомерСтроки = 3 ТОГДА ВЫРАЗИТЬ(Ост.Субконто3 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
	|			ИНАЧЕ """"
	|		КОНЕЦ КАК ДоговорИдКод,
	|		ВЫБОР
	|			КОГДА ПозД.НомерСтроки = 2 ТОГДА ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов.Код
	|			ИНАЧЕ ""980""
	|		КОНЕЦ КАК ВалютаКод,
	|		ВЫБОР
	|			КОГДА ПозД.НомерСтроки = 2 И ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов <> &Грн
	|				ТОГДА Ост.ВалютнаяСуммаНачальныйОстаток ИНАЧЕ Ост.СуммаНачальныйОстаток
	|		КОНЕЦ КАК НачОстаток,
	|		ВЫБОР
	|			КОГДА ПозД.НомерСтроки = 2 И ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов <> &Грн
	|				ТОГДА Ост.ВалютнаяСуммаОборотДт ИНАЧЕ Ост.СуммаОборотДт
	|		КОНЕЦ КАК Приход,
	|		ВЫБОР
	|			КОГДА ПозД.НомерСтроки = 2 И ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов <> &Грн
	|				ТОГДА Ост.ВалютнаяСуммаОборотКт ИНАЧЕ Ост.СуммаОборотКт
	|		КОНЕЦ КАК Расход,
	|		ВЫБОР
	|			КОГДА ПозД.НомерСтроки = 2 И ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов <> &Грн
	|				ТОГДА Ост.ВалютнаяСуммаКонечныйОстаток ИНАЧЕ Ост.СуммаКонечныйОстаток
	|		КОНЕЦ КАК КонОстаток
	|	ИЗ
	|		РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачП, &КонП, Авто, ДвиженияИГраницыПериода, Счет В ИЕРАРХИИ (&Счет), , ) КАК Ост
	|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозК
	|				ПО Ост.Счет = ПозК.Ссылка И ПозК.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты)
	|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозД
	|				ПО Ост.Счет = ПозД.Ссылка И ПозД.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры)
	|	ГДЕ
	|		Ост.Организация.КодПоЕДРПОУ В (&масЕДРПОУ)) КАК ВЗ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЗ.КонтрагентИдКод,
	|	ВЗ.ДоговорИдКод,
	|	ВЗ.ВалютаКод";

	Запрос.УстановитьПараметр("НачП", НачП);
	Запрос.УстановитьПараметр("КонП", КонП);
	Запрос.УстановитьПараметр("Грн", V83.Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("Счет", СписокСчетовРасчетов_V83(V83));
	Запрос.УстановитьПараметр("масЕДРПОУ", СписокЕДРПОУ_V83(V83));

	Попытка
		ТЗ = Запрос.Выполнить().Выгрузить();
	Исключение
		Сообщить("Помилка запиту до BuhBud (взаєморозрахунки): " + ОписаниеОшибки());
		Возврат Новый ТаблицаЗначений;
	КонецПопытки;

	стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗ);
	ТаблицаBuhBud = ЗначениеИзСтрокиВнутр(стр_ТЗ);

	Возврат КонвертироватьТЗ_BuhBud(ТаблицаBuhBud);

КонецФункции

// Конвертація ИдКод -> посилання ERP (Контрагент/Договор/Валюта) через тимчасову таблицю.
//
Функция КонвертироватьТЗ_BuhBud(ТаблицаBuhBud)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВнТ.КонтрагентИдКод КАК КонтрагентИдКод,
	|	ВнТ.ДоговорИдКод КАК ДоговорИдКод,
	|	ВнТ.ВалютаКод КАК ВалютаКод,
	|	ВнТ.НачОстаток КАК НачОстаток,
	|	ВнТ.Приход КАК Приход,
	|	ВнТ.Расход КАК Расход,
	|	ВнТ.КонОстаток КАК КонОстаток
	|ПОМЕСТИТЬ ВнТ
	|ИЗ
	|	&ТЗ КАК ВнТ
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Контрагент,
	|	ДоговорыКонтрагентов.Ссылка КАК Договор,
	|	Валюты.Ссылка КАК ВалютаСсылка,
	|	ВнТ.КонтрагентИдКод КАК КонтрагентИдКод,
	|	ВнТ.ДоговорИдКод КАК ДоговорИдКод,
	|	ВнТ.ВалютаКод КАК ВалютаКод,
	|	ВнТ.НачОстаток КАК НачОстаток,
	|	ВнТ.Приход КАК Приход,
	|	ВнТ.Расход КАК Расход,
	|	ВнТ.КонОстаток КАК КонОстаток
	|ИЗ
	|	ВнТ КАК ВнТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ВнТ.КонтрагентИдКод = Контрагенты.А_ИдКод
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО ВнТ.ДоговорИдКод = ДоговорыКонтрагентов.А_ИдКод
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО ВнТ.ВалютаКод = Валюты.Код";

	Запрос.УстановитьПараметр("ТЗ", ТаблицаBuhBud);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Злиття ERP та BuhBud — FULL OUTER по ключу КонтрагентКлюч|ДоговорКлюч|ВалютаКод (без сторони).
//
Процедура СвестиТаблицы_Взаиморасчеты(ТЗ_ЕРП, ТЗ_Бух)

	Ключи = Новый Соответствие;

	// ERP
	Для Каждого Стр Из ТЗ_ЕРП Цикл
		КлК = СокрЛП(Стр.КонтрагентИдКод);
		КлД = СокрЛП(Стр.ДоговорИдКод);
		КлВ = СокрЛП(Стр.ВалютаКод);
		Ключ = КлК + "|" + КлД + "|" + КлВ;

		Запись = Ключи.Получить(Ключ);
		Если Запись = Неопределено Тогда
			Запись = НоваяЗаписьСведения(КлК, КлД, КлВ);
			Запись.Контрагент = Стр.Контрагент;
			Запись.Договор    = Стр.Договор;
			Запись.Валюта     = Стр.ВалютаСсылка;
			Ключи.Вставить(Ключ, Запись);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Запись.Раздел) Тогда
			Запись.Раздел = ?(Стр.Сторона = 2, "Постачальник", "Клієнт");
		КонецЕсли;
		Запись.НачЕРП     = Запись.НачЕРП     + Стр.НачОстаток;
		Запись.ПриходЕРП  = Запись.ПриходЕРП  + Стр.Приход;
		Запись.РасходЕРП  = Запись.РасходЕРП  + Стр.Расход;
		Запись.ОстатокЕРП = Запись.ОстатокЕРП + Стр.КонОстаток;
	КонецЦикла;

	// BuhBud
	Для Каждого Стр Из ТЗ_Бух Цикл
		КлК = СокрЛП(Стр.КонтрагентИдКод);
		КлД = СокрЛП(Стр.ДоговорИдКод);
		КлВ = СокрЛП(Стр.ВалютаКод);
		Ключ = КлК + "|" + КлД + "|" + КлВ;

		Запись = Ключи.Получить(Ключ);
		Если Запись = Неопределено Тогда
			Запись = НоваяЗаписьСведения(КлК, КлД, КлВ);
			Запись.Контрагент = ?(ЗначениеЗаполнено(Стр.Контрагент), Стр.Контрагент, "ІдКод: " + КлК);
			Запись.Договор    = ?(ЗначениеЗаполнено(Стр.Договор), Стр.Договор, ?(ЗначениеЗаполнено(КлД), "ІдКод: " + КлД, ""));
			Запись.Валюта     = ?(ЗначениеЗаполнено(Стр.ВалютаСсылка), Стр.ВалютаСсылка, КлВ);
			Ключи.Вставить(Ключ, Запись);
		КонецЕсли;
		Запись.НачБух     = Запись.НачБух     + Стр.НачОстаток;
		Запись.ПриходБух  = Запись.ПриходБух  + Стр.Приход;
		Запись.РасходБух  = Запись.РасходБух  + Стр.Расход;
		Запись.ОстатокБух = Запись.ОстатокБух + Стр.КонОстаток;
	КонецЦикла;

	// Заповнення ТаблицаРасхождений — тільки рядки з розбіжностями
	Для Каждого КлЗн Из Ключи Цикл
		Запись = КлЗн.Значение;

		Разница = Запись.ОстатокЕРП - Запись.ОстатокБух;
		Если Окр(Разница, 2) = 0
			И Окр(Запись.НачЕРП - Запись.НачБух, 2) = 0
			И Окр(Запись.ПриходЕРП - Запись.ПриходБух, 2) = 0
			И Окр(Запись.РасходЕРП - Запись.РасходБух, 2) = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Запись.Раздел) Тогда
			Запись.Раздел = ?(Запись.ОстатокЕРП - Запись.ОстатокБух < 0, "Постачальник", "Клієнт");
		КонецЕсли;

		НС = ТаблицаРасхождений.Добавить();
		НС.Раздел           = Запись.Раздел;
		НС.Контрагент       = Запись.Контрагент;
		НС.Договор          = Запись.Договор;
		НС.Валюта           = Запись.Валюта;
		НС.НачОстатокЕРП    = Запись.НачЕРП;
		НС.НачОстатокБух    = Запись.НачБух;
		НС.ПриходЕРП        = Запись.ПриходЕРП;
		НС.ПриходБух        = Запись.ПриходБух;
		НС.РасходЕРП        = Запись.РасходЕРП;
		НС.РасходБух        = Запись.РасходБух;
		НС.ОстатокЕРП       = Запись.ОстатокЕРП;
		НС.ОстатокБух       = Запись.ОстатокБух;
		НС.Разница          = Разница;
		НС.Синхронизировать = Истина;
		НС.КонтрагентКлюч   = Запись.КлК;
		НС.ДоговорКлюч      = Запись.КлД;
		НС.ВалютаКод        = Запись.КлВ;
	КонецЦикла;

КонецПроцедуры

// Фабрика структури-акумулятора однієї позиції
//
Функция НоваяЗаписьСведения(КлК, КлД, КлВ)
	Запись = Новый Структура(
		"Контрагент, Договор, Валюта, КлК, КлД, КлВ, Раздел,
		|НачЕРП, ПриходЕРП, РасходЕРП, ОстатокЕРП,
		|НачБух, ПриходБух, РасходБух, ОстатокБух",
		Неопределено, Неопределено, Неопределено, КлК, КлД, КлВ, "",
		0, 0, 0, 0,
		0, 0, 0, 0);
	Возврат Запись;
КонецФункции

#КонецОбласти

// ===========================================================================
// ФАЗА 2: Аналіз документів
// ===========================================================================

#Область Фаза2_АнализДокументов

// Головна функція Фази 2.
// ИндексКонтрагента = -1 → усі відмічені; >= 0 → один за індексом.
//
Функция АнализироватьДокументы(ИндексКонтрагента = -1) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ТаблицаДокументов.Очистить();

	Контрагенты = Новый Массив;
	Если ИндексКонтрагента >= 0 Тогда
		Если ИндексКонтрагента >= ТаблицаКонтрагентов.Количество() Тогда
			Возврат "Невірний номер рядка контрагента";
		КонецЕсли;
		Контрагенты.Добавить(ТаблицаКонтрагентов[ИндексКонтрагента]);
	Иначе
		Для Каждого СтрК Из ТаблицаКонтрагентов Цикл
			Если СтрК.Синхронизировать Тогда
				Контрагенты.Добавить(СтрК);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Контрагенты.Количество() = 0 Тогда
		Возврат "Немає відмічених контрагентів для аналізу";
	КонецЕсли;

	Для Каждого СтрК Из ТаблицаКонтрагентов Цикл
		СтрК.Документов     = 0;
		СтрК.Действий       = 0;
		СтрК.ТребуютРешения = 0;
	КонецЦикла;

	V83 = ПодключитьсяКBuhBud();
	Если V83 = Неопределено Тогда
		Возврат "Помилка підключення до BuhBud";
	КонецЕсли;

	УзелОбмена = Неопределено;
	Попытка
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20 ГДЕ НЕ ЭтотУзел";
		V83_Рез = V83_Запрос.Выполнить().Выбрать();
		Если V83_Рез.Следующий() Тогда
			УзелОбмена = V83_Рез.Ссылка;
		КонецЕсли;
	Исключение
		Сообщить("Не вдалося знайти вузол обміну в BuhBud: " + ОписаниеОшибки());
	КонецПопытки;

	Для Каждого СтрК Из Контрагенты Цикл
		КлючК = СокрЛП(СтрК.КонтрагентКлюч);
		ДоДок = ТаблицаДокументов.Количество();

		Для Каждого СтрРасх Из ТаблицаРасхождений Цикл
			Если СокрЛП(СтрРасх.КонтрагентКлюч) <> КлючК Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				АнализДокументов_Взаиморасчеты(V83, СтрРасх, УзелОбмена);
			Исключение
				Сообщить("ПОМИЛКА аналізу " + Строка(СтрРасх.Контрагент) + " / " + Строка(СтрРасх.Договор) + ": " + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;

		Для Сч = ДоДок По ТаблицаДокументов.Количество() - 1 Цикл
			СтрДок = ТаблицаДокументов[Сч];
			СтрДок.ЕстьРасхождение = НЕ СтрНачинаетсяС(СтрДок.Статус, "ОК")
				И НЕ СтрНачинаетсяС(СтрДок.Статус, "Збігається");
			СтрК.Документов = СтрК.Документов + 1;
			Если СтрДок.ЕстьРасхождение Тогда
				Если ЗначениеЗаполнено(СтрДок.Действие) Тогда
					СтрК.Действий = СтрК.Действий + 1;
				Иначе
					СтрК.ТребуютРешения = СтрК.ТребуютРешения + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	V83 = Неопределено;
	Возврат "Документів для синхронізації: " + Строка(ТаблицаДокументов.Количество());

КонецФункции

// Аналіз документів однієї позиції Контрагент×Договір.
//
Процедура АнализДокументов_Взаиморасчеты(V83, СтрРасх, УзелОбмена)

	НачП = НачалоПериода;
	КонП = КонецДня(ОкончаниеПериода);

	// 1. Обороти по документах ERP (UNION 2 регістрів) + LEFT JOIN СоответствияОбъектовИнформационныхБаз
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Об.Регистратор КАК Регистратор,
	|	ПРЕДСТАВЛЕНИЕ(Об.Регистратор) КАК РегистраторПредст,
	|	Об.Сумма КАК Сумма,
	|	Соотв.УникальныйИдентификаторПриемника КАК UIDвBuhBud,
	|	Соотв.ТипПриемника КАК ТипПриемника,
	|	Соотв.ТипИсточника КАК ТипИсточника
	|ИЗ
	|	(ВЫБРАТЬ
	|		Об1.Регистратор КАК Регистратор,
	|		Об1.СуммаПриход - Об1.СуммаРасход КАК Сумма
	|	ИЗ
	|		РегистрНакопления.РасчетыСКлиентами.Обороты(&НачП, &КонП, Авто,
	|			АналитикаУчетаПоПартнерам.Контрагент.А_ИдКод = &КонтрагентИдКод
	|				И АналитикаУчетаПоПартнерам.Договор.А_ИдКод = &ДоговорИдКод) КАК Об1
	|	ОБЪЕДИНИТЬ ВСЕ
	|	ВЫБРАТЬ
	|		Об2.Регистратор,
	|		Об2.СуммаПриход - Об2.СуммаРасход
	|	ИЗ
	|		РегистрНакопления.РасчетыСПоставщиками.Обороты(&НачП, &КонП, Авто,
	|			АналитикаУчетаПоПартнерам.Контрагент.А_ИдКод = &КонтрагентИдКод
	|				И АналитикаУчетаПоПартнерам.Договор.А_ИдКод = &ДоговорИдКод) КАК Об2) КАК Об
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
	|		ПО Об.Регистратор = Соотв.УникальныйИдентификаторИсточника
	|			И (Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20)";

	Запрос.УстановитьПараметр("НачП", НачП);
	Запрос.УстановитьПараметр("КонП", КонП);
	Запрос.УстановитьПараметр("КонтрагентИдКод", СтрРасх.КонтрагентКлюч);
	Запрос.УстановитьПараметр("ДоговорИдКод", СтрРасх.ДоговорКлюч);

	ТЗ_Док = Запрос.Выполнить().Выгрузить();

	ОбробитиДокументиЕРП(V83, ТЗ_Док, СтрРасх, УзелОбмена);
	АнализДокументовBuhBud_Взаиморасчеты(V83, СтрРасх);

КонецПроцедуры

// Обробка документів ERP: визначення дії/статусу по наявності пари в BuhBud.
//
Процедура ОбробитиДокументиЕРП(V83, ТЗ_Док, СтрРасх, УзелОбмена)

	Для Каждого СтрДок Из ТЗ_Док Цикл

		НС = ТаблицаДокументов.Добавить();
		НС.Раздел           = СтрРасх.Раздел;
		НС.Контрагент       = СтрРасх.Контрагент;
		НС.Договор          = СтрРасх.Договор;
		НС.ДокументЕРП      = СтрДок.Регистратор;
		НС.СуммаЕРП         = СтрДок.Сумма;
		НС.UIDДокумента     = Строка(СтрДок.Регистратор.УникальныйИдентификатор());
		НС.Синхронизировать = Истина;

		ТипИст = "";
		Попытка
			ТипИст = СокрЛП(СтрДок.ТипИсточника);
			ТипИст = СтрЗаменить(ТипИст, "ДокументСсылка.", "");
		Исключение
		КонецПопытки;
		Если НЕ ЗначениеЗаполнено(ТипИст) Тогда
			Попытка
				ТипИст = СтрДок.Регистратор.Метаданные().Имя;
			Исключение
			КонецПопытки;
		КонецЕсли;
		НС.ТипДокумента = ТипИст;

		UIDвBuhBud = Неопределено;
		Попытка
			UIDвBuhBud = СтрДок.UIDвBuhBud;
		Исключение
		КонецПопытки;

		Если UIDвBuhBud <> Неопределено И ЗначениеЗаполнено(UIDвBuhBud) Тогда
			НС.ЕстьСоответствие = Истина;
			НС.UIDДокументаБух  = Строка(UIDвBuhBud);

			ТипПрием = "";
			Попытка
				ТипПрием = СокрЛП(СтрДок.ТипПриемника);
				ТипПрием = СтрЗаменить(ТипПрием, "ДокументСсылка.", "");
			Исключение
			КонецПопытки;

			Если ЗначениеЗаполнено(ТипПрием) Тогда
				ПроверитьДокументВBuhBud(V83, НС, ТипПрием, UIDвBuhBud, УзелОбмена);
			Иначе
				НС.Действие = "Невідомий тип";
				НС.Статус   = "Тип приемника не визначено";
			КонецЕсли;
		Иначе
			НС.ЕстьСоответствие = Ложь;
			НС.Действие = "Розпровести в ЕРП";
			НС.Статус   = "Немає в BuhBud (немає відповідності)";
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Перевірка стану документа в BuhBud через COM.
//
Процедура ПроверитьДокументВBuhBud(V83, НС, ТипПриемника, UIDвBuhBud, УзелОбмена)

	Попытка
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст =
			"ВЫБРАТЬ Ссылка, Проведен, ПометкаУдаления, ПРЕДСТАВЛЕНИЕ(Ссылка) КАК Представление ИЗ Документ." + ТипПриемника
			+ " ГДЕ Ссылка = &Ссылка";

		СсылкаBuhBud = V83.Документы[ТипПриемника].ПолучитьСсылку(
			V83.NewObject("УникальныйИдентификатор", Строка(UIDвBuhBud)));
		V83_Запрос.УстановитьПараметр("Ссылка", СсылкаBuhBud);

		V83_Рез = V83_Запрос.Выполнить().Выбрать();
		Если V83_Рез.Следующий() Тогда
			НС.ДокументБух = СокрЛП(V83_Рез.Представление);

			Если V83_Рез.ПометкаУдаления Тогда
				НС.Действие = "Розпровести в ЕРП";
				НС.Статус   = "Видалений в BuhBud";
			ИначеЕсли НЕ V83_Рез.Проведен Тогда
				НС.Действие = "На обмін в BuhBud";
				НС.Статус   = "Не проведений в BuhBud";
				НС.ТипДокумента = ТипПриемника;
			Иначе
				НС.Действие = "Перепровести в ЕРП";
				НС.Статус   = "Проведений, різниця в рухах";
				НС.ТипДокумента = ТипПриемника;
			КонецЕсли;

			// Сума Бух по позиції встановлюється в АнализДокументовBuhBud_Взаиморасчеты
			Если (НС.Действие = "Переобмін" ИЛИ НС.Действие = "Перепровести в ЕРП")
				И Окр(НС.СуммаЕРП - НС.СуммаБух, 2) = 0 Тогда
				НС.Действие = "";
				НС.Статус   = "ОК";
				НС.Синхронизировать = Ложь;
			КонецЕсли;
		Иначе
			НС.Действие = "Розпровести в ЕРП";
			НС.Статус   = "Не знайдено в BuhBud";
		КонецЕсли;
	Исключение
		НС.Действие = "Помилка";
		НС.Статус   = "Помилка COM: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Зворотній аналіз: документи BuhBud по субконто Контрагент/Договір, яких немає в ЕРП.
//
Процедура АнализДокументовBuhBud_Взаиморасчеты(V83, СтрРасх)

	НачП = НачалоПериода;
	КонП = КонецДня(ОкончаниеПериода);

	ВжеЗнайдені = Новый Соответствие;
	МапаПоUIDБух = Новый Соответствие;
	МапаПоПредставлению = Новый Соответствие;
	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если ЗначениеЗаполнено(СтрДок.UIDДокументаБух) Тогда
			ВжеЗнайдені.Вставить(ВРег(СокрЛП(СтрДок.UIDДокументаБух)), Истина);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрДок.UIDДокументаБух)
			И СтрДок.Контрагент = СтрРасх.Контрагент
			И СтрДок.Договор = СтрРасх.Договор Тогда
			МапаПоUIDБух.Вставить(ВРег(СокрЛП(СтрДок.UIDДокументаБух)), СтрДок);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрДок.ДокументБух)
			И СтрДок.Контрагент = СтрРасх.Контрагент
			И СтрДок.Договор = СтрРасх.Договор Тогда
			МапаПоПредставлению.Вставить(СтрДок.ДокументБух, СтрДок);
		КонецЕсли;
	КонецЦикла;

	Попытка
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст =
		"ВЫБРАТЬ
		|	ВЗ.Регистратор КАК Регистратор,
		|	ПРЕДСТАВЛЕНИЕ(ВЗ.Регистратор) КАК РегистраторПредст,
		|	СУММА(ВЗ.СуммаНетто) КАК СуммаИтого
		|ИЗ
		|	(ВЫБРАТЬ
		|		Ост.Регистратор КАК Регистратор,
		|		Ост.СуммаОборотДт - Ост.СуммаОборотКт КАК СуммаНетто
		|	ИЗ
		|		РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачП, &КонП, Регистратор, , Счет В ИЕРАРХИИ (&Счет), , ) КАК Ост
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозК
		|				ПО Ост.Счет = ПозК.Ссылка И ПозК.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты)
		|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозД
		|				ПО Ост.Счет = ПозД.Ссылка И ПозД.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры)
		|	ГДЕ
		|		(Ост.СуммаОборотДт <> 0 ИЛИ Ост.СуммаОборотКт <> 0)
		|		И Ост.Организация.КодПоЕДРПОУ В (&масЕДРПОУ)
		|		И (ВЫБОР
		|			КОГДА ПозК.НомерСтроки = 1 ТОГДА ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Контрагенты).А_ИдКод
		|			КОГДА ПозК.НомерСтроки = 2 ТОГДА ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.Контрагенты).А_ИдКод
		|			КОГДА ПозК.НомерСтроки = 3 ТОГДА ВЫРАЗИТЬ(Ост.Субконто3 КАК Справочник.Контрагенты).А_ИдКод
		|			ИНАЧЕ """"
		|		КОНЕЦ) = &КонтрагентИдКод
		|		И ((ВЫБОР
		|			КОГДА ПозД.НомерСтроки = 1 ТОГДА ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
		|			КОГДА ПозД.НомерСтроки = 2 ТОГДА ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
		|			КОГДА ПозД.НомерСтроки = 3 ТОГДА ВЫРАЗИТЬ(Ост.Субконто3 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
		|			ИНАЧЕ """"
		|		КОНЕЦ) = &ДоговорИдКод
		|			ИЛИ ПозД.НомерСтроки ЕСТЬ NULL)) КАК ВЗ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЗ.Регистратор
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВЗ.СуммаНетто) <> 0";

		V83_Запрос.УстановитьПараметр("НачП", НачП);
		V83_Запрос.УстановитьПараметр("КонП", КонП);
		V83_Запрос.УстановитьПараметр("Счет", СписокСчетовРасчетов_V83(V83));
		V83_Запрос.УстановитьПараметр("масЕДРПОУ", СписокЕДРПОУ_V83(V83));
		V83_Запрос.УстановитьПараметр("КонтрагентИдКод", СтрРасх.КонтрагентКлюч);
		V83_Запрос.УстановитьПараметр("ДоговорИдКод", СтрРасх.ДоговорКлюч);

		V83_Рез = V83_Запрос.Выполнить().Выбрать();
		Пока V83_Рез.Следующий() Цикл

			UIDДок = "";
			Попытка
				UIDДок = ВРег(V83.XMLСтрока(V83_Рез.Регистратор.УникальныйИдентификатор()));
			Исключение
				Продолжить;
			КонецПопытки;

			ПредстБух = СокрЛП(V83_Рез.РегистраторПредст);

			Если ВжеЗнайдені.Получить(UIDДок) <> Неопределено Тогда
				НайденаСтрока = МапаПоUIDБух.Получить(UIDДок);
				Если НайденаСтрока = Неопределено Тогда
					НайденаСтрока = МапаПоПредставлению.Получить(ПредстБух);
				КонецЕсли;
				Если НайденаСтрока <> Неопределено Тогда
					НайденаСтрока.СуммаБух = V83_Рез.СуммаИтого;
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			НайденаСтрока = МапаПоUIDБух.Получить(UIDДок);
			Если НайденаСтрока = Неопределено Тогда
				НайденаСтрока = МапаПоПредставлению.Получить(ПредстБух);
			КонецЕсли;
			Если НайденаСтрока <> Неопределено Тогда
				НайденаСтрока.СуммаБух = V83_Рез.СуммаИтого;
				Продолжить;
			КонецЕсли;

			ТипБух = "";
			Попытка
				ТипБух = V83_Рез.Регистратор.Метаданные().Имя;
			Исключение
			КонецПопытки;

			ДокЕРППредставлення = "";
			ДокЕРПСсылка = Неопределено;
			UIDДокЕРП = "";
			ЕстьВідповідність = Ложь;
			ДіяДок = "На обмін в BuhBud";
			СтатусДок = "Існує тільки в BuhBud";
			Попытка
				ЗапросСоотв = Новый Запрос;
				ЗапросСоотв.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Соотв.УникальныйИдентификаторИсточника КАК Источник,
				|	Соотв.ТипИсточника КАК ТипИсточника
				|ИЗ
				|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
				|ГДЕ
				|	Соотв.УникальныйИдентификаторПриемника = &UIDПриемника
				|	И Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20";
				ЗапросСоотв.УстановитьПараметр("UIDПриемника", UIDДок);
				РезСоотв = ЗапросСоотв.Выполнить().Выбрать();
				Если РезСоотв.Следующий() Тогда
					ЕстьВідповідність = Истина;
					ДокЕРПСсылка = РезСоотв.Источник;
					UIDДокЕРП = Строка(РезСоотв.Источник.УникальныйИдентификатор());
					ДокЕРППредставлення = Строка(РезСоотв.Источник);
					Если РезСоотв.Источник.Проведен Тогда
						ДіяДок = "Перепровести в ЕРП";
						СтатусДок = "Проведений в ЕРП, немає рухів по позиції";
					Иначе
						ДіяДок = "Провести в ЕРП";
						СтатусДок = "Не проведений в ЕРП";
					КонецЕсли;
				КонецЕсли;
			Исключение
			КонецПопытки;

			НС = ТаблицаДокументов.Добавить();
			НС.Раздел           = СтрРасх.Раздел;
			НС.Контрагент       = СтрРасх.Контрагент;
			НС.Договор          = СтрРасх.Договор;
			НС.ТипДокумента     = ТипБух;
			НС.ДокументЕРП      = ?(ДокЕРПСсылка <> Неопределено, ДокЕРПСсылка, ДокЕРППредставлення);
			НС.ДокументБух      = ПредстБух;
			НС.СуммаЕРП         = 0;
			НС.СуммаБух         = V83_Рез.СуммаИтого;
			НС.UIDДокумента     = UIDДокЕРП;
			НС.UIDДокументаБух  = UIDДок;
			НС.ЕстьСоответствие = ЕстьВідповідність;
			НС.Действие         = ДіяДок;
			НС.Статус           = СтатусДок;
			НС.Синхронизировать = Истина;

		КонецЦикла;

	Исключение
		Сообщить("Помилка зворотнього аналізу BuhBud (взаєморозрахунки): " + ОписаниеОшибки());
	КонецПопытки;

	// Фінальна нормалізація: сума ЕРП = сума Бух → документ збігається.
	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если СтрДок.Контрагент <> СтрРасх.Контрагент
			ИЛИ СтрДок.Договор <> СтрРасх.Договор Тогда
			Продолжить;
		КонецЕсли;
		Если (СтрДок.Действие = "Переобмін" ИЛИ СтрДок.Действие = "Перепровести в ЕРП")
			И Окр(СтрДок.СуммаЕРП - СтрДок.СуммаБух, 2) = 0
			И СтрДок.СуммаЕРП <> 0 Тогда
			СтрДок.Действие = "";
			СтрДок.Статус   = "Збігається";
			СтрДок.Синхронизировать = Ложь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

// ===========================================================================
// ФАЗА 3: Синхронізація
// ===========================================================================

#Область Фаза3_Синхронизация

// Головна функція Фази 3 — виконання синхронізації всіх відмічених документів
//
Функция ВыполнитьСинхронизацию() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	V83 = Неопределено;
	УзелОбмена = Неопределено;
	КількістьОброблених = 0;
	КількістьПомилок    = 0;

	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если НЕ СтрДок.Синхронизировать Тогда
			Продолжить;
		КонецЕсли;
		ВыполнитьДействиеСтроки(СтрДок, V83, УзелОбмена, КількістьОброблених, КількістьПомилок);
	КонецЦикла;

	V83 = Неопределено;

	Возврат "Оброблено: " + КількістьОброблених + ", Помилок: " + КількістьПомилок;

КонецФункции

// Диспетчер дії рядка. V83/УзелОбмена передаються за посиланням — ліниве підключення.
//
Процедура ВыполнитьДействиеСтроки(СтрДок, V83, УзелОбмена, КількістьОброблених, КількістьПомилок)

	Если СтрДок.Действие = "Розпровести в ЕРП" Тогда
		Попытка
			РаспровестиВЕРП(СтрДок);
			УчестьРезультатСтроки(СтрДок, КількістьОброблених, КількістьПомилок);
		Исключение
			СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
			КількістьПомилок = КількістьПомилок + 1;
		КонецПопытки;

	ИначеЕсли СтрДок.Действие = "Провести в ЕРП" Тогда
		Попытка
			ПровестиВЕРП(СтрДок);
			УчестьРезультатСтроки(СтрДок, КількістьОброблених, КількістьПомилок);
		Исключение
			СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
			КількістьПомилок = КількістьПомилок + 1;
		КонецПопытки;

	ИначеЕсли СтрДок.Действие = "На обмін в BuhBud"
		ИЛИ СтрДок.Действие = "Переобмін" Тогда

		Если V83 = Неопределено Тогда
			V83 = ПодключитьсяКBuhBud();
			Если V83 = Неопределено Тогда
				СтрДок.Статус = "ПОМИЛКА: Немає підключення до BuhBud";
				КількістьПомилок = КількістьПомилок + 1;
				Возврат;
			КонецЕсли;
			Попытка
				V83_З = V83.NewObject("Запрос");
				V83_З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20 ГДЕ НЕ ЭтотУзел";
				V83_Рез = V83_З.Выполнить().Выбрать();
				Если V83_Рез.Следующий() Тогда
					УзелОбмена = V83_Рез.Ссылка;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;

		Попытка
			ПоставитьНаОбменВBuhBud(V83, СтрДок, УзелОбмена);
			УчестьРезультатСтроки(СтрДок, КількістьОброблених, КількістьПомилок);
		Исключение
			СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
			КількістьПомилок = КількістьПомилок + 1;
		КонецПопытки;

	ИначеЕсли СтрДок.Действие = "Перепровести в ЕРП" Тогда
		Попытка
			ПерепровестиВЕРП(СтрДок);
			УчестьРезультатСтроки(СтрДок, КількістьОброблених, КількістьПомилок);
		Исключение
			СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
			КількістьПомилок = КількістьПомилок + 1;
		КонецПопытки;

	Иначе
		СтрДок.Статус = "ПОМИЛКА: невідома дія """ + СтрДок.Действие + """";
		КількістьПомилок = КількістьПомилок + 1;
	КонецЕсли;

КонецПроцедуры

Процедура УчестьРезультатСтроки(СтрДок, КількістьОброблених, КількістьПомилок)
	Если СтрНачинаетсяС(СтрДок.Статус, "ПОМИЛКА") Тогда
		КількістьПомилок = КількістьПомилок + 1;
	Иначе
		КількістьОброблених = КількістьОброблених + 1;
	КонецЕсли;
КонецПроцедуры

// Розпровести документ в ЕРП
//
Процедура РаспровестиВЕРП(СтрДок)

	UIDСтрока = СокрЛП(СтрДок.UIDДокумента);
	Если НЕ ЗначениеЗаполнено(UIDСтрока) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа";
		Возврат;
	КонецЕсли;

	ТипДок = СокрЛП(СтрДок.ТипДокумента);
	МенеджерДок = Документы[ТипДок];
	СсылкаДок = МенеджерДок.ПолучитьСсылку(Новый УникальныйИдентификатор(UIDСтрока));

	Если НЕ ЗначениеЗаполнено(СсылкаДок) ИЛИ СсылкаДок.Пустая() Тогда
		СтрДок.Статус = "ПОМИЛКА: Документ не знайдено в ЕРП";
		Возврат;
	КонецЕсли;

	ДокОбъект = СсылкаДок.ПолучитьОбъект();
	ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	СтрДок.Статус = "Розпроведено в ЕРП";

КонецПроцедуры

// Провести непроведений документ в ЕРП (резолв типу за UID Бух через реєстр відповідності)
//
Процедура ПровестиВЕРП(СтрДок)

	Попытка
		ЗапросТип = Новый Запрос;
		ЗапросТип.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Соотв.УникальныйИдентификаторИсточника КАК Источник
		|ИЗ
		|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
		|ГДЕ
		|	Соотв.УникальныйИдентификаторПриемника = &UIDПриемника
		|	И Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20";
		ЗапросТип.УстановитьПараметр("UIDПриемника", СокрЛП(СтрДок.UIDДокументаБух));
		РезТип = ЗапросТип.Выполнить().Выбрать();
		Если РезТип.Следующий() Тогда
			ДокОбъект = РезТип.Источник.ПолучитьОбъект();
			Если ДокОбъект = Неопределено Тогда
				СтрДок.Статус = "ПОМИЛКА: Документ не знайдено в ЕРП";
				Возврат;
			КонецЕсли;
			Если ДокОбъект.Проведен Тогда
				СтрДок.Статус = "Вже проведений";
				Возврат;
			КонецЕсли;
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			СтрДок.Статус = "Проведено в ЕРП";
		Иначе
			СтрДок.Статус = "ПОМИЛКА: Відповідність не знайдена";
		КонецЕсли;
	Исключение
		СтрДок.Статус = "ПОМИЛКА проведення: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Поставити документ на обмін в BuhBud
//
Процедура ПоставитьНаОбменВBuhBud(V83, СтрДок, УзелОбмена)

	Если УзелОбмена = Неопределено Тогда
		СтрДок.Статус = "ПОМИЛКА: Вузол обміну не знайдено";
		Возврат;
	КонецЕсли;

	UIDСтрока = СокрЛП(СтрДок.UIDДокументаБух);
	Если НЕ ЗначениеЗаполнено(UIDСтрока) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа в BuhBud";
		Возврат;
	КонецЕсли;

	ТипПриемника = СокрЛП(СтрДок.ТипДокумента);

	СсылкаBuhBud = V83.Документы[ТипПриемника].ПолучитьСсылку(
		V83.NewObject("УникальныйИдентификатор", UIDСтрока));

	V83.ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, СсылкаBuhBud);
	СтрДок.Статус = "Зареєстровано на обмін в BuhBud";

КонецПроцедуры

// Перепровести документ в ЕРП: ОтменаПроведения + Проведення (UI-сесія, НЕ COM-перепровод).
//
Процедура ПерепровестиВЕРП(СтрДок)

	СсылкаДок = НайтиСсылкуЕРПДляПерепроведения(СтрДок);
	Если СсылкаДок = Неопределено Тогда
		СтрДок.Статус = "ПОМИЛКА: документ ЕРП не знайдено для перепроведення";
		Возврат;
	КонецЕсли;

	ДокОбъект = СсылкаДок.ПолучитьОбъект();
	Если ДокОбъект = Неопределено Тогда
		СтрДок.Статус = "ПОМИЛКА: документ ЕРП видалено (битий ref)";
		Возврат;
	КонецЕсли;

	Если ДокОбъект.Проведен Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ДокОбъект = СсылкаДок.ПолучитьОбъект();
	КонецЕсли;
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);

	СтрДок.Статус = "Перепроведено в ЕРП";

КонецПроцедуры

// Знайти посилання на документ ЕРП для перепроведення.
//
Функция НайтиСсылкуЕРПДляПерепроведения(СтрДок)

	Если ТипЗнч(СтрДок.ДокументЕРП) <> Тип("Строка")
		И ЗначениеЗаполнено(СтрДок.ДокументЕРП) Тогда
		Возврат СтрДок.ДокументЕРП;
	КонецЕсли;

	UIDБух = СокрЛП(СтрДок.UIDДокументаБух);
	Если ЗначениеЗаполнено(UIDБух) Тогда
		ЗапросСоотв = Новый Запрос;
		ЗапросСоотв.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Соотв.УникальныйИдентификаторИсточника КАК Источник
		|ИЗ
		|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
		|ГДЕ
		|	Соотв.УникальныйИдентификаторПриемника = &UIDПриемника
		|	И Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20";
		ЗапросСоотв.УстановитьПараметр("UIDПриемника", UIDБух);
		РезСоотв = ЗапросСоотв.Выполнить().Выбрать();
		Если РезСоотв.Следующий() Тогда
			Возврат РезСоотв.Источник;
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
