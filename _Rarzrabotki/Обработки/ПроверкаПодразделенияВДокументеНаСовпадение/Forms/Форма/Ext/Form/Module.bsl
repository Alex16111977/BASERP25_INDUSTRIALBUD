&НаСервере
Функция ПолучитьДокументыДляПроверкиПодразделения(ДатаНачала, ДатаОкончания) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Документы.Ссылка КАК Ссылка,
	|	Документы.Дата КАК Дата
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПриходныйКассовыйОрдер.Ссылка КАК Ссылка,
	|		ПриходныйКассовыйОрдер.Дата КАК Дата
	|	ИЗ
	|		Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|	ГДЕ
	|		ПриходныйКассовыйОрдер.Проведен
	|		И ПриходныйКассовыйОрдер.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		РасходныйКассовыйОрдер.Ссылка,
	|		РасходныйКассовыйОрдер.Дата
	|	ИЗ
	|		Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	|	ГДЕ
	|		РасходныйКассовыйОрдер.Проведен
	|		И РасходныйКассовыйОрдер.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		СписаниеБезналичныхДенежныхСредств.Ссылка,
	|		СписаниеБезналичныхДенежныхСредств.Дата
	|	ИЗ
	|		Документ.СписаниеБезналичныхДенежныхСредств КАК СписаниеБезналичныхДенежныхСредств
	|	ГДЕ
	|		СписаниеБезналичныхДенежныхСредств.Проведен
	|		И СписаниеБезналичныхДенежныхСредств.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ПоступлениеБезналичныхДенежныхСредств.Ссылка,
	|		ПоступлениеБезналичныхДенежныхСредств.Дата
	|	ИЗ
	|		Документ.ПоступлениеБезналичныхДенежныхСредств КАК ПоступлениеБезналичныхДенежныхСредств
	|	ГДЕ
	|		ПоступлениеБезналичныхДенежныхСредств.Проведен
	|		И ПоступлениеБезналичныхДенежныхСредств.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания) КАК Документы
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	Выборка = Запрос.Выполнить().Выбрать();
	МассивДокументов = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		ДанныеДокумента = Новый Структура;
		ДанныеДокумента.Вставить("Ссылка", Выборка.Ссылка);
		ДанныеДокумента.Вставить("Дата", Выборка.Дата);
		МассивДокументов.Добавить(ДанныеДокумента);
	КонецЦикла;
	
	Возврат МассивДокументов;

КонецФункции

&НаСервере
Процедура ОбработатьДокументДляПроверкиПодразделения(СсылкаНаДокумент) Экспорт
	
	Если Не ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		Возврат;
	КонецЕсли;
	
	Док = СсылкаНаДокумент.ПолучитьОбъект();
	Док.ОбменДанными.Загрузка = Истина;
	А_СобытияОбъектов.ПроверкаПодразделенияВДокументеНаСовпадение(Док);
	Док.Записать();

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаПодразделенияВДокументеНаСовпадение(Команда)
	
	ДатаНачала = Дата(2025, 12, 1);
	ДатаОкончания = Дата(2026, 12, 1);
	
	Документы = ПолучитьДокументыДляПроверкиПодразделения(ДатаНачала, ДатаОкончания);
	ВсегоДокументов = Документы.Количество();
	
	Если ВсегоДокументов = 0 Тогда
		Сообщить("Документы для обработки не найдены.");
		Возврат;
	КонецЕсли;
	
	Для Индекс = 0 По ВсегоДокументов - 1 Цикл
		
		ДанныеДокумента = Документы[Индекс];
		ОбработатьДокументДляПроверкиПодразделения(ДанныеДокумента.Ссылка);
		
		Обработано = Индекс + 1;
		Осталось = ВсегоДокументов - Обработано;
		Процент = Окр(Обработано / ВсегоДокументов * 100, 2);
		
		Состояние(
			"док: " + Строка(Обработано)
			+ " из " + Строка(ВсегоДокументов)
			+ " (" + Строка(Процент) + "%)"
			+ ", дата: " + Формат(ДанныеДокумента.Дата, "ДФ=dd.MM.yyyy")
			+ ", осталось: " + Строка(Осталось)
		);
		
	КонецЦикла;
	
	Сообщить("Обработка завершена. Всего обработано: " + Строка(ВсегоДокументов));

КонецПроцедуры
