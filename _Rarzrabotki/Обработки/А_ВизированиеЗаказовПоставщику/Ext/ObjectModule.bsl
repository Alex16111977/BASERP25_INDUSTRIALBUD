#Область ПрограммныйИнтерфейс

// Наполняет таблицу журнала визирования заказами поставщикам В КОНТУРЕ визирования.
//
// Заказы вне контура (обменные/исторические, с пустым А_Виза_Состояние) в журнал НЕ попадают.
//
// Параметры:
//  Отбор - Структура - все ключи опциональны:
//    * РежимОчереди        - Число  - 0 Все · 1 Мне на визирование · 2 Могу подписать заранее
//    * ТекущийПользователь - СправочникСсылка.Пользователи
//    * Подразделение       - СправочникСсылка.СтруктураПредприятия (в иерархии)
//    * Организация         - СправочникСсылка.Организации
//    * Партнер             - СправочникСсылка.Партнеры
//    * СостояниеВизы       - ПеречислениеСсылка.А_Визы_Состояния
//    * СтатусЗаказа        - ПеречислениеСсылка.СтатусыЗаказовПоставщикам
//    * Автор               - СправочникСсылка.Пользователи
//    * ДатаС, ДатаПо       - Дата
//    * ПоказыватьПомеченные - Булево
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки журнала.
//
Функция ЗаполнитьТаблицуЖурнала(Отбор = Неопределено) Экспорт

	П = ?(Отбор = Неопределено, Новый Структура, Отбор);

	РежимОчереди        = ЗначениеОтбора(П, "РежимОчереди", 0);
	ТекущийПользователь = ЗначениеОтбора(П, "ТекущийПользователь", Пользователи.ТекущийПользователь());
	ПоказыватьПомеченные = ЗначениеОтбора(П, "ПоказыватьПомеченные", Ложь);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номер КАК Номер,
	|	Т.Дата КАК Дата,
	|	Т.ПометкаУдаления КАК ПометкаУдаления,
	|	Т.Организация КАК Организация,
	|	Т.Подразделение КАК Подразделение,
	|	Т.Партнер КАК Партнер,
	|	Т.Контрагент КАК Контрагент,
	|	Т.СуммаДокумента КАК СуммаДокумента,
	|	Т.Статус КАК Статус,
	|	Т.Автор КАК Автор,
	|	Т.Менеджер КАК Менеджер,
	|	Т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Т.А_Виза_Состояние КАК ВизаСостояние,
	|	Т.А_Виза_ТекущаяРоль КАК ВизаТекущаяРоль,
	|	Т.А_Виза_ТекущиеВизирующие КАК ВизаТекущиеВизирующие,
	|	Т.А_Виза_Дата КАК ВизаДата,
	|	ВЫРАЗИТЬ(Т.Комментарий КАК СТРОКА(200)) КАК Комментарий
	|ИЗ
	|	Документ.ЗаказПоставщику КАК Т
	|ГДЕ
	|	Т.А_Виза_Состояние <> ЗНАЧЕНИЕ(Перечисление.А_Визы_Состояния.ПустаяСсылка)
	|	И (&РежимОчереди = 0
	|			И (&ПоказыватьПомеченные ИЛИ НЕ Т.ПометкаУдаления)
	|		ИЛИ &РежимОчереди = 1
	|			И Т.Ссылка В (ВЫБРАТЬ Т2.Ссылка ИЗ Документ.ЗаказПоставщику.А_ТекущиеВизирующие КАК Т2
	|							ГДЕ Т2.Пользователь = &ТекущийПользователь)
	|			И Т.А_Виза_Состояние = ЗНАЧЕНИЕ(Перечисление.А_Визы_Состояния.НаВизировании)
	|			И НЕ Т.ПометкаУдаления
	|		ИЛИ &РежимОчереди = 2
	|			И Т.Ссылка В (ВЫБРАТЬ Т3.Ссылка ИЗ Документ.ЗаказПоставщику.А_ПредварительныеВизы КАК Т3
	|							ГДЕ Т3.Пользователь = &ТекущийПользователь И НЕ Т3.Утверждено)
	|			И Т.А_Виза_Состояние = ЗНАЧЕНИЕ(Перечисление.А_Визы_Состояния.НаВизировании)
	|			И НЕ Т.ПометкаУдаления)
	|	//УсловияОтбора
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Дата УБЫВ";

	Запрос.УстановитьПараметр("РежимОчереди", РежимОчереди);
	Запрос.УстановитьПараметр("ТекущийПользователь", ТекущийПользователь);
	Запрос.УстановитьПараметр("ПоказыватьПомеченные", ПоказыватьПомеченные);

	ДобавитьУсловие(Запрос, П, "Подразделение", "Т.Подразделение В ИЕРАРХИИ (&Подразделение)");
	ДобавитьУсловие(Запрос, П, "Организация",   "Т.Организация = &Организация");
	ДобавитьУсловие(Запрос, П, "Партнер",       "Т.Партнер = &Партнер");
	ДобавитьУсловие(Запрос, П, "СостояниеВизы", "Т.А_Виза_Состояние = &СостояниеВизы");
	ДобавитьУсловие(Запрос, П, "СтатусЗаказа",  "Т.Статус = &СтатусЗаказа");
	ДобавитьУсловие(Запрос, П, "Автор",         "Т.Автор = &Автор");
	ДобавитьУсловие(Запрос, П, "ДатаС",         "Т.Дата >= &ДатаС");
	ДобавитьУсловие(Запрос, П, "ДатаПо",        "Т.Дата <= &ДатаПо");

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// История виз одного заказа — для master-detail панели.
//
// Параметры:
//  ДокСсылка - ДокументСсылка.ЗаказПоставщику
//
// Возвращаемое значение:
//  ТаблицаЗначений - Роль, Пользователь, ДатаВизы, Состояние, Авто, Комментарий.
//
Функция ЗаполнитьИсториюВиз(ДокСсылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Виз.Роль КАК Роль,
	|	Виз.Пользователь КАК Пользователь,
	|	Виз.ДатаВизы КАК ДатаВизы,
	|	Виз.Виза_Состояние КАК Состояние,
	|	Виз.Авто КАК Авто,
	|	ВЫРАЗИТЬ(Виз.Комментарий КАК СТРОКА(200)) КАК Комментарий
	|ИЗ
	|	Документ.ЗаказПоставщику.А_Визы КАК Виз
	|ГДЕ
	|	Виз.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Виз.НомерСтроки";

	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеОтбора(Отбор, Ключ, ПоУмолчанию)

	Значение = Неопределено;
	Если Отбор.Свойство(Ключ, Значение) И ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;

КонецФункции

// Добавляет условие в ГДЕ (перед маркером //УсловияОтбора), только если параметр заполнен.
//
Процедура ДобавитьУсловие(Запрос, Отбор, Ключ, ВыражениеУсловия)

	Значение = Неопределено;
	Если НЕ Отбор.Свойство(Ключ, Значение) ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловияОтбора",
		"И " + ВыражениеУсловия + "
		|	//УсловияОтбора");
	Запрос.УстановитьПараметр(Ключ, Значение);

КонецПроцедуры

#КонецОбласти
