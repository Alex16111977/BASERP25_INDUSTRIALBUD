#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура МассовоеДействие_ПослеПричины(Строка, Контекст) Экспорт
	Если Строка = Неопределено Тогда // отменено
		Возврат;
	КонецЕсли;
	Контекст.Причина = Строка;
	МассовоеДействие_Спросить(Контекст);
КонецПроцедуры

&НаКлиенте
Процедура МассовоеДействие_ПослеВопроса(Ответ, Контекст) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ОчиститьСообщения();
	Допы = Новый Структура;
	Если НЕ ПустаяСтрока(Контекст.Причина) Тогда
		Допы.Вставить("Виза_Причина", Контекст.Причина);
	КонецЕсли;
	Если Контекст.ИмяСостояния = "Предварительная" Тогда
		Допы.Вставить("ЭтоИзФормы", Истина);
	КонецЕсли;

	КоличествоОбработанных = А_ВизированиеВызовСервера.УстановитьВизуДокументов(
		Контекст.Ссылки, Контекст.ИмяСостояния, Допы);

	Элементы.Список.Обновить();
	ОповеститьОбИтоге(КоличествоОбработанных, Контекст.Ссылки.Количество(), Контекст.СтатусОповещения);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьПараметрыСписка()

	Список.Параметры.УстановитьЗначениеПараметра("РежимОчереди", РежимОчереди);
	Список.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь", Пользователи.ТекущийПользователь());
	Список.Параметры.УстановитьЗначениеПараметра("Состояние_НаВизировании",
		Перечисления.А_Визы_Состояния.НаВизировании);
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьПомеченные", ПоказыватьПомеченные);

КонецПроцедуры

&НаСервере
Процедура УстановитьПорядокСписка()

	Порядок = Список.КомпоновщикНастроек.Настройки.Порядок;
	Порядок.Элементы.Очистить();
	ЭлементПорядка = Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных("Дата");
	ЭлементПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
	ЭлементПорядка.Использование = Истина;

КонецПроцедуры

// Период — два отбора по одному полю «Дата» (>= и <=), поэтому типовой хелпер
// УстановитьЭлементОтбораДинамическогоСписка не подходит (ищет только по имени поля).
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборПериода(СписокДанные, НачалоПериода, КонецПериода)

	Отбор = СписокДанные.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
	УстановитьЭлементОтбораПериода(Отбор, ВидСравненияКомпоновкиДанных.БольшеИлиРавно,
		НачалоДня(НачалоПериода), ЗначениеЗаполнено(НачалоПериода));
	УстановитьЭлементОтбораПериода(Отбор, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,
		КонецДня(КонецПериода), ЗначениеЗаполнено(КонецПериода));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЭлементОтбораПериода(Отбор, ВидСравнения, Значение, Использование)

	ПолеДата = Новый ПолеКомпоновкиДанных("Дата");

	НайденныйЭлемент = Неопределено;
	Для Каждого ЭлементОтбора Из Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных")
			И ЭлементОтбора.ЛевоеЗначение = ПолеДата
			И ЭлементОтбора.ВидСравнения = ВидСравнения Тогда
			НайденныйЭлемент = ЭлементОтбора;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НайденныйЭлемент = Неопределено Тогда
		НайденныйЭлемент = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НайденныйЭлемент.ЛевоеЗначение = ПолеДата;
		НайденныйЭлемент.ВидСравнения = ВидСравнения;
		НайденныйЭлемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	КонецЕсли;

	НайденныйЭлемент.ПравоеЗначение = Значение;
	НайденныйЭлемент.Использование = Использование;

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьВыделенное()

	// У динамического списка ВыделенныеСтроки — ссылки; данные — через ДанныеСтроки().
	Сумма = 0;
	Количество = 0;
	Для Каждого ВыделеннаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		ДанныеСтроки = Элементы.Список.ДанныеСтроки(ВыделеннаяСтрока);
		Если ДанныеСтроки <> Неопределено Тогда
			Сумма = Сумма + ДанныеСтроки.СуммаДокумента;
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Если Количество > 1 Тогда
		Выделено = СтрШаблон(НСтр("ru='Всего выбрано %1: Сумма %2'"),
			Количество, Формат(Сумма, "ЧДЦ=2; ЧРГ= "));
	Иначе
		Выделено = "";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИсториюВизОжидание()

	ТекущаяСсылка = Элементы.Список.ТекущаяСтрока;
	Если ТекущаяСсылка = Неопределено ИЛИ ТипЗнч(ТекущаяСсылка) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		ИсторияВиз.Очистить();
	Иначе
		ОбновитьИсториюВизНаСервере(ТекущаяСсылка);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьИсториюВизНаСервере(ДокСсылка)
	Обработка = РеквизитФормыВЗначение("Объект");
	ИсторияВиз.Загрузить(Обработка.ЗаполнитьИсториюВиз(ДокСсылка));
КонецПроцедуры

&НаКлиенте
Процедура НачатьМассовоеДействие(ИмяСостояния, СтатусОповещения, ТекстВопроса, ЗапроситьПричину)

	Ссылки = ОбщегоНазначенияУТКлиент.ПроверитьПолучитьВыделенныеВСпискеСсылки(Элементы.Список);
	Если Ссылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Контекст = Новый Структура("ИмяСостояния, СтатусОповещения, ТекстВопроса, Ссылки, Причина",
		ИмяСостояния, СтатусОповещения, ТекстВопроса, Ссылки, "");

	Если ЗапроситьПричину Тогда
		ПоказатьВводСтроки(Новый ОписаниеОповещения("МассовоеДействие_ПослеПричины", ЭтотОбъект, Контекст),
			, НСтр("ru='Укажите причину'"), 0, Ложь);
	Иначе
		МассовоеДействие_Спросить(Контекст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура МассовоеДействие_Спросить(Контекст)
	ТекстВопроса = СтрШаблон(НСтр("ru='%1 (заказов: %2)'"),
		Контекст.ТекстВопроса, Контекст.Ссылки.Количество());
	ПоказатьВопрос(Новый ОписаниеОповещения("МассовоеДействие_ПослеВопроса", ЭтотОбъект, Контекст),
		ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
КонецПроцедуры

&НаКлиенте
Процедура ОповеститьОбИтоге(Обработано, Всего, Статус)
	Если Обработано > 0 Тогда
		Текст = СтрШаблон(НСтр("ru='Для %1 из %2 заказов установлено состояние ""%3""'"), Обработано, Всего, Статус);
	Иначе
		Текст = СтрШаблон(НСтр("ru='Состояние ""%1"" не установлено ни для одного заказа (см. сообщения).'"), Статус);
	КонецЕсли;
	ПоказатьОповещениеПользователя(НСтр("ru='Визирование'"), , Текст);
КонецПроцедуры

// Подсветка строк журнала по состоянию визы — ТОЛЬКО кодом через компоновщик
// динамического списка (ЕРП-паттерн ФормаСпискаЗаявокКСогласованию).
&НаСервере
Процедура УстановитьУсловноеОформление()

	СписокОформление = Список.КомпоновщикНастроек.Настройки.УсловноеОформление;
	СписокОформление.Элементы.Очистить();

	ДобавитьОформлениеСостояния(СписокОформление, Перечисления.А_Визы_Состояния.НаВизировании,
		"ЦветФона", Новый Цвет(255, 248, 220));   // светло-жёлтый фон
	ДобавитьОформлениеСостояния(СписокОформление, Перечисления.А_Визы_Состояния.Утвержден,
		"ЦветФона", Новый Цвет(214, 240, 214));   // зелёный фон
	ДобавитьОформлениеСостояния(СписокОформление, Перечисления.А_Визы_Состояния.УтвержденСКомментариями,
		"ЦветФона", Новый Цвет(214, 240, 214));
	ДобавитьОформлениеСостояния(СписокОформление, Перечисления.А_Визы_Состояния.Отклонено,
		"ЦветТекста", ЦветаСтиля.ПросроченныйДокумент);   // красный текст
	ДобавитьОформлениеСостояния(СписокОформление, Перечисления.А_Визы_Состояния.Анулировано,
		"ЦветТекста", ЦветаСтиля.ЗакрытыйДокумент);       // серый текст

КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеСостояния(СписокОформление, Состояние, ИмяПараметра, Цвет)

	Элемент = СписокОформление.Элементы.Добавить();

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВизаСостояние");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Состояние;

	Элемент.Оформление.УстановитьЗначениеПараметра(ИмяПараметра, Цвет);

КонецПроцедуры

#КонецОбласти
