#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РежимОчереди = 1; // по умолчанию — «Мне на визирование»
	УстановитьПараметрыСписка();
	УстановитьПорядокСписка();
	УстановитьУсловноеОформление();

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	// Отборы сохраняются между сеансами (паттерн ФормаСпискаЗаявокКСогласованию).
	ОтборыСписковКлиентСервер.ОтборПоЗначениюСпискаПриЗагрузкеИзНастроек(
		Список, "Подразделение", Подразделение, Неопределено, Настройки,
		, ВидСравненияКомпоновкиДанных.ВИерархии);
	ОтборыСписковКлиентСервер.ОтборПоЗначениюСпискаПриЗагрузкеИзНастроек(
		Список, "Организация", Организация, Неопределено, Настройки);
	ОтборыСписковКлиентСервер.ОтборПоЗначениюСпискаПриЗагрузкеИзНастроек(
		Список, "Партнер", Партнер, Неопределено, Настройки);
	ОтборыСписковКлиентСервер.ОтборПоЗначениюСпискаПриЗагрузкеИзНастроек(
		Список, "Автор", Автор, Неопределено, Настройки);
	ОтборыСписковКлиентСервер.ОтборПоЗначениюСпискаПриЗагрузкеИзНастроек(
		Список, "ВизаСостояние", ВизаСостояние, Неопределено, Настройки);
	ОтборыСписковКлиентСервер.ОтборПоЗначениюСпискаПриЗагрузкеИзНастроек(
		Список, "Статус", Статус, Неопределено, Настройки);

	ЗначениеНастройки = Настройки.Получить("ДатаС");
	Если ЗначениеНастройки <> Неопределено Тогда
		ДатаС = ЗначениеНастройки;
	КонецЕсли;
	ЗначениеНастройки = Настройки.Получить("ДатаПо");
	Если ЗначениеНастройки <> Неопределено Тогда
		ДатаПо = ЗначениеНастройки;
	КонецЕсли;
	УстановитьОтборПериода(Список, ДатаС, ДатаПо);

	ЗначениеНастройки = Настройки.Получить("ПоказыватьПомеченные");
	Если ЗначениеНастройки <> Неопределено Тогда
		ПоказыватьПомеченные = ЗначениеНастройки;
	КонецЕсли;
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьПомеченные", ПоказыватьПомеченные);

КонецПроцедуры

#КонецОбласти

