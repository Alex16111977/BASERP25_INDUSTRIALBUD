	<Attributes>
		<Attribute name="Объект" id="1">
			<Type>
				<v8:Type>cfg:ExternalDataProcessorObject.А_ВизированиеЗаказовПоставщику</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
		</Attribute>
		<Attribute name="Список" id="2">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Список</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	Т.Ссылка КАК Ссылка,
	Т.Номер КАК Номер,
	Т.Дата КАК Дата,
	Т.ПометкаУдаления КАК ПометкаУдаления,
	Т.Организация КАК Организация,
	Т.Подразделение КАК Подразделение,
	Т.Партнер КАК Партнер,
	Т.Контрагент КАК Контрагент,
	Т.СуммаДокумента КАК СуммаДокумента,
	Т.Статус КАК Статус,
	Т.Автор КАК Автор,
	Т.Менеджер КАК Менеджер,
	Т.НаправлениеДеятельности КАК НаправлениеДеятельности,
	Т.А_Виза_Состояние КАК ВизаСостояние,
	Т.А_Виза_ТекущаяРоль КАК ВизаТекущаяРоль,
	Т.А_Виза_ТекущиеВизирующие КАК ВизаТекущиеВизирующие,
	Т.А_Виза_Дата КАК ВизаДата,
	ВЫРАЗИТЬ(Т.Комментарий КАК СТРОКА(200)) КАК Комментарий
ИЗ
	Документ.ЗаказПоставщику КАК Т
ГДЕ
	Т.А_Виза_Состояние &lt;&gt; ЗНАЧЕНИЕ(Перечисление.А_Визы_Состояния.ПустаяСсылка)
	И (&amp;РежимОчереди = 0
			И (&amp;ПоказыватьПомеченные ИЛИ НЕ Т.ПометкаУдаления)
		ИЛИ &amp;РежимОчереди = 1
			И Т.Ссылка В (ВЫБРАТЬ Т2.Ссылка ИЗ Документ.ЗаказПоставщику.А_ТекущиеВизирующие КАК Т2
							ГДЕ Т2.Пользователь = &amp;ТекущийПользователь)
			И Т.А_Виза_Состояние = &amp;Состояние_НаВизировании
			И НЕ Т.ПометкаУдаления
		ИЛИ &amp;РежимОчереди = 2
			И Т.Ссылка В (ВЫБРАТЬ Т3.Ссылка ИЗ Документ.ЗаказПоставщику.А_ПредварительныеВизы КАК Т3
							ГДЕ Т3.Пользователь = &amp;ТекущийПользователь И НЕ Т3.Утверждено)
			И Т.А_Виза_Состояние = &amp;Состояние_НаВизировании
			И НЕ Т.ПометкаУдаления)</QueryText>
				<MainTable>Document.ЗаказПоставщику</MainTable>
			</Settings>
		</Attribute>
		<Attribute name="РежимОчереди" id="3">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Режим очереди</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>xs:decimal</v8:Type>
				<v8:NumberQualifiers>
					<v8:Digits>1</v8:Digits>
					<v8:FractionDigits>0</v8:FractionDigits>
					<v8:AllowedSign>Nonnegative</v8:AllowedSign>
				</v8:NumberQualifiers>
			</Type>
		</Attribute>
