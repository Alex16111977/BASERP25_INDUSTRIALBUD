
&НаКлиенте
Процедура АнализДокументов(Команда)
	АнализДокументовНаСервере();
КонецПроцедуры

&НаСервере
Процедура АнализДокументовНаСервере()
	мОбъект = РеквизитФормыВЗначение("Объект");
	мОбъект.АнализДокументов();
	ЗначениеВРеквизитФормы(мОбъект, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументы(Команда)
	СоздатьДокументыНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыНаСервере()
	мОбъект = РеквизитФормыВЗначение("Объект");
	мОбъект.СоздатьДокументы();
	ЗначениеВРеквизитФормы(мОбъект, "Объект");
КонецПроцедуры
