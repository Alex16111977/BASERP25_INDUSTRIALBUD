// ============================================================================
// А_ОбработкаДисбалансаПоПодразделениям — Модуль объекта
// ============================================================================
// Масовий аналіз дисбалансу управлінського балансу по підрозділах за період.
// Запускається після закриття місяця (РасчетСебестоимости виконаний,
// баланс по організації сходиться, залишилось звести по підрозділах).
//
// Кнопка "Аналіз документів": заповнює ТЧ ДокументыДисбаланса
// Кнопка "Створити документи": для кожного необробленого рядка
//   викликає Обработки.А_ДвижениеПоВзаимозачетПоБалансуУпр
// ============================================================================

Процедура АнализДокументов() Экспорт

	ДокументыДисбаланса.Очистить();

	Если НЕ ЗначениеЗаполнено(НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(ОкончаниеПериода) Тогда
		Сообщить("Не заполнен период!");
		Возврат;
	КонецЕсли;

	// === 1. Запит оборотів за період по Регистратор + Подразделение ===
	// (як звіт УправленческийБалансКонтроль, через віртуальну таблицю Обороты)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Об.Регистратор КАК Документ,
	|	Об.Подразделение КАК Подразделение,
	|	Об.Организация КАК Организация,
	|	Об.СуммаПриход КАК Дебет,
	|	Об.СуммаРасход КАК Кредит,
	|	Об.СуммаПриход - Об.СуммаРасход КАК Контроль
	|ИЗ
	|	РегистрНакопления.ПрочиеАктивыПассивы.Обороты(
	|		&НачалоПериода, &ОкончаниеПериода, Регистратор, ) КАК Об
	|ГДЕ
	|	НЕ Об.Статья В (
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ВложенияСобственныхСредств),
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ВыводСобственныхСредств))
	|УПОРЯДОЧИТЬ ПО
	|	Об.Регистратор";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ОкончаниеПериода));

	ТаблицаОборотов = Запрос.Выполнить().Выгрузить();
	Сообщить("Обороты: " + ТаблицаОборотов.Количество() + " строк");

	// === 2. Групування по Регистратору і аналіз ===

	СоответствиеДокументов = Новый Соответствие; // XML(Документ) -> Структура
	ДокументыСДисбалансом = Новый Соответствие;  // XML(Документ) -> Истина

	// Групування: Документ -> Підрозділ -> СУМА(Контроль)
	// Обороты повертає окремі рядки по Статтях — потрібно підсумувати по підрозділу
	Для Каждого Строка Из ТаблицаОборотов Цикл
		КлючДок = XMLСтрока(Строка.Документ);

		Если СоответствиеДокументов.Получить(КлючДок) = Неопределено Тогда
			СоответствиеДокументов.Вставить(КлючДок, Новый Структура(
				"ДокументСсылка, Организация, ПодразделенияСоотв",
				Строка.Документ, Строка.Организация, Новый Соответствие));
		КонецЕсли;

		Данные = СоответствиеДокументов.Получить(КлючДок);
		КлючПодр = XMLСтрока(Строка.Подразделение);
		СущПодр = Данные.ПодразделенияСоотв.Получить(КлючПодр);
		Если СущПодр = Неопределено Тогда
			Данные.ПодразделенияСоотв.Вставить(КлючПодр, Новый Структура(
				"Подразделение, Контроль", Строка.Подразделение, Строка.Контроль));
		Иначе
			СущПодр.Контроль = СущПодр.Контроль + Строка.Контроль;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Уникальных документов: " + СоответствиеДокументов.Количество());

	// === 3. Фільтрація: баланс по орг = 0 + дисбаланс по підрозділах ===

	Для Каждого КлючЗначение Из СоответствиеДокументов Цикл
		Данные = КлючЗначение.Значение;
		ПодразделенияСоотв = Данные.ПодразделенияСоотв; // Соответствие: XML(Подр) -> {Подразделение, Контроль}

		// Пропустити авто-створені взаємозаліки (з заповненим А_ДокументОснованиеДляБаланса)
		// Ручні взаємозаліки (без А_ДокОснование) — аналізуються як звичайні документи
		ДокСсылка = Данные.ДокументСсылка;
		Если ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.ВзаимозачетЗадолженности") Тогда
			Если ЗначениеЗаполнено(ДокСсылка.А_ДокументОснованиеДляБаланса) Тогда
				Продолжить; // Авто-створений — пропустити
			КонецЕсли;
		КонецЕсли;

		// Сума контролю по всіх підрозділах (баланс орг)
		ИтогоКонтроль = 0;
		Для Каждого КЗП Из ПодразделенияСоотв Цикл
			ИтогоКонтроль = ИтогоКонтроль + КЗП.Значение.Контроль;
		КонецЦикла;

		// Баланс по організації має сходитись
		Если Окр(ИтогоКонтроль, 2) <> 0 Тогда
			Продолжить;
		КонецЕсли;

		// Мінімум 2 підрозділи з дисбалансом
		КолДисб = 0;
		Для Каждого КЗП Из ПодразделенияСоотв Цикл
			Если Окр(КЗП.Значение.Контроль, 2) <> 0 Тогда
				КолДисб = КолДисб + 1;
			КонецЕсли;
		КонецЦикла;

		Если КолДисб < 2 Тогда
			Продолжить;
		КонецЕсли;

		// Знайти дебітора (макс Контроль > 0) і кредитора (мін Контроль < 0)
		ПодрДебитор = Неопределено;
		ПодрКредитор = Неопределено;
		МаксК = 0;
		МинК = 0;
		Для Каждого КЗП Из ПодразделенияСоотв Цикл
			П = КЗП.Значение;
			Если П.Контроль > МаксК Тогда
				ПодрДебитор = П.Подразделение;
				МаксК = П.Контроль;
			КонецЕсли;
			Если П.Контроль < МинК Тогда
				ПодрКредитор = П.Подразделение;
				МинК = П.Контроль;
			КонецЕсли;
		КонецЦикла;

		Если ПодрДебитор = Неопределено ИЛИ ПодрКредитор = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Пропустити якщо дебітор = кредитор (внутрішній дисбаланс одного підрозділу)
		Если ПодрДебитор = ПодрКредитор Тогда
			Продолжить;
		КонецЕсли;

		// Фільтр по підрозділу (якщо вибрано) — після визначення сторін
		Если ЗначениеЗаполнено(Подразделение) Тогда
			Если ПодрДебитор <> Подразделение И ПодрКредитор <> Подразделение Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		ДокументыСДисбалансом.Вставить(КлючЗначение.Ключ, Истина);

		// === 4. Знайти існуючий Взаємозалік ===
		ДокОснование = Данные.ДокументСсылка;
		СуммаДисбаланса = МаксК;

		СущВзаимозачет = НайтиСуществующийВзаимозачет(ДокОснование);

		// === 5. Визначити статус ===
		ВзаимозачетСсылка = Неопределено;
		СуммаВзаимозачета = 0;
		Обработан = Ложь;

		РасхождениеДог = Ложь;

		Если ЗначениеЗаполнено(СущВзаимозачет) Тогда
			ВзаимозачетСсылка = СущВзаимозачет;
			СуммаВзаимозачета = СущВзаимозачет.СуммаРегл;

			// Перевірити договори: А_ПодрОказанияУслуг має бути заповнений
			РасхождениеДог = ПроверитьДоговорыВзаимозачета(СущВзаимозачет, ПодрДебитор, ПодрКредитор);

			// Порівняти суму — якщо збігається І документ проведений І договори ОК
			Если СущВзаимозачет.Проведен И Окр(СуммаВзаимозачета - СуммаДисбаланса, 2) = 0 И НЕ РасхождениеДог Тогда
				Обработан = Истина;
			КонецЕсли;
		КонецЕсли;

		// Якщо галочка "Показывать все" знята — пропускаємо оброблені
		Если НЕ ПоказыватьВсе И Обработан Тогда
			Продолжить;
		КонецЕсли;

		// === 6. Визначити СтатьяДисбаланса ===
		СтатьяДисбаланса = ОпределитьСтатьюДисбаланса(ДокОснование, ПодрДебитор, ПодрКредитор);

		// === 7. Заповнити рядок ТЧ ===
		НС = ДокументыДисбаланса.Добавить();
		НС.Обработан = Обработан;
		НС.Документ = ДокОснование;
		НС.ПодразделениеПриход = ПодрДебитор;
		НС.ПодразделениеРасход = ПодрКредитор;
		НС.СуммаДокумента = СуммаДисбаланса;
		НС.ДокВзаимозачетЗадолженности = ВзаимозачетСсылка;
		НС.СуммаВзаимозачета = СуммаВзаимозачета;
		НС.СтатьяДисбаланса = СтатьяДисбаланса;
		НС.СуммаРасхождение = СуммаДисбаланса - СуммаВзаимозачета;
		НС.РасхождениеДоговор = РасхождениеДог;
	КонецЦикла;

	// === 8. Знайти "зайві" Взаємозаліки (документ-основа більше не має дисбалансу) ===
	// Якщо документ-джерело розпроведений/видалений, а Взаємозалік залишився — потрібно розпровести

	ЗапросЗайвих = Новый Запрос;
	ЗапросЗайвих.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.А_ДокументОснованиеДляБаланса КАК ДокОснование,
	|	Док.СуммаРегл КАК СуммаРегл,
	|	Док.А_СтатьяДисбалансаПоПодразделению КАК СтатьяДисбаланса,
	|	Док.КонтрагентДебитор КАК КонтрагентДебитор,
	|	Док.КонтрагентКредитор КАК КонтрагентКредитор
	|ИЗ
	|	Документ.ВзаимозачетЗадолженности КАК Док
	|ГДЕ
	|	Док.Дата МЕЖДУ &Нач И &Кон
	|	И Док.А_ДокументОснованиеДляБаланса <> НЕОПРЕДЕЛЕНО
	|	И Док.Проведен
	|	И НЕ Док.ПометкаУдаления";
	ЗапросЗайвих.УстановитьПараметр("Нач", НачалоПериода);
	ЗапросЗайвих.УстановитьПараметр("Кон", КонецДня(ОкончаниеПериода));

	ВыбЗайвих = ЗапросЗайвих.Выполнить().Выбрать();
	КолЗайвих = 0;

	Пока ВыбЗайвих.Следующий() Цикл
		КлючДокОсн = XMLСтрока(ВыбЗайвих.ДокОснование);

		// Зайвий = документ-основа НЕ в списку дисбалансів (зник дисбаланс)
		Если ДокументыСДисбалансом.Получить(КлючДокОсн) <> Неопределено Тогда
			Продолжить; // документ ще має дисбаланс — це не зайвий
		КонецЕсли;

		// Фільтр по підрозділу
		Если ЗначениеЗаполнено(Подразделение) Тогда
			ИмяПодр = Строка(Подразделение);
			ИмяДеб = "";
			ИмяКред = "";
			Если ЗначениеЗаполнено(ВыбЗайвих.КонтрагентДебитор) Тогда
				ИмяДеб = Строка(ВыбЗайвих.КонтрагентДебитор);
			КонецЕсли;
			Если ЗначениеЗаполнено(ВыбЗайвих.КонтрагентКредитор) Тогда
				ИмяКред = Строка(ВыбЗайвих.КонтрагентКредитор);
			КонецЕсли;
			Если ИмяДеб <> ИмяПодр И ИмяКред <> ИмяПодр Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		// Визначити підрозділи через рухи документа-основи
		ПодрДебЗайв = Неопределено;
		ПодрКредЗайв = Неопределено;
		Если ЗначениеЗаполнено(ВыбЗайвих.ДокОснование) Тогда
			ЗапросПодр = Новый Запрос;
			ЗапросПодр.Текст =
			"ВЫБРАТЬ
			|	Об.Подразделение КАК Подразделение,
			|	Об.СуммаПриход - Об.СуммаРасход КАК Контроль
			|ИЗ
			|	РегистрНакопления.ПрочиеАктивыПассивы.Обороты(, , Регистратор, ) КАК Об
			|ГДЕ
			|	Об.Регистратор = &Рег
			|	И НЕ Об.Статья В (
			|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ВложенияСобственныхСредств),
			|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ВыводСобственныхСредств))";
			ЗапросПодр.УстановитьПараметр("Рег", ВыбЗайвих.ДокОснование);
			ВыбПодр = ЗапросПодр.Выполнить().Выбрать();
			МаксКЗ = 0;
			МинКЗ = 0;
			Пока ВыбПодр.Следующий() Цикл
				Если ВыбПодр.Контроль > МаксКЗ Тогда
					ПодрДебЗайв = ВыбПодр.Подразделение;
					МаксКЗ = ВыбПодр.Контроль;
				КонецЕсли;
				Если ВыбПодр.Контроль < МинКЗ Тогда
					ПодрКредЗайв = ВыбПодр.Подразделение;
					МинКЗ = ВыбПодр.Контроль;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		НС = ДокументыДисбаланса.Добавить();
		НС.Обработан = Ложь; // Потрібно розпровести зайвий Взаємозалік
		НС.Документ = ВыбЗайвих.ДокОснование;
		НС.ПодразделениеПриход = ПодрДебЗайв;
		НС.ПодразделениеРасход = ПодрКредЗайв;
		НС.СуммаДокумента = 0; // Дисбаланс зник
		НС.ДокВзаимозачетЗадолженности = ВыбЗайвих.Ссылка;
		НС.СуммаВзаимозачета = ВыбЗайвих.СуммаРегл;
		НС.СтатьяДисбаланса = ВыбЗайвих.СтатьяДисбаланса;
		НС.СуммаРасхождение = 0 - ВыбЗайвих.СуммаРегл; // Дисбаланс зник, розходження = -СуммаВзаємозаліку
		КолЗайвих = КолЗайвих + 1;
	КонецЦикла;

	// === 9. Статистика ===
	КолНових = 0;
	КолОК = 0;
	КолПереформ = 0;
	КолРасхДог = 0;
	Для Каждого Стр Из ДокументыДисбаланса Цикл
		Если Стр.РасхождениеДоговор Тогда
			КолРасхДог = КолРасхДог + 1;
		КонецЕсли;
		Если Стр.Обработан Тогда
			КолОК = КолОК + 1;
		ИначеЕсли НЕ ЗначениеЗаполнено(Стр.ДокВзаимозачетЗадолженности) И Стр.СуммаДокумента > 0 Тогда
			КолНових = КолНових + 1;
		Иначе
			КолПереформ = КолПереформ + 1;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Результат анализа за " + Формат(НачалоПериода, "ДЛФ=D") + " - " + Формат(ОкончаниеПериода, "ДЛФ=D") + ":");
	Сообщить("  Всего документов с дисбалансом: " + ДокументыДисбаланса.Количество());
	Сообщить("  Обработано (ОК): " + КолОК);
	Сообщить("  Новых (создать): " + КолНових);
	Сообщить("  Переформировать: " + КолПереформ);
	Сообщить("  Зайвих (распровести): " + КолЗайвих);
	Если КолРасхДог > 0 Тогда
		Сообщить("  Расхождение договоров: " + КолРасхДог + " (нет А_ПодразделениеОказаниеУслугПодразделению)");
	КонецЕсли;

КонецПроцедуры


Процедура СоздатьДокументы() Экспорт

	КолСоздано = 0;
	КолПереформ = 0;
	КолРаспров = 0;
	КолОшибок = 0;

	Для Каждого Стр Из ДокументыДисбаланса Цикл
		Если Стр.Обработан Тогда
			Продолжить;
		КонецЕсли;

		Если Стр.СуммаДокумента = 0 И ЗначениеЗаполнено(Стр.ДокВзаимозачетЗадолженности) Тогда
			// Дисбаланс зник — розпровести зайвий Взаємозалік
			Попытка
				ДокОбъект = Стр.ДокВзаимозачетЗадолженности.ПолучитьОбъект();
				Если ДокОбъект.Проведен Тогда
					ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					Сообщить("Распроведен зайвий: " + Стр.ДокВзаимозачетЗадолженности);
					КолРаспров = КолРаспров + 1;
				КонецЕсли;
				Стр.Обработан = Истина;
			Исключение
				Сообщить("ОШИБКА распроведения: " + ОписаниеОшибки());
				КолОшибок = КолОшибок + 1;
			КонецПопытки;
		Иначе
			// Створити/переформувати Взаємозалік через А_ДвижениеПоВзаимозачетПоБалансуУпр
			Попытка
				Обработка = Обработки.А_ДвижениеПоВзаимозачетПоБалансуУпр.Создать();
				Обработка.ДокументОснование = Стр.Документ;
				Обработка.СформироватьВзаимозачетНаСервере();

				// Оновити рядок — знайти створений/оновлений Взаємозалік
				СущВз = НайтиСуществующийВзаимозачет(Стр.Документ);
				Если ЗначениеЗаполнено(СущВз) Тогда
					Стр.ДокВзаимозачетЗадолженности = СущВз;
					Стр.СуммаВзаимозачета = СущВз.СуммаРегл;
					Стр.СуммаРасхождение = Стр.СуммаДокумента - СущВз.СуммаРегл;
					Стр.РасхождениеДоговор = ПроверитьДоговорыВзаимозачета(
						СущВз, Стр.ПодразделениеПриход, Стр.ПодразделениеРасход);
				КонецЕсли;

				Стр.Обработан = Истина;

				Если ЗначениеЗаполнено(Стр.ДокВзаимозачетЗадолженности) Тогда
					КолСоздано = КолСоздано + 1;
				КонецЕсли;
			Исключение
				Сообщить("ОШИБКА для " + Стр.Документ + ": " + ОписаниеОшибки());
				КолОшибок = КолОшибок + 1;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Результат создания документов:");
	Сообщить("  Создано/переформировано: " + КолСоздано);
	Сообщить("  Распроведено зайвих: " + КолРаспров);
	Если КолОшибок > 0 Тогда
		Сообщить("  Ошибок: " + КолОшибок);
	КонецЕсли;

КонецПроцедуры


// ===== Допоміжні функції =====

Функция НайтиСуществующийВзаимозачет(ДокОснование)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВзаимозачетЗадолженности КАК Док
	|ГДЕ
	|	Док.А_ДокументОснованиеДляБаланса = &ДокОснование
	|	И НЕ Док.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДокОснование", ДокОснование);

	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выб = Результат.Выбрать();
		Выб.Следующий();
		Возврат Выб.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ОпределитьСтатьюДисбаланса(ДокОснование, ПодрДебитор, ПодрКредитор)

	// Стаття дебітора: макс Контроль > 0
	ЗапросСтДеб = Новый Запрос;
	ЗапросСтДеб.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Об.Статья КАК Статья
	|ИЗ
	|	РегистрНакопления.ПрочиеАктивыПассивы.Обороты(, , Регистратор, ) КАК Об
	|ГДЕ
	|	Об.Регистратор = &Регистратор
	|	И Об.Подразделение = &Подразделение
	|	И НЕ Об.Статья В (
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ВложенияСобственныхСредств),
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ВыводСобственныхСредств))
	|УПОРЯДОЧИТЬ ПО
	|	Об.СуммаПриход - Об.СуммаРасход УБЫВ";
	ЗапросСтДеб.УстановитьПараметр("Регистратор", ДокОснование);
	ЗапросСтДеб.УстановитьПараметр("Подразделение", ПодрДебитор);

	СтатьяДебитора = Неопределено;
	ВыбДеб = ЗапросСтДеб.Выполнить().Выбрать();
	Если ВыбДеб.Следующий() Тогда
		СтатьяДебитора = ВыбДеб.Статья;
	КонецЕсли;

	// Стаття кредитора: макс |Контроль| < 0
	ЗапросСтКред = Новый Запрос;
	ЗапросСтКред.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Об.Статья КАК Статья
	|ИЗ
	|	РегистрНакопления.ПрочиеАктивыПассивы.Обороты(, , Регистратор, ) КАК Об
	|ГДЕ
	|	Об.Регистратор = &Регистратор
	|	И Об.Подразделение = &Подразделение
	|	И НЕ Об.Статья В (
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ВложенияСобственныхСредств),
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ВыводСобственныхСредств))
	|УПОРЯДОЧИТЬ ПО
	|	Об.СуммаПриход - Об.СуммаРасход ВОЗР";
	ЗапросСтКред.УстановитьПараметр("Регистратор", ДокОснование);
	ЗапросСтКред.УстановитьПараметр("Подразделение", ПодрКредитор);

	СтатьяКредитора = Неопределено;
	ВыбКред = ЗапросСтКред.Выполнить().Выбрать();
	Если ВыбКред.Следующий() Тогда
		СтатьяКредитора = ВыбКред.Статья;
	КонецЕсли;

	// Знайти/створити елемент довідника А_ДисбалансПоПодразделению
	Если ЗначениеЗаполнено(СтатьяДебитора) И ЗначениеЗаполнено(СтатьяКредитора) Тогда
		Возврат НайтиИлиСоздатьДисбалансПоПодразделению(СтатьяДебитора, СтатьяКредитора);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция НайтиИлиСоздатьДисбалансПоПодразделению(СтатьяДебитора, СтатьяКредитора)

	СписокСтатей = Новый СписокЗначений;
	СписокСтатей.Добавить(СтатьяДебитора);
	СписокСтатей.Добавить(СтатьяКредитора);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЧ.Ссылка КАК Элемент,
	|	КОЛИЧЕСТВО(ТЧ.НомерСтроки) КАК КолСтрок,
	|	СУММА(ВЫБОР
	|		КОГДА ТЧ.Статья В (&СписокСтатей)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК Совпадений
	|ИЗ
	|	Справочник.А_ДисбалансПоПодразделению.СтатьиБаланса КАК ТЧ
	|ГДЕ
	|	НЕ ТЧ.Ссылка.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	ТЧ.Ссылка";
	Запрос.УстановитьПараметр("СписокСтатей", СписокСтатей);

	Выб = Запрос.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Если Выб.КолСтрок = 2 И Выб.Совпадений = 2 Тогда
			Возврат Выб.Элемент;
		КонецЕсли;
	КонецЦикла;

	// Створити новий
	Попытка
		НовыйЭл = Справочники.А_ДисбалансПоПодразделению.СоздатьЭлемент();
		НовыйЭл.Наименование = Строка(СтатьяДебитора) + " - " + Строка(СтатьяКредитора);
		Стр1 = НовыйЭл.СтатьиБаланса.Добавить();
		Стр1.Статья = СтатьяДебитора;
		Стр2 = НовыйЭл.СтатьиБаланса.Добавить();
		Стр2.Статья = СтатьяКредитора;
		НовыйЭл.Записать();
		Возврат НовыйЭл.Ссылка;
	Исключение
		Сообщить("Ошибка создания элемента дисбаланса: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Перевірка договорів взаємозаліку: А_ПодразделениеОказаниеУслугПодразделению
// Дебітор: договір має А_ПодрОказ = ПодрКредитор (протилежна сторона)
// Кредитор: договір має А_ПодрОказ = ПодрДебитор (протилежна сторона)
// Повертає Істина якщо є розходження
Функция ПроверитьДоговорыВзаимозачета(ВзаимозачетСсылка, ПодрДебитор, ПодрКредитор)

	// Перевірка дебіторської сторони
	ЗапросДеб = Новый Запрос;
	ЗапросДеб.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДЗ.ОбъектРасчетов КАК ОР
	|ИЗ
	|	Документ.ВзаимозачетЗадолженности.ДебиторскаяЗадолженность КАК ДЗ
	|ГДЕ
	|	ДЗ.Ссылка = &Вз";
	ЗапросДеб.УстановитьПараметр("Вз", ВзаимозачетСсылка);

	РезДеб = ЗапросДеб.Выполнить().Выбрать();
	Если РезДеб.Следующий() И ЗначениеЗаполнено(РезДеб.ОР) Тогда
		ДоговорДеб = РезДеб.ОР.Договор;
		Если ЗначениеЗаполнено(ДоговорДеб) Тогда
			ПодрДог = ДоговорДеб.А_ПодразделениеОказаниеУслугПодразделению;
			// Дебітор: А_ПодрОказ має = Кредитор
			Если НЕ ЗначениеЗаполнено(ПодрДог) ИЛИ ПодрДог <> ПодрКредитор Тогда
				Возврат Истина; // Розходження
			КонецЕсли;
		Иначе
			Возврат Истина; // Немає договору
		КонецЕсли;
	КонецЕсли;

	// Перевірка кредиторської сторони
	ЗапросКред = Новый Запрос;
	ЗапросКред.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КЗ.ОбъектРасчетов КАК ОР
	|ИЗ
	|	Документ.ВзаимозачетЗадолженности.КредиторскаяЗадолженность КАК КЗ
	|ГДЕ
	|	КЗ.Ссылка = &Вз";
	ЗапросКред.УстановитьПараметр("Вз", ВзаимозачетСсылка);

	РезКред = ЗапросКред.Выполнить().Выбрать();
	Если РезКред.Следующий() И ЗначениеЗаполнено(РезКред.ОР) Тогда
		ДоговорКред = РезКред.ОР.Договор;
		Если ЗначениеЗаполнено(ДоговорКред) Тогда
			ПодрДог = ДоговорКред.А_ПодразделениеОказаниеУслугПодразделению;
			// Кредитор: А_ПодрОказ має = Дебітор
			Если НЕ ЗначениеЗаполнено(ПодрДог) ИЛИ ПодрДог <> ПодрДебитор Тогда
				Возврат Истина; // Розходження
			КонецЕсли;
		Иначе
			Возврат Истина; // Немає договору
		КонецЕсли;
	КонецЕсли;

	Возврат Ложь; // Все ОК

КонецФункции
