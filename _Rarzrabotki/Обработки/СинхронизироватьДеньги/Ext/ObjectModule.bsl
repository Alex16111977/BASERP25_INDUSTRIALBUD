// ===========================================================================
// Обробка: СинхронизироватьДеньги
// Призначення: Контроль синхронізації безготівкових грошових коштів ERP ↔ BuhBud
// ===========================================================================
// Фаза 1: Порівняння залишків (РН.ДенежныеСредстваБезналичные ↔ Хозрасчетный 31x)
// Фаза 2: Аналіз документів (через СоответствияОбъектовИнформационныхБаз)
// Фаза 3: Синхронізація (розпровести/провести в ЕРП, поставити на обмін в BuhBud)
// ===========================================================================
// Створено на основі грошового розділу обробки СинхронизироватьТовары.
// ===========================================================================

#Область ОбщиеФункции

// Підключення до BuhBud через COM
//
// Повертає:
//  COMОбъект - підключення до бази BuhBud, або Неопределено при помилці
//
Функция ПодключитьсяКBuhBud() Экспорт

	СтрокаПодключенияBuhBud = "Srvr=""SQLSERVER"";Ref=""BuhBud"";Usr=""cfo"";Pwd=""2442""";
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияBuhBud));
	Исключение
		Сообщить("Помилка підключення до BuhBud: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Возврат V83;

КонецФункции

#КонецОбласти

// ===========================================================================
// ФАЗА 1: Порівняння залишків
// ===========================================================================

#Область Фаза1_ПорівнянняЗалишків

// Головна функція Фази 1 — порівняння залишків грошових коштів
//
Функция СравнитьОстатки() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ТаблицаРасхождений.Очистить();
	ТаблицаДокументов.Очистить();

	// Підключення до BuhBud
	V83 = ПодключитьсяКBuhBud();
	Если V83 = Неопределено Тогда
		Возврат "Помилка підключення до BuhBud";
	КонецЕсли;

	Попытка

		КонецПериодаРасч = КонецДня(ОкончаниеПериода);

		// 1. Залишки ERP (РегістрНакопления.ДенежныеСредстваБезналичные)
		ТЗ_ЕРП = ПолучитьОстаткиЕРП(НачалоПериода, КонецПериодаРасч);

		// 2. Залишки BuhBud (РегістрБухгалтерії.Хозрасчетный, рахунки 31x)
		ТЗ_Бух = ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериодаРасч);

		// 3. Злиття та пошук розбіжностей
		СвестиТаблицы(ТЗ_ЕРП, ТЗ_Бух);

	Исключение
		Сообщить("Помилка при порівнянні залишків: " + ОписаниеОшибки());
	КонецПопытки;

	// Звільнення COM-з'єднання
	V83 = Неопределено;

	Возврат "Оброблено. Розбіжностей: " + Строка(ТаблицаРасхождений.Количество());

КонецФункции

// Залишки ERP з РегістрНакопления.ДенежныеСредстваБезналичные
//
Функция ПолучитьОстаткиЕРП(НачалоПериодаЗапр, КонецПериодаЗапр)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.БанковскийСчет КАК БанковскийСчет,
	|	ПРЕДСТАВЛЕНИЕ(Т.БанковскийСчет) КАК БанковскийСчетПредставление,
	|	Т.СуммаНачальныйОстаток КАК НачОстаток,
	|	Т.СуммаПриход КАК Приход,
	|	Т.СуммаРасход КАК Расход,
	|	Т.СуммаКонечныйОстаток КАК КонОстаток
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваБезналичные.ОстаткиИОбороты(
	|		&НачалоПериода, &КонецПериода, , , ) КАК Т";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаЗапр);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаЗапр);

	ТЗ_Запрос = Запрос.Выполнить().Выгрузить();

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("БанковскийСчетUID", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	Результат.Колонки.Добавить("БанковскийСчетПредставление", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Результат.Колонки.Добавить("НачОстаток", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Результат.Колонки.Добавить("Приход", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Результат.Колонки.Добавить("Расход", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Результат.Колонки.Добавить("КонОстаток", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));

	Для Каждого Стр Из ТЗ_Запрос Цикл
		НС = Результат.Добавить();
		НС.БанковскийСчетUID           = Строка(Стр.БанковскийСчет.УникальныйИдентификатор());
		НС.БанковскийСчетПредставление = Стр.БанковскийСчетПредставление;
		НС.НачОстаток                  = Стр.НачОстаток;
		НС.Приход                      = Стр.Приход;
		НС.Расход                      = Стр.Расход;
		НС.КонОстаток                  = Стр.КонОстаток;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Залишки BuhBud через COM (РегістрБухгалтерії.Хозрасчетный, рахунки 31x СчетаВБанках)
// Валютні рахунки — у валютній сумі; зіставлення з ERP по UUID рахунку (обмін зберігає 1:1)
//
Функция ПолучитьОстаткиBuhBud(V83, НачалоПериодаЗапр, КонецПериодаЗапр)

	ЗапросОрганизаций = Новый Запрос;
	ЗапросОрганизаций.Текст =
	"ВЫБРАТЬ
	|	Организации.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.А_ВБалансе = ИСТИНА
	|	И Организации.КодПоЕДРПОУ <> """"";

	масКодПоЕДРПОУ = Новый Массив;
	ВыборкаОрганизаций = ЗапросОрганизаций.Выполнить().Выбрать();
	Пока ВыборкаОрганизаций.Следующий() Цикл
		масКодПоЕДРПОУ.Добавить(ВыборкаОрганизаций.КодПоЕДРПОУ);
	КонецЦикла;

	Если масКодПоЕДРПОУ.Количество() = 0 Тогда
		Сообщить("Немає організацій з флагом А_ВБалансе!");
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;

	Запрос = V83.NewObject("Запрос");

	масКодПоЕДРПОУ_V83 = V83.NewObject("Массив");
	Для Каждого КодЕДРПОУ Из масКодПоЕДРПОУ Цикл
		масКодПоЕДРПОУ_V83.Добавить(КодЕДРПОУ);
	КонецЦикла;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Субконто1 КАК БанковскийСчетКасса,
	|	ПРЕДСТАВЛЕНИЕ(Остатки.Субконто1) КАК БанковскийСчетПредставление,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Валютный
	|			ТОГДА Остатки.ВалютнаяСуммаНачальныйОстаток
	|		ИНАЧЕ Остатки.СуммаНачальныйОстаток
	|	КОНЕЦ КАК НачОстаток,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Валютный
	|			ТОГДА Остатки.ВалютнаяСуммаОборотДт
	|		ИНАЧЕ Остатки.СуммаОборотДт
	|	КОНЕЦ КАК Приход,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Валютный
	|			ТОГДА Остатки.ВалютнаяСуммаОборотКт
	|		ИНАЧЕ Остатки.СуммаОборотКт
	|	КОНЕЦ КАК Расход,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Валютный
	|			ТОГДА Остатки.ВалютнаяСуммаКонечныйОстаток
	|		ИНАЧЕ Остатки.СуммаКонечныйОстаток
	|	КОНЕЦ КАК КонОстаток,
	|	Остатки.Счет.Код КАК СчетКод,
	|	Остатки.Организация.КодПоЕДРПОУ КАК ОрганизацияКодПоЕДРПОУ
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|		&НачалоПериода, &КонецПериода, , ,
	|		Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках)), , ) КАК Остатки
	|ГДЕ
	|	Остатки.Организация.КодПоЕДРПОУ В (&масКодПоЕДРПОУ)
	|	И (Остатки.СуммаНачальныйОстаток <> 0
	|		ИЛИ Остатки.СуммаОборотДт <> 0
	|		ИЛИ Остатки.СуммаОборотКт <> 0)";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаЗапр);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаЗапр);
	Запрос.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);

	Попытка
		ТЗ = Запрос.Выполнить().Выгрузить();
	Исключение
		Сообщить("Помилка запиту до BuhBud (Гроші): " + ОписаниеОшибки());
		Возврат Новый ТаблицаЗначений;
	КонецПопытки;

	// Ітерація безпосередньо по BuhBud COM таблиці (без серіалізації!)
	// Причина: ЗначениеВСтрокуВнутр/ЗначениеИзСтрокиВнутр ламає посилання БанковскиеСчета
	// (тип Справочник.БанковскиеСчета в BuhBud не існує в ERP як БанковскиеСчетаОрганизаций)
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("БанковскийСчетUID", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	Результат.Колонки.Добавить("БанковскийСчетПредставление", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Результат.Колонки.Добавить("НачОстаток", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Результат.Колонки.Добавить("Приход", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Результат.Колонки.Добавить("Расход", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Результат.Колонки.Добавить("КонОстаток", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));

	Для Сч = 0 По ТЗ.Количество() - 1 Цикл
		СтрокаТЗ = ТЗ.Получить(Сч);

		НС = Результат.Добавить();
		НС.НачОстаток = СтрокаТЗ.НачОстаток;
		НС.Приход     = СтрокаТЗ.Приход;
		НС.Расход     = СтрокаТЗ.Расход;
		НС.КонОстаток = СтрокаТЗ.КонОстаток;
		НС.БанковскийСчетПредставление = СокрЛП(V83.String(СтрокаТЗ.БанковскийСчетПредставление));

		Попытка
			Если СокрЛП(V83.String(СтрокаТЗ.СчетКод)) = "315" Тогда
				// Спеціальна обробка рахунку 315 — пошук по ЄДРПОУ
				ЗапросСчет = Новый Запрос;
				ЗапросСчет.УстановитьПараметр("КодПоЕДРПОУ", СокрЛП(V83.String(СтрокаТЗ.ОрганизацияКодПоЕДРПОУ)));
				ЗапросСчет.УстановитьПараметр("А_СчетБухгалтерский", ПланыСчетов.Хозрасчетный.НайтиПоКоду("315"));
				ЗапросСчет.Текст =
				"ВЫБРАТЬ
				|	БСО.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.БанковскиеСчетаОрганизаций КАК БСО
				|ГДЕ
				|	БСО.А_ОрганизацияБухгалтерия.КодПоЕДРПОУ = &КодПоЕДРПОУ
				|	И БСО.А_СчетБухгалтерский = &А_СчетБухгалтерский
				|	И БСО.А_ПоУмолчаниюДляПустыхСчетовИзБухгалтерии";
				Выборка315 = ЗапросСчет.Выполнить().Выбрать();
				Если Выборка315.Следующий() Тогда
					НС.БанковскийСчетUID = Строка(Выборка315.Ссылка.УникальныйИдентификатор());
				КонецЕсли;
			Иначе
				// Стандартна конвертація по UUID (зчитуємо UUID в контексті BuhBud COM!)
				Если V83.ЗначениеЗаполнено(СтрокаТЗ.БанковскийСчетКасса) Тогда
					СсылкаЕРП = А_Привилегированный.ПолучитьСправочникUID(
						"БанковскиеСчетаОрганизаций",
						V83.String(СтрокаТЗ.БанковскийСчетКасса.УникальныйИдентификатор()));
					Если ЗначениеЗаполнено(СсылкаЕРП) Тогда
						НС.БанковскийСчетUID = Строка(СсылкаЕРП.УникальныйИдентификатор());
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Исключение
			// Якщо не вдалося — залишаємо порожнім
		КонецПопытки;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Злиття таблиць ERP та BuhBud — FULL OUTER JOIN по UUID банківського рахунку
// Результат записується у ТЧ ТаблицаРасхождений (тільки рядки з розбіжностями)
//
Процедура СвестиТаблицы(ТЗ_ЕРП, ТЗ_Бух)

	Ключи = Новый Соответствие;

	// ERP
	Для Каждого Стр Из ТЗ_ЕРП Цикл
		Ключ = СокрЛП(Стр.БанковскийСчетUID);
		Запись = Ключи.Получить(Ключ);
		Если Запись = Неопределено Тогда
			Запись = Новый Структура(
				"Представление, Ключ, НачЕРП, ПриходЕРП, РасходЕРП, ОстатокЕРП, НачБух, ПриходБух, РасходБух, ОстатокБух",
				Стр.БанковскийСчетПредставление, Ключ,
				0, 0, 0, 0, 0, 0, 0, 0);
			Ключи.Вставить(Ключ, Запись);
		КонецЕсли;
		Запись.НачЕРП     = Запись.НачЕРП     + Стр.НачОстаток;
		Запись.ПриходЕРП  = Запись.ПриходЕРП  + Стр.Приход;
		Запись.РасходЕРП  = Запись.РасходЕРП  + Стр.Расход;
		Запись.ОстатокЕРП = Запись.ОстатокЕРП + Стр.КонОстаток;
	КонецЦикла;

	// BuhBud
	Для Каждого Стр Из ТЗ_Бух Цикл
		Ключ = СокрЛП(Стр.БанковскийСчетUID);
		Запись = Ключи.Получить(Ключ);
		Если Запись = Неопределено Тогда
			Предст = Стр.БанковскийСчетПредставление;
			Если НЕ ЗначениеЗаполнено(Предст) Тогда
				Предст = "BuhBud: " + Ключ;
			КонецЕсли;
			Запись = Новый Структура(
				"Представление, Ключ, НачЕРП, ПриходЕРП, РасходЕРП, ОстатокЕРП, НачБух, ПриходБух, РасходБух, ОстатокБух",
				Предст, Ключ,
				0, 0, 0, 0, 0, 0, 0, 0);
			Ключи.Вставить(Ключ, Запись);
		КонецЕсли;
		Запись.НачБух     = Запись.НачБух     + Стр.НачОстаток;
		Запись.ПриходБух  = Запись.ПриходБух  + Стр.Приход;
		Запись.РасходБух  = Запись.РасходБух  + Стр.Расход;
		Запись.ОстатокБух = Запись.ОстатокБух + Стр.КонОстаток;
	КонецЦикла;

	// Заповнення ТЧ
	Для Каждого КлючЗначение Из Ключи Цикл
		Запись = КлючЗначение.Значение;
		Разница = Запись.ОстатокЕРП - Запись.ОстатокБух;
		Если Окр(Разница, 2) = 0
			И Окр(Запись.НачЕРП - Запись.НачБух, 2) = 0
			И Окр(Запись.ПриходЕРП - Запись.ПриходБух, 2) = 0
			И Окр(Запись.РасходЕРП - Запись.РасходБух, 2) = 0 Тогда
			Продолжить;
		КонецЕсли;

		НС = ТаблицаРасхождений.Добавить();
		// Відновити ссылку на банківський рахунок з UUID
		Попытка
			БанкСсылка = Справочники.БанковскиеСчетаОрганизаций.ПолучитьСсылку(Новый УникальныйИдентификатор(Запись.Ключ));
			Если ЗначениеЗаполнено(БанкСсылка) И БанкСсылка.ПолучитьОбъект() <> Неопределено Тогда
				НС.БанковскийСчет = БанкСсылка;
			Иначе
				НС.БанковскийСчет = Запись.Представление;
			КонецЕсли;
		Исключение
			НС.БанковскийСчет = Запись.Представление;
		КонецПопытки;
		НС.НачОстатокЕРП       = Запись.НачЕРП;
		НС.НачОстатокБух       = Запись.НачБух;
		НС.ПриходЕРП           = Запись.ПриходЕРП;
		НС.ПриходБух           = Запись.ПриходБух;
		НС.РасходЕРП           = Запись.РасходЕРП;
		НС.РасходБух           = Запись.РасходБух;
		НС.ОстатокЕРП          = Запись.ОстатокЕРП;
		НС.ОстатокБух          = Запись.ОстатокБух;
		НС.Разница             = Разница;
		НС.Синхронизировать    = Истина;
		НС.БанковскийСчетUID   = Запись.Ключ;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

// ===========================================================================
// ФАЗА 2: Аналіз документів (через СоответствияОбъектовИнформационныхБаз)
// ===========================================================================

#Область Фаза2_АналізДокументів

// Головна функція Фази 2 — аналіз документів для вибраних розбіжностей
//
Функция АнализироватьДокументы() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ТаблицаДокументов.Очистить();

	V83 = ПодключитьсяКBuhBud();
	Если V83 = Неопределено Тогда
		Возврат "Помилка підключення до BuhBud";
	КонецЕсли;

	// Отримати вузол обміну в BuhBud
	УзелОбмена = Неопределено;
	Попытка
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20 ГДЕ НЕ ЭтотУзел";
		V83_Рез = V83_Запрос.Выполнить().Выбрать();
		Если V83_Рез.Следующий() Тогда
			УзелОбмена = V83_Рез.Ссылка;
		КонецЕсли;
	Исключение
		Сообщить("Не вдалося знайти вузол обміну в BuhBud: " + ОписаниеОшибки());
	КонецПопытки;

	Для Каждого СтрРасх Из ТаблицаРасхождений Цикл
		Если НЕ СтрРасх.Синхронизировать Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			АнализДокументов_ПоСчету(V83, СтрРасх, УзелОбмена);
		Исключение
			Сообщить("ПОМИЛКА аналізу " + Строка(СтрРасх.БанковскийСчет) + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	V83 = Неопределено;
	Возврат "Документів для синхронізації: " + Строка(ТаблицаДокументов.Количество());

КонецФункции

// Аналіз документів по одному банківському рахунку
//
Процедура АнализДокументов_ПоСчету(V83, СтрРасх, УзелОбмена)

	Если НЕ ЗначениеЗаполнено(СтрРасх.БанковскийСчетUID) Тогда
		Сообщить("Рахунок не зіставлено з ERP, аналіз неможливий: " + Строка(СтрРасх.БанковскийСчет));
		Возврат;
	КонецЕсли;

	КонецПериодаРасч = КонецДня(ОкончаниеПериода);

	// Конвертація UUID-рядка в посилання
	БанковскийСчетСсылка = Справочники.БанковскиеСчетаОрганизаций.ПолучитьСсылку(
		Новый УникальныйИдентификатор(СтрРасх.БанковскийСчетUID));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Об.Регистратор КАК Регистратор,
	|	ПРЕДСТАВЛЕНИЕ(Об.Регистратор) КАК РегистраторПредст,
	|	Об.СуммаПриход КАК Приход,
	|	Об.СуммаРасход КАК Расход,
	|	Соотв.УникальныйИдентификаторПриемника КАК UIDвBuhBud,
	|	Соотв.ТипПриемника КАК ТипПриемника,
	|	Соотв.ТипИсточника КАК ТипИсточника
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваБезналичные.Обороты(
	|		&НачалоПериода, &КонецПериода, Авто,
	|		БанковскийСчет = &БанковскийСчет) КАК Об
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
	|	ПО Об.Регистратор = Соотв.УникальныйИдентификаторИсточника
	|		И (Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20)";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаРасч);
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчетСсылка);

	ТЗ_Док = Запрос.Выполнить().Выгрузить();

	// Обробка документів ERP
	ОбробитиДокументиЕРП(V83, ТЗ_Док, СтрРасх, УзелОбмена);

	// Зворотна перевірка: документи BuhBud без ERP відповідника
	ПроверитьДокументыBuhBud(V83, ТЗ_Док, СтрРасх);

КонецПроцедуры

// Зворотна перевірка: знайти документи BuhBud без ERP відповідника
// Вирішує проблему коли документ створений/проведений в BuhBud, але відсутній
// або непроведений в ERP (ручна проводка чи документ не перенесений обміном)
//
Процедура ПроверитьДокументыBuhBud(V83, ТЗ_ДокЕРП, СтрРасх)

	Попытка
		// 1. Збираємо UUID всіх ERP регістраторів
		масUIDерп = Новый Соответствие;
		Для Каждого СтрДок Из ТЗ_ДокЕРП Цикл
			масUIDерп.Вставить(ВРег(Строка(СтрДок.Регистратор.УникальныйИдентификатор())), Истина);
		КонецЦикла;

		// 2. Знайти BuhBud банківський рахунок по IBAN (НомерСчета)
		БанковскийСчетСсылкаЕРП = Справочники.БанковскиеСчетаОрганизаций.ПолучитьСсылку(
			Новый УникальныйИдентификатор(СтрРасх.БанковскийСчетUID));
		IBAN = СокрЛП(БанковскийСчетСсылкаЕРП.НомерСчета);

		V83_ЗапрБанк = V83.NewObject("Запрос");
		V83_ЗапрБанк.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Ссылка, Наименование
		|ИЗ Справочник.БанковскиеСчета
		|ГДЕ НомерСчета = &НомерСчета
		|	И Наименование <> """"
		|	И Наименование НЕ ПОДОБНО ""%$$$%""
		|УПОРЯДОЧИТЬ ПО Наименование";
		V83_ЗапрБанк.УстановитьПараметр("НомерСчета", IBAN);
		V83_РезБанк = V83_ЗапрБанк.Выполнить().Выбрать();
		Если НЕ V83_РезБанк.Следующий() Тогда
			Возврат; // BuhBud рахунок не знайдено
		КонецЕсли;
		БанкРахунокBuhBud = V83_РезБанк.Ссылка;

		// 3. Запит BuhBud: ОстаткиИОбороты з періодичністю Регистратор та Субконто1 = банк.рахунок
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Регистратор КАК Регистратор,
		|	ПРЕДСТАВЛЕНИЕ(Т.Регистратор) КАК Представление,
		|	Т.СуммаОборотДт КАК Приход,
		|	Т.СуммаОборотКт КАК Расход
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		|		&НачалоПериода, &КонецПериода, Регистратор, ,
		|		Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках)), ,
		|		Субконто1 = &БанкРахунок) КАК Т";

		V83_Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		V83_Запрос.УстановитьПараметр("КонецПериода", КонецДня(ОкончаниеПериода));
		V83_Запрос.УстановитьПараметр("БанкРахунок", БанкРахунокBuhBud);

		V83_Рез = V83_Запрос.Выполнить().Выбрать();

		// 4. Для кожного регістратора: якщо немає в ERP оборотах — кандидат на синхронізацію
		Пока V83_Рез.Следующий() Цикл
			Попытка
				Рег = V83_Рез.Регистратор;
				Если НЕ V83.ЗначениеЗаполнено(Рег) Тогда Продолжить; КонецЕсли;
				// V83.XMLСтрока: COM UUID з BuhBud не конвертується локальною функцією
				УИД = ВРег(V83.XMLСтрока(Рег.УникальныйИдентификатор()));
			Исключение
				Продолжить;
			КонецПопытки;

			// Пропустити якщо вже є в ERP
			Если масUIDерп[УИД] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			// Чистий потік по рахунку: Приход(Дт) - Расход(Кт)
			ПриходБух = 0;
			РасходБух = 0;
			Попытка ПриходБух = V83_Рез.Приход; Исключение КонецПопытки;
			Попытка РасходБух = V83_Рез.Расход; Исключение КонецПопытки;
			Сума = ПриходБух - РасходБух;

			// Пропустити якщо чистий потік = 0 по цьому рахунку
			Если Окр(Сума, 2) = 0 Тогда Продолжить; КонецЕсли;

			// Тип документа BuhBud — потрібен Фазі 3 для отримання посилання
			ТипБух = "";
			Попытка
				ТипБух = V83.String(Рег.Метаданные().Имя);
			Исключение
				// COM-помилка читання метаданих — тип залишиться порожнім,
				// Фаза 3 поверне по такому рядку помилку з поясненням
			КонецПопытки;

			// Перевірити відповідність в ЕРП (документ може існувати, але бути непроведеним)
			ДокЕРПСсылка = Неопределено;
			UIDДокЕРП = "";
			ЕстьВідповідність = Ложь;
			ДіяДок = "На обмін в BuhBud";
			СтатусДок = "Тільки в BuhBud (немає в ЕРП)";
			Попытка
				ЗапросСоотв = Новый Запрос;
				ЗапросСоотв.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Соотв.УникальныйИдентификаторИсточника КАК Источник
				|ИЗ
				|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
				|ГДЕ
				|	Соотв.УникальныйИдентификаторПриемника = &UIDПриемника
				|	И Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20";
				ЗапросСоотв.УстановитьПараметр("UIDПриемника", УИД);
				РезСоотв = ЗапросСоотв.Выполнить().Выбрать();
				Если РезСоотв.Следующий() Тогда
					ЕстьВідповідність = Истина;
					ДокЕРПСсылка = РезСоотв.Источник;
					UIDДокЕРП = Строка(РезСоотв.Источник.УникальныйИдентификатор());
					Если РезСоотв.Источник.Проведен Тогда
						ДіяДок = "Переобмін";
						СтатусДок = "Проведений в ЕРП, немає рухів по рахунку";
					Иначе
						ДіяДок = "Провести в ЕРП";
						СтатусДок = "Не проведений в ЕРП";
					КонецЕсли;
				КонецЕсли;
			Исключение
				// Помилка пошуку відповідності — залишаємо дію "На обмін в BuhBud"
			КонецПопытки;

			НС = ТаблицаДокументов.Добавить();
			НС.БанковскийСчет      = СтрРасх.БанковскийСчет;
			НС.ТипДокумента        = ТипБух;
			НС.ДокументЕРП         = ?(ДокЕРПСсылка <> Неопределено, ДокЕРПСсылка, "");
			НС.ДокументБух         = СокрЛП(V83.String(V83_Рез.Представление));
			НС.СуммаБух            = Сума;
			НС.UIDДокумента        = UIDДокЕРП;
			НС.UIDДокументаБух     = УИД;
			НС.ЕстьСоответствие    = ЕстьВідповідність;
			НС.Действие            = ДіяДок;
			НС.Статус              = СтатусДок;
			НС.Синхронизировать    = Истина;
		КонецЦикла;

	Исключение
		Сообщить("Помилка зворотньої перевірки BuhBud: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Обробка документів ERP: для кожного перевіряє відповідність в BuhBud та визначає дію
//
Процедура ОбробитиДокументиЕРП(V83, ТЗ_Док, СтрРасх, УзелОбмена)

	Для Каждого СтрДок Из ТЗ_Док Цикл

		НС = ТаблицаДокументов.Добавить();
		НС.БанковскийСчет  = СтрРасх.БанковскийСчет;
		НС.ДокументЕРП     = СтрДок.Регистратор;
		НС.СуммаЕРП        = СтрДок.Приход - СтрДок.Расход;
		НС.UIDДокумента    = Строка(СтрДок.Регистратор.УникальныйИдентификатор());
		НС.Синхронизировать = Истина;

		// Визначити тип документа ERP
		ТипИст = "";
		Попытка
			ТипИст = СокрЛП(СтрДок.ТипИсточника);
			ТипИст = СтрЗаменить(ТипИст, "ДокументСсылка.", "");
		Исключение
		КонецПопытки;
		Если НЕ ЗначениеЗаполнено(ТипИст) Тогда
			МетаДанные = СтрДок.Регистратор.Метаданные();
			ТипИст = МетаДанные.Имя;
		КонецЕсли;
		НС.ТипДокумента = ТипИст;

		// Пропустити операції переказу між рахунками
		// (в BuhBud це ОДИН документ, а в ERP — ДВА; порівнювати недоречно)
		Попытка
			ХозОперация = СтрДок.Регистратор.ХозяйственнаяОперация;
			Если ХозОперация = Перечисления.ХозяйственныеОперации.ПоступлениеДенежныхСредствСДругогоСчета
				ИЛИ ХозОперация = Перечисления.ХозяйственныеОперации.ПеречислениеДенежныхСредствНаДругойСчет Тогда
				НС.Действие = "";
				НС.Статус   = "Переказ між рахунками";
				НС.Синхронизировать = Ложь;
				Продолжить;
			КонецЕсли;
		Исключение
			// У типа документа немає реквізиту ХозяйственнаяОперация — не переказ
		КонецПопытки;

		// Перевірка наявності відповідності
		UIDвBuhBud = Неопределено;
		Попытка
			UIDвBuhBud = СтрДок.UIDвBuhBud;
		Исключение
		КонецПопытки;

		Если UIDвBuhBud <> Неопределено И ЗначениеЗаполнено(UIDвBuhBud) Тогда
			// Є відповідність — перевіряємо стан документа в BuhBud
			НС.ЕстьСоответствие = Истина;
			НС.UIDДокументаБух  = Строка(UIDвBuhBud);

			ТипПрием = "";
			Попытка
				ТипПрием = СокрЛП(СтрДок.ТипПриемника);
				ТипПрием = СтрЗаменить(ТипПрием, "ДокументСсылка.", "");
			Исключение
			КонецПопытки;

			Если ЗначениеЗаполнено(ТипПрием) Тогда
				ПроверитьДокументВBuhBud(V83, НС, ТипПрием, UIDвBuhBud, УзелОбмена);
			Иначе
				НС.Действие = "Невідомий тип";
				НС.Статус   = "Тип приемника не визначено";
			КонецЕсли;
		Иначе
			// Немає відповідності — документ ніколи не відправлявся
			НС.ЕстьСоответствие = Ложь;
			НС.Действие = "Розпровести в ЕРП";
			НС.Статус   = "Немає в BuhBud (немає відповідності)";
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Перевірка документа в BuhBud через COM
//
Процедура ПроверитьДокументВBuhBud(V83, НС, ТипПриемника, UIDвBuhBud, УзелОбмена)

	Попытка
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст =
			"ВЫБРАТЬ Ссылка, Проведен, ПометкаУдаления, ПРЕДСТАВЛЕНИЕ(Ссылка) КАК Представление ИЗ Документ." + ТипПриемника
			+ " ГДЕ Ссылка = &Ссылка";

		СсылкаBuhBud = V83.Документы[ТипПриемника].ПолучитьСсылку(
			V83.NewObject("УникальныйИдентификатор", Строка(UIDвBuhBud)));
		V83_Запрос.УстановитьПараметр("Ссылка", СсылкаBuhBud);

		V83_Рез = V83_Запрос.Выполнить().Выбрать();
		Если V83_Рез.Следующий() Тогда
			НС.ДокументБух = СокрЛП(V83_Рез.Представление);

			Если V83_Рез.ПометкаУдаления Тогда
				// Документ видалено в BuhBud
				НС.Действие = "Розпровести в ЕРП";
				НС.Статус   = "Видалений в BuhBud";
			ИначеЕсли НЕ V83_Рез.Проведен Тогда
				// Документ не проведений в BuhBud — поставити на обмін
				НС.Действие = "На обмін в BuhBud";
				НС.Статус   = "Не проведений в BuhBud";
				НС.ТипДокумента = ТипПриемника;
			Иначе
				// Проведений — розбіжність в рухах, потребує аналізу
				НС.Действие = "Переобмін";
				НС.Статус   = "Проведений, різниця в рухах";
				НС.ТипДокумента = ТипПриемника;
			КонецЕсли;

			// Отримати чистий потік документа по банківських рахунках BuhBud:
			// Дт банку (приход) - Кт банку (расход); В ИЕРАРХИИ не можна
			// всередині агрегатних функцій → UNION ALL
			Попытка
				V83_ЗапросКол = V83.NewObject("Запрос");
				V83_ЗапросКол.Текст =
				"ВЫБРАТЬ
				|	СУММА(Т.Приход) - СУММА(Т.Расход) КАК Сумма
				|ИЗ
				|	(ВЫБРАТЬ Д.Сумма КАК Приход, 0 КАК Расход
				|	ИЗ РегистрБухгалтерии.Хозрасчетный КАК Д
				|	ГДЕ Д.Регистратор = &Регистратор
				|		И Д.СчетДт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках))
				|
				|	ОБЪЕДИНИТЬ ВСЕ
				|
				|	ВЫБРАТЬ 0, Д.Сумма
				|	ИЗ РегистрБухгалтерии.Хозрасчетный КАК Д
				|	ГДЕ Д.Регистратор = &Регистратор
				|		И Д.СчетКт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках))) КАК Т";
				V83_ЗапросКол.УстановитьПараметр("Регистратор", СсылкаBuhBud);
				V83_РезКол = V83_ЗапросКол.Выполнить().Выбрать();
				Если V83_РезКол.Следующий() Тогда
					НС.СуммаБух = V83_РезКол.Сумма;
				КонецЕсли;
			Исключение
				// Не вдалось отримати суму з BuhBud — залишаємо 0
			КонецПопытки;

			// Якщо суми співпадають — документ ОК, не потребує дії
			Если НС.Действие = "Переобмін"
				И Окр(НС.СуммаЕРП - НС.СуммаБух, 2) = 0 Тогда
				НС.Действие = "";
				НС.Статус   = "ОК";
				НС.Синхронизировать = Ложь;
			КонецЕсли;

		Иначе
			// Документ не знайдено — видалений або UUID невірний
			НС.Действие = "Розпровести в ЕРП";
			НС.Статус   = "Не знайдено в BuhBud";
		КонецЕсли;
	Исключение
		НС.Действие = "Помилка";
		НС.Статус   = "Помилка COM: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

// ===========================================================================
// ФАЗА 3: Синхронізація
// ===========================================================================

#Область Фаза3_Синхронізація

// Головна функція Фази 3 — виконання синхронізації
//
Функция ВыполнитьСинхронизацию() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	V83 = Неопределено;
	УзелОбмена = Неопределено;
	КількістьОброблених = 0;
	КількістьПомилок    = 0;

	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если НЕ СтрДок.Синхронизировать Тогда
			Продолжить;
		КонецЕсли;

		Если СтрДок.Действие = "Розпровести в ЕРП" Тогда
			// Отменити проведення документа в ЕРП
			Попытка
				РаспровестиВЕРП(СтрДок);
				КількістьОброблених = КількістьОброблених + 1;
			Исключение
				СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
				КількістьПомилок = КількістьПомилок + 1;
			КонецПопытки;

		ИначеЕсли СтрДок.Действие = "Провести в ЕРП" Тогда
			// Провести непроведений документ в ЕРП
			Попытка
				ПровестиВЕРП(СтрДок);
				КількістьОброблених = КількістьОброблених + 1;
			Исключение
				СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
				КількістьПомилок = КількістьПомилок + 1;
			КонецПопытки;

		ИначеЕсли СтрДок.Действие = "На обмін в BuhBud"
			ИЛИ СтрДок.Действие = "Переобмін" Тогда

			// Ліниве підключення до BuhBud (тільки якщо потрібно)
			Если V83 = Неопределено Тогда
				V83 = ПодключитьсяКBuhBud();
				Если V83 = Неопределено Тогда
					СтрДок.Статус = "ПОМИЛКА: Немає підключення до BuhBud";
					КількістьПомилок = КількістьПомилок + 1;
					Продолжить;
				КонецЕсли;
				// Знайти вузол обміну
				Попытка
					V83_З = V83.NewObject("Запрос");
					V83_З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20 ГДЕ НЕ ЭтотУзел";
					V83_Рез = V83_З.Выполнить().Выбрать();
					Если V83_Рез.Следующий() Тогда
						УзелОбмена = V83_Рез.Ссылка;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;

			Попытка
				ПоставитьНаОбменВBuhBud(V83, СтрДок, УзелОбмена);
				КількістьОброблених = КількістьОброблених + 1;
			Исключение
				СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
				КількістьПомилок = КількістьПомилок + 1;
			КонецПопытки;

		КонецЕсли;
	КонецЦикла;

	V83 = Неопределено;

	Возврат "Оброблено: " + КількістьОброблених + ", Помилок: " + КількістьПомилок;

КонецФункции

// Розпровести документ в ЕРП
//
Процедура РаспровестиВЕРП(СтрДок)

	UIDСтрока = СокрЛП(СтрДок.UIDДокумента);
	Если НЕ ЗначениеЗаполнено(UIDСтрока) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа";
		Возврат;
	КонецЕсли;

	// Знайти документ по UUID
	ТипДок = СокрЛП(СтрДок.ТипДокумента);
	МенеджерДок = Документы[ТипДок];
	СсылкаДок = МенеджерДок.ПолучитьСсылку(Новый УникальныйИдентификатор(UIDСтрока));

	Если НЕ ЗначениеЗаполнено(СсылкаДок) ИЛИ СсылкаДок.Пустая() Тогда
		СтрДок.Статус = "ПОМИЛКА: Документ не знайдено в ЕРП";
		Возврат;
	КонецЕсли;

	ДокОбъект = СсылкаДок.ПолучитьОбъект();
	ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	СтрДок.Статус = "Розпроведено в ЕРП";

КонецПроцедуры

// Провести непроведений документ в ЕРП
//
Процедура ПровестиВЕРП(СтрДок)

	UIDСтрока = СокрЛП(СтрДок.UIDДокумента);
	Если НЕ ЗначениеЗаполнено(UIDСтрока) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа ЕРП";
		Возврат;
	КонецЕсли;

	// Знайти документ ЕРП по UUID через СоответствияОбъектовИнформационныхБаз
	Попытка
		ЗапросТип = Новый Запрос;
		ЗапросТип.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Соотв.УникальныйИдентификаторИсточника КАК Источник,
		|	Соотв.ТипИсточника КАК ТипИсточника
		|ИЗ
		|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
		|ГДЕ
		|	Соотв.УникальныйИдентификаторПриемника = &UIDПриемника
		|	И Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20";
		ЗапросТип.УстановитьПараметр("UIDПриемника", СокрЛП(СтрДок.UIDДокументаБух));
		РезТип = ЗапросТип.Выполнить().Выбрать();
		Если РезТип.Следующий() Тогда
			ДокОбъект = РезТип.Источник.ПолучитьОбъект();
			Если ДокОбъект = Неопределено Тогда
				СтрДок.Статус = "ПОМИЛКА: Документ не знайдено в ЕРП";
				Возврат;
			КонецЕсли;
			Если ДокОбъект.Проведен Тогда
				СтрДок.Статус = "Вже проведений";
				Возврат;
			КонецЕсли;
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			СтрДок.Статус = "Проведено в ЕРП";
		Иначе
			СтрДок.Статус = "ПОМИЛКА: Відповідність не знайдена";
		КонецЕсли;
	Исключение
		СтрДок.Статус = "ПОМИЛКА проведення: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Поставити документ на обмін в BuhBud
//
Процедура ПоставитьНаОбменВBuhBud(V83, СтрДок, УзелОбмена)

	Если УзелОбмена = Неопределено Тогда
		СтрДок.Статус = "ПОМИЛКА: Вузол обміну не знайдено";
		Возврат;
	КонецЕсли;

	UIDСтрока = СокрЛП(СтрДок.UIDДокументаБух);
	Если НЕ ЗначениеЗаполнено(UIDСтрока) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа в BuhBud";
		Возврат;
	КонецЕсли;

	// ТипДокумента містить тип BuhBud (встановлений на етапі аналізу)
	ТипПриемника = СокрЛП(СтрДок.ТипДокумента);

	// Отримати посилання на документ в BuhBud
	СсылкаBuhBud = V83.Документы[ТипПриемника].ПолучитьСсылку(
		V83.NewObject("УникальныйИдентификатор", UIDСтрока));

	// Зареєструвати зміни на вузлі обміну
	V83.ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, СсылкаBuhBud);
	СтрДок.Статус = "Зареєстровано на обмін в BuhBud";

КонецПроцедуры

#КонецОбласти
