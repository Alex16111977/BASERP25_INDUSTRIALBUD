// ===========================================================================
// Обробка: СинхронизироватьДеньги
// Призначення: Контроль синхронізації безготівкових грошових коштів ERP ↔ BuhBud
// ===========================================================================
// Фаза 1: Порівняння залишків (РН.ДенежныеСредстваБезналичные ↔ Хозрасчетный 31x)
// Фаза 2: Аналіз документів (через СоответствияОбъектовИнформационныхБаз)
// Фаза 3: Синхронізація (розпровести/провести в ЕРП, поставити на обмін в BuhBud)
// ===========================================================================
// Створено на основі грошового розділу обробки СинхронизироватьТовары.
// ===========================================================================

#Область ОбщиеФункции

// Підключення до BuhBud через COM
//
// Повертає:
//  COMОбъект - підключення до бази BuhBud, або Неопределено при помилці
//
Функция ПодключитьсяКBuhBud() Экспорт

	СтрокаПодключенияBuhBud = "Srvr=""SQLSERVER"";Ref=""BuhBud"";Usr=""cfo"";Pwd=""2442""";
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияBuhBud));
	Исключение
		Сообщить("Помилка підключення до BuhBud: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Возврат V83;

КонецФункции

#КонецОбласти

// ===========================================================================
// ДАНІ ПОРІВНЯННЯ ДЛЯ СКД
// Структура наборів та алгоритм — зі звіту А_СравнитьОстаткиДенегЕРПсBASБухгалтерия
// (функції отримання залишків перенесені 1:1)
// ===========================================================================

#Область ДаніПорівняння

// Будує таблиці зовнішніх наборів даних СКД
// (БезналичныеДС_ЕРП / _УПП / _ПоДнямЕРП / _ПоДнямУПП)
//
// Повертає:
//  Структура - зовнішні набори даних, або Неопределено при помилці підключення
//
Функция ПостроитьДанныеСравнения() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	КонецПериодаРасч = КонецДня(ОкончаниеПериода);

	ТаблицаЕРП = ПолучитьОстаткиЕРП_Бух(НачалоПериода, КонецПериодаРасч, Ложь);
	ТаблицаПоДнямЕРП = Новый ТаблицаЗначений;
	Если ПоДням Тогда
		ТаблицаПоДнямЕРП = ПолучитьОстаткиЕРП_Бух(НачалоПериода, КонецПериодаРасч, Истина);
	КонецЕсли;

	V83 = ПодключитьсяКBuhBud();
	Если V83 = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТаблицаУПП = ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериодаРасч, Ложь);
	ТаблицаПоДнямУПП = Новый ТаблицаЗначений;
	Если ПоДням Тогда
		ТаблицаПоДнямУПП = ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериодаРасч, Истина);
	КонецЕсли;

	V83 = Неопределено;

	Возврат Новый Структура(
		"БезналичныеДС_ЕРП, БезналичныеДС_УПП, БезналичныеДС_ПоДнямЕРП, БезналичныеДС_ПоДнямУПП",
		ТаблицаЕРП, ТаблицаУПП, ТаблицаПоДнямЕРП, ТаблицаПоДнямУПП);

КонецФункции

// Отримання залишків з ERP (РегістрБухгалтерії.Хозрасчетный, рахунки 31x)
//
// Параметри:
//  НачалоПериода - Дата - початок періоду
//  КонецПериода - Дата - кінець періоду
//  ПоДням - Булево - якщо Істина, то розбивка по днях
//
// Повертає:
//  ТаблицяЗначень - таблиця з залишками
//
Функция ПолучитьОстаткиЕРП_Бух(НачалоПериода, КонецПериода, ПоДням)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	ОписаниеТиповДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("БанковскийСчетКасса",
		Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчетаОрганизаций"));
	Результат.Колонки.Добавить("ТипДенежныхСредств",
		Новый ОписаниеТипов("ПеречислениеСсылка.ТипыДенежныхСредств"));

	Если ПоДням Тогда
		Результат.Колонки.Добавить("СуммаНачальныйОстаток_ПоДнямЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаПриход_ПоДнямЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасход_ПоДнямЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаКонечныйОстаток_ПоДнямЕРП", ТипЧисло);
		Результат.Колонки.Добавить("ПериодДень", ОписаниеТиповДата);
	Иначе
		Результат.Колонки.Добавить("СуммаНачальныйОстаток_ЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаПриход_ЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасход_ЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаКонечныйОстаток_ЕРП", ТипЧисло);
	КонецЕсли;

	Запрос = Новый Запрос;

	Если ПоДням Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	ДенежныеСредстваБезналичныеОстаткиИОбороты.БанковскийСчет КАК БанковскийСчетКасса,
		|	ДенежныеСредстваБезналичныеОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток_ПоДнямЕРП,
		|	ДенежныеСредстваБезналичныеОстаткиИОбороты.СуммаПриход КАК СуммаПриход_ПоДнямЕРП,
		|	ДенежныеСредстваБезналичныеОстаткиИОбороты.СуммаРасход КАК СуммаРасход_ПоДнямЕРП,
		|	ДенежныеСредстваБезналичныеОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток_ПоДнямЕРП,
		|	ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Безналичные) КАК ТипДенежныхСредств,
		|	ДенежныеСредстваБезналичныеОстаткиИОбороты.Период КАК ПериодДень
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваБезналичные.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, День, , ) КАК ДенежныеСредстваБезналичныеОстаткиИОбороты" ;
		
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		|	ДенежныеСредстваБезналичныеОстаткиИОбороты.БанковскийСчет КАК БанковскийСчетКасса,
		|	ДенежныеСредстваБезналичныеОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток_ЕРП,
		|	ДенежныеСредстваБезналичныеОстаткиИОбороты.СуммаПриход КАК СуммаПриход_ЕРП,
		|	ДенежныеСредстваБезналичныеОстаткиИОбороты.СуммаРасход КАК СуммаРасход_ЕРП,
		|	ДенежныеСредстваБезналичныеОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток_ЕРП,
		|	ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Безналичные) КАК ТипДенежныхСредств
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваБезналичные.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ) КАК ДенежныеСредстваБезналичныеОстаткиИОбороты" ;
		
	КонецЕсли;

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НС = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Выборка);
		НС.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Безналичные;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Отримання залишків з BuhBud через COM (РегістрБухгалтерії.Хозрасчетный, рахунки 31x)
//
// Параметри:
//  V83 - COMОбъект - підключення до BuhBud
//  НачалоПериода - Дата - початок періоду
//  КонецПериода - Дата - кінець періоду
//  ПоДням - Булево - якщо Істина, то розбивка по днях
//
// Повертає:
//  ТаблицяЗначень - таблиця з залишками (з конвертованими посиланнями)
//
Функция ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода, ПоДням)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	ОписаниеТиповДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("БанковскийСчетКасса",
		Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчетаОрганизаций"));
	Результат.Колонки.Добавить("ТипДенежныхСредств",
		Новый ОписаниеТипов("ПеречислениеСсылка.ТипыДенежныхСредств"));

	Если ПоДням Тогда
		Результат.Колонки.Добавить("СуммаНачальныйОстаток_ПоДнямУПП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаПриход_ПоДнямУПП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасход_ПоДнямУПП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаКонечныйОстаток_ПоДнямУПП", ТипЧисло);
		Результат.Колонки.Добавить("ПериодДень", ОписаниеТиповДата);
	Иначе
		Результат.Колонки.Добавить("СуммаНачальныйОстаток_УПП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаПриход_УПП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасход_УПП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаКонечныйОстаток_УПП", ТипЧисло);
	КонецЕсли;

	Запрос = V83.NewObject("Запрос");

	Если ПоДням Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Субконто1 КАК БанковскийСчетКасса,
		|	ВЫБОР
		|		КОГДА Остатки.Счет.Валютный
		|			ТОГДА Остатки.ВалютнаяСуммаНачальныйОстаток
		|		ИНАЧЕ Остатки.СуммаНачальныйОстаток
		|	КОНЕЦ КАК СуммаНачальныйОстаток_ПоДнямУПП,
		|	ВЫБОР
		|		КОГДА Остатки.Счет.Валютный
		|			ТОГДА Остатки.ВалютнаяСуммаОборотДт
		|		ИНАЧЕ Остатки.СуммаОборотДт
		|	КОНЕЦ КАК СуммаПриход_ПоДнямУПП,
		|	ВЫБОР
		|		КОГДА Остатки.Счет.Валютный
		|			ТОГДА Остатки.ВалютнаяСуммаОборотКт
		|		ИНАЧЕ Остатки.СуммаОборотКт
		|	КОНЕЦ КАК СуммаРасход_ПоДнямУПП,
		|	ВЫБОР
		|		КОГДА Остатки.Счет.Валютный
		|			ТОГДА Остатки.ВалютнаяСуммаКонечныйОстаток
		|		ИНАЧЕ Остатки.СуммаКонечныйОстаток
		|	КОНЕЦ КАК СуммаКонечныйОстаток_ПоДнямУПП,
		|	Остатки.Период КАК ПериодДень,
		|	Остатки.Счет.Код КАК СчетКод,
		|	Остатки.Организация.КодПоЕДРПОУ КАК ОрганизацияКодПоЕДРПОУ
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, День, , Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках)), , ) КАК Остатки
		|ГДЕ
		|	(Остатки.СуммаНачальныйОстаток <> 0
		|			ИЛИ Остатки.СуммаОборотДт <> 0
		|			ИЛИ Остатки.СуммаОборотКт <> 0)";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Субконто1 КАК БанковскийСчетКасса,
		|	ВЫБОР
		|		КОГДА Остатки.Счет.Валютный
		|			ТОГДА Остатки.ВалютнаяСуммаНачальныйОстаток
		|		ИНАЧЕ Остатки.СуммаНачальныйОстаток
		|	КОНЕЦ КАК СуммаНачальныйОстаток_УПП,
		|	ВЫБОР
		|		КОГДА Остатки.Счет.Валютный
		|			ТОГДА Остатки.ВалютнаяСуммаОборотДт
		|		ИНАЧЕ Остатки.СуммаОборотДт
		|	КОНЕЦ КАК СуммаПриход_УПП,
		|	ВЫБОР
		|		КОГДА Остатки.Счет.Валютный
		|			ТОГДА Остатки.ВалютнаяСуммаОборотКт
		|		ИНАЧЕ Остатки.СуммаОборотКт
		|	КОНЕЦ КАК СуммаРасход_УПП,
		|	ВЫБОР
		|		КОГДА Остатки.Счет.Валютный
		|			ТОГДА Остатки.ВалютнаяСуммаКонечныйОстаток
		|		ИНАЧЕ Остатки.СуммаКонечныйОстаток
		|	КОНЕЦ КАК СуммаКонечныйОстаток_УПП,
		|	Остатки.Счет.Код КАК СчетКод,
		|	Остатки.Организация.КодПоЕДРПОУ КАК ОрганизацияКодПоЕДРПОУ
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках)), , ) КАК Остатки
		|ГДЕ
		|	(Остатки.СуммаНачальныйОстаток <> 0
		|			ИЛИ Остатки.СуммаОборотДт <> 0
		|			ИЛИ Остатки.СуммаОборотКт <> 0)";
	КонецЕсли;

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	ТЗ = Запрос.Выполнить().Выгрузить();

	// Конвертація посилань BuhBud -> ERP через UUID
	Для Каждого СтрокаТЗ Из ТЗ Цикл
		НС = Результат.Добавить();

		Если ПоДням Тогда
			НС.ПериодДень = СтрокаТЗ.ПериодДень;
			НС.СуммаНачальныйОстаток_ПоДнямУПП = СтрокаТЗ.СуммаНачальныйОстаток_ПоДнямУПП;
			НС.СуммаПриход_ПоДнямУПП = СтрокаТЗ.СуммаПриход_ПоДнямУПП;
			НС.СуммаРасход_ПоДнямУПП = СтрокаТЗ.СуммаРасход_ПоДнямУПП;
			НС.СуммаКонечныйОстаток_ПоДнямУПП = СтрокаТЗ.СуммаКонечныйОстаток_ПоДнямУПП;
		Иначе
			НС.СуммаНачальныйОстаток_УПП = СтрокаТЗ.СуммаНачальныйОстаток_УПП;
			НС.СуммаПриход_УПП = СтрокаТЗ.СуммаПриход_УПП;
			НС.СуммаРасход_УПП = СтрокаТЗ.СуммаРасход_УПП;
			НС.СуммаКонечныйОстаток_УПП = СтрокаТЗ.СуммаКонечныйОстаток_УПП;
		КонецЕсли;

		// Зіставлення по UUID (BuhBud -> ERP)
		Попытка
			
			Если СокрЛП(СтрокаТЗ.СчетКод) = "315" Тогда
				Запрос_315 = Новый Запрос;
				Запрос_315.УстановитьПараметр("КодПоЕДРПОУ",СокрЛП(СтрокаТЗ.ОрганизацияКодПоЕДРПОУ));
				Запрос_315.УстановитьПараметр("А_СчетБухгалтерский",ПланыСчетов.Хозрасчетный.НайтиПоКоду("315"));
				Запрос_315.Текст = "ВЫБРАТЬ
				                   |	БанковскиеСчетаОрганизаций.Ссылка КАК Ссылка
				                   |ИЗ
				                   |	Справочник.БанковскиеСчетаОрганизаций КАК БанковскиеСчетаОрганизаций
				                   |ГДЕ
				                   |	БанковскиеСчетаОрганизаций.А_ОрганизацияБухгалтерия.КодПоЕДРПОУ = &КодПоЕДРПОУ
				                   |	И БанковскиеСчетаОрганизаций.А_СчетБухгалтерский = &А_СчетБухгалтерский
				                   |	И БанковскиеСчетаОрганизаций.А_ПоУмолчаниюДляПустыхСчетовИзБухгалтерии"		;
				ВыборкаЗапрос_315 = Запрос_315.Выполнить().Выбрать();
				Если ВыборкаЗапрос_315.Следующий() Тогда
					
					НС.БанковскийСчетКасса = ВыборкаЗапрос_315.Ссылка;	
					
				КонецЕсли;
			Иначе
				СсылкаБанкСчет = СтрокаТЗ.БанковскийСчетКасса;
				Если СтрокаТЗ.БанковскийСчетКасса <> Неопределено
					//И  V83.ЗначениеЗаполнено(СтрокаТЗ.БанковскийСчетКасса) 
					Тогда
					НС.БанковскийСчетКасса = А_Привилегированный.ПолучитьСправочникUID(
					"БанковскиеСчетаОрганизаций",
					V83.String(СтрокаТЗ.БанковскийСчетКасса.УникальныйИдентификатор()));
					
				Иначе			
				КонецЕсли;
			КонецЕсли;		
			
		Исключение
			// Якщо не вдалося знайти відповідність - залишаємо порожню посилку
		КонецПопытки;

		НС.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Безналичные;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

// ===========================================================================
// ФАЗА 2: Аналіз документів (через СоответствияОбъектовИнформационныхБаз)
// ===========================================================================

#Область Фаза2_АналізДокументів

// Головна функція Фази 2 — аналіз документів по масиву банківських рахунків
//
// Параметри:
//  МассивСчетов - Массив - СправочникСсылка.БанковскиеСчетаОрганизаций
//  НачПериодаАнализ, КонПериодаАнализ - Дата - період аналізу (день або весь період)
//
Функция АнализироватьДокументыПоСчетам(МассивСчетов, НачПериодаАнализ, КонПериодаАнализ) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ТаблицаДокументов.Очистить();

	V83 = ПодключитьсяКBuhBud();
	Если V83 = Неопределено Тогда
		Возврат "Помилка підключення до BuhBud";
	КонецЕсли;

	// Отримати вузол обміну в BuhBud
	УзелОбмена = Неопределено;
	Попытка
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20 ГДЕ НЕ ЭтотУзел";
		V83_Рез = V83_Запрос.Выполнить().Выбрать();
		Если V83_Рез.Следующий() Тогда
			УзелОбмена = V83_Рез.Ссылка;
		КонецЕсли;
	Исключение
		Сообщить("Не вдалося знайти вузол обміну в BuhBud: " + ОписаниеОшибки());
	КонецПопытки;

	Для Каждого СчетСсылка Из МассивСчетов Цикл
		Попытка
			АнализДокументов_ПоСчету(V83, СчетСсылка, НачПериодаАнализ, КонПериодаАнализ, УзелОбмена);
		Исключение
			Сообщить("ПОМИЛКА аналізу " + Строка(СчетСсылка) + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	// Ознака розбіжності — для відбору на формі. Окремо від галки вибору:
	// проблемні перекази мають порожню дію (рішення за бухгалтером), але це розбіжності
	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		СтрДок.ЕстьРасхождение = НЕ (СтрДок.Статус = "ОК" ИЛИ СтрДок.Статус = "Переказ: синхронно");
	КонецЦикла;

	V83 = Неопределено;
	Возврат "Документів для синхронізації: " + Строка(ТаблицаДокументов.Количество());

КонецФункции

// Аналіз документів по ВСІХ рахунках з розбіжностями за період обробки
//
Функция АнализироватьВсеРасхождения() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Данные = ПостроитьДанныеСравнения();
	Если Данные = Неопределено Тогда
		Возврат "Помилка підключення до BuhBud";
	КонецЕсли;

	// Звід 4 показників по рахунку: ЕРП мінус УПП
	Свод = Новый Соответствие;
	Для Каждого Стр Из Данные.БезналичныеДС_ЕРП Цикл
		Значения = Свод.Получить(Стр.БанковскийСчетКасса);
		Если Значения = Неопределено Тогда
			Значения = Новый Структура("Нач, Прих, Расх, Кон", 0, 0, 0, 0);
			Свод.Вставить(Стр.БанковскийСчетКасса, Значения);
		КонецЕсли;
		Значения.Нач  = Значения.Нач  + Стр.СуммаНачальныйОстаток_ЕРП;
		Значения.Прих = Значения.Прих + Стр.СуммаПриход_ЕРП;
		Значения.Расх = Значения.Расх + Стр.СуммаРасход_ЕРП;
		Значения.Кон  = Значения.Кон  + Стр.СуммаКонечныйОстаток_ЕРП;
	КонецЦикла;
	Для Каждого Стр Из Данные.БезналичныеДС_УПП Цикл
		Значения = Свод.Получить(Стр.БанковскийСчетКасса);
		Если Значения = Неопределено Тогда
			Значения = Новый Структура("Нач, Прих, Расх, Кон", 0, 0, 0, 0);
			Свод.Вставить(Стр.БанковскийСчетКасса, Значения);
		КонецЕсли;
		Значения.Нач  = Значения.Нач  - Стр.СуммаНачальныйОстаток_УПП;
		Значения.Прих = Значения.Прих - Стр.СуммаПриход_УПП;
		Значения.Расх = Значения.Расх - Стр.СуммаРасход_УПП;
		Значения.Кон  = Значения.Кон  - Стр.СуммаКонечныйОстаток_УПП;
	КонецЦикла;

	МассивСчетов = Новый Массив;
	Для Каждого КлючЗначение Из Свод Цикл
		Значения = КлючЗначение.Значение;
		Если ЗначениеЗаполнено(КлючЗначение.Ключ)
			И (Окр(Значения.Нач, 2) <> 0 ИЛИ Окр(Значения.Прих, 2) <> 0
				ИЛИ Окр(Значения.Расх, 2) <> 0 ИЛИ Окр(Значения.Кон, 2) <> 0) Тогда
			МассивСчетов.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Если МассивСчетов.Количество() = 0 Тогда
		ТаблицаДокументов.Очистить();
		Возврат "Розбіжностей не знайдено";
	КонецЕсли;

	Возврат "Рахунків з розбіжностями: " + Строка(МассивСчетов.Количество()) + ". "
		+ АнализироватьДокументыПоСчетам(МассивСчетов, НачалоПериода, КонецДня(ОкончаниеПериода));

КонецФункции

// Аналіз документів по одному банківському рахунку
//
Процедура АнализДокументов_ПоСчету(V83, БанковскийСчетСсылка, НачПериодаАнализ, КонПериодаАнализ, УзелОбмена)

	Если НЕ ЗначениеЗаполнено(БанковскийСчетСсылка) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Об.Регистратор КАК Регистратор,
	|	ПРЕДСТАВЛЕНИЕ(Об.Регистратор) КАК РегистраторПредст,
	|	Об.СуммаПриход КАК Приход,
	|	Об.СуммаРасход КАК Расход,
	|	ВЫРАЗИТЬ(Об.Регистратор КАК Документ.ПоступлениеБезналичныхДенежныхСредств).ХозяйственнаяОперация КАК ХозОперацияПоступления,
	|	ВЫРАЗИТЬ(Об.Регистратор КАК Документ.ПоступлениеБезналичныхДенежныхСредств).А_СписаниеБезналичныхДенежныхСредств КАК ПарноеСписание,
	|	ВЫРАЗИТЬ(Об.Регистратор КАК Документ.СписаниеБезналичныхДенежныхСредств).ХозяйственнаяОперация КАК ХозОперацияСписания,
	|	Соотв.УникальныйИдентификаторПриемника КАК UIDвBuhBud,
	|	Соотв.ТипПриемника КАК ТипПриемника,
	|	Соотв.ТипИсточника КАК ТипИсточника
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваБезналичные.Обороты(
	|		&НачалоПериода, &КонецПериода, Авто,
	|		БанковскийСчет = &БанковскийСчет) КАК Об
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
	|	ПО Об.Регистратор = Соотв.УникальныйИдентификаторИсточника
	|		И (Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20)";

	Запрос.УстановитьПараметр("НачалоПериода", НачПериодаАнализ);
	Запрос.УстановитьПараметр("КонецПериода", КонПериодаАнализ);
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчетСсылка);

	ТЗ_Док = Запрос.Выполнить().Выгрузить();

	// Банківський рахунок BuhBud (по IBAN) — для пер-рахункових потоків
	БанкРахунокBuhBud = НайтиБанкСчетBuhBud(V83, БанковскийСчетСсылка);

	// Обробка документів ERP
	ОбробитиДокументиЕРП(V83, ТЗ_Док, БанковскийСчетСсылка, УзелОбмена, БанкРахунокBuhBud);

	// Зворотна перевірка: документи BuhBud без ERP відповідника
	ПроверитьДокументыBuhBud(V83, ТЗ_Док, БанковскийСчетСсылка, НачПериодаАнализ, КонПериодаАнализ, БанкРахунокBuhBud);

КонецПроцедуры

// Пошук банківського рахунку BuhBud для рахунку ERP.
// Спочатку по UUID (обмін зберігає 1:1 — це обходить дублі та неточності IBAN),
// потім fallback по IBAN (для рахунків без двійника, напр. зведених 315).
//
// Повертає:
//  COMОбъект - посилання на Справочник.БанковскиеСчета в BuhBud, або Неопределено
//
Функция НайтиБанкСчетBuhBud(V83, БанковскийСчетСсылкаЕРП)

	// 1. По UUID (основний шлях)
	Попытка
		СсылкаUID = V83.Справочники.БанковскиеСчета.ПолучитьСсылку(
			V83.NewObject("УникальныйИдентификатор", Строка(БанковскийСчетСсылкаЕРП.УникальныйИдентификатор())));
		Если НЕ (СсылкаUID.ПолучитьОбъект() = Неопределено) Тогда
			Возврат СсылкаUID;
		КонецЕсли;
	Исключение
		// Перейдемо до пошуку по IBAN
	КонецПопытки;

	// 2. Fallback по IBAN
	Попытка
		IBAN = СокрЛП(БанковскийСчетСсылкаЕРП.НомерСчета);
		Если НЕ ЗначениеЗаполнено(IBAN) Тогда
			Возврат Неопределено;
		КонецЕсли;

		V83_ЗапрБанк = V83.NewObject("Запрос");
		V83_ЗапрБанк.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Ссылка, Наименование
		|ИЗ Справочник.БанковскиеСчета
		|ГДЕ НомерСчета = &НомерСчета
		|	И Наименование <> """"
		|	И Наименование НЕ ПОДОБНО ""%$$$%""
		|УПОРЯДОЧИТЬ ПО Наименование";
		V83_ЗапрБанк.УстановитьПараметр("НомерСчета", IBAN);
		V83_РезБанк = V83_ЗапрБанк.Выполнить().Выбрать();
		Если V83_РезБанк.Следующий() Тогда
			Возврат V83_РезБанк.Ссылка;
		КонецЕсли;
	Исключение
		// Рахунок не знайдено — пер-рахункові потоки будуть недоступні
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Зворотна перевірка: знайти документи BuhBud без ERP відповідника
// Вирішує проблему коли документ створений/проведений в BuhBud, але відсутній
// або непроведений в ERP (ручна проводка чи документ не перенесений обміном)
//
Процедура ПроверитьДокументыBuhBud(V83, ТЗ_ДокЕРП, БанковскийСчетСсылка, НачПериодаАнализ, КонПериодаАнализ, БанкРахунокBuhBud)

	Если БанкРахунокBuhBud = Неопределено Тогда
		Возврат; // BuhBud рахунок не знайдено за IBAN — зворотна перевірка неможлива
	КонецЕсли;

	Попытка
		// 1. Збираємо UUID всіх ERP регістраторів
		масUIDерп = Новый Соответствие;
		Для Каждого СтрДок Из ТЗ_ДокЕРП Цикл
			масUIDерп.Вставить(ВРег(Строка(СтрДок.Регистратор.УникальныйИдентификатор())), Истина);
			// Сторона приймача переказу: документ BuhBud має UUID ПАРНОГО Списання,
			// а не Поступлення, яке рухає цей рахунок — покриваємо пару
			Если ЗначениеЗаполнено(СтрДок.ПарноеСписание) Тогда
				масUIDерп.Вставить(ВРег(Строка(СтрДок.ПарноеСписание.УникальныйИдентификатор())), Истина);
			КонецЕсли;
		КонецЦикла;

		// 2. Запит BuhBud: ОстаткиИОбороты з періодичністю Регистратор та Субконто1 = банк.рахунок
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Регистратор КАК Регистратор,
		|	ПРЕДСТАВЛЕНИЕ(Т.Регистратор) КАК Представление,
		|	Т.СуммаОборотДт КАК Приход,
		|	Т.СуммаОборотКт КАК Расход
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		|		&НачалоПериода, &КонецПериода, Регистратор, ,
		|		Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках)), ,
		|		Субконто1 = &БанкРахунок) КАК Т";

		V83_Запрос.УстановитьПараметр("НачалоПериода", НачПериодаАнализ);
		V83_Запрос.УстановитьПараметр("КонецПериода", КонПериодаАнализ);
		V83_Запрос.УстановитьПараметр("БанкРахунок", БанкРахунокBuhBud);

		V83_Рез = V83_Запрос.Выполнить().Выбрать();

		// 3. Для кожного регістратора: якщо немає в ERP оборотах — кандидат на синхронізацію
		Пока V83_Рез.Следующий() Цикл
			Попытка
				Рег = V83_Рез.Регистратор;
				Если НЕ V83.ЗначениеЗаполнено(Рег) Тогда Продолжить; КонецЕсли;
				// V83.XMLСтрока: COM UUID з BuhBud не конвертується локальною функцією
				УИД = ВРег(V83.XMLСтрока(Рег.УникальныйИдентификатор()));
			Исключение
				Продолжить;
			КонецПопытки;

			// Пропустити якщо вже є в ERP
			Если масUIDерп[УИД] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			// Чистий потік по рахунку: Приход(Дт) - Расход(Кт)
			ПриходБух = 0;
			РасходБух = 0;
			Попытка ПриходБух = V83_Рез.Приход; Исключение КонецПопытки;
			Попытка РасходБух = V83_Рез.Расход; Исключение КонецПопытки;
			Сума = ПриходБух - РасходБух;

			// Пропустити якщо чистий потік = 0 по цьому рахунку
			Если Окр(Сума, 2) = 0 Тогда Продолжить; КонецЕсли;

			// Тип документа BuhBud — потрібен Фазі 3 для отримання посилання
			ТипБух = "";
			Попытка
				ТипБух = V83.String(Рег.Метаданные().Имя);
			Исключение
				// COM-помилка читання метаданих — тип залишиться порожнім,
				// Фаза 3 поверне по такому рядку помилку з поясненням
			КонецПопытки;

			// Перевірити відповідність в ЕРП (документ може існувати, але бути непроведеним)
			ДокЕРПСсылка = Неопределено;
			UIDДокЕРП = "";
			ЕстьВідповідність = Ложь;
			ДіяДок = "На обмін в BuhBud";
			СтатусДок = "Тільки в BuhBud (немає в ЕРП)";
			Попытка
				ЗапросСоотв = Новый Запрос;
				ЗапросСоотв.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Соотв.УникальныйИдентификаторИсточника КАК Источник
				|ИЗ
				|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
				|ГДЕ
				|	Соотв.УникальныйИдентификаторПриемника = &UIDПриемника
				|	И Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20";
				ЗапросСоотв.УстановитьПараметр("UIDПриемника", УИД);
				РезСоотв = ЗапросСоотв.Выполнить().Выбрать();
				Если РезСоотв.Следующий() Тогда
					ЕстьВідповідність = Истина;
					ДокЕРПСсылка = РезСоотв.Источник;
					UIDДокЕРП = Строка(РезСоотв.Источник.УникальныйИдентификатор());

					// Якщо ERP-відповідник — переказ між власними рахунками, рухи по цьому
					// рахунку в ERP робить ПАРНЕ Поступлення. Раз пара не покрила цей UUID,
					// у Поступлення порожній А_Списание — це питання зв'язки, не переобміну
					ОперацияИсточника = Неопределено;
					Попытка
						ОперацияИсточника = РезСоотв.Источник.ХозяйственнаяОперация;
					Исключение
						// Тип без ХозяйственнаяОперация — не переказ
					КонецПопытки;

					Если ОперацияИсточника = Перечисления.ХозяйственныеОперации.ПеречислениеДенежныхСредствНаДругойСчет
						ИЛИ ОперацияИсточника = Перечисления.ХозяйственныеОперации.ПоступлениеДенежныхСредствСДругогоСчета Тогда
						ДіяДок = "";
						СтатусДок = "Переказ: вхідна сторона в ЕРП не зв'язана (перевірте А_Списание у Поступлення)";
					ИначеЕсли РезСоотв.Источник.Проведен Тогда
						ДіяДок = "Переобмін";
						СтатусДок = "Проведений в ЕРП, немає рухів по рахунку";
					Иначе
						ДіяДок = "Провести в ЕРП";
						СтатусДок = "Не проведений в ЕРП";
					КонецЕсли;
				КонецЕсли;
			Исключение
				// Помилка пошуку відповідності — залишаємо дію "На обмін в BuhBud"
			КонецПопытки;

			// 4. Додати в ТаблицаДокументов
			НС = ТаблицаДокументов.Добавить();
			НС.БанковскийСчет      = БанковскийСчетСсылка;
			НС.ТипДокумента        = ТипБух;
			НС.ДокументЕРП         = ?(ДокЕРПСсылка <> Неопределено, ДокЕРПСсылка, "");
			НС.ДокументБух         = СокрЛП(V83.String(V83_Рез.Представление));
			НС.СуммаБух            = Сума;
			НС.UIDДокумента        = UIDДокЕРП;
			НС.UIDДокументаБух     = УИД;
			НС.ЕстьСоответствие    = ЕстьВідповідність;
			НС.Действие            = ДіяДок;
			НС.Статус              = СтатусДок;
			НС.Синхронизировать    = ЗначениеЗаполнено(ДіяДок);
		КонецЦикла;

	Исключение
		Сообщить("Помилка зворотньої перевірки BuhBud: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Обробка документів ERP: для кожного перевіряє відповідність в BuhBud та визначає дію
//
Процедура ОбробитиДокументиЕРП(V83, ТЗ_Док, БанковскийСчетСсылка, УзелОбмена, БанкРахунокBuhBud)

	Для Каждого СтрДок Из ТЗ_Док Цикл

		НС = ТаблицаДокументов.Добавить();
		НС.БанковскийСчет      = БанковскийСчетСсылка;
		НС.ДокументЕРП     = СтрДок.Регистратор;
		НС.СуммаЕРП        = СтрДок.Приход - СтрДок.Расход;
		НС.UIDДокумента    = Строка(СтрДок.Регистратор.УникальныйИдентификатор());
		НС.Синхронизировать = Истина;

		// Визначити тип документа ERP
		ТипИст = "";
		Попытка
			ТипИст = СокрЛП(СтрДок.ТипИсточника);
			ТипИст = СтрЗаменить(ТипИст, "ДокументСсылка.", "");
		Исключение
		КонецПопытки;
		Если НЕ ЗначениеЗаполнено(ТипИст) Тогда
			// НЕ присваивать через змінну "МетаДанные" — в модулі об'єкта це ім'я
			// конфліктує з членом об'єкта (помилка "Поле объекта недоступно для записи")
			ТипИст = СтрДок.Регистратор.Метаданные().Имя;
		КонецЕсли;
		НС.ТипДокумента = ТипИст;

		// Переказ між власними рахунками — НЕ помилка, в базах він відображається по-різному:
		// ERP: ДВА документи через транзит 3331 (Списання Дт3331/Кт311 + Поступлення Дт311/Кт3331,
		//      пара зв'язана реквізитом А_СписаниеБезналичныхДенежныхСредств);
		// BuhBud: ОДИН документ з прямою проводкою Дт311-приймач/Кт311-джерело (UUID = UUID Списання).
		// Звіряємо як пару по аналізованому рахунку, автоматичних дій не пропонуємо.
		ЭтоСписаниеПеревод = (СтрДок.ХозОперацияСписания =
			Перечисления.ХозяйственныеОперации.ПеречислениеДенежныхСредствНаДругойСчет);
		ЭтоПоступлениеПеревод = (СтрДок.ХозОперацияПоступления =
			Перечисления.ХозяйственныеОперации.ПоступлениеДенежныхСредствСДругогоСчета);

		Если ЭтоСписаниеПеревод ИЛИ ЭтоПоступлениеПеревод Тогда

			НС.Действие = "";
			НС.Синхронизировать = Ложь;

			UIDБухПеревода = "";
			Если ЭтоСписаниеПеревод Тогда
				// Кт-сторона: документ BuhBud має UUID самого Списання (обмін 1:1).
				// Запис відповідності не обов'язковий — шукаємо прямим UUID
				Если ЗначениеЗаполнено(СтрДок.UIDвBuhBud) Тогда
					UIDБухПеревода = СокрЛП(Строка(СтрДок.UIDвBuhBud));
					НС.ЕстьСоответствие = Истина;
				Иначе
					UIDБухПеревода = НС.UIDДокумента;
				КонецЕсли;
			Иначе
				// Дт-сторона: документ BuhBud знаходиться через парне Списання
				Если ЗначениеЗаполнено(СтрДок.ПарноеСписание) Тогда
					UIDБухПеревода = Строка(СтрДок.ПарноеСписание.УникальныйИдентификатор());
				Иначе
					НС.Статус = "Переказ: пару не знайдено (порожнє А_СписаниеБезналичныхДенежныхСредств)";
					Продолжить;
				КонецЕсли;
			КонецЕсли;

			ПроверитьПереводВBuhBud(V83, НС, UIDБухПеревода, БанкРахунокBuhBud, НС.СуммаЕРП);
			Продолжить;

		КонецЕсли;

		// Перевірка наявності відповідності
		UIDвBuhBud = Неопределено;
		Попытка
			UIDвBuhBud = СтрДок.UIDвBuhBud;
		Исключение
		КонецПопытки;

		Если UIDвBuhBud <> Неопределено И ЗначениеЗаполнено(UIDвBuhBud) Тогда
			// Є відповідність — перевіряємо стан документа в BuhBud
			НС.ЕстьСоответствие = Истина;
			НС.UIDДокументаБух  = Строка(UIDвBuhBud);

			ТипПрием = "";
			Попытка
				ТипПрием = СокрЛП(СтрДок.ТипПриемника);
				ТипПрием = СтрЗаменить(ТипПрием, "ДокументСсылка.", "");
			Исключение
			КонецПопытки;

			Если ЗначениеЗаполнено(ТипПрием) Тогда
				ПроверитьДокументВBuhBud(V83, НС, ТипПрием, UIDвBuhBud, УзелОбмена, БанкРахунокBuhBud);
			Иначе
				НС.Действие = "Невідомий тип";
				НС.Статус   = "Тип приемника не визначено";
			КонецЕсли;
		Иначе
			// Немає відповідності — документ ніколи не відправлявся
			НС.ЕстьСоответствие = Ложь;
			НС.Действие = "Розпровести в ЕРП";
			НС.Статус   = "Немає в BuhBud (немає відповідності)";
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Перевірка переказу між власними рахунками в BuhBud:
// стан документа + пер-рахунковий потік Дт(X)-Кт(X) проти очікуваного потоку ERP
//
Процедура ПроверитьПереводВBuhBud(V83, НС, UIDБухСтрока, БанкРахунокBuhBud, ОжидаемыйПоток)

	НС.UIDДокументаБух = UIDБухСтрока;

	// Тип документа BuhBud — з відповідності; fallback на правило обміну
	ТипПриемника = "СписаниеСРасчетногоСчета";
	Попытка
		ЗапросТип = Новый Запрос;
		ЗапросТип.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Соотв.ТипПриемника КАК ТипПриемника
		|ИЗ
		|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
		|ГДЕ
		|	Соотв.УникальныйИдентификаторПриемника = &UIDПриемника
		|	И Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20";
		ЗапросТип.УстановитьПараметр("UIDПриемника", UIDБухСтрока);
		РезТип = ЗапросТип.Выполнить().Выбрать();
		Если РезТип.Следующий() И ЗначениеЗаполнено(РезТип.ТипПриемника) Тогда
			ТипПриемника = СтрЗаменить(СокрЛП(РезТип.ТипПриемника), "ДокументСсылка.", "");
		КонецЕсли;
	Исключение
		// Залишаємо тип за правилом обміну
	КонецПопытки;

	Попытка
		СсылкаBuhBud = V83.Документы[ТипПриемника].ПолучитьСсылку(
			V83.NewObject("УникальныйИдентификатор", UIDБухСтрока));

		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст =
			"ВЫБРАТЬ Ссылка, Проведен, ПометкаУдаления, ПРЕДСТАВЛЕНИЕ(Ссылка) КАК Представление ИЗ Документ." + ТипПриемника
			+ " ГДЕ Ссылка = &Ссылка";
		V83_Запрос.УстановитьПараметр("Ссылка", СсылкаBuhBud);
		V83_Рез = V83_Запрос.Выполнить().Выбрать();

		Если НЕ V83_Рез.Следующий() Тогда
			НС.Статус = "Переказ: документ не знайдено в Бух";
			Возврат;
		КонецЕсли;

		НС.ДокументБух = СокрЛП(V83_Рез.Представление);

		Если V83_Рез.ПометкаУдаления Тогда
			НС.Статус = "Переказ: видалений в Бух";
			Возврат;
		ИначеЕсли НЕ V83_Рез.Проведен Тогда
			НС.Статус = "Переказ: не проведений в Бух";
			Возврат;
		КонецЕсли;

		Если БанкРахунокBuhBud = Неопределено Тогда
			НС.Статус = "Переказ: рахунок BuhBud не знайдено за IBAN";
			Возврат;
		КонецЕсли;

		ПотокБух = ПотокДокументаПоСчетуBuhBud(V83, СсылкаBuhBud, БанкРахунокBuhBud);
		НС.СуммаБух = ПотокБух;

		Если Окр(ОжидаемыйПоток - ПотокБух, 2) = 0 Тогда
			НС.Статус = "Переказ: синхронно";
		Иначе
			НС.Статус = "Переказ: розбіжність суми (Бух = " + Строка(ПотокБух) + ")";
		КонецЕсли;

	Исключение
		НС.Статус = "Переказ: помилка COM: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Потік документа BuhBud по конкретному банківському рахунку: Дт(X) - Кт(X)
// Через ДвиженияССубконто — пряме звернення до СубконтоДт1/СубконтоКт1 в запиті неможливе
//
Функция ПотокДокументаПоСчетуBuhBud(V83, СсылкаBuhBud, БанкРахунокBuhBud)

	V83_ЗапросКол = V83.NewObject("Запрос");
	V83_ЗапросКол.Текст =
	"ВЫБРАТЬ
	|	СУММА(Т.Приход) - СУММА(Т.Расход) КАК Сумма
	|ИЗ
	|	(ВЫБРАТЬ Д.Сумма КАК Приход, 0 КАК Расход
	|	ИЗ РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(, , Регистратор = &Регистратор, , ) КАК Д
	|	ГДЕ Д.СчетДт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках))
	|		И Д.СубконтоДт1 = &БанкРахунок
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ 0, Д.Сумма
	|	ИЗ РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(, , Регистратор = &Регистратор, , ) КАК Д
	|	ГДЕ Д.СчетКт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках))
	|		И Д.СубконтоКт1 = &БанкРахунок) КАК Т";
	V83_ЗапросКол.УстановитьПараметр("Регистратор", СсылкаBuhBud);
	V83_ЗапросКол.УстановитьПараметр("БанкРахунок", БанкРахунокBuhBud);

	Результат = 0;
	V83_РезКол = V83_ЗапросКол.Выполнить().Выбрать();
	Если V83_РезКол.Следующий() И V83.ЗначениеЗаполнено(V83_РезКол.Сумма) Тогда
		Результат = V83_РезКол.Сумма;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Перевірка документа в BuhBud через COM
//
Процедура ПроверитьДокументВBuhBud(V83, НС, ТипПриемника, UIDвBuhBud, УзелОбмена, БанкРахунокBuhBud)

	Попытка
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст =
			"ВЫБРАТЬ Ссылка, Проведен, ПометкаУдаления, ПРЕДСТАВЛЕНИЕ(Ссылка) КАК Представление ИЗ Документ." + ТипПриемника
			+ " ГДЕ Ссылка = &Ссылка";

		СсылкаBuhBud = V83.Документы[ТипПриемника].ПолучитьСсылку(
			V83.NewObject("УникальныйИдентификатор", Строка(UIDвBuhBud)));
		V83_Запрос.УстановитьПараметр("Ссылка", СсылкаBuhBud);

		V83_Рез = V83_Запрос.Выполнить().Выбрать();
		Если V83_Рез.Следующий() Тогда
			НС.ДокументБух = СокрЛП(V83_Рез.Представление);

			Если V83_Рез.ПометкаУдаления Тогда
				// Документ видалено в BuhBud
				НС.Действие = "Розпровести в ЕРП";
				НС.Статус   = "Видалений в BuhBud";
			ИначеЕсли НЕ V83_Рез.Проведен Тогда
				// Документ не проведений в BuhBud — поставити на обмін
				НС.Действие = "На обмін в BuhBud";
				НС.Статус   = "Не проведений в BuhBud";
				НС.ТипДокумента = ТипПриемника;
			Иначе
				// Проведений — розбіжність в рухах, потребує аналізу
				НС.Действие = "Переобмін";
				НС.Статус   = "Проведений, різниця в рухах";
				НС.ТипДокумента = ТипПриемника;
			КонецЕсли;

			// Отримати потік документа ПО АНАЛІЗОВАНОМУ РАХУНКУ: Дт(X) - Кт(X).
			// Нетто по всіх СчетаВБанках некоректне для документів, що рухають
			// два банківські рахунки (перекази, купівля/продаж валюти)
			Попытка
				Если БанкРахунокBuhBud <> Неопределено Тогда
					НС.СуммаБух = ПотокДокументаПоСчетуBuhBud(V83, СсылкаBuhBud, БанкРахунокBuhBud);
				Иначе
					// Рахунок BuhBud не знайдено за IBAN — fallback: нетто по всіх банках
					V83_ЗапросКол = V83.NewObject("Запрос");
					V83_ЗапросКол.Текст =
					"ВЫБРАТЬ
					|	СУММА(Т.Приход) - СУММА(Т.Расход) КАК Сумма
					|ИЗ
					|	(ВЫБРАТЬ Д.Сумма КАК Приход, 0 КАК Расход
					|	ИЗ РегистрБухгалтерии.Хозрасчетный КАК Д
					|	ГДЕ Д.Регистратор = &Регистратор
					|		И Д.СчетДт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках))
					|
					|	ОБЪЕДИНИТЬ ВСЕ
					|
					|	ВЫБРАТЬ 0, Д.Сумма
					|	ИЗ РегистрБухгалтерии.Хозрасчетный КАК Д
					|	ГДЕ Д.Регистратор = &Регистратор
					|		И Д.СчетКт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках))) КАК Т";
					V83_ЗапросКол.УстановитьПараметр("Регистратор", СсылкаBuhBud);
					V83_РезКол = V83_ЗапросКол.Выполнить().Выбрать();
					Если V83_РезКол.Следующий() Тогда
						НС.СуммаБух = V83_РезКол.Сумма;
					КонецЕсли;
				КонецЕсли;
			Исключение
				// Не вдалось отримати суму з BuhBud — залишаємо 0
			КонецПопытки;

			// Якщо суми співпадають — документ ОК, не потребує дії
			Если НС.Действие = "Переобмін"
				И Окр(НС.СуммаЕРП - НС.СуммаБух, 2) = 0 Тогда
				НС.Действие = "";
				НС.Статус   = "ОК";
				НС.Синхронизировать = Ложь;
			КонецЕсли;

		Иначе
			// Документ не знайдено — видалений або UUID невірний
			НС.Действие = "Розпровести в ЕРП";
			НС.Статус   = "Не знайдено в BuhBud";
		КонецЕсли;
	Исключение
		НС.Действие = "Помилка";
		НС.Статус   = "Помилка COM: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

// ===========================================================================
// ФАЗА 3: Синхронізація
// ===========================================================================

#Область Фаза3_Синхронізація

// Головна функція Фази 3 — виконання синхронізації
//
Функция ВыполнитьСинхронизацию() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	V83 = Неопределено;
	УзелОбмена = Неопределено;
	КількістьОброблених = 0;
	КількістьПомилок    = 0;

	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если НЕ СтрДок.Синхронизировать Тогда
			Продолжить;
		КонецЕсли;

		Если СтрДок.Действие = "Розпровести в ЕРП" Тогда
			// Отменити проведення документа в ЕРП
			Попытка
				РаспровестиВЕРП(СтрДок);
				КількістьОброблених = КількістьОброблених + 1;
			Исключение
				СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
				КількістьПомилок = КількістьПомилок + 1;
			КонецПопытки;

		ИначеЕсли СтрДок.Действие = "Провести в ЕРП" Тогда
			// Провести непроведений документ в ЕРП
			Попытка
				ПровестиВЕРП(СтрДок);
				КількістьОброблених = КількістьОброблених + 1;
			Исключение
				СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
				КількістьПомилок = КількістьПомилок + 1;
			КонецПопытки;

		ИначеЕсли СтрДок.Действие = "На обмін в BuhBud"
			ИЛИ СтрДок.Действие = "Переобмін" Тогда

			// Ліниве підключення до BuhBud (тільки якщо потрібно)
			Если V83 = Неопределено Тогда
				V83 = ПодключитьсяКBuhBud();
				Если V83 = Неопределено Тогда
					СтрДок.Статус = "ПОМИЛКА: Немає підключення до BuhBud";
					КількістьПомилок = КількістьПомилок + 1;
					Продолжить;
				КонецЕсли;
				// Знайти вузол обміну
				Попытка
					V83_З = V83.NewObject("Запрос");
					V83_З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20 ГДЕ НЕ ЭтотУзел";
					V83_Рез = V83_З.Выполнить().Выбрать();
					Если V83_Рез.Следующий() Тогда
						УзелОбмена = V83_Рез.Ссылка;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;

			Попытка
				ПоставитьНаОбменВBuhBud(V83, СтрДок, УзелОбмена);
				КількістьОброблених = КількістьОброблених + 1;
			Исключение
				СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
				КількістьПомилок = КількістьПомилок + 1;
			КонецПопытки;

		КонецЕсли;
	КонецЦикла;

	V83 = Неопределено;

	Возврат "Оброблено: " + КількістьОброблених + ", Помилок: " + КількістьПомилок;

КонецФункции

// Розпровести документ в ЕРП
//
Процедура РаспровестиВЕРП(СтрДок)

	UIDСтрока = СокрЛП(СтрДок.UIDДокумента);
	Если НЕ ЗначениеЗаполнено(UIDСтрока) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа";
		Возврат;
	КонецЕсли;

	// Знайти документ по UUID
	ТипДок = СокрЛП(СтрДок.ТипДокумента);
	МенеджерДок = Документы[ТипДок];
	СсылкаДок = МенеджерДок.ПолучитьСсылку(Новый УникальныйИдентификатор(UIDСтрока));

	Если НЕ ЗначениеЗаполнено(СсылкаДок) ИЛИ СсылкаДок.Пустая() Тогда
		СтрДок.Статус = "ПОМИЛКА: Документ не знайдено в ЕРП";
		Возврат;
	КонецЕсли;

	ДокОбъект = СсылкаДок.ПолучитьОбъект();
	ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	СтрДок.Статус = "Розпроведено в ЕРП";

КонецПроцедуры

// Провести непроведений документ в ЕРП
//
Процедура ПровестиВЕРП(СтрДок)

	UIDСтрока = СокрЛП(СтрДок.UIDДокумента);
	Если НЕ ЗначениеЗаполнено(UIDСтрока) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа ЕРП";
		Возврат;
	КонецЕсли;

	// Знайти документ ЕРП по UUID через СоответствияОбъектовИнформационныхБаз
	Попытка
		ЗапросТип = Новый Запрос;
		ЗапросТип.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Соотв.УникальныйИдентификаторИсточника КАК Источник,
		|	Соотв.ТипИсточника КАК ТипИсточника
		|ИЗ
		|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
		|ГДЕ
		|	Соотв.УникальныйИдентификаторПриемника = &UIDПриемника
		|	И Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20";
		ЗапросТип.УстановитьПараметр("UIDПриемника", СокрЛП(СтрДок.UIDДокументаБух));
		РезТип = ЗапросТип.Выполнить().Выбрать();
		Если РезТип.Следующий() Тогда
			ДокОбъект = РезТип.Источник.ПолучитьОбъект();
			Если ДокОбъект = Неопределено Тогда
				СтрДок.Статус = "ПОМИЛКА: Документ не знайдено в ЕРП";
				Возврат;
			КонецЕсли;
			Если ДокОбъект.Проведен Тогда
				СтрДок.Статус = "Вже проведений";
				Возврат;
			КонецЕсли;
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			СтрДок.Статус = "Проведено в ЕРП";
		Иначе
			СтрДок.Статус = "ПОМИЛКА: Відповідність не знайдена";
		КонецЕсли;
	Исключение
		СтрДок.Статус = "ПОМИЛКА проведення: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Поставити документ на обмін в BuhBud
//
Процедура ПоставитьНаОбменВBuhBud(V83, СтрДок, УзелОбмена)

	Если УзелОбмена = Неопределено Тогда
		СтрДок.Статус = "ПОМИЛКА: Вузол обміну не знайдено";
		Возврат;
	КонецЕсли;

	UIDСтрока = СокрЛП(СтрДок.UIDДокументаБух);
	Если НЕ ЗначениеЗаполнено(UIDСтрока) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа в BuhBud";
		Возврат;
	КонецЕсли;

	// ТипДокумента містить тип BuhBud (встановлений на етапі аналізу)
	ТипПриемника = СокрЛП(СтрДок.ТипДокумента);

	// Отримати посилання на документ в BuhBud
	СсылкаBuhBud = V83.Документы[ТипПриемника].ПолучитьСсылку(
		V83.NewObject("УникальныйИдентификатор", UIDСтрока));

	// Зареєструвати зміни на вузлі обміну
	V83.ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, СсылкаBuhBud);
	СтрДок.Статус = "Зареєстровано на обмін в BuhBud";

КонецПроцедуры

#КонецОбласти
