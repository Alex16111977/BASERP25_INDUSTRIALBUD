
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Объект.НачалоПериода    = НачалоМесяца(ТекущаяДатаСеанса());
	Объект.ОкончаниеПериода = КонецМесяца(ТекущаяДатаСеанса());

	НастроитьУсловноеОформление();

КонецПроцедуры

&НаСервере
Процедура НастроитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	// Рядки документів зі «спокійним» статусом (все зійшлося) — сірі.
	// Розбіжності переказів (Дія порожня, але статус говорить про проблему) лишаються чорними.
	СписокСпокойных = Новый СписокЗначений;
	СписокСпокойных.Добавить("ОК");
	СписокСпокойных.Добавить("Переказ: синхронно");
	Элемент = УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаДокументовФорма");
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ТаблицаДокументов.Статус");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
	Отбор.ПравоеЗначение = СписокСпокойных;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);

	// Помилки — червоним
	Элемент = УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаДокументовФорма");
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ТаблицаДокументов.Статус");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.НачинаетсяС;
	Отбор.ПравоеЗначение = "ПОМИЛКА";
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);

	// Успішно виконані дії — зеленим
	СписокУспех = Новый СписокЗначений;
	СписокУспех.Добавить("Розпроведено в ЕРП");
	СписокУспех.Добавить("Проведено в ЕРП");
	СписокУспех.Добавить("Зареєстровано на обмін в BuhBud");
	Элемент = УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаДокументовФорма");
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ТаблицаДокументов.Статус");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
	Отбор.ПравоеЗначение = СписокУспех;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.ЗеленыйЛес);

КонецПроцедуры

// === КОМАНДЫ ===

&НаКлиенте
Процедура Сформировать(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		ПоказатьПредупреждение(, "Вкажіть період!");
		Возврат;
	КонецЕсли;

	СформироватьНаСервере();

КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()

	мОбъект = РеквизитФормыВЗначение("Объект");

	Данные = мОбъект.ПостроитьДанныеСравнения();
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Схема = мОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");

	Настройки = Схема.НастройкиПоУмолчанию;

	Период = Новый СтандартныйПериод;
	Период.ДатаНачала    = НачалоДня(Объект.НачалоПериода);
	Период.ДатаОкончания = КонецДня(Объект.ОкончаниеПериода);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", Период);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПоДням", Объект.ПоДням);

	Если ЗначениеЗаполнено(Объект.ФильтрБанковскийСчет) Тогда
		Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("БанковскийСчетКасса");
		Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		Отбор.ПравоеЗначение = Объект.ФильтрБанковскийСчет;
		Отбор.Использование  = Истина;
	КонецЕсли;

	ДанныеРасшифровкиОбъект = Неопределено;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, ДанныеРасшифровкиОбъект);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, Данные, ДанныеРасшифровкиОбъект);

	РезультатСКД.Очистить();
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(РезультатСКД);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

	АдресРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровкиОбъект, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура АнализВсехРасхождений(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		ПоказатьПредупреждение(, "Вкажіть період!");
		Возврат;
	КонецЕсли;

	АнализВсехРасхожденийНаСервере();
	ПрименитьФильтрДокументов();

КонецПроцедуры

&НаСервере
Процедура АнализВсехРасхожденийНаСервере()

	мОбъект = РеквизитФормыВЗначение("Объект");
	Итог = мОбъект.АнализироватьВсеРасхождения();
	ЗначениеВРеквизитФормы(мОбъект, "Объект");

	СчетОтбораДокументов = Справочники.БанковскиеСчетаОрганизаций.ПустаяСсылка();
	Сообщить(Итог);

КонецПроцедуры

&НаКлиенте
Процедура Синхронизировать(Команда)

	// Проверяем что есть выбранные документы
	КоличествоВыбранных = 0;
	Для Каждого Стр Из Объект.ТаблицаДокументов Цикл
		Если Стр.Синхронизировать Тогда
			КоличествоВыбранных = КоличествоВыбранных + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоВыбранных = 0 Тогда
		ПоказатьПредупреждение(, "Оберіть документи для синхронізації!");
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения("СинхронизироватьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения,
		"Синхронізувати " + КоличествоВыбранных + " документ(ів)?" + Символы.ПС
		+ "Операція може розпровести документи в ЕРП або зареєструвати на обмін в BuhBud.",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		СинхронизироватьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СинхронизироватьНаСервере()

	мОбъект = РеквизитФормыВЗначение("Объект");
	мОбъект.ВыполнитьСинхронизацию();
	ЗначениеВРеквизитФормы(мОбъект, "Объект");

КонецПроцедуры

// === РАСШИФРОВКА СКД ===

&НаКлиенте
Процедура РезультатСКДОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	РасшифроватьНаСервере(Расшифровка);
	ПрименитьФильтрДокументов();

КонецПроцедуры

&НаСервере
Процедура РасшифроватьНаСервере(ИдРасшифровки)

	Если НЕ ЗначениеЗаполнено(АдресРасшифровки) Тогда
		Возврат;
	КонецЕсли;

	ДанныеРасш = ПолучитьИзВременногоХранилища(АдресРасшифровки);
	Если ДанныеРасш = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Счет = ЗначениеПоляРасшифровки(ДанныеРасш, ИдРасшифровки, "БанковскийСчетКасса");
	День = ЗначениеПоляРасшифровки(ДанныеРасш, ИдРасшифровки, "ПериодДень");

	Если НЕ ЗначениеЗаполнено(Счет) Тогда
		Сообщить("Оберіть комірку рядка банківського рахунку");
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(День) Тогда
		НачП = НачалоДня(День);
		КонП = КонецДня(День);
	Иначе
		НачП = НачалоДня(Объект.НачалоПериода);
		КонП = КонецДня(Объект.ОкончаниеПериода);
	КонецЕсли;

	МассивСчетов = Новый Массив;
	МассивСчетов.Добавить(Счет);

	мОбъект = РеквизитФормыВЗначение("Объект");
	Итог = мОбъект.АнализироватьДокументыПоСчетам(МассивСчетов, НачП, КонП);
	ЗначениеВРеквизитФормы(мОбъект, "Объект");

	СчетОтбораДокументов = Счет;
	Сообщить(Строка(Счет) + ": " + Итог);

КонецПроцедуры

// Пошук значення поля у елементі розшифровки та його батьках (обхід вгору)
//
&НаСервереБезКонтекста
Функция ЗначениеПоляРасшифровки(ДанныеРасш, ИдРасшифровки, ИмяПоля)

	Очередь = Новый Массив;
	Очередь.Добавить(ДанныеРасш.Элементы[ИдРасшифровки]);

	Пока Очередь.Количество() > 0 Цикл
		ЭлементРасш = Очередь[0];
		Очередь.Удалить(0);

		Если ТипЗнч(ЭлементРасш) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
			ЗначениеПоля = ЭлементРасш.ПолучитьПоля().Найти(ИмяПоля);
			Если ЗначениеПоля <> Неопределено Тогда
				Возврат ЗначениеПоля.Значение;
			КонецЕсли;
		КонецЕсли;

		Для Каждого Родитель Из ЭлементРасш.ПолучитьРодителей() Цикл
			Очередь.Добавить(Родитель);
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// === ОБРАБОТЧИКИ ТАБЛИЦ ===

&НаКлиенте
Процедура ТаблицаДокументовФормаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Стр = Объект.ТаблицаДокументов.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Стр <> Неопределено
		И ТипЗнч(Стр.ДокументЕРП) <> Тип("Строка")
		И ЗначениеЗаполнено(Стр.ДокументЕРП) Тогда
		ПоказатьЗначение(, Стр.ДокументЕРП);
	КонецЕсли;

КонецПроцедуры

// === ОБРАБОТЧИКИ ИЗМЕНЕНИЙ ===

&НаКлиенте
Процедура ПоказыватьТолькоРасхожденияПриИзменении(Элемент)

	ПрименитьФильтрДокументов();

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьФильтрДокументов()

	// Комбінований відбір: рахунок останньої розшифровки + прапорець "Тільки розбіжності"
	СтруктураОтбора = Новый Структура;

	Если ЗначениеЗаполнено(СчетОтбораДокументов) Тогда
		СтруктураОтбора.Вставить("БанковскийСчет", СчетОтбораДокументов);
	КонецЕсли;

	Если Объект.ПоказыватьТолькоРасхождения Тогда
		// По ознаці розбіжності, НЕ по галці вибору: проблемні перекази мають
		// порожню дію і зняту галку, але ховати їх не можна
		СтруктураОтбора.Вставить("ЕстьРасхождение", Истина);
	КонецЕсли;

	Если СтруктураОтбора.Количество() = 0 Тогда
		Элементы.ТаблицаДокументовФорма.ОтборСтрок = Неопределено;
	Иначе
		Элементы.ТаблицаДокументовФорма.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбора);
	КонецЕсли;

КонецПроцедуры
