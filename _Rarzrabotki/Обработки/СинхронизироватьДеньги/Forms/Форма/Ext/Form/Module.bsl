
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Объект.НачалоПериода    = НачалоМесяца(ТекущаяДатаСеанса());
	Объект.ОкончаниеПериода = КонецМесяца(ТекущаяДатаСеанса());

	НастроитьУсловноеОформление();

КонецПроцедуры

&НаСервере
Процедура НастроитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	// Рядки розбіжностей, зняті з синхронізації — сірі
	Элемент = УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаРасхожденийФорма");
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ТаблицаРасхождений.Синхронизировать");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Ложь;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);

	// Рядки документів зі «спокійним» статусом (все зійшлося) — сірі.
	// Розбіжності переказів (Дія порожня, але статус говорить про проблему) лишаються чорними.
	СписокСпокойных = Новый СписокЗначений;
	СписокСпокойных.Добавить("ОК");
	СписокСпокойных.Добавить("Переказ: синхронно");
	Элемент = УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаДокументовФорма");
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ТаблицаДокументов.Статус");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
	Отбор.ПравоеЗначение = СписокСпокойных;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);

	// Помилки — червоним
	Элемент = УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаДокументовФорма");
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ТаблицаДокументов.Статус");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.НачинаетсяС;
	Отбор.ПравоеЗначение = "ПОМИЛКА";
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);

	// Успішно виконані дії — зеленим
	СписокУспех = Новый СписокЗначений;
	СписокУспех.Добавить("Розпроведено в ЕРП");
	СписокУспех.Добавить("Проведено в ЕРП");
	СписокУспех.Добавить("Зареєстровано на обмін в BuhBud");
	Элемент = УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаДокументовФорма");
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ТаблицаДокументов.Статус");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
	Отбор.ПравоеЗначение = СписокУспех;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.ЗеленыйЛес);

КонецПроцедуры

// === КОМАНДЫ ===

&НаКлиенте
Процедура Сформировать(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		ПоказатьПредупреждение(, "Вкажіть період!");
		Возврат;
	КонецЕсли;

	СформироватьНаСервере();

КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()

	мОбъект = РеквизитФормыВЗначение("Объект");
	мОбъект.СравнитьОстатки();
	ЗначениеВРеквизитФормы(мОбъект, "Объект");

КонецПроцедуры

&НаКлиенте
Процедура АнализДокументов(Команда)

	// Проверяем что есть выбранные строки расхождений
	ЕстьВыбранные = Ложь;
	Для Каждого Стр Из Объект.ТаблицаРасхождений Цикл
		Если Стр.Синхронизировать Тогда
			ЕстьВыбранные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЕстьВыбранные Тогда
		ПоказатьПредупреждение(, "Оберіть рядки розбіжностей для аналізу документів!");
		Возврат;
	КонецЕсли;

	АнализДокументовНаСервере();
	ПрименитьФильтрДокументов();

КонецПроцедуры

&НаСервере
Процедура АнализДокументовНаСервере()

	мОбъект = РеквизитФормыВЗначение("Объект");
	мОбъект.АнализироватьДокументы();
	ЗначениеВРеквизитФормы(мОбъект, "Объект");

КонецПроцедуры

&НаКлиенте
Процедура Синхронизировать(Команда)

	// Проверяем что есть выбранные документы
	КоличествоВыбранных = 0;
	Для Каждого Стр Из Объект.ТаблицаДокументов Цикл
		Если Стр.Синхронизировать Тогда
			КоличествоВыбранных = КоличествоВыбранных + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоВыбранных = 0 Тогда
		ПоказатьПредупреждение(, "Оберіть документи для синхронізації!");
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения("СинхронизироватьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения,
		"Синхронізувати " + КоличествоВыбранных + " документ(ів)?" + Символы.ПС
		+ "Операція може розпровести документи в ЕРП або зареєструвати на обмін в BuhBud.",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		СинхронизироватьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СинхронизироватьНаСервере()

	мОбъект = РеквизитФормыВЗначение("Объект");
	мОбъект.ВыполнитьСинхронизацию();
	ЗначениеВРеквизитФормы(мОбъект, "Объект");

КонецПроцедуры

// === ВЫБОР/СНЯТИЕ ===

&НаКлиенте
Процедура ВыбратьВсе(Команда)

	УстановитьГалочки(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьВыделение(Команда)

	УстановитьГалочки(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьГалочки(Значение)

	Для Каждого Стр Из Объект.ТаблицаРасхождений Цикл
		Стр.Синхронизировать = Значение;
	КонецЦикла;

	Для Каждого Стр Из Объект.ТаблицаДокументов Цикл
		Стр.Синхронизировать = Значение;
	КонецЦикла;

КонецПроцедуры

// === ОБРАБОТЧИКИ ТАБЛИЦ ===

&НаКлиенте
Процедура ТаблицаРасхожденийФормаПриАктивизацииСтроки(Элемент)

	// Нижня таблиця документів слідує за активним рахунком верхньої
	ПрименитьФильтрДокументов();

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРасхожденийФормаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Стр = Объект.ТаблицаРасхождений.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Стр <> Неопределено
		И ТипЗнч(Стр.БанковскийСчет) <> Тип("Строка")
		И ЗначениеЗаполнено(Стр.БанковскийСчет) Тогда
		ПоказатьЗначение(, Стр.БанковскийСчет);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовФормаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Стр = Объект.ТаблицаДокументов.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Стр <> Неопределено
		И ТипЗнч(Стр.ДокументЕРП) <> Тип("Строка")
		И ЗначениеЗаполнено(Стр.ДокументЕРП) Тогда
		ПоказатьЗначение(, Стр.ДокументЕРП);
	КонецЕсли;

КонецПроцедуры

// === ОБРАБОТЧИКИ ИЗМЕНЕНИЙ ===

&НаКлиенте
Процедура ПоказыватьТолькоРасхожденияПриИзменении(Элемент)

	ПрименитьФильтрДокументов();

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьФильтрДокументов()

	// Комбінований відбір: активний рахунок верхньої таблиці + прапорець "Тільки розбіжності"
	СтруктураОтбора = Новый Структура;

	ТекущиеДанные = Элементы.ТаблицаРасхожденийФорма.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		СтруктураОтбора.Вставить("БанковскийСчет", ТекущиеДанные.БанковскийСчет);
	КонецЕсли;

	Если Объект.ПоказыватьТолькоРасхождения Тогда
		СтруктураОтбора.Вставить("Синхронизировать", Истина);
	КонецЕсли;

	Если СтруктураОтбора.Количество() = 0 Тогда
		Элементы.ТаблицаДокументовФорма.ОтборСтрок = Неопределено;
	Иначе
		Элементы.ТаблицаДокументовФорма.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбора);
	КонецЕсли;

КонецПроцедуры
