	Пока Выборка.Следующий() Цикл
		
		Док = Выборка.Ссылка.ПолучитьОбъект();
		
		НачатьТранзакцию();
		
		Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Док.Записать(РежимЗаписиДокумента.Проведение);
		
		ЗафиксироватьТранзакцию();
		
		
	КонецЦикла; 	
      

	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата1",НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("Дата2",КонецДня(ОкончаниеПериода));
	Запрос.УстановитьПараметр("Валюта",Константы.ВалютаРегламентированногоУчета.Получить());
	
	Запрос.Текст = 	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Ссылка,
	|	ВложенныйЗапрос.Дата КАК Дата
	|ИЗ
	|	(ВЫБРАТЬ
	|		СписаниеБезналичныхДенежныхСредств.Ссылка КАК Ссылка,
	|		СписаниеБезналичныхДенежныхСредств.Дата КАК Дата
	|	ИЗ
	|		Документ.СписаниеБезналичныхДенежныхСредств КАК СписаниеБезналичныхДенежныхСредств
	|	ГДЕ
	|		СписаниеБезналичныхДенежныхСредств.Проведен
	|		И СписаниеБезналичныхДенежныхСредств.Дата МЕЖДУ &Дата1 И &Дата2
	|		И СписаниеБезналичныхДенежныхСредств.Валюта <> &Валюта
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПоступлениеБезналичныхДенежныхСредств.Ссылка,
	|		ПоступлениеБезналичныхДенежныхСредств.Дата
	|	ИЗ
	|		Документ.ПоступлениеБезналичныхДенежныхСредств КАК ПоступлениеБезналичныхДенежныхСредств
	|	ГДЕ
	|		ПоступлениеБезналичныхДенежныхСредств.Проведен
	|		И ПоступлениеБезналичныхДенежныхСредств.Дата МЕЖДУ &Дата1 И &Дата2
	|		И ПоступлениеБезналичныхДенежныхСредств.Валюта <> &Валюта
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПриходныйКассовыйОрдер.Ссылка,
	|		ПриходныйКассовыйОрдер.Дата
	|	ИЗ
	|		Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|	ГДЕ
	|		ПриходныйКассовыйОрдер.Проведен
	|		И ПриходныйКассовыйОрдер.Дата МЕЖДУ &Дата1 И &Дата2
	|		И ПриходныйКассовыйОрдер.Валюта <> &Валюта
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		РасходныйКассовыйОрдер.Ссылка,
	|		РасходныйКассовыйОрдер.Дата
	|	ИЗ
	|		Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	|	ГДЕ
	|		РасходныйКассовыйОрдер.Проведен
	|		И РасходныйКассовыйОрдер.Дата МЕЖДУ &Дата1 И &Дата2
	|		И РасходныйКассовыйОрдер.Валюта <> &Валюта) КАК ВложенныйЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		Док = Выборка.Ссылка.ПолучитьОбъект(); 
		Док.Записать(РежимЗаписиДокумента.ОтменаПроведения); 
		Док.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();

	КонецЦикла; 

