	Запрос.УстановитьПараметр("Дата2",КонецДня(ОкончаниеПериода));
	
	Запрос.Текст =  "ВЫБРАТЬ
                |	ВложенныйЗапрос.Ссылка
                |ИЗ
                |	(ВЫБРАТЬ
                |		АвансовыйОтчет.Ссылка КАК Ссылка
                |	ИЗ
                |		Документ.АвансовыйОтчет КАК АвансовыйОтчет
                |	ГДЕ
                |		АвансовыйОтчет.Дата МЕЖДУ &Дата1 И &Дата2 
				|		И АвансовыйОтчет.Организация.ВБалансе
                |		И АвансовыйОтчет.ОтражатьВУправленческомУчете) КАК ВложенныйЗапрос
                |
                |УПОРЯДОЧИТЬ ПО
                |	ВложенныйЗапрос.Ссылка.Дата";
	
	
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Для каждого СтрокаТабличнойЧасти Из ТЗ Цикл
		
		
		
		Если СтрокаТабличнойЧасти.Ссылка.Метаданные().Имя="АвансовыйОтчет" Тогда
					
			ДокV83= Документы.АвансовыйОтчет.ПолучитьСсылку(Новый УникальныйИдентификатор(V83.string(СтрокаТабличнойЧасти.Ссылка.УникальныйИдентификатор())));
			
		Иначе
			Продолжить;
		КонецЕсли; 
		
		
		Док =  СтрокаТабличнойЧасти.Ссылка.ПолучитьОбъект();
		
		ДокОбъект = ДокV83.ПолучитьОбъект();
		Если ДокОбъект = Неопределено Тогда // Не найден в базе 1С ЕРП
			Попытка
				Док.Записать(V83.РежимЗаписиДокумента.Запись); 
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден документ "+СокрЛП(СтрокаТабличнойЧасти.Ссылка.Метаданные().Synonym)
							+" № "+СокрЛП(СтрокаТабличнойЧасти.Ссылка.Номер)+" от "
							+ Формат(СтрокаТабличнойЧасти.Ссылка.Дата,"ДФ=dd.MM.yyyy"));
			Исключение
				
			КонецПопытки;
		Иначе     
			Флаг_ИзменятьДокумент = Ложь;
			Если   СтрокаТабличнойЧасти.Ссылка.ПометкаУдаления 
				И НЕ ДокОбъект.ПометкаУдаления Тогда 
				Флаг_ИзменятьДокумент = Истина;
			ИначеЕсли  НЕ СтрокаТабличнойЧасти.Ссылка.Проведен 
				И ДокОбъект.Проведен Тогда
				Флаг_ИзменятьДокумент = Истина;
			ИначеЕсли   СтрокаТабличнойЧасти.Ссылка.Проведен 
				И НЕ ДокОбъект.Проведен Тогда   
				Флаг_ИзменятьДокумент = Истина;
			КонецЕсли; 
			
			Если Флаг_ИзменятьДокумент Тогда
			
			Док.Записать(V83.РежимЗаписиДокумента.Запись);	
			
			КонецЕсли;
		КонецЕсли;
		
				
	КонецЦикла;
	
	
	
		
