// Процедура выполняет полную проверку и синхронизацию документов между базами УПП и ERP
Процедура ПолнаяПроверкаМеждуБазамиЕРПиУПП() Экспорт
    
    // Структура для хранения результатов проверок
    РезультатыПроверок = Новый Структура;
    РезультатыПроверок.Вставить("УспешноОбработано", 0);
    РезультатыПроверок.Вставить("Ошибок", 0);
    
    // 1. Проверка платежных документов
    ТекстСообщения = НСтр("ru='Начало проверки платежных документов'");
    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
    ВыполнитьПроверку("Обработка_ПровестивУППлатежиОтсутствующиевЕРП", РезультатыПроверок);
    
    // 2. Проверка договоров
    ТекстСообщения = НСтр("ru='Начало проверки договоров'");
    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
    ВыполнитьПроверку("Обработка_ПровестиВУПППлатежкиОтсутствуещиеДоговораЕРП", РезультатыПроверок);
    
    // 3. Проверка бухгалтерских актов
    ТекстСообщения = НСтр("ru='Начало проверки бухгалтерских актов'");
    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
    ВыполнитьПроверку("Обработка_ПометитьНаУдалениеБухАктыНаСервере", РезультатыПроверок);
    
     
    // 5. Проверка бухгалтерских платежей
    ТекстСообщения = НСтр("ru='Начало проверки бухгалтерских платежей'");
    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
    ВыполнитьПроверку("Обработка_УдалитьБухгалтерскиеПлатежиВЕрп", РезультатыПроверок);
    
    // 6. Проверка документов с флагом "Не переносить в ERP"
    ТекстСообщения = НСтр("ru='Начало проверки документов с флагом 'Не переносить в ERP'");
    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
    ВыполнитьПроверку("Обработка_ПометитьНаУдаленияПлатежкиСФлагомНепереноситьВЕРПИНеПроведенные", РезультатыПроверок);
    
    // 7. Проверка товарных накладных
    ТекстСообщения = НСтр("ru='Начало проверки товарных накладных'");
    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
    ВыполнитьПроверку("Обработка_ПроверкаТоварныхНакладныхМеждуБазамиНаСервере", РезультатыПроверок);
    
    // 8. Проверка авансовых отчетов
    ТекстСообщения = НСтр("ru='Начало проверки авансовых отчетов'");
    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
    ВыполнитьПроверку("Обработка_ПроверкаАвансовыхОтчетовМеждуБазами", РезультатыПроверок);
    
    // 9. Проверка платежек в УПП
    ТекстСообщения = НСтр("ru='Начало проверки платежек в УПП'");
    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
    ВыполнитьПроверку("Обработка_ПлатежкиНетВБазеУППНаСервере", РезультатыПроверок);
    
    // 10. Проверка ведомостей
    ТекстСообщения = НСтр("ru='Начало проверки ведомостей'");
    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
    ВыполнитьПроверку("Обработка_ОтменитьВедомостиВКассуУкоторыхНетРасхОрдеров", РезультатыПроверок);
    
      // Выводим итоговый результат
    ТекстСообщения = СтрШаблон(НСтр("ru='Проверка завершена.
        |Успешно обработано: %1
        |Ошибок: %2'"), 
        РезультатыПроверок.УспешноОбработано,
        РезультатыПроверок.Ошибок);
    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
    
КонецПроцедуры

// Выполняет указанную процедуру проверки и обновляет статистику
Процедура ВыполнитьПроверку(ИмяПроцедуры, РезультатыПроверок)
    Попытка
        Выполнить(ИмяПроцедуры + "();");
        РезультатыПроверок.УспешноОбработано = РезультатыПроверок.УспешноОбработано + 1;
        
        ТекстСообщения = СтрШаблон(НСтр("ru='Успешно выполнена процедура: %1'"), ИмяПроцедуры);
        ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
        
    Исключение
        РезультатыПроверок.Ошибок = РезультатыПроверок.Ошибок + 1;
        
        ТекстСообщения = СтрШаблон(НСтр("ru='Ошибка при выполнении %1: %2'"), 
            ИмяПроцедуры, 
            ОписаниеОшибки());
        ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
        
        // Записываем в журнал регистрации
        ЗаписьЖурналаРегистрации("ПолнаяПроверкаМеждуБазами", 
            УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
    КонецПопытки;
КонецПроцедуры 