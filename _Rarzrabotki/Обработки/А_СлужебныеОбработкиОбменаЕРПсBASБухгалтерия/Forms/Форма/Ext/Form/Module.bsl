&НаСервере
Процедура ОчиститьРегистрСведенийНаСервере()
	
	ИмяРегистра = СокрЛП(Объект.ИмяРегистраСведений);  
	Если НЕ ЗначениеЗаполнено(ИмяРегистра) Тогда
	
		Возврат;
	
	КонецЕсли;
	НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей(); 
	НаборЗаписей.Записать();

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРегистрСведений(Команда)
	ОчиститьРегистрСведенийНаСервере();
