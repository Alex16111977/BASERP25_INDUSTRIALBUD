// Тонкая форма-диспетчер: логика разбора и записи — в модуле объекта, форма строит из ТЧ
// Объект.Строки три матрицы «дім × модуль» того же вида, что Excel-звіт:
//   БУДЕ ЗАВАНТАЖЕНО (з файлу) · БУЛО В БАЗІ на дату · ЗМІНИ (на скільки % зміниться база)
//
// Колонки матриц динамические (6 у «15 м», 14 у «30 м»), поэтому создаются программно:
// ИзменитьРеквизиты -> группы колонок «Дім №k» -> поля «М1…Мm». Эталон паттерна —
// Документ.А_ВыполнениеРаботМодулей.ФормаДокумента и типовой ЗарплатаКадрыРасширенный.
//
// Спека: docs/superpowers/specs/2026-08-12-zvr-matrica-formy-design.md

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Объект.ДатаЗагрузки) Тогда
		Объект.ДатаЗагрузки = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;

	Объект.Проводить = Истина;
	Объект.ЗагружатьПриОшибках = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы ИЛИ ЗакрытиеПодтверждено ИЛИ ДокументыСозданы
		ИЛИ Объект.Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	СтандартнаяОбработка = Ложь;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
		"Файл розшифровано, але документи не створені. Закрити?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьФайлКоманда(Команда)

	// Сигнатура из рабочих загрузчиков проекта: 5 параметров,
	// колбэк получает (Результат, Адрес, Имя, ДопПараметры).
	Описание = Новый ОписаниеОповещения("ВыбратьФайлЗавершение", ЭтотОбъект);
	НачатьПомещениеФайла(Описание, , , Истина, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура РазобратьФайлКоманда(Команда)

	Если НЕ ЗначениеЗаполнено(АдресФайла) Тогда
		ПоказатьПредупреждение(, "Спочатку оберіть файл звіту.");
		Возврат;
	КонецЕсли;

	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;

	РазобратьФайлНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыКоманда(Команда)

	Если Объект.Строки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Спочатку натисніть ""Розшифрувати файл"".");
		Возврат;
	КонецЕсли;

	Если ЕстьОшибки И НЕ Объект.ЗагружатьПриОшибках Тогда
		ПоказатьПредупреждение(,
			"У файлі є помилки — документи не створюються. Виправте файл і розшифруйте ще раз"
			+ " або увімкніть ""Завантажити попри помилки"" (проблемні клітинки буде пропущено).");
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("СоздатьДокументыЗавершение", ЭтотОбъект),
		"Створити/оновити документів: " + Строка(Объект.Дома.Количество()) + "?",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыбратьФайлЗавершение(Результат, Адрес, Имя, ДополнительныеПараметры) Экспорт

	Если НЕ Результат Тогда
		Возврат;
	КонецЕсли;

	АдресФайла = Адрес;
	Объект.ИмяФайла = ИмяБезПути(Имя);
	ОчиститьПредставленияНаСервере();
	ЗаполнитьШапкуПоФайлуНаСервере();

КонецПроцедуры

&НаКлиенте
Функция ИмяБезПути(Знач ПолноеИмя)

	Части = СтрРазделить(СтрЗаменить(ПолноеИмя, "/", "\"), "\", Ложь);
	Возврат ?(Части.Количество() = 0, ПолноеИмя, Части[Части.ВГраница()]);

КонецФункции

&НаСервере
Процедура ОчиститьПредставленияНаСервере()

	Объект.Дома.Очистить();
	Объект.Строки.Очистить();
	УдалитьДобавленныеЭлементы();
	МатрицаФайл.Очистить();
	МатрицаБаза.Очистить();
	МатрицаИзменений.Очистить();
	Проблемы.Очистить();
	Элементы.ГруппаПроблем.Видимость = Ложь;
	ДокументыСозданы = Ложь;
	ЕстьОшибки = Ложь;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьШапкуПоФайлуНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Паспорт = ОбъектОбработки.ПрочитатьПаспортФайла(АдресФайла, ОбъектОбработки.ИмяФайла);
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");

	Если ЗначениеЗаполнено(Паспорт.Ошибка) Тогда
		Объект.ТекстСводки = Паспорт.Ошибка;
		Сообщить(Паспорт.Ошибка);
		Возврат;
	КонецЕсли;

	Объект.СтруктураСебестоимости = Паспорт.СтруктураСебестоимости;
	Объект.ДатаЗагрузки = Паспорт.Дата;
	Объект.ТекстСводки = СтрШаблон("Файл: %1 · на дату %2 · домів %3 · модулів у домі %4",
		Объект.ИмяФайла, Формат(Паспорт.Дата, "ДЛФ=D"), Паспорт.Домов, Паспорт.Модулей);

КонецПроцедуры

&НаСервере
Процедура РазобратьФайлНаСервере()

	ОчиститьПредставленияНаСервере();

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Сводка = ОбъектОбработки.РазобратьФайл(АдресФайла, ОбъектОбработки.ИмяФайла);
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");

	ЕстьОшибки = (Сводка.Ошибок > 0) ИЛИ ЗначениеЗаполнено(Сводка.Ошибка);

	Если ЗначениеЗаполнено(Сводка.Ошибка) Тогда
		Сообщить(Сводка.Ошибка);
		Возврат;
	КонецЕсли;

	СоздатьКолонкиМатриц();
	ЗаполнитьМатрицы();
	ЗаполнитьПроблемы();
	УстановитьОформлениеМатриц();
	ОбновитьЗаголовкиИСводку(Сводка);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СоздатьДокументыНаСервере();

КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Результат = ОбъектОбработки.СоздатьДокументы();
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");

	Если ЗначениеЗаполнено(Результат.Помилка) Тогда
		Сообщить("Нічого не створено, зміни скасовано. Помилка: " + Результат.Помилка);
		Возврат;
	КонецЕсли;

	ДокументыСозданы = Истина;
	Объект.ТекстСводки = СтрШаблон("Створено %1 · оновлено %2 · проведено %3",
		Результат.Створено, Результат.Оновлено, Результат.Проведено);
	Сообщить(Объект.ТекстСводки);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЗакрытиеПодтверждено = Истина;
	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область ПостроениеМатриц

// Пересоздаёт колонки трёх матриц под текущий файл: групп — по числу домов,
// в каждой группе M колонок «М1…Мm». В ТЗ на каждую клетку заводится ДВЕ колонки:
// текстовая «Д1М1» (её видит пользователь, «100%» — как в Excel) и числовая «Д1М1Ч»
// (скрытая, по ней работает условное оформление: -1 = проблема, інакше відсоток/дельта).
&НаСервере
Процедура СоздатьКолонкиМатриц()

	УдалитьДобавленныеЭлементы();

	Модулей = Макс(Объект.КоличествоМодулейФайл, 1);
	ИменаМатриц = ИменаМатриц();

	ОписаниеТипаТекст = Новый ОписаниеТипов("Строка",
		, , , Новый КвалификаторыСтроки(10, ДопустимаяДлина.Переменная));
	ОписаниеТипаЧисло = Новый ОписаниеТипов("Число",
		, , Новый КвалификаторыЧисла(6, 2, ДопустимыйЗнак.Любой));

	// 1. Реквизиты-колонки — ОДНИМ вызовом ИзменитьРеквизиты (он пересоздаёт контекст формы).
	НовыеРеквизиты = Новый Массив;
	Для Каждого ИмяМатрицы Из ИменаМатриц Цикл
		Для Каждого СтрокаДома Из Объект.Дома Цикл
			Для НомерМодуля = 1 По Модулей Цикл
				ИмяКлетки = ИмяКлетки(СтрокаДома.НомерДома, НомерМодуля);
				НовыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяКлетки, ОписаниеТипаТекст, ИмяМатрицы));
				НовыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяКлетки + "Ч", ОписаниеТипаЧисло, ИмяМатрицы));
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ИзменитьРеквизиты(НовыеРеквизиты, УдаляемыеРеквизитыКолонок());

	// 2. Элементы формы: группа «Дім №k» -> поля «М1…Мm».
	Для Каждого ИмяМатрицы Из ИменаМатриц Цикл

		ТаблицаФормы = Элементы[ИмяМатрицы];
		ПолеРазом = Элементы[ИмяМатрицы + "Разом"];

		Для Каждого СтрокаДома Из Объект.Дома Цикл

			ИмяГруппы = ИмяМатрицы + "Дом" + Формат(СтрокаДома.НомерДома, "ЧГ=0");
			ГруппаДома = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), ТаблицаФормы);
			ГруппаДома.Вид = ВидГруппыФормы.ГруппаКолонок;
			ГруппаДома.Группировка = ГруппировкаКолонок.Горизонтальная;
			// ОтображатьВШапке = Истина -> заголовок групи стає верхнім рівнем шапки таблиці
			// («Дім №1» над «М1 М2»), як у типовому ЗарплатаКадрыРасширенный.
			ГруппаДома.ОтображатьВШапке = Истина;
			ГруппаДома.Заголовок = ЗаголовокДома(СтрокаДома);
			Элементы.Переместить(ГруппаДома, ТаблицаФормы, ПолеРазом);
			ДобавленныеЭлементы.Добавить(ИмяГруппы);

			Для НомерМодуля = 1 По Модулей Цикл
				ИмяКлетки = ИмяКлетки(СтрокаДома.НомерДома, НомерМодуля);
				ИмяПоля = ИмяМатрицы + ИмяКлетки;
				ПолеКлетки = Элементы.Добавить(ИмяПоля, Тип("ПолеФормы"), ГруппаДома);
				ПолеКлетки.ПутьКДанным = ИмяМатрицы + "." + ИмяКлетки;
				ПолеКлетки.Вид = ВидПоляФормы.ПолеВвода;
				ПолеКлетки.Заголовок = "М" + Формат(НомерМодуля, "ЧГ=0");
				ПолеКлетки.Ширина = 6;
				ПолеКлетки.РастягиватьПоГоризонтали = Ложь;
				ПолеКлетки.ТолькоПросмотр = Истина;
				ДобавленныеЭлементы.Добавить(ИмяПоля);
			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ИменаМатриц()

	Результат = Новый Массив;
	Результат.Добавить("МатрицаФайл");
	Результат.Добавить("МатрицаБаза");
	Результат.Добавить("МатрицаИзменений");
	Возврат Результат;

КонецФункции

&НаСервере
Функция ИмяКлетки(Знач НомерДома, Знач НомерМодуля)

	Возврат "Д" + Формат(НомерДома, "ЧГ=0") + "М" + Формат(НомерМодуля, "ЧГ=0");

КонецФункции

&НаСервере
Функция ЗаголовокДома(СтрокаДома)

	Если ЗначениеЗаполнено(СтрокаДома.ЗаголовокКолонки) Тогда
		Возврат СтрокаДома.ЗаголовокКолонки;
	КонецЕсли;
	Возврат "Дім №" + Формат(СтрокаДома.НомерДома, "ЧГ=0");

КонецФункции

// Сносит ранее созданные элементы формы и возвращает список реквизитов-колонок на удаление.
&НаСервере
Процедура УдалитьДобавленныеЭлементы()

	Для Каждого ЭлементСписка Из ДобавленныеЭлементы Цикл
		ЭлементФормы = Элементы.Найти(ЭлементСписка.Значение);
		Если ЭлементФормы <> Неопределено Тогда
			Элементы.Удалить(ЭлементФормы);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция УдаляемыеРеквизитыКолонок()

	// Состав колонок читаем через ПолучитьРеквизиты: у реквизита формы типа ТаблицаЗначений
	// на форме нет свойства .Колонки — это ДанныеФормыКоллекция.
	УдаляемыеРеквизиты = Новый Массив;
	Для Каждого ИмяМатрицы Из ИменаМатриц() Цикл
		Для Каждого Реквизит Из ПолучитьРеквизиты(ИмяМатрицы) Цикл
			Если Лев(Реквизит.Имя, 1) = "Д" И СтрНайти(Реквизит.Имя, "М") > 0 Тогда
				УдаляемыеРеквизиты.Добавить(ИмяМатрицы + "." + Реквизит.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ДобавленныеЭлементы.Очистить();
	Возврат УдаляемыеРеквизиты;

КонецФункции

// Раскладывает плоскую ТЧ Объект.Строки в три матрицы.
&НаСервере
Процедура ЗаполнитьМатрицы()

	МатрицаФайл.Очистить();
	МатрицаБаза.Очистить();
	МатрицаИзменений.Очистить();

	Модулей = Макс(Объект.КоличествоМодулейФайл, 1);
	СтрокиРабот = Новый Соответствие;   // имя работы -> Структура(Файл, База, Змины, ЕстьЗмины, …)
	ПорядокРабот = Новый Массив;

	ПланВсього = 0;
	ВиконаноФайл = 0;
	ВиконаноБаза = 0;

	Для Каждого СтрокаМатрицы Из Объект.Строки Цикл

		Описание = СтрокиРабот.Получить(СтрокаМатрицы.РаботаТекст);
		Если Описание = Неопределено Тогда
			Описание = ДобавитьРаботуВМатрицы(СтрокаМатрицы, ПорядокРабот.Количество() + 1);
			СтрокиРабот.Вставить(СтрокаМатрицы.РаботаТекст, Описание);
			ПорядокРабот.Добавить(СтрокаМатрицы.РаботаТекст);
		КонецЕсли;

		ИмяКлетки = ИмяКлетки(СтрокаМатрицы.НомерДома, СтрокаМатрицы.НомерМодуля);
		ЕстьПроблема = (СтрокаМатрицы.Уровень = "Помилка");

		Описание.Файл[ИмяКлетки] = ?(ЕстьПроблема, "?", ТекстПроцента(СтрокаМатрицы.Процент));
		Описание.Файл[ИмяКлетки + "Ч"] = ?(ЕстьПроблема, -1, СтрокаМатрицы.Процент);

		Описание.База[ИмяКлетки] = ТекстПроцента(СтрокаМатрицы.ПроцентПред);
		Описание.База[ИмяКлетки + "Ч"] = СтрокаМатрицы.ПроцентПред;

		Дельта = ?(ЕстьПроблема, 0, СтрокаМатрицы.Процент - СтрокаМатрицы.ПроцентПред);
		Описание.Змины[ИмяКлетки] = ТекстДельты(Дельта);
		Описание.Змины[ИмяКлетки + "Ч"] = Дельта;

		Описание.СуммаФайл = Описание.СуммаФайл + СтрокаМатрицы.Процент;
		Описание.СуммаБаза = Описание.СуммаБаза + СтрокаМатрицы.ПроцентПред;
		Описание.Клеток = Описание.Клеток + 1;
		Если Дельта <> 0 Тогда
			Описание.ЕстьЗмины = Истина;
		КонецЕсли;

		ПланВсього = ПланВсього + СтрокаМатрицы.ПланЧасыМодуля;
		ВиконаноФайл = ВиконаноФайл + СтрокаМатрицы.ПланЧасыМодуля * СтрокаМатрицы.Процент / 100;
		ВиконаноБаза = ВиконаноБаза + СтрокаМатрицы.ПланЧасыМодуля * СтрокаМатрицы.ПроцентПред / 100;

	КонецЦикла;

	// «Разом по проєкту, %» по каждой работе + удаление строк без изменений из матрицы «Зміни»
	СтрокиБезИзменений = Новый Массив;
	Для Каждого ИмяРаботы Из ПорядокРабот Цикл
		Описание = СтрокиРабот.Получить(ИмяРаботы);
		Клеток = Макс(Описание.Клеток, 1);
		Описание.Файл.Разом = ТекстПроцента(Окр(Описание.СуммаФайл / Клеток, 1));
		Описание.База.Разом = ТекстПроцента(Окр(Описание.СуммаБаза / Клеток, 1));
		Описание.Змины.Разом = ТекстДельты(
			Окр(Описание.СуммаФайл / Клеток, 1) - Окр(Описание.СуммаБаза / Клеток, 1));
		Если НЕ Описание.ЕстьЗмины Тогда
			СтрокиБезИзменений.Добавить(Описание.Змины);
		КонецЕсли;
	КонецЦикла;
	// ДанныеФормыКоллекция.Удалить принимает ИНДЕКС, поэтому берём его перед каждым удалением.
	Для Каждого СтрокаБезИзменений Из СтрокиБезИзменений Цикл
		МатрицаИзменений.Удалить(МатрицаИзменений.Индекс(СтрокаБезИзменений));
	КонецЦикла;

	ДобавитьИтоговуюСтроку(ПланВсього, ВиконаноФайл, ВиконаноБаза);

КонецПроцедуры

&НаСервере
Функция ДобавитьРаботуВМатрицы(СтрокаИсточника, Знач НомерРяд)

	СтрокаФайл = МатрицаФайл.Добавить();
	СтрокаФайл.НомерРяд = НомерРяд;
	СтрокаФайл.Робота = СтрокаИсточника.РаботаТекст;
	СтрокаФайл.Коментар = СтрокаИсточника.Комментарий;

	СтрокаБаза = МатрицаБаза.Добавить();
	СтрокаБаза.НомерРяд = НомерРяд;
	СтрокаБаза.Робота = СтрокаИсточника.РаботаТекст;

	СтрокаЗмины = МатрицаИзменений.Добавить();
	СтрокаЗмины.НомерРяд = НомерРяд;
	СтрокаЗмины.Робота = СтрокаИсточника.РаботаТекст;

	Описание = Новый Структура;
	Описание.Вставить("Файл", СтрокаФайл);
	Описание.Вставить("База", СтрокаБаза);
	Описание.Вставить("Змины", СтрокаЗмины);
	Описание.Вставить("СуммаФайл", 0);
	Описание.Вставить("СуммаБаза", 0);
	Описание.Вставить("Клеток", 0);
	Описание.Вставить("ЕстьЗмины", Ложь);
	Возврат Описание;

КонецФункции

// Подвал «Загальна» — взвешенный по часам процент, та же формула, что печатает отчёт.
&НаСервере
Процедура ДобавитьИтоговуюСтроку(Знач ПланВсього, Знач ВиконаноФайл, Знач ВиконаноБаза)

	Если ПланВсього = 0 Тогда
		Возврат;
	КонецЕсли;

	ПроцентФайл = Окр(ВиконаноФайл / ПланВсього * 100, 1);
	ПроцентБаза = Окр(ВиконаноБаза / ПланВсього * 100, 1);

	СтрокаФайл = МатрицаФайл.Добавить();
	СтрокаФайл.Робота = "Загальна";
	СтрокаФайл.Разом = ТекстПроцента(ПроцентФайл);
	СтрокаФайл.ЭтоИтог = Истина;

	СтрокаБаза = МатрицаБаза.Добавить();
	СтрокаБаза.Робота = "Загальна";
	СтрокаБаза.Разом = ТекстПроцента(ПроцентБаза);
	СтрокаБаза.ЭтоИтог = Истина;

	Если МатрицаИзменений.Количество() > 0 Тогда
		СтрокаЗмины = МатрицаИзменений.Добавить();
		СтрокаЗмины.Робота = "Загальна";
		СтрокаЗмины.Разом = ТекстДельты(ПроцентФайл - ПроцентБаза);
		СтрокаЗмины.ЭтоИтог = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПроблемы()

	Проблемы.Очистить();

	Для Каждого СтрокаМатрицы Из Объект.Строки Цикл
		Если СтрокаМатрицы.Уровень <> "Помилка" Тогда
			Продолжить;
		КонецЕсли;
		СтрокаПроблемы = Проблемы.Добавить();
		СтрокаПроблемы.Робота = СтрокаМатрицы.РаботаТекст;
		СтрокаПроблемы.Дом = СтрокаМатрицы.ЗаголовокДома;
		СтрокаПроблемы.Модуль = СтрокаМатрицы.НомерМодуля;
		СтрокаПроблемы.УФайли = СтрокаМатрицы.ТекстЯчейки;
		СтрокаПроблемы.Пояснение = СтрокаМатрицы.Пояснение;
	КонецЦикла;

	Элементы.ГруппаПроблем.Видимость = (Проблемы.Количество() > 0);
	Элементы.ГруппаПроблем.Заголовок = "ПРОБЛЕМИ (" + Формат(Проблемы.Количество(), "ЧГ=0") + ")";

КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовкиИСводку(Сводка)

	Элементы.ГруппаБыло.Заголовок = "БУЛО В БАЗІ на " + Формат(Объект.ДатаЗагрузки, "ДЛФ=D");

	Ростов = 0;
	Откатов = 0;
	Для Каждого СтрокаМатрицы Из Объект.Строки Цикл
		Дельта = СтрокаМатрицы.Процент - СтрокаМатрицы.ПроцентПред;
		Если СтрокаМатрицы.Уровень = "Помилка" ИЛИ Дельта = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Дельта > 0 Тогда
			Ростов = Ростов + 1;
		Иначе
			Откатов = Откатов + 1;
		КонецЕсли;
	КонецЦикла;

	Элементы.ГруппаИзменений.Заголовок = СтрШаблон(
		"ЗМІНИ — на скільки %% зміниться база: %1 (зростань %2, відкатів %3)",
		Ростов + Откатов, Ростов, Откатов);

	Створити = 0;
	Оновити = 0;
	Для Каждого СтрокаДома Из Объект.Дома Цикл
		Если СтрокаДома.Состояние = "створити новий" Тогда
			Створити = Створити + 1;
		Иначе
			Оновити = Оновити + 1;
		КонецЕсли;
	КонецЦикла;

	Объект.ТекстСводки = СтрШаблон(
		"Домів %1 · робіт %2 · клітинок %3 · змін %4 (зростань %5, відкатів %6) · помилок %7"
		+ " · документи: оновити %8, створити %9",
		Объект.Дома.Количество(), Сводка.Работ, Сводка.Строк, Ростов + Откатов,
		Ростов, Откатов, Сводка.Ошибок, Оновити, Створити);

КонецПроцедуры

&НаСервере
Функция ТекстПроцента(Знач Процент)

	// 0 % не показываем — как в Excel-звіті (порожня клітинка).
	Если Процент = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Формат(Процент, "ЧЦ=6; ЧДЦ=1; ЧН=; ЧГ=0") + "%";

КонецФункции

&НаСервере
Функция ТекстДельты(Знач Дельта)

	Если Дельта = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ?(Дельта > 0, "+", "") + Формат(Дельта, "ЧЦ=6; ЧДЦ=1; ЧН=; ЧГ=0");

КонецФункции

#КонецОбласти

#Область УсловноеОформлениеМатриц

// Цвет задаём КОДОМ: <TextColor>style:…</TextColor> в Form.xml внешней обработки
// валит сборку .epf («Исключение XDTO»).
&НаСервере
Процедура УстановитьОформлениеМатриц()

	УсловноеОформление.Элементы.Очистить();

	ЦветВиконано = Новый Цвет(198, 239, 206);   // зелений — 100 %
	ЦветВРоботи  = Новый Цвет(255, 235, 156);   // жовтий — в роботі
	ЦветПомилки  = Новый Цвет(255, 199, 206);   // червоний — проблемна клітинка / відкат
	ЦветИтога    = Новый Цвет(235, 235, 235);   // сірий — рядок «Загальна»

	Модулей = Макс(Объект.КоличествоМодулейФайл, 1);

	Для Каждого СтрокаДома Из Объект.Дома Цикл
		Для НомерМодуля = 1 По Модулей Цикл

			ИмяКлетки = ИмяКлетки(СтрокаДома.НомерДома, НомерМодуля);

			// БУДЕ ЗАВАНТАЖЕНО: як у звіті + червона проблемна клітинка (Ч = -1)
			ДобавитьПравило("МатрицаФайл", ИмяКлетки,
				ВидСравненияКомпоновкиДанных.БольшеИлиРавно, 100, ЦветВиконано);
			ДобавитьПравило("МатрицаФайл", ИмяКлетки,
				ВидСравненияКомпоновкиДанных.Больше, 0, ЦветВРоботи);
			ДобавитьПравило("МатрицаФайл", ИмяКлетки,
				ВидСравненияКомпоновкиДанных.Меньше, 0, ЦветПомилки);

			// БУЛО В БАЗІ: те саме оформлення без проблемних клітинок
			ДобавитьПравило("МатрицаБаза", ИмяКлетки,
				ВидСравненияКомпоновкиДанных.БольшеИлиРавно, 100, ЦветВиконано);
			ДобавитьПравило("МатрицаБаза", ИмяКлетки,
				ВидСравненияКомпоновкиДанных.Больше, 0, ЦветВРоботи);

			// ЗМІНИ: зростання зелене, відкат червоний
			ДобавитьПравило("МатрицаИзменений", ИмяКлетки,
				ВидСравненияКомпоновкиДанных.Больше, 0, ЦветВиконано);
			ДобавитьПравило("МатрицаИзменений", ИмяКлетки,
				ВидСравненияКомпоновкиДанных.Меньше, 0, ЦветПомилки);

		КонецЦикла;
	КонецЦикла;

	Для Каждого ИмяМатрицы Из ИменаМатриц() Цикл
		ДобавитьПравилоИтога(ИмяМатрицы, "Робота", ЦветИтога);
		ДобавитьПравилоИтога(ИмяМатрицы, "Разом", ЦветИтога);
	КонецЦикла;

КонецПроцедуры

// Правило раскраски клетки: отбор по СКРЫТОЙ числовой колонке, оформление — видимого поля.
&НаСервере
Процедура ДобавитьПравило(Знач ИмяМатрицы, Знач ИмяКлетки, Знач ВидСравнения,
	Знач ЗначениеОтбора, Знач ЦветФона)

	Элемент = УсловноеОформление.Элементы.Добавить();

	ОформляемоеПоле = Элемент.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяМатрицы + ИмяКлетки);

	ЭлементОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяМатрицы + "." + ИмяКлетки + "Ч");
	ЭлементОтбора.ВидСравнения = ВидСравнения;
	ЭлементОтбора.ПравоеЗначение = ЗначениеОтбора;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);

КонецПроцедуры

&НаСервере
Процедура ДобавитьПравилоИтога(Знач ИмяМатрицы, Знач ИмяКолонки, Знач ЦветФона)

	Элемент = УсловноеОформление.Элементы.Добавить();

	ОформляемоеПоле = Элемент.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяМатрицы + ИмяКолонки);

	ЭлементОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяМатрицы + ".ЭтоИтог");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);

КонецПроцедуры

#КонецОбласти
