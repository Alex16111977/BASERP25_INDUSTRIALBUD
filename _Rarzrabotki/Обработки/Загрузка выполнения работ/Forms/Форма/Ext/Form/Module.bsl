// Тонкая форма-диспетчер: вся логика — в модуле объекта, форма только перекладывает
// объект через мост РеквизитФормыВЗначение / ЗначениеВРеквизитФормы и показывает результат.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Объект.ДатаЗагрузки) Тогда
		Объект.ДатаЗагрузки = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;

	Объект.Проводить = Истина;
	Объект.ЗагружатьПриОшибках = Ложь;

	УстановитьОформлениеСтрок();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы ИЛИ ЗакрытиеПодтверждено ИЛИ ДокументыСозданы
		ИЛИ Объект.Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	СтандартнаяОбработка = Ложь;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
		"Файл розшифровано, але документи не створені. Закрити?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТолькоПроблемныеПриИзменении(Элемент)

	Если ТолькоПроблемные Тогда
		Отбор = Новый Структура("Проблемна", Истина);
		Элементы.Строки.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
	Иначе
		Элементы.Строки.ОтборСтрок = Новый ФиксированнаяСтруктура();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДомаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ТекущиеДанные = Элементы.Дома.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ПоказатьЗначение(, ТекущиеДанные.Документ);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьФайлКоманда(Команда)

	// Сигнатура из рабочих загрузчиков проекта («Загрузка ТЧТребованиеНакладная» и др.):
	// 5 параметров, колбэк получает (Результат, Адрес, Имя, ДопПараметры).
	Описание = Новый ОписаниеОповещения("ВыбратьФайлЗавершение", ЭтотОбъект);
	НачатьПомещениеФайла(Описание, , , Истина, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура РазобратьФайлКоманда(Команда)

	Если НЕ ЗначениеЗаполнено(АдресФайла) Тогда
		ПоказатьПредупреждение(, "Спочатку оберіть файл звіту.");
		Возврат;
	КонецЕсли;

	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;

	РазобратьФайлНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыКоманда(Команда)

	Если Объект.Строки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Спочатку натисніть ""Розшифрувати файл"".");
		Возврат;
	КонецЕсли;

	Если ЕстьОшибки И НЕ Объект.ЗагружатьПриОшибках Тогда
		ПоказатьПредупреждение(,
			"У файлі є помилки — документи не створюються. Виправте файл і розшифруйте ще раз"
			+ " або увімкніть ""Завантажити попри помилки"" (проблемні рядки буде пропущено).");
		Возврат;
	КонецЕсли;

	КоличествоДомов = 0;
	Для Каждого СтрокаДома Из Объект.Дома Цикл
		Если СтрокаДома.Вантажити Тогда
			КоличествоДомов = КоличествоДомов + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоДомов = 0 Тогда
		ПоказатьПредупреждение(, "Не відмічено жодного будинку.");
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("СоздатьДокументыЗавершение", ЭтотОбъект),
		"Створити/оновити документів: " + Строка(КоличествоДомов) + "?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыбратьФайлЗавершение(Результат, Адрес, Имя, ДополнительныеПараметры) Экспорт

	Если НЕ Результат Тогда
		Возврат;
	КонецЕсли;

	АдресФайла = Адрес;
	Объект.ИмяФайла = ИмяБезПути(Имя);
	Объект.Дома.Очистить();
	Объект.Строки.Очистить();
	ДокументыСозданы = Ложь;
	ЕстьОшибки = Ложь;

	ЗаполнитьШапкуПоФайлуНаСервере();

КонецПроцедуры

&НаКлиенте
Функция ИмяБезПути(Знач ПолноеИмя)

	Части = СтрРазделить(СтрЗаменить(ПолноеИмя, "/", "\"), "\", Ложь);
	Возврат ?(Части.Количество() = 0, ПолноеИмя, Части[Части.ВГраница()]);

КонецФункции

&НаСервере
Процедура ЗаполнитьШапкуПоФайлуНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Паспорт = ОбъектОбработки.ПрочитатьПаспортФайла(АдресФайла, ОбъектОбработки.ИмяФайла);
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");

	Если ЗначениеЗаполнено(Паспорт.Ошибка) Тогда
		Объект.ТекстСводки = Паспорт.Ошибка;
		Сообщить(Паспорт.Ошибка);
		Возврат;
	КонецЕсли;

	Объект.СтруктураСебестоимости = Паспорт.СтруктураСебестоимости;
	Объект.ДатаЗагрузки = Паспорт.Дата;
	Объект.ТекстСводки = СтрШаблон("Файл: %1 · на дату %2 · домів %3 · модулів у домі %4",
		Объект.ИмяФайла, Формат(Паспорт.Дата, "ДЛФ=D"), Паспорт.Домов, Паспорт.Модулей);

КонецПроцедуры

&НаСервере
Процедура РазобратьФайлНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Сводка = ОбъектОбработки.РазобратьФайл(АдресФайла, ОбъектОбработки.ИмяФайла);
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");

	ДокументыСозданы = Ложь;
	ЕстьОшибки = (Сводка.Ошибок > 0) ИЛИ ЗначениеЗаполнено(Сводка.Ошибка);

	Если ЗначениеЗаполнено(Сводка.Ошибка) Тогда
		Сообщить(Сводка.Ошибка);
		Возврат;
	КонецЕсли;

	// Проблемные строки — в служебные сообщения, чтобы их было видно без прокрутки таблицы
	Показано = 0;
	Для Каждого СтрокаМатрицы Из Объект.Строки Цикл
		Если СтрокаМатрицы.Уровень <> "Помилка" Тогда
			Продолжить;
		КонецЕсли;
		Если Показано >= 20 Тогда
			Сообщить("… решта помилок — у таблиці рядків (увімкніть ""Тільки проблемні рядки"")");
			Прервать;
		КонецЕсли;
		Сообщить(СтрокаМатрицы.РаботаТекст + " · " + СтрокаМатрицы.ЗаголовокДома
			+ ": " + СтрокаМатрицы.Пояснение);
		Показано = Показано + 1;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СоздатьДокументыНаСервере();

КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Результат = ОбъектОбработки.СоздатьДокументы();
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");

	Если ЗначениеЗаполнено(Результат.Помилка) Тогда
		Сообщить("Нічого не створено, зміни скасовано. Помилка: " + Результат.Помилка);
		Возврат;
	КонецЕсли;

	ДокументыСозданы = Истина;
	Объект.ТекстСводки = СтрШаблон("Створено %1 · оновлено %2 · проведено %3 · пропущено %4",
		Результат.Створено, Результат.Оновлено, Результат.Проведено, Результат.Пропущено);
	Сообщить(Объект.ТекстСводки);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЗакрытиеПодтверждено = Истина;
	Закрыть();

КонецПроцедуры

// Оформление задаём КОДОМ: <TextColor>style:…</TextColor> в Form.xml внешней обработки
// валит сборку .epf («Исключение XDTO»).
&НаСервере
Процедура УстановитьОформлениеСтрок()

	УсловноеОформление.Элементы.Очистить();

	ДобавитьОформление("Строки", "Объект.Строки.Уровень",
		ВидСравненияКомпоновкиДанных.Равно, "Помилка", Новый Цвет(255, 225, 225));

	ДобавитьОформление("Строки", "Объект.Строки.Уровень",
		ВидСравненияКомпоновкиДанных.Равно, "Попередження", Новый Цвет(255, 245, 205));

	ДобавитьОформление("Дома", "Объект.Дома.Ошибок",
		ВидСравненияКомпоновкиДанных.Больше, 0, Новый Цвет(255, 225, 225));

КонецПроцедуры

&НаСервере
Процедура ДобавитьОформление(Знач ИмяПоляФормы, Знач ПутьКДанным, Знач ВидСравнения,
	Знач ЗначениеОтбора, Знач ЦветФона)

	Элемент = УсловноеОформление.Элементы.Добавить();

	ОформляемоеПоле = Элемент.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоляФормы);

	ЭлементОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКДанным);
	ЭлементОтбора.ВидСравнения = ВидСравнения;
	ЭлементОтбора.ПравоеЗначение = ЗначениеОтбора;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);

КонецПроцедуры

#КонецОбласти
