// Обработка «Завантаження виконання робіт».
//
// Читает выгруженный в Excel отчёт Отчет.А_ОтчетПоВыполнениюРаботвПроизводстве
// («Звіт з виконання робіт по домах і модулях»), показывает расшифровку файла
// и создаёт документы А_ВыполнениеРаботМодулей — по одному на дом, снимок
// накопленных процентов на дату.
//
// Файл заполняет ЧЕЛОВЕК, поэтому любое отклонение в ячейке называется явно:
// «не розпізналося» никогда не считается нулём.
//
// Спека: docs/superpowers/specs/2026-08-11-zagruzka-vypolneniya-rabot-design.md
// Прототип алгоритма (Rule #-1): _Rarzrabotki/Python/test/proto_zvit_parser.py

#Область ПрограммныйИнтерфейс

// Регистрация в подсистеме БСП «Дополнительные отчёты и обработки».
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Наименование", "Завантаження виконання робіт");
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"Завантаження звіту виконання робіт з Excel у документи «Виконання робіт модулів»");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.0.7.6");

	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд, "Завантаження виконання робіт", "1", "ОткрытиеФормы", Истина, "");
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);

	Возврат ПараметрыРегистрации;

КонецФункции

// Приводит текст ячейки процента к числу. Файл заполняет ЧЕЛОВЕК, поэтому любое
// отклонение называется явно: «не розпізналося» никогда не считается нулём.
//
// Параметры:
//  ТекстЯчейки - Строка - как пользователь видит значение в Excel («80», «80%», «0,5»).
//
// Возвращаемое значение:
//  Структура:
//   * Процент   - Число  - 0..100, округлён до 2 знаков.
//   * Уровень   - Строка - "" (ок) / "Помилка" / "Інфо".
//   * Пояснение - Строка - человеческий текст проблемы.
Функция НормализоватьПроцент(Знач ТекстЯчейки) Экспорт

	Результат = Новый Структура("Процент, Уровень, Пояснение", 0, "", "");

	Исходный = СокрЛП(Строка(ТекстЯчейки));
	Значение = СтрЗаменить(Исходный, Символ(160), "");
	Значение = СтрЗаменить(Значение, " ", "");
	Если ПустаяСтрока(Значение) Тогда
		Возврат Результат;
	КонецЕсли;

	ЕстьЗнакПроцента = (СтрНайти(Значение, "%") > 0);
	Значение = СтрЗаменить(Значение, "%", "");
	Значение = СтрЗаменить(Значение, ",", ".");

	Если НЕ ЭтоЧисловаяСтрока(Значение) Тогда
		Результат.Уровень = "Помилка";
		Результат.Пояснение = "не розпізнано як число: """ + Исходный + """";
		Возврат Результат;
	КонецЕсли;

	ЧисловоеЗначение = Число(Значение);

	Если ЧисловоеЗначение < 0 ИЛИ ЧисловоеЗначение > 100 Тогда
		Результат.Уровень = "Помилка";
		Результат.Пояснение = "відсоток має бути від 0 до 100, у файлі: """ + Исходный + """";
		Возврат Результат;
	КонецЕсли;

	Если НЕ ЕстьЗнакПроцента И ЧисловоеЗначение > 0 И ЧисловоеЗначение < 1 Тогда
		Результат.Уровень = "Помилка";
		Результат.Пояснение = СтрШаблон(
			"неоднозначне значення ""%1"": це %2%% чи %3%%? Впишіть %2 або %2%%",
			Исходный,
			Формат(ЧисловоеЗначение * 100, "ЧГ=0"),
			Формат(ЧисловоеЗначение, "ЧГ=0"));
		Возврат Результат;
	КонецЕсли;

	Округлённое = Окр(ЧисловоеЗначение, 2);
	Если Округлённое <> ЧисловоеЗначение Тогда
		Результат.Уровень = "Інфо";
		Результат.Пояснение = "округлено до " + Формат(Округлённое, "ЧГ=0");
	КонецЕсли;

	Результат.Процент = Округлённое;
	Возврат Результат;

КонецФункции

// Читает шапку файла: дату снимка, наименование структуры себестоимости, домов и модулей.
// Нужна форме, чтобы заполнить шапку сразу после выбора файла.
//
// Параметры:
//  АдресФайла - Строка - адрес двоичных данных файла во временном хранилище.
//  ИмяФайла   - Строка - исходное имя файла (по расширению выбирается формат чтения).
//
// Возвращаемое значение:
//  Структура - Дата, ИмяСС, Домов, Модулей, СтруктураСебестоимости, Ошибка.
Функция ПрочитатьПаспортФайла(Знач АдресФайла, Знач ИмяФайлаИсходное) Экспорт

	Паспорт = Новый Структура("Дата, ИмяСС, Домов, Модулей, СтруктураСебестоимости, Ошибка",
		'00010101', "", 0, 0, Справочники.А_СтруктураСебестоимости.ПустаяСсылка(), "");

	ТекстОшибки = "";
	Таб = ПрочитатьТабличныйДокумент(АдресФайла, ИмяФайлаИсходное, ТекстОшибки);
	Если Таб = Неопределено Тогда
		Паспорт.Ошибка = ТекстОшибки;
		Возврат Паспорт;
	КонецЕсли;

	ЗаполнитьПаспортИзТаблицы(Таб, Паспорт);
	Возврат Паспорт;

КонецФункции

// Разбирает файл в табличные части Дома и Строки. В базу НИЧЕГО не пишет —
// это предпросмотр «как обработка поняла файл».
//
// Параметры:
//  АдресФайла         - Строка - адрес двоичных данных файла во временном хранилище.
//  ИмяФайлаИсходное   - Строка - исходное имя файла.
//
// Возвращаемое значение:
//  Структура:
//   * Домов, Работ, Строк, Ошибок, Предупреждений - Число.
//   * Ошибка - Строка - фатальная ошибка (файл не тот / не читается); пусто, если разобран.
Функция РазобратьФайл(Знач АдресФайла, Знач ИмяФайлаИсходное) Экспорт

	Сводка = Новый Структура("Домов, Работ, Строк, Ошибок, Предупреждений, Ошибка",
		0, 0, 0, 0, 0, "");

	Дома.Очистить();
	Строки.Очистить();
	КоличествоДомовФайл = 0;
	КоличествоМодулейФайл = 0;

	Если НЕ ЗначениеЗаполнено(СтруктураСебестоимости) Тогда
		Сводка.Ошибка = "Не вказана структура собівартості";
		ТекстСводки = Сводка.Ошибка;
		Возврат Сводка;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДатаЗагрузки) Тогда
		Сводка.Ошибка = "Не вказана дата завантаження";
		ТекстСводки = Сводка.Ошибка;
		Возврат Сводка;
	КонецЕсли;

	ТекстОшибки = "";
	Таб = ПрочитатьТабличныйДокумент(АдресФайла, ИмяФайлаИсходное, ТекстОшибки);
	Если Таб = Неопределено Тогда
		Сводка.Ошибка = ТекстОшибки;
		ТекстСводки = Сводка.Ошибка;
		Возврат Сводка;
	КонецЕсли;

	Разметка = РазметитьТаблицу(Таб);
	Если ЗначениеЗаполнено(Разметка.Ошибка) Тогда
		Сводка.Ошибка = Разметка.Ошибка;
		ТекстСводки = Сводка.Ошибка;
		Возврат Сводка;
	КонецЕсли;

	МодулейСС = МодулейВДоме(СтруктураСебестоимости);
	Если Разметка.Модулей <> МодулейСС Тогда
		Сводка.Ошибка = СтрШаблон(
			"У файлі модулів у домі %1, а в структурі собівартості ""%2"" — %3."
			+ " Файл сформовано для іншого проєкту або змінилася структура",
			Разметка.Модулей, Строка(СтруктураСебестоимости), МодулейСС);
		ТекстСводки = Сводка.Ошибка;
		Возврат Сводка;
	КонецЕсли;

	КоличествоМодулейФайл = Разметка.Модулей;
	КоличествоДомовФайл = Разметка.Дома.Количество();

	ЗаполнитьТаблицуДомов(Разметка, КартаДомовСС(СтруктураСебестоимости), Сводка);
	ЗаполнитьСтрокиМатрицы(Таб, Разметка, КартаРаботСС(СтруктураСебестоимости),
		ПредыдущиеПроценты(СтруктураСебестоимости, ДатаЗагрузки), Сводка);
	ПересчитатьИтогиДомов();

	ТекстСводки = СтрШаблон("Домів %1 · робіт %2 · рядків %3 · помилок %4 · попереджень %5",
		КоличествоДомовФайл, Сводка.Работ, Сводка.Строк, Сводка.Ошибок, Сводка.Предупреждений);

	Возврат Сводка;

КонецФункции

// Создаёт/обновляет документы по разобранному файлу — по одному на отмеченный дом.
//
// Весь пакет пишется в ОДНОЙ транзакции: сбой на любом доме откатывает всё,
// половина загруженного снимка хуже, чем ничего.
//
// Возвращаемое значение:
//  Структура - Створено, Оновлено, Проведено, Пропущено (Число), Помилка (Строка).
Функция СоздатьДокументы() Экспорт

	Результат = Новый Структура("Створено, Оновлено, Проведено, Пропущено, Помилка",
		0, 0, 0, 0, "");

	Если Строки.Количество() = 0 Тогда
		Результат.Помилка = "Спочатку розшифруйте файл";
		Возврат Результат;
	КонецЕсли;

	Организация = ОрганизацияДляДокументов(СтруктураСебестоимости);
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Результат.Помилка = "Не знайдено організацію для документів";
		Возврат Результат;
	КонецЕсли;

	// Время 9:00 — как у всех существующих снимков; поиск документа всё равно идёт по дню.
	ДатаДокумента = НачалоДня(ДатаЗагрузки) + 9 * 3600;
	ЗаписанныеДокументы = Новый Соответствие;

	НачатьТранзакцию();

	Попытка

		Для Каждого СтрокаДома Из Дома Цикл

			Если НЕ СтрокаДома.Вантажити ИЛИ НЕ ЗначениеЗаполнено(СтрокаДома.Подразделение) Тогда
				Результат.Пропущено = Результат.Пропущено + 1;
				Продолжить;
			КонецЕсли;

			СсылкаДокумента = НайтиДокументДня(СтруктураСебестоимости,
				СтрокаДома.Подразделение, ДатаЗагрузки);

			Если ЗначениеЗаполнено(СсылкаДокумента) Тогда
				ДокументОбъект = СсылкаДокумента.ПолучитьОбъект();
				Результат.Оновлено = Результат.Оновлено + 1;
			Иначе
				ДокументОбъект = Документы.А_ВыполнениеРаботМодулей.СоздатьДокумент();
				ДокументОбъект.Дата = ДатаДокумента;
				// метку загрузки ставим только новому документу: у существующего
				// комментарий мог написать пользователь
				ДокументОбъект.Комментарий = Лев("Завантажено з файлу " + ИмяФайла, 500);
				Результат.Створено = Результат.Створено + 1;
			КонецЕсли;

			ДокументОбъект.Организация = Организация;
			ДокументОбъект.СтруктураСебестоимости = СтруктураСебестоимости;
			ДокументОбъект.Подразделение = СтрокаДома.Подразделение;
			ДокументОбъект.КоличествоМодулей = Макс(КоличествоМодулейФайл, 1);
			ДокументОбъект.Работы.Очистить();

			Отбор = Новый Структура("НомерДома", СтрокаДома.НомерДома);
			Для Каждого СтрокаМатрицы Из Строки.НайтиСтроки(Отбор) Цикл

				Если НЕ СтрокаМатрицы.Грузить ИЛИ НЕ ЗначениеЗаполнено(СтрокаМатрицы.Работа) Тогда
					Продолжить;
				КонецЕсли;

				СтрокаТЧ = ДокументОбъект.Работы.Добавить();
				СтрокаТЧ.Работа = СтрокаМатрицы.Работа;
				СтрокаТЧ.Этап = СтрокаМатрицы.Этап;
				СтрокаТЧ.НомерМодуля = СтрокаМатрицы.НомерМодуля;
				СтрокаТЧ.ПланЧасыМодуля = СтрокаМатрицы.ПланЧасыМодуля;
				СтрокаТЧ.Процент = СтрокаМатрицы.Процент;
				СтрокаТЧ.ЧасыВыполнение = Окр(
					СтрокаМатрицы.ПланЧасыМодуля * СтрокаМатрицы.Процент / 100, 2);
				СтрокаТЧ.Комментарий = СтрокаМатрицы.Комментарий;

			КонецЦикла;

			Если Проводить Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Результат.Проведено = Результат.Проведено + 1;
			Иначе
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;

			ЗаписанныеДокументы.Вставить(СтрокаДома.НомерДома, ДокументОбъект.Ссылка);

		КонецЦикла;

		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();
		Результат.Помилка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат.Створено = 0;
		Результат.Оновлено = 0;
		Результат.Проведено = 0;
		ЗаписьЖурналаРегистрации("ЗагрузкаВыполненияРабот", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;

	КонецПопытки;

	// Ссылки проставляем ТОЛЬКО после успешной фиксации: при откате в форме остались бы
	// ссылки на несуществующие документы.
	Для Каждого СтрокаДома Из Дома Цикл
		СсылкаЗаписанного = ЗаписанныеДокументы.Получить(СтрокаДома.НомерДома);
		Если СсылкаЗаписанного <> Неопределено Тогда
			СтрокаДома.Документ = СсылкаЗаписанного;
			СтрокаДома.Состояние = ?(Проводить, "проведено", "записано");
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Истина, если строка — корректное число вида «123», «12.5», «.5», «-7»
// (разделитель дробной части уже приведён к точке).
Функция ЭтоЧисловаяСтрока(Знач Значение)

	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Цифр = 0;
	Точек = 0;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифр = Цифр + 1;
		ИначеЕсли Символ = "." Тогда
			Точек = Точек + 1;
		ИначеЕсли Символ = "-" И Индекс = 1 Тогда
			// минус допустим только первым символом — число отсеется проверкой диапазона
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Цифр > 0 И Точек <= 1;

КонецФункции

// Кладёт двоичные данные во временный файл и читает табличным документом.
// ⚠ Расширение обязано совпадать с исходным — платформа выбирает формат по нему.
// ⚠ Если файл открыт в Excel, чтение падает «Ошибка совместного доступа» — говорим об этом прямо.
Функция ПрочитатьТабличныйДокумент(Знач АдресФайла, Знач ИмяФайлаИсходное, ТекстОшибки)

	ТекстОшибки = "";

	Если НЕ ЭтоАдресВременногоХранилища(АдресФайла) Тогда
		ТекстОшибки = "Файл не обрано";
		Возврат Неопределено;
	КонецЕсли;

	Расширение = "xlsx";
	Точка = СтрНайти(ИмяФайлаИсходное, ".", НаправлениеПоиска.СКонца);
	Если Точка > 0 Тогда
		Расширение = НРег(Сред(ИмяФайлаИсходное, Точка + 1));
	КонецЕсли;

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	Таб = Новый ТабличныйДокумент;

	Попытка
		ПолучитьИзВременногоХранилища(АдресФайла).Записать(ИмяВременногоФайла);
		Таб.Прочитать(ИмяВременногоФайла);
	Исключение
		ТекстОшибки = "Не вдалося прочитати файл: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ ". Якщо файл відкритий в Excel — закрийте його і повторіть.";
		Таб = Неопределено;
	КонецПопытки;

	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		// временный файл уберёт платформа
	КонецПопытки;

	Возврат Таб;

КонецФункции

// Разбирает первые строки файла: «На дату», «Структура собівартості», «Домів / Модулів у домі».
Процедура ЗаполнитьПаспортИзТаблицы(Таб, Паспорт)

	Для НомерСтроки = 1 По Мин(Таб.ВысотаТаблицы, 12) Цикл

		Текст = ТекстЯчейки(Таб, НомерСтроки, 1);
		Если ПустаяСтрока(Текст) Тогда
			Продолжить;
		КонецЕсли;
		НижнийТекст = НРег(Текст);

		Если СтрНайти(НижнийТекст, "на дату:") > 0 Тогда
			Паспорт.Дата = ДатаИзТекста(ФрагментПослеМетки(Текст, "На дату:", Новый Массив));
		КонецЕсли;

		Если СтрНайти(НижнийТекст, "період:") > 0 И НЕ ЗначениеЗаполнено(Паспорт.Дата) Тогда
			// полный вариант отчёта: «… Період: 01.08.2026 – 05.08.2026» — берём конец периода
			Хвост = ФрагментПослеМетки(Текст, "Період:", Новый Массив);
			Части = СтрРазделить(Хвост, "–", Ложь);
			Паспорт.Дата = ДатаИзТекста(Части[Части.ВГраница()]);
		КонецЕсли;

		Если СтрНайти(НижнийТекст, "структура собівартості:") > 0 Тогда
			Ограничители = Новый Массив;
			Ограничители.Добавить("Період:");
			Паспорт.ИмяСС = ФрагментПослеМетки(Текст, "Структура собівартості:", Ограничители);
		КонецЕсли;

		Если СтрНайти(НижнийТекст, "домів:") > 0 Тогда
			ОграничителиДомов = Новый Массив;
			ОграничителиДомов.Добавить("Модулів");
			Паспорт.Домов = Число(ТолькоЦифры(ФрагментПослеМетки(Текст, "Домів:", ОграничителиДомов)));

			ОграничителиМодулей = Новый Массив;
			ОграничителиМодулей.Добавить("Площа");
			Паспорт.Модулей = Число(ТолькоЦифры(
				ФрагментПослеМетки(Текст, "Модулів у домі:", ОграничителиМодулей)));
		КонецЕсли;

	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(Паспорт.ИмяСС) Тогда
		Паспорт.Ошибка = "У файлі немає рядка ""Структура собівартості: …"" —"
			+ " це не звіт з виконання робіт по домах і модулях";
		Возврат;
	КонецЕсли;

	Паспорт.СтруктураСебестоимости = НайтиСтруктуруСебестоимости(Паспорт.ИмяСС);
	Если НЕ ЗначениеЗаполнено(Паспорт.СтруктураСебестоимости) Тогда
		Паспорт.Ошибка = "У базі немає структури собівартості """ + Паспорт.ИмяСС
			+ """ — перевірте, чи не перейменували її";
	КонецЕсли;

КонецПроцедуры

Функция ТекстЯчейки(Таб, Знач НомерСтроки, Знач НомерКолонки)
	Возврат СокрЛП(Таб.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
КонецФункции

// Кусок строки после метки, обрезанный по первому встреченному ограничителю.
Функция ФрагментПослеМетки(Знач Текст, Знач Метка, Знач Ограничители)

	Позиция = СтрНайти(НРег(Текст), НРег(Метка));
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Позиция + СтрДлина(Метка));
	Для Каждого Ограничитель Из Ограничители Цикл
		ПозицияОграничителя = СтрНайти(НРег(Хвост), НРег(Ограничитель));
		Если ПозицияОграничителя > 0 Тогда
			Хвост = Лев(Хвост, ПозицияОграничителя - 1);
		КонецЕсли;
	КонецЦикла;

	Возврат СокрЛП(Хвост);

КонецФункции

Функция ТолькоЦифры(Знач Текст)

	Результат = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(Результат = "", "0", Результат);

КонецФункции

// «05.08.2026» -> Дата. Некорректный текст -> пустая дата.
Функция ДатаИзТекста(Знач Текст)

	Части = СтрРазделить(СокрЛП(Текст), ".", Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		Возврат Дата(Число(ТолькоЦифры(Части[2])), Число(ТолькоЦифры(Части[1])),
			Число(ТолькоЦифры(Части[0])));
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

Функция НайтиСтруктуруСебестоимости(Знач Наименование)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости КАК СС
	|ГДЕ
	|	СС.Наименование = &Наименование
	|	И НЕ СС.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка,
		Справочники.А_СтруктураСебестоимости.ПустаяСсылка());

КонецФункции

// Модулей в доме = СС.А_КоличествоМодулей (15 м -> 1, 30 м -> 2, ВООЗ -> 8), но не меньше 1.
Функция МодулейВДоме(Знач СС)

	Если НЕ ЗначениеЗаполнено(СС) Тогда
		Возврат 1;
	КонецЕсли;
	Возврат Макс(СС.А_КоличествоМодулей, 1);

КонецФункции

// Находит строку шапки таблицы, колонку работ, колонки матрицы «дім × модуль» и «Коментар».
//
// 🔴 Колонка входит в матрицу, если во ВТОРОЙ строке шапки стоит «М<число>».
// У фиксированных колонок («№», «Найменування робіт», «Норма на модуль», …) ячейка объединена
// по вертикали и во второй строке пуста, поэтому правило одинаково работает для краткого
// и полного вариантов отчёта. Заголовок «Дім №k» при M > 1 объединён по горизонтали —
// текст лежит только в первой колонке дома, остальные колонки наследуют текущий дом.
Функция РазметитьТаблицу(Таб)

	Разметка = Новый Структура(
		"СтрокаШапки, СтрокаМодулей, КолРабота, КолКоментар, Колонки, Дома, Модулей, Ошибка",
		0, 0, 0, 0, Новый Массив, Новый Массив, 0, "");

	Для НомерСтроки = 1 По Мин(Таб.ВысотаТаблицы, 12) Цикл
		Для НомерКолонки = 1 По Мин(Таб.ШиринаТаблицы, 4) Цикл
			Если СтрНайти(НРег(ТекстЯчейки(Таб, НомерСтроки, НомерКолонки)), "найменування роб") > 0 Тогда
				Разметка.СтрокаШапки = НомерСтроки;
				Разметка.КолРабота = НомерКолонки;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Разметка.СтрокаШапки > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Разметка.СтрокаШапки = 0 Тогда
		Разметка.Ошибка = "У файлі немає колонки ""Найменування робіт"" —"
			+ " це не звіт з виконання робіт по домах і модулях";
		Возврат Разметка;
	КонецЕсли;

	Разметка.СтрокаМодулей = Разметка.СтрокаШапки + 1;
	НомерДома = 0;
	ЗаголовокДома = "";

	Для НомерКолонки = 1 По Таб.ШиринаТаблицы Цикл

		ЗаголовокШапки = ТекстЯчейки(Таб, Разметка.СтрокаШапки, НомерКолонки);
		ЗаголовокМодуля = ТекстЯчейки(Таб, Разметка.СтрокаМодулей, НомерКолонки);

		Если СтрНайти(НРег(ЗаголовокШапки), "коментар") > 0 Тогда
			Разметка.КолКоментар = НомерКолонки;
		КонецЕсли;

		Если НЕ ЭтоЗаголовокМодуля(ЗаголовокМодуля) Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(ЗаголовокШапки) Тогда
			ЗаголовокДома = ЗаголовокШапки;
			ПозицияНомера = СтрНайти(ЗаголовокШапки, "№");
			Если ПозицияНомера > 0 Тогда
				НомерДома = Число(ТолькоЦифры(Сред(ЗаголовокШапки, ПозицияНомера + 1, 4)));
			Иначе
				НомерДома = НомерДома + 1;
			КонецЕсли;
			ОписаниеДома = Новый Структура("Номер, Заголовок", НомерДома, ЗаголовокДома);
			Разметка.Дома.Добавить(ОписаниеДома);
		КонецЕсли;

		ОписаниеКолонки = Новый Структура("Колонка, НомерДома, ЗаголовокДома, НомерМодуля",
			НомерКолонки, НомерДома, ЗаголовокДома, Число(Сред(ЗаголовокМодуля, 2)));
		Разметка.Колонки.Добавить(ОписаниеКолонки);

	КонецЦикла;

	Если Разметка.Колонки.Количество() = 0 Тогда
		Разметка.Ошибка = "У файлі немає жодної колонки ""Дім №… / М1"" —"
			+ " перевірте, що збережено саме звіт з виконання робіт";
		Возврат Разметка;
	КонецЕсли;

	Разметка.Модулей = Разметка.Колонки.Количество() / Разметка.Дома.Количество();
	Если Разметка.Модулей <> Цел(Разметка.Модулей) Тогда
		Разметка.Ошибка = "Колонки модулів у файлі розкладені нерівномірно по домах —"
			+ " файл пошкоджено (видалили або додали колонку?)";
	КонецЕсли;

	Возврат Разметка;

КонецФункции

Функция ЭтоЗаголовокМодуля(Знач Заголовок)

	Если СтрДлина(Заголовок) < 2 Тогда
		Возврат Ложь;
	КонецЕсли;

	ПерваяБуква = ВРег(Лев(Заголовок, 1));
	// «М» кириллическая (как пишет отчёт) и «M» латинская — на случай ручной правки шапки
	Если ПерваяБуква <> "М" И ПерваяБуква <> "M" Тогда
		Возврат Ложь;
	КонецЕсли;

	Хвост = Сред(Заголовок, 2);
	Возврат ЭтоЧисловаяСтрока(Хвост) И СтрНайти(Хвост, ".") = 0 И СтрНайти(Хвост, "-") = 0;

КонецФункции

// Работы СС: ключ — нормализованное наименование (мягкое и жёсткое),
// значение — Структура(Работа, Этап, Норма, Наименование).
Функция КартаРаботСС(Знач СС)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СС", СС);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.Работа КАК Работа,
	|	Р.Работа.Наименование КАК Наименование,
	|	МАКСИМУМ(Р.Этап) КАК Этап,
	|	СУММА(Р.Количество) КАК Норма
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Работы КАК Р
	|ГДЕ
	|	Р.Ссылка = &СС
	|	И Р.Работа <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|СГРУППИРОВАТЬ ПО
	|	Р.Работа,
	|	Р.Работа.Наименование";

	Карта = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Описание = Новый Структура("Работа, Этап, Норма, Наименование",
			Выборка.Работа, Выборка.Этап,
			?(ЗначениеЗаполнено(Выборка.Норма), Выборка.Норма, 0), Выборка.Наименование);
		Карта.Вставить(КлючИмени(Выборка.Наименование), Описание);
		Карта.Вставить(КлючИмениЖёсткий(Выборка.Наименование), Описание);
	КонецЦикла;

	Возврат Карта;

КонецФункции

// Мягкая нормализация имени: регистр не важен, повторные пробелы схлопнуты.
Функция КлючИмени(Знач Наименование)

	Результат = НРег(СокрЛП(Строка(Наименование)));
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Жёсткая нормализация: снимает пробелы и пунктуацию (точки, скобки, дефисы, апострофы).
// Префикс «##» отделяет жёсткие ключи от мягких в одном соответствии.
Функция КлючИмениЖёсткий(Знач Наименование)

	Исходный = НРег(Строка(Наименование));
	Результат = "";
	Для Индекс = 1 По СтрДлина(Исходный) Цикл
		Символ = Сред(Исходный, Индекс, 1);
		Если СтрНайти(" .,;:!?-–—()""'«»/\|_", Символ) = 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат "##" + Результат;

КонецФункции

// Дома-подразделения СС берём из СУЩЕСТВУЮЩИХ документов: реквизит СС.Подразделение
// могли переуказать на верхний уровень проекта (LESSONS §8). Ключи — номер после «№»
// и нормализованное наименование (на случай обрезанного заголовка без номера).
Функция КартаДомовСС(Знач СС)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СС", СС);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Д.Подразделение КАК Подразделение,
	|	Д.Подразделение.Наименование КАК Наименование
	|ИЗ
	|	Документ.А_ВыполнениеРаботМодулей КАК Д
	|ГДЕ
	|	Д.СтруктураСебестоимости = &СС
	|	И НЕ Д.ПометкаУдаления";

	Карта = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПозицияНомера = СтрНайти(Выборка.Наименование, "№");
		Если ПозицияНомера > 0 Тогда
			Номер = Число(ТолькоЦифры(Сред(Выборка.Наименование, ПозицияНомера + 1, 4)));
			Карта.Вставить(Номер, Выборка.Подразделение);
		КонецЕсли;
		Карта.Вставить(КлючИмени(Выборка.Наименование), Выборка.Подразделение);
	КонецЦикла;

	Возврат Карта;

КонецФункции

Процедура ЗаполнитьТаблицуДомов(Разметка, КартаДомов, Сводка)

	Для Каждого ОписаниеДома Из Разметка.Дома Цикл

		СтрокаДома = Дома.Добавить();
		СтрокаДома.Вантажити = Истина;
		СтрокаДома.НомерДома = ОписаниеДома.Номер;
		СтрокаДома.ЗаголовокКолонки = ОписаниеДома.Заголовок;

		Подразделение = КартаДомов.Получить(ОписаниеДома.Номер);
		Если Подразделение = Неопределено Тогда
			Подразделение = КартаДомов.Получить(КлючИмени(ОписаниеДома.Заголовок));
		КонецЕсли;

		Если Подразделение = Неопределено Тогда
			СтрокаДома.Состояние = "підрозділ не знайдено";
			СтрокаДома.Вантажити = Ложь;
			СтрокаДома.Ошибок = 1;
			Сводка.Ошибок = Сводка.Ошибок + 1;
		Иначе
			СтрокаДома.Подразделение = Подразделение;
			СтрокаДома.Документ = НайтиДокументДня(СтруктураСебестоимости, Подразделение, ДатаЗагрузки);
			СтрокаДома.Состояние = ?(ЗначениеЗаполнено(СтрокаДома.Документ),
				"оновити наявний", "створити новий");
		КонецЕсли;

	КонецЦикла;

	Сводка.Домов = Дома.Количество();

КонецПроцедуры

// Состояние базы НА дату загрузки: проценты последнего проведённого снимка каждого дома
// с датой ВКЛЮЧИТЕЛЬНО по конец дня загрузки.
//
// 🔴 Именно включительно: если документы этого дня уже есть (перезагрузка), сравнивать надо
// с ними — тогда «Зміни» показывают, что правит эта загрузка, и совпадают с тем, на сколько
// изменится накопленный ЧасыВыполнение в РН. Если документов дня нет (первая загрузка),
// запрос сам возьмёт последний снимок раньше — и «Зміни» покажут недельный прирост.
Функция ПредыдущиеПроценты(Знач СС, Знач ДатаСнимка)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СС", СС);
	Запрос.УстановитьПараметр("Граница", КонецДня(ДатаСнимка));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Д.Подразделение КАК Подразделение,
	|	МАКСИМУМ(Д.Дата) КАК ДатаСнимка
	|ПОМЕСТИТЬ ВТ_Последние
	|ИЗ
	|	Документ.А_ВыполнениеРаботМодулей КАК Д
	|ГДЕ
	|	Д.СтруктураСебестоимости = &СС
	|	И НЕ Д.ПометкаУдаления
	|	И Д.Проведен
	|	И Д.Дата <= &Граница
	|СГРУППИРОВАТЬ ПО
	|	Д.Подразделение
	|;
	|ВЫБРАТЬ
	|	ВТ.Подразделение КАК Подразделение,
	|	Т.Работа КАК Работа,
	|	Т.НомерМодуля КАК НомерМодуля,
	|	Т.Процент КАК Процент
	|ИЗ
	|	ВТ_Последние КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.А_ВыполнениеРаботМодулей КАК Д
	|		ПО ВТ.Подразделение = Д.Подразделение
	|			И ВТ.ДатаСнимка = Д.Дата
	|			И Д.СтруктураСебестоимости = &СС
	|			И НЕ Д.ПометкаУдаления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.А_ВыполнениеРаботМодулей.Работы КАК Т
	|		ПО Т.Ссылка = Д.Ссылка";

	Карта = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Карта.Вставить(КлючЯчейки(Выборка.Подразделение, Выборка.Работа, Выборка.НомерМодуля),
			Выборка.Процент);
	КонецЦикла;

	Возврат Карта;

КонецФункции

Функция КлючЯчейки(Знач Подразделение, Знач Работа, Знач НомерМодуля)

	Возврат Строка(Подразделение.УникальныйИдентификатор()) + "|"
		+ Строка(Работа.УникальныйИдентификатор()) + "|"
		+ Формат(НомерМодуля, "ЧГ=0");

КонецФункции

// Документ снимка ищем по СС + Подразделение + ДЕНЬ (не по времени): повторная загрузка
// того же дня обновляет тот же документ, а не плодит новые (LESSONS §9).
Функция НайтиДокументДня(Знач СС, Знач Подразделение, Знач ДатаСнимка)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СС", СС);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ДатаСнимка));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ДатаСнимка));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Д.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.А_ВыполнениеРаботМодулей КАК Д
	|ГДЕ
	|	Д.СтруктураСебестоимости = &СС
	|	И Д.Подразделение = &Подразделение
	|	И НЕ Д.ПометкаУдаления
	|	И Д.Дата МЕЖДУ &НачалоДня И &КонецДня
	|УПОРЯДОЧИТЬ ПО
	|	Д.Дата";

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка,
		Документы.А_ВыполнениеРаботМодулей.ПустаяСсылка());

КонецФункции

Процедура ЗаполнитьСтрокиМатрицы(Таб, Разметка, КартаРабот, ПредыдущийСнимок, Сводка)

	ВстреченныеРаботы = Новый Соответствие;

	Для НомерСтроки = Разметка.СтрокаМодулей + 1 По Таб.ВысотаТаблицы Цикл

		ИмяРаботы = ТекстЯчейки(Таб, НомерСтроки, Разметка.КолРабота);
		Если ПустаяСтрока(ИмяРаботы) Тогда
			Продолжить;
		КонецЕсли;

		НижнееИмя = НРег(ИмяРаботы);
		// подвал отчёта: «Табель, год» и «Загальна» — это не работы
		Если СтрНачинаетсяС(НижнееИмя, "загальна") ИЛИ СтрНачинаетсяС(НижнееИмя, "табель") Тогда
			Продолжить;
		КонецЕсли;

		Сводка.Работ = Сводка.Работ + 1;

		ОписаниеРаботы = КартаРабот.Получить(КлючИмени(ИмяРаботы));
		Если ОписаниеРаботы = Неопределено Тогда
			ОписаниеРаботы = КартаРабот.Получить(КлючИмениЖёсткий(ИмяРаботы));
		КонецЕсли;

		Дубль = (ВстреченныеРаботы.Получить(КлючИмени(ИмяРаботы)) <> Неопределено);
		ВстреченныеРаботы.Вставить(КлючИмени(ИмяРаботы), Истина);

		Комментарий = ?(Разметка.КолКоментар > 0,
			ТекстЯчейки(Таб, НомерСтроки, Разметка.КолКоментар), "");
		ПланМодуля = ?(ОписаниеРаботы = Неопределено, 0, ОписаниеРаботы.Норма / Разметка.Модулей);

		Для Каждого ОписаниеКолонки Из Разметка.Колонки Цикл

			СтрокаМатрицы = Строки.Добавить();
			СтрокаМатрицы.НомерДома = ОписаниеКолонки.НомерДома;
			СтрокаМатрицы.ЗаголовокДома = ОписаниеКолонки.ЗаголовокДома;
			СтрокаМатрицы.НомерМодуля = ОписаниеКолонки.НомерМодуля;
			СтрокаМатрицы.РаботаТекст = Лев(ИмяРаботы, 150);
			СтрокаМатрицы.ТекстЯчейки = Лев(ТекстЯчейки(Таб, НомерСтроки, ОписаниеКолонки.Колонка), 50);
			СтрокаМатрицы.Комментарий = Лев(Комментарий, 500);
			СтрокаМатрицы.ПланЧасыМодуля = ПланМодуля;
			СтрокаМатрицы.Грузить = Истина;

			СтрокаДома = НайтиСтрокуДома(ОписаниеКолонки.НомерДома);
			Если СтрокаДома <> Неопределено Тогда
				СтрокаМатрицы.Подразделение = СтрокаДома.Подразделение;
			КонецЕсли;

			Если Дубль Тогда
				ПометитьОшибку(СтрокаМатрицы, СтрШаблон(
					"робота ""%1"" зустрічається у файлі двічі — залиште один рядок", ИмяРаботы), Сводка);
				Продолжить;
			КонецЕсли;

			Если ОписаниеРаботы = Неопределено Тогда
				ПометитьОшибку(СтрокаМатрицы, СтрШаблон(
					"роботи ""%1"" немає в структурі собівартості%2",
					ИмяРаботы, ПодсказкаПохожейРаботы(ИмяРаботы, КартаРабот)), Сводка);
				Продолжить;
			КонецЕсли;

			СтрокаМатрицы.Работа = ОписаниеРаботы.Работа;
			СтрокаМатрицы.Этап = ОписаниеРаботы.Этап;

			// Стан бази заповнюємо ДО розбору відсотка: навіть у проблемної клітинки
			// матриця «Було» має показати те, що зараз лежить у документах.
			Если ЗначениеЗаполнено(СтрокаМатрицы.Подразделение) Тогда
				Ключ = КлючЯчейки(СтрокаМатрицы.Подразделение, СтрокаМатрицы.Работа,
					СтрокаМатрицы.НомерМодуля);
				Предыдущий = ПредыдущийСнимок.Получить(Ключ);
				СтрокаМатрицы.ПроцентПред = ?(Предыдущий = Неопределено, 0, Предыдущий);
			КонецЕсли;

			Разбор = НормализоватьПроцент(СтрокаМатрицы.ТекстЯчейки);
			Если Разбор.Уровень = "Помилка" Тогда
				ПометитьОшибку(СтрокаМатрицы, Разбор.Пояснение, Сводка);
				Продолжить;
			КонецЕсли;

			СтрокаМатрицы.Процент = Разбор.Процент;
			Если Разбор.Уровень = "Інфо" Тогда
				СтрокаМатрицы.Уровень = "Інфо";
				СтрокаМатрицы.Пояснение = Разбор.Пояснение;
			КонецЕсли;

			Если НЕ ЗначениеЗаполнено(СтрокаМатрицы.Подразделение) Тогда
				Продолжить;
			КонецЕсли;

			СтрокаМатрицы.Дельта = СтрокаМатрицы.Процент - СтрокаМатрицы.ПроцентПред;

			Если СтрокаМатрицы.Дельта < 0 Тогда
				СтрокаМатрицы.Уровень = "Попередження";
				СтрокаМатрицы.Проблемна = Истина;
				СтрокаМатрицы.Пояснение = СтрШаблон(
					"відкат: у базі %1%%, у файлі %2%% — завантаження знизить показник",
					Формат(СтрокаМатрицы.ПроцентПред, "ЧГ=0"), Формат(СтрокаМатрицы.Процент, "ЧГ=0"));
				Сводка.Предупреждений = Сводка.Предупреждений + 1;
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Сводка.Строк = Строки.Количество();

КонецПроцедуры

Процедура ПометитьОшибку(СтрокаМатрицы, Знач Пояснение, Сводка)

	СтрокаМатрицы.Уровень = "Помилка";
	СтрокаМатрицы.Пояснение = Лев(Пояснение, 250);
	СтрокаМатрицы.Проблемна = Истина;
	СтрокаМатрицы.Грузить = Ложь;
	Сводка.Ошибок = Сводка.Ошибок + 1;

КонецПроцедуры

// «Схоже на: …» — работа СС с самым длинным общим началом (по жёсткой нормализации).
Функция ПодсказкаПохожейРаботы(Знач ИмяРаботы, КартаРабот)

	Эталон = СтрЗаменить(КлючИмениЖёсткий(ИмяРаботы), "##", "");
	ЛучшаяДлина = 0;
	ЛучшееИмя = "";

	Для Каждого КлючИЗначение Из КартаРабот Цикл

		Если Лев(КлючИЗначение.Ключ, 2) <> "##" Тогда
			Продолжить;
		КонецЕсли;

		Кандидат = Сред(КлючИЗначение.Ключ, 3);
		Длина = 0;
		Пока Длина < СтрДлина(Кандидат) И Длина < СтрДлина(Эталон)
			И Сред(Кандидат, Длина + 1, 1) = Сред(Эталон, Длина + 1, 1) Цикл
			Длина = Длина + 1;
		КонецЦикла;

		Если Длина > ЛучшаяДлина Тогда
			ЛучшаяДлина = Длина;
			ЛучшееИмя = КлючИЗначение.Значение.Наименование;
		КонецЕсли;

	КонецЦикла;

	Возврат ?(ЛучшаяДлина >= 5, ". Схоже на: """ + ЛучшееИмя + """", "");

КонецФункции

Функция НайтиСтрокуДома(Знач НомерДома)

	Для Каждого СтрокаДома Из Дома Цикл
		Если СтрокаДома.НомерДома = НомерДома Тогда
			Возврат СтрокаДома;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Организация — как в уже существующих документах этой СС, иначе первая непомеченная.
Функция ОрганизацияДляДокументов(Знач СС)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СС", СС);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Д.Организация КАК Организация
	|ИЗ
	|	Документ.А_ВыполнениеРаботМодулей КАК Д
	|ГДЕ
	|	Д.СтруктураСебестоимости = &СС
	|	И НЕ Д.ПометкаУдаления
	|	И Д.Организация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|УПОРЯДОЧИТЬ ПО
	|	Д.Дата УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Организация;
	КонецЕсли;

	ЗапросОрганизации = Новый Запрос;
	ЗапросОрганизации.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	О.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК О
	|ГДЕ
	|	НЕ О.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	О.Наименование";

	ВыборкаОрганизации = ЗапросОрганизации.Выполнить().Выбрать();
	Возврат ?(ВыборкаОрганизации.Следующий(), ВыборкаОрганизации.Ссылка,
		Справочники.Организации.ПустаяСсылка());

КонецФункции

Процедура ПересчитатьИтогиДомов()

	Для Каждого СтрокаДома Из Дома Цикл

		Отбор = Новый Структура("НомерДома", СтрокаДома.НомерДома);
		НайденныеСтроки = Строки.НайтиСтроки(Отбор);

		СуммаПроцентов = 0;
		Ошибок = СтрокаДома.Ошибок;
		Для Каждого СтрокаМатрицы Из НайденныеСтроки Цикл
			СуммаПроцентов = СуммаПроцентов + СтрокаМатрицы.Процент;
			Если СтрокаМатрицы.Уровень = "Помилка" Тогда
				Ошибок = Ошибок + 1;
			КонецЕсли;
		КонецЦикла;

		СтрокаДома.Строк = НайденныеСтроки.Количество();
		СтрокаДома.СреднийПроцент = ?(НайденныеСтроки.Количество() = 0, 0,
			Окр(СуммаПроцентов / НайденныеСтроки.Количество(), 2));
		СтрокаДома.Ошибок = Ошибок;

	КонецЦикла;

КонецПроцедуры

Функция ПолучитьТаблицуКоманд()

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;

КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование,
	ПоказыватьОповещение = Ложь, Модификатор = "")

	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;

КонецПроцедуры

#КонецОбласти
