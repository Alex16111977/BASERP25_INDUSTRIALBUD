Функция СведенияОВнешнейОбработке() Экспорт
    Назначения = Новый Массив ;
    Назначения.Добавить("Документ.ПередачаМалоценныхАктивовВЭксплуатацию") ;

    ПараметрыРегистрации = Новый Структура ;
    ПараметрыРегистрации.Вставить("Вид","ЗаполнениеОбъекта");
    ПараметрыРегистрации.Вставить("Назначение",Назначения);
    ПараметрыРегистрации.Вставить("Наименование","Загрузка из Excel ТЧ Передача малоценных активов");
    ПараметрыРегистрации.Вставить("Версия","1.0");
    ПараметрыРегистрации.Вставить("Информация","Дополнительная обработка табличной части");
    ПараметрыРегистрации.Вставить("БезопасныйРежим",Ложь);

    Команды = ПолучитьТаблицуКоманд() ;
    ДобавитьКоманду(Команды, "Загрузить из Excel",
            "Загрузить","ВызовКлиентскогоМетода",Ложь,) ;

    ПараметрыРегистрации.Вставить("Команды",Команды) ;

    Возврат ПараметрыРегистрации;

КонецФункции

Функция ПолучитьТаблицуКоманд()
    Команды = Новый ТаблицаЗначений ;
    Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка")) ;
    Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка")) ;
    Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка")) ;
    Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево")) ;
    Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка")) ;
    Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор,
	Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	НоваяКоманда = ТаблицаКоманд.Добавить() ;
	НоваяКоманда.Представление = Представление ;
	НоваяКоманда.Идентификатор = Идентификатор ;
	НоваяКоманда.Использование = Использование ;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение ;
	НоваяКоманда.Модификатор = Модификатор ;
КонецПроцедуры

// Заполняет ТЧ МалоценныеАктивы документа по таблице кодов из Excel.
// Строки ДОБАВЛЯЮТСЯ к существующим (без очистки ТЧ) — поведение как у образца.
// НазначениеИспользования, ФизЛицо, НалоговоеНазначение не заполняются — их указывает пользователь.
//
// Параметры:
//   ДокСсылка    - ДокументСсылка.ПередачаМалоценныхАктивовВЭксплуатацию
//   ТаблицаКодов - ТаблицаЗначений с колонками КодНоменлатуры (Строка), КвоДляСписания (Число)
//
// Возвращаемое значение:
//   Структура - Загружено, НеНайденоКодов, БезСчета (Число), Ошибка (Булево), ТекстОшибки (Строка)
Функция ЗаполнитьМалоценныеАктивы(ДокСсылка, ТаблицаКодов) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Загружено", 0);
	Результат.Вставить("НеНайденоКодов", 0);
	Результат.Вставить("БезСчета", 0);
	Результат.Вставить("Ошибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");

	Если НЕ ЗначениеЗаполнено(ДокСсылка) Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = НСтр("ru='Не указан документ для заполнения';uk='Не вказано документ для заповнення'");
		Возврат Результат;
	КонецЕсли;

	Попытка

		ДокОбъект = ДокСсылка.ПолучитьОбъект();

		КэшСчетов = Новый ТаблицаЗначений;
		КэшСчетов.Колонки.Добавить("Номенклатура");
		КэшСчетов.Колонки.Добавить("Счет");

		Для Каждого СтрокаКодов Из ТаблицаКодов Цикл

			текНоменклатура = Справочники.Номенклатура.НайтиПоКоду(СтрокаКодов.КодНоменлатуры);
			Если НЕ ЗначениеЗаполнено(текНоменклатура) Тогда
				Результат.НеНайденоКодов = Результат.НеНайденоКодов + 1;
				Сообщить("Не найдена номенклатура с кодом " + СтрокаКодов.КодНоменлатуры);
				Продолжить;
			КонецЕсли;

			НоваяСтрока = ДокОбъект.МалоценныеАктивы.Добавить();
			НоваяСтрока.Номенклатура     = текНоменклатура;
			НоваяСтрока.Количество       = СтрокаКодов.КвоДляСписания;
			НоваяСтрока.Коэффициент      = 1;
			НоваяСтрока.ЕдиницаИзмерения = текНоменклатура.БазоваяЕдиницаИзмерения;

			СчетУчетаБУ = ОпределитьСчетУчетаБУ(текНоменклатура, КэшСчетов);
			Если ЗначениеЗаполнено(СчетУчетаБУ) Тогда
				НоваяСтрока.СчетУчетаБУ = СчетУчетаБУ;
			Иначе
				Результат.БезСчета = Результат.БезСчета + 1;
				Сообщить("Нет остатков на счетах малоценки (22, 112, 153) для "
					+ СтрокаКодов.КодНоменлатуры + " " + Строка(текНоменклатура)
					+ " — строка загружена без счёта");
			КонецЕсли;

			Результат.Загружено = Результат.Загружено + 1;

		КонецЦикла;

		ДокОбъект.Записать();

	Исключение
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Счёт учёта БУ по остаткам на счетах малоценки: 22 (МШП), 112 (МНМА), 153 (капинвестиции в МНМА),
// включая субсчета (В ИЕРАРХИИ). Результат кэшируется, в т.ч. отсутствие остатка.
Функция ОпределитьСчетУчетаБУ(текНоменклатура, КэшСчетов)

	СтрокаКэша = КэшСчетов.Найти(текНоменклатура, "Номенклатура");
	Если СтрокаКэша <> Неопределено Тогда
		Возврат СтрокаКэша.Счет;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ХозрасчетныйОстатки.Счет КАК Счет
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(, Счет В ИЕРАРХИИ (&СпСчетов), , Субконто1 = &Субконто1) КАК ХозрасчетныйОстатки
	|ГДЕ
	|	ХозрасчетныйОстатки.КоличествоОстаток > 0
	|УПОРЯДОЧИТЬ ПО
	|	ХозрасчетныйОстатки.Счет.Код";

	СпСчетов = Новый СписокЗначений;
	СпСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("22"));
	СпСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("112"));
	СпСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("153"));

	Запрос.УстановитьПараметр("СпСчетов", СпСчетов);
	Запрос.УстановитьПараметр("Субконто1", текНоменклатура);

	НайденныйСчет = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НайденныйСчет = Выборка.Счет;
	КонецЕсли;

	СтрокаКэша = КэшСчетов.Добавить();
	СтрокаКэша.Номенклатура = текНоменклатура;
	СтрокаКэша.Счет = НайденныйСчет;

	Возврат НайденныйСчет;

КонецФункции
