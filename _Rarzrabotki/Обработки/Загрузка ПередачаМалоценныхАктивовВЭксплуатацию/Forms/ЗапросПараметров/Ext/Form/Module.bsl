
&НаКлиенте
Процедура Отмена(Команда)
	ЭтаФорма.Закрыть(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка    = Ложь;
	
	Описание    = Новый ОписаниеОповещения("ЗакончитьВыборФайла", ЭтотОбъект);
	НачатьПомещениеФайла(Описание,,,Истина, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ЗакончитьВыборФайла(Результат, Адрес, Имя, ДопПараметры) Экспорт
	Если Результат Тогда
		
		ИмяФайла        = Имя;
		АдресХранения   = Адрес;
		     
		Парам = Новый Структура("ОбъектДляЗаполнения,АдресХранения,ИмяФайла,Лист,ПерваяСтрока,КолонкаКоличество,КолонкаКод");
		Парам.ОбъектДляЗаполнения = ВладелецФормы;
		Парам.АдресХранения = Адрес;
		Парам.ИмяФайла = Имя; 
		Парам.ПерваяСтрока = Объект.ПерваяСтрока;
		Парам.КолонкаКоличество =Объект.КолонкаКоличество;
		Парам.КолонкаКод = Объект.КолонкаКод;
		
		
		
	ЭтаФорма.Закрыть(Парам);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	КонецПроцедуры

&НаКлиенте
	Процедура ПриОткрытии(Отказ)
		ОтобразитьДопреквизитыНаСервере();
	КонецПроцедуры
	
	
	Процедура ОтобразитьДопреквизитыНаСервере()
	
	
    КлючОбъекта = "НастройкаЗагрузкиПередачаМалоценки";
	КлючНастроек = "НастройкаЗагрузкиПередачаМалоценки";
	ОписаниеНастроек = "НастройкаЗагрузкиПередачаМалоценки";
	ИмяПользователя = "";

	Попытка	
	ЗначениеНастроек = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, КлючНастроек, ОписаниеНастроек, ИмяПользователя);

	Объект.ПерваяСтрока = ЗначениеНастроек.Получить("ПерваяСтрока");
	Объект.КолонкаКод =  ЗначениеНастроек.Получить("КолонкаКод");
	Объект.КолонкаКоличество =  ЗначениеНастроек.Получить("КолонкаКоличество");
Исключение
	КонецПопытки;

	
	КонецПроцедуры
