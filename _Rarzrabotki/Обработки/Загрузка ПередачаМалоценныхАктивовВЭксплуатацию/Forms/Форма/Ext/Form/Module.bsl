Перем ОбъектЗаполнения Экспорт;

&НаКлиенте
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ОбъектыНазначенияМассив) Экспорт
	Объект.Документ =  ОбъектыНазначенияМассив[0];
	ЗаполнениеНоменклатуры(Объект.Документ);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеНоменклатуры(ОбъектЗаполнения) Экспорт

	ЗакрытиеФормы = Новый ОписаниеОповещения
	("ЗаполнениеПоВыбраннымПараметрам", ЭтаФорма); // Название процедуры, которая будет выполняться после закрытия формы "ЗапросПараметров"
	ЗапросПараметров = ОткрытьФорму("ВнешняяОбработка.ЗагрузкаПередачаМалоценныхАктивовВЭксплуатацию.Форма.ЗапросПараметров", ,ОбъектЗаполнения,,,,ЗакрытиеФормы);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеПоВыбраннымПараметрам(Результат, Параметры) Экспорт
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат; // Пользователь не стал указывать параметры, останавливаем работу
	КонецЕсли;

	Загрузить(Результат) ;  // Результат содержит структуру, полученную из формы "ЗапросПараметров"
КонецПроцедуры

&НаКлиенте
Процедура  Загрузить(Параметры)
	Попытка
		СохранитьНастройкиНаСервере(Параметры);
	Исключение
	КонецПопытки;

	// Уникальное имя временного файла: фиксированное temp.xls ловило
	// "Ошибка совместного доступа" от зависшего Excel предыдущего запуска
	Расширение = ".xls";
	Если Параметры.Свойство("ИмяФайла") И ЗначениеЗаполнено(Параметры.ИмяФайла) Тогда
		ПозицияТочки = СтрНайти(Параметры.ИмяФайла, ".", НаправлениеПоиска.СКонца);
		Если ПозицияТочки > 0 Тогда
			Расширение = Сред(Параметры.ИмяФайла, ПозицияТочки);
		КонецЕсли;
	КонецЕсли;
	Путь = КаталогВременныхФайлов() + "malocenka_" + Строка(Новый УникальныйИдентификатор) + Расширение;

	Файл = ПолучитьИзВременногоХранилища(Параметры.АдресХранения);
	Попытка
		Файл.Записать(Путь);
	Исключение
		Сообщить("Не удалось записать временный файл " + Путь + ": " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	СтрПараметров = Новый Структура;
	СтрПараметров.Вставить("Ексель", Неопределено);
	СтрПараметров.Вставить("Книга", Неопределено);
	СтрПараметров.Вставить("Путь", Путь);
	СтрПараметров.Вставить("ПерваяСтрока", Параметры.ПерваяСтрока);
	СтрПараметров.Вставить("КолонкаКоличество", Параметры.КолонкаКоличество);
	СтрПараметров.Вставить("КолонкаКод", Параметры.КолонкаКод);

	Попытка
		Ексель = Новый COMObject("Excel.Application");
		СтрПараметров.Ексель = Ексель;
		Ексель.DisplayAlerts = Ложь;
		СтрПараметров.Книга = Ексель.WorkBooks.Open(Путь);

		СпЛистов = Новый СписокЗначений;
		Для СчЛистов=1  По Ексель.Sheets.COUNT() Цикл
			СпЛистов.Добавить(СчЛистов,Ексель.Sheets(СчЛистов).name);
		КонецЦикла;
	Исключение
		Сообщить("Не удалось открыть файл в Excel: " + ОписаниеОшибки());
		ЗакрытьЕксель(СтрПараметров);
		Возврат;
	КонецПопытки;

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораЭлемента", ЭтаФорма,СтрПараметров);
	СпЛистов.ПоказатьВыборЭлемента(Оповещение, "Выберите лист для загрузки");

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЭлемента(Элемент, СтрПараметров) Экспорт

	Если Элемент = Неопределено Тогда
		ЗакрытьЕксель(СтрПараметров); // отмена выбора листа — Excel не должен остаться висеть
		Возврат;
	КонецЕсли;

	// Любой сбой чтения листа не должен оставить Excel и временный файл занятыми
	Попытка

		ПерваяСтрока = СтрПараметров.ПерваяСтрока;
		КолонкаКоличество = СтрПараметров.КолонкаКоличество;
		КолонкаКод = СтрПараметров.КолонкаКод;
		Ексель = СтрПараметров.Ексель;

		ТекНомерЛиста = Элемент.Значение ;
		Лист = Ексель.Sheets(ТекНомерЛиста);

		Объект.ТчЗагрузка.Очистить(); // защита от задвоения при повторном запуске в той же форме

		ТекСтр = ПерваяСтрока;
		СчПробелов =0;
		Пока СчПробелов<50  Цикл

			Если ЗначениеЗаполнено(Лист.cells(ТекСтр,КолонкаКод).text)  Тогда
				СчПробелов=0;
			Иначе
				СчПробелов=СчПробелов+1;
				ТекСтр=ТекСтр+1;
				Продолжить;
			КонецЕсли;

			КодНоменлатурыЗначение =Лист.cells(ТекСтр,КолонкаКод).value;
			Если ТипЗнч(КодНоменлатурыЗначение )=Тип("Строка") Тогда
				КодНоменлатуры =КодНоменлатурыЗначение;
			Иначе
				КодНоменлатуры =Прав("00000000000"+Формат(КодНоменлатурыЗначение,"ЧДЦ=; ЧГ="),11);
			КонецЕсли;

			КвоДляСписания =Лист.cells(ТекСтр,КолонкаКоличество).value;

			Попытка
				КвоДляСписания=ЧИсло(КвоДляСписания);
			Исключение
				КвоДляСписания=0
			КонецПопытки;

			Если КвоДляСписания>0 Тогда
				НСтрока = Объект.ТчЗагрузка.Добавить();
				Нстрока.КодНоменлатуры = КодНоменлатуры;
				Нстрока.КвоДляСписания = КвоДляСписания;
			КонецЕсли;
			ТекСтр=ТекСтр+1
		КонецЦикла;

		Лист = Неопределено;

	Исключение
		Лист = Неопределено;
		ЗакрытьЕксель(СтрПараметров);
		Сообщить("Ошибка чтения листа Excel: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ЗакрытьЕксель(СтрПараметров);

	ЗагрузитьТЧ() ;
	Перечитать();

КонецПроцедуры

// Гарантированно закрывает книгу и Excel, освобождает COM-ссылки и удаляет временный файл.
// Каждая ступень в своей Попытке: сбой одной не должен помешать остальным.
&НаКлиенте
Процедура ЗакрытьЕксель(СтрПараметров)

	Попытка
		Если СтрПараметров.Книга <> Неопределено Тогда
			СтрПараметров.Книга.Close(Ложь); // снимает блокировку файла даже если процесс ещё жив
		КонецЕсли;
	Исключение
	КонецПопытки;
	СтрПараметров.Книга = Неопределено;

	Попытка
		Если СтрПараметров.Ексель <> Неопределено Тогда
			СтрПараметров.Ексель.Quit();
		КонецЕсли;
	Исключение
	КонецПопытки;
	СтрПараметров.Ексель = Неопределено;

	Попытка
		УдалитьФайлы(СтрПараметров.Путь);
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТЧ()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Результат = ОбъектОбработки.ЗаполнитьМалоценныеАктивы(Объект.Документ, ОбъектОбработки.ТчЗагрузка.Выгрузить());

	Если Результат.Ошибка Тогда
		Сообщить("Ошибка загрузки: " + Результат.ТекстОшибки);
	Иначе
		ТекстИтога = "Загружено строк: " + Результат.Загружено;
		Если Результат.НеНайденоКодов > 0 Тогда
			ТекстИтога = ТекстИтога + ", не найдено кодов: " + Результат.НеНайденоКодов;
		КонецЕсли;
		Если Результат.БезСчета > 0 Тогда
			ТекстИтога = ТекстИтога + ", без счёта: " + Результат.БезСчета;
		КонецЕсли;
		Сообщить(ТекстИтога);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Перечитать()

	Если НЕ ВладелецФормы=Неопределено Тогда
		ВладелецФормы.Прочитать(); // Если обработка вызывалась из документа, то нужно перечитать изменения, чтобы пользователь видел результат обработки
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Загрузить1(Команда)
	ЗаполнениеНоменклатуры(Объект.Документ)
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере(Параметры)

	КлючОбъекта = "НастройкаЗагрузкиПередачаМалоценки";
	КлючНастроек = "НастройкаЗагрузкиПередачаМалоценки";
	ОписаниеНастроек = "НастройкаЗагрузкиПередачаМалоценки";
	ИмяПользователя = "";

	Настройки = Новый Соответствие;

	Настройки.Вставить("ПерваяСтрока", Параметры.ПерваяСтрока);
	Настройки.Вставить("КолонкаКоличество", Параметры.КолонкаКоличество);
	Настройки.Вставить("КолонкаКод", Параметры.КолонкаКод);

	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючНастроек, Настройки, ОписаниеНастроек, ИмяПользователя);

КонецПроцедуры
