
&НаСервере
Функция ПолучитьСписокДокументовНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Рег.Регистратор КАК Регистратор,
	|	МИНИМУМ(Рег.Регистратор.Дата) КАК Дата,
	|	МИНИМУМ(Рег.Регистратор.Номер) КАК Номер,
	|	ТИПЗНАЧЕНИЯ(Рег.Регистратор) КАК ТипДокумента
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваВПути КАК Рег
	|ГДЕ
	|	Рег.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	|	И (Рег.Организация = &Организация ИЛИ &ВсеОрганизации)
	|	И Рег.Регистратор.Проведен = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	Рег.Регистратор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Объект.НачалоПериода));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(Объект.ОкончаниеПериода));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ВсеОрганизации", НЕ ЗначениеЗаполнено(Объект.Организация));

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		ДанныеСтроки = Новый Структура;
		ДанныеСтроки.Вставить("Регистратор", Выборка.Регистратор);
		ДанныеСтроки.Вставить("Дата", Выборка.Дата);
		ДанныеСтроки.Вставить("Номер", Выборка.Номер);
		ДанныеСтроки.Вставить("Представление", Строка(Выборка.Регистратор));
		Результат.Добавить(ДанныеСтроки);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПерепровестиДокументНаСервере(СсылкаНаДокумент)

	Попытка
		Док = СсылкаНаДокумент.ПолучитьОбъект();
		Если Док = Неопределено Тогда
			Возврат "Документ не существует (битая ссылка)";
		КонецЕсли;
		НачатьТранзакцию();
		Если Док.Проведен Тогда
			Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Док = СсылкаНаДокумент.ПолучитьОбъект();
		КонецЕсли;
		Док.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
		Возврат "";
	Исключение
		ОтменитьТранзакцию();
		Возврат ОписаниеОшибки();
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ПерепровестиДокументы(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		ПоказатьПредупреждение(, "Заполните период (Начало и Окончание).");
		Возврат;
	КонецЕсли;

	Если НачалоДня(Объект.НачалоПериода) > КонецДня(Объект.ОкончаниеПериода) Тогда
		ПоказатьПредупреждение(, "Начало периода больше окончания.");
		Возврат;
	КонецЕсли;

	МассивДокументов = ПолучитьСписокДокументовНаСервере();
	ВсегоДокументов = МассивДокументов.Количество();

	Если ВсегоДокументов = 0 Тогда
		ПоказатьПредупреждение(, "Не найдено документов с движениями в регистре ""ДенежныеСредстваВПути"" за указанный период.");
		Возврат;
	КонецЕсли;

	КоличествоУспешных = 0;
	КоличествоОшибок = 0;
	ЛогОшибок = Новый СписокЗначений;

	Для НомерТекущего = 0 По ВсегоДокументов - 1 Цикл

		ДанныеДокумента = МассивДокументов[НомерТекущего];
		Процент = Окр((НомерТекущего + 1) / ВсегоДокументов * 100, 0);

		Состояние(
			"П: " + (НомерТекущего + 1) + " из " + ВсегоДокументов
				+ " (" + Процент + "%)"
				+ " | Ок: " + КоличествоУспешных + ", Ошибок: " + КоличествоОшибок,
			Процент,
			Формат(ДанныеДокумента.Дата, "ДЛФ=D") + " — " + ДанныеДокумента.Представление);

		ОбработкаПрерыванияПользователя();

		ОписаниеОш = ПерепровестиДокументНаСервере(ДанныеДокумента.Регистратор);

		Если ОписаниеОш = "" Тогда
			КоличествоУспешных = КоличествоУспешных + 1;
		Иначе
			КоличествоОшибок = КоличествоОшибок + 1;
			Сообщить("Ошибка: " + ДанныеДокумента.Представление + " — " + ОписаниеОш);
			ЛогОшибок.Добавить(ДанныеДокумента.Регистратор, ДанныеДокумента.Представление + " — " + ОписаниеОш);
		КонецЕсли;

	КонецЦикла;

	ТекстИтога = "Перепроведение по регистру ""ДенежныеСредстваВПути"" завершено."
		+ Символы.ПС + "Успешно: " + КоличествоУспешных
		+ ", ошибок: " + КоличествоОшибок
		+ ", всего: " + ВсегоДокументов + ".";

	ПоказатьПредупреждение(, ТекстИтога);

КонецПроцедуры
