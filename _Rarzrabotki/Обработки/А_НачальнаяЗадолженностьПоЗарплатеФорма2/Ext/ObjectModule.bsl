#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// ФАЗА 1. zup_2: Общий = сальдо ВзаиморасчетыСРаботниками(КонецДня) + начисление-нетто месяца
// (Начислено − Удержано из НачислениеЗарплатыРаботникам) → Форма2 = Общий − Форма1(док-источник) → превью.
Процедура ЗагрузитьИзZup2() Экспорт
	Если НЕ ЗначениеЗаполнено(ДатаОстатков) Тогда
		ВызватьИсключение "Не заполнена «Дата остатков»!";
	КонецЕсли;
	ТЗОбщий = ПрочитатьОбщийИзZup2();
	ЗаполнитьПревью(ТЗОбщий);
КонецПроцедуры

// ФАЗА 2. Очистка-перезапись выбранного документа Форма2 (ФормаPL=Форма2), проведение.
Процедура СоздатьДокументы() Экспорт
	Если НЕ ЗначениеЗаполнено(ДокНачальнаяЗадолженностьПоЗарплатеФорма2) Тогда
		ВызватьИсключение "Не выбран документ «ДокНачальнаяЗадолженностьПоЗарплатеФорма2»!";
	КонецЕсли;
	Если Задолженность.Количество() = 0 Тогда
		ВызватьИсключение "ТЧ Задолженность пуста — сначала «Заполнить»!";
	КонецЕсли;

	ДокОбъект = ДокНачальнаяЗадолженностьПоЗарплатеФорма2.ПолучитьОбъект();
	Если ДокОбъект.Проведен Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ДокОбъект = ДокНачальнаяЗадолженностьПоЗарплатеФорма2.ПолучитьОбъект();
	КонецЕсли;
	ДокОбъект.ЗадолженностьПоЗарплате.Очистить();

	Добавлено = 0;
	Для Каждого СтрП Из Задолженность Цикл
		Если СтрП.Статус <> "OK" ИЛИ СтрП.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ДокОбъект.ЗадолженностьПоЗарплате.Добавить();
		НоваяСтрока.Сотрудник             = СтрП.Сотрудник;
		НоваяСтрока.Подразделение         = СтрП.ПодразделениеОрг;
		НоваяСтрока.Сумма                 = СтрП.Сумма;
		НоваяСтрока.ФормаPL               = Перечисления.А_ФормыPL.Форма2;
		НоваяСтрока.ГруппаУчетаНачислений = ПолучитьГруппуУчета(СтрП.ФизическоеЛицо);
		// ОрганизацияБухгалтерия НЕ заполняем (Форма2 — управленческая)
		Добавлено = Добавлено + 1;
	КонецЦикла;

	Если Добавлено = 0 Тогда
		Сообщить("Нет строк OK — документ не изменён.");
		Возврат;
	КонецЕсли;
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Сообщить("Документ " + Строка(ДокОбъект.Ссылка) + " перезаписан и проведён, строк: " + Добавлено);
	Исключение
		Сообщить("Ошибка проведения документа: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// zup_2: Общий per ФЛ = сальдо ВзаиморасчетыСРаботниками(КонецДня(ДатаОстатков))
//   + Σ(Начисления.Результат − Удержания.Результат) за месяц(ДатаОстатков) из НачислениеЗарплатыРаботникам.
// Смысл: управленческое сальдо минус свежее начисление месяца = начальная (перенесённая) задолженность.
// Подтверждено пользователем 2026-06-02 (эталон Буша: −35153 + (52000−16940) = −93,00).
Функция ПрочитатьОбщийИзZup2()
	СтрокаПодключения = А_ПодключенияБазСервер.СтрокаПодключения("zup_2");
	V8 = Новый COMОбъект("V83.COMConnector");
	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключения));
	Исключение
		ВызватьИсключение "Ошибка подключения к zup_2: " + ОписаниеОшибки();
	КонецПопытки;

	Сальдо = Новый Соответствие;
	Имена  = Новый Соответствие;
	NETМес = Новый Соответствие;

	Попытка
		// 1) Сальдо ВзаиморасчетыСРаботниками на конец ДатаОстатков (per ФЛ по КодПоДРФО)
		ЗапросС = V83.NewObject("Запрос");
		ЗапросС.УстановитьПараметр("Дата", КонецДня(ДатаОстатков));
		ЗапросС.Текст =
		"ВЫБРАТЬ
		|	О.Физлицо.КодПоДРФО КАК ДРФО,
		|	МАКСИМУМ(О.Физлицо.Наименование) КАК ИмяФЛ,
		|	СУММА(О.СуммаУпрОстаток) КАК Сальдо
		|ИЗ РегистрНакопления.ВзаиморасчетыСРаботниками.Остатки(&Дата, ) КАК О
		|СГРУППИРОВАТЬ ПО О.Физлицо.КодПоДРФО";
		ВыборкаС = ЗапросС.Выполнить().Выбрать();
		Пока ВыборкаС.Следующий() Цикл
			Д = СокрЛП("" + ВыборкаС.ДРФО);
			Если НЕ ПустаяСтрока(Д) Тогда
				Сальдо[Д] = Число(ВыборкаС.Сальдо);
				Имена[Д]  = ВыборкаС.ИмяФЛ;
			КонецЕсли;
		КонецЦикла;

		// 2) NET месяца = Начислено − Удержано(ВСЕ, включая «Утримано по бухгалтерії») из НачислениеЗарплатыРаботникам
		ЗапросN = V83.NewObject("Запрос");
		ЗапросN.УстановитьПараметр("НачМес", НачалоМесяца(ДатаОстатков));
		ЗапросN.УстановитьПараметр("КонМес", КонецМесяца(ДатаОстатков));
		ЗапросN.Текст =
		"ВЫБРАТЬ
		|	Т.ДРФО КАК ДРФО,
		|	МАКСИМУМ(Т.Имя) КАК ИмяФЛ,
		|	СУММА(Т.Сумма) КАК NET
		|ИЗ (
		|		ВЫБРАТЬ
		|			Н.Физлицо.КодПоДРФО КАК ДРФО,
		|			Н.Физлицо.Наименование КАК Имя,
		|			Н.Результат КАК Сумма
		|		ИЗ Документ.НачислениеЗарплатыРаботникам.Начисления КАК Н
		|		ГДЕ Н.Ссылка.Дата МЕЖДУ &НачМес И &КонМес И Н.Ссылка.Проведен
		|	ОБЪЕДИНИТЬ ВСЕ
		|		ВЫБРАТЬ
		|			У.Физлицо.КодПоДРФО,
		|			У.Физлицо.Наименование,
		|			-У.Результат
		|		ИЗ Документ.НачислениеЗарплатыРаботникам.Удержания КАК У
		|		ГДЕ У.Ссылка.Дата МЕЖДУ &НачМес И &КонМес И У.Ссылка.Проведен
		|	) КАК Т
		|СГРУППИРОВАТЬ ПО Т.ДРФО";
		ВыборкаN = ЗапросN.Выполнить().Выбрать();
		Пока ВыборкаN.Следующий() Цикл
			Д = СокрЛП("" + ВыборкаN.ДРФО);
			Если НЕ ПустаяСтрока(Д) Тогда
				NETМес[Д] = Число(ВыборкаN.NET);
				Если Имена[Д] = Неопределено Тогда
					Имена[Д] = ВыборкаN.ИмяФЛ;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		V83 = Неопределено;
		V8 = Неопределено;
		ВызватьИсключение "Ошибка запроса к zup_2: " + ОписаниеОшибки();
	КонецПопытки;

	V83 = Неопределено;
	V8 = Неопределено;

	// Объединить ключи → Общий = сальдо + NET месяца
	ВсеДРФО = Новый Соответствие;
	Для Каждого КЗ Из Сальдо Цикл
		ВсеДРФО[КЗ.Ключ] = Истина;
	КонецЦикла;
	Для Каждого КЗ Из NETМес Цикл
		ВсеДРФО[КЗ.Ключ] = Истина;
	КонецЦикла;

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ДРФО");
	ТЗ.Колонки.Добавить("ИмяФЛ");
	ТЗ.Колонки.Добавить("Общий");
	Для Каждого КЗ Из ВсеДРФО Цикл
		Д = КЗ.Ключ;
		ЗначС = ?(Сальдо[Д] = Неопределено, 0, Сальдо[Д]);
		ЗначN = ?(NETМес[Д] = Неопределено, 0, NETМес[Д]);
		Общ = Окр(ЗначС + ЗначN, 2);
		Если Общ = 0 Тогда
			Продолжить;
		КонецЕсли;
		Стр = ТЗ.Добавить();
		Стр.ДРФО  = Д;
		Стр.ИмяФЛ = Имена[Д];
		Стр.Общий = Общ;
	КонецЦикла;
	Возврат ТЗ;
КонецФункции

// Резолв ссылок per ФЛ, Форма1 из дока-источника, Форма2 = Общий − Форма1, подразделение по первой кассе.
Процедура ЗаполнитьПревью(ТЗОбщий)
	Задолженность.Очистить();
	УпрОрг = А_Привилегированный.А_ПолучитьОрганизациюУпр();
	Д0 = НачалоДня(ДатаОстатков) + 86400;  // день после даты остатка (01.12 для 30.11)
	ФоллбекКорень = КореньПоИмени("Строительство");

	Для Каждого СтрО Из ТЗОбщий Цикл
		НоваяСтрока = Задолженность.Добавить();
		НоваяСтрока.ФизЛицоИмя = СтрО.ИмяФЛ;
		НоваяСтрока.СуммаОбщий = СтрО.Общий;
		НоваяСтрока.Организация = УпрОрг;

		ФЛ = НайтиФизЛицо(СтрО.ДРФО);
		НоваяСтрока.ФизическоеЛицо = ФЛ;
		Если НЕ ЗначениеЗаполнено(ФЛ) Тогда
			НоваяСтрока.Статус = "Нет ФЛ"; Продолжить;
		КонецЕсли;

		НоваяСтрока.Сотрудник = НайтиСотрудника(ФЛ, УпрОрг);
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Сотрудник) Тогда
			НоваяСтрока.Статус = "Нет сотрудника"; Продолжить;
		КонецЕсли;

		Форма1 = ПолучитьФорма1(ФЛ);
		НоваяСтрока.СуммаФорма1 = Форма1;
		Форма2 = Окр(СтрО.Общий - Форма1, 2);
		НоваяСтрока.Сумма = Форма2;
		Если Форма2 = 0 Тогда
			НоваяСтрока.Статус = "Форма2=0"; Продолжить;
		КонецЕсли;

		Корень = НайтиКореньПоКассе(ФЛ, Д0);
		Если НЕ ЗначениеЗаполнено(Корень) Тогда
			Корень = ФоллбекКорень;
		КонецЕсли;
		НоваяСтрока.ПодразделениеОрг = РеверсПодразделение(Корень, УпрОрг);
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.ПодразделениеОрг) Тогда
			НоваяСтрока.Статус = "Нет подразделения"; Продолжить;
		КонецЕсли;

		НоваяСтрока.Статус = "OK";
	КонецЦикла;
	ВывестиСтатистику();
КонецПроцедуры

Функция НайтиФизЛицо(ДРФО)
	Если ЗначениеЗаполнено(ДРФО) Тогда
		Канд = Справочники.ФизическиеЛица.НайтиПоРеквизиту("КодПоДРФО", ДРФО);
		Если ЗначениеЗаполнено(Канд) Тогда
			Возврат Канд;
		КонецЕсли;
	КонецЕсли;
	Возврат Справочники.ФизическиеЛица.ПустаяСсылка();
КонецФункции

Функция НайтиСотрудника(ФЛ, УпрОрг)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФЛ", ФЛ);
	Запрос.УстановитьПараметр("Орг", УпрОрг);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 С.Ссылка КАК Ссылка
	|ИЗ Справочник.Сотрудники КАК С
	|ГДЕ С.ФизическоеЛицо = &ФЛ И НЕ С.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО ВЫБОР КОГДА С.ГоловнаяОрганизация = &Орг ТОГДА 0 ИНАЧЕ 1 КОНЕЦ, С.Код";
	Рез = Запрос.Выполнить();
	Если Рез.Пустой() Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	Выборка = Рез.Выбрать(); Выборка.Следующий();
	Возврат Выборка.Ссылка;
КонецФункции

// Σ строк дока-источника Форма1 per ФЛ (ФормаPL=Форма1 ИЛИ пусто).
Функция ПолучитьФорма1(ФЛ)
	Если НЕ ЗначениеЗаполнено(ДокНачальнаяЗадолженностьПоЗарплатеБух) Тогда
		Возврат 0;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Док", ДокНачальнаяЗадолженностьПоЗарплатеБух);
	Запрос.УстановитьПараметр("ФЛ", ФЛ);
	Запрос.Текст =
	"ВЫБРАТЬ ЕСТЬNULL(СУММА(Т.Сумма), 0) КАК Сумма
	|ИЗ Документ.НачальнаяЗадолженностьПоЗарплате.ЗадолженностьПоЗарплате КАК Т
	|ГДЕ Т.Ссылка = &Док И Т.Сотрудник.ФизическоеЛицо = &ФЛ
	|	И (Т.ФормаPL = ЗНАЧЕНИЕ(Перечисление.А_ФормыPL.Форма1)
	|		ИЛИ Т.ФормаPL = ЗНАЧЕНИЕ(Перечисление.А_ФормыPL.ПустаяСсылка))";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Число(Выборка.Сумма);
КонецФункции

// Первая касса-выплата с Д0 → СтрПредпр → корневой родитель.
Функция НайтиКореньПоКассе(ФЛ, Д0)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФЛ", ФЛ);
	Запрос.УстановитьПараметр("Д0", Д0);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Рш.Подразделение КАК Подр
	|ИЗ Документ.ВедомостьНаВыплатуЗарплатыВКассу.А_РасшифровкаВыплатыЗарплатаПоФизлицам КАК Рш
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВедомостьНаВыплатуЗарплатыВКассу КАК Вед
	|		ПО Вед.Ссылка = Рш.Ссылка
	|ГДЕ Рш.ФизическоеЛицо = &ФЛ И Вед.Дата >= &Д0 И Вед.Проведен
	|УПОРЯДОЧИТЬ ПО Вед.Дата";
	Рез = Запрос.Выполнить();
	Если Рез.Пустой() Тогда
		Возврат Справочники.СтруктураПредприятия.ПустаяСсылка();
	КонецЕсли;
	Выборка = Рез.Выбрать(); Выборка.Следующий();
	СтрП = ?(ЗначениеЗаполнено(Выборка.Подр), Выборка.Подр.А_Подразделение,
		Справочники.СтруктураПредприятия.ПустаяСсылка());
	Возврат КореньСтрП(СтрП);
КонецФункции

Функция КореньСтрП(СтрП)
	Тек = СтрП;
	Пока ЗначениеЗаполнено(Тек) И ЗначениеЗаполнено(Тек.Родитель) Цикл
		Тек = Тек.Родитель;
	КонецЦикла;
	Возврат Тек;
КонецФункции

Функция КореньПоИмени(Имя)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 СП.Ссылка КАК Ссылка
	|ИЗ Справочник.СтруктураПредприятия КАК СП
	|ГДЕ СП.Наименование = &Имя
	|	И СП.Родитель = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)";
	Рез = Запрос.Выполнить();
	Если Рез.Пустой() Тогда
		Возврат Справочники.СтруктураПредприятия.ПустаяСсылка();
	КонецЕсли;
	Выборка = Рез.Выбрать(); Выборка.Следующий();
	Возврат Выборка.Ссылка;
КонецФункции

// Реверс корневого СтрПредпр → ПодрОрг (Владелец=упр.орг, .А_Подразделение=корень).
Функция РеверсПодразделение(Корень, УпрОрг)
	Если НЕ ЗначениеЗаполнено(Корень) Тогда
		Возврат Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Влад", УпрОрг);
	Запрос.УстановитьПараметр("Корень", Корень);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 ПодрОрг.Ссылка КАК Ссылка
	|ИЗ Справочник.ПодразделенияОрганизаций КАК ПодрОрг
	|ГДЕ ПодрОрг.Владелец = &Влад
	|	И ПодрОрг.А_Подразделение = &Корень
	|	И НЕ ПодрОрг.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО ПодрОрг.Код";
	Рез = Запрос.Выполнить();
	Если Рез.Пустой() Тогда
		Возврат Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
	КонецЕсли;
	Выборка = Рез.Выбрать(); Выборка.Следующий();
	Возврат Выборка.Ссылка;
КонецФункции

// ГруппаУчетаНачислений из дока-источника Форма1 per ФЛ, иначе «Зарплата (661)».
Функция ПолучитьГруппуУчета(ФЛ)
	Если ЗначениеЗаполнено(ДокНачальнаяЗадолженностьПоЗарплатеБух) И ЗначениеЗаполнено(ФЛ) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Док", ДокНачальнаяЗадолженностьПоЗарплатеБух);
		Запрос.УстановитьПараметр("ФЛ", ФЛ);
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Т.ГруппаУчетаНачислений КАК ГУН
		|ИЗ Документ.НачальнаяЗадолженностьПоЗарплате.ЗадолженностьПоЗарплате КАК Т
		|ГДЕ Т.Ссылка = &Док И Т.Сотрудник.ФизическоеЛицо = &ФЛ
		|	И Т.ГруппаУчетаНачислений <> ЗНАЧЕНИЕ(Справочник.ГруппыУчетаНачисленийИУдержаний.ПустаяСсылка)";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.ГУН;
		КонецЕсли;
	КонецЕсли;
	Возврат Справочники.ГруппыУчетаНачисленийИУдержаний.НайтиПоНаименованию("Зарплата (661)");
КонецФункции

Процедура ВывестиСтатистику()
	Всего = Задолженность.Количество();
	ОК = 0; НетФЛ = 0; НетСотр = 0; НетПодр = 0; Ноль = 0;
	Для Каждого Стр Из Задолженность Цикл
		Если Стр.Статус = "OK" Тогда
			ОК = ОК + 1;
		ИначеЕсли Стр.Статус = "Нет ФЛ" Тогда
			НетФЛ = НетФЛ + 1;
		ИначеЕсли Стр.Статус = "Нет сотрудника" Тогда
			НетСотр = НетСотр + 1;
		ИначеЕсли Стр.Статус = "Нет подразделения" Тогда
			НетПодр = НетПодр + 1;
		ИначеЕсли Стр.Статус = "Форма2=0" Тогда
			Ноль = Ноль + 1;
		КонецЕсли;
	КонецЦикла;
	Сообщить("Загружено: " + Всего + " | OK: " + ОК + " | Нет ФЛ: " + НетФЛ
		+ " | Нет сотрудника: " + НетСотр + " | Нет подразделения: " + НетПодр + " | Форма2=0: " + Ноль);
КонецПроцедуры

#КонецОбласти

#КонецЕсли
