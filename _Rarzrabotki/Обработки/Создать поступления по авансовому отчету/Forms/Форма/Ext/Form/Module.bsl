
&НаКлиенте
Процедура СоздатьДокументПриобретенияПоАвансовомуОтчету(Команда)

	// Валідація: перевірка що вибрано документ
	Если НЕ ЗначениеЗаполнено(Объект.ДокАвансовыйОтчет) Тогда
		ПоказатьПредупреждение(, "Виберіть авансовий звіт!");
		Возврат;
	КонецЕсли;

	// Підтвердження
	ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьДокументыЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения,
		"Створити документи придбання товарів/послуг по авансовому звіту?",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыЗавершение(Результат, ДопПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние("Створення документів...");

	Попытка
		РезультатСоздания = СоздатьДокументыНаСервере();

		Если РезультатСоздания.Успешно Тогда
			ПоказатьПредупреждение(, "Успішно створено документів: " + РезультатСоздания.КоличествоСозданных);
		Иначе
			ПоказатьПредупреждение(, "Помилка: " + РезультатСоздания.ОписаниеОшибки);
		КонецЕсли;
	Исключение
		ПоказатьПредупреждение(, "Помилка: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция СоздатьДокументыНаСервере()

	Результат = Новый Структура("Успешно, КоличествоСозданных, ОписаниеОшибки", Ложь, 0, "");

	АвансовыйОтчетСсылка = Объект.ДокАвансовыйОтчет;

	// 1. Перевірка що документ проведений
	Если НЕ АвансовыйОтчетСсылка.Проведен Тогда
		Результат.ОписаниеОшибки = "Авансовий звіт не проведений!";
		Возврат Результат;
	КонецЕсли;

	// 2. Отримання даних з табличної частини А_Товары
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	АвансовыйОтчетА_Товары.Контрагент КАК Контрагент,
		|	АвансовыйОтчетА_Товары.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	АвансовыйОтчетА_Товары.Номенклатура КАК Номенклатура,
		|	АвансовыйОтчетА_Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	АвансовыйОтчетА_Товары.Коэффициент КАК Коэффициент,
		|	АвансовыйОтчетА_Товары.Количество КАК Количество,
		|	АвансовыйОтчетА_Товары.Цена КАК Цена,
		|	АвансовыйОтчетА_Товары.Сумма КАК Сумма,
		|	АвансовыйОтчетА_Товары.СтавкаНДС КАК СтавкаНДСПеречисление,
		|	АвансовыйОтчетА_Товары.СуммаНДС КАК СуммаНДС,
		|	АвансовыйОтчетА_Товары.НалоговоеНазначение КАК НалоговоеНазначение,
		|	АвансовыйОтчетА_Товары.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	АвансовыйОтчетА_Товары.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента
		|ИЗ
		|	Документ.АвансовыйОтчет.А_Товары КАК АвансовыйОтчетА_Товары
		|ГДЕ
		|	АвансовыйОтчетА_Товары.Ссылка = &АвансовыйОтчет
		|
		|УПОРЯДОЧИТЬ ПО
		|	АвансовыйОтчетА_Товары.Контрагент,
		|	АвансовыйОтчетА_Товары.ДоговорКонтрагента,
		|	АвансовыйОтчетА_Товары.НомерСтроки";

	Запрос.УстановитьПараметр("АвансовыйОтчет", АвансовыйОтчетСсылка);
	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		Результат.ОписаниеОшибки = "Табличная частина А_Товары порожня!";
		Возврат Результат;
	КонецЕсли;

	// 3. Групування по Контрагент + ДоговорКонтрагента
	ТаблицаТоваров = РезультатЗапроса.Выгрузить();

	// Отримати унікальні комбінації Контрагент + Договор
	ТаблицаГрупп = ТаблицаТоваров.Скопировать(, "Контрагент, ДоговорКонтрагента");
	ТаблицаГрупп.Свернуть("Контрагент, ДоговорКонтрагента");

	// Отримати дані шапки АвансовыйОтчет
	АвансовыйОтчетОбъект = АвансовыйОтчетСсылка.ПолучитьОбъект();

	КоличествоСозданных = 0;

	// 4. Цикл створення документів
	Для Каждого ГруппаТоваров Из ТаблицаГрупп Цикл

		Попытка
			// Фільтрація рядків для поточної групи
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Контрагент", ГруппаТоваров.Контрагент);
			СтруктураОтбора.Вставить("ДоговорКонтрагента", ГруппаТоваров.ДоговорКонтрагента);

			НайденныеСтроки = ТаблицаТоваров.НайтиСтроки(СтруктураОтбора);

			Если НайденныеСтроки.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;

			// Створення нового документа
			НовыйДокумент = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();

			// Заповнення шапки
			НовыйДокумент.Дата = ТекущаяДата();
			НовыйДокумент.Организация = АвансовыйОтчетОбъект.Организация;
			НовыйДокумент.Контрагент = ГруппаТоваров.Контрагент;
			НовыйДокумент.Договор = ГруппаТоваров.ДоговорКонтрагента;
			НовыйДокумент.Склад = АвансовыйОтчетОбъект.А_Склад;
			НовыйДокумент.НаправлениеДеятельности = АвансовыйОтчетОбъект.А_НаправлениеДеятельности;
			НовыйДокумент.А_НаправлениеДеятельности = АвансовыйОтчетОбъект.А_НаправлениеДеятельности;
			НовыйДокумент.А_Подразделение = АвансовыйОтчетОбъект.А_Подразделение;
			НовыйДокумент.АвансовыйОтчет = АвансовыйОтчетСсылка;
			НовыйДокумент.Валюта = АвансовыйОтчетОбъект.Валюта;
			НовыйДокумент.ЦенаВключаетНДС = АвансовыйОтчетОбъект.ЦенаВключаетНДС;
			НовыйДокумент.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;

			// Номер і дата вхідного документа з першого рядка групи
			ПервыйРядок = НайденныеСтроки[0];
			НовыйДокумент.НомерВходящегоДокумента = ПервыйРядок.НомерВходящегоДокумента;
			НовыйДокумент.ДатаВходящегоДокумента = ПервыйРядок.ДатаВходящегоДокумента;

			СуммаДокумента = 0;

			// Заповнення табличної частини Товары
			Для Каждого СтрокаТовара Из НайденныеСтроки Цикл

				НоваяСтрока = НовыйДокумент.Товары.Добавить();
				НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура;
				НоваяСтрока.Упаковка = СтрокаТовара.ЕдиницаИзмерения;
				НоваяСтрока.КоличествоУпаковок = СтрокаТовара.Количество;

				// Количество = Количество * Коэффициент
				Коэффициент = ?(СтрокаТовара.Коэффициент = 0, 1, СтрокаТовара.Коэффициент);
				НоваяСтрока.Количество = СтрокаТовара.Количество * Коэффициент;

				НоваяСтрока.Цена = СтрокаТовара.Цена;
				НоваяСтрока.Сумма = СтрокаТовара.Сумма;

				// Перетворення СтавкаНДС: Перечисление -> Справочник
				НоваяСтрока.СтавкаНДС = ПолучитьСтавкуНДССправочник(СтрокаТовара.СтавкаНДСПеречисление);

				НоваяСтрока.СуммаНДС = СтрокаТовара.СуммаНДС;
				НоваяСтрока.СуммаСНДС = СтрокаТовара.Сумма + СтрокаТовара.СуммаНДС;
				НоваяСтрока.НалоговоеНазначение = СтрокаТовара.НалоговоеНазначение;

				СуммаДокумента = СуммаДокумента + СтрокаТовара.Сумма + СтрокаТовара.СуммаНДС;

			КонецЦикла;

			// Встановлення суми документа
			НовыйДокумент.СуммаДокумента = СуммаДокумента;

			// Запис документа БЕЗ проведення
			НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);

			КоличествоСозданных = КоличествоСозданных + 1;

			// Виведення повідомлення про створений документ
			Сообщить("Створено документ: " + НовыйДокумент.Ссылка + " для контрагента: " + ГруппаТоваров.Контрагент);

		Исключение
			Сообщить("Помилка при створенні документа для " + ГруппаТоваров.Контрагент + ": " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

	КонецЦикла;

	Результат.Успешно = Истина;
	Результат.КоличествоСозданных = КоличествоСозданных;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПолучитьСтавкуНДССправочник(СтавкаНДСПеречисление)

	// Перетворення з Перечисления.СтавкиНДС в Справочник.СтавкиНДС
	// Використовуємо пошук за найменуванням

	Если НЕ ЗначениеЗаполнено(СтавкаНДСПеречисление) Тогда
		Возврат Справочники.СтавкиНДС.ПустаяСсылка();
	КонецЕсли;

	НаименованиеСтавки = Строка(СтавкаНДСПеречисление);

	// Спочатку шукаємо за точною відповідністю найменування
	СтавкаНДССправочник = Справочники.СтавкиНДС.НайтиПоНаименованию(НаименованиеСтавки, Истина);

	Если ЗначениеЗаполнено(СтавкаНДССправочник) Тогда
		Возврат СтавкаНДССправочник;
	КонецЕсли;

	// Якщо не знайдено - шукаємо через запит по реквізиту СтавкаНДС в довіднику
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СтавкиНДС.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СтавкиНДС КАК СтавкиНДС
		|ГДЕ
		|	СтавкиНДС.СтавкаНДС = &СтавкаНДС
		|	И НЕ СтавкиНДС.ПометкаУдаления";

	Запрос.УстановитьПараметр("СтавкаНДС", СтавкаНДСПеречисление);

	РезультатЗапроса = Запрос.Выполнить();

	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;

	// Повертаємо порожнє посилання, якщо не знайдено
	Возврат Справочники.СтавкиНДС.ПустаяСсылка();

КонецФункции
