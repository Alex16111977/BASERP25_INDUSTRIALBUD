// ===========================================================================
// Обробка: СинхронизироватьТовары
// Призначення: Комплексний інструмент контролю синхронізації ERP ↔ BuhBud
// Розділи: Товари / Грошові кошти / Взаєморозрахунки
// ===========================================================================
// Фаза 1: Порівняння залишків (залишки+обороти ERP vs BuhBud)
// Фаза 2: Аналіз документів (через СоответствияОбъектовИнформационныхБаз)
// Фаза 3: Синхронізація (розпровести в ЕРП / поставити на обмін в BuhBud)
// ===========================================================================

#Область ОбщиеФункции

// Підключення до BuhBud через COM
//
// Повертає:
//  COMОбъект - підключення до бази BuhBud, або Неопределено при помилці
//
Функция ПодключитьсяКBuhBud() Экспорт

	СтрокаПодключенияBuhBud = "Srvr=""SQLSERVER"";Ref=""BuhBud"";Usr=""cfo"";Pwd=""2442""";
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияBuhBud));
	Исключение
		Сообщить("Помилка підключення до BuhBud: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Возврат V83;

КонецФункции

#КонецОбласти

// ===========================================================================
// ФАЗА 1: Порівняння залишків
// ===========================================================================

#Область Фаза1_ПорівнянняЗалишків

// Головна функція Фази 1 — порівняння залишків по всіх увімкнених розділах
//
Функция СравнитьОстатки() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ТаблицаРасхождений.Очистить();
	ТаблицаДокументов.Очистить();

	// Підключення до BuhBud
	V83 = ПодключитьсяКBuhBud();
	Если V83 = Неопределено Тогда
		Возврат "Помилка підключення до BuhBud";
	КонецЕсли;

	Попытка

		Если РазделТовары Тогда
			СравнитьОстатки_Товары(V83);
		КонецЕсли;

		Если РазделДеньги Тогда
			СравнитьОстатки_Деньги(V83);
		КонецЕсли;

		Если РазделВзаиморасчеты Тогда
			СравнитьОстатки_Взаиморасчеты(V83);
		КонецЕсли;

	Исключение
		Сообщить("Помилка при порівнянні залишків: " + ОписаниеОшибки());
	КонецПопытки;

	// Звільнення COM-з'єднання
	V83 = Неопределено;

	Возврат "Оброблено. Розбіжностей: " + Строка(ТаблицаРасхождений.Количество());

КонецФункции

// ===========================
// РОЗДІЛ: ТОВАРИ
// ===========================

Процедура СравнитьОстатки_Товары(V83)

	КонецПериодаРасч = КонецДня(ОкончаниеПериода);

	// 1. Залишки ERP
	ТЗ_ЕРП = ПолучитьОстаткиЕРП_Товары(НачалоПериода, КонецПериодаРасч);

	// 2. Залишки BuhBud (через COM)
	ТЗ_Бух = ПолучитьОстаткиBuhBud_Товары(V83, НачалоПериода, КонецПериодаРасч);

	// 3. Злиття та пошук розбіжностей
	СвестиТаблицы_Товары(ТЗ_ЕРП, ТЗ_Бух);

КонецПроцедуры

// Залишки ERP з РегістрНакопления.ТоварыНаСкладах
//
Функция ПолучитьОстаткиЕРП_Товары(НачалоПериодаЗапр, КонецПериодаЗапр)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Номенклатура.А_ИдКод КАК НоменклатураИдКод,
	|	ПРЕДСТАВЛЕНИЕ(Т.Номенклатура) КАК НоменклатураПредставление,
	|	Т.Склад КАК Склад,
	|	Т.Склад.А_ИдКод КАК СкладИдКод,
	|	ПРЕДСТАВЛЕНИЕ(Т.Склад) КАК СкладПредставление,
	|	Т.ВНаличииНачальныйОстаток КАК НачОстаток,
	|	Т.ВНаличииПриход КАК Приход,
	|	Т.ВНаличииРасход КАК Расход,
	|	Т.ВНаличииКонечныйОстаток КАК КонОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			,
	|			(&ФильтрНоменклатура
	|				ИЛИ Номенклатура = &Номенклатура)
	|				И (&ФильтрСклад
	|					ИЛИ Склад = &Склад)) КАК Т
	|ГДЕ
	|	Т.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаЗапр);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаЗапр);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ФильтрНоменклатура", НЕ ЗначениеЗаполнено(Номенклатура));
	Запрос.УстановитьПараметр("ФильтрСклад", НЕ ЗначениеЗаполнено(Склад));

	Возврат Запрос.Выполнить().Выгрузить();
    
КонецФункции

// Залишки BuhBud через COM (РегістрБухгалтерії.Хозрасчетный)
// Рахунки: 281 (Товари), 20x (ВиробничіЗапаси), 26 (ГотоваПродукція), 22x (МШП)
// Динамічне визначення позиції субконто через ВидыСубконто
//
Функция ПолучитьОстаткиBuhBud_Товары(V83, НачалоПериодаЗапр, КонецПериодаЗапр)

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НоменклатураИдКод", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("СкладИдКод", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("СкладНаименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Результат.Колонки.Добавить("НоменклатураНаименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Результат.Колонки.Добавить("НачОстаток", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	Результат.Колонки.Добавить("Приход", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	Результат.Колонки.Добавить("Расход", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	Результат.Колонки.Добавить("КонОстаток", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));

	// Підготовка фільтрів по А_ИдКод
	НоменклатураИдКод = "";
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		НоменклатураИдКод = СокрЛП(Номенклатура.А_ИдКод);
	КонецЕсли;

	СкладИдКод = "";
	Если ЗначениеЗаполнено(Склад) Тогда
		СкладИдКод = СокрЛП(Склад.А_ИдКод);
	КонецЕсли;

		ЗапросОрганизаций = Новый Запрос;
	ЗапросОрганизаций.Текст =
	"ВЫБРАТЬ
	|	Организации.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.А_ВБалансе = ИСТИНА
	|	И Организации.КодПоЕДРПОУ <> """"";

	масКодПоЕДРПОУ = Новый Массив;
	ВыборкаОрганизаций = ЗапросОрганизаций.Выполнить().Выбрать();
	Пока ВыборкаОрганизаций.Следующий() Цикл
		масКодПоЕДРПОУ.Добавить(ВыборкаОрганизаций.КодПоЕДРПОУ);
	КонецЦикла;

	Если масКодПоЕДРПОУ.Количество() = 0 Тогда
		Сообщить("Немає організацій з флагом А_ВБалансе!");
		Возврат Неопределено;
	КонецЕсли;

	Запрос = V83.NewObject("Запрос");
	
		масКодПоЕДРПОУ_V83 = V83.NewObject("Массив");
	Для Каждого КодЕДРПОУ Из масКодПоЕДРПОУ Цикл
		масКодПоЕДРПОУ_V83.Добавить(КодЕДРПОУ);
	КонецЦикла;

	// Запит з динамічним визначенням позиції субконто
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.НоменклатураИдКод КАК НоменклатураИдКод,
	|	ВложенныйЗапрос.СкладИдКод КАК СкладИдКод,
	|	ВложенныйЗапрос.СкладНаименование КАК СкладНаименование,
	|	ВложенныйЗапрос.НоменклатураНаименование КАК НоменклатураНаименование,
	|	СУММА(ВложенныйЗапрос.НачОстаток) КАК НачОстаток,
	|	СУММА(ВложенныйЗапрос.Приход) КАК Приход,
	|	СУММА(ВложенныйЗапрос.Расход) КАК Расход,
	|	СУММА(ВложенныйЗапрос.КонОстаток) КАК КонОстаток
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВЫБОР
	|			КОГДА ПозицияНоменклатуры.НомерСтроки = 1
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура).А_ИдКод
	|			КОГДА ПозицияНоменклатуры.НомерСтроки = 2
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Номенклатура).А_ИдКод
	|			КОГДА ПозицияНоменклатуры.НомерСтроки = 3
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Номенклатура).А_ИдКод
	|			ИНАЧЕ """"
	|		КОНЕЦ КАК НоменклатураИдКод,
	|		ВЫБОР
	|			КОГДА ПозицияНоменклатуры.НомерСтроки = 1
	|				ТОГДА ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура))
	|			КОГДА ПозицияНоменклатуры.НомерСтроки = 2
	|				ТОГДА ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Номенклатура))
	|			КОГДА ПозицияНоменклатуры.НомерСтроки = 3
	|				ТОГДА ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Номенклатура))
	|			ИНАЧЕ """"
	|		КОНЕЦ КАК НоменклатураНаименование,
	|		ВЫБОР
	|			КОГДА ПозицияСклада.НомерСтроки = 1
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Склады).А_ИдКод
	|			КОГДА ПозицияСклада.НомерСтроки = 2
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Склады).А_ИдКод
	|			КОГДА ПозицияСклада.НомерСтроки = 3
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Склады).А_ИдКод
	|			ИНАЧЕ """"
	|		КОНЕЦ КАК СкладИдКод,
	|		ВЫБОР
	|			КОГДА ПозицияСклада.НомерСтроки = 1
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Склады).Наименование
	|			КОГДА ПозицияСклада.НомерСтроки = 2
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Склады).Наименование
	|			КОГДА ПозицияСклада.НомерСтроки = 3
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Склады).Наименование
	|			ИНАЧЕ """"
	|		КОНЕЦ КАК СкладНаименование,
	|		Остатки.КоличествоНачальныйОстаток КАК НачОстаток,
	|		Остатки.КоличествоОборотДт КАК Приход,
	|		Остатки.КоличествоОборотКт КАК Расход,
	|		Остатки.КоличествоКонечныйОстаток КАК КонОстаток
	|	ИЗ
	|		РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				,
	|				,
	|				Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Товары))
	|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПроизводственныеЗапасы))
	|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПриобретениеИзготовлениеОсновныхСредств))
	|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПриобретениеДругихНеоборотныхМатериальныхАктивов))
    |					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ГотоваяПродукция))
	|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.МалоценныеИБыстроизнашивающиесяПредметы)),
	|				,
	|				) КАК Остатки
	|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозицияНоменклатуры
	|			ПО Остатки.Счет = ПозицияНоменклатуры.Ссылка
	|				И (ПозицияНоменклатуры.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура))
	|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозицияСклада
	|			ПО Остатки.Счет = ПозицияСклада.Ссылка
	|				И (ПозицияСклада.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады))
	|	ГДЕ
	|		Остатки.Организация.КодПоЕДРПОУ В (&масКодПоЕДРПОУ)
	|		И (Остатки.КоличествоНачальныйОстаток <> 0
	|				ИЛИ Остатки.КоличествоОборотДт <> 0
	|				ИЛИ Остатки.КоличествоОборотКт <> 0)) КАК ВложенныйЗапрос
	|ГДЕ
	|	(&ФильтрНоменклатура
	|			ИЛИ ВложенныйЗапрос.НоменклатураИдКод = &НоменклатураИдКод)
	|	И (&ФильтрСклад
	|			ИЛИ ВложенныйЗапрос.СкладИдКод = &СкладИдКод)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.НоменклатураИдКод,
	|	ВложенныйЗапрос.СкладИдКод,
	|	ВложенныйЗапрос.СкладНаименование,
	|	ВложенныйЗапрос.НоменклатураНаименование";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаЗапр);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаЗапр);
	Запрос.УстановитьПараметр("НоменклатураИдКод", НоменклатураИдКод);
	Запрос.УстановитьПараметр("СкладИдКод", СкладИдКод);
	Запрос.УстановитьПараметр("ФильтрНоменклатура", НЕ ЗначениеЗаполнено(Номенклатура));
	Запрос.УстановитьПараметр("ФильтрСклад", НЕ ЗначениеЗаполнено(Склад));
    Запрос.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);

	Попытка
		ТЗ = Запрос.Выполнить().Выгрузить();
	Исключение
		Сообщить("Помилка запиту до BuhBud (Товари): " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	// Серіалізація та десеріалізація для передачі через COM
	стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗ);
	ТаблицаBuhBud = ЗначениеИзСтрокиВнутр(стр_ТЗ);

	Возврат ТаблицаBuhBud;

КонецФункции

// Злиття таблиць ERP та BuhBud — FULL OUTER JOIN по НоменклатураИдКод+СкладИдКод
// Результат записується у ТЧ ТаблицаРасхождений
//
Процедура СвестиТаблицы_Товары(ТЗ_ЕРП, ТЗ_Бух)

	// Індексована структура: Ключ -> {дані}
	Ключи = Новый Соответствие;

	// Додати дані ERP
	Для Каждого Стр Из ТЗ_ЕРП Цикл

		КлючНом = СокрЛП(Стр.НоменклатураИдКод);
		КлючСкл = СокрЛП(Стр.СкладИдКод);
		Ключ = КлючНом + "|" + КлючСкл;

		Запись = Ключи.Получить(Ключ);
		Если Запись = Неопределено Тогда
			Запись = Новый Структура(
				"НоменклатураПредставление, СкладПредставление, КлючНом, КлючСкл,
				|НачЕРП, ПриходЕРП, РасходЕРП, ОстатокЕРП,
				|НачБух, ПриходБух, РасходБух, ОстатокБух",
				Стр.НоменклатураПредставление, Стр.СкладПредставление, КлючНом, КлючСкл,
				0, 0, 0, 0,
				0, 0, 0, 0);
			Ключи.Вставить(Ключ, Запись);
		КонецЕсли;

		Запись.НачЕРП     = Запись.НачЕРП     + Стр.НачОстаток;
		Запись.ПриходЕРП  = Запись.ПриходЕРП  + Стр.Приход;
		Запись.РасходЕРП  = Запись.РасходЕРП  + Стр.Расход;
		Запись.ОстатокЕРП = Запись.ОстатокЕРП + Стр.КонОстаток;
	КонецЦикла;

	// Додати дані BuhBud
	Для Каждого Стр Из ТЗ_Бух Цикл

		КлючНом = СокрЛП(Стр.НоменклатураИдКод);
		КлючСкл = СокрЛП(Стр.СкладИдКод);
		Ключ = КлючНом + "|" + КлючСкл;

		Запись = Ключи.Получить(Ключ);
		Если Запись = Неопределено Тогда
			// Є в BuhBud, немає в ERP
			НомПредст = СокрЛП(Стр.НоменклатураНаименование);
			Если НЕ ЗначениеЗаполнено(НомПредст) Тогда
				НомПредст = "ІдКод: " + КлючНом;
			КонецЕсли;
			СклПредст = СокрЛП(Стр.СкладНаименование);
			Если НЕ ЗначениеЗаполнено(СклПредст) Тогда
				СклПредст = "ІдКод: " + КлючСкл;
			КонецЕсли;

			Запись = Новый Структура(
				"НоменклатураПредставление, СкладПредставление, КлючНом, КлючСкл,
				|НачЕРП, ПриходЕРП, РасходЕРП, ОстатокЕРП,
				|НачБух, ПриходБух, РасходБух, ОстатокБух",
				НомПредст, СклПредст, КлючНом, КлючСкл,
				0, 0, 0, 0,
				0, 0, 0, 0);
			Ключи.Вставить(Ключ, Запись);
		КонецЕсли;

		Запись.НачБух     = Запись.НачБух     + Стр.НачОстаток;
		Запись.ПриходБух  = Запись.ПриходБух  + Стр.Приход;
		Запись.РасходБух  = Запись.РасходБух  + Стр.Расход;
		Запись.ОстатокБух = Запись.ОстатокБух + Стр.КонОстаток;
	КонецЦикла;

	// Заповнення ТаблицаРасхождений — тільки рядки з розбіжностями
	Для Каждого КлючЗначение Из Ключи Цикл

		Запись = КлючЗначение.Значение;
		Разница = Запись.ОстатокЕРП - Запись.ОстатокБух;

		Если Окр(Разница, 3) = 0
			И Окр(Запись.НачЕРП - Запись.НачБух, 3) = 0
			И Окр(Запись.ПриходЕРП - Запись.ПриходБух, 3) = 0
			И Окр(Запись.РасходЕРП - Запись.РасходБух, 3) = 0 Тогда
			Продолжить; // Немає розбіжностей
		КонецЕсли;

		НС = ТаблицаРасхождений.Добавить();
		НС.Раздел              = "Товари";
		НС.Измерение1          = Запись.НоменклатураПредставление;
		НС.Измерение2          = Запись.СкладПредставление;
		НС.НачОстатокЕРП       = Запись.НачЕРП;
		НС.НачОстатокБух       = Запись.НачБух;
		НС.ПриходЕРП           = Запись.ПриходЕРП;
		НС.ПриходБух           = Запись.ПриходБух;
		НС.РасходЕРП           = Запись.РасходЕРП;
		НС.РасходБух           = Запись.РасходБух;
		НС.ОстатокЕРП          = Запись.ОстатокЕРП;
		НС.ОстатокБух          = Запись.ОстатокБух;
		НС.Разница             = Разница;
		НС.Синхронизировать    = Истина;
		НС.Измерение1Ссылка    = Запись.КлючНом;
		НС.Измерение2Ссылка    = Запись.КлючСкл;

	КонецЦикла;

КонецПроцедуры

// ===========================
// РОЗДІЛ: ГРОШОВІ КОШТИ
// ===========================

Процедура СравнитьОстатки_Деньги(V83)

	КонецПериодаРасч = КонецДня(ОкончаниеПериода);

	// 1. Залишки ERP (РегістрНакопления.ДенежныеСредстваБезналичные)
	ТЗ_ЕРП = ПолучитьОстаткиЕРП_Деньги(НачалоПериода, КонецПериодаРасч);

	// 2. Залишки BuhBud (РегістрБухгалтерії.Хозрасчетный, рахунки 31x)
	ТЗ_Бух = ПолучитьОстаткиBuhBud_Деньги(V83, НачалоПериода, КонецПериодаРасч);

	// 3. Злиття та пошук розбіжностей
	СвестиТаблицы_Деньги(ТЗ_ЕРП, ТЗ_Бух);

КонецПроцедуры

Функция ПолучитьОстаткиЕРП_Деньги(НачалоПериодаЗапр, КонецПериодаЗапр)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.БанковскийСчет КАК БанковскийСчет,
	|	ПРЕДСТАВЛЕНИЕ(Т.БанковскийСчет) КАК БанковскийСчетПредставление,
	|	Т.СуммаНачальныйОстаток КАК НачОстаток,
	|	Т.СуммаПриход КАК Приход,
	|	Т.СуммаРасход КАК Расход,
	|	Т.СуммаКонечныйОстаток КАК КонОстаток
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваБезналичные.ОстаткиИОбороты(
	|		&НачалоПериода, &КонецПериода, , , ) КАК Т";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаЗапр);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаЗапр);

	ТЗ_Запрос = Запрос.Выполнить().Выгрузить();

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("БанковскийСчетUID", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	Результат.Колонки.Добавить("БанковскийСчетПредставление", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Результат.Колонки.Добавить("НачОстаток", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Результат.Колонки.Добавить("Приход", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Результат.Колонки.Добавить("Расход", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Результат.Колонки.Добавить("КонОстаток", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));

	Для Каждого Стр Из ТЗ_Запрос Цикл
		НС = Результат.Добавить();
		НС.БанковскийСчетUID           = Строка(Стр.БанковскийСчет.УникальныйИдентификатор());
		НС.БанковскийСчетПредставление = Стр.БанковскийСчетПредставление;
		НС.НачОстаток                  = Стр.НачОстаток;
		НС.Приход                      = Стр.Приход;
		НС.Расход                      = Стр.Расход;
		НС.КонОстаток                  = Стр.КонОстаток;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьОстаткиBuhBud_Деньги(V83, НачалоПериодаЗапр, КонецПериодаЗапр)

	ЗапросОрганизаций = Новый Запрос;
	ЗапросОрганизаций.Текст =
	"ВЫБРАТЬ
	|	Организации.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.А_ВБалансе = ИСТИНА
	|	И Организации.КодПоЕДРПОУ <> """"";

	масКодПоЕДРПОУ = Новый Массив;
	ВыборкаОрганизаций = ЗапросОрганизаций.Выполнить().Выбрать();
	Пока ВыборкаОрганизаций.Следующий() Цикл
		масКодПоЕДРПОУ.Добавить(ВыборкаОрганизаций.КодПоЕДРПОУ);
	КонецЦикла;

	Если масКодПоЕДРПОУ.Количество() = 0 Тогда
		Сообщить("Немає організацій з флагом А_ВБалансе!");
		Возврат Неопределено;
	КонецЕсли;

	Запрос = V83.NewObject("Запрос");

	масКодПоЕДРПОУ_V83 = V83.NewObject("Массив");
	Для Каждого КодЕДРПОУ Из масКодПоЕДРПОУ Цикл
		масКодПоЕДРПОУ_V83.Добавить(КодЕДРПОУ);
	КонецЦикла;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Субконто1 КАК БанковскийСчетКасса,
	|	ПРЕДСТАВЛЕНИЕ(Остатки.Субконто1) КАК БанковскийСчетПредставление,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Валютный
	|			ТОГДА Остатки.ВалютнаяСуммаНачальныйОстаток
	|		ИНАЧЕ Остатки.СуммаНачальныйОстаток
	|	КОНЕЦ КАК НачОстаток,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Валютный
	|			ТОГДА Остатки.ВалютнаяСуммаОборотДт
	|		ИНАЧЕ Остатки.СуммаОборотДт
	|	КОНЕЦ КАК Приход,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Валютный
	|			ТОГДА Остатки.ВалютнаяСуммаОборотКт
	|		ИНАЧЕ Остатки.СуммаОборотКт
	|	КОНЕЦ КАК Расход,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Валютный
	|			ТОГДА Остатки.ВалютнаяСуммаКонечныйОстаток
	|		ИНАЧЕ Остатки.СуммаКонечныйОстаток
	|	КОНЕЦ КАК КонОстаток,
	|	Остатки.Счет.Код КАК СчетКод,
	|	Остатки.Организация.КодПоЕДРПОУ КАК ОрганизацияКодПоЕДРПОУ
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|		&НачалоПериода, &КонецПериода, , ,
	|		Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках)), , ) КАК Остатки
	|ГДЕ
	|	Остатки.Организация.КодПоЕДРПОУ В (&масКодПоЕДРПОУ)
	|	И (Остатки.СуммаНачальныйОстаток <> 0
	|		ИЛИ Остатки.СуммаОборотДт <> 0
	|		ИЛИ Остатки.СуммаОборотКт <> 0)";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаЗапр);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаЗапр);
	Запрос.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);

	Попытка
		ТЗ = Запрос.Выполнить().Выгрузить();
	Исключение
		Сообщить("Помилка запиту до BuhBud (Гроші): " + ОписаниеОшибки());
		Возврат Новый ТаблицаЗначений;
	КонецПопытки;

	// Ітерація безпосередньо по BuhBud COM таблиці (без серіалізації!)
	// Причина: ЗначениеВСтрокуВнутр/ЗначениеИзСтрокиВнутр ламає посилання БанковскиеСчета
	// (тип Справочник.БанковскиеСчета в BuhBud не існує в ERP як БанковскиеСчетаОрганизаций)
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("БанковскийСчетUID", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	Результат.Колонки.Добавить("БанковскийСчетПредставление", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Результат.Колонки.Добавить("НачОстаток", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Результат.Колонки.Добавить("Приход", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Результат.Колонки.Добавить("Расход", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Результат.Колонки.Добавить("КонОстаток", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));

	Для Сч = 0 По ТЗ.Количество() - 1 Цикл
		СтрокаТЗ = ТЗ.Получить(Сч);

		НС = Результат.Добавить();
		НС.НачОстаток = СтрокаТЗ.НачОстаток;
		НС.Приход     = СтрокаТЗ.Приход;
		НС.Расход     = СтрокаТЗ.Расход;
		НС.КонОстаток = СтрокаТЗ.КонОстаток;
		НС.БанковскийСчетПредставление = СокрЛП(V83.String(СтрокаТЗ.БанковскийСчетПредставление));

		Попытка
			Если СокрЛП(V83.String(СтрокаТЗ.СчетКод)) = "315" Тогда
				// Спеціальна обробка рахунку 315 — пошук по ЄДРПОУ
				ЗапросСчет = Новый Запрос;
				ЗапросСчет.УстановитьПараметр("КодПоЕДРПОУ", СокрЛП(V83.String(СтрокаТЗ.ОрганизацияКодПоЕДРПОУ)));
				ЗапросСчет.УстановитьПараметр("А_СчетБухгалтерский", ПланыСчетов.Хозрасчетный.НайтиПоКоду("315"));
				ЗапросСчет.Текст =
				"ВЫБРАТЬ
				|	БСО.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.БанковскиеСчетаОрганизаций КАК БСО
				|ГДЕ
				|	БСО.А_ОрганизацияБухгалтерия.КодПоЕДРПОУ = &КодПоЕДРПОУ
				|	И БСО.А_СчетБухгалтерский = &А_СчетБухгалтерский
				|	И БСО.А_ПоУмолчаниюДляПустыхСчетовИзБухгалтерии";
				Выборка315 = ЗапросСчет.Выполнить().Выбрать();
				Если Выборка315.Следующий() Тогда
					НС.БанковскийСчетUID = Строка(Выборка315.Ссылка.УникальныйИдентификатор());
				КонецЕсли;
			Иначе
				// Стандартна конвертація по UUID (зчитуємо UUID в контексті BuhBud COM!)
				Если V83.ЗначениеЗаполнено(СтрокаТЗ.БанковскийСчетКасса) Тогда
					СсылкаЕРП = А_Привилегированный.ПолучитьСправочникUID(
						"БанковскиеСчетаОрганизаций",
						V83.String(СтрокаТЗ.БанковскийСчетКасса.УникальныйИдентификатор()));
					Если ЗначениеЗаполнено(СсылкаЕРП) Тогда
						НС.БанковскийСчетUID = Строка(СсылкаЕРП.УникальныйИдентификатор());
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Исключение
			// Якщо не вдалося — залишаємо порожнім
		КонецПопытки;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура СвестиТаблицы_Деньги(ТЗ_ЕРП, ТЗ_Бух)

	Ключи = Новый Соответствие;

	// ERP
	Для Каждого Стр Из ТЗ_ЕРП Цикл
		Ключ = СокрЛП(Стр.БанковскийСчетUID);
		Запись = Ключи.Получить(Ключ);
		Если Запись = Неопределено Тогда
			Запись = Новый Структура(
				"Представление, Ключ, НачЕРП, ПриходЕРП, РасходЕРП, ОстатокЕРП, НачБух, ПриходБух, РасходБух, ОстатокБух",
				Стр.БанковскийСчетПредставление, Ключ,
				0, 0, 0, 0, 0, 0, 0, 0);
			Ключи.Вставить(Ключ, Запись);
		КонецЕсли;
		Запись.НачЕРП     = Запись.НачЕРП     + Стр.НачОстаток;
		Запись.ПриходЕРП  = Запись.ПриходЕРП  + Стр.Приход;
		Запись.РасходЕРП  = Запись.РасходЕРП  + Стр.Расход;
		Запись.ОстатокЕРП = Запись.ОстатокЕРП + Стр.КонОстаток;
	КонецЦикла;

	// BuhBud
	Для Каждого Стр Из ТЗ_Бух Цикл
		Ключ = СокрЛП(Стр.БанковскийСчетUID);
		Запись = Ключи.Получить(Ключ);
		Если Запись = Неопределено Тогда
			Предст = Стр.БанковскийСчетПредставление;
			Если НЕ ЗначениеЗаполнено(Предст) Тогда
				Предст = "BuhBud: " + Ключ;
			КонецЕсли;
			Запись = Новый Структура(
				"Представление, Ключ, НачЕРП, ПриходЕРП, РасходЕРП, ОстатокЕРП, НачБух, ПриходБух, РасходБух, ОстатокБух",
				Предст, Ключ,
				0, 0, 0, 0, 0, 0, 0, 0);
			Ключи.Вставить(Ключ, Запись);
		КонецЕсли;
		Запись.НачБух     = Запись.НачБух     + Стр.НачОстаток;
		Запись.ПриходБух  = Запись.ПриходБух  + Стр.Приход;
		Запись.РасходБух  = Запись.РасходБух  + Стр.Расход;
		Запись.ОстатокБух = Запись.ОстатокБух + Стр.КонОстаток;
	КонецЦикла;

	// Заповнення ТЧ
	Для Каждого КлючЗначение Из Ключи Цикл
		Запись = КлючЗначение.Значение;
		Разница = Запись.ОстатокЕРП - Запись.ОстатокБух;
		Если Окр(Разница, 2) = 0
			И Окр(Запись.НачЕРП - Запись.НачБух, 2) = 0
			И Окр(Запись.ПриходЕРП - Запись.ПриходБух, 2) = 0
			И Окр(Запись.РасходЕРП - Запись.РасходБух, 2) = 0 Тогда
			Продолжить;
		КонецЕсли;

		НС = ТаблицаРасхождений.Добавить();
		НС.Раздел              = "Гроші";
		НС.Измерение1          = Запись.Представление;
		НС.Измерение2          = "";
		НС.НачОстатокЕРП       = Запись.НачЕРП;
		НС.НачОстатокБух       = Запись.НачБух;
		НС.ПриходЕРП           = Запись.ПриходЕРП;
		НС.ПриходБух           = Запись.ПриходБух;
		НС.РасходЕРП           = Запись.РасходЕРП;
		НС.РасходБух           = Запись.РасходБух;
		НС.ОстатокЕРП          = Запись.ОстатокЕРП;
		НС.ОстатокБух          = Запись.ОстатокБух;
		НС.Разница             = Разница;
		НС.Синхронизировать    = Истина;
		НС.Измерение1Ссылка    = Запись.Ключ;
		НС.Измерение2Ссылка    = "";
	КонецЦикла;

