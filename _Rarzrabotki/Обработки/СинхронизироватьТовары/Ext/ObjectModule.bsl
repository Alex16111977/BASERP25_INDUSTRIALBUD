Функция ПолучитьОстаткиBuhBud_Взаиморасчеты(V83, НачалоПериодаЗапр, КонецПериодаЗапр)

	ВалютаГривня = V83.Константы.ВалютаРегламентированногоУчета.Получить();

	// Масив рахунків
	спСчет = V83.NewObject("Массив");
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСОтечественнымиПокупателями);           // 361
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСИностраннымиПокупателями);             // 362
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСОтечественнымиПоставщиками);           // 631
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСИностраннымиПоставщиками);             // 632
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСДругимиКредиторамиВНациональнойВалюте);// 6851
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСДругимиКредиторамиВИностраннойВалюте); // 6852
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСДругимиДебиторамиВНациональнойВалюте); // 3771
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСДругимиДебиторамиВИностраннойВалюте);  // 3772
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.КраткосрочныеКредитыБанковВНациональнойВалюте);// 601
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.КраткосрочныеКредитыБанковВИностраннойВалюте); // 602
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыПоНачисленнымПроцентам);                // 684
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыПоСтрахованиюИмущества);                // 655

	ЗапросОрганизаций = Новый Запрос;
	ЗапросОрганизаций.Текст =
	"ВЫБРАТЬ
	|	Организации.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.А_ВБалансе = ИСТИНА
	|	И Организации.КодПоЕДРПОУ <> """"";

	масКодПоЕДРПОУ = Новый Массив;
	ВыборкаОрганизаций = ЗапросОрганизаций.Выполнить().Выбрать();
	Пока ВыборкаОрганизаций.Следующий() Цикл
		масКодПоЕДРПОУ.Добавить(ВыборкаОрганизаций.КодПоЕДРПОУ);
	КонецЦикла;

	Если масКодПоЕДРПОУ.Количество() = 0 Тогда
		Сообщить("Немає організацій з флагом А_ВБалансе!");
		Возврат Неопределено;
	КонецЕсли;

	Запрос = V83.NewObject("Запрос");

	масКодПоЕДРПОУ_V83 = V83.NewObject("Массив");
	Для Каждого КодЕДРПОУ Из масКодПоЕДРПОУ Цикл
		масКодПоЕДРПОУ_V83.Добавить(КодЕДРПОУ);
	КонецЦикла;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЗ.КонтрагентИдКод КАК КонтрагентИдКод,
	|	ВЗ.ДоговорИдКод КАК ДоговорИдКод,
	|	СУММА(ВЗ.НачОстаток) КАК НачОстаток,
	|	СУММА(ВЗ.Приход) КАК Приход,
	|	СУММА(ВЗ.Расход) КАК Расход,
	|	СУММА(ВЗ.КонОстаток) КАК КонОстаток
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВЫБОР
	|			КОГДА ПозицияКонтрагента.НомерСтроки = 1
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Контрагенты).А_ИдКод
	|			КОГДА ПозицияКонтрагента.НомерСтроки = 2
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Контрагенты).А_ИдКод
	|			КОГДА ПозицияКонтрагента.НомерСтроки = 3
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Контрагенты).А_ИдКод
	|			ИНАЧЕ """"
	|		КОНЕЦ КАК КонтрагентИдКод,
	|		ВЫБОР
	|			КОГДА ПозицияДоговора.НомерСтроки = 1
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
	|			КОГДА ПозицияДоговора.НомерСтроки = 2
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
	|			КОГДА ПозицияДоговора.НомерСтроки = 3
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
	|			ИНАЧЕ """"
	|		КОНЕЦ КАК ДоговорИдКод,
	|		ВЫБОР
	|			КОГДА ПозицияДоговора.НомерСтроки = 2
	|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов = &ВалютаГривня
	|				ТОГДА Остатки.СуммаНачальныйОстаток
	|			КОГДА ПозицияДоговора.НомерСтроки = 2
	|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов <> &ВалютаГривня
	|				ТОГДА Остатки.ВалютнаяСуммаНачальныйОстаток
	|			ИНАЧЕ Остатки.СуммаНачальныйОстаток
	|		КОНЕЦ КАК НачОстаток,
	|		ВЫБОР
	|			КОГДА ПозицияДоговора.НомерСтроки = 2
	|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов = &ВалютаГривня
	|				ТОГДА Остатки.СуммаОборотДт
	|			КОГДА ПозицияДоговора.НомерСтроки = 2
	|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов <> &ВалютаГривня
	|				ТОГДА Остатки.ВалютнаяСуммаОборотДт
	|			ИНАЧЕ Остатки.СуммаОборотДт
	|		КОНЕЦ КАК Приход,
	|		ВЫБОР
	|			КОГДА ПозицияДоговора.НомерСтроки = 2
	|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов = &ВалютаГривня
	|				ТОГДА Остатки.СуммаОборотКт
	|			КОГДА ПозицияДоговора.НомерСтроки = 2
	|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов <> &ВалютаГривня
	|				ТОГДА Остатки.ВалютнаяСуммаОборотКт
	|			ИНАЧЕ Остатки.СуммаОборотКт
	|		КОНЕЦ КАК Расход,
	|		ВЫБОР
	|			КОГДА ПозицияДоговора.НомерСтроки = 2
	|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов = &ВалютаГривня
	|				ТОГДА Остатки.СуммаКонечныйОстаток
	|			КОГДА ПозицияДоговора.НомерСтроки = 2
	|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов <> &ВалютаГривня
	|				ТОГДА Остатки.ВалютнаяСуммаКонечныйОстаток
	|			ИНАЧЕ Остатки.СуммаКонечныйОстаток
	|		КОНЕЦ КАК КонОстаток
	|	ИЗ
	|		РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Авто,
	|			ДвиженияИГраницыПериода,
	|			Счет В ИЕРАРХИИ (&Счет),
	|			,
	|			) КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозицияКонтрагента
	|		ПО Остатки.Счет = ПозицияКонтрагента.Ссылка
	|			И (ПозицияКонтрагента.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты))
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозицияДоговора
	|		ПО Остатки.Счет = ПозицияДоговора.Ссылка
	|			И (ПозицияДоговора.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры))
	|	ГДЕ
	|		Остатки.Организация.КодПоЕДРПОУ В (&масКодПоЕДРПОУ)) КАК ВЗ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЗ.КонтрагентИдКод,
	|	ВЗ.ДоговорИдКод";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаЗапр);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаЗапр);
	Запрос.УстановитьПараметр("Счет", спСчет);
	Запрос.УстановитьПараметр("ВалютаГривня", ВалютаГривня);
	Запрос.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);

	Попытка
		ТЗ = Запрос.Выполнить().Выгрузить();
	Исключение
		Сообщить("Помилка запиту до BuhBud (Взаєморозрахунки): " + ОписаниеОшибки());
		Возврат Новый ТаблицаЗначений;
	КонецПопытки;

	// Серіалізація через COM
	стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗ);
	ТаблицаBuhBud = ЗначениеИзСтрокиВнутр(стр_ТЗ);

	// Конвертація ІдКод -> Ссилка через тимчасову таблицю
	Возврат КонвертироватьТЗ_Взаиморасчеты(ТаблицаBuhBud);

КонецФункции

Функция КонвертироватьТЗ_Взаиморасчеты(ТаблицаBuhBud)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ.КонтрагентИдКод,
	|	ВТ.ДоговорИдКод,
	|	ВТ.НачОстаток,
	|	ВТ.Приход,
	|	ВТ.Расход,
	|	ВТ.КонОстаток
	|ПОМЕСТИТЬ ВнутренняяТаблица
	|ИЗ
	|	&ТЗ КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Контрагент,
	|	ПРЕДСТАВЛЕНИЕ(Контрагенты.Ссылка) КАК КонтрагентПредставление,
	|	ВТ.КонтрагентИдКод,
	|	Договоры.Ссылка КАК Договор,
	|	ПРЕДСТАВЛЕНИЕ(Договоры.Ссылка) КАК ДоговорПредставление,
	|	ВТ.ДоговорИдКод,
	|	ВТ.НачОстаток,
	|	ВТ.Приход,
	|	ВТ.Расход,
	|	ВТ.КонОстаток
	|ИЗ
	|	ВнутренняяТаблица КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ВТ.КонтрагентИдКод = Контрагенты.А_ИдКод
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК Договоры
	|		ПО ВТ.ДоговорИдКод = Договоры.А_ИдКод";

	Запрос.УстановитьПараметр("ТЗ", ТаблицаBuhBud);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура СвестиТаблицы_Взаиморасчеты(ТЗ_ЕРП, ТЗ_Бух)

	Ключи = Новый Соответствие;

	// ERP
	Для Каждого Стр Из ТЗ_ЕРП Цикл
		КлючКонтр = СокрЛП(Стр.КонтрагентИдКод);
		КлючДог   = СокрЛП(Стр.ДоговорИдКод);
		Ключ = КлючКонтр + "|" + КлючДог;

		Запись = Ключи.Получить(Ключ);
		Если Запись = Неопределено Тогда
			Запись = Новый Структура(
				"КонтрагентПредставление, ДоговорПредставление, КлючКонтр, КлючДог,
				|НачЕРП, ПриходЕРП, РасходЕРП, ОстатокЕРП,
				|НачБух, ПриходБух, РасходБух, ОстатокБух",
				Стр.КонтрагентПредставление, Стр.ДоговорПредставление, КлючКонтр, КлючДог,
				0, 0, 0, 0, 0, 0, 0, 0);
			Ключи.Вставить(Ключ, Запись);
		КонецЕсли;
		Запись.НачЕРП     = Запись.НачЕРП     + Стр.НачОстаток;
		Запись.ПриходЕРП  = Запись.ПриходЕРП  + Стр.Приход;
		Запись.РасходЕРП  = Запись.РасходЕРП  + Стр.Расход;
		Запись.ОстатокЕРП = Запись.ОстатокЕРП + Стр.КонОстаток;
	КонецЦикла;

	// BuhBud
	Для Каждого Стр Из ТЗ_Бух Цикл
		КлючКонтр = СокрЛП(Стр.КонтрагентИдКод);
		КлючДог   = СокрЛП(Стр.ДоговорИдКод);
		Ключ = КлючКонтр + "|" + КлючДог;

		Запись = Ключи.Получить(Ключ);
		Если Запись = Неопределено Тогда
			КПредст = СокрЛП(Стр.КонтрагентПредставление);
			Если НЕ ЗначениеЗаполнено(КПредст) Тогда
				КПредст = "ІдКод: " + КлючКонтр;
			КонецЕсли;
			ДПредст = СокрЛП(Стр.ДоговорПредставление);
			Если НЕ ЗначениеЗаполнено(ДПредст) Тогда
				ДПредст = "ІдКод: " + КлючДог;
			КонецЕсли;

			Запись = Новый Структура(
				"КонтрагентПредставление, ДоговорПредставление, КлючКонтр, КлючДог,
				|НачЕРП, ПриходЕРП, РасходЕРП, ОстатокЕРП,
				|НачБух, ПриходБух, РасходБух, ОстатокБух",
				КПредст, ДПредст, КлючКонтр, КлючДог,
				0, 0, 0, 0, 0, 0, 0, 0);
			Ключи.Вставить(Ключ, Запись);
		КонецЕсли;
		Запись.НачБух     = Запись.НачБух     + Стр.НачОстаток;
		Запись.ПриходБух  = Запись.ПриходБух  + Стр.Приход;
		Запись.РасходБух  = Запись.РасходБух  + Стр.Расход;
		Запись.ОстатокБух = Запись.ОстатокБух + Стр.КонОстаток;
	КонецЦикла;

	// Заповнення ТЧ
	Для Каждого КлючЗначение Из Ключи Цикл
		Запись = КлючЗначение.Значение;
		Разница = Запись.ОстатокЕРП - Запись.ОстатокБух;
		Если Окр(Разница, 2) = 0
			И Окр(Запись.НачЕРП - Запись.НачБух, 2) = 0
			И Окр(Запись.ПриходЕРП - Запись.ПриходБух, 2) = 0
			И Окр(Запись.РасходЕРП - Запись.РасходБух, 2) = 0 Тогда
			Продолжить;
		КонецЕсли;

		НС = ТаблицаРасхождений.Добавить();
		НС.Раздел              = "Взаєморозрах";
		НС.Измерение1          = Запись.КонтрагентПредставление;
		НС.Измерение2          = Запись.ДоговорПредставление;
		НС.НачОстатокЕРП       = Запись.НачЕРП;
		НС.НачОстатокБух       = Запись.НачБух;
		НС.ПриходЕРП           = Запись.ПриходЕРП;
		НС.ПриходБух           = Запись.ПриходБух;
		НС.РасходЕРП           = Запись.РасходЕРП;
		НС.РасходБух           = Запись.РасходБух;
		НС.ОстатокЕРП          = Запись.ОстатокЕРП;
		НС.ОстатокБух          = Запись.ОстатокБух;
		НС.Разница             = Разница;
		НС.Синхронизировать    = Истина;
		НС.Измерение1Ссылка    = Запись.КлючКонтр;
		НС.Измерение2Ссылка    = Запись.КлючДог;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

// ===========================================================================
// ФАЗА 2: Аналіз документів (через СоответствияОбъектовИнформационныхБаз)
// ===========================================================================

#Область Фаза2_АналізДокументів

// Головна функція Фази 2 — аналіз документів для вибраних розбіжностей
//
Функция АнализироватьДокументы() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ТаблицаДокументов.Очистить();

	V83 = ПодключитьсяКBuhBud();
	Если V83 = Неопределено Тогда
		Возврат "Помилка підключення до BuhBud";
	КонецЕсли;

	// Отримати вузол обміну в BuhBud
	УзелОбмена = Неопределено;
	Попытка
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20 ГДЕ НЕ ЭтотУзел";
		V83_Рез = V83_Запрос.Выполнить().Выбрать();
		Если V83_Рез.Следующий() Тогда
			УзелОбмена = V83_Рез.Ссылка;
		КонецЕсли;
	Исключение
		Сообщить("Не вдалося знайти вузол обміну в BuhBud: " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Для Каждого СтрРасх Из ТаблицаРасхождений Цикл
			Если НЕ СтрРасх.Синхронизировать Тогда
				Продолжить;
			КонецЕсли;

			Если СтрРасх.Раздел = "Товари" Тогда
				АнализДокументов_Товары(V83, СтрРасх, УзелОбмена);
			ИначеЕсли СтрРасх.Раздел = "Гроші" Тогда
				АнализДокументов_Деньги(V83, СтрРасх, УзелОбмена);
			ИначеЕсли СтрРасх.Раздел = "Взаєморозрах" Тогда
				АнализДокументов_Взаиморасчеты(V83, СтрРасх, УзелОбмена);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Сообщить("Помилка аналізу документів: " + ОписаниеОшибки());
	КонецПопытки;

	V83 = Неопределено;
	Возврат "Документів для синхронізації: " + Строка(ТаблицаДокументов.Количество());

КонецФункции

// ===========================
// ТОВАРИ — аналіз документів
// ===========================
Процедура АнализДокументов_Товары(V83, СтрРасх, УзелОбмена)

	КонецПериодаРасч = КонецДня(ОкончаниеПериода);

	// 1. Обороти по документах ERP + LEFT JOIN з СоответствияОбъектовИнформационныхБаз
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Об.Регистратор КАК Регистратор,
	|	ПРЕДСТАВЛЕНИЕ(Об.Регистратор) КАК РегистраторПредст,
	|	Об.ВНаличииПриход КАК Приход,
	|	Об.ВНаличииРасход КАК Расход,
	|	Соотв.УникальныйИдентификаторПриемника КАК UIDвBuhBud,
	|	Соотв.ТипПриемника КАК ТипПриемника,
	|	Соотв.ТипИсточника КАК ТипИсточника
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Обороты(
	|		&НачалоПериода, &КонецПериода, Авто,
	|		Номенклатура.А_ИдКод = &НоменклатураИдКод
	|			И Склад.А_ИдКод = &СкладИдКод) КАК Об
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
	|	ПО Об.Регистратор = Соотв.УникальныйИдентификаторИсточника
	|		И (Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20)";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаРасч);
	Запрос.УстановитьПараметр("НоменклатураИдКод", СтрРасх.Измерение1Ссылка);
	Запрос.УстановитьПараметр("СкладИдКод", СтрРасх.Измерение2Ссылка);

	ТЗ_Док = Запрос.Выполнить().Выгрузить();

	// 2. Обробка кожного документа ERP
	ОбробитиДокументиЕРП(V83, ТЗ_Док, СтрРасх, УзелОбмена);

	// 3. Зворотній аналіз: документи BuhBud, яких немає в ЕРП
	АнализДокументовBuhBud_Товары(V83, СтрРасх);

КонецПроцедуры

// ===========================
// ТОВАРИ — зворотній аналіз документів BuhBud
// ===========================
// Знаходить документи в BuhBud, які не мають відповідників в ЕРП
// (рухають товарні рахунки з тією ж Номенклатурою та Складом)
//
Процедура АнализДокументовBuhBud_Товары(V83, СтрРасх)

	КонецПериодаРасч = КонецДня(ОкончаниеПериода);

	// 1. Зібрати UUID документів BuhBud, які вже знайдені через ЕРП аналіз
	ВжеЗнайдені = Новый Соответствие;
	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если ЗначениеЗаполнено(СтрДок.UIDДокументаБух) Тогда
			ВжеЗнайдені.Вставить(ВРег(СокрЛП(СтрДок.UIDДокументаБух)), Истина);
		КонецЕсли;
	КонецЦикла;

	// Карта по UUID документа BuhBud — надійний пошук строки
	МапаПоUIDБух = Новый Соответствие;
	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если ЗначениеЗаполнено(СтрДок.UIDДокументаБух)
			И СтрДок.Раздел = СтрРасх.Раздел
			И СтрДок.Измерение1 = СтрРасх.Измерение1 Тогда
			МапаПоUIDБух.Вставить(ВРег(СокрЛП(СтрДок.UIDДокументаБух)), СтрДок);
		КонецЕсли;
	КонецЦикла;

	// Додатково: карта по представленню документа BuhBud для fallback
	МапаПоПредставлению = Новый Соответствие;
	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если ЗначениеЗаполнено(СтрДок.ДокументБух)
			И СтрДок.Раздел = СтрРасх.Раздел
			И СтрДок.Измерение1 = СтрРасх.Измерение1 Тогда
			МапаПоПредставлению.Вставить(СтрДок.ДокументБух, СтрДок);
		КонецЕсли;
	КонецЦикла;

	// 2. Підготовка масиву організацій для фільтру
	// ЕДРПОУ беремо з ЕРП (де є А_ВБалансе), потім передаємо в BuhBud через COM
	ЗапросОрганизаций = Новый Запрос;
	ЗапросОрганизаций.Текст =
	"ВЫБРАТЬ
	|	Организации.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.А_ВБалансе = ИСТИНА
	|	И Организации.КодПоЕДРПОУ <> """"";

	масКодПоЕДРПОУ = Новый Массив;
	ВыборкаОрганизаций = ЗапросОрганизаций.Выполнить().Выбрать();
	Пока ВыборкаОрганизаций.Следующий() Цикл
		масКодПоЕДРПОУ.Добавить(ВыборкаОрганизаций.КодПоЕДРПОУ);
	КонецЦикла;

	Если масКодПоЕДРПОУ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	масКодПоЕДРПОУ_V83 = V83.NewObject("Массив");
	Для Каждого КодЕДРПОУ Из масКодПоЕДРПОУ Цикл
		масКодПоЕДРПОУ_V83.Добавить(КодЕДРПОУ);
	КонецЦикла;

	// 3. Запит до BuhBud: ОстаткиИОбороты з періодичністю Регістратор
	// Універсальний: INNER JOIN по Номенклатурі (працює на ВСІХ рахунках з субконто Номенклатура)
	// Без жорсткого фільтру по 5 групах рахунків
	Попытка
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст =
		"ВЫБРАТЬ
		|	ВЗ.Регистратор КАК Регистратор,
		|	ПРЕДСТАВЛЕНИЕ(ВЗ.Регистратор) КАК РегистраторПредст,
		|	СУММА(ВЗ.КоличествоПриход) - СУММА(ВЗ.КоличествоРасход) КАК КоличествоИтого
		|ИЗ
		|	(ВЫБРАТЬ
		|		Ост.Регистратор КАК Регистратор,
		|		Ост.КоличествоОборотДт КАК КоличествоПриход,
		|		Ост.КоличествоОборотКт КАК КоличествоРасход,
		|		Ост.СуммаОборотДт - Ост.СуммаОборотКт КАК СуммаНетто
		|	ИЗ
		|		РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		|				&НачалоПериода,
		|				&КонецПериода,
		|				Регистратор,
		|				,
		|				,
		|				,
		|				) КАК Ост
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозНом
		|			ПО Ост.Счет = ПозНом.Ссылка
		|				И (ПозНом.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура))
		|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозСкл
		|			ПО Ост.Счет = ПозСкл.Ссылка
		|				И (ПозСкл.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады))
		|	ГДЕ
		|		(Ост.КоличествоОборотДт <> 0 ИЛИ Ост.КоличествоОборотКт <> 0)
		|		И Ост.Организация.КодПоЕДРПОУ В (&масКодПоЕДРПОУ)
		|		И (ВЫБОР
		|			КОГДА ПозНом.НомерСтроки = 1
		|				ТОГДА ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура).А_ИдКод
		|			КОГДА ПозНом.НомерСтроки = 2
		|				ТОГДА ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.Номенклатура).А_ИдКод
		|			КОГДА ПозНом.НомерСтроки = 3
		|				ТОГДА ВЫРАЗИТЬ(Ост.Субконто3 КАК Справочник.Номенклатура).А_ИдКод
		|			ИНАЧЕ """"
		|		КОНЕЦ) = &НоменклатураИдКод
		|		И ((ВЫБОР
		|			КОГДА ПозСкл.НомерСтроки = 1
		|				ТОГДА ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Склады).А_ИдКод
		|			КОГДА ПозСкл.НомерСтроки = 2
		|				ТОГДА ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.Склады).А_ИдКод
		|			КОГДА ПозСкл.НомерСтроки = 3
		|				ТОГДА ВЫРАЗИТЬ(Ост.Субконто3 КАК Справочник.Склады).А_ИдКод
		|			ИНАЧЕ """"
		|		КОНЕЦ) = &СкладИдКод
		|			ИЛИ ПозСкл.НомерСтроки ЕСТЬ NULL)) КАК ВЗ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЗ.Регистратор
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВЗ.СуммаНетто) <> 0";

		V83_Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		V83_Запрос.УстановитьПараметр("КонецПериода", КонецПериодаРасч);
		V83_Запрос.УстановитьПараметр("НоменклатураИдКод", СтрРасх.Измерение1Ссылка);
		V83_Запрос.УстановитьПараметр("СкладИдКод", СтрРасх.Измерение2Ссылка);
		V83_Запрос.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);

		V83_Рез = V83_Запрос.Выполнить().Выбрать();
		Сообщить("DEBUG BuhBud: ЕДРПОУ=" + Строка(масКодПоЕДРПОУ_V83.Количество())
			+ " НомІд=" + СтрРасх.Измерение1Ссылка
			+ " СклІд=" + СтрРасх.Измерение2Ссылка);
		КолДокBuhBud = 0;
		Пока V83_Рез.Следующий() Цикл
			КолДокBuhBud = КолДокBuhBud + 1;

			// Отримати UUID документа BuhBud
			UIDДок = "";
			Попытка
				UIDДок = ВРег(V83.XMLСтрока(V83_Рез.Регистратор.УникальныйИдентификатор()));
			Исключение
				Сообщить("DEBUG doc " + Строка(КолДокBuhBud) + ": ПОМИЛКА UUID - " + ОписаниеОшибки());
				Продолжить;
			КонецПопытки;

			// Представлення документа BuhBud
			ПредстБух = СокрЛП(V83_Рез.РегистраторПредст);
			Сообщить("DEBUG doc " + Строка(КолДокBuhBud) + ": " + ПредстБух + " UUID=" + UIDДок + " К-ть=" + Строка(V83_Рез.КоличествоИтого));

			// Перевірити чи документ вже знайдений через ЕРП аналіз
			Если ВжеЗнайдені.Получить(UIDДок) <> Неопределено Тогда
				Сообщить("DEBUG doc " + Строка(КолДокBuhBud) + ": ВЖЕ ЗНАЙДЕНИЙ в ЕРП → оновлюю К-ть");
				// Пошук строки по UUID (надійний)
				НайденаСтрока = МапаПоUIDБух.Получить(UIDДок);
				// Fallback по представленню
				Если НайденаСтрока = Неопределено Тогда
					НайденаСтрока = МапаПоПредставлению.Получить(ПредстБух);
				КонецЕсли;
				Если НайденаСтрока <> Неопределено Тогда
					НайденаСтрока.КоличествоБух = V83_Рез.КоличествоИтого;
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			// Fallback: пошук по представленню документа (якщо UUID не в ВжеЗнайдені)
			НайденаСтрока = МапаПоUIDБух.Получить(UIDДок);
			Если НайденаСтрока = Неопределено Тогда
				НайденаСтрока = МапаПоПредставлению.Получить(ПредстБух);
			КонецЕсли;
			Если НайденаСтрока <> Неопределено Тогда
				Сообщить("DEBUG doc " + Строка(КолДокBuhBud) + ": знайдено в МапаПоUIDБух/Представленню → оновлюю К-ть");
				НайденаСтрока.КоличествоБух = V83_Рез.КоличествоИтого;
				Продолжить;
			КонецЕсли;
			Сообщить("DEBUG doc " + Строка(КолДокBuhBud) + ": НОВИЙ → додаю строку");

			// Визначити тип документа BuhBud
			ТипБух = "";
			Попытка
				ТипБух = V83_Рез.Регистратор.Метаданные().Имя;
			Исключение
			КонецПопытки;

			// Перевірити чи є відповідність в ЕРП (документ може існувати але не проведений)
			ДокЕРППредставлення = "";
			UIDДокЕРП = "";
			ЕстьВідповідність = Ложь;
			ДіяДок = "На обмін в BuhBud";
			СтатусДок = "Існує тільки в BuhBud";
			Попытка
				ЗапросСоотв = Новый Запрос;
				ЗапросСоотв.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Соотв.УникальныйИдентификаторИсточника КАК Источник,
				|	Соотв.ТипИсточника КАК ТипИсточника
				|ИЗ
				|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
				|ГДЕ
				|	Соотв.УникальныйИдентификаторПриемника = &UIDПриемника
				|	И Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20";
				ЗапросСоотв.УстановитьПараметр("UIDПриемника", UIDДок);
				РезСоотв = ЗапросСоотв.Выполнить().Выбрать();
				Если РезСоотв.Следующий() Тогда
					ЕстьВідповідність = Истина;
					UIDДокЕРП = Строка(РезСоотв.Источник.УникальныйИдентификатор());
					ДокЕРППредставлення = Строка(РезСоотв.Источник);
					// Перевірити чи проведений
					Если РезСоотв.Источник.Проведен Тогда
						ДіяДок = "Переобмін";
						СтатусДок = "Проведений в ЕРП, немає рухів по обраному складу";
					Иначе
						ДіяДок = "Провести в ЕРП";
						СтатусДок = "Не проведений в ЕРП";
					КонецЕсли;
					Сообщить("DEBUG doc " + Строка(КолДокBuhBud) + ": знайдено відповідність в ЕРП: " + ДокЕРППредставлення + " статус=" + СтатусДок);
				КонецЕсли;
			Исключение
				Сообщить("DEBUG doc " + Строка(КолДокBuhBud) + ": помилка пошуку відповідності: " + ОписаниеОшибки());
			КонецПопытки;

			// Додати строку
			НС = ТаблицаДокументов.Добавить();
			НС.Раздел          = СтрРасх.Раздел;
			НС.Измерение1      = СтрРасх.Измерение1;
			НС.Измерение2      = СтрРасх.Измерение2;
			НС.ТипДокумента    = ТипБух;
			НС.ДокументЕРП     = ДокЕРППредставлення;
			НС.ДокументБух     = ПредстБух;
			НС.КоличествоЕРП   = 0;
			НС.КоличествоБух   = V83_Рез.КоличествоИтого;
			НС.UIDДокумента    = UIDДокЕРП;
			НС.UIDДокументаБух = UIDДок;
			НС.ЕстьСоответствие = ЕстьВідповідність;
			НС.Действие        = ДіяДок;
			НС.Статус          = СтатусДок;
			НС.Синхронизировать = Истина;

		КонецЦикла;
		Сообщить("DEBUG BuhBud результат: знайдено " + Строка(КолДокBuhBud) + " документів");

	Исключение
		Сообщить("Помилка зворотнього аналізу BuhBud (Товари): " + ОписаниеОшибки());
	КонецПопытки;

	// Фінальна перевірка: якщо К-ть ЕРП = К-ть Бух — документ збігається, не потребує переобміну
	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если СтрДок.Раздел <> СтрРасх.Раздел
			ИЛИ СтрДок.Измерение1 <> СтрРасх.Измерение1 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрДок.Действие = "Переобмін"
			И СтрДок.КоличествоЕРП = СтрДок.КоличествоБух
			И СтрДок.КоличествоЕРП <> 0 Тогда
			СтрДок.Действие = "";
			СтрДок.Статус   = "Збігається";
			СтрДок.Синхронизировать = Ложь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// ===========================
// ГРОШІ — аналіз документів
// ===========================
Процедура АнализДокументов_Деньги(V83, СтрРасх, УзелОбмена)

	КонецПериодаРасч = КонецДня(ОкончаниеПериода);

	// Конвертація UUID-рядка в посилання
	БанковскийСчетСсылка = Справочники.БанковскиеСчетаОрганизаций.ПолучитьСсылку(
		Новый УникальныйИдентификатор(СтрРасх.Измерение1Ссылка));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Об.Регистратор КАК Регистратор,
	|	ПРЕДСТАВЛЕНИЕ(Об.Регистратор) КАК РегистраторПредст,
	|	Об.СуммаПриход КАК Приход,
	|	Об.СуммаРасход КАК Расход,
	|	Соотв.УникальныйИдентификаторПриемника КАК UIDвBuhBud,
	|	Соотв.ТипПриемника КАК ТипПриемника,
	|	Соотв.ТипИсточника КАК ТипИсточника
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваБезналичные.Обороты(
	|		&НачалоПериода, &КонецПериода, Авто,
	|		БанковскийСчет = &БанковскийСчет) КАК Об
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
	|	ПО Об.Регистратор = Соотв.УникальныйИдентификаторИсточника
	|		И (Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20)";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаРасч);
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчетСсылка);

	ТЗ_Док = Запрос.Выполнить().Выгрузить();
	ОбробитиДокументиЕРП(V83, ТЗ_Док, СтрРасх, УзелОбмена);

	// Зворотна перевірка: документи BuhBud без ERP відповідника
	ПеревіритиДокументиBuhBud_Деньги(V83, ТЗ_Док, СтрРасх);

КонецПроцедуры

// Зворотна перевірка: знайти документи BuhBud без ERP відповідника (розділ Гроші)
// Вирішує проблему коли документ створений/проведений в BuhBud, але не існує в ERP
// (наприклад, ручна проводка або документ не перенесений через обмін)
//
Процедура ПеревіритиДокументиBuhBud_Деньги(V83, ТЗ_ДокЕРП, СтрРасх)

	Попытка
		// 1. Збираємо UUID всіх ERP регістраторів
		масUIDерп = Новый Соответствие;
		Для Каждого СтрДок Из ТЗ_ДокЕРП Цикл
			масUIDерп.Вставить(ВРег(Строка(СтрДок.Регистратор.УникальныйИдентификатор())), Истина);
		КонецЦикла;

		// 2. Запит BuhBud: всі рухи по банківських рахунках за період
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст =
		"ВЫБРАТЬ
		|	Д.Регистратор КАК Регистратор,
		|	ПРЕДСТАВЛЕНИЕ(Д.Регистратор) КАК Представление,
		|	Д.СчетДт.Код КАК СчетДтКод,
		|	Д.СчетКт.Код КАК СчетКтКод,
		|	Д.Сумма КАК Сумма
		|ИЗ РегистрБухгалтерии.Хозрасчетный КАК Д
		|ГДЕ Д.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И (Д.СчетДт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках))
		|		ИЛИ Д.СчетКт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках)))";

		V83_Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		V83_Запрос.УстановитьПараметр("КонецПериода", КонецДня(ОкончаниеПериода));

		ТЗ_Бух = V83_Запрос.Выполнить().Выгрузить();

		// 3. Групуємо по регістратору UUID — тільки ті що НЕ в ERP
		// Зберігаємо COM-посилання на Регистратор для подальшого запиту
		масРегBuh = Новый Соответствие;
		Для Инд = 0 По ТЗ_Бух.Количество() - 1 Цикл
			Стр = ТЗ_Бух.Получить(Инд);

			Попытка
				УИД = ВРег(XMLСтрока(Стр.Регистратор.УникальныйИдентификатор()));
			Исключение
				Продолжить;
			КонецПопытки;

			// Пропустити якщо вже є в ERP
			Если масUIDерп[УИД] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			// Визначити чи обидва боки — банківські рахунки (= переказ між рахунками)
			СчДт = СокрЛП(V83.String(Стр.СчетДтКод));
			СчКт = СокрЛП(V83.String(Стр.СчетКтКод));
			ЕстьДтБанк = (Лев(СчДт, 2) = "31");
			ЕстьКтБанк = (Лев(СчКт, 2) = "31");
			ЄПереказ = ЕстьДтБанк И ЕстьКтБанк;

			Запись = масРегBuh[УИД];
			Если Запись = Неопределено Тогда
				Запись = Новый Структура("Представление, ЄПереказ, Регистратор",
					V83.String(Стр.Представление), Ложь, Стр.Регистратор);
				масРегBuh.Вставить(УИД, Запись);
			КонецЕсли;

			Если ЄПереказ Тогда
				Запись.ЄПереказ = Истина;
			КонецЕсли;
		КонецЦикла;

		// 4. Для кожного BuhBud-only регістратора: запит чистого потоку по банківських рахунках
		Для Каждого КЗ Из масРегBuh Цикл
			Запись = КЗ.Значение;

			// Пропустити переказки між рахунками
			Если Запись.ЄПереказ Тогда Продолжить; КонецЕсли;

			Попытка
				// Чистий потік: Дт банк (приход) - Кт банк (расход)
				// В ИЕРАРХИИ не можна всередині агрегатних функцій → UNION ALL
				V83_ЗапрСума = V83.NewObject("Запрос");
				V83_ЗапрСума.Текст =
				"ВЫБРАТЬ
				|	СУММА(Т.Приход) - СУММА(Т.Расход) КАК Сумма
				|ИЗ
				|	(ВЫБРАТЬ Д.Сумма КАК Приход, 0 КАК Расход
				|	ИЗ РегистрБухгалтерии.Хозрасчетный КАК Д
				|	ГДЕ Д.Регистратор = &Регистратор
				|		И Д.СчетДт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках))
				|
				|	ОБЪЕДИНИТЬ ВСЕ
				|
				|	ВЫБРАТЬ 0, Д.Сумма
				|	ИЗ РегистрБухгалтерии.Хозрасчетный КАК Д
				|	ГДЕ Д.Регистратор = &Регистратор
				|		И Д.СчетКт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках))) КАК Т";

				V83_ЗапрСума.УстановитьПараметр("Регистратор", Запись.Регистратор);
				V83_РезСума = V83_ЗапрСума.Выполнить().Выбрать();
				Сума = 0;
				Если V83_РезСума.Следующий() Тогда
					Сума = V83_РезСума.Сумма;
				КонецЕсли;

				// Пропустити якщо чистий потік = 0 (переказки або збалансовані операції)
				Если Окр(Сума, 2) = 0 Тогда Продолжить; КонецЕсли;

			Исключение
				Продолжить;
			КонецПопытки;

			// 5. Додати в ТаблицаДокументов як BuhBud-only документ
			НС = ТаблицаДокументов.Добавить();
			НС.Раздел              = СтрРасх.Раздел;
			НС.Измерение1          = СтрРасх.Измерение1;
			НС.Измерение2          = СтрРасх.Измерение2;
			НС.ДокументБух         = СокрЛП(Запись.Представление);
			НС.КоличествоБух       = Сума;
			НС.UIDДокументаБух     = КЗ.Ключ;
			НС.Действие            = "Розпровести в BuhBud";
			НС.Статус              = "Тільки в BuhBud (немає в ЕРП)";
			НС.Синхронизировать    = Истина;
			НС.ЕстьСоответствие    = Ложь;
		КонецЦикла;

	Исключение
		// Не критична помилка — зворотна перевірка не блокує основний аналіз
	КонецПопытки;

КонецПроцедуры

// ===========================
// ВЗАЄМОРОЗРАХУНКИ — аналіз документів
// ===========================
Процедура АнализДокументов_Взаиморасчеты(V83, СтрРасх, УзелОбмена)

	КонецПериодаРасч = КонецДня(ОкончаниеПериода);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Об.Регистратор КАК Регистратор,
	|	ПРЕДСТАВЛЕНИЕ(Об.Регистратор) КАК РегистраторПредст,
	|	Об.СуммаПриход КАК Приход,
	|	Об.СуммаРасход КАК Расход,
	|	Соотв.УникальныйИдентификаторПриемника КАК UIDвBuhBud,
	|	Соотв.ТипПриемника КАК ТипПриемника,
	|	Соотв.ТипИсточника КАК ТипИсточника
	|ИЗ
	|	(ВЫБРАТЬ
	|		Кл.Регистратор КАК Регистратор,
	|		ПРЕДСТАВЛЕНИЕ(Кл.Регистратор) КАК РегистраторПредст,
	|		Кл.СуммаПриход КАК СуммаПриход,
	|		Кл.СуммаРасход КАК СуммаРасход,
	|		Анал.Контрагент КАК Контрагент,
	|		Анал.Договор КАК Договор
	|	ИЗ
	|		РегистрНакопления.РасчетыСКлиентами.Обороты(
	|			&НачалоПериода, &КонецПериода, Авто, ) КАК Кл
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК Анал
	|		ПО Кл.АналитикаУчетаПоПартнерам = Анал.КлючАналитики
	|	ГДЕ Анал.Контрагент.А_ИдКод = &КонтрагентИдКод
	|		И Анал.Договор.А_ИдКод = &ДоговорИдКод
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Пост.Регистратор,
	|		ПРЕДСТАВЛЕНИЕ(Пост.Регистратор),
	|		Пост.СуммаПриход,
	|		Пост.СуммаРасход,
	|		Анал.Контрагент,
	|		Анал.Договор
	|	ИЗ
	|		РегистрНакопления.РасчетыСПоставщиками.Обороты(
	|			&НачалоПериода, &КонецПериода, Авто, ) КАК Пост
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК Анал
	|		ПО Пост.АналитикаУчетаПоПартнерам = Анал.КлючАналитики
	|	ГДЕ Анал.Контрагент.А_ИдКод = &КонтрагентИдКод
	|		И Анал.Договор.А_ИдКод = &ДоговорИдКод) КАК Об
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
	|	ПО Об.Регистратор = Соотв.УникальныйИдентификаторИсточника
	|		И (Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20)";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаРасч);
	Запрос.УстановитьПараметр("КонтрагентИдКод", СтрРасх.Измерение1Ссылка);
	Запрос.УстановитьПараметр("ДоговорИдКод", СтрРасх.Измерение2Ссылка);

	ТЗ_Док = Запрос.Выполнить().Выгрузить();
	ОбробитиДокументиЕРП(V83, ТЗ_Док, СтрРасх, УзелОбмена);

КонецПроцедуры

// ===========================
// Загальна обробка документів ERP
// ===========================
// Для кожного документа перевіряє відповідність в BuhBud та визначає дію
//
Процедура ОбробитиДокументиЕРП(V83, ТЗ_Док, СтрРасх, УзелОбмена)

	Для Каждого СтрДок Из ТЗ_Док Цикл

		НС = ТаблицаДокументов.Добавить();
		НС.Раздел          = СтрРасх.Раздел;
		НС.Измерение1      = СтрРасх.Измерение1;
		НС.Измерение2      = СтрРасх.Измерение2;
		НС.ДокументЕРП     = СокрЛП(СтрДок.РегистраторПредст);
		НС.КоличествоЕРП   = СтрДок.Приход - СтрДок.Расход;
		НС.UIDДокумента    = Строка(СтрДок.Регистратор.УникальныйИдентификатор());
		НС.Синхронизировать = Истина;

		// Визначити тип документа ERP
		ТипИст = "";
		Попытка
			ТипИст = СокрЛП(СтрДок.ТипИсточника);
			ТипИст = СтрЗаменить(ТипИст, "ДокументСсылка.", "");
		Исключение
		КонецПопытки;
		Если НЕ ЗначениеЗаполнено(ТипИст) Тогда
			МетаДанные = СтрДок.Регистратор.Метаданные();
			ТипИст = МетаДанные.Имя;
		КонецЕсли;
		НС.ТипДокумента = ТипИст;

		// Для грошей: пропустити операції переказу між рахунками
		// (в BuhBud це ОДИН документ, а в ERP — ДВА; порівнювати недоречно)
		Если НС.Раздел = "Гроші" Тогда
			Попытка
				ХозОперация = СтрДок.Регистратор.ХозяйственнаяОперация;
				Если ХозОперация = Перечисления.ХозяйственныеОперации.ПоступлениеДенежныхСредствСДругогоСчета
					ИЛИ ХозОперация = Перечисления.ХозяйственныеОперации.ПеречислениеДенежныхСредствНаДругойСчет Тогда
					НС.Действие = "";
					НС.Статус   = "Переказ між рахунками";
					НС.Синхронизировать = Ложь;
					Продолжить;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;

		// Перевірка наявності відповідності
		UIDвBuhBud = Неопределено;
		Попытка
			UIDвBuhBud = СтрДок.UIDвBuhBud;
		Исключение
		КонецПопытки;

		Если UIDвBuhBud <> Неопределено И ЗначениеЗаполнено(UIDвBuhBud) Тогда
			// Є відповідність — перевіряємо стан документа в BuhBud
			НС.ЕстьСоответствие = Истина;
			НС.UIDДокументаБух  = Строка(UIDвBuhBud);

			ТипПрием = "";
			Попытка
				ТипПрием = СокрЛП(СтрДок.ТипПриемника);
				ТипПрием = СтрЗаменить(ТипПрием, "ДокументСсылка.", "");
			Исключение
			КонецПопытки;

			Если ЗначениеЗаполнено(ТипПрием) Тогда
				ПроверитьДокументВBuhBud(V83, НС, ТипПрием, UIDвBuhBud, УзелОбмена);
			Иначе
				НС.Действие = "Невідомий тип";
				НС.Статус   = "Тип приемника не визначено";
			КонецЕсли;
		Иначе
			// Немає відповідності — документ ніколи не відправлявся
			НС.ЕстьСоответствие = Ложь;
			НС.Действие = "Розпровести в ЕРП";
			НС.Статус   = "Немає в BuhBud (немає відповідності)";
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Перевірка документа в BuhBud через COM
//
Процедура ПроверитьДокументВBuhBud(V83, НС, ТипПриемника, UIDвBuhBud, УзелОбмена)

	Попытка
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст =
			"ВЫБРАТЬ Ссылка, Проведен, ПометкаУдаления, ПРЕДСТАВЛЕНИЕ(Ссылка) КАК Представление ИЗ Документ." + ТипПриемника
			+ " ГДЕ Ссылка = &Ссылка";

		СсылкаBuhBud = V83.Документы[ТипПриемника].ПолучитьСсылку(
			V83.NewObject("УникальныйИдентификатор", Строка(UIDвBuhBud)));
		V83_Запрос.УстановитьПараметр("Ссылка", СсылкаBuhBud);

		V83_Рез = V83_Запрос.Выполнить().Выбрать();
		Если V83_Рез.Следующий() Тогда
			НС.ДокументБух = СокрЛП(V83_Рез.Представление);

			Если V83_Рез.ПометкаУдаления Тогда
				// Документ видалено в BuhBud
				НС.Действие = "Розпровести в ЕРП";
				НС.Статус   = "Видалений в BuhBud";
			ИначеЕсли НЕ V83_Рез.Проведен Тогда
				// Документ не проведений в BuhBud — поставити на обмін
				НС.Действие = "На обмін в BuhBud";
				НС.Статус   = "Не проведений в BuhBud";
				НС.ТипДокумента = ТипПриемника;
			Иначе
				// Проведений — розбіжність в рухах, потребує аналізу
				НС.Действие = "Переобмін";
				НС.Статус   = "Проведений, різниця в рухах";
				НС.ТипДокумента = ТипПриемника;
			КонецЕсли;

			// Отримати кількість/суму руху документа в BuhBud
			Попытка
				V83_ЗапросКол = V83.NewObject("Запрос");
				Если НС.Раздел = "Товари" Тогда
					// Для Товарів К-ть Бух встановлюється в АнализДокументовBuhBud_Товары
					// (UNION ALL з фільтром по Номенклатурі), тут пропускаємо
				ИначеЕсли НС.Раздел = "Контрагенти" Тогда
					V83_ЗапросКол.Текст =
					"ВЫБРАТЬ
					|	СУММА(Движения.Сумма) КАК Сумма
					|ИЗ
					|	РегистрБухгалтерии.Хозрасчетный КАК Движения
					|ГДЕ
					|	Движения.Регистратор = &Регистратор";
					V83_ЗапросКол.УстановитьПараметр("Регистратор", СсылкаBuhBud);
					V83_РезКол = V83_ЗапросКол.Выполнить().Выбрать();
					Если V83_РезКол.Следующий() Тогда
						НС.КоличествоБух = V83_РезКол.Сумма;
					КонецЕсли;
				ИначеЕсли НС.Раздел = "Гроші" Тогда
					// Чистий потік по банківському рахунку: Дт банку (приход) - Кт банку (расход)
					// В ИЕРАРХИИ не можна всередині агрегатних функцій → UNION ALL
					V83_ЗапросКол.Текст =
					"ВЫБРАТЬ
					|	СУММА(Т.Приход) - СУММА(Т.Расход) КАК Сумма
					|ИЗ
					|	(ВЫБРАТЬ Д.Сумма КАК Приход, 0 КАК Расход
					|	ИЗ РегистрБухгалтерии.Хозрасчетный КАК Д
					|	ГДЕ Д.Регистратор = &Регистратор
					|		И Д.СчетДт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках))
					|
					|	ОБЪЕДИНИТЬ ВСЕ
					|
					|	ВЫБРАТЬ 0, Д.Сумма
					|	ИЗ РегистрБухгалтерии.Хозрасчетный КАК Д
					|	ГДЕ Д.Регистратор = &Регистратор
					|		И Д.СчетКт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках))) КАК Т";
					V83_ЗапросКол.УстановитьПараметр("Регистратор", СсылкаBuhBud);
					V83_РезКол = V83_ЗапросКол.Выполнить().Выбрать();
					Если V83_РезКол.Следующий() Тогда
						НС.КоличествоБух = V83_РезКол.Сумма;
					КонецЕсли;
				КонецЕсли;
			Исключение
				// Не вдалось отримати кількість з BuhBud — залишаємо 0
			КонецПопытки;

			// Якщо суми співпадають — документ ОК, не потребує дії
			Если НС.Действие = "Переобмін"
				И Окр(НС.КоличествоЕРП - НС.КоличествоБух, 2) = 0 Тогда
				НС.Действие = "";
				НС.Статус   = "ОК";
				НС.Синхронизировать = Ложь;
			КонецЕсли;

		Иначе
			// Документ не знайдено — видалений або UUID невірний
			НС.Действие = "Розпровести в ЕРП";
			НС.Статус   = "Не знайдено в BuhBud";
		КонецЕсли;
	Исключение
		НС.Действие = "Помилка";
		НС.Статус   = "Помилка COM: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

// ===========================================================================
// ФАЗА 3: Синхронізація
// ===========================================================================

#Область Фаза3_Синхронізація

// Головна функція Фази 3 — виконання синхронізації
//
Функция ВыполнитьСинхронизацию() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	V83 = Неопределено;
	УзелОбмена = Неопределено;
	КількістьОброблених = 0;
	КількістьПомилок    = 0;

	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если НЕ СтрДок.Синхронизировать Тогда
			Продолжить;
		КонецЕсли;

		Если СтрДок.Действие = "Розпровести в ЕРП" Тогда
			// Отменити проведення документа в ЕРП
			Попытка
				РаспровестиВЕРП(СтрДок);
				КількістьОброблених = КількістьОброблених + 1;
			Исключение
				СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
				КількістьПомилок = КількістьПомилок + 1;
			КонецПопытки;

		ИначеЕсли СтрДок.Действие = "Провести в ЕРП" Тогда
			// Провести непроведений документ в ЕРП
			Попытка
				ПровестиВЕРП(СтрДок);
				КількістьОброблених = КількістьОброблених + 1;
			Исключение
				СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
				КількістьПомилок = КількістьПомилок + 1;
			КонецПопытки;

		ИначеЕсли СтрДок.Действие = "На обмін в BuhBud"
			ИЛИ СтрДок.Действие = "Переобмін" Тогда

			// Ліниве підключення до BuhBud (тільки якщо потрібно)
			Если V83 = Неопределено Тогда
				V83 = ПодключитьсяКBuhBud();
				Если V83 = Неопределено Тогда
					СтрДок.Статус = "ПОМИЛКА: Немає підключення до BuhBud";
					КількістьПомилок = КількістьПомилок + 1;
					Продолжить;
				КонецЕсли;
				// Знайти вузол обміну
				Попытка
					V83_З = V83.NewObject("Запрос");
					V83_З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20 ГДЕ НЕ ЭтотУзел";
					V83_Рез = V83_З.Выполнить().Выбрать();
					Если V83_Рез.Следующий() Тогда
						УзелОбмена = V83_Рез.Ссылка;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;

			Попытка
				ПоставитьНаОбменВBuhBud(V83, СтрДок, УзелОбмена);
				КількістьОброблених = КількістьОброблених + 1;
			Исключение
				СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
				КількістьПомилок = КількістьПомилок + 1;
			КонецПопытки;

		КонецЕсли;
	КонецЦикла;

	V83 = Неопределено;

	Возврат "Оброблено: " + КількістьОброблених + ", Помилок: " + КількістьПомилок;

КонецФункции

// Розпровести документ в ЕРП
//
Процедура РаспровестиВЕРП(СтрДок)

	UIDСтрока = СокрЛП(СтрДок.UIDДокумента);
	Если НЕ ЗначениеЗаполнено(UIDСтрока) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа";
		Возврат;
	КонецЕсли;

	// Знайти документ по UUID
	ТипДок = СокрЛП(СтрДок.ТипДокумента);
	МенеджерДок = Документы[ТипДок];
	СсылкаДок = МенеджерДок.ПолучитьСсылку(Новый УникальныйИдентификатор(UIDСтрока));

	Если НЕ ЗначениеЗаполнено(СсылкаДок) ИЛИ СсылкаДок.Пустая() Тогда
		СтрДок.Статус = "ПОМИЛКА: Документ не знайдено в ЕРП";
		Возврат;
	КонецЕсли;

	ДокОбъект = СсылкаДок.ПолучитьОбъект();
	ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	СтрДок.Статус = "Розпроведено в ЕРП";

КонецПроцедуры

// Провести непроведений документ в ЕРП
//
Процедура ПровестиВЕРП(СтрДок)

	UIDСтрока = СокрЛП(СтрДок.UIDДокумента);
	Если НЕ ЗначениеЗаполнено(UIDСтрока) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа ЕРП";
		Возврат;
	КонецЕсли;

	// Знайти тип документа ЕРП по UUID через СоответствияОбъектовИнформационныхБаз
	ТипДок = "";
	Попытка
		ЗапросТип = Новый Запрос;
		ЗапросТип.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Соотв.УникальныйИдентификаторИсточника КАК Источник,
		|	Соотв.ТипИсточника КАК ТипИсточника
		|ИЗ
		|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
		|ГДЕ
		|	Соотв.УникальныйИдентификаторПриемника = &UIDПриемника
		|	И Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20";
		ЗапросТип.УстановитьПараметр("UIDПриемника", СокрЛП(СтрДок.UIDДокументаБух));
		РезТип = ЗапросТип.Выполнить().Выбрать();
		Если РезТип.Следующий() Тогда
			ДокОбъект = РезТип.Источник.ПолучитьОбъект();
			Если ДокОбъект = Неопределено Тогда
				СтрДок.Статус = "ПОМИЛКА: Документ не знайдено в ЕРП";
				Возврат;
			КонецЕсли;
			Если ДокОбъект.Проведен Тогда
				СтрДок.Статус = "Вже проведений";
				Возврат;
			КонецЕсли;
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			СтрДок.Статус = "Проведено в ЕРП";
		Иначе
			СтрДок.Статус = "ПОМИЛКА: Відповідність не знайдена";
		КонецЕсли;
	Исключение
		СтрДок.Статус = "ПОМИЛКА проведення: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Поставити документ на обмін в BuhBud
//
Процедура ПоставитьНаОбменВBuhBud(V83, СтрДок, УзелОбмена)

	Если УзелОбмена = Неопределено Тогда
		СтрДок.Статус = "ПОМИЛКА: Вузол обміну не знайдено";
		Возврат;
	КонецЕсли;

	UIDСтрока = СокрЛП(СтрДок.UIDДокументаБух);
	Если НЕ ЗначениеЗаполнено(UIDСтрока) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа в BuhBud";
		Возврат;
	КонецЕсли;

	// ТипДокумента вже містить тип BuhBud (встановлений на етапі аналізу)
	ТипПриемника = СокрЛП(СтрДок.ТипДокумента);

	// Отримати посилання на документ в BuhBud
	СсылкаBuhBud = V83.Документы[ТипПриемника].ПолучитьСсылку(
		V83.NewObject("УникальныйИдентификатор", UIDСтрока));

	// Зареєструвати зміни на вузлі обміну
	V83.ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, СсылкаBuhBud);
	СтрДок.Статус = "Зареєстровано на обмін в BuhBud";

КонецПроцедуры

#КонецОбласти
