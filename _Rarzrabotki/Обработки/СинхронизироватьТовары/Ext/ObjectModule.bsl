Функция ПолучитьОстаткиЕРП_Взаиморасчеты(НачалоПериодаЗапр, КонецПериодаЗапр)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(ВЗ.СуммаНачальныйОстаток_ЕРП) КАК НачОстаток,
	|	СУММА(ВЗ.СуммаПриход_ЕРП) КАК Приход,
	|	СУММА(ВЗ.СуммаРасход_ЕРП) КАК Расход,
	|	СУММА(ВЗ.СуммаКонечныйОстаток_ЕРП) КАК КонОстаток,
	|	ВЗ.Контрагент КАК Контрагент,
	|	ПРЕДСТАВЛЕНИЕ(ВЗ.Контрагент) КАК КонтрагентПредставление,
	|	ВЗ.Контрагент.А_ИдКод КАК КонтрагентИдКод,
	|	ВЗ.Договор КАК Договор,
	|	ПРЕДСТАВЛЕНИЕ(ВЗ.Договор) КАК ДоговорПредставление,
	|	ВЗ.Договор.А_ИдКод КАК ДоговорИдКод
	|ИЗ
	|	(ВЫБРАТЬ
	|		Кл.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток_ЕРП,
	|		Кл.СуммаПриход КАК СуммаПриход_ЕРП,
	|		Кл.СуммаРасход КАК СуммаРасход_ЕРП,
	|		Кл.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток_ЕРП,
	|		Анал.Контрагент КАК Контрагент,
	|		Анал.Договор КАК Договор
	|	ИЗ
	|		РегистрНакопления.РасчетыСКлиентами.ОстаткиИОбороты(
	|			&НачалоПериода, &КонецПериода, , , ) КАК Кл
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК Анал
	|		ПО Кл.АналитикаУчетаПоПартнерам = Анал.КлючАналитики
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Пост.СуммаНачальныйОстаток,
	|		Пост.СуммаПриход,
	|		Пост.СуммаРасход,
	|		Пост.СуммаКонечныйОстаток,
	|		Анал.Контрагент,
	|		Анал.Договор
	|	ИЗ
	|		РегистрНакопления.РасчетыСПоставщиками.ОстаткиИОбороты(
	|			&НачалоПериода, &КонецПериода, , , ) КАК Пост
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК Анал
	|		ПО Пост.АналитикаУчетаПоПартнерам = Анал.КлючАналитики) КАК ВЗ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЗ.Контрагент,
	|	ВЗ.Договор";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаЗапр);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаЗапр);

	Возврат Запрос.Выполнить().Выгрузить();

