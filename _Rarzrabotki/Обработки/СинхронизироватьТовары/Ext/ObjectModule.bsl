Процедура СравнитьОстатки_Взаиморасчеты(V83)

	КонецПериодаРасч = КонецДня(ОкончаниеПериода);

	// 1. Залишки ERP (РасчетыСКлиентами + РасчетыСПоставщиками)
	ТЗ_ЕРП = ПолучитьОстаткиЕРП_Взаиморасчеты(НачалоПериода, КонецПериодаРасч);

	// 2. Залишки BuhBud (РегБух: 36x/63x/377x/685x...)
	ТЗ_Бух = ПолучитьОстаткиBuhBud_Взаиморасчеты(V83, НачалоПериода, КонецПериодаРасч);

	// 3. Злиття та пошук розбіжностей
	СвестиТаблицы_Взаиморасчеты(ТЗ_ЕРП, ТЗ_Бух);

