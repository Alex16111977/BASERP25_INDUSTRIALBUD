#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Ініціалізація дат періоду
	ДатаНачала = НачалоМесяца(ТекущаяДата());
	ДатаОкончания = КонецДня(ТекущаяДата());

	// Заповнення таблиці видів об'єктів
	ЗаполнитьВидыОбъектовНаСервере();

	// Заповнення списку дій
	ЗаполнитьСписокДействий();

	// Заповнення списку реквізитів для умов відбору
	ЗаполнитьСписокРеквизитовДляОтбора();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипОбъектаПриИзменении(Элемент)

	ЗаполнитьВидыОбъектовНаСервере();
	СписокОбъектов.Очистить();
	УсловияОтбора.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура ВидыОбъектовПриИзменении(Элемент)

	СписокОбъектов.Очистить();
	ЗаполнитьСписокРеквизитовДляОтбораНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура УсловияОтбораПредставлениеРеквизитаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.УсловияОтбора.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Зберігаємо ім'я реквізиту з представлення
	ТекущиеДанные.ИмяРеквизита = ТекущиеДанные.ПредставлениеРеквизита;
	ТекущиеДанные.Значение = Неопределено;
	ТекущиеДанные.ПредставлениеЗначения = "";

КонецПроцедуры

&НаКлиенте
Процедура УсловияОтбораПредставлениеЗначенияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	ТекущиеДанные = Элементы.УсловияОтбора.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ТекущиеДанные.ИмяРеквизита) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Сначала выберите реквизит';uk='Спочатку оберіть реквізит'"));
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;

	// Для простих типів (Дата, Число, Строка, Булево) використовуємо стандартний вибір
	// Для посилальних типів потрібна окрема обробка

КонецПроцедуры

&НаКлиенте
Процедура ДействиеПриИзменении(Элемент)

	// Настройка видимості поля значення в залежності від обраної дії
	НастроитьПолеЗначенияДействия();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отобрать(Команда)

	// Перевірка наявності позначених видів об'єктів
	ЕстьОтмеченныеВиды = Ложь;
	Для Каждого СтрокаВида Из ВидыОбъектов Цикл
		Если СтрокаВида.Пометка Тогда
			ЕстьОтмеченныеВиды = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЕстьОтмеченныеВиды Тогда
		ПоказатьПредупреждение(, НСтр("ru='Не выбран ни один вид объекта! Отметьте флажками нужные виды.';uk='Не обрано жодного виду об''єкта! Позначте прапорцями потрібні види.'"));
		Возврат;
	КонецЕсли;

	ОтобратьНаСервере();

	Если СписокОбъектов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Объекты не найдены';uk='Об''єкти не знайдено'"));
	Иначе
		СообщитьПользователю(СтрШаблон(НСтр("ru='Найдено объектов: %1';uk='Знайдено об''єктів: %1'"), СписокОбъектов.Количество()));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеВиды(Команда)

	Для Каждого СтрокаВида Из ВидыОбъектов Цикл
		СтрокаВида.Пометка = Истина;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкуВидов(Команда)

	Для Каждого СтрокаВида Из ВидыОбъектов Цикл
		СтрокаВида.Пометка = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьУсловие(Команда)

	НоваяСтрока = УсловияОтбора.Добавить();
	НоваяСтрока.Использовать = Истина;
	НоваяСтрока.ВидСравнения = "Равно";

КонецПроцедуры

&НаКлиенте
Процедура УдалитьУсловие(Команда)

	ТекущиеДанные = Элементы.УсловияОтбора.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		УсловияОтбора.Удалить(ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействие(Команда)

	// Перевірка наявності позначених об'єктів
	КоличествоОтмеченных = 0;
	Для Каждого СтрокаТаблицы Из СписокОбъектов Цикл
		Если СтрокаТаблицы.Пометка Тогда
			КоличествоОтмеченных = КоличествоОтмеченных + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоОтмеченных = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Нет отмеченных объектов!';uk='Немає позначених об''єктів!'"));
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Действие) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Не выбрано действие!';uk='Не обрано дію!'"));
		Возврат;
	КонецЕсли;

	// Підтвердження виконання
	ТекстВопроса = СтрШаблон(
		НСтр("ru='Выполнить действие ""%1"" для %2 объектов?';uk='Виконати дію ""%1"" для %2 об''єктів?'"),
		Действие,
		КоличествоОтмеченных);

	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьДействиеЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда

		РезультатВыполнения = ВыполнитьДействиеНаСервере();

		СообщитьПользователю(СтрШаблон(
			НСтр("ru='Обработано объектов: %1, ошибок: %2';uk='Оброблено об''єктів: %1, помилок: %2'"),
			РезультатВыполнения.Обработано,
			РезультатВыполнения.Ошибок));

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПечатьРеестра(Команда)

	Если СписокОбъектов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Список объектов пуст!';uk='Список об''єктів порожній!'"));
		Возврат;
	КонецЕсли;

	ПечатьРеестраНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для Каждого СтрокаТаблицы Из СписокОбъектов Цикл
		СтрокаТаблицы.Пометка = Истина;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметку(Команда)

	Для Каждого СтрокаТаблицы Из СписокОбъектов Цикл
		СтрокаТаблицы.Пометка = Ложь;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьВидыОбъектовНаСервере()

	ВидыОбъектов.Очистить();

	Если ТипОбъекта = 0 Тогда
		// Документи
		Для Каждого МетаданныеДокумента Из Метаданные.Документы Цикл
			НоваяСтрока = ВидыОбъектов.Добавить();
			НоваяСтрока.Пометка = Ложь;
			НоваяСтрока.ПолноеИмя = МетаданныеДокумента.ПолноеИмя();
			НоваяСтрока.Синоним = МетаданныеДокумента.Синоним;
		КонецЦикла;
	Иначе
		// Довідники
		Для Каждого МетаданныеСправочника Из Метаданные.Справочники Цикл
			НоваяСтрока = ВидыОбъектов.Добавить();
			НоваяСтрока.Пометка = Ложь;
			НоваяСтрока.ПолноеИмя = МетаданныеСправочника.ПолноеИмя();
			НоваяСтрока.Синоним = МетаданныеСправочника.Синоним;
		КонецЦикла;
	КонецЕсли;

	// Сортування за синонімом
	ВидыОбъектов.Сортировать("Синоним");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокРеквизитовДляОтбора()

	// Динамічне завантаження реквізитів з метаданих
	СписокРеквизитов = Элементы.УсловияОтбораПредставлениеРеквизита.СписокВыбора;
	СписокРеквизитов.Очистить();

	// Збираємо позначені види об'єктів
	МассивВидов = Новый Массив;
	Для Каждого СтрокаВида Из ВидыОбъектов Цикл
		Если СтрокаВида.Пометка Тогда
			МассивВидов.Добавить(СтрокаВида.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Если МассивВидов.Количество() = 0 Тогда
		// Якщо нічого не обрано - показуємо всі реквізити першого типу
		Если ВидыОбъектов.Количество() > 0 Тогда
			МассивВидов.Добавить(ВидыОбъектов[0].ПолноеИмя);
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// Отримуємо спільні реквізити для обраних видів
	ОбщиеРеквизиты = ПолучитьОбщиеРеквизитыОбъектов(МассивВидов);

	// Додаємо стандартні реквізити
	Для Каждого Реквизит Из ОбщиеРеквизиты.СтандартныеРеквизиты Цикл
		СписокРеквизитов.Добавить(Реквизит.Имя, Реквизит.Синоним);
	КонецЦикла;

	// Додаємо власні реквізити
	Для Каждого Реквизит Из ОбщиеРеквизиты.Реквизиты Цикл
		СписокРеквизитов.Добавить(Реквизит.Имя, Реквизит.Синоним);
	КонецЦикла;

	// Додаємо реквізити табличних частин з префіксом імені ТЧ
	Для Каждого КлючЗначение Из ОбщиеРеквизиты.ТабличныеЧасти Цикл
		ИмяТЧ = КлючЗначение.Ключ;
		// Отримуємо синонім табличної частини
		СинонимТЧ = ИмяТЧ;
		Если МассивВидов.Количество() > 0 Тогда
			МетаОбъект = Метаданные.НайтиПоПолномуИмени(МассивВидов[0]);
			Если МетаОбъект <> Неопределено И МетаОбъект.ТабличныеЧасти.Найти(ИмяТЧ) <> Неопределено Тогда
				МетаТЧ = МетаОбъект.ТабличныеЧасти[ИмяТЧ];
				Если Не ПустаяСтрока(МетаТЧ.Синоним) Тогда
					СинонимТЧ = МетаТЧ.Синоним;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		Для Каждого Реквизит Из КлючЗначение.Значение Цикл
			ПолноеИмя = ИмяТЧ + "." + Реквизит.Имя;
			Представление = СинонимТЧ + "." + Реквизит.Синоним;
			СписокРеквизитов.Добавить(ПолноеИмя, Представление);
		КонецЦикла;
	КонецЦикла;

	// Сортуємо за синонімом
	СписокРеквизитов.СортироватьПоПредставлению();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОбщиеРеквизитыОбъектов(МассивВидов)

	// Структура результату
	Результат = Новый Структура;
	Результат.Вставить("СтандартныеРеквизиты", Новый Массив);
	Результат.Вставить("Реквизиты", Новый Массив);
	Результат.Вставить("ТабличныеЧасти", Новый Структура);

	Если МассивВидов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Масив об'єктів метаданих
	ОбъектыМетаданных = Новый Массив;
	Для Каждого ИмяОбъекта Из МассивВидов Цикл
		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
		Если МетаданныеОбъекта <> Неопределено Тогда
			ОбъектыМетаданных.Добавить(МетаданныеОбъекта);
		КонецЕсли;
	КонецЦикла;

	Если ОбъектыМетаданных.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Стандартні реквізити - беремо з першого, потім фільтруємо
	ПервыйОбъект = ОбъектыМетаданных[0];

	// Збираємо стандартні реквізити
	СтандартныеРеквизиты = Новый Массив;
	Для Каждого ОписаниеРеквизита Из ПервыйОбъект.СтандартныеРеквизиты Цикл
		СтруктураРеквизита = Новый Структура("Имя, Синоним, Тип",
			ОписаниеРеквизита.Имя,
			?(ПустаяСтрока(ОписаниеРеквизита.Синоним), ОписаниеРеквизита.Имя, ОписаниеРеквизита.Синоним),
			ОписаниеРеквизита.Тип);
		СтандартныеРеквизиты.Добавить(СтруктураРеквизита);
	КонецЦикла;

	// Перетин стандартних реквізитів по всіх об'єктах
	Для Индекс = 1 По ОбъектыМетаданных.Количество() - 1 Цикл
		СтандартныеРеквизиты = ПересечениеСтандартныхРеквизитов(СтандартныеРеквизиты, ОбъектыМетаданных[Индекс].СтандартныеРеквизиты);
	КонецЦикла;
	Результат.СтандартныеРеквизиты = СтандартныеРеквизиты;

	// Збираємо власні реквізити
	СобственныеРеквизиты = Новый Массив;
	Для Каждого ОписаниеРеквизита Из ПервыйОбъект.Реквизиты Цикл
		СтруктураРеквизита = Новый Структура("Имя, Синоним, Тип",
			ОписаниеРеквизита.Имя,
			?(ПустаяСтрока(ОписаниеРеквизита.Синоним), ОписаниеРеквизита.Имя, ОписаниеРеквизита.Синоним),
			ОписаниеРеквизита.Тип);
		СобственныеРеквизиты.Добавить(СтруктураРеквизита);
	КонецЦикла;

	// Перетин власних реквізитів по всіх об'єктах
	Для Индекс = 1 По ОбъектыМетаданных.Количество() - 1 Цикл
		СобственныеРеквизиты = ПересечениеРеквизитов(СобственныеРеквизиты, ОбъектыМетаданных[Индекс].Реквизиты);
	КонецЦикла;
	Результат.Реквизиты = СобственныеРеквизиты;

	// Збираємо табличні частини
	ТабличныеЧасти = СписокИменТабличныхЧастей(ПервыйОбъект);
	Для Индекс = 1 По ОбъектыМетаданных.Количество() - 1 Цикл
		ТабличныеЧасти = ПересечениеМножеств(ТабличныеЧасти, СписокИменТабличныхЧастей(ОбъектыМетаданных[Индекс]));
	КонецЦикла;

	// Для кожної спільної табличної частини отримуємо спільні реквізити
	Для Каждого ИмяТабличнойЧасти Из ТабличныеЧасти Цикл
		РеквизитыТЧ = Новый Массив;
		Для Каждого ОписаниеРеквизита Из ПервыйОбъект.ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты Цикл
			СтруктураРеквизита = Новый Структура("Имя, Синоним, Тип",
				ОписаниеРеквизита.Имя,
				?(ПустаяСтрока(ОписаниеРеквизита.Синоним), ОписаниеРеквизита.Имя, ОписаниеРеквизита.Синоним),
				ОписаниеРеквизита.Тип);
			РеквизитыТЧ.Добавить(СтруктураРеквизита);
		КонецЦикла;

		Для Индекс = 1 По ОбъектыМетаданных.Количество() - 1 Цикл
			РеквизитыТЧ = ПересечениеРеквизитов(РеквизитыТЧ, ОбъектыМетаданных[Индекс].ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты);
		КонецЦикла;

		Если РеквизитыТЧ.Количество() > 0 Тогда
			Результат.ТабличныеЧасти.Вставить(ИмяТабличнойЧасти, РеквизитыТЧ);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПересечениеСтандартныхРеквизитов(Массив1, КоллекцияРеквизитов2)

	Результат = Новый Массив;

	Для Каждого Реквизит2 Из КоллекцияРеквизитов2 Цикл
		Для Каждого Реквизит1 Из Массив1 Цикл
			Если Реквизит1.Имя = Реквизит2.Имя Тогда
				Результат.Добавить(Реквизит1);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

