// Конвертовано з товстого клієнта для BAS ERP 2.5
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Ініціалізація дат періоду
	ДатаНачала = НачалоМесяца(ТекущаяДата());
	ДатаОкончания = КонецДня(ТекущаяДата());

	// Заповнення списку видів об'єктів
	ОбновитьСписокВидовОбъектовНаСервере();

	// Заповнення списку дій
	ЗаполнитьСписокДействий();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипОбъектаПриИзменении(Элемент)

	ОбновитьСписокВидовОбъектовНаСервере();
	СписокОбъектов.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура ВыбранныйВидОбъектаПриИзменении(Элемент)

	СписокОбъектов.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура ДействиеПриИзменении(Элемент)

	// Настройка видимості поля значення в залежності від обраної дії
	НастроитьПолеЗначенияДействия();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отобрать(Команда)

	Если ПустаяСтрока(ВыбранныйВидОбъекта) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Не выбран вид объекта!';uk='Не обрано вид об''єкта!'"));
		Возврат;
	КонецЕсли;

	ОтобратьНаСервере();

	Если СписокОбъектов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Объекты не найдены';uk='Об''єкти не знайдено'"));
	Иначе
		СообщитьПользователю(СтрШаблон(НСтр("ru='Найдено объектов: %1';uk='Знайдено об''єктів: %1'"), СписокОбъектов.Количество()));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействие(Команда)

	// Перевірка наявності позначених об'єктів
	КоличествоОтмеченных = 0;
	Для Каждого СтрокаТаблицы Из СписокОбъектов Цикл
		Если СтрокаТаблицы.Пометка Тогда
			КоличествоОтмеченных = КоличествоОтмеченных + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоОтмеченных = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Нет отмеченных объектов!';uk='Немає позначених об''єктів!'"));
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Действие) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Не выбрано действие!';uk='Не обрано дію!'"));
		Возврат;
	КонецЕсли;

	// Підтвердження виконання
	ТекстВопроса = СтрШаблон(
		НСтр("ru='Выполнить действие ""%1"" для %2 объектов?';uk='Виконати дію ""%1"" для %2 об''єктів?'"),
		Действие,
		КоличествоОтмеченных);

	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьДействиеЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда

		РезультатВыполнения = ВыполнитьДействиеНаСервере();

		СообщитьПользователю(СтрШаблон(
			НСтр("ru='Обработано объектов: %1, ошибок: %2';uk='Оброблено об''єктів: %1, помилок: %2'"),
			РезультатВыполнения.Обработано,
			РезультатВыполнения.Ошибок));

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПечатьРеестра(Команда)

	Если СписокОбъектов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Список объектов пуст!';uk='Список об''єктів порожній!'"));
		Возврат;
	КонецЕсли;

	ПечатьРеестраНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для Каждого СтрокаТаблицы Из СписокОбъектов Цикл
		СтрокаТаблицы.Пометка = Истина;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметку(Команда)

	Для Каждого СтрокаТаблицы Из СписокОбъектов Цикл
		СтрокаТаблицы.Пометка = Ложь;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьСписокВидовОбъектовНаСервере()

	СписокВидов = Элементы.ВыбранныйВидОбъекта.СписокВыбора;
	СписокВидов.Очистить();

	Если ТипОбъекта = 0 Тогда
		// Документи
		Для Каждого МетаданныеДокумента Из Метаданные.Документы Цикл
			СписокВидов.Добавить(МетаданныеДокумента.ПолноеИмя(), МетаданныеДокумента.Синоним);
		КонецЦикла;
	Иначе
		// Довідники
		Для Каждого МетаданныеСправочника Из Метаданные.Справочники Цикл
			СписокВидов.Добавить(МетаданныеСправочника.ПолноеИмя(), МетаданныеСправочника.Синоним);
		КонецЦикла;
	КонецЕсли;

	// Сортування за синонімом
	СписокВидов.СортироватьПоПредставлению();

	ВыбранныйВидОбъекта = "";

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДействий()

	СписокДействий = Элементы.Действие.СписокВыбора;
	СписокДействий.Очистить();

	СписокДействий.Добавить("ПометкаУдаления", НСтр("ru='Пометка удаления';uk='Позначка видалення'"));
	СписокДействий.Добавить("СнятьПометкуУдаления", НСтр("ru='Снять пометку удаления';uk='Зняти позначку видалення'"));
	СписокДействий.Добавить("Провести", НСтр("ru='Провести';uk='Провести'"));
	СписокДействий.Добавить("ОтменитьПроведение", НСтр("ru='Отменить проведение';uk='Скасувати проведення'"));
	СписокДействий.Добавить("Удалить", НСтр("ru='Удалить (ОСТОРОЖНО!)';uk='Видалити (ОБЕРЕЖНО!)'"));

КонецПроцедуры

&НаКлиенте
Процедура НастроитьПолеЗначенияДействия()

	// Для стандартних дій поле значення не потрібне
	Элементы.ЗначениеДействия.Видимость = Ложь;

КонецПроцедуры

&НаСервере
Процедура ОтобратьНаСервере()

	СписокОбъектов.Очистить();

	Если ПустаяСтрока(ВыбранныйВидОбъекта) Тогда
		Возврат;
	КонецЕсли;

	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ВыбранныйВидОбъекта);
	Если Менеджер = Неопределено Тогда
		Возврат;
	КонецЕсли;

	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ВыбранныйВидОбъекта);

	Если ТипОбъекта = 0 Тогда
		// Запит для документів
		ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	Т.Ссылка КАК Ссылка,
		|	Т.Представление КАК Наименование,
		|	Т.Дата КАК Дата,
		|	Т.Номер КАК Номер
		|ИЗ
		|	" + ВыбранныйВидОбъекта + " КАК Т
		|ГДЕ
		|	Т.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|УПОРЯДОЧИТЬ ПО
		|	Т.Дата УБЫВ";
	Иначе
		// Запит для довідників
		ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	Т.Ссылка КАК Ссылка,
		|	Т.Наименование КАК Наименование,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК Дата,
		|	"""" КАК Номер
		|ИЗ
		|	" + ВыбранныйВидОбъекта + " КАК Т
		|УПОРЯДОЧИТЬ ПО
		|	Т.Наименование";
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();

		Пока Выборка.Следующий() Цикл
			НоваяСтрока = СписокОбъектов.Добавить();
			НоваяСтрока.Пометка = Истина;
			НоваяСтрока.Ссылка = Выборка.Ссылка;
			НоваяСтрока.Наименование = Выборка.Наименование;
			НоваяСтрока.Дата = Выборка.Дата;
			НоваяСтрока.Номер = Выборка.Номер;
		КонецЦикла;
	Исключение
		СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ВыполнитьДействиеНаСервере()

	Результат = Новый Структура("Обработано, Ошибок", 0, 0);

	Для Каждого СтрокаТаблицы Из СписокОбъектов Цикл

		Если Не СтрокаТаблицы.Пометка Тогда
			Продолжить;
		КонецЕсли;

		Попытка

			ВыполнитьДействиеНадОбъектом(СтрокаТаблицы.Ссылка, Действие, ЗначениеДействия, Объект.ВыполнятьВТранзакции);
			Результат.Обработано = Результат.Обработано + 1;

		Исключение

			Результат.Ошибок = Результат.Ошибок + 1;
			СообщитьПользователю(СтрШаблон(
				НСтр("ru='Ошибка обработки %1: %2';uk='Помилка обробки %1: %2'"),
				СтрокаТаблицы.Ссылка,
				ОписаниеОшибки()));

		КонецПопытки;

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ВыполнитьДействиеНадОбъектом(Ссылка, Действие, ЗначениеДействия, ВТранзакции)

	Если ВТранзакции Тогда
		НачатьТранзакцию();
	КонецЕсли;

	Попытка

		ОбъектДанных = Ссылка.ПолучитьОбъект();

		Если Действие = "ПометкаУдаления" Тогда
			ОбъектДанных.УстановитьПометкуУдаления(Истина);

		ИначеЕсли Действие = "СнятьПометкуУдаления" Тогда
			ОбъектДанных.УстановитьПометкуУдаления(Ложь);

		ИначеЕсли Действие = "Провести" Тогда
			ОбъектДанных.Записать(РежимЗаписиДокумента.Проведение);

		ИначеЕсли Действие = "ОтменитьПроведение" Тогда
			ОбъектДанных.Записать(РежимЗаписиДокумента.ОтменаПроведения);

		ИначеЕсли Действие = "Удалить" Тогда
			ОбъектДанных.Удалить();

		КонецЕсли;

		Если ВТранзакции Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;

	Исключение

		Если ВТранзакции Тогда
			ОтменитьТранзакцию();
		КонецЕсли;

		ВызватьИсключение;

	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ПечатьРеестраНаСервере()

	// Створення табличного документа
	ТабличныйДокумент = Новый ТабличныйДокумент;

	// Заголовок
	ОбластьЗаголовок = ТабличныйДокумент.Область(1, 1, 1, 5);
	ОбластьЗаголовок.Текст = НСтр("ru='Реестр объектов';uk='Реєстр об''єктів'");
	ОбластьЗаголовок.Шрифт = Новый Шрифт(, 14, Истина);
	ОбластьЗаголовок.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;

	// Шапка таблиці
	СтрокаШапки = 3;
	ТабличныйДокумент.Область(СтрокаШапки, 1).Текст = "№";
	ТабличныйДокумент.Область(СтрокаШапки, 2).Текст = НСтр("ru='Ссылка';uk='Посилання'");
	ТабличныйДокумент.Область(СтрокаШапки, 3).Текст = НСтр("ru='Наименование';uk='Найменування'");
	ТабличныйДокумент.Область(СтрокаШапки, 4).Текст = НСтр("ru='Дата';uk='Дата'");
	ТабличныйДокумент.Область(СтрокаШапки, 5).Текст = НСтр("ru='Номер';uk='Номер'");

	// Рамка для шапки
	Для Колонка = 1 По 5 Цикл
		Область = ТабличныйДокумент.Область(СтрокаШапки, Колонка);
		Область.Шрифт = Новый Шрифт(, , Истина);
		Область.РамкаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	КонецЦикла;

	// Дані
	НомерСтроки = 0;
	Для Каждого СтрокаТаблицы Из СписокОбъектов Цикл

		Если Не СтрокаТаблицы.Пометка Тогда
			Продолжить;
		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;
		ТекущаяСтрока = СтрокаШапки + НомерСтроки;

		ТабличныйДокумент.Область(ТекущаяСтрока, 1).Текст = Строка(НомерСтроки);
		ТабличныйДокумент.Область(ТекущаяСтрока, 2).Текст = Строка(СтрокаТаблицы.Ссылка);
		ТабличныйДокумент.Область(ТекущаяСтрока, 3).Текст = СтрокаТаблицы.Наименование;
		ТабличныйДокумент.Область(ТекущаяСтрока, 4).Текст = Формат(СтрокаТаблицы.Дата, "ДЛФ=D");
		ТабличныйДокумент.Область(ТекущаяСтрока, 5).Текст = СтрокаТаблицы.Номер;

	КонецЦикла;

	// Налаштування друку
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.ТолькоПросмотр = Истина;

	// Ширина колонок
	ТабличныйДокумент.Область(, 1).ШиринаКолонки = 5;
	ТабличныйДокумент.Область(, 2).ШиринаКолонки = 40;
	ТабличныйДокумент.Область(, 3).ШиринаКолонки = 40;
	ТабличныйДокумент.Область(, 4).ШиринаКолонки = 15;
	ТабличныйДокумент.Область(, 5).ШиринаКолонки = 15;

	// Показати документ
	ТабличныйДокумент.Показать(НСтр("ru='Реестр объектов';uk='Реєстр об''єктів'"));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СообщитьПользователю(Текст, Поле = "")

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Если Не ПустаяСтрока(Поле) Тогда
		Сообщение.Поле = Поле;
	КонецЕсли;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
