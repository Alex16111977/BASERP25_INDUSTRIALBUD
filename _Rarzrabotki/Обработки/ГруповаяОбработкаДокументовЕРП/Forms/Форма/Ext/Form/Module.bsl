КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокИзменяемыхРеквизитовНаСервере()

	// Динамічне заповнення списку реквізитів для зміни на основі метаданих
	СписокРеквизитов = Элементы.ИзменяемыйРеквизит.СписокВыбора;
	СписокРеквизитов.Очистить();

	// Збираємо позначені види об'єктів
	МассивВидов = Новый Массив;
	Для Каждого СтрокаВида Из ВидыОбъектов Цикл
		Если СтрокаВида.Пометка Тогда
			МассивВидов.Добавить(СтрокаВида.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Если МассивВидов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Отримуємо спільні реквізити для обраних видів
	ОбщиеРеквизиты = ПолучитьОбщиеРеквизитыОбъектов(МассивВидов);

	// Виключаємо системні реквізити які не можна змінювати
	НеИзменяемыеРеквизиты = Новый Массив;
	НеИзменяемыеРеквизиты.Добавить("Ссылка");
	НеИзменяемыеРеквизиты.Добавить("Дата");
	НеИзменяемыеРеквизиты.Добавить("Номер");
	НеИзменяемыеРеквизиты.Добавить("Проведен");
	НеИзменяемыеРеквизиты.Добавить("ПометкаУдаления");
	НеИзменяемыеРеквизиты.Добавить("Код");
	НеИзменяемыеРеквизиты.Добавить("ЭтоГруппа");
	НеИзменяемыеРеквизиты.Добавить("Предопределенный");

	// Додаємо стандартні реквізити (крім незмінюваних)
	Для Каждого Реквизит Из ОбщиеРеквизиты.СтандартныеРеквизиты Цикл
		Если НеИзменяемыеРеквизиты.Найти(Реквизит.Имя) = Неопределено Тогда
			СписокРеквизитов.Добавить(Реквизит.Имя, Реквизит.Синоним);
		КонецЕсли;
	КонецЦикла;

	// Додаємо власні реквізити
	Для Каждого Реквизит Из ОбщиеРеквизиты.Реквизиты Цикл
		СписокРеквизитов.Добавить(Реквизит.Имя, Реквизит.Синоним);
	КонецЦикла;

	// Додаємо реквізити табличних частин (з префіксом)
	Для Каждого КлючЗначение Из ОбщиеРеквизиты.ТабличныеЧасти Цикл
		ИмяТЧ = КлючЗначение.Ключ;
		СинонимТЧ = ИмяТЧ; // Можна отримати з метаданих
		Для Каждого Реквизит Из КлючЗначение.Значение Цикл
			ПолноеИмя = ИмяТЧ + "." + Реквизит.Имя;
			Представление = СинонимТЧ + "." + Реквизит.Синоним;
			СписокРеквизитов.Добавить(ПолноеИмя, Представление);
		КонецЦикла;
	КонецЦикла;

	// Сортуємо за представленням
	СписокРеквизитов.СортироватьПоПредставлению();

КонецПроцедуры

&НаСервере
Процедура ОтобратьНаСервере()

	СписокОбъектов.Очистить();

	// Збираємо позначені види об'єктів
	МассивВидов = Новый Массив;
	Для Каждого СтрокаВида Из ВидыОбъектов Цикл
		Если СтрокаВида.Пометка Тогда
			МассивВидов.Добавить(СтрокаВида.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Если МассивВидов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Формуємо умови відбору
	ТекстУсловийШапки = "";
	ТекстУсловийТЧ = Новый Соответствие; // Ключ - ім'я ТЧ, Значення - текст умов
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ДатаНачала", НачалоДня(ДатаНачала));
	ПараметрыЗапроса.Вставить("ДатаОкончания", КонецДня(ДатаОкончания));

	НомерПараметра = 0;
	Для Каждого СтрокаУсловия Из УсловияОтбора Цикл
		Если Не СтрокаУсловия.Использовать Тогда
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(СтрокаУсловия.ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;

		НомерПараметра = НомерПараметра + 1;
		ИмяПараметра = "П" + Формат(НомерПараметра, "ЧГ=");

		// Визначаємо оператор порівняння
		Если СтрокаУсловия.ВидСравнения = "Равно" Тогда
			Оператор = "=";
		ИначеЕсли СтрокаУсловия.ВидСравнения = "НеРавно" Тогда
			Оператор = "<>";
		ИначеЕсли СтрокаУсловия.ВидСравнения = "Больше" Тогда
			Оператор = ">";
		ИначеЕсли СтрокаУсловия.ВидСравнения = "БольшеИлиРавно" Тогда
			Оператор = ">=";
		ИначеЕсли СтрокаУсловия.ВидСравнения = "Меньше" Тогда
			Оператор = "<";
		ИначеЕсли СтрокаУсловия.ВидСравнения = "МеньшеИлиРавно" Тогда
			Оператор = "<=";
		ИначеЕсли СтрокаУсловия.ВидСравнения = "Содержит" Тогда
			Оператор = "ПОДОБНО";
		Иначе
			Оператор = "=";
		КонецЕсли;

		// Перевіряємо чи це реквізит табличної частини
		ЭтоРеквизитТЧ = СтрНайти(СтрокаУсловия.ИмяРеквизита, ".") > 0;

		Если ЭтоРеквизитТЧ Тогда
			// Розбираємо ім'я ТЧ та реквізиту
			ЧастиИмени = СтрРазделить(СтрокаУсловия.ИмяРеквизита, ".");
			ИмяТЧ = ЧастиИмени[0];
			ИмяРеквизитаТЧ = ЧастиИмени[1];
			АлиасТЧ = "ТЧ" + ИмяТЧ;

			// Ініціалізуємо умови для цієї ТЧ якщо потрібно
			Если ТекстУсловийТЧ.Получить(ИмяТЧ) = Неопределено Тогда
				ТекстУсловийТЧ.Вставить(ИмяТЧ, "");
			КонецЕсли;

			// Формуємо умову для табличної частини
			ТекущийТекстТЧ = ТекстУсловийТЧ.Получить(ИмяТЧ);
			Если СтрокаУсловия.ВидСравнения = "Содержит" Тогда
				ТекущийТекстТЧ = ТекущийТекстТЧ + "
				|	И " + АлиасТЧ + "." + ИмяРеквизитаТЧ + " ПОДОБНО ""%" + СтрокаУсловия.ПредставлениеЗначения + "%""";
			Иначе
				ТекущийТекстТЧ = ТекущийТекстТЧ + "
				|	И " + АлиасТЧ + "." + ИмяРеквизитаТЧ + " " + Оператор + " &" + ИмяПараметра;
				// Визначаємо значення параметра
				Если СтрокаУсловия.Значение <> Неопределено Тогда
					ПараметрыЗапроса.Вставить(ИмяПараметра, СтрокаУсловия.Значение);
				Иначе
					ЗначениеПараметра = ПолучитьЗначениеИзПредставления(СтрокаУсловия.ИмяРеквизита, СтрокаУсловия.ПредставлениеЗначения);
					ПараметрыЗапроса.Вставить(ИмяПараметра, ЗначениеПараметра);
				КонецЕсли;
			КонецЕсли;
			ТекстУсловийТЧ.Вставить(ИмяТЧ, ТекущийТекстТЧ);
		Иначе
			// Формуємо умову для реквізиту шапки
			Если СтрокаУсловия.ВидСравнения = "Содержит" Тогда
				ТекстУсловийШапки = ТекстУсловийШапки + "
				|	И Т." + СтрокаУсловия.ИмяРеквизита + " ПОДОБНО ""%" + СтрокаУсловия.ПредставлениеЗначения + "%""";
			Иначе
				ТекстУсловийШапки = ТекстУсловийШапки + "
				|	И Т." + СтрокаУсловия.ИмяРеквизита + " " + Оператор + " &" + ИмяПараметра;
				// Визначаємо значення параметра
				Если СтрокаУсловия.Значение <> Неопределено Тогда
					ПараметрыЗапроса.Вставить(ИмяПараметра, СтрокаУсловия.Значение);
				Иначе
					ЗначениеПараметра = ПолучитьЗначениеИзПредставления(СтрокаУсловия.ИмяРеквизита, СтрокаУсловия.ПредставлениеЗначения);
					ПараметрыЗапроса.Вставить(ИмяПараметра, ЗначениеПараметра);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// Виконуємо запит для кожного виду об'єкта
	Для Каждого ПолноеИмяОбъекта Из МассивВидов Цикл

		Попытка
			МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
			Если МетаданныеОбъекта = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			// Формуємо текст JOIN-ів для табличних частин та відповідні умови
			ТекстСоединений = "";
			ТекстУсловийТЧОбъекта = "";
			НужноРАЗЛИЧНЫЕ = Ложь;

			Для Каждого КлючЗначение Из ТекстУсловийТЧ Цикл
				ИмяТЧ = КлючЗначение.Ключ;
				УсловияТЧ = КлючЗначение.Значение;

				// Перевіряємо чи є ця ТЧ в об'єкті метаданих
				Если МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяТЧ) = Неопределено Тогда
					Продолжить;
				КонецЕсли;

				АлиасТЧ = "ТЧ" + ИмяТЧ;
				ТекстСоединений = ТекстСоединений + "
				|ВНУТРЕННЕЕ СОЕДИНЕНИЕ " + ПолноеИмяОбъекта + "." + ИмяТЧ + " КАК " + АлиасТЧ + "
				|ПО Т.Ссылка = " + АлиасТЧ + ".Ссылка";
				ТекстУсловийТЧОбъекта = ТекстУсловийТЧОбъекта + УсловияТЧ;
				НужноРАЗЛИЧНЫЕ = Истина;
			КонецЦикла;

			// Вибираємо РАЗЛИЧНЫЕ якщо є JOIN з табличними частинами
			КлючовоеСловоРазличные = ?(НужноРАЗЛИЧНЫЕ, "РАЗЛИЧНЫЕ ", "");

			Если ТипОбъекта = 0 Тогда
				// Запит для документів
				ТекстЗапроса =
				"ВЫБРАТЬ " + КлючовоеСловоРазличные + "ПЕРВЫЕ 500
				|	Т.Ссылка КАК Ссылка,
				|	Т.Представление КАК Наименование,
				|	Т.Дата КАК Дата,
				|	Т.Номер КАК Номер
				|ИЗ
				|	" + ПолноеИмяОбъекта + " КАК Т" + ТекстСоединений + "
				|ГДЕ
				|	Т.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания"
				+ ТекстУсловийШапки + ТекстУсловийТЧОбъекта + "
				|УПОРЯДОЧИТЬ ПО
				|	Т.Дата УБЫВ";
			Иначе
				// Запит для довідників
				ТекстЗапроса =
				"ВЫБРАТЬ " + КлючовоеСловоРазличные + "ПЕРВЫЕ 500
				|	Т.Ссылка КАК Ссылка,
				|	Т.Наименование КАК Наименование,
				|	ДАТАВРЕМЯ(1, 1, 1) КАК Дата,
				|	"""" КАК Номер
				|ИЗ
				|	" + ПолноеИмяОбъекта + " КАК Т" + ТекстСоединений + "
				|ГДЕ
				|	ИСТИНА"
				+ ТекстУсловийШапки + ТекстУсловийТЧОбъекта + "
				|УПОРЯДОЧИТЬ ПО
				|	Т.Наименование";
			КонецЕсли;

			Запрос = Новый Запрос(ТекстЗапроса);
			Для Каждого КлючЗначение Из ПараметрыЗапроса Цикл
				Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;

			Выборка = Запрос.Выполнить().Выбрать();

			Пока Выборка.Следующий() Цикл
				НоваяСтрока = СписокОбъектов.Добавить();
				НоваяСтрока.Пометка = Истина;
				НоваяСтрока.Ссылка = Выборка.Ссылка;
				НоваяСтрока.Наименование = Выборка.Наименование;
				НоваяСтрока.Дата = Выборка.Дата;
				НоваяСтрока.Номер = Выборка.Номер;
			КонецЦикла;

		Исключение
			СообщитьПользователю(СтрШаблон(НСтр("ru='Ошибка запроса для %1: %2';uk='Помилка запиту для %1: %2'"), ПолноеИмяОбъекта, ОписаниеОшибки()));
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПолучитьЗначениеИзПредставления(ИмяРеквизита, ПредставлениеЗначения)

	// Конвертація текстового представлення в значення відповідного типу
	Если ПустаяСтрока(ПредставлениеЗначения) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Булево
	Если ВРег(ПредставлениеЗначения) = "ДА" Или ВРег(ПредставлениеЗначения) = "TRUE" Или ВРег(ПредставлениеЗначения) = "ИСТИНА" Или ПредставлениеЗначения = "1" Тогда
		Возврат Истина;
	ИначеЕсли ВРег(ПредставлениеЗначения) = "НЕТ" Или ВРег(ПредставлениеЗначения) = "FALSE" Или ВРег(ПредставлениеЗначения) = "ЛОЖЬ" Или ПредставлениеЗначения = "0" Тогда
		Возврат Ложь;
	КонецЕсли;

	// Число
	Попытка
		ЧисловоеЗначение = Число(ПредставлениеЗначения);
		Возврат ЧисловоеЗначение;
	Исключение
	КонецПопытки;

	// Дата
	Попытка
		ДатаЗначение = Дата(ПредставлениеЗначения);
		Если ДатаЗначение <> Дата(1,1,1) Тогда
			Возврат ДатаЗначение;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Повертаємо як строку
	Возврат ПредставлениеЗначения;

КонецФункции

&НаСервере
Функция ВыполнитьДействиеНаСервере()

	Результат = Новый Структура("Обработано, Ошибок", 0, 0);

	Для Каждого СтрокаТаблицы Из СписокОбъектов Цикл

		Если Не СтрокаТаблицы.Пометка Тогда
			Продолжить;
		КонецЕсли;

		Попытка

			ВыполнитьДействиеНадОбъектом(СтрокаТаблицы.Ссылка, Действие, ЗначениеДействия, Объект.ВыполнятьВТранзакции, ИзменяемыйРеквизит);
			Результат.Обработано = Результат.Обработано + 1;

		Исключение

			Результат.Ошибок = Результат.Ошибок + 1;
			СообщитьПользователю(СтрШаблон(
				НСтр("ru='Ошибка обработки %1: %2';uk='Помилка обробки %1: %2'"),
				СтрокаТаблицы.Ссылка,
				ОписаниеОшибки()));

		КонецПопытки;

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ВыполнитьДействиеНадОбъектом(Ссылка, Действие, ЗначениеДействия, ВТранзакции, ИмяРеквизита = "")

	Если ВТранзакции Тогда
		НачатьТранзакцию();
	КонецЕсли;

	Попытка

		ОбъектДанных = Ссылка.ПолучитьОбъект();

		Если Действие = "ПометкаУдаления" Тогда
			ОбъектДанных.УстановитьПометкуУдаления(Истина);

		ИначеЕсли Действие = "СнятьПометкуУдаления" Тогда
			ОбъектДанных.УстановитьПометкуУдаления(Ложь);

		ИначеЕсли Действие = "Провести" Тогда
			ОбъектДанных.Записать(РежимЗаписиДокумента.Проведение);

		ИначеЕсли Действие = "ПровестиОперативно" Тогда
			ОбъектДанных.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);

		ИначеЕсли Действие = "ОтменитьПроведение" Тогда
			ОбъектДанных.Записать(РежимЗаписиДокумента.ОтменаПроведения);

		ИначеЕсли Действие = "ИзменитьРеквизит" Тогда
			Если Не ПустаяСтрока(ИмяРеквизита) Тогда
				Попытка
					// Перевіряємо чи це реквізит табличної частини (містить крапку)
					Если СтрНайти(ИмяРеквизита, ".") > 0 Тогда
						// Формат: "ИмяТабличнойЧасти.ИмяРеквизита"
						ЧастиИмени = СтрРазделить(ИмяРеквизита, ".");
						ИмяТабличнойЧасти = ЧастиИмени[0];
						ИмяРеквизитаТЧ = ЧастиИмени[1];

						// Змінюємо значення у всіх рядках табличної частини
						ТабличнаяЧасть = ОбъектДанных[ИмяТабличнойЧасти];
						Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
							СтрокаТЧ[ИмяРеквизитаТЧ] = ЗначениеДействия;
						КонецЦикла;
					Иначе
						// Звичайний реквізит шапки
						ОбъектДанных[ИмяРеквизита] = ЗначениеДействия;
					КонецЕсли;
					ОбъектДанных.Записать();
				Исключение
					ВызватьИсключение СтрШаблон(НСтр("ru='Не удалось изменить реквизит %1: %2';uk='Не вдалося змінити реквізит %1: %2'"), ИмяРеквизита, ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;

		ИначеЕсли Действие = "Удалить" Тогда
			ОбъектДанных.Удалить();

		КонецЕсли;

		Если ВТранзакции Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;

	Исключение

		Если ВТранзакции Тогда
			ОтменитьТранзакцию();
		КонецЕсли;

		ВызватьИсключение;

	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ПечатьРеестраНаСервере()

	// Створення табличного документа
	ТабличныйДокумент = Новый ТабличныйДокумент;

	// Заголовок
	ОбластьЗаголовок = ТабличныйДокумент.Область(1, 1, 1, 5);
	ОбластьЗаголовок.Текст = НСтр("ru='Реестр объектов';uk='Реєстр об''єктів'");
	ОбластьЗаголовок.Шрифт = Новый Шрифт(, 14, Истина);
	ОбластьЗаголовок.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;

	// Шапка таблиці
	СтрокаШапки = 3;
	ТабличныйДокумент.Область(СтрокаШапки, 1).Текст = "№";
	ТабличныйДокумент.Область(СтрокаШапки, 2).Текст = НСтр("ru='Ссылка';uk='Посилання'");
	ТабличныйДокумент.Область(СтрокаШапки, 3).Текст = НСтр("ru='Наименование';uk='Найменування'");
	ТабличныйДокумент.Область(СтрокаШапки, 4).Текст = НСтр("ru='Дата';uk='Дата'");
	ТабличныйДокумент.Область(СтрокаШапки, 5).Текст = НСтр("ru='Номер';uk='Номер'");

	// Рамка для шапки
	Для Колонка = 1 По 5 Цикл
		Область = ТабличныйДокумент.Область(СтрокаШапки, Колонка);
		Область.Шрифт = Новый Шрифт(, , Истина);
		Область.РамкаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	КонецЦикла;

	// Дані
	НомерСтроки = 0;
	Для Каждого СтрокаТаблицы Из СписокОбъектов Цикл

		Если Не СтрокаТаблицы.Пометка Тогда
			Продолжить;
		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;
		ТекущаяСтрока = СтрокаШапки + НомерСтроки;

		ТабличныйДокумент.Область(ТекущаяСтрока, 1).Текст = Строка(НомерСтроки);
		ТабличныйДокумент.Область(ТекущаяСтрока, 2).Текст = Строка(СтрокаТаблицы.Ссылка);
		ТабличныйДокумент.Область(ТекущаяСтрока, 3).Текст = СтрокаТаблицы.Наименование;
		ТабличныйДокумент.Область(ТекущаяСтрока, 4).Текст = Формат(СтрокаТаблицы.Дата, "ДЛФ=D");
		ТабличныйДокумент.Область(ТекущаяСтрока, 5).Текст = СтрокаТаблицы.Номер;

	КонецЦикла;

	// Налаштування друку
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.ТолькоПросмотр = Истина;

	// Ширина колонок
	ТабличныйДокумент.Область(, 1).ШиринаКолонки = 5;
	ТабличныйДокумент.Область(, 2).ШиринаКолонки = 40;
	ТабличныйДокумент.Область(, 3).ШиринаКолонки = 40;
	ТабличныйДокумент.Область(, 4).ШиринаКолонки = 15;
	ТабличныйДокумент.Область(, 5).ШиринаКолонки = 15;

	// Показати документ
	ТабличныйДокумент.Показать(НСтр("ru='Реестр объектов';uk='Реєстр об''єктів'"));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СообщитьПользователю(Текст, Поле = "")

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Если Не ПустаяСтрока(Поле) Тогда
		Сообщение.Поле = Поле;
	КонецЕсли;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
