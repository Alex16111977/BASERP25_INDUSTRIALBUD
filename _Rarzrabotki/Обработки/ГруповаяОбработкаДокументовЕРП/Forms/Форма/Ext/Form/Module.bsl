#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Ініціалізація дат періоду
	ДатаНачала = НачалоМесяца(ТекущаяДата());
	ДатаОкончания = КонецДня(ТекущаяДата());

	// Заповнення таблиці видів об'єктів
	ЗаполнитьВидыОбъектовНаСервере();

	// Заповнення списку дій
	ЗаполнитьСписокДействий();

	// Заповнення списку реквізитів для умов відбору
	ЗаполнитьСписокРеквизитовДляОтбора();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипОбъектаПриИзменении(Элемент)

	ЗаполнитьВидыОбъектовНаСервере();
	СписокОбъектов.Очистить();
	УсловияОтбора.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура ВидыОбъектовПриИзменении(Элемент)

	СписокОбъектов.Очистить();
	ЗаполнитьСписокРеквизитовДляОтбораНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура УсловияОтбораПредставлениеРеквизитаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.УсловияОтбора.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Зберігаємо ім'я реквізиту з представлення
	ТекущиеДанные.ИмяРеквизита = ТекущиеДанные.ПредставлениеРеквизита;
	ТекущиеДанные.Значение = Неопределено;
	ТекущиеДанные.ПредставлениеЗначения = "";

КонецПроцедуры

&НаКлиенте
Процедура УсловияОтбораПредставлениеЗначенияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	ТекущиеДанные = Элементы.УсловияОтбора.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ТекущиеДанные.ИмяРеквизита) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Сначала выберите реквизит';uk='Спочатку оберіть реквізит'"));
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;

	// Для простих типів (Дата, Число, Строка, Булево) використовуємо стандартний вибір
	// Для посилальних типів потрібна окрема обробка

КонецПроцедуры

&НаКлиенте
Процедура ДействиеПриИзменении(Элемент)

	// Настройка видимості поля значення в залежності від обраної дії
	НастроитьПолеЗначенияДействия();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отобрать(Команда)

	// Перевірка наявності позначених видів об'єктів
	ЕстьОтмеченныеВиды = Ложь;
	Для Каждого СтрокаВида Из ВидыОбъектов Цикл
		Если СтрокаВида.Пометка Тогда
			ЕстьОтмеченныеВиды = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЕстьОтмеченныеВиды Тогда
		ПоказатьПредупреждение(, НСтр("ru='Не выбран ни один вид объекта! Отметьте флажками нужные виды.';uk='Не обрано жодного виду об''єкта! Позначте прапорцями потрібні види.'"));
		Возврат;
	КонецЕсли;

	ОтобратьНаСервере();

	Если СписокОбъектов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Объекты не найдены';uk='Об''єкти не знайдено'"));
	Иначе
		СообщитьПользователю(СтрШаблон(НСтр("ru='Найдено объектов: %1';uk='Знайдено об''єктів: %1'"), СписокОбъектов.Количество()));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеВиды(Команда)

	Для Каждого СтрокаВида Из ВидыОбъектов Цикл
		СтрокаВида.Пометка = Истина;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкуВидов(Команда)

	Для Каждого СтрокаВида Из ВидыОбъектов Цикл
		СтрокаВида.Пометка = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьУсловие(Команда)

	НоваяСтрока = УсловияОтбора.Добавить();
	НоваяСтрока.Использовать = Истина;
	НоваяСтрока.ВидСравнения = "Равно";

КонецПроцедуры

&НаКлиенте
Процедура УдалитьУсловие(Команда)

	ТекущиеДанные = Элементы.УсловияОтбора.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		УсловияОтбора.Удалить(ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействие(Команда)

	// Перевірка наявності позначених об'єктів
	КоличествоОтмеченных = 0;
	Для Каждого СтрокаТаблицы Из СписокОбъектов Цикл
		Если СтрокаТаблицы.Пометка Тогда
			КоличествоОтмеченных = КоличествоОтмеченных + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоОтмеченных = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Нет отмеченных объектов!';uk='Немає позначених об''єктів!'"));
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Действие) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Не выбрано действие!';uk='Не обрано дію!'"));
		Возврат;
	КонецЕсли;

	// Підтвердження виконання
	ТекстВопроса = СтрШаблон(
		НСтр("ru='Выполнить действие ""%1"" для %2 объектов?';uk='Виконати дію ""%1"" для %2 об''єктів?'"),
		Действие,
		КоличествоОтмеченных);

	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьДействиеЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда

		РезультатВыполнения = ВыполнитьДействиеНаСервере();

		СообщитьПользователю(СтрШаблон(
			НСтр("ru='Обработано объектов: %1, ошибок: %2';uk='Оброблено об''єктів: %1, помилок: %2'"),
			РезультатВыполнения.Обработано,
			РезультатВыполнения.Ошибок));

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПечатьРеестра(Команда)

	Если СписокОбъектов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Список объектов пуст!';uk='Список об''єктів порожній!'"));
		Возврат;
	КонецЕсли;

	ПечатьРеестраНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для Каждого СтрокаТаблицы Из СписокОбъектов Цикл
		СтрокаТаблицы.Пометка = Истина;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметку(Команда)

	Для Каждого СтрокаТаблицы Из СписокОбъектов Цикл
		СтрокаТаблицы.Пометка = Ложь;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьВидыОбъектовНаСервере()

	ВидыОбъектов.Очистить();

	Если ТипОбъекта = 0 Тогда
		// Документи
		Для Каждого МетаданныеДокумента Из Метаданные.Документы Цикл
			НоваяСтрока = ВидыОбъектов.Добавить();
			НоваяСтрока.Пометка = Ложь;
			НоваяСтрока.ПолноеИмя = МетаданныеДокумента.ПолноеИмя();
			НоваяСтрока.Синоним = МетаданныеДокумента.Синоним;
		КонецЦикла;
	Иначе
		// Довідники
		Для Каждого МетаданныеСправочника Из Метаданные.Справочники Цикл
			НоваяСтрока = ВидыОбъектов.Добавить();
			НоваяСтрока.Пометка = Ложь;
			НоваяСтрока.ПолноеИмя = МетаданныеСправочника.ПолноеИмя();
			НоваяСтрока.Синоним = МетаданныеСправочника.Синоним;
		КонецЦикла;
	КонецЕсли;

	// Сортування за синонімом
	ВидыОбъектов.Сортировать("Синоним");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокРеквизитовДляОтбора()

	// Базові реквізити для відбору
	СписокРеквизитов = Элементы.УсловияОтбораПредставлениеРеквизита.СписокВыбора;
	СписокРеквизитов.Очистить();

	Если ТипОбъекта = 0 Тогда
		// Для документів
		СписокРеквизитов.Добавить("Дата", НСтр("ru='Дата';uk='Дата'"));
		СписокРеквизитов.Добавить("Номер", НСтр("ru='Номер';uk='Номер'"));
		СписокРеквизитов.Добавить("Проведен", НСтр("ru='Проведен';uk='Проведено'"));
		СписокРеквизитов.Добавить("ПометкаУдаления", НСтр("ru='Пометка удаления';uk='Позначка видалення'"));
		СписокРеквизитов.Добавить("Организация", НСтр("ru='Организация';uk='Організація'"));
		СписокРеквизитов.Добавить("Контрагент", НСтр("ru='Контрагент';uk='Контрагент'"));
		СписокРеквизитов.Добавить("Партнер", НСтр("ru='Партнер';uk='Партнер'"));
		СписокРеквизитов.Добавить("Склад", НСтр("ru='Склад';uk='Склад'"));
		СписокРеквизитов.Добавить("Подразделение", НСтр("ru='Подразделение';uk='Підрозділ'"));
		СписокРеквизитов.Добавить("Ответственный", НСтр("ru='Ответственный';uk='Відповідальний'"));
		СписокРеквизитов.Добавить("Комментарий", НСтр("ru='Комментарий';uk='Коментар'"));
	Иначе
		// Для довідників
		СписокРеквизитов.Добавить("Наименование", НСтр("ru='Наименование';uk='Найменування'"));
		СписокРеквизитов.Добавить("Код", НСтр("ru='Код';uk='Код'"));
		СписокРеквизитов.Добавить("ПометкаУдаления", НСтр("ru='Пометка удаления';uk='Позначка видалення'"));
		СписокРеквизитов.Добавить("ЭтоГруппа", НСтр("ru='Это группа';uk='Це група'"));
		СписокРеквизитов.Добавить("Родитель", НСтр("ru='Родитель';uk='Батьківський елемент'"));
		СписокРеквизитов.Добавить("Владелец", НСтр("ru='Владелец';uk='Власник'"));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокРеквизитовДляОтбораНаСервере()

	ЗаполнитьСписокРеквизитовДляОтбора();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДействий()

	СписокДействий = Элементы.Действие.СписокВыбора;
	СписокДействий.Очистить();

	СписокДействий.Добавить("ПометкаУдаления", НСтр("ru='Пометка удаления';uk='Позначка видалення'"));
	СписокДействий.Добавить("СнятьПометкуУдаления", НСтр("ru='Снять пометку удаления';uk='Зняти позначку видалення'"));
	СписокДействий.Добавить("Провести", НСтр("ru='Провести';uk='Провести'"));
	СписокДействий.Добавить("ПровестиОперативно", НСтр("ru='Провести (оперативно)';uk='Провести (оперативно)'"));
	СписокДействий.Добавить("ОтменитьПроведение", НСтр("ru='Отменить проведение';uk='Скасувати проведення'"));
	СписокДействий.Добавить("ИзменитьРеквизит", НСтр("ru='Изменить реквизит';uk='Змінити реквізит'"));
	СписокДействий.Добавить("Удалить", НСтр("ru='Удалить (ОСТОРОЖНО!)';uk='Видалити (ОБЕРЕЖНО!)'"));

КонецПроцедуры

&НаКлиенте
Процедура НастроитьПолеЗначенияДействия()

	// Для дії "ИзменитьРеквизит" показуємо поля вибору реквізиту та нового значення
	Если Действие = "ИзменитьРеквизит" Тогда
		Элементы.ИзменяемыйРеквизит.Видимость = Истина;
		Элементы.ЗначениеДействия.Видимость = Истина;
		ЗаполнитьСписокИзменяемыхРеквизитовНаСервере();
	Иначе
		Элементы.ИзменяемыйРеквизит.Видимость = Ложь;
		Элементы.ЗначениеДействия.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокИзменяемыхРеквизитовНаСервере()

	// Заповнюємо список реквізитів для зміни на основі обраних видів об'єктів
	СписокРеквизитов = Элементы.ИзменяемыйРеквизит.СписокВыбора;
	СписокРеквизитов.Очистить();

	// Базові реквізити
	Если ТипОбъекта = 0 Тогда
		// Для документів
		СписокРеквизитов.Добавить("Организация", НСтр("ru='Организация';uk='Організація'"));
		СписокРеквизитов.Добавить("Контрагент", НСтр("ru='Контрагент';uk='Контрагент'"));
		СписокРеквизитов.Добавить("Партнер", НСтр("ru='Партнер';uk='Партнер'"));
		СписокРеквизитов.Добавить("Склад", НСтр("ru='Склад';uk='Склад'"));
		СписокРеквизитов.Добавить("Подразделение", НСтр("ru='Подразделение';uk='Підрозділ'"));
		СписокРеквизитов.Добавить("Ответственный", НСтр("ru='Ответственный';uk='Відповідальний'"));
		СписокРеквизитов.Добавить("Комментарий", НСтр("ru='Комментарий';uk='Коментар'"));
		СписокРеквизитов.Добавить("Менеджер", НСтр("ru='Менеджер';uk='Менеджер'"));
		СписокРеквизитов.Добавить("СтатьяДвиженияДенежныхСредств", НСтр("ru='Статья ДДС';uk='Стаття РГК'"));
	Иначе
		// Для довідників
		СписокРеквизитов.Добавить("Наименование", НСтр("ru='Наименование';uk='Найменування'"));
		СписокРеквизитов.Добавить("Родитель", НСтр("ru='Родитель';uk='Батьківський елемент'"));
		СписокРеквизитов.Добавить("Владелец", НСтр("ru='Владелец';uk='Власник'"));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОтобратьНаСервере()

	СписокОбъектов.Очистить();

	// Збираємо позначені види об'єктів
	МассивВидов = Новый Массив;
	Для Каждого СтрокаВида Из ВидыОбъектов Цикл
		Если СтрокаВида.Пометка Тогда
			МассивВидов.Добавить(СтрокаВида.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Если МассивВидов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Формуємо умови відбору
	ТекстУсловий = "";
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ДатаНачала", НачалоДня(ДатаНачала));
	ПараметрыЗапроса.Вставить("ДатаОкончания", КонецДня(ДатаОкончания));

	НомерПараметра = 0;
	Для Каждого СтрокаУсловия Из УсловияОтбора Цикл
		Если Не СтрокаУсловия.Использовать Тогда
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(СтрокаУсловия.ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;

		НомерПараметра = НомерПараметра + 1;
		ИмяПараметра = "П" + Формат(НомерПараметра, "ЧГ=");

		// Визначаємо оператор порівняння
		Если СтрокаУсловия.ВидСравнения = "Равно" Тогда
			Оператор = "=";
		ИначеЕсли СтрокаУсловия.ВидСравнения = "НеРавно" Тогда
			Оператор = "<>";
		ИначеЕсли СтрокаУсловия.ВидСравнения = "Больше" Тогда
			Оператор = ">";
		ИначеЕсли СтрокаУсловия.ВидСравнения = "БольшеИлиРавно" Тогда
			Оператор = ">=";
		ИначеЕсли СтрокаУсловия.ВидСравнения = "Меньше" Тогда
			Оператор = "<";
		ИначеЕсли СтрокаУсловия.ВидСравнения = "МеньшеИлиРавно" Тогда
			Оператор = "<=";
		ИначеЕсли СтрокаУсловия.ВидСравнения = "Содержит" Тогда
			Оператор = "ПОДОБНО";
		Иначе
			Оператор = "=";
		КонецЕсли;

		// Формуємо умову
		Если СтрокаУсловия.ВидСравнения = "Содержит" Тогда
			ТекстУсловий = ТекстУсловий + "
			|	И Т." + СтрокаУсловия.ИмяРеквизита + " ПОДОБНО ""%" + СтрокаУсловия.ПредставлениеЗначения + "%""";
		Иначе
			ТекстУсловий = ТекстУсловий + "
			|	И Т." + СтрокаУсловия.ИмяРеквизита + " " + Оператор + " &" + ИмяПараметра;
			// Визначаємо значення параметра
			Если СтрокаУсловия.Значение <> Неопределено Тогда
				ПараметрыЗапроса.Вставить(ИмяПараметра, СтрокаУсловия.Значение);
			Иначе
				// Спроба конвертувати текстове представлення
				ЗначениеПараметра = ПолучитьЗначениеИзПредставления(СтрокаУсловия.ИмяРеквизита, СтрокаУсловия.ПредставлениеЗначения);
				ПараметрыЗапроса.Вставить(ИмяПараметра, ЗначениеПараметра);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// Виконуємо запит для кожного виду об'єкта
	Для Каждого ПолноеИмяОбъекта Из МассивВидов Цикл

		Попытка
			МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
			Если МетаданныеОбъекта = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Если ТипОбъекта = 0 Тогда
				// Запит для документів
				ТекстЗапроса =
				"ВЫБРАТЬ ПЕРВЫЕ 500
				|	Т.Ссылка КАК Ссылка,
				|	Т.Представление КАК Наименование,
				|	Т.Дата КАК Дата,
				|	Т.Номер КАК Номер
				|ИЗ
				|	" + ПолноеИмяОбъекта + " КАК Т
				|ГДЕ
				|	Т.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания"
				+ ТекстУсловий + "
				|УПОРЯДОЧИТЬ ПО
				|	Т.Дата УБЫВ";
			Иначе
				// Запит для довідників
				ТекстЗапроса =
				"ВЫБРАТЬ ПЕРВЫЕ 500
				|	Т.Ссылка КАК Ссылка,
				|	Т.Наименование КАК Наименование,
				|	ДАТАВРЕМЯ(1, 1, 1) КАК Дата,
				|	"""" КАК Номер
				|ИЗ
				|	" + ПолноеИмяОбъекта + " КАК Т
				|ГДЕ
				|	ИСТИНА"
				+ ТекстУсловий + "
				|УПОРЯДОЧИТЬ ПО
				|	Т.Наименование";
			КонецЕсли;

			Запрос = Новый Запрос(ТекстЗапроса);
			Для Каждого КлючЗначение Из ПараметрыЗапроса Цикл
				Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;

			Выборка = Запрос.Выполнить().Выбрать();

			Пока Выборка.Следующий() Цикл
				НоваяСтрока = СписокОбъектов.Добавить();
				НоваяСтрока.Пометка = Истина;
				НоваяСтрока.Ссылка = Выборка.Ссылка;
				НоваяСтрока.Наименование = Выборка.Наименование;
				НоваяСтрока.Дата = Выборка.Дата;
				НоваяСтрока.Номер = Выборка.Номер;
			КонецЦикла;

		Исключение
			СообщитьПользователю(СтрШаблон(НСтр("ru='Ошибка запроса для %1: %2';uk='Помилка запиту для %1: %2'"), ПолноеИмяОбъекта, ОписаниеОшибки()));
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПолучитьЗначениеИзПредставления(ИмяРеквизита, ПредставлениеЗначения)

	// Конвертація текстового представлення в значення відповідного типу
	Если ПустаяСтрока(ПредставлениеЗначения) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Булево
	Если ВРег(ПредставлениеЗначения) = "ДА" Или ВРег(ПредставлениеЗначения) = "TRUE" Или ВРег(ПредставлениеЗначения) = "ИСТИНА" Или ПредставлениеЗначения = "1" Тогда
		Возврат Истина;
	ИначеЕсли ВРег(ПредставлениеЗначения) = "НЕТ" Или ВРег(ПредставлениеЗначения) = "FALSE" Или ВРег(ПредставлениеЗначения) = "ЛОЖЬ" Или ПредставлениеЗначения = "0" Тогда
		Возврат Ложь;
	КонецЕсли;

	// Число
	Попытка
		ЧисловоеЗначение = Число(ПредставлениеЗначения);
		Возврат ЧисловоеЗначение;
	Исключение
	КонецПопытки;

	// Дата
	Попытка
		ДатаЗначение = Дата(ПредставлениеЗначения);
		Если ДатаЗначение <> Дата(1,1,1) Тогда
			Возврат ДатаЗначение;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Повертаємо як строку
	Возврат ПредставлениеЗначения;

КонецФункции

&НаСервере
Функция ВыполнитьДействиеНаСервере()

	Результат = Новый Структура("Обработано, Ошибок", 0, 0);

	Для Каждого СтрокаТаблицы Из СписокОбъектов Цикл

		Если Не СтрокаТаблицы.Пометка Тогда
			Продолжить;
		КонецЕсли;

		Попытка

			ВыполнитьДействиеНадОбъектом(СтрокаТаблицы.Ссылка, Действие, ЗначениеДействия, Объект.ВыполнятьВТранзакции, ИзменяемыйРеквизит);
			Результат.Обработано = Результат.Обработано + 1;

		Исключение

			Результат.Ошибок = Результат.Ошибок + 1;
			СообщитьПользователю(СтрШаблон(
				НСтр("ru='Ошибка обработки %1: %2';uk='Помилка обробки %1: %2'"),
				СтрокаТаблицы.Ссылка,
				ОписаниеОшибки()));

		КонецПопытки;

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ВыполнитьДействиеНадОбъектом(Ссылка, Действие, ЗначениеДействия, ВТранзакции, ИмяРеквизита = "")

	Если ВТранзакции Тогда
		НачатьТранзакцию();
	КонецЕсли;

	Попытка

		ОбъектДанных = Ссылка.ПолучитьОбъект();

		Если Действие = "ПометкаУдаления" Тогда
			ОбъектДанных.УстановитьПометкуУдаления(Истина);

		ИначеЕсли Действие = "СнятьПометкуУдаления" Тогда
			ОбъектДанных.УстановитьПометкуУдаления(Ложь);

		ИначеЕсли Действие = "Провести" Тогда
			ОбъектДанных.Записать(РежимЗаписиДокумента.Проведение);

		ИначеЕсли Действие = "ПровестиОперативно" Тогда
			ОбъектДанных.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);

		ИначеЕсли Действие = "ОтменитьПроведение" Тогда
			ОбъектДанных.Записать(РежимЗаписиДокумента.ОтменаПроведения);

		ИначеЕсли Действие = "ИзменитьРеквизит" Тогда
			Если Не ПустаяСтрока(ИмяРеквизита) Тогда
				Попытка
					ОбъектДанных[ИмяРеквизита] = ЗначениеДействия;
					ОбъектДанных.Записать();
				Исключение
					ВызватьИсключение СтрШаблон(НСтр("ru='Не удалось изменить реквизит %1';uk='Не вдалося змінити реквізит %1'"), ИмяРеквизита);
				КонецПопытки;
			КонецЕсли;

		ИначеЕсли Действие = "Удалить" Тогда
			ОбъектДанных.Удалить();

		КонецЕсли;

		Если ВТранзакции Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;

	Исключение

		Если ВТранзакции Тогда
			ОтменитьТранзакцию();
		КонецЕсли;

		ВызватьИсключение;

	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ПечатьРеестраНаСервере()

	// Створення табличного документа
	ТабличныйДокумент = Новый ТабличныйДокумент;

	// Заголовок
	ОбластьЗаголовок = ТабличныйДокумент.Область(1, 1, 1, 5);
	ОбластьЗаголовок.Текст = НСтр("ru='Реестр объектов';uk='Реєстр об''єктів'");
	ОбластьЗаголовок.Шрифт = Новый Шрифт(, 14, Истина);
	ОбластьЗаголовок.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;

	// Шапка таблиці
	СтрокаШапки = 3;
	ТабличныйДокумент.Область(СтрокаШапки, 1).Текст = "№";
	ТабличныйДокумент.Область(СтрокаШапки, 2).Текст = НСтр("ru='Ссылка';uk='Посилання'");
	ТабличныйДокумент.Область(СтрокаШапки, 3).Текст = НСтр("ru='Наименование';uk='Найменування'");
	ТабличныйДокумент.Область(СтрокаШапки, 4).Текст = НСтр("ru='Дата';uk='Дата'");
	ТабличныйДокумент.Область(СтрокаШапки, 5).Текст = НСтр("ru='Номер';uk='Номер'");

	// Рамка для шапки
	Для Колонка = 1 По 5 Цикл
		Область = ТабличныйДокумент.Область(СтрокаШапки, Колонка);
		Область.Шрифт = Новый Шрифт(, , Истина);
		Область.РамкаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	КонецЦикла;

	// Дані
	НомерСтроки = 0;
	Для Каждого СтрокаТаблицы Из СписокОбъектов Цикл

		Если Не СтрокаТаблицы.Пометка Тогда
			Продолжить;
		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;
		ТекущаяСтрока = СтрокаШапки + НомерСтроки;

		ТабличныйДокумент.Область(ТекущаяСтрока, 1).Текст = Строка(НомерСтроки);
		ТабличныйДокумент.Область(ТекущаяСтрока, 2).Текст = Строка(СтрокаТаблицы.Ссылка);
		ТабличныйДокумент.Область(ТекущаяСтрока, 3).Текст = СтрокаТаблицы.Наименование;
		ТабличныйДокумент.Область(ТекущаяСтрока, 4).Текст = Формат(СтрокаТаблицы.Дата, "ДЛФ=D");
		ТабличныйДокумент.Область(ТекущаяСтрока, 5).Текст = СтрокаТаблицы.Номер;

	КонецЦикла;

	// Налаштування друку
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.ТолькоПросмотр = Истина;

	// Ширина колонок
	ТабличныйДокумент.Область(, 1).ШиринаКолонки = 5;
	ТабличныйДокумент.Область(, 2).ШиринаКолонки = 40;
	ТабличныйДокумент.Область(, 3).ШиринаКолонки = 40;
	ТабличныйДокумент.Область(, 4).ШиринаКолонки = 15;
	ТабличныйДокумент.Область(, 5).ШиринаКолонки = 15;

	// Показати документ
	ТабличныйДокумент.Показать(НСтр("ru='Реестр объектов';uk='Реєстр об''єктів'"));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СообщитьПользователю(Текст, Поле = "")

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Если Не ПустаяСтрока(Поле) Тогда
		Сообщение.Поле = Поле;
	КонецЕсли;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
