
&НаСервере
Процедура ЗагрузитьЗарлатуИзКазныНаСервере()

	// 1. Перевірка заповнення документа
	Если НЕ ЗначениеЗаполнено(Объект.Док_ОтражениеЗарплатыВФинансовомУчете) Тогда
		ВызватьИсключение "Не вказано документ ОтражениеЗарплатыВФинансовомУчете!";
	КонецЕсли;

	// 2. Отримання періоду з документа
	ДокРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Объект.Док_ОтражениеЗарплатыВФинансовомУчете,
		"ПериодРегистрации, Организация");

	ПериодРегистрации = ДокРеквизиты.ПериодРегистрации;
	Организация = ДокРеквизиты.Организация;

	Если НЕ ЗначениеЗаполнено(ПериодРегистрации) Тогда
		ВызватьИсключение "В документі не заповнено ПериодРегистрации!";
	КонецЕсли;

	НачалоПериода = НачалоМесяца(ПериодРегистрации);
	КонецПериода = КонецМесяца(ПериодРегистрации);

	// 3. Параметри підключення до казначейської бази
	СтрокаПодключенияКазн = "Srvr=""SQLSERVER"";Ref=""BuhKazn"";Usr=""cfo"";Pwd=""2442""";

	// 4. Створення COM-конектора
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияКазн));
	Исключение
		ВызватьИсключение "Помилка підключення до бази BuhKazn: " + ОписаниеОшибки();
	КонецПопытки;

	// 5. Формування тексту запиту до регістру БДДС
	// Вибираємо обороти по документах РаспределениеЗаработнойПлаты та РаспределениеФ2
		ТекстЗапроса =
	"ВЫБРАТЬ
	|	БДДС.Подразделение.Код КАК ПодразделениеКод,
	|	БДДС.СтатьяДвиженияДенежныхСредств.Код КАК СтатьяКод,
	|	БДДС.Направление.Код КАК НаправлениеКод,
	|	БДДС.Сотрудник.ИНН КАК СотрудникИНН,
	|	СУММА(БДДС.Сумма) КАК Сумма,
	|	БДДС.Регистратор.Организация.ЕГРПОУ КАК ОрганизацияЕГРПОУ,
	|	БДДС.Регистратор.Номер как НомерДокумента,
	|	ВЫБОР
	|		КОГДА БДДС.Регистратор ССЫЛКА Документ.РаспределениеЗаработнойПлаты
	|			ТОГДА ""А_РаспределениеЗаработнойПлаты""
	|		ИНАЧЕ ""РаспределениеФ2""
	|	КОНЕЦ КАК ВиДокумента
	|ИЗ
	|	РегистрНакопления.БДДС КАК БДДС
	|ГДЕ
	|	БДДС.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И БДДС.Регистратор.Организация.А_ПереносЕРП
	|	И (БДДС.Регистратор ССЫЛКА Документ.РаспределениеЗаработнойПлаты
	|			ИЛИ БДДС.Регистратор ССЫЛКА Документ.РаспределениеФ2)
	|
	|СГРУППИРОВАТЬ ПО
	|	БДДС.Подразделение.Код,
	|	БДДС.СтатьяДвиженияДенежныхСредств.Код,
	|	БДДС.Направление.Код,
	|	БДДС.Сотрудник.ИНН,
	|	БДДС.Регистратор.Номер,
	|	БДДС.Регистратор.Организация.ЕГРПОУ,
	|	ВЫБОР
	|		КОГДА БДДС.Регистратор ССЫЛКА Документ.РаспределениеЗаработнойПлаты
	|			ТОГДА ""А_РаспределениеЗаработнойПлаты""
	|		ИНАЧЕ ""РаспределениеФ2""
	|	КОНЕЦ";            
	
	
		
	

	// 6. Виконання запиту в казначейській базі
	Попытка
		Запрос = V83.NewObject("Запрос");
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

		РезультатЗапроса = Запрос.Выполнить();
		ТЗДанные = РезультатЗапроса.Выгрузить();
	Исключение
		V83 = Неопределено;
		V8 = Неопределено;
		ВызватьИсключение "Помилка виконання запиту в базі BuhKazn: " + ОписаниеОшибки();
	КонецПопытки;

	// 7. Серіалізація таблиці значень для передачі через COM
	Попытка
		стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗДанные);
	Исключение
		V83 = Неопределено;
		V8 = Неопределено;
		ВызватьИсключение "Помилка серіалізації даних: " + ОписаниеОшибки();
	КонецПопытки;

	// 8. Відключення від казначейської бази
	V83 = Неопределено;
	V8 = Неопределено;

	// 9. Десеріалізація таблиці значень в поточній базі
	ТаблицаДанных = ЗначениеИзСтрокиВнутр(стр_ТЗ);

	// 10. Отримання об'єкта документа для заповнення
	ДокОбъект = Объект.Док_ОтражениеЗарплатыВФинансовомУчете.ПолучитьОбъект();
	ДокОбъект.А_РаспределениеКазна.Очистить();

	// 11. Заповнення табличної частини з зіставленням довідників
	// Правила конвертації (з ПравилаОбменаДанными.xml):
	// - Подразделения → СтруктураПредприятия по Код
	// - Направления → НаправленияДеятельности по Код
	// - СтатьиДвиженияДенежныхСредств → СтатьиДвиженияДенежныхСредств по Код

	СчетчикОшибок = 0;
	СчетчикЗагружено = 0;

	Для Каждого СтрокаТЗ Из ТаблицаДанных Цикл

		// 11.1. Пошук підрозділу по коду
		Подразделение = Справочники.СтруктураПредприятия.НайтиПоКоду(
			СокрЛП(СтрокаТЗ.ПодразделениеКод));

		Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
			СчетчикОшибок = СчетчикОшибок + 1;
			Сообщить("Не знайдено підрозділ з кодом: " + СтрокаТЗ.ПодразделениеКод);
			Продолжить;
		КонецЕсли;

		// 11.2. Пошук статті ДДС по коду
		СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду(
			СокрЛП(СтрокаТЗ.СтатьяКод));

		Если НЕ ЗначениеЗаполнено(СтатьяДДС) Тогда
			СчетчикОшибок = СчетчикОшибок + 1;
			Сообщить("Не знайдено статтю ДДС з кодом: " + СтрокаТЗ.СтатьяКод);
			Продолжить;
		КонецЕсли;

		// 11.3. Пошук напрямку діяльності по коду
		   
			
			НаправлениеДеятельности = Справочники.НаправленияДеятельности.НайтиПоКоду(
			СокрЛП(СтрокаТЗ.НаправлениеКод));  
			
			
				Сотрудник = Справочники.Сотрудники.НайтиПоРеквизиту("А_КодПоДРФО",
			СокрЛП(СтрокаТЗ.СотрудникИНН));   

             	Организация = Справочники.Организации.НайтиПоРеквизиту("КодПоЕДРПОУ",
			СокрЛП(СтрокаТЗ.ОрганизацияЕГРПОУ)); 
			
			ДокРаспределениеЗП = А_НайтиПоНомеруРаспределениеЗаработнойПлаты(НачалоПериода,КонецПериода,СокрЛП(СтрокаТЗ.НомерДокумента),СокрЛП(СтрокаТЗ.ВиДокумента));

			
		// Напрямок може бути порожнім - це не помилка

		// 11.4. Додавання рядка в табличну частину А_РаспределениеКазна
		НоваяСтрока = ДокОбъект.А_РаспределениеКазна.Добавить();
		НоваяСтрока.Организация = Организация;
		НоваяСтрока.Подразделение = Подразделение;
		НоваяСтрока.СтатьяДвиженияДенежныхСредств = СтатьяДДС;
		НоваяСтрока.НаправленияДеятельности = НаправлениеДеятельности;
		НоваяСтрока.Сотрудник = Сотрудник;
		НоваяСтрока.Организация = Организация;
		НоваяСтрока.ДокРаспределениеЗП = ДокРаспределениеЗП;

		НоваяСтрока.Сумма = СтрокаТЗ.Сумма;
		// НоваяСтрока.Сотрудник - залишаємо порожнім

		СчетчикЗагружено = СчетчикЗагружено + 1;

	КонецЦикла;

	// 12. Запис документа
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		Сообщить("Документ оновлено: " + Объект.Док_ОтражениеЗарплатыВФинансовомУчете);
	Исключение
		Сообщить("ПОМИЛКА запису документа: " + ОписаниеОшибки());
	КонецПопытки;

	// 13. Виведення статистики
	Сообщить("Завантажено: " + СчетчикЗагружено + " позицій");
	Если СчетчикОшибок > 0 Тогда
		Сообщить("Помилок зіставлення: " + СчетчикОшибок);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция А_НайтиПоНомеруРаспределениеЗаработнойПлаты(НачалоПериода,КонецПериода,Номер,ВидДокумента)
	Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
		Запрос.УстановитьПараметр("Номер", Номер);
		Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
	Запрос.Текст = "ВЫБРАТЬ
	|	А_РаспределениеЗаработнойПлаты.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.А_РаспределениеЗаработнойПлаты КАК А_РаспределениеЗаработнойПлаты
	|ГДЕ
	|	А_РаспределениеЗаработнойПлаты.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И А_РаспределениеЗаработнойПлаты.Номер = &Номер
	|	И &ВидДокумента = ""А_РаспределениеЗаработнойПлаты""
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	А_РаспределениеЗаработнойПлаты.Ссылка
	|ИЗ
	|	Документ.А_РаспределениеЗаработнойПлаты КАК А_РаспределениеЗаработнойПлаты
	|ГДЕ
	|	А_РаспределениеЗаработнойПлаты.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И А_РаспределениеЗаработнойПлаты.Номер = &Номер
	|	И &ВидДокумента = ""А_РаспределениеЗаработнойПлаты""" ;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
		
		Рез = Выборка.Ссылка;	
			
	Иначе
		Рез = Неопределено;
		КонецЕсли;
		
		Возврат Рез;
КонецФункции // А_НайтиПоНомеру()

&НаКлиенте
Процедура ЗагрузитьЗарлатуИзКазны(Команда)
	ЗагрузитьЗарлатуИзКазныНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЗарплатуИзЗУПНаСервере()

	// 1. Перевірка заповнення документа
	Если НЕ ЗначениеЗаполнено(Объект.Док_ОтражениеЗарплатыВФинансовомУчете) Тогда
		ВызватьИсключение "Не вказано документ ОтражениеЗарплатыВФинансовомУчете!";
	КонецЕсли;

	// 2. Отримання періоду з документа
	ДокРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Объект.Док_ОтражениеЗарплатыВФинансовомУчете,
		"ПериодРегистрации, Организация");

	ПериодРегистрации = ДокРеквизиты.ПериодРегистрации;
	ОрганизацияДок = ДокРеквизиты.Организация;

	Если НЕ ЗначениеЗаполнено(ПериодРегистрации) Тогда
		ВызватьИсключение "В документі не заповнено ПериодРегистрации!";
	КонецЕсли;

	НачалоПериода = НачалоМесяца(ПериодРегистрации);
	КонецПериода = КонецМесяца(ПериодРегистрации);

	// Отримуємо код організації для фільтра в запиті ЗУП
	КодОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОрганизацияДок, "Код");

	// 3. Параметри підключення до бази ЗУП
	СтрокаПодключенияЗУП = "Srvr=""SQLSERVER"";Ref=""zup_1"";Usr=""cfo"";Pwd=""2442""";

	// 4. Створення COM-конектора
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияЗУП));
	Исключение
		ВызватьИсключение "Помилка підключення до бази ЗУП (zup_1): " + ОписаниеОшибки();
	КонецПопытки;

	// 5. Формування тексту запиту до регістру ВзаиморасчетыПоНДФЛ
	// Вибираємо обороти НДФЛ (утримання) за період
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВзаиморасчетыПоНДФЛ.Сотрудник.Физлицо.КодПоДРФО КАК СотрудникИНН,
	|	ВзаиморасчетыПоНДФЛ.Сотрудник.Физлицо.Наименование КАК СотрудникНаименование,
	|	СУММА(ВзаиморасчетыПоНДФЛ.НалогПриход) КАК СуммаНалога,
	|	ВзаиморасчетыПоНДФЛ.Организация.Код КАК ОрганизацияКод
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыПоНДФЛ.Обороты(&НачалоПериода, &КонецПериода, , ) КАК ВзаиморасчетыПоНДФЛ
	|ГДЕ
	|	ВзаиморасчетыПоНДФЛ.НалогПриход <> 0
	|	И ВзаиморасчетыПоНДФЛ.Организация.Код = &КодОрганизации
	|СГРУППИРОВАТЬ ПО
	|	ВзаиморасчетыПоНДФЛ.Сотрудник.Физлицо.КодПоДРФО,
	|	ВзаиморасчетыПоНДФЛ.Сотрудник.Физлицо.Наименование,
	|	ВзаиморасчетыПоНДФЛ.Организация.Код";

	// 6. Виконання запиту в базі ЗУП
	Попытка
		Запрос = V83.NewObject("Запрос");
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
		Запрос.УстановитьПараметр("КодОрганизации", КодОрганизации);

		РезультатЗапроса = Запрос.Выполнить();
		ТЗДанные = РезультатЗапроса.Выгрузить();
	Исключение
		V83 = Неопределено;
		V8 = Неопределено;
		ВызватьИсключение "Помилка виконання запиту в базі ЗУП: " + ОписаниеОшибки();
	КонецПопытки;

	// 7. Серіалізація таблиці значень для передачі через COM
	Попытка
		стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗДанные);
	Исключение
		V83 = Неопределено;
		V8 = Неопределено;
		ВызватьИсключение "Помилка серіалізації даних: " + ОписаниеОшибки();
	КонецПопытки;

	// 8. Відключення від бази ЗУП
	V83 = Неопределено;
	V8 = Неопределено;

	// 9. Десеріалізація таблиці значень в поточній базі
	ТаблицаДанных = ЗначениеИзСтрокиВнутр(стр_ТЗ);

	// 10. Отримання об'єкта документа для заповнення
	ДокОбъект = Объект.Док_ОтражениеЗарплатыВФинансовомУчете.ПолучитьОбъект();
	ДокОбъект.А_РаспределениеНалоги.Очистить();

	// 11. Підготовка довідникових значень
	// Знаходимо податок НДФЛ (шукаємо по наименованию)
	НалогНДФЛ = Справочники.Налоги.НайтиПоНаименованию("НДФЛ");
	Если НЕ ЗначениеЗаполнено(НалогНДФЛ) Тогда
		// Спробуємо знайти по частковому наименованию
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Налоги.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Налоги КАК Налоги
		|ГДЕ
		|	Налоги.Наименование ПОДОБНО ""%НДФЛ%""
		|	ИЛИ Налоги.Наименование ПОДОБНО ""%ПДФО%""";
		РезЗапроса = Запрос.Выполнить();
		Если НЕ РезЗапроса.Пустой() Тогда
			Выборка = РезЗапроса.Выбрать();
			Выборка.Следующий();
			НалогНДФЛ = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	// 12. Заповнення табличної частини А_РаспределениеНалоги
	СчетчикОшибок = 0;
	СчетчикЗагружено = 0;

	Для Каждого СтрокаТЗ Из ТаблицаДанных Цикл

		// 12.1. Пошук співробітника по ІНН (реквізит А_КодПоДРФО)
		ИННСотрудника = СокрЛП(СтрокаТЗ.СотрудникИНН);
		Если ПустаяСтрока(ИННСотрудника) Тогда
			СчетчикОшибок = СчетчикОшибок + 1;
			Сообщить("Порожній ІНН для співробітника: " + СтрокаТЗ.СотрудникНаименование);
			Продолжить;
		КонецЕсли;

		Сотрудник = Справочники.Сотрудники.НайтиПоРеквизиту("А_КодПоДРФО", ИННСотрудника);

		Если НЕ ЗначениеЗаполнено(Сотрудник) Тогда
			СчетчикОшибок = СчетчикОшибок + 1;
			Сообщить("Не знайдено співробітника з ІНН: " + ИННСотрудника + " (" + СтрокаТЗ.СотрудникНаименование + ")");
			Продолжить;
		КонецЕсли;

		// 12.2. Пошук організації по коду
		КодОрг = СокрЛП(СтрокаТЗ.ОрганизацияКод);
		Организация = Справочники.Организации.НайтиПоКоду(КодОрг);

		Если НЕ ЗначениеЗаполнено(Организация) Тогда
			// Якщо не знайшли по коду - використовуємо організацію з документа
			Организация = ОрганизацияДок;
		КонецЕсли;

		// 12.3. Додавання рядка в табличну частину А_РаспределениеНалоги
		НоваяСтрока = ДокОбъект.А_РаспределениеНалоги.Добавить();
		НоваяСтрока.Организация = Организация;
		НоваяСтрока.Сотрудник = Сотрудник;
		НоваяСтрока.Налог = НалогНДФЛ;
		НоваяСтрока.Сумма = СтрокаТЗ.СуммаНалога;
		НоваяСтрока.ТипНалога = Перечисления.ТипыНалогов.НДФЛ;

		СчетчикЗагружено = СчетчикЗагружено + 1;

	КонецЦикла;

	// 13. Запис документа
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		Сообщить("Документ оновлено: " + Объект.Док_ОтражениеЗарплатыВФинансовомУчете);
	Исключение
		Сообщить("ПОМИЛКА запису документа: " + ОписаниеОшибки());
	КонецПопытки;

	// 14. Виведення статистики
	Сообщить("===== ЗАВАНТАЖЕННЯ НДФЛ З ЗУП =====");
	Сообщить("Період: " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy") + " - " + Формат(КонецПериода, "ДФ=dd.MM.yyyy"));
	Сообщить("Завантажено: " + СчетчикЗагружено + " позицій НДФЛ");
	Если СчетчикОшибок > 0 Тогда
		Сообщить("Помилок зіставлення: " + СчетчикОшибок);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗарплатуИзЗУП(Команда)
	ЗагрузитьЗарплатуИзЗУПНаСервере();
КонецПроцедуры
