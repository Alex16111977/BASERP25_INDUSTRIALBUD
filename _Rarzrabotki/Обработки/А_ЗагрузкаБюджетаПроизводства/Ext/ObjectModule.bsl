// Загрузка бюджета экономиста (ДДС производства) из Excel в документы А_ПредварительныйБюджет.
//
// Здесь серверный движок: роль листа и его подразделение, месячные блоки, отбор строк-статей
// по уровню группировки Excel, поиск статей ДДС, get-or-create документа НА МЕСЯЦ,
// перезаполнение ТЧ ПоказателиБДДС, запись в транзакции с контролем записанного.
// Чтение самой книги Excel живёт в модуле формы (COM работает на клиенте).
//
// ВНИМАНИЕ: в модуле объекта локальные переменные теневят реквизиты обработки.
// Не заводить переменных с именами ПутьКФайлу, Сценарий, КореньНаправления,
// ПроводитьДокументы, Листы.
//
// Разметка книги (замер 18.09.2026, «ДДС Производство Вересень - Грудень 2026 Прогноз.xlsx»):
//   строка 3 — имя объекта в A и ДАТЫ начала месячных блоков; число блоков на листах РАЗНОЕ
//              (ЦО и ООН — четыре, IRC — три, а дальше на IRC идёт блок домов), поэтому блоки
//              ищутся по датам на КАЖДОМ листе отдельно;
//   строка 4 — Безналичные | Наличные | Итого | Комментарии под каждым блоком; берём две первые;
//   строки 6+ — статьи ДДС. Уровень строки — группировка Excel (Rows(N).OutlineLevel):
//     1 — разделы (ПОСТУПЛЕНИЯ, СПИСАНИЕ, Операционная деятельность…) — грузить нельзя;
//     2 — группы (Аренда квартиры, Затраты на командировку…) — грузить нельзя;
//     3 — статьи ДДС — единственный уровень, который грузим.
//   Одноимённые строки на разных уровнях — норма книги («Аренда квартиры» есть и группой,
//   и статьёй), поэтому сопоставление идёт по УРОВНЮ, а не по имени. Отступ ячейки бесполезен.
//   С первой строки «переходящий остаток» / «Free CF» / «Сальдо…» идёт служебный хвост — не грузим.
//
// Знак: в книге и поступления, и списания записаны ПОЛОЖИТЕЛЬНЫМИ; регистр хранит сумму без
// знака, приход от расхода отличает статья (А_ТипПоказателя). Грузим как есть. Проверено
// 18.09.2026: А_БюджетыНаМесяц объекта 00-001069 — 36 строк, все положительные, 29 расходных.

#Область ПрограммныйИнтерфейс

// Уровень группировки Excel строки-статьи: Rows(N).OutlineLevel = 3 (1 — раздел, 2 — группа).
// В openpyxl тот же уровень нумеруется с нуля (2); проверено 18.09.2026 на 1000 строках — 0 расхождений.
Функция УровеньСтатьиExcel() Экспорт
	Возврат 3;
КонецФункции

Функция РольОбъект() Экспорт
	Возврат "Объект";
КонецФункции

Функция РольЦО() Экспорт
	Возврат "ЦО";
КонецФункции

Функция РольСвод() Экспорт
	Возврат "Свод";
КонецФункции

Функция РольПропуск() Экспорт
	Возврат "Пропуск";
КонецФункции

// НРег + СокрЛП + NBSP(160) в пробел + Таб/ПС/ВК в пробел + сжатие двойных пробелов.
Функция НормализоватьИмя(Знач Текст) Экспорт

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Результат = Строка(Текст);
	Результат = СтрЗаменить(Результат, Символ(160), " ");
	Результат = СтрЗаменить(Результат, Символы.Таб, " ");
	Результат = СтрЗаменить(Результат, Символы.ПС, " ");
	Результат = СтрЗаменить(Результат, Символы.ВК, " ");

	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;

	Возврат НРег(СокрЛП(Результат));

КонецФункции

// Нестрогое сравнение имён подразделений: гасит ь/ъ, апострофы и разнобой и/і/ї/ы, е/є/ё.
Функция МягкаяНормаИмени(Знач Текст) Экспорт

	Результат = НормализоватьИмя(Текст);

	УдаляемыеСимволы = "ьъ'`’ʼ"".,";
	Для Сч = 1 По СтрДлина(УдаляемыеСимволы) Цикл
		Результат = СтрЗаменить(Результат, Сред(УдаляемыеСимволы, Сч, 1), "");
	КонецЦикла;

	Результат = СтрЗаменить(Результат, "і", "и");
	Результат = СтрЗаменить(Результат, "ї", "и");
	Результат = СтрЗаменить(Результат, "ы", "и");
	Результат = СтрЗаменить(Результат, "є", "е");
	Результат = СтрЗаменить(Результат, "ё", "е");
	Результат = СтрЗаменить(Результат, "ґ", "г");

	Возврат Результат;

КонецФункции

// Нормализация имени статьи без пунктуации: «Прочие юр.услуги» и «Прочие юр услуги» совпадают.
// Знаки препинания заменяются ПРОБЕЛОМ (не удаляются), иначе «юр.услуги» слиплось бы в «юруслуги».
Функция НормаБезПунктуации(Знач Текст) Экспорт

	Результат = НормализоватьИмя(Текст);

	Знаки = ".,;:-–—()«»""'/";
	Для Сч = 1 По СтрДлина(Знаки) Цикл
		Результат = СтрЗаменить(Результат, Сред(Знаки, Сч, 1), " ");
	КонецЦикла;

	Возврат НормализоватьИмя(Результат);

КонецФункции

// Месячные блоки листа по строке дат (3) и строке подписей (4).
//
// ЗначенияРядаДат, ЗначенияРядаПодписей — Соответствие: НомерКолонки -> значение ячейки.
// Блок = ДАТА в строке дат, под которой в строке подписей стоят «Безналичные» и в соседней
// колонке «Наличные». Дата без таких подписей — не блок (на IRC с колонки 15 идёт блок домов,
// но там в строке 3 числа, а не даты).
//
// Возвращает Структуру "Блоки, Отброшено": Блоки — Массив структур "Колонка, Месяц"
// по возрастанию колонки; Отброшено — Массив номеров колонок с датой, но без подписей.
Функция БлокиМесяцев(ЗначенияРядаДат, ЗначенияРядаПодписей) Экспорт

	Результат = Новый Структура("Блоки, Отброшено", Новый Массив, Новый Массив);

	Колонки = Новый СписокЗначений;
	Для Каждого КлючИЗначение Из ЗначенияРядаДат Цикл
		Если ТипЗнч(КлючИЗначение.Значение) = Тип("Дата") Тогда
			Колонки.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Колонки.СортироватьПоЗначению(НаправлениеСортировки.Возр);

	Для Каждого ЭлементКолонки Из Колонки Цикл

		Колонка = ЭлементКолонки.Значение;
		ПодписьБезнал = НормализоватьИмя(ЗначенияРядаПодписей.Получить(Колонка));
		ПодписьНал = НормализоватьИмя(ЗначенияРядаПодписей.Получить(Колонка + 1));

		Если ПодписьБезнал <> "безналичные" ИЛИ ПодписьНал <> "наличные" Тогда
			Результат.Отброшено.Добавить(Колонка);
			Продолжить;
		КонецЕсли;

		// COM сдвигает дату на -3 часа; +3 часа и НачалоМесяца гасят сдвиг в обе стороны.
		Блок = Новый Структура("Колонка, Месяц", Колонка,
			НачалоМесяца(ЗначенияРядаДат.Получить(Колонка) + 10800));
		Результат.Блоки.Добавить(Блок);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Значение перечисления для загруженных строк.
// Если ИзФайлаПрогноза ещё не загружено в конфигурацию БД — откатываемся на Вручную.
Функция ИсточникЗагрузки() Экспорт

	ЗначенияПеречисления = Метаданные.Перечисления.А_ИсточникиПредварительногоPL.ЗначенияПеречисления;
	МетаЗначение = ЗначенияПеречисления.Найти("ИзФайлаПрогноза");

	Если МетаЗначение <> Неопределено Тогда
		Возврат Перечисления.А_ИсточникиПредварительногоPL.Получить(
			ЗначенияПеречисления.Индекс(МетаЗначение));
	КонецЕсли;

	Возврат Перечисления.А_ИсточникиПредварительногоPL.Вручную;

КонецФункции

// Заполняет ТЧ Листы по данным, прочитанным из книги на клиенте.
// ДанныеЛистов — Массив структур "ИмяЛиста, Скрыт, Месяцев, СтрокСДанными" (плюс
// необязательное "Замечание" — текст клиента о листе, например об отброшенных блоках).
Процедура ЗаполнитьТаблицуЛистов(ДанныеЛистов) Экспорт

	Листы.Очистить();

	Карта = КартаЛистовВыгрузки();
	ИндексПодр = ИндексПодразделений();

	Для Каждого ДанныеЛиста Из ДанныеЛистов Цикл

		СтрокаЛистов = Листы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЛистов, ДанныеЛиста, "ИмяЛиста, Скрыт, Месяцев, СтрокСДанными");

		Роль = РольЛиста(ДанныеЛиста.ИмяЛиста, Карта, ИндексПодр);
		СтрокаЛистов.Роль = Роль.Роль;
		СтрокаЛистов.Подразделение = Роль.Подразделение;
		СтрокаЛистов.Загружать = Роль.Загружать;

		Пометки = Новый Массив;
		Пометки.Добавить(Роль.Примечание);

		Если Роль.Загружать И ДанныеЛиста.Месяцев = 0 Тогда
			СтрокаЛистов.Загружать = Ложь;
			Пометки.Добавить("нет месячных блоков (дата в строке 3 + подписи Безналичные/Наличные в строке 4)");
		ИначеЕсли Роль.Загружать И ДанныеЛиста.СтрокСДанными = 0 Тогда
			СтрокаЛистов.Загружать = Ложь;
			Пометки.Добавить("сумм нет — грузить нечего");
		КонецЕсли;

		Если ДанныеЛиста.Скрыт Тогда
			Пометки.Добавить("лист скрыт в книге");
		КонецЕсли;

		Замечание = "";
		ДанныеЛиста.Свойство("Замечание", Замечание);
		Если ЗначениеЗаполнено(Замечание) Тогда
			Пометки.Добавить(Замечание);
		КонецЕсли;

		СтрокаЛистов.Примечание = Лев(СтрСоединить(Пометки, "; "), 200);

	КонецЦикла;

КонецПроцедуры

// Дата документа месяца: первое число в 12:00.
//
// Ровно 12 часов, не полночь: месяц документа читается с его даты, а COM-обмен
// сдвигает даты на −3 часа, и полуночная дата уехала бы на предыдущие сутки.
Функция ДатаДокументаМесяца(Знач Месяц) Экспорт

	Возврат НачалоМесяца(Месяц) + 12 * 3600;

КонецФункции

// Сценарий по наименованию среди непомеченных; при Создавать = Истина недостающий заводится
// с валютой регламентированного учёта (так заведены соседние сценарии 00004–00006).
Функция СценарийПоНаименованию(Знач Наименование, Знач Создавать = Ложь) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сц.Ссылка КАК СценарийСсылка
	|ИЗ
	|	Справочник.Сценарии КАК Сц
	|ГДЕ
	|	Сц.Наименование = &Наименование
	|	И НЕ Сц.ПометкаУдаления";
	Запрос.УстановитьПараметр("Наименование", Наименование);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СценарийСсылка;
	КонецЕсли;

	Если НЕ Создавать Тогда
		Возврат Справочники.Сценарии.ПустаяСсылка();
	КонецЕсли;

	СценарийОбъект = Справочники.Сценарии.СоздатьЭлемент();
	СценарийОбъект.Наименование = Наименование;
	СценарийОбъект.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	СценарийОбъект.Записать();

	Возврат СценарийОбъект.Ссылка;

КонецФункции

// Загружает один лист в документы А_ПредварительныйБюджет — ПО ОДНОМУ НА МЕСЯЦ.
//
// ИмяЛиста            - Строка
// ПодразделениеЛиста  - СправочникСсылка.СтруктураПредприятия
// СтрокиЛиста         - Массив структур "Ряд, Имя, Уровень, Значения" в порядке строк листа,
//                       Уровень — Rows(Ряд).OutlineLevel книги, Значения — Массив структур
//                       "Месяц, Безнал, Нал" (пустые ячейки можно не класть)
// ИмяФайла            - Строка, для комментария документа
//
// Возвращает структуру с итогами по листу; Документы — массив структур
// "Месяц, Документ, Строк, Сумма, Создан, Проведен, Ошибка" по одной на месяц.
// Всё, что не поехало в документ (статья не найдена, сторона не совпала, хвост листа),
// перечислено в НеНайденныеСтатьи / Отсечено — молча ничего не глотается.
// Пустой итог листа: и для загрузки, и для предпросмотра без записи.
Функция НовыйИтогЛиста(Знач ИмяЛиста) Экспорт

	Итог = Новый Структура;
	Итог.Вставить("ИмяЛиста", ИмяЛиста);
	Итог.Вставить("Создано", 0);
	Итог.Вставить("Обновлено", 0);
	Итог.Вставить("Проведено", 0);
	Итог.Вставить("СтрокЗагружено", 0);
	Итог.Вставить("СуммаЗагружено", 0);
	Итог.Вставить("Ошибка", "");
	Итог.Вставить("ХвостСоСтроки", 0);
	Итог.Вставить("НеНайденныеСтатьи", Новый Массив);
	Итог.Вставить("НестрогиеСтатьи", Новый Массив);
	Итог.Вставить("Отсечено", Новый Массив);
	Итог.Вставить("Документы", Новый Массив);

	Возврат Итог;

КонецФункции

Функция ЗагрузитьЛист(ИмяЛиста, ПодразделениеЛиста, СтрокиЛиста, ИмяФайла) Экспорт

	Итог = НовыйИтогЛиста(ИмяЛиста);

	Если НЕ ЗначениеЗаполнено(ПодразделениеЛиста) Тогда
		Итог.Ошибка = "не указано подразделение";
		Возврат Итог;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.Сценарий) Тогда
		Итог.Ошибка = "не указан сценарий";
		Возврат Итог;
	КонецЕсли;

	ТаблицаБюджета = СобратьТаблицуБюджета(СтрокиЛиста, Итог);

	Для Каждого Месяц Из МесяцыТаблицы(ТаблицаБюджета) Цикл
		ЗагрузитьМесяцЛиста(Месяц, ТаблицаБюджета, ПодразделениеЛиста, ИмяЛиста, ИмяФайла, Итог);
	КонецЦикла;

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Карта листов PL-книги — РегистрСведений.А_СтруктураВыгрузкиОтчетаPLвЕксел.
// В нём уже выверены описки экономиста («МК Чорноморск» -> «МК Чорноморськ» и т. п.),
// поэтому лист с таким же именем берёт подразделение оттуда, а не подбирает по имени.
// Возвращает Соответствие: нормализованное имя листа -> Структура
// "Подразделение, ОтчетПоНаправлению, ТолькоЭтоПодразделение".
Функция КартаЛистовВыгрузки()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Рег.ИмяСтраницы КАК ИмяСтраницы,
	|	Рег.Подразделение КАК Подразделение,
	|	Рег.ОтчетПоНаправлению КАК ОтчетПоНаправлению,
	|	Рег.ТолькоЭтоПодразделение КАК ТолькоЭтоПодразделение
	|ИЗ
	|	РегистрСведений.А_СтруктураВыгрузкиОтчетаPLвЕксел КАК Рег
	|УПОРЯДОЧИТЬ ПО
	|	Рег.НомерПорядковыйСтраницы";

	Карта = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Ключ = НормализоватьИмя(Выборка.ИмяСтраницы);
		Если НЕ ЗначениеЗаполнено(Ключ) ИЛИ Карта.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Запись = Новый Структура("Подразделение, ОтчетПоНаправлению, ТолькоЭтоПодразделение");
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Карта.Вставить(Ключ, Запись);

	КонецЦикла;

	Возврат Карта;

КонецФункции

// Индексы подразделений: Строгие и Мягкие (имя -> Массив ссылок), Корни (имя -> ссылка
// подразделения без родителя), ПодКорнем (ссылка -> Истина для иерархии КореньНаправления;
// Неопределено, если корень не задан), Направления (ссылка -> А_НаправлениеДеятельности).
Функция ИндексПодразделений()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Ссылка КАК ПодразделениеСсылка,
	|	П.Наименование КАК Наименование,
	|	П.Родитель КАК Родитель,
	|	П.А_НаправлениеДеятельности КАК Направление
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК П
	|ГДЕ
	|	НЕ П.ПометкаУдаления";

	Индекс = Новый Структура("Строгие, Мягкие, Корни, ПодКорнем, Направления",
		Новый Соответствие, Новый Соответствие, Новый Соответствие, Неопределено, Новый Соответствие);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьКандидата(Индекс.Строгие, НормализоватьИмя(Выборка.Наименование), Выборка.ПодразделениеСсылка);
		ДобавитьКандидата(Индекс.Мягкие, МягкаяНормаИмени(Выборка.Наименование), Выборка.ПодразделениеСсылка);
		Индекс.Направления.Вставить(Выборка.ПодразделениеСсылка, Выборка.Направление);
		Если НЕ ЗначениеЗаполнено(Выборка.Родитель) Тогда
			Индекс.Корни.Вставить(НормализоватьИмя(Выборка.Наименование), Выборка.ПодразделениеСсылка);
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(ЭтотОбъект.КореньНаправления) Тогда
		Индекс.ПодКорнем = Новый Соответствие;
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	П.Ссылка КАК ПодразделениеСсылка
		|ИЗ
		|	Справочник.СтруктураПредприятия КАК П
		|ГДЕ
		|	П.Ссылка В ИЕРАРХИИ (&Корень)
		|	И НЕ П.ПометкаУдаления";
		Запрос.УстановитьПараметр("Корень", ЭтотОбъект.КореньНаправления);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Индекс.ПодКорнем.Вставить(Выборка.ПодразделениеСсылка, Истина);
		КонецЦикла;
	КонецЕсли;

	Возврат Индекс;

КонецФункции

Процедура ДобавитьКандидата(Индекс, Знач Ключ, Знач Значение)

	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;

	Кандидаты = Индекс.Получить(Ключ);
	Если Кандидаты = Неопределено Тогда
		Кандидаты = Новый Массив;
		Индекс.Вставить(Ключ, Кандидаты);
	КонецЕсли;
	Кандидаты.Добавить(Значение);

КонецПроцедуры

// Подтверждённые пользователем соответствия «лист книги -> код подразделения» для случаев,
// где имена не сводятся никакой нормализацией: экономист пишет объект по-украински, а в базе
// он заведён по-русски. Нестрогое сравнение тут бессильно — «підгірці» и «подгорцы» отличаются
// не мягким знаком, а гласными (і/о, і/ы).
//
//   «МК Підгірці» -> 00-001103 «МК Подгорцы» (подтверждено пользователем 18.09.2026;
//   в ветке «хххх Не использовать» есть тёзки 00-000281/285/288 — их брать нельзя).
//
// Новых подразделений обработка НЕ создаёт: код, которого нет в базе, просто не сопоставится,
// и лист уйдёт в «требует уточнения».
Функция ЯвныеСоответствияЛистов()

	Соответствия = Новый Соответствие;
	Соответствия.Вставить(НормализоватьИмя("МК Підгірці"), "00-001103");

	Возврат Соответствия;

КонецФункции

Функция ПодразделениеПоКоду(Знач Код)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	П.Ссылка КАК ПодразделениеСсылка
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК П
	|ГДЕ
	|	П.Код = &Код
	|	И НЕ П.ПометкаУдаления";
	Запрос.УстановитьПараметр("Код", Код);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПодразделениеСсылка;
	КонецЕсли;

	Возврат Справочники.СтруктураПредприятия.ПустаяСсылка();

КонецФункции

// Строгое совпадение, затем ЕДИНСТВЕННОЕ нестрогое. Неоднозначность — не подбираем:
// пусть пользователь укажет руками, чем загрузить бюджет не в тот объект.
Функция ПодобратьПодразделение(Знач ИмяЛиста, ИндексПодр)

	Результат = Новый Структура("Подразделение, Нестрого",
		Справочники.СтруктураПредприятия.ПустаяСсылка(), Ложь);

	Кандидаты = ИндексПодр.Строгие.Получить(НормализоватьИмя(ИмяЛиста));
	Если Кандидаты <> Неопределено И Кандидаты.Количество() = 1 Тогда
		Результат.Подразделение = Кандидаты[0];
		Возврат Результат;
	КонецЕсли;
	Если Кандидаты <> Неопределено И Кандидаты.Количество() > 1 Тогда
		Возврат Результат;
	КонецЕсли;

	Кандидаты = ИндексПодр.Мягкие.Получить(МягкаяНормаИмени(ИмяЛиста));
	Если Кандидаты <> Неопределено И Кандидаты.Количество() = 1 Тогда
		Результат.Подразделение = Кандидаты[0];
		Результат.Нестрого = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Роль листа книги: грузить ли его и на какое подразделение.
//
//   «СВОД…»            — свод направления: собирает объекты, грузить нельзя — задвоит;
//   «ЦО_<Направление>» — ЦО направления: затраты самого корня, с объектами не пересекается
//                        (замер 18.09.2026: СВОД_Производство = ЦО_Производство + 14 объектов
//                        копейка в копейку) — грузим на корень направления;
//   иначе              — объектный лист: подразделение из регистра выгрузки PL, затем по имени.
// Подразделение вне иерархии КореньНаправления — не грузится (другое направление).
// Что не сопоставилось — НЕ пропускается молча: роль «Пропуск» с причиной, пользователь
// укажет подразделение руками и поставит галку «Грузить».
Функция РольЛиста(Знач ИмяЛиста, Карта, ИндексПодр)

	Результат = Новый Структура("Роль, Подразделение, Загружать, Примечание",
		РольПропуск(), Справочники.СтруктураПредприятия.ПустаяСсылка(), Ложь, "");

	ИмяНорм = НормализоватьИмя(ИмяЛиста);

	Если СтрНачинаетсяС(ИмяНорм, "свод") Тогда
		Результат.Роль = РольСвод();
		Результат.Примечание = "свод направления — не грузится (задвоил бы объектные листы)";
		Возврат Результат;
	КонецЕсли;

	Если СтрНачинаетсяС(ИмяНорм, "цо") И СтрНайти(" _-", Сред(ИмяНорм + " ", 3, 1)) > 0 Тогда

		ИмяКорня = НормализоватьИмя(СтрЗаменить(СтрЗаменить(Сред(ИмяНорм, 3), "_", " "), "-", " "));
		Если НЕ ЗначениеЗаполнено(ИмяКорня) Тогда
			Результат.Примечание = "ЦО без направления в имени листа — не грузится";
			Возврат Результат;
		КонецЕсли;

		Корень = ИндексПодр.Корни.Получить(ИмяКорня);
		Если Корень = Неопределено Тогда
			Результат.Примечание = "ЦО: корневое подразделение «" + ИмяКорня + "» не найдено — требует уточнения";
			Возврат Результат;
		КонецЕсли;

		Результат.Роль = РольЦО();
		Результат.Подразделение = Корень;
		Результат.Загружать = Истина;
		Результат.Примечание = "ЦО направления (затраты самого корня)";
		Возврат ПроверитьКорень(Результат, ИндексПодр);

	КонецЕсли;

	КодЯвного = ЯвныеСоответствияЛистов().Получить(ИмяНорм);
	Если КодЯвного <> Неопределено Тогда

		ПодразделениеЯвное = ПодразделениеПоКоду(КодЯвного);
		Если НЕ ЗначениеЗаполнено(ПодразделениеЯвное) Тогда
			Результат.Примечание = "явное соответствие: подразделения с кодом " + КодЯвного
				+ " нет в базе — требует уточнения";
			Возврат Результат;
		КонецЕсли;

		Результат.Роль = РольОбъект();
		Результат.Подразделение = ПодразделениеЯвное;
		Результат.Загружать = Истина;
		Результат.Примечание = "подразделение по явному соответствию (код " + КодЯвного + ")";
		Возврат ПроверитьКорень(Результат, ИндексПодр);

	КонецЕсли;

	Запись = Карта.Получить(ИмяНорм);
	Если Запись <> Неопределено Тогда

		Если Запись.ОтчетПоНаправлению ИЛИ НЕ ЗначениеЗаполнено(Запись.Подразделение) Тогда
			Результат.Роль = РольСвод();
			Результат.Примечание = "свод по регистру выгрузки PL — не грузится";
			Возврат Результат;
		КонецЕсли;

		Результат.Роль = ?(Запись.ТолькоЭтоПодразделение, РольЦО(), РольОбъект());
		Результат.Подразделение = Запись.Подразделение;
		Результат.Загружать = Истина;
		Результат.Примечание = "подразделение из регистра выгрузки PL";
		Возврат ПроверитьКорень(Результат, ИндексПодр);

	КонецЕсли;

	Подбор = ПодобратьПодразделение(ИмяЛиста, ИндексПодр);
	Если НЕ ЗначениеЗаполнено(Подбор.Подразделение) Тогда
		Результат.Примечание = "подразделение не найдено — укажите вручную и поставьте галку «Грузить»";
		Возврат Результат;
	КонецЕсли;

	Результат.Роль = РольОбъект();
	Результат.Подразделение = Подбор.Подразделение;
	Результат.Загружать = Истина;
	Результат.Примечание = "подразделение подобрано по имени"
		+ ?(Подбор.Нестрого, " НЕСТРОГО — проверьте", "");

	Возврат ПроверитьКорень(Результат, ИндексПодр);

КонецФункции

Функция ПроверитьКорень(Результат, ИндексПодр)

	Если ИндексПодр.ПодКорнем <> Неопределено
		И ИндексПодр.ПодКорнем.Получить(Результат.Подразделение) = Неопределено Тогда
		Результат.Загружать = Ложь;
		Результат.Примечание = Результат.Примечание + "; НЕ под корнем «"
			+ Строка(ЭтотОбъект.КореньНаправления) + "» — не грузится";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Кэш РАБОЧИХ статей ДДС: Строгий и БезПунктуации (нормализованное имя -> ссылка),
// Неоднозначные / НеоднозначныеБП (имя -> Истина), Типы (ссылка -> А_ТипПоказателя).
// Ветка «!!! НЕ ИСПОЛЬЗОВАТЬ !!!» (УТ-000965) исключается обязательно: в ней 209 статей-дублей,
// среди них «Поступление от заказчика» с тремя кодами.
Функция КэшСтатей()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СТ.Ссылка КАК СтатьяСсылка,
	|	СТ.Наименование КАК Наименование,
	|	СТ.А_ТипПоказателя КАК ТипПоказателя
	|ИЗ
	|	Справочник.СтатьиДвиженияДенежныхСредств КАК СТ
	|ГДЕ
	|	НЕ СТ.ЭтоГруппа
	|	И НЕ СТ.ПометкаУдаления
	|	И НЕ СТ.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				Г.Ссылка
	|			ИЗ
	|				Справочник.СтатьиДвиженияДенежныхСредств КАК Г
	|			ГДЕ
	|				Г.Код = &КодЗапретнойВетки)";
	Запрос.УстановитьПараметр("КодЗапретнойВетки", "УТ-000965");

	Кэш = Новый Структура("Строгий, БезПунктуации, Неоднозначные, НеоднозначныеБП, Типы",
		Новый Соответствие, Новый Соответствие, Новый Соответствие, Новый Соответствие, Новый Соответствие);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Ключ = НормализоватьИмя(Выборка.Наименование);
		Если НЕ ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;

		Если Кэш.Строгий.Получить(Ключ) = Неопределено Тогда
			Кэш.Строгий.Вставить(Ключ, Выборка.СтатьяСсылка);
		Иначе
			Кэш.Неоднозначные.Вставить(Ключ, Истина);
		КонецЕсли;

		КлючБП = НормаБезПунктуации(Выборка.Наименование);
		Если Кэш.БезПунктуации.Получить(КлючБП) = Неопределено Тогда
			Кэш.БезПунктуации.Вставить(КлючБП, Выборка.СтатьяСсылка);
		ИначеЕсли Кэш.БезПунктуации.Получить(КлючБП) <> Выборка.СтатьяСсылка Тогда
			Кэш.НеоднозначныеБП.Вставить(КлючБП, Истина);
		КонецЕсли;

		Кэш.Типы.Вставить(Выборка.СтатьяСсылка, Выборка.ТипПоказателя);

	КонецЦикла;

	Возврат Кэш;

КонецФункции

// Статья по имени строки книги: строго, затем без пунктуации. Возвращает Структуру
// "Статья, Нестрого, Неоднозначно"; неоднозначное имя статью НЕ получает.
Функция НайтиСтатью(Знач Имя, Кэш)

	Результат = Новый Структура("Статья, Нестрого, Неоднозначно",
		Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка(), Ложь, Ложь);

	Ключ = НормализоватьИмя(Имя);
	Если Кэш.Неоднозначные.Получить(Ключ) <> Неопределено Тогда
		Результат.Неоднозначно = Истина;
		Возврат Результат;
	КонецЕсли;

	Найденная = Кэш.Строгий.Получить(Ключ);
	Если Найденная <> Неопределено Тогда
		Результат.Статья = Найденная;
		Возврат Результат;
	КонецЕсли;

	КлючБП = НормаБезПунктуации(Имя);
	Если Кэш.НеоднозначныеБП.Получить(КлючБП) <> Неопределено Тогда
		Результат.Неоднозначно = Истина;
		Возврат Результат;
	КонецЕсли;

	Найденная = Кэш.БезПунктуации.Получить(КлючБП);
	Если Найденная <> Неопределено Тогда
		Результат.Статья = Найденная;
		Результат.Нестрого = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Служебный хвост листа: с этой строки идут остатки, Free CF, сальдо — не бюджет.
Функция ЭтоХвост(Знач ИмяНорм)

	Маркеры = "переходящ,free cf,fcf,сальдо,cf за,баланс по объекту";
	Для Каждого Маркер Из СтрРазделить(Маркеры, ",", Ложь) Цикл
		Если СтрНачинаетсяС(ИмяНорм, Маркер) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СуммаЗначенийСтроки(Значения)

	Сумма = 0;
	Для Каждого Значение Из Значения Цикл
		Сумма = Сумма + Значение.Безнал + Значение.Нал;
	КонецЦикла;

	Возврат Сумма;

КонецФункции

Процедура ДобавитьОтсечение(Итог, Знач Причина, СтрокаКниги, Знач Сумма)

	Итог.Отсечено.Добавить(Причина + ": строка " + СтрокаКниги.Ряд + " «" + Лев(СтрокаКниги.Имя, 60)
		+ "» на " + Формат(Сумма, "ЧДЦ=2; ЧРГ=' '"));

КонецПроцедуры

Процедура ДобавитьСтрокуТаблицы(Таблица, Знач Месяц, Знач Статья, Знач ВидОплаты, Знач Сумма)

	Сумма = Окр(Сумма, 2);
	Если Сумма = 0 Тогда
		Возврат;
	КонецЕсли;

	СтрокаТаблицы = Таблица.Добавить();
	СтрокаТаблицы.Месяц = НачалоМесяца(Месяц);
	СтрокаТаблицы.СтатьяДДС = Статья;
	СтрокаТаблицы.ВидОплаты = ВидОплаты;
	СтрокаТаблицы.Сумма = Сумма;

КонецПроцедуры

// Свёрнутая таблица "Месяц, СтатьяДДС, ВидОплаты, Сумма" по строкам одного листа.
//
// Берутся ТОЛЬКО строки уровня статьи (см. УровеньСтатьиExcel) до служебного хвоста.
// Разделы и группы не грузятся: их сумма уже стоит на статьях, загрузка задвоила бы.
// Сторона листа проверяется типом статьи: строка ВЫШЕ «СПИСАНИЕ» — приход, ниже — расход;
// статья с противоположным А_ТипПоказателя не грузится и уходит в Отсечено.
Функция СобратьТаблицуБюджета(СтрокиЛиста, Итог) Экспорт

	Кэш = КэшСтатей();
	ТипПриход = Перечисления.ТипыЗначенийПоказателейБюджетногоОтчета.Приход;
	ТипРасход = Перечисления.ТипыЗначенийПоказателейБюджетногоОтчета.Расход;
	ВидБезнал = Перечисления.ТипыДенежныхСредств.Безналичные;
	ВидНал = Перечисления.ТипыДенежныхСредств.Наличные;

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Месяц", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("СтатьяДДС",
		Новый ОписаниеТипов("СправочникСсылка.СтатьиДвиженияДенежныхСредств"));
	Таблица.Колонки.Добавить("ВидОплаты",
		Новый ОписаниеТипов("ПеречислениеСсылка.ТипыДенежныхСредств"));
	Таблица.Колонки.Добавить("Сумма",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	НеНайденные = Новый Соответствие;
	Нестрогие = Новый Соответствие;
	РядСписания = 0;
	ХвостНачат = Ложь;

	Для Каждого СтрокаКниги Из СтрокиЛиста Цикл

		ИмяНорм = НормализоватьИмя(СтрокаКниги.Имя);
		СуммаСтроки = СуммаЗначенийСтроки(СтрокаКниги.Значения);

		Если НЕ ХвостНачат И ЗначениеЗаполнено(ИмяНорм) И ЭтоХвост(ИмяНорм) Тогда
			ХвостНачат = Истина;
			Итог.ХвостСоСтроки = СтрокаКниги.Ряд;
		КонецЕсли;

		Если ХвостНачат Тогда
			Если СуммаСтроки <> 0 И СтрокаКниги.Уровень = УровеньСтатьиExcel() Тогда
				ДобавитьОтсечение(Итог, "хвост листа", СтрокаКниги, СуммаСтроки);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если РядСписания = 0 И ИмяНорм = "списание" Тогда
			РядСписания = СтрокаКниги.Ряд;
		КонецЕсли;

		Если СтрокаКниги.Уровень <> УровеньСтатьиExcel() ИЛИ СуммаСтроки = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(ИмяНорм) Тогда
			ДобавитьОтсечение(Итог, "строка-статья без имени", СтрокаКниги, СуммаСтроки);
			Продолжить;
		КонецЕсли;

		Найденная = НайтиСтатью(СтрокаКниги.Имя, Кэш);

		Если Найденная.Неоднозначно Тогда
			ДобавитьОтсечение(Итог, "статья неоднозначна (несколько рабочих статей с таким именем)",
				СтрокаКниги, СуммаСтроки);
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Найденная.Статья) Тогда
			Накоплено = НеНайденные.Получить(СокрЛП(СтрокаКниги.Имя));
			НеНайденные.Вставить(СокрЛП(СтрокаКниги.Имя), ?(Накоплено = Неопределено, 0, Накоплено) + СуммаСтроки);
			Продолжить;
		КонецЕсли;

		ТипСтатьи = Кэш.Типы.Получить(Найденная.Статья);
		СторонаПриход = (РядСписания = 0 ИЛИ СтрокаКниги.Ряд < РядСписания);
		Если (СторонаПриход И ТипСтатьи = ТипРасход) ИЛИ (НЕ СторонаПриход И ТипСтатьи = ТипПриход) Тогда
			ДобавитьОтсечение(Итог, "сторона листа (" + ?(СторонаПриход, "поступления", "списание")
				+ ") не совпала с типом статьи «" + Строка(Найденная.Статья) + "»", СтрокаКниги, СуммаСтроки);
			Продолжить;
		КонецЕсли;

		Если Найденная.Нестрого Тогда
			Нестрогие.Вставить("«" + СокрЛП(СтрокаКниги.Имя) + "» -> «" + Строка(Найденная.Статья) + "»", Истина);
		КонецЕсли;

		Для Каждого Значение Из СтрокаКниги.Значения Цикл
			ДобавитьСтрокуТаблицы(Таблица, Значение.Месяц, Найденная.Статья, ВидБезнал, Значение.Безнал);
			ДобавитьСтрокуТаблицы(Таблица, Значение.Месяц, Найденная.Статья, ВидНал, Значение.Нал);
		КонецЦикла;

	КонецЦикла;

	Таблица.Свернуть("Месяц, СтатьяДДС, ВидОплаты", "Сумма");

	Сч = Таблица.Количество() - 1;
	Пока Сч >= 0 Цикл
		Если Таблица[Сч].Сумма = 0 Тогда
			Таблица.Удалить(Сч);
		КонецЕсли;
		Сч = Сч - 1;
	КонецЦикла;

	Таблица.Сортировать("Месяц, СтатьяДДС, ВидОплаты");

	Для Каждого КлючИЗначение Из НеНайденные Цикл
		Итог.НеНайденныеСтатьи.Добавить("«" + КлючИЗначение.Ключ + "» на "
			+ Формат(КлючИЗначение.Значение, "ЧДЦ=2; ЧРГ=' '"));
	КонецЦикла;
	Для Каждого КлючИЗначение Из Нестрогие Цикл
		Итог.НестрогиеСтатьи.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Месяцы таблицы в порядке возрастания (таблица уже отсортирована по месяцу).
Функция МесяцыТаблицы(ТаблицаБюджета)

	Уникальные = Новый Соответствие;
	Месяцы = Новый Массив;

	Для Каждого СтрокаТаблицы Из ТаблицаБюджета Цикл
		Месяц = НачалоМесяца(СтрокаТаблицы.Месяц);
		Если Уникальные.Получить(Месяц) = Неопределено Тогда
			Уникальные.Вставить(Месяц, Истина);
			Месяцы.Добавить(Месяц);
		КонецЕсли;
	КонецЦикла;

	Возврат Месяцы;

КонецФункции

// Направление подразделения из реквизита А_НаправлениеДеятельности; если у объекта пусто
// (например, «МК Подгорцы») — направление корня.
Функция НаправлениеПодразделения(Знач Подразделение)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.А_НаправлениеДеятельности КАК Направление
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК П
	|ГДЕ
	|	П.Ссылка = &Подразделение";
	Запрос.УстановитьПараметр("Подразделение", Подразделение);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Направление) Тогда
		Возврат Выборка.Направление;
	КонецЕсли;

	Если ЗначениеЗаполнено(ЭтотОбъект.КореньНаправления) И ЭтотОбъект.КореньНаправления <> Подразделение Тогда
		Возврат НаправлениеПодразделения(ЭтотОбъект.КореньНаправления);
	КонецЕсли;

	Возврат Справочники.НаправленияДеятельности.ПустаяСсылка();

КонецФункции

// Пишет строки ОДНОГО месяца листа в отдельный документ — в транзакции, с контролем записанного.
// Расхождение записанного с ожидаемым — исключение, транзакция откатывается: битая загрузка
// не фиксируется. Сбой одного месяца не отменяет остальные: ошибка ложится в запись месяца.
Процедура ЗагрузитьМесяцЛиста(Знач Месяц, ТаблицаБюджета, ПодразделениеЛиста, ИмяЛиста, ИмяФайла, Итог)

	СтрокиМесяца = ТаблицаБюджета.НайтиСтроки(Новый Структура("Месяц", Месяц));

	ЗаписьДокумента = Новый Структура("Месяц, Документ, Строк, Сумма, Создан, Проведен, Ошибка",
		Месяц, "", СтрокиМесяца.Количество(), 0, Ложь, Ложь, "");
	Итог.Документы.Добавить(ЗаписьДокумента);

	НачатьТранзакцию();
	Попытка

		РезультатПоиска = ПолучитьИлиСоздатьДокумент(ПодразделениеЛиста, Месяц);
		ДокОбъект = РезультатПоиска.ДокОбъект;

		ДокОбъект.Подразделение = ПодразделениеЛиста;
		ДокОбъект.Сценарий = ЭтотОбъект.Сценарий;
		Если НЕ ЗначениеЗаполнено(ДокОбъект.Направление) Тогда
			ДокОбъект.Направление = НаправлениеПодразделения(ПодразделениеЛиста);
		КонецЕсли;
		ДокОбъект.Ответственный = Пользователи.ТекущийПользователь();
		ДокОбъект.Комментарий = "Бюджет экономиста из файла """ + ИмяФайла + """, лист """ + ИмяЛиста
			+ """, месяц " + Формат(Месяц, "ДФ='MM.yyyy'");

		// Файл главнее: ТЧ перезаполняется ЦЕЛИКОМ, иначе повторная загрузка задвоила бы строки.
		// ГрафикДомов не трогаем — он питает расчётный движок, а не загрузку.
		ДокОбъект.ПоказателиБДДС.Очистить();

		ИсточникСтрок = ИсточникЗагрузки();
		ОжидаемоСтрок = 0;
		ОжидаемоСумма = 0;
		Для Каждого СтрокаТаблицы Из СтрокиМесяца Цикл
			СтрокаТЧ = ДокОбъект.ПоказателиБДДС.Добавить();
			СтрокаТЧ.Месяц = НачалоМесяца(СтрокаТаблицы.Месяц);
			СтрокаТЧ.СтатьяДДС = СтрокаТаблицы.СтатьяДДС;
			СтрокаТЧ.ВидОплаты = СтрокаТаблицы.ВидОплаты;
			СтрокаТЧ.Сумма = СтрокаТаблицы.Сумма;
			СтрокаТЧ.Источник = ИсточникСтрок;
			ОжидаемоСтрок = ОжидаемоСтрок + 1;
			ОжидаемоСумма = ОжидаемоСумма + СтрокаТаблицы.Сумма;
		КонецЦикла;

		Если ЭтотОбъект.ПроводитьДокументы Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			ЗаписьДокумента.Проведен = Истина;
		ИначеЕсли ДокОбъект.Проведен Тогда
			// Иначе документ остался бы проведённым со старыми движениями.
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Иначе
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		ПроверитьЗаписанное(ДокОбъект.Ссылка, ОжидаемоСтрок, ОжидаемоСумма, ЗаписьДокумента.Проведен);

		// ЗафиксироватьТранзакцию — ПОСЛЕДНИЙ оператор в Попытка: исключение после фиксации
		// позвало бы ОтменитьТранзакцию вне транзакции.
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЗаписьДокумента.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("А_ЗагрузкаБюджетаПроизводства.Ошибка",
			УровеньЖурналаРегистрации.Ошибка, , ИмяЛиста + " " + Формат(Месяц, "ДФ='MM.yyyy'"),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ЗаписьДокумента.Документ = Строка(ДокОбъект.Ссылка);
	ЗаписьДокумента.Строк = ОжидаемоСтрок;
	ЗаписьДокумента.Сумма = ОжидаемоСумма;
	ЗаписьДокумента.Создан = РезультатПоиска.Создан;

	Если РезультатПоиска.Создан Тогда
		Итог.Создано = Итог.Создано + 1;
	Иначе
		Итог.Обновлено = Итог.Обновлено + 1;
	КонецЕсли;
	Если ЗаписьДокумента.Проведен Тогда
		Итог.Проведено = Итог.Проведено + 1;
	КонецЕсли;
	Итог.СтрокЗагружено = Итог.СтрокЗагружено + ОжидаемоСтрок;
	Итог.СуммаЗагружено = Итог.СуммаЗагружено + ОжидаемоСумма;

КонецПроцедуры

// Контроль после записи: строки и сумма ТЧ в базе, а при проведении — и движения регистра
// по этому регистратору. Расхождение — исключение, внешний обработчик откатит транзакцию.
Процедура ПроверитьЗаписанное(ДокСсылка, Знач ОжидаемоСтрок, Знач ОжидаемоСумма, Знач Проведен)

	Расхождения = "";

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Т.НомерСтроки) КАК Строк,
	|	СУММА(Т.Сумма) КАК Сумма
	|ИЗ
	|	Документ.А_ПредварительныйБюджет.ПоказателиБДДС КАК Т
	|ГДЕ
	|	Т.Ссылка = &Документ";
	Запрос.УстановитьПараметр("Документ", ДокСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	СтрокБазы = ?(Выборка.Строк = NULL, 0, Выборка.Строк);
	СуммаБазы = ?(Выборка.Сумма = NULL, 0, Выборка.Сумма);

	Если СтрокБазы <> ОжидаемоСтрок Тогда
		Расхождения = Расхождения + Символы.ПС + "строк ТЧ: ожидание=" + ОжидаемоСтрок + ", база=" + СтрокБазы;
	КонецЕсли;
	Отклонение = СуммаБазы - ОжидаемоСумма;
	Если Макс(Отклонение, -Отклонение) > 0.005 Тогда
		Расхождения = Расхождения + Символы.ПС + "сумма ТЧ: ожидание=" + ОжидаемоСумма + ", база=" + СуммаБазы;
	КонецЕсли;

	Если Проведен Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Записей,
		|	СУММА(Р.Сумма) КАК Сумма
		|ИЗ
		|	РегистрНакопления.А_ПредварительныйБюджетНаМесяц КАК Р
		|ГДЕ
		|	Р.Регистратор = &Документ";
		Запрос.УстановитьПараметр("Документ", ДокСсылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		ЗаписейБазы = ?(Выборка.Записей = NULL, 0, Выборка.Записей);
		СуммаРегистра = ?(Выборка.Сумма = NULL, 0, Выборка.Сумма);
		// Нулевых строк в ТЧ нет (отсеяны при сборке), поэтому движений ровно столько же, сколько строк.
		Если ЗаписейБазы <> ОжидаемоСтрок Тогда
			Расхождения = Расхождения + Символы.ПС + "движений регистра: ожидание=" + ОжидаемоСтрок + ", база=" + ЗаписейБазы;
		КонецЕсли;
		Отклонение = СуммаРегистра - ОжидаемоСумма;
		Если Макс(Отклонение, -Отклонение) > 0.005 Тогда
			Расхождения = Расхождения + Символы.ПС + "сумма регистра: ожидание=" + ОжидаемоСумма + ", база=" + СуммаРегистра;
		КонецЕсли;
	КонецЕсли;

	Если НЕ ПустаяСтрока(Расхождения) Тогда
		ВызватьИсключение "КОНТРОЛЬ ЗАПИСАННОГО НЕ ПРОЙДЕН:" + Расхождения;
	КонецЕсли;

КонецПроцедуры

// Ключ документа — Сценарий x Подразделение x МЕСЯЦ среди непомеченных.
// Месяц документа опознаётся по его дате (первое число, 12:00, см. ДатаДокументаМесяца),
// поэтому ищем по попаданию даты в месяц, а найденному дату выравниваем.
// Документы не плодим и не удаляем: найденный переиспользуем.
Функция ПолучитьИлиСоздатьДокумент(ПодразделениеЛиста, Знач Месяц)

	Результат = Новый Структура("ДокОбъект, Создан", Неопределено, Ложь);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Д.Ссылка КАК ДокументСсылка
	|ИЗ
	|	Документ.А_ПредварительныйБюджет КАК Д
	|ГДЕ
	|	Д.Сценарий = &Сценарий
	|	И Д.Подразделение = &Подразделение
	|	И Д.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
	|	И НЕ Д.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Д.Дата";
	Запрос.УстановитьПараметр("Сценарий", ЭтотОбъект.Сценарий);
	Запрос.УстановитьПараметр("Подразделение", ПодразделениеЛиста);
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(Месяц));
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца(Месяц));

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Результат.ДокОбъект = Выборка.ДокументСсылка.ПолучитьОбъект();
	Иначе
		Результат.ДокОбъект = Документы.А_ПредварительныйБюджет.СоздатьДокумент();
		Результат.ДокОбъект.Заполнить(Неопределено);
		Результат.Создан = Истина;
	КонецЕсли;

	Результат.ДокОбъект.Дата = ДатаДокументаМесяца(Месяц);

	Возврат Результат;

КонецФункции

#КонецОбласти
