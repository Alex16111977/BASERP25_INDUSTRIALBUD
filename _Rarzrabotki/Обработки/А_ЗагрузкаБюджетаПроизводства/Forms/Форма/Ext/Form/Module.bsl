// Форма обработки «Загрузка бюджета производства из Excel».
//
// Разделение ролей: здесь только ввод-вывод (COM Excel живёт на клиенте),
// вся семантика — роль листа, уровни строк, статьи, запись документов —
// в модуле объекта. Оба действия используют один разбор РазобратьЛист,
// чтобы «Прочитать файл» и «Загрузить» не разъезжались.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Объект.ПутьКФайлу) Тогда
		Объект.ПутьКФайлу =
			"C:\Configuration_downloads\BASERP25\_Rarzrabotki\Бюджет прогноз\Отчеты высланные\ДДС Производство Вересень - Грудень 2026 Прогноз.xlsx";
	КонецЕсли;

	Объект.ПроводитьДокументы = Истина;

	Если НЕ ЗначениеЗаполнено(Объект.Сценарий) Тогда
		Объект.Сценарий = Справочники.Сценарии.НайтиПоНаименованию("Бюджет экономиста ДДС", Истина);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.КореньНаправления) Тогда
		Объект.КореньНаправления = Справочники.СтруктураПредприятия.НайтиПоКоду("0Ц-000004");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите книгу бюджета ДДС";
	Диалог.Фильтр = "Книга Excel (*.xlsx)|*.xlsx|Все файлы (*.*)|*.*";
	Диалог.ПолноеИмяФайла = Объект.ПутьКФайлу;

	Если Диалог.Выбрать() Тогда
		Объект.ПутьКФайлу = Диалог.ПолноеИмяФайла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрочитатьФайлКоманда(Команда)

	Если НЕ ПроверитьПутьКФайлу() Тогда
		Возврат;
	КонецЕсли;

	Протокол = Новый Массив;
	ДанныеЛистов = Новый Массив;
	КонтекстExcel = Неопределено;

	Попытка
		КонтекстExcel = ОткрытьКнигу(Объект.ПутьКФайлу);

		Для НомерЛиста = 1 По КонтекстExcel.Книга.Sheets.Count Цикл

			Лист = КонтекстExcel.Книга.Sheets(НомерЛиста);

			// Скрытые листы разбираем наравне с видимыми: скрытость — только пометка,
			// роль листа определяет модуль объекта по имени и содержимому.
			РазобранныйЛист = РазобратьЛист(Лист);

			ДанныеЛиста = Новый Структура("ИмяЛиста, Скрыт, Месяцев, СтрокСДанными, Замечание");
			ДанныеЛиста.ИмяЛиста = Строка(Лист.Name);
			ДанныеЛиста.Скрыт = (Лист.Visible <> -1);
			ДанныеЛиста.Месяцев = РазобранныйЛист.Блоки.Количество();
			ДанныеЛиста.СтрокСДанными = РазобранныйЛист.СтрокСДанными;
			ДанныеЛиста.Замечание = РазобранныйЛист.Замечание;
			ДанныеЛистов.Добавить(ДанныеЛиста);

		КонецЦикла;

	Исключение
		Протокол.Добавить("ОШИБКА чтения книги: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗакрытьКнигу(КонтекстExcel);

	Если ДанныеЛистов.Количество() > 0 Тогда
		ЗаполнитьЛистыНаСервере(ДанныеЛистов);
		Протокол.Добавить("Прочитано листов: " + ДанныеЛистов.Количество()
			+ ", отмечено к загрузке: " + КоличествоОтмеченных());
		Протокол.Добавить("Проверьте роли и подразделения, снимите лишние галки, затем «Загрузить».");
		ДобавитьПропущенные(Протокол);
	КонецЕсли;

	Результат = СтрСоединить(Протокол, Символы.ПС);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКоманда(Команда)

	Если НЕ ПроверитьПутьКФайлу() Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Сценарий) Тогда
		ПоказатьПредупреждение(, "Не заполнен сценарий.");
		Возврат;
	КонецЕсли;

	Если Объект.Листы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Сначала нажмите «Прочитать файл».");
		Возврат;
	КонецЕсли;

	ИмяФайла = ИмяФайлаИзПути(Объект.ПутьКФайлу);

	Протокол = Новый Массив;
	КонтекстExcel = Неопределено;
	ВсегоСоздано = 0;
	ВсегоОбновлено = 0;
	ВсегоСтрок = 0;
	ВсегоСумма = 0;
	ВсегоОшибок = 0;
	НеНайденныеСтатьи = Новый Массив;
	НестрогиеСтатьи = Новый Массив;
	Отсечено = Новый Массив;
	БезПодразделения = Новый Массив;

	Попытка
		КонтекстExcel = ОткрытьКнигу(Объект.ПутьКФайлу);

		Для Каждого СтрокаЛистов Из Объект.Листы Цикл

			Если НЕ СтрокаЛистов.Загружать Тогда
				Продолжить;
			КонецЕсли;

			Если НЕ ЗначениеЗаполнено(СтрокаЛистов.Подразделение) Тогда
				БезПодразделения.Добавить(СтрокаЛистов.ИмяЛиста);
				Продолжить;
			КонецЕсли;

			Лист = КонтекстExcel.Книга.Sheets(СтрокаЛистов.ИмяЛиста);
			РазобранныйЛист = РазобратьЛист(Лист);

			Итог = ЗагрузитьЛистНаСервере(СтрокаЛистов.ИмяЛиста, СтрокаЛистов.Подразделение,
				РазобранныйЛист.Строки, ИмяФайла);

			Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
				ВсегоОшибок = ВсегоОшибок + 1;
				Протокол.Добавить("ОШИБКА «" + СтрокаЛистов.ИмяЛиста + "»: " + Итог.Ошибка);
				Продолжить;
			КонецЕсли;

			ВсегоСоздано = ВсегоСоздано + Итог.Создано;
			ВсегоОбновлено = ВсегоОбновлено + Итог.Обновлено;
			ВсегоСтрок = ВсегоСтрок + Итог.СтрокЗагружено;
			ВсегоСумма = ВсегоСумма + Итог.СуммаЗагружено;

			Если Итог.Документы.Количество() = 0 Тогда
				Протокол.Добавить("пусто     " + СтрокаЛистов.ИмяЛиста
					+ ": ни одного месяца с суммами — документы не создавались");
			КонецЕсли;

			// Один документ на месяц: по строке протокола на каждый.
			Для Каждого ЗаписьДокумента Из Итог.Документы Цикл

				ПодписьМесяца = Формат(ЗаписьДокумента.Месяц, "ДФ='MM.yyyy'");

				Если ЗначениеЗаполнено(ЗаписьДокумента.Ошибка) Тогда
					ВсегоОшибок = ВсегоОшибок + 1;
					Протокол.Добавить("ОШИБКА «" + СтрокаЛистов.ИмяЛиста + "» " + ПодписьМесяца
						+ ": " + ЗаписьДокумента.Ошибка);
					Продолжить;
				КонецЕсли;

				Протокол.Добавить(?(ЗаписьДокумента.Создан, "создан  ", "обновлён") + "  "
					+ СтрокаЛистов.ИмяЛиста + " " + ПодписьМесяца
					+ ": строк " + ЗаписьДокумента.Строк
					+ ", сумма " + Формат(ЗаписьДокумента.Сумма, "ЧДЦ=2; ЧРГ=' '")
					+ ?(ЗаписьДокумента.Проведен, ", проведён", ", не проводился")
					+ " -> " + ЗаписьДокумента.Документ);

			КонецЦикла;

			ДобавитьУникальные(НеНайденныеСтатьи, Итог.НеНайденныеСтатьи, СтрокаЛистов.ИмяЛиста);
			ДобавитьУникальные(НестрогиеСтатьи, Итог.НестрогиеСтатьи, "");
			ДобавитьУникальные(Отсечено, Итог.Отсечено, СтрокаЛистов.ИмяЛиста);

		КонецЦикла;

	Исключение
		ВсегоОшибок = ВсегоОшибок + 1;
		Протокол.Добавить("ОШИБКА загрузки: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗакрытьКнигу(КонтекстExcel);

	Заголовок = Новый Массив;
	Заголовок.Добавить("Создано документов: " + ВсегоСоздано
		+ ", обновлено: " + ВсегоОбновлено
		+ ", строк загружено: " + ВсегоСтрок
		+ ", сумма: " + Формат(ВсегоСумма, "ЧДЦ=2; ЧРГ=' '")
		+ ", ошибок: " + ВсегоОшибок);

	Если БезПодразделения.Количество() > 0 Тогда
		Заголовок.Добавить("Пропущены без подразделения: " + СтрСоединить(БезПодразделения, ", "));
	КонецЕсли;

	ДобавитьПропущенные(Заголовок);

	Если НеНайденныеСтатьи.Количество() > 0 Тогда
		Заголовок.Добавить("");
		Заголовок.Добавить("СТАТЬИ НЕ НАЙДЕНЫ (в справочник НЕ создавались, суммы НЕ загружены):");
		Для Каждого Строка Из НеНайденныеСтатьи Цикл
			Заголовок.Добавить("  - " + Строка);
		КонецЦикла;
	КонецЕсли;

	Если Отсечено.Количество() > 0 Тогда
		Заголовок.Добавить("");
		Заголовок.Добавить("ОТСЕЧЕНО (не загружено):");
		Для Каждого Строка Из Отсечено Цикл
			Заголовок.Добавить("  - " + Строка);
		КонецЦикла;
	КонецЕсли;

	Если НестрогиеСтатьи.Количество() > 0 Тогда
		Заголовок.Добавить("");
		Заголовок.Добавить("Статьи сопоставлены без учёта пунктуации (проверьте): " + СтрСоединить(НестрогиеСтатьи, "; "));
	КонецЕсли;

	Заголовок.Добавить("");
	Для Каждого СтрокаПротокола Из Протокол Цикл
		Заголовок.Добавить(СтрокаПротокола);
	КонецЦикла;

	Результат = СтрСоединить(Заголовок, Символы.ПС);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьЛистыНаСервере(ДанныеЛистов)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ЗаполнитьТаблицуЛистов(ДанныеЛистов);
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");

КонецПроцедуры

&НаСервере
Функция ЗагрузитьЛистНаСервере(ИмяЛиста, ПодразделениеЛиста, СтрокиЛиста, ИмяФайла)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ЗагрузитьЛист(ИмяЛиста, ПодразделениеЛиста, СтрокиЛиста, ИмяФайла);

КонецФункции

&НаСервере
Функция БлокиМесяцевНаСервере(ЗначенияРядаДат, ЗначенияРядаПодписей)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.БлокиМесяцев(ЗначенияРядаДат, ЗначенияРядаПодписей);

КонецФункции

&НаКлиенте
Процедура ДобавитьУникальные(Приемник, Источник, Знач Префикс)

	Для Каждого Элемент Из Источник Цикл
		Текст = ?(ЗначениеЗаполнено(Префикс), Префикс + ": ", "") + Элемент;
		Если Приемник.Найти(Текст) = Неопределено Тогда
			Приемник.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Ни один лист не пропадает молча: каждый непогруженный лист называется с ролью и причиной.
&НаКлиенте
Процедура ДобавитьПропущенные(Протокол)

	Пропущенные = Новый Массив;

	Для Каждого СтрокаЛистов Из Объект.Листы Цикл
		Если СтрокаЛистов.Загружать Тогда
			Продолжить;
		КонецЕсли;
		Причина = ?(ЗначениеЗаполнено(СтрокаЛистов.Примечание),
			СтрокаЛистов.Примечание, "снята галка «Грузить»");
		Пропущенные.Добавить("  - " + СтрокаЛистов.ИмяЛиста + " [" + СтрокаЛистов.Роль + "]: " + Причина);
	КонецЦикла;

	Если Пропущенные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Протокол.Добавить("");
	Протокол.Добавить("ПРОПУЩЕНО листов: " + Пропущенные.Количество());
	Для Каждого СтрокаПропуска Из Пропущенные Цикл
		Протокол.Добавить(СтрокаПропуска);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция КоличествоОтмеченных()

	Количество = 0;
	Для Каждого СтрокаЛистов Из Объект.Листы Цикл
		Если СтрокаЛистов.Загружать Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Количество;

КонецФункции

&НаКлиенте
Функция ПроверитьПутьКФайлу()

	Если НЕ ЗначениеЗаполнено(Объект.ПутьКФайлу) Тогда
		ПоказатьПредупреждение(, "Не указан путь к книге бюджета.");
		Возврат Ложь;
	КонецЕсли;

	Файл = Новый Файл(Объект.ПутьКФайлу);
	Если НЕ Файл.Существует() Тогда
		ПоказатьПредупреждение(, "Файл не найден: " + Объект.ПутьКФайлу);
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ИмяФайлаИзПути(Знач Путь)

	Файл = Новый Файл(Путь);
	Возврат Файл.Имя;

КонецФункции

&НаКлиенте
Функция ОткрытьКнигу(Знач Путь)

	Ексель = Новый COMObject("Excel.Application");
	Ексель.Visible = Ложь;
	Ексель.DisplayAlerts = Ложь;
	// ReadOnly: книгу не трогаем, файл может быть открыт у экономиста.
	Книга = Ексель.Workbooks.Open(Путь, Ложь, Истина);

	Возврат Новый Структура("Ексель, Книга", Ексель, Книга);

КонецФункции

&НаКлиенте
Процедура ЗакрытьКнигу(КонтекстExcel)

	Если КонтекстExcel = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		КонтекстExcel.Книга.Close(Ложь);
	Исключение
	КонецПопытки;

	Попытка
		КонтекстExcel.Ексель.Quit();
	Исключение
	КонецПопытки;

КонецПроцедуры

// Разбор одного листа книги.
//
// Месячные блоки ищутся по ДАТАМ строки 3 и подписям строки 4 на КАЖДОМ листе заново
// (число блоков на листах разное; после последнего блока на IRC идёт блок домов).
// Решение, что считать блоком, принимает модуль объекта (БлокиМесяцев) — здесь только чтение.
// Уровень строки — Rows(N).OutlineLevel (группировка Excel): единственный надёжный признак
// статьи в этой книге; отступ и жирность не годятся.
//
// Возвращает структуру "Блоки, Строки, СтрокСДанными, Замечание"; Строки — массив структур
// "Ряд, Имя, Уровень, Значения" по всем строкам с 6-й, у которых есть имя или сумма,
// Значения — массив структур "Месяц, Безнал, Нал" только по ненулевым ячейкам.
&НаКлиенте
Функция РазобратьЛист(Лист)

	РазборЛиста = Новый Структура("Блоки, Строки, СтрокСДанными, Замечание",
		Новый Массив, Новый Массив, 0, "");

	ИспользуемаяОбласть = Лист.UsedRange;
	ПоследняяСтрока = ИспользуемаяОбласть.Row + ИспользуемаяОбласть.Rows.Count - 1;
	ПоследняяКолонка = ИспользуемаяОбласть.Column + ИспользуемаяОбласть.Columns.Count - 1;

	Если ПоследняяСтрока < 6 ИЛИ ПоследняяКолонка < 3 Тогда
		Возврат РазборЛиста;
	КонецЕсли;

	Разбор = БлокиМесяцевНаСервере(
		ЗначенияРяда(Лист, 3, ПоследняяКолонка),
		ЗначенияРяда(Лист, 4, ПоследняяКолонка));

	Если Разбор.Отброшено.Количество() > 0 Тогда
		Отброшенные = Новый Массив;
		Для Каждого Колонка Из Разбор.Отброшено Цикл
			Отброшенные.Добавить(Строка(Колонка));
		КонецЦикла;
		РазборЛиста.Замечание = "дата в строке 3 без подписей Безналичные/Наличные в колонках "
			+ СтрСоединить(Отброшенные, ", ") + " — блок пропущен";
	КонецЕсли;

	РазборЛиста.Блоки = Разбор.Блоки;
	Если Разбор.Блоки.Количество() = 0 Тогда
		// Лист без месячных блоков — служебный или иной разметки.
		Возврат РазборЛиста;
	КонецЕсли;

	Для НомерСтроки = 6 По ПоследняяСтрока Цикл

		Значения = Новый Массив;
		Для Каждого Блок Из Разбор.Блоки Цикл

			СуммаБезнал = ЧислоЯчейки(Лист.Cells(НомерСтроки, Блок.Колонка).Value);
			СуммаНал = ЧислоЯчейки(Лист.Cells(НомерСтроки, Блок.Колонка + 1).Value);

			Если СуммаБезнал = 0 И СуммаНал = 0 Тогда
				Продолжить;
			КонецЕсли;

			Значение = Новый Структура("Месяц, Безнал, Нал", Блок.Месяц, СуммаБезнал, СуммаНал);
			Значения.Добавить(Значение);

		КонецЦикла;

		ИмяСтроки = ИмяСтрокиЛиста(Лист, НомерСтроки);
		Если НЕ ЗначениеЗаполнено(ИмяСтроки) И Значения.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		СтрокаКниги = Новый Структура("Ряд, Имя, Уровень, Значения");
		СтрокаКниги.Ряд = НомерСтроки;
		СтрокаКниги.Имя = ИмяСтроки;
		СтрокаКниги.Уровень = ЧислоЯчейки(Лист.Rows(НомерСтроки).OutlineLevel);
		СтрокаКниги.Значения = Значения;
		РазборЛиста.Строки.Добавить(СтрокаКниги);

		Если Значения.Количество() > 0 Тогда
			РазборЛиста.СтрокСДанными = РазборЛиста.СтрокСДанными + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат РазборЛиста;

КонецФункции

// Значения одного ряда: Соответствие НомерКолонки -> значение (только даты и строки).
&НаКлиенте
Функция ЗначенияРяда(Лист, Знач НомерСтроки, Знач ПоследняяКолонка)

	ЗначенияРядаЛиста = Новый Соответствие;

	Для НомерКолонки = 1 По ПоследняяКолонка Цикл
		ЗначениеЯчейки = Лист.Cells(НомерСтроки, НомерКолонки).Value;
		Если ЗначениеЯчейки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ЗначениеЯчейки) = Тип("Дата") ИЛИ ТипЗнч(ЗначениеЯчейки) = Тип("Строка") Тогда
			ЗначенияРядаЛиста.Вставить(НомерКолонки, ЗначениеЯчейки);
		КонецЕсли;
	КонецЦикла;

	Возврат ЗначенияРядаЛиста;

КонецФункции

// Наименование строки: колонка A, с запасом по B и C.
&НаКлиенте
Функция ИмяСтрокиЛиста(Лист, Знач НомерСтроки)

	Для НомерКолонки = 1 По 3 Цикл
		Значение = Лист.Cells(НомерСтроки, НомерКолонки).Value;
		Если Значение <> Неопределено Тогда
			ТекстЗначения = СокрЛП(Строка(Значение));
			Если ЗначениеЗаполнено(ТекстЗначения) Тогда
				Возврат ТекстЗначения;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

&НаКлиенте
Функция ЧислоЯчейки(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") ИЛИ ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат 0;
	КонецЕсли;

	ТекстЗначения = СтрЗаменить(СокрЛП(Строка(Значение)), Символ(160), "");
	ТекстЗначения = СтрЗаменить(ТекстЗначения, " ", "");
	ТекстЗначения = СтрЗаменить(ТекстЗначения, ",", ".");

	Если НЕ ЗначениеЗаполнено(ТекстЗначения) Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Возврат Число(ТекстЗначения);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

#КонецОбласти
