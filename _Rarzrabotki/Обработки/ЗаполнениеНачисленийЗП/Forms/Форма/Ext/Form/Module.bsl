
&НаСервере
Процедура ЗаполнитьНачисленияНаСервере()

	// ================================================================================
	// КРОК 1: Валідація вхідних даних
	// ================================================================================
	Если НЕ ЗначениеЗаполнено(Объект.ДокНачислениеЗарплаты) Тогда
		ВызватьИсключение "Не вказано документ НачислениеЗарплаты!";
	КонецЕсли;

	// Отримання періоду з документа
	ДокРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Объект.ДокНачислениеЗарплаты, "МесяцНачисления, Организация");

	Если НЕ ЗначениеЗаполнено(ДокРеквизиты.МесяцНачисления) Тогда
		ВызватьИсключение "В документі не заповнено МесяцНачисления!";
	КонецЕсли;

	ПериодРегистрации = НачалоМесяца(ДокРеквизиты.МесяцНачисления);

	Сообщить("Період завантаження: " + Формат(ПериодРегистрации, "ДФ=MMMM yyyy"));

	// ================================================================================
	// КРОК 2: Отримання списку організацій з ERP (А_ВБалансе = Істина)
	// ================================================================================
	ЗапросОрганизаций = Новый Запрос;
	ЗапросОрганизаций.Текст =
	"ВЫБРАТЬ
	|	Организации.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.А_ВБалансе = ИСТИНА
	|	И Организации.КодПоЕДРПОУ <> """"";

	масКодПоЕДРПОУ = Новый Массив;
	ВыборкаОрганизаций = ЗапросОрганизаций.Выполнить().Выбрать();
	Пока ВыборкаОрганизаций.Следующий() Цикл
		масКодПоЕДРПОУ.Добавить(ВыборкаОрганизаций.КодПоЕДРПОУ);
	КонецЦикла;

	Если масКодПоЕДРПОУ.Количество() = 0 Тогда
		Сообщить("Немає організацій з флагом А_ВБалансе!");
		Возврат;
	КонецЕсли;

	Сообщить("Знайдено організацій в балансі: " + масКодПоЕДРПОУ.Количество());

	// ================================================================================
	// КРОК 3: COM-підключення до бази ЗУП
	// ================================================================================
	СтрокаПодключенияЗУП = А_ПодключенияБазСервер.СтрокаПодключения("zup_1");
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияЗУП));
		Сообщить("Підключення до бази ЗУП успішне");
	Исключение
		ВызватьИсключение "Помилка підключення до бази ЗУП (zup_1): " + ОписаниеОшибки();
	КонецПопытки;

	// ================================================================================
	// КРОК 4: Передача масиву організацій в контекст ЗУП
	// ================================================================================
	масКодПоЕДРПОУ_V83 = V83.NewObject("Массив");
	Для Каждого КодЕДРПОУ Из масКодПоЕДРПОУ Цикл
		масКодПоЕДРПОУ_V83.Добавить(КодЕДРПОУ);
	КонецЦикла;

	// ================================================================================
	// КРОК 5: Виконання запиту в базі ЗУП
	// ================================================================================

	
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Начисления.Сотрудник.Физлицо.КодПоДРФО КАК СотрудникИНН,
	|	СУММА(Начисления.Результат) КАК СуммаНачислено,
	|	Начисления.Сотрудник.Физлицо.Наименование КАК СотрудникНаименование,
	|	ВложенныйЗапрос.КодПоЕДРПОУ КАК КодОрганизации
	|ИЗ
	|	РегистрРасчета.ОсновныеНачисленияРаботниковОрганизаций КАК Начисления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			КодыОрганизацииСрезПоследних.Организация КАК Организация,
	|			КодыОрганизацииСрезПоследних.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|		ИЗ
	|			РегистрСведений.КодыОрганизации.СрезПоследних КАК КодыОрганизацииСрезПоследних) КАК ВложенныйЗапрос
	|		ПО Начисления.Организация = ВложенныйЗапрос.Организация
	|ГДЕ
	|	НАЧАЛОПЕРИОДА(Начисления.ПериодРегистрации, МЕСЯЦ) = &ПериодРегистрации
	|	И Начисления.ВидРасчета.Код <> ""00021""
	|	И Начисления.Результат <> 0
	|	И ВложенныйЗапрос.КодПоЕДРПОУ В(&масКодПоЕДРПОУ)
	|
	|СГРУППИРОВАТЬ ПО
	|	Начисления.Сотрудник.Физлицо.КодПоДРФО,
	|	Начисления.Сотрудник.Физлицо.Наименование,
	|	ВложенныйЗапрос.КодПоЕДРПОУ";

	
	Попытка
		Запрос = V83.NewObject("Запрос");
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ПериодРегистрации", ПериодРегистрации);
		Запрос.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);

		РезультатЗапроса = Запрос.Выполнить();
		ТЗДанные = РезультатЗапроса.Выгрузить();

		Сообщить("Отримано записів з ЗУП: " + ТЗДанные.Количество());
	Исключение
		V83 = Неопределено;
		V8 = Неопределено;
		ВызватьИсключение "Помилка виконання запиту в базі ЗУП: " + ОписаниеОшибки();
	КонецПопытки;

	// ================================================================================
	// КРОК 6: Серіалізація/десеріалізація даних через COM
	// ================================================================================
	Попытка
		стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗДанные);
	Исключение
		V83 = Неопределено;
		V8 = Неопределено;
		ВызватьИсключение "Помилка серіалізації даних: " + ОписаниеОшибки();
	КонецПопытки;

	// Відключення від бази ЗУП
	V83 = Неопределено;
	V8 = Неопределено;

	// Десеріалізація таблиці значень в поточній базі
	ТаблицаДанных = ЗначениеИзСтрокиВнутр(стр_ТЗ);

	// ================================================================================
	// КРОК 7: Заповнення ТЧ А_НачисленияБух
	// ================================================================================
	ДокОбъект = Объект.ДокНачислениеЗарплаты.ПолучитьОбъект();
	ДокОбъект.А_НачисленияБух.Очистить();

	СчетчикОшибок = 0;
	СчетчикЗагружено = 0;

	Для Каждого СтрокаТЗ Из ТаблицаДанных Цикл

		// Пошук ФизЛицо по ІНН (реквізит А_КодПоДРФО)
		ИННСотрудника = СокрЛП(СтрокаТЗ.СотрудникИНН);

		Если ПустаяСтрока(ИННСотрудника) Тогда
			СчетчикОшибок = СчетчикОшибок + 1;
			Сообщить("Порожній ІНН: " + СтрокаТЗ.СотрудникНаименование);
			Продолжить;
		КонецЕсли;

		ФизЛицо = Справочники.ФизическиеЛица.НайтиПоРеквизиту("КодПоДРФО", ИННСотрудника);

		Если НЕ ЗначениеЗаполнено(ФизЛицо) Тогда
			СчетчикОшибок = СчетчикОшибок + 1;
			Сообщить("Не знайдено ФизЛицо з ІНН: " + ИННСотрудника + " (" + СтрокаТЗ.СотрудникНаименование + ")");
			Продолжить;
		КонецЕсли;

		// Пошук Организации по КодПоЕДРПОУ
		КодОрг = СокрЛП(СтрокаТЗ.КодОрганизации);
		Организация = Справочники.Организации.НайтиПоРеквизиту("КодПоЕДРПОУ", КодОрг);

		// Додавання рядка в табличну частину А_НачисленияБух
		НоваяСтрока = ДокОбъект.А_НачисленияБух.Добавить();
		НоваяСтрока.ФизЛицо = ФизЛицо;
		НоваяСтрока.Сумма = СтрокаТЗ.СуммаНачислено;
		НоваяСтрока.ВидРасчета = "Оклад по днях";
		НоваяСтрока.КодВидРасчета = "00001";
		НоваяСтрока.Организация = Организация;

		СчетчикЗагружено = СчетчикЗагружено + 1;

	КонецЦикла;
	
	
	
	// ================================================================================
	// КРОК 8: Запис документа та виведення статистики
	// ================================================================================
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		Сообщить("Документ оновлено: " + Объект.ДокНачислениеЗарплаты);
	Исключение
		Сообщить("ПОМИЛКА запису документа: " + ОписаниеОшибки());
	КонецПопытки;

	Сообщить("===== РЕЗУЛЬТАТ ЗАВАНТАЖЕННЯ =====");
	Сообщить("Період: " + Формат(ПериодРегистрации, "ДФ=MMMM yyyy"));
	Сообщить("Завантажено рядків: " + СчетчикЗагружено);
	Если СчетчикОшибок > 0 Тогда
		Сообщить("Помилок зіставлення: " + СчетчикОшибок);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНачисления(Команда)
	ЗаполнитьНачисленияНаСервере();
КонецПроцедуры
