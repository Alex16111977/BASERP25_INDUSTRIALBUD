////////////////////////////////////////////////////////////////////////////////
// Обробка: Заповнити СписаниеЗатратНаВыпуск по ПроизводствоБезЗаказа
// Призначення: Створює документ "СписаниеЗатратНаВыпуск" з матеріалами
//              з регістра "МатериалыИРаботыВПроизводстве" для обраного документа
//              "ПроизводствоБезЗаказа"
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиКоманд

&НаКлиенте
Процедура СоздатьДокументСписаниеЗатратНаВыпуск(Команда)

	// Валідація вибору документа
	Если НЕ ЗначениеЗаполнено(Объект.ДокПроизводствоБезЗаказа) Тогда
		ПоказатьПредупреждение(, "Виберіть документ ""Виробництво без замовлення""!");
		Возврат;
	КонецЕсли;

	// Підтвердження дії
	ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьСписаниеЗатратЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения,
		"Створити документ(и) ""Списання витрат на випуск""?",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьСписаниеЗатратЗавершение(Результат, ДопПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	// Виклик серверної процедури
	РезультатСоздания = СоздатьДокументНаСервере();

	Если РезультатСоздания.Успешно Тогда
		ПоказатьПредупреждение(, "Документи успішно створено!");

		// Відкриття останнього створеного документа
		Если ЗначениеЗаполнено(РезультатСоздания.СозданныйДокумент) Тогда
			ПоказатьЗначение(, РезультатСоздания.СозданныйДокумент);
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(, "Помилка: " + РезультатСоздания.ОписаниеОшибки);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СерверныеПроцедуры

&НаСервере
Функция СоздатьДокументНаСервере()

	Результат = Новый Структура("Успешно, СозданныйДокумент, ОписаниеОшибки", Ложь, Неопределено, "");

	ПроизводствоБезЗаказаСсылка = Объект.ДокПроизводствоБезЗаказа;

	// Перевірка що документ проведений
	Если НЕ ПроизводствоБезЗаказаСсылка.Проведен Тогда
		Результат.ОписаниеОшибки = "Документ ""Виробництво без замовлення"" не проведений!";
		Возврат Результат;
	КонецЕсли;

	// Перевірка наявності вихідних виробів
	Если ПроизводствоБезЗаказаСсылка.ВыходныеИзделия.Количество() = 0 Тогда
		Результат.ОписаниеОшибки = "У документі ""Виробництво без замовлення"" немає вихідних виробів!";
		Возврат Результат;
	КонецЕсли;

	// Отримання матеріалів з регістра
	ТаблицаМатериалов = ПолучитьМатериалыИзРегистра(ПроизводствоБезЗаказаСсылка);

	Если ТаблицаМатериалов.Количество() = 0 Тогда
		Результат.ОписаниеОшибки = "Не знайдено матеріалів у регістрі ""Матеріали і роботи у виробництві"" за підрозділом "
			+ Строка(ПроизводствоБезЗаказаСсылка.Подразделение) + " за місяць документа!";
		Возврат Результат;
	КонецЕсли;

	КоличествоСозданных = 0;
	ПоследнийСозданный = Неопределено;

	// Перебір вихідних виробів з ПроизводствоБезЗаказа
	Для Каждого СтрокаПродукции Из ПроизводствоБезЗаказаСсылка.ВыходныеИзделия Цикл

		Попытка
			// Пошук або створення документа СписаниеЗатратНаВыпуск
			Док = НайтиИлиСоздатьСписаниеЗатрат(ПроизводствоБезЗаказаСсылка, СтрокаПродукции);

			// Заповнення шапки
			Док.Дата = ПроизводствоБезЗаказаСсылка.Дата;
			Док.Организация = ПроизводствоБезЗаказаСсылка.Организация;
			Док.Подразделение = ПроизводствоБезЗаказаСсылка.Подразделение;
			Док.Ответственный = ПроизводствоБезЗаказаСсылка.Ответственный;
			Док.А_ПроизводствоБезЗаказа = ПроизводствоБезЗаказаСсылка;
			Док.Номенклатура = СтрокаПродукции.Номенклатура;
			Док.Характеристика = СтрокаПродукции.Характеристика;
			Док.Спецификация = СтрокаПродукции.Спецификация;
			Док.Количество = СтрокаПродукции.Количество;

			// Заповнення Назначение якщо є в документі-основі
			Попытка
				Док.Назначение = ПроизводствоБезЗаказаСсылка.Назначение;
			Исключение
				// Реквізит відсутній - пропускаємо
			КонецПопытки;

			// Заповнення табличної частини МатериалыИУслуги
			Док.МатериалыИУслуги.Очистить();
			Для Каждого СтрокаМатериала Из ТаблицаМатериалов Цикл
				НоваяСтрока = Док.МатериалыИУслуги.Добавить();
				НоваяСтрока.Номенклатура = СтрокаМатериала.Номенклатура;
				НоваяСтрока.Характеристика = СтрокаМатериала.Характеристика;
				НоваяСтрока.Количество = СтрокаМатериала.Количество;
				НоваяСтрока.КоличествоУпаковок = СтрокаМатериала.Количество;
				НоваяСтрока.Подразделение = СтрокаМатериала.Подразделение;
				НоваяСтрока.Назначение = СтрокаМатериала.Назначение;
				НоваяСтрока.Серия = СтрокаМатериала.Серия;

				
			КонецЦикла;

			// Заповнення табличної частини ВыходныеИзделия
			Док.ВыходныеИзделия.Очистить();
			НоваяСтрокаВыходные = Док.ВыходныеИзделия.Добавить();
			НоваяСтрокаВыходные.Номенклатура = СтрокаПродукции.Номенклатура;
			НоваяСтрокаВыходные.Характеристика = СтрокаПродукции.Характеристика;
			НоваяСтрокаВыходные.Количество = СтрокаПродукции.Количество;
			НоваяСтрокаВыходные.КоличествоУпаковок = СтрокаПродукции.Количество;
			НоваяСтрокаВыходные.Подразделение = ПроизводствоБезЗаказаСсылка.Подразделение;

			// Заповнення КодСтроки якщо є
			Попытка
				НоваяСтрокаВыходные.КодСтроки = СтрокаПродукции.КодСтроки;
			Исключение
				// Реквізит відсутній - пропускаємо
			КонецПопытки;

			// ДоляСтоимости = 1 для єдиного виробу
			Попытка
				НоваяСтрокаВыходные.ДоляСтоимости = 1;
			Исключение
				// Реквізит відсутній - пропускаємо
			КонецПопытки;

			// Запис документа
			Попытка
				Док.Записать(РежимЗаписиДокумента.Проведение);
				Сообщить("Створено та проведено документ: " + Строка(Док.Ссылка));
			Исключение
				Док.Записать(РежимЗаписиДокумента.Запись);
				Сообщить("Створено документ (без проведення): " + Строка(Док.Ссылка)
					+ " - " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;

			КоличествоСозданных = КоличествоСозданных + 1;
			ПоследнийСозданный = Док.Ссылка;

		Исключение
			Сообщить("Помилка при обробці виробу " + Строка(СтрокаПродукции.Номенклатура)
				+ ": " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

	КонецЦикла;

	Если КоличествоСозданных > 0 Тогда
		Результат.Успешно = Истина;
		Результат.СозданныйДокумент = ПоследнийСозданный;
		Сообщить("Всього створено документів: " + КоличествоСозданных);
	Иначе
		Результат.ОписаниеОшибки = "Не вдалося створити жодного документа!";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПолучитьМатериалыИзРегистра(ПроизводствоБезЗаказаСсылка)

	// Запит до регістра МатериалыИРаботыВПроизводстве
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	МатериалыИРаботыВПроизводствеОстаткиИОбороты.Номенклатура КАК Номенклатура,
		|	МатериалыИРаботыВПроизводствеОстаткиИОбороты.Характеристика КАК Характеристика,
		|	МатериалыИРаботыВПроизводствеОстаткиИОбороты.Подразделение КАК Подразделение,
		|	МатериалыИРаботыВПроизводствеОстаткиИОбороты.Серия КАК Серия,
		|	МатериалыИРаботыВПроизводствеОстаткиИОбороты.Назначение КАК Назначение,
		|	СУММА(МатериалыИРаботыВПроизводствеОстаткиИОбороты.КоличествоПриход) КАК Количество
		|ИЗ
		|	РегистрНакопления.МатериалыИРаботыВПроизводстве.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			,
		|			,
		|			Организация = &Организация
		|				И Подразделение = &Подразделение) КАК МатериалыИРаботыВПроизводствеОстаткиИОбороты
		|ГДЕ
		|	МатериалыИРаботыВПроизводствеОстаткиИОбороты.КоличествоПриход > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	МатериалыИРаботыВПроизводствеОстаткиИОбороты.Номенклатура,
		|	МатериалыИРаботыВПроизводствеОстаткиИОбороты.Характеристика,
		|	МатериалыИРаботыВПроизводствеОстаткиИОбороты.Подразделение,
		|	МатериалыИРаботыВПроизводствеОстаткиИОбороты.Серия,
		|	МатериалыИРаботыВПроизводствеОстаткиИОбороты.Назначение";

	// Параметри періода - місяць документа
	НачалоПериода = НачалоМесяца(ПроизводствоБезЗаказаСсылка.Дата);
	КонецПериода = КонецМесяца(ПроизводствоБезЗаказаСсылка.Дата);

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Организация", ПроизводствоБезЗаказаСсылка.Организация);
	Запрос.УстановитьПараметр("Подразделение", ПроизводствоБезЗаказаСсылка.Подразделение);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Функция НайтиИлиСоздатьСписаниеЗатрат(ПроизводствоБезЗаказаСсылка, СтрокаПродукции)

	// Пошук існуючого документа
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СписаниеЗатратНаВыпуск.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.СписаниеЗатратНаВыпуск КАК СписаниеЗатратНаВыпуск
		|ГДЕ
		|	СписаниеЗатратНаВыпуск.А_ПроизводствоБезЗаказа = &ПроизводствоБезЗаказа
		|	И СписаниеЗатратНаВыпуск.Номенклатура = &Номенклатура
		|	И СписаниеЗатратНаВыпуск.Характеристика = &Характеристика
		|	И СписаниеЗатратНаВыпуск.Спецификация = &Спецификация
		|	И НЕ СписаниеЗатратНаВыпуск.ПометкаУдаления";

	Запрос.УстановитьПараметр("ПроизводствоБезЗаказа", ПроизводствоБезЗаказаСсылка);
	Запрос.УстановитьПараметр("Номенклатура", СтрокаПродукции.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", СтрокаПродукции.Характеристика);
	Запрос.УстановитьПараметр("Спецификация", СтрокаПродукции.Спецификация);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Сообщить("Знайдено існуючий документ: " + Строка(Выборка.Ссылка) + " - буде оновлено");
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	Иначе
		Возврат Документы.СписаниеЗатратНаВыпуск.СоздатьДокумент();
	КонецЕсли;

КонецФункции

#КонецОбласти
