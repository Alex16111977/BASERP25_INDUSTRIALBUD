&НаКлиенте
Процедура СформироватьЗакрытиеОтрицательныхОстатков(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		ПоказатьПредупреждение(, "Укажите окончание периода.");
		Возврат;
	КонецЕсли;
	ВыполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНаСервере()
	Обр = РеквизитФормыВЗначение("Объект");
	Обр.ВыполнитьЗакрытие();
	ЗначениеВРеквизитФормы(Обр, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура УдалитьДокументыЗакрытия(Команда)
	ИспользоватьПериод = ЗначениеЗаполнено(Объект.НачалоПериода)
		И ЗначениеЗаполнено(Объект.ОкончаниеПериода);
	Текст = "Будут удалены документы Оприходование излишков товаров"
		+ " с флагом ""Для закрытия отрицательных остатков""";
	Если ИспользоватьПериод Тогда
		Текст = Текст + " в периоде "
			+ Формат(Объект.НачалоПериода, "ДЛФ=D") + " — "
			+ Формат(Объект.ОкончаниеПериода, "ДЛФ=D") + ".";
	Иначе
		Текст = Текст + " ЗА ВСЁ ВРЕМЯ (период не указан).";
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		Текст = Текст + " Организация: " + Строка(Объект.Организация) + ".";
	Иначе
		Текст = Текст + " По всем организациям.";
	КонецЕсли;
	Текст = Текст + Символы.ПС + "Продолжить?";
	Оповещение = Новый ОписаниеОповещения("УдалитьДокументыЗакрытияЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьДокументыЗакрытияЗавершение(Ответ, ДопПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Результат = УдалитьДокументыЗакрытияНаСервере();
	Текст = "Удалено: " + Результат.Удалено
		+ "; пропущено: " + Результат.Пропущено
		+ "; ошибок: " + Результат.Ошибок;
	ПоказатьПредупреждение(, Текст);
КонецПроцедуры

&НаСервере
Функция УдалитьДокументыЗакрытияНаСервере()
	Обр = РеквизитФормыВЗначение("Объект");
	Результат = Обр.УдалитьДокументыЗакрытия();
	ЗначениеВРеквизитФормы(Обр, "Объект");
	Возврат Результат;
КонецФункции
