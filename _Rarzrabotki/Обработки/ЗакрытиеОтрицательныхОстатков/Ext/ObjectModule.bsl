// Серверный модуль внешней обработки "ЗакрытиеОтрицательныхОстатков".
// Закрывает отрицательные остатки регистра ТоварыОрганизаций созданием
// документов ОприходованиеИзлишковТоваров.
//
// Логика дат:
//   * Период задаётся НачалоПериода..ОкончаниеПериода.
//   * Минусы ищутся как КОНЕЧНЫЙ ОСТАТОК на конец месяца ОкончаниеПериода через
//     виртуальную таблицу ОстаткиИОбороты. Граница КонецПериода в ОстаткиИОбороты
//     ВКЛЮЧИТЕЛЬНА — в отличие от .Остатки(простаяДата), она учитывает движения,
//     датированные ровно 23:59:59 последнего дня месяца (списания недостач,
//     регламентные операции закрытия). Это совпадает со штатным контролем
//     состояния учёта, который иначе видит минус, а обработка — нет.
//   * Документ оприходования создаётся датой начала месяца ОкончаниеПериода,
//     чтобы приход опережал все расходы месяца и закрывал минусы.

#Область СведенияОВнешнейОбработке

Функция СведенияОВнешнейОбработке() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Вид", "ДополнительнаяОбработка");
	Параметры.Вставить("Версия", "1.0");
	Параметры.Вставить("БезопасныйРежим", Ложь);
	Параметры.Вставить("Информация",
		"Поиск отрицательных остатков товаров организаций на конец месяца и"
		+ " автоматическое создание/проведение документов ОприходованиеИзлишковТоваров"
		+ " датой начала месяца для устранения минусов перед закрытием периода.");
	Параметры.Вставить("Наименование",
		"Закрытие отрицательных остатков");

	ТаблицаКоманд = Новый ТаблицаЗначений;
	ТаблицаКоманд.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	ТаблицаКоманд.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = "Закрытие отрицательных остатков товаров организаций";
	НоваяКоманда.Идентификатор = "ЗакрытиеОтрицательныхОстатков";
	НоваяКоманда.Использование = "ОткрытиеФормы";
	НоваяКоманда.ПоказыватьОповещение = Ложь;
	Параметры.Вставить("Команды", ТаблицаКоманд);

	Возврат Параметры;

КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

Процедура ВыполнитьЗакрытие() Экспорт

	ОтрицательныеОстатки.Очистить();

	Если НЕ ЗначениеЗаполнено(ОкончаниеПериода) Тогда
		ВызватьИсключение "Не указано окончание периода.";
	КонецЕсли;

	СтатьяДоходов = ПолучитьСтатьюДоходовПрочиеДоходы();
	Если НЕ ЗначениеЗаполнено(СтатьяДоходов) Тогда
		ВызватьИсключение "Не найдена статья доходов по коду '000001007' (Прочие доходи).";
	КонецЕсли;

	КонецМес = КонецМесяца(ОкончаниеПериода);
	НачалоМес = НачалоМесяца(ОкончаниеПериода);

	ТабОстатков = ПолучитьОтрицательныеОстатки(КонецМес, Организация);
	Если ТабОстатков.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	МассивНом = ВыгрузитьУникальные(ТабОстатков, "Номенклатура");
	Цены = ПолучитьСредниеЦены(МассивНом, КонецМес);

	Для Каждого СтрИсх Из ТабОстатков Цикл
		НоваяСтр = ОтрицательныеОстатки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтр, СтрИсх);
		Цена = ?(Цены.Получить(СтрИсх.Номенклатура) = Неопределено, 0, Цены[СтрИсх.Номенклатура]);
		НоваяСтр.Цена = Цена;
		НоваяСтр.Сумма = НоваяСтр.Количество * Цена;
		НоваяСтр.Статус = ?(Цена = 0, "Цена не найдена", "OK");
	КонецЦикла;

	ГруппыПоСкладу = ОтрицательныеОстатки.Выгрузить(, "Склад");
	ГруппыПоСкладу.Свернуть("Склад");

	Для Каждого ГрСтр Из ГруппыПоСкладу Цикл
		Склад = ГрСтр.Склад;
		Если НЕ ЗначениеЗаполнено(Склад) Тогда
			Продолжить;
		КонецЕсли;
		Строки = ОтрицательныеОстатки.НайтиСтроки(Новый Структура("Склад", Склад));
		Попытка
			СсылкаДок = СоздатьИПровестиДокумент(Склад, Строки, СтатьяДоходов, НачалоМес);
			Для Каждого С Из Строки Цикл
				С.СозданныйДокумент = СсылкаДок;
			КонецЦикла;
		Исключение
			Текст = СокрЛП(ОписаниеОшибки());
			Если СтрДлина(Текст) > 200 Тогда
				Текст = Лев(Текст, 197) + "...";
			КонецЕсли;
			Для Каждого С Из Строки Цикл
				С.Статус = "Ошибка: " + Текст;
			КонецЦикла;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьОтрицательныеОстатки(КонецМес, ОрганизацияПар)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ост.Организация                                     КАК Организация,
	|	Ост.АналитикаУчетаНоменклатуры                      КАК АналитикаУчетаНоменклатуры,
	|	Ост.АналитикаУчетаНоменклатуры.Номенклатура         КАК Номенклатура,
	|	Ост.АналитикаУчетаНоменклатуры.Характеристика       КАК Характеристика,
	|	Ост.АналитикаУчетаНоменклатуры.СкладскаяТерритория  КАК Склад,
	|	Ост.ВидЗапасов                                      КАК ВидЗапасов,
	|	Ост.НомерГТД                                        КАК НомерГТД,
	|	-Ост.КоличествоКонечныйОстаток                      КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыОрганизаций.ОстаткиИОбороты(
	|			,
	|			&КонецМес,
	|			Период,
	|			,
	|			Организация = &Орг ИЛИ &ОрганизацияПусто) КАК Ост
	|ГДЕ
	|	Ост.КоличествоКонечныйОстаток < 0";

	Запрос.УстановитьПараметр("КонецМес",         КонецМес);
	Запрос.УстановитьПараметр("Орг",              ОрганизацияПар);
	Запрос.УстановитьПараметр("ОрганизацияПусто", НЕ ЗначениеЗаполнено(ОрганизацияПар));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолучитьСредниеЦены(МассивНоменклатуры, КонецМес)

	Соотв = Новый Соответствие;
	Если МассивНоменклатуры.Количество() = 0 Тогда
		Возврат Соотв;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Тов.Номенклатура                       КАК Номенклатура,
	|	СУММА(Тов.Сумма) / ВЫБОР
	|		КОГДА СУММА(Тов.Количество) = 0 ТОГДА 1
	|		ИНАЧЕ СУММА(Тов.Количество)
	|	КОНЕЦ                                   КАК СредняяЦена
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК Тов
	|ГДЕ
	|	Тов.Ссылка.Проведен = ИСТИНА
	|	И Тов.Ссылка.Дата >= &ДатаС
	|	И Тов.Ссылка.Дата <= &ДатаПо
	|	И Тов.Номенклатура В (&Номенклатуры)
	|СГРУППИРОВАТЬ ПО
	|	Тов.Номенклатура";

	Запрос.УстановитьПараметр("ДатаС",         ДобавитьМесяц(КонецМес, -12));
	Запрос.УстановитьПараметр("ДатаПо",        КонецМес);
	Запрос.УстановитьПараметр("Номенклатуры",  МассивНоменклатуры);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Соотв.Вставить(Выборка.Номенклатура, Выборка.СредняяЦена);
	КонецЦикла;

	Возврат Соотв;

КонецФункции

Функция ПолучитьСтатьюДоходовПрочиеДоходы()

	Возврат ПланыВидовХарактеристик.СтатьиДоходов.НайтиПоКоду("000001007");

КонецФункции

Функция СоздатьИПровестиДокумент(Склад, Строки, СтатьяДоходов, ДатаДок)

	Орг = ?(ЗначениеЗаполнено(Организация), Организация, Строки[0].Организация);

	СсылкаСущ = НайтиСуществующийДокумент(Орг, Склад, ДатаДок);
	Если ЗначениеЗаполнено(СсылкаСущ) Тогда
		Док = СсылкаСущ.ПолучитьОбъект();
		Док.Товары.Очистить();
	Иначе
		Док = Документы.ОприходованиеИзлишковТоваров.СоздатьДокумент();
	КонецЕсли;

	Док.Дата                              = ДатаДок;
	Док.Организация                       = Орг;
	Док.Склад                             = Склад;
	Док.Подразделение                     = Склад.Подразделение;
	Док.СтатьяДоходов                     = СтатьяДоходов;
	Док.АналитикаДоходов                  = Орг;
	Док.Валюта                            = Константы.ВалютаРегламентированногоУчета.Получить();
	Док.Ответственный                     = Пользователи.ТекущийПользователь();
	Док.А_ДляЗакрытиеОтрицательныхОстатков = Истина;
	Док.Комментарий = "Создано обработкой ЗакрытиеОтрицательныхОстатков "
		+ Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");

	Для Каждого Стр Из Строки Цикл
		СтрТЧ = Док.Товары.Добавить();
		СтрТЧ.Номенклатура              = Стр.Номенклатура;
		СтрТЧ.Характеристика            = Стр.Характеристика;
		СтрТЧ.Количество                = Стр.Количество;
		СтрТЧ.Цена                      = Стр.Цена;
		СтрТЧ.Сумма                     = Стр.Сумма;
		СтрТЧ.ВидЗапасов                = Стр.ВидЗапасов;
		СтрТЧ.АналитикаУчетаНоменклатуры = Стр.АналитикаУчетаНоменклатуры;
		Если ЗначениеЗаполнено(Стр.НомерГТД) Тогда
			СтрТЧ.НомерГТД              = Стр.НомерГТД;
		КонецЕсли;
		СтрТЧ.ИдентификаторСтроки       = Строка(Новый УникальныйИдентификатор());
	КонецЦикла;

	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ОшибкаПровед = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации(
			"ЗакрытиеОтрицательныхОстатков",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ОприходованиеИзлишковТоваров,
			Док.Ссылка,
			ОшибкаПровед);
		Попытка
			Док.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			ВызватьИсключение "Не удалось записать: " + ОписаниеОшибки() + " | Провед: " + ОшибкаПровед;
		КонецПопытки;
	КонецПопытки;

	Возврат Док.Ссылка;

КонецФункции

Функция НайтиСуществующийДокумент(Орг, Склад, Дата)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОприходованиеИзлишковТоваров КАК Док
	|ГДЕ
	|	Док.Организация = &Орг
	|	И Док.Склад = &Склад
	|	И Док.Дата = &Дата
	|	И Док.А_ДляЗакрытиеОтрицательныхОстатков = ИСТИНА";

	Запрос.УстановитьПараметр("Орг",   Орг);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Дата",  Дата);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

Функция ВыгрузитьУникальные(ТЗ, ИмяКолонки)

	Резерв = ТЗ.Скопировать(, ИмяКолонки);
	Резерв.Свернуть(ИмяКолонки);
	Возврат Резерв.ВыгрузитьКолонку(ИмяКолонки);

КонецФункции

// Удаляет документы ОприходованиеИзлишковТоваров с флагом
// А_ДляЗакрытиеОтрицательныхОстатков=Истина.
// Период (НачалоПериода..ОкончаниеПериода) — опционален:
//   * если оба заданы — фильтрует НачалоМесяца(НачалоПериода)..КонецМесяца(ОкончаниеПериода);
//   * если не заданы — удаляет ВСЕ документы по флагу.
// Организация — опционально, фильтрует если заполнено.
// В цикле повторно проверяется флаг А_ДляЗакрытиеОтрицательныхОстатков по объекту —
// защита от удаления документа, у которого флаг был снят между запросом и обработкой.
// Возврат: Структура (Удалено, Пропущено, Ошибок, Ошибки[Массив]).
Функция УдалитьДокументыЗакрытия() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Удалено",   0);
	Результат.Вставить("Пропущено", 0);
	Результат.Вставить("Ошибок",    0);
	Результат.Вставить("Ошибки",    Новый Массив);

	ИспольПериод = ЗначениеЗаполнено(НачалоПериода) И ЗначениеЗаполнено(ОкончаниеПериода);
	Если ИспольПериод И НачалоПериода > ОкончаниеПериода Тогда
		ВызватьИсключение "Начало периода больше окончания.";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОприходованиеИзлишковТоваров КАК Док
	|ГДЕ
	|	Док.А_ДляЗакрытиеОтрицательныхОстатков = ИСТИНА
	|	И (НЕ &ИспольПериод ИЛИ (Док.Дата >= &НачДата И Док.Дата <= &КонДата))
	|	И (НЕ &ФильтрОрг ИЛИ Док.Организация = &Орг)";
	Запрос.УстановитьПараметр("ИспольПериод", ИспольПериод);
	Запрос.УстановитьПараметр("НачДата",      ?(ИспольПериод, НачалоМесяца(НачалоПериода), '00010101'));
	Запрос.УстановитьПараметр("КонДата",      ?(ИспольПериод, КонецМесяца(ОкончаниеПериода), '39991231'));
	Запрос.УстановитьПараметр("ФильтрОрг",    ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Орг",          Организация);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Если ДокОбъект = Неопределено Тогда
				Результат.Пропущено = Результат.Пропущено + 1;
				Продолжить;
			КонецЕсли;
			// Защита: повторная проверка флага по актуальному объекту.
			// Удаляем только если флаг А_ДляЗакрытиеОтрицательныхОстатков=Истина.
			Если НЕ ДокОбъект.А_ДляЗакрытиеОтрицательныхОстатков Тогда
				Результат.Пропущено = Результат.Пропущено + 1;
				Продолжить;
			КонецЕсли;
			Если ДокОбъект.Проведен Тогда
				ДокОбъект.ОбменДанными.Загрузка = Истина;
				ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				// Перечитаем объект после отмены проведения, чтобы избежать
				// "Попытка использования закрытого менеджера временных таблиц"
				// в подписке ПередЗаписью регистра СуммыДокументовВВалютахУчета.
				ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
				// Перепроверим флаг и после перечтения.
				Если ДокОбъект = Неопределено ИЛИ НЕ ДокОбъект.А_ДляЗакрытиеОтрицательныхОстатков Тогда
					Результат.Пропущено = Результат.Пропущено + 1;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			ДокОбъект.ОбменДанными.Загрузка = Истина;
			ДокОбъект.Удалить();
			Результат.Удалено = Результат.Удалено + 1;
		Исключение
			Результат.Ошибок = Результат.Ошибок + 1;
			Текст = "" + Выборка.Ссылка + ": " + СокрЛП(ОписаниеОшибки());
			Результат.Ошибки.Добавить(Текст);
			ЗаписьЖурналаРегистрации(
				"ЗакрытиеОтрицательныхОстатков.УдалениеДокумента",
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.ОприходованиеИзлишковТоваров,
				Выборка.Ссылка,
				ОписаниеОшибки());
		КонецПопытки;
