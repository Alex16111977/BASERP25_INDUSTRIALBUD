
// Регистрация в подсистеме БСП «Дополнительные отчёты и обработки»
// (подключение как внешней обработки в конфигурацию). Команда открывает форму,
// на которой обе кнопки: «Заполнить по списанию» (приобретение) и «...реализацию».
Функция СведенияОВнешнейОбработке() Экспорт
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Наименование", "Заповнення в бухобліку за списанням (надходження/реалізація)");
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация", "Заповнення ТЧ «Товари» документів Надходження/Реалізація за Кт-проводками проведеного Списання товарів");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.0.7.6");
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд, "Заповнення за списанням (надходження/реалізація)", "1", "ОткрытиеФормы", Истина, "");
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	Возврат ПараметрыРегистрации;
КонецФункции

// Заполняет ТЧ Товары документа-приёмника ПоступлениеТоваровУслуг по проводкам
// (РегистрБухгалтерии.Хозрасчетный, сторона Кт) проведённого СписаниеТоваров.
// Свёртка по (Номенклатура, СчётКт, НалоговоеНазначение). НДС 20% сверх.
// ПроцентНаценки: 0 → по себестоимости 1:1 (Сумма=себест, Цена=себест/Кол);
//   >0 → Цена=Окр(себест/Кол*(1+%/100),2), Сумма=Окр(Цена*Кол,2) (см. ЦенаИСуммаСНаценкой).
// Возвращает Структуру: Успех(Булево), Сообщение(Строка), Строк(Число),
//   ИтогоСумма(Число), ИтогоНДС(Число), Распроведён(Булево).
Функция ЗаполнитьПоСписанию(СписаниеСсылка, ПриёмникСсылка, ПроцентНаценки = 0) Экспорт

	Результат = Новый Структура("Успех, Сообщение, Строк, ИтогоСумма, ИтогоНДС, Распроведён",
		Ложь, "", 0, 0, 0, Ложь);

	// --- Гарды ---
	Если НЕ ЗначениеЗаполнено(СписаниеСсылка) Тогда
		Результат.Сообщение = "Не вибрано документ «Списання товарів».";
		Возврат Результат;
	КонецЕсли;
	Если НЕ СписаниеСсылка.Проведен Тогда
		Результат.Сообщение = "Документ списання не проведено — немає проводок для заповнення.";
		Возврат Результат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПриёмникСсылка) Тогда
		Результат.Сообщение = "Не вибрано документ-приймач «Надходження товарів і послуг».";
		Возврат Результат;
	КонецЕсли;

	// --- Чтение проводок: набор записей по регистратору ---
	НаборЗаписей = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(СписаниеСсылка);
	НаборЗаписей.Прочитать();

	ТипНоменклатура = Тип("СправочникСсылка.Номенклатура");
	Группы = Новый Соответствие; // Ключ(Строка) -> Структура
	Порядок = Новый Массив;      // порядок появления групп

	Для Каждого Запись Из НаборЗаписей Цикл
		Если Запись.КоличествоКт = 0 Тогда
			Продолжить;
		КонецЕсли;

		Номенклатура = Неопределено;
		Для Каждого КлючЗначение Из Запись.СубконтоКт Цикл
			Если ТипЗнч(КлючЗначение.Значение) = ТипНоменклатура Тогда
				Номенклатура = КлючЗначение.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Номенклатура = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Счет = Запись.СчетКт;
		НалНазначение = Запись.НалоговоеНазначениеКт; // небалансовое измерение → сторона Кт
		Ключ = Строка(Номенклатура.УникальныйИдентификатор())
			+ "|" + Строка(Счет.УникальныйИдентификатор())
			+ "|" + Строка(НалНазначение.УникальныйИдентификатор());

		Группа = Группы.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Номенклатура, Счет, НалНазначение, Количество, Сумма",
				Номенклатура, Счет, НалНазначение, 0, 0);
			Группы.Вставить(Ключ, Группа);
			Порядок.Добавить(Ключ);
		КонецЕсли;
		Группа.Количество = Группа.Количество + Запись.КоличествоКт;
		Группа.Сумма = Группа.Сумма + Запись.Сумма;
	КонецЦикла;

	Если Порядок.Количество() = 0 Тогда
		Результат.Сообщение = "У проводках списання немає рядків з номенклатурою на боці Кт — заповнювати нічого.";
		Возврат Результат;
	КонецЕсли;

	// --- Заполнение приёмника ---
	ДокОбъект = ПриёмникСсылка.ПолучитьОбъект();
	Итоги = ЗаполнитьСтрокиПоступления(ДокОбъект, Группы, Порядок, ПроцентНаценки);
	ИтогоСумма = Итоги.ИтогоСумма;
	ИтогоНДС = Итоги.ИтогоНДС;

	// --- Запись без проведения ---
	ТекстНаценки = ?(ПроцентНаценки <> 0, ", націнка " + Формат(ПроцентНаценки, "ЧДЦ=2") + "%", "");
	ХвостСообщения = " (" + Строка(Порядок.Количество()) + " ряд., сума "
		+ Формат(ИтогоСумма, "ЧЦ=15; ЧДЦ=2") + " + ПДВ "
		+ Формат(ИтогоНДС, "ЧЦ=15; ЧДЦ=2") + ТекстНаценки + "). Перевірте та проведіть документ.";
	Если ДокОбъект.Проведен Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Результат.Распроведён = Истина;
		Результат.Сообщение = "Надходження перезаповнено за проводками списання та розпроведено" + ХвостСообщения;
	Иначе
		ДокОбъект.Записать();
		Результат.Сообщение = "Надходження заповнено за проводками списання" + ХвостСообщения;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Строк = Порядок.Количество();
	Результат.ИтогоСумма = ИтогоСумма;
	Результат.ИтогоНДС = ИтогоНДС;
	Возврат Результат;

КонецФункции

// Заполняет ТЧ Товары документа-приёмника РеализацияТоваровУслуг по проводкам
// (РегистрБухгалтерии.Хозрасчетный, сторона Кт) проведённого СписаниеТоваров.
// Зеркало ЗаполнитьПоСписанию: свёртка по (Номенклатура, СчётКт, НалоговоеНазначение),
// НДС 20% сверх. ПроцентНаценки: 0 → по себестоимости 1:1; >0 → Цена/Сумма с наценкой
// (см. ЦенаИСуммаСНаценкой). Поля строки заполняются как в типовом документе-эталоне
// реализации: СуммаБезСкидки = Сумма, СуммаСкидки = 0, СхемаРеализации = Товары;
// колонки Себестоимость/СебестоимостьНУ и НалоговоеНазначениеДоходовИЗатрат не трогаем
// (в эталоне пусты, считаются при проведении).
// Возвращает Структуру: Успех(Булево), Сообщение(Строка), Строк(Число),
//   ИтогоСумма(Число), ИтогоНДС(Число), Распроведён(Булево).
