КонецФункции

// Заполняет ТЧ Товары документа-приёмника ПеремещениеТоваров по проводкам
// (РегистрБухгалтерии.Хозрасчетный, сторона Кт) проведённого СписаниеТоваров.
// Зеркало ЗаполнитьПоСписанию, но перемещение — по себестоимости, БЕЗ наценки и БЕЗ НДС
// (в ТЧ их нет): Цена = себест/Кол, СчетУчетаБУ = СчётКт, НовыйСчетУчетаБУ = СчётКт.
// Шапку (СкладОтправитель/СкладПолучатель/Организация) не трогаем — задаёт пользователь.
// Возвращает Структуру: Успех(Булево), Сообщение(Строка), Строк(Число),
//   ИтогоСумма(Число), ИтогоНДС(Число), Распроведён(Булево).
Функция ЗаполнитьПоСписаниюПеремещение(СписаниеСсылка, ПриёмникСсылка) Экспорт

	Результат = Новый Структура("Успех, Сообщение, Строк, ИтогоСумма, ИтогоНДС, Распроведён",
		Ложь, "", 0, 0, 0, Ложь);

	// --- Гарды ---
	Если НЕ ЗначениеЗаполнено(СписаниеСсылка) Тогда
		Результат.Сообщение = "Не вибрано документ «Списання товарів».";
		Возврат Результат;
	КонецЕсли;
	Если НЕ СписаниеСсылка.Проведен Тогда
		Результат.Сообщение = "Документ списання не проведено — немає проводок для заповнення.";
		Возврат Результат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПриёмникСсылка) Тогда
		Результат.Сообщение = "Не вибрано документ-приймач «Переміщення товарів».";
		Возврат Результат;
	КонецЕсли;

	// --- Чтение проводок: набор записей по регистратору ---
	НаборЗаписей = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(СписаниеСсылка);
	НаборЗаписей.Прочитать();

	ТипНоменклатура = Тип("СправочникСсылка.Номенклатура");
	Группы = Новый Соответствие;
	Порядок = Новый Массив;

	Для Каждого Запись Из НаборЗаписей Цикл
		Если Запись.КоличествоКт = 0 Тогда
			Продолжить;
		КонецЕсли;

		Номенклатура = Неопределено;
		Для Каждого КлючЗначение Из Запись.СубконтоКт Цикл
			Если ТипЗнч(КлючЗначение.Значение) = ТипНоменклатура Тогда
				Номенклатура = КлючЗначение.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Номенклатура = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Счет = Запись.СчетКт;
		НалНазначение = Запись.НалоговоеНазначениеКт; // небалансовое измерение → сторона Кт
		Ключ = Строка(Номенклатура.УникальныйИдентификатор())
			+ "|" + Строка(Счет.УникальныйИдентификатор())
			+ "|" + Строка(НалНазначение.УникальныйИдентификатор());

		Группа = Группы.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Номенклатура, Счет, НалНазначение, Количество, Сумма",
				Номенклатура, Счет, НалНазначение, 0, 0);
			Группы.Вставить(Ключ, Группа);
			Порядок.Добавить(Ключ);
		КонецЕсли;
		Группа.Количество = Группа.Количество + Запись.КоличествоКт;
		Группа.Сумма = Группа.Сумма + Запись.Сумма;
	КонецЦикла;

	Если Порядок.Количество() = 0 Тогда
		Результат.Сообщение = "У проводках списання немає рядків з номенклатурою на боці Кт — заповнювати нічого.";
		Возврат Результат;
	КонецЕсли;

	// --- Заполнение приёмника (по себестоимости, без наценки и НДС) ---
	ДокОбъект = ПриёмникСсылка.ПолучитьОбъект();
	ДокОбъект.Товары.Очистить();
	ИтогоСумма = 0;

	Для Каждого Ключ Из Порядок Цикл
		Группа = Группы.Получить(Ключ);
		НоваяСтрока = ДокОбъект.Товары.Добавить();
		НоваяСтрока.Номенклатура = Группа.Номенклатура;
		НоваяСтрока.Количество = Группа.Количество;
		Если Группа.Количество <> 0 Тогда
			НоваяСтрока.Цена = Группа.Сумма / Группа.Количество;
		Иначе
			НоваяСтрока.Цена = 0;
		КонецЕсли;
		НоваяСтрока.ЕдиницаИзмерения = Группа.Номенклатура.БазоваяЕдиницаИзмерения;
		НоваяСтрока.Коэффициент = 1;
		НоваяСтрока.СчетУчетаБУ = Группа.Счет;
		НоваяСтрока.НовыйСчетУчетаБУ = Группа.Счет; // тот же счёт у получателя
		НоваяСтрока.НалоговоеНазначение = Группа.НалНазначение;

		ИтогоСумма = ИтогоСумма + Группа.Сумма;
	КонецЦикла;

	// --- Запись без проведения ---
	ХвостСообщения = " (" + Строка(Порядок.Количество()) + " ряд., собівартість "
		+ Формат(ИтогоСумма, "ЧЦ=15; ЧДЦ=2") + "). Перевірте склади та проведіть документ.";
	Если ДокОбъект.Проведен Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Результат.Распроведён = Истина;
		Результат.Сообщение = "Переміщення перезаповнено за проводками списання та розпроведено" + ХвостСообщения;
	Иначе
		ДокОбъект.Записать();
		Результат.Сообщение = "Переміщення заповнено за проводками списання" + ХвостСообщения;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Строк = Порядок.Количество();
	Результат.ИтогоСумма = ИтогоСумма;
	Возврат Результат;

КонецФункции

// Возвращает Структуру("Цена, Сумма") строки с учётом наценки.
// ПроцентНаценки = 0 → точная себестоимость (Сумма = Себестоимость, Цена = Себестоимость/Количество).
// ПроцентНаценки > 0 → Цена = Окр(Себестоимость/Количество * (1 + ПроцентНаценки/100), 2), Сумма = Окр(Цена*Количество, 2).
Функция ЦенаИСуммаСНаценкой(Себестоимость, Количество, ПроцентНаценки)
	Рез = Новый Структура("Цена, Сумма", 0, Себестоимость);
	Если Количество = 0 Тогда
		Возврат Рез;
	КонецЕсли;
	Если ПроцентНаценки = 0 Тогда
		Рез.Сумма = Себестоимость;
		Рез.Цена = Себестоимость / Количество;
	Иначе
		Рез.Цена = Окр(Себестоимость / Количество * (1 + ПроцентНаценки / 100), 2);
		Рез.Сумма = Окр(Рез.Цена * Количество, 2);
	КонецЕсли;
	Возврат Рез;
КонецФункции

// Заполняет ТЧ Товары документа-приёмника ПоступлениеТоваровУслуг из готовых групп
// (Номенклатура, Счет, НалНазначение, Количество, Сумма-себест). Используется ветками
// «по списанию» и «по перемещениям». Возвращает Структуру(ИтогоСумма, ИтогоНДС).
Функция ЗаполнитьСтрокиПоступления(ДокОбъект, Группы, Порядок, ПроцентНаценки)
	ДокОбъект.Товары.Очистить();
	ДокОбъект.СуммаВключаетНДС = Ложь;
	СтавкаНДС20 = Перечисления.СтавкиНДС.НДС20;
	ПроцентНДС = 20;
	ИтогоСумма = 0;
	ИтогоНДС = 0;
	Для Каждого Ключ Из Порядок Цикл
		Группа = Группы.Получить(Ключ);
		НоваяСтрока = ДокОбъект.Товары.Добавить();
		НоваяСтрока.Номенклатура = Группа.Номенклатура;
		НоваяСтрока.СчетУчетаБУ = Группа.Счет;
		НоваяСтрока.Количество = Группа.Количество;
		ЦенаСумма = ЦенаИСуммаСНаценкой(Группа.Сумма, Группа.Количество, ПроцентНаценки);
		НоваяСтрока.Сумма = ЦенаСумма.Сумма;
		НоваяСтрока.Цена = ЦенаСумма.Цена;
		НоваяСтрока.ЕдиницаИзмерения = Группа.Номенклатура.БазоваяЕдиницаИзмерения;
		НоваяСтрока.Коэффициент = 1;
		НоваяСтрока.СтавкаНДС = СтавкаНДС20;
		НоваяСтрока.СуммаНДС = Окр(ЦенаСумма.Сумма * ПроцентНДС / 100, 2);
		НоваяСтрока.НалоговоеНазначение = Группа.НалНазначение;
		ИтогоСумма = ИтогоСумма + ЦенаСумма.Сумма;
		ИтогоНДС = ИтогоНДС + НоваяСтрока.СуммаНДС;
	КонецЦикла;
	ДокОбъект.СуммаДокумента = ИтогоСумма + ИтогоНДС;
	Возврат Новый Структура("ИтогоСумма, ИтогоНДС", ИтогоСумма, ИтогоНДС);
КонецФункции

// Заполняет ТЧ Товары документа-приёмника РеализацияТоваровУслуг из готовых групп.
// Поля как в эталоне реализации (СуммаБезСкидки=Сумма, СуммаСкидки=0, СхемаРеализации=Товары).
// Используется ветками «по списанию» и «по перемещениям». Возвращает Структуру(ИтогоСумма, ИтогоНДС).
Функция ЗаполнитьСтрокиРеализации(ДокОбъект, Группы, Порядок, ПроцентНаценки)
	ДокОбъект.Товары.Очистить();
	ДокОбъект.СуммаВключаетНДС = Ложь;
	СтавкаНДС20 = Перечисления.СтавкиНДС.НДС20;
	СхемаРеализацииТовары = Справочники.СхемыРеализации.Товары; // справочник (предопр.), как в эталоне
	ПроцентНДС = 20;
	ИтогоСумма = 0;
	ИтогоНДС = 0;
	Для Каждого Ключ Из Порядок Цикл
		Группа = Группы.Получить(Ключ);
		НоваяСтрока = ДокОбъект.Товары.Добавить();
		НоваяСтрока.Номенклатура = Группа.Номенклатура;
		НоваяСтрока.СчетУчетаБУ = Группа.Счет;
		НоваяСтрока.Количество = Группа.Количество;
		ЦенаСумма = ЦенаИСуммаСНаценкой(Группа.Сумма, Группа.Количество, ПроцентНаценки);
		НоваяСтрока.Сумма = ЦенаСумма.Сумма;
		НоваяСтрока.Цена = ЦенаСумма.Цена;
		НоваяСтрока.ЕдиницаИзмерения = Группа.Номенклатура.БазоваяЕдиницаИзмерения;
		НоваяСтрока.Коэффициент = 1;
		НоваяСтрока.СтавкаНДС = СтавкаНДС20;
		НоваяСтрока.СуммаНДС = Окр(ЦенаСумма.Сумма * ПроцентНДС / 100, 2);
		НоваяСтрока.НалоговоеНазначение = Группа.НалНазначение;
		НоваяСтрока.СуммаБезСкидки = ЦенаСумма.Сумма; // как в эталоне: сумма без скидки = сумме
		НоваяСтрока.СуммаСкидки = 0;
		НоваяСтрока.СхемаРеализации = СхемаРеализацииТовары;
		ИтогоСумма = ИтогоСумма + ЦенаСумма.Сумма;
		ИтогоНДС = ИтогоНДС + НоваяСтрока.СуммаНДС;
	КонецЦикла;
	ДокОбъект.СуммаДокумента = ИтогоСумма + ИтогоНДС; // ПередЗаписью реализации пересчитает по всем ТЧ
	Возврат Новый Структура("ИтогоСумма, ИтогоНДС", ИтогоСумма, ИтогоНДС);
КонецФункции

// Агрегирует Дт-проводки (РегистрБухгалтерии.Хозрасчетный) проведённых ПеремещениеТоваров
// из списка (ТЧ с реквизитом ДокументПеремещениеТоваров) в группы по (Номенклатура, СчётДт,
// НалоговоеНазначениеДт). Дт = приход на склад-получатель. Дубли ссылок и непроведённые
// пропускаются. Возвращает Структуру: Группы(Соответствие), Порядок(Массив), Пропущено(Число).
Функция ГруппыИзПеремещений(СписокПеремещений)
	ТипНоменклатура = Тип("СправочникСсылка.Номенклатура");
	Группы = Новый Соответствие;
	Порядок = Новый Массив;
	Обработанные = Новый Соответствие; // дедуп ссылок перемещений
	Пропущено = 0;

	Для Каждого СтрокаСписка Из СписокПеремещений Цикл
		Перемещение = СтрокаСписка.ДокументПеремещениеТоваров;
		Если НЕ ЗначениеЗаполнено(Перемещение) Тогда
			Продолжить;
		КонецЕсли;
		Если Обработанные.Получить(Перемещение) <> Неопределено Тогда
			Продолжить; // дубль в списке
		КонецЕсли;
		Обработанные.Вставить(Перемещение, Истина);
		Если НЕ Перемещение.Проведен Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		НаборЗаписей = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Перемещение);
		НаборЗаписей.Прочитать();
		Для Каждого Запись Из НаборЗаписей Цикл
			Если Запись.КоличествоДт = 0 Тогда
				Продолжить;
			КонецЕсли;
			Номенклатура = Неопределено;
			Для Каждого КлючЗначение Из Запись.СубконтоДт Цикл
				Если ТипЗнч(КлючЗначение.Значение) = ТипНоменклатура Тогда
					Номенклатура = КлючЗначение.Значение;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Номенклатура = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Счет = Запись.СчетДт;
			НалНазначение = Запись.НалоговоеНазначениеДт;
			Ключ = Строка(Номенклатура.УникальныйИдентификатор())
				+ "|" + Строка(Счет.УникальныйИдентификатор())
				+ "|" + Строка(НалНазначение.УникальныйИдентификатор());
			Группа = Группы.Получить(Ключ);
			Если Группа = Неопределено Тогда
				Группа = Новый Структура("Номенклатура, Счет, НалНазначение, Количество, Сумма",
					Номенклатура, Счет, НалНазначение, 0, 0);
				Группы.Вставить(Ключ, Группа);
				Порядок.Добавить(Ключ);
			КонецЕсли;
			Группа.Количество = Группа.Количество + Запись.КоличествоДт;
			Группа.Сумма = Группа.Сумма + Запись.Сумма;
		КонецЦикла;
	КонецЦикла;

	Возврат Новый Структура("Группы, Порядок, Пропущено", Группы, Порядок, Пропущено);
КонецФункции

// Заполняет ТЧ Товары выбранного ПоступлениеТоваровУслуг по списку проведённых
// ПеремещениеТоваров (агрегат Дт-проводок). ПроцентНаценки — как в ветках по списанию.
// Возвращает результат-Структуру (Успех/Сообщение/Строк/ИтогоСумма/ИтогоНДС/Распроведён).
Функция ЗаполнитьПоПеремещениямПоступление(СписокПеремещений, ПриёмникСсылка, ПроцентНаценки = 0) Экспорт

	Результат = Новый Структура("Успех, Сообщение, Строк, ИтогоСумма, ИтогоНДС, Распроведён",
		Ложь, "", 0, 0, 0, Ложь);

	Если СписокПеремещений.Количество() = 0 Тогда
		Результат.Сообщение = "Список переміщень порожній.";
		Возврат Результат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПриёмникСсылка) Тогда
		Результат.Сообщение = "Не вибрано документ-приймач «Надходження товарів і послуг».";
		Возврат Результат;
	КонецЕсли;

	Агрегат = ГруппыИзПеремещений(СписокПеремещений);
	Если Агрегат.Порядок.Количество() = 0 Тогда
		Результат.Сообщение = "У проводках переміщень немає рядків з номенклатурою на боці Дт"
			+ ?(Агрегат.Пропущено > 0, " (пропущено непроведених переміщень: " + Строка(Агрегат.Пропущено) + ")", "")
			+ " — заповнювати нічого.";
		Возврат Результат;
	КонецЕсли;

	ДокОбъект = ПриёмникСсылка.ПолучитьОбъект();
	Итоги = ЗаполнитьСтрокиПоступления(ДокОбъект, Агрегат.Группы, Агрегат.Порядок, ПроцентНаценки);

	ТекстНаценки = ?(ПроцентНаценки <> 0, ", націнка " + Формат(ПроцентНаценки, "ЧДЦ=2") + "%", "");
	ТекстПропущено = ?(Агрегат.Пропущено > 0, ", пропущено непроведених " + Строка(Агрегат.Пропущено), "");
	ХвостСообщения = " (" + Строка(Агрегат.Порядок.Количество()) + " ряд., сума "
		+ Формат(Итоги.ИтогоСумма, "ЧЦ=15; ЧДЦ=2") + " + ПДВ "
		+ Формат(Итоги.ИтогоНДС, "ЧЦ=15; ЧДЦ=2") + ТекстНаценки + ТекстПропущено + "). Перевірте та проведіть документ.";
	Если ДокОбъект.Проведен Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Результат.Распроведён = Истина;
		Результат.Сообщение = "Надходження перезаповнено за переміщеннями та розпроведено" + ХвостСообщения;
	Иначе
		ДокОбъект.Записать();
		Результат.Сообщение = "Надходження заповнено за переміщеннями" + ХвостСообщения;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Строк = Агрегат.Порядок.Количество();
	Результат.ИтогоСумма = Итоги.ИтогоСумма;
	Результат.ИтогоНДС = Итоги.ИтогоНДС;
	Возврат Результат;

КонецФункции

// Заполняет ТЧ Товары выбранного РеализацияТоваровУслуг по списку проведённых
// ПеремещениеТоваров (агрегат Дт-проводок). ПроцентНаценки — как в ветках по списанию.
