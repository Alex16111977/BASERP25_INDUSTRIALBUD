// ===========================================================================
// Обробка: СинхронизироватьТоварыТолькоТовары
// Призначення: Контроль синхронізації ERP ↔ BuhBud ТІЛЬКИ по товарах (номенклатурі)
// Розділ: Товари (рух номенклатури: ТоварыНаСкладах ↔ рах. 281/20x/26/22x)
// ===========================================================================
// Фаза 1: Порівняння залишків (залишки+обороти ERP vs BuhBud)
// Фаза 2: Аналіз документів (через СоответствияОбъектовИнформационныхБаз)
// Фаза 3: Синхронізація (розпровести в ЕРП / поставити на обмін в BuhBud)
// ===========================================================================

#Область ОбщиеФункции

// Підключення до BuhBud через COM
//
// Повертає:
//  COMОбъект - підключення до бази BuhBud, або Неопределено при помилці
//
Функция ПодключитьсяКBuhBud() Экспорт

	СтрокаПодключенияBuhBud = А_ПодключенияБазСервер.СтрокаПодключения("BuhBud");
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияBuhBud));
	Исключение
		Сообщить("Помилка підключення до BuhBud: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Возврат V83;

КонецФункции

#КонецОбласти

// ===========================================================================
// ФАЗА 1: Порівняння залишків
// ===========================================================================

#Область Фаза1_ПорівнянняЗалишків

// Головна функція Фази 1 — порівняння залишків по товарах
//
Функция СравнитьОстатки() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ТаблицаРасхождений.Очистить();
	ТаблицаДокументов.Очистить();
	ТаблицаСкладов.Очистить();

	// Підключення до BuhBud
	V83 = ПодключитьсяКBuhBud();
	Если V83 = Неопределено Тогда
		Возврат "Помилка підключення до BuhBud";
	КонецЕсли;

	Попытка
		СравнитьОстатки_Товары(V83);
	Исключение
		Сообщить("Помилка при порівнянні залишків: " + ОписаниеОшибки());
	КонецПопытки;

	// Звільнення COM-з'єднання
	V83 = Неопределено;

	// Згорнути позиції (Номенклатура×Склад) у звід по складах — це верхня таблиця форми
	ЗаполнитьСводПоСкладам();

	Возврат "Оброблено. Складів з розбіжностями: " + Строка(ТаблицаСкладов.Количество())
		+ ", позицій: " + Строка(ТаблицаРасхождений.Количество());

КонецФункции

// Згортка ТаблицаРасхождений (позиції Номенклатура×Склад) у звід по складах.
// Ключ складу — СкладКлюч (А_ИдКод). Кількісні залишки НЕ підсумовуємо
// (різна номенклатура — несумісні одиниці), рахуємо кількість позицій та Σ|Різниця|.
//
Процедура ЗаполнитьСводПоСкладам()

	ТаблицаСкладов.Очистить();

	Индекс = Новый Соответствие; // СкладКлюч -> рядок ТаблицаСкладов
	Для Каждого СтрРасх Из ТаблицаРасхождений Цикл
		Ключ = СокрЛП(СтрРасх.СкладКлюч);

		СтрСклад = Индекс.Получить(Ключ);
		Если СтрСклад = Неопределено Тогда
			СтрСклад = ТаблицаСкладов.Добавить();
			СтрСклад.Склад           = СтрРасх.Склад;
			СтрСклад.СкладКлюч       = Ключ;
			СтрСклад.Синхронизировать = Истина;
			Индекс.Вставить(Ключ, СтрСклад);
		КонецЕсли;

		СтрСклад.Позиций      = СтрСклад.Позиций + 1;
		СтрСклад.СуммаРазницы = СтрСклад.СуммаРазницы + ?(СтрРасх.Разница < 0, -СтрРасх.Разница, СтрРасх.Разница);
	КонецЦикла;

КонецПроцедуры

// ===========================
// РОЗДІЛ: ТОВАРИ
// ===========================

Процедура СравнитьОстатки_Товары(V83)

	КонецПериодаРасч = КонецДня(ОкончаниеПериода);

	// 1. Залишки ERP
	ТЗ_ЕРП = ПолучитьОстаткиЕРП_Товары(НачалоПериода, КонецПериодаРасч);

	// 2. Залишки BuhBud (через COM)
	ТЗ_Бух = ПолучитьОстаткиBuhBud_Товары(V83, НачалоПериода, КонецПериодаРасч);

	// 3. Злиття та пошук розбіжностей
	СвестиТаблицы_Товары(ТЗ_ЕРП, ТЗ_Бух);

КонецПроцедуры

// Залишки ERP з РегістрНакопления.ТоварыНаСкладах
//
Функция ПолучитьОстаткиЕРП_Товары(НачалоПериодаЗапр, КонецПериодаЗапр)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Номенклатура.А_ИдКод КАК НоменклатураИдКод,
	|	ПРЕДСТАВЛЕНИЕ(Т.Номенклатура) КАК НоменклатураПредставление,
	|	Т.Склад КАК Склад,
	|	Т.Склад.А_ИдКод КАК СкладИдКод,
	|	ПРЕДСТАВЛЕНИЕ(Т.Склад) КАК СкладПредставление,
	|	Т.ВНаличииНачальныйОстаток КАК НачОстаток,
	|	Т.ВНаличииПриход КАК Приход,
	|	Т.ВНаличииРасход КАК Расход,
	|	Т.ВНаличииКонечныйОстаток КАК КонОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			,
	|			(&ФильтрНоменклатура
	|				ИЛИ Номенклатура = &Номенклатура)
	|				И (&ФильтрСклад
	|					ИЛИ Склад = &Склад)) КАК Т
	|ГДЕ
	|	Т.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаЗапр);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаЗапр);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ФильтрНоменклатура", НЕ ЗначениеЗаполнено(Номенклатура));
	Запрос.УстановитьПараметр("ФильтрСклад", НЕ ЗначениеЗаполнено(Склад));

	Возврат Запрос.Выполнить().Выгрузить();
    
КонецФункции

// Залишки BuhBud через COM (РегістрБухгалтерії.Хозрасчетный)
// Рахунки: 281 (Товари), 20x (ВиробничіЗапаси), 26 (ГотоваПродукція), 22x (МШП)
// Динамічне визначення позиції субконто через ВидыСубконто
//
Функция ПолучитьОстаткиBuhBud_Товары(V83, НачалоПериодаЗапр, КонецПериодаЗапр)

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НоменклатураИдКод", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("СкладИдКод", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("СкладНаименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Результат.Колонки.Добавить("НоменклатураНаименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Результат.Колонки.Добавить("НачОстаток", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	Результат.Колонки.Добавить("Приход", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	Результат.Колонки.Добавить("Расход", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	Результат.Колонки.Добавить("КонОстаток", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));

	// Підготовка фільтрів по А_ИдКод
	НоменклатураИдКод = "";
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		НоменклатураИдКод = СокрЛП(Номенклатура.А_ИдКод);
	КонецЕсли;

	СкладИдКод = "";
	Если ЗначениеЗаполнено(Склад) Тогда
		СкладИдКод = СокрЛП(Склад.А_ИдКод);
	КонецЕсли;

		ЗапросОрганизаций = Новый Запрос;
	ЗапросОрганизаций.Текст =
	"ВЫБРАТЬ
	|	Организации.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.А_ВБалансе = ИСТИНА
	|	И Организации.КодПоЕДРПОУ <> """"";

	масКодПоЕДРПОУ = Новый Массив;
	ВыборкаОрганизаций = ЗапросОрганизаций.Выполнить().Выбрать();
	Пока ВыборкаОрганизаций.Следующий() Цикл
		масКодПоЕДРПОУ.Добавить(ВыборкаОрганизаций.КодПоЕДРПОУ);
	КонецЦикла;

	Если масКодПоЕДРПОУ.Количество() = 0 Тогда
		Сообщить("Немає організацій з флагом А_ВБалансе!");
		Возврат Неопределено;
	КонецЕсли;

	Запрос = V83.NewObject("Запрос");
	
		масКодПоЕДРПОУ_V83 = V83.NewObject("Массив");
	Для Каждого КодЕДРПОУ Из масКодПоЕДРПОУ Цикл
		масКодПоЕДРПОУ_V83.Добавить(КодЕДРПОУ);
	КонецЦикла;

	// Запит з динамічним визначенням позиції субконто
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.НоменклатураИдКод КАК НоменклатураИдКод,
	|	ВложенныйЗапрос.СкладИдКод КАК СкладИдКод,
	|	ВложенныйЗапрос.СкладНаименование КАК СкладНаименование,
	|	ВложенныйЗапрос.НоменклатураНаименование КАК НоменклатураНаименование,
	|	СУММА(ВложенныйЗапрос.НачОстаток) КАК НачОстаток,
	|	СУММА(ВложенныйЗапрос.Приход) КАК Приход,
	|	СУММА(ВложенныйЗапрос.Расход) КАК Расход,
	|	СУММА(ВложенныйЗапрос.КонОстаток) КАК КонОстаток
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВЫБОР
	|			КОГДА ПозицияНоменклатуры.НомерСтроки = 1
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура).А_ИдКод
	|			КОГДА ПозицияНоменклатуры.НомерСтроки = 2
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Номенклатура).А_ИдКод
	|			КОГДА ПозицияНоменклатуры.НомерСтроки = 3
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Номенклатура).А_ИдКод
	|			ИНАЧЕ """"
	|		КОНЕЦ КАК НоменклатураИдКод,
	|		ВЫБОР
	|			КОГДА ПозицияНоменклатуры.НомерСтроки = 1
	|				ТОГДА ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура))
	|			КОГДА ПозицияНоменклатуры.НомерСтроки = 2
	|				ТОГДА ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Номенклатура))
	|			КОГДА ПозицияНоменклатуры.НомерСтроки = 3
	|				ТОГДА ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Номенклатура))
	|			ИНАЧЕ """"
	|		КОНЕЦ КАК НоменклатураНаименование,
	|		ВЫБОР
	|			КОГДА ПозицияСклада.НомерСтроки = 1
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Склады).А_ИдКод
	|			КОГДА ПозицияСклада.НомерСтроки = 2
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Склады).А_ИдКод
	|			КОГДА ПозицияСклада.НомерСтроки = 3
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Склады).А_ИдКод
	|			ИНАЧЕ """"
	|		КОНЕЦ КАК СкладИдКод,
	|		ВЫБОР
	|			КОГДА ПозицияСклада.НомерСтроки = 1
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Склады).Наименование
	|			КОГДА ПозицияСклада.НомерСтроки = 2
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Склады).Наименование
	|			КОГДА ПозицияСклада.НомерСтроки = 3
	|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Склады).Наименование
	|			ИНАЧЕ """"
	|		КОНЕЦ КАК СкладНаименование,
	|		Остатки.КоличествоНачальныйОстаток КАК НачОстаток,
	|		Остатки.КоличествоОборотДт КАК Приход,
	|		Остатки.КоличествоОборотКт КАК Расход,
	|		Остатки.КоличествоКонечныйОстаток КАК КонОстаток
	|	ИЗ
	|		РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				,
	|				,
	|				Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Товары))
	|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПроизводственныеЗапасы))
	|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПриобретениеИзготовлениеОсновныхСредств))
	|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПриобретениеДругихНеоборотныхМатериальныхАктивов))
    |					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ГотоваяПродукция))
	|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.МалоценныеИБыстроизнашивающиесяПредметы)),
	|				,
	|				) КАК Остатки
	|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозицияНоменклатуры
	|			ПО Остатки.Счет = ПозицияНоменклатуры.Ссылка
	|				И (ПозицияНоменклатуры.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура))
	|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозицияСклада
	|			ПО Остатки.Счет = ПозицияСклада.Ссылка
	|				И (ПозицияСклада.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады))
	|	ГДЕ
	|		Остатки.Организация.КодПоЕДРПОУ В (&масКодПоЕДРПОУ)
	|		И (Остатки.КоличествоНачальныйОстаток <> 0
	|				ИЛИ Остатки.КоличествоОборотДт <> 0
	|				ИЛИ Остатки.КоличествоОборотКт <> 0)) КАК ВложенныйЗапрос
	|ГДЕ
	|	(&ФильтрНоменклатура
	|			ИЛИ ВложенныйЗапрос.НоменклатураИдКод = &НоменклатураИдКод)
	|	И (&ФильтрСклад
	|			ИЛИ ВложенныйЗапрос.СкладИдКод = &СкладИдКод)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.НоменклатураИдКод,
	|	ВложенныйЗапрос.СкладИдКод,
	|	ВложенныйЗапрос.СкладНаименование,
	|	ВложенныйЗапрос.НоменклатураНаименование";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаЗапр);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаЗапр);
	Запрос.УстановитьПараметр("НоменклатураИдКод", НоменклатураИдКод);
	Запрос.УстановитьПараметр("СкладИдКод", СкладИдКод);
	Запрос.УстановитьПараметр("ФильтрНоменклатура", НЕ ЗначениеЗаполнено(Номенклатура));
	Запрос.УстановитьПараметр("ФильтрСклад", НЕ ЗначениеЗаполнено(Склад));
    Запрос.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);

	Попытка
		ТЗ = Запрос.Выполнить().Выгрузить();
	Исключение
		Сообщить("Помилка запиту до BuhBud (Товари): " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	// Серіалізація та десеріалізація для передачі через COM
	стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗ);
	ТаблицаBuhBud = ЗначениеИзСтрокиВнутр(стр_ТЗ);

	Возврат ТаблицаBuhBud;

КонецФункции

// Злиття таблиць ERP та BuhBud — FULL OUTER JOIN по НоменклатураИдКод+СкладИдКод
// Результат записується у ТЧ ТаблицаРасхождений
//
Процедура СвестиТаблицы_Товары(ТЗ_ЕРП, ТЗ_Бух)

	// Індексована структура: Ключ -> {дані}
	Ключи = Новый Соответствие;

	// Склади-«обмінні» (реквізит А_ЭтоОбмен=Истина) — транзитні склади обміну,
	// у аналіз НЕ беремо (виключаємо за А_ИдКод одразу — покриває і ERP, і BuhBud сторону)
	ОбменныеСклады = Новый Соответствие;
	ЗапросОбмен = Новый Запрос;
	ЗапросОбмен.Текст =
	"ВЫБРАТЬ
	|	Склады.А_ИдКод КАК ИдКод
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	Склады.А_ЭтоОбмен = ИСТИНА
	|	И Склады.А_ИдКод <> """"";
	ВыборкаОбмен = ЗапросОбмен.Выполнить().Выбрать();
	Пока ВыборкаОбмен.Следующий() Цикл
		ОбменныеСклады.Вставить(ВРег(СокрЛП(ВыборкаОбмен.ИдКод)), Истина);
	КонецЦикла;

	// Додати дані ERP
	Для Каждого Стр Из ТЗ_ЕРП Цикл

		КлючНом = СокрЛП(Стр.НоменклатураИдКод);
		КлючСкл = СокрЛП(Стр.СкладИдКод);
		Ключ = КлючНом + "|" + КлючСкл;

		Запись = Ключи.Получить(Ключ);
		Если Запись = Неопределено Тогда
			Запись = Новый Структура(
				"НоменклатураПредставление, СкладПредставление, КлючНом, КлючСкл,
				|НоменклатураСсылка, СкладСсылка,
				|НачЕРП, ПриходЕРП, РасходЕРП, ОстатокЕРП,
				|НачБух, ПриходБух, РасходБух, ОстатокБух",
				Стр.НоменклатураПредставление, Стр.СкладПредставление, КлючНом, КлючСкл,
				Стр.Номенклатура, Стр.Склад,
				0, 0, 0, 0,
				0, 0, 0, 0);
			Ключи.Вставить(Ключ, Запись);
		КонецЕсли;

		Запись.НачЕРП     = Запись.НачЕРП     + Стр.НачОстаток;
		Запись.ПриходЕРП  = Запись.ПриходЕРП  + Стр.Приход;
		Запись.РасходЕРП  = Запись.РасходЕРП  + Стр.Расход;
		Запись.ОстатокЕРП = Запись.ОстатокЕРП + Стр.КонОстаток;
	КонецЦикла;

	// Додати дані BuhBud
	Для Каждого Стр Из ТЗ_Бух Цикл

		КлючНом = СокрЛП(Стр.НоменклатураИдКод);
		КлючСкл = СокрЛП(Стр.СкладИдКод);
		Ключ = КлючНом + "|" + КлючСкл;

		Запись = Ключи.Получить(Ключ);
		Если Запись = Неопределено Тогда
			// Є в BuhBud, немає в ERP — знайти ссылки по А_ИдКод
			НомСсылка = Справочники.Номенклатура.НайтиПоРеквизиту("А_ИдКод", КлючНом);
			СклСсылка = Справочники.Склады.НайтиПоРеквизиту("А_ИдКод", КлючСкл);
			НомПредст = ?(ЗначениеЗаполнено(НомСсылка), Строка(НомСсылка), СокрЛП(Стр.НоменклатураНаименование));
			Если НЕ ЗначениеЗаполнено(НомПредст) Тогда
				НомПредст = "ІдКод: " + КлючНом;
			КонецЕсли;
			СклПредст = ?(ЗначениеЗаполнено(СклСсылка), Строка(СклСсылка), СокрЛП(Стр.СкладНаименование));
			Если НЕ ЗначениеЗаполнено(СклПредст) Тогда
				СклПредст = "ІдКод: " + КлючСкл;
			КонецЕсли;

			Запись = Новый Структура(
				"НоменклатураПредставление, СкладПредставление, КлючНом, КлючСкл,
				|НоменклатураСсылка, СкладСсылка,
				|НачЕРП, ПриходЕРП, РасходЕРП, ОстатокЕРП,
				|НачБух, ПриходБух, РасходБух, ОстатокБух",
				НомПредст, СклПредст, КлючНом, КлючСкл,
				НомСсылка, СклСсылка,
				0, 0, 0, 0,
				0, 0, 0, 0);
			Ключи.Вставить(Ключ, Запись);
		КонецЕсли;

		Запись.НачБух     = Запись.НачБух     + Стр.НачОстаток;
		Запись.ПриходБух  = Запись.ПриходБух  + Стр.Приход;
		Запись.РасходБух  = Запись.РасходБух  + Стр.Расход;
		Запись.ОстатокБух = Запись.ОстатокБух + Стр.КонОстаток;
	КонецЦикла;

	// Заповнення ТаблицаРасхождений — тільки рядки з розбіжностями
	Для Каждого КлючЗначение Из Ключи Цикл

		Запись = КлючЗначение.Значение;

		// Пропустити склади-«обмінні»
		Если ОбменныеСклады.Получить(ВРег(СокрЛП(Запись.КлючСкл))) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Разница = Запись.ОстатокЕРП - Запись.ОстатокБух;

		Если Окр(Разница, 3) = 0
			И Окр(Запись.НачЕРП - Запись.НачБух, 3) = 0
			И Окр(Запись.ПриходЕРП - Запись.ПриходБух, 3) = 0
			И Окр(Запись.РасходЕРП - Запись.РасходБух, 3) = 0 Тогда
			Продолжить; // Немає розбіжностей
		КонецЕсли;

		НС = ТаблицаРасхождений.Добавить();
		НС.Раздел              = "Товари";
		НС.Номенклатура          = ?(ЗначениеЗаполнено(Запись.НоменклатураСсылка), Запись.НоменклатураСсылка, Запись.НоменклатураПредставление);
		НС.Склад          = ?(ЗначениеЗаполнено(Запись.СкладСсылка), Запись.СкладСсылка, Запись.СкладПредставление);
		НС.НачОстатокЕРП       = Запись.НачЕРП;
		НС.НачОстатокБух       = Запись.НачБух;
		НС.ПриходЕРП           = Запись.ПриходЕРП;
		НС.ПриходБух           = Запись.ПриходБух;
		НС.РасходЕРП           = Запись.РасходЕРП;
		НС.РасходБух           = Запись.РасходБух;
		НС.ОстатокЕРП          = Запись.ОстатокЕРП;
		НС.ОстатокБух          = Запись.ОстатокБух;
		НС.Разница             = Разница;
		НС.Синхронизировать    = Истина;
		НС.НоменклатураКлюч    = Запись.КлючНом;
		НС.СкладКлюч    = Запись.КлючСкл;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

// ===========================================================================
// ФАЗА 2: Аналіз документів (через СоответствияОбъектовИнформационныхБаз)
// ===========================================================================

#Область Фаза2_АналізДокументів

// Головна функція Фази 2 — аналіз документів по складах
//
// ИндексСклада = -1 → аналіз усіх відмічених складів ТаблицаСкладов;
//             >= 0 → аналіз лише одного складу за індексом (команда «Аналіз поточного складу»).
// Для кожного складу обробляються ВСІ його позиції (Номенклатура×Склад) з ТаблицаРасхождений.
//
Функция АнализироватьДокументы(ИндексСклада = -1) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ТаблицаДокументов.Очистить();

	// Цільові склади
	Склади = Новый Массив;
	Если ИндексСклада >= 0 Тогда
		Если ИндексСклада >= ТаблицаСкладов.Количество() Тогда
			Возврат "Невірний номер рядка складу";
		КонецЕсли;
		Склади.Добавить(ТаблицаСкладов[ИндексСклада]);
	Иначе
		Для Каждого СтрСклад Из ТаблицаСкладов Цикл
			Если СтрСклад.Синхронизировать Тогда
				Склади.Добавить(СтрСклад);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Склади.Количество() = 0 Тогда
		Возврат "Немає відмічених складів для аналізу";
	КонецЕсли;

	// Документи очищені → скинути лічильники аналізу всіх складів
	Для Каждого СтрСклад Из ТаблицаСкладов Цикл
		СтрСклад.Документов        = 0;
		СтрСклад.Действий               = 0;
		СтрСклад.ТребуютРешения = 0;
	КонецЦикла;

	V83 = ПодключитьсяКBuhBud();
	Если V83 = Неопределено Тогда
		Возврат "Помилка підключення до BuhBud";
	КонецЕсли;

	// Отримати вузол обміну в BuhBud
	УзелОбмена = Неопределено;
	Попытка
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20 ГДЕ НЕ ЭтотУзел";
		V83_Рез = V83_Запрос.Выполнить().Выбрать();
		Если V83_Рез.Следующий() Тогда
			УзелОбмена = V83_Рез.Ссылка;
		КонецЕсли;
	Исключение
		Сообщить("Не вдалося знайти вузол обміну в BuhBud: " + ОписаниеОшибки());
	КонецПопытки;

	Для Каждого СтрСклад Из Склади Цикл
		КлючСклада = СокрЛП(СтрСклад.СкладКлюч);
		ДоДок = ТаблицаДокументов.Количество();

		// Усі позиції цього складу
		Для Каждого СтрРасх Из ТаблицаРасхождений Цикл
			Если СокрЛП(СтрРасх.СкладКлюч) <> КлючСклада Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				АнализДокументов_Товары(V83, СтрРасх, УзелОбмена);
			Исключение
				Сообщить("ПОМИЛКА аналізу " + Строка(СтрРасх.Номенклатура) + " (" + Строка(СтрСклад.Склад) + "): " + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;

		// Лічильники складу по доданих рядках документів
		Для Сч = ДоДок По ТаблицаДокументов.Количество() - 1 Цикл
			СтрДок = ТаблицаДокументов[Сч];
			СтрДок.ЕстьРасхождение = НЕ СтрНачинаетсяС(СтрДок.Статус, "ОК")
				И НЕ СтрНачинаетсяС(СтрДок.Статус, "Збігається");
			СтрСклад.Документов = СтрСклад.Документов + 1;
			Если СтрДок.ЕстьРасхождение Тогда
				Если ЗначениеЗаполнено(СтрДок.Действие) Тогда
					СтрСклад.Действий = СтрСклад.Действий + 1;
				Иначе
					СтрСклад.ТребуютРешения = СтрСклад.ТребуютРешения + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	V83 = Неопределено;
	Возврат "Документів для синхронізації: " + Строка(ТаблицаДокументов.Количество());

КонецФункции

// ===========================
// ТОВАРИ — аналіз документів
// ===========================
Процедура АнализДокументов_Товары(V83, СтрРасх, УзелОбмена)

	КонецПериодаРасч = КонецДня(ОкончаниеПериода);

	// 1. Обороти по документах ERP + LEFT JOIN з СоответствияОбъектовИнформационныхБаз
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Об.Регистратор КАК Регистратор,
	|	ПРЕДСТАВЛЕНИЕ(Об.Регистратор) КАК РегистраторПредст,
	|	Об.ВНаличииПриход КАК Приход,
	|	Об.ВНаличииРасход КАК Расход,
	|	Соотв.УникальныйИдентификаторПриемника КАК UIDвBuhBud,
	|	Соотв.ТипПриемника КАК ТипПриемника,
	|	Соотв.ТипИсточника КАК ТипИсточника
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Обороты(
	|		&НачалоПериода, &КонецПериода, Авто,
	|		Номенклатура.А_ИдКод = &НоменклатураИдКод
	|			И Склад.А_ИдКод = &СкладИдКод) КАК Об
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
	|	ПО Об.Регистратор = Соотв.УникальныйИдентификаторИсточника
	|		И (Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20)";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаРасч);
	Запрос.УстановитьПараметр("НоменклатураИдКод", СтрРасх.НоменклатураКлюч);
	Запрос.УстановитьПараметр("СкладИдКод", СтрРасх.СкладКлюч);

	ТЗ_Док = Запрос.Выполнить().Выгрузить();

	// 2. Обробка кожного документа ERP
	ОбробитиДокументиЕРП(V83, ТЗ_Док, СтрРасх, УзелОбмена);

	// 3. Зворотній аналіз: документи BuhBud, яких немає в ЕРП
	АнализДокументовBuhBud_Товары(V83, СтрРасх);

КонецПроцедуры

// ===========================
// ТОВАРИ — зворотній аналіз документів BuhBud
// ===========================
// Знаходить документи в BuhBud, які не мають відповідників в ЕРП
// (рухають товарні рахунки з тією ж Номенклатурою та Складом)
//
Процедура АнализДокументовBuhBud_Товары(V83, СтрРасх)

	КонецПериодаРасч = КонецДня(ОкончаниеПериода);

	// 1. Зібрати UUID документів BuhBud, які вже знайдені через ЕРП аналіз
	ВжеЗнайдені = Новый Соответствие;
	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если ЗначениеЗаполнено(СтрДок.UIDДокументаБух) Тогда
			ВжеЗнайдені.Вставить(ВРег(СокрЛП(СтрДок.UIDДокументаБух)), Истина);
		КонецЕсли;
	КонецЦикла;

	// Карта по UUID документа BuhBud — надійний пошук строки
	МапаПоUIDБух = Новый Соответствие;
	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если ЗначениеЗаполнено(СтрДок.UIDДокументаБух)
			И СтрДок.Раздел = СтрРасх.Раздел
			И СтрДок.Номенклатура = СтрРасх.Номенклатура Тогда
			МапаПоUIDБух.Вставить(ВРег(СокрЛП(СтрДок.UIDДокументаБух)), СтрДок);
		КонецЕсли;
	КонецЦикла;

	// Додатково: карта по представленню документа BuhBud для fallback
	МапаПоПредставлению = Новый Соответствие;
	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если ЗначениеЗаполнено(СтрДок.ДокументБух)
			И СтрДок.Раздел = СтрРасх.Раздел
			И СтрДок.Номенклатура = СтрРасх.Номенклатура Тогда
			МапаПоПредставлению.Вставить(СтрДок.ДокументБух, СтрДок);
		КонецЕсли;
	КонецЦикла;

	// 2. Підготовка масиву організацій для фільтру
	// ЕДРПОУ беремо з ЕРП (де є А_ВБалансе), потім передаємо в BuhBud через COM
	ЗапросОрганизаций = Новый Запрос;
	ЗапросОрганизаций.Текст =
	"ВЫБРАТЬ
	|	Организации.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.А_ВБалансе = ИСТИНА
	|	И Организации.КодПоЕДРПОУ <> """"";

	масКодПоЕДРПОУ = Новый Массив;
	ВыборкаОрганизаций = ЗапросОрганизаций.Выполнить().Выбрать();
	Пока ВыборкаОрганизаций.Следующий() Цикл
		масКодПоЕДРПОУ.Добавить(ВыборкаОрганизаций.КодПоЕДРПОУ);
	КонецЦикла;

	Если масКодПоЕДРПОУ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	масКодПоЕДРПОУ_V83 = V83.NewObject("Массив");
	Для Каждого КодЕДРПОУ Из масКодПоЕДРПОУ Цикл
		масКодПоЕДРПОУ_V83.Добавить(КодЕДРПОУ);
	КонецЦикла;

	// 3. Запит до BuhBud: ОстаткиИОбороты з періодичністю Регістратор
	// Універсальний: INNER JOIN по Номенклатурі (працює на ВСІХ рахунках з субконто Номенклатура)
	// Без жорсткого фільтру по 5 групах рахунків
	Попытка
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст =
		"ВЫБРАТЬ
		|	ВЗ.Регистратор КАК Регистратор,
		|	ПРЕДСТАВЛЕНИЕ(ВЗ.Регистратор) КАК РегистраторПредст,
		|	СУММА(ВЗ.КоличествоПриход) - СУММА(ВЗ.КоличествоРасход) КАК КоличествоИтого
		|ИЗ
		|	(ВЫБРАТЬ
		|		Ост.Регистратор КАК Регистратор,
		|		Ост.КоличествоОборотДт КАК КоличествоПриход,
		|		Ост.КоличествоОборотКт КАК КоличествоРасход,
		|		Ост.СуммаОборотДт - Ост.СуммаОборотКт КАК СуммаНетто
		|	ИЗ
		|		РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		|				&НачалоПериода,
		|				&КонецПериода,
		|				Регистратор,
		|				,
		|				,
		|				,
		|				) КАК Ост
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозНом
		|			ПО Ост.Счет = ПозНом.Ссылка
		|				И (ПозНом.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура))
		|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозСкл
		|			ПО Ост.Счет = ПозСкл.Ссылка
		|				И (ПозСкл.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады))
		|	ГДЕ
		|		(Ост.КоличествоОборотДт <> 0 ИЛИ Ост.КоличествоОборотКт <> 0)
		|		И Ост.Организация.КодПоЕДРПОУ В (&масКодПоЕДРПОУ)
		|		И (ВЫБОР
		|			КОГДА ПозНом.НомерСтроки = 1
		|				ТОГДА ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура).А_ИдКод
		|			КОГДА ПозНом.НомерСтроки = 2
		|				ТОГДА ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.Номенклатура).А_ИдКод
		|			КОГДА ПозНом.НомерСтроки = 3
		|				ТОГДА ВЫРАЗИТЬ(Ост.Субконто3 КАК Справочник.Номенклатура).А_ИдКод
		|			ИНАЧЕ """"
		|		КОНЕЦ) = &НоменклатураИдКод
		|		И ((ВЫБОР
		|			КОГДА ПозСкл.НомерСтроки = 1
		|				ТОГДА ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Склады).А_ИдКод
		|			КОГДА ПозСкл.НомерСтроки = 2
		|				ТОГДА ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.Склады).А_ИдКод
		|			КОГДА ПозСкл.НомерСтроки = 3
		|				ТОГДА ВЫРАЗИТЬ(Ост.Субконто3 КАК Справочник.Склады).А_ИдКод
		|			ИНАЧЕ """"
		|		КОНЕЦ) = &СкладИдКод
		|			ИЛИ ПозСкл.НомерСтроки ЕСТЬ NULL)) КАК ВЗ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЗ.Регистратор
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВЗ.СуммаНетто) <> 0";

		V83_Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		V83_Запрос.УстановитьПараметр("КонецПериода", КонецПериодаРасч);
		V83_Запрос.УстановитьПараметр("НоменклатураИдКод", СтрРасх.НоменклатураКлюч);
		V83_Запрос.УстановитьПараметр("СкладИдКод", СтрРасх.СкладКлюч);
		V83_Запрос.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);

		V83_Рез = V83_Запрос.Выполнить().Выбрать();
		КолДокBuhBud = 0;
		Пока V83_Рез.Следующий() Цикл
			КолДокBuhBud = КолДокBuhBud + 1;

			// Отримати UUID документа BuhBud
			UIDДок = "";
			Попытка
				UIDДок = ВРег(V83.XMLСтрока(V83_Рез.Регистратор.УникальныйИдентификатор()));
			Исключение
				Продолжить;
			КонецПопытки;

			// Представлення документа BuhBud
			ПредстБух = СокрЛП(V83_Рез.РегистраторПредст);

			// Перевірити чи документ вже знайдений через ЕРП аналіз
			Если ВжеЗнайдені.Получить(UIDДок) <> Неопределено Тогда
				// Пошук строки по UUID (надійний)
				НайденаСтрока = МапаПоUIDБух.Получить(UIDДок);
				// Fallback по представленню
				Если НайденаСтрока = Неопределено Тогда
					НайденаСтрока = МапаПоПредставлению.Получить(ПредстБух);
				КонецЕсли;
				Если НайденаСтрока <> Неопределено Тогда
					НайденаСтрока.КоличествоБух = V83_Рез.КоличествоИтого;
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			// Fallback: пошук по представленню документа (якщо UUID не в ВжеЗнайдені)
			НайденаСтрока = МапаПоUIDБух.Получить(UIDДок);
			Если НайденаСтрока = Неопределено Тогда
				НайденаСтрока = МапаПоПредставлению.Получить(ПредстБух);
			КонецЕсли;
			Если НайденаСтрока <> Неопределено Тогда
				НайденаСтрока.КоличествоБух = V83_Рез.КоличествоИтого;
				Продолжить;
			КонецЕсли;

			// Визначити тип документа BuhBud
			ТипБух = "";
			Попытка
				ТипБух = V83_Рез.Регистратор.Метаданные().Имя;
			Исключение
			КонецПопытки;

			// Перевірити чи є відповідність в ЕРП (документ може існувати але не проведений)
			ДокЕРППредставлення = "";
			ДокЕРПСсылка = Неопределено;
			UIDДокЕРП = "";
			ЕстьВідповідність = Ложь;
			ДіяДок = "На обмін в BuhBud";
			СтатусДок = "Існує тільки в BuhBud";
			Попытка
				ЗапросСоотв = Новый Запрос;
				ЗапросСоотв.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Соотв.УникальныйИдентификаторИсточника КАК Источник,
				|	Соотв.ТипИсточника КАК ТипИсточника
				|ИЗ
				|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
				|ГДЕ
				|	Соотв.УникальныйИдентификаторПриемника = &UIDПриемника
				|	И Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20";
				ЗапросСоотв.УстановитьПараметр("UIDПриемника", UIDДок);
				РезСоотв = ЗапросСоотв.Выполнить().Выбрать();
				Если РезСоотв.Следующий() Тогда
					ЕстьВідповідність = Истина;
					ДокЕРПСсылка = РезСоотв.Источник;
					UIDДокЕРП = Строка(РезСоотв.Источник.УникальныйИдентификатор());
					ДокЕРППредставлення = Строка(РезСоотв.Источник);
					// Перевірити чи проведений
					Если РезСоотв.Источник.Проведен Тогда
						ДіяДок = "Переобмін";
						СтатусДок = "Проведений в ЕРП, немає рухів по обраному складу";
					Иначе
						ДіяДок = "Провести в ЕРП";
						СтатусДок = "Не проведений в ЕРП";
					КонецЕсли;
				КонецЕсли;
			Исключение
			КонецПопытки;

			// Додати строку
			НС = ТаблицаДокументов.Добавить();
			НС.Раздел          = СтрРасх.Раздел;
			НС.Номенклатура      = СтрРасх.Номенклатура;
			НС.Склад      = СтрРасх.Склад;
			НС.ТипДокумента    = ТипБух;
			НС.ДокументЕРП     = ?(ДокЕРПСсылка <> Неопределено, ДокЕРПСсылка, ДокЕРППредставлення);
			НС.ДокументБух     = ПредстБух;
			НС.КоличествоЕРП   = 0;
			НС.КоличествоБух   = V83_Рез.КоличествоИтого;
			НС.UIDДокумента    = UIDДокЕРП;
			НС.UIDДокументаБух = UIDДок;
			НС.ЕстьСоответствие = ЕстьВідповідність;
			НС.Действие        = ДіяДок;
			НС.Статус          = СтатусДок;
			НС.Синхронизировать = Истина;

		КонецЦикла;

	Исключение
		Сообщить("Помилка зворотнього аналізу BuhBud (Товари): " + ОписаниеОшибки());
	КонецПопытки;

	// Фінальна перевірка: якщо К-ть ЕРП = К-ть Бух — документ збігається, не потребує переобміну.
	// Фільтр по складу (Склад) теж — інакше при однаковій Номенклатурі на кількох складах
	// reset зачепив би рядки іншого (раніше обробленого) складу, чиї лічильники вже зафіксовані.
	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если СтрДок.Раздел <> СтрРасх.Раздел
			ИЛИ СтрДок.Номенклатура <> СтрРасх.Номенклатура
			ИЛИ СтрДок.Склад <> СтрРасх.Склад Тогда
			Продолжить;
		КонецЕсли;
		Если (СтрДок.Действие = "Переобмін" ИЛИ СтрДок.Действие = "Перепровести в ЕРП")
			И СтрДок.КоличествоЕРП = СтрДок.КоличествоБух
			И СтрДок.КоличествоЕРП <> 0 Тогда
			СтрДок.Действие = "";
			СтрДок.Статус   = "Збігається";
			СтрДок.Синхронизировать = Ложь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// ===========================
// Загальна обробка документів ERP
// ===========================
// Для кожного документа перевіряє відповідність в BuhBud та визначає дію
//
Процедура ОбробитиДокументиЕРП(V83, ТЗ_Док, СтрРасх, УзелОбмена)

	Для Каждого СтрДок Из ТЗ_Док Цикл

		НС = ТаблицаДокументов.Добавить();
		НС.Раздел          = СтрРасх.Раздел;
		НС.Номенклатура      = СтрРасх.Номенклатура;
		НС.Склад      = СтрРасх.Склад;
		НС.ДокументЕРП     = СтрДок.Регистратор;
		НС.КоличествоЕРП   = СтрДок.Приход - СтрДок.Расход;
		НС.UIDДокумента    = Строка(СтрДок.Регистратор.УникальныйИдентификатор());
		НС.Синхронизировать = Истина;

		// Визначити тип документа ERP
		ТипИст = "";
		Попытка
			ТипИст = СокрЛП(СтрДок.ТипИсточника);
			ТипИст = СтрЗаменить(ТипИст, "ДокументСсылка.", "");
		Исключение
		КонецПопытки;
		Если НЕ ЗначениеЗаполнено(ТипИст) Тогда
			Попытка
				МетаОбъекта = СтрДок.Регистратор.Метаданные();
				ТипИст = МетаОбъекта.Имя;
			Исключение
			КонецПопытки;
		КонецЕсли;
		НС.ТипДокумента = ТипИст;

		// Перевірка наявності відповідності
		UIDвBuhBud = Неопределено;
		Попытка
			UIDвBuhBud = СтрДок.UIDвBuhBud;
		Исключение
		КонецПопытки;

		Если UIDвBuhBud <> Неопределено И ЗначениеЗаполнено(UIDвBuhBud) Тогда
			// Є відповідність — перевіряємо стан документа в BuhBud
			НС.ЕстьСоответствие = Истина;
			НС.UIDДокументаБух  = Строка(UIDвBuhBud);

			ТипПрием = "";
			Попытка
				ТипПрием = СокрЛП(СтрДок.ТипПриемника);
				ТипПрием = СтрЗаменить(ТипПрием, "ДокументСсылка.", "");
			Исключение
			КонецПопытки;

			Если ЗначениеЗаполнено(ТипПрием) Тогда
				ПроверитьДокументВBuhBud(V83, НС, ТипПрием, UIDвBuhBud, УзелОбмена);
			Иначе
				НС.Действие = "Невідомий тип";
				НС.Статус   = "Тип приемника не визначено";
			КонецЕсли;
		Иначе
			// Немає відповідності — документ ніколи не відправлявся
			НС.ЕстьСоответствие = Ложь;
			НС.Действие = "Розпровести в ЕРП";
			НС.Статус   = "Немає в BuhBud (немає відповідності)";
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Перевірка документа в BuhBud через COM
//
Процедура ПроверитьДокументВBuhBud(V83, НС, ТипПриемника, UIDвBuhBud, УзелОбмена)

	Попытка
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст =
			"ВЫБРАТЬ Ссылка, Проведен, ПометкаУдаления, ПРЕДСТАВЛЕНИЕ(Ссылка) КАК Представление ИЗ Документ." + ТипПриемника
			+ " ГДЕ Ссылка = &Ссылка";

		СсылкаBuhBud = V83.Документы[ТипПриемника].ПолучитьСсылку(
			V83.NewObject("УникальныйИдентификатор", Строка(UIDвBuhBud)));
		V83_Запрос.УстановитьПараметр("Ссылка", СсылкаBuhBud);

		V83_Рез = V83_Запрос.Выполнить().Выбрать();
		Если V83_Рез.Следующий() Тогда
			НС.ДокументБух = СокрЛП(V83_Рез.Представление);

			Если V83_Рез.ПометкаУдаления Тогда
				// Документ видалено в BuhBud
				НС.Действие = "Розпровести в ЕРП";
				НС.Статус   = "Видалений в BuhBud";
			ИначеЕсли НЕ V83_Рез.Проведен Тогда
				// Документ не проведений в BuhBud — поставити на обмін
				НС.Действие = "На обмін в BuhBud";
				НС.Статус   = "Не проведений в BuhBud";
				НС.ТипДокумента = ТипПриемника;
			Иначе
				// Проведений в ЕРП і BuhBud, рухи різняться → перепровести в ЕРП (регенерувати рухи)
				НС.Действие = "Перепровести в ЕРП";
				НС.Статус   = "Проведений, різниця в рухах";
				НС.ТипДокумента = ТипПриемника;
			КонецЕсли;

			// Кількість Бух по товарах встановлюється в АнализДокументовBuhBud_Товары
			// (UNION ALL з фільтром по Номенклатурі), тут нічого не робимо

			// Якщо суми співпадають — документ ОК, не потребує дії
			Если (НС.Действие = "Переобмін" ИЛИ НС.Действие = "Перепровести в ЕРП")
				И Окр(НС.КоличествоЕРП - НС.КоличествоБух, 2) = 0 Тогда
				НС.Действие = "";
				НС.Статус   = "ОК";
				НС.Синхронизировать = Ложь;
			КонецЕсли;

		Иначе
			// Документ не знайдено — видалений або UUID невірний
			НС.Действие = "Розпровести в ЕРП";
			НС.Статус   = "Не знайдено в BuhBud";
		КонецЕсли;
	Исключение
		НС.Действие = "Помилка";
		НС.Статус   = "Помилка COM: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

// ===========================================================================
// ФАЗА 3: Синхронізація
// ===========================================================================

#Область Фаза3_Синхронізація

// Головна функція Фази 3 — виконання синхронізації всіх відмічених документів
//
Функция ВыполнитьСинхронизацию() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	V83 = Неопределено;
	УзелОбмена = Неопределено;
	КількістьОброблених = 0;
	КількістьПомилок    = 0;

	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если НЕ СтрДок.Синхронизировать Тогда
			Продолжить;
		КонецЕсли;
		ВыполнитьДействиеСтроки(СтрДок, V83, УзелОбмена, КількістьОброблених, КількістьПомилок);
	КонецЦикла;

	V83 = Неопределено;

	Возврат "Оброблено: " + КількістьОброблених + ", Помилок: " + КількістьПомилок;

КонецФункции

// (Застаріле: кнопку «Дія по рядку» прибрано з форми; функція не викликається UI, лишено для сумісності)
//
Функция ВыполнитьСинхронизациюСтроки(ИндексСтроки) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если ИндексСтроки < 0 ИЛИ ИндексСтроки >= ТаблицаДокументов.Количество() Тогда
		Возврат "Невірний номер рядка";
	КонецЕсли;

	СтрДок = ТаблицаДокументов[ИндексСтроки];
	Если НЕ ЗначениеЗаполнено(СтрДок.Действие) Тогда
		Возврат "Для рядка немає дії";
	КонецЕсли;

	V83 = Неопределено;
	УзелОбмена = Неопределено;
	Оброблено = 0;
	Помилок = 0;

	ВыполнитьДействиеСтроки(СтрДок, V83, УзелОбмена, Оброблено, Помилок);

	V83 = Неопределено;

	Возврат СтрДок.Статус;

КонецФункции

// Диспетчер дії рядка. V83/УзелОбмена передаються за посиланням — ліниве підключення раз на пакет
//
Процедура ВыполнитьДействиеСтроки(СтрДок, V83, УзелОбмена, КількістьОброблених, КількістьПомилок)

	Если СтрДок.Действие = "Розпровести в ЕРП" Тогда
		Попытка
			РаспровестиВЕРП(СтрДок);
			УчестьРезультатСтроки(СтрДок, КількістьОброблених, КількістьПомилок);
		Исключение
			СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
			КількістьПомилок = КількістьПомилок + 1;
		КонецПопытки;

	ИначеЕсли СтрДок.Действие = "Провести в ЕРП" Тогда
		Попытка
			ПровестиВЕРП(СтрДок);
			УчестьРезультатСтроки(СтрДок, КількістьОброблених, КількістьПомилок);
		Исключение
			СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
			КількістьПомилок = КількістьПомилок + 1;
		КонецПопытки;

	ИначеЕсли СтрДок.Действие = "На обмін в BuhBud"
		ИЛИ СтрДок.Действие = "Переобмін" Тогда

		// Ліниве підключення до BuhBud (тільки якщо потрібно)
		Если V83 = Неопределено Тогда
			V83 = ПодключитьсяКBuhBud();
			Если V83 = Неопределено Тогда
				СтрДок.Статус = "ПОМИЛКА: Немає підключення до BuhBud";
				КількістьПомилок = КількістьПомилок + 1;
				Возврат;
			КонецЕсли;
			// Знайти вузол обміну
			Попытка
				V83_З = V83.NewObject("Запрос");
				V83_З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20 ГДЕ НЕ ЭтотУзел";
				V83_Рез = V83_З.Выполнить().Выбрать();
				Если V83_Рез.Следующий() Тогда
					УзелОбмена = V83_Рез.Ссылка;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;

		Попытка
			ПоставитьНаОбменВBuhBud(V83, СтрДок, УзелОбмена);
			УчестьРезультатСтроки(СтрДок, КількістьОброблених, КількістьПомилок);
		Исключение
			СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
			КількістьПомилок = КількістьПомилок + 1;
		КонецПопытки;

	ИначеЕсли СтрДок.Действие = "Перепровести в ЕРП" Тогда
		Попытка
			ПерепровестиВЕРП(СтрДок);
			УчестьРезультатСтроки(СтрДок, КількістьОброблених, КількістьПомилок);
		Исключение
			СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
			КількістьПомилок = КількістьПомилок + 1;
		КонецПопытки;

	Иначе
		СтрДок.Статус = "ПОМИЛКА: невідома дія """ + СтрДок.Действие + """";
		КількістьПомилок = КількістьПомилок + 1;
	КонецЕсли;

КонецПроцедуры

// «М'які» помилки (Статус = ПОМИЛКА без винятку) — теж помилки
//
Процедура УчестьРезультатСтроки(СтрДок, КількістьОброблених, КількістьПомилок)

	Если СтрНачинаетсяС(СтрДок.Статус, "ПОМИЛКА") Тогда
		КількістьПомилок = КількістьПомилок + 1;
	Иначе
		КількістьОброблених = КількістьОброблених + 1;
	КонецЕсли;

КонецПроцедуры

// Розпровести документ в ЕРП
//
Процедура РаспровестиВЕРП(СтрДок)

	UIDСтрока = СокрЛП(СтрДок.UIDДокумента);
	Если НЕ ЗначениеЗаполнено(UIDСтрока) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа";
		Возврат;
	КонецЕсли;

	// Знайти документ по UUID
	ТипДок = СокрЛП(СтрДок.ТипДокумента);
	МенеджерДок = Документы[ТипДок];
	СсылкаДок = МенеджерДок.ПолучитьСсылку(Новый УникальныйИдентификатор(UIDСтрока));

	Если НЕ ЗначениеЗаполнено(СсылкаДок) ИЛИ СсылкаДок.Пустая() Тогда
		СтрДок.Статус = "ПОМИЛКА: Документ не знайдено в ЕРП";
		Возврат;
	КонецЕсли;

	ДокОбъект = СсылкаДок.ПолучитьОбъект();
	ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	СтрДок.Статус = "Розпроведено в ЕРП";

КонецПроцедуры

// Провести непроведений документ в ЕРП
//
Процедура ПровестиВЕРП(СтрДок)

	UIDСтрока = СокрЛП(СтрДок.UIDДокумента);
	Если НЕ ЗначениеЗаполнено(UIDСтрока) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа ЕРП";
		Возврат;
	КонецЕсли;

	// Знайти тип документа ЕРП по UUID через СоответствияОбъектовИнформационныхБаз
	ТипДок = "";
	Попытка
		ЗапросТип = Новый Запрос;
		ЗапросТип.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Соотв.УникальныйИдентификаторИсточника КАК Источник,
		|	Соотв.ТипИсточника КАК ТипИсточника
		|ИЗ
		|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
		|ГДЕ
		|	Соотв.УникальныйИдентификаторПриемника = &UIDПриемника
		|	И Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20";
		ЗапросТип.УстановитьПараметр("UIDПриемника", СокрЛП(СтрДок.UIDДокументаБух));
		РезТип = ЗапросТип.Выполнить().Выбрать();
		Если РезТип.Следующий() Тогда
			ДокОбъект = РезТип.Источник.ПолучитьОбъект();
			Если ДокОбъект = Неопределено Тогда
				СтрДок.Статус = "ПОМИЛКА: Документ не знайдено в ЕРП";
				Возврат;
			КонецЕсли;
			Если ДокОбъект.Проведен Тогда
				СтрДок.Статус = "Вже проведений";
				Возврат;
			КонецЕсли;
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			СтрДок.Статус = "Проведено в ЕРП";
		Иначе
			СтрДок.Статус = "ПОМИЛКА: Відповідність не знайдена";
		КонецЕсли;
	Исключение
		СтрДок.Статус = "ПОМИЛКА проведення: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Поставити документ на обмін в BuhBud
//
Процедура ПоставитьНаОбменВBuhBud(V83, СтрДок, УзелОбмена)

	Если УзелОбмена = Неопределено Тогда
		СтрДок.Статус = "ПОМИЛКА: Вузол обміну не знайдено";
		Возврат;
	КонецЕсли;

	UIDСтрока = СокрЛП(СтрДок.UIDДокументаБух);
	Если НЕ ЗначениеЗаполнено(UIDСтрока) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа в BuhBud";
		Возврат;
	КонецЕсли;

	// ТипДокумента вже містить тип BuhBud (встановлений на етапі аналізу)
	ТипПриемника = СокрЛП(СтрДок.ТипДокумента);

	// Отримати посилання на документ в BuhBud
	СсылкаBuhBud = V83.Документы[ТипПриемника].ПолучитьСсылку(
		V83.NewObject("УникальныйИдентификатор", UIDСтрока));

	// Зареєструвати зміни на вузлі обміну
	V83.ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, СсылкаBuhBud);
	СтрДок.Статус = "Зареєстровано на обмін в BuhBud";

КонецПроцедуры

// Перепровести документ в ЕРП: ОтменаПроведения + Проведення (регенерація рухів).
// Викликається з UI (інтерактивна сесія) — штатне перепроведення, НЕ автономний COM-перепровод.
// Пошук документа ЕРП: 1) пряме посилання ДокументЕРП (DocumentRef, прямий аналіз);
//                     2) fallback — резолв за UID Бух через СоответствияОбъектовИнформационныхБаз.
//
Процедура ПерепровестиВЕРП(СтрДок)

	СсылкаДок = НайтиСсылкуЕРПДляПерепроведения(СтрДок);
	Если СсылкаДок = Неопределено Тогда
		СтрДок.Статус = "ПОМИЛКА: документ ЕРП не знайдено для перепроведення";
		Возврат;
	КонецЕсли;

	ДокОбъект = СсылкаДок.ПолучитьОбъект();
	Если ДокОбъект = Неопределено Тогда
		СтрДок.Статус = "ПОМИЛКА: документ ЕРП видалено (битий ref)";
		Возврат;
	КонецЕсли;

	// Якщо проведений — спершу відмінити, ПЕРЕЧИТАТИ об'єкт (інакше падіння на
	// закритому менеджері ВТ — memory feedback_delete_doc_obmen_zagruzka), потім провести.
	Если ДокОбъект.Проведен Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ДокОбъект = СсылкаДок.ПолучитьОбъект();
	КонецЕсли;
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);

	СтрДок.Статус = "Перепроведено в ЕРП";

КонецПроцедуры

// Знайти посилання на документ ЕРП для перепроведення.
// Повертає ДокументСсылка або Неопределено.
//
Функция НайтиСсылкуЕРПДляПерепроведения(СтрДок)

	// 1) Пряме посилання, збережене при аналізі (найнадійніше — без двозначності типу)
	Если ТипЗнч(СтрДок.ДокументЕРП) <> Тип("Строка")
		И ЗначениеЗаполнено(СтрДок.ДокументЕРП) Тогда
		Возврат СтрДок.ДокументЕРП;
	КонецЕсли;

	// 2) Резолв за UID Бух через реєстр відповідності об'єктів (як у ПровестиВЕРП)
	UIDБух = СокрЛП(СтрДок.UIDДокументаБух);
	Если ЗначениеЗаполнено(UIDБух) Тогда
		ЗапросСоотв = Новый Запрос;
		ЗапросСоотв.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Соотв.УникальныйИдентификаторИсточника КАК Источник
		|ИЗ
		|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
		|ГДЕ
		|	Соотв.УникальныйИдентификаторПриемника = &UIDПриемника
		|	И Соотв.УзелИнформационнойБазы ССЫЛКА ПланОбмена.ОбменУправлениеПредприятиемБухгалтерия20";
		ЗапросСоотв.УстановитьПараметр("UIDПриемника", UIDБух);
		РезСоотв = ЗапросСоотв.Выполнить().Выбрать();
		Если РезСоотв.Следующий() Тогда
			Возврат РезСоотв.Источник;
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
