
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Объект.НачалоПериода    = НачалоМесяца(ТекущаяДатаСеанса());
	Объект.ОкончаниеПериода = КонецМесяца(ТекущаяДатаСеанса());

	// За замовчуванням показуємо ВСІ документи складу після аналізу (зокрема «Збігається» —
	// для товарних розбіжностей переносу залишку це типовий випадок). Галку «Тільки розбіжності»
	// бухгалтер вмикає сам, коли треба сфокусуватись на проблемних (актуально для великих складів).
	Объект.ПоказыватьТолькоРасхождения = Ложь;

	// Колір надпису — кодом: TextColor у вивантаженні XML зовнішньої обробки ламає XDTO-завантаження
	Элементы.НадписьРезюме.ЦветТекста = ЦветаСтиля.ПоясняющийТекст;

	НастроитьУсловноеОформление();
	ОбновитьРезюмеИЗаголовки();

КонецПроцедуры

&НаСервере
Процедура НастроитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	// Рядки складів зі знятою галкою — сірі
	Элемент = УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаСкладовФорма");
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ТаблицаСкладов.Синхронизировать");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Ложь;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);

	// Рядки документів зі «спокійним» статусом — сірі: усе що починається з «ОК» або «Збігається»
	СписокСпокій = Новый СписокЗначений;
	СписокСпокій.Добавить("ОК");
	СписокСпокій.Добавить("Збігається");
	Для Каждого ЗнСпокій Из СписокСпокій Цикл
		Элемент = УсловноеОформление.Элементы.Добавить();
		Поле = Элемент.Поля.Элементы.Добавить();
		Поле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаДокументовФорма");
		Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ТаблицаДокументов.Статус");
		Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.НачинаетсяС;
		Отбор.ПравоеЗначение = ЗнСпокій.Значение;
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);
	КонецЦикла;

	// Помилки — червоним
	Элемент = УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаДокументовФорма");
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ТаблицаДокументов.Статус");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.НачинаетсяС;
	Отбор.ПравоеЗначение = "ПОМИЛКА";
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);

	// Успішно виконані дії — зеленим
	СписокУспех = Новый СписокЗначений;
	СписокУспех.Добавить("Розпроведено в ЕРП");
	СписокУспех.Добавить("Проведено в ЕРП");
	СписокУспех.Добавить("Зареєстровано на обмін в BuhBud");
	СписокУспех.Добавить("Перепроведено в ЕРП");
	Элемент = УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаДокументовФорма");
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ТаблицаДокументов.Статус");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
	Отбор.ПравоеЗначение = СписокУспех;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.ЗеленыйЛес);

КонецПроцедуры

// Зведення-резюме під шапкою та лічильники в заголовках таблиць
//
&НаСервере
Процедура ОбновитьРезюмеИЗаголовки()

	КолСкл = Объект.ТаблицаСкладов.Количество();
	КолПоз = Объект.ТаблицаРасхождений.Количество();

	КолДок = Объект.ТаблицаДокументов.Количество();
	КолДій = 0;
	КолПитань = 0;
	Для Каждого Стр Из Объект.ТаблицаДокументов Цикл
		Если Стр.ЕстьРасхождение Тогда
			Если ЗначениеЗаполнено(Стр.Действие) Тогда
				КолДій = КолДій + 1;
			Иначе
				КолПитань = КолПитань + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если КолСкл = 0 Тогда
		НадписьРезюме = "Натисніть «Сформувати» для порівняння залишків товарів ERP та BuhBud за період";
	Иначе
		НадписьРезюме = "Складів з розбіжностями: " + КолСкл + " (позицій: " + КолПоз + ")";
		Если КолДок > 0 Тогда
			НадписьРезюме = НадписьРезюме
				+ ".  Документів: " + КолДок
				+ " (з діями: " + КолДій
				+ ", рішення бухгалтера: " + КолПитань + ")";
		Иначе
			НадписьРезюме = НадписьРезюме + ".  Відмітьте склади та натисніть «Аналіз документів»";
		КонецЕсли;
	КонецЕсли;

	Элементы.ТаблицаСкладовФорма.Заголовок =
		"Розбіжності по складах" + ?(КолСкл > 0, " (" + КолСкл + ")", "");
	Элементы.ТаблицаДокументовФорма.Заголовок =
		"Документи для синхронізації" + ?(КолДок > 0, " (" + КолДок + ", з діями " + КолДій + ")", "");

КонецПроцедуры

// === КОМАНДЫ ===

&НаКлиенте
Процедура Сформировать(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		ПоказатьПредупреждение(, "Вкажіть період!");
		Возврат;
	КонецЕсли;

	СформироватьНаСервере();

КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()

	// Зберегти галки вибору складів — повторне формування не повинно скидати роботу
	КартаГалок = Новый Соответствие;
	Для Каждого Стр Из Объект.ТаблицаСкладов Цикл
		КартаГалок.Вставить(СокрЛП(Стр.СкладКлюч), Стр.Синхронизировать);
	КонецЦикла;

	мОбъект = РеквизитФормыВЗначение("Объект");
	мОбъект.СравнитьОстатки();
	ЗначениеВРеквизитФормы(мОбъект, "Объект");

	Если КартаГалок.Количество() > 0 Тогда
		Для Каждого Стр Из Объект.ТаблицаСкладов Цикл
			БылоЗначение = КартаГалок.Получить(СокрЛП(Стр.СкладКлюч));
			Если БылоЗначение <> Неопределено Тогда
				Стр.Синхронизировать = БылоЗначение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ОбновитьРезюмеИЗаголовки();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериод(Команда)

	// Преднастройка через окрему змінну: властивість Диалог.Период повертає КОПІЮ
	// агрегату СтандартныйПериод — пряма мутація Диалог.Период.ДатаНачала не застосовується
	Период = Новый СтандартныйПериод;
	Если ЗначениеЗаполнено(Объект.НачалоПериода) Тогда
		Период.ДатаНачала = Объект.НачалоПериода;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		Период.ДатаОкончания = КонецДня(Объект.ОкончаниеПериода);
	КонецЕсли;

	Диалог = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Период = Период;

	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
	Диалог.Показать(ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодЗавершение(Период, ДопПарам) Экспорт

	Если Период = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Объект.НачалоПериода = Период.ДатаНачала;
	Объект.ОкончаниеПериода = Период.ДатаОкончания;

КонецПроцедуры

&НаКлиенте
Процедура АнализДокументов(Команда)

	// Проверяем что есть выбранные склады
	ЕстьВыбранные = Ложь;
	Для Каждого Стр Из Объект.ТаблицаСкладов Цикл
		Если Стр.Синхронизировать Тогда
			ЕстьВыбранные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЕстьВыбранные Тогда
		ПоказатьПредупреждение(, "Оберіть склади для аналізу документів!");
		Возврат;
	КонецЕсли;

	АнализДокументовНаСервере(-1);
	ПрименитьФильтрДокументов();

КонецПроцедуры

&НаКлиенте
Процедура АнализТекущегоСчета(Команда)

	ТекущиеДанные = Элементы.ТаблицаСкладовФорма.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Встаньте на рядок складу!");
		Возврат;
	КонецЕсли;

	АнализДокументовНаСервере(Объект.ТаблицаСкладов.Индекс(ТекущиеДанные));
	ПрименитьФильтрДокументов();

КонецПроцедуры

&НаСервере
Процедура АнализДокументовНаСервере(ИндексСклада)

	мОбъект = РеквизитФормыВЗначение("Объект");
	Итог = мОбъект.АнализироватьДокументы(ИндексСклада);
	ЗначениеВРеквизитФормы(мОбъект, "Объект");

	ОбновитьРезюмеИЗаголовки();
	Сообщить(Итог);

КонецПроцедуры

&НаКлиенте
Процедура Синхронизировать(Команда)

	// Проверяем что есть выбранные документы
	КоличествоВыбранных = 0;
	Для Каждого Стр Из Объект.ТаблицаДокументов Цикл
		Если Стр.Синхронизировать Тогда
			КоличествоВыбранных = КоличествоВыбранных + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоВыбранных = 0 Тогда
		ПоказатьПредупреждение(, "Оберіть документи для синхронізації!");
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения("СинхронизироватьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения,
		"Синхронізувати " + КоличествоВыбранных + " документ(ів)?" + Символы.ПС
		+ "Операція може розпровести документи в ЕРП або зареєструвати на обмін в BuhBud.",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		СинхронизироватьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СинхронизироватьНаСервере()

	мОбъект = РеквизитФормыВЗначение("Объект");
	мОбъект.ВыполнитьСинхронизацию();
	ЗначениеВРеквизитФормы(мОбъект, "Объект");

	ОбновитьРезюмеИЗаголовки();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокументЕРП(Команда)

	ТекущиеДанные = Элементы.ТаблицаДокументовФорма.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ТекущиеДанные.ДокументЕРП) <> Тип("Строка")
		И ЗначениеЗаполнено(ТекущиеДанные.ДокументЕРП) Тогда
		ПоказатьЗначение(, ТекущиеДанные.ДокументЕРП);
	Иначе
		ПоказатьПредупреждение(, "У рядка немає документа ЕРП");
	КонецЕсли;

КонецПроцедуры

// === ВЫБОР/СНЯТИЕ ОТМЕТОК (склады) ===

&НаКлиенте
Процедура ВыбратьВсе(Команда)

	УстановитьГалочки(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьВыделение(Команда)

	УстановитьГалочки(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ИнвертироватьВыделение(Команда)

	Для Каждого Стр Из Объект.ТаблицаСкладов Цикл
		Стр.Синхронизировать = НЕ Стр.Синхронизировать;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьГалочки(Значение)

	// Верхня таблиця складів: галки нижньої розставляє аналіз
	Для Каждого Стр Из Объект.ТаблицаСкладов Цикл
		Стр.Синхронизировать = Значение;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВыделенные(Команда)

	УстановитьОтметкиВыделенныхДокументов(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкиВыделенных(Команда)

	УстановитьОтметкиВыделенныхДокументов(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметкиВыделенныхДокументов(Значение)

	Для Каждого ИдСтроки Из Элементы.ТаблицаДокументовФорма.ВыделенныеСтроки Цикл
		Стр = Объект.ТаблицаДокументов.НайтиПоИдентификатору(ИдСтроки);
		Если Стр <> Неопределено Тогда
			Стр.Синхронизировать = Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// === ОБРАБОТЧИКИ ТАБЛИЦ ===

&НаКлиенте
Процедура ТаблицаСкладовФормаПриАктивизацииСтроки(Элемент)

	// Нижня таблиця документів слідує за активним складом верхньої
	ПрименитьФильтрДокументов();

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСкладовФормаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Стр = Объект.ТаблицаСкладов.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Стр <> Неопределено
		И ТипЗнч(Стр.Склад) <> Тип("Строка")
		И ЗначениеЗаполнено(Стр.Склад) Тогда
		ПоказатьЗначение(, Стр.Склад);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовФормаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Стр = Объект.ТаблицаДокументов.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Стр <> Неопределено
		И ТипЗнч(Стр.ДокументЕРП) <> Тип("Строка")
		И ЗначениеЗаполнено(Стр.ДокументЕРП) Тогда
		ПоказатьЗначение(, Стр.ДокументЕРП);
	КонецЕсли;

КонецПроцедуры

// === ОБРАБОТЧИКИ ИЗМЕНЕНИЙ ===

&НаКлиенте
Процедура ПоказыватьТолькоРасхожденияПриИзменении(Элемент)

	ПрименитьФильтрДокументов();

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьФильтрДокументов()

	// Комбінований відбір: активний склад верхньої таблиці + прапорець «Тільки розбіжності»
	СтруктураОтбора = Новый Структура;

	ТекущиеДанные = Элементы.ТаблицаСкладовФорма.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		СтруктураОтбора.Вставить("Склад", ТекущиеДанные.Склад);
	КонецЕсли;

	Если Объект.ПоказыватьТолькоРасхождения Тогда
		// По ознаці розбіжності, НЕ по галці вибору
		СтруктураОтбора.Вставить("ЕстьРасхождение", Истина);
	КонецЕсли;

	Если СтруктураОтбора.Количество() = 0 Тогда
		Элементы.ТаблицаДокументовФорма.ОтборСтрок = Неопределено;
	Иначе
		Элементы.ТаблицаДокументовФорма.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбора);
	КонецЕсли;

КонецПроцедуры
