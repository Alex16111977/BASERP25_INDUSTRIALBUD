
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Процедура заповнює реквізит А_СчетБухгалтерский в справочнику БанковскиеСчетаОрганизаций
// на основі оборотів з бухгалтерської бази BuhBud через COM-підключення.
// Визначає на якому рахунку (311, 312, 313, 314, 315) обліковується кожен банківський рахунок.
//
// ДОРОБКА: Пошук банківського рахунку через UUID замість найменування
// Використовує А_Привилегированный.ПолучитьСправочникUID() як в звіті А_СравнитьОстаткиДенегЕРПсBASБухгалтерия
//
// Повертає:
//   Строка - текст з результатами виконання (кількість оновлених, помилок, пропущених)
//
Функция ЗаполнитьСчетаБухгалтерские() Экспорт

    УстановитьПривилегированныйРежим(Истина);

    // 1. Параметри підключення до бухгалтерської бази
    СтрокаПодключенияБух = А_ПодключенияБазСервер.СтрокаПодключения("BuhBud");
    // 2. Створення COM-конектора
    V8 = Новый COMОбъект("V83.COMConnector");

    Попытка
        V83 = V8.Connect(СокрЛП(СтрокаПодключенияБух));
    Исключение
        V8 = Неопределено;
        ВызватьИсключение "Помилка підключення до бази BuhBud: " + ОписаниеОшибки();
    КонецПопытки;

    // 3. Формування тексту запиту для отримання оборотів по рахунках 31х
    // Субконто1 = БанковскийСчет для рахунків 311, 312, 313, 314, 315
    // ДОРОБКА: Додано поле БанковскийСчетСсылка для отримання UUID
    ТекстЗапроса =
    "ВЫБРАТЬ
    |    Обороты.Субконто1 КАК БанковскийСчетСсылка,
    |    ВЫРАЗИТЬ(Обороты.Субконто1 КАК Справочник.БанковскиеСчета).Наименование КАК БанкСчетНаименование,
    |    Обороты.Счет.Код КАК СчетКод
    |ПОМЕСТИТЬ ВТ_Обороты
    |ИЗ
    |    РегистрБухгалтерии.Хозрасчетный.Обороты(
    |        ,
    |        ,
    |        ,
    |        Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках)),
    |        ,
    |    ) КАК Обороты
    |ГДЕ
    |    Обороты.Субконто1 ССЫЛКА Справочник.БанковскиеСчета
    |    И НЕ Обороты.Субконто1 = НЕОПРЕДЕЛЕНО
    |
    |СГРУППИРОВАТЬ ПО
    |    Обороты.Субконто1,
    |    Обороты.Счет
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    ВТ_Обороты.БанковскийСчетСсылка КАК БанковскийСчетСсылка,
    |    ВТ_Обороты.БанкСчетНаименование КАК БанкСчетНаименование,
    |    ВТ_Обороты.СчетКод КАК СчетКод
    |ИЗ
    |    ВТ_Обороты КАК ВТ_Обороты
    |ГДЕ
    |    НЕ ВТ_Обороты.БанкСчетНаименование = """"";

    // 4. Виконання запиту в бухгалтерській базі
    Попытка
        Запрос = V83.NewObject("Запрос");
        Запрос.Текст = ТекстЗапроса;

        РезультатЗапроса = Запрос.Выполнить();
        ТЗОбороты = РезультатЗапроса.Выгрузить();
    Исключение
        V83 = Неопределено;
        V8 = Неопределено;
        ВызватьИсключение "Помилка виконання запиту в базі BuhBud: " + ОписаниеОшибки();
    КонецПопытки;

    // 5. Лічильники для статистики
    СчетчикОбновлено = 0;
    СчетчикОшибок = 0;
    СчетчикПропущено = 0;
    СчетчикНайденоПоUUID = 0;
    СчетчикНайденоПоИмени = 0;

    // 6. Цикл по результату - оновлення справочника БанковскиеСчетаОрганизаций
    //    ВАЖЛИВО: Цикл виконується ДО закриття V83, щоб мати доступ до УникальныйИдентификатор()!
    Для Каждого СтрокаТЗ Из ТЗОбороты Цикл

        БанкСчетНаименование = СокрЛП(СтрокаТЗ.БанкСчетНаименование);
        СчетКод = СокрЛП(СтрокаТЗ.СчетКод);

        // 6.1. Перевірка на порожні значення
        Если ПустаяСтрока(БанкСчетНаименование) Тогда
            СчетчикПропущено = СчетчикПропущено + 1;
            Сообщить("Пропущено: порожня назва банківського рахунку, рахунок " + СчетКод);
            Продолжить;
        КонецЕсли;

        Если ПустаяСтрока(СчетКод) Тогда
            СчетчикПропущено = СчетчикПропущено + 1;
            Сообщить("Пропущено: порожній код рахунку для " + БанкСчетНаименование);
            Продолжить;
        КонецЕсли;

        // 6.2. Пошук банківського рахунку в ERP
        //      Спочатку по UUID (надійний метод), потім fallback по наименованию
        БанкСчетERP = Неопределено;
        НайденоПоUUID = Ложь;

        // Спроба пошуку по UUID через А_Привилегированный
        Попытка
            Если СтрокаТЗ.БанковскийСчетСсылка <> Неопределено Тогда
                УИД_Строка = V83.String(СтрокаТЗ.БанковскийСчетСсылка.УникальныйИдентификатор());
                БанкСчетERP = А_Привилегированный.ПолучитьСправочникUID(
                    "БанковскиеСчетаОрганизаций", УИД_Строка);
                Если ЗначениеЗаполнено(БанкСчетERP) Тогда
                    НайденоПоUUID = Истина;
                    СчетчикНайденоПоUUID = СчетчикНайденоПоUUID + 1;
                КонецЕсли;
            КонецЕсли;
        Исключение
            // UUID не знайдено або помилка - спробуємо fallback по наименованию
        КонецПопытки;

        // Fallback на пошук по наименованию
        Если НЕ ЗначениеЗаполнено(БанкСчетERP) Тогда
            БанкСчетERP = Справочники.БанковскиеСчетаОрганизаций.НайтиПоНаименованию(
                БанкСчетНаименование, Истина);
            Если ЗначениеЗаполнено(БанкСчетERP) Тогда
                СчетчикНайденоПоИмени = СчетчикНайденоПоИмени + 1;
            КонецЕсли;
        КонецЕсли;

        Если НЕ ЗначениеЗаполнено(БанкСчетERP) Тогда
            СчетчикОшибок = СчетчикОшибок + 1;
            Сообщить("Не знайдено банківський рахунок в ERP ні по UUID ні по імені: " + БанкСчетНаименование);
            Продолжить;
        КонецЕсли;

        // 6.3. Пошук рахунку бухобліку в плані рахунків ERP за кодом
        СчетБухУчета = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СчетКод);

        Если НЕ ЗначениеЗаполнено(СчетБухУчета) Тогда
            СчетчикОшибок = СчетчикОшибок + 1;
            Сообщить("Рахунок бухобліку не знайдено в ERP: " + СчетКод + " для " + БанкСчетНаименование);
            Продолжить;
        КонецЕсли;

        // 6.4. Перевірка чи потрібно оновлення (якщо рахунок вже заповнений і співпадає - пропускаємо)
        Если БанкСчетERP.А_СчетБухгалтерский = СчетБухУчета Тогда
            СчетчикПропущено = СчетчикПропущено + 1;
            Продолжить;
        КонецЕсли;

        // 6.5. Оновлення справочника
        Попытка
            СпрОбъект = БанкСчетERP.ПолучитьОбъект();
            СпрОбъект.А_СчетБухгалтерский = СчетБухУчета;
            СпрОбъект.ОбменДанными.Загрузка = Истина;
            СпрОбъект.Записать();

            СчетчикОбновлено = СчетчикОбновлено + 1;
            
            МетодПоиска = ?(НайденоПоUUID, "UUID", "Наименование");
            Сообщить("Оновлено: " + БанкСчетНаименование + " -> " + СчетКод + " (знайдено по " + МетодПоиска + ")");
        Исключение
            СчетчикОшибок = СчетчикОшибок + 1;
            Сообщить("Помилка запису банківського рахунку " + БанкСчетНаименование + ": " + ОписаниеОшибки());
        КонецПопытки;

    КонецЦикла;

    // 7. Відключення від бухгалтерської бази (ПІСЛЯ циклу!)
    V83 = Неопределено;
    V8 = Неопределено;

    // 8. Формування результату
    ТекстРезультата =
        "Результат заповнення рахунків бухгалтерського обліку:" + Символы.ПС +
        "===============================================" + Символы.ПС +
        "Оновлено: " + СчетчикОбновлено + Символы.ПС +
        "  - знайдено по UUID: " + СчетчикНайденоПоUUID + Символы.ПС +
        "  - знайдено по імені: " + СчетчикНайденоПоИмени + Символы.ПС +
        "Пропущено (без змін): " + СчетчикПропущено + Символы.ПС +
        "Помилок: " + СчетчикОшибок;

    Сообщить(ТекстРезультата);

    Возврат ТекстРезультата;

КонецФункции

#КонецЕсли
