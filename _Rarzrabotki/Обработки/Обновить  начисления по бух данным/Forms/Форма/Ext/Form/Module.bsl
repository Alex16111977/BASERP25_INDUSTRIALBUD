////////////////////////////////////////////////////////////////////////////////
// Обновление начислений в документах НачислениеЗарплаты по данным из базы ЗУП
// 
// ИСТОЧНИК ДАННЫХ:
//   - База ЗУП: регистр А_НастройкиПодключенияБаз, идентификатор "zup_2"
//   - Документ: НачислениеЗарплатыРаботникам
//   - ТЧ: Начисления, Удержания
//
// ЦЕЛЕВЫЕ ОБЪЕКТЫ (ERP):
//   - Документ: НачислениеЗарплаты
//   - ТЧ: А_Начисления, А_Удержания
//
// МАППИНГ (по правилам обмена):
//   Начисления (ЗУП) → А_Начисления (ERP):
//     Физлицо → ФизЛицо (поиск по КодПоДРФО)
//     ВидРасчета (наименование) → ВидРасчета
//     Результат → Сумма
//     ВидРасчета.Код → КодВидРасчета
//
//   Удержания (ЗУП) → А_Удержания (ERP):
//     Физлицо → ФизЛицо (поиск по КодПоДРФО)
//     ВидРасчета (наименование) → ВидРасчета
//     Результат → Сумма
//     ВидРасчета.Код → КодВидРасчета
//
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Инициализация - текущий месяц по умолчанию
	Если НЕ ЗначениеЗаполнено(Объект.МесяцНачисления) Тогда
		Объект.МесяцНачисления = НачалоМесяца(ТекущаяДата());
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьНачисленияИзЗУП(Команда)
	
	ОчиститьСообщения();
	
	Если НЕ ЗначениеЗаполнено(Объект.МесяцНачисления) Тогда
		ПоказатьПредупреждение(, "Не указан месяц начисления!");
		Возврат;
	КонецЕсли;
	
	Результат = ЗаполнитьНачисленияИзЗУПНаСервере();
	
	Если Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Сообщение);
	Иначе
		ПоказатьПредупреждение(, "Ошибка: " + Результат.Сообщение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основная серверная процедура
&НаСервере
Функция ЗаполнитьНачисленияИзЗУПНаСервере()
	
	Результат = Новый Структура("Успех, Сообщение", Ложь, "");
	
	Попытка
		
		// 1. Подключаемся к базе ЗУП
		СоединениеЗУП = ПодключитьсяКБазеЗУП();
		
		Если СоединениеЗУП = Неопределено Тогда
			Результат.Сообщение = "Не удалось подключиться к базе ЗУП!";
			Возврат Результат;
		КонецЕсли;
		
		// 2. Находим документы НачислениеЗарплаты в ERP за выбранный месяц
		МассивДокументовERP = ПолучитьДокументыНачисленияЗарплаты();
		
		Если МассивДокументовERP.Количество() = 0 Тогда
			Результат.Сообщение = СтрШаблон(
				"Не найдено проведённых документов НачислениеЗарплаты за %1",
				Формат(Объект.МесяцНачисления, "ДФ='ММММ гггг'"));
			Возврат Результат;
		КонецЕсли;
		
		// 3. Подготовка справочных данных - соответствие ФизЛиц по КодПоДРФО
		СоответствиеФизЛиц = ПодготовитьСоответствиеФизЛиц();
		
		// 4. Счётчики
		ВсегоДокументов = МассивДокументовERP.Количество();
		ОбработаноДокументов = 0;
		ВсегоНачислений = 0;
		ВсегоУдержаний = 0;
		ОшибкиДокументов = 0;
		
		// 5. Обрабатываем каждый документ
		Для Каждого ДокументERP Из МассивДокументовERP Цикл
			
			Попытка
				
				// 5.1. Ищем соответствующий документ в ЗУП
				ДанныеЗУП = ПолучитьДанныеИзЗУП(СоединениеЗУП, ДокументERP.Номер, ДокументERP.Дата);
				
				Если ДанныеЗУП = Неопределено Тогда
					// Документ не найден в ЗУП - пропускаем
					Продолжить;
				КонецЕсли;
				
				// 5.2. Заполняем документ ERP
				РезультатЗаполнения = ЗаполнитьДокументERP(ДокументERP.Ссылка, ДанныеЗУП, СоответствиеФизЛиц);
				
				ОбработаноДокументов = ОбработаноДокументов + 1;
				ВсегоНачислений = ВсегоНачислений + РезультатЗаполнения.КолНачислений;
				ВсегоУдержаний = ВсегоУдержаний + РезультатЗаполнения.КолУдержаний;
				
			Исключение
				ОшибкиДокументов = ОшибкиДокументов + 1;
				Сообщить("Ошибка обработки документа " + ДокументERP.Номер + ": " + ОписаниеОшибки());
			КонецПопытки;
			
		КонецЦикла;
		
		// 6. Отключаемся от ЗУП
		СоединениеЗУП = Неопределено;
		
		Результат.Успех = Истина;
		Результат.Сообщение = СтрШаблон(
			"Обработка завершена:
			|• Найдено документов в ERP: %1
			|• Обработано документов: %2
			|• Загружено начислений: %3
			|• Загружено удержаний: %4
			|• Ошибок: %5",
			ВсегоДокументов,
			ОбработаноДокументов,
			ВсегоНачислений,
			ВсегоУдержаний,
			ОшибкиДокументов);
		
	Исключение
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#Область ПодключениеКЗУП

// Подключение к базе ЗУП через COM
&НаСервере
Функция ПодключитьсяКБазеЗУП()
	
	Попытка
		
		Connector = Новый COMОбъект("V83.COMConnector");
		
		// Строка подключения к ЗУП
		// ВАЖНО: Измените логин и пароль при необходимости
		СтрокаСоединения = А_ПодключенияБазСервер.СтрокаПодключения("zup2");
		V8 = Connector.Connect(СтрокаСоединения);
		
		Возврат V8;
		
	Исключение
		Сообщить("Ошибка подключения к ЗУП: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Получение данных из ЗУП по номеру и дате документа
&НаСервере
Функция ПолучитьДанныеИзЗУП(СоединениеЗУП, НомерДокумента, ДатаДокумента)
	
	Попытка
		
		// Запрос для поиска документа НачислениеЗарплатыРаботникам в ЗУП
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.НачислениеЗарплатыРаботникам КАК Док
		|ГДЕ
		|	Док.Номер = &Номер
		|	И Док.Дата МЕЖДУ &НачалоДня И &КонецДня
		|	И Док.Проведен = ИСТИНА";
		
		Запрос = СоединениеЗУП.NewObject("Запрос");
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Номер", СокрЛП(НомерДокумента));
		Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ДатаДокумента));
		Запрос.УстановитьПараметр("КонецДня", КонецДня(ДатаДокумента));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		ДокументЗУП = Выборка.Ссылка;
		
		// Получаем данные начислений
		Данные = Новый Структура("Начисления, Удержания");
		Данные.Начисления = Новый Массив;
		Данные.Удержания = Новый Массив;
		
		// Запрос начислений
		ТекстЗапросаНачисления = 
		"ВЫБРАТЬ
		|	Начисления.Физлицо.КодПоДРФО КАК КодПоДРФО,
		|	Начисления.ВидРасчета.Наименование КАК ВидРасчета,
		|	Начисления.ВидРасчета.Код КАК КодВидРасчета,
		|	Начисления.Результат КАК Сумма
		|ИЗ
		|	Документ.НачислениеЗарплатыРаботникам.Начисления КАК Начисления
		|ГДЕ
		|	Начисления.Ссылка = &Ссылка
		|	И Начисления.Результат <> 0";
		
		ЗапросНачисления = СоединениеЗУП.NewObject("Запрос");
		ЗапросНачисления.Текст = ТекстЗапросаНачисления;
		ЗапросНачисления.УстановитьПараметр("Ссылка", ДокументЗУП);
		
		РезультатНачисления = ЗапросНачисления.Выполнить();
		ВыборкаНачисления = РезультатНачисления.Выбрать();
		
		Пока ВыборкаНачисления.Следующий() Цикл
			СтрокаНачисления = Новый Структура("КодПоДРФО, ВидРасчета, КодВидРасчета, Сумма");
			СтрокаНачисления.КодПоДРФО = СокрЛП(ВыборкаНачисления.КодПоДРФО);
			СтрокаНачисления.ВидРасчета = СокрЛП(ВыборкаНачисления.ВидРасчета);
			СтрокаНачисления.КодВидРасчета = СокрЛП(ВыборкаНачисления.КодВидРасчета);
			СтрокаНачисления.Сумма = ВыборкаНачисления.Сумма;
			Данные.Начисления.Добавить(СтрокаНачисления);
		КонецЦикла;
		
		// Запрос удержаний
		ТекстЗапросаУдержания = 
		"ВЫБРАТЬ
		|	Удержания.Физлицо.КодПоДРФО КАК КодПоДРФО,
		|	Удержания.ВидРасчета.Наименование КАК ВидРасчета,
		|	Удержания.ВидРасчета.Код КАК КодВидРасчета,
		|	Удержания.Результат КАК Сумма
		|ИЗ
		|	Документ.НачислениеЗарплатыРаботникам.Удержания КАК Удержания
		|ГДЕ
		|	Удержания.Ссылка = &Ссылка
		|	И Удержания.Результат <> 0";
		
		ЗапросУдержания = СоединениеЗУП.NewObject("Запрос");
		ЗапросУдержания.Текст = ТекстЗапросаУдержания;
		ЗапросУдержания.УстановитьПараметр("Ссылка", ДокументЗУП);
		
		РезультатУдержания = ЗапросУдержания.Выполнить();
		ВыборкаУдержания = РезультатУдержания.Выбрать();
		
		Пока ВыборкаУдержания.Следующий() Цикл
			СтрокаУдержания = Новый Структура("КодПоДРФО, ВидРасчета, КодВидРасчета, Сумма");
			СтрокаУдержания.КодПоДРФО = СокрЛП(ВыборкаУдержания.КодПоДРФО);
			СтрокаУдержания.ВидРасчета = СокрЛП(ВыборкаУдержания.ВидРасчета);
			СтрокаУдержания.КодВидРасчета = СокрЛП(ВыборкаУдержания.КодВидРасчета);
			СтрокаУдержания.Сумма = ВыборкаУдержания.Сумма;
			Данные.Удержания.Добавить(СтрокаУдержания);
		КонецЦикла;
		
		Возврат Данные;
		
	Исключение
		Сообщить("Ошибка получения данных из ЗУП: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область РаботаСДаннымиERP

// Получение списка документов НачислениеЗарплаты за месяц
&НаСервере
Функция ПолучитьДокументыНачисленияЗарплаты()
	
	Результат = Новый Массив;
	
	НачалоПериода = НачалоМесяца(Объект.МесяцНачисления);
	КонецПериода = КонецМесяца(Объект.МесяцНачисления);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НачислениеЗарплаты.Ссылка КАК Ссылка,
	|	НачислениеЗарплаты.Номер КАК Номер,
	|	НачислениеЗарплаты.Дата КАК Дата
	|ИЗ
	|	Документ.НачислениеЗарплаты КАК НачислениеЗарплаты
	|ГДЕ
	|	НачислениеЗарплаты.МесяцНачисления = &МесяцНачисления
	|	И НачислениеЗарплаты.Проведен = ИСТИНА
	|УПОРЯДОЧИТЬ ПО
	|	НачислениеЗарплаты.Дата";
	
	Запрос.УстановитьПараметр("МесяцНачисления", НачалоПериода);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Ссылка, Номер, Дата", 
			Выборка.Ссылка, Выборка.Номер, Выборка.Дата));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Подготовка соответствия физлиц по КодПоДРФО
&НаСервере
Функция ПодготовитьСоответствиеФизЛиц()
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ФизическиеЛица.Ссылка КАК Ссылка,
	|	ФизическиеЛица.КодПоДРФО КАК КодПоДРФО
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|ГДЕ
	|	ФизическиеЛица.КодПоДРФО <> """"";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		КодДРФО = СокрЛП(Выборка.КодПоДРФО);
		Если ЗначениеЗаполнено(КодДРФО) Тогда
			Результат.Вставить(КодДРФО, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Заполнение документа ERP данными из ЗУП
&НаСервере
Функция ЗаполнитьДокументERP(СсылкаДокумента, ДанныеЗУП, СоответствиеФизЛиц)
	
	Результат = Новый Структура("КолНачислений, КолУдержаний", 0, 0);
	
	ДокОбъект = СсылкаДокумента.ПолучитьОбъект();
	
	Если ДокОбъект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Очищаем табличные части
	ДокОбъект.А_Начисления.Очистить();
	ДокОбъект.А_Удержания.Очистить();
	
	// Заполняем начисления
	Для Каждого СтрокаНачисления Из ДанныеЗУП.Начисления Цикл
		
		// Ищем физлицо по КодПоДРФО
		ФизЛицо = СоответствиеФизЛиц[СтрокаНачисления.КодПоДРФО];
		
		Если ФизЛицо = Неопределено Тогда
			// Физлицо не найдено - пропускаем или сообщаем
			Сообщить("Не найдено физлицо с КодПоДРФО: " + СтрокаНачисления.КодПоДРФО);
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДокОбъект.А_Начисления.Добавить();
		НоваяСтрока.ФизЛицо = ФизЛицо;
		НоваяСтрока.Сумма = СтрокаНачисления.Сумма;
		НоваяСтрока.ВидРасчета = СтрокаНачисления.ВидРасчета;
		НоваяСтрока.КодВидРасчета = СтрокаНачисления.КодВидРасчета;
		
		Результат.КолНачислений = Результат.КолНачислений + 1;
		
	КонецЦикла;
	
	// Заполняем удержания
	Для Каждого СтрокаУдержания Из ДанныеЗУП.Удержания Цикл
		
		// Ищем физлицо по КодПоДРФО
		ФизЛицо = СоответствиеФизЛиц[СтрокаУдержания.КодПоДРФО];
		
		Если ФизЛицо = Неопределено Тогда
			// Физлицо не найдено - пропускаем
			Сообщить("Не найдено физлицо с КодПоДРФО: " + СтрокаУдержания.КодПоДРФО);
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДокОбъект.А_Удержания.Добавить();
		НоваяСтрока.ФизЛицо = ФизЛицо;
		НоваяСтрока.Сумма = СтрокаУдержания.Сумма;
		НоваяСтрока.ВидРасчета = СтрокаУдержания.ВидРасчета;
		НоваяСтрока.КодВидРасчета = СтрокаУдержания.КодВидРасчета;
		
		Результат.КолУдержаний = Результат.КолУдержаний + 1;
		
	КонецЦикла;
	
	// Записываем документ БЕЗ проведения (сохраняем текущий статус)
	ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти
