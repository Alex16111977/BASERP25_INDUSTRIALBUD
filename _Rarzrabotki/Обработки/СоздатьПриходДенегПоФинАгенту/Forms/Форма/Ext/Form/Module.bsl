// ==============================================================================
// Обработка: СоздатьПриходДенегПоФинАгенту
// Назначение: Для каждой строки РасшифровкаПлатежа с Сумма > 0:
//   1) Ищет/создаёт ПКО (ВозвратОплатыПоставщику) на полную Стр.Сумма
//   2) Если СуммаКомиссии > 0 — ищет/создаёт РКО (ОплатаПоставщику)
//   3) Если СуммаКомиссии > 0 — ищет/создаёт ПриобретениеТоваровУслуг
// Паттерн:
//   Фаза 1: Пометить все дочерние документы на удаление + отменить проведение
//   Проверка: если источник НЕ проведён → Возврат (дочерние остаются помеченными)
//   Фаза 2: Для каждой строки — искать документ → нашли: снять пометку, обновить, провести
//                                                не нашли: создать, заполнить, провести
// ==============================================================================

// ---------- Вспомогательные функции заполнения ----------

&НаСервере
Процедура ЗаполнитьПКО(ДокОбъект, ДатаДокумента, Организация, Касса, Валюта,
		СтрКонтрагент, СтрПартнер, СтрСумма, СтатьяДДС, Подразделение,
		НаправлениеДеятельности, ДокОснование, СтрНомерСтроки,
		СтрПроцентФинАгента, СтрСуммаКомиссии, СтрОбъектРасчетов)

	ДокОбъект.Дата                           = ДатаДокумента;
	ДокОбъект.Организация                    = Организация;
	ДокОбъект.ХозяйственнаяОперация          = Перечисления.ХозяйственныеОперации.ВозвратДенежныхСредствОтПоставщика;
	ДокОбъект.А_ОбработанКазна               = Истина;   // Чтобы ПередЗаписью не перезаписывал ХозОперацию и РасшифровкуПлатежа
	ДокОбъект.Касса                           = Касса;
	ДокОбъект.Контрагент                      = СтрКонтрагент;
	ДокОбъект.Партнер                         = СтрПартнер;
	ДокОбъект.Валюта                          = Валюта;
	ДокОбъект.СуммаДокумента                  = СтрСумма;
	ДокОбъект.СтатьяДвиженияДенежныхСредств   = СтатьяДДС;
	ДокОбъект.Подразделение                   = Подразделение;
	ДокОбъект.НаправлениеДеятельности         = НаправлениеДеятельности;
	// Связки
	ДокОбъект.А_ПриходДенегОтФинАгента       = ДокОснование;
	ДокОбъект.А_КодСтрокиПриходДенегОтФинАгента = СтрНомерСтроки;
	// Кастомные поля
	ДокОбъект.А_НаправлениеДеятельности       = НаправлениеДеятельности;
	ДокОбъект.А_Подразделение                 = Подразделение;
	ДокОбъект.А_ПроцентФинАгента              = СтрПроцентФинАгента;
	ДокОбъект.А_СуммаКомиссии                 = СтрСуммаКомиссии;

	// ТЧ РасшифровкаПлатежа — очистить и 1 строка
	ДокОбъект.РасшифровкаПлатежа.Очистить();
	СтрокаРП = ДокОбъект.РасшифровкаПлатежа.Добавить();
	СтрокаРП.Партнер                          = СтрПартнер;
	СтрокаРП.Сумма                            = СтрСумма;
	СтрокаРП.СуммаВзаиморасчетов              = СтрСумма;
	СтрокаРП.ВалютаВзаиморасчетов             = Валюта;
	СтрокаРП.СтатьяДвиженияДенежныхСредств    = СтатьяДДС;
	СтрокаРП.Подразделение                    = Подразделение;
	СтрокаРП.НаправлениеДеятельности          = НаправлениеДеятельности;
	Если ЗначениеЗаполнено(СтрОбъектРасчетов) Тогда
		СтрокаРП.ОбъектРасчетов               = СтрОбъектРасчетов;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРКО(ДокОбъект, ДатаДокумента, Организация, Касса, Валюта,
		СтрКонтрагент, СтрПартнер, СтрСуммаКомиссии, СтатьяДДС, Подразделение,
		НаправлениеДеятельности, ДокОснование, СсылкаПКО, СтрОбъектРасчетов)

	ДокОбъект.Дата                           = ДатаДокумента;
	ДокОбъект.Организация                    = Организация;
	ДокОбъект.ХозяйственнаяОперация          = Перечисления.ХозяйственныеОперации.ОплатаПоставщику;
	ДокОбъект.А_ОбработанКазна               = Истина;   // Чтобы ПередЗаписью не перезаписывал ХозОперацию и РасшифровкуПлатежа
	ДокОбъект.Касса                           = Касса;
	ДокОбъект.Контрагент                      = СтрКонтрагент;
	ДокОбъект.Партнер                         = СтрПартнер;
	ДокОбъект.Валюта                          = Валюта;
	ДокОбъект.СуммаДокумента                  = СтрСуммаКомиссии;
	ДокОбъект.СтатьяДвиженияДенежныхСредств   = СтатьяДДС;
	ДокОбъект.Подразделение                   = Подразделение;
	ДокОбъект.НаправлениеДеятельности         = НаправлениеДеятельности;
	// Связки
	ДокОбъект.А_ПриходДенегОтФинАгента       = ДокОснование;
	ДокОбъект.А_ПриходныйКассовыйОрдерОтФинАгента = СсылкаПКО;

	// ТЧ РасшифровкаПлатежа — очистить и 1 строка
	ДокОбъект.РасшифровкаПлатежа.Очистить();
	СтрокаРП = ДокОбъект.РасшифровкаПлатежа.Добавить();
	СтрокаРП.Сумма                           = СтрСуммаКомиссии;
	СтрокаРП.СуммаВзаиморасчетов              = СтрСуммаКомиссии;
	СтрокаРП.ВалютаВзаиморасчетов             = Валюта;
	СтрокаРП.СтатьяДвиженияДенежныхСредств    = СтатьяДДС;
	СтрокаРП.Подразделение                    = Подразделение;
	СтрокаРП.НаправлениеДеятельности          = НаправлениеДеятельности;
	СтрокаРП.Партнер                          = СтрПартнер;
	Если ЗначениеЗаполнено(СтрОбъектРасчетов) Тогда
		СтрокаРП.ОбъектРасчетов              = СтрОбъектРасчетов;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПриобретение(ДокОбъект, ДатаДокумента, Организация, Валюта,
		СтрКонтрагент, СтрПартнер, СтрСуммаКомиссии, Подразделение,
		НаправлениеДеятельности, ДокОснование, СсылкаПКО, СтрДоговор,
		НоменклатураЗатрат, СтатьяЗатрат, СтрОбъектРасчетов)

	ДокОбъект.Дата                          = ДатаДокумента;
	ДокОбъект.Организация                   = Организация;
	ДокОбъект.Контрагент                    = СтрКонтрагент;
	ДокОбъект.Партнер                       = СтрПартнер;
	ДокОбъект.ХозяйственнаяОперация         = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	ДокОбъект.А_ВведенВЕРП                  = Истина;   // Чтобы ПередЗаписью не очищал ТЧ Товары
	ДокОбъект.Валюта                        = Валюта;
	ДокОбъект.ВалютаВзаиморасчетов           = Валюта;
	ДокОбъект.СуммаДокумента                = СтрСуммаКомиссии;
	ДокОбъект.Курс                          = 1;
	ДокОбъект.Кратность                     = 1;
	ДокОбъект.ЦенаВключаетНДС               = Истина;
	ДокОбъект.СуммаВзаиморасчетов            = СтрСуммаКомиссии;
	ДокОбъект.Подразделение                  = Подразделение;
	ДокОбъект.НаправлениеДеятельности        = НаправлениеДеятельности;
	ДокОбъект.ФормаОплаты                    = Перечисления.ФормыОплаты.Наличная;
	// Договор
	Если ЗначениеЗаполнено(СтрДоговор) Тогда
		ДокОбъект.Договор                   = СтрДоговор;
	КонецЕсли;
	// Связки
	ДокОбъект.А_ПриходДенегОтФинАгента     = ДокОснование;
	ДокОбъект.А_ПриходныйКассовыйОрдерКомиссия = СсылкаПКО;
	// Если ОбъектРасчетов.Объект = ЗаказПоставщику → ставим галочку и шапочный реквизит
	Если ЗначениеЗаполнено(СтрОбъектРасчетов)
		И ТипЗнч(СтрОбъектРасчетов.Объект) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		ДокОбъект.ПоступлениеПоЗаказам       = Истина;
		ДокОбъект.ЗаказПоставщику             = СтрОбъектРасчетов.Объект;
	КонецЕсли;

	// ТЧ Товары — очистить и 1 строка
	ДокОбъект.Товары.Очистить();
	НоваяСтрТовары = ДокОбъект.Товары.Добавить();
	НоваяСтрТовары.Номенклатура              = НоменклатураЗатрат;
	НоваяСтрТовары.СтатьяРасходов            = СтатьяЗатрат;
	НоваяСтрТовары.Количество                = 1;
	НоваяСтрТовары.КоличествоУпаковок        = 1;
	НоваяСтрТовары.Цена                      = СтрСуммаКомиссии;
	НоваяСтрТовары.Сумма                     = СтрСуммаКомиссии;
	НоваяСтрТовары.СуммаСНДС                 = СтрСуммаКомиссии;
	НоваяСтрТовары.СуммаВзаиморасчетов       = СтрСуммаКомиссии;
	НоваяСтрТовары.СтавкаНДС                 = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
	НоваяСтрТовары.СуммаНДС                  = 0;
	НоваяСтрТовары.СписатьНаРасходы           = Истина;
	НоваяСтрТовары.КодСтроки                 = 1;
	НоваяСтрТовары.ИдентификаторСтроки        = Строка(Новый УникальныйИдентификатор);
	Если ЗначениеЗаполнено(Подразделение) Тогда
		НоваяСтрТовары.Подразделение          = Подразделение;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрОбъектРасчетов) Тогда
		НоваяСтрТовары.ОбъектРасчетов         = СтрОбъектРасчетов;
		Если ТипЗнч(СтрОбъектРасчетов.Объект) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			НоваяСтрТовары.ЗаказПоставщику    = СтрОбъектРасчетов.Объект;
		КонецЕсли;
	КонецЕсли;

	// ТЧ РасшифровкаПлатежа — очистить и 1 строка (взаиморасчёты)
	ДокОбъект.РасшифровкаПлатежа.Очистить();
	СтрокаВзаим = ДокОбъект.РасшифровкаПлатежа.Добавить();
	СтрокаВзаим.Сумма                        = СтрСуммаКомиссии;
	СтрокаВзаим.СуммаВзаиморасчетов           = СтрСуммаКомиссии;
	СтрокаВзаим.ВалютаВзаиморасчетов          = Валюта;
	Если ЗначениеЗаполнено(СтрОбъектРасчетов) Тогда
		СтрокаВзаим.ОбъектРасчетов            = СтрОбъектРасчетов;
	КонецЕсли;

КонецПроцедуры

// ---------- Очистка (пометка на удаление + отмена проведения) ----------

&НаСервере
Функция ОчиститьДочерниеДокументы(ДокОснование, ИмяТипаДок)

	ЗапросОчистки = Новый Запрос;
	ЗапросОчистки.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Проведен КАК Проведен,
	|	Док.Номер КАК Номер
	|ИЗ
	|	Документ." + ИмяТипаДок + " КАК Док
	|ГДЕ
	|	Док.А_ПриходДенегОтФинАгента = &Основание
	|	И НЕ Док.ПометкаУдаления";
	ЗапросОчистки.УстановитьПараметр("Основание", ДокОснование);

	Кол = 0;
	РезОчистки = ЗапросОчистки.Выполнить();
	Если НЕ РезОчистки.Пустой() Тогда
		ВыбОчистки = РезОчистки.Выбрать();
		Пока ВыбОчистки.Следующий() Цикл
			Попытка
				ДокОбъект = ВыбОчистки.Ссылка.ПолучитьОбъект();
				Если ВыбОчистки.Проведен Тогда
					ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;
				ДокОбъект.УстановитьПометкуУдаления(Истина);
				Кол = Кол + 1;
			Исключение
				Сообщить("Ошибка очистки " + ИмяТипаДок + " " + ВыбОчистки.Номер
					+ ": " + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	Возврат Кол;

КонецФункции

// ---------- ОСНОВНАЯ ПРОЦЕДУРА ----------

&НаСервере
Процедура СоздатьПриходДенегПоФинАгентуНаСервере()

	ДокОснование = Объект.ДокПриходДенегОтФинАгента;

	Если НЕ ЗначениеЗаполнено(ДокОснование) Тогда
		Сообщить("Не выбран документ А_ПриходДенегОтФинАгента!");
		Возврат;
	КонецЕсли;

	// ========== ФАЗА 1: ОЧИСТКА (пометка на удаление + отмена проведения) ==========
	// Порядок: дочерние → родительские (Приобретения → РКО → ПКО)
	КолОчисткаПриобр = ОчиститьДочерниеДокументы(ДокОснование, "ПриобретениеТоваровУслуг");
	КолОчисткаРКО    = ОчиститьДочерниеДокументы(ДокОснование, "РасходныйКассовыйОрдер");
	КолОчисткаПКО    = ОчиститьДочерниеДокументы(ДокОснование, "ПриходныйКассовыйОрдер");

	Если КолОчисткаПриобр > 0 ИЛИ КолОчисткаРКО > 0 ИЛИ КолОчисткаПКО > 0 Тогда
		Сообщить("Фаза 1: помечено на удаление ПКО=" + Строка(КолОчисткаПКО)
			+ ", РКО=" + Строка(КолОчисткаРКО)
			+ ", Приобретений=" + Строка(КолОчисткаПриобр));
	КонецЕсли;

	// ========== ПРОВЕРКА: источник проведён? ==========
	Если НЕ ДокОснование.Проведен Тогда
		Сообщить("Документ-источник не проведён. Дочерние документы помечены на удаление.");
		Возврат;
	КонецЕсли;

	// ========== ЧТЕНИЕ ШАПКИ ИСТОЧНИКА ==========
	ЗапросШапка = Новый Запрос;
	ЗапросШапка.Текст =
	"ВЫБРАТЬ
	|	Док.Дата КАК Дата,
	|	Док.Организация КАК Организация,
	|	Док.Касса КАК Касса,
	|	Док.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
	|	Док.НоменклатураЗатрат КАК НоменклатураЗатрат,
	|	Док.СтатьяЗатратКомиссия КАК СтатьяЗатрат,
	|	Док.Подразделение КАК Подразделение,
	|	Док.А_НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Док.Касса.ВалютаДенежныхСредств КАК Валюта
	|ИЗ
	|	Документ.А_ПриходДенегОтФинАгента КАК Док
	|ГДЕ
	|	Док.Ссылка = &Ссылка";
	ЗапросШапка.УстановитьПараметр("Ссылка", ДокОснование);

	РезШапка = ЗапросШапка.Выполнить();
	Если РезШапка.Пустой() Тогда
		Сообщить("Документ-источник не найден!");
		Возврат;
	КонецЕсли;

	ВыбШапка = РезШапка.Выбрать();
	ВыбШапка.Следующий();

	ДатаДокумента         = ВыбШапка.Дата;
	Организация           = ВыбШапка.Организация;
	Касса                 = ВыбШапка.Касса;
	СтатьяДДС             = ВыбШапка.СтатьяДДС;
	НоменклатураЗатрат    = ВыбШапка.НоменклатураЗатрат;
	СтатьяЗатрат          = ВыбШапка.СтатьяЗатрат;
	Подразделение         = ВыбШапка.Подразделение;
	НаправлениеДеятельности = ВыбШапка.НаправлениеДеятельности;
	Валюта                = ВыбШапка.Валюта;

	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		Валюта = Справочники.Валюты.НайтиПоКоду("980");
	КонецЕсли;

	// ========== ЧТЕНИЕ СТРОК РАСШИФРОВКИ С Сумма > 0 ==========
	ЗапросСтрок = Новый Запрос;
	ЗапросСтрок.Текст =
	"ВЫБРАТЬ
	|	Стр.НомерСтроки КАК НомерСтроки,
	|	Стр.Контрагент КАК Контрагент,
	|	Стр.ОбъектРасчетов КАК ОбъектРасчетов,
	|	Стр.Сумма КАК Сумма,
	|	Стр.СуммаКомиссии КАК СуммаКомиссии,
	|	Стр.А_ПроцентФинАгента КАК ПроцентФинАгента
	|ИЗ
	|	Документ.А_ПриходДенегОтФинАгента.РасшифровкаПлатежа КАК Стр
	|ГДЕ
	|	Стр.Ссылка = &Ссылка
	|	И Стр.Сумма > 0
	|УПОРЯДОЧИТЬ ПО
	|	Стр.НомерСтроки";
	ЗапросСтрок.УстановитьПараметр("Ссылка", ДокОснование);

	РезСтрок = ЗапросСтрок.Выполнить();
	Если РезСтрок.Пустой() Тогда
		Сообщить("Нет строк с Сумма > 0 в РасшифровкаПлатежа!");
		Возврат;
	КонецЕсли;

	ТаблицаСтрок = РезСтрок.Выгрузить();
	Сообщить("Найдено строк: " + Строка(ТаблицаСтрок.Количество()));

	// ========== ФАЗА 2: ПОИСК / СОЗДАНИЕ ДОКУМЕНТОВ ==========

	КолСозданоПКО    = 0;
	КолОбновленоПКО  = 0;
	КолСозданоРКО    = 0;
	КолОбновленоРКО  = 0;
	КолСозданоПриобр = 0;
	КолОбновленоПриобр = 0;

	Для Каждого СтрТаблицы Из ТаблицаСтрок Цикл

		СтрКонтрагент       = СтрТаблицы.Контрагент;
		СтрОбъектРасчетов   = СтрТаблицы.ОбъектРасчетов;
		СтрСумма            = СтрТаблицы.Сумма;
		СтрСуммаКомиссии    = СтрТаблицы.СуммаКомиссии;
		СтрНомерСтроки      = СтрТаблицы.НомерСтроки;
		СтрПроцентФинАгента = СтрТаблицы.ПроцентФинАгента;

		// Партнёр
		СтрПартнер = Неопределено;
		Попытка
			СтрПартнер = ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(СтрКонтрагент);
		Исключение
			ЗапросПартнер = Новый Запрос;
			ЗапросПартнер.Текст = "ВЫБРАТЬ Партнер ИЗ Справочник.Контрагенты ГДЕ Ссылка = &К";
			ЗапросПартнер.УстановитьПараметр("К", СтрКонтрагент);
			РезП = ЗапросПартнер.Выполнить();
			Если НЕ РезП.Пустой() Тогда
				ВыбП = РезП.Выбрать();
				ВыбП.Следующий();
				СтрПартнер = ВыбП.Партнер;
			КонецЕсли;
		КонецПопытки;

		// Договор (для Приобретения)
		СтрДоговор = Неопределено;
		Если СтрСуммаКомиссии > 0 Тогда
			ЗапросДоговор = Новый Запрос;
			ЗапросДоговор.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Ссылка
			|ИЗ
			|	Справочник.ДоговорыКонтрагентов
			|ГДЕ
			|	Контрагент = &Контрагент
			|	И НЕ ПометкаУдаления
			|	И Организация = &Организация";
			ЗапросДоговор.УстановитьПараметр("Контрагент", СтрКонтрагент);
			ЗапросДоговор.УстановитьПараметр("Организация", Организация);
			РезДоговор = ЗапросДоговор.Выполнить();
			Если НЕ РезДоговор.Пустой() Тогда
				ВыбДоговор = РезДоговор.Выбрать();
				ВыбДоговор.Следующий();
				СтрДоговор = ВыбДоговор.Ссылка;
			КонецЕсли;
		КонецЕсли;

		// ===== 4а. ПКО: ПОИСК → обновить / создать =====
		СсылкаПКО = Неопределено;

		ЗапросПКО = Новый Запрос;
		ЗапросПКО.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Док.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПриходныйКассовыйОрдер КАК Док
		|ГДЕ
		|	Док.А_ПриходДенегОтФинАгента = &Основание
		|	И Док.А_КодСтрокиПриходДенегОтФинАгента = &НомерСтроки";
		ЗапросПКО.УстановитьПараметр("Основание", ДокОснование);
		ЗапросПКО.УстановитьПараметр("НомерСтроки", СтрНомерСтроки);

		РезПКО = ЗапросПКО.Выполнить();

		Если НЕ РезПКО.Пустой() Тогда
			// НАЙДЕН → обновить
			ВыбПКО = РезПКО.Выбрать();
			ВыбПКО.Следующий();
			Попытка
				ДокОбъектПКО = ВыбПКО.Ссылка.ПолучитьОбъект();
				ДокОбъектПКО.УстановитьПометкуУдаления(Ложь);
				ЗаполнитьПКО(ДокОбъектПКО, ДатаДокумента, Организация, Касса, Валюта,
					СтрКонтрагент, СтрПартнер, СтрСумма, СтатьяДДС, Подразделение,
					НаправлениеДеятельности, ДокОснование, СтрНомерСтроки,
					СтрПроцентФинАгента, СтрСуммаКомиссии, СтрОбъектРасчетов);
				ДокОбъектПКО.Записать(РежимЗаписиДокумента.Проведение);
				СсылкаПКО = ДокОбъектПКО.Ссылка;
				КолОбновленоПКО = КолОбновленоПКО + 1;
				Сообщить("Строка " + Строка(СтрНомерСтроки) + ": обновлён ПКО " + ДокОбъектПКО.Номер
					+ " на " + Формат(СтрСумма, "ЧДЦ=2")
					+ " (" + Строка(СтрКонтрагент) + ")");
			Исключение
				Сообщить("ОШИБКА обновления ПКО строка " + Строка(СтрНомерСтроки)
					+ ": " + ОписаниеОшибки());
				Продолжить;
			КонецПопытки;
		Иначе
			// НЕ НАЙДЕН → создать
			Попытка
				НовыйПКО = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
				ЗаполнитьПКО(НовыйПКО, ДатаДокумента, Организация, Касса, Валюта,
					СтрКонтрагент, СтрПартнер, СтрСумма, СтатьяДДС, Подразделение,
					НаправлениеДеятельности, ДокОснование, СтрНомерСтроки,
					СтрПроцентФинАгента, СтрСуммаКомиссии, СтрОбъектРасчетов);
				НовыйПКО.Записать(РежимЗаписиДокумента.Проведение);
				СсылкаПКО = НовыйПКО.Ссылка;
				КолСозданоПКО = КолСозданоПКО + 1;
				Сообщить("Строка " + Строка(СтрНомерСтроки) + ": создан ПКО " + НовыйПКО.Номер
					+ " на " + Формат(СтрСумма, "ЧДЦ=2")
					+ " (" + Строка(СтрКонтрагент) + ")");
			Исключение
				Сообщить("ОШИБКА создания ПКО строка " + Строка(СтрНомерСтроки)
					+ ": " + ОписаниеОшибки());
				Продолжить; // Без ПКО нет смысла создавать РКО и Приобретение
			КонецПопытки;
		КонецЕсли;

		// РКО и Приобретение только если есть комиссия
		Если СтрСуммаКомиссии <= 0 Тогда
			Продолжить;
		КонецЕсли;

		// ===== 4б. РКО: ПОИСК → обновить / создать =====
		ЗапросРКО = Новый Запрос;
		ЗапросРКО.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Док.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РасходныйКассовыйОрдер КАК Док
		|ГДЕ
		|	Док.А_ПриходДенегОтФинАгента = &Основание
		|	И Док.А_ПриходныйКассовыйОрдерОтФинАгента = &СсылкаПКО";
		ЗапросРКО.УстановитьПараметр("Основание", ДокОснование);
		ЗапросРКО.УстановитьПараметр("СсылкаПКО", СсылкаПКО);

		РезРКО = ЗапросРКО.Выполнить();

		Если НЕ РезРКО.Пустой() Тогда
			// НАЙДЕН → обновить
			ВыбРКО = РезРКО.Выбрать();
			ВыбРКО.Следующий();
			Попытка
				ДокОбъектРКО = ВыбРКО.Ссылка.ПолучитьОбъект();
				ДокОбъектРКО.УстановитьПометкуУдаления(Ложь);
				ЗаполнитьРКО(ДокОбъектРКО, ДатаДокумента, Организация, Касса, Валюта,
					СтрКонтрагент, СтрПартнер, СтрСуммаКомиссии, СтатьяДДС, Подразделение,
					НаправлениеДеятельности, ДокОснование, СсылкаПКО, СтрОбъектРасчетов);
				ДокОбъектРКО.Записать(РежимЗаписиДокумента.Проведение);
				КолОбновленоРКО = КолОбновленоРКО + 1;
				Сообщить("Строка " + Строка(СтрНомерСтроки) + ": обновлён РКО " + ДокОбъектРКО.Номер
					+ " на " + Формат(СтрСуммаКомиссии, "ЧДЦ=2"));
			Исключение
				Сообщить("ОШИБКА обновления РКО строка " + Строка(СтрНомерСтроки)
					+ ": " + ОписаниеОшибки());
			КонецПопытки;
		Иначе
			// НЕ НАЙДЕН → создать
			Попытка
				НовыйРКО = Документы.РасходныйКассовыйОрдер.СоздатьДокумент();
				ЗаполнитьРКО(НовыйРКО, ДатаДокумента, Организация, Касса, Валюта,
					СтрКонтрагент, СтрПартнер, СтрСуммаКомиссии, СтатьяДДС, Подразделение,
					НаправлениеДеятельности, ДокОснование, СсылкаПКО, СтрОбъектРасчетов);
				НовыйРКО.Записать(РежимЗаписиДокумента.Проведение);
				КолСозданоРКО = КолСозданоРКО + 1;
				Сообщить("Строка " + Строка(СтрНомерСтроки) + ": создан РКО " + НовыйРКО.Номер
					+ " на " + Формат(СтрСуммаКомиссии, "ЧДЦ=2"));
			Исключение
				Сообщить("ОШИБКА создания РКО строка " + Строка(СтрНомерСтроки)
					+ ": " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;

		// ===== 4в. Приобретение: ПОИСК → обновить / создать =====
		ЗапросПриобр = Новый Запрос;
		ЗапросПриобр.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Док.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг КАК Док
		|ГДЕ
		|	Док.А_ПриходДенегОтФинАгента = &Основание
		|	И Док.А_ПриходныйКассовыйОрдерКомиссия = &СсылкаПКО";
		ЗапросПриобр.УстановитьПараметр("Основание", ДокОснование);
		ЗапросПриобр.УстановитьПараметр("СсылкаПКО", СсылкаПКО);

		РезПриобр = ЗапросПриобр.Выполнить();

		Если НЕ РезПриобр.Пустой() Тогда
			// НАЙДЕН → обновить
			ВыбПриобр = РезПриобр.Выбрать();
			ВыбПриобр.Следующий();
			Попытка
				ДокОбъектПриобр = ВыбПриобр.Ссылка.ПолучитьОбъект();
				ДокОбъектПриобр.УстановитьПометкуУдаления(Ложь);
				ЗаполнитьПриобретение(ДокОбъектПриобр, ДатаДокумента, Организация, Валюта,
					СтрКонтрагент, СтрПартнер, СтрСуммаКомиссии, Подразделение,
					НаправлениеДеятельности, ДокОснование, СсылкаПКО, СтрДоговор,
					НоменклатураЗатрат, СтатьяЗатрат, СтрОбъектРасчетов);
				ДокОбъектПриобр.Записать(РежимЗаписиДокумента.Проведение);
				КолОбновленоПриобр = КолОбновленоПриобр + 1;
				Сообщить("Строка " + Строка(СтрНомерСтроки) + ": обновлено Приобретение " + ДокОбъектПриобр.Номер
					+ " на " + Формат(СтрСуммаКомиссии, "ЧДЦ=2"));
			Исключение
				Сообщить("ОШИБКА обновления Приобретения строка " + Строка(СтрНомерСтроки)
					+ ": " + ОписаниеОшибки());
			КонецПопытки;
		Иначе
			// НЕ НАЙДЕН → создать
			Попытка
				НовоеПриобр = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
				ЗаполнитьПриобретение(НовоеПриобр, ДатаДокумента, Организация, Валюта,
					СтрКонтрагент, СтрПартнер, СтрСуммаКомиссии, Подразделение,
					НаправлениеДеятельности, ДокОснование, СсылкаПКО, СтрДоговор,
					НоменклатураЗатрат, СтатьяЗатрат, СтрОбъектРасчетов);
				НовоеПриобр.Записать(РежимЗаписиДокумента.Проведение);
				КолСозданоПриобр = КолСозданоПриобр + 1;
				Сообщить("Строка " + Строка(СтрНомерСтроки) + ": создано Приобретение " + НовоеПриобр.Номер
					+ " на " + Формат(СтрСуммаКомиссии, "ЧДЦ=2"));
			Исключение
				Сообщить("ОШИБКА создания Приобретения строка " + Строка(СтрНомерСтроки)
					+ ": " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;

	КонецЦикла;

	// ========== ИТОГОВОЕ СООБЩЕНИЕ ==========
	Сообщить("=== ИТОГО ===");
	Сообщить("ПКО: создано " + Строка(КолСозданоПКО) + ", обновлено " + Строка(КолОбновленоПКО));
	Сообщить("РКО: создано " + Строка(КолСозданоРКО) + ", обновлено " + Строка(КолОбновленоРКО));
	Сообщить("Приобретений: создано " + Строка(КолСозданоПриобр) + ", обновлено " + Строка(КолОбновленоПриобр));
	Сообщить("Обработка завершена.");

КонецПроцедуры

&НаКлиенте
Процедура СоздатьПриходДенегПоФинАгенту(Команда)
	СоздатьПриходДенегПоФинАгентуНаСервере();
КонецПроцедуры
