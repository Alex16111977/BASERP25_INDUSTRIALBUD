
&НаСервере
Функция ОбеспечитьПартнераПоПодразделению(ПодразделениеСсылка)

	// 1. Определить правильного родителя в Партнёрах (рекурсия вверх)
	ГруппаПідрозділи = Справочники.Партнеры.НайтиПоКоду("0Ц-00000011");
	РодительПартнера = ГруппаПідрозділи;

	Если ЗначениеЗаполнено(ПодразделениеСсылка.Родитель) Тогда
		// РЕКУРСИЯ: сначала обеспечить родителя
		РодительПартнера = ОбеспечитьПартнераПоПодразделению(ПодразделениеСсылка.Родитель);
	КонецЕсли;

	// 2. Проверка: уже есть Партнёр для этого подразделения?
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Партнеры.Ссылка КАК Ссылка
		|ИЗ Справочник.Партнеры КАК Партнеры
		|ГДЕ Партнеры.А_Подразделение = &Подразделение";
	Запрос.УстановитьПараметр("Подразделение", ПодразделениеСсылка);
	Результат = Запрос.Выполнить();

	Если НЕ Результат.Пустой() Тогда
		// Партнёр уже есть — проверить и обновить иерархию + наименование
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		СуществующийПартнер = Выборка.Ссылка;
		НаименованиеПодразделения = ПодразделениеСсылка.Наименование;

		НужноОбновить = (СуществующийПартнер.Родитель <> РодительПартнера)
			ИЛИ (СуществующийПартнер.Наименование <> НаименованиеПодразделения);

		Если НужноОбновить Тогда
			ПартнерОбъект = СуществующийПартнер.ПолучитьОбъект();
			ПартнерОбъект.Родитель = РодительПартнера;
			ПартнерОбъект.Наименование = НаименованиеПодразделения;
			ПартнерОбъект.НаименованиеПолное = НаименованиеПодразделения;
			ПартнерОбъект.Записать();
			Сообщить("Обновлён Партнёр: " + НаименованиеПодразделения);
		КонецЕсли;

		Возврат СуществующийПартнер;
	КонецЕсли;

	// 3. Создать Партнёра
	НаименованиеПодразделения = ПодразделениеСсылка.Наименование;

	НовыйПартнер = Справочники.Партнеры.СоздатьЭлемент();
	НовыйПартнер.Наименование       = НаименованиеПодразделения;
	НовыйПартнер.НаименованиеПолное  = НаименованиеПодразделения;
	НовыйПартнер.Родитель            = РодительПартнера;
	НовыйПартнер.А_Подразделение     = ПодразделениеСсылка;
	НовыйПартнер.Клиент              = Истина;
	НовыйПартнер.Поставщик           = Истина;
	НовыйПартнер.ПрочиеОтношения     = Истина;
	НовыйПартнер.ЮрФизЛицо           = Перечисления.КомпанияЧастноеЛицо.Компания;
	НовыйПартнер.Записать();

	// 4. Создать Контрагента
	НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
	НовыйКонтрагент.Наименование       = НаименованиеПодразделения;
	НовыйКонтрагент.НаименованиеПолное  = НаименованиеПодразделения;
	НовыйКонтрагент.Партнер             = НовыйПартнер.Ссылка;
	НовыйКонтрагент.ЮрФизЛицо           = Перечисления.ЮрФизЛицо.ЮрЛицо;
	НовыйКонтрагент.Записать();

	Сообщить("Создан Партнёр + Контрагент: " + НаименованиеПодразделения);

	Возврат НовыйПартнер.Ссылка;

КонецФункции

&НаСервере
Процедура СоздатьКонтрагентаПоПодразделениюНаСервере()

	Если НЕ ЗначениеЗаполнено(Объект.Подразделение) Тогда
		Сообщить("Не выбрано подразделение!");
		Возврат;
	КонецЕсли;

	ОбеспечитьПартнераПоПодразделению(Объект.Подразделение);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьКонтрагентаПоПодразделению(Команда)
	СоздатьКонтрагентаПоПодразделениюНаСервере();
КонецПроцедуры
