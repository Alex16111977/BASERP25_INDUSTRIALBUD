
////////////////////////////////////////////////////////////////////////////////
// МОДУЛЬ ФОРМЫ ОБРАБОТКИ "Заполнить документы ПокупкаПродажаВалюты"
//
// Назначение:
// - Загрузка документов ПокупкаПродажаВалюты за период по А_ОрганизацияБухгалтерия
// - Диагностика связей между ПВ и платежками
// - Исправление односторонних связей
//
// Архитектура организаций:
// - В ERP поле "Организация" = одна консолидирующая
// - Поле "А_ОрганизацияБухгалтерия" = реальная организация из BuhBud
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ЗагрузитьПокупкаПродажаВалюты(Команда)
	ЗагрузитьПокупкаПродажаВалютыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДокументыПокупкаПродажаВалюты(Команда)

	Если Объект.ПокупкаПродажаВалюты.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Сначала загрузите документы!");
		Возврат;
	КонецЕсли;

	КоличествоОбновленных = ОбновитьДокументыНаСервере();
	ПоказатьПредупреждение(, "Обновлено документов: " + КоличествоОбновленных);

	// Перезагрузить данные
	ЗагрузитьПокупкаПродажаВалютыНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииСервер

&НаСервере
Процедура ЗагрузитьПокупкаПродажаВалютыНаСервере()

	Объект.ПокупкаПродажаВалюты.Очистить();

	Если НЕ ЗначениеЗаполнено(Объект.А_ОрганизацияБухгалтерия) Тогда
		Сообщить("Не указана организация бухгалтерии!");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		Сообщить("Не указан период!");
		Возврат;
	КонецЕсли;

	// Запрос для загрузки ПокупкаПродажаВалюты
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПВ.Ссылка КАК ДокПокупкаПродажаВалюты,
	|	ПВ.А_ПлатежкаПеречисленияНаПокупкуПродажиВалюты,
	|	ПВ.А_ПлатежкаЗачисленияНаПокупкуПродажиВалюты,
	|	ПВ.А_ПлатежкаЗачисленияВозвратаНаПокупкуПродажиВалюты,
	|	ПВ.А_ОрганизацияБухгалтерия КАК А_ОрганизацияБухгалтерияПВ,
	|	ПВ.ХозяйственнаяОперация,
	|	ПВ.СуммаВалютная,
	|	ПВ.СуммаГривневая,
	|	ПВ.Дата,
	|	ПВ.А_Закрытый,
	|	ПВ.СуммаКомиссионные КАК СуммаКомиссии
	|ИЗ
	|	Документ.ПокупкаПродажаВалюты КАК ПВ
	|ГДЕ
	|	ПВ.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ПВ.А_ОрганизацияБухгалтерия = &А_ОрганизацияБухгалтерия
	|	И НЕ ПВ.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	ПВ.Дата";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Объект.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Объект.ОкончаниеПериода));
	Запрос.УстановитьПараметр("А_ОрганизацияБухгалтерия", Объект.А_ОрганизацияБухгалтерия);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ПокупкаПродажаВалюты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;

	// Заполнение сумм платежек и расчет баланса
	ЗаполнитьСуммыПлатежекИБаланс();

	// Запуск диагностики
	ВыполнитьДиагностику();

КонецПроцедуры

&НаСервере
Процедура ВыполнитьДиагностику()

	Для Каждого СтрокаТЧ Из Объект.ПокупкаПродажаВалюты Цикл

		ТипПроблемы = "";
		ДокПВ = СтрокаТЧ.ДокПокупкаПродажаВалюты;
		СтрокаТЧ.К1_Совпадение = Истина;

		// ================================================================================
		// Контур 1: Поиск платежек по обратной ссылке А_ПокупкаПродажаВалюты
		// ================================================================================

		// 1.1 Поиск СписаниеБезналичныхДС (А_ПлатежкаПеречисления)
		ЗапросСписание = Новый Запрос;
		ЗапросСписание.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Списание.Ссылка КАК Платежка
		|ИЗ
		|	Документ.СписаниеБезналичныхДенежныхСредств КАК Списание
		|ГДЕ
		|	Списание.А_ПокупкаПродажаВалюты = &ДокПВ
		|	И НЕ Списание.ПометкаУдаления";
		ЗапросСписание.УстановитьПараметр("ДокПВ", ДокПВ);

		РезультатСписание = ЗапросСписание.Выполнить();
		Если НЕ РезультатСписание.Пустой() Тогда
			ВыборкаСписание = РезультатСписание.Выбрать();
			ВыборкаСписание.Следующий();
			НайденнаяПлатежкаПеречисления = ВыборкаСписание.Платежка;

			// Проверка совпадения
			Если СтрокаТЧ.А_ПлатежкаПеречисленияНаПокупкуПродажиВалюты <> НайденнаяПлатежкаПеречисления Тогда
				Если ЗначениеЗаполнено(СтрокаТЧ.А_ПлатежкаПеречисленияНаПокупкуПродажиВалюты) Тогда
					ТипПроблемы = "Расхождение К1: в ПВ=" + Строка(СтрокаТЧ.А_ПлатежкаПеречисленияНаПокупкуПродажиВалюты) + ", найдено=" + Строка(НайденнаяПлатежкаПеречисления);
				Иначе
					ТипПроблемы = "Не заполнено А_ПлатежкаПеречисления в ПВ (К1 найдена: " + Строка(НайденнаяПлатежкаПеречисления) + ")";
				КонецЕсли;
				СтрокаТЧ.К1_Совпадение = Ложь;
			КонецЕсли;
		КонецЕсли;

		// 1.2 Поиск ПоступлениеБезналичныхДС (А_ПлатежкаЗачисления)
		ЗапросПоступление = Новый Запрос;
		ЗапросПоступление.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Поступление.Ссылка КАК Платежка,
		|	Поступление.БанковскийСчет.ВалютаДенежныхСредств КАК Валюта
		|ИЗ
		|	Документ.ПоступлениеБезналичныхДенежныхСредств КАК Поступление
		|ГДЕ
		|	Поступление.А_ПокупкаПродажаВалюты = &ДокПВ
		|	И НЕ Поступление.ПометкаУдаления";
		ЗапросПоступление.УстановитьПараметр("ДокПВ", ДокПВ);

		РезультатПоступление = ЗапросПоступление.Выполнить();
		Если НЕ РезультатПоступление.Пустой() Тогда
			ВыборкаПост = РезультатПоступление.Выбрать();
			Пока ВыборкаПост.Следующий() Цикл
				НайденнаяПлатежкаЗачисления = ВыборкаПост.Платежка;
				ВалютаПлатежки = ВыборкаПост.Валюта;
				ВалютаУАХ = Константы.ВалютаРегламентированногоУчета.Получить();

				// Определяем тип платежки с учетом хозяйственной операции ПВ
				// При ПОКУПКЕ валюты: грн = возврат, валюта = зачисление
				// При ПРОДАЖЕ валюты: грн = ОСНОВНОЕ зачисление (выручка!), валюта = возврат
				ХозОперацияПВ = СтрокаТЧ.ХозяйственнаяОперация;

				Если ХозОперацияПВ = Перечисления.ХозяйственныеОперации.ПокупкаВалюты Тогда
					// ПОКУПКА ВАЛЮТЫ:
					// - Поступление валюты = зачисление купленной валюты
					// - Поступление грн = возврат остатка
					ЭтоЗачислениеВозврата = (ВалютаПлатежки = ВалютаУАХ);
				ИначеЕсли ХозОперацияПВ = Перечисления.ХозяйственныеОперации.ПродажаВалюты Тогда
					// ПРОДАЖА ВАЛЮТЫ:
					// - Поступление грн = ОСНОВНОЕ зачисление (выручка от продажи!)
					// - Поступление валюты = возврат непроданной валюты
					ЭтоЗачислениеВозврата = (ВалютаПлатежки <> ВалютаУАХ);
				Иначе
					// Неизвестная операция - по умолчанию как раньше
					ЭтоЗачислениеВозврата = (ВалютаПлатежки = ВалютаУАХ);
				КонецЕсли;

				Если ЭтоЗачислениеВозврата Тогда
					// Это возврат (А_ПлатежкаЗачисленияВозврата)
					Если СтрокаТЧ.А_ПлатежкаЗачисленияВозвратаНаПокупкуПродажиВалюты <> НайденнаяПлатежкаЗачисления Тогда
						Если ПустаяСтрока(ТипПроблемы) Тогда
							Если ЗначениеЗаполнено(СтрокаТЧ.А_ПлатежкаЗачисленияВозвратаНаПокупкуПродажиВалюты) Тогда
								ТипПроблемы = "Расхождение А_ПлатежкаЗачисленияВозврата";
							Иначе
								ТипПроблемы = "Не заполнено А_ПлатежкаЗачисленияВозврата (К1: " + Строка(НайденнаяПлатежкаЗачисления) + ")";
							КонецЕсли;
						КонецЕсли;
						СтрокаТЧ.К1_Совпадение = Ложь;
					КонецЕсли;
				Иначе
					// Это основное зачисление (А_ПлатежкаЗачисления)
					Если СтрокаТЧ.А_ПлатежкаЗачисленияНаПокупкуПродажиВалюты <> НайденнаяПлатежкаЗачисления Тогда
						Если ПустаяСтрока(ТипПроблемы) Тогда
							Если ЗначениеЗаполнено(СтрокаТЧ.А_ПлатежкаЗачисленияНаПокупкуПродажиВалюты) Тогда
								ТипПроблемы = "Расхождение А_ПлатежкаЗачисления";
							Иначе
								ТипПроблемы = "Не заполнено А_ПлатежкаЗачисления (К1: " + Строка(НайденнаяПлатежкаЗачисления) + ")";
							КонецЕсли;
						КонецЕсли;
						СтрокаТЧ.К1_Совпадение = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// Проверка: ПВ без единой платежки (и не закрыт)
		Если ПустаяСтрока(ТипПроблемы) Тогда
			РеквизитыПВ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокПВ, "А_Закрытый");
			Если НЕ РеквизитыПВ.А_Закрытый
				И НЕ ЗначениеЗаполнено(СтрокаТЧ.А_ПлатежкаПеречисленияНаПокупкуПродажиВалюты)
				И НЕ ЗначениеЗаполнено(СтрокаТЧ.А_ПлатежкаЗачисленияНаПокупкуПродажиВалюты)
				И НЕ ЗначениеЗаполнено(СтрокаТЧ.А_ПлатежкаЗачисленияВозвратаНаПокупкуПродажиВалюты) Тогда

				// Проверяем, есть ли платежки по Контуру 1
				Если РезультатСписание.Пустой() И РезультатПоступление.Пустой() Тогда
					ТипПроблемы = "ПВ без единой платежки";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		СтрокаТЧ.ТипПроблемы = ТипПроблемы;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ОбновитьДокументыНаСервере()

	КоличествоОбновленных = 0;

	Для Каждого СтрокаТЧ Из Объект.ПокупкаПродажаВалюты Цикл
		
		ДокПВОбъект = СтрокаТЧ.ДокПокупкаПродажаВалюты.ПолучитьОбъект();
			ДокПВОбъект.ОбменДанными.Загрузка = Истина;
           ДокПВОбъект.А_ПлатежкаПеречисленияНаПокупкуПродажиВалюты = Неопределено; 
		   ДокПВОбъект.А_ПлатежкаЗачисленияНаПокупкуПродажиВалюты = Неопределено; 
		   ДокПВОбъект.А_ПлатежкаЗачисленияВозвратаНаПокупкуПродажиВалюты = Неопределено; 
		    ДокПВОбъект.Записать();

			
		//Если ПустаяСтрока(СтрокаТЧ.ТипПроблемы) ИЛИ СтрокаТЧ.К1_Совпадение Тогда
		//	Продолжить;
		//КонецЕсли;

		ДокПВ = СтрокаТЧ.ДокПокупкаПродажаВалюты;
		ТребуетсяЗапись = Ложь;
		
		
		НачатьТранзакцию();
		Попытка

			БлокировкаДанных = Новый БлокировкаДанных;
			ЭлементБлокировки = БлокировкаДанных.Добавить("Документ.ПокупкаПродажаВалюты");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", ДокПВ);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			БлокировкаДанных.Заблокировать();

			ДокПВОбъект = ДокПВ.ПолучитьОбъект();
			ДокПВОбъект.ОбменДанными.Загрузка = Истина;
         
			// Поиск и заполнение А_ПлатежкаПеречисления
			Если НЕ ЗначениеЗаполнено(ДокПВОбъект.А_ПлатежкаПеречисленияНаПокупкуПродажиВалюты) Тогда
				ЗапросСписание = Новый Запрос;
				ЗапросСписание.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Списание.Ссылка
				|ИЗ
				|	Документ.СписаниеБезналичныхДенежныхСредств КАК Списание
				|ГДЕ
				|	Списание.А_ПокупкаПродажаВалюты = &ДокПВ
				|	И НЕ Списание.ПометкаУдаления";
				ЗапросСписание.УстановитьПараметр("ДокПВ", ДокПВ);
				РезСписание = ЗапросСписание.Выполнить();
				Если НЕ РезСписание.Пустой() Тогда
					ВыбСписание = РезСписание.Выбрать();
					ВыбСписание.Следующий();
					ДокПВОбъект.А_ПлатежкаПеречисленияНаПокупкуПродажиВалюты = ВыбСписание.Ссылка;
					ТребуетсяЗапись = Истина;
				КонецЕсли;
			КонецЕсли;

			// Поиск и заполнение А_ПлатежкаЗачисления и А_ПлатежкаЗачисленияВозврата
			ЗапросПоступление = Новый Запрос;
			ЗапросПоступление.Текст =
			"ВЫБРАТЬ
			|	Поступление.Ссылка КАК Платежка,
			|	Поступление.БанковскийСчет.ВалютаДенежныхСредств КАК Валюта
			|ИЗ
			|	Документ.ПоступлениеБезналичныхДенежныхСредств КАК Поступление
			|ГДЕ
			|	Поступление.А_ПокупкаПродажаВалюты = &ДокПВ
			|	И НЕ Поступление.ПометкаУдаления";
			ЗапросПоступление.УстановитьПараметр("ДокПВ", ДокПВ);

			ВалютаУАХ = Константы.ВалютаРегламентированногоУчета.Получить();

			РезПоступление = ЗапросПоступление.Выполнить();
			Если НЕ РезПоступление.Пустой() Тогда
				ВыбПост = РезПоступление.Выбрать();
				Пока ВыбПост.Следующий() Цикл
					// Определяем тип платежки с учетом хозяйственной операции ПВ
					// При ПОКУПКЕ валюты: грн = возврат, валюта = зачисление
					// При ПРОДАЖЕ валюты: грн = ОСНОВНОЕ зачисление (выручка!), валюта = возврат
					ХозОперацияПВ = ДокПВОбъект.ХозяйственнаяОперация;

					Если ХозОперацияПВ = Перечисления.ХозяйственныеОперации.ПокупкаВалюты Тогда
						ЭтоЗачислениеВозврата = (ВыбПост.Валюта = ВалютаУАХ);
					ИначеЕсли ХозОперацияПВ = Перечисления.ХозяйственныеОперации.ПродажаВалюты Тогда
						ЭтоЗачислениеВозврата = (ВыбПост.Валюта <> ВалютаУАХ); // Инверсная логика!
					Иначе
						ЭтоЗачислениеВозврата = (ВыбПост.Валюта = ВалютаУАХ);
					КонецЕсли;

					Если ЭтоЗачислениеВозврата Тогда
						// Возврат
						Если НЕ ЗначениеЗаполнено(ДокПВОбъект.А_ПлатежкаЗачисленияВозвратаНаПокупкуПродажиВалюты) Тогда
							ДокПВОбъект.А_ПлатежкаЗачисленияВозвратаНаПокупкуПродажиВалюты = ВыбПост.Платежка;
							ТребуетсяЗапись = Истина;
						КонецЕсли;
					Иначе
						// Основное зачисление
						Если НЕ ЗначениеЗаполнено(ДокПВОбъект.А_ПлатежкаЗачисленияНаПокупкуПродажиВалюты) Тогда
							ДокПВОбъект.А_ПлатежкаЗачисленияНаПокупкуПродажиВалюты = ВыбПост.Платежка;
							ТребуетсяЗапись = Истина;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;

			Если ТребуетсяЗапись Тогда
				ДокПВОбъект.Записать();
				КоличествоОбновленных = КоличествоОбновленных + 1;
			КонецЕсли;

			ЗафиксироватьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			Сообщить("Ошибка при обновлении " + ДокПВ + ": " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	Возврат КоличествоОбновленных;

КонецФункции

&НаСервере
Процедура ЗаполнитьСуммыПлатежекИБаланс()

	// Получаем валюту регламентированного учета (гривна)
	ВалютаГрн = Константы.ВалютаРегламентированногоУчета.Получить();

	Для Каждого СтрокаТЧ Из Объект.ПокупкаПродажаВалюты Цикл

		// ================================================================================
		// 1. СуммаПеречисления - из СписаниеБезналичныхДенежныхСредств.СуммаДокумента
		// Всегда в гривнах - берем напрямую
		// ================================================================================
		Если ЗначениеЗаполнено(СтрокаТЧ.А_ПлатежкаПеречисленияНаПокупкуПродажиВалюты) Тогда
			СтрокаТЧ.СуммаПеречисления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				СтрокаТЧ.А_ПлатежкаПеречисленияНаПокупкуПродажиВалюты,
				"СуммаДокумента");
		Иначе
			СтрокаТЧ.СуммаПеречисления = 0;
		КонецЕсли;

		// ================================================================================
		// 2. СуммаЗачисления - из ПоступлениеБезналичныхДенежныхСредств
		// КРИТИЧНО: платежка может быть валютной (USD)!
		// Если валюта ≠ грн → брать СуммаКонвертации для гривневого эквивалента
		// ================================================================================
		Если ЗначениеЗаполнено(СтрокаТЧ.А_ПлатежкаЗачисленияНаПокупкуПродажиВалюты) Тогда
			РеквизитыЗачисления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
				СтрокаТЧ.А_ПлатежкаЗачисленияНаПокупкуПродажиВалюты,
				"СуммаДокумента, СуммаКонвертации, Валюта");

			// Сумма в валюте документа (оригинальная)
			СтрокаТЧ.СуммаЗачисленияВал = РеквизитыЗачисления.СуммаДокумента;

			// Гривневый эквивалент: если валюта != грн то СуммаКонвертации иначе СуммаДокумента
			Если РеквизитыЗачисления.Валюта <> ВалютаГрн Тогда
				СтрокаТЧ.СуммаЗачисленияГрн = РеквизитыЗачисления.СуммаКонвертации;
			Иначе
				СтрокаТЧ.СуммаЗачисленияГрн = РеквизитыЗачисления.СуммаДокумента;
			КонецЕсли;
		Иначе
			СтрокаТЧ.СуммаЗачисленияВал = 0;
			СтрокаТЧ.СуммаЗачисленияГрн = 0;
		КонецЕсли;

		// ================================================================================
		// 3. СуммаВозвратаГрн - из ПоступлениеБезналичныхДенежныхСредств (возврат)
		// Обычно в грн - возврат остатка
		// ================================================================================
		Если ЗначениеЗаполнено(СтрокаТЧ.А_ПлатежкаЗачисленияВозвратаНаПокупкуПродажиВалюты) Тогда
			СтрокаТЧ.СуммаВозвратаГрн = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				СтрокаТЧ.А_ПлатежкаЗачисленияВозвратаНаПокупкуПродажиВалюты,
				"СуммаДокумента");
		Иначе
			СтрокаТЧ.СуммаВозвратаГрн = 0;
		КонецЕсли;

		// ================================================================================
		// 4. СуммаКомиссии - уже заполнена из запроса (ПокупкаПродажаВалюты.СуммаКомиссионные)
		// ================================================================================
		// СтрокаТЧ.СуммаКомиссии уже заполнена

		// ================================================================================
		// 5. Расчет разницы и контроль баланса
		// РазницаГрн = СуммаПеречисления - СуммаЗачисленияГрн - СуммаВозвратаГрн - СуммаКомиссии
		// Если РазницаГрн = 0 → Баланс OK
		// ================================================================================
		СтрокаТЧ.РазницаГрн = СтрокаТЧ.СуммаПеречисления
			- СтрокаТЧ.СуммаЗачисленияГрн
			- СтрокаТЧ.СуммаВозвратаГрн
			- СтрокаТЧ.СуммаКомиссии;

		// Баланс ОК если разница равна 0 (с допуском на копейки)
		СтрокаТЧ.БалансОК = (Окр(СтрокаТЧ.РазницаГрн, 2) = 0);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти
