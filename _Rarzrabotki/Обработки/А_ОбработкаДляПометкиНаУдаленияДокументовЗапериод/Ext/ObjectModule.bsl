// ===========================================================================
// Обработка: А_ОбработкаДляПометкиНаУдаленияДокументовЗапериод
// Назначение: пометка на удаление проведённых документов, которые делают
//             движения в регистрах баланса/ПнЛ и проводки по бухсчетам.
// ===========================================================================
// Фаза 1: анализ  — скан регистров, свод по видам документа, снимок выборки
// Фаза 2: пометка — порциями, с накоплением прогресса по снимку
// ===========================================================================
// Критерий отбора — ПО ФАКТУ ДВИЖЕНИЙ, а не по списку видов документов.
// Проверено на живой базе: 01.12.2025-30.06.2026 -> 28 видов / 30 342 док.
// ЗаказКлиента и ЗаказПоставщику в выборку не попадают (движений не делают).
//
// ВАЖНО: пометка снимает проведение, а снятие проведения удаляет движения.
// Помеченный документ исчезает из регистрового отбора. Поэтому знаменатель
// прогресса берётся из СНИМКА, а не из текущего скана.
// ===========================================================================

#Область ПрограммныйИнтерфейс

// Фаза 1. Сканирует регистры за период, строит свод по видам документа
// и объединяет результат с ранее сохранённым снимком.
//
// Возвращаемое значение:
//  Строка - краткий итог для показа пользователю
//
Функция ЗаполнитьСнимокИСтатус() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ТаблицаДокументов.Очистить();

	ТЗСкан = ВыполнитьСканирование("");

	// Объединение со старым снимком: обработанные документы уже не имеют
	// движений и в скан не попадают — без объединения они выпали бы из
	// знаменателя и процент поехал бы назад.
	Уникальные = Новый Соответствие;

	СтарыйСнимок = ЗагрузитьСнимок();
	Если СтарыйСнимок <> Неопределено Тогда
		Для Каждого СтрокаСтарая Из СтарыйСнимок Цикл
			Уникальные.Вставить(СтрокаСтарая.Документ, СтрокаСтарая.ИмяТипа);
		КонецЦикла;
	КонецЕсли;

	Для Каждого СтрокаСкана Из ТЗСкан Цикл
		Уникальные.Вставить(СтрокаСкана.Документ, СтрокаСкана.ИмяТипа);
	КонецЦикла;

	// Фильтры применяем к ОБЪЕДИНЁННОМУ результату, а не только к свежему скану:
	// иначе защищённые виды и новые остатки вернулись бы из старого снимка.
	ТЗИтог = Новый ТаблицаЗначений;
	ТЗИтог.Колонки.Добавить("Документ");
	ТЗИтог.Колонки.Добавить("ИмяТипа", Новый ОписаниеТипов("Строка"));

	Защищенные = ЗащищенныеВидыДокументов();

	Для Каждого КлючЗначение Из Уникальные Цикл
		Если Защищенные.Получить(КлючЗначение.Значение) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаИтога = ТЗИтог.Добавить();
		СтрокаИтога.Документ = КлючЗначение.Ключ;
		СтрокаИтога.ИмяТипа  = КлючЗначение.Значение;
	КонецЦикла;

	ИсключитьНовыеОстатки(ТЗИтог);

	Снимок.Очистить();
	Снимок.Загрузить(ТЗИтог);

	СохранитьСнимок();
	ОбновитьСтатус();

	// ЧН=0 обязателен: без него 1С рисует ноль пустой строкой
	Возврат "В снимке документов: " + Формат(ВсегоВСнимке, "ЧГ=0; ЧН=0")
		+ ", помечено: " + Формат(ВсегоПомечено, "ЧГ=0; ЧН=0")
		+ ", осталось: " + Формат(ВсегоОсталось, "ЧГ=0; ЧН=0");

КонецФункции

// Пересчитывает статус пометки по снимку, не пересобирая сам снимок.
//
Процедура ОбновитьСтатус() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если Снимок.Количество() = 0 Тогда
		СтарыйСнимок = ЗагрузитьСнимок();
		Если СтарыйСнимок <> Неопределено Тогда
			Снимок.Загрузить(СтарыйСнимок);
		КонецЕсли;
	КонецЕсли;

	Защищенные = ЗащищенныеВидыДокументов();

	// Группировка снимка по видам документа
	ПоВидам = Новый Соответствие;
	Для Каждого СтрокаСнимка Из Снимок Цикл
		МассивСсылок = ПоВидам.Получить(СтрокаСнимка.ИмяТипа);
		Если МассивСсылок = Неопределено Тогда
			МассивСсылок = Новый Массив;
			ПоВидам.Вставить(СтрокаСнимка.ИмяТипа, МассивСсылок);
		КонецЕсли;
		МассивСсылок.Добавить(СтрокаСнимка.Документ);
	КонецЦикла;

	// Сохраняем расставленные пользователем галки
	ОтмеченныеВиды = Новый Соответствие;
	Для Каждого СтрокаВида Из ТаблицаВидов Цикл
		Если СтрокаВида.Пометить Тогда
			ОтмеченныеВиды.Вставить(СтрокаВида.ИмяТипа, Истина);
		КонецЕсли;
	КонецЦикла;

	ТаблицаВидов.Очистить();

	Для Каждого КлючЗначение Из ПоВидам Цикл

		ИмяВида = КлючЗначение.Ключ;
		МассивСсылок = КлючЗначение.Значение;

		МетаВида = Метаданные.Документы.Найти(ИмяВида);
		Если МетаВида = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(*) КАК Всего,
			|	СУММА(ВЫБОР КОГДА Док.ПометкаУдаления ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Помечено,
			|	МИНИМУМ(Док.Дата) КАК ДатаМин,
			|	МАКСИМУМ(Док.Дата) КАК ДатаМакс
			|ИЗ
			|	Документ." + ИмяВида + " КАК Док
			|ГДЕ
			|	Док.Ссылка В (&МассивСсылок)";
		Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);

		Попытка
			ВыборкаИтогов = Запрос.Выполнить().Выбрать();
		Исключение
			Сообщить("Не удалось получить статус по виду """ + ИмяВида + """: " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Если Не ВыборкаИтогов.Следующий() Тогда
			Продолжить;
		КонецЕсли;

		СтрокаВида = ТаблицаВидов.Добавить();
		СтрокаВида.ИмяТипа = ИмяВида;
		СтрокаВида.ПредставлениеТипа = МетаВида.Синоним;
		СтрокаВида.Всего = ВыборкаИтогов.Всего;
		СтрокаВида.Помечено = ВыборкаИтогов.Помечено;
		СтрокаВида.Осталось = ВыборкаИтогов.Всего - ВыборкаИтогов.Помечено;
		СтрокаВида.ДатаМин = ВыборкаИтогов.ДатаМин;
		СтрокаВида.ДатаМакс = ВыборкаИтогов.ДатаМакс;
		СтрокаВида.Процент = ?(ВыборкаИтогов.Всего = 0, 0,
			Окр(ВыборкаИтогов.Помечено * 100 / ВыборкаИтогов.Всего, 1));
		СтрокаВида.Защищен = (Защищенные.Получить(ИмяВида) <> Неопределено);
		СтрокаВида.Пометить = Не СтрокаВида.Защищен
			И (ОтмеченныеВиды.Получить(ИмяВида) <> Неопределено);

	КонецЦикла;

	ТаблицаВидов.Сортировать("Осталось Убыв, Всего Убыв");

	ПересчитатьИтоги();

КонецПроцедуры

// Заполняет таблицу документов (расшифровку) по выбранному виду документа.
//
// Параметры:
//  ИмяВидаДокумента - Строка - имя типа документа в метаданных
//  МаксимумСтрок    - Число  - ограничение на количество строк
//
Процедура ЗаполнитьТаблицуДокументов(ИмяВидаДокумента, МаксимумСтрок = 5000) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ТаблицаДокументов.Очистить();

	Если ПустаяСтрока(ИмяВидаДокумента) Тогда
		Возврат;
	КонецЕсли;

	МетаВида = Метаданные.Документы.Найти(ИмяВидаДокумента);
	Если МетаВида = Неопределено Тогда
		Возврат;
	КонецЕсли;

	МассивСсылок = Новый Массив;
	Для Каждого СтрокаСнимка Из Снимок Цикл
		Если СтрокаСнимка.ИмяТипа = ИмяВидаДокумента Тогда
			МассивСсылок.Добавить(СтрокаСнимка.Документ);
		КонецЕсли;
	КонецЦикла;

	Если МассивСсылок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Состав реквизитов у 28 видов документов разный — Организацию и
	// Подразделение включаем только если они реально есть у этого вида.
	Если МетаВида.Реквизиты.Найти("Организация") <> Неопределено Тогда
		ПолеОрганизация = "Док.Организация КАК Организация";
	Иначе
		ПолеОрганизация = "ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация";
	КонецЕсли;

	Если МетаВида.Реквизиты.Найти("Подразделение") <> Неопределено Тогда
		ПолеПодразделение = "Док.Подразделение КАК Подразделение";
	Иначе
		ПолеПодразделение = "ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка) КАК Подразделение";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(МаксимумСтрок, "ЧГ=0") + "
		|	Док.Ссылка КАК Документ,
		|	Док.Дата КАК Дата,
		|	Док.Номер КАК Номер,
		|	Док.Проведен КАК Проведен,
		|	Док.ПометкаУдаления КАК Пометка,
		|	" + ПолеОрганизация + ",
		|	" + ПолеПодразделение + "
		|ИЗ
		|	Документ." + ИмяВидаДокумента + " КАК Док
		|ГДЕ
		|	Док.Ссылка В (&МассивСсылок)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);

	Попытка
		ТаблицаДокументов.Загрузить(Запрос.Выполнить().Выгрузить());
	Исключение
		Сообщить("Не удалось получить документы вида """ + ИмяВидаДокумента + """: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Возвращает очередную порцию документов для пометки.
//
// Документы берутся ЖИВЫМ сканом регистров: уже обработанные движений
// не имеют и в скан не попадают, поэтому очередь самоочищается.
//
// Параметры:
//  ИмяВидаДокумента - Строка - имя типа документа
//  РазмерПорции     - Число  - сколько документов вернуть
//
// Возвращаемое значение:
//  Массив - ссылки на документы
//
Функция ПолучитьПорциюДляПометки(ИмяВидаДокумента, РазмерПорции = 20) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Результат = Новый Массив;

	Защищенные = ЗащищенныеВидыДокументов();
	Если Защищенные.Получить(ИмяВидаДокумента) <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	МетаВида = Метаданные.Документы.Найти(ИмяВидаДокумента);
	Если МетаВида = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ТЗПорция = ВыполнитьСканирование(ИмяВидаДокумента, РазмерПорции);
	Для Каждого СтрокаПорции Из ТЗПорция Цикл
		Результат.Добавить(СтрокаПорции.Документ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Помечает на удаление переданные документы.
//
// УстановитьПометкуУдаления на проведённом документе сама снимает проведение
// и уничтожает все движения — отдельный вызов ОтменаПроведения не нужен.
// ОбменДанными.Загрузка использовать НЕЛЬЗЯ: платформа отвечает
// "Действие не может выполняться в режиме загрузки данных".
//
// Параметры:
//  МассивДокументов - Массив - ссылки на документы
//
// Возвращаемое значение:
//  Структура - Помечено, Ошибок, Пропущено, Протокол
//
Функция ПометитьПорцию(МассивДокументов) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Результат = Новый Структура("Помечено, Ошибок, Пропущено, Протокол", 0, 0, 0, "");
	СтрокиПротокола = Новый Массив;

	Для Каждого ДокСсылка Из МассивДокументов Цикл

		// Транзакция на документ НЕ открывается намеренно: сбой одного
		// документа не должен откатывать уже обработанные в этой порции.
		Попытка

			ДокОбъект = ДокСсылка.ПолучитьОбъект();
			Если ДокОбъект = Неопределено Тогда
				// Битая ссылка: движения в регистре есть, документа уже нет.
				// Пометить нечего, снять движения через документ невозможно.
				Результат.Пропущено = Результат.Пропущено + 1;
				Продолжить;
			КонецЕсли;

			Если Не ДокОбъект.ПометкаУдаления Тогда
				ДокОбъект.УстановитьПометкуУдаления(Истина);
			КонецЕсли;

			Результат.Помечено = Результат.Помечено + 1;

		Исключение

			Результат.Ошибок = Результат.Ошибок + 1;
			СтрокиПротокола.Добавить(Строка(ДокСсылка) + " -> " + ОписаниеОшибки());

		КонецПопытки;

	КонецЦикла;

	Результат.Протокол = СтрСоединить(СтрокиПротокола, Символы.ПС);

	Возврат Результат;

КонецФункции

// Возвращает имена видов документов, которые НИКОГДА не помечаются.
//
// Возвращаемое значение:
//  Соответствие - ключ: имя типа документа
//
Функция ЗащищенныеВидыДокументов() Экспорт

	Защищенные = Новый Соответствие;

	// Нужны для отчётов
	Защищенные.Вставить("А_ВводОстатковОтчетаPL", Истина);
	Защищенные.Вставить("А_ОтчетPL", Истина);
	Защищенные.Вставить("А_БюджетМесяц", Истина);

	// Участвуют в оплатах и приходах с 01.07.2026, движений в баланс/ПнЛ не делают
	Защищенные.Вставить("ЗаказКлиента", Истина);
	Защищенные.Вставить("ЗаказПоставщику", Истина);

	// Служебный документ механизма взаиморасчётов — им управляет система
	Защищенные.Вставить("РегистраторРасчетов", Истина);

	Возврат Защищенные;

КонецФункции

// Виды документов, которыми вводятся остатки.
//
// Их создают обработки "Перенос остатков*" (из бухгалтерии и казны).
// По ВИДУ их защищать нельзя: старые остатки 2025 года — те же самые виды,
// и они как раз должны удаляться. Разделитель — ДАТА (см. ДатаНовыхОстатков).
//
// Возвращаемое значение:
//  Соответствие - ключ: имя типа документа
//
Функция ВидыДокументовВводаОстатков() Экспорт

	Виды = Новый Соответствие;

	// Перенос остатков денег / денег по кассе из казны / РасчетыСПартнерами
	Виды.Вставить("ВводОстатков", Истина);

	// Перенос остатков номенклатуры / основных средств
	Виды.Вставить("ВводОстатковВнеоборотныхАктивов", Истина);

	// Перенос остатков налогов / исполнительных листов и соцфондов из бухгалтерии
	Виды.Вставить("КорректировкаРегистров", Истина);
	Виды.Вставить("ОперацияБух", Истина);

	// Перенос остатков сотрудников
	Виды.Вставить("НачальнаяЗадолженностьПоЗарплате", Истина);

	Возврат Виды;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Регистры, движения в которых означают участие документа в балансе и ПнЛ.
//
// Возвращаемое значение:
//  Массив - имена регистров накопления
//
Функция СписокРегистровНакопления()

	Регистры = Новый Массив;

	// Баланс: единственный источник сумм управленческого баланса
	Регистры.Добавить("ПрочиеАктивыПассивы");

	// ПнЛ
	Регистры.Добавить("ПрочиеРасходы");
	Регистры.Добавить("ПрочиеДоходы");
	Регистры.Добавить("ВыручкаИСебестоимостьПродаж");
	Регистры.Добавить("ФинансовыеРезультаты");
	Регистры.Добавить("ДвиженияНоменклатураДоходыРасходы");
	Регистры.Добавить("ДвиженияКонтрагентДоходыРасходы");
	Регистры.Добавить("ДвиженияДенежныеСредстваДоходыРасходы");
	Регистры.Добавить("ПартииПрочихРасходов");

	Возврат Регистры;

КонецФункции

// Сканирует регистры за период и возвращает документы-регистраторы.
//
// Параметры:
//  ИмяВидаДокумента - Строка - если заполнено, отбор только по этому виду
//  МаксимумСтрок    - Число  - 0 = без ограничения
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Документ, ИмяТипа
//
Функция ВыполнитьСканирование(ИмяВидаДокумента = "", МаксимумСтрок = 0)

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Документ");
	Результат.Колонки.Добавить("ИмяТипа", Новый ОписаниеТипов("Строка"));

	// Условие по виду документа — во ВНУТРЕННИЕ запросы объединения,
	// иначе платформа сканирует все регистры целиком.
	УсловиеВида = "";
	Если Не ПустаяСтрока(ИмяВидаДокумента) Тогда
		УсловиеВида = " И ТИПЗНАЧЕНИЯ({Алиас}.Регистратор) = ТИП(Документ." + ИмяВидаДокумента + ")";
	КонецЕсли;

	ЧастиОбъединения = Новый Массив;
	Индекс = 0;

	Для Каждого ИмяРегистра Из СписокРегистровНакопления() Цикл
		Алиас = "Т" + Формат(Индекс, "ЧГ=0");
		ЧастиОбъединения.Добавить(
			"ВЫБРАТЬ " + Алиас + ".Регистратор КАК Рег
			|ИЗ РегистрНакопления." + ИмяРегистра + " КАК " + Алиас + "
			|ГДЕ " + Алиас + ".Период МЕЖДУ &НачалоП И &КонецП"
			+ СтрЗаменить(УсловиеВида, "{Алиас}", Алиас));
		Индекс = Индекс + 1;
	КонецЦикла;

	ЧастиОбъединения.Добавить(
		"ВЫБРАТЬ ТБух.Регистратор
		|ИЗ РегистрБухгалтерии.Хозрасчетный КАК ТБух
		|ГДЕ ТБух.Период МЕЖДУ &НачалоП И &КонецП"
		+ СтрЗаменить(УсловиеВида, "{Алиас}", "ТБух"));

	Объединение = СтрСоединить(ЧастиОбъединения, Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС);

	// ПЕРВЫЕ в запросе НЕ ставим: отсечение документов ввода остатков идёт
	// после выборки, и обрезка до фильтра вернула бы пустую порцию при
	// живых документах — вид ошибочно считался бы обработанным.
	// ВТР, а не В: "В" — зарезервированное слово (оператор IN)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Рег КАК Рег
		|ПОМЕСТИТЬ ВТРегистраторы
		|ИЗ (" + Объединение + ") КАК Объединенные
		|;
		|ВЫБРАТЬ ВТР.Рег КАК Документ
		|ИЗ ВТРегистраторы КАК ВТР";
	Запрос.УстановитьПараметр("НачалоП", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецП", КонецДня(ОкончаниеПериода));

	Выборка = Запрос.Выполнить().Выбрать();

	Защищенные = ЗащищенныеВидыДокументов();
	КэшИменТипов = Новый Соответствие;

	Пока Выборка.Следующий() Цикл

		ДокСсылка = Выборка.Документ;
		ТипДокумента = ТипЗнч(ДокСсылка);

		ИмяТипаДокумента = КэшИменТипов.Получить(ТипДокумента);
		Если ИмяТипаДокумента = Неопределено Тогда
			МетаНайденная = Метаданные.НайтиПоТипу(ТипДокумента);
			ИмяТипаДокумента = ?(МетаНайденная = Неопределено, "", МетаНайденная.Имя);
			КэшИменТипов.Вставить(ТипДокумента, ИмяТипаДокумента);
		КонецЕсли;

		Если ПустаяСтрока(ИмяТипаДокумента) Тогда
			Продолжить;
		КонецЕсли;

		Если Защищенные.Получить(ИмяТипаДокумента) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Документ = ДокСсылка;
		НоваяСтрока.ИмяТипа = ИмяТипаДокумента;

	КонецЦикла;

	ИсключитьНовыеОстатки(Результат);

	// Ограничение применяем ПОСЛЕ отсечения — см. комментарий к запросу
	Если МаксимумСтрок > 0 Тогда
		Пока Результат.Количество() > МаксимумСтрок Цикл
			Результат.Удалить(Результат.Количество() - 1);
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Убирает из выборки документы ввода остатков, датированные новой границей.
//
// Остатки на 30.06.2026 переносятся из бухгалтерии и казны обработками
// "Перенос остатков*". Они ставят документам дату КонецДня(ДатаОстатков),
// то есть 30.06.2026 23:59:59 — ВНУТРИ периода удаления. Без этого отсечения
// обработка уничтожила бы только что перенесённый баланс.
//
// Параметры:
//  ТаблицаОтбора - ТаблицаЗначений - колонки Документ, ИмяТипа; меняется на месте
//
Процедура ИсключитьНовыеОстатки(ТаблицаОтбора)

	Если Не ЗначениеЗаполнено(ДатаНовыхОстатков) Тогда
		Возврат;
	КонецЕсли;

	ВидыОстатков = ВидыДокументовВводаОстатков();
	ГраницаОстатков = НачалоДня(ДатаНовыхОстатков);

	// Группируем только те виды, которые вообще могут нести новые остатки
	ПоВидам = Новый Соответствие;
	Для Каждого СтрокаОтбора Из ТаблицаОтбора Цикл
		Если ВидыОстатков.Получить(СтрокаОтбора.ИмяТипа) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МассивПоВиду = ПоВидам.Получить(СтрокаОтбора.ИмяТипа);
		Если МассивПоВиду = Неопределено Тогда
			МассивПоВиду = Новый Массив;
			ПоВидам.Вставить(СтрокаОтбора.ИмяТипа, МассивПоВиду);
		КонецЕсли;
		МассивПоВиду.Добавить(СтрокаОтбора.Документ);
	КонецЦикла;

	Если ПоВидам.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	КИсключению = Новый Соответствие;

	Для Каждого КлючЗначение Из ПоВидам Цикл

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ Док.Ссылка КАК Документ
			|ИЗ Документ." + КлючЗначение.Ключ + " КАК Док
			|ГДЕ Док.Ссылка В (&МассивСсылок)
			|	И Док.Дата >= &ГраницаОстатков";
		Запрос.УстановитьПараметр("МассивСсылок", КлючЗначение.Значение);
		Запрос.УстановитьПараметр("ГраницаОстатков", ГраницаОстатков);

		Попытка
			ВыборкаОстатков = Запрос.Выполнить().Выбрать();
		Исключение
			Сообщить("Не удалось отсечь новые остатки по виду """
				+ КлючЗначение.Ключ + """: " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Пока ВыборкаОстатков.Следующий() Цикл
			КИсключению.Вставить(ВыборкаОстатков.Документ, Истина);
		КонецЦикла;

	КонецЦикла;

	Если КИсключению.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Индекс = ТаблицаОтбора.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если КИсключению.Получить(ТаблицаОтбора[Индекс].Документ) <> Неопределено Тогда
			ТаблицаОтбора.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

// Пересчитывает итоговые показатели прогресса в шапке.
//
Процедура ПересчитатьИтоги()

	ВсегоВСнимке = 0;
	ВсегоПомечено = 0;

	Для Каждого СтрокаВида Из ТаблицаВидов Цикл
		ВсегоВСнимке = ВсегоВСнимке + СтрокаВида.Всего;
		ВсегоПомечено = ВсегоПомечено + СтрокаВида.Помечено;
	КонецЦикла;

	ВсегоОсталось = ВсегоВСнимке - ВсегоПомечено;
	ПроцентВыполнения = ?(ВсегоВСнимке = 0, 0, Окр(ВсегоПомечено * 100 / ВсегоВСнимке, 1));
	СостояниеВыполнения = ТекстПрогресса(ВсегоВСнимке, ВсегоПомечено, ВсегоОсталось, ПроцентВыполнения);

КонецПроцедуры

// Собирает текстовый индикатор прогресса.
//
// Вынесен в модуль объекта, чтобы обработка была самодостаточной: при вызове
// без формы (COM, тесты) СостояниеВыполнения тоже заполняется.
//
// Параметры:
//  ВсегоДокументов, ПомеченоДокументов, ОсталосьДокументов, ПроцентГотовности - Число
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстПрогресса(ВсегоДокументов, ПомеченоДокументов, ОсталосьДокументов, ПроцентГотовности) Экспорт

	ДлинаИндикатора = 25;
	ЗаполненныхБлоков = ?(ВсегоДокументов = 0, 0,
		Цел(ПомеченоДокументов * ДлинаИндикатора / ВсегоДокументов));

	Индикатор = "";
	Для Сч = 1 По ДлинаИндикатора Цикл
		Индикатор = Индикатор + ?(Сч <= ЗаполненныхБлоков, "█", "░");
	КонецЦикла;

	// ЧН=0 обязателен: без него 1С рисует ноль пустой строкой
	Возврат Индикатор + "  " + Формат(ПроцентГотовности, "ЧДЦ=1; ЧН=0") + "%"
		+ "   ·   помечено " + Формат(ПомеченоДокументов, "ЧГ=3,0; ЧРГ=' '; ЧН=0")
		+ " из " + Формат(ВсегоДокументов, "ЧГ=3,0; ЧРГ=' '; ЧН=0")
		+ "   ·   осталось " + Формат(ОсталосьДокументов, "ЧГ=3,0; ЧРГ=' '; ЧН=0");

КонецФункции

// Ключ хранения снимка — привязан к периоду.
//
Функция КлючСнимка()

	Возврат "Снимок_" + Формат(НачалоПериода, "ДФ=yyyyMMdd")
		+ "_" + Формат(ОкончаниеПериода, "ДФ=yyyyMMdd");

КонецФункции

// Сохраняет снимок в хранилище общих настроек (конфигурация не меняется).
//
Процедура СохранитьСнимок()

	Попытка
		ХранилищеОбщихНастроек.Сохранить(
			"А_ПометкаНаУдалениеДокументов", КлючСнимка(), Снимок.Выгрузить());
	Исключение
		Сообщить("Не удалось сохранить снимок: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Загружает ранее сохранённый снимок.
//
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено
//
Функция ЗагрузитьСнимок()

	Попытка
		Возврат ХранилищеОбщихНастроек.Загрузить(
			"А_ПометкаНаУдалениеДокументов", КлючСнимка());
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти
