// ===========================================================================
// Форма обработки "Пометка на удаление документов за период"
// ===========================================================================
// Фаза 2 выполняется ПОРЦИЯМИ через обработчик ожидания: форма
// перерисовывается между порциями, поэтому прогресс виден вживую,
// а процесс можно остановить в любой момент.
//
// Фоновое задание не используется намеренно: ДлительныеОперации требует
// экспортную процедуру ОБЩЕГО МОДУЛЯ, которой у внешней обработки нет.
// Перезапуск безопасен — снимок хранится и прогресс накапливается.
// ===========================================================================

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) Тогда
		Объект.НачалоПериода = Дата(2025, 12, 1);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		Объект.ОкончаниеПериода = Дата(2026, 6, 30);
	КонецЕсли;

	// ДатаНовыхОстатков по умолчанию ПУСТАЯ — удаляется всё, включая старые
	// документы ввода остатков 2025 года (решение пользователя 11.09.2026).
	//
	// Заполнять её нужно только в одном случае: если остатки на новую границу
	// УЖЕ перенесены обработками "Перенос остатков*" из бухгалтерии и казны.
	// Те датируют документы КонецДня(ДатаОстатков) — то есть 30.06.2026 23:59:59,
	// это ВНУТРИ периода удаления, и без границы они будут уничтожены.

	РазмерПорции = 20;
	ВыполняетсяОбработка = Ложь;
	ОстановитьЗапрошено = Ложь;

	// Если снимок за этот период уже сохранён — сразу показываем прогресс
	ОбновитьСтатусНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьКоманда(Команда)

	Если ВыполняетсяОбработка Тогда
		ПоказатьПредупреждение(, "Идёт пометка. Сначала остановите обработку.");
		Возврат;
	КонецЕсли;

	ЗаполнитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусКоманда(Команда)

	ОбновитьСтатусНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеКоманда(Команда)

	УстановитьОтметки(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеКоманда(Команда)

	УстановитьОтметки(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПометитьНаУдалениеКоманда(Команда)

	Если ВыполняетсяОбработка Тогда
		Возврат;
	КонецЕсли;

	КОбработке = 0;
	Для Каждого СтрокаВида Из Объект.ТаблицаВидов Цикл
		Если СтрокаВида.Пометить И НЕ СтрокаВида.Защищен Тогда
			КОбработке = КОбработке + СтрокаВида.Осталось;
		КонецЕсли;
	КонецЦикла;

	Если КОбработке = 0 Тогда
		ПоказатьПредупреждение(, "Не отмечено ни одного вида документов, либо всё уже помечено.");
		Возврат;
	КонецЕсли;

	ТекстВопроса = "Будет снято проведение и поставлена пометка на удаление: "
		+ Формат(КОбработке, "ЧГ=3,0; ЧРГ=' '; ЧН=0") + " документов."
		+ Символы.ПС + Символы.ПС
		+ "Движения этих документов в балансе и ПнЛ будут уничтожены."
		+ Символы.ПС + "Продолжить?";

	ПоказатьВопрос(Новый ОписаниеОповещения("ПометитьНаУдалениеЗавершение", ЭтотОбъект),
		ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьКоманда(Команда)

	ОстановитьЗапрошено = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТаблицаВидовПриАктивизацииСтроки(Элемент)

	Если ВыполняетсяОбработка Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элементы.ТаблицаВидов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьДокументыНаСервере(ТекущиеДанные.ИмяТипа);

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовВыборСтроки(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ТекущиеДанные = Элементы.ТаблицаДокументов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Документ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПометитьНаУдалениеЗавершение(Ответ, ДопПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ВыполняетсяОбработка = Истина;
	ОстановитьЗапрошено = Ложь;
	ПротоколОшибок = "";
	ОбработаноЗаСеанс = 0;
	ВремяСтарта = ТекущаяДата();

	Элементы.КнопкаОстановить.Доступность = Истина;
	Элементы.КнопкаПометить.Доступность = Ложь;
	Элементы.КнопкаЗаполнить.Доступность = Ложь;

	ПодключитьОбработчикОжидания("ОбработатьОчереднуюПорцию", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОчереднуюПорцию()

	Если ОстановитьЗапрошено Тогда
		ЗавершитьОбработку("Остановлено пользователем.");
		Возврат;
	КонецЕсли;

	РезультатПорции = ОбработатьПорциюНаСервере();

	ОбработаноЗаСеанс = ОбработаноЗаСеанс + РезультатПорции.Помечено;

	Если НЕ ПустаяСтрока(РезультатПорции.Протокол) Тогда
		ПротоколОшибок = ПротоколОшибок + ?(ПустаяСтрока(ПротоколОшибок), "", Символы.ПС)
			+ РезультатПорции.Протокол;
	КонецЕсли;

	Если РезультатПорции.Завершено Тогда
		ЗавершитьОбработку("Готово.");
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("ОбработатьОчереднуюПорцию", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОбработку(Причина)

	ОтключитьОбработчикОжидания("ОбработатьОчереднуюПорцию");

	ВыполняетсяОбработка = Ложь;
	ОстановитьЗапрошено = Ложь;

	Элементы.КнопкаОстановить.Доступность = Ложь;
	Элементы.КнопкаПометить.Доступность = Истина;
	Элементы.КнопкаЗаполнить.Доступность = Истина;

	ОбновитьСтатусНаСервере();

	ПоказатьПредупреждение(, Причина + " Обработано за сеанс: "
		+ Формат(ОбработаноЗаСеанс, "ЧГ=3,0; ЧРГ=' '; ЧН=0") + " документов.");

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметки(Значение)

	Для Каждого СтрокаВида Из Объект.ТаблицаВидов Цикл
		Если НЕ СтрокаВида.Защищен Тогда
			СтрокаВида.Пометить = Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ИтогЗаполнения = ОбработкаОбъект.ЗаполнитьСнимокИСтатус();
	// Сначала переносим данные в форму, и только потом считаем прогресс:
	// иначе ОбновитьТекстПрогресса читал бы ещё пустую таблицу формы.
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	ОбновитьТекстПрогресса();

	Сообщить(ИтогЗаполнения);

КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ОбновитьСтатус();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	ОбновитьТекстПрогресса();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументыНаСервере(ИмяВидаДокумента)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ЗаполнитьТаблицуДокументов(ИмяВидаДокумента);
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");

КонецПроцедуры

// Обрабатывает одну порцию документов первого отмеченного вида.
//
// Возвращаемое значение:
//  Структура - Завершено, Помечено, Ошибок, Протокол
//
&НаСервере
Функция ОбработатьПорциюНаСервере()

	Результат = Новый Структура("Завершено, Помечено, Ошибок, Пропущено, Протокол",
		Истина, 0, 0, 0, "");

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	// Служебные виды (РегистраторРасчетов) обрабатываем ПОСЛЕДНИМИ: механизм
	// взаиморасчётов может пересоздать их при снятии проведения с документов-
	// источников, и пометка, поставленная раньше, пропала бы впустую.
	СлужебныеВиды = Новый Соответствие;
	Для Каждого ИмяСлужебного Из ОбработкаОбъект.ВидыВключаемыеПоДате() Цикл
		СлужебныеВиды.Вставить(ИмяСлужебного, Истина);
	КонецЦикла;

	ИндексСтроки = -1;
	ИндексСлужебной = -1;

	Для Сч = 0 По Объект.ТаблицаВидов.Количество() - 1 Цикл
		СтрокаВида = Объект.ТаблицаВидов[Сч];
		Если НЕ (СтрокаВида.Пометить И НЕ СтрокаВида.Защищен И СтрокаВида.Осталось > 0) Тогда
			Продолжить;
		КонецЕсли;
		Если СлужебныеВиды.Получить(СтрокаВида.ИмяТипа) <> Неопределено Тогда
			Если ИндексСлужебной < 0 Тогда
				ИндексСлужебной = Сч;
			КонецЕсли;
		Иначе
			ИндексСтроки = Сч;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ИндексСтроки < 0 Тогда
		ИндексСтроки = ИндексСлужебной;
	КонецЕсли;

	Если ИндексСтроки < 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Завершено = Ложь;
	СтрокаОбработки = Объект.ТаблицаВидов[ИндексСтроки];

	РазмерТекущейПорции = ?(РазмерПорции > 0, РазмерПорции, 20);
	МассивПорции = ОбработкаОбъект.ПолучитьПорциюДляПометки(
		СтрокаОбработки.ИмяТипа, РазмерТекущейПорции);

	Если МассивПорции.Количество() = 0 Тогда
		// Вид исчерпан: документов с движениями больше нет
		СтрокаОбработки.Помечено = СтрокаОбработки.Всего;
		СтрокаОбработки.Осталось = 0;
		СтрокаОбработки.Процент = 100;
		ОбновитьТекстПрогресса();
		Возврат Результат;
	КонецЕсли;

	ИтогПометки = ОбработкаОбъект.ПометитьПорцию(МассивПорции);

	Результат.Помечено = ИтогПометки.Помечено;
	Результат.Ошибок = ИтогПометки.Ошибок;
	Результат.Протокол = ИтогПометки.Протокол;

	Если ИтогПометки.Помечено = 0 Тогда
		// Ни один документ не помечен — вид закрываем, иначе цикл станет
		// бесконечным: битые ссылки из регистров не исчезают никогда.
		СтрокаОбработки.Осталось = 0;

		Если ИтогПометки.Пропущено > 0 И ИтогПометки.Ошибок = 0 Тогда
			ПричинаОстановки = """ остановлен: остались только битые ссылки ("
				+ Формат(ИтогПометки.Пропущено, "ЧГ=0; ЧН=0")
				+ " шт.) — движения в регистрах есть, документов уже нет.";
		Иначе
			ПричинаОстановки = """ пропущен: вся порция завершилась ошибкой.";
		КонецЕсли;

		Результат.Протокол = Результат.Протокол + ?(ПустаяСтрока(Результат.Протокол), "", Символы.ПС)
			+ "Вид """ + СтрокаОбработки.ПредставлениеТипа + ПричинаОстановки;
	Иначе
		СтрокаОбработки.Помечено = СтрокаОбработки.Помечено + ИтогПометки.Помечено;
		ОстатокПоВиду = СтрокаОбработки.Всего - СтрокаОбработки.Помечено;
		СтрокаОбработки.Осталось = ?(ОстатокПоВиду < 0, 0, ОстатокПоВиду);
		СтрокаОбработки.Процент = ?(СтрокаОбработки.Всего = 0, 0,
			Окр(СтрокаОбработки.Помечено * 100 / СтрокаОбработки.Всего, 1));
	КонецЕсли;

	ОбновитьТекстПрогресса();

	Возврат Результат;

КонецФункции

// Пересчитывает итоги шапки и собирает текстовый индикатор прогресса.
//
&НаСервере
Процедура ОбновитьТекстПрогресса()

	ВсегоДокументов = 0;
	ПомеченоДокументов = 0;

	Для Каждого СтрокаВида Из Объект.ТаблицаВидов Цикл
		ВсегоДокументов = ВсегоДокументов + СтрокаВида.Всего;
		ПомеченоДокументов = ПомеченоДокументов + СтрокаВида.Помечено;
	КонецЦикла;

	ОсталосьДокументов = ВсегоДокументов - ПомеченоДокументов;
	ПроцентГотовности = ?(ВсегоДокументов = 0, 0,
		Окр(ПомеченоДокументов * 100 / ВсегоДокументов, 1));

	ДлинаИндикатора = 25;
	ЗаполненныхБлоков = ?(ВсегоДокументов = 0, 0,
		Цел(ПомеченоДокументов * ДлинаИндикатора / ВсегоДокументов));

	Индикатор = "";
	Для Сч = 1 По ДлинаИндикатора Цикл
		Индикатор = Индикатор + ?(Сч <= ЗаполненныхБлоков, "█", "░");
	КонецЦикла;

	ТекстСостояния = Индикатор + "  " + Формат(ПроцентГотовности, "ЧДЦ=1; ЧН=0") + "%"
		+ "   ·   помечено " + Формат(ПомеченоДокументов, "ЧГ=3,0; ЧРГ=' '; ЧН=0")
		+ " из " + Формат(ВсегоДокументов, "ЧГ=3,0; ЧРГ=' '; ЧН=0")
		+ "   ·   осталось " + Формат(ОсталосьДокументов, "ЧГ=3,0; ЧРГ=' '; ЧН=0");

	Объект.ВсегоВСнимке = ВсегоДокументов;
	Объект.ВсегоПомечено = ПомеченоДокументов;
	Объект.ВсегоОсталось = ОсталосьДокументов;
	Объект.ПроцентВыполнения = ПроцентГотовности;
	Объект.СостояниеВыполнения = ТекстСостояния;

КонецПроцедуры

#КонецОбласти
