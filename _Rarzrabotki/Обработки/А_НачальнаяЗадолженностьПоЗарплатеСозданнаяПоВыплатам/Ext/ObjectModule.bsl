// А_НачальнаяЗадолженностьПоЗарплатеСозданнаяПоВыплатам
//
// Назначение: выровнять остатки ЗарплатаКВыплате (и А_ВзСС) с базой ЗУП по выплатам
// за месяц остатков (ноябрь 2025), проведённым в следующем месяце (декабрь 2025).
// Ведомости ВКассу с МесяцВыплаты = МесяцОстатков списали ЗКВ Периодом = МесяцОстатков,
// а входящего остатка под них не было -> остатки ушли в минус.
//
// Механика (3 шага):
//   1. ЗаполнитьВедомости() — отбор ведомостей (Дата в МесяцеВедомостей, ПериодРегистрации = МесяцОстатков).
//   2. СформироватьПревью() — строки ТЧ Зарплата отмеченных ведомостей + остаток ЗКВ по ключу
//      аналитики (ФЛ, Сотрудник, Подразделение, ПериодВзаиморасчетов, ГруппаУчета) на конец
//      МесяцаОстатков БЕЗ движений документа-цели; СуммаКЗаполнению = последовательное покрытие
//      дефицита МИН(СуммаПоВедомостям, МАКС(0, -Остаток)).
//   3. ЗаполнитьДокумент() — перезапись ТЧ документа-цели НачальнаяЗадолженностьПоЗарплате:
//      Сотрудник/Подразделение/ГруппаУчета из ведомостей, Сумма = СуммаКЗаполнению,
//      ФормаPL = Форма2 (проверено данными: РКО этих ведомостей списали А_ВзСС только Форма2,
//      ОргБух пусто — diag_rko_formapl_vedomosti.py), Месяц шапки = МесяцОстатков
//      (даёт ЗКВ приход с Период/ПериодВзаиморасчетов = МесяцОстатков — закрытие по аналитике).
//
// Тест запросов: _Rarzrabotki/Python/test/test_nachzad_po_vyplatam_pretest.py (Rule #-1).
// Грабли: алиас "В" в запросах зарезервирован -> "Вед".

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Шаг 1. Отбор ведомостей ВКассу: Дата в месяце ведомостей, МесяцВыплаты = месяц остатков.
Процедура ЗаполнитьВедомости() Экспорт

	Если НЕ ЗначениеЗаполнено(МесяцОстатков) ИЛИ НЕ ЗначениеЗаполнено(МесяцВедомостей) Тогда
		ВызватьИсключение "Заполните Месяц остатков и Месяц ведомостей.";
	КонецЕсли;

	Ведомости.Очистить();
	Превью.Очистить();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоВедомостей", НачалоМесяца(МесяцВедомостей));
	Запрос.УстановитьПараметр("КонецВедомостей", КонецМесяца(МесяцВедомостей));
	Запрос.УстановитьПараметр("МесяцОст", НачалоМесяца(МесяцОстатков));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Вед.Ссылка КАК Ведомость,
	|	Вед.Дата КАК Дата,
	|	Вед.СуммаПоДокументу КАК СуммаПоДокументу
	|ИЗ
	|	Документ.ВедомостьНаВыплатуЗарплатыВКассу КАК Вед
	|ГДЕ
	|	Вед.Дата МЕЖДУ &НачалоВедомостей И &КонецВедомостей
	|	И Вед.ПериодРегистрации = &МесяцОст
	|	И Вед.Проведен
	|УПОРЯДОЧИТЬ ПО
	|	Вед.Дата,
	|	Вед.Ссылка
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	З.Ссылка КАК Ведомость,
	|	КОЛИЧЕСТВО(*) КАК КоличествоСтрок
	|ИЗ
	|	Документ.ВедомостьНаВыплатуЗарплатыВКассу.Зарплата КАК З
	|ГДЕ
	|	З.Ссылка.Дата МЕЖДУ &НачалоВедомостей И &КонецВедомостей
	|	И З.Ссылка.ПериодРегистрации = &МесяцОст
	|	И З.Ссылка.Проведен
	|СГРУППИРОВАТЬ ПО
	|	З.Ссылка";

	Результаты = Запрос.ВыполнитьПакет();

	КолСтрокПоВедомости = Новый Соответствие;
	ВыборкаКол = Результаты[1].Выбрать();
	Пока ВыборкаКол.Следующий() Цикл
		КолСтрокПоВедомости.Вставить(ВыборкаКол.Ведомость, ВыборкаКол.КоличествоСтрок);
	КонецЦикла;

	ВыборкаВед = Результаты[0].Выбрать();
	Пока ВыборкаВед.Следующий() Цикл
		НоваяСтрока = Ведомости.Добавить();
		НоваяСтрока.Выбрать = Истина;
		НоваяСтрока.Ведомость = ВыборкаВед.Ведомость;
		НоваяСтрока.Дата = ВыборкаВед.Дата;
		НоваяСтрока.СуммаПоДокументу = ВыборкаВед.СуммаПоДокументу;
		КолСтрок = КолСтрокПоВедомости.Получить(ВыборкаВед.Ведомость);
		НоваяСтрока.КоличествоСтрок = ?(КолСтрок = Неопределено, 0, КолСтрок);
	КонецЦикла;

	Сообщить("Найдено ведомостей: " + Ведомости.Количество());

КонецПроцедуры

// Шаг 2. Превью строк документа: строки ведомостей + остаток ЗКВ по ключу + сумма к заполнению.
Процедура СформироватьПревью() Экспорт

	Превью.Очистить();

	МассивВедомостей = Новый Массив;
	Для Каждого СтрВ Из Ведомости Цикл
		Если СтрВ.Выбрать И ЗначениеЗаполнено(СтрВ.Ведомость) Тогда
			МассивВедомостей.Добавить(СтрВ.Ведомость);
		КонецЕсли;
	КонецЦикла;
	Если МассивВедомостей.Количество() = 0 Тогда
		ВызватьИсключение "Не отмечена ни одна ведомость (шаг 1 — Заполнить ведомости).";
	КонецЕсли;

	// 2.1 Строки ТЧ Зарплата по отмеченным ведомостям
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивВедомостей", МассивВедомостей);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	З.Ссылка КАК Ведомость,
	|	З.Сотрудник КАК Сотрудник,
	|	З.ФизическоеЛицо КАК ФизическоеЛицо,
	|	З.Подразделение КАК Подразделение,
	|	З.ПериодВзаиморасчетов КАК ПериодВзаиморасчетов,
	|	З.ГруппаУчетаНачислений КАК ГруппаУчетаНачислений,
	|	СУММА(З.КВыплате) КАК СуммаПоВедомостям
	|ИЗ
	|	Документ.ВедомостьНаВыплатуЗарплатыВКассу.Зарплата КАК З
	|ГДЕ
	|	З.Ссылка В (&МассивВедомостей)
	|СГРУППИРОВАТЬ ПО
	|	З.Ссылка,
	|	З.Сотрудник,
	|	З.ФизическоеЛицо,
	|	З.Подразделение,
	|	З.ПериодВзаиморасчетов,
	|	З.ГруппаУчетаНачислений
	|УПОРЯДОЧИТЬ ПО
	|	Ведомость,
	|	Сотрудник";
	ТаблицаСтрок = Запрос.Выполнить().Выгрузить();

	МассивФЛ = Новый Массив;
	СоответствиеФЛ = Новый Соответствие;
	Для Каждого СтрТ Из ТаблицаСтрок Цикл
		Если СоответствиеФЛ.Получить(СтрТ.ФизическоеЛицо) = Неопределено Тогда
			СоответствиеФЛ.Вставить(СтрТ.ФизическоеЛицо, Истина);
			МассивФЛ.Добавить(СтрТ.ФизическоеЛицо);
		КонецЕсли;
	КонецЦикла;

	// 2.2 Остатки ЗКВ на конец месяца остатков по ключу аналитики, БЕЗ движений документа-цели
	ДокЦель = ?(ЗначениеЗаполнено(ДокументЦель), ДокументЦель,
		Документы.НачальнаяЗадолженностьПоЗарплате.ПустаяСсылка());
	ЗапросОст = Новый Запрос;
	ЗапросОст.УстановитьПараметр("ГраницаОстатков", КонецМесяца(МесяцОстатков));
	ЗапросОст.УстановитьПараметр("ДокЦель", ДокЦель);
	ЗапросОст.УстановитьПараметр("МассивФЛ", МассивФЛ);
	ЗапросОст.Текст =
	"ВЫБРАТЬ
	|	Д.ФизическоеЛицо КАК ФизическоеЛицо,
	|	Д.Сотрудник КАК Сотрудник,
	|	Д.Подразделение КАК Подразделение,
	|	Д.ПериодВзаиморасчетов КАК ПериодВзаиморасчетов,
	|	Д.ГруппаУчетаНачислений КАК ГруппаУчетаНачислений,
	|	СУММА(ВЫБОР
	|			КОГДА Д.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Д.СуммаКВыплате
	|			ИНАЧЕ -Д.СуммаКВыплате
	|		КОНЕЦ) КАК Остаток
	|ИЗ
	|	РегистрНакопления.ЗарплатаКВыплате КАК Д
	|ГДЕ
	|	Д.Период <= &ГраницаОстатков
	|	И Д.Регистратор <> &ДокЦель
	|	И Д.ФизическоеЛицо В (&МассивФЛ)
	|СГРУППИРОВАТЬ ПО
	|	Д.ФизическоеЛицо,
	|	Д.Сотрудник,
	|	Д.Подразделение,
	|	Д.ПериодВзаиморасчетов,
	|	Д.ГруппаУчетаНачислений";
	ТаблицаОстатков = ЗапросОст.Выполнить().Выгрузить();

	ОстатокПоКлючу = Новый Соответствие;
	Для Каждого СтрО Из ТаблицаОстатков Цикл
		Ключ = КлючАналитики(СтрО.ФизическоеЛицо, СтрО.Сотрудник, СтрО.Подразделение,
			СтрО.ПериодВзаиморасчетов, СтрО.ГруппаУчетаНачислений);
		Существующий = ОстатокПоКлючу.Получить(Ключ);
		ОстатокПоКлючу.Вставить(Ключ, ?(Существующий = Неопределено, 0, Существующий) + СтрО.Остаток);
	КонецЦикла;

	// 2.3 Последовательное покрытие дефицита по ключу
	Для Каждого СтрТ Из ТаблицаСтрок Цикл
		Ключ = КлючАналитики(СтрТ.ФизическоеЛицо, СтрТ.Сотрудник, СтрТ.Подразделение,
			СтрТ.ПериодВзаиморасчетов, СтрТ.ГруппаУчетаНачислений);
		Остаток = ОстатокПоКлючу.Получить(Ключ);
		Остаток = ?(Остаток = Неопределено, 0, Остаток);
		Дефицит = Макс(0, -Остаток);
		СуммаКЗаполнению = Мин(СтрТ.СуммаПоВедомостям, Дефицит);
		ОстатокПоКлючу.Вставить(Ключ, Остаток + СуммаКЗаполнению);

		НоваяСтрока = Превью.Добавить();
		НоваяСтрока.Ведомость = СтрТ.Ведомость;
		НоваяСтрока.Сотрудник = СтрТ.Сотрудник;
		НоваяСтрока.ФизическоеЛицо = СтрТ.ФизическоеЛицо;
		НоваяСтрока.Подразделение = СтрТ.Подразделение;
		НоваяСтрока.ПериодВзаиморасчетов = СтрТ.ПериодВзаиморасчетов;
		НоваяСтрока.ГруппаУчетаНачислений = СтрТ.ГруппаУчетаНачислений;
		НоваяСтрока.СуммаПоВедомостям = СтрТ.СуммаПоВедомостям;
		НоваяСтрока.ОстатокЗКВ = Остаток;
		НоваяСтрока.СуммаКЗаполнению = СуммаКЗаполнению;
		Если СуммаКЗаполнению = 0 Тогда
			НоваяСтрока.Статус = "Покрыто остатком";
		ИначеЕсли СуммаКЗаполнению < СтрТ.СуммаПоВедомостям Тогда
			НоваяСтрока.Статус = "Частично";
		Иначе
			НоваяСтрока.Статус = "OK";
		КонецЕсли;
		Если СтрТ.ПериодВзаиморасчетов <> НачалоМесяца(МесяцОстатков) Тогда
			НоваяСтрока.Статус = "ПерВзаим <> месяц остатков";
			НоваяСтрока.СуммаКЗаполнению = 0;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Превью: строк " + Превью.Количество()
		+ ", Σ к заполнению = " + Формат(Превью.Итог("СуммаКЗаполнению"), "ЧДЦ=2"));

КонецПроцедуры

// Шаг 3. Перезапись ТЧ документа-цели и проведение (паттерн А_НачальнаяЗадолженностьПоЗарплатеФорма2).
Процедура ЗаполнитьДокумент() Экспорт

	Если НЕ ЗначениеЗаполнено(ДокументЦель) Тогда
		ВызватьИсключение "Не выбран документ-цель НачальнаяЗадолженностьПоЗарплате.";
	КонецЕсли;
	Если Превью.Количество() = 0 Тогда
		ВызватьИсключение "Превью пусто — выполните шаги 1 и 2.";
	КонецЕсли;

	ДокОбъект = ДокументЦель.ПолучитьОбъект();
	Если ДокОбъект.Проведен Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ДокОбъект = ДокументЦель.ПолучитьОбъект();
	КонецЕсли;

	ДокОбъект.Месяц = НачалоМесяца(МесяцОстатков);
	ДокОбъект.ЗадолженностьПоЗарплате.Очистить();

	Добавлено = 0;
	Для Каждого СтрП Из Превью Цикл
		Если СтрП.СуммаКЗаполнению = 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ДокОбъект.ЗадолженностьПоЗарплате.Добавить();
		НоваяСтрока.Сотрудник             = СтрП.Сотрудник;
		НоваяСтрока.Подразделение         = СтрП.Подразделение;
		НоваяСтрока.Сумма                 = СтрП.СуммаКЗаполнению;
		НоваяСтрока.ГруппаУчетаНачислений = СтрП.ГруппаУчетаНачислений;
		НоваяСтрока.ФормаPL               = Перечисления.А_ФормыPL.Форма2;
		// ОрганизацияБухгалтерия НЕ заполняем: РКО этих ведомостей списали Форма2 без ОргБух
		Добавлено = Добавлено + 1;
	КонецЦикла;

	Если Добавлено = 0 Тогда
		ВызватьИсключение "Нет строк с суммой к заполнению — документ не изменён.";
	КонецЕсли;

	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Сообщить("Документ " + Строка(ДокОбъект.Ссылка) + " перезаписан и проведён, строк: " + Добавлено
			+ ", Σ = " + Формат(Превью.Итог("СуммаКЗаполнению"), "ЧДЦ=2")
			+ ", Месяц = " + Формат(ДокОбъект.Месяц, "ДФ=ММММ гггг"));
	Исключение
		Сообщить("Ошибка проведения документа: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строковый ключ аналитики ЗКВ (UUID-представления ссылок устойчивы и уникальны).
Функция КлючАналитики(ФЛ, Сотр, Подр, ПерВзаим, ГУН)

	Возврат XMLСтрока(ФЛ) + "|" + XMLСтрока(Сотр) + "|" + XMLСтрока(Подр)
		+ "|" + XMLСтрока(ПерВзаим) + "|" + XMLСтрока(ГУН);

КонецФункции

#КонецОбласти

#КонецЕсли
