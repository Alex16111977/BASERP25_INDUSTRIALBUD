
&НаКлиенте
Процедура ЗаполнитьВедомости(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.МесяцОстатков) ИЛИ НЕ ЗначениеЗаполнено(Объект.МесяцВедомостей) Тогда
		ПоказатьПредупреждение(, "Заполните «Месяц остатков» и «Месяц ведомостей».");
		Возврат;
	КонецЕсли;

	ЗаполнитьВедомостиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВедомостиНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ОбъектОбработки.ЗаполнитьВедомости();
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");

КонецПроцедуры

&НаКлиенте
Процедура СформироватьПревью(Команда)

	Если Объект.Ведомости.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Сначала нажмите «1. Заполнить ведомости».");
		Возврат;
	КонецЕсли;

	СформироватьПревьюНаСервере();

КонецПроцедуры

&НаСервере
Процедура СформироватьПревьюНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ОбъектОбработки.СформироватьПревью();
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.ДокументЦель) Тогда
		ПоказатьПредупреждение(, "Выберите документ «Начальная задолженность по зарплате» (цель).");
		Возврат;
	КонецЕсли;
	Если Объект.Превью.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Сначала нажмите «2. Сформировать превью».");
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьДокументЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения,
		"ТЧ документа-цели будет ОЧИЩЕНА и заполнена строками превью (Месяц = месяц остатков), документ проведён. Продолжить?",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокументЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДокументНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ОбъектОбработки.ЗаполнитьДокумент();
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// По умолчанию: остатки — ноябрь 2025, ведомости — декабрь 2025
	Если НЕ ЗначениеЗаполнено(Объект.МесяцОстатков) Тогда
		Объект.МесяцОстатков = Дата(2025, 11, 1);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.МесяцВедомостей) Тогда
		Объект.МесяцВедомостей = Дата(2025, 12, 1);
	КонецЕсли;

КонецПроцедуры
