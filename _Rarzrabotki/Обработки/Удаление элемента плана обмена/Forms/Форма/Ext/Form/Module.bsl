#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьУзлыНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьУзлы(Команда)

	ЗаполнитьУзлыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура УдалитьУзел(Команда)

	ТекущиеДанные = Элементы.Узлы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите узел в списке.'"));
		Возврат;
	КонецЕсли;

	ТекстВопроса = НСтр("ru = 'Узел будет удален НЕПОСРЕДСТВЕННО, без пометки удаления и без контроля ссылок.
		|Вместе с узлом удаляются его регистрации изменений.
		|
		|План обмена: %1
		|Код: [%2]  Наименование: [%3]
		|Этот узел: %4,  сообщений отправлено / принято: %5 / %6
		|
		|Удалить?'");
	ТекстВопроса = СтрШаблон(ТекстВопроса, ТекущиеДанные.СинонимПлана, ТекущиеДанные.Код, ТекущиеДанные.Наименование,
		?(ТекущиеДанные.ЭтотУзел, "ДА", "нет"), ТекущиеДанные.НомерОтправленного, ТекущиеДанные.НомерПринятого);

	ПараметрыУдаления = Новый Структура("ИмяПлана, УИД", ТекущиеДанные.ИмяПлана, ТекущиеДанные.УИД);
	Оповещение = Новый ОписаниеОповещения("УдалитьУзелЗавершение", ЭтотОбъект, ПараметрыУдаления);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УдалитьУзелЗавершение(РезультатВопроса, ПараметрыУдаления) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ОписаниеОшибки = УдалитьУзелНаСервере(ПараметрыУдаления.ИмяПлана, ПараметрыУдаления.УИД);
	Если ОписаниеОшибки = "" Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Узел удален'"), , ПараметрыУдаления.ИмяПлана);
	Иначе
		ПоказатьПредупреждение(, ОписаниеОшибки);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция УдалитьУзелНаСервере(ПланУзла, УИД)

	Результат = РеквизитФормыВЗначение("Объект").УдалитьУзелНепосредственно(ПланУзла, УИД);
	ЗаполнитьУзлыНаСервере();
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьУзлыНаСервере()

	ТаблицаУзлов = РеквизитФормыВЗначение("Объект").ВсеУзлыПлановОбмена();
	ЗначениеВДанныеФормы(ТаблицаУзлов, Узлы);

КонецПроцедуры

#КонецОбласти
