#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.ИмяПлана.РежимВыбораИзСписка = Истина;
	Для Каждого Элемент Из РеквизитФормыВЗначение("Объект").СписокПлановОбмена() Цикл
		Элементы.ИмяПлана.СписокВыбора.Добавить(Элемент.Значение, Элемент.Представление);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяПланаПриИзменении(Элемент)

	Если ИмяПлана <> "" Тогда
		ЗаполнитьУзлыНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьУзлы(Команда)

	Если ИмяПлана = "" Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите план обмена.'"));
		Возврат;
	КонецЕсли;
	ЗаполнитьУзлыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура УдалитьУзел(Команда)

	ТекущиеДанные = Элементы.Узлы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите узел в списке.'"));
		Возврат;
	КонецЕсли;

	ТекстВопроса = НСтр("ru = 'Узел будет удален НЕПОСРЕДСТВЕННО, без пометки удаления и без контроля ссылок.
		|Вместе с узлом удаляются его регистрации изменений.
		|
		|План обмена: %1
		|Код: [%2]  Наименование: [%3]
		|Этот узел: %4,  сообщений отправлено / принято: %5 / %6
		|
		|Удалить?'");
	ТекстВопроса = СтрШаблон(ТекстВопроса, ИмяПлана, ТекущиеДанные.Код, ТекущиеДанные.Наименование,
		?(ТекущиеДанные.ЭтотУзел, "ДА", "нет"), ТекущиеДанные.НомерОтправленного, ТекущиеДанные.НомерПринятого);

	Оповещение = Новый ОписаниеОповещения("УдалитьУзелЗавершение", ЭтотОбъект, ТекущиеДанные.УИД);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УдалитьУзелЗавершение(РезультатВопроса, УИД) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ОписаниеОшибки = УдалитьУзелНаСервере(УИД);
	Если ОписаниеОшибки = "" Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Узел удален'"), , ИмяПлана);
	Иначе
		ПоказатьПредупреждение(, ОписаниеОшибки);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция УдалитьУзелНаСервере(УИД)

	Результат = РеквизитФормыВЗначение("Объект").УдалитьУзелНепосредственно(ИмяПлана, УИД);
	ЗаполнитьУзлыНаСервере();
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьУзлыНаСервере()

	ТаблицаУзлов = РеквизитФормыВЗначение("Объект").УзлыПланаОбмена(ИмяПлана);
	ЗначениеВДанныеФормы(ТаблицаУзлов, Узлы);

КонецПроцедуры

#КонецОбласти
