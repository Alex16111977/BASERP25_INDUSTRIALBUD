// Удаление элемента плана обмена НЕПОСРЕДСТВЕННО (без пометки удаления).
//
// Зачем: пометка на удаление — это перезапись узла, и для узла-дубля с признаком «ЭтотУзел»
// платформа отказывает («Элемент с установленным признаком "ЭтотУзел" уже существует»).
// Непосредственное удаление с ОбменДанными.Загрузка = Истина обходит запись и позволяет
// убрать такой узел (типовая авария после восстановления базы из копии).

// Список планов обмена конфигурации: Значение = имя плана, Представление = синоним.
Функция СписокПлановОбмена() Экспорт

	Список = Новый СписокЗначений;
	Для Каждого План Из Метаданные.ПланыОбмена Цикл
		Список.Добавить(План.Имя, План.Синоним + " (" + План.Имя + ")");
	КонецЦикла;
	Возврат Список;

КонецФункции

// Таблица узлов плана: Код, Наименование, ЭтотУзел, ПометкаУдаления, НомерОтправленного, НомерПринятого, УИД.
Функция УзлыПланаОбмена(ИмяПлана) Экспорт

	Если Метаданные.ПланыОбмена.Найти(ИмяПлана) = Неопределено Тогда
		ВызватьИсключение "План обмена не найден: " + ИмяПлана;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Узлы.Ссылка КАК Ссылка,
	|	Узлы.Код КАК Код,
	|	Узлы.Наименование КАК Наименование,
	|	Узлы.ЭтотУзел КАК ЭтотУзел,
	|	Узлы.ПометкаУдаления КАК ПометкаУдаления,
	|	Узлы.НомерОтправленного КАК НомерОтправленного,
	|	Узлы.НомерПринятого КАК НомерПринятого
	|ИЗ
	|	ПланОбмена.PLAN_NAME КАК Узлы
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "PLAN_NAME", ИмяПлана);

	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Колонки.Добавить("УИД", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	Для Каждого Стр Из Результат Цикл
		Стр.УИД = Строка(Стр.Ссылка.УникальныйИдентификатор());
	КонецЦикла;
	Результат.Колонки.Удалить("Ссылка");
	Возврат Результат;

КонецФункции

// Узлы всех планов обмена одной таблицей (+ИмяПлана, +СинонимПлана).
Функция ВсеУзлыПлановОбмена() Экспорт

	Результат = Неопределено;
	Для Каждого План Из Метаданные.ПланыОбмена Цикл
		Таблица = УзлыПланаОбмена(План.Имя);
		Таблица.Колонки.Добавить("ИмяПлана", Новый ОписаниеТипов("Строка"));
		Таблица.Колонки.Добавить("СинонимПлана", Новый ОписаниеТипов("Строка"));
		Для Каждого Стр Из Таблица Цикл
			Стр.ИмяПлана = План.Имя;
			Стр.СинонимПлана = План.Синоним;
		КонецЦикла;
		Если Результат = Неопределено Тогда
			Результат = Таблица;
		Иначе
			Для Каждого Стр Из Таблица Цикл
				ЗаполнитьЗначенияСвойств(Результат.Добавить(), Стр);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Непосредственно удаляет узел. Возвращает "" при успехе, иначе текст ошибки.
Функция УдалитьУзелНепосредственно(ИмяПлана, УИДСтрока) Экспорт

	Если Метаданные.ПланыОбмена.Найти(ИмяПлана) = Неопределено Тогда
		Возврат "План обмена не найден: " + ИмяПлана;
	КонецЕсли;

	УИД = Новый УникальныйИдентификатор(УИДСтрока);
	УзелОбъект = Неопределено;
	Попытка
		УзелОбъект = ПланыОбмена[ИмяПлана].ПолучитьСсылку(УИД).ПолучитьОбъект();
	Исключение
		УзелОбъект = Неопределено; // пустая/битая ссылка
	КонецПопытки;
	Если УзелОбъект = Неопределено Тогда
		Возврат "Узел с идентификатором " + УИДСтрока + " не найден в плане обмена " + ИмяПлана + ".";
	КонецЕсли;

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		УзелОбъект.ОбменДанными.Загрузка = Истина;
		УзелОбъект.Удалить();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;

	Возврат "";

КонецФункции
