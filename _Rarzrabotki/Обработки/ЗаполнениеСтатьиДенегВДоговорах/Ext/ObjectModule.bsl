// Внешняя обработка: расшифровка платежей по статье ДДС с группировкой по
// договорам закупки + опциональная запись статьи в реквизит договора.
// Источник данных: РегистрНакопления.ДвиженияДенежныеСредстваКонтрагент.Обороты
// (тот же регистр, что использует отчёт А_БДДС).

#Область СведенияОВнешнейОбработке

Функция СведенияОВнешнейОбработке() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Вид", "ДополнительнаяОбработка");
	Параметры.Вставить("Версия", "1.0");
	Параметры.Вставить("БезопасныйРежим", Ложь);
	Параметры.Вставить("Информация",
		"Расшифровка платежей по статье ДДС: договоры закупки и документы за период.");
	Параметры.Вставить("Наименование",
		"Заполнение статьи денег в договорах по платежкам");

	ТаблицаКоманд = Новый ТаблицаЗначений;
	ТаблицаКоманд.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	ТаблицаКоманд.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = "Заполнение статьи денег в договорах по платежкам";
	НоваяКоманда.Идентификатор = "ЗаполнениеСтатьиДенегВДоговорахПоПлатежкам";
	НоваяКоманда.Использование = "ОткрытиеФормы";
	НоваяКоманда.ПоказыватьОповещение = Ложь;
	Параметры.Вставить("Команды", ТаблицаКоманд);
	
	Возврат Параметры;

КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает структуру с двумя ТЗ для заполнения формы.
//
// Параметры:
//   НачалоПериода       - Дата
//   ОкончаниеПериода    - Дата (день включается)
//   СтатьяДДС           - СправочникСсылка.СтатьиДвиженияДенежныхСредств
//
// Возвращаемое значение:
//   Структура с полями:
//     РасшифровкаДокументы - ТаблицаЗначений: Контрагент, Договор, Подразделение,
//                           ДокументДенежныхСредств, СуммаДокумента
//     Расшифровка         - ТаблицаЗначений: Контрагент, Договор, Подразделение, Сумма,
//                           А_СтатьяДвиженияДенежныхСредствОснавнаяПринудительно, Обработан
//
Функция ПолучитьРасшифровкуПлатежей(НачалоПериода, ОкончаниеПериода, СтатьяДДС) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода",    НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ОкончаниеПериода));
	Запрос.УстановитьПараметр("СтатьяДДС",        СтатьяДДС);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	РегДДС.Регистратор    КАК Регистратор,
	|	РегДДС.Контрагент     КАК Контрагент,
	|	ВЫРАЗИТЬ(РегДДС.Договор КАК Справочник.ДоговорыКонтрагентов) КАК Договор,
	|	РегДДС.Подразделение  КАК Подразделение,
	|	РегДДС.СуммаОплатыОборот КАК Сумма
	|ПОМЕСТИТЬ ВТ_Платежи
	|ИЗ
	|	РегистрНакопления.ДвиженияДенежныеСредстваКонтрагент.Обороты(
	|		&НачалоПериода,
	|		&ОкончаниеПериода,
	|		Регистратор,
	|		СтатьяДвиженияДенежныхСредств = &СтатьяДДС
	|			И ТИПЗНАЧЕНИЯ(Договор) = ТИП(Справочник.ДоговорыКонтрагентов)
	|			И ВЫРАЗИТЬ(Договор КАК Справочник.ДоговорыКонтрагентов).ТипДоговора
	|				= ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПоставщиком)
	|	) КАК РегДДС
	|ГДЕ
	|	РегДДС.СуммаОплатыОборот <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////
	|// Многоцелевые договоры: те же договоры, но с другими статьями ДДС
	|// в том же периоде (любой ТипДоговора, главное — другая статья).
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Н.Договор КАК Договор
	|ПОМЕСТИТЬ ВТ_МногоцелевыеДоговоры
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ П.Договор КАК Договор ИЗ ВТ_Платежи КАК П) КАК Н
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|			РегистрНакопления.ДвиженияДенежныеСредстваКонтрагент.Обороты(
	|				&НачалоПериода,
	|				&ОкончаниеПериода,
	|				,
	|				СтатьяДвиженияДенежныхСредств <> &СтатьяДДС
	|					И ТИПЗНАЧЕНИЯ(Договор) = ТИП(Справочник.ДоговорыКонтрагентов)
	|			) КАК РегДДС
	|		ПО Н.Договор = ВЫРАЗИТЬ(РегДДС.Договор КАК Справочник.ДоговорыКонтрагентов)
	|ГДЕ
	|	РегДДС.СуммаОплатыОборот <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////
	|// 1) Детализация — ВСЕ платежи договоров верхней свёртки за период
	|//    (по любой статье ДДС, чтобы финансист видел реальный микс).
	|ВЫБРАТЬ
	|	РегДДС.Контрагент    КАК Контрагент,
	|	ВЫРАЗИТЬ(РегДДС.Договор КАК Справочник.ДоговорыКонтрагентов) КАК Договор,
	|	РегДДС.Подразделение КАК Подразделение,
	|	РегДДС.Регистратор   КАК ДокументДенежныхСредств,
	|	РегДДС.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
	|	РегДДС.СуммаОплатыОборот КАК СуммаДокумента
	|ИЗ
	|	РегистрНакопления.ДвиженияДенежныеСредстваКонтрагент.Обороты(
	|		&НачалоПериода,
	|		&ОкончаниеПериода,
	|		Регистратор,
	|		ТИПЗНАЧЕНИЯ(Договор) = ТИП(Справочник.ДоговорыКонтрагентов)
	|			И ВЫРАЗИТЬ(Договор КАК Справочник.ДоговорыКонтрагентов) В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ П.Договор ИЗ ВТ_Платежи КАК П)
	|	) КАК РегДДС
	|ГДЕ
	|	РегДДС.СуммаОплатыОборот <> 0
	|УПОРЯДОЧИТЬ ПО
	|	Контрагент, Договор, ДокументДенежныхСредств
	|;
	|
	|////////////////////////////////////////////////////////////////////////
	|// 2) Свёртка по договорам с флагом «многоцелевой» — для ТЗ Расшифровка
	|ВЫБРАТЬ
	|	П.Контрагент    КАК Контрагент,
	|	П.Договор       КАК Договор,
	|	П.Договор.А_СтатьяДвиженияДенежныхСредствОснавнаяПринудительно
	|		КАК А_СтатьяДвиженияДенежныхСредствОснавнаяПринудительно,
	|	П.Подразделение КАК Подразделение,
	|	СУММА(П.Сумма)  КАК Сумма,
	|	МАКСИМУМ(ВЫБОР КОГДА М.Договор ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ)
	|		КАК ИспользоватьВДругихСтатьях
	|ИЗ
	|	ВТ_Платежи КАК П
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МногоцелевыеДоговоры КАК М
	|		ПО П.Договор = М.Договор
	|СГРУППИРОВАТЬ ПО
	|	П.Контрагент, П.Договор, П.Подразделение,
	|	П.Договор.А_СтатьяДвиженияДенежныхСредствОснавнаяПринудительно
	|УПОРЯДОЧИТЬ ПО
	|	Контрагент, Договор";

	Результаты = Запрос.ВыполнитьПакет();
	// [0] = ВТ_Платежи (ПОМЕСТИТЬ), [1] = ВТ_МногоцелевыеДоговоры (ПОМЕСТИТЬ),
	// [2] = детализация документов, [3] = свёртка по договорам.
	ТЗДокументы = Результаты[2].Выгрузить();
	ТЗДоговоры  = Результаты[3].Выгрузить();
	ТЗДоговоры.Колонки.Добавить("Обработан", Новый ОписаниеТипов("Булево"));

	// Авто-проставка флага «Обработан» для моноцелевых договоров (безопасных
	// для записи статьи). Многоцелевые остаются без галки — финансист решает.
	Для Каждого СтрокаДоговора Из ТЗДоговоры Цикл
		СтрокаДоговора.Обработан = НЕ СтрокаДоговора.ИспользоватьВДругихСтатьях;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("РасшифровкаДокументы", ТЗДокументы);
	Результат.Вставить("Расшифровка",          ТЗДоговоры);
	Возврат Результат;

КонецФункции

// Записывает в реквизит А_СтатьяДвиженияДенежныхСредствОснавнаяПринудительно
// у указанных договоров заданную статью ДДС. Возвращает структуру со счётчиками.
//
// Параметры:
//   МассивДоговоров - Массив СправочникСсылка.ДоговорыКонтрагентов
//   Статья          - СправочникСсылка.СтатьиДвиженияДенежныхСредств
//
// Возвращаемое значение:
//   Структура: Обновлено (Число), Пропущено (Число), Ошибки (Массив строк)
//
Функция ОбновитьСтатьюВДоговорах(МассивДоговоров, Статья) Экспорт

	Обновлено  = 0;
	Пропущено  = 0;
	Ошибки     = Новый Массив;

	Для Каждого ДоговорСсылка Из МассивДоговоров Цикл
		Если НЕ ЗначениеЗаполнено(ДоговорСсылка) Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Попытка
			ДоговорОбъект = ДоговорСсылка.ПолучитьОбъект();
			Если ДоговорОбъект = Неопределено Тогда
				Пропущено = Пропущено + 1;
				Продолжить;
			КонецЕсли;
			Если ДоговорОбъект.А_Необновлять Тогда
				Пропущено = Пропущено + 1;
				Продолжить;
			КонецЕсли;
			ДоговорОбъект.А_СтатьяДвиженияДенежныхСредствОснавнаяПринудительно = Статья;
			ДоговорОбъект.ОбменДанными.Загрузка = Истина;
			ДоговорОбъект.Записать();
			Обновлено = Обновлено + 1;
		Исключение
			Ошибки.Добавить(СтрШаблон("%1: %2", ДоговорСсылка, ОписаниеОшибки()));
		КонецПопытки;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Обновлено", Обновлено);
	Результат.Вставить("Пропущено", Пропущено);
	Результат.Вставить("Ошибки",    Ошибки);
	Возврат Результат;

КонецФункции

#КонецОбласти
