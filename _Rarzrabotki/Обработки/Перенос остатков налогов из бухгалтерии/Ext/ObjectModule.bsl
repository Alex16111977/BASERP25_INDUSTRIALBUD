#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Определение типа налога (Перечисление.ТипыНалогов) по коду счёта BuhBud
Функция _ТипНалогаПоСчету(КодСчета)
	Код = СокрЛП(КодСчета);
	Если      Код = "6411" Тогда Возврат Перечисления.ТипыНалогов.НДФЛ;
	ИначеЕсли Код = "642"  Тогда Возврат Перечисления.ТипыНалогов.ВоенныйСбор;
	ИначеЕсли Код = "651"  Тогда Возврат Перечисления.ТипыНалогов.НачисленныйЕСВ;
	ИначеЕсли Код = "6412" Тогда Возврат Перечисления.ТипыНалогов.НДС;
	ИначеЕсли Код = "6413" Тогда Возврат Перечисления.ТипыНалогов.НалогНаПрибыль;
	ИначеЕсли Код = "6414" Тогда Возврат Перечисления.ТипыНалогов.ЕдиныйНалог;
	Иначе                        Возврат Перечисления.ТипыНалогов.ДругиеНалоги;
	КонецЕсли;
КонецФункции

// Заполняет субконто проводки Хозрасчетного по фактическим видам субконто счёта.
// Если вид субконто счёта принимает тип Справочник.Налоги — подставляет элемент
// справочника Налоги по наименованию ВидНалогаНаим (как в типовых проводках 642/651/6415).
// Для счетов без субконто (6411/6412) и со «Статьями налоговых деклараций» (6413/6414)
// субконто остаётся пустым — проводка проводится корректно.
//
// КоллекцияСубконто - КоллекцияЗначенийСубконто (Движение.СубконтоДт или .СубконтоКт)
// Счет             - ПланСчетовСсылка.Хозрасчетный
// ВидНалогаНаим    - Строка - представление субконто из BuhBud
Процедура _ЗаполнитьСубконтоНалога(КоллекцияСубконто, Счет, ВидНалогаНаим)
	Если НЕ ЗначениеЗаполнено(Счет) Тогда
		Возврат;
	КонецЕсли;
	ТипСправочникНалоги = Тип("СправочникСсылка.Налоги");
	Для Каждого ВидСубконтоСтрока Из Счет.ВидыСубконто Цикл
		ВидСубконто = ВидСубконтоСтрока.ВидСубконто;
		Если ВидСубконто.ТипЗначения.СодержитТип(ТипСправочникНалоги)
			И НЕ ПустаяСтрока(ВидНалогаНаим) Тогда
			ЭлементНалога = Справочники.Налоги.НайтиПоНаименованию(СокрЛП(ВидНалогаНаим));
			Если ЗначениеЗаполнено(ЭлементНалога) Тогда
				КоллекцияСубконто.Вставить(ВидСубконто, ЭлементНалога);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Управленческая организация: ВСЕ управленческие движения (ПАП) консолидируются
// на неё, по какой бы бух.организации (А_ВБалансе) ни был заведён налог.
Функция А_ПолучитьОрганизациюУпр() Экспорт

	Возврат Справочники.Организации.НайтиПоРеквизиту("КодПоЕДРПОУ", "40645273"); //ТОВ "ІНДАСТРІАЛБУД"

КонецФункции

// Загружает сальдо налоговых счетов из BuhBud в табличную часть Налоги
Процедура ЗагрузитьОстатки() Экспорт

	Если НЕ ЗначениеЗаполнено(ОкончаниеПериода) Тогда
		ВызватьИсключение "Не указана дата остатков (ОкончаниеПериода)!";
	КонецЕсли;

	// ERP-side: ЕДРПОУ организаций «в балансе» (в BuhBud реквизита А_ВБалансе НЕТ)
	ЗапросОрг = Новый Запрос;
	ЗапросОрг.Текст =
	"ВЫБРАТЬ
	|	Орг.КодПоЕДРПОУ КАК ЕДРПОУ
	|ИЗ
	|	Справочник.Организации КАК Орг
	|ГДЕ
	|	Орг.А_ВБалансе
	|	И Орг.КодПоЕДРПОУ <> """"";
	СписокЕДРПОУ = ЗапросОрг.Выполнить().Выгрузить().ВыгрузитьКолонку("ЕДРПОУ");
	Если СписокЕДРПОУ.Количество() = 0 Тогда
		ВызватьИсключение "Нет организаций с признаком А_ВБалансе.";
	КонецЕсли;

	// Подключение к BuhBud
	СтрокаПодключения = А_ПодключенияБазСервер.СтрокаПодключения("BuhBud");
	V8 = Новый COMОбъект("V83.COMConnector");
	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключения));
	Исключение
		ВызватьИсключение "Ошибка подключения к BuhBud: " + ОписаниеОшибки();
	КонецПопытки;

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Ост.Организация.КодПоЕДРПОУ КАК ЕДРПОУ,
	|	Ост.Счет.Код КАК КодСчета,
	|	ПРЕДСТАВЛЕНИЕ(Ост.Субконто1) КАК ВидНалогаНаим,
	|	Ост.СуммаКонечныйОстатокКт - Ост.СуммаКонечныйОстатокДт КАК Сальдо
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&Дата, &Дата, , , Счет.Код В (&Счета), , ) КАК Ост
	|ГДЕ
	|	Ост.Организация.КодПоЕДРПОУ В (&СписокЕДРПОУ)
	|	И (Ост.СуммаКонечныйОстатокКт - Ост.СуммаКонечныйОстатокДт) <> 0";

	Попытка
		Запрос = V83.NewObject("Запрос");
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Дата", КонецДня(ОкончаниеПериода));

		МассивСчетов = V83.NewObject("Массив");
		Для Каждого Код Из СтрРазделить("6411,6412,6413,6414,6415,6417,642,651", ",", Ложь) Цикл
			МассивСчетов.Добавить(СокрЛП(Код));
		КонецЦикла;
		Запрос.УстановитьПараметр("Счета", МассивСчетов);

		МассивЕДРПОУ = V83.NewObject("Массив");
		Для Каждого Е Из СписокЕДРПОУ Цикл
			МассивЕДРПОУ.Добавить(СокрЛП(Е));
		КонецЦикла;
		Запрос.УстановитьПараметр("СписокЕДРПОУ", МассивЕДРПОУ);

		ТЗ = Запрос.Выполнить().Выгрузить();
		стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗ);
	Исключение
		V83 = Неопределено;
		V8 = Неопределено;
		ВызватьИсключение "Ошибка запроса BuhBud: " + ОписаниеОшибки();
	КонецПопытки;

	ТаблицаОстатков = ЗначениеИзСтрокиВнутр(стр_ТЗ);
	V83 = Неопределено;
	V8 = Неопределено;

	Налоги.Очистить();
	СчетчикПропущено = 0;
	Для Каждого СтрТЗ Из ТаблицаОстатков Цикл

		ОргERP = Справочники.Организации.НайтиПоРеквизиту("КодПоЕДРПОУ", СокрЛП(СтрТЗ.ЕДРПОУ));
		Если НЕ ЗначениеЗаполнено(ОргERP) Тогда
			СчетчикПропущено = СчетчикПропущено + 1;
			Продолжить;
		КонецЕсли;

		НС = Налоги.Добавить();
		НС.ОрганизацияБух = ОргERP;
		НС.КодСчета       = СокрЛП(СтрТЗ.КодСчета);
		НС.Счет           = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СокрЛП(СтрТЗ.КодСчета));
		НС.ТипНалога      = _ТипНалогаПоСчету(СтрТЗ.КодСчета);
		НС.Подразделение  = ОргERP.А_ПодразделениеЗарплатаБух;
		НС.ВидНалогаНаим  = СтрТЗ.ВидНалогаНаим;
		НС.СуммаСальдо    = СтрТЗ.Сальдо;
	КонецЦикла;

	Сообщить("Загружено позиций: " + Налоги.Количество());
	Если СчетчикПропущено > 0 Тогда
		Сообщить("Пропущено (организация не найдена в ERP по ЕДРПОУ): " + СчетчикПропущено);
	КонецЕсли;

КонецПроцедуры

// Создаёт/обновляет два документа-приёмника:
//   1) КорректировкаРегистров — движения Движения.ПрочиеАктивыПассивы (ПАП, одноногая)
//   2) ОперацияБух            — движения Движения.Хозрасчетный (Дт00/Кт<налог.счёт>)
Процедура СоздатьДокументы() Экспорт

	Если Налоги.Количество() = 0 Тогда
		ВызватьИсключение "Таблица налогов пуста — сначала «Загрузить остатки».";
	КонецЕсли;
	ДатаДок = КонецДня(ОкончаниеПериода);

	// 1) ПАП через КорректировкаРегистров — агрегат по Орг×Подр×ТипНалога (одноногая)
	ДокКР = _ПолучитьИлиСоздатьКР(ДатаДок);
	НаборПАП = ДокКР.Движения.ПрочиеАктивыПассивы;
	НаборПАП.Записывать = Истина;
	НаборПАП.Очистить();
	Если ДокКР.ТаблицаРегистров.Найти("ПрочиеАктивыПассивы", "Имя") = Неопределено Тогда
		ДокКР.ТаблицаРегистров.Добавить().Имя = "ПрочиеАктивыПассивы";
	КонецЕсли;

	// ПАП — управленческий регистр: ВСЕ налоги всех бух.организаций (А_ВБалансе)
	// сводятся на ОДНУ управленческую организацию (ТОВ "ІНДАСТРІАЛБУД"), агрегат
	// по Подразделение×ТипНалога. Иначе налоги ДЖИ ТРИ/ІНДЕПТ оседают на их орг и
	// не попадают в управ.баланс (он по одной орг) → занижение «Налогов» и
	// завышение «Прибыли». Регл.бухучёт (ОперацияБух ниже) остаётся по-организации.
	ОрганизацияУпр = А_ПолучитьОрганизациюУпр();
	ТЗАгр = Налоги.Выгрузить(, "Подразделение,ТипНалога,СуммаСальдо");
	ТЗАгр.Свернуть("Подразделение,ТипНалога", "СуммаСальдо");
	Для Каждого СтрА Из ТЗАгр Цикл
		Если СтрА.СуммаСальдо = 0 Тогда Продолжить; КонецЕсли;
		Абс = ?(СтрА.СуммаСальдо > 0, СтрА.СуммаСальдо, -СтрА.СуммаСальдо);
		ДвП = НаборПАП.Добавить();
		ДвП.Период        = ДатаДок;
		ДвП.Активность    = Истина;
		ДвП.ВидДвижения   = ?(СтрА.СуммаСальдо > 0, ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);
		ДвП.Организация   = ОрганизацияУпр;
		ДвП.Подразделение = СтрА.Подразделение;
		ДвП.Статья        = ПланыВидовХарактеристик.СтатьиАктивовПассивов.Налоги;
		ДвП.Аналитика     = СтрА.ТипНалога;
		ДвП.Источник      = Перечисления.ИсточникиУправленческогоБаланса.ПустаяСсылка();
		ДвП.ВидИсточника  = Перечисления.ВидыИсточниковДвижений.ПустаяСсылка();
		ДвП.Сумма         = Абс;
	КонецЦикла;

	// 2) Хозрасчетный через ОперацияБух — построчно (Дт00/Кт<налог.счёт>)
	ДокОБ = _ПолучитьИлиСоздатьОБ(ДатаДок);
	НаборХР = ДокОБ.Движения.Хозрасчетный;
	НаборХР.Записывать = Истина;
	НаборХР.Очистить();
	Счет00 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("00");
	Для Каждого СтрН Из Налоги Цикл
		Если СтрН.СуммаСальдо = 0 ИЛИ НЕ ЗначениеЗаполнено(СтрН.Счет) Тогда Продолжить; КонецЕсли;
		Абс = ?(СтрН.СуммаСальдо > 0, СтрН.СуммаСальдо, -СтрН.СуммаСальдо);
		ДвХ = НаборХР.Добавить();
		ДвХ.Период      = ДатаДок;
		ДвХ.Активность  = Истина;
		ДвХ.Организация = СтрН.ОрганизацияБух;
		ДвХ.Содержание  = "Ввод начального остатка по налогам";
		Если СтрН.СуммаСальдо > 0 Тогда
			// Кредитовое сальдо (задолженность бюджету): Дт00 / Кт<налог.счёт>
			ДвХ.СчетДт = Счет00;
			ДвХ.СчетКт = СтрН.Счет;
			_ЗаполнитьСубконтоНалога(ДвХ.СубконтоКт, СтрН.Счет, СтрН.ВидНалогаНаим);
		Иначе
			// Дебетовое сальдо (переплата): Дт<налог.счёт> / Кт00
			ДвХ.СчетДт = СтрН.Счет;
			ДвХ.СчетКт = Счет00;
			_ЗаполнитьСубконтоНалога(ДвХ.СубконтоДт, СтрН.Счет, СтрН.ВидНалогаНаим);
		КонецЕсли;
		ДвХ.Сумма = Абс;
	КонецЦикла;

	ДокКР.Записать(РежимЗаписиДокумента.Запись);
	ДокОБ.Записать(РежимЗаписиДокумента.Проведение);
	ДокументКорректировкаРегистров = ДокКР.Ссылка;
	ДокументОперацияБух = ДокОБ.Ссылка;

	Сообщить("Создан/обновлён ПАП: " + Строка(ДокументКорректировкаРегистров));
	Сообщить("Создан/обновлён бухучёт: " + Строка(ДокументОперацияБух));

КонецПроцедуры

Функция _ПолучитьИлиСоздатьКР(ДатаДок)
	Если ЗначениеЗаполнено(ДокументКорректировкаРегистров) Тогда
		// Загружаем в ВЫБРАННЫЙ на форме документ (его движения будут очищены и перезаписаны)
		Док = ДокументКорректировкаРегистров.ПолучитьОбъект();
	Иначе
		Док = Документы.КорректировкаРегистров.СоздатьДокумент();
		Док.Операция = Перечисления.ОперацииКорректировкиРегистров.РучнаяКорректировка;
	КонецЕсли;
	Док.Дата = ДатаДок;
	Если ЗначениеЗаполнено(Организация) Тогда
		Док.Организация = Организация;
	КонецЕсли;
	Возврат Док;
КонецФункции

Функция _ПолучитьИлиСоздатьОБ(ДатаДок)
	Если ЗначениеЗаполнено(ДокументОперацияБух) Тогда
		// Загружаем в ВЫБРАННЫЙ на форме документ (его движения будут очищены и перезаписаны)
		Док = ДокументОперацияБух.ПолучитьОбъект();
	Иначе
		Док = Документы.ОперацияБух.СоздатьДокумент();
	КонецЕсли;
	Док.Дата = ДатаДок;
	// ОперацияБух требует непустую шапочную Организацию для проведения (регл.учёт).
	// Движения Хозрасчетного несут собственную Организацию per-row (ОрганизацияБух);
	// приоритет: форма > уже заданная у документа > собственная управленческая (ТОВ ІНДАСТРІАЛБУД).
	Если ЗначениеЗаполнено(Организация) Тогда
		Док.Организация = Организация;
	ИначеЕсли НЕ ЗначениеЗаполнено(Док.Организация) Тогда
		Док.Организация = Справочники.Организации.НайтиПоРеквизиту("КодПоЕДРПОУ", "40645273");
	КонецЕсли;
	Возврат Док;
КонецФункции

#КонецЕсли
