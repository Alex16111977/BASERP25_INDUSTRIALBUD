// Серверный движок внешней обработки "ВыгрузкаОтчетаPLвExcel".
// Книга Excel по закладкам: каждый лист = Отчеты.А_ОтчетPL_ПолныйЕРП по одному
// подразделению или направлению деятельности. Постоянный состав листов хранится в
// РегистрСведений.А_СтруктураВыгрузкиОтчетаPLвЕксел; таблица на форме — разовая
// правка, отдельная команда пишет её обратно в регистр.
//
// Механизм одного листа (проверен 21.08.2026 на живой базе,
// _Rarzrabotki/Python/test/test_user_variant_compose.py и test_ravno_vs_gruppa.py):
//   * настройки пользовательского варианта (Справочник.ВариантыОтчетов, реквизит
//     Настройки) грузятся В ОСНОВНЫЕ настройки компоновщика отчёта;
//   * подставляются ТОЛЬКО параметр Период и значения отборов по Подразделению —
//     остальное в настройках варианта не трогать;
//   * основной механизм отборов (спека 2026-08-24-pl-excel-svod-otbor-design.md):
//     в варианте подготовлена пара элементов по полю Подразделение — «В списке»
//     (точное вхождение) и «В группе из списка» (с дочерними), обычно в группе Или.
//     Объект -> его подразделение «в группе»; ТолькоЭтоПодразделение -> корень
//     «в списке»; свод направления (ОтчетПоНаправлению) -> СЛОЙ СВОДОВ отчёта
//     (СводыНаправлений=Истина + корень «в списке»): накопительные приходят из
//     свод-остатков корня (Документ.А_ВводОстатковОтчетаPL) и включают закрытые
//     объекты независимо от состава листов книги (решение финансиста 31.08.2026);
//     PL_Свод (оба измерения пустые) -> слой сводов по корням направлений строк-сводов
//     (ЦО отсекается условием «Не в группе ЦО» в самом варианте общего свода);
//   * совместимость с вариантами БЕЗ пары: объект — первый отбор по Подразделению
//     (список из одного, вид сравнения из варианта), ТолькоЭто — Равно со скаляром,
//     только период (отборы варианта не трогаются).

#Область СведенияОВнешнейОбработке

Функция СведенияОВнешнейОбработке() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Вид", "ДополнительнаяОбработка");
	Параметры.Вставить("Версия", "1.0");
	Параметры.Вставить("БезопасныйРежим", Ложь);
	Параметры.Вставить("Информация",
		"Формирование одной книги Excel, где каждый лист — отчёт PL (полный ЕРП)"
		+ " по подразделению или направлению деятельности. Состав листов хранится"
		+ " в регистре сведений А_СтруктураВыгрузкиОтчетаPLвЕксел.");
	Параметры.Вставить("Наименование",
		"Выгрузка отчета PL в Excel");

	ТаблицаКоманд = Новый ТаблицаЗначений;
	ТаблицаКоманд.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	ТаблицаКоманд.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = "Выгрузка отчета PL в Excel (книга по подразделениям)";
	НоваяКоманда.Идентификатор = "ВыгрузкаОтчетаPLвExcel";
	НоваяКоманда.Использование = "ОткрытиеФормы";
	НоваяКоманда.ПоказыватьОповещение = Ложь;
	Параметры.Вставить("Команды", ТаблицаКоманд);

	Возврат Параметры;

КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Читает регистр настроек и заполняет ТЧ ПодразделенияДляОтчета
// в порядке НомерПорядковыйСтраницы (= порядок листов книги).
Процедура ЗаполнитьНастройкиИзРегистра() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Рег.НомерПорядковыйСтраницы КАК НомерСтраницы,
	|	Рег.ИмяСтраницы КАК ИмяЛиста,
	|	Рег.Подразделение КАК Подразделение,
	|	Рег.ВариантОтчета КАК ВариантОтчета,
	|	Рег.ОтчетПоНаправлению КАК ОтчетПоНаправлению,
	|	Рег.ТолькоЭтоПодразделение КАК ТолькоЭтоПодразделение,
	|	Рег.Выгружать КАК Выгружать
	|ИЗ
	|	РегистрСведений.А_СтруктураВыгрузкиОтчетаPLвЕксел КАК Рег
	|
	|УПОРЯДОЧИТЬ ПО
	|	Рег.НомерПорядковыйСтраницы";

	ПодразделенияДляОтчета.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

// Полная перезапись регистра настроек строками ТЧ ПодразделенияДляОтчета
// (как в первичном заполнении: набор записей без отбора).
Процедура СохранитьНастройкиВРегистр() Экспорт

	Набор = РегистрыСведений.А_СтруктураВыгрузкиОтчетаPLвЕксел.СоздатьНаборЗаписей();
	Для Каждого СтрокаНастройки Из ПодразделенияДляОтчета Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаНастройки.ИмяЛиста)
			И НЕ ЗначениеЗаполнено(СтрокаНастройки.Подразделение) Тогда
			Продолжить;
		КонецЕсли;
		Запись = Набор.Добавить();
		Запись.НомерПорядковыйСтраницы = СтрокаНастройки.НомерСтраницы;
		Запись.ИмяСтраницы             = Лев(СтрокаНастройки.ИмяЛиста, 100);
		Запись.Подразделение           = СтрокаНастройки.Подразделение;
		Запись.ВариантОтчета           = СтрокаНастройки.ВариантОтчета;
		Запись.ОтчетПоНаправлению      = СтрокаНастройки.ОтчетПоНаправлению;
		Запись.ТолькоЭтоПодразделение  = СтрокаНастройки.ТолькоЭтоПодразделение;
		Запись.Выгружать               = СтрокаНастройки.Выгружать;
	КонецЦикла;
	Набор.Записать(Истина);

КонецПроцедуры

// Нормализует имена листов прямо в ТЧ (ограничения Excel: 31 символ,
// запрещены : \ / ? * [ ]) и проверяет строки с Выгружать = Истина.
// Возвращает Структуру: ТекстОшибки (пусто = можно формировать), Предупреждения.
Функция ПроверитьНастройкиВыгрузки() Экспорт

	Результат = Новый Структура("ТекстОшибки, Предупреждения", "", "");
	Предупреждения = "";

	КоличествоКВыгрузке = 0;
	ИменаЛистов = Новый Соответствие;
	Для Каждого СтрокаНастройки Из ПодразделенияДляОтчета Цикл
		Если НЕ СтрокаНастройки.Выгружать Тогда
			Продолжить;
		КонецЕсли;
		КоличествоКВыгрузке = КоличествоКВыгрузке + 1;
		НомерСтрокиТЧ = ПодразделенияДляОтчета.Индекс(СтрокаНастройки) + 1;

		Если НЕ ЗначениеЗаполнено(СтрокаНастройки.ИмяЛиста) Тогда
			Результат.ТекстОшибки = "Строка " + НомерСтрокиТЧ + ": не заполнено имя листа.";
			Возврат Результат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаНастройки.ВариантОтчета) Тогда
			Результат.ТекстОшибки = "Лист «" + СтрокаНастройки.ИмяЛиста
				+ "»: не указан вариант отчета.";
			Возврат Результат;
		КонецЕсли;
		// Пустое подразделение = лист-СВОД (PL_Свод): значения отбора подставляет
		// обработка, у строки проверять нечего.
		Если ЗначениеЗаполнено(СтрокаНастройки.Подразделение) Тогда
			// заполнено — годится и для объекта, и для свода направления
		ИначеЕсли СтрокаНастройки.ОтчетПоНаправлению Тогда
			Результат.ТекстОшибки = "Лист «" + СтрокаНастройки.ИмяЛиста
				+ "»: отчет по направлению, но подразделение-корень не заполнено.";
			Возврат Результат;
		КонецЕсли;

		НормальноеИмя = НормализованноеИмяЛиста(СтрокаНастройки.ИмяЛиста);
		Если НЕ ЗначениеЗаполнено(НормальноеИмя) Тогда
			Результат.ТекстОшибки = "Строка " + НомерСтрокиТЧ
				+ ": имя листа «" + СтрокаНастройки.ИмяЛиста
				+ "» после чистки запрещённых символов пусто.";
			Возврат Результат;
		КонецЕсли;
		Если НормальноеИмя <> СтрокаНастройки.ИмяЛиста Тогда
			Предупреждения = Предупреждения + ?(Предупреждения = "", "", Символы.ПС)
				+ "Имя листа «" + СтрокаНастройки.ИмяЛиста + "» исправлено на «"
				+ НормальноеИмя + "» (ограничения Excel: 31 символ, без : \ / ? * [ ]).";
			СтрокаНастройки.ИмяЛиста = НормальноеИмя;
		КонецЕсли;

		КлючИмени = ВРег(НормальноеИмя);
		Если ИменаЛистов[КлючИмени] <> Неопределено Тогда
			Результат.ТекстОшибки = "Дубль имени листа «" + НормальноеИмя
				+ "» (Excel не допускает одинаковых имён листов). Исправьте таблицу.";
			Возврат Результат;
		КонецЕсли;
		ИменаЛистов.Вставить(КлючИмени, Истина);
	КонецЦикла;

	Если КоличествоКВыгрузке = 0 Тогда
		Результат.ТекстОшибки = "Нет ни одной строки с флагом «Выгружать».";
	КонецЕсли;
	Результат.Предупреждения = Предупреждения;
	Возврат Результат;

КонецФункции

// Формирует все листы книги по строкам ТЧ с Выгружать = Истина.
// Возвращает Массив структур {ИмяЛиста, ТабДок}.
Функция СформироватьЛисты() Экспорт

	Результат = Новый Массив;
	Для Каждого СтрокаНастройки Из ПодразделенияДляОтчета Цикл
		Если НЕ СтрокаНастройки.Выгружать Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(
			СформироватьЛистПоИндексу(ПодразделенияДляОтчета.Индекс(СтрокаНастройки)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Формирует один лист по индексу строки ТЧ (порционный вызов с формы:
// клиент показывает прогресс и пишет временные файлы между вызовами).
// Возвращает Структуру: ИмяЛиста (нормализованное), ТабДок (ТабличныйДокумент).
Функция СформироватьЛистПоИндексу(ИндексСтроки) Экспорт

	СтрокаНастройки = ПодразделенияДляОтчета[ИндексСтроки];
	Лист = Новый Структура("ИмяЛиста, ТабДок");
	Лист.ИмяЛиста = НормализованноеИмяЛиста(СтрокаНастройки.ИмяЛиста);
	Лист.ТабДок = СформироватьТабДокПоСтроке(СтрокаНастройки);
	Возврат Лист;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Компонует Отчеты.А_ОтчетPL_ПолныйЕРП по одной строке настроек
// (механизм проверен на живой базе — см. шапку модуля).
Функция СформироватьТабДокПоСтроке(СтрокаНастройки)

	Если НЕ ЗначениеЗаполнено(СтрокаНастройки.ВариантОтчета) Тогда
		ВызватьИсключение "Лист «" + СтрокаНастройки.ИмяЛиста
			+ "»: не указан вариант отчета.";
	КонецЕсли;

	НастройкиВарианта = СтрокаНастройки.ВариантОтчета.Настройки.Получить();
	Если НастройкиВарианта = Неопределено Тогда
		ВызватьИсключение "Вариант отчета «" + Строка(СтрокаНастройки.ВариантОтчета)
			+ "»: хранилище настроек пустое.";
	КонецЕсли;

	// С 31.08.2026 книга строится отчётом-клоном с фиксированными накопительными:
	// «PL с начала года» и «Накопительный PL» = Документ.А_ВводОстатковОтчетаPL
	// (остатки на 30.06.2026 по-листово) + обороты после даты остатков.
	Отчет = Отчеты.А_ОтчетPL_ПолныйЕРП_Остатки.Создать();
	Компоновщик = Отчет.КомпоновщикНастроек;
	Компоновщик.Инициализировать(
		Новый ИсточникДоступныхНастроекКомпоновкиДанных(Отчет.СхемаКомпоновкиДанных));
	Компоновщик.ЗагрузитьНастройки(НастройкиВарианта);

	НастройкиКомпоновки = Компоновщик.Настройки;

	// Период: единственный параметр, который подставляет обработка.
	ЭлементПериода = НастройкиКомпоновки.ПараметрыДанных.Элементы.Найти("Период");
	Если ЭлементПериода = Неопределено Тогда
		ВызватьИсключение "В варианте «" + Строка(СтрокаНастройки.ВариантОтчета)
			+ "» нет параметра «Период».";
	КонецЕсли;
	ПериодОтчета = Новый СтандартныйПериод;
	ПериодОтчета.ДатаНачала    = НачалоДня(НачалоПериода);
	ПериодОтчета.ДатаОкончания = КонецДня(ОкончаниеПериода);
	ЭлементПериода.Значение = ПериодОтчета;
	ЭлементПериода.Использование = Истина;

	ЗаполнитьОтборыЛиста(НастройкиКомпоновки, СтрокаНастройки);

	ТабДок = Новый ТабличныйДокумент;
	Отчет.СкомпоноватьРезультат(ТабДок);
	Возврат ТабДок;

КонецФункции

// Заполняет отборы по подразделениям для строки настроек.
// Основной механизм: в варианте подготовлен каркас — пара элементов отбора по полю
// Подразделение («В списке» для точного вхождения корней + «В группе из списка» для
// объектов с их дочерними), обычно внутри группы Или. Обработка только заполняет
// значения; прочие условия варианта (например «Не в группе ЦО» у общего свода)
// не трогаются. Если пары в варианте нет — прежние механизмы (совместимость).
Процедура ЗаполнитьОтборыЛиста(НастройкиКомпоновки, СтрокаНастройки)

	Пара = Новый Структура("ВСписке, ВГруппе", Неопределено, Неопределено);
	НайтиПаруОтбораПоПодразделению(НастройкиКомпоновки.Отбор.Элементы, Пара);
	ПараНайдена = (Пара.ВСписке <> Неопределено) И (Пара.ВГруппе <> Неопределено);

	ЛистСвод = НЕ ЗначениеЗаполнено(СтрокаНастройки.Подразделение);

	Если ЛистСвод Тогда
		// Общий свод — СЛОЙ СВОДОВ: корни направлений из строк-сводов таблицы
		// (ЦО отсекается условием «Не в группе ЦО» самого варианта).
		УстановитьСводыНаправлений(НастройкиКомпоновки, СтрокаНастройки.ВариантОтчета);
		Состав = КорниНаправленийСводов();
		ИсключитьОтсекаемыеВариантом(НастройкиКомпоновки, Состав);
		Если ПараНайдена Тогда
			ПрименитьСоставКПаре(Пара, Состав, СтрокаНастройки.ИмяЛиста);
		Иначе
			// Вариант с одиночным «Подразделение В группе из списка»
			// («PL: (без направления ЦО)…»): корни направлений одним списком.
			ЗаполнитьОдиночныйОтборСписком(НастройкиКомпоновки, СтрокаНастройки,
				"Подразделение", Состав.Корни);
		КонецЕсли;
	ИначеЕсли СтрокаНастройки.ОтчетПоНаправлению Тогда
		// Свод направления — СЛОЙ СВОДОВ отчёта (решение финансиста 31.08.2026):
		// накопительные = свод-остатки корня направления (включают закрытые до даты
		// остатков объекты), текущий месяц — ЕРП по карте на корень. Состав листов
		// книги на цифры свода больше не влияет.
		УстановитьСводыНаправлений(НастройкиКомпоновки, СтрокаНастройки.ВариантОтчета);
		Если ПараНайдена Тогда
			Состав = НовыйСоставОтбора();
			Состав.Корни.Добавить(СтрокаНастройки.Подразделение);
			ПрименитьСоставКПаре(Пара, Состав, СтрокаНастройки.ИмяЛиста);
		Иначе
			// Вариант с одиночным отбором «Подразделение В группе из списка»
			// («PL: … (для свода)», решение финансиста 01.09.2026): на слое сводов
			// строки лежат на САМОМ корне, «в группе корня» их пропускает — второй
			// элемент пары не нужен.
			ЗаполнитьОдиночныйОтбор(НастройкиКомпоновки, СтрокаНастройки,
				"Подразделение", СтрокаНастройки.Подразделение);
		КонецЕсли;
	ИначеЕсли ПараНайдена Тогда
		Состав = НовыйСоставОтбора();
		Если СтрокаНастройки.ТолькоЭтоПодразделение Тогда
			Состав.Корни.Добавить(СтрокаНастройки.Подразделение);
		Иначе
			Состав.Объекты.Добавить(СтрокаНастройки.Подразделение);
		КонецЕсли;
		ПрименитьСоставКПаре(Пара, Состав, СтрокаНастройки.ИмяЛиста);
	Иначе
		// Старые варианты объектных листов: одиночный отбор по подразделению.
		ЗаполнитьОдиночныйОтбор(НастройкиКомпоновки, СтрокаНастройки,
			"Подразделение", СтрокаНастройки.Подразделение);
	КонецЕсли;

КонецПроцедуры

// Заполняет первый элемент отбора по имени поля СПИСКОМ значений
// (вид сравнения берётся из варианта — обычно «В группе из списка»).
Процедура ЗаполнитьОдиночныйОтборСписком(НастройкиКомпоновки, СтрокаНастройки, ИмяПоляОтбора, ЗначенияОтбора)

	Если ЗначенияОтбора.Количество() = 0 Тогда
		ВызватьИсключение "Лист «" + СтрокаНастройки.ИмяЛиста
			+ "»: не удалось собрать состав свода (нет строк-сводов с флагом «Выгружать»).";
	КонецЕсли;
	ЭлементОтбора = НайтиЭлементОтбораПоПолю(НастройкиКомпоновки.Отбор.Элементы, ИмяПоляОтбора);
	Если ЭлементОтбора = Неопределено Тогда
		ВызватьИсключение "В варианте «" + Строка(СтрокаНастройки.ВариантОтчета)
			+ "» нет отбора по полю «" + ИмяПоляОтбора
			+ "» (лист «" + СтрокаНастройки.ИмяЛиста + "»).";
	КонецЕсли;
	СписокОтбора = Новый СписокЗначений;
	Для Каждого ЭлементСписка Из ЗначенияОтбора Цикл
		СписокОтбора.Добавить(ЭлементСписка.Значение);
	КонецЦикла;
	ЭлементОтбора.ПравоеЗначение = СписокОтбора;
	ЭлементОтбора.Использование = Истина;

КонецПроцедуры

// Прежний механизм для вариантов без пары: первый элемент отбора по имени поля,
// ТолькоЭтоПодразделение -> Равно со скаляром, иначе список из одного значения
// с видом сравнения из варианта.
Процедура ЗаполнитьОдиночныйОтбор(НастройкиКомпоновки, СтрокаНастройки, ИмяПоляОтбора, ЗначениеОтбора)

	Если НЕ ЗначениеЗаполнено(ЗначениеОтбора) Тогда
		ВызватьИсключение "Лист «" + СтрокаНастройки.ИмяЛиста
			+ "»: не заполнено значение отбора (" + ИмяПоляОтбора + ").";
	КонецЕсли;
	ЭлементОтбора = НайтиЭлементОтбораПоПолю(НастройкиКомпоновки.Отбор.Элементы, ИмяПоляОтбора);
	Если ЭлементОтбора = Неопределено Тогда
		// Молчаливый полный отчёт по всей базе хуже ошибки — СТОП всей выгрузки.
		ВызватьИсключение "В варианте «" + Строка(СтрокаНастройки.ВариантОтчета)
			+ "» нет отбора по полю «" + ИмяПоляОтбора
			+ "» (лист «" + СтрокаНастройки.ИмяЛиста + "»).";
	КонецЕсли;
	Если СтрокаНастройки.ТолькоЭтоПодразделение Тогда
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = ЗначениеОтбора;
	Иначе
		СписокОтбора = Новый СписокЗначений;
		СписокОтбора.Добавить(ЗначениеОтбора);
		ЭлементОтбора.ПравоеЗначение = СписокОтбора;
	КонецЕсли;
	ЭлементОтбора.Использование = Истина;

КонецПроцедуры

// Рекурсивный поиск пары элементов отбора по полю Подразделение:
// Пара.ВСписке — вид сравнения «В списке», Пара.ВГруппе — «В группе из списка».
Процедура НайтиПаруОтбораПоПодразделению(ЭлементыОтбора, Пара)

	Для Каждого ЭлементКоллекции Из ЭлементыОтбора Цикл
		Если ТипЗнч(ЭлементКоллекции) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			НайтиПаруОтбораПоПодразделению(ЭлементКоллекции.Элементы, Пара);
			Продолжить;
		КонецЕсли;
		ПредставлениеПоля = "";
		Попытка
			ПредставлениеПоля = Строка(ЭлементКоллекции.ЛевоеЗначение);
		Исключение
			ПредставлениеПоля = "";
		КонецПопытки;
		Если ПредставлениеПоля <> "Подразделение" Тогда
			Продолжить;
		КонецЕсли;
		// «В группе из списка» в BSL — значение ВСпискеПоИерархии (проверено COM:
		// Строка(ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии) = "В группе из списка").
		Если ЭлементКоллекции.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
			И Пара.ВСписке = Неопределено Тогда
			Пара.ВСписке = ЭлементКоллекции;
		ИначеЕсли ЭлементКоллекции.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии
			И Пара.ВГруппе = Неопределено Тогда
			Пара.ВГруппе = ЭлементКоллекции;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Включает слой сводов отчёта: параметр «СводыНаправлений» = Истина.
// Без параметра в варианте — СТОП всей выгрузки (молчаливый объектный слой хуже ошибки).
Процедура УстановитьСводыНаправлений(НастройкиКомпоновки, ВариантОтчета)

	ЭлементПараметра = НастройкиКомпоновки.ПараметрыДанных.Элементы.Найти("СводыНаправлений");
	Если ЭлементПараметра = Неопределено Тогда
		ВызватьИсключение "В варианте «" + Строка(ВариантОтчета)
			+ "» нет параметра «СводыНаправлений» — свод-лист построить нельзя.";
	КонецЕсли;
	ЭлементПараметра.Значение = Истина;
	ЭлементПараметра.Использование = Истина;

КонецПроцедуры

// Корни направлений для общего свода: подразделения строк-сводов таблицы
// (ОтчетПоНаправлению = Истина, Выгружать = Истина), без дублей.
Функция КорниНаправленийСводов()

	Состав = НовыйСоставОтбора();
	Для Каждого СтрокаСостава Из ПодразделенияДляОтчета Цикл
		Если СтрокаСостава.Выгружать
			И СтрокаСостава.ОтчетПоНаправлению
			И ЗначениеЗаполнено(СтрокаСостава.Подразделение) Тогда
			ДобавитьБезДублей(Состав.Корни, СтрокаСостава.Подразделение);
		КонецЕсли;
	КонецЦикла;
	Возврат Состав;

КонецФункции

Функция НовыйСоставОтбора()

	Возврат Новый Структура("Корни, Объекты", Новый СписокЗначений, Новый СписокЗначений);

КонецФункции

// Подразделения, отсекаемые самим вариантом условиями «Не в группе» /
// «Не в группе из списка» (например ЦО у общего свода), в состав свода не
// включаются: И-условие всё равно их вычтет, а в представлении отбора листа
// они только сбивают с толку.
Процедура ИсключитьОтсекаемыеВариантом(НастройкиКомпоновки, Состав)

	ИсключающиеКорни = Новый СписокЗначений;
	СобратьИсключающиеКорни(НастройкиКомпоновки.Отбор.Элементы, ИсключающиеКорни);
	Если ИсключающиеКорни.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	УдалитьПринадлежащиеКорням(Состав.Корни, ИсключающиеКорни);
	УдалитьПринадлежащиеКорням(Состав.Объекты, ИсключающиеКорни);

КонецПроцедуры

// Собирает значения ВКЛЮЧЁННЫХ условий «Не в группе» / «Не в группе из списка»
// по полю Подразделение (правое значение — скаляр или список).
Процедура СобратьИсключающиеКорни(ЭлементыОтбора, ИсключающиеКорни)

	Для Каждого ЭлементКоллекции Из ЭлементыОтбора Цикл
		Если ТипЗнч(ЭлементКоллекции) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			СобратьИсключающиеКорни(ЭлементКоллекции.Элементы, ИсключающиеКорни);
			Продолжить;
		КонецЕсли;
		Если НЕ ЭлементКоллекции.Использование Тогда
			Продолжить;
		КонецЕсли;
		ПредставлениеПоля = "";
		Попытка
			ПредставлениеПоля = Строка(ЭлементКоллекции.ЛевоеЗначение);
		Исключение
			ПредставлениеПоля = "";
		КонецПопытки;
		Если ПредставлениеПоля <> "Подразделение" Тогда
			Продолжить;
		КонецЕсли;
		Если ЭлементКоллекции.ВидСравнения <> ВидСравненияКомпоновкиДанных.НеВИерархии
			И ЭлементКоллекции.ВидСравнения <> ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ЭлементКоллекции.ПравоеЗначение) = Тип("СписокЗначений") Тогда
			Для Каждого ЭлементСписка Из ЭлементКоллекции.ПравоеЗначение Цикл
				Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
					ДобавитьБезДублей(ИсключающиеКорни, ЭлементСписка.Значение);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ЗначениеЗаполнено(ЭлементКоллекции.ПравоеЗначение) Тогда
			ДобавитьБезДублей(ИсключающиеКорни, ЭлементКоллекции.ПравоеЗначение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Убирает из списка значения, равные исключающим корням или принадлежащие им
// по иерархии (сам элемент себе НЕ принадлежит — равенство проверяется отдельно).
Процедура УдалитьПринадлежащиеКорням(СписокПодразделений, ИсключающиеКорни)

	Индекс = СписокПодразделений.Количество() - 1;
	Пока Индекс >= 0 Цикл
		ЗначениеСписка = СписокПодразделений[Индекс].Значение;
		Для Каждого ЭлементКорня Из ИсключающиеКорни Цикл
			Если ЗначениеСписка = ЭлементКорня.Значение
				ИЛИ ЗначениеСписка.ПринадлежитЭлементу(ЭлементКорня.Значение) Тогда
				СписокПодразделений.Удалить(Индекс);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

// Заполняет пару элементов отбора собранным составом; пустая половина выключается.
Процедура ПрименитьСоставКПаре(Пара, Состав, ИмяЛиста)

	Если Состав.Корни.Количество() = 0 И Состав.Объекты.Количество() = 0 Тогда
		ВызватьИсключение "Лист «" + ИмяЛиста + "»: не удалось собрать состав свода"
			+ " по таблице (нет подходящих строк с флагом «Выгружать»"
			+ " и заполненным подразделением).";
	КонецЕсли;
	Если Состав.Корни.Количество() > 0 Тогда
		Пара.ВСписке.ПравоеЗначение = Состав.Корни;
		Пара.ВСписке.Использование = Истина;
	Иначе
		Пара.ВСписке.Использование = Ложь;
	КонецЕсли;
	Если Состав.Объекты.Количество() > 0 Тогда
		Пара.ВГруппе.ПравоеЗначение = Состав.Объекты;
		Пара.ВГруппе.Использование = Истина;
	Иначе
		Пара.ВГруппе.Использование = Ложь;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьБезДублей(Приемник, Значение)

	Если Приемник.НайтиПоЗначению(Значение) = Неопределено Тогда
		Приемник.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьСписокБезДублей(Приемник, Источник)

	Для Каждого ЭлементСписка Из Источник Цикл
		ДобавитьБезДублей(Приемник, ЭлементСписка.Значение);
	КонецЦикла;

КонецПроцедуры

// Рекурсивный поиск элемента отбора по имени поля: элементы могут быть
// группами (ГруппаЭлементовОтбораКомпоновкиДанных), у групп нет ЛевоеЗначение.
Функция НайтиЭлементОтбораПоПолю(ЭлементыОтбора, ИмяПоля)

	Для Каждого ЭлементКоллекции Из ЭлементыОтбора Цикл
		Если ТипЗнч(ЭлементКоллекции) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			НайденныйЭлемент = НайтиЭлементОтбораПоПолю(ЭлементКоллекции.Элементы, ИмяПоля);
			Если НайденныйЭлемент <> Неопределено Тогда
				Возврат НайденныйЭлемент;
			КонецЕсли;
		Иначе
			ПредставлениеПоля = "";
			Попытка
				ПредставлениеПоля = Строка(ЭлементКоллекции.ЛевоеЗначение);
			Исключение
				ПредставлениеПоля = "";
			КонецПопытки;
			Если ПредставлениеПоля = ИмяПоля Тогда
				Возврат ЭлементКоллекции;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Имя листа по правилам Excel: без : \ / ? * [ ], не длиннее 31 символа.
Функция НормализованноеИмяЛиста(ИмяЛиста)

	Результат = СокрЛП(ИмяЛиста);
	ЗапрещенныеСимволы = ":\/?*[]";
	Для НомерСимвола = 1 По СтрДлина(ЗапрещенныеСимволы) Цикл
		Результат = СтрЗаменить(Результат, Сред(ЗапрещенныеСимволы, НомерСимвола, 1), "_");
	КонецЦикла;
	Возврат СокрЛП(Лев(Результат, 31));

КонецФункции

#КонецОбласти
