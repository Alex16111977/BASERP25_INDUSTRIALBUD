// Тонкая форма-диспетчер обработки "ВыгрузкаОтчетаPLвExcel".
// Логика (регистр настроек, компоновка отчётов) — в модуле объекта; здесь UI,
// порционное формирование листов с прогрессом и сборка книги Excel на клиенте
// через COMObject("Excel.Application") — ТабличныйДокумент.Записать(XLSX) умеет
// только один лист на файл, поэтому книга склеивается из временных файлов.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) Тогда
		Объект.НачалоПериода = НачалоМесяца(НачалоМесяца(ТекущаяДатаСеанса()) - 1);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		Объект.ОкончаниеПериода = КонецМесяца(Объект.НачалоПериода);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ИмяФайлаОтчета) Тогда
		Объект.ИмяФайлаОтчета = "PL по компании "
			+ Формат(Объект.НачалоПериода, "ДФ=MM.yyyy") + ".xlsx";
	КонецЕсли;
	// Форма должна открыться даже если конфигурация базы ещё не обновлена
	// (регистр без ресурсов) — иначе пользователь не увидит причину.
	Попытка
		ЗаполнитьИзРегистраНаСервере();
	Исключение
		Сообщить("Не удалось заполнить настройки из регистра"
			+ " А_СтруктураВыгрузкиОтчетаPLвЕксел: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьИзРегистра(Команда)

	ОчиститьСообщения();
	КоличествоСтрок = ЗаполнитьИзРегистраНаСервере();
	ПоказатьОповещениеПользователя("Заполнено из регистра", , "Строк: " + КоличествоСтрок);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьВРегистр(Команда)

	ОчиститьСообщения();
	ТекстВопроса = "Таблица будет записана в регистр А_СтруктураВыгрузкиОтчетаPLвЕксел"
		+ " как новые постоянные настройки состава листов."
		+ " Старое содержимое регистра будет заменено полностью."
		+ Символы.ПС + "Продолжить?";
	Оповещение = Новый ОписаниеОповещения("СохранитьВРегистрЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьВРегистрЗавершение(Ответ, ДопПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	КоличествоСтрок = СохранитьВРегистрНаСервере();
	ПоказатьОповещениеПользователя("Сохранено в регистр", , "Строк: " + КоличествоСтрок);

КонецПроцедуры

&НаКлиенте
Процедура ПеренумероватьЛисты(Команда)

	Если Объект.ПодразделенияДляОтчета.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Таблица пуста — нечего нумеровать.");
		Возврат;
	КонецЕсли;
	// Номера 1..N по ТЕКУЩЕМУ порядку строк таблицы (порядок задаёт пользователь
	// стрелками/вставкой, кнопка только выравнивает номера).
	НовыйНомер = 0;
	Для Каждого СтрокаТаблицы Из Объект.ПодразделенияДляОтчета Цикл
		НовыйНомер = НовыйНомер + 1;
		СтрокаТаблицы.НомерСтраницы = НовыйНомер;
	КонецЦикла;
	ПоказатьОповещениеПользователя("Перенумеровано строк: " + НовыйНомер);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайл(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Файл книги Excel";
	Диалог.Фильтр = "Книга Excel (*.xlsx)|*.xlsx";
	Диалог.Расширение = "xlsx";
	Если ЗначениеЗаполнено(Объект.ИмяФайлаОтчета) Тогда
		Диалог.ПолноеИмяФайла = Объект.ИмяФайлаОтчета;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ВыбратьФайлЗавершение", ЭтотОбъект);
	Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлЗавершение(ВыбранныеФайлы, ДопПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено ИЛИ ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Объект.ИмяФайлаОтчета = ВыбранныеФайлы[0];

КонецПроцедуры

&НаКлиенте
Процедура СформироватьExcel(Команда)

	ОчиститьСообщения();
	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода)
		ИЛИ НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		ПоказатьПредупреждение(, "Укажите период отчета.");
		Возврат;
	КонецЕсли;
	Если Объект.НачалоПериода > Объект.ОкончаниеПериода Тогда
		ПоказатьПредупреждение(, "Начало периода больше окончания.");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ИмяФайлаОтчета) Тогда
		ПоказатьПредупреждение(, "Укажите файл книги Excel.");
		Возврат;
	КонецЕсли;

	// Проверка и нормализация имён листов ДО формирования: дубль имени — стоп.
	Проверка = ПроверитьНастройкиНаСервере();
	Если Проверка.ТекстОшибки <> "" Тогда
		ПоказатьПредупреждение(, Проверка.ТекстОшибки);
		Возврат;
	КонецЕсли;
	Если Проверка.Предупреждения <> "" Тогда
		Сообщить(Проверка.Предупреждения);
	КонецЕсли;

	// Индексы строк к выгрузке — в порядке таблицы (= порядок листов книги).
	ИндексыСтрок = Новый Массив;
	Для Каждого СтрокаТаблицы Из Объект.ПодразделенияДляОтчета Цикл
		Если СтрокаТаблицы.Выгружать Тогда
			ИндексыСтрок.Добавить(Объект.ПодразделенияДляОтчета.Индекс(СтрокаТаблицы));
		КонецЕсли;
	КонецЦикла;
	Если ИндексыСтрок.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Нет ни одной строки с флагом «Выгружать».");
		Возврат;
	КонецЕсли;

	// Фаза 1: формирование листов порциями — каждый лист отдельным серверным
	// вызовом (2-5 секунд на лист), прогресс в окне состояния.
	Листы = Новый Массив;
	ВременныеФайлы = Новый Массив;
	ВсегоЛистов = ИндексыСтрок.Количество();
	НомерЛиста = 0;
	Для Каждого ИндексСтроки Из ИндексыСтрок Цикл
		НомерЛиста = НомерЛиста + 1;
		СтрокаТаблицы = Объект.ПодразделенияДляОтчета[ИндексСтроки];
		Состояние("Формирование отчета: лист " + НомерЛиста + " из " + ВсегоЛистов
			+ " — " + СтрокаТаблицы.ИмяЛиста);
		Лист = СформироватьЛистНаСервере(ИндексСтроки);
		// Уникальное имя временного файла: фиксированное имя ловило
		// "Ошибка совместного доступа" от зависшего Excel предыдущего запуска.
		ПутьФайла = КаталогВременныхФайлов() + "plxl_"
			+ Строка(Новый УникальныйИдентификатор) + ".xlsx";
		Лист.ТабДок.Записать(ПутьФайла, ТипФайлаТабличногоДокумента.XLSX);
		Листы.Добавить(Новый Структура("ИмяЛиста, Путь", Лист.ИмяЛиста, ПутьФайла));
		ВременныеФайлы.Добавить(ПутьФайла);
	КонецЦикла;

	// Фаза 2: сборка книги на клиенте через COM Excel.
	// Все COM-ссылки — в структуре; ЗакрытьЕксель вызывается на всех путях выхода.
	СтрПараметров = Новый Структура;
	СтрПараметров.Вставить("Ексель", Неопределено);
	СтрПараметров.Вставить("ЦелеваяКнига", Неопределено);
	СтрПараметров.Вставить("КнигаИсточник", Неопределено);
	СтрПараметров.Вставить("ВременныеФайлы", ВременныеФайлы);

	Попытка
		Ексель = Новый COMObject("Excel.Application");
		СтрПараметров.Ексель = Ексель;
		// СРАЗУ после создания, ДО первого Open: невидимый модальный диалог
		// Excel иначе подвешивает клиента. Visible не включать.
		Ексель.DisplayAlerts = Ложь;
		Ексель.SheetsInNewWorkbook = 1;
		ЦелеваяКнига = Ексель.Workbooks.Add();
		СтрПараметров.ЦелеваяКнига = ЦелеваяКнига;

		НомерЛиста = 0;
		Для Каждого ОписаниеЛиста Из Листы Цикл
			НомерЛиста = НомерЛиста + 1;
			Состояние("Сборка книги: лист " + НомерЛиста + " из " + Листы.Количество()
				+ " — " + ОписаниеЛиста.ИмяЛиста);
			КнигаИсточник = Ексель.Workbooks.Open(ОписаниеЛиста.Путь);
			СтрПараметров.КнигаИсточник = КнигаИсточник;
			// Копия ПОСЛЕ последнего листа целевой книги, затем переименование.
			КнигаИсточник.Sheets(1).Copy(, ЦелеваяКнига.Sheets(ЦелеваяКнига.Sheets.Count));
			ЦелеваяКнига.Sheets(ЦелеваяКнига.Sheets.Count).Name = ОписаниеЛиста.ИмяЛиста;
			// Свернуть группировки строк до 2-го уровня (разделы + статьи PL,
			// аналитика скрыта — раскрывается плюсиками в Excel). 1С при
			// Записать(XLSX) всегда пишет outline РАЗВЁРНУТЫМ, поэтому свёртка
			// делается здесь; состояние сохраняется в книге при SaveAs.
			Попытка
				ЦелеваяКнига.Sheets(ЦелеваяКнига.Sheets.Count).Outline.ShowLevels(2);
			Исключение
				// у листа без группировок Outline отказывает — оставить как есть
			КонецПопытки;
			// Свернуть шапку листа («Параметры:» + «Отбор:» — все строки до
			// заголовка таблицы «Строка листа…»): группа с плюсиком, скрытая по
			// умолчанию. После ShowLevels, чтобы свёртка данных её не раскрыла.
			Попытка
				ЛистКниги = ЦелеваяКнига.Sheets(ЦелеваяКнига.Sheets.Count);
				// Граница шапки — БЕЗ привязки к тексту заголовка (его переименовывают
				// в вариантах: «Строка листа…», «Строка PL»…): текст шапки живёт только
				// в колонках 1..3, а у заголовка/данных таблицы заполнены колонки 4+
				// («Июль 2026», суммы). Первая строка с данными правее колонки 3 = таблица.
				НомерСтрокиТаблицы = 0;
				Для НомерПоиска = 2 По 30 Цикл
					Для НомерКолонки = 4 По 10 Цикл
						ЗначениеЯчейки = ЛистКниги.Cells(НомерПоиска, НомерКолонки).Value;
						Если ЗначениеЯчейки <> Неопределено И Строка(ЗначениеЯчейки) <> "" Тогда
							НомерСтрокиТаблицы = НомерПоиска;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если НомерСтрокиТаблицы > 0 Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НомерСтрокиТаблицы > 2 Тогда
					ДиапазонШапки = ЛистКниги.Rows("2:" + Формат(НомерСтрокиТаблицы - 1, "ЧГ="));
					ДиапазонШапки.Group();
					ДиапазонШапки.Hidden = Истина;
				КонецЕсли;
			Исключение
				// шапка не найдена или лист нетипичный — оставить развёрнутым
			КонецПопытки;
			КнигаИсточник.Close(Ложь);
			СтрПараметров.КнигаИсточник = Неопределено;
		КонецЦикла;

		// Первый лист новой книги — пустой служебный, удалить.
		Если ЦелеваяКнига.Sheets.Count > Листы.Количество() Тогда
			ЦелеваяКнига.Sheets(1).Delete();
		КонецЕсли;

		// Книга должна открываться на ПЕРВОМ листе (PL_Свод): активный лист
		// запоминается в файле, а после копирования активен последний.
		ЦелеваяКнига.Sheets(1).Activate();

		ЦелеваяКнига.SaveAs(Объект.ИмяФайлаОтчета, 51); // 51 = xlOpenXMLWorkbook (.xlsx)
	Исключение
		ОписаниеПроблемы = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗакрытьЕксель(СтрПараметров);
		ПоказатьПредупреждение(, "Не удалось собрать книгу Excel: " + ОписаниеПроблемы);
		Возврат;
	КонецПопытки;

	ЗакрытьЕксель(СтрПараметров);
	ПоказатьОповещениеПользователя("Книга Excel сформирована", , Объект.ИмяФайлаОтчета);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаполнитьИзРегистраНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ОбъектОбработки.ЗаполнитьНастройкиИзРегистра();
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");
	Возврат Объект.ПодразделенияДляОтчета.Количество();

КонецФункции

&НаСервере
Функция СохранитьВРегистрНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ОбъектОбработки.СохранитьНастройкиВРегистр();
	Возврат Объект.ПодразделенияДляОтчета.Количество();

КонецФункции

&НаСервере
Функция ПроверитьНастройкиНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Результат = ОбъектОбработки.ПроверитьНастройкиВыгрузки();
	// Нормализованные имена листов должны вернуться в таблицу на форме.
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");
	Возврат Результат;

КонецФункции

&НаСервере
Функция СформироватьЛистНаСервере(ИндексСтроки)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектОбработки.СформироватьЛистПоИндексу(ИндексСтроки);

КонецФункции

#КонецОбласти

#Область КлиентскиеПроцедурыExcel

// Гарантированно закрывает книги и Excel, освобождает COM-ссылки и удаляет
// временные файлы. Каждая ступень в своей Попытке: сбой одной не должен
// помешать остальным. Вызывается на ВСЕХ путях выхода, включая исключения.
&НаКлиенте
Процедура ЗакрытьЕксель(СтрПараметров)

	Попытка
		Если СтрПараметров.КнигаИсточник <> Неопределено Тогда
			СтрПараметров.КнигаИсточник.Close(Ложь);
		КонецЕсли;
	Исключение
	КонецПопытки;
	СтрПараметров.КнигаИсточник = Неопределено;

	Попытка
		Если СтрПараметров.ЦелеваяКнига <> Неопределено Тогда
			СтрПараметров.ЦелеваяКнига.Close(Ложь);
		КонецЕсли;
	Исключение
	КонецПопытки;
	СтрПараметров.ЦелеваяКнига = Неопределено;

	Попытка
		Если СтрПараметров.Ексель <> Неопределено Тогда
			СтрПараметров.Ексель.Quit();
		КонецЕсли;
	Исключение
	КонецПопытки;
	СтрПараметров.Ексель = Неопределено;

	Для Каждого ПутьВременногоФайла Из СтрПараметров.ВременныеФайлы Цикл
		Попытка
			УдалитьФайлы(ПутьВременногоФайла);
		Исключение
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
