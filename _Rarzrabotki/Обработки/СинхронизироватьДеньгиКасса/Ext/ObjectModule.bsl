// ===========================================================================
// Обробка: СинхронизироватьДеньгиКасса
// Призначення: Контроль синхронізації НАЛИЧНОЇ каси ERP ↔ Казна (BuhKazn)
// ===========================================================================
// Фаза 1: Порівняння ПОВНИХ залишків каси (РН.ДенежныеСредстваНаличные ↔ Казна РН.ДенежныеСредства Наличные)
//         Залишки ПОВНІ (як база/Ведомость/звіт А_СравнитьОстаткиДенегЕРПсКазной), сверка по Кон.остатку.
//         Виключення А_ВведенВЕРП/А_ОрганизацияБухгалтерия до залишків НЕ застосовуються (для каси флаг
//         ≠ «немає в Казні»: це ~20М доходу без корреспонденції; фільтр ламав би баланс у мінус).
//         Область: тільки каси, чия Касса.А_ОрганизацияБухгалтерия.А_ВБалансе = Істина.
// Фаза 2: Аналіз документів (через СоответствияОбъектовИнформационныхБаз, вузол КазначействоBASERP) —
//         ОСЬ ТУТ виключаються ПКО/РКО з А_ВведенВЕРП=Істина або заповненою А_ОрганизацияБухгалтерия.
// ВАЖЛИВО: ім'я плану обміну саме КазначействоBASERP (Казначе-Й-ство), однакове в ЕРП і Казні
// Фаза 3: Синхронізація (розпровести/провести в ЕРП, поставити на обмін в Казну)
// ===========================================================================
// Створено на основі обробки СинхронизироватьДеньги (ERP↔BuhBud, безнал) та
// звіту А_СравнитьОстаткиДенегЕРПсКазной (логіка сторони Казна).
// Усі запити перевірені на живій базі (Rule #-1), інваріант виключень підтверджено.
// ===========================================================================

#Область ОбщиеФункции

// Підключення до Казни (BuhKazn) через COM
//
// Повертає:
//  COMОбъект - підключення до бази BuhKazn, або Неопределено при помилці
//
Функция ПодключитьсяКKazna() Экспорт

	СтрокаПодключенияKazna = А_ПодключенияБазСервер.СтрокаПодключения("kazna");
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияKazna));
	Исключение
		Сообщить("Помилка підключення до BuhKazn: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Возврат V83;

КонецФункции

// Вузол обміну з Казною на стороні ЕРП (для пошуку відповідностей по правильному вузлу)
// УВАГА: фільтрувати строго по імені КазначействоBASERP — під маску «Казн» в ЕРП підпадають інші плани
//
Функция НайтиУзелКазнаЕРП()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ ПланОбмена.КазначействоBASERP ГДЕ НЕ ЭтотУзел";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

// ===========================================================================
// ФАЗА 1: Порівняння залишків/оборотів каси
// ===========================================================================

#Область Фаза1_ПорівнянняЗалишків

// Головна функція Фази 1 — порівняння каси ЕРП (фільтрованої) та Казни
//
Функция СравнитьОстатки() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ТаблицаРасхождений.Очистить();
	ТаблицаДокументов.Очистить();

	V83 = ПодключитьсяКKazna();
	Если V83 = Неопределено Тогда
		Возврат "Помилка підключення до Казни";
	КонецЕсли;

	Попытка
		КонецПериодаРасч = КонецДня(ОкончаниеПериода);

		// 1. Каса ЕРП (фільтрована: без ПКО/РКО з А_ВведенВЕРП/А_ОрганизацияБухгалтерия)
		ТЗ_ЕРП = ПолучитьОстаткиЕРП(НачалоПериода, КонецПериодаРасч);

		// 2. Каса Казни (РН.ДенежныеСредства, ВидДенежныхСредств = Наличные)
		ТЗ_Казна = ПолучитьОстаткиКазна(V83, НачалоПериода, КонецПериодаРасч);

		// 3. Злиття та пошук розбіжностей
		СвестиТаблицы(ТЗ_ЕРП, ТЗ_Казна);

	Исключение
		Сообщить("Помилка при порівнянні залишків каси: " + ОписаниеОшибки());
	КонецПопытки;

	V83 = Неопределено;

	Возврат "Оброблено. Розбіжностей: " + Строка(ТаблицаРасхождений.Количество());

КонецФункции

// ПОВНІ залишки/обороти каси ЕРП з РН.ДенежныеСредстваНаличные.ОстаткиИОбороты (БЕЗ виключень).
// Збігаються з базою (Ведомость по ДС / звіт А_СравнитьОстаткиДенегЕРПсКазной).
// Виключення А_ВведенВЕРП/А_ОрганизацияБухгалтерия тут НЕ застосовуються (вони ламають баланс,
// бо для каси флаг ≠ «немає в Казні») — вони працюють лише у Фазі 2 (список документів).
// Область: тільки каси, чия Касса.А_ОрганизацияБухгалтерия.А_ВБалансе = Істина.
//
Функция ПолучитьОстаткиЕРП(НачалоПериодаЗапр, КонецПериодаЗапр)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДС.Касса КАК Касса,
	|	ПРЕДСТАВЛЕНИЕ(ДС.Касса) КАК КассаПредставление,
	|	ДС.СуммаНачальныйОстаток КАК НачОстаток,
	|	ДС.СуммаПриход КАК Приход,
	|	ДС.СуммаРасход КАК Расход,
	|	ДС.СуммаКонечныйОстаток КАК КонОстаток
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваНаличные.ОстаткиИОбороты(
	|		&НачалоПериода, &КонецПериода, , ,
	|		Касса.А_ОрганизацияБухгалтерия.А_ВБалансе
	|		И (&БезФильтраКассы ИЛИ Касса = &Касса)) КАК ДС";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаЗапр);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаЗапр);
	Запрос.УстановитьПараметр("БезФильтраКассы", НЕ ЗначениеЗаполнено(ФильтрКасса));
	Запрос.УстановитьПараметр("Касса", ФильтрКасса);

	ТЗ_Запрос = Запрос.Выполнить().Выгрузить();

	Результат = ПустаяТаблицаОстатков();
	Для Каждого Стр Из ТЗ_Запрос Цикл
		НС = Результат.Добавить();
		НС.КассаUID            = Строка(Стр.Касса.УникальныйИдентификатор());
		НС.КассаПредставление  = Стр.КассаПредставление;
		НС.НачОстаток          = Стр.НачОстаток;
		НС.Приход              = Стр.Приход;
		НС.Расход              = Стр.Расход;
		НС.КонОстаток          = Стр.КонОстаток;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Залишки/обороти НАЛИЧНОЇ каси Казни через COM (РН.ДенежныеСредства, Наличные).
// Зіставлення каси Казна → ЕРП: по UUID (обмін зберігає UUID 1:1), fallback по Найменуванню.
// (Справочник.Кассы НЕ має реквізиту Код — НайтиПоКоду не застосовний.)
//
Функция ПолучитьОстаткиКазна(V83, НачалоПериодаЗапр, КонецПериодаЗапр)

	Запрос = V83.NewObject("Запрос");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДС.БанковскийСчетКасса КАК Касса,
	|	ДС.СуммаНачальныйОстаток КАК НачОстаток,
	|	ДС.СуммаПриход КАК Приход,
	|	ДС.СуммаРасход КАК Расход,
	|	ДС.СуммаКонечныйОстаток КАК КонОстаток
	|ИЗ
	|	РегистрНакопления.ДенежныеСредства.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , ,
	|		ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДенежныхСредств.Наличные)) КАК ДС
	|ГДЕ
	|	ДС.СуммаНачальныйОстаток <> 0
	|	ИЛИ ДС.СуммаПриход <> 0
	|	ИЛИ ДС.СуммаРасход <> 0
	|	ИЛИ ДС.СуммаКонечныйОстаток <> 0";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаЗапр);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаЗапр);

	Попытка
		ТЗ = Запрос.Выполнить().Выгрузить();
	Исключение
		Сообщить("Помилка запиту до Казни (каса): " + ОписаниеОшибки());
		Возврат ПустаяТаблицаОстатков();
	КонецПопытки;

	Результат = ПустаяТаблицаОстатков();

	Для Сч = 0 По ТЗ.Количество() - 1 Цикл
		СтрокаТЗ = ТЗ.Получить(Сч);

		НайденнаяКасса = Справочники.Кассы.ПустаяСсылка();
		Предст = "";

		// Зіставлення каси Казна → ЕРП (UUID 1:1; fallback по Найменуванню; Код у Кас немає)
		Попытка
			Если V83.ЗначениеЗаполнено(СтрокаТЗ.Касса) Тогда
				Предст = СокрЛП(V83.String(СтрокаТЗ.Касса.Наименование));

				НайденнаяКасса = А_Привилегированный.ПолучитьСправочникUID(
					"Кассы",
					V83.String(СтрокаТЗ.Касса.УникальныйИдентификатор()));

				Если ЗначениеЗаполнено(НайденнаяКасса) И НайденнаяКасса.ПолучитьОбъект() = Неопределено Тогда
					НайденнаяКасса = Справочники.Кассы.ПустаяСсылка();
				КонецЕсли;

				Если НЕ ЗначениеЗаполнено(НайденнаяКасса) И ЗначениеЗаполнено(Предст) Тогда
					НайденнаяКасса = Справочники.Кассы.НайтиПоНаименованию(Предст);
				КонецЕсли;
			КонецЕсли;
		Исключение
			// COM-помилка зіставлення — каса поза областю, пропустимо нижче
		КонецПопытки;

		// Фільтр області «В балансі»: тільки зіставлені каси з ОргБух.А_ВБалансе = Істина
		// (узгоджено з ЕРП-стороною, де той самий фільтр у віртуальній таблиці)
		Если НЕ ЗначениеЗаполнено(НайденнаяКасса) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ НайденнаяКасса.А_ОрганизацияБухгалтерия.А_ВБалансе Тогда
			Продолжить;
		КонецЕсли;

		НС = Результат.Добавить();
		НС.КассаUID           = Строка(НайденнаяКасса.УникальныйИдентификатор());
		НС.КассаПредставление = Предст;
		НС.НачОстаток         = СтрокаТЗ.НачОстаток;
		НС.Приход             = СтрокаТЗ.Приход;
		НС.Расход             = СтрокаТЗ.Расход;
		НС.КонОстаток         = СтрокаТЗ.КонОстаток;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Порожня таблиця залишків (єдина структура для ЕРП та Казни)
//
Функция ПустаяТаблицаОстатков()

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("КассаUID", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	Т.Колонки.Добавить("КассаПредставление", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Т.Колонки.Добавить("НачОстаток", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Т.Колонки.Добавить("Приход", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Т.Колонки.Добавить("Расход", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Т.Колонки.Добавить("КонОстаток", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Возврат Т;

КонецФункции

// Злиття таблиць ЕРП та Казна — FULL OUTER JOIN по UUID каси.
// Результат записується у ТЧ ТаблицаРасхождений (тільки рядки з розбіжностями).
//
Процедура СвестиТаблицы(ТЗ_ЕРП, ТЗ_Казна)

	ФильтрUID = "";
	Если ЗначениеЗаполнено(ФильтрКасса) Тогда
		ФильтрUID = ВРег(Строка(ФильтрКасса.УникальныйИдентификатор()));
	КонецЕсли;

	Ключи = Новый Соответствие;

	// ЕРП
	Для Каждого Стр Из ТЗ_ЕРП Цикл
		Ключ = СокрЛП(Стр.КассаUID);
		Запись = Ключи.Получить(Ключ);
		Если Запись = Неопределено Тогда
			Запись = НоваяЗаписьСвода(Стр.КассаПредставление, Ключ);
			Ключи.Вставить(Ключ, Запись);
		КонецЕсли;
		Запись.НачЕРП     = Запись.НачЕРП     + Стр.НачОстаток;
		Запись.ПриходЕРП  = Запись.ПриходЕРП  + Стр.Приход;
		Запись.РасходЕРП  = Запись.РасходЕРП  + Стр.Расход;
		Запись.ОстатокЕРП = Запись.ОстатокЕРП + Стр.КонОстаток;
	КонецЦикла;

	// Казна
	Для Каждого Стр Из ТЗ_Казна Цикл
		Ключ = СокрЛП(Стр.КассаUID);
		Если ФильтрUID <> "" И ВРег(Ключ) <> ФильтрUID Тогда
			Продолжить;
		КонецЕсли;
		Запись = Ключи.Получить(Ключ);
		Если Запись = Неопределено Тогда
			Предст = Стр.КассаПредставление;
			Если НЕ ЗначениеЗаполнено(Предст) Тогда
				Предст = "Казна: " + Ключ;
			КонецЕсли;
			Запись = НоваяЗаписьСвода(Предст, Ключ);
			Ключи.Вставить(Ключ, Запись);
		КонецЕсли;
		Запись.НачКазна     = Запись.НачКазна     + Стр.НачОстаток;
		Запись.ПриходКазна  = Запись.ПриходКазна  + Стр.Приход;
		Запись.РасходКазна  = Запись.РасходКазна  + Стр.Расход;
		Запись.ОстатокКазна = Запись.ОстатокКазна + Стр.КонОстаток;
	КонецЦикла;

	// Відбір розбіжностей + сортування за спаданням |Різниці|
	ТЗСорт = Новый ТаблицаЗначений;
	ТЗСорт.Колонки.Добавить("АбсРазница", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	ТЗСорт.Колонки.Добавить("Запись");

	Для Каждого КлючЗначение Из Ключи Цикл
		Запись = КлючЗначение.Значение;
		Разница = Запись.ОстатокЕРП - Запись.ОстатокКазна;
		// Розбіжність визначається по ЗАЛИШКАХ (Нач + Кон). Різниця в Прих/Расх при співпадінні
		// залишків — це внутрішні рухи ЕРП (А_ВведенВЕРП), що сальдуються в нуль: каса звірена.
		Если Окр(Разница, 2) = 0
			И Окр(Запись.НачЕРП - Запись.НачКазна, 2) = 0 Тогда
			Продолжить;
		КонецЕсли;
		НСорт = ТЗСорт.Добавить();
		НСорт.АбсРазница = Макс(Разница, -Разница);
		НСорт.Запись = Запись;
	КонецЦикла;

	ТЗСорт.Сортировать("АбсРазница Убыв");

	Для Каждого СтрСорт Из ТЗСорт Цикл
		Запись = СтрСорт.Запись;
		Разница = Запись.ОстатокЕРП - Запись.ОстатокКазна;

		НС = ТаблицаРасхождений.Добавить();
		// Відновити ссилку на касу з UUID
		Попытка
			Если ЗначениеЗаполнено(Запись.Ключ) Тогда
				КассаСсылка = Справочники.Кассы.ПолучитьСсылку(Новый УникальныйИдентификатор(Запись.Ключ));
				Если ЗначениеЗаполнено(КассаСсылка) И КассаСсылка.ПолучитьОбъект() <> Неопределено Тогда
					НС.Касса = КассаСсылка;
				Иначе
					НС.Касса = Запись.Представление;
				КонецЕсли;
			Иначе
				НС.Касса = Запись.Представление;
			КонецЕсли;
		Исключение
			НС.Касса = Запись.Представление;
		КонецПопытки;
		НС.НачОстатокЕРП    = Запись.НачЕРП;
		НС.НачОстатокКазна  = Запись.НачКазна;
		НС.ПриходЕРП        = Запись.ПриходЕРП;
		НС.ПриходКазна      = Запись.ПриходКазна;
		НС.РасходЕРП        = Запись.РасходЕРП;
		НС.РасходКазна      = Запись.РасходКазна;
		НС.ОстатокЕРП       = Запись.ОстатокЕРП;
		НС.ОстатокКазна     = Запись.ОстатокКазна;
		НС.Разница          = Разница;
		НС.Синхронизировать = Истина;
		НС.КассаUID         = Запись.Ключ;
	КонецЦикла;

КонецПроцедуры

// Нова порожня запис-структура свода
//
Функция НоваяЗаписьСвода(Представление, Ключ)
	Возврат Новый Структура(
		"Представление, Ключ, НачЕРП, ПриходЕРП, РасходЕРП, ОстатокЕРП, НачКазна, ПриходКазна, РасходКазна, ОстатокКазна",
		Представление, Ключ, 0, 0, 0, 0, 0, 0, 0, 0);
КонецФункции

#КонецОбласти

// ===========================================================================
// ФАЗА 2: Аналіз документів
// ===========================================================================

#Область Фаза2_АналізДокументів

// Головна функція Фази 2 — аналіз документів для вибраних розбіжностей
//
// Параметри:
//  ИндексСтроки - Число - якщо >= 0, аналізується ТІЛЬКИ цей рядок ТаблицаРасхождений
//
Функция АнализироватьДокументы(ИндексСтроки = -1) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ТаблицаДокументов.Очистить();

	СтрокиДляАнализа = Новый Массив;
	Если ИндексСтроки >= 0 Тогда
		Если ИндексСтроки >= ТаблицаРасхождений.Количество() Тогда
			Возврат "Невірний номер рядка";
		КонецЕсли;
		СтрокиДляАнализа.Добавить(ТаблицаРасхождений[ИндексСтроки]);
	Иначе
		Для Каждого СтрРасх Из ТаблицаРасхождений Цикл
			Если СтрРасх.Синхронизировать Тогда
				СтрокиДляАнализа.Добавить(СтрРасх);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если СтрокиДляАнализа.Количество() = 0 Тогда
		Возврат "Немає відмічених рядків розбіжностей";
	КонецЕсли;

	V83 = ПодключитьсяКKazna();
	Если V83 = Неопределено Тогда
		Возврат "Помилка підключення до Казни";
	КонецЕсли;

	УзелКазнаЕРП = НайтиУзелКазнаЕРП();
	// ГАРД: без вузла обміну JOIN не зматчить жодної відповідності → ВСІ документи
	// помилково отримали б дію «Розпровести в ЕРП». Не будуємо список на порожньому вузлі.
	Если УзелКазнаЕРП = Неопределено Тогда
		V83 = Неопределено;
		Возврат "ПОМИЛКА: не знайдено вузол обміну КазначействоBASERP в ЕРП";
	КонецЕсли;

	Для Каждого СтрРасх Из СтрокиДляАнализа Цикл
		Попытка
			АнализДокументов_ПоСчету(V83, СтрРасх, УзелКазнаЕРП);
		Исключение
			Сообщить("ПОМИЛКА аналізу " + Строка(СтрРасх.Касса) + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	// Ознака розбіжності — для відбору на формі
	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		СтрДок.ЕстьРасхождение = НЕ СтрНачинаетсяС(СтрДок.Статус, "ОК");
	КонецЦикла;

	// Підсумкова розбивка
	КолОК = 0;
	КолДій = 0;
	КолПитань = 0;
	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если НЕ СтрДок.ЕстьРасхождение Тогда
			КолОК = КолОК + 1;
		ИначеЕсли ЗначениеЗаполнено(СтрДок.Действие) Тогда
			КолДій = КолДій + 1;
		Иначе
			КолПитань = КолПитань + 1;
		КонецЕсли;
	КонецЦикла;
	Сообщить("Аналіз кас: " + СтрокиДляАнализа.Количество()
		+ ". Документів: " + ТаблицаДокументов.Количество()
		+ " (співпало: " + КолОК
		+ ", з діями: " + КолДій
		+ ", потребують рішення: " + КолПитань + ")");

	V83 = Неопределено;
	Возврат "Документів для синхронізації: " + Строка(ТаблицаДокументов.Количество());

КонецФункции

// Аналіз документів по одній касі
//
Процедура АнализДокументов_ПоСчету(V83, СтрРасх, УзелКазнаЕРП)

	Если НЕ ЗначениеЗаполнено(СтрРасх.КассаUID) Тогда
		Сообщить("Каса не зіставлена з ЕРП, аналіз неможливий: " + Строка(СтрРасх.Касса));
		Возврат;
	КонецЕсли;

	КонецПериодаРасч = КонецДня(ОкончаниеПериода);
	КассаСсылка = Справочники.Кассы.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрРасх.КассаUID));

	// Парна каса в Казні: UUID зберігається 1:1 → беремо по тому ж UUID
	КассаКазна = Неопределено;
	Попытка
		КассаКазнаПроба = V83.Справочники.Кассы.ПолучитьСсылку(
			V83.NewObject("УникальныйИдентификатор", СтрРасх.КассаUID));
		Если НЕ (КассаКазнаПроба.ПолучитьОбъект() = Неопределено) Тогда
			КассаКазна = КассаКазнаПроба;
		КонецЕсли;
	Исключение
		// Парну касу не знайдено — зворотна перевірка буде недоступна
	КонецПопытки;

	// Документи ЕРП по касі + ознаки виключення + відповідність у Казні
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Об.Регистратор КАК Регистратор,
	|	ПРЕДСТАВЛЕНИЕ(Об.Регистратор) КАК РегистраторПредст,
	|	Об.СуммаПриход КАК Приход,
	|	Об.СуммаРасход КАК Расход,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Об.Регистратор КАК Документ.ПриходныйКассовыйОрдер).А_ВведенВЕРП, ЛОЖЬ)
	|		ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Об.Регистратор КАК Документ.РасходныйКассовыйОрдер).А_ВведенВЕРП, ЛОЖЬ) КАК ВведенВЕРП,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Об.Регистратор КАК Документ.ПриходныйКассовыйОрдер).А_ОрганизацияБухгалтерия,
	|			ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|		ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Об.Регистратор КАК Документ.РасходныйКассовыйОрдер).А_ОрганизацияБухгалтерия,
	|			ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК ИзБухгалтерии,
	|	Соотв.УникальныйИдентификаторПриемника КАК UIDКазна,
	|	Соотв.ТипПриемника КАК ТипПриемника
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваНаличные.Обороты(&НачалоПериода, &КонецПериода, Авто,
	|		Касса = &Касса) КАК Об
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
	|	ПО Об.Регистратор = Соотв.УникальныйИдентификаторИсточника
	|		И Соотв.УзелИнформационнойБазы = &УзелКазнаЕРП";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаРасч);
	Запрос.УстановитьПараметр("Касса", КассаСсылка);
	Запрос.УстановитьПараметр("УзелКазнаЕРП", УзелКазнаЕРП);

	ТЗ_Док = Запрос.Выполнить().Выгрузить();

	// Обробка документів ЕРП
	ОбробитиДокументиЕРП(V83, ТЗ_Док, СтрРасх, КассаКазна);

	// Зворотна перевірка: документи Казни без ЕРП відповідника
	ПроверитьДокументыКазна(V83, ТЗ_Док, СтрРасх, КассаКазна, КассаСсылка, УзелКазнаЕРП);

КонецПроцедуры

// Обробка документів ЕРП: визначення дії по кожному
//
Процедура ОбробитиДокументиЕРП(V83, ТЗ_Док, СтрРасх, КассаКазна)

	Для Каждого СтрДок Из ТЗ_Док Цикл

		// ВИКЛЮЧЕННЯ: введені в ЕРП або з бухгалтерії — у Казні їх немає, не звіряємо
		Если СтрДок.ВведенВЕРП ИЛИ СтрДок.ИзБухгалтерии Тогда
			Продолжить;
		КонецЕсли;

		НС = ТаблицаДокументов.Добавить();
		НС.Касса            = СтрРасх.Касса;
		НС.ДокументЕРП      = СтрДок.Регистратор;
		НС.СуммаЕРП         = СтрДок.Приход - СтрДок.Расход;
		НС.UIDДокумента     = Строка(СтрДок.Регистратор.УникальныйИдентификатор());
		НС.ТипДокумента     = СтрДок.Регистратор.Метаданные().Имя;
		НС.Синхронизировать = Истина;

		Если ЗначениеЗаполнено(СтрДок.UIDКазна) Тогда
			НС.ЕстьСоответствие = Истина;
			НС.UIDДокументаКазна = СокрЛП(Строка(СтрДок.UIDКазна));

			ТипКазна = "";
			Попытка
				ТипКазна = СтрЗаменить(СокрЛП(Строка(СтрДок.ТипПриемника)), "ДокументСсылка.", "");
			Исключение
			КонецПопытки;

			Если ЗначениеЗаполнено(ТипКазна) Тогда
				ПроверитьДокументВКазна(V83, НС, ТипКазна, НС.UIDДокументаКазна, КассаКазна);
			Иначе
				НС.Действие = "";
				НС.Статус   = "Тип у Казні не визначено";
				НС.Синхронизировать = Ложь;
			КонецЕсли;
		Иначе
			// Немає відповідності у Казні
			ТипЕРП = СтрДок.Регистратор.Метаданные().Имя;
			Если ТипЕРП = "ПриходныйКассовыйОрдер" ИЛИ ТипЕРП = "РасходныйКассовыйОрдер" Тогда
				НС.ЕстьСоответствие = Ложь;
				НС.Действие = "Розпровести в ЕРП";
				НС.Статус   = "Немає в Казні (немає відповідності)";
			Иначе
				// Не касовий ордер (ВводОстатков, РасчетКурсовыхРазниц тощо) — рішення за бухгалтером
				НС.ЕстьСоответствие = Ложь;
				НС.Действие = "";
				НС.Статус   = "Тільки в ЕРП (" + ТипЕРП + ")";
				НС.Синхронизировать = Ложь;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Перевірка документа в Казні через COM + потік по касі
//
Процедура ПроверитьДокументВКазна(V83, НС, ТипКазна, UIDКазна, КассаКазна)

	Попытка
		СсылкаКазна = V83.Документы[ТипКазна].ПолучитьСсылку(
			V83.NewObject("УникальныйИдентификатор", UIDКазна));

		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст =
			"ВЫБРАТЬ Ссылка, Проведен, ПометкаУдаления, ПРЕДСТАВЛЕНИЕ(Ссылка) КАК Представление ИЗ Документ." + ТипКазна
			+ " ГДЕ Ссылка = &Ссылка";
		V83_Запрос.УстановитьПараметр("Ссылка", СсылкаКазна);

		V83_Рез = V83_Запрос.Выполнить().Выбрать();
		Если НЕ V83_Рез.Следующий() Тогда
			НС.Действие = "Розпровести в ЕРП";
			НС.Статус   = "Не знайдено в Казні";
			Возврат;
		КонецЕсли;

		НС.ДокументКазна = СокрЛП(V83.String(V83_Рез.Представление));

		Если V83_Рез.ПометкаУдаления Тогда
			НС.Действие = "Розпровести в ЕРП";
			НС.Статус   = "Видалений в Казні";
			Возврат;
		ИначеЕсли НЕ V83_Рез.Проведен Тогда
			НС.Действие = "На обмін в Казну";
			НС.Статус   = "Не проведений в Казні";
			НС.ТипДокумента = ТипКазна;
			Возврат;
		КонецЕсли;

		// Проведений у Казні — порівнюємо потік по касі
		Если КассаКазна <> Неопределено Тогда
			ПотокКазна = ПотокДокументаПоКассеКазна(V83, СсылкаКазна, КассаКазна);
			НС.СуммаКазна = ПотокКазна;
			Если Окр(НС.СуммаЕРП - ПотокКазна, 2) = 0 Тогда
				НС.Действие = "";
				НС.Статус   = "ОК";
				НС.Синхронизировать = Ложь;
			Иначе
				НС.Действие = "Переобмін";
				НС.Статус   = "Проведений, різниця в рухах (Казна = " + Строка(ПотокКазна) + ")";
				НС.ТипДокумента = ТипКазна;
			КонецЕсли;
		Иначе
			НС.Действие = "Переобмін";
			НС.Статус   = "Проведений у Казні (касу не зіставлено для звірки сум)";
			НС.ТипДокумента = ТипКазна;
		КонецЕсли;

	Исключение
		НС.Действие = "";
		НС.Статус   = "ПОМИЛКА COM: " + ОписаниеОшибки();
		НС.Синхронизировать = Ложь;
	КонецПопытки;

КонецПроцедуры

// Чистий потік документа Казни по конкретній касі: Приход - Расход (зі знаком)
//
Функция ПотокДокументаПоКассеКазна(V83, СсылкаКазна, КассаКазна)

	V83_Запрос = V83.NewObject("Запрос");
	V83_Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ) КАК Поток
	|ИЗ
	|	РегистрНакопления.ДенежныеСредства КАК Т
	|ГДЕ
	|	Т.Регистратор = &Регистратор
	|	И Т.БанковскийСчетКасса = &Касса
	|	И Т.ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДенежныхСредств.Наличные)
	|	И Т.Активность";
	V83_Запрос.УстановитьПараметр("Регистратор", СсылкаКазна);
	V83_Запрос.УстановитьПараметр("Касса", КассаКазна);

	Результат = 0;
	V83_Рез = V83_Запрос.Выполнить().Выбрать();
	Если V83_Рез.Следующий() И V83.ЗначениеЗаполнено(V83_Рез.Поток) Тогда
		Результат = V83_Рез.Поток;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Зворотна перевірка: документи Казни по касі без ЕРП відповідника
//
Процедура ПроверитьДокументыКазна(V83, ТЗ_ДокЕРП, СтрРасх, КассаКазна, КассаСсылкаЕРП, УзелКазнаЕРП)

	Если КассаКазна = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		// 1. UUID всіх ЕРП регістраторів (для відсіву вже покритих)
		масUIDерп = Новый Соответствие;
		Для Каждого СтрДок Из ТЗ_ДокЕРП Цикл
			масUIDерп.Вставить(ВРег(Строка(СтрДок.Регистратор.УникальныйИдентификатор())), Истина);
		КонецЦикла;

		// 2. Обороти Казни по касі з періодичністю Регистратор
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Регистратор КАК Регистратор,
		|	ПРЕДСТАВЛЕНИЕ(Т.Регистратор) КАК Представление,
		|	Т.СуммаПриход КАК Приход,
		|	Т.СуммаРасход КАК Расход
		|ИЗ
		|	РегистрНакопления.ДенежныеСредства.Обороты(&НачалоПериода, &КонецПериода, Регистратор,
		|		ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДенежныхСредств.Наличные)
		|		И БанковскийСчетКасса = &Касса) КАК Т";
		V83_Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		V83_Запрос.УстановитьПараметр("КонецПериода", КонецДня(ОкончаниеПериода));
		V83_Запрос.УстановитьПараметр("Касса", КассаКазна);

		V83_Рез = V83_Запрос.Выполнить().Выбрать();

		Пока V83_Рез.Следующий() Цикл
			Попытка
				Рег = V83_Рез.Регистратор;
				Если НЕ V83.ЗначениеЗаполнено(Рег) Тогда Продолжить; КонецЕсли;
				УИД = ВРег(V83.XMLСтрока(Рег.УникальныйИдентификатор()));
			Исключение
				Продолжить;
			КонецПопытки;

			// Вже є серед ЕРП регістраторів — пропустити
			Если масUIDерп[УИД] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ПриходБ = 0;
			РасходБ = 0;
			Попытка ПриходБ = V83_Рез.Приход; Исключение КонецПопытки;
			Попытка РасходБ = V83_Рез.Расход; Исключение КонецПопытки;
			Сума = ПриходБ - РасходБ;
			Если Окр(Сума, 2) = 0 Тогда Продолжить; КонецЕсли;

			ТипКазна = "";
			Попытка
				ТипКазна = V83.String(Рег.Метаданные().Имя);
			Исключение
			КонецПопытки;

			// Перевірити відповідність у ЕРП (документ може існувати, але бути непроведеним)
			ДокЕРПСсылка = Неопределено;
			UIDДокЕРП = "";
			СуммаЕРПРядка = 0;
			ДіяДок = "На обмін в Казну";
			СтатусДок = "Тільки в Казні (немає в ЕРП)";
			Попытка
				ЗапросСоотв = Новый Запрос;
				ЗапросСоотв.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Соотв.УникальныйИдентификаторИсточника КАК Источник
				|ИЗ
				|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
				|ГДЕ
				|	Соотв.УникальныйИдентификаторПриемника = &UIDПриемника
				|	И Соотв.УзелИнформационнойБазы = &УзелКазнаЕРП";
				ЗапросСоотв.УстановитьПараметр("UIDПриемника", УИД);
				ЗапросСоотв.УстановитьПараметр("УзелКазнаЕРП", УзелКазнаЕРП);
				РезСоотв = ЗапросСоотв.Выполнить().Выбрать();
				Если РезСоотв.Следующий() Тогда
					ДокЕРПСсылка = РезСоотв.Источник;
					UIDДокЕРП = Строка(РезСоотв.Источник.УникальныйИдентификатор());
					// Фін-агент: А_ПриходДенегОтФинАгента САМ касу не рухає — її рухають дочірні
					// ПКО/РКО (СоздатьПриходДенегПоФинАгенту). Чистий приход у касу = реквізит
					// Сумма («Сумма прихода») = СуммаДокумента − СуммаКомиссииФА = сумі Казни.
					Если ТипЗнч(ДокЕРПСсылка) = Тип("ДокументСсылка.А_ПриходДенегОтФинАгента") Тогда
						// ФАКТИЧНИЙ нетто-потік дочірніх ПКО/РКО по цій касі за період (А_ПриходДенегОтФинАгента
						// сам касу не рухає). Беремо РЕАЛЬНІ рухи, а НЕ декларовану «Сумма прихода»: вони можуть
						// розійтися (напр. N00023780: дочірнє РКО-комісія 0,88 замість 1,51 → нетто 5,63 ≠ Казна 5,00).
						СуммаЕРПРядка = ПотокДочернихФинАгента(ДокЕРПСсылка, КассаСсылкаЕРП);
						Если Окр(СуммаЕРПРядка - Сума, 2) = 0 Тогда
							ДіяДок = "";
							СтатусДок = "ОК (фінагент: дочірні ПКО/РКО)";
						Иначе
							ДіяДок = "";
							СтатусДок = "Фінагент: ЕРП нетто " + Формат(СуммаЕРПРядка, "ЧДЦ=2") + " <> Казна "
								+ Формат(Сума, "ЧДЦ=2") + " (перевірте дочірні ПКО/РКО)";
						КонецЕсли;
					ИначеЕсли РезСоотв.Источник.Проведен Тогда
						ДіяДок = "Переобмін";
						СтатусДок = "Проведений в ЕРП, немає рухів по касі";
					Иначе
						ДіяДок = "Провести в ЕРП";
						СтатусДок = "Не проведений в ЕРП";
					КонецЕсли;
				КонецЕсли;
			Исключение
				// Залишаємо дію "На обмін в Казну"
			КонецПопытки;

			// Без типу документа Казни дія «На обмін в Казну» гарантовано впаде — не пропонуємо її
			Если ДіяДок = "На обмін в Казну" И НЕ ЗначениеЗаполнено(ТипКазна) Тогда
				ДіяДок = "";
				СтатусДок = "Тільки в Казні (тип документа не визначено)";
			КонецЕсли;

			НС = ТаблицаДокументов.Добавить();
			НС.Касса             = СтрРасх.Касса;
			НС.ТипДокумента      = ТипКазна;
			НС.ДокументЕРП       = ?(ДокЕРПСсылка <> Неопределено, ДокЕРПСсылка, "");
			НС.ДокументКазна     = СокрЛП(V83.String(V83_Рез.Представление));
			НС.СуммаЕРП          = СуммаЕРПРядка;
			НС.СуммаКазна        = Сума;
			НС.UIDДокумента      = UIDДокЕРП;
			НС.UIDДокументаКазна = УИД;
			НС.ЕстьСоответствие  = ЗначениеЗаполнено(UIDДокЕРП);
			НС.Действие          = ДіяДок;
			НС.Статус            = СтатусДок;
			НС.Синхронизировать  = ЗначениеЗаполнено(ДіяДок);
		КонецЦикла;

	Исключение
		Сообщить("Помилка зворотньої перевірки Казни: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Фактичний нетто-потік готівки дочірніх ПКО/РКО фін-агента по касі за період.
// Дочірні документи (СоздатьПриходДенегПоФинАгенту) мають реквізит А_ПриходДенегОтФинАгента = батько:
// ПКО кладе брутто, РКО знімає комісію; нетто = реально проведений приход у касу (звіряємо з Казною).
//
Функция ПотокДочернихФинАгента(Родитель, КассаЕРП)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(ВЫБОР КОГДА Дв.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Дв.Сумма ИНАЧЕ -Дв.Сумма КОНЕЦ) КАК Нетто
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваНаличные КАК Дв
	|ГДЕ
	|	Дв.Период >= &НачалоПериода И Дв.Период <= &КонецПериода
	|	И Дв.Активность
	|	И Дв.Касса = &Касса
	|	И (ВЫРАЗИТЬ(Дв.Регистратор КАК Документ.ПриходныйКассовыйОрдер).А_ПриходДенегОтФинАгента = &Родитель
	|		ИЛИ ВЫРАЗИТЬ(Дв.Регистратор КАК Документ.РасходныйКассовыйОрдер).А_ПриходДенегОтФинАгента = &Родитель)";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ОкончаниеПериода));
	Запрос.УстановитьПараметр("Касса", КассаЕРП);
	Запрос.УстановитьПараметр("Родитель", Родитель);

	Результат = 0;
	Выб = Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() И ЗначениеЗаполнено(Выб.Нетто) Тогда
		Результат = Выб.Нетто;
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

// ===========================================================================
// ФАЗА 3: Синхронізація
// ===========================================================================

#Область Фаза3_Синхронізація

// Головна функція Фази 3 — виконання по відмічених рядках
//
Функция ВыполнитьСинхронизацию() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	V83 = Неопределено;
	УзелОбмена = Неопределено;
	УзелКазнаЕРП = НайтиУзелКазнаЕРП();
	Если УзелКазнаЕРП = Неопределено Тогда
		Возврат "ПОМИЛКА: не знайдено вузол обміну КазначействоBASERP в ЕРП";
	КонецЕсли;
	КількістьОброблених = 0;
	КількістьПомилок    = 0;

	Для Каждого СтрДок Из ТаблицаДокументов Цикл
		Если НЕ СтрДок.Синхронизировать Тогда
			Продолжить;
		КонецЕсли;
		ВыполнитьДействиеСтроки(СтрДок, V83, УзелОбмена, УзелКазнаЕРП, КількістьОброблених, КількістьПомилок);
	КонецЦикла;

	V83 = Неопределено;

	Возврат "Оброблено: " + КількістьОброблених + ", Помилок: " + КількістьПомилок;

КонецФункции

// Виконання дії ОДНОГО рядка (команда «Дія по рядку» на формі)
//
Функция ВыполнитьСинхронизациюСтроки(ИндексСтроки) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если ИндексСтроки < 0 ИЛИ ИндексСтроки >= ТаблицаДокументов.Количество() Тогда
		Возврат "Невірний номер рядка";
	КонецЕсли;

	СтрДок = ТаблицаДокументов[ИндексСтроки];
	Если НЕ ЗначениеЗаполнено(СтрДок.Действие) Тогда
		Возврат "Для рядка немає дії";
	КонецЕсли;

	V83 = Неопределено;
	УзелОбмена = Неопределено;
	УзелКазнаЕРП = НайтиУзелКазнаЕРП();
	Если УзелКазнаЕРП = Неопределено Тогда
		Возврат "ПОМИЛКА: не знайдено вузол обміну КазначействоBASERP в ЕРП";
	КонецЕсли;
	Оброблено = 0;
	Помилок = 0;

	ВыполнитьДействиеСтроки(СтрДок, V83, УзелОбмена, УзелКазнаЕРП, Оброблено, Помилок);

	V83 = Неопределено;

	Возврат СтрДок.Статус;

КонецФункции

// Диспетчер дії рядка. V83/УзелОбмена передаються за посиланням — ліниве підключення раз на пакет
//
Процедура ВыполнитьДействиеСтроки(СтрДок, V83, УзелОбмена, УзелКазнаЕРП, КількістьОброблених, КількістьПомилок)

	Если СтрДок.Действие = "Розпровести в ЕРП" Тогда
		Попытка
			РаспровестиВЕРП(СтрДок);
			УчестьРезультатСтроки(СтрДок, КількістьОброблених, КількістьПомилок);
		Исключение
			СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
			КількістьПомилок = КількістьПомилок + 1;
		КонецПопытки;

	ИначеЕсли СтрДок.Действие = "Провести в ЕРП" Тогда
		Попытка
			ПровестиВЕРП(СтрДок, УзелКазнаЕРП);
			УчестьРезультатСтроки(СтрДок, КількістьОброблених, КількістьПомилок);
		Исключение
			СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
			КількістьПомилок = КількістьПомилок + 1;
		КонецПопытки;

	ИначеЕсли СтрДок.Действие = "На обмін в Казну"
		ИЛИ СтрДок.Действие = "Переобмін" Тогда

		Если V83 = Неопределено Тогда
			V83 = ПодключитьсяКKazna();
			Если V83 = Неопределено Тогда
				СтрДок.Статус = "ПОМИЛКА: Немає підключення до Казни";
				КількістьПомилок = КількістьПомилок + 1;
				Возврат;
			КонецЕсли;
			УзелОбмена = НайтиУзелОбменаКазна(V83);
		КонецЕсли;

		Попытка
			ПоставитьНаОбменВКазну(V83, СтрДок, УзелОбмена);
			УчестьРезультатСтроки(СтрДок, КількістьОброблених, КількістьПомилок);
		Исключение
			СтрДок.Статус = "ПОМИЛКА: " + ОписаниеОшибки();
			КількістьПомилок = КількістьПомилок + 1;
		КонецПопытки;

	Иначе
		СтрДок.Статус = "ПОМИЛКА: невідома дія """ + СтрДок.Действие + """";
		КількістьПомилок = КількістьПомилок + 1;
	КонецЕсли;

КонецПроцедуры

// «М'які» помилки (Статус = ПОМИЛКА без винятку) — теж помилки
//
Процедура УчестьРезультатСтроки(СтрДок, КількістьОброблених, КількістьПомилок)

	Если СтрНачинаетсяС(СтрДок.Статус, "ПОМИЛКА") Тогда
		КількістьПомилок = КількістьПомилок + 1;
	Иначе
		КількістьОброблених = КількістьОброблених + 1;
	КонецЕсли;

КонецПроцедуры

// Пошук вузла обміну КазначействоBASERP у базі Казна (для реєстрації змін)
//
Функция НайтиУзелОбменаКазна(V83)

	Попытка
		V83_Запрос = V83.NewObject("Запрос");
		V83_Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ ПланОбмена.КазначействоBASERP ГДЕ НЕ ЭтотУзел";
		V83_Рез = V83_Запрос.Выполнить().Выбрать();
		Если V83_Рез.Следующий() Тогда
			Возврат V83_Рез.Ссылка;
		КонецЕсли;
	Исключение
		Сообщить("Не вдалося знайти вузол обміну в Казні: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Розпровести документ у ЕРП
//
Процедура РаспровестиВЕРП(СтрДок)

	UIDСтрока = СокрЛП(СтрДок.UIDДокумента);
	Если НЕ ЗначениеЗаполнено(UIDСтрока) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа";
		Возврат;
	КонецЕсли;

	ТипДок = СокрЛП(СтрДок.ТипДокумента);
	МенеджерДок = Документы[ТипДок];
	ДокСсылка = МенеджерДок.ПолучитьСсылку(Новый УникальныйИдентификатор(UIDСтрока));

	ДокОбъект = ДокСсылка.ПолучитьОбъект();
	Если ДокОбъект = Неопределено Тогда
		СтрДок.Статус = "ПОМИЛКА: Документ не знайдено в ЕРП";
		Возврат;
	КонецЕсли;

	ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	СтрДок.Статус = "Розпроведено в ЕРП";

КонецПроцедуры

// Провести непроведений документ у ЕРП (пошук через відповідність по UUID документа Казни)
//
Процедура ПровестиВЕРП(СтрДок, УзелКазнаЕРП)

	Если НЕ ЗначениеЗаполнено(СокрЛП(СтрДок.UIDДокументаКазна)) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа Казни";
		Возврат;
	КонецЕсли;

	Попытка
		ЗапросТип = Новый Запрос;
		ЗапросТип.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Соотв.УникальныйИдентификаторИсточника КАК Источник
		|ИЗ
		|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
		|ГДЕ
		|	Соотв.УникальныйИдентификаторПриемника = &UIDПриемника
		|	И Соотв.УзелИнформационнойБазы = &УзелКазнаЕРП";
		ЗапросТип.УстановитьПараметр("UIDПриемника", СокрЛП(СтрДок.UIDДокументаКазна));
		ЗапросТип.УстановитьПараметр("УзелКазнаЕРП", УзелКазнаЕРП);
		РезТип = ЗапросТип.Выполнить().Выбрать();
		Если РезТип.Следующий() Тогда
			ДокОбъект = РезТип.Источник.ПолучитьОбъект();
			Если ДокОбъект = Неопределено Тогда
				СтрДок.Статус = "ПОМИЛКА: Документ не знайдено в ЕРП";
				Возврат;
			КонецЕсли;
			Если ДокОбъект.Проведен Тогда
				СтрДок.Статус = "Вже проведений";
				Возврат;
			КонецЕсли;
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			СтрДок.Статус = "Проведено в ЕРП";
		Иначе
			СтрДок.Статус = "ПОМИЛКА: Відповідність не знайдена";
		КонецЕсли;
	Исключение
		СтрДок.Статус = "ПОМИЛКА проведення: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Поставити документ Казни на обмін (зареєструвати зміни на вузлі КазначействоBASERP)
//
Процедура ПоставитьНаОбменВКазну(V83, СтрДок, УзелОбмена)

	Если УзелОбмена = Неопределено Тогда
		СтрДок.Статус = "ПОМИЛКА: Вузол обміну не знайдено";
		Возврат;
	КонецЕсли;

	UIDСтрока = СокрЛП(СтрДок.UIDДокументаКазна);
	Если НЕ ЗначениеЗаполнено(UIDСтрока) Тогда
		СтрДок.Статус = "ПОМИЛКА: Немає UUID документа в Казні";
		Возврат;
	КонецЕсли;

	ТипКазна = СокрЛП(СтрДок.ТипДокумента);
	СсылкаКазна = V83.Документы[ТипКазна].ПолучитьСсылку(
		V83.NewObject("УникальныйИдентификатор", UIDСтрока));

	V83.ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, СсылкаКазна);
	СтрДок.Статус = "Зареєстровано на обмін в Казну";

КонецПроцедуры

#КонецОбласти
