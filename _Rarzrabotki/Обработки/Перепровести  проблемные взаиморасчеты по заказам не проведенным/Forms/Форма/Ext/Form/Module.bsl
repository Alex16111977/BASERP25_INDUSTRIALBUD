////////////////////////////////////////////////////////////////////////////////
// ОБРОБКА: Перепровести проблемні взаєморозрахунки по замовленням не проведеним
//
// Призначення:
//   Автоматичне виправлення проблем з взаєморозрахунками, коли проведені документи
//   посилаються на непроведені замовлення.
//
// Бізнес-логіка:
//   1. Пошук проблемних документів (проведених, що посилаються на непроведені замовлення)
//   2. Проведення непроведених замовлень (пропуск помічених на видалення)
//   3. Перепроведення залежних документів у хронологічному порядку
//
// Версія: 1.0
// Дата: 2024
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Ініціалізація атрибутів форми
	Объект.НачалоПериода = НачалоГода(ТекущаяДатаСеанса());
	Объект.ОкончаниеПериода = ТекущаяДатаСеанса();

	// Ініціалізація логу
	Лог = "";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Команда "Знайти проблемні" - аналіз без змін
&НаКлиенте
Процедура ЗнайтиПроблемні(Команда)

	ОчиститьСообщения();

	Если НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		СообщитьПользователю("Не вказана дата закінчення періоду!");
		Возврат;
	КонецЕсли;

	РезультатПоиска = ЗнайтиПроблемніНаСервере();

	Если РезультатПоиска.УспешноЗавершено Тогда
		СообщитьПользователю("Пошук завершено. Знайдено непроведених замовлень: " + РезультатПоиска.КількістьЗамовлень);
	Иначе
		СообщитьПользователю("Помилка пошуку: " + РезультатПоиска.ОписаниеОшибки);
	КонецЕсли;

КонецПроцедуры

// Команда "Виконати" - провести замовлення та перепровести залежні документи
&НаКлиенте
Процедура ВыполнитьОбработкуДокументов(Команда)

	ОчиститьСообщения();

	Если НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		СообщитьПользователю("Не вказана дата закінчення періоду!");
		Возврат;
	КонецЕсли;

	// Підтвердження дії
	ТекстВопроса = "Виконати проведення непроведених замовлень та перепроведення залежних документів?
	|
	|УВАГА: Ця операція змінює дані в базі!";

	ПоказатьВопрос(Новый ОписаниеОповещения("ВыполнитьОбработкуДокументовЗавершение", ЭтотОбъект),
		ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет, "Підтвердження");

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработкуДокументовЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		РезультатВыполнения = ВыполнитьНаСервере();

		Если РезультатВыполнения.УспешноЗавершено Тогда
			СообщитьПользователю("Обробка завершена успішно!");
			СообщитьПользователю("Проведено замовлень: " + РезультатВыполнения.ПроведеноЗамовлень);
			СообщитьПользователю("Перепроведено документів: " + РезультатВыполнения.ПерепроведеноДокументів);
			СообщитьПользователю("Помилок: " + РезультатВыполнения.Помилок);
		Иначе
			СообщитьПользователю("Обробка завершена з помилками. Деталі в логу.");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пошук проблемних документів на сервері
&НаСервере
Функция ЗнайтиПроблемніНаСервере()

	Результат = Новый Структура("УспешноЗавершено, КількістьЗамовлень, ОписаниеОшибки", Ложь, 0, "");

	Попытка
		ДодатиВЛог("========================================");
		ДодатиВЛог("ПОЧАТОК ПОШУКУ ПРОБЛЕМНИХ ДОКУМЕНТІВ");
		ДодатиВЛог("Період: " + Формат(Объект.НачалоПериода, "ДЛФ=D") + " - " + Формат(Объект.ОкончаниеПериода, "ДЛФ=D"));
		Если ЗначениеЗаполнено(Объект.Организация) Тогда
			ДодатиВЛог("Організація: " + Объект.Организация);
		Иначе
			ДодатиВЛог("Організація: Всі");
		КонецЕсли;
		ДодатиВЛог("========================================");

		// Очистка таблиці результатів
		ТаблицаРезультатов.Очистить();

		// Отримуємо непроведені замовлення
		ТаблицяЗамовлень = ПолучитьНепроведенныеЗаказы();

		// Заповнюємо таблицю результатів
		Для Каждого СтрокаЗамовлення Из ТаблицяЗамовлень Цикл
			НоваяСтрока = ТаблицаРезультатов.Добавить();
			НоваяСтрока.ТипЗамовлення = СтрокаЗамовлення.ТипЗамовлення;
			НоваяСтрока.НомерЗамовлення = СтрокаЗамовлення.НомерЗамовлення;
			НоваяСтрока.ДатаЗамовлення = СтрокаЗамовлення.ДатаЗамовлення;
			НоваяСтрока.Замовлення = СтрокаЗамовлення.Замовлення;
			НоваяСтрока.КількістьЗалежнихДокументів = СтрокаЗамовлення.КількістьЗалежних;
			НоваяСтрока.СтатусПроведення = "Очікує";
			НоваяСтрока.СтатусПерепроведення = "";
		КонецЦикла;

		ДодатиВЛог("Знайдено непроведених замовлень: " + ТаблицяЗамовлень.Количество());
		ДодатиВЛог("========================================");

		Результат.УспешноЗавершено = Истина;
		Результат.КількістьЗамовлень = ТаблицяЗамовлень.Количество();

	Исключение
		Результат.ОписаниеОшибки = ОписаниеОшибки();
		ДодатиВЛог("ПОМИЛКА: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Основна функція виконання обробки
&НаСервере
Функция ВыполнитьНаСервере()

	Результат = Новый Структура("УспешноЗавершено, ПроведеноЗамовлень, ПерепроведеноДокументів, Помилок", Ложь, 0, 0, 0);

	Попытка
		ДодатиВЛог("========================================");
		ДодатиВЛог("ПОЧАТОК ВИКОНАННЯ ОБРОБКИ");
		ДодатиВЛог("Час: " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"));
		ДодатиВЛог("========================================");

		// Крок 1: Якщо таблиця порожня - знаходимо проблемні документи
		Если ТаблицаРезультатов.Количество() = 0 Тогда
			РезультатПоиска = ЗнайтиПроблемніНаСервере();
			Если НЕ РезультатПоиска.УспешноЗавершено Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;

		// Крок 2: Проведення непроведених замовлень
		ДодатиВЛог("");
		ДодатиВЛог("=== КРОК 2: ПРОВЕДЕННЯ НЕПРОВЕДЕНИХ ЗАМОВЛЕНЬ ===");

		Для Каждого СтрокаТаблицы Из ТаблицаРезультатов Цикл

			ЗамовленняСсылка = СтрокаТаблицы.Замовлення;

			Если НЕ ЗначениеЗаполнено(ЗамовленняСсылка) Тогда
				Продолжить;
			КонецЕсли;

			// Перевірка ПометкаУдаления
			Если ЗамовленняСсылка.ПометкаУдаления Тогда
				ДодатиВЛог("  ПРОПУСК (помічено на видалення): " + ЗамовленняСсылка);
				СтрокаТаблицы.СтатусПроведення = "Пропущено (видалення)";
				Продолжить;
			КонецЕсли;

			// Перевірка чи вже проведено
			Если ЗамовленняСсылка.Проведен Тогда
				ДодатиВЛог("  ПРОПУСК (вже проведено): " + ЗамовленняСсылка);
				СтрокаТаблицы.СтатусПроведення = "Вже проведено";
				Продолжить;
			КонецЕсли;

			// Спроба провести замовлення
			Попытка
				НачатьТранзакцию();

				ЗамовленняОбъект = ЗамовленняСсылка.ПолучитьОбъект();
				ЗамовленняОбъект.Записать(РежимЗаписиДокумента.Проведение);

				ДодатиВЛог("  ПРОВЕДЕНО: " + ЗамовленняСсылка);
				СтрокаТаблицы.СтатусПроведення = "Успішно";
				Результат.ПроведеноЗамовлень = Результат.ПроведеноЗамовлень + 1;

				// Крок 3: Перепроведення залежних документів для цього замовлення
				КількістьПерепроведено = ПерепровестиЗалежніДокументи(ЗамовленняСсылка);
				Результат.ПерепроведеноДокументів = Результат.ПерепроведеноДокументів + КількістьПерепроведено;
				СтрокаТаблицы.СтатусПерепроведення = "Перепроведено: " + КількістьПерепроведено;

				ЗафиксироватьТранзакцию();

			Исключение
				ОтменитьТранзакцию();

				ТекстПомилки = ОписаниеОшибки();
				ДодатиВЛог("  ПОМИЛКА проведення: " + ЗамовленняСсылка + " - " + ТекстПомилки);
				СтрокаТаблицы.СтатусПроведення = "Помилка";
				Результат.Помилок = Результат.Помилок + 1;
			КонецПопытки;

		КонецЦикла;

		ДодатиВЛог("");
		ДодатиВЛог("========================================");
		ДодатиВЛог("ОБРОБКА ЗАВЕРШЕНА");
		ДодатиВЛог("Проведено замовлень: " + Результат.ПроведеноЗамовлень);
		ДодатиВЛог("Перепроведено документів: " + Результат.ПерепроведеноДокументів);
		ДодатиВЛог("Помилок: " + Результат.Помилок);
		ДодатиВЛог("========================================");

		Результат.УспешноЗавершено = Истина;

	Исключение
		Результат.ОписаниеОшибки = ОписаниеОшибки();
		ДодатиВЛог("КРИТИЧНА ПОМИЛКА: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Отримати список непроведених замовлень на які посилаються проведені документи
&НаСервере
Функция ПолучитьНепроведенныеЗаказы()

	ТаблицяРезультат = Новый ТаблицаЗначений;
	ТаблицяРезультат.Колонки.Добавить("Замовлення");
	ТаблицяРезультат.Колонки.Добавить("ТипЗамовлення", Новый ОписаниеТипов("Строка"));
	ТаблицяРезультат.Колонки.Добавить("НомерЗамовлення", Новый ОписаниеТипов("Строка"));
	ТаблицяРезультат.Колонки.Добавить("ДатаЗамовлення", Новый ОписаниеТипов("Дата"));
	ТаблицяРезультат.Колонки.Добавить("КількістьЗалежних", Новый ОписаниеТипов("Число"));

	// Основний запит для пошуку непроведених замовлень
	// Шукаємо через реквізити документів: ЗаказПоставщику, ЗаказКлиента, ЗаказДавальца, ЗаказПереработчику

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	""ЗаказПоставщику"" КАК ТипЗамовлення,
	|	Док.ЗаказПоставщику КАК Замовлення,
	|	Док.ЗаказПоставщику.Номер КАК НомерЗамовлення,
	|	Док.ЗаказПоставщику.Дата КАК ДатаЗамовлення
	|ПОМЕСТИТЬ ВТ_ВсеЗамовлення
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК Док
	|ГДЕ
	|	Док.Проведен = ИСТИНА
	|	И Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Док.ЗаказПоставщику <> ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)
	|	И Док.ЗаказПоставщику.Проведен = ЛОЖЬ
	|	И Док.ЗаказПоставщику.ПометкаУдаления = ЛОЖЬ
	|	И (&БезОтбораОрганизации ИЛИ Док.Организация = &Организация)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	""ЗаказКлиента"",
	|	Док.ЗаказКлиента,
	|	Док.ЗаказКлиента.Номер,
	|	Док.ЗаказКлиента.Дата
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Док
	|ГДЕ
	|	Док.Проведен = ИСТИНА
	|	И Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Док.ЗаказКлиента <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И Док.ЗаказКлиента.Проведен = ЛОЖЬ
	|	И Док.ЗаказКлиента.ПометкаУдаления = ЛОЖЬ
	|	И (&БезОтбораОрганизации ИЛИ Док.Организация = &Организация)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	""ЗаказПереработчику"",
	|	Док.ЗаказПереработчику,
	|	Док.ЗаказПереработчику.Номер,
	|	Док.ЗаказПереработчику.Дата
	|ИЗ
	|	Документ.ОтчетПереработчика КАК Док
	|ГДЕ
	|	Док.Проведен = ИСТИНА
	|	И Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Док.ЗаказПереработчику <> ЗНАЧЕНИЕ(Документ.ЗаказПереработчику.ПустаяСсылка)
	|	И Док.ЗаказПереработчику.Проведен = ЛОЖЬ
	|	И Док.ЗаказПереработчику.ПометкаУдаления = ЛОЖЬ
	|	И (&БезОтбораОрганизации ИЛИ Док.Организация = &Организация)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	""ЗаказДавальца"",
	|	Док.ЗаказДавальца,
	|	Док.ЗаказДавальца.Номер,
	|	Док.ЗаказДавальца.Дата
	|ИЗ
	|	Документ.ОтчетДавальцу КАК Док
	|ГДЕ
	|	Док.Проведен = ИСТИНА
	|	И Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Док.ЗаказДавальца <> ЗНАЧЕНИЕ(Документ.ЗаказДавальца.ПустаяСсылка)
	|	И Док.ЗаказДавальца.Проведен = ЛОЖЬ
	|	И Док.ЗаказДавальца.ПометкаУдаления = ЛОЖЬ
	|	И (&БезОтбораОрганизации ИЛИ Док.Организация = &Организация)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ТипЗамовлення КАК ТипЗамовлення,
	|	ВТ.Замовлення КАК Замовлення,
	|	ВТ.НомерЗамовлення КАК НомерЗамовлення,
	|	ВТ.ДатаЗамовлення КАК ДатаЗамовлення
	|ИЗ
	|	ВТ_ВсеЗамовлення КАК ВТ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ.ТипЗамовлення,
	|	ВТ.ДатаЗамовлення";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Объект.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Объект.ОкончаниеПериода));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("БезОтбораОрганизации", НЕ ЗначениеЗаполнено(Объект.Организация));

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл

		Если Выборка.Замовлення = Неопределено Или НЕ ЗначениеЗаполнено(Выборка.Замовлення) Тогда
			Продолжить;
		КонецЕсли;

		// Підраховуємо кількість залежних проведених документів
		КількістьЗалежних = ПолучитьКількістьЗалежнихДокументів(Выборка.Замовлення, Выборка.ТипЗамовлення);

		НоваСтрока = ТаблицяРезультат.Добавить();
		НоваСтрока.Замовлення = Выборка.Замовлення;
		НоваСтрока.ТипЗамовлення = Выборка.ТипЗамовлення;
		НоваСтрока.НомерЗамовлення = Выборка.НомерЗамовлення;
		НоваСтрока.ДатаЗамовлення = Выборка.ДатаЗамовлення;
		НоваСтрока.КількістьЗалежних = КількістьЗалежних;

		ДодатиВЛог("  Знайдено: " + Выборка.ТипЗамовлення + " №" + Выборка.НомерЗамовлення
			+ " від " + Формат(Выборка.ДатаЗамовлення, "ДЛФ=D")
			+ " (залежних документів: " + КількістьЗалежних + ")");

	КонецЦикла;

	Возврат ТаблицяРезультат;

КонецФункции

// Отримати кількість залежних проведених документів для замовлення
&НаСервере
Функция ПолучитьКількістьЗалежнихДокументів(ЗамовленняСсылка, ТипЗамовлення)

	Запрос = Новый Запрос;

	Если ТипЗамовлення = "ЗаказПоставщику" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Док.Ссылка) КАК Количество
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг КАК Док
		|ГДЕ
		|	Док.Проведен = ИСТИНА
		|	И Док.ЗаказПоставщику = &Замовлення";

	ИначеЕсли ТипЗамовлення = "ЗаказКлиента" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Док.Ссылка) КАК Количество
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Док
		|ГДЕ
		|	Док.Проведен = ИСТИНА
		|	И Док.ЗаказКлиента = &Замовлення";

	ИначеЕсли ТипЗамовлення = "ЗаказПереработчику" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Док.Ссылка) КАК Количество
		|ИЗ
		|	Документ.ОтчетПереработчика КАК Док
		|ГДЕ
		|	Док.Проведен = ИСТИНА
		|	И Док.ЗаказПереработчику = &Замовлення";

	ИначеЕсли ТипЗамовлення = "ЗаказДавальца" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Док.Ссылка) КАК Количество
		|ИЗ
		|	Документ.ОтчетДавальцу КАК Док
		|ГДЕ
		|	Док.Проведен = ИСТИНА
		|	И Док.ЗаказДавальца = &Замовлення";

	Иначе
		Возврат 0;
	КонецЕсли;

	Запрос.УстановитьПараметр("Замовлення", ЗамовленняСсылка);

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Перепровести залежні документи для замовлення
&НаСервере
Функция ПерепровестиЗалежніДокументи(ЗамовленняСсылка)

	КількістьПерепроведено = 0;

	// Визначаємо тип замовлення
	ТипЗамовлення = ЗамовленняСсылка.Метаданные().Имя;

	ДодатиВЛог("    Перепроведення залежних документів для: " + ЗамовленняСсылка);

	// Отримуємо список залежних документів (відсортованих по даті)
	ЗалежніДокументи = ПолучитьЗалежныеДокументы(ЗамовленняСсылка, ТипЗамовлення);

	Для Каждого СтрокаДок Из ЗалежніДокументи Цикл

		Попытка
			ДокОбъект = СтрокаДок.Документ.ПолучитьОбъект();
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);

			КількістьПерепроведено = КількістьПерепроведено + 1;
			ДодатиВЛог("      Перепроведено: " + СтрокаДок.Документ);

		Исключение
			ДодатиВЛог("      ПОМИЛКА перепроведення: " + СтрокаДок.Документ + " - " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	Возврат КількістьПерепроведено;

КонецФункции

// Отримати список залежних документів для замовлення
&НаСервере
Функция ПолучитьЗалежныеДокументы(ЗамовленняСсылка, ТипЗамовлення)

	ТаблицяДокументів = Новый ТаблицаЗначений;
	ТаблицяДокументів.Колонки.Добавить("Документ");
	ТаблицяДокументів.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));

	Запрос = Новый Запрос;

	Если ТипЗамовлення = "ЗаказПоставщику" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Документ,
		|	Док.Дата КАК Дата
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг КАК Док
		|ГДЕ
		|	Док.Проведен = ИСТИНА
		|	И Док.ЗаказПоставщику = &Замовлення
		|
		|УПОРЯДОЧИТЬ ПО
		|	Док.Дата,
		|	Док.МоментВремени";

	ИначеЕсли ТипЗамовлення = "ЗаказКлиента" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Документ,
		|	Док.Дата КАК Дата
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Док
		|ГДЕ
		|	Док.Проведен = ИСТИНА
		|	И Док.ЗаказКлиента = &Замовлення
		|
		|УПОРЯДОЧИТЬ ПО
		|	Док.Дата,
		|	Док.МоментВремени";

	ИначеЕсли ТипЗамовлення = "ЗаказПереработчику" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Документ,
		|	Док.Дата КАК Дата
		|ИЗ
		|	Документ.ОтчетПереработчика КАК Док
		|ГДЕ
		|	Док.Проведен = ИСТИНА
		|	И Док.ЗаказПереработчику = &Замовлення
		|
		|УПОРЯДОЧИТЬ ПО
		|	Док.Дата,
		|	Док.МоментВремени";

	ИначеЕсли ТипЗамовлення = "ЗаказДавальца" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Документ,
		|	Док.Дата КАК Дата
		|ИЗ
		|	Документ.ОтчетДавальцу КАК Док
		|ГДЕ
		|	Док.Проведен = ИСТИНА
		|	И Док.ЗаказДавальца = &Замовлення
		|
		|УПОРЯДОЧИТЬ ПО
		|	Док.Дата,
		|	Док.МоментВремени";

	Иначе
		Возврат ТаблицяДокументів;
	КонецЕсли;

	Запрос.УстановитьПараметр("Замовлення", ЗамовленняСсылка);

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();

	Пока Выборка.Следующий() Цикл
		НоваСтрока = ТаблицяДокументів.Добавить();
		НоваСтрока.Документ = Выборка.Документ;
		НоваСтрока.Дата = Выборка.Дата;
	КонецЦикла;

	Возврат ТаблицяДокументів;

КонецФункции

// Додати запис у лог
&НаСервере
Процедура ДодатиВЛог(Текст)

	Если ПустаяСтрока(Лог) Тогда
		Лог = Формат(ТекущаяДатаСеанса(), "ДЛФ=T") + " " + Текст;
	Иначе
		Лог = Лог + Символы.ПС + Формат(ТекущаяДатаСеанса(), "ДЛФ=T") + " " + Текст;
	КонецЕсли;

КонецПроцедуры

// Повідомити користувача
&НаКлиенте
Процедура СообщитьПользователю(Текст)

	Сообщить(Текст);

КонецПроцедуры

#КонецОбласти
