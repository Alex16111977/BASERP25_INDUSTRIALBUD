////////////////////////////////////////////////////////////////////////////////
// ОБРОБКА: Перепроведення проблемних взаєморозрахунків
// Версія: 1.0
// Дата: 2025-12-19
//
// ОПИС:
// Обробка для пошуку та виправлення двох типів проблем у документах:
// 1. Документи з непроведеними замовленнями (існуюча проблема)
// 2. Документи з проведеними замовленнями, але без рухів по регістрах (нова проблема)
//
// ПІДТРИМУВАНІ ДОКУМЕНТИ:
// - ПриобретениеТоваровУслуг (ЗаказПоставщику -> РасчетыСПоставщиками)
// - РеализацияТоваровУслуг (ЗаказКлиента -> РасчетыСКлиентами)
// - ОтчетПереработчика (ЗаказДавальца -> РасчетыСКлиентами)
// - ОтчетДавальцу (ЗаказПереработчику -> РасчетыСПоставщиками)
//
// ТИПИ ПРОБЛЕМ:
// - "Непроведене замовлення" - документ посилається на замовлення з Проведен = Ложь
// - "Відсутні рухи" - замовлення проведене, але в регістрі немає рухів з прив'язкою до нього
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Ініціалізація періоду - останній місяць
	НачалоПериода = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	КонецПериода = КонецДня(ТекущаяДата());

	// За замовчуванням обидва режими включені
	ПроверятьНепроведенныеЗаказы = Истина;
	ПроверятьОтсутствующиеДвижения = Истина;

	// Ініціалізація логу
	ДобавитьВЛог("Обробка запущена. Виберіть період та режими перевірки.");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиПроблемы(Команда)

	Если НЕ ПроверятьНепроведенныеЗаказы И НЕ ПроверятьОтсутствующиеДвижения Тогда
		ПоказатьПредупреждение(, "Виберіть хоча б один режим перевірки!");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(НачалоПериода) Или НЕ ЗначениеЗаполнено(КонецПериода) Тогда
		ПоказатьПредупреждение(, "Вкажіть період для пошуку!");
		Возврат;
	КонецЕсли;

	КоличествоНайденных = НайтиПроблемыНаСервере();

	Если КоличествоНайденных = 0 Тогда
		ПоказатьПредупреждение(, "Проблемних документів не знайдено!");
	Иначе
		ПоказатьПредупреждение(, "Знайдено проблемних документів: " + КоличествоНайденных);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПерепровестиВыбранные(Команда)

	КоличествоОтмеченных = 0;
	Для Каждого Строка Из ТаблицаДокументов Цикл
		Если Строка.Отметка Тогда
			КоличествоОтмеченных = КоличествоОтмеченных + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоОтмеченных = 0 Тогда
		ПоказатьПредупреждение(, "Відмітьте документи для перепроведення!");
		Возврат;
	КонецЕсли;

	КоличествоОбработанных = ПерепровестиДокументыНаСервере(Истина);

	ПоказатьПредупреждение(, "Перепроведено документів: " + КоличествоОбработанных + " з " + КоличествоОтмеченных);

КонецПроцедуры

&НаКлиенте
Процедура ПерепровестиВсе(Команда)

	Если ТаблицаДокументов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Спочатку виконайте пошук проблемних документів!");
		Возврат;
	КонецЕсли;

	КоличествоОбработанных = ПерепровестиДокументыНаСервере(Ложь);

	ПоказатьПредупреждение(, "Перепроведено документів: " + КоличествоОбработанных + " з " + ТаблицаДокументов.Количество());

КонецПроцедуры

#КонецОбласти

#Область ПоискПроблем

&НаСервере
Функция НайтиПроблемыНаСервере()

	ТаблицаДокументов.Очистить();
	ДобавитьВЛог("=== Початок пошуку ===");
	ДобавитьВЛог("Період: " + Формат(НачалоПериода, "ДЛФ=D") + " - " + Формат(КонецПериода, "ДЛФ=D"));

	КоличествоНайденных = 0;

	// Режим 1: Пошук непроведених замовлень
	Если ПроверятьНепроведенныеЗаказы Тогда
		ДобавитьВЛог("--- Режим 1: Пошук непроведених замовлень ---");
		КоличествоНайденных = КоличествоНайденных + НайтиНепроведенныеЗаказы();
	КонецЕсли;

	// Режим 2: Пошук документів з відсутніми рухами
	Если ПроверятьОтсутствующиеДвижения Тогда
		ДобавитьВЛог("--- Режим 2: Пошук відсутніх рухів ---");
		КоличествоНайденных = КоличествоНайденных + НайтиОтсутствующиеДвижения();
	КонецЕсли;

	ДобавитьВЛог("=== Пошук завершено ===");
	ДобавитьВЛог("Всього знайдено: " + КоличествоНайденных);

	Возврат КоличествоНайденных;

КонецФункции

// ============================================================================
// РЕЖИМ 1: Пошук непроведених замовлень
// ============================================================================
&НаСервере
Функция НайтиНепроведенныеЗаказы()

	КоличествоНайденных = 0;

	// Отримуємо конфігурацію типів документів для перевірки
	НастройкиДокументов = ПолучитьНастройкиДокументов();

	Для Каждого НастройкаДокумента Из НастройкиДокументов Цикл

		ИмяДокумента = НастройкаДокумента.ИмяДокумента;
		РеквизитЗаказа = НастройкаДокумента.РеквизитЗаказа;
		ТипЗаказа = НастройкаДокумента.ТипЗаказа;

		// Перевіряємо наявність документа в метаданих
		МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
		Если МетаданныеДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Перевіряємо наявність реквізиту замовлення
		РеквизитМетаданных = МетаданныеДокумента.Реквизиты.Найти(РеквизитЗаказа);
		Если РеквизитМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ТекстЗапроса =
				"ВЫБРАТЬ
				|	Документ.Ссылка КАК Документ,
				|	Документ.Дата КАК ДатаДокумента,
				|	Документ.Номер КАК НомерДокумента,
				|	Документ." + РеквизитЗаказа + " КАК Заказ,
				|	ЛОЖЬ КАК ЗаказПроведен
				|ИЗ
				|	Документ." + ИмяДокумента + " КАК Документ
				|ГДЕ
				|	Документ.Проведен = ИСТИНА
				|	И Документ." + РеквизитЗаказа + " <> ЗНАЧЕНИЕ(Документ." + ТипЗаказа + ".ПустаяСсылка)
				|	И Документ." + РеквизитЗаказа + ".Проведен = ЛОЖЬ
				|	И Документ.Дата МЕЖДУ &НачалоПериода И &КонецПериода";

			Запрос = Новый Запрос(ТекстЗапроса);
			Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
			Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));

			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();

			Пока Выборка.Следующий() Цикл

				НоваяСтрока = ТаблицаДокументов.Добавить();
				НоваяСтрока.Отметка = Истина;
				НоваяСтрока.ТипПроблемы = "Непроведене замовлення";
				НоваяСтрока.ТипДокумента = "Документ." + ИмяДокумента;
				НоваяСтрока.Документ = Выборка.Документ;
				НоваяСтрока.ДатаДокумента = Выборка.ДатаДокумента;
				НоваяСтрока.НомерДокумента = Выборка.НомерДокумента;
				НоваяСтрока.Заказ = Выборка.Заказ;
				НоваяСтрока.СтатусЗаказа = "Не проведено";
				НоваяСтрока.СтатусПерепроведения = "Очікує";

				КоличествоНайденных = КоличествоНайденных + 1;

			КонецЦикла;

			ДобавитьВЛог("  " + ИмяДокумента + ": знайдено " + Результат.Выгрузить().Количество() + " документів");

		Исключение
			ДобавитьВЛог("  ПОМИЛКА при обробці " + ИмяДокумента + ": " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	Возврат КоличествоНайденных;

КонецФункции

// ============================================================================
// РЕЖИМ 2: Пошук документів з відсутніми рухами по проведених замовленнях
// ============================================================================
&НаСервере
Функция НайтиОтсутствующиеДвижения()

	КоличествоНайденных = 0;

	// ПриобретениеТоваровУслуг -> РасчетыСПоставщиками
	КоличествоНайденных = КоличествоНайденных +
		НайтиДокументыБезДвиженийПоЗаказу(
			"ПриобретениеТоваровУслуг",
			"ЗаказПоставщику",
			"ЗаказПоставщику",
			"РасчетыСПоставщиками"
		);

	// РеализацияТоваровУслуг -> РасчетыСКлиентами
	КоличествоНайденных = КоличествоНайденных +
		НайтиДокументыБезДвиженийПоЗаказу(
			"РеализацияТоваровУслуг",
			"ЗаказКлиента",
			"ЗаказКлиента",
			"РасчетыСКлиентами"
		);

	// ОтчетПереработчика -> РасчетыСКлиентами
	КоличествоНайденных = КоличествоНайденных +
		НайтиДокументыБезДвиженийПоЗаказу(
			"ОтчетПереработчика",
			"ЗаказДавальца",
			"ЗаказНаПереработку",
			"РасчетыСКлиентами"
		);

	// ОтчетДавальцу -> РасчетыСПоставщиками
	КоличествоНайденных = КоличествоНайденных +
		НайтиДокументыБезДвиженийПоЗаказу(
			"ОтчетДавальцу",
			"ЗаказПереработчику",
			"ЗаказНаПереработку",
			"РасчетыСПоставщиками"
		);

	Возврат КоличествоНайденных;

КонецФункции

&НаСервере
Функция НайтиДокументыБезДвиженийПоЗаказу(ИмяДокумента, РеквизитЗаказа, ТипЗаказа, ИмяРегистра)

	КоличествоНайденных = 0;

	// Перевіряємо наявність документа в метаданих
	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаданныеДокумента = Неопределено Тогда
		ДобавитьВЛог("  " + ИмяДокумента + ": документ не знайдено в метаданих");
		Возврат 0;
	КонецЕсли;

	// Перевіряємо наявність реквізиту замовлення
	РеквизитМетаданных = МетаданныеДокумента.Реквизиты.Найти(РеквизитЗаказа);
	Если РеквизитМетаданных = Неопределено Тогда
		ДобавитьВЛог("  " + ИмяДокумента + ": реквізит " + РеквизитЗаказа + " не знайдено");
		Возврат 0;
	КонецЕсли;

	// Перевіряємо наявність регістра
	МетаданныеРегистра = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если МетаданныеРегистра = Неопределено Тогда
		ДобавитьВЛог("  " + ИмяДокумента + ": регістр " + ИмяРегистра + " не знайдено");
		Возврат 0;
	КонецЕсли;

	Попытка
		// Запит для пошуку документів з проведеними замовленнями, але без рухів
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	Документ.Ссылка КАК Документ,
			|	Документ.Дата КАК ДатаДокумента,
			|	Документ.Номер КАК НомерДокумента,
			|	Документ." + РеквизитЗаказа + " КАК Заказ
			|ИЗ
			|	Документ." + ИмяДокумента + " КАК Документ
			|ГДЕ
			|	Документ.Проведен = ИСТИНА
			|	И Документ." + РеквизитЗаказа + " <> ЗНАЧЕНИЕ(Документ." + ТипЗаказа + ".ПустаяСсылка)
			|	И Документ." + РеквизитЗаказа + ".Проведен = ИСТИНА
			|	И Документ.Дата МЕЖДУ &НачалоПериода И &КонецПериода
			|	И НЕ Документ.Ссылка В (
			|		ВЫБРАТЬ РАЗЛИЧНЫЕ
			|			Движения.Регистратор
			|		ИЗ
			|			РегистрНакопления." + ИмяРегистра + " КАК Движения
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
			|			ПО Движения.ОбъектРасчетов = ОбъектыРасчетов.Ссылка
			|		ГДЕ
			|			Движения.Регистратор ССЫЛКА Документ." + ИмяДокумента + "
			|			И ОбъектыРасчетов.Объект = Документ." + РеквизитЗаказа + "
			|	)";

		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));

		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();

		Пока Выборка.Следующий() Цикл

			// Перевіряємо, чи немає такого документа вже в таблиці
			УжеДобавлен = Ложь;
			Для Каждого СуществующаяСтрока Из ТаблицаДокументов Цикл
				Если СуществующаяСтрока.Документ = Выборка.Документ Тогда
					УжеДобавлен = Истина;
					// Доповнюємо тип проблеми
					Если СтрНайти(СуществующаяСтрока.ТипПроблемы, "Відсутні рухи") = 0 Тогда
						СуществующаяСтрока.ТипПроблемы = СуществующаяСтрока.ТипПроблемы + "; Відсутні рухи";
					КонецЕсли;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Если НЕ УжеДобавлен Тогда
				НоваяСтрока = ТаблицаДокументов.Добавить();
				НоваяСтрока.Отметка = Истина;
				НоваяСтрока.ТипПроблемы = "Відсутні рухи";
				НоваяСтрока.ТипДокумента = "Документ." + ИмяДокумента;
				НоваяСтрока.Документ = Выборка.Документ;
				НоваяСтрока.ДатаДокумента = Выборка.ДатаДокумента;
				НоваяСтрока.НомерДокумента = Выборка.НомерДокумента;
				НоваяСтрока.Заказ = Выборка.Заказ;
				НоваяСтрока.СтатусЗаказа = "Проведено";
				НоваяСтрока.СтатусПерепроведения = "Очікує";

				КоличествоНайденных = КоличествоНайденных + 1;
			КонецЕсли;

		КонецЦикла;

		ДобавитьВЛог("  " + ИмяДокумента + " (" + ИмяРегистра + "): знайдено " + Результат.Выгрузить().Количество() + " документів");

	Исключение
		ДобавитьВЛог("  ПОМИЛКА при обробці " + ИмяДокумента + ": " + ОписаниеОшибки());
	КонецПопытки;

	Возврат КоличествоНайденных;

КонецФункции

#КонецОбласти

#Область ПерепроведениеДокументов

&НаСервере
Функция ПерепровестиДокументыНаСервере(ТолькоОтмеченные)

	КоличествоОбработанных = 0;
	КоличествоУспешных = 0;
	КоличествоОшибок = 0;

	ДобавитьВЛог("=== Початок перепроведення ===");

	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл

		// Перевірка на відмітку
		Если ТолькоОтмеченные И НЕ СтрокаТаблицы.Отметка Тогда
			Продолжить;
		КонецЕсли;

		// Пропускаємо вже оброблені
		Если СтрокаТаблицы.СтатусПерепроведения = "Успішно" Тогда
			Продолжить;
		КонецЕсли;

		КоличествоОбработанных = КоличествоОбработанных + 1;

		Попытка
			// Отримуємо рухи ДО перепроведення для логування
			КількістьРухівДо = ПолучитьКоличествоДвижений(СтрокаТаблицы.Документ, СтрокаТаблицы.Заказ);

			// Перепроводимо документ
			ДокументОбъект = СтрокаТаблицы.Документ.ПолучитьОбъект();

			Если ДокументОбъект = Неопределено Тогда
				СтрокаТаблицы.СтатусПерепроведения = "Помилка";
				СтрокаТаблицы.Ошибка = "Документ не знайдено";
				КоличествоОшибок = КоличествоОшибок + 1;
				Продолжить;
			КонецЕсли;

			// Перепроводимо
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);

			// Отримуємо рухи ПІСЛЯ перепроведення
			КількістьРухівПісля = ПолучитьКоличествоДвижений(СтрокаТаблицы.Документ, СтрокаТаблицы.Заказ);

			СтрокаТаблицы.СтатусПерепроведения = "Успішно";
			СтрокаТаблицы.Ошибка = "";
			КоличествоУспешных = КоличествоУспешных + 1;

			ДобавитьВЛог("  + " + СтрокаТаблицы.Документ +
				" (рухів: " + КількістьРухівДо + " -> " + КількістьРухівПісля + ")");

		Исключение
			СтрокаТаблицы.СтатусПерепроведения = "Помилка";
			СтрокаТаблицы.Ошибка = ОписаниеОшибки();
			КоличествоОшибок = КоличествоОшибок + 1;

			ДобавитьВЛог("  - ПОМИЛКА: " + СтрокаТаблицы.Документ + " - " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	ДобавитьВЛог("=== Перепроведення завершено ===");
	ДобавитьВЛог("Успішно: " + КоличествоУспешных + ", Помилок: " + КоличествоОшибок);

	Возврат КоличествоУспешных;

КонецФункции

&НаСервере
Функция ПолучитьКоличествоДвижений(ДокументСсылка, ЗаказСсылка)

	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат 0;
	КонецЕсли;

	КоличествоДвижений = 0;

	// Визначаємо регістр по типу замовлення
	ИмяРегистра = "";

	Если ТипЗнч(ЗаказСсылка) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		ИмяРегистра = "РасчетыСПоставщиками";
	ИначеЕсли ТипЗнч(ЗаказСсылка) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		ИмяРегистра = "РасчетыСКлиентами";
	ИначеЕсли ТипЗнч(ЗаказСсылка) = Тип("ДокументСсылка.ЗаказНаПереработку") Тогда
		// Для ЗаказНаПереработку перевіряємо обидва регістри
		ИмяРегистра = "РасчетыСПоставщиками"; // або РасчетыСКлиентами
	Иначе
		Возврат 0;
	КонецЕсли;

	Попытка
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(*) КАК Количество
			|ИЗ
			|	РегистрНакопления." + ИмяРегистра + " КАК Движения
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
			|	ПО Движения.ОбъектРасчетов = ОбъектыРасчетов.Ссылка
			|ГДЕ
			|	Движения.Регистратор = &Регистратор
			|	И ОбъектыРасчетов.Объект = &Заказ";

		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Регистратор", ДокументСсылка);
		Запрос.УстановитьПараметр("Заказ", ЗаказСсылка);

		Результат = Запрос.Выполнить();
		Если НЕ Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Если Выборка.Следующий() Тогда
				КоличествоДвижений = Выборка.Количество;
			КонецЕсли;
		КонецЕсли;

	Исключение
		// Помилка - повертаємо 0
	КонецПопытки;

	Возврат КоличествоДвижений;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьНастройкиДокументов()

	// Масив налаштувань документів для перевірки
	НастройкиДокументов = Новый Массив;

	// ПриобретениеТоваровУслуг
	Настройка = Новый Структура;
	Настройка.Вставить("ИмяДокумента", "ПриобретениеТоваровУслуг");
	Настройка.Вставить("РеквизитЗаказа", "ЗаказПоставщику");
	Настройка.Вставить("ТипЗаказа", "ЗаказПоставщику");
	Настройка.Вставить("Регистр", "РасчетыСПоставщиками");
	НастройкиДокументов.Добавить(Настройка);

	// РеализацияТоваровУслуг
	Настройка = Новый Структура;
	Настройка.Вставить("ИмяДокумента", "РеализацияТоваровУслуг");
	Настройка.Вставить("РеквизитЗаказа", "ЗаказКлиента");
	Настройка.Вставить("ТипЗаказа", "ЗаказКлиента");
	Настройка.Вставить("Регистр", "РасчетыСКлиентами");
	НастройкиДокументов.Добавить(Настройка);

	// ОтчетПереработчика
	Настройка = Новый Структура;
	Настройка.Вставить("ИмяДокумента", "ОтчетПереработчика");
	Настройка.Вставить("РеквизитЗаказа", "ЗаказДавальца");
	Настройка.Вставить("ТипЗаказа", "ЗаказНаПереработку");
	Настройка.Вставить("Регистр", "РасчетыСКлиентами");
	НастройкиДокументов.Добавить(Настройка);

	// ОтчетДавальцу
	Настройка = Новый Структура;
	Настройка.Вставить("ИмяДокумента", "ОтчетДавальцу");
	Настройка.Вставить("РеквизитЗаказа", "ЗаказПереработчику");
	Настройка.Вставить("ТипЗаказа", "ЗаказНаПереработку");
	Настройка.Вставить("Регистр", "РасчетыСПоставщиками");
	НастройкиДокументов.Добавить(Настройка);

	Возврат НастройкиДокументов;

КонецФункции

&НаСервере
Процедура ДобавитьВЛог(Текст)

	ТекущийТекст = ЛогВыполнения.ПолучитьТекст();

	Если ЗначениеЗаполнено(ТекущийТекст) Тогда
		ТекущийТекст = ТекущийТекст + Символы.ПС;
	КонецЕсли;

	ТекущийТекст = ТекущийТекст + "[" + Формат(ТекущаяДата(), "ДФ=HH:mm:ss") + "] " + Текст;

	ЛогВыполнения.УстановитьТекст(ТекущийТекст);

КонецПроцедуры

#КонецОбласти
