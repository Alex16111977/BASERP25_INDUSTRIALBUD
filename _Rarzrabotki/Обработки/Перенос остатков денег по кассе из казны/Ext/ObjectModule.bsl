
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Процедура завантажує залишки грошових коштів по касах
// з казначейської бази BuhKazn через COM-підключення
//
Процедура ЗагрузитьОстатки() Экспорт

    // 1. Перевірка заповнення дати
    Если НЕ ЗначениеЗаполнено(ОкончаниеПериода) Тогда
        ВызватьИсключение "Не вказана дата залишків (Окончание периода)!";
    КонецЕсли;

    // 2. Параметри підключення до казначейської бази
    СтрокаПодключенияБух = А_ПодключенияБазСервер.СтрокаПодключения("BuhKazn");
    // 3. Створення COM-конектора
    V8 = Новый COMОбъект("V83.COMConnector");

    Попытка
        V83 = V8.Connect(СокрЛП(СтрокаПодключенияБух));
    Исключение
        ВызватьИсключение "Помилка підключення до бази BuhKazn: " + ОписаниеОшибки();
    КонецПопытки;

    // 4. Формування тексту запиту для отримання залишків по касах
    // Регістр накопичення ДСКасса, вимірювання Касса, ресурс Сумма
    ТекстЗапроса =
    "ВЫБРАТЬ
    |   ДСКассаОстатки.Касса.Наименование КАК КассаНаименование,
    |   ДСКассаОстатки.СуммаОстаток КАК Сумма
    |ИЗ
    |   РегистрНакопления.ДСКасса.Остатки(&ДатаОстатков) КАК ДСКассаОстатки
    |ГДЕ
    |   ДСКассаОстатки.СуммаОстаток > 0";

    // 5. Виконання запиту в казначейській базі
    Попытка
        Запрос = V83.NewObject("Запрос");
        Запрос.Текст = ТекстЗапроса;
        Запрос.УстановитьПараметр("ДатаОстатков", КонецДня(ОкончаниеПериода));

        РезультатЗапроса = Запрос.Выполнить();
        ТЗОстатки = РезультатЗапроса.Выгрузить();
    Исключение
        V83 = Неопределено;
        V8 = Неопределено;
        ВызватьИсключение "Помилка виконання запиту в базі BuhKazn: " + ОписаниеОшибки();
    КонецПопытки;

    // 6. Серіалізація таблиці значень для передачі через COM
    Попытка
        стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗОстатки);
    Исключение
        V83 = Неопределено;
        V8 = Неопределено;
        ВызватьИсключение "Помилка серіалізації даних: " + ОписаниеОшибки();
    КонецПопытки;

    // 7. Відключення від казначейської бази
    V83 = Неопределено;
    V8 = Неопределено;

    // 8. Десеріалізація таблиці значень в поточній базі
    ТаблицаОстатков = ЗначениеИзСтрокиВнутр(стр_ТЗ);

    // 9. Очистка табличної частини
    Кассы.Очистить();

    // 10. Отримання валют для перерахунку
    ВалютаРегл = Константы.ВалютаРегламентированногоУчета.Получить();
    ВалютаУпр = Константы.ВалютаУправленческогоУчета.Получить();
    ДатаКурса = КонецДня(ОкончаниеПериода);

    // 11. Заповнення табличної частини з зіставленням довідників
    СчетчикОшибок = 0;
    СчетчикЗагружено = 0;

    Для Каждого СтрокаТЗ Из ТаблицаОстатков Цикл

        КассаНаименование = СокрЛП(СтрокаТЗ.КассаНаименование);

        Если ПустаяСтрока(КассаНаименование) Тогда
            СчетчикОшибок = СчетчикОшибок + 1;
            Сообщить("Пропущено рядок: порожня назва каси");
            Продолжить;
        КонецЕсли;

        // 11.1. Пошук каси по найменуванню
        КассаERP = Справочники.Кассы.НайтиПоНаименованию(
            КассаНаименование, Истина);

        Если НЕ ЗначениеЗаполнено(КассаERP) Тогда
            СчетчикОшибок = СчетчикОшибок + 1;
            Сообщить("Не знайдено касу: " + КассаНаименование);
            Продолжить;
        КонецЕсли;

        // 11.2. Додавання рядка в табличну частину
        НоваяСтрока = Кассы.Добавить();
        НоваяСтрока.Касса = КассаERP;

        // Сума у валюті каси (для кас зазвичай національна валюта)
        НоваяСтрока.Сумма = СтрокаТЗ.Сумма;

        // 11.3. Для касс суми зазвичай в національній валюті
        // СуммаРегл = СуммаУпр = Сумма
        НоваяСтрока.СуммаРегл = СтрокаТЗ.Сумма;
        НоваяСтрока.СуммаУпр = СтрокаТЗ.Сумма;

        СчетчикЗагружено = СчетчикЗагружено + 1;

    КонецЦикла;

    // 12. Виведення статистики
    Сообщить("Завантажено: " + СчетчикЗагружено + " позицій");
    Если СчетчикОшибок > 0 Тогда
        Сообщить("Помилок зіставлення: " + СчетчикОшибок);
    КонецЕсли;

КонецПроцедуры

// Процедура створює документ "Ввод остатков" з хоз. операцією "Ввод остатков в кассах"
//
Процедура СоздатьДокументыВводаОстатков() Экспорт

    // 1. Перевірка заповнення обов'язкових реквізитів
    Если НЕ ЗначениеЗаполнено(Организация) Тогда
        ВызватьИсключение "Не вибрана організація!";
    КонецЕсли;

    Если Кассы.Количество() = 0 Тогда
        ВызватьИсключение "Таблична частина порожня! Спочатку завантажте залишки.";
    КонецЕсли;

    Если НЕ ЗначениеЗаполнено(ОкончаниеПериода) Тогда
        ВызватьИсключение "Не вказана дата залишків (Окончание периода)!";
    КонецЕсли;

    // 2. Параметри документа
    ДатаДок = КонецДня(ОкончаниеПериода);
    ХозОп = Перечисления.ХозяйственныеОперации.ВводОстатковВКассах;

    // 3. Пошук існуючого документа з такими параметрами
    ЗапросПроверки = Новый Запрос;
    ЗапросПроверки.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    ВводОстатков.Ссылка КАК Ссылка
    |ИЗ
    |    Документ.ВводОстатков КАК ВводОстатков
    |ГДЕ
    |    ВводОстатков.Организация = &Организация
    |    И ВводОстатков.Дата = &Дата
    |    И ВводОстатков.ХозяйственнаяОперация = &ХозяйственнаяОперация";

    ЗапросПроверки.УстановитьПараметр("Организация", Организация);
    ЗапросПроверки.УстановитьПараметр("Дата", ДатаДок);
    ЗапросПроверки.УстановитьПараметр("ХозяйственнаяОперация", ХозОп);

    РезультатПроверки = ЗапросПроверки.Выполнить();

    ЭтоОбновление = Ложь;

    Если НЕ РезультатПроверки.Пустой() Тогда
        // Документ існує - оновлюємо
        ВыборкаПроверки = РезультатПроверки.Выбрать();
        ВыборкаПроверки.Следующий();

        Док = ВыборкаПроверки.Ссылка.ПолучитьОбъект();
        Док.Кассы.Очистить();
        Док.Комментарий = "Оновлено обробкою переносу залишків грошей по касах " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");

        ЭтоОбновление = Истина;
    Иначе
        // Створюємо новий документ
        Док = Документы.ВводОстатков.СоздатьДокумент();
        Док.Комментарий = "Створено обробкою переносу залишків грошей по касах " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
    КонецЕсли;

    // 4. Заповнення шапки документа
    Док.Дата = ДатаДок;
    Док.Организация = Организация;
    Док.ХозяйственнаяОперация = ХозОп;

    // Прапорці відображення
    Док.ОтражатьВОперативномУчете = Истина;
    Док.ОтражатьВБУиНУ = Истина;
    Док.ОтражатьВУУ = Истина;

    // 5. Заповнення табличної частини Кассы
    Для Каждого СтрокаТЧ Из Кассы Цикл
        НС = Док.Кассы.Добавить();
        НС.Касса = СтрокаТЧ.Касса;
        НС.Сумма = СтрокаТЧ.Сумма;
        НС.СуммаРегл = СтрокаТЧ.СуммаРегл;
        НС.СуммаУпр = СтрокаТЧ.СуммаУпр;
    КонецЦикла;

    // 6. Запис та проведення документа
    Попытка
        Док.Записать(РежимЗаписиДокумента.Проведение);

        Если ЭтоОбновление Тогда
            Сообщить("Документ оновлено: " + Док.Ссылка);
        Иначе
            Сообщить("Документ створено: " + Док.Ссылка);
        КонецЕсли;

        Сообщить("Кількість рядків: " + Док.Кассы.Количество());

    Исключение
        Сообщить("ПОМИЛКА запису документа: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

#КонецЕсли
