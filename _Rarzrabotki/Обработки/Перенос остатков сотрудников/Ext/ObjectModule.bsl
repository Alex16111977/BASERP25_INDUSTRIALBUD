#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// ФАЗА 1. Грузит входящие остатки счетов 661/663 из BuhBud в ТЧ Задолженность (превью)
// и резолвит ссылки (ФизическоеЛицо/Сотрудник/Подразделение/Организация/ОргБух).
// Шапка будущего документа = упр.орг (А_ПолучитьОрганизациюУпр); ОргБух = реальная орг по ЕДРПОУ;
// Подразделение = ПодрОрг (Владелец=упр.орг) по .А_Подразделение = ОргБух.А_ПодразделениеЗарплатаБух.
Процедура ЗагрузитьИзBuhBud() Экспорт

	Если НЕ ЗначениеЗаполнено(ДатаОстатков) Тогда
		ВызватьИсключение "Не заполнена «Дата остатков»!";
	КонецЕсли;

	масЕДРПОУ = ПолучитьЕДРПОУОрганизацийВБалансе();
	Если масЕДРПОУ.Количество() = 0 Тогда
		ВызватьИсключение "Нет организаций с А_ВБалансе=Истина и заполненным КодПоЕДРПОУ!";
	КонецЕсли;

	ТЗОстатки = ПрочитатьОстаткиИзBuhBud(масЕДРПОУ);
	ЗаполнитьПревью(ТЗОстатки);

КонецПроцедуры

// ФАЗА 2. Один документ НачальнаяЗадолженностьПоЗарплате (шапка=упр.орг, Месяц),
// заполняемый из OK-строк превью, и проведение (-> А_ВзСС Форма1, период=Месяц).
Процедура СоздатьДокументы() Экспорт

	Если НЕ ЗначениеЗаполнено(ДатаОстатков) Тогда
		ВызватьИсключение "Не заполнена «Дата остатков»!";
	КонецЕсли;
	Если Задолженность.Количество() = 0 Тогда
		ВызватьИсключение "ТЧ Задолженность пуста — сначала «Заполнить из BuhBud»!";
	КонецЕсли;

	Месяц = НачалоМесяца(ДатаОстатков);
	УпрОрг = А_Привилегированный.А_ПолучитьОрганизациюУпр();

	ДокОбъект = НайтиИлиСоздатьДокумент(УпрОрг, Месяц);
	ДокОбъект.Дата         = ДатаОстатков;
	ДокОбъект.Месяц        = Месяц;
	ДокОбъект.Организация  = УпрОрг;
	ДокОбъект.Комментарий  = "Сформировано переносом 661/663 на " + Формат(ДатаОстатков, "ДЛФ=D");

	Добавлено = 0;
	Для Каждого СтрП Из Задолженность Цикл
		Если СтрП.Статус <> "OK" ИЛИ СтрП.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ДокОбъект.ЗадолженностьПоЗарплате.Добавить();
		НоваяСтрока.Сотрудник              = СтрП.Сотрудник;
		НоваяСтрока.Подразделение          = СтрП.ПодразделениеОрг;
		НоваяСтрока.ГруппаУчетаНачислений  = Справочники.ГруппыУчетаНачисленийИУдержаний.Зарплата;

		НоваяСтрока.Сумма                  = СтрП.Сумма;
		НоваяСтрока.ФормаPL                = Перечисления.А_ФормыPL.Форма1;
		НоваяСтрока.ОрганизацияБухгалтерия = СтрП.ОрганизацияБухгалтерия;
		Добавлено = Добавлено + 1;
	КонецЦикла;

	Если Добавлено = 0 Тогда
		Сообщить("Нет строк со статусом OK — документ не создан.");
		Возврат;
	КонецЕсли;

	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Сообщить("Документ " + Строка(ДокОбъект.Ссылка) + " проведён, строк: " + Добавлено);
	Исключение
		Сообщить("Ошибка проведения документа: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьЕДРПОУОрганизацийВБалансе()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пусто", "");
	Запрос.Текст =
	"ВЫБРАТЬ Орг.КодПоЕДРПОУ КАК ЕДРПОУ
	|ИЗ Справочник.Организации КАК Орг
	|ГДЕ Орг.А_ВБалансе = ИСТИНА И Орг.КодПоЕДРПОУ <> &Пусто";
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.ЕДРПОУ);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// COM к BuhBud, читает остатки 661/663, возвращает ТЗ ПРИМИТИВОВ (без COM-ссылок между базами).
Функция ПрочитатьОстаткиИзBuhBud(масЕДРПОУ)
	СтрокаПодключения = "Srvr=""SQLSERVER"";Ref=""BuhBud"";Usr=""cfo"";Pwd=""2442""";
	V8 = Новый COMОбъект("V83.COMConnector");
	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключения));
	Исключение
		ВызватьИсключение "Ошибка подключения к BuhBud: " + ОписаниеОшибки();
	КонецПопытки;

	масV83 = V83.NewObject("Массив");
	Для Каждого ЕДР Из масЕДРПОУ Цикл
		масV83.Добавить(ЕДР);
	КонецЦикла;

	Запрос = V83.NewObject("Запрос");
	Запрос.УстановитьПараметр("Дата", КонецДня(ДатаОстатков));
	Запрос.УстановитьПараметр("масЕДРПОУ", масV83);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Субконто1 КАК ФЛ,
	|	Остатки.СуммаОстатокКт КАК Сумма,
	|	Остатки.Организация.КодПоЕДРПОУ КАК ЕДРПОУ
	|ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Дата, Счет.Код В (""661"", ""663""), , ) КАК Остатки
	|ГДЕ Остатки.СуммаОстатокКт <> 0
	|	И Остатки.Организация.КодПоЕДРПОУ В (&масЕДРПОУ)";
	ВыборкаBuh = Запрос.Выполнить().Выбрать();

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("УИД");
	ТЗ.Колонки.Добавить("ДРФО");
	ТЗ.Колонки.Добавить("ИмяФЛ");
	ТЗ.Колонки.Добавить("ЕДРПОУ");
	ТЗ.Колонки.Добавить("Сумма");
	Пока ВыборкаBuh.Следующий() Цикл
		Стр = ТЗ.Добавить();
		Стр.УИД = V83.string(ВыборкаBuh.ФЛ.УникальныйИдентификатор());
		Попытка
			Стр.ДРФО = СокрЛП(ВыборкаBuh.ФЛ.КодПоДРФО);
		Исключение
			Стр.ДРФО = "";
		КонецПопытки;
		Стр.ИмяФЛ  = ВыборкаBuh.ФЛ.Наименование;
		Стр.ЕДРПОУ = ВыборкаBuh.ЕДРПОУ;
		Стр.Сумма  = Число(ВыборкаBuh.Сумма);
	КонецЦикла;

	V83 = Неопределено;
	V8 = Неопределено;
	Возврат ТЗ;
КонецФункции

// Свёртка 661+663 per (ФЛ, ОргБух) -> резолв -> ТЧ Задолженность + статусы.
Процедура ЗаполнитьПревью(ТЗОстатки)
	Задолженность.Очистить();
	ТЗОстатки.Свернуть("УИД, ДРФО, ИмяФЛ, ЕДРПОУ", "Сумма");
	УпрОрг = А_Привилегированный.А_ПолучитьОрганизациюУпр();

	Для Каждого СтрО Из ТЗОстатки Цикл
		НоваяСтрока = Задолженность.Добавить();
		НоваяСтрока.Счет       = "661+663";
		НоваяСтрока.ФизЛицоИмя = СтрО.ИмяФЛ;
		НоваяСтрока.Сумма      = СтрО.Сумма;

		ОргБух = Справочники.Организации.НайтиПоРеквизиту("КодПоЕДРПОУ", СтрО.ЕДРПОУ);
		НоваяСтрока.Организация            = УпрОрг;
		НоваяСтрока.ОрганизацияБухгалтерия = ОргБух;

		ФЛ = НайтиФизЛицо(СтрО.УИД, СтрО.ДРФО);
		НоваяСтрока.ФизическоеЛицо = ФЛ;
		Если НЕ ЗначениеЗаполнено(ФЛ) Тогда
			НоваяСтрока.Статус = "Нет ФЛ";
			Продолжить;
		КонецЕсли;

		НоваяСтрока.Сотрудник = НайтиСотрудника(ФЛ, ОргБух);
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Сотрудник) Тогда
			НоваяСтрока.Статус = "Нет сотрудника";
			Продолжить;
		КонецЕсли;

		НоваяСтрока.ПодразделениеОрг = НайтиПодразделение(ОргБух, УпрОрг);
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.ПодразделениеОрг) Тогда
			НоваяСтрока.Статус = "Нет подразделения";
			Продолжить;
		КонецЕсли;

		НоваяСтрока.Статус = "OK";
	КонецЦикла;

	ВывестиСтатистику();
КонецПроцедуры

Функция НайтиФизЛицо(УИД, ДРФО)
	Попытка
		ФЛСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
		Если ФЛСсылка.ПолучитьОбъект() <> Неопределено Тогда
			Возврат ФЛСсылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если ЗначениеЗаполнено(ДРФО) Тогда
		Канд = Справочники.ФизическиеЛица.НайтиПоРеквизиту("КодПоДРФО", ДРФО);
		Если ЗначениеЗаполнено(Канд) Тогда
			Возврат Канд;
		КонецЕсли;
	КонецЕсли;
	Возврат Справочники.ФизическиеЛица.ПустаяСсылка();
КонецФункции

// ФизЛицо -> Сотрудник (приоритет ГоловнаяОрганизация = ОргБух, иначе первый по Коду).
Функция НайтиСотрудника(ФЛ, ОргБух)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФЛ", ФЛ);
	Запрос.УстановитьПараметр("Орг", ОргБух);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 С.Ссылка КАК Ссылка
	|ИЗ Справочник.Сотрудники КАК С
	|ГДЕ С.ФизическоеЛицо = &ФЛ И НЕ С.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО ВЫБОР КОГДА С.ГоловнаяОрганизация = &Орг ТОГДА 0 ИНАЧЕ 1 КОНЕЦ, С.Код";
	Рез = Запрос.Выполнить();
	Если Рез.Пустой() Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	Выборка = Рез.Выбрать(); Выборка.Следующий();
	Возврат Выборка.Ссылка;
КонецФункции

// Реверс СтрПредпр -> ПодрОрг: ПодразделенияОрганизаций (Владелец=УпрОрг)
// с .А_Подразделение = ОргБух.А_ПодразделениеЗарплатаБух.
Функция НайтиПодразделение(ОргБух, УпрОрг)
	Если НЕ ЗначениеЗаполнено(ОргБух) Тогда
		Возврат Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
	КонецЕсли;
	СтрПредпр = ОргБух.А_ПодразделениеЗарплатаБух;
	Если НЕ ЗначениеЗаполнено(СтрПредпр) Тогда
		Возврат Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Влад", УпрОрг);
	Запрос.УстановитьПараметр("СтрПредпр", СтрПредпр);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 ПодрОрг.Ссылка КАК Ссылка
	|ИЗ Справочник.ПодразделенияОрганизаций КАК ПодрОрг
	|ГДЕ ПодрОрг.Владелец = &Влад
	|	И ПодрОрг.А_Подразделение = &СтрПредпр
	|	И НЕ ПодрОрг.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО ПодрОрг.Код";
	Рез = Запрос.Выполнить();
	Если Рез.Пустой() Тогда
		Возврат Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
	КонецЕсли;
	Выборка = Рез.Выбрать(); Выборка.Следующий();
	Возврат Выборка.Ссылка;
КонецФункции

// Find-or-create по (Организация, Месяц). Если найден — распровести + очистить ТЧ.
Функция НайтиИлиСоздатьДокумент(Орг, Месяц)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Орг", Орг);
	Запрос.УстановитьПараметр("Месяц", Месяц);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка, Д.Проведен КАК Проведен
	|ИЗ Документ.НачальнаяЗадолженностьПоЗарплате КАК Д
	|ГДЕ Д.Организация = &Орг И Д.Месяц = &Месяц";
	Рез = Запрос.Выполнить();
	Если НЕ Рез.Пустой() Тогда
		Выборка = Рез.Выбрать(); Выборка.Следующий();
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Если Выборка.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		ДокОбъект.ЗадолженностьПоЗарплате.Очистить();
		Возврат ДокОбъект;
	КонецЕсли;
	Возврат Документы.НачальнаяЗадолженностьПоЗарплате.СоздатьДокумент();
КонецФункции

Процедура ВывестиСтатистику()
	Всего = Задолженность.Количество();
	ОК = 0; НетФЛ = 0; НетСотр = 0; НетПодр = 0; СуммаНеОК = 0;
	Для Каждого Стр Из Задолженность Цикл
		Если Стр.Статус = "OK" Тогда
			ОК = ОК + 1;
		ИначеЕсли Стр.Статус = "Нет ФЛ" Тогда
			НетФЛ = НетФЛ + 1; СуммаНеОК = СуммаНеОК + Стр.Сумма;
		ИначеЕсли Стр.Статус = "Нет сотрудника" Тогда
			НетСотр = НетСотр + 1; СуммаНеОК = СуммаНеОК + Стр.Сумма;
		ИначеЕсли Стр.Статус = "Нет подразделения" Тогда
			НетПодр = НетПодр + 1; СуммаНеОК = СуммаНеОК + Стр.Сумма;
		КонецЕсли;
	КонецЦикла;
	Сообщить("Загружено строк: " + Всего + " | OK: " + ОК
		+ " | Нет ФЛ: " + НетФЛ + " | Нет сотрудника: " + НетСотр
		+ " | Нет подразделения: " + НетПодр + " | Σ несопоставленных: " + Формат(СуммаНеОК, "ЧДЦ=2"));
КонецПроцедуры

#КонецОбласти

#КонецЕсли
