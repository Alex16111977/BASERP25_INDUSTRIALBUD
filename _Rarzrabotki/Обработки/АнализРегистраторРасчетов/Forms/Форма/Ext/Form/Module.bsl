
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДатаНачала = НачалоМесяца(ТекущаяДата()) - 86400 * 120;
	ДатаОкончания = КонецДня(ТекущаяДата());
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура АнализРегистраторРасчетов(Команда)

	Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Укажите период!");
		Возврат;
	КонецЕсли;

	КолДублей = ЗаполнитьДублиНаСервере();

	Если КолДублей = 0 Тогда
		Сообщить("Задвоенные РегистраторыРасчетов не найдены за указанный период.");
	Иначе
		Сообщить("Найдено " + Строка(КолДублей) + " записей с задвоенными РегистраторамиРасчетов.");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыНаСервере

&НаСервере
Функция ЗаполнитьДублиНаСервере()

	Объект.ТабличнаяЧастьДублей.Очистить();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	// Универсальный критерий реального дубля:
	// Дубль = >1 РегистраторРасчетов с ОДИНАКОВЫМ НАБОРОМ:
	//   (ДокументРегистратор + ХозОперация + ОбъектРасчетов + РасчетныйДокумент)
	//
	// НЕ дубли (легитимные множественные регистраторы):
	//   - Разные ХозОперации (Перенос аванса + Возврат ДС)
	//   - Разные ОбъектыРасчетов (Взаимозачёт по нескольким заказам)
	//   - Разные РасчетныеДокументы (зачёт из разных источников)
	//
	// 1) Найти комбинации с >1 регистратором (поставщики)
	// 2) То же для клиентов
	// 3) Детализация: каждый дублирующий РегистраторРасчетов отдельной строкой
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.ДокументРегистратор КАК Источник,
	|	Р.ХозяйственнаяОперация КАК ХозОперация,
	|	Р.ОбъектРасчетов КАК ОбъектРасчетов,
	|	Р.РасчетныйДокумент КАК РасчетныйДокумент
	|ПОМЕСТИТЬ ВтДублиПоставщики
	|ИЗ
	|	РегистрНакопления.РасчетыСПоставщикамиПоСрокам КАК Р
	|ГДЕ
	|	Р.Период >= &ДатаНачала
	|	И Р.Период <= &ДатаОкончания
	|	И Р.Регистратор ССЫЛКА Документ.РегистраторРасчетов
	|СГРУППИРОВАТЬ ПО
	|	Р.ДокументРегистратор,
	|	Р.ХозяйственнаяОперация,
	|	Р.ОбъектРасчетов,
	|	Р.РасчетныйДокумент
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Р.Регистратор) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Р.ДокументРегистратор КАК Источник,
	|	Р.ХозяйственнаяОперация КАК ХозОперация,
	|	Р.ОбъектРасчетов КАК ОбъектРасчетов,
	|	Р.РасчетныйДокумент КАК РасчетныйДокумент
	|ПОМЕСТИТЬ ВтДублиКлиенты
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоСрокам КАК Р
	|ГДЕ
	|	Р.Период >= &ДатаНачала
	|	И Р.Период <= &ДатаОкончания
	|	И Р.Регистратор ССЫЛКА Документ.РегистраторРасчетов
	|СГРУППИРОВАТЬ ПО
	|	Р.ДокументРегистратор,
	|	Р.ХозяйственнаяОперация,
	|	Р.ОбъектРасчетов,
	|	Р.РасчетныйДокумент
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Р.Регистратор) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Р.ДокументРегистратор КАК Источник,
	|	ВЫРАЗИТЬ(Р.Регистратор КАК Документ.РегистраторРасчетов) КАК ДокРегистраторРасчетов
	|ИЗ
	|	РегистрНакопления.РасчетыСПоставщикамиПоСрокам КАК Р
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтДублиПоставщики КАК Д
	|		ПО Р.ДокументРегистратор = Д.Источник
	|		И Р.ХозяйственнаяОперация = Д.ХозОперация
	|		И Р.ОбъектРасчетов = Д.ОбъектРасчетов
	|		И Р.РасчетныйДокумент = Д.РасчетныйДокумент
	|ГДЕ
	|	Р.Регистратор ССЫЛКА Документ.РегистраторРасчетов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Р.ДокументРегистратор,
	|	ВЫРАЗИТЬ(Р.Регистратор КАК Документ.РегистраторРасчетов)
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоСрокам КАК Р
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтДублиКлиенты КАК Д
	|		ПО Р.ДокументРегистратор = Д.Источник
	|		И Р.ХозяйственнаяОперация = Д.ХозОперация
	|		И Р.ОбъектРасчетов = Д.ОбъектРасчетов
	|		И Р.РасчетныйДокумент = Д.РасчетныйДокумент
	|ГДЕ
	|	Р.Регистратор ССЫЛКА Документ.РегистраторРасчетов
	|
	|УПОРЯДОЧИТЬ ПО
	|	Источник";

	РезультатыПакета = Запрос.ВыполнитьПакет();
	Выборка = РезультатыПакета[2].Выбрать();

	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ТабличнаяЧастьДублей.Добавить();
		НоваяСтрока.Источник               = Выборка.Источник;
		НоваяСтрока.ДокРегистраторРасчетов = Выборка.ДокРегистраторРасчетов;
	КонецЦикла;

	Возврат Объект.ТабличнаяЧастьДублей.Количество();

КонецФункции

#КонецОбласти
