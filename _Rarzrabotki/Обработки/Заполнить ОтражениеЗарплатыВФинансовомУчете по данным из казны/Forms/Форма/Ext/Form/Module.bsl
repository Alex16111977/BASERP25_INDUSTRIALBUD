////////////////////////////////////////////////////////////////////////////////
// Заполнение ОтражениеЗарплатыВФинансовомУчете по данным из Казны
// Модуль формы внешней обработки
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Инициализация при открытии формы
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Команда 1: Загрузить распределение из Казны (заполняет А_РаспределениеКазна)
&НаКлиенте
Процедура Заполнить_ОтражениеЗарплатыВФинансовомУчете_ПоКазне(Команда)

	ОчиститьСообщения();

	Если Не ЗначениеЗаполнено(Объект.Док_ОтражениеЗарплатыВФинансовомУчете) Тогда
		ПоказатьПредупреждение(, "Не указан документ ""Отражение зарплаты в финансовом учете""!");
		Возврат;
	КонецЕсли;

	Результат = Заполнить_ОтражениеЗарплатыВФинансовомУчете_ПоКазнеНаСервере();

	Если Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Сообщение);
	Иначе
		ПоказатьПредупреждение(, "Ошибка: " + Результат.Сообщение);
	КонецЕсли;

КонецПроцедуры

// Команда 2: Заполнить начисления из Казны (заполняет НачисленнаяЗарплатаИВзносы и НачисленнаяЗарплатаИВзносыПоФизлицам)
&НаКлиенте
Процедура Заполнить_НачисленияИзКазны(Команда)

	ОчиститьСообщения();

	Если Не ЗначениеЗаполнено(Объект.Док_ОтражениеЗарплатыВФинансовомУчете) Тогда
		ПоказатьПредупреждение(, "Не указан документ ""Отражение зарплаты в финансовом учете""!");
		Возврат;
	КонецЕсли;

	Результат = Заполнить_НачисленияИзКазныНаСервере();

	Если Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Сообщение);
	Иначе
		ПоказатьПредупреждение(, "Ошибка: " + Результат.Сообщение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Серверная процедура загрузки распределения из Казны
&НаСервере
Функция Заполнить_ОтражениеЗарплатыВФинансовомУчете_ПоКазнеНаСервере()

	Результат = Новый Структура("Успех, Сообщение", Ложь, "");

	Попытка

		ДокОбъект = Объект.Док_ОтражениеЗарплатыВФинансовомУчете.ПолучитьОбъект();

		Если ДокОбъект = Неопределено Тогда
			Результат.Сообщение = "Не удалось получить объект документа!";
			Возврат Результат;
		КонецЕсли;

		// Очищаем таблицу А_РаспределениеКазна
		ДокОбъект.А_РаспределениеКазна.Очистить();

		// Получаем данные из Казны
		ДанныеКазны = ПолучитьДанныеРаспределенияИзКазны(ДокОбъект);

		// Заполняем табличную часть
		Для Каждого СтрокаДанных Из ДанныеКазны Цикл
			НоваяСтрока = ДокОбъект.А_РаспределениеКазна.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
		КонецЦикла;

		ДокОбъект.Записать();

		Результат.Успех = Истина;
		Результат.Сообщение = СтрШаблон("Загружено %1 строк в А_РаспределениеКазна.",
			ДокОбъект.А_РаспределениеКазна.Количество());

	Исключение
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Серверная процедура заполнения начислений из данных Казны
// ДОРАБОТАНО: Раздельная обработка начислений и удержаний
// НАЧИСЛЕНИЯ: из А_РаспределениеКазна (где А_ЭтоУдержание = ЛОЖЬ)
// УДЕРЖАНИЯ ИЗ КАЗНЫ (А_ЭтоУдержание = ИСТИНА): создают 2 записи:
//   1. НачисленнаяЗарплатаИВзносы - с замененным СпособОтражения на парный (начисление)
//   2. НачисленныйНДФЛ - с исходной статьей удержания как ГруппаУчетаНачислений
// УДЕРЖАНИЯ: из А_РаспределениеНалоги
&НаСервере
Функция Заполнить_НачисленияИзКазныНаСервере()

	Результат = Новый Структура("Успех, Сообщение", Ложь, "");

	Попытка

		ДокОбъект = Объект.Док_ОтражениеЗарплатыВФинансовомУчете.ПолучитьОбъект();

		Если ДокОбъект = Неопределено Тогда
			Результат.Сообщение = "Не удалось получить объект документа!";
			Возврат Результат;
		КонецЕсли;

		// Проверяем наличие данных в источниках
		Если ДокОбъект.А_РаспределениеКазна.Количество() = 0 Тогда
			Результат.Сообщение = "Таблица А_РаспределениеКазна пуста! Сначала загрузите распределение из Казны.";
			Возврат Результат;
		КонецЕсли;

		// Очищаем целевые таблицы
		ДокОбъект.НачисленнаяЗарплатаИВзносы.Очистить();
		ДокОбъект.НачисленнаяЗарплатаИВзносыПоФизлицам.Очистить();
		ДокОбъект.НачисленныйНДФЛ.Очистить();  // ДОБАВЛЕНО: очищаем таблицу НДФЛ

		// Получаем способы отражения и признак "Это удержание" для статей ДДС
		СоответствиеСпособовОтражения = ПолучитьСпособыОтраженияПоСтатьямДДС(ДокОбъект.А_РаспределениеКазна);

		// ДОБАВЛЕНО: Получаем соответствие Удержание → Начисление для способов отражения
		СоответствиеУдержанийНачислениям = ПолучитьСоответствиеУдержанийНачислениям();

		// Счетчики для результата
		КоличествоНачислений = 0;
		КоличествоУдержаний = 0;
		КоличествоУдержанийИзКазны = 0;  // ДОБАВЛЕНО: счетчик удержаний из Казны

		// 1. НАЧИСЛЕНИЯ: заполняем из А_РаспределениеКазна (где А_ЭтоУдержание = ЛОЖЬ)
		КоличествоНачислений = ЗаполнитьНачисленияИзКазны(ДокОбъект, СоответствиеСпособовОтражения);

		// 2. УДЕРЖАНИЯ ИЗ КАЗНЫ: заполняем из А_РаспределениеКазна (где А_ЭтоУдержание = ИСТИНА)
		// Создает 2 записи: в НачисленнаяЗарплатаИВзносыПоФизлицам и в НачисленныйНДФЛ
		КоличествоУдержанийИзКазны = ЗаполнитьУдержанияИзКазны(ДокОбъект, СоответствиеСпособовОтражения, СоответствиеУдержанийНачислениям);

		// 3. УДЕРЖАНИЯ ИЗ НАЛОГОВ: заполняем из А_РаспределениеНалоги
		КоличествоУдержаний = ЗаполнитьУдержанияИзНалогов(ДокОбъект);

		// 4. КОНТРОЛЬНАЯ СВЕРКА по сотрудникам
		ТекстРасхождений = ВыполнитьКонтрольнуюСверку(ДокОбъект, СоответствиеСпособовОтражения);

		// 5. Формируем сводную таблицу НачисленнаяЗарплатаИВзносы
		ОбновитьСводнуюТаблицуНачислений(ДокОбъект);

		// Записываем документ
		ДокОбъект.Записать();

		Результат.Успех = Истина;
		Результат.Сообщение = СтрШаблон(
			"Заполнено: Начисления - %1 строк, Удержания из Казны - %2 строк, Удержания из Налогов - %3 строк.
			|НачисленнаяЗарплатаИВзносы - %4 строк, НачисленнаяЗарплатаИВзносыПоФизлицам - %5 строк, НачисленныйНДФЛ - %6 строк.%7",
			КоличествоНачислений,
			КоличествоУдержанийИзКазны,
			КоличествоУдержаний,
			ДокОбъект.НачисленнаяЗарплатаИВзносы.Количество(),
			ДокОбъект.НачисленнаяЗарплатаИВзносыПоФизлицам.Количество(),
			ДокОбъект.НачисленныйНДФЛ.Количество(),
			?(ПустаяСтрока(ТекстРасхождений), "", Символы.ПС + Символы.ПС + ТекстРасхождений));

	Исключение
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Получение данных распределения из системы Казна
&НаСервере
Функция ПолучитьДанныеРаспределенияИзКазны(ДокОбъект)

	// TODO: Здесь должен быть запрос к данным Казны
	// Пока возвращаем пустую таблицу
	// Логика получения данных из Казны должна быть реализована отдельно

	ДанныеКазны = Новый ТаблицаЗначений;
	ДанныеКазны.Колонки.Добавить("Организация");
	ДанныеКазны.Колонки.Добавить("Сотрудник");
	ДанныеКазны.Колонки.Добавить("СтатьяДвиженияДенежныхСредств");
	ДанныеКазны.Колонки.Добавить("Подразделение");
	ДанныеКазны.Колонки.Добавить("НаправленияДеятельности");
	ДанныеКазны.Колонки.Добавить("Сумма");

	Возврат ДанныеКазны;

КонецФункции

// Получение способов отражения и признака "Это удержание" по статьям ДДС
// Возвращает соответствие: СтатьяДДС -> Структура("СпособОтражения", "ЭтоУдержание")
&НаСервере
Функция ПолучитьСпособыОтраженияПоСтатьямДДС(ТаблицаКазны)

	Результат = Новый Соответствие;

	// Собираем уникальные статьи ДДС
	МассивСтатейДДС = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаКазны Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.СтатьяДвиженияДенежныхСредств)
			И МассивСтатейДДС.Найти(СтрокаТаблицы.СтатьяДвиженияДенежныхСредств) = Неопределено Тогда
			МассивСтатейДДС.Добавить(СтрокаТаблицы.СтатьяДвиженияДенежныхСредств);
		КонецЕсли;
	КонецЦикла;

	Если МассивСтатейДДС.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Запрос для получения способов отражения
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтатьиДДС.Ссылка КАК СтатьяДДС,
	|	СтатьиДДС.А_СпособОтраженияЗарплатыВБухучете КАК СпособОтражения,
	|	ЕСТЬNULL(СтатьиДДС.А_СпособОтраженияЗарплатыВБухучете.А_ЭтоУдержание, ЛОЖЬ) КАК ЭтоУдержание
	|ИЗ
	|	Справочник.СтатьиДвиженияДенежныхСредств КАК СтатьиДДС
	|ГДЕ
	|	СтатьиДДС.Ссылка В(&МассивСтатейДДС)";

	Запрос.УстановитьПараметр("МассивСтатейДДС", МассивСтатейДДС);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.СтатьяДДС, Новый Структура("СпособОтражения, ЭтоУдержание",
			Выборка.СпособОтражения, Выборка.ЭтоУдержание));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Получение соответствия Удержание → Начисление для способов отражения зарплаты
// ИСПРАВЛЕНО: Явная таблица соответствий по ТОЧНЫМ наименованиям из базы
// Возвращает Соответствие: СпособОтраженияУдержание -> СпособОтраженияНачисление
&НаСервере
Функция ПолучитьСоответствиеУдержанийНачислениям()

	Результат = Новый Соответствие;

	// Явная таблица соответствий Удержание → Начисление
	// ВАЖНО: наименования берутся из базы данных, а не выдумываются!
	ТаблицаСоответствий = Новый ТаблицаЗначений;
	ТаблицаСоответствий.Колонки.Добавить("Удержание");
	ТаблицаСоответствий.Колонки.Добавить("Начисление");

	// Заполняем пары по ТОЧНЫМ наименованиям из базы
	ДобавитьПаруСоответствия(ТаблицаСоответствий, "Удержание с админ зарплату", "Зарплата управленческого персонала");
	ДобавитьПаруСоответствия(ТаблицаСоответствий, "Удержание с зарплаты ИТР", "Зарплата ИТР");
	ДобавитьПаруСоответствия(ТаблицаСоответствий, "Удержание с зарплаты механизатров", "Зарплата механизаторов");
	ДобавитьПаруСоответствия(ТаблицаСоответствий, "Удержание с зарплаты производственного персонала", "Зарплата производственного персонала");
	ДобавитьПаруСоответствия(ТаблицаСоответствий, "Удержание с зарплаты кладовщика", "Зарплата кладовщика");
	ДобавитьПаруСоответствия(ТаблицаСоответствий, "Удержание с зарплаты РМ", "Зарплата PM");  // ВАЖНО: В базе "РМ", а начисление "PM"!

	// Получаем ссылки на способы отражения по наименованиям
	Для Каждого Строка Из ТаблицаСоответствий Цикл
		СпособУдержания = Справочники.СпособыОтраженияЗарплатыВБухУчете.НайтиПоНаименованию(Строка.Удержание, Истина);
		СпособНачисления = Справочники.СпособыОтраженияЗарплатыВБухУчете.НайтиПоНаименованию(Строка.Начисление, Истина);
		Если ЗначениеЗаполнено(СпособУдержания) И ЗначениеЗаполнено(СпособНачисления) Тогда
			Результат.Вставить(СпособУдержания, СпособНачисления);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Вспомогательная процедура добавления пары в таблицу соответствий
&НаСервере
Процедура ДобавитьПаруСоответствия(ТаблицаСоответствий, НаименованиеУдержания, НаименованиеНачисления)
	НоваяСтрока = ТаблицаСоответствий.Добавить();
	НоваяСтрока.Удержание = НаименованиеУдержания;
	НоваяСтрока.Начисление = НаименованиеНачисления;
КонецПроцедуры

// 2. УДЕРЖАНИЯ ИЗ КАЗНЫ: заполнение из А_РаспределениеКазна (где А_ЭтоУдержание = ИСТИНА)
// Создает ДВЕ записи для каждого удержания:
// 1. В НачисленнаяЗарплатаИВзносыПоФизлицам (как начисление) - с замененным СпособОтражения на парный
// 2. В НачисленныйНДФЛ (как удержание) - с исходной статьей удержания как ГруппаУчетаНачислений
&НаСервере
Функция ЗаполнитьУдержанияИзКазны(ДокОбъект, СоответствиеСпособовОтражения, СоответствиеУдержанийНачислениям)

	КоличествоДобавленных = 0;

	// Вид операции "Начислено" для первой записи (НачисленнаяЗарплатаИВзносыПоФизлицам)
	ВидОперацииНачислено = Перечисления.ВидыОперацийПоЗарплате.НачисленоДоход;

	// Вид операции "НДФЛ" для второй записи (НачисленныйНДФЛ)
	ВидОперацииНДФЛ = Перечисления.ВидыОперацийПоЗарплате.НДФЛ;

	// Тип налога НДФЛ
	ТипНалогаНДФЛ = Перечисления.ТипыНалогов.НДФЛ;

	// Получаем физические лица для сотрудников
	СоответствиеФизЛиц = ПолучитьФизическиеЛицаСотрудников(ДокОбъект.А_РаспределениеКазна);

	// Получаем группу учета начислений для зарплаты (661)
	ГруппаУчетаЗарплата = ПолучитьГруппуУчетаЗарплата();

	// Обрабатываем строки А_РаспределениеКазна где А_ЭтоУдержание = ИСТИНА
	Для Каждого СтрокаКазны Из ДокОбъект.А_РаспределениеКазна Цикл

		Если СтрокаКазны.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Получаем данные способа отражения для статьи ДДС
		ДанныеСтатьи = СоответствиеСпособовОтражения[СтрокаКазны.СтатьяДвиженияДенежныхСредств];

		// Обрабатываем ТОЛЬКО строки где А_ЭтоУдержание = ИСТИНА
		Если ДанныеСтатьи = Неопределено ИЛИ Не ДанныеСтатьи.ЭтоУдержание Тогда
			Продолжить;
		КонецЕсли;

		ИсходныйСпособОтражения = ДанныеСтатьи.СпособОтражения;

		// Получаем парный способ отражения (начисление вместо удержания)
		ПарныйСпособОтражения = СоответствиеУдержанийНачислениям[ИсходныйСпособОтражения];

		// Получаем физическое лицо
		ФизическоеЛицо = Неопределено;
		Если СоответствиеФизЛиц[СтрокаКазны.Сотрудник] <> Неопределено Тогда
			ФизическоеЛицо = СоответствиеФизЛиц[СтрокаКазны.Сотрудник];
		КонецЕсли;

		// =====================================
		// ЗАПИСЬ 1: НачисленнаяЗарплатаИВзносыПоФизлицам (как начисление)
		// Д-т 92 К-т 661 - начислено
		// СпособОтражения = ПАРНЫЙ (начисление)
		// =====================================
		НоваяСтрока1 = ДокОбъект.НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();

		НоваяСтрока1.Организация = ДокОбъект.Организация;
		НоваяСтрока1.ПодразделениеПредприятия = СтрокаКазны.Подразделение;
		НоваяСтрока1.Сумма = СтрокаКазны.Сумма;
		НоваяСтрока1.ВзносыВсего = 0;
		НоваяСтрока1.ВидОперации = ВидОперацииНачислено;
		НоваяСтрока1.ГруппаУчетаНачислений = ГруппаУчетаЗарплата;  // Зарплата (661)
		НоваяСтрока1.ФизическоеЛицо = ФизическоеЛицо;

		// СпособОтражения = ПАРНЫЙ (если найден) или исходный
		Если ЗначениеЗаполнено(ПарныйСпособОтражения) Тогда
			НоваяСтрока1.СпособОтраженияЗарплатыВБухучете = ПарныйСпособОтражения;
		Иначе
			// Если не нашли парный, используем исходный (как fallback)
			НоваяСтрока1.СпособОтраженияЗарплатыВБухучете = ИсходныйСпособОтражения;
		КонецЕсли;

		// =====================================
		// ЗАПИСЬ 2: НачисленныйНДФЛ (как удержание)
		// Д-т 661 К-т 6411 - удержано
		// ГруппаУчетаНачислений = назва статті ДДС (не способа відображення!)
		// =====================================
		НоваяСтрока2 = ДокОбъект.НачисленныйНДФЛ.Добавить();

		НоваяСтрока2.Организация = ДокОбъект.Организация;
		НоваяСтрока2.ПодразделениеПредприятия = СтрокаКазны.Подразделение;
		НоваяСтрока2.Сумма = СтрокаКазны.Сумма;
		НоваяСтрока2.ВидОперации = ВидОперацииНДФЛ;
		НоваяСтрока2.ТипНалога = ТипНалогаНДФЛ;
		НоваяСтрока2.ФизическоеЛицо = ФизическоеЛицо;

		// ИСПРАВЛЕНО: ГруппаУчетаНачислений = НАИМЕНОВАНИЕ СТАТЬИ ДДС (не способа отражения!)
		// Например: "Удержание с админ зарплату" (а НЕ "Выплаты по гиг-контрактам (663)")
		НаименованиеСтатьиДДС = Строка(СтрокаКазны.СтатьяДвиженияДенежныхСредств);
		ГруппаУчетаУдержания = Справочники.ГруппыУчетаНачисленийИУдержаний.НайтиПоНаименованию(НаименованиеСтатьиДДС);
		Если Не ЗначениеЗаполнено(ГруппаУчетаУдержания) Тогда
			// Fallback: шукаємо по назві способа відображення
			ГруппаУчетаУдержания = ПолучитьГруппуУчетаПоСпособуОтражения(ИсходныйСпособОтражения);
		КонецЕсли;
		НоваяСтрока2.ГруппаУчетаНачислений = ГруппаУчетаУдержания;

		КоличествоДобавленных = КоличествоДобавленных + 1;

	КонецЦикла;

	Возврат КоличествоДобавленных;

КонецФункции

// Получение группы учета "Зарплата (661)"
&НаСервере
Функция ПолучитьГруппуУчетаЗарплата()

	// Ищем группу учета для зарплаты (счет 661)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ГруппыУчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ГруппыУчетаНачисленийИУдержаний КАК ГруппыУчета
	|ГДЕ
	|	ГруппыУчета.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыГруппУчетаНачисленийИУдержаний.Начисления)
	|	И НЕ ГруппыУчета.ПометкаУдаления
	|	И (ГруппыУчета.Наименование ПОДОБНО ""%Зарплата%661%""
	|		ИЛИ ГруппыУчета.Наименование ПОДОБНО ""%661%Зарплата%""
	|		ИЛИ ГруппыУчета.Наименование = ""Зарплата"")";

	Результат = Запрос.Выполнить();

	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;

	// Если не нашли специфичную, возвращаем первую группу начислений
	Возврат ПолучитьГруппуУчетаНачисленийПоУмолчанию();

КонецФункции

// Получение группы учета начислений по способу отражения
// Для удержаний возвращает группу учета, соответствующую исходной статье удержания
&НаСервере
Функция ПолучитьГруппуУчетаПоСпособуОтражения(СпособОтражения)

	Если Не ЗначениеЗаполнено(СпособОтражения) Тогда
		Возврат ПолучитьГруппуУчетаНачисленийПоУмолчанию();
	КонецЕсли;

	// Пытаемся найти группу учета с похожим наименованием
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ГруппыУчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ГруппыУчетаНачисленийИУдержаний КАК ГруппыУчета
	|ГДЕ
	|	ГруппыУчета.Наименование = &НаименованиеСпособа
	|	И НЕ ГруппыУчета.ПометкаУдаления";

	Запрос.УстановитьПараметр("НаименованиеСпособа", Строка(СпособОтражения));

	Результат = Запрос.Выполнить();

	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;

	// Если не нашли по точному совпадению, возвращаем группу учета начислений по умолчанию
	Возврат ПолучитьГруппуУчетаНачисленийПоУмолчанию();

КонецФункции

// 1. НАЧИСЛЕНИЯ: заполнение из А_РаспределениеКазна (где А_ЭтоУдержание = ЛОЖЬ)
&НаСервере
Функция ЗаполнитьНачисленияИзКазны(ДокОбъект, СоответствиеСпособовОтражения)

	КоличествоДобавленных = 0;

	// Вид операции по умолчанию - "Начислено"
	ВидОперацииНачислено = Перечисления.ВидыОперацийПоЗарплате.НачисленоДоход;

	// Получаем физические лица для сотрудников
	СоответствиеФизЛиц = ПолучитьФизическиеЛицаСотрудников(ДокОбъект.А_РаспределениеКазна);

	// Получаем группу учета начислений по умолчанию
	ГруппаУчетаНачисленийПоУмолчанию = ПолучитьГруппуУчетаНачисленийПоУмолчанию();

	// Заполняем детальную таблицу НачисленнаяЗарплатаИВзносыПоФизлицам
	// ТОЛЬКО для строк где А_ЭтоУдержание = ЛОЖЬ (начисления)
	Для Каждого СтрокаКазны Из ДокОбъект.А_РаспределениеКазна Цикл

		Если СтрокаКазны.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Получаем данные способа отражения для статьи ДДС
		ДанныеСтатьи = СоответствиеСпособовОтражения[СтрокаКазны.СтатьяДвиженияДенежныхСредств];

		// Проверяем признак "Это удержание"
		// Если А_ЭтоУдержание = ИСТИНА, пропускаем (это удержания, их берем из А_РаспределениеНалоги)
		Если ДанныеСтатьи <> Неопределено И ДанныеСтатьи.ЭтоУдержание Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ДокОбъект.НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();

		// Заполняем реквизиты из А_РаспределениеКазна
		НоваяСтрока.Организация = ДокОбъект.Организация;
		НоваяСтрока.ПодразделениеПредприятия = СтрокаКазны.Подразделение;
		НоваяСтрока.Сумма = СтрокаКазны.Сумма;
		НоваяСтрока.ВзносыВсего = 0;

		// Заполняем служебные реквизиты
		НоваяСтрока.ВидОперации = ВидОперацииНачислено;
		НоваяСтрока.ГруппаУчетаНачислений = ГруппаУчетаНачисленийПоУмолчанию;

		// Способ отражения из статьи ДДС
		Если ДанныеСтатьи <> Неопределено И ЗначениеЗаполнено(ДанныеСтатьи.СпособОтражения) Тогда
			НоваяСтрока.СпособОтраженияЗарплатыВБухучете = ДанныеСтатьи.СпособОтражения;
		КонецЕсли;

		// Получаем физическое лицо из сотрудника
		Если СоответствиеФизЛиц[СтрокаКазны.Сотрудник] <> Неопределено Тогда
			НоваяСтрока.ФизическоеЛицо = СоответствиеФизЛиц[СтрокаКазны.Сотрудник];
		КонецЕсли;

		КоличествоДобавленных = КоличествоДобавленных + 1;

	КонецЦикла;

	Возврат КоличествоДобавленных;

КонецФункции

// 2. УДЕРЖАНИЯ: заполнение из А_РаспределениеНалоги
// ИСПРАВЛЕНО: Запись в НачисленныйНДФЛ, а НЕ в НачисленнаяЗарплатаИВзносыПоФизлицам!
&НаСервере
Функция ЗаполнитьУдержанияИзНалогов(ДокОбъект)

	КоличествоДобавленных = 0;

	// Проверяем наличие данных в ТЧ А_РаспределениеНалоги
	Если ДокОбъект.А_РаспределениеНалоги.Количество() = 0 Тогда
		Возврат КоличествоДобавленных;
	КонецЕсли;

	// Вид операции для НДФЛ
	ВидОперацииНДФЛ = Перечисления.ВидыОперацийПоЗарплате.НДФЛ;

	// Получаем физические лица для сотрудников
	СоответствиеФизЛиц = ПолучитьФизическиеЛицаСотрудниковИзНалогов(ДокОбъект.А_РаспределениеНалоги);

	// Получаем группу учета НДФЛ (6411)
	ГруппаУчетаНДФЛ = ПолучитьГруппуУчетаНДФЛ();

	// Получаем группу учета Военный сбор (642)
	ГруппаУчетаВС = ПолучитьГруппуУчетаВоенныйСбор();

	Для Каждого СтрокаНалога Из ДокОбъект.А_РаспределениеНалоги Цикл

		Если СтрокаНалога.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;

		// ИСПРАВЛЕНО: Запись в НачисленныйНДФЛ, а НЕ в НачисленнаяЗарплатаИВзносыПоФизлицам!
		НоваяСтрока = ДокОбъект.НачисленныйНДФЛ.Добавить();

		// Заполняем реквизиты из А_РаспределениеНалоги
		НоваяСтрока.Организация = ДокОбъект.Организация;
		НоваяСтрока.Сумма = СтрокаНалога.Сумма;

		// Вид операции
		НоваяСтрока.ВидОперации = ВидОперацииНДФЛ;

		// ИСПРАВЛЕНО: Заполнение ТипНалога и ГруппаУчетаНачислений
		Если СтрокаНалога.ТипНалога = Перечисления.ТипыНалогов.ВоенныйСбор Тогда
			НоваяСтрока.ТипНалога = Перечисления.ТипыНалогов.ВоенныйСбор;
			НоваяСтрока.ГруппаУчетаНачислений = ГруппаУчетаВС;
		Иначе
			// По умолчанию - НДФЛ
			НоваяСтрока.ТипНалога = Перечисления.ТипыНалогов.НДФЛ;
			НоваяСтрока.ГруппаУчетаНачислений = ГруппаУчетаНДФЛ;
		КонецЕсли;

		// Получаем физическое лицо из сотрудника
		Если СоответствиеФизЛиц[СтрокаНалога.Сотрудник] <> Неопределено Тогда
			НоваяСтрока.ФизическоеЛицо = СоответствиеФизЛиц[СтрокаНалога.Сотрудник];
		КонецЕсли;

		КоличествоДобавленных = КоличествоДобавленных + 1;

	КонецЦикла;

	Возврат КоличествоДобавленных;

КонецФункции

// Получение группы учета "НДФЛ (6411)"
&НаСервере
Функция ПолучитьГруппуУчетаНДФЛ()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ГруппыУчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ГруппыУчетаНачисленийИУдержаний КАК ГруппыУчета
	|ГДЕ
	|	НЕ ГруппыУчета.ПометкаУдаления
	|	И (ГруппыУчета.Наименование ПОДОБНО ""%НДФЛ%6411%""
	|		ИЛИ ГруппыУчета.Наименование ПОДОБНО ""%6411%НДФЛ%""
	|		ИЛИ ГруппыУчета.Наименование = ""НДФЛ (6411)"")";

	Результат = Запрос.Выполнить();

	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.ГруппыУчетаНачисленийИУдержаний.ПустаяСсылка();

КонецФункции

// Получение группы учета "Военный сбор (642)"
&НаСервере
Функция ПолучитьГруппуУчетаВоенныйСбор()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ГруппыУчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ГруппыУчетаНачисленийИУдержаний КАК ГруппыУчета
	|ГДЕ
	|	НЕ ГруппыУчета.ПометкаУдаления
	|	И (ГруппыУчета.Наименование ПОДОБНО ""%Военный%сбор%642%""
	|		ИЛИ ГруппыУчета.Наименование ПОДОБНО ""%642%Военный%""
	|		ИЛИ ГруппыУчета.Наименование = ""Военный сбор (642)"")";

	Результат = Запрос.Выполнить();

	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.ГруппыУчетаНачисленийИУдержаний.ПустаяСсылка();

КонецФункции

// 3. КОНТРОЛЬНАЯ СВЕРКА: сравнение сумм удержаний из Казны и Налогов по каждому сотруднику
&НаСервере
Функция ВыполнитьКонтрольнуюСверку(ДокОбъект, СоответствиеСпособовОтражения)

	ТекстРасхождений = "";

	// Собираем суммы удержаний по сотрудникам из А_РаспределениеКазна (где А_ЭтоУдержание = ИСТИНА)
	СуммыКазны = Новый Соответствие;
	Для Каждого СтрокаКазны Из ДокОбъект.А_РаспределениеКазна Цикл

		ДанныеСтатьи = СоответствиеСпособовОтражения[СтрокаКазны.СтатьяДвиженияДенежныхСредств];

		// Учитываем только строки где А_ЭтоУдержание = ИСТИНА
		Если ДанныеСтатьи = Неопределено ИЛИ Не ДанныеСтатьи.ЭтоУдержание Тогда
			Продолжить;
		КонецЕсли;

		ТекущаяСумма = СуммыКазны[СтрокаКазны.Сотрудник];
		Если ТекущаяСумма = Неопределено Тогда
			ТекущаяСумма = 0;
		КонецЕсли;
		СуммыКазны.Вставить(СтрокаКазны.Сотрудник, ТекущаяСумма + СтрокаКазны.Сумма);
	КонецЦикла;

	// Собираем суммы по сотрудникам из А_РаспределениеНалоги (НДФЛ + ВоенныйСбор)
	СуммыНалогов = Новый Соответствие;
	Для Каждого СтрокаНалога Из ДокОбъект.А_РаспределениеНалоги Цикл
		ТекущаяСумма = СуммыНалогов[СтрокаНалога.Сотрудник];
		Если ТекущаяСумма = Неопределено Тогда
			ТекущаяСумма = 0;
		КонецЕсли;
		СуммыНалогов.Вставить(СтрокаНалога.Сотрудник, ТекущаяСумма + СтрокаНалога.Сумма);
	КонецЦикла;

	// Сравниваем суммы по каждому сотруднику
	ВсеСотрудники = Новый Соответствие;

	// Собираем всех сотрудников из обоих источников
	Для Каждого КлючЗначение Из СуммыКазны Цикл
		ВсеСотрудники.Вставить(КлючЗначение.Ключ, Истина);
	КонецЦикла;
	Для Каждого КлючЗначение Из СуммыНалогов Цикл
		ВсеСотрудники.Вставить(КлючЗначение.Ключ, Истина);
	КонецЦикла;

	// Проверяем расхождения
	Для Каждого КлючЗначение Из ВсеСотрудники Цикл

		Сотрудник = КлючЗначение.Ключ;

		СуммаКазны = СуммыКазны[Сотрудник];
		Если СуммаКазны = Неопределено Тогда
			СуммаКазны = 0;
		КонецЕсли;

		СуммаНалогов = СуммыНалогов[Сотрудник];
		Если СуммаНалогов = Неопределено Тогда
			СуммаНалогов = 0;
		КонецЕсли;

		Разница = СуммаКазны - СуммаНалогов;

		Если Разница <> 0 Тогда
			ТекстРасхождений = ТекстРасхождений + ?(ПустаяСтрока(ТекстРасхождений), "", Символы.ПС);
			ТекстРасхождений = ТекстРасхождений + СтрШаблон(
				"ПРЕДУПРЕЖДЕНИЕ: Сотрудник %1: Казна (удержания)=%2, Налоги=%3, Разница=%4",
				Сотрудник, Формат(СуммаКазны, "ЧДЦ=2"), Формат(СуммаНалогов, "ЧДЦ=2"), Формат(Разница, "ЧДЦ=2"));
		КонецЕсли;

	КонецЦикла;

	// Если есть расхождения, выводим сообщение пользователю
	Если Не ПустаяСтрока(ТекстРасхождений) Тогда
		ТекстРасхождений = "КОНТРОЛЬНАЯ СВЕРКА (расхождения):" + Символы.ПС + ТекстРасхождений;
	КонецЕсли;

	Возврат ТекстРасхождений;

КонецФункции

// Получение физических лиц для сотрудников из А_РаспределениеНалоги
&НаСервере
Функция ПолучитьФизическиеЛицаСотрудниковИзНалогов(ТаблицаНалогов)

	СоответствиеФизЛиц = Новый Соответствие;

	// Собираем уникальных сотрудников
	МассивСотрудников = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаНалогов Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.Сотрудник)
			И МассивСотрудников.Найти(СтрокаТаблицы.Сотрудник) = Неопределено Тогда
			МассивСотрудников.Добавить(СтрокаТаблицы.Сотрудник);
		КонецЕсли;
	КонецЦикла;

	Если МассивСотрудников.Количество() = 0 Тогда
		Возврат СоответствиеФизЛиц;
	КонецЕсли;

	// Запрос для получения физических лиц
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Ссылка В(&МассивСотрудников)";

	Запрос.УстановитьПараметр("МассивСотрудников", МассивСотрудников);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеФизЛиц.Вставить(Выборка.Сотрудник, Выборка.ФизическоеЛицо);
	КонецЦикла;

	Возврат СоответствиеФизЛиц;

КонецФункции

