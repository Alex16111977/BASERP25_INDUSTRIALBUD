////////////////////////////////////////////////////////////////////////////////
// Заполнение ОтражениеЗарплатыВФинансовомУчете по данным из Казны
// Модуль формы внешней обработки
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Инициализация при открытии формы
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Команда 1: Загрузить распределение из Казны (заполняет А_РаспределениеКазна)
&НаКлиенте
Процедура Заполнить_ОтражениеЗарплатыВФинансовомУчете_ПоКазне(Команда)

	ОчиститьСообщения();

	Если Не ЗначениеЗаполнено(Объект.Док_ОтражениеЗарплатыВФинансовомУчете) Тогда
		ПоказатьПредупреждение(, "Не указан документ ""Отражение зарплаты в финансовом учете""!");
		Возврат;
	КонецЕсли;

	Результат = Заполнить_ОтражениеЗарплатыВФинансовомУчете_ПоКазнеНаСервере();

	Если Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Сообщение);
	Иначе
		ПоказатьПредупреждение(, "Ошибка: " + Результат.Сообщение);
	КонецЕсли;

КонецПроцедуры

// Команда 2: Заполнить начисления из Казны (заполняет НачисленнаяЗарплатаИВзносы и НачисленнаяЗарплатаИВзносыПоФизлицам)
&НаКлиенте
Процедура Заполнить_НачисленияИзКазны(Команда)

	ОчиститьСообщения();

	Если Не ЗначениеЗаполнено(Объект.Док_ОтражениеЗарплатыВФинансовомУчете) Тогда
		ПоказатьПредупреждение(, "Не указан документ ""Отражение зарплаты в финансовом учете""!");
		Возврат;
	КонецЕсли;

	Результат = Заполнить_НачисленияИзКазныНаСервере();

	Если Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Сообщение);
	Иначе
		ПоказатьПредупреждение(, "Ошибка: " + Результат.Сообщение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Серверная процедура загрузки распределения из Казны
&НаСервере
Функция Заполнить_ОтражениеЗарплатыВФинансовомУчете_ПоКазнеНаСервере()

	Результат = Новый Структура("Успех, Сообщение", Ложь, "");

	Попытка

		ДокОбъект = Объект.Док_ОтражениеЗарплатыВФинансовомУчете.ПолучитьОбъект();

		Если ДокОбъект = Неопределено Тогда
			Результат.Сообщение = "Не удалось получить объект документа!";
			Возврат Результат;
		КонецЕсли;

		// Очищаем таблицу А_РаспределениеКазна
		ДокОбъект.А_РаспределениеКазна.Очистить();

		// Получаем данные из Казны
		ДанныеКазны = ПолучитьДанныеРаспределенияИзКазны(ДокОбъект);

		// Заполняем табличную часть
		Для Каждого СтрокаДанных Из ДанныеКазны Цикл
			НоваяСтрока = ДокОбъект.А_РаспределениеКазна.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
		КонецЦикла;

		ДокОбъект.Записать();

		Результат.Успех = Истина;
		Результат.Сообщение = СтрШаблон("Загружено %1 строк в А_РаспределениеКазна.",
			ДокОбъект.А_РаспределениеКазна.Количество());

	Исключение
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Серверная процедура заполнения начислений из данных Казны
// ДОРАБОТАНО: Раздельная обработка начислений и удержаний
// НАЧИСЛЕНИЯ: из А_РаспределениеКазна (где А_ЭтоУдержание = ЛОЖЬ)
// УДЕРЖАНИЯ: из А_РаспределениеНалоги
&НаСервере
Функция Заполнить_НачисленияИзКазныНаСервере()

	Результат = Новый Структура("Успех, Сообщение", Ложь, "");

	Попытка

		ДокОбъект = Объект.Док_ОтражениеЗарплатыВФинансовомУчете.ПолучитьОбъект();

		Если ДокОбъект = Неопределено Тогда
			Результат.Сообщение = "Не удалось получить объект документа!";
			Возврат Результат;
		КонецЕсли;

		// Проверяем наличие данных в источниках
		Если ДокОбъект.А_РаспределениеКазна.Количество() = 0 Тогда
			Результат.Сообщение = "Таблица А_РаспределениеКазна пуста! Сначала загрузите распределение из Казны.";
			Возврат Результат;
		КонецЕсли;

		// Очищаем целевые таблицы
		ДокОбъект.НачисленнаяЗарплатаИВзносы.Очистить();
		ДокОбъект.НачисленнаяЗарплатаИВзносыПоФизлицам.Очистить();

		// Получаем способы отражения и признак "Это удержание" для статей ДДС
		СоответствиеСпособовОтражения = ПолучитьСпособыОтраженияПоСтатьямДДС(ДокОбъект.А_РаспределениеКазна);

		// Счетчики для результата
		КоличествоНачислений = 0;
		КоличествоУдержаний = 0;

		// 1. НАЧИСЛЕНИЯ: заполняем из А_РаспределениеКазна (где А_ЭтоУдержание = ЛОЖЬ)
		КоличествоНачислений = ЗаполнитьНачисленияИзКазны(ДокОбъект, СоответствиеСпособовОтражения);

		// 2. УДЕРЖАНИЯ: заполняем из А_РаспределениеНалоги
		КоличествоУдержаний = ЗаполнитьУдержанияИзНалогов(ДокОбъект);

		// 3. КОНТРОЛЬНАЯ СВЕРКА по сотрудникам
		ТекстРасхождений = ВыполнитьКонтрольнуюСверку(ДокОбъект, СоответствиеСпособовОтражения);

		// 4. Формируем сводную таблицу НачисленнаяЗарплатаИВзносы
		ОбновитьСводнуюТаблицуНачислений(ДокОбъект);

		// Записываем документ
		ДокОбъект.Записать();

		Результат.Успех = Истина;
		Результат.Сообщение = СтрШаблон(
			"Заполнено: Начисления - %1 строк, Удержания - %2 строк.
			|НачисленнаяЗарплатаИВзносы - %3 строк, НачисленнаяЗарплатаИВзносыПоФизлицам - %4 строк.%5",
			КоличествоНачислений,
			КоличествоУдержаний,
			ДокОбъект.НачисленнаяЗарплатаИВзносы.Количество(),
			ДокОбъект.НачисленнаяЗарплатаИВзносыПоФизлицам.Количество(),
			?(ПустаяСтрока(ТекстРасхождений), "", Символы.ПС + Символы.ПС + ТекстРасхождений));

	Исключение
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Получение данных распределения из системы Казна
&НаСервере
Функция ПолучитьДанныеРаспределенияИзКазны(ДокОбъект)

	// TODO: Здесь должен быть запрос к данным Казны
	// Пока возвращаем пустую таблицу
	// Логика получения данных из Казны должна быть реализована отдельно

	ДанныеКазны = Новый ТаблицаЗначений;
	ДанныеКазны.Колонки.Добавить("Организация");
	ДанныеКазны.Колонки.Добавить("Сотрудник");
	ДанныеКазны.Колонки.Добавить("СтатьяДвиженияДенежныхСредств");
	ДанныеКазны.Колонки.Добавить("Подразделение");
	ДанныеКазны.Колонки.Добавить("НаправленияДеятельности");
	ДанныеКазны.Колонки.Добавить("Сумма");

	Возврат ДанныеКазны;

КонецФункции

// Получение способов отражения и признака "Это удержание" по статьям ДДС
// Возвращает соответствие: СтатьяДДС -> Структура("СпособОтражения", "ЭтоУдержание")
&НаСервере
Функция ПолучитьСпособыОтраженияПоСтатьямДДС(ТаблицаКазны)

	Результат = Новый Соответствие;

	// Собираем уникальные статьи ДДС
	МассивСтатейДДС = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаКазны Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.СтатьяДвиженияДенежныхСредств)
			И МассивСтатейДДС.Найти(СтрокаТаблицы.СтатьяДвиженияДенежныхСредств) = Неопределено Тогда
			МассивСтатейДДС.Добавить(СтрокаТаблицы.СтатьяДвиженияДенежныхСредств);
		КонецЕсли;
	КонецЦикла;

	Если МассивСтатейДДС.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Запрос для получения способов отражения
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтатьиДДС.Ссылка КАК СтатьяДДС,
	|	СтатьиДДС.А_СпособОтраженияЗарплатыВБухучете КАК СпособОтражения,
	|	ЕСТЬNULL(СтатьиДДС.А_СпособОтраженияЗарплатыВБухучете.А_ЭтоУдержание, ЛОЖЬ) КАК ЭтоУдержание
	|ИЗ
	|	Справочник.СтатьиДвиженияДенежныхСредств КАК СтатьиДДС
	|ГДЕ
	|	СтатьиДДС.Ссылка В(&МассивСтатейДДС)";

	Запрос.УстановитьПараметр("МассивСтатейДДС", МассивСтатейДДС);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.СтатьяДДС, Новый Структура("СпособОтражения, ЭтоУдержание",
			Выборка.СпособОтражения, Выборка.ЭтоУдержание));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// 1. НАЧИСЛЕНИЯ: заполнение из А_РаспределениеКазна (где А_ЭтоУдержание = ЛОЖЬ)
&НаСервере
Функция ЗаполнитьНачисленияИзКазны(ДокОбъект, СоответствиеСпособовОтражения)

	КоличествоДобавленных = 0;

	// Вид операции по умолчанию - "Начислено"
	ВидОперацииНачислено = Перечисления.ВидыОперацийПоЗарплате.НачисленоДоход;

	// Получаем физические лица для сотрудников
	СоответствиеФизЛиц = ПолучитьФизическиеЛицаСотрудников(ДокОбъект.А_РаспределениеКазна);

	// Получаем группу учета начислений по умолчанию
	ГруппаУчетаНачисленийПоУмолчанию = ПолучитьГруппуУчетаНачисленийПоУмолчанию();

	// Заполняем детальную таблицу НачисленнаяЗарплатаИВзносыПоФизлицам
	// ТОЛЬКО для строк где А_ЭтоУдержание = ЛОЖЬ (начисления)
	Для Каждого СтрокаКазны Из ДокОбъект.А_РаспределениеКазна Цикл

		Если СтрокаКазны.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Получаем данные способа отражения для статьи ДДС
		ДанныеСтатьи = СоответствиеСпособовОтражения[СтрокаКазны.СтатьяДвиженияДенежныхСредств];

		// Проверяем признак "Это удержание"
		// Если А_ЭтоУдержание = ИСТИНА, пропускаем (это удержания, их берем из А_РаспределениеНалоги)
		Если ДанныеСтатьи <> Неопределено И ДанныеСтатьи.ЭтоУдержание Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ДокОбъект.НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();

		// Заполняем реквизиты из А_РаспределениеКазна
		НоваяСтрока.Организация = ДокОбъект.Организация;
		НоваяСтрока.ПодразделениеПредприятия = СтрокаКазны.Подразделение;
		НоваяСтрока.Сумма = СтрокаКазны.Сумма;
		НоваяСтрока.ВзносыВсего = 0;

		// Заполняем служебные реквизиты
		НоваяСтрока.ВидОперации = ВидОперацииНачислено;
		НоваяСтрока.ГруппаУчетаНачислений = ГруппаУчетаНачисленийПоУмолчанию;

		// Способ отражения из статьи ДДС
		Если ДанныеСтатьи <> Неопределено И ЗначениеЗаполнено(ДанныеСтатьи.СпособОтражения) Тогда
			НоваяСтрока.СпособОтраженияЗарплатыВБухучете = ДанныеСтатьи.СпособОтражения;
		КонецЕсли;

		// Получаем физическое лицо из сотрудника
		Если СоответствиеФизЛиц[СтрокаКазны.Сотрудник] <> Неопределено Тогда
			НоваяСтрока.ФизическоеЛицо = СоответствиеФизЛиц[СтрокаКазны.Сотрудник];
		КонецЕсли;

		КоличествоДобавленных = КоличествоДобавленных + 1;

	КонецЦикла;

	Возврат КоличествоДобавленных;

КонецФункции

// 2. УДЕРЖАНИЯ: заполнение из А_РаспределениеНалоги
&НаСервере
Функция ЗаполнитьУдержанияИзНалогов(ДокОбъект)

	КоличествоДобавленных = 0;

	// Проверяем наличие данных в ТЧ А_РаспределениеНалоги
	Если ДокОбъект.А_РаспределениеНалоги.Количество() = 0 Тогда
		Возврат КоличествоДобавленных;
	КонецЕсли;

	// Вид операции для НДФЛ
	ВидОперацииНДФЛ = Перечисления.ВидыОперацийПоЗарплате.НДФЛ;

	// Получаем физические лица для сотрудников
	СоответствиеФизЛиц = ПолучитьФизическиеЛицаСотрудниковИзНалогов(ДокОбъект.А_РаспределениеНалоги);

	// Получаем группу учета удержаний
	ГруппаУчетаУдержаний = ПолучитьГруппуУчетаУдержанийПоУмолчанию();

	// Получаем справочник налогов для заполнения реквизита "Налог"
	НалогНДФЛ = Справочники.Налоги.НайтиПоНаименованию("НДФЛ");
	НалогВоенныйСбор = Справочники.Налоги.НайтиПоНаименованию("Военный сбор");

	// Если не нашли по наименованию, пробуем найти альтернативно
	Если Не ЗначениеЗаполнено(НалогВоенныйСбор) Тогда
		НалогВоенныйСбор = Справочники.Налоги.НайтиПоНаименованию("ВС");
	КонецЕсли;

	Для Каждого СтрокаНалога Из ДокОбъект.А_РаспределениеНалоги Цикл

		Если СтрокаНалога.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ДокОбъект.НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();

		// Заполняем реквизиты из А_РаспределениеНалоги
		НоваяСтрока.Организация = ДокОбъект.Организация;
		НоваяСтрока.Сумма = СтрокаНалога.Сумма;
		НоваяСтрока.ВзносыВсего = 0;

		// Вид операции
		НоваяСтрока.ВидОперации = ВидОперацииНДФЛ;
		НоваяСтрока.ГруппаУчетаНачислений = ГруппаУчетаУдержаний;

		// Определяем реквизит "Налог" по типу налога
		Если СтрокаНалога.ТипНалога = Перечисления.ТипыНалогов.ВоенныйСбор Тогда
			НоваяСтрока.Налог = НалогВоенныйСбор;
		Иначе
			// По умолчанию - НДФЛ
			НоваяСтрока.Налог = НалогНДФЛ;
		КонецЕсли;

		// Получаем физическое лицо из сотрудника
		Если СоответствиеФизЛиц[СтрокаНалога.Сотрудник] <> Неопределено Тогда
			НоваяСтрока.ФизическоеЛицо = СоответствиеФизЛиц[СтрокаНалога.Сотрудник];
		КонецЕсли;

		КоличествоДобавленных = КоличествоДобавленных + 1;

	КонецЦикла;

	Возврат КоличествоДобавленных;

КонецФункции

// 3. КОНТРОЛЬНАЯ СВЕРКА: сравнение сумм удержаний из Казны и Налогов по каждому сотруднику
&НаСервере
Функция ВыполнитьКонтрольнуюСверку(ДокОбъект, СоответствиеСпособовОтражения)

	ТекстРасхождений = "";

	// Собираем суммы удержаний по сотрудникам из А_РаспределениеКазна (где А_ЭтоУдержание = ИСТИНА)
	СуммыКазны = Новый Соответствие;
	Для Каждого СтрокаКазны Из ДокОбъект.А_РаспределениеКазна Цикл

		ДанныеСтатьи = СоответствиеСпособовОтражения[СтрокаКазны.СтатьяДвиженияДенежныхСредств];

		// Учитываем только строки где А_ЭтоУдержание = ИСТИНА
		Если ДанныеСтатьи = Неопределено ИЛИ Не ДанныеСтатьи.ЭтоУдержание Тогда
			Продолжить;
		КонецЕсли;

		ТекущаяСумма = СуммыКазны[СтрокаКазны.Сотрудник];
		Если ТекущаяСумма = Неопределено Тогда
			ТекущаяСумма = 0;
		КонецЕсли;
		СуммыКазны.Вставить(СтрокаКазны.Сотрудник, ТекущаяСумма + СтрокаКазны.Сумма);
	КонецЦикла;

	// Собираем суммы по сотрудникам из А_РаспределениеНалоги (НДФЛ + ВоенныйСбор)
	СуммыНалогов = Новый Соответствие;
	Для Каждого СтрокаНалога Из ДокОбъект.А_РаспределениеНалоги Цикл
		ТекущаяСумма = СуммыНалогов[СтрокаНалога.Сотрудник];
		Если ТекущаяСумма = Неопределено Тогда
			ТекущаяСумма = 0;
		КонецЕсли;
		СуммыНалогов.Вставить(СтрокаНалога.Сотрудник, ТекущаяСумма + СтрокаНалога.Сумма);
	КонецЦикла;

	// Сравниваем суммы по каждому сотруднику
	ВсеСотрудники = Новый Соответствие;

	// Собираем всех сотрудников из обоих источников
	Для Каждого КлючЗначение Из СуммыКазны Цикл
		ВсеСотрудники.Вставить(КлючЗначение.Ключ, Истина);
	КонецЦикла;
	Для Каждого КлючЗначение Из СуммыНалогов Цикл
		ВсеСотрудники.Вставить(КлючЗначение.Ключ, Истина);
	КонецЦикла;

	// Проверяем расхождения
	Для Каждого КлючЗначение Из ВсеСотрудники Цикл

		Сотрудник = КлючЗначение.Ключ;

		СуммаКазны = СуммыКазны[Сотрудник];
		Если СуммаКазны = Неопределено Тогда
			СуммаКазны = 0;
		КонецЕсли;

		СуммаНалогов = СуммыНалогов[Сотрудник];
		Если СуммаНалогов = Неопределено Тогда
			СуммаНалогов = 0;
		КонецЕсли;

		Разница = СуммаКазны - СуммаНалогов;

		Если Разница <> 0 Тогда
			ТекстРасхождений = ТекстРасхождений + ?(ПустаяСтрока(ТекстРасхождений), "", Символы.ПС);
			ТекстРасхождений = ТекстРасхождений + СтрШаблон(
				"ПРЕДУПРЕЖДЕНИЕ: Сотрудник %1: Казна (удержания)=%2, Налоги=%3, Разница=%4",
				Сотрудник, Формат(СуммаКазны, "ЧДЦ=2"), Формат(СуммаНалогов, "ЧДЦ=2"), Формат(Разница, "ЧДЦ=2"));
		КонецЕсли;

	КонецЦикла;

	// Если есть расхождения, выводим сообщение пользователю
	Если Не ПустаяСтрока(ТекстРасхождений) Тогда
		ТекстРасхождений = "КОНТРОЛЬНАЯ СВЕРКА (расхождения):" + Символы.ПС + ТекстРасхождений;
	КонецЕсли;

	Возврат ТекстРасхождений;

КонецФункции

// Получение физических лиц для сотрудников из А_РаспределениеНалоги
&НаСервере
Функция ПолучитьФизическиеЛицаСотрудниковИзНалогов(ТаблицаНалогов)

	СоответствиеФизЛиц = Новый Соответствие;

	// Собираем уникальных сотрудников
	МассивСотрудников = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаНалогов Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.Сотрудник)
			И МассивСотрудников.Найти(СтрокаТаблицы.Сотрудник) = Неопределено Тогда
			МассивСотрудников.Добавить(СтрокаТаблицы.Сотрудник);
		КонецЕсли;
	КонецЦикла;

	Если МассивСотрудников.Количество() = 0 Тогда
		Возврат СоответствиеФизЛиц;
	КонецЕсли;

	// Запрос для получения физических лиц
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Ссылка В(&МассивСотрудников)";

	Запрос.УстановитьПараметр("МассивСотрудников", МассивСотрудников);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеФизЛиц.Вставить(Выборка.Сотрудник, Выборка.ФизическоеЛицо);
	КонецЦикла;

	Возврат СоответствиеФизЛиц;

КонецФункции

// Получение группы учета удержаний по умолчанию
&НаСервере
Функция ПолучитьГруппуУчетаУдержанийПоУмолчанию()

	// Ищем группу учета для удержаний
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ГруппыУчетаНачисленийИУдержаний.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ГруппыУчетаНачисленийИУдержаний КАК ГруппыУчетаНачисленийИУдержаний
	|ГДЕ
	|	ГруппыУчетаНачисленийИУдержаний.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыГруппУчетаНачисленийИУдержаний.Удержания)
	|	И НЕ ГруппыУчетаНачисленийИУдержаний.ПометкаУдаления";

	Результат = Запрос.Выполнить();

	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.ГруппыУчетаНачисленийИУдержаний.ПустаяСсылка();

КонецФункции

