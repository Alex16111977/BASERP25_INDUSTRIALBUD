////////////////////////////////////////////////////////////////////////////////
// Заполнение ОтражениеЗарплатыВФинансовомУчете по данным из А_РаспределениеНалоги
// и регистра ВзаиморасчетыССотрудниками
// Модуль формы внешней обработки
// 
// ИСТОЧНИКИ ДАННЫХ:
//   - А_РаспределениеНалоги - суммы НДФЛ, ВС, ЕСВ
//   - ВзаиморасчетыССотрудниками - суммы начисленной ЗП
//   - А_РаспределениеКазна - % распределения по подразделениям + СпособОтражения
//
// ЦЕЛЕВЫЕ ТАБЛИЦЫ:
//   - НачисленнаяЗарплатаИВзносыПоФизлицам - детальные начисления
//   - НачисленныйНДФЛ - НДФЛ/ВС распределенный по подразделениям
//   - НачисленнаяЗарплатаИВзносы - сводная таблица (свертка)
//
// КЛЮЧЕВОЕ ИЗМЕНЕНИЕ:
//   СпособОтраженияЗарплатыВБухучете берется из 
//   СтатьяДвиженияДенежныхСредств.А_СпособОтраженияЗарплатыВБухучете в А_РаспределениеКазна
//
// ЛОГИКА ПОИСКА РАСПРЕДЕЛЕНИЯ (fallback):
//   1. Ищем по точному НалогСтатьяДДС
//   2. Если налог начинается с "ЕСВ ФОТ" → ищем по базовому "ЕСВ ФОТ"
//   3. Берем распределение из строк где А_Налог = "" (базовые начисления)
//
// ВАЖНО: Для НДФЛ/ВС (строки где Сумма > 0 и СуммаФОТ = 0):
//   СпособОтражения берется из строк А_РаспределениеКазна где СуммаНалогов > 0
//
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Инициализация при открытии формы
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить_НачисленияИзКазны(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Объект.Док_ОтражениеЗарплатыВФинансовомУчете) Тогда
		ПоказатьПредупреждение(, "Не указан документ ""Отражение зарплаты в финансовом учете""!");
		Возврат;
	КонецЕсли;
	
	Результат = Заполнить_НачисленияИзКазныНаСервере();
	
	Если Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Сообщение);
	Иначе
		ПоказатьПредупреждение(, "Ошибка: " + Результат.Сообщение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основная серверная процедура заполнения
&НаСервере
Функция Заполнить_НачисленияИзКазныНаСервере()
	
	Результат = Новый Структура("Успех, Сообщение", Ложь, "");
	
	Попытка
		
		ДокОбъект = Объект.Док_ОтражениеЗарплатыВФинансовомУчете.ПолучитьОбъект();
		
		Если ДокОбъект = Неопределено Тогда
			Результат.Сообщение = "Не удалось получить объект документа!";
			Возврат Результат;
		КонецЕсли;
		
		// Проверяем наличие исходных данных
		Если ДокОбъект.А_РаспределениеНалоги.Количество() = 0 Тогда
			Результат.Сообщение = "Таблица А_РаспределениеНалоги пуста!";
			Возврат Результат;
		КонецЕсли;
		
		Если ДокОбъект.А_РаспределениеКазна.Количество() = 0 Тогда
			Результат.Сообщение = "Таблица А_РаспределениеКазна пуста (нужна для распределения по подразделениям)!";
			Возврат Результат;
		КонецЕсли;
		
		// Подготовка справочных данных
		СправочныеДанные = ПодготовитьСправочныеДанные(ДокОбъект);
		
		// Очищаем целевые таблицы
		ДокОбъект.НачисленнаяЗарплатаИВзносы.Очистить();
		ДокОбъект.НачисленнаяЗарплатаИВзносыПоФизлицам.Очистить();
		ДокОбъект.НачисленныйНДФЛ.Очистить();
		
		// Счетчики
		КолНачисленийНалоги = 0;
		КолНачисленийЗП = 0;
		КолНДФЛ = 0;
		
		// 1. НАЧИСЛЕНИЯ ИЗ НАЛОГОВ: А_РаспределениеНалоги → НачисленнаяЗарплатаИВзносыПоФизлицам
		КолНачисленийНалоги = ЗаполнитьНачисленияИзНалогов(ДокОбъект, СправочныеДанные);
		
		// 2. НАЧИСЛЕНИЯ ЗП: ВзаиморасчетыССотрудниками → НачисленнаяЗарплатаИВзносыПоФизлицам
		КолНачисленийЗП = ЗаполнитьНачисленияЗПИзРегистра(ДокОбъект, СправочныеДанные);
		
		// 3. НДФЛ: А_РаспределениеНалоги → НачисленныйНДФЛ
		КолНДФЛ = ЗаполнитьНДФЛИзНалогов(ДокОбъект, СправочныеДанные);
		
		// 4. Формируем сводную таблицу
		СформироватьСводнуюТаблицу(ДокОбъект);
		
		// Записываем документ
		ДокОбъект.Записать();
		
		Результат.Успех = Истина;
		Результат.Сообщение = СтрШаблон(
			"Заполнено:
			|• Начисления из налогов: %1 строк
			|• Начисления ЗП из регистра: %2 строк
			|• НачисленныйНДФЛ: %3 строк
			|
			|Итого:
			|• НачисленнаяЗарплатаИВзносыПоФизлицам: %4 строк
			|• НачисленнаяЗарплатаИВзносы: %5 строк",
			КолНачисленийНалоги,
			КолНачисленийЗП,
			КолНДФЛ,
			ДокОбъект.НачисленнаяЗарплатаИВзносыПоФизлицам.Количество(),
			ДокОбъект.НачисленнаяЗарплатаИВзносы.Количество());
		
	Исключение
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#Область ПодготовкаДанных

// Подготовка справочных данных
&НаСервере
Функция ПодготовитьСправочныеДанные(ДокОбъект)
	
	Данные = Новый Структура;
	
	// Собираем всех сотрудников
	ВсеСотрудники = Новый Массив;
	Для Каждого Строка Из ДокОбъект.А_РаспределениеКазна Цикл
		Если ЗначениеЗаполнено(Строка.Сотрудник) И ВсеСотрудники.Найти(Строка.Сотрудник) = Неопределено Тогда
			ВсеСотрудники.Добавить(Строка.Сотрудник);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка Из ДокОбъект.А_РаспределениеНалоги Цикл
		Если ЗначениеЗаполнено(Строка.Сотрудник) И ВсеСотрудники.Найти(Строка.Сотрудник) = Неопределено Тогда
			ВсеСотрудники.Добавить(Строка.Сотрудник);
		КонецЕсли;
	КонецЦикла;
	
	// Получаем физические лица
	Данные.Вставить("ФизЛица", ПолучитьФизическиеЛица(ВсеСотрудники));
	
	// Группа учета - Зарплата (661)
	Данные.Вставить("ГруппаУчетаЗарплата", Справочники.ГруппыУчетаНачисленийИУдержаний.Зарплата);
	
	// Вид операции - НачисленоДоход
	Данные.Вставить("ВидОперацииНачислено", Перечисления.ВидыОперацийПоЗарплате.НачисленоДоход);
	Данные.Вставить("ВидОперацииВоенныйСбор", Перечисления.ВидыОперацийПоЗарплате.ВоенныйСбор);
	Данные.Вставить("ВидОперацииНДФЛ", Перечисления.ВидыОперацийПоЗарплате.НДФЛ);
	
	// Типы налогов
	Данные.Вставить("ТипНалогаВС", Перечисления.ТипыНалогов.ВоенныйСбор);
	Данные.Вставить("ТипНалогаНДФЛ", Перечисления.ТипыНалогов.НДФЛ);
	
	// Способ отражения по умолчанию (fallback)
	Данные.Вставить("СпособОтраженияПоУмолчанию", ПолучитьСпособОтраженияПоУмолчанию());
	
	// Налог "ЕСВ ФОТ" - базовый для всех вариантов ЕСВ
	Данные.Вставить("НалогЕСВФОТ", Справочники.Налоги.НайтиПоНаименованию("ЕСВ ФОТ"));
	
	// КЛЮЧЕВОЕ: Распределение по подразделениям из Казны
	// Структура: Сотрудник → Налог → Структура(Подразделения, Итого)
	// где Подразделения = Соответствие(Подразделение → Структура(Сумма, СпособОтражения))
	Данные.Вставить("РаспределениеПоПодразделениям", 
		ПодготовитьРаспределениеПоПодразделениям(ДокОбъект));
	
	// Ключ для базовых начислений (где А_Налог пустой)
	Данные.Вставить("КлючБазовыеНачисления", "БазовыеНачисления");

	// НОВОЕ: Распределение налогов (НДФЛ/ВС) по сотрудникам
	// Собирает данные из строк А_РаспределениеКазна где СуммаНалогов > 0
	Данные.Вставить("РаспределениеНалоговПоСотрудникам",
		ПодготовитьРаспределениеНалоговПоСотрудникам(ДокОбъект));

	// Период для запроса к регистру (из шапки документа)
	Данные.Вставить("МесяцНачисления", ДокОбъект.МесяцНачисления);
	Данные.Вставить("Организация", ДокОбъект.Организация);

	Возврат Данные;
	
КонецФункции

// Получение способа отражения по умолчанию (fallback)
&НаСервере
Функция ПолучитьСпособОтраженияПоУмолчанию()
	
	Возврат Справочники.СпособыОтраженияЗарплатыВБухУчете.НайтиПоНаименованию("Зарплата производственного персонала");
	
КонецФункции

// Подготовка данных о распределении по подразделениям из А_РаспределениеКазна
//
// Возвращает: Соответствие(Сотрудник → Соответствие(Налог → Структура(Подразделения, Итого)))
//   где Подразделения = Соответствие(Подразделение → Структура(Сумма, СпособОтражения))
//   Специальный ключ "БазовыеНачисления" для строк где А_Налог пустой
&НаСервере
Функция ПодготовитьРаспределениеПоПодразделениям(ДокОбъект)
	
	Результат = Новый Соответствие;
	КлючБазовые = "БазовыеНачисления";
	
	Для Каждого СтрокаКазны Из ДокОбъект.А_РаспределениеКазна Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаКазны.СтатьяДвиженияДенежныхСредств) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаКазны.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Получаем А_Налог из статьи ДДС
		НалогСтатьи = СтрокаКазны.СтатьяДвиженияДенежныхСредств.А_Налог;
		
		// КЛЮЧЕВОЕ: Получаем СпособОтражения из статьи ДДС
		СпособОтражения = СтрокаКазны.СтатьяДвиженияДенежныхСредств.А_СпособОтраженияЗарплатыВБухучете;
		
		// Определяем ключ: если А_Налог пустой - используем специальный ключ
		Если ЗначениеЗаполнено(НалогСтатьи) Тогда
			КлючНалога = НалогСтатьи;
		Иначе
			КлючНалога = КлючБазовые;
		КонецЕсли;
		
		Сотрудник = СтрокаКазны.Сотрудник;
		Подразделение = СтрокаКазны.Подразделение;
		
		// Получаем или создаем структуру для сотрудника
		ДанныеСотрудника = Результат[Сотрудник];
		Если ДанныеСотрудника = Неопределено Тогда
			ДанныеСотрудника = Новый Соответствие;
			Результат.Вставить(Сотрудник, ДанныеСотрудника);
		КонецЕсли;
		
		// Получаем или создаем структуру для налога/ключа
		ДанныеНалога = ДанныеСотрудника[КлючНалога];
		Если ДанныеНалога = Неопределено Тогда
			ДанныеНалога = Новый Структура("Подразделения, Итого", Новый Соответствие, 0);
			ДанныеСотрудника.Вставить(КлючНалога, ДанныеНалога);
		КонецЕсли;
		
		// Получаем или создаем структуру для подразделения
		// НОВОЕ: Хранит Сумма + СпособОтражения
		ДанныеПодразделения = ДанныеНалога.Подразделения[Подразделение];
		Если ДанныеПодразделения = Неопределено Тогда
			ДанныеПодразделения = Новый Структура("Сумма, СпособОтражения", 0, СпособОтражения);
			ДанныеНалога.Подразделения.Вставить(Подразделение, ДанныеПодразделения);
		КонецЕсли;
		
		// Добавляем сумму
		ДанныеПодразделения.Сумма = ДанныеПодразделения.Сумма + СтрокаКазны.Сумма;
		
		// Обновляем СпособОтражения если пустой
		Если Не ЗначениеЗаполнено(ДанныеПодразделения.СпособОтражения) И ЗначениеЗаполнено(СпособОтражения) Тогда
			ДанныеПодразделения.СпособОтражения = СпособОтражения;
		КонецЕсли;
		
		// Увеличиваем итого
		ДанныеНалога.Итого = ДанныеНалога.Итого + СтрокаКазны.Сумма;
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

// Подготовка данных о распределении НАЛОГОВ (НДФЛ/ВС) по сотрудникам
// Собирает данные из строк А_РаспределениеКазна где СуммаНалогов > 0
//
// Возвращает: Соответствие(Сотрудник → Структура(Подразделения, Итого))
//   где Подразделения = Соответствие(Подразделение → Структура(Сумма, СпособОтражения))
&НаСервере
Функция ПодготовитьРаспределениеНалоговПоСотрудникам(ДокОбъект)

	Результат = Новый Соответствие;

	Для Каждого СтрокаКазны Из ДокОбъект.А_РаспределениеКазна Цикл

		// Фильтруем только строки где СуммаНалогов > 0 (это строки типа "Удержание с админ зарплату")
		Если СтрокаКазны.СуммаНалогов = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(СтрокаКазны.СтатьяДвиженияДенежныхСредств) Тогда
			Продолжить;
		КонецЕсли;

		// Получаем СпособОтражения из статьи ДДС
		СпособОтражения = СтрокаКазны.СтатьяДвиженияДенежныхСредств.А_СпособОтраженияЗарплатыВБухучете;

		Сотрудник = СтрокаКазны.Сотрудник;
		Подразделение = СтрокаКазны.Подразделение;
		СуммаНалогов = СтрокаКазны.СуммаНалогов;

		// Получаем или создаем структуру для сотрудника
		ДанныеСотрудника = Результат[Сотрудник];
		Если ДанныеСотрудника = Неопределено Тогда
			ДанныеСотрудника = Новый Структура("Подразделения, Итого", Новый Соответствие, 0);
			Результат.Вставить(Сотрудник, ДанныеСотрудника);
		КонецЕсли;

		// Получаем или создаем структуру для подразделения
		ДанныеПодразделения = ДанныеСотрудника.Подразделения[Подразделение];
		Если ДанныеПодразделения = Неопределено Тогда
			ДанныеПодразделения = Новый Структура("Сумма, СпособОтражения", 0, СпособОтражения);
			ДанныеСотрудника.Подразделения.Вставить(Подразделение, ДанныеПодразделения);
		КонецЕсли;

		// Добавляем сумму налогов
		ДанныеПодразделения.Сумма = ДанныеПодразделения.Сумма + СуммаНалогов;

		// Обновляем СпособОтражения если пустой
		Если Не ЗначениеЗаполнено(ДанныеПодразделения.СпособОтражения) И ЗначениеЗаполнено(СпособОтражения) Тогда
			ДанныеПодразделения.СпособОтражения = СпособОтражения;
		КонецЕсли;

		// Увеличиваем итого
		ДанныеСотрудника.Итого = ДанныеСотрудника.Итого + СуммаНалогов;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Получение физических лиц для сотрудников
&НаСервере
Функция ПолучитьФизическиеЛица(МассивСотрудников)
	
	Результат = Новый Соответствие;
	
	Если МассивСотрудников.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Ссылка В(&МассивСотрудников)";
	
	Запрос.УстановитьПараметр("МассивСотрудников", МассивСотрудников);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Сотрудник, Выборка.ФизическоеЛицо);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получение данных распределения для сотрудника и налога
// С учетом fallback:
//   1. Точный НалогСтатьяДДС
//   2. ЕСВ ФОТ (работники/инвалиды/...) → базовый "ЕСВ ФОТ"
//   3. Строки с пустым А_Налог (базовые начисления зарплаты)
&НаСервере
Функция ПолучитьДанныеРаспределения(Сотрудник, НалогДляПоиска, СправочныеДанные)
	
	РаспределениеПоПодразделениям = СправочныеДанные.РаспределениеПоПодразделениям;
	НалогЕСВФОТ = СправочныеДанные.НалогЕСВФОТ;
	КлючБазовые = СправочныеДанные.КлючБазовыеНачисления;
	
	ДанныеСотрудника = РаспределениеПоПодразделениям[Сотрудник];
	
	Если ДанныеСотрудника = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// 1. Пробуем найти по точному налогу
	Если ЗначениеЗаполнено(НалогДляПоиска) Тогда
		ДанныеНалога = ДанныеСотрудника[НалогДляПоиска];
		Если ДанныеНалога <> Неопределено И ДанныеНалога.Итого > 0 Тогда
			Возврат ДанныеНалога;
		КонецЕсли;
	КонецЕсли;
	
	// 2. Fallback: если налог начинается с "ЕСВ ФОТ" - ищем по базовому "ЕСВ ФОТ"
	Если ЗначениеЗаполнено(НалогДляПоиска) Тогда
		НаименованиеНалога = Строка(НалогДляПоиска);
		Если СтрНачинаетсяС(НаименованиеНалога, "ЕСВ ФОТ") И ЗначениеЗаполнено(НалогЕСВФОТ) Тогда
			ДанныеНалога = ДанныеСотрудника[НалогЕСВФОТ];
			Если ДанныеНалога <> Неопределено И ДанныеНалога.Итого > 0 Тогда
				Возврат ДанныеНалога;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// 3. Fallback: берем из базовых начислений (где А_Налог пустой)
	ДанныеНалога = ДанныеСотрудника[КлючБазовые];
	Если ДанныеНалога <> Неопределено И ДанныеНалога.Итого > 0 Тогда
		Возврат ДанныеНалога;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Получение данных распределения ТОЛЬКО из базовых начислений (где А_Налог пустой)
// Используется для начислений ЗП из регистра
&НаСервере
Функция ПолучитьДанныеРаспределенияБазовые(Сотрудник, СправочныеДанные)
	
	РаспределениеПоПодразделениям = СправочныеДанные.РаспределениеПоПодразделениям;
	КлючБазовые = СправочныеДанные.КлючБазовыеНачисления;
	
	ДанныеСотрудника = РаспределениеПоПодразделениям[Сотрудник];
	
	Если ДанныеСотрудника = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Берем только из базовых начислений (где А_Налог пустой)
	ДанныеНалога = ДанныеСотрудника[КлючБазовые];
	Если ДанныеНалога <> Неопределено И ДанныеНалога.Итого > 0 Тогда
		Возврат ДанныеНалога;
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции

// Получение данных распределения для НДФЛ/ВС (налогов где Сумма > 0 и СуммаФОТ = 0)
// Использует данные из А_РаспределениеКазна где СуммаНалогов > 0
&НаСервере
Функция ПолучитьДанныеРаспределенияНалогов(Сотрудник, СправочныеДанные)

	РаспределениеНалоговПоСотрудникам = СправочныеДанные.РаспределениеНалоговПоСотрудникам;

	ДанныеСотрудника = РаспределениеНалоговПоСотрудникам[Сотрудник];

	Если ДанныеСотрудника = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ДанныеСотрудника.Итого > 0 Тогда
		Возврат ДанныеСотрудника;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область ОбработкаДанных

// 1. НАЧИСЛЕНИЯ ИЗ НАЛОГОВ: А_РаспределениеНалоги → НачисленнаяЗарплатаИВзносыПоФизлицам
// ВАЖНО: Для НДФЛ/ВС (строки где Сумма > 0 и СуммаФОТ = 0)
//        СпособОтражения берется из строк А_РаспределениеКазна где СуммаНалогов > 0
&НаСервере
Функция ЗаполнитьНачисленияИзНалогов(ДокОбъект, СправочныеДанные)

	КоличествоДобавленных = 0;

	Для Каждого СтрокаНалога Из ДокОбъект.А_РаспределениеНалоги Цикл

		// Определяем сумму и куда записывать
		ЭтоСуммаФОТ = СтрокаНалога.СуммаФОТ <> 0;
		СуммаДляРаспределения = ?(ЭтоСуммаФОТ, СтрокаНалога.СуммаФОТ, СтрокаНалога.Сумма);

		Если СуммаДляРаспределения = 0 Тогда
			Продолжить;
		КонецЕсли;

		Сотрудник = СтрокаНалога.Сотрудник;

		// КЛЮЧЕВОЕ ИЗМЕНЕНИЕ: Определяем тип строки
		// Если Сумма > 0 и СуммаФОТ = 0 - это НДФЛ/ВС, нужно искать СпособОтражения
		// из строк А_РаспределениеКазна где СуммаНалогов > 0
		ЭтоНДФЛилиВС = СтрокаНалога.Сумма > 0 И СтрокаНалога.СуммаФОТ = 0;

		Если ЭтоНДФЛилиВС Тогда
			// Для НДФЛ/ВС используем новую функцию поиска
			ДанныеНалога = ПолучитьДанныеРаспределенияНалогов(Сотрудник, СправочныеДанные);
		Иначе
			// Для ЕСВ (СуммаФОТ > 0) используем старую логику с fallback
			НалогДляПоиска = СтрокаНалога.НалогСтатьяДвиженияДенежныхСредств;
			ДанныеНалога = ПолучитьДанныеРаспределения(Сотрудник, НалогДляПоиска, СправочныеДанные);
		КонецЕсли;

		Если ДанныеНалога = Неопределено Тогда
			// Нет данных о распределении - создаем одну строку без подразделения
			НоваяСтрока = ДокОбъект.НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
			ЗаполнитьСтрокуНачисления(НоваяСтрока, ДокОбъект, СтрокаНалога,
				СуммаДляРаспределения, Неопределено, Неопределено, ЭтоСуммаФОТ, СправочныеДанные);
			КоличествоДобавленных = КоличествоДобавленных + 1;
			Продолжить;
		КонецЕсли;

		// Распределяем сумму по подразделениям пропорционально
		КоличествоДобавленных = КоличествоДобавленных +
			РаспределитьСуммуПоПодразделениям(ДокОбъект, СтрокаНалога,
				СуммаДляРаспределения, ДанныеНалога, ЭтоСуммаФОТ, СправочныеДанные);

	КонецЦикла;

	Возврат КоличествоДобавленных;

КонецФункции

// Распределение суммы по подразделениям и создание строк
&НаСервере
Функция РаспределитьСуммуПоПодразделениям(ДокОбъект, СтрокаНалога, СуммаДляРаспределения, ДанныеНалога, ЭтоСуммаФОТ, СправочныеДанные)
	
	КоличествоДобавленных = 0;
	
	Итого = ДанныеНалога.Итого;
	ОстатокСуммы = СуммаДляРаспределения;
	СчетчикПодразделений = 0;
	КоличествоПодразделений = ДанныеНалога.Подразделения.Количество();
	
	Для Каждого КлючЗначение Из ДанныеНалога.Подразделения Цикл
		
		Подразделение = КлючЗначение.Ключ;
		ДанныеПодразделения = КлючЗначение.Значение; // Структура(Сумма, СпособОтражения)
		СуммаПодразделения = ДанныеПодразделения.Сумма;
		СпособОтражения = ДанныеПодразделения.СпособОтражения;
		
		СчетчикПодразделений = СчетчикПодразделений + 1;
		
		// Рассчитываем сумму для подразделения
		Если СчетчикПодразделений = КоличествоПодразделений Тогда
			// Последнее подразделение - берем остаток
			СуммаДляПодразделения = ОстатокСуммы;
		Иначе
			// Пропорциональное распределение
			Доля = СуммаПодразделения / Итого;
			СуммаДляПодразделения = Окр(СуммаДляРаспределения * Доля, 2);
			ОстатокСуммы = ОстатокСуммы - СуммаДляПодразделения;
		КонецЕсли;
		
		Если СуммаДляПодразделения = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Создаем строку
		НоваяСтрока = ДокОбъект.НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
		ЗаполнитьСтрокуНачисления(НоваяСтрока, ДокОбъект, СтрокаНалога,
			СуммаДляПодразделения, Подразделение, СпособОтражения, ЭтоСуммаФОТ, СправочныеДанные);
		
		КоличествоДобавленных = КоличествоДобавленных + 1;
		
	КонецЦикла;
	
	Возврат КоличествоДобавленных;
	
КонецФункции

// Заполнение одной строки НачисленнаяЗарплатаИВзносыПоФизлицам
&НаСервере
Процедура ЗаполнитьСтрокуНачисления(НоваяСтрока, ДокОбъект, СтрокаНалога, 
	Сумма, Подразделение, СпособОтражения, ЭтоСуммаФОТ, СправочныеДанные)
	
	НоваяСтрока.Организация = ДокОбъект.Организация;
	НоваяСтрока.ВидОперации = СправочныеДанные.ВидОперацииНачислено;
	НоваяСтрока.ГруппаУчетаНачислений = СправочныеДанные.ГруппаУчетаЗарплата;
	НоваяСтрока.ФизическоеЛицо = СправочныеДанные.ФизЛица[СтрокаНалога.Сотрудник];
	
	// КЛЮЧЕВОЕ: СпособОтражения из Казны (или fallback)
	Если ЗначениеЗаполнено(СпособОтражения) Тогда
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = СпособОтражения;
	Иначе
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = СправочныеДанные.СпособОтраженияПоУмолчанию;
	КонецЕсли;
	
	// Подразделение
	Если Подразделение <> Неопределено Тогда
		НоваяСтрока.ПодразделениеПредприятия = Подразделение;
	КонецЕсли;
	
	// Сумма или ВзносыВсего
	Если ЭтоСуммаФОТ Тогда
		// СуммаФОТ → ВзносыВсего, Налог = из А_РаспределениеНалоги
		НоваяСтрока.ВзносыВсего = Сумма;
		НоваяСтрока.Сумма = 0;
		НоваяСтрока.Налог = СтрокаНалога.Налог;
	Иначе
		// Сумма → Сумма, Налог = пусто
		НоваяСтрока.Сумма = Сумма;
		НоваяСтрока.ВзносыВсего = 0;
		// НоваяСтрока.Налог - пусто
	КонецЕсли;
	
КонецПроцедуры

// 2. НАЧИСЛЕНИЯ ЗП: ВзаиморасчетыССотрудниками → НачисленнаяЗарплатаИВзносыПоФизлицам
&НаСервере
Функция ЗаполнитьНачисленияЗПИзРегистра(ДокОбъект, СправочныеДанные)
	
	КоличествоДобавленных = 0;
	
	// Получаем данные из регистра ВзаиморасчетыССотрудниками
	МесяцНачисления = СправочныеДанные.МесяцНачисления;
	НачалоПериода = НачалоМесяца(МесяцНачисления);
	КонецПериода = КонецМесяца(МесяцНачисления);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВзаиморасчетыССотрудниками.Сотрудник КАК Сотрудник,
	|	СУММА(ВзаиморасчетыССотрудниками.СуммаВзаиморасчетов) КАК СуммаВзаиморасчетов
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыССотрудниками КАК ВзаиморасчетыССотрудниками
	|ГДЕ
	|	ВзаиморасчетыССотрудниками.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ВзаиморасчетыССотрудниками.Регистратор ССЫЛКА Документ.НачислениеЗарплаты
	|СГРУППИРОВАТЬ ПО
	|	ВзаиморасчетыССотрудниками.Сотрудник";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат 0;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Сотрудник = Выборка.Сотрудник;
		СуммаЗП = Выборка.СуммаВзаиморасчетов;
		
		Если СуммаЗП = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Получаем распределение ТОЛЬКО из базовых начислений (где А_Налог пустой)
		ДанныеРаспределения = ПолучитьДанныеРаспределенияБазовые(Сотрудник, СправочныеДанные);
		
		Если ДанныеРаспределения = Неопределено Тогда
			// Нет данных о распределении - создаем одну строку без подразделения
			НоваяСтрока = ДокОбъект.НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
			ЗаполнитьСтрокуНачисленияЗП(НоваяСтрока, ДокОбъект, Сотрудник, 
				СуммаЗП, Неопределено, Неопределено, СправочныеДанные);
			КоличествоДобавленных = КоличествоДобавленных + 1;
			Продолжить;
		КонецЕсли;
		
		// Распределяем сумму ЗП по подразделениям пропорционально
		Итого = ДанныеРаспределения.Итого;
		ОстатокСуммы = СуммаЗП;
		СчетчикПодразделений = 0;
		КоличествоПодразделений = ДанныеРаспределения.Подразделения.Количество();
		
		Для Каждого КлючЗначение Из ДанныеРаспределения.Подразделения Цикл
			
			Подразделение = КлючЗначение.Ключ;
			ДанныеПодразделения = КлючЗначение.Значение; // Структура(Сумма, СпособОтражения)
			СуммаПодразделения = ДанныеПодразделения.Сумма;
			СпособОтражения = ДанныеПодразделения.СпособОтражения;
			
			СчетчикПодразделений = СчетчикПодразделений + 1;
			
			// Рассчитываем сумму для подразделения
			Если СчетчикПодразделений = КоличествоПодразделений Тогда
				// Последнее подразделение - берем остаток
				СуммаДляПодразделения = ОстатокСуммы;
			Иначе
				// Пропорциональное распределение
				Доля = СуммаПодразделения / Итого;
				СуммаДляПодразделения = Окр(СуммаЗП * Доля, 2);
				ОстатокСуммы = ОстатокСуммы - СуммаДляПодразделения;
			КонецЕсли;
			
			Если СуммаДляПодразделения = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			// Создаем строку
			НоваяСтрока = ДокОбъект.НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
			ЗаполнитьСтрокуНачисленияЗП(НоваяСтрока, ДокОбъект, Сотрудник,
				СуммаДляПодразделения, Подразделение, СпособОтражения, СправочныеДанные);
			
			КоличествоДобавленных = КоличествоДобавленных + 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат КоличествоДобавленных;
	
КонецФункции

// Заполнение одной строки НачисленнаяЗарплатаИВзносыПоФизлицам для ЗП из регистра
&НаСервере
Процедура ЗаполнитьСтрокуНачисленияЗП(НоваяСтрока, ДокОбъект, Сотрудник, 
	Сумма, Подразделение, СпособОтражения, СправочныеДанные)
	
	НоваяСтрока.Организация = ДокОбъект.Организация;
	НоваяСтрока.ВидОперации = СправочныеДанные.ВидОперацииНачислено;
	НоваяСтрока.ГруппаУчетаНачислений = СправочныеДанные.ГруппаУчетаЗарплата;
	НоваяСтрока.ФизическоеЛицо = СправочныеДанные.ФизЛица[Сотрудник];
	
	// КЛЮЧЕВОЕ: СпособОтражения из Казны (или fallback)
	Если ЗначениеЗаполнено(СпособОтражения) Тогда
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = СпособОтражения;
	Иначе
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = СправочныеДанные.СпособОтраженияПоУмолчанию;
	КонецЕсли;
	
	// Подразделение
	Если Подразделение <> Неопределено Тогда
		НоваяСтрока.ПодразделениеПредприятия = Подразделение;
	КонецЕсли;
	
	// Сумма ЗП → поле Сумма, ВзносыВсего = 0, Налог = пусто
	НоваяСтрока.Сумма = Сумма;
	НоваяСтрока.ВзносыВсего = 0;
	// НоваяСтрока.Налог - пусто
	
КонецПроцедуры

// 3. НДФЛ: А_РаспределениеНалоги → НачисленныйНДФЛ
// Только строки с Сумма > 0 (НДФЛ, Военный сбор)
&НаСервере
Функция ЗаполнитьНДФЛИзНалогов(ДокОбъект, СправочныеДанные)
	
	КоличествоДобавленных = 0;
	
	Для Каждого СтрокаНалога Из ДокОбъект.А_РаспределениеНалоги Цикл
		
		// В НачисленныйНДФЛ идут только строки с Сумма > 0 (не СуммаФОТ!)
		Если СтрокаНалога.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Сотрудник = СтрокаНалога.Сотрудник;
		СуммаНалога = СтрокаНалога.Сумма;
		
		// Определяем вид операции и тип налога
		Если СтрокаНалога.ТипНалога = СправочныеДанные.ТипНалогаВС Тогда
			ВидОперации = СправочныеДанные.ВидОперацииВоенныйСбор;
			ТипНалога = СправочныеДанные.ТипНалогаВС;
		Иначе
			ВидОперации = СправочныеДанные.ВидОперацииНДФЛ;
			ТипНалога = СправочныеДанные.ТипНалогаНДФЛ;
		КонецЕсли;
		
		// НалогСтатьяДвиженияДенежныхСредств - ключ для поиска % распределения
		НалогДляПоиска = СтрокаНалога.НалогСтатьяДвиженияДенежныхСредств;
		
		// Получаем данные о распределении по подразделениям (с fallback)
		ДанныеНалога = ПолучитьДанныеРаспределения(Сотрудник, НалогДляПоиска, СправочныеДанные);
		
		Если ДанныеНалога = Неопределено Тогда
			// Нет данных о распределении - создаем одну строку без подразделения
			НоваяСтрока = ДокОбъект.НачисленныйНДФЛ.Добавить();
			ЗаполнитьСтрокуНДФЛ(НоваяСтрока, ДокОбъект, СтрокаНалога, СуммаНалога, 
				Неопределено, Неопределено, ВидОперации, ТипНалога, СправочныеДанные);
			КоличествоДобавленных = КоличествоДобавленных + 1;
			Продолжить;
		КонецЕсли;
		
		// Распределяем сумму по подразделениям пропорционально
		Итого = ДанныеНалога.Итого;
		ОстатокСуммы = СуммаНалога;
		СчетчикПодразделений = 0;
		КоличествоПодразделений = ДанныеНалога.Подразделения.Количество();
		
		Для Каждого КлючЗначение Из ДанныеНалога.Подразделения Цикл
			
			Подразделение = КлючЗначение.Ключ;
			ДанныеПодразделения = КлючЗначение.Значение; // Структура(Сумма, СпособОтражения)
			СуммаПодразделения = ДанныеПодразделения.Сумма;
			СпособОтражения = ДанныеПодразделения.СпособОтражения;
			
			СчетчикПодразделений = СчетчикПодразделений + 1;
			
			// Рассчитываем сумму для подразделения
			Если СчетчикПодразделений = КоличествоПодразделений Тогда
				// Последнее подразделение - берем остаток
				СуммаДляПодразделения = ОстатокСуммы;
			Иначе
				// Пропорциональное распределение
				Доля = СуммаПодразделения / Итого;
				СуммаДляПодразделения = Окр(СуммаНалога * Доля, 2);
				ОстатокСуммы = ОстатокСуммы - СуммаДляПодразделения;
			КонецЕсли;
			
			Если СуммаДляПодразделения = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			// Создаем строку в НачисленныйНДФЛ
			НоваяСтрока = ДокОбъект.НачисленныйНДФЛ.Добавить();
			ЗаполнитьСтрокуНДФЛ(НоваяСтрока, ДокОбъект, СтрокаНалога, СуммаДляПодразделения,
				Подразделение, СпособОтражения, ВидОперации, ТипНалога, СправочныеДанные);
			
			КоличествоДобавленных = КоличествоДобавленных + 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат КоличествоДобавленных;
	
КонецФункции

// Заполнение одной строки НачисленныйНДФЛ
&НаСервере
Процедура ЗаполнитьСтрокуНДФЛ(НоваяСтрока, ДокОбъект, СтрокаНалога, Сумма, 
	Подразделение, СпособОтражения, ВидОперации, ТипНалога, СправочныеДанные)
	
	НоваяСтрока.Организация = ДокОбъект.Организация;
	НоваяСтрока.Сумма = Сумма;
	НоваяСтрока.ВидОперации = ВидОперации;
	НоваяСтрока.ТипНалога = ТипНалога;
	НоваяСтрока.КодДохода = СтрокаНалога.КодДохода;
	НоваяСтрока.ГруппаУчетаНачислений = СправочныеДанные.ГруппаУчетаЗарплата;
	НоваяСтрока.ФизическоеЛицо = СправочныеДанные.ФизЛица[СтрокаНалога.Сотрудник];
	
	// Подразделение
	Если Подразделение <> Неопределено Тогда
		НоваяСтрока.ПодразделениеПредприятия = Подразделение;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Свертка

// Формирование сводной таблицы
&НаСервере
Процедура СформироватьСводнуюТаблицу(ДокОбъект)
	
	ТаблицаДетали = ДокОбъект.НачисленнаяЗарплатаИВзносыПоФизлицам.Выгрузить();
	
	ТаблицаДетали.Свернуть(
		"Организация, ПодразделениеПредприятия, ВидОперации, СпособОтраженияЗарплатыВБухучете, ГруппаУчетаНачислений, Налог",
		"Сумма, ВзносыВсего");
	
	Для Каждого СтрокаСводки Из ТаблицаДетали Цикл
		НоваяСтрока = ДокОбъект.НачисленнаяЗарплатаИВзносы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСводки);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
