КонецПроцедуры	

Функция ОпределитьСчетУчетаБУ(текНоменклатура,СчетаНоменклатуры)
	
	
	нужнаяСтрока =СчетаНоменклатуры.Найти(текНоменклатура); 
	Если нужнаяСтрока=Неопределено Тогда
		Запрос  = Новый Запрос;
		Запрос.Текст=    "ВЫБРАТЬ
		|	ХозрасчетныйОстатки.Счет
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(, Счет В (&СпСчетов), , Субконто1 = &Субконто1) КАК ХозрасчетныйОстатки"    ;
		СпСчетов= Новый СписокЗначений;
		СпСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("201"));
		СпСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("203"));
		СпСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("205"));
		СпСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("206"));
		СпСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("207"));
		СпСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("209"));
		СпСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("221"));
		СпСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("281"));
		
		ЗАпрос.УстановитьПараметр("СпСчетов",СпСчетов);
		ЗАпрос.УстановитьПараметр("Субконто1",текНоменклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			нСтр =  СчетаНоменклатуры.Добавить();
			нСтр.Счет=Выборка.Счет;
			нСтр.Номенклатура=текНоменклатура;
			Возврат     Выборка.Счет;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе 
		Возврат   нужнаяСтрока.Счет;
	КонецЕсли;
	
	
КонецФункции // ()

&НаКлиенте
Процедура Перечитать()
	
	Если НЕ ВладелецФормы=Неопределено Тогда
		ВладелецФормы.Прочитать(); // Если обработка вызывалась из документа, то нужно перечитать изменения, чтобы пользователь видел результат обработки
	КонецЕсли;
	
КонецПроцедуры
