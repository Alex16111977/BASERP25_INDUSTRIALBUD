		локТЗ.Свернуть("Номенклатура,Коэффициент,ЕдиницаИзмерения,НалоговоеНазначение,"+СтрокаНазваниеСчета,"Количество");
		Объект[НазваниеТЧ].Загрузить(локТЗ);
	КонецЕсли;
