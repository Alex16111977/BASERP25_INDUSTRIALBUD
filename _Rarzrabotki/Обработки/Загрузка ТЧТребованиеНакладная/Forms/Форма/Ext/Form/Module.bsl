	//Иначе 	
	//	НазваниеТЧ="Материалы";
	//	СтрокаНазваниеСчета="Счет";
	//КонецЕсли;
	
	
	//  Если Объект[НазваниеТЧ].Количество()>0 Тогда
	//Если Вопрос("Очистить документ перед заполнением?", РежимДиалогаВопрос.ДаНет)=КодВозвратаДиалога.Да Тогда
	//	Объект[НазваниеТЧ].Очистить();
	//КонецЕсли;
	СчетаНоменклатуры= Новый ТаблицаЗначений;
	СчетаНоменклатуры.Колонки.Добавить("Счет");
	СчетаНоменклатуры.Колонки.Добавить("Номенклатура");
	
	
	Для Каждого СтрокаСоответствия  Из Объект.ТчЗагрузка Цикл
		//********на сервере
		текНоменклатура =  ""  ;
		
		текНоменклатура = Справочники.Номенклатура.НайтиПоКоду(СтрокаСоответствия.КодНоменлатуры);
		
		Если НЕ ЗначениеЗаполнено(текНоменклатура) Тогда
			Сообщить("Не найдена номенклатура с кодом "+СтрокаСоответствия.КодНоменлатуры);
		Иначе
			нСтр = ДокОбъект[НазваниеТЧ].Добавить();
			нСтр.Номенклатура= текНоменклатура;
			нСтр.Количество= СтрокаСоответствия.КвоДляСписания;
			нСтр.Коэффициент= 1;
			нСтр.ЕдиницаИзмерения= текНоменклатура.БазоваяЕдиницаИзмерения;
			СчетУчетаБУ=ОпределитьСчетУчетаБУ(текНоменклатура,СчетаНоменклатуры);
			Если НазваниеТЧ="Товары" ИЛИ НазваниеТЧ="Комплектующие" Тогда
				нСтр.СчетУчетаБУ=СчетУчетаБУ;
			Иначе	
				нСтр.Счет=СчетУчетаБУ;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НазваниеНовыйСчетУчетаБУ) Тогда
				нСтр.НовыйСчетУчетаБУ=СчетУчетаБУ;
