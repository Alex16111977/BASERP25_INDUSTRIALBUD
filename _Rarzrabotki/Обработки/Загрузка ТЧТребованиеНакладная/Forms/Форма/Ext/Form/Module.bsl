			//нСтр.НалоговоеНазначение=Справочники.НалоговыеНазначенияАктивовИЗатрат.НДС_Облагаемая;
		КонецЕсли;
	КонецЦикла;
	//ТекСтр=ТекСтр+1;
	
	ДокОбъект.Записать();
