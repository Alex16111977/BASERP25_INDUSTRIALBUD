
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТКА: Заполнить код UUID в справочниках
// Описание: Заполняет поле А_ИдКод значением UUID для элементов справочников
// Справочники: ФизическиеЛица, Склады, ДоговорыКонтрагентов, Номенклатура, Контрагенты
// Запускать: Непосредственно в базе бухгалтерии BuhBud
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьКодUUIDВСправочниках(Команда)
    
    // Підтвердження операції
    ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьЗавершение", ЭтотОбъект);
    ПоказатьВопрос(ОписаниеОповещения,
        "Заполнить поле А_ИдКод (UUID) во всех справочниках?
        |
        |Будут обработаны справочники:
        | - Физические лица
        | - Склады
        | - Договоры контрагентов
        | - Номенклатура
        | - Контрагенты
        |
        |Это может занять несколько минут.",
        РежимДиалогаВопрос.ДаНет,
        ,
        КодВозвратаДиалога.Нет,
        "Заполнение UUID");
    
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    Если Результат <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
    
    // Показати стан
    Состояние("Обработка справочников...");
    
    Попытка
        СтруктураРезультата = ЗаполнитьКодUUIDВСправочникахНаСервере();
        
        // Формування повідомлення про результат
        ТекстРезультата = "========== РЕЗУЛЬТАТ ЗАПОЛНЕНИЯ UUID ==========
        |
        |Физические лица: обновлено " + СтруктураРезультата.ФизическиеЛица + " элементов
        |Склады: обновлено " + СтруктураРезультата.Склады + " элементов
        |Договоры контрагентов: обновлено " + СтруктураРезультата.ДоговорыКонтрагентов + " элементов
        |Номенклатура: обновлено " + СтруктураРезультата.Номенклатура + " элементов
        |Контрагенты: обновлено " + СтруктураРезультата.Контрагенты + " элементов
        |
        |ВСЕГО обновлено: " + СтруктураРезультата.Всего + " элементов
        |Ошибок: " + СтруктураРезультата.Ошибок;
        
        ПоказатьПредупреждение(, ТекстРезультата);
        
    Исключение
        ПоказатьПредупреждение(, "Ошибка выполнения: " + ОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаполнитьКодUUIDВСправочникахНаСервере()
    
    // Структура результата
    Результат = Новый Структура;
    Результат.Вставить("ФизическиеЛица", 0);
    Результат.Вставить("Склады", 0);
    Результат.Вставить("ДоговорыКонтрагентов", 0);
    Результат.Вставить("Номенклатура", 0);
    Результат.Вставить("Контрагенты", 0);
    Результат.Вставить("Всего", 0);
    Результат.Вставить("Ошибок", 0);
    
    // Обробка справочника ФизическиеЛица
    Сообщить("Обработка справочника: Физические лица...");
    Результат.ФизическиеЛица = ОбработатьСправочник("ФизическиеЛица", Результат.Ошибок);
    
    // Обробка справочника Склады
    Сообщить("Обработка справочника: Склады...");
    Результат.Склады = ОбработатьСправочник("Склады", Результат.Ошибок);
    
    // Обробка справочника ДоговорыКонтрагентов
    Сообщить("Обработка справочника: Договоры контрагентов...");
    Результат.ДоговорыКонтрагентов = ОбработатьСправочник("ДоговорыКонтрагентов", Результат.Ошибок);
    
    // Обробка справочника Номенклатура
    Сообщить("Обработка справочника: Номенклатура...");
    Результат.Номенклатура = ОбработатьСправочник("Номенклатура", Результат.Ошибок);
    
    // Обробка справочника Контрагенты
    Сообщить("Обработка справочника: Контрагенты...");
    Результат.Контрагенты = ОбработатьСправочник("Контрагенты", Результат.Ошибок);
    
    // Підрахунок загальної кількості
    Результат.Всего = Результат.ФизическиеЛица 
                    + Результат.Склады 
                    + Результат.ДоговорыКонтрагентов 
                    + Результат.Номенклатура 
                    + Результат.Контрагенты;
    
    Возврат Результат;
    
КонецФункции

&НаСервере
Функция ОбработатьСправочник(ИмяСправочника, СчетчикОшибок)
    
    КоличествоОбновлено = 0;
    
    Попытка
        
        // Выборка всіх елементів справочника
        Выборка = Справочники[ИмяСправочника].Выбрать();
        
        Пока Выборка.Следующий() Цикл
            
            Попытка
                
                // Отримання UUID елемента
                ИдКодНовый = СокрЛП(Выборка.Ссылка.УникальныйИдентификатор());
                
                // Перевірка чи потрібно оновлювати
                Если СокрЛП(Выборка.А_ИдКод) <> ИдКодНовый Тогда
                    
                    // Отримання об'єкта для запису
                    ОбъектСправочника = Выборка.Ссылка.ПолучитьОбъект();
                    ОбъектСправочника.А_ИдКод = ИдКодНовый;
                    
                    // Запис без контролю обміну даними
                    ОбъектСправочника.ОбменДанными.Загрузка = Истина;
                    ОбъектСправочника.Записать();
                    
                    КоличествоОбновлено = КоличествоОбновлено + 1;
                    
                КонецЕсли;
                
            Исключение
                СчетчикОшибок = СчетчикОшибок + 1;
                Сообщить("Ошибка обработки " + ИмяСправочника + " (" + Выборка.Код + "): " + ОписаниеОшибки());
            КонецПопытки;
            
        КонецЦикла;
        
    Исключение
        СчетчикОшибок = СчетчикОшибок + 1;
        Сообщить("Ошибка обработки справочника " + ИмяСправочника + ": " + ОписаниеОшибки());
    КонецПопытки;
    
    Сообщить("  -> " + ИмяСправочника + ": обновлено " + КоличествоОбновлено + " элементов");
    
    Возврат КоличествоОбновлено;
    
КонецФункции

#КонецОбласти
