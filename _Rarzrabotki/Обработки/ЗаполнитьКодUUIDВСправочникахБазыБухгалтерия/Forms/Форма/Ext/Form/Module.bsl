
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТКА: Заполнить код UUID в справочниках
// Описание: Заполняет поле А_ИдКод значением UUID для элементов справочников
// Справочники: ФизическиеЛица, Склады, ДоговорыКонтрагентов, Номенклатура,
//              Контрагенты, ОсновныеСредства, НематериальныеАктивы
// Запускать: Непосредственно в базе бухгалтерии BuhBud
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДобавитьСправочник("ФизическиеЛица", "Физические лица");
	ДобавитьСправочник("Склады", "Склады");
	ДобавитьСправочник("ДоговорыКонтрагентов", "Договоры контрагентов");
	ДобавитьСправочник("Номенклатура", "Номенклатура");
	ДобавитьСправочник("Контрагенты", "Контрагенты");
	ДобавитьСправочник("ОсновныеСредства", "Основные средства");
	ДобавитьСправочник("НематериальныеАктивы", "Нематериальные активы");

КонецПроцедуры

&НаСервере
Процедура ДобавитьСправочник(ИмяСправочника, Представление)

	НоваяСтрока = СписокСправочников.Добавить();
	НоваяСтрока.Пометка = Истина;
	НоваяСтрока.ИмяСправочника = ИмяСправочника;
	НоваяСтрока.Представление = Представление;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для Каждого Строка Из СписокСправочников Цикл
		Строка.Пометка = Истина;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметку(Команда)

	Для Каждого Строка Из СписокСправочников Цикл
		Строка.Пометка = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКодUUIDВСправочниках(Команда)

	// Собрать список отмеченных справочников
	СписокОтмеченных = Новый Массив;
	ТекстСписка = "";
	Для Каждого Строка Из СписокСправочников Цикл
		Если Строка.Пометка Тогда
			СписокОтмеченных.Добавить(Строка.ИмяСправочника);
			ТекстСписка = ТекстСписка + "
			| - " + Строка.Представление;
		КонецЕсли;
	КонецЦикла;

	Если СписокОтмеченных.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не отмечен ни один справочник для обработки!");
		Возврат;
	КонецЕсли;

    // Підтвердження операції
    ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьЗавершение", ЭтотОбъект);
    ПоказатьВопрос(ОписаниеОповещения,
        "Заполнить поле А_ИдКод (UUID) в выбранных справочниках?
        |
        |Будут обработаны справочники:" + ТекстСписка + "
        |
        |Это может занять несколько минут.",
        РежимДиалогаВопрос.ДаНет,
        ,
        КодВозвратаДиалога.Нет,
        "Заполнение UUID");

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗавершение(Результат, ДополнительныеПараметры) Экспорт

    Если Результат <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    // Показати стан
    Состояние("Обработка справочников...");

    Попытка
        СтруктураРезультата = ЗаполнитьКодUUIDВСправочникахНаСервере();

        // Формування повідомлення про результат
        ТекстРезультата = "========== РЕЗУЛЬТАТ ЗАПОЛНЕНИЯ UUID ==========";

		Для Каждого Строка Из СписокСправочников Цикл
			Если Строка.Пометка И СтруктураРезультата.Свойство(Строка.ИмяСправочника) Тогда
				ТекстРезультата = ТекстРезультата + "
				|" + Строка.Представление + ": обновлено " + СтруктураРезультата[Строка.ИмяСправочника] + " элементов";
			КонецЕсли;
		КонецЦикла;

		ТекстРезультата = ТекстРезультата + "
		|
		|ВСЕГО обновлено: " + СтруктураРезультата.Всего + " элементов
		|Ошибок: " + СтруктураРезультата.Ошибок;

        ПоказатьПредупреждение(, ТекстРезультата);

    Исключение
        ПоказатьПредупреждение(, "Ошибка выполнения: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаполнитьКодUUIDВСправочникахНаСервере()

    // Структура результата
    Результат = Новый Структура;
    Результат.Вставить("Всего", 0);
    Результат.Вставить("Ошибок", 0);

	// Обработать только отмеченные справочники
	Для Каждого Строка Из СписокСправочников Цикл
		Если НЕ Строка.Пометка Тогда
			Продолжить;
		КонецЕсли;

		Результат.Вставить(Строка.ИмяСправочника, 0);

		Сообщить("Обработка справочника: " + Строка.Представление + "...");
		Результат[Строка.ИмяСправочника] = ОбработатьСправочник(Строка.ИмяСправочника, Результат.Ошибок);
		Результат.Всего = Результат.Всего + Результат[Строка.ИмяСправочника];
	КонецЦикла;

    Возврат Результат;

КонецФункции

&НаСервере
Функция ОбработатьСправочник(ИмяСправочника, СчетчикОшибок)

    КоличествоОбновлено = 0;

    Попытка

        // Выборка всіх елементів справочника
        Выборка = Справочники[ИмяСправочника].Выбрать();

        Пока Выборка.Следующий() Цикл

            Попытка

                // Отримання UUID елемента
                ИдКодНовый = СокрЛП(Выборка.Ссылка.УникальныйИдентификатор());

                // Перевірка чи потрібно оновлювати
                Если СокрЛП(Выборка.А_ИдКод) <> ИдКодНовый Тогда

                    // Отримання об'єкта для запису
                    ОбъектСправочника = Выборка.Ссылка.ПолучитьОбъект();
                    ОбъектСправочника.А_ИдКод = ИдКодНовый;

                    // Запис без контролю обміну даними
                    ОбъектСправочника.ОбменДанными.Загрузка = Истина;
                    ОбъектСправочника.Записать();

                    КоличествоОбновлено = КоличествоОбновлено + 1;

                КонецЕсли;

            Исключение
                СчетчикОшибок = СчетчикОшибок + 1;
                Сообщить("Ошибка обработки " + ИмяСправочника + " (" + Выборка.Код + "): " + ОписаниеОшибки());
            КонецПопытки;

        КонецЦикла;

    Исключение
        СчетчикОшибок = СчетчикОшибок + 1;
        Сообщить("Ошибка обработки справочника " + ИмяСправочника + ": " + ОписаниеОшибки());
    КонецПопытки;

    Сообщить("  -> " + ИмяСправочника + ": обновлено " + КоличествоОбновлено + " элементов");

    Возврат КоличествоОбновлено;

КонецФункции

#КонецОбласти
