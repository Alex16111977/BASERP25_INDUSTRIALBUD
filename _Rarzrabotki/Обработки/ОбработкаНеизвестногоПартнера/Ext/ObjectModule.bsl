////////////////////////////////////////////////////////////////////////////////
// Обработка неизвестного партнера
// Модуль поиска и замены ссылок на НеизвестныйПартнер в документах
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполняет поиск документов со ссылкой на НеизвестныйПартнер
//
// Параметры:
//   ТолькоПоиск - Булево - Если Истина, только поиск без обработки
//
// Возвращаемое значение:
//   ТаблицаЗначений - Найденные документы
//
Функция НайтиДокументыСНеизвестнымПартнером(ТолькоПоиск = Истина) Экспорт

	НеизвестныйПартнер = Справочники.Партнеры.НеизвестныйПартнер;

	// Получаем все ссылки на НеизвестныйПартнер в базе — НайтиПоСсылкам требует Массив
	МассивПоиска = Новый Массив;
	МассивПоиска.Добавить(НеизвестныйПартнер);
	ТаблицаИспользования = НайтиПоСсылкам(МассивПоиска);

	// Таблица результатов
	ТаблицаРезультатов = Новый ТаблицаЗначений;
	ТаблицаРезультатов.Колонки.Добавить("Документ");
	ТаблицаРезультатов.Колонки.Добавить("ТипДокумента");
	ТаблицаРезультатов.Колонки.Добавить("Реквизит");
	ТаблицаРезультатов.Колонки.Добавить("ТаблицаИлиШапка");
	ТаблицаРезультатов.Колонки.Добавить("Контрагент");
	ТаблицаРезультатов.Колонки.Добавить("НовыйПартнер");
	ТаблицаРезультатов.Колонки.Добавить("Обработан");

	// НайтиПоСсылкам возвращает ТаблицуЗначений с колонками: Данные, Метаданные
	Для Каждого СтрокаРезультата Из ТаблицаИспользования Цикл

		ОбъектСсылка = СтрокаРезультата.Данные;

		// Работаем с документами и справочниками
		ЭтоДокумент = Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ОбъектСсылка));
		ЭтоСправочник = Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ОбъектСсылка));

		Если НЕ ЭтоДокумент И НЕ ЭтоСправочник Тогда
			Продолжить;
		КонецЕсли;

		ПолноеИмяМетаданных = СтрокаРезультата.Метаданные.ПолноеИмя();

		НоваяСтрока = ТаблицаРезультатов.Добавить();
		НоваяСтрока.Документ = ОбъектСсылка;
		НоваяСтрока.ТипДокумента = Строка(ТипЗнч(ОбъектСсылка));
		НоваяСтрока.Реквизит = ПолноеИмяМетаданных;
		НоваяСтрока.Обработан = Ложь;

		// Определяем тип использования (шапка или табличная часть)
		Если СтрНайти(ПолноеИмяМетаданных, "ТабличнаяЧасть") > 0 Тогда
			НоваяСтрока.ТаблицаИлиШапка = "ТабличнаяЧасть";
		Иначе
			НоваяСтрока.ТаблицаИлиШапка = "Шапка";
		КонецЕсли;

		// Пытаемся получить контрагента
		Попытка
			СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектСсылка, "Контрагент");
			НоваяСтрока.Контрагент = СтруктураРеквизитов.Контрагент;
		Исключение
			НоваяСтрока.Контрагент = Неопределено;
		КонецПопытки;

	КонецЦикла;

	// Сворачиваем дубли по документам
	ТаблицаРезультатов.Свернуть("Документ, ТипДокумента, ТаблицаИлиШапка, Контрагент", "");

	Возврат ТаблицаРезультатов;

КонецФункции

// Обрабатывает документ - заменяет НеизвестныйПартнер на партнера по контрагенту
//
// Параметры:
//   ДокументСсылка - ДокументСсылка - Ссылка на обрабатываемый документ
//   ТаблицаИлиШапка - Строка - "Шапка" или "ТабличнаяЧасть"
//
// Возвращаемое значение:
//   Структура - Результат обработки
//
Функция ОбработатьДокумент(ОбъектСсылка, ТаблицаИлиШапка = "") Экспорт

	Результат = Новый Структура("Успех, Сообщение, НовыйПартнер", Ложь, "", Неопределено);

	НеизвестныйПартнер = Справочники.Партнеры.НеизвестныйПартнер;
	ЭтоДокумент = Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ОбъектСсылка));

	Попытка

		ТекущийОбъект = ОбъектСсылка.ПолучитьОбъект();

		Если ТекущийОбъект = Неопределено Тогда
			Результат.Сообщение = "Не удалось получить объект";
			Возврат Результат;
		КонецЕсли;

		// Собираем ВСЕ реквизиты шапки, содержащие тип СправочникСсылка.Партнеры
		МетаданныеОбъекта = ТекущийОбъект.Метаданные();
		ТипПартнера = Тип("СправочникСсылка.Партнеры");
		РеквизитыПартнераШапки = Новый Массив;
		Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
			Если Реквизит.Тип.СодержитТип(ТипПартнера) Тогда
				РеквизитыПартнераШапки.Добавить(Реквизит.Имя);
			КонецЕсли;
		КонецЦикла;

		// Определяем контрагента шапки для получения партнера (может быть пустым!)
		ТипКонтрагента = Тип("СправочникСсылка.Контрагенты");
		КонтрагентШапки = Неопределено;

		// Если сам объект — это Контрагент, используем его ссылку
		Если ТипЗнч(ОбъектСсылка) = ТипКонтрагента Тогда
			КонтрагентШапки = ОбъектСсылка;
		КонецЕсли;

		// Пробуем найти контрагента в реквизитах шапки (любое поле типа Контрагенты)
		Если НЕ ЗначениеЗаполнено(КонтрагентШапки) Тогда
			Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
				Если Реквизит.Тип.СодержитТип(ТипКонтрагента) Тогда
					Попытка
						ЗначениеК = ТекущийОбъект[Реквизит.Имя];
						Если ТипЗнч(ЗначениеК) = ТипКонтрагента И ЗначениеЗаполнено(ЗначениеК) Тогда
							КонтрагентШапки = ЗначениеК;
							Прервать;
						КонецЕсли;
					Исключение
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// Для справочников (например ДоговорыКонтрагентов) контрагент может быть Владелец
		Если НЕ ЗначениеЗаполнено(КонтрагентШапки) Тогда
			Попытка
				Владелец = ТекущийОбъект.Владелец;
				Если ТипЗнч(Владелец) = ТипКонтрагента Тогда
					КонтрагентШапки = Владелец;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;

		// Проверяем битую ссылку контрагента шапки
		Если ЗначениеЗаполнено(КонтрагентШапки) Тогда
			Если КонтрагентШапки.ПолучитьОбъект() = Неопределено Тогда
				КонтрагентШапки = Неопределено;
			КонецЕсли;
		КонецЕсли;

		// Партнер шапки (может быть Неопределено, если контрагент шапки не найден)
		ПартнерШапки = Неопределено;
		Если ЗначениеЗаполнено(КонтрагентШапки) Тогда
			ПартнерШапки = ПолучитьИлиСоздатьПартнераПоКонтрагенту(КонтрагентШапки);
		КонецЕсли;

		// Кеш: Контрагент -> Партнер
		КешПартнеров = Новый Соответствие;
		Если ЗначениеЗаполнено(КонтрагентШапки) Тогда
			КешПартнеров.Вставить(КонтрагентШапки, ПартнерШапки);
		КонецЕсли;

		Изменен = Ложь;

		// === Универсальная обработка табличных частей ===
		Для Каждого ТЧ Из МетаданныеОбъекта.ТабличныеЧасти Цикл

			// Собираем реквизиты ТЧ типа Партнеры
			РеквизитыПартнераТЧ = Новый Массив;
			Для Каждого РеквизитТЧ Из ТЧ.Реквизиты Цикл
				Если РеквизитТЧ.Тип.СодержитТип(ТипПартнера) Тогда
					РеквизитыПартнераТЧ.Добавить(РеквизитТЧ.Имя);
				КонецЕсли;
			КонецЦикла;

			Если РеквизитыПартнераТЧ.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;

			// Собираем реквизиты ТЧ типа Контрагенты (для построчного определения партнера)
			РеквизитыКонтрагентаТЧ = Новый Массив;
			Для Каждого РеквизитТЧ Из ТЧ.Реквизиты Цикл
				Если РеквизитТЧ.Тип.СодержитТип(ТипКонтрагента) Тогда
					РеквизитыКонтрагентаТЧ.Добавить(РеквизитТЧ.Имя);
				КонецЕсли;
			КонецЦикла;

			ТабличнаяЧасть = ТекущийОбъект[ТЧ.Имя];

			Для Каждого Строка Из ТабличнаяЧасть Цикл
				Для Каждого ИмяРеквизита Из РеквизитыПартнераТЧ Цикл
					ЗначениеПоля = Строка[ИмяРеквизита];
					Если ЗначениеПоля <> НеизвестныйПартнер Тогда
						Продолжить;
					КонецЕсли;

					// Определяем контрагента СТРОКИ
					КонтрагентСтроки = Неопределено;
					Для Каждого ИмяКонтрагента Из РеквизитыКонтрагентаТЧ Цикл
						Попытка
							ЗначениеК = Строка[ИмяКонтрагента];
							Если ТипЗнч(ЗначениеК) = ТипКонтрагента И ЗначениеЗаполнено(ЗначениеК) Тогда
								КонтрагентСтроки = ЗначениеК;
								Прервать;
							КонецЕсли;
						Исключение
						КонецПопытки;
					КонецЦикла;

					// Определяем партнера: из строки или из шапки
					ПартнерДляЗамены = Неопределено;
					Если ЗначениеЗаполнено(КонтрагентСтроки) Тогда
						ПартнерДляЗамены = КешПартнеров.Получить(КонтрагентСтроки);
						Если ПартнерДляЗамены = Неопределено Тогда
							Если КонтрагентСтроки.ПолучитьОбъект() <> Неопределено Тогда
								ПартнерДляЗамены = ПолучитьИлиСоздатьПартнераПоКонтрагенту(КонтрагентСтроки);
								КешПартнеров.Вставить(КонтрагентСтроки, ПартнерДляЗамены);
							КонецЕсли;
						КонецЕсли;
					ИначеЕсли ЗначениеЗаполнено(ПартнерШапки) Тогда
						ПартнерДляЗамены = ПартнерШапки;
					КонецЕсли;

					Если ЗначениеЗаполнено(ПартнерДляЗамены) И ПартнерДляЗамены <> НеизвестныйПартнер Тогда
						Строка[ИмяРеквизита] = ПартнерДляЗамены;
						Изменен = Истина;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;

		КонецЦикла;

		// === Универсальная обработка шапки ===
		Если ЗначениеЗаполнено(ПартнерШапки) И ПартнерШапки <> НеизвестныйПартнер Тогда
			Для Каждого ИмяРеквизита Из РеквизитыПартнераШапки Цикл
				ЗначениеПоля = ТекущийОбъект[ИмяРеквизита];
				Если ЗначениеПоля = НеизвестныйПартнер Тогда
					ТекущийОбъект[ИмяРеквизита] = ПартнерШапки;
					Изменен = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// Если ничего не нашли и нет контрагента — сообщаем
		Если НЕ Изменен И НЕ ЗначениеЗаполнено(КонтрагентШапки) Тогда
			Результат.Сообщение = "Не удалось определить контрагента";
			Возврат Результат;
		КонецЕсли;

		Если Изменен Тогда
			// Устанавливаем флаги, чтобы ПередЗаписью не перезаписывал наши данные
			// (ОбновитьXXXПослеОбмена вызывается ДО проверки ОбменДанными.Загрузка)
			Попытка ТекущийОбъект.А_Обработан = Истина; Исключение КонецПопытки;
			Попытка ТекущийОбъект.А_ОбработанКазна = Истина; Исключение КонецПопытки;
			Попытка ТекущийОбъект.А_ВведенВЕРП = Истина; Исключение КонецПопытки;

			// Записываем через Загрузка — чтобы не вызывать подписки и обработчики проведения.
			ТекущийОбъект.ОбменДанными.Загрузка = Истина;
			Если ЭтоДокумент Тогда
				ТекущийОбъект.Записать(РежимЗаписиДокумента.Запись);
			Иначе
				ТекущийОбъект.Записать();
			КонецЕсли;

			Результат.Успех = Истина;
			Результат.НовыйПартнер = ПартнерШапки;
			Результат.Сообщение = "Успешно обработан";
		Иначе
			Результат.Успех = Истина;
			Результат.Сообщение = "Изменения не требуются";
		КонецЕсли;

	Исключение
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Получает партнера по контрагенту. Если партнер = НеизвестныйПартнер или пустой,
// создаёт нового партнера по наименованию контрагента и привязывает к контрагенту.
//
Функция ПолучитьИлиСоздатьПартнераПоКонтрагенту(КонтрагентСсылка)

	НеизвестныйПартнер = Справочники.Партнеры.НеизвестныйПартнер;

	// Сначала пробуем получить существующего партнера
	ПартнерИзКонтрагента = ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(КонтрагентСсылка);

	// Если партнер нормальный (не НеизвестныйПартнер и заполнен) — возвращаем его
	Если ЗначениеЗаполнено(ПартнерИзКонтрагента) И ПартнерИзКонтрагента <> НеизвестныйПартнер Тогда
		Возврат ПартнерИзКонтрагента;
	КонецЕсли;

	// Партнер = НеизвестныйПартнер или пустой — нужно создать нового
	ИмяКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КонтрагентСсылка, "Наименование");

	Если НЕ ЗначениеЗаполнено(ИмяКонтрагента) Тогда
		Возврат НеизвестныйПартнер;
	КонецЕсли;

	// Проверяем — может партнер с таким именем уже есть и он свободен
	НовыйПартнер = Неопределено;
	СуществующийПартнер = Справочники.Партнеры.НайтиПоНаименованию(ИмяКонтрагента, Истина);

	Если ЗначениеЗаполнено(СуществующийПартнер) И СуществующийПартнер <> НеизвестныйПартнер Тогда
		// Проверяем: этот партнер уже привязан к ДРУГОМУ контрагенту?
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Контрагенты.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.Партнер = &Партнер
			|	И Контрагенты.Ссылка <> &ТекущийКонтрагент";
		Запрос.УстановитьПараметр("Партнер", СуществующийПартнер);
		Запрос.УстановитьПараметр("ТекущийКонтрагент", КонтрагентСсылка);
		РезультатЗапроса = Запрос.Выполнить();

		Если РезультатЗапроса.Пустой() Тогда
			// Партнер не занят другим контрагентом — используем его
			НовыйПартнер = СуществующийПартнер;
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(НовыйПартнер) Тогда
		// Создаём нового партнера
		ПартнерОбъект = Справочники.Партнеры.СоздатьЭлемент();
		ПартнерОбъект.Наименование = ИмяКонтрагента;
		ПартнерОбъект.НаименованиеПолное = ИмяКонтрагента;

		Попытка
			ПартнерОбъект.Клиент = Истина;
			ПартнерОбъект.Поставщик = Истина;
		Исключение
		КонецПопытки;

		ПартнерОбъект.Записать();
		НовыйПартнер = ПартнерОбъект.Ссылка;
	КонецЕсли;

	// Привязываем контрагента к новому партнеру
	Попытка
		КонтрагентОбъект = КонтрагентСсылка.ПолучитьОбъект();
		Если КонтрагентОбъект <> Неопределено Тогда
			КонтрагентОбъект.Партнер = НовыйПартнер;
			КонтрагентОбъект.ОбменДанными.Загрузка = Истина;
			КонтрагентОбъект.Записать();
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат НовыйПартнер;

КонецФункции

// Обрабатывает табличные части документа
//
Функция ОбработатьТабличныеЧастиДокумента(ДокументОбъект, ПартнерПолученныйПоКонтрагенту)

	Изменен = Ложь;
	НеизвестныйПартнер = Справочники.Партнеры.НеизвестныйПартнер;

	// Получаем контрагента из базы для сравнения
	КонтрагентВБазе = Неопределено;
	Попытка
		Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
			СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОбъект.Ссылка, "Контрагент");
			КонтрагентВБазе = СтруктураРеквизитов.Контрагент;
		КонецЕсли;
	Исключение
		КонтрагентВБазе = Неопределено;
	КонецПопытки;

	// Перебираем все табличные части документа
	МетаданныеДокумента = ДокументОбъект.Метаданные();

	Для Каждого ТЧ Из МетаданныеДокумента.ТабличныеЧасти Цикл

		// Проверяем наличие реквизита Партнер в табличной части
		ЕстьРеквизитПартнер = ТЧ.Реквизиты.Найти("Партнер") <> Неопределено;

		Если НЕ ЕстьРеквизитПартнер Тогда
			Продолжить;
		КонецЕсли;

		// Обрабатываем строки табличной части
		ТабличнаяЧасть = ДокументОбъект[ТЧ.Имя];

		Для Каждого Строка Из ТабличнаяЧасть Цикл

			// Условие замены: партнер не заполнен ИЛИ партнер = НеизвестныйПартнер ИЛИ контрагент изменился
			КонтрагентИзменился = (КонтрагентВБазе <> Неопределено) И (КонтрагентВБазе <> ДокументОбъект.Контрагент);

			Если НЕ ЗначениеЗаполнено(Строка.Партнер)
				ИЛИ Строка.Партнер = НеизвестныйПартнер
				ИЛИ КонтрагентИзменился Тогда

				Строка.Партнер = ПартнерПолученныйПоКонтрагенту;

				Если НЕ ЗначениеЗаполнено(Строка.Партнер) Тогда
					Строка.Партнер = НеизвестныйПартнер;
				КонецЕсли;

				Изменен = Истина;

			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Возврат Изменен;

КонецФункции

// Обрабатывает шапку документа
//
Функция ОбработатьШапкуДокумента(ДокументОбъект, ПартнерПолученныйПоКонтрагенту)

	Изменен = Ложь;
	НеизвестныйПартнер = Справочники.Партнеры.НеизвестныйПартнер;

	// Проверяем наличие реквизита Партнер в шапке
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	ЕстьРеквизитПартнер = МетаданныеДокумента.Реквизиты.Найти("Партнер") <> Неопределено;

	Если НЕ ЕстьРеквизитПартнер Тогда
		Возврат Ложь;
	КонецЕсли;

	// Получаем контрагента из базы для сравнения
	КонтрагентВБазе = Неопределено;
	Попытка
		Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
			СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОбъект.Ссылка, "Контрагент");
			КонтрагентВБазе = СтруктураРеквизитов.Контрагент;
		КонецЕсли;
	Исключение
		КонтрагентВБазе = Неопределено;
	КонецПопытки;

	// Проверяем условия для замены
	Если ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда

		КонтрагентИзменился = (КонтрагентВБазе <> Неопределено) И (КонтрагентВБазе <> ДокументОбъект.Контрагент);

		Если НЕ ЗначениеЗаполнено(ДокументОбъект.Партнер)
			ИЛИ ДокументОбъект.Партнер = НеизвестныйПартнер
			ИЛИ КонтрагентИзменился Тогда

			ДокументОбъект.Партнер = ПартнерПолученныйПоКонтрагенту;

			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Партнер) Тогда
				ДокументОбъект.Партнер = НеизвестныйПартнер;
			КонецЕсли;

			Изменен = Истина;

		КонецЕсли;

	КонецЕсли;

	Возврат Изменен;

КонецФункции

#КонецОбласти
