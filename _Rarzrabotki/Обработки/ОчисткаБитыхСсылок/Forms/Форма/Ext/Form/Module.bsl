
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Анализ(Команда)
	АнализНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОчисткаБитыхСсылок(Команда)
	Если ТаблицаРезультатов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Сначала выполните анализ");
		Возврат;
	КонецЕсли;

	ОчисткаНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыНаСервере

&НаСервере
Процедура АнализНаСервере()

	ТаблицаРезультатов.Очистить();

	Запрос = Новый Запрос;

	// === Регистры накопления ===
	Для Каждого МетаРег Из Метаданные.РегистрыНакопления Цикл

		ИмяРегистра = МетаРег.Имя;
		ПолноеИмя = "РегистрНакопления." + ИмяРегистра;

		Попытка
			Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол ИЗ " + ПолноеИмя + " ГДЕ Регистратор.Ссылка ЕСТЬ NULL";
			Результат = Запрос.Выполнить().Выбрать();
			Результат.Следующий();
			КоличествоБитых = Результат.Кол;
		Исключение
			Продолжить;
		КонецПопытки;

		Если КоличествоБитых = 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ТаблицаРезультатов.Добавить();
		НоваяСтрока.ТипРегистра    = "Накопления";
		НоваяСтрока.ИмяРегистра    = ПолноеИмя;
		НоваяСтрока.КоличествоБитых = КоличествоБитых;
		НоваяСтрока.Очищено         = 0;
		НоваяСтрока.Ошибки          = 0;

	КонецЦикла;

	// === Регистры сведений (подчинённые регистратору) ===
	Для Каждого МетаРег Из Метаданные.РегистрыСведений Цикл

		Если МетаРег.РежимЗаписи <> Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
			Продолжить;
		КонецЕсли;

		ИмяРегистра = МетаРег.Имя;
		ПолноеИмя = "РегистрСведений." + ИмяРегистра;

		Попытка
			Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол ИЗ " + ПолноеИмя + " ГДЕ Регистратор.Ссылка ЕСТЬ NULL";
			Результат = Запрос.Выполнить().Выбрать();
			Результат.Следующий();
			КоличествоБитых = Результат.Кол;
		Исключение
			Продолжить;
		КонецПопытки;

		Если КоличествоБитых = 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ТаблицаРезультатов.Добавить();
		НоваяСтрока.ТипРегистра    = "Сведений";
		НоваяСтрока.ИмяРегистра    = ПолноеИмя;
		НоваяСтрока.КоличествоБитых = КоличествоБитых;
		НоваяСтрока.Очищено         = 0;
		НоваяСтрока.Ошибки          = 0;

	КонецЦикла;

	// === Регистры сведений (независимые) — битые ссылки в ИЗМЕРЕНИЯХ ===
	Для Каждого МетаРег Из Метаданные.РегистрыСведений Цикл

		Если МетаРег.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
			Продолжить; // уже обработан выше
		КонецЕсли;

		ИмяРегистра = МетаРег.Имя;
		ПолноеИмя = "РегистрСведений." + ИмяРегистра;

		// Перебираем измерения — ищем ссылочные типы
		Для Каждого МетаИзмерение Из МетаРег.Измерения Цикл

			ИмяИзмерения = МетаИзмерение.Имя;

			// Проверяем только измерения со ссылочными типами (документы, справочники)
			ЕстьСсылочныйТип = Ложь;
			Для Каждого ЭлементТипа Из МетаИзмерение.Тип.Типы() Цикл
				Если Документы.ТипВсеСсылки().СодержитТип(ЭлементТипа)
					ИЛИ Справочники.ТипВсеСсылки().СодержитТип(ЭлементТипа) Тогда
					ЕстьСсылочныйТип = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Если НЕ ЕстьСсылочныйТип Тогда
				Продолжить;
			КонецЕсли;

			Попытка
				Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол ИЗ " + ПолноеИмя
					+ " ГДЕ " + ИмяИзмерения + ".Ссылка ЕСТЬ NULL"
					+ " И " + ИмяИзмерения + " <> НЕОПРЕДЕЛЕНО";
				Результат = Запрос.Выполнить().Выбрать();
				Результат.Следующий();
				КоличествоБитых = Результат.Кол;
			Исключение
				Продолжить;
			КонецПопытки;

			Если КоличествоБитых = 0 Тогда
				Продолжить;
			КонецЕсли;

			НоваяСтрока = ТаблицаРезультатов.Добавить();
			НоваяСтрока.ТипРегистра    = "Свед.(изм.)";
			НоваяСтрока.ИмяРегистра    = ПолноеИмя + "." + ИмяИзмерения;
			НоваяСтрока.КоличествоБитых = КоличествоБитых;
			НоваяСтрока.Очищено         = 0;
			НоваяСтрока.Ошибки          = 0;

		КонецЦикла;

	КонецЦикла;

	// === Регистры бухгалтерии ===
	Для Каждого МетаРег Из Метаданные.РегистрыБухгалтерии Цикл

		ИмяРегистра = МетаРег.Имя;
		ПолноеИмя = "РегистрБухгалтерии." + ИмяРегистра;

		Попытка
			Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол ИЗ " + ПолноеИмя + " ГДЕ Регистратор.Ссылка ЕСТЬ NULL";
			Результат = Запрос.Выполнить().Выбрать();
			Результат.Следующий();
			КоличествоБитых = Результат.Кол;
		Исключение
			Продолжить;
		КонецПопытки;

		Если КоличествоБитых = 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ТаблицаРезультатов.Добавить();
		НоваяСтрока.ТипРегистра    = "Бухгалтерии";
		НоваяСтрока.ИмяРегистра    = ПолноеИмя;
		НоваяСтрока.КоличествоБитых = КоличествоБитых;
		НоваяСтрока.Очищено         = 0;
		НоваяСтрока.Ошибки          = 0;

	КонецЦикла;

	Если ТаблицаРезультатов.Количество() = 0 Тогда
		Сообщить("Битых ссылок не найдено!");
	Иначе
		Итого = 0;
		Для Каждого Стр Из ТаблицаРезультатов Цикл
			Итого = Итого + Стр.КоличествоБитых;
		КонецЦикла;
		Сообщить("Найдено " + Строка(Итого) + " битых записей в " + Строка(ТаблицаРезультатов.Количество()) + " регистрах");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОчисткаНаСервере()

	Запрос = Новый Запрос;
	ВсегоОчищено = 0;
	ВсегоОшибок  = 0;

	Для Каждого СтрокаТаблицы Из ТаблицаРезультатов Цикл

		Если СтрокаТаблицы.КоличествоБитых = 0 Тогда
			Продолжить;
		КонецЕсли;

		ПолноеИмя   = СтрокаТаблицы.ИмяРегистра;
		ТипРегистра = СтрокаТаблицы.ТипРегистра;

		Очищено = 0;
		Ошибки  = 0;

		Если ТипРегистра = "Свед.(изм.)" Тогда

			// Независимый регистр сведений — битые ссылки в измерении
			// ПолноеИмя = "РегистрСведений.ИмяРегистра.ИмяИзмерения"
			ЧастиИмени    = СтрРазделить(ПолноеИмя, ".");
			ИмяРег        = ЧастиИмени[1];
			ИмяИзмерения  = ЧастиИмени[2];
			ИмяРегПолное  = "РегистрСведений." + ИмяРег;

			// Получаем все измерения регистра для формирования ключа записи
			МетаРег = Метаданные.РегистрыСведений[ИмяРег];

			// Выбираем ВСЕ поля-измерения для битых записей
			СписокПолей = "";
			Для Каждого МетаИзм Из МетаРег.Измерения Цикл
				Если СписокПолей <> "" Тогда СписокПолей = СписокПолей + ", "; КонецЕсли;
				СписокПолей = СписокПолей + МетаИзм.Имя;
			КонецЦикла;

			Попытка
				Запрос.Текст = "ВЫБРАТЬ " + СписокПолей
					+ " ИЗ " + ИмяРегПолное
					+ " ГДЕ " + ИмяИзмерения + ".Ссылка ЕСТЬ NULL"
					+ " И " + ИмяИзмерения + " <> НЕОПРЕДЕЛЕНО";
				ТаблицаБитых = Запрос.Выполнить().Выгрузить();
			Исключение
				СтрокаТаблицы.Ошибки = СтрокаТаблицы.КоличествоБитых;
				Сообщить("ОШИБКА запроса " + ПолноеИмя + ": " + ОписаниеОшибки());
				Продолжить;
			КонецПопытки;

			Для Каждого СтрБитая Из ТаблицаБитых Цикл
				Попытка
					МенеджерЗаписи = РегистрыСведений[ИмяРег].СоздатьМенеджерЗаписи();
					Для Каждого МетаИзм Из МетаРег.Измерения Цикл
						МенеджерЗаписи[МетаИзм.Имя] = СтрБитая[МетаИзм.Имя];
					КонецЦикла;
					МенеджерЗаписи.Удалить();
					Очищено = Очищено + 1;
				Исключение
					Ошибки = Ошибки + 1;
					Если Ошибки <= 3 Тогда
						Сообщить("  ОШИБКА " + ПолноеИмя + ": " + ОписаниеОшибки());
					КонецЕсли;
				КонецПопытки;
			КонецЦикла;

		Иначе

			// Регистры с регистратором (накопления, сведений подчинённые, бухгалтерии)
			ЧастиИмени = СтрРазделить(ПолноеИмя, ".");
			ИмяРег     = ЧастиИмени[1];

			Попытка
				Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ Регистратор КАК Рег ИЗ " + ПолноеИмя + " ГДЕ Регистратор.Ссылка ЕСТЬ NULL";
				Результат = Запрос.Выполнить().Выбрать();
			Исключение
				СтрокаТаблицы.Ошибки = СтрокаТаблицы.КоличествоБитых;
				Сообщить("ОШИБКА запроса " + ПолноеИмя + ": " + ОписаниеОшибки());
				Продолжить;
			КонецПопытки;

			Пока Результат.Следующий() Цикл
				Попытка
					Если ТипРегистра = "Накопления" Тогда
						НаборЗаписей = РегистрыНакопления[ИмяРег].СоздатьНаборЗаписей();
					ИначеЕсли ТипРегистра = "Сведений" Тогда
						НаборЗаписей = РегистрыСведений[ИмяРег].СоздатьНаборЗаписей();
					ИначеЕсли ТипРегистра = "Бухгалтерии" Тогда
						НаборЗаписей = РегистрыБухгалтерии[ИмяРег].СоздатьНаборЗаписей();
					КонецЕсли;

					НаборЗаписей.Отбор.Регистратор.Установить(Результат.Рег);
					НаборЗаписей.Записать();
					Очищено = Очищено + 1;
				Исключение
					Ошибки = Ошибки + 1;
					Если Ошибки <= 3 Тогда
						Сообщить("  ОШИБКА " + ПолноеИмя + ": " + ОписаниеОшибки());
					КонецЕсли;
				КонецПопытки;
			КонецЦикла;

		КонецЕсли;

		СтрокаТаблицы.Очищено = Очищено;
		СтрокаТаблицы.Ошибки  = Ошибки;
		ВсегоОчищено = ВсегоОчищено + Очищено;
		ВсегоОшибок  = ВсегоОшибок  + Ошибки;

		Сообщить(ПолноеИмя + ": очищено " + Строка(Очищено) + " регистраторов, ошибок " + Строка(Ошибки));

	КонецЦикла;

	Сообщить("========================================");
	Сообщить("ИТОГО: очищено " + Строка(ВсегоОчищено) + " регистраторов, ошибок " + Строка(ВсегоОшибок));

КонецПроцедуры

#КонецОбласти
