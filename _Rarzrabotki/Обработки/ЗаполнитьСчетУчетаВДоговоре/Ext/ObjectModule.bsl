#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Обробка для заповнення реквізиту А_СчетУчетаБух в довіднику ДоговорыКонтрагентов
// на основі даних з бухгалтерської бази BuhBud
//
// Логіка: Отримуємо обороти з рахунків взаєморозрахунків в BuhBud,
// визначаємо рахунок з максимальним оборотом для кожного договору,
// та записуємо цей рахунок в поле А_СчетУчетаБух договору в ERP

// Процедура заповнює табличну частину Договоры даними з BuhBud
// Отримує обороти по рахунках взаєморозрахунків через COM-підключення
// Визначає рахунок для кожного договору по максимальному обороту
//
Процедура ЗаполнитьТаблицу() Экспорт

    Договоры.Очистить();


    // 2. Параметри підключення до бухгалтерської бази
    СтрокаПодключенияБух = А_ПодключенияБазСервер.СтрокаПодключения("bas_industrialbud");
    // 3. Створення COM-конектора
    V8 = Новый COMОбъект("V83.COMConnector");

    Попытка
        V83 = V8.Connect(СокрЛП(СтрокаПодключенияБух));
    Исключение
        ВызватьИсключение "Помилка підключення до бази BuhBud: " + ОписаниеОшибки();
    КонецПопытки;

    // 4. Формування списку рахунків для запиту
    Если НЕ ЗначениеЗаполнено(СчетаВзаиморасчетов) Тогда
        // Рахунки взаєморозрахунків з контрагентами
        СчетаВзаиморасчетов = "361,362,631,632,3711,3771,3772,601,602,6851,6852,6853,6855,681,684,655";
    КонецЕсли;

    // 5. Формування тексту запиту для отримання оборотів
    // КРИТИЧНО: Використовуємо динамічне визначення позиції субконто через ВидыСубконто
    ТекстЗапроса =
    "ВЫБРАТЬ
    |    ВложенныйЗапрос.ДоговорИдКод КАК ДоговорИдКод,
    |    ВложенныйЗапрос.ДоговорНаименование КАК ДоговорНаименование,
    |    ВложенныйЗапрос.КонтрагентИдКод КАК КонтрагентИдКод,
    |    ВложенныйЗапрос.КонтрагентНаименование КАК КонтрагентНаименование,
    |    ВложенныйЗапрос.СчетКод КАК СчетКод,
    |    СУММА(ВложенныйЗапрос.СуммаОборот) КАК СуммаОборот
    |ИЗ
    |    (ВЫБРАТЬ
    |        ВЫБОР
    |            КОГДА ПозицияДоговора.НомерСтроки = 1
    |                ТОГДА ВЫРАЗИТЬ(Обороты.Субконто1 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
    |            КОГДА ПозицияДоговора.НомерСтроки = 2
    |                ТОГДА ВЫРАЗИТЬ(Обороты.Субконто2 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
    |            КОГДА ПозицияДоговора.НомерСтроки = 3
    |                ТОГДА ВЫРАЗИТЬ(Обороты.Субконто3 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
    |            ИНАЧЕ """"
    |        КОНЕЦ КАК ДоговорИдКод,
    |        ВЫБОР
    |            КОГДА ПозицияДоговора.НомерСтроки = 1
    |                ТОГДА ВЫРАЗИТЬ(Обороты.Субконто1 КАК Справочник.ДоговорыКонтрагентов).Наименование
    |            КОГДА ПозицияДоговора.НомерСтроки = 2
    |                ТОГДА ВЫРАЗИТЬ(Обороты.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Наименование
    |            КОГДА ПозицияДоговора.НомерСтроки = 3
    |                ТОГДА ВЫРАЗИТЬ(Обороты.Субконто3 КАК Справочник.ДоговорыКонтрагентов).Наименование
    |            ИНАЧЕ """"
    |        КОНЕЦ КАК ДоговорНаименование,
    |        ВЫБОР
    |            КОГДА ПозицияКонтрагента.НомерСтроки = 1
    |                ТОГДА ВЫРАЗИТЬ(Обороты.Субконто1 КАК Справочник.Контрагенты).А_ИдКод
    |            КОГДА ПозицияКонтрагента.НомерСтроки = 2
    |                ТОГДА ВЫРАЗИТЬ(Обороты.Субконто2 КАК Справочник.Контрагенты).А_ИдКод
    |            КОГДА ПозицияКонтрагента.НомерСтроки = 3
    |                ТОГДА ВЫРАЗИТЬ(Обороты.Субконто3 КАК Справочник.Контрагенты).А_ИдКод
    |            ИНАЧЕ """"
    |        КОНЕЦ КАК КонтрагентИдКод,
    |        ВЫБОР
    |            КОГДА ПозицияКонтрагента.НомерСтроки = 1
    |                ТОГДА ВЫРАЗИТЬ(Обороты.Субконто1 КАК Справочник.Контрагенты).Наименование
    |            КОГДА ПозицияКонтрагента.НомерСтроки = 2
    |                ТОГДА ВЫРАЗИТЬ(Обороты.Субконто2 КАК Справочник.Контрагенты).Наименование
    |            КОГДА ПозицияКонтрагента.НомерСтроки = 3
    |                ТОГДА ВЫРАЗИТЬ(Обороты.Субконто3 КАК Справочник.Контрагенты).Наименование
    |            ИНАЧЕ """"
    |        КОНЕЦ КАК КонтрагентНаименование,
    |        Обороты.Счет.Код КАК СчетКод,
    |        Обороты.СуммаОборотДт + Обороты.СуммаОборотКт КАК СуммаОборот
    |    ИЗ
    |        РегистрБухгалтерии.Хозрасчетный.Обороты(
    |                &НачалоПериода,
    |                &КонецПериода,
    |                ,
    |                Счет.Код В (&СписокСчетов),
    |                ,
    |                ) КАК Обороты
    |            ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозицияДоговора
    |            ПО Обороты.Счет = ПозицияДоговора.Ссылка
    |                И (ПозицияДоговора.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры))
    |            ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозицияКонтрагента
    |            ПО Обороты.Счет = ПозицияКонтрагента.Ссылка
    |                И (ПозицияКонтрагента.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты))
    |    ) КАК ВложенныйЗапрос
    |ГДЕ
    |    ВложенныйЗапрос.ДоговорИдКод <> """"
    |
    |СГРУППИРОВАТЬ ПО
    |    ВложенныйЗапрос.ДоговорИдКод,
    |    ВложенныйЗапрос.ДоговорНаименование,
    |    ВложенныйЗапрос.КонтрагентИдКод,
    |    ВложенныйЗапрос.КонтрагентНаименование,
    |    ВложенныйЗапрос.СчетКод
    |
    |УПОРЯДОЧИТЬ ПО
    |    ДоговорИдКод,
    |    СуммаОборот УБЫВ";

    // 6. Виконання запиту в бухгалтерській базі
    Попытка
        Запрос = V83.NewObject("Запрос");
        Запрос.Текст = ТекстЗапроса;
        Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
        Запрос.УстановитьПараметр("КонецПериода", КонецДня(ОкончаниеПериода));

        // Формуємо масив кодів рахунків
        МассивСчетов = V83.NewObject("Массив");
        СписокКодов = СтрРазделить(СчетаВзаиморасчетов, ",", Ложь);
        Для Каждого КодСчета Из СписокКодов Цикл
            МассивСчетов.Добавить(СокрЛП(КодСчета));
        КонецЦикла;
        Запрос.УстановитьПараметр("СписокСчетов", МассивСчетов);

        РезультатЗапроса = Запрос.Выполнить();
        ТЗОбороты = РезультатЗапроса.Выгрузить();
    Исключение
        V83 = Неопределено;
        V8 = Неопределено;
        ВызватьИсключение "Помилка виконання запиту в базі BuhBud: " + ОписаниеОшибки();
    КонецПопытки;

    // 7. Серіалізація таблиці значень для передачі через COM
    Попытка
        стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗОбороты);
    Исключение
        V83 = Неопределено;
        V8 = Неопределено;
        ВызватьИсключение "Помилка серіалізації даних: " + ОписаниеОшибки();
    КонецПопытки;

    // 8. Відключення від бухгалтерської бази
    V83 = Неопределено;
    V8 = Неопределено;

    // 9. Десеріалізація таблиці значень в поточній базі
    ТаблицаОборотов = ЗначениеИзСтрокиВнутр(стр_ТЗ);

    // 10. Згортання по договору - для кожного договору беремо рахунок з максимальним оборотом
    // Таблиця вже відсортована по ДоговорИдКод, СуммаОборот DESC
    // тому перший запис для кожного договору - це рахунок з максимальним оборотом
    СоответствиеДоговоров = Новый Соответствие;

    Для Каждого СтрокаТЗ Из ТаблицаОборотов Цикл

        ДоговорКод = СокрЛП(СтрокаТЗ.ДоговорИдКод);

        // Пропускаємо якщо договір вже оброблений (перший запис = максимальний оборот)
        Если СоответствиеДоговоров.Получить(ДоговорКод) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;

        СоответствиеДоговоров.Вставить(ДоговорКод, Истина);

        // 10.1. Пошук договору в ERP по А_ИдКод
        ДоговорЕРП = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("А_ИдКод", ДоговорКод);

        Если НЕ ЗначениеЗаполнено(ДоговорЕРП) Тогда
            // Fallback: пошук по найменуванню + контрагенту
            КонтрагентКод = СокрЛП(СтрокаТЗ.КонтрагентИдКод);
            КонтрагентЕРП = Неопределено;
            Если НЕ ПустаяСтрока(КонтрагентКод) Тогда
                КонтрагентЕРП = Справочники.Контрагенты.НайтиПоРеквизиту("А_ИдКод", КонтрагентКод);
            КонецЕсли;

            Если ЗначениеЗаполнено(КонтрагентЕРП) И НЕ ПустаяСтрока(СтрокаТЗ.ДоговорНаименование) Тогда
                ЗапросДоговор = Новый Запрос;
                ЗапросДоговор.Текст =
                "ВЫБРАТЬ ПЕРВЫЕ 1
                |   Дог.Ссылка КАК Ссылка
                |ИЗ
                |   Справочник.ДоговорыКонтрагентов КАК Дог
                |ГДЕ
                |   Дог.Наименование = &Наименование
                |   И Дог.Контрагент = &Контрагент
                |   И НЕ Дог.ПометкаУдаления";
                ЗапросДоговор.УстановитьПараметр("Наименование", СокрЛП(СтрокаТЗ.ДоговорНаименование));
                ЗапросДоговор.УстановитьПараметр("Контрагент", КонтрагентЕРП);
                РезультатДог = ЗапросДоговор.Выполнить();
                Если НЕ РезультатДог.Пустой() Тогда
                    ВыборкаДог = РезультатДог.Выбрать();
                    ВыборкаДог.Следующий();
                    ДоговорЕРП = ВыборкаДог.Ссылка;
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;

        // Пропускаємо якщо договір не знайдено в ERP
        Если НЕ ЗначениеЗаполнено(ДоговорЕРП) Тогда
            Продолжить;
        КонецЕсли;

        // 10.2. Фільтрація: тільки договори з порожнім рахунком (якщо встановлено флаг)
        Если ТолькоПустые Тогда
            Если ЗначениеЗаполнено(ДоговорЕРП.А_СчетУчетаБух) Тогда
                Продолжить;
            КонецЕсли;
        КонецЕсли;

        // 10.3. Пошук рахунку в ERP по коду
        СчетКод = СокрЛП(СтрокаТЗ.СчетКод);
        СчетЕРП = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СчетКод);

        Если НЕ ЗначениеЗаполнено(СчетЕРП) Тогда
            Продолжить;
        КонецЕсли;

        // 10.4. Додавання рядка в табличну частину
        НоваяСтрока = Договоры.Добавить();
        НоваяСтрока.Договор = ДоговорЕРП;
        НоваяСтрока.Контрагент = ДоговорЕРП.Контрагент;
        НоваяСтрока.СчетУчета = СчетЕРП;
        НоваяСтрока.ТекущийСчет = ДоговорЕРП.А_СчетУчетаБух;
        НоваяСтрока.Обработано = Ложь;

    КонецЦикла;

    // 11. Виведення статистики
    Сообщить("Завантажено договорів: " + Договоры.Количество());

КонецПроцедуры

// Процедура оновлює реквізит А_СчетУчетаБух в договорах контрагентів
// на основе даних табличної частини Договоры
//
Процедура ОбновитьДоговоры() Экспорт

    КоличествоОбновленных = 0;
    КоличествоОшибок = 0;
    КоличествоПропущенных = 0;

    Для Каждого СтрокаДоговоры Из Договоры Цикл

        // Пропускаємо вже оброблені рядки
        Если СтрокаДоговоры.Обработано Тогда
            Продолжить;
        КонецЕсли;

        // Пропускаємо якщо рахунок не змінився
        Если СтрокаДоговоры.СчетУчета = СтрокаДоговоры.ТекущийСчет Тогда
            СтрокаДоговоры.Обработано = Истина;
            КоличествоПропущенных = КоличествоПропущенных + 1;
            Продолжить;
        КонецЕсли;

        Попытка

            СпрДоговор = СтрокаДоговоры.Договор.ПолучитьОбъект();

            Если СпрДоговор = Неопределено Тогда
                КоличествоОшибок = КоличествоОшибок + 1;
                Сообщить("Договір не знайдено: " + СтрокаДоговоры.Договор);
                Продолжить;
            КонецЕсли;

            // Оновлюємо рахунок бухобліку в договорі
            СпрДоговор.А_СчетУчетаБух = СтрокаДоговоры.СчетУчета;

            // Записуємо без перевірок і обробників подій
            СпрДоговор.ОбменДанными.Загрузка = Истина;
            СпрДоговор.Записать();

            СтрокаДоговоры.Обработано = Истина;
            КоличествоОбновленных = КоличествоОбновленных + 1;

        Исключение
            КоличествоОшибок = КоличествоОшибок + 1;
            Сообщить("Помилка при оновленні " + СтрокаДоговоры.Договор + ": " + ОписаниеОшибки());
        КонецПопытки;

    КонецЦикла;

    // Виведення результатів
    Сообщить("===============================================");
    Сообщить("Оновлено договорів: " + КоличествоОбновленных);
    Если КоличествоПропущенных > 0 Тогда
        Сообщить("Пропущено (без змін): " + КоличествоПропущенных);
    КонецЕсли;
    Если КоличествоОшибок > 0 Тогда
        Сообщить("Помилок: " + КоличествоОшибок);
    КонецЕсли;

КонецПроцедуры

// Процедура очищає табличну частину Договоры
//
Процедура ОчиститьТаблицу() Экспорт

    Договоры.Очистить();
    Сообщить("Таблицю очищено");

КонецПроцедуры

#КонецЕсли