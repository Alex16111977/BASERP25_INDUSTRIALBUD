#Область ПрограммныйИнтерфейс

// Имя плана обмена ERP <-> BAS Бухгалтерия (bas_industrialbud).
//
// Возвращаемое значение:
//  Строка - имя плана обмена в метаданных.
//
Функция ПланБухгалтерии() Экспорт

	Возврат "ОбменУправлениеПредприятиемБухгалтерия20";

КонецФункции

// Имя плана обмена ERP <-> Казна (kazna).
//
// ВНИМАНИЕ: имя пишется через «Казна-ЧЕЙ-ство» — с буквой «й» (код 0x439).
// Опечатка («Казначество») ломает всё МОЛЧА: Метаданные.Найти() вернёт Неопределено,
// узел не будет найден, обмен просто не пойдёт — без единой ошибки в журнале.
// Поэтому строка записана в коде РОВНО ОДИН РАЗ — здесь.
//
// Возвращаемое значение:
//  Строка - имя плана обмена в метаданных.
//
Функция ПланКазны() Экспорт

	Возврат "КазначействоBASERP";

КонецФункции

// Узел-корреспондент указанного плана обмена в ТЕКУЩЕЙ базе.
//
// Имя плана — СТРОКА и ищется через метаданные, поэтому отсутствие плана в базе
// НЕ ломает компиляцию: в bas_industrialbud нет плана Казны, в kazna нет плана Бухгалтерии,
// и один и тот же модуль работает во всех трёх базах.
//
// Настройки транспорта здесь НЕ используются намеренно: в kazna регистр называется
// иначе (НастройкиТранспортаОбмена с измерением Узел, а не НастройкиТранспортаОбменаДанными
// с измерением Корреспондент), поэтому поиск узла по транспорту там просто падал бы.
//
// Параметры:
//  ИмяПлана - Строка - см. ПланБухгалтерии() / ПланКазны().
//
// Возвращаемое значение:
//  ПланОбменаСсылка, Неопределено - узел (<> ЭтотУзел, не помечен на удаление),
//                                   либо Неопределено, если плана или узла в базе нет.
//
Функция УзелКорреспондентПлана(ИмяПлана) Экспорт

	Если Метаданные.ПланыОбмена.Найти(ИмяПлана) = Неопределено Тогда
		Возврат Неопределено; // плана нет в этой базе — это НЕ ошибка
	КонецЕсли;

	Менеджер = ПланыОбмена[ИмяПлана];

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЭтотУзел", Менеджер.ЭтотУзел());
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Узлы.Ссылка КАК Узел
	|ИЗ
	|	ПланОбмена." + ИмяПлана + " КАК Узлы
	|ГДЕ
	|	Узлы.Ссылка <> &ЭтотУзел
	|	И НЕ Узлы.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Узел;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Выполняет обмен ТЕКУЩЕЙ базы по указанному плану обмена (если план в ней есть).
// Обмен идёт серверным методом БСП, поэтому окно помощника интерактивного обмена
// открыться физически не может.
//
// Параметры:
//  ИмяПлана  - Строка - см. ПланБухгалтерии() / ПланКазны().
//  Сообщения - Массив - (возвращаемый) читаемые строки-результаты.
//
// Возвращаемое значение:
//  Булево - Истина, если РЕАЛЬНЫХ ошибок не было.
//           Плана нет в этой базе -> Истина (нечего делать, это не ошибка).
//           «Нечего принимать» -> тоже НЕ ошибка (см. ДобавитьРезультатыПоУзлу).
//
Функция СинхронизироватьПоПлану(ИмяПлана, Сообщения = Неопределено) Экспорт

	Если Сообщения = Неопределено Тогда
		Сообщения = Новый Массив;
	КонецЕсли;

	Узел = УзелКорреспондентПлана(ИмяПлана);
	Если Узел = Неопределено Тогда
		Возврат Истина; // плана нет в этой базе — молча пропускаем
	КонецЕсли;

	ПараметрыОбмена = ОбменДаннымиСервер.ПараметрыОбмена();
	ПараметрыОбмена.ВидТранспортаСообщенийОбмена = Перечисления.ВидыТранспортаСообщенийОбмена.FILE;
	ПараметрыОбмена.ВыполнятьВыгрузку = Истина;
	ПараметрыОбмена.ВыполнятьЗагрузку = Истина;

	Отказ = Ложь;
	Попытка
		ОбменДаннымиСервер.ВыполнитьОбменДаннымиДляУзлаИнформационнойБазы(Узел, ПараметрыОбмена, Отказ);
	Исключение
		ЗаписьЖурналаРегистрации("А_АвтоматическийОбмен",
			УровеньЖурналаРегистрации.Ошибка, , Узел,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Сообщения.Добавить("Обмен с " + Строка(Узел) + ": ИСКЛЮЧЕНИЕ — "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	// ВАЖНО: флагу Отказ доверять нельзя. БСП поднимает его даже когда обмен прошёл
	// нормально, а принимать было просто НЕЧЕГО: результат
	// Предупреждение_СообщениеОбменаБылоРанееПринято не входит в его список «выполнено»
	// (см. ОбменДаннымиСервер.РезультатВыполненияОбменаВыполнено).
	// Поэтому читаем ФАКТИЧЕСКИЙ результат по каждому действию из регистра состояний.
	Сообщения.Добавить("Обмен с " + Строка(Узел) + ":");
	Возврат ДобавитьРезультатыПоУзлу(Узел, Сообщения);

КонецФункции

// Выполняет обмен по ВСЕМ известным планам, которые есть в текущей базе:
// bas_industrialbud -> только Бухгалтерия; kazna -> только Казна; BaseERP -> обе пары.
//
// Параметры:
//  Сообщения - Массив - (возвращаемый) читаемые строки-результаты.
//
// Возвращаемое значение:
//  Булево - Истина, если РЕАЛЬНЫХ ошибок не было.
//
Функция СинхронизироватьТекущуюБазу(Сообщения = Неопределено) Экспорт

	Если Сообщения = Неопределено Тогда
		Сообщения = Новый Массив;
	КонецЕсли;

	Планы = Новый Массив;
	Планы.Добавить(ПланБухгалтерии());
	Планы.Добавить(ПланКазны());

	НайденХотяБыОдин = Ложь;
	ВсеУспешно = Истина;

	Для Каждого ИмяПлана Из Планы Цикл

		Если УзелКорреспондентПлана(ИмяПлана) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НайденХотяБыОдин = Истина;
		Если НЕ СинхронизироватьПоПлану(ИмяПлана, Сообщения) Тогда
			ВсеУспешно = Ложь;
		КонецЕсли;

	КонецЦикла;

	Если НЕ НайденХотяБыОдин Тогда
		Сообщения.Добавить(НСтр("ru='В текущей базе не найдено ни одного узла обмена с ERP.'"));
		Возврат Ложь;
	КонецЕсли;

	Если ВсеУспешно Тогда
		Сообщения.Добавить("Итог: обмен выполнен успешно.");
	Иначе
		Сообщения.Добавить("Итог: обмен завершён С ОШИБКАМИ (см. Журнал регистрации).");
	КонецЕсли;

	Возврат ВсеУспешно;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает фактический результат обмена по каждому действию (Выгрузка/Загрузка) и
// добавляет читаемые строки в Сообщения. Классификация делается в самом запросе
// (нативно в 1С — сравнение перечислений в коде не требуется).
//
// Возвращаемое значение:
//  Булево - Ложь, если есть РЕАЛЬНЫЕ ошибки (Ошибка, Ошибка_ТранспортСообщения, Отменено).
//           «Сообщение обмена было ранее принято» = нечего принимать, это НЕ ошибка.
//
Функция ДобавитьРезультатыПоУзлу(Узел, Сообщения)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Узел", Узел);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(Состояния.ДействиеПриОбмене) КАК ДействиеТекст,
	|	ПРЕДСТАВЛЕНИЕ(Состояния.РезультатВыполненияОбмена) КАК РезультатТекст,
	|	ВЫБОР
	|		КОГДА Состояния.РезультатВыполненияОбмена = ЗНАЧЕНИЕ(Перечисление.РезультатыВыполненияОбмена.Выполнено)
	|				ИЛИ Состояния.РезультатВыполненияОбмена = ЗНАЧЕНИЕ(Перечисление.РезультатыВыполненияОбмена.ВыполненоСПредупреждениями)
	|			ТОГДА ""OK""
	|		КОГДА Состояния.РезультатВыполненияОбмена = ЗНАЧЕНИЕ(Перечисление.РезультатыВыполненияОбмена.Предупреждение_СообщениеОбменаБылоРанееПринято)
	|			ТОГДА ""INFO""
	|		ИНАЧЕ ""ERR""
	|	КОНЕЦ КАК Класс
	|ИЗ
	|	РегистрСведений.СостоянияОбменовДанными КАК Состояния
	|ГДЕ
	|	Состояния.УзелИнформационнойБазы = &Узел
	|	И Состояния.ДействиеПриОбмене <> ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ПустаяСсылка)";

	БезОшибок = Истина;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Выборка.Класс = "ERR" Тогда
			БезОшибок = Ложь;
			Сообщения.Добавить("   " + Выборка.ДействиеТекст + ": ОШИБКА — " + Выборка.РезультатТекст);
		ИначеЕсли Выборка.Класс = "INFO" Тогда
			Сообщения.Добавить("   " + Выборка.ДействиеТекст + ": нечего принимать (сообщение уже было принято ранее)");
		Иначе
			Сообщения.Добавить("   " + Выборка.ДействиеТекст + ": выполнено");
		КонецЕсли;

	КонецЦикла;

	Возврат БезОшибок;

КонецФункции

#КонецОбласти
