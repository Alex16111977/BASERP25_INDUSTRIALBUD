#Область ОбработчикиСобытийФормы

// ОБМЕН ВЫПОЛНЯЕТСЯ ЗДЕСЬ — на сервере, при создании формы.
//
// Почему не в ПриОткрытии (клиент): серверный обработчик отрабатывает гарантированно
// при создании формы, не зависит от клиентского цикла сообщений и от ПараметрЗапуска.
//
// ВАЖНО: обработчик обязан быть объявлен в Form.xml —
//   <Events><Event name="OnCreateAtServer">ПриСозданииНаСервере</Event></Events>
// Без этого объявления платформа процедуру НЕ вызывает (процедура в модуле есть,
// но молча не работает — именно на этом ранее и не запускался обмен).
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаписьЖурналаРегистрации("А_АвтоматическийОбмен",
		УровеньЖурналаРегистрации.Информация, , ,
		"А_ЗапуститьОбмен: старт обмена (ПриСозданииНаСервере)");

	Обработка = РеквизитФормыВЗначение("Объект");
	Сообщения = Новый Массив;
	Обработка.СинхронизироватьТекущуюБазу(Сообщения);
	Результат = СтрСоединить(Сообщения, Символы.ПС);

	ЗаписьЖурналаРегистрации("А_АвтоматическийОбмен",
		УровеньЖурналаРегистрации.Информация, , ,
		"А_ЗапуститьОбмен: обмен завершён. " + Результат);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Обмен уже выполнен на сервере. Даём 5 секунд увидеть результат и закрываем сессию —
	// это нужно оркестратору: ЗапуститьПриложение(..., ОжидатьЗавершения = Истина, ...)
	// дожидается закрытия каждого шага цепочки bas_industrialbud -> ERP -> bas_industrialbud.
	ПодключитьОбработчикОжидания("ЗакрытьСессию", 5, Истина);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗакрытьСессию()
	ЗавершитьРаботуСистемы(Ложь, Ложь);
КонецПроцедуры

#КонецОбласти
