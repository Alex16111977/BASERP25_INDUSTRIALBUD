&НаСервере
Функция ПолучитьСписокДокументовНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Подразделение", Справочники.СтруктураПредприятия.ПустаяСсылка());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПрочиеАктивыПассивы.Регистратор КАК Регистратор,
	|	ПрочиеАктивыПассивы.Период КАК Период
	|ИЗ
	|	РегистрНакопления.ПрочиеАктивыПассивы КАК ПрочиеАктивыПассивы
	|ГДЕ
	|	ПрочиеАктивыПассивы.Подразделение = &Подразделение
	|	И ПрочиеАктивыПассивы.ВидИсточника <> ЗНАЧЕНИЕ(Перечисление.ВидыИсточниковДвижений.РасчетБаланса)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрочиеАктивыПассивы.Регистратор,
	|	ПрочиеАктивыПассивы.Период
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	// Возвращаем МАССИВ структур (не ТаблицуЗначений!)
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Регистратор, Период", Выборка.Регистратор, Выборка.Период));
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПерепровестиДокументНаСервере(СсылкаНаДокумент)
	
	Попытка
	
		 
		Док = СсылкаНаДокумент.ПолучитьОбъект();
		НачатьТранзакцию();
		Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Док.Записать(РежимЗаписиДокумента.Проведение); 
		ЗафиксироватьТранзакцию();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура ПерепровестиВсеДокументыГдеНетПодразделения(Команда)
	
	МассивДокументов = ПолучитьСписокДокументовНаСервере();
	ВсегоДокументов = МассивДокументов.Количество();
	
	Если ВсегоДокументов = 0 Тогда
		ПоказатьПредупреждение(, "Документы без подразделения не найдены");
		Возврат;
	КонецЕсли;
	
	КоличествоОшибок = 0;
	
	Для НомерТекущего = 0 По ВсегоДокументов - 1 Цикл
		
		ДанныеДокумента = МассивДокументов[НомерТекущего];
		Процент = Окр((НомерТекущего + 1) / ВсегоДокументов * 100, 0);
		
		Состояние(
			"Перепроведение: " + (НомерТекущего + 1) + " из " + ВсегоДокументов,
			Процент,
			"Дата: " + Формат(ДанныеДокумента.Период, "ДЛФ=D")
		);
		
		ОбработкаПрерыванияПользователя();
		
		Если НЕ ПерепровестиДокументНаСервере(ДанныеДокумента.Регистратор) Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	ПоказатьПредупреждение(, "Готово! Обработано: " + ВсегоДокументов + ", ошибок: " + КоличествоОшибок);
	
КонецПроцедуры