
&НаСервере
Процедура ОбновитьДокументУслугНаСервере()

    Если НЕ ЗначениеЗаполнено(Объект.ДокОказаниеУслуг) Тогда
        Возврат;
    КонецЕсли;

    ДокОбъект = Объект.ДокОказаниеУслуг.ПолучитьОбъект();
    ДокОбъект.Услуги.Очистить();

    НоменклатураУслуга = Справочники.Номенклатура.НайтиПоКоду("0Ц-00000002");

    НаправлениеПриход = Перечисления.ТипыЗначенийПоказателейБюджетногоОтчета.Приход;
    НаправлениеРасход = Перечисления.ТипыЗначенийПоказателейБюджетногоОтчета.Расход;

    КоличествоСтрок = ДокОбъект.СоставБДДС.Количество();

    // ============================================================
    // ПРОХОД 1: Разбивка на группы (комментарий + позиция + баланс)
    // ============================================================
    МассивГрупп = Новый Массив;

    ТекГруппа = НоваяГруппа();

    Для Индекс = 0 По КоличествоСтрок - 1 Цикл

        ТекСтрока = ДокОбъект.СоставБДДС[Индекс];
        Направление = ТекСтрока.НаправлениеДДС;

        Если Направление <> НаправлениеПриход И Направление <> НаправлениеРасход Тогда
            Продолжить;
        КонецЕсли;

        КоммСтроки = ОчиститьКомментарий(ТекСтрока.Комментарий);
        ЭтоПриход = (Направление = НаправлениеПриход);

        // Решаем: добавить в текущую группу или начать новую
        НачатьНовую = Ложь;

        Если ТекГруппа.МассивПриход.Количество() = 0 И ТекГруппа.МассивРасход.Количество() = 0 Тогда
            // Группа пустая — добавляем
        Иначе
            ЕстьПриход = ТекГруппа.МассивПриход.Количество() > 0;
            ЕстьРасход = ТекГруппа.МассивРасход.Количество() > 0;
            КоммСовпадает = КомментарийСовпадает(КоммСтроки, ТекГруппа.Комментарии);

            // Смена направления: текущая строка Приход, а в группе уже есть Расходы
            СменаНаправления = ЭтоПриход И ЕстьРасход;

            Если СменаНаправления И ЕстьПриход И НЕ КоммСовпадает Тогда
                // Группа уже имеет оба типа, смена направления, комментарий другой → новая группа
                НачатьНовую = Истина;
            КонецЕсли;
        КонецЕсли;

        Если НачатьНовую Тогда
            МассивГрупп.Добавить(ТекГруппа);
            ТекГруппа = НоваяГруппа();
        КонецЕсли;

        // Добавляем строку в текущую группу
        Если ЭтоПриход Тогда
            ТекГруппа.МассивПриход.Добавить(Индекс);
            ТекГруппа.ИтогоПриход = ТекГруппа.ИтогоПриход + ТекСтрока.Сумма;
        Иначе
            ТекГруппа.МассивРасход.Добавить(Индекс);
            ТекГруппа.ИтогоРасход = ТекГруппа.ИтогоРасход + ТекСтрока.Сумма;
        КонецЕсли;

        Если ЗначениеЗаполнено(КоммСтроки) Тогда
            ТекГруппа.Комментарии.Вставить(КоммСтроки, Истина);
        КонецЕсли;

        // Проверяем баланс: если сошёлся и следующая строка с другим комментарием — закрываем
        Если ТекГруппа.МассивПриход.Количество() > 0
            И ТекГруппа.МассивРасход.Количество() > 0
            И ТекГруппа.ИтогоПриход > 0
            И Окр(ТекГруппа.ИтогоПриход - ТекГруппа.ИтогоРасход, 2) = 0 Тогда

            // Смотрим следующую строку
            ЗакрытьГруппу = Истина;
            Если Индекс < КоличествоСтрок - 1 Тогда
                СледСтрока = ДокОбъект.СоставБДДС[Индекс + 1];
                КоммСлед = ОчиститьКомментарий(СледСтрока.Комментарий);
                Если КомментарийСовпадает(КоммСлед, ТекГруппа.Комментарии) Тогда
                    ЗакрытьГруппу = Ложь;
                КонецЕсли;
            КонецЕсли;

            Если ЗакрытьГруппу Тогда
                МассивГрупп.Добавить(ТекГруппа);
                ТекГруппа = НоваяГруппа();
            КонецЕсли;

        КонецЕсли;

    КонецЦикла;

    // Добавляем последнюю группу если непустая
    Если ТекГруппа.МассивПриход.Количество() > 0 ИЛИ ТекГруппа.МассивРасход.Количество() > 0 Тогда
        МассивГрупп.Добавить(ТекГруппа);
    КонецЕсли;

    // ============================================================
    // ПРОХОД 2: Склейка сирот по комментарию
    // ============================================================
    МассивСирот = Новый Массив;

    Для Каждого Группа Из МассивГрупп Цикл
        ЭтоСирота = (Группа.МассивПриход.Количество() = 0) ИЛИ (Группа.МассивРасход.Количество() = 0);
        Если ЭтоСирота Тогда
            МассивСирот.Добавить(Группа);
        КонецЕсли;
    КонецЦикла;

    Для Каждого Сирота Из МассивСирот Цикл

        // Ищем несбалансированную группу с совпадающим комментарием
        Найдена = Ложь;
        Для Каждого Группа Из МассивГрупп Цикл
            Если Группа = Сирота Тогда
                Продолжить;
            КонецЕсли;

            // Проверяем совпадение комментариев
            КоммСовпал = Ложь;
            Для Каждого КлючЗнач Из Сирота.Комментарии Цикл
                Если Группа.Комментарии.Получить(КлючЗнач.Ключ) <> Неопределено Тогда
                    КоммСовпал = Истина;
                    Прервать;
                КонецЕсли;
            КонецЦикла;

            Если НЕ КоммСовпал Тогда
                Продолжить;
            КонецЕсли;

            // Проверяем что группа несбалансирована
            Баланс = Окр(Группа.ИтогоПриход - Группа.ИтогоРасход, 2);
            Если Баланс = 0 И Группа.ИтогоПриход > 0 Тогда
                Продолжить; // Группа уже сбалансирована
            КонецЕсли;

            // Присоединяем строки сироты
            Для Каждого Инд Из Сирота.МассивПриход Цикл
                Группа.МассивПриход.Добавить(Инд);
            КонецЦикла;
            Группа.ИтогоПриход = Группа.ИтогоПриход + Сирота.ИтогоПриход;

            Для Каждого Инд Из Сирота.МассивРасход Цикл
                Группа.МассивРасход.Добавить(Инд);
            КонецЦикла;
            Группа.ИтогоРасход = Группа.ИтогоРасход + Сирота.ИтогоРасход;

            Для Каждого КлючЗнач Из Сирота.Комментарии Цикл
                Группа.Комментарии.Вставить(КлючЗнач.Ключ, Истина);
            КонецЦикла;

            // Помечаем сироту для удаления
            Сирота.МассивПриход = Новый Массив;
            Сирота.МассивРасход = Новый Массив;

            Найдена = Истина;
            Прервать;
        КонецЦикла;

        Если НЕ Найдена Тогда
            Сообщить("ВНИМАНИЕ: Группа-сирота не найдена для склейки. Комментарии: "
                + КомментарииВСтроку(Сирота.Комментарии));
        КонецЕсли;

    КонецЦикла;

    // ============================================================
    // ПРОХОД 3: Генерация строк Услуги
    // ============================================================
    НомерГруппы = 0;

    Для Каждого Группа Из МассивГрупп Цикл

        // Пропускаем пустые (склеенные сироты)
        Если Группа.МассивПриход.Количество() = 0 И Группа.МассивРасход.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;

        НомерГруппы = НомерГруппы + 1;

        // Предупреждение о несбалансированной группе
        Баланс = Окр(Группа.ИтогоПриход - Группа.ИтогоРасход, 2);
        Если Баланс <> 0 ИЛИ Группа.ИтогоПриход = 0 Тогда
            Сообщить("ВНИМАНИЕ: Группа №" + НомерГруппы + " не сбалансирована! "
                + "Приход = " + Формат(Группа.ИтогоПриход, "ЧДЦ=2")
                + ", Расход = " + Формат(Группа.ИтогоРасход, "ЧДЦ=2")
                + ", Разница = " + Формат(Баланс, "ЧДЦ=2")
                + " [" + КомментарииВСтроку(Группа.Комментарии) + "]");
        КонецЕсли;

        Если Группа.МассивПриход.Количество() > 0 И Группа.МассивРасход.Количество() > 0 Тогда
            СоздатьСтрокиУслугИзГруппы(ДокОбъект, Группа.МассивПриход, Группа.МассивРасход, НоменклатураУслуга, НомерГруппы);
        Иначе
            Сообщить("Группа №" + НомерГруппы + " содержит только "
                + ?(Группа.МассивПриход.Количество() > 0, "приходы", "расходы")
                + " — невозможно создать строки услуг."
                + " [" + КомментарииВСтроку(Группа.Комментарии) + "]");
        КонецЕсли;

    КонецЦикла;

    Сообщить("Заполнено строк Услуги: " + ДокОбъект.Услуги.Количество()
        + " из " + КоличествоСтрок + " строк БДДС, "
        + НомерГруппы + " групп.");

    ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

&НаСервере
Функция НоваяГруппа()
    Группа = Новый Структура;
    Группа.Вставить("МассивПриход", Новый Массив);
    Группа.Вставить("МассивРасход", Новый Массив);
    Группа.Вставить("ИтогоПриход", 0);
    Группа.Вставить("ИтогоРасход", 0);
    Группа.Вставить("Комментарии", Новый Соответствие);
    Возврат Группа;
КонецФункции

&НаСервере
Функция ОчиститьКомментарий(Комментарий)
    Результат = СокрЛП(Комментарий);
    Результат = СтрЗаменить(Результат, Символы.Таб, " ");
    Результат = СтрЗаменить(Результат, "¶", "");
    Возврат СокрЛП(Результат);
КонецФункции

&НаСервере
Функция КомментарийСовпадает(КоммСтроки, СоответствиеКомментариев)
    Если НЕ ЗначениеЗаполнено(КоммСтроки) Тогда
        Возврат Ложь; // Пустой комментарий не считается совпадением
    КонецЕсли;
    Возврат СоответствиеКомментариев.Получить(КоммСтроки) <> Неопределено;
КонецФункции

&НаСервере
Функция КомментарииВСтроку(СоответствиеКомментариев)
    Результат = "";
    Для Каждого КлючЗнач Из СоответствиеКомментариев Цикл
        Если ЗначениеЗаполнено(Результат) Тогда
            Результат = Результат + ", ";
        КонецЕсли;
        Результат = Результат + КлючЗнач.Ключ;
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаСервере
Процедура СоздатьСтрокиУслугИзГруппы(ДокОбъект, МассивПриход, МассивРасход, НоменклатураУслуга, НомерГруппы)

    // Первая строка Приход — источник для подразделения продавца и статьи ДДС
    ПерваяСтрокаПриход = ДокОбъект.СоставБДДС[МассивПриход[0]];

    ПодразделениеПродавец = А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны(
        ПерваяСтрокаПриход.Направление, ПерваяСтрокаПриход.Подразделение);

    СтатьяДДСПродавец = ПерваяСтрокаПриход.СтатьяДвиженияДенежныхСредств;

    // Собираем комментарии Приход (без дублей)
    КомментарийПриход = "";
    Для Каждого ИндексПриход Из МассивПриход Цикл
        СтрокаПриход = ДокОбъект.СоставБДДС[ИндексПриход];
        ТекКомментарий = СокрЛП(СтрокаПриход.Комментарий);
        Если ЗначениеЗаполнено(ТекКомментарий) И Найти(КомментарийПриход, ТекКомментарий) = 0 Тогда
            Если ЗначениеЗаполнено(КомментарийПриход) Тогда
                КомментарийПриход = КомментарийПриход + ", ";
            КонецЕсли;
            КомментарийПриход = КомментарийПриход + ТекКомментарий;
        КонецЕсли;
    КонецЦикла;

    // Для каждого Расхода с ненулевой суммой — создаём строку Услуги
    Для Каждого ИндексРасход Из МассивРасход Цикл

        СтрокаРасход = ДокОбъект.СоставБДДС[ИндексРасход];

        // Пропускаем нулевые строки
        Если СтрокаРасход.Сумма = 0 Тогда
            Продолжить;
        КонецЕсли;

        НоваяСтрока = ДокОбъект.Услуги.Добавить();

        НоваяСтрока.Сумма = СтрокаРасход.Сумма;

        // Подразделение покупатель — из строки Расход
        НоваяСтрока.ПодразделениеПокупатель = А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны(
            СтрокаРасход.Направление, СтрокаРасход.Подразделение);

        // Подразделение продавец — из первой строки Приход группы
        НоваяСтрока.ПодразделениеПродавец = ПодразделениеПродавец;

        // Комментарий: Приход / Расход (обрезка до 50 символов)
        КомментарийРасход = СокрЛП(СтрокаРасход.Комментарий);
        НоваяСтрока.Комментарий = Лев(КомментарийПриход + " /" + КомментарийРасход, 50);

        // Номенклатура (фиксированная)
        НоваяСтрока.Номенклатура = НоменклатураУслуга;

        // Статья затрат — из связанной статьи расходов на статье ДДС
        НоваяСтрока.СтатьяЗатрат = СтрокаРасход.СтатьяДвиженияДенежныхСредств.А_СтатьяРасходов;

        // Статьи ДДС продавца и покупателя
        НоваяСтрока.СтатьяДвиженияДенежныхСредствПродавец = СтатьяДДСПродавец;
        НоваяСтрока.СтатьяДвиженияДенежныхСредствПокупатель = СтрокаРасход.СтатьяДвиженияДенежныхСредств;

    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДокументУслуг(Команда)
    ОбновитьДокументУслугНаСервере();
КонецПроцедуры
