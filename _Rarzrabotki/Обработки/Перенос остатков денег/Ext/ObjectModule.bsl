
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Процедура завантажує залишки грошових коштів на банківських рахунках
// з бухгалтерської бази BuhBud через COM-підключення
//
Процедура ЗагрузитьОстатки() Экспорт

    // 1. Перевірка заповнення дати
    Если НЕ ЗначениеЗаполнено(ОкончаниеПериода) Тогда
        ВызватьИсключение "Не вказана дата залишків (Окончание периода)!";
    КонецЕсли;

    // 2. Параметри підключення до бухгалтерської бази
    СтрокаПодключенияБух = А_ПодключенияБазСервер.СтрокаПодключения("bas_industrialbud");
    // 3. Створення COM-конектора
    V8 = Новый COMОбъект("V83.COMConnector");

    Попытка
        V83 = V8.Connect(СокрЛП(СтрокаПодключенияБух));
    Исключение
        ВызватьИсключение "Помилка підключення до бази BuhBud: " + ОписаниеОшибки();
    КонецПопытки;

    // 4. Формування тексту запиту для отримання залишків по рахунках 31х
    // Субконто1 = БанковскийСчет для рахунків 311, 312, 313, 314
   ТекстЗапроса =
    "ВЫБРАТЬ
    |	Остатки.Счет.Код КАК СчетКод,
    |	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.БанковскиеСчета).Наименование КАК БанковскийСчетНаименование,
    |	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.БанковскиеСчета).ВалютаДенежныхСредств.Код КАК ВалютаКод,
    |	Остатки.СуммаОстатокДт КАК Сумма,
    |	Остатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСумма,
    |	Остатки.Организация.КодПоЕДРПОУ КАК ОрганизацияЕДРПОУ
    |ИЗ
    |	РегистрБухгалтерии.Хозрасчетный.Остатки(&ДатаОстатков, Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаВБанках)), , ) КАК Остатки
    |ГДЕ
    |	Остатки.СуммаОстатокДт <> 0
    |	И Остатки.Организация.А_ВБалансе";

    // 5. Виконання запиту в бухгалтерській базі
    Попытка
        Запрос = V83.NewObject("Запрос");
        Запрос.Текст = ТекстЗапроса;
        Запрос.УстановитьПараметр("ДатаОстатков", КонецДня(ОкончаниеПериода));

        РезультатЗапроса = Запрос.Выполнить();
        ТЗОстатки = РезультатЗапроса.Выгрузить();
    Исключение
        V83 = Неопределено;
        V8 = Неопределено;
        ВызватьИсключение "Помилка виконання запиту в базі BuhBud: " + ОписаниеОшибки();
    КонецПопытки;

    // 6. Серіалізація таблиці значень для передачі через COM
    Попытка
        стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗОстатки);
    Исключение
        V83 = Неопределено;
        V8 = Неопределено;
        ВызватьИсключение "Помилка серіалізації даних: " + ОписаниеОшибки();
    КонецПопытки;

    // 7. Відключення від бухгалтерської бази
    V83 = Неопределено;
    V8 = Неопределено;

    // 8. Десеріалізація таблиці значень в поточній базі
    ТаблицаОстатков = ЗначениеИзСтрокиВнутр(стр_ТЗ);

    // 9. Очистка табличної частини
    БанковскиеСчета.Очистить();

    // 10. Отримання валют для перерахунку
    ВалютаРегл = Константы.ВалютаРегламентированногоУчета.Получить();
    ВалютаУпр = Константы.ВалютаУправленческогоУчета.Получить();
    ДатаКурса = КонецДня(ОкончаниеПериода);

    // 11. Заповнення табличної частини з зіставленням довідників
    СчетчикОшибок = 0;
    СчетчикЗагружено = 0;

    Для Каждого СтрокаТЗ Из ТаблицаОстатков Цикл

        БанковскийСчетНаименование = СокрЛП(СтрокаТЗ.БанковскийСчетНаименование);

        Если ПустаяСтрока(БанковскийСчетНаименование) Тогда
            СчетчикОшибок = СчетчикОшибок + 1;
            Сообщить("Пропущено рядок: порожня назва банківського рахунку");
            Продолжить;
        КонецЕсли;

        // 11.1. Пошук банківського рахунку по найменуванню
        БанкСчетERP = Справочники.БанковскиеСчетаОрганизаций.НайтиПоНаименованию(
            БанковскийСчетНаименование, Истина);

        Если НЕ ЗначениеЗаполнено(БанкСчетERP) Тогда
            СчетчикОшибок = СчетчикОшибок + 1;
            Сообщить("Не знайдено банківський рахунок: " + БанковскийСчетНаименование);
            Продолжить;
        КонецЕсли;

        // 11.2. Додавання рядка в табличну частину
        НоваяСтрока = БанковскиеСчета.Добавить();
        НоваяСтрока.БанковскийСчет = БанкСчетERP;
        НоваяСтрока.СчетКод = СокрЛП(СтрокаТЗ.СчетКод);

        // Валюта з рахунку ERP
        НоваяСтрока.Валюта = БанкСчетERP.ВалютаДенежныхСредств;

        // Сума у валюті рахунку
        // Якщо є валютна сума (для валютних рахунків) - використовуємо її,
        // інакше - суму в грн
        Если СтрокаТЗ.ВалютнаяСумма <> 0 Тогда
            НоваяСтрока.Сумма = СтрокаТЗ.ВалютнаяСумма;
        Иначе
            НоваяСтрока.Сумма = СтрокаТЗ.Сумма;
        КонецЕсли;

        // 11.3. Перерахунок сум
        Если ЗначениеЗаполнено(НоваяСтрока.Валюта) Тогда
            // Коефіцієнт з валюти рахунку в регламентовану
            КоэфРегл = РаботаСКурсамиВалютУТ.ПолучитьКоэффициентПересчетаИзВалютыВВалюту(
                НоваяСтрока.Валюта, ВалютаРегл, ДатаКурса);
            // Коефіцієнт з валюти рахунку в управлінську
            КоэфУпр = РаботаСКурсамиВалютУТ.ПолучитьКоэффициентПересчетаИзВалютыВВалюту(
                НоваяСтрока.Валюта, ВалютаУпр, ДатаКурса);

            НоваяСтрока.СуммаРегл = Окр(НоваяСтрока.Сумма * КоэфРегл, 2);
            НоваяСтрока.СуммаУпр = Окр(НоваяСтрока.Сумма * КоэфУпр, 2);
        Иначе
            // Якщо валюта не визначена - сума в грн
            НоваяСтрока.СуммаРегл = НоваяСтрока.Сумма;
            НоваяСтрока.СуммаУпр = НоваяСтрока.Сумма;
        КонецЕсли;

        СчетчикЗагружено = СчетчикЗагружено + 1;

    КонецЦикла;

    // 12. Виведення статистики
    Сообщить("Завантажено: " + СчетчикЗагружено + " позицій");
    Если СчетчикОшибок > 0 Тогда
        Сообщить("Помилок зіставлення: " + СчетчикОшибок);
    КонецЕсли;

КонецПроцедуры

// Процедура створює документ "Ввод остатков" з хоз. операцією "Ввод остатков на банковских счетах"
//
Процедура СоздатьДокументыВводаОстатков() Экспорт

    // 1. Перевірка заповнення обов'язкових реквізитів
    Если НЕ ЗначениеЗаполнено(Организация) Тогда
        ВызватьИсключение "Не вибрана організація!";
    КонецЕсли;

    Если БанковскиеСчета.Количество() = 0 Тогда
        ВызватьИсключение "Таблична частина порожня! Спочатку завантажте залишки.";
    КонецЕсли;

    Если НЕ ЗначениеЗаполнено(ОкончаниеПериода) Тогда
        ВызватьИсключение "Не вказана дата залишків (Окончание периода)!";
    КонецЕсли;

    // 2. Параметри документа
    ДатаДок = КонецДня(ОкончаниеПериода);
    ХозОп = Перечисления.ХозяйственныеОперации.ВводОстатковНаБанковскихСчетах;

    // 3. Пошук існуючого документа з такими параметрами
    ЗапросПроверки = Новый Запрос;
    ЗапросПроверки.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    ВводОстатков.Ссылка КАК Ссылка
    |ИЗ
    |    Документ.ВводОстатков КАК ВводОстатков
    |ГДЕ
    |    ВводОстатков.Организация = &Организация
    |    И ВводОстатков.Дата = &Дата
    |    И ВводОстатков.ХозяйственнаяОперация = &ХозяйственнаяОперация";

    ЗапросПроверки.УстановитьПараметр("Организация", Организация);
    ЗапросПроверки.УстановитьПараметр("Дата", ДатаДок);
    ЗапросПроверки.УстановитьПараметр("ХозяйственнаяОперация", ХозОп);

    РезультатПроверки = ЗапросПроверки.Выполнить();

    ЭтоОбновление = Ложь;

    Если НЕ РезультатПроверки.Пустой() Тогда
        // Документ існує - оновлюємо
        ВыборкаПроверки = РезультатПроверки.Выбрать();
        ВыборкаПроверки.Следующий();

        Док = ВыборкаПроверки.Ссылка.ПолучитьОбъект();
        Док.БанковскиеСчета.Очистить();
        Док.Комментарий = "Оновлено обробкою переносу залишків грошей " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");

        ЭтоОбновление = Истина;
    Иначе
        // Створюємо новий документ
        Док = Документы.ВводОстатков.СоздатьДокумент();
        Док.Комментарий = "Створено обробкою переносу залишків грошей " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
    КонецЕсли;

    // 4. Заповнення шапки документа
    Док.Дата = ДатаДок;
    Док.Организация = Организация;
    Док.ХозяйственнаяОперация = ХозОп;

    // Прапорці відображення
    Док.ОтражатьВОперативномУчете = Истина;
    Док.ОтражатьВБУиНУ = Истина;
    Док.ОтражатьВУУ = Истина;

    // 5. Заповнення табличної частини БанковскиеСчета
    Для Каждого СтрокаТЧ Из БанковскиеСчета Цикл
        НС = Док.БанковскиеСчета.Добавить();
        НС.БанковскийСчет = СтрокаТЧ.БанковскийСчет;
        НС.Сумма = СтрокаТЧ.Сумма;
        НС.СуммаРегл = СтрокаТЧ.СуммаРегл;
        НС.СуммаУпр = СтрокаТЧ.СуммаУпр;
    КонецЦикла;

    // 6. Запис та проведення документа
    Попытка
        Док.Записать(РежимЗаписиДокумента.Проведение);

        Если ЭтоОбновление Тогда
            Сообщить("Документ оновлено: " + Док.Ссылка);
        Иначе
            Сообщить("Документ створено: " + Док.Ссылка);
        КонецЕсли;

        Сообщить("Кількість рядків: " + Док.БанковскиеСчета.Количество());

    Исключение
        Сообщить("ПОМИЛКА запису документа: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

#КонецЕсли
