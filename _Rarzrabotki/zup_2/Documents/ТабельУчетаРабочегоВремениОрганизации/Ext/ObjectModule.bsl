	Иначе
		// Заполнение с разбивкой по дням.
		
	
		ЗапросАвтоЗаполнения.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ГрафикиРаботыПоВидамВремени.ГрафикРаботы,
