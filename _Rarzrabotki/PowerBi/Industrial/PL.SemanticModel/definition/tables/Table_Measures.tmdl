	partition Table_Measures = m
		mode: import
		source =
				let
				    Источник = Sql.Database("SQLSERVER", "OlapBASERP"),
				    dbo_Table_Measures = Источник{[Schema="dbo",Item="Table_Measures"]}[Data]
				in
				    dbo_Table_Measures

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Навигация

