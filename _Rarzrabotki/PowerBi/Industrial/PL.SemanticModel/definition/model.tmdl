model Model
	culture: ru-RU
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: ru-RU
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Table_Measures","ДоговорыКонтрагентов","Контрагенты","СтатьиДвиженияДенежныхСредств","СтруктураПредприятия","НаправленияДеятельности","СтатьиРасходов","СтатьиДоходов","ФизическиеЛица","Организации","А_ГруппаСтатей_PL","А_Статьи_PL","Партнеры","Документы","Calendar","Fact_PnL","ДенежныеСредства","Fact_Cashflow","Fact_Balance","СтатьиАктивовПассивов","Номенклатура","Виды номенклатуры","Склады","ТипыНалогов","ТипПоказателя","ФинАгенты","ТипыДоговоров","ОбъектыРасчетов"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table ДоговорыКонтрагентов
ref table Контрагенты
ref table СтатьиДвиженияДенежныхСредств
ref table СтруктураПредприятия
ref table НаправленияДеятельности
ref table СтатьиРасходов
ref table СтатьиДоходов
ref table ФизическиеЛица
ref table Организации
ref table А_ГруппаСтатей_PL
ref table А_Статьи_PL
ref table Table_Measures
ref table Партнеры
ref table Документы
ref table Calendar
ref table Fact_PnL
ref table ДенежныеСредства
ref table Fact_Cashflow
ref table Fact_Balance
ref table СтатьиАктивовПассивов
ref table Номенклатура
ref table 'Виды номенклатуры'
ref table Склады
ref table ТипыНалогов
ref table ТипПоказателя
ref table ФинАгенты
ref table ТипыДоговоров
ref table ОбъектыРасчетов

ref cultureInfo ru-RU

