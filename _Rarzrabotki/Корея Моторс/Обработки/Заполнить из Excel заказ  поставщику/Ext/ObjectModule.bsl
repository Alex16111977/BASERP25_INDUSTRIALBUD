Процедура Инициализировать(Объект, ИмяТабличнойЧасти = Неопределено, ТабличноеПолеОбъекта = Неопределено) Экспорт

	Если Объект.Товары.Количество() > 0 Тогда

		ТекстВопроса = "Перед заповненням таблична частина буде очищена. Заповнити?";
		Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, Метаданные().Синоним);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;

		Объект.Товары.Очистить();
	КонецЕсли;

	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);

	ДиалогВыбораФайла.Заголовок = "Прочитати табличний документ з файлу";
	ДиалогВыбораФайла.Фильтр    = "Лист Excel (*.xls;*.xlsx)|*.xls;*.xlsx|";
	Если ДиалогВыбораФайла.Выбрать() Тогда
		ИмяФайла = ДиалогВыбораФайла.ПолноеИмяФайла;
		ЗагрузитьИзExcel(Объект, Объект.Товары, ИмяФайла);
	КонецЕсли;

КонецПроцедуры


Функция НайтиСтрокуЗаголовков(ExcelЛист)

	// Використовуємо нативний Excel Find замість перебору клітинок
	// xlValues = -4163, xlPart = 2 (частковий збіг)
	Попытка
		Результат = ExcelЛист.Cells.Find("Код товара", , -4163, 2);
	Исключение
		Возврат 0;
	КонецПопытки;

	Если Результат = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Результат.Row;

КонецФункции


Функция ОпределитьКолонкиПоЗаголовкам(ExcelЛист, СтрокаЗаголовков)

	Колонки = Новый Структура;
	Колонки.Вставить("КодЗаявки", 0);
	Колонки.Вставить("КодТовара", 0);
	Колонки.Вставить("Количество", 0);

	// Обмежуємо пошук рядком заголовків через Rows(N).Find()
	ДиапазонРядка = ExcelЛист.Rows(СтрокаЗаголовков);

	Попытка
		Результат = ДиапазонРядка.Find("Код заявки", , -4163, 2);
		Если Результат <> Неопределено Тогда
			Колонки.КодЗаявки = Результат.Column;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Результат = ДиапазонРядка.Find("Код товара", , -4163, 2);
		Если Результат <> Неопределено Тогда
			Колонки.КодТовара = Результат.Column;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Результат = ДиапазонРядка.Find("Количество", , -4163, 2);
		Если Результат <> Неопределено Тогда
			Колонки.Количество = Результат.Column;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Колонки;

КонецФункции


Процедура ЗаповнитиКоментар(ExcelЛист, Объект, Колонки, СтрокаДанных)

	// Зчитуємо код заявки з першого рядка даних
	КодЗаявки = "";
	Если Колонки.КодЗаявки > 0 Тогда
		Попытка
			КодЗаявки = СокрЛП(ExcelЛист.Cells(СтрокаДанных, Колонки.КодЗаявки).Value);
		Исключение
			КодЗаявки = "";
		КонецПопытки;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(КодЗаявки) Тогда
		// Спроба взяти номер заявки із заголовка стовпця F (рядок 1, стовпець 6)
		Попытка
			КодЗаявки = СокрЛП(ExcelЛист.Cells(1, 6).Value);
		Исключение
			КодЗаявки = "";
		КонецПопытки;
	КонецЕсли;

	Если ЗначениеЗаполнено(КодЗаявки) Тогда
		Объект.Комментарий = КодЗаявки;
		Сообщить("Заявка: " + КодЗаявки);
	Иначе
		Сообщить("Не вдалося визначити код заявки.");
	КонецЕсли;

КонецПроцедуры


Процедура ЗагрузитьИзExcel(Объект, Товары, ИмяФайла)

	Попытка
		Excel = Новый COMОбъект("Excel.Application");
		Excel.WorkBooks.Open(ИмяФайла);
		Состояние("Обробка файлу Microsoft Excel...");
	Исключение
		Сообщить("Помилка. Можливо невірно вказано файл книги Excel.");
		Возврат;
	КонецПопытки;

	ФормаИндикатора = ПолучитьОбщуюФорму("ФормаИндикатора");
	ФормаИндикатора.НадписьСостоянияИндикатораОбщая = "Завантаження з Excel";
	ФормаИндикатора.Открыть();

	ИндикаторФормы = ФормаИндикатора.ЭлементыФормы.Индикатор;

	ВыбФайл = Новый Файл(ИмяФайла);
	Если НЕ ВыбФайл.Существует() Тогда
		Сообщить("Файл не існує!");
		Возврат;
	КонецЕсли;

	Попытка
		Состояние("Обробка файлу Microsoft Excel...");
		ExcelЛист = Excel.Sheets(1);
	Исключение
		Сообщить("Помилка. Можливо невірно вказано номер листа книги Excel.");
		Возврат;
	КонецПопытки;

	// Визначаємо рядок заголовків та колонки по заголовках
	СтрокаЗаголовков = НайтиСтрокуЗаголовков(ExcelЛист);
	Если СтрокаЗаголовков = 0 Тогда
		Сообщить("Не знайдено рядок заголовків (шукається ""Код товара"")!");
		ФормаИндикатора.Закрыть();
		Excel.WorkBooks.Close();
		Excel = 0;
		Возврат;
	КонецЕсли;

	Колонки = ОпределитьКолонкиПоЗаголовкам(ExcelЛист, СтрокаЗаголовков);

	Если Колонки.КодТовара = 0 Тогда
		Сообщить("Не знайдено колонку ""Код товара""!");
		ФормаИндикатора.Закрыть();
		Excel.WorkBooks.Close();
		Excel = 0;
		Возврат;
	КонецЕсли;

	Если Колонки.Количество = 0 Тогда
		Сообщить("Не знайдено колонку ""Количество""!");
	КонецЕсли;

	Сообщить("Заголовки знайдено у рядку " + СтрокаЗаголовков
		+ ". Код товара: кол." + Колонки.КодТовара
		+ ", Количество: кол." + Колонки.Количество
		+ ", Код заявки: кол." + Колонки.КодЗаявки);

	// Дані починаються одразу після заголовків (без рядка номерів колонок)
	НачалоДанных = СтрокаЗаголовков + 1;
	// Визначаємо останній заповнений рядок листа
	КонецДанных = ExcelЛист.Cells(1, 1).SpecialCells(11).Row;
	ВсегоСтрок = КонецДанных - НачалоДанных + 1;

	// Заповнюємо коментар кодом заявки з першого рядка даних
	ЗаповнитиКоментар(ExcelЛист, Объект, Колонки, НачалоДанных);

	Сообщить("Обробка рядків з " + НачалоДанных + " по " + КонецДанных + " (всього " + ВсегоСтрок + ")");

	Для Row = НачалоДанных По КонецДанных Цикл
		Если ВсегоСтрок > 0 Тогда
			ИндикаторФормы.Значение = (Row - НачалоДанных) / ВсегоСтрок * 100;
		КонецЕсли;

		Артикул = СокрЛП(ExcelЛист.Cells(Row, Колонки.КодТовара).Value);

		Если НЕ ЗначениеЗаполнено(Артикул) Тогда
			Продолжить;
		КонецЕсли;

		Кво = 0;
		Если Колонки.Количество > 0 Тогда
			Кво = ExcelЛист.Cells(Row, Колонки.Количество).Value;
		КонецЕсли;

		// Ціна не заповнюється (в файлах заказів цін немає)
		Цена = 0;

		Если ЗначениеЗаполнено(Артикул) Тогда
			НайденнаяСсылка = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Артикул);
			Если Не ЗначениеЗаполнено(НайденнаяСсылка) Тогда
				Сообщить("Не знайдено номенклатуру за артикулом <" + Артикул + ">");
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
			СтрокаТабличнойЧасти = Товары.Добавить();
			СтрокаТабличнойЧасти.Номенклатура = НайденнаяСсылка;
			СтрокаТабличнойЧасти.Количество = Кво;
			СтрокаТабличнойЧасти.ЕдиницаИзмерения = НайденнаяСсылка.ЕдиницаХраненияОстатков;
			СтрокаТабличнойЧасти.Коэффициент = 1;
			СтрокаТабличнойЧасти.Цена = Цена;

			// Виконати загальні дії для всіх документів при зміні номенклатури.
			ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(СтрокаТабличнойЧасти, Объект);

			// Заповнюємо реквізити табличної частини.
			ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаТабличнойЧасти, Объект, "Приобретение");

			СтруктураШапкиДокумента = Новый Структура("Контрагент, ТипЦен, ДоговорКонтрагента, ДатаДокумента, ВалютаДокумента, УчитыватьНДС, СуммаВключаетНДС",
				Объект.Контрагент, Объект.ТипЦен, Объект.ДоговорКонтрагента, Объект.Дата, Объект.ВалютаДокумента, Объект.УчитыватьНДС, Объект.СуммаВключаетНДС);
			ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуЦенуПокупкиТабЧасти(СтрокаТабличнойЧасти, Объект, СтруктураШапкиДокумента, Константы.ВалютаРегламентированногоУчета.Получить());

			// Розраховуємо реквізити табличної частини.
			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТабличнойЧасти, Объект);
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаТабличнойЧасти, Объект);

			А_ЗаполнитьЦенурозничнаяРекомендуемая(Объект, СтрокаТабличнойЧасти);

		КонецЕсли;

	КонецЦикла;

	ФормаИндикатора.Закрыть();
	ВыбФайл = 0;
	Excel.WorkBooks.Close();
	Excel = 0;

КонецПроцедуры


Функция А_НайтиПоШтрихКоду(ШтрихКод) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);

	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Штрихкоды.Владелец КАК Номенклатура
	               |ИЗ
	               |	РегистрСведений.Штрихкоды КАК Штрихкоды
	               |ГДЕ
	               |	Штрихкоды.Штрихкод = &Штрихкод";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Номенклатура;
	Иначе
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;

КонецФункции
