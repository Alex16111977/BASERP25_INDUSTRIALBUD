Процедура Инициализировать(Объект, ИмяТабличнойЧасти = Неопределено, ТабличноеПолеОбъекта = Неопределено) Экспорт

	Если Объект.Товары.Количество() > 0 Тогда

		ТекстВопроса = "Перед заповненням таблична частина буде очищена. Заповнити?";
		Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, Метаданные().Синоним);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;

		Объект.Товары.Очистить();
	КонецЕсли;

	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);

	ДиалогВыбораФайла.Заголовок = "Прочитати табличний документ з файлу";
	ДиалогВыбораФайла.Фильтр    = "Лист Excel (*.xls;*.xlsx)|*.xls;*.xlsx|";
	Если ДиалогВыбораФайла.Выбрать() Тогда
		ИмяФайла = ДиалогВыбораФайла.ПолноеИмяФайла;
		ЗагрузитьИзExcel(Объект, Объект.Контрагент, Объект.Товары, ИмяФайла);
	КонецЕсли;

КонецПроцедуры


Функция НайтиСтрокуЗаголовков(ExcelЛист)

	// Використовуємо нативний Excel Find замість перебору клітинок
	// xlValues = -4163, xlPart = 2 (частковий збіг)
	Попытка
		Результат = ExcelЛист.Cells.Find("Код номенклатури", , -4163, 2);
	Исключение
		Возврат 0;
	КонецПопытки;

	Если Результат = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Результат.Row;

КонецФункции


Функция ОпределитьКолонкиПоЗаголовкам(ExcelЛист, СтрокаЗаголовков)

	Колонки = Новый Структура;
	Колонки.Вставить("КодНоменклатури", 0);
	Колонки.Вставить("Кількість", 0);
	Колонки.Вставить("ЦінаБезПДВ", 0);
	Колонки.Вставить("ЦінаЗПДВ", 0);

	// Обмежуємо пошук рядком заголовків через Rows(N).Find()
	ДиапазонРядка = ExcelЛист.Rows(СтрокаЗаголовков);

	Попытка
		Результат = ДиапазонРядка.Find("Код номенклатури", , -4163, 2);
		Если Результат <> Неопределено Тогда
			Колонки.КодНоменклатури = Результат.Column;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Результат = ДиапазонРядка.Find("Кількість", , -4163, 2);
		Если Результат <> Неопределено Тогда
			Колонки.Кількість = Результат.Column;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Результат = ДиапазонРядка.Find("Ціна без ПДВ", , -4163, 2);
		Если Результат <> Неопределено Тогда
			Колонки.ЦінаБезПДВ = Результат.Column;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Результат = ДиапазонРядка.Find("Ціна з ПДВ", , -4163, 2);
		Если Результат <> Неопределено Тогда
			Колонки.ЦінаЗПДВ = Результат.Column;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Колонки;

КонецФункции


Процедура ЗаполнитьВходящийДокумент(ExcelЛист, Объект)

	// Шукаємо "Видаткова накладна" через нативний Excel Find (замість перебору 100×70 клітинок)
	Попытка
		Результат = ExcelЛист.Cells.Find("Видаткова накладна", , -4163, 2);
	Исключение
		Результат = Неопределено;
	КонецПопытки;

	Если Результат = Неопределено Тогда
		Сообщить("Не знайдено рядок ""Видаткова накладна"" для заповнення вхідного документа.");
		Возврат;
	КонецЕсли;

	СтрокаНакладной = Результат.Row;

	// У знайденому рядку шукаємо комірку з текстом що містить " від " — це номер та дата накладної
	// Формат: "KIANK048700 від 16.01.2026"
	// Використовуємо Find + FindNext для перевірки виключень
	ДиапазонРядка = ExcelЛист.Rows(СтрокаНакладной);
	ТекстНакладной = "";

	Попытка
		Результат = ДиапазонРядка.Find(" від ", , -4163, 2);
	Исключение
		Результат = Неопределено;
	КонецПопытки;

	ПершийАдрес = "";
	Пока Результат <> Неопределено Цикл
		Если ПершийАдрес = "" Тогда
			ПершийАдрес = Результат.Address;
		ИначеЕсли Результат.Address = ПершийАдрес Тогда
			Прервать;
		КонецЕсли;

		Значение = СокрЛП(Результат.Value);
		Если Найти(Значение, "Видаткова") = 0 И Найти(Значение, "LADANK") = 0 Тогда
			ТекстНакладной = Значение;
			Прервать;
		КонецЕсли;

		Попытка
			Результат = ДиапазонРядка.FindNext(Результат);
		Исключение
			Прервать;
		КонецПопытки;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(ТекстНакладной) Тогда
		Сообщить("Не знайдено текст з номером та датою накладної у рядку " + СтрокаНакладной);
		Возврат;
	КонецЕсли;

	// Парсимо: "KIANK048700 від 16.01.2026" -> номер = "KIANK048700", дата = "16.01.2026"
	ПозицияВід = Найти(ТекстНакладной, " від ");
	Если ПозицияВід > 0 Тогда
		НомерВх = СокрЛП(Лев(ТекстНакладной, ПозицияВід - 1));
		ДатаСтр = СокрЛП(Сред(ТекстНакладной, ПозицияВід + 5));

		// Заповнюємо номер вхідного документа
		Объект.НомерВходящегоДокумента = НомерВх;

		// Парсимо дату: "16.01.2026" -> Дата(2026, 1, 16)
		Если СтрДлина(ДатаСтр) >= 10 Тогда
			Попытка
				День  = Число(Лев(ДатаСтр, 2));
				Месяц = Число(Сред(ДатаСтр, 4, 2));
				Год   = Число(Сред(ДатаСтр, 7, 4));
				Объект.ДатаВходящегоДокумента = Дата(Год, Месяц, День);
			Исключение
				Сообщить("Помилка перетворення дати вхідного документа: " + ДатаСтр);
			КонецПопытки;
		КонецЕсли;

		Сообщить("Вхідний документ: № " + НомерВх + " від " + ДатаСтр);
	Иначе
		Сообщить("Не вдалося розібрати номер та дату з: " + ТекстНакладной);
	КонецЕсли;

КонецПроцедуры


Процедура ЗагрузитьИзExcel(Объект, Контрагент, Товары, ИмяФайла)

	Попытка
		Excel = Новый COMОбъект("Excel.Application");
		Excel.WorkBooks.Open(ИмяФайла);
		Состояние("Обробка файлу Microsoft Excel...");
	Исключение
		Сообщить("Помилка. Можливо невірно вказано номер листа книги Excel.");
		Возврат;
	КонецПопытки;

	ФормаИндикатора = ПолучитьОбщуюФорму("ФормаИндикатора");
	ФормаИндикатора.НадписьСостоянияИндикатораОбщая = "Завантаження з Excel";
	ФормаИндикатора.Открыть();

	ИндикаторФормы = ФормаИндикатора.ЭлементыФормы.Индикатор;

	ВыбФайл = Новый Файл(ИмяФайла);
	Если НЕ ВыбФайл.Существует() Тогда
		Сообщить("Файл не існує!");
		Возврат;
	КонецЕсли;

	Попытка
		Состояние("Обробка файлу Microsoft Excel...");
		ExcelЛист = Excel.Sheets(1);
	Исключение
		Сообщить("Помилка. Можливо невірно вказано номер листа книги Excel.");
		Возврат;
	КонецПопытки;

	// Заповнюємо номер та дату вхідного документа з шапки Excel
	ЗаполнитьВходящийДокумент(ExcelЛист, Объект);

	// Визначаємо рядок заголовків та колонки по заголовках
	СтрокаЗаголовков = НайтиСтрокуЗаголовков(ExcelЛист);
	Если СтрокаЗаголовков = 0 Тогда
		Сообщить("Не знайдено рядок заголовків (шукається ""Код номенклатури"")!");
		ФормаИндикатора.Закрыть();
		Excel.WorkBooks.Close();
		Excel = 0;
		Возврат;
	КонецЕсли;

	Колонки = ОпределитьКолонкиПоЗаголовкам(ExcelЛист, СтрокаЗаголовков);

	Если Колонки.КодНоменклатури = 0 Тогда
		Сообщить("Не знайдено колонку ""Код номенклатури""!");
		ФормаИндикатора.Закрыть();
		Excel.WorkBooks.Close();
		Excel = 0;
		Возврат;
	КонецЕсли;

	Если Колонки.Кількість = 0 Тогда
		Сообщить("Не знайдено колонку ""Кількість""!");
	КонецЕсли;

	Если Колонки.ЦінаБезПДВ = 0 И Колонки.ЦінаЗПДВ = 0 Тогда
		Сообщить("Не знайдено колонки цін!");
	КонецЕсли;

	Сообщить("Заголовки знайдено у рядку " + СтрокаЗаголовков
		+ ". Код номенклатури: кол." + Колонки.КодНоменклатури
		+ ", Кількість: кол." + Колонки.Кількість
		+ ", Ціна без ПДВ: кол." + Колонки.ЦінаБезПДВ
		+ ", Ціна з ПДВ: кол." + Колонки.ЦінаЗПДВ);

	// Дані починаються через 2 рядки після заголовків (рядок номерів колонок + перший рядок даних)
	НачалоДанных = СтрокаЗаголовков + 2;
	// Визначаємо останній заповнений рядок листа
	КонецДанных = ExcelЛист.Cells(1, 1).SpecialCells(11).Row;
	ВсегоСтрок = КонецДанных - НачалоДанных + 1;

	Сообщить("Обробка рядків з " + НачалоДанных + " по " + КонецДанных + " (всього " + ВсегоСтрок + ")");

	Для Row = НачалоДанных По КонецДанных Цикл
		Если ВсегоСтрок > 0 Тогда
			ИндикаторФормы.Значение = (Row - НачалоДанных) / ВсегоСтрок * 100;
		КонецЕсли;

		Артикул = СокрЛП(ExcelЛист.Cells(Row, Колонки.КодНоменклатури).Value);

		Если НЕ ЗначениеЗаполнено(Артикул) Тогда
			Продолжить;
		КонецЕсли;

		Кво = ExcelЛист.Cells(Row, Колонки.Кількість).Value;

		// Обираємо ціну в залежності від прапорця СуммаВключаетНДС
		Если Объект.СуммаВключаетНДС Тогда
			Если Колонки.ЦінаЗПДВ > 0 Тогда
				Цена = ExcelЛист.Cells(Row, Колонки.ЦінаЗПДВ).Value;
			Иначе
				Цена = ExcelЛист.Cells(Row, Колонки.ЦінаБезПДВ).Value * 1.2;
			КонецЕсли;
		Иначе
			Цена = ExcelЛист.Cells(Row, Колонки.ЦінаБезПДВ).Value;
		КонецЕсли;

		Если ЗначениеЗаполнено(Артикул) Тогда
			НайденнаяСсылка = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Артикул);
			Если Не ЗначениеЗаполнено(НайденнаяСсылка) Тогда
				Сообщить("Не знайдено номенклатуру за артикулом <" + Артикул + ">");
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
			СтрокаТабличнойЧасти = Товары.Добавить();
			СтрокаТабличнойЧасти.Номенклатура = НайденнаяСсылка;
			СтрокаТабличнойЧасти.Количество = Кво;
			СтрокаТабличнойЧасти.ЕдиницаИзмерения = НайденнаяСсылка.ЕдиницаХраненияОстатков;
			СтрокаТабличнойЧасти.Коэффициент = 1;
			СтрокаТабличнойЧасти.Цена = Цена;

			// Виконати загальні дії для всіх документів при зміні номенклатури.
			ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(СтрокаТабличнойЧасти, Объект);

			// Заповнюємо реквізити табличної частини.
			ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаТабличнойЧасти, Объект, "Приобретение");

			СтруктураШапкиДокумента = Новый Структура("Контрагент, ТипЦен, ДоговорКонтрагента, ДатаДокумента, ВалютаДокумента, УчитыватьНДС, СуммаВключаетНДС",
				Объект.Контрагент, Объект.ТипЦен, Объект.ДоговорКонтрагента, Объект.Дата, Объект.ВалютаДокумента, Объект.УчитыватьНДС, Объект.СуммаВключаетНДС);
			ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуЦенуПокупкиТабЧасти(СтрокаТабличнойЧасти, Объект, СтруктураШапкиДокумента, Константы.ВалютаРегламентированногоУчета.Получить());

			// Розраховуємо реквізити табличної частини.
			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТабличнойЧасти, Объект);
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаТабличнойЧасти, Объект);

			Объект.ЗаполнитьСчетаУчетаВСтрокеТабЧастиРегл(СтрокаТабличнойЧасти, "Товары", Объект.ОтражатьВБухгалтерскомУчете, Истина);
			СтрокаТабличнойЧасти.Склад = Объект.СкладОрдер;
			А_ЗаполнитьЦенурозничнаяРекомендуемая(Объект, СтрокаТабличнойЧасти);

		КонецЕсли;

	КонецЦикла;

	ФормаИндикатора.Закрыть();
	ВыбФайл = 0;
	Excel.WorkBooks.Close();
	Excel = 0;

КонецПроцедуры


Функция А_НайтиПоШтрихКоду(ШтрихКод) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);

	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Штрихкоды.Владелец КАК Номенклатура
	               |ИЗ
	               |	РегистрСведений.Штрихкоды КАК Штрихкоды
	               |ГДЕ
	               |	Штрихкоды.Штрихкод = &Штрихкод";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Номенклатура;
	Иначе
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;

КонецФункции
