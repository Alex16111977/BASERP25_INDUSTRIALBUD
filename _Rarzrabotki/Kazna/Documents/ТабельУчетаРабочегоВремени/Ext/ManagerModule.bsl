#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Разбор значения ячейки дня табеля (реквизиты ПервыйЧасовN табличной части ОтработанноеВремя).
//
// Правила:
//   ""            -> Состояние "", часов нет (движение только при плане > 0);
//   "8", "10,5"   -> Состояние "Р", ЧасыФакт = число (оплата по ставке Казны), ЧасыОфициальные = число;
//   "О","Б","Н","В","С","К","М","Д" -> Состояние = буква, часов нет;
//   "8М"          -> Состояние "М", ЧасыФакт = 0, ЧасыОфициальные = число (оплата официально через ЗУП);
// ЧасыОфициальные = все отработанные часы сотрудника: часы по ставке (ЧасыФакт) плюс часы "М".
//   иное          -> Состояние "?", Ошибка с текстом (в проведении сообщение без отказа).
// Латинские двойники M O B H C K приводятся к кириллице, запятая к точке.
//
// Параметры:
//   Значение - Строка - значение ячейки как введено.
//
// Возвращаемое значение:
//   Структура - Состояние (Строка), ЧасыФакт (Число), ЧасыОфициальные (Число), Ошибка (Строка).
//
Функция РазобратьЗначениеЯчейки(Знач Значение) Экспорт

	Результат = Новый Структура("Состояние, ЧасыФакт, ЧасыОфициальные, Ошибка", "", 0, 0, "");

	Текст = ВРег(СокрЛП(Строка(Значение)));
	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	Текст = СтрЗаменить(Текст, "M", "М");
	Текст = СтрЗаменить(Текст, "O", "О");
	Текст = СтрЗаменить(Текст, "B", "В");
	Текст = СтрЗаменить(Текст, "H", "Н");
	Текст = СтрЗаменить(Текст, "C", "С");
	Текст = СтрЗаменить(Текст, "K", "К");
	Текст = СтрЗаменить(Текст, ",", ".");

	ЧисловаяЧасть = "";
	Позиция = 1;
	Пока Позиция <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789.", Символ) > 0 Тогда
			ЧисловаяЧасть = ЧисловаяЧасть + Символ;
			Позиция = Позиция + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Остаток = Сред(Текст, Позиция);

	ЧислоЧасов = 0;
	ЧислоРазобрано = Ложь;
	Если ЧисловаяЧасть <> "" Тогда
		Попытка
			ЧислоЧасов = Число(ЧисловаяЧасть);
			ЧислоРазобрано = Истина;
		Исключение
			ЧислоРазобрано = Ложь;
		КонецПопытки;
	КонецЕсли;

	Если ЧислоРазобрано И Остаток = "" Тогда
		Результат.Состояние = "Р";
		Результат.ЧасыФакт = ЧислоЧасов;
		Результат.ЧасыОфициальные = ЧислоЧасов;
	ИначеЕсли ЧисловаяЧасть = "" И СтрДлина(Остаток) = 1 И СтрНайти("ОБНВСКМД", Остаток) > 0 Тогда
		Результат.Состояние = Остаток;
	ИначеЕсли ЧислоРазобрано И Остаток = "М" Тогда
		Результат.Состояние = "М";
		Результат.ЧасыОфициальные = ЧислоЧасов;
	Иначе
		Результат.Состояние = "?";
		Результат.Ошибка = "Недопустимое значение '" + Текст + "'. Допустимо: число, буква О/Б/Н/В/С/К/М/Д или число с М (8М)";
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецЕсли
