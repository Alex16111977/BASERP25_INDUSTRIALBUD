
&НаКлиенте
Процедура ДокументыПолученыПриИзменении(Элемент)
	Если Запись.ДатаПолучения=Дата(1,1,1) Тогда
		Запись.ДатаПолучения=ТекущаяДата();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Типзнч(Запись.Документ) = Тип("ДокументСсылка.АвансовыйОтчет") Тогда   
		Элементы.ДокументыОтправлены.Заголовок = "Відправлено на підпис підзвітній особі";
		Элементы.ДокументыПолучены.Заголовок = "Повернено з підписами підзвітної особи";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	//Оповестить("ОтправкаПолучениеДокументов");
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("ОтправкаПолучениеДокументов");
КонецПроцедуры

&НаКлиенте
Процедура ДокументыОтправленыПриИзменении(Элемент)
	Если Запись.ДатаПолучения=Дата(1,1,1) Тогда
		Запись.ДатаОтправки=ТекущаяДата();
	КонецЕсли;

КонецПроцедуры
