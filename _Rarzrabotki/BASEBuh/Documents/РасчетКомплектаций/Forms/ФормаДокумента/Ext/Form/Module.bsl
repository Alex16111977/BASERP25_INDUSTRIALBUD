
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Метрик-панель «Підсумки»: підсвічування «В нормі» (зелений) і «Понад» (янтарний).
	Элементы.ИтогоВНорме.ЦветФона = Новый Цвет(214, 240, 214);
	Элементы.ИтогоПонад.ЦветФона  = Новый Цвет(250, 235, 200);
	// Підсвічування рядків «понад норму» в таблиці аналізу.
	УстановитьУсловноеОформлениеСтрок();
	ПідсумокКарти = Документы.РасчетКомплектаций.ПідсумокКартиЦиклу(Объект.ДокументыОтрузкиИДосписания, Объект.ХронологияПеремещений);
	Элементы.НадписьПідсумокЦиклу.Заголовок = ПідсумокКарти;
	Элементы.НадписьПідсумокДокументів.Заголовок = ПідсумокКарти;
	// Карта циклу: колонки лише для читання (крім «Виправити»), подвійний клік відкриває документ.
	Для Каждого ІмяКолонки Из СтрРазделить("ВидОперации,Статус,Склад,СкладОтправитель,Дата,ДатаФакт,Документ,Проведен,Номенклатура,Количество,Сумма,Организация,ОписаниеОперации,ДатаДоПереноса", ",") Цикл
		Элементы["ДокументыОтрузкиИДосписания" + ІмяКолонки].ТолькоПросмотр = Истина;
	КонецЦикла;
	Для Каждого ІмяКолонки Из СтрРазделить("ВидОперации,Статус,Склад,СкладОтправитель,Дата,ДатаФакт,Документ,Проведен,Организация,ОписаниеОперации,ДатаДоПереноса", ",") Цикл
		Элементы["ХронологияПеремещений" + ІмяКолонки].ТолькоПросмотр = Истина;
	КонецЦикла;
	Элементы.ДокументыОтрузкиИДосписания.УстановитьДействие("Выбор", "ДокументыОтрузкиИДосписанияВыбор");
	Элементы.ХронологияПеремещений.УстановитьДействие("Выбор", "ХронологияПеремещенийВыбор");
	// Зміна реалізації в шапці → дата відвантаження = день реалізації (і M, якщо порожня або раніше D).
	Элементы.ДокументРеализацияТоваровУслуг.УстановитьДействие("ПриИзменении", "ДокументРеализацияТоваровУслугПриИзменении");
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Відновлення робочого місця зі збереженого розрахунку.
	ПрименитьОтборИИтоги();
	// Знімок «Проведено» міг застаріти, якщо документи проводили з іншого вікна.
	ОбновитьСостояниеДокументовНаСервере();
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеСтрок()

	УсловноеОформление.Элементы.Очистить();

	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Представление = "Понад норму";

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТаблицаАнализа.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаАнализа.ПонадНорму");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	ОтборЭлемента.ПравоеЗначение = 0;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(250, 235, 200));

	// Розбіжність одиниць — рожевим (правило пізніше — перекриває янтарне понаднорми).
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Представление = "Розбіжність одиниць";

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТаблицаАнализа.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаАнализа.РасхождениеЕдиниц");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(250, 215, 215));

	// Карта циклу будинку — правила ДОДАЮТЬСЯ останніми (процедура починається з Очистить()).
	ДодатиОформленняКроку("Порушення хронології", "НарушениеХронологии", Новый Цвет(255, 205, 205));
	ДодатиОформленняКроку("Порушення підрозділу", "НарушениеПодразделения", Новый Цвет(255, 190, 160));
	ДодатиОформленняКроку("Помилка", "Ошибка", Новый Цвет(255, 205, 205));
	ДодатиОформленняКроку("Прострочено", "Просрочен", Новый Цвет(255, 225, 190));
	ДодатиОформленняКроку("Не проведено", "НеПроведен", Новый Цвет(255, 245, 190));
	ДодатиОформленняКроку("Планується", "Планируется", Новый Цвет(255, 245, 190));
	ДодатиОформленняКроку("Закритий період", "ЗакрытыйПериод", Новый Цвет(235, 215, 245));
	ДодатиОформленняКроку("Очікує бухгалтера", "ОжидаетБухгалтера", Новый Цвет(205, 225, 255));
	ДодатиОформленняКроку("Створено", "Создан", Новый Цвет(215, 245, 215));
	ДодатиОформленняКроку("Перенесено", "Перенесен", Новый Цвет(215, 245, 215));
	ДодатиОформленняКроку("Інформаційно", "Информационно", Новый Цвет(235, 235, 235));

КонецПроцедуры

&НаСервере
Процедура ДодатиОформленняКроку(Представление, ИмяСтатуса, ЦветФона)

	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Представление = "Цикл: " + Представление;

	Для Каждого ІмяТаблиці Из СтрРазделить("ДокументыОтрузкиИДосписания,ХронологияПеремещений", ",") Цикл
		Если ІмяТаблиці <> "ДокументыОтрузкиИДосписания" Тогда
			Элемент = УсловноеОформление.Элементы.Добавить();
			Элемент.Представление = "Хронологія: " + Представление;
		КонецЕсли;
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы[ІмяТаблиці].Имя);

		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ІмяТаблиці + ".Статус");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = Перечисления.А_СтатусыШагаЦикла[ИмяСтатуса];

		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура Рассчитать(Команда)
	Если Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыРасчетаКомплектаций.ДокументыСозданы") Тогда
		Оповещение = Новый ОписаниеОповещения("РассчитатьПродолжение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
			"Документи вже створено за цим розрахунком. Перезаповнити розрахунок?",
			РежимДиалогаВопрос.ДаНет);
	Иначе
		РассчитатьПродолжение(КодВозвратаДиалога.Да, Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьПродолжение(РезультатВопроса, ДопПараметры) Экспорт
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	РассчитатьНаСервере();
	ПрименитьОтборИИтоги();
	Записать();
КонецПроцедуры

