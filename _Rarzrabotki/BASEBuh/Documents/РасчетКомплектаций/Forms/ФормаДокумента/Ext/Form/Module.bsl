&НаКлиенте
Процедура Печать(Команда)
	ТабДок = ПечатьНаСервере();
	Если ТабДок <> Неопределено Тогда
		ТабДок.Показать("Аналіз залишків (для списання)");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура РассчитатьНаСервере()
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Попытка
		ОбъектОбработки.РассчитатьАнализ();
	Исключение
		Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");
	Сообщить("Розраховано позицій: " + Объект.ТабличнаяЧастьОстатков.Количество());
	Розбіжностей = 0;
	Для Каждого Стр Из Объект.ТабличнаяЧастьОстатков Цикл
		Если Стр.РасхождениеЕдиниц Тогда
			Розбіжностей = Розбіжностей + 1;
		КонецЕсли;
	КонецЦикла;
	Если Розбіжностей > 0 Тогда
		Сообщить("Розбіжностей одиниць: " + Розбіжностей
			+ " рядків (рожеві рядки; див. «Друк розбіжностей одиниць»).");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументыНаСервере(ЗаполнятьВНорме, ЗаполнятьПонад)
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Результат = ОбъектОбработки.ЗаполнитьДокументыПоАнализу(ЗаполнятьВНорме, ЗаполнятьПонад);
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");
	ВывестиРезультатЗаполнения(Результат);
КонецПроцедуры

