// Швидкий фільтр за колонкою, на якій стоїть курсор:
// «Загальна назва (еталон)» -> в шапку «Еталон»; «Склад» -> в шапку «Склад»;
// «Номенклатура» -> у поле «Пошук».
&НаКлиенте
Процедура ФильтрПоПолю(Команда)
	Таб = Элементы.ТаблицаАнализа;
	ТекЭлемент = Таб.ТекущийЭлемент;
	ИмяКолонки = ?(ТекЭлемент = Неопределено, "", ТекЭлемент.Имя);
	ПрименитьФильтрПоКолонке(ИмяКолонки, Таб.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура СброситьОтбор(Команда)
	ОтборСклад = Неопределено;
	ОтборЭталон = Неопределено;
	Пошук = "";
	ТолькоПонадНорму = Ложь;
	ПрименитьОтборИИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьФильтрПоКолонке(ИмяКолонки, СтрокаДанных)
	Если СтрокаДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ИмяКолонки = "ТАСклад" Тогда
		ОтборСклад = СтрокаДанных.Склад;
	ИначеЕсли ИмяКолонки = "ТАОбщееНазвание" Тогда
		ОтборЭталон = СтрокаДанных.ОбщееНазвание;
	ИначеЕсли ИмяКолонки = "ТАНоменклатура" Тогда
		Пошук = Строка(СтрокаДанных.Номенклатура);
	Иначе
		// числові колонки (Залишок/Норма/В нормі/Понад) — фільтр не застосовуємо
		Возврат;
	КонецЕсли;
	ПрименитьОтборИИтоги();
КонецПроцедуры

// Перебудовує таблицю анализа (ТаблицаАнализа) під поточний відбір/пошук
// і одночасно рахує підсумки. Джерело — повний Объект.ТабличнаяЧастьОстатков
// (заповнюється РассчитатьАнализ). Документи заповнюються з повного набору окремо.
&НаКлиенте
Процедура ПрименитьОтборИИтоги()

	ИтогоЗалишок = 0;
	ИтогоВНорме  = 0;
	ИтогоПонад   = 0;
	ИтогоЭкономия = 0;
	ИтогоСуммаОстатка = 0;
	ИтогоВНормеСума   = 0;
	ИтогоПонадСума    = 0;
	ИтогоЕкономіяСума = 0;
	ТаблицаАнализа.Очистить();

	ТекстПошуку = ВРег(СокрЛП(Пошук));

	Для Каждого Стр Из Объект.ТабличнаяЧастьОстатков Цикл

		Если ЗначениеЗаполнено(ОтборСклад) И Стр.Склад <> ОтборСклад Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ОтборЭталон) И Стр.ОбщееНазвание <> ОтборЭталон Тогда
			Продолжить;
		КонецЕсли;
		Если ТолькоПонадНорму И НЕ (Стр.ПонадНорму > 0) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ТекстПошуку) Тогда
			Ціль = ВРег(Строка(Стр.Номенклатура) + " " + Строка(Стр.ОбщееНазвание) + " " + Строка(Стр.Склад) + " " + Строка(Стр.Счет));
			Если СтрНайти(Ціль, ТекстПошуку) = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		НС = ТаблицаАнализа.Добавить();
		НС.ОбщееНазвание = Стр.ОбщееНазвание;
		НС.Номенклатура  = Стр.Номенклатура;
		НС.Склад         = Стр.Склад;
		НС.Организация   = Стр.Организация;
			НС.Счет          = Стр.Счет;
			НС.Экономия      = Стр.Экономия;
		НС.Остаток       = Стр.Остаток;
		НС.Норма         = Стр.Норма;
		НС.ВНорме        = Стр.ВНорме;
		НС.ПонадНорму    = Стр.ПонадНорму;
		НС.Единица         = Стр.Единица;
		НС.ЕдиницаСС       = Стр.ЕдиницаСС;
		НС.СуммаОстатка    = Стр.СуммаОстатка;
		НС.НормаСумма      = Стр.НормаСумма;
		НС.ВНормеСумма     = Стр.ВНормеСумма;
		НС.ПонадНормуСумма = Стр.ПонадНормуСумма;
		НС.ЕкономіяСума    = Стр.ЕкономіяСума;
		НС.НормаНоменкл     = Стр.НормаНоменкл;
		НС.НормаСуммаНоменкл = Стр.НормаСуммаНоменкл;
		НС.Этап            = Стр.Этап;
		НС.РасхождениеЕдиниц = Стр.РасхождениеЕдиниц;

		ИтогоЗалишок = ИтогоЗалишок + Стр.Остаток;
		ИтогоВНорме  = ИтогоВНорме  + Стр.ВНорме;
		ИтогоПонад   = ИтогоПонад   + Стр.ПонадНорму;
		ИтогоЭкономия = ИтогоЭкономия + Стр.Экономия;
		ИтогоСуммаОстатка = ИтогоСуммаОстатка + Стр.СуммаОстатка;
		ИтогоВНормеСума   = ИтогоВНормеСума   + Стр.ВНормеСумма;
		ИтогоПонадСума    = ИтогоПонадСума    + Стр.ПонадНормуСумма;
		ИтогоЕкономіяСума = ИтогоЕкономіяСума + Стр.ЕкономіяСума;

	КонецЦикла;

КонецПроцедуры


&НаКлиенте
Процедура СверхНормыКоличествоПриИзменении(Элемент)
	Стр = Элементы.СписаниеСверхНормы.ТекущиеДанные;
	Если Стр = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Стр.Сумма = Окр(Стр.Количество * Стр.Цена, 2);
	Если Стр.КоличествоКСписанию > Стр.Количество Тогда
		Стр.КоличествоКСписанию = Стр.Количество;
	КонецЕсли;
	Если ЗначениеЗаполнено(Стр.Номенклатура) И ЗначениеЗаполнено(Стр.Склад) Тогда
		ПроверитьОстатокСтрокиНаСервере(Стр.Номенклатура, Стр.Склад, Стр.Количество);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СверхНормыКоличествоКСписаниюПриИзменении(Элемент)
	Стр = Элементы.СписаниеСверхНормы.ТекущиеДанные;
	Если Стр = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Стр.КоличествоКСписанию < 0 Тогда
		Стр.КоличествоКСписанию = 0;
	КонецЕсли;
	Если Стр.КоличествоКСписанию > Стр.Количество Тогда
		Стр.КоличествоКСписанию = Стр.Количество;
		Сообщить("Кількість до списання не може перевищувати понаднормову — зменшено до " + Стр.Количество + ".");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СверхНормыПослеУдаления(Элемент)
КонецПроцедуры

&НаКлиенте
Процедура СверхНормыЦенаПриИзменении(Элемент)
	Стр = Элементы.СписаниеСверхНормы.ТекущиеДанные;
	Если Стр = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Стр.Сумма = Окр(Стр.Количество * Стр.Цена, 2);
КонецПроцедуры

&НаКлиенте
Процедура СверхНормыНоменклатураПриИзменении(Элемент)
	ПодобратьДанныеСтрокиСверхНормы();
КонецПроцедуры

&НаКлиенте
Процедура СверхНормыСкладПриИзменении(Элемент)
	ПодобратьДанныеСтрокиСверхНормы();
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьДанныеСтрокиСверхНормы()
	Стр = Элементы.СписаниеСверхНормы.ТекущиеДанные;
	Если Стр = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Стр.Номенклатура) ИЛИ НЕ ЗначениеЗаполнено(Стр.Склад) Тогда
		Возврат;
	КонецЕсли;
	Данные = ДанныеОстаткаНаСервере(Стр.Номенклатура, Стр.Склад);
	Если Данные = Неопределено Тогда
		Сообщить("Залишок за цією номенклатурою на складі не знайдено (рахунок/ціну не підібрано).");
		Возврат;
	КонецЕсли;
	Стр.Счет = Данные.Счет;
	Стр.Единица = Данные.Единица;
	Стр.ОбщееНазвание = Данные.ОбщееНазвание;
	Стр.Цена = Данные.Цена;
	Стр.Сумма = Окр(Стр.Количество * Стр.Цена, 2);
	Стр.КоличествоСС = Данные.КоличествоСС;
	Стр.СуммаСС = Данные.СуммаСС;
	Стр.Организация = Данные.Организация;
КонецПроцедуры

// Подтверждение списания: галочка -> автор и время; снятие -> очистка.
// Серверная гарантия того же — в ПередЗаписью объекта.
&НаКлиенте
Процедура СписанняПідтвердженоПриИзменении(Элемент)
	Если Объект.СписанняПідтверджено Тогда
		Объект.СписанняПідтвердженоАвтор = ПодтверждениеАвторНаСервере();
	Иначе
		Объект.СписанняПідтвердженоАвтор = "";
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодтверждениеАвторНаСервере()
	Возврат Строка(Пользователи.ТекущийПользователь()) + ", "
		+ Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'");
КонецФункции

&НаСервере
Функция ДанныеОстаткаНаСервере(Номенклатура, Склад)
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектДокумента.ДанныеОстаткаДляСтроки(Номенклатура, Склад);
КонецФункции

&НаСервере
Процедура ПроверитьОстатокСтрокиНаСервере(Номенклатура, Склад, Количество)
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	Данные = ОбъектДокумента.ДанныеОстаткаДляСтроки(Номенклатура, Склад);
	Если Данные = Неопределено Тогда
		Сообщить("Увага: залишку немає — списуємо без покриття залишком.");
	ИначеЕсли Количество > Данные.Остаток Тогда
		Сообщить("Увага: кількість " + Количество + " перевищує залишок " + Данные.Остаток + ".");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПечатьАкт(Команда)
	ТабДок = ПечатьАктНаСервере();
	Если ТабДок <> Неопределено Тогда
		ТабДок.Показать("Акт на списання понаднормових матеріалів");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПечатьАктНаСервере()
	Если Объект.СписаниеСверхНормы.Количество() = 0 Тогда
		Сообщить("Таблиця «Списання понад норму» порожня.");
		Возврат Неопределено;
	КонецЕсли;
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектДокумента.СформироватьПечатьАкт();
КонецФункции

// Акт за фактом: джерело — проводки проведених документів «Додаткова»,
// а не таблиця списання. Тому працює й після переоткриття без «Розрахувати».
&НаКлиенте
Процедура ПечатьАктФакт(Команда)
	ТабДок = ПечатьАктФактНаСервере();
	Если ТабДок <> Неопределено Тогда
		ТабДок.Показать("Акт на списання понаднормових матеріалів (за проведеними)");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПечатьАктФактНаСервере()
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Спочатку запишіть документ.");
		Возврат Неопределено;
	КонецЕсли;
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектДокумента.СформироватьПечатьАктФакт();
КонецФункции

&НаКлиенте
Процедура ПечатьРозбижности(Команда)
	ТабДок = ПечатьРозбижностиНаСервере();
	Если ТабДок <> Неопределено Тогда
		ТабДок.Показать("Розбіжності одиниць (норми - фактичний прихід)");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПечатьРозбижностиНаСервере()
	Если Объект.ТабличнаяЧастьОстатков.Количество() = 0 Тогда
		Сообщить("Спочатку натисніть «Розрахувати».");
		Возврат Неопределено;
	КонецЕсли;
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектДокумента.СформироватьПечатьРозбіжностіОдиниць();
КонецФункции

&НаКлиенте
Процедура ПечатьМ29(Команда)
	ТабДок = ПечатьМ29НаСервере();
	Если ТабДок <> Неопределено Тогда
		ТабДок.Показать("М-29. Звіт про витрати основних матеріалів у будівництві");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПечатьМ29НаСервере()
	// М-29 читає проводки проведених документів, а не результат «Розрахувати»,
	// тому друкується і після переоткриття документа без перерахунку.
	Если Объект.ДокументиКомплектації.Количество() = 0
		И Объект.ДокументиМалоценки.Количество() = 0 Тогда
		Сообщить("Немає документів комплектації/малоцінки — друкувати нічого.");
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Спочатку запишіть документ.");
		Возврат Неопределено;
	КонецЕсли;
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектДокумента.СформироватьПечатьМ29();
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Підменю «Документи» — управління проведенням цільових документів
//
// Робочий цикл бухгалтера: бухгалтер довозить матеріали на склад -> щоб оновити
// документи, їх треба РОЗПРОВЕСТИ (інакше перезапис ТЧ залишить старі рухи),
// потім РОЗРАХУВАТИ, потім ЗАПОВНИТИ, потім ПРОВЕСТИ. Кнопка «Оновити документи»
// робить це одним кліком; окремі кроки лишаються для втручання посередині.

&НаКлиенте
Процедура ОбновитьДокументы(Команда)

	Если НЕ ПроверитьГотовностьКОперации() Тогда
		Возврат;
	КонецЕсли;

	Всего = ЧислоЦелевыхДокументовНаСервере();
	Текст = "Оновити документи?" + Символы.ПС + Символы.ПС
		+ "Буде виконано:" + Символы.ПС
		+ "  1. Розпроведення документів: " + Всего + Символы.ПС
		+ "  2. Перерахунок аналізу залишків" + Символы.ПС
		+ "  3. Перезаповнення документів (в нормі + понад норму)" + Символы.ПС
		+ "  4. За потреби — створення відсутніх «Призначень використання»" + Символы.ПС
		+ "  5. Проведення документів: " + Всего + Символы.ПС + Символы.ПС
		+ "УВАГА: ручні правки в «Списання понад норму» (Причина," + Символы.ПС
		+ "Кількість до списання) будуть ЗАТЕРТІ перерахунком.";

	ПоказатьВопрос(Новый ОписаниеОповещения("ОбновитьДокументыЗавершение", ЭтотОбъект),
		Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Оновлення документів");

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДокументыЗавершение(Ответ, ДопПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ВыполнитьЦиклОбновленияНаСервере();
	ПрименитьОтборИИтоги();
КонецПроцедуры

&НаКлиенте
Процедура РаспровестиВсе(Команда)
	Если НЕ ПроверитьГотовностьКОперации() Тогда
		Возврат;
	КонецЕсли;
	Текст = "Розпровести всі документи розрахунку (" + ЧислоЦелевыхДокументовНаСервере() + ")?"
		+ Символы.ПС + "Рухи по регістрах будуть скасовані.";
	ПоказатьВопрос(Новый ОписаниеОповещения("РаспровестиВсеЗавершение", ЭтотОбъект),
		Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Розпроведення");
КонецПроцедуры

&НаКлиенте
Процедура РаспровестиВсеЗавершение(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		РаспровестиВсеНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПровестиВсе(Команда)
	Если НЕ ПроверитьГотовностьКОперации() Тогда
		Возврат;
	КонецЕсли;
	Текст = "Провести всі документи розрахунку (" + ЧислоЦелевыхДокументовНаСервере() + ")?"
		+ Символы.ПС + "Уже проведені будуть перепроведені — це актуалізує рухи.";
	ПоказатьВопрос(Новый ОписаниеОповещения("ПровестиВсеЗавершение", ЭтотОбъект),
		Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Проведення");
КонецПроцедуры

&НаКлиенте
Процедура ПровестиВсеЗавершение(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПровестиВсеНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСостояние(Команда)
	ОбновитьСостояниеДокументовНаСервере();
	Сообщить("Стан документів оновлено.");
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Серверна частина підменю

&НаКлиенте
Функция ПроверитьГотовностьКОперации()
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Спочатку запишіть документ.");
		Возврат Ложь;
	КонецЕсли;
	Если Модифицированность Тогда
		Сообщить("Спочатку запишіть зміни (документ модифіковано).");
		Возврат Ложь;
	КонецЕсли;
	Если ЧислоЦелевыхДокументовНаСервере() = 0 Тогда
		Сообщить("У розрахунку не вибрано жодного документа комплектації/малоцінки.");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаСервере
Функция ЧислоЦелевыхДокументовНаСервере()
	Возврат РеквизитФормыВЗначение("Объект").ЦелевыеДокументы().Количество();
КонецФункции

&НаСервере
Процедура РаспровестиВсеНаСервере()
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	Результат = ОбъектДокумента.РаспровестиДокументы();
	ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
	ЗаписатьРасчетПослеОперации();
	ВывестиРезультатОперации("Розпроведено", Результат);
КонецПроцедуры

&НаСервере
Процедура ПровестиВсеНаСервере()
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	Результат = ОбъектДокумента.ПровестиДокументы();
	ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
	ЗаписатьРасчетПослеОперации();
	ВывестиРезультатОперации("Проведено", Результат);
КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояниеДокументовНаСервере()
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	ОбъектДокумента.ОбновитьСостояниеДокументов();
	ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
КонецПроцедуры

// Увесь цикл в одному серверному виклику: розпровести -> розрахувати ->
// заповнити -> провести. Кожен крок звітує окремо, щоб було видно, де стало.
&НаСервере
Процедура ВыполнитьЦиклОбновленияНаСервере()

	ОбъектДокумента = РеквизитФормыВЗначение("Объект");

	Сообщить("--- Крок 1: розпроведення ---");
	РезРаспр = ОбъектДокумента.РаспровестиДокументы();
	ВывестиРезультатОперации("Розпроведено", РезРаспр);

	Сообщить("--- Крок 2: перерахунок аналізу ---");
	ОбъектДокумента.РассчитатьАнализ();
	Сообщить("Рядків аналізу: " + ОбъектДокумента.ТабличнаяЧастьОстатков.Количество()
		+ "; за нормами: " + ОбъектДокумента.СписаниеПоНормам.Количество()
		+ "; понад норму: " + ОбъектДокумента.СписаниеСверхНормы.Количество());

	Сообщить("--- Крок 3: заповнення документів ---");
	РезЗап = ОбъектДокумента.ЗаполнитьДокументыПоАнализу(Истина, Истина);
	ВывестиРезультатЗаполнения(РезЗап);

	// Рядок малоцінки без НазначениеИспользования валить типове проведення
	// (УправлениеЗапасамиПартионныйУчет: «Значение не является значением объектного
	// типа (Забалансовый)») — документ лишився б розпроведеним, а в обліку зʼявилась
	// би дірка.
	//
	// Чому це стається саме в циклі: розпроведення повертає матеріали на склад,
	// перерахунок бачить БІЛЬШІ залишки, і в понаднорму потрапляє номенклатура,
	// для якої призначення з поточним «Способом відображення витрат» ще немає.
	//
	// Тому крок 3а: заводимо відсутні картки за зразком наявних і ПЕРЕзаповнюємо
	// документи — тепер рядки отримають призначення. Зупиняємось лише якщо
	// створити картки не вдалося.
	Если РезЗап.БезНазначення > 0 Тогда
		Сообщить("--- Крок 3а: створення відсутніх «Призначень використання» ---");
		Сообщить("Рядків без призначення: " + РезЗап.БезНазначення);
		Для Каждого Пара Из РезЗап.НоменклатуриБезПризначення Цикл
			Сообщить("   • " + Строка(Пара.Номенклатура) + "  /  " + Строка(Пара.Способ));
		КонецЦикла;

		РезПризн = ОбъектДокумента.СоздатьОтсутствующиеНазначения(
			РезЗап.НоменклатуриБезПризначення);
		Сообщить("Створено карток: " + РезПризн.Створено
			+ ?(РезПризн.Пропущено > 0, "; пропущено (уже були): " + РезПризн.Пропущено, ""));
		Для Каждого ТекстОшибки Из РезПризн.Помилки Цикл
			Сообщить("ПОМИЛКА створення: " + ТекстОшибки);
		КонецЦикла;

		Сообщить("--- Крок 3б: перезаповнення документів із новими призначеннями ---");
		РезЗап = ОбъектДокумента.ЗаполнитьДокументыПоАнализу(Истина, Истина);
		ВывестиРезультатЗаполнения(РезЗап);
	КонецЕсли;

	// Якщо після створення карток рядки без призначення лишились — НЕ проводимо.
	Если РезЗап.БезНазначення > 0 Тогда
		Сообщить("");
		Сообщить("=== ПРОВЕДЕННЯ СКАСОВАНО ===");
		Сообщить("Рядків без «Призначення використання» лишилось: " + РезЗап.БезНазначення
			+ ". Такий рядок не дасть провести документ.");
		Сообщить("Заведіть картки вручну для номенклатур:");
		Для Каждого Пара Из РезЗап.НоменклатуриБезПризначення Цикл
			Сообщить("   • " + Строка(Пара.Номенклатура) + "  /  " + Строка(Пара.Способ));
		КонецЦикла;
		Сообщить("Документи лишились РОЗПРОВЕДЕНИМИ. Після заведення призначень"
			+ " натисніть «Оновити документи» ще раз або «Провести всі».");
		ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
		ЗаписатьРасчетПослеОперации();
		Возврат;
	КонецЕсли;

	Если РезЗап.Помилки.Количество() > 0 Тогда
		Сообщить("");
		Сообщить("=== ПРОВЕДЕННЯ СКАСОВАНО: заповнення завершилось з помилками ===");
		Сообщить("Документи лишились РОЗПРОВЕДЕНИМИ.");
		ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
		ЗаписатьРасчетПослеОперации();
		Возврат;
	КонецЕсли;

	Сообщить("--- Крок 4: проведення ---");
	РезПров = ОбъектДокумента.ПровестиДокументы();
	ВывестиРезультатОперации("Проведено", РезПров);

	ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
	ЗаписатьРасчетПослеОперации();

	Если РезРаспр.Помилки.Количество() = 0 И РезПров.Помилки.Количество() = 0 Тогда
		Сообщить("=== Документи оновлено успішно ===");
	Иначе
		Сообщить("=== Оновлення завершено З ПОМИЛКАМИ — див. повідомлення вище ===");
	КонецЕсли;

КонецПроцедуры


// Колонки-знімки «Проведено» живуть у ТЧ, тому їх треба зберегти.
&НаСервере
Процедура ЗаписатьРасчетПослеОперации()
	Попытка
		ТекущийОбъект = РеквизитФормыВЗначение("Объект");
		ТекущийОбъект.Записать();
		ЗначениеВРеквизитФормы(ТекущийОбъект, "Объект");
		Модифицированность = Ложь;
	Исключение
		Сообщить("Не вдалося зберегти розрахунок: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ВывестиРезультатОперации(Дія, Результат)
	Сообщить(Дія + " документів: " + Результат.Оброблено
		+ ?(Результат.Пропущено > 0, "; пропущено (уже в потрібному стані): "
			+ Результат.Пропущено, ""));
	Для Каждого ТекстОшибки Из Результат.Помилки Цикл
		Сообщить("ПОМИЛКА: " + ТекстОшибки);
	КонецЦикла;
КонецПроцедуры
