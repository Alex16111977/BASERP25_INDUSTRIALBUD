// Перенести дату документа поточного рядка таблиці документів на планову (наприклад, вимогу,
// проведену раніше комплектацій монтажу). Ставить прихований прапорець «Виправити» і зове той самий сервер.
&НаКлиенте
Процедура ПеренестиДатуПоточного(Команда)

	ТекущиеДанные = Элементы.ДокументыОтрузкиИДосписания.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		ПоказатьПредупреждение(, "У рядку немає документа.");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Дата) Тогда
		ПоказатьПредупреждение(, "У рядку немає планової дати — спершу «Проаналізувати».");
		Возврат;
	КонецЕсли;
	Текст = "Перенести " + Строка(ТекущиеДанные.Документ) + Символы.ПС
		+ "на планову дату " + Формат(ТекущиеДанные.Дата, "ДФ='dd.MM.yyyy HH:mm:ss'") + "?" + Символы.ПС + Символы.ПС
		+ "Документ буде перепроведено; стара дата збережеться (колонка «Дата до перенесення»).";
	Оповещение = Новый ОписаниеОповещения("ПеренестиДатуПоточногоЗавершення", ЭтотОбъект, ТекущиеДанные.ПолучитьИдентификатор());
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Перенесення дати");

КонецПроцедуры

&НаКлиенте
Процедура ПеренестиДатуПоточногоЗавершення(Ответ, ИдентификаторСтроки) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	СтрокаКарты = Объект.ДокументыОтрузкиИДосписания.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаКарты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаКарты.Виправити = Истина;
	ПеренестиДатиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПерепровестиЦикл(Команда)

	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("БезРеалізації", "Так, без реалізації");
	Кнопки.Добавить("ЗРеалізацією", "Так, разом з реалізацією");
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, "Ні");
	Текст = "Перепровести ВСІ проведені документи циклу будинку у фактичному хронологічному порядку (перерахунок партій)?"
		+ Символы.ПС + Символы.ПС
		+ "Реалізація за замовчуванням не чіпається (перереєстрація в обміні з ЕРП). Розподіл за нормами не виконується —"
		+ " це не «Перерахувати і провести». Непроведені й помічені на видалення документи пропускаються.";
	Оповещение = Новый ОписаниеОповещения("ПерепровестиЦиклЗавершення", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, Кнопки, , КодВозвратаДиалога.Отмена, "Перепроведення циклу будинку");

КонецПроцедуры

&НаКлиенте
Процедура ПерепровестиЦиклЗавершення(Ответ, Параметры) Экспорт

	Если Ответ = Неопределено Или Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	ПерепровестиЦиклНаСервере(Ответ = "ЗРеалізацією");

КонецПроцедуры

&НаСервере
Процедура ПерепровестиЦиклНаСервере(ЗРеалізацією)

	ОбъектРасчета = РеквизитФормыВЗначение("Объект");
	РезультатЦиклу = ОбъектРасчета.ПерепровестиДокументиЦиклу(ЗРеалізацією);
	ЗначениеВРеквизитФормы(ОбъектРасчета, "Объект");
	ЗаписатьРасчетПослеОперации();
	ОновитиПідсумокЦиклу(РезультатЦиклу);
	ВивестиПовідомленняЦиклу(РезультатЦиклу);

КонецПроцедуры

&НаКлиенте
Процедура ДокументРеализацияТоваровУслугПриИзменении(Элемент)

	Если Не ЗначениеЗаполнено(Объект.ДокументРеализацияТоваровУслуг) Тогда
		Возврат;
	КонецЕсли;
	ДеньРеалізації = ДеньДокументаНаСервере(Объект.ДокументРеализацияТоваровУслуг);
	Если Не ЗначениеЗаполнено(ДеньРеалізації) Тогда
		Возврат;
	КонецЕсли;
	Объект.ДатаОтгрузки = ДеньРеалізації;
	Если Не ЗначениеЗаполнено(Объект.ДатаСписанияПоМонтажу) Или Объект.ДатаСписанияПоМонтажу < ДеньРеалізації Тогда
		Объект.ДатаСписанияПоМонтажу = НачалоДня(КонецМесяца(ДеньРеалізації + 10 * 86400));
	КонецЕсли;
	Сообщить("Дата відвантаження = день реалізації: " + Формат(ДеньРеалізації, "ДФ=dd.MM.yyyy")
		+ "; дата списання по монтажу: " + Формат(Объект.ДатаСписанияПоМонтажу, "ДФ=dd.MM.yyyy") + ".");

КонецПроцедуры

&НаСервереБезКонтекста
Функция ДеньДокументаНаСервере(ДокСсылка)

	Возврат НачалоДня(ДокСсылка.Дата);

КонецФункции

&НаКлиенте
Процедура ЗалишкиЦиклу(Команда)

	ЗалишкиЦиклуНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗалишкиЦиклуНаСервере()

	ОбъектРасчета = РеквизитФормыВЗначение("Объект");
	Зал = ОбъектРасчета.ЗалишкиПісляЦиклу();
	Сообщить(Зал.Текст);
	Если Не Зал.Пусто И Зал.Рядки <> Неопределено Тогда
		Для Каждого Рядок Из Зал.Рядки Цикл
			Сообщить("   " + Строка(Рядок.Счет.Код) + " | " + Строка(Рядок.Склад) + " | " + Строка(Рядок.Организация) + " | кількість "
				+ Формат(Рядок.Кол, "ЧДЦ=3; ЧН=0") + " | сума " + Формат(Рядок.Сумма, "ЧДЦ=2; ЧРГ=' '; ЧН=0"));
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОновитиПідсумокЦиклу(РезультатЦиклу)

	Если РезультатЦиклу = Неопределено Или Не РезультатЦиклу.Свойство("Підсумок") Тогда
		Возврат;
	КонецЕсли;
	Элементы.НадписьПідсумокЦиклу.Заголовок = РезультатЦиклу.Підсумок;
	Элементы.НадписьПідсумокДокументів.Заголовок = РезультатЦиклу.Підсумок;

КонецПроцедуры

&НаСервере
Процедура ВивестиПовідомленняЦиклу(РезультатЦиклу)

	Если РезультатЦиклу = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если РезультатЦиклу.Свойство("Сообщения") Тогда
		Для Каждого ТекстСообщения Из РезультатЦиклу.Сообщения Цикл
			Сообщить(ТекстСообщения);
		КонецЦикла;
	КонецЕсли;
	Если РезультатЦиклу.Свойство("Помилки") Тогда
		Для Каждого ТекстПомилки Из РезультатЦиклу.Помилки Цикл
			Сообщить("ПОМИЛКА: " + ТекстПомилки);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ЗаписатьРасчетПослеОперации()
	Попытка
		ТекущийОбъект = РеквизитФормыВЗначение("Объект");
		ТекущийОбъект.Записать();
		ЗначениеВРеквизитФормы(ТекущийОбъект, "Объект");
		Модифицированность = Ложь;
	Исключение
		Сообщить("Не вдалося зберегти розрахунок: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ВывестиРезультатОперации(Дія, Результат)
	Сообщить(Дія + " документів: " + Результат.Оброблено
		+ ?(Результат.Пропущено > 0, "; пропущено (уже в потрібному стані): "
			+ Результат.Пропущено, ""));
	Для Каждого ТекстОшибки Из Результат.Помилки Цикл
		Сообщить("ПОМИЛКА: " + ТекстОшибки);
	КонецЦикла;
КонецПроцедуры

#Область ПричиниЦеху

// Зворотне завантаження друкованої форми «Аналіз для цеху (з коментарем)»:
// файл обирається на клієнті, кладеться у тимчасове сховище, читає його рух движок
// документа (ЗавантажитиПричиниЦехуЗФайлу) — з файлу береться ЛИШЕ колонка «Коментар цеху».

&НаКлиенте
Процедура ЗавантажитиКоментаріЦеху(Команда)
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Заголовок = "Оберіть файл «Аналіз для цеху» з коментарями";
	ДиалогВыбора.Фильтр = "Книга Excel (*.xlsx)|*.xlsx|Таблиця OpenDocument (*.ods)|*.ods|Табличний документ (*.mxl)|*.mxl";
	ДиалогВыбора.МножественныйВыбор = Ложь;
	Если НЕ ДиалогВыбора.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	ПолноеИмяФайла = ДиалогВыбора.ПолноеИмяФайла;
	АдресФайла = "";
	Если НЕ ПоместитьФайл(АдресФайла, ПолноеИмяФайла, , Ложь, УникальныйИдентификатор) Тогда
		Возврат;
	КонецЕсли;
	ЗавантажитиКоментаріЦехуНаСервері(АдресФайла, ПолноеИмяФайла);
КонецПроцедуры

&НаСервере
Процедура ЗавантажитиКоментаріЦехуНаСервері(АдресФайла, ПолноеИмяФайла)
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Протокол = ОбъектОбработки.ЗавантажитиПричиниЦехуЗФайлу(АдресФайла, ПолноеИмяФайла);
	Если ПустаяСтрока(Протокол.Ошибка) Тогда
		ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");
		Модифицированность = Истина;
	КонецЕсли;
	ВывестиПротоколПричин(Протокол);
КонецПроцедуры

&НаСервере
Процедура ВывестиПротоколПричин(Протокол)
	Если НЕ ПустаяСтрока(Протокол.Ошибка) Тогда
		Сообщить(Протокол.Ошибка);
		Возврат;
	КонецЕсли;
	Сообщить("Коментарі цеху: у файлі " + Протокол.Всего
		+ ", нових " + Протокол.Загружено
		+ ", оновлених " + Протокол.Обновлено
		+ ", без змін " + Протокол.БезИзменений
		+ ", проставлено у понаднормове списання " + Протокол.Применено);
	Если Протокол.НеНайдено > 0 Тогда
		Сообщить("Немає у цьому розрахунку (коментар не проставлено): " + Протокол.НеНайдено);
	КонецЕсли;
	Если Протокол.Конфликт > 0 Тогда
		Сообщить("Неоднозначні позиції (коментар не проставлено): " + Протокол.Конфликт);
	КонецЕсли;
	Если Протокол.Обрезано > 0 Тогда
		Сообщить("Обрізано до 200 символів: " + Протокол.Обрезано);
	КонецЕсли;
	Для Каждого ТекстСообщения Из Протокол.Сообщения Цикл
		Сообщить(ТекстСообщения);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗастосуватиПричиниДоСписання(Команда)
	Сообщить("Проставлено причин у понаднормове списання: " + ЗастосуватиПричиниДоСписанняНаСервері());
КонецПроцедуры

&НаСервере
Функция ЗастосуватиПричиниДоСписанняНаСервері()
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Протокол = Новый Структура("Применено", 0);
	ОбъектОбработки.ЗастосуватиПричиниЦеху(Протокол);
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");
	Модифицированность = Истина;
	Возврат Протокол.Применено;
КонецФункции

&НаКлиенте
Процедура ОчиститиПричиниЦеху(Команда)
	Если Объект.ПричиниЦеху.Количество() = 0 Тогда
		Сообщить("Причин цеху немає.");
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ОчиститиПричиниЦехуЗавершення", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		"Очистити всі причини цеху і колонку «Причина» у понаднормовому списанні?",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Причини цеху");
КонецПроцедуры

&НаКлиенте
Процедура ОчиститиПричиниЦехуЗавершення(РезультатВопроса, ДопПараметры) Экспорт
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ОчиститиПричиниЦехуНаСервері();
	Сообщить("Причини цеху очищено.");
КонецПроцедуры

&НаСервере
Процедура ОчиститиПричиниЦехуНаСервері()
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ОбъектОбработки.ОчиститиПричиниЦеху();
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");
	Модифицированность = Истина;
КонецПроцедуры

#КонецОбласти
