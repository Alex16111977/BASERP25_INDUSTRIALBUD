	Подписи.Добавить("Член комісії:   ______________________   ______________________");
	Подписи.Добавить("МВО:            ______________________   ______________________");
	Для Каждого ТекстПодписи Из Подписи Цикл
		Обл = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 9);
		Обл.Объединить();
		Обл.Текст = ТекстПодписи;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	ТабДок.Область(2, 1, 2, 1).ШиринаКолонки = 5;
	ТабДок.Область(2, 2, 2, 2).ШиринаКолонки = 45;
	ТабДок.Область(2, 3, 2, 3).ШиринаКолонки = 26;
	ТабДок.Область(2, 4, 2, 4).ШиринаКолонки = 10;
	ТабДок.Область(2, 5, 2, 5).ШиринаКолонки = 10;
	ТабДок.Область(2, 6, 2, 6).ШиринаКолонки = 12;
	ТабДок.Область(2, 7, 2, 7).ШиринаКолонки = 12;
	ТабДок.Область(2, 8, 2, 8).ШиринаКолонки = 14;
	ТабДок.Область(2, 9, 2, 9).ШиринаКолонки = 40;

	Возврат ТабДок;
КонецФункции

// Кэш единиц эталонов ОДНИМ запросом: ОбщееНазвание -> ОбщиеНазванияНоменклатуры.Единица.
Функция ЕдиницыЭталонов(СтрокиАнализа)
	Кэш = Новый Соответствие;
	Відомі = Новый Соответствие;
	Эталоны = Новый Массив;
	Для Каждого Стр Из СтрокиАнализа Цикл
		Если ЗначениеЗаполнено(Стр.ОбщееНазвание) И Відомі.Получить(Стр.ОбщееНазвание) = Неопределено Тогда
			Відомі.Вставить(Стр.ОбщееНазвание, Истина);
			Эталоны.Добавить(Стр.ОбщееНазвание);
		КонецЕсли;
	КонецЦикла;
	Если Эталоны.Количество() = 0 Тогда
		Возврат Кэш;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОН.Ссылка КАК Эталон,
	|	ОН.Единица КАК Единица
	|ИЗ
	|	Справочник.ОбщиеНазванияНоменклатуры КАК ОН
	|ГДЕ
	|	ОН.Ссылка В (&Эталоны)";
	Запрос.УстановитьПараметр("Эталоны", Эталоны);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Кэш.Вставить(Выборка.Эталон, Выборка.Единица);
	КонецЦикла;
	Возврат Кэш;
КонецФункции

// Правило розбіжності одиниць (рішення замовника): серед ЗАПОВНЕНИХ одиниць
// {норма СС, залишки, еталон} є різні, АБО еталон заповнений, а його одиниця порожня.
// Порівняння — за СокрЛП(Наименование), НЕ за посиланням: у класифікаторі є дублі
// однієї одиниці (" шт" і "шт"), правити всі документи замовник не хоче.
Функция ЕстьРасхождениеЕдиниц(ЕдиницаСС, ЕдиницаОстатков, ЕдиницаЭталона, ЕстьЭталон)
	Если ЕстьЭталон И НЕ ЗначениеЗаполнено(ЕдиницаЭталона) Тогда
		Возврат Истина;
	КонецЕсли;
	Единицы = Новый Массив;
	Единицы.Добавить(ЕдиницаСС);
	Единицы.Добавить(ЕдиницаОстатков);
	Единицы.Добавить(ЕдиницаЭталона);
	Первая = Неопределено;
	Для Каждого Ед Из Единицы Цикл
		Если НЕ ЗначениеЗаполнено(Ед) Тогда
			Продолжить;
		КонецЕсли;
		ИмяЕдиницы = СокрЛП(Ед.Наименование);
		Если Первая = Неопределено Тогда
			Первая = ИмяЕдиницы;
		ИначеЕсли ИмяЕдиницы <> Первая Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// «Розбіжності одиниць (норми <-> фактичний прихід)» — програмний ТабДок.
// Лише еталони, де є хоч один рядок з РасхождениеЕдиниц; картки згорнуті за номенклатурою.
Функция СформироватьПечатьРозбіжностіОдиниць() Экспорт
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.АвтоМасштаб = Истина;

	Заголовок = ТабДок.Область(1, 1, 1, 5);
	Заголовок.Объединить();
	Заголовок.Текст = "Розбіжності одиниць (норми - фактичний прихід)";
	Заголовок.Шрифт = Новый Шрифт(, 14, Истина);
	Заголовок.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;

	НомерСтроки = 3;
	Параметры = Новый Массив;
	Параметры.Добавить("Документ: Розрахунок комплектацій № " + Номер + " від " + Формат(Дата, "ДФ=dd.MM.yyyy"));
	Параметры.Добавить("Організація: " + Строка(Организация));
	Параметры.Добавить("Специфікація: " + Строка(Спецификация));
	Параметры.Добавить("Залишки на дату: " + Формат(Период, "ДФ=dd.MM.yyyy"));
	Параметры.Добавить("Склади: " + СкладыСтрокой());
	Для Каждого ТекстПараметра Из Параметры Цикл
		Обл = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 5);
		Обл.Объединить();
		Обл.Текст = ТекстПараметра;
		Обл.Шрифт = Новый Шрифт(, 9);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;

	Заголовки = Новый Массив;
	Заголовки.Добавить("Загальна назва");
	Заголовки.Добавить("Залишок");
	Заголовки.Добавить("Одиниця виміру залишків");
	Заголовки.Добавить("Згідно з СС");
	Заголовки.Добавить("Одиниця виміру СС");
	ВывестиСтрокуПечати(ТабДок, НомерСтроки, Заголовки, Истина, Новый Цвет(210, 224, 240));
	НомерСтроки = НомерСтроки + 1;

	ЕдиницыЭталона = ЕдиницыЭталонов(ТабличнаяЧастьОстатков);
	Итоги = Новый Структура("Еталони, Номенклатури", 0, 0);

	ТекЭталон = Неопределено;
	ПервыйРяд = Истина;
	КарткиЕталона = Неопределено;
	ПорядокКарток = Неопределено;
	ЕстьРозбіжність = Ложь;
	Для Каждого Стр Из ТабличнаяЧастьОстатков Цикл
		Если ПервыйРяд ИЛИ Стр.ОбщееНазвание <> ТекЭталон Тогда
			Если НЕ ПервыйРяд Тогда
				НомерСтроки = ВывестиБлокЕталона(ТабДок, НомерСтроки, ТекЭталон, КарткиЕталона,
					ПорядокКарток, ЕстьРозбіжність, ЕдиницыЭталона, Итоги);
			КонецЕсли;
			ТекЭталон = Стр.ОбщееНазвание;
			КарткиЕталона = Новый Соответствие;
			ПорядокКарток = Новый Массив;
			ЕстьРозбіжність = Ложь;
			ПервыйРяд = Ложь;
		КонецЕсли;
		Агрегат = КарткиЕталона.Получить(Стр.Номенклатура);
		Если Агрегат = Неопределено Тогда
			Агрегат = Новый Структура("Залишок, Единица, ЕдиницаСС, Норма, Розбіжність",
				0, Стр.Единица, Стр.ЕдиницаСС, 0, Ложь);
			КарткиЕталона.Вставить(Стр.Номенклатура, Агрегат);
			ПорядокКарток.Добавить(Стр.Номенклатура);
		КонецЕсли;
		Агрегат.Залишок = Агрегат.Залишок + Стр.Остаток;
		Агрегат.Норма = Агрегат.Норма + Стр.НормаНоменкл; // штамп 1х на номенклатуру — не задвоюється
		Если Стр.РасхождениеЕдиниц Тогда
			Агрегат.Розбіжність = Истина;
			ЕстьРозбіжність = Истина;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ПервыйРяд Тогда
		НомерСтроки = ВывестиБлокЕталона(ТабДок, НомерСтроки, ТекЭталон, КарткиЕталона,
			ПорядокКарток, ЕстьРозбіжність, ЕдиницыЭталона, Итоги);
	КонецЕсли;

	НомерСтроки = НомерСтроки + 1;
	Итог = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 5);
	Итог.Объединить();
	Итог.Текст = "Еталонів з розбіжностями: " + Итоги.Еталони
		+ ", номенклатур з розбіжністю: " + Итоги.Номенклатури;
	Итог.Шрифт = Новый Шрифт(, 10, Истина);

	ТабДок.Область(2, 1, 2, 1).ШиринаКолонки = 50;
	ТабДок.Область(2, 2, 2, 2).ШиринаКолонки = 12;
	ТабДок.Область(2, 3, 2, 3).ШиринаКолонки = 24;
	ТабДок.Область(2, 4, 2, 4).ШиринаКолонки = 12;
	ТабДок.Область(2, 5, 2, 5).ШиринаКолонки = 24;

	Возврат ТабДок;
КонецФункции

// Рендер блока еталона у друку розбіжностей (якщо у еталона є розбіжність). Повертає новий номер рядка.
Функция ВывестиБлокЕталона(ТабДок, НомерСтроки, Эталон, Картки, Порядок, ЕстьРозбіжність, ЕдиницыЭталона, Итоги)
	Если НЕ ЕстьРозбіжність Тогда
		Возврат НомерСтроки;
	КонецЕсли;
	Итоги.Еталони = Итоги.Еталони + 1;
	ЕдЭталона = ЕдиницыЭталона.Получить(Эталон);
	ЕдЗаполнена = ЗначениеЗаполнено(ЕдЭталона);
	НазваЕталона = ?(ЗначениеЗаполнено(Эталон), Строка(Эталон), "<без еталона>")
		+ ?(ЕдЗаполнена, " [од. еталона: " + Строка(ЕдЭталона) + "]", " [!!! од. еталона не заповнена]");
	СумЗалишок = 0;
	СумНорма = 0;
	Для Каждого Ном Из Порядок Цикл
		Агр = Картки.Получить(Ном);
		СумЗалишок = СумЗалишок + Агр.Залишок;
		СумНорма = СумНорма + Агр.Норма;
	КонецЦикла;
	Значения = Новый Массив;
	Значения.Добавить(НазваЕталона);
	Значения.Добавить(СумЗалишок);
	Значения.Добавить("");
	Значения.Добавить(СумНорма);
	Значения.Добавить("");
	ВывестиСтрокуПечати(ТабДок, НомерСтроки, Значения, Истина, Новый Цвет(232, 232, 232));
	Если НЕ ЕдЗаполнена Тогда
		ТабДок.Область(НомерСтроки, 1, НомерСтроки, 1).ЦветТекста = Новый Цвет(132, 60, 12);
	КонецЕсли;
	НомерСтроки = НомерСтроки + 1;
	Для Каждого Ном Из Порядок Цикл
		Агр = Картки.Получить(Ном);
		Если Агр.Розбіжність Тогда
			Итоги.Номенклатури = Итоги.Номенклатури + 1;
		КонецЕсли;
		Значения = Новый Массив;
		Значения.Добавить("    " + Строка(Ном));
		Значения.Добавить(Агр.Залишок);
		Значения.Добавить(Строка(Агр.Единица));
		Значения.Добавить(?(Агр.Норма = 0, "", Агр.Норма));
		Значения.Добавить(?(ЗначениеЗаполнено(Агр.ЕдиницаСС), Строка(Агр.ЕдиницаСС), ""));
		ВывестиСтрокуПечати(ТабДок, НомерСтроки, Значения, Ложь);
		Если Агр.Розбіжність Тогда
			ТабДок.Область(НомерСтроки, 3, НомерСтроки, 3).ЦветФона = Новый Цвет(255, 230, 153);
			ТабДок.Область(НомерСтроки, 5, НомерСтроки, 5).ЦветФона = Новый Цвет(255, 230, 153);
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	Возврат НомерСтроки;
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Статус = Перечисления.СтатусыРасчетаКомплектаций.Черновик;
	Период = НачалоДня(ТекущаяДата());
	Ответственный = Пользователи.ТекущийПользователь();
	Если СчетаОстатков.Количество() = 0 Тогда
		Для Каждого Код Из СтрРазделить("20,28", ",") Цикл
			Сч = ПланыСчетов.Хозрасчетный.НайтиПоКоду(Код);
			Если ЗначениеЗаполнено(Сч) Тогда
				СчетаОстатков.Добавить().Счет = Сч;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если СчетаМалоценки.Количество() = 0 Тогда
		Сч22 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("22");
		Если ЗначениеЗаполнено(Сч22) Тогда
			СчетаМалоценки.Добавить().Счет = Сч22;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусыРасчетаКомплектаций.Черновик;
	КонецЕсли;
	// Контроль дублей: предупреждение, НЕ отказ.
	Дубли = НайтиДубликатыРасчета();
	Если Дубли.Количество() > 0 Тогда
		Сообщить("Увага: вже існує розрахунок за цією специфікацією/датою/складами: "
			+ Строка(Дубли[0]) + ?(Дубли.Количество() > 1, " (та ще " + (Дубли.Количество() - 1) + ")", ""));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
