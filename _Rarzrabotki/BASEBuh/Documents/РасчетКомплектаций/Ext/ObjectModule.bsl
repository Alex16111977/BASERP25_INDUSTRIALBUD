// Документ «Розрахунок комплектацій за СС» (bas_industrialbud). Порт движка обработки РасчетКомплектаций.
// Остатки счетов класса 2 -> нормы Спецификации (кап по эталону) -> анализ + сохраняемые таблицы списания
// (за нормами / понад норму, редактируемая) -> документы КомплектацияНоменклатуры / ПередачаМалоценныхАктивовВЭксплуатацию.

#Область ПрограммныйИнтерфейс

// Заполняет ТабличнаяЧастьОстатков анализом: остаток / норма / в норме / понад норму / экономия.
Процедура РассчитатьАнализ() Экспорт

	СкладыМассив = СкладыСписком();
	Если СкладыМассив.Количество() = 0 Тогда
		ВызватьИсключение "Не вибрані склади залишків.";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Спецификация) Тогда
		ВызватьИсключение "Не вибрана специфікація (норми).";
	КонецЕсли;

	// Мультиорг: пустой список организаций автозаполняется (шапка + А_Организация складов),
	// явно заполненный пользователем — не трогаем.
	ДополнитьОрганизацииОстатков();

	ТЗОстатки = ПолучитьОстатки(СкладыМассив);
	Нормы = ПолучитьНормы();
	ДополнитьНоменклатуройБезОстатков(ТЗОстатки, Нормы);
	ЗаполнитьАнализ(ТЗОстатки, Нормы);
	ДополнитьСкладыДокументов();
	ПопередитиПроРозбіжністьОдиниць();
	ЗаполнитьТаблицыСписания();
	Статус = Перечисления.СтатусыРасчетаКомплектаций.РасчетВыполнен;

КонецПроцедуры

// Заполняет ТЧ Комплектующие выбранных документов. Режим: ЗаполнятьВНорме / ЗаполнятьПонад
// (по умолчанию обе категории — обратная совместимость). Возвращает структуру-результат.
// Запись всего пакета — в одной транзакции (всё-или-ничего).
Функция ЗаполнитьДокументыПоАнализу(ЗаполнятьВНорме = Истина, ЗаполнятьПонад = Истина) Экспорт

	Результат = НовыйРезультатЗаполнения();

	Если СписаниеПоНормам.Количество() = 0 И СписаниеСверхНормы.Количество() = 0 Тогда
		Результат.Помилки.Добавить("Спочатку натисніть «Розрахувати».");
		Возврат Результат;
	КонецЕсли;

	СтрокиПоДокументам = ПодготовитьСтрокиПоДокументам(Результат, ЗаполнятьВНорме, ЗаполнятьПонад);

	ИмяСобытия = "РасчетКомплектаций.Заповнення документів";
	НачатьТранзакцию();
	Попытка
		СформироватьДокументыПоСоответствию(СтрокиПоДокументам, Результат);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат = НовыйРезультатЗаполнения();
		Результат.Помилки.Добавить("Помилка запису, зміни скасовано: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Результат.Помилки.Количество() = 0 И Результат.Заповнено > 0 Тогда
		Статус = Перечисления.СтатусыРасчетаКомплектаций.ДокументыСозданы;
	КонецЕсли;

	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Управління проведенням цільових документів (підменю «Документи»)
//
// Навіщо: ЗаполнитьДокументыПоАнализу пише в цільові документи через
// Записать(РежимЗаписиДокумента.Запись). Якщо документ ПРОВЕДЕНИЙ, платформа
// перезапише табличну частину, залишить прапорець «Проведений», але рухи НЕ
// перерахує — у документі нові рядки, у проводках старі суми. Тому перед
// перезаповненням документи треба розпровести, а після — провести.
//
// Спека: docs/superpowers/specs/2026-08-04-podmenyu-dokumenty-design.md

// Усі непорожні посилання на цільові документи з обох ТЧ, без дублів.
Функция ЦелевыеДокументы() Экспорт
	Результат = Новый Массив;
	Известные = Новый Соответствие;
	Таблицы = Новый Массив;
	Таблицы.Добавить(ДокументиКомплектації);
	Таблицы.Добавить(ДокументиМалоценки);
	Для Каждого Таблица Из Таблицы Цикл
		Для Каждого Стр Из Таблица Цикл
			Кандидаты = Новый Массив;
			Кандидаты.Добавить(Стр.ДокументПоНормам);
			Кандидаты.Добавить(Стр.ДокументДодаткова);
			Для Каждого Док Из Кандидаты Цикл
				Если ЗначениеЗаполнено(Док) И Известные.Получить(Док) = Неопределено Тогда
					Известные.Вставить(Док, Истина);
					Результат.Добавить(Док);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Розпроводить усі цільові документи розрахунку.
// Повертає Структуру("Оброблено, Пропущено, Помилки") — Помилки це Массив рядків.
// БЕЗ спільної транзакції: помилка на одному документі не скасовує решту
// (рішення замовника — «проводити всі, зібрати помилки»).
Функция РаспровестиДокументы() Экспорт

	Результат = Новый Структура("Оброблено, Пропущено, Помилки", 0, 0, Новый Массив);
	ИмяСобытия = "РасчетКомплектаций.Розпроведення документів";

	Для Каждого ДокСсылка Из ЦелевыеДокументы() Цикл
		Если НЕ ДокСсылка.Проведен Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Попытка
			ДокОбъект = ДокСсылка.ПолучитьОбъект();
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Результат.Оброблено = Результат.Оброблено + 1;
		Исключение
			Результат.Помилки.Добавить(Строка(ДокСсылка) + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ДокСсылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	ОбновитьСостояниеДокументов();
	Возврат Результат;

КонецФункции

// Проводить усі цільові документи розрахунку. Уже проведені перепроводяться —
// саме це актуалізує рухи після перезаповнення. Документ з ПОРОЖНЬОЮ профільною ТЧ
// пропускається і лишається розпроведеним (контракт очищення 2026-08-25: розрахунок
// не дав рядків -> документу нічого списувати).
// Повертає Структуру("Оброблено, Пропущено, Помилки").
Функция ПровестиДокументы() Экспорт

	Результат = Новый Структура("Оброблено, Пропущено, Помилки", 0, 0, Новый Массив);
	ИмяСобытия = "РасчетКомплектаций.Проведення документів";

	Для Каждого ДокСсылка Из ЦелевыеДокументы() Цикл
		Попытка
			ДокОбъект = ДокСсылка.ПолучитьОбъект();
			Если ПрофильнаяТабЧастьПуста(ДокОбъект) Тогда
				Результат.Пропущено = Результат.Пропущено + 1;
				Продолжить;
			КонецЕсли;
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Результат.Оброблено = Результат.Оброблено + 1;
		Исключение
			Результат.Помилки.Добавить(Строка(ДокСсылка) + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ДокСсылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	ОбновитьСостояниеДокументов();
	Возврат Результат;

КонецФункции

// Порожня профільна ТЧ документа списання: МалоценныеАктивы у малоцінки, Комплектующие у комплектації.
Функция ПрофильнаяТабЧастьПуста(ДокОбъект)
	Если ТипЗнч(ДокОбъект.Ссылка) = Тип("ДокументСсылка.ПередачаМалоценныхАктивовВЭксплуатацию") Тогда
		Возврат ДокОбъект.МалоценныеАктивы.Количество() = 0;
	КонецЕсли;
	Возврат ДокОбъект.Комплектующие.Количество() = 0;
КонецФункции

// Повний цикл «Перерахувати і провести» одним викликом (рішення заказчика 2026-08-25):
// розпровести цільові -> перерахувати аналіз -> заповнити документи (з очищенням порожніх,
// авто-ПоНорме і автостворенням призначень) -> провести непорожні. Уся логіка в ОБ'ЄКТІ —
// викликається і командою списку (по виділених рядках), і будь-яким іншим кодом; дзеркалить
// перевірений цикл форми «Оновити документи» (ВыполнитьЦиклОбновленияНаСервере).
//
// Сценарій бухгалтера: виявили помилки в переміщеннях між складами чи в «загальній назві»
// картки номенклатури -> одна кнопка перебудовує і перепроводить усі списання розрахунку.
//
// Проводить = Ложь — службовий режим приймальних тестів (усе, крім кроку проведення).
// Повертає Структуру("Розпроведено, Заповнено, Очищено, СтвореноПризначень, Проведено,
// ПропущеноПорожніх, Попередження, Помилки"); Попередження/Помилки — масиви рядків.
// Помилка розпроведення чи заповнення зупиняє ЦЕЙ розрахунок (документи лишаються
// розпроведеними — це видно в ТЧ «Документи»); помилка проведення одного документа
// НЕ зупиняє решту (рішення заказчика: продовжувати + звіт).
Функция ПересчитатьИПровести(Проводить = Истина) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Розпроведено", 0);
	Результат.Вставить("Заповнено", 0);
	Результат.Вставить("Очищено", 0);
	Результат.Вставить("СтвореноПризначень", 0);
	Результат.Вставить("Проведено", 0);
	Результат.Вставить("ПропущеноПорожніх", 0);
	Результат.Вставить("Попередження", Новый Массив);
	Результат.Вставить("Помилки", Новый Массив);

	Если ЦелевыеДокументы().Количество() = 0 Тогда
		Результат.Помилки.Добавить("У розрахунку не вибрано жодного документа комплектації/малоцінки.");
		Возврат Результат;
	КонецЕсли;

	// Крок 1: розпроведення — повертає матеріали на склади, розрахунок бачить повні залишки.
	РезРаспр = РаспровестиДокументы();
	Результат.Розпроведено = РезРаспр.Оброблено;
	Для Каждого ТекстПомилки Из РезРаспр.Помилки Цикл
		Результат.Помилки.Добавить("Розпроведення: " + ТекстПомилки);
	КонецЦикла;
	Если РезРаспр.Помилки.Количество() > 0 Тогда
		Результат.Помилки.Добавить("Перерахунок СКАСОВАНО: не всі документи вдалося розпровести.");
		ЗаписатьРасчетБезИсключений(Результат);
		Возврат Результат;
	КонецЕсли;

	// Крок 2: перерахунок аналізу — таблиці списання будуються заново за поточними
	// залишками, нормами СС і «загальними назвами» карток.
	// Цикл будинку: D/M/реалізацію визначаємо ДО розрахунку — від них залежать дати залишків і цільових документів.
	Попытка
		РезПар = НовийРезультатЦиклу();
		ПараметриЦиклу(РезПар);
		Для Каждого Т Из РезПар.Сообщения Цикл
			Результат.Попередження.Добавить("Цикл: " + Т);
		КонецЦикла;
	Исключение
		Результат.Попередження.Добавить("Цикл: параметри не визначено — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	РассчитатьАнализ();
	Если НЕ КоличествоКСписаниюАвтоматическиЗаполнять Тогда
		Результат.Попередження.Добавить("Прапорець автозаповнення «Кількість до списання» ВИМКНЕНО:"
			+ " понаднорма до списання = 0, документи «Додаткова» будуть порожні і розпроведені.");
	КонецЕсли;

	// Крок 3: заповнення — очищення порожніх, ознака ПоНорме і автостворення
	// «Призначень використання» відпрацьовують усередині.
	РезЗап = ЗаполнитьДокументыПоАнализу(Истина, Истина);
	Результат.Заповнено = РезЗап.Заповнено;
	Результат.Очищено = РезЗап.Очищено;
	Результат.СтвореноПризначень = РезЗап.СтвореноПризначень;
	Для Каждого ТекстПомилки Из РезЗап.Помилки Цикл
		Результат.Помилки.Добавить("Заповнення: " + ТекстПомилки);
	КонецЦикла;
	Если РезЗап.БезНазначення > 0 Тогда
		Результат.Помилки.Добавить("Рядків малоцінки без «Призначення використання»: " + РезЗап.БезНазначення
			+ ". Заповніть «Спосіб відображення витрат» у ТЧ «Документи» і повторіть.");
	КонецЕсли;
	Если Результат.Помилки.Количество() > 0 Тогда
		Результат.Помилки.Добавить("Проведення СКАСОВАНО — документи лишились розпроведеними.");
		ЗаписатьРасчетБезИсключений(Результат);
		Возврат Результат;
	КонецЕсли;

	// Крок 4: проведення непорожніх (порожні очищені лишаються розпроведеними).
	Если Проводить Тогда
		РезПров = ПровестиДокументы();
		Результат.Проведено = РезПров.Оброблено;
		Результат.ПропущеноПорожніх = РезПров.Пропущено;
		Для Каждого ТекстПомилки Из РезПров.Помилки Цикл
			Результат.Помилки.Добавить("Проведення: " + ТекстПомилки);
		КонецЦикла;
	КонецЕсли;

	// Крок 5: цикл будинку — карта, автоперенесення (за прапорцем, лише виробничий склад),
	// створення відсутніх (за воротами), проведення за хронологією, залишки «в нуль».
	ЦиклЗакрито = Ложь;
	Если Проводить Тогда
		Попытка
			РезЦиклу = ПроаналізуватиЦиклБудинку();
			Если АвтоматическиСмещатьДатыПремещенийДляСкладаПроизводственного Тогда
				Для Каждого РядокКарти Из ХронологияПеремещений Цикл
					Если РядокКарти.ВидОперации = Перечисления.А_ШагиЦиклаДомика.ПеремещениеМатериаловНаПроизводство
						И РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.НарушениеХронологии
						И ЗначениеЗаполнено(РядокКарти.Склад)
						И РядокКарти.Склад.А_ВидСклада = Перечисления.А_ВидСклада.Производственный Тогда
						РядокКарти.Виправити = Истина;
					КонецЕсли;
				КонецЦикла;
				РезПерен = ПеренестиДатиВідміченихДокументів();
				ЗлитиРезультатиЦиклу(РезЦиклу, РезПерен);
			КонецЕсли;
			РезСтв = СтворитиВідсутніДокументиЦиклу();
			ЗлитиРезультатиЦиклу(РезЦиклу, РезСтв);
			РезПров = ПровестиДокументиЦиклуЗаХронологією();
			ЗлитиРезультатиЦиклу(РезЦиклу, РезПров);
			РезЗал = ЗалишкиПісляЦиклу();
			РезЦиклу.Сообщения.Добавить(РезЗал.Текст);
			ЦиклЗакрито = РезЗал.Пусто И РезЦиклу.Відсутніх = 0 И РезЦиклу.Помилки.Количество() = 0;
			Для Каждого Т Из РезЦиклу.Сообщения Цикл
				Результат.Попередження.Добавить("Цикл: " + Т);
			КонецЦикла;
			Для Каждого Т Из РезЦиклу.Помилки Цикл
				Результат.Попередження.Добавить("Цикл (помилка): " + Т);
			КонецЦикла;
			Результат.Попередження.Добавить("Цикл будинку: " + РезЦиклу.Підсумок);
		Исключение
			Результат.Попередження.Добавить("Цикл будинку не розраховано: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	// Знімки стану «Проведений» у ТЧ «Документи» + статус — зберігаємо розрахунок.
	ЗаписатьРасчетБезИсключений(Результат);
	Если ЦиклЗакрито И Результат.Помилки.Количество() = 0 Тогда
		Статус = Перечисления.СтатусыРасчетаКомплектаций.ЦиклЗакрыт;
		ЗаписатьРасчетБезИсключений(Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Запис розрахунку без прокидання виключення: цикл перерахунку має повернути
// накопичений звіт навіть якщо сам розрахунок зберегти не вдалося.
Процедура ЗаписатьРасчетБезИсключений(Результат)
	Попытка
		Записать();
	Исключение
		Результат.Помилки.Добавить("Не вдалося зберегти розрахунок: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации("РасчетКомплектаций.Перерахунок і проведення",
			УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

// Додає пару {Номенклатура, Способ} у перелік проблемних без дублів.
Процедура ДодатиПаруБезПризначення(Результат, Номенклатура, Способ)
	Для Каждого Пара Из Результат.НоменклатуриБезПризначення Цикл
		Если Пара.Номенклатура = Номенклатура И Пара.Способ = Способ Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Результат.НоменклатуриБезПризначення.Добавить(
		Новый Структура("Номенклатура, Способ", Номенклатура, Способ));
КонецПроцедуры

// Заводить відсутні «Призначення використання» за зразком уже наявних карток
// (усі 7 робочих карток документа ІБ00-000385 заповнені однаково — перевірено
// 2026-08-04, розбіжностей нуль, тому значення константні, а не вигадані):
//
//   Вид малоцінного активу      Малоцінний швидкозношуваний предмет
//   Кількість за нормативом     1
//   Коефіцієнт                  1
//   Строк корисного використання 12
//   Рахунок передачі БО         00
//   Рахунок амортизації БО      00
//   Рахунок БО для друку        231
//
// Змінюються лише Найменування (з номенклатури) і Одиниця (базова одиниця
// номенклатури; якщо порожня — беремо з наявної картки цієї ж номенклатури).
//
// ПариБезПризначення — Массив структур {Номенклатура, Способ} з результату заповнення.
// Ідемпотентна: пара «Владелец + Спосіб», що вже існує, пропускається.
// Повертає Структуру("Створено, Пропущено, Помилки").
Функция СоздатьОтсутствующиеНазначения(ПариБезПризначення) Экспорт

	Результат = Новый Структура("Створено, Пропущено, Помилки", 0, 0, Новый Массив);
	Если ПариБезПризначення.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ИмяСобытия = "РасчетКомплектаций.Створення призначень використання";

	Для Каждого Пара Из ПариБезПризначення Цикл

		Если НЕ ЗначениеЗаполнено(Пара.Номенклатура) ИЛИ НЕ ЗначениеЗаполнено(Пара.Способ) Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(НайтиПризначенняЗаСпособом(Пара.Номенклатура, Пара.Способ)) Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Попытка
			СоздатьКарточкуПризначення(Пара.Номенклатура, Пара.Способ);
			Результат.Створено = Результат.Створено + 1;
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
				"Створено призначення: " + Строка(Пара.Номенклатура)
				+ " / " + Строка(Пара.Способ));
		Исключение
			Результат.Помилки.Добавить(Строка(Пара.Номенклатура) + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ядро створення ОДНІЄЇ картки «Призначення використання» для МШП. Константи — див.
// коментар перед СоздатьОтсутствующиеНазначения (зняті зі зразкових карток і статистики
// бази: 176/183 карток способу «Виробничий (IRS)» — саме МШП зі строком 12).
// Викликається пакетним СоздатьОтсутствующиеНазначения і автостворенням під час
// заповнення (НайтиИлиСоздатьНазначение). Помилки запису — назовні.
Функция СоздатьКарточкуПризначення(Номенклатура, Способ)
	НовеПризначення = Справочники.НазначенияИспользования.СоздатьЭлемент();
	НовеПризначення.Владелец = Номенклатура;
	// Найменування довідника обмежене 50 символами — довші імена обрізаємо,
	// інакше запис впаде.
	НовеПризначення.Наименование = Лев(СокрЛП(Номенклатура.Наименование), 50);
	НовеПризначення.ВидМалоценногоАктива = Перечисления.ВидыМалоценныхАктивов.МалоценныйБыстроизнашивающийсяПредмет;
	НовеПризначення.Количество = 1;
	НовеПризначення.Коэффициент = 1;
	НовеПризначення.СрокПолезногоИспользования = 12;
	НовеПризначення.СпособОтраженияРасходов = Способ;
	Счет00 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("00");
	НовеПризначення.СчетПередачиБУ = Счет00;
	НовеПризначення.СчетАмортизацииБУ = Счет00;
	НовеПризначення.СчетБУДляПечати = "231";
	НовеПризначення.ЕдиницаИзмерения = ЕдиницаДляПризначення(Номенклатура);
	НовеПризначення.Записать();
	Возврат НовеПризначення.Ссылка;
КонецФункции

// Чинне (непомічене) призначення номенклатури під конкретний спосіб.
Функция НайтиПризначенняЗаСпособом(Номенклатура, Способ)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Н.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.НазначенияИспользования КАК Н
	|ГДЕ
	|	Н.Владелец = &Номенклатура
	|	И Н.СпособОтраженияРасходов = &Способ
	|	И НЕ Н.ПометкаУдаления";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Способ", Способ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.НазначенияИспользования.ПустаяСсылка();
КонецФункции

// Одиниця для нової картки: базова одиниця номенклатури, інакше — одиниця
// будь-якої наявної картки цієї ж номенклатури.
Функция ЕдиницаДляПризначення(Номенклатура)
	Единица = Номенклатура.БазоваяЕдиницаИзмерения;
	Если ЗначениеЗаполнено(Единица) Тогда
		Возврат Единица;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Н.ЕдиницаИзмерения КАК Единица
	|ИЗ
	|	Справочник.НазначенияИспользования КАК Н
	|ГДЕ
	|	Н.Владелец = &Номенклатура
	|	И Н.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|	И НЕ Н.ПометкаУдаления";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Единица;
	КонецЕсли;
	Возврат Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
КонецФункции

// Оновлює колонки-знімки «Проведено» в обох ТЧ документів ОДНИМ запитом.
// Викликається після кожної операції підменю та при відкритті форми.
Процедура ОбновитьСостояниеДокументов() Экспорт

	Доки = ЦелевыеДокументы();
	Состояния = Новый Соответствие;

	Если Доки.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Д.Ссылка КАК Док,
		|	Д.Проведен КАК Проведен
		|ИЗ
		|	Документ.КомплектацияНоменклатуры КАК Д
		|ГДЕ
		|	Д.Ссылка В (&Доки)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	М.Ссылка,
		|	М.Проведен
		|ИЗ
		|	Документ.ПередачаМалоценныхАктивовВЭксплуатацию КАК М
		|ГДЕ
		|	М.Ссылка В (&Доки)";
		Запрос.УстановитьПараметр("Доки", Доки);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Состояния.Вставить(Выборка.Док, Выборка.Проведен);
		КонецЦикла;
	КонецЕсли;

	Таблицы = Новый Массив;
	Таблицы.Добавить(ДокументиКомплектації);
	Таблицы.Добавить(ДокументиМалоценки);
	Для Каждого Таблица Из Таблицы Цикл
		Для Каждого Стр Из Таблица Цикл
			Стр.ПроведенПоНормам = ?(Состояния.Получить(Стр.ДокументПоНормам) = Истина, Истина, Ложь);
			Стр.ПроведенДодаткова = ?(Состояния.Получить(Стр.ДокументДодаткова) = Истина, Истина, Ложь);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

