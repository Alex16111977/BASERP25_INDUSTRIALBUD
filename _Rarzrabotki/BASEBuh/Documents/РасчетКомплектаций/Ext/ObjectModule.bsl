		Обл = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 9);
		Обл.Объединить();
		Обл.Текст = ТекстПараметра;
		Обл.Шрифт = Новый Шрифт(, 9);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;

