// Документ «Розрахунок комплектацій за СС» (bas_industrialbud). Порт движка обработки РасчетКомплектаций.
// Остатки счетов класса 2 -> нормы Спецификации (кап по эталону) -> анализ + сохраняемые таблицы списания
// (за нормами / понад норму, редактируемая) -> документы КомплектацияНоменклатуры / ПередачаМалоценныхАктивовВЭксплуатацию.

#Область ПрограммныйИнтерфейс

// Заполняет ТабличнаяЧастьОстатков анализом: остаток / норма / в норме / понад норму / экономия.
Процедура РассчитатьАнализ() Экспорт

	СкладыМассив = СкладыСписком();
	Если СкладыМассив.Количество() = 0 Тогда
		ВызватьИсключение "Не вибрані склади залишків.";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Спецификация) Тогда
		ВызватьИсключение "Не вибрана специфікація (норми).";
	КонецЕсли;

	ТЗОстатки = ПолучитьОстатки(СкладыМассив);
	Нормы = ПолучитьНормы();
	ДополнитьНоменклатуройБезОстатков(ТЗОстатки, Нормы);
	ЗаполнитьАнализ(ТЗОстатки, Нормы);
	ДополнитьСкладыДокументов();
	ПопередитиПроРозбіжністьОдиниць();
	ЗаполнитьТаблицыСписания();
	Статус = Перечисления.СтатусыРасчетаКомплектаций.РасчетВыполнен;

КонецПроцедуры

// Заполняет ТЧ Комплектующие выбранных документов. Режим: ЗаполнятьВНорме / ЗаполнятьПонад
// (по умолчанию обе категории — обратная совместимость). Возвращает структуру-результат.
// Запись всего пакета — в одной транзакции (всё-или-ничего).
Функция ЗаполнитьДокументыПоАнализу(ЗаполнятьВНорме = Истина, ЗаполнятьПонад = Истина) Экспорт

	Результат = НовыйРезультатЗаполнения();

	Если СписаниеПоНормам.Количество() = 0 И СписаниеСверхНормы.Количество() = 0 Тогда
		Результат.Помилки.Добавить("Спочатку натисніть «Розрахувати».");
		Возврат Результат;
	КонецЕсли;

	СтрокиПоДокументам = ПодготовитьСтрокиПоДокументам(Результат, ЗаполнятьВНорме, ЗаполнятьПонад);

	ИмяСобытия = "РасчетКомплектаций.Заповнення документів";
	НачатьТранзакцию();
	Попытка
		СформироватьДокументыПоСоответствию(СтрокиПоДокументам, Результат);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат = НовыйРезультатЗаполнения();
		Результат.Помилки.Добавить("Помилка запису, зміни скасовано: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Результат.Помилки.Количество() = 0 И Результат.Заповнено > 0 Тогда
		Статус = Перечисления.СтатусыРасчетаКомплектаций.ДокументыСозданы;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Строит печатную форму (ТабличныйДокумент) анализа из переданных строк (ТаблицаАнализа формы).
Функция СформироватьПечать(ДанныеАнализа) Экспорт

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;

	НаДату = ?(ЗначениеЗаполнено(Период), Период, ТекущаяДата());
	ОблЗаг = ТабДок.Область(1, 1, 1, 14);
	ОблЗаг.Объединить();
	ОблЗаг.Текст = "Аналіз залишків (для списання)";
	ОблЗаг.Шрифт = Новый Шрифт(, 14, Истина);
	ОблЗаг.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОблПериод = ТабДок.Область(2, 1, 2, 14);
	ОблПериод.Объединить();
	ОблПериод.Текст = "Період: " + Формат(НаДату, "ДЛФ=D");
	ОблПериод.Шрифт = Новый Шрифт(, 9);
	ОблСклады = ТабДок.Область(3, 1, 3, 14);
	ОблСклады.Объединить();
	ОблСклады.Текст = "Склади: " + СкладыСтрокой();
	ОблСклады.Шрифт = Новый Шрифт(, 9);
	ОблСпец = ТабДок.Область(4, 1, 4, 14);
	ОблСпец.Объединить();
	ОблСпец.Текст = "Специфікація (норми): " + Строка(Спецификация);
	ОблСпец.Шрифт = Новый Шрифт(, 9);

	Заголовки = СтрРазделить("Загальна назва,Номенклатура,Склад,Рахунок,Залишок,Одиниця виміру залишків,Сума залишку,Згідно з СС,Одиниця виміру СС,В нормі,Понад норму,Сума понад,Економія,Економія (грн)", ",");
	НомСтр = 6;
	ВывестиСтрокуПечати(ТабДок, НомСтр, Заголовки, Истина, Новый Цвет(210, 224, 240), Истина);

	ИтЗалишок = 0; ИтСумЗалишку = 0; ИтНорма = 0; ИтВНорме = 0; ИтПонад = 0; ИтСумПонад = 0; ИтЭкономия = 0; ИтЕкономіяСума = 0;
	Для Каждого Стр Из ДанныеАнализа Цикл
		НомСтр = НомСтр + 1;
		Значения = Новый Массив;
		Значения.Добавить(Строка(Стр.ОбщееНазвание));
		Значения.Добавить(Строка(Стр.Номенклатура));
		Значения.Добавить(Строка(Стр.Склад));
		Значения.Добавить(Строка(Стр.Счет));
		Значения.Добавить(Формат(Стр.Остаток, "ЧЦ=15; ЧДЦ=3"));
		Значения.Добавить(Строка(Стр.Единица));
		Значения.Добавить(Формат(Стр.СуммаОстатка, "ЧЦ=15; ЧДЦ=2"));
		Значения.Добавить(?(Стр.НормаНоменкл = 0, "", Формат(Стр.НормаНоменкл, "ЧЦ=15; ЧДЦ=3")));
		Значения.Добавить(?(НЕ ЗначениеЗаполнено(Стр.ЕдиницаСС), "", Строка(Стр.ЕдиницаСС)));
		Значения.Добавить(?(Стр.ВНорме = 0, "", Формат(Стр.ВНорме, "ЧЦ=15; ЧДЦ=3")));
		Значения.Добавить(?(Стр.ПонадНорму = 0, "", Формат(Стр.ПонадНорму, "ЧЦ=15; ЧДЦ=3")));
		Значения.Добавить(?(Стр.ПонадНормуСумма = 0, "", Формат(Стр.ПонадНормуСумма, "ЧЦ=15; ЧДЦ=2")));
		Значения.Добавить(?(Стр.Экономия = 0, "", Формат(Стр.Экономия, "ЧЦ=15; ЧДЦ=3")));
		Значения.Добавить(?(Стр.ЕкономіяСума = 0, "", Формат(Стр.ЕкономіяСума, "ЧЦ=15; ЧДЦ=2")));
		ВывестиСтрокуПечати(ТабДок, НомСтр, Значения, Ложь);
		ИтЗалишок = ИтЗалишок + Стр.Остаток;
		ИтСумЗалишку = ИтСумЗалишку + Стр.СуммаОстатка;
		ИтНорма = ИтНорма + Стр.НормаНоменкл;
		ИтВНорме = ИтВНорме + Стр.ВНорме;
		ИтПонад = ИтПонад + Стр.ПонадНорму;
		ИтСумПонад = ИтСумПонад + Стр.ПонадНормуСумма;
		ИтЭкономия = ИтЭкономия + Стр.Экономия;
		ИтЕкономіяСума = ИтЕкономіяСума + Стр.ЕкономіяСума;
	КонецЦикла;

	НомСтр = НомСтр + 1;
	Итоги = Новый Массив;
	Итоги.Добавить("Разом");
	Итоги.Добавить(""); Итоги.Добавить(""); Итоги.Добавить("");
	Итоги.Добавить(Формат(ИтЗалишок, "ЧЦ=15; ЧДЦ=3"));
	Итоги.Добавить("");
	Итоги.Добавить(Формат(ИтСумЗалишку, "ЧЦ=15; ЧДЦ=2"));
	Итоги.Добавить(Формат(ИтНорма, "ЧЦ=15; ЧДЦ=3"));
	Итоги.Добавить("");
	Итоги.Добавить(Формат(ИтВНорме, "ЧЦ=15; ЧДЦ=3"));
	Итоги.Добавить(Формат(ИтПонад, "ЧЦ=15; ЧДЦ=3"));
	Итоги.Добавить(Формат(ИтСумПонад, "ЧЦ=15; ЧДЦ=2"));
	Итоги.Добавить(Формат(ИтЭкономия, "ЧЦ=15; ЧДЦ=3"));
	Итоги.Добавить(Формат(ИтЕкономіяСума, "ЧЦ=15; ЧДЦ=2"));
	ВывестиСтрокуПечати(ТабДок, НомСтр, Итоги, Истина, Новый Цвет(232, 232, 232));

	Ширины = СтрРазделить("22,30,22,8,13,8,13,11,8,11,13,13,11,13", ",");
	Для К = 0 По Ширины.ВГраница() Цикл
		ТабДок.Область(6, К + 1, 6, К + 1).ШиринаКолонки = Число(Ширины[К]);
	КонецЦикла;
	ТабДок.АвтоМасштаб = Истина;

	Возврат ТабДок;

КонецФункции

// Будує звіт «План-факт по матеріалах»: групування ОбщееНазвание (еталон) -> Номенклатура.
// План = норма (кол+сума, лише на 1-му рядку еталону), Факт = залишок (кол+сума),
// проценти виконання (Факт/План) і перевищення (Понад/План). Джерело — ДанныеАнализа (упорядк. по еталону).
Функция СформироватьПечатьПланФакт(ДанныеАнализа) Экспорт

	ТЗ = ДанныеВТаблицуПланФакт(ДанныеАнализа);
	Схема = ПолучитьМакет("МакетПланФакт");

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Настройки = Схема.НастройкиПоУмолчанию;
	УстановитьЗаголовокЗвіту(Настройки, "План-факт по матеріалах");
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанных"));

	ВнешниеНаборы = Новый Структура("Данные", ТЗ);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет, ВнешниеНаборы, , Истина);

	ТабДок = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабДок);
	ПроцессорВывода.Вывести(Процессор);

	Возврат ТабДок;

КонецФункции

