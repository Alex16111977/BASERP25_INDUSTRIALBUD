// Друкована форма «для цеху» (кількісна): видається комірнику; по жовтих (понаднормових)
// рядках він пише пояснення від руки в колонку «Коментар цеху». Сум немає — тільки кількість.
// «Норма СС» і «Економія» — лише на рядку групи (загальна назва), на картках порожньо.
Функция СформироватьПечатьАнализЦех(ДанныеАнализа) Экспорт

	ТЗ = ДанныеВТаблицуПланФакт(ДанныеАнализа);
	Схема = ПолучитьМакет("МакетАнализЦех");

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Настройки = Схема.НастройкиПоУмолчанию;
	УстановитьЗаголовокЗвіту(Настройки, "Аналіз залишків для списання за СС");
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанных"));

	ВнешниеНаборы = Новый Структура("Данные", ТЗ);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет, ВнешниеНаборы, , Истина);

	ТабДок = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабДок);
	ПроцессорВывода.Вывести(Процессор);

	// Постобробка після СКД:
	// 1) широка колонка «Коментар цеху» під рукопис (ШиринаКолонки — на НЕоб'єднаній клітинці даних);
	// 2) рамки-сітка на всю таблицю — СКД друкує без них, на папері рядки зливаються;
	// 3) шапка колонок (два рядки: поля + «Номенклатура») виділяється жирнішою рамкою.
	// Жовта заливка понаднормових рядків задана умовним оформленням СКД і лишається як була.
	СтрокаШапки = 0;
	КолонкаПервая = 0;
	КолонкаПоследняя = 0;
	Для НомерСтроки = 1 По Мин(ТабДок.ВысотаТаблицы, 30) Цикл
		Для НомерКолонки = 1 По ТабДок.ШиринаТаблицы Цикл
			ТекстЯчейки = СокрЛП(ТабДок.Область(НомерСтроки, НомерКолонки).Текст);
			Если ТекстЯчейки = "Загальна назва" Тогда
				СтрокаШапки = НомерСтроки;
				КолонкаПервая = НомерКолонки;
			ИначеЕсли ТекстЯчейки = "Коментар цеху" Тогда
				КолонкаПоследняя = НомерКолонки;
				ТабДок.Область(НомерСтроки + 1, НомерКолонки).ШиринаКолонки = 35;
			ИначеЕсли ТекстЯчейки = "Код" Тогда
				ТабДок.Область(НомерСтроки + 1, НомерКолонки).ШиринаКолонки = 13;
			КонецЕсли;
		КонецЦикла;
		Если СтрокаШапки > 0 И КолонкаПоследняя > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если СтрокаШапки > 0 И КолонкаПоследняя > КолонкаПервая Тогда
		ТонкаяЛиния = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
		ЖирнаяЛиния = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
		Сетка = ТабДок.Область(СтрокаШапки, КолонкаПервая, ТабДок.ВысотаТаблицы, КолонкаПоследняя);
		Сетка.ГраницаСлева  = ТонкаяЛиния;
		Сетка.ГраницаСправа = ТонкаяЛиния;
		Сетка.ГраницаСверху = ТонкаяЛиния;
		Сетка.ГраницаСнизу  = ТонкаяЛиния;
		Шапка = ТабДок.Область(СтрокаШапки, КолонкаПервая, СтрокаШапки + 1, КолонкаПоследняя);
		Шапка.ГраницаСлева  = ЖирнаяЛиния;
		Шапка.ГраницаСправа = ЖирнаяЛиния;
		Шапка.ГраницаСверху = ЖирнаяЛиния;
		Шапка.ГраницаСнизу  = ЖирнаяЛиния;
	КонецЕсли;

	Возврат ТабДок;

КонецФункции

// Друкована форма М-29 «ЗВІТ про витрати основних матеріалів у будівництві
// в співставленні з виробничими нормами» — програмний ТабДок, 13 колонок.
//
// Джерело сум — ВИКЛЮЧНО проводки Хозрасчетный проведених документів, на які посилається
// розрахунок (рішення замовника): у проводках списання по партіях, а не по середній як у
// документі, і в МалоценныеАктивы реквізиту Сумма немає взагалі.
//
// Два блоки: Матеріали (ДокументиКомплектації) і МШП (ДокументиМалоценки). Норма і
// понаднорма не розділяються — обидва слоти кожної сім'ї зливаються в один блок.
//
// Спека: docs/superpowers/specs/2026-08-03-m29-print-form-design.md
Функция СформироватьПечатьМ29() Экспорт

	ДаніМатеріали = ДанныеМ29ПоБлоку("Комплектація");
	ДаніМШП = ДанныеМ29ПоБлоку("Малоцінка");

	Если ДаніМатеріали.Строки.Количество() = 0 И ДаніМШП.Строки.Количество() = 0 Тогда
		Сообщить("Немає проведених документів комплектації/малоцінки — друкувати нічого.");
		Возврат Неопределено;
	КонецЕсли;

	ПропущеніДокументи = Новый Массив;
	Для Каждого Номер Из ДаніМатеріали.Непроведені Цикл
		ПропущеніДокументи.Добавить(Номер);
	КонецЦикла;
	Для Каждого Номер Из ДаніМШП.Непроведені Цикл
		ПропущеніДокументи.Добавить(Номер);
	КонецЦикла;
	Если ПропущеніДокументи.Количество() > 0 Тогда
		Сообщить("Увага: не проведені й не потрапили у звіт: " + СтрСоединить(ПропущеніДокументи, ", "));
	КонецЕсли;

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;

	НомерСтроки = ВывестиШапкуМ29(ТабДок);
	СтрокаНумерации = НомерСтроки - 1;

	// Блок «Матеріали»: перший рядок несе дані блоку «Інформація з АВР».
	ИтогМатериалы = 0;
	НомерСтроки = ВывестиБлокМ29(ТабДок, НомерСтроки, ДаніМатеріали.Строки, Истина, ИтогМатериалы);
	НомерСтроки = ВывестиИтогМ29(ТабДок, НомерСтроки, "Разом вартість матеріалів", ИтогМатериалы);

	ИтогМШП = 0;
	НомерСтроки = ВывестиБлокМ29(ТабДок, НомерСтроки, ДаніМШП.Строки, Ложь, ИтогМШП);
	НомерСтроки = ВывестиИтогМ29(ТабДок, НомерСтроки, "Разом вартість МШП", ИтогМШП);

	НомерСтроки = ВывестиИтогМ29(ТабДок, НомерСтроки, "ВСЬОГО списано", ИтогМатериалы + ИтогМШП);

	НомерСтроки = НомерСтроки + 1;
	ВывестиПодписиМ29(ТабДок, НомерСтроки);

	УстановитьШириныКолонокМ29(ТабДок, СтрокаНумерации);

	Возврат ТабДок;

КонецФункции


// Заповнює блок «Відвантаження по казні» ЦЬОГО документа: відкриває власне
// COM-з'єднання з базою Казначейства по будинку з реквізиту Подразделение.
// Для пачки документів використовувати
// Документы.РасчетКомплектаций.ЗаполнитьОтгрузкуПоКазнеПоСсылкам() — там
// одне з'єднання на всю пачку.
//
// Об'єкт НЕ записується — запис робить викликаюча сторона (форма пише
// патерном ЗаписатьРасчетПослеОперации, інакше Модифицированность
// заблокує підменю «Документи»).
//
// Возвращаемое значение:
//   Структура - Заполнено (Булево), Сообщение (Строка).
//
Функция ЗаполнитьОтгрузкуПоКазне() Экспорт

	Если Не ЗначениеЗаполнено(Подразделение) Тогда
		Возврат Новый Структура("Заполнено, Сообщение", Ложь,
			"Не заповнено реквізит «Підрозділ» (будинок) — нема за чим шукати відвантаження в казні.");
	КонецЕсли;

	МассивДомов = Новый Массив;
	МассивДомов.Добавить(Подразделение);
	ДанныеКазны = Документы.РасчетКомплектаций.ПолучитьОтгрузкиПоКазне(МассивДомов);

	Если ЗначениеЗаполнено(ДанныеКазны.Ошибка) Тогда
		Возврат Новый Структура("Заполнено, Сообщение", Ложь, ДанныеКазны.Ошибка);
	КонецЕсли;

	Возврат ЗаполнитьОтгрузкуПоКазнеИзДанных(ДанныеКазны.Данные[Подразделение]);

КонецФункции

// Заповнює реквізити ДатаОтгрузкиПоКазне / ОписаниеОтгрузкиПоКазне з уже
// прочитаних даних казни, БЕЗ власного COM-виклику.
//
// Параметры:
//   СписокОтгрузок - Массив, Неопределено - структури з
//                    Документы.РасчетКомплектаций.ПолучитьОтгрузкиПоКазне().
//
// Возвращаемое значение:
//   Структура - Заполнено (Булево), Сообщение (Строка).
//
Функция ЗаполнитьОтгрузкуПоКазнеИзДанных(СписокОтгрузок) Экспорт

	Результат = Новый Структура("Заполнено, Сообщение", Ложь, "");

	Если СписокОтгрузок = Неопределено Или СписокОтгрузок.Количество() = 0 Тогда
		// Вже заповнені реквізити НЕ чистимо: недоступна казна або незаповнена
		// в казні ТЧ ДоставкаДомов не повинні стирати введені дані.
		Результат.Сообщение = "Відвантаження по казні не знайдено для дому «"
			+ СокрЛП(Строка(Подразделение)) + "».";
		Возврат Результат;
	КонецЕсли;

	// Дата = НАЙРАНІШЕ відвантаження (масив відсортований за датою).
	НоваяДатаОтгрузки = СписокОтгрузок[0].Дата;
	НовоеОписаниеОтгрузки = Документы.РасчетКомплектаций.СформироватьОписаниеОтгрузки(СписокОтгрузок);

	Если ЗначениеЗаполнено(ДатаОтгрузкиПоКазне) И ДатаОтгрузкиПоКазне <> НоваяДатаОтгрузки Тогда
		Результат.Сообщение = "Увага: дату відвантаження по казні змінено з "
			+ Формат(ДатаОтгрузкиПоКазне, "ДФ=dd.MM.yyyy") + " на "
			+ Формат(НоваяДатаОтгрузки, "ДФ=dd.MM.yyyy") + ". ";
	КонецЕсли;

	ДатаОтгрузкиПоКазне = НоваяДатаОтгрузки;
	ОписаниеОтгрузкиПоКазне = НовоеОписаниеОтгрузки;

	Результат.Заполнено = Истина;
	Результат.Сообщение = Результат.Сообщение
		+ "Відвантаження по казні: " + Формат(НоваяДатаОтгрузки, "ДФ=dd.MM.yyyy")
		+ ?(СписокОтгрузок.Количество() > 1,
			" (знайдено " + Формат(СписокОтгрузок.Количество(), "ЧН=0; ЧГ=0") + " відвантажень, взято найраніше)", "");

	Возврат Результат;

КонецФункции


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СкладыСписком()
	Результат = Новый Массив;
	Для Каждого Стр Из СкладыОстатков Цикл
		Если ЗначениеЗаполнено(Стр.Склад) Тогда
			Результат.Добавить(Стр.Склад);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Организации, чьи остатки участвуют в расчёте: ТЧ ОрганизацииОстатков (уникальные),
// пустая ТЧ -> организация шапки, пустая и она -> пустой массив (= без фильтра, как раньше).
Функция ОрганизацииСписком()
	Результат = Новый Массив;
	Для Каждого Стр Из ОрганизацииОстатков Цикл
		Если ЗначениеЗаполнено(Стр.Организация) И Результат.Найти(Стр.Организация) = Неопределено Тогда
			Результат.Добавить(Стр.Организация);
		КонецЕсли;
	КонецЦикла;
	Если Результат.Количество() = 0 И ЗначениеЗаполнено(Организация) Тогда
		Результат.Добавить(Организация);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Автозаполнение ТЧ ОрганизацииОстатков (только если пуста): организация шапки +
// различные Склады.А_Организация выбранных складов. Пустые А_Организация пропускаются.
Процедура ДополнитьОрганизацииОстатков()
	Если ОрганизацииОстатков.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	Добавленные = Новый Соответствие;
	Если ЗначениеЗаполнено(Организация) Тогда
		ОрганизацииОстатков.Добавить().Организация = Организация;
		Добавленные.Вставить(Организация, Истина);
	КонецЕсли;
	Для Каждого Стр Из СкладыОстатков Цикл
		Если НЕ ЗначениеЗаполнено(Стр.Склад) Тогда
			Продолжить;
		КонецЕсли;
		ОрганизацияСклада = Стр.Склад.А_Организация;
		Если ЗначениеЗаполнено(ОрганизацияСклада) И Добавленные.Получить(ОрганизацияСклада) = Неопределено Тогда
			ОрганизацииОстатков.Добавить().Организация = ОрганизацияСклада;
			Добавленные.Вставить(ОрганизацияСклада, Истина);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Перечень организаций расчёта строкой (для шапок печатей): шапка + ТЧ, уникальные.
Функция ОрганизацииСтрокой()
	Список = Новый Массив;
	Если ЗначениеЗаполнено(Организация) Тогда
		Список.Добавить(Строка(Организация));
	КонецЕсли;
	Для Каждого Стр Из ОрганизацииОстатков Цикл
		Если ЗначениеЗаполнено(Стр.Организация) И Список.Найти(Строка(Стр.Организация)) = Неопределено Тогда
			Список.Добавить(Строка(Стр.Организация));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Список, ", ");
КонецФункции

// Ключ пары «склад × организация» для карт семейств целевых документов.
Функция КлючСкладОрганизация(СкладПары, ОрганизацияПары)
	Возврат Строка(СкладПары.УникальныйИдентификатор()) + "|"
		+ ?(ЗначениеЗаполнено(ОрганизацияПары), Строка(ОрганизацияПары.УникальныйИдентификатор()), "");
КонецФункции

// Добавляет в ТЧ целевых документов (комплектация и малоценка) склады из СкладыОстатков,
// которых там ещё нет (документы «ПоНормам»/«Додаткова» пользователь выбирает сам). Идемпотентно.
Процедура ДополнитьСкладыДокументов()
	ДополнитьСкладыВТаблицу(ДокументиКомплектації);
	ДополнитьСкладыВТаблицу(ДокументиМалоценки);
КонецПроцедуры

// Дополняет переданную ТЧ документов парами «склад × организация» (без дублей).
// Миграция старых строк с пустой Организацией: от УЖЕ вписанного документа строки
// (выбор пользователя главнее), иначе от Склады.А_Организация, иначе от организации шапки.
Процедура ДополнитьСкладыВТаблицу(ТаблицаДокументов)

	Для Каждого Стр Из ТаблицаДокументов Цикл
		Если ЗначениеЗаполнено(Стр.Организация) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ДокументПоНормам) Тогда
			Стр.Организация = Стр.ДокументПоНормам.Организация;
		ИначеЕсли ЗначениеЗаполнено(Стр.ДокументДодаткова) Тогда
			Стр.Организация = Стр.ДокументДодаткова.Организация;
		ИначеЕсли ЗначениеЗаполнено(Стр.Склад) Тогда
			Стр.Организация = Стр.Склад.А_Организация;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.Организация) Тогда
			Стр.Организация = Организация;
		КонецЕсли;
	КонецЦикла;

	Существующие = Новый Соответствие;
	Для Каждого Стр Из ТаблицаДокументов Цикл
		Если ЗначениеЗаполнено(Стр.Склад) Тогда
			Существующие.Вставить(КлючСкладОрганизация(Стр.Склад, Стр.Организация), Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого КЗ Из ПарыСкладОрганизация() Цикл
		Если Существующие.Получить(КЗ.Ключ) = Неопределено Тогда
			НоваяСтрока = ТаблицаДокументов.Добавить();
			НоваяСтрока.Склад = КЗ.Значение.Склад;
			НоваяСтрока.Организация = КЗ.Значение.Организация;
			Существующие.Вставить(КЗ.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Пары «склад × организация», реально встречающиеся в остатках анализа; склады из
// СкладыОстатков без остатков дают пару с Склады.А_Организация (fallback — шапка).
// Возвращает Соответствие: ключ -> Структура(Склад, Организация).
Функция ПарыСкладОрганизация()

	Пары = Новый Соответствие;
	Для Каждого Стр Из ТабличнаяЧастьОстатков Цикл
		Если НЕ ЗначениеЗаполнено(Стр.Склад) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = КлючСкладОрганизация(Стр.Склад, Стр.Организация);
		Если Пары.Получить(Ключ) = Неопределено Тогда
			Пары.Вставить(Ключ, Новый Структура("Склад, Организация", Стр.Склад, Стр.Организация));
		КонецЕсли;
	КонецЦикла;

	СкладыСОстатками = Новый Соответствие;
	Для Каждого КЗ Из Пары Цикл
		СкладыСОстатками.Вставить(КЗ.Значение.Склад, Истина);
	КонецЦикла;
	Для Каждого Стр Из СкладыОстатков Цикл
		Если НЕ ЗначениеЗаполнено(Стр.Склад) ИЛИ СкладыСОстатками.Получить(Стр.Склад) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОрганизацияПары = Стр.Склад.А_Организация;
		Если НЕ ЗначениеЗаполнено(ОрганизацияПары) Тогда
			ОрганизацияПары = Организация;
		КонецЕсли;
		Ключ = КлючСкладОрганизация(Стр.Склад, ОрганизацияПары);
		Если Пары.Получить(Ключ) = Неопределено Тогда
			Пары.Вставить(Ключ, Новый Структура("Склад, Организация", Стр.Склад, ОрганизацияПары));
		КонецЕсли;
	КонецЦикла;

	Возврат Пары;

КонецФункции

// Перечень выбранных складов строкой (для шапки печати).
Функция СкладыСтрокой()
	Список = Новый Массив;
	Для Каждого Стр Из СкладыОстатков Цикл
		Если ЗначениеЗаполнено(Стр.Склад) Тогда
			Список.Добавить(Строка(Стр.Склад));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Список, ", ");
КонецФункции

// Багаторядковий заголовок звіту: підрозділ + дата + склади + специфікація — щоб користувач
// бачив, по яких даних пораховано.
Функция ТекстЗаголовкаЗвіту(НазваЗвіту) Экспорт
	Текст = НазваЗвіту;
	Если ЗначениеЗаполнено(Спецификация) И ЗначениеЗаполнено(Спецификация.Подразделение) Тогда
		Текст = Текст + Символы.ПС + "Підрозділ: " + Строка(Спецификация.Подразделение);
	КонецЕсли;
	Дата = ?(ЗначениеЗаполнено(Период), Период, ТекущаяДата());
	Текст = Текст + Символы.ПС + "Залишки на: " + Формат(Дата, "ДЛФ=D");
	Склади = СкладыСтрокой();
	Если ЗначениеЗаполнено(Склади) Тогда
		Текст = Текст + Символы.ПС + "Склади: " + Склади;
	КонецЕсли;
	Если ЗначениеЗаполнено(Спецификация) Тогда
		Текст = Текст + Символы.ПС + "Специфікація: " + Строка(Спецификация);
	КонецЕсли;
	ПереченьОрганизаций = ОрганизацииСтрокой();
	Если ЗначениеЗаполнено(ПереченьОрганизаций) Тогда
		Текст = Текст + Символы.ПС + "Організація: " + ПереченьОрганизаций;
	КонецЕсли;
	Возврат Текст;
КонецФункции

// Ставить динамічний заголовок у параметри виводу СКД-налаштувань.
Процедура УстановитьЗаголовокЗвіту(Настройки, НазваЗвіту)
	ЭлЗаг = Настройки.ПараметрыВывода.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Заголовок"));
	Если ЭлЗаг <> Неопределено Тогда
		ЭлЗаг.Значение = ТекстЗаголовкаЗвіту(НазваЗвіту);
		ЭлЗаг.Использование = Истина;
	КонецЕсли;
КонецПроцедуры

// Выводит строку из массива значений в табличный документ (с рамкой; первые 4 колонки слева, числа справа).
Процедура ВывестиСтрокуПечати(ТабДок, НомерСтроки, МассивЗначений, Жирный, ЦветФонаСтроки = Неопределено, ЦентрироватьВсе = Ложь)
	Граница = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	Для К = 0 По МассивЗначений.ВГраница() Цикл
		Обл = ТабДок.Область(НомерСтроки, К + 1, НомерСтроки, К + 1);
		Обл.Текст = МассивЗначений[К];
		Обл.ГраницаСверху = Граница;
		Обл.ГраницаСнизу = Граница;
		Обл.ГраницаСлева = Граница;
		Обл.ГраницаСправа = Граница;
		Если ЦентрироватьВсе Тогда
			Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Иначе
			Обл.ГоризонтальноеПоложение = ?(К <= 3, ГоризонтальноеПоложение.Лево, ГоризонтальноеПоложение.Право);
		КонецЕсли;
		Если Жирный Тогда
			Обл.Шрифт = Новый Шрифт(, , Истина);
		КонецЕсли;
		Если ЦветФонаСтроки <> Неопределено Тогда
			Обл.ЦветФона = ЦветФонаСтроки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Счета-источники остатков комплектации из ТЧ СчетаОстатков; пусто -> группы 20/28
// (материалы; малоценка идёт через СчетаМалоценкиСписком).
Функция СчетаСписком()
	Результат = Новый Массив;
	Для Каждого Стр Из СчетаОстатков Цикл
		Если ЗначениеЗаполнено(Стр.Счет) Тогда
			Результат.Добавить(Стр.Счет);
		КонецЕсли;
	КонецЦикла;
	Если Результат.Количество() = 0 Тогда
		Для Каждого Код Из СтрРазделить("20,28", ",") Цикл
			Сч = ПланыСчетов.Хозрасчетный.НайтиПоКоду(Код);
			Если ЗначениеЗаполнено(Сч) Тогда
				Результат.Добавить(Сч);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Счета-источники остатков малоценки из ТЧ СчетаМалоценки; пусто -> счёт 22.
Функция СчетаМалоценкиСписком()
	Результат = Новый Массив;
	Для Каждого Стр Из СчетаМалоценки Цикл
		Если ЗначениеЗаполнено(Стр.Счет) Тогда
			Результат.Добавить(Стр.Счет);
		КонецЕсли;
	КонецЦикла;
	Если Результат.Количество() = 0 Тогда
		Сч = ПланыСчетов.Хозрасчетный.НайтиПоКоду("22");
		Если ЗначениеЗаполнено(Сч) Тогда
			Результат.Добавить(Сч);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Объединение счетов комплектации и малоценки (для загрузки остатков одним запросом).
Функция ВсеСчетаСписком()
	Результат = Новый Массив;
	Для Каждого Сч Из СчетаСписком() Цикл
		Результат.Добавить(Сч);
	КонецЦикла;
	Для Каждого Сч Из СчетаМалоценкиСписком() Цикл
		Результат.Добавить(Сч);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Соответствие «счёт малоценки -> Истина» (для классификации строк анализа).
Функция МножинаСчетовМалоценки()
	Множина = Новый Соответствие;
	Для Каждого Сч Из СчетаМалоценкиСписком() Цикл
		Множина.Вставить(Сч, Истина);
	КонецЦикла;
	Возврат Множина;
КонецФункции

// Истина, если счёт строки принадлежит по иерархии какому-либо счёту малоценки.
// Строка несёт конкретный субсчёт (221), список задан группой (22) -> подъём по родителю.
Функция СчетМалоценки(Счет, МножинаМалоценки)
	ТекСчет = Счет;
	Пока ЗначениеЗаполнено(ТекСчет) Цикл
		Если МножинаМалоценки.Получить(ТекСчет) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		ТекСчет = ТекСчет.Родитель;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Этапы работ из ТЧ Этапы (для фильтра норм).
Функция ЭтапыСписком()
	Результат = Новый Массив;
	Для Каждого Стр Из Этапы Цикл
		Если ЗначениеЗаполнено(Стр.Этап) Тогда
			Результат.Добавить(Стр.Этап);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Кількість рядків норм специфікації, де одиниця Комплектующие <> базовій одиниці номенклатури.
// На практиці 0 (норма вже в базовій одиниці); >0 -> попередження в журналі (норму НЕ перераховуємо).
Функция КількістьРозбіжностейОдиниць()
	Если НЕ ЗначениеЗаполнено(Спецификация) Тогда
		Возврат 0;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Спецификация", Спецификация);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Кіл
	|ИЗ
	|	Справочник.СтруктураСебестоимости.Комплектующие КАК К
	|ГДЕ
	|	К.Ссылка = &Спецификация
	|	И СОКРЛП(К.Единица.Наименование) <> СОКРЛП(К.Номенклатура.БазоваяЕдиницаИзмерения.Наименование)
	|	И К.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Кіл, 0);
КонецФункции

// Пише попередження в журнал реєстрації, якщо одиниці норм не збігаються з базовими.
Процедура ПопередитиПроРозбіжністьОдиниць()
	Розбіжностей = КількістьРозбіжностейОдиниць();
	Если Розбіжностей > 0 Тогда
		ЗаписьЖурналаРегистрации("РасчетКомплектаций.Одиниці", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Специфікація " + Строка(Спецификация) + ": одиниця норми не збігається з базовою у "
			+ Строка(Розбіжностей) + " рядк(ах) — норму взято без перерахунку.");
	КонецЕсли;
КонецПроцедуры

// Коефіцієнт приведення собівартості остатків (без ПДВ) до бази норми (з ПДВ).
// Норми у Структурі Собівартості введені з ПДВ 20%, рахунки обліку — без ПДВ.
Функция КоэффициентНДС()
	Возврат 1.2;
КонецФункции

// Залишки для аналізу: якщо визначено дату відвантаження — по дедлайну КОЖНОГО складу
// (виробничі/ІС — D 08:59:59, монтаж — M 19:59:59), інакше одна дата = кінець періоду.
Функция ПолучитьОстатки(СкладыМассив)

	Если Не ЗначениеЗаполнено(ДатаОтгрузки) Тогда
		Возврат ПолучитьОстаткиНаДату(СкладыМассив, ?(ЗначениеЗаполнено(Период), КонецДня(Период), КонецДня(ТекущаяДата())));
	КонецЕсли;
	ДатаD = НачалоДня(ДатаОтгрузки);
	ДатаM = ?(ЗначениеЗаполнено(ДатаСписанияПоМонтажу), НачалоДня(ДатаСписанияПоМонтажу), НачалоДня(КонецМесяца(ДатаD + 10 * 86400)));
	ВиробМассив = Новый Массив;
	МонтажМассив = Новый Массив;
	Для Каждого СкладЗ Из СкладыМассив Цикл
		Если ЗначениеЗаполнено(СкладЗ) И СкладЗ.А_ВидСклада = Перечисления.А_ВидСклада.Монтаж Тогда
			МонтажМассив.Добавить(СкладЗ);
		Иначе
			ВиробМассив.Добавить(СкладЗ);
		КонецЕсли;
	КонецЦикла;
	Результат = Неопределено;
	Если ВиробМассив.Количество() > 0 Тогда
		Результат = ПолучитьОстаткиНаДату(ВиробМассив, ДатаD + 8 * 3600 + 59 * 60 + 59);
	КонецЕсли;
	Если МонтажМассив.Количество() > 0 Тогда
		ЧастинаМонтажу = ПолучитьОстаткиНаДату(МонтажМассив, ДатаM + 19 * 3600 + 59 * 60 + 59);
		Если Результат = Неопределено Тогда
			Результат = ЧастинаМонтажу;
		Иначе
			Для Каждого РядокМ Из ЧастинаМонтажу Цикл
				ЗаполнитьЗначенияСвойств(Результат.Добавить(), РядокМ);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если Результат = Неопределено Тогда
		Результат = ПолучитьОстаткиНаДату(СкладыМассив, ДатаD);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПолучитьОстаткиНаДату(СкладыМассив, НаДату)


	// Мультиорг: остатки берутся по СПИСКУ организаций (ТЧ ОрганизацииОстатков, пусто ->
	// организация шапки, пусто и там -> без фильтра); организация остатка идёт в строку
	// анализа — по ней потом роутинг в целевые документы своей организации.
	ОрганизацииМассив = ОрганизацииСписком();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("Склады", СкладыМассив);
	Запрос.УстановитьПараметр("Счета", ВсеСчетаСписком());
	Запрос.УстановитьПараметр("Организации", ОрганизацииМассив);
	Запрос.УстановитьПараметр("БезФильтраОрганизаций", ОрганизацииМассив.Количество() = 0);
	Запрос.УстановитьПараметр("КоэффНДС", КоэффициентНДС());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура).ОбщееНазваниеНоменклатуры КАК ОбщееНазвание,
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура).БазоваяЕдиницаИзмерения КАК Единица,
	|	ВЫРАЗИТЬ(Ост.Субконто3 КАК Справочник.Склады) КАК Склад,
	|	Ост.Организация КАК Организация,
	|	Ост.Счет КАК Счет,
	|	СУММА(Ост.КоличествоОстаток) КАК Остаток,
	|	СУММА(Ост.СуммаОстаток) * &КоэффНДС КАК СуммаОстатка
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&НаДату, Счет В ИЕРАРХИИ(&Счета), , ) КАК Ост
	|ГДЕ
	|	Ост.КоличествоОстаток > 0
	|	И (&БезФильтраОрганизаций ИЛИ Ост.Организация В (&Организации))
	|	И ВЫРАЗИТЬ(Ост.Субконто3 КАК Справочник.Склады) В (&Склады)
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура),
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура).ОбщееНазваниеНоменклатуры,
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура).БазоваяЕдиницаИзмерения,
	|	ВЫРАЗИТЬ(Ост.Субконто3 КАК Справочник.Склады),
	|	Ост.Организация,
	|	Ост.Счет
	|УПОРЯДОЧИТЬ ПО
	|	ОбщееНазвание,
	|	Остаток УБЫВ";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолучитьНормы()

	МассивЭтапов = ЭтапыСписком();
	УсловиеЭтапа = "";
	Если МассивЭтапов.Количество() > 0 Тогда
		УсловиеЭтапа = ?(ИсключатьЭтапы, " И НЕ К.Этап В (&Этапы)", " И К.Этап В (&Этапы)");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Спецификация", Спецификация);
	Запрос.УстановитьПараметр("Этапы", МассивЭтапов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.ОбщееНазвание КАК ОбщееНазвание,
	|	К.Номенклатура КАК Номенклатура,
	|	К.Этап КАК Этап,
	|	ВЫРАЗИТЬ(К.Номенклатура КАК Справочник.Номенклатура).БазоваяЕдиницаИзмерения КАК Единица,
	|	К.Единица КАК ЕдиницаСС,
	|	СУММА(К.Количество) КАК Норма,
	|	СУММА(К.Сумма) КАК НормаСум
	|ИЗ
	|	Справочник.СтруктураСебестоимости.Комплектующие КАК К
	|ГДЕ
	|	К.Ссылка = &Спецификация" + УсловиеЭтапа + "
	|СГРУППИРОВАТЬ ПО
	|	К.ОбщееНазвание,
	|	К.Номенклатура,
	|	К.Этап,
	|	ВЫРАЗИТЬ(К.Номенклатура КАК Справочник.Номенклатура).БазоваяЕдиницаИзмерения,
	|	К.Единица";
	Выборка = Запрос.Выполнить().Выгрузить();

	НормыЭталон = Новый Соответствие;
	НормыНоменкл = Новый Соответствие;
	ПланМассив = Новый Массив;
	ЭтапНоменкл = Новый Соответствие;   // перший етап на номенклатуру (рішення замовника)
	ЭтапЭталон = Новый Соответствие;    // перший етап на еталон (fallback для fact-only номенклатур еталону)
	НоменклаДані = Новый Соответствие;  // Номенклатура -> {Эталон, Единица} (для рядків норм-карток без залишку)
	НормаКарткаЭтап = Новый Соответствие; // Фаза 16: Номенклатура -> Соответствие(Этап|"__БЕЗЭТАПУ__" -> {Кол, Сум})
	НормаЭталонЭтап = Новый Соответствие; // Фаза 16: ОбщееНазвание -> Соответствие(Этап|"__БЕЗЭТАПУ__" -> {Кол, Сум})
	Для Каждого Стр Из Выборка Цикл
		ДЭ = НормыЭталон.Получить(Стр.ОбщееНазвание);
		Если ДЭ = Неопределено Тогда
			ДЭ = Новый Структура("Кол, Сум", 0, 0);
			НормыЭталон.Вставить(Стр.ОбщееНазвание, ДЭ);
		КонецЕсли;
		ДЭ.Кол = ДЭ.Кол + Стр.Норма;
		ДЭ.Сум = ДЭ.Сум + Стр.НормаСум;
		Если ЗначениеЗаполнено(Стр.ОбщееНазвание) И ЭтапЭталон.Получить(Стр.ОбщееНазвание) = Неопределено И ЗначениеЗаполнено(Стр.Этап) Тогда
			ЭтапЭталон.Вставить(Стр.ОбщееНазвание, Стр.Этап);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Номенклатура) Тогда
			ДН = НормыНоменкл.Получить(Стр.Номенклатура);
			Если ДН = Неопределено Тогда
				ДН = Новый Структура("Кол, Сум", 0, 0);
				НормыНоменкл.Вставить(Стр.Номенклатура, ДН);
				ПланМассив.Добавить(Стр.Номенклатура);
				НоменклаДані.Вставить(Стр.Номенклатура, Новый Структура("Эталон, Единица, ЕдиницаСС", Стр.ОбщееНазвание, Стр.Единица, Стр.ЕдиницаСС));
			КонецЕсли;
			ДН.Кол = ДН.Кол + Стр.Норма;
			ДН.Сум = ДН.Сум + Стр.НормаСум;
			Если ЭтапНоменкл.Получить(Стр.Номенклатура) = Неопределено И ЗначениеЗаполнено(Стр.Этап) Тогда
				ЭтапНоменкл.Вставить(Стр.Номенклатура, Стр.Этап);
			КонецЕсли;
		КонецЕсли;

		// Фаза 16: по-етапна норма (картка й еталон) для коректної розшивки звіту «за етапами».
		// Порожній этап -> рядковий сентинел (§7: НЕ використовувати Неопределено як ключ Соответствия).
		ЭтапКлюч = ?(ЗначениеЗаполнено(Стр.Этап), Стр.Этап, "__БЕЗЭТАПУ__");
		Если ЗначениеЗаполнено(Стр.Номенклатура) Тогда
			СтК = НормаКарткаЭтап.Получить(Стр.Номенклатура);
			Если СтК = Неопределено Тогда СтК = Новый Соответствие; НормаКарткаЭтап.Вставить(Стр.Номенклатура, СтК); КонецЕсли;
			ДК = СтК.Получить(ЭтапКлюч);
			Если ДК = Неопределено Тогда ДК = Новый Структура("Кол, Сум", 0, 0); СтК.Вставить(ЭтапКлюч, ДК); КонецЕсли;
			ДК.Кол = ДК.Кол + Стр.Норма; ДК.Сум = ДК.Сум + Стр.НормаСум;
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ОбщееНазвание) Тогда
			СтЕ = НормаЭталонЭтап.Получить(Стр.ОбщееНазвание);
			Если СтЕ = Неопределено Тогда СтЕ = Новый Соответствие; НормаЭталонЭтап.Вставить(Стр.ОбщееНазвание, СтЕ); КонецЕсли;
			ДЕст = СтЕ.Получить(ЭтапКлюч);
			Если ДЕст = Неопределено Тогда ДЕст = Новый Структура("Кол, Сум", 0, 0); СтЕ.Вставить(ЭтапКлюч, ДЕст); КонецЕсли;
			ДЕст.Кол = ДЕст.Кол + Стр.Норма; ДЕст.Сум = ДЕст.Сум + Стр.НормаСум;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Эталон, Номенкл, ПланМассив, ЭтапНоменкл, ЭтапЭталон, НоменклаДані, НормаКарткаЭтап, НормаЭталонЭтап",
		НормыЭталон, НормыНоменкл, ПланМассив, ЭтапНоменкл, ЭтапЭталон, НоменклаДані, НормаКарткаЭтап, НормаЭталонЭтап);
КонецФункции

// Додає у ТЗОстатки рядки для норм-карток (план), яких немає в залишках (Остаток=0),
// щоб у звітах було видно ВСІ заплановані картки. Кап/розподіл не зачіпає (нульовий залишок
// у ЗаполнитьАнализ дає min(0,cap)=0; ПорядокПлан=0, але сортування Остаток Убыв ставить їх
// після залишкових норм-карток).
Процедура ДополнитьНоменклатуройБезОстатков(ТЗОстатки, Нормы)
	ЕстьВОстатках = Новый Соответствие;
	Для Каждого Стр Из ТЗОстатки Цикл
		ЕстьВОстатках.Вставить(Стр.Номенклатура, Истина);
	КонецЦикла;
	Для Каждого Ном Из Нормы.ПланМассив Цикл
		Если ЕстьВОстатках.Получить(Ном) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Дані = Нормы.НоменклаДані.Получить(Ном);
		НоваяСтрока = ТЗОстатки.Добавить();
		НоваяСтрока.Номенклатура = Ном;
		Если Дані <> Неопределено Тогда
			НоваяСтрока.ОбщееНазвание = Дані.Эталон;
			НоваяСтрока.Единица = Дані.Единица;
		КонецЕсли;
		НоваяСтрока.Остаток = 0;
		НоваяСтрока.СуммаОстатка = 0;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьАнализ(ТЗОстатки, Нормы)

	ТабличнаяЧастьОстатков.Очистить();
	ЕдиницыЭталона = ЕдиницыЭталонов(ТЗОстатки);

	// Порядок усередині эталону: спочатку номенклатури з плану, далі за спаданням залишку.
	Если ТЗОстатки.Колонки.Найти("ПорядокПлан") = Неопределено Тогда
		ТЗОстатки.Колонки.Добавить("ПорядокПлан");
	КонецЕсли;
	Для Каждого Стр Из ТЗОстатки Цикл
		Стр.ПорядокПлан = ?(Нормы.Номенкл.Получить(Стр.Номенклатура) = Неопределено, 1, 0);
	КонецЦикла;
	// Организация — ПОСЛЕДНИМ ключом: при одной организации порядок (и распределение
	// нормы по строкам эталона) байт-в-байт как раньше.
	ТЗОстатки.Сортировать("ОбщееНазвание Возр, ПорядокПлан Возр, Остаток Убыв, Организация Возр");

	БаченіНоменклатури = Новый Соответствие;
	ТекЭталон = Неопределено;
	ОстатокНормы = 0;
	НормаЭталона = 0;
	НормаСумЭталона = 0;
	ПервыйРяд = Истина;
	ПерваяСтрокаЭталона = Неопределено;

	Для Каждого Стр Из ТЗОстатки Цикл

		НовыйЭталон = ПервыйРяд ИЛИ Стр.ОбщееНазвание <> ТекЭталон;
		Если НовыйЭталон Тогда
			ЗафиксироватьЭкономиюЭталона(ПерваяСтрокаЭталона, ОстатокНормы, НормаЭталона, НормаСумЭталона);
			ТекЭталон = Стр.ОбщееНазвание;
			ДанныеНормы = ?(ЗначениеЗаполнено(Стр.ОбщееНазвание), Нормы.Эталон.Получить(Стр.ОбщееНазвание), Неопределено);
			Если ДанныеНормы = Неопределено Тогда
				НормаЭталона = 0;
				НормаСумЭталона = 0;
			Иначе
				НормаЭталона = ДанныеНормы.Кол;
				НормаСумЭталона = ДанныеНормы.Сум;
			КонецЕсли;
			ОстатокНормы = НормаЭталона;
			ПервыйРяд = Ложь;
		КонецЕсли;

		ВНорме = ?(Стр.Остаток < ОстатокНормы, Стр.Остаток, ОстатокНормы);
		Если ВНорме < 0 Тогда
			ВНорме = 0;
		КонецЕсли;
		ПонадНорму = Стр.Остаток - ВНорме;
		ОстатокНормы = ОстатокНормы - ВНорме;

		ЦенаСтроки = ?(Стр.Остаток <> 0, Стр.СуммаОстатка / Стр.Остаток, 0);
		ВНормеСумма = Окр(ВНорме * ЦенаСтроки, 2);
		ПонадНормуСумма = Стр.СуммаОстатка - ВНормеСумма;

		НоваяСтрока = ТабличнаяЧастьОстатков.Добавить();
		НоваяСтрока.Номенклатура = Стр.Номенклатура;
		НоваяСтрока.ОбщееНазвание = Стр.ОбщееНазвание;
		НоваяСтрока.Единица = Стр.Единица;
		ДаніНорми = Нормы.НоменклаДані.Получить(Стр.Номенклатура);
		Если ДаніНорми <> Неопределено Тогда
			НоваяСтрока.ЕдиницаСС = ДаніНорми.ЕдиницаСС;
		КонецЕсли;
		ЭтапРядка = Нормы.ЭтапНоменкл.Получить(Стр.Номенклатура);
		Если ЭтапРядка = Неопределено Тогда
			ЭтапРядка = Нормы.ЭтапЭталон.Получить(Стр.ОбщееНазвание);
		КонецЕсли;
		Если ЭтапРядка <> Неопределено Тогда
			НоваяСтрока.Этап = ЭтапРядка;
		КонецЕсли;
		НоваяСтрока.Склад = Стр.Склад;
		НоваяСтрока.Организация = Стр.Организация;
		НоваяСтрока.Счет = Стр.Счет;
		НоваяСтрока.Остаток = Стр.Остаток;
		НоваяСтрока.СуммаОстатка = Стр.СуммаОстатка;
		НоваяСтрока.Норма = ?(НовыйЭталон, НормаЭталона, 0);
		НоваяСтрока.НормаСумма = ?(НовыйЭталон, НормаСумЭталона, 0);
		НоваяСтрока.ВНорме = ВНорме;
		НоваяСтрока.ВНормеСумма = ВНормеСумма;
		НоваяСтрока.ПонадНорму = ПонадНорму;
		НоваяСтрока.ПонадНормуСумма = ПонадНормуСумма;
		НоваяСтрока.РасхождениеЕдиниц = ЕстьРасхождениеЕдиниц(НоваяСтрока.ЕдиницаСС,
			НоваяСтрока.Единица, ЕдиницыЭталона.Получить(Стр.ОбщееНазвание), ЗначениеЗаполнено(Стр.ОбщееНазвание));

		// План по номенклатурі — лише на першому рядку кожної номенклатури (щоб СКД-Σ не задвоював).
		Если БаченіНоменклатури.Получить(Стр.Номенклатура) = Неопределено Тогда
			БаченіНоменклатури.Вставить(Стр.Номенклатура, Истина);
			ДН = Нормы.Номенкл.Получить(Стр.Номенклатура);
			Если ДН <> Неопределено Тогда
				НоваяСтрока.НормаНоменкл = ДН.Кол;
				НоваяСтрока.НормаСуммаНоменкл = ДН.Сум;
			КонецЕсли;
		КонецЕсли;

		Если НовыйЭталон Тогда
			ПерваяСтрокаЭталона = НоваяСтрока;
		КонецЕсли;

	КонецЦикла;

	ЗафиксироватьЭкономиюЭталона(ПерваяСтрокаЭталона, ОстатокНормы, НормаЭталона, НормаСумЭталона);

КонецПроцедуры

// Пишет неиспользованную норму (кол + сумма) на представительную строку эталона.
// Сумма — КІЛЬКІСНА оцінка за плановими цінами СС: Економія × (НормаСум/Норма).
// Цінову різницю план/факт в економію НЕ підмішуємо (рішення бухгалтера 2026-08-06):
// раніше «Гайка» показувала 11 906 грн економії при перевитраті 5 шт.
Процедура ЗафиксироватьЭкономиюЭталона(СтрокаЭталона, ОстатокНормы, НормаЭталона, НормаСумЭталона)
	Если СтрокаЭталона <> Неопределено Тогда
		СтрокаЭталона.Экономия = ?(ОстатокНормы > 0, ОстатокНормы, 0);
		Если ОстатокНормы > 0 И НормаЭталона > 0 Тогда
			СтрокаЭталона.ЕкономіяСума = Окр(ОстатокНормы * НормаСумЭталона / НормаЭталона, 2);
		Иначе
			СтрокаЭталона.ЕкономіяСума = 0;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура НакопитьСтроку(СтрокиПоДокументам, ДокСсылка, Номенклатура, Количество, Счет, Сумма)
	ТЗ = ТаблицаСтрокДокумента(СтрокиПоДокументам, ДокСсылка);
	НоваяСтрока = ТЗ.Добавить();
	НоваяСтрока.Номенклатура = Номенклатура;
	НоваяСтрока.Количество = Количество;
	НоваяСтрока.Счет = Счет;
	НоваяСтрока.Сумма = Сумма;
КонецПроцедуры

// Таблица строк документа в карте заполнения; создаётся при первом обращении.
Функция ТаблицаСтрокДокумента(СтрокиПоДокументам, ДокСсылка)
	ТЗ = СтрокиПоДокументам.Получить(ДокСсылка);
	Если ТЗ = Неопределено Тогда
		ТЗ = Новый ТаблицаЗначений;
		ТЗ.Колонки.Добавить("Номенклатура");
		ТЗ.Колонки.Добавить("Количество");
		ТЗ.Колонки.Добавить("Счет");
		ТЗ.Колонки.Добавить("Сумма");
		СтрокиПоДокументам.Вставить(ДокСсылка, ТЗ);
	КонецЕсли;
	Возврат ТЗ;
КонецФункции

// Предсоздаёт в карте заполнения ПУСТЫЕ таблицы для всех документов карт семейства
// (режим — «ПоНормам» или «Додаткова»).
Процедура ПредсоздатьСтрокиДокументов(СтрокиПоДокументам, Карты, ИмяРежима)
	Для Каждого КЗ Из Карты.Точные Цикл
		Если ЗначениеЗаполнено(КЗ.Значение[ИмяРежима]) Тогда
			ТаблицаСтрокДокумента(СтрокиПоДокументам, КЗ.Значение[ИмяРежима]);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Карты роутинга одного семейства (ТЧ ДокументиКомплектації или ДокументиМалоценки):
//   Точные  — ключ (склад|организация) -> Структура(ПоНормам, Додаткова);
//   ПоСкладу — склад -> та же пара, ТОЛЬКО если строка склада ЕДИНСТВЕННАЯ
//              (fallback для строк без организации / старых документов).
Функция КартыСемейства(ТаблицаДокументов)
	Точные = Новый Соответствие;
	ПоСкладу = Новый Соответствие;
	Дубли = Новый Соответствие;
	Для Каждого Стр Из ТаблицаДокументов Цикл
		Если НЕ ЗначениеЗаполнено(Стр.Склад) Тогда
			Продолжить;
		КонецЕсли;
		Пара = Новый Структура("ПоНормам, Додаткова", Стр.ДокументПоНормам, Стр.ДокументДодаткова);
		Точные.Вставить(КлючСкладОрганизация(Стр.Склад, Стр.Организация), Пара);
		Если ПоСкладу.Получить(Стр.Склад) = Неопределено И Дубли.Получить(Стр.Склад) = Неопределено Тогда
			ПоСкладу.Вставить(Стр.Склад, Пара);
		Иначе
			// вторая строка того же склада (разные организации) — fallback по складу неоднозначен
			ПоСкладу.Удалить(Стр.Склад);
			Дубли.Вставить(Стр.Склад, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Точные, ПоСкладу", Точные, ПоСкладу);
КонецФункции

// Целевой документ для строки списания: точный ключ (склад|организация),
// иначе — единственная строка склада в семействе. Неопределено = склад пропущен.
Функция ДокументДляСтроки(Карты, СкладСтроки, ОрганизацияСтроки, ИмяРежима)
	Пара = Карты.Точные.Получить(КлючСкладОрганизация(СкладСтроки, ОрганизацияСтроки));
	Если Пара = Неопределено Тогда
		Пара = Карты.ПоСкладу.Получить(СкладСтроки);
	КонецЕсли;
	Если Пара = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Пара[ИмяРежима];
КонецФункции

// Строит соответствие «документ -> ТЗ строк» из СОХРАНЁННЫХ таблиц списания:
// СписаниеПоНормам -> документы «ПоНормам», СписаниеСверхНормы -> документы «Додаткова»
// (ручные правки понаднормы попадают в документы). Семейство (комплектация/малоценка) — по счёту строки,
// документ внутри семейства — по паре (склад, организация) строки.
Функция ПодготовитьСтрокиПоДокументам(Результат, ЗаполнятьВНорме, ЗаполнятьПонад)

	КартыКомпл = КартыСемейства(ДокументиКомплектації);
	КартыМал = КартыСемейства(ДокументиМалоценки);

	МножинаМал = МножинаСчетовМалоценки();
	СтрокиПоДокументам = Новый Соответствие;
	ПропущенныеСклады = Новый Соответствие;

	// КОНТРАКТ карты: КОЖЕН цільовий документ активного режиму присутній у карті, навіть
	// якщо поточний розрахунок не дав йому жодного рядка (значення = порожня ТЗ). Без цього
	// документ зі СТАРИМ складом ТЧ не перезаписувався і проводився застарілим розрахунком
	// (дефект знайдено заказчиком 2026-08-25).
	Если ЗаполнятьВНорме Тогда
		ПредсоздатьСтрокиДокументов(СтрокиПоДокументам, КартыКомпл, "ПоНормам");
		ПредсоздатьСтрокиДокументов(СтрокиПоДокументам, КартыМал, "ПоНормам");
	КонецЕсли;
	Если ЗаполнятьПонад Тогда
		ПредсоздатьСтрокиДокументов(СтрокиПоДокументам, КартыКомпл, "Додаткова");
		ПредсоздатьСтрокиДокументов(СтрокиПоДокументам, КартыМал, "Додаткова");
	КонецЕсли;

	Если ЗаполнятьВНорме Тогда
		Для Каждого Стр Из СписаниеПоНормам Цикл
			Если НЕ Стр.Количество > 0 Тогда
				Продолжить;
			КонецЕсли;
			Если СчетМалоценки(Стр.Счет, МножинаМал) Тогда
				Карты = КартыМал;
			Иначе
				Карты = КартыКомпл;
			КонецЕсли;
			РаспределитьВДокумент(СтрокиПоДокументам, ПропущенныеСклады,
				ДокументДляСтроки(Карты, Стр.Склад, Стр.Организация, "ПоНормам"),
				Стр.Склад, Стр.Номенклатура, Стр.Количество, Стр.Счет, Стр.Сумма);
		КонецЦикла;
	КонецЕсли;

	Если ЗаполнятьПонад Тогда
		Для Каждого Стр Из СписаниеСверхНормы Цикл
			// Списываем только заявленное бухгалтером КоличествоКСписанию (<= понаднорма).
			Если НЕ Стр.КоличествоКСписанию > 0 Тогда
				Продолжить;
			КонецЕсли;
			Если СчетМалоценки(Стр.Счет, МножинаМал) Тогда
				Карты = КартыМал;
			Иначе
				Карты = КартыКомпл;
			КонецЕсли;
			// Сумма пропорционально доле КоличествоКСписанию (при = Количество даёт исходную Сумму без дрейфа).
			СуммаКСписанию = ?(Стр.Количество > 0, Окр(Стр.Сумма * Стр.КоличествоКСписанию / Стр.Количество, 2), 0);
			РаспределитьВДокумент(СтрокиПоДокументам, ПропущенныеСклады,
				ДокументДляСтроки(Карты, Стр.Склад, Стр.Организация, "Додаткова"),
				Стр.Склад, Стр.Номенклатура, Стр.КоличествоКСписанию, Стр.Счет, СуммаКСписанию);
		КонецЦикла;
	КонецЕсли;

	Результат.Пропущено = ПропущенныеСклады.Количество();
	Возврат СтрокиПоДокументам;

КонецФункции

// Кладёт строку в ТЗ выбранного документа; если документ не выбран — помечает склад пропущенным.
Процедура РаспределитьВДокумент(СтрокиПоДокументам, ПропущенныеСклады, ДокСсылка, Склад, Номенклатура, Количество, Счет, Сумма)
	Если НЕ ЗначениеЗаполнено(ДокСсылка) Тогда
		ПропущенныеСклады.Вставить(Склад, Истина);
		Возврат;
	КонецЕсли;
	НакопитьСтроку(СтрокиПоДокументам, ДокСсылка, Номенклатура, Количество, Счет, Сумма);
КонецПроцедуры

// Записывает строки в ТЧ выбранных документов. Вызывается ВНУТРИ транзакции.
// Ветвление по типу документа: ПередачаМалоценныхАктивовВЭксплуатацию -> ТЧ МалоценныеАктивы (без Сумма),
// иначе КомплектацияНоменклатуры -> ТЧ Комплектующие (с Сумма). Ветку выбираем через Если/Иначе:
// оператор ?() вычислил бы обе ветки и упал на несуществующей у документа ТЧ.
// Для малоценки дополнительно заполняются:
//   ФизЛицо (МВО) и Способ — из ТЧ ДокументиМалоценки (по документу);
//   НалоговоеНазначение = НДС_Облагаемая (предопределённое);
//   НазначениеИспользования — поиск по (Номенклатура=Владелец, СпособОтраженияРасходов) в кэше.
Процедура СформироватьДокументыПоСоответствию(СтрокиПоДокументам, Результат)

	ИмяСобытия = "РасчетКомплектаций.Заповнення документів";
	ТипМалоценки = Тип("ДокументСсылка.ПередачаМалоценныхАктивовВЭксплуатацию");
	НалоговоеНазначениеМал = Справочники.НалоговыеНазначенияАктивовИЗатрат.НДС_Облагаемая;
	ДокМетаМал = МетаданныеДокументовМалоценки();
	КэшНазнИсп = ПодготовитьКэшНазначенийИспользования(СтрокиПоДокументам, ДокМетаМал, ТипМалоценки);
	ПризнакиПоНорме = ПризнакиПоНормеДокументов();

	Для Каждого КЗ Из СтрокиПоДокументам Цикл
		ДокСсылка = КЗ.Ключ;
		ДокОбъект = ДокСсылка.ПолучитьОбъект();
		// Автопроставление признака «За нормою» (ПоНорме): колонка ДокументПоНормам -> Истина,
		// ДокументДодаткова -> Ложь. По признаку отчёт «Списання за нормами і понад норму (бухоблік)»
		// делит факт списания; до автопроставления флаг ставили руками и пропускали (ІБ00-000135).
		ПризнакПоНорме = ПризнакиПоНорме.Получить(ДокСсылка);
		Если ПризнакПоНорме <> Неопределено Тогда
			ДокОбъект.ПоНорме = ПризнакПоНорме;
		КонецЕсли;
		ЭтоМалоценка = (ТипЗнч(ДокСсылка) = ТипМалоценки);
		ФизЛицоДок = Неопределено;
		СпособДок = Неопределено;
		Если ЭтоМалоценка Тогда
			ТабЧасть = ДокОбъект.МалоценныеАктивы;
			Мета = ДокМетаМал.Получить(ДокСсылка);
			Если Мета <> Неопределено Тогда
				ФизЛицоДок = Мета.ФизЛицо;
				СпособДок = Мета.Способ;
			КонецЕсли;
		Иначе
			ТабЧасть = ДокОбъект.Комплектующие;
		КонецЕсли;
		ТабЧасть.Очистить();
		Для Каждого СтрД Из КЗ.Значение Цикл
			НС = ТабЧасть.Добавить();
			НС.Номенклатура = СтрД.Номенклатура;
			НС.Коэффициент = 1;
			НС.СчетУчетаБУ = СтрД.Счет;
			НС.Количество = СтрД.Количество;
			Если ЭтоМалоценка Тогда
				НС.НалоговоеНазначение = НалоговоеНазначениеМал;
				Если ЗначениеЗаполнено(ФизЛицоДок) Тогда
					НС.ФизЛицо = ФизЛицоДок;
				КонецЕсли;
				НазнИсп = НайтиНазначениеИспользования(КэшНазнИсп, СтрД.Номенклатура, СпособДок);
				Если НЕ ЗначениеЗаполнено(НазнИсп) И ЗначениеЗаполнено(СпособДок) Тогда
					// Автостворення прямо під час заповнення (рішення заказчика 2026-08-25) —
					// раніше рядок лишався без призначення до окремого кроку «створити картки».
					НазнИсп = НайтиИлиСоздатьНазначение(КэшНазнИсп, СтрД.Номенклатура, СпособДок, Результат);
				КонецЕсли;
				Если ЗначениеЗаполнено(НазнИсп) Тогда
					НС.НазначениеИспользования = НазнИсп;
				Иначе
					Результат.БезНазначення = Результат.БезНазначення + 1;
					ДодатиПаруБезПризначення(Результат, СтрД.Номенклатура, СпособДок);
				КонецЕсли;
			Иначе
				НС.Сумма = СтрД.Сумма; // у МалоценныеАктивы нет реквизита Сумма
			КонецЕсли;

			ЕдиницаИзмерения = СтрД.Номенклатура.БазоваяЕдиницаИзмерения;
			Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
				НС.ЕдиницаИзмерения = ЕдиницаИзмерения;
			Иначе
				Результат.БезЕдиниці = Результат.БезЕдиниці + 1;
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ДокСсылка,
					"Не задана базова одиниця виміру для номенклатури: " + Строка(СтрД.Номенклатура));
			КонецЕсли;
		КонецЦикла;
		Если ТабЧасть.Количество() = 0 Тогда
			// Поточний розрахунок не дав документу жодного рядка: ТЧ чистимо, а ПРОВЕДЕНИЙ
			// документ РОЗПРОВОДИМО — інакше в обліку залишились би рухи за старим складом
			// при порожній табличній частині.
			Если ДокОбъект.Проведен Тогда
				ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Сообщить(СтрШаблон("Документ %1 очищено і РОЗПРОВЕДЕНО: за поточним розрахунком рядків для нього немає.",
					Строка(ДокСсылка)));
			Иначе
				ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
				Сообщить(СтрШаблон("Документ %1 очищено: за поточним розрахунком рядків для нього немає.",
					Строка(ДокСсылка)));
			КонецЕсли;
			Результат.Очищено = Результат.Очищено + 1;
		Иначе
			// Цикл будинку: дата документа — за регламентною сіткою (D/M), якщо визначено дату відвантаження.
			ПлановаДата = ПлановаДатаЦільовогоДокумента(ДокОбъект.Склад, ЭтоМалоценка, ДокОбъект.ПоНорме);
			Если ЗначениеЗаполнено(ПлановаДата) И ДокОбъект.Дата <> ПлановаДата Тогда
				Если ЗначениеЗаполнено(ДокОбъект.Дата) И НачалоМесяца(ДокОбъект.Дата) <> НачалоМесяца(ПлановаДата) Тогда
					Сообщить("Цикл: дату " + Строка(ДокСсылка) + " не змінено — інший місяць ("
						+ Формат(ДокОбъект.Дата, "ДФ=dd.MM.yyyy") + " ≠ " + Формат(ПлановаДата, "ДФ=dd.MM.yyyy") + ").");
				Иначе
					ДокОбъект.Дата = ПлановаДата;
				КонецЕсли;
			КонецЕсли;
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			Результат.Заповнено = Результат.Заповнено + 1;
		КонецЕсли;
	КонецЦикла;
	// Рішення замовника: норма + понаднорма = ОДИН комплект будинку (0,5 + 0,5), лише норма — 1.
	ВирівнятиКількістьКомплектів();

КонецПроцедуры

// Соответствие: документ списания -> значение признака ПоНорме («За нормою»).
// Колонка ДокументПоНормам обеих ТЧ -> Истина, ДокументДодаткова -> Ложь.
// Реквизит ПоНорме есть у обоих видов (КомплектацияНоменклатуры, ПередачаМалоценныхАктивовВЭксплуатацию).
Функция ПризнакиПоНормеДокументов()
	Признаки = Новый Соответствие;
	Для Каждого Стр Из ДокументиКомплектації Цикл
		Если ЗначениеЗаполнено(Стр.ДокументПоНормам) Тогда
			Признаки.Вставить(Стр.ДокументПоНормам, Истина);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ДокументДодаткова) Тогда
			Признаки.Вставить(Стр.ДокументДодаткова, Ложь);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из ДокументиМалоценки Цикл
		Если ЗначениеЗаполнено(Стр.ДокументПоНормам) Тогда
			Признаки.Вставить(Стр.ДокументПоНормам, Истина);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ДокументДодаткова) Тогда
			Признаки.Вставить(Стр.ДокументДодаткова, Ложь);
		КонецЕсли;
	КонецЦикла;
	Возврат Признаки;
КонецФункции

// Соответствие: документ малоценки -> Структура(ФизЛицо, Способ) из ТЧ ДокументиМалоценки.
// Оба документа склада (ПоНормам, Додаткова) наследуют ФизЛицо/Способ строки склада.
Функция МетаданныеДокументовМалоценки()
	Мета = Новый Соответствие;
	Для Каждого Стр Из ДокументиМалоценки Цикл
		Данные = Новый Структура("ФизЛицо, Способ", Стр.ФизЛицо, Стр.СпособОтраженияРасходов);
		Если ЗначениеЗаполнено(Стр.ДокументПоНормам) Тогда
			Мета.Вставить(Стр.ДокументПоНормам, Данные);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ДокументДодаткова) Тогда
			Мета.Вставить(Стр.ДокументДодаткова, Данные);
		КонецЕсли;
	КонецЦикла;
	Возврат Мета;
КонецФункции

// Предзагрузка НазначенияИспользования ОДНИМ запросом (не запрос в цикле).
// Возврат: Соответствие Номенклатура -> Соответствие(Способ -> НазначениеИспользования).
Функция ПодготовитьКэшНазначенийИспользования(СтрокиПоДокументам, ДокМетаМал, ТипМалоценки)
	Кэш = Новый Соответствие;
	Номенклатуры = Новый Массив;
	Способы = Новый Массив;
	Для Каждого КЗ Из СтрокиПоДокументам Цикл
		Если ТипЗнч(КЗ.Ключ) <> ТипМалоценки Тогда
			Продолжить;
		КонецЕсли;
		Мета = ДокМетаМал.Получить(КЗ.Ключ);
		Если Мета = Неопределено Или НЕ ЗначениеЗаполнено(Мета.Способ) Тогда
			Продолжить;
		КонецЕсли;
		Способы.Добавить(Мета.Способ);
		Для Каждого СтрД Из КЗ.Значение Цикл
			Номенклатуры.Добавить(СтрД.Номенклатура);
		КонецЦикла;
	КонецЦикла;
	Если Номенклатуры.Количество() = 0 Или Способы.Количество() = 0 Тогда
		Возврат Кэш;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ном", Номенклатуры);
	Запрос.УстановитьПараметр("Способы", Способы);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НИ.Владелец КАК Номенклатура,
	|	НИ.СпособОтраженияРасходов КАК Способ,
	|	НИ.Ссылка КАК Назначение
	|ИЗ
	|	Справочник.НазначенияИспользования КАК НИ
	|ГДЕ
	|	НЕ НИ.ПометкаУдаления
	|	И НИ.Владелец В (&Ном)
	|	И НИ.СпособОтраженияРасходов В (&Способы)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПоСпособу = Кэш.Получить(Выборка.Номенклатура);
		Если ПоСпособу = Неопределено Тогда
			ПоСпособу = Новый Соответствие;
			Кэш.Вставить(Выборка.Номенклатура, ПоСпособу);
		КонецЕсли;
		Если ПоСпособу.Получить(Выборка.Способ) = Неопределено Тогда // первый — устойчиво к дублям
			ПоСпособу.Вставить(Выборка.Способ, Выборка.Назначение);
		КонецЕсли;
	КонецЦикла;
	Возврат Кэш;
КонецФункции

// Поиск НазначенияИспользования в кэше по (Номенклатура, Способ).
Функция НайтиНазначениеИспользования(Кэш, Номенклатура, Способ)
	Если НЕ ЗначениеЗаполнено(Способ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПоСпособу = Кэш.Получить(Номенклатура);
	Если ПоСпособу = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ПоСпособу.Получить(Способ);
КонецФункции

// Автостворення «Призначення використання» під час заповнення: промах кешу + заповнений
// Спосіб -> страховка-пошук у базі, далі створення карткою-ядром (СоздатьКарточкуПризначення).
// Успіх кладеться в кеш — повторні рядки тієї ж номенклатури отримують ту саму картку.
// Помилка створення НЕ валить пакет: рядок іде старим шляхом БезНазначення, деталі в журналі.
Функция НайтиИлиСоздатьНазначение(Кэш, Номенклатура, Способ, Результат)
	НазнИсп = НайтиПризначенняЗаСпособом(Номенклатура, Способ);
	Если НЕ ЗначениеЗаполнено(НазнИсп) Тогда
		Попытка
			НазнИсп = СоздатьКарточкуПризначення(Номенклатура, Способ);
			Результат.СтвореноПризначень = Результат.СтвореноПризначень + 1;
			Сообщить(СтрШаблон("Створено «Призначення використання»: %1 / %2 (МШП, строк 12 міс.).",
				Строка(Номенклатура), Строка(Способ)));
			ЗаписьЖурналаРегистрации("РасчетКомплектаций.Створення призначень використання",
				УровеньЖурналаРегистрации.Информация, , ,
				"Автостворено при заповненні: " + Строка(Номенклатура) + " / " + Строка(Способ));
		Исключение
			ЗаписьЖурналаРегистрации("РасчетКомплектаций.Створення призначень використання",
				УровеньЖурналаРегистрации.Ошибка, , ,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	ПоСпособу = Кэш.Получить(Номенклатура);
	Если ПоСпособу = Неопределено Тогда
		ПоСпособу = Новый Соответствие;
		Кэш.Вставить(Номенклатура, ПоСпособу);
	КонецЕсли;
	ПоСпособу.Вставить(Способ, НазнИсп);
	Возврат НазнИсп;
КонецФункции

Функция НовыйРезультатЗаполнения()
	Результат = Новый Структура;
	Результат.Вставить("Заповнено", 0);
	// Очищено — цільові документи, яким ПОТОЧНИЙ розрахунок не дав жодного рядка:
	// їх ТЧ чиститься, проведені — розпроводяться (див. СформироватьДокументыПоСоответствию).
	Результат.Вставить("Очищено", 0);
	// СтвореноПризначень — картки «Призначення використання», автостворені при заповненні
	// (НайтиИлиСоздатьНазначение): МШП, строк 12, спосіб — з ТЧ ДокументиМалоценки.
	Результат.Вставить("СтвореноПризначень", 0);
	Результат.Вставить("Пропущено", 0);
	Результат.Вставить("БезЕдиниці", 0);
	Результат.Вставить("БезНазначення", 0);
	// Пари {Номенклатура, Способ} без НазначениеИспользования — без них такий рядок
	// валить типове проведення малоцінки («Значение не является значением
	// объектного типа (Забалансовый)»), а лічильник не каже, ЩО саме чинити.
	// Спосіб потрібен, бо картка створюється саме під нього.
	Результат.Вставить("НоменклатуриБезПризначення", Новый Массив);
	Результат.Вставить("Помилки", Новый Массив);
	Возврат Результат;
КонецФункции

// Перетворює рядки аналізу (форм-VT або об'єкт-ТЧ) у ТаблицаЗначений для зовнішнього набору СКД.
// Коди номенклатури одним запитом: колонка «Код» друкованої форми для цеху — ключ
// зворотного завантаження коментарів (імена номенклатури мають дублікати, код у межах
// розрахунку практично унікальний, решту неоднозначності ловить протокол завантаження).
Функция КодиНоменклатуриДляДаних(ДанныеАнализа)
	Результат = Новый Соответствие;
	Унікальні = Новый Соответствие;
	Для Каждого Стр Из ДанныеАнализа Цикл
		Если ЗначениеЗаполнено(Стр.Номенклатура) Тогда
			Унікальні.Вставить(Стр.Номенклатура, Истина);
		КонецЕсли;
	КонецЦикла;
	Если Унікальні.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Номенклатури = Новый Массив;
	Для Каждого КлючЗначение Из Унікальні Цикл
		Номенклатури.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Ссылка КАК Ссылка,
	|	Н.Код КАК Код
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	Н.Ссылка В (&Номенклатура)";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатури);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, СокрЛП(Выборка.Код));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ДанныеВТаблицуПланФакт(ДанныеАнализа)
	КодиНоменклатури = КодиНоменклатуриДляДаних(ДанныеАнализа);
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Этап");
	ТЗ.Колонки.Добавить("ОбщееНазвание");
	ТЗ.Колонки.Добавить("Номенклатура");
	ТЗ.Колонки.Добавить("Код");
	ТЗ.Колонки.Добавить("Единица");
	ТЗ.Колонки.Добавить("ЕдиницаСС");
	ТЗ.Колонки.Добавить("ЕдиницаЕдина");
	ТЗ.Колонки.Добавить("Норма");
	ТЗ.Колонки.Добавить("НормаНоменкл");
	ТЗ.Колонки.Добавить("Остаток");
	ТЗ.Колонки.Добавить("ВНорме");
	ТЗ.Колонки.Добавить("ПонадНорму");
	ТЗ.Колонки.Добавить("Экономия");
	ТЗ.Колонки.Добавить("НормаСумма");
	ТЗ.Колонки.Добавить("НормаСуммаНоменкл");
	ТЗ.Колонки.Добавить("СуммаОстатка");
	ТЗ.Колонки.Добавить("ВНормеСумма");
	ТЗ.Колонки.Добавить("ПонадНормуСумма");
	ТЗ.Колонки.Добавить("ЕкономіяСума");
	Для Каждого Стр Из ДанныеАнализа Цикл
		Н = ТЗ.Добавить();
		Н.Этап = Стр.Этап;
		Н.ОбщееНазвание = Стр.ОбщееНазвание;
		Н.Номенклатура = Стр.Номенклатура;
		КодНоменклатури = КодиНоменклатури.Получить(Стр.Номенклатура);
		Н.Код = ?(КодНоменклатури = Неопределено, "", КодНоменклатури);
		Н.Единица = Строка(Стр.Единица);
		Н.ЕдиницаСС = Строка(Стр.ЕдиницаСС);
		Н.ЕдиницаЕдина = ?(ЗначениеЗаполнено(Стр.ЕдиницаСС), Строка(Стр.ЕдиницаСС), Строка(Стр.Единица));
		Н.Норма = Стр.Норма;
		Н.НормаНоменкл = Стр.НормаНоменкл;
		Н.Остаток = Стр.Остаток;
		Н.ВНорме = Стр.ВНорме;
		Н.ПонадНорму = Стр.ПонадНорму;
		Н.Экономия = Стр.Экономия;
		Н.НормаСумма = Стр.НормаСумма;
		Н.НормаСуммаНоменкл = Стр.НормаСуммаНоменкл;
		Н.СуммаОстатка = Стр.СуммаОстатка;
		Н.ВНормеСумма = Стр.ВНормеСумма;
		Н.ПонадНормуСумма = Стр.ПонадНормуСумма;
		Н.ЕкономіяСума = Стр.ЕкономіяСума;
	КонецЦикла;
	Возврат ТЗ;
КонецФункции

// Фаза 16: додає рядок-фрагмент (Этап×картка) у ТЗ по-етапного звіту; реєструє перший рядок групи (Еталон,Этап).
Функция ДодатиФрагментПоЭтапам(ТЗ, ГрупаПерший, БезЭтапу, ЭтапКлюч, Ном, Агр, ЕдЄдина, Коеф)
	Рядок = ТЗ.Добавить();
	Рядок.Этап = ?(ЭтапКлюч = БезЭтапу, Неопределено, ЭтапКлюч);
	Рядок.ОбщееНазвание = Агр.ОбщееНазвание;
	Рядок.Номенклатура = Ном;
	Рядок.Единица = Строка(Агр.Единица);
	Рядок.ЕдиницаСС = Строка(Агр.ЕдиницаСС);
	Рядок.ЕдиницаЕдина = ЕдЄдина;
	Рядок.Остаток = Агр.Остаток * Коеф;
	Рядок.СуммаОстатка = Агр.СуммаОстатка * Коеф;
	Рядок.ВНорме = Агр.ВНорме * Коеф;
	Рядок.ВНормеСумма = Агр.ВНормеСумма * Коеф;
	Рядок.ПонадНорму = Агр.ПонадНорму * Коеф;
	Рядок.ПонадНормуСумма = Агр.ПонадНормуСумма * Коеф;
	Рядок.НормаНоменкл = Агр.НормаНоменкл * Коеф;
	Рядок.НормаСуммаНоменкл = Агр.НормаСуммаНоменкл * Коеф;
	Рядок.Экономия = 0;
	Рядок.ЕкономіяСума = 0;
	ГрупиЕт = ГрупаПерший.Получить(Агр.ОбщееНазвание);
	Если ГрупиЕт = Неопределено Тогда
		ГрупиЕт = Новый Соответствие;
		ГрупаПерший.Вставить(Агр.ОбщееНазвание, ГрупиЕт);
	КонецЕсли;
	Если ГрупиЕт.Получить(ЭтапКлюч) = Неопределено Тогда
		ГрупиЕт.Вставить(ЭтапКлюч, Рядок);
	КонецЕсли;
	Возврат Рядок;
КонецФункции

// Фаза 16: ТЗ для звіту «за етапами» з КОРЕКТНОЮ по-етапною розшивкою (Этап×Еталон):
// норма — реальна по-етапна з СС; факт/ВНорме/Понад картки розкидано ∝ по-етапній нормі;
// економія по (еталон,этап) ∝ нормі еталону. Тільки цей звіт (решта — ДанныеВТаблицуПланФакт).
// Валідовано Python-прототипом (спека Фаза 16, інваріанти Σфрагментів=Σкарток).
Функция ДанныеПоЭтапам(ДанныеАнализа)
	БезЭтапу = "__БЕЗЭТАПУ__";
	Нормы = ПолучитьНормы();

	// 1. Агрегація рядків по картці + економія по еталону.
	ПоКартці = Новый Соответствие;
	ПорядокКарток = Новый Массив;
	ЕкономіяЕталона = Новый Соответствие;
	Для Каждого Стр Из ДанныеАнализа Цикл
		Агр = ПоКартці.Получить(Стр.Номенклатура);
		Если Агр = Неопределено Тогда
			Агр = Новый Структура("ОбщееНазвание, Единица, ЕдиницаСС, Остаток, СуммаОстатка, ВНорме, ВНормеСумма, ПонадНорму, ПонадНормуСумма, НормаНоменкл, НормаСуммаНоменкл",
				Стр.ОбщееНазвание, Стр.Единица, Стр.ЕдиницаСС, 0, 0, 0, 0, 0, 0, 0, 0);
			ПоКартці.Вставить(Стр.Номенклатура, Агр);
			ПорядокКарток.Добавить(Стр.Номенклатура);
		КонецЕсли;
		Агр.Остаток = Агр.Остаток + Стр.Остаток;
		Агр.СуммаОстатка = Агр.СуммаОстатка + Стр.СуммаОстатка;
		Агр.ВНорме = Агр.ВНорме + Стр.ВНорме;
		Агр.ВНормеСумма = Агр.ВНормеСумма + Стр.ВНормеСумма;
		Агр.ПонадНорму = Агр.ПонадНорму + Стр.ПонадНорму;
		Агр.ПонадНормуСумма = Агр.ПонадНормуСумма + Стр.ПонадНормуСумма;
		Агр.НормаНоменкл = Агр.НормаНоменкл + Стр.НормаНоменкл;
		Агр.НормаСуммаНоменкл = Агр.НормаСуммаНоменкл + Стр.НормаСуммаНоменкл;
		ЕЕ = ЕкономіяЕталона.Получить(Стр.ОбщееНазвание);
		Если ЕЕ = Неопределено Тогда
			ЕЕ = Новый Структура("Экономия, ЕкономіяСума", 0, 0);
			ЕкономіяЕталона.Вставить(Стр.ОбщееНазвание, ЕЕ);
		КонецЕсли;
		ЕЕ.Экономия = ЕЕ.Экономия + Стр.Экономия;
		ЕЕ.ЕкономіяСума = ЕЕ.ЕкономіяСума + Стр.ЕкономіяСума;
	КонецЦикла;

	ТЗ = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Этап,ОбщееНазвание,Номенклатура,Единица,ЕдиницаСС,ЕдиницаЕдина,Норма,НормаНоменкл,Остаток,ВНорме,ПонадНорму,Экономия,НормаСумма,НормаСуммаНоменкл,СуммаОстатка,ВНормеСумма,ПонадНормуСумма,ЕкономіяСума", ",") Цикл
		ТЗ.Колонки.Добавить(Имя);
	КонецЦикла;
	ГрупаПерший = Новый Соответствие;

	// 2. Фрагменти по (Этап, картка): факт ∝ по-етапній нормі; норма = реальна по-етапна.
	Для Каждого Ном Из ПорядокКарток Цикл
		Агр = ПоКартці.Получить(Ном);
		ЕдЄдина = ?(ЗначениеЗаполнено(Агр.ЕдиницаСС), Строка(Агр.ЕдиницаСС), Строка(Агр.Единица));
		СтадіїКартки = Нормы.НормаКарткаЭтап.Получить(Ном);
		СумаКол = 0;
		Если СтадіїКартки <> Неопределено Тогда
			Для Каждого КЗ Из СтадіїКартки Цикл
				СумаКол = СумаКол + КЗ.Значение.Кол;
			КонецЦикла;
		КонецЕсли;
		Если СтадіїКартки <> Неопределено И СумаКол > 0 Тогда
			Для Каждого КЗ Из СтадіїКартки Цикл
				Рядок = ДодатиФрагментПоЭтапам(ТЗ, ГрупаПерший, БезЭтапу, КЗ.Ключ, Ном, Агр, ЕдЄдина, КЗ.Значение.Кол / СумаКол);
				Рядок.НормаНоменкл = КЗ.Значение.Кол;
				Рядок.НормаСуммаНоменкл = КЗ.Значение.Сум;
			КонецЦикла;
		Иначе
			ЭтапКл = Нормы.ЭтапЭталон.Получить(Агр.ОбщееНазвание);
			Если ЭтапКл = Неопределено Тогда
				ЭтапКл = БезЭтапу;
			КонецЕсли;
			ДодатиФрагментПоЭтапам(ТЗ, ГрупаПерший, БезЭтапу, ЭтапКл, Ном, Агр, ЕдЄдина, 1);
		КонецЕсли;
	КонецЦикла;

	// 3. Економія по (еталон, этап) ∝ по-етапній нормі; резидуум округлення -> перший рядок групи.
	Для Каждого ЕЗ Из ЕкономіяЕталона Цикл
		ЕК = ЕЗ.Значение;
		Если ЕК.Экономия = 0 И ЕК.ЕкономіяСума = 0 Тогда
			Продолжить;
		КонецЕсли;
		ГрупиЕт = ГрупаПерший.Получить(ЕЗ.Ключ);
		Если ГрупиЕт = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтЕт = Нормы.НормаЭталонЭтап.Получить(ЕЗ.Ключ);
		СумаКолЕт = 0;
		Если СтЕт <> Неопределено Тогда
			Для Каждого КЗ Из СтЕт Цикл
				СумаКолЕт = СумаКолЕт + КЗ.Значение.Кол;
			КонецЦикла;
		КонецЕсли;
		РозданоЕк = 0;
		РозданоЕкС = 0;
		ПершийРядок = Неопределено;
		Для Каждого ГЗ Из ГрупиЕт Цикл
			ПершийРядок = ГЗ.Значение;
			Прервать;
		КонецЦикла;
		Если СтЕт <> Неопределено И СумаКолЕт > 0 Тогда
			Для Каждого КЗ Из СтЕт Цикл
				Рядок = ГрупиЕт.Получить(КЗ.Ключ);
				Если Рядок = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Част = Окр(ЕК.Экономия * КЗ.Значение.Кол / СумаКолЕт, 3);
				ЧастС = Окр(ЕК.ЕкономіяСума * КЗ.Значение.Кол / СумаКолЕт, 2);
				Рядок.Экономия = Рядок.Экономия + Част;
				РозданоЕк = РозданоЕк + Част;
				Рядок.ЕкономіяСума = Рядок.ЕкономіяСума + ЧастС;
				РозданоЕкС = РозданоЕкС + ЧастС;
			КонецЦикла;
		КонецЕсли;
		Если ПершийРядок <> Неопределено Тогда
			ПершийРядок.Экономия = ПершийРядок.Экономия + (ЕК.Экономия - РозданоЕк);
			ПершийРядок.ЕкономіяСума = ПершийРядок.ЕкономіяСума + (ЕК.ЕкономіяСума - РозданоЕкС);
		КонецЕсли;
	КонецЦикла;

	Возврат ТЗ;
КонецФункции


// Перезаполняет сохраняемые таблицы списания из анализа. Суммы — БЕЗ НДС (как пойдут в документы).
Процедура ЗаполнитьТаблицыСписания()
	СписаниеПоНормам.Очистить();
	СписаниеСверхНормы.Очистить();
	КоэффНДС = КоэффициентНДС();
	// Норма эталона для справочных колонок СС понаднормы: в анализе она штампуется только
	// на ПЕРВОЙ строке эталона (чтобы Σ не задваивалась) — собираем карту одним проходом.
	НормыЭталонов = Новый Соответствие;
	Для Каждого Стр Из ТабличнаяЧастьОстатков Цикл
		Если ЗначениеЗаполнено(Стр.ОбщееНазвание) И (Стр.Норма <> 0 ИЛИ Стр.НормаСумма <> 0) Тогда
			НормыЭталонов.Вставить(Стр.ОбщееНазвание, Новый Структура("Кол, Сум", Стр.Норма, Стр.НормаСумма));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из ТабличнаяЧастьОстатков Цикл
		Если Стр.ВНорме > 0 Тогда
			ЗаполнитьСтрокуСписания(СписаниеПоНормам.Добавить(), Стр,
				Стр.ВНорме, Окр(Стр.ВНормеСумма / КоэффНДС, 2));
		КонецЕсли;
		Если Стр.ПонадНорму > 0 Тогда
			НоваяСтрокаПонад = СписаниеСверхНормы.Добавить();
			ЗаполнитьСтрокуСписания(НоваяСтрокаПонад, Стр,
				Стр.ПонадНорму, Окр(Стр.ПонадНормуСумма / КоэффНДС, 2));
			НоваяСтрокаПонад.КоличествоКСписанию = ?(КоличествоКСписаниюАвтоматическиЗаполнять, НоваяСтрокаПонад.Количество, 0);
			// Справочно для бухгалтера: сколько этой позиции (эталона) заложено в СС. СС забита
			// С НДС, колонки списания — без НДС, поэтому сумму приводим ÷ КоэффНДС (один раз).
			НормаСС = НормыЭталонов.Получить(Стр.ОбщееНазвание);
			Если НормаСС <> Неопределено Тогда
				НоваяСтрокаПонад.КоличествоСС = НормаСС.Кол;
				НоваяСтрокаПонад.СуммаСС = Окр(НормаСС.Сум / КоэффНДС, 2);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	// Причини цеху живуть у власній ТЧ і переживають перезаповнення таблиць списання.
	ЗастосуватиПричиниЦеху();
КонецПроцедуры

// Общий филлер строки таблицы списания из строки анализа.
Процедура ЗаполнитьСтрокуСписания(НС, СтрАнализа, Количество, Сумма)
	НС.Номенклатура = СтрАнализа.Номенклатура;
	НС.ОбщееНазвание = СтрАнализа.ОбщееНазвание;
	НС.Склад = СтрАнализа.Склад;
	НС.Организация = СтрАнализа.Организация;
	НС.Счет = СтрАнализа.Счет;
	НС.Единица = СтрАнализа.Единица;
	НС.Количество = Количество;
	НС.Сумма = Сумма;
	НС.Цена = ?(Количество > 0, Окр(Сумма / Количество, 2), 0);
КонецПроцедуры

// Данные остатка для ручной строки понаднормы: Счет/Цена(без ПДВ)/Единица/ОбщееНазвание/Остаток
// + справочные КоличествоСС/СуммаСС (норма эталона из СС, сумма приведена к без НДС).
// Неопределено — если остатка нет. Счета — объединение обоих списков (комплектация + малоценка).
Функция ДанныеОстаткаДляСтроки(Номенклатура, Склад) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ост.Счет КАК Счет,
	|	Ост.Организация КАК Организация,
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура).БазоваяЕдиницаИзмерения КАК Единица,
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура).ОбщееНазваниеНоменклатуры КАК ОбщееНазвание,
	|	Ост.КоличествоОстаток КАК Остаток,
	|	Ост.СуммаОстаток КАК СуммаОстатка
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&НаДату, Счет В ИЕРАРХИИ (&Счета), , ) КАК Ост
	|ГДЕ
	|	Ост.КоличествоОстаток > 0
	|	И ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура) = &Номенклатура
	|	И ВЫРАЗИТЬ(Ост.Субконто3 КАК Справочник.Склады) = &Склад
	|	И (&БезФильтраОрганизаций ИЛИ Ост.Организация В (&Организации))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остаток УБЫВ";
	ОрганизацииМассив = ОрганизацииСписком();
	Запрос.УстановитьПараметр("НаДату", ?(ЗначениеЗаполнено(Период), КонецДня(Период), КонецДня(ТекущаяДата())));
	Запрос.УстановитьПараметр("Счета", ВсеСчетаСписком());
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Организации", ОрганизацииМассив);
	Запрос.УстановитьПараметр("БезФильтраОрганизаций", ОрганизацииМассив.Количество() = 0);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура("Счет, Единица, ОбщееНазвание, Остаток, Цена, Организация");
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Результат.Цена = ?(Выборка.Остаток > 0, Окр(Выборка.СуммаОстатка / Выборка.Остаток, 2), 0);
	// Справочно: норма эталона из СС (тот же штамп на первой строке эталона,
	// что и в ЗаполнитьТаблицыСписания) — для ручных строк понаднормы.
	Результат.Вставить("КоличествоСС", 0);
	Результат.Вставить("СуммаСС", 0);
	Если ЗначениеЗаполнено(Результат.ОбщееНазвание) Тогда
		Для Каждого СтрАнализа Из ТабличнаяЧастьОстатков Цикл
			Если СтрАнализа.ОбщееНазвание = Результат.ОбщееНазвание
				И (СтрАнализа.Норма <> 0 ИЛИ СтрАнализа.НормаСумма <> 0) Тогда
				Результат.КоличествоСС = СтрАнализа.Норма;
				Результат.СуммаСС = Окр(СтрАнализа.НормаСумма / КоэффициентНДС(), 2);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Другие документы-расчёты по той же спецификации, тому же дню остатков и с пересечением складов.
Функция НайтиДубликатыРасчета() Экспорт
	Дубли = Новый Массив;
	СкладыМассив = СкладыСписком();
	Если СкладыМассив.Количество() = 0 ИЛИ НЕ ЗначениеЗаполнено(Спецификация) Тогда
		Возврат Дубли;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РасчетКомплектаций КАК Док
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасчетКомплектаций.СкладыОстатков КАК Склады
	|		ПО Склады.Ссылка = Док.Ссылка
	|ГДЕ
	|	НЕ Док.ПометкаУдаления
	|	И Док.Ссылка <> &Ссылка
	|	И Док.Спецификация = &Спецификация
	|	И Док.Период МЕЖДУ &НачалоДня И &КонецДня
	|	И Склады.Склад В (&Склады)";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Спецификация", Спецификация);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(Период));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(Период));
	Запрос.УстановитьПараметр("Склады", СкладыМассив);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Дубли.Добавить(Выборка.Ссылка);
	КонецЦикла;
	Возврат Дубли;
КонецФункции

// «Акт на списання понаднормових матеріалів» — программный ТабДок по ТЧ СписаниеСверхНормы.
// АКТ (ПЛАН) — «що і на які гроші збираємось списати».
//
// Рядки — з ТЧ СписаниеСверхНормы, лише де КоличествоКСписанию > 0.
// Ціна — з ТЧ документа: вона вже є середньою по залишках, узятою в момент
// «Розрахувати». Акт-план друкує саме знімок розрахунку; фактичну собівартість
// після проведення показує другий акт (СформироватьПечатьАктФакт).
// Сума = КоличествоКСписанию × ціна ТЧ.
//
// Склад із таблиці прибрано — він у шапці «Склади:». Підпис один — Відповідальний.
Функция СформироватьПечатьАкт() Экспорт

	КолонокВсього = 9;
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;

	НомерСтроки = ВывестиШапкуАкта(ТабДок, "АКТ на списання понаднормових матеріалів (план)",
		КолонокВсього);

	Заголовки = Новый Массив;
	Заголовки.Добавить("№");
	Заголовки.Добавить("Загальна назва");
	Заголовки.Добавить("Номенклатура");
	Заголовки.Добавить("Рахунок");
	Заголовки.Добавить("Одиниця");
	Заголовки.Добавить("Кількість до списання");
	Заголовки.Добавить("Ціна, грн");
	Заголовки.Добавить("Сума, грн");
	Заголовки.Добавить("Причина (обґрунтування)");
	ВывестиСтрокуПечати(ТабДок, НомерСтроки, Заголовки, Истина, Новый Цвет(210, 224, 240), Истина);
	НомерСтроки = НомерСтроки + 1;

	// Сортування «Загальна назва, потім Номенклатура». Виганяємо ТЧ у ТаблицуЗначений
	// і сортуємо в памʼяті — так друк бачить і НЕзбережені правки бухгалтера
	// (запит до ТЧ документа читав би збережений стан).
	СтрокиАкта = СписаниеСверхНормы.Выгрузить();
	ОтсортироватьСтрокиАкта(СтрокиАкта, "ОбщееНазвание", "Номенклатура");

	НомерПП = 0;
	ИтогоКолДоСписания = 0;
	ИтогоСума = 0;
	Для Каждого Стр Из СтрокиАкта Цикл

		Если Стр.КоличествоКСписанию <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Сумма = Окр(Стр.КоличествоКСписанию * Стр.Цена, 2);

		НомерПП = НомерПП + 1;
		Значения = Новый Массив;
		Значения.Добавить(НомерПП);
		Значения.Добавить(Строка(Стр.ОбщееНазвание));
		Значения.Добавить(Строка(Стр.Номенклатура));
		Значения.Добавить(?(ЗначениеЗаполнено(Стр.Счет), Стр.Счет.Код, ""));
		Значения.Добавить(Строка(Стр.Единица));
		Значения.Добавить(Стр.КоличествоКСписанию);
		Значения.Добавить(Окр(Стр.Цена, 2));
		Значения.Добавить(Сумма);
		Значения.Добавить(Стр.Причина);
		ВывестиСтрокуПечати(ТабДок, НомерСтроки, Значения, Ложь);
		ВыровнятьТекстовыеКолонкиАкта(ТабДок, НомерСтроки);

		ИтогоКолДоСписания = ИтогоКолДоСписания + Стр.КоличествоКСписанию;
		ИтогоСума = ИтогоСума + Сумма;
		НомерСтроки = НомерСтроки + 1;

	КонецЦикла;

	Итоги = Новый Массив;
	Итоги.Добавить("Разом");
	Итоги.Добавить("");
	Итоги.Добавить("");
	Итоги.Добавить("");
	Итоги.Добавить("");
	Итоги.Добавить(ИтогоКолДоСписания);
	Итоги.Добавить("");
	Итоги.Добавить(ИтогоСума);
	Итоги.Добавить("");
	ВывестиСтрокуПечати(ТабДок, НомерСтроки, Итоги, Истина, Новый Цвет(232, 232, 232));
	НомерСтроки = НомерСтроки + 2;

	ВывестиПодписьОтветственного(ТабДок, НомерСтроки, КолонокВсього);
	УстановитьШириныКолонокАкта(ТабДок);

	Возврат ТабДок;

КонецФункции

// АКТ (ФАКТ) — «що реально списано за бухобліком».
//
// Джерело — проводки ПРОВЕДЕНИХ документів понаднорми обох сімей. Критерій понаднорми —
// ознака ПоНорме = Ложь (галочка «За нормою» НЕ стоїть), обидві колонки обох ТЧ: та сама
// галочка, за якою звіт «Списання за нормами і понад норму (бухоблік)» ділить факт —
// акт і звіт завжди бачать один склад документів (рішення заказчика 2026-08-25).
// Кількість і Сума — фактичні, з регістру; Ціна = Сума / Кількість.
Функция СформироватьПечатьАктФакт() Экспорт

	КолонокВсього = 9;
	Регистраторы = ДокументыДодатковаПроведенные();
	Если Регистраторы.Количество() = 0 Тогда
		Сообщить("Немає проведених документів «Додаткова» — актом за фактом друкувати нічого.");
		Возврат Неопределено;
	КонецЕсли;

	Данные = ДанныеАктаПоПроводкам(Регистраторы);
	Если Данные.Количество() = 0 Тогда
		Сообщить("У проведених документах «Додаткова» немає проводок за рахунками запасів.");
		Возврат Неопределено;
	КонецЕсли;

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;

	НомерСтроки = ВывестиШапкуАкта(ТабДок,
		"АКТ на списання понаднормових матеріалів (за проведеними документами)", КолонокВсього);

	Заголовки = Новый Массив;
	Заголовки.Добавить("№");
	Заголовки.Добавить("Загальна назва");
	Заголовки.Добавить("Номенклатура");
	Заголовки.Добавить("Рахунок");
	Заголовки.Добавить("Одиниця");
	Заголовки.Добавить("Кількість");
	Заголовки.Добавить("Ціна, грн");
	Заголовки.Добавить("Сума, грн");
	Заголовки.Добавить("Причина (обґрунтування)");
	ВывестиСтрокуПечати(ТабДок, НомерСтроки, Заголовки, Истина, Новый Цвет(210, 224, 240), Истина);
	НомерСтроки = НомерСтроки + 1;

	Причины = ПричиныПоНоменклатуре();

	НомерПП = 0;
	ИтогоКол = 0;
	ИтогоСума = 0;
	Для Каждого Стр Из Данные Цикл
		НомерПП = НомерПП + 1;
		// Сума тут задана регістром, Ціна похідна -> адаптивна точність,
		// інакше дрібна ціна на великій кількості не перемножується.
		Цена = ЦенаСАдаптивнойТочностью(
			?(Стр.Количество <> 0, Стр.Сумма / Стр.Количество, 0), Стр.Количество, Стр.Сумма);
		Причина = Причины.Получить(Стр.Номенклатура);
		Значения = Новый Массив;
		Значения.Добавить(НомерПП);
		Значения.Добавить(Строка(Стр.ОбщееНазвание));
		Значения.Добавить(Строка(Стр.Наименование));
		Значения.Добавить(Стр.КодСчета);
		Значения.Добавить(Стр.Единица);
		Значения.Добавить(Стр.Количество);
		Значения.Добавить(Цена);
		Значения.Добавить(Стр.Сумма);
		Значения.Добавить(?(Причина = Неопределено, "", Причина));
		ВывестиСтрокуПечати(ТабДок, НомерСтроки, Значения, Ложь);
		ВыровнятьТекстовыеКолонкиАкта(ТабДок, НомерСтроки);
		ИтогоКол = ИтогоКол + Стр.Количество;
		ИтогоСума = ИтогоСума + Стр.Сумма;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	Итоги = Новый Массив;
	Итоги.Добавить("Разом");
	Итоги.Добавить("");
	Итоги.Добавить("");
	Итоги.Добавить("");
	Итоги.Добавить("");
	Итоги.Добавить(ИтогоКол);
	Итоги.Добавить("");
	Итоги.Добавить(ИтогоСума);
	Итоги.Добавить("");
	ВывестиСтрокуПечати(ТабДок, НомерСтроки, Итоги, Истина, Новый Цвет(232, 232, 232));
	НомерСтроки = НомерСтроки + 2;

	ВывестиПодписьОтветственного(ТабДок, НомерСтроки, КолонокВсього);
	УстановитьШириныКолонокАкта(ТабДок);

	Возврат ТабДок;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Службові процедури Актів

// Шапка обох Актів: назва + параметри розрахунку. Повертає перший рядок таблиці.
Функция ВывестиШапкуАкта(ТабДок, Название, КолонокВсього)

	Заголовок = ТабДок.Область(1, 1, 1, КолонокВсього);
	Заголовок.Объединить();
	Заголовок.Текст = Название;
	Заголовок.Шрифт = Новый Шрифт(, 14, Истина);
	Заголовок.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;

	НомерСтроки = 3;
	Параметры = Новый Массив;
	Параметры.Добавить("Документ: Розрахунок комплектацій № " + Номер
		+ " від " + Формат(Дата, "ДФ=dd.MM.yyyy"));
	Параметры.Добавить("Організація: " + ОрганизацииСтрокой());
	Параметры.Добавить("Специфікація: " + Строка(Спецификация));
	Параметры.Добавить("Залишки на дату: " + Формат(Период, "ДФ=dd.MM.yyyy"));
	Параметры.Добавить("Склади: " + СкладыСтрокой());
	Для Каждого ТекстПараметра Из Параметры Цикл
		Обл = ТабДок.Область(НомерСтроки, 1, НомерСтроки, КолонокВсього);
		Обл.Объединить();
		Обл.Текст = ТекстПараметра;
		Обл.Шрифт = Новый Шрифт(, 9);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	Возврат НомерСтроки + 1;

КонецФункции

// Підпис у підвалі: тільки Відповідальний (комісія прибрана — рішення замовника).
Процедура ВывестиПодписьОтветственного(ТабДок, НомерСтроки, КолонокВсього)
	Обл = ТабДок.Область(НомерСтроки, 1, НомерСтроки, КолонокВсього);
	Обл.Объединить();
	Обл.Текст = "Відповідальний: ______________________   " + Строка(Ответственный);
	Обл = ТабДок.Область(НомерСтроки + 1, 1, НомерСтроки + 1, КолонокВсього);
	Обл.Объединить();
	Обл.Текст = "                                        (дата, П.І.Б., підпис)";
	Обл.Шрифт = Новый Шрифт(, 8);
КонецПроцедуры

// ВывестиСтрокуПечати вирівнює праворуч усе з 5-ї колонки, а в Акті колонки
// 2-5 (загальна назва, номенклатура, рахунок, одиниця) — текстові.
Процедура ВыровнятьТекстовыеКолонкиАкта(ТабДок, НомерСтроки)
	ТабДок.Область(НомерСтроки, 2, НомерСтроки, 3).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
	ТабДок.Область(НомерСтроки, 4, НомерСтроки, 5).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
КонецПроцедуры

// Ширини колонок. Обидва Акти мають однаковий макет із 9 колонок; різниця лише
// в тому, що в плані 6-та колонка — «Кількість до списання», у факті — «Кількість».
Процедура УстановитьШириныКолонокАкта(ТабДок)
	Ширины = Новый Массив;
	Ширины.Добавить(5);   // №
	Ширины.Добавить(28);  // Загальна назва
	Ширины.Добавить(45);  // Номенклатура
	Ширины.Добавить(10);  // Рахунок
	Ширины.Добавить(10);  // Одиниця
	Ширины.Добавить(16);  // Кількість (до списання)
	Ширины.Добавить(13);  // Ціна
	Ширины.Добавить(15);  // Сума
	Ширины.Добавить(38);  // Причина
	Для К = 0 По Ширины.ВГраница() Цикл
		ТабДок.Область(2, К + 1, 2, К + 1).ШиринаКолонки = Ширины[К];
	КонецЦикла;
КонецПроцедуры


// Сортування рядків Акта: «Загальна назва, потім Номенклатура», за ОБРІЗАНИМИ назвами.
//
// Чому СокрЛП: у довіднику трапляються назви з ведучим пробілом (напр. « Кутики сталеві»).
// Пробіл сортується раніше за літери, і такий рядок стрибає на початок акта — у друку
// пробіл не видно, і виглядає це як зламане сортування. Обрізаємо перед порівнянням.
//
// Сортуємо в BSL, а не в запиті: мова запитів 1С не має функції обрізання рядка.
Процедура ОтсортироватьСтрокиАкта(ТаблицаСтрок, ИмяКолонкиЭталона, ИмяКолонкиНоменклатуры)
	Если ТаблицаСтрок.Колонки.Найти("_СортЭталон") = Неопределено Тогда
		ТаблицаСтрок.Колонки.Добавить("_СортЭталон", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Если ТаблицаСтрок.Колонки.Найти("_СортНоменклатура") = Неопределено Тогда
		ТаблицаСтрок.Колонки.Добавить("_СортНоменклатура", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Для Каждого Стр Из ТаблицаСтрок Цикл
		Стр._СортЭталон = СокрЛП(Строка(Стр[ИмяКолонкиЭталона]));
		Стр._СортНоменклатура = СокрЛП(Строка(Стр[ИмяКолонкиНоменклатуры]));
	КонецЦикла;
	ТаблицаСтрок.Сортировать("_СортЭталон, _СортНоменклатура");
КонецПроцедуры

// Проведені документи понаднорми обох сімей (для Акта-факту).
// Критерій — ознака ПоНорме = Ложь у БУДЬ-ЯКІЙ колонці ТЧ (не колонка «Додаткова»!):
// та сама галочка, за якою звіт «Списання за нормами і понад норму» ділить факт.
// Раніше бралась колонка ДокументДодаткова — акт і звіт розходились, коли документ
// стояв у колонці «По нормам» без галочки (кейс ІБ00-000135, 2026-08-25).
Функция ДокументыДодатковаПроведенные()
	Результат = Новый Массив;
	Известные = Новый Соответствие;
	Таблицы = Новый Массив;
	Таблицы.Добавить(ДокументиКомплектації);
	Таблицы.Добавить(ДокументиМалоценки);
	Для Каждого Таблица Из Таблицы Цикл
		Для Каждого Стр Из Таблица Цикл
			ДобавитьДокументПонаднормы(Результат, Известные, Стр.ДокументПоНормам);
			ДобавитьДокументПонаднормы(Результат, Известные, Стр.ДокументДодаткова);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Кладёт документ в массив акта-факту, если он проведён, БЕЗ галочки «За нормою» и ещё не встречался.
Процедура ДобавитьДокументПонаднормы(Результат, Известные, Док)
	Если ЗначениеЗаполнено(Док) И Док.Проведен И НЕ Док.ПоНорме
		И Известные.Получить(Док) = Неопределено Тогда
		Известные.Вставить(Док, Истина);
		Результат.Добавить(Док);
	КонецЕсли;
КонецПроцедуры

// Факт списання з проводок документів «Додаткова», згорнутий по номенклатурі й рахунку.
// Фільтр «СчетКт заповнений» обовʼязковий: малоцінка пише ще й забалансову Дт МЦ
// на ту саму суму — без фільтра сума подвоюється.
Функция ДанныеАктаПоПроводкам(Регистраторы)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Х.СубконтоКт1 КАК Номенклатура,
	|	Х.СчетКт КАК Счет,
	|	Х.КоличествоКт КАК Количество,
	|	Х.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТСырые
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(, , Регистратор В (&Регистраторы), , ) КАК Х
	|ГДЕ
	|	Х.СчетКт <> ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)
	|	И ТИПЗНАЧЕНИЯ(Х.СубконтоКт1) = ТИП(Справочник.Номенклатура)
	|;
	|
	|ВЫБРАТЬ
	|	С.Номенклатура КАК Номенклатура,
	|	С.Счет КАК Счет,
	|	СУММА(С.Количество) КАК Количество,
	|	СУММА(С.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТСвод
	|ИЗ
	|	ВТСырые КАК С
	|СГРУППИРОВАТЬ ПО
	|	С.Номенклатура,
	|	С.Счет
	|;
	|
	|ВЫБРАТЬ
	|	Д.Номенклатура КАК Номенклатура,
	|	ВЫРАЗИТЬ(Д.Номенклатура КАК Справочник.Номенклатура).ОбщееНазваниеНоменклатуры КАК ОбщееНазвание,
	|	ВЫРАЗИТЬ(Д.Номенклатура КАК Справочник.Номенклатура).ОбщееНазваниеНоменклатуры.Наименование КАК НазваЭталона,
	|	ВЫРАЗИТЬ(Д.Номенклатура КАК Справочник.Номенклатура).Наименование КАК Наименование,
	|	ВЫРАЗИТЬ(Д.Номенклатура КАК Справочник.Номенклатура).БазоваяЕдиницаИзмерения.Наименование КАК Единица,
	|	Д.Счет.Код КАК КодСчета,
	|	ЕСТЬNULL(Д.Количество, 0) КАК Количество,
	|	ЕСТЬNULL(Д.Сумма, 0) КАК Сумма
	|ИЗ
	|	ВТСвод КАК Д";
	Запрос.УстановитьПараметр("Регистраторы", Регистраторы);

	Результат = Запрос.Выполнить().Выгрузить();
	// Сортуємо в BSL, а не в запиті: потрібне порівняння за ОБРІЗАНИМИ назвами,
	// а мова запитів 1С не має функції обрізання рядка.
	ОтсортироватьСтрокиАкта(Результат, "НазваЭталона", "Наименование");
	Возврат Результат;

КонецФункции

// Причини з ТЧ СписаниеСверхНормы за номенклатурою — проводки їх не несуть.
Функция ПричиныПоНоменклатуре()
	Результат = Новый Соответствие;
	Для Каждого Стр Из СписаниеСверхНормы Цикл
		Если ЗначениеЗаполнено(Стр.Номенклатура) И ЗначениеЗаполнено(Стр.Причина)
			И Результат.Получить(Стр.Номенклатура) = Неопределено Тогда
			Результат.Вставить(Стр.Номенклатура, Стр.Причина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Кэш единиц эталонов ОДНИМ запросом: ОбщееНазвание -> ОбщиеНазванияНоменклатуры.Единица.
Функция ЕдиницыЭталонов(СтрокиАнализа)
	Кэш = Новый Соответствие;
	Відомі = Новый Соответствие;
	Эталоны = Новый Массив;
	Для Каждого Стр Из СтрокиАнализа Цикл
		Если ЗначениеЗаполнено(Стр.ОбщееНазвание) И Відомі.Получить(Стр.ОбщееНазвание) = Неопределено Тогда
			Відомі.Вставить(Стр.ОбщееНазвание, Истина);
			Эталоны.Добавить(Стр.ОбщееНазвание);
		КонецЕсли;
	КонецЦикла;
	Если Эталоны.Количество() = 0 Тогда
		Возврат Кэш;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОН.Ссылка КАК Эталон,
	|	ОН.Единица КАК Единица
	|ИЗ
	|	Справочник.ОбщиеНазванияНоменклатуры КАК ОН
	|ГДЕ
	|	ОН.Ссылка В (&Эталоны)";
	Запрос.УстановитьПараметр("Эталоны", Эталоны);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Кэш.Вставить(Выборка.Эталон, Выборка.Единица);
	КонецЦикла;
	Возврат Кэш;
КонецФункции

// Правило розбіжності одиниць (рішення замовника): серед ЗАПОВНЕНИХ одиниць
// {норма СС, залишки, еталон} є різні, АБО еталон заповнений, а його одиниця порожня.
// Порівняння — за СокрЛП(Наименование), НЕ за посиланням: у класифікаторі є дублі
// однієї одиниці (" шт" і "шт"), правити всі документи замовник не хоче.
Функция ЕстьРасхождениеЕдиниц(ЕдиницаСС, ЕдиницаОстатков, ЕдиницаЭталона, ЕстьЭталон)
	Если ЕстьЭталон И НЕ ЗначениеЗаполнено(ЕдиницаЭталона) Тогда
		Возврат Истина;
	КонецЕсли;
	Единицы = Новый Массив;
	Единицы.Добавить(ЕдиницаСС);
	Единицы.Добавить(ЕдиницаОстатков);
	Единицы.Добавить(ЕдиницаЭталона);
	Первая = Неопределено;
	Для Каждого Ед Из Единицы Цикл
		Если НЕ ЗначениеЗаполнено(Ед) Тогда
			Продолжить;
		КонецЕсли;
		ИмяЕдиницы = СокрЛП(Ед.Наименование);
		Если Первая = Неопределено Тогда
			Первая = ИмяЕдиницы;
		ИначеЕсли ИмяЕдиницы <> Первая Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// «Розбіжності одиниць (норми <-> фактичний прихід)» — програмний ТабДок.
// Лише еталони, де є хоч один рядок з РасхождениеЕдиниц; картки згорнуті за номенклатурою.
Функция СформироватьПечатьРозбіжностіОдиниць() Экспорт
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.АвтоМасштаб = Истина;

	Заголовок = ТабДок.Область(1, 1, 1, 5);
	Заголовок.Объединить();
	Заголовок.Текст = "Розбіжності одиниць (норми - фактичний прихід)";
	Заголовок.Шрифт = Новый Шрифт(, 14, Истина);
	Заголовок.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;

	НомерСтроки = 3;
	Параметры = Новый Массив;
	Параметры.Добавить("Документ: Розрахунок комплектацій № " + Номер + " від " + Формат(Дата, "ДФ=dd.MM.yyyy"));
	Параметры.Добавить("Організація: " + ОрганизацииСтрокой());
	Параметры.Добавить("Специфікація: " + Строка(Спецификация));
	Параметры.Добавить("Залишки на дату: " + Формат(Период, "ДФ=dd.MM.yyyy"));
	Параметры.Добавить("Склади: " + СкладыСтрокой());
	Для Каждого ТекстПараметра Из Параметры Цикл
		Обл = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 5);
		Обл.Объединить();
		Обл.Текст = ТекстПараметра;
		Обл.Шрифт = Новый Шрифт(, 9);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;

	Заголовки = Новый Массив;
	Заголовки.Добавить("Загальна назва");
	Заголовки.Добавить("Залишок");
	Заголовки.Добавить("Одиниця виміру залишків");
	Заголовки.Добавить("Згідно з СС");
	Заголовки.Добавить("Одиниця виміру СС");
	ВывестиСтрокуПечати(ТабДок, НомерСтроки, Заголовки, Истина, Новый Цвет(210, 224, 240));
	НомерСтроки = НомерСтроки + 1;

	ЕдиницыЭталона = ЕдиницыЭталонов(ТабличнаяЧастьОстатков);
	Итоги = Новый Структура("Еталони, Номенклатури", 0, 0);

	ТекЭталон = Неопределено;
	ПервыйРяд = Истина;
	КарткиЕталона = Неопределено;
	ПорядокКарток = Неопределено;
	ЕстьРозбіжність = Ложь;
	Для Каждого Стр Из ТабличнаяЧастьОстатков Цикл
		Если ПервыйРяд ИЛИ Стр.ОбщееНазвание <> ТекЭталон Тогда
			Если НЕ ПервыйРяд Тогда
				НомерСтроки = ВывестиБлокЕталона(ТабДок, НомерСтроки, ТекЭталон, КарткиЕталона,
					ПорядокКарток, ЕстьРозбіжність, ЕдиницыЭталона, Итоги);
			КонецЕсли;
			ТекЭталон = Стр.ОбщееНазвание;
			КарткиЕталона = Новый Соответствие;
			ПорядокКарток = Новый Массив;
			ЕстьРозбіжність = Ложь;
			ПервыйРяд = Ложь;
		КонецЕсли;
		Агрегат = КарткиЕталона.Получить(Стр.Номенклатура);
		Если Агрегат = Неопределено Тогда
			Агрегат = Новый Структура("Залишок, Единица, ЕдиницаСС, Норма, Розбіжність",
				0, Стр.Единица, Стр.ЕдиницаСС, 0, Ложь);
			КарткиЕталона.Вставить(Стр.Номенклатура, Агрегат);
			ПорядокКарток.Добавить(Стр.Номенклатура);
		КонецЕсли;
		Агрегат.Залишок = Агрегат.Залишок + Стр.Остаток;
		Агрегат.Норма = Агрегат.Норма + Стр.НормаНоменкл; // штамп 1х на номенклатуру — не задвоюється
		Если Стр.РасхождениеЕдиниц Тогда
			Агрегат.Розбіжність = Истина;
			ЕстьРозбіжність = Истина;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ПервыйРяд Тогда
		НомерСтроки = ВывестиБлокЕталона(ТабДок, НомерСтроки, ТекЭталон, КарткиЕталона,
			ПорядокКарток, ЕстьРозбіжність, ЕдиницыЭталона, Итоги);
	КонецЕсли;

	НомерСтроки = НомерСтроки + 1;
	Итог = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 5);
	Итог.Объединить();
	Итог.Текст = "Еталонів з розбіжностями: " + Итоги.Еталони
		+ ", номенклатур з розбіжністю: " + Итоги.Номенклатури;
	Итог.Шрифт = Новый Шрифт(, 10, Истина);

	ТабДок.Область(2, 1, 2, 1).ШиринаКолонки = 50;
	ТабДок.Область(2, 2, 2, 2).ШиринаКолонки = 12;
	ТабДок.Область(2, 3, 2, 3).ШиринаКолонки = 24;
	ТабДок.Область(2, 4, 2, 4).ШиринаКолонки = 12;
	ТабДок.Область(2, 5, 2, 5).ШиринаКолонки = 24;

	Возврат ТабДок;
КонецФункции

// Рендер блока еталона у друку розбіжностей (якщо у еталона є розбіжність). Повертає новий номер рядка.
Функция ВывестиБлокЕталона(ТабДок, НомерСтроки, Эталон, Картки, Порядок, ЕстьРозбіжність, ЕдиницыЭталона, Итоги)
	Если НЕ ЕстьРозбіжність Тогда
		Возврат НомерСтроки;
	КонецЕсли;
	Итоги.Еталони = Итоги.Еталони + 1;
	ЕдЭталона = ЕдиницыЭталона.Получить(Эталон);
	ЕдЗаполнена = ЗначениеЗаполнено(ЕдЭталона);
	НазваЕталона = ?(ЗначениеЗаполнено(Эталон), Строка(Эталон), "<без еталона>")
		+ ?(ЕдЗаполнена, " [од. еталона: " + Строка(ЕдЭталона) + "]", " [!!! од. еталона не заповнена]");
	СумЗалишок = 0;
	СумНорма = 0;
	Для Каждого Ном Из Порядок Цикл
		Агр = Картки.Получить(Ном);
		СумЗалишок = СумЗалишок + Агр.Залишок;
		СумНорма = СумНорма + Агр.Норма;
	КонецЦикла;
	Значения = Новый Массив;
	Значения.Добавить(НазваЕталона);
	Значения.Добавить(СумЗалишок);
	Значения.Добавить("");
	Значения.Добавить(СумНорма);
	Значения.Добавить("");
	ВывестиСтрокуПечати(ТабДок, НомерСтроки, Значения, Истина, Новый Цвет(232, 232, 232));
	Если НЕ ЕдЗаполнена Тогда
		ТабДок.Область(НомерСтроки, 1, НомерСтроки, 1).ЦветТекста = Новый Цвет(132, 60, 12);
	КонецЕсли;
	НомерСтроки = НомерСтроки + 1;
	Для Каждого Ном Из Порядок Цикл
		Агр = Картки.Получить(Ном);
		Если Агр.Розбіжність Тогда
			Итоги.Номенклатури = Итоги.Номенклатури + 1;
		КонецЕсли;
		Значения = Новый Массив;
		Значения.Добавить("    " + Строка(Ном));
		Значения.Добавить(Агр.Залишок);
		Значения.Добавить(Строка(Агр.Единица));
		Значения.Добавить(?(Агр.Норма = 0, "", Агр.Норма));
		Значения.Добавить(?(ЗначениеЗаполнено(Агр.ЕдиницаСС), Строка(Агр.ЕдиницаСС), ""));
		ВывестиСтрокуПечати(ТабДок, НомерСтроки, Значения, Ложь);
		Если Агр.Розбіжність Тогда
			ТабДок.Область(НомерСтроки, 3, НомерСтроки, 3).ЦветФона = Новый Цвет(255, 230, 153);
			ТабДок.Область(НомерСтроки, 5, НомерСтроки, 5).ЦветФона = Новый Цвет(255, 230, 153);
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	Возврат НомерСтроки;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// М-29 (див. СформироватьПечатьМ29)

// Кількість логічних колонок М-29 (Excel-еталон має 18 фізичних стовпців, але 5 з них —
// порожні залишки канонічної форми без номерів у рядку нумерації).
Функция КолонокМ29()
	Возврат 13;
КонецФункции

// Дані одного блоку М-29. ІмʼяБлоку: "Комплектація" (ТЧ ДокументиКомплектації) або
// "Малоцінка" (ТЧ ДокументиМалоценки). Повертає Структуру:
//   Строки       — ТаблицаЗначений (Код, Наименование, Единица, Количество, Цена, Сумма)
//   Непроведені  — Массив номерів документів, що не потрапили у звіт
Функция ДанныеМ29ПоБлоку(ИмяБлока)

	Результат = Новый Структура("Строки, Непроведені");
	Результат.Непроведені = Новый Массив;

	ТаблицаДокументов = ?(ИмяБлока = "Малоцінка", ДокументиМалоценки, ДокументиКомплектації);

	Регистраторы = Новый Массив;
	Известные = Новый Соответствие;
	Для Каждого Стр Из ТаблицаДокументов Цикл
		Кандидаты = Новый Массив;
		Кандидаты.Добавить(Стр.ДокументПоНормам);
		Кандидаты.Добавить(Стр.ДокументДодаткова);
		Для Каждого Док Из Кандидаты Цикл
			Если НЕ ЗначениеЗаполнено(Док) ИЛИ Известные.Получить(Док) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Известные.Вставить(Док, Истина);
			Если Док.Проведен Тогда
				Регистраторы.Добавить(Док);
			Иначе
				Результат.Непроведені.Добавить(Строка(Док.Номер));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Регистраторы.Количество() = 0 Тогда
		Результат.Строки = НоваяТаблицаМ29();
		Возврат Результат;
	КонецЕсли;

	// Аналітика доступна ЛИШЕ через віртуальну таблицю ДвиженияССубконто: у основній таблиці
	// регістру полів СубконтоКт1..3 немає. СубконтоКт1 = Номенклатура на ВСІХ рахунках запасів
	// (20/201/205/2051/207/22/221/28/281 — порядок видів субконто скрізь однаковий).
	// Фільтр «СчетКт заповнений» ОБОВʼЯЗКОВИЙ: малоцінка робить подвійні проводки —
	// балансову Дт 231 Кт 221 і забалансову Дт МЦ з порожнім Кт на ту саму суму.
	// Фільтра по кількості НЕМАЄ свідомо: сумова доводка партії (кількість 0, сума <> 0) —
	// легітимна проводка, втрачати її не можна; від ділення на нуль захищає ВЫБОР у ціні.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Х.СубконтоКт1 КАК Номенклатура,
	|	СУММА(Х.КоличествоКт) КАК Количество,
	|	СУММА(Х.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТДанные
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(, , Регистратор В (&Регистраторы), , ) КАК Х
	|ГДЕ
	|	Х.СчетКт <> ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)
	|СГРУППИРОВАТЬ ПО
	|	Х.СубконтоКт1
	|;
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Д.Номенклатура КАК Справочник.Номенклатура).Код КАК Код,
	|	ВЫРАЗИТЬ(Д.Номенклатура КАК Справочник.Номенклатура).Наименование КАК Наименование,
	|	ВЫРАЗИТЬ(Д.Номенклатура КАК Справочник.Номенклатура).БазоваяЕдиницаИзмерения.Наименование КАК Единица,
	|	ЕСТЬNULL(Д.Количество, 0) КАК Количество,
	|	ЕСТЬNULL(Д.Сумма, 0) КАК Сумма,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Д.Количество, 0) <> 0
	|			ТОГДА ЕСТЬNULL(Д.Сумма, 0) / Д.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	ВТДанные КАК Д
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Запрос.УстановитьПараметр("Регистраторы", Регистраторы);

	Результат.Строки = Запрос.Выполнить().Выгрузить();
	Возврат Результат;

КонецФункции

// Порожня таблиця рядків М-29 (коли проведених документів блоку немає).
Функция НоваяТаблицаМ29()
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Код");
	ТЗ.Колонки.Добавить("Наименование");
	ТЗ.Колонки.Добавить("Единица");
	ТЗ.Колонки.Добавить("Количество");
	ТЗ.Колонки.Добавить("Цена");
	ТЗ.Колонки.Добавить("Сумма");
	Возврат ТЗ;
КонецФункции

// Об'єднаний рядок на всю ширину М-29.
Функция ВывестиСтрокуНаВсюШиринуМ29(ТабДок, НомерСтроки, Текст, Шрифт = Неопределено,
	Положение = Неопределено, ПерваяКолонка = 1)
	Обл = ТабДок.Область(НомерСтроки, ПерваяКолонка, НомерСтроки, КолонокМ29());
	Обл.Объединить();
	Обл.Текст = Текст;
	Если Шрифт <> Неопределено Тогда
		Обл.Шрифт = Шрифт;
	КонецЕсли;
	Если Положение <> Неопределено Тогда
		Обл.ГоризонтальноеПоложение = Положение;
	КонецЕсли;
	Возврат НомерСтроки + 1;
КонецФункции

// Шапка М-29: гриф, назва звіту, обʼєкт, двоповерхова шапка таблиці, рядок нумерації 1..13.
// Повертає номер першого рядка даних.
Функция ВывестиШапкуМ29(ТабДок)

	Граница = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	НомерСтроки = 1;

	// Гриф — права частина аркуша (колонки 8..13).
	Обл = ТабДок.Область(НомерСтроки, 8, НомерСтроки, КолонокМ29());
	Обл.Объединить();
	Обл.Текст = "Додаток №3" + Символы.ПС + "до Наказу №_______ від _________________р.";
	НомерСтроки = НомерСтроки + 2;

	Обл = ТабДок.Область(НомерСтроки, 8, НомерСтроки, КолонокМ29());
	Обл.Объединить();
	Обл.Текст = "Форма № М-29/1";
	Обл.Шрифт = Новый Шрифт(, , Истина);
	Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	НомерСтроки = НомерСтроки + 1;

	Обл = ТабДок.Область(НомерСтроки, 8, НомерСтроки, КолонокМ29());
	Обл.Объединить();
	Обл.Текст = """ЗАТВЕРДЖЕНО""";
	Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	НомерСтроки = НомерСтроки + 2;

	Обл = ТабДок.Область(НомерСтроки, 8, НомерСтроки, КолонокМ29());
	Обл.Объединить();
	Обл.Текст = "____________________";
	Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	НомерСтроки = НомерСтроки + 2;

	ПоЦентру = ГоризонтальноеПоложение.Центр;
	НомерСтроки = ВывестиСтрокуНаВсюШиринуМ29(ТабДок, НомерСтроки, "З В І Т", Новый Шрифт(, 14, Истина), ПоЦентру);
	НомерСтроки = ВывестиСтрокуНаВсюШиринуМ29(ТабДок, НомерСтроки,
		"про витрати основних матеріалів у будівництві", Новый Шрифт(, 12, Истина), ПоЦентру);
	НомерСтроки = ВывестиСтрокуНаВсюШиринуМ29(ТабДок, НомерСтроки,
		"в співставленні з виробничими нормами", Новый Шрифт(, 12, Истина), ПоЦентру);
	НомерСтроки = НомерСтроки + 1;

	Если ЗначениеЗаполнено(НаименованиеРаботыМ29) Тогда
		НомерСтроки = ВывестиСтрокуНаВсюШиринуМ29(ТабДок, НомерСтроки, СокрЛП(НаименованиеРаботыМ29),
			Новый Шрифт(, 12, Истина), ПоЦентру);
	КонецЕсли;
	НомерСтроки = ВывестиСтрокуНаВсюШиринуМ29(ТабДок, НомерСтроки, "До Акту № ", , ПоЦентру);

	// Шапка блоків: «Інформація з АВР» (1-6) | «Інформація з 1С» (7-13).
	ЦветБлока = Новый Цвет(210, 224, 240);
	Обл = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 6);
	Обл.Объединить();
	Обл.Текст = "Інформація з АВР";
	Обл.Шрифт = Новый Шрифт(, , Истина);
	Обл.ГоризонтальноеПоложение = ПоЦентру;
	Обл.ЦветФона = ЦветБлока;
	ОбрамитьОбластьМ29(Обл, Граница);

	Обл = ТабДок.Область(НомерСтроки, 7, НомерСтроки, КолонокМ29());
	Обл.Объединить();
	Обл.Текст = "Інформація з 1С";
	Обл.Шрифт = Новый Шрифт(, , Истина);
	Обл.ГоризонтальноеПоложение = ПоЦентру;
	Обл.ЦветФона = ЦветБлока;
	ОбрамитьОбластьМ29(Обл, Граница);
	НомерСтроки = НомерСтроки + 1;

	// Двоповерхова шапка: колонки 1-6 і 13 обʼєднані вертикально, 7-12 під «Матеріали».
	ВерхняяСтрока = НомерСтроки;
	НижняяСтрока = НомерСтроки + 1;

	ЗаголовкиАВР = Новый Массив;
	ЗаголовкиАВР.Добавить("№ п/п");
	ЗаголовкиАВР.Добавить("Найменування робіт");
	ЗаголовкиАВР.Добавить("Од. вим.");
	ЗаголовкиАВР.Добавить("Кіл-ть");
	ЗаголовкиАВР.Добавить("Вартість од. вим.");
	ЗаголовкиАВР.Добавить("Вартість всього вим.");
	Для К = 0 По ЗаголовкиАВР.ВГраница() Цикл
		Обл = ТабДок.Область(ВерхняяСтрока, К + 1, НижняяСтрока, К + 1);
		Обл.Объединить();
		Обл.Текст = ЗаголовкиАВР[К];
		Обл.Шрифт = Новый Шрифт(, , Истина);
		Обл.ГоризонтальноеПоложение = ПоЦентру;
		Обл.ЦветФона = ЦветБлока;
		ОбрамитьОбластьМ29(Обл, Граница);
	КонецЦикла;

	Обл = ТабДок.Область(ВерхняяСтрока, 7, ВерхняяСтрока, 12);
	Обл.Объединить();
	Обл.Текст = "Матеріали";
	Обл.Шрифт = Новый Шрифт(, , Истина);
	Обл.ГоризонтальноеПоложение = ПоЦентру;
	Обл.ЦветФона = ЦветБлока;
	ОбрамитьОбластьМ29(Обл, Граница);

	Обл = ТабДок.Область(ВерхняяСтрока, 13, НижняяСтрока, 13);
	Обл.Объединить();
	Обл.Текст = "Примітка";
	Обл.Шрифт = Новый Шрифт(, , Истина);
	Обл.ГоризонтальноеПоложение = ПоЦентру;
	Обл.ЦветФона = ЦветБлока;
	ОбрамитьОбластьМ29(Обл, Граница);

	Заголовки1С = Новый Массив;
	Заголовки1С.Добавить("Код");
	Заголовки1С.Добавить("Найменування");
	Заголовки1С.Добавить("од. вим.");
	Заголовки1С.Добавить("Кіл-ть");
	Заголовки1С.Добавить("Вартість од. вим.");
	Заголовки1С.Добавить("Вартість всього вим.");
	Для К = 0 По Заголовки1С.ВГраница() Цикл
		Обл = ТабДок.Область(НижняяСтрока, К + 7, НижняяСтрока, К + 7);
		Обл.Текст = Заголовки1С[К];
		Обл.Шрифт = Новый Шрифт(, , Истина);
		Обл.ГоризонтальноеПоложение = ПоЦентру;
		Обл.ЦветФона = ЦветБлока;
		ОбрамитьОбластьМ29(Обл, Граница);
	КонецЦикла;
	НомерСтроки = НижняяСтрока + 1;

	// Рядок нумерації колонок 1..13 — як у бланку.
	Нумерация = Новый Массив;
	Для К = 1 По КолонокМ29() Цикл
		Нумерация.Добавить(К);
	КонецЦикла;
	ВывестиСтрокуПечати(ТабДок, НомерСтроки, Нумерация, Ложь, , Истина);
	НомерСтроки = НомерСтроки + 1;

	ТабДок.ФиксацияСверху = НомерСтроки - 1;

	Возврат НомерСтроки;

КонецФункции

// Рамка по всіх чотирьох сторонах області (властивості .Граница не існує).
Процедура ОбрамитьОбластьМ29(Обл, Граница)
	Обл.ГраницаСверху = Граница;
	Обл.ГраницаСнизу = Граница;
	Обл.ГраницаСлева = Граница;
	Обл.ГраницаСправа = Граница;
КонецПроцедуры

// Рядки одного блоку. ПерваяСтрокаНесетАВР = Истина -> у першому рядку друкуються
// колонки 1-4 блоку «Інформація з АВР» (№ п/п = 1, назва робіт, «шт», 1) — рішення замовника.
// ИтогСуммы — вихідний параметр, накопичує суму блоку.
Функция ВывестиБлокМ29(ТабДок, НомерСтрокиНачало, СтрокиБлока, ПерваяСтрокаНесетАВР, ИтогСуммы)

	НомерСтроки = НомерСтрокиНачало;
	ПерваяСтрока = Истина;

	Для Каждого Стр Из СтрокиБлока Цикл
		Значения = Новый Массив;
		Если ПерваяСтрока И ПерваяСтрокаНесетАВР Тогда
			Значения.Добавить(1);
			Значения.Добавить(СокрЛП(НаименованиеРаботыМ29));
			Значения.Добавить("шт");
			Значения.Добавить(1);
		Иначе
			Значения.Добавить("");
			Значения.Добавить("");
			Значения.Добавить("");
			Значения.Добавить("");
		КонецЕсли;
		Значения.Добавить("");
		Значения.Добавить("");
		Значения.Добавить(Стр.Код);
		Значения.Добавить(Стр.Наименование);
		Значения.Добавить(Стр.Единица);
		Значения.Добавить(Стр.Количество);
		Значения.Добавить(ЦенаСАдаптивнойТочностью(Стр.Цена, Стр.Количество, Стр.Сумма));
		Значения.Добавить(Стр.Сумма);
		Значения.Добавить("");
		ВывестиСтрокуПечати(ТабДок, НомерСтроки, Значения, Ложь);
		// Назва номенклатури — текст, а не число: ВывестиСтрокуПечати праворуч вирівнює все з 5-ї колонки.
		ТабДок.Область(НомерСтроки, 8, НомерСтроки, 8).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
		ТабДок.Область(НомерСтроки, 7, НомерСтроки, 7).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
		ТабДок.Область(НомерСтроки, 9, НомерСтроки, 9).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;

		ИтогСуммы = ИтогСуммы + Стр.Сумма;
		НомерСтроки = НомерСтроки + 1;
		ПерваяСтрока = Ложь;
	КонецЦикла;

	Возврат НомерСтроки;

КонецФункции

// Ціна для друку з адаптивною точністю: 2 знаки (норма для грошей), але якщо при них
// Ціна x Кількість розходиться із Сумою більше ніж на копійку — стільки знаків, скільки
// потрібно, щоб рядок сходився (до 6). Інакше дрібні ціни на великих кількостях дають
// візуально «неперемножувані» рядки: 1000 шт х 0,08 = 80,00 при сумі 83,36 (реальна
// ціна 0,08336). Бухгалтер, який перевіряє форму, множить стовпці — вона має сходитись.
//
// Використовується скрізь, де Сума задана, а Ціна похідна: М-29 та Акт (за проведеними).
// В Акті (план) не потрібна — там навпаки, Сума рахується від округленої ціни.
Функция ЦенаСАдаптивнойТочностью(Цена, Количество, Сумма)
	Если Количество = 0 Тогда
		Возврат Окр(Цена, 2);
	КонецЕсли;
	Для Знаков = 2 По 6 Цикл
		Округленная = Окр(Цена, Знаков);
		Отклонение = Округленная * Количество - Сумма;
		Если Окр(?(Отклонение < 0, -Отклонение, Отклонение), 2) <= 0.01 Тогда
			Возврат Округленная;
		КонецЕсли;
	КонецЦикла;
	Возврат Окр(Цена, 6);
КонецФункции

// Підсумковий рядок: назва обʼєднана на колонки 1..11, сума у колонці 12.
Функция ВывестиИтогМ29(ТабДок, НомерСтроки, Название, Сумма)

	Граница = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	ЦветИтога = Новый Цвет(232, 232, 232);

	Обл = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 11);
	Обл.Объединить();
	Обл.Текст = Название;
	Обл.Шрифт = Новый Шрифт(, , Истина);
	Обл.ЦветФона = ЦветИтога;
	ОбрамитьОбластьМ29(Обл, Граница);

	Обл = ТабДок.Область(НомерСтроки, 12, НомерСтроки, 12);
	Обл.Текст = Сумма;
	Обл.Шрифт = Новый Шрифт(, , Истина);
	Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	Обл.ЦветФона = ЦветИтога;
	ОбрамитьОбластьМ29(Обл, Граница);

	Обл = ТабДок.Область(НомерСтроки, 13, НомерСтроки, 13);
	Обл.ЦветФона = ЦветИтога;
	ОбрамитьОбластьМ29(Обл, Граница);

	Возврат НомерСтроки + 1;

КонецФункции

// Блок підписів: посада + прочерк + ПІБ з реквізиту, під ним «(дата, П.І.Б., підпис)».
Процедура ВывестиПодписиМ29(ТабДок, НомерСтрокиНачало)

	НомерСтроки = НомерСтрокиНачало;

	Подписи = Новый Массив;
	Подписи.Добавить(Новый Структура("Должность, Лицо", "Опрацював  Бухгалтер ________________________", Бухгалтер));
	Подписи.Добавить(Новый Структура("Должность, Лицо", "Витрати матеріалів перевірив: ________________________", Перевірив));
	Подписи.Добавить(Новый Структура("Должность, Лицо", "Начальник ВТВ _______________________________", НачальникВТВ));
	Подписи.Добавить(Новый Структура("Должность, Лицо", "Інженер ВТВ _______________________________", Інженер));
	Подписи.Добавить(Новый Структура("Должность, Лицо", "Начальник будівельного-монтажного комплекса __________________________", Начальник));
	Подписи.Добавить(Новый Структура("Должность, Лицо", "Матеріально-відповідальна особа, що склала звіт  __________________", МВО));

	Для Каждого Подпись Из Подписи Цикл
		Текст = Подпись.Должность;
		Если ЗначениеЗаполнено(Подпись.Лицо) Тогда
			Текст = Текст + " " + Строка(Подпись.Лицо);
		КонецЕсли;
		НомерСтроки = ВывестиСтрокуНаВсюШиринуМ29(ТабДок, НомерСтроки, Текст);
		НомерСтроки = ВывестиСтрокуНаВсюШиринуМ29(ТабДок, НомерСтроки,
			"                                             (дата, П.І.Б., підпис)", Новый Шрифт(, 8));
	КонецЦикла;

КонецПроцедуры

// Ширини колонок М-29 (у символах). Ставляться на НЕобʼєднаному рядку (рядок нумерації) —
// на обʼєднаному платформа ширину ігнорує.
Процедура УстановитьШириныКолонокМ29(ТабДок, СтрокаНумерации)
	Ширины = Новый Массив;
	Ширины.Добавить(6);
	Ширины.Добавить(60);
	Ширины.Добавить(10);
	Ширины.Добавить(11);
	Ширины.Добавить(14);
	Ширины.Добавить(15);
	Ширины.Добавить(16);
	Ширины.Добавить(58);
	Ширины.Добавить(10);
	Ширины.Добавить(12);
	Ширины.Добавить(16);
	Ширины.Добавить(15);
	Ширины.Добавить(30);
	Для К = 0 По Ширины.ВГраница() Цикл
		ТабДок.Область(СтрокаНумерации, К + 1, СтрокаНумерации, К + 1).ШиринаКолонки = Ширины[К];
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ЦиклБудинку

// ============================================================================
// КАРТА ЦИКЛУ БУДИНКУ — план/факт хронології по трьох складах дому.
// Регламент (див. PROMPT_razrabotka_PolnyjCiklDomika.md, розділ 3):
//   D = ДатаОтгрузки = день реалізації; M = ДатаСписанияПоМонтажу = КонецМесяца(D + 10 днів).
//   Час документів — константи сітки (реквізити зберігають лише дату).
// ============================================================================

// Будує карту циклу: заповнює ТЧ ДокументыОтрузкиИДосписания, реквізити D/M/реалізацію.
// НЕ записує об'єкт і не кидає винятків назовні.
// Повертає Структуру: Кроків, Порушень, Відсутніх, Помилок, Сообщения, Помилки, Підсумок.
Функция ПроаналізуватиЦиклБудинку() Экспорт

	Рез = НовийРезультатЦиклу();
	Попытка
		Пар = ПараметриЦиклу(Рез);
		Если Пар = Неопределено Тогда
			Рез.Підсумок = "Цикл не розраховано — див. повідомлення.";
			Возврат Рез;
		КонецЕсли;
		Відмітки = ЗберегтиВідміткиКарти();
		ДокументыОтрузкиИДосписания.Очистить();
		ХронологияПеремещений.Очистить();
		ПобудуватиКарту(Пар, Рез);
		ВідновитиВідміткиКарти(Відмітки);
		ДокументыОтрузкиИДосписания.Сортировать("Дата, ДатаФакт");
		ХронологияПеремещений.Сортировать("Дата, ДатаФакт");
	Исключение
		Рез.Помилки.Добавить("Аналіз циклу: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Рез.Кроків = ДокументыОтрузкиИДосписания.Количество() + ХронологияПеремещений.Количество();
	Для Каждого РядокКарти Из ВсіРядкиКарти() Цикл
		Если РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.НарушениеХронологии
			Или РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.НарушениеПодразделения Тогда
			Рез.Порушень = Рез.Порушень + 1;
		ИначеЕсли РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.Планируется
			Или РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.Просрочен Тогда
			Рез.Відсутніх = Рез.Відсутніх + 1;
		КонецЕсли;
	КонецЦикла;
	Рез.Помилок = Рез.Помилки.Количество();
	Рез.Підсумок = Документы.РасчетКомплектаций.ПідсумокКартиЦиклу(ДокументыОтрузкиИДосписания, ХронологияПеремещений);
	Возврат Рез;

КонецФункции

// Створює документи для кроків «Планується»/«Прострочено» з виконаними воротами — за зразком попереднього будинку проєкту:
// переміщення комплекту (потрібна ДатаОтгрузкиПоКазне), реалізація (комплект на складі монтажу + зразок; той самий комплект —
// з проведенням), досписання монтажу (СписанняПідтверджено + проведена реалізація). Черга — за плановою датою.
Функция СтворитиВідсутніДокументиЦиклу() Экспорт

	Рез = НовийРезультатЦиклу();
	Рез.Вставить("Створено", 0);
	// Свіжа карта: статуси кроків і документи, створені поза системою (інакше — дублі за застарілими рядками).
	ПроаналізуватиЦиклБудинку();
	Пар = ПараметриЦиклу(Рез);
	Если Пар = Неопределено Тогда
		Возврат Рез;
	КонецЕсли;
	ДатаЗаборони = ДатаЗабориниЗмін();
	ПомилкиКроків = Новый Соответствие;
	// Черга створення — за плановою датою: переміщення комплекту (D 10:00) → реалізація (D 12:00) → досписання (M 21:00),
	// щоб підтверджений будинок закривався одним натисканням.
	Черга = Новый ТаблицаЗначений;
	Черга.Колонки.Добавить("Дата");
	Черга.Колонки.Добавить("Индекс");
	Для Индекс = 0 По ДокументыОтрузкиИДосписания.Количество() - 1 Цикл
		РядокЧерги = Черга.Добавить();
		РядокЧерги.Дата = ДокументыОтрузкиИДосписания[Индекс].Дата;
		РядокЧерги.Индекс = Индекс;
	КонецЦикла;
	Черга.Сортировать("Дата, Индекс");
	Для Каждого РядокЧерги Из Черга Цикл
		РядокКарти = ДокументыОтрузкиИДосписания[РядокЧерги.Индекс];
		Если ЗначениеЗаполнено(РядокКарти.Документ) Тогда
			Продолжить;
		КонецЕсли;
		Если РядокКарти.Статус <> Перечисления.А_СтатусыШагаЦикла.Планируется
			И РядокКарти.Статус <> Перечисления.А_СтатусыШагаЦикла.Просрочен Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДатаЗаборони) И РядокКарти.Дата <= ДатаЗаборони Тогда
			РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.ЗакрытыйПериод;
			РядокКарти.ОписаниеОперации = "Планова дата в закритому періоді (заборона до " + Формат(ДатаЗаборони, "ДФ=dd.MM.yyyy") + ")";
			Продолжить;
		КонецЕсли;
		Крок = РядокКарти.ВидОперации;
		Попытка
			Если Крок = Перечисления.А_ШагиЦиклаДомика.ПеремещениеКомплектаНаМонтаж Тогда
				СтворитиПереміщенняКомплекту(РядокКарти, Пар, Рез);
			ИначеЕсли Крок = Перечисления.А_ШагиЦиклаДомика.Реализация Тогда
				СтворитиРеалізацію(РядокКарти, Пар, Рез);
			ИначеЕсли Крок = Перечисления.А_ШагиЦиклаДомика.ДосписаниеМонтажа Тогда
				СтворитиВимогу(РядокКарти, Пар, Рез, "231");
			КонецЕсли;
		Исключение
			РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.Ошибка;
			РядокКарти.ОписаниеОперации = Лев("Не створено: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 200);
			ПомилкиКроків.Вставить(Строка(Крок) + "|" + Строка(РядокКарти.Склад), РядокКарти.ОписаниеОперации);
			Рез.Помилки.Добавить(Строка(Крок) + " (" + Строка(РядокКарти.Склад) + "): "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Если Не ЗначениеЗаполнено(РядокКарти.Документ) И РядокКарти.Статус <> Перечисления.А_СтатусыШагаЦикла.Ошибка Тогда
			// ворота не пройдені — текст причини зберігаємо для карти після переаналізу
			ПомилкиКроків.Вставить(Строка(Крок) + "|" + Строка(РядокКарти.Склад), РядокКарти.ОписаниеОперации);
		КонецЕсли;
	КонецЦикла;
	// Переаналізувати — знайти щойно створене, перерахувати статуси; причини відмов повернути в рядки.
	РезАналізу = ПроаналізуватиЦиклБудинку();
	ЗлитиРезультатиЦиклу(Рез, РезАналізу);
	Для Каждого РядокКарти Из ДокументыОтрузкиИДосписания Цикл
		ТекстПричини = ПомилкиКроків[Строка(РядокКарти.ВидОперации) + "|" + Строка(РядокКарти.Склад)];
		Если ТекстПричини <> Неопределено И Не ЗначениеЗаполнено(РядокКарти.Документ) И ЗначениеЗаполнено(ТекстПричини) Тогда
			Если СтрНачинаетсяС(ТекстПричини, "Не створено:") Тогда
				РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.Ошибка;
			КонецЕсли;
			РядокКарти.ОписаниеОперации = ТекстПричини;
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;

КонецФункции

// Переносить дати відмічених («Виправити») документів на планову дату — кожен у своїй транзакції,
// із перепроведенням. Реалізацію не чіпає. Стара дата зберігається в ДатаДоПереноса.
Функция ПеренестиДатиВідміченихДокументів() Экспорт

	Рез = НовийРезультатЦиклу();
	Рез.Вставить("Перенесено", 0);
	ТипРеалізації = Тип("ДокументСсылка.РеализацияТоваровУслуг");
	Для Каждого РядокКарти Из ВсіРядкиКарти() Цикл
		Если Не РядокКарти.Виправити Или Не ЗначениеЗаполнено(РядокКарти.Документ) Или Не ЗначениеЗаполнено(РядокКарти.Дата) Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(РядокКарти.Документ) = ТипРеалізації Тогда
			Рез.Помилки.Добавить(Строка(РядокКарти.Документ) + ": реалізацію система не переносить.");
			Продолжить;
		КонецЕсли;
		Попытка
			ДокОбъект = РядокКарти.Документ.ПолучитьОбъект();
			Если ДокОбъект = Неопределено Тогда
				ВызватьИсключение "документ не знайдено";
			КонецЕсли;
			Если ДокОбъект.ПометкаУдаления Тогда
				ВызватьИсключение "документ помічений на видалення";
			КонецЕсли;
			Если НачалоМесяца(ДокОбъект.Дата) <> НачалоМесяца(РядокКарти.Дата) Тогда
				ВызватьИсключение "перенесення в інший місяць (" + Формат(ДокОбъект.Дата, "ДФ=dd.MM.yyyy") + " → "
					+ Формат(РядокКарти.Дата, "ДФ=dd.MM.yyyy") + ") — лише вручну: змінюються рахунки обліку";
			КонецЕсли;
			Если Не ПеревіритиСкладДокумента(ДокОбъект) Тогда
				ВызватьИсключение "склад/організація документа не належать цьому будинку";
			КонецЕсли;
			// Що саме виправляємо: підрозділ (партія не для будинку) і/або дату (порушення хронології).
			Ціль = ЦільовийПідрозділДокумента(РядокКарти);
			ПотрібноПідрозділ = ЗначениеЗаполнено(Ціль) И ДокОбъект.Подразделение <> Ціль;
			ПотрібноДату = (РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.НарушениеХронологии);
			Если Не ПотрібноДату И (РядокКарти.ВидОперации = Перечисления.А_ШагиЦиклаДомика.ПеремещениеМатериаловНаПроизводство
				Или РядокКарти.ВидОперации = Перечисления.А_ШагиЦиклаДомика.ПеремещениеМатериаловНаМонтаж) И ЗначениеЗаполнено(ДатаОтгрузки) Тогда
				ДатаDф = НачалоДня(ДатаОтгрузки);
				ДатаMф = ?(ЗначениеЗаполнено(ДатаСписанияПоМонтажу), НачалоДня(ДатаСписанияПоМонтажу), НачалоДня(КонецМесяца(ДатаDф + 10 * 86400)));
				ВидСкл = ?(РядокКарти.Склад.А_ВидСклада = Перечисления.А_ВидСклада.Монтаж, "Монтаж", "Вироб");
				ПотрібноДату = ДокОбъект.Дата > ДедлайнПриходу(ВидСкл, ДатаDф, ДатаMф);
			КонецЕсли;
			Если Не ПотрібноПідрозділ И Не ПотрібноДату Тогда
				РядокКарти.Виправити = Ложь;
				Рез.Сообщения.Добавить(Строка(РядокКарти.Документ) + ": виправляти нічого (дата і підрозділ у нормі).");
				Продолжить;
			КонецЕсли;
			Опис = "";
			СтараДата = ДокОбъект.Дата;
			Если ПотрібноПідрозділ Тогда
				Опис = "підрозділ «" + Строка(ДокОбъект.Подразделение) + "» → «" + Строка(Ціль) + "»";
				ДокОбъект.Подразделение = Ціль;
			КонецЕсли;
			Если ПотрібноДату Тогда
				ДокОбъект.Дата = РядокКарти.Дата;
				Опис = Опис + ?(Опис = "", "", "; ") + "дата " + Формат(СтараДата, "ДФ='dd.MM.yyyy HH:mm:ss'") + " → " + Формат(РядокКарти.Дата, "ДФ='dd.MM.yyyy HH:mm:ss'");
			КонецЕсли;
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Если ПотрібноДату Тогда
				РядокКарти.ДатаДоПереноса = СтараДата;
			КонецЕсли;
			РядокКарти.ДатаФакт = ДокОбъект.Дата;
			РядокКарти.Проведен = Истина;
			РядокКарти.Виправити = Ложь;
			РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.Перенесен;
			РядокКарти.ОписаниеОперации = Лев("Виправлено: " + Опис, 200);
			Рез.Перенесено = Рез.Перенесено + 1;
			ЗаписьЖурналаРегистрации("РасчетКомплектаций.Цикл будинку", УровеньЖурналаРегистрации.Информация, , Ссылка,
				"Виправлено " + Строка(РядокКарти.Документ) + ": " + Опис);
		Исключение
			РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.Ошибка;
			РядокКарти.ОписаниеОперации = Лев("Не виправлено: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 200);
			Рез.Помилки.Добавить(Строка(РядокКарти.Документ) + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Если Рез.Перенесено > 0 Тогда
		Рез.Сообщения.Добавить("Виправлено документів: " + Рез.Перенесено + ". Після виправлення виконайте групове перепроведення послідовності «Документи організацій».");
	КонецЕсли;
	Возврат Рез;

КонецФункции

// Проводить документи карти в порядку планових дат (реалізацію не чіпає).
Функция ПровестиДокументиЦиклуЗаХронологією() Экспорт

	Рез = НовийРезультатЦиклу();
	Рез.Вставить("Проведено", 0);
	ТипРеалізації = Тип("ДокументСсылка.РеализацияТоваровУслуг");
	Рядки = ДокументыОтрузкиИДосписания.Выгрузить(, "Документ, Дата, ДатаФакт, Проведен, Статус");
	Для Каждого РядокХронології Из ХронологияПеремещений Цикл
		ЗаполнитьЗначенияСвойств(Рядки.Добавить(), РядокХронології);
	КонецЦикла;
	Рядки.Сортировать("Дата, ДатаФакт");
	Для Каждого РядокКарти Из Рядки Цикл
		Если Не ЗначениеЗаполнено(РядокКарти.Документ) Или РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.Информационно Тогда
			Продолжить;
		КонецЕсли;
		ЦеРеалізація = (ТипЗнч(РядокКарти.Документ) = ТипРеалізації);
		Если ЦеРеалізація И Не РядокКарти.Проведен Тогда
			// Непроведену реалізацію система не проводить — це рішення бухгалтера (можливий дубль).
			Рез.Сообщения.Добавить(Строка(РядокКарти.Документ) + ": непроведену реалізацію не проводимо — перевірте (чи не дубль) і проведіть вручну.");
			Продолжить;
		ИначеЕсли РядокКарти.Проведен И Не ЦеРеалізація Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ДокОбъект = РядокКарти.Документ.ПолучитьОбъект();
			Если ДокОбъект = Неопределено Или ДокОбъект.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			Если Не ПеревіритиСкладДокумента(ДокОбъект) Тогда
				ВызватьИсключение "склад/організація документа не належать цьому будинку";
			КонецЕсли;
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Рез.Проведено = Рез.Проведено + 1;
			Если ЦеРеалізація Тогда
				Рез.Сообщения.Добавить(Строка(РядокКарти.Документ) + ": проведену реалізацію перепроведено у своїй черзі хронології.");
			КонецЕсли;
		Исключение
			Рез.Помилки.Добавить(Строка(РядокКарти.Документ) + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	РезАналізу = ПроаналізуватиЦиклБудинку();
	ЗлитиРезультатиЦиклу(Рез, РезАналізу);
	Возврат Рез;

КонецФункции

// Повне перепроведення ПРОВЕДЕНИХ документів циклу будинку за фактичною хронологією — для перерахунку партій.
// Свідомо НЕ входить до «Перерахувати і провести» (там довгий розподіл за нормами) — окрема кнопка.
// ЗРеалізацією — перепроводити і реалізацію (інакше пропускається: перереєстрація в обміні з ЕРП).
Функция ПерепровестиДокументиЦиклу(ЗРеалізацією = Ложь) Экспорт

	Рез = НовийРезультатЦиклу();
	Рез.Вставить("Перепроведено", 0);
	Рез.Вставить("Пропущено", 0);
	Если ДокументыОтрузкиИДосписания.Количество() + ХронологияПеремещений.Количество() = 0 Тогда
		РезАналізу = ПроаналізуватиЦиклБудинку();
		ЗлитиРезультатиЦиклу(Рез, РезАналізу);
		Если ДокументыОтрузкиИДосписания.Количество() + ХронологияПеремещений.Количество() = 0 Тогда
			Рез.Сообщения.Добавить("Карта циклу порожня — нічого перепроводити.");
			Возврат Рез;
		КонецЕсли;
	КонецЕсли;
	ТипРеалізації = Тип("ДокументСсылка.РеализацияТоваровУслуг");
	Рядки = ДокументыОтрузкиИДосписания.Выгрузить(, "Документ, Дата, ДатаФакт, Проведен, Статус, ВидОперации");
	Для Каждого РядокХронології Из ХронологияПеремещений Цикл
		ЗаполнитьЗначенияСвойств(Рядки.Добавить(), РядокХронології);
	КонецЦикла;
	Рядки.Сортировать("ДатаФакт, Дата");
	Оброблено = Новый Соответствие;
	Для Каждого РядокКарти Из Рядки Цикл
		Если Не ЗначениеЗаполнено(РядокКарти.Документ) Или Оброблено[РядокКарти.Документ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Оброблено.Вставить(РядокКарти.Документ, Истина);
		Если ТипЗнч(РядокКарти.Документ) = ТипРеалізації И Не ЗРеалізацією Тогда
			Рез.Пропущено = Рез.Пропущено + 1;
			Рез.Сообщения.Добавить("Пропущено (реалізація не чіпається): " + Строка(РядокКарти.Документ));
			Продолжить;
		КонецЕсли;
		Попытка
			ДокОбъект = РядокКарти.Документ.ПолучитьОбъект();
			Если ДокОбъект = Неопределено Или ДокОбъект.ПометкаУдаления Или Не ДокОбъект.Проведен Тогда
				Рез.Пропущено = Рез.Пропущено + 1;
				Продолжить;
			КонецЕсли;
			Если Не ПеревіритиСкладДокумента(ДокОбъект) Тогда
				ВызватьИсключение "склад/організація документа не належать цьому будинку";
			КонецЕсли;
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Рез.Перепроведено = Рез.Перепроведено + 1;
		Исключение
			Рез.Помилки.Добавить(Строка(РядокКарти.Документ) + " (" + Формат(РядокКарти.ДатаФакт, "ДФ='dd.MM.yyyy HH:mm:ss'") + "): "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	ЗаписьЖурналаРегистрации("РасчетКомплектаций.Цикл будинку", УровеньЖурналаРегистрации.Информация, , Ссылка,
		"Перепроведення циклу: перепроведено " + Рез.Перепроведено + ", пропущено " + Рез.Пропущено + ", помилок " + Рез.Помилки.Количество());
	Рез.Сообщения.Добавить("Перепроведення циклу: перепроведено " + Формат(Рез.Перепроведено, "ЧН=0; ЧГ=0") + ", пропущено "
		+ Формат(Рез.Пропущено, "ЧН=0; ЧГ=0") + ?(Рез.Помилки.Количество() > 0, ", помилок " + Формат(Рез.Помилки.Количество(), "ЧН=0; ЧГ=0"), "") + ".");
	РезАналізу = ПроаналізуватиЦиклБудинку();
	ЗлитиРезультатиЦиклу(Рез, РезАналізу);
	РезЗал = ЗалишкиПісляЦиклу();
	Рез.Сообщения.Добавить(РезЗал.Текст);
	Возврат Рез;

КонецФункции

// Залишки 20/22/26/28 по складах будинку на кінець M (границя включно).
// Повертає Структуру: Пусто (Булево), Текст, Рядки (ТаблицаЗначений).
Функция ЗалишкиПісляЦиклу() Экспорт

	Рез = Новый Структура("Пусто, Текст, Рядки", Истина, "", Неопределено);
	ДатаM = ?(ЗначениеЗаполнено(ДатаСписанияПоМонтажу), ДатаСписанияПоМонтажу, ?(ЗначениеЗаполнено(Период), Период, ТекущаяДата()));
	Склади = СкладиБудинку();
	СкладиМассив = Склади.ВыгрузитьКолонку("Склад");
	Если СкладиМассив.Количество() = 0 Тогда
		Рез.Текст = "Склади будинку не визначено.";
		Рез.Пусто = Ложь;
		Возврат Рез;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Вн.Счет КАК Счет,
	|	Вн.Организация КАК Организация,
	|	Вн.Склад КАК Склад,
	|	Вн.Кол КАК Кол,
	|	Вн.Сумма КАК Сумма
	|ИЗ
	|	(ВЫБРАТЬ
	|		О.Счет КАК Счет,
	|		О.Организация КАК Организация,
	|		ВЫБОР КОГДА О.Субконто2 ССЫЛКА Справочник.Склады ТОГДА О.Субконто2 ИНАЧЕ О.Субконто3 КОНЕЦ КАК Склад,
	|		СУММА(О.КоличествоОстаток) КАК Кол,
	|		СУММА(О.СуммаОстаток) КАК Сумма
	|	ИЗ
	|		РегистрБухгалтерии.Хозрасчетный.Остатки(&Граница, Счет В ИЕРАРХИИ (&Счета), , Субконто2 В (&Склады) ИЛИ Субконто3 В (&Склады)) КАК О
	|	СГРУППИРОВАТЬ ПО
	|		О.Счет,
	|		О.Организация,
	|		ВЫБОР КОГДА О.Субконто2 ССЫЛКА Справочник.Склады ТОГДА О.Субконто2 ИНАЧЕ О.Субконто3 КОНЕЦ
	|	ИМЕЮЩИЕ
	|		СУММА(О.КоличествоОстаток) <> 0 ИЛИ СУММА(О.СуммаОстаток) <> 0) КАК Вн
	|УПОРЯДОЧИТЬ ПО
	|	Склад,
	|	Счет";
	Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(ДатаM), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Склады", СкладиМассив);
	РахункиМассив = Новый Массив;
	Для Каждого КодРахунку Из СтрРазделить("20,22,26,28", ",") Цикл
		Рахунок = ПланыСчетов.Хозрасчетный.НайтиПоКоду(КодРахунку);
		Если ЗначениеЗаполнено(Рахунок) Тогда
			РахункиМассив.Добавить(Рахунок);
		КонецЕсли;
	КонецЦикла;
	Запрос.УстановитьПараметр("Счета", РахункиМассив);
	Рез.Рядки = Запрос.Выполнить().Выгрузить();
	Рез.Пусто = (Рез.Рядки.Количество() = 0);
	Если Рез.Пусто Тогда
		Рез.Текст = "Залишки по складах будинку на " + Формат(ДатаM, "ДФ=dd.MM.yyyy") + ": нуль (20/22/26/28).";
	Иначе
		Частини = Новый Массив;
		Для Каждого Рядок Из Рез.Рядки Цикл
			Частини.Добавить(Строка(Рядок.Счет.Код) + " " + Строка(Рядок.Склад) + ": " + Формат(Рядок.Кол, "ЧДЦ=3; ЧН=0")
				+ " / " + Формат(Рядок.Сумма, "ЧДЦ=2; ЧРГ=' '"));
		КонецЦикла;
		Рез.Текст = "Залишки на " + Формат(ДатаM, "ДФ=dd.MM.yyyy") + " НЕ нульові: " + СтрСоединить(Частини, "; ");
	КонецЕсли;
	Возврат Рез;

КонецФункции

// ---------------------------------------------------------------------------
// Параметри циклу, склади, комплект, реалізація
// ---------------------------------------------------------------------------

Функция НовийРезультатЦиклу()
	Рез = Новый Структура;
	Рез.Вставить("Кроків", 0);
	Рез.Вставить("Порушень", 0);
	Рез.Вставить("Відсутніх", 0);
	Рез.Вставить("Помилок", 0);
	Рез.Вставить("Сообщения", Новый Массив);
	Рез.Вставить("Помилки", Новый Массив);
	Рез.Вставить("Підсумок", "");
	Возврат Рез;
КонецФункции

Процедура ЗлитиРезультатиЦиклу(Рез, РезІнший)
	Для Каждого Т Из РезІнший.Сообщения Цикл
		Если Рез.Сообщения.Найти(Т) = Неопределено Тогда
			Рез.Сообщения.Добавить(Т);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Т Из РезІнший.Помилки Цикл
		Если Рез.Помилки.Найти(Т) = Неопределено Тогда
			Рез.Помилки.Добавить(Т);
		КонецЕсли;
	КонецЦикла;
	Рез.Кроків = РезІнший.Кроків;
	Рез.Порушень = РезІнший.Порушень;
	Рез.Відсутніх = РезІнший.Відсутніх;
	Рез.Помилок = Рез.Помилки.Количество();
	Рез.Підсумок = РезІнший.Підсумок;
КонецПроцедуры

// Склади будинку: ТЧ СкладыОстатков, а якщо порожня — усі склади з Подразделение = дім.
// ТЗ: Склад, Вид ("Вироб" / "Монтаж" / "Інше"), Организация.
Функция СкладиБудинку()
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Склад");
	ТЗ.Колонки.Добавить("Вид");
	ТЗ.Колонки.Добавить("Организация");
	СкладиМассив = СкладыСписком();
	Если СкладиМассив.Количество() = 0 И ЗначениеЗаполнено(Подразделение) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	С.Ссылка КАК Склад
		|ИЗ
		|	Справочник.Склады КАК С
		|ГДЕ
		|	С.Подразделение = &Дом
		|	И НЕ С.ЭтоГруппа
		|	И НЕ С.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	С.Код";
		Запрос.УстановитьПараметр("Дом", Подразделение);
		СкладиМассив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Склад");
	КонецЕсли;
	Для Каждого СкладБудинку Из СкладиМассив Цикл
		Если Не ЗначениеЗаполнено(СкладБудинку) Тогда
			Продолжить;
		КонецЕсли;
		НовийРядок = ТЗ.Добавить();
		НовийРядок.Склад = СкладБудинку;
		ВидСкладу = СкладБудинку.А_ВидСклада;
		Если ВидСкладу = Перечисления.А_ВидСклада.Монтаж Тогда
			НовийРядок.Вид = "Монтаж";
		ИначеЕсли ВидСкладу = Перечисления.А_ВидСклада.Производственный Тогда
			НовийРядок.Вид = "Вироб";
		Иначе
			НовийРядок.Вид = "Інше";
		КонецЕсли;
		ОргСкладу = СкладБудинку.А_Организация;
		НовийРядок.Организация = ?(ЗначениеЗаполнено(ОргСкладу), ОргСкладу, Организация);
	КонецЦикла;
	Возврат ТЗ;
КонецФункции

Функция КомплектБудинку()
	Для Каждого РядокТЧ Из ДокументиКомплектації Цикл
		Если ЗначениеЗаполнено(РядокТЧ.ДокументПоНормам) Тогда
			КомплектДок = РядокТЧ.ДокументПоНормам.Номенклатура;
			Если ЗначениеЗаполнено(КомплектДок) Тогда
				Возврат КомплектДок;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат НоменклатураКомплект;
КонецФункции

Функция ПараметриЦиклу(Рез)

	Пар = Новый Структура("ДатаD, ДатаM, Склади, Комплект, Реалізація, Рахунок26");
	Пар.Рахунок26 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("26");
	Пар.Склади = СкладиБудинку();
	Если Пар.Склади.Количество() = 0 Тогда
		Рез.Помилки.Добавить("Не визначено склади будинку: заповніть ТЧ «Склади залишків» або реквізит «Підрозділ».");
		Возврат Неопределено;
	КонецЕсли;
	Пар.Комплект = КомплектБудинку();
	Если Не ЗначениеЗаполнено(Пар.Комплект) Тогда
		Рез.Помилки.Добавить("Не визначено номенклатуру-комплект (немає комплектації «по нормам» і порожній реквізит «Комплект»).");
	ИначеЕсли Не ЗначениеЗаполнено(НоменклатураКомплект) Тогда
		НоменклатураКомплект = Пар.Комплект;
		Рез.Сообщения.Добавить("Реквізит «Комплект» заповнено з комплектації: " + Строка(Пар.Комплект) + ".");
	ИначеЕсли НоменклатураКомплект <> Пар.Комплект Тогда
		// У шапці зазвичай номенклатура рівня СС («МД IRS 2026 15 м»), у комплектації — виріб («Амбулаторія модульна 15 м.кв»):
		// це не помилка, карта і документи будуються за комплектацією. Повідомляємо, щоб було видно розбіжність.
		Рез.Сообщения.Добавить("Комплект у шапці «" + Строка(НоменклатураКомплект) + "», у комплектаціях «" + Строка(Пар.Комплект)
			+ "» — карта будується за комплектацією.");
	КонецЕсли;
	Пар.Реалізація = ЗнайтиРеалізацію(Пар, Рез);
	// D — день реалізації; інакше введена вручну; інакше з казни.
	Если ЗначениеЗаполнено(Пар.Реалізація) Тогда
		ДеньD = НачалоДня(Пар.Реалізація.Дата);
		Если ДатаОтгрузки <> ДеньD Тогда
			Если ЗначениеЗаполнено(ДатаОтгрузки) Тогда
				Рез.Сообщения.Добавить("Дата відвантаження змінена з " + Формат(ДатаОтгрузки, "ДФ=dd.MM.yyyy") + " на день реалізації "
					+ Формат(ДеньD, "ДФ=dd.MM.yyyy") + " (" + Строка(Пар.Реалізація) + ").");
			КонецЕсли;
			ДатаОтгрузки = ДеньD;
		КонецЕсли;
	ИначеЕсли Не ЗначениеЗаполнено(ДатаОтгрузки) И ЗначениеЗаполнено(ДатаОтгрузкиПоКазне) Тогда
		ДатаОтгрузки = НачалоДня(ДатаОтгрузкиПоКазне);
		Рез.Сообщения.Добавить("Дата відвантаження взята з казни: " + Формат(ДатаОтгрузки, "ДФ=dd.MM.yyyy") + " (реалізацію не знайдено).");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаОтгрузки) Тогда
		Рез.Помилки.Добавить("Не визначено дату відвантаження (D): немає реалізації, порожні «Дата відвантаження» і «Дата відвантаження по казні».");
		Возврат Неопределено;
	КонецЕсли;
	Пар.ДатаD = НачалоДня(ДатаОтгрузки);
	// M — кінець місяця (D + 10 днів), якщо не задано вручну.
	Если Не ЗначениеЗаполнено(ДатаСписанияПоМонтажу) Тогда
		ДатаСписанияПоМонтажу = НачалоДня(КонецМесяца(Пар.ДатаD + 10 * 86400));
		Рез.Сообщения.Добавить("Дата списання по монтажу = кінець місяця (D + 10 днів): " + Формат(ДатаСписанияПоМонтажу, "ДФ=dd.MM.yyyy") + ".");
	КонецЕсли;
	Пар.ДатаM = НачалоДня(ДатаСписанияПоМонтажу);
	Если Пар.ДатаM < Пар.ДатаD Тогда
		Рез.Помилки.Добавить("Дата списання по монтажу (" + Формат(Пар.ДатаM, "ДФ=dd.MM.yyyy") + ") раніше дати відвантаження ("
			+ Формат(Пар.ДатаD, "ДФ=dd.MM.yyyy") + ").");
	КонецЕсли;
	Возврат Пар;

КонецФункции

// Реалізацію лише ЗНАХОДИМО: реквізит шапки, інакше пошук за складом монтажу + рахунок 26.
Функция ЗнайтиРеалізацію(Пар, Рез)
	Если ЗначениеЗаполнено(ДокументРеализацияТоваровУслуг) Тогда
		Возврат ДокументРеализацияТоваровУслуг;
	КонецЕсли;
	СкладиМонтажу = Новый Массив;
	Для Каждого РядокСкладу Из Пар.Склади Цикл
		Если РядокСкладу.Вид = "Монтаж" Тогда
			СкладиМонтажу.Добавить(РядокСкладу.Склад);
		КонецЕсли;
	КонецЦикла;
	Если СкладиМонтажу.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Р.Ссылка КАК Док,
	|	Р.Дата КАК Дата,
	|	Р.Проведен КАК Проведен
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Р
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РТ
	|		ПО РТ.Ссылка = Р.Ссылка
	|ГДЕ
	|	Р.Склад В (&Склады)
	|	И РТ.СчетУчетаБУ = &Счет26
	|	И НЕ Р.ПометкаУдаления
	|	И Р.Дата МЕЖДУ &Начало И &Конец
	|УПОРЯДОЧИТЬ ПО
	|	Р.Проведен УБЫВ,
	|	Р.Дата";
	Запрос.УстановитьПараметр("Склады", СкладиМонтажу);
	Запрос.УстановитьПараметр("Счет26", Пар.Рахунок26);
	Запрос.УстановитьПараметр("Начало", НачалоДня(?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДата())) - 30 * 86400);
	Запрос.УстановитьПараметр("Конец", КонецДня(Макс(Период, ТекущаяДата())));
	Таблиця = Запрос.Выполнить().Выгрузить();
	Знайдена = Неопределено;
	Проведених = 0;
	Дублі = Новый Массив;
	Для Каждого РядокТаблиці Из Таблиця Цикл
		Если РядокТаблиці.Проведен Тогда
			Проведених = Проведених + 1;
			Если Знайдена = Неопределено Тогда
				Знайдена = РядокТаблиці.Док;
			Иначе
				Дублі.Добавить(Строка(РядокТаблиці.Док));
			КонецЕсли;
		Иначе
			Дублі.Добавить(Строка(РядокТаблиці.Док) + " (не проведена)");
		КонецЕсли;
	КонецЦикла;
	Если Проведених > 1 Тогда
		Рез.Помилки.Добавить("Знайдено кілька проведених реалізацій по складу монтажу — оберіть вручну в реквізиті «Документ реалізації»: "
			+ Строка(Знайдена) + ", " + СтрСоединить(Дублі, ", "));
		Возврат Неопределено;
	КонецЕсли;
	Если Знайдена <> Неопределено Тогда
		ДокументРеализацияТоваровУслуг = Знайдена;
		Рез.Сообщения.Добавить("Реалізацію знайдено і підставлено: " + Строка(Знайдена) + ".");
		Если Дублі.Количество() > 0 Тогда
			Рез.Сообщения.Добавить("УВАГА: є ще реалізації по цьому складу: " + СтрСоединить(Дублі, ", "));
		КонецЕсли;
	КонецЕсли;
	Возврат Знайдена;
КонецФункции

// ---------------------------------------------------------------------------
// Сітка часу
// ---------------------------------------------------------------------------

// Планова дата-час кроку за регламентом (для переміщень матеріалів — рекомендована при перенесенні).
Функция ПлановаДатаКроку(Крок, ДатаD, ДатаM)
	К = Перечисления.А_ШагиЦиклаДомика;
	Если Крок = К.ПеремещениеМатериаловНаПроизводство Тогда
		Возврат ДатаD + 8 * 3600;
	ИначеЕсли Крок = К.ПередачаМалоценкиПроизводство Тогда
		Возврат ДатаD + 8 * 3600 + 1800;
	ИначеЕсли Крок = К.КомплектацияПроизводствоПоНормам Тогда
		Возврат ДатаD + 9 * 3600;
	ИначеЕсли Крок = К.КомплектацияПроизводствоДодаткова Тогда
		Возврат ДатаD + 9 * 3600 + 1;
	ИначеЕсли Крок = К.ПеремещениеКомплектаНаМонтаж Тогда
		Возврат ДатаD + 10 * 3600;
	ИначеЕсли Крок = К.Реализация Тогда
		Возврат ДатаD + 12 * 3600;
	ИначеЕсли Крок = К.СписаниеПонаднормыПроизводства Тогда
		Возврат ДатаD + 12 * 3600 + 1800;
	ИначеЕсли Крок = К.ПеремещениеМатериаловНаМонтаж Тогда
		Возврат ДатаM + 18 * 3600;
	ИначеЕсли Крок = К.ПередачаМалоценкиМонтаж Тогда
		Возврат ДатаM + 19 * 3600;
	ИначеЕсли Крок = К.КомплектацияМонтажПоНормам Тогда
		Возврат ДатаM + 20 * 3600;
	ИначеЕсли Крок = К.КомплектацияМонтажДодаткова Тогда
		Возврат ДатаM + 20 * 3600 + 1;
	ИначеЕсли Крок = К.ДосписаниеМонтажа Тогда
		Возврат ДатаM + 21 * 3600;
	ИначеЕсли Крок = К.ВозвратОстатков Тогда
		Возврат ДатаM + 21 * 3600 + 1800;
	КонецЕсли;
	Возврат '00010101';
КонецФункции

// Дедлайн для приходу матеріалів: виробництво — D 08:59:58, монтаж — M 18:30:00.
Функция ДедлайнПриходу(ВидСкладу, ДатаD, ДатаM)
	Если ВидСкладу = "Монтаж" Тогда
		Возврат ДатаM + 18 * 3600 + 1800;
	КонецЕсли;
	Возврат ДатаD + 8 * 3600 + 59 * 60 + 58;
КонецФункции

// Дата-час цільового документа сімейства (комплектація / малоцінка) за сіткою. Порожня — не змінювати.
Функция ПлановаДатаЦільовогоДокумента(СкладДок, ЦеМалоцінка, ПоНорміДок)
	Если Не ЗначениеЗаполнено(ДатаОтгрузки) Или Не ЗначениеЗаполнено(СкладДок) Тогда
		Возврат '00010101';
	КонецЕсли;
	ДатаD = НачалоДня(ДатаОтгрузки);
	ДатаM = ?(ЗначениеЗаполнено(ДатаСписанияПоМонтажу), НачалоДня(ДатаСписанияПоМонтажу), НачалоДня(КонецМесяца(ДатаD + 10 * 86400)));
	ЦеМонтаж = (СкладДок.А_ВидСклада = Перечисления.А_ВидСклада.Монтаж);
	К = Перечисления.А_ШагиЦиклаДомика;
	Если ЦеМалоцінка Тогда
		Возврат ПлановаДатаКроку(?(ЦеМонтаж, К.ПередачаМалоценкиМонтаж, К.ПередачаМалоценкиПроизводство), ДатаD, ДатаM);
	ИначеЕсли ПоНорміДок = Истина Тогда
		Возврат ПлановаДатаКроку(?(ЦеМонтаж, К.КомплектацияМонтажПоНормам, К.КомплектацияПроизводствоПоНормам), ДатаD, ДатаM);
	Иначе
		Возврат ПлановаДатаКроку(?(ЦеМонтаж, К.КомплектацияМонтажДодаткова, К.КомплектацияПроизводствоДодаткова), ДатаD, ДатаM);
	КонецЕсли;
КонецФункции

// ---------------------------------------------------------------------------
// Побудова карти
// ---------------------------------------------------------------------------

Функция ДокументиЦиклуЗБази(Пар)
	СкладиМассив = Пар.Склади.ВыгрузитьКолонку("Склад");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	1 КАК Тип,
	|	П.Ссылка КАК Док,
	|	П.Дата КАК Дата,
	|	П.Проведен КАК Проведен,
	|	П.ПометкаУдаления КАК ПометкаУдаления,
	|	П.Организация КАК Организация,
	|	П.СкладПолучатель КАК Склад,
	|	П.СкладОтправитель КАК СкладОтправитель,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК Номенклатура,
	|	0 КАК Количество,
	|	ЛОЖЬ КАК ПоНорме
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК П
	|ГДЕ
	|	П.Дата МЕЖДУ &Начало И &Конец
	|	И (П.СкладПолучатель В (&Склады) ИЛИ П.СкладОтправитель В (&Склады))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	2, К.Ссылка, К.Дата, К.Проведен, К.ПометкаУдаления, К.Организация, К.Склад,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка), К.Номенклатура, К.Количество, К.ПоНорме
	|ИЗ
	|	Документ.КомплектацияНоменклатуры КАК К
	|ГДЕ
	|	К.Дата МЕЖДУ &Начало И &Конец
	|	И К.Склад В (&Склады)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	3, М.Ссылка, М.Дата, М.Проведен, М.ПометкаУдаления, М.Организация, М.Склад,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка), ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка), 0, М.ПоНорме
	|ИЗ
	|	Документ.ПередачаМалоценныхАктивовВЭксплуатацию КАК М
	|ГДЕ
	|	М.Дата МЕЖДУ &Начало И &Конец
	|	И М.Склад В (&Склады)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	4, Р.Ссылка, Р.Дата, Р.Проведен, Р.ПометкаУдаления, Р.Организация, Р.Склад,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка), РТ.Номенклатура, РТ.Количество, ЛОЖЬ
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Р
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РТ
	|		ПО РТ.Ссылка = Р.Ссылка
	|ГДЕ
	|	Р.Дата МЕЖДУ &Начало И &Конец
	|	И Р.Склад В (&Склады)
	|	И РТ.СчетУчетаБУ = &Счет26
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	5, Т.Ссылка, Т.Дата, Т.Проведен, Т.ПометкаУдаления, Т.Организация, Т.Склад,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка), ТМ.Номенклатура, ТМ.Количество, ЛОЖЬ
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТребованиеНакладная.Материалы КАК ТМ
	|		ПО ТМ.Ссылка = Т.Ссылка
	|ГДЕ
	|	Т.Дата МЕЖДУ &Начало И &Конец
	|	И Т.Склад В (&Склады)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Тип";
	Запрос.УстановитьПараметр("Склады", СкладиМассив);
	Запрос.УстановитьПараметр("Счет26", Пар.Рахунок26);
	Запрос.УстановитьПараметр("Начало", НачалоМесяца(Пар.ДатаD) - 31 * 86400);
	Запрос.УстановитьПараметр("Конец", КонецДня(Макс(Пар.ДатаM, Период, ТекущаяДата())));
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Переміщення КОМПЛЕКТІВ (рядки з рахунком 26): Док -> Структура(Номенклатура, Количество).
Функция ПереміщенняКомплектів(Пар)
	Відповідність = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Ссылка КАК Док,
	|	ПТ.Номенклатура КАК Номенклатура,
	|	СУММА(ПТ.Количество) КАК Количество
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК П
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПеремещениеТоваров.Товары КАК ПТ
	|		ПО ПТ.Ссылка = П.Ссылка
	|ГДЕ
	|	П.Дата МЕЖДУ &Начало И &Конец
	|	И ПТ.СчетУчетаБУ = &Счет26
	|	И (П.СкладПолучатель В (&Склады) ИЛИ П.СкладОтправитель В (&Склады))
	|СГРУППИРОВАТЬ ПО
	|	П.Ссылка,
	|	ПТ.Номенклатура";
	Запрос.УстановитьПараметр("Склады", Пар.Склади.ВыгрузитьКолонку("Склад"));
	Запрос.УстановитьПараметр("Счет26", Пар.Рахунок26);
	Запрос.УстановитьПараметр("Начало", НачалоМесяца(Пар.ДатаD) - 31 * 86400);
	Запрос.УстановитьПараметр("Конец", КонецДня(Макс(Пар.ДатаM, Период, ТекущаяДата())));
	Вибірка = Запрос.Выполнить().Выбрать();
	Пока Вибірка.Следующий() Цикл
		Если Відповідність[Вибірка.Док] = Неопределено Тогда
			Відповідність.Вставить(Вибірка.Док, Новый Структура("Номенклатура, Количество", Вибірка.Номенклатура, Вибірка.Количество));
		КонецЕсли;
	КонецЦикла;
	Возврат Відповідність;
КонецФункции

// Крок належить таблиці документів циклу (4 кроки) — інакше рядок іде в хронологію переміщень.
Функция ЦеКрокДокументів(Крок)
	К = Перечисления.А_ШагиЦиклаДомика;
	Возврат Крок = К.ПеремещениеКомплектаНаМонтаж Или Крок = К.Реализация
		Или Крок = К.СписаниеПонаднормыПроизводства Или Крок = К.ДосписаниеМонтажа;
КонецФункции

// Усі рядки карти (обидві ТЧ) — для циклів статусів, відміток, лічильників.
Функция ВсіРядкиКарти()
	Рядки = Новый Массив;
	Для Каждого РядокКарти Из ДокументыОтрузкиИДосписания Цикл
		Рядки.Добавить(РядокКарти);
	КонецЦикла;
	Для Каждого РядокКарти Из ХронологияПеремещений Цикл
		Рядки.Добавить(РядокКарти);
	КонецЦикла;
	Возврат Рядки;
КонецФункции

Функция ДодатиРядокКарти(Крок, СкладРядка, ОргРядка, ДатаD, ДатаM)
	Если ЦеКрокДокументів(Крок) Тогда
		НовийРядок = ДокументыОтрузкиИДосписания.Добавить();
	Иначе
		НовийРядок = ХронологияПеремещений.Добавить();
	КонецЕсли;
	НовийРядок.ВидОперации = Крок;
	НовийРядок.Склад = СкладРядка;
	НовийРядок.Организация = ОргРядка;
	НовийРядок.Дата = ПлановаДатаКроку(Крок, ДатаD, ДатаM);
	НовийРядок.Статус = Перечисления.А_СтатусыШагаЦикла.Планируется;
	Возврат НовийРядок;
КонецФункции

Процедура ПобудуватиКарту(Пар, Рез)

	К = Перечисления.А_ШагиЦиклаДомика;
	С = Перечисления.А_СтатусыШагаЦикла;
	ВидПоСкладу = Новый Соответствие;
	ОргПоСкладу = Новый Соответствие;
	Для Каждого РядокСкладу Из Пар.Склади Цикл
		ВидПоСкладу.Вставить(РядокСкладу.Склад, РядокСкладу.Вид);
		ОргПоСкладу.Вставить(РядокСкладу.Склад, РядокСкладу.Организация);
	КонецЦикла;
	Факт = ДокументиЦиклуЗБази(Пар);
	Комплекти = ПереміщенняКомплектів(Пар);
	ВимогиЗКомплектом = Новый Соответствие;
	Для Каждого СтрФ Из Факт Цикл
		Если СтрФ.Тип = 5 И ЗначениеЗаполнено(Пар.Комплект) И СтрФ.Номенклатура = Пар.Комплект Тогда
			ВимогиЗКомплектом.Вставить(СтрФ.Док, Истина);
		КонецЕсли;
	КонецЦикла;
	Оброблено = Новый Соответствие;
	Наявні = Новый Соответствие; // Крок|Склад -> рядок карти (перший)
	ДатиКроків = Новый Соответствие; // Крок|Склад -> макс. ДатаФакт проведених
	ПроведенаРеал = ПроведенаРеалізаціяБудинку(Факт, Пар);

	Для Каждого СтрФ Из Факт Цикл
		Если Оброблено[СтрФ.Док] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтрФ.Тип = 4 И Не СтрФ.Проведен И Не СтрФ.ПометкаУдаления И ПроведенаРеал <> Неопределено И СтрФ.Док <> Пар.Реалізація Тогда
			// Будинок уже реалізовано — зайву непроведену реалізацію в цикл не тягнемо (щоб її не провели вдруге).
			Оброблено.Вставить(СтрФ.Док, Истина);
			Рез.Сообщения.Добавить("Непроведена реалізація " + Строка(СтрФ.Док) + " не включена в цикл: будинок уже реалізовано ("
				+ Строка(ПроведенаРеал) + ") — ймовірно дубль, перевірте і позначте на видалення.");
			Продолжить;
		КонецЕсли;
		Оброблено.Вставить(СтрФ.Док, Истина);
		Если СтрФ.Тип = 4 И СтрФ.Проведен И Не СтрФ.ПометкаУдаления И ПроведенаРеал <> Неопределено И СтрФ.Док <> ПроведенаРеал Тогда
			Рез.Помилки.Добавить("Друга проведена реалізація " + Строка(СтрФ.Док) + " по складу монтажу (перша — "
				+ Строка(ПроведенаРеал) + ") — будинок реалізовано двічі?");
		КонецЕсли;
		Крок = Неопределено;
		СкладРядка = СтрФ.Склад;
		СкладВідпр = СтрФ.СкладОтправитель;
		НоменклатураРядка = СтрФ.Номенклатура;
		КількістьРядка = СтрФ.Количество;
		ВидОтр = ВидПоСкладу[СтрФ.Склад];
		ВидВідпр = ВидПоСкладу[СтрФ.СкладОтправитель];
		Если СтрФ.Тип = 1 Тогда
			ДаніКомплекту = Комплекти[СтрФ.Док];
			Если ДаніКомплекту <> Неопределено И ВидОтр = "Монтаж" И ВидВідпр = "Вироб" Тогда
				Крок = К.ПеремещениеКомплектаНаМонтаж;
				НоменклатураРядка = ДаніКомплекту.Номенклатура;
				КількістьРядка = ДаніКомплекту.Количество;
			ИначеЕсли ВидОтр <> Неопределено Тогда
				Крок = ?(ВидОтр = "Монтаж", К.ПеремещениеМатериаловНаМонтаж, К.ПеремещениеМатериаловНаПроизводство);
			Иначе
				Крок = К.ВозвратОстатков;
				СкладРядка = СтрФ.СкладОтправитель;
			КонецЕсли;
		ИначеЕсли СтрФ.Тип = 2 Тогда
			Если ВидОтр = "Монтаж" Тогда
				Крок = ?(СтрФ.ПоНорме, К.КомплектацияМонтажПоНормам, К.КомплектацияМонтажДодаткова);
			Иначе
				Крок = ?(СтрФ.ПоНорме, К.КомплектацияПроизводствоПоНормам, К.КомплектацияПроизводствоДодаткова);
			КонецЕсли;
		ИначеЕсли СтрФ.Тип = 3 Тогда
			Крок = ?(ВидОтр = "Монтаж", К.ПередачаМалоценкиМонтаж, К.ПередачаМалоценкиПроизводство);
		ИначеЕсли СтрФ.Тип = 4 Тогда
			Крок = К.Реализация;
		ИначеЕсли СтрФ.Тип = 5 Тогда
			Если ВидОтр = "Монтаж" Тогда
				Крок = К.ДосписаниеМонтажа;
			ИначеЕсли ВимогиЗКомплектом[СтрФ.Док] <> Неопределено Тогда
				Крок = К.СписаниеПонаднормыПроизводства;
				НоменклатураРядка = Пар.Комплект;
			Иначе
				Крок = К.ПрочееДвижение;
			КонецЕсли;
		КонецЕсли;
		Если Крок = Неопределено Тогда
			Крок = К.ПрочееДвижение;
		КонецЕсли;
		НовийРядок = ДодатиРядокКарти(Крок, СкладРядка, СтрФ.Организация, Пар.ДатаD, Пар.ДатаM);
		НовийРядок.СкладОтправитель = СкладВідпр;
		НовийРядок.Документ = СтрФ.Док;
		НовийРядок.ДатаФакт = СтрФ.Дата;
		НовийРядок.Проведен = СтрФ.Проведен;
		Если ЦеКрокДокументів(Крок) Тогда
			НовийРядок.Номенклатура = НоменклатураРядка;
			НовийРядок.Количество = КількістьРядка;
		КонецЕсли;
		Если СтрФ.ПометкаУдаления Тогда
			НовийРядок.Статус = С.Информационно;
			НовийРядок.ОписаниеОперации = "Помічений на видалення";
		ИначеЕсли Крок = К.ВозвратОстатков Или Крок = К.ПрочееДвижение Тогда
			НовийРядок.Статус = С.Информационно;
			НовийРядок.ОписаниеОперации = ?(Крок = К.ВозвратОстатков, "Вибуття зі складу будинку на " + Строка(СтрФ.Склад), "Не належить до кроків циклу");
		ИначеЕсли СтрФ.Проведен Тогда
			НовийРядок.Статус = С.Проведен;
		Иначе
			НовийРядок.Статус = С.НеПроведен;
		КонецЕсли;
		Ключ = Строка(Крок) + "|" + Строка(СкладРядка);
		Если Наявні[Ключ] = Неопределено Тогда
			Наявні.Вставить(Ключ, НовийРядок);
		КонецЕсли;
		Если СтрФ.Проведен И Не СтрФ.ПометкаУдаления Тогда
			Попередня = ДатиКроків[Ключ];
			Если Попередня = Неопределено Или СтрФ.Дата > Попередня Тогда
				ДатиКроків.Вставить(Ключ, СтрФ.Дата);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(Пар.Реалізація) И ПроведенаРеал <> Неопределено И ПроведенаРеал <> Пар.Реалізація Тогда
		Рез.Помилки.Добавить("У реквізиті «Документ реалізації» непроведена " + Строка(Пар.Реалізація) + ", а будинок уже реалізовано проведеною "
			+ Строка(ПроведенаРеал) + " — перевірте, чи це не дубль.");
	КонецЕсли;

	// --- хронологія ---
	Для Каждого РядокКарти Из ВсіРядкиКарти() Цикл
		Если РядокКарти.Статус = С.Информационно Или Не ЗначениеЗаполнено(РядокКарти.ДатаФакт) Тогда
			Продолжить;
		КонецЕсли;
		Крок = РядокКарти.ВидОперации;
		ВидСкладуРядка = ВидПоСкладу[РядокКарти.Склад];
		Порушення = "";
		Если Крок = К.ПеремещениеМатериаловНаПроизводство Или Крок = К.ПеремещениеМатериаловНаМонтаж Тогда
			Дедлайн = ДедлайнПриходу(ВидСкладуРядка, Пар.ДатаD, Пар.ДатаM);
			Если РядокКарти.ДатаФакт > Дедлайн Тогда
				Порушення = "Приїхало " + Формат(РядокКарти.ДатаФакт, "ДФ='dd.MM HH:mm'") + ", дедлайн " + Формат(Дедлайн, "ДФ='dd.MM HH:mm'")
					+ " — пізніше на " + Формат((РядокКарти.ДатаФакт - Дедлайн) / 86400, "ЧДЦ=1") + " дн. Рекомендована дата у колонці «Планова дата».";
			КонецЕсли;
		ИначеЕсли Крок = К.ПеремещениеКомплектаНаМонтаж Тогда
			ДатаКомпл = ДатиКроків[Строка(К.КомплектацияПроизводствоПоНормам) + "|" + Строка(РядокКарти.СкладОтправитель)];
			Если ДатаКомпл <> Неопределено И РядокКарти.ДатаФакт <= ДатаКомпл Тогда
				Порушення = "Переміщення комплекту " + Формат(РядокКарти.ДатаФакт, "ДФ='dd.MM HH:mm:ss'") + " не пізніше комплектації "
					+ Формат(ДатаКомпл, "ДФ='dd.MM HH:mm:ss'");
			КонецЕсли;
		ИначеЕсли Крок = К.Реализация Тогда
			Если РядокКарти.ДатаФакт <= Пар.ДатаD + 10 * 3600 Тогда
				Порушення = "Реалізація " + Формат(РядокКарти.ДатаФакт, "ДФ='dd.MM HH:mm'") + " раніше переміщення комплекту (D 10:00)";
			КонецЕсли;
			ПеревіркаРеал = ПеревіркаРеалізації(РядокКарти.Документ, Пар);
			Если ПеревіркаРеал <> "" Тогда
				Порушення = Порушення + ?(Порушення = "", "", " | ") + ПеревіркаРеал;
			КонецЕсли;
		ИначеЕсли Крок = К.ДосписаниеМонтажа Тогда
			ДатаКомпл = ДатиКроків[Строка(К.КомплектацияМонтажПоНормам) + "|" + Строка(РядокКарти.Склад)];
			ДатаКомплД = ДатиКроків[Строка(К.КомплектацияМонтажДодаткова) + "|" + Строка(РядокКарти.Склад)];
			Если ДатаКомплД <> Неопределено И (ДатаКомпл = Неопределено Или ДатаКомплД > ДатаКомпл) Тогда
				ДатаКомпл = ДатаКомплД;
			КонецЕсли;
			Если ДатаКомпл <> Неопределено И РядокКарти.ДатаФакт <= ДатаКомпл Тогда
				Порушення = "Досписання " + Формат(РядокКарти.ДатаФакт, "ДФ='dd.MM HH:mm'") + " раніше комплектації монтажу "
					+ Формат(ДатаКомпл, "ДФ='dd.MM HH:mm'") + " — на складі ще немає комплекту";
			КонецЕсли;
		КонецЕсли;
		Если Порушення <> "" Тогда
			РядокКарти.Статус = С.НарушениеХронологии;
			РядокКарти.ОписаниеОперации = Лев(Порушення, 200);
		КонецЕсли;
		// Підрозділ документа = дім складу (фільтр партій — строга рівність Субконто2.Подразделение).
		ПеревіркаПідр = ПеревіркаПідрозділуДокумента(РядокКарти);
		Если ПеревіркаПідр.Порушення Тогда
			РядокКарти.Статус = С.НарушениеПодразделения;
			РядокКарти.ОписаниеОперации = Лев(ПеревіркаПідр.Текст + ?(Порушення <> "", " | " + Порушення, ""), 200);
		ИначеЕсли ПеревіркаПідр.Текст <> "" И Не ЗначениеЗаполнено(РядокКарти.ОписаниеОперации) Тогда
			РядокКарти.ОписаниеОперации = Лев(ПеревіркаПідр.Текст, 200);
		КонецЕсли;
	КонецЦикла;

	// --- планові рядки для обов'язкових кроків ---
	ДатаЗаборони = ДатаЗабориниЗмін();
	ЄДодаткова = Ложь;
	Для Каждого РядокСкладу Из Пар.Склади Цикл
		СкладБ = РядокСкладу.Склад;
		Если РядокСкладу.Вид = "Вироб" И РядокСкладу.Организация = Организация Тогда
			ЄКомпл = Наявні[Строка(К.КомплектацияПроизводствоПоНормам) + "|" + Строка(СкладБ)] <> Неопределено;
			ЄДодаткова = ЄДодаткова Или Наявні[Строка(К.КомплектацияПроизводствоДодаткова) + "|" + Строка(СкладБ)] <> Неопределено;
			Если Не ЄКомпл Тогда
				ДодатиПлановийРядок(К.КомплектацияПроизводствоПоНормам, СкладБ, РядокСкладу.Организация, Пар, ДатаЗаборони,
					"Створюється кнопкою «Перерахувати і провести» (контур комплектацій)");
			КонецЕсли;
			ЄПереміщенняКомпл = Ложь;
			Для Каждого РядокКарти Из ДокументыОтрузкиИДосписания Цикл
				Если РядокКарти.ВидОперации = К.ПеремещениеКомплектаНаМонтаж И РядокКарти.СкладОтправитель = СкладБ Тогда
					ЄПереміщенняКомпл = Истина;
				КонецЕсли;
			КонецЦикла;
			Если Не ЄПереміщенняКомпл Тогда
				СкладМонтажу = ПершийСкладВиду(Пар, "Монтаж");
				Если ЗначениеЗаполнено(СкладМонтажу) Тогда
					НовийРядок = ДодатиПлановийРядок(К.ПеремещениеКомплектаНаМонтаж, СкладМонтажу, РядокСкладу.Организация, Пар, ДатаЗаборони,
						?(ЗначениеЗаполнено(ДатаОтгрузкиПоКазне), "Буде створено: весь залишок 26 (" + Строка(Пар.Комплект) + ") → " + Строка(СкладМонтажу),
						"Потрібне підтвердження відвантаження: заповніть «Дата відвантаження по казні»"));
					НовийРядок.СкладОтправитель = СкладБ;
					НовийРядок.Номенклатура = Пар.Комплект;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли РядокСкладу.Вид = "Монтаж" Тогда
			Если Наявні[Строка(К.Реализация) + "|" + Строка(СкладБ)] = Неопределено Тогда
				Зразок = ЗразокДокументаЦиклу(К.Реализация, Пар);
				Если Зразок = Неопределено Тогда
					НовийРядок = ДодатиПлановийРядок(К.Реализация, СкладБ, РядокСкладу.Организация, Пар, ДатаЗаборони,
						"Немає зразка реалізації по проєкту — першу створює бухгалтер (контрагент, договір, ціна)");
					НовийРядок.Статус = С.ОжидаетБухгалтера;
				Иначе
					НовийРядок = ДодатиПлановийРядок(К.Реализация, СкладБ, РядокСкладу.Организация, Пар, ДатаЗаборони,
						"Буде створено за зразком " + Строка(Зразок.Док) + ?(Зразок.ЗКомплектом, " (з проведенням, ціна зразка — перевірте)",
						" (інший комплект — без проведення, ціну вкаже бухгалтер)"));
				КонецЕсли;
				НовийРядок.Номенклатура = Пар.Комплект;
			КонецЕсли;
			Если Наявні[Строка(К.КомплектацияМонтажПоНормам) + "|" + Строка(СкладБ)] = Неопределено Тогда
				ДодатиПлановийРядок(К.КомплектацияМонтажПоНормам, СкладБ, РядокСкладу.Организация, Пар, ДатаЗаборони,
					"Створюється кнопкою «Перерахувати і провести» (контур комплектацій)");
			КонецЕсли;
			Если Наявні[Строка(К.ДосписаниеМонтажа) + "|" + Строка(СкладБ)] = Неопределено Тогда
				НовийРядок = ДодатиПлановийРядок(К.ДосписаниеМонтажа, СкладБ, РядокСкладу.Организация, Пар, ДатаЗаборони,
					?(СписанняПідтверджено, "Буде створено: вимога Кт 26 → Дт 231 на весь залишок складу монтажу",
					"Потрібна позначка «Списання підтверджено» (монтаж завершено, довозу не буде)"));
				НовийРядок.Номенклатура = Пар.Комплект;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ДодатиПлановийРядок(Крок, СкладБ, ОргБ, Пар, ДатаЗаборони, Опис)
	НовийРядок = ДодатиРядокКарти(Крок, СкладБ, ОргБ, Пар.ДатаD, Пар.ДатаM);
	НовийРядок.ОписаниеОперации = Лев(Опис, 200);
	Если ЗначениеЗаполнено(ДатаЗаборони) И НовийРядок.Дата <= ДатаЗаборони Тогда
		НовийРядок.Статус = Перечисления.А_СтатусыШагаЦикла.ЗакрытыйПериод;
	ИначеЕсли НовийРядок.Дата < ТекущаяДата() Тогда
		НовийРядок.Статус = Перечисления.А_СтатусыШагаЦикла.Просрочен;
	КонецЕсли;
	Возврат НовийРядок;
КонецФункции

Функция ПершийСкладВиду(Пар, Вид)
	Для Каждого РядокСкладу Из Пар.Склади Цикл
		Если РядокСкладу.Вид = Вид И РядокСкладу.Организация = Организация Тогда
			Возврат РядокСкладу.Склад;
		КонецЕсли;
	КонецЦикла;
	Возврат Справочники.Склады.ПустаяСсылка();
КонецФункции

// Реалізація: у рядках зі счётом 26 має бути комплект будинку, 1 шт. Повертає текст порушення або "".
Функция ПеревіркаРеалізації(ДокРеалізації, Пар)
	Если Не ЗначениеЗаполнено(ДокРеалізації) Или Не ЗначениеЗаполнено(Пар.Комплект) Тогда
		Возврат "";
	КонецЕсли;
	Кількість = 0;
	ЧужаНоменклатура = "";
	Для Каждого РядокТоварів Из ДокРеалізації.Товары Цикл
		Если РядокТоварів.СчетУчетаБУ <> Пар.Рахунок26 Тогда
			Продолжить;
		КонецЕсли;
		Если РядокТоварів.Номенклатура = Пар.Комплект Тогда
			Кількість = Кількість + РядокТоварів.Количество;
		Иначе
			ЧужаНоменклатура = ЧужаНоменклатура + ?(ЧужаНоменклатура = "", "", ", ") + Строка(РядокТоварів.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Текст = "";
	Если Кількість = 0 Тогда
		Текст = "у реалізації немає комплекту будинку «" + Строка(Пар.Комплект) + "» на рахунку 26";
	ИначеЕсли Кількість <> 1 Тогда
		Текст = "у реалізації комплект " + Формат(Кількість, "ЧДЦ=3; ЧН=0") + " шт (очікується 1)";
	КонецЕсли;
	Если ЧужаНоменклатура <> "" Тогда
		Текст = Текст + ?(Текст = "", "", "; ") + "інша номенклатура на 26: " + ЧужаНоменклатура;
	КонецЕсли;
	Возврат Текст;
КонецФункции

// Цільовий підрозділ документа для партій: дім складу (для переміщення — складу-одержувача).
// Реалізація не перевіряється (підрозділ = корінь проєкту — норма). Повертає порожню ссылку, якщо не перевіряємо.
Функция ЦільовийПідрозділДокумента(РядокКарти)
	Если Не ЗначениеЗаполнено(РядокКарти.Документ) Или Не ЗначениеЗаполнено(РядокКарти.Склад) Тогда
		Возврат Справочники.Подразделения.ПустаяСсылка();
	КонецЕсли;
	ТипДок = ТипЗнч(РядокКарти.Документ);
	К = Перечисления.А_ШагиЦиклаДомика;
	Если ТипДок = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		Крок = РядокКарти.ВидОперации;
		Если Крок <> К.ПеремещениеМатериаловНаПроизводство И Крок <> К.ПеремещениеМатериаловНаМонтаж И Крок <> К.ПеремещениеКомплектаНаМонтаж Тогда
			Возврат Справочники.Подразделения.ПустаяСсылка(); // вибуття/повернення — партія створюється не в нас
		КонецЕсли;
		Возврат РядокКарти.Склад.Подразделение;
	ИначеЕсли ТипДок = Тип("ДокументСсылка.КомплектацияНоменклатуры")
		Или ТипДок = Тип("ДокументСсылка.ТребованиеНакладная")
		Или ТипДок = Тип("ДокументСсылка.ПередачаМалоценныхАктивовВЭксплуатацию") Тогда
		Возврат РядокКарти.Склад.Подразделение;
	КонецЕсли;
	Возврат Справочники.Подразделения.ПустаяСсылка();
КонецФункции

// Структура: Порушення (Булево), Текст. Для переміщення додатково — примітка про «З підрозділу» (без зміни статусу).
Функция ПеревіркаПідрозділуДокумента(РядокКарти)
	Рез = Новый Структура("Порушення, Текст", Ложь, "");
	Ціль = ЦільовийПідрозділДокумента(РядокКарти);
	Если Не ЗначениеЗаполнено(Ціль) Тогда
		Возврат Рез;
	КонецЕсли;
	ПідрозділДок = РядокКарти.Документ.Подразделение;
	Если ПідрозділДок <> Ціль Тогда
		Рез.Порушення = Истина;
		Рез.Текст = "Підрозділ документа «" + Строка(ПідрозділДок) + "» ≠ дім складу «" + Строка(Ціль)
			+ "»: партія не для будинку — комплектація її не спише";
	КонецЕсли;
	Если ТипЗнч(РядокКарти.Документ) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		ПідрозділЗ = РядокКарти.Документ.Подразделение1;
		СкладВідпр = РядокКарти.Документ.СкладОтправитель;
		Если ЗначениеЗаполнено(ПідрозділЗ) И ЗначениеЗаполнено(СкладВідпр) И ПідрозділЗ <> СкладВідпр.Подразделение Тогда
			Рез.Текст = Рез.Текст + ?(Рез.Текст = "", "", "; ") + "«З підрозділу» = «" + Строка(ПідрозділЗ)
				+ "» ≠ дім складу-відправника «" + Строка(СкладВідпр.Подразделение) + "» (партії відправника — лише цього підрозділу)";
		КонецЕсли;
	КонецЕсли;
	Возврат Рез;
КонецФункции

Функция ЗберегтиВідміткиКарти()
	Відмітки = Новый Соответствие;
	Для Каждого РядокКарти Из ВсіРядкиКарти() Цикл
		Если ЗначениеЗаполнено(РядокКарти.Документ) И (РядокКарти.Виправити Или ЗначениеЗаполнено(РядокКарти.ДатаДоПереноса)) Тогда
			Відмітки.Вставить(РядокКарти.Документ, Новый Структура("Виправити, ДатаДоПереноса", РядокКарти.Виправити, РядокКарти.ДатаДоПереноса));
		КонецЕсли;
	КонецЦикла;
	Возврат Відмітки;
КонецФункции

Процедура ВідновитиВідміткиКарти(Відмітки)
	Для Каждого РядокКарти Из ВсіРядкиКарти() Цикл
		Дані = Відмітки[РядокКарти.Документ];
		Если Дані <> Неопределено Тогда
			РядокКарти.Виправити = Дані.Виправити;
			РядокКарти.ДатаДоПереноса = Дані.ДатаДоПереноса;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Дата заборони зміни даних для поточного користувача (персональна, інакше «для всіх»).
Функция ДатаЗабориниЗмін()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(Р.ДатаЗапрета) КАК ДатаЗапрета
	|ИЗ
	|	РегистрСведений.ДатыЗапретаИзменения КАК Р
	|ГДЕ
	|	Р.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	Вибірка = Запрос.Выполнить().Выбрать();
	Если Вибірка.Следующий() И ЗначениеЗаполнено(Вибірка.ДатаЗапрета) Тогда
		Возврат Вибірка.ДатаЗапрета;
	КонецЕсли;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(Р.ДатаЗапрета) КАК ДатаЗапрета
	|ИЗ
	|	РегистрСведений.ДатыЗапретаИзменения КАК Р
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(Р.Пользователь) = ТИП(Перечисление.ВидыНазначенияДатЗапрета)";
	Вибірка = Запрос.Выполнить().Выбрать();
	Если Вибірка.Следующий() И ЗначениеЗаполнено(Вибірка.ДатаЗапрета) Тогда
		Возврат Вибірка.ДатаЗапрета;
	КонецЕсли;
	Возврат '00010101';
КонецФункции

// Документ належить будинку: склад у списку складів розрахунку і організація збігається (захист від чужих посилань).
Функция ПеревіритиСкладДокумента(ДокОбъект)
	Склади = СкладиБудинку();
	СкладиМассив = Склади.ВыгрузитьКолонку("Склад");
	Если Склади.ВыгрузитьКолонку("Организация").Найти(ДокОбъект.Организация) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипДок = ТипЗнч(ДокОбъект.Ссылка);
	Если ТипДок = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		Возврат СкладиМассив.Найти(ДокОбъект.СкладПолучатель) <> Неопределено Или СкладиМассив.Найти(ДокОбъект.СкладОтправитель) <> Неопределено;
	КонецЕсли;
	Возврат СкладиМассив.Найти(ДокОбъект.Склад) <> Неопределено;
КонецФункции

// ---------------------------------------------------------------------------
// Створення документів
// ---------------------------------------------------------------------------

// Залишок рахунку 26 по номенклатурі на складі/організації на момент (для кількостей переміщення/вимоги).
Функция Залишок26(СкладБ, ОргБ, Момент, Рахунок26)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(О.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	О.Субконто1.БазоваяЕдиницаИзмерения КАК Единица,
	|	О.НалоговоеНазначение КАК НалоговоеНазначение,
	|	СУММА(О.КоличествоОстаток) КАК Кол,
	|	СУММА(О.СуммаОстаток) КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&НаДату, Счет = &Счет26, , Субконто3 = &Склад И Организация = &Орг) КАК О
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(О.Субконто1 КАК Справочник.Номенклатура),
	|	О.Субконто1.БазоваяЕдиницаИзмерения,
	|	О.НалоговоеНазначение
	|ИМЕЮЩИЕ
	|	СУММА(О.КоличествоОстаток) > 0";
	Запрос.УстановитьПараметр("НаДату", Момент);
	Запрос.УстановитьПараметр("Счет26", Рахунок26);
	Запрос.УстановитьПараметр("Склад", СкладБ);
	Запрос.УстановитьПараметр("Орг", ОргБ);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция НапрямокВиробництво()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Н.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Направления КАК Н
	|ГДЕ
	|	Н.Наименование = &Имя
	|	И НЕ Н.ПометкаУдаления";
	Запрос.УстановитьПараметр("Имя", "Производство");
	Вибірка = Запрос.Выполнить().Выбрать();
	Если Вибірка.Следующий() Тогда
		Возврат Вибірка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Направления.ПустаяСсылка();
КонецФункции

Функция КоріньПроєкту()
	Корінь = Подразделение;
	Лічильник = 0;
	Пока ЗначениеЗаполнено(Корінь) И ЗначениеЗаполнено(Корінь.Родитель) И Лічильник < 10 Цикл
		Корінь = Корінь.Родитель;
		Лічильник = Лічильник + 1;
	КонецЦикла;
	Возврат Корінь;
КонецФункции

// Шаблон аналітики витрат: остання проведена вимога проєкту з цим рахунком витрат.
Функция ШаблонВимоги(КодРахунку)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Док,
	|	Т.Субконто1 КАК Субконто1,
	|	Т.Субконто2 КАК Субконто2,
	|	Т.Субконто3 КАК Субконто3,
	|	Т.НалоговоеНазначениеДоходовИЗатрат КАК НалоговоеНазначениеДоходовИЗатрат
	|ИЗ
	|	Документ.ТребованиеНакладная КАК Т
	|ГДЕ
	|	Т.Проведен
	|	И НЕ Т.ПометкаУдаления
	|	И Т.Подразделение В ИЕРАРХИИ (&Корень)
	|	И Т.СчетЗатрат = &СчетЗатрат
	|	И НЕ Т.СчетаУчетаЗатратВТаблице
	|УПОРЯДОЧИТЬ ПО
	|	Т.Дата УБЫВ";
	Запрос.УстановитьПараметр("Корень", КоріньПроєкту());
	Запрос.УстановитьПараметр("СчетЗатрат", ПланыСчетов.Хозрасчетный.НайтиПоКоду(КодРахунку));
	Вибірка = Запрос.Выполнить().Выбрать();
	Если Вибірка.Следующий() Тогда
		Возврат Новый Структура("Док, Субконто1, Субконто2, Субконто3, НалоговоеНазначениеДоходовИЗатрат",
			Вибірка.Док, Вибірка.Субконто1, Вибірка.Субконто2, Вибірка.Субконто3, Вибірка.НалоговоеНазначениеДоходовИЗатрат);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Проведена реалізація будинку: реквізит шапки (якщо проведений), інакше перша проведена з фактів. Неопределено — немає.
Функция ПроведенаРеалізаціяБудинку(Факт, Пар)
	Если ЗначениеЗаполнено(Пар.Реалізація) И Пар.Реалізація.Проведен И Не Пар.Реалізація.ПометкаУдаления Тогда
		Возврат Пар.Реалізація;
	КонецЕсли;
	Для Каждого СтрФ Из Факт Цикл
		Если СтрФ.Тип = 4 И СтрФ.Проведен И Не СтрФ.ПометкаУдаления Тогда
			Возврат СтрФ.Док;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Останній проведений документ-зразок проєкту для кроку циклу (реалізація / переміщення комплекту / досписання монтажу):
// спершу з комплектом цього будинку, інакше будь-який комплект проєкту. Структура (Док, ЗКомплектом) або Неопределено.
Функция ЗразокДокументаЦиклу(Крок, Пар)
	К = Перечисления.А_ШагиЦиклаДомика;
	Если Крок = К.Реализация Тогда
		УмоваКомплекту = "И РТ.Номенклатура = &Комплект";
		Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Р.Ссылка КАК Док
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Р
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РТ
		|		ПО РТ.Ссылка = Р.Ссылка
		|ГДЕ
		|	Р.Проведен
		|	И НЕ Р.ПометкаУдаления
		|	И Р.Подразделение В ИЕРАРХИИ (&Корень)
		|	И РТ.СчетУчетаБУ = &Счет26
		|	И РТ.Номенклатура = &Комплект
		|УПОРЯДОЧИТЬ ПО
		|	Р.Дата УБЫВ";
	ИначеЕсли Крок = К.ПеремещениеКомплектаНаМонтаж Тогда
		УмоваКомплекту = "И ПТ.Номенклатура = &Комплект";
		Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	П.Ссылка КАК Док
		|ИЗ
		|	Документ.ПеремещениеТоваров КАК П
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПеремещениеТоваров.Товары КАК ПТ
		|		ПО ПТ.Ссылка = П.Ссылка
		|ГДЕ
		|	П.Проведен
		|	И НЕ П.ПометкаУдаления
		|	И П.Подразделение В ИЕРАРХИИ (&Корень)
		|	И П.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПеремещениеТоваров.ТоварыПродукция)
		|	И П.СкладПолучатель.А_ВидСклада = ЗНАЧЕНИЕ(Перечисление.А_ВидСклада.Монтаж)
		|	И П.СкладОтправитель.А_ВидСклада = ЗНАЧЕНИЕ(Перечисление.А_ВидСклада.Производственный)
		|	И ПТ.СчетУчетаБУ = &Счет26
		|	И ПТ.Номенклатура = &Комплект
		|УПОРЯДОЧИТЬ ПО
		|	П.Дата УБЫВ";
	ИначеЕсли Крок = К.ДосписаниеМонтажа Тогда
		УмоваКомплекту = "И ТМ.Номенклатура = &Комплект";
		Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Ссылка КАК Док
		|ИЗ
		|	Документ.ТребованиеНакладная КАК Т
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТребованиеНакладная.Материалы КАК ТМ
		|		ПО ТМ.Ссылка = Т.Ссылка
		|ГДЕ
		|	Т.Проведен
		|	И НЕ Т.ПометкаУдаления
		|	И Т.Подразделение В ИЕРАРХИИ (&Корень)
		|	И Т.СчетЗатрат = &Счет231
		|	И НЕ Т.СчетаУчетаЗатратВТаблице
		|	И Т.Склад.А_ВидСклада = ЗНАЧЕНИЕ(Перечисление.А_ВидСклада.Монтаж)
		|	И ТМ.Счет = &Счет26
		|	И ТМ.Номенклатура = &Комплект
		|УПОРЯДОЧИТЬ ПО
		|	Т.Дата УБЫВ";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Корень", КоріньПроєкту());
	Запрос.УстановитьПараметр("Счет26", Пар.Рахунок26);
	Запрос.УстановитьПараметр("Счет231", ПланыСчетов.Хозрасчетный.НайтиПоКоду("231"));
	Запрос.УстановитьПараметр("Комплект", Пар.Комплект);
	Для Спроба = 1 По 2 Цикл
		Если Спроба = 1 И Не ЗначениеЗаполнено(Пар.Комплект) Тогда
			Продолжить;
		КонецЕсли;
		Запрос.Текст = ?(Спроба = 1, Текст, СтрЗаменить(Текст, УмоваКомплекту, ""));
		Вибірка = Запрос.Выполнить().Выбрать();
		Если Вибірка.Следующий() Тогда
			Возврат Новый Структура("Док, ЗКомплектом", Вибірка.Док, Спроба = 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Коментар реалізації: маршрут/село з опису відвантаження по казні (3-й рядок), інакше коментар зразка з позначкою.
Функция КоментарРеалізації(КоментарЗразка)
	Рядки = СтрРазделить(СтрЗаменить(ОписаниеОтгрузкиПоКазне, Символы.ВК, ""), Символы.ПС);
	Если Рядки.Количество() >= 3 И ЗначениеЗаполнено(СокрЛП(Рядки[2])) Тогда
		Возврат СокрЛП(Рядки[2]);
	КонецЕсли;
	Возврат СокрЛП(КоментарЗразка) + " (зі зразка — перевірте)";
КонецФункции

// Реалізація будинку за зразком попередньої реалізації проєкту: контрагент, договір, рахунки, ПДВ, «Отримав»,
// підрозділ (корінь проєкту) — зі зразка; склад монтажу, дата D 12:00, комплект 1 шт — цього будинку.
// Той самий комплект — проводиться (ціна зразка, перевірити); інший комплект — без проведення, ціну вкаже бухгалтер.
Процедура СтворитиРеалізацію(РядокКарти, Пар, Рез)
	Если ЗначениеЗаполнено(Пар.Реалізація) Тогда
		РядокКарти.ОписаниеОперации = "Реалізацію вже знайдено: " + Строка(Пар.Реалізація);
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Пар.Комплект) Тогда
		РядокКарти.ОписаниеОперации = "Не визначено комплект будинку";
		Возврат;
	КонецЕсли;
	// Комплект має лежати на складі монтажу (переміщення комплекту проведене).
	Залишки = Залишок26(РядокКарти.Склад, РядокКарти.Организация, РядокКарти.Дата - 1, Пар.Рахунок26);
	ЄКомплект = Ложь;
	Для Каждого РядокЗалишку Из Залишки Цикл
		Если РядокЗалишку.Номенклатура = Пар.Комплект И РядокЗалишку.Кол >= 1 Тогда
			ЄКомплект = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Не ЄКомплект Тогда
		РядокКарти.ОписаниеОперации = "Спершу проведіть переміщення комплекту на монтаж: на складі " + Строка(РядокКарти.Склад)
			+ " немає «" + Строка(Пар.Комплект) + "» на рахунку 26 на " + Формат(РядокКарти.Дата, "ДФ='dd.MM.yyyy HH:mm'");
		Возврат;
	КонецЕсли;
	Зразок = ЗразокДокументаЦиклу(Перечисления.А_ШагиЦиклаДомика.Реализация, Пар);
	Если Зразок = Неопределено Тогда
		РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.ОжидаетБухгалтера;
		РядокКарти.ОписаниеОперации = "Немає зразка реалізації по проєкту — першу створює бухгалтер (контрагент, договір, ціна)";
		Возврат;
	КонецЕсли;
	ДокОбъект = Зразок.Док.ПолучитьОбъект().Скопировать();
	ДокОбъект.Дата = РядокКарти.Дата;
	ДокОбъект.Организация = РядокКарти.Организация;
	ДокОбъект.Склад = РядокКарти.Склад;
	ДокОбъект.Ответственный = Пользователи.ТекущийПользователь();
	ДокОбъект.Комментарий = КоментарРеалізації(ДокОбъект.Комментарий);
	Для Каждого ТЧМета Из ДокОбъект.Метаданные().ТабличныеЧасти Цикл
		Если ТЧМета.Имя <> "Товары" Тогда
			ДокОбъект[ТЧМета.Имя].Очистить();
		КонецЕсли;
	КонецЦикла;
	// Один рядок: комплект будинку, 1 шт, рахунок 26 — рядок зразка (краще з тим самим комплектом).
	ІндексРядка = -1;
	Для Індекс = 0 По ДокОбъект.Товары.Количество() - 1 Цикл
		РядокТоварів = ДокОбъект.Товары[Індекс];
		Если РядокТоварів.СчетУчетаБУ = Пар.Рахунок26 И (ІндексРядка < 0 Или РядокТоварів.Номенклатура = Пар.Комплект) Тогда
			ІндексРядка = Індекс;
		КонецЕсли;
	КонецЦикла;
	Если ІндексРядка < 0 Тогда
		ВызватьИсключение "у зразку " + Строка(Зразок.Док) + " немає рядка з рахунком 26";
	КонецЕсли;
	ДаніРядка = ДокОбъект.Товары.Выгрузить()[ІндексРядка];
	ДокОбъект.Товары.Очистить();
	НС = ДокОбъект.Товары.Добавить();
	ЗаполнитьЗначенияСвойств(НС, ДаніРядка);
	ЦінаВідома = (НС.Номенклатура = Пар.Комплект);
	Если Не ЦінаВідома Тогда
		НС.Номенклатура = Пар.Комплект;
		НС.ЕдиницаИзмерения = Пар.Комплект.БазоваяЕдиницаИзмерения;
		НС.Цена = 0;
		НС.Сумма = 0;
		НС.СуммаНДС = 0;
		НС.СуммаБезСкидки = 0;
	ИначеЕсли НС.Количество <> 1 И НС.Количество <> 0 Тогда
		// зразок продавав іншу кількість — масштабуємо на 1 шт
		НС.Сумма = Окр(НС.Сумма / НС.Количество, 2);
		НС.СуммаНДС = Окр(НС.СуммаНДС / НС.Количество, 2);
		НС.СуммаБезСкидки = Окр(НС.СуммаБезСкидки / НС.Количество, 2);
	КонецЕсли;
	НС.Количество = 1;
	НС.Коэффициент = 1;
	ДокОбъект.СуммаДокумента = ДокОбъект.Товары.Итог("Сумма");
	Если ЦінаВідома Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		ЗаповнитиРядокСтвореним(РядокКарти, ДокОбъект, Рез);
		Рез.Сообщения.Добавить("Реалізацію " + Строка(ДокОбъект.Ссылка) + " створено за зразком " + Строка(Зразок.Док) + ": ціна "
			+ Формат(НС.Сумма, "ЧДЦ=2; ЧРГ=' '") + " грн з ПДВ (зі зразка — перевірте), коментар «" + ДокОбъект.Комментарий + "».");
	Иначе
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		ЗаповнитиРядокСтвореним(РядокКарти, ДокОбъект, Рез);
		РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.ОжидаетБухгалтера;
		РядокКарти.ОписаниеОперации = "Створено без проведення (зразок " + Строка(Зразок.Док) + " — інший комплект): вкажіть ціну і проведіть";
		Рез.Сообщения.Добавить("Реалізацію " + Строка(ДокОбъект.Ссылка) + " створено БЕЗ проведення за зразком " + Строка(Зразок.Док)
			+ " (інший комплект — ціну не визначено): вкажіть ціну і проведіть.");
	КонецЕсли;
	ДокументРеализацияТоваровУслуг = ДокОбъект.Ссылка;
	Пар.Реалізація = ДокОбъект.Ссылка;
КонецПроцедуры

Процедура СтворитиПереміщенняКомплекту(РядокКарти, Пар, Рез)
	Если Не ЗначениеЗаполнено(ДатаОтгрузкиПоКазне) Тогда
		РядокКарти.ОписаниеОперации = "Потрібне підтвердження відвантаження: заповніть «Дата відвантаження по казні»";
		Возврат;
	КонецЕсли;
	Якщо = ЗначениеЗаполнено(РядокКарти.СкладОтправитель) И ЗначениеЗаполнено(РядокКарти.Склад);
	Если Не Якщо Тогда
		ВызватьИсключение "не визначено склади переміщення";
	КонецЕсли;
	Залишки = Залишок26(РядокКарти.СкладОтправитель, РядокКарти.Организация, РядокКарти.Дата - 1, Пар.Рахунок26);
	Если Залишки.Количество() = 0 Тогда
		ВызватьИсключение "на складі " + Строка(РядокКарти.СкладОтправитель) + " немає комплекту на рахунку 26 на "
			+ Формат(РядокКарти.Дата, "ДФ='dd.MM.yyyy HH:mm:ss'") + " (спершу проведіть комплектацію)";
	КонецЕсли;
	// Рішення замовника: переміщуємо ВЕСЬ залишок 26 виробничого складу (норма + понаднорма = один будинок).
	// Зразок — переміщення комплекту попереднього будинку проєкту (вид операції, напрямок, рахунки — з нього).
	Зразок = ЗразокДокументаЦиклу(Перечисления.А_ШагиЦиклаДомика.ПеремещениеКомплектаНаМонтаж, Пар);
	Если Зразок <> Неопределено Тогда
		ДокОбъект = Зразок.Док.ПолучитьОбъект().Скопировать();
		ДокОбъект._ДокументОснование = Неопределено; // погодження переміщення іншого будинку
		Для Каждого ТЧМета Из ДокОбъект.Метаданные().ТабличныеЧасти Цикл
			ДокОбъект[ТЧМета.Имя].Очистить();
		КонецЦикла;
		Если ЗначениеЗаполнено(ДокОбъект.Подразделение1) Тогда
			ДокОбъект.Подразделение1 = РядокКарти.СкладОтправитель.Подразделение;
		КонецЕсли;
		ОписЗразка = " (зразок: " + Строка(Зразок.Док) + ")";
	Иначе
		ДокОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
		ДокОбъект.ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.ТоварыПродукция;
		ДокОбъект.Направление = НапрямокВиробництво();
		ОписЗразка = "";
	КонецЕсли;
	ДокОбъект.Дата = РядокКарти.Дата;
	ДокОбъект.Организация = РядокКарти.Организация;
	ДокОбъект.СкладОтправитель = РядокКарти.СкладОтправитель;
	ДокОбъект.СкладПолучатель = РядокКарти.Склад;
	ДокОбъект.Подразделение = Подразделение;
	ДокОбъект.Ответственный = Пользователи.ТекущийПользователь();
	ДокОбъект.Комментарий = Строка(Подразделение) + " / розрахунок " + Номер + " / переміщення комплекту на монтаж" + ОписЗразка;
	Для Каждого РядокЗалишку Из Залишки Цикл
		НС = ДокОбъект.Товары.Добавить();
		НС.Номенклатура = РядокЗалишку.Номенклатура;
		НС.Количество = РядокЗалишку.Кол;
		НС.ЕдиницаИзмерения = РядокЗалишку.Единица;
		НС.Коэффициент = 1;
		НС.СчетУчетаБУ = Пар.Рахунок26;
		НС.НовыйСчетУчетаБУ = Пар.Рахунок26;
		НС.НалоговоеНазначение = РядокЗалишку.НалоговоеНазначение;
	КонецЦикла;
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	ЗаповнитиРядокСтвореним(РядокКарти, ДокОбъект, Рез);
КонецПроцедуры

Функция ПереміщенняКомплектуПроведено(СкладБ)
	Для Каждого РядокКарти Из ДокументыОтрузкиИДосписания Цикл
		Если РядокКарти.ВидОперации = Перечисления.А_ШагиЦиклаДомика.ПеремещениеКомплектаНаМонтаж И РядокКарти.СкладОтправитель = СкладБ
			И ЗначениеЗаполнено(РядокКарти.Документ) И РядокКарти.Проведен Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция КількістьПоНормам(СкладБ)
	Для Каждого РядокКарти Из ХронологияПеремещений Цикл
		Если РядокКарти.ВидОперации = Перечисления.А_ШагиЦиклаДомика.КомплектацияПроизводствоПоНормам И РядокКарти.Склад = СкладБ
			И ЗначениеЗаполнено(РядокКарти.Документ) Тогда
			Возврат РядокКарти.Документ.Количество;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
КонецФункции

Процедура СтворитиВимогу(РядокКарти, Пар, Рез, КодРахункуВитрат)
	Если КодРахункуВитрат = "231" И Не СписанняПідтверджено Тогда
		РядокКарти.ОписаниеОперации = "Потрібна позначка «Списання підтверджено» (монтаж завершено, довозу не буде)";
		Возврат;
	КонецЕсли;
	// Списання на витрати — лише після проведеної реалізації: інакше на витрати піде і сам комплект будинку.
	Если Не ЗначениеЗаполнено(Пар.Реалізація) Или Не Пар.Реалізація.Проведен Тогда
		РядокКарти.ОписаниеОперации = "Потрібна проведена реалізація будинку (інакше у " + КодРахункуВитрат + " піде і сам комплект)";
		Возврат;
	КонецЕсли;
	Если КодРахункуВитрат = "901" И Не ПереміщенняКомплектуПроведено(РядокКарти.Склад) Тогда
		РядокКарти.ОписаниеОперации = "Спершу проведіть переміщення комплекту на монтаж (крок 5) — інакше в 901 піде і комплект «за нормами»";
		Возврат;
	КонецЕсли;
	Залишки = Залишок26(РядокКарти.Склад, РядокКарти.Организация, РядокКарти.Дата - 1, Пар.Рахунок26);
	Если Залишки.Количество() = 0 Тогда
		РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.Проведен;
		РядокКарти.ОписаниеОперации = "Списувати нічого: залишок 26 на складі нульовий";
		Возврат;
	КонецЕсли;
	// Зразок — вимога досписання попереднього будинку проєкту (рахунок витрат, субконто, податкове призначення — з неї).
	Зразок = ?(КодРахункуВитрат = "231", ЗразокДокументаЦиклу(Перечисления.А_ШагиЦиклаДомика.ДосписаниеМонтажа, Пар), Неопределено);
	Если Зразок <> Неопределено Тогда
		ДокОбъект = Зразок.Док.ПолучитьОбъект().Скопировать();
		ДокОбъект.ДокументОснование = Неопределено;
		Для Каждого ТЧМета Из ДокОбъект.Метаданные().ТабличныеЧасти Цикл
			ДокОбъект[ТЧМета.Имя].Очистить();
		КонецЦикла;
		ОписЗразка = "зразок: " + Строка(Зразок.Док);
	Иначе
		Шаблон = ШаблонВимоги(КодРахункуВитрат);
		Если Шаблон = Неопределено И КодРахункуВитрат = "901" И ЗначениеЗаполнено(Пар.Комплект) И ЗначениеЗаполнено(Пар.Комплект.НоменклатурнаяГруппа) Тогда
			// зразка немає — аналітика 901 з картки комплекту (номенклатурна група)
			Шаблон = Новый Структура("Док, Субконто1, Субконто2, Субконто3, НалоговоеНазначениеДоходовИЗатрат",
				Пар.Комплект, Пар.Комплект.НоменклатурнаяГруппа, Неопределено, Неопределено, Неопределено);
		КонецЕсли;
		Если Шаблон = Неопределено Тогда
			ВызватьИсключение "не визначено аналітику рахунку " + КодРахункуВитрат + ": немає проведеної вимоги-зразка по проєкту";
		КонецЕсли;
		ДокОбъект = Документы.ТребованиеНакладная.СоздатьДокумент();
		ДокОбъект.ВидОперации = Перечисления.ВидыОперацийТребованиеНакладная.Материалы;
		ДокОбъект.Направление = НапрямокВиробництво();
		ДокОбъект.СчетаУчетаЗатратВТаблице = Ложь;
		ДокОбъект.СчетЗатрат = ПланыСчетов.Хозрасчетный.НайтиПоКоду(КодРахункуВитрат);
		ДокОбъект.Субконто1 = Шаблон.Субконто1;
		ДокОбъект.Субконто2 = Шаблон.Субконто2;
		ДокОбъект.Субконто3 = Шаблон.Субконто3;
		ДокОбъект.НалоговоеНазначениеДоходовИЗатрат = Шаблон.НалоговоеНазначениеДоходовИЗатрат;
		ОписЗразка = "зразок аналітики: " + Строка(Шаблон.Док);
	КонецЕсли;
	ДокОбъект.Дата = РядокКарти.Дата;
	ДокОбъект.Организация = РядокКарти.Организация;
	ДокОбъект.Склад = РядокКарти.Склад;
	ДокОбъект.Подразделение = Подразделение;
	ДокОбъект.Ответственный = Пользователи.ТекущийПользователь();
	ДокОбъект.Комментарий = Строка(Подразделение) + " / розрахунок " + Номер + " / "
		+ ?(КодРахункуВитрат = "901", "списання понаднорми виробництва", "досписання монтажу") + " (" + ОписЗразка + ")";
	Для Каждого РядокЗалишку Из Залишки Цикл
		НС = ДокОбъект.Материалы.Добавить();
		НС.Номенклатура = РядокЗалишку.Номенклатура;
		НС.Количество = РядокЗалишку.Кол;
		НС.ЕдиницаИзмерения = РядокЗалишку.Единица;
		НС.Коэффициент = 1;
		НС.Счет = Пар.Рахунок26;
		НС.НалоговоеНазначение = РядокЗалишку.НалоговоеНазначение;
		Если РядокЗалишку.Номенклатура = Пар.Комплект И РядокЗалишку.Кол > 1 Тогда
			Рез.Сообщения.Добавить("УВАГА: досписання списує " + Формат(РядокЗалишку.Кол, "ЧДЦ=3; ЧН=0") + " комплекти «" + Строка(Пар.Комплект)
				+ "» зі складу " + Строка(РядокКарти.Склад) + " — перевірте кількості комплектацій (норма + понаднорма = 1 будинок).");
		КонецЕсли;
	КонецЦикла;
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	ЗаповнитиРядокСтвореним(РядокКарти, ДокОбъект, Рез);
КонецПроцедуры

Процедура ЗаповнитиРядокСтвореним(РядокКарти, ДокОбъект, Рез)
	РядокКарти.Документ = ДокОбъект.Ссылка;
	РядокКарти.ДатаФакт = ДокОбъект.Дата;
	РядокКарти.Проведен = ДокОбъект.Проведен;
	РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.Создан;
	РядокКарти.ОписаниеОперации = "Створено " + Строка(ДокОбъект.Ссылка);
	Рез.Створено = Рез.Створено + 1;
	Рез.Сообщения.Добавить("Створено " + Строка(ДокОбъект.Ссылка) + " (" + Строка(РядокКарти.ВидОперации) + ")");
	ЗаписьЖурналаРегистрации("РасчетКомплектаций.Цикл будинку", УровеньЖурналаРегистрации.Информация, , Ссылка,
		"Створено " + Строка(ДокОбъект.Ссылка));
КонецПроцедуры

// Кількість у шапці комплектацій сімейства: якщо заповнені і «по нормам», і «понад норму» — по 0,5 кожна
// (разом один будинок); якщо «понад норму» порожня — «по нормам» = 1. Малоцінки не стосується.
Процедура ВирівнятиКількістьКомплектів()
	Для Каждого РядокСімейства Из ДокументиКомплектації Цикл
		ДокНорма = РядокСімейства.ДокументПоНормам;
		ДокДодаткова = РядокСімейства.ДокументДодаткова;
		ЄНорма = ЗначениеЗаполнено(ДокНорма) И Не ДокНорма.ПометкаУдаления И ДокНорма.Комплектующие.Количество() > 0;
		ЄДодаткова = ЗначениеЗаполнено(ДокДодаткова) И Не ДокДодаткова.ПометкаУдаления И ДокДодаткова.Комплектующие.Количество() > 0;
		Если Не ЄНорма Тогда
			Продолжить;
		КонецЕсли;
		ВстановитиКількістьКомплекту(ДокНорма, ?(ЄДодаткова, 0.5, 1));
		Если ЄДодаткова Тогда
			ВстановитиКількістьКомплекту(ДокДодаткова, 0.5);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ВстановитиКількістьКомплекту(ДокСсылка, Кількість)
	Если ДокСсылка.Количество = Кількість Тогда
		Возврат;
	КонецЕсли;
	ДокОбъект = ДокСсылка.ПолучитьОбъект();
	ДокОбъект.Количество = Кількість;
	ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Сообщить("Кількість комплекту " + Строка(ДокСсылка) + ": " + Формат(Кількість, "ЧДЦ=1") + " (норма + понаднорма = 1 будинок).");
КонецПроцедуры

#КонецОбласти

#Область ПричиниЦеху

// Пам'ять причин понаднормового списання.
//
// ТЧ ПричиниЦеху переживає «Розрахувати» (ЗаполнитьТаблицыСписания чистить лише таблиці
// списання) і після кожного перерахунку повертає причини у СписаниеСверхНормы.Причина.
// Джерело — друкована форма «Аналіз для цеху (з коментарем)», збережена цехом у .xlsx:
// з файлу читається ВИКЛЮЧНО колонка «Коментар цеху», жодна інша колонка документа
// (кількості, ціни, суми, рахунки, склади) завантаженням не змінюється.
//
// Рядок пам'яті буває двох видів:
//   * по номенклатурі — заповнені ОбщееНазвание + Номенклатура (коментар на рядку позиції);
//   * по еталону — заповнене лише ОбщееНазвание (коментар на жирному рядку групи); працює
//     і для номенклатур, які з'являться під цим еталоном при наступному перерахунку.
//
// Спека: docs/superpowers/specs/2026-09-16-zagruzka-prichin-ceh-excel-design.md

// Завантажує коментарі цеху з файлу у ПричиниЦеху і одразу застосовує їх до списання.
// АдресФайла — адреса двійкових даних у тимчасовому сховищі (файл кладе туди форма),
// ИмяФайла потрібне лише для визначення розширення. Повертає протокол для виводу користувачу.
Функция ЗавантажитиПричиниЦехуЗФайлу(АдресФайла, ИмяФайла = "") Экспорт
	Протокол = НовыйПротоколПричин();
	Расширение = РасширениеФайлаПричин(?(ПустаяСтрока(ИмяФайла), АдресФайла, ИмяФайла));
	Если Расширение = "xls" Тогда
		Протокол.Ошибка = НСтр("ru='Формат .xls платформа не читает. Сохраните файл как .xlsx и повторите.';uk='Формат .xls платформа не читає. Збережіть файл як .xlsx і повторіть.'");
		Возврат Протокол;
	КонецЕсли;
	ТабДок = ПрочитатьКнигуПричин(АдресФайла, Расширение, Протокол);
	Если ТабДок = Неопределено Тогда
		Возврат Протокол;
	КонецЕсли;
	Координаты = НайтиШапкуПричин(ТабДок);
	Если Координаты = Неопределено Тогда
		Протокол.Ошибка = НСтр("ru='В файле не найдена колонка «Коментар цеху» — это не печатная форма «Аналіз для цеху».';uk='У файлі не знайдено колонку «Коментар цеху» — це не друкована форма «Аналіз для цеху».'");
		Возврат Протокол;
	КонецЕсли;
	Индексы = ИндексыРасчетаДляПричин();
	СобранныеПричины = СобратьПричиныИзКниги(ТабДок, Координаты, Индексы, Протокол);
	ЗаписатьПричиныЦеха(СобранныеПричины, Протокол);
	ЗастосуватиПричиниЦеху(Протокол);
	Возврат Протокол;
КонецФункции

// Повертає причини з пам'яті у СписаниеСверхНормы.Причина: причина по номенклатурі
// важливіша за причину рівня еталона, порожня причина нічого не затирає.
// Викликається наприкінці ЗаполнитьТаблицыСписания — тому «Розрахувати» причини не втрачає.
Процедура ЗастосуватиПричиниЦеху(Протокол = Неопределено) Экспорт
	Если ПричиниЦеху.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ПоНоменклатуре = Новый Соответствие;
	ПоЭталону = Новый Соответствие;
	Для Каждого СтрокаПамяти Из ПричиниЦеху Цикл
		Если ПустаяСтрока(СтрокаПамяти.Причина) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаПамяти.Номенклатура) Тогда
			ПоНоменклатуре.Вставить(СтрокаПамяти.Номенклатура, СтрокаПамяти.Причина);
		ИначеЕсли ЗначениеЗаполнено(СтрокаПамяти.ОбщееНазвание) Тогда
			ПоЭталону.Вставить(СтрокаПамяти.ОбщееНазвание, СтрокаПамяти.Причина);
		КонецЕсли;
	КонецЦикла;
	Применено = 0;
	Для Каждого СтрокаСписания Из СписаниеСверхНормы Цикл
		ТекстПричины = ПоНоменклатуре.Получить(СтрокаСписания.Номенклатура);
		Если ТекстПричины = Неопределено Тогда
			ТекстПричины = ПоЭталону.Получить(СтрокаСписания.ОбщееНазвание);
		КонецЕсли;
		Если ТекстПричины = Неопределено ИЛИ СтрокаСписания.Причина = ТекстПричины Тогда
			Продолжить;
		КонецЕсли;
		СтрокаСписания.Причина = ТекстПричины;
		Применено = Применено + 1;
	КонецЦикла;
	Если Протокол <> Неопределено Тогда
		Протокол.Применено = Применено;
	КонецЕсли;
КонецПроцедуры

// Прибирає ВСІ обґрунтування розрахунку: і пам'ять, і колонку Причина у списанні.
// Чистити щось одне немає сенсу: збір при записі поверне причини зі списання у пам'ять,
// а застосування при перерахунку — навпаки.
Процедура ОчиститиПричиниЦеху() Экспорт
	ПричиниЦеху.Очистить();
	Для Каждого СтрокаСписания Из СписаниеСверхНормы Цикл
		СтрокаСписания.Причина = "";
	КонецЦикла;
КонецПроцедуры

// Ручні правки Причина у таблиці понаднормового списання повертаються у пам'ять —
// інакше наступний «Розрахувати» їх втратить. Правила:
//   * порожня причина по номенклатурі видаляє рядок пам'яті (бухгалтер стер обґрунтування);
//   * причина, що прийшла з рівня еталона, у пам'ять по номенклатурі НЕ дублюється;
//   * номенклатури, яких зараз немає у списанні, у пам'яті не чіпаються.
Процедура СобратьПричиныИзСписания() Экспорт
	ПричиныЭталонов = Новый Соответствие;
	Для Каждого СтрокаПамяти Из ПричиниЦеху Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаПамяти.Номенклатура) И ЗначениеЗаполнено(СтрокаПамяти.ОбщееНазвание) Тогда
			ПричиныЭталонов.Вставить(СтрокаПамяти.ОбщееНазвание, СокрЛП(СтрокаПамяти.Причина));
		КонецЕсли;
	КонецЦикла;
	ТекстыПоНоменклатуре = Новый Соответствие;
	ЭталоныНоменклатуры = Новый Соответствие;
	Для Каждого СтрокаСписания Из СписаниеСверхНормы Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаСписания.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		ЭталоныНоменклатуры.Вставить(СтрокаСписания.Номенклатура, СтрокаСписания.ОбщееНазвание);
		ТекстПричины = СокрЛП(СтрокаСписания.Причина);
		Если ТекстПричины = ПричиныЭталонов.Получить(СтрокаСписания.ОбщееНазвание) Тогда
			ТекстПричины = "";
		КонецЕсли;
		Известный = ТекстыПоНоменклатуре.Получить(СтрокаСписания.Номенклатура);
		Если Известный = Неопределено ИЛИ (ПустаяСтрока(Известный) И НЕ ПустаяСтрока(ТекстПричины)) Тогда
			ТекстыПоНоменклатуре.Вставить(СтрокаСписания.Номенклатура, ТекстПричины);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючЗначение Из ТекстыПоНоменклатуре Цикл
		ЭталонСтроки = ЭталоныНоменклатуры.Получить(КлючЗначение.Ключ);
		СтрокаПамяти = НайтиСтрокуПричины(ЭталонСтроки, КлючЗначение.Ключ);
		Если ПустаяСтрока(КлючЗначение.Значение) Тогда
			Если СтрокаПамяти <> Неопределено Тогда
				ПричиниЦеху.Удалить(СтрокаПамяти);
			КонецЕсли;
		ИначеЕсли СтрокаПамяти = Неопределено Тогда
			НоваяСтрока = ПричиниЦеху.Добавить();
			НоваяСтрока.ОбщееНазвание = ЭталонСтроки;
			НоваяСтрока.Номенклатура = КлючЗначение.Ключ;
			НоваяСтрока.Причина = КлючЗначение.Значение;
			НоваяСтрока.ДатаЗагрузки = ТекущаяДатаСеанса();
		ИначеЕсли СтрокаПамяти.Причина <> КлючЗначение.Значение Тогда
			СтрокаПамяти.Причина = КлючЗначение.Значение;
			СтрокаПамяти.ДатаЗагрузки = ТекущаяДатаСеанса();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Протокол завантаження: лічильники + перші 30 рядків пояснень.
Функция НовыйПротоколПричин()
	Протокол = Новый Структура;
	Протокол.Вставить("Всего", 0);
	Протокол.Вставить("Загружено", 0);
	Протокол.Вставить("Обновлено", 0);
	Протокол.Вставить("БезИзменений", 0);
	Протокол.Вставить("НеНайдено", 0);
	Протокол.Вставить("Конфликт", 0);
	Протокол.Вставить("Обрезано", 0);
	Протокол.Вставить("Применено", 0);
	Протокол.Вставить("Ошибка", "");
	Протокол.Вставить("Сообщения", Новый Массив);
	Возврат Протокол;
КонецФункции

Процедура ДобавитьСообщениеПротокола(Протокол, Текст)
	Если Протокол.Сообщения.Количество() < 30 Тогда
		Протокол.Сообщения.Добавить(Текст);
	КонецЕсли;
КонецПроцедуры

Функция РасширениеФайлаПричин(ИмяФайла)
	Позиция = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
	Если Позиция = 0 Тогда
		Возврат "xlsx";
	КонецЕсли;
	Возврат НРег(Сред(ИмяФайла, Позиция + 1));
КонецФункции

// Читає книгу штатним засобом платформи (.xlsx / .ods / .mxl) — без Excel і COM.
// Тимчасовий файл прибирається у будь-якому разі.
Функция ПрочитатьКнигуПричин(АдресФайла, Расширение, Протокол)
	// Форма кладе файл у тимчасове сховище; скрипти приймання і пакетні сценарії
	// передають шлях до файлу на сервері — підтримуємо обидва варіанти.
	ЧерезХранилище = ЭтоАдресВременногоХранилища(АдресФайла);
	ИмяВременногоФайла = ?(ЧерезХранилище, ПолучитьИмяВременногоФайла(Расширение), АдресФайла);
	ТабДок = Неопределено;
	Попытка
		Если ЧерезХранилище Тогда
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
			ДвоичныеДанные.Записать(ИмяВременногоФайла);
		КонецЕсли;
		ТабДок = Новый ТабличныйДокумент;
		ТабДок.Прочитать(ИмяВременногоФайла);
	Исключение
		ТабДок = Неопределено;
		Протокол.Ошибка = НСтр("ru='Не удалось прочитать файл: ';uk='Не вдалося прочитати файл: '")
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если ЧерезХранилище Тогда
		Попытка
			УдалитьФайлы(ИмяВременногоФайла);
		Исключение
			// тимчасовий файл не критичний
		КонецПопытки;
	КонецЕсли;
	Возврат ТабДок;
КонецФункции

// Шапка друкованої форми: колонка назви, колонка коментаря і (за наявності) колонка коду.
// Шукаємо за ТЕКСТОМ заголовків — зсув колонок у майбутніх версіях друку переживаємо.
Функция НайтиШапкуПричин(ТабДок)
	Для НомерСтроки = 1 По Мин(ТабДок.ВысотаТаблицы, 30) Цикл
		КолонкаНазвания = 0;
		КолонкаКомментария = 0;
		КолонкаКода = 0;
		Для НомерКолонки = 1 По ТабДок.ШиринаТаблицы Цикл
			ТекстЯчейки = СокрЛП(ТабДок.Область(НомерСтроки, НомерКолонки).Текст);
			Если ТекстЯчейки = "Загальна назва" Тогда
				КолонкаНазвания = НомерКолонки;
			ИначеЕсли ТекстЯчейки = "Коментар цеху" Тогда
				КолонкаКомментария = НомерКолонки;
			ИначеЕсли ТекстЯчейки = "Код" Тогда
				КолонкаКода = НомерКолонки;
			КонецЕсли;
		КонецЦикла;
		Если КолонкаНазвания > 0 И КолонкаКомментария > 0 Тогда
			Возврат Новый Структура("СтрокаШапки, КолонкаНазвания, КолонкаКомментария, КолонкаКода",
				НомерСтроки, КолонкаНазвания, КолонкаКомментария, КолонкаКода);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Індекси для зіставлення рядків файлу з позиціями ЦЬОГО розрахунку.
// Область пошуку — тільки ТабличнаяЧастьОстатков документа: у довіднику 57 дублікатів кодів
// і 602 тезки за іменем, у межах розрахунку неоднозначності майже немає, а залишок
// ловить лічильник «Конфлікт» (чужу причину не ставимо).
Функция ИндексыРасчетаДляПричин()
	Индексы = Новый Структура;
	Индексы.Вставить("КодНоменклатуры", Новый Соответствие);
	Индексы.Вставить("ПараИмен", Новый Соответствие);
	Индексы.Вставить("ИмяНоменклатуры", Новый Соответствие);
	Индексы.Вставить("ИмяЭталона", Новый Соответствие);
	Индексы.Вставить("ЭталонНоменклатуры", Новый Соответствие);
	Номенклатуры = Новый Массив;
	Эталоны = Новый Массив;
	Для Каждого СтрокаАнализа Из ТабличнаяЧастьОстатков Цикл
		Если ЗначениеЗаполнено(СтрокаАнализа.Номенклатура) Тогда
			Номенклатуры.Добавить(СтрокаАнализа.Номенклатура);
			Индексы.ЭталонНоменклатуры.Вставить(СтрокаАнализа.Номенклатура, СтрокаАнализа.ОбщееНазвание);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаАнализа.ОбщееНазвание) Тогда
			Эталоны.Добавить(СтрокаАнализа.ОбщееНазвание);
		КонецЕсли;
	КонецЦикла;
	ИменаЭталонов = Новый Соответствие;
	Если Эталоны.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	О.Ссылка КАК Ссылка,
		|	О.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ОбщиеНазванияНоменклатуры КАК О
		|ГДЕ
		|	О.Ссылка В (&Эталоны)";
		Запрос.УстановитьПараметр("Эталоны", Эталоны);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ИмяЭталона = ВРег(СокрЛП(Выборка.Наименование));
			ИменаЭталонов.Вставить(Выборка.Ссылка, ИмяЭталона);
			ДобавитьВИндексПричин(Индексы.ИмяЭталона, ИмяЭталона, Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	Если Номенклатуры.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Н.Ссылка КАК Ссылка,
		|	Н.Код КАК Код,
		|	Н.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Н
		|ГДЕ
		|	Н.Ссылка В (&Номенклатура)";
		Запрос.УстановитьПараметр("Номенклатура", Номенклатуры);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ИмяНоменклатуры = ВРег(СокрЛП(Выборка.Наименование));
			ДобавитьВИндексПричин(Индексы.КодНоменклатуры, СокрЛП(Выборка.Код), Выборка.Ссылка);
			ДобавитьВИндексПричин(Индексы.ИмяНоменклатуры, ИмяНоменклатуры, Выборка.Ссылка);
			ИмяЭталона = ИменаЭталонов.Получить(Индексы.ЭталонНоменклатуры.Получить(Выборка.Ссылка));
			ДобавитьВИндексПричин(Индексы.ПараИмен,
				?(ИмяЭталона = Неопределено, "", ИмяЭталона) + "|" + ИмяНоменклатуры, Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	Возврат Индексы;
КонецФункции

Процедура ДобавитьВИндексПричин(Индекс, Ключ, Значение)
	Если ПустаяСтрока(Ключ) Тогда
		Возврат;
	КонецЕсли;
	Кандидаты = Индекс.Получить(Ключ);
	Если Кандидаты = Неопределено Тогда
		Кандидаты = Новый Массив;
		Индекс.Вставить(Ключ, Кандидаты);
	КонецЕсли;
	Если Кандидаты.Найти(Значение) = Неопределено Тогда
		Кандидаты.Добавить(Значение);
	КонецЕсли;
КонецПроцедуры

// Номенклатура рядка файлу: спершу за кодом, далі за парою «еталон + назва», у крайньому
// разі за самою назвою. Повертає Статус = Найдено / НеНайдено / Конфликт.
Функция НайтиНоменклатуруПричины(Индексы, Код, Название, ИмяЭталона)
	Результат = Новый Структура("Статус, Ссылка", "НеНайдено", Неопределено);
	КлючПары = ИмяЭталона + "|" + ВРег(Название);
	Кандидаты = Неопределено;
	Если НЕ ПустаяСтрока(Код) Тогда
		Кандидаты = Индексы.КодНоменклатуры.Получить(Код);
	КонецЕсли;
	Если Кандидаты <> Неопределено И Кандидаты.Количество() > 1 Тогда
		КандидатыПоИмени = Индексы.ПараИмен.Получить(КлючПары);
		Если КандидатыПоИмени <> Неопределено Тогда
			Пересечение = Новый Массив;
			Для Каждого Кандидат Из Кандидаты Цикл
				Если КандидатыПоИмени.Найти(Кандидат) <> Неопределено Тогда
					Пересечение.Добавить(Кандидат);
				КонецЕсли;
			КонецЦикла;
			Если Пересечение.Количество() = 1 Тогда
				Кандидаты = Пересечение;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Кандидаты = Неопределено Тогда
		Кандидаты = Индексы.ПараИмен.Получить(КлючПары);
	КонецЕсли;
	Если Кандидаты = Неопределено Тогда
		Кандидаты = Индексы.ИмяНоменклатуры.Получить(ВРег(Название));
	КонецЕсли;
	Если Кандидаты = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если Кандидаты.Количество() = 1 Тогда
		Результат.Статус = "Найдено";
		Результат.Ссылка = Кандидаты[0];
	Иначе
		Результат.Статус = "Конфликт";
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Обхід рядків книги: жирний рядок першої колонки — еталон (група), звичайний — номенклатура.
// Коментар еталона лягає у пам'ять рядком без номенклатури, а сама ссылка еталона береться
// від його дочірніх рядків файлу (імена еталонів мають 2 дублікати, тому ім'я — лише резерв).
Функция СобратьПричиныИзКниги(ТабДок, Координаты, Индексы, Протокол)
	Результат = Новый Массив;
	ТекущийЭталонИмя = "";
	ТекущийЭталонСсылка = Неопределено;
	ТекущийЭталонКомментарий = "";
	Для НомерСтроки = Координаты.СтрокаШапки + 1 По ТабДок.ВысотаТаблицы Цикл
		ОбластьНазвания = ТабДок.Область(НомерСтроки, Координаты.КолонкаНазвания);
		Название = СокрЛП(ОбластьНазвания.Текст);
		Если ПустаяСтрока(Название) Тогда
			Продолжить;
		КонецЕсли;
		ВерхнееНазвание = ВРег(Название);
		Если ВерхнееНазвание = "ИТОГО" ИЛИ ВерхнееНазвание = "РАЗОМ" ИЛИ ВерхнееНазвание = "ВСЬОГО" Тогда
			Прервать;
		КонецЕсли;
		Если ВерхнееНазвание = "НОМЕНКЛАТУРА" И НомерСтроки <= Координаты.СтрокаШапки + 2 Тогда
			Продолжить;
		КонецЕсли;
		Комментарий = СокрЛП(ТабДок.Область(НомерСтроки, Координаты.КолонкаКомментария).Текст);
		Код = "";
		Если Координаты.КолонкаКода > 0 Тогда
			Код = СокрЛП(ТабДок.Область(НомерСтроки, Координаты.КолонкаКода).Текст);
		КонецЕсли;
		ШрифтНазвания = ОбластьНазвания.Шрифт;
		ЭтоЭталон = (ШрифтНазвания <> Неопределено И ШрифтНазвания.Жирный = Истина);
		Если ЭтоЭталон Тогда
			ЗавершитьЭталонПричин(Результат, Индексы, Протокол,
				ТекущийЭталонИмя, ТекущийЭталонСсылка, ТекущийЭталонКомментарий);
			ТекущийЭталонИмя = ВерхнееНазвание;
			ТекущийЭталонСсылка = Неопределено;
			ТекущийЭталонКомментарий = Комментарий;
			Если НЕ ПустаяСтрока(Комментарий) Тогда
				Протокол.Всего = Протокол.Всего + 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Найденное = НайтиНоменклатуруПричины(Индексы, Код, Название, ТекущийЭталонИмя);
		Если Найденное.Статус = "Найдено" И ТекущийЭталонСсылка = Неопределено Тогда
			ТекущийЭталонСсылка = Индексы.ЭталонНоменклатуры.Получить(Найденное.Ссылка);
		КонецЕсли;
		Если ПустаяСтрока(Комментарий) Тогда
			Продолжить;
		КонецЕсли;
		Протокол.Всего = Протокол.Всего + 1;
		Если Найденное.Статус = "Конфликт" Тогда
			Протокол.Конфликт = Протокол.Конфликт + 1;
			ДобавитьСообщениеПротокола(Протокол, "Рядок " + НомерСтроки + ": «" + Название
				+ "» — у розрахунку кілька позицій з такою назвою/кодом, коментар НЕ проставлено.");
			Продолжить;
		ИначеЕсли Найденное.Статус = "НеНайдено" Тогда
			Протокол.НеНайдено = Протокол.НеНайдено + 1;
			ДобавитьСообщениеПротокола(Протокол, "Рядок " + НомерСтроки + ": «" + Название
				+ "» — немає у цьому розрахунку, коментар НЕ проставлено.");
			Продолжить;
		КонецЕсли;
		ДобавитьПричинуВСписок(Результат, Протокол,
			Индексы.ЭталонНоменклатуры.Получить(Найденное.Ссылка), Найденное.Ссылка, Комментарий);
	КонецЦикла;
	ЗавершитьЭталонПричин(Результат, Индексы, Протокол,
		ТекущийЭталонИмя, ТекущийЭталонСсылка, ТекущийЭталонКомментарий);
	Возврат Результат;
КонецФункции

// Коментар жирного рядка групи: ссылка еталона вже відома від його номенклатур,
// інакше пробуємо за іменем (тут можливий конфлікт — тоді нічого не ставимо).
Процедура ЗавершитьЭталонПричин(Результат, Индексы, Протокол, ИмяЭталона, СсылкаЭталона, Комментарий)
	Если ПустаяСтрока(Комментарий) Тогда
		Возврат;
	КонецЕсли;
	НайденныйЭталон = СсылкаЭталона;
	Если НЕ ЗначениеЗаполнено(НайденныйЭталон) Тогда
		Кандидаты = Индексы.ИмяЭталона.Получить(ИмяЭталона);
		Если Кандидаты = Неопределено Тогда
			Протокол.НеНайдено = Протокол.НеНайдено + 1;
			ДобавитьСообщениеПротокола(Протокол, "Загальна назва «" + ИмяЭталона
				+ "» — немає у цьому розрахунку, коментар НЕ проставлено.");
			Возврат;
		ИначеЕсли Кандидаты.Количество() > 1 Тогда
			Протокол.Конфликт = Протокол.Конфликт + 1;
			ДобавитьСообщениеПротокола(Протокол, "Загальна назва «" + ИмяЭталона
				+ "» — у розрахунку кілька еталонів з такою назвою, коментар НЕ проставлено.");
			Возврат;
		КонецЕсли;
		НайденныйЭталон = Кандидаты[0];
	КонецЕсли;
	ДобавитьПричинуВСписок(Результат, Протокол, НайденныйЭталон,
		Справочники.Номенклатура.ПустаяСсылка(), Комментарий);
КонецПроцедуры

Процедура ДобавитьПричинуВСписок(Список, Протокол, ЭталонСсылка, НоменклатураСсылка, Комментарий)
	ТекстПричины = Комментарий;
	Если СтрДлина(ТекстПричины) > 200 Тогда
		ТекстПричины = Лев(ТекстПричины, 200);
		Протокол.Обрезано = Протокол.Обрезано + 1;
	КонецЕсли;
	Список.Добавить(Новый Структура("ОбщееНазвание, Номенклатура, Причина",
		?(ЭталонСсылка = Неопределено, Справочники.ОбщиеНазванияНоменклатуры.ПустаяСсылка(), ЭталонСсылка),
		НоменклатураСсылка,
		ТекстПричины));
КонецПроцедуры

Процедура ЗаписатьПричиныЦеха(СобранныеПричины, Протокол)
	Для Каждого Причина Из СобранныеПричины Цикл
		СтрокаПамяти = НайтиСтрокуПричины(Причина.ОбщееНазвание, Причина.Номенклатура);
		Если СтрокаПамяти = Неопределено Тогда
			НоваяСтрока = ПричиниЦеху.Добавить();
			НоваяСтрока.ОбщееНазвание = Причина.ОбщееНазвание;
			НоваяСтрока.Номенклатура = Причина.Номенклатура;
			НоваяСтрока.Причина = Причина.Причина;
			НоваяСтрока.ДатаЗагрузки = ТекущаяДатаСеанса();
			Протокол.Загружено = Протокол.Загружено + 1;
		ИначеЕсли СтрокаПамяти.Причина <> Причина.Причина Тогда
			СтрокаПамяти.Причина = Причина.Причина;
			СтрокаПамяти.ДатаЗагрузки = ТекущаяДатаСеанса();
			Протокол.Обновлено = Протокол.Обновлено + 1;
		Иначе
			Протокол.БезИзменений = Протокол.БезИзменений + 1;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция НайтиСтрокуПричины(ЭталонСсылка, НоменклатураСсылка)
	Для Каждого СтрокаПамяти Из ПричиниЦеху Цикл
		Если СтрокаПамяти.Номенклатура = НоменклатураСсылка
			И СтрокаПамяти.ОбщееНазвание = ЭталонСсылка Тогда
			Возврат СтрокаПамяти;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Статус = Перечисления.СтатусыРасчетаКомплектаций.Черновик;
	Период = НачалоДня(ТекущаяДата());
	Ответственный = Пользователи.ТекущийПользователь();
	Если СчетаОстатков.Количество() = 0 Тогда
		Для Каждого Код Из СтрРазделить("20,28", ",") Цикл
			Сч = ПланыСчетов.Хозрасчетный.НайтиПоКоду(Код);
			Если ЗначениеЗаполнено(Сч) Тогда
				СчетаОстатков.Добавить().Счет = Сч;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если СчетаМалоценки.Количество() = 0 Тогда
		Сч22 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("22");
		Если ЗначениеЗаполнено(Сч22) Тогда
			СчетаМалоценки.Добавить().Счет = Сч22;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Причини цеху — обґрунтування КОНКРЕТНОГО розрахунку (вимога замовника: у копію не їдуть).
// Чистимо і пам'ять, і колонку Причина у списанні, інакше збір при записі поверне їх назад.
Процедура ОбработкаКопирования(ОбъектКопирования)
	ПричиниЦеху.Очистить();
	Для Каждого СтрокаСписания Из СписаниеСверхНормы Цикл
		СтрокаСписания.Причина = "";
	КонецЦикла;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусыРасчетаКомплектаций.Черновик;
	КонецЕсли;
	// Автор подтверждения списания: галочку могли поставить в форме, из списка
	// («Изменить выделенные») или программно — гарантия здесь, в объекте.
	Если СписанняПідтверджено И ПустаяСтрока(СписанняПідтвердженоАвтор) Тогда
		СписанняПідтвердженоАвтор = Строка(Пользователи.ТекущийПользователь()) + ", "
			+ Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'");
	ИначеЕсли НЕ СписанняПідтверджено И НЕ ПустаяСтрока(СписанняПідтвердженоАвтор) Тогда
		СписанняПідтвердженоАвтор = "";
	КонецЕсли;
	// Контроль: кількість до списання не може перевищувати понаднормову.
	Для Каждого СтрокаСверхНормы Из СписаниеСверхНормы Цикл
		Если СтрокаСверхНормы.КоличествоКСписанию > СтрокаСверхНормы.Количество Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Строка %1 ""%2"": количество к списанию (%3) больше сверхнормового (%4). Уменьшите.';uk='Рядок %1 ""%2"": кількість до списання (%3) більша за понаднормову (%4). Зменшіть.'"),
					СтрокаСверхНормы.НомерСтроки, СтрокаСверхНормы.Номенклатура, СтрокаСверхНормы.КоличествоКСписанию, СтрокаСверхНормы.Количество),
				ЭтотОбъект,
				"СписаниеСверхНормы[" + Формат(СтрокаСверхНормы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].КоличествоКСписанию",
				"Объект",
				Отказ);
		КонецЕсли;
	КонецЦикла;
	// Ручні правки Причина повертаємо у пам'ять ПричиниЦеху — інакше наступний
	// «Розрахувати» перезаповнить СписаниеСверхНормы і обґрунтування зникнуть.
	СобратьПричиныИзСписания();
	// Контроль дублей: предупреждение, НЕ отказ.
	Дубли = НайтиДубликатыРасчета();
	Если Дубли.Количество() > 0 Тогда
		Сообщить("Увага: вже існує розрахунок за цією специфікацією/датою/складами: "
			+ Строка(Дубли[0]) + ?(Дубли.Количество() > 1, " (та ще " + (Дубли.Количество() - 1) + ")", ""));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
