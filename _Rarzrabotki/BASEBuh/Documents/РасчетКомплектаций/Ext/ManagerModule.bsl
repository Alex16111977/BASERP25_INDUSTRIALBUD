#Область ПрограммныйИнтерфейс

// Параметры открытия отчёта зі списання з журналу (або форми) розрахунку:
// готові користувацькі настройки з автовідбором і ключ унікальності вікна.
//
// Автовідбір (рішення заказчика 2026-08-25):
//   Період            — місяць «Залишків на дату» виділених розрахунків
//                       (об'єднання: початок місяця найранішої, кінець місяця найпізнішої).
//   Підрозділ-об'єкт  — вузол об'єкта СС (ПодразделениеОбъекта, fallback Подразделение),
//                       ставиться ЛИШЕ якщо в усіх виділених розрахунках він ОДИН;
//                       інакше відбір лишається як у варіанті (бухгалтер обере сам).
//
// ⚠ Настройки віддаються формі звіту параметром «ПользовательскиеНастройки», а НЕ «Отбор»:
// параметр «Отбор» БСП застосовує як ФІКСОВАНИЙ і робить поля НЕДОСТУПНИМИ для правки
// (інцидент 2026-04-19 на А_ОтчетPL).
//
// Параметры:
//   ИмяОтчета - Строка - ім'я об'єкта метаданих звіту (Отчеты.<ИмяОтчета>).
//   ПараметрКоманды - Массив, ДокументСсылка.РасчетКомплектаций - виділені розрахунки.
//   КлючВарианта - Строка - предвизначений варіант звіту: "Основной" (за нормами і понад норму),
//         "Шахматка" (об'єкти в колонках) або "ПланФакт" (план-факт із залишками).
//         Настройки будуються САМЕ ЦЬОГО варіанта: у кожного свої userSettingID.
//
// Возвращаемое значение:
//   Структура:
//     * ПользовательскиеНастройки - ПользовательскиеНастройкиКомпоновкиДанных - для форми звіту.
//     * КлючВарианта - Строка - передається формі звіту як параметр.
//     * КлючУникальности - Строка - різні варіанти/відбори відкриваються різними вікнами,
//         повтор із тим самим відбором перевикористовує вікно.
//
Функция ПараметрыОткрытияОтчета(ИмяОтчета, ПараметрКоманды, КлючВарианта = "Основной",
	ПериодТриМесяца = Истина) Экспорт

	Отбор = ОтборПоРасчетам(ПараметрКоманды);

	// Контроль розкладки по домиках дивляться за ТРИ місяці від початку місяця ПЕРШОГО розрахунку
	// по вузлу обʼєкта: цикл будинку (виробництво → відвантаження → монтаж) в один місяць не вміщається
	// (прохання замовника 07.09.2026). Немає розрахунків по вузлу — лишається місячний період за виділеними.
	Если ПериодТриМесяца И ЗначениеЗаполнено(Отбор.Подразделение) Тогда
		ПерваяДата = ПерваяДатаРасчетовОбъекта(Отбор.Подразделение);
		Если ЗначениеЗаполнено(ПерваяДата) Тогда
			Отбор.ДатаНачала = НачалоМесяца(ПерваяДата);
			Отбор.ДатаОкончания = КонецМесяца(ДобавитьМесяц(Отбор.ДатаНачала, 2));
		КонецЕсли;
	КонецЕсли;

	Отчет = Отчеты[ИмяОтчета].Создать();
	Схема = Отчет.СхемаКомпоновкиДанных;
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));

	Вариант = Схема.ВариантыНастроек.Найти(КлючВарианта);
	Если Вариант <> Неопределено Тогда
		Компоновщик.ЗагрузитьНастройки(Вариант.Настройки);
	Иначе
		Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	КонецЕсли;

	// 🔴 У КОРИСТУВАЦЬКИХ настройках елемент відбору НЕ несе поля: його ЛевоеЗначение ПОРОЖНЄ,
	// а зв'язок з відбором варіанта — лише через ИдентификаторПользовательскойНастройки
	// (доведено діагностикою на живій базі 2026-08-25). Тому спершу беремо ідентифікатор
	// відбору «Подразделение» з ОСНОВНИХ настройок, а вже потім ставимо значення в
	// користувацьких за цим ідентифікатором.
	ИдентификаторОтбора = ИдентификаторОтбораПоПолю(Компоновщик.Настройки, "Подразделение");
	// Домики поточного обʼєкта підставляємо у відбори, але НЕ вмикаємо: бухгалтер лише ставить галочку
	// і прибирає зайві (прохання замовника 07.09.2026).
	ИдентификаторДомиков = ИдентификаторОтбораПоПолю(Компоновщик.Настройки, "ПодразделениеИсполнитель");
	ИдентификаторНомеров = ИдентификаторОтбораПоПолю(Компоновщик.Настройки, "Домик");
	Домики = ДомикиОбъекта(Отбор.Подразделение);

	// «Склади залишків» варіанта ПланФакт: за замовчуванням — склади КОРЕНЯ гілки об'єкта
	// з позначкою «Основний для приходу на підрозділ» (закупівельні). Позначок немає або
	// вузол об'єкта неоднозначний — параметр не чіпаємо (у звіті працює автопідбір).
	СкладыОтбора = СкладыОсновныеДляПрихода(Отбор.Подразделение);

	Для Каждого Элемент Из Компоновщик.ПользовательскиеНастройки.Элементы Цикл

		Если ТипЗнч(Элемент) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда

			Если Строка(Элемент.Параметр) = "Период" И ЗначениеЗаполнено(Отбор.ДатаНачала) Тогда
				Период = Новый СтандартныйПериод;
				Период.ДатаНачала = Отбор.ДатаНачала;
				Период.ДатаОкончания = Отбор.ДатаОкончания;
				Элемент.Значение = Период;
				Элемент.Использование = Истина;
			ИначеЕсли Строка(Элемент.Параметр) = "СкладыОстатков" И СкладыОтбора.Количество() > 0 Тогда
				Элемент.Значение = СкладыОтбора;
				Элемент.Использование = Истина;
			КонецЕсли;

		ИначеЕсли ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда

			Если ЗначениеЗаполнено(Отбор.Подразделение) И ИдентификаторОтбора <> Неопределено
				И Элемент.ИдентификаторПользовательскойНастройки = ИдентификаторОтбора Тогда
				Элемент.ПравоеЗначение = Отбор.Подразделение;
				Элемент.Использование = Истина;
			ИначеЕсли ИдентификаторДомиков <> Неопределено И Домики.Подразделения.Количество() > 0
				И Элемент.ИдентификаторПользовательскойНастройки = ИдентификаторДомиков Тогда
				Элемент.ПравоеЗначение = Домики.Подразделения;
				Элемент.Использование = Ложь;
			ИначеЕсли ИдентификаторНомеров <> Неопределено И Домики.Номера.Количество() > 0
				И Элемент.ИдентификаторПользовательскойНастройки = ИдентификаторНомеров Тогда
				Элемент.ПравоеЗначение = Домики.Номера;
				Элемент.Использование = Ложь;
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("ПользовательскиеНастройки", Компоновщик.ПользовательскиеНастройки);
	Результат.Вставить("КлючВарианта", КлючВарианта);
	Результат.Вставить("КлючУникальности", ИмяОтчета
		+ "/" + КлючВарианта
		+ "/" + Формат(Отбор.ДатаНачала, "ДФ=yyyyMMdd; ДП=")
		+ "-" + Формат(Отбор.ДатаОкончания, "ДФ=yyyyMMdd; ДП=")
		+ "/" + Строка(Отбор.Подразделение));
	Возврат Результат;

КонецФункции


// Читає з бази Казначейства відвантаження продукції по будинках.
//
// КЛЮЧ СОПОСТАВЛЕННЯ (єдиний, перевірений на живих базах 06.09.2026):
//   РасчетКомплектаций.Подразделение  <->  ОтгрузкаПродукции.ДоставкаДомов.Дом
//   Це ОДИН І ТОЙ САМИЙ елемент Справочника.Подразделения в обох базах.
//   Основний ключ — КОД (офіційний ключ пошуку правил обміну, унікальний в обох базах).
//   Пошук за НАЙМЕНУВАННЯМ ЗАБОРОНЕНО: модуль об'єкта довідника в Казні у ПередЗаписью
//   переписує Наименование як «НаименованиеЭлемента (Родитель)» і обрізає до 50 символів,
//   тому імена не збігаються ніколи (перевірка дала 0 з 5).
//   Пошук за ЗАКАЗЧИКОМ ЗАБОРОНЕНО: заказчик — це ПРОЄКТ, а не будинок; по одному проєкту
//   в казні 34 документи, з них дому стосуються одиниці (решта — доставка матеріалів).
//
// Параметры:
//   МассивДомов - Массив - елементи СправочникСсылка.Подразделения.
//
// Возвращаемое значение:
//   Структура:
//     * Данные - Соответствие - ключ СправочникСсылка.Подразделения,
//                значення Массив структур (Дата, Номер, НазваниеЗаказа, Сумма, Комментарий),
//                відсортований за датою за зростанням.
//     * Ошибка - Строка - порожня, якщо читання пройшло успішно.
//
Функция ПолучитьОтгрузкиПоКазне(МассивДомов) Экспорт

	Результат = Новый Структура("Данные, Ошибка", Новый Соответствие, "");

	ДомаПоКоду = Новый Соответствие;
	КодыСписком = Новый Массив;
	Для Каждого ДомСсылка Из МассивДомов Цикл
		Если Не ЗначениеЗаполнено(ДомСсылка) Тогда
			Продолжить;
		КонецЕсли;
		КодДома = СтрЗаменить(СокрЛП(ДомСсылка.Код), """", "");
		Если Не ЗначениеЗаполнено(КодДома) Или ДомаПоКоду[КодДома] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДомаПоКоду.Вставить(КодДома, ДомСсылка);
		КодыСписком.Добавить("""" + КодДома + """");
	КонецЦикла;

	Если КодыСписком.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Коннектор = Новый COMОбъект("V83.COMConnector");
		СоединениеКазны = Коннектор.Connect(СтрокаПодключенияКазны());
	Исключение
		Результат.Ошибка = "Не вдалося підключитися до бази Казначейства: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Попытка
		ШаблонЗапроса =
		"ВЫБРАТЬ
		|	ДД.Дом.Код КАК ДомКод,
		|	ГОД(Д.Дата) КАК ДатаГод,
		|	МЕСЯЦ(Д.Дата) КАК ДатаМесяц,
		|	ДЕНЬ(Д.Дата) КАК ДатаДень,
		|	Д.Номер КАК Номер,
		|	Д.НазваниеЗаказа КАК НазваниеЗаказа,
		|	Д.СуммаДокумента КАК СуммаДокумента,
		|	Д.Комментарий КАК Комментарий
		|ИЗ
		|	Документ.ОтгрузкаПродукции.ДоставкаДомов КАК ДД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтгрузкаПродукции КАК Д
		|		ПО Д.Ссылка = ДД.Ссылка
		|ГДЕ
		|	Д.Проведен
		|	И НЕ Д.ПометкаУдаления
		|	И ДД.Дом.Код В (%1)
		|УПОРЯДОЧИТЬ ПО
		|	ДатаГод,
		|	ДатаМесяц,
		|	ДатаДень,
		|	Номер";

		ЗапросКазны = СоединениеКазны.NewObject("Запрос");
		ЗапросКазны.Текст = СтрШаблон(ШаблонЗапроса, СтрСоединить(КодыСписком, ", "));
		ВыборкаКазны = ЗапросКазны.Выполнить().Выбрать();

		Пока ВыборкаКазны.Следующий() Цикл

			КодДома = СокрЛП(Строка(ВыборкаКазны.ДомКод));
			ДомСсылка = ДомаПоКоду[КодДома];
			Если ДомСсылка = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			СписокОтгрузок = Результат.Данные[ДомСсылка];
			Если СписокОтгрузок = Неопределено Тогда
				СписокОтгрузок = Новый Массив;
				Результат.Данные.Вставить(ДомСсылка, СписокОтгрузок);
			КонецЕсли;

			ДанныеОтгрузки = Новый Структура("Дата, Номер, НазваниеЗаказа, Сумма, Комментарий");
			// Дату через межу COM НЕ носимо: у казні беремо ГОД/МЕСЯЦ/ДЕНЬ числами і збираємо
			// дату вже тут. Інакше COM зсуває значення на -3 години і опівнічний документ
			// втрачає добу (03.08 перетворюється на 02.08).
			ДанныеОтгрузки.Дата = Дата(Число(ВыборкаКазны.ДатаГод),
				Число(ВыборкаКазны.ДатаМесяц), Число(ВыборкаКазны.ДатаДень));
			// У казні всі рядкові значення йдуть з хвостовими пробілами — СокрЛП обов'язковий.
			ДанныеОтгрузки.Номер = СокрЛП(Строка(ВыборкаКазны.Номер));
			ДанныеОтгрузки.НазваниеЗаказа = СокрЛП(Строка(ВыборкаКазны.НазваниеЗаказа));
			ДанныеОтгрузки.Комментарий = СокрЛП(Строка(ВыборкаКазны.Комментарий));
			ДанныеОтгрузки.Сумма = Число(ВыборкаКазны.СуммаДокумента);
			СписокОтгрузок.Добавить(ДанныеОтгрузки);

		КонецЦикла;
	Исключение
		Результат.Ошибка = "Помилка читання відвантажень з бази Казначейства: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Збирає текст реквізиту ОписаниеОтгрузкиПоКазне — рівно три рядки, щоб уміститись
// у поле форми (MaxHeight = 3 — це три ВИДИМІ рядки, довгий рядок переноситься
// і з'їдає сусідній, тому кожен рядок обрізається).
//
//   03.08.2026 №000001382 · 54 800,00
//   Доставка модкуля та комплектації 31.07 - 01.08
//   Біла Церква - Харківська обл. с. Приморське
//
// Будинок у текст НЕ виводиться — він уже є в шапці документа (реквізит Подразделение).
//
// Параметры:
//   СписокОтгрузок - Массив - структури з ПолучитьОтгрузкиПоКазне(), відсортовані за датою.
//
// Возвращаемое значение:
//   Строка - три рядки через Символы.ПС (порожні поля рядок не займають).
//
Функция СформироватьОписаниеОтгрузки(СписокОтгрузок) Экспорт

	Если СписокОтгрузок = Неопределено Или СписокОтгрузок.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	// Беремо НАЙРАНІШЕ відвантаження — масив уже відсортований запитом за датою.
	Отгрузка = СписокОтгрузок[0];

	ПерваяСтрока = Формат(Отгрузка.Дата, "ДФ=dd.MM.yyyy")
		+ " №" + Отгрузка.Номер
		+ " · " + Формат(Отгрузка.Сумма, "ЧДЦ=2; ЧРГ=' '");
	Если СписокОтгрузок.Количество() > 1 Тогда
		ПерваяСтрока = ПерваяСтрока + " (1 з " + Формат(СписокОтгрузок.Количество(), "ЧН=0; ЧГ=0") + ")";
	КонецЕсли;

	СтрокиОписания = Новый Массив;
	СтрокиОписания.Добавить(ОбрезатьСтрокуОписания(ПерваяСтрока));
	Если ЗначениеЗаполнено(Отгрузка.НазваниеЗаказа) Тогда
		СтрокиОписания.Добавить(ОбрезатьСтрокуОписания(Отгрузка.НазваниеЗаказа));
	КонецЕсли;
	Если ЗначениеЗаполнено(Отгрузка.Комментарий) Тогда
		СтрокиОписания.Добавить(ОбрезатьСтрокуОписания(Отгрузка.Комментарий));
	КонецЕсли;

	Возврат СтрСоединить(СтрокиОписания, Символы.ПС);

КонецФункции

// Пакетне заповнення «Відвантаження по казні» за списком розрахунків.
// Відкриває ОДНЕ COM-з'єднання з казною на всю пачку (кожне з'єднання забирає ліцензію).
//
// Параметры:
//   МассивСсылок - Массив - ДокументСсылка.РасчетКомплектаций.
//
// Возвращаемое значение:
//   Структура - Заполнено, НеНайдено, Ошибки (Число), Сообщения (Массив строк).
//
Функция ЗаполнитьОтгрузкуПоКазнеПоСсылкам(МассивСсылок) Экспорт

	Сводка = Новый Структура("Заполнено, НеНайдено, Ошибки, Сообщения", 0, 0, 0, Новый Массив);

	Если МассивСсылок = Неопределено Или МассивСсылок.Количество() = 0 Тогда
		Возврат Сводка;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Ссылка,
	|	Д.Подразделение КАК Дом
	|ИЗ
	|	Документ.РасчетКомплектаций КАК Д
	|ГДЕ
	|	Д.Ссылка В (&Ссылки)
	|УПОРЯДОЧИТЬ ПО
	|	Д.Номер";
	Запрос.УстановитьПараметр("Ссылки", МассивСсылок);
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();

	ДанныеКазны = ПолучитьОтгрузкиПоКазне(ТаблицаДокументов.ВыгрузитьКолонку("Дом"));
	Если ЗначениеЗаполнено(ДанныеКазны.Ошибка) Тогда
		Сводка.Ошибки = ТаблицаДокументов.Количество();
		Сводка.Сообщения.Добавить(ДанныеКазны.Ошибка);
		Возврат Сводка;
	КонецЕсли;

	Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл
		Попытка
			ДокОбъект = СтрокаДокумента.Ссылка.ПолучитьОбъект();
			РезультатДокумента = ДокОбъект.ЗаполнитьОтгрузкуПоКазнеИзДанных(
				ДанныеКазны.Данные[СтрокаДокумента.Дом]);
			Если РезультатДокумента.Заполнено Тогда
				ДокОбъект.Записать();
				Сводка.Заполнено = Сводка.Заполнено + 1;
			Иначе
				Сводка.НеНайдено = Сводка.НеНайдено + 1;
			КонецЕсли;
			Сводка.Сообщения.Добавить(Строка(СтрокаДокумента.Ссылка) + ": " + РезультатДокумента.Сообщение);
		Исключение
			Сводка.Ошибки = Сводка.Ошибки + 1;
			Сводка.Сообщения.Добавить(Строка(СтрокаДокумента.Ссылка) + ": ПОМИЛКА — "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Возврат Сводка;

КонецФункции



// Підсумок карти циклу будинку одним рядком (для напису на формі та повідомлень).
// Рядки — ТЧ документа або ДанныеФормыКоллекция з колонкою Статус.
Функция ПідсумокКартиЦиклу(Рядки, Рядки2 = Неопределено) Экспорт

	Всього = 0;
	Лічильники = Новый Соответствие;
	Колекції = Новый Массив;
	Колекції.Добавить(Рядки);
	Если Рядки2 <> Неопределено Тогда
		Колекції.Добавить(Рядки2);
	КонецЕсли;
	Для Каждого Колекція Из Колекції Цикл
		Для Каждого РядокКарти Из Колекція Цикл
			Всього = Всього + 1;
			Если Не ЗначениеЗаполнено(РядокКарти.Статус) Тогда
				Продолжить;
			КонецЕсли;
			Лічильники.Вставить(РядокКарти.Статус, ?(Лічильники[РядокКарти.Статус] = Неопределено, 0, Лічильники[РядокКарти.Статус]) + 1);
		КонецЦикла;
	КонецЦикла;
	Если Всього = 0 Тогда
		Возврат "Карту циклу ще не побудовано — натисніть «Проаналізувати».";
	КонецЕсли;
	С = Перечисления.А_СтатусыШагаЦикла;
	Частини = Новый Массив;
	Частини.Добавить("Кроків: " + Формат(Всього, "ЧН=0; ЧГ=0"));
	Для Каждого Пара Из Лічильники Цикл
		Если Пара.Ключ = С.Проведен Или Пара.Ключ = С.Найден Или Пара.Ключ = С.Информационно Тогда
			Продолжить;
		КонецЕсли;
		Частині = Строка(Пара.Ключ) + ": " + Формат(Пара.Значение, "ЧН=0; ЧГ=0");
		Частини.Добавить(Частині);
	КонецЦикла;
	Возврат СтрСоединить(Частини, " · ");

КонецФункции


// «Світлофор будинків»: по розрахунках — статус циклу, порушення, залишки складів будинку.
// Аналіз виконується в пам'яті (об'єкти не записуються). Повертає ТабличныйДокумент.
Функция СвітлофорБудинків(МассивСсылок) Экспорт

	ТабДок = Новый ТабличныйДокумент;
	Заголовки = СтрРазделить("Розрахунок,Дім,Статус розрахунку,Реалізація,D (відвантаження),M (монтаж),Кроків,Порушень,Планується,Очікує бухгалтера,Помилок,Залишки 20/22/26/28 на M", ",");
	Рядок = 1;
	Для Колонка = 1 По Заголовки.Количество() Цикл
		Обл = ТабДок.Область(Рядок, Колонка, Рядок, Колонка);
		Обл.Текст = Заголовки[Колонка - 1];
		Обл.Шрифт = Новый Шрифт(, , Истина);
		Обл.ЦветФона = Новый Цвет(230, 230, 230);
		Обл.Обвести(Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная));
	КонецЦикла;
	Для Каждого ДокСсылка Из МассивСсылок Цикл
		Рядок = Рядок + 1;
		Значення = Новый Массив;
		Колір = Неопределено;
		Попытка
			ДокОбъект = ДокСсылка.ПолучитьОбъект();
			Рез = ДокОбъект.ПроаналізуватиЦиклБудинку();
			Зал = ДокОбъект.ЗалишкиПісляЦиклу();
			ОчікуєБух = 0;
			Для Каждого РядокКарти Из ДокОбъект.ДокументыОтрузкиИДосписания Цикл
				Если РядокКарти.Статус = Перечисления.А_СтатусыШагаЦикла.ОжидаетБухгалтера Тогда
					ОчікуєБух = ОчікуєБух + 1;
				КонецЕсли;
			КонецЦикла;
			Значення.Добавить(Строка(ДокОбъект.Номер));
			Значення.Добавить(Строка(ДокОбъект.Подразделение));
			Значення.Добавить(Строка(ДокОбъект.Статус));
			Значення.Добавить(?(ЗначениеЗаполнено(ДокОбъект.ДокументРеализацияТоваровУслуг), Строка(ДокОбъект.ДокументРеализацияТоваровУслуг), "—"));
			Значення.Добавить(?(ЗначениеЗаполнено(ДокОбъект.ДатаОтгрузки), Формат(ДокОбъект.ДатаОтгрузки, "ДФ=dd.MM.yyyy"), "—"));
			Значення.Добавить(?(ЗначениеЗаполнено(ДокОбъект.ДатаСписанияПоМонтажу), Формат(ДокОбъект.ДатаСписанияПоМонтажу, "ДФ=dd.MM.yyyy"), "—"));
			Значення.Добавить(Формат(Рез.Кроків, "ЧН=0; ЧГ=0"));
			Значення.Добавить(Формат(Рез.Порушень, "ЧН=0; ЧГ=0"));
			Значення.Добавить(Формат(Рез.Відсутніх, "ЧН=0; ЧГ=0"));
			Значення.Добавить(Формат(ОчікуєБух, "ЧН=0; ЧГ=0"));
			Значення.Добавить(Формат(Рез.Помилки.Количество(), "ЧН=0; ЧГ=0"));
			Значення.Добавить(?(Зал.Пусто, "0 — у нулі", СтрЗаменить(Зал.Текст, "Залишки на ", "")));
			Если Рез.Помилки.Количество() > 0 Тогда
				Колір = Новый Цвет(255, 205, 205);
			ИначеЕсли Зал.Пусто И Рез.Порушень = 0 И Рез.Відсутніх = 0 Тогда
				Колір = Новый Цвет(215, 245, 215);
			ИначеЕсли Рез.Порушень > 0 Тогда
				Колір = Новый Цвет(255, 225, 190);
			Иначе
				Колір = Новый Цвет(255, 245, 190);
			КонецЕсли;
		Исключение
			Значення.Добавить(Строка(ДокСсылка));
			Пока Значення.Количество() < Заголовки.Количество() - 1 Цикл
				Значення.Добавить("");
			КонецЦикла;
			Значення.Добавить("ПОМИЛКА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Колір = Новый Цвет(255, 205, 205);
		КонецПопытки;
		Для Колонка = 1 По Заголовки.Количество() Цикл
			Обл = ТабДок.Область(Рядок, Колонка, Рядок, Колонка);
			Обл.Текст = ?(Колонка <= Значення.Количество(), Значення[Колонка - 1], "");
			Обл.Обвести(Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная));
			Если Колір <> Неопределено Тогда
				Обл.ЦветФона = Колір;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для Колонка = 1 По Заголовки.Количество() Цикл
		ТабДок.Область(1, Колонка, Рядок, Колонка).ШиринаКолонки = ?(Колонка = 2 Или Колонка = 4, 30, ?(Колонка = Заголовки.Количество(), 60, 14));
	КонецЦикла;
	ТабДок.ФиксацияСверху = 1;
	Возврат ТабДок;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Склади КОРЕНЯ гілки вузла об'єкта з позначкою «Основний для приходу на підрозділ»
// (закупівельні). Порожній вузол або відсутність позначок -> порожній список
// (параметр «Склади залишків» тоді не чіпаємо — у звіті спрацює автопідбір).
Функция СкладыОсновныеДляПрихода(ПодразделениеОбъекта)

	Список = Новый СписокЗначений;
	Если НЕ ЗначениеЗаполнено(ПодразделениеОбъекта) Тогда
		Возврат Список;
	КонецЕсли;

	Корень = ПодразделениеОбъекта;
	Текущий = ПодразделениеОбъекта;
	Для Счетчик = 1 По 20 Цикл
		Родитель = Текущий.Родитель;
		Если НЕ ЗначениеЗаполнено(Родитель) Тогда
			Прервать;
		КонецЕсли;
		Текущий = Родитель;
		Корень = Родитель;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Корень", Корень);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	С.Ссылка КАК Склад
	|ИЗ
	|	Справочник.Склады КАК С
	|ГДЕ
	|	С.Подразделение = &Корень
	|	И С.А_ОсновнойДляПрихода
	|	И НЕ С.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	С.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.Склад);
	КонецЦикла;

	Возврат Список;

КонецФункции

// Ідентифікатор користувацької настройки відбору за ІМЕНЕМ поля — шукається в ОСНОВНИХ
// настройках (тільки там заповнене ЛевоеЗначение). Неопределено, якщо такого відбору немає
// або він не виведений користувачеві (порожній ідентифікатор).
Функция ИдентификаторОтбораПоПолю(Настройки, ИмяПоля)
	Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Для Каждого Элемент Из Настройки.Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных")
			И Элемент.ЛевоеЗначение = Поле
			И ЗначениеЗаполнено(Элемент.ИдентификаторПользовательскойНастройки) Тогда
			Возврат Элемент.ИдентификаторПользовательскойНастройки;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Період і вузол об'єкта за виділеними розрахунками — ОДНИМ запитом.
// Запит перевірено на живій базі (Rule #-1): test_otchety_iz_zhurnala_zapros.py.
// Домики (підлеглі підрозділи) вузла обʼєкта: посилання і короткі номери «№1» — для ЗАПОВНЕНОГО, але
// ВИМКНЕНОГО відбору у звіті. Проєкти без домиків (виконавець = сам вузол) дають порожні списки.
Функция ДомикиОбъекта(УзелОбъекта)

	Результат = Новый Структура("Подразделения, Номера", Новый СписокЗначений, Новый СписокЗначений);
	Если НЕ ЗначениеЗаполнено(УзелОбъекта) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Узел", УзелОбъекта);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Ссылка КАК Ссылка,
	|	П.Наименование КАК Имя
	|ИЗ
	|	Справочник.Подразделения КАК П
	|ГДЕ
	|	П.Родитель = &Узел
	|	И НЕ П.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	П.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Подразделения.Добавить(Выборка.Ссылка);
		Номер = НомерДомикаПоИмени(Выборка.Имя);
		Если НЕ ПустаяСтрока(Номер) И Результат.Номера.НайтиПоЗначению(Номер) = Неопределено Тогда
			Результат.Номера.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Той самий розбір, що у звіті (РазобратьНомерДомика): від ОСТАННЬОГО «№» до найближчого пробілу —
// імена підрозділів мають хвостові пробіли і дублі назви в дужках.
Функция НомерДомикаПоИмени(Имя)

	Текст = СокрЛП(Строка(Имя));
	Позиция = СтрНайти(Текст, "№", НаправлениеПоиска.СКонца);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Текст, Позиция);
	Пробел = СтрНайти(Хвост, " ");
	Если Пробел > 0 Тогда
		Хвост = Лев(Хвост, Пробел - 1);
	КонецЕсли;
	Возврат СокрЛП(Хвост);

КонецФункции

// Дата найранішого розрахунку комплектацій по вузлу обʼєкта (домики — підлеглі підрозділи вузла).
Функция ПерваяДатаРасчетовОбъекта(УзелОбъекта)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Узел", УзелОбъекта);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МИНИМУМ(Д.Дата) КАК ПерваяДата
	|ИЗ
	|	Документ.РасчетКомплектаций КАК Д
	|ГДЕ
	|	НЕ Д.ПометкаУдаления
	|	И Д.Подразделение В ИЕРАРХИИ (&Узел)";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ПерваяДата) Тогда
		Возврат Выборка.ПерваяДата;
	КонецЕсли;
	Возврат '00010101';

КонецФункции

Функция ОтборПоРасчетам(ПараметрКоманды)

	Результат = Новый Структура("ДатаНачала, ДатаОкончания, Подразделение",
		'00010101', '00010101', Справочники.Подразделения.ПустаяСсылка());

	МассивСсылок = Новый Массив;
	ТипРасчета = Тип("ДокументСсылка.РасчетКомплектаций");
	Если ТипЗнч(ПараметрКоманды) = Тип("Массив") Тогда
		Для Каждого Элемент Из ПараметрКоманды Цикл
			Если ТипЗнч(Элемент) = ТипРасчета И ЗначениеЗаполнено(Элемент) Тогда
				МассивСсылок.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ПараметрКоманды) = ТипРасчета И ЗначениеЗаполнено(ПараметрКоманды) Тогда
		МассивСсылок.Добавить(ПараметрКоманды);
	КонецЕсли;

	Если МассивСсылок.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", МассивСсылок);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Д.Период <> ДАТАВРЕМЯ(1, 1, 1) ТОГДА Д.Период
	|		ИНАЧЕ Д.Дата
	|	КОНЕЦ КАК ДатаПериода,
	|	ВЫБОР
	|		КОГДА Д.Спецификация.ПодразделениеОбъекта <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|			ТОГДА Д.Спецификация.ПодразделениеОбъекта
	|		ИНАЧЕ Д.Спецификация.Подразделение
	|	КОНЕЦ КАК Драйвер
	|ИЗ
	|	Документ.РасчетКомплектаций КАК Д
	|ГДЕ
	|	Д.Ссылка В (&Ссылки)";

	Драйверы = Новый Соответствие;
	МинДата = '39991231';
	МаксДата = '00010101';
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ДатаПериода) Тогда
			МинДата = Мин(МинДата, Выборка.ДатаПериода);
			МаксДата = Макс(МаксДата, Выборка.ДатаПериода);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Драйвер) Тогда
			Драйверы.Вставить(Выборка.Драйвер, Истина);
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(МаксДата) Тогда
		Результат.ДатаНачала = НачалоМесяца(МинДата);
		Результат.ДатаОкончания = КонецМесяца(МаксДата);
	КонецЕсли;

	// Відбір ставимо лише за однозначного вузла об'єкта: інакше звіт мовчки показав би
	// один домик замість усіх виділених.
	Если Драйверы.Количество() = 1 Тогда
		Для Каждого КЗ Из Драйверы Цикл
			Результат.Подразделение = КЗ.Ключ;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции


