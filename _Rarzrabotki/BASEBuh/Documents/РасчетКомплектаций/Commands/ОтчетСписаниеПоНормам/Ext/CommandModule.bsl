// Команда підменю «Звіти»: відкриває ОДИН звіт «Списання за нормами і понад норму (бухоблік)»
// у предвизначеному варіанті «Основной» (за нормами і понад норму).
//
// Три варіанти одного звіту (рішення заказчика 2026-08-26 — замість двох окремих звітів):
//   Основной — за нормами і понад норму; Шахматка — об'єкти в колонках; ПланФакт — із залишками.
// Період і Підрозділ-об'єкт підставляє модуль менеджера (ПараметрыОткрытияОтчета) — там же
// пояснення, чому настройки передаються як «ПользовательскиеНастройки», а не «Отбор».
// ⚠ У МОДУЛІ КОМАНДИ допустимі ЛИШЕ директиви &НаКлиенте / &НаСервере.

#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	ПараметрыОткрытия = ПараметрыОткрытияНаСервере(ПараметрКоманды);

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КлючВарианта", ПараметрыОткрытия.КлючВарианта);
	ПараметрыФормы.Вставить("ПользовательскиеНастройки", ПараметрыОткрытия.ПользовательскиеНастройки);
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);

	ОткрытьФорму("Отчет.А_ОтчетПоСписаниюПоНормам_Бухгалтерский.Форма",
		ПараметрыФормы,
		ПараметрыВыполненияКоманды.Источник,
		ПараметрыОткрытия.КлючУникальности,
		ПараметрыВыполненияКоманды.Окно);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПараметрыОткрытияНаСервере(ПараметрКоманды)
	Возврат Документы.РасчетКомплектаций.ПараметрыОткрытияОтчета(
		"А_ОтчетПоСписаниюПоНормам_Бухгалтерский", ПараметрКоманды, "Основной");
КонецФункции

#КонецОбласти
