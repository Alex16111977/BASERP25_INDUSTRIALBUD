// Команда «Заповнити з казни» — працює по ВИДІЛЕНИХ рядках журналу
// (ParameterUseMode = Multiple). Уся логіка в модулі менеджера документа:
// ОДНЕ COM-з'єднання з базою Казначейства на всю пачку (кожне з'єднання
// забирає клієнтську ліцензію казни), тут лише підтвердження і зведення.

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	Если ПараметрКоманды = Неопределено Или ПараметрКоманды.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Виділіть у списку розрахунки для заповнення.';
			|uk = 'Виділіть у списку розрахунки для заповнення.'"));
		Возврат;
	КонецЕсли;

	Текст = СтрШаблон(НСтр("ru = 'Заповнити дату і опис відвантаження з бази Казначейства
		|за виділеними розрахунками (%1 шт.)?
		|
		|Пошук — за будинком з реквізиту «Підрозділ». Де відвантаження не знайдено,
		|реквізити залишаться без змін.';
		|uk = 'Заповнити дату і опис відвантаження з бази Казначейства
		|за виділеними розрахунками (%1 шт.)?
		|
		|Пошук — за будинком з реквізиту «Підрозділ». Де відвантаження не знайдено,
		|реквізити залишаться без змін.'"),
		ПараметрКоманды.Количество());
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьОтгрузкуПоКазнеЗавершение", ЭтотОбъект, ПараметрКоманды);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет,
		НСтр("ru = 'Відвантаження по казні'; uk = 'Відвантаження по казні'"));

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОтгрузкуПоКазнеЗавершение(Ответ, СписокСсылок) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьНаСервере(СписокСсылок);

	Для Каждого ДокСсылка Из СписокСсылок Цикл
		ОповеститьОбИзменении(ДокСсылка);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере(СписокСсылок)

	МассивСсылок = Новый Массив;
	Для Каждого ДокСсылка Из СписокСсылок Цикл
		МассивСсылок.Добавить(ДокСсылка);
	КонецЦикла;

	Сводка = Документы.РасчетКомплектаций.ЗаполнитьОтгрузкуПоКазнеПоСсылкам(МассивСсылок);

	Для Каждого ТекстСообщения Из Сводка.Сообщения Цикл
		Сообщить(ТекстСообщения);
	КонецЦикла;

	Сообщить("=== Відвантаження по казні: заповнено " + Формат(Сводка.Заполнено, "ЧН=0; ЧГ=0")
		+ ", не знайдено " + Формат(Сводка.НеНайдено, "ЧН=0; ЧГ=0")
		+ ?(Сводка.Ошибки > 0, ", помилок " + Формат(Сводка.Ошибки, "ЧН=0; ЧГ=0"), "") + " ===");

КонецПроцедуры
