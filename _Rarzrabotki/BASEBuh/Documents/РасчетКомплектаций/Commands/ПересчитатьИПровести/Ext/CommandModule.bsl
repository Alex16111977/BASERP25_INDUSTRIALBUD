// Команда «Перерахувати і провести» — працює по ВИДІЛЕНИХ рядках журналу
// (ParameterUseMode = Multiple): для кожного розрахунку викликає об'єктний
// ПересчитатьИПровести() — розпровести -> перерахувати -> заповнити -> провести.
// Уся логіка в модулі об'єкта; тут лише підтвердження і зведення по кожному документу.

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	Если ПараметрКоманды = Неопределено ИЛИ ПараметрКоманды.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Виділіть у списку розрахунки для перерахунку.';
			|uk = 'Виділіть у списку розрахунки для перерахунку.'"));
		Возврат;
	КонецЕсли;

	Текст = СтрШаблон(НСтр("ru = 'Розпровести, перерахувати, заповнити і провести документи списання
		|за виділеними розрахунками (%1 шт.)?
		|
		|Таблиці списання буде перебудовано за поточними залишками (за ЗАПИСАНИМИ даними розрахунків).';
		|uk = 'Розпровести, перерахувати, заповнити і провести документи списання
		|за виділеними розрахунками (%1 шт.)?
		|
		|Таблиці списання буде перебудовано за поточними залишками (за ЗАПИСАНИМИ даними розрахунків).'"),
		ПараметрКоманды.Количество());
	Оповещение = Новый ОписаниеОповещения("ПересчитатьИПровестиЗавершение", ЭтотОбъект, ПараметрКоманды);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет,
		НСтр("ru = 'Перерахунок'; uk = 'Перерахунок'"));

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИПровестиЗавершение(Ответ, СписокСсылок) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ПересчитатьНаСервере(СписокСсылок);

	Для Каждого ДокСсылка Из СписокСсылок Цикл
		ОповеститьОбИзменении(ДокСсылка);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПересчитатьНаСервере(СписокСсылок)

	ВсегоПомилок = 0;
	Для Каждого ДокСсылка Из СписокСсылок Цикл
		Сообщить("=== " + Строка(ДокСсылка) + " ===");
		ДокОбъект = ДокСсылка.ПолучитьОбъект();
		Результат = ДокОбъект.ПересчитатьИПровести();
		Сообщить("Розпроведено: " + Результат.Розпроведено
			+ "; заповнено: " + Результат.Заповнено
			+ ?(Результат.Очищено > 0, "; очищено порожніх: " + Результат.Очищено, "")
			+ ?(Результат.СтвореноПризначень > 0, "; створено призначень: " + Результат.СтвореноПризначень, "")
			+ "; проведено: " + Результат.Проведено
			+ ?(Результат.ПропущеноПорожніх > 0, " (порожніх пропущено: " + Результат.ПропущеноПорожніх + ")", ""));
		Для Каждого ТекстПопередження Из Результат.Попередження Цикл
			Сообщить("УВАГА: " + ТекстПопередження);
		КонецЦикла;
		Для Каждого ТекстПомилки Из Результат.Помилки Цикл
			Сообщить("ПОМИЛКА: " + ТекстПомилки);
		КонецЦикла;
		ВсегоПомилок = ВсегоПомилок + Результат.Помилки.Количество();
	КонецЦикла;

	Если ВсегоПомилок = 0 Тогда
		Сообщить("=== Перерахунок завершено успішно (" + СписокСсылок.Количество() + " розрахунків) ===");
	Иначе
		Сообщить("=== Перерахунок завершено З ПОМИЛКАМИ — див. повідомлення вище ===");
	КонецЕсли;

КонецПроцедуры
