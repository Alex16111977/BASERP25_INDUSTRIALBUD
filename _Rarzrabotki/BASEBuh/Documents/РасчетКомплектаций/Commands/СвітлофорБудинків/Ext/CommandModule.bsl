// Команда «Світлофор будинків» — по ВИДІЛЕНИХ розрахунках журналу (ParameterUseMode = Multiple):
// аналіз циклу кожного будинку в пам'яті (без запису) і зведення в табличний документ.

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	Если ПараметрКоманды = Неопределено Или ПараметрКоманды.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Виділіть у списку розрахунки.'; uk = 'Виділіть у списку розрахунки.'"));
		Возврат;
	КонецЕсли;
	ТабДок = СвітлофорНаСервере(ПараметрКоманды);
	ТабДок.Показать(НСтр("ru = 'Світлофор будинків'; uk = 'Світлофор будинків'"));

КонецПроцедуры

&НаСервере
Функция СвітлофорНаСервере(СписокСсылок)

	МассивСсылок = Новый Массив;
	Для Каждого ДокСсылка Из СписокСсылок Цикл
		МассивСсылок.Добавить(ДокСсылка);
	КонецЦикла;
	Возврат Документы.РасчетКомплектаций.СвітлофорБудинків(МассивСсылок);

КонецФункции
