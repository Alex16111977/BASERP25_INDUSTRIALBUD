// Форма документа «Фінансовий звіт виробництва» — тонкий диспетчер.
// Уся логіка розрахунку і друку живе у модулі об'єкта; тут лише міст об'єкт↔форма,
// умовне оформлення, master-detail розшифровки і діалоги.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	УстановитьУсловноеОформление();
	ОбновитьСостояниеРасчета();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПрименитьФильтрРасшифровки();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ОбновитьСостояниеРасчета();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Рассчитать(Команда)

	Результат = РассчитатьНаСервере();

	Если НЕ Результат.Выполнено Тогда
		ПоказатьПредупреждение(, "Розрахунок заблоковано: помилок — " + Результат.Ошибок
			+ ". Дивіться закладку «Контроль» і панель повідомлень.");
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаКонтроль;
		Возврат;
	КонецЕсли;

	Если Результат.Ошибок > 0 ИЛИ Результат.Предупреждений > 0 Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаКонтроль;
	Иначе
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаРезультат;
	КонецЕсли;

	ПрименитьФильтрРасшифровки();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПодразделения(Команда)

	Если Объект.Подразделения.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьПодразделенияЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
			"Таблична частина «Підрозділи» не порожня." + Символы.ПС
			+ "«Так» — перезаповнити з нуля (параметри рядків буде втрачено)." + Символы.ПС
			+ "«Ні» — тільки додати відсутні підрозділи.",
			РежимДиалогаВопрос.ДаНетОтмена);
		Возврат;
	КонецЕсли;

	ЗаполнитьПодразделенияНаСервере(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПодразделенияЗавершение(Ответ, ДопПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьПодразделенияНаСервере(Ответ = КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура ПечатьОтчет(Команда)

	Если НЕ ЕстьРезультатДляПечати() Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПечатнуюФорму(ПолучитьПечатнуюФорму("Отчет"), "Фінансовий звіт виробництва");

КонецПроцедуры

&НаКлиенте
Процедура ПечатьОтчетРасшифровка(Команда)

	Если НЕ ЕстьРезультатДляПечати() Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПечатнуюФорму(ПолучитьПечатнуюФорму("Расшифровка"),
		"Фінансовий звіт виробництва з розшифровкою");

КонецПроцедуры

&НаКлиенте
Процедура ПечатьДоклад(Команда)

	Если НЕ ЕстьРезультатДляПечати() Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПечатнуюФорму(ПолучитьПечатнуюФорму("Доклад"), "Доповідь");

КонецПроцедуры

&НаКлиенте
Процедура СохранитьДокладHTML(Команда)

	Если НЕ ЕстьРезультатДляПечати() Тогда
		Возврат;
	КонецЕсли;

	ИмяПоУмолчанию = "Доповідь_" + Формат(Объект.ДатаРасчета, "ДФ=yyyy-MM-dd") + ".html";
	АдресТекста = ПолучитьАдресДокладаHTML();

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Зберегти доповідь";
	Диалог.ПолноеИмяФайла = ИмяПоУмолчанию;
	Диалог.Фильтр = "HTML (*.html)|*.html";
	Диалог.Расширение = "html";
	Диалог.МножественныйВыбор = Ложь;

	// НачатьПолучениеФайлов сам показує діалог збереження і працює у тонкому та веб-клієнті.
	// (Глобальної НачатьПолучениеФайлаИзВременногоХранилища у платформі немає.)
	ПолучаемыеФайлы = Новый Массив;
	ПолучаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ИмяПоУмолчанию, АдресТекста));

	Оповещение = Новый ОписаниеОповещения("СохранитьДокладHTMLЗавершение", ЭтотОбъект);
	НачатьПолучениеФайлов(Оповещение, ПолучаемыеФайлы, Диалог, Истина);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьДокладHTMLЗавершение(ПолученныеФайлы, ДопПараметры) Экспорт

	Если ПолученныеФайлы = Неопределено ИЛИ ПолученныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ПоказатьОповещениеПользователя("Доповідь збережено", , ПолученныеФайлы[0].Имя);

КонецПроцедуры

&НаКлиенте
Процедура ПечатьДинамика(Команда)

	Если НЕ ЕстьРезультатДляПечати() Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПечатнуюФорму(ПолучитьПечатнуюФорму("Динамика"), "Динаміка");

КонецПроцедуры

&НаКлиенте
Процедура СохранитьДинамикуHTML(Команда)

	Если НЕ ЕстьРезультатДляПечати() Тогда
		Возврат;
	КонецЕсли;

	АдресТекста = ПолучитьАдресДинамикиHTML();
	Если ПустаяСтрока(АдресТекста) Тогда
		ПоказатьПредупреждение(, "Немає документа порівняння: заповніть «Документ порівняння»"
			+ " у шапці або натисніть «Розрахувати» — він підбереться автоматично.");
		Возврат;
	КонецЕсли;

	ИмяПоУмолчанию = "Динаміка_" + Формат(Объект.ДатаРасчета, "ДФ=yyyy-MM-dd") + ".html";

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Зберегти динаміку";
	Диалог.ПолноеИмяФайла = ИмяПоУмолчанию;
	Диалог.Фильтр = "HTML (*.html)|*.html";
	Диалог.Расширение = "html";
	Диалог.МножественныйВыбор = Ложь;

	ПолучаемыеФайлы = Новый Массив;
	ПолучаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ИмяПоУмолчанию, АдресТекста));

	Оповещение = Новый ОписаниеОповещения("СохранитьДинамикуHTMLЗавершение", ЭтотОбъект);
	НачатьПолучениеФайлов(Оповещение, ПолучаемыеФайлы, Диалог, Истина);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьДинамикуHTMLЗавершение(ПолученныеФайлы, ДопПараметры) Экспорт

	Если ПолученныеФайлы = Неопределено ИЛИ ПолученныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ПоказатьОповещениеПользователя("Динаміку збережено", , ПолученныеФайлы[0].Имя);

КонецПроцедуры

&НаКлиенте
Процедура СбросФильтраРасшифровки(Команда)

	ФильтрПодразделениеРасшифровки = ПредопределенноеЗначение("Справочник.Подразделения.ПустаяСсылка");
	ПрименитьФильтрРасшифровки();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзКазны(Команда)

	Если Объект.Подразделения.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьИзКазныЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
			"Таблична частина «Підрозділи» не порожня." + Символы.ПС
			+ "«Так» — перезаповнити з нуля з бази «Казна»." + Символы.ПС
			+ "«Ні» — тільки додати відсутні підрозділи.",
			РежимДиалогаВопрос.ДаНетОтмена);
		Возврат;
	КонецЕсли;

	ЗаполнитьИзКазныНаСервере(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзКазныЗавершение(Ответ, ДопПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьИзКазныНаСервере(Ответ = КодВозвратаДиалога.Да);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура РасчетПриАктивизацииСтроки(Элемент)

	// дебаунс: не смикати відбір на кожен клік під час прокрутки
	ПодключитьОбработчикОжидания("ОбновитьДетальРасшифровки", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДетальРасшифровки()

	ТекущаяСтрока = Элементы.Расчет.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ФильтрПодразделениеРасшифровки = ТекущаяСтрока.Подразделение;

	// рядок результату = договір, тому детальний відбір точніший за підрозділ
	Если ЗначениеЗаполнено(ТекущаяСтрока.Договор) Тогда
		Элементы.РасшифровкаДокументов.ОтборСтрок =
			Новый ФиксированнаяСтруктура("Договор", ТекущаяСтрока.Договор);
	Иначе
		ПрименитьФильтрРасшифровки();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПолеФильтрПодразделениеПриИзменении(Элемент)

	ПрименитьФильтрРасшифровки();

КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаДокументовВыборСтроки(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущаяСтрока = Элементы.РасшифровкаДокументов.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено И ЗначениеЗаполнено(ТекущаяСтрока.Документ) Тогда
		ПоказатьЗначение(, ТекущаяСтрока.Документ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция РассчитатьНаСервере()

	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	Результат = ОбъектДокумента.Рассчитать();
	ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
	ОбновитьСостояниеРасчета();
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьПодразделенияНаСервере(Перезаполнять)

	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	ОбъектДокумента.ЗаполнитьПодразделенияПоУмолчанию(Перезаполнять);
	ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
	ОбновитьСостояниеРасчета();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзКазныНаСервере(Перезаполнять)

	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	ОбъектДокумента.ЗаполнитьПодразделенияИзКазны(Перезаполнять);
	ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
	ОбновитьСостояниеРасчета();

КонецПроцедуры

&НаСервере
Функция ПолучитьПечатнуюФорму(ВидФормы)

	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	Если ВидФормы = "Доклад" Тогда
		Возврат ОбъектДокумента.СформироватьПечатьДоклад();
	ИначеЕсли ВидФормы = "Расшифровка" Тогда
		Возврат ОбъектДокумента.СформироватьПечатьОтчетРасшифровка();
	ИначеЕсли ВидФормы = "Динамика" Тогда
		Возврат ОбъектДокумента.СформироватьПечатьДинамика();
	КонецЕсли;
	Возврат ОбъектДокумента.СформироватьПечатьОтчет();

КонецФункции

// Порожній рядок = немає документа порівняння (клієнт покаже попередження).
&НаСервере
Функция ПолучитьАдресДинамикиHTML()

	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	ТекстHTML = ОбъектДокумента.ТекстДинамикиHTML();
	Если ПустаяСтрока(ТекстHTML) Тогда
		Возврат "";
	КонецЕсли;

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("html");
	ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(ТекстHTML);
	ЗаписьТекста.Закрыть();

	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	УдалитьФайлы(ИмяВременногоФайла);

	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

&НаСервере
Функция ПолучитьАдресДокладаHTML()

	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	ТекстHTML = ОбъектДокумента.ТекстДокладаHTML();

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("html");
	ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(ТекстHTML);
	ЗаписьТекста.Закрыть();

	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	УдалитьФайлы(ИмяВременногоФайла);

	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

&НаКлиенте
Функция ЕстьРезультатДляПечати()

	Если Объект.Расчет.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Немає що друкувати: спочатку натисніть «Розрахувати».");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ПоказатьПечатнуюФорму(ТабДок, Заголовок)

	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.Показать(Заголовок);

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьФильтрРасшифровки()

	Если ЗначениеЗаполнено(ФильтрПодразделениеРасшифровки) Тогда
		Элементы.РасшифровкаДокументов.ОтборСтрок =
			Новый ФиксированнаяСтруктура("Подразделение", ФильтрПодразделениеРасшифровки);
	Иначе
		Элементы.РасшифровкаДокументов.ОтборСтрок = Новый ФиксированнаяСтруктура();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояниеРасчета()

	Ошибок = 0;
	Предупреждений = 0;
	Для Каждого СтрокаКонтроля Из Объект.Контроль Цикл
		Если СтрокаКонтроля.Уровень = "Помилка" Тогда
			Ошибок = Ошибок + 1;
		ИначеЕсли СтрокаКонтроля.Уровень = "Попередження" Тогда
			Предупреждений = Предупреждений + 1;
		КонецЕсли;
	КонецЦикла;

	Если Объект.Расчет.Количество() = 0 Тогда
		СостояниеРасчета = "Розрахунок не виконано.";
	Иначе
		ИтогоКПолучению = 0;
		Для Каждого СтрокаРезультата Из Объект.Расчет Цикл
			ИтогоКПолучению = ИтогоКПолучению + СтрокаРезультата.ИтогоКПолучению;
		КонецЦикла;
		СостояниеРасчета = "Рядків: " + Объект.Расчет.Количество()
			+ ";  разом до отримання: " + Формат(ИтогоКПолучению, "ЧДЦ=2; ЧРГ=' '") + " грн";
	КонецЕсли;

	Если Ошибок > 0 ИЛИ Предупреждений > 0 Тогда
		СостояниеРасчета = СостояниеРасчета + ";  помилок: " + Ошибок
			+ ", попереджень: " + Предупреждений;
	КонецЕсли;

	Элементы.СтраницаКонтроль.Заголовок = "Контроль"
		+ ?(Ошибок + Предупреждений > 0, " (" + (Ошибок + Предупреждений) + ")", "");

КонецПроцедуры

// Кольори виставляються кодом: <TextColor>style:… у Form.xml валить збірку/завантаження.
&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	ДобавитьОформлениеКонтроля("Ошибка", Новый Цвет(255, 214, 214), Новый Цвет(163, 0, 0));
	ДобавитьОформлениеКонтроля("Предупреждение", Новый Цвет(255, 242, 204), Новый Цвет(138, 90, 0));

	// Від'ємні підсумки — червоним
	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Расчет.ИтогоКПолучению");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	Отбор.ПравоеЗначение = 0;
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("РасчетИтогоКПолучению");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(163, 0, 0));

	// Непроведені документи у розшифровці
	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.РасшифровкаДокументов.ДокументПроведен");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Ложь;
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("РасшДокумент");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(138, 90, 0));

	// Вимкнені рядки параметрів — приглушено
	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Подразделения.Включать");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Ложь;
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ПодразделенияПодразделение");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(150, 150, 150));

КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеКонтроля(ИмяУровня, ЦветФона, ЦветТекста)

	Элемент = УсловноеОформление.Элементы.Добавить();

	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Контроль.Уровень");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Если ИмяУровня = "Ошибка" Тогда
		Отбор.ПравоеЗначение = "Помилка";
	Иначе
		Отбор.ПравоеЗначение = "Попередження";
	КонецЕсли;

	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("КонтрольТекст");
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("КонтрольКод");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекста);

