// Документ «Фінансовий звіт виробництва» (bas_industrialbud). Непроводимий документ-калькулятор.
//
// Рахує за рахунком 361 у розрізі ПІДРОЗДІЛУ ДОГОВОРУ (перелік підрозділів — той самий, що у звіті
// «План факт Производство» з бази kazna) чотири показники:
//   E «Виконані роботи»  — оборот Дт за документами З відміткою ОтправкаПолучениеДокументов.ДокументыПолучены
//   F «Оплачено»         — оборот Кт
//   H «Акти подані»      — ① проведені БЕЗ відмітки (оборот Дт) + ② НЕпроведені документи (СуммаДокумента)
//   G «Заборгованість»   — E − F (це НЕ сальдо рахунку: сальдо містить ще й H)
// Рядок результату = ДОГОВІР. Підсумок K рахується за параметрами договору з
// РегистрСведений.А_ПараметрыДоговоровФинотчета (ВариантФормулыИтога, ПроцентГарантийногоУдержания);
// на рівнях контрагента й підрозділу K/B/C/D СУМУЮТЬСЯ, а не перераховуються (як в Excel).
//
// Рух по регістрах НЕ робить (Posting = Deny). Уся логіка тут, форма — тонкий диспетчер.

#Область ПрограммныйИнтерфейс

// Перевіряє параметри розрахунку. Заповнює ТЧ Контроль і виводить повідомлення з прив'язкою
// до конкретного рядка табличної частини. Частину «м'яких» помилок виправляє сама (обрізає
// відсотки, прибирає дублі договорів) і попереджає про це.
//
// Повертає: Булево — Істина, якщо блокуючих помилок немає.
//
Функция ПроверитьПараметры() Экспорт

	Контроль.Очистить();
	ЕстьОшибки = Ложь;

	ПроверитьПериодИСчета();
	НаборПодразделений = ПроверитьПодразделения();
	ПроверитьДополнительныеДоговоры(НаборПодразделений);

	// П18 знято 16.08.2026 разом із реквізитом СтавкаНДС: ставка тепер константна
	// у коді (СтавкаНДСРасчета) і нулем бути не може.

	Для Каждого СтрокаЗамечания Из Контроль Цикл
		Если СтрокаЗамечания.Уровень = "Помилка" Тогда
			ЕстьОшибки = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат НЕ ЕстьОшибки;

КонецФункции

// Основний розрахунок. Очищає ТІЛЬКИ результатні ТЧ (Расчет, РасшифровкаДокументов, Контроль);
// параметри користувача (Подразделения, ДоговорыДополнительно, СчетаРасчетов) не чіпає —
// перерахунок безпечний.
//
// Показники накопичуються ЗА ДОГОВОРОМ: підсумок K рахується за формулою і відсотком
// утримання З ДОГОВОРУ і лише потім підсумовується у рядок підрозділу.
//
// Повертає: Структура — Выполнено, Ошибок, Предупреждений, СтрокРасчета.
//
Функция Рассчитать() Экспорт

	Результат = Новый Структура("Выполнено, Ошибок, Предупреждений, СтрокРасчета", Ложь, 0, 0, 0);

	Если НЕ ПроверитьПараметры() Тогда
		ЗаполнитьСчетчикиРезультата(Результат);
		ВывестиЗамечанияПользователю();
		Возврат Результат;
	КонецЕсли;

	Расчет.Очистить();
	РасшифровкаДокументов.Очистить();
	Казна.Очистить();

	// Документ порівняння для «Динаміки»: якщо не вказано — останній записаний
	// непозначений документ того ж напрямку з меншою датою розрахунку.
	Если НЕ ЗначениеЗаполнено(ДокументСравнения) Тогда
		ДокументСравнения = ПодобратьДокументСравнения();
	КонецЕсли;

	МассивПодр = МассивВключенныхПодразделений();
	МассивДог  = МассивДопДоговоров();
	КартаДоп   = КартаДопДоговоров();
	НаборПодр  = НаборВключенныхПодразделений();

	// Підрозділ -> (Договір -> акумулятор E/F/H)
	Итоги = Новый Соответствие;
	Для Каждого СтрокаПодр Из ВключенныеПодразделения() Цикл
		Итоги.Вставить(СтрокаПодр.Подразделение, Новый Соответствие);
	КонецЦикла;
	СальдоПоПодразделениям = Новый Соответствие;

	// --- 1. Обороти рахунків розрахунків
	ВыборкаОборотов = ЗапросОборотов(МассивПодр, МассивДог).Выбрать();
	Пока ВыборкаОборотов.Следующий() Цикл

		// WHERE запиту вже гарантує влучання у розрахунок; перевірка — захисна
		Цель = ЦелевоеПодразделение(ВыборкаОборотов.Договор, ВыборкаОборотов.Подразделение, КартаДоп, НаборПодр);
		Если Цель = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Акк = АккумуляторДоговора(Итоги.Получить(Цель), ВыборкаОборотов.Договор,
			ВыборкаОборотов.Контрагент);
		Если ВыборкаОборотов.Оригинал Тогда
			Акк.ВыполненныеРаботы = Акк.ВыполненныеРаботы + ВыборкаОборотов.ОборотДт;
		Иначе
			Акк.АктыПроведенные = Акк.АктыПроведенные + ВыборкаОборотов.ОборотДт;
		КонецЕсли;
		Акк.Оплачено = Акк.Оплачено + ВыборкаОборотов.ОборотКт;

		ДобавитьСтрокуРасшифровки(Цель, ВыборкаОборотов);

	КонецЦикла;

	// --- 2. Непроведені документи (друга гілка колонки «Акти подані»)
	Если ВключатьНепроведенные Тогда
		ВыборкаНепроведенных = ЗапросНепроведенных(МассивПодр, МассивДог).Выбрать();
		Пока ВыборкаНепроведенных.Следующий() Цикл

			Цель = ЦелевоеПодразделение(ВыборкаНепроведенных.Договор,
				ВыборкаНепроведенных.Подразделение, КартаДоп, НаборПодр);
			Если Цель = Неопределено ИЛИ ВыборкаНепроведенных.Сумма = 0 Тогда
				Продолжить;
			КонецЕсли;

			Акк = АккумуляторДоговора(Итоги.Получить(Цель), ВыборкаНепроведенных.Договор,
				ВыборкаНепроведенных.Контрагент);
			Акк.АктыНепроведенные = Акк.АктыНепроведенные + ВыборкаНепроведенных.Сумма;

			СтрокаРасш = РасшифровкаДокументов.Добавить();
			СтрокаРасш.Подразделение   = Цель;
			СтрокаРасш.Контрагент      = ВыборкаНепроведенных.Контрагент;
			СтрокаРасш.Договор         = ВыборкаНепроведенных.Договор;
			СтрокаРасш.Документ        = ВыборкаНепроведенных.Документ;
			СтрокаРасш.ДатаДокумента   = ВыборкаНепроведенных.Дата;
			СтрокаРасш.Вид             = "Акт поданий (непроведений)";
			СтрокаРасш.ДокументПроведен = Ложь;
			СтрокаРасш.Оригинал        = Ложь;
			СтрокаРасш.СуммаДт         = ВыборкаНепроведенных.Сумма;

		КонецЦикла;
	КонецЕсли;

	// --- 3. Сальдо (тільки для контролю К01)
	ВыборкаСальдо = ЗапросСальдо(МассивПодр, МассивДог).Выбрать();
	Пока ВыборкаСальдо.Следующий() Цикл
		Цель = ЦелевоеПодразделение(ВыборкаСальдо.Договор, ВыборкаСальдо.Подразделение, КартаДоп, НаборПодр);
		Если Цель <> Неопределено Тогда
			НакопленноеСальдо = СальдоПоПодразделениям.Получить(Цель);
			Если НакопленноеСальдо = Неопределено Тогда
				НакопленноеСальдо = 0;
			КонецЕсли;
			СальдоПоПодразделениям.Вставить(Цель, НакопленноеСальдо + ВыборкаСальдо.Сальдо);
		КонецЕсли;
	КонецЦикла;

	// --- 3а. Договори з «Договори додатково» БЕЗ оборотів у періоді: порожній акумулятор,
	// щоб у звіті зʼявився рядок із сумами угод C/D з регістру параметрів (звірка з Excel:
	// внутрішні договори-контейнери IRC/ВООЗ та договори без руху 361 інакше не видно).
	Для Каждого СтрокаДог Из ДоговорыДополнительно Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаДог.Договор) Тогда
			Продолжить;
		КонецЕсли;
		Цель = ЦелевоеПодразделение(СтрокаДог.Договор, СтрокаДог.Договор.Подразделение,
			КартаДоп, НаборПодр);
		Если Цель = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		КартаДоговоров = Итоги.Получить(Цель);
		Если КартаДоговоров = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если КартаДоговоров.Получить(СтрокаДог.Договор) = Неопределено Тогда
			АккумуляторДоговора(КартаДоговоров, СтрокаДог.Договор, СтрокаДог.Договор.Владелец);
		КонецЕсли;
	КонецЦикла;

	// --- 4. Рядки результату
	ЗаполнитьСтрокиРасчета(Итоги, СальдоПоПодразделениям);

	// --- 5. Контролі після розрахунку. «Неотнесені» обороти основний запит відсікає
	// своїм WHERE, тому для К03 їх шукає ОКРЕМИЙ запит з інверсією фільтра.
	НеотнесенныеОбороты = ЗапросНеотнесенныхОборотов(МассивПодр, МассивДог).Выгрузить();
	КонтролиПослеРасчета(НеотнесенныеОбороты);

	// --- 5а. Блок «Казна»: план-факт виробництва з бази kazna.
	// Збій казни НЕ ронить розрахунок — тільки П34 у контролі.
	ЗаполнитьБлокКазны();

	ЗаполнитьСчетчикиРезультата(Результат);
	Результат.Выполнено    = Истина;
	Результат.СтрокРасчета = Расчет.Количество();

	// Стан розрахунку показує напис «СостояниеРасчета» на формі (рядків / разом / зауваження) —
	// окремий реквізит Статус прибрано 16.08.2026 як дубль.

	ВывестиЗамечанияПользователю();

	Возврат Результат;

КонецФункции

// Заповнює ТЧ Подразделения.
// Якщо у шапці заданий Направление — бере підрозділи договорів цього напрямку
// (за замовчуванням тільки ті, де у періоді є рух — інакше 45 порожніх рядків).
// Якщо напрямок не заданий — падає на фіксований перелік звіту «План факт Производство».
// Перезаполнять = Істина — попередньо очищає (параметри рядків буде втрачено).
//
Процедура ЗаполнитьПодразделенияПоУмолчанию(Перезаполнять = Ложь) Экспорт

	Если Перезаполнять Тогда
		Подразделения.Очистить();
	КонецЕсли;

	Если ЗначениеЗаполнено(Направление) Тогда
		ЗаполнитьПодразделенияПоНаправлению();
		Возврат;
	КонецЕсли;

	ЗаполнитьПодразделенияИзПереченьЗвиту();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииЗаполнения

Процедура ЗаполнитьПодразделенияПоНаправлению()

	Если НЕ ЗначениеЗаполнено(ДатаРасчета) Тогда
		ДобавитьЗамечание("Ошибка", "П04",
			"Спочатку заповніть «Дата розрахунку» — без неї не визначити, де є рух.",
			Неопределено, "Объект.ДатаРасчета");
		ВывестиЗамечанияПользователю();
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Д.Подразделение КАК Подразделение
	|ПОМЕСТИТЬ ВТПодразделенияНаправления
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Д
	|ГДЕ
	|	Д.Направление = &Направление
	|	И НЕ Д.ПометкаУдаления
	|	И Д.Подразделение <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	И НЕ Д.Подразделение.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(Об.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Подразделение КАК Подразделение
	|ПОМЕСТИТЬ ВТСДвижениями
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПериода, &ДатаРасчета, ,
	|		Счет В (&Счета), , , , ) КАК Об
	|ГДЕ
	|	ВЫРАЗИТЬ(Об.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Направление = &Направление
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Р.ДоговорКонтрагента.Подразделение
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Р
	|ГДЕ
	|	НЕ Р.Проведен И НЕ Р.ПометкаУдаления И Р.Дата <= &ДатаРасчета
	|	И Р.ДоговорКонтрагента.Направление = &Направление
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Р.ДоговорКонтрагента.Подразделение
	|ИЗ
	|	Документ.РеализацияУслугПоПереработке КАК Р
	|ГДЕ
	|	НЕ Р.Проведен И НЕ Р.ПометкаУдаления И Р.Дата <= &ДатаРасчета
	|	И Р.ДоговорКонтрагента.Направление = &Направление
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Р.ДоговорКонтрагента.Подразделение
	|ИЗ
	|	Документ.АктОбОказанииПроизводственныхУслуг КАК Р
	|ГДЕ
	|	НЕ Р.Проведен И НЕ Р.ПометкаУдаления И Р.Дата <= &ДатаРасчета
	|	И Р.ДоговорКонтрагента.Направление = &Направление
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Р.ДоговорКонтрагента.Подразделение
	|ИЗ
	|	Документ.ИмпРеализацияСтроительныхРаботУслуг КАК Р
	|ГДЕ
	|	НЕ Р.Проведен И НЕ Р.ПометкаУдаления И Р.Дата <= &ДатаРасчета
	|	И Р.ДоговорКонтрагента.Направление = &Направление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	П.Подразделение КАК Подразделение,
	|	П.Подразделение.Наименование КАК Наименование,
	|	ВЫБОР КОГДА Д.Подразделение ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ КАК ЕстьДвижения
	|ИЗ
	|	ВТПодразделенияНаправления КАК П
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСДвижениями КАК Д
	|		ПО Д.Подразделение = П.Подразделение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";

	Запрос.УстановитьПараметр("Направление", Направление);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоРасчетногоПериода());
	Запрос.УстановитьПараметр("ДатаРасчета", МоментРасчета());
	Запрос.УстановитьПараметр("Счета", МассивСчетов());

	Выборка = Запрос.Выполнить().Выбрать();
	Добавлено = 0;
	Пропущено = 0;

	Пока Выборка.Следующий() Цикл

		Если ЗаполнятьТолькоСДвижениями И НЕ Выборка.ЕстьДвижения Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Если Подразделения.Найти(Выборка.Подразделение, "Подразделение") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Подразделения.Добавить();
		НоваяСтрока.Подразделение = Выборка.Подразделение;
		НоваяСтрока.Включать      = Истина;
		Добавлено = Добавлено + 1;

	КонецЦикла;

	ДобавитьЗамечание("Информация", "П32",
		"Напрямок «" + Строка(Направление) + "»: додано підрозділів " + Добавлено
		+ ?(Пропущено > 0, ", пропущено без руху за період " + Пропущено, "") + ".",
		Неопределено, "Объект.Подразделения");
	ВывестиЗамечанияПользователю();

КонецПроцедуры

Процедура ЗаполнитьПодразделенияИзПереченьЗвиту()

	// Найменування — точно як у звіті з kazna. УВАГА: у двох є ПОДВІЙНІ пробіли, не «схлопувати».
	Имена = Новый Массив;
	Имена.Добавить("МК Подгорцы");
	Имена.Добавить("МК Каменец Цемент");
	Имена.Добавить("МД IRC 2026");
	Имена.Добавить("МД ООН Админ");
	Имена.Добавить("МД Вооз ЕМS Мала 2026");
	Имена.Добавить("МК Кривий ріг");
	Имена.Добавить("МД МХП ОРІЛЬ");
	Имена.Добавить("МК Чорноморськ");
	Имена.Добавить("МД ООН 2026");
	Имена.Добавить("МД ПРООН Черкаси  ДСНС");
	Имена.Добавить("МД ВООЗ  2025");
	Имена.Добавить("МД ООН 2025");
	Имена.Добавить("МД Кернел Кухня");
	Имена.Добавить("МК Глобино");

	НеЗнайдено = "";
	Для Каждого ИмяПодразделения Из Имена Цикл

		НайденноеПодразделение = Справочники.Подразделения.НайтиПоНаименованию(ИмяПодразделения, Истина);
		Если НЕ ЗначениеЗаполнено(НайденноеПодразделение) Тогда
			НеЗнайдено = НеЗнайдено + ?(ПустаяСтрока(НеЗнайдено), "", ", ") + ИмяПодразделения;
			Продолжить;
		КонецЕсли;

		Если Подразделения.Найти(НайденноеПодразделение, "Подразделение") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Подразделения.Добавить();
		НоваяСтрока.Подразделение = НайденноеПодразделение;
		НоваяСтрока.Включать      = Истина;

	КонецЦикла;

	Если НЕ ПустаяСтрока(НеЗнайдено) Тогда
		ДобавитьЗамечание("Предупреждение", "П30",
			"Не знайдено у довіднику «Підрозділи»: " + НеЗнайдено
			+ ". Перевірте найменування (у деяких є подвійні пробіли).",
			Неопределено, "Объект.Подразделения");
		ВывестиЗамечанияПользователю();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейсПродолжение

// Рядок COM-підключення до бази kazna. Тримається В КОДІ навмисно (рішення користувача
// 16.08.2026): у типовій конфігурації — мінімум власних об'єктів, без констант.
Функция СтрокаПодключенияКазны()

	Возврат "Srvr=""SQLSERVER"";Ref=""kazna"";Usr=""cfo"";Pwd=""2442"";";

КонецФункции

// Тягне підрозділи проекту «Производство» з бази kazna: РегистрНакопления.БюджетыНаМесяц,
// обороти з початку місяця по дату розрахунку. Джерело перевірене: 14/14 збігів зі звітом
// «План факт Производство» (РН.БДДС давав лише 4/14 — НЕ використовувати).
// «Главный офис» виключається за іменем — у звіті його немає.
// Зіставлення з довідником — ЗА НАЙМЕНУВАННЯМ: UUID двох підрозділів («МД Кернел Кухня»,
// «МК Глобино») між базами різні. Подвійні пробіли в іменах значущі — не «схлопувати».
// Перезаполнять = Істина — попередньо очищає табличну частину.
//
Процедура ЗаполнитьПодразделенияИзКазны(Перезаполнять = Ложь) Экспорт

	Если НЕ ЗначениеЗаполнено(ДатаРасчета) Тогда
		ДобавитьЗамечание("Ошибка", "П04",
			"Спочатку заповніть «Дата розрахунку» — без неї не визначити період оборотів у Казні.",
			Неопределено, "Объект.ДатаРасчета");
		ВывестиЗамечанияПользователю();
		Возврат;
	КонецЕсли;

	СтрокаПодключения = СтрокаПодключенияКазны();

	// Казна може бути недоступна — це не повинно ронити форму.
	// УВАГА: імʼя змінної НЕ «Казна» — так називається таблична частина документа,
	// локальна змінна з цим імʼям у модулі обʼєкта конфліктує з нею (мовчазний збій).
	Попытка
		Коннектор = Новый COMОбъект("V83.COMConnector");
		СоединениеКазны = Коннектор.Connect(СтрокаПодключения);
	Исключение
		ДобавитьЗамечание("Ошибка", "П34",
			"Не вдалося підключитися до бази «Казна»: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			Неопределено, "Объект.Подразделения");
		ВывестиЗамечанияПользователю();
		Возврат;
	КонецПопытки;

	Попытка
		НаправлениеКазна = СоединениеКазны.Справочники.Направления.НайтиПоНаименованию("Производство", Истина);
		ЗапросКазны = СоединениеКазны.NewObject("Запрос");
		ЗапросКазны.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Об.Подразделение.Наименование КАК Имя
		|ИЗ
		|	РегистрНакопления.БюджетыНаМесяц.Обороты(&НачалоМесяца, &ДатаРасчета, ,
		|		Направление = &Направление) КАК Об
		|ГДЕ
		|	Об.Подразделение <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Имя";
		ЗапросКазны.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ДатаРасчета));
		ЗапросКазны.УстановитьПараметр("ДатаРасчета", МоментРасчета());
		ЗапросКазны.УстановитьПараметр("Направление", НаправлениеКазна);
		ВыборкаКазны = ЗапросКазны.Выполнить().Выбрать();
	Исключение
		ДобавитьЗамечание("Ошибка", "П34",
			"Запит до бази «Казна» не виконався: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			Неопределено, "Объект.Подразделения");
		ВывестиЗамечанияПользователю();
		Возврат;
	КонецПопытки;

	Если Перезаполнять Тогда
		Подразделения.Очистить();
	КонецЕсли;

	Добавлено = 0;
	НеЗнайдено = "";
	Пока ВыборкаКазны.Следующий() Цикл

		// .Наименование вибрано рядком ще на стороні Казни — COM-об'єкти сюди не потрапляють
		ИмяПодразделения = ВыборкаКазны.Имя;
		Если ИмяПодразделения = "Главный офис" Тогда
			Продолжить;
		КонецЕсли;

		НайденноеПодразделение = Справочники.Подразделения.НайтиПоНаименованию(ИмяПодразделения, Истина);
		Если НЕ ЗначениеЗаполнено(НайденноеПодразделение) Тогда
			НеЗнайдено = НеЗнайдено + ?(ПустаяСтрока(НеЗнайдено), "", ", ") + ИмяПодразделения;
			Продолжить;
		КонецЕсли;

		Если Подразделения.Найти(НайденноеПодразделение, "Подразделение") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Подразделения.Добавить();
		НоваяСтрока.Подразделение = НайденноеПодразделение;
		НоваяСтрока.Включать      = Истина;
		Добавлено = Добавлено + 1;

	КонецЦикла;

	Если НЕ ПустаяСтрока(НеЗнайдено) Тогда
		ДобавитьЗамечание("Предупреждение", "П33",
			"У Казні є, але не знайдено у довіднику «Підрозділи»: " + НеЗнайдено
			+ ". Перевірте найменування (у деяких є подвійні пробіли).",
			Неопределено, "Объект.Подразделения");
	КонецЕсли;

	ДобавитьЗамечание("Информация", "П35",
		"З Казни (проект «Производство», " + Формат(НачалоМесяца(ДатаРасчета), "ДФ=dd.MM.yyyy")
		+ " — " + Формат(ДатаРасчета, "ДФ=dd.MM.yyyy") + ") додано підрозділів: " + Добавлено + ".",
		Неопределено, "Объект.Подразделения");
	ВывестиЗамечанияПользователю();

КонецПроцедуры

// Заголовок для друкованих форм. Реквізит ЗаголовокОтчета прибрано 16.08.2026 —
// заголовок завжди формується з дати розрахунку.
Функция ЗаголовокПечати() Экспорт

	Возврат "Фінансовий звіт виробництва станом на " + Формат(ДатаРасчета, "ДФ=dd.MM.yyyy");

КонецФункции

// Друкована форма «Фінансовий звіт виробництва» — директорська, 1:1 з ручним Excel:
// дворівнева шапка, три рівні рядків (Підрозділ → Контрагент → Договір), підсумок.
//
Функция СформироватьПечатьОтчет() Экспорт

	Возврат СформироватьТабличныйОтчет(Ложь);

КонецФункции

// Робочий варіант звіту: ті самі рівні, плюс під кожним договором рядки ВСІХ документів
// (виконані роботи, оплати, акти; непроведені — з позначкою «(не проведено)»).
//
Функция СформироватьПечатьОтчетРасшифровка() Экспорт

	Возврат СформироватьТабличныйОтчет(Истина);

КонецФункции

// Потоковий вивід з АВТОГРУПУВАННЯМ рядків (як у друку «План-факт» РасчетКомплектаций):
// рівні згортання Підрозділ(1) → Контрагент(2) → Договір(3) → документи(4), «+/−» зліва.
// Групування працює лише через Вывести(), тому кожен рядок будується у буфері-табдоку
// з ОДНАКОВИМИ ширинами колонок і виводиться потоком.
Функция СформироватьТабличныйОтчет(СРасшифровкой)

	КолонокВсего = 11;
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДок.ИмяПараметровПечати = ?(СРасшифровкой,
		"А_ФинансовыйОтчетПроизводства_Расшифровка", "А_ФинансовыйОтчетПроизводства");

	ТабДок.Вывести(БуферШапкиОтчета(КолонокВсего));
	ТабДок.ФиксацияСверху = 5;

	ЦветПодразделения = Новый Цвет(226, 239, 217);
	ЦветИтога = Новый Цвет(232, 232, 232);

	// Дерево рівнів: рядки Расчет уже впорядковані (підрозділ → контрагент → договір),
	// але суми верхніх рівнів відомі лише після проходу — тому спершу збірка, потім друк.
	Итог = НовыйНаборСуммПечати();
	УзлыПодразделений = Новый Массив;
	УзелПодр = Неопределено;
	УзелКонтр = Неопределено;

	Для Каждого СтрокаРезультата Из Расчет Цикл

		Если УзелПодр = Неопределено ИЛИ УзелПодр.Подразделение <> СтрокаРезультата.Подразделение Тогда
			УзелПодр = Новый Структура("Подразделение, Суммы, Контрагенты",
				СтрокаРезультата.Подразделение, НовыйНаборСуммПечати(), Новый Массив);
			УзлыПодразделений.Добавить(УзелПодр);
			УзелКонтр = Неопределено;
		КонецЕсли;

		Если УзелКонтр = Неопределено ИЛИ УзелКонтр.Контрагент <> СтрокаРезультата.Контрагент Тогда
			УзелКонтр = Новый Структура("Контрагент, Суммы, Договоры",
				СтрокаРезультата.Контрагент, НовыйНаборСуммПечати(), Новый Массив);
			УзелПодр.Контрагенты.Добавить(УзелКонтр);
		КонецЕсли;

		УзелКонтр.Договоры.Добавить(СтрокаРезультата);
		ДобавитьВСуммыПечати(УзелПодр.Суммы, СтрокаРезультата);
		ДобавитьВСуммыПечати(УзелКонтр.Суммы, СтрокаРезультата);
		ДобавитьВСуммыПечати(Итог, СтрокаРезультата);

	КонецЦикла;

	ТабДок.НачатьАвтогруппировкуСтрок();

	Для Каждого УзелПодр Из УзлыПодразделений Цикл

		ВывестиСтрокуУровня(ТабДок,
			Строка(УзелПодр.Подразделение), "", УзелПодр.Суммы, ЦветПодразделения, 1);

		Для Каждого УзелКонтр Из УзелПодр.Контрагенты Цикл

			// нульовий рядок підрозділу без руху — рівні контрагента/договору не друкуємо
			Если НЕ ЗначениеЗаполнено(УзелКонтр.Контрагент)
				И УзелКонтр.Договоры.Количество() = 1
				И НЕ ЗначениеЗаполнено(УзелКонтр.Договоры[0].Договор) Тогда
				Продолжить;
			КонецЕсли;

			ВывестиСтрокуУровня(ТабДок,
				"    " + Строка(УзелКонтр.Контрагент), "", УзелКонтр.Суммы, Неопределено, 2);

			Для Каждого СтрокаДоговора Из УзелКонтр.Договоры Цикл

				Значения = Новый Массив;
				Значения.Добавить("        " + Строка(СтрокаДоговора.Договор));
				Значения.Добавить(СтрокаДоговора.Примечание);
				Значения.Добавить(СтрокаДоговора.СуммаСоглашения);
				Значения.Добавить(СтрокаДоговора.СуммаДЦ);
				Значения.Добавить(СтрокаДоговора.ВыполненныеРаботы);
				Значения.Добавить(СтрокаДоговора.Оплачено);
				Значения.Добавить(СтрокаДоговора.Задолженность);
				Значения.Добавить(СтрокаДоговора.АктыПоданные);
				Значения.Добавить(СтрокаДоговора.ГарантийныеПлатежи);
				Значения.Добавить(СтрокаДоговора.НДСНезарегистрированный);
				Значения.Добавить(СтрокаДоговора.ИтогоКПолучению);
				ВывестиСтрокуПотоком(ТабДок, Значения, Ложь, Неопределено, 3);

				Если СРасшифровкой Тогда
					ВывестиДокументыДоговора(ТабДок, СтрокаДоговора);
				КонецЕсли;

			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

	ТабДок.ЗакончитьАвтогруппировкуСтрок();

	ВывестиСтрокуУровня(ТабДок, "РАЗОМ", "", Итог, ЦветИтога, 0);

	БуферПодписи = НовыйБуферСтроки();
	Обл = БуферПодписи.Область(2, 1, 2, КолонокВсего);
	Обл.Объединить();
	Обл.Текст = "Відповідальний: ______________________   " + Строка(Ответственный);
	ТабДок.Вывести(БуферПодписи);

	Возврат ТабДок;

КонецФункции

// Друкована форма «Доповідь» — шпаргалка для зачитування на нараді:
// фраза по кожному об'єкту + підсумкова таблиця + блок зауважень.
//
Функция СформироватьПечатьДоклад() Экспорт

	КолонокВсего = 5;
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.ИмяПараметровПечати = "А_ФинансовыйОтчетПроизводства_Доклад";

	Обл = ТабДок.Область(1, 1, 1, КолонокВсего);
	Обл.Объединить();
	Обл.Текст = "ДОПОВІДЬ. " + ЗаголовокПечати();
	Обл.Шрифт = Новый Шрифт(, 12, Истина);
	Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;

	// рядок ширин — обов'язково НЕобʼєднаний
	Ширины = Новый Массив;
	Ширины.Добавить(34);
	Ширины.Добавить(16);
	Ширины.Добавить(16);
	Ширины.Добавить(16);
	Ширины.Добавить(18);
	Для Индекс = 0 По Ширины.ВГраница() Цикл
		ТабДок.Область(2, Индекс + 1, 2, Индекс + 1).ШиринаКолонки = Ширины[Индекс];
	КонецЦикла;

	НомерСтроки = 3;
	Для Каждого СтрокаТекста Из МассивФразДоклада() Цикл
		Обл = ТабДок.Область(НомерСтроки, 1, НомерСтроки, КолонокВсего);
		Обл.Объединить();
		Обл.Текст = СтрокаТекста;
		Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	НомерСтроки = НомерСтроки + 1;

	Заголовки = Новый Массив;
	Заголовки.Добавить("Об'єкт");
	Заголовки.Добавить("Виконано, грн");
	Заголовки.Добавить("Оплачено, грн");
	Заголовки.Добавить("Акти подані, грн");
	Заголовки.Добавить("Разом до отримання, грн");
	ВывестиСтрокуОтчета(ТабДок, НомерСтроки, Заголовки, Истина, Новый Цвет(210, 224, 240), Истина);
	НомерСтроки = НомерСтроки + 1;

	ИтогE = 0; ИтогF = 0; ИтогH = 0; ИтогK = 0;
	Для Каждого СтрокаРезультата Из СводРасчетаПоПодразделениям() Цикл
		Значения = Новый Массив;
		Значения.Добавить(Строка(СтрокаРезультата.Подразделение));
		Значения.Добавить(СтрокаРезультата.ВыполненныеРаботы);
		Значения.Добавить(СтрокаРезультата.Оплачено);
		Значения.Добавить(СтрокаРезультата.АктыПоданные);
		Значения.Добавить(СтрокаРезультата.ИтогоКПолучению);
		ВывестиСтрокуОтчета(ТабДок, НомерСтроки, Значения, Ложь);
		НомерСтроки = НомерСтроки + 1;
		ИтогE = ИтогE + СтрокаРезультата.ВыполненныеРаботы;
		ИтогF = ИтогF + СтрокаРезультата.Оплачено;
		ИтогH = ИтогH + СтрокаРезультата.АктыПоданные;
		ИтогK = ИтогK + СтрокаРезультата.ИтогоКПолучению;
	КонецЦикла;

	Итоги = Новый Массив;
	Итоги.Добавить("РАЗОМ");
	Итоги.Добавить(ИтогE);
	Итоги.Добавить(ИтогF);
	Итоги.Добавить(ИтогH);
	Итоги.Добавить(ИтогK);
	ВывестиСтрокуОтчета(ТабДок, НомерСтроки, Итоги, Истина, Новый Цвет(232, 232, 232));

	Возврат ТабДок;

КонецФункции

// HTML-версія доповіді (для збереження у файл і надсилання).
Функция ТекстДокладаHTML() Экспорт

	Текст = "<!doctype html><html lang=""uk""><head><meta charset=""utf-8"">";
	Текст = Текст + "<title>" + ЗаголовокПечати() + "</title><style>";
	Текст = Текст + "body{font-family:Segoe UI,Arial,sans-serif;font-size:13px;color:#1b1b1b;margin:24px}";
	Текст = Текст + "h1{font-size:18px;margin:0 0 4px}p{margin:6px 0}";
	Текст = Текст + "table{border-collapse:collapse;margin-top:12px;width:100%}";
	Текст = Текст + "th,td{border:1px solid #b5b5b5;padding:5px 7px}";
	Текст = Текст + "th{background:#d2e0f0;text-align:center}";
	Текст = Текст + "td.n{text-align:right;white-space:nowrap}tr.t td{background:#e8e8e8;font-weight:bold}";
	Текст = Текст + ".w{color:#8a5a00}.e{color:#a30000}</style></head><body>";
	Текст = Текст + "<h1>" + ЗаголовокПечати() + "</h1>";

	Для Каждого СтрокаТекста Из МассивФразДоклада() Цикл
		Текст = Текст + "<p>" + ЭкранироватьHTML(СтрокаТекста) + "</p>";
	КонецЦикла;

	Текст = Текст + "<table><tr><th>Об'єкт</th><th>Виконано, грн</th><th>Оплачено, грн</th>"
		+ "<th>Акти подані, грн</th><th>Разом до отримання, грн</th></tr>";

	ИтогE = 0; ИтогF = 0; ИтогH = 0; ИтогK = 0;
	Для Каждого СтрокаРезультата Из СводРасчетаПоПодразделениям() Цикл
		Текст = Текст + "<tr><td>" + ЭкранироватьHTML(Строка(СтрокаРезультата.Подразделение)) + "</td>"
			+ "<td class=""n"">" + ЧислоДляHTML(СтрокаРезультата.ВыполненныеРаботы) + "</td>"
			+ "<td class=""n"">" + ЧислоДляHTML(СтрокаРезультата.Оплачено) + "</td>"
			+ "<td class=""n"">" + ЧислоДляHTML(СтрокаРезультата.АктыПоданные) + "</td>"
			+ "<td class=""n"">" + ЧислоДляHTML(СтрокаРезультата.ИтогоКПолучению) + "</td></tr>";
		ИтогE = ИтогE + СтрокаРезультата.ВыполненныеРаботы;
		ИтогF = ИтогF + СтрокаРезультата.Оплачено;
		ИтогH = ИтогH + СтрокаРезультата.АктыПоданные;
		ИтогK = ИтогK + СтрокаРезультата.ИтогоКПолучению;
	КонецЦикла;

	Текст = Текст + "<tr class=""t""><td>РАЗОМ</td><td class=""n"">" + ЧислоДляHTML(ИтогE)
		+ "</td><td class=""n"">" + ЧислоДляHTML(ИтогF) + "</td><td class=""n"">" + ЧислоДляHTML(ИтогH)
		+ "</td><td class=""n"">" + ЧислоДляHTML(ИтогK) + "</td></tr></table>";

	Возврат Текст + "</body></html>";

КонецФункции

// Друкована форма «Динаміка»: порівняння з попереднім звітом (реквізит ДокументСравнения).
// Потокова побудова з автогрупуванням рядків (як основний друк): підрозділ (рівень 1) →
// показники E/F/H/K і договори з ненульовою зміною (рівень 2) → нові та зниклі документи
// (рівень 3, клік по рядку відкриває документ). Поліпшення зверху, погіршення знизу.
// Минулий документ читається ЗАПИСАНИМ, БЕЗ перерахунку: порівнюємо звіт зі звітом
// (регламент knowledge_Письмо Директору/03_dinamika_nedeli.md).
Функция СформироватьПечатьДинамика() Экспорт

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДок.ИмяПараметровПечати = "А_ФинансовыйОтчетПроизводства_Динамика";

	Данные = ДанныеДинамики();
	Если Данные = Неопределено Тогда
		Обл = ТабДок.Область(1, 1, 1, 5);
		Обл.Объединить();
		Обл.Текст = "Немає документа порівняння. Заповніть «Документ порівняння» у шапці"
			+ " або натисніть «Розрахувати» — він підбереться автоматично.";
		Возврат ТабДок;
	КонецЕсли;

	// Шапка окремим буфером: заголовок обʼєднаний, ширини — на НЕобʼєднаному рядку 2
	Буфер = НовыйБуферДинамики(2);
	Обл = Буфер.Область(1, 1, 1, 5);
	Обл.Объединить();
	Обл.Текст = "Динаміка фінансового звіту виробництва: "
		+ Формат(Данные.ДатаБыло, "ДФ=dd.MM.yyyy") + " → " + Формат(ДатаРасчета, "ДФ=dd.MM.yyyy");
	Обл.Шрифт = Новый Шрифт(, 12, Истина);
	Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ТабДок.Вывести(Буфер);

	Заголовки = Новый Массив;
	Заголовки.Добавить("Підрозділ / показник");
	Заголовки.Добавить("Деталі");
	Заголовки.Добавить("Було, грн");
	Заголовки.Добавить("Стало, грн");
	Заголовки.Добавить("Зміна, грн");
	ВывестиСтрокуДинамики(ТабДок, Заголовки, Истина, Новый Цвет(210, 224, 240), 0);

	ЦветПодразделения = Новый Цвет(226, 235, 218);
	ЦветНепроведенных = Новый Цвет(138, 90, 0);

	ТабДок.НачатьАвтогруппировкуСтрок();

	Для Каждого СтрокаПодр Из Данные.Подразделения Цикл

		Значения = МассивКолонокДинамики(СтрокаПодр.Имя);
		Значения[1] = "Разом до отримання (K)";
		Значения[2] = СтрокаПодр.ИтогоБыло;
		Значения[3] = СтрокаПодр.ИтогоСтало;
		Значения[4] = СтрокаПодр.ИтогоСтало - СтрокаПодр.ИтогоБыло;
		ВывестиСтрокуДинамики(ТабДок, Значения, Истина, ЦветПодразделения, 1);

		ВывестиПоказательДинамики(ТабДок, "Виконано робіт (E)",
			СтрокаПодр.ВыполненоБыло, СтрокаПодр.ВыполненоСтало);
		ВывестиПоказательДинамики(ТабДок, "Оплачено (F)",
			СтрокаПодр.ОплаченоБыло, СтрокаПодр.ОплаченоСтало);
		ВывестиПоказательДинамики(ТабДок, "Акти подані (H)",
			СтрокаПодр.АктыБыло, СтрокаПодр.АктыСтало);
		ВывестиПоказательДинамики(ТабДок, "Разом до отримання (K)",
			СтрокаПодр.ИтогоБыло, СтрокаПодр.ИтогоСтало);

		ОтборПодразделения = Новый Структура("ИмяПодразделения", СтрокаПодр.Имя);

		СтрокиДоговоров = Данные.Договоры.НайтиСтроки(ОтборПодразделения);
		Если СтрокиДоговоров.Количество() > 0 Тогда
			ВывестиСтрокуДинамики(ТабДок,
				МассивКолонокДинамики("    Договори з ненульовою зміною:"), Истина, Неопределено, 2);
			Для Каждого СтрокаДог Из СтрокиДоговоров Цикл
				Значения = МассивКолонокДинамики("        " + СтрокаДог.Показатель);
				Значения[1] = СтрокаДог.Заголовок;
				Значения[2] = СтрокаДог.Было;
				Значения[3] = СтрокаДог.Стало;
				Значения[4] = СтрокаДог.Стало - СтрокаДог.Было;
				ВывестиСтрокуДинамики(ТабДок, Значения, Ложь, Неопределено, 2, , Истина);
			КонецЦикла;
		КонецЕсли;

		НовыеСтроки = Данные.Новые.НайтиСтроки(ОтборПодразделения);
		Если НовыеСтроки.Количество() > 0 Тогда
			ВывестиСтрокуДинамики(ТабДок,
				МассивКолонокДинамики("    Що дало зміну — нові документи:"), Истина, Неопределено, 2);
			Для Каждого СтрокаСобытия Из НовыеСтроки Цикл
				Значения = МассивКолонокДинамики("        + "
					+ Формат(СтрокаСобытия.Дата, "ДФ=dd.MM.yyyy") + "  " + СтрокаСобытия.Вид
					+ ?(СтрокаСобытия.Проведен, "", " (не проведено)"));
				Значения[1] = СтрокаСобытия.ИмяДокумента;
				Значения[4] = СтрокаСобытия.Сумма;
				ВывестиСтрокуДинамики(ТабДок, Значения, Ложь, Неопределено, 3,
					СтрокаСобытия.Документ, Истина,
					?(СтрокаСобытия.Проведен, Неопределено, ЦветНепроведенных));
			КонецЦикла;
		КонецЕсли;

		УшедшиеСтроки = Данные.Ушедшие.НайтиСтроки(ОтборПодразделения);
		Если УшедшиеСтроки.Количество() > 0 Тогда
			ВывестиСтрокуДинамики(ТабДок,
				МассивКолонокДинамики("    Зникли з розрахунку (були минулого разу):"),
				Истина, Неопределено, 2);
			Для Каждого СтрокаСобытия Из УшедшиеСтроки Цикл
				Значения = МассивКолонокДинамики("        − "
					+ Формат(СтрокаСобытия.Дата, "ДФ=dd.MM.yyyy") + "  " + СтрокаСобытия.Вид);
				Значения[1] = СтрокаСобытия.ИмяДокумента;
				Значения[4] = -СтрокаСобытия.Сумма;
				ВывестиСтрокуДинамики(ТабДок, Значения, Ложь, Неопределено, 3,
					СтрокаСобытия.Документ, Истина, ЦветНепроведенных);
			КонецЦикла;
		КонецЕсли;

	КонецЦикла;

	ТабДок.ЗакончитьАвтогруппировкуСтрок();

	// Фрази-висновки економіста — під таблицями
	Для Каждого Фраза Из МассивФразДинамики(Данные) Цикл
		ВывестиФразуДинамики(ТабДок, Фраза);
	КонецЦикла;

	Возврат ТабДок;

КонецФункции

// HTML-доповідь «Динаміка» — лист директору за регламентом knowledge_Письмо Директору:
// звернення, по кожному обʼєкту абзац і таблиця динаміки, перелік подій тижня;
// без оцінок і жаргону; числа у таблицях до копійок, у тексті — тис. грн.
Функция ТекстДинамикиHTML() Экспорт

	Данные = ДанныеДинамики();
	Если Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ДатаБылоСтрока  = Формат(Данные.ДатаБыло, "ДФ=dd.MM.yyyy");
	ДатаСталоСтрока = Формат(ДатаРасчета, "ДФ=dd.MM.yyyy");
	Заголовок = "Фінансовий звіт виробництва — динаміка станом на " + ДатаСталоСтрока;

	Текст = "<!doctype html><html lang=""uk""><head><meta charset=""utf-8"">";
	Текст = Текст + "<title>" + Заголовок + "</title><style>";
	Текст = Текст + "body{font-family:Segoe UI,Arial,sans-serif;font-size:13px;color:#1b1b1b;margin:24px}";
	Текст = Текст + "h1{font-size:18px;margin:0 0 4px}h2{font-size:15px;margin:18px 0 4px}p{margin:6px 0}";
	Текст = Текст + "table{border-collapse:collapse;margin-top:8px;width:100%}";
	Текст = Текст + "th,td{border:1px solid #b5b5b5;padding:5px 7px}";
	Текст = Текст + "th{background:#d2e0f0;text-align:center}";
	Текст = Текст + "td.n{text-align:right;white-space:nowrap}tr.t td{background:#e8e8e8;font-weight:bold}";
	Текст = Текст + "ul{margin:6px 0 6px 18px;padding:0}li{margin:2px 0}";
	Текст = Текст + ".w{color:#8a5a00}</style></head><body>";
	Текст = Текст + "<h1>" + Заголовок + "</h1>";
	Текст = Текст + "<p>Доброго дня,</p>";

	Для Каждого Фраза Из МассивФразДинамики(Данные) Цикл
		Текст = Текст + "<p>" + ЭкранироватьHTML(Фраза) + "</p>";
	КонецЦикла;

	Текст = Текст + "<table><tr><th>Показник</th><th>" + ДатаБылоСтрока + "</th><th>"
		+ ДатаСталоСтрока + "</th><th>Зміна за тиждень</th></tr>";
	Текст = Текст + СтрокаТаблицыHTMLДинамики("Виконано робіт, грн",
		Данные.ИтогоВыполненоБыло, Данные.ИтогоВыполненоСтало);
	Текст = Текст + СтрокаТаблицыHTMLДинамики("Оплачено, грн",
		Данные.ИтогоОплаченоБыло, Данные.ИтогоОплаченоСтало);
	Текст = Текст + СтрокаТаблицыHTMLДинамики("Акти подані, грн",
		Данные.ИтогоАктыБыло, Данные.ИтогоАктыСтало);
	Текст = Текст + СтрокаТаблицыHTMLДинамики("Разом до отримання, грн",
		Данные.ИтогоКБыло, Данные.ИтогоКСтало);
	Текст = Текст + "</table>";

	БезИзменений = "";
	Для Каждого СтрокаПодр Из Данные.Подразделения Цикл

		ОтборПодразделения = Новый Структура("ИмяПодразделения", СтрокаПодр.Имя);
		НовыеСтроки = Данные.Новые.НайтиСтроки(ОтборПодразделения);
		УшедшиеСтроки = Данные.Ушедшие.НайтиСтроки(ОтборПодразделения);

		ЕстьИзменения = НовыеСтроки.Количество() > 0 ИЛИ УшедшиеСтроки.Количество() > 0
			ИЛИ ЕстьЗаметнаяРазница(СтрокаПодр.ВыполненоБыло, СтрокаПодр.ВыполненоСтало)
			ИЛИ ЕстьЗаметнаяРазница(СтрокаПодр.ОплаченоБыло, СтрокаПодр.ОплаченоСтало)
			ИЛИ ЕстьЗаметнаяРазница(СтрокаПодр.АктыБыло, СтрокаПодр.АктыСтало)
			ИЛИ ЕстьЗаметнаяРазница(СтрокаПодр.ИтогоБыло, СтрокаПодр.ИтогоСтало);
		Если НЕ ЕстьИзменения Тогда
			БезИзменений = БезИзменений + ?(ПустаяСтрока(БезИзменений), "", ", ") + СтрокаПодр.Имя;
			Продолжить;
		КонецЕсли;

		Текст = Текст + "<h2>" + ЭкранироватьHTML(СтрокаПодр.Имя) + "</h2>";
		Текст = Текст + "<p>" + ЭкранироватьHTML(АбзацОбъектаДинамики(СтрокаПодр)) + "</p>";

		Текст = Текст + "<table><tr><th>Показник</th><th>" + ДатаБылоСтрока + "</th><th>"
			+ ДатаСталоСтрока + "</th><th>Зміна</th></tr>";
		Текст = Текст + СтрокаТаблицыHTMLДинамики("Виконано робіт, грн",
			СтрокаПодр.ВыполненоБыло, СтрокаПодр.ВыполненоСтало);
		Текст = Текст + СтрокаТаблицыHTMLДинамики("Оплачено, грн",
			СтрокаПодр.ОплаченоБыло, СтрокаПодр.ОплаченоСтало);
		Текст = Текст + СтрокаТаблицыHTMLДинамики("Акти подані, грн",
			СтрокаПодр.АктыБыло, СтрокаПодр.АктыСтало);
		Текст = Текст + СтрокаТаблицыHTMLДинамики("Разом до отримання, грн",
			СтрокаПодр.ИтогоБыло, СтрокаПодр.ИтогоСтало);
		Текст = Текст + "</table>";

		Если НовыеСтроки.Количество() > 0 Тогда
			Текст = Текст + "<p>Події тижня:</p><ul>";
			Для Каждого СтрокаСобытия Из НовыеСтроки Цикл
				Текст = Текст + "<li>" + Формат(СтрокаСобытия.Дата, "ДФ=dd.MM.yyyy") + " — "
					+ ЭкранироватьHTML(СтрокаСобытия.Вид) + " — "
					+ ЭкранироватьHTML(СтрокаСобытия.ИмяДокумента) + " — "
					+ ЧислоДляHTML(СтрокаСобытия.Сумма) + " грн"
					+ ?(СтрокаСобытия.Проведен, "", " <span class=""w"">(не проведено)</span>")
					+ "</li>";
			КонецЦикла;
			Текст = Текст + "</ul>";
		КонецЕсли;

		Если УшедшиеСтроки.Количество() > 0 Тогда
			Текст = Текст + "<p>Зникли з розрахунку:</p><ul>";
			Для Каждого СтрокаСобытия Из УшедшиеСтроки Цикл
				Текст = Текст + "<li class=""w"">" + Формат(СтрокаСобытия.Дата, "ДФ=dd.MM.yyyy")
					+ " — " + ЭкранироватьHTML(СтрокаСобытия.Вид) + " — "
					+ ЭкранироватьHTML(СтрокаСобытия.ИмяДокумента) + " — "
					+ ЧислоДляHTML(СтрокаСобытия.Сумма) + " грн</li>";
			КонецЦикла;
			Текст = Текст + "</ul>";
		КонецЕсли;

	КонецЦикла;

	Если НЕ ПустаяСтрока(БезИзменений) Тогда
		Текст = Текст + "<p>Без змін за тиждень: " + ЭкранироватьHTML(БезИзменений) + ".</p>";
	КонецЕсли;

	Возврат Текст + "</body></html>";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// Замечания и сообщения
////////////////////////////////////////////////////////////////////////////////

Процедура ДобавитьЗамечание(ИмяУровня, Код, Текст, ПодразделениеЗамечания = Неопределено, Путь = "")

	СтрокаКонтроля = Контроль.Добавить();
	Если ИмяУровня = "Ошибка" Тогда
		СтрокаКонтроля.Уровень = "Помилка";
	ИначеЕсли ИмяУровня = "Предупреждение" Тогда
		СтрокаКонтроля.Уровень = "Попередження";
	Иначе
		СтрокаКонтроля.Уровень = "Інформація";
	КонецЕсли;
	СтрокаКонтроля.КодЗамечания = Код;
	СтрокаКонтроля.Текст        = Лев(Текст, 1000);
	СтрокаКонтроля.ПутьКДанным  = Лев(Путь, 200);
	Если ПодразделениеЗамечания <> Неопределено Тогда
		СтрокаКонтроля.Подразделение = ПодразделениеЗамечания;
	КонецЕсли;

КонецПроцедуры

// Дублює зауваження у панель повідомлень із прив'язкою до поля — клік переводить курсор
// у проблемний рядок табличної частини.
Процедура ВывестиЗамечанияПользователю()

	Для Каждого СтрокаКонтроля Из Контроль Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрокаКонтроля.КодЗамечания + ": " + СтрокаКонтроля.Текст;
		Если НЕ ПустаяСтрока(СтрокаКонтроля.ПутьКДанным) Тогда
			Сообщение.Поле = СтрокаКонтроля.ПутьКДанным;
		КонецЕсли;
		Попытка
			Сообщение.УстановитьДанные(ЭтотОбъект);
		Исключение
			// об'єкт ще не записаний — прив'язка недоступна, текст усе одно покажемо
		КонецПопытки;
		Сообщение.Сообщить();
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСчетчикиРезультата(Результат)

	Ошибок = 0;
	Предупреждений = 0;
	Для Каждого СтрокаКонтроля Из Контроль Цикл
		Если СтрокаКонтроля.Уровень = "Помилка" Тогда
			Ошибок = Ошибок + 1;
		ИначеЕсли СтрокаКонтроля.Уровень = "Попередження" Тогда
			Предупреждений = Предупреждений + 1;
		КонецЕсли;
	КонецЦикла;
	Результат.Ошибок = Ошибок;
	Результат.Предупреждений = Предупреждений;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Проверки параметров
////////////////////////////////////////////////////////////////////////////////

Процедура ПроверитьПериодИСчета()

	Если НЕ ЗначениеЗаполнено(ДатаРасчета) Тогда
		ДобавитьЗамечание("Ошибка", "П04", "Не заповнено «Дата розрахунку».",
			Неопределено, "Объект.ДатаРасчета");
	КонецЕсли;

	Если ЗначениеЗаполнено(НачалоПериода) И ЗначениеЗаполнено(ДатаРасчета)
		И НачалоПериода > ДатаРасчета Тогда
		ДобавитьЗамечание("Ошибка", "П05",
			"«Початок періоду» пізніше за «Дата розрахунку».", Неопределено, "Объект.НачалоПериода");
	КонецЕсли;

	Если ЗначениеЗаполнено(ДатаРасчета) И ДатаРасчета > КонецДня(ТекущаяДата()) Тогда
		ДобавитьЗамечание("Предупреждение", "П13",
			"Дата розрахунку у майбутньому — у звіт потраплять не всі документи.",
			Неопределено, "Объект.ДатаРасчета");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Направление) Тогда
		ДобавитьЗамечание("Предупреждение", "П31",
			"Напрямок не заданий — у розрахунок увійдуть договори ВСІХ напрямків "
			+ "(будівництво, логістика тощо).", Неопределено, "Объект.Направление");
	КонецЕсли;

	Если СчетаРасчетов.Количество() = 0 Тогда
		НоваяСтрока = СчетаРасчетов.Добавить();
		НоваяСтрока.Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду("361");
		ДобавитьЗамечание("Предупреждение", "П06",
			"Рахунки розрахунків не задані — підставлено 361.", Неопределено, "Объект.СчетаРасчетов");
	КонецЕсли;

	НомерСтрокиСчета = 0;
	Для Каждого СтрокаСчета Из СчетаРасчетов Цикл
		НомерСтрокиСчета = НомерСтрокиСчета + 1;
		Путь = "Объект.СчетаРасчетов[" + Формат(НомерСтрокиСчета - 1, "ЧГ=0") + "].Счет";
		Если НЕ ЗначениеЗаполнено(СтрокаСчета.Счет) Тогда
			ДобавитьЗамечание("Ошибка", "П08",
				"Рахунки розрахунків, рядок " + НомерСтрокиСчета + ": рахунок не заповнено.",
				Неопределено, Путь);
			Продолжить;
		КонецЕсли;
		ВидыСубконтоСчета = СтрокаСчета.Счет.ВидыСубконто;
		Если ВидыСубконтоСчета.Количество() < 2
			ИЛИ Найти(ВидыСубконтоСчета[1].ВидСубконто.Наименование, "огов") = 0 Тогда
			ДобавитьЗамечание("Ошибка", "П07",
				"Рахунок " + СтрокаСчета.Счет.Код + ": друге субконто не «Договори». "
				+ "Розріз за підрозділом договору неможливий.", Неопределено, Путь);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Повертає: Соответствие — ключ підрозділ, значення рядок ТЧ (тільки увімкнені й коректні).
Функция ПроверитьПодразделения()

	Набор = Новый Соответствие;

	Если ВключенныеПодразделения().Количество() = 0 Тогда
		ДобавитьЗамечание("Ошибка", "П01",
			"Не вибрано жодного підрозділу: таблична частина порожня або всі рядки вимкнені.",
			Неопределено, "Объект.Подразделения");
	КонецЕсли;

	УжеВидели = Новый Соответствие;
	НомерСтроки = 0;
	Для Каждого СтрокаПодр Из Подразделения Цикл

		НомерСтроки = НомерСтроки + 1;
		Индекс = Формат(НомерСтроки - 1, "ЧГ=0");
		Путь = "Объект.Подразделения[" + Индекс + "].Подразделение";

		Если НЕ ЗначениеЗаполнено(СтрокаПодр.Подразделение) Тогда
			ДобавитьЗамечание("Ошибка", "П03",
				"Підрозділи, рядок " + НомерСтроки + ": підрозділ не заповнено.", Неопределено, Путь);
			Продолжить;
		КонецЕсли;

		ПредыдущийНомер = УжеВидели.Получить(СтрокаПодр.Подразделение);
		Если ПредыдущийНомер <> Неопределено Тогда
			ДобавитьЗамечание("Ошибка", "П02",
				"Підрозділ «" + СтрокаПодр.Подразделение + "» вказано двічі (рядки "
				+ ПредыдущийНомер + " та " + НомерСтроки + ").", СтрокаПодр.Подразделение, Путь);
		Иначе
			УжеВидели.Вставить(СтрокаПодр.Подразделение, НомерСтроки);
		КонецЕсли;

		Если СтрокаПодр.Подразделение.ПометкаУдаления Тогда
			ДобавитьЗамечание("Предупреждение", "П12",
				"Підрозділи, рядок " + НомерСтроки + ": «" + СтрокаПодр.Подразделение
				+ "» позначено на видалення.", СтрокаПодр.Подразделение, Путь);
		КонецЕсли;

		Если НЕ СтрокаПодр.Включать Тогда
			Продолжить;
		КонецЕсли;

		Набор.Вставить(СтрокаПодр.Подразделение, СтрокаПодр);

	КонецЦикла;

	Возврат Набор;

КонецФункции

Процедура ПроверитьДополнительныеДоговоры(НаборПодразделений)

	УжеВидели = Новый Соответствие;
	КУдалению = Новый Массив;
	НомерСтроки = 0;

	Для Каждого СтрокаДог Из ДоговорыДополнительно Цикл

		НомерСтроки = НомерСтроки + 1;
		Индекс = Формат(НомерСтроки - 1, "ЧГ=0");
		Путь = "Объект.ДоговорыДополнительно[" + Индекс + "].Договор";

		Если НЕ ЗначениеЗаполнено(СтрокаДог.Договор) Тогда
			ДобавитьЗамечание("Ошибка", "П21",
				"Договори додатково, рядок " + НомерСтроки + ": договір не заповнено.",
				Неопределено, Путь);
			Продолжить;
		КонецЕсли;

		Если УжеВидели.Получить(СтрокаДог.Договор) <> Неопределено Тогда
			ДобавитьЗамечание("Предупреждение", "П17",
				"Договори додатково, рядок " + НомерСтроки + ": договір «" + СтрокаДог.Договор
				+ "» вказано двічі — рядок проігноровано.", Неопределено, Путь);
			КУдалению.Добавить(СтрокаДог);
			Продолжить;
		КонецЕсли;
		УжеВидели.Вставить(СтрокаДог.Договор, НомерСтроки);

		// Подвійний рахунок: договір і так увійде за власним підрозділом.
		// ВИНЯТОК (16.08.2026): якщо ручне призначення ЗБІГАЄТЬСЯ з власним підрозділом,
		// рядок залишаємо — так у звіт потрапляють договори БЕЗ оборотів (порожній рядок
		// із сумами угод C/D з регістру параметрів). Подвійного рахунку при цьому немає:
		// акумулятор договору один, ціль та сама.
		СобственноеПодразделение = СтрокаДог.Договор.Подразделение;
		Если ЗначениеЗаполнено(СобственноеПодразделение)
			И НаборПодразделений.Получить(СобственноеПодразделение) <> Неопределено
			И СтрокаДог.Подразделение <> СобственноеПодразделение Тогда
			ДобавитьЗамечание("Предупреждение", "П15",
				"Договори додатково, рядок " + НомерСтроки + ": договір «" + СтрокаДог.Договор
				+ "» уже входить у розрахунок за власним підрозділом «" + СобственноеПодразделение
				+ "» — рядок проігноровано (подвійний рахунок).", СобственноеПодразделение, Путь);
			КУдалению.Добавить(СтрокаДог);
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(СтрокаДог.Подразделение)
			ИЛИ НаборПодразделений.Получить(СтрокаДог.Подразделение) = Неопределено Тогда
			ДобавитьЗамечание("Ошибка", "П16",
				"Договори додатково, рядок " + НомерСтроки + ": підрозділ «" + СтрокаДог.Подразделение
				+ "» відсутній серед увімкнених рядків табличної частини «Підрозділи».",
				Неопределено, "Объект.ДоговорыДополнительно[" + Индекс + "].Подразделение");
		КонецЕсли;

	КонецЦикла;

	Для Каждого УдаляемаяСтрока Из КУдалению Цикл
		ДоговорыДополнительно.Удалить(УдаляемаяСтрока);
	КонецЦикла;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Наборы параметров
////////////////////////////////////////////////////////////////////////////////

Функция ВключенныеПодразделения()

	Отбор = Новый Структура("Включать", Истина);
	Возврат Подразделения.НайтиСтроки(Отбор);

КонецФункции

Функция НаборВключенныхПодразделений()

	Набор = Новый Соответствие;
	Для Каждого СтрокаПодр Из ВключенныеПодразделения() Цикл
		Если ЗначениеЗаполнено(СтрокаПодр.Подразделение) Тогда
			Набор.Вставить(СтрокаПодр.Подразделение, СтрокаПодр);
		КонецЕсли;
	КонецЦикла;
	Возврат Набор;

КонецФункции

Функция МассивВключенныхПодразделений()

	МассивПодр = Новый Массив;
	Для Каждого СтрокаПодр Из ВключенныеПодразделения() Цикл
		Если ЗначениеЗаполнено(СтрокаПодр.Подразделение) Тогда
			МассивПодр.Добавить(СтрокаПодр.Подразделение);
		КонецЕсли;
	КонецЦикла;
	// УВАГА: порожній масив у «В (&Параметр)» — коректно (нічого не відбирає).
	// Додавати ПустаяСсылка() як заглушку НЕ МОЖНА: вона зловить рядки з незаповненим
	// підрозділом/договором і завищить суми.
	Возврат МассивПодр;

КонецФункции

Функция МассивДопДоговоров()

	МассивДог = Новый Массив;
	Для Каждого СтрокаДог Из ДоговорыДополнительно Цикл
		Если ЗначениеЗаполнено(СтрокаДог.Договор) Тогда
			МассивДог.Добавить(СтрокаДог.Договор);
		КонецЕсли;
	КонецЦикла;
	// Порожній масив — нормальний випадок (жодного ручного договору). Заглушку не додаємо.
	Возврат МассивДог;

КонецФункции

Функция КартаДопДоговоров()

	Карта = Новый Соответствие;
	Для Каждого СтрокаДог Из ДоговорыДополнительно Цикл
		Если ЗначениеЗаполнено(СтрокаДог.Договор) И ЗначениеЗаполнено(СтрокаДог.Подразделение) Тогда
			Карта.Вставить(СтрокаДог.Договор, СтрокаДог.Подразделение);
		КонецЕсли;
	КонецЦикла;
	Возврат Карта;

КонецФункции

// До якого рядка звіту віднести договір: спершу ручне призначення, потім власний підрозділ.
Функция ЦелевоеПодразделение(Договор, ПодразделениеДоговора, КартаДоп, НаборПодр)

	Если ЗначениеЗаполнено(Договор) Тогда
		РучноеНазначение = КартаДоп.Получить(Договор);
		Если РучноеНазначение <> Неопределено Тогда
			Возврат РучноеНазначение;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПодразделениеДоговора)
		И НаборПодр.Получить(ПодразделениеДоговора) <> Неопределено Тогда
		Возврат ПодразделениеДоговора;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Акумулятор оборотів ОДНОГО договору всередині підрозділу: створює за потреби.
// Контрагент запам'ятовується при першому зверненні (у договору він один — власник).
Функция АккумуляторДоговора(КартаДоговоров, Договор, Контрагент)

	Акк = КартаДоговоров.Получить(Договор);
	Если Акк = Неопределено Тогда
		Акк = Новый Структура(
			"Контрагент, ВыполненныеРаботы, Оплачено, АктыПроведенные, АктыНепроведенные",
			Контрагент, 0, 0, 0, 0);
		КартаДоговоров.Вставить(Договор, Акк);
	КонецЕсли;
	Возврат Акк;

КонецФункции

// Фінансовий звіт «станом на дату» = на КІНЕЦЬ дня. Це не косметика:
// віртуальна таблиця Остатки бере залишок ПЕРЕД моментом, а Обороты — включно з ним,
// тому на 00:00:00 сальдо і оборот розходяться (перевірено на договорі ОРІЛЬ:
// на 07.08 00:00:00 сальдо 391 440,55 при нульовому обороті, на 23:59:59 — нуль і нуль).
// Користувач вводить дату, час нас не цікавить — приводимо самі.
Функция МоментРасчета()

	Если НЕ ЗначениеЗаполнено(ДатаРасчета) Тогда
		Возврат ДатаРасчета;
	КонецЕсли;
	Возврат КонецДня(ДатаРасчета);

КонецФункции

Функция НачалоРасчетногоПериода()

	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		Возврат НачалоПериода;
	КонецЕсли;
	Возврат '00010101';

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Запросы
////////////////////////////////////////////////////////////////////////////////

Функция МассивСчетов()

	МассивСчетов = Новый Массив;
	Для Каждого СтрокаСчета Из СчетаРасчетов Цикл
		Если ЗначениеЗаполнено(СтрокаСчета.Счет) Тогда
			МассивСчетов.Добавить(СтрокаСчета.Счет);
		КонецЕсли;
	КонецЦикла;
	Если МассивСчетов.Количество() = 0 Тогда
		МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("361"));
	КонецЕсли;
	Возврат МассивСчетов;

КонецФункции

// Напрямок живе на ДОГОВОРІ (Справочник.ДоговорыКонтрагентов.Направление), не на підрозділі.
// Один підрозділ (напр. «Главный офис») може мати договори різних напрямків — без цього
// фільтра у звіт «Виробництво» потрапили б чужі обороти.
Процедура УстановитьПараметрыНаправления(Запрос)

	Запрос.УстановитьПараметр("Направление", Направление);
	Запрос.УстановитьПараметр("БезФильтраНаправления", НЕ ЗначениеЗаполнено(Направление));

КонецПроцедуры

Функция ЗапросОборотов(МассивПодр, МассивДог)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Об.Регистратор КАК Регистратор,
	|	Об.Регистратор.Дата КАК ДатаДокумента,
	|	Об.Субконто1 КАК Контрагент,
	|	Об.Субконто2 КАК Договор,
	|	ВЫРАЗИТЬ(Об.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Подразделение КАК Подразделение,
	|	ЕСТЬNULL(ОПД.ДокументыПолучены, ЛОЖЬ) КАК Оригинал,
	|	СУММА(Об.СуммаОборотДт) КАК ОборотДт,
	|	СУММА(Об.СуммаОборотКт) КАК ОборотКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПериода, &ДатаРасчета, Регистратор,
	|		Счет В (&Счета), , , , ) КАК Об
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтправкаПолучениеДокументов КАК ОПД
	|		ПО ОПД.Документ = Об.Регистратор
	|ГДЕ
	|	(ВЫРАЗИТЬ(Об.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Подразделение В (&Подразделения)
	|		ИЛИ Об.Субконто2 В (&Договоры))
	|	И (&БезФильтраНаправления
	|		ИЛИ ВЫРАЗИТЬ(Об.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Направление = &Направление)
	|
	|СГРУППИРОВАТЬ ПО
	|	Об.Регистратор,
	|	Об.Регистратор.Дата,
	|	Об.Субконто1,
	|	Об.Субконто2,
	|	ВЫРАЗИТЬ(Об.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Подразделение,
	|	ЕСТЬNULL(ОПД.ДокументыПолучены, ЛОЖЬ)";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоРасчетногоПериода());
	Запрос.УстановитьПараметр("ДатаРасчета", МоментРасчета());
	Запрос.УстановитьПараметр("Счета", МассивСчетов());
	Запрос.УстановитьПараметр("Подразделения", МассивПодр);
	Запрос.УстановитьПараметр("Договоры", МассивДог);
	УстановитьПараметрыНаправления(Запрос);

	Возврат Запрос.Выполнить();

КонецФункции

Функция ЗапросСальдо(МассивПодр, МассивДог)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Подразделение КАК Подразделение,
	|	Ост.Субконто2 КАК Договор,
	|	СУММА(ЕСТЬNULL(Ост.СуммаОстатокДт, 0) - ЕСТЬNULL(Ост.СуммаОстатокКт, 0)) КАК Сальдо
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&ДатаРасчета, Счет В (&Счета), , ) КАК Ост
	|ГДЕ
	|	(ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Подразделение В (&Подразделения)
	|		ИЛИ Ост.Субконто2 В (&Договоры))
	|	И (&БезФильтраНаправления
	|		ИЛИ ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Направление = &Направление)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Подразделение,
	|	Ост.Субконто2";

	Запрос.УстановитьПараметр("ДатаРасчета", МоментРасчета());
	Запрос.УстановитьПараметр("Счета", МассивСчетов());
	Запрос.УстановитьПараметр("Подразделения", МассивПодр);
	Запрос.УстановитьПараметр("Договоры", МассивДог);
	УстановитьПараметрыНаправления(Запрос);

	Возврат Запрос.Выполнить();

КонецФункции

// Обороти рахунків розрахунків, що НЕ потрапили у розрахунок (інверсія WHERE основного
// запиту): підрозділ договору не входить у ТЧ або не заповнений. Живлять контроль К03 —
// основний запит такі рядки відсікає, і без цього запиту вони випадали б мовчки.
// Відсортовано за спаданням обороту Дт — перші рядки і є «найбільші» для тексту К03.
Функция ЗапросНеотнесенныхОборотов(МассивПодр, МассивДог)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Об.Субконто2 КАК Договор,
	|	СУММА(Об.СуммаОборотДт) КАК ОборотДт,
	|	СУММА(Об.СуммаОборотКт) КАК ОборотКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПериода, &ДатаРасчета, ,
	|		Счет В (&Счета), , , , ) КАК Об
	|ГДЕ
	|	НЕ (ВЫРАЗИТЬ(Об.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Подразделение В (&Подразделения)
	|		ИЛИ Об.Субконто2 В (&Договоры))
	|	И (&БезФильтраНаправления
	|		ИЛИ ВЫРАЗИТЬ(Об.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Направление = &Направление)
	|
	|СГРУППИРОВАТЬ ПО
	|	Об.Субконто2
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОборотДт УБЫВ";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоРасчетногоПериода());
	Запрос.УстановитьПараметр("ДатаРасчета", МоментРасчета());
	Запрос.УстановитьПараметр("Счета", МассивСчетов());
	Запрос.УстановитьПараметр("Подразделения", МассивПодр);
	Запрос.УстановитьПараметр("Договоры", МассивДог);
	УстановитьПараметрыНаправления(Запрос);

	Возврат Запрос.Выполнить();

КонецФункции

// Непроведені документи реалізації — друга гілка колонки «Акти подані».
Функция ЗапросНепроведенных(МассивПодр, МассивДог)

	ВидыДокументов = Новый Массив;
	ВидыДокументов.Добавить("РеализацияТоваровУслуг");
	ВидыДокументов.Добавить("РеализацияУслугПоПереработке");
	ВидыДокументов.Добавить("АктОбОказанииПроизводственныхУслуг");
	ВидыДокументов.Добавить("ИмпРеализацияСтроительныхРаботУслуг");

	ШаблонЧасти =
	"ВЫБРАТЬ
	|	Р.Ссылка КАК Документ,
	|	Р.Дата КАК Дата,
	|	Р.Контрагент КАК Контрагент,
	|	Р.ДоговорКонтрагента КАК Договор,
	|	Р.ДоговорКонтрагента.Подразделение КАК Подразделение,
	|	Р.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.#ВидДокумента# КАК Р
	|ГДЕ
	|	НЕ Р.Проведен
	|	И НЕ Р.ПометкаУдаления
	|	И Р.Дата <= &ДатаРасчета
	|	И (Р.ДоговорКонтрагента.Подразделение В (&Подразделения)
	|		ИЛИ Р.ДоговорКонтрагента В (&Договоры))
	|	И (&БезФильтраНаправления ИЛИ Р.ДоговорКонтрагента.Направление = &Направление)";

	ТекстЗапроса = "";
	Для Каждого ВидДокумента Из ВидыДокументов Цикл
		Если НЕ ПустаяСтрока(ТекстЗапроса) Тогда
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС + Символы.ПС;
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + СтрЗаменить(ШаблонЧасти, "#ВидДокумента#", ВидДокумента);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаРасчета", МоментРасчета());
	Запрос.УстановитьПараметр("Подразделения", МассивПодр);
	Запрос.УстановитьПараметр("Договоры", МассивДог);
	УстановитьПараметрыНаправления(Запрос);

	Возврат Запрос.Выполнить();

КонецФункции

