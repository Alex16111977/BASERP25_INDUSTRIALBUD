// Непроведені документи реалізації — друга гілка колонки «Акти подані».
Функция ЗапросНепроведенных(МассивПодр, МассивДог)

	ВидыДокументов = Новый Массив;
	ВидыДокументов.Добавить("РеализацияТоваровУслуг");
	ВидыДокументов.Добавить("РеализацияУслугПоПереработке");
	ВидыДокументов.Добавить("АктОбОказанииПроизводственныхУслуг");
	ВидыДокументов.Добавить("ИмпРеализацияСтроительныхРаботУслуг");

	ШаблонЧасти =
	"ВЫБРАТЬ
	|	Р.Ссылка КАК Документ,
	|	Р.Дата КАК Дата,
	|	Р.Контрагент КАК Контрагент,
	|	Р.ДоговорКонтрагента КАК Договор,
	|	Р.ДоговорКонтрагента.Подразделение КАК Подразделение,
	|	Р.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.#ВидДокумента# КАК Р
	|ГДЕ
	|	НЕ Р.Проведен
	|	И НЕ Р.ПометкаУдаления
	|	И Р.Дата <= &ДатаРасчета
	|	И (Р.ДоговорКонтрагента.Подразделение В (&Подразделения)
	|		ИЛИ Р.ДоговорКонтрагента В (&Договоры))
	|	И (&БезФильтраНаправления ИЛИ Р.ДоговорКонтрагента.Направление = &Направление)";

	ТекстЗапроса = "";
	Для Каждого ВидДокумента Из ВидыДокументов Цикл
		Если НЕ ПустаяСтрока(ТекстЗапроса) Тогда
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС + Символы.ПС;
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + СтрЗаменить(ШаблонЧасти, "#ВидДокумента#", ВидДокумента);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаРасчета", МоментРасчета());
	Запрос.УстановитьПараметр("Подразделения", МассивПодр);
	Запрос.УстановитьПараметр("Договоры", МассивДог);
	УстановитьПараметрыНаправления(Запрос);

	Возврат Запрос.Выполнить();

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Заполнение результата
////////////////////////////////////////////////////////////////////////////////

// Договори зі статусом «Закрыт» (регістр параметрів, СтатусВОтчете) виключаються ще до кроку 0:
// рядки видаляються з таблиць оборотів і непроведених; сальдо і договори «Всегда» їх пропускають.
// К24 (Інформація) — які договори сховано і з якими сумами E/F/H; К25 (Попередження) — закрито, але є борг/акти. Повертає Соответствие Договір -> суми.
Функция ИсключитьСкрытыеДоговоры(ТаблицаОборотов, ТаблицаНепроведенных)

	Скрытые = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Договор КАК Договор
	|ИЗ
	|	РегистрСведений.А_ПараметрыДоговоровФинотчета КАК П
	|ГДЕ
	|	П.СтатусВОтчете = ""Закрыт""";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Скрытые.Вставить(Выборка.Договор, Новый Структура("E, F, H", 0, 0, 0));
	КонецЦикла;
	Если Скрытые.Количество() = 0 Тогда
		Возврат Скрытые;
	КонецЕсли;

	Индекс = ТаблицаОборотов.Количество();
	Пока Индекс > 0 Цикл
		Индекс = Индекс - 1;
		СтрокаТаблицы = ТаблицаОборотов[Индекс];
		Суммы = Скрытые.Получить(СтрокаТаблицы.Договор);
		Если Суммы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаТаблицы.Оригинал Тогда
			Суммы.E = Суммы.E + СтрокаТаблицы.ОборотДт;
		Иначе
			Суммы.H = Суммы.H + СтрокаТаблицы.ОборотДт;
		КонецЕсли;
		Суммы.F = Суммы.F + СтрокаТаблицы.ОборотКт;
		ТаблицаОборотов.Удалить(СтрокаТаблицы);
	КонецЦикла;

	Индекс = ТаблицаНепроведенных.Количество();
	Пока Индекс > 0 Цикл
		Индекс = Индекс - 1;
		СтрокаТаблицы = ТаблицаНепроведенных[Индекс];
		Суммы = Скрытые.Получить(СтрокаТаблицы.Договор);
		Если Суммы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ВключатьНепроведенные Тогда
			Суммы.H = Суммы.H + СтрокаТаблицы.Сумма;
		КонецЕсли;
		ТаблицаНепроведенных.Удалить(СтрокаТаблицы);
	КонецЦикла;

	Для Каждого Элемент Из Скрытые Цикл
		Суммы = Элемент.Значение;
		Если Суммы.E <> 0 ИЛИ Суммы.F <> 0 ИЛИ Суммы.H <> 0 Тогда
			// закритий договір врегульовано, якщо всі акти (з «Оригінал» і без) покриті оплатами
			Долг = Суммы.E + Суммы.H - Суммы.F;
			ЕстьДолг = Долг >= 1 ИЛИ Долг <= -1;
			ДобавитьЗамечание(?(ЕстьДолг, "Предупреждение", "Информация"), ?(ЕстьДолг, "К25", "К24"), "«" + Строка(Элемент.Ключ)
				+ ?(ЕстьДолг, "» має статус «Закрыт», але E + H − F ≠ 0 — перевірте: E ",
					"» закрито (статус «Закрыт») — не показується у звіті: E ") + Формат(Суммы.E, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00")
				+ ", F " + Формат(Суммы.F, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00")
				+ ", H " + Формат(Суммы.H, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + ".", , "Объект.Расчет");
		КонецЕсли;
	КонецЦикла;
	Возврат Скрытые;

КонецФункции

Процедура ДобавитьСтрокуРасшифровки(Цель, ВыборкаОборотов, ПодразделенияОплат)

	СтрокаРасш = РасшифровкаДокументов.Добавить();
	СтрокаРасш.Подразделение    = Цель;
	СтрокаРасш.Контрагент       = ВыборкаОборотов.Контрагент;
	СтрокаРасш.Договор          = ВыборкаОборотов.Договор;
	СтрокаРасш.Документ         = ВыборкаОборотов.Регистратор;
	СтрокаРасш.ДатаДокумента    = ВыборкаОборотов.ДатаДокумента;
	СтрокаРасш.ДокументПроведен = Истина;
	СтрокаРасш.Оригинал         = ВыборкаОборотов.Оригинал;
	СтрокаРасш.ДатаПодписания   = ВыборкаОборотов.ДатаПодписания;
	СтрокаРасш.СуммаДт          = ВыборкаОборотов.ОборотДт;
	СтрокаРасш.СуммаКт          = ВыборкаОборотов.ОборотКт;

	Если ВыборкаОборотов.ОборотДт = 0 И ВыборкаОборотов.ОборотКт > 0 Тогда
		СтрокаРасш.Вид = "Оплата";
	ИначеЕсли ВыборкаОборотов.Оригинал Тогда
		СтрокаРасш.Вид = "Виконані роботи";
	Иначе
		СтрокаРасш.Вид = "Акт поданий";
	КонецЕсли;

	Если СтрокаРасш.Вид = "Оплата" Тогда
		ТекстКазны = ПодразделенияОплат.Получить(КлючОплаты(ВыборкаОборотов.Регистратор, ВыборкаОборотов.Договор));
		Если ТекстКазны <> Неопределено Тогда
			СтрокаРасш.ПодразделениеКазны = ТекстКазны;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Параметри розрахунку договорів, що потрапили у вибірки: одним запитом по всіх.
// Джерело — РегистрСведений.А_ПараметрыДоговоровФинотчета (з 14.08.2026 параметри живуть
// у регістрі, а не в реквізитах довідника). Договір без запису рахується за замовчуванням.
// Повертає: Соответствие — Договір -> Структура (СуммаСоглашения, СуммаДЦ, Примечание,
// ПроцентУдержания, ВариантФормулы).
Функция ПараметрыДоговоров(Итоги)

	МассивДоговоров = Новый Массив;
	Для Каждого ЭлементПодразделения Из Итоги Цикл
		Для Каждого ЭлементДоговора Из ЭлементПодразделения.Значение Цикл
			МассивДоговоров.Добавить(ЭлементДоговора.Ключ);
		КонецЦикла;
	КонецЦикла;

	Карта = Новый Соответствие;
	Если МассивДоговоров.Количество() = 0 Тогда
		Возврат Карта;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Договор КАК Договор,
	|	П.СуммаСоглашения КАК СуммаСоглашения,
	|	П.СуммаДЦ КАК СуммаДЦ,
	|	П.ОбъектПримечание КАК Примечание,
	|	П.ПроцентГарантийногоУдержания КАК ПроцентУдержания,
	|	П.ВариантФормулыИтога КАК ВариантФормулы,
	|	П.СуммаПредоплаты КАК СуммаПредоплаты,
	|	П.ДатаЗачетаПредоплаты КАК ДатаЗачетаПредоплаты,
	|	П.ОстатокПредоплатыНаДату КАК ОстатокПредоплатыНаДату,
	|	П.ПравилоНДС КАК ПравилоНДС,
	|	П.СуммаГарантийногоУдержания КАК СуммаГарантийногоУдержания,
	|	П.СрокОплатыДней КАК СрокОплатыДней,
	|	П.БазаСрокаОплаты КАК БазаСрокаОплаты,
	|	П.СтатусВОтчете КАК СтатусВОтчете,
	|	П.УсловияДоговора КАК УсловияДоговора
	|ИЗ
	|	РегистрСведений.А_ПараметрыДоговоровФинотчета КАК П
	|ГДЕ
	|	П.Договор В (&Договоры)";
	Запрос.УстановитьПараметр("Договоры", МассивДоговоров);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПараметрыДог = НовыеПараметрыДоговора();
		ЗаполнитьЗначенияСвойств(ПараметрыДог, Выборка);
		ПараметрыДог.ЕстьЗапись = Истина;
		Карта.Вставить(Выборка.Договор, ПараметрыДог);
	КонецЦикла;

	Возврат Карта;

КонецФункции

Функция ПараметрыДоговора(КартаПараметров, Договор)

	ПараметрыДог = КартаПараметров.Получить(Договор);
	Если ПараметрыДог = Неопределено Тогда
		ПараметрыДог = НовыеПараметрыДоговора();
	КонецЕсли;
	Возврат ПараметрыДог;

КонецФункции

// Параметри договору за замовчуванням (запису в регістрі немає): Z(0), ПДВ від актів.
Функция НовыеПараметрыДоговора()

	Возврат Новый Структура("СуммаСоглашения, СуммаДЦ, Примечание, ПроцентУдержания, ВариантФормулы, СуммаПредоплаты, ДатаЗачетаПредоплаты, ОстатокПредоплатыНаДату, ПравилоНДС, СуммаГарантийногоУдержания, СрокОплатыДней, БазаСрокаОплаты, СтатусВОтчете, УсловияДоговора, ЕстьЗапись",
		0, 0, "", 0, "", 0, '00010101', 0, "", 0, 0, "", "", "", Ложь);

КонецФункции

// Рядок результату = ДОГОВІР (як в Excel: сума угоди, примітка і K стоять на рядку договору
// і СУМУЮТЬСЯ вгору — до контрагента й підрозділу, а не перераховуються за згорнутими цифрами).
// Порядок рядків: за порядком ТЧ «Підрозділи», всередині — за контрагентом і договором.
// Сальдо361 пишеться у ПЕРШИЙ рядок підрозділу (для ока), контролі беруть його агрегатом.
// Підрозділ без руху дає один нульовий рядок з порожнім договором — для контролю К02.
Процедура ЗаполнитьСтрокиРасчета(Итоги, СальдоПоПодразделениям)

	КартаПараметров = ПараметрыДоговоров(Итоги);

	Для Каждого СтрокаПодр Из ВключенныеПодразделения() Цикл

		Если НЕ ЗначениеЗаполнено(СтрокаПодр.Подразделение) Тогда
			Продолжить;
		КонецЕсли;

		КартаДоговоров = Итоги.Получить(СтрокаПодр.Подразделение);
		Если КартаДоговоров = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Сальдо = СальдоПоПодразделениям.Получить(СтрокаПодр.Подразделение);
		Если Сальдо = Неопределено Тогда
			Сальдо = 0;
		КонецЕсли;

		Если КартаДоговоров.Количество() = 0 Тогда
			СтрокаРезультата = Расчет.Добавить();
			СтрокаРезультата.Подразделение = СтрокаПодр.Подразделение;
			СтрокаРезультата.Сальдо361 = Окр(Сальдо, 2);
			Продолжить;
		КонецЕсли;

		СтрокиДоговоров = НовыйНаборСтрокДоговоров();
		Отрицательные = Новый Структура("Количество, Сумма, Договоры", 0, 0, "");
		АвтоСкрытые = Новый Структура("Количество, Выполнено, Оплачено, Договоры", 0, 0, 0, "");
		Для Каждого ЭлементДоговора Из КартаДоговоров Цикл
			ДобавитьСтрокуДоговора(СтрокиДоговоров, ЭлементДоговора.Ключ,
				ЭлементДоговора.Значение, КартаПараметров, СтрокаПодр.Подразделение, Отрицательные, АвтоСкрытые);
		КонецЦикла;
		Если Отрицательные.Количество > 0 Тогда
			ДобавитьЗамечание("Информация", "К19",
				Строка(СтрокаПодр.Подразделение) + ": у " + Отрицательные.Количество + " договор(ах) «Разом до отримання» "
				+ "за формулою від'ємне (разом " + Формат(Отрицательные.Сумма, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00")
				+ ") — показано 0 (аванс не відпрацьовано або переплата): " + Отрицательные.Договоры
				+ ?(Отрицательные.Количество > 3, "; …", "") + ".",
				СтрокаПодр.Подразделение, "Объект.Расчет");
		КонецЕсли;
		Если АвтоСкрытые.Количество > 0 Тогда
			ДобавитьЗамечание("Информация", "К26", Строка(СтрокаПодр.Подразделение) + ": не показано "
				+ АвтоСкрытые.Количество + " договор(ів) без боргу, актів, авансу і руху в місяці розрахунку (E "
				+ Формат(АвтоСкрытые.Выполнено, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + ", F "
				+ Формат(АвтоСкрытые.Оплачено, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + "): " + АвтоСкрытые.Договоры
				+ ?(АвтоСкрытые.Количество > 3, "; …", "") + ". Показати завжди — статус «Всегда» у параметрах договору.",
				СтрокаПодр.Подразделение, "Объект.Расчет");
		КонецЕсли;
		Если СтрокиДоговоров.Количество() = 0 Тогда
			// усі договори закриті — підрозділ лишається у звіті нульовим рядком (план-факт казни, К02)
			СтрокаРезультата = Расчет.Добавить();
			СтрокаРезультата.Подразделение = СтрокаПодр.Подразделение;
			СтрокаРезультата.Сальдо361 = Окр(Сальдо, 2);
			Продолжить;
		КонецЕсли;
		СтрокиДоговоров.Сортировать("ИмяКонтрагента, ИмяДоговора");

		ПерваяСтрока = Истина;
		Для Каждого СтрокаДоговора Из СтрокиДоговоров Цикл
			СтрокаРезультата = Расчет.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРезультата, СтрокаДоговора);
			СтрокаРезультата.Подразделение = СтрокаПодр.Подразделение;
			Если ПерваяСтрока Тогда
				СтрокаРезультата.Сальдо361 = Окр(Сальдо, 2);
				ПерваяСтрока = Ложь;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Тимчасова таблиця рядків договорів одного підрозділу — щоб відсортувати за поданням
// контрагента й договору до переносу в ТЧ (сортування Соответствия недетерміноване).
Функция НовыйНаборСтрокДоговоров()

	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("ИмяКонтрагента", Новый ОписаниеТипов("Строка"));
	Строки.Колонки.Добавить("ИмяДоговора", Новый ОписаниеТипов("Строка"));
	Строки.Колонки.Добавить("Контрагент");
	Строки.Колонки.Добавить("Договор");
	Строки.Колонки.Добавить("Примечание");
	Строки.Колонки.Добавить("СуммаСоглашения");
	Строки.Колонки.Добавить("СуммаДЦ");
	Строки.Колонки.Добавить("ВыполненныеРаботыРасч");
	Строки.Колонки.Добавить("ОплаченоРасч");
	Строки.Колонки.Добавить("АктыПоданныеРасч");
	Строки.Колонки.Добавить("ВыполненныеРаботы");
	Строки.Колонки.Добавить("Оплачено");
	Строки.Колонки.Добавить("Задолженность");
	Строки.Колонки.Добавить("АктыПоданные");
	Строки.Колонки.Добавить("АктыПоданныеПроведенные");
	Строки.Колонки.Добавить("АктыПоданныеНепроведенные");
	Строки.Колонки.Добавить("ГарантийныеПлатежи");
	Строки.Колонки.Добавить("НДСНезарегистрированный");
	Строки.Колонки.Добавить("ИтогоКПолучению");
	Строки.Колонки.Добавить("ВариантФормулы");
	Строки.Колонки.Добавить("ОстатокАванса");
	Возврат Строки;

КонецФункции

Процедура ДобавитьСтрокуДоговора(СтрокиДоговоров, Договор, Акк, КартаПараметров, ПодразделениеСтроки, Отрицательные, АвтоСкрытые)

	ПараметрыДог = ПараметрыДоговора(КартаПараметров, Договор);
	Вариант = ВариантФормулыДоговора(ПараметрыДог, Договор, ПодразделениеСтроки);
	Доля = ПараметрыДог.ПроцентУдержания / 100;

	Выполнено  = Окр(Акк.ВыполненныеРаботы, 2);
	Оплачено   = Окр(Акк.Оплачено, 2);
	АктыПров   = Окр(Акк.АктыПроведенные, 2);
	АктыНепров = Окр(Акк.АктыНепроведенные, 2);
	Акты       = Окр(АктыПров + АктыНепров, 2);
	Задолженность = Окр(Выполнено - Оплачено, 2);

	ОстатокАванса = 0;
	Если Вариант = "ЗачетПредоплаты" Тогда
		ОстатокАванса = ОстатокПредоплаты(ПараметрыДог, Договор, Выполнено, ПодразделениеСтроки);
	КонецЕсли;
	// частина поданих актів, покрита авансом (лише для заліку передоплати): ПДВ з неї вже нараховано
	// з авансу. Для Z/V база ПДВ = H як і раніше (навіть при H < 0 — сторно).
	ПокрытоАвансом = ?(Вариант = "ЗачетПредоплаты", Мин(ОстатокАванса, Акты * Доля), 0);

	НДС = НДСПоПравилу(ПараметрыДог, Договор, ПодразделениеСтроки, Задолженность, Акты - ПокрытоАвансом);
	Удержание = ГарантийноеУдержание(ПараметрыДог, Договор, ПодразделениеСтроки, Задолженность, Акты);

	ИтогРасчетный = ИтогоПоФормулеДоговора(Вариант, Доля, Выполнено, Оплачено, Задолженность, Акты,
		НДС, Удержание, ОстатокАванса);
	Итог = Окр(Макс(0, ИтогРасчетный), 2);

	// Статус у регістрі: «Всегда» — завжди у звіті; порожній (авто) — лише активний договір (борг, подані акти,
	// незачтений аванс, рух у місяці розрахунку). Інакше — не показується (К26).
	Если СокрЛП(ПараметрыДог.СтатусВОтчете) <> "Всегда"
		И НЕ ДоговорАктивенВОтчете(Договор, Задолженность, Акты, ОстатокАванса) Тогда
		АвтоСкрытые.Количество = АвтоСкрытые.Количество + 1;
		АвтоСкрытые.Выполнено = АвтоСкрытые.Выполнено + Выполнено;
		АвтоСкрытые.Оплачено = АвтоСкрытые.Оплачено + Оплачено;
		Если АвтоСкрытые.Количество <= 3 Тогда
			АвтоСкрытые.Договоры = АвтоСкрытые.Договоры + ?(ПустаяСтрока(АвтоСкрытые.Договоры), "", "; ")
				+ "«" + Строка(Договор) + "»";
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если ИтогРасчетный < -0.005 Тогда
		// К19 — одним рядком на підрозділ (ЗаполнитьСтрокиРасчета): тут лише накопичуємо
		Отрицательные.Количество = Отрицательные.Количество + 1;
		Отрицательные.Сумма = Отрицательные.Сумма + ИтогРасчетный;
		Если Отрицательные.Количество <= 3 Тогда
			Отрицательные.Договоры = Отрицательные.Договоры + ?(ПустаяСтрока(Отрицательные.Договоры), "", "; ")
				+ "«" + Строка(Договор) + "» " + Формат(ИтогРасчетный, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00");
		КонецЕсли;
	КонецЕсли;

	КонтролиПараметровДоговора(ПараметрыДог, Вариант, Договор, ПодразделениеСтроки, Акты);

	НоваяСтрока = СтрокиДоговоров.Добавить();
	НоваяСтрока.ИмяКонтрагента = Строка(Акк.Контрагент);
	НоваяСтрока.ИмяДоговора    = Строка(Договор);
	НоваяСтрока.Контрагент     = Акк.Контрагент;
	НоваяСтрока.Договор        = Договор;
	НоваяСтрока.Примечание     = Лев(СокрЛП(ПараметрыДог.Примечание), 200);
	НоваяСтрока.СуммаСоглашения = ПараметрыДог.СуммаСоглашения;
	НоваяСтрока.СуммаДЦ         = ПараметрыДог.СуммаДЦ;
	НоваяСтрока.ВыполненныеРаботыРасч = Выполнено;
	НоваяСтрока.ОплаченоРасч          = Оплачено;
	НоваяСтрока.АктыПоданныеРасч      = Акты;
	НоваяСтрока.ВыполненныеРаботы     = Выполнено;
	НоваяСтрока.Оплачено              = Оплачено;
	НоваяСтрока.Задолженность         = Задолженность;
	НоваяСтрока.АктыПоданные          = Акты;
	НоваяСтрока.АктыПоданныеПроведенные   = АктыПров;
	НоваяСтрока.АктыПоданныеНепроведенные = АктыНепров;
	НоваяСтрока.ГарантийныеПлатежи        = Удержание;
	НоваяСтрока.НДСНезарегистрированный   = НДС;
	НоваяСтрока.ИтогоКПолучению           = Итог;
	// у рядку — фактично застосований варіант (з урахуванням замовчування і К22)
	НоваяСтрока.ВариантФормулы            = Вариант;
	НоваяСтрока.ОстатокАванса             = Окр(ОстатокАванса, 2);

КонецПроцедуры

// Фактично застосований варіант. Порожній — «ЗадолженностьПлюсАкты». Невідомий рядок або
// «ЗачетПредоплаты» без суми — К22 і розрахунок як «ЗадолженностьПлюсАкты» (не мовчазний 0).
Функция ВариантФормулыДоговора(ПараметрыДог, Договор, ПодразделениеСтроки)

	Вариант = СокрЛП(ПараметрыДог.ВариантФормулы);
	Если ПустаяСтрока(Вариант) Тогда
		Возврат "ЗадолженностьПлюсАкты";
	КонецЕсли;
	Если Вариант <> "ЗадолженностьПлюсАкты" И Вариант <> "ВыполнениеМинусОплата"
		И Вариант <> "ТолькоРучной" И Вариант <> "ЗачетПредоплаты" Тогда
		ДобавитьЗамечание("Предупреждение", "К22",
			Строка(ПодразделениеСтроки) + ", «" + Строка(Договор) + "»: невідомий варіант формули «"
			+ Вариант + "» — рахується як «ЗадолженностьПлюсАкты».", ПодразделениеСтроки, "Объект.Расчет");
		Возврат "ЗадолженностьПлюсАкты";
	КонецЕсли;
	Если Вариант = "ЗачетПредоплаты" И ПараметрыДог.СуммаПредоплаты <= 0 Тогда
		ДобавитьЗамечание("Предупреждение", "К22",
			Строка(ПодразделениеСтроки) + ", «" + Строка(Договор) + "»: варіант «ЗачетПредоплаты» без суми "
			+ "передоплати — рахується як «ЗадолженностьПлюсАкты».", ПодразделениеСтроки, "Объект.Расчет");
		Возврат "ЗадолженностьПлюсАкты";
	КонецЕсли;
	Возврат Вариант;

КонецФункции

// Залишок авансу для «ЗачетПредоплаты». A_факт = min(A; оплати до першого акта) — неотриманий
// аванс K не завищує. Якщо задано дату заліку (≤ дати розрахунку) — від залишку на ту дату
// віднімається частка актів, виконаних ПІСЛЯ неї; інакше — частка всіх виконаних.
Функция ОстатокПредоплаты(ПараметрыДог, Договор, Выполнено, ПодразделениеСтроки)

	Доля = ПараметрыДог.ПроцентУдержания / 100;
	ДанныеАванса = ДанныеАвансаДоговора(Договор, ПараметрыДог.ДатаЗачетаПредоплаты);

	// Дата заліку діє — залишок задано вручну на ту дату; оплати до першого акта не потрібні
	// (К18/К21 тут були б хибними).
	Если ЗначениеЗаполнено(ПараметрыДог.ДатаЗачетаПредоплаты)
		И ПараметрыДог.ДатаЗачетаПредоплаты <= МоментРасчета() Тогда
		Возврат Макс(0, ПараметрыДог.ОстатокПредоплатыНаДату - ДанныеАванса.ВыполненоПослеДаты * Доля);
	КонецЕсли;

	АвансФакт = Мин(ПараметрыДог.СуммаПредоплаты, ДанныеАванса.ОплатаДоПервогоАкта);
	Если АвансФакт < ПараметрыДог.СуммаПредоплаты - 0.005 Тогда
		Если ЗначениеЗаполнено(НачалоПериода) Тогда
			// оплати раніше «Початку періоду» не видно — аванс міг прийти до нього
			ДобавитьЗамечание("Предупреждение", "К21",
				Строка(ПодразделениеСтроки) + ", «" + Строка(Договор) + "»: у періоді видно лише "
				+ Формат(АвансФакт, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " передоплати з "
				+ Формат(ПараметрыДог.СуммаПредоплаты, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00")
				+ " — аванс міг надійти раніше «Початку періоду»; залишок авансу може бути недостовірним.",
				ПодразделениеСтроки, "Объект.НачалоПериода");
		Иначе
			ДобавитьЗамечание("Предупреждение", "К18",
				Строка(ПодразделениеСтроки) + ", «" + Строка(Договор) + "»: передоплата надійшла не повністю — "
				+ Формат(АвансФакт, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " з "
				+ Формат(ПараметрыДог.СуммаПредоплаты, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " (оплати до першого акта).",
				ПодразделениеСтроки, "Объект.Расчет");
		КонецЕсли;
	КонецЕсли;
	Возврат Макс(0, АвансФакт - Выполнено * Доля);

КонецФункции

// Оплати договору до дати першого акта (E або H; актів немає — усі оплати) і виконані роботи
// після дати заліку. Джерело — рядки РасшифровкаДокументов цього договору (заповнені до
// ЗаполнитьСтрокиРасчета).
Функция ДанныеАвансаДоговора(Договор, ДатаЗачета)

	Результат = Новый Структура("ОплатаДоПервогоАкта, ВыполненоПослеДаты", 0, 0);
	СтрокиДоговора = РасшифровкаДокументов.НайтиСтроки(Новый Структура("Договор", Договор));

	ДатаПервогоАкта = Неопределено;
	Для Каждого СтрокаРасш Из СтрокиДоговора Цикл
		Если СтрокаРасш.СуммаДт > 0
			И (ДатаПервогоАкта = Неопределено ИЛИ СтрокаРасш.ДатаДокумента < ДатаПервогоАкта) Тогда
			ДатаПервогоАкта = СтрокаРасш.ДатаДокумента;
		КонецЕсли;
	КонецЦикла;
	ГраницаОплат = ?(ДатаПервогоАкта = Неопределено, МоментРасчета(), КонецДня(ДатаПервогоАкта));
	ЕстьДатаЗачета = ЗначениеЗаполнено(ДатаЗачета);
	ГраницаЗачета = ?(ЕстьДатаЗачета, КонецДня(ДатаЗачета), МоментРасчета());

	Для Каждого СтрокаРасш Из СтрокиДоговора Цикл
		Если СтрокаРасш.Вид = "Оплата" И СтрокаРасш.ДатаДокумента <= ГраницаОплат Тогда
			Результат.ОплатаДоПервогоАкта = Результат.ОплатаДоПервогоАкта + СтрокаРасш.СуммаКт;
		КонецЕсли;
		Если ЕстьДатаЗачета И СтрокаРасш.Вид = "Виконані роботи" И СтрокаРасш.ДатаДокумента > ГраницаЗачета Тогда
			Результат.ВыполненоПослеДаты = Результат.ВыполненоПослеДаты + СтрокаРасш.СуммаДт;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// J за правилом договору: ОтАктов (порожнє) — з бази актів; НеУчитывать — 0; ОтЗадолженности —
// з додатної заборгованості. Невідоме — К22 і як ОтАктов.
Функция НДСПоПравилу(ПараметрыДог, Договор, ПодразделениеСтроки, Задолженность, БазаАктов)

	Правило = СокрЛП(ПараметрыДог.ПравилоНДС);
	Если ПустаяСтрока(Правило) ИЛИ Правило = "ОтАктов" Тогда
		Возврат СуммаНезарегистрированногоНДС(БазаАктов);
	ИначеЕсли Правило = "НеУчитывать" Тогда
		Возврат 0;
	ИначеЕсли Правило = "ОтЗадолженности" Тогда
		Возврат СуммаНезарегистрированногоНДС(Макс(0, Задолженность));
	ИначеЕсли Правило = "ПослеРегистрацииПН" Тогда
		Возврат НДСНеЗарегистрированныхПН(Договор);
	КонецЕсли;
	ДобавитьЗамечание("Предупреждение", "К22",
		Строка(ПодразделениеСтроки) + ", «" + Строка(Договор) + "»: невідоме правило ПДВ «" + Правило
		+ "» — рахується як «ОтАктов».", ПодразделениеСтроки, "Объект.Расчет");
	Возврат СуммаНезарегистрированногоНДС(БазаАктов);

КонецФункции

// I = −min(сума утримання; max(0; G + H)). Сума оновлюється вручну при оплаті утримання.
Функция ГарантийноеУдержание(ПараметрыДог, Договор, ПодразделениеСтроки, Задолженность, Акты)

	СуммаУдержания = ПараметрыДог.СуммаГарантийногоУдержания;
	Если СуммаУдержания <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	Если Задолженность + Акты > СуммаУдержания + 1 Тогда
		ДобавитьЗамечание("Информация", "К23",
			Строка(ПодразделениеСтроки) + ", «" + Строка(Договор) + "»: борг з актами "
			+ Формат(Задолженность + Акты, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " перевищує гарантійне утримання "
			+ Формат(СуммаУдержания, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " — різниця йде до отримання.",
			ПодразделениеСтроки, "Объект.Расчет");
	КонецЕсли;
	Возврат -Окр(Мин(СуммаУдержания, Макс(0, Задолженность + Акты)), 2);

КонецФункции

// К17 (передоплата ≠ p × сума угоди), К20 (H без запису в регістрі). К21 — в ОстатокПредоплаты.
Процедура КонтролиПараметровДоговора(ПараметрыДог, Вариант, Договор, ПодразделениеСтроки, Акты)

	Префикс = Строка(ПодразделениеСтроки) + ", «" + Строка(Договор) + "»: ";
	Если Вариант = "ЗачетПредоплаты" Тогда
		Расхождение = ПараметрыДог.СуммаПредоплаты
			- ПараметрыДог.СуммаСоглашения * ПараметрыДог.ПроцентУдержания / 100;
		Если ПараметрыДог.СуммаСоглашения = 0 Тогда
			ДобавитьЗамечание("Информация", "К17", Префикс
				+ "сума угоди не заповнена — відсоток заліку авансу не перевірено.",
				ПодразделениеСтроки, "Объект.Расчет");
		ИначеЕсли Расхождение > 1 ИЛИ Расхождение < -1 Тогда
			ДобавитьЗамечание("Информация", "К17", Префикс + "передоплата "
				+ Формат(ПараметрыДог.СуммаПредоплаты, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " ≠ "
				+ Формат(ПараметрыДог.ПроцентУдержания, "ЧДЦ=2; ЧН=0") + " % від суми угоди "
				+ Формат(ПараметрыДог.СуммаСоглашения, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + ".",
				ПодразделениеСтроки, "Объект.Расчет");
		КонецЕсли;
	КонецЕсли;
	Если НЕ ПараметрыДог.ЕстьЗапись И Акты >= 1 Тогда
		ДобавитьЗамечание("Предупреждение", "К20", Префикс + "подані акти "
			+ Формат(Акты, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00")
			+ " без запису в «Параметрах договорів фінзвіту» — рахується Z(0).",
			ПодразделениеСтроки, "Объект.Расчет");
	КонецЕсли;

КонецПроцедуры

// ПДВ, не зареєстрований за поданими актами: сума з ПДВ / (1 + 100/Ставка), зі знаком мінус.
Функция СуммаНезарегистрированногоНДС(СуммаАктов)

	Ставка = СтавкаНДСРасчета();
	Если Ставка = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Окр(-СуммаАктов / (1 + 100 / Ставка), 2);

КонецФункции

// Ставка ПДВ розрахунку. З 16.08.2026 — КОНСТАНТА у коді: реквізит шапки СтавкаНДС
// прибрано (рішення користувача — менше полів на формі), ставка в Україні незмінна 20 %.
Функция СтавкаНДСРасчета()

	Возврат 20;

КонецФункции

// Формула підсумку K одного договору (специфікація 2026-09-28; модель — finrep_k_model.py):
//   ЗадолженностьПлюсАкты : G + I + J + H×(1 − p)
//   ВыполнениеМинусОплата : (E + H)×(1 − p) + J − F + I
//   ЗачетПредоплаты       : G + A_ост + H − min(A_ост; H×p) + J + I
//   ТолькоРучной          : 0
// Повертає «сире» значення; обрізання до 0 — у ДобавитьСтрокуДоговора (К19).
Функция ИтогоПоФормулеДоговора(Вариант, Доля, Выполнено, Оплачено, Задолженность, Акты, НДС, Удержание, ОстатокАванса)

	Если Вариант = "ЗадолженностьПлюсАкты" Тогда
		Возврат Задолженность + Удержание + НДС + Акты * (1 - Доля);
	ИначеЕсли Вариант = "ВыполнениеМинусОплата" Тогда
		Возврат (Выполнено + Акты) * (1 - Доля) + НДС - Оплачено + Удержание;
	ИначеЕсли Вариант = "ЗачетПредоплаты" Тогда
		Возврат Задолженность + ОстатокАванса + Акты - Мин(ОстатокАванса, Акты * Доля) + НДС + Удержание;
	КонецЕсли;
	Возврат 0;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Контроли после расчёта
////////////////////////////////////////////////////////////////////////////////

Процедура КонтролиПослеРасчета(НеотнесенныеОбороты)

	// Рядки розрахунку тепер за договорами, а контролі К01/К02/К06/К08 — за ПІДРОЗДІЛОМ:
	// сальдо 361 порівнянне лише з сумою його договорів, а «немає руху» має сенс по об'єкту.
	Агрегаты = Новый Соответствие;
	Для Каждого СтрокаРезультата Из Расчет Цикл
		Агрегат = Агрегаты.Получить(СтрокаРезультата.Подразделение);
		Если Агрегат = Неопределено Тогда
			Агрегат = Новый Структура(
				"Выполнено, Оплачено, Акты, АктыПроведенные, Итого, Сальдо", 0, 0, 0, 0, 0, 0);
			Агрегаты.Вставить(СтрокаРезультата.Подразделение, Агрегат);
		КонецЕсли;
		Агрегат.Выполнено       = Агрегат.Выполнено + СтрокаРезультата.ВыполненныеРаботы;
		Агрегат.Оплачено        = Агрегат.Оплачено + СтрокаРезультата.Оплачено;
		Агрегат.Акты            = Агрегат.Акты + СтрокаРезультата.АктыПоданные;
		Агрегат.АктыПроведенные = Агрегат.АктыПроведенные + СтрокаРезультата.АктыПоданныеПроведенные;
		Агрегат.Итого           = Агрегат.Итого + СтрокаРезультата.ИтогоКПолучению;
		Агрегат.Сальдо          = Агрегат.Сальдо + СтрокаРезультата.Сальдо361;
	КонецЦикла;

	Для Каждого ЭлементАгрегата Из Агрегаты Цикл

		ПодразделениеСтроки = ЭлементАгрегата.Ключ;
		Агрегат = ЭлементАгрегата.Значение;
		Путь = "Объект.Расчет";
		Задолженность = Окр(Агрегат.Выполнено - Агрегат.Оплачено, 2);

		// К01 — сальдо рахунку містить ТІЛЬКИ проведені акти, тому віднімаємо проведену частину H
		РасчетнаяЗадолженность = Окр(Агрегат.Сальдо - Агрегат.АктыПроведенные, 2);
		Расхождение = РасчетнаяЗадолженность - Задолженность;
		Если Расхождение > 0.01 ИЛИ Расхождение < -0.01 Тогда
			ДобавитьЗамечание("Предупреждение", "К01",
				Строка(ПодразделениеСтроки) + ": звірка не зійшлася. Сальдо "
				+ Формат(Агрегат.Сальдо, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " − проведені акти "
				+ Формат(Агрегат.АктыПроведенные, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " = "
				+ Формат(РасчетнаяЗадолженность, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + ", а Заборгованість (E−F) = "
				+ Формат(Задолженность, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + ". Різниця "
				+ Формат(Расхождение, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + ".",
				ПодразделениеСтроки, Путь);
		КонецЕсли;

		// К02 — жодного руху
		Если Агрегат.Выполнено = 0 И Агрегат.Оплачено = 0 И Агрегат.Акты = 0 Тогда
			ДобавитьЗамечание("Предупреждение", "К02",
				Строка(ПодразделениеСтроки) + ": за період немає жодного руху за рахунками "
				+ "розрахунків. Перевірте підрозділ у договорах або період розрахунку.",
				ПодразделениеСтроки, Путь);
		КонецЕсли;

		// К06 (від'ємний підсумок) знято 28.09.2026: K договору ≥ 0, від'ємне «сире» — К19.

		// К08 — оплата без актів
		Если Агрегат.Выполнено + Агрегат.Акты = 0 И Агрегат.Оплачено > 0 Тогда
			ДобавитьЗамечание("Информация", "К08",
				Строка(ПодразделениеСтроки) + ": є оплата "
				+ Формат(Агрегат.Оплачено, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00")
				+ " без жодного акта — аванс замовника.", ПодразделениеСтроки, Путь);
		КонецЕсли;

	КонецЦикла;

	// К03 — договори напрямку з оборотом за рахунками розрахунків, що не потрапили
	// у жоден рядок (підрозділ договору не заповнено або не входить у ТЧ)
	Если НеотнесенныеОбороты.Количество() > 0 Тогда
		НеотнесенныеСумма = 0;
		Для Каждого СтрокаНеотнесенных Из НеотнесенныеОбороты Цикл
			НеотнесенныеСумма = НеотнесенныеСумма + СтрокаНеотнесенных.ОборотДт;
		КонецЦикла;
		Перечень = "";
		Для Индекс = 0 По Мин(4, НеотнесенныеОбороты.Количество() - 1) Цикл
			Перечень = Перечень + ?(ПустаяСтрока(Перечень), "", "; ")
				+ Строка(НеотнесенныеОбороты[Индекс].Договор);
		КонецЦикла;
		ДобавитьЗамечание("Предупреждение", "К03",
			"Договорів поза розрахунком: " + НеотнесенныеОбороты.Количество() + " на "
			+ Формат(НеотнесенныеСумма, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн оборотів Дт (підрозділ договору "
			+ "не заповнено або не входить у ТЧ). Найбільші: " + Перечень
			+ ". Потрібні — вкажіть у договорі підрозділ і напрям звіту.", Неопределено, "Объект.Подразделения");
	КонецЕсли;

	// К04/К10 — непроведені у розрахунку: поіменно, щоб користувач побачив
	СуммаНепроведенных = 0;
	КоличествоНепроведенных = 0;
	Для Каждого СтрокаРасш Из РасшифровкаДокументов Цикл
		Если НЕ СтрокаРасш.ДокументПроведен Тогда
			КоличествоНепроведенных = КоличествоНепроведенных + 1;
			СуммаНепроведенных = СуммаНепроведенных + СтрокаРасш.СуммаДт;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоНепроведенных > 0 Тогда
		ДобавитьЗамечание("Информация", "К04",
			"Непроведених документів у розрахунку: " + КоличествоНепроведенных + " на "
			+ Формат(СуммаНепроведенных, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн. Вони формують «Акти подані».",
			Неопределено, "Объект.РасшифровкаДокументов");

		Для Каждого СтрокаРасш Из РасшифровкаДокументов Цикл
			Если СтрокаРасш.ДокументПроведен Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьЗамечание("Предупреждение", "К10",
				Строка(СтрокаРасш.Подразделение) + ": непроведений «" + Строка(СтрокаРасш.Документ) + "» на "
				+ Формат(СтрокаРасш.СуммаДт, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн увійшов до «Акти подані». "
				+ "Якщо це не очікувано — проведіть документ або виправте первинку.",
				СтрокаРасш.Подразделение, "Объект.РасшифровкаДокументов");
		КонецЦикла;
	КонецЕсли;

	// К05 — проведені без відмітки «Оригінал»
	СуммаБезОтметки = 0;
	КоличествоБезОтметки = 0;
	Для Каждого СтрокаРасш Из РасшифровкаДокументов Цикл
		Если СтрокаРасш.ДокументПроведен И НЕ СтрокаРасш.Оригинал И СтрокаРасш.СуммаДт > 0 Тогда
			КоличествоБезОтметки = КоличествоБезОтметки + 1;
			СуммаБезОтметки = СуммаБезОтметки + СтрокаРасш.СуммаДт;
		КонецЕсли;
	КонецЦикла;
	Если КоличествоБезОтметки > 0 Тогда
		ДобавитьЗамечание("Информация", "К05",
			"Проведених документів без відмітки «Оригінал»: " + КоличествоБезОтметки + " на "
			+ Формат(СуммаБезОтметки, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн.",
			Неопределено, "Объект.РасшифровкаДокументов");
	КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Печать
////////////////////////////////////////////////////////////////////////////////

// Буфер рядків 1–5: заголовок, параметри, порожній рядок-роздільник (з ширинами колонок —
// вони мають стояти на НЕоб'єднаному рядку) і російська двоповерхова шапка колонок.
// Виводиться потоком першим — рядки лягають в 1–5 підсумкового документа.
// Вывести() приймає лише ТабличныйДокумент (НЕ область), тому повертаємо буфер цілком.
Функция БуферШапкиОтчета(КолонокВсего)

	Буфер = Новый ТабличныйДокумент;

	Обл = Буфер.Область(1, 1, 1, КолонокВсего);
	Обл.Объединить();
	Обл.Текст = ЗаголовокПечати();
	Обл.Шрифт = Новый Шрифт(, 14, Истина);
	Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;

	ТекстПараметров = "Період: "
		+ ?(ЗначениеЗаполнено(НачалоПериода), Формат(НачалоПериода, "ДФ=dd.MM.yyyy"), "з початку обліку")
		+ " — " + Формат(ДатаРасчета, "ДФ=dd.MM.yyyy")
		+ ";  ставка ПДВ: " + Формат(СтавкаНДСРасчета(), "ЧДЦ=0") + "%"
		+ ";  непроведені документи: " + ?(ВключатьНепроведенные, "враховані", "НЕ враховані");
	// Реквізит Организация прибрано 16.08.2026: жоден запит по ньому не фільтрував —
	// звіт рахує по ВСІХ організаціях, розріз задають Напрямок і Підрозділ.

	Обл = Буфер.Область(2, 1, 2, КолонокВсего);
	Обл.Объединить();
	Обл.Текст = ТекстПараметров;
	Обл.Шрифт = Новый Шрифт(, 9);
	Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;

	Ширины = ШириныКолонокПечати();
	Для Индекс = 0 По Ширины.ВГраница() Цикл
		Буфер.Область(3, Индекс + 1, 3, Индекс + 1).ШиринаКолонки = Ширины[Индекс];
	КонецЦикла;

	ВывестиЗаголовкиКолонокОтчета(Буфер, 4);

	Возврат Буфер;

КонецФункции

// Дворівнева РОСІЙСЬКА шапка — 1:1 з ручним Excel (рядки 4–5 еталона): директор звіряє очима,
// тому текст дослівний, ВКЛЮЧНО з друкарською помилкою «незарегестрированного».
// A і H — два поверхи з різним текстом; B, C, D, I, J, K об'єднані вертикально; E:G — група.
Процедура ВывестиЗаголовкиКолонокОтчета(ТабДок, НомерСтроки)

	ЦветШапки = Новый Цвет(198, 217, 160);  // #C6D9A0 — заливка шапки в Excel
	ВерхняяСтрока = НомерСтроки;
	НижняяСтрока  = НомерСтроки + 1;

	// Вертикальні об'єднання: B4:B5, C4:C5, D4:D5, I4:I5, J4:J5, K4:K5
	ВертикальныеКолонки = Новый Соответствие;
	ВертикальныеКолонки.Вставить(2, "Примечание");
	ВертикальныеКолонки.Вставить(3, "Сумма утвержденного соглашения");
	ВертикальныеКолонки.Вставить(4, "Сумма ДЦ поданной на рассмотрение");
	ВертикальныеКолонки.Вставить(9, "Гарантийные платежи");
	ВертикальныеКолонки.Вставить(10, "Сумма незарегестрированного НДС по проведенным актам");
	ВертикальныеКолонки.Вставить(11, "ИТОГО сумма к получению");
	Для Каждого Колонка Из ВертикальныеКолонки Цикл
		Обл = ТабДок.Область(ВерхняяСтрока, Колонка.Ключ, НижняяСтрока, Колонка.Ключ);
		Обл.Объединить();
		ОформитьЯчейкуШапки(Обл, Колонка.Значение, ЦветШапки);
	КонецЦикла;

	// A і H не об'єднані — два поверхи з різним текстом
	ОформитьЯчейкуШапки(ТабДок.Область(ВерхняяСтрока, 1, ВерхняяСтрока, 1),
		"Контрагент", ЦветШапки);
	ОформитьЯчейкуШапки(ТабДок.Область(НижняяСтрока, 1, НижняяСтрока, 1),
		"Договор", ЦветШапки);
	ОформитьЯчейкуШапки(ТабДок.Область(ВерхняяСтрока, 8, ВерхняяСтрока, 8),
		"Поданные акты на рассмотрении", ЦветШапки);
	ОформитьЯчейкуШапки(ТабДок.Область(НижняяСтрока, 8, НижняяСтрока, 8),
		"Акты поданные на Заказчика", ЦветШапки);

	// E4:G4 — горизонтальна група, під нею три колонки
	Обл = ТабДок.Область(ВерхняяСтрока, 5, ВерхняяСтрока, 7);
	Обл.Объединить();
	ОформитьЯчейкуШапки(Обл, "Фактические данные на дату составления отчета", ЦветШапки);
	ОформитьЯчейкуШапки(ТабДок.Область(НижняяСтрока, 5, НижняяСтрока, 5),
		"Выполненные работы грн.", ЦветШапки);
	ОформитьЯчейкуШапки(ТабДок.Область(НижняяСтрока, 6, НижняяСтрока, 6),
		"Оплачено грн.", ЦветШапки);
	ОформитьЯчейкуШапки(ТабДок.Область(НижняяСтрока, 7, НижняяСтрока, 7),
		"Задолженность, грн. (аванс-)", ЦветШапки);

КонецПроцедуры

Процедура ОформитьЯчейкуШапки(Обл, ТекстЯчейки, ЦветШапки)

	Граница = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	Обл.Текст = ТекстЯчейки;
	Обл.ЦветФона = ЦветШапки;
	Обл.Шрифт = Новый Шрифт(, , Истина);
	Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	Обл.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	Обл.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Обл.ГраницаСверху = Граница;
	Обл.ГраницаСнизу = Граница;
	Обл.ГраницаСлева = Граница;
	Обл.ГраницаСправа = Граница;

КонецПроцедуры

Процедура ВывестиСтрокуОтчета(ТабДок, НомерСтроки, МассивЗначений, Жирный,
	ЦветФонаСтроки = Неопределено, ЦентрироватьВсе = Ложь)

	Граница = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	Для Индекс = 0 По МассивЗначений.ВГраница() Цикл
		Обл = ТабДок.Область(НомерСтроки, Индекс + 1, НомерСтроки, Индекс + 1);
		Обл.Текст = МассивЗначений[Индекс];
		Обл.ГраницаСверху = Граница;
		Обл.ГраницаСнизу = Граница;
		Обл.ГраницаСлева = Граница;
		Обл.ГраницаСправа = Граница;
		Если ЦентрироватьВсе Тогда
			Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		ИначеЕсли Индекс <= 1 Тогда
			Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
		Иначе
			Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
			Если ТипЗнч(МассивЗначений[Индекс]) = Тип("Число") Тогда
				Обл.Текст = Формат(МассивЗначений[Индекс], "ЧДЦ=2; ЧРГ=' '; ЧН=");
				Если МассивЗначений[Индекс] < 0 Тогда
					Обл.ЦветТекста = Новый Цвет(160, 0, 0);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Жирный Тогда
			Обл.Шрифт = Новый Шрифт(, , Истина);
		КонецЕсли;
		Если ЦветФонаСтроки <> Неопределено Тогда
			Обл.ЦветФона = ЦветФонаСтроки;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Набір сум друкованих колонок C..K одного рівня (підрозділ / контрагент / РАЗОМ).
Функция НовыйНаборСуммПечати()

	Возврат Новый Структура("C, D, E, F, G, H, I, J, K", 0, 0, 0, 0, 0, 0, 0, 0, 0);

КонецФункции

Процедура ДобавитьВСуммыПечати(Суммы, СтрокаРезультата)

	Суммы.C = Суммы.C + СтрокаРезультата.СуммаСоглашения;
	Суммы.D = Суммы.D + СтрокаРезультата.СуммаДЦ;
	Суммы.E = Суммы.E + СтрокаРезультата.ВыполненныеРаботы;
	Суммы.F = Суммы.F + СтрокаРезультата.Оплачено;
	Суммы.G = Суммы.G + СтрокаРезультата.Задолженность;
	Суммы.H = Суммы.H + СтрокаРезультата.АктыПоданные;
	Суммы.I = Суммы.I + СтрокаРезультата.ГарантийныеПлатежи;
	Суммы.J = Суммы.J + СтрокаРезультата.НДСНезарегистрированный;
	Суммы.K = Суммы.K + СтрокаРезультата.ИтогоКПолучению;

КонецПроцедуры

// Ширини колонок друку: A/B/C/G/H/I — з Excel-еталона, решта — робочі.
// ЄДИНІ для шапки і всіх буферів рядків — інакше потоковий вивід створить різні
// форматні секції і сітка «роз'їдеться».
Функция ШириныКолонокПечати()

	Ширины = Новый Массив;
	Ширины.Добавить(45);    // A Контрагент / Договор
	Ширины.Добавить(48);    // B Примечание
	Ширины.Добавить(18.5);  // C Сумма утвержденного соглашения
	Ширины.Добавить(13);    // D Сумма ДЦ
	Ширины.Добавить(13);    // E Выполненные работы
	Ширины.Добавить(13);    // F Оплачено
	Ширины.Добавить(20.3);  // G Задолженность
	Ширины.Добавить(18.5);  // H Поданные акты
	Ширины.Добавить(18.5);  // I Гарантийные платежи
	Ширины.Добавить(13);    // J НДС
	Ширины.Добавить(14);    // K ИТОГО
	Возврат Ширины;

КонецФункции

// Буфер-табдок для одного фрагмента потокового виводу зі стандартними ширинами колонок.
Функция НовыйБуферСтроки()

	Буфер = Новый ТабличныйДокумент;
	Ширины = ШириныКолонокПечати();
	Для Индекс = 0 По Ширины.ВГраница() Цикл
		Буфер.Область(1, Индекс + 1, 1, Индекс + 1).ШиринаКолонки = Ширины[Индекс];
	КонецЦикла;
	Возврат Буфер;

КонецФункции

// Виводить один рядок потоком з рівнем автогрупування (0 = поза групуванням).
// ЗначениеРасшифровки (посилання) вішається на колонку A: у стандартному перегляді
// подвійний клік відкриває об'єкт.
Процедура ВывестиСтрокуПотоком(ТабДок, Значения, Жирный, ЦветФона, Уровень,
	МелкийШрифт = Ложь, ЦветТекстаСтроки = Неопределено, ЗначениеРасшифровки = Неопределено)

	Буфер = НовыйБуферСтроки();
	ВывестиСтрокуОтчета(Буфер, 1, Значения, Жирный, ЦветФона);
	Если ЗначениеРасшифровки <> Неопределено Тогда
		Буфер.Область(1, 1, 1, 1).Расшифровка = ЗначениеРасшифровки;
	КонецЕсли;
	Если МелкийШрифт Тогда
		Буфер.Область(1, 1, 1, Значения.ВГраница() + 1).Шрифт = Новый Шрифт(, 8);
	КонецЕсли;
	Если ЦветТекстаСтроки <> Неопределено Тогда
		Буфер.Область(1, 1, 1, Значения.ВГраница() + 1).ЦветТекста = ЦветТекстаСтроки;
	КонецЕсли;

	Если Уровень = 0 Тогда
		ТабДок.Вывести(Буфер);
	Иначе
		ТабДок.Вывести(Буфер, Уровень, , Истина);
	КонецЕсли;

КонецПроцедуры

// Жирний рядок рівня (підрозділ, контрагент, РАЗОМ) з сумами C..K.
Процедура ВывестиСтрокуУровня(ТабДок, ТекстКолонкиА, ТекстКолонкиБ, Суммы, ЦветФона, Уровень)

	Значения = Новый Массив;
	Значения.Добавить(ТекстКолонкиА);
	Значения.Добавить(ТекстКолонкиБ);
	Значения.Добавить(Суммы.C);
	Значения.Добавить(Суммы.D);
	Значения.Добавить(Суммы.E);
	Значения.Добавить(Суммы.F);
	Значения.Добавить(Суммы.G);
	Значения.Добавить(Суммы.H);
	Значения.Добавить(Суммы.I);
	Значения.Добавить(Суммы.J);
	Значения.Добавить(Суммы.K);
	ВывестиСтрокуПотоком(ТабДок, Значения, Истина, ЦветФона, Уровень);

КонецПроцедуры

// Рядки документів одного договору (друк «з розшифровкою»): дата + документ, суми за видом
// (виконані → E, оплати → F, акти → H), непроведені — помаранчеві з позначкою.
// Рівень автогрупування 4 — згортаються під рядком договору.
Процедура ВывестиДокументыДоговора(ТабДок, СтрокаДоговора)

	Отбор = Новый Структура("Подразделение, Договор",
		СтрокаДоговора.Подразделение, СтрокаДоговора.Договор);

	СтрокиДокументов = Новый ТаблицаЗначений;
	СтрокиДокументов.Колонки.Добавить("Дата");
	СтрокиДокументов.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	СтрокиДокументов.Колонки.Добавить("СтрокаРасшифровки");
	Для Каждого СтрокаРасш Из РасшифровкаДокументов.НайтиСтроки(Отбор) Цикл
		НоваяСтрока = СтрокиДокументов.Добавить();
		НоваяСтрока.Дата = СтрокаРасш.ДатаДокумента;
		НоваяСтрока.Имя = Строка(СтрокаРасш.Документ);
		НоваяСтрока.СтрокаРасшифровки = СтрокаРасш;
	КонецЦикла;
	СтрокиДокументов.Сортировать("Дата, Имя");

	ЦветНепроведенных = Новый Цвет(138, 90, 0);
	Для Каждого СтрокаДокумента Из СтрокиДокументов Цикл

		СтрокаРасш = СтрокаДокумента.СтрокаРасшифровки;
		ЭтоВыполненные = СтрокаРасш.ДокументПроведен И СтрокаРасш.Оригинал;

		Значения = Новый Массив;
		Значения.Добавить("            " + Формат(СтрокаРасш.ДатаДокумента, "ДФ=dd.MM.yyyy")
			+ "  " + Строка(СтрокаРасш.Документ)
			+ ?(СтрокаРасш.ДокументПроведен, "", " (не проведено)"));
		Значения.Добавить("");
		Значения.Добавить("");
		Значения.Добавить("");
		Значения.Добавить(?(ЭтоВыполненные, СтрокаРасш.СуммаДт, 0));
		Значения.Добавить(СтрокаРасш.СуммаКт);
		Значения.Добавить("");
		Значения.Добавить(?(ЭтоВыполненные, 0, СтрокаРасш.СуммаДт));
		Значения.Добавить("");
		Значения.Добавить("");
		Значения.Добавить("");
		ВывестиСтрокуПотоком(ТабДок, Значения, Ложь, Неопределено, 4, Истина,
			?(СтрокаРасш.ДокументПроведен, Неопределено, ЦветНепроведенных),
			СтрокаРасш.Документ);

	КонецЦикла;

КонецПроцедуры

// Згортка рядків-договорів до підрозділів — для доповіді, HTML і друку доповіді:
// їхній вигляд лишається «по об'єктах», як до переходу на рядки-договори.
Функция СводРасчетаПоПодразделениям()

	Свод = Расчет.Выгрузить(, "Подразделение, ВыполненныеРаботы, Оплачено, Задолженность,"
		+ " АктыПоданные, АктыПоданныеНепроведенные, ИтогоКПолучению");
	Свод.Свернуть("Подразделение",
		"ВыполненныеРаботы, Оплачено, Задолженность, АктыПоданные, АктыПоданныеНепроведенные,"
		+ " ИтогоКПолучению");
	Возврат Свод;

КонецФункции

// Фрази доповіді: по одній на об'єкт + вступ і підсумок. Формулювання нейтральні,
// без жаргону (регламент — knowledge_Письмо Директору).
Функция МассивФразДоклада()

	Фразы = Новый Массив;

	Если Расчет.Количество() = 0 Тогда
		Фразы.Добавить("Розрахунок не виконано або не містить жодного рядка.");
		Возврат Фразы;
	КонецЕсли;

	Свод = СводРасчетаПоПодразделениям();

	ИтогK = 0;
	ИтогH = 0;
	Для Каждого СтрокаРезультата Из Свод Цикл
		ИтогK = ИтогK + СтрокаРезультата.ИтогоКПолучению;
		ИтогH = ИтогH + СтрокаРезультата.АктыПоданные;
	КонецЦикла;

	Фразы.Добавить("Станом на " + Формат(ДатаРасчета, "ДФ=dd.MM.yyyy") + " по "
		+ Свод.Количество() + " об'єктах виробництва загальна сума до отримання складає "
		+ Формат(ИтогK, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн, з них подано актів на "
		+ Формат(ИтогH, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн.");
	Фразы.Добавить("");

	Для Каждого СтрокаРезультата Из Свод Цикл

		Фраза = Строка(СтрокаРезультата.Подразделение) + ": виконано робіт на "
			+ Формат(СтрокаРезультата.ВыполненныеРаботы, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн, оплачено "
			+ Формат(СтрокаРезультата.Оплачено, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн";

		Если СтрокаРезультата.АктыПоданные <> 0 Тогда
			Фраза = Фраза + ", подано актів на "
				+ Формат(СтрокаРезультата.АктыПоданные, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн";
			Если СтрокаРезультата.АктыПоданныеНепроведенные <> 0 Тогда
				Фраза = Фраза + " (з них не проведено в обліку "
					+ Формат(СтрокаРезультата.АктыПоданныеНепроведенные, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн)";
			КонецЕсли;
		КонецЕсли;

		Если СтрокаРезультата.Задолженность < 0 Тогда
			Фраза = Фраза + ". Замовник має передоплату "
				+ Формат(-СтрокаРезультата.Задолженность, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн";
		ИначеЕсли СтрокаРезультата.Задолженность > 0 Тогда
			Фраза = Фраза + ". Заборгованість замовника "
				+ Формат(СтрокаРезультата.Задолженность, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн";
		КонецЕсли;

		Фраза = Фраза + ". Разом до отримання — "
			+ Формат(СтрокаРезультата.ИтогоКПолучению, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн.";

		Фразы.Добавить(Фраза);

	КонецЦикла;

	Возврат Фразы;

КонецФункции

Функция ЭкранироватьHTML(Текст)

	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Возврат СтрЗаменить(Результат, """", "&quot;");

КонецФункции

Функция ЧислоДляHTML(Значение)

	Возврат Формат(Значение, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00");

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Оплати за казною (специфікація 2026-09-28)
////////////////////////////////////////////////////////////////////////////////

Функция КлючОплаты(Регистратор, Договор)

	Возврат Строка(Регистратор.УникальныйИдентификатор()) + "|" + Строка(Договор.УникальныйИдентификатор());

КонецФункции

Функция КороткоДокумент(Документ)

	Возврат СокрЛП(Документ.Номер) + " від " + Формат(Документ.Дата, "ДФ=dd.MM.yyyy");

КонецФункции

// Крок 0: оплати Кт 361 від ПоступлениеНаРасчетныйСчет ↔ ПлатежноеПоручениеВходящее казни ЗА UUID
// (обмін казна → ЕРП → BuhBud, UUID 1:1, 198/198 на 28.09.2026). У казні договору немає — підрозділ
// шапки і рядки «Расшифровки». Тексти запитів = doc_finrep_kazna_oplaty_prototype.py (Rule #-1).
// Повертає Структура: Переносы (Договір -> Підрозділ), ПодразделенияОплат (КлючОплаты -> текст),
// Переносено / Предупреждения (К14), Сводка (зведений К15).
Функция ПодразделенияДоговоровПоКазне(СоединениеКазны, ТаблицаОборотов, ТаблицаНепроведенных, КартаДоп, НаборПодр)

	Сводка = Новый Структура("ВнеОтчетаКол, ВнеОтчетаСумма, ВнеОтчетаДок, НеСопоставленоКол, НеСопоставленоСумма, НетВКазнеКол, НетВКазнеСумма, НеПНРСКол, НеПНРССумма",
		0, 0, "", 0, 0, 0, 0, 0, 0);
	Результат = Новый Структура("Переносы, ПодразделенияОплат, Переносено, Предупреждения, Сводка",
		Новый Соответствие, Новый Соответствие, Новый Массив, Новый Массив, Сводка);
	Если СоединениеКазны = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ЕстьАкты = Новый Соответствие;
	Для Каждого СтрокаОб Из ТаблицаОборотов Цикл
		Если СтрокаОб.ОборотДт <> 0 Тогда
			ЕстьАкты.Вставить(СтрокаОб.Договор, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаНепр Из ТаблицаНепроведенных Цикл
		ЕстьАкты.Вставить(СтрокаНепр.Договор, Истина);
	КонецЦикла;

	ТипПНРС = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет");
	Оплаты = Новый ТаблицаЗначений;
	Оплаты.Колонки.Добавить("Регистратор");
	Оплаты.Колонки.Добавить("Договор");
	Оплаты.Колонки.Добавить("Цель");
	Оплаты.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Оплаты.Колонки.Добавить("УИД", Новый ОписаниеТипов("Строка"));
	Оплаты.Колонки.Добавить("Корень", Новый ОписаниеТипов("Строка"));
	Оплаты.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"));
	МассивПНРС = Новый Массив;
	ЕстьНеПНРС = Новый Соответствие;   // договори з оплатами, які казна не перевіряє — не переносяться
	Для Каждого СтрокаОб Из ТаблицаОборотов Цикл
		Если СтрокаОб.ОборотКт <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Цель = ЦелевоеПодразделение(СтрокаОб.Договор, СтрокаОб.Подразделение, КартаДоп, НаборПодр);
		Если Цель = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(СтрокаОб.Регистратор) <> ТипПНРС Тогда
			ЕстьНеПНРС.Вставить(СтрокаОб.Договор, Истина);
			Сводка.НеПНРСКол = Сводка.НеПНРСКол + 1;
			Сводка.НеПНРССумма = Сводка.НеПНРССумма + СтрокаОб.ОборотКт;
			Результат.ПодразделенияОплат.Вставить(КлючОплаты(СтрокаОб.Регистратор, СтрокаОб.Договор),
				"не перевіряється");
			Продолжить;
		КонецЕсли;
		СтрокаОпл = Оплаты.Добавить();
		СтрокаОпл.Регистратор = СтрокаОб.Регистратор;
		СтрокаОпл.Договор     = СтрокаОб.Договор;
		СтрокаОпл.Цель        = Цель;
		СтрокаОпл.Сумма       = СтрокаОб.ОборотКт;
		СтрокаОпл.УИД         = Строка(СтрокаОб.Регистратор.УникальныйИдентификатор());
		Если МассивПНРС.Найти(СтрокаОб.Регистратор) = Неопределено Тогда
			МассивПНРС.Добавить(СтрокаОб.Регистратор);
		КонецЕсли;
	КонецЦикла;
	Если Оплаты.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ЗапросСумм = Новый Запрос;
	ЗапросСумм.Текст =
	"ВЫБРАТЬ
	|	П.Ссылка КАК Ссылка,
	|	П.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.ПоступлениеНаРасчетныйСчет КАК П
	|ГДЕ
	|	П.Ссылка В (&Ссылки)";
	ЗапросСумм.УстановитьПараметр("Ссылки", МассивПНРС);
	СуммыДокументов = Новый Соответствие;
	ВыборкаСумм = ЗапросСумм.Выполнить().Выбрать();
	Пока ВыборкаСумм.Следующий() Цикл
		СуммыДокументов.Вставить(ВыборкаСумм.Ссылка, ВыборкаСумм.СуммаДокумента);
	КонецЦикла;

	Попытка
		ШапкиКазны = ШапкиПлатежейКазны(СоединениеКазны, МассивПНРС);
	Исключение
		ДобавитьЗамечание("Предупреждение", "П34",
			"Оплати не звірено з казною: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ".",
			Неопределено, "Объект.РасшифровкаДокументов");
		Возврат Результат;
	КонецПопытки;

	ИменаОтчета = Новый Соответствие;
	Для Каждого ЭлементНабора Из НаборПодр Цикл
		ИменаОтчета.Вставить(Строка(ЭлементНабора.Ключ), ЭлементНабора.Ключ);
	КонецЦикла;
	Исключенные = Новый Массив;
	Исключенные.Добавить("Главный офис");
	Исключенные.Добавить("Цех металлоконструкций");

	ПоДоговорам = Новый Соответствие;
	Для Каждого СтрокаОпл Из Оплаты Цикл
		СопоставитьОплатуСКазной(СтрокаОпл, ШапкиКазны.Получить(СтрокаОпл.УИД),
			СуммыДокументов.Получить(СтрокаОпл.Регистратор));
		Если СтрокаОпл.Статус = "НемаєВКазні" Тогда
			ТекстКазны = "немає в казні";
			Сводка.НетВКазнеКол = Сводка.НетВКазнеКол + 1;
			Сводка.НетВКазнеСумма = Сводка.НетВКазнеСумма + СтрокаОпл.Сумма;
		ИначеЕсли СтрокаОпл.Статус = "НеЗіставлено" Тогда
			ТекстКазны = "не зіставлено";
			Сводка.НеСопоставленоКол = Сводка.НеСопоставленоКол + 1;
			Сводка.НеСопоставленоСумма = Сводка.НеСопоставленоСумма + СтрокаОпл.Сумма;
		Иначе
			ТекстКазны = СтрокаОпл.Корень;
			Если СтрокаОпл.Статус = "Інший" И (ИменаОтчета.Получить(СтрокаОпл.Корень) = Неопределено
				ИЛИ Исключенные.Найти(СтрокаОпл.Корень) <> Неопределено) Тогда
				Сводка.ВнеОтчетаКол = Сводка.ВнеОтчетаКол + 1;
				Сводка.ВнеОтчетаСумма = Сводка.ВнеОтчетаСумма + СтрокаОпл.Сумма;
				Если Сводка.ВнеОтчетаКол <= 5 Тогда
					Сводка.ВнеОтчетаДок = Сводка.ВнеОтчетаДок + ?(ПустаяСтрока(Сводка.ВнеОтчетаДок), "", "; ")
						+ КороткоДокумент(СтрокаОпл.Регистратор) + " → " + СтрокаОпл.Корень;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Результат.ПодразделенияОплат.Вставить(КлючОплаты(СтрокаОпл.Регистратор, СтрокаОпл.Договор), ТекстКазны);
		СписокДоговора = ПоДоговорам.Получить(СтрокаОпл.Договор);
		Если СписокДоговора = Неопределено Тогда
			СписокДоговора = Новый Массив;
			ПоДоговорам.Вставить(СтрокаОпл.Договор, СписокДоговора);
		КонецЕсли;
		СписокДоговора.Добавить(СтрокаОпл);
	КонецЦикла;

	Для Каждого ЭлементДоговора Из ПоДоговорам Цикл
		Договор = ЭлементДоговора.Ключ;
		СписокДоговора = ЭлементДоговора.Значение;
		Корень = "";
		ВсеВОдномДругом = Истина;
		Для Каждого СтрокаОпл Из СписокДоговора Цикл
			Если СтрокаОпл.Статус <> "Інший" ИЛИ ИменаОтчета.Получить(СтрокаОпл.Корень) = Неопределено
				ИЛИ Исключенные.Найти(СтрокаОпл.Корень) <> Неопределено
				ИЛИ (НЕ ПустаяСтрока(Корень) И Корень <> СтрокаОпл.Корень) Тогда
				ВсеВОдномДругом = Ложь;
				Прервать;
			КонецЕсли;
			Корень = СтрокаОпл.Корень;
		КонецЦикла;

		Если ВсеВОдномДругом И ЕстьАкты.Получить(Договор) = Неопределено
			И ЕстьНеПНРС.Получить(Договор) = Неопределено
			И КартаДоп.Получить(Договор) = Неопределено Тогда
			Приемник = ИменаОтчета.Получить(Корень);
			Результат.Переносы.Вставить(Договор, Приемник);
			ПереченьДокументов = "";
			Для Каждого СтрокаОпл Из СписокДоговора Цикл
				ПереченьДокументов = ПереченьДокументов + ?(ПустаяСтрока(ПереченьДокументов), "", "; ")
					+ КороткоДокумент(СтрокаОпл.Регистратор) + " — " + Формат(СтрокаОпл.Сумма, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00");
			КонецЦикла;
			Результат.Переносено.Добавить(Новый Структура("Подразделение, Текст", Приемник,
				"«" + Строка(Договор) + "»: " + Строка(СписокДоговора[0].Цель) + " → " + Корень
				+ " за казною (актів немає, усі оплати в казні — " + Корень + "): " + ПереченьДокументов + "."));
			Продолжить;
		КонецЕсли;

		Для Каждого СтрокаОпл Из СписокДоговора Цикл
			Если СтрокаОпл.Статус = "Інший" И ИменаОтчета.Получить(СтрокаОпл.Корень) <> Неопределено
				И Исключенные.Найти(СтрокаОпл.Корень) = Неопределено Тогда
				Результат.Предупреждения.Добавить(Новый Структура("Подразделение, Текст", СтрокаОпл.Цель,
					КороткоДокумент(СтрокаОпл.Регистратор) + " — " + Формат(СтрокаОпл.Сумма, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00")
					+ ": у бухгалтерії договір «" + Строка(Договор) + "» (" + Строка(СтрокаОпл.Цель)
					+ "), у казні — " + СтрокаОпл.Корень + ". Не перенесено (у договору є акти, оплати різних "
					+ "об'єктів або оплати, яких казна не перевіряє) — перевірте рознесення."));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Шапки і рядки «Расшифровки» ПлатежноеПоручениеВходящее казни для масиву ПНРС BuhBud.
// Запити — на боці казни, сюди — лише рядки і числа. Ключ — UUID рядком (V83.string lowercase).
Функция ШапкиПлатежейКазны(СоединениеКазны, МассивПНРС)

	Родители = ИерархияПодразделенийКазны(СоединениеКазны);
	МенеджерКазны = СоединениеКазны.Документы.ПлатежноеПоручениеВходящее;
	СсылкиКазны = СоединениеКазны.NewObject("Массив");
	Для Каждого СсылкаПНРС Из МассивПНРС Цикл
		СсылкиКазны.Добавить(МенеджерКазны.ПолучитьСсылку(
			СоединениеКазны.NewObject("УникальныйИдентификатор", Строка(СсылкаПНРС.УникальныйИдентификатор()))));
	КонецЦикла;

	ЗапросШапки = СоединениеКазны.NewObject("Запрос");
	ЗапросШапки.Текст =
	"ВЫБРАТЬ
	|	П.Ссылка КАК Ссылка,
	|	П.СуммаДокумента КАК СуммаДокумента,
	|	П.Подразделение.Наименование КАК ПодразделениеИмя
	|ИЗ
	|	Документ.ПлатежноеПоручениеВходящее КАК П
	|ГДЕ
	|	П.Ссылка В (&Ссылки)";
	ЗапросШапки.УстановитьПараметр("Ссылки", СсылкиКазны);
	Шапки = Новый Соответствие;
	Выборка = ЗапросШапки.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИмяПодр = Выборка.ПодразделениеИмя;
		Если ТипЗнч(ИмяПодр) <> Тип("Строка") Тогда
			ИмяПодр = "";
		КонецЕсли;
		Шапки.Вставить(СоединениеКазны.string(Выборка.Ссылка.УникальныйИдентификатор()),
			Новый Структура("Сумма, Корень, Части", Выборка.СуммаДокумента,
				?(ПустаяСтрока(ИмяПодр), "", КореньПодразделенияКазны(ИмяПодр, Родители)), Новый Массив));
	КонецЦикла;

	ЗапросЧастей = СоединениеКазны.NewObject("Запрос");
	ЗапросЧастей.Текст =
	"ВЫБРАТЬ
	|	Р.Ссылка КАК Ссылка,
	|	Р.Подразделение.Наименование КАК ПодразделениеИмя,
	|	Р.Сумма КАК Сумма
	|ИЗ
	|	Документ.ПлатежноеПоручениеВходящее.Расшифровка КАК Р
	|ГДЕ
	|	Р.Ссылка В (&Ссылки)";
	ЗапросЧастей.УстановитьПараметр("Ссылки", СсылкиКазны);
	Выборка = ЗапросЧастей.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Шапка = Шапки.Получить(СоединениеКазны.string(Выборка.Ссылка.УникальныйИдентификатор()));
		Если Шапка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИмяПодр = Выборка.ПодразделениеИмя;
		Если ТипЗнч(ИмяПодр) <> Тип("Строка") Тогда
			ИмяПодр = "";
		КонецЕсли;
		Шапка.Части.Добавить(Новый Структура("Корень, Сумма",
			?(ПустаяСтрока(ИмяПодр), "", КореньПодразделенияКазны(ИмяПодр, Родители)), Выборка.Сумма));
	КонецЦикла;
	Возврат Шапки;

КонецФункции

// Статус рядка оплати: «Збіг» (корінь казни = Ціль), «Інший», «НеЗіставлено», «НемаєВКазні».
// Порядок: частина «Расшифровки» з коренем = Ціль → частина з точною сумою → шапка без «Расшифровки»
// (корінь = Ціль, або суми документів BuhBud і казни рівні).
Процедура СопоставитьОплатуСКазной(СтрокаОпл, Шапка, СуммаДокументаБух)

	Если Шапка = Неопределено Тогда
		СтрокаОпл.Статус = "НемаєВКазні";
		Возврат;
	КонецЕсли;
	ИмяЦели = Строка(СтрокаОпл.Цель);
	Корень = "";
	Для Каждого Часть Из Шапка.Части Цикл
		Если Часть.Корень = ИмяЦели Тогда
			Корень = ИмяЦели;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Корень) Тогда
		Для Каждого Часть Из Шапка.Части Цикл
			Если Окр(Часть.Сумма - СтрокаОпл.Сумма, 2) = 0 Тогда
				Корень = Часть.Корень;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ПустаяСтрока(Корень) И Шапка.Части.Количество() = 0 Тогда
		Если Шапка.Корень = ИмяЦели Тогда
			Корень = ИмяЦели;
		ИначеЕсли СуммаДокументаБух <> Неопределено И Окр(СуммаДокументаБух - Шапка.Сумма, 2) = 0 Тогда
			Корень = Шапка.Корень;
		КонецЕсли;
	КонецЕсли;
	СтрокаОпл.Корень = Корень;
	Если ПустаяСтрока(Корень) Тогда
		СтрокаОпл.Статус = "НеЗіставлено";
	ИначеЕсли Корень = ИмяЦели Тогда
		СтрокаОпл.Статус = "Збіг";
	Иначе
		СтрокаОпл.Статус = "Інший";
	КонецЕсли;

КонецПроцедуры

// К14 (Інформація — перенесені договори; Попередження — оплати з актами в іншому об'єкті)
// і зведений К15 одним рядком.
Процедура ЗамечанияОплатКазны(ДанныеКазны)

	Для Каждого Перенос Из ДанныеКазны.Переносено Цикл
		ДобавитьЗамечание("Информация", "К14", Перенос.Текст, Перенос.Подразделение, "Объект.Расчет");
	КонецЦикла;
	Для Каждого Предупреждение Из ДанныеКазны.Предупреждения Цикл
		ДобавитьЗамечание("Предупреждение", "К14", Предупреждение.Текст, Предупреждение.Подразделение,
			"Объект.РасшифровкаДокументов");
	КонецЦикла;

	Св = ДанныеКазны.Сводка;
	Если Св.ВнеОтчетаКол + Св.НеСопоставленоКол + Св.НетВКазнеКол + Св.НеПНРСКол = 0 Тогда
		Возврат;
	КонецЕсли;
	ДобавитьЗамечание("Информация", "К15",
		"Оплати лишено як у бухгалтерії: підрозділ казни поза звітом — " + Св.ВнеОтчетаКол + " на "
		+ Формат(Св.ВнеОтчетаСумма, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00")
		+ ?(ПустаяСтрока(Св.ВнеОтчетаДок), "", " (" + Св.ВнеОтчетаДок + ")")
		+ "; не зіставлено — " + Св.НеСопоставленоКол + " на " + Формат(Св.НеСопоставленоСумма, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00")
		+ "; немає в казні — " + Св.НетВКазнеКол + " на " + Формат(Св.НетВКазнеСумма, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00")
		+ "; не від «Надходження на рахунок» — " + Св.НеПНРСКол + " на " + Формат(Св.НеПНРССумма, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00")
		+ ". Підрозділ казни кожної оплати — колонка «Підрозділ казни» розшифровки.",
		Неопределено, "Объект.РасшифровкаДокументов");

КонецПроцедуры

// К16: казна відносить оплату до об'єкта звіту, а бухгалтерія — до договору поза звітом. НЕ додається
// в F (одні оплати без актів — фальшивий аванс; пари-перестановки — подвійний рахунок). Фільтр —
// на боці казни (шапка АБО рядок «Расшифровки» в ієрархії підрозділів звіту, група доходу УТ-001053
// без статей-виключень ТЧ). Текст = doc_finrep_kazna_oplaty_prototype.py (Rule #-1).
Процедура КонтрольОплатКазныВнеОтчета(СоединениеКазны, КартаДоп, НаборПодр)

	Если СоединениеКазны = Неопределено Тогда
		Возврат;
	КонецЕсли;
	КорниДокументов = Новый Соответствие;   // УИД -> Массив коренів казни (точне порівняння, не підрядок)
	МассивБух = Новый Массив;
	Попытка
		Корни = КорниОтчетаВКазне(СоединениеКазны, НаборПодр);
		Если Корни.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		Родители = ИерархияПодразделенийКазны(СоединениеКазны);
		Исключения = СписокСтатейИсключенияДляЗапроса();
		ЗапросКазны = СоединениеКазны.NewObject("Запрос");
		ЗапросКазны.Текст =
		"ВЫБРАТЬ
		|	Д.Ссылка КАК Ссылка,
		|	Д.ПодразделениеИмя КАК ПодразделениеИмя
		|ИЗ
		|	(ВЫБРАТЬ
		|		П.Ссылка КАК Ссылка,
		|		П.Подразделение.Наименование КАК ПодразделениеИмя
		|	ИЗ
		|		Документ.ПлатежноеПоручениеВходящее КАК П
		|	ГДЕ
		|		П.Проведен
		|		И П.Дата МЕЖДУ &Начало И &Конец
		|		И П.Подразделение В ИЕРАРХИИ (&Корни)
		|		И П.СтатьяДвиженияДенежныхСредств В ИЕРАРХИИ (&ГруппаДоход)
		|		И НЕ П.СтатьяДвиженияДенежныхСредств.Наименование В (" + Исключения + ")
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		Р.Ссылка,
		|		Р.Подразделение.Наименование
		|	ИЗ
		|		Документ.ПлатежноеПоручениеВходящее.Расшифровка КАК Р
		|	ГДЕ
		|		Р.Ссылка.Проведен
		|		И Р.Ссылка.Дата МЕЖДУ &Начало И &Конец
		|		И Р.Подразделение В ИЕРАРХИИ (&Корни)
		|		И Р.СтатьяДвиженияДенежныхСредств В ИЕРАРХИИ (&ГруппаДоход)
		|		И НЕ Р.СтатьяДвиженияДенежныхСредств.Наименование В (" + Исключения + ")) КАК Д";
		ЗапросКазны.УстановитьПараметр("Начало", НачалоРасчетногоПериода());
		ЗапросКазны.УстановитьПараметр("Конец", МоментРасчета());
		ЗапросКазны.УстановитьПараметр("Корни", Корни);
		ЗапросКазны.УстановитьПараметр("ГруппаДоход",
			СоединениеКазны.Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду("УТ-001053"));
		Выборка = ЗапросКазны.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			УИД = СоединениеКазны.string(Выборка.Ссылка.УникальныйИдентификатор());
			ИмяПодр = Выборка.ПодразделениеИмя;
			Корень = ?(ТипЗнч(ИмяПодр) = Тип("Строка"), КореньПодразделенияКазны(ИмяПодр, Родители), "");
			КорниУИД = КорниДокументов.Получить(УИД);
			Если КорниУИД = Неопределено Тогда
				КорниУИД = Новый Массив;
				КорниДокументов.Вставить(УИД, КорниУИД);
				МассивБух.Добавить(Документы.ПоступлениеНаРасчетныйСчет.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД)));
			КонецЕсли;
			Если КорниУИД.Найти(Корень) = Неопределено Тогда
				КорниУИД.Добавить(Корень);
			КонецЕсли;
		КонецЦикла;
	Исключение
		ДобавитьЗамечание("Предупреждение", "П34",
			"Зворотну звірку оплат з казною не виконано: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ".",
			Неопределено, "Объект.Подразделения");
		Возврат;
	КонецПопытки;
	Если МассивБух.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Об.Регистратор КАК Регистратор,
	|	Об.Субконто2 КАК Договор,
	|	ВЫРАЗИТЬ(Об.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Подразделение КАК Подразделение,
	|	ВЫРАЗИТЬ(Об.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Направление КАК НаправлениеДоговора,
	|	СУММА(Об.СуммаОборотКт) КАК ОборотКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПериода, &ДатаРасчета, Регистратор,
	|		Счет В (&Счета), , , , ) КАК Об
	|ГДЕ
	|	Об.Регистратор В (&Ссылки)
	|
	|СГРУППИРОВАТЬ ПО
	|	Об.Регистратор,
	|	Об.Субконто2,
	|	ВЫРАЗИТЬ(Об.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Подразделение,
	|	ВЫРАЗИТЬ(Об.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Направление";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоРасчетногоПериода());
	Запрос.УстановитьПараметр("ДатаРасчета", МоментРасчета());
	Запрос.УстановитьПараметр("Счета", МассивСчетов());
	Запрос.УстановитьПараметр("Ссылки", МассивБух);
	// Прохід 1: рядки поза звітом і корені казни за договором (договір, який казна відносить до
	// кількох об'єктів, — спільний: перенос договору підняв би E/F об'єкта на весь його обіг).
	РядкиК16 = Новый Массив;
	КорниДоговоров = Новый Соответствие;   // Договір -> Массив коренів
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ОборотКт <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Цель = ЦелевоеПодразделение(Выборка.Договор, Выборка.Подразделение, КартаДоп, НаборПодр);
		НаправлениеСовпадает = НЕ ЗначениеЗаполнено(Направление) ИЛИ Выборка.НаправлениеДоговора = Направление;
		Если Цель <> Неопределено И НаправлениеСовпадает Тогда
			Продолжить;
		КонецЕсли;
		КорниУИД = КорниДокументов.Получить(Строка(Выборка.Регистратор.УникальныйИдентификатор()));
		Если КорниУИД = Неопределено Тогда
			КорниУИД = Новый Массив;
		КонецЕсли;
		КорниДог = КорниДоговоров.Получить(Выборка.Договор);
		Если КорниДог = Неопределено Тогда
			КорниДог = Новый Массив;
			КорниДоговоров.Вставить(Выборка.Договор, КорниДог);
		КонецЕсли;
		Для Каждого Корень Из КорниУИД Цикл
			Если КорниДог.Найти(Корень) = Неопределено Тогда
				КорниДог.Добавить(Корень);
			КонецЕсли;
		КонецЦикла;
		РядкиК16.Добавить(Новый Структура("Регистратор, Договор, Подразделение, НаправлениеДоговора, Сумма, Корни",
			Выборка.Регистратор, Выборка.Договор, Выборка.Подразделение, Выборка.НаправлениеДоговора,
			Выборка.ОборотКт, СтрСоединить(КорниУИД, ", ")));
	КонецЦикла;

	// Прохід 2: замечання з підказкою за класом договору
	Для Каждого Рядок Из РядкиК16 Цикл
		Если КорниДоговоров.Получить(Рядок.Договор).Количество() > 1
			ИЛИ (ЗначениеЗаполнено(Рядок.Подразделение) И ЗначениеЗаполнено(Рядок.НаправлениеДоговора)) Тогда
			Подсказка = "Договір належить іншому об'єкту або кільком об'єктам — перепровести оплату на договір "
				+ "об'єкта (рішення бухгалтерії).";
		ИначеЕсли ЗначениеЗаполнено(Направление) И Рядок.НаправлениеДоговора <> Направление Тогда
			Подсказка = "Заповніть у договорі напрямок «" + Строка(Направление) + "» і підрозділ — тоді акти й "
				+ "оплати зайдуть разом.";
		Иначе
			Подсказка = "Заповніть у договорі підрозділ звіту — тоді акти й оплати зайдуть разом.";
		КонецЕсли;
		ДобавитьЗамечание("Предупреждение", "К16",
			КороткоДокумент(Рядок.Регистратор) + " — " + Формат(Рядок.Сумма, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00")
			+ ": у казні — " + Рядок.Корни + ", у бухгалтерії — договір «" + Строка(Рядок.Договор) + "» ("
			+ ?(ЗначениеЗаполнено(Рядок.Подразделение), Строка(Рядок.Подразделение), "підрозділ не заповнено")
			+ ") поза звітом. " + Подсказка, Неопределено, "Объект.Подразделения");
	КонецЦикла;

	// К03 і К16 перетинаються (договори поза розрахунком) — відсилка з К03
	Если РядкиК16.Количество() > 0 Тогда
		Для Каждого СтрокаКонтроля Из Контроль.НайтиСтроки(Новый Структура("КодЗамечания", "К03")) Цикл
			СтрокаКонтроля.Текст = Лев(СтрокаКонтроля.Текст + " Частину цих договорів казна відносить до "
				+ "об'єктів звіту — див. К16 (там підказка, що робити з кожним).", 1000);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Підрозділи звіту як посилання казни (за найменуванням) — масив НА БОЦІ казни для «В ИЕРАРХИИ».
Функция КорниОтчетаВКазне(СоединениеКазны, НаборПодр)

	Корни = СоединениеКазны.NewObject("Массив");
	Для Каждого ЭлементНабора Из НаборПодр Цикл
		ПодрКазны = СоединениеКазны.Справочники.Подразделения.НайтиПоНаименованию(Строка(ЭлементНабора.Ключ), Истина);
		Если НЕ ПодрКазны.Пустая() Тогда
			Корни.Добавить(ПодрКазны);
		КонецЕсли;
	КонецЦикла;
	Возврат Корни;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Блок «Казна»: план-факт виробництва з бази kazna
////////////////////////////////////////////////////////////////////////////////

// Найменування статей-виключень за замовчуванням. Довідник СтатьиДвиженияДенежныхСредств
// синхронізується обміном між базами (UUID шести статей у BuhBud і kazna збігаються 1:1,
// перевірено 16.08.2026) — у ТЧ зберігаються ССИЛКИ довідника BuhBud.
Функция СтатьиИсключенияКазныПоУмолчанию()

	Статьи = Новый Массив;
	Статьи.Добавить("Поступление от Фин агента");
	Статьи.Добавить("Оплата Фин агентам");
	Статьи.Добавить("Транзит Исх");
	Статьи.Добавить("Транзит Вх");
	Статьи.Добавить("Внутригрупповые затраты");
	Статьи.Добавить("Внутригрупповые доходы");
	Возврат Статьи;

КонецФункции

// Заповнює ТЧ СтатьиИсключенияКазны ссилками довідника за найменуваннями за замовчуванням.
Процедура ЗаполнитьСтатьиИсключенияПоУмолчанию() Экспорт

	Для Каждого ИмяСтатьи Из СтатьиИсключенияКазныПоУмолчанию() Цикл
		СтатьяСсылка = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию(ИмяСтатьи, Истина);
		Если ЗначениеЗаполнено(СтатьяСсылка) Тогда
			СтатьиИсключенияКазны.Добавить().Статья = СтатьяСсылка;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Заповнення ТЧ «Казна» + контролі К12/К13. Збій казни НЕ ронить розрахунок:
// тільки П34-попередження у контролі (паттерн — ЗаполнитьПодразделенияИзКазны).
Процедура ЗаполнитьБлокКазны(СоединениеКазны, КартаДоп, НаборПодр)

	Казна.Очистить();
	Если СоединениеКазны = Неопределено Тогда
		Возврат;  // П34 уже додано в ОткрытьСоединениеКазны
	КонецЕсли;

	Попытка
		ЗагрузитьПланФактКазны(СоединениеКазны);
	Исключение
		ДобавитьЗамечание("Предупреждение", "П34",
			"Блок «Казна» не заповнено: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ ". Фінзвіт розраховано без даних казни.",
			Неопределено, "Объект.Казна");
		Возврат;
	КонецПопытки;

	КонтролиКазны(КартаДоп, НаборПодр);

КонецПроцедуры

// Тягне план-факт виробництва з kazna механікою звіту «План факт» казни:
//   ФАКТ — РН.БДДС.Обороты(початок місяця, кінець дня дати розрахунку), знак за НаправлениеДДС;
//   ПЛАН — РН.БюджетыНаМесяц.Обороты за ВЕСЬ місяць (ВидПериода = МЕСЯЦ).
// Групи статей — як у варіанті «Производство» звіту казни: доходи «Операционная деятельность »
// (код УТ-001053, у найменуванні ХВОСТОВИЙ ПРОБІЛ), витрати «Списание» (код 1В) — тому шукаємо
// ЗА КОДОМ. Відбори: Направление = Производство; Подразделение НЕ у («Главный офис»,
// «Цех металлоконструкций»); найменування статті НЕ у ТЧ СтатьиИсключенияКазны.
// Ієрархію підрозділів казни згортаємо до КОРЕНЯ (вкладені IRC), зіставляємо з довідником
// Подразделения ЗА НАЙМЕНУВАННЯМ (подвійні пробіли значущі). Запити виконуються НА СТОРОНІ
// казни, сюди повертаються лише рядки і числа — COM-обʼєкти не тягнемо.
// Тексти запитів = doc_finrep_kazna_planfakt_prototype.py (Rule #-1: перевірені на живій
// kazna 16.08.2026, еталон «План факт на 14-08-2026.xlsx» зійшовся до копійки).
Процедура ЗагрузитьПланФактКазны(СоединениеКазны)

	НаправлениеКазны = СоединениеКазны.Справочники.Направления.НайтиПоНаименованию("Производство", Истина);
	ГруппаДоход  = СоединениеКазны.Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду("УТ-001053");
	ГруппаРасход = СоединениеКазны.Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду("1В");

	Родители = ИерархияПодразделенийКазны(СоединениеКазны);

	СписокИсключенийПодр = """Главный офис"", ""Цех металлоконструкций""";
	СписокИсключенийСтатей = СписокСтатейИсключенияДляЗапроса();

	// --- ФАКТ: БДДС з початку місяця по кінець дня дати розрахунку
	ЗапросФакта = СоединениеКазны.NewObject("Запрос");
	ЗапросФакта.Текст =
	"ВЫБРАТЬ
	|	БДДСОбороты.Подразделение.Наименование КАК ПодразделениеИмя,
	|	ВЫБОР
	|		КОГДА БДДСОбороты.СтатьяДвиженияДенежныхСредств В ИЕРАРХИИ (&ГруппаДоход)
	|				И БДДСОбороты.НаправлениеДДС = ЗНАЧЕНИЕ(Перечисление.НаправленияДвиженийДенежныхСредств.Приход)
	|			ТОГДА БДДСОбороты.СуммаПриходОборот + БДДСОбороты.СуммаРасходОборот
	|		КОГДА БДДСОбороты.СтатьяДвиженияДенежныхСредств В ИЕРАРХИИ (&ГруппаДоход)
	|				И БДДСОбороты.НаправлениеДДС = ЗНАЧЕНИЕ(Перечисление.НаправленияДвиженийДенежныхСредств.Расход)
	|			ТОГДА -(БДДСОбороты.СуммаПриходОборот + БДДСОбороты.СуммаРасходОборот)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Доход,
	|	ВЫБОР
	|		КОГДА БДДСОбороты.СтатьяДвиженияДенежныхСредств В ИЕРАРХИИ (&ГруппаРасход)
	|			ТОГДА (БДДСОбороты.СуммаПриходОборот + БДДСОбороты.СуммаРасходОборот) * ВЫБОР
	|					КОГДА БДДСОбороты.НаправлениеДДС = ЗНАЧЕНИЕ(Перечисление.НаправленияДвиженийДенежныхСредств.Расход)
	|						ТОГДА -1
	|					ИНАЧЕ 1
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Расход
	|ПОМЕСТИТЬ ВТФакт
	|ИЗ
	|	РегистрНакопления.БДДС.Обороты(&НачалоМесяца, &КонецПериода, , Направление = &Направление) КАК БДДСОбороты
	|ГДЕ
	|	БДДСОбороты.Подразделение.Наименование НЕ В (" + СписокИсключенийПодр + ")
	|	И БДДСОбороты.СтатьяДвиженияДенежныхСредств.Наименование НЕ В (" + СписокИсключенийСтатей + ")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТФакт.ПодразделениеИмя КАК ПодразделениеИмя,
	|	СУММА(ВТФакт.Доход) КАК Доход,
	|	СУММА(ВТФакт.Расход) КАК Расход
	|ИЗ
	|	ВТФакт КАК ВТФакт
	|СГРУППИРОВАТЬ ПО
	|	ВТФакт.ПодразделениеИмя";
	ЗапросФакта.УстановитьПараметр("ГруппаДоход", ГруппаДоход);
	ЗапросФакта.УстановитьПараметр("ГруппаРасход", ГруппаРасход);
	ЗапросФакта.УстановитьПараметр("Направление", НаправлениеКазны);
	ЗапросФакта.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ДатаРасчета));
	ЗапросФакта.УстановитьПараметр("КонецПериода", МоментРасчета());

	Строки = Новый Соответствие;  // імʼя кореня -> акумулятор
	ВыборкаФакта = ЗапросФакта.Выполнить().Выбрать();
	Пока ВыборкаФакта.Следующий() Цикл
		Корень = КореньПодразделенияКазны(ВыборкаФакта.ПодразделениеИмя, Родители);
		Аккумулятор = АккумуляторКазны(Строки, Корень);
		Аккумулятор.ПоступленияФакт = Аккумулятор.ПоступленияФакт + ВыборкаФакта.Доход;
		Аккумулятор.ЗатратыФакт     = Аккумулятор.ЗатратыФакт + ВыборкаФакта.Расход;
	КонецЦикла;

	// --- ПЛАН: бюджети на ВЕСЬ місяць
	ЗапросПлана = СоединениеКазны.NewObject("Запрос");
	ЗапросПлана.Текст =
	"ВЫБРАТЬ
	|	БюджетОбороты.Подразделение.Наименование КАК ПодразделениеИмя,
	|	ВЫБОР
	|		КОГДА БюджетОбороты.ПоказательБюджета В ИЕРАРХИИ (&ГруппаДоход)
	|			ТОГДА БюджетОбороты.СуммаОборот
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПланДоход,
	|	ВЫБОР
	|		КОГДА БюджетОбороты.ПоказательБюджета В ИЕРАРХИИ (&ГруппаРасход)
	|			ТОГДА -БюджетОбороты.СуммаОборот
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПланРасход
	|ПОМЕСТИТЬ ВТПлан
	|ИЗ
	|	РегистрНакопления.БюджетыНаМесяц.Обороты(&НачалоМесяца, &КонецМесяца, ,
	|		ВидПериода = ЗНАЧЕНИЕ(Перечисление.ВидыПериодовБюджетирования.МЕСЯЦ)
	|		И Направление = &Направление) КАК БюджетОбороты
	|ГДЕ
	|	БюджетОбороты.Подразделение.Наименование НЕ В (" + СписокИсключенийПодр + ")
	|	И ЕСТЬNULL(ВЫРАЗИТЬ(БюджетОбороты.ПоказательБюджета КАК Справочник.СтатьиДвиженияДенежныхСредств).Наименование, """") НЕ В (" + СписокИсключенийСтатей + ")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПлан.ПодразделениеИмя КАК ПодразделениеИмя,
	|	СУММА(ВТПлан.ПланДоход) КАК ПланДоход,
	|	СУММА(ВТПлан.ПланРасход) КАК ПланРасход
	|ИЗ
	|	ВТПлан КАК ВТПлан
	|СГРУППИРОВАТЬ ПО
	|	ВТПлан.ПодразделениеИмя";
	ЗапросПлана.УстановитьПараметр("ГруппаДоход", ГруппаДоход);
	ЗапросПлана.УстановитьПараметр("ГруппаРасход", ГруппаРасход);
	ЗапросПлана.УстановитьПараметр("Направление", НаправлениеКазны);
	ЗапросПлана.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ДатаРасчета));
	ЗапросПлана.УстановитьПараметр("КонецМесяца", КонецМесяца(ДатаРасчета));

	ВыборкаПлана = ЗапросПлана.Выполнить().Выбрать();
	Пока ВыборкаПлана.Следующий() Цикл
		Корень = КореньПодразделенияКазны(ВыборкаПлана.ПодразделениеИмя, Родители);
		Аккумулятор = АккумуляторКазны(Строки, Корень);
		Аккумулятор.ПоступленияПлан = Аккумулятор.ПоступленияПлан + ВыборкаПлана.ПланДоход;
		Аккумулятор.ЗатратыПлан     = Аккумулятор.ЗатратыПлан + ВыборкаПлана.ПланРасход;
	КонецЦикла;

	// --- Заповнення ТЧ: за алфавітом, зіставлення підрозділу за найменуванням.
	// При згортці ЖОДНИХ відсотків — у вкладених IRC немає плану («ділення на 0» у казні).
	Имена = Новый СписокЗначений;
	Для Каждого ЭлементСтрок Из Строки Цикл
		Имена.Добавить(ЭлементСтрок.Ключ);
	КонецЦикла;
	Имена.СортироватьПоЗначению();

	НеСопоставлено = "";
	Для Каждого ЭлементИмени Из Имена Цикл
		ИмяКорня = ЭлементИмени.Значение;
		Аккумулятор = Строки.Получить(ИмяКорня);
		СтрокаКазны = Казна.Добавить();
		СтрокаКазны.ИмяВКазне       = Лев(ИмяКорня, 150);
		СтрокаКазны.ПоступленияПлан = Окр(Аккумулятор.ПоступленияПлан, 2);
		СтрокаКазны.ПоступленияФакт = Окр(Аккумулятор.ПоступленияФакт, 2);
		СтрокаКазны.ЗатратыПлан     = Окр(Аккумулятор.ЗатратыПлан, 2);
		СтрокаКазны.ЗатратыФакт     = Окр(Аккумулятор.ЗатратыФакт, 2);
		// затрати відʼємні, тому маржа = надходження + затрати
		СтрокаКазны.МаржаПлан = Окр(Аккумулятор.ПоступленияПлан + Аккумулятор.ЗатратыПлан, 2);
		СтрокаКазны.МаржаФакт = Окр(Аккумулятор.ПоступленияФакт + Аккумулятор.ЗатратыФакт, 2);
		НайденноеПодразделение = Справочники.Подразделения.НайтиПоНаименованию(ИмяКорня, Истина);
		Если ЗначениеЗаполнено(НайденноеПодразделение) Тогда
			СтрокаКазны.Подразделение = НайденноеПодразделение;
		Иначе
			НеСопоставлено = НеСопоставлено + ?(ПустаяСтрока(НеСопоставлено), "", ", ") + ИмяКорня;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ПустаяСтрока(НеСопоставлено) Тогда
		ДобавитьЗамечание("Предупреждение", "П33",
			"Казна: підрозділи не знайдено у довіднику «Підрозділи» (рядки з порожнім підрозділом): "
			+ НеСопоставлено + ". Перевірте найменування (у деяких подвійні пробіли).",
			Неопределено, "Объект.Казна");
	КонецЕсли;

КонецПроцедуры

// Список найменувань статей-виключень для підстановки у текст запиту казни літералами
// (масив рядків через COM-параметр не передається надійно). У ТЧ — ссилки довідника
// BuhBud; у запит казни йдуть їхні НАЙМЕНУВАННЯ (довідники синхронізовані обміном,
// найменування збігаються — надійніше за передачу UUID у чужу базу).
Функция СписокСтатейИсключенияДляЗапроса()

	Список = "";
	Для Каждого СтрокаСтатьи Из СтатьиИсключенияКазны Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаСтатьи.Статья) Тогда
			Продолжить;
		КонецЕсли;
		ИмяСтатьи = СокрЛП(СтрокаСтатьи.Статья.Наименование);
		Если ПустаяСтрока(ИмяСтатьи) Тогда
			Продолжить;
		КонецЕсли;
		Список = Список + ?(ПустаяСтрока(Список), "", ", ")
			+ """" + СтрЗаменить(ИмяСтатьи, """", """""") + """";
	КонецЦикла;
	Если ПустаяСтрока(Список) Тогда
		Список = """""";  // порожня ТЧ: НЕ В ("") нічого не виключає
	КонецЕсли;
	Возврат Список;

КонецФункции

// Ієрархія підрозділів казни: імʼя -> імʼя батька (лише рядки; у кореневих — "").
Функция ИерархияПодразделенийКазны(СоединениеКазны)

	ЗапросИерархии = СоединениеКазны.NewObject("Запрос");
	ЗапросИерархии.Текст =
	"ВЫБРАТЬ
	|	Подр.Наименование КАК Имя,
	|	Подр.Родитель.Наименование КАК РодительИмя
	|ИЗ
	|	Справочник.Подразделения КАК Подр";
	ВыборкаИерархии = ЗапросИерархии.Выполнить().Выбрать();
	Родители = Новый Соответствие;
	Пока ВыборкаИерархии.Следующий() Цикл
		РодительИмя = ВыборкаИерархии.РодительИмя;
		Если ТипЗнч(РодительИмя) <> Тип("Строка") Тогда
			РодительИмя = "";  // у кореневих Родитель порожній — через COM приходить NULL
		КонецЕсли;
		Родители.Вставить(ВыборкаИерархии.Имя, РодительИмя);
	КонецЦикла;
	Возврат Родители;

КонецФункции

// Корінь ієрархії підрозділу казни за картою «імʼя -> імʼя батька».
Функция КореньПодразделенияКазны(ИмяПодразделения, Родители)

	Текущее = ИмяПодразделения;
	Глубина = 0;
	Пока Глубина < 20 Цикл
		РодительИмя = Родители.Получить(Текущее);
		Если РодительИмя = Неопределено ИЛИ ПустаяСтрока(РодительИмя) Тогда
			Прервать;
		КонецЕсли;
		Текущее = РодительИмя;
		Глубина = Глубина + 1;
	КонецЦикла;
	Возврат Текущее;

КонецФункции

Функция АккумуляторКазны(Строки, ИмяКорня)

	Аккумулятор = Строки.Получить(ИмяКорня);
	Если Аккумулятор = Неопределено Тогда
		Аккумулятор = Новый Структура(
			"ПоступленияПлан, ПоступленияФакт, ЗатратыПлан, ЗатратыФакт", 0, 0, 0, 0);
		Строки.Вставить(ИмяКорня, Аккумулятор);
	КонецЕсли;
	Возврат Аккумулятор;

КонецФункции

// К12: підрозділ казни з планом/фактом не світиться у фінзвіті.
// К13: надходження-факт казни ≠ обороту Кт рахунків розрахунків за місяць (допуск 1 грн).
Процедура КонтролиКазны(КартаДоп, НаборПодр)

	Если Казна.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПодразделенияРасчета = Новый Соответствие;
	Для Каждого СтрокаРезультата Из Расчет Цикл
		ПодразделенияРасчета.Вставить(СтрокаРезультата.Подразделение, Истина);
	КонецЦикла;

	ОборотыКт = ОборотыКтПоПодразделениям(КартаДоп, НаборПодр);

	Для Каждого СтрокаКазны Из Казна Цикл

		ЕстьЦифры = СтрокаКазны.ПоступленияФакт <> 0 ИЛИ СтрокаКазны.ЗатратыФакт <> 0
			ИЛИ СтрокаКазны.ПоступленияПлан <> 0 ИЛИ СтрокаКазны.ЗатратыПлан <> 0;

		Если ЕстьЦифры И (НЕ ЗначениеЗаполнено(СтрокаКазны.Подразделение)
			ИЛИ ПодразделенияРасчета.Получить(СтрокаКазны.Подразделение) = Неопределено) Тогда
			ДобавитьЗамечание("Предупреждение", "К12",
				"Казна: «" + СтрокаКазны.ИмяВКазне + "» має план/факт (надходження факт "
				+ Формат(СтрокаКазны.ПоступленияФакт, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + ", затрати факт "
				+ Формат(СтрокаКазны.ЗатратыФакт, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00")
				+ "), але у фінзвіті цей підрозділ не світиться.",
				СтрокаКазны.Подразделение, "Объект.Казна");
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаКазны.Подразделение) Тогда
			ОборотКт = ОборотыКт.Получить(СтрокаКазны.Подразделение);
			Если ОборотКт = Неопределено Тогда
				ОборотКт = 0;
			КонецЕсли;
			Разница = Окр(СтрокаКазны.ПоступленияФакт - ОборотКт, 2);
			Если Разница > 1 ИЛИ Разница < -1 Тогда
				ДобавитьЗамечание("Предупреждение", "К13",
					Строка(СтрокаКазны.Подразделение) + ": надходження-факт казни "
					+ Формат(СтрокаКазны.ПоступленияФакт, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00")
					+ " не дорівнює обороту Кт рахунків розрахунків за місяць "
					+ Формат(ОборотКт, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + ". Різниця "
					+ Формат(Разница, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + ".",
					СтрокаКазны.Подразделение, "Объект.Казна");
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Оборот Кт рахунків розрахунків за місяць (початок місяця — кінець дня дати розрахунку)
// у розрізі ЦІЛЬОВОГО підрозділу договору: договір, перенесений вручну або за казною,
// рахується там, де він у звіті (тоді К13 не дублює К14); договори поза звітом — за власним
// підрозділом, як раніше. Тексти: doc_finrep_kt361_prototype.py (16.08) і
// doc_finrep_kazna_oplaty_prototype.py (28.09, групування за договором).
Функция ОборотыКтПоПодразделениям(КартаДоп, НаборПодр)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Об.Субконто2 КАК Договор,
	|	ВЫРАЗИТЬ(Об.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Подразделение КАК Подразделение,
	|	СУММА(Об.СуммаОборотКт) КАК ОборотКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоМесяца, &КонецПериода, ,
	|		Счет В (&Счета), , , , ) КАК Об
	|ГДЕ
	|	(&БезФильтраНаправления
	|		ИЛИ ВЫРАЗИТЬ(Об.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Направление = &Направление)
	|
	|СГРУППИРОВАТЬ ПО
	|	Об.Субконто2,
	|	ВЫРАЗИТЬ(Об.Субконто2 КАК Справочник.ДоговорыКонтрагентов).Подразделение";
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ДатаРасчета));
	Запрос.УстановитьПараметр("КонецПериода", МоментРасчета());
	Запрос.УстановитьПараметр("Счета", МассивСчетов());
	УстановитьПараметрыНаправления(Запрос);

	Карта = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Цель = ЦелевоеПодразделение(Выборка.Договор, Выборка.Подразделение, КартаДоп, НаборПодр);
		Если Цель = Неопределено Тогда
			Цель = Выборка.Подразделение;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Цель) Тогда
			Продолжить;
		КонецЕсли;
		Накоплено = Карта.Получить(Цель);
		Карта.Вставить(Цель, ?(Накоплено = Неопределено, 0, Накоплено) + Выборка.ОборотКт);
	КонецЦикла;
	Возврат Карта;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Динаміка до попереднього звіту
////////////////////////////////////////////////////////////////////////////////

// Останній записаний непозначений документ того ж напрямку з меншою датою розрахунку.
// Текст = doc_finrep_docsravn_precheck.py (Rule #-1: для № 2 підбирає № 1 на живій базі).
Функция ПодобратьДокументСравнения()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Д.Ссылка КАК ДокументПрошлый
	|ИЗ
	|	Документ.А_ФинансовыйОтчетПроизводства КАК Д
	|ГДЕ
	|	НЕ Д.ПометкаУдаления
	|	И Д.Направление = &Направление
	|	И Д.ДатаРасчета < &ДатаРасчета
	|	И Д.Ссылка <> &ТекущийДокумент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Д.ДатаРасчета УБЫВ";
	Запрос.УстановитьПараметр("Направление", Направление);
	Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
	Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДокументПрошлый;
	КонецЕсли;
	Возврат Документы.А_ФинансовыйОтчетПроизводства.ПустаяСсылка();

КонецФункции

// Дані динаміки: підрозділи (було/стало/зміна E/F/H/K), договори з ненульовою зміною,
// нові та зниклі документи (ключ Договір+Документ). Минулий документ читається ЗАПИСАНИМ.
// Повертає Неопределено, якщо документа порівняння немає.
Функция ДанныеДинамики()

	Если НЕ ЗначениеЗаполнено(ДокументСравнения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПрошлыйОбъект = ДокументСравнения.ПолучитьОбъект();
	Если ПрошлыйОбъект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	СводБыло  = СводПоказателейПодразделений(ПрошлыйОбъект.Расчет);
	СводСтало = СводПоказателейПодразделений(Расчет);

	// НЕ «Подразделения» — так називається таблична частина документа, локальна змінна
	// з цим імʼям у модулі обʼєкта дає «Поле объекта недоступно для записи».
	ТаблицаПодразделений = Новый ТаблицаЗначений;
	ТаблицаПодразделений.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Для Каждого ИмяКолонки Из СтрРазделить(
		"ВыполненоБыло,ВыполненоСтало,ОплаченоБыло,ОплаченоСтало,АктыБыло,АктыСтало,"
		+ "ИтогоБыло,ИтогоСтало,Активность", ",") Цикл
		ТаблицаПодразделений.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Число"));
	КонецЦикла;

	ВсеИмена = Новый Соответствие;
	Для Каждого ЭлементСвода Из СводБыло Цикл
		ВсеИмена.Вставить(ЭлементСвода.Ключ, Истина);
	КонецЦикла;
	Для Каждого ЭлементСвода Из СводСтало Цикл
		ВсеИмена.Вставить(ЭлементСвода.Ключ, Истина);
	КонецЦикла;

	ПустойПоказатель = Новый Структура("Выполнено, Оплачено, Акты, Итого", 0, 0, 0, 0);
	ИтогоБыло  = Новый Структура("Выполнено, Оплачено, Акты, Итого", 0, 0, 0, 0);
	ИтогоСтало = Новый Структура("Выполнено, Оплачено, Акты, Итого", 0, 0, 0, 0);

	Для Каждого ЭлементИмени Из ВсеИмена Цикл
		Было = СводБыло.Получить(ЭлементИмени.Ключ);
		Если Было = Неопределено Тогда
			Было = ПустойПоказатель;
		КонецЕсли;
		Стало = СводСтало.Получить(ЭлементИмени.Ключ);
		Если Стало = Неопределено Тогда
			Стало = ПустойПоказатель;
		КонецЕсли;

		СтрокаПодр = ТаблицаПодразделений.Добавить();
		СтрокаПодр.Имя = ЭлементИмени.Ключ;
		СтрокаПодр.ВыполненоБыло  = Было.Выполнено;
		СтрокаПодр.ВыполненоСтало = Стало.Выполнено;
		СтрокаПодр.ОплаченоБыло   = Было.Оплачено;
		СтрокаПодр.ОплаченоСтало  = Стало.Оплачено;
		СтрокаПодр.АктыБыло       = Было.Акты;
		СтрокаПодр.АктыСтало      = Стало.Акты;
		СтрокаПодр.ИтогоБыло      = Было.Итого;
		СтрокаПодр.ИтогоСтало     = Стало.Итого;
		// поліпшення зверху: сумарна активність тижня (виконання + оплати + акти)
		СтрокаПодр.Активность = (Стало.Выполнено - Было.Выполнено)
			+ (Стало.Оплачено - Было.Оплачено) + (Стало.Акты - Было.Акты);

		ИтогоБыло.Выполнено = ИтогоБыло.Выполнено + Было.Выполнено;
		ИтогоБыло.Оплачено  = ИтогоБыло.Оплачено + Было.Оплачено;
		ИтогоБыло.Акты      = ИтогоБыло.Акты + Было.Акты;
		ИтогоБыло.Итого     = ИтогоБыло.Итого + Было.Итого;
		ИтогоСтало.Выполнено = ИтогоСтало.Выполнено + Стало.Выполнено;
		ИтогоСтало.Оплачено  = ИтогоСтало.Оплачено + Стало.Оплачено;
		ИтогоСтало.Акты      = ИтогоСтало.Акты + Стало.Акты;
		ИтогоСтало.Итого     = ИтогоСтало.Итого + Стало.Итого;
	КонецЦикла;
	ТаблицаПодразделений.Сортировать("Активность Убыв, Имя");

	// Договори зі зміною хоч одного показника
	ДоговорыБыло  = СводПоказателейДоговоров(ПрошлыйОбъект.Расчет);
	ДоговорыСтало = СводПоказателейДоговоров(Расчет);

	Договоры = Новый ТаблицаЗначений;
	Договоры.Колонки.Добавить("ИмяПодразделения", Новый ОписаниеТипов("Строка"));
	Договоры.Колонки.Добавить("Заголовок", Новый ОписаниеТипов("Строка"));
	Договоры.Колонки.Добавить("Показатель", Новый ОписаниеТипов("Строка"));
	Договоры.Колонки.Добавить("Было", Новый ОписаниеТипов("Число"));
	Договоры.Колонки.Добавить("Стало", Новый ОписаниеТипов("Число"));

	ВсеКлючиДоговоров = Новый Соответствие;
	Для Каждого ЭлементСвода Из ДоговорыБыло Цикл
		ВсеКлючиДоговоров.Вставить(ЭлементСвода.Ключ, Истина);
	КонецЦикла;
	Для Каждого ЭлементСвода Из ДоговорыСтало Цикл
		ВсеКлючиДоговоров.Вставить(ЭлементСвода.Ключ, Истина);
	КонецЦикла;

	ИменаПоказателей = Новый Структура(
		"Выполнено, Оплачено, Акты, Итого",
		"Виконано (E)", "Оплачено (F)", "Акти подані (H)", "Разом до отримання (K)");

	Для Каждого ЭлементКлюча Из ВсеКлючиДоговоров Цикл
		Было = ДоговорыБыло.Получить(ЭлементКлюча.Ключ);
		Стало = ДоговорыСтало.Получить(ЭлементКлюча.Ключ);
		Описание = ?(Стало <> Неопределено, Стало, Было);
		Для Каждого ЭлементПоказателя Из ИменаПоказателей Цикл
			ЗначениеБыло  = ?(Было = Неопределено, 0, Было[ЭлементПоказателя.Ключ]);
			ЗначениеСтало = ?(Стало = Неопределено, 0, Стало[ЭлементПоказателя.Ключ]);
			Если ЕстьЗаметнаяРазница(ЗначениеБыло, ЗначениеСтало) Тогда
				СтрокаДог = Договоры.Добавить();
				СтрокаДог.ИмяПодразделения = Описание.ИмяПодразделения;
				СтрокаДог.Заголовок  = Описание.Заголовок;
				СтрокаДог.Показатель = ЭлементПоказателя.Значение;
				СтрокаДог.Было  = ЗначениеБыло;
				СтрокаДог.Стало = ЗначениеСтало;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Договоры.Сортировать("ИмяПодразделения, Заголовок, Показатель");

	// Нові та зниклі документи (ключ Договір+Документ)
	КлючиБыло = Новый Соответствие;
	Для Каждого СтрокаРасш Из ПрошлыйОбъект.РасшифровкаДокументов Цикл
		КлючиБыло.Вставить(КлючСобытияДинамики(СтрокаРасш), Истина);
	КонецЦикла;
	КлючиСтало = Новый Соответствие;
	Для Каждого СтрокаРасш Из РасшифровкаДокументов Цикл
		КлючиСтало.Вставить(КлючСобытияДинамики(СтрокаРасш), Истина);
	КонецЦикла;

	Новые = НоваяТаблицаСобытийДинамики();
	Для Каждого СтрокаРасш Из РасшифровкаДокументов Цикл
		Если КлючиБыло.Получить(КлючСобытияДинамики(СтрокаРасш)) = Неопределено Тогда
			ДобавитьСобытиеДинамики(Новые, СтрокаРасш);
		КонецЕсли;
	КонецЦикла;
	Новые.Сортировать("ИмяПодразделения, Дата, ИмяДокумента");

	Ушедшие = НоваяТаблицаСобытийДинамики();
	Для Каждого СтрокаРасш Из ПрошлыйОбъект.РасшифровкаДокументов Цикл
		Если КлючиСтало.Получить(КлючСобытияДинамики(СтрокаРасш)) = Неопределено Тогда
			ДобавитьСобытиеДинамики(Ушедшие, СтрокаРасш);
		КонецЕсли;
	КонецЦикла;
	Ушедшие.Сортировать("ИмяПодразделения, Дата, ИмяДокумента");

	Данные = Новый Структура;
	Данные.Вставить("ДатаБыло", ПрошлыйОбъект.ДатаРасчета);
	Данные.Вставить("Подразделения", ТаблицаПодразделений);
	Данные.Вставить("Договоры", Договоры);
	Данные.Вставить("Новые", Новые);
	Данные.Вставить("Ушедшие", Ушедшие);
	Данные.Вставить("ИтогоВыполненоБыло", ИтогоБыло.Выполнено);
	Данные.Вставить("ИтогоВыполненоСтало", ИтогоСтало.Выполнено);
	Данные.Вставить("ИтогоОплаченоБыло", ИтогоБыло.Оплачено);
	Данные.Вставить("ИтогоОплаченоСтало", ИтогоСтало.Оплачено);
	Данные.Вставить("ИтогоАктыБыло", ИтогоБыло.Акты);
	Данные.Вставить("ИтогоАктыСтало", ИтогоСтало.Акты);
	Данные.Вставить("ИтогоКБыло", ИтогоБыло.Итого);
	Данные.Вставить("ИтогоКСтало", ИтогоСтало.Итого);
	Возврат Данные;

КонецФункции

// Звід E/F/H/K табличної частини «Расчет» за підрозділами: імʼя -> структура.
Функция СводПоказателейПодразделений(ТЧРасчет)

	Свод = ТЧРасчет.Выгрузить(, "Подразделение, ВыполненныеРаботы, Оплачено, АктыПоданные,"
		+ " ИтогоКПолучению");
	Свод.Свернуть("Подразделение", "ВыполненныеРаботы, Оплачено, АктыПоданные, ИтогоКПолучению");

	Карта = Новый Соответствие;
	Для Каждого СтрокаСвода Из Свод Цикл
		Карта.Вставить(Строка(СтрокаСвода.Подразделение), Новый Структура(
			"Выполнено, Оплачено, Акты, Итого",
			СтрокаСвода.ВыполненныеРаботы, СтрокаСвода.Оплачено,
			СтрокаСвода.АктыПоданные, СтрокаСвода.ИтогоКПолучению));
	КонецЦикла;
	Возврат Карта;

КонецФункции

// Показники рядків-договорів: УІД договору -> структура з іменами і сумами.
Функция СводПоказателейДоговоров(ТЧРасчет)

	Карта = Новый Соответствие;
	Для Каждого СтрокаРасчета Из ТЧРасчет Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаРасчета.Договор) Тогда
			Продолжить;
		КонецЕсли;
		Карта.Вставить(Строка(СтрокаРасчета.Договор.УникальныйИдентификатор()), Новый Структура(
			"ИмяПодразделения, Заголовок, Выполнено, Оплачено, Акты, Итого",
			Строка(СтрокаРасчета.Подразделение),
			Строка(СтрокаРасчета.Контрагент) + " · " + Строка(СтрокаРасчета.Договор),
			СтрокаРасчета.ВыполненныеРаботы, СтрокаРасчета.Оплачено,
			СтрокаРасчета.АктыПоданные, СтрокаРасчета.ИтогоКПолучению));
	КонецЦикла;
	Возврат Карта;

КонецФункции

Функция НоваяТаблицаСобытийДинамики()

	События = Новый ТаблицаЗначений;
	События.Колонки.Добавить("ИмяПодразделения", Новый ОписаниеТипов("Строка"));
	События.Колонки.Добавить("Дата");
	События.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка"));
	События.Колонки.Добавить("ИмяДокумента", Новый ОписаниеТипов("Строка"));
	События.Колонки.Добавить("Документ");
	События.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	События.Колонки.Добавить("Проведен", Новый ОписаниеТипов("Булево"));
	Возврат События;

КонецФункции

Процедура ДобавитьСобытиеДинамики(События, СтрокаРасш)

	СтрокаСобытия = События.Добавить();
	СтрокаСобытия.ИмяПодразделения = Строка(СтрокаРасш.Подразделение);
	СтрокаСобытия.Дата         = СтрокаРасш.ДатаДокумента;
	СтрокаСобытия.Вид          = СтрокаРасш.Вид;
	СтрокаСобытия.ИмяДокумента = Строка(СтрокаРасш.Документ);
	СтрокаСобытия.Документ     = СтрокаРасш.Документ;
	СтрокаСобытия.Сумма = ?(СтрокаРасш.Вид = "Оплата", СтрокаРасш.СуммаКт, СтрокаРасш.СуммаДт);
	СтрокаСобытия.Проведен = СтрокаРасш.ДокументПроведен;

КонецПроцедуры

Функция КлючСобытияДинамики(СтрокаРасш)

	КлючДоговора = "-";
	Если ЗначениеЗаполнено(СтрокаРасш.Договор) Тогда
		КлючДоговора = Строка(СтрокаРасш.Договор.УникальныйИдентификатор());
	КонецЕсли;
	КлючДокумента = "-";
	Если ЗначениеЗаполнено(СтрокаРасш.Документ) Тогда
		КлючДокумента = Строка(СтрокаРасш.Документ.УникальныйИдентификатор());
	КонецЕсли;
	Возврат КлючДоговора + "|" + КлючДокумента;

КонецФункции

Функция ЕстьЗаметнаяРазница(Было, Стало)

	Разница = Стало - Было;
	Возврат Разница > 0.005 ИЛИ Разница < -0.005;

КонецФункции

// Абзац обʼєкта для HTML-доповіді: суми тижня у тис. грн (регламент: у тексті — тисячі).
Функция АбзацОбъектаДинамики(СтрокаПодр)

	Части = Новый Массив;
	Если ЕстьЗаметнаяРазница(СтрокаПодр.ВыполненоБыло, СтрокаПодр.ВыполненоСтало) Тогда
		Части.Добавить("виконано робіт на "
			+ ТысГрн(СтрокаПодр.ВыполненоСтало - СтрокаПодр.ВыполненоБыло));
	КонецЕсли;
	Если ЕстьЗаметнаяРазница(СтрокаПодр.ОплаченоБыло, СтрокаПодр.ОплаченоСтало) Тогда
		Части.Добавить("оплачено " + ТысГрн(СтрокаПодр.ОплаченоСтало - СтрокаПодр.ОплаченоБыло));
	КонецЕсли;
	Если ЕстьЗаметнаяРазница(СтрокаПодр.АктыБыло, СтрокаПодр.АктыСтало) Тогда
		Части.Добавить("подано актів на " + ТысГрн(СтрокаПодр.АктыСтало - СтрокаПодр.АктыБыло));
	КонецЕсли;

	Если Части.Количество() = 0 Тогда
		Абзац = "Рухів за рахунками розрахунків за тиждень не було, але склад документів змінився.";
	Иначе
		Абзац = "За тиждень " + СтрСоединить(Части, ", ") + ".";
	КонецЕсли;

	Абзац = Абзац + " Разом до отримання — "
		+ Формат(СтрокаПодр.ИтогоСтало, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн";
	Если ЕстьЗаметнаяРазница(СтрокаПодр.ИтогоБыло, СтрокаПодр.ИтогоСтало) Тогда
		ИзменениеИтога = СтрокаПодр.ИтогоСтало - СтрокаПодр.ИтогоБыло;
		// функції Абс у мові немає — модуль через ?()
		МодульИзменения = ?(ИзменениеИтога > 0, ИзменениеИтога, -ИзменениеИтога);
		Абзац = Абзац + " (" + ?(ИзменениеИтога > 0, "+", "−")
			+ ТысГрн(МодульИзменения) + " за тиждень)";
	КонецЕсли;
	Возврат Абзац + ".";

КонецФункции

// Фрази-висновки: факти без оцінок, суми тижня у тис. грн.
Функция МассивФразДинамики(Данные)

	Фразы = Новый Массив;

	ИзменениеВыполнено = Данные.ИтогоВыполненоСтало - Данные.ИтогоВыполненоБыло;
	ИзменениеОплачено  = Данные.ИтогоОплаченоСтало - Данные.ИтогоОплаченоБыло;
	ИзменениеАкты      = Данные.ИтогоАктыСтало - Данные.ИтогоАктыБыло;
	ИзменениеИтого     = Данные.ИтогоКСтало - Данные.ИтогоКБыло;

	Фразы.Добавить("За тиждень " + Формат(Данные.ДатаБыло, "ДФ=dd.MM.yyyy") + " → "
		+ Формат(ДатаРасчета, "ДФ=dd.MM.yyyy") + " по напрямку виконано робіт на "
		+ ТысГрн(ИзменениеВыполнено) + ", оплачено " + ТысГрн(ИзменениеОплачено)
		+ ", подано актів на " + ТысГрн(ИзменениеАкты) + ".");

	Если ИзменениеИтого > 0.005 Тогда
		Фразы.Добавить("Тобто разом до отримання зросло на " + ТысГрн(ИзменениеИтого) + ": з "
			+ Формат(Данные.ИтогоКБыло, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " до "
			+ Формат(Данные.ИтогоКСтало, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн.");
	ИначеЕсли ИзменениеИтого < -0.005 Тогда
		Фразы.Добавить("Тобто разом до отримання зменшилось на " + ТысГрн(-ИзменениеИтого) + ": з "
			+ Формат(Данные.ИтогоКБыло, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " до "
			+ Формат(Данные.ИтогоКСтало, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн.");
	Иначе
		Фразы.Добавить("Разом до отримання не змінилось: "
			+ Формат(Данные.ИтогоКСтало, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " грн.");
	КонецЕсли;

	ФразаДокументов = "Нових документів за тиждень: " + Данные.Новые.Количество();
	Если Данные.Ушедшие.Количество() > 0 Тогда
		ФразаДокументов = ФразаДокументов + "; зникло з розрахунку: " + Данные.Ушедшие.Количество();
	КонецЕсли;
	Фразы.Добавить(ФразаДокументов + ".");

	Возврат Фразы;

КонецФункции

Функция ТысГрн(Значение)

	Возврат Формат(Значение / 1000, "ЧДЦ=1; ЧРГ=' '; ЧН=0") + " тис. грн";

КонецФункции

Функция СтрокаТаблицыHTMLДинамики(ИмяПоказателя, Было, Стало)

	Возврат "<tr><td>" + ИмяПоказателя + "</td><td class=""n"">" + ЧислоДляHTML(Было)
		+ "</td><td class=""n"">" + ЧислоДляHTML(Стало)
		+ "</td><td class=""n"">" + ЧислоДляHTML(Стало - Было) + "</td></tr>";

КонецФункции

// --- Потоковий друк «Динаміки»: 5 колонок, ширини ВСІХ буферів ідентичні (§16а LESSONS).

Функция ШириныКолонокДинамики()

	Ширины = Новый Массив;
	Ширины.Добавить(42);
	Ширины.Добавить(46);
	Ширины.Добавить(16);
	Ширины.Добавить(16);
	Ширины.Добавить(16);
	Возврат Ширины;

КонецФункции

// Буфер-табдок динаміки; СтрокаШирин — НЕобʼєднаний рядок, на якому стоять ширини.
Функция НовыйБуферДинамики(СтрокаШирин = 1)

	Буфер = Новый ТабличныйДокумент;
	Ширины = ШириныКолонокДинамики();
	Для Индекс = 0 По Ширины.ВГраница() Цикл
		Буфер.Область(СтрокаШирин, Индекс + 1, СтрокаШирин, Индекс + 1).ШиринаКолонки = Ширины[Индекс];
	КонецЦикла;
	Возврат Буфер;

КонецФункции

Процедура ВывестиСтрокуДинамики(ТабДок, Значения, Жирный, ЦветФона, Уровень,
	ЗначениеРасшифровки = Неопределено, МелкийШрифт = Ложь, ЦветТекстаСтроки = Неопределено)

	Буфер = НовыйБуферДинамики();
	ВывестиСтрокуОтчета(Буфер, 1, Значения, Жирный, ЦветФона);
	Если ЗначениеРасшифровки <> Неопределено Тогда
		Буфер.Область(1, 1, 1, 1).Расшифровка = ЗначениеРасшифровки;
	КонецЕсли;
	Если МелкийШрифт Тогда
		Буфер.Область(1, 1, 1, Значения.ВГраница() + 1).Шрифт = Новый Шрифт(, 8);
	КонецЕсли;
	Если ЦветТекстаСтроки <> Неопределено Тогда
		Буфер.Область(1, 1, 1, Значения.ВГраница() + 1).ЦветТекста = ЦветТекстаСтроки;
	КонецЕсли;

	Если Уровень = 0 Тогда
		ТабДок.Вывести(Буфер);
	Иначе
		ТабДок.Вывести(Буфер, Уровень, , Истина);
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиПоказательДинамики(ТабДок, ИмяПоказателя, Было, Стало)

	Значения = МассивКолонокДинамики("    " + ИмяПоказателя);
	Значения[2] = Было;
	Значения[3] = Стало;
	Значения[4] = Стало - Было;
	ВывестиСтрокуДинамики(ТабДок, Значения, Ложь, Неопределено, 2);

КонецПроцедуры

// Фраза на весь рядок: текст обʼєднаний (1..5), ширини — на НЕобʼєднаному рядку 2.
Процедура ВывестиФразуДинамики(ТабДок, ТекстФразы)

	Буфер = НовыйБуферДинамики(2);
	Обл = Буфер.Область(1, 1, 1, 5);
	Обл.Объединить();
	Обл.Текст = ТекстФразы;
	Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
	ТабДок.Вывести(Буфер);

КонецПроцедуры

