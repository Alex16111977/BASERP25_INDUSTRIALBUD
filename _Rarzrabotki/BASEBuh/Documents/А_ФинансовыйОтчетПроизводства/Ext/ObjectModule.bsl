КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Вивантаження в Excel: модель аркуша (запис xlsx — ДвоичныеДанныеКнигиExcel у модулі менеджера)
////////////////////////////////////////////////////////////////////////////////

// Аркуш як директорський «Финансовый_отчет Производства»: рядки 1–3 приховані, шапка 4–5,
// далі блоки підрозділів (порядок ТЧ «Підрозділи»): об'єкт → сума → договори (рівень 1) →
// «Итого» → порожній рядок. G/I/J/K і підсумки — формули з кешем значень документа.
// Стилі — індекси cellXfs з ТекстСтилейКниги (модуль менеджера).
Функция МодельКнигиExcel(СРасшифровкой = Ложь)

	Модель = Новый Структура;
	Модель.Вставить("ИмяЛиста", Формат(ДатаРасчета, "ДФ=dd.MM.yyyy"));
	Модель.Вставить("Ширины", СтрРазделить("42.16,34.5,18.5,18.5,18.5,18.5,20.33,18.5,18.5,18.5,18.5"
		+ ?(СРасшифровкой, ",40,28", ""), ","));
	Модель.Вставить("СРасшифровкой", СРасшифровкой);
	// з розшифровкою кнопка групування — біля рядка-підсумку НАД групою (рядок суми блоку, рядок договору)
	Модель.Вставить("ИтогиСверху", СРасшифровкой);
	Модель.Вставить("Строки", Новый Массив);
	Модель.Вставить("Объединения", Новый Массив);
	Модель.Вставить("Примечания", Новый Массив);

	Для Счетчик = 1 По 3 Цикл
		ДобавитьСтрокуМодели(Модель, Новый Массив, 0, Истина);
	КонецЦикла;
	ДобавитьШапкуМодели(Модель);
	ДобавитьСтрокуМодели(Модель, Новый Массив, 12.95);

	КартаПараметров = ПараметрыДоговоровРасчета();
	ТаблицаПН = ДанныеПНДоговоров(Расчет.ВыгрузитьКолонку("Договор"));
	Для Каждого СтрокаПодр Из ВключенныеПодразделения() Цикл
		Договоры = Новый Массив;
		Для Каждого СтрокаРасчета Из Расчет.НайтиСтроки(Новый Структура("Подразделение", СтрокаПодр.Подразделение)) Цикл
			Если ЗначениеЗаполнено(СтрокаРасчета.Договор) Тогда
				Договоры.Добавить(СтрокаРасчета);
			КонецЕсли;
		КонецЦикла;
		// блок виводиться і без договорів: підрозділ у план-факті казни або всі договори закриті
		ДобавитьБлокМодели(Модель, СтрокаПодр.Подразделение, Договоры, КартаПараметров, ТаблицаПН);
	КонецЦикла;

	Возврат Модель;

КонецФункции

Процедура ДобавитьШапкуМодели(Модель)

	Тексты4 = СтрРазделить("Контрагент|Примечание|Сумма утвержденного соглашения|Сумма ДЦ поданной на рассмотрение|"
		+ "Фактические данные на дату составления отчета|||Поданные акты на рассмотрении|Гарантийные платежи|"
		+ "Сумма незарегестрированного НДС по проведенным актам|ИТОГО сумма к получению", "|", Истина);
	Тексты5 = СтрРазделить("Договор||||Выполненные работы грн.|Оплачено грн.|Задолженность, грн. (аванс-)|"
		+ "Акты поданные на Заказчика|||", "|", Истина);
	Ячейки4 = Новый Массив;
	Ячейки5 = Новый Массив;
	Для Колонка = 1 По 11 Цикл
		Ячейки4.Добавить(ЯчейкаМодели(Колонка, Тексты4[Колонка - 1], ?(Колонка >= 9, 2, 1)));
		Ячейки5.Добавить(ЯчейкаМодели(Колонка, Тексты5[Колонка - 1], ?(Колонка = 7, 3, ?(Колонка >= 5, 2, 1))));
	КонецЦикла;
	Если Модель.СРасшифровкой Тогда
		Ячейки4.Добавить(ЯчейкаМодели(12, "ПН / регистрация в ЕРПН", 2));
		Ячейки4.Добавить(ЯчейкаМодели(13, "Срок оплаты", 2));
		Ячейки5.Добавить(ЯчейкаМодели(12, "", 2));
		Ячейки5.Добавить(ЯчейкаМодели(13, "", 2));
		Модель.Объединения.Добавить("L4:L5");
		Модель.Объединения.Добавить("M4:M5");
	КонецЕсли;
	ДобавитьСтрокуМодели(Модель, Ячейки4, 32.45);
	НомерСтроки = ДобавитьСтрокуМодели(Модель, Ячейки5, 24);
	Для Каждого Диапазон Из СтрРазделить("B4:B5,C4:C5,D4:D5,E4:G4,I4:I5,J4:J5,K4:K5", ",") Цикл
		Модель.Объединения.Добавить(Диапазон);
	КонецЦикла;
	ДобавитьПримечаниеМодели(Модель, НомерСтроки, 5, "Дт 361 в 1С Бух: акты с отметкой «Оригинал»");
	ДобавитьПримечаниеМодели(Модель, НомерСтроки, 6, "Кт 361 в 1С Бух");
	ДобавитьПримечаниеМодели(Модель, НомерСтроки, 8, "Дт 361 в 1С Бух без отметки «Оригинал» + непроведённые акты");

КонецПроцедуры

Процедура ДобавитьБлокМодели(Модель, Подразделение, Договоры, КартаПараметров, ТаблицаПН)

	Колонки = СтрРазделить("C,D,E,F,G,H,I,J,K", ",");
	СРасшифровкой = Модель.СРасшифровкой;
	НомерОбъекта = Модель.Строки.Количество() + 1;
	НомерСуммы = НомерОбъекта + 1;
	ПервыйДоговор = НомерОбъекта + 2;

	// документи договорів (лише для варіанта з розшифровкою) — наперед, щоб знати номери рядків
	ДокументыДоговоров = Новый Массив;
	ВсегоДокументов = 0;
	Для Каждого СтрокаРасчета Из Договоры Цикл
		Если СРасшифровкой Тогда
			ДокументыДоговора = РасшифровкаДокументов.Выгрузить(Новый Структура("Подразделение, Договор",
				СтрокаРасчета.Подразделение, СтрокаРасчета.Договор));
			ДокументыДоговора.Сортировать("ДатаДокумента");
		Иначе
			ДокументыДоговора = Неопределено;
		КонецЕсли;
		ДокументыДоговоров.Добавить(ДокументыДоговора);
		ВсегоДокументов = ВсегоДокументов + ?(ДокументыДоговора = Неопределено, 0, ДокументыДоговора.Количество());
	КонецЦикла;
	ПоследняяСтрокаБлока = ПервыйДоговор + Договоры.Количество() + ВсегоДокументов - 1;
	НомерИтого = ПоследняяСтрокаБлока + 1;

	Суммы = Новый Соответствие;
	Для Каждого Колонка Из Колонки Цикл
		Суммы.Вставить(Колонка, 0);
	КонецЦикла;
	Для Каждого СтрокаРасчета Из Договоры Цикл
		Для Каждого Колонка Из Колонки Цикл
			Суммы.Вставить(Колонка, Суммы.Получить(Колонка) + ЗначениеКолонкиРасчета(СтрокаРасчета, Колонка));
		КонецЦикла;
	КонецЦикла;

	// об'єкт і рядок суми. З розшифровкою сума блоку — SUBTOTAL: пропускає SUBTOTAL-и договорів і бере
	// їхні документи, а договори без документів — значенням (подвійного рахунку немає).
	ЯчейкиОбъекта = Новый Массив;
	ЯчейкиОбъекта.Добавить(ЯчейкаМодели(1, ПодписьБлока(Подразделение, Договоры), 4));
	ЯчейкиОбъекта.Добавить(ЯчейкаМодели(2, "", 4));
	ЯчейкиСуммы = Новый Массив;
	ЯчейкиСуммы.Добавить(ЯчейкаМодели(1, "", 6));
	ЯчейкиСуммы.Добавить(ЯчейкаМодели(2, "", 6));
	ЯчейкиИтого = Новый Массив;
	ЯчейкиИтого.Добавить(ЯчейкаМодели(1, "Итого", 10));
	ЯчейкиИтого.Добавить(ЯчейкаМодели(2, "", 10));
	Для Каждого Колонка Из Колонки Цикл
		НомерКолонки = СтрНайти("ABCDEFGHIJK", Колонка);
		Диапазон = АдресЯчейки(Колонка, ПервыйДоговор) + ":" + АдресЯчейки(Колонка, ПоследняяСтрокаБлока);
		ЯчейкиОбъекта.Добавить(ЯчейкаМодели(НомерКолонки, Суммы.Получить(Колонка), 5, АдресЯчейки(Колонка, НомерСуммы)));
		ЯчейкиСуммы.Добавить(ЯчейкаМодели(НомерКолонки, Суммы.Получить(Колонка), 7,
			?(Договоры.Количество() = 0, "0", ?(СРасшифровкой, "SUBTOTAL(9," + Диапазон + ")", "SUM(" + Диапазон + ")"))));
		ФормулаИтого = ?(Колонка = "G", АдресЯчейки("E", НомерИтого) + "-" + АдресЯчейки("F", НомерИтого),
			АдресЯчейки(Колонка, НомерОбъекта));
		ЯчейкиИтого.Добавить(ЯчейкаМодели(НомерКолонки, Суммы.Получить(Колонка), 11, ФормулаИтого));
	КонецЦикла;
	ДобавитьСтрокуМодели(Модель, ЯчейкиОбъекта, 15);
	Модель.Объединения.Добавить(АдресЯчейки("A", НомерОбъекта) + ":" + АдресЯчейки("B", НомерОбъекта));
	ДобавитьПримечаниеМодели(Модель, НомерОбъекта, 1, ТекстПланФактаКазны(Подразделение));
	ДобавитьСтрокуМодели(Модель, ЯчейкиСуммы, 11.25);

	// договори (+ документи під договором, згорнуті)
	Индекс = 0;
	Для Каждого СтрокаРасчета Из Договоры Цикл
		ДокументыДоговора = ДокументыДоговоров[Индекс];
		Индекс = Индекс + 1;
		ЕстьДокументы = ДокументыДоговора <> Неопределено И ДокументыДоговора.Количество() > 0;
		Р = Модель.Строки.Количество() + 1;
		ПараметрыДог = ПараметрыДоговора(КартаПараметров, СтрокаРасчета.Договор);
		Ячейки = Новый Массив;
		ИмяДоговора = СокрЛП(Строка(СтрокаРасчета.Договор));
		Ячейки.Добавить(ЯчейкаМодели(1, ИмяДоговора, 8));
		Ячейки.Добавить(ЯчейкаМодели(2, СокрЛП(СтрокаРасчета.Примечание), 8));
		Для Каждого Колонка Из Колонки Цикл
			Формула = ФормулаКолонкиДоговора(Колонка, Р, СтрокаРасчета, ПараметрыДог);
			Если ЕстьДокументы И (Колонка = "E" ИЛИ Колонка = "F" ИЛИ Колонка = "H") Тогда
				Формула = "SUBTOTAL(9," + АдресЯчейки(Колонка, Р + 1) + ":"
					+ АдресЯчейки(Колонка, Р + ДокументыДоговора.Количество()) + ")";
			КонецЕсли;
			Ячейки.Добавить(ЯчейкаМодели(СтрНайти("ABCDEFGHIJK", Колонка), ЗначениеКолонкиРасчета(СтрокаРасчета, Колонка), 9,
				Формула));
		КонецЦикла;
		Строк = Макс(1, Цел(СтрДлина(ИмяДоговора) / 48) + 1, Цел(СтрДлина(СтрокаРасчета.Примечание) / 40) + 1);
		ДобавитьСтрокуМодели(Модель, Ячейки, Мин(409, Строк * 11.25), Ложь, 1, ЕстьДокументы);

		ДобавитьПримечаниеМодели(Модель, Р, 1, ТекстУсловийДоговора(СтрокаРасчета, ПараметрыДог, ТаблицаПН));
		Если СРасшифровкой Тогда
			Если ЕстьДокументы Тогда
				ДобавитьСтрокиДокументовМодели(Модель, СтрокаРасчета, ПараметрыДог, ТаблицаПН, ДокументыДоговора);
			КонецЕсли;
		Иначе
			Примечания = ПримечанияДоговора(СтрокаРасчета.Подразделение, СтрокаРасчета.Договор, ПараметрыДог, ТаблицаПН);
			ДобавитьПримечаниеМодели(Модель, Р, 5, Примечания.E);
			ДобавитьПримечаниеМодели(Модель, Р, 6, Примечания.F);
			ДобавитьПримечаниеМодели(Модель, Р, 8, Примечания.H);
		КонецЕсли;
	КонецЦикла;

	ДобавитьСтрокуМодели(Модель, ЯчейкиИтого, 15);
	ДобавитьСтрокуМодели(Модель, Новый Массив);

КонецПроцедуры

// Рядки документів під договором (варіант «з розшифровкою»): рівень групування 2, приховані (згорнуті).
// A — вид, номер, дата; B — статус; сума — у колонці, де документ врахований (як у друку з розшифровкою:
// E — акт з «Оригінал», F — Кт, H — інші акти); L — ПН і реєстрація в ЄРПН; M — строк оплати.
Процедура ДобавитьСтрокиДокументовМодели(Модель, СтрокаРасчета, ПараметрыДог, ТаблицаПН, ДокументыДоговора)

	Остатки = НеоплаченныеОстаткиАктов(СтрокаРасчета.Договор);
	Для Каждого СтрокаРасш Из ДокументыДоговора Цикл
		Непроведен = НЕ СтрокаРасш.ДокументПроведен;
		СтильТекста = ?(Непроведен, 14, 12);
		СтильЧисла = ?(Непроведен, 15, 13);
		ЭтоОплата = СтрокаРасш.Вид = "Оплата";
		ЭтоВыполненные = СтрокаРасш.Вид = "Виконані роботи";
		Если ЭтоОплата Тогда
			Статус = "оплата" + ?(ПустаяСтрока(СтрокаРасш.ПодразделениеКазны), "", "; казна: " + СтрокаРасш.ПодразделениеКазны);
		ИначеЕсли ЭтоВыполненные Тогда
			Статус = "оригинал получен" + ?(ЗначениеЗаполнено(СтрокаРасш.ДатаПодписания),
				" " + Формат(СтрокаРасш.ДатаПодписания, "ДФ=dd.MM.yyyy"), "");
		ИначеЕсли Непроведен Тогда
			Статус = "не проведён";
		Иначе
			Статус = "не подписан";
		КонецЕсли;
		ТекстДокумента = ДокументДляПримечания(СтрокаРасш.Документ) + " от "
			+ Формат(СтрокаРасш.ДатаДокумента, "ДФ=dd.MM.yyyy");

		Ячейки = Новый Массив;
		Ячейки.Добавить(ЯчейкаМодели(1, ТекстДокумента, СтильТекста));
		Ячейки.Добавить(ЯчейкаМодели(2, Статус, СтильТекста));
		Для НомерКолонки = 3 По 11 Цикл
			Значение = 0;
			Если НомерКолонки = 5 И ЭтоВыполненные Тогда
				Значение = СтрокаРасш.СуммаДт;
			ИначеЕсли НомерКолонки = 6 Тогда
				Значение = СтрокаРасш.СуммаКт;
			ИначеЕсли НомерКолонки = 8 И НЕ ЭтоОплата И НЕ ЭтоВыполненные Тогда
				Значение = СтрокаРасш.СуммаДт;
			КонецЕсли;
			Ячейки.Добавить(ЯчейкаМодели(НомерКолонки, Значение, СтильЧисла));
		КонецЦикла;
		ТекстПН = "";
		ТекстСрока = "";
		Если НЕ ЭтоОплата Тогда
			ТекстПН = Сред(ТекстПНАкта(СтрокаРасш.Документ, ТаблицаПН), 3);
			Если ПараметрыДог.СрокОплатыДней > 0 И СтрокаРасш.СуммаДт > 0 Тогда
				Остаток = Остатки.Получить(СтрокаРасш.Документ);
				ТекстСрока = СокрЛП(СтрЗаменить(СтрокаСрокаОплаты(СтрокаРасш, СтрокаРасш.СуммаДт,
					?(Остаток = Неопределено, 0, Остаток), ПараметрыДог), " — ", " "));
			КонецЕсли;
		КонецЕсли;
		Ячейки.Добавить(ЯчейкаМодели(12, ТекстПН, СтильТекста));
		Ячейки.Добавить(ЯчейкаМодели(13, ТекстСрока, СтильТекста));
		Строк = Макс(1, Цел(СтрДлина(ТекстДокумента) / 48) + 1, Цел(СтрДлина(ТекстПН) / 50) + 1);
		ДобавитьСтрокуМодели(Модель, Ячейки, Мин(409, Строк * 11.25), Истина, 2);
	КонецЦикла;

КонецПроцедуры

Функция ЗначениеКолонкиРасчета(СтрокаРасчета, Колонка)

	Если Колонка = "C" Тогда
		Возврат СтрокаРасчета.СуммаСоглашения;
	ИначеЕсли Колонка = "D" Тогда
		Возврат СтрокаРасчета.СуммаДЦ;
	ИначеЕсли Колонка = "E" Тогда
		Возврат СтрокаРасчета.ВыполненныеРаботы;
	ИначеЕсли Колонка = "F" Тогда
		Возврат СтрокаРасчета.Оплачено;
	ИначеЕсли Колонка = "G" Тогда
		Возврат СтрокаРасчета.Задолженность;
	ИначеЕсли Колонка = "H" Тогда
		Возврат СтрокаРасчета.АктыПоданные;
	ИначеЕсли Колонка = "I" Тогда
		Возврат СтрокаРасчета.ГарантийныеПлатежи;
	ИначеЕсли Колонка = "J" Тогда
		Возврат СтрокаРасчета.НДСНезарегистрированный;
	КонецЕсли;
	Возврат СтрокаРасчета.ИтогоКПолучению;

КонецФункции

// Формули рядка договору — дзеркало ДобавитьСтрокуДоговора / ИтогоПоФормулеДоговора (K ≥ 0,
// округлення як у документі). Порожній рядок — значення без формули (C, D, E, F, H вводяться руками).
Функция ФормулаКолонкиДоговора(Колонка, Р, СтрокаРасчета, ПараметрыДог)

	E = АдресЯчейки("E", Р);
	F = АдресЯчейки("F", Р);
	G = АдресЯчейки("G", Р);
	H = АдресЯчейки("H", Р);
	I = АдресЯчейки("I", Р);
	J = АдресЯчейки("J", Р);
	Вариант = СтрокаРасчета.ВариантФормулы;
	Доля = ПараметрыДог.ПроцентУдержания / 100;
	Аванс = ЧислоФормулы(СтрокаРасчета.ОстатокАванса);
	ДелительНДС = ЧислоФормулы(1 + 100 / СтавкаНДСРасчета());

	Если Колонка = "G" Тогда
		Возврат E + "-" + F;
	ИначеЕсли Колонка = "I" Тогда
		Если ПараметрыДог.СуммаГарантийногоУдержания <= 0 Тогда
			Возврат "";
		КонецЕсли;
		Возврат "-ROUND(MIN(" + ЧислоФормулы(ПараметрыДог.СуммаГарантийногоУдержания) + ",MAX(0," + G + "+" + H + ")),2)";
	ИначеЕсли Колонка = "J" Тогда
		Правило = СокрЛП(ПараметрыДог.ПравилоНДС);
		Если Правило = "НеУчитывать" ИЛИ Правило = "ПослеРегистрацииПН" Тогда
			Возврат "";
		ИначеЕсли Правило = "ОтЗадолженности" Тогда
			Возврат "ROUND(-MAX(0," + G + ")/" + ДелительНДС + ",2)";
		ИначеЕсли Вариант = "ЗачетПредоплаты" Тогда
			Возврат "ROUND(-(" + H + "-MIN(" + Аванс + "," + H + "*" + ЧислоФормулы(Доля) + "))/" + ДелительНДС + ",2)";
		КонецЕсли;
		Возврат "ROUND(-" + H + "/" + ДелительНДС + ",2)";
	ИначеЕсли Колонка = "K" Тогда
		Если Вариант = "ЗадолженностьПлюсАкты" Тогда
			Сире = G + "+" + I + "+" + J + "+" + H + "*" + ЧислоФормулы(1 - Доля);
		ИначеЕсли Вариант = "ВыполнениеМинусОплата" Тогда
			Сире = "(" + E + "+" + H + ")*" + ЧислоФормулы(1 - Доля) + "+" + J + "-" + F + "+" + I;
		ИначеЕсли Вариант = "ЗачетПредоплаты" Тогда
			Сире = G + "+" + Аванс + "+" + H + "-MIN(" + Аванс + "," + H + "*" + ЧислоФормулы(Доля) + ")+" + J + "+" + I;
		Иначе
			Возврат "";
		КонецЕсли;
		Возврат "ROUND(MAX(0," + Сире + "),2)";
	КонецЕсли;
	Возврат "";

КонецФункции

// Примітки рядка договору: документи E (акти з «Оригінал»), F (оплати), H (подані/непроведені) за датою,
// «Итого» в кінці. До акта — його податкова накладна зі статусом реєстрації; для договорів зі строком
// оплати (регістр) — «оплата до …» / «просрочено N дн.» за неоплаченим залишком (оплати гасять акти за датою).
Функция ПримечанияДоговора(Подразделение, Договор, ПараметрыДог, ТаблицаПН)

	ДокументыДоговора = РасшифровкаДокументов.Выгрузить(Новый Структура("Подразделение, Договор", Подразделение, Договор));
	ДокументыДоговора.Сортировать("ДатаДокумента");
	Остатки = НеоплаченныеОстаткиАктов(Договор);

	Тексты = Новый Структура("E, F, H", Новый Массив, Новый Массив, Новый Массив);
	Итоги = Новый Структура("E, F, H", 0, 0, 0);
	Для Каждого СтрокаРасш Из ДокументыДоговора Цикл
		Если СтрокаРасш.Вид = "Оплата" Тогда
			Колонка = "F";
			Сумма = СтрокаРасш.СуммаКт;
		ИначеЕсли СтрокаРасш.Вид = "Виконані роботи" Тогда
			Колонка = "E";
			Сумма = СтрокаРасш.СуммаДт;
		Иначе
			Колонка = "H";
			Сумма = СтрокаРасш.СуммаДт;
		КонецЕсли;
		Текст = ДокументДляПримечания(СтрокаРасш.Документ) + " от " + Формат(СтрокаРасш.ДатаДокумента, "ДФ=dd.MM.yyyy")
			+ " — " + Формат(Сумма, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00");
		Если СтрокаРасш.Вид = "Акт поданий (непроведений)" Тогда
			Текст = Текст + " (не проведён)";
		ИначеЕсли СтрокаРасш.Вид = "Акт поданий" Тогда
			Текст = Текст + " (не подписан)";
		КонецЕсли;
		Если Колонка <> "F" Тогда
			Текст = Текст + ТекстПНАкта(СтрокаРасш.Документ, ТаблицаПН);
			Если ПараметрыДог.СрокОплатыДней > 0 И Сумма > 0 Тогда
				Остаток = Остатки.Получить(СтрокаРасш.Документ);
				Текст = Текст + СтрокаСрокаОплаты(СтрокаРасш, Сумма, ?(Остаток = Неопределено, 0, Остаток), ПараметрыДог);
			КонецЕсли;
		КонецЕсли;
		Тексты[Колонка].Добавить(Текст);
		Итоги[Колонка] = Итоги[Колонка] + Сумма;
	КонецЦикла;

	Результат = Новый Структура("E, F, H", "", "", "");
	Для Каждого Элемент Из Тексты Цикл
		Если Элемент.Значение.Количество() > 0 Тогда
			Результат[Элемент.Ключ] = СтрСоединить(Элемент.Значение, Символы.ПС) + Символы.ПС
				+ "Итого: " + Формат(Итоги[Элемент.Ключ], "ЧДЦ=2; ЧРГ=' '; ЧН=0,00");
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Неоплачений залишок кожного акта договору (E і H): усі оплати договору гасять акти за датою (FIFO).
// Соответствие Документ -> залишок.
Функция НеоплаченныеОстаткиАктов(Договор)

	СтрокиДоговора = РасшифровкаДокументов.Выгрузить(Новый Структура("Договор", Договор));
	СтрокиДоговора.Сортировать("ДатаДокумента");
	Пул = 0;
	Для Каждого СтрокаРасш Из СтрокиДоговора Цикл
		Если СтрокаРасш.Вид = "Оплата" Тогда
			Пул = Пул + СтрокаРасш.СуммаКт;
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Соответствие;
	Для Каждого СтрокаРасш Из СтрокиДоговора Цикл
		Если СтрокаРасш.Вид = "Оплата" ИЛИ СтрокаРасш.СуммаДт <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Погашено = Макс(0, Мин(Пул, СтрокаРасш.СуммаДт));
		Пул = Пул - Погашено;
		Результат.Вставить(СтрокаРасш.Документ, СтрокаРасш.СуммаДт - Погашено);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Податкові накладні договорів (проведені, до дати розрахунку) з ознакою реєстрації в ЄРПН.
// Реєстрацію видно лише для внутрішньогрупових ПН: покупець — наша організація (збіг ЄДРПОУ) реєструє
// вхідну ПН документом «Реєстрація вхідного податкового документа»; проведений = зареєстровано
// (дата — «Дата реєстр. в ЄРПН»). Зіставлення: організація-покупець, дата ПН, сума ПДВ.
Функция ДанныеПНДоговоров(Договоры)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПН.Ссылка КАК ПН,
	|	ПН.Номер КАК Номер,
	|	ПН.Дата КАК Дата,
	|	ПН.ДоговорКонтрагента КАК Договор,
	|	ПН.ДокументОснование КАК Основание,
	|	ПН.СуммаНДСДокумента КАК НДС,
	|	ЕСТЬNULL(Орг.Ссылка, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Внутренняя,
	|	ЕСТЬNULL(МАКСИМУМ(Рег.ДатаВключенияВЕдиныйРеестрНалоговыхНакладных), ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЕРПН,
	|	КОЛИЧЕСТВО(Рег.Ссылка) КАК Регистраций
	|ИЗ
	|	Документ.НалоговаяНакладная КАК ПН
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Орг
	|		ПО (Орг.КодПоЕДРПОУ = ПН.Контрагент.КодПоЕДРПОУ)
	|			И (ПН.Контрагент.КодПоЕДРПОУ <> """")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегистрацияВходящегоНалоговогоДокумента КАК Рег
	|		ПО (Рег.Проведен)
	|			И (Рег.Организация = Орг.Ссылка)
	|			И (Рег.ДатаВходящегоДокумента = НАЧАЛОПЕРИОДА(ПН.Дата, ДЕНЬ))
	|			И (Рег.СуммаНДСДокумента = ПН.СуммаНДСДокумента)
	|ГДЕ
	|	ПН.Проведен
	|	И НЕ ПН.ПометкаУдаления
	|	И ПН.Дата <= &ДатаРасчета
	|	И ПН.ДоговорКонтрагента В (&Договоры)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПН.Ссылка,
	|	ПН.Номер,
	|	ПН.Дата,
	|	ПН.ДоговорКонтрагента,
	|	ПН.ДокументОснование,
	|	ПН.СуммаНДСДокумента,
	|	ЕСТЬNULL(Орг.Ссылка, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Договоры", Договоры);
	Запрос.УстановитьПараметр("ДатаРасчета", МоментРасчета());
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ТекстПНАкта(Документ, ТаблицаПН)

	СтрокаПН = ТаблицаПН.Найти(Документ, "Основание");
	Если СтрокаПН = Неопределено Тогда
		Возврат "; ПН по акту нет";
	КонецЕсли;
	Возврат "; ПН " + СокрЛП(СтрокаПН.Номер) + " от " + Формат(СтрокаПН.Дата, "ДФ=dd.MM.yyyy") + ", НДС "
		+ Формат(СтрокаПН.НДС, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + " — " + СтатусПН(СтрокаПН);

КонецФункции

Функция СтатусПН(СтрокаПН)

	Если СтрокаПН.Регистраций > 0 Тогда
		Возврат "зарегистрирована" + ?(ЗначениеЗаполнено(СтрокаПН.ДатаЕРПН),
			" " + Формат(СтрокаПН.ДатаЕРПН, "ДФ=dd.MM.yyyy"), "");
	ИначеЕсли СтрокаПН.Внутренняя Тогда
		Возврат "не зарегистрирована";
	КонецЕсли;
	Возврат "регистрация: нет данных в 1С";

КонецФункции

// J за правилом «ПослеРегистрацииПН»: замовник платить ПДВ лише після реєстрації ПН. Для кожного
// неоплаченого акта з незареєстрованою ПН (або без ПН) — мінус min(ПДВ акта; неоплачений залишок).
Функция НДСНеЗарегистрированныхПН(Договор)

	МассивДоговоров = Новый Массив;
	МассивДоговоров.Добавить(Договор);
	ТаблицаПН = ДанныеПНДоговоров(МассивДоговоров);
	СтрокиДоговора = РасшифровкаДокументов.Выгрузить(Новый Структура("Договор", Договор));
	Итог = 0;
	Для Каждого Элемент Из НеоплаченныеОстаткиАктов(Договор) Цикл
		Остаток = Элемент.Значение;
		Если Остаток < 0.005 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаПН = ТаблицаПН.Найти(Элемент.Ключ, "Основание");
		Если СтрокаПН = Неопределено Тогда
			СтрокаАкта = СтрокиДоговора.Найти(Элемент.Ключ, "Документ");
			НДСАкта = ?(СтрокаАкта = Неопределено, 0, -СуммаНезарегистрированногоНДС(СтрокаАкта.СуммаДт));
		ИначеЕсли СтрокаПН.Регистраций > 0 Тогда
			Продолжить;
		Иначе
			НДСАкта = СтрокаПН.НДС;
		КонецЕсли;
		Итог = Итог + Мин(НДСАкта, Остаток);
	КонецЦикла;
	Возврат -Окр(Итог, 2);

КонецФункции

// Активний договір для авто-статусу: борг чи подані акти (≥ 1 грн за модулем), незачтений аванс,
// або рух у місяці розрахунку.
Функция ДоговорАктивенВОтчете(Договор, Задолженность, Акты, ОстатокАванса)

	Если Задолженность >= 1 ИЛИ Задолженность <= -1 ИЛИ Акты >= 1 ИЛИ Акты <= -1 ИЛИ ОстатокАванса >= 1 Тогда
		Возврат Истина;
	КонецЕсли;
	НачалоМесяцаРасчета = НачалоМесяца(ДатаРасчета);
	Для Каждого СтрокаРасш Из РасшифровкаДокументов.НайтиСтроки(Новый Структура("Договор", Договор)) Цикл
		Если СтрокаРасш.ДатаДокумента >= НачалоМесяцаРасчета Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Підрозділи план-факту казни за місяць розрахунку (РН.БюджетыНаМесяц, напрям «Производство»), яких
// немає в ТЧ «Підрозділи», додаються увімкненими: заплановано надходження чи витрати — об'єкт має бути
// у звіті навіть без боргів. Вимкнені вручну рядки не чіпаються. П35 — перелік доданих.
Процедура ДобавитьПодразделенияПланФактаКазны(СоединениеКазны)

	Если СоединениеКазны = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		НаправлениеКазна = СоединениеКазны.Справочники.Направления.НайтиПоНаименованию("Производство", Истина);
		ЗапросКазны = СоединениеКазны.NewObject("Запрос");
		ЗапросКазны.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Об.Подразделение.Наименование КАК Имя
		|ИЗ
		|	РегистрНакопления.БюджетыНаМесяц.Обороты(&НачалоМесяца, &ДатаРасчета, ,
		|		Направление = &Направление) КАК Об
		|ГДЕ
		|	Об.Подразделение <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)";
		ЗапросКазны.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ДатаРасчета));
		ЗапросКазны.УстановитьПараметр("ДатаРасчета", МоментРасчета());
		ЗапросКазны.УстановитьПараметр("Направление", НаправлениеКазна);
		ВыборкаКазны = ЗапросКазны.Выполнить().Выбрать();
	Исключение
		ДобавитьЗамечание("Предупреждение", "П34", "Підрозділи план-факту казни не отримано: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Неопределено, "Объект.Подразделения");
		Возврат;
	КонецПопытки;

	Добавлено = "";
	Пока ВыборкаКазны.Следующий() Цикл
		ИмяПодразделения = ВыборкаКазны.Имя;
		Если ИмяПодразделения = "Главный офис" ИЛИ ИмяПодразделения = "Цех металлоконструкций" Тогда
			Продолжить;
		КонецЕсли;
		НайденноеПодразделение = Справочники.Подразделения.НайтиПоНаименованию(ИмяПодразделения, Истина);
		Если НЕ ЗначениеЗаполнено(НайденноеПодразделение)
			ИЛИ Подразделения.Найти(НайденноеПодразделение, "Подразделение") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Подразделения.Добавить();
		НоваяСтрока.Подразделение = НайденноеПодразделение;
		НоваяСтрока.Включать = Истина;
		Добавлено = Добавлено + ?(ПустаяСтрока(Добавлено), "", ", ") + ИмяПодразделения;
	КонецЦикла;
	Если НЕ ПустаяСтрока(Добавлено) Тогда
		ДобавитьЗамечание("Информация", "П35", "З план-факту казни додано підрозділи (заплановано надходження "
			+ "або витрати): " + Добавлено + ".", Неопределено, "Объект.Подразделения");
	КонецЕсли;

КонецПроцедуры

// Підпис блоку в Excel: «Підрозділ (контрагент взаєморозрахунків; …)».
Функция ПодписьБлока(Подразделение, Договоры)

	Контрагенты = Новый Массив;
	Для Каждого СтрокаРасчета Из Договоры Цикл
		ИмяКонтрагента = СокрЛП(Строка(СтрокаРасчета.Контрагент));
		Если НЕ ПустаяСтрока(ИмяКонтрагента) И Контрагенты.Найти(ИмяКонтрагента) = Неопределено Тогда
			Контрагенты.Добавить(ИмяКонтрагента);
		КонецЕсли;
	КонецЦикла;
	Возврат Строка(Подразделение) + ?(Контрагенты.Количество() = 0, "", " (" + СтрСоединить(Контрагенты, "; ") + ")");

КонецФункции

// Примітка рядка об'єкта: план-факт казни за місяць розрахунку (ТЧ «Казна»).
Функция ТекстПланФактаКазны(Подразделение)

	СтрокаКазны = Казна.Найти(Подразделение, "Подразделение");
	Если СтрокаКазны = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ФорматСуммы = "ЧДЦ=2; ЧРГ=' '; ЧН=0,00";
	Возврат "План-факт казны с " + Формат(НачалоМесяца(ДатаРасчета), "ДФ=dd.MM.yyyy") + " по "
		+ Формат(ДатаРасчета, "ДФ=dd.MM.yyyy") + ":" + Символы.ПС
		+ "Поступления: план " + Формат(СтрокаКазны.ПоступленияПлан, ФорматСуммы)
		+ ", факт " + Формат(СтрокаКазны.ПоступленияФакт, ФорматСуммы) + Символы.ПС
		+ "Затраты: план " + Формат(СтрокаКазны.ЗатратыПлан, ФорматСуммы)
		+ ", факт " + Формат(СтрокаКазны.ЗатратыФакт, ФорматСуммы) + Символы.ПС
		+ "Маржа: план " + Формат(СтрокаКазны.МаржаПлан, ФорматСуммы)
		+ ", факт " + Формат(СтрокаКазны.МаржаФакт, ФорматСуммы);

КонецФункции

// Примітка назви договору (колонка A): реквізити, умови оплати, аванс, утримання, ПДВ, податкові
// накладні і текст умов з регістру параметрів.
Функция ТекстУсловийДоговора(СтрокаРасчета, ПараметрыДог, ТаблицаПН)

	ФорматСуммы = "ЧДЦ=2; ЧРГ=' '; ЧН=0,00";
	Договор = СтрокаРасчета.Договор;
	Строки = Новый Массив;
	Строки.Добавить("Договор № " + СокрЛП(Договор.Номер)
		+ ?(ЗначениеЗаполнено(Договор.Дата), " от " + Формат(Договор.Дата, "ДФ=dd.MM.yyyy"), "")
		+ " (" + СокрЛП(Строка(Договор.Организация)) + " → " + СокрЛП(Строка(Договор.Владелец)) + ")");
	Если ПараметрыДог.СуммаСоглашения <> 0 Тогда
		Строки.Добавить("Сумма соглашения: " + Формат(ПараметрыДог.СуммаСоглашения, ФорматСуммы));
	КонецЕсли;
	Если ПараметрыДог.СрокОплатыДней > 0 Тогда
		База = СокрЛП(ПараметрыДог.БазаСрокаОплаты);
		Строки.Добавить("Оплата: " + Формат(ПараметрыДог.СрокОплатыДней, "ЧГ=0") + " кал. дн. "
			+ ?(База = "ПодписаниеАкта", "после подписания акта",
			?(База = "ПоставкаИДокументы", "после поставки и получения документов", "от даты акта")));
	КонецЕсли;
	Процент = Формат(ПараметрыДог.ПроцентУдержания, "ЧГ=0; ЧН=0");
	Вариант = СтрокаРасчета.ВариантФормулы;
	Если Вариант = "ЗачетПредоплаты" Тогда
		Строки.Добавить("Аванс: " + Формат(ПараметрыДог.СуммаПредоплаты, ФорматСуммы) + ", зачёт " + Процент
			+ " % с каждого акта; остаток аванса на дату отчёта " + Формат(СтрокаРасчета.ОстатокАванса, ФорматСуммы));
	ИначеЕсли ПараметрыДог.ПроцентУдержания > 0 И Вариант = "ЗадолженностьПлюсАкты" Тогда
		Строки.Добавить("Из поданных актов " + Процент + " % ожидается позже (второй транш)");
	ИначеЕсли ПараметрыДог.ПроцентУдержания > 0 И Вариант = "ВыполнениеМинусОплата" Тогда
		Строки.Добавить("Удержание " + Процент + " % от выполненных работ");
	КонецЕсли;
	Если ПараметрыДог.СуммаГарантийногоУдержания > 0 Тогда
		Строки.Добавить("Гарантийное удержание: " + Формат(ПараметрыДог.СуммаГарантийногоУдержания, ФорматСуммы));
	КонецЕсли;
	Правило = СокрЛП(ПараметрыДог.ПравилоНДС);
	Строки.Добавить("НДС в отчёте: " + ?(Правило = "НеУчитывать", "не учитывается",
		?(Правило = "ОтЗадолженности", "от задолженности",
		?(Правило = "ПослеРегистрацииПН", "платится после регистрации ПН", "от поданных актов"))));

	Всего = 0;
	НДСВсего = 0;
	Зарегистрировано = 0;
	НеЗарегистрировано = 0;
	НДСНеЗарегистрировано = 0;
	БезДанных = 0;
	Для Каждого СтрокаПН Из ТаблицаПН.НайтиСтроки(Новый Структура("Договор", Договор)) Цикл
		Всего = Всего + 1;
		НДСВсего = НДСВсего + СтрокаПН.НДС;
		Если СтрокаПН.Регистраций > 0 Тогда
			Зарегистрировано = Зарегистрировано + 1;
		ИначеЕсли СтрокаПН.Внутренняя Тогда
			НеЗарегистрировано = НеЗарегистрировано + 1;
			НДСНеЗарегистрировано = НДСНеЗарегистрировано + СтрокаПН.НДС;
		Иначе
			БезДанных = БезДанных + 1;
		КонецЕсли;
	КонецЦикла;
	Если Всего > 0 Тогда
		Строки.Добавить("ПН: " + Формат(Всего, "ЧГ=0") + " шт., НДС " + Формат(НДСВсего, ФорматСуммы)
			+ "; зарегистрировано " + Формат(Зарегистрировано, "ЧГ=0; ЧН=0")
			+ ?(НеЗарегистрировано > 0, "; не зарегистрировано " + Формат(НеЗарегистрировано, "ЧГ=0")
				+ " (НДС " + Формат(НДСНеЗарегистрировано, ФорматСуммы) + ")", "")
			+ ?(БезДанных > 0, "; нет данных о регистрации " + Формат(БезДанных, "ЧГ=0"), ""));
	КонецЕсли;
	Если НЕ ПустаяСтрока(СокрЛП(ПараметрыДог.УсловияДоговора)) Тогда
		Строки.Добавить("Условия: " + СокрЛП(ПараметрыДог.УсловияДоговора));
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// База строку (регістр, БазаСрокаОплаты): «ПодписаниеАкта» — дата отримання оригіналу;
// «ПоставкаИДокументы» — пізніша з дати акта і дати отримання документів; інакше — дата документа.
Функция СтрокаСрокаОплаты(СтрокаРасш, Сумма, Остаток, ПараметрыДог)

	Если Остаток < 0.005 Тогда
		Возврат "";
	КонецЕсли;
	База = СокрЛП(ПараметрыДог.БазаСрокаОплаты);
	Если База = "ПодписаниеАкта" ИЛИ База = "ПоставкаИДокументы" Тогда
		Если НЕ ЗначениеЗаполнено(СтрокаРасш.ДатаПодписания) Тогда
			Возврат " — срок оплаты: " + ПараметрыДог.СрокОплатыДней + " дн. после "
				+ ?(База = "ПодписаниеАкта", "подписания акта", "получения документов");
		КонецЕсли;
		Начало = ?(База = "ПодписаниеАкта", СтрокаРасш.ДатаПодписания,
			Макс(СтрокаРасш.ДатаДокумента, СтрокаРасш.ДатаПодписания));
	Иначе
		Начало = СтрокаРасш.ДатаДокумента;
	КонецЕсли;
	Срок = НачалоДня(Начало) + ПараметрыДог.СрокОплатыДней * 86400;
	Префикс = ?(Остаток < Сумма - 0.005, " — остаток " + Формат(Остаток, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00") + ",", " —");
	Просрочено = (НачалоДня(ДатаРасчета) - Срок) / 86400;
	Если Просрочено > 0 Тогда
		Возврат Префикс + " просрочено " + Формат(Просрочено, "ЧГ=0") + " дн. (срок " + Формат(Срок, "ДФ=dd.MM.yyyy") + ")";
	КонецЕсли;
	Возврат Префикс + " оплата до " + Формат(Срок, "ДФ=dd.MM.yyyy");

КонецФункции

Функция ДокументДляПримечания(Документ)

	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		Возврат "Документ";
	КонецЕсли;
	Скорочення = Новый Соответствие;
	Скорочення.Вставить("РеализацияУслугПоПереработке", "Реализ. услуг по переработке");
	Скорочення.Вставить("РеализацияТоваровУслуг", "Реализ. товаров и услуг");
	Скорочення.Вставить("АктОбОказанииПроизводственныхУслуг", "Оказание произв. услуг");
	Скорочення.Вставить("ИмпРеализацияСтроительныхРаботУслуг", "Реализ. строит. работ");
	Скорочення.Вставить("ПоступлениеНаРасчетныйСчет", "Поступление на р/с");
	МетаданныеДокумента = Документ.Метаданные();
	Вид = Скорочення.Получить(МетаданныеДокумента.Имя);
	Если Вид = Неопределено Тогда
		Вид = МетаданныеДокумента.Представление();
	КонецЕсли;
	Возврат Вид + " " + СокрЛП(Документ.Номер);

КонецФункции

// Параметри договорів рядків «Розрахунку» — той самий запит, що й у розрахунку (без контролів).
Функция ПараметрыДоговоровРасчета()

	Договоры = Новый Соответствие;
	Для Каждого СтрокаРасчета Из Расчет Цикл
		Если ЗначениеЗаполнено(СтрокаРасчета.Договор) Тогда
			Договоры.Вставить(СтрокаРасчета.Договор, Истина);
		КонецЕсли;
	КонецЦикла;
	Итоги = Новый Соответствие;
	Итоги.Вставить("Усі", Договоры);
	Возврат ПараметрыДоговоров(Итоги);

КонецФункции

Функция ДобавитьСтрокуМодели(Модель, Ячейки, Высота = 0, Скрыта = Ложь, Уровень = 0, Свернута = Ложь)

	Модель.Строки.Добавить(Новый Структура("Высота, Скрыта, Уровень, Ячейки, Свернута",
		Высота, Скрыта, Уровень, Ячейки, Свернута));
	Возврат Модель.Строки.Количество();

КонецФункции

Функция ЯчейкаМодели(Колонка, Значение, Стиль, Формула = "")

	Возврат Новый Структура("Колонка, Значение, Стиль, Формула", Колонка, Значение, Стиль, Формула);

КонецФункции

Процедура ДобавитьПримечаниеМодели(Модель, НомерСтроки, Колонка, Текст)

	Если НЕ ПустаяСтрока(Текст) Тогда
		Модель.Примечания.Добавить(Новый Структура("Строка, Колонка, Текст", НомерСтроки, Колонка, Текст));
	КонецЕсли;

КонецПроцедуры

Функция АдресЯчейки(Колонка, НомерСтроки)

	Возврат Колонка + Формат(НомерСтроки, "ЧН=0; ЧГ=0");

КонецФункции

// Число для формули Excel: крапка, без групування.
Функция ЧислоФормулы(Число)

	Возврат Формат(Число, "ЧРД=.; ЧН=0; ЧГ=0");

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(ДатаРасчета) Тогда
		ДатаРасчета = КонецДня(?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДата()));
	КонецЕсли;
	ВключатьНепроведенные = Истина;
	ЗаполнятьТолькоСДвижениями = Истина;
	// Документ створювався під напрямок «Производство» — підставляємо його за замовчуванням.
	Если НЕ ЗначениеЗаполнено(Направление) Тогда
		Направление = Справочники.Направления.НайтиПоНаименованию("Производство", Истина);
	КонецЕсли;

	Если СчетаРасчетов.Количество() = 0 Тогда
		СчетаРасчетов.Добавить().Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду("361");
	КонецЕсли;

	Если СтатьиИсключенияКазны.Количество() = 0 Тогда
		ЗаполнитьСтатьиИсключенияПоУмолчанию();
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Документ нічого не проводить — це калькулятор. Захист від «порожнього» збереження
	// не потрібен: чернетку з параметрами зберігати можна й треба.
	// Реквізит Статус прибрано 16.08.2026 — стан показує напис на формі.

КонецПроцедуры

