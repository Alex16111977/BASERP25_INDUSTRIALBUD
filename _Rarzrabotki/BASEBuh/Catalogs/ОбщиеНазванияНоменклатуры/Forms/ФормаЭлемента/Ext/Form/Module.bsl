
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)   
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Номенклатура.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);   
		Номенклатура.Параметры.УстановитьЗначениеПараметра("ОсновнаяНоменклатура", Объект.ОсновнаяНоменклатура);

		Иначе
        Номенклатура.Параметры.УстановитьЗначениеПараметра("Ссылка", Неопределено);   
		Номенклатура.Параметры.УстановитьЗначениеПараметра("ОсновнаяНоменклатура", Неопределено);

    КонецЕсли;
    
   КонецПроцедуры

   &НаКлиенте
   Процедура ПодборНоменклатуры(Команда)
	   Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		   ПоказатьПредупреждение(, "Спочатку запишіть елемент!");
		   Возврат;
	   КонецЕсли;
	   
	   ПараметрыФормы = Новый Структура;
	   ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);          
	   ПараметрыФормы.Вставить("МножественныйВыбор",  Ложь);
	   ПараметрыФормы.Вставить("РежимОткрытияОкна",   РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	   
	   Оповещение = Новый ОписаниеОповещения("ПослеВыбораНоменклатуры", ЭтотОбъект);
	   
	   ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", 
	   ПараметрыФормы, 
	   ЭтотОбъект, 
	   , , , 
	   Оповещение, 
	   РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
   КонецПроцедуры     
   
   &НаКлиенте
Процедура ПослеВыбораНоменклатуры(ВыбранныеЗначения, ДопПараметры) Экспорт
    
    Если ВыбранныеЗначения = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
        ЗаписатьНоменклатуруНаСервере(ВыбранныеЗначения);
        Элементы.Номенклатура.Обновить();  
    
КонецПроцедуры


&НаСервере
Процедура ЗаписатьНоменклатуруНаСервере(НоменклатураСсылка)
    
    НачатьТранзакцию();
    Попытка
            
            Если НЕ ЗначениеЗаполнено(НоменклатураСсылка) Тогда
                Возврат;
            КонецЕсли;
            
            ОбъектНоменклатуры = НоменклатураСсылка.ПолучитьОбъект();
            Если ОбъектНоменклатуры.ОбщееНазваниеНоменклатуры = Объект.Ссылка Тогда
                Возврат; 
            КонецЕсли;
            
            ОбъектНоменклатуры.ОбщееНазваниеНоменклатуры = Объект.Ссылка;
            ОбъектНоменклатуры.Записать();
            
        ЗафиксироватьТранзакцию();
        
    Исключение
        ОтменитьТранзакцию();
        Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    
КонецПроцедуры


&НаКлиенте
Процедура УдалитьПривязку(Команда)
	 ВыделенныеИдентификаторы = Элементы.Номенклатура.ВыделенныеСтроки;  // это массив чисел: 1,3,5...
    
    Если ВыделенныеИдентификаторы.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "Виділіть хоча б один елемент!");
        Возврат;
    КонецЕсли;
    
	 МассивСсылок = Новый Массив;
	 Для Каждого ИдентификаторСтроки Из ВыделенныеИдентификаторы Цикл
        
        ДанныеСтроки = Элементы.Номенклатура.ДанныеСтроки(ИдентификаторСтроки);
        
        Если ДанныеСтроки = Неопределено Тогда
            Продолжить;    
		ИначеЕсли  ДанныеСтроки.Ссылка = Объект.ОсновнаяНоменклатура Тогда  
			ПоказатьПредупреждение(, "Не можна видаляти основну номенклатуру");
            Возврат;
		КонецЕсли;
        
        СсылкаНаНоменклатуру = ДанныеСтроки.Ссылка;
        
        Если ЗначениеЗаполнено(СсылкаНаНоменклатуру) Тогда
            МассивСсылок.Добавить(СсылкаНаНоменклатуру);
        КонецЕсли;
        
    КонецЦикла;

	
    
    Если МассивСсылок.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "Не вдалося визначити посилання на номенклатуру");
        Возврат;
    КонецЕсли;
    
    Текст = ?(МассивСсылок.Количество() = 1,
        "Відв'язати вибрану номенклатуру?",
        СтрШаблон("Відв'язати %1 елемент(ів)?", МассивСсылок.Количество()));
    
    Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияУдаления", ЭтотОбъект, МассивСсылок);
    ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет);
    
КонецПроцедуры


&НаКлиенте
Процедура ПослеПодтвержденияУдаления(Результат, ВыделенныеСтроки) Экспорт
    
    Если Результат <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
    
    УдалитьПривязкуНаСервере(ВыделенныеСтроки);
    
    Элементы.Номенклатура.Обновить();
    
КонецПроцедуры

&НаСервере
Процедура УдалитьПривязкуНаСервере(МассивСсылок)
    
    Если МассивСсылок.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    
    НачатьТранзакцию();
    Попытка
        
        Для Каждого НоменклатураСсылка Из МассивСсылок Цикл
            
            Если НЕ ЗначениеЗаполнено(НоменклатураСсылка) Тогда
                Продолжить;
            КонецЕсли;
            
            Блокировка = Новый БлокировкаДанных;
            ЭлементБлокировки = Блокировка.Добавить("Справочник.Номенклатура");
            ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
            ЭлементБлокировки.УстановитьЗначение("Ссылка", НоменклатураСсылка);
            Блокировка.Заблокировать();
            
            ОбъектНоменклатуры = НоменклатураСсылка.ПолучитьОбъект();
            
            Если НЕ ЗначениеЗаполнено(ОбъектНоменклатуры.ОбщееНазваниеНоменклатуры) Тогда
                Продолжить;             КонецЕсли;
            
            ОбъектНоменклатуры.ОбщееНазваниеНоменклатуры = Неопределено;  
            ОбъектНоменклатуры.Записать();
            
        КонецЦикла;
        
        ЗафиксироватьТранзакцию();
        
    Исключение
        ОтменитьТранзакцию();
        Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
        ЗаписьЖурналаРегистрации("Помилка при відв'язуванні номенклатури",
            УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    
КонецПроцедуры


&НаКлиенте
Процедура СделатьОсновной(Команда)
    
    Выделенные = Элементы.Номенклатура.ВыделенныеСтроки;
    
    Если Выделенные.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "Виділіть номенклатуру, яку потрібно зробити основною!");
        Возврат;
    КонецЕсли;
    
    Если Выделенные.Количество() > 1 Тогда
        ПоказатьПредупреждение(, "Можна обрати тільки одну номенклатуру як основну!");
        Возврат;
    КонецЕсли;
    
    Идентификатор = Выделенные[0];
    ДанныеСтроки  = Элементы.Номенклатура.ДанныеСтроки(Идентификатор);
    
    Если ДанныеСтроки = Неопределено Или НЕ ЗначениеЗаполнено(ДанныеСтроки.Ссылка) Тогда
        ПоказатьПредупреждение(, "Не вдалося визначити посилання на номенклатуру");
        Возврат;
    КонецЕсли;
    
    НоваяОсновная = ДанныеСтроки.Ссылка;
    
    Если Объект.ОсновнаяНоменклатура = НоваяОсновная Тогда
        ПоказатьПредупреждение(, "Ця номенклатура вже є основною!");
        Возврат;
    КонецЕсли;
    
    ТекстВопроса = СтрШаблон("Зробити номенклатуру ""%1"" основною для цього загального найменування?", 
                             Строка(НоваяОсновная));
    
    Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияОсновной", ЭтотОбъект, НоваяОсновная);
    ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
    
КонецПроцедуры


&НаКлиенте
Процедура ПослеПодтвержденияОсновной(Результат, НоваяОсновная) Экспорт
    
    Если Результат <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
    
    УстановитьОсновнуюНаСервере(НоваяОсновная);
    
    Прочитать();
    
    Элементы.Номенклатура.Обновить();
    
КонецПроцедуры

&НаСервере
Процедура УстановитьОсновнуюНаСервере(НоваяОсновнаяНоменклатура)
    
    НачатьТранзакцию();
    Попытка
        
        // 1. Блокуємо поточний елемент (ОбщиеНазванияНоменклатуры)
        Блокировка = Новый БлокировкаДанных;
        ЭлементБлокировки = Блокировка.Добавить("Справочник.ОбщиеНазванияНоменклатуры");
        ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
        ЭлементБлокировки.УстановитьЗначение("Ссылка", Объект.Ссылка);
        Блокировка.Заблокировать();
        
        // 2. Оновлюємо поточний об'єкт
        ОбъектДляЗаписи = РеквизитФормыВЗначение("Объект");
        ОбъектДляЗаписи.ОсновнаяНоменклатура = НоваяОсновнаяНоменклатура;
        ОбъектДляЗаписи.Записать();
        
        ЗначениеВРеквизитФормы(ОбъектДляЗаписи, "Объект");
        
        ЗафиксироватьТранзакцию(); 
		
		Номенклатура.Параметры.УстановитьЗначениеПараметра("ОсновнаяНоменклатура", Объект.ОсновнаяНоменклатура);

        
    Исключение
        ОтменитьТранзакцию();
        Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
        ЗаписьЖурналаРегистрации("Помилка при встановленні основної номенклатури",
            УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Номенклатура.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка); 
КонецПроцедуры

	
