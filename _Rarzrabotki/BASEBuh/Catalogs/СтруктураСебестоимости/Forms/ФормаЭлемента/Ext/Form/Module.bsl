
&НаКлиенте
Процедура КомплектующиеНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Комплектующие.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    Если НЕ ЗначениеЗаполнено(ТекущиеДанные.ОбщееНазвание) Тогда
        СтандартнаяОбработка = Ложь;
        ПоказатьПредупреждение(, "Спочатку заповніть ""Загальну назву"" у поточному рядку!");
        Возврат;
    КонецЕсли;
    
    СтандартнаяОбработка = Ложь;
    
    ПараметрыОткрытия = Новый Структура;
    ПараметрыОткрытия.Вставить("Отбор", Новый Структура("ОбщееНазваниеНоменклатуры, Услуга", ТекущиеДанные.ОбщееНазвание,Ложь));
    
    ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыОткрытия, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
    
КонецПроцедуры

&НаКлиенте
Процедура КомплектующиеОбщееНазваниеПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Комплектующие.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    Если ЗначениеЗаполнено(ТекущиеДанные.ОбщееНазвание) Тогда
       ТекущиеДанные.Номенклатура = ОсновнаяНоменклатура(ТекущиеДанные.ОбщееНазвание);
	   Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда   
		   ТекущиеДанные.Единица = ПолучитьЕдиницу(ТекущиеДанные.Номенклатура);
	   КонецЕсли;
	КонецЕсли;
КонецПроцедуры    

Функция ОсновнаяНоменклатура(ОбщееНазвание)
Возврат ОбщееНазвание.ОсновнаяНоменклатура;
КонецФункции      

Функция ПолучитьЕдиницу(Номенклатура)
Возврат Номенклатура.БазоваяЕдиницаИзмерения;
КонецФункции   

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Объект.Активная Тогда 
		Код = ПроверитьАктивные();  
		Если Код <> Неопределено Тогда   
			Отказ = Истина;
			ПоказатьПредупреждение(, "Вже існує активна структура по підрозділу та складу з кодом " + Код);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры    


Функция ПроверитьАктивные()     
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СтруктураСебестоимости.Код КАК Код
	|ИЗ
	|	Справочник.СтруктураСебестоимости КАК СтруктураСебестоимости
	|ГДЕ
	|	СтруктураСебестоимости.Подразделение = &Подразделение
	|	И СтруктураСебестоимости.Склад = &Склад
	|	И СтруктураСебестоимости.Активная
	|	И СтруктураСебестоимости.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
	Запрос.УстановитьПараметр("Склад",  Объект.Склад); 
	Запрос.УстановитьПараметр("Ссылка",  Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Код;
	ИНАЧЕ
		Возврат Неопределено
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура КомплектующиеНоменклатураПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Комплектующие.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
	Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда 
		ТекущиеДанные.Единица = ПолучитьЕдиницу(ТекущиеДанные.Номенклатура);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СкладПриИзмененииНаСервере()
Объект.Подразделение = Объект.Склад.Подразделение;
ИзменитьНаименование();

КонецПроцедуры

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	СкладПриИзмененииНаСервере();
КонецПроцедуры   

Процедура  ИзменитьНаименование() 
	Если ЗначениеЗаполнено(Объект.Подразделение) И ЗначениеЗаполнено(Объект.Склад) Тогда
		Объект.Наименование = Строка(Объект.Подразделение) + " / " + Строка(Объект.Склад);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	ИзменитьНаименование() 
КонецПроцедуры
