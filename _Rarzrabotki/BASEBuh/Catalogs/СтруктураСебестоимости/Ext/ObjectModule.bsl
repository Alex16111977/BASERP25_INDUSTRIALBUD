
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Для каждого СтрокаТабличнойЧасти Из Комплектующие Цикл
		
		СтрокаТабличнойЧасти.ЕдиницаОбщееНазвание = СтрокаТабличнойЧасти.ОбщееНазвание.Единица;
		
		Если СокрЛП(СтрокаТабличнойЧасти.ЕдиницаОбщееНазвание) <> СокрЛП(СтрокаТабличнойЧасти.Единица)
			  Тогда
			СообщенияОбОшибке = " Рядок "+СокрЛП(СтрокаТабличнойЧасти.НомерСтроки)+Символы.ПС+
			"одиниця виміру загальна назва " +СокрЛП(СтрокаТабличнойЧасти.ОбщееНазвание)+" " +СокрЛП(СтрокаТабличнойЧасти.ЕдиницаОбщееНазвание)+ "<>" + СокрЛП(СтрокаТабличнойЧасти.Единица); 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщенияОбОшибке);
			СтрокаТабличнойЧасти.НеСовпадает = Истина;  
			     

		ИначеЕсли СокрЛП(СтрокаТабличнойЧасти.ЕдиницаОбщееНазвание) <> СокрЛП(СтрокаТабличнойЧасти.ЕдиницаСС) Тогда
					СообщенияОбОшибке = " Рядок "+СокрЛП(СтрокаТабличнойЧасти.НомерСтроки)+Символы.ПС+
			"одиниця виміру загальна назва " +СокрЛП(СтрокаТабличнойЧасти.ОбщееНазвание)+" " +СокрЛП(СтрокаТабличнойЧасти.ЕдиницаОбщееНазвание)+ "<>" + СокрЛП(СтрокаТабличнойЧасти.ЕдиницаСС); 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщенияОбОшибке);
			СтрокаТабличнойЧасти.НеСовпадает = Истина;  
	
		Иначе
			СтрокаТабличнойЧасти.НеСовпадает = Ложь;
		КонецЕсли;
		
	СтрокаТабличнойЧасти.Цена = ?(СтрокаТабличнойЧасти.Количество<>0,Окр(СтрокаТабличнойЧасти.Сумма/СтрокаТабличнойЧасти.Количество,2),0);	
	КонецЦикла;
	
КонецПроцедуры
