#Область ЗагрузкаМатериаловИзExcel

// Заполняет табличную часть Комплектующие строками материалов листа «Проект СС».
// Объект НЕ записывается: запись выполняет пользователь из формы элемента.
// Правила отбора строк-материалов — см. ОтобратьМатериалы.
//
// Параметры:
//  СырыеСтроки - Массив структур {Ряд, Тип, Этап, ОбщееНазвание, Наименование, Единица, Количество, Сумма}
//                как они прочитаны из листа, без предварительной фильтрации.
//
// Возвращаемое значение:
//  Структура - протокол загрузки (см. НовыйПротоколЗагрузки).
//
Функция ЗаполнитьКомплектующиеИзСырыхСтрок(СырыеСтроки) Экспорт

	Результат = НовыйПротоколЗагрузки();

	// Транзакция защищает справочники-приёмники: если контроль итогов не пройден,
	// созданные по пути этапы и общие названия откатываются вместе с ним.
	НачатьТранзакцию();
	Попытка
		ПротоколОтбора = Неопределено;
		МассивСтрок = ОтобратьМатериалы(СырыеСтроки, ПротоколОтбора);

		Результат.ПодхваченоБезТипа = ПротоколОтбора.ПодхваченоБезТипа;
		Результат.СтопСтрока = ПротоколОтбора.СтопСтрока;
		Результат.ДеталиОтбора = ПротоколОтбора.ДеталиОтбора;
		Результат.Инфо.Добавить("Строк листа прочитано: " + ПротоколОтбора.Прочитано
			+ ", размечено «Матеріал»: " + ПротоколОтбора.ПоТипу
			+ ", подхвачено без типа: " + ПротоколОтбора.ПодхваченоБезТипа);

		ЗаполнитьТЧПоСтрокам(Комплектующие, МассивСтрок, Результат);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Комплектующие.Очистить();
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("ЗагрузкаМатериаловВСС.Ошибка",
			УровеньЖурналаРегистрации.Ошибка, , ЭтотОбъект.Ссылка, Результат.ТекстОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Заполняет оригинал модуля в табличной части КомплектующиеПоМодульно строками материалов листа «Проект СС».
// Строки модуля заменяются, строки других модулей сохраняются; модуль 0 — файл на всю СС (заменяет всё).
// Комплектующие НЕ изменяются. Отбор и разрешение ссылок — те же, что у ЗаполнитьКомплектующиеИзСырыхСтрок.
// Объект НЕ записывается.
//
// Параметры:
//  СырыеСтроки - Массив структур {Ряд, Тип, Этап, ОбщееНазвание, Наименование, Единица, Количество, Сумма}
//  Модуль      - Число - номер модуля, 0 — вся СС.
//
// Возвращаемое значение:
//  Структура - протокол загрузки (см. НовыйПротоколЗагрузки); Итоги — строк/количество/сумма файла.
//
Функция ЗаполнитьОригиналИзСырыхСтрок(СырыеСтроки, Модуль) Экспорт

	Результат = НовыйПротоколЗагрузки();
	Сохраненные = КомплектующиеПоМодульно.Выгрузить();

	НачатьТранзакцию();
	Попытка
		ПротоколОтбора = Неопределено;
		МассивСтрок = ОтобратьМатериалы(СырыеСтроки, ПротоколОтбора);

		Результат.ПодхваченоБезТипа = ПротоколОтбора.ПодхваченоБезТипа;
		Результат.СтопСтрока = ПротоколОтбора.СтопСтрока;
		Результат.ДеталиОтбора = ПротоколОтбора.ДеталиОтбора;
		Результат.Инфо.Добавить("Модуль " + Модуль + ". Строк листа прочитано: " + ПротоколОтбора.Прочитано
			+ ", размечено «Матеріал»: " + ПротоколОтбора.ПоТипу
			+ ", подхвачено без типа: " + ПротоколОтбора.ПодхваченоБезТипа);

		ЗаполнитьТЧПоСтрокам(КомплектующиеПоМодульно, МассивСтрок, Результат, Модуль);

		// Общие названия оригинала — как у бухгалтера в Комплектующие (если позиция там есть).
		А_СтруктураСебестоимостиСервер.ОтметитьДобавленныеВручную(ЭтотОбъект);
		Сопоставление = А_СтруктураСебестоимостиСервер.ПривестиСсылкиОригиналаККомплектующим(ЭтотОбъект, Модуль);
		Результат.Инфо.Добавить("Ссылки оригинала взяты из Комплектующих: " + Сопоставление.Сопоставлено
			+ ", позиций без пары (ссылки по файлу): " + Сопоставление.БезПары);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		КомплектующиеПоМодульно.Загрузить(Сохраненные);
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("ЗагрузкаОригиналаСС.Ошибка",
			УровеньЖурналаРегистрации.Ошибка, , ЭтотОбъект.Ссылка, Результат.ТекстОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Отбирает строки-материалы из "сырых" строк листа «Проект СС».
//
// Правила (применяются сверху вниз):
//  1. Чтение прекращается на шапке второй таблицы листа (наименование «№» или единица «Од. виміру»).
//  2. Ведётся текущий этап — последнее непустое значение колонки «Тип робіт».
//  3. Тип «Матеріал» — строка берётся; пустой этап наследуется от текущего.
//  4. Тип пустой — строка берётся, только если похожа на материал прораба:
//     текстовое наименование, текстовая единица, количество > 0 и сумма > 0. Этап — текущий.
//  5. Прочие типы («Робота» и т. п.) пропускаются.
//
// Параметры:
//  СырыеСтроки    - Массив структур {Ряд, Тип, Этап, ОбщееНазвание, Наименование, Единица, Количество, Сумма}
//  ПротоколОтбора - Структура (возвращается): Прочитано, ПоТипу, ПодхваченоБезТипа, СтопСтрока, ДеталиОтбора
//
// Возвращаемое значение:
//  Массив структур {Этап, ОбщееНазвание, НоменклатураСС, ЕдиницаСС, Количество, Сумма, Ряд}
//
Функция ОтобратьМатериалы(СырыеСтроки, ПротоколОтбора = Неопределено) Экспорт

	ПротоколОтбора = Новый Структура;
	ПротоколОтбора.Вставить("Прочитано", 0);
	ПротоколОтбора.Вставить("ПоТипу", 0);
	ПротоколОтбора.Вставить("ПодхваченоБезТипа", 0);
	ПротоколОтбора.Вставить("СтопСтрока", 0);
	ПротоколОтбора.Вставить("ДеталиОтбора", Новый Массив);

	Результат = Новый Массив;
	ТекущийЭтап = "";

	Для Каждого СыраяСтрока Из СырыеСтроки Цикл

		// ВНИМАНИЕ: в модуле объекта имена «Наименование», «Код», «Подразделение» и т. п. —
		// это реквизиты самого справочника. Локальные переменные строки файла названы иначе,
		// иначе разбор молча переписывает шапку элемента (ловилось приёмкой: имя менялось на «№»).
		Ряд = ?(СыраяСтрока.Свойство("Ряд"), СыраяСтрока.Ряд, 0);
		ТипСтроки = СокрЛП("" + СыраяСтрока.Тип);
		НаимСтроки = СокрЛП("" + СыраяСтрока.Наименование);
		ЕдиницаСтроки = СокрЛП("" + СыраяСтрока.Единица);

		// Ниже основной таблицы лежит вторая («Ст. затрат Упр. от…») — её строки не материалы.
		Если НаимСтроки = "№" ИЛИ НРег(ЕдиницаСтроки) = НРег("Од. виміру") Тогда
			ПротоколОтбора.СтопСтрока = Ряд;
			Прервать;
		КонецЕсли;
		ПротоколОтбора.Прочитано = ПротоколОтбора.Прочитано + 1;

		Этап = СокрЛП("" + СыраяСтрока.Этап);
		Если НЕ ПустаяСтрока(Этап) Тогда
			ТекущийЭтап = Этап;
		КонецЕсли;

		КоличествоСтроки = ЧислоИзЗначения(СыраяСтрока.Количество);
		СуммаСтроки = ЧислоИзЗначения(СыраяСтрока.Сумма);

		Если ТипСтроки = "Матеріал" Тогда
			Если ПустаяСтрока(НаимСтроки) Тогда
				Продолжить;
			КонецЕсли;
			ПротоколОтбора.ПоТипу = ПротоколОтбора.ПоТипу + 1;
		ИначеЕсли ПустаяСтрока(ТипСтроки) Тогда
			Если НЕ ЭтоПотерянныйМатериал(НаимСтроки, ЕдиницаСтроки, КоличествоСтроки, СуммаСтроки) Тогда
				Продолжить;
			КонецЕсли;
			ПротоколОтбора.ПодхваченоБезТипа = ПротоколОтбора.ПодхваченоБезТипа + 1;
			ПротоколОтбора.ДеталиОтбора.Добавить("строка Excel " + Ряд + ": «" + НаимСтроки + "» ("
				+ ?(ПустаяСтрока(ТекущийЭтап), "без этапа", ТекущийЭтап) + "), "
				+ КоличествоСтроки + " " + ЕдиницаСтроки + " = " + СуммаСтроки);
		Иначе
			Продолжить;
		КонецЕсли;

		Стр = Новый Структура("Этап, ОбщееНазвание, НоменклатураСС, ЕдиницаСС, Количество, Сумма, Ряд");
		Стр.Этап = ?(ПустаяСтрока(Этап), ТекущийЭтап, Этап);
		Стр.ОбщееНазвание = СокрЛП("" + СыраяСтрока.ОбщееНазвание);
		Стр.НоменклатураСС = НаимСтроки;
		Стр.ЕдиницаСС = ЕдиницаСтроки;
		Стр.Количество = КоличествоСтроки;
		Стр.Сумма = СуммаСтроки;
		Стр.Ряд = Ряд;
		Результат.Добавить(Стр);

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииЗагрузки

// Протокол загрузки: то, что кнопка формы выводит пользователю.
Функция НовыйПротоколЗагрузки()

	Протокол = Новый Структура;
	Протокол.Вставить("Загружено", 0);
	Протокол.Вставить("СозданоЭтапов", 0);
	Протокол.Вставить("СозданоНазваний", 0);
	Протокол.Вставить("ЗаполненоЕдиниц", 0);
	Протокол.Вставить("ДозаполненоЕдиниц", 0);
	Протокол.Вставить("Пропущено", 0);
	Протокол.Вставить("ПодхваченоБезТипа", 0);
	Протокол.Вставить("СтопСтрока", 0);
	Протокол.Вставить("ДеталиОтбора", Новый Массив);
	Протокол.Вставить("КонтрольПройден", Ложь);
	Протокол.Вставить("Контроль", Новый Массив);
	Протокол.Вставить("Инфо", Новый Массив);
	Протокол.Вставить("Предупреждения", Новый Массив);
	Протокол.Вставить("Ошибка", Ложь);
	Протокол.Вставить("ТекстОшибки", "");
	Протокол.Вставить("Итоги", Новый Структура("Строк, Количество, Сумма", 0, 0, 0));
	Возврат Протокол;

КонецФункции

// Заполнение приёмника строками отобранных материалов.
//
// Параметры:
//  ТЧ          - ТабличнаяЧасть - Комплектующие или КомплектующиеПоМодульно
//  МассивСтрок - Массив - результат ОтобратьМатериалы
//  Результат   - Структура - протокол загрузки
//  Модуль      - Неопределено - приёмник Комплектующие, очищается целиком;
//                Число - приёмник КомплектующиеПоМодульно: заменяются строки модуля (0 — все строки).
//
Процедура ЗаполнитьТЧПоСтрокам(ТЧ, МассивСтрок, Результат, Модуль = Неопределено)

	КэшЭтапов = ПостроитьКэшЭтапов();
	КэшНазваний = ПостроитьКэшНазваний();
	КэшЕдиниц = ПостроитьКэшЕдиниц();
	ЕдиницыНазваний = ЕдиницыПоНазваниямФайла(МассивСтрок, Результат);
	КлючиЕдиницКарточек = Новый Соответствие;

	ИтогиExcel = Новый Структура("Строк, Количество, Сумма, ПоЭтапам", 0, 0, 0, Новый Соответствие);

	Если Модуль = Неопределено Или Модуль = 0 Тогда
		ТЧ.Очистить();
	Иначе
		Для Индекс = -ТЧ.Количество() + 1 По 0 Цикл
			Если ТЧ[-Индекс].Модуль = Модуль Тогда
				ТЧ.Удалить(-Индекс);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого СтрокаДанных Из МассивСтрок Цикл

		НаимМатериала = СокрЛП("" + СтрокаДанных.НоменклатураСС);
		Если ПустаяСтрока(НаимМатериала) Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Этап = ПолучитьИлиСоздатьЭтап(СтрокаДанных.Этап, КэшЭтапов, Результат);
		ДанныеНазвания = ПолучитьИлиСоздатьНазвание(СтрокаДанных.ОбщееНазвание,
			КэшНазваний, КэшЕдиниц, ЕдиницыНазваний, Результат);

		НоваяСтрока = ТЧ.Добавить();
		НоваяСтрока.Этап = Этап;
		Если ДанныеНазвания <> Неопределено Тогда
			НоваяСтрока.ОбщееНазвание = ДанныеНазвания.Ссылка;
			НоваяСтрока.Номенклатура = ДанныеНазвания.ОсновнаяНоменклатура;
			НоваяСтрока.Единица = ДанныеНазвания.Единица;
		КонецЕсли;
		НоваяСтрока.НоменклатураСС = НаимМатериала;
		НоваяСтрока.ЕдиницаСС = СокрЛП("" + СтрокаДанных.ЕдиницаСС);
		НоваяСтрока.Количество = ПолучитьЧисло(СтрокаДанных, "Количество");
		НоваяСтрока.Сумма = ПолучитьЧисло(СтрокаДанных, "Сумма");
		НоваяСтрока.ЕдиницаСС_Оригинал = НоваяСтрока.ЕдиницаСС;
		НоваяСтрока.КоличествоСС_Оригинал = НоваяСтрока.Количество;
		НоваяСтрока.Цена = ?(НоваяСтрока.Количество = 0, 0, Окр(НоваяСтрока.Сумма / НоваяСтрока.Количество, 2));
		Если Модуль <> Неопределено Тогда
			// Оригинал: ПередЗаписью эту ТЧ не пересчитывает, признаки ставятся здесь.
			НоваяСтрока.Модуль = Модуль;
			НоваяСтрока.ЕдиницаОбщееНазвание = НоваяСтрока.Единица;
			НоваяСтрока.НеСовпадает = А_СтруктураСебестоимостиСервер.КлючЕдиницы(НоваяСтрока.ЕдиницаСС)
				<> КлючЕдиницыКарточки(НоваяСтрока.Единица, КлючиЕдиницКарточек);
		КонецЕсли;
		Результат.Загружено = Результат.Загружено + 1;

		КолОкр = Окр(НоваяСтрока.Количество, 3);
		СумОкр = Окр(НоваяСтрока.Сумма, 2);
		ИтогиExcel.Строк = ИтогиExcel.Строк + 1;
		ИтогиExcel.Количество = ИтогиExcel.Количество + КолОкр;
		ИтогиExcel.Сумма = ИтогиExcel.Сумма + СумОкр;
		СуммаЭтапа = ИтогиExcel.ПоЭтапам.Получить(Этап);
		ИтогиExcel.ПоЭтапам.Вставить(Этап, ?(СуммаЭтапа = Неопределено, 0, СуммаЭтапа) + СумОкр);

	КонецЦикла;

	Результат.Итоги.Строк = ИтогиExcel.Строк;
	Результат.Итоги.Количество = ИтогиExcel.Количество;
	Результат.Итоги.Сумма = ИтогиExcel.Сумма;

	ПроверитьКонтрольныеИтоги(ИтогиExcel, Результат, ТЧ, Модуль);
	ДополнитьИнформациейОЗаполненности(Результат, ТЧ, Модуль);

КонецПроцедуры

// Ключ единицы карточки общего названия (кэш на загрузку).
Функция КлючЕдиницыКарточки(Единица, Кэш)
	Если Не ЗначениеЗаполнено(Единица) Тогда
		Возврат "";
	КонецЕсли;
	Ключ = Кэш.Получить(Единица);
	Если Ключ = Неопределено Тогда
		Ключ = А_СтруктураСебестоимостиСервер.КлючЕдиницы(Единица.Наименование);
		Кэш.Вставить(Единица, Ключ);
	КонецЕсли;
	Возврат Ключ;
КонецФункции

// Строка ТЧ участвует в контроле: для Комплектующие — все строки, для оригинала — строки своего модуля.
Функция СтрокаМодуля(СтрокаТЧ, Модуль)
	Возврат Модуль = Неопределено Или Модуль = 0 Или СтрокаТЧ.Модуль = Модуль;
КонецФункции

// Истина, если строка без проставленного типа выглядит как реальный материал:
// текстовое наименование, текстовая единица, положительные количество и сумма.
Функция ЭтоПотерянныйМатериал(НаимСтроки, ЕдиницаСтроки, КоличествоСтроки, СуммаСтроки)
	Если ПустаяСтрока(НаимСтроки) ИЛИ ЧислоподобнаяСтрока(НаимСтроки) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПустаяСтрока(ЕдиницаСтроки) ИЛИ ЧислоподобнаяСтрока(ЕдиницаСтроки) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат КоличествоСтроки > 0 И СуммаСтроки > 0;
КонецФункции

// Истина, если текст состоит только из цифр, пробелов, точки, запятой и минуса.
// Так отсеиваются служебные строки-нумерация колонок вида «1 | 2 | 3 | 4».
Функция ЧислоподобнаяСтрока(Знач Текст)
	Текст = СтрЗаменить(СокрЛП(Текст), " ", "");
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Разрешенные = "0123456789.,-";
	Для Поз = 1 По СтрДлина(Текст) Цикл
		Если Найти(Разрешенные, Сред(Текст, Поз, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Числовое значение ячейки (пусто/не число -> 0).
Функция ЧислоИзЗначения(Значение)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

// Возвращает числовое значение поля структуры по имени (пусто/не число -> 0).
Функция ПолучитьЧисло(СтрокаДанных, ИмяПоля)
	Если НЕ СтрокаДанных.Свойство(ИмяПоля) Тогда
		Возврат 0;
	КонецЕсли;
	Значение = СтрокаДанных[ИмяПоля];
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

// Нормализация: убрать концевые пробелы + схлопнуть любые серии пробелов в один.
Функция НормализоватьНаименование(Знач Текст) Экспорт
	Возврат А_СтруктураСебестоимостиСервер.НормализоватьНаименование(Текст);
КонецФункции

// Кэш этапов: НРег(нормализованное наименование) -> Ссылка.
Функция ПостроитьКэшЭтапов()
	Кэш = Новый Соответствие;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЭтапыРабот.Наименование КАК Наименование,
	|	ЭтапыРабот.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЭтапыРабот КАК ЭтапыРабот");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = НРег(НормализоватьНаименование(Выборка.Наименование));
		Если Кэш.Получить(Ключ) = Неопределено Тогда
			Кэш.Вставить(Ключ, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Кэш;
КонецФункции

Функция ПолучитьИлиСоздатьЭтап(Знач Наим, КэшЭтапов, Результат)
	НормИмя = НормализоватьНаименование(Наим);
	Если ПустаяСтрока(НормИмя) Тогда
		Возврат Справочники.ЭтапыРабот.ПустаяСсылка();
	КонецЕсли;
	Ключ = НРег(НормИмя);
	Найденное = КэшЭтапов.Получить(Ключ);
	Если Найденное <> Неопределено Тогда
		Возврат Найденное;
	КонецЕсли;

	НовыйЭтап = Справочники.ЭтапыРабот.СоздатьЭлемент();
	НовыйЭтап.Наименование = НормИмя;
	НовыйЭтап.Записать();
	КэшЭтапов.Вставить(Ключ, НовыйЭтап.Ссылка);
	Результат.СозданоЭтапов = Результат.СозданоЭтапов + 1;
	Результат.Инфо.Добавить("создан этап работ «" + НормИмя + "»");
	Возврат НовыйЭтап.Ссылка;
КонецФункции

// Кэш общих названий: НРег(нормализованное наименование) -> Структура(Ссылка, ОсновнаяНоменклатура, Единица).
Функция ПостроитьКэшНазваний()
	Кэш = Новый Соответствие;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ОбщиеНазвания.Наименование КАК Наименование,
	|	ОбщиеНазвания.Ссылка КАК Ссылка,
	|	ОбщиеНазвания.ОсновнаяНоменклатура КАК ОсновнаяНоменклатура,
	|	ОбщиеНазвания.Единица КАК Единица
	|ИЗ
	|	Справочник.ОбщиеНазванияНоменклатуры КАК ОбщиеНазвания
	|ГДЕ
	|	НЕ ОбщиеНазвания.ЭтоГруппа");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = НРег(НормализоватьНаименование(Выборка.Наименование));
		Если Кэш.Получить(Ключ) = Неопределено Тогда
			Данные = Новый Структура("Ссылка, ОсновнаяНоменклатура, Единица, ЕдиницаПроверена",
				Выборка.Ссылка, Выборка.ОсновнаяНоменклатура, Выборка.Единица, Ложь);
			Кэш.Вставить(Ключ, Данные);
		КонецЕсли;
	КонецЦикла;
	Возврат Кэш;
КонецФункции

// Единица карточки берётся из строкового ЕдиницаСС файла (см. ЕдиницыПоНазваниямФайла):
// у новой карточки — при создании, у существующей — только если она ПУСТАЯ.
// Заполненная единица существующей карточки не изменяется никогда.
Функция ПолучитьИлиСоздатьНазвание(Знач Наим, КэшНазваний, КэшЕдиниц, ЕдиницыНазваний, Результат)

	НормИмя = НормализоватьНаименование(Наим);
	Если ПустаяСтрока(НормИмя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ключ = НРег(НормИмя);
	Найденное = КэшНазваний.Получить(Ключ);
	Если Найденное <> Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(Найденное.Единица) И НЕ Найденное.ЕдиницаПроверена Тогда
			Найденное.ЕдиницаПроверена = Истина;
			ДозаполнитьЕдиницуКарточки(Найденное, НормИмя, КэшЕдиниц,
				ЕдиницыНазваний.Получить(Ключ), Результат);
		КонецЕсли;
		Возврат Найденное;
	КонецЕсли;

	ЕдиницаСтрокой = ЕдиницыНазваний.Получить(Ключ);
	ЕдиницаЭлемент = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
	Если ЕдиницаСтрокой <> Неопределено Тогда
		НайденнаяЕдиница = НайтиЕдиницу(ЕдиницаСтрокой, КэшЕдиниц);
		Если НайденнаяЕдиница = Неопределено Тогда
			Результат.Предупреждения.Добавить("новое общее название «" + НормИмя + "»: единица «"
				+ ЕдиницаСтрокой + "» не найдена в классификаторе — карточка создана без единицы");
		Иначе
			ЕдиницаЭлемент = НайденнаяЕдиница;
		КонецЕсли;
	КонецЕсли;

	НовоеНазвание = Справочники.ОбщиеНазванияНоменклатуры.СоздатьЭлемент();
	НовоеНазвание.Наименование = НормИмя;
	НовоеНазвание.Единица = ЕдиницаЭлемент;
	НовоеНазвание.Записать();

	Если ЗначениеЗаполнено(ЕдиницаЭлемент) Тогда
		Результат.ЗаполненоЕдиниц = Результат.ЗаполненоЕдиниц + 1;
		Результат.Инфо.Добавить("создано общее название «" + НормИмя + "», единица «"
			+ СокрЛП(Строка(ЕдиницаЭлемент)) + "» (из «" + ЕдиницаСтрокой + "»)");
	Иначе
		Результат.Инфо.Добавить("создано общее название «" + НормИмя + "» без единицы");
	КонецЕсли;

	Данные = Новый Структура("Ссылка, ОсновнаяНоменклатура, Единица, ЕдиницаПроверена",
		НовоеНазвание.Ссылка, НовоеНазвание.ОсновнаяНоменклатура, НовоеНазвание.Единица, Истина);
	КэшНазваний.Вставить(Ключ, Данные);
	Результат.СозданоНазваний = Результат.СозданоНазваний + 1;
	Возврат Данные;

КонецФункции

// Дозаполнение единицы у СУЩЕСТВУЮЩЕЙ карточки: только когда она пустая.
// Иначе строка ТЧ остаётся без единицы и «Одиниця заг. назва» в форме пустая,
// хотя прораб единицу в файле указал.
Процедура ДозаполнитьЕдиницуКарточки(Данные, Знач НормИмя, КэшЕдиниц, Знач ЕдиницаСтрокой, Результат)

	Если ЕдиницаСтрокой = Неопределено ИЛИ ПустаяСтрока(ЕдиницаСтрокой) Тогда
		Возврат;
	КонецЕсли;

	НайденнаяЕдиница = НайтиЕдиницу(ЕдиницаСтрокой, КэшЕдиниц);
	Если НайденнаяЕдиница = Неопределено Тогда
		Результат.Предупреждения.Добавить("общее название «" + НормИмя + "»: единица «"
			+ ЕдиницаСтрокой + "» не найдена в классификаторе — осталась пустой");
		Возврат;
	КонецЕсли;

	КарточкаОбъект = Данные.Ссылка.ПолучитьОбъект();
	Если КарточкаОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Между построением кэша и записью единицу мог проставить кто-то ещё — чужое значение важнее.
	Если ЗначениеЗаполнено(КарточкаОбъект.Единица) Тогда
		Данные.Единица = КарточкаОбъект.Единица;
		Возврат;
	КонецЕсли;

	КарточкаОбъект.Единица = НайденнаяЕдиница;
	КарточкаОбъект.Записать();

	Данные.Единица = НайденнаяЕдиница;
	Результат.ДозаполненоЕдиниц = Результат.ДозаполненоЕдиниц + 1;
	Результат.Инфо.Добавить("дозаполнена единица «" + СокрЛП(Строка(НайденнаяЕдиница))
		+ "» у общего названия «" + НормИмя + "» (из «" + ЕдиницаСтрокой + "»)");

КонецПроцедуры

// По каждому общему названию файла определяет строковую единицу для НОВОЙ карточки:
// самая частая единица среди строк этого названия, при ничьей — первая встреченная.
// Расхождения единиц у одного названия попадают в предупреждения протокола.
//
// Возвращаемое значение:
//  Соответствие - НРег(нормализованное название) -> Строка (единица как в файле).
//
Функция ЕдиницыПоНазваниямФайла(МассивСтрок, Результат)

	Счетчики = Новый Соответствие;
	Первые = Новый Соответствие;
	Названия = Новый Соответствие;

	Для Каждого СтрокаДанных Из МассивСтрок Цикл
		НормИмя = НормализоватьНаименование(СтрокаДанных.ОбщееНазвание);
		Если ПустаяСтрока(НормИмя) Тогда
			Продолжить;
		КонецЕсли;
		Единица = СокрЛП("" + СтрокаДанных.ЕдиницаСС);
		Если ПустаяСтрока(Единица) Тогда
			Продолжить;
		КонецЕсли;

		Ключ = НРег(НормИмя);
		Названия.Вставить(Ключ, НормИмя);
		ПоЕдиницам = Счетчики.Получить(Ключ);
		Если ПоЕдиницам = Неопределено Тогда
			ПоЕдиницам = Новый Соответствие;
			Счетчики.Вставить(Ключ, ПоЕдиницам);
			Первые.Вставить(Ключ, Единица);
		КонецЕсли;
		Было = ПоЕдиницам.Получить(Единица);
		ПоЕдиницам.Вставить(Единица, ?(Было = Неопределено, 0, Было) + 1);
	КонецЦикла;

	ЕдиницыНазваний = Новый Соответствие;
	Для Каждого КлючЗначение Из Счетчики Цикл
		ПоЕдиницам = КлючЗначение.Значение;
		Лучшая = Первые.Получить(КлючЗначение.Ключ);
		ЛучшийСчет = ПоЕдиницам.Получить(Лучшая);
		Перечень = "";
		Для Каждого ЕдиницаИСчет Из ПоЕдиницам Цикл
			Если ЕдиницаИСчет.Значение > ЛучшийСчет Тогда
				Лучшая = ЕдиницаИСчет.Ключ;
				ЛучшийСчет = ЕдиницаИСчет.Значение;
			КонецЕсли;
			Перечень = Перечень + ?(ПустаяСтрока(Перечень), "", ", ")
				+ "«" + ЕдиницаИСчет.Ключ + "» x" + ЕдиницаИСчет.Значение;
		КонецЦикла;
		ЕдиницыНазваний.Вставить(КлючЗначение.Ключ, Лучшая);
		Если ПоЕдиницам.Количество() > 1 Тогда
			Результат.Предупреждения.Добавить("у названия «" + Названия.Получить(КлючЗначение.Ключ)
				+ "» в файле разные единицы (" + Перечень + ") — для новой карточки взята «" + Лучшая + "»");
		КонецЕсли;
	КонецЦикла;

	Возврат ЕдиницыНазваний;

КонецФункции

// Кэш классификатора единиц. Помеченные на удаление отброшены запросом,
// порядок «частота использования убыв, код» делает первого кандидата каноническим:
// на живых данных это «шт» (2009, а не « шт»), « т» (0306, «т» помечен на удаление), «м3» (0134).
//
// Возвращаемое значение:
//  Структура - Точные (Соответствие наименование -> Ссылка),
//              Нормализованные (Соответствие НРег(нормализованное) -> Ссылка).
//
Функция ПостроитьКэшЕдиниц()

	Кэш = Новый Структура("Точные, Нормализованные", Новый Соответствие, Новый Соответствие);

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Единицы.Ссылка КАК Ссылка,
	|	Единицы.Наименование КАК Наименование,
	|	Единицы.Код КАК Код,
	|	ЕСТЬNULL(Частоты.Частота, 0) КАК Частота
	|ИЗ
	|	Справочник.КлассификаторЕдиницИзмерения КАК Единицы
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Номенклатура.БазоваяЕдиницаИзмерения КАК Единица,
	|			КОЛИЧЕСТВО(*) КАК Частота
	|		ИЗ
	|			Справочник.Номенклатура КАК Номенклатура
	|		ГДЕ
	|			НЕ Номенклатура.ПометкаУдаления
	|		СГРУППИРОВАТЬ ПО
	|			Номенклатура.БазоваяЕдиницаИзмерения) КАК Частоты
	|		ПО Единицы.Ссылка = Частоты.Единица
	|ГДЕ
	|	НЕ Единицы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Частота УБЫВ,
	|	Код");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючТочный = СокрЛП(Выборка.Наименование);
		Если НЕ ПустаяСтрока(КлючТочный) И Кэш.Точные.Получить(КлючТочный) = Неопределено Тогда
			Кэш.Точные.Вставить(КлючТочный, Выборка.Ссылка);
		КонецЕсли;
		КлючНорм = НРег(НормализоватьНаименование(Выборка.Наименование));
		Если НЕ ПустаяСтрока(КлючНорм) И Кэш.Нормализованные.Получить(КлючНорм) = Неопределено Тогда
			Кэш.Нормализованные.Вставить(КлючНорм, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Возврат Кэш;

КонецФункции

// Строковая единица прораба -> элемент классификатора.
// Порядок: точное наименование -> нормализованное -> синоним -> Неопределено.
Функция НайтиЕдиницу(Знач ЕдиницаСтрокой, КэшЕдиниц)

	Текст = СокрЛП("" + ЕдиницаСтрокой);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Найденное = КэшЕдиниц.Точные.Получить(Текст);
	Если Найденное <> Неопределено Тогда
		Возврат Найденное;
	КонецЕсли;

	Ключ = НРег(НормализоватьНаименование(Текст));
	Найденное = КэшЕдиниц.Нормализованные.Получить(Ключ);
	Если Найденное <> Неопределено Тогда
		Возврат Найденное;
	КонецЕсли;

	Синоним = СинонимЕдиницы(Ключ);
	Если Синоним = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Найденное = КэшЕдиниц.Точные.Получить(Синоним);
	Если Найденное <> Неопределено Тогда
		Возврат Найденное;
	КонецЕсли;

	Возврат КэшЕдиниц.Нормализованные.Получить(НРег(Синоним));

КонецФункции

// Написания прорабов, которых нет в классификаторе, — к каноническому наименованию.
Функция СинонимЕдиницы(Знач Ключ)
	Возврат А_СтруктураСебестоимостиСервер.СинонимЕдиницы(Ключ);
КонецФункции

// Истина, если модуль разницы двух чисел превышает допуск.
Функция ПревышаетДопуск(А, Б, Допуск)
	Возврат ?(А > Б, А - Б, Б - А) > Допуск;
КонецФункции

// Контроль в момент загрузки: сверяет итоги файла с фактом в табличной части.
// Объект не записан, поэтому сверка идёт с ТЧ в памяти — квалификаторы реквизитов
// применяются при присваивании, так что обрезание дробей ловится.
// При расхождении вызывает исключение — внешний обработчик откатит транзакцию и очистит ТЧ.
Процедура ПроверитьКонтрольныеИтоги(ИтогиExcel, Результат, ТЧ, Модуль)

	Допуск = 0.005;
	Расхождения = "";

	СтрокТЧ = 0;
	КоличествоТЧ = 0;
	СуммаТЧ = 0;
	ЭтапыТЧ = Новый Соответствие;
	Для Каждого СтрокаТЧ Из ТЧ Цикл
		Если Не СтрокаМодуля(СтрокаТЧ, Модуль) Тогда
			Продолжить;
		КонецЕсли;
		СтрокТЧ = СтрокТЧ + 1;
		КоличествоСтроки = Окр(СтрокаТЧ.Количество, 3);
		СуммаСтроки = Окр(СтрокаТЧ.Сумма, 2);
		КоличествоТЧ = КоличествоТЧ + КоличествоСтроки;
		СуммаТЧ = СуммаТЧ + СуммаСтроки;
		Накоплено = ЭтапыТЧ.Получить(СтрокаТЧ.Этап);
		ЭтапыТЧ.Вставить(СтрокаТЧ.Этап, ?(Накоплено = Неопределено, 0, Накоплено) + СуммаСтроки);
	КонецЦикла;

	Результат.Контроль.Добавить("Строк:        файл = " + ИтогиExcel.Строк + ", ТЧ = " + СтрокТЧ);
	Результат.Контроль.Добавить("Σ Количество: файл = " + ИтогиExcel.Количество + ", ТЧ = " + КоличествоТЧ);
	Результат.Контроль.Добавить("Σ Сумма:      файл = " + ИтогиExcel.Сумма + ", ТЧ = " + СуммаТЧ);

	Если СтрокТЧ <> ИтогиExcel.Строк Тогда
		Расхождения = Расхождения + Символы.ПС + "строк: файл=" + ИтогиExcel.Строк + ", ТЧ=" + СтрокТЧ;
	КонецЕсли;
	Если ПревышаетДопуск(КоличествоТЧ, ИтогиExcel.Количество, Допуск) Тогда
		Расхождения = Расхождения + Символы.ПС + "Σ Количество: файл=" + ИтогиExcel.Количество + ", ТЧ=" + КоличествоТЧ;
	КонецЕсли;
	Если ПревышаетДопуск(СуммаТЧ, ИтогиExcel.Сумма, Допуск) Тогда
		Расхождения = Расхождения + Символы.ПС + "Σ Сумма: файл=" + ИтогиExcel.Сумма + ", ТЧ=" + СуммаТЧ;
	КонецЕсли;

	Для Каждого КлючЗначение Из ИтогиExcel.ПоЭтапам Цикл
		СуммаЭтапаТЧ = ЭтапыТЧ.Получить(КлючЗначение.Ключ);
		СуммаЭтапаТЧ = ?(СуммаЭтапаТЧ = Неопределено, 0, СуммаЭтапаТЧ);
		Результат.Контроль.Добавить("Этап " + КлючЗначение.Ключ + ": файл = "
			+ КлючЗначение.Значение + ", ТЧ = " + СуммаЭтапаТЧ);
		Если ПревышаетДопуск(СуммаЭтапаТЧ, КлючЗначение.Значение, Допуск) Тогда
			Расхождения = Расхождения + Символы.ПС + "этап " + КлючЗначение.Ключ
				+ ": файл=" + КлючЗначение.Значение + ", ТЧ=" + СуммаЭтапаТЧ;
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючЗначение Из ЭтапыТЧ Цикл
		Если ИтогиExcel.ПоЭтапам.Получить(КлючЗначение.Ключ) = Неопределено Тогда
			Расхождения = Расхождения + Символы.ПС + "этап " + КлючЗначение.Ключ + " есть в ТЧ, нет в файле";
		КонецЕсли;
	КонецЦикла;

	Если НЕ ПустаяСтрока(Расхождения) Тогда
		ВызватьИсключение "КОНТРОЛЬ ЗАГРУЗКИ НЕ ПРОЙДЕН:" + Расхождения;
	КонецЕсли;
	Результат.КонтрольПройден = Истина;

КонецПроцедуры

// Что бухгалтеру предстоит дозаполнить руками после загрузки.
Процедура ДополнитьИнформациейОЗаполненности(Результат, ТЧ, Модуль)

	Наименования = Новый Соответствие;
	БезОбщегоНазвания = 0;
	БезЕдиницы = 0;
	БезНоменклатуры = 0;

	Для Каждого СтрокаТЧ Из ТЧ Цикл
		Если Не СтрокаМодуля(СтрокаТЧ, Модуль) Тогда
			Продолжить;
		КонецЕсли;
		Наименования.Вставить(НРег(СтрокаТЧ.НоменклатураСС), Истина);
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ОбщееНазвание) Тогда
			БезОбщегоНазвания = БезОбщегоНазвания + 1;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Единица) Тогда
			БезЕдиницы = БезЕдиницы + 1;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
			БезНоменклатуры = БезНоменклатуры + 1;
		КонецЕсли;
	КонецЦикла;

	Результат.Инфо.Добавить("Уникальных наименований: " + Наименования.Количество());
	Результат.Инфо.Добавить("Без общего названия: " + БезОбщегоНазвания
		+ ", без единицы: " + БезЕдиницы + ", без номенклатуры: " + БезНоменклатуры);

КонецПроцедуры

#КонецОбласти
