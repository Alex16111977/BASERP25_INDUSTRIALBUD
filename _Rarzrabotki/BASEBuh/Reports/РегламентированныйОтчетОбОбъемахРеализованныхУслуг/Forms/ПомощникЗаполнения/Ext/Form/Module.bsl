			Или ТипДокумента = Тип("ДокументСсылка.РегламентнаяОперация") Тогда 
				//пропускаем 
				
		Иначе  //операция, РеализацияУслугПрочихАктивов
			НоваяСтрока = Таблица.Добавить();
			НоваяСтрока.Документ = ДокументРегистратор;
			НоваяСтрока.Счет = Счет;
