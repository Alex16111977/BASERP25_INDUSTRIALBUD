&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Организация = Параметры.Организация;
	НачалоПериода = Параметры.НачалоПериода;
	ОкончаниеПериода = Параметры.ОкончаниеПериода;
	
	КлассификаторКВЕД	= ПолучитьСписокКВЕД();   
	Элементы.ТаблицаКВЕД.СписокВыбора.Очистить();
	Для каждого ЭлементСпискаКВЕД Из КлассификаторКВЕД Цикл
		Элементы.ТаблицаКВЕД.СписокВыбора.Добавить(ЭлементСпискаКВЕД.Значение, ЭлементСпискаКВЕД.Значение + " " + ЭлементСпискаКВЕД.Представление);
	КонецЦикла;

 	ИДКонфигурации = РегламентированнаяОтчетностьПереопределяемый.ИДКонфигурации();

	Если ЗначениеЗаполнено(Параметры.СохраненныйДокумент) Тогда
		
		СписокСохранения = Параметры.СохраненныйДокумент.ДанныеОтчета.Получить(); 
		Попытка
			ЗначениеВРеквизитФормы(СписокСохранения.Таблица, "Таблица");
		Исключение
		КонецПопытки;
		ЗначениеВРеквизитФормы(СписокСохранения.T1R, "T1R");            
		Попытка
			ЗначениеВРеквизитФормы(СписокСохранения.ТаблицаКВЕД, "ТаблицаКВЕД");			
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	Элементы.ТаблицаСубконто2.Видимость =  ?(ИДКонфигурации = "ЕРП", Ложь, Истина);
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьДанные(ИдентификаторФормы)
	
	ЗаполнитьИтоговуюТаблицу();
	
	СписокСохранения = Новый Структура;
	СписокСохранения.Вставить("Таблица", РеквизитФормыВЗначение("Таблица"));
	СписокСохранения.Вставить("T1R", РеквизитФормыВЗначение("T1R"));
	СписокСохранения.Вставить("ТаблицаКВЕД", РеквизитФормыВЗначение("ТаблицаКВЕД"));
	
	Возврат ПоместитьВоВременноеХранилище(СписокСохранения, ИдентификаторФормы);

КонецФункции

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	Если ПроверитьЗаполнение() Тогда
		
		ВладелецФормы.СохранитьДокументЗаполнения(ПодготовитьДанные(ВладелецФормы.УникальныйИдентификатор));   
		
		Закрыть(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИтоговуюТаблицу()

	T1R.Очистить();
	
	ТЗ = T1R.Выгрузить();
	Для каждого ИсходнаяСтрока ИЗ Таблица Цикл
		
		Если НЕ ИсходнаяСтрока.Флаг Тогда
			Продолжить;
		КонецЕсли;
		НомерПериода = Месяц(ИсходнаяСтрока.ДатаДокумента)%3; 
		
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.T1RXXXXG2S = ИсходнаяСтрока.КВЕД;
		НоваяСтрока.T1RXXXXG6S = ИсходнаяСтрока.ВЕД;
		НоваяСтрока.T1RXXXXG3 = 0;
		НоваяСтрока.T1RXXXXG4 = ?(НомерПериода = 1,ИсходнаяСтрока.СуммаДокумента,0);
		НоваяСтрока.T1RXXXXG5 = ?(НомерПериода = 2,ИсходнаяСтрока.СуммаДокумента,0);
		НоваяСтрока.T1RXXXXG7 = ?(НомерПериода = 0,ИсходнаяСтрока.СуммаДокумента,0);
		
	КонецЦикла;
	ТЗ.Свернуть("T1RXXXXНомерСтроки, T1RXXXXG2S, T1RXXXXG6S","T1RXXXXG3, T1RXXXXG4, T1RXXXXG5, T1RXXXXG7");
	ТЗ.Сортировать("T1RXXXXG2S");
	
	НомСтр = 0;
	Для каждого СтрокаТЗ Из ТЗ Цикл
		НомСтр = НомСтр + 1;
		СтрокаТЗ.T1RXXXXНомерСтроки = НомСтр;
		СтрокаТЗ.T1RXXXXG3 = ОкруглитьЧислоПоФормату(СтрокаТЗ.T1RXXXXG4) 
							+ ОкруглитьЧислоПоФормату(СтрокаТЗ.T1RXXXXG5) 
							+ ОкруглитьЧислоПоФормату(СтрокаТЗ.T1RXXXXG7);
	КонецЦикла;
	
	T1R.Загрузить(ТЗ);
	
	//сохраним список КВЕД для подбора в следующем периоде
	ТН = ТаблицаКВЕД.Выгрузить();
	
	ПолнаяТаблица = Таблица.Выгрузить();
	ПолнаяТаблица.Свернуть("Субконто3, Субконто2, Субконто1, КВЕД");
	//выберем строки с заполненным КВЕД
	КоличествоИндексов = ПолнаяТаблица.Количество() - 1;
	Для Индекс = 0 По КоличествоИндексов Цикл
		Строка = ПолнаяТаблица[КоличествоИндексов - Индекс];
		Если НЕ ЗначениеЗаполнено(Строка.КВЕД) Тогда
			ПолнаяТаблица.Удалить(Строка);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаПоНомеклатуре = ПолнаяТаблица.Скопировать();
	ТаблицаПоНомеклатуре.Свернуть("Субконто3, КВЕД");
	Для каждого ИсходнаяСтрока ИЗ ТаблицаПоНомеклатуре Цикл
		
		Если НЕ ЗначениеЗаполнено(ИсходнаяСтрока.Субконто3) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиИсх = ТаблицаПоНомеклатуре.НайтиСтроки(Новый Структура("Субконто3", ИсходнаяСтрока.Субконто3));
		Если СтрокиИсх.Количество() > 1 Тогда 
			//для одной аналитики несколько КВЕД, пропускаем
			Продолжить;
		КонецЕсли;
		
		Строки = ТН.НайтиСтроки(Новый Структура("Аналитика", ИсходнаяСтрока.Субконто3));
		Если Строки.Количество() > 0 Тогда 
			//для уже существующей переписываем КВЕД
		    Строки[0].КВЕД = ИсходнаяСтрока.КВЕД; 
		Иначе
			
			НоваяСтрока = ТН.Добавить();
			НоваяСтрока.Аналитика = ИсходнаяСтрока.Субконто3;
			НоваяСтрока.КВЕД = ИсходнаяСтрока.КВЕД;
		КонецЕсли; 
		
	КонецЦикла;                                 
	
	// удалить строки с заполенной номенклатурой      
	СтрокиБезНоменклатуры = ПолнаяТаблица.НайтиСтроки(Новый Структура("Субконто3", Неопределено));
	ТаблицаПоНоменклатурнымГруппам = ПолнаяТаблица.Скопировать(СтрокиБезНоменклатуры);
	ТаблицаПоНоменклатурнымГруппам.Свернуть("Субконто2, КВЕД");
	Для каждого ИсходнаяСтрока ИЗ ТаблицаПоНоменклатурнымГруппам Цикл
		
		Если НЕ ЗначениеЗаполнено(ИсходнаяСтрока.Субконто2) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиИсх = ТаблицаПоНоменклатурнымГруппам.НайтиСтроки(Новый Структура("Субконто2", ИсходнаяСтрока.Субконто2));
		Если СтрокиИсх.Количество() > 1 Тогда 
			//для одной аналитики несколько КВЕД, пропускаем
			Продолжить;
		КонецЕсли;
		
		Строки = ТН.НайтиСтроки(Новый Структура("Аналитика", ИсходнаяСтрока.Субконто2));
		Если Строки.Количество() > 0 Тогда 
			//для уже существующей переписываем КВЕД
		    Строки[0].КВЕД = ИсходнаяСтрока.КВЕД; 
		Иначе
			
			НоваяСтрока = ТН.Добавить();
			НоваяСтрока.Аналитика = ИсходнаяСтрока.Субконто2;
			НоваяСтрока.КВЕД = ИсходнаяСтрока.КВЕД;
		КонецЕсли; 
		
	КонецЦикла;                                 
	
	// берем только строки, с пустыми 
	СтрокиБезНоменклатурыИНоменклатурныхГрупп = ПолнаяТаблица.НайтиСтроки(Новый Структура("Субконто2,Субконто3", Неопределено, Неопределено));
	ТаблицаПоСтатьямДоходов = ПолнаяТаблица.Скопировать(СтрокиБезНоменклатурыИНоменклатурныхГрупп);
	ТаблицаПоСтатьямДоходов.Свернуть("Субконто1, КВЕД");
	Для каждого ИсходнаяСтрока ИЗ ТаблицаПоСтатьямДоходов Цикл
		
		Если НЕ ЗначениеЗаполнено(ИсходнаяСтрока.Субконто1) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиИсх = ТаблицаПоСтатьямДоходов.НайтиСтроки(Новый Структура("Субконто1", ИсходнаяСтрока.Субконто1));
		Если СтрокиИсх.Количество() > 1 Тогда 
			//для одной аналитики несколько КВЕД, пропускаем
			Продолжить;
		КонецЕсли;
		
		Строки = ТН.НайтиСтроки(Новый Структура("Аналитика", ИсходнаяСтрока.Субконто1));
		Если Строки.Количество() > 0 Тогда 
			//для уже существующей переписываем КВЕД
		    Строки[0].КВЕД = ИсходнаяСтрока.КВЕД; 
		Иначе
			
			НоваяСтрока = ТН.Добавить();
			НоваяСтрока.Аналитика = ИсходнаяСтрока.Субконто1;
			НоваяСтрока.КВЕД = ИсходнаяСтрока.КВЕД;
		КонецЕсли; 
		
	КонецЦикла;                                 
	
	ТаблицаКВЕД.Загрузить(ТН);
	
КонецПроцедуры

// ОкруглитьЧислоПоФормату(Форма, )
//
&НаКлиентеНаСервереБезКонтекста
Функция ОкруглитьЧислоПоФормату(ИсходноеЧисло)
		
	Возврат Окр(ИсходноеЧисло / 1000, 1) * 1000;
	
КонецФункции // ОкруглитьЧислоПоФормату(Форма, )

&НаСервере
Процедура АвтоподборНаСервере() 
	
	Таблица.Очистить();

 	ИДКонфигурации = РегламентированнаяОтчетностьПереопределяемый.ИДКонфигурации(); 
	ИДКонф = РегламентированнаяОтчетностьПереопределяемый.ИДКонфигурации(Истина);
	
	Если ИДКонфигурации = "ЕРП" Тогда 
		ЗапросВыручка = Новый Запрос;
		ЗапросВыручка.УстановитьПараметр("НачалоПериода", НачалоПериода);
		ЗапросВыручка.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
		ЗапросВыручка.УстановитьПараметр("Организация", Организация);
		ЗапросВыручка.УстановитьПараметр("ТипЗапасовУслуга", Перечисления.ТипыЗапасов.Услуга); 
		
		Если ФлагНЕОтображатьДокумент Тогда

			ТекстЗапросаВыручка = 
			"ВЫБРАТЬ
			|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
			|	СУММА(ВыручкаИСебестоимостьПродажОбороты.СуммаВыручкиРеглОборот) КАК Сумма,
			|	НАЧАЛОПЕРИОДА(ВыручкаИСебестоимостьПродажОбороты.Период, МЕСЯЦ) КАК Период
			|ИЗ
			|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(&НачалоПериода, &ОкончаниеПериода, Регистратор, ) КАК ВыручкаИСебестоимостьПродажОбороты
			|ГДЕ
			|	ВыручкаИСебестоимостьПродажОбороты.ТипЗапасов = &ТипЗапасовУслуга
			|	И ВыручкаИСебестоимостьПродажОбороты.Регистратор.Организация = &Организация
			|
			|СГРУППИРОВАТЬ ПО
			|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура,
			|	НАЧАЛОПЕРИОДА(ВыручкаИСебестоимостьПродажОбороты.Период, МЕСЯЦ)";
		
		
		Иначе	
			
			ТекстЗапросаВыручка = 
			"ВЫБРАТЬ
			|	ВыручкаИСебестоимостьПродажОбороты.Регистратор КАК Регистратор,
			|	ВыручкаИСебестоимостьПродажОбороты.Период КАК Период,
			|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
			|	СУММА(ВыручкаИСебестоимостьПродажОбороты.СуммаВыручкиРеглОборот) КАК Сумма
			|ИЗ
			|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(&НачалоПериода, &ОкончаниеПериода, Регистратор, ) КАК ВыручкаИСебестоимостьПродажОбороты
			|ГДЕ
			|	ВыручкаИСебестоимостьПродажОбороты.ТипЗапасов = &ТипЗапасовУслуга
			|	И ВыручкаИСебестоимостьПродажОбороты.Регистратор.Организация = &Организация
			|
			|СГРУППИРОВАТЬ ПО
			|	ВыручкаИСебестоимостьПродажОбороты.Регистратор,
			|	ВыручкаИСебестоимостьПродажОбороты.Период,
			|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура";
			
		КонецЕсли;
		
		ЗапросВыручка.Текст = ТекстЗапросаВыручка;
		
		РезультатЗапроса = ЗапросВыручка.Выполнить();
		ВыборкаВыручка = РезультатЗапроса.Выбрать(); 
		
		Пока ВыборкаВыручка.Следующий() Цикл  
			
			НоваяСтрока = Таблица.Добавить();
			Если НЕ ФлагНЕОтображатьДокумент Тогда
				НоваяСтрока.Документ = ВыборкаВыручка.Регистратор;
			КонецЕсли;
			НоваяСтрока.Субконто3 = ВыборкаВыручка.Номенклатура;
			НоваяСтрока.ДатаДокумента = ВыборкаВыручка.Период;
			ЗаполнитьКВЕДВСтрокеАналитика(НоваяСтрока);
			НоваяСтрока.Флаг= КВЕДВключаетсяВОтчет(НоваяСтрока.КВЕД);
			НоваяСтрока.ВЕД = ПолучитьНаименованиеВЕД(НоваяСтрока.КВЕД);
			НоваяСтрока.СуммаДокумента = ВыборкаВыручка.Сумма;
			
		КонецЦикла;
		
	    //оставшиеся документы
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
		Запрос.УстановитьПараметр("Организация", Организация);
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
			|	Услуги.Период КАК Период,
			|	Услуги.Регистратор КАК Регистратор,
			|	Услуги.СчетКт КАК Счет,
			|	Услуги.СубконтоКт1 КАК СубконтоКт1,
			|	Услуги.СубконтоКт2 КАК СубконтоКт2,
			|	Услуги.СуммаОборот КАК Сумма,
			|	ЕСТЬNULL(НДС.СуммаОборот, 0) КАК СуммаНДС
			|ИЗ
			|	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(&НачалоПериода, &ОкончаниеПериода, Регистратор, , , СчетКт В ИЕРАРХИИ (&СписокСчетов), , Организация = &Организация) КАК Услуги
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(&НачалоПериода, &ОкончаниеПериода, Регистратор, СчетДт В ИЕРАРХИИ (&СписокСчетов), , СчетКт В ИЕРАРХИИ (&СписокСчетовНДС), , Организация = &Организация) КАК НДС
			|		ПО Услуги.Регистратор = НДС.Регистратор
			|			И Услуги.СчетКт = НДС.СчетДт";
		
		ПС = ПланыСчетов["Хозрасчетный"];
		
		СписокСчетов = Новый Массив();
		СписокСчетов.Добавить(ПС.ДоходОтРеализацииРаботИУслуг);	//703  
		СписокСчетов.Добавить(ПС.ДоходОтОперационнойАрендыАктивов);     //713
		СписокСчетов.Добавить(ПС.ДругиеДоходы);     //74
		Запрос.УстановитьПараметр ("СписокСчетов",СписокСчетов);

		СписокСчетовНДС = Новый Массив();
		СписокСчетовНДС.Добавить(ПС.РасчетыПоНалогамИПлатежам); //64
		Запрос.УстановитьПараметр ("СписокСчетовНДС",СписокСчетовНДС);

		Запрос.Текст = ТекстЗапроса;
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл  
			
				ОбработкаСтрокиЕРП(Выборка.Регистратор, Выборка.Счет, Выборка.Сумма-Выборка.СуммаНДС, Выборка.СубконтоКт1, Выборка.СубконтоКт2, ИДКонф);
		КонецЦикла; 
	
	Иначе

		ЗаполнитьПоБУ();

	КонецЕсли; 
		
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаСтрокиЕРП(ДокументРегистратор, Счет, ДокументСумма, Субконто1, Субконто2, ИДКонф)
	
		ТипДокумента = ТипЗнч(ДокументРегистратор); 
		
		Если ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг")  
			ИЛИ ТипДокумента = Тип("ДокументСсылка.АктВыполненныхРабот")  
			ИЛИ ТипДокумента = Тип("ДокументСсылка.ОтчетКомитенту") 
			ИЛИ ТипДокумента = Тип("ДокументСсылка.ОтчетОРозничныхПродажах")  
			ИЛИ ТипДокумента = Тип("ДокументСсылка.ОтчетДавальцу")  
			ИЛИ ТипДокумента = Тип("ДокументСсылка.ПередачаТоваровМеждуОрганизациями") Тогда
			// уже учтены
			
			
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетКомиссионераОСписании") 
			Или (ИДКонф = "ERP25" И ТипДокумента = Тип("ДокументСсылка.ВыкупТоваровХранителем"))  
