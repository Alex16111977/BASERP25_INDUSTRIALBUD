&НаСервере
Функция ПолучитьНаименованиеВЕД(КВЕД)
	
	ЭлементКВЕД = КлассификаторКВЕД.НайтиПоЗначению(КВЕД);
	Если ЭлементКВЕД = Неопределено Тогда
		Возврат "";
	Иначе
		Возврат ЭлементКВЕД.Представление;
	КонецЕсли;
КонецФункции //ПолучитьНаименованиеВЕД()

&НаКлиенте
Процедура ТаблицаКВЕДПриИзменении(Элемент) 
	ТекущиеДанные = Элементы.Таблица.ТекущиеДанные;
	ТекущиеДанные.Флаг = КВЕДВключаетсяВОтчет(ТекущиеДанные.КВЕД);
	ТекущиеДанные.ВЕД = ПолучитьНаименованиеВЕД(ТекущиеДанные.КВЕД); 

	Если ФлагНЕЗаполнятьКВЕДДЛяПохожих Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из Таблица Цикл
	
		Если ЗначениеЗаполнено(ТекущиеДанные.Субконто3) И ЗначениеЗаполнено(СтрокаТаблицы.Субконто3) 
			И СтрокаТаблицы.Субконто3 = ТекущиеДанные.Субконто3 Тогда
			СтрокаТаблицы.КВЕД = ТекущиеДанные.КВЕД; 
			СтрокаТаблицы.ВЕД = ТекущиеДанные.ВЕД; 
			СтрокаТаблицы.Флаг = ТекущиеДанные.Флаг; 
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Субконто3) И НЕ ЗначениеЗаполнено(СтрокаТаблицы.Субконто3) 
			И ЗначениеЗаполнено(ТекущиеДанные.Субконто2) И ЗначениеЗаполнено(СтрокаТаблицы.Субконто2) 
			И СтрокаТаблицы.Субконто2 = ТекущиеДанные.Субконто2 Тогда
			
			СтрокаТаблицы.КВЕД = ТекущиеДанные.КВЕД; 
			СтрокаТаблицы.ВЕД = ТекущиеДанные.ВЕД; 
			СтрокаТаблицы.Флаг = ТекущиеДанные.Флаг; 
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Субконто3) И НЕ ЗначениеЗаполнено(СтрокаТаблицы.Субконто3) 
			И НЕ ЗначениеЗаполнено(ТекущиеДанные.Субконто2) И НЕ ЗначениеЗаполнено(СтрокаТаблицы.Субконто2) 
			И СтрокаТаблицы.Субконто1 = ТекущиеДанные.Субконто1 Тогда
			
			СтрокаТаблицы.КВЕД = ТекущиеДанные.КВЕД; 
			СтрокаТаблицы.ВЕД = ТекущиеДанные.ВЕД; 
			СтрокаТаблицы.Флаг = ТекущиеДанные.Флаг; 
		КонецЕсли;
	
	КонецЦикла;
КонецПроцедуры


