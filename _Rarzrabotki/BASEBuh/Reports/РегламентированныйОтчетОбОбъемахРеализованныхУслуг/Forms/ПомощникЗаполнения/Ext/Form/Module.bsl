&НаСервере
Процедура ЗаполнитьДанныеПредыдущегоПериодаНаСервере(АдресДанных)
	
	Если АдресДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТЗ = ПолучитьИзВременногоХранилища(АдресДанных);
	Если ТЗ = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	ТаблицаКВЕД.Очистить();
	Для каждого СтрокаТЗ Из ТЗ Цикл
		
		НоваяСтрока = ТаблицаКВЕД.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
		
	КонецЦикла;

	Для каждого ИсходнаяСтрока Из Таблица Цикл
		ЗаполнитьКВЕДВСтрокеАналитика(ИсходнаяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ВыделитьКВЕД(Знач КодУКТВЭД) 
	Перем КВЕД;
	
	КВЕД = СокрЛП(Лев(КодУКТВЭД, 5));
	Если Сред(КВЕД,5,1) = "0" Тогда  		
		Возврат Лев(КВЕД, 4);
	Иначе
		Возврат КВЕД;
	КонецЕсли;
		
КонецФункции

&НаСервере
Функция ЗаполнитьКВЕДВСтрокеАналитика(ИсходнаяСтрока)
	
	НоменклатураЕсть = Ложь;
	Номенклатура = Неопределено;
	Если ТипЗнч(ИсходнаяСтрока.Субконто3) = Тип("СправочникСсылка.Номенклатура") и
		ЗначениеЗаполнено(ИсходнаяСтрока.Субконто3) Тогда
		
		КодДляПН = ИсходнаяСтрока.Субконто3.НоменклатураГТД;           
		Если ЗначениеЗаполнено(КодДляПН) Тогда
			Если ТипЗнч(КодДляПН) = Тип("СправочникСсылка.КлассификаторУКТВЭД") Тогда
				КодУКТВЭД = КодДляПН;
			ИначеЕсли  ТипЗнч(КодДляПН) = Тип("СправочникСсылка.НоменклатураГТД") Тогда
				КодУКТВЭД = КодДляПН.КодУКТВЭД;		
			КонецЕсли;
			ИсходнаяСтрока.КВЕД = ВыделитьКВЕД(КодУКТВЭД); 	
		КонецЕсли;

	КонецЕсли;		
	
	Если ПустаяСтрока(ИсходнаяСтрока.КВЕД) И ЗначениеЗаполнено(ИсходнаяСтрока.Субконто3) Тогда
		Строки = ТаблицаКВЕД.НайтиСтроки(Новый Структура("Аналитика", ИсходнаяСтрока.Субконто3));
		Если Строки.Количество() > 0 Тогда 
			ИсходнаяСтрока.КВЕД = Строки[0].КВЕД;
		КонецЕсли; 
	КонецЕсли;
	
	Если ПустаяСтрока(ИсходнаяСтрока.КВЕД) И ЗначениеЗаполнено(ИсходнаяСтрока.Субконто2) И НЕ ЗначениеЗаполнено(ИсходнаяСтрока.Субконто3) Тогда
		Строки = ТаблицаКВЕД.НайтиСтроки(Новый Структура("Аналитика", ИсходнаяСтрока.Субконто2));
		Если Строки.Количество() > 0 Тогда 
			ИсходнаяСтрока.КВЕД = Строки[0].КВЕД;
		КонецЕсли; 
	КонецЕсли;
	
	Если ПустаяСтрока(ИсходнаяСтрока.КВЕД) И ЗначениеЗаполнено(ИсходнаяСтрока.Субконто1) И НЕ ЗначениеЗаполнено(ИсходнаяСтрока.Субконто2) И НЕ ЗначениеЗаполнено(ИсходнаяСтрока.Субконто3) Тогда
		Строки = ТаблицаКВЕД.НайтиСтроки(Новый Структура("Аналитика", ИсходнаяСтрока.Субконто1));
		Если Строки.Количество() > 0 Тогда 
			ИсходнаяСтрока.КВЕД = Строки[0].КВЕД;
		КонецЕсли; 
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КВЕДВключаетсяВОтчет(КВЕД)
	
	ГруппаКВЕД = Лев(КВЕД,2);
	Если ГруппаКВЕД >= "49" и ГруппаКВЕД <= "63" Тогда
		Возврат Истина;
	ИначеЕсли ГруппаКВЕД >= "68" и ГруппаКВЕД <= "82" Тогда
		Возврат Истина;
	Иначе 
		Возврат Ложь;
	КонецЕсли;	
КонецФункции

&НаСервереБезКонтекста
