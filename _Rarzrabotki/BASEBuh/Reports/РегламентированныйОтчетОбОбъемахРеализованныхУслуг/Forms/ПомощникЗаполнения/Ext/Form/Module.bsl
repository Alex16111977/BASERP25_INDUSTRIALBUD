			НоваяСтрока.ДатаДокумента=НачалоМесяца(Выборка.Регистратор.Дата); 
		КонецЕсли;
		НоваяСтрока.СуммаДокумента=Выборка.Сумма-Выборка.СуммаНДС;    
	КонецЦикла; 
	Если ФлагНЕОтображатьДокумент Тогда
		ПолнаяТаблица = Таблица.Выгрузить();
		ПолнаяТаблица.Свернуть("Флаг, ДатаДокумента, Счет, Субконто3, Субконто2, Субконто1, КВЕД, ВЕД, Документ","СуммаДокумента");
		Таблица.Загрузить(ПолнаяТаблица);
	КонецЕсли;
	
