Процедура УстановитьКодUUIDВСправочнике(Источник, Отказ) Экспорт

	Попытка
		
		ДоступныеРеквизиты = Источник.Метаданные().Реквизиты;
		Если ДоступныеРеквизиты.Найти("А_ИдКод") = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		НовыйИдКод = Строка(Источник.Ссылка.УникальныйИдентификатор());
		Если Источник.А_ИдКод <> НовыйИдКод Тогда
			Источник.А_ИдКод = НовыйИдКод;
			Источник.ОбменДанными.Загрузка = Истина;
			Источник.Записать();
		КонецЕсли;

	Исключение
	КонецПопытки;

КонецПроцедуры


Процедура А_ДоработкаСправочникиПриЗаписи(Источник, Отказ) Экспорт
	УстановитьКодUUIDВСправочнике(Источник, Отказ);
КонецПроцедуры
