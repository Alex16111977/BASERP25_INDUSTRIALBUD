Процедура УстановитьКодUUIDВСправочнике(Источник, Отказ) Экспорт
	
	Попытка
     
  	ИдКодНовый = СокрЛП(Источник.Ссылка.УникальныйИдентификатор());
	Если  СокрЛП(Источник.А_ИдКод)<>ИдКодНовый  Тогда
		Источник.А_ИдКод = ИдКодНовый; 
		Источник.ОбменДанными.Загрузка = Истина;
		Источник.Записать();
	КонецЕсли; 
	
	 Исключение
   
   КонецПопытки;


КонецПроцедуры

Процедура А_ДоработкаСправочникиПриЗаписи(Источник, Отказ) Экспорт
	
	Если ТипЗнч(Источник)=Тип("СправочникОбъект.ФизическиеЛица") Тогда
		
		УстановитьКодUUIDВСправочнике(Источник, Отказ);  
		
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.Склады") Тогда
		
		УстановитьКодUUIDВСправочнике(Источник, Отказ); 		
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.ДоговорыКонтрагентов") Тогда
		
		УстановитьКодUUIDВСправочнике(Источник, Отказ);
		
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.Номенклатура") Тогда
		
		УстановитьКодUUIDВСправочнике(Источник, Отказ); 
		
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.Контрагенты") Тогда
		
		УстановитьКодUUIDВСправочнике(Источник, Отказ); 
		
	КонецЕсли; 
	
КонецПроцедуры
   
