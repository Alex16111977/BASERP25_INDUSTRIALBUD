Процедура _ПередЗаписьюОСПередЗаписью(Источник, Отказ) Экспорт
		
	Если ЗначениеЗаполнено(Источник._Организация) И НЕ ЗначениеЗаполнено(Источник.Код) Тогда  
	//	Источник._Организация = Организация;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		//"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		//|	ДоговорыКонтрагентов.Номер КАК Номер
		//|ИЗ
		//|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		//|ГДЕ
		//|	ДоговорыКонтрагентов._ВидВзаиморасчетов = &ВидВзаиморасчетов
		//|	И ДоговорыКонтрагентов.Номер <> &Пустой
		//|	И ДоговорыКонтрагентов.Ссылка <> &Ссылка
		//|	И ДоговорыКонтрагентов.Номер ПОДОБНО &НомерДокумента
		//|
		//|УПОРЯДОЧИТЬ ПО
		//|	Номер УБЫВ";  
		
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОсновныеСредства.Код КАК Код
		|ИЗ
		|	Справочник.ОсновныеСредства КАК ОсновныеСредства
		|ГДЕ
		|	ОсновныеСредства.Код ПОДОБНО &Код
		|	И ОсновныеСредства.Ссылка <> &Ссылка
		|	И ОсновныеСредства._Организация = &Организация
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код УБЫВ";
		
		Запрос.УстановитьПараметр("Организация", Источник._Организация);  
		//Запрос.УстановитьПараметр("Пустой", "");      
		Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка); 
		Запрос.УстановитьПараметр("Код", Источник._Организация.Префикс+"%"); 

		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда 
			НомерСтрокой = СтрЗаменить(Выборка.Код,Источник._Организация.Префикс+"-","");  
			НомерЧислом = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(НомерСтрокой);  
			Попытка    
				НомерЧисломНовый = НомерЧислом+1;
				Источник.Код = Источник._Организация.Префикс+"-" + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(НомерЧисломНовый,6); 
			Исключение  
				Сообщить(ОписаниеОшибки());
			КонецПопытки;
		Иначе
			Источник.Код = Источник._Организация.Префикс+"-" + СтроковыеФункцииКлиентСервер.ДополнитьСтроку("1",6);
		КонецЕсли;
	//ИначеЕсли НЕ ЗначениеЗаполнено(Источник._Организация)	Тогда  
	//	Отказ = Истина;
	//	Сообщить("Вкажіть організацію!");
		
	КонецЕсли;

КонецПроцедуры


//Партионный учет списания производим по партиям подразделения
Процедура УстановитьФильтрПартии(ФильтрПартии,Документ,Номенклатура,МассивСчетовУчетаБУ,МассивСкладов,МассивНалоговыхНазначений) Экспорт 
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.КомплектацияНоменклатуры") ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.ТребованиеНакладная")
		ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.СписаниеТоваров") ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.ПередачаМалоценныхАктивовВЭксплуатацию") Тогда
		Если ЗначениеЗаполнено(Документ.Подразделение) Тогда  
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ХозрасчетныйОстатки.Субконто2 КАК Партия
			|ИЗ
			|	РегистрБухгалтерии.Хозрасчетный.Остатки(
			|			&Дата,
			|			Счет В (&МассивСчетовУчетаБУ),
			|			,
			|			Субконто1 В (&Номенклатура)
			|				И Организация = &Организация
			|				И Субконто2.Подразделение = &Подразделение
			|				И НалоговоеНазначение В (&НалоговоеНазначение)
			|				И Субконто3 В (&МассивСкладов)) КАК ХозрасчетныйОстатки
			|
			|СГРУППИРОВАТЬ ПО
			|	ХозрасчетныйОстатки.Субконто2";
			
			Запрос.УстановитьПараметр("Дата", Документ.Дата-1);   
			Запрос.УстановитьПараметр("МассивСчетовУчетаБУ", МассивСчетовУчетаБУ);
			Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
			Запрос.УстановитьПараметр("МассивСкладов", МассивСкладов);
			Запрос.УстановитьПараметр("НалоговоеНазначение", МассивНалоговыхНазначений);
			//	Запрос.УстановитьПараметр("Документ", Документ);
			
			Запрос.УстановитьПараметр("Подразделение", Документ.Подразделение);
			Запрос.УстановитьПараметр("Организация", Документ.Организация);
			
			ФильтрПартии = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Партия");
		КонецЕсли;   
		
	ИначеЕсли  ТипЗнч(Документ) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда 
		
		Если ЗначениеЗаполнено(Документ.Подразделение1) Тогда  
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ХозрасчетныйОстатки.Субконто2 КАК Партия
			|ИЗ
			|	РегистрБухгалтерии.Хозрасчетный.Остатки(
			|			&Дата,
			|			Счет В (&МассивСчетовУчетаБУ),
			|			,
			|			Субконто1 В (&Номенклатура)
			|				И Организация = &Организация
			|				И Субконто2.Подразделение = &Подразделение
			|				И НалоговоеНазначение В (&НалоговоеНазначение)
			|				И Субконто3 В (&МассивСкладов)) КАК ХозрасчетныйОстатки
			|
			|СГРУППИРОВАТЬ ПО
			|	ХозрасчетныйОстатки.Субконто2";
			
			Запрос.УстановитьПараметр("Дата", Документ.Дата-1);   
			Запрос.УстановитьПараметр("МассивСчетовУчетаБУ", МассивСчетовУчетаБУ);
			Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
			Запрос.УстановитьПараметр("МассивСкладов", МассивСкладов);
			Запрос.УстановитьПараметр("НалоговоеНазначение", МассивНалоговыхНазначений);
			//	Запрос.УстановитьПараметр("Документ", Документ);
			
			Запрос.УстановитьПараметр("Подразделение", Документ.Подразделение1);
			Запрос.УстановитьПараметр("Организация", Документ.Организация);
			
			ФильтрПартии = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Партия");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьНаправлениеПодразделениеОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеНаРасчетныйСчет")
		ИЛИ ТипЗнч(Источник) = Тип("ДокументОбъект.СписаниеСРасчетногоСчета") Тогда 
		
		Если  Источник.ВидОперации  = Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ОплатаПокупателя 
			ИЛИ  Источник.ВидОперации  = Перечисления.ВидыОперацийСписаниеДенежныхСредств.ОплатаПоставщику Тогда 
			
			Для Каждого Строка Из Источник.РасшифровкаПлатежа Цикл  
				Договор = Строка.ДоговорКонтрагента;
				Отказ = ПроверкаНаправлениеПодразделение(Источник, Договор,Отказ);
			КонецЦикла;    
			
		КонецЕсли;
	Иначе     
		Договор = Источник.ДоговорКонтрагента;
		Отказ = ПроверкаНаправлениеПодразделение(Источник, Договор,Отказ);
	КонецЕсли;
	
	
КонецПроцедуры   

Функция ПроверкаНаправлениеПодразделение(Источник, Договор,Отказ) 
	
	Если  Источник.Направление <>  Договор.Направление Тогда  
		Отказ = Истина;
		Сообщить("Направлення в документі: " + Источник.Направление+  " не відповідає направленню в договорі: " + Договор.Направление);
	КонецЕсли;
	
	Если  Источник.Подразделение <>  Договор.Подразделение Тогда  
		Отказ = Истина;
		Сообщить("Підрозділ в документі: " + Источник.Подразделение+  " не відповідає підрозділу в договорі: " + Договор.Подразделение);
	КонецЕсли;    
	
	Возврат Отказ;
	
КонецФункции
