
&НаКлиенте
Процедура ЗаполнитьОС(Команда)

	// Перевірка заповнення дати
	Если НЕ ЗначениеЗаполнено(Объект.ДатаОстатков) Тогда
		ПоказатьПредупреждение(, "Вкажіть дату залишків!");
		Возврат;
	КонецЕсли;

	// Підтвердження операції
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьОСЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения,
		"Завантажити залишки ОС з бази BuhBud на дату " + Формат(Объект.ДатаОстатков, "ДЛФ=D") + "?
		|
		|Поточні дані в табличній частині будуть очищені!",
		РежимДиалогаВопрос.ДаНет,
		,
		КодВозвратаДиалога.Нет,
		"Завантаження залишків ОС");

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОСЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние("Завантаження залишків ОС з BuhBud...");

	Попытка
		КоличествоЗагружено = ЗаполнитьОСНаСервере();
		ПоказатьПредупреждение(, "Завантажено " + КоличествоЗагружено + " позицій ОС");
	Исключение
		ПоказатьПредупреждение(, "Помилка: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ЗаполнитьОСНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ОбъектОбработки.ЗагрузитьОстаткиОС();
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");

	Возврат Объект.ОС.Количество();

КонецФункции

// Обробник ПриСозданииНаСервере
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Встановити дату за замовчуванням
	Если НЕ ЗначениеЗаполнено(Объект.ДатаОстатков) Тогда
		Объект.ДатаОстатков = КонецМесяца(ТекущаяДатаСеанса());
	КонецЕсли;

КонецПроцедуры

// Команда створення документа вводу залишків ОС
&НаКлиенте
Процедура СоздатьДокумент(Команда)

	// Перевірка заповнення організації
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		ПоказатьПредупреждение(, "Необхідно обрати організацію!");
		Возврат;
	КонецЕсли;

	// Перевірка заповнення дати
	Если НЕ ЗначениеЗаполнено(Объект.ДатаОстатков) Тогда
		ПоказатьПредупреждение(, "Необхідно вказати дату залишків!");
		Возврат;
	КонецЕсли;

	// Перевірка наявності даних
	Если Объект.ОС.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Таблична частина ОС порожня! Спочатку завантажте залишки.");
		Возврат;
	КонецЕсли;

	// Підтвердження операції
	ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьДокументЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения,
		"Створити документ вводу залишків ОС на дату " + Формат(Объект.ДатаОстатков, "ДЛФ=D") + "?
		|
		|Організація: " + Объект.Организация + "
		|Рядків ОС: " + Объект.ОС.Количество(),
		РежимДиалогаВопрос.ДаНет,
		,
		КодВозвратаДиалога.Нет,
		"Створення документа вводу залишків ОС");

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние("Створення документа вводу залишків ОС...");

	Попытка
		СоздатьДокументНаСервере();
		ПоказатьПредупреждение(, "Документ успішно створено! Деталі див. у повідомленнях.");
	Исключение
		ПоказатьПредупреждение(, "Помилка: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СоздатьДокументНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ОбъектОбработки.СоздатьДокументВводаОстатковОС();
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");

КонецПроцедуры
