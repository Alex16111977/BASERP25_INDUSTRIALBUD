КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Отметки

// Режим: 1 — відмітити, 0 — зняти, -1 — інвертувати.
&НаКлиенте
Процедура УстановитьОтметкиКлючей(Режим)

	Для Каждого СтрКлюч Из Объект.Ключи Цикл
		УстановитьОтметкуКлюча(СтрКлюч, ?(Режим = -1, НЕ СтрКлюч.Отметка, Режим = 1));
	КонецЦикла;
	ОбновитьРезюме(ЭтотОбъект);

КонецПроцедуры

// Відмітка ключа → розбіжні документи ключа, доступні для перепроведення; зняття — з усіх документів ключа.
&НаКлиенте
Процедура УстановитьОтметкуКлюча(СтрКлюч, Значение)

	ЕстьОтмеченные = Ложь;
	Для Каждого СтрДок Из Объект.Документы.НайтиСтроки(Новый Структура("КлючИД", СтрКлюч.КлючИД)) Цикл
		СтрДок.Отметка = Значение И СтрДок.ЕстьРасхождение И ДокументДоступен(СтрДок);
		ЕстьОтмеченные = ЕстьОтмеченные ИЛИ СтрДок.Отметка;
	КонецЦикла;
	СтрКлюч.Отметка = ЕстьОтмеченные;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметкиВыделенныхДокументов(Значение)

	ИзмененныеКлючи = Новый Соответствие;
	Для Каждого ИдСтроки Из Элементы.Документы.ВыделенныеСтроки Цикл
		СтрДок = Объект.Документы.НайтиПоИдентификатору(ИдСтроки);
		Если СтрДок = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрДок.Отметка = Значение И (НЕ СтрДок.ЗакрытыйПериод ИЛИ Объект.РазрешитьЗакрытыйПериод);
		ИзмененныеКлючи.Вставить(СтрДок.КлючИД, Истина);
	КонецЦикла;
	Для Каждого КлючИЗначение Из ИзмененныеКлючи Цикл
		ОбновитьОтметкуКлюча(КлючИЗначение.Ключ);
	КонецЦикла;
	ОбновитьРезюме(ЭтотОбъект);

КонецПроцедуры

// Відмітка ключа = «є відмічені документи ключа».
&НаКлиенте
Процедура ОбновитьОтметкуКлюча(КлючИД)

	ЕстьОтмеченные = Ложь;
	Для Каждого СтрДок Из Объект.Документы.НайтиСтроки(Новый Структура("КлючИД", КлючИД)) Цикл
		ЕстьОтмеченные = ЕстьОтмеченные ИЛИ СтрДок.Отметка;
	КонецЦикла;
	Для Каждого СтрКлюч Из Объект.Ключи.НайтиСтроки(Новый Структура("КлючИД", КлючИД)) Цикл
		СтрКлюч.Отметка = ЕстьОтмеченные;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ДокументДоступен(СтрДок)

	Возврат (НЕ СтрДок.ЗакрытыйПериод ИЛИ Объект.РазрешитьЗакрытыйПериод)
		И НЕ СтрНачинаетсяС(СтрДок.Статус, ПрефиксУспеха());

КонецФункции

&НаКлиенте
Процедура ПрименитьОтборДокументов()

	СтрКлюч = Элементы.Ключи.ТекущиеДанные;
	Если СтрКлюч = Неопределено Тогда
		Элементы.Документы.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючИД", "-"));
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура("КлючИД", СтрКлюч.КлючИД);
	Если Объект.ТолькоРасхождения Тогда
		Отбор.Вставить("ЕстьРасхождение", Истина);
	КонецЕсли;
	Элементы.Документы.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);

КонецПроцедуры

