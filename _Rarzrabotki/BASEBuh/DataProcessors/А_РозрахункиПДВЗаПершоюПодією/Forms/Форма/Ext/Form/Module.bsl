&НаКлиенте
Процедура КарточкаСчета6442(Команда)

	СтрКлюч = Элементы.Ключи.ТекущиеДанные;
	Если СтрКлюч = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите ключ в верхней таблице.';uk='Оберіть ключ у верхній таблиці.'"));
