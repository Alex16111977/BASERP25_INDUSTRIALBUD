Процедура ПоказатьДокументыПериода(Команда)

	ПоказатьДокументыПериодаНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПерепровестиПериод(Команда)

	Если Объект.Протокол.Количество() = 0 Тогда
		ПоказатьДокументыПериодаНаСервере();
	КонецЕсли;
	СписокДокументов = Новый Массив;
	Для Каждого СтрПрот Из Объект.Протокол Цикл
		Если (НЕ ЭтоЗакрытыйПериод(СтрПрот.Дата, Объект.ГраницаЗапрета) ИЛИ Объект.РазрешитьЗакрытыйПериод)
			И НЕ СтрНачинаетсяС(СтрПрот.Статус, ПрефиксУспеха()) Тогда
			СписокДокументов.Добавить(СтрПрот.Документ);
		КонецЕсли;
	КонецЦикла;
	Если СписокДокументов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='За период нет документов для перепроведения.';uk='За період немає документів для перепроведення.'"));
		Возврат;
	КонецЕсли;
	Текст = СтрШаблон(НСтр("ru='Перепровести все документы механизма НДС за %1 – %2: %3 шт. в хронологическом порядке?
		|Это может занять длительное время.';uk='Перепровести всі документи механізму ПДВ за %1 – %2: %3 шт. у хронологічному порядку?
		|Це може зайняти тривалий час.'"),
		Формат(Объект.ДатаНачала, "ДЛФ=D"), Формат(Объект.ДатаОкончания, "ДЛФ=D"), СписокДокументов.Количество());
	ПоказатьВопрос(Новый ОписаниеОповещения("ПерепровестиПериодЗавершение", ЭтотОбъект, СписокДокументов),
		Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

