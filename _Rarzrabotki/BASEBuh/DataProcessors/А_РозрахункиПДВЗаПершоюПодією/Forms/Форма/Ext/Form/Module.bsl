&НаКлиенте
Процедура ВыбратьПериодЗавершение(Период, ДополнительныеПараметры) Экспорт

	Если Период = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект.ДатаНачала = Период.ДатаНачала;
	Объект.ДатаОкончания = Период.ДатаОкончания;

КонецПроцедуры

// Картка рахунку 6442 з відбором по ключу (механіка БухгалтерскиеОтчетыВызовСервера.ПриСозданииНаСервере, ВидРасшифровки = 2).
&НаСервере
Функция ПараметрыКарточкиСчета(Знач ИдСтроки)

	СтрКлюч = Объект.Ключи.НайтиПоИдентификатору(ИдСтроки);
	Настройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
	Настройки.ДополнительныеСвойства.Вставить("Счет", ПланыСчетов.Хозрасчетный.НалоговыйКредитНеподтвержденный);
	Настройки.ДополнительныеСвойства.Вставить("НачалоПериода", НачалоДня(Объект.ДатаНачала));
	Настройки.ДополнительныеСвойства.Вставить("КонецПериода", КонецДня(Объект.ДатаОкончания));
	Настройки.ДополнительныеСвойства.Вставить("Организация", СтрКлюч.Организация);
	Отбор = Настройки.Элементы.Добавить(Тип("ОтборКомпоновкиДанных"));
	Отбор.ИдентификаторПользовательскойНастройки = "Отбор";
	ДобавитьОтборКарточки(Отбор, "Субконто1", СтрКлюч.Контрагент);
	ДобавитьОтборКарточки(Отбор, "Субконто2", СтрКлюч.ДоговорКонтрагента);
	Если ЗначениеЗаполнено(СтрКлюч.Сделка) Тогда
		ДобавитьОтборКарточки(Отбор, "Субконто3", СтрКлюч.Сделка);
	КонецЕсли;
	Возврат Новый Структура("ВидРасшифровки, ПользовательскиеНастройки, СформироватьПриОткрытии", 2, Настройки, Истина);

КонецФункции

&НаСервере
Процедура ДобавитьОтборКарточки(Отбор, ИмяПоля, Значение)

	ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Значение;
	ЭлементОтбора.Использование = Истина;

КонецПроцедуры

&НаСервере
Процедура НастроитьУсловноеОформление(ОбъектОбработки)

	Успех = ОбъектОбработки.ПрефиксУспеха();
	Ошибка = ОбъектОбработки.ПрефиксОшибки();
	Жирный = Новый Шрифт(, , , Истина);
	НачинаетсяС = ВидСравненияКомпоновкиДанных.НачинаетсяС;
	Равно = ВидСравненияКомпоновкиДанных.Равно;

	ДобавитьОформление("Ключи", "Объект.Ключи.Отметка", Равно, Ложь, "ЦветТекста", WebЦвета.Серый);
	ДобавитьОформление("Ключи", "Объект.Ключи.ЗакрытыйПериод", Равно, Истина, "ЦветФона", WebЦвета.ДымчатоБелый);
	ДобавитьОформление("Ключи", "Объект.Ключи.Статус", Равно, ОбъектОбработки.СтатусИсправлено(), "ЦветТекста", WebЦвета.ЗеленыйЛес);
	ДобавитьОформление("Ключи", "Объект.Ключи.Статус", НачинаетсяС, НСтр("ru='Осталось';uk='Лишилась'"), "ЦветТекста", WebЦвета.Красный);

	ДобавитьОформление("Документы", "Объект.Документы.Отметка", Равно, Ложь, "ЦветТекста", WebЦвета.Серый);
	ДобавитьОформление("Документы", "Объект.Документы.ЗакрытыйПериод", Равно, Истина, "ЦветФона", WebЦвета.ДымчатоБелый);
	ДобавитьОформление("Документы", "Объект.Документы.ЕстьРасхождение", Равно, Истина, "Шрифт", Жирный);
	ДобавитьОформление("Документы", "Объект.Документы.Статус", НачинаетсяС, Успех, "ЦветТекста", WebЦвета.ЗеленыйЛес);
	ДобавитьОформление("Документы", "Объект.Документы.Статус", НачинаетсяС, Ошибка, "ЦветТекста", WebЦвета.Красный);

	ДобавитьОформление("Протокол", "Объект.Протокол.Статус", НачинаетсяС, Успех, "ЦветТекста", WebЦвета.ЗеленыйЛес);
	ДобавитьОформление("Протокол", "Объект.Протокол.Статус", НачинаетсяС, Ошибка, "ЦветТекста", WebЦвета.Красный);

КонецПроцедуры

&НаСервере
Процедура ДобавитьОформление(ИмяТаблицы, ПутьПоля, ВидСравнения, Значение, ИмяПараметра, ЗначениеПараметра)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы);
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьПоля);
	ЭлементОтбора.ВидСравнения = ВидСравнения;
	ЭлементОтбора.ПравоеЗначение = Значение;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра(ИмяПараметра, ЗначениеПараметра);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоЗакрытыйПериод(ДатаДокумента, ГраницаЗапрета)

	Возврат ЗначениеЗаполнено(ГраницаЗапрета) И ДатаДокумента <= КонецДня(ГраницаЗапрета);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПрефиксУспеха()

	Возврат НСтр("ru='Перепроведено';uk='Перепроведено'");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьРезюме(Форма)

	Исправлено = НСтр("ru='Исправлено';uk='Виправлено'");
	КлючейСРасхождением = 0;
	ДокументовСРасхождением = 0;
	Лишнее = 0;
	КлючейОтмечено = 0;
	Для Каждого СтрКлюч Из Форма.Объект.Ключи Цикл
		Если СтрКлюч.Статус = Исправлено Тогда
			Продолжить;
		КонецЕсли;
		КлючейСРасхождением = КлючейСРасхождением + 1;
		ДокументовСРасхождением = ДокументовСРасхождением + СтрКлюч.ДокументовСРасхождением;
		Лишнее = Лишнее + СтрКлюч.Отклонение;
		Если СтрКлюч.Отметка Тогда
			КлючейОтмечено = КлючейОтмечено + 1;
		КонецЕсли;
	КонецЦикла;
	ДокументовОтмечено = 0;
	Для Каждого СтрДок Из Форма.Объект.Документы Цикл
		Если СтрДок.Отметка Тогда
			ДокументовОтмечено = ДокументовОтмечено + 1;
		КонецЕсли;
	КонецЦикла;
	Форма.НадписьРезюме = СтрШаблон(НСтр("ru='Ключей с расхождением: %1 · документов с расхождением: %2 · лишний НДС 6442: %3 грн · отмечено: ключей %4, документов %5 · запрет изменений по %6';uk='Ключів з розбіжністю: %1 · документів з розбіжністю: %2 · зайвий ПДВ 6442: %3 грн · відмічено: ключів %4, документів %5 · заборона змін по %6'"),
		КлючейСРасхождением, ДокументовСРасхождением, Формат(Лишнее, "ЧДЦ=2; ЧН=0"), КлючейОтмечено, ДокументовОтмечено,
		Формат(Форма.Объект.ГраницаЗапрета, "ДЛФ=D; ДП=—"));

КонецПроцедуры

#КонецОбласти
