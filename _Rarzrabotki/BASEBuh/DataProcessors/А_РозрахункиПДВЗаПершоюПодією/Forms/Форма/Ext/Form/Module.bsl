&НаКлиенте
Процедура КлючиПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПрименитьОтборДокументов", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура КлючиОтметкаПриИзменении(Элемент)

	СтрКлюч = Элементы.Ключи.ТекущиеДанные;
	Если СтрКлюч = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Хотели = СтрКлюч.Отметка;
	УстановитьОтметкуКлюча(СтрКлюч, Хотели);
	Если Хотели И НЕ СтрКлюч.Отметка Тогда
		ПоказатьПредупреждение(, НСтр("ru='У ключа нет документов, доступных для перепроведения: расхождения в закрытом периоде или уже перепроведены. Включите «Разрешить закрытый период» или отметьте документы внизу вручную.';uk='У ключа немає документів, доступних для перепроведення: розбіжності в закритому періоді або вже перепроведені. Увімкніть «Дозволити закритий період» або відмітьте документи внизу вручну.'"));
	КонецЕсли;
	ОбновитьРезюме(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура КлючиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле = Элементы.КлючиОтметка Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	СтрКлюч = Объект.Ключи.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если СтрКлюч = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Поле = Элементы.КлючиОрганизация Тогда
		Значение = СтрКлюч.Организация;
	ИначеЕсли Поле = Элементы.КлючиКонтрагент Тогда
		Значение = СтрКлюч.Контрагент;
	ИначеЕсли Поле = Элементы.КлючиДоговор Тогда
		Значение = СтрКлюч.ДоговорКонтрагента;
	ИначеЕсли Поле = Элементы.КлючиСделка Тогда
		Значение = СтрКлюч.Сделка;
	Иначе
		Значение = СтрКлюч.ПервыйДокумент;
	КонецЕсли;
	Если ЗначениеЗаполнено(Значение) Тогда
		ПоказатьЗначение(, Значение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДокументыОтметкаПриИзменении(Элемент)

	СтрДок = Элементы.Документы.ТекущиеДанные;
	Если СтрДок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если СтрДок.Отметка И СтрДок.ЗакрытыйПериод И НЕ Объект.РазрешитьЗакрытыйПериод Тогда
		СтрДок.Отметка = Ложь;
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru='Документ в закрытом периоде (запрет изменений по %1). Включите «Разрешить закрытый период».';uk='Документ у закритому періоді (заборона змін по %1). Увімкніть «Дозволити закритий період».'"),
			Формат(Объект.ГраницаЗапрета, "ДЛФ=D")));
	КонецЕсли;
	ОбновитьОтметкуКлюча(СтрДок.КлючИД);
	ОбновитьРезюме(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле = Элементы.ДокументыОтметка Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	СтрДок = Объект.Документы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если СтрДок <> Неопределено И ЗначениеЗаполнено(СтрДок.Документ) Тогда
		ПоказатьЗначение(, СтрДок.Документ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПротоколВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрПрот = Объект.Протокол.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если СтрПрот <> Неопределено И ЗначениеЗаполнено(СтрПрот.Документ) Тогда
		ПоказатьЗначение(, СтрПрот.Документ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЖурналВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрЖурнал = Журнал.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если СтрЖурнал <> Неопределено Тогда
		ПоказатьПредупреждение(, СтрЖурнал.Комментарий);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Анализировать(Команда)

	Итог = АнализироватьНаСервере();
	ПрименитьОтборДокументов();
	ПоказатьОповещениеПользователя(НСтр("ru='Анализ завершён';uk='Аналіз завершено'"), ,
		СтрШаблон(НСтр("ru='Ключей с расхождением: %1, документов: %2, лишний НДС 6442: %3';uk='Ключів з розбіжністю: %1, документів: %2, зайвий ПДВ 6442: %3'"),
			Итог.КлючейСРасхождением, Итог.ДокументовСРасхождением, Формат(Итог.Отклонение, "ЧДЦ=2; ЧН=0")));

КонецПроцедуры

&НаКлиенте
Процедура ПерепровестиОтмеченные(Команда)

	СписокДокументов = Новый Массив;
	КлючиСОтметками = Новый Соответствие;
	Для Каждого СтрДок Из Объект.Документы Цикл
		Если СтрДок.Отметка И СписокДокументов.Найти(СтрДок.Документ) = Неопределено Тогда
			СписокДокументов.Добавить(СтрДок.Документ);
			КлючиСОтметками.Вставить(СтрДок.КлючИД, Истина);
		КонецЕсли;
	КонецЦикла;
	Если СписокДокументов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Отметьте ключи или документы для перепроведения.';uk='Відмітьте ключі або документи для перепроведення.'"));
		Возврат;
	КонецЕсли;
	Текст = СтрШаблон(НСтр("ru='Перепровести %1 документ(ов) по %2 ключам в хронологическом порядке?
		|Документы, которых не было в очереди обмена с ЕРП, из очереди будут сняты.';uk='Перепровести %1 документ(ів) по %2 ключах у хронологічному порядку?
		|Документи, яких не було в черзі обміну з ЕРП, з черги буде знято.'"),
		СписокДокументов.Количество(), КлючиСОтметками.Количество());
	ПоказатьВопрос(Новый ОписаниеОповещения("ПерепровестиОтмеченныеЗавершение", ЭтотОбъект, СписокДокументов),
		Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

