КонецПроцедуры

// Фон — через команду «ФонПерепровести» зареєстрованої обробки БСП (зовнішня обробка з «Файл → Відкрити»
// у фон не йде — тоді синхронно на сервері).
&НаКлиенте
Процедура ЗапуститьПерепроведение(СписокДокументов, Режим)

	Если НЕ ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
		Итог = ПерепровестиНаСервере(СписокДокументов, Режим);
		ПослеПерепроведенияНаКлиенте(Итог, Режим);
		Возврат;
	КонецЕсли;
	ПараметрыКоманды = ДополнительныеОтчетыИОбработкиКлиент.ПараметрыВыполненияКомандыВФоне(ДополнительнаяОбработкаСсылка);
	ПараметрыКоманды.Вставить("ИдентификаторКоманды", "ФонПерепровести");
	ПараметрыКоманды.Вставить("Документы", СписокДокументов);
	ПараметрыКоманды.Вставить("РазрешитьЗакрытыйПериод", Объект.РазрешитьЗакрытыйПериод);
	Задание = ДополнительныеОтчетыИОбработкиВызовСервера.ЗапуститьДлительнуюОперацию(УникальныйИдентификатор, ПараметрыКоманды);

	НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	НастройкиОжидания.ТекстСообщения = СтрШаблон(НСтр("ru='Перепроведение %1 документ(ов)…';uk='Перепроведення %1 документ(ів)…'"),
		СписокДокументов.Количество());
	НастройкиОжидания.ВыводитьОкноОжидания = Истина;
	НастройкиОжидания.ВыводитьПрогрессВыполнения = Истина;
	НастройкиОжидания.ВыводитьСообщения = Истина;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Задание,
		Новый ОписаниеОповещения("ПерепроведениеВФонеЗавершение", ЭтотОбъект, Режим), НастройкиОжидания);

КонецПроцедуры

&НаКлиенте
Процедура ПерепроведениеВФонеЗавершение(Результат, Режим) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Результат.Статус <> "Выполнено" Тогда
		ПоказатьПредупреждение(, НСтр("ru='Перепроведение завершилось ошибкой: ';uk='Перепроведення завершилось помилкою: '")
			+ Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	Итог = ПрименитьРезультатФонаНаСервере(Результат.АдресРезультата, Режим);
	ПослеПерепроведенияНаКлиенте(Итог, Режим);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПерепроведенияНаКлиенте(Итог, Режим)

	ПрименитьОтборДокументов();
	Текст = СтрШаблон(НСтр("ru='Перепроведено: %1, ошибок: %2, пропущено: %3, снято с очереди обмена ЕРП: %4';uk='Перепроведено: %1, помилок: %2, пропущено: %3, знято з черги обміну ЕРП: %4'"),
		Итог.Перепроведено, Итог.Ошибок, Итог.Пропущено, Итог.СнятоСОчереди);
	Если Режим = "Ключи" Тогда
		Текст = Текст + Символы.ПС + СтрШаблон(НСтр("ru='Осталось ключей с расхождением: %1 (лишний НДС 6442: %2).';uk='Лишилось ключів з розбіжністю: %1 (зайвий ПДВ 6442: %2).'"),
			Итог.КлючейСРасхождением, Формат(Итог.Отклонение, "ЧДЦ=2; ЧН=0"));
	КонецЕсли;
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

&НаСервере
Функция ПерепровестиНаСервере(Знач СписокДокументов, Знач Режим)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Протокол = ОбъектОбработки.ПерепровестиДокументы(СписокДокументов);
	Возврат ПрименитьПротокол(ОбъектОбработки, Протокол, Режим);

КонецФункции

&НаСервере
Функция ПрименитьРезультатФонаНаСервере(Знач Адрес, Знач Режим)

	РезультатВыполнения = ПолучитьИзВременногоХранилища(Адрес);
	Протокол = РезультатВыполнения.Итог;
	Возврат ПрименитьПротокол(РеквизитФормыВЗначение("Объект"), Протокол, Режим);

КонецФункции

&НаСервере
Функция ПрименитьПротокол(ОбъектОбработки, Протокол, Режим)

	Если Режим = "Ключи" Тогда
		Итог = ОбъектОбработки.ПослеПерепроведения(Протокол);
	Иначе
		ОбъектОбработки.ПрименитьПротоколПериода(Протокол);
		Итог = Новый Структура("Перепроведено, Ошибок, Пропущено, СнятоСОчереди", 0, 0, 0, 0);
		Для Каждого СтрПрот Из Протокол Цикл
			Если СтрПрот.Успех Тогда
				Итог.Перепроведено = Итог.Перепроведено + 1;
			ИначеЕсли СтрНачинаетсяС(СтрПрот.Статус, ОбъектОбработки.ПрефиксОшибки()) Тогда
				Итог.Ошибок = Итог.Ошибок + 1;
			Иначе
				Итог.Пропущено = Итог.Пропущено + 1;
			КонецЕсли;
			Если СтрПрот.СнятСОчереди Тогда
				Итог.СнятоСОчереди = Итог.СнятоСОчереди + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");
	ОбновитьРезюме(ЭтотОбъект);
	Возврат Итог;

КонецФункции

#КонецОбласти

&НаСервере
Функция АнализироватьНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Итог = ОбъектОбработки.Анализировать();
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");
	ОбновитьРезюме(ЭтотОбъект);
	Возврат Итог;

КонецФункции

&НаСервере
Процедура ПоказатьДокументыПериодаНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Итог = ОбъектОбработки.ЗаполнитьПротоколПериода();
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");
	Части = Новый Массив;
	Для Каждого КлючИЗначение Из Итог.ПоВидам Цикл
		Части.Добавить(КлючИЗначение.Ключ + ": " + КлючИЗначение.Значение);
	КонецЦикла;
	НадписьПериод = СтрШаблон(НСтр("ru='Документов механизма НДС за %1 – %2: %3 (в закрытом периоде: %4). %5';uk='Документів механізму ПДВ за %1 – %2: %3 (у закритому періоді: %4). %5'"),
		Формат(Объект.ДатаНачала, "ДЛФ=D"), Формат(Объект.ДатаОкончания, "ДЛФ=D"), Итог.Всего, Итог.ВЗакрытомПериоде,
		СтрСоединить(Части, "; "));

КонецПроцедуры

&НаСервере
Процедура ОбновитьЖурналНаСервере()

	Журнал.Загрузить(РеквизитФормыВЗначение("Объект").ПрочитатьЖурнал());

