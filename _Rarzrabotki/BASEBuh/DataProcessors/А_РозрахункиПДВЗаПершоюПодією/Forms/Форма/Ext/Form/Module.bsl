#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	Если Параметры.Свойство("ДополнительнаяОбработкаСсылка") Тогда
		ДополнительнаяОбработкаСсылка = Параметры.ДополнительнаяОбработкаСсылка;
	КонецЕсли;

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Если НЕ ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
		Объект.ДатаНачала = НачалоГода(ТекущаяДатаСеанса());
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		Объект.ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;
	Объект.ГраницаЗапрета = ОбъектОбработки.ГраницаЗапретаИзменения();
	ТекстИнструкции = ОбъектОбработки.ПолучитьМакет("Инструкция").ПолучитьТекст();

	Связи = Новый Массив;
	Связи.Добавить(Новый СвязьПараметраВыбора("Отбор.Владелец", "Объект.Контрагент"));
	Элементы.ДоговорКонтрагента.СвязиПараметровВыбора = Новый ФиксированныйМассив(Связи);
	Элементы.РазрешитьЗакрытыйПериод.Подсказка = СтрШаблон(
		НСтр("ru='Разрешить перепроведение документов с датой по %1 включительно (дата запрета изменений для всех пользователей). Ночные команды закрытый период не трогают никогда.';uk='Дозволити перепроведення документів з датою по %1 включно (дата заборони змін для всіх користувачів). Нічні команди закритий період не чіпають ніколи.'"),
		Формат(Объект.ГраницаЗапрета, "ДЛФ=D; ДП=—"));

	НастроитьУсловноеОформление(ОбъектОбработки);
	ОбновитьРезюме(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПрименитьОтборДокументов();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)

	Объект.ДоговорКонтрагента = ПредопределенноеЗначение("Справочник.ДоговорыКонтрагентов.ПустаяСсылка");

КонецПроцедуры

&НаКлиенте
Процедура РазрешитьЗакрытыйПериодПриИзменении(Элемент)

	Если Объект.РазрешитьЗакрытыйПериод Тогда
		ПоказатьОповещениеПользователя(НСтр("ru='Закрытый период разрешён';uk='Закритий період дозволено'"), ,
			НСтр("ru='Документы закрытого периода можно отметить вручную.';uk='Документи закритого періоду можна відмітити вручну.'"));
		Возврат;
	КонецЕсли;
	ИзмененныеКлючи = Новый Соответствие;
	Для Каждого СтрДок Из Объект.Документы Цикл
		Если СтрДок.Отметка И СтрДок.ЗакрытыйПериод Тогда
			СтрДок.Отметка = Ложь;
			ИзмененныеКлючи.Вставить(СтрДок.КлючИД, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючИЗначение Из ИзмененныеКлючи Цикл
		ОбновитьОтметкуКлюча(КлючИЗначение.Ключ);
	КонецЦикла;
	ОбновитьРезюме(ЭтотОбъект);

КонецПроцедуры

