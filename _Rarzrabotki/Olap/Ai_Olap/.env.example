# Ai_Olap environment variables. Copy to .env and fill in real values.
# .env is gitignored.

# Source: 1C BAS ERP 2.5 SQL backend (primary read path via pyodbc)
BASERP_SQL_DSN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=BaseERP;UID=sa;PWD=CHANGE_ME;TrustServerCertificate=yes

# Target: OlapBASERP (write path via pyodbc, sa user)
OLAP_SQL_DSN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=OlapBASERP;UID=sa;PWD=CHANGE_ME;TrustServerCertificate=yes

# Fallback: 1C COM connector for virtual tables (Остатки/Обороты, _Свод-registers)
BASERP_COM_CONN=Srvr="SQLSERVER";Ref="BaseERP";Usr="Администратор";Pwd="CHANGE_ME"

# Optional: log level
LOG_LEVEL=INFO

# Optional: path to mapping file (default: mapping/baserp_storage.json)
MAPPING_PATH=mapping/baserp_storage.json
