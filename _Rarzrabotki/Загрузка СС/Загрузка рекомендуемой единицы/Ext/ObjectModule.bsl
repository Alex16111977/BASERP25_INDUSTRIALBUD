
#Область ПрограммныйИнтерфейс

// Загрузка в базу Бухгалтерии (bas_industrialbud): ОбщиеНазванияНоменклатуры.ЕдиницаРекомендуемая
// (тип КлассификаторЕдиницИзмерения). Если обработка открыта в самой Бухгалтерии - пишет локально,
// иначе (ЕРП) - подключается по COM (строка из регистра А_НастройкиПодключенияБаз) и выполняет
// локальный движок этой же обработки в базе Бухгалтерии.
// МассивСтрок - Массив структур {ОбщееНазвание, Единица}.
Функция ЗагрузитьЕдиницыБух(МассивСтрок) Экспорт

	Если Метаданные.Справочники.Найти("ОбщиеНазванияНоменклатуры") <> Неопределено Тогда
		Возврат ЗагрузитьЕдиницыИзМассива(МассивСтрок);
	КонецЕсли;
	Возврат ЗагрузитьЕдиницыБухЧерезCOM(МассивСтрок);

КонецФункции

// Загрузка в базу ЕРП: А_ОбщиеНазванияНоменклатуры.ЕдиницаРекомендуемая
// (тип УпаковкиЕдиницыИзмерения). Работает только при открытии обработки в базе ЕРП.
// МассивСтрок - Массив структур {ОбщееНазвание, Единица}.
Функция ЗагрузитьЕдиницыЕРП(МассивСтрок) Экспорт

	Результат = НовыйПротоколЗагрузки(МассивСтрок.Количество());

	МетаСправочника = Метаданные.Справочники.Найти("А_ОбщиеНазванияНоменклатуры");
	Если МетаСправочника = Неопределено Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Кнопка загрузки в ЕРП доступна только при открытии обработки в базе ЕРП"
			+ " (справочник А_ОбщиеНазванияНоменклатуры не найден)";
		Возврат Результат;
	КонецЕсли;
	Если МетаСправочника.Реквизиты.Найти("ЕдиницаРекомендуемая") = Неопределено Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "У справочника А_ОбщиеНазванияНоменклатуры нет реквизита ЕдиницаРекомендуемая."
			+ " Добавьте его в конфигураторе (тип: СправочникСсылка.УпаковкиЕдиницыИзмерения) и повторите";
		Возврат Результат;
	КонецЕсли;

	КэшНазваний = ПостроитьКэшНазванийЕРП();
	КэшЕдиниц = ПостроитьКэшЕдиницЕРП();
	ЗаписатьЕдиницыПоКэшам(МассивСтрок, КэшНазваний, КэшЕдиниц, Результат, "ЗагрузкаРекомендуемойЕдиницы.ЕРП");
	Возврат Результат;

КонецФункции

// Локальный движок Бухгалтерии: записывает ЕдиницаРекомендуемая в карточки
// справочника ОбщиеНазванияНоменклатуры по данным Excel «Аналіз одиниць виміру»
// (колонка D «Одиниця» на строках общих названий).
// Значение из файла - источник истины: при отличии реквизит перезаписывается,
// при совпадении строка учитывается как «без изменений» (повторный прогон идемпотентен).
// МассивСтрок - Массив структур {ОбщееНазвание, Единица}.
// Возврат     - Структура с протоколом загрузки.
Функция ЗагрузитьЕдиницыИзМассива(МассивСтрок) Экспорт

	Результат = НовыйПротоколЗагрузки(МассивСтрок.Количество());
	КэшНазваний = ПостроитьКэшНазваний();
	КэшЕдиниц = ПостроитьКэшЕдиниц();
	ЗаписатьЕдиницыПоКэшам(МассивСтрок, КэшНазваний, КэшЕдиниц, Результат, "ЗагрузкаРекомендуемойЕдиницы.Бух");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйПротоколЗагрузки(ВсегоСтрок)
	Результат = Новый Структура;
	Результат.Вставить("ВсегоСтрок", ВсегоСтрок);
	Результат.Вставить("Обновлено", 0);
	Результат.Вставить("БезИзменений", 0);
	Результат.Вставить("НеНайденоНазваний", Новый Массив);
	Результат.Вставить("НеНайденоЕдиниц", Новый Массив);
	Результат.Вставить("Ошибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Возврат Результат;
КонецФункции

// Общий цикл записи: по кэшам названий и единиц пишет ЕдиницаРекомендуемая в одной транзакции.
// КэшНазваний - Соответствие: НРег(имя) -> Структура(Ссылка, ЕдиницаРекомендуемая).
// КэшЕдиниц   - Соответствие: НРег(имя) -> Ссылка единицы.
Процедура ЗаписатьЕдиницыПоКэшам(МассивСтрок, КэшНазваний, КэшЕдиниц, Результат, ИмяСобытияЖурнала)

	НачатьТранзакцию();
	Попытка

		Для Каждого СтрокаДанных Из МассивСтрок Цикл

			НормНазвание = НормализоватьНаименование(СтрокаДанных.ОбщееНазвание);
			НормЕдиница = НормализоватьНаименование(СтрокаДанных.Единица);
			Если ПустаяСтрока(НормНазвание) ИЛИ ПустаяСтрока(НормЕдиница) Тогда
				Продолжить;
			КонецЕсли;

			ДанныеНазвания = КэшНазваний.Получить(НРег(НормНазвание));
			Если ДанныеНазвания = Неопределено Тогда
				Результат.НеНайденоНазваний.Добавить(НормНазвание);
				Продолжить;
			КонецЕсли;

			ЕдиницаСсылка = КэшЕдиниц.Получить(НРег(НормЕдиница));
			Если ЕдиницаСсылка = Неопределено Тогда
				Результат.НеНайденоЕдиниц.Добавить(НормНазвание + " -> «" + НормЕдиница + "»");
				Продолжить;
			КонецЕсли;

			Если ДанныеНазвания.ЕдиницаРекомендуемая = ЕдиницаСсылка Тогда
				Результат.БезИзменений = Результат.БезИзменений + 1;
				Продолжить;
			КонецЕсли;

			ОбъектНазвания = ДанныеНазвания.Ссылка.ПолучитьОбъект();
			ОбъектНазвания.ЕдиницаРекомендуемая = ЕдиницаСсылка;
			ОбъектНазвания.Записать();
			ДанныеНазвания.ЕдиницаРекомендуемая = ЕдиницаСсылка;
			Результат.Обновлено = Результат.Обновлено + 1;

		КонецЦикла;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = ОписаниеОшибки();
		Результат.Обновлено = 0;
		Результат.БезИзменений = 0;
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала,
			УровеньЖурналаРегистрации.Ошибка, , , Результат.ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Нормализация: убрать концевые пробелы + схлопнуть любые серии пробелов в один.
Функция НормализоватьНаименование(Знач Текст) Экспорт
	Текст = СокрЛП("" + Текст);
	Пока Найти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Возврат Текст;
КонецФункции

// ===== Бухгалтерия (локальные кэши) =====

// Кэш общих названий: НРег(нормализованное наименование) -> Структура(Ссылка, ЕдиницаРекомендуемая).
Функция ПостроитьКэшНазваний()
	Кэш = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.Наименование КАК Наименование,
	|	Спр.ЕдиницаРекомендуемая КАК ЕдиницаРекомендуемая
	|ИЗ
	|	Справочник.ОбщиеНазванияНоменклатуры КАК Спр
	|ГДЕ
	|	НЕ Спр.ПометкаУдаления
	|	И НЕ Спр.ЭтоГруппа";
	ЗаполнитьКэшНазванийПоЗапросу(Кэш, Запрос);
	Возврат Кэш;
КонецФункции

// Кэш единиц: НРег(нормализованное наименование) -> Ссылка.
// В классификаторе есть дубли наименований (например «шт» и « шт», м2, м3) -
// при дублях берётся элемент с максимальным числом использований
// в Номенклатура.БазоваяЕдиницаИзмерения (канонический).
Функция ПостроитьКэшЕдиниц()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Кл.Ссылка КАК Ссылка,
	|	Кл.Наименование КАК Наименование,
	|	КОЛИЧЕСТВО(Ном.Ссылка) КАК Использований
	|ИЗ
	|	Справочник.КлассификаторЕдиницИзмерения КАК Кл
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Ном
	|		ПО Ном.БазоваяЕдиницаИзмерения = Кл.Ссылка
	|ГДЕ
	|	НЕ Кл.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	Кл.Ссылка,
	|	Кл.Наименование";
	Возврат КэшЕдиницПоЗапросу(Запрос);
КонецФункции

// ===== ЕРП (локальные кэши) =====

// Кэш общих названий ЕРП: НРег(имя) -> Структура(Ссылка, ЕдиницаРекомендуемая).
Функция ПостроитьКэшНазванийЕРП()
	Кэш = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.Наименование КАК Наименование,
	|	Спр.ЕдиницаРекомендуемая КАК ЕдиницаРекомендуемая
	|ИЗ
	|	Справочник.А_ОбщиеНазванияНоменклатуры КАК Спр
	|ГДЕ
	|	НЕ Спр.ПометкаУдаления
	|	И НЕ Спр.ЭтоГруппа";
	ЗаполнитьКэшНазванийПоЗапросу(Кэш, Запрос);
	Возврат Кэш;
КонецФункции

// Кэш единиц ЕРП: НРег(имя) -> Ссылка упаковки.
// В УпаковкиЕдиницыИзмерения есть дубли («шт») - при дублях берётся элемент
// с максимальным числом использований в Номенклатура.ЕдиницаИзмерения.
Функция ПостроитьКэшЕдиницЕРП()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Уп.Ссылка КАК Ссылка,
	|	Уп.Наименование КАК Наименование,
	|	КОЛИЧЕСТВО(Ном.Ссылка) КАК Использований
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК Уп
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Ном
	|		ПО Ном.ЕдиницаИзмерения = Уп.Ссылка
	|ГДЕ
	|	НЕ Уп.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	Уп.Ссылка,
	|	Уп.Наименование";
	Возврат КэшЕдиницПоЗапросу(Запрос);
КонецФункции

// ===== Общие построители кэшей =====

Процедура ЗаполнитьКэшНазванийПоЗапросу(Кэш, Запрос)
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = НРег(НормализоватьНаименование(Выборка.Наименование));
		Если Кэш.Получить(Ключ) = Неопределено Тогда
			Кэш.Вставить(Ключ, Новый Структура("Ссылка, ЕдиницаРекомендуемая",
				Выборка.Ссылка, Выборка.ЕдиницаРекомендуемая));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция КэшЕдиницПоЗапросу(Запрос)
	Лучшие = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = НРег(НормализоватьНаименование(Выборка.Наименование));
		Найденное = Лучшие.Получить(Ключ);
		Если Найденное = Неопределено ИЛИ Выборка.Использований > Найденное.Использований Тогда
			Лучшие.Вставить(Ключ, Новый Структура("Ссылка, Использований",
				Выборка.Ссылка, Выборка.Использований));
		КонецЕсли;
	КонецЦикла;
	Кэш = Новый Соответствие;
	Для Каждого КлючЗначение Из Лучшие Цикл
		Кэш.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение.Ссылка);
	КонецЦикла;
	Возврат Кэш;
КонецФункции

// ===== COM-ветка: загрузка в Бухгалтерию из другой базы (ЕРП) =====

Функция ЗагрузитьЕдиницыБухЧерезCOM(МассивСтрок)

	Результат = НовыйПротоколЗагрузки(МассивСтрок.Количество());

	Если Метаданные.РегистрыСведений.Найти("А_НастройкиПодключенияБаз") = Неопределено Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "В этой базе нет ни справочника ОбщиеНазванияНоменклатуры,"
			+ " ни регистра А_НастройкиПодключенияБаз - загрузка в Бухгалтерию недоступна";
		Возврат Результат;
	КонецЕсли;

	СтрокаПодключения = СтрокаПодключенияБазы("bas_industrialbud", Результат);
	Если Результат.Ошибка Тогда
		Возврат Результат;
	КонецЕсли;

	ПутьКОбработке = ПутьКФайлуОбработки();
	Если ПустаяСтрока(ПутьКОбработке) Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Не найден файл обработки (.epf) для запуска в базе Бухгалтерии";
		Возврат Результат;
	КонецЕсли;

	Попытка
		V83 = Новый COMОбъект("V83.COMConnector");
		Соединение = V83.Connect(СтрокаПодключения);

		ОбработкаБух = Соединение.ВнешниеОбработки.Создать(ПутьКОбработке, Ложь);
		МассивCOM = Соединение.NewObject("Массив");
		Для Каждого СтрокаДанных Из МассивСтрок Цикл
			МассивCOM.Добавить(Соединение.NewObject("Структура", "ОбщееНазвание, Единица",
				СтрокаДанных.ОбщееНазвание, СтрокаДанных.Единица));
		КонецЦикла;

		ПротоколCOM = ОбработкаБух.ЗагрузитьЕдиницыИзМассива(МассивCOM);

		Результат.ВсегоСтрок = ПротоколCOM.ВсегоСтрок;
		Результат.Обновлено = ПротоколCOM.Обновлено;
		Результат.БезИзменений = ПротоколCOM.БезИзменений;
		Результат.Ошибка = ПротоколCOM.Ошибка;
		Результат.ТекстОшибки = Строка(ПротоколCOM.ТекстОшибки);
		Для Инд = 0 По ПротоколCOM.НеНайденоНазваний.Количество() - 1 Цикл
			Результат.НеНайденоНазваний.Добавить(Строка(ПротоколCOM.НеНайденоНазваний.Получить(Инд)));
		КонецЦикла;
		Для Инд = 0 По ПротоколCOM.НеНайденоЕдиниц.Количество() - 1 Цикл
			Результат.НеНайденоЕдиниц.Добавить(Строка(ПротоколCOM.НеНайденоЕдиниц.Получить(Инд)));
		КонецЦикла;

		ОбработкаБух = Неопределено;
		Соединение = Неопределено;
		V83 = Неопределено;
	Исключение
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Ошибка COM-загрузки в Бухгалтерию: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("ЗагрузкаРекомендуемойЕдиницы.БухCOM",
			УровеньЖурналаРегистрации.Ошибка, , , Результат.ТекстОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Строка подключения к базе из регистра А_НастройкиПодключенияБаз (только в ЕРП).
Функция СтрокаПодключенияБазы(ИдентификаторБазы, Результат)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Настройки.Сервер КАК Сервер,
	|	Настройки.ИмяБазы КАК ИмяБазы,
	|	Настройки.Пользователь КАК Пользователь,
	|	Настройки.Пароль КАК Пароль
	|ИЗ
	|	РегистрСведений.А_НастройкиПодключенияБаз КАК Настройки
	|ГДЕ
	|	Настройки.ИдентификаторБазы = &ИдентификаторБазы";
	Запрос.УстановитьПараметр("ИдентификаторБазы", ИдентификаторБазы);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "В регистре А_НастройкиПодключенияБаз нет строки с идентификатором «"
			+ ИдентификаторБазы + "»";
		Возврат "";
	КонецЕсли;

	Возврат "Srvr=""" + Выборка.Сервер + """;Ref=""" + Выборка.ИмяБазы
		+ """;Usr=""" + Выборка.Пользователь + """;Pwd=""" + Выборка.Пароль + """";

КонецФункции

// Путь к .epf этой обработки: сначала фактический файл, затем основной каталог разработок.
Функция ПутьКФайлуОбработки()

	Путь = ЭтотОбъект.ИспользуемоеИмяФайла;
	Если НЕ ПустаяСтрока(Путь) Тогда
		Файл = Новый Файл(Путь);
		Если Файл.Существует() Тогда
			Возврат Путь;
		КонецЕсли;
	КонецЕсли;

