
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ПустаяСтрока(Объект.ИмяФайла) Тогда
		Объект.ИмяФайла = "C:\Configuration_downloads\BASERP25\_Rarzrabotki\Виробництво\Копия Аналіз одиниць виміру.xlsx";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЕдиницы(Команда)
	ВыполнитьЗагрузку("Бух");
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЕдиницыВЕРП(Команда)
	ВыполнитьЗагрузку("ЕРП");
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗагрузку(Контур)

	Если НЕ ЗначениеЗаполнено(Объект.ИмяФайла) Тогда
		Сообщить("Не указан путь к файлу Excel (реквизит «Имя файла»)");
		Возврат;
	КонецЕсли;

	МассивСтрок = ПрочитатьExcelВМассив(Объект.ИмяФайла);
	Если МассивСтрок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если МассивСтрок.Количество() = 0 Тогда
		Сообщить("В файле нет строк общих названий с заполненной колонкой «Одиниця» (D)");
		Возврат;
	КонецЕсли;

	Протокол = ЗагрузитьНаСервере(МассивСтрок, Контур);
	ВывестиПротокол(Протокол, Контур);

КонецПроцедуры

&НаКлиенте
Функция ПрочитатьExcelВМассив(ИмяФайла)

	Попытка
		Excel = Новый COMОбъект("Excel.Application");
	Исключение
		Сообщить("Не удалось запустить Excel: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	МассивСтрок = Новый Массив;
	Попытка
		// ReadOnly - файл может быть открыт у пользователя
		Excel.Workbooks.Open(ИмяФайла, 0, Истина);
		Лист = Excel.WorkSheets("TDSheet");
		ВсегоСтрок = Лист.Cells(1, 1).SpecialCells(11).Row;

		ВсегоНазваний = 0;
		ПропущеноБезЕдиницы = 0;
		Для Ряд = 4 По ВсегоСтрок Цикл
			// Берём только верхний уровень группировки - строки общих названий.
			// На уровнях 2-3 (номенклатура, документы) колонка D содержит протянутый шум.
			Если Лист.Rows(Ряд).OutlineLevel <> 1 Тогда
				Продолжить;
			КонецЕсли;
			Название = СокрЛП("" + Лист.Cells(Ряд, 1).Text);
			Если ПустаяСтрока(Название) Тогда
				Продолжить;
			КонецЕсли;
			ВсегоНазваний = ВсегоНазваний + 1;
			Единица = СокрЛП("" + Лист.Cells(Ряд, 4).Text);
			Если ПустаяСтрока(Единица) Тогда
				ПропущеноБезЕдиницы = ПропущеноБезЕдиницы + 1;
				Продолжить;
			КонецЕсли;
			МассивСтрок.Добавить(Новый Структура("ОбщееНазвание, Единица", Название, Единица));
		КонецЦикла;

		Сообщить("Файл прочитан: общих названий = " + ВсегоНазваний
			+ ", с единицей (D) = " + МассивСтрок.Количество()
			+ ", без единицы = " + ПропущеноБезЕдиницы);

		Excel.ActiveWorkbook.Close(Ложь);
		Excel.Quit();
		Excel = Неопределено;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Попытка
			Excel.Quit();
		Исключение
		КонецПопытки;
		Excel = Неопределено;
		Сообщить("Ошибка чтения Excel: " + ТекстОшибки);
		Возврат Неопределено;
	КонецПопытки;

	Возврат МассивСтрок;

КонецФункции

&НаСервере
Функция ЗагрузитьНаСервере(МассивСтрок, Контур)
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Если Контур = "ЕРП" Тогда
		Возврат ОбъектОбработки.ЗагрузитьЕдиницыЕРП(МассивСтрок);
	КонецЕсли;
	Возврат ОбъектОбработки.ЗагрузитьЕдиницыБух(МассивСтрок);
КонецФункции

&НаКлиенте
Процедура ВывестиПротокол(Протокол, Контур)
	ИмяБазы = ?(Контур = "ЕРП", "ЕРП (А_ОбщиеНазванияНоменклатуры)", "Бухгалтерия (ОбщиеНазванияНоменклатуры)");
	Если Протокол.Ошибка Тогда
		Сообщить("ОШИБКА загрузки в " + ИмяБазы + " (изменения отменены): " + Протокол.ТекстОшибки);
		Возврат;
	КонецЕсли;
	Сообщить("Загрузка в " + ИмяБазы + " завершена.");
	Сообщить("  Строк из файла:     " + Протокол.ВсегоСтрок);
	Сообщить("  Обновлено карточек: " + Протокол.Обновлено);
	Сообщить("  Без изменений:      " + Протокол.БезИзменений);
	Если Протокол.НеНайденоНазваний.Количество() > 0 Тогда
		Сообщить("  НЕ НАЙДЕНЫ общие названия (" + Протокол.НеНайденоНазваний.Количество() + "):");
		Для Каждого Строка Из Протокол.НеНайденоНазваний Цикл
			Сообщить("    - " + Строка);
		КонецЦикла;
	КонецЕсли;
	Если Протокол.НеНайденоЕдиниц.Количество() > 0 Тогда
		Сообщить("  НЕ НАЙДЕНЫ единицы (" + Протокол.НеНайденоЕдиниц.Количество() + "):");
		Для Каждого Строка Из Протокол.НеНайденоЕдиниц Цикл
			Сообщить("    - " + Строка);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
