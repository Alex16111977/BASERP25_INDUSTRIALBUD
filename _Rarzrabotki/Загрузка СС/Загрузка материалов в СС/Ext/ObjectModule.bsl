
#Область ПрограммныйИнтерфейс

// Загружает строки материалов в ТЧ Комплектующие переданной структуры себестоимости.
// После записи сверяются контрольные итоги Excel/1С (строк, суммы, по этапам);
// при расхождении транзакция откатывается, загрузка не фиксируется.
// СтруктураСеб - СправочникСсылка.СтруктураСебестоимости
// МассивСтрок  - Массив структур {Этап, НоменклатураСС, ЕдиницаСС, Количество, Сумма}
// Возврат      - Структура с протоколом загрузки.
Функция ЗагрузитьМатериалыИзМассива(СтруктураСеб, МассивСтрок) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Загружено", 0);
	Результат.Вставить("СозданоЭтапов", 0);
	Результат.Вставить("СозданоНазваний", 0);
	Результат.Вставить("Пропущено", 0);
	Результат.Вставить("КонтрольПройден", Ложь);
	Результат.Вставить("Контроль", Новый Массив);
	Результат.Вставить("Инфо", Новый Массив);
	Результат.Вставить("Ошибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");

	Если НЕ ЗначениеЗаполнено(СтруктураСеб) Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Не указана структура себестоимости";
		Возврат Результат;
	КонецЕсли;

	КэшЭтапов = ПостроитьКэшЭтапов();
	КэшНазваний = ПостроитьКэшНазваний();

	ИтогиExcel = Новый Структура("Строк, Количество, Сумма, ПоЭтапам", 0, 0, 0, Новый Соответствие);

	НачатьТранзакцию();
	Попытка
		ОбъектСеб = СтруктураСеб.ПолучитьОбъект();
		ОбъектСеб.Комплектующие.Очистить();

		Для Каждого СтрокаДанных Из МассивСтрок Цикл
			НаимМатериала = СокрЛП("" + СтрокаДанных.НоменклатураСС);
			Если ПустаяСтрока(НаимМатериала) Тогда
				Результат.Пропущено = Результат.Пропущено + 1;
				Продолжить;
			КонецЕсли;

			Этап = ПолучитьИлиСоздатьЭтап(СтрокаДанных.Этап, КэшЭтапов, Результат);
			ДанныеНазвания = ПолучитьИлиСоздатьНазвание(СтрокаДанных.ОбщееНазвание, КэшНазваний, Результат);

			НоваяСтрока = ОбъектСеб.Комплектующие.Добавить();
			НоваяСтрока.Этап = Этап;
			Если ДанныеНазвания <> Неопределено Тогда
				НоваяСтрока.ОбщееНазвание = ДанныеНазвания.Ссылка;
				НоваяСтрока.Номенклатура = ДанныеНазвания.ОсновнаяНоменклатура;
				НоваяСтрока.Единица = ДанныеНазвания.Единица;
			КонецЕсли;
			НоваяСтрока.НоменклатураСС = НаимМатериала;
			НоваяСтрока.ЕдиницаСС = СокрЛП("" + СтрокаДанных.ЕдиницаСС);
			НоваяСтрока.Количество = ПолучитьЧисло(СтрокаДанных, "Количество");
			НоваяСтрока.Сумма = ПолучитьЧисло(СтрокаДанных, "Сумма");
			Результат.Загружено = Результат.Загружено + 1;

			КолОкр = Окр(НоваяСтрока.Количество, 3);
			СумОкр = Окр(НоваяСтрока.Сумма, 2);
			ИтогиExcel.Строк = ИтогиExcel.Строк + 1;
			ИтогиExcel.Количество = ИтогиExcel.Количество + КолОкр;
			ИтогиExcel.Сумма = ИтогиExcel.Сумма + СумОкр;
			СуммаЭтапа = ИтогиExcel.ПоЭтапам.Получить(Этап);
			ИтогиExcel.ПоЭтапам.Вставить(Этап, ?(СуммаЭтапа = Неопределено, 0, СуммаЭтапа) + СумОкр);
		КонецЦикла;

		ОбъектСеб.Записать();
		ПроверитьКонтрольныеИтоги(ОбъектСеб.Ссылка, ИтогиExcel, Результат);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("ЗагрузкаМатериаловВСС.Ошибка",
			УровеньЖурналаРегистрации.Ошибка, , СтруктураСеб, Результат.ТекстОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает числовое значение поля структуры по имени (пусто/не число -> 0).
Функция ПолучитьЧисло(СтрокаДанных, ИмяПоля)
	Если НЕ СтрокаДанных.Свойство(ИмяПоля) Тогда
		Возврат 0;
	КонецЕсли;
	Значение = СтрокаДанных[ИмяПоля];
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

// Нормализация: убрать концевые пробелы + схлопнуть любые серии пробелов в один.
Функция НормализоватьНаименование(Знач Текст) Экспорт
	Текст = СокрЛП("" + Текст);
	Пока Найти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Возврат Текст;
КонецФункции

// Кэш этапов: НРег(нормализованное наименование) -> Ссылка.
Функция ПостроитьКэшЭтапов()
	Кэш = Новый Соответствие;
	Запрос = Новый Запрос("ВЫБРАТЬ Наименование, Ссылка ИЗ Справочник.ЭтапыРабот");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = НРег(НормализоватьНаименование(Выборка.Наименование));
		Если Кэш.Получить(Ключ) = Неопределено Тогда
			Кэш.Вставить(Ключ, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Кэш;
КонецФункции

Функция ПолучитьИлиСоздатьЭтап(Знач Наим, КэшЭтапов, Результат)
	НормИмя = НормализоватьНаименование(Наим);
	Если ПустаяСтрока(НормИмя) Тогда
		Возврат Справочники.ЭтапыРабот.ПустаяСсылка();
	КонецЕсли;
	Ключ = НРег(НормИмя);
	Найденное = КэшЭтапов.Получить(Ключ);
	Если Найденное <> Неопределено Тогда
		Возврат Найденное;
	КонецЕсли;

	НовыйЭтап = Справочники.ЭтапыРабот.СоздатьЭлемент();
	НовыйЭтап.Наименование = НормИмя;
	НовыйЭтап.Записать();
	КэшЭтапов.Вставить(Ключ, НовыйЭтап.Ссылка);
	Результат.СозданоЭтапов = Результат.СозданоЭтапов + 1;
	Возврат НовыйЭтап.Ссылка;
КонецФункции

// Кэш общих названий: НРег(нормализованное наименование) -> Структура(Ссылка, ОсновнаяНоменклатура, Единица).
Функция ПостроитьКэшНазваний()
	Кэш = Новый Соответствие;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ Наименование, Ссылка, ОсновнаяНоменклатура, Единица
	|ИЗ Справочник.ОбщиеНазванияНоменклатуры ГДЕ НЕ ЭтоГруппа");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = НРег(НормализоватьНаименование(Выборка.Наименование));
		Если Кэш.Получить(Ключ) = Неопределено Тогда
			Данные = Новый Структура("Ссылка, ОсновнаяНоменклатура, Единица",
				Выборка.Ссылка, Выборка.ОсновнаяНоменклатура, Выборка.Единица);
			Кэш.Вставить(Ключ, Данные);
		КонецЕсли;
	КонецЦикла;
	Возврат Кэш;
КонецФункции

Функция ПолучитьИлиСоздатьНазвание(Знач Наим, КэшНазваний, Результат)
	НормИмя = НормализоватьНаименование(Наим);
	Если ПустаяСтрока(НормИмя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ключ = НРег(НормИмя);
	Найденное = КэшНазваний.Получить(Ключ);
	Если Найденное <> Неопределено Тогда
		Возврат Найденное;
	КонецЕсли;

	НовоеНазвание = Справочники.ОбщиеНазванияНоменклатуры.СоздатьЭлемент();
	НовоеНазвание.Наименование = НормИмя;
	НовоеНазвание.Записать();
	Данные = Новый Структура("Ссылка, ОсновнаяНоменклатура, Единица",
		НовоеНазвание.Ссылка, НовоеНазвание.ОсновнаяНоменклатура, НовоеНазвание.Единица);
	КэшНазваний.Вставить(Ключ, Данные);
	Результат.СозданоНазваний = Результат.СозданоНазваний + 1;
	Возврат Данные;
КонецФункции

// Истина, если модуль разницы двух чисел превышает допуск.
Функция ПревышаетДопуск(А, Б, Допуск)
	Возврат ?(А > Б, А - Б, Б - А) > Допуск;
КонецФункции

// Контроль в момент загрузки: сверяет итоги Excel-массива с фактом в базе.
// При расхождении вызывает исключение - внешний обработчик откатит транзакцию.
Процедура ПроверитьКонтрольныеИтоги(СтруктураСсылка, ИтогиExcel, Результат)

	Допуск = 0.005;
	Расхождения = "";

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Строк,
	|	СУММА(К.Количество) КАК СуммаКоличество,
	|	СУММА(К.Сумма) КАК СуммаСумма
	|ИЗ
	|	Справочник.СтруктураСебестоимости.Комплектующие КАК К
	|ГДЕ
	|	К.Ссылка = &Структура";
	Запрос.УстановитьПараметр("Структура", СтруктураСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Строк1С = ?(Выборка.Строк = NULL, 0, Выборка.Строк);
	Количество1С = ?(Выборка.СуммаКоличество = NULL, 0, Выборка.СуммаКоличество);
	Сумма1С = ?(Выборка.СуммаСумма = NULL, 0, Выборка.СуммаСумма);

	Результат.Контроль.Добавить("Строк:        Excel = " + ИтогиExcel.Строк + ", 1С = " + Строк1С);
	Результат.Контроль.Добавить("Σ Количество: Excel = " + ИтогиExcel.Количество + ", 1С = " + Количество1С);
	Результат.Контроль.Добавить("Σ Сумма:      Excel = " + ИтогиExcel.Сумма + ", 1С = " + Сумма1С);

	Если Строк1С <> ИтогиExcel.Строк Тогда
		Расхождения = Расхождения + Символы.ПС + "строк: Excel=" + ИтогиExcel.Строк + ", 1С=" + Строк1С;
	КонецЕсли;
	Если ПревышаетДопуск(Количество1С, ИтогиExcel.Количество, Допуск) Тогда
		Расхождения = Расхождения + Символы.ПС + "Σ Количество: Excel=" + ИтогиExcel.Количество + ", 1С=" + Количество1С;
	КонецЕсли;
	Если ПревышаетДопуск(Сумма1С, ИтогиExcel.Сумма, Допуск) Тогда
		Расхождения = Расхождения + Символы.ПС + "Σ Сумма: Excel=" + ИтогиExcel.Сумма + ", 1С=" + Сумма1С;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.Этап КАК Этап,
	|	СУММА(К.Сумма) КАК СуммаСумма
	|ИЗ
	|	Справочник.СтруктураСебестоимости.Комплектующие КАК К
	|ГДЕ
	|	К.Ссылка = &Структура
	|
	|СГРУППИРОВАТЬ ПО
	|	К.Этап";
	Запрос.УстановитьПараметр("Структура", СтруктураСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Этапы1С = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Этапы1С.Вставить(Выборка.Этап, Выборка.СуммаСумма);
	КонецЦикла;

	Для Каждого КлючЗначение Из ИтогиExcel.ПоЭтапам Цикл
		Сумма1СЭтапа = Этапы1С.Получить(КлючЗначение.Ключ);
		Сумма1СЭтапа = ?(Сумма1СЭтапа = Неопределено, 0, Сумма1СЭтапа);
		Результат.Контроль.Добавить("Этап " + КлючЗначение.Ключ + ": Excel = " + КлючЗначение.Значение + ", 1С = " + Сумма1СЭтапа);
		Если ПревышаетДопуск(Сумма1СЭтапа, КлючЗначение.Значение, Допуск) Тогда
			Расхождения = Расхождения + Символы.ПС + "этап " + КлючЗначение.Ключ + ": Excel=" + КлючЗначение.Значение + ", 1С=" + Сумма1СЭтапа;
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючЗначение Из Этапы1С Цикл
		Если ИтогиExcel.ПоЭтапам.Получить(КлючЗначение.Ключ) = Неопределено Тогда
			Расхождения = Расхождения + Символы.ПС + "этап " + КлючЗначение.Ключ + " есть в 1С, нет в Excel";
		КонецЕсли;
	КонецЦикла;

	Если НЕ ПустаяСтрока(Расхождения) Тогда
		ВызватьИсключение "КОНТРОЛЬ ЗАГРУЗКИ НЕ ПРОЙДЕН:" + Расхождения;
	КонецЕсли;
	Результат.КонтрольПройден = Истина;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ К.НоменклатураСС) КАК УникальныхНаименований,
	|	СУММА(ВЫБОР КОГДА К.ОбщееНазвание = ЗНАЧЕНИЕ(Справочник.ОбщиеНазванияНоменклатуры.ПустаяСсылка) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК БезОбщегоНазвания,
	|	СУММА(ВЫБОР КОГДА К.Единица = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК БезЕдиницы,
	|	СУММА(ВЫБОР КОГДА К.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК БезНоменклатуры
	|ИЗ
	|	Справочник.СтруктураСебестоимости.Комплектующие КАК К
	|ГДЕ
	|	К.Ссылка = &Структура";
	Запрос.УстановитьПараметр("Структура", СтруктураСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Инфо.Добавить("Уникальных наименований: " + Выборка.УникальныхНаименований);
		Результат.Инфо.Добавить("Без общего названия: " + Выборка.БезОбщегоНазвания
			+ ", без единицы: " + Выборка.БезЕдиницы + ", без номенклатуры: " + Выборка.БезНоменклатуры);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
