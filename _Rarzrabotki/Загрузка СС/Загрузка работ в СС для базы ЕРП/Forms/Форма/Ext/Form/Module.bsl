
&НаКлиенте
Процедура ЗагрузитьРаботы(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.ИмяФайла) Тогда
		Сообщить("Не указан путь к файлу Excel (реквизит «Имя файла»)");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ДокСтруктураСебестоимости) Тогда
		Сообщить("Не выбрана структура себестоимости");
		Возврат;
	КонецЕсли;

	МассивСтрок = ПрочитатьExcelВМассив(Объект.ИмяФайла);
	Если МассивСтрок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Протокол = ЗагрузитьНаСервере(МассивСтрок);
	ВывестиПротокол(Протокол);

КонецПроцедуры

// Читает лист «Проект СС» (по имени): строки с колонкой C = "Робота" ДО раздела
// «Загальновиробничі витрати» - дальше идут статьи затрат, а не работы (не загружаются).
// Маппинг: Этап <- E (Тип робіт), Работа <- G (Найменування робіт), Единица <- I (Од. вим.),
// Количество <- J (Кіль-кість), Цена <- K (за од.виміру), Сумма <- M (за повний обсяг).
&НаКлиенте
Функция ПрочитатьExcelВМассив(ИмяФайла)

	Попытка
		Excel = Новый COMОбъект("Excel.Application");
	Исключение
		Сообщить("Не удалось запустить Excel: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	МассивСтрок = Новый Массив;
	Попытка
		Excel.Workbooks.Open(ИмяФайла);
		Лист = Excel.WorkSheets("Проект СС");
		ВсегоСтрок = Лист.Cells(1, 1).SpecialCells(11).Row;

		ВсегоРабота = 0;
		ПропущеноПустых = 0;
		Для Ряд = 2 По ВсегоСтрок Цикл
			// Граница загрузки: раздел «Загальновиробничі витрати» (статьи затрат, не работы).
			Если НормИмяКлиент(Лист.Cells(Ряд, 5).Text) = "загальновиробничі витрати"
				ИЛИ НормИмяКлиент(Лист.Cells(Ряд, 7).Text) = "загальновиробничі витрати" Тогда
				Сообщить("Чтение остановлено на разделе «Загальновиробничі витрати» (строка " + Ряд
					+ ") - статьи затрат не загружаются");
				Прервать;
			КонецЕсли;

			ТипСтроки = СокрЛП("" + Лист.Cells(Ряд, 3).Text);
			Если ТипСтроки <> "Робота" Тогда
				Продолжить;
			КонецЕсли;
			ВсегоРабота = ВсегоРабота + 1;

			НаимРаботы = СокрЛП("" + Лист.Cells(Ряд, 7).Text);
			Если ПустаяСтрока(НаимРаботы) Тогда
				ПропущеноПустых = ПропущеноПустых + 1;
				Продолжить;
			КонецЕсли;

			Стр = Новый Структура("Этап, Работа, Единица, Количество, Цена, Сумма");
			Стр.Этап = СокрЛП("" + Лист.Cells(Ряд, 5).Text);
			Стр.Работа = НаимРаботы;
			Стр.Единица = СокрЛП("" + Лист.Cells(Ряд, 9).Text);
			Стр.Количество = ЧислоИзЯчейки(Лист.Cells(Ряд, 10).Value);
			Стр.Цена = ЧислоИзЯчейки(Лист.Cells(Ряд, 11).Value);
			Стр.Сумма = ЧислоИзЯчейки(Лист.Cells(Ряд, 13).Value);
			МассивСтрок.Добавить(Стр);
		КонецЦикла;

		Сообщить("Файл прочитан: строк «Робота» = " + ВсегоРабота
			+ ", взято = " + МассивСтрок.Количество() + ", пропущено пустых = " + ПропущеноПустых);

		Excel.ActiveWorkbook.Close(Ложь);
		Excel.Quit();
		Excel = Неопределено;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Попытка
			Excel.Quit();
		Исключение
		КонецПопытки;
		Excel = Неопределено;
		Сообщить("Ошибка чтения Excel: " + ТекстОшибки);
		Возврат Неопределено;
	КонецПопытки;

	Возврат МассивСтрок;

КонецФункции

// Нормализация для сравнения: СокрЛП + схлопывание серий пробелов + нижний регистр.
&НаКлиенте
Функция НормИмяКлиент(Знач Текст)
	Текст = СокрЛП("" + Текст);
	Пока Найти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Возврат НРег(Текст);
КонецФункции

&НаКлиенте
Функция ЧислоИзЯчейки(Значение)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

&НаСервере
Функция ЗагрузитьНаСервере(МассивСтрок)
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектОбработки.ЗагрузитьРаботыИзМассива(
		ОбъектОбработки.ДокСтруктураСебестоимости, МассивСтрок);
КонецФункции

&НаКлиенте
Процедура ВывестиПротокол(Протокол)
	Если Протокол.Ошибка Тогда
		Сообщить("ОШИБКА загрузки: " + Протокол.ТекстОшибки);
		Возврат;
	КонецЕсли;
	Сообщить("Загрузка завершена.");
	Сообщить("  Загружено строк:  " + Протокол.Загружено);
	Сообщить("  Создано работ:    " + Протокол.СозданоРабот);
	Сообщить("  Создано этапов:   " + Протокол.СозданоЭтапов);
	Сообщить("  Пропущено пустых: " + Протокол.Пропущено);
	Сообщить(?(Протокол.КонтрольПройден, "КОНТРОЛЬ ЗАГРУЗКИ: ПРОЙДЕН", "КОНТРОЛЬ ЗАГРУЗКИ: НЕ ВЫПОЛНЕН"));
	Для Каждого Строка Из Протокол.Контроль Цикл
		Сообщить("  " + Строка);
	КонецЦикла;
	Для Каждого Строка Из Протокол.Инфо Цикл
		Сообщить("  " + Строка);
	КонецЦикла;
КонецПроцедуры
