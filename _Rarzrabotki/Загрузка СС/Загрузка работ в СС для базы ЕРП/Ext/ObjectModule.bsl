
#Область ПрограммныйИнтерфейс

// Загружает строки работ в ТЧ Работы переданной структуры себестоимости.
// После записи сверяются контрольные итоги Excel/1С (строк, Σ Количество, Σ Сумма, Σ Сумма по этапам);
// при расхождении транзакция откатывается, загрузка не фиксируется.
// СтруктураСеб - СправочникСсылка.А_СтруктураСебестоимости
// МассивСтрок  - Массив структур {Этап, Работа, Единица, Количество, Цена, Сумма}
// Возврат      - Структура с протоколом загрузки.
Функция ЗагрузитьРаботыИзМассива(СтруктураСеб, МассивСтрок) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Загружено", 0);
	Результат.Вставить("СозданоРабот", 0);
	Результат.Вставить("СозданоЭтапов", 0);
	Результат.Вставить("Пропущено", 0);
	Результат.Вставить("КонтрольПройден", Ложь);
	Результат.Вставить("Контроль", Новый Массив);
	Результат.Вставить("Инфо", Новый Массив);
	Результат.Вставить("Ошибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");

	Если НЕ ЗначениеЗаполнено(СтруктураСеб) Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Не указана структура себестоимости";
		Возврат Результат;
	КонецЕсли;

	ГруппаРоботи = НайтиГруппуРоботи();
	Если НЕ ЗначениеЗаполнено(ГруппаРоботи) Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Не найдена группа номенклатуры _Роботи (код 0Ц-00000016)";
		Возврат Результат;
	КонецЕсли;

	Образец = НайтиОбразецРаботы(ГруппаРоботи);
	Если НЕ ЗначениеЗаполнено(Образец) Тогда
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Не найден образец работы (артикул 1.1.1) в группе _Роботи";
		Возврат Результат;
	КонецЕсли;
	ОбъектОбразца = Образец.ПолучитьОбъект();

	КэшЭтапов  = ПостроитьКэшЭтапов();
	КэшРабот   = ПостроитьКэшРабот(ГруппаРоботи);
	КэшЕдиниц  = ПостроитьКэшЕдиниц();
	НенайденныеЕдиницы = Новый Соответствие;

	ИтогиExcel = Новый Структура("Строк, Количество, Сумма, ПоЭтапам", 0, 0, 0, Новый Соответствие);

	НачатьТранзакцию();
	Попытка
		ОбъектСеб = СтруктураСеб.ПолучитьОбъект();
		ОбъектСеб.Работы.Очистить();

		Для Каждого СтрокаДанных Из МассивСтрок Цикл
			НаимРаботы = СокрЛП("" + СтрокаДанных.Работа);
			Если ПустаяСтрока(НаимРаботы) Тогда
				Результат.Пропущено = Результат.Пропущено + 1;
				Продолжить;
			КонецЕсли;

			Этап   = ПолучитьИлиСоздатьЭтап(СтрокаДанных.Этап, КэшЭтапов, Результат);
			Работа = ПолучитьИлиСоздатьРаботу(НаимРаботы, ГруппаРоботи, ОбъектОбразца, КэшРабот, Результат);

			ИмяЕдиницы = ПолучитьСтроку(СтрокаДанных, "Единица");
			Единица = НайтиЕдиницу(ИмяЕдиницы, КэшЕдиниц);
			Если НЕ ЗначениеЗаполнено(Единица) И НЕ ПустаяСтрока(ИмяЕдиницы) Тогда
				СчетчикЕд = НенайденныеЕдиницы.Получить(ИмяЕдиницы);
				НенайденныеЕдиницы.Вставить(ИмяЕдиницы, ?(СчетчикЕд = Неопределено, 0, СчетчикЕд) + 1);
			КонецЕсли;

			НоваяСтрока = ОбъектСеб.Работы.Добавить();
			НоваяСтрока.Этап = Этап;
			НоваяСтрока.Работа = Работа;
			НоваяСтрока.Единица = Единица;
			НоваяСтрока.Количество = ПолучитьЧисло(СтрокаДанных, "Количество");
			НоваяСтрока.Цена = ПолучитьЧисло(СтрокаДанных, "Цена");
			НоваяСтрока.Сумма = ПолучитьЧисло(СтрокаДанных, "Сумма");
			Результат.Загружено = Результат.Загружено + 1;

			// Контрольные итоги: округление под квалификаторы ТЧ Работы (Количество 15.2, Сумма 10.2).
			КолОкр = Окр(НоваяСтрока.Количество, 2);
			СумОкр = Окр(НоваяСтрока.Сумма, 2);
			ИтогиExcel.Строк = ИтогиExcel.Строк + 1;
			ИтогиExcel.Количество = ИтогиExcel.Количество + КолОкр;
			ИтогиExcel.Сумма = ИтогиExcel.Сумма + СумОкр;
			СуммаЭтапа = ИтогиExcel.ПоЭтапам.Получить(Этап);
			ИтогиExcel.ПоЭтапам.Вставить(Этап, ?(СуммаЭтапа = Неопределено, 0, СуммаЭтапа) + СумОкр);
		КонецЦикла;

		ОбъектСеб.Записать();
		ПроверитьКонтрольныеИтоги(ОбъектСеб.Ссылка, ИтогиExcel, Результат);
		Для Каждого КлючЗначение Из НенайденныеЕдиницы Цикл
			Результат.Инфо.Добавить("Единица не найдена в базовых: «" + КлючЗначение.Ключ
				+ "» (строк: " + КлючЗначение.Значение + ") - оставлена пустой");
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("ЗагрузкаРаботВССДляЕРП.Ошибка",
			УровеньЖурналаРегистрации.Ошибка, , СтруктураСеб, Результат.ТекстОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает числовое значение поля структуры по имени (пусто/не число -> 0).
Функция ПолучитьЧисло(СтрокаДанных, ИмяПоля)
	Если НЕ СтрокаДанных.Свойство(ИмяПоля) Тогда
		Возврат 0;
	КонецЕсли;
	Значение = СтрокаДанных[ИмяПоля];
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

// Возвращает строковое значение поля структуры по имени (нет поля/пусто -> "").
Функция ПолучитьСтроку(СтрокаДанных, ИмяПоля)
	Значение = Неопределено;
	Если НЕ СтрокаДанных.Свойство(ИмяПоля, Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП("" + Значение);
КонецФункции

// Нормализация: убрать концевые пробелы + схлопнуть любые серии пробелов в один.
// Симметрична для базы и Excel - в базе есть работы с двойными пробелами.
Функция НормализоватьНаименование(Знач Текст) Экспорт
	Текст = СокрЛП("" + Текст);
	Пока Найти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция НайтиГруппуРоботи()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура
	|ГДЕ Код = &Код И ЭтоГруппа";
	Запрос.УстановитьПараметр("Код", "0Ц-00000016");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция НайтиОбразецРаботы(ГруппаРоботи)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура
	|ГДЕ Артикул = &Арт И НЕ ЭтоГруппа И Родитель В ИЕРАРХИИ(&Гр)";
	Запрос.УстановитьПараметр("Арт", "1.1.1");
	Запрос.УстановитьПараметр("Гр", ГруппаРоботи);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Кэш этапов: НРег(нормализованное наименование) -> Ссылка.
Функция ПостроитьКэшЭтапов()
	Кэш = Новый Соответствие;
	Запрос = Новый Запрос("ВЫБРАТЬ Наименование, Ссылка ИЗ Справочник.А_ЭтапыРабот");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = НРег(НормализоватьНаименование(Выборка.Наименование));
		Если Кэш.Получить(Ключ) = Неопределено Тогда
			Кэш.Вставить(Ключ, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Кэш;
КонецФункции

// Кэш работ в _Роботи: НРег(нормализованное наименование) -> Ссылка.
Функция ПостроитьКэшРабот(ГруппаРоботи)
	Кэш = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Наименование, Ссылка ИЗ Справочник.Номенклатура
	|ГДЕ НЕ ЭтоГруппа И Родитель В ИЕРАРХИИ(&Гр)";
	Запрос.УстановитьПараметр("Гр", ГруппаРоботи);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = НРег(НормализоватьНаименование(Выборка.Наименование));
		Если Кэш.Получить(Ключ) = Неопределено Тогда
			Кэш.Вставить(Ключ, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Кэш;
КонецФункции

Функция СрезатьХвостовуюТочку(Знач Текст)
	Пока СтрЗаканчиваетсяНа(Текст, ".") Цикл
		Текст = СокрЛП(Лев(Текст, СтрДлина(Текст) - 1));
	КонецЦикла;
	Возврат Текст;
КонецФункции

// Кэш базовых единиц измерения (владелец - предопределённый набор БазовыеЕдиницыИзмерения):
// НРег(вариант имени) -> Ссылка. Приоритет ключей (первый занявший ключ выигрывает):
// 1) точное «чистое» Наименование, 2) нормализованное Наименование,
// 3) Наименование без хвостовой точки, 4) НаименованиеПолное (нормализованное, без точки).
// Так Excel «шт» находит элемент «шт» (а не « шт»), «послуга»/«посл» - элемент «посл.».
Функция ПостроитьКэшЕдиниц()
	Кэш = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Наименование, НаименованиеПолное, Ссылка ИЗ Справочник.УпаковкиЕдиницыИзмерения
	|ГДЕ Владелец = ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.БазовыеЕдиницыИзмерения)";
	Таблица = Запрос.Выполнить().Выгрузить();
	Для Приоритет = 1 По 4 Цикл
		Для Каждого СтрокаЕд Из Таблица Цикл
			НормИмя = НормализоватьНаименование(СтрокаЕд.Наименование);
			Если Приоритет = 1 Тогда
				Если СтрокаЕд.Наименование <> НормИмя Тогда
					Продолжить;
				КонецЕсли;
				Ключ = НРег(НормИмя);
			ИначеЕсли Приоритет = 2 Тогда
				Ключ = НРег(НормИмя);
			ИначеЕсли Приоритет = 3 Тогда
				Ключ = НРег(СрезатьХвостовуюТочку(НормИмя));
			Иначе
				Ключ = НРег(СрезатьХвостовуюТочку(НормализоватьНаименование(СтрокаЕд.НаименованиеПолное)));
			КонецЕсли;
			Если НЕ ПустаяСтрока(Ключ) И Кэш.Получить(Ключ) = Неопределено Тогда
				Кэш.Вставить(Ключ, СтрокаЕд.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Кэш;
КонецФункции

// Поиск единицы по имени из Excel: точный ключ, затем без хвостовой точки.
// Не найдена -> пустая ссылка (загрузку не блокирует, попадает в Инфо-протокол).
Функция НайтиЕдиницу(Знач Наим, КэшЕдиниц)
	НормИмя = НРег(НормализоватьНаименование(Наим));
	Если ПустаяСтрока(НормИмя) Тогда
		Возврат Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	КонецЕсли;
	Найденное = КэшЕдиниц.Получить(НормИмя);
	Если Найденное = Неопределено Тогда
		Найденное = КэшЕдиниц.Получить(СрезатьХвостовуюТочку(НормИмя));
	КонецЕсли;
	Если Найденное = Неопределено Тогда
		Возврат Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	КонецЕсли;
	Возврат Найденное;
КонецФункции

Функция ПолучитьИлиСоздатьЭтап(Знач Наим, КэшЭтапов, Результат)
	НормИмя = НормализоватьНаименование(Наим);
	Если ПустаяСтрока(НормИмя) Тогда
		Возврат Справочники.А_ЭтапыРабот.ПустаяСсылка();
	КонецЕсли;
	Ключ = НРег(НормИмя);
	Найденное = КэшЭтапов.Получить(Ключ);
	Если Найденное <> Неопределено Тогда
		Возврат Найденное;
	КонецЕсли;

	НовыйЭтап = Справочники.А_ЭтапыРабот.СоздатьЭлемент();
	НовыйЭтап.Наименование = НормИмя;
	НовыйЭтап.Записать();
	КэшЭтапов.Вставить(Ключ, НовыйЭтап.Ссылка);
	Результат.СозданоЭтапов = Результат.СозданоЭтапов + 1;
	Возврат НовыйЭтап.Ссылка;
КонецФункции

// Работа не найдена в кэше -> клон образца (артикул 1.1.1): наследует все обязательные
// реквизиты (вид Послуга, ед. чол-год, НДС 20%) кроме кода/артикула/наименования/родителя.
Функция ПолучитьИлиСоздатьРаботу(Знач Наим, ГруппаРоботи, ОбъектОбразца, КэшРабот, Результат)
	НормИмя = НормализоватьНаименование(Наим);
	Ключ = НРег(НормИмя);
	Найденное = КэшРабот.Получить(Ключ);
	Если Найденное <> Неопределено Тогда
		Возврат Найденное;
	КонецЕсли;

	НоваяРабота = Справочники.Номенклатура.СоздатьЭлемент();
	ЗаполнитьЗначенияСвойств(НоваяРабота, ОбъектОбразца, ,
		"Код,Артикул,Наименование,НаименованиеПолное,Ссылка,Родитель,Владелец,ПометкаУдаления,Предопределенный,ИмяПредопределенныхДанных");
	НоваяРабота.Наименование = НормИмя;
	НоваяРабота.НаименованиеПолное = НормИмя;
	НоваяРабота.Родитель = ГруппаРоботи;
	НоваяРабота.Записать();
	КэшРабот.Вставить(Ключ, НоваяРабота.Ссылка);
	Результат.СозданоРабот = Результат.СозданоРабот + 1;
	Возврат НоваяРабота.Ссылка;
КонецФункции

// Истина, если модуль разницы двух чисел превышает допуск.
Функция ПревышаетДопуск(А, Б, Допуск)
	Возврат ?(А > Б, А - Б, Б - А) > Допуск;
КонецФункции

// Контроль в момент загрузки: сверяет итоги Excel-массива с фактом в базе.
// При расхождении вызывает исключение - внешний обработчик откатит транзакцию.
Процедура ПроверитьКонтрольныеИтоги(СтруктураСсылка, ИтогиExcel, Результат)

	Допуск = 0.005;
	Расхождения = "";

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Строк,
	|	СУММА(Р.Количество) КАК СуммаКоличество,
	|	СУММА(Р.Сумма) КАК СуммаСумма
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Работы КАК Р
	|ГДЕ
	|	Р.Ссылка = &Структура";
	Запрос.УстановитьПараметр("Структура", СтруктураСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Строк1С = ?(Выборка.Строк = NULL, 0, Выборка.Строк);
	Количество1С = ?(Выборка.СуммаКоличество = NULL, 0, Выборка.СуммаКоличество);
	Сумма1С = ?(Выборка.СуммаСумма = NULL, 0, Выборка.СуммаСумма);

	Результат.Контроль.Добавить("Строк:        Excel = " + ИтогиExcel.Строк + ", 1С = " + Строк1С);
	Результат.Контроль.Добавить("Σ Количество: Excel = " + ИтогиExcel.Количество + ", 1С = " + Количество1С);
	Результат.Контроль.Добавить("Σ Сумма:      Excel = " + ИтогиExcel.Сумма + ", 1С = " + Сумма1С);

	Если Строк1С <> ИтогиExcel.Строк Тогда
		Расхождения = Расхождения + Символы.ПС + "строк: Excel=" + ИтогиExcel.Строк + ", 1С=" + Строк1С;
	КонецЕсли;
	Если ПревышаетДопуск(Количество1С, ИтогиExcel.Количество, Допуск) Тогда
		Расхождения = Расхождения + Символы.ПС + "Σ Количество: Excel=" + ИтогиExcel.Количество + ", 1С=" + Количество1С;
	КонецЕсли;
	Если ПревышаетДопуск(Сумма1С, ИтогиExcel.Сумма, Допуск) Тогда
		Расхождения = Расхождения + Символы.ПС + "Σ Сумма: Excel=" + ИтогиExcel.Сумма + ", 1С=" + Сумма1С;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.Этап КАК Этап,
	|	СУММА(Р.Сумма) КАК СуммаСумма
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Работы КАК Р
	|ГДЕ
	|	Р.Ссылка = &Структура
	|
	|СГРУППИРОВАТЬ ПО
	|	Р.Этап";
	Запрос.УстановитьПараметр("Структура", СтруктураСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Этапы1С = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Этапы1С.Вставить(Выборка.Этап, Выборка.СуммаСумма);
	КонецЦикла;

	Для Каждого КлючЗначение Из ИтогиExcel.ПоЭтапам Цикл
		Сумма1СЭтапа = Этапы1С.Получить(КлючЗначение.Ключ);
		Сумма1СЭтапа = ?(Сумма1СЭтапа = Неопределено, 0, Сумма1СЭтапа);
		Результат.Контроль.Добавить("Этап " + КлючЗначение.Ключ + ": Excel = " + КлючЗначение.Значение + ", 1С = " + Сумма1СЭтапа);
		Если ПревышаетДопуск(Сумма1СЭтапа, КлючЗначение.Значение, Допуск) Тогда
			Расхождения = Расхождения + Символы.ПС + "этап " + КлючЗначение.Ключ + ": Excel=" + КлючЗначение.Значение + ", 1С=" + Сумма1СЭтапа;
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючЗначение Из Этапы1С Цикл
		Если ИтогиExcel.ПоЭтапам.Получить(КлючЗначение.Ключ) = Неопределено Тогда
			Расхождения = Расхождения + Символы.ПС + "этап " + КлючЗначение.Ключ + " есть в 1С, нет в Excel";
		КонецЕсли;
	КонецЦикла;

	Если НЕ ПустаяСтрока(Расхождения) Тогда
		ВызватьИсключение "КОНТРОЛЬ ЗАГРУЗКИ НЕ ПРОЙДЕН:" + Расхождения;
	КонецЕсли;
	Результат.КонтрольПройден = Истина;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Р.Работа) КАК УникальныхРабот,
	|	СУММА(ВЫБОР КОГДА Р.Этап = ЗНАЧЕНИЕ(Справочник.А_ЭтапыРабот.ПустаяСсылка) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК БезЭтапа,
	|	СУММА(ВЫБОР КОГДА Р.Работа = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК БезРаботы,
	|	СУММА(ВЫБОР КОГДА Р.Единица = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК БезЕдиницы
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Работы КАК Р
	|ГДЕ
	|	Р.Ссылка = &Структура";
	Запрос.УстановитьПараметр("Структура", СтруктураСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Инфо.Добавить("Уникальных работ: " + Выборка.УникальныхРабот);
		Результат.Инфо.Добавить("Строк без этапа: " + Выборка.БезЭтапа
			+ ", без работы: " + Выборка.БезРаботы + ", без единицы: " + Выборка.БезЕдиницы);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
