
&НаКлиенте
Процедура ЗагрузитьРаботы(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.ИмяФайла) Тогда
		Сообщить("Не указан путь к файлу Excel (реквизит «Имя файла»)");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ДокСтруктураСебестоимости) Тогда
		Сообщить("Не выбрана структура себестоимости");
		Возврат;
	КонецЕсли;

	МассивСтрок = ПрочитатьExcelВМассив(Объект.ИмяФайла);
	Если МассивСтрок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Протокол = ЗагрузитьНаСервере(МассивСтрок);
	ВывестиПротокол(Протокол);

КонецПроцедуры

&НаКлиенте
Функция ПрочитатьExcelВМассив(ИмяФайла)

	Попытка
		Excel = Новый COMОбъект("Excel.Application");
	Исключение
		Сообщить("Не удалось запустить Excel: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	МассивСтрок = Новый Массив;
	Попытка
		Excel.Workbooks.Open(ИмяФайла);
		Лист = Excel.WorkSheets(1);
		ВсегоСтрок = Лист.Cells(1, 1).SpecialCells(11).Row;

		Для Ряд = 2 По ВсегоСтрок Цикл
			НаимРаботы = СокрЛП("" + Лист.Cells(Ряд, 2).Text);
			Если ПустаяСтрока(НаимРаботы) Тогда
				Продолжить;
			КонецЕсли;

			Стр = Новый Структура("Этап, Работа, Количество, Цена, Сумма");
			Стр.Этап = СокрЛП("" + Лист.Cells(Ряд, 1).Text);
			Стр.Работа = НаимРаботы;
			Стр.Количество = ЧислоИзЯчейки(Лист.Cells(Ряд, 3).Value);
			Стр.Цена = ЧислоИзЯчейки(Лист.Cells(Ряд, 4).Value);
			Стр.Сумма = ЧислоИзЯчейки(Лист.Cells(Ряд, 5).Value);
			МассивСтрок.Добавить(Стр);
		КонецЦикла;

		Excel.ActiveWorkbook.Close(Ложь);
		Excel.Quit();
		Excel = Неопределено;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Попытка
			Excel.Quit();
		Исключение
		КонецПопытки;
		Excel = Неопределено;
		Сообщить("Ошибка чтения Excel: " + ТекстОшибки);
		Возврат Неопределено;
	КонецПопытки;

	Возврат МассивСтрок;

КонецФункции

&НаКлиенте
Функция ЧислоИзЯчейки(Значение)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

&НаСервере
Функция ЗагрузитьНаСервере(МассивСтрок)
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектОбработки.ЗагрузитьРаботыИзМассива(
		ОбъектОбработки.ДокСтруктураСебестоимости, МассивСтрок);
КонецФункции

&НаКлиенте
Процедура ВывестиПротокол(Протокол)
	Если Протокол.Ошибка Тогда
		Сообщить("ОШИБКА загрузки: " + Протокол.ТекстОшибки);
		Возврат;
	КонецЕсли;
	Сообщить("Загрузка завершена.");
	Сообщить("  Загружено строк: " + Протокол.Загружено);
	Сообщить("  Создано работ:   " + Протокол.СозданоРабот);
	Сообщить("  Создано этапов:  " + Протокол.СозданоЭтапов);
	Сообщить("  Пропущено пустых: " + Протокол.Пропущено);
КонецПроцедуры
