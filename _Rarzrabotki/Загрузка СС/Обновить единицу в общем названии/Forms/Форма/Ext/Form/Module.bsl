
&НаСервере
Функция ОбновитьНаСервере()
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектОбработки.ОбновитьВОбщемНазванииЕдиницу();
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПоВсемАктивнымВОбщемНазванииЕдиницу(Команда)

	Протокол = ОбновитьНаСервере();

	Если Протокол.Ошибка Тогда
		Сообщить("ОШИБКА: " + Протокол.ТекстОшибки);
		Возврат;
	КонецЕсли;

	Сообщить("Заполнение завершено.");
	Сообщить("  Из структур себестоимости (мода): " + Протокол.ИзСтруктур);
	Сообщить("  Из закупаемой номенклатуры:       " + Протокол.ИзНоменклатуры);
	Сообщить("  Из единственной привязки:         " + Протокол.ИзЕдинственнойПривязки);
	Сообщить("  Ничьих конфликтов (пропущено):    " + Протокол.НичьихКонфликтов);
	Сообщить("  Осталось пустых:                  " + Протокол.ОсталосьПустых);

	Если Протокол.СписокКонфликтов.Количество() > 0 Тогда
		Сообщить("--- Конфликты единиц (проверьте выбор) ---");
		Для Каждого Строка Из Протокол.СписокКонфликтов Цикл
			Сообщить("  " + Строка);
		КонецЦикла;
	КонецЕсли;

	Если Протокол.СписокПустых.Количество() > 0 Тогда
		Сообщить("--- Карточки без единицы (заполнить вручную) ---");
		Для Каждого Строка Из Протокол.СписокПустых Цикл
			Сообщить("  " + Строка);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗаполнитьНоменклатуруНаСервере()
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектОбработки.ЗаполнитьОсновнуюНоменклатуру();
КонецФункции

&НаКлиенте
Процедура ЗаполнитьОсновнуюНоменклатуру(Команда)

	Протокол = ЗаполнитьНоменклатуруНаСервере();

	Если Протокол.Ошибка Тогда
		Сообщить("ОШИБКА: " + Протокол.ТекстОшибки);
		Возврат;
	КонецЕсли;

	Сообщить("Заполнение основной номенклатуры завершено (заполненные ранее карточки пропущены).");
	Сообщить("  Из приходных накладных (лидер): " + Протокол.ИзЗакупок);
	Сообщить("  Из единственной привязки:       " + Протокол.ИзЕдинственнойПривязки);
	Сообщить("  Осталось пустых:                " + Протокол.ОсталосьПустых);

	Если Протокол.СписокРасхожденийЕдиниц.Количество() > 0 Тогда
		Сообщить("--- Единица карточки не совпадает с базовой единицей номенклатуры ---");
		Для Каждого Строка Из Протокол.СписокРасхожденийЕдиниц Цикл
			Сообщить("  " + Строка);
		КонецЦикла;
	КонецЕсли;

	Если Протокол.СписокПустых.Количество() > 0 Тогда
		Сообщить("--- Карточки без основной номенклатуры (нет привязок) ---");
		Для Каждого Строка Из Протокол.СписокПустых Цикл
			Сообщить("  " + Строка);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры
