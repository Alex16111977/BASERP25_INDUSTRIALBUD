Процедура ОбновитьВОбщемНазванииЕдиницу() Экспорт

Запрос = Новый Запрос;
Запрос.Текст =  "ВЫБРАТЬ
                |	СтруктураСебестоимости.Ссылка КАК Ссылка
                |ИЗ
                |	Справочник.СтруктураСебестоимости КАК СтруктураСебестоимости
                |ГДЕ
                |	СтруктураСебестоимости.Активная";

Выборка = Запрос.Выполнить().Выбрать();
Пока Выборка.Следующий() Цикл
  СпрСтруктураСебестоимости = Выборка.Ссылка;
	
   Для каждого СтрокаТЗ Из СпрСтруктураСебестоимости.Комплектующие Цикл
	   Если ЗначениеЗаполнено(СтрокаТЗ.ОбщееНазвание) 
		   И ЗначениеЗаполнено(СтрокаТЗ.Единица)
		   И НЕ ЗначениеЗаполнено(СтрокаТЗ.ОбщееНазвание.Единица) Тогда
	    
	  	 СпрОбщееНазвание = СтрокаТЗ.ОбщееНазвание.ПолучитьОбъект();
	     СпрОбщееНазвание.Единица = СтрокаТЗ.Единица;
		 СпрОбщееНазвание.Записать();
		 
	  КонецЕсли;
   	  
   
   КонецЦикла;
КонецЦикла;

КонецПроцедуры
