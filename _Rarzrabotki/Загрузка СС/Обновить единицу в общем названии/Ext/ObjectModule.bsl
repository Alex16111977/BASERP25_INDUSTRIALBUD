
#Область ПрограммныйИнтерфейс

// Заполняет реквизит Единица справочника ОбщиеНазванияНоменклатуры по каскаду:
// П1  - наиболее частая (мода) единица по строкам ТЧ Комплектующие АКТИВНЫХ структур
//       себестоимости; при ничьей голосов карточка пропускается (в протокол);
// П2  - базовая единица самой закупаемой привязанной номенклатуры (СУММА(Количество)
//       по проведённым ПоступлениеТоваровУслуг, при равенстве - большая сумма);
// П2б - базовая единица ЕДИНСТВЕННОЙ привязанной номенклатуры (когда закупок нет).
// Заполняются только карточки с пустой Единицей. Возврат - структура-протокол.
Функция ОбновитьВОбщемНазванииЕдиницу() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ИзСтруктур", 0);
	Результат.Вставить("ИзНоменклатуры", 0);
	Результат.Вставить("ИзЕдинственнойПривязки", 0);
	Результат.Вставить("НичьихКонфликтов", 0);
	Результат.Вставить("ОсталосьПустых", 0);
	Результат.Вставить("СписокКонфликтов", Новый Массив);
	Результат.Вставить("СписокПустых", Новый Массив);
	Результат.Вставить("Ошибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");

	НачатьТранзакцию();
	Попытка
		ЗаполнитьИзСтруктур(Результат);
		ЗаполнитьИзЗакупаемойНоменклатуры(Результат);
		ЗаполнитьИзЕдинственнойПривязки(Результат);
		СобратьОставшиесяПустыми(Результат);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("ОбновлениеЕдиницыОбщегоНазвания.Ошибка",
			УровеньЖурналаРегистрации.Ошибка, , , Результат.ТекстОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьЕдиницу(КарточкаСсылка, Единица)
	КарточкаОбъект = КарточкаСсылка.ПолучитьОбъект();
	КарточкаОбъект.Единица = Единица;
	КарточкаОбъект.Записать();
КонецПроцедуры

// П1: мода единиц по строкам ТЧ активных структур; ничья голосов - пропуск.
Процедура ЗаполнитьИзСтруктур(Результат)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.ОбщееНазвание КАК ОбщееНазвание,
	|	К.Единица КАК Единица,
	|	КОЛИЧЕСТВО(*) КАК Голосов
	|ИЗ
	|	Справочник.СтруктураСебестоимости.Комплектующие КАК К
	|ГДЕ
	|	К.Ссылка.Активная
	|	И К.ОбщееНазвание <> ЗНАЧЕНИЕ(Справочник.ОбщиеНазванияНоменклатуры.ПустаяСсылка)
	|	И К.ОбщееНазвание.Единица = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|	И К.Единица <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	К.ОбщееНазвание, К.Единица
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбщееНазвание, Голосов УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();

	ТекущаяСсылка = Неопределено;
	МодаЕдиница = Неопределено;
	МодаГолосов = 0;
	Ничья = Ложь;
	Расклад = "";

	Пока Выборка.Следующий() Цикл
		Если Выборка.ОбщееНазвание <> ТекущаяСсылка Тогда
			ЗаписатьВыборП1(ТекущаяСсылка, МодаЕдиница, Ничья, Расклад, Результат);
			ТекущаяСсылка = Выборка.ОбщееНазвание;
			МодаЕдиница = Выборка.Единица;
			МодаГолосов = Выборка.Голосов;
			Ничья = Ложь;
			Расклад = "" + Выборка.Единица + " (" + Выборка.Голосов + ")";
		Иначе
			Если Выборка.Голосов = МодаГолосов Тогда
				Ничья = Истина;
			КонецЕсли;
			Расклад = Расклад + ", " + Выборка.Единица + " (" + Выборка.Голосов + ")";
		КонецЕсли;
	КонецЦикла;
	ЗаписатьВыборП1(ТекущаяСсылка, МодаЕдиница, Ничья, Расклад, Результат);

КонецПроцедуры

Процедура ЗаписатьВыборП1(КарточкаСсылка, Единица, Ничья, Расклад, Результат)
	Если КарточкаСсылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Ничья Тогда
		Результат.НичьихКонфликтов = Результат.НичьихКонфликтов + 1;
		Результат.СписокКонфликтов.Добавить("НИЧЬЯ (пропущено): " + КарточкаСсылка + " — " + Расклад);
		Возврат;
	КонецЕсли;
	Если Найти(Расклад, ",") > 0 Тогда
		Результат.СписокКонфликтов.Добавить("Выбрана мода: " + КарточкаСсылка + " → " + Единица + " — " + Расклад);
	КонецЕсли;
	ЗаписатьЕдиницу(КарточкаСсылка, Единица);
	Результат.ИзСтруктур = Результат.ИзСтруктур + 1;
КонецПроцедуры

// П2: базовая единица самой закупаемой привязанной номенклатуры.
// Выполняется ПОСЛЕ записей П1 в той же транзакции - отбор по пустой Единице
// сам исключает уже заполненные карточки.
Процедура ЗаполнитьИзЗакупаемойНоменклатуры(Результат)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Номенклатура.ОбщееНазваниеНоменклатуры КАК ОбщееНазвание,
	|	Т.Номенклатура.БазоваяЕдиницаИзмерения КАК Единица,
	|	СУММА(Т.Количество) КАК Куплено,
	|	СУММА(Т.Сумма) КАК СуммаЗакупок
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Проведен
	|	И Т.Номенклатура.ОбщееНазваниеНоменклатуры <> ЗНАЧЕНИЕ(Справочник.ОбщиеНазванияНоменклатуры.ПустаяСсылка)
	|	И Т.Номенклатура.ОбщееНазваниеНоменклатуры.Единица = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|	И Т.Номенклатура.БазоваяЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Номенклатура.ОбщееНазваниеНоменклатуры, Т.Номенклатура, Т.Номенклатура.БазоваяЕдиницаИзмерения
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбщееНазвание, Куплено УБЫВ, СуммаЗакупок УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();

	ТекущаяСсылка = Неопределено;
	Пока Выборка.Следующий() Цикл
		Если Выборка.ОбщееНазвание <> ТекущаяСсылка Тогда
			ТекущаяСсылка = Выборка.ОбщееНазвание;
			ЗаписатьЕдиницу(ТекущаяСсылка, Выборка.Единица);
			Результат.ИзНоменклатуры = Результат.ИзНоменклатуры + 1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// П2б: карточки без закупок - если привязана РОВНО ОДНА номенклатура с базовой единицей.
// Выполняется ПОСЛЕ П1 и П2 (отбор по пустой Единице исключает заполненные).
Процедура ЗаполнитьИзЕдинственнойПривязки(Результат)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.ОбщееНазваниеНоменклатуры КАК ОбщееНазвание,
	|	Н.БазоваяЕдиницаИзмерения КАК Единица,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Н.Ссылка) КАК КолНоменклатур
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|	И Н.ОбщееНазваниеНоменклатуры <> ЗНАЧЕНИЕ(Справочник.ОбщиеНазванияНоменклатуры.ПустаяСсылка)
	|	И Н.ОбщееНазваниеНоменклатуры.Единица = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|	И Н.БазоваяЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	Н.ОбщееНазваниеНоменклатуры, Н.БазоваяЕдиницаИзмерения
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбщееНазвание";
	Таблица = Запрос.Выполнить().Выгрузить();

	// на карточку: суммарное число привязанных номенклатур и единица первой строки
	Сводка = Новый Соответствие;
	Для Каждого СтрокаТаб Из Таблица Цикл
		Данные = Сводка.Получить(СтрокаТаб.ОбщееНазвание);
		Если Данные = Неопределено Тогда
			Данные = Новый Структура("Всего, Единица", 0, СтрокаТаб.Единица);
			Сводка.Вставить(СтрокаТаб.ОбщееНазвание, Данные);
		КонецЕсли;
		Данные.Всего = Данные.Всего + СтрокаТаб.КолНоменклатур;
	КонецЦикла;

	Для Каждого КлючЗначение Из Сводка Цикл
		Если КлючЗначение.Значение.Всего = 1 Тогда
			ЗаписатьЕдиницу(КлючЗначение.Ключ, КлючЗначение.Значение.Единица);
			Результат.ИзЕдинственнойПривязки = Результат.ИзЕдинственнойПривязки + 1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СобратьОставшиесяПустыми(Результат)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОН.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ОбщиеНазванияНоменклатуры КАК ОН
	|ГДЕ
	|	НЕ ОН.ЭтоГруппа
	|	И ОН.Единица = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.ОсталосьПустых = Результат.ОсталосьПустых + 1;
		Результат.СписокПустых.Добавить("" + Выборка.Наименование);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
