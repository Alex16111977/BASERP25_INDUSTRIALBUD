#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Ответственный = Пользователи.ТекущийПользователь();

	Организация = ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Организация);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	ВнеоборотныеАктивы.ПроверитьСоответствиеДатыВерсииУчета(ЭтотОбъект, Ложь, Отказ);

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);

	ПроведениеДокументов.ПередЗаписьюДокумента(ЭтотОбъект, РежимЗаписи, РежимПроведения);

	Если НачисленнаяАмортизация.Количество() <> 0 Тогда
		НачисленнаяАмортизация.Очистить();
	КонецЕсли;

	Если ДоначислениеВНУ И РежимЗаписи = РежимЗаписиДокумента.Проведение И УчетнаяПолитика.ПлательщикНалогаНаПрибыль(Организация, Дата) Тогда
		ТекстОшибки = НСтр("ru='Доначисление Амортизации ОС в НУ для организации плательщика налога на прибыль не требуется';uk='Донарахування Амортизації ОЗ у ПО для організації платника податку на прибуток не потрібно'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,,, Отказ);
	КонецЕсли;

	ТекстОшибки = НСтр("ru='Требуются настройки отражения %1 по амортизации в регламентированном учете';uk='Потрібні настройки відображення %1 по амортизації в регламентованому обліку'");
	ТекстОшибки = СтрШаблон(ТекстОшибки, НСтр("ru='расходов';uk='витрат'"));

	Если РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Не ДополнительныеСвойства.Свойство("ВыполненаПроверкаНастроекОтражения")
//		И (ВнеоборотныеАктивыЛокализация.ЕстьОшибкиЗаполненияРасходовПоАмортизацииОС(Организация, КонецМесяца(Дата))
		И ВнеоборотныеАктивыЛокализация.ЕстьОшибкиЗаполненияРасходовПоАмортизацииОС(Организация, КонецМесяца(Дата)) Тогда

		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,, "ДекорацияОшибка", Отказ);

	КонецЕсли;

	УчетОСВызовСервера.ПроверитьСпособыОтраженияРасходовНаПрочиеАктивы(ЭтотОбъект, Отказ);

	Если Не Отказ И РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		РассчитатьАмортизацию(Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ПроведениеДокументов.ПриЗаписиДокумента(ЭтотОбъект, Отказ);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	ПроведениеДокументов.ОчиститьДвиженияДокумента(ЭтотОбъект, "Хозрасчетный");

	Документы.АмортизацияОС.ПроверитьБлокировкуВходящихДанныхПриОбновленииИБ(
		НСтр("ru='Амортизация и износ основных средств';uk='Амортизація та знос основних засобів'"));

	ДопПараметры = ПроведениеДокументов.ДопПараметрыИнициализироватьДанныеДокументаДляПроведения();
	ДопПараметры.ДополнительныеСвойства = ДополнительныеСвойства;

	ПроведениеДокументов.ОбработкаПроведенияДокумента(ЭтотОбъект, Отказ, ДопПараметры);

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Результат = РеглУчетПроведениеСервер.ОтразитьДокумент(
		Новый Структура("Ссылка, Дата, Организация", Ссылка, Дата),,
		МенеджерВременныхТаблицНачисленнойАмортизации());

	Если Результат <> Перечисления.СтатусыОтраженияДокументовВРеглУчете.ОтраженоВРеглУчете Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	СформироватьЗаданияКЗакрытиюМесяца();

	// {А_Доработка} Аналитика ОС в ПрочиеРасходы заполняется через УчетОСВызовСервера (рядки 5039, 5110).
	// 1. Списати залишки ПрочиеРасходы по статтях ВНА
	// 2. Створити РАСХОД в ПрочиеАктивыПассивы (читає аналітику з ПрочиеРасходы)
	А_СформироватьРасходПрочиеРасходыВНА();
	// {А_Доработка v2 2026-05-25} НДС-корректная амортизация для управ.учёта.
	// Заменяет А_СформироватьДвиженияАктивовПассивов (старая оставлена в коде для отката).
	// Решает 3 проблемы: задвоение Дт «Расходы», скрытый остаток НДС на ОС, неправильный PnL.
	КартаУправАморт = А_ПолучитьУправАмортизациюПоОС();
	А_СкорректироватьПрочиеРасходыНаНДС(КартаУправАморт);
	А_СформироватьСимметричнуюАмортизациюВПАП(КартаУправАморт);

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	ПроведениеДокументов.ОбработкаУдаленияПроведенияДокумента(ЭтотОбъект, Отказ);

	СформироватьЗаданияКЗакрытиюМесяца();
	СформироватьЗаданиеАмортизацияОСПриОтменеПроведения();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МенеджерВременныхТаблицНачисленнойАмортизации()

	ВременныеТаблицы = Новый МенеджерВременныхТаблиц;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ВременныеТаблицы;
	Запрос.УстановитьПараметр("ТаблицаАмортизации", ДополнительныеСвойства.НачисленнаяАмортизация);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(&Организация КАК Справочник.Организации) КАК Организация,
	|	ВЫРАЗИТЬ(ТаблицаАмортизации.ОбъектУчета КАК Справочник.ОбъектыЭксплуатации) КАК ОбъектУчета,
	|	ВЫРАЗИТЬ(ТаблицаАмортизации.Подразделение КАК Справочник.СтруктураПредприятия) КАК Подразделение,
	|	ВЫРАЗИТЬ(ТаблицаАмортизации.НаправлениеДеятельности КАК Справочник.НаправленияДеятельности) КАК НаправлениеДеятельности,
	|	ВЫРАЗИТЬ(ТаблицаАмортизации.СуммаБУ КАК ЧИСЛО) КАК СуммаБУ,
	|	ВЫРАЗИТЬ(ТаблицаАмортизации.СуммаНУ КАК ЧИСЛО) КАК СуммаНУ,
	|	ВЫРАЗИТЬ(ТаблицаАмортизации.СуммаУменьшенияДооценки КАК ЧИСЛО) КАК СуммаУменьшенияДооценки,
	|	ВЫРАЗИТЬ(ТаблицаАмортизации.Коэффициент КАК ЧИСЛО) КАК Коэффициент,
	|	ВЫРАЗИТЬ(ТаблицаАмортизации.СтатьяРасходов КАК ПланВидовХарактеристик.СтатьиРасходов) КАК СтатьяРасходов,
	|	ТаблицаАмортизации.ОбъектУчета КАК АналитикаРасходов,
	|	ВЫРАЗИТЬ(ТаблицаАмортизации.НалоговоеНазначение КАК Справочник.НалоговыеНазначенияАктивовИЗатрат) КАК НалоговоеНазначение
	|ПОМЕСТИТЬ втТаблицаАмортизации
	|ИЗ
	|	&ТаблицаАмортизации КАК ТаблицаАмортизации";

	Запрос.Выполнить();

	Возврат ВременныеТаблицы;

КонецФункции

Процедура РассчитатьАмортизацию(Отказ)

	ДобавитьПараметрыРасчета = ДополнительныеСвойства.Свойство("ДобавитьПараметрыРасчета");

	Если ДобавитьПараметрыРасчета Тогда
		ТаблицаПараметровРасчетаАмортизации = УчетОСВызовСервера.ПустаяТаблицаПараметровРасчетаАмортизации();
	Иначе
		ТаблицаПараметровРасчетаАмортизации = Неопределено;
	КонецЕсли;

	ТаблицаНачисленнаяАмортизация = УчетОСВызовСервера.НачисленнаяАмортизация(
		Неопределено,
		ТаблицаРеквизитовДокумента(),
		ТаблицаПараметровРасчетаАмортизации,
		Отказ);

	ДополнительныеСвойства.Вставить("НачисленнаяАмортизация", ТаблицаНачисленнаяАмортизация);

	Если ДобавитьПараметрыРасчета Тогда
		ДополнительныеСвойства.Вставить("ПараметрыАмортизации", ТаблицаПараметровРасчетаАмортизации);
	КонецЕсли;

КонецПроцедуры

Функция ТаблицаРеквизитовДокумента()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	&Ссылка КАК Регистратор,
		|	&Дата КАК Период,
		|	КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ) КАК ДатаРасчета,
		|	&Номер КАК Номер,
		|	&Организация КАК Организация,
		|	&ДоначислениеВНУ КАК ДоначислениеВНУ,
		|	"""" КАК ИмяСписка,
		|	ИСТИНА КАК ВыдаватьСообщения");

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДоначислениеВНУ", ДоначислениеВНУ);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура СформироватьЗаданиеАмортизацияОСПриОтменеПроведения()

	Если РегистрыСведений.ЗаданияКРасчетуАмортизацииОС.ТребуетсяРасчет(Организация, НачалоМесяца(Дата)) Тогда
		РегистрыСведений.ЗаданияКРасчетуАмортизацииОС.СоздатьЗаписьРегистра(НачалоМесяца(Дата), Ссылка, Организация, 0);
	КонецЕсли;

КонецПроцедуры

Процедура СформироватьЗаданияКЗакрытиюМесяца()

	Возврат;

КонецПроцедуры

// {А_Доработка} Списание остатков ПрочиеРасходы по статьям ВНА (формирование стоимости необоротных активов).
// Обнуляет остаток ПрочиеРасходы по статьям с ТипРасходов = ФормированиеСтоимостиВНА
// путем создания РАСХОД записей, равных текущему остатку.
Процедура А_СформироватьРасходПрочиеРасходыВНА()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Организация КАК Организация,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Остатки.НалоговоеНазначение КАК НалоговоеНазначение,
	|	Остатки.СтатьяРасходов КАК СтатьяРасходов,
	|	Остатки.АналитикаРасходов КАК АналитикаРасходов,
	|	Остатки.СуммаОстаток КАК Сумма,
	|	Остатки.СуммаБезНДСОстаток КАК СуммаБезНДС,
	|	Остатки.СуммаРеглОстаток КАК СуммаРегл,
	|	Остатки.СуммаРеглБезНДСОстаток КАК СуммаРеглБезНДС,
	|	Остатки.НДСРеглОстаток КАК НДСРегл,
	|	Остатки.СуммаУпрОстаток КАК СуммаУпр,
	|	Остатки.СуммаУпрБезНДСОстаток КАК СуммаУпрБезНДС
	|ИЗ
	|	РегистрНакопления.ПрочиеРасходы.Остатки(
	|		&МоментВремени,
	|		Организация = &Организация
	|		И СтатьяРасходов.ТипРасходов = ЗНАЧЕНИЕ(Перечисление.ТипыРасходов.ФормированиеСтоимостиВНА)
	|		И СтатьяРасходов.ВариантРаспределенияРасходовРегл = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|	) КАК Остатки
	|ГДЕ
	|	Остатки.СуммаОстаток > 0";

	Запрос.УстановитьПараметр("МоментВремени",
		Новый Граница(КонецМесяца(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", Организация);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей = РегистрыНакопления.ПрочиеРасходы.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Ссылка);
	НаборЗаписей.Прочитать();

	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = НаборЗаписей.Добавить();
		Запись.ВидДвижения = ВидДвиженияНакопления.Расход;
		Запись.Период = КонецМесяца(Дата);
		Запись.Организация = Выборка.Организация;
		Запись.Подразделение = Выборка.Подразделение;
		Запись.НаправлениеДеятельности = Выборка.НаправлениеДеятельности;
		Запись.НалоговоеНазначение = Выборка.НалоговоеНазначение;
		Запись.СтатьяРасходов = Выборка.СтатьяРасходов;
		Запись.АналитикаРасходов = Выборка.АналитикаРасходов;
		Запись.Сумма = Выборка.Сумма;
		Запись.СуммаБезНДС = Выборка.СуммаБезНДС;
		Запись.СуммаРегл = Выборка.СуммаРегл;
		Запись.СуммаРеглБезНДС = Выборка.СуммаРеглБезНДС;
		Запись.НДСРегл = Выборка.НДСРегл;
		Запись.СуммаУпр = Выборка.СуммаУпр;
		Запись.СуммаУпрБезНДС = Выборка.СуммаУпрБезНДС;
	КонецЦикла;

	НаборЗаписей.Записать(Истина);

КонецПроцедуры

// {А_Доработка} Формирование движений ПрочиеАктивыПассивы (Статья = ОсновныеСредства) для амортизации.
// Создает РАСХОД записи на сумму начисленной амортизации (СуммаРегл из ПрочиеРасходы).
// ВАЖНО: Пишем в Движения.ПрочиеАктивыПассивы (коллекцию документа), а НЕ во внешний НаборЗаписей!
// Иначе платформа затрет наши записи при завершении ОбработкаПроведения (т.к. регистр в RegisterRecords).
Процедура А_СформироватьДвиженияАктивовПассивов()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПР.Период КАК Период,
	|	ПР.Организация КАК Организация,
	|	ПР.Подразделение КАК Подразделение,
	|	ПР.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ПР.АналитикаРасходов КАК Аналитика,
	|	СУММА(ПР.СуммаРегл) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ПрочиеРасходы КАК ПР
	|ГДЕ
	|	ПР.Регистратор = &Регистратор
	|	И ПР.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И ПР.СуммаРегл > 0
	|СГРУППИРОВАТЬ ПО
	|	ПР.Период, ПР.Организация, ПР.Подразделение,
	|	ПР.НаправлениеДеятельности, ПР.АналитикаРасходов";

	Запрос.УстановитьПараметр("Регистратор", Ссылка);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		// При первом проведении СуммаРегл = 0 — движения создаст обработка ДвиженияАктивовПассивов после закрытия месяца
		Движения.ПрочиеАктивыПассивы.Записывать = Ложь;
		Возврат;
	КонецЕсли;

	СтатьяОС = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ОсновныеСредства;

	// Пишем в коллекцию движений документа — платформа запишет их вместе со стандартными
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Движения.ПрочиеАктивыПассивы.Добавить();
		Запись.ВидДвижения = ВидДвиженияНакопления.Расход;
		Запись.Период = Выборка.Период;
		Запись.Организация = Выборка.Организация;
		Запись.Подразделение = Выборка.Подразделение;
		Запись.НаправлениеДеятельности = Выборка.НаправлениеДеятельности;
		Запись.Статья = СтатьяОС;
		Запись.Аналитика = Выборка.Аналитика;
		Запись.Сумма = Выборка.Сумма;
	КонецЦикла;

	Движения.ПрочиеАктивыПассивы.Записывать = Истина;

КонецПроцедуры

// ============================================================================
// {А_Доработка v2 2026-05-25} НДС-корректная амортизация (Вариант B v2)
// ----------------------------------------------------------------------------
// Решает 3 проблемы НДС в управ.учёте АмортизацияОС (2.1):
//   1) Видимое Δ в Контроле управ.баланса (задвоение Дт «Расходы» от БОБА+УПР строк)
//   2) Скрытый остаток на статье «Основные средства» (= 20% НДС после полной амортизации)
//   3) Неправильная амортизация в PnL (А_ФинРез_PL читает Σ Сумма_Приход из РН.ПрочиеРасходы)
//
// Граница ответственности: меняем ТОЛЬКО управ.колонки (Сумма / СуммаУпр / СуммаУпрБезНДС)
// в РН.ПрочиеРасходы + полную перезапись РН.ПрочиеАктивыПассивы.
// СуммаРегл / СуммаРеглБезНДС / НДСРегл / РБ.Хозрасчетный — НЕ ТРОГАЕМ.
//
// Knowledge база: _Rarzrabotki/notebook/knowledge_НеоборотныеАктивы/
// ============================================================================

// Расчёт правильной управ.амортизации с НДС для каждого ОС, по которому
// этот документ начисляет амортизацию.
// Источник истины: остаток в РН.ПрочиеАктивыПассивы (с НДС из СписаниеТоваровПоТребованию
// или ПринятиеКУчетуОС). Делим на СПИ_БУ из РС.ПараметрыАмортизацииОСБУ.
// Запрос исключает свой регистратор → работает и для ОС оприходованных в этом же месяце.
Функция А_ПолучитьУправАмортизациюПоОС() Экспорт
	НачМес = НачалоМесяца(Дата);
	КонМес = КонецМесяца(Дата);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Р", Ссылка);
	Запрос.УстановитьПараметр("НачМес", НачМес);
	Запрос.УстановитьПараметр("КонМес", КонМес);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ПР.АналитикаРасходов КАК Справочник.ОбъектыЭксплуатации) КАК ОС,
	|	ПР.Подразделение, ПР.НаправлениеДеятельности
	|ПОМЕСТИТЬ втОС
	|ИЗ РегистрНакопления.ПрочиеРасходы КАК ПР
	|ГДЕ ПР.Регистратор = &Р
	|	И ПР.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И ВЫРАЗИТЬ(ПР.АналитикаРасходов КАК Справочник.ОбъектыЭксплуатации) <> ЗНАЧЕНИЕ(Справочник.ОбъектыЭксплуатации.ПустаяСсылка)
	|;
	|ВЫБРАТЬ
	|	втОС.ОС, втОС.Подразделение, втОС.НаправлениеДеятельности,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|		КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) И Т.Период <= &КонМес
	|			ТОГДА Т.Сумма
	|		КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) И Т.Период < &НачМес
	|			ТОГДА -Т.Сумма
	|		ИНАЧЕ 0
	|	КОНЕЦ), 0) КАК ДоступнаяСтоимость,
	|	ЕСТЬNULL(МАКСИМУМ(ПАрБУ.СрокПолезногоИспользованияБУ), 1) КАК СПИ
	|ИЗ втОС КАК втОС
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПрочиеАктивыПассивы КАК Т
	|		ПО Т.Аналитика = втОС.ОС
	|			И Т.Статья = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ОсновныеСредства)
	|			И Т.Регистратор <> &Р
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыАмортизацииОСБУ.СрезПоследних(&КонМес) КАК ПАрБУ
	|		ПО ПАрБУ.ОсновноеСредство = втОС.ОС
	|СГРУППИРОВАТЬ ПО втОС.ОС, втОС.Подразделение, втОС.НаправлениеДеятельности";

	Карта = Новый Соответствие;
	Выб = Запрос.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		СПИ = ?(Выб.СПИ < 1, 1, Выб.СПИ);
		Сумма = ?(СПИ <= 1, Выб.ДоступнаяСтоимость, Окр(Выб.ДоступнаяСтоимость / СПИ, 2));
		Если Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Карта.Вставить(Выб.ОС, Новый Структура("Сумма, Подразделение, НаправлениеДеятельности",
			Сумма, Выб.Подразделение, Выб.НаправлениеДеятельности));
	КонецЦикла;
	Возврат Карта;
КонецФункции

// Коррекция управ.сумм в РН.ПрочиеРасходы.
// Принцип:
//   - ОС с УПР строкой (СуммаРегл=0, СуммаУпр>0): обнуляем Сумма/СуммаУпр в БОБА строках.
//     УПР строка уже содержит правильную сумму с НДС.
//   - ОС без УПР строки: меняем Сумма/СуммаУпр в БОБА строке на правильную управ-сумму
//     (распределяется равномерно если несколько БОБА строк по этому ОС — например 4 единицы Платформы).
// СуммаРегл, СуммаРеглБезНДС, НДСРегл НЕ ТРОГАЕМ — бух/нал.учёт сохраняется.
Процедура А_СкорректироватьПрочиеРасходыНаНДС(КартаУправАморт) Экспорт
	НаборЗап = РегистрыНакопления.ПрочиеРасходы.СоздатьНаборЗаписей();
	НаборЗап.Отбор.Регистратор.Установить(Ссылка);
	НаборЗап.Прочитать();

	// 1) Группируем строки по ОС: есть ли УПР строка для каждой Аналитики
	ЕстьУПР_ПоОС = Новый Соответствие;
	Для Каждого Зап Из НаборЗап Цикл
		Если Зап.ВидДвижения <> ВидДвиженияНакопления.Приход
			ИЛИ НЕ ЗначениеЗаполнено(Зап.АналитикаРасходов) Тогда
			Продолжить;
		КонецЕсли;
		Если Зап.СуммаРегл = 0 И Зап.СуммаУпр > 0 Тогда
			ЕстьУПР_ПоОС.Вставить(Зап.АналитикаРасходов, Истина);
		КонецЕсли;
	КонецЦикла;

	// 2) Считаем количество БОБА-строк по каждой Аналитике (для распределения суммы)
	КолвоБОБА_ПоОС = Новый Соответствие;
	Для Каждого Зап Из НаборЗап Цикл
		Если Зап.ВидДвижения = ВидДвиженияНакопления.Приход
			И ЗначениеЗаполнено(Зап.АналитикаРасходов)
			И Зап.СуммаРегл > 0 И Зап.СуммаУпр > 0 Тогда
			ОС = Зап.АналитикаРасходов;
			КолвоБОБА_ПоОС.Вставить(ОС, ?(КолвоБОБА_ПоОС[ОС] = Неопределено, 1, КолвоБОБА_ПоОС[ОС] + 1));
		КонецЕсли;
	КонецЦикла;

	// 3) Корректируем БОБА строки
	Для Каждого Зап Из НаборЗап Цикл
		Если Зап.ВидДвижения <> ВидДвиженияНакопления.Приход
			ИЛИ НЕ ЗначениеЗаполнено(Зап.АналитикаРасходов) Тогда
			Продолжить;
		КонецЕсли;
		ЭтоБОБА = (Зап.СуммаРегл > 0 И Зап.СуммаУпр > 0);
		Если НЕ ЭтоБОБА Тогда
			Продолжить;
		КонецЕсли;

		ОС = Зап.АналитикаРасходов;
		Если ЕстьУПР_ПоОС[ОС] = Истина Тогда
			// Есть УПР строка → обнуляем Сумма/СуммаУпр в БОБА (СуммаРегл оставляем!)
			Зап.Сумма = 0;
			Зап.СуммаУпр = 0;
			Зап.СуммаУпрБезНДС = 0;
		Иначе
			// Нет УПР строки → ставим правильную управ-сумму с НДС
			Инфо = КартаУправАморт.Получить(ОС);
			Если Инфо <> Неопределено Тогда
				КолвоСтр = КолвоБОБА_ПоОС[ОС];
				Если КолвоСтр > 0 Тогда
					ДоляПравильная = Окр(Инфо.Сумма / КолвоСтр, 2);
					Зап.Сумма = ДоляПравильная;
					Зап.СуммаУпр = ДоляПравильная;
					Зап.СуммаУпрБезНДС = 0;
					// Зап.СуммаРегл, СуммаРеглБезНДС, НДСРегл НЕ ТРОГАЕМ
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// {А_Доработка v3 2026-05-26} Защита от задвоения УПР строк при повторных перепроводах.
	// При повторном проведении документа штатная Обработка.ДвиженияАктивовПассывы может
	// ДОБАВИТЬ новую УПР строку (СуммаРегл=0, СуммаУпр>0) поверх существующей вместо замены.
	// Это даёт задвоение в РН.ПрочиеРасходы → завышение Σ Сумма_Приход → задвоение в А_ФинРез_PL.
	// Если для одной Аналитики (ОС) есть >1 УПР строки — оставляем первую (она содержит правильную
	// сумму с НДС), остальные обнуляем по управ-колонкам (становятся «пустыми» строками).
	// СуммаРегл / СуммаРеглБезНДС / НДСРегл НЕ ТРОГАЕМ — бух/нал.учёт сохраняется.
	УПР_Обработана_ПоОС = Новый Соответствие;
	Для Каждого Зап Из НаборЗап Цикл
		Если Зап.ВидДвижения <> ВидДвиженияНакопления.Приход
			ИЛИ НЕ ЗначениеЗаполнено(Зап.АналитикаРасходов) Тогда
			Продолжить;
		КонецЕсли;
		ЭтоУПР = (Зап.СуммаРегл = 0 И Зап.СуммаУпр > 0);
		Если НЕ ЭтоУПР Тогда
			Продолжить;
		КонецЕсли;

		ОС = Зап.АналитикаРасходов;
		Если УПР_Обработана_ПоОС[ОС] = Истина Тогда
			// Дубликат УПР строки — обнуляем управ-колонки
			Зап.Сумма = 0;
			Зап.СуммаУпр = 0;
			Зап.СуммаУпрБезНДС = 0;
		Иначе
			// Первая УПР строка для этого ОС — оставляем, помечаем обработанной
			УПР_Обработана_ПоОС.Вставить(ОС, Истина);
		КонецЕсли;
	КонецЦикла;

	НаборЗап.Записать(Истина);
КонецПроцедуры

// Полная замена А_СформироватьДвиженияАктивовПассивов.
// Очищает движения по этому регистратору и записывает симметричные пары
// Дт «Расходы текущего периода» / Кт «Основные средства» на правильную
// управ-сумму с НДС из Карта[ОС].Сумма (посчитанной функцией №1).
Процедура А_СформироватьСимметричнуюАмортизациюВПАП(КартаУправАморт) Экспорт
	КонецМесяцаДата = КонецМесяца(Дата);
	СтатьяОС    = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ОсновныеСредства;
	СтатьяРасх  = ПланыВидовХарактеристик.СтатьиАктивовПассивов.НайтиПоКоду("00000000014"); // «Расходы текущего периода»

	Движения.ПрочиеАктивыПассивы.Очистить();
	Движения.ПрочиеАктивыПассивы.Записывать = Истина;

	Для Каждого Эл Из КартаУправАморт Цикл
		ОС = Эл.Ключ;
		Инфо = Эл.Значение;

		// Дт «Расходы текущего периода» (Приход)
		ЗапДт = Движения.ПрочиеАктивыПассивы.Добавить();
		ЗапДт.ВидДвижения = ВидДвиженияНакопления.Приход;
		ЗапДт.Период = КонецМесяцаДата;
		ЗапДт.Организация = Организация;
		ЗапДт.Подразделение = Инфо.Подразделение;
		ЗапДт.НаправлениеДеятельности = Инфо.НаправлениеДеятельности;
		ЗапДт.Статья = СтатьяРасх;
		ЗапДт.Аналитика = Неопределено;
		ЗапДт.Сумма = Инфо.Сумма;

		// Кт «Основные средства» (Расход)
		ЗапКт = Движения.ПрочиеАктивыПассивы.Добавить();
		ЗапКт.ВидДвижения = ВидДвиженияНакопления.Расход;
		ЗапКт.Период = КонецМесяцаДата;
		ЗапКт.Организация = Организация;
		ЗапКт.Подразделение = Инфо.Подразделение;
		ЗапКт.НаправлениеДеятельности = Инфо.НаправлениеДеятельности;
		ЗапКт.Статья = СтатьяОС;
		ЗапКт.Аналитика = ОС;
		ЗапКт.Сумма = Инфо.Сумма;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#КонецЕсли
