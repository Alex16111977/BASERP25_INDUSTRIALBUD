		               |		СГРУППИРОВАТЬ ПО
		               |			СверкаВзаиморасчетов.Контрагент,
		               |			СверкаВзаиморасчетов.Договор) КАК ЗапросСверка
		               |		ПО ВложенныйЗапрос.Контрагент = ЗапросСверка.Контрагент
		               |			И ВложенныйЗапрос.Договор = ЗапросСверка.Договор
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВложенныйЗапрос.ВалютаВзаиморасчетов,
		               |	ВложенныйЗапрос.Договор,
		               |	ВложенныйЗапрос.Контрагент,
		               |	ЗапросСверка.ДокументСверки" ;
		
		
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
		Запрос.УстановитьПараметр("спОрганизацияДляОтчета",спОрганизаций);
		
		ТаблицаВзаиморасчеты_ЕРП= Запрос.Выполнить().Выгрузить();
		
		
		
		
		
		СтрокаПодключения1СУПП = "Srvr=""localhost"";Ref=""work"";Usr=""Оператор1С"";Pwd=""159""";
