#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	УстановитьПривилегированныйРежим(Истина);

	// =============================================
	// Отримання параметрів з СКД
	// =============================================
	ПоДням = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПоДням").Значение;

	ПараметрПериодОтчета = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Период").Значение;
	НачалоПериода = ПараметрПериодОтчета.ДатаНачала;
	КонецПериода = КонецДня(ПараметрПериодОтчета.ДатаОкончания);

	// =============================================
	// 1. ЗАЛИШКИ ERP (РасчетыСКлиентами + РасчетыСПоставщиками)
	// =============================================
	ТаблицаВзаиморасчеты_ЕРП = ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода, Ложь);

	ТаблицаВзаиморасчеты_ПоДнямЕРП = Новый ТаблицаЗначений;
	Если ПоДням Тогда
		ТаблицаВзаиморасчеты_ПоДнямЕРП = ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода, Истина);
	КонецЕсли;

	// =============================================
	// 2. ЗАЛИШКИ BUHBUD (COM + РегБух.Хозрасчетный)
	//    Рахунки: 361, 362, 631, 632, 6851, 6852, 3771, 3772 тощо
	//    ОНОВЛЕНО: Динамічне визначення позиції субконто через ВидыСубконто!
	// =============================================
	СтрокаПодключенияBuhBud = "Srvr=""SQLSERVER"";Ref=""BuhBud"";Usr=""1cAdmin"";Pwd=""""";
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияBuhBud));
	Исключение
		Сообщить("Помилка підключення до BuhBud: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ТаблицаВзаиморасчеты_BuhBud = ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода, Ложь);

	ТаблицаВзаиморасчеты_ПоДнямBuhBud = Новый ТаблицаЗначений;
	Если ПоДням Тогда
		ТаблицаВзаиморасчеты_ПоДнямBuhBud = ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода, Истина);
	КонецЕсли;

	// Звільнення COM-з'єднання
	V83 = Неопределено;
	V8 = Неопределено;

	// =============================================
	// 3. ПЕРЕДАЧА В СКД
	// =============================================
	ВнешниеНаборыДанных = Новый Структура(
		"Взаиморасчеты_ЕРП, Взаиморасчеты_BuhBud, Взаиморасчеты_ПоДнямЕРП, Взаиморасчеты_ПоДнямBuhBud",
		ТаблицаВзаиморасчеты_ЕРП,
		ТаблицаВзаиморасчеты_BuhBud,
		ТаблицаВзаиморасчеты_ПоДнямЕРП,
		ТаблицаВзаиморасчеты_ПоДнямBuhBud
	);

	// Формування звіту
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отримання залишків з ERP (РасчетыСКлиентами + РасчетыСПоставщиками)
// через РегістрСведений.АналитикаУчетаПоПартнерам
//
// Параметри:
//  НачалоПериода - Дата - початок періоду
//  КонецПериода - Дата - кінець періоду
//  ПоДням - Булево - якщо Істина, то розбивка по днях
//
// Повертає:
//  ТаблицяЗначень - таблиця з залишками
//
Функция ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода, ПоДням)

	Запрос = Новый Запрос;

	Если ПоДням Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РасчетыСКлиентамиОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток_ПоДнямЕРП,
		|	РасчетыСКлиентамиОстаткиИОбороты.СуммаПриход КАК СуммаПриход_ПоДнямЕРП,
		|	РасчетыСКлиентамиОстаткиИОбороты.СуммаРасход КАК СуммаРасход_ПоДнямЕРП,
		|	РасчетыСКлиентамиОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток_ПоДнямЕРП,
		|	РасчетыСКлиентамиОстаткиИОбороты.Период КАК ПериодДень,
		|	регАналитикаУчетаПоПартнерам.Контрагент КАК Контрагент,
		|	регАналитикаУчетаПоПартнерам.Договор КАК Договор,
		|	регАналитикаУчетаПоПартнерам.Договор.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов
		|ИЗ
		|	РегистрНакопления.РасчетыСКлиентами.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, День, , ) КАК РасчетыСКлиентамиОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК регАналитикаУчетаПоПартнерам
		|		ПО РасчетыСКлиентамиОстаткиИОбороты.АналитикаУчетаПоПартнерам = регАналитикаУчетаПоПартнерам.КлючАналитики
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РасчетыСПоставщикамиОстаткиИОбороты.СуммаНачальныйОстаток,
		|	РасчетыСПоставщикамиОстаткиИОбороты.СуммаПриход,
		|	РасчетыСПоставщикамиОстаткиИОбороты.СуммаРасход,
		|	РасчетыСПоставщикамиОстаткиИОбороты.СуммаКонечныйОстаток,
		|	РасчетыСПоставщикамиОстаткиИОбороты.Период,
		|	регАналитикаУчетаПоПартнерам.Контрагент,
		|	регАналитикаУчетаПоПартнерам.Договор,
		|	регАналитикаУчетаПоПартнерам.Договор.ВалютаВзаиморасчетов
		|ИЗ
		|	РегистрНакопления.РасчетыСПоставщиками.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, День, , ) КАК РасчетыСПоставщикамиОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК регАналитикаУчетаПоПартнерам
		|		ПО РасчетыСПоставщикамиОстаткиИОбороты.АналитикаУчетаПоПартнерам = регАналитикаУчетаПоПартнерам.КлючАналитики";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(ВложенныйЗапрос.СуммаНачальныйОстаток_ЕРП) КАК СуммаНачальныйОстаток_ЕРП,
		|	СУММА(ВложенныйЗапрос.СуммаПриход_ЕРП) КАК СуммаПриход_ЕРП,
		|	СУММА(ВложенныйЗапрос.СуммаРасход_ЕРП) КАК СуммаРасход_ЕРП,
		|	СУММА(ВложенныйЗапрос.СуммаКонечныйОстаток_ЕРП) КАК СуммаКонечныйОстаток_ЕРП,
		|	ВложенныйЗапрос.Контрагент КАК Контрагент,
		|	ВложенныйЗапрос.Договор КАК Договор,
		|	ВложенныйЗапрос.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов
		|ИЗ
		|	(ВЫБРАТЬ
		|		РасчетыСКлиентамиОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток_ЕРП,
		|		РасчетыСКлиентамиОстаткиИОбороты.СуммаПриход КАК СуммаПриход_ЕРП,
		|		РасчетыСКлиентамиОстаткиИОбороты.СуммаРасход КАК СуммаРасход_ЕРП,
		|		РасчетыСКлиентамиОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток_ЕРП,
		|		регАналитикаУчетаПоПартнерам.Контрагент КАК Контрагент,
		|		регАналитикаУчетаПоПартнерам.Договор КАК Договор,
		|		регАналитикаУчетаПоПартнерам.Договор.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов
		|	ИЗ
		|		РегистрНакопления.РасчетыСКлиентами.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ) КАК РасчетыСКлиентамиОстаткиИОбороты
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК регАналитикаУчетаПоПартнерам
		|			ПО РасчетыСКлиентамиОстаткиИОбороты.АналитикаУчетаПоПартнерам = регАналитикаУчетаПоПартнерам.КлючАналитики
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		РасчетыСПоставщикамиОстаткиИОбороты.СуммаНачальныйОстаток,
		|		РасчетыСПоставщикамиОстаткиИОбороты.СуммаПриход,
		|		РасчетыСПоставщикамиОстаткиИОбороты.СуммаРасход,
		|		РасчетыСПоставщикамиОстаткиИОбороты.СуммаКонечныйОстаток,
		|		регАналитикаУчетаПоПартнерам.Контрагент,
		|		регАналитикаУчетаПоПартнерам.Договор,
		|		регАналитикаУчетаПоПартнерам.Договор.ВалютаВзаиморасчетов
		|	ИЗ
		|		РегистрНакопления.РасчетыСПоставщиками.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ) КАК РасчетыСПоставщикамиОстаткиИОбороты
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК регАналитикаУчетаПоПартнерам
		|			ПО РасчетыСПоставщикамиОстаткиИОбороты.АналитикаУчетаПоПартнерам = регАналитикаУчетаПоПартнерам.КлючАналитики) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.ВалютаВзаиморасчетов,
		|	ВложенныйЗапрос.Договор,
		|	ВложенныйЗапрос.Контрагент";
	КонецЕсли;

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Отримання залишків з BuhBud через COM (РегістрБухгалтерії.Хозрасчетный)
// Рахунки: 361, 362, 631, 632, 6851, 6852, 3771, 3772, 601, 602, 684, 655
//
// ОНОВЛЕНО: Використовує динамічне визначення позиції субконто через
//           з'єднання з ПланСчетов.Хозрасчетный.ВидыСубконто!
//           Це дозволяє правильно працювати з рахунками де субконто
//           Контрагенты/ДоговорыКонтрагентов знаходяться на різних позиціях.
//
// Параметри:
//  V83 - COMОбъект - підключення до BuhBud
//  НачалоПериода - Дата - початок періоду
//  КонецПериода - Дата - кінець періоду
//  ПоДням - Булево - якщо Істина, то розбивка по днях
//
// Повертає:
//  ТаблицяЗначень - таблиця з залишками (з конвертованими посиланнями)
//
Функция ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода, ПоДням)

	ВалютаГривня = V83.Константы.ВалютаРегламентированногоУчета.Получить();

	// Масив рахунків для сверки взаєморозрахунків
	спСчет = V83.NewObject("Массив");
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСОтечественнымиПокупателями);           // 361
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСИностраннымиПокупателями);             // 362
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСОтечественнымиПоставщиками);           // 631
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСИностраннымиПоставщиками);             // 632
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСДругимиКредиторамиВНациональнойВалюте);// 6851
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСДругимиКредиторамиВИностраннойВалюте); // 6852
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСДругимиДебиторамиВНациональнойВалюте); // 3771
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыСДругимиДебиторамиВИностраннойВалюте);  // 3772
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.КраткосрочныеКредитыБанковВНациональнойВалюте);// 601
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.КраткосрочныеКредитыБанковВИностраннойВалюте); // 602
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыПоНачисленнымПроцентам);                // 684
	спСчет.Добавить(V83.ПланыСчетов.Хозрасчетный.РасчетыПоСтрахованиюИмущества);                // 655

	Запрос = V83.NewObject("Запрос");

	// =====================================================================
	// ЗАПИТ з динамічним визначенням позиції субконто!
	// Логіка: JOIN з ПланСчетов.Хозрасчетный.ВидыСубконто для визначення
	// на якій позиції (1, 2 або 3) знаходиться субконто Контрагенты та ДоговорыКонтрагентов
	// =====================================================================

	Если ПоДням Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.КонтрагентИдКод КАК КонтрагентИдКод,
		|	ВложенныйЗапрос.ДоговорИдКод КАК ДоговорИдКод,
		|	ВложенныйЗапрос.ВалютаВзаиморасчетовКод КАК ВалютаВзаиморасчетовКод,
		|	СУММА(ВложенныйЗапрос.СуммаНачальныйОстаток_ПоДнямBuhBud) КАК СуммаНачальныйОстаток_ПоДнямBuhBud,
		|	СУММА(ВложенныйЗапрос.СуммаПриход_ПоДнямBuhBud) КАК СуммаПриход_ПоДнямBuhBud,
		|	СУММА(ВложенныйЗапрос.СуммаРасход_ПоДнямBuhBud) КАК СуммаРасход_ПоДнямBuhBud,
		|	СУММА(ВложенныйЗапрос.СуммаКонечныйОстаток_ПоДнямBuhBud) КАК СуммаКонечныйОстаток_ПоДнямBuhBud,
		|	ВложенныйЗапрос.ПериодДень КАК ПериодДень
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВЫБОР
		|			КОГДА ПозицияКонтрагента.НомерСтроки = 1
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Контрагенты).А_ИдКод
		|			КОГДА ПозицияКонтрагента.НомерСтроки = 2
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Контрагенты).А_ИдКод
		|			КОГДА ПозицияКонтрагента.НомерСтроки = 3
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Контрагенты).А_ИдКод
		|			ИНАЧЕ """"
		|		КОНЕЦ КАК КонтрагентИдКод,
		|		ВЫБОР
		|			КОГДА ПозицияДоговора.НомерСтроки = 1
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
		|			КОГДА ПозицияДоговора.НомерСтроки = 3
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
		|			ИНАЧЕ """"
		|		КОНЕЦ КАК ДоговорИдКод,
		|		ВЫБОР
		|			КОГДА ПозицияДоговора.НомерСтроки = 1
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов.Код
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов.Код
		|			КОГДА ПозицияДоговора.НомерСтроки = 3
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов.Код
		|			ИНАЧЕ ""980""
		|		КОНЕЦ КАК ВалютаВзаиморасчетовКод,
		|		ВЫБОР
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов = &ВалютаГривня
		|				ТОГДА Остатки.СуммаНачальныйОстаток
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов <> &ВалютаГривня
		|				ТОГДА Остатки.ВалютнаяСуммаНачальныйОстаток
		|			ИНАЧЕ Остатки.СуммаНачальныйОстаток
		|		КОНЕЦ КАК СуммаНачальныйОстаток_ПоДнямBuhBud,
		|		ВЫБОР
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов = &ВалютаГривня
		|				ТОГДА Остатки.СуммаОборотДт
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов <> &ВалютаГривня
		|				ТОГДА Остатки.ВалютнаяСуммаОборотДт
		|			ИНАЧЕ Остатки.СуммаОборотДт
		|		КОНЕЦ КАК СуммаПриход_ПоДнямBuhBud,
		|		ВЫБОР
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов = &ВалютаГривня
		|				ТОГДА Остатки.СуммаОборотКт
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов <> &ВалютаГривня
		|				ТОГДА Остатки.ВалютнаяСуммаОборотКт
		|			ИНАЧЕ Остатки.СуммаОборотКт
		|		КОНЕЦ КАК СуммаРасход_ПоДнямBuhBud,
		|		ВЫБОР
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов = &ВалютаГривня
		|				ТОГДА Остатки.СуммаКонечныйОстаток
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов <> &ВалютаГривня
		|				ТОГДА Остатки.ВалютнаяСуммаКонечныйОстаток
		|			ИНАЧЕ Остатки.СуммаКонечныйОстаток
		|		КОНЕЦ КАК СуммаКонечныйОстаток_ПоДнямBuhBud,
		|		Остатки.Период КАК ПериодДень
		|	ИЗ
		|		РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		|				&НачалоПериода,
		|				&КонецПериода,
		|				День,
		|				ДвиженияИГраницыПериода,
		|				Счет В ИЕРАРХИИ (&Счет),
		|				,
		|				НЕ Организация.А_ЗапретИспользованияУправленческой) КАК Остатки
		|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозицияКонтрагента
		|			ПО Остатки.Счет = ПозицияКонтрагента.Ссылка
		|				И (ПозицияКонтрагента.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты))
		|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозицияДоговора
		|			ПО Остатки.Счет = ПозицияДоговора.Ссылка
		|				И (ПозицияДоговора.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ДоговорыКонтрагентов))) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.КонтрагентИдКод,
		|	ВложенныйЗапрос.ДоговорИдКод,
		|	ВложенныйЗапрос.ВалютаВзаиморасчетовКод,
		|	ВложенныйЗапрос.ПериодДень";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.КонтрагентИдКод КАК КонтрагентИдКод,
		|	ВложенныйЗапрос.ДоговорИдКод КАК ДоговорИдКод,
		|	ВложенныйЗапрос.ВалютаВзаиморасчетовКод КАК ВалютаВзаиморасчетовКод,
		|	СУММА(ВложенныйЗапрос.СуммаНачальныйОстаток_BuhBud) КАК СуммаНачальныйОстаток_BuhBud,
		|	СУММА(ВложенныйЗапрос.СуммаПриход_BuhBud) КАК СуммаПриход_BuhBud,
		|	СУММА(ВложенныйЗапрос.СуммаРасход_BuhBud) КАК СуммаРасход_BuhBud,
		|	СУММА(ВложенныйЗапрос.СуммаКонечныйОстаток_BuhBud) КАК СуммаКонечныйОстаток_BuhBud
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВЫБОР
		|			КОГДА ПозицияКонтрагента.НомерСтроки = 1
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Контрагенты).А_ИдКод
		|			КОГДА ПозицияКонтрагента.НомерСтроки = 2
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Контрагенты).А_ИдКод
		|			КОГДА ПозицияКонтрагента.НомерСтроки = 3
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Контрагенты).А_ИдКод
		|			ИНАЧЕ """"
		|		КОНЕЦ КАК КонтрагентИдКод,
		|		ВЫБОР
		|			КОГДА ПозицияДоговора.НомерСтроки = 1
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
		|			КОГДА ПозицияДоговора.НомерСтроки = 3
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.ДоговорыКонтрагентов).А_ИдКод
		|			ИНАЧЕ """"
		|		КОНЕЦ КАК ДоговорИдКод,
		|		ВЫБОР
		|			КОГДА ПозицияДоговора.НомерСтроки = 1
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов.Код
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов.Код
		|			КОГДА ПозицияДоговора.НомерСтроки = 3
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов.Код
		|			ИНАЧЕ ""980""
		|		КОНЕЦ КАК ВалютаВзаиморасчетовКод,
		|		ВЫБОР
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов = &ВалютаГривня
		|				ТОГДА Остатки.СуммаНачальныйОстаток
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов <> &ВалютаГривня
		|				ТОГДА Остатки.ВалютнаяСуммаНачальныйОстаток
		|			ИНАЧЕ Остатки.СуммаНачальныйОстаток
		|		КОНЕЦ КАК СуммаНачальныйОстаток_BuhBud,
		|		ВЫБОР
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов = &ВалютаГривня
		|				ТОГДА Остатки.СуммаОборотДт
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов <> &ВалютаГривня
		|				ТОГДА Остатки.ВалютнаяСуммаОборотДт
		|			ИНАЧЕ Остатки.СуммаОборотДт
		|		КОНЕЦ КАК СуммаПриход_BuhBud,
		|		ВЫБОР
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов = &ВалютаГривня
		|				ТОГДА Остатки.СуммаОборотКт
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов <> &ВалютаГривня
		|				ТОГДА Остатки.ВалютнаяСуммаОборотКт
		|			ИНАЧЕ Остатки.СуммаОборотКт
		|		КОНЕЦ КАК СуммаРасход_BuhBud,
		|		ВЫБОР
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов = &ВалютаГривня
		|				ТОГДА Остатки.СуммаКонечныйОстаток
		|			КОГДА ПозицияДоговора.НомерСтроки = 2
		|					И ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВалютаВзаиморасчетов <> &ВалютаГривня
		|				ТОГДА Остатки.ВалютнаяСуммаКонечныйОстаток
		|			ИНАЧЕ Остатки.СуммаКонечныйОстаток
		|		КОНЕЦ КАК СуммаКонечныйОстаток_BuhBud
		|	ИЗ
		|		РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		|				&НачалоПериода,
		|				&КонецПериода,
		|				Авто,
		|				ДвиженияИГраницыПериода,
		|				Счет В ИЕРАРХИИ (&Счет),
		|				,
		|				НЕ Организация.А_ЗапретИспользованияУправленческой) КАК Остатки
		|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозицияКонтрагента
		|			ПО Остатки.Счет = ПозицияКонтрагента.Ссылка
		|				И (ПозицияКонтрагента.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты))
		|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозицияДоговора
		|			ПО Остатки.Счет = ПозицияДоговора.Ссылка
		|				И (ПозицияДоговора.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ДоговорыКонтрагентов))) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.КонтрагентИдКод,
		|	ВложенныйЗапрос.ДоговорИдКод,
		|	ВложенныйЗапрос.ВалютаВзаиморасчетовКод";
	КонецЕсли;

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Счет", спСчет);
	Запрос.УстановитьПараметр("ВалютаГривня", ВалютаГривня);

	Попытка
		ТЗ = Запрос.Выполнить().Выгрузить();
	Исключение
		Сообщить("Помилка виконання запиту до BuhBud: " + ОписаниеОшибки());
		Возврат Новый ТаблицаЗначений;
	КонецПопытки;

	// Серіалізація та десеріалізація для передачі через COM
	стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗ);
	ТаблицаBuhBud = ЗначениеИзСтрокиВнутр(стр_ТЗ);

	// Конвертація посилань BuhBud -> ERP через запит з тимчасовою таблицею
	// (ефективніше ніж НайтиПоРеквизиту в циклі)
	Возврат КонвертироватьТЗ_BuhBud(ТаблицаBuhBud, ПоДням);

КонецФункции

// Конвертація таблиці залишків BuhBud -> ERP через запит з тимчасовою таблицею
// Пошук контрагента та договору по А_ИдКод
//
// Параметри:
//  ТаблицаBuhBud - ТаблицяЗначень - вхідна таблиця з полями КонтрагентИдКод, ДоговорИдКод, ВалютаВзаиморасчетовКод
//  ПоДням - Булево - якщо Істина, повертає дані з розбивкою по днях
//
// Повертає:
//  ТаблицяЗначень - таблиця з конвертованими посиланнями
//
Функция КонвертироватьТЗ_BuhBud(ТаблицаBuhBud, ПоДням)

	Запрос = Новый Запрос;

	Если ПоДням Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВнутренняяТаблица.КонтрагентИдКод,
		|	ВнутренняяТаблица.ДоговорИдКод,
		|	ВнутренняяТаблица.ВалютаВзаиморасчетовКод,
		|	ВнутренняяТаблица.СуммаНачальныйОстаток_ПоДнямBuhBud,
		|	ВнутренняяТаблица.СуммаПриход_ПоДнямBuhBud,
		|	ВнутренняяТаблица.СуммаРасход_ПоДнямBuhBud,
		|	ВнутренняяТаблица.СуммаКонечныйОстаток_ПоДнямBuhBud,
		|	ВнутренняяТаблица.ПериодДень
		|ПОМЕСТИТЬ ВнутренняяТаблица
		|ИЗ
		|	&ТЗ КАК ВнутренняяТаблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Контрагент,
		|	ДоговорыКонтрагентов.Ссылка КАК Договор,
		|	Валюты.Ссылка КАК ВалютаВзаиморасчетов,
		|	ВнутренняяТаблица.СуммаНачальныйОстаток_ПоДнямBuhBud,
		|	ВнутренняяТаблица.СуммаПриход_ПоДнямBuhBud,
		|	ВнутренняяТаблица.СуммаРасход_ПоДнямBuhBud,
		|	ВнутренняяТаблица.СуммаКонечныйОстаток_ПоДнямBuhBud,
		|	ВнутренняяТаблица.ПериодДень
		|ИЗ
		|	ВнутренняяТаблица КАК ВнутренняяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО ВнутренняяТаблица.КонтрагентИдКод = Контрагенты.А_ИдКод
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ПО ВнутренняяТаблица.ДоговорИдКод = ДоговорыКонтрагентов.А_ИдКод
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
		|		ПО ВнутренняяТаблица.ВалютаВзаиморасчетовКод = Валюты.Код";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВнутренняяТаблица.КонтрагентИдКод,
		|	ВнутренняяТаблица.ДоговорИдКод,
		|	ВнутренняяТаблица.ВалютаВзаиморасчетовКод,
		|	ВнутренняяТаблица.СуммаНачальныйОстаток_BuhBud,
		|	ВнутренняяТаблица.СуммаПриход_BuhBud,
		|	ВнутренняяТаблица.СуммаРасход_BuhBud,
		|	ВнутренняяТаблица.СуммаКонечныйОстаток_BuhBud
		|ПОМЕСТИТЬ ВнутренняяТаблица
		|ИЗ
		|	&ТЗ КАК ВнутренняяТаблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Контрагент,
		|	ДоговорыКонтрагентов.Ссылка КАК Договор,
		|	Валюты.Ссылка КАК ВалютаВзаиморасчетов,
		|	ВнутренняяТаблица.СуммаНачальныйОстаток_BuhBud,
		|	ВнутренняяТаблица.СуммаПриход_BuhBud,
		|	ВнутренняяТаблица.СуммаРасход_BuhBud,
		|	ВнутренняяТаблица.СуммаКонечныйОстаток_BuhBud
		|ИЗ
		|	ВнутренняяТаблица КАК ВнутренняяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО ВнутренняяТаблица.КонтрагентИдКод = Контрагенты.А_ИдКод
