#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	УстановитьПривилегированныйРежим(Истина);

	// Отримання параметрів з СКД
	ПоДням = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПоДням").Значение;
	ПоДокументам = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПоДокументам").Значение;
	ПараметрПериодОтчета = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Период").Значение;
	НачалоПериода = ПараметрПериодОтчета.ДатаНачала;
	КонецПериода = КонецДня(ПараметрПериодОтчета.ДатаОкончания);

	// =============================================
	// 1. ЗАЛИШКИ ERP (А_ДенежныеСредстваФинАгенты)
	// =============================================
	ОстаткиДС_ЕРП = ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода, Ложь);

	ОстаткиДС_ПоДнямЕРП = Новый ТаблицаЗначений;
	Если ПоДням Тогда
		ОстаткиДС_ПоДнямЕРП = ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода, Истина);
	КонецЕсли;

	// =============================================
	// 2. ОБОРОТИ ERP по напрямках діяльності
	// =============================================
	ОборотыДДС_ЕРП = ПолучитьОборотыЕРП(НачалоПериода, КонецПериода, Ложь);

	ОборотыДДС_ПоДнямЕРП = Новый ТаблицаЗначений;
	Если ПоДням Тогда
		ОборотыДДС_ПоДнямЕРП = ПолучитьОборотыЕРП(НачалоПериода, КонецПериода, Истина, ПоДокументам);
	КонецЕсли;

	// =============================================
	// 3. ПІДКЛЮЧЕННЯ ДО BuhKazn (COM)
	// =============================================
	СтрокаПодключенияKazna = "Srvr=""SQLSERVER"";Ref=""BuhKazn"";Usr=""cfo"";Pwd=""2442""";
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияKazna));
	Исключение
		Сообщить("Помилка підключення до BuhKazn: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	// =============================================
	// 4. ЗАЛИШКИ КАЗНА (ДенежныеСредстваФинАгенты)
	// =============================================
	ОстаткиДС_Казна = ПолучитьОстаткиКазна(V83, НачалоПериода, КонецПериода, Ложь);

	ОстаткиДС_ПоДнямКазна = Новый ТаблицаЗначений;
	Если ПоДням Тогда
		ОстаткиДС_ПоДнямКазна = ПолучитьОстаткиКазна(V83, НачалоПериода, КонецПериода, Истина);
	КонецЕсли;

	// =============================================
	// 5. ОБОРОТИ КАЗНА по напрямках
	// =============================================
	ОборотыДДС_Казна = ПолучитьОборотыКазна(V83, НачалоПериода, КонецПериода, Ложь);

	ОборотыДДС_ПоДнямКазна = Новый ТаблицаЗначений;
	Если ПоДням Тогда
		ОборотыДДС_ПоДнямКазна = ПолучитьОборотыКазна(V83, НачалоПериода, КонецПериода, Истина, ПоДокументам);
	КонецЕсли;

	// Звільнення COM-з'єднання
	V83 = Неопределено;
	V8 = Неопределено;

	// =============================================
	// 6. ПЕРЕДАЧА В СКД
	// =============================================
	ВнешниеНаборыДанных = Новый Структура(
		"ОстаткиДС_ЕРП, ОстаткиДС_Казна, ОстаткиДС_ПоДнямЕРП, ОстаткиДС_ПоДнямКазна, ОборотыДДС_ЕРП, ОборотыДДС_Казна, ОборотыДДС_ПоДнямЕРП, ОборотыДДС_ПоДнямКазна",
		ОстаткиДС_ЕРП,
		ОстаткиДС_Казна,
		ОстаткиДС_ПоДнямЕРП,
		ОстаткиДС_ПоДнямКазна,
		ОборотыДДС_ЕРП,
		ОборотыДДС_Казна,
		ОборотыДДС_ПоДнямЕРП,
		ОборотыДДС_ПоДнямКазна
	);

	// Формування звіту
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// =============================================================================
// ЗАЛИШКИ ERP (А_ДенежныеСредстваФинАгенты)
// =============================================================================

Функция ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода, ПоДням)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	ОписаниеТиповДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ФинАгент",
		Новый ОписаниеТипов("СправочникСсылка.А_ФинАгенты"));
	Результат.Колонки.Добавить("НаправлениеДеятельности",
		Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	Результат.Колонки.Добавить("ДокументПередачи",
		Новый ОписаниеТипов("ДокументСсылка.СписаниеБезналичныхДенежныхСредств"));

	Если ПоДням Тогда
		Результат.Колонки.Добавить("СуммаНачОст_ПоДнямЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаПриход_ПоДнямЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасход_ПоДнямЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаКонОст_ПоДнямЕРП", ТипЧисло);
		Результат.Колонки.Добавить("ПериодДень", ОписаниеТиповДата);
	Иначе
		Результат.Колонки.Добавить("СуммаНачОст_ЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаПриход_ЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасход_ЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаКонОст_ЕРП", ТипЧисло);
	КонецЕсли;

	Запрос = Новый Запрос;
	Если ПоДням Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДС.ФинАгент КАК ФинАгент,
		|	ДС.НаправлениеДеятельности КАК НаправлениеДеятельности,
		|	ДС.ДокументПередачи КАК ДокументПередачи,
		|	ДС.СуммаНачальныйОстаток КАК СуммаНачОст_ПоДнямЕРП,
		|	ДС.СуммаПриход КАК СуммаПриход_ПоДнямЕРП,
		|	ДС.СуммаРасход КАК СуммаРасход_ПоДнямЕРП,
		|	ДС.СуммаКонечныйОстаток КАК СуммаКонОст_ПоДнямЕРП,
		|	ДС.Период КАК ПериодДень
		|ИЗ
		|	РегистрНакопления.А_ДенежныеСредстваФинАгенты.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, День, , ) КАК ДС";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДС.ФинАгент КАК ФинАгент,
		|	ДС.НаправлениеДеятельности КАК НаправлениеДеятельности,
		|	ДС.ДокументПередачи КАК ДокументПередачи,
		|	ДС.СуммаНачальныйОстаток КАК СуммаНачОст_ЕРП,
		|	ДС.СуммаПриход КАК СуммаПриход_ЕРП,
		|	ДС.СуммаРасход КАК СуммаРасход_ЕРП,
		|	ДС.СуммаКонечныйОстаток КАК СуммаКонОст_ЕРП
		|ИЗ
		|	РегистрНакопления.А_ДенежныеСредстваФинАгенты.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ) КАК ДС";
	КонецЕсли;

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НС = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Выборка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// =============================================================================
// ОБОРОТИ ERP по НаправлениеДеятельности + Подразделение
// =============================================================================

Функция ПолучитьОборотыЕРП(НачалоПериода, КонецПериода, ПоДням, ПоДокументам = Ложь)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	ОписаниеТиповДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ФинАгентОб",
		Новый ОписаниеТипов("СправочникСсылка.А_ФинАгенты"));
	Результат.Колонки.Добавить("НаправлениеДеятельностиОб",
		Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	Результат.Колонки.Добавить("Подразделение",
		Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));

	Если ПоДням И ПоДокументам Тогда
		Результат.Колонки.Добавить("Документ");
	КонецЕсли;

	Если ПоДням Тогда
		Результат.Колонки.Добавить("СуммаПриходОб_ПоДнямЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасходОб_ПоДнямЕРП", ТипЧисло);
		Результат.Колонки.Добавить("ПериодДеньОб", ОписаниеТиповДата);
	Иначе
		Результат.Колонки.Добавить("СуммаПриход_ЕРП_Обороты", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасход_ЕРП_Обороты", ТипЧисло);
	КонецЕсли;

	Запрос = Новый Запрос;

	Если ПоДням Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДвиженияДС.ФинАгент КАК ФинАгентОб,
		|	ДвиженияДС.НаправлениеДеятельности КАК НаправлениеДеятельностиОб,
		|	ДвиженияДС.Подразделение КАК Подразделение,
		|	НАЧАЛОПЕРИОДА(ДвиженияДС.Период, ДЕНЬ) КАК ПериодДеньОб,
		|	%ДокументВыборка%
		|	СУММА(ВЫБОР
		|			КОГДА ДвиженияДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|				ТОГДА ДвиженияДС.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаПриходОб_ПоДнямЕРП,
		|	СУММА(ВЫБОР
		|			КОГДА ДвиженияДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|				ТОГДА ДвиженияДС.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаРасходОб_ПоДнямЕРП
		|ИЗ
		|	РегистрНакопления.А_ДенежныеСредстваФинАгенты КАК ДвиженияДС
		|ГДЕ
		|	ДвиженияДС.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ДвиженияДС.Активность
		|СГРУППИРОВАТЬ ПО
		|	ДвиженияДС.ФинАгент,
		|	ДвиженияДС.НаправлениеДеятельности,
		|	ДвиженияДС.Подразделение,
		|	НАЧАЛОПЕРИОДА(ДвиженияДС.Период, ДЕНЬ)
		|	%ДокументГруппировка%";

		// Підстановка маркерів для документа
		Если ПоДокументам Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ДокументВыборка%",
				"ДвиженияДС.Регистратор КАК Документ,");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ДокументГруппировка%",
				", ДвиженияДС.Регистратор");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ДокументВыборка%", "");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ДокументГруппировка%", "");
		КонецЕсли;
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДвиженияДС.ФинАгент КАК ФинАгентОб,
		|	ДвиженияДС.НаправлениеДеятельности КАК НаправлениеДеятельностиОб,
		|	ДвиженияДС.Подразделение КАК Подразделение,
		|	СУММА(ВЫБОР
		|			КОГДА ДвиженияДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|				ТОГДА ДвиженияДС.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаПриход_ЕРП_Обороты,
		|	СУММА(ВЫБОР
		|			КОГДА ДвиженияДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|				ТОГДА ДвиженияДС.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаРасход_ЕРП_Обороты
		|ИЗ
		|	РегистрНакопления.А_ДенежныеСредстваФинАгенты КАК ДвиженияДС
		|ГДЕ
		|	ДвиженияДС.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ДвиженияДС.Активность
		|СГРУППИРОВАТЬ ПО
		|	ДвиженияДС.ФинАгент,
		|	ДвиженияДС.НаправлениеДеятельности,
		|	ДвиженияДС.Подразделение";
	КонецЕсли;

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НС = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Выборка);
	КонецЦикла;

	// Свернути результат
	Если ПоДням И ПоДокументам Тогда
		Результат.Свернуть("ФинАгентОб, НаправлениеДеятельностиОб, Подразделение, ПериодДеньОб, Документ", "СуммаПриходОб_ПоДнямЕРП, СуммаРасходОб_ПоДнямЕРП");
	ИначеЕсли ПоДням Тогда
		Результат.Свернуть("ФинАгентОб, НаправлениеДеятельностиОб, Подразделение, ПериодДеньОб", "СуммаПриходОб_ПоДнямЕРП, СуммаРасходОб_ПоДнямЕРП");
	Иначе
		Результат.Свернуть("ФинАгентОб, НаправлениеДеятельностиОб, Подразделение", "СуммаПриход_ЕРП_Обороты, СуммаРасход_ЕРП_Обороты");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// =============================================================================
// ЗАЛИШКИ КАЗНА (РегістрНакопичення.ДенежныеСредстваФинАгенты)
// =============================================================================

Функция ПолучитьОстаткиКазна(V83, НачалоПериода, КонецПериода, ПоДням)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	ОписаниеТиповДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ФинАгент",
		Новый ОписаниеТипов("СправочникСсылка.А_ФинАгенты"));
	Результат.Колонки.Добавить("НаправлениеДеятельности",
		Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	Результат.Колонки.Добавить("ДокументПередачи",
		Новый ОписаниеТипов("ДокументСсылка.СписаниеБезналичныхДенежныхСредств"));

	Если ПоДням Тогда
		Результат.Колонки.Добавить("СуммаНачОст_ПоДнямКазна", ТипЧисло);
		Результат.Колонки.Добавить("СуммаПриход_ПоДнямКазна", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасход_ПоДнямКазна", ТипЧисло);
		Результат.Колонки.Добавить("СуммаКонОст_ПоДнямКазна", ТипЧисло);
		Результат.Колонки.Добавить("ПериодДень", ОписаниеТиповДата);
	Иначе
		Результат.Колонки.Добавить("СуммаНачОст_Казна", ТипЧисло);
		Результат.Колонки.Добавить("СуммаПриход_Казна", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасход_Казна", ТипЧисло);
		Результат.Колонки.Добавить("СуммаКонОст_Казна", ТипЧисло);
	КонецЕсли;

	Результат.Колонки.Добавить("ФинАгентКазна", ОбщегоНазначения.ОписаниеТипаСтрока(150));

	Запрос = V83.NewObject("Запрос");

	Если ПоДням Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
|	ДС.ФинАгент КАК ФинАгент,
|	ДС.Направление КАК Направление,
|	ДС.ДокументПередачи КАК ДокументПередачи,
|	ДС.СуммаНачальныйОстаток КАК СуммаНачОст_ПоДнямКазна,
|	ДС.СуммаПриход КАК СуммаПриход_ПоДнямКазна,
|	ДС.СуммаРасход КАК СуммаРасход_ПоДнямКазна,
|	ДС.СуммаКонечныйОстаток КАК СуммаКонОст_ПоДнямКазна,
|	ДС.Период КАК ПериодДень
|ИЗ
|	РегистрНакопления.ДенежныеСредстваФинАгенты.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, День, , ) КАК ДС
|ГДЕ
|	(ДС.СуммаНачальныйОстаток <> 0
|		ИЛИ ДС.СуммаПриход <> 0
|		ИЛИ ДС.СуммаРасход <> 0
|		ИЛИ ДС.СуммаКонечныйОстаток <> 0)";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
|	ДС.ФинАгент КАК ФинАгент,
|	ДС.Направление КАК Направление,
|	ДС.ДокументПередачи КАК ДокументПередачи,
|	ДС.СуммаНачальныйОстаток КАК СуммаНачОст_Казна,
|	ДС.СуммаПриход КАК СуммаПриход_Казна,
|	ДС.СуммаРасход КАК СуммаРасход_Казна,
|	ДС.СуммаКонечныйОстаток КАК СуммаКонОст_Казна
|ИЗ
|	РегистрНакопления.ДенежныеСредстваФинАгенты.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ) КАК ДС
|ГДЕ
|	(ДС.СуммаНачальныйОстаток <> 0
|		ИЛИ ДС.СуммаПриход <> 0
|		ИЛИ ДС.СуммаРасход <> 0
|		ИЛИ ДС.СуммаКонечныйОстаток <> 0)";
	КонецЕсли;

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	ТЗ = Запрос.Выполнить().Выгрузить();

	// Конвертація посилань Казна -> ERP
	Для Каждого СтрокаТЗ Из ТЗ Цикл
		НС = Результат.Добавить();

		Если ПоДням Тогда
			НС.ПериодДень = СтрокаТЗ.ПериодДень;
			НС.СуммаНачОст_ПоДнямКазна = СтрокаТЗ.СуммаНачОст_ПоДнямКазна;
			НС.СуммаПриход_ПоДнямКазна = СтрокаТЗ.СуммаПриход_ПоДнямКазна;
			НС.СуммаРасход_ПоДнямКазна = СтрокаТЗ.СуммаРасход_ПоДнямКазна;
			НС.СуммаКонОст_ПоДнямКазна = СтрокаТЗ.СуммаКонОст_ПоДнямКазна;
		Иначе
			НС.СуммаНачОст_Казна = СтрокаТЗ.СуммаНачОст_Казна;
			НС.СуммаПриход_Казна = СтрокаТЗ.СуммаПриход_Казна;
			НС.СуммаРасход_Казна = СтрокаТЗ.СуммаРасход_Казна;
			НС.СуммаКонОст_Казна = СтрокаТЗ.СуммаКонОст_Казна;
		КонецЕсли;

		// Маппінг ФінАгент Казна -> ERP
		Попытка
			Если СтрокаТЗ.ФинАгент <> Неопределено Тогда
				НС.ФинАгентКазна = V83.String(СтрокаТЗ.ФинАгент);
				НС.ФинАгент = НайтиФинАгентВЕРП(V83, СтрокаТЗ.ФинАгент);
				Если НЕ ЗначениеЗаполнено(НС.ФинАгент) Тогда
					Сообщить("Не знайдено ФінАгент в ЕРП: " + НС.ФинАгентКазна);
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;

		// Маппінг Направление -> НаправлениеДеятельности (по Коду)
		Попытка
			Если СтрокаТЗ.Направление <> Неопределено Тогда
				КодНаправления = V83.String(СтрокаТЗ.Направление.Код);
				Если ЗначениеЗаполнено(КодНаправления) Тогда
					НС.НаправлениеДеятельности = Справочники.НаправленияДеятельности.НайтиПоКоду(СокрЛП(КодНаправления));
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;

		// ДокументПередачи -> маппінг по UUID (ПлатежноеПоручениеИсходящее -> СписаниеБезналичныхДенежныхСредств)
		Попытка
			Если V83.ЗначениеЗаполнено(СтрокаТЗ.ДокументПередачи) Тогда
				УИД = V83.XMLСтрока(СтрокаТЗ.ДокументПередачи.УникальныйИдентификатор());
				НС.ДокументПередачи = Документы.СписаниеБезналичныхДенежныхСредств.ПолучитьСсылку(
					Новый УникальныйИдентификатор(УИД));
			КонецЕсли;
		Исключение
			Сообщить("Помилка маппінгу ДокументПередачи Казна: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// =============================================================================
// ОБОРОТИ КАЗНА (РегістрНакопичення.ДенежныеСредстваФинАгенты)
// =============================================================================

Функция ПолучитьОборотыКазна(V83, НачалоПериода, КонецПериода, ПоДням, ПоДокументам = Ложь)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	ОписаниеТиповДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ФинАгентОб",
		Новый ОписаниеТипов("СправочникСсылка.А_ФинАгенты"));
	Результат.Колонки.Добавить("НаправлениеДеятельностиОб",
		Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	Результат.Колонки.Добавить("Подразделение",
		Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));

	Если ПоДням И ПоДокументам Тогда
		Результат.Колонки.Добавить("Документ");
	КонецЕсли;

	Если ПоДням Тогда
		Результат.Колонки.Добавить("СуммаПриходОб_ПоДнямКазна", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасходОб_ПоДнямКазна", ТипЧисло);
		Результат.Колонки.Добавить("ПериодДеньОб", ОписаниеТиповДата);
	Иначе
		Результат.Колонки.Добавить("СуммаПриход_Казна_Обороты", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасход_Казна_Обороты", ТипЧисло);
	КонецЕсли;

	Запрос = V83.NewObject("Запрос");

	Если ПоДням И ПоДокументам Тогда
		// RAW-запит з Регистратором
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Д.ФинАгент КАК ФинАгент,
		|	НАЧАЛОПЕРИОДА(Д.Период, ДЕНЬ) КАК ПериодДеньОб,
		|	Д.Направление КАК Направление,
		|	Д.Регистратор КАК РегистраторКазна,
		|	СУММА(ВЫБОР
		|			КОГДА Д.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|				ТОГДА Д.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаПриходОб_ПоДнямКазна,
		|	СУММА(ВЫБОР
		|			КОГДА Д.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|				ТОГДА Д.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаРасходОб_ПоДнямКазна
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваФинАгенты КАК Д
		|ГДЕ
		|	Д.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Д.Активность
		|СГРУППИРОВАТЬ ПО
		|	Д.ФинАгент,
		|	НАЧАЛОПЕРИОДА(Д.Период, ДЕНЬ),
		|	Д.Направление,
		|	Д.Регистратор";
	ИначеЕсли ПоДням Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Д.ФинАгент КАК ФинАгент,
		|	Д.Период КАК ПериодДеньОб,
		|	Д.Направление КАК Направление,
		|	Д.СуммаПриход КАК СуммаПриходОб_ПоДнямКазна,
		|	Д.СуммаРасход КАК СуммаРасходОб_ПоДнямКазна
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваФинАгенты.Обороты(&НачалоПериода, &КонецПериода, День, ) КАК Д";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Д.ФинАгент КАК ФинАгент,
		|	Д.Направление КАК Направление,
		|	Д.СуммаПриход КАК СуммаПриход_Казна_Обороты,
		|	Д.СуммаРасход КАК СуммаРасход_Казна_Обороты
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваФинАгенты.Обороты(&НачалоПериода, &КонецПериода, , ) КАК Д";
	КонецЕсли;

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	ТЗ = Запрос.Выполнить().Выгрузить();

	// Конвертація посилань Казна -> ERP
	Для Каждого СтрокаТЗ Из ТЗ Цикл
		НС = Результат.Добавить();

		Если ПоДням Тогда
			НС.ПериодДеньОб = СтрокаТЗ.ПериодДеньОб;
			НС.СуммаПриходОб_ПоДнямКазна = СтрокаТЗ.СуммаПриходОб_ПоДнямКазна;
			НС.СуммаРасходОб_ПоДнямКазна = СтрокаТЗ.СуммаРасходОб_ПоДнямКазна;
		Иначе
			НС.СуммаПриход_Казна_Обороты = СтрокаТЗ.СуммаПриход_Казна_Обороты;
			НС.СуммаРасход_Казна_Обороты = СтрокаТЗ.СуммаРасход_Казна_Обороты;
		КонецЕсли;

		// Маппінг ФінАгент Казна -> ERP
		Попытка
			Если СтрокаТЗ.ФинАгент <> Неопределено Тогда
				НС.ФинАгентОб = НайтиФинАгентВЕРП(V83, СтрокаТЗ.ФинАгент);
			КонецЕсли;
		Исключение
		КонецПопытки;

		// Маппінг Направление -> НаправлениеДеятельности
		Попытка
			Если СтрокаТЗ.Направление <> Неопределено Тогда
				НаправлениеДеятельности = Справочники.НаправленияДеятельности.ПустаяСсылка();

				КодНаправления = V83.String(СтрокаТЗ.Направление.Код);
				Если ЗначениеЗаполнено(КодНаправления) Тогда
					НаправлениеДеятельности = Справочники.НаправленияДеятельности.НайтиПоКоду(СокрЛП(КодНаправления));
				КонецЕсли;

				Если НЕ ЗначениеЗаполнено(НаправлениеДеятельности) Тогда
					НаименованиеНаправления = V83.String(СтрокаТЗ.Направление.Наименование);
					Если ЗначениеЗаполнено(НаименованиеНаправления) Тогда
						НаправлениеДеятельности = Справочники.НаправленияДеятельности.НайтиПоНаименованию(СокрЛП(НаименованиеНаправления));
					КонецЕсли;
				КонецЕсли;

				НС.НаправлениеДеятельностиОб = НаправлениеДеятельности;
			КонецЕсли;
		Исключение
		КонецПопытки;

		// Маппінг документа Казна → ERP (тільки коли ПоДокументам)
		Если ПоДням И ПоДокументам Тогда
			Попытка
				ДокументЗначение = Неопределено;
				Если СтрокаТЗ.РегистраторКазна <> Неопределено Тогда
					// 1. Отримати UUID документа Казна
					УИДКазна = V83.String(СтрокаТЗ.РегистраторКазна.УникальныйИдентификатор());

					// 2. Пошук в СоответствияОбъектовИнформационныхБаз
					ЗапросСоотв = Новый Запрос;
					ЗапросСоотв.Текст =
					"ВЫБРАТЬ ПЕРВЫЕ 1
					|	Соотв.УникальныйИдентификаторИсточника КАК ДокументERP
					|ИЗ
					|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
					|ГДЕ
					|	Соотв.УникальныйИдентификаторПриемника = &УИДКазна";
					ЗапросСоотв.УстановитьПараметр("УИДКазна", УИДКазна);
					РезСоотв = ЗапросСоотв.Выполнить();

					Если НЕ РезСоотв.Пустой() Тогда
						ВыбСоотв = РезСоотв.Выбрать();
						ВыбСоотв.Следующий();
						Если ЗначениеЗаполнено(ВыбСоотв.ДокументERP) Тогда
							ДокументЗначение = ВыбСоотв.ДокументERP;
						КонецЕсли;
					КонецЕсли;

					// 3. Fallback: текстове представлення документа Казна
					Если ДокументЗначение = Неопределено Тогда
						ТипДок = V83.String(СтрокаТЗ.РегистраторКазна.Метаданные().Имя);
						НомерДок = V83.String(СтрокаТЗ.РегистраторКазна.Номер);
						ДатаДок = СтрокаТЗ.РегистраторКазна.Дата;
						ДокументЗначение = СтрШаблон("%1 %2 від %3 (Казна)",
							ТипДок, СокрЛП(НомерДок), Формат(ДатаДок, "ДФ=dd.MM.yyyy"));
					КонецЕсли;
				КонецЕсли;
				НС.Документ = ДокументЗначение;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// =============================================================================
// Пошук ФінАгент в ЕРП по Коду/Наименованию з Казни
// =============================================================================

Функция НайтиФинАгентВЕРП(V83, ФинАгентКазна)

	// Спроба 1: по Коду
	Попытка
		КодФинАгента = V83.String(ФинАгентКазна.Код);
		Если ЗначениеЗаполнено(КодФинАгента) Тогда
			НайденнаяСсылка = Справочники.А_ФинАгенты.НайтиПоКоду(СокрЛП(КодФинАгента));
			Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
				Возврат НайденнаяСсылка;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Спроба 2: по Наименованию
	Попытка
		НаименованиеФинАгента = V83.String(ФинАгентКазна.Наименование);
		Если ЗначениеЗаполнено(НаименованиеФинАгента) Тогда
			НайденнаяСсылка = Справочники.А_ФинАгенты.НайтиПоНаименованию(СокрЛП(НаименованиеФинАгента));
			Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
				Возврат НайденнаяСсылка;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Справочники.А_ФинАгенты.ПустаяСсылка();

КонецФункции

#КонецОбласти

#КонецЕсли
