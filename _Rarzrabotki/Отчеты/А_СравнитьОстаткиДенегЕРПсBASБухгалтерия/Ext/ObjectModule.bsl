
// Звіт: Порівняння бухгалтерських залишків грошей ERP з BAS Бухгалтерія
// Джерело ERP: РегистрБухгалтерии.Хозрасчетный (рахунки 31х - ДенежныеСредстваВБанках)
// Джерело BuhBud: РегистрБухгалтерии.Хозрасчетный (рахунки 31х - ДенежныеСредстваВБанках) через COM
//

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;
    УстановитьПривилегированныйРежим(Истина);

    // Отримати параметри з СКД
    ПоДням = Ложь;
    Попытка
        ПараметрПоДням = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПоДням");
        Если ПараметрПоДням <> Неопределено Тогда
            ПоДням = ПараметрПоДням.Значение;
        КонецЕсли;
    Исключение
    КонецПопытки;

    ПараметрПериод = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Период").Значение;
    НачалоПериода = ПараметрПериод.ДатаНачала;
    КонецПериода = КонецДня(ПараметрПериод.ДатаОкончания);

    // =============================================
    // 1. ЗАЛИШКИ ERP (РегистрБухгалтерии.Хозрасчетный)
    // =============================================
    ТаблицаБезналичныеДС_ЕРП = ПолучитьОстаткиЕРП_Бух(НачалоПериода, КонецПериода, Ложь);
    ТаблицаБезналичныеДС_ПоДнямЕРП = Новый ТаблицаЗначений;
    Если ПоДням Тогда
        ТаблицаБезналичныеДС_ПоДнямЕРП = ПолучитьОстаткиЕРП_Бух(НачалоПериода, КонецПериода, Истина);
    КонецЕсли;

    // =============================================
    // 2. ЗАЛИШКИ BUHBUD (COM + РегБух.Хозрасчетный)
    // =============================================
    СтрокаПодключения = "Srvr=""SQLSERVER"";Ref=""BuhBud"";Usr=""1cAdmin"";Pwd=""""";
    V8 = Новый COMОбъект("V83.COMConnector");

    Попытка
        V83 = V8.Connect(СокрЛП(СтрокаПодключения));
    Исключение
        Сообщить("Помилка підключення до BuhBud: " + ОписаниеОшибки());

        // Повертаємо порожні таблиці для BuhBud
        ТаблицаБезналичныеДС_УПП = СоздатьПустуюТаблицуУПП(Ложь);
        ТаблицаБезналичныеДС_ПоДнямУПП = СоздатьПустуюТаблицуУПП(Истина);

        ВывестиОтчет(ДокументРезультат, ДанныеРасшифровки,
            ТаблицаБезналичныеДС_ЕРП, ТаблицаБезналичныеДС_УПП,
            ТаблицаБезналичныеДС_ПоДнямЕРП, ТаблицаБезналичныеДС_ПоДнямУПП);
        Возврат;
    КонецПопытки;

    ТаблицаБезналичныеДС_УПП = ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода, Ложь);
    ТаблицаБезналичныеДС_ПоДнямУПП = Новый ТаблицаЗначений;
    Если ПоДням Тогда
        ТаблицаБезналичныеДС_ПоДнямУПП = ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода, Истина);
    Иначе
        ТаблицаБезналичныеДС_ПоДнямУПП = СоздатьПустуюТаблицуУПП(Истина);
    КонецЕсли;

    // Звільнити COM
    V83 = Неопределено;
    V8 = Неопределено;

    // =============================================
    // 3. ПЕРЕДАТИ В СКД
    // =============================================
    ВывестиОтчет(ДокументРезультат, ДанныеРасшифровки,
        ТаблицаБезналичныеДС_ЕРП, ТаблицаБезналичныеДС_УПП,
        ТаблицаБезналичныеДС_ПоДнямЕРП, ТаблицаБезналичныеДС_ПоДнямУПП);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Виводить звіт через СКД
//
Процедура ВывестиОтчет(ДокументРезультат, ДанныеРасшифровки,
    ТаблицаБезналичныеДС_ЕРП, ТаблицаБезналичныеДС_УПП,
    ТаблицаБезналичныеДС_ПоДнямЕРП, ТаблицаБезналичныеДС_ПоДнямУПП)

    ВнешниеНаборыДанных = Новый Структура(
        "БезналичныеДС_ЕРП, БезналичныеДС_УПП, БезналичныеДС_ПоДнямЕРП, БезналичныеДС_ПоДнямУПП",
        ТаблицаБезналичныеДС_ЕРП,
        ТаблицаБезналичныеДС_УПП,
        ТаблицаБезналичныеДС_ПоДнямЕРП,
        ТаблицаБезналичныеДС_ПоДнямУПП
    );

    НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);

    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
    ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
    ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

// Отримує залишки з ERP РегистрБухгалтерии.Хозрасчетный (рахунки 31х)
//
// Параметри:
//   НачалоПериода - Дата
//   КонецПериода - Дата
//   ПоДням - Булево - чи групувати по днях
//
// Повертає:
//   ТаблицаЗначений
//
Функция ПолучитьОстаткиЕРП_Бух(НачалоПериода, КонецПериода, ПоДням)

    ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);

    Результат = Новый ТаблицаЗначений;
    Результат.Колонки.Добавить("БанковскийСчетКасса",
        Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчетаОрганизаций"));
    Результат.Колонки.Добавить("ТипДенежныхСредств",
        Новый ОписаниеТипов("ПеречислениеСсылка.ТипыДенежныхСредств"));
    Результат.Колонки.Добавить("СуммаНачальныйОстаток_ЕРП", ТипЧисло);
    Результат.Колонки.Добавить("СуммаПриход_ЕРП", ТипЧисло);
    Результат.Колонки.Добавить("СуммаРасход_ЕРП", ТипЧисло);
    Результат.Колонки.Добавить("СуммаКонечныйОстаток_ЕРП", ТипЧисло);

    Если ПоДням Тогда
        Результат.Колонки.Добавить("ПериодДень",
            Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
    КонецЕсли;

    Запрос = Новый Запрос;
    Если ПоДням Тогда
        Запрос.Текст =
        "ВЫБРАТЬ
        |    ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.БанковскиеСчетаОрганизаций) КАК БанковскийСчетКасса,
        |    Остатки.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток_ЕРП,
        |    Остатки.СуммаОборотДт КАК СуммаПриход_ЕРП,
        |    Остатки.СуммаОборотКт КАК СуммаРасход_ЕРП,
        |    Остатки.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток_ЕРП,
        |    Остатки.Период КАК ПериодДень
        |ИЗ
        |    РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, День, ,
        |        Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ДенежныеСредстваВБанках)), , ) КАК Остатки
        |ГДЕ
        |    Остатки.СуммаНачальныйОстаток <> 0
        |    ИЛИ Остатки.СуммаОборотДт <> 0
        |    ИЛИ Остатки.СуммаОборотКт <> 0";
    Иначе
        Запрос.Текст =
        "ВЫБРАТЬ
        |    ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.БанковскиеСчетаОрганизаций) КАК БанковскийСчетКасса,
        |    Остатки.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток_ЕРП,
        |    Остатки.СуммаОборотДт КАК СуммаПриход_ЕРП,
        |    Остатки.СуммаОборотКт КАК СуммаРасход_ЕРП,
        |    Остатки.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток_ЕРП
        |ИЗ
        |    РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , ,
        |        Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ДенежныеСредстваВБанках)), , ) КАК Остатки
        |ГДЕ
        |    Остатки.СуммаНачальныйОстаток <> 0
        |    ИЛИ Остатки.СуммаОборотДт <> 0
        |    ИЛИ Остатки.СуммаОборотКт <> 0";
    КонецЕсли;

    Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
    Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            НС = Результат.Добавить();
            ЗаполнитьЗначенияСвойств(НС, Выборка);
            НС.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Безналичные;
        КонецЦикла;
    Исключение
        Сообщить("Помилка запиту ERP: " + ОписаниеОшибки());
    КонецПопытки;

    Возврат Результат;

КонецФункции

// Отримує залишки з BuhBud через COM (РегистрБухгалтерии.Хозрасчетный, рахунки 31х)
//
// Параметри:
//   V83 - COMОбъект - з'єднання з BuhBud
//   НачалоПериода - Дата
//   КонецПериода - Дата
//   ПоДням - Булево - чи групувати по днях
//
// Повертає:
//   ТаблицаЗначений
//
Функция ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода, ПоДням)

    ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);

    Результат = Новый ТаблицаЗначений;
    Результат.Колонки.Добавить("БанковскийСчетКасса",
        Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчетаОрганизаций"));
    Результат.Колонки.Добавить("ТипДенежныхСредств",
        Новый ОписаниеТипов("ПеречислениеСсылка.ТипыДенежныхСредств"));
    Результат.Колонки.Добавить("СуммаНачальныйОстаток_УПП", ТипЧисло);
    Результат.Колонки.Добавить("СуммаПриход_УПП", ТипЧисло);
    Результат.Колонки.Добавить("СуммаРасход_УПП", ТипЧисло);
    Результат.Колонки.Добавить("СуммаКонечныйОстаток_УПП", ТипЧисло);

    Если ПоДням Тогда
        Результат.Колонки.Добавить("ПериодДень",
            Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
    КонецЕсли;

    Попытка
        Запрос = V83.NewObject("Запрос");
        Если ПоДням Тогда
            Запрос.Текст =
            "ВЫБРАТЬ
            |    Остатки.Субконто1 КАК БанковскийСчетКасса,
            |    ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.БанковскиеСчета).Наименование КАК БанковскийСчетНаименование,
            |    Остатки.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток_УПП,
            |    Остатки.СуммаОборотДт КАК СуммаПриход_УПП,
            |    Остатки.СуммаОборотКт КАК СуммаРасход_УПП,
            |    Остатки.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток_УПП,
            |    Остатки.Период КАК ПериодДень
            |ИЗ
            |    РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, День, ,
            |        Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ДенежныеСредстваВБанках)), , ) КАК Остатки
            |ГДЕ
            |    Остатки.СуммаНачальныйОстаток <> 0
            |    ИЛИ Остатки.СуммаОборотДт <> 0
            |    ИЛИ Остатки.СуммаОборотКт <> 0";
        Иначе
            Запрос.Текст =
            "ВЫБРАТЬ
            |    Остатки.Субконто1 КАК БанковскийСчетКасса,
            |    ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.БанковскиеСчета).Наименование КАК БанковскийСчетНаименование,
            |    Остатки.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток_УПП,
            |    Остатки.СуммаОборотДт КАК СуммаПриход_УПП,
            |    Остатки.СуммаОборотКт КАК СуммаРасход_УПП,
            |    Остатки.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток_УПП
            |ИЗ
            |    РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , ,
            |        Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ДенежныеСредстваВБанках)), , ) КАК Остатки
            |ГДЕ
            |    Остатки.СуммаНачальныйОстаток <> 0
            |    ИЛИ Остатки.СуммаОборотДт <> 0
            |    ИЛИ Остатки.СуммаОборотКт <> 0";
        КонецЕсли;

        Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
        Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

        ТЗ = Запрос.Выполнить().Выгрузить();

        // Конвертація посилань BuhBud -> ERP через пошук по найменуванню
        Для Каждого СтрокаТЗ Из ТЗ Цикл
            НС = Результат.Добавить();

            Если ПоДням Тогда
                НС.ПериодДень = СтрокаТЗ.ПериодДень;
            КонецЕсли;

            НС.СуммаНачальныйОстаток_УПП = СтрокаТЗ.СуммаНачальныйОстаток_УПП;
            НС.СуммаПриход_УПП = СтрокаТЗ.СуммаПриход_УПП;
            НС.СуммаРасход_УПП = СтрокаТЗ.СуммаРасход_УПП;
            НС.СуммаКонечныйОстаток_УПП = СтрокаТЗ.СуммаКонечныйОстаток_УПП;

            // Зіставлення по найменуванню банківського рахунку
            БанковскийСчетНаименование = СокрЛП(СтрокаТЗ.БанковскийСчетНаименование);
            Если НЕ ПустаяСтрока(БанковскийСчетНаименование) Тогда
                НС.БанковскийСчетКасса = Справочники.БанковскиеСчетаОрганизаций.НайтиПоНаименованию(
                    БанковскийСчетНаименование, Истина);
            КонецЕсли;

            НС.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Безналичные;
        КонецЦикла;

    Исключение
        Сообщить("Помилка запиту BuhBud: " + ОписаниеОшибки());
    КонецПопытки;

    Возврат Результат;

КонецФункции

