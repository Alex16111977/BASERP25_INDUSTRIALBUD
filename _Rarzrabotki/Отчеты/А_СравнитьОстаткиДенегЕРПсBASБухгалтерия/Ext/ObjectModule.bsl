    Результат.Колонки.Добавить("ТипДенежныхСредств",
        Новый ОписаниеТипов("ПеречислениеСсылка.ТипыДенежныхСредств"));
    Результат.Колонки.Добавить("СуммаНачальныйОстаток_УПП", ТипЧисло);
    Результат.Колонки.Добавить("СуммаПриход_УПП", ТипЧисло);
    Результат.Колонки.Добавить("СуммаРасход_УПП", ТипЧисло);
    Результат.Колонки.Добавить("СуммаКонечныйОстаток_УПП", ТипЧисло);

    Если ПоДням Тогда
        Результат.Колонки.Добавить("ПериодДень",
            Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
    КонецЕсли;

    Возврат Результат;

КонецФункции

#КонецОбласти
