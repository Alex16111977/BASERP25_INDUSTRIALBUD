// РегистрНакопления.РабочееВремяРаботниковОрганизаций по дням и видам времени (БуквенныйКод).
// Дата разложена на Год/Месяц/День, чтобы не тащить дату через COM.
Функция ПолучитьВремяЗУП(V83, НачалоПериода, КонецПериода)

	Результат = НоваяТаблицаВремяЗУП();

	ЗапросЗУП = V83.NewObject("Запрос");
	ЗапросЗУП.УстановитьПараметр("НачалоПериода", НачалоПериода);
	ЗапросЗУП.УстановитьПараметр("КонецПериода", КонецПериода);
	ЗапросЗУП.Текст =
	"ВЫБРАТЬ
	|	РВ.Сотрудник.Физлицо.КодПоДРФО КАК ДРФО,
	|	РВ.Сотрудник.Физлицо.Наименование КАК ФИО,
	|	РВ.Организация.Наименование КАК Организация,
	|	ГОД(РВ.Период) КАК Год,
	|	МЕСЯЦ(РВ.Период) КАК Месяц,
	|	ДЕНЬ(РВ.Период) КАК День,
	|	РВ.ВидИспользованияРабочегоВремени.БуквенныйКод КАК Код,
	|	РВ.ВидИспользованияРабочегоВремени.РабочееВремя КАК РабочееВремя,
	|	СУММА(РВ.Дней) КАК Дней,
	|	СУММА(РВ.Часов) КАК Часов
	|ИЗ
	|	РегистрНакопления.РабочееВремяРаботниковОрганизаций КАК РВ
	|ГДЕ
	|	РВ.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И РВ.Активность
	|СГРУППИРОВАТЬ ПО
	|	РВ.Сотрудник.Физлицо.КодПоДРФО,
	|	РВ.Сотрудник.Физлицо.Наименование,
	|	РВ.Организация.Наименование,
	|	ГОД(РВ.Период),
	|	МЕСЯЦ(РВ.Период),
	|	ДЕНЬ(РВ.Период),
	|	РВ.ВидИспользованияРабочегоВремени.БуквенныйКод,
	|	РВ.ВидИспользованияРабочегоВремени.РабочееВремя";

	Выборка = ЗапросЗУП.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр = Результат.Добавить();
		Стр.ДРФО = СокрЛП(Выборка.ДРФО);
		Стр.ФИО = СокрЛП(Выборка.ФИО);
		Стр.Организация = СокрЛП(Выборка.Организация);
		Стр.Дата = Дата(Выборка.Год, Выборка.Месяц, Выборка.День);
		Стр.Код = НРег(СокрЛП(Выборка.Код));
		Стр.РабочееВремя = (Выборка.РабочееВремя = Истина);
		Стр.Дней = Выборка.Дней;
		Стр.Часов = Выборка.Часов;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// РегистрРасчета.ОсновныеНачисленияРаботниковОрганизаций за период регистрации, свёртка по ДРФО.
Функция ПолучитьНачисленияЗУП(V83, НачалоПериода, КонецПериода)

	Результат = НоваяТаблицаНачисленияЗУП();

	ЗапросЗУП = V83.NewObject("Запрос");
	ЗапросЗУП.УстановитьПараметр("НачалоПериода", НачалоПериода);
	ЗапросЗУП.УстановитьПараметр("КонецПериода", КонецПериода);
	ЗапросЗУП.Текст =
	"ВЫБРАТЬ
	|	Н.Сотрудник.Физлицо.КодПоДРФО КАК ДРФО,
	|	Н.Сотрудник.Физлицо.Наименование КАК ФИО,
	|	Н.Организация.Наименование КАК Организация,
	|	СУММА(Н.Результат) КАК Начислено,
	|	СУММА(Н.ОтработаноДней) КАК ОтработаноДней,
	|	МАКСИМУМ(Н.НормаДней) КАК НормаДней
	|ИЗ
	|	РегистрРасчета.ОсновныеНачисленияРаботниковОрганизаций КАК Н
	|ГДЕ
	|	Н.ПериодРегистрации МЕЖДУ &НачалоПериода И &КонецПериода
	|СГРУППИРОВАТЬ ПО
	|	Н.Сотрудник.Физлицо.КодПоДРФО,
	|	Н.Сотрудник.Физлицо.Наименование,
	|	Н.Организация.Наименование";

	Выборка = ЗапросЗУП.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр = Результат.Добавить();
		Стр.ДРФО = СокрЛП(Выборка.ДРФО);
		Стр.ФИО = СокрЛП(Выборка.ФИО);
		Стр.Организация = СокрЛП(Выборка.Организация);
		Стр.Начислено = Выборка.Начислено;
		Стр.ОтработаноДней = Выборка.ОтработаноДней;
		Стр.НормаДней = Выборка.НормаДней;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Записи Справочник.СотрудникиОрганизаций ЗУП с кадровыми данными ПО РЕГИСТРАМ (как отчёт ЗУП «Личная карточка»):
// приём = МИНИМУМ(РаботникиОрганизаций.Период), увольнение = период последней записи минус день, если её
// регистратор УвольнениеИзОрганизаций; актуальность = есть движения и последнее не увольнение.
// Запасные источники даты приёма при пустом регистре (ИсточникПриема): 2 реквизит ДатаПриемаНаРаботу,
// 3 ДатаНачала, 4 ДатаДоговора; 0 = даты нет. Непроведённые кадровые документы не учитываются.
// Даты разложены на Год/Месяц/День (только примитивы через COM); пустая дата ЗУП = 0001-01-01.
Функция ПолучитьСотрудниковЗУП(V83)

	Результат = НоваяТаблицаСотрудникиЗУП();

	ЗапросЗУП = V83.NewObject("Запрос");
	ЗапросЗУП.Текст =
	"ВЫБРАТЬ
	|	Вл.ДРФО КАК ДРФО,
	|	Вл.ФИО КАК ФИО,
	|	Вл.Организация КАК Организация,
	|	Вл.Актуальность КАК Актуальность,
	|	Вл.Трудовой КАК Трудовой,
	|	Вл.ИсточникПриема КАК ИсточникПриема,
	|	ГОД(Вл.ДатаПриема) КАК ГодП,
	|	МЕСЯЦ(Вл.ДатаПриема) КАК МесяцП,
	|	ДЕНЬ(Вл.ДатаПриема) КАК ДеньП,
	|	ГОД(Вл.ДатаУвольнения) КАК ГодУ,
	|	МЕСЯЦ(Вл.ДатаУвольнения) КАК МесяцУ,
	|	ДЕНЬ(Вл.ДатаУвольнения) КАК ДеньУ
	|ИЗ
	|	(ВЫБРАТЬ
	|		С.Физлицо.КодПоДРФО КАК ДРФО,
	|		С.Физлицо.Наименование КАК ФИО,
	|		С.Организация.Наименование КАК Организация,
	|		ВЫБОР
	|			КОГДА Кадры.МинПериод ЕСТЬ NULL ТОГДА ЛОЖЬ
	|			КОГДА Посл.Регистратор ССЫЛКА Документ.УвольнениеИзОрганизаций ТОГДА ЛОЖЬ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ КАК Актуальность,
	|		ВЫБОР КОГДА С.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровСФизЛицами.ТрудовойДоговор) ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК Трудовой,
	|		ВЫБОР
	|			КОГДА НЕ Кадры.МинПериод ЕСТЬ NULL ТОГДА 1
	|			КОГДА С.ДатаПриемаНаРаботу <> ДАТАВРЕМЯ(1, 1, 1) ТОГДА 2
	|			КОГДА С.ДатаНачала <> ДАТАВРЕМЯ(1, 1, 1) ТОГДА 3
	|			КОГДА С.ДатаДоговора <> ДАТАВРЕМЯ(1, 1, 1) ТОГДА 4
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК ИсточникПриема,
	|		ВЫБОР
	|			КОГДА НЕ Кадры.МинПериод ЕСТЬ NULL ТОГДА Кадры.МинПериод
	|			КОГДА С.ДатаПриемаНаРаботу <> ДАТАВРЕМЯ(1, 1, 1) ТОГДА С.ДатаПриемаНаРаботу
	|			КОГДА С.ДатаНачала <> ДАТАВРЕМЯ(1, 1, 1) ТОГДА С.ДатаНачала
	|			ИНАЧЕ С.ДатаДоговора
	|		КОНЕЦ КАК ДатаПриема,
	|		ВЫБОР
	|			КОГДА Посл.Регистратор ССЫЛКА Документ.УвольнениеИзОрганизаций ТОГДА ДОБАВИТЬКДАТЕ(Посл.Период, ДЕНЬ, -1)
	|			КОГДА НЕ Кадры.МинПериод ЕСТЬ NULL ТОГДА ДАТАВРЕМЯ(1, 1, 1)
	|			КОГДА С.ДатаУвольнения <> ДАТАВРЕМЯ(1, 1, 1) ТОГДА С.ДатаУвольнения
	|			ИНАЧЕ С.ДатаОкончания
	|		КОНЕЦ КАК ДатаУвольнения
	|	ИЗ
	|		Справочник.СотрудникиОрганизаций КАК С
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ Р.Сотрудник КАК Сотрудник, МИНИМУМ(Р.Период) КАК МинПериод
	|				ИЗ РегистрСведений.РаботникиОрганизаций КАК Р
	|				СГРУППИРОВАТЬ ПО Р.Сотрудник) КАК Кадры
	|			ПО Кадры.Сотрудник = С.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаботникиОрганизаций.СрезПоследних(, ) КАК Посл
	|			ПО Посл.Сотрудник = С.Ссылка
	|	ГДЕ
	|		НЕ С.ПометкаУдаления
	|		И С.Физлицо.КодПоДРФО <> """") КАК Вл";

	Выборка = ЗапросЗУП.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр = Результат.Добавить();
		Стр.ДРФО = СокрЛП(Выборка.ДРФО);
		Стр.ФИО = СокрЛП(Выборка.ФИО);
		Стр.Организация = СокрЛП(Выборка.Организация);
		Стр.Актуальность = (Выборка.Актуальность = Истина);
		Стр.Трудовой = (Выборка.Трудовой = Истина);
		Стр.ИсточникПриема = Выборка.ИсточникПриема;
		Стр.ДатаПриема = ДатаИзЧастей(Выборка.ГодП, Выборка.МесяцП, Выборка.ДеньП);
		Стр.ДатаУвольнения = ДатаИзЧастей(Выборка.ГодУ, Выборка.МесяцУ, Выборка.ДеньУ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

