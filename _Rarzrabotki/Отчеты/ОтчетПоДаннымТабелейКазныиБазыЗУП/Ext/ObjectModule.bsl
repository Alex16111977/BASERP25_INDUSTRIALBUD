	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("КлючДок", ТипСтрока);
	ТЗ.Колонки.Добавить("ТабельКазныДок", Новый ОписаниеТипов("ДокументСсылка.ТабельУчетаРабочегоВремени"));
	ТЗ.Колонки.Добавить("ОрганизацияДок", ТипСтрока);
