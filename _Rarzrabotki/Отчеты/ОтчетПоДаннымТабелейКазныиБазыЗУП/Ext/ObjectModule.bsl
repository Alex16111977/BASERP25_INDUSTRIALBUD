КонецФункции

// Строка = сотрудник Свода × табель Казны: расшифровка дней и часов до документа (ссылка открывается из отчёта).
Функция СформироватьСводДок(Свод, ДанныеКазны)

	Результат = НоваяТаблицаСводДок();
	СводПоКлючу = Новый Соответствие;
	Для Каждого Стр Из Свод Цикл
		Если Стр.ЕстьТабельКазны Тогда
			СводПоКлючу.Вставить(Стр.КлючСвода, Стр);
		КонецЕсли;
	КонецЦикла;

	Агрегаты = Новый Соответствие;
	Порядок = Новый Массив;
	Для Каждого СтрК Из ДанныеКазны Цикл
		Ключ = КлючСотрудникаКазны(СтрК.Сотрудник, СтрК.ИНН);
		Если СводПоКлючу[Ключ] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Состояние = СокрЛП(СтрК.Состояние);
		Если Состояние = "" Тогда
			Продолжить;
		КонецЕсли;
		КлючДок = Ключ + "|" + Строка(СтрК.Регистратор.УникальныйИдентификатор());
		А = Агрегаты[КлючДок];
		Если А = Неопределено Тогда
			А = Новый Структура("Ключ, Док, Организация, Подразделения, Даты, ЧасыР, ЧасыМ", Ключ, СтрК.Регистратор, СтрК.Организация, Новый Соответствие, Новый Соответствие, 0, 0);
			Агрегаты.Вставить(КлючДок, А);
			Порядок.Добавить(КлючДок);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрК.Подразделение) Тогда
			А.Подразделения.Вставить(СтрК.Подразделение, Истина);
		КонецЕсли;
		Если Состояние = "Р" Тогда
			Если СтрК.ЧасыФакт > 0 Тогда
				А.ЧасыР = А.ЧасыР + СтрК.ЧасыФакт;
				ОтметитьДень(А.Даты, "Р", СтрК.Дата);
				ОтметитьДень(А.Даты, "Официально", СтрК.Дата);
			КонецЕсли;
		ИначеЕсли Состояние = "М" Тогда
			А.ЧасыМ = А.ЧасыМ + СтрК.ЧасыОфициальные;
			ОтметитьДень(А.Даты, "М", СтрК.Дата);
			ОтметитьДень(А.Даты, "Официально", СтрК.Дата);
		Иначе
			ОтметитьДень(А.Даты, Состояние, СтрК.Дата);
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючДок Из Порядок Цикл
		А = Агрегаты[КлючДок];
		Стр = Результат.Добавить();
		Стр.КлючДок = А.Ключ;
		Стр.ТабельКазныДок = А.Док;
		Стр.ОрганизацияДок = А.Организация;
		Стр.ПодразделениеДок = СтрокаИзМножества(А.Подразделения);
		Стр.ДниРДок = КоличествоДней(А.Даты, "Р");
		Стр.ЧасыРДок = А.ЧасыР;
		Стр.ДниМДок = КоличествоДней(А.Даты, "М");
		Стр.ЧасыМДок = А.ЧасыМ;
		Стр.ДниОфицДок = КоличествоДней(А.Даты, "Официально");
		Стр.ЧасыОфицДок = А.ЧасыР + А.ЧасыМ;
		Стр.ДниОДок = КоличествоДней(А.Даты, "О");
		Стр.ДниБДок = КоличествоДней(А.Даты, "Б");
		Стр.ДниСДок = КоличествоДней(А.Даты, "С");
		Стр.ДниКДок = КоличествоДней(А.Даты, "К");
		Стр.ДниНДок = КоличествоДней(А.Даты, "Н");
		Стр.ДниВДок = КоличествоДней(А.Даты, "В");
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

