	Для Каждого Имя Из СтрРазделить("ДниРДок,ЧасыРДок,ДниМДок,ЧасыМДок,ДниОфицДок,ЧасыОфицДок,ДниОДок,ДниБДок,ДниСДок,ДниКДок,ДниНДок,ДниВДок", ",") Цикл
		ТЗ.Колонки.Добавить(Имя, ТипЧисло);
	КонецЦикла;
