КонецФункции

Функция ДатаИзЧастей(Год, Месяц, День)
	Если Год < 1900 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Возврат Дата(Год, Месяц, День);
КонецФункции

// Свёртка кадров по ДРФО. Трудоустройство = актуальный ТРУДОВОЙ договор; договоры ГПХ (подряд, авторский)
// показываются в тексте с пометкой «ГПХ», но актуальность и даты приёма/увольнения по ним не считаются.
// Дата приёма: актуальной трудовой записи (иначе первой трудовой), увольнение: последнее, только если актуальной нет.
Функция СвернутьКадрыЗУП(ТаблицаСотрудники, ПоОрганизациям = Ложь)

	ТаблицаСотрудники.Сортировать("ДРФО, Трудовой УБЫВ, ДатаПриема");
	Результат = Новый Соответствие;
	Для Каждого Стр Из ТаблицаСотрудники Цикл
		Ключ = ?(ПоОрганизациям, Стр.ДРФО + "|" + Стр.Организация, Стр.ДРФО);
		К = Результат[Ключ];
		Если К = Неопределено Тогда
			К = Новый Структура("ФИО, Части, ДатаПриема, ДатаУвольнения, Актуален, Трудовой, ЕстьГПХ, ИсточникПриема", Стр.ФИО, Новый Массив, Дата(1, 1, 1), Дата(1, 1, 1), Ложь, Ложь, Ложь, 0);
			Результат.Вставить(Ключ, К);
		КонецЕсли;
		ТекстПриема = ?(ЗначениеЗаполнено(Стр.ДатаПриема), Формат(Стр.ДатаПриема, "ДФ=dd.MM.yyyy") + ПометкаИсточникаПриема(Стр.ИсточникПриема), "?");
		ТекстУвольнения = ?(Стр.Актуальность, "по н.в.", ?(ЗначениеЗаполнено(Стр.ДатаУвольнения), Формат(Стр.ДатаУвольнения, "ДФ=dd.MM.yyyy"), "?"));
		К.Части.Добавить(Стр.Организация + ?(Стр.Трудовой, "", " (ГПХ)") + ": " + ТекстПриема + " - " + ТекстУвольнения);
		Если НЕ Стр.Трудовой Тогда
			К.ЕстьГПХ = Истина;
			Продолжить;
		КонецЕсли;
		К.Трудовой = Истина;
		Если Стр.Актуальность Тогда
			Если НЕ К.Актуален ИЛИ (ЗначениеЗаполнено(Стр.ДатаПриема) И (НЕ ЗначениеЗаполнено(К.ДатаПриема) ИЛИ Стр.ДатаПриема < К.ДатаПриема)) Тогда
				К.ДатаПриема = Стр.ДатаПриема;
				К.ИсточникПриема = Стр.ИсточникПриема;
			КонецЕсли;
			К.Актуален = Истина;
			К.ДатаУвольнения = Дата(1, 1, 1);
		ИначеЕсли НЕ К.Актуален Тогда
			Если НЕ ЗначениеЗаполнено(К.ДатаПриема) ИЛИ (ЗначениеЗаполнено(Стр.ДатаПриема) И Стр.ДатаПриема < К.ДатаПриема) Тогда
				К.ДатаПриема = Стр.ДатаПриема;
				К.ИсточникПриема = Стр.ИсточникПриема;
			КонецЕсли;
			Если Стр.ДатаУвольнения > К.ДатаУвольнения Тогда
				К.ДатаУвольнения = Стр.ДатаУвольнения;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПометкаИсточникаПриема(Источник)
	Если Источник = 2 Тогда
		Возврат " (реквизит справочника)";
	ИначеЕсли Источник = 3 Тогда
		Возврат " (дата начала)";
	ИначеЕсли Источник = 4 Тогда
		Возврат " (дата договора)";
	КонецЕсли;
	Возврат "";
КонецФункции

#КонецОбласти

#Область Свод

Функция НоваяТаблицаСвод()

	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипЧисло = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2));
	ТипБулево = Новый ОписаниеТипов("Булево");

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	ТЗ.Колонки.Добавить("ФИО", ТипСтрока);
	ТЗ.Колонки.Добавить("ИНН", ТипСтрока);
	ТЗ.Колонки.Добавить("Трудоустроен", ТипБулево);
	ТЗ.Колонки.Добавить("ЕстьТабельКазны", ТипБулево);
	ТЗ.Колонки.Добавить("КлючСвода", ТипСтрока);
	ТЗ.Колонки.Добавить("ОрганизацииКазны", ТипСтрока);
	ТЗ.Колонки.Добавить("ПодразделенияКазны", ТипСтрока);
	// Казна
	Для Каждого Имя Из СтрРазделить("ДниР,ЧасыР,ДниМ,ЧасыМ,ДниОфициальные,ЧасыОфициальные,ДниКазна,ДниО,ДниБ,ДниС,ДниК,ДниН,ДниВ,ДниД,ДниОшибка,ЧасыПлан", ",") Цикл
		ТЗ.Колонки.Добавить(Имя, ТипЧисло);
	КонецЦикла;
	// ЗУП
	ТЗ.Колонки.Добавить("ФИОЗУП", ТипСтрока);
	ТЗ.Колонки.Добавить("ОрганизацияЗУП", ТипСтрока);
	ТЗ.Колонки.Добавить("АктуаленВЗУП", ТипБулево);
	ТЗ.Колонки.Добавить("ПриемУвольнениеЗУП", ТипСтрока);
	ТЗ.Колонки.Добавить("ДатаПриемаЗУП", Новый ОписаниеТипов("Дата"));
	ТЗ.Колонки.Добавить("ДатаУвольненияЗУП", Новый ОписаниеТипов("Дата"));
	Для Каждого Имя Из СтрРазделить("ОрганизацийЗУП,ДниРаботаЗУП,ЧасыРаботаЗУП,ДниОтпускЗУП,ДниБольничныйЗУП,ДниБезОплатыЗУП,ДниКомандировкаЗУП,ДниНеявкиЗУП,ДниПрочиеЗУП,НачисленоЗУП,ОтработаноДнейЗУП,НормаДнейЗУП", ",") Цикл
		ТЗ.Колонки.Добавить(Имя, ТипЧисло);
	КонецЦикла;
	// Контроль
	ТЗ.Колонки.Добавить("Контроль", ТипСтрока);
	Для Каждого Имя Из СтрРазделить("НетФлагаТрудоустроен,УволенВЗУП,ЕстьРасхождениеДней,НетНачисленийЗУП,НеПротабелированВЗУП,БольничныйНеВЗУП,ОтпускНеВЗУП,ЗаСвойСчетНеВЗУП,НетИНН,ДубльИНН,НетТабеляКазны,ЕстьКонтроль", ",") Цикл
		ТЗ.Колонки.Добавить(Имя, ТипБулево);
	КонецЦикла;
	ТЗ.Колонки.Добавить("РасхождениеДней", ТипЧисло);
	Возврат ТЗ;

КонецФункции

// Ключ сотрудника Казны: ИНН, если он есть, иначе уникальный идентификатор ссылки.
Функция КлючСотрудникаКазны(Сотрудник, ИНН)
	Если ЗначениеЗаполнено(СокрЛП(ИНН)) Тогда
		Возврат "И:" + СокрЛП(ИНН);
	КонецЕсли;
	Возврат "К:" + Строка(Сотрудник.УникальныйИдентификатор());
КонецФункции

Функция КатегорияКодаЗУП(Код, РабочееВремя)
	Если РабочееВремя Тогда
		Возврат "Работа";
	ИначеЕсли СтрНайти(",в,д,дб,тв,ч,до,", "," + Код + ",") > 0 Тогда
		Возврат "Отпуск";
	ИначеЕсли СтрНайти(",тн,нн,", "," + Код + ",") > 0 Тогда
		Возврат "Больничный";
	ИначеЕсли СтрНайти(",на,бз,", "," + Код + ",") > 0 Тогда
		Возврат "БезОплаты";
	ИначеЕсли СтрНайти(",нз,пр,ін,і,ів,", "," + Код + ",") > 0 Тогда
		Возврат "Неявки";
	КонецЕсли;
	Возврат "Прочие";
КонецФункции

Процедура ОтметитьДень(ДниСотрудника, Состояние, Дата)
	Дни = ДниСотрудника[Состояние];
	Если Дни = Неопределено Тогда
		Дни = Новый Соответствие;
		ДниСотрудника.Вставить(Состояние, Дни);
	КонецЕсли;
	Дни.Вставить(Дата, Истина);
КонецПроцедуры

Функция КоличествоДней(ДниСотрудника, Состояние)
	Дни = ДниСотрудника[Состояние];
	Возврат ?(Дни = Неопределено, 0, Дни.Количество());
КонецФункции

Функция СтрокаИзМножества(Множество)
	Массив = Новый Массив;
	Для Каждого КлючЗначение Из Множество Цикл
		Массив.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	Возврат СтрСоединить(Массив, ", ");
КонецФункции

// Свёртка ЗУП по ДРФО: Соответствие ДРФО -> Структура с днями/часами по категориям, ФИО, организациями.
Функция СвернутьВремяЗУП(ТаблицаВремя, ПоОрганизациям = Ложь)

	Результат = Новый Соответствие;
	Для Каждого Стр Из ТаблицаВремя Цикл
		Если Стр.ДРФО = "" Тогда
			Продолжить;
		КонецЕсли;
		Ключ = ?(ПоОрганизациям, Стр.ДРФО + "|" + Стр.Организация, Стр.ДРФО);
		Св = Результат[Ключ];
		Если Св = Неопределено Тогда
			// Дни считаются по уникальным датам: сотрудник ЗУП в двух организациях — одна карточка Казны,
			// поэтому день, отработанный в обеих организациях, считается один раз. Часы суммируются.
			Св = Новый Структура("ФИО, Организации, Даты, ЧасыРабота", Стр.ФИО, Новый Соответствие, Новый Соответствие, 0);
			Для Каждого ИмяКатегории Из СтрРазделить("Работа,Командировка,Отпуск,Больничный,БезОплаты,Неявки,Прочие,Всего", ",") Цикл
				Св.Даты.Вставить(ИмяКатегории, Новый Соответствие);
			КонецЦикла;
			Результат.Вставить(Ключ, Св);
		КонецЕсли;
		Св.Организации.Вставить(Стр.Организация, Истина);
		Если Стр.Дней = 0 И Стр.Часов = 0 Тогда
			Продолжить;
		КонецЕсли;
		Св.Даты["Всего"].Вставить(Стр.Дата, Истина);
		Категория = КатегорияКодаЗУП(Стр.Код, Стр.РабочееВремя);
		Св.Даты[Категория].Вставить(Стр.Дата, Истина);
		Если Категория = "Работа" Тогда
			Св.ЧасыРабота = Св.ЧасыРабота + Стр.Часов;
			Если Стр.Код = "вд" Тогда
				Св.Даты["Командировка"].Вставить(Стр.Дата, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СформироватьСвод(ДанныеКазны, ДанныеЗУП)

	Свод = НоваяТаблицаСвод();
	СтрокиПоКлючу = Новый Соответствие;
	ДниПоКлючу = Новый Соответствие;
	ОрганизацииПоКлючу = Новый Соответствие;
	ПодразделенияПоКлючу = Новый Соответствие;
	СотрудникиПоКлючу = Новый Соответствие;

	// 1. Казна
	Для Каждого СтрК Из ДанныеКазны Цикл
		Ключ = КлючСотрудникаКазны(СтрК.Сотрудник, СтрК.ИНН);
		Стр = СтрокиПоКлючу[Ключ];
		Если Стр = Неопределено Тогда
			Стр = Свод.Добавить();
			Стр.Сотрудник = СтрК.Сотрудник;
			Стр.ФИО = СтрК.ФИО;
			Стр.ИНН = СокрЛП(СтрК.ИНН);
			Стр.Трудоустроен = (СтрК.Трудоустроен = Истина);
			Стр.ЕстьТабельКазны = Истина;
			Стр.КлючСвода = Ключ;
			СтрокиПоКлючу.Вставить(Ключ, Стр);
			ДниПоКлючу.Вставить(Ключ, Новый Соответствие);
			ОрганизацииПоКлючу.Вставить(Ключ, Новый Соответствие);
			ПодразделенияПоКлючу.Вставить(Ключ, Новый Соответствие);
			СотрудникиПоКлючу.Вставить(Ключ, Новый Соответствие);
		КонецЕсли;
		// Дубли одного ИНН в справочнике Казны сливаются в одну строку: Трудоустроен = ИЛИ по всем записям
		СотрудникиПоКлючу[Ключ].Вставить(СтрК.Сотрудник, Истина);
		Стр.Трудоустроен = Стр.Трудоустроен ИЛИ (СтрК.Трудоустроен = Истина);
		ОрганизацииПоКлючу[Ключ].Вставить(СтрК.Организация, Истина);
		Если ЗначениеЗаполнено(СтрК.Подразделение) Тогда
			ПодразделенияПоКлючу[Ключ].Вставить(СтрК.Подразделение, Истина);
		КонецЕсли;
		Стр.ЧасыПлан = Стр.ЧасыПлан + СтрК.ЧасыПлан;
		Состояние = СокрЛП(СтрК.Состояние);
		Если Состояние = "Р" Тогда
			Если СтрК.ЧасыФакт > 0 Тогда
				Стр.ЧасыР = Стр.ЧасыР + СтрК.ЧасыФакт;
				ОтметитьДень(ДниПоКлючу[Ключ], "Р", СтрК.Дата);
				ОтметитьДень(ДниПоКлючу[Ключ], "Официально", СтрК.Дата);
			КонецЕсли;
		ИначеЕсли Состояние = "М" Тогда
			Стр.ЧасыМ = Стр.ЧасыМ + СтрК.ЧасыОфициальные;
			ОтметитьДень(ДниПоКлючу[Ключ], "М", СтрК.Дата);
			ОтметитьДень(ДниПоКлючу[Ключ], "Официально", СтрК.Дата);
		ИначеЕсли Состояние <> "" Тогда
			ОтметитьДень(ДниПоКлючу[Ключ], Состояние, СтрК.Дата);
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючЗначение Из СтрокиПоКлючу Цикл
		Ключ = КлючЗначение.Ключ;
		Стр = КлючЗначение.Значение;
		Дни = ДниПоКлючу[Ключ];
		Стр.ДниР = КоличествоДней(Дни, "Р");
		Стр.ДниМ = КоличествоДней(Дни, "М");
		// Официальные = все отработанные: дни по уникальным датам с часами Р или М, часы = Р + М
		Стр.ДниОфициальные = КоличествоДней(Дни, "Официально");
		Стр.ЧасыОфициальные = Стр.ЧасыР + Стр.ЧасыМ;
		Стр.ДниО = КоличествоДней(Дни, "О");
		Стр.ДниБ = КоличествоДней(Дни, "Б");
		Стр.ДниС = КоличествоДней(Дни, "С");
		Стр.ДниК = КоличествоДней(Дни, "К");
		Стр.ДниКазна = КоличествоДней(Дни, "Официально") + Стр.ДниК; // рабочие дни по Казне: Р + М + командировки
		Стр.ДниН = КоличествоДней(Дни, "Н");
		Стр.ДниВ = КоличествоДней(Дни, "В");
		Стр.ДниД = КоличествоДней(Дни, "Д");
		Стр.ДниОшибка = КоличествоДней(Дни, "?");
		Стр.ОрганизацииКазны = СтрокаИзМножества(ОрганизацииПоКлючу[Ключ]);
		Стр.ПодразделенияКазны = СтрокаИзМножества(ПодразделенияПоКлючу[Ключ]);
		Стр.ДубльИНН = (СотрудникиПоКлючу[Ключ].Количество() > 1);
	КонецЦикла;

	// 2. ЗУП
	ВремяПоДРФО = СвернутьВремяЗУП(ДанныеЗУП.Время, Ложь);
	НачисленияПоДРФО = СвернутьНачисленияЗУП(ДанныеЗУП.Начисления, Ложь);

	ДРФОБезТабеля = Новый Соответствие;
	Для Каждого КлючЗначение Из ВремяПоДРФО Цикл
		Если СтрокиПоКлючу["И:" + КлючЗначение.Ключ] = Неопределено Тогда
			ДРФОБезТабеля.Вставить(КлючЗначение.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючЗначение Из НачисленияПоДРФО Цикл
		Если СтрокиПоКлючу["И:" + КлючЗначение.Ключ] = Неопределено И КлючЗначение.Значение.Начислено <> 0 Тогда
			ДРФОБезТабеля.Вставить(КлючЗначение.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючЗначение Из ДанныеЗУП.АктуальныеДРФО Цикл
		Если СтрокиПоКлючу["И:" + КлючЗначение.Ключ] = Неопределено Тогда
			ДРФОБезТабеля.Вставить(КлючЗначение.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

	// Люди ЗУП без табеля Казны: отбор в отчёте по полю «Нет табеля Казны»
	Если ДанныеЗУП.Доступен Тогда
		Для Каждого КлючЗначение Из ДРФОБезТабеля Цикл
			ДРФО = КлючЗначение.Ключ;
			Стр = Свод.Добавить();
			Стр.ИНН = ДРФО;
			Стр.ЕстьТабельКазны = Ложь;
			Стр.КлючСвода = "З:" + ДРФО;
			Св = ВремяПоДРФО[ДРФО];
			Н = НачисленияПоДРФО[ДРФО];
			К = ДанныеЗУП.Кадры[ДРФО];
			Если Св <> Неопределено Тогда
				Стр.ФИО = Св.ФИО;
			ИначеЕсли Н <> Неопределено Тогда
				Стр.ФИО = Н.ФИО;
			ИначеЕсли К <> Неопределено Тогда
				Стр.ФИО = К.ФИО;
			Иначе
				Стр.ФИО = ДРФО;
			КонецЕсли;
			СтрокиПоКлючу.Вставить("З:" + ДРФО, Стр);
		КонецЦикла;
	КонецЕсли;

	// 3. Присоединение ЗУП и контроль
	Для Каждого Стр Из Свод Цикл
		ДРФО = Стр.ИНН;
		Св = ?(ДРФО = "", Неопределено, ВремяПоДРФО[ДРФО]);
		Н = ?(ДРФО = "", Неопределено, НачисленияПоДРФО[ДРФО]);
		Если Св <> Неопределено Тогда
			Стр.ФИОЗУП = Св.ФИО;
			Стр.ОрганизацияЗУП = СтрокаИзМножества(Св.Организации);
			Стр.ОрганизацийЗУП = Св.Организации.Количество();
			Стр.ДниРаботаЗУП = Св.Даты["Работа"].Количество();
			Стр.ЧасыРаботаЗУП = Св.ЧасыРабота;
			Стр.ДниОтпускЗУП = Св.Даты["Отпуск"].Количество();
			Стр.ДниБольничныйЗУП = Св.Даты["Больничный"].Количество();
			Стр.ДниБезОплатыЗУП = Св.Даты["БезОплаты"].Количество();
			Стр.ДниКомандировкаЗУП = Св.Даты["Командировка"].Количество();
			Стр.ДниНеявкиЗУП = Св.Даты["Неявки"].Количество();
			Стр.ДниПрочиеЗУП = Св.Даты["Прочие"].Количество();
		КонецЕсли;
		Если Н <> Неопределено Тогда
			Если Стр.ФИОЗУП = "" Тогда
				Стр.ФИОЗУП = Н.ФИО;
			КонецЕсли;
			Стр.НачисленоЗУП = Н.Начислено;
			Стр.ОтработаноДнейЗУП = Н.ОтработаноДней;
			Стр.НормаДнейЗУП = Н.НормаДней;
		КонецЕсли;
		Стр.АктуаленВЗУП = (ДРФО <> "" И ДанныеЗУП.АктуальныеДРФО[ДРФО] <> Неопределено);
		К = ?(ДРФО = "", Неопределено, ДанныеЗУП.Кадры[ДРФО]);
		Если К <> Неопределено Тогда
			Если Стр.ФИОЗУП = "" Тогда
				Стр.ФИОЗУП = К.ФИО;
			КонецЕсли;
			Стр.ПриемУвольнениеЗУП = СтрСоединить(К.Части, "; ");
			Стр.ДатаПриемаЗУП = К.ДатаПриема;
			Стр.ДатаУвольненияЗУП = К.ДатаУвольнения;
		КонецЕсли;
		ЗаполнитьКонтроль(Стр, ДанныеЗУП.Доступен, Св <> Неопределено ИЛИ Н <> Неопределено ИЛИ К <> Неопределено);
	КонецЦикла;

	Свод.Сортировать("ФИО");
	Возврат Свод;

КонецФункции

Процедура ЗаполнитьКонтроль(Стр, ЗУПДоступен, ЕстьДанныеЗУП)

	Признаки = Новый Массив;
	ЕстьИНН = (Стр.ИНН <> "");
	// Сравнивать с ЗУП имеет смысл для трудоустроенных, для людей с часами «М» и для тех, кто есть в ЗУП
	СвязанСЗУП = ЕстьИНН И (Стр.Трудоустроен ИЛИ ЕстьДанныеЗУП ИЛИ Стр.АктуаленВЗУП ИЛИ Стр.ДниМ > 0);

	Стр.НетТабеляКазны = НЕ Стр.ЕстьТабельКазны;
	Стр.НетИНН = Стр.ЕстьТабельКазны И НЕ ЕстьИНН И (Стр.Трудоустроен ИЛИ Стр.ДниМ > 0);

	Если НЕ ЗУПДоступен Тогда
		Признаки.Добавить("ЗУП недоступен");
	ИначеЕсли Стр.ЕстьТабельКазны И ЕстьИНН Тогда
		Стр.НетФлагаТрудоустроен = НЕ Стр.Трудоустроен И (Стр.НачисленоЗУП <> 0 ИЛИ Стр.ДниРаботаЗУП > 0 ИЛИ Стр.АктуаленВЗУП);
		Стр.УволенВЗУП = Стр.Трудоустроен И НЕ Стр.АктуаленВЗУП И Стр.ПриемУвольнениеЗУП <> "";
		Стр.НетНачисленийЗУП = Стр.Трудоустроен И Стр.НачисленоЗУП = 0;
		Если СвязанСЗУП Тогда
			Стр.РасхождениеДней = Стр.ДниКазна - Стр.ДниРаботаЗУП;
			Стр.ЕстьРасхождениеДней = (Стр.РасхождениеДней <> 0);
			Стр.НеПротабелированВЗУП = Стр.ДниКазна > 0 И Стр.ДниРаботаЗУП = 0;
			Стр.БольничныйНеВЗУП = Стр.ДниБ > 0 И Стр.ДниБольничныйЗУП = 0;
			Стр.ОтпускНеВЗУП = Стр.ДниО > 0 И Стр.ДниОтпускЗУП = 0;
			Стр.ЗаСвойСчетНеВЗУП = Стр.ДниС > 0 И Стр.ДниБезОплатыЗУП = 0;
		КонецЕсли;
	КонецЕсли;

	// Порядок: сначала главное для бухгалтера — расхождение дней, потом статус, потом отметки
	Если Стр.НеПротабелированВЗУП Тогда
		Признаки.Добавить("в ЗУП нет рабочих дней, по Казне " + Формат(Стр.ДниКазна, "ЧДЦ=0; ЧГ=0") + " дн");
	ИначеЕсли Стр.РасхождениеДней > 0 Тогда
		Признаки.Добавить("Казна > ЗУП на " + Формат(Стр.РасхождениеДней, "ЧДЦ=0; ЧГ=0") + " дн");
	ИначеЕсли Стр.РасхождениеДней < 0 Тогда
		Признаки.Добавить("ЗУП > Казна на " + Формат(-Стр.РасхождениеДней, "ЧДЦ=0; ЧГ=0") + " дн");
	КонецЕсли;
	Если Стр.НетФлагаТрудоустроен Тогда
		Признаки.Добавить("нет флага Трудоустроен" + ?(Стр.АктуаленВЗУП, ", в ЗУП принят" + ?(ЗначениеЗаполнено(Стр.ДатаПриемаЗУП), " с " + Формат(Стр.ДатаПриемаЗУП, "ДФ=dd.MM.yyyy"), ""), ", в ЗУП есть начисления/время"));
	КонецЕсли;
	Если Стр.УволенВЗУП Тогда
		Признаки.Добавить("в ЗУП уволен" + ?(ЗначениеЗаполнено(Стр.ДатаУвольненияЗУП), " " + Формат(Стр.ДатаУвольненияЗУП, "ДФ=dd.MM.yyyy"), ""));
	КонецЕсли;
	Если Стр.НетНачисленийЗУП Тогда
		Признаки.Добавить("нет начислений в ЗУП");
	КонецЕсли;
	Если Стр.БольничныйНеВЗУП Тогда
		Признаки.Добавить("Б " + Формат(Стр.ДниБ, "ЧДЦ=0") + " дн не в ЗУП");
	КонецЕсли;
	Если Стр.ОтпускНеВЗУП Тогда
		Признаки.Добавить("О " + Формат(Стр.ДниО, "ЧДЦ=0") + " дн не в ЗУП");
	КонецЕсли;
	Если Стр.ЗаСвойСчетНеВЗУП Тогда
		Признаки.Добавить("С " + Формат(Стр.ДниС, "ЧДЦ=0") + " дн не в ЗУП");
	КонецЕсли;
	Если Стр.НетТабеляКазны Тогда
		Признаки.Добавить("нет табеля Казны");
	КонецЕсли;
	Если Стр.НетИНН Тогда
		Признаки.Добавить("нет ИНН");
	КонецЕсли;
	Если Стр.ДубльИНН Тогда
		Признаки.Добавить("дубль ИНН в Казне");
	КонецЕсли;
	Если Стр.ОрганизацийЗУП > 1 Тогда
		Признаки.Добавить(Формат(Стр.ОрганизацийЗУП, "ЧДЦ=0") + " орг. ЗУП");
	КонецЕсли;

	Стр.Контроль = СтрСоединить(Признаки, "; ");
	Стр.ЕстьКонтроль = Стр.НетТабеляКазны ИЛИ Стр.НетИНН ИЛИ Стр.ДубльИНН ИЛИ Стр.НетФлагаТрудоустроен ИЛИ Стр.УволенВЗУП
		ИЛИ Стр.НетНачисленийЗУП ИЛИ Стр.НеПротабелированВЗУП ИЛИ Стр.БольничныйНеВЗУП
		ИЛИ Стр.ОтпускНеВЗУП ИЛИ Стр.ЗаСвойСчетНеВЗУП ИЛИ Стр.ЕстьРасхождениеДней;

КонецПроцедуры

#КонецОбласти

#Область СводПоОрганизациям

// Свёртка начислений по ДРФО (ПоОрганизациям = Ложь) или по ДРФО|Организация.
Функция СвернутьНачисленияЗУП(ТаблицаНачисления, ПоОрганизациям)

	Результат = Новый Соответствие;
	Для Каждого Стр Из ТаблицаНачисления Цикл
		Если Стр.ДРФО = "" Тогда
			Продолжить;
		КонецЕсли;
		Ключ = ?(ПоОрганизациям, Стр.ДРФО + "|" + Стр.Организация, Стр.ДРФО);
		Н = Результат[Ключ];
		Если Н = Неопределено Тогда
			Н = Новый Структура("ФИО, Начислено, ОтработаноДней, НормаДней, Организации", Стр.ФИО, 0, 0, 0, Новый Соответствие);
			Результат.Вставить(Ключ, Н);
		КонецЕсли;
		Н.Начислено = Н.Начислено + Стр.Начислено;
		Н.ОтработаноДней = Н.ОтработаноДней + Стр.ОтработаноДней;
		Н.НормаДней = Макс(Н.НормаДней, Стр.НормаДней);
		Н.Организации.Вставить(Стр.Организация, Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НоваяТаблицаСводОрг()

	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипЧисло = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2));
	ТипДата = Новый ОписаниеТипов("Дата");
	ТЗ = Новый ТаблицаЗначений;
	// Имена полей уникальны относительно набора «Свод» (СКД не допускает одноимённые поля в разных наборах)
	ТЗ.Колонки.Добавить("ИННО", ТипСтрока);
	ТЗ.Колонки.Добавить("ФИОО", ТипСтрока);
	ТЗ.Колонки.Добавить("ОрганизацияЗУПО", ТипСтрока);
	ТЗ.Колонки.Добавить("ВидДоговораОрг", ТипСтрока);
	ТЗ.Колонки.Добавить("АктуаленОрг", Новый ОписаниеТипов("Булево"));
	ТЗ.Колонки.Добавить("ДатаПриемаОрг", ТипДата);
	ТЗ.Колонки.Добавить("ДатаУвольненияОрг", ТипДата);
	ТЗ.Колонки.Добавить("ИсточникПриемаОрг", ТипСтрока);
	Для Каждого Имя Из СтрРазделить("ДниРаботаОрг,ЧасыРаботаОрг,ДниОтпускОрг,ДниБольничныйОрг,ДниБезОплатыОрг,ДниКомандировкаОрг,ДниНеявкиОрг,ДниПрочиеОрг,НачисленоОрг,ОтработаноДнейОрг", ",") Цикл
		ТЗ.Колонки.Добавить(Имя, ТипЧисло);
	КонецЦикла;
	Возврат ТЗ;

КонецФункции

// Строка = сотрудник Свода × организация ЗУП: куда ушли дни/часы, начисления по организации, приём/увольнение в ней.
Функция СформироватьСводОрг(Свод, ДанныеЗУП, НачалоПериода)

	Результат = НоваяТаблицаСводОрг();
	Если НЕ ДанныеЗУП.Доступен Тогда
		Возврат Результат;
	КонецЕсли;

	ВремяПоОрг = СвернутьВремяЗУП(ДанныеЗУП.Время, Истина);
	НачисленияПоОрг = СвернутьНачисленияЗУП(ДанныеЗУП.Начисления, Истина);
	КадрыПоОрг = СвернутьКадрыЗУП(ДанныеЗУП.Сотрудники, Истина);

	// организации по ДРФО из трёх источников
	ОргПоДРФО = Новый Соответствие;
	Источники = Новый Массив;
	Источники.Добавить(ВремяПоОрг);
	Источники.Добавить(НачисленияПоОрг);
	Источники.Добавить(КадрыПоОрг);
	Для Каждого Источник Из Источники Цикл
		Для Каждого КлючЗначение Из Источник Цикл
			Части = СтрРазделить(КлючЗначение.Ключ, "|");
			Если Части.Количество() < 2 Тогда
				Продолжить;
			КонецЕсли;
			Орги = ОргПоДРФО[Части[0]];
			Если Орги = Неопределено Тогда
				Орги = Новый СписокЗначений;
				ОргПоДРФО.Вставить(Части[0], Орги);
			КонецЕсли;
			Если Орги.НайтиПоЗначению(Части[1]) = Неопределено Тогда
				Орги.Добавить(Части[1]);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого СтрСвода Из Свод Цикл
		Если СтрСвода.ИНН = "" Тогда
			Продолжить;
		КонецЕсли;
		Орги = ОргПоДРФО[СтрСвода.ИНН];
		Если Орги = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Орги.СортироватьПоЗначению();
		Для Каждого ЭлементОрг Из Орги Цикл
			Ключ = СтрСвода.ИНН + "|" + ЭлементОрг.Значение;
			// Организация, где человек уволен до периода и по которой в периоде нет времени и начислений, не показывается
			КОрг = КадрыПоОрг[Ключ];
			СвОрг = ВремяПоОрг[Ключ];
			НОрг = НачисленияПоОрг[Ключ];
			ЕстьДанныеВПериоде = (СвОрг <> Неопределено) ИЛИ (НОрг <> Неопределено И НОрг.Начислено <> 0);
			Актуальна = (КОрг <> Неопределено И КОрг.Актуален);
			УволенВПериоде = (КОрг <> Неопределено И ЗначениеЗаполнено(КОрг.ДатаУвольнения) И КОрг.ДатаУвольнения >= НачалоПериода);
			Если НЕ Актуальна И НЕ ЕстьДанныеВПериоде И НЕ УволенВПериоде Тогда
				Продолжить;
			КонецЕсли;
			Стр = Результат.Добавить();
			Стр.ИННО = СтрСвода.ИНН;
			Стр.ФИОО = СтрСвода.ФИО;
			Стр.ОрганизацияЗУПО = ЭлементОрг.Значение;
			К = КадрыПоОрг[Ключ];
			Если К <> Неопределено Тогда
				Стр.ВидДоговораОрг = ?(К.Трудовой, "Трудовой", "") + ?(К.ЕстьГПХ, ?(К.Трудовой, " + ГПХ", "ГПХ"), "");
				Стр.АктуаленОрг = К.Актуален;
				Стр.ДатаПриемаОрг = К.ДатаПриема;
				Стр.ДатаУвольненияОрг = К.ДатаУвольнения;
				Стр.ИсточникПриемаОрг = СокрЛП(ПометкаИсточникаПриема(К.ИсточникПриема));
			КонецЕсли;
			Св = ВремяПоОрг[Ключ];
			Если Св <> Неопределено Тогда
				Стр.ДниРаботаОрг = Св.Даты["Работа"].Количество();
				Стр.ЧасыРаботаОрг = Св.ЧасыРабота;
				Стр.ДниОтпускОрг = Св.Даты["Отпуск"].Количество();
				Стр.ДниБольничныйОрг = Св.Даты["Больничный"].Количество();
				Стр.ДниБезОплатыОрг = Св.Даты["БезОплаты"].Количество();
				Стр.ДниКомандировкаОрг = Св.Даты["Командировка"].Количество();
				Стр.ДниНеявкиОрг = Св.Даты["Неявки"].Количество();
				Стр.ДниПрочиеОрг = Св.Даты["Прочие"].Количество();
			КонецЕсли;
			Н = НачисленияПоОрг[Ключ];
			Если Н <> Неопределено Тогда
				Стр.НачисленоОрг = Н.Начислено;
				Стр.ОтработаноДнейОрг = Н.ОтработаноДней;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

