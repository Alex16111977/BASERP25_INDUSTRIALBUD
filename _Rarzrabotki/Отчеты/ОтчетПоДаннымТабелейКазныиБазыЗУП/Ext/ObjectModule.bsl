// РегистрНакопления.РабочееВремяРаботниковОрганизаций по дням и видам времени (БуквенныйКод).
// Дата разложена на Год/Месяц/День, чтобы не тащить дату через COM.
Функция ПолучитьВремяЗУП(V83, НачалоПериода, КонецПериода)

	Результат = НоваяТаблицаВремяЗУП();

	ЗапросЗУП = V83.NewObject("Запрос");
	ЗапросЗУП.УстановитьПараметр("НачалоПериода", НачалоПериода);
	ЗапросЗУП.УстановитьПараметр("КонецПериода", КонецПериода);
	ЗапросЗУП.Текст =
	"ВЫБРАТЬ
	|	РВ.Сотрудник.Физлицо.КодПоДРФО КАК ДРФО,
	|	РВ.Сотрудник.Физлицо.Наименование КАК ФИО,
	|	РВ.Организация.Наименование КАК Организация,
	|	ГОД(РВ.Период) КАК Год,
	|	МЕСЯЦ(РВ.Период) КАК Месяц,
	|	ДЕНЬ(РВ.Период) КАК День,
	|	РВ.ВидИспользованияРабочегоВремени.БуквенныйКод КАК Код,
	|	РВ.ВидИспользованияРабочегоВремени.РабочееВремя КАК РабочееВремя,
	|	СУММА(РВ.Дней) КАК Дней,
	|	СУММА(РВ.Часов) КАК Часов
	|ИЗ
	|	РегистрНакопления.РабочееВремяРаботниковОрганизаций КАК РВ
	|ГДЕ
	|	РВ.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И РВ.Активность
	|СГРУППИРОВАТЬ ПО
	|	РВ.Сотрудник.Физлицо.КодПоДРФО,
	|	РВ.Сотрудник.Физлицо.Наименование,
	|	РВ.Организация.Наименование,
	|	ГОД(РВ.Период),
	|	МЕСЯЦ(РВ.Период),
	|	ДЕНЬ(РВ.Период),
	|	РВ.ВидИспользованияРабочегоВремени.БуквенныйКод,
	|	РВ.ВидИспользованияРабочегоВремени.РабочееВремя";

	Выборка = ЗапросЗУП.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр = Результат.Добавить();
		Стр.ДРФО = СокрЛП(Выборка.ДРФО);
		Стр.ФИО = СокрЛП(Выборка.ФИО);
		Стр.Организация = СокрЛП(Выборка.Организация);
		Стр.Дата = Дата(Выборка.Год, Выборка.Месяц, Выборка.День);
		Стр.Код = НРег(СокрЛП(Выборка.Код));
		Стр.РабочееВремя = (Выборка.РабочееВремя = Истина);
		Стр.Дней = Выборка.Дней;
		Стр.Часов = Выборка.Часов;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// РегистрРасчета.ОсновныеНачисленияРаботниковОрганизаций за период регистрации, свёртка по ДРФО.
Функция ПолучитьНачисленияЗУП(V83, НачалоПериода, КонецПериода)

	Результат = НоваяТаблицаНачисленияЗУП();

	ЗапросЗУП = V83.NewObject("Запрос");
	ЗапросЗУП.УстановитьПараметр("НачалоПериода", НачалоПериода);
	ЗапросЗУП.УстановитьПараметр("КонецПериода", КонецПериода);
	ЗапросЗУП.Текст =
	"ВЫБРАТЬ
	|	Н.Сотрудник.Физлицо.КодПоДРФО КАК ДРФО,
	|	Н.Сотрудник.Физлицо.Наименование КАК ФИО,
	|	СУММА(Н.Результат) КАК Начислено,
	|	СУММА(Н.ОтработаноДней) КАК ОтработаноДней,
	|	МАКСИМУМ(Н.НормаДней) КАК НормаДней
	|ИЗ
	|	РегистрРасчета.ОсновныеНачисленияРаботниковОрганизаций КАК Н
	|ГДЕ
	|	Н.ПериодРегистрации МЕЖДУ &НачалоПериода И &КонецПериода
	|СГРУППИРОВАТЬ ПО
	|	Н.Сотрудник.Физлицо.КодПоДРФО,
	|	Н.Сотрудник.Физлицо.Наименование";

	Выборка = ЗапросЗУП.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр = Результат.Добавить();
		Стр.ДРФО = СокрЛП(Выборка.ДРФО);
		Стр.ФИО = СокрЛП(Выборка.ФИО);
		Стр.Начислено = Выборка.Начислено;
		Стр.ОтработаноДней = Выборка.ОтработаноДней;
		Стр.НормаДней = Выборка.НормаДней;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Множество ДРФО актуальных сотрудников ЗУП (Справочник.СотрудникиОрганизаций.Актуальность).
Функция ПолучитьАктуальныхЗУП(V83)

	Результат = Новый Соответствие;

	ЗапросЗУП = V83.NewObject("Запрос");
	ЗапросЗУП.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	С.Физлицо.КодПоДРФО КАК ДРФО
	|ИЗ
	|	Справочник.СотрудникиОрганизаций КАК С
	|ГДЕ
	|	НЕ С.ПометкаУдаления
	|	И С.Актуальность
	|	И С.Физлицо.КодПоДРФО <> """"";

	Выборка = ЗапросЗУП.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(СокрЛП(Выборка.ДРФО), Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Свод

Функция НоваяТаблицаСвод()

	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипЧисло = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2));
	ТипБулево = Новый ОписаниеТипов("Булево");

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	ТЗ.Колонки.Добавить("ФИО", ТипСтрока);
	ТЗ.Колонки.Добавить("ИНН", ТипСтрока);
	ТЗ.Колонки.Добавить("Трудоустроен", ТипБулево);
	ТЗ.Колонки.Добавить("ЕстьТабельКазны", ТипБулево);
	ТЗ.Колонки.Добавить("ОрганизацииКазны", ТипСтрока);
	ТЗ.Колонки.Добавить("ПодразделенияКазны", ТипСтрока);
	// Казна
	Для Каждого Имя Из СтрРазделить("ДниР,ЧасыР,ДниМ,ЧасыМ,ДниО,ДниБ,ДниС,ДниК,ДниН,ДниВ,ДниД,ДниОшибка,ЧасыПлан", ",") Цикл
		ТЗ.Колонки.Добавить(Имя, ТипЧисло);
	КонецЦикла;
	// ЗУП
	ТЗ.Колонки.Добавить("ФИОЗУП", ТипСтрока);
	ТЗ.Колонки.Добавить("ОрганизацияЗУП", ТипСтрока);
	ТЗ.Колонки.Добавить("АктуаленВЗУП", ТипБулево);
	Для Каждого Имя Из СтрРазделить("ДниРаботаЗУП,ЧасыРаботаЗУП,ДниОтпускЗУП,ДниБольничныйЗУП,ДниБезОплатыЗУП,ДниКомандировкаЗУП,ДниНеявкиЗУП,ДниПрочиеЗУП,НачисленоЗУП,ОтработаноДнейЗУП,НормаДнейЗУП", ",") Цикл
		ТЗ.Колонки.Добавить(Имя, ТипЧисло);
	КонецЦикла;
	// Контроль
	ТЗ.Колонки.Добавить("Контроль", ТипСтрока);
	Для Каждого Имя Из СтрРазделить("НетФлагаТрудоустроен,НетНачисленийЗУП,НеПротабелированВЗУП,БольничныйНеВЗУП,ОтпускНеВЗУП,ЗаСвойСчетНеВЗУП,НетИНН,ДубльИНН,НетТабеляКазны,ЕстьКонтроль", ",") Цикл
		ТЗ.Колонки.Добавить(Имя, ТипБулево);
	КонецЦикла;
	ТЗ.Колонки.Добавить("РасхождениеДней", ТипЧисло);
	Возврат ТЗ;

КонецФункции

// Ключ сотрудника Казны: ИНН, если он есть, иначе уникальный идентификатор ссылки.
Функция КлючСотрудникаКазны(Сотрудник, ИНН)
	Если ЗначениеЗаполнено(СокрЛП(ИНН)) Тогда
		Возврат "И:" + СокрЛП(ИНН);
	КонецЕсли;
	Возврат "К:" + Строка(Сотрудник.УникальныйИдентификатор());
КонецФункции

Функция КатегорияКодаЗУП(Код, РабочееВремя)
	Если РабочееВремя Тогда
		Возврат "Работа";
	ИначеЕсли СтрНайти(",в,д,дб,тв,ч,до,", "," + Код + ",") > 0 Тогда
		Возврат "Отпуск";
	ИначеЕсли СтрНайти(",тн,нн,", "," + Код + ",") > 0 Тогда
		Возврат "Больничный";
	ИначеЕсли СтрНайти(",на,бз,", "," + Код + ",") > 0 Тогда
		Возврат "БезОплаты";
	ИначеЕсли СтрНайти(",нз,пр,ін,і,ів,", "," + Код + ",") > 0 Тогда
		Возврат "Неявки";
	КонецЕсли;
	Возврат "Прочие";
КонецФункции

Процедура ОтметитьДень(ДниСотрудника, Состояние, Дата)
	Дни = ДниСотрудника[Состояние];
	Если Дни = Неопределено Тогда
		Дни = Новый Соответствие;
		ДниСотрудника.Вставить(Состояние, Дни);
	КонецЕсли;
	Дни.Вставить(Дата, Истина);
КонецПроцедуры

Функция КоличествоДней(ДниСотрудника, Состояние)
	Дни = ДниСотрудника[Состояние];
	Возврат ?(Дни = Неопределено, 0, Дни.Количество());
КонецФункции

Функция СтрокаИзМножества(Множество)
	Массив = Новый Массив;
	Для Каждого КлючЗначение Из Множество Цикл
		Массив.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	Возврат СтрСоединить(Массив, ", ");
КонецФункции

// Свёртка ЗУП по ДРФО: Соответствие ДРФО -> Структура с днями/часами по категориям, ФИО, организациями.
Функция СвернутьВремяЗУП(ТаблицаВремя)

	Результат = Новый Соответствие;
	Для Каждого Стр Из ТаблицаВремя Цикл
		Если Стр.ДРФО = "" Тогда
			Продолжить;
		КонецЕсли;
		Св = Результат[Стр.ДРФО];
		Если Св = Неопределено Тогда
			Св = Новый Структура("ФИО, Организации, ДниРабота, ЧасыРабота, ДниОтпуск, ДниБольничный, ДниБезОплаты, ДниКомандировка, ДниНеявки, ДниПрочие, ДниВсего",
				Стр.ФИО, Новый Соответствие, 0, 0, 0, 0, 0, 0, 0, 0, 0);
			Результат.Вставить(Стр.ДРФО, Св);
		КонецЕсли;
		Св.Организации.Вставить(Стр.Организация, Истина);
		Св.ДниВсего = Св.ДниВсего + Стр.Дней;
		Категория = КатегорияКодаЗУП(Стр.Код, Стр.РабочееВремя);
		Если Категория = "Работа" Тогда
			Св.ДниРабота = Св.ДниРабота + Стр.Дней;
			Св.ЧасыРабота = Св.ЧасыРабота + Стр.Часов;
			Если Стр.Код = "вд" Тогда
				Св.ДниКомандировка = Св.ДниКомандировка + Стр.Дней;
			КонецЕсли;
		ИначеЕсли Категория = "Отпуск" Тогда
			Св.ДниОтпуск = Св.ДниОтпуск + Стр.Дней;
		ИначеЕсли Категория = "Больничный" Тогда
			Св.ДниБольничный = Св.ДниБольничный + Стр.Дней;
		ИначеЕсли Категория = "БезОплаты" Тогда
			Св.ДниБезОплаты = Св.ДниБезОплаты + Стр.Дней;
		ИначеЕсли Категория = "Неявки" Тогда
			Св.ДниНеявки = Св.ДниНеявки + Стр.Дней;
		Иначе
			Св.ДниПрочие = Св.ДниПрочие + Стр.Дней;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СформироватьСвод(ДанныеКазны, ДанныеЗУП, ТолькоТрудоустроенные, ПоказыватьЗУПБезТабеля)

	Свод = НоваяТаблицаСвод();
	СтрокиПоКлючу = Новый Соответствие;
	ДниПоКлючу = Новый Соответствие;
	ОрганизацииПоКлючу = Новый Соответствие;
	ПодразделенияПоКлючу = Новый Соответствие;
	СотрудникиПоКлючу = Новый Соответствие;

	// 1. Казна
	Для Каждого СтрК Из ДанныеКазны Цикл
		Ключ = КлючСотрудникаКазны(СтрК.Сотрудник, СтрК.ИНН);
		Стр = СтрокиПоКлючу[Ключ];
		Если Стр = Неопределено Тогда
			Стр = Свод.Добавить();
			Стр.Сотрудник = СтрК.Сотрудник;
			Стр.ФИО = СтрК.ФИО;
			Стр.ИНН = СокрЛП(СтрК.ИНН);
			Стр.Трудоустроен = (СтрК.Трудоустроен = Истина);
			Стр.ЕстьТабельКазны = Истина;
			СтрокиПоКлючу.Вставить(Ключ, Стр);
			ДниПоКлючу.Вставить(Ключ, Новый Соответствие);
			ОрганизацииПоКлючу.Вставить(Ключ, Новый Соответствие);
			ПодразделенияПоКлючу.Вставить(Ключ, Новый Соответствие);
			СотрудникиПоКлючу.Вставить(Ключ, Новый Соответствие);
		КонецЕсли;
		// Дубли одного ИНН в справочнике Казны сливаются в одну строку: Трудоустроен = ИЛИ по всем записям
		СотрудникиПоКлючу[Ключ].Вставить(СтрК.Сотрудник, Истина);
		Стр.Трудоустроен = Стр.Трудоустроен ИЛИ (СтрК.Трудоустроен = Истина);
		ОрганизацииПоКлючу[Ключ].Вставить(СтрК.Организация, Истина);
		Если ЗначениеЗаполнено(СтрК.Подразделение) Тогда
			ПодразделенияПоКлючу[Ключ].Вставить(СтрК.Подразделение, Истина);
		КонецЕсли;
		Стр.ЧасыПлан = Стр.ЧасыПлан + СтрК.ЧасыПлан;
		Состояние = СокрЛП(СтрК.Состояние);
		Если Состояние = "Р" Тогда
			Если СтрК.ЧасыФакт > 0 Тогда
				Стр.ЧасыР = Стр.ЧасыР + СтрК.ЧасыФакт;
				ОтметитьДень(ДниПоКлючу[Ключ], "Р", СтрК.Дата);
			КонецЕсли;
		ИначеЕсли Состояние = "М" Тогда
			Стр.ЧасыМ = Стр.ЧасыМ + СтрК.ЧасыОфициальные;
			ОтметитьДень(ДниПоКлючу[Ключ], "М", СтрК.Дата);
		ИначеЕсли Состояние <> "" Тогда
			ОтметитьДень(ДниПоКлючу[Ключ], Состояние, СтрК.Дата);
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючЗначение Из СтрокиПоКлючу Цикл
		Ключ = КлючЗначение.Ключ;
		Стр = КлючЗначение.Значение;
		Дни = ДниПоКлючу[Ключ];
		Стр.ДниР = КоличествоДней(Дни, "Р");
		Стр.ДниМ = КоличествоДней(Дни, "М");
		Стр.ДниО = КоличествоДней(Дни, "О");
		Стр.ДниБ = КоличествоДней(Дни, "Б");
		Стр.ДниС = КоличествоДней(Дни, "С");
		Стр.ДниК = КоличествоДней(Дни, "К");
		Стр.ДниН = КоличествоДней(Дни, "Н");
		Стр.ДниВ = КоличествоДней(Дни, "В");
		Стр.ДниД = КоличествоДней(Дни, "Д");
		Стр.ДниОшибка = КоличествоДней(Дни, "?");
		Стр.ОрганизацииКазны = СтрокаИзМножества(ОрганизацииПоКлючу[Ключ]);
		Стр.ПодразделенияКазны = СтрокаИзМножества(ПодразделенияПоКлючу[Ключ]);
		Стр.ДубльИНН = (СотрудникиПоКлючу[Ключ].Количество() > 1);
	КонецЦикла;

	// 2. ЗУП
	ВремяПоДРФО = СвернутьВремяЗУП(ДанныеЗУП.Время);
	НачисленияПоДРФО = Новый Соответствие;
	Для Каждого СтрН Из ДанныеЗУП.Начисления Цикл
		Если СтрН.ДРФО <> "" Тогда
			НачисленияПоДРФО.Вставить(СтрН.ДРФО, СтрН);
		КонецЕсли;
	КонецЦикла;

	ДРФОБезТабеля = Новый Соответствие;
	Для Каждого КлючЗначение Из ВремяПоДРФО Цикл
		Если СтрокиПоКлючу["И:" + КлючЗначение.Ключ] = Неопределено Тогда
			ДРФОБезТабеля.Вставить(КлючЗначение.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючЗначение Из НачисленияПоДРФО Цикл
		Если СтрокиПоКлючу["И:" + КлючЗначение.Ключ] = Неопределено И КлючЗначение.Значение.Начислено <> 0 Тогда
			ДРФОБезТабеля.Вставить(КлючЗначение.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

	Если ПоказыватьЗУПБезТабеля И ДанныеЗУП.Доступен Тогда
		Для Каждого КлючЗначение Из ДРФОБезТабеля Цикл
			ДРФО = КлючЗначение.Ключ;
			Стр = Свод.Добавить();
			Стр.ИНН = ДРФО;
			Стр.ЕстьТабельКазны = Ложь;
			Св = ВремяПоДРФО[ДРФО];
			Н = НачисленияПоДРФО[ДРФО];
			Если Св <> Неопределено Тогда
				Стр.ФИО = Св.ФИО;
			ИначеЕсли Н <> Неопределено Тогда
				Стр.ФИО = Н.ФИО;
			Иначе
				Стр.ФИО = ДРФО;
			КонецЕсли;
			СтрокиПоКлючу.Вставить("З:" + ДРФО, Стр);
		КонецЦикла;
	КонецЕсли;

	// 3. Присоединение ЗУП и контроль
	Для Каждого Стр Из Свод Цикл
		ДРФО = Стр.ИНН;
		Св = ?(ДРФО = "", Неопределено, ВремяПоДРФО[ДРФО]);
		Н = ?(ДРФО = "", Неопределено, НачисленияПоДРФО[ДРФО]);
		Если Св <> Неопределено Тогда
			Стр.ФИОЗУП = Св.ФИО;
			Стр.ОрганизацияЗУП = СтрокаИзМножества(Св.Организации);
			Стр.ДниРаботаЗУП = Св.ДниРабота;
			Стр.ЧасыРаботаЗУП = Св.ЧасыРабота;
			Стр.ДниОтпускЗУП = Св.ДниОтпуск;
			Стр.ДниБольничныйЗУП = Св.ДниБольничный;
			Стр.ДниБезОплатыЗУП = Св.ДниБезОплаты;
			Стр.ДниКомандировкаЗУП = Св.ДниКомандировка;
			Стр.ДниНеявкиЗУП = Св.ДниНеявки;
			Стр.ДниПрочиеЗУП = Св.ДниПрочие;
		КонецЕсли;
		Если Н <> Неопределено Тогда
			Если Стр.ФИОЗУП = "" Тогда
				Стр.ФИОЗУП = Н.ФИО;
			КонецЕсли;
			Стр.НачисленоЗУП = Н.Начислено;
			Стр.ОтработаноДнейЗУП = Н.ОтработаноДней;
			Стр.НормаДнейЗУП = Н.НормаДней;
		КонецЕсли;
		Стр.АктуаленВЗУП = (ДРФО <> "" И ДанныеЗУП.АктуальныеДРФО[ДРФО] <> Неопределено);
		ЗаполнитьКонтроль(Стр, ДанныеЗУП.Доступен, Св <> Неопределено ИЛИ Н <> Неопределено);
	КонецЦикла;

	// 4. Фильтр «Только трудоустроенные» (строки только из ЗУП остаются)
	Если ТолькоТрудоустроенные Тогда
		Индекс = Свод.Количество() - 1;
		Пока Индекс >= 0 Цикл
			Стр = Свод[Индекс];
			Если Стр.ЕстьТабельКазны И НЕ Стр.Трудоустроен Тогда
				Свод.Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
	КонецЕсли;

	Свод.Сортировать("ФИО");
	Возврат Свод;

КонецФункции

Процедура ЗаполнитьКонтроль(Стр, ЗУПДоступен, ЕстьДанныеЗУП)

	Признаки = Новый Массив;
	ЕстьИНН = (Стр.ИНН <> "");
	// Сравнивать с ЗУП имеет смысл для трудоустроенных, для людей с часами «М» и для тех, кто есть в ЗУП
	СвязанСЗУП = ЕстьИНН И (Стр.Трудоустроен ИЛИ ЕстьДанныеЗУП ИЛИ Стр.АктуаленВЗУП ИЛИ Стр.ДниМ > 0);

	Стр.НетТабеляКазны = НЕ Стр.ЕстьТабельКазны;
	Если Стр.НетТабеляКазны Тогда
		Признаки.Добавить("В ЗУП есть, табеля Казны нет");
	КонецЕсли;

	Стр.НетИНН = Стр.ЕстьТабельКазны И НЕ ЕстьИНН И (Стр.Трудоустроен ИЛИ Стр.ДниМ > 0);
	Если Стр.НетИНН Тогда
		Признаки.Добавить("Нет ИНН, сверка с ЗУП невозможна");
	КонецЕсли;
	Если Стр.ДубльИНН Тогда
		Признаки.Добавить("Дубль ИНН в Казне");
	КонецЕсли;

	Если НЕ ЗУПДоступен Тогда
		Признаки.Добавить("ЗУП недоступен");
	ИначеЕсли Стр.ЕстьТабельКазны И ЕстьИНН Тогда
		Стр.НетФлагаТрудоустроен = НЕ Стр.Трудоустроен И (Стр.НачисленоЗУП <> 0 ИЛИ Стр.ДниРаботаЗУП > 0);
		Если Стр.НетФлагаТрудоустроен Тогда
			Признаки.Добавить("Нет флага «Трудоустроен», а в ЗУП есть начисления/время");
		КонецЕсли;
		Стр.НетНачисленийЗУП = Стр.Трудоустроен И Стр.НачисленоЗУП = 0;
		Если Стр.НетНачисленийЗУП Тогда
			Признаки.Добавить("Трудоустроен, но начислений в ЗУП нет");
		КонецЕсли;
		Если СвязанСЗУП Тогда
			Стр.НеПротабелированВЗУП = (Стр.ДниР + Стр.ДниМ > 0) И Стр.ДниРаботаЗУП = 0;
			Если Стр.НеПротабелированВЗУП Тогда
				Признаки.Добавить("Работал по Казне, в ЗУП рабочих дней нет");
			КонецЕсли;
			Стр.БольничныйНеВЗУП = Стр.ДниБ > 0 И Стр.ДниБольничныйЗУП = 0;
			Если Стр.БольничныйНеВЗУП Тогда
				Признаки.Добавить("Больничный (Б) не отражён в ЗУП");
			КонецЕсли;
			Стр.ОтпускНеВЗУП = Стр.ДниО > 0 И Стр.ДниОтпускЗУП = 0;
			Если Стр.ОтпускНеВЗУП Тогда
				Признаки.Добавить("Отпуск (О) не отражён в ЗУП");
			КонецЕсли;
			Стр.ЗаСвойСчетНеВЗУП = Стр.ДниС > 0 И Стр.ДниБезОплатыЗУП = 0;
			Если Стр.ЗаСвойСчетНеВЗУП Тогда
				Признаки.Добавить("За свой счёт (С) не отражён в ЗУП");
			КонецЕсли;
			Стр.РасхождениеДней = (Стр.ДниР + Стр.ДниМ + Стр.ДниК) - Стр.ДниРаботаЗУП;
		КонецЕсли;
	КонецЕсли;

	Стр.Контроль = СтрСоединить(Признаки, "; ");
	Стр.ЕстьКонтроль = Стр.НетТабеляКазны ИЛИ Стр.НетИНН ИЛИ Стр.ДубльИНН ИЛИ Стр.НетФлагаТрудоустроен
		ИЛИ Стр.НетНачисленийЗУП ИЛИ Стр.НеПротабелированВЗУП ИЛИ Стр.БольничныйНеВЗУП
		ИЛИ Стр.ОтпускНеВЗУП ИЛИ Стр.ЗаСвойСчетНеВЗУП;

КонецПроцедуры

#КонецОбласти

#Область ПоДням

Функция НоваяТаблицаПоДням()

	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипЧисло = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2));
	ТЗ = Новый ТаблицаЗначений;
	// Имена полей отличаются от набора «Свод»: одноимённые поля двух несвязанных наборов СКД не допускает
	ТЗ.Колонки.Добавить("СотрудникД", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	ТЗ.Колонки.Добавить("ФИОД", ТипСтрока);
	ТЗ.Колонки.Добавить("ИННД", ТипСтрока);
	ТЗ.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТЗ.Колонки.Добавить("ЗначениеКазны", ТипСтрока);
	ТЗ.Колонки.Добавить("СостояниеКазны", ТипСтрока);
	ТЗ.Колонки.Добавить("ЧасыКазны", ТипЧисло);
	ТЗ.Колонки.Добавить("КодЗУП", ТипСтрока);
	ТЗ.Колонки.Добавить("ЧасыЗУП", ТипЧисло);
	ТЗ.Колонки.Добавить("ДнейЗУП", ТипЧисло);
	ТЗ.Колонки.Добавить("Расхождение", ТипСтрока);
	Возврат ТЗ;

КонецФункции

Функция ФорматЧасов(Часы)
	Если Часы = Цел(Часы) Тогда
		Возврат Формат(Часы, "ЧДЦ=0; ЧН=0; ЧГ=0");
	КонецЕсли;
	Возврат Формат(Часы, "ЧДЦ=1; ЧН=0; ЧГ=0");
КонецФункции

// Строка = сотрудник Свода × день. Казна: значение ячейки и часы; ЗУП: коды и часы того же дня.
Функция СформироватьПоДням(ДанныеКазны, ДанныеЗУП, Свод)

	Результат = НоваяТаблицаПоДням();

	// Сотрудники Свода: по ключу Казны и по ИНН (для строк ЗУП)
	СводПоКлючу = Новый Соответствие;
	СводПоИНН = Новый Соответствие;
	Для Каждого Стр Из Свод Цикл
		Если Стр.ЕстьТабельКазны Тогда
			СводПоКлючу.Вставить(КлючСотрудникаКазны(Стр.Сотрудник, Стр.ИНН), Стр);
		КонецЕсли;
		Если Стр.ИНН <> "" Тогда
			СводПоИНН.Вставить(Стр.ИНН, Стр);
		КонецЕсли;
	КонецЦикла;

	Дни = Новый Соответствие; // Ключ(Свод) -> Соответствие(Дата -> Структура)

	Для Каждого СтрК Из ДанныеКазны Цикл
		Ключ = КлючСотрудникаКазны(СтрК.Сотрудник, СтрК.ИНН);
		СтрСвода = СводПоКлючу[Ключ];
		Если СтрСвода = Неопределено Тогда
			Продолжить; // отфильтрован
		КонецЕсли;
		Состояние = СокрЛП(СтрК.Состояние);
		Если Состояние = "" ИЛИ (Состояние = "Р" И СтрК.ЧасыФакт = 0) Тогда
			Продолжить; // только план или пустая ячейка
		КонецЕсли;
		День = ДеньСотрудника(Дни, СтрСвода, СтрК.Дата);
		Если Состояние = "Р" Тогда
			День.ЗначенияКазны.Добавить(ФорматЧасов(СтрК.ЧасыФакт));
			День.ЧасыКазны = День.ЧасыКазны + СтрК.ЧасыФакт;
		ИначеЕсли Состояние = "М" Тогда
			День.ЗначенияКазны.Добавить(ФорматЧасов(СтрК.ЧасыОфициальные) + "М");
			День.ЧасыКазны = День.ЧасыКазны + СтрК.ЧасыОфициальные;
		Иначе
			День.ЗначенияКазны.Добавить(Состояние);
		КонецЕсли;
		День.СостоянияКазны.Вставить(Состояние, Истина);
	КонецЦикла;

	Для Каждого СтрЗ Из ДанныеЗУП.Время Цикл
		СтрСвода = ?(СтрЗ.ДРФО = "", Неопределено, СводПоИНН[СтрЗ.ДРФО]);
		Если СтрСвода = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		День = ДеньСотрудника(Дни, СтрСвода, СтрЗ.Дата);
		День.КодыЗУП.Вставить(СтрЗ.Код, Истина);
		День.ЧасыЗУП = День.ЧасыЗУП + СтрЗ.Часов;
		День.ДнейЗУП = День.ДнейЗУП + СтрЗ.Дней;
		Категория = КатегорияКодаЗУП(СтрЗ.Код, СтрЗ.РабочееВремя);
		Если Категория = "Работа" Тогда
			День.РаботаЗУП = Истина;
		ИначеЕсли Категория = "Больничный" Тогда
			День.БольничныйЗУП = Истина;
		ИначеЕсли Категория = "Отпуск" Тогда
			День.ОтпускЗУП = Истина;
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючСотрудник Из Дни Цикл
		Для Каждого КлючДень Из КлючСотрудник.Значение Цикл
			День = КлючДень.Значение;
			СтрСвода = День.СтрСвода;
			Стр = Результат.Добавить();
			Стр.СотрудникД = СтрСвода.Сотрудник;
			Стр.ФИОД = СтрСвода.ФИО;
			Стр.ИННД = СтрСвода.ИНН;
			Стр.Дата = КлючДень.Ключ;
			Стр.ЗначениеКазны = СтрСоединить(День.ЗначенияКазны, "/");
			Стр.СостояниеКазны = СтрокаИзМножества(День.СостоянияКазны);
			Стр.ЧасыКазны = День.ЧасыКазны;
			Стр.КодЗУП = СтрокаИзМножества(День.КодыЗУП);
			Стр.ЧасыЗУП = День.ЧасыЗУП;
			Стр.ДнейЗУП = День.ДнейЗУП;
			Стр.Расхождение = РасхождениеДня(День, СтрСвода, ДанныеЗУП.Доступен);
		КонецЦикла;
	КонецЦикла;

	Результат.Сортировать("ФИОД, Дата");
	Возврат Результат;

КонецФункции

Функция ДеньСотрудника(Дни, СтрСвода, Дата)
	КлючСотрудника = ?(СтрСвода.ЕстьТабельКазны, КлючСотрудникаКазны(СтрСвода.Сотрудник, СтрСвода.ИНН), "З:" + СтрСвода.ИНН);
	ДниСотрудника = Дни[КлючСотрудника];
	Если ДниСотрудника = Неопределено Тогда
		ДниСотрудника = Новый Соответствие;
		Дни.Вставить(КлючСотрудника, ДниСотрудника);
	КонецЕсли;
	День = ДниСотрудника[Дата];
	Если День = Неопределено Тогда
		День = Новый Структура("СтрСвода, ЗначенияКазны, СостоянияКазны, ЧасыКазны, КодыЗУП, ЧасыЗУП, ДнейЗУП, РаботаЗУП, БольничныйЗУП, ОтпускЗУП",
			СтрСвода, Новый Массив, Новый Соответствие, 0, Новый Соответствие, 0, 0, Ложь, Ложь, Ложь);
		ДниСотрудника.Вставить(Дата, День);
	КонецЕсли;
	Возврат День;
КонецФункции

Функция РасхождениеДня(День, СтрСвода, ЗУПДоступен)

	Если НЕ ЗУПДоступен ИЛИ СтрСвода.ИНН = "" Тогда
		Возврат "";
	КонецЕсли;
	СвязанСЗУП = СтрСвода.Трудоустроен ИЛИ СтрСвода.АктуаленВЗУП ИЛИ СтрСвода.НачисленоЗУП <> 0 ИЛИ СтрСвода.ДниРаботаЗУП > 0 ИЛИ СтрСвода.ДниМ > 0;
	Если НЕ СвязанСЗУП Тогда
		Возврат "";
	КонецЕсли;

	РаботалКазна = (День.ЧасыКазны > 0) ИЛИ (День.СостоянияКазны["М"] <> Неопределено) ИЛИ (День.СостоянияКазны["К"] <> Неопределено);
	Если РаботалКазна И НЕ День.РаботаЗУП Тогда
		Возврат "Казна: работал, ЗУП: " + ?(День.КодыЗУП.Количество() = 0, "нет", СтрокаИзМножества(День.КодыЗУП));
	КонецЕсли;
	// Пустой день в Казне расхождением не считается (Казна табелирует не всех и не каждый день);
	// расхождение — когда в Казне стоит явная отметка (Н, Б, О, С, В, Д), а ЗУП считает день рабочим.
	Если День.РаботаЗУП И НЕ РаботалКазна И День.СостоянияКазны.Количество() > 0 Тогда
		Возврат "ЗУП: работал, Казна: " + СтрокаИзМножества(День.СостоянияКазны);
	КонецЕсли;
	Если День.СостоянияКазны["Б"] <> Неопределено И НЕ День.БольничныйЗУП Тогда
		Возврат "Больничный только в Казне";
	КонецЕсли;
	Если День.СостоянияКазны["О"] <> Неопределено И НЕ День.ОтпускЗУП Тогда
		Возврат "Отпуск только в Казне";
	КонецЕсли;
	Возврат "";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеПараметраНастроек(Настройки, ИмяПараметра, ЗначениеПоУмолчанию)
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(ИмяПараметра));
	Если Параметр = Неопределено ИЛИ НЕ Параметр.Использование Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат Параметр.Значение;
КонецФункции

Функция ПолучитьТаблицуКоманд()
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
КонецПроцедуры

#КонецОбласти

#КонецЕсли
