#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Отчёт «Табели Казны и ЗУП» (база kazna).
// Сверяет регистр ДанныеТабелирования (Казна) с базой zup (БАС ЗУП 2.1):
//   РегистрНакопления.РабочееВремяРаботниковОрганизаций (дни/часы по видам времени, по дням)
//   РегистрРасчета.ОсновныеНачисленияРаботниковОрганизаций (начисления, отработано дней, норма)
// Ключ связи: Казна Сотрудники.ИНН = ЗУП ФизическиеЛица.КодПоДРФО.
// Из ЗУП через COM читаются только строки и числа (дата разложена на Год/Месяц/День).
// Наборы данных СКД (объекты): Свод (строка = сотрудник) и ПоДням (сотрудник × день).

#Область ОбработчикиСобытий

// Регистрация в подсистеме «Дополнительные отчеты и обработки» (БСП).
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	МассивНазначений = Новый Массив;
	МассивНазначений.Добавить("");

	ИмяОтчета = Метаданные().Представление();

	ПараметрыРегистрации.Вставить("Вид", "ДополнительныйОтчет");
	ПараметрыРегистрации.Вставить("Назначение", МассивНазначений);
	ПараметрыРегистрации.Вставить("Наименование", ИмяОтчета);
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	// COM-подключение к ЗУП невозможно в безопасном режиме
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"Сверка табелей Казны с базой ЗУП по сотрудникам и по дням: дни и часы по состояниям, больничные, отпуска, начисления, флаг «Трудоустроен».");

	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд, ИмяОтчета, Метаданные().ПолноеИмя(), "ОткрытиеФормы", Истина);
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);

	Возврат ПараметрыРегистрации;

КонецФункции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	УстановитьПривилегированныйРежим(Истина);

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();

	Период = ЗначениеПараметраНастроек(Настройки, "Период", Неопределено);
	НачалоПериода = Дата(1, 1, 1);
	КонецПериода = Дата(1, 1, 1);
	Если ТипЗнч(Период) = Тип("СтандартныйПериод") Тогда
		НачалоПериода = Период.ДатаНачала;
		КонецПериода = Период.ДатаОкончания;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(НачалоПериода) Тогда
		НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КонецПериода) Тогда
		КонецПериода = КонецМесяца(НачалоПериода);
	КонецЕсли;
	НачалоПериода = НачалоДня(НачалоПериода);
	КонецПериода = КонецДня(КонецПериода);

	ДанныеКазны = ПолучитьДанныеКазны(НачалоПериода, КонецПериода);

	ДанныеЗУП = НовыеДанныеЗУП();
	Попытка
		V83 = ПодключитьсяКЗУП();
		ДанныеЗУП.Время = ПолучитьВремяЗУП(V83, НачалоПериода, КонецПериода);
		ДанныеЗУП.Начисления = ПолучитьНачисленияЗУП(V83, НачалоПериода, КонецПериода);
		ДанныеЗУП.Сотрудники = ПолучитьСотрудниковЗУП(V83);
		ДанныеЗУП.Кадры = СвернутьКадрыЗУП(ДанныеЗУП.Сотрудники, Ложь);
		Для Каждого КлючЗначение Из ДанныеЗУП.Кадры Цикл
			Если КлючЗначение.Значение.Актуален Тогда
				ДанныеЗУП.АктуальныеДРФО.Вставить(КлючЗначение.Ключ, Истина);
			КонецЕсли;
		КонецЦикла;
		ДанныеЗУП.Доступен = Истина;
		V83 = Неопределено;
	Исключение
		ДанныеЗУП.Доступен = Ложь;
		ДанныеЗУП.ТекстОшибки = ОписаниеОшибки();
		Сообщить("Помилка отримання даних із ЗУП: " + ДанныеЗУП.ТекстОшибки);
	КонецПопытки;

	Свод = СформироватьСвод(ДанныеКазны, ДанныеЗУП);
	ПоДням = СформироватьПоДням(ДанныеКазны, ДанныеЗУП, Свод);

	СводОрг = СформироватьСводОрг(Свод, ДанныеЗУП, НачалоПериода);
	СводДок = СформироватьСводДок(Свод, ДанныеКазны);

	ВнешниеНаборыДанных = Новый Структура("Свод, СводОрг, СводДок, ПоДням", Свод, СводОрг, СводДок, ПоДням);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область Казна

// Физическая таблица регистра за период, свёртка по сотруднику, состоянию и дню.
// Период движений регистра стоит на 23:59:59 дня, поэтому границы — НачалоДня/КонецДня.
Функция ПолучитьДанныеКазны(НачалоПериода, КонецПериода)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Сотрудник КАК Сотрудник,
	|	Т.Регистратор КАК Регистратор,
	|	Т.Сотрудник.Наименование КАК ФИО,
	|	Т.Сотрудник.ИНН КАК ИНН,
	|	Т.Сотрудник.Трудоустроен КАК Трудоустроен,
	|	Т.Организация.Наименование КАК Организация,
	|	Т.Подразделение.Наименование КАК Подразделение,
	|	Т.Состояние КАК Состояние,
	|	НАЧАЛОПЕРИОДА(Т.Период, ДЕНЬ) КАК Дата,
	|	СУММА(Т.ЧасыФакт) КАК ЧасыФакт,
	|	СУММА(Т.ЧасыОфициальные) КАК ЧасыОфициальные,
	|	СУММА(Т.ЧасыПлан) КАК ЧасыПлан
	|ИЗ
	|	РегистрНакопления.ДанныеТабелирования КАК Т
	|ГДЕ
	|	Т.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Т.Активность
	|СГРУППИРОВАТЬ ПО
	|	Т.Сотрудник,
	|	Т.Регистратор,
	|	Т.Сотрудник.Наименование,
	|	Т.Сотрудник.ИНН,
	|	Т.Сотрудник.Трудоустроен,
	|	Т.Организация.Наименование,
	|	Т.Подразделение.Наименование,
	|	Т.Состояние,
	|	НАЧАЛОПЕРИОДА(Т.Период, ДЕНЬ)";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

