
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	УстановитьПривилегированныйРежим(Истина);

	// Отримання параметрів з СКД
	ПараметрПериодОтчета = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Период").Значение;
	НачалоПериода = ПараметрПериодОтчета.ДатаНачала;
	КонецПериода = КонецДня(ПараметрПериодОтчета.ДатаОкончания);

	// =============================================
	// 1. ЗАЛИШКИ ERP (РегНакопления.ДенежныеСредстваУПодотчетныхЛиц)
	// =============================================
	ТаблицаЕРП = ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода);

	// =============================================
	// 2. ЗАЛИШКИ BUHBUD (COM + РегБух.Хозрасчетный, рах. 3721)
	// =============================================
	СтрокаПодключенияBuhBud = А_ПодключенияБазСервер.СтрокаПодключения("bas_industrialbud");
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияBuhBud));
	Исключение
		Сообщить("Помилка підключення до BuhBud: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ТаблицаBuhBud = ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода);

	// Звільнення COM-з'єднання
	V83 = Неопределено;
	V8 = Неопределено;

	// =============================================
	// 2.1. КОНВЕРТАЦІЯ BuhBud: А_ИдКод -> СправочникСсылка.ФизическиеЛица
	// =============================================
	ТаблицаBuhBud = КонвертироватьТЗ_BuhBud(ТаблицаBuhBud);

	// =============================================
	// 3. ОБ'ЄДНАННЯ та ПОРІВНЯННЯ по А_ИдКод
	// =============================================
	ТаблицаСравнение = ОбъединитьТаблицы(ТаблицаЕРП, ТаблицаBuhBud);

	// =============================================
	// 4. ПЕРЕДАЧА В СКД
	// =============================================
	ВнешниеНаборыДанных = Новый Структура("ПодОтчетные_Сравнение", ТаблицаСравнение);

	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// =====================================================================
// ЗАЛИШКИ ERP
// РегНакопления.ДенежныеСредстваУПодотчетныхЛиц.ОстаткиИОбороты
// Вимір: ПодотчетноеЛицо (ФизическиеЛица), ресурс: СуммаРегл
// =====================================================================
Функция ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	ТипСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("А_ИдКод", ТипСтрока);
	Результат.Колонки.Добавить("ФизическоеЛицо",
		Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	Результат.Колонки.Добавить("НачальныйОстаток_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("ОборотДт_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("ОборотКт_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("КонечныйОстаток_ЕРП", ТипЧисло);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ФЛ.Ссылка КАК ФизическоеЛицо,
	|	ФЛ.А_ИдКод КАК А_ИдКод,
	|	СУММА(Ост.СуммаРеглНачальныйОстаток) КАК НачальныйОстаток,
	|	СУММА(Ост.СуммаРеглПриход) КАК ОборотДт,
	|	СУММА(Ост.СуммаРеглРасход) КАК ОборотКт,
	|	СУММА(Ост.СуммаРеглКонечныйОстаток) КАК КонечныйОстаток
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваУПодотчетныхЛиц.ОстаткиИОбороты(
	|		&НачалоПериода,
	|		&КонецПериода,
	|		,
	|		,) КАК Ост
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФЛ
	|		ПО Ост.ПодотчетноеЛицо = ФЛ.Ссылка
	|ГДЕ
	|	(Ост.СуммаРеглКонечныйОстаток <> 0
	|		ИЛИ Ост.СуммаРеглПриход <> 0
	|		ИЛИ Ост.СуммаРеглРасход <> 0
	|		ИЛИ Ост.СуммаРеглНачальныйОстаток <> 0)
	|СГРУППИРОВАТЬ ПО
	|	ФЛ.Ссылка,
	|	ФЛ.А_ИдКод";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Сообщить("Помилка запиту залишків підзвітних осіб (ERP): " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		ИдКод = СокрЛП(Выборка.А_ИдКод);
		Если ПустаяСтрока(ИдКод) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.А_ИдКод = ИдКод;
		НоваяСтрока.ФизическоеЛицо = Выборка.ФизическоеЛицо;
		НоваяСтрока.НачальныйОстаток_ЕРП = Выборка.НачальныйОстаток;
		НоваяСтрока.ОборотДт_ЕРП = Выборка.ОборотДт;
		НоваяСтрока.ОборотКт_ЕРП = Выборка.ОборотКт;
		НоваяСтрока.КонечныйОстаток_ЕРП = Выборка.КонечныйОстаток;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// =====================================================================
// ЗАЛИШКИ BuhBud (COM)
// РегБух.Хозрасчетный.ОстаткиИОбороты (рах. 3721)
// Субконто1 = ФизическиеЛица, извлечение А_ИдКод
// ОстаткиИОбороты приймає ТІЛЬКИ 2 параметри!
// =====================================================================
Функция ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	ТипСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ФЛ_А_ИдКод", ТипСтрока);
	Результат.Колонки.Добавить("ФЛ_Наименование", ТипСтрока);
	Результат.Колонки.Добавить("НачальныйОстаток_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("ОборотДт_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("ОборотКт_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("КонечныйОстаток_BuhBud", ТипЧисло);

	// Фільтр по організаціях (А_ВБалансе = Істина)
	ЗапросОрганизаций = Новый Запрос;
	ЗапросОрганизаций.Текст =
	"ВЫБРАТЬ
	|	Организации.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.А_ВБалансе = ИСТИНА
	|	И Организации.КодПоЕДРПОУ <> """"";

	масКодПоЕДРПОУ_V83 = V83.NewObject("Массив");
	ВыборкаОрганизаций = ЗапросОрганизаций.Выполнить().Выбрать();
	Пока ВыборкаОрганизаций.Следующий() Цикл
		масКодПоЕДРПОУ_V83.Добавить(ВыборкаОрганизаций.КодПоЕДРПОУ);
	КонецЦикла;

	Если масКодПоЕДРПОУ_V83.Количество() = 0 Тогда
		Сообщить("Немає організацій з флагом А_ВБалансе!");
		Возврат Результат;
	КонецЕсли;

	// COM-запит до BuhBud: рахунок 3721, Субконто1 = ФизическиеЛица
	ЗапросBuhBud = V83.NewObject("Запрос");
	ЗапросBuhBud.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.ФизическиеЛица).А_ИдКод КАК ФЛ_А_ИдКод,
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.ФизическиеЛица).Наименование КАК ФЛ_Наименование,
	|	СУММА(Ост.СуммаНачальныйОстатокДт) КАК НачОстатокДт,
	|	СУММА(Ост.СуммаНачальныйОстатокКт) КАК НачОстатокКт,
	|	СУММА(Ост.СуммаОборотДт) КАК ОборотДт,
	|	СУММА(Ост.СуммаОборотКт) КАК ОборотКт,
	|	СУММА(Ост.СуммаКонечныйОстатокДт) КАК КонОстатокДт,
	|	СУММА(Ост.СуммаКонечныйОстатокКт) КАК КонОстатокКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|		&НачалоПериода,
	|		&КонецПериода) КАК Ост
	|ГДЕ
	|	Ост.Счет.Код = ""3721""
	|	И Ост.Субконто1 ССЫЛКА Справочник.ФизическиеЛица
	|	И Ост.Организация.КодПоЕДРПОУ В (&масКодПоЕДРПОУ)
	|	И (Ост.СуммаКонечныйОстатокДт <> 0 ИЛИ Ост.СуммаКонечныйОстатокКт <> 0
	|		ИЛИ Ост.СуммаОборотДт <> 0 ИЛИ Ост.СуммаОборотКт <> 0
	|		ИЛИ Ост.СуммаНачальныйОстатокДт <> 0 ИЛИ Ост.СуммаНачальныйОстатокКт <> 0)
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.ФизическиеЛица).А_ИдКод,
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.ФизическиеЛица).Наименование";

	ЗапросBuhBud.УстановитьПараметр("НачалоПериода", НачалоПериода);
	ЗапросBuhBud.УстановитьПараметр("КонецПериода", КонецПериода);
	ЗапросBuhBud.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);

	// Виконання та серіалізація через COM
	Попытка
		ТЗ = ЗапросBuhBud.Выполнить().Выгрузить();
		стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗ);
		ТаблицаBuhBud = ЗначениеИзСтрокиВнутр(стр_ТЗ);
	Исключение
		Сообщить("Помилка запиту залишків підзвітних осіб (BuhBud): " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	// Заповнення результату з обчисленням сальдо (Дт - Кт)
	Для Каждого СтрокаBuhBud Из ТаблицаBuhBud Цикл
		ИдКод = СокрЛП(СтрокаBuhBud.ФЛ_А_ИдКод);
		Если ПустаяСтрока(ИдКод) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.ФЛ_А_ИдКод = ИдКод;
		НоваяСтрока.ФЛ_Наименование = СокрЛП(СтрокаBuhBud.ФЛ_Наименование);
		НоваяСтрока.НачальныйОстаток_BuhBud = СтрокаBuhBud.НачОстатокДт - СтрокаBuhBud.НачОстатокКт;
		НоваяСтрока.ОборотДт_BuhBud = СтрокаBuhBud.ОборотДт;
		НоваяСтрока.ОборотКт_BuhBud = СтрокаBuhBud.ОборотКт;
		НоваяСтрока.КонечныйОстаток_BuhBud = СтрокаBuhBud.КонОстатокДт - СтрокаBuhBud.КонОстатокКт;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// =====================================================================
// КОНВЕРТАЦІЯ BuhBud: ФЛ_А_ИдКод -> СправочникСсылка.ФизическиеЛица
// Тимчасова таблиця + LEFT JOIN (як у звіті по товарах/ОС)
// =====================================================================
Функция КонвертироватьТЗ_BuhBud(ТаблицаBuhBud)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ.ФЛ_А_ИдКод,
	|	ВТ.ФЛ_Наименование,
	|	ВТ.НачальныйОстаток_BuhBud,
	|	ВТ.ОборотДт_BuhBud,
	|	ВТ.ОборотКт_BuhBud,
	|	ВТ.КонечныйОстаток_BuhBud
	|ПОМЕСТИТЬ ВТ_BuhBud
	|ИЗ
	|	&ТЗ КАК ВТ
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ФЛ_А_ИдКод КАК А_ИдКод,
	|	ВТ.ФЛ_Наименование,
	|	ФЛ.Ссылка КАК ФизическоеЛицо,
	|	ВТ.НачальныйОстаток_BuhBud,
	|	ВТ.ОборотДт_BuhBud,
	|	ВТ.ОборотКт_BuhBud,
	|	ВТ.КонечныйОстаток_BuhBud
	|ИЗ
	|	ВТ_BuhBud КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФЛ
	|		ПО ВТ.ФЛ_А_ИдКод = ФЛ.А_ИдКод";

	Запрос.УстановитьПараметр("ТЗ", ТаблицаBuhBud);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// =====================================================================
// ОБ'ЄДНАННЯ ТАБЛИЦЬ ERP + BuhBud по А_ИдКод
// Результат — єдина таблиця для СКД з розбіжностями
// =====================================================================
Функция ОбъединитьТаблицы(ТаблицаЕРП, ТаблицаBuhBud)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ФизическоеЛицо",
		Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));

	// Нач.остаток
	Результат.Колонки.Добавить("НачальныйОстаток_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("НачальныйОстаток_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("РазницаНачОстаток", ТипЧисло);

	// Оборот Дт
	Результат.Колонки.Добавить("ОборотДт_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("ОборотДт_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("РазницаОборотДт", ТипЧисло);

	// Оборот Кт
	Результат.Колонки.Добавить("ОборотКт_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("ОборотКт_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("РазницаОборотКт", ТипЧисло);

	// Кон.остаток
	Результат.Колонки.Добавить("КонечныйОстаток_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("КонечныйОстаток_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("РазницаКонОстаток", ТипЧисло);

	// Індекс ERP по А_ИдКод
	ИндексЕРП = Новый Соответствие;
	НомерСтроки = 0;

	// 1. Додаємо всі записи ERP
	Для Каждого СтрокаЕРП Из ТаблицаЕРП Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.ФизическоеЛицо = СтрокаЕРП.ФизическоеЛицо;
		НоваяСтрока.НачальныйОстаток_ЕРП = СтрокаЕРП.НачальныйОстаток_ЕРП;
		НоваяСтрока.ОборотДт_ЕРП = СтрокаЕРП.ОборотДт_ЕРП;
		НоваяСтрока.ОборотКт_ЕРП = СтрокаЕРП.ОборотКт_ЕРП;
		НоваяСтрока.КонечныйОстаток_ЕРП = СтрокаЕРП.КонечныйОстаток_ЕРП;

		ИндексЕРП.Вставить(СтрокаЕРП.А_ИдКод, НомерСтроки);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	// 2. Додаємо/оновлюємо записи BuhBud
	Для Каждого СтрокаBuhBud Из ТаблицаBuhBud Цикл
		НомерВРезультате = ИндексЕРП.Получить(СтрокаBuhBud.А_ИдКод);

		Если НомерВРезультате <> Неопределено Тогда
			// Знайдено в ERP — дозаповнюємо
			СтрокаРезультата = Результат.Получить(НомерВРезультате);
		Иначе
			// Немає в ERP — додаємо нову (тільки BuhBud)
			СтрокаРезультата = Результат.Добавить();
			СтрокаРезультата.ФизическоеЛицо = СтрокаBuhBud.ФизическоеЛицо;
		КонецЕсли;

		СтрокаРезультата.НачальныйОстаток_BuhBud = СтрокаBuhBud.НачальныйОстаток_BuhBud;
		СтрокаРезультата.ОборотДт_BuhBud = СтрокаBuhBud.ОборотДт_BuhBud;
		СтрокаРезультата.ОборотКт_BuhBud = СтрокаBuhBud.ОборотКт_BuhBud;
		СтрокаРезультата.КонечныйОстаток_BuhBud = СтрокаBuhBud.КонечныйОстаток_BuhBud;
	КонецЦикла;

	// 3. Обчислення різниць
	Для Каждого СтрокаРезультата Из Результат Цикл
		СтрокаРезультата.РазницаНачОстаток = СтрокаРезультата.НачальныйОстаток_ЕРП - СтрокаРезультата.НачальныйОстаток_BuhBud;
		СтрокаРезультата.РазницаОборотДт = СтрокаРезультата.ОборотДт_ЕРП - СтрокаРезультата.ОборотДт_BuhBud;
		СтрокаРезультата.РазницаОборотКт = СтрокаРезультата.ОборотКт_ЕРП - СтрокаРезультата.ОборотКт_BuhBud;
		СтрокаРезультата.РазницаКонОстаток = СтрокаРезультата.КонечныйОстаток_ЕРП - СтрокаРезультата.КонечныйОстаток_BuhBud;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецЕсли
