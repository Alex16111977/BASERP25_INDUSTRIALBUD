	|	ЗНАЧЕНИЕ(Справочник.СтруктураСебестоимости.ПустаяСсылка),
	|	ВЫБОР
	|		КОГДА Вик.Викон ЕСТЬ NULL
	|			ТОГДА ВЫРАЗИТЬ(""6. Залишок складу закупівель"" КАК СТРОКА(50))
	|		ИНАЧЕ ВЫРАЗИТЬ(""5. Залишок складу домика"" КАК СТРОКА(50))
	|	КОНЕЦ,
	|	0,
	|	0,
	|	0,
	|	0,
	|	ВЫБОР КОГДА Вик.Викон ЕСТЬ NULL ТОГДА 0 ИНАЧЕ Ост.Кол КОНЕЦ,
	|	ВЫБОР КОГДА Вик.Викон ЕСТЬ NULL ТОГДА 0 ИНАЧЕ Ост.Грн КОНЕЦ,
	|	ВЫБОР КОГДА Вик.Викон ЕСТЬ NULL ТОГДА Ост.Кол ИНАЧЕ 0 КОНЕЦ,
	|	ВЫБОР КОГДА Вик.Викон ЕСТЬ NULL ТОГДА Ост.Грн ИНАЧЕ 0 КОНЕЦ
	|ИЗ
	|	ВТ_Остатки КАК Ост
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Викон КАК Вик
	|		ПО Вик.Викон = Ост.Склад.Подразделение
	|ГДЕ
	|	Ост.Кол <> 0
	|	И (&ОтборСкладовЗадан
	|				И Ост.Склад В (&МассивСкладов)
	|			ИЛИ НЕ &ОтборСкладовЗадан
	|				И (Ост.Склад.Подразделение В ИЕРАРХИИ (&Драйвер)
	|					ИЛИ &РодительДрайвера <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|						И Ост.Склад.Подразделение = &РодительДрайвера))
	|;
	|ВЫБРАТЬ
	|	ВТ_Детали.Подразделение КАК Подразделение,
	|	ВТ_Детали.ПодразделениеИсполнитель КАК ПодразделениеИсполнитель,
