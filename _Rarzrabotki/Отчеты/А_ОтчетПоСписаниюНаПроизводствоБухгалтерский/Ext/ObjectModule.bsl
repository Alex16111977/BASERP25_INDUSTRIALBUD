// Внешний отчёт А_ОтчетПоСписаниюНаПроизводствоБухгалтерский (база bas_industrialbud).
// «Списання на виробництво: план-факт (бухоблік)» — программная компоновка СКД.
//
// План — Справочник.СтруктураСебестоимости.Комплектующие. Норма в бухбазе заведена НА ОДИН ДІМ,
// поэтому множителя нет: план исполнителя = норма * 1, план проекта = норма * число исполнителей.
//
// Факт — РегистрБухгалтерии.Хозрасчетный.Обороты, Кт счетов запасов 20/22/28 В ИЕРАРХИИ
// (26 «готова продукція» — под флажком), 4 документа списания. Подразделение-исполнитель берётся
// ТОЛЬКО из шапки документа (решение финансиста: fallback на Склад.Подразделение не делаем).
//
// 🔴 Состав колонок — БУХГАЛТЕРСКИЙ, 10 показателей (решение 2026-08-05):
// План/Факт в количестве и деньгах, отклонение, % выполнения, цена плана и цена факта.
// Аналитические колонки ЕРП-близнеца (оценка факта в плановых ценах, разложение отклонения
// на количественное и ценовое, остаток плана) здесь УБРАНЫ вместе со всей их механикой:
// в бухбазе проводки полные по всем месяцам, костыль «плановые цены» не нужен.
// В ЕРП-версии они ОСТАЮТСЯ — там себестоимость выбытия появляется только после закрытия месяца.
//
// Все запросы проверены Python-COM на живой bas_industrialbud (Rule #-1).
// Спека: docs/superpowers/specs/2026-08-05-spisanie-na-proizvodstvo-buh-design.md

#Область СлужебныйПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	МассивНазначений = Новый Массив;
	МассивНазначений.Добавить("");

	ИмяОтчета = Метаданные().Представление();

	ПараметрыРегистрации.Вставить("Вид", "ДополнительныйОтчет");
	ПараметрыРегистрации.Вставить("Назначение", МассивНазначений);
	ПараметрыРегистрации.Вставить("Наименование", ИмяОтчета);
	ПараметрыРегистрации.Вставить("Версия", "2.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Истина);
	ПараметрыРегистрации.Вставить("Информация",
		"Списання на виробництво: норми структури собівартості проти факту списання з рахунків запасів");

	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд, ИмяОтчета, Метаданные().ПолноеИмя(), "ОткрытиеФормы", Истина);
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);

	Возврат ПараметрыРегистрации;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СформироватьОтчет(ДокументРезультат, ДанныеРасшифровки);

КонецПроцедуры

// Экспортная точка входа: ровно то, что делает ПриКомпоновкеРезультата.
// Вынесена отдельно, чтобы приёмка могла прогнать ПОЛНЫЙ путь пользователя через COM —
// сам обработчик события COM-прокси не отдаёт («<unknown>.ПриКомпоновкеРезультата»).
// Именно на этом участке в бою вылезла ошибка «Метод объекта не обнаружен (ПолучитьПараметр)»,
// которую приёмка не видела, потому что дёргала только ПолучитьДанные.
Процедура СформироватьОтчет(ДокументРезультат, ДанныеРасшифровки = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();

	Период = ПолучитьЗначениеПараметра(Настройки, "Период");
	ВключатьГП = ПолучитьЗначениеПараметра(Настройки, "ВключатьГотовуюПродукцию");
	СкладыОстатков = ПолучитьЗначениеПараметра(Настройки, "СкладыОстатков");
	ПриводитьПДВ = ПолучитьЗначениеПараметра(Настройки, "ПриводитьФактДоПДВ");

	ТаблицаДетали = ПолучитьДанные(Период, ВключатьГП = Истина, СкладыОстатков,
		НЕ (ПриводитьПДВ = Ложь));

	ВнешниеНаборыДанных = Новый Структура("Детали", ТаблицаДетали);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Главный сбор данных: плоская ТЗ грейна по всем драйверам активных структур себестоимости.
// Границы периода независимы: пустое начало -> '00010101', пустой конец -> '39991231'.
Функция ПолучитьДанные(Период, ВключатьГотовуюПродукцию = Ложь, СкладыОстатков = Неопределено,
	ПриводитьФактДоПДВ = Истина) Экспорт

	Если ЗначениеЗаполнено(Период) И ЗначениеЗаполнено(Период.ДатаНачала) Тогда
		НачП = Период.ДатаНачала;
	Иначе
		НачП = '00010101000000';
	КонецЕсли;
	Если ЗначениеЗаполнено(Период) И ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		КонП = КонецДня(Период.ДатаОкончания);
	Иначе
		КонП = '39991231235959';
	КонецЕсли;

	МассивСкладов = НормализоватьСписокСкладов(СкладыОстатков);
	ОтборСкладовЗадан = (МассивСкладов.Количество() > 0);
	Если НЕ ОтборСкладовЗадан Тогда
		// в запрос всё равно нужен непустой массив — кладём заглушку, ветка отбора не сработает
		МассивСкладов.Добавить(Справочники.Склады.ПустаяСсылка());
	КонецЕсли;

	ТЗ = СоздатьПустуюТаблицу();

	Для Каждого КлючЗначение Из ПолучитьСоответствиеДрайверов() Цикл
		Драйвер = КлючЗначение.Ключ;
		МассивСС = КлючЗначение.Значение;
		МассивВиконавцев = ПолучитьИсполнителей(Драйвер);
		ТЗЧасть = ВыполнитьЗапросПоДрайверу(Драйвер, МассивСС, МассивВиконавцев, НачП, КонП,
			ВключатьГотовуюПродукцию, МассивСкладов, ОтборСкладовЗадан, ПриводитьФактДоПДВ);
		ЗаполнитьЭтапИКатегориюФакта(ТЗЧасть, МассивСС);
		Для Каждого СтрокаЧасти Из ТЗЧасть Цикл
			ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), СтрокаЧасти);
		КонецЦикла;
	КонецЦикла;

	ЗаполнитьПроизводные(ТЗ);

	Возврат ТЗ;

КонецФункции

// Параметр «Склади залишків» из СКД приходит как СписокЗначений (множественный выбор),
// одиночная ссылка или Неопределено — приводим к массиву ссылок без пустых.
Функция НормализоватьСписокСкладов(Значение)

	Массив = Новый Массив;
	Если Значение = Неопределено Тогда
		Возврат Массив;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("СписокЗначений") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если ЗначениеЗаполнено(Элемент.Значение) Тогда
				Массив.Добавить(Элемент.Значение);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если ЗначениеЗаполнено(Элемент) Тогда
				Массив.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
		Массив.Добавить(Значение);
	КонецЕсли;

	Возврат Массив;

КонецФункции

// Производные показатели на уровне ДЕТАЛЬНОЙ строки. На уровнях группировок те же формулы
// пересчитываются схемой через totalField — иначе средние цены, проценты и «Треба доперемістити»
// сложились бы суммой (а они должны считаться от итогов группы).
Процедура ЗаполнитьПроизводные(ТЗ)

	Для Каждого СтрокаТЗ Из ТЗ Цикл
		СтрокаТЗ.ЦенаПлан = ?(СтрокаТЗ.ПланКол = 0, 0, СтрокаТЗ.ПланГрн / СтрокаТЗ.ПланКол);
		СтрокаТЗ.ЦенаФакт = ?(СтрокаТЗ.ФактКол = 0, 0, СтрокаТЗ.ФактГрнБух / СтрокаТЗ.ФактКол);
		СтрокаТЗ.ОтклонениеКол = СтрокаТЗ.ФактКол - СтрокаТЗ.ПланКол;
		СтрокаТЗ.ОтклонениеГрн = СтрокаТЗ.ФактГрнБух - СтрокаТЗ.ПланГрн;
		СтрокаТЗ.ПроцентКол = ?(СтрокаТЗ.ПланКол = 0, 0, СтрокаТЗ.ФактКол / СтрокаТЗ.ПланКол * 100);
		СтрокаТЗ.ПроцентГрн = ?(СтрокаТЗ.ПланГрн = 0, 0, СтрокаТЗ.ФактГрнБух / СтрокаТЗ.ПланГрн * 100);
		// Скільки ще треба доперемістити на склади домика (виробничий + відвантажено),
		// щоб закрити план: план мінус уже списане мінус те, що вже лежить на складах домика.
		СтрокаТЗ.ТребуетсяПереместить =
			Макс(0, СтрокаТЗ.ПланКол - СтрокаТЗ.ФактКол - СтрокаТЗ.ОстатокОбъектаКол);
	КонецЦикла;

КонецПроцедуры

// Соответствие: Драйвер (СправочникСсылка.Подразделения) -> Массив карточек СС этого драйвера.
//
// Драйвер — это УЗЕЛ ОБЪЕКТА: подразделение, детьми которого являются домики. План карточки
// тиражируется на его детей, факт берётся «В ИЕРАРХИИ» от него.
//
// В бухбазе НЕТ реквизита-драйвера (аналога ПодразделениеОбъекта из ЕРП): карточки IRS
// (15 м и 30 м) обе висят на ОБЩЕМ зонтике «МД IRC 2026», и узел объекта приходится узнавать
// по названию. Три правила, первое сработавшее побеждает:
//   1. У СС.Подразделение нет детей -> оно само и есть узел объекта.
//   2. Ребёнок с именем, точно равным имени карточки.
//   3. Ребёнок с той же СОБСТВЕННОЙ частью имени: каждая сторона отбрасывает СВОЙ префикс-родителя
//      («МД IRC 2026 15 м (МД IRC 2026)» -> «15 м», «МД IRS 2026 15 м (МД IRS 2026)» -> «15 м»).
//
// 🔴 Правило 3 добавлено 2026-08-11: дерево подразделений переименовали IRS -> IRC, карточки СС
// остались IRS, точное сравнение имён (правило 2) перестало срабатывать — и драйвер молча
// откатывался на зонтик. Последствия в бою: план тиражировался на узлы «15 м»/«30 м» вместо
// домиков (44 190 вместо 146 347 — 30% от плана), факт лежал на домиках «№1..№3», и план с фактом
// оказывались в РАЗНЫХ строках отчёта. Правило 3 переживает переименование проекта, потому что
// сравнивает только различающий суффикс и только среди детей ОДНОГО зонтика.
//
// Если ни одно правило не сработало, а дети у СС.Подразделение есть — драйвер вырождается
// в зонтик, и это ГРОМКО сообщается пользователю: молчаливая деградация здесь стоит дороже,
// чем неудобное сообщение. Постоянное лечение — поставить в карточке СС Подразделение = узел
// объекта; тогда сработает правило 1 и никакой разбор имён не понадобится вовсе.
Функция ПолучитьСоответствиеДрайверов()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СС.Ссылка КАК СС,
	|	СС.Наименование КАК ИмяСС,
	|	СС.Подразделение КАК Узел,
	|	СС.Подразделение.Наименование КАК ИмяУзла
	|ПОМЕСТИТЬ ВТ_Карточки
	|ИЗ
	|	Справочник.СтруктураСебестоимости КАК СС
	|ГДЕ
	|	НЕ СС.ЭтоГруппа
	|	И СС.Активная
	|	И НЕ СС.ПометкаУдаления
	|	И СС.Подразделение <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|;
	|ВЫБРАТЬ
	|	К.СС КАК СС,
	|	К.ИмяСС КАК ИмяСС,
	|	К.Узел КАК Узел,
	|	К.ИмяУзла КАК ИмяУзла,
	|	Дочь.Ссылка КАК Дочь,
	|	Дочь.Наименование КАК ИмяДочери
	|ИЗ
	|	ВТ_Карточки КАК К
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Подразделения КАК Дочь
	|		ПО Дочь.Родитель = К.Узел
	|			И НЕ Дочь.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	ИмяСС,
	|	ИмяДочери";

	Карточки = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Данные = Карточки.Получить(Выборка.СС);
		Если Данные = Неопределено Тогда
			Данные = Новый Структура("Узел, ИмяСС, ИмяУзла, Дети",
				Выборка.Узел, СокрЛП(Выборка.ИмяСС), СокрЛП(Выборка.ИмяУзла), Новый Массив);
			Карточки.Вставить(Выборка.СС, Данные);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Дочь) Тогда
			Данные.Дети.Добавить(Новый Структура("Ссылка, Имя",
				Выборка.Дочь, СокрЛП(Выборка.ИмяДочери)));
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Соответствие;
	Для Каждого КлючЗначение Из Карточки Цикл
		Драйвер = ОпределитьДрайвер(КлючЗначение.Значение);
		МассивСС = Результат.Получить(Драйвер);
		Если МассивСС = Неопределено Тогда
			МассивСС = Новый Массив;
			Результат.Вставить(Драйвер, МассивСС);
		КонецЕсли;
		МассивСС.Добавить(КлючЗначение.Ключ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Узел объекта для одной карточки СС. Правила — см. комментарий к ПолучитьСоответствиеДрайверов.
Функция ОпределитьДрайвер(Данные)

	Если Данные.Дети.Количество() = 0 Тогда
		Возврат Данные.Узел;
	КонецЕсли;

	Для Каждого Ребенок Из Данные.Дети Цикл
		Если Ребенок.Имя = Данные.ИмяСС Тогда
			Возврат Ребенок.Ссылка;
		КонецЕсли;
	КонецЦикла;

	ХвостСС = ВРег(СобственнаяЧастьИмени(Данные.ИмяСС, ЗонтикИзИмени(Данные.ИмяСС)));
	Если ЗначениеЗаполнено(ХвостСС) И ХвостСС <> ВРег(Данные.ИмяСС) Тогда
		Найденный = Неопределено;
		СколькоСовпало = 0;
		Для Каждого Ребенок Из Данные.Дети Цикл
			Если ВРег(СобственнаяЧастьИмени(Ребенок.Имя, Данные.ИмяУзла)) = ХвостСС Тогда
				Найденный = Ребенок.Ссылка;
				СколькоСовпало = СколькоСовпало + 1;
			КонецЕсли;
		КонецЦикла;
		Если СколькоСовпало = 1 Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЕсли;

	ПредупредитьОНераспознанномУзле(Данные);
	Возврат Данные.Узел;

КонецФункции

// Собственная часть имени: отбрасываем хвост в скобках и префикс-родителя.
// «МД IRC 2026 15 м (МД IRC 2026)» + родитель «МД IRC 2026» -> «15 м».
// ⚠️ Скобку ищем ПЕРВУЮ: у подразделений имя рекурсивно тянет весь путь и обрезается по 50 символов
// («МД IRC 2026 15 м №1 (МД IRC 2026 15 м (МД IRC 2026»), поиск с конца дал бы мусор.
Функция СобственнаяЧастьИмени(Имя, ИмяРодителя)

	Текст = СокрЛП(Имя);
	Позиция = СтрНайти(Текст, " (");
	Если Позиция > 0 Тогда
		Текст = СокрЛП(Лев(Текст, Позиция - 1));
	КонецЕсли;

	Родитель = СокрЛП(ИмяРодителя);
	Если ЗначениеЗаполнено(Родитель)
		И СтрДлина(Текст) > СтрДлина(Родитель)
		И ВРег(Лев(Текст, СтрДлина(Родитель))) = ВРег(Родитель) Тогда
		Текст = СокрЛП(Сред(Текст, СтрДлина(Родитель) + 1));
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Зонтик, объявленный в самом имени карточки: «МД IRS 2026 15 м (МД IRS 2026)» -> «МД IRS 2026».
// Нужен, чтобы отбросить префикс карточки, не зная её реального родителя (он может быть переименован).
Функция ЗонтикИзИмени(Имя)

	Текст = СокрЛП(Имя);
	Позиция = СтрНайти(Текст, " (");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = СокрЛП(Сред(Текст, Позиция + 2));
	Если Прав(Хвост, 1) = ")" Тогда
		Хвост = СокрЛП(Лев(Хвост, СтрДлина(Хвост) - 1));
	КонецЕсли;

	Возврат Хвост;

КонецФункции

// Молчать здесь нельзя: отчёт останется формально рабочим, но план ляжет на зонтик,
// а факт — на домики, и бухгалтер увидит пустую колонку «План» напротив каждой позиции.
Процедура ПредупредитьОНераспознанномУзле(Данные)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон(
		"Списання на виробництво: картку структури собівартості «%1» не вдалося звести з вузлом"
		+ " об'єкта. Вона привʼязана до підрозділу «%2», у якого Є дочірні вузли, але жоден не"
		+ " збігається з карткою за назвою."
		+ " План ляже на «%2» цілком, а факт — на будиночки, і вони НЕ зійдуться в одному рядку."
		+ " Виправлення: у картці СС вкажіть Підрозділ = вузол об'єкта (дочірній) або приведіть"
		+ " назви картки та вузла до однакового вигляду.",
		Данные.ИмяСС, Данные.ИмяУзла);
	Сообщение.Сообщить();

КонецПроцедуры

// Подразделения-исполнители драйвера = его непосредственные дети (для IRS это «№1..№N»,
// их число равно количеству домиков). Если детей нет — исполнителем считается сам драйвер.
// ⚠️ Справочник.Подразделения — иерархия ЭЛЕМЕНТОВ, реквизита ЭтоГруппа у него НЕТ.
Функция ПолучитьИсполнителей(Драйвер)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Драйвер", Драйвер);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Ссылка КАК Викон
	|ИЗ
	|	Справочник.Подразделения КАК П
	|ГДЕ
	|	П.Родитель = &Драйвер
	|	И НЕ П.ПометкаУдаления";

	Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Викон");
	Если Массив.Количество() = 0 Тогда
		Массив.Добавить(Драйвер);
	КонецЕсли;
	Возврат Массив;

КонецФункции

// Запрос грейна по ОДНОМУ драйверу: UNION плановой и фактовой веток.
//
// План тиражируется на исполнителей БЕЗ множителя: норма в бухбазе — на один дом.
// Факт НЕ соединяется ни с чем (только ГДЕ) — иначе при нескольких активных СС на одном драйвере
// «ПО ИСТИНА» умножил бы факт на число карточек.
// ⚠️ «В ИЕРАРХИИ (столбец ВТ)» запрещено платформой — только параметр или подзапрос.
// ⚠️ Склад: у части проводок он во ВТОРОМ субконто, у остальных в ТРЕТЬЕМ — отсюда ЕСТЬNULL
// с двумя ВЫРАЗИТЬ (несовпадающий ВЫРАЗИТЬ даёт NULL).
//
// 🔴 Залишки — ДВІ РІЗНІ гілки з РІЗНИМИ правилами відбору складів:
//   «Залишок на домику»       — склади, привʼязані до підрозділу-виконавця
//                               (…№1 Виробничий + …№1 Відвантажено). Підбираються ЗАВЖДИ
//                               автоматично, параметр «Склади залишків» на них НЕ впливає.
//   «Залишок складів проекту» — рівно ті склади, що вибрані в параметрі «Склади залишків»
//                               (порожньо -> автопідбір по ієрархії драйвера + батьківський
//                               підрозділ). Тиражується на всіх виконавців.
// Причина: бухгалтер вибирає в шапці ЗАКУПІВЕЛЬНИЙ склад проекту, і цей вибір не повинен
// гасити залишки цехів домика — інакше «Залишок на домику» падає в нуль (баг 2026-08-05).
Функция ВыполнитьЗапросПоДрайверу(Драйвер, МассивСС, МассивВиконавцев, НачП, КонП,
	ВключатьГотовуюПродукцию, МассивСкладов, ОтборСкладовЗадан, ПриводитьФактДоПДВ)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Драйвер", Драйвер);
	// Карточки этого драйвера пришли уже разобранными (ПолучитьСоответствиеДрайверов) — правило
	// «карточка -> узел объекта» живёт в ОДНОМ месте, а не переписывается в каждом запросе.
	Запрос.УстановитьПараметр("МассивСС", МассивСС);
	Запрос.УстановитьПараметр("МассивВиконавцев", МассивВиконавцев);
	Запрос.УстановитьПараметр("НачП", НачП);
	Запрос.УстановитьПараметр("КонП", КонП);
	Запрос.УстановитьПараметр("ВключатьГотовуюПродукцию", ВключатьГотовуюПродукцию);
	Запрос.УстановитьПараметр("МассивСкладов", МассивСкладов);
	Запрос.УстановитьПараметр("ОтборСкладовЗадан", ОтборСкладовЗадан);
	// Родитель драйвера — чтобы автоподбор поймал ОБЩИЙ склад проекта: он висит не на драйвере,
	// а на родительском подразделении («ІБ _МД IRS 2026» -> «МД IRS 2026»).
	Запрос.УстановитьПараметр("РодительДрайвера", Драйвер.Родитель);
	// План у ТЧ Комплектующие заведён З ПДВ, а бухоблік запасів (рах. 20/22/28) — БЕЗ ПДВ.
	// Щоб порівнювати однакові суми, факт і залишки приводимо до цін з ПДВ за ставкою
	// НОМЕНКЛАТУРИ (20/14/7%), а не однією ставкою на все: у плані активних СС є 44 позиції
	// «Без ПДВ»/«Не ПДВ» на 528 927,64 грн — їх множити не можна.
	Запрос.УстановитьПараметр("ПриводитьФактДоПДВ", ПриводитьФактДоПДВ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Ссылка КАК Викон
	|ПОМЕСТИТЬ ВТ_Викон
	|ИЗ
	|	Справочник.Подразделения КАК П
	|ГДЕ
	|	П.Ссылка В (&МассивВиконавцев)
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Счет.Ссылка КАК Счет
	|ПОМЕСТИТЬ ВТ_Счета
	|ИЗ
	|	ПланСчетов.Хозрасчетный КАК Счет
	|ГДЕ
	|	Счет.Ссылка В ИЕРАРХИИ (
	|		ВЫБРАТЬ
	|			Г.Ссылка
	|		ИЗ
	|			ПланСчетов.Хозрасчетный КАК Г
	|		ГДЕ
	|			Г.Код В (""20"", ""22"", ""28"")
	|				ИЛИ &ВключатьГотовуюПродукцию
	|					И Г.Код = ""26"")
	|;
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура) КАК Ном,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.Склады), ВЫРАЗИТЬ(Ост.Субконто3 КАК Справочник.Склады)) КАК Склад,
	|	Ост.Счет КАК Счет,
	|	ВЫБОР
	|		КОГДА НЕ &ПриводитьФактДоПДВ
	|			ТОГДА 1
	|		КОГДА ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура).СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20)
	|			ТОГДА 1.2
	|		КОГДА ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура).СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС14)
	|			ТОГДА 1.14
	|		КОГДА ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура).СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС7)
	|			ТОГДА 1.07
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК КоэфПДВ,
	|	СУММА(Ост.КоличествоОстаток) КАК Кол,
	|	СУММА(Ост.СуммаОстаток) КАК Грн
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&КонП,
	|			Счет В
	|				(ВЫБРАТЬ
	|					ВТ_Счета.Счет
	|				ИЗ
	|					ВТ_Счета КАК ВТ_Счета),
	|			,
	|			) КАК Ост
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура),
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Ост.Субконто2 КАК Справочник.Склады), ВЫРАЗИТЬ(Ост.Субконто3 КАК Справочник.Склады)),
	|	Ост.Счет,
	|	ВЫБОР
	|		КОГДА НЕ &ПриводитьФактДоПДВ
	|			ТОГДА 1
	|		КОГДА ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура).СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20)
	|			ТОГДА 1.2
	|		КОГДА ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура).СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС14)
	|			ТОГДА 1.14
	|		КОГДА ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Номенклатура).СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС7)
	|			ТОГДА 1.07
	|		ИНАЧЕ 1
	|	КОНЕЦ
	|;
	|ВЫБРАТЬ
	|	&Драйвер КАК Подразделение,
	|	Вик.Викон КАК ПодразделениеИсполнитель,
	|	ВЫРАЗИТЬ(ВЫБОР КОГДА К.Этап.Наименование ПОДОБНО ""%Монтаж%"" ТОГДА ""Монтаж"" ИНАЧЕ ""Виробництво"" КОНЕЦ КАК СТРОКА(50)) КАК Категория,
	|	К.Этап КАК Этап,
	|	ВЫБОР
	|		КОГДА К.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА К.ОбщееНазвание
	|		ИНАЧЕ К.Номенклатура.ОбщееНазваниеНоменклатуры
	|	КОНЕЦ КАК ОбщееНазвание,
	|	ВЫБОР
	|		КОГДА К.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА К.НоменклатураСС
	|		ИНАЧЕ К.Номенклатура
	|	КОНЕЦ КАК Аналитика,
	|	К.Единица КАК Единица,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) КАК Склад,
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка) КАК Счет,
	|	К.Ссылка КАК Документ,
	|	ВЫРАЗИТЬ(""0. План"" КАК СТРОКА(50)) КАК ВидДокумента,
	|	К.Количество КАК ПланКол,
	|	К.Сумма КАК ПланГрн,
	|	0 КАК ФактКол,
	|	0 КАК ФактГрнБух,
	|	0 КАК ОстатокОбъектаКол,
	|	0 КАК ОстатокОбъектаГрн,
	|	0 КАК ОстатокЗакупкиКол,
	|	0 КАК ОстатокЗакупкиГрн
	|ПОМЕСТИТЬ ВТ_Детали
	|ИЗ
	|	Справочник.СтруктураСебестоимости.Комплектующие КАК К
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Викон КАК Вик
	|		ПО ИСТИНА
	|ГДЕ
	|	К.Ссылка В (&МассивСС)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Драйвер,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(О.Регистратор) = ТИП(Документ.ТребованиеНакладная)
	|			ТОГДА ВЫРАЗИТЬ(О.Регистратор КАК Документ.ТребованиеНакладная).Подразделение
	|		КОГДА ТИПЗНАЧЕНИЯ(О.Регистратор) = ТИП(Документ.СписаниеТоваров)
	|			ТОГДА ВЫРАЗИТЬ(О.Регистратор КАК Документ.СписаниеТоваров).Подразделение
	|		КОГДА ТИПЗНАЧЕНИЯ(О.Регистратор) = ТИП(Документ.КомплектацияНоменклатуры)
	|			ТОГДА ВЫРАЗИТЬ(О.Регистратор КАК Документ.КомплектацияНоменклатуры).Подразделение
	|		КОГДА ТИПЗНАЧЕНИЯ(О.Регистратор) = ТИП(Документ.ПередачаМалоценныхАктивовВЭксплуатацию)
	|			ТОГДА ВЫРАЗИТЬ(О.Регистратор КАК Документ.ПередачаМалоценныхАктивовВЭксплуатацию).Подразделение
	|	КОНЕЦ,
	|	ВЫРАЗИТЬ(""Виробництво"" КАК СТРОКА(50)),
	|	НЕОПРЕДЕЛЕНО,
	|	ВЫРАЗИТЬ(О.Субконто1 КАК Справочник.Номенклатура).ОбщееНазваниеНоменклатуры,
	|	ВЫРАЗИТЬ(О.Субконто1 КАК Справочник.Номенклатура),
	|	ВЫРАЗИТЬ(О.Субконто1 КАК Справочник.Номенклатура).БазоваяЕдиницаИзмерения,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(О.Субконто2 КАК Справочник.Склады), ВЫРАЗИТЬ(О.Субконто3 КАК Справочник.Склады)),
	|	О.Счет,
	|	О.Регистратор,
	|	ВЫРАЗИТЬ(ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(О.Регистратор) = ТИП(Документ.КомплектацияНоменклатуры)
	|			ТОГДА ""1. Комплектація""
	|		КОГДА ТИПЗНАЧЕНИЯ(О.Регистратор) = ТИП(Документ.ПередачаМалоценныхАктивовВЭксплуатацию)
	|			ТОГДА ""2. Малоцінка в експлуатацію""
	|		КОГДА ТИПЗНАЧЕНИЯ(О.Регистратор) = ТИП(Документ.ТребованиеНакладная)
	|			ТОГДА ""3. Вимога-накладна""
	|		ИНАЧЕ ""4. Списання товарів""
	|	КОНЕЦ КАК СТРОКА(50)),
	|	0,
	|	0,
	|	О.КоличествоОборотКт,
	|	О.СуммаОборотКт * ВЫБОР
	|		КОГДА НЕ &ПриводитьФактДоПДВ
	|			ТОГДА 1
	|		КОГДА ВЫРАЗИТЬ(О.Субконто1 КАК Справочник.Номенклатура).СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20)
	|			ТОГДА 1.2
	|		КОГДА ВЫРАЗИТЬ(О.Субконто1 КАК Справочник.Номенклатура).СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС14)
	|			ТОГДА 1.14
	|		КОГДА ВЫРАЗИТЬ(О.Субконто1 КАК Справочник.Номенклатура).СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС7)
	|			ТОГДА 1.07
	|		ИНАЧЕ 1
	|	КОНЕЦ,
	|	0,
	|	0,
	|	0,
	|	0
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			&НачП,
	|			&КонП,
	|			Регистратор,
	|			Счет В
	|				(ВЫБРАТЬ
	|					ВТ_Счета.Счет
	|				ИЗ
	|					ВТ_Счета КАК ВТ_Счета),
	|			,
	|			,
	|			,
	|			) КАК О
	|ГДЕ
	|	О.СуммаОборотКт <> 0
	|	И ТИПЗНАЧЕНИЯ(О.Регистратор) В (
	|			ТИП(Документ.ТребованиеНакладная),
	|			ТИП(Документ.СписаниеТоваров),
	|			ТИП(Документ.КомплектацияНоменклатуры),
	|			ТИП(Документ.ПередачаМалоценныхАктивовВЭксплуатацию))
	|	И ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(О.Регистратор) = ТИП(Документ.ТребованиеНакладная)
	|			ТОГДА ВЫРАЗИТЬ(О.Регистратор КАК Документ.ТребованиеНакладная).Подразделение
	|		КОГДА ТИПЗНАЧЕНИЯ(О.Регистратор) = ТИП(Документ.СписаниеТоваров)
	|			ТОГДА ВЫРАЗИТЬ(О.Регистратор КАК Документ.СписаниеТоваров).Подразделение
	|		КОГДА ТИПЗНАЧЕНИЯ(О.Регистратор) = ТИП(Документ.КомплектацияНоменклатуры)
	|			ТОГДА ВЫРАЗИТЬ(О.Регистратор КАК Документ.КомплектацияНоменклатуры).Подразделение
	|		КОГДА ТИПЗНАЧЕНИЯ(О.Регистратор) = ТИП(Документ.ПередачаМалоценныхАктивовВЭксплуатацию)
	|			ТОГДА ВЫРАЗИТЬ(О.Регистратор КАК Документ.ПередачаМалоценныхАктивовВЭксплуатацию).Подразделение
	|	КОНЕЦ В ИЕРАРХИИ (&Драйвер)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Драйвер,
	|	ЕСТЬNULL(Вик.Викон, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)),
	|	ВЫРАЗИТЬ(""Виробництво"" КАК СТРОКА(50)),
	|	НЕОПРЕДЕЛЕНО,
	|	Ост.Ном.ОбщееНазваниеНоменклатуры,
	|	Ост.Ном,
	|	Ост.Ном.БазоваяЕдиницаИзмерения,
	|	Ост.Склад,
	|	Ост.Счет,
	|	ЗНАЧЕНИЕ(Справочник.СтруктураСебестоимости.ПустаяСсылка),
	|	ВЫРАЗИТЬ(""5. Залишок складу домика"" КАК СТРОКА(50)),
	|	0,
	|	0,
	|	0,
	|	0,
	|	Ост.Кол,
	|	Ост.Грн * Ост.КоэфПДВ,
	|	0,
	|	0
	|ИЗ
	|	ВТ_Остатки КАК Ост
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Викон КАК Вик
	|		ПО Вик.Викон = Ост.Склад.Подразделение
	|ГДЕ
	|	Ост.Кол <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Драйвер,
	|	Вик.Викон,
	|	ВЫРАЗИТЬ(""Виробництво"" КАК СТРОКА(50)),
	|	НЕОПРЕДЕЛЕНО,
	|	Ост.Ном.ОбщееНазваниеНоменклатуры,
	|	Ост.Ном,
	|	Ост.Ном.БазоваяЕдиницаИзмерения,
	|	Ост.Склад,
	|	Ост.Счет,
	|	ЗНАЧЕНИЕ(Справочник.СтруктураСебестоимости.ПустаяСсылка),
	|	ВЫРАЗИТЬ(""6. Залишок складу проекту"" КАК СТРОКА(50)),
	|	0,
	|	0,
	|	0,
	|	0,
	|	0,
	|	0,
	|	Ост.Кол,
	|	Ост.Грн * Ост.КоэфПДВ
	|ИЗ
	|	ВТ_Остатки КАК Ост
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Викон КАК Вик
	|		ПО ИСТИНА
	|ГДЕ
	|	Ост.Кол <> 0
	|	И НЕ Ост.Склад.Подразделение В (&МассивВиконавцев)
	|	И (&ОтборСкладовЗадан
	|				И Ост.Склад В (&МассивСкладов)
	|			ИЛИ НЕ &ОтборСкладовЗадан
	|				И (Ост.Склад.Подразделение В ИЕРАРХИИ (&Драйвер)
	|					ИЛИ &РодительДрайвера <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|						И Ост.Склад.Подразделение = &РодительДрайвера))
	|;
	|ВЫБРАТЬ
	|	ВТ_Детали.Подразделение КАК Подразделение,
	|	ВТ_Детали.ПодразделениеИсполнитель КАК ПодразделениеИсполнитель,
	|	ВТ_Детали.Категория КАК Категория,
	|	ВТ_Детали.Этап КАК Этап,
	|	ВТ_Детали.ОбщееНазвание КАК ОбщееНазвание,
	|	ВТ_Детали.Аналитика КАК Аналитика,
	|	ВТ_Детали.Единица КАК Единица,
	|	ВТ_Детали.Склад КАК Склад,
	|	ВТ_Детали.Счет КАК Счет,
	|	ВТ_Детали.Документ КАК Документ,
	|	ВТ_Детали.ВидДокумента КАК ВидДокумента,
	|	СУММА(ВТ_Детали.ПланКол) КАК ПланКол,
	|	СУММА(ВТ_Детали.ПланГрн) КАК ПланГрн,
	|	СУММА(ВТ_Детали.ФактКол) КАК ФактКол,
	|	СУММА(ВТ_Детали.ФактГрнБух) КАК ФактГрнБух,
	|	СУММА(ВТ_Детали.ОстатокОбъектаКол) КАК ОстатокОбъектаКол,
	|	СУММА(ВТ_Детали.ОстатокОбъектаГрн) КАК ОстатокОбъектаГрн,
	|	СУММА(ВТ_Детали.ОстатокЗакупкиКол) КАК ОстатокЗакупкиКол,
	|	СУММА(ВТ_Детали.ОстатокЗакупкиГрн) КАК ОстатокЗакупкиГрн
	|ИЗ
	|	ВТ_Детали КАК ВТ_Детали
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Детали.Подразделение,
	|	ВТ_Детали.ПодразделениеИсполнитель,
	|	ВТ_Детали.Категория,
	|	ВТ_Детали.Этап,
	|	ВТ_Детали.ОбщееНазвание,
	|	ВТ_Детали.Аналитика,
	|	ВТ_Детали.Единица,
	|	ВТ_Детали.Склад,
	|	ВТ_Детали.Счет,
	|	ВТ_Детали.Документ,
	|	ВТ_Детали.ВидДокумента";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Разнос строк ФАКТА (Етап пуст) по Етапу и Категорії:
// «Загальна назва» -> {Этап, Категория} из плана Комплектующие этого драйвера (через Соответствие).
// Ключ — нормализованное ИМЯ общей назвы: у ОбщиеНазванияНоменклатуры есть ДУБЛИ карточек
// с одинаковым именем, сопоставление по ссылке их не находит.
Процедура ЗаполнитьЭтапИКатегориюФакта(ТЗ, МассивСС)

	Маппинг = МаппингОбщееНазваниеЭтап(МассивСС);
	Если Маппинг.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТЗ Из ТЗ Цикл
		Если СтрокаТЗ.ВидДокумента = "0. План" ИЛИ ЗначениеЗаполнено(СтрокаТЗ.Этап) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаТЗ.ОбщееНазвание) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = СокрЛП(СтрокаТЗ.ОбщееНазвание.Наименование);
		ДанныеЭтапа = Маппинг.Получить(Ключ);
		Если ДанныеЭтапа <> Неопределено Тогда
			СтрокаТЗ.Этап = ДанныеЭтапа.Этап;
			СтрокаТЗ.Категория = ДанныеЭтапа.Категория;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Соответствие ИМЯ общей назвы (нормализованное) -> Структура{Этап, Категория}.
// Карта строится по карточкам ЭТОГО драйвера — их массив уже разобран ПолучитьСоответствиеДрайверов.
Функция МаппингОбщееНазваниеЭтап(МассивСС)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСС", МассивСС);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА К.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА К.ОбщееНазвание.Наименование
	|		ИНАЧЕ К.Номенклатура.ОбщееНазваниеНоменклатуры.Наименование
	|	КОНЕЦ КАК ОбщееНазвание,
	|	К.Этап КАК Этап,
	|	ВЫБОР КОГДА К.Этап.Наименование ПОДОБНО ""%Монтаж%"" ТОГДА ""Монтаж"" ИНАЧЕ ""Виробництво"" КОНЕЦ КАК Категория
	|ИЗ
	|	Справочник.СтруктураСебестоимости.Комплектующие КАК К
	|ГДЕ
	|	К.Ссылка В (&МассивСС)
	|	И ВЫБОР
	|		КОГДА К.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА К.ОбщееНазвание
	|		ИНАЧЕ К.Номенклатура.ОбщееНазваниеНоменклатуры
	|	КОНЕЦ <> ЗНАЧЕНИЕ(Справочник.ОбщиеНазванияНоменклатуры.ПустаяСсылка)
	|	И К.Этап <> ЗНАЧЕНИЕ(Справочник.ЭтапыРабот.ПустаяСсылка)";

	Маппинг = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = СокрЛП(Выборка.ОбщееНазвание);
		Если НЕ ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Текущий = Маппинг.Получить(Ключ);
		Если Текущий = Неопределено ИЛИ Строка(Выборка.Этап) > Строка(Текущий.Этап) Тогда
			Маппинг.Вставить(Ключ, Новый Структура("Этап, Категория", Выборка.Этап, Выборка.Категория));
		КонецЕсли;
	КонецЦикла;
	Возврат Маппинг;

КонецФункции

// Пустая ТЗ грейна (типы колонок = полям внешнего набора "Детали" схемы СКД).
// Порядок и типы обязаны совпадать со схемой — рассинхрон даёт битые данные без ошибки.
// 10 измерений + 10 показателей = 20 полей (бухгалтерский состав, решение 2026-08-05).
Функция СоздатьПустуюТаблицу()

	ТЗ = Новый ТаблицаЗначений;
	ОписЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 3, ДопустимыйЗнак.Любой));
	ОписСтрока50 = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50));

	МассивАналитика = Новый Массив;
	МассивАналитика.Добавить(Тип("СправочникСсылка.Номенклатура"));
	МассивАналитика.Добавить(Тип("Строка")); // план без карточки = текст НоменклатураСС (Excel)

	МассивДокумент = Новый Массив;
	МассивДокумент.Добавить(Тип("ДокументСсылка.КомплектацияНоменклатуры"));
	МассивДокумент.Добавить(Тип("ДокументСсылка.ПередачаМалоценныхАктивовВЭксплуатацию"));
	МассивДокумент.Добавить(Тип("ДокументСсылка.ТребованиеНакладная"));
	МассивДокумент.Добавить(Тип("ДокументСсылка.СписаниеТоваров"));
	МассивДокумент.Добавить(Тип("СправочникСсылка.СтруктураСебестоимости"));

	ТЗ.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТЗ.Колонки.Добавить("ПодразделениеИсполнитель", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТЗ.Колонки.Добавить("Категория", ОписСтрока50);
	ТЗ.Колонки.Добавить("Этап", Новый ОписаниеТипов("СправочникСсылка.ЭтапыРабот"));
	ТЗ.Колонки.Добавить("ОбщееНазвание", Новый ОписаниеТипов("СправочникСсылка.ОбщиеНазванияНоменклатуры"));
	ТЗ.Колонки.Добавить("Аналитика", Новый ОписаниеТипов(МассивАналитика, , Новый КвалификаторыСтроки(200)));
	ТЗ.Колонки.Добавить("Единица", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТЗ.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	// Рахунок обліку — щоб бухгалтер бачив, ДЕ саме лежить залишок: 205 (склад закупівель)
	// чи 2051 (передано у виробництво). Без цього розрізу ОСВ по одному субрахунку не сходиться
	// зі звітом, який бере 20 В ІЄРАРХІЇ (реальне питання 2026-08-05).
	ТЗ.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"));
	ТЗ.Колонки.Добавить("Документ", Новый ОписаниеТипов(МассивДокумент));
	ТЗ.Колонки.Добавить("ВидДокумента", ОписСтрока50);
	ТЗ.Колонки.Добавить("ПланКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ПланГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ФактКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ФактГрнБух", ОписЧисло);
	ТЗ.Колонки.Добавить("ОстатокОбъектаКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ОстатокОбъектаГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ОстатокЗакупкиКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ОстатокЗакупкиГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ТребуетсяПереместить", ОписЧисло);
	ТЗ.Колонки.Добавить("ЦенаПлан", ОписЧисло);
	ТЗ.Колонки.Добавить("ЦенаФакт", ОписЧисло);
	ТЗ.Колонки.Добавить("ОтклонениеКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ОтклонениеГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ПроцентКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ПроцентГрн", ОписЧисло);
	Возврат ТЗ;

КонецФункции

// Значение параметра компоновки БЕЗ обращения к БСП.
// ⚠️ НЕ использовать КомпоновкаДанныхКлиентСервер.ПолучитьПараметр: в bas_industrialbud модуль
// есть, но экспортного метода ПолучитьПараметр в нём НЕТ — отчёт падал прямо в форме
// с «Метод объекта не обнаружен (ПолучитьПараметр)». Читаем параметр из уже полученных
// настроек (в них уже применены пользовательские).
Функция ПолучитьЗначениеПараметра(Настройки, ИмяПараметра)
	Если Настройки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Параметр = Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
	Возврат ?(Параметр = Неопределено, Неопределено, Параметр.Значение);
КонецФункции

Функция ПолучитьТаблицуКоманд()
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
КонецПроцедуры

#КонецОбласти

#КонецЕсли
