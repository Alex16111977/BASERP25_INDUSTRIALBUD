#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Внешний отчёт А_РасшифровкаПартийСписаннойНоменклатуры.
// «Розшифровка партій списаної номенклатури» — программная компоновка СКД
// (ПриКомпоновкеРезультата): данные строит ObjectModule (ПолучитьДанные),
// затем передаются в СКД как внешний набор данных "Данные".
//
// Задача: по выбранной Реализации показать, из какой первичной приходной накладной
// пришла каждая списанная позиция. В проводках списания партия номенклатуры — это, как
// правило, документ Перемещение (товар гонялся между складами). Алгоритм рекурсивно
// разворачивает цепочку партий назад через перемещения до первичного приходного документа.
//
// Причина программной компоновки: субконто РегистраБухгалтерии.Хозрасчетный
// (Партії / Номенклатура) НЕДОСТУПНЫ в запросе СКД на базе BuhBud — читаются только
// через НаборЗаписей + итерацию Запись.СубконтоКт.
//
// Алгоритм проверен Python-COM (Rule #-1): _Rarzrabotki/Python/test/probe_partii_full.py.
// Эталон: Реализація ІБ00-000113 (2026), «Біта РН 2*50 мм» -> «Надходження ІБ00-007655».
// Образец движка: А_ПланФактныйПроизводствоПолный.

#Область СлужебныйПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	МассивНазначений = Новый Массив;
	МассивНазначений.Добавить("");

	ИмяОтчета = Метаданные().Представление();

	ПараметрыРегистрации.Вставить("Вид", "ДополнительныйОтчет");
	ПараметрыРегистрации.Вставить("Назначение", МассивНазначений);
	ПараметрыРегистрации.Вставить("Наименование", ИмяОтчета);
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Истина);
	ПараметрыРегистрации.Вставить("Информация", "Розшифровка партій списаної номенклатури до первинного приходу");

	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд, ИмяОтчета, Метаданные().ПолноеИмя(), "ОткрытиеФормы", Истина);
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);

	Возврат ПараметрыРегистрации;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Программная компоновка: данные готовятся в ПолучитьДанные и передаются в СКД
// как внешний набор данных "Данные". Расшифровка штатная (ДанныеРасшифровки прокидывается).
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	УстановитьПривилегированныйРежим(Истина);

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();

	ДокументРеализации = ПолучитьЗначениеПараметра(Настройки, "ДокументРеализации");

	ТаблицаДанные = ПолучитьДанные(ДокументРеализации);

	ВнешниеНаборыДанных = Новый Структура("Данные", ТаблицаДанные);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Главный сбор данных: по выбранной Реализации строит плоскую ТЗ грейна
// (Документ, Номенклатура, ПартияСписания, ПартияПрихода, Количество, Сумма).
// Кол/Сумма (себестоимость списания) относятся к уровню ПартияСписания и ставятся
// на первую (после УпорядочитьПриходы — реальный приход) строку ПартияПрихода;
// остальные приходы-кандидаты multi-batch = 0, чтобы итоги по ПартияСписания не задваивались.
Функция ПолучитьДанные(ДокументРеализации) Экспорт

	ТЗ = СоздатьПустуюТаблицу();

	Если НЕ ЗначениеЗаполнено(ДокументРеализации) Тогда
		Возврат ТЗ;
	КонецЕсли;

	ВидПартии = ВидСубконтоПартии(ДокументРеализации);
	Если ВидПартии = Неопределено Тогда
		Возврат ТЗ;
	КонецЕсли;

	Кэш = Новый Соответствие;

	// 1. Кт-строки реализации, агрегируем по (Номенклатура, ПартияСписания).
	Агрегаты = Новый Соответствие;
	Для Каждого Стр Из КтСтроки(ДокументРеализации, ВидПартии, Кэш) Цикл
		Если Стр.Номенклатура = Неопределено ИЛИ Стр.Партия = Неопределено Тогда
			Продолжить; // отсекаем не-товарные строки (702, 6432 и т.п.)
		КонецЕсли;
		Ключ = КлючСсылки(Стр.Номенклатура) + "##" + КлючСсылки(Стр.Партия);
		Агрегат = Агрегаты.Получить(Ключ);
		Если Агрегат = Неопределено Тогда
			Агрегат = Новый Структура("Номенклатура, Партия, Количество, Сумма",
				Стр.Номенклатура, Стр.Партия, 0, 0);
			Агрегаты.Вставить(Ключ, Агрегат);
		КонецЕсли;
		Агрегат.Количество = Агрегат.Количество + Стр.Количество;
		Агрегат.Сумма = Агрегат.Сумма + Стр.Сумма;
	КонецЦикла;

	// 2. Для каждой пары — рекурсивный трейс до первичного приходного документа.
	Для Каждого КлючЗначение Из Агрегаты Цикл
		Агрегат = КлючЗначение.Значение;
		Посещенные = Новый Соответствие;
		Приходы = ТрейсДоПрихода(Агрегат.Номенклатура, Агрегат.Партия, ВидПартии, Кэш, Посещенные, 0);
		Если Приходы.Количество() = 0 Тогда
			Приходы.Добавить(Агрегат.Партия);
		КонецЕсли;
		// Детерминированный порядок: реальные приходы (не Перемещение) выше тупиков-Перемещений,
		// внутри — по ключу ссылки. Так Кол/Сум (первая строка) при multi-batch попадают на
		// реальный приходный документ, а вывод стабилен между запусками.
		Приходы = УпорядочитьПриходы(Приходы);
		Индекс = 0;
		Для Каждого Приход Из Приходы Цикл
			НоваяСтрока = ТЗ.Добавить();
			НоваяСтрока.Документ = ДокументРеализации;
			НоваяСтрока.Номенклатура = Агрегат.Номенклатура;
			НоваяСтрока.ПартияСписания = Агрегат.Партия;
			НоваяСтрока.ПартияПрихода = Приход;
			Если Индекс = 0 Тогда
				НоваяСтрока.Количество = Агрегат.Количество;
				НоваяСтрока.Сумма = Агрегат.Сумма;
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;
	КонецЦикла;

	Возврат ТЗ;

КонецФункции

// Рекурсия: разворачивает партию-Перемещение до первичного приходного документа.
// Терминал = первый документ, который НЕ ПеремещениеТоваров (Надходження, Оприбуткування,
// Авансовий звіт, Звіт виробництва і т.п.). Если перемещение собрало номенклатуру из
// нескольких партий-источников — возвращается несколько приходов-кандидатов (multi-batch).
// Возвращает Массив ссылок на приходные документы (с дедупликацией).
Функция ТрейсДоПрихода(Номенклатура, Партия, ВидПартии, Кэш, Посещенные, Глубина)

	Результат = Новый Массив;

	Если Партия = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	КлючП = КлючСсылки(Партия);
	Если Глубина > 50 ИЛИ Посещенные.Получить(КлючП) <> Неопределено Тогда
		Результат.Добавить(Партия); // защита от циклов
		Возврат Результат;
	КонецЕсли;
	Посещенные.Вставить(КлючП, Истина);

	Если ТипЗнч(Партия) <> Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		Результат.Добавить(Партия); // терминал — первый не-Перемещение
		Возврат Результат;
	КонецЕсли;

	// Партия — Перемещение: читаем его Кт-партии по той же номенклатуре.
	КлючНом = КлючСсылки(Номенклатура);
	Источники = Новый Массив;
	КлючиИсточников = Новый Соответствие;
	Для Каждого Стр Из КтСтроки(Партия, ВидПартии, Кэш) Цикл
		Если Стр.Номенклатура <> Неопределено
			И КлючСсылки(Стр.Номенклатура) = КлючНом
			И Стр.Партия <> Неопределено Тогда
			КлючИст = КлючСсылки(Стр.Партия);
			Если КлючиИсточников.Получить(КлючИст) = Неопределено Тогда
				КлючиИсточников.Вставить(КлючИст, Истина);
				Источники.Добавить(Стр.Партия);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если Источники.Количество() = 0 Тогда
		Результат.Добавить(Партия); // тупик — показываем само перемещение
		Возврат Результат;
	КонецЕсли;

	КлючиИтога = Новый Соответствие;
	Для Каждого Источник Из Источники Цикл
		Для Каждого Приход Из ТрейсДоПрихода(Номенклатура, Источник, ВидПартии, Кэш, Посещенные, Глубина + 1) Цикл
			КлючПрих = КлючСсылки(Приход);
			Если КлючиИтога.Получить(КлючПрих) = Неопределено Тогда
				КлючиИтога.Вставить(КлючПрих, Истина);
				Результат.Добавить(Приход);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Детерминированный порядок приходов-кандидатов (multi-batch): реальные приходные документы
// (не ПеремещениеТоваров) первыми, внутри группы — по строковому ключу ссылки. Гарантирует,
// что Кол/Сум (первая строка) попадают на реальный приход, а вывод стабилен между запусками.
Функция УпорядочитьПриходы(Приходы)
	ТипПеремещение = Тип("ДокументСсылка.ПеремещениеТоваров");
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Приход");
	Таблица.Колонки.Добавить("ЭтоТерминал", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));
	Для Каждого Приход Из Приходы Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Приход = Приход;
		СтрокаТаблицы.ЭтоТерминал = (ТипЗнч(Приход) <> ТипПеремещение);
		СтрокаТаблицы.Ключ = КлючСсылки(Приход);
	КонецЦикла;
	Таблица.Сортировать("ЭтоТерминал Убыв, Ключ Возр");
	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Результат.Добавить(СтрокаТаблицы.Приход);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Кт-строки документа из РегистраБухгалтерии.Хозрасчетный (с кэшем по регистратору).
// Возвращает Массив структур (Номенклатура, Партия, Количество, Сумма) — только записи
// с КоличествоКт <> 0. Субконто читаются итерацией Запись.СубконтоКт (в запросе СКД недоступны):
// Номенклатура — субконто с типом СправочникСсылка.Номенклатура; Партия — субконто с видом ВидПартии.
Функция КтСтроки(Регистратор, ВидПартии, Кэш)

	КлючР = КлючСсылки(Регистратор);
	Результат = Кэш.Получить(КлючР);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = Новый Массив;
	НаборЗаписей = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
	НаборЗаписей.Прочитать();

	ТипНоменклатура = Тип("СправочникСсылка.Номенклатура");
	Для Каждого Запись Из НаборЗаписей Цикл
		Если Запись.КоличествоКт = 0 Тогда
			Продолжить;
		КонецЕсли;
		Номенклатура = Неопределено;
		Партия = Неопределено;
		Для Каждого Субконто Из Запись.СубконтоКт Цикл
			Если ТипЗнч(Субконто.Значение) = ТипНоменклатура Тогда
				Номенклатура = Субконто.Значение;
			ИначеЕсли Субконто.Ключ = ВидПартии Тогда
				Партия = Субконто.Значение;
			КонецЕсли;
		КонецЦикла;
		Стр = Новый Структура("Номенклатура, Партия, Количество, Сумма",
			Номенклатура, Партия, Запись.КоличествоКт, Запись.Сумма);
		Результат.Добавить(Стр);
	КонецЦикла;

	Кэш.Вставить(КлючР, Результат);
	Возврат Результат;

КонецФункции

// Вид субконто «Партії» РегистраБухгалтерии.Хозрасчетный — определяется по данным
// (на товарной Кт-строке документом является только субконто «Партії»). Не зависит от
// языка интерфейса. Состав типов субконто «Партії» = ОписаниеТиповПартии (9 типов документов).
Функция ВидСубконтоПартии(ДокументРеализации)

	НаборЗаписей = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ДокументРеализации);
	НаборЗаписей.Прочитать();

	ТипНоменклатура = Тип("СправочникСсылка.Номенклатура");
	ТипыПартии = ОписаниеТиповПартии();

	Для Каждого Запись Из НаборЗаписей Цикл
		ЕстьНоменклатура = Ложь;
		ВидДокумента = Неопределено;
		Для Каждого Субконто Из Запись.СубконтоКт Цикл
			ТипЗначения = ТипЗнч(Субконто.Значение);
			Если ТипЗначения = ТипНоменклатура Тогда
				ЕстьНоменклатура = Истина;
			ИначеЕсли ТипыПартии.СодержитТип(ТипЗначения) Тогда
				ВидДокумента = Субконто.Ключ;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьНоменклатура И ВидДокумента <> Неопределено Тогда
			Возврат ВидДокумента;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Строковый ключ ссылки (имя типа + UUID) для кэша / посещённых / дедупликации.
Функция КлючСсылки(СсылкаЗнч)
	Если СсылкаЗнч = Неопределено Тогда
		Возврат "Неопределено";
	КонецЕсли;
	Возврат XMLТип(ТипЗнч(СсылкаЗнч)).ИмяТипа + ":" + XMLСтрока(СсылкаЗнч);
КонецФункции

// Пустая ТЗ грейна (типы колонок = полям внешнего набора "Данные" схемы СКД).
Функция СоздатьПустуюТаблицу()

	ТЗ = Новый ТаблицаЗначений;
	ОписСумма = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписКоличество = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 3, ДопустимыйЗнак.Любой));
	ОписПартия = ОписаниеТиповПартии();

	ТЗ.Колонки.Добавить("Документ", Новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровУслуг"));
	ТЗ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("ПартияСписания", ОписПартия);
	ТЗ.Колонки.Добавить("ПартияПрихода", ОписПартия);
	ТЗ.Колонки.Добавить("Количество", ОписКоличество);
	ТЗ.Колонки.Добавить("Сумма", ОписСумма);

	Возврат ТЗ;

КонецФункции

// Составной тип субконто «Партії» РегистраБухгалтерии.Хозрасчетный (9 типов документов).
// Источник истины — ВидыСубконтоХозрасчетные.Партії.ТипЗначения; держать в синхроне с
// valueType полей ПартияСписания/ПартияПрихода в СКД-схеме.
Функция ОписаниеТиповПартии()
	Массив = Новый Массив;
	Массив.Добавить(Тип("ДокументСсылка.ПоступлениеТоваровУслуг"));
	Массив.Добавить(Тип("ДокументСсылка.ПеремещениеТоваров"));
