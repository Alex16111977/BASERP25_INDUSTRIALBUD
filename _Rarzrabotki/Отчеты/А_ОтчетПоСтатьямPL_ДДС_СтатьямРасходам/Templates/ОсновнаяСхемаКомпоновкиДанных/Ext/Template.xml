		<dataSource>ИсточникДанных1</dataSource>
		<query>////////////////////////////////////////////////////////////////////////////////
// Область проверки: только статьи денег (ДДС) и статьи затрат, выбранные в справочник А_Статьи_PL.
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ТЧ.СтатьяДвиженияДенежныхСредств КАК ДДС,
	ТЧ.Ссылка КАК PL
ПОМЕСТИТЬ втДДСвPL
ИЗ
	Справочник.А_Статьи_PL.Статьи КАК ТЧ
ГДЕ
	НЕ ТЧ.Ссылка.ПометкаУдаления
	И НЕ ТЧ.Ссылка.ЭтоГруппа
;
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ТЧ.СтатьяРасходов КАК СтатьяЗатрат
ПОМЕСТИТЬ втЗатратвPL
ИЗ
	Справочник.А_Статьи_PL.Статьи КАК ТЧ
ГДЕ
	НЕ ТЧ.Ссылка.ПометкаУдаления
	И НЕ ТЧ.Ссылка.ЭтоГруппа
	И ТЧ.СтатьяРасходов &lt;&gt; ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка)
;
////////////////////////////////////////////////////////////////////////////////
// Связи внутри области в обе стороны:
//   деньги → затраты: ДДС.А_СтатьяРасходов (так заполняется ТЧ PL)
//   затраты → деньги: СтатьяЗатрат.А_СтатьяДвиженияДенежныхСредств (по ней ФАКТ ЕРП попадает в PL)
ВЫБРАТЬ
	Д.ДДС КАК ДДС,
	Д.ДДС.А_СтатьяРасходов КАК СтатьяЗатрат,
	1 КАК ДеньгиКЗатратам,
	0 КАК ЗатратыКДеньгам
ПОМЕСТИТЬ втСвязи
ИЗ
	втДДСвPL КАК Д
ГДЕ
	Д.ДДС.А_СтатьяРасходов В
		(ВЫБРАТЬ
			З.СтатьяЗатрат
		ИЗ
			втЗатратвPL КАК З)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	З.СтатьяЗатрат.А_СтатьяДвиженияДенежныхСредств,
	З.СтатьяЗатрат,
	0,
	1
ИЗ
	втЗатратвPL КАК З
ГДЕ
	З.СтатьяЗатрат.А_СтатьяДвиженияДенежныхСредств В
		(ВЫБРАТЬ
			Д.ДДС
		ИЗ
			втДДСвPL КАК Д)
;
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Св.ДДС КАК ДДС,
	Св.СтатьяЗатрат КАК СтатьяЗатрат,
	МАКСИМУМ(Св.ДеньгиКЗатратам) КАК ДеньгиКЗатратам,
	МАКСИМУМ(Св.ЗатратыКДеньгам) КАК ЗатратыКДеньгам
ПОМЕСТИТЬ втПары
ИЗ
	втСвязи КАК Св

СГРУППИРОВАТЬ ПО
	Св.ДДС,
	Св.СтатьяЗатрат
;
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	П.СтатьяЗатрат КАК СтатьяЗатрат,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ П.ДДС) КАК ЧислоДДС
ПОМЕСТИТЬ втСчЗатрат
ИЗ
	втПары КАК П

СГРУППИРОВАТЬ ПО
	П.СтатьяЗатрат
;
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	П.ДДС КАК ДДС,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ П.СтатьяЗатрат) КАК ЧислоЗатрат
ПОМЕСТИТЬ втСчДДС
ИЗ
	втПары КАК П

СГРУППИРОВАТЬ ПО
	П.ДДС
;
////////////////////////////////////////////////////////////////////////////////
// Итог: каждая статья денег из PL × её связанные статьи затрат (или одна строка без статьи затрат)
ВЫБРАТЬ
	Д.PL.Группа КАК ГруппаPL,
	ЕСТЬNULL(Д.PL.Группа.Сорт, 0) КАК ГруппаСорт,
	Д.PL КАК СтатьяPL,
	Д.PL.Код КАК КодPL,
	Д.PL.Сорт КАК СортPL,
	Д.PL.ТипСтатьи КАК ТипСтатьи,
	Д.ДДС КАК ДДС,
	П.СтатьяЗатрат КАК СтатьяЗатрат,
	ВЫБОР
		КОГДА П.СтатьяЗатрат ЕСТЬ NULL
			ТОГДА &quot;нет статьи затрат&quot;
		КОГДА ЕСТЬNULL(П.ДеньгиКЗатратам, 0) = 1
				И ЕСТЬNULL(П.ЗатратыКДеньгам, 0) = 1
			ТОГДА &quot;взаимная (1:1)&quot;
		КОГДА ЕСТЬNULL(П.ДеньгиКЗатратам, 0) = 1
			ТОГДА &quot;только деньги -&gt; затраты&quot;
		ИНАЧЕ &quot;только затраты -&gt; деньги (факт)&quot;
	КОНЕЦ КАК ВидСвязи,
	П.СтатьяЗатрат.А_СтатьяДвиженияДенежныхСредств КАК ДДСФакта,
	ДФ.PL КАК PLФакта,
	ЕСТЬNULL(СчЗ.ЧислоДДС, 0) КАК СтатейДенегУЗатрат,
	ЕСТЬNULL(СчД.ЧислоЗатрат, 0) КАК СтатейЗатратУДенег,
	ВЫБОР
		КОГДА ЕСТЬNULL(СчЗ.ЧислоДДС, 0) &gt;= 2
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ПроблемаЗатрат,
	ВЫБОР
		КОГДА ЕСТЬNULL(СчД.ЧислоЗатрат, 0) &gt;= 2
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ПроблемаДенег,
	ВЫБОР
		КОГДА П.СтатьяЗатрат ЕСТЬ NULL
			ТОГДА 0
		КОГДА ДФ.PL ЕСТЬ NULL
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ФактВнеPL,
	ВЫБОР
		КОГДА П.СтатьяЗатрат ЕСТЬ NULL
			ТОГДА 0
		КОГДА ДФ.PL ЕСТЬ NULL
			ТОГДА 0
		КОГДА ДФ.PL &lt;&gt; Д.PL
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ФактВДругойPL,
	ВЫБОР
		КОГДА П.СтатьяЗатрат ЕСТЬ NULL
				И Д.PL.ТипСтатьи = ЗНАЧЕНИЕ(Перечисление.А_ТипСтатьиPL.Расход)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК НетСтатьиЗатрат,
	ВЫБОР
		КОГДА ЕСТЬNULL(СчЗ.ЧислоДДС, 0) &gt;= 2
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ + ВЫБОР
		КОГДА ЕСТЬNULL(СчД.ЧислоЗатрат, 0) &gt;= 2
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ + ВЫБОР
		КОГДА П.СтатьяЗатрат ЕСТЬ NULL
			ТОГДА 0
		КОГДА ДФ.PL ЕСТЬ NULL
			ТОГДА 1
		КОГДА ДФ.PL &lt;&gt; Д.PL
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ + ВЫБОР
		КОГДА П.СтатьяЗатрат ЕСТЬ NULL
				И Д.PL.ТипСтатьи = ЗНАЧЕНИЕ(Перечисление.А_ТипСтатьиPL.Расход)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК Проблем,
	1 КАК Строк
ИЗ
	втДДСвPL КАК Д
		ЛЕВОЕ СОЕДИНЕНИЕ втПары КАК П
		ПО П.ДДС = Д.ДДС
		ЛЕВОЕ СОЕДИНЕНИЕ втСчЗатрат КАК СчЗ
		ПО СчЗ.СтатьяЗатрат = П.СтатьяЗатрат
		ЛЕВОЕ СОЕДИНЕНИЕ втСчДДС КАК СчД
		ПО СчД.ДДС = Д.ДДС
		ЛЕВОЕ СОЕДИНЕНИЕ втДДСвPL КАК ДФ
		ПО ДФ.ДДС = П.СтатьяЗатрат.А_СтатьяДвиженияДенежныхСредств</query>
