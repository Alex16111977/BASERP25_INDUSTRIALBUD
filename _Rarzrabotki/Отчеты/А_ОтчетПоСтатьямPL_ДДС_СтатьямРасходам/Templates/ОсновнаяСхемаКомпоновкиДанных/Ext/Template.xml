		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	PL.Группа КАК ГруппаPL,
	ЕСТЬNULL(PL.Группа.Сорт, 0) КАК ГруппаСорт,
	PL.Ссылка КАК СтатьяPL,
	PL.Код КАК КодPL,
	PL.Сорт КАК СортPL,
	PL.ТипСтатьи КАК ТипСтатьи,
	ЕСТЬNULL(ТЧ.НомерСтроки, 0) КАК НомерСтроки,
	ТЧ.СтатьяДвиженияДенежныхСредств КАК ДДС,
	ТЧ.СтатьяРасходов КАК СтатьяРасходов,
	ЕСТЬNULL(ВхДДС.ЧислоPL, 0) КАК ВхожденийДДС,
	ЕСТЬNULL(ВхСР.ЧислоPL, 0) КАК ВхожденийСтатьиРасходов,
	ВЫБОР КОГДА ЕСТЬNULL(ВхДДС.ЧислоPL, 0) &gt;= 2 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ КАК ПроблемаДДС,
	ВЫБОР КОГДА ЕСТЬNULL(ВхСР.ЧислоPL, 0) &gt;= 2 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ КАК ПроблемаСтатьиРасходов,
	ВЫБОР КОГДА ТЧ.НомерСтроки ЕСТЬ NULL ТОГДА 1 ИНАЧЕ 0 КОНЕЦ КАК НетСтрок,
	ВЫБОР КОГДА ТЧ.НомерСтроки ЕСТЬ NULL ТОГДА 0 ИНАЧЕ 1 КОНЕЦ КАК КоличествоСтрок
ИЗ
	Справочник.А_Статьи_PL КАК PL
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.А_Статьи_PL.Статьи КАК ТЧ
		ПО ТЧ.Ссылка = PL.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				Т.СтатьяДвиженияДенежныхСредств КАК ДДС,
				КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.Ссылка) КАК ЧислоPL
			ИЗ Справочник.А_Статьи_PL.Статьи КАК Т
			ГДЕ НЕ Т.Ссылка.ПометкаУдаления
			СГРУППИРОВАТЬ ПО Т.СтатьяДвиженияДенежныхСредств) КАК ВхДДС
		ПО ВхДДС.ДДС = ТЧ.СтатьяДвиженияДенежныхСредств
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				Т.СтатьяРасходов КАК СР,
				КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.Ссылка) КАК ЧислоPL
			ИЗ Справочник.А_Статьи_PL.Статьи КАК Т
			ГДЕ НЕ Т.Ссылка.ПометкаУдаления
				И Т.СтатьяРасходов &lt;&gt; ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка)
			СГРУППИРОВАТЬ ПО Т.СтатьяРасходов) КАК ВхСР
		ПО ВхСР.СР = ТЧ.СтатьяРасходов
ГДЕ
	НЕ PL.ПометкаУдаления
	И НЕ PL.ЭтоГруппа</query>
