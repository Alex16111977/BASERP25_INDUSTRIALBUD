#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	УстановитьПривилегированныйРежим(Истина);

	// Отримання параметрів з СКД
	ПараметрПериодОтчета = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Период").Значение;
	НачалоПериода = ПараметрПериодОтчета.ДатаНачала;
	КонецПериода = КонецДня(ПараметрПериодОтчета.ДатаОкончания);

	// =============================================
	// 1. ЗАЛИШКИ ERP (РегістрБухгалтерії.Хозрасчетный)
	//    Рахунки 10x (ОсновніЗасоби) + 131 (ЗносОС)
	//    + РегСвед.ПервоначальныеСведенияОС
	// =============================================
	ТаблицаОС_ЕРП = ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода);

	// =============================================
	// 2. ЗАЛИШКИ BUHBUD (COM + РегБух.Хозрасчетный)
	//    Рахунки 10x (ОсновніЗасоби) + 131 (ЗносОС)
	//    + РегСвед.ПервоначальныеСведенияОСБухгалтерскийУчет
	// =============================================
	СтрокаПодключенияBuhBud = А_ПодключенияБазСервер.СтрокаПодключения("bas_industrialbud");
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияBuhBud));
	Исключение
		Сообщить("Помилка підключення до BuhBud: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ТаблицаОС_BuhBud = ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода);

	// Звільнення COM-з'єднання
	V83 = Неопределено;
	V8 = Неопределено;

	// =============================================
	// 2.1. КОНВЕРТАЦІЯ BuhBud: А_ИдКод -> СправочникСсылка.ОбъектыЭксплуатации
	//      через тимчасову таблицю + LEFT JOIN
	// =============================================
	ТаблицаОС_BuhBud = КонвертироватьТЗ_BuhBud(ТаблицаОС_BuhBud);

	// =============================================
	// 3. ОБ'ЄДНАННЯ та ПОРІВНЯННЯ по А_ИдКод
	// =============================================
	ТаблицаОС_Сравнение = ОбъединитьТаблицы(ТаблицаОС_ЕРП, ТаблицаОС_BuhBud);

	// =============================================
	// 4. ПЕРЕДАЧА В СКД
	// =============================================
	ВнешниеНаборыДанных = Новый Структура("ОС_Сравнение", ТаблицаОС_Сравнение);

	// Формування звіту
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// =====================================================================
// ЗАЛИШКИ ERP
// Запит 1: РегБух.Хозрасчетный.ОстаткиИОбороты (рах. 10x)
//          → НачОстаток, ОборотДт, ОборотКт, КонОстаток, Кількість
// Запит 2: РегБух.Хозрасчетный.Остатки (рах. 131 — амортизація)
// Запит 3: РегСвед.ПервоначальныеСведенияОС.СрезПоследних
//          → ПервоначальнаяСтоимостьБУ
// =====================================================================
Функция ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	ТипСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("А_ИдКод", ТипСтрока);
	Результат.Колонки.Добавить("ОС",
		Новый ОписаниеТипов("СправочникСсылка.ОбъектыЭксплуатации"));
	Результат.Колонки.Добавить("Количество_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("НачальныйОстаток_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("ОборотДт_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("ОборотКт_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("КонечныйОстаток_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("ПервоначальнаяСтоимость_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("Амортизация_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("ОстаточнаяСтоимость_ЕРП", ТипЧисло);

	// 1. Залишки і обороти по рахунках 10x (ОстаткиИОбороты)
	ЗапросОС = Новый Запрос;
	ЗапросОС.Текст =
	"ВЫБРАТЬ
	|	ОЭ.Ссылка КАК ОбъектЭксплуатации,
	|	ОЭ.А_ИдКод КАК А_ИдКод,
	|	СУММА(Ост.СуммаНачальныйОстатокДт) КАК НачальныйОстаток,
	|	СУММА(Ост.СуммаОборотДт) КАК ОборотДт,
	|	СУММА(Ост.СуммаОборотКт) КАК ОборотКт,
	|	СУММА(Ост.СуммаКонечныйОстатокДт) КАК КонечныйОстаток,
	|	СУММА(Ост.КоличествоКонечныйОстатокДт) КАК Количество
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|		&НачалоПериода,
	|		&КонецПериода) КАК Ост
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбъектыЭксплуатации КАК ОЭ
	|	ПО Ост.Субконто1 = ОЭ.Ссылка
	|ГДЕ
	|	(Ост.Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОсновныеСредства))
	|		ИЛИ Ост.Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.МалоценныеНеоборотныеМатериальныеАктивыИндивидуально))
	|	И Ост.Субконто1 ССЫЛКА Справочник.ОбъектыЭксплуатации
	|	И (Ост.СуммаКонечныйОстатокДт > 0
	|		ИЛИ Ост.СуммаОборотДт > 0
	|		ИЛИ Ост.СуммаОборотКт > 0
	|		ИЛИ Ост.СуммаНачальныйОстатокДт > 0)
	|СГРУППИРОВАТЬ ПО
	|	ОЭ.Ссылка,
	|	ОЭ.А_ИдКод";

	ЗапросОС.УстановитьПараметр("НачалоПериода", НачалоПериода);
	ЗапросОС.УстановитьПараметр("КонецПериода", КонецПериода);

	Попытка
		ВыборкаОС = ЗапросОС.Выполнить().Выбрать();
	Исключение
		Сообщить("Помилка запиту залишків ОС (ERP): " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	// 2. Амортизація по рахунку 131 (залишок на кінець періоду)
	ЗапросАморт = Новый Запрос;
	ЗапросАморт.Текст =
	"ВЫБРАТЬ
	|	ОЭ.А_ИдКод КАК А_ИдКод,
	|	СУММА(Ост.СуммаОстатокКт) КАК НакопленнаяАмортизация
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|		&КонецПериода,
	|		Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ИзносОсновныхСредств))
	|			ИЛИ Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ИзносДругихНеоборотныхМатериальныхАктивовИндивидуально),
	|		,) КАК Ост
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбъектыЭксплуатации КАК ОЭ
	|	ПО Ост.Субконто1 = ОЭ.Ссылка
	|ГДЕ
	|	Ост.Субконто1 ССЫЛКА Справочник.ОбъектыЭксплуатации
	|	И Ост.СуммаОстатокКт > 0
	|СГРУППИРОВАТЬ ПО
	|	ОЭ.А_ИдКод";

	ЗапросАморт.УстановитьПараметр("КонецПериода", КонецПериода);

	// Збираємо амортизацію у відповідність А_ИдКод -> сума
	СоответствиеАморт = Новый Соответствие;
	Попытка
		ВыборкаАморт = ЗапросАморт.Выполнить().Выбрать();
		Пока ВыборкаАморт.Следующий() Цикл
			Если НЕ ПустаяСтрока(ВыборкаАморт.А_ИдКод) Тогда
				СоответствиеАморт.Вставить(СокрЛП(ВыборкаАморт.А_ИдКод), ВыборкаАморт.НакопленнаяАмортизация);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Сообщить("Помилка запиту амортизації (ERP): " + ОписаниеОшибки());
	КонецПопытки;

	// 3. Первісна вартість з РегістрВідомостей.ПервоначальныеСведенияОС
	//    (залишок на рах. 10x ≠ первісна вартість після переоцінки/зменшення корисності)
	ЗапросПервоначСтоимость = Новый Запрос;
	ЗапросПервоначСтоимость.Текст =
	"ВЫБРАТЬ
	|	Сведения.ОсновноеСредство.А_ИдКод КАК А_ИдКод,
	|	Сведения.ПервоначальнаяСтоимостьБУ КАК ПервоначальнаяСтоимость
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОС.СрезПоследних(
	|		&КонецПериода, ) КАК Сведения
	|ГДЕ
	|	Сведения.ПервоначальнаяСтоимостьБУ > 0";

	ЗапросПервоначСтоимость.УстановитьПараметр("КонецПериода", КонецПериода);

	СоответствиеПервоначСтоимость = Новый Соответствие;
	Попытка
		ВыборкаПервоначСтоимость = ЗапросПервоначСтоимость.Выполнить().Выбрать();
		Пока ВыборкаПервоначСтоимость.Следующий() Цикл
			Если НЕ ПустаяСтрока(ВыборкаПервоначСтоимость.А_ИдКод) Тогда
				СоответствиеПервоначСтоимость.Вставить(
					СокрЛП(ВыборкаПервоначСтоимость.А_ИдКод),
					ВыборкаПервоначСтоимость.ПервоначальнаяСтоимость);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Сообщить("Помилка запиту первісної вартості (ERP): " + ОписаниеОшибки());
	КонецПопытки;

	// 4. Об'єднання ОС + амортизація + первісна вартість
	Пока ВыборкаОС.Следующий() Цикл
		ИдКод = СокрЛП(ВыборкаОС.А_ИдКод);
		Если ПустаяСтрока(ИдКод) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.А_ИдКод = ИдКод;
		НоваяСтрока.ОС = ВыборкаОС.ОбъектЭксплуатации;
		НоваяСтрока.Количество_ЕРП = ?(ВыборкаОС.Количество > 0, ВыборкаОС.Количество, 1);
		НоваяСтрока.НачальныйОстаток_ЕРП = ВыборкаОС.НачальныйОстаток;
		НоваяСтрока.ОборотДт_ЕРП = ВыборкаОС.ОборотДт;
		НоваяСтрока.ОборотКт_ЕРП = ВыборкаОС.ОборотКт;
		НоваяСтрока.КонечныйОстаток_ЕРП = ВыборкаОС.КонечныйОстаток;

		// Первісна вартість з ПервоначальныеСведенияОС
		ПервоначСтоимость = СоответствиеПервоначСтоимость.Получить(ИдКод);
		НоваяСтрока.ПервоначальнаяСтоимость_ЕРП = ?(ПервоначСтоимость <> Неопределено, ПервоначСтоимость, 0);

		// Амортизація
		АмортСумма = СоответствиеАморт.Получить(ИдКод);
		Если АмортСумма <> Неопределено Тогда
			НоваяСтрока.Амортизация_ЕРП = АмортСумма;
		КонецЕсли;

		// Залишкова вартість = Первісна (з рег.свед.) - Амортизація
		НоваяСтрока.ОстаточнаяСтоимость_ЕРП = НоваяСтрока.ПервоначальнаяСтоимость_ЕРП - НоваяСтрока.Амортизация_ЕРП;
	КонецЦикла;

	Возврат Результат;

КонецФункции


// =====================================================================
// ЗАЛИШКИ BuhBud (COM)
// Запит 1: РегБух.Хозрасчетный.ОстаткиИОбороты (рах. 10x)
//          → НачОстаток, ОборотДт, ОборотКт, КонОстаток, Кількість
// Запит 2: РегБух.Хозрасчетный.Остатки (рах. 131 — амортизація)
// Запит 3: РегСвед.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних
//          → ПервоначальнаяСтоимость
// =====================================================================
Функция ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	ТипСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("А_ИдКод", ТипСтрока);
	Результат.Колонки.Добавить("ОС_Наименование", ТипСтрока);
	Результат.Колонки.Добавить("ОС_Код", ТипСтрока);
	Результат.Колонки.Добавить("КодСчета", ТипСтрока);
	Результат.Колонки.Добавить("Количество_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("НачальныйОстаток_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("ОборотДт_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("ОборотКт_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("КонечныйОстаток_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("ПервоначальнаяСтоимость_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("Амортизация_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("ОстаточнаяСтоимость_BuhBud", ТипЧисло);

	// Фільтр по організаціях (А_ВБалансе = Істина)
	ЗапросОрганизаций = Новый Запрос;
	ЗапросОрганизаций.Текст =
	"ВЫБРАТЬ
	|	Организации.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.А_ВБалансе = ИСТИНА
	|	И Организации.КодПоЕДРПОУ <> """"";

	масКодПоЕДРПОУ_V83 = V83.NewObject("Массив");
	ВыборкаОрганизаций = ЗапросОрганизаций.Выполнить().Выбрать();
	Пока ВыборкаОрганизаций.Следующий() Цикл
		масКодПоЕДРПОУ_V83.Добавить(ВыборкаОрганизаций.КодПоЕДРПОУ);
	КонецЦикла;

	Если масКодПоЕДРПОУ_V83.Количество() = 0 Тогда
		Сообщить("Немає організацій з флагом А_ВБалансе!");
		Возврат Результат;
	КонецЕсли;

	// 1. Залишки і обороти ОС по рахунках 10x (ОстаткиИОбороты)
	ЗапросОС = V83.NewObject("Запрос");
	ЗапросОС.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.ОсновныеСредства).А_ИдКод КАК ОС_А_ИдКод,
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.ОсновныеСредства).Наименование КАК ОС_Наименование,
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.ОсновныеСредства).Код КАК ОС_Код,
	|	Ост.Счет.Код КАК КодСчета,
	|	СУММА(Ост.СуммаНачальныйОстатокДт) КАК НачальныйОстаток,
	|	СУММА(Ост.СуммаОборотДт) КАК ОборотДт,
	|	СУММА(Ост.СуммаОборотКт) КАК ОборотКт,
	|	СУММА(Ост.СуммаКонечныйОстатокДт) КАК КонечныйОстаток,
	|	СУММА(Ост.КоличествоКонечныйОстатокДт) КАК КолВо
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|		&НачалоПериода,
	|		&КонецПериода) КАК Ост
	|ГДЕ
	|	(Ост.Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОсновныеСредства))
	|		ИЛИ Ост.Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.МалоценныеНеоборотныеМатериальныеАктивыИндивидуально))
	|	И Ост.Субконто1 ССЫЛКА Справочник.ОсновныеСредства
	|	И (Ост.СуммаКонечныйОстатокДт > 0
	|		ИЛИ Ост.СуммаОборотДт > 0
	|		ИЛИ Ост.СуммаОборотКт > 0
	|		ИЛИ Ост.СуммаНачальныйОстатокДт > 0)
	|	И Ост.Организация.КодПоЕДРПОУ В (&масКодПоЕДРПОУ)
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.ОсновныеСредства).А_ИдКод,
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.ОсновныеСредства).Наименование,
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.ОсновныеСредства).Код,
	|	Ост.Счет.Код";

	ЗапросОС.УстановитьПараметр("НачалоПериода", НачалоПериода);
	ЗапросОС.УстановитьПараметр("КонецПериода", КонецПериода);
	ЗапросОС.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);

	// Серіалізація через COM
	Попытка
		ТЗ_ОС = ЗапросОС.Выполнить().Выгрузить();
		стр_ТЗ_ОС = V83.ЗначениеВСтрокуВнутр(ТЗ_ОС);
		ТаблицаОС = ЗначениеИзСтрокиВнутр(стр_ТЗ_ОС);
	Исключение
		Сообщить("Помилка запиту залишків ОС (BuhBud): " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	// 2. Амортизація по рахунку 131 (залишок на кінець періоду)
	ЗапросАморт = V83.NewObject("Запрос");
	ЗапросАморт.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.ОсновныеСредства).А_ИдКод КАК ОС_А_ИдКод,
	|	СУММА(Ост.СуммаОстатокКт) КАК НакопленнаяАмортизация
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|		&КонецПериода,
	|		Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ИзносОсновныхСредств))
	|			ИЛИ Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ИзносДругихНеоборотныхМатериальныхАктивовИндивидуально),
	|		,) КАК Ост
	|ГДЕ
	|	Ост.Субконто1 ССЫЛКА Справочник.ОсновныеСредства
	|	И Ост.СуммаОстатокКт > 0
	|	И Ост.Организация.КодПоЕДРПОУ В (&масКодПоЕДРПОУ)
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.ОсновныеСредства).А_ИдКод";

	ЗапросАморт.УстановитьПараметр("КонецПериода", КонецПериода);
	ЗапросАморт.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);

	СоответствиеАморт = Новый Соответствие;
	Попытка
		ТЗ_Аморт = ЗапросАморт.Выполнить().Выгрузить();
		стр_ТЗ_Аморт = V83.ЗначениеВСтрокуВнутр(ТЗ_Аморт);
		ТаблицаАморт = ЗначениеИзСтрокиВнутр(стр_ТЗ_Аморт);

		Для Каждого СтрокаАморт Из ТаблицаАморт Цикл
			ИдКод = СокрЛП(СтрокаАморт.ОС_А_ИдКод);
			Если НЕ ПустаяСтрока(ИдКод) Тогда
				СоответствиеАморт.Вставить(ИдКод, СтрокаАморт.НакопленнаяАмортизация);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Сообщить("Помилка запиту амортизації (BuhBud): " + ОписаниеОшибки());
	КонецПопытки;

	// 3. Первісна вартість з РегСвед.ПервоначальныеСведенияОСБухгалтерскийУчет
	ЗапросПервонач = V83.NewObject("Запрос");
	ЗапросПервонач.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Сведения.ОсновноеСредство КАК Справочник.ОсновныеСредства).А_ИдКод КАК ОС_А_ИдКод,
	|	Сведения.ПервоначальнаяСтоимость КАК ПервоначальнаяСтоимость
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних(
	|		&КонецПериода, ) КАК Сведения
	|ГДЕ
	|	Сведения.ПервоначальнаяСтоимость > 0
	|	И Сведения.Организация.КодПоЕДРПОУ В (&масКодПоЕДРПОУ)";

	ЗапросПервонач.УстановитьПараметр("КонецПериода", КонецПериода);
	ЗапросПервонач.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);

	СоответствиеПервоначСтоимость = Новый Соответствие;
	Попытка
		ТЗ_Первонач = ЗапросПервонач.Выполнить().Выгрузить();
		стр_ТЗ_Первонач = V83.ЗначениеВСтрокуВнутр(ТЗ_Первонач);
		ТаблицаПервонач = ЗначениеИзСтрокиВнутр(стр_ТЗ_Первонач);

		Для Каждого СтрокаПервонач Из ТаблицаПервонач Цикл
			ИдКод = СокрЛП(СтрокаПервонач.ОС_А_ИдКод);
			Если НЕ ПустаяСтрока(ИдКод) Тогда
				СоответствиеПервоначСтоимость.Вставить(ИдКод, СтрокаПервонач.ПервоначальнаяСтоимость);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Сообщить("Помилка запиту первісної вартості (BuhBud): " + ОписаниеОшибки());
	КонецПопытки;

	// 4. Заповнення результату: ОС + обороти + амортизація + первісна вартість
	Для Каждого СтрокаОС Из ТаблицаОС Цикл
		ИдКод = СокрЛП(СтрокаОС.ОС_А_ИдКод);
		Если ПустаяСтрока(ИдКод) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.А_ИдКод = ИдКод;
		НоваяСтрока.ОС_Наименование = СтрокаОС.ОС_Наименование;
		НоваяСтрока.ОС_Код = СокрЛП(СтрокаОС.ОС_Код);
		НоваяСтрока.КодСчета = СокрЛП(СтрокаОС.КодСчета);
		НоваяСтрока.Количество_BuhBud = ?(СтрокаОС.КолВо > 0, СтрокаОС.КолВо, 1);
		НоваяСтрока.НачальныйОстаток_BuhBud = СтрокаОС.НачальныйОстаток;
		НоваяСтрока.ОборотДт_BuhBud = СтрокаОС.ОборотДт;
		НоваяСтрока.ОборотКт_BuhBud = СтрокаОС.ОборотКт;
		НоваяСтрока.КонечныйОстаток_BuhBud = СтрокаОС.КонечныйОстаток;

		// Первісна вартість з рег.свед.
		ПервоначСтоимость = СоответствиеПервоначСтоимость.Получить(ИдКод);
		НоваяСтрока.ПервоначальнаяСтоимость_BuhBud = ?(ПервоначСтоимость <> Неопределено, ПервоначСтоимость, 0);

		// Амортизація
		АмортСумма = СоответствиеАморт.Получить(ИдКод);
		Если АмортСумма <> Неопределено Тогда
			НоваяСтрока.Амортизация_BuhBud = АмортСумма;
		КонецЕсли;

		// Залишкова вартість = Первісна (з рег.свед.) - Амортизація
		НоваяСтрока.ОстаточнаяСтоимость_BuhBud = НоваяСтрока.ПервоначальнаяСтоимость_BuhBud - НоваяСтрока.Амортизация_BuhBud;
	КонецЦикла;

	Возврат Результат;

КонецФункции


// =====================================================================
// КОНВЕРТАЦІЯ BuhBud: А_ИдКод -> СправочникСсылка.ОбъектыЭксплуатации
// Тимчасова таблиця + LEFT JOIN (як у звіті по товарах)
// =====================================================================
Функция КонвертироватьТЗ_BuhBud(ТаблицаBuhBud)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ.А_ИдКод,
	|	ВТ.ОС_Наименование,
	|	ВТ.ОС_Код,
	|	ВТ.КодСчета,
	|	ВТ.Количество_BuhBud,
	|	ВТ.НачальныйОстаток_BuhBud,
	|	ВТ.ОборотДт_BuhBud,
	|	ВТ.ОборотКт_BuhBud,
	|	ВТ.КонечныйОстаток_BuhBud,
	|	ВТ.ПервоначальнаяСтоимость_BuhBud,
	|	ВТ.Амортизация_BuhBud,
	|	ВТ.ОстаточнаяСтоимость_BuhBud
	|ПОМЕСТИТЬ ВТ_BuhBud
	|ИЗ
	|	&ТЗ КАК ВТ
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.А_ИдКод,
	|	ВТ.ОС_Наименование,
	|	ВТ.ОС_Код,
	|	ВТ.КодСчета,
	|	ОЭ.Ссылка КАК ОС,
	|	ВТ.Количество_BuhBud,
	|	ВТ.НачальныйОстаток_BuhBud,
	|	ВТ.ОборотДт_BuhBud,
	|	ВТ.ОборотКт_BuhBud,
	|	ВТ.КонечныйОстаток_BuhBud,
	|	ВТ.ПервоначальнаяСтоимость_BuhBud,
	|	ВТ.Амортизация_BuhBud,
	|	ВТ.ОстаточнаяСтоимость_BuhBud
	|ИЗ
	|	ВТ_BuhBud КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбъектыЭксплуатации КАК ОЭ
	|		ПО ВТ.А_ИдКод = ОЭ.А_ИдКод";

	Запрос.УстановитьПараметр("ТЗ", ТаблицаBuhBud);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции


// =====================================================================
// ОБ'ЄДНАННЯ ТАБЛИЦЬ ERP + BuhBud по А_ИдКод
// Результат — єдина таблиця для СКД з розбіжностями
// 1 вимір (ОС) + 24 числових колонки
// =====================================================================
Функция ОбъединитьТаблицы(ТаблицаЕРП, ТаблицаBuhBud)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ОС",
		Новый ОписаниеТипов("СправочникСсылка.ОбъектыЭксплуатации"));

	// Кількість
	Результат.Колонки.Добавить("Количество_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("Количество_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("РазницаКоличество", ТипЧисло);

	// Залишки і обороти по бух.обліку (рах. 10x)
	Результат.Колонки.Добавить("НачальныйОстаток_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("НачальныйОстаток_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("РазницаНачОстаток", ТипЧисло);
	Результат.Колонки.Добавить("ОборотДт_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("ОборотДт_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("РазницаОборотДт", ТипЧисло);
	Результат.Колонки.Добавить("ОборотКт_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("ОборотКт_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("РазницаОборотКт", ТипЧисло);
	Результат.Колонки.Добавить("КонечныйОстаток_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("КонечныйОстаток_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("РазницаКонОстаток", ТипЧисло);

	// Первісна вартість (з реєстру відомостей)
	Результат.Колонки.Добавить("ПервоначальнаяСтоимость_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("ПервоначальнаяСтоимость_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("РазницаСтоимость", ТипЧисло);

	// Амортизація (рах. 131)
	Результат.Колонки.Добавить("Амортизация_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("Амортизация_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("РазницаАмортизация", ТипЧисло);

	// Залишкова вартість
	Результат.Колонки.Добавить("ОстаточнаяСтоимость_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("ОстаточнаяСтоимость_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("РазницаОстСтоимость", ТипЧисло);

	// Індекс ERP по А_ИдКод
	ИндексЕРП = Новый Соответствие;
	НомерСтроки = 0;

	// 1. Додаємо всі записи ERP
	Для Каждого СтрокаЕРП Из ТаблицаЕРП Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.ОС = СтрокаЕРП.ОС;
		НоваяСтрока.Количество_ЕРП = СтрокаЕРП.Количество_ЕРП;
		НоваяСтрока.НачальныйОстаток_ЕРП = СтрокаЕРП.НачальныйОстаток_ЕРП;
		НоваяСтрока.ОборотДт_ЕРП = СтрокаЕРП.ОборотДт_ЕРП;
		НоваяСтрока.ОборотКт_ЕРП = СтрокаЕРП.ОборотКт_ЕРП;
		НоваяСтрока.КонечныйОстаток_ЕРП = СтрокаЕРП.КонечныйОстаток_ЕРП;
		НоваяСтрока.ПервоначальнаяСтоимость_ЕРП = СтрокаЕРП.ПервоначальнаяСтоимость_ЕРП;
		НоваяСтрока.Амортизация_ЕРП = СтрокаЕРП.Амортизация_ЕРП;
		НоваяСтрока.ОстаточнаяСтоимость_ЕРП = СтрокаЕРП.ОстаточнаяСтоимость_ЕРП;

		ИндексЕРП.Вставить(СтрокаЕРП.А_ИдКод, НомерСтроки);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	// 2. Додаємо/оновлюємо записи BuhBud
	Для Каждого СтрокаBuhBud Из ТаблицаBuhBud Цикл
		НомерВРезультате = ИндексЕРП.Получить(СтрокаBuhBud.А_ИдКод);

		Если НомерВРезультате <> Неопределено Тогда
			// Знайдено в ERP — дозаповнюємо
			СтрокаРезультата = Результат.Получить(НомерВРезультате);
		Иначе
			// Немає в ERP — додаємо нову (тільки BuhBud)
			СтрокаРезультата = Результат.Добавить();
			СтрокаРезультата.ОС = СтрокаBuhBud.ОС;
		КонецЕсли;

		СтрокаРезультата.Количество_BuhBud = СтрокаBuhBud.Количество_BuhBud;
		СтрокаРезультата.НачальныйОстаток_BuhBud = СтрокаBuhBud.НачальныйОстаток_BuhBud;
		СтрокаРезультата.ОборотДт_BuhBud = СтрокаBuhBud.ОборотДт_BuhBud;
		СтрокаРезультата.ОборотКт_BuhBud = СтрокаBuhBud.ОборотКт_BuhBud;
		СтрокаРезультата.КонечныйОстаток_BuhBud = СтрокаBuhBud.КонечныйОстаток_BuhBud;
		СтрокаРезультата.ПервоначальнаяСтоимость_BuhBud = СтрокаBuhBud.ПервоначальнаяСтоимость_BuhBud;
		СтрокаРезультата.Амортизация_BuhBud = СтрокаBuhBud.Амортизация_BuhBud;
		СтрокаРезультата.ОстаточнаяСтоимость_BuhBud = СтрокаBuhBud.ОстаточнаяСтоимость_BuhBud;
	КонецЦикла;

	// 3. Обчислення різниць
	Для Каждого СтрокаРезультата Из Результат Цикл
		СтрокаРезультата.РазницаКоличество = СтрокаРезультата.Количество_ЕРП - СтрокаРезультата.Количество_BuhBud;
		СтрокаРезультата.РазницаНачОстаток = СтрокаРезультата.НачальныйОстаток_ЕРП - СтрокаРезультата.НачальныйОстаток_BuhBud;
		СтрокаРезультата.РазницаОборотДт = СтрокаРезультата.ОборотДт_ЕРП - СтрокаРезультата.ОборотДт_BuhBud;
		СтрокаРезультата.РазницаОборотКт = СтрокаРезультата.ОборотКт_ЕРП - СтрокаРезультата.ОборотКт_BuhBud;
		СтрокаРезультата.РазницаКонОстаток = СтрокаРезультата.КонечныйОстаток_ЕРП - СтрокаРезультата.КонечныйОстаток_BuhBud;
		СтрокаРезультата.РазницаСтоимость = СтрокаРезультата.ПервоначальнаяСтоимость_ЕРП - СтрокаРезультата.ПервоначальнаяСтоимость_BuhBud;
		СтрокаРезультата.РазницаАмортизация = СтрокаРезультата.Амортизация_ЕРП - СтрокаРезультата.Амортизация_BuhBud;
		СтрокаРезультата.РазницаОстСтоимость = СтрокаРезультата.ОстаточнаяСтоимость_ЕРП - СтрокаРезультата.ОстаточнаяСтоимость_BuhBud;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецЕсли
