
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьПериод(Команда)
	Диалог = Новый ДиалогРедактированияСтандартногоПериода;
	Если ЗначениеЗаполнено(Объект.НачалоПериода) Тогда
		Диалог.Период.ДатаНачала = Объект.НачалоПериода;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		Диалог.Период.ДатаОкончания = КонецДня(Объект.ОкончаниеПериода);
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
	Диалог.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодЗавершение(Период, ДополнительныеПараметры) Экспорт
	Если Период <> Неопределено Тогда
		Объект.НачалоПериода    = Период.ДатаНачала;
		Объект.ОкончаниеПериода = НачалоДня(Период.ДатаОкончания);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.СтатьяДвиженияДенежныхСредств) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Не выбрана статья ДДС.'"));
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Не задан период.'"));
		Возврат;
	КонецЕсли;
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатьюДенегВДоговорах(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.СтатьяДвиженияДенежныхСредств) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Не выбрана статья ДДС.'"));
		Возврат;
	КонецЕсли;
	Если Объект.Расшифровка.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Сначала нажмите ""Заполнить"".'"));
		Возврат;
	КонецЕсли;
	ОбновитьСтатьюДенегВДоговорахНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере()
	Объект.Расшифровка.Очистить();
	Объект.РасшифровкаДокументы.Очистить();

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ОбработкаОбъект.ПолучитьРасшифровкуПлатежей(
		Объект.НачалоПериода,
		Объект.ОкончаниеПериода,
		Объект.СтатьяДвиженияДенежныхСредств);

	Объект.РасшифровкаДокументы.Загрузить(Результат.РасшифровкаДокументы);
	Объект.Расшифровка.Загрузить(Результат.Расшифровка);
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатьюДенегВДоговорахНаСервере()
	МассивДоговоров = Новый Массив;
	Для Каждого СтрокаТЗ Из Объект.Расшифровка Цикл
		Если СтрокаТЗ.Обработан И ЗначениеЗаполнено(СтрокаТЗ.Договор) Тогда
			МассивДоговоров.Добавить(СтрокаТЗ.Договор);
		КонецЕсли;
	КонецЦикла;

	Если МассивДоговоров.Количество() = 0 Тогда
		Сообщить(НСтр("ru='Не отмечено ни одного договора (колонка ""Обработан"").'"));
		Возврат;
	КонецЕсли;

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ОбработкаОбъект.ОбновитьСтатьюВДоговорах(
		МассивДоговоров,
		Объект.СтатьяДвиженияДенежныхСредств);

	// Перечитать текущие значения статьи в ТЗ Расшифровка
	Для Каждого СтрокаТЗ Из Объект.Расшифровка Цикл
		Если СтрокаТЗ.Обработан И ЗначениеЗаполнено(СтрокаТЗ.Договор) Тогда
			СтрокаТЗ.А_СтатьяДвиженияДенежныхСредствОснавнаяПринудительно =
				СтрокаТЗ.Договор.А_СтатьяДвиженияДенежныхСредствОснавнаяПринудительно;
		КонецЕсли;
	КонецЦикла;

	Сообщить(СтрШаблон(НСтр("ru='Обновлено договоров: %1, пропущено: %2.'"),
		Результат.Обновлено, Результат.Пропущено));
	Для Каждого ТекстОшибки Из Результат.Ошибки Цикл
		Сообщить(ТекстОшибки);
	КонецЦикла;
КонецПроцедуры

