#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	УстановитьПривилегированныйРежим(Истина);

	ПараметрПериодОтчета = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Период").Значение;
	НачалоПериода = ПараметрПериодОтчета.ДатаНачала;
	КонецПериода = КонецДня(ПараметрПериодОтчета.ДатаОкончания);

	// 1. ЕРП: РегистрНакопления.ПрочиеАктивыПассивы (Статья=Налоги), разрез Организация × ВидНалога,
	//    подвиды НДФЛ схлопнуты в один бакет НДФЛ.
	ТаблицаЕРП = ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода);

	// 2. BuhBud (COM): РегистрБухгалтерии.Хозрасчетный, счета 64x/65x, разрез Организация(ЕДРПОУ) × Счёт.Код → ВидНалога.
	СтрокаПодключенияBuhBud = А_ПодключенияБазСервер.СтрокаПодключения("bas_industrialbud");
	V8 = Новый COMОбъект("V83.COMConnector");
	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияBuhBud));
	Исключение
		Сообщить("Помилка підключення до BuhBud: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ТаблицаBuhBud = ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода);
	V83 = Неопределено;
	V8 = Неопределено;

	// 2.1 Конвертация BuhBud: ЕДРПОУ → ссылка Организации ЕРП (ВТ + LEFT JOIN по КодПоЕДРПОУ).
	ТаблицаBuhBud = КонвертироватьТЗ_BuhBud(ТаблицаBuhBud);

	// 3. Объединение по (ЕДРПОУ, ВидНалога), расчёт 4 разниц (ЕРП − Бух).
	ТаблицаСравнение = ОбъединитьТаблицы(ТаблицаЕРП, ТаблицаBuhBud);

	// 4. Передача в СКД.
	ВнешниеНаборыДанных = Новый Структура("Налоги_Сравнение", ТаблицаСравнение);

	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Определение ВидНалога (Перечисление.ТипыНалогов) по коду счёта BuhBud.
// Карта 1:1 с обработкой «Перенос остатков налогов из бухгалтерии» (_ТипНалогаПоСчету):
// 6411→НДФЛ, 6412→НДС, 6413→НалогНаПрибыль, 6414→ЕдиныйНалог, 642→ВоенныйСбор, 651→НачисленныйЕСВ,
// 6415/6417/прочее→ДругиеНалоги.
Функция ТипНалогаПоСчету(КодСчета)
	Код = СокрЛП(КодСчета);
	Если      Код = "6411" Тогда Возврат Перечисления.ТипыНалогов.НДФЛ;
	ИначеЕсли Код = "642"  Тогда Возврат Перечисления.ТипыНалогов.ВоенныйСбор;
	ИначеЕсли Код = "651"  Тогда Возврат Перечисления.ТипыНалогов.НачисленныйЕСВ;
	ИначеЕсли Код = "6412" Тогда Возврат Перечисления.ТипыНалогов.НДС;
	ИначеЕсли Код = "6413" Тогда Возврат Перечисления.ТипыНалогов.НалогНаПрибыль;
	ИначеЕсли Код = "6414" Тогда Возврат Перечисления.ТипыНалогов.ЕдиныйНалог;
	Иначе                        Возврат Перечисления.ТипыНалогов.ДругиеНалоги;
	КонецЕсли;
КонецФункции

// Массив всех подвидов НДФЛ для схлопывания в единый бакет НДФЛ на ЕРП-стороне.
// Список зафиксирован pre-тестом (test_sverka_nalogov_pretest.py): имена начинаются с НДФЛ/НФДЛ.
// В управленческом балансе единственному счёту 6411 BuhBud соответствуют ~7 подвидов НДФЛ ⇒ иначе фантомы.
Функция СписокПодвидовНДФЛ()
	Результат = Новый Массив;
	Результат.Добавить(Перечисления.ТипыНалогов.НДФЛ);
	Результат.Добавить(Перечисления.ТипыНалогов.НДФЛДоходыКонтрагентов);
	Результат.Добавить(Перечисления.ТипыНалогов.НФДЛДивиденды);
	Результат.Добавить(Перечисления.ТипыНалогов.НФДЛДивидендыСотрудникам);
	Результат.Добавить(Перечисления.ТипыНалогов.НДФЛДоначисленныйПоРезультатамПроверки);
	Результат.Добавить(Перечисления.ТипыНалогов.НДФЛПередачаЗадолженностиВНалоговыйОрган);
	Результат.Добавить(Перечисления.ТипыНалогов.НДФЛПрочиеРасчетыСПерсоналом);
	Возврат Результат;
КонецФункции

// ЕРП: РегистрНакопления.ПрочиеАктивыПассивы.ОстаткиИОбороты, Статья=Налоги, разрез Организация × ВидНалога.
// Знак: ПАП пассив-плюс (Приход растит долг бюджету, Расход гасит); КонечныйОстаток signed.
// Орг-фильтр прямо по реквизиту Организация.А_ВБалансе (флаг есть только в ЕРП).
Функция ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	ТипСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ЕДРПОУ", ТипСтрока);
	Результат.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Результат.Колонки.Добавить("ВидНалога", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыНалогов"));
	Результат.Колонки.Добавить("НачальныйОстаток_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("Начисления_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("Выплаты_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("КонечныйОстаток_ЕРП", ТипЧисло);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("СписокНДФЛ", СписокПодвидовНДФЛ());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ост.Организация КАК Организация,
	|	Ост.Организация.КодПоЕДРПОУ КАК ЕДРПОУ,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(Ост.Аналитика КАК Перечисление.ТипыНалогов) В (&СписокНДФЛ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыНалогов.НДФЛ)
	|		ИНАЧЕ ВЫРАЗИТЬ(Ост.Аналитика КАК Перечисление.ТипыНалогов)
	|	КОНЕЦ КАК ВидНалога,
	|	СУММА(Ост.СуммаНачальныйОстаток) КАК НачальныйОстаток,
	|	СУММА(Ост.СуммаПриход) КАК Начисления,
	|	СУММА(Ост.СуммаРасход) КАК Выплаты,
	|	СУММА(Ост.СуммаКонечныйОстаток) КАК КонечныйОстаток
	|ИЗ
	|	РегистрНакопления.ПрочиеАктивыПассивы.ОстаткиИОбороты(
	|		&НачалоПериода,
	|		&КонецПериода,
	|		,
	|		,
	|		Статья = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.Налоги)) КАК Ост
	|ГДЕ
	|	Ост.Организация.А_ВБалансе
	|	И Ост.Организация.КодПоЕДРПОУ <> """"
	|СГРУППИРОВАТЬ ПО
	|	Ост.Организация,
	|	Ост.Организация.КодПоЕДРПОУ,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(Ост.Аналитика КАК Перечисление.ТипыНалогов) В (&СписокНДФЛ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыНалогов.НДФЛ)
	|		ИНАЧЕ ВЫРАЗИТЬ(Ост.Аналитика КАК Перечисление.ТипыНалогов)
	|	КОНЕЦ";

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Сообщить("Помилка запиту ЕРП (ПрочиеАктивыПассивы, Налоги): " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.ЕДРПОУ = СокрЛП(Выборка.ЕДРПОУ);
		НоваяСтрока.Организация = Выборка.Организация;
		НоваяСтрока.ВидНалога = Выборка.ВидНалога;
		НоваяСтрока.НачальныйОстаток_ЕРП = Выборка.НачальныйОстаток;
		НоваяСтрока.Начисления_ЕРП = Выборка.Начисления;
		НоваяСтрока.Выплаты_ЕРП = Выборка.Выплаты;
		НоваяСтрока.КонечныйОстаток_ЕРП = Выборка.КонечныйОстаток;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// BuhBud (COM): РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты, счета 64x/65x, разрез Организация(ЕДРПОУ) × Счёт.Код.
// Пассивные счета: сальдо долга = Кт − Дт (signed, как ПАП). Начисления=ОборотКт, Выплаты=ОборотДт.
// ТЗ содержит ТОЛЬКО примитивы (строки/числа) ⇒ сериализация между базами безопасна.
// Маппинг Счёт.Код → ВидНалога и агрегация по (ЕДРПОУ, ВидНалога) выполняются ПОСЛЕ десериализации в ЕРП.
Функция ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	ТипСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ЕДРПОУ", ТипСтрока);
	Результат.Колонки.Добавить("ВидНалога", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыНалогов"));
	Результат.Колонки.Добавить("НачальныйОстаток_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("Начисления_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("Выплаты_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("КонечныйОстаток_BuhBud", ТипЧисло);

	// ЕДРПОУ организаций «в балансе» (ERP-side; в BuhBud реквизита А_ВБалансе нет).
	ЗапросОрг = Новый Запрос;
	ЗапросОрг.Текст =
	"ВЫБРАТЬ Организации.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|ИЗ Справочник.Организации КАК Организации
	|ГДЕ Организации.А_ВБалансе И Организации.КодПоЕДРПОУ <> """"";
	масЕДРПОУ_V83 = V83.NewObject("Массив");
	ВыборкаОрг = ЗапросОрг.Выполнить().Выбрать();
	Пока ВыборкаОрг.Следующий() Цикл
		масЕДРПОУ_V83.Добавить(ВыборкаОрг.КодПоЕДРПОУ);
	КонецЦикла;
	Если масЕДРПОУ_V83.Количество() = 0 Тогда
		Сообщить("Немає організацій з флагом А_ВБалансе!");
		Возврат Результат;
	КонецЕсли;

	масСчетов_V83 = V83.NewObject("Массив");
	Для Каждого Код Из СтрРазделить("6411,6412,6413,6414,6415,6417,642,651", ",", Ложь) Цикл
		масСчетов_V83.Добавить(СокрЛП(Код));
	КонецЦикла;

	ЗапросBuhBud = V83.NewObject("Запрос");
	ЗапросBuhBud.УстановитьПараметр("НачалоПериода", НачалоПериода);
	ЗапросBuhBud.УстановитьПараметр("КонецПериода", КонецПериода);
	ЗапросBuhBud.УстановитьПараметр("масЕДРПОУ", масЕДРПОУ_V83);
	ЗапросBuhBud.УстановитьПараметр("Счета", масСчетов_V83);
	ЗапросBuhBud.Текст =
	"ВЫБРАТЬ
	|	Ост.Организация.КодПоЕДРПОУ КАК ЕДРПОУ,
	|	Ост.Счет.Код КАК КодСчета,
	|	СУММА(Ост.СуммаНачальныйОстатокКт - Ост.СуммаНачальныйОстатокДт) КАК НачальныйОстаток,
	|	СУММА(Ост.СуммаОборотКт) КАК Начисления,
	|	СУММА(Ост.СуммаОборотДт) КАК Выплаты,
	|	СУММА(Ост.СуммаКонечныйОстатокКт - Ост.СуммаКонечныйОстатокДт) КАК КонечныйОстаток
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , Счет.Код В (&Счета), , ) КАК Ост
	|ГДЕ
	|	Ост.Организация.КодПоЕДРПОУ В (&масЕДРПОУ)
	|СГРУППИРОВАТЬ ПО
	|	Ост.Организация.КодПоЕДРПОУ,
	|	Ост.Счет.Код";

	Попытка
		ТЗ = ЗапросBuhBud.Выполнить().Выгрузить();
		стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗ);
		ТаблицаBuhBud = ЗначениеИзСтрокиВнутр(стр_ТЗ);
	Исключение
		Сообщить("Помилка запиту BuhBud (налоги 64x/65x): " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	// Маппинг Счёт.Код → ВидНалога + агрегация по (ЕДРПОУ, ВидНалога) (6415/6417 → один бакет ДругиеНалоги).
	Индекс = Новый Соответствие;
	Для Каждого СтрБ Из ТаблицаBuhBud Цикл
		ЕДРПОУ = СокрЛП(СтрБ.ЕДРПОУ);
		ВидНалога = ТипНалогаПоСчету(СтрБ.КодСчета);
		Ключ = ЕДРПОУ + "|" + XMLСтрока(ВидНалога);
		НомерСтроки = Индекс.Получить(Ключ);
		Если НомерСтроки = Неопределено Тогда
			СтрокаРез = Результат.Добавить();
			СтрокаРез.ЕДРПОУ = ЕДРПОУ;
			СтрокаРез.ВидНалога = ВидНалога;
			Индекс.Вставить(Ключ, Результат.Индекс(СтрокаРез));
		Иначе
			СтрокаРез = Результат.Получить(НомерСтроки);
		КонецЕсли;
		СтрокаРез.НачальныйОстаток_BuhBud = СтрокаРез.НачальныйОстаток_BuhBud + СтрБ.НачальныйОстаток;
		СтрокаРез.Начисления_BuhBud = СтрокаРез.Начисления_BuhBud + СтрБ.Начисления;
		СтрокаРез.Выплаты_BuhBud = СтрокаРез.Выплаты_BuhBud + СтрБ.Выплаты;
		СтрокаРез.КонечныйОстаток_BuhBud = СтрокаРез.КонечныйОстаток_BuhBud + СтрБ.КонечныйОстаток;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Конвертация BuhBud: ЕДРПОУ → Организации.Ссылка (ВТ + LEFT JOIN по КодПоЕДРПОУ).
// ВидНалога уже ПеречислениеСсылка.ТипыНалогов — проходит через ВТ без преобразования.
Функция КонвертироватьТЗ_BuhBud(ТаблицаBuhBud)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТЗ", ТаблицаBuhBud);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ.ЕДРПОУ КАК ЕДРПОУ,
	|	ВТ.ВидНалога КАК ВидНалога,
	|	ВТ.НачальныйОстаток_BuhBud КАК НачальныйОстаток_BuhBud,
	|	ВТ.Начисления_BuhBud КАК Начисления_BuhBud,
	|	ВТ.Выплаты_BuhBud КАК Выплаты_BuhBud,
	|	ВТ.КонечныйОстаток_BuhBud КАК КонечныйОстаток_BuhBud
	|ПОМЕСТИТЬ ВТ_BuhBud
	|ИЗ
	|	&ТЗ КАК ВТ
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ЕДРПОУ КАК ЕДРПОУ,
	|	ВТ.ВидНалога КАК ВидНалога,
	|	Орг.Ссылка КАК Организация,
	|	ВТ.НачальныйОстаток_BuhBud КАК НачальныйОстаток_BuhBud,
	|	ВТ.Начисления_BuhBud КАК Начисления_BuhBud,
	|	ВТ.Выплаты_BuhBud КАК Выплаты_BuhBud,
	|	ВТ.КонечныйОстаток_BuhBud КАК КонечныйОстаток_BuhBud
	|ИЗ
	|	ВТ_BuhBud КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Орг
	|		ПО ВТ.ЕДРПОУ = Орг.КодПоЕДРПОУ";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Объединение ЕРП + BuhBud по (ЕДРПОУ, ВидНалога), расчёт 4 разниц (ЕРП − Бух). FULL-merge.
Функция ОбъединитьТаблицы(ТаблицаЕРП, ТаблицаBuhBud)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Результат.Колонки.Добавить("ВидНалога", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыНалогов"));
	Результат.Колонки.Добавить("НачальныйОстаток_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("НачальныйОстаток_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("РазницаНачальныйОстаток", ТипЧисло);
	Результат.Колонки.Добавить("Начисления_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("Начисления_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("РазницаНачисления", ТипЧисло);
	Результат.Колонки.Добавить("Выплаты_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("Выплаты_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("РазницаВыплаты", ТипЧисло);
	Результат.Колонки.Добавить("КонечныйОстаток_ЕРП", ТипЧисло);
	Результат.Колонки.Добавить("КонечныйОстаток_BuhBud", ТипЧисло);
	Результат.Колонки.Добавить("РазницаКонечныйОстаток", ТипЧисло);

	Индекс = Новый Соответствие;

	Для Каждого СтрЕ Из ТаблицаЕРП Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Организация = СтрЕ.Организация;
		НоваяСтрока.ВидНалога = СтрЕ.ВидНалога;
		НоваяСтрока.НачальныйОстаток_ЕРП = СтрЕ.НачальныйОстаток_ЕРП;
		НоваяСтрока.Начисления_ЕРП = СтрЕ.Начисления_ЕРП;
		НоваяСтрока.Выплаты_ЕРП = СтрЕ.Выплаты_ЕРП;
		НоваяСтрока.КонечныйОстаток_ЕРП = СтрЕ.КонечныйОстаток_ЕРП;
		Ключ = СокрЛП(СтрЕ.ЕДРПОУ) + "|" + XMLСтрока(СтрЕ.ВидНалога);
		Индекс.Вставить(Ключ, Результат.Индекс(НоваяСтрока));
	КонецЦикла;

	Для Каждого СтрБ Из ТаблицаBuhBud Цикл
		Ключ = СокрЛП(СтрБ.ЕДРПОУ) + "|" + XMLСтрока(СтрБ.ВидНалога);
		НомерСтроки = Индекс.Получить(Ключ);
		Если НомерСтроки <> Неопределено Тогда
			СтрокаРез = Результат.Получить(НомерСтроки);
		Иначе
			СтрокаРез = Результат.Добавить();
			СтрокаРез.Организация = СтрБ.Организация;
			СтрокаРез.ВидНалога = СтрБ.ВидНалога;
		КонецЕсли;
		СтрокаРез.НачальныйОстаток_BuhBud = СтрБ.НачальныйОстаток_BuhBud;
		СтрокаРез.Начисления_BuhBud = СтрБ.Начисления_BuhBud;
		СтрокаРез.Выплаты_BuhBud = СтрБ.Выплаты_BuhBud;
		СтрокаРез.КонечныйОстаток_BuhBud = СтрБ.КонечныйОстаток_BuhBud;
	КонецЦикла;

	Для Каждого СтрР Из Результат Цикл
		СтрР.РазницаНачальныйОстаток = СтрР.НачальныйОстаток_ЕРП - СтрР.НачальныйОстаток_BuhBud;
		СтрР.РазницаНачисления = СтрР.Начисления_ЕРП - СтрР.Начисления_BuhBud;
		СтрР.РазницаВыплаты = СтрР.Выплаты_ЕРП - СтрР.Выплаты_BuhBud;
		СтрР.РазницаКонечныйОстаток = СтрР.КонечныйОстаток_ЕРП - СтрР.КонечныйОстаток_BuhBud;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецЕсли
