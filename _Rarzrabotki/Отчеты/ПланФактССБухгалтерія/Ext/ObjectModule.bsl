#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Внешний отчёт ПланФактССБухгалтерія — «План на факт за матеріалами» (база bas_industrialbud).
// В «Додаткові звіти та обробки» регистрируется под именем ПланФактССБухгалтерія:
// СведенияОВнешнейОбработке берёт Наименование из Метаданные().Представление() = Синоним.
// Заголовок самого отчёта («План на факт за матеріалами») живёт в варианте компоновки.
//
// Бухгалтерский близнец ЕРП-варианта отчёта А_ПланФактныйПроизводствоПолный.
// ТОЛЬКО матеріали: ТЧ Работы в бухгалтерской структуре себестоимости не существует,
// поэтому ни табеля, ни плана часов, ни EV-виконання здесь нет.
//
// Программная компоновка СКД: данные строит ПолучитьДанные(Период), СКД получает их
// внешним набором "Детали". Причины программности:
//   1) «План на факт» (ETC) — синтетические строки, которых нет в грейне;
//   2) разнос факта по Етапу идёт через карту «имя загальної назви -> Етап».
//
// ИНВАРИАНТЫ (не менять):
//   - факт по материалам ВСЕГДА с ПДВ: план (Комплектующие.Сумма) заведён с ПДВ;
//     формула — ВЫБОР КОГДА СуммаВключаетНДС ТОГДА Сумма ИНАЧЕ Сумма + СуммаНДС КОНЕЦ.
//     Никакого «просто * 1,2»: 22 строки факта IRS уже включают ПДВ, 137 несут его
//     отдельной суммой, 48 идут от неплательщиков — сплошной множитель задвоил бы налог;
//   - факт = ЗАКУПКИ (ПоступлениеТоваровУслуг), не списание;
//   - сбор идёт циклом по подразделениям-зонтикам: две карточки IRS на одном зонтике
//     иначе удвоят факт;
//   - план = норма * СС.КоличествоДомов (0 -> 1): норма заведена на один дім. Подсчёт домиков по
//     имени дочернего подразделения убран 04.09.2026: имена карточек IRS набраны с кириллической
//     «С» («IRС»), подразделения — с латинской, сопоставление молча давало 2 вместо 6/7;
//   - загальна назва плана — ИЗ СТРОКИ СС (К.ОбщееНазвание); карточная — только при пустой строке.
//     Факт классифицируется карточной назвой. Иначе строка спецификации «Мінеральна вата 100»
//     с карточкой «EKOBOARD 50» уезжала под «вату 50» (кейс пользователя 04.09.2026);
//   - «Аналітика» — ТЕКСТ: план СокрЛП(К.НоменклатураСС), факт СокрЛП(Номенклатура.Наименование).
//     Ссылка на карточку живёт в отдельном измерении Номенклатура (только у факта).
//
// Все запросы проверены Python COM на живой bas_industrialbud (Rule #-1).
// Спека: docs/superpowers/specs/2026-08-06-planfaktss-materialy-buhbud-design.md
//        docs/superpowers/specs/2026-09-04-planfaktss-analitika-on-domiki-design.md
// Промт: _Rarzrabotki/Отчеты/ПРОМТ_ПланФактСС_Материали.md

#Область СлужебныйПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	МассивНазначений = Новый Массив;
	МассивНазначений.Добавить("");

	ИмяОтчета = Метаданные().Представление();

	ПараметрыРегистрации.Вставить("Вид", "ДополнительныйОтчет");
	ПараметрыРегистрации.Вставить("Назначение", МассивНазначений);
	ПараметрыРегистрации.Вставить("Наименование", ИмяОтчета);
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Истина);
	ПараметрыРегистрации.Вставить("Информация",
		"План структури собівартості проти факту закупівель з прогнозом бюджету матеріалів");

	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд, ИмяОтчета, Метаданные().ПолноеИмя(), "ОткрытиеФормы", Истина);
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);

	Возврат ПараметрыРегистрации;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СформироватьОтчет(ДокументРезультат, ДанныеРасшифровки);

КонецПроцедуры

// Экспортная точка входа: ровно то, что делает ПриКомпоновкеРезультата.
// Вынесена отдельно, чтобы приёмка могла прогнать ПОЛНЫЙ путь пользователя через COM —
// сам обработчик события COM-прокси не отдаёт.
Процедура СформироватьОтчет(ДокументРезультат, ДанныеРасшифровки = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	Период = ПолучитьЗначениеПараметра(Настройки, "Период");

	ТаблицаДетали = ПолучитьДанные(Период);

	ВнешниеНаборыДанных = Новый Структура("Детали", ТаблицаДетали);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Главный сбор данных. Плоская ТЗ грейна по ВСЕМ подразделениям, у которых есть активные
// структуры себестоимости; СКД-отбор «Підрозділ» потом отфильтрует нужное.
// Границы периода независимы: пустое начало -> '00010101', пустой конец -> '39991231'.
Функция ПолучитьДанные(Период) Экспорт

	Если ЗначениеЗаполнено(Период) И ЗначениеЗаполнено(Период.ДатаНачала) Тогда
		НачП = Период.ДатаНачала;
	Иначе
		НачП = '00010101000000';
	КонецЕсли;
	Если ЗначениеЗаполнено(Период) И ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		КонП = КонецДня(Период.ДатаОкончания);
	Иначе
		КонП = '39991231235959';
	КонецЕсли;

	ТЗ = СоздатьПустуюТаблицу();

	Для Каждого Зонтик Из ПолучитьЗонтики() Цикл
		ТЗЧасть = ВыполнитьЗапросПоЗонтику(Зонтик, НачП, КонП);
		ЗаполнитьЭтапИКатегориюФакта(ТЗЧасть, Зонтик);
		Для Каждого СтрокаЧасти Из ТЗЧасть Цикл
			ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), СтрокаЧасти);
		КонецЦикла;
	КонецЦикла;

	ЗаполнитьПланНаФакт(ТЗ);
	ЗаполнитьПроизводные(ТЗ);

	Возврат ТЗ;

КонецФункции

// Подразделения-зонтики: по ним идёт и разрез «Підрозділ», и отбор факта закупок.
// Именно зонтик, а не драйвер домиков: котёл закупок IRS висит на «МД IRS 2026».
Функция ПолучитьЗонтики()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СС.Подразделение КАК Подр
	|ИЗ
	|	Справочник.СтруктураСебестоимости КАК СС
	|ГДЕ
	|	НЕ СС.ЭтоГруппа
	|	И СС.Активная
	|	И НЕ СС.ПометкаУдаления
	|	И СС.Подразделение <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)";

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Подр");

КонецФункции

// Грейн по ОДНОМУ зонтику: UNION плановой и фактовой веток.
//
// План умножается на СС.КоличествоДомов (0 -> 1) — как в ЕРП-прообразе.
// Загальна назва плана — из строки СС, карточная — при пустой строке; «Аналитика» — текст.
// Факт ни с чем не соединяется, только ГДЕ: при нескольких активных карточках на зонтике
// «ПО ИСТИНА» умножил бы его на их число.
// ⚠️ «В ИЕРАРХИИ (столбец ВТ)» запрещено платформой — только параметр или подзапрос.
// Текст 1:1 с ТЕКСТ_ГРЕЙНА в test_planfaktss_grain.py (Rule #-1).
Функция ВыполнитьЗапросПоЗонтику(Зонтик, НачП, КонП)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Зонтик", Зонтик);
	Запрос.УстановитьПараметр("НачП", НачП);
	Запрос.УстановитьПараметр("КонП", КонП);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СС.Ссылка КАК СС,
	|	СС.Подразделение КАК Подр,
	|	ВЫБОР
	|		КОГДА СС.КоличествоДомов > 0
	|			ТОГДА СС.КоличествоДомов
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Домиков
	|ПОМЕСТИТЬ ВТ_СС
	|ИЗ
	|	Справочник.СтруктураСебестоимости КАК СС
	|ГДЕ
	|	НЕ СС.ЭтоГруппа
	|	И СС.Активная
	|	И НЕ СС.ПометкаУдаления
	|	И СС.Подразделение = &Зонтик
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СС.Подр КАК Подразделение,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА К.Этап.Наименование ПОДОБНО ""%Монтаж%""
	|				ТОГДА ""Монтаж""
	|			ИНАЧЕ ""Виробництво""
	|		КОНЕЦ КАК СТРОКА(50)) КАК Категория,
	|	К.Этап КАК Этап,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА К.ОбщееНазвание <> ЗНАЧЕНИЕ(Справочник.ОбщиеНазванияНоменклатуры.ПустаяСсылка)
	|				ТОГДА К.ОбщееНазвание
	|			ИНАЧЕ К.Номенклатура.ОбщееНазваниеНоменклатуры
	|		КОНЕЦ, ЗНАЧЕНИЕ(Справочник.ОбщиеНазванияНоменклатуры.ПустаяСсылка)) КАК ОбщееНазвание,
	|	СокрЛП(К.НоменклатураСС) КАК Аналитика,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК Номенклатура,
	|	К.Единица КАК Единица,
	|	ВТ_СС.СС КАК Документ,
	|	К.Количество * ВТ_СС.Домиков КАК ПланКол,
	|	К.Сумма * ВТ_СС.Домиков КАК ПланГрн,
	|	0 КАК ФактКол,
	|	0 КАК ФактГрн
	|ПОМЕСТИТЬ ВТ_Детали
	|ИЗ
	|	Справочник.СтруктураСебестоимости.Комплектующие КАК К
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
	|		ПО К.Ссылка = ВТ_СС.СС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Зонтик,
	|	ВЫРАЗИТЬ(""Виробництво"" КАК СТРОКА(50)),
	|	ЗНАЧЕНИЕ(Справочник.ЭтапыРабот.ПустаяСсылка),
	|	Т.Номенклатура.ОбщееНазваниеНоменклатуры,
	|	СокрЛП(Т.Номенклатура.Наименование),
	|	Т.Номенклатура,
	|	Т.ЕдиницаИзмерения,
	|	Д.Ссылка,
	|	0,
	|	0,
	|	Т.Количество,
	|	ВЫБОР
	|		КОГДА Д.СуммаВключаетНДС
	|			ТОГДА Т.Сумма
	|		ИНАЧЕ Т.Сумма + Т.СуммаНДС
	|	КОНЕЦ
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК Д
	|		ПО Т.Ссылка = Д.Ссылка
	|ГДЕ
	|	Д.Проведен
	|	И Д.Дата МЕЖДУ &НачП И &КонП
	|	И Д.Подразделение В ИЕРАРХИИ (&Зонтик)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Детали.Подразделение КАК Подразделение,
	|	ВТ_Детали.Категория КАК Категория,
	|	ВТ_Детали.Этап КАК Этап,
	|	ВТ_Детали.ОбщееНазвание КАК ОбщееНазвание,
	|	ВТ_Детали.Аналитика КАК Аналитика,
	|	ВТ_Детали.Номенклатура КАК Номенклатура,
	|	ВТ_Детали.Единица КАК Единица,
	|	ВТ_Детали.Документ КАК Документ,
	|	СУММА(ВТ_Детали.ПланКол) КАК ПланКол,
	|	СУММА(ВТ_Детали.ПланГрн) КАК ПланГрн,
	|	СУММА(ВТ_Детали.ФактКол) КАК ФактКол,
	|	СУММА(ВТ_Детали.ФактГрн) КАК ФактГрн
	|ИЗ
	|	ВТ_Детали КАК ВТ_Детали
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Детали.Подразделение,
	|	ВТ_Детали.Категория,
	|	ВТ_Детали.Этап,
	|	ВТ_Детали.ОбщееНазвание,
	|	ВТ_Детали.Аналитика,
	|	ВТ_Детали.Номенклатура,
	|	ВТ_Детали.Единица,
	|	ВТ_Детали.Документ";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Разнос строк ФАКТА (Етап пуст) по Етапу и Категорії:
// «Загальна назва» -> {Этап, Категория} из плана Комплектующие этого зонтика.
// Несопоставленные строки остаются с пустым Етапом и категорией-плейсхолдером
// «Виробництво» — это норма архитектуры, не дефект.
Процедура ЗаполнитьЭтапИКатегориюФакта(ТЗ, Зонтик)

	Маппинг = МаппингОбщееНазваниеЭтап(Зонтик);
	Если Маппинг.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТЗ Из ТЗ Цикл
		Если ЗначениеЗаполнено(СтрокаТЗ.Этап) ИЛИ НЕ ЗначениеЗаполнено(СтрокаТЗ.ОбщееНазвание) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = ВРег(СокрЛП(СтрокаТЗ.ОбщееНазвание.Наименование));
		ДанныеЭтапа = Маппинг.Получить(Ключ);
		Если ДанныеЭтапа <> Неопределено Тогда
			СтрокаТЗ.Этап = ДанныеЭтапа.Этап;
			СтрокаТЗ.Категория = ДанныеЭтапа.Категория;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Соответствие: нормализованное ИМЯ загальної назви -> Структура{Этап, Категория}.
// Ключ — ИМЯ, а не ссылка: в справочнике ОбщиеНазванияНоменклатуры есть ДУБЛИ карточек
// с одинаковым именем, по ссылке план и факт могут не сойтись.
// Назва берётся из СТРОКИ СС — тем же правилом, что и у плана в грейне (карточная — при пустой).
// При нескольких этапах одного имени берём максимум по Строка(Этап) — детерминизм.
// Текст 1:1 с ТЕКСТ в test_planfaktss_mapping.py.
Функция МаппингОбщееНазваниеЭтап(Зонтик)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Зонтик", Зонтик);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА К.ОбщееНазвание <> ЗНАЧЕНИЕ(Справочник.ОбщиеНазванияНоменклатуры.ПустаяСсылка)
	|				ТОГДА К.ОбщееНазвание.Наименование
	|			ИНАЧЕ К.Номенклатура.ОбщееНазваниеНоменклатуры.Наименование
	|		КОНЕЦ, """") КАК ОбщееНазвание,
	|	К.Этап КАК Этап,
	|	ВЫБОР
	|		КОГДА К.Этап.Наименование ПОДОБНО ""%Монтаж%""
	|			ТОГДА ""Монтаж""
	|		ИНАЧЕ ""Виробництво""
	|	КОНЕЦ КАК Категория
	|ИЗ
	|	Справочник.СтруктураСебестоимости.Комплектующие КАК К
	|ГДЕ
	|	К.Ссылка.Подразделение = &Зонтик
	|	И НЕ К.Ссылка.ЭтоГруппа
	|	И К.Ссылка.Активная
	|	И НЕ К.Ссылка.ПометкаУдаления
	|	И К.Этап <> ЗНАЧЕНИЕ(Справочник.ЭтапыРабот.ПустаяСсылка)
	|	И (К.ОбщееНазвание <> ЗНАЧЕНИЕ(Справочник.ОбщиеНазванияНоменклатуры.ПустаяСсылка)
	|		ИЛИ К.Номенклатура.ОбщееНазваниеНоменклатуры <> ЗНАЧЕНИЕ(Справочник.ОбщиеНазванияНоменклатуры.ПустаяСсылка))";

	Маппинг = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = ВРег(СокрЛП(Выборка.ОбщееНазвание));
		Если НЕ ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Текущий = Маппинг.Получить(Ключ);
		Если Текущий = Неопределено ИЛИ Строка(Выборка.Этап) > Строка(Текущий.Этап) Тогда
			Маппинг.Вставить(Ключ, Новый Структура("Этап, Категория", Выборка.Этап, Выборка.Категория));
		КонецЕсли;
	КонецЦикла;

	Возврат Маппинг;

КонецФункции

// «План на факт» (ETC, estimate-to-complete) — некупленный остаток плана по плановой цене.
// Ложится в ТЗ СИНТЕТИЧЕСКИМИ строками: в грейне их нет.
//
// Группа нетто = (Підрозділ, нормализованное имя загальної назви). Етап и Категорія
// в ключ НЕ входят: иначе перерасход одного этапа не гасит остаток другого и ETC завышается.
Процедура ЗаполнитьПланНаФакт(ТЗ)

	Группы = Новый Соответствие;

	Для Каждого СтрокаТЗ Из ТЗ Цикл
		Ключ = КлючГруппыПланНаФакт(СтрокаТЗ);
		Если НЕ ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Данные = Группы.Получить(Ключ);
		Если Данные = Неопределено Тогда
			Данные = Новый Структура("ПланКол, ФактКол, ПланГрн, ФактГрн, Образец, МаксПланГрн",
				0, 0, 0, 0, Неопределено, -1);
			Группы.Вставить(Ключ, Данные);
		КонецЕсли;
		Данные.ПланКол = Данные.ПланКол + СтрокаТЗ.ПланКол;
		Данные.ФактКол = Данные.ФактКол + СтрокаТЗ.ФактКол;
		Данные.ПланГрн = Данные.ПланГрн + СтрокаТЗ.ПланГрн;
		Данные.ФактГрн = Данные.ФактГрн + СтрокаТЗ.ФактГрн;
		Если СтрокаТЗ.ПланГрн > Данные.МаксПланГрн Тогда
			Данные.МаксПланГрн = СтрокаТЗ.ПланГрн;
			Данные.Образец = СтрокаТЗ;
		КонецЕсли;
	КонецЦикла;

	ПустаяНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
	ПустаяЕдиница = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
	ПустойДокумент = Документы.ПоступлениеТоваровУслуг.ПустаяСсылка();

	Для Каждого КлючИЗначение Из Группы Цикл
		Данные = КлючИЗначение.Значение;
		Если Данные.Образец = Неопределено ИЛИ Данные.ПланГрн <= 0 Тогда
			// Правило 1: прогнозировать нечего.
			Продолжить;
		КонецЕсли;

		Если Данные.ПланКол <= 0 Тогда
			// Правило 2: план суммой без количества -> стоимостное нетто.
			ПланНаФакт = Данные.ПланГрн - Данные.ФактГрн;
		ИначеЕсли Данные.ФактКол <= 0 Тогда
			// Правило 3: закупок не было -> РОВНО сумма плана.
			// Без пересчёта «кол-во * средняя цена»: round-trip через цену теряет копейки,
			// а бухгалтеру нужен точный отчёт («не играться с копейками»).
			ПланНаФакт = Данные.ПланГрн;
		Иначе
			// Правило 4: частичный факт -> количественное нетто по средней плановой цене.
			ПланНаФакт = (Данные.ПланКол - Данные.ФактКол) * (Данные.ПланГрн / Данные.ПланКол);
		КонецЕсли;

		Если ПланНаФакт <= 0 Тогда
			// Overrun: прогноз группы = факт.
			Продолжить;
		КонецЕсли;

		Образец = Данные.Образец;
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.Подразделение = Образец.Подразделение;
		НоваяСтрока.Категория = Образец.Категория;
		НоваяСтрока.Этап = Образец.Этап;
		НоваяСтрока.ОбщееНазвание = Образец.ОбщееНазвание;
		НоваяСтрока.Номенклатура = ПустаяНоменклатура;
		Если ЗначениеЗаполнено(Образец.ОбщееНазвание) Тогда
			// Итог по загальній назві: пустая аналитика и типизированная пустая единица —
			// иначе расшифровка плодит пустые строки-дубли.
			НоваяСтрока.Аналитика = "";
			НоваяСтрока.Единица = ПустаяЕдиница;
		Иначе
			НоваяСтрока.Аналитика = Образец.Аналитика;
			НоваяСтрока.Единица = Образец.Единица;
		КонецЕсли;
		НоваяСтрока.Документ = ПустойДокумент;
		НоваяСтрока.ПланНаФактГрн = ПланНаФакт;
	КонецЦикла;

КонецПроцедуры

// Ключ группы нетто. Пустая строка = строка в прогнозе не участвует.
// Без загальної назви план и факт неттуются по ТЕКСТУ аналитики (у обеих веток он текст):
// сходятся только при точном совпадении СокрЛП(НоменклатураСС) и СокрЛП(Наименование карточки).
Функция КлючГруппыПланНаФакт(СтрокаТЗ)

	Префикс = Строка(СтрокаТЗ.Подразделение.УникальныйИдентификатор());

	Если ЗначениеЗаполнено(СтрокаТЗ.ОбщееНазвание) Тогда
		Возврат Префикс + "|ОН|" + ВРег(СокрЛП(СтрокаТЗ.ОбщееНазвание.Наименование));
	КонецЕсли;

	Если ЗначениеЗаполнено(СокрЛП(СтрокаТЗ.Аналитика)) Тогда
		Возврат Префикс + "|ТЕКСТ|" + ВРег(СокрЛП(СтрокаТЗ.Аналитика));
	КонецЕсли;

	Возврат "";

КонецФункции

// Производные показатели на уровне ДЕТАЛЬНОЙ строки. На уровнях группировок те же формулы
// пересчитываются схемой через totalField — иначе средние цены и проценты сложились бы суммой.
// Вызывается ПОСЛЕ ЗаполнитьПланНаФакт, чтобы синтетические строки тоже получили прогноз.
Процедура ЗаполнитьПроизводные(ТЗ)

	Для Каждого СтрокаТЗ Из ТЗ Цикл
		СтрокаТЗ.ЦенаПлан = ?(СтрокаТЗ.ПланКол = 0, 0, СтрокаТЗ.ПланГрн / СтрокаТЗ.ПланКол);
		СтрокаТЗ.ЦенаФакт = ?(СтрокаТЗ.ФактКол = 0, 0, СтрокаТЗ.ФактГрн / СтрокаТЗ.ФактКол);
		СтрокаТЗ.ОтклонениеКол = СтрокаТЗ.ФактКол - СтрокаТЗ.ПланКол;
		СтрокаТЗ.ОтклонениеГрн = СтрокаТЗ.ФактГрн - СтрокаТЗ.ПланГрн;
		СтрокаТЗ.ПроцентКол = ?(СтрокаТЗ.ПланКол = 0, 0, СтрокаТЗ.ФактКол / СтрокаТЗ.ПланКол * 100);
		СтрокаТЗ.ПроцентГрн = ?(СтрокаТЗ.ПланГрн = 0, 0, СтрокаТЗ.ФактГрн / СтрокаТЗ.ПланГрн * 100);

		Прогноз = СтрокаТЗ.ФактГрн + СтрокаТЗ.ПланНаФактГрн;
		СтрокаТЗ.ПрогнозГрн = Прогноз;
		СтрокаТЗ.ОтклонениеПрогнозГрн = Прогноз - СтрокаТЗ.ПланГрн;
		СтрокаТЗ.ПроцентПрогнозГрн = ?(СтрокаТЗ.ПланГрн = 0, 0, Прогноз / СтрокаТЗ.ПланГрн * 100);
	КонецЦикла;

КонецПроцедуры

// Пустая ТЗ грейна. Имена и типы колонок обязаны совпадать с полями набора "Детали"
// схемы СКД — рассинхрон даёт битые данные без ошибки.
// 8 измерений + 14 показателей.
Функция СоздатьПустуюТаблицу()

	ТЗ = Новый ТаблицаЗначений;
	ОписЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 3, ДопустимыйЗнак.Любой));
	ОписСтрока50 = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50));
	ОписСтрока200 = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(200));

	МассивДокумент = Новый Массив;
	МассивДокумент.Добавить(Тип("ДокументСсылка.ПоступлениеТоваровУслуг"));
	МассивДокумент.Добавить(Тип("СправочникСсылка.СтруктураСебестоимости"));

	ТЗ.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТЗ.Колонки.Добавить("Категория", ОписСтрока50);
	ТЗ.Колонки.Добавить("Этап", Новый ОписаниеТипов("СправочникСсылка.ЭтапыРабот"));
	ТЗ.Колонки.Добавить("ОбщееНазвание", Новый ОписаниеТипов("СправочникСсылка.ОбщиеНазванияНоменклатуры"));
	ТЗ.Колонки.Добавить("Аналитика", ОписСтрока200); // план: СокрЛП(НоменклатураСС), факт: СокрЛП(Наименование)
	ТЗ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура")); // только у факта
	ТЗ.Колонки.Добавить("Единица", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТЗ.Колонки.Добавить("Документ", Новый ОписаниеТипов(МассивДокумент));
	ТЗ.Колонки.Добавить("ПланКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ЦенаПлан", ОписЧисло);
	ТЗ.Колонки.Добавить("ПланГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ФактКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ЦенаФакт", ОписЧисло);
	ТЗ.Колонки.Добавить("ФактГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ОтклонениеКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ОтклонениеГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ПроцентКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ПроцентГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ПланНаФактГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ПрогнозГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ОтклонениеПрогнозГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ПроцентПрогнозГрн", ОписЧисло);

	Возврат ТЗ;

КонецФункции

// Значение параметра компоновки БЕЗ обращения к БСП.
// ⚠️ НЕ использовать КомпоновкаДанныхКлиентСервер.ПолучитьПараметр: в bas_industrialbud
// модуль есть, но экспортного метода ПолучитьПараметр в нём НЕТ — отчёт падает прямо
// в форме с «Метод объекта не обнаружен (ПолучитьПараметр)».
Функция ПолучитьЗначениеПараметра(Настройки, ИмяПараметра)

	Если Настройки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Параметр = Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
	Возврат ?(Параметр = Неопределено, Неопределено, Параметр.Значение);

КонецФункции

Функция ПолучитьТаблицуКоманд()

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;

КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование,
	ПоказыватьОповещение = Ложь, Модификатор = "")

	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
