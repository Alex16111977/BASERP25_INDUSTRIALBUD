#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Внешний отчёт А_ОтчетПоСписаниюНаПроизводствоУправленческий.
// «Списання на виробництво (управлінський)» — форма СС по факту списания:
// Етап -> Загальна назва -> Номенклатура, кількість / ціна / сума з ПДВ.
//
// Факт — РегистрНакопления.СебестоимостьТоваров (Расход / ТоварыНаСкладах) по документам
// СборкаТоваров и ВнутреннееПотреблениеТоваров; Стоимость регистра — брутто (с НДС).
// Плановых строк в выводе НЕТ: ТЧ Комплектующие активных СС драйвера дают только
// карту «назва -> етап» (первое вхождение по НомерСтроки; материал ровно в одном этапе)
// и карту плановых цен «назва+одиниця» для fallback незакрытого месяца
// (себестоимость выбытия появляется лишь после РасчетСебестоимостиТоваров).
// Работы и табелирование не используются вообще.
//
// Все запросы проверены Python-COM на живой BaseERP (Rule #-1, test_upr_queries.py).
// Спека: docs/superpowers/specs/2026-08-14-spisanie-na-proizvodstvo-upravlencheskiy-design.md

#Область СлужебныйПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	МассивНазначений = Новый Массив;
	МассивНазначений.Добавить("");

	ИмяОтчета = Метаданные().Представление();

	ПараметрыРегистрации.Вставить("Вид", "ДополнительныйОтчет");
	ПараметрыРегистрации.Вставить("Назначение", МассивНазначений);
	ПараметрыРегистрации.Вставить("Наименование", ИмяОтчета);
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Истина);
	ПараметрыРегистрации.Вставить("Информация",
		"Форма СС за фактом списання: Етап -> Загальна назва -> Номенклатура (кількість, ціна та сума з ПДВ)");

	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд, ИмяОтчета, Метаданные().ПолноеИмя(), "ОткрытиеФормы", Истина);
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);

	Возврат ПараметрыРегистрации;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Программная компоновка: данные готовятся в ПолучитьДанные и передаются в СКД
// как внешний набор данных "Детали". Расшифровка штатная (ДанныеРасшифровки прокидывается).
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СформироватьОтчет(ДокументРезультат, ДанныеРасшифровки);

КонецПроцедуры

// Экспортная точка входа: ровно то, что делает ПриКомпоновкеРезультата.
// Вынесена отдельно, чтобы приёмка могла прогнать ПОЛНЫЙ путь пользователя через COM —
// сам обработчик события COM-прокси не отдаёт.
Процедура СформироватьОтчет(ДокументРезультат, ДанныеРасшифровки = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();

	Период = ПолучитьЗначениеПараметра(Настройки, "Период");

	ТаблицаДетали = ПолучитьДанные(Период);

	ВнешниеНаборыДанных = Новый Структура("Детали", ТаблицаДетали);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Главный сбор данных: плоская ТЗ факта списания по всем драйверам активных СС.
// Драйвер = ПодразделениеОбъекта (fallback -> Подразделение) — как в отчёте-доноре:
// у IRS/IRC 15 м и 30 м Подразделение — общий зонтик, ПодразделениеОбъекта разводит их.
// Границы периода независимы: пустое начало -> '00010101', пустой конец -> '39991231'.
Функция ПолучитьДанные(Период) Экспорт

	Если ЗначениеЗаполнено(Период) И ЗначениеЗаполнено(Период.ДатаНачала) Тогда
		НачП = Период.ДатаНачала;
	Иначе
		НачП = '00010101000000';
	КонецЕсли;
	Если ЗначениеЗаполнено(Период) И ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		КонП = КонецДня(Период.ДатаОкончания);
	Иначе
		КонП = '39991231235959';
	КонецЕсли;

	ТЗ = СоздатьПустуюТаблицу();

	Для Каждого Драйвер Из ПолучитьДрайверы() Цикл
		ТЗЧасть = ВыполнитьЗапросПоДрайверу(Драйвер, НачП, КонП);
		КартыСС = ПостроитьКартыСС(Драйвер);
		РазнестиПоЭтапам(ТЗЧасть, КартыСС.Этапы);
		ЗаполнитьСуммыИЦены(ТЗЧасть, КартыСС.Цены);
		Для Каждого СтрокаЧасти Из ТЗЧасть Цикл
			ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), СтрокаЧасти);
		КонецЦикла;
	КонецЦикла;

	Возврат ТЗ;

КонецФункции

// Массив подразделений-драйверов: РАЗЛИЧНЫЕ ПодразделениеОбъекта (fallback Подразделение)
// по всем активным не-групповым карточкам структуры себестоимости.
Функция ПолучитьДрайверы()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА СС.ПодразделениеОбъекта <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ТОГДА СС.ПодразделениеОбъекта
	|		ИНАЧЕ СС.Подразделение
	|	КОНЕЦ КАК Драйвер
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости КАК СС
	|ГДЕ
	|	НЕ СС.ЭтоГруппа
	|	И СС.Активная
	|	И ВЫБОР
	|		КОГДА СС.ПодразделениеОбъекта <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ТОГДА СС.ПодразделениеОбъекта
	|		ИНАЧЕ СС.Подразделение
	|	КОНЕЦ <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)";

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Драйвер");

КонецФункции

// Факт списания по одному драйверу: Расход СебестоимостьТоваров по документам
// СборкаТоваров / ВнутреннееПотреблениеТоваров, подразделение-исполнитель В ИЕРАРХИИ драйвера.
// Группировка через ВТ (группировать по выражению ВЫБОР напрямую нельзя).
// Колонки Этап/ЭтапСтрока/ЭтапНомер/ИсточникЦены/СуммаПлан/СуммаСНДС/ЦенаСНДС
// заполняются постобработками, поэтому результат перекладывается в пустую ТЗ полного грейна.
Функция ВыполнитьЗапросПоДрайверу(Драйвер, НачП, КонП)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Драйвер", Драйвер);
	Запрос.УстановитьПараметр("НачП", НачП);
	Запрос.УстановитьПараметр("КонП", КонП);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СТ.Подразделение КАК ПодразделениеИсполнитель,
	|	СТ.АналитикаУчетаНоменклатуры.Номенклатура.А_ОбщееНазваниеНоменклатуры КАК ОбщееНазвание,
	|	СТ.АналитикаУчетаНоменклатуры.Номенклатура КАК Аналитика,
	|	СТ.АналитикаУчетаНоменклатуры.Номенклатура.Наименование КАК НоменклатураНаименование,
	|	СТ.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения КАК Единица,
	|	СТ.Регистратор КАК Документ,
	|	ВЫРАЗИТЬ(ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СТ.Регистратор) = ТИП(Документ.СборкаТоваров)
	|			ТОГДА ""1. Комплектація""
	|		ИНАЧЕ ""2. Внутрішнє споживання""
	|	КОНЕЦ КАК СТРОКА(50)) КАК ВидДокумента,
	|	СТ.Количество КАК Количество,
	|	СТ.Стоимость КАК СуммаСоб
	|ПОМЕСТИТЬ ВТ_Факт
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров КАК СТ
	|ГДЕ
	|	СТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И СТ.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыНаСкладах)
	|	И СТ.Период МЕЖДУ &НачП И &КонП
	|	И ТИПЗНАЧЕНИЯ(СТ.Регистратор) В (ТИП(Документ.СборкаТоваров), ТИП(Документ.ВнутреннееПотреблениеТоваров))
	|	И СТ.Подразделение В ИЕРАРХИИ (&Драйвер)
	|;
	|ВЫБРАТЬ
	|	&Драйвер КАК Подразделение,
	|	Ф.ПодразделениеИсполнитель КАК ПодразделениеИсполнитель,
	|	Ф.ОбщееНазвание КАК ОбщееНазвание,
	|	Ф.Аналитика КАК Аналитика,
	|	Ф.НоменклатураНаименование КАК НоменклатураНаименование,
	|	Ф.Единица КАК Единица,
	|	Ф.Документ КАК Документ,
	|	Ф.ВидДокумента КАК ВидДокумента,
	|	СУММА(Ф.Количество) КАК Количество,
	|	СУММА(Ф.СуммаСоб) КАК СуммаСоб
	|ИЗ
	|	ВТ_Факт КАК Ф
	|СГРУППИРОВАТЬ ПО
	|	Ф.ПодразделениеИсполнитель,
	|	Ф.ОбщееНазвание,
	|	Ф.Аналитика,
	|	Ф.НоменклатураНаименование,
	|	Ф.Единица,
	|	Ф.Документ,
	|	Ф.ВидДокумента";

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	ТЗЧасть = СоздатьПустуюТаблицу();
	Для Каждого СтрокаРез Из РезультатЗапроса Цикл
		ЗаполнитьЗначенияСвойств(ТЗЧасть.Добавить(), СтрокаРез);
	КонецЦикла;

	Возврат ТЗЧасть;

КонецФункции

// Обе карты СС драйвера ОДНИМ упорядоченным обходом ТЧ Комплектующие
// (только материальная часть; ТЧ Работы не читается):
//   Этапы: ключ назвы -> {Этап, ЭтапНомер, ЭтапСтрока} — ПЕРВОЕ вхождение по
//     (Наименование СС, НомерСтроки); материал попадает ровно в один этап.
//     ЭтапНомер — порядковый номер появления этапа в обходе (порядок листа СС),
//     подпись раздела "01. Каркас" ... "99. Позапланово" сортируется строково.
//   Цены: ключ "назва|одиниця" -> {ПланКол, ПланГрн} — суммы ТЧ (с НДС) для fallback;
//     множитель КоличествоДомов на цену не влияет (сокращается в ПланГрн/ПланКол).
// Ключи нормализованы ВРег(СокрЛП()): в справочниках дубли карточек и «шт»/« шт».
Функция ПостроитьКартыСС(Драйвер)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Драйвер", Драйвер);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.Ссылка.Наименование КАК ИмяСС,
	|	К.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(ВЫБОР
	|		КОГДА К.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА К.ОбщееНазвание.Наименование
	|		ИНАЧЕ К.Номенклатура.А_ОбщееНазваниеНоменклатуры.Наименование
	|	КОНЕЦ, """") КАК ИмяНазвы,
	|	К.Этап КАК Этап,
	|	ЕСТЬNULL(К.Единица.Наименование, """") КАК ИмяЕдиницы,
	|	К.Количество КАК Количество,
	|	К.Сумма КАК Сумма
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Комплектующие КАК К
	|ГДЕ
	|	К.Ссылка.Активная
	|	И НЕ К.Ссылка.ЭтоГруппа
	|	И ВЫБОР
	|		КОГДА К.Ссылка.ПодразделениеОбъекта <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ТОГДА К.Ссылка.ПодразделениеОбъекта
	|		ИНАЧЕ К.Ссылка.Подразделение
	|	КОНЕЦ = &Драйвер
	|УПОРЯДОЧИТЬ ПО
	|	ИмяСС,
	|	НомерСтроки";

	Этапы = Новый Соответствие;
	Цены = Новый Соответствие;
	НомераЭтапов = Новый Соответствие;
	СчетчикЭтапов = 0;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючНазвы = ВРег(СокрЛП(Выборка.ИмяНазвы));
		Если КлючНазвы = "" Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Этап) Тогда
			Если НомераЭтапов.Получить(Выборка.Этап) = Неопределено Тогда
				СчетчикЭтапов = СчетчикЭтапов + 1;
				НомераЭтапов.Вставить(Выборка.Этап, СчетчикЭтапов);
			КонецЕсли;
			Если Этапы.Получить(КлючНазвы) = Неопределено Тогда
				НомерЭтапа = НомераЭтапов.Получить(Выборка.Этап);
				Этапы.Вставить(КлючНазвы, Новый Структура("Этап, ЭтапНомер, ЭтапСтрока",
					Выборка.Этап, НомерЭтапа, ПодписьЭтапа(НомерЭтапа, Строка(Выборка.Этап))));
			КонецЕсли;
		КонецЕсли;
		КлючЦены = КлючНазвы + "|" + ВРег(СокрЛП(Выборка.ИмяЕдиницы));
		Группа = Цены.Получить(КлючЦены);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("ПланКол, ПланГрн", 0, 0);
			Цены.Вставить(КлючЦены, Группа);
		КонецЕсли;
		Группа.ПланКол = Группа.ПланКол + Выборка.Количество;
		Группа.ПланГрн = Группа.ПланГрн + Выборка.Сумма;
	КонецЦикла;

	Возврат Новый Структура("Этапы, Цены", Этапы, Цены);

КонецФункции

// Подпись раздела "NN. Имя" — двузначный номер даёт строковую сортировку = порядку листа.
Функция ПодписьЭтапа(Номер, Имя)

	Возврат ?(Номер < 10, "0" + Строка(Номер), Строка(Номер)) + ". " + Имя;

КонецФункции

// Разнос строк факта по этапам: назва найдена в карте -> её единственный этап;
// не найдена (или назвы нет у номенклатуры) -> раздел "99. Позапланово" (Этап пустой).
Процедура РазнестиПоЭтапам(ТЗ, КартаЭтапов)

	Для Каждого СтрокаТЗ Из ТЗ Цикл
		ДанныеЭтапа = Неопределено;
		Если ЗначениеЗаполнено(СтрокаТЗ.ОбщееНазвание) Тогда
			ДанныеЭтапа = КартаЭтапов.Получить(ВРег(СокрЛП(СтрокаТЗ.ОбщееНазвание.Наименование)));
		КонецЕсли;
		Если ДанныеЭтапа = Неопределено Тогда
			СтрокаТЗ.ЭтапНомер = 99;
			СтрокаТЗ.ЭтапСтрока = "99. Позапланово";
		Иначе
			СтрокаТЗ.Этап = ДанныеЭтапа.Этап;
			СтрокаТЗ.ЭтапНомер = ДанныеЭтапа.ЭтапНомер;
			СтрокаТЗ.ЭтапСтрока = ДанныеЭтапа.ЭтапСтрока;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Деньги строки: СуммаСНДС = себестоимость (с НДС), при нуле (месяц не закрыт) —
// fallback Количество * плановая цена СС (ключ «назва+одиниця»). ИсточникЦены — прозрачность.
// ЦенаСНДС на детальной строке; на группах пересчитывается totalField схемы.
Процедура ЗаполнитьСуммыИЦены(ТЗ, КартаЦен)

	Для Каждого СтрокаТЗ Из ТЗ Цикл
		СуммаПлан = 0;
		Если ЗначениеЗаполнено(СтрокаТЗ.ОбщееНазвание) Тогда
			КлючЦены = ВРег(СокрЛП(СтрокаТЗ.ОбщееНазвание.Наименование)) + "|" + КлючЕдиницы(СтрокаТЗ.Единица);
			Группа = КартаЦен.Получить(КлючЦены);
			Если Группа <> Неопределено И Группа.ПланКол > 0 Тогда
				СуммаПлан = СтрокаТЗ.Количество * (Группа.ПланГрн / Группа.ПланКол);
			КонецЕсли;
		КонецЕсли;
		СтрокаТЗ.СуммаПлан = СуммаПлан;
		Если СтрокаТЗ.СуммаСоб <> 0 Тогда
			СтрокаТЗ.СуммаСНДС = СтрокаТЗ.СуммаСоб;
			СтрокаТЗ.ИсточникЦены = "Собівартість";
		ИначеЕсли СуммаПлан <> 0 Тогда
			СтрокаТЗ.СуммаСНДС = СуммаПлан;
			СтрокаТЗ.ИсточникЦены = "Планова ціна";
		Иначе
			СтрокаТЗ.СуммаСНДС = 0;
			СтрокаТЗ.ИсточникЦены = "Без ціни";
		КонецЕсли;
		СтрокаТЗ.ЦенаСНДС = ?(СтрокаТЗ.Количество = 0, 0, СтрокаТЗ.СуммаСНДС / СтрокаТЗ.Количество);
	КонецЦикла;

КонецПроцедуры

// Нормализованное ИМЯ единицы измерения. По ссылке сравнивать нельзя: справочник подчинён
// владельцу, «шт» у разных номенклатур — разные ссылки; в классификаторе дубли «шт» / « шт».
Функция КлючЕдиницы(Единица)

	Если НЕ ЗначениеЗаполнено(Единица) Тогда
		Возврат "";
	КонецЕсли;
	Возврат ВРег(СокрЛП(Единица.Наименование));

КонецФункции

// Пустая ТЗ грейна (типы колонок = полям внешнего набора "Детали" схемы СКД).
// Порядок и типы обязаны совпадать со схемой — рассинхрон даёт битые данные без ошибки.
Функция СоздатьПустуюТаблицу()

	ТЗ = Новый ТаблицаЗначений;
	ОписЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 3, ДопустимыйЗнак.Любой));
	ОписСтрока20 = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20));
	ОписСтрока50 = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50));
	ОписСтрока100 = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100));
	ОписСтрока150 = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(150));

	МассивДокумент = Новый Массив;
	МассивДокумент.Добавить(Тип("ДокументСсылка.СборкаТоваров"));
	МассивДокумент.Добавить(Тип("ДокументСсылка.ВнутреннееПотреблениеТоваров"));

	ТЗ.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ТЗ.Колонки.Добавить("ПодразделениеИсполнитель", Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ТЗ.Колонки.Добавить("ЭтапНомер", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	ТЗ.Колонки.Добавить("ЭтапСтрока", ОписСтрока100);
	ТЗ.Колонки.Добавить("Этап", Новый ОписаниеТипов("СправочникСсылка.А_ЭтапыРабот"));
	ТЗ.Колонки.Добавить("ОбщееНазвание", Новый ОписаниеТипов("СправочникСсылка.А_ОбщиеНазванияНоменклатуры"));
	ТЗ.Колонки.Добавить("Аналитика", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("НоменклатураНаименование", ОписСтрока150);
	ТЗ.Колонки.Добавить("Единица", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	ТЗ.Колонки.Добавить("Документ", Новый ОписаниеТипов(МассивДокумент));
	ТЗ.Колонки.Добавить("ВидДокумента", ОписСтрока50);
	ТЗ.Колонки.Добавить("ИсточникЦены", ОписСтрока20);
	ТЗ.Колонки.Добавить("Количество", ОписЧисло);
	ТЗ.Колонки.Добавить("СуммаСоб", ОписЧисло);
	ТЗ.Колонки.Добавить("СуммаПлан", ОписЧисло);
	ТЗ.Колонки.Добавить("СуммаСНДС", ОписЧисло);
	ТЗ.Колонки.Добавить("ЦенаСНДС", ОписЧисло);
	Возврат ТЗ;

КонецФункции

// Значение параметра компоновки БЕЗ обращения к БСП
// (КомпоновкаДанныхКлиентСервер.ПолучитьПараметр есть не во всех базах семейства).
Функция ПолучитьЗначениеПараметра(Настройки, ИмяПараметра)
	Если Настройки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Параметр = Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
	Возврат ?(Параметр = Неопределено, Неопределено, Параметр.Значение);
КонецФункции

Функция ПолучитьТаблицуКоманд()
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
КонецПроцедуры

#КонецОбласти

#КонецЕсли
