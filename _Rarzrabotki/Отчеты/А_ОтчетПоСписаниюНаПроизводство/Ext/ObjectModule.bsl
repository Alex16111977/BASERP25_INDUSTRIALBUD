#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Внешний отчёт А_ОтчетПоСписаниюНаПроизводство.
// «Списання на виробництво: план-факт» — программная компоновка СКД (ПриКомпоновкеРезультата):
// данные строит ObjectModule (ПолучитьДанные), затем передаются в СКД как внешний набор "Детали".
//
// План — Справочник.А_СтруктураСебестоимости.Комплектующие, тираж на подразделения-исполнители.
// Факт — РегистрНакопления.СебестоимостьТоваров (Расход / ТоварыНаСкладах) по документам
// СборкаТоваров и ВнутреннееПотреблениеТоваров, подразделение-исполнитель = СТ.Подразделение.
//
// Причины программной компоновки:
//   1) тираж плана на исполнителей (норма * Домов / КолвоИсполнителей);
//   2) маппинг «Загальна назва -> Етап» невозможен в чистом запросе СКД: у справочника
//      А_ОбщиеНазванияНоменклатуры есть дубли карточек с одинаковым именем (сопоставление
//      только по нормализованному ИМЕНИ через Соответствие);
//   3) оценка факта в плановых ценах (ФактГрнПлан) — нужна средняя плановая цена по группе.
//
// Все запросы проверены Python-COM на живой BaseERP (Rule #-1).
// Спека: docs/superpowers/specs/2026-08-05-spisanie-na-proizvodstvo-design.md

#Область СлужебныйПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	МассивНазначений = Новый Массив;
	МассивНазначений.Добавить("");

	ИмяОтчета = Метаданные().Представление();

	ПараметрыРегистрации.Вставить("Вид", "ДополнительныйОтчет");
	ПараметрыРегистрации.Вставить("Назначение", МассивНазначений);
	ПараметрыРегистрации.Вставить("Наименование", ИмяОтчета);
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Истина);
	ПараметрыРегистрации.Вставить("Информация",
		"Списання на виробництво: план по структурі собівартості проти факту списання по підрозділах-виконавцях");

	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд, ИмяОтчета, Метаданные().ПолноеИмя(), "ОткрытиеФормы", Истина);
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);

	Возврат ПараметрыРегистрации;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Программная компоновка: данные готовятся в ПолучитьДанные и передаются в СКД
// как внешний набор данных "Детали". Расшифровка штатная (ДанныеРасшифровки прокидывается).
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	УстановитьПривилегированныйРежим(Истина);

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();

	Период = ПолучитьЗначениеПараметра(КомпоновщикНастроек, "Период");

	ТаблицаДетали = ПолучитьДанные(Период);

	ВнешниеНаборыДанных = Новый Структура("Детали", ТаблицаДетали);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Главный сбор данных: плоская ТЗ грейна по ВСЕМ драйверам активных структур себестоимости.
// Драйвер = ПодразделениеОбъекта (fallback -> Подразделение). Именно он, а НЕ Подразделение:
// у IRS 15 м и 30 м Подразделение — общий зонтик «МД IRS 2026», и факт «В ИЕРАРХИИ» по нему
// достался бы обеим карточкам (двойной счёт). ПодразделениеОбъекта разводит их корректно.
// Границы периода независимы: пустое начало -> '00010101', пустой конец -> '39991231'.
Функция ПолучитьДанные(Период) Экспорт

	Если ЗначениеЗаполнено(Период) И ЗначениеЗаполнено(Период.ДатаНачала) Тогда
		НачП = Период.ДатаНачала;
	Иначе
		НачП = '00010101000000';
	КонецЕсли;
	Если ЗначениеЗаполнено(Период) И ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		КонП = КонецДня(Период.ДатаОкончания);
	Иначе
		КонП = '39991231235959';
	КонецЕсли;

	ТЗ = СоздатьПустуюТаблицу();

	Для Каждого Драйвер Из ПолучитьДрайверы() Цикл
		МассивВиконавцев = ПолучитьИсполнителей(Драйвер);
		ТЗЧасть = ВыполнитьЗапросПоДрайверу(Драйвер, МассивВиконавцев, НачП, КонП);
		ЗаполнитьЭтапИКатегориюФакта(ТЗЧасть, Драйвер);
		ЗаполнитьОценкуВПлановыхЦенах(ТЗЧасть);
		Для Каждого СтрокаЧасти Из ТЗЧасть Цикл
			ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), СтрокаЧасти);
		КонецЦикла;
	КонецЦикла;

	ЗаполнитьПроизводные(ТЗ);

	Возврат ТЗ;

КонецФункции

// Производные показатели на уровне ДЕТАЛЬНОЙ строки. На уровнях группировок те же формулы
// пересчитываются схемой через totalField — иначе средние цены и проценты сложились бы суммой.
// Считаются последними: ФактГрнПлан появляется только после ЗаполнитьОценкуВПлановыхЦенах.
Процедура ЗаполнитьПроизводные(ТЗ)

	Для Каждого СтрокаТЗ Из ТЗ Цикл
		СтрокаТЗ.ЦенаПлан = ?(СтрокаТЗ.ПланКол = 0, 0, СтрокаТЗ.ПланГрн / СтрокаТЗ.ПланКол);
		СтрокаТЗ.ЦенаФакт = ?(СтрокаТЗ.ФактКол = 0, 0, СтрокаТЗ.ФактГрнСоб / СтрокаТЗ.ФактКол);
		СтрокаТЗ.ОтклонениеКол = СтрокаТЗ.ФактКол - СтрокаТЗ.ПланКол;
		// кількісне відхилення в грошах: працює і на НЕзакритому місяці (собівартість там 0)
		СтрокаТЗ.ОтклонениеКолГрн = СтрокаТЗ.ФактГрнПлан - СтрокаТЗ.ПланГрн;
		СтрокаТЗ.ОтклонениеЦенаГрн = СтрокаТЗ.ФактГрнСоб - СтрокаТЗ.ФактГрнПлан;
		СтрокаТЗ.ОтклонениеГрн = СтрокаТЗ.ФактГрнСоб - СтрокаТЗ.ПланГрн;
		СтрокаТЗ.ПроцентКол = ?(СтрокаТЗ.ПланКол = 0, 0, СтрокаТЗ.ФактКол / СтрокаТЗ.ПланКол * 100);
		СтрокаТЗ.ПроцентГрн = ?(СтрокаТЗ.ПланГрн = 0, 0, СтрокаТЗ.ФактГрнСоб / СтрокаТЗ.ПланГрн * 100);
		СтрокаТЗ.ОстатокПланаКол = Макс(0, СтрокаТЗ.ПланКол - СтрокаТЗ.ФактКол);
		СтрокаТЗ.ОстатокПланаГрн = Макс(0, СтрокаТЗ.ПланГрн - СтрокаТЗ.ФактГрнПлан);
	КонецЦикла;

КонецПроцедуры

// Массив подразделений-драйверов: РАЗЛИЧНЫЕ ПодразделениеОбъекта (fallback Подразделение)
// по всем активным не-групповым карточкам структуры себестоимости.
Функция ПолучитьДрайверы()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА СС.ПодразделениеОбъекта <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ТОГДА СС.ПодразделениеОбъекта
	|		ИНАЧЕ СС.Подразделение
	|	КОНЕЦ КАК Драйвер
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости КАК СС
	|ГДЕ
	|	НЕ СС.ЭтоГруппа
	|	И СС.Активная
	|	И ВЫБОР
	|		КОГДА СС.ПодразделениеОбъекта <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ТОГДА СС.ПодразделениеОбъекта
	|		ИНАЧЕ СС.Подразделение
	|	КОНЕЦ <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)";

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Драйвер");

КонецФункции

// Подразделения-исполнители драйвера = его непосредственные дети (для IRS это «№1..№N»,
// их число равно КоличествоДомов). Если детей нет — исполнителем считается сам драйвер.
// ⚠️ Справочник.СтруктураПредприятия — иерархия ЭЛЕМЕНТОВ, реквизита ЭтоГруппа у него НЕТ.
Функция ПолучитьИсполнителей(Драйвер)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Драйвер", Драйвер);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Ссылка КАК Викон
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК П
	|ГДЕ
	|	П.Родитель = &Драйвер
	|	И НЕ П.ПометкаУдаления";

	Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Викон");
	Если Массив.Количество() = 0 Тогда
		Массив.Добавить(Драйвер);
	КонецЕсли;
	Возврат Массив;

КонецФункции

// Запрос грейна по ОДНОМУ драйверу: UNION плановой и фактовой веток.
//
// План тиражируется на исполнителей: множитель = Домов / КолвоИсполнителей.
// Инвариант: сумма плана по исполнителям РАВНА норме ТЧ * КоличествоДомов при любом числе детей.
//
// Факт НЕ соединяется ни с чем (только ГДЕ) — иначе при нескольких активных СС на одном драйвере
// «ПО ИСТИНА» умножил бы факт на число карточек.
// ⚠️ «В ИЕРАРХИИ (столбец ВТ)» запрещено платформой — только параметр или подзапрос.
Функция ВыполнитьЗапросПоДрайверу(Драйвер, МассивВиконавцев, НачП, КонП)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Драйвер", Драйвер);
	Запрос.УстановитьПараметр("МассивВиконавцев", МассивВиконавцев);
	Запрос.УстановитьПараметр("КолВиконавцев", МассивВиконавцев.Количество());
	Запрос.УстановитьПараметр("НачП", НачП);
	Запрос.УстановитьПараметр("КонП", КонП);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СС.Ссылка КАК СС,
	|	ВЫБОР КОГДА СС.КоличествоДомов > 0 ТОГДА СС.КоличествоДомов ИНАЧЕ 1 КОНЕЦ КАК Домов
	|ПОМЕСТИТЬ ВТ_СС
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости КАК СС
	|ГДЕ
	|	НЕ СС.ЭтоГруппа
	|	И СС.Активная
	|	И ВЫБОР
	|		КОГДА СС.ПодразделениеОбъекта <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ТОГДА СС.ПодразделениеОбъекта
	|		ИНАЧЕ СС.Подразделение
	|	КОНЕЦ = &Драйвер
	|;
	|ВЫБРАТЬ
	|	П.Ссылка КАК Викон
	|ПОМЕСТИТЬ ВТ_Викон
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК П
	|ГДЕ
	|	П.Ссылка В (&МассивВиконавцев)
	|;
	|ВЫБРАТЬ
	|	&Драйвер КАК Подразделение,
	|	Вик.Викон КАК ПодразделениеИсполнитель,
	|	ВТ_СС.СС КАК СтруктураСебестоимости,
	|	ВЫРАЗИТЬ(ВЫБОР КОГДА К.Этап.Наименование ПОДОБНО ""%Монтаж%"" ТОГДА ""Монтаж"" ИНАЧЕ ""Виробництво"" КОНЕЦ КАК СТРОКА(50)) КАК Категория,
	|	К.Этап КАК Этап,
	|	ВЫБОР
	|		КОГДА К.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА К.ОбщееНазвание
	|		ИНАЧЕ К.Номенклатура.А_ОбщееНазваниеНоменклатуры
	|	КОНЕЦ КАК ОбщееНазвание,
	|	ВЫБОР
	|		КОГДА К.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА К.НоменклатураСС
	|		ИНАЧЕ К.Номенклатура
	|	КОНЕЦ КАК Аналитика,
	|	"""" КАК НоменклатураНаименование,
	|	К.Единица КАК Единица,
	|	ВТ_СС.СС КАК Документ,
	|	ВЫРАЗИТЬ(""0. План"" КАК СТРОКА(50)) КАК ВидДокумента,
	|	ВЫРАЗИТЬ(""1. В плані"" КАК СТРОКА(30)) КАК СтатусПлана,
	|	К.Количество * ВТ_СС.Домов / &КолВиконавцев КАК ПланКол,
	|	К.Сумма * ВТ_СС.Домов / &КолВиконавцев КАК ПланГрн,
	|	0 КАК ФактКол,
	|	0 КАК ФактГрнСоб,
	|	0 КАК ФактГрнПлан
	|ПОМЕСТИТЬ ВТ_Детали
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Комплектующие КАК К
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
	|		ПО К.Ссылка = ВТ_СС.СС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Викон КАК Вик
	|		ПО ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Драйвер,
	|	СТ.Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.А_СтруктураСебестоимости.ПустаяСсылка),
	|	ВЫРАЗИТЬ(""Виробництво"" КАК СТРОКА(50)),
	|	НЕОПРЕДЕЛЕНО,
	|	СТ.АналитикаУчетаНоменклатуры.Номенклатура.А_ОбщееНазваниеНоменклатуры,
	|	СТ.АналитикаУчетаНоменклатуры.Номенклатура,
	|	СТ.АналитикаУчетаНоменклатуры.Номенклатура.Наименование,
	|	СТ.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения,
	|	СТ.Регистратор,
	|	ВЫРАЗИТЬ(ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СТ.Регистратор) = ТИП(Документ.СборкаТоваров)
	|			ТОГДА ""1. Комплектація""
	|		ИНАЧЕ ""2. Внутрішнє споживання""
	|	КОНЕЦ КАК СТРОКА(50)),
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(30)),
	|	0,
	|	0,
	|	СТ.Количество,
	|	СТ.Стоимость,
	|	0
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров КАК СТ
	|ГДЕ
	|	СТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И СТ.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыНаСкладах)
	|	И СТ.Период МЕЖДУ &НачП И &КонП
	|	И ТИПЗНАЧЕНИЯ(СТ.Регистратор) В (ТИП(Документ.СборкаТоваров), ТИП(Документ.ВнутреннееПотреблениеТоваров))
	|	И СТ.Подразделение В ИЕРАРХИИ (&Драйвер)
	|;
	|ВЫБРАТЬ
	|	ВТ_Детали.Подразделение КАК Подразделение,
	|	ВТ_Детали.ПодразделениеИсполнитель КАК ПодразделениеИсполнитель,
	|	ВТ_Детали.СтруктураСебестоимости КАК СтруктураСебестоимости,
	|	ВТ_Детали.Категория КАК Категория,
	|	ВТ_Детали.Этап КАК Этап,
	|	ВТ_Детали.ОбщееНазвание КАК ОбщееНазвание,
	|	ВТ_Детали.Аналитика КАК Аналитика,
	|	ВТ_Детали.НоменклатураНаименование КАК НоменклатураНаименование,
	|	ВТ_Детали.Единица КАК Единица,
	|	ВТ_Детали.Документ КАК Документ,
	|	ВТ_Детали.ВидДокумента КАК ВидДокумента,
	|	ВТ_Детали.СтатусПлана КАК СтатусПлана,
	|	СУММА(ВТ_Детали.ПланКол) КАК ПланКол,
	|	СУММА(ВТ_Детали.ПланГрн) КАК ПланГрн,
	|	СУММА(ВТ_Детали.ФактКол) КАК ФактКол,
	|	СУММА(ВТ_Детали.ФактГрнСоб) КАК ФактГрнСоб,
	|	СУММА(ВТ_Детали.ФактГрнПлан) КАК ФактГрнПлан
	|ИЗ
	|	ВТ_Детали КАК ВТ_Детали
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Детали.Подразделение,
	|	ВТ_Детали.ПодразделениеИсполнитель,
	|	ВТ_Детали.СтруктураСебестоимости,
	|	ВТ_Детали.Категория,
	|	ВТ_Детали.Этап,
	|	ВТ_Детали.ОбщееНазвание,
	|	ВТ_Детали.Аналитика,
	|	ВТ_Детали.НоменклатураНаименование,
	|	ВТ_Детали.Единица,
	|	ВТ_Детали.Документ,
	|	ВТ_Детали.ВидДокумента,
	|	ВТ_Детали.СтатусПлана";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Разнос строк ФАКТА (Етап пуст) по Етапу и Категорії:
// «Загальна назва» -> {Этап, Категория} из плана Комплектующие этого драйвера (через Соответствие).
// Ключ — нормализованное ИМЯ общей назвы: у А_ОбщиеНазванияНоменклатуры есть ДУБЛИ карточек
// с одинаковым именем, сопоставление по ссылке их не находит.
// Категория Вир/Монт берётся по этапу тем же выражением, что и у плана (ПОДОБНО "%Монтаж%").
Процедура ЗаполнитьЭтапИКатегориюФакта(ТЗ, Драйвер)

	Маппинг = МаппингОбщееНазваниеЭтап(Драйвер);
	Если Маппинг.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТЗ Из ТЗ Цикл
		Если СтрокаТЗ.ВидДокумента = "0. План" ИЛИ ЗначениеЗаполнено(СтрокаТЗ.Этап) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаТЗ.ОбщееНазвание) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = СокрЛП(СтрокаТЗ.ОбщееНазвание.Наименование);
		ДанныеЭтапа = Маппинг.Получить(Ключ);
		Если ДанныеЭтапа <> Неопределено Тогда
			СтрокаТЗ.Этап = ДанныеЭтапа.Этап;
			СтрокаТЗ.Категория = ДанныеЭтапа.Категория;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Оценка факта в ПЛАНОВЫХ ценах (колонка ФактГрнПлан) + статус сопоставления с планом.
//
// Зачем: себестоимость выбытия в ЕРП проставляет месячное закрытие (РасчетСебестоимостиТоваров);
// до закрытия Расход пишется с количеством и Стоимость = 0, и денежный план-факт был бы пустым.
// ФактГрнПлан = ФактКол * ЦенаПлан работает и на НЕзакрытом месяце и даёт кількісне відхилення
// в гривнях (ФактГрнПлан - ПланГрн).
//
// 🔴 КЛЮЧ ЦЕНЫ — «загальна назва + ОДИНИЦЯ», НЕ одна лише загальна назва.
// Замер 05.08.2026: по одной лишь назве оценка = 34,3 млн при собівартості 11,15 млн, причём
// 19,8 млн разрыва дала ОДНА мусорная назва «мшп» (план 6 балонів × 1054 грн, факт 18 811 одиниць
// у «к-т/пак/пар/шт»). Средняя цена по группе, где смешаны балон/к-т/пак/пар/шт, бессмысленна.
// С единицей: 14,36 млн, покрытие 85,8% фактической себестоимости — правдоподобно.
//
// Единица сравнивается по нормализованному ИМЕНИ, а не по ссылке: справочник
// УпаковкиЕдиницыИзмерения подчинён владельцу (Номенклатура / Наборы упаковок), поэтому «шт»
// разных номенклатур — РАЗНЫЕ ссылки.
//
// СтатусПлана у фактовых строк:
//   «1. В плані»         — цена найдена, ФактГрнПлан посчитан;
//   «2. Інша од. виміру» — назва в плане есть, но в другой единице -> цена не применима;
//   «3. Позапланово»     — назвы в плане проекта нет вообще.
Процедура ЗаполнитьОценкуВПлановыхЦенах(ТЗ)

	ЦеныПлана = Новый Соответствие; // назва+одиниця -> {ПланКол, ПланГрн}
	НазвыПлана = Новый Соответствие; // назва -> Истина

	Для Каждого СтрокаТЗ Из ТЗ Цикл
		Если СтрокаТЗ.ВидДокумента <> "0. План" Тогда
			Продолжить;
		КонецЕсли;
		КлючНазвы = КлючОбщейНазвы(СтрокаТЗ.ОбщееНазвание);
		Если КлючНазвы = "" Тогда
			Продолжить;
		КонецЕсли;
		НазвыПлана.Вставить(КлючНазвы, Истина);
		Ключ = КлючНазвы + "|" + КлючЕдиницы(СтрокаТЗ.Единица);
		Группа = ЦеныПлана.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("ПланКол, ПланГрн", 0, 0);
			ЦеныПлана.Вставить(Ключ, Группа);
		КонецЕсли;
		Группа.ПланКол = Группа.ПланКол + СтрокаТЗ.ПланКол;
		Группа.ПланГрн = Группа.ПланГрн + СтрокаТЗ.ПланГрн;
	КонецЦикла;

	Для Каждого СтрокаТЗ Из ТЗ Цикл
		Если СтрокаТЗ.ВидДокумента = "0. План" Тогда
			Продолжить;
		КонецЕсли;
		КлючНазвы = КлючОбщейНазвы(СтрокаТЗ.ОбщееНазвание);
		Если КлючНазвы = "" ИЛИ НазвыПлана.Получить(КлючНазвы) = Неопределено Тогда
			СтрокаТЗ.СтатусПлана = "3. Позапланово";
			Продолжить;
		КонецЕсли;
		Группа = ЦеныПлана.Получить(КлючНазвы + "|" + КлючЕдиницы(СтрокаТЗ.Единица));
		Если Группа = Неопределено ИЛИ Группа.ПланКол <= 0 Тогда
			СтрокаТЗ.СтатусПлана = "2. Інша од. виміру";
			Продолжить;
		КонецЕсли;
		СтрокаТЗ.СтатусПлана = "1. В плані";
		СтрокаТЗ.ФактГрнПлан = СтрокаТЗ.ФактКол * (Группа.ПланГрн / Группа.ПланКол);
	КонецЦикла;

КонецПроцедуры

// Нормализованный строковый ключ общей назвы (дубли карточек с одним именем схлопываются).
Функция КлючОбщейНазвы(ОбщееНазвание)

	Если НЕ ЗначениеЗаполнено(ОбщееНазвание) Тогда
		Возврат "";
	КонецЕсли;
	Имя = ВРег(СокрЛП(ОбщееНазвание.Наименование));
	Если Имя = "" Тогда
		Возврат "УИД|" + Строка(ОбщееНазвание.УникальныйИдентификатор());
	КонецЕсли;
	Возврат "ОН|" + Имя;

КонецФункции

// Нормализованное ИМЯ единицы измерения. По ссылке сравнивать нельзя: справочник подчинён
// владельцу, «шт» у разных номенклатур — разные ссылки. В классификаторе встречаются дубли
// с лишними пробелами («шт» / « шт»), поэтому СокрЛП + ВРег.
Функция КлючЕдиницы(Единица)

	Если НЕ ЗначениеЗаполнено(Единица) Тогда
		Возврат "";
	КонецЕсли;
	Возврат ВРег(СокрЛП(Единица.Наименование));

КонецФункции

// Соответствие ИМЯ общей назвы (нормализованное) -> Структура{Этап, Категория}
// (при нескольких этапах у одной назвы берётся максимальный по представлению — как в доноре).
// Карта строится по ВСЕМ активным СС этого драйвера.
Функция МаппингОбщееНазваниеЭтап(Драйвер)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Драйвер", Драйвер);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА К.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА К.ОбщееНазвание.Наименование
	|		ИНАЧЕ К.Номенклатура.А_ОбщееНазваниеНоменклатуры.Наименование
	|	КОНЕЦ КАК ОбщееНазвание,
	|	К.Этап КАК Этап,
	|	ВЫБОР КОГДА К.Этап.Наименование ПОДОБНО ""%Монтаж%"" ТОГДА ""Монтаж"" ИНАЧЕ ""Виробництво"" КОНЕЦ КАК Категория
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Комплектующие КАК К
	|ГДЕ
	|	К.Ссылка.Активная
	|	И НЕ К.Ссылка.ЭтоГруппа
	|	И ВЫБОР
	|		КОГДА К.Ссылка.ПодразделениеОбъекта <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ТОГДА К.Ссылка.ПодразделениеОбъекта
	|		ИНАЧЕ К.Ссылка.Подразделение
	|	КОНЕЦ = &Драйвер
	|	И ВЫБОР
	|		КОГДА К.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА К.ОбщееНазвание
	|		ИНАЧЕ К.Номенклатура.А_ОбщееНазваниеНоменклатуры
	|	КОНЕЦ <> ЗНАЧЕНИЕ(Справочник.А_ОбщиеНазванияНоменклатуры.ПустаяСсылка)
	|	И К.Этап <> ЗНАЧЕНИЕ(Справочник.А_ЭтапыРабот.ПустаяСсылка)";

	Маппинг = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = СокрЛП(Выборка.ОбщееНазвание);
		Если НЕ ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Текущий = Маппинг.Получить(Ключ);
		Если Текущий = Неопределено ИЛИ Строка(Выборка.Этап) > Строка(Текущий.Этап) Тогда
			Маппинг.Вставить(Ключ, Новый Структура("Этап, Категория", Выборка.Этап, Выборка.Категория));
		КонецЕсли;
	КонецЦикла;
	Возврат Маппинг;

КонецФункции

// Пустая ТЗ грейна (типы колонок = полям внешнего набора "Детали" схемы СКД).
// Порядок и типы обязаны совпадать со схемой — рассинхрон даёт битые данные без ошибки.
Функция СоздатьПустуюТаблицу()

	ТЗ = Новый ТаблицаЗначений;
	ОписЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 3, ДопустимыйЗнак.Любой));
	ОписСтрока50 = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50));
	ОписСтрока150 = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(150));

	МассивАналитика = Новый Массив;
	МассивАналитика.Добавить(Тип("СправочникСсылка.Номенклатура"));
	МассивАналитика.Добавить(Тип("Строка")); // план без карточки = текст НоменклатураСС (Excel)

	МассивДокумент = Новый Массив;
	МассивДокумент.Добавить(Тип("ДокументСсылка.СборкаТоваров"));
	МассивДокумент.Добавить(Тип("ДокументСсылка.ВнутреннееПотреблениеТоваров"));
	МассивДокумент.Добавить(Тип("СправочникСсылка.А_СтруктураСебестоимости"));

	ТЗ.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ТЗ.Колонки.Добавить("ПодразделениеИсполнитель", Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ТЗ.Колонки.Добавить("СтруктураСебестоимости", Новый ОписаниеТипов("СправочникСсылка.А_СтруктураСебестоимости"));
	ТЗ.Колонки.Добавить("Категория", ОписСтрока50);
	ТЗ.Колонки.Добавить("Этап", Новый ОписаниеТипов("СправочникСсылка.А_ЭтапыРабот"));
	ТЗ.Колонки.Добавить("ОбщееНазвание", Новый ОписаниеТипов("СправочникСсылка.А_ОбщиеНазванияНоменклатуры"));
	ТЗ.Колонки.Добавить("Аналитика", Новый ОписаниеТипов(МассивАналитика, , Новый КвалификаторыСтроки(200)));
	ТЗ.Колонки.Добавить("НоменклатураНаименование", ОписСтрока150);
	ТЗ.Колонки.Добавить("Единица", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	ТЗ.Колонки.Добавить("Документ", Новый ОписаниеТипов(МассивДокумент));
	ТЗ.Колонки.Добавить("ВидДокумента", ОписСтрока50);
	ТЗ.Колонки.Добавить("СтатусПлана", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(30)));
	ТЗ.Колонки.Добавить("ПланКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ПланГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ФактКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ФактГрнСоб", ОписЧисло);
	ТЗ.Колонки.Добавить("ФактГрнПлан", ОписЧисло);
	ТЗ.Колонки.Добавить("ЦенаПлан", ОписЧисло);
	ТЗ.Колонки.Добавить("ЦенаФакт", ОписЧисло);
	ТЗ.Колонки.Добавить("ОтклонениеКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ОтклонениеКолГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ОтклонениеЦенаГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ОтклонениеГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ПроцентКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ПроцентГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ОстатокПланаКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ОстатокПланаГрн", ОписЧисло);
	Возврат ТЗ;

КонецФункции

Функция ПолучитьЗначениеПараметра(Компоновщик, ИмяПараметра)
	Параметр = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(Компоновщик, ИмяПараметра);
	Возврат ?(Параметр = Неопределено, Неопределено, Параметр.Значение);
КонецФункции

Функция ПолучитьТаблицуКоманд()
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
КонецПроцедуры

