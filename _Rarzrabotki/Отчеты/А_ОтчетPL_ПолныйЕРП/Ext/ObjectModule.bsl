// Ось колонок отчёта: месяцы периода (ГГГГММ), «PL с начала года» (890000),
// накопительный итог (900000), план объекта (900100). Порядок задаёт КолонкаСорт,
// подпись — КолонкаПредставление.
//
// Флажки убирают блок ЦЕЛИКОМ, а не отбором: колонки просто не создаётся,
// поэтому её ветка запроса не читает данные. Снять «Месяцы» на длинном периоде —
// самый дешёвый способ ускорить отчёт, когда нужен только накопительный итог.
Функция ТаблицаКолонок(НачалоПериода, КонецПериода,
	ВыводитьМесяцы = Истина, ВыводитьНакопительный = Истина, ВыводитьПлан = Истина,
	ВыводитьСНачалаГода = Ложь)

	Колонки = Новый ТаблицаЗначений;
	Колонки.Колонки.Добавить("КолонкаСорт", Новый ОписаниеТипов("Число",
		Новый КвалификаторыЧисла(10, 0)));
	Колонки.Колонки.Добавить("КолонкаПредставление", Новый ОписаниеТипов("Строка", ,
		Новый КвалификаторыСтроки(30)));
	Колонки.Колонки.Добавить("МесяцДата", Новый ОписаниеТипов("Дата"));

	// ТекМесяц, а не Месяц: имя Месяц занято встроенной функцией, Месяц(Месяц) не скомпилируется.
	Если ВыводитьМесяцы Тогда
		ТекМесяц = НачалоМесяца(НачалоПериода);
		Пока ТекМесяц <= КонецПериода Цикл
			Стр = Колонки.Добавить();
			Стр.КолонкаСорт = Год(ТекМесяц) * 100 + Месяц(ТекМесяц);
			// Л=ru_RU: язык сеанса на другом сервере — украинский, месяцы выходили «Липень 2026».
			Стр.КолонкаПредставление = Формат(ТекМесяц, "Л=ru_RU; ДФ='MMMM yyyy'");
			Стр.МесяцДата = ТекМесяц;
			ТекМесяц = ДобавитьМесяц(ТекМесяц, 1);
		КонецЦикла;
	КонецЕсли;

	// YTD стоит ПЕРЕД накопительным: горизонт растёт слева направо —
	// месяц -> год -> вся деятельность -> план (решение финансиста 24.08.2026).
	Если ВыводитьСНачалаГода Тогда
		Стр = Колонки.Добавить();
		Стр.КолонкаСорт = 890000;
		Стр.КолонкаПредставление = "PL с начала года";
		Стр.МесяцДата = Дата(1, 1, 1);
	КонецЕсли;

	Если ВыводитьНакопительный Тогда
		Стр = Колонки.Добавить();
		Стр.КолонкаСорт = 900000;
		Стр.КолонкаПредставление = "Накопительный PL";
		Стр.МесяцДата = Дата(1, 1, 1);
	КонецЕсли;

	// План идёт ПОСЛЕДНИМ (сорт 900100), как просил финансист:
	// сначала факт по месяцам, затем накопительный итог, и только потом план.
	Если ВыводитьПлан Тогда
		Стр = Колонки.Добавить();
		Стр.КолонкаСорт = 900100;
		Стр.КолонкаПредставление = "План итого";
		Стр.МесяцДата = Дата(1, 1, 1);
	КонецЕсли;

	Если Колонки.Количество() = 0 Тогда
		ВызватьИсключение "Сняты все флажки блоков колонок — выводить нечего.
			|Включите хотя бы один: «Месяцы», «PL с начала года», «Накопительный PL»
			|или «План объекта».";
	КонецЕсли;

	Возврат Колонки;

КонецФункции

// Возвращает ссылку на ДДС с флагом А_ПриёмникСебестоимостиПродажPL.
// Если такой нет — ПустаяСсылка, и себестоимость продаж в отчёте не появляется.
Функция ПолучитьДДСПриёмникCoGS()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ссылка
	|ИЗ
	|	Справочник.СтатьиДвиженияДенежныхСредств
	|ГДЕ
	|	А_ПриёмникСебестоимостиПродажPL
	|	И НЕ ПометкаУдаления";

	Рез = Запрос.Выполнить().Выгрузить();
	Если Рез.Количество() = 0 Тогда
		Возврат Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
	КонецЕсли;

	Возврат Рез[0].Ссылка;

КонецФункции

// СтатьяДоходов для ТОВАРНОЙ выручки: та, чья А_СтатьяДвиженияДенежныхСредств входит
// в ТЧ Статьи PL-статьи «Доход от прочей операционной деятельности» (код 000000002).
// Приоритет — «Прочие доходи». Если подходящей нет — вся выручка остаётся на ВыручкаОтПродаж.
Функция ПолучитьСтатьюДоходовТовара()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СД.Ссылка КАК Ссылка,
	|	ВЫБОР КОГДА СД.Наименование = ""Прочие доходи"" ТОГДА 0 ИНАЧЕ 1 КОНЕЦ КАК Приоритет
	|ИЗ
	|	ПланВидовХарактеристик.СтатьиДоходов КАК СД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.А_Статьи_PL.Статьи КАК СтатьиТЧ
	|		ПО СтатьиТЧ.СтатьяДвиженияДенежныхСредств = СД.А_СтатьяДвиженияДенежныхСредств
	|			И СтатьиТЧ.Ссылка.Код = ""000000002""
	|			И НЕ СтатьиТЧ.Ссылка.ПометкаУдаления
	|ГДЕ
	|	НЕ СД.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет, СД.Наименование";

	Рез = Запрос.Выполнить().Выгрузить();
	Если Рез.Количество() = 0 Тогда
		Возврат ПланыВидовХарактеристик.СтатьиДоходов.ПустаяСсылка();
	КонецЕсли;

	Возврат Рез[0].Ссылка;

КонецФункции

// Коды статей PL с особым поведением в водопаде — в одном месте.
// По этим кодам строка уходит из своей группы в отдельную строку листа
// и в собственную «тройку» водопада (см. ДополнитьВидКакВExcel).
Функция КодыОсобыхСтатей()

	Коды = Новый Структура;
	Коды.Вставить("Амортизация",     "000000068"); // из ОПЗ -> собственный блок между EBITDA и EBIT
	Коды.Вставить("ФинДоход",        "000000055");
	// Финансовые расходы расщеплены на три строки листа. Статья 000000056 — это и есть
	// комиссии (её ДДС — «Комиссия по Фин агенту»), 20.08.2026 она так и переименована;
	// отдельная статья 000000074 заводилась и удалена как дубль.
	Коды.Вставить("ФинРасхКомиссии", "000000056");
	Коды.Вставить("ФинРасхПроценты", "000000075"); // заведена 20.08.2026
	Коды.Вставить("КурсовыеРазницы", "000000076"); // заведена 20.08.2026
	Коды.Вставить("НалогНаПрибыль",  "000000057"); // из ФД -> блок «Налоги и сборы»
	Коды.Вставить("Дивиденды",       "000000058"); // статья ИСКЛЮЧЕНА из вывода (21.08.2026)
	Возврат Коды;

КонецФункции

// Единый пакетный запрос версии 2. Проверен на живой базе 18.08.2026, см.
// _Rarzrabotki/Python/test/v2_full.sql и приёмочные эталоны в базе знаний.
//
// Порядок временных таблиц: втСводныеПодразделения → втПредкиПодразделений → втКартаУровней
// → втКолонкиPL → втPL_ДДС → втЕРП_Расх_Детали → втЕРП_Доходы_Детали
// → втЕРП_CoGS_Детали → втЕРП_ДохCoGS_PL → финальное объединение.
//
// ПРАВИЛО ИСТОЧНИКА ФАКТА (финансист, 20.08.2026) — БЕЗ ИСКЛЮЧЕНИЙ:
//   последний месяц периода отчёта -> ТОЛЬКО регистры ЕРП;
//   все более ранние месяцы        -> ТОЛЬКО документы А_ОтчетPL;
//   месяц без документа            -> НОЛЬ (регистры не подхватываются);
//   накопительная колонка          -> документы за всю историю + регистры последнего месяца;
//   план объекта                   -> отдельная ветка с КолонкаСорт = 900100.
//
Функция ПолучитьДанные(НачалоПериода, КонецПериода, СводыНаправлений, Блоки)

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДокСвод.Подразделение КАК Подразделение
	|ПОМЕСТИТЬ втСводныеПодразделения
	|ИЗ
	|	Документ.А_ОтчетPL КАК ДокСвод
	|ГДЕ
	|	ДокСвод.ВключатьДочерние
	|	И НЕ ДокСвод.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтрПредпр.Ссылка КАК Подразделение,
	|	СтрПредпр.Ссылка КАК Предок0,
	|	СтрПредпр.Родитель КАК Предок1,
	|	СтрПредпр.Родитель.Родитель КАК Предок2,
	|	СтрПредпр.Родитель.Родитель.Родитель КАК Предок3,
	|	СтрПредпр.Родитель.Родитель.Родитель.Родитель КАК Предок4
	|ПОМЕСТИТЬ втПредкиПодразделений
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК СтрПредпр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Предки.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА НЕ &СводыНаправлений
	|			ТОГДА Предки.Подразделение
	|		КОГДА Свод0.Подразделение ЕСТЬ НЕ NULL
	|			ТОГДА Предки.Предок0
	|		КОГДА Свод1.Подразделение ЕСТЬ НЕ NULL
	|			ТОГДА Предки.Предок1
	|		КОГДА Свод2.Подразделение ЕСТЬ НЕ NULL
	|			ТОГДА Предки.Предок2
	|		КОГДА Свод3.Подразделение ЕСТЬ НЕ NULL
	|			ТОГДА Предки.Предок3
	|		КОГДА Свод4.Подразделение ЕСТЬ НЕ NULL
	|			ТОГДА Предки.Предок4
	|		ИНАЧЕ Предки.Подразделение
	|	КОНЕЦ КАК ПодразделениеОтчета
	|ПОМЕСТИТЬ втКартаУровней
	|ИЗ
	|	втПредкиПодразделений КАК Предки
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСводныеПодразделения КАК Свод0
	|		ПО Предки.Предок0 = Свод0.Подразделение
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСводныеПодразделения КАК Свод1
	|		ПО Предки.Предок1 = Свод1.Подразделение
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСводныеПодразделения КАК Свод2
	|		ПО Предки.Предок2 = Свод2.Подразделение
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСводныеПодразделения КАК Свод3
	|		ПО Предки.Предок3 = Свод3.Подразделение
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСводныеПодразделения КАК Свод4
	|		ПО Предки.Предок4 = Свод4.Подразделение
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Подразделение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КЛ.КолонкаСорт КАК КолонкаСорт,
	|	ВЫРАЗИТЬ(КЛ.КолонкаПредставление КАК Строка(30)) КАК КолонкаПредставление,
	|	КЛ.МесяцДата КАК МесяцДата
	|ПОМЕСТИТЬ втКолонкиPL
	|ИЗ
	|	&КолонкиPL КАК КЛ
	|ИНДЕКСИРОВАТЬ ПО
	|	МесяцДата,
	|	КолонкаСорт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// Колонка 890000 «PL с начала года» (24.08.2026, v8): тот же накопительный принцип,
	|// но только месяцы >= &КлючНачалаГода (январь года КОНЦА периода). Фиксов и плана
	|// в ней нет, как и в накопительной.
	|//
	|// ПРАВИЛО ИСТОЧНИКА ФАКТА (финансист, 20.08.2026) — БЕЗ ИСКЛЮЧЕНИЙ:
	|//   последний месяц периода отчёта -> ТОЛЬКО регистры ЕРП;
	|//   все более ранние месяцы        -> ТОЛЬКО документы А_ОтчетPL.
	|//
	|// Наличие документа больше НЕ проверяется: месяц без документа даёт ноль, а не
	|// подхват регистров. Поэтому таблицы втМесяцыДок / втДДСАморт / втМесяцыДокАморт
	|// и параметр &СтатьяАмортизации удалены — прежнее исключение для амортизации снято.
	|////////////////////////////////////////////////////////////////////////////////
	|// Связь PL-статья -> ДДС (все строки ТЧ Статьи).
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтатьиТЧ.Ссылка КАК СтатьяPL,
	|	СтатьиТЧ.СтатьяДвиженияДенежныхСредств КАК ДДС
	|ПОМЕСТИТЬ втPL_ДДС
	|ИЗ
	|	Справочник.А_Статьи_PL.Статьи КАК СтатьиТЧ
	|ГДЕ
	|	НЕ СтатьиТЧ.Ссылка.ПометкаУдаления
	|	И СтатьиТЧ.СтатьяДвиженияДенежныхСредств <> ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|ИНДЕКСИРОВАТЬ ПО
	|	ДДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
