#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Отчёт PL в форме Excel-листа «!PL по компании»: ось колонок повторяет книгу —
//   [месяцы периода] [Накопительный PL] [План итого]
// Строки — статьи PL в порядке листа, с водопадом прибыли внизу.
//
// Накопительный факт ГИБРИДНЫЙ. Правило источника (финансист, 19.08.2026):
//   ПОСЛЕДНИЙ месяц периода отчёта — ТОЛЬКО регистры ЕРП; документ А_ОтчетPL
//     за этот месяц игнорируется, даже если он заведён;
//   все более ранние месяцы — ТОЛЬКО документ А_ОтчетPL (это выверенный Excel);
//   месяц, за который документа по ветке нет, — регистры ЕРП, иначе факт теряется молча.
// Признак «закрыт документом» считается ПО ВЕТКЕ подразделения: лист Excel покрывает
// объект целиком, а движения ЕРП размазаны по дочерним подразделениям.
// Месяцы — ЧАСТЬ накопительного, а не добавка к нему.
//
// Параметра «Подразделение» НЕТ: отбор делает СКД любым способом (в иерархии, список, группа).
// Замер 18.08.2026: полный скан базы 0,4–1,9 с, ограничивать отбором незачем.
//
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	УстановитьПривилегированныйРежим(Истина);

	ПараметрПериод = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Период").Значение;
	НачалоПериода = НачалоДня(ПараметрПериод.ДатаНачала);
	КонецПериода = КонецДня(ПараметрПериод.ДатаОкончания);

	Если НЕ ЗначениеЗаполнено(НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(КонецПериода) Тогда
		ВызватьИсключение "Заполните параметр «Период».";
	КонецЕсли;

	СводыНаправлений = ЗначениеПараметра("СводыНаправлений", Ложь);
	ПоказИтогиПрибыли = ЗначениеПараметра("ПоказИтогиПрибыли", Истина);
	ПолныйШаблон = ЗначениеПараметра("ПолныйШаблон", Истина);
	// Служебные строки (контроль плана, предупреждение об отсутствии документов) —
	// диагностика для финансиста. В отчёте, который уходит директору, их снимают.
	ПоказатьСлужебныеСтроки = ЗначениеПараметра("ПоказатьСлужебныеСтроки", Истина);

	// Какие блоки колонок строить. Снятый флажок = колонки нет вовсе, а не отбор,
	// поэтому её данные и не читаются.
	Блоки = Новый Структура;
	Блоки.Вставить("Месяцы", ЗначениеПараметра("ВыводитьМесяцы", Истина));
	// «PL с начала года» — накопительно с 1 января года КОНЦА периода. По умолчанию
	// Ложь: сохранённые варианты не знают параметра и не должны менять вид (21.08.2026).
	Блоки.Вставить("СНачалаГода", ЗначениеПараметра("ВыводитьСНачалаГода", Ложь));
	Блоки.Вставить("Накопительный", ЗначениеПараметра("ВыводитьНакопительный", Истина));
	Блоки.Вставить("План", ЗначениеПараметра("ВыводитьПлан", Истина));
	Блоки.Вставить("Фиксы", ЗначениеПараметра("ВыводитьФиксы", Истина));
	ТолькоСтатьиСФиксами = ЗначениеПараметра("ТолькоСтатьиСФиксами", Ложь);
	// Вкл — статьи/группы/водопад/заголовки Ф1-Ф2 выводятся русскими названиями
	// из НаименованиеДляОтчетаНаРусском. Ни одна цифра при этом не меняется.
	НазванияНаРусском = ЗначениеПараметра("НазванияНаРусском", Ложь);

	ТаблицаДанных = ПолучитьДанные(НачалоПериода, КонецПериода, СводыНаправлений, Блоки);

	// Статья «Дивиденды» (000000058) исключена из отчёта решением финансиста 21.08.2026 —
	// в обоих режимах названий. Данные в справочнике и регистрах не трогаются.
	УдалитьСтрокиДивидендов(ТаблицаДанных);

	// Читаемый вид колонки: в сохранённых настройках отбор идёт словами,
	// а не числом 900 100.
	ТаблицаДанных.Колонки.Добавить("ВидКолонки",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Для Каждого Стр Из ТаблицаДанных Цикл
		Если Стр.КолонкаСорт = 900100 Тогда
			Стр.ВидКолонки = "План объекта";
		ИначеЕсли Стр.КолонкаСорт = 900000 Тогда
			Стр.ВидКолонки = "Накопительный PL";
		ИначеЕсли Стр.КолонкаСорт = 890000 Тогда
			Стр.ВидКолонки = "PL с начала года";
		Иначе
			Стр.ВидКолонки = "Месяц";
		КонецЕсли;
	КонецЦикла;

	// Аналитика1: у документных строк содержательна не аналитика, а комментарий финансиста.
	ТаблицаДанных.Колонки.Добавить("Аналитика1",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1000)));
	Для Каждого Стр Из ТаблицаДанных Цикл
		Если ТипЗнч(Стр.Документ) = Тип("ДокументСсылка.А_ОтчетPL") Тогда
			Стр.Аналитика1 = СокрЛП(Строка(Стр.Комментарий));
		Иначе
			Стр.Аналитика1 = СокрЛП(Строка(Стр.Аналитика));
		КонецЕсли;
	КонецЦикла;

	ДополнитьВидКакВExcel(ТаблицаДанных, ПоказИтогиПрибыли, ПолныйШаблон, ПоказатьСлужебныеСтроки,
		НазванияНаРусском);

	// Бюджетные строки, чей ДДС не привязан к статье PL, сворачиваются в БЕЗЫМЯННУЮ
	// группу и читаются как сбой отчёта. Подпись обязательна: без неё итог нормы
	// не объясняется суммой видимых строк (по «Производство» это 140 420 грн из 1 170 531).
	// Только там, где разметка листа не задала свою подпись.
	Для Каждого Стр Из ТаблицаДанных Цикл
		Если НЕ ЗначениеЗаполнено(Стр.СтатьяPL)
			И ПустаяСтрока(Стр.СтрокаЛиста)
			И (Стр.ФиксИтого <> 0 ИЛИ Стр.КолонкаСорт = 900100) Тогда
			Стр.СтрокаЛиста = "Бюджет без статьи PL";
		КонецЕсли;
	КонецЦикла;

	// Настройка сверки с фиксами: оставить только те статьи, где норма вообще заведена.
	// Фиксы покрывают 26 статей из ~90 — без этого лист на две трети пустой.
	// Строго ПОСЛЕ разметки: полный шаблон дорисовал бы удалённые статьи обратно.
	Если ТолькоСтатьиСФиксами Тогда
		ОставитьСтатьиСФиксами(ТаблицаДанных);
	КонецЕсли;
	ЗаполнитьРаскрытиеИсточников(ТаблицаДанных, СводыНаправлений, КонецПериода);

	// СТРОГО ПОСЛЕ разметки и полного шаблона: колонки русских представлений должны
	// получить значения у ВСЕХ строк статей, включая добавленные нулевые. Иначе часть
	// строк статьи выводилась бы старым именем и лист двоился.
	ЗаполнитьРусскиеНаименования(ТаблицаДанных, НазванияНаРусском);

	ВнешниеНаборыДанных = Новый Структура("Данные", ТаблицаДанных);

	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	// Подписи колонок факта ВСЕГДА «Сумма по Ф1, грн» / «Сумма по Ф2, грн» — независимо
	// от «Названий на русском» (решение заказчика 21.08.2026): сохранённые варианты несут
	// свои подписи («Факт: безнал (Ф1), грн») и перекрыли бы заголовок из схемы.
	УстановитьЗаголовкиФ1Ф2(НастройкиОтчета.Выбор);
	УстановитьЗаголовкиФ1Ф2ВСтруктуре(НастройкиОтчета.Структура);
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

	// Платформенные надписи шапки («Параметри:», «Так/Ні», виды сравнения) выводятся
	// на языке СЕАНСА — на другом сервере отчёт выходил с украинской шапкой.
	// Отчёт обязан быть русским всегда (решение заказчика 26.08.2026).
	РусифицироватьСлужебныеТексты(ДокументРезультат);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Оставляет только статьи, по которым заведена норма (фикс) хотя бы в одной колонке.
// Строки водопада и контроля (ВидСтроки <> "Статья") не трогаются: без них лист развалится.
Процедура ОставитьСтатьиСФиксами(ТаблицаДанных)

	СтатьиСНормой = Новый Соответствие;
	Для Каждого Стр Из ТаблицаДанных Цикл
		Если Стр.ФиксИтого <> 0 ИЛИ Стр.ФиксФ1 <> 0 ИЛИ Стр.ФиксФ2 <> 0 Тогда
			СтатьиСНормой.Вставить(Стр.СтатьяPL, Истина);
		КонецЕсли;
	КонецЦикла;

	Индекс = ТаблицаДанных.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Стр = ТаблицаДанных[Индекс];
		Если Стр.ВидСтроки = "Статья"
			И ЗначениеЗаполнено(Стр.СтатьяPL)
			И СтатьиСНормой.Получить(Стр.СтатьяPL) = Неопределено Тогда
			ТаблицаДанных.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

// Статья «Дивиденды» (000000058) исключена из отчёта финансистом 21.08.2026 — целиком,
// в обоих режимах названий. Удаляем её строки из данных ДО разметки листа, чтобы она
// не всплыла ни строкой листа, ни во «Вне структуры PL», ни в базе «% затрат».
Процедура УдалитьСтрокиДивидендов(ТаблицаДанных)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ст.Ссылка КАК СтатьяДивиденды
	|ИЗ
	|	Справочник.А_Статьи_PL КАК Ст
	|ГДЕ
	|	Ст.Код = &Код";
	Запрос.УстановитьПараметр("Код", КодыОсобыхСтатей().Дивиденды);
	Рез = Запрос.Выполнить().Выгрузить();
	Если Рез.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	СтатьяДивиденды = Рез[0].СтатьяДивиденды;

	Индекс = ТаблицаДанных.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если ТаблицаДанных[Индекс].СтатьяPL = СтатьяДивиденды Тогда
			ТаблицаДанных.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

// Представления статей и групп для полей СтатьяPLРус/ГруппаРус.
// В СХЕМЕ у полей СтатьяPL и Группа выражение представления — ЭТИ служебные поля
// (паттерн КолонкаСорт -> КолонкаPL: обращение к самому полю в его же выражении даёт
// «Рекурсивное получение представления»). Поэтому колонки заполняются в ОБОИХ режимах:
// Выкл — обычное представление ссылки, Вкл — НаименованиеДляОтчетаНаРусском с фолбэком.
Процедура ЗаполнитьРусскиеНаименования(ТаблицаДанных, НазванияНаРусском)

	ТаблицаДанных.Колонки.Добавить("СтатьяPLРус",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	ТаблицаДанных.Колонки.Добавить("ГруппаРус",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));

	Имена = Новый Соответствие;
	Если НазванияНаРусском Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Ст.Ссылка КАК Элемент,
		|	Ст.НаименованиеДляОтчетаНаРусском КАК НаРусском
		|ИЗ
		|	Справочник.А_Статьи_PL КАК Ст
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Гр.Ссылка,
		|	Гр.НаименованиеДляОтчетаНаРусском
		|ИЗ
		|	Справочник.А_ГруппаСтатей_PL КАК Гр";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.НаРусском) Тогда
				Имена.Вставить(Выборка.Элемент, Выборка.НаРусском);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Стр Из ТаблицаДанных Цикл
		Если ЗначениеЗаполнено(Стр.СтатьяPL) Тогда
			Стр.СтатьяPLРус = ?(Имена.Получить(Стр.СтатьяPL) = Неопределено,
				Строка(Стр.СтатьяPL), Имена.Получить(Стр.СтатьяPL));
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Группа) Тогда
			Стр.ГруппаРус = ?(Имена.Получить(Стр.Группа) = Неопределено,
				Строка(Стр.Группа), Имена.Получить(Стр.Группа));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Подписи колонок факта: всегда «Сумма по Ф1, грн» / «Сумма по Ф2, грн», от параметра
// «Названия на русском» НЕ зависят. Меняется подпись ВЫБРАННЫХ полей: сохранённые
// варианты несут свои подписи и перекрыли бы заголовок из схемы.
Процедура УстановитьЗаголовкиФ1Ф2(Выбор)

	Для Каждого Эл Из Выбор.Элементы Цикл
		Если ТипЗнч(Эл) <> Тип("ВыбранноеПолеКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		ИмяПоля = Строка(Эл.Поле);
		// У выбранного поля подпись — свойство «Заголовок» (в сериализации <title>);
		// «Представление» у него нет — «Поле объекта не обнаружено».
		Если ИмяПоля = "СуммаФ1" Тогда
			Эл.Заголовок = "Сумма по Ф1, грн";
		ИначеЕсли ИмяПоля = "СуммаФ2" Тогда
			Эл.Заголовок = "Сумма по Ф2, грн";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Обход структуры настроек: у вариантов-таблиц выбранные поля живут и в группировках
// Таблица.Строки / Таблица.Колонки, не только в корневом выборе.
Процедура УстановитьЗаголовкиФ1Ф2ВСтруктуре(Структура)

	Для Каждого Элемент Из Структура Цикл
		ТипЭлемента = ТипЗнч(Элемент);
		Если ТипЭлемента = Тип("ГруппировкаКомпоновкиДанных")
			ИЛИ ТипЭлемента = Тип("ГруппировкаТаблицыКомпоновкиДанных") Тогда
			УстановитьЗаголовкиФ1Ф2(Элемент.Выбор);
			УстановитьЗаголовкиФ1Ф2ВСтруктуре(Элемент.Структура);
		ИначеЕсли ТипЭлемента = Тип("ТаблицаКомпоновкиДанных") Тогда
			УстановитьЗаголовкиФ1Ф2(Элемент.Выбор);
			УстановитьЗаголовкиФ1Ф2ВСтруктуре(Элемент.Строки);
			УстановитьЗаголовкиФ1Ф2ВСтруктуре(Элемент.Колонки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Служебная шапка отчёта (блок параметров и отбора) печатается платформой на языке
// сеанса: «Параметри:», «Відбір:», «Так»/«Ні», «В групі зі списку». Код на это не
// влияет, поэтому готовый табличный документ дочищается заменами. Обрабатывается
// ТОЛЬКО шапка — строки до заголовка таблицы, данные не затрагиваются.
// Экспортная: приёмка скармливает ей украинский табличный документ и проверяет замены.
Процедура РусифицироватьСлужебныеТексты(ТабДок) Экспорт

	Замены = ЗаменыУкраинскихТекстов();

	// Граница шапки — строка заголовка таблицы («Статья PL»); если не нашли — 20 строк.
	Граница = 0;
	Для НомерСтроки = 1 По Мин(ТабДок.ВысотаТаблицы, 60) Цикл
		Для НомерКолонки = 1 По Мин(ТабДок.ШиринаТаблицы, 5) Цикл
			Если СтрНайти(ТабДок.Область(НомерСтроки, НомерКолонки,
					НомерСтроки, НомерКолонки).Текст, "Статья PL") > 0 Тогда
				Граница = НомерСтроки;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Граница > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Граница = 0 Тогда
		Граница = Мин(ТабДок.ВысотаТаблицы, 20);
	КонецЕсли;

	Для НомерСтроки = 1 По Граница Цикл
		Для НомерКолонки = 1 По ТабДок.ШиринаТаблицы Цикл
			Область = ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
			ТекстЯчейки = Область.Текст;
			Если ПустаяСтрока(ТекстЯчейки) Тогда
				Продолжить;
			КонецЕсли;
			ТекстРус = ТекстЯчейки;
			Для Каждого Пара Из Замены Цикл
				ТекстРус = СтрЗаменить(ТекстРус, Пара.Укр, Пара.Рус);
			КонецЦикла;
			Если ТекстРус <> ТекстЯчейки Тогда
				Область.Текст = ТекстРус;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

