	|	С.КолонкаСорт КАК КолонкаСорт,
	|	М.СтатьяPL КАК СтатьяPL,
	|	М.СтатьяPL.Группа КАК Группа,
	|	С.ДДС КАК ДДС,
	|	Б.Регистратор КАК Документ,
	|	СУММА(ВЫБОР КОГДА Б.ВидОплаты = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Наличные)
	|			ТОГДА 0 ИНАЧЕ Б.Сумма КОНЕЦ) КАК ФиксФ1,
	|	СУММА(ВЫБОР КОГДА Б.ВидОплаты = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Наличные)
	|			ТОГДА Б.Сумма ИНАЧЕ 0 КОНЕЦ) КАК ФиксФ2,
	|	СУММА(Б.Сумма) КАК ФиксИтого
	|ПОМЕСТИТЬ втФиксНорма
	|ИЗ
	|	втФиксСрез КАК С
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.А_БюджетыНаМесяц КАК Б
	|		ПО Б.Месяц = С.МесяцНормы
	|			И Б.СтатьяДвиженияДенежныхСредств = С.ДДС
	|			И Б.ВидПериода = ЗНАЧЕНИЕ(Перечисление.А_ВидыПериодовБюджетирования.Фиксы)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втКартаУровней КАК КУ
	|		ПО КУ.Подразделение = Б.Подразделение
	|			И КУ.ПодразделениеОтчета = С.ПодразделениеОтчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ втPL_ДДС КАК М
	|		ПО М.ДДС = С.ДДС
	|СГРУППИРОВАТЬ ПО
	|	С.ПодразделениеОтчета, С.КолонкаСорт, М.СтатьяPL, М.СтатьяPL.Группа, С.ДДС,
	|	Б.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
