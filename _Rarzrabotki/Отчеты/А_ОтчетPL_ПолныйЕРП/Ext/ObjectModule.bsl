	|	Д.ПодразделениеОтчета.А_НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ВЫРАЗИТЬ("""" КАК Строка(150)) КАК ПодразделениеСтрока,
	|	PLДДС.СтатьяPL.Группа КАК Группа,
	|	PLДДС.СтатьяPL КАК СтатьяPL,
	|	Д.ДДС КАК ДДС,
	|	КЛ.КолонкаСорт КАК КолонкаСорт,
	|	КЛ.КолонкаПредставление КАК КолонкаPL,
	|	СУММА(Д.СуммаФ1) КАК СуммаФ1,
	|	СУММА(Д.СуммаФ2) КАК СуммаФ2,
	|	СУММА(Д.СуммаИтого) КАК СуммаИтого,
	|	Д.Документ КАК Документ,
	|	ВЫРАЗИТЬ("""" КАК Строка(1000)) КАК Комментарий,
	|	Д.Контрагент КАК Контрагент,
	|	Д.Аналитика КАК Аналитика,
	|	СУММА(0) КАК ФиксФ1,
	|	СУММА(0) КАК ФиксФ2,
	|	СУММА(0) КАК ФиксИтого
	|ИЗ
	|	втЕРП_Расх_Детали КАК Д
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втPL_ДДС КАК PLДДС
	|		ПО PLДДС.ДДС = Д.ДДС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втКолонкиPL КАК КЛ
	|		ПО (КЛ.КолонкаСорт > 0 И КЛ.КолонкаСорт < 890000 И Д.МесяцКлюч = КЛ.КолонкаСорт)
	|			ИЛИ КЛ.КолонкаСорт = 900000
	|			ИЛИ (КЛ.КолонкаСорт = 890000 И Д.МесяцКлюч >= &КлючНачалаГода)
	|СГРУППИРОВАТЬ ПО
	|	Д.ПодразделениеОтчета, Д.ПодразделениеОтчета.А_НаправлениеДеятельности,
	|	PLДДС.СтатьяPL, PLДДС.СтатьяPL.Группа, Д.ДДС,
	|	КЛ.КолонкаСорт, КЛ.КолонкаПредставление, Д.Документ, Д.Контрагент, Д.Аналитика
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Д.Подразделение, Д.Подразделение.А_НаправлениеДеятельности,
	|	ВЫРАЗИТЬ("""" КАК Строка(150)),
	|	Д.Группа, Д.СтатьяPL, Д.ДДС,
	|	КЛ.КолонкаСорт, КЛ.КолонкаПредставление,
	|	// Доход через приходный кассовый ордер — Форма 2, всё остальное — Форма 1.
	|	СУММА(ВЫБОР КОГДА Д.Наличные = 1 ТОГДА 0 ИНАЧЕ Д.СуммаЕРП КОНЕЦ),
	|	СУММА(ВЫБОР КОГДА Д.Наличные = 1 ТОГДА Д.СуммаЕРП ИНАЧЕ 0 КОНЕЦ),
	|	СУММА(Д.СуммаЕРП),
	|	Д.Документ, ВЫРАЗИТЬ("""" КАК Строка(1000)), Д.Контрагент, Д.Аналитика,
	|	СУММА(0), СУММА(0), СУММА(0)
	|ИЗ
	|	втЕРП_ДохCoGS_PL КАК Д
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втКолонкиPL КАК КЛ
	|		ПО (КЛ.КолонкаСорт > 0 И КЛ.КолонкаСорт < 890000 И Д.МесяцКлюч = КЛ.КолонкаСорт)
	|			ИЛИ КЛ.КолонкаСорт = 900000
	|			ИЛИ (КЛ.КолонкаСорт = 890000 И Д.МесяцКлюч >= &КлючНачалаГода)
	|СГРУППИРОВАТЬ ПО
	|	Д.Подразделение, Д.Подразделение.А_НаправлениеДеятельности,
	|	Д.Группа, Д.СтатьяPL, Д.ДДС,
	|	КЛ.КолонкаСорт, КЛ.КолонкаПредставление, Д.Документ, Д.Контрагент, Д.Аналитика
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Док.Подразделение, Док.Подразделение.А_НаправлениеДеятельности,
	|	ВЫРАЗИТЬ(Док.ПодразделениеСтрока КАК Строка(150)),
	|	Стр.Статья.Группа, Стр.Статья,
	|	ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка),
	|	ГОД(Док.Дата) * 100 + МЕСЯЦ(Док.Дата),
	|	КЛ.КолонкаПредставление,
	|	СУММА(Стр.СуммаФома1), СУММА(Стр.СуммаФорма2), СУММА(Стр.Сумма),
	|	Стр.Ссылка, МАКСИМУМ(ВЫРАЗИТЬ(Стр.Комментарий КАК Строка(1000))),
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка), НЕОПРЕДЕЛЕНО,
	|	СУММА(0), СУММА(0), СУММА(0)
	|ИЗ
	|	Документ.А_ОтчетPL.ДанныеОтчета КАК Стр
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.А_ОтчетPL КАК Док
	|		ПО Стр.Ссылка = Док.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втКолонкиPL КАК КЛ
	|		ПО КЛ.КолонкаСорт = ГОД(Док.Дата) * 100 + МЕСЯЦ(Док.Дата) И КЛ.КолонкаСорт > 0 И КЛ.КолонкаСорт < 890000
	|ГДЕ
	|	Док.Проведен И Док.ВключатьДочерние = &СводыНаправлений
	|	И Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Стр.Статья <> ЗНАЧЕНИЕ(Справочник.А_Статьи_PL.ПустаяСсылка)
	|	И ГОД(Док.Дата) * 100 + МЕСЯЦ(Док.Дата) <> &ПоследнийМесяц
	|СГРУППИРОВАТЬ ПО
	|	Док.Подразделение, Док.Подразделение.А_НаправлениеДеятельности,
	|	ВЫРАЗИТЬ(Док.ПодразделениеСтрока КАК Строка(150)),
	|	Стр.Статья, Стр.Статья.Группа, ГОД(Док.Дата) * 100 + МЕСЯЦ(Док.Дата),
	|	КЛ.КолонкаПредставление, Стр.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Док.Подразделение, Док.Подразделение.А_НаправлениеДеятельности,
	|	ВЫРАЗИТЬ(Док.ПодразделениеСтрока КАК Строка(150)),
	|	Стр.Статья.Группа, Стр.Статья,
	|	ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка),
	|	КЛ.КолонкаСорт, КЛ.КолонкаПредставление,
	|	СУММА(Стр.СуммаФома1), СУММА(Стр.СуммаФорма2), СУММА(Стр.Сумма),
	|	Стр.Ссылка, МАКСИМУМ(ВЫРАЗИТЬ(Стр.Комментарий КАК Строка(1000))),
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка), НЕОПРЕДЕЛЕНО,
	|	СУММА(0), СУММА(0), СУММА(0)
	|ИЗ
	|	Документ.А_ОтчетPL.ДанныеОтчета КАК Стр
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.А_ОтчетPL КАК Док
	|		ПО Стр.Ссылка = Док.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втКолонкиPL КАК КЛ
	|		ПО КЛ.КолонкаСорт = 900000
	|			ИЛИ (КЛ.КолонкаСорт = 890000 И ГОД(Док.Дата) * 100 + МЕСЯЦ(Док.Дата) >= &КлючНачалаГода)
	|ГДЕ
	|	Док.Проведен И Док.ВключатьДочерние = &СводыНаправлений
	|	И Стр.Статья <> ЗНАЧЕНИЕ(Справочник.А_Статьи_PL.ПустаяСсылка)
	|	И ГОД(Док.Дата) * 100 + МЕСЯЦ(Док.Дата) < &ПоследнийМесяц
	|СГРУППИРОВАТЬ ПО
	|	Док.Подразделение, Док.Подразделение.А_НаправлениеДеятельности,
	|	ВЫРАЗИТЬ(Док.ПодразделениеСтрока КАК Строка(150)),
	|	Стр.Статья, Стр.Статья.Группа, Стр.Ссылка,
	|	КЛ.КолонкаСорт, КЛ.КолонкаПредставление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КУ.ПодразделениеОтчета, КУ.ПодразделениеОтчета.А_НаправлениеДеятельности,
	|	ВЫРАЗИТЬ("""" КАК Строка(150)),
	|	М.СтатьяPL.Группа, М.СтатьяPL, Б.СтатьяДвиженияДенежныхСредств,
	|	КЛ.КолонкаСорт, КЛ.КолонкаПредставление,
	|	СУММА(ВЫБОР КОГДА Б.ВидОплаты = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Наличные)
	|			ТОГДА 0 ИНАЧЕ Б.Сумма КОНЕЦ),
	|	СУММА(ВЫБОР КОГДА Б.ВидОплаты = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Наличные)
	|			ТОГДА Б.Сумма ИНАЧЕ 0 КОНЕЦ),
	|	СУММА(Б.Сумма),
	|	Б.Регистратор, ВЫРАЗИТЬ("""" КАК Строка(1000)),
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка), НЕОПРЕДЕЛЕНО,
	|	СУММА(0), СУММА(0), СУММА(0)
	|ИЗ
	|	РегистрНакопления.А_БюджетыНаМесяц КАК Б
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втКартаУровней КАК КУ
	|		ПО КУ.Подразделение = Б.Подразделение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втКолонкиPL КАК КЛ
	|		ПО КЛ.КолонкаСорт = 900100
	|		ЛЕВОЕ СОЕДИНЕНИЕ втPL_ДДС КАК М
	|		ПО М.ДДС = Б.СтатьяДвиженияДенежныхСредств
	|ГДЕ
	|	Б.ВидПериода = ЗНАЧЕНИЕ(Перечисление.А_ВидыПериодовБюджетирования.Объект)
	|СГРУППИРОВАТЬ ПО
	|	КУ.ПодразделениеОтчета, КУ.ПодразделениеОтчета.А_НаправлениеДеятельности,
	|	М.СтатьяPL, М.СтатьяPL.Группа, Б.СтатьяДвиженияДенежныхСредств,
	|	КЛ.КолонкаСорт, КЛ.КолонкаПредставление, Б.Регистратор
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// ФИКСЫ: норма попадает в КАЖДУЮ месячную колонку. В накопительном и в плане
	|// фикса нет — накопительный идёт за всю историю, а норма действует с 2026 года,
	|// сравнивать не с чем, и пустая ячейка честнее выдуманной.
	|ВЫБРАТЬ
	|	ФН.ПодразделениеОтчета, ФН.ПодразделениеОтчета.А_НаправлениеДеятельности,
	|	ВЫРАЗИТЬ("""" КАК Строка(150)),
	|	ФН.Группа, ФН.СтатьяPL, ФН.ДДС,
	|	ФН.КолонкаСорт, КЛ.КолонкаПредставление,
	|	СУММА(0), СУММА(0), СУММА(0),
	|	ФН.Документ, ВЫРАЗИТЬ("""" КАК Строка(1000)),
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка), НЕОПРЕДЕЛЕНО,
	|	СУММА(ФН.ФиксФ1), СУММА(ФН.ФиксФ2), СУММА(ФН.ФиксИтого)
	|ИЗ
	|	втФиксНорма КАК ФН
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втКолонкиPL КАК КЛ
	|		ПО КЛ.КолонкаСорт = ФН.КолонкаСорт
	|СГРУППИРОВАТЬ ПО
	|	ФН.ПодразделениеОтчета, ФН.ПодразделениеОтчета.А_НаправлениеДеятельности,
	|	ФН.Группа, ФН.СтатьяPL, ФН.ДДС, ФН.КолонкаСорт, КЛ.КолонкаПредставление,
	|	ФН.Документ";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("СводыНаправлений", СводыНаправлений);
	Запрос.УстановитьПараметр("КолонкиPL", ТаблицаКолонок(НачалоПериода, КонецПериода,
		Блоки.Месяцы, Блоки.Накопительный, Блоки.План, Блоки.СНачалаГода));
	// Фиксы выключаются здесь же: ветка нормы просто не строится.
	Запрос.УстановитьПараметр("ВыводитьФиксы", Блоки.Фиксы);
	Запрос.УстановитьПараметр("ДДСCoGS", ПолучитьДДСПриёмникCoGS());
	Запрос.УстановитьПараметр("СтатьяДоходовТовар", ПолучитьСтатьюДоходовТовара());
	// Последний МЕСЯЦ периода отчёта — ЕДИНСТВЕННЫЙ, факт которого берётся из регистров
	// ЕРП. Все более ранние месяцы идут ТОЛЬКО из документов А_ОтчетPL: месяц без
	// документа даёт ноль, исключений (в том числе для амортизации) больше нет.
	Запрос.УстановитьПараметр("ПоследнийМесяц", Год(КонецПериода) * 100 + Месяц(КонецПериода));
	// «PL с начала года»: месяцы >= января года, в котором лежит КОНЕЦ периода.
	Запрос.УстановитьПараметр("КлючНачалаГода", Год(КонецПериода) * 100 + 1);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции


// Разметка листа PL: строки уровня 1 и 2, полный шаблон, водопад прибыли, контрольные строки.
//
// ОТЛИЧИЕ ОТ ВЕРСИИ 1: всё считается по ПАРЕ (Подразделение × КолонкаСорт), потому что
// в Excel каждый блок колонок несёт собственный водопад и собственный «% затрат».
//
// Строки ПоказательПроцент хранят ЧИСЛИТЕЛЬ в суммах и ЗНАМЕНАТЕЛЬ в поле Знаменатель:
// итог считается как Сумма(числитель)/Сумма(знаменателя) и потому верен на любом уровне
// свёртки. Хранить долю нельзя — сумма долей не имеет смысла.
//
Процедура ДополнитьВидКакВExcel(ТаблицаДанных, ПоказИтогиПрибыли, ПолныйШаблон = Истина,
	ПоказатьСлужебныеСтроки = Истина, НазванияНаРусском = Ложь)

	ТаблицаДанных.Колонки.Добавить("ВидСтроки",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30)));
	ТаблицаДанных.Колонки.Добавить("СтрокаЛиста",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	ТаблицаДанных.Колонки.Добавить("СортЛиста",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0)));
	ТаблицаДанных.Колонки.Добавить("ПоказыватьСтатью", Новый ОписаниеТипов("Булево"));
	ТаблицаДанных.Колонки.Добавить("БазаПроцента",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(17, 2)));
	ТаблицаДанных.Колонки.Добавить("СуммаСтатья",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(17, 2)));
	ТаблицаДанных.Колонки.Добавить("Знаменатель",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(17, 2)));

	Для Каждого Стр Из ТаблицаДанных Цикл
		Стр.ВидСтроки = "Статья";
		Стр.ПоказыватьСтатью = Истина;
		Стр.СуммаСтатья = ?(Стр.СуммаИтого = NULL, 0, Стр.СуммаИтого);
	КонецЦикла;

	Если НЕ ПоказИтогиПрибыли Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Ссылка, Код, Наименование, НаименованиеДляОтчетаНаРусском
	|ИЗ Справочник.А_ГруппаСтатей_PL ГДЕ НЕ ПометкаУдаления
	|;
	|ВЫБРАТЬ
	|	Ст.Ссылка КАК Ссылка,
	|	Ст.Код КАК Код,
	|	Ст.Наименование КАК Наименование,
	|	Ст.Группа КАК Группа,
	|	Ст.Сорт КАК Сорт
	|ИЗ Справочник.А_Статьи_PL КАК Ст
	|ГДЕ НЕ Ст.ПометкаУдаления
	|	И Ст.Код <> &КодДивидендов";
	// Дивиденды исключены из отчёта (21.08.2026): полный шаблон не должен дорисовать
	// нулевую строку статьи, которую УдалитьСтрокиДивидендов уже вычистил из данных.
	Запрос.УстановитьПараметр("КодДивидендов", КодыОсобыхСтатей().Дивиденды);
	Пакет = Запрос.ВыполнитьПакет();
	ТЗГрупп  = Пакет[0].Выгрузить();
	ТЗСтатей = Пакет[1].Выгрузить();

	// Порядок строк листа (форма PL, 21.08.2026):
	//   10 ОД · 20 СС · 30 ДР · 40/50 Маржа грн/% · 60 ОПЗ · 70 МЗ · 80 АЗ
	//   100/110 EBITDA грн/% · 115 Амортизация · 120/125 EBIT грн/%
	//   130 Финансовая деятельность · 140 Налоги и сборы · 150 Чистый доход
	//   190 Чистый доход, % (строки «Дивиденды» и «Прибыль в распоряжении» убраны)
	ПозицииГрупп = Новый Соответствие;
	ПозицииГрупп.Вставить("000000006", 10);
	ПозицииГрупп.Вставить("000000001", 20);
	ПозицииГрупп.Вставить("000000007", 30);
	ПозицииГрупп.Вставить("000000003", 60);
	ПозицииГрупп.Вставить("000000005", 70);
	ПозицииГрупп.Вставить("000000002", 80);
	ПозицииГрупп.Вставить("000000008", 140);
	ПозицииГрупп.Вставить("000000004", 130);

	РазметкаГрупп = Новый Соответствие;
	Для Каждого СтрГр Из ТЗГрупп Цикл
		Позиция = ПозицииГрупп.Получить(СтрГр.Код);
		Если Позиция <> Неопределено Тогда
			// Имя строки листа: при «Названия на русском» — реквизит с фолбэком.
			ИмяСтроки = СтрГр.Наименование;
			Если НазванияНаРусском И ЗначениеЗаполнено(СтрГр.НаименованиеДляОтчетаНаРусском) Тогда
				ИмяСтроки = СтрГр.НаименованиеДляОтчетаНаРусском;
			КонецЕсли;
			РазметкаГрупп.Вставить(СтрГр.Ссылка,
				Новый Структура("Код, Имя, Сорт", СтрГр.Код, ИмяСтроки, Позиция));
		КонецЕсли;
	КонецЦикла;
	КодыСтатей = Новый Соответствие;
	Для Каждого СтрСт Из ТЗСтатей Цикл
		КодыСтатей.Вставить(СтрСт.Ссылка, СтрСт.Код);
	КонецЦикла;

	// Аккумуляция по ПАРЕ (Подразделение, КолонкаСорт).
	// Ключ соответствия — строка, потому что пара ссылка+число ключом быть не может.
	Итоги = Новый Соответствие;
	ИменаКлючей = СтрРазделить(
		"ОД,СС,ДР,ОПЗ,Аморт,МЗ,АЗ,НС,ФинДоход,ФинРасхКом,ФинРасхПроц,КурсРазн,"
		+ "НалогНаПрибыль", ",");
	Коды = КодыОсобыхСтатей();

	Для Каждого Стр Из ТаблицаДанных Цикл

		Ключ = Строка(Стр.Подразделение.УникальныйИдентификатор()) + "|" + Формат(Стр.КолонкаСорт, "ЧГ=");
		Данные = Итоги.Получить(Ключ);
		Если Данные = Неопределено Тогда
			Данные = Новый Структура;
			Данные.Вставить("Подразделение", Стр.Подразделение);
			Данные.Вставить("Направление", Стр.НаправлениеДеятельности);
			Данные.Вставить("КолонкаСорт", Стр.КолонкаСорт);
			Данные.Вставить("КолонкаPL", Стр.КолонкаPL);
			Данные.Вставить("ПланВсего", 0);
			Данные.Вставить("ПланБезСтатьи", 0);
			Данные.Вставить("ЕстьДокумент", Ложь);
			Для Каждого ИмяКлюча Из ИменаКлючей Цикл
				Данные.Вставить(ИмяКлюча, Новый Структура("Ф1, Ф2, Ит", 0, 0, 0));
			КонецЦикла;
			Итоги.Вставить(Ключ, Данные);
		КонецЕсли;

		Если Стр.КолонкаСорт = 900100 Тогда
			Данные.ПланВсего = Данные.ПланВсего + Стр.СуммаИтого;
			Если НЕ ЗначениеЗаполнено(Стр.СтатьяPL) Тогда
				Данные.ПланБезСтатьи = Данные.ПланБезСтатьи + Стр.СуммаИтого;
			КонецЕсли;
		КонецЕсли;
		Если ТипЗнч(Стр.Документ) = Тип("ДокументСсылка.А_ОтчетPL") Тогда
			Данные.ЕстьДокумент = Истина;
		КонецЕсли;

		Если Стр.СуммаИтого = 0 И Стр.СуммаФ1 = 0 И Стр.СуммаФ2 = 0 Тогда
			Продолжить;
		КонецЕсли;

		КодСтатьи = КодыСтатей.Получить(Стр.СтатьяPL);
		Разметка  = РазметкаГрупп.Получить(Стр.Группа);
		// Особые статьи разбираются ПО КОДУ и раньше группы: так «Амортизация» уходит
		// из ОПЗ, а «Налог на прибыль» — из финансовой деятельности.
		Тройка = Неопределено;
		Если КодСтатьи = Коды.ФинДоход Тогда
			Тройка = Данные.ФинДоход;
		ИначеЕсли КодСтатьи = Коды.ФинРасхКомиссии Тогда
			Тройка = Данные.ФинРасхКом;
		ИначеЕсли КодСтатьи = Коды.ФинРасхПроценты Тогда
			Тройка = Данные.ФинРасхПроц;
		ИначеЕсли КодСтатьи = Коды.КурсовыеРазницы Тогда
			Тройка = Данные.КурсРазн;
		ИначеЕсли КодСтатьи = Коды.Амортизация Тогда
			Тройка = Данные.Аморт;
		ИначеЕсли КодСтатьи = Коды.НалогНаПрибыль Тогда
			Тройка = Данные.НалогНаПрибыль;
		ИначеЕсли Разметка <> Неопределено Тогда
			Если Разметка.Код = "000000006" Тогда
				Тройка = Данные.ОД;
			ИначеЕсли Разметка.Код = "000000001" Тогда
				Тройка = Данные.СС;
			ИначеЕсли Разметка.Код = "000000007" Тогда
				Тройка = Данные.ДР;
			ИначеЕсли Разметка.Код = "000000003" Тогда
				Тройка = Данные.ОПЗ;
			ИначеЕсли Разметка.Код = "000000005" Тогда
				Тройка = Данные.МЗ;
			ИначеЕсли Разметка.Код = "000000002" Тогда
				Тройка = Данные.АЗ;
			ИначеЕсли Разметка.Код = "000000008" Тогда
				Тройка = Данные.НС;
			КонецЕсли;
		КонецЕсли;
		Если Тройка <> Неопределено Тогда
			Тройка.Ф1 = Тройка.Ф1 + Стр.СуммаФ1;
			Тройка.Ф2 = Тройка.Ф2 + Стр.СуммаФ2;
			Тройка.Ит = Тройка.Ит + Стр.СуммаИтого;
		КонецЕсли;
	КонецЦикла;

	// Полный шаблон: нулевые строки статей без данных — на каждую пару (подразделение, колонка).
	Если ПолныйШаблон Тогда
		ЕстьСтатья = Новый Соответствие;
		Для Каждого Стр Из ТаблицаДанных Цикл
			Если НЕ ЗначениеЗаполнено(Стр.СтатьяPL) Тогда
				Продолжить;
			КонецЕсли;
			Ключ = Строка(Стр.Подразделение.УникальныйИдентификатор()) + "|" + Формат(Стр.КолонкаСорт, "ЧГ=");
			НаборСтатей = ЕстьСтатья.Получить(Ключ);
			Если НаборСтатей = Неопределено Тогда
				НаборСтатей = Новый Соответствие;
				ЕстьСтатья.Вставить(Ключ, НаборСтатей);
			КонецЕсли;
			НаборСтатей.Вставить(Стр.СтатьяPL, Истина);
		КонецЦикла;
		Для Каждого КлючЗначение Из Итоги Цикл
			Данные = КлючЗначение.Значение;
			НаборСтатей = ЕстьСтатья.Получить(КлючЗначение.Ключ);
			Для Каждого СтрСт Из ТЗСтатей Цикл
				Если НаборСтатей <> Неопределено И НаборСтатей.Получить(СтрСт.Ссылка) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				НоваяСтр = ТаблицаДанных.Добавить();
				НоваяСтр.Подразделение = Данные.Подразделение;
				НоваяСтр.НаправлениеДеятельности = Данные.Направление;
				НоваяСтр.КолонкаСорт = Данные.КолонкаСорт;
				НоваяСтр.КолонкаPL = Данные.КолонкаPL;
				НоваяСтр.ПодразделениеСтрока = "";
				НоваяСтр.Комментарий = "";
				НоваяСтр.Группа = СтрСт.Группа;
				НоваяСтр.СтатьяPL = СтрСт.Ссылка;
				НоваяСтр.ВидСтроки = "Статья";
				НоваяСтр.ПоказыватьСтатью = Истина;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	// Разметка строк листа и база «% затрат» — база своя у каждой пары (подразделение, колонка).
	Для Каждого Стр Из ТаблицаДанных Цикл
		КодСтатьи = КодыСтатей.Получить(Стр.СтатьяPL);
		Разметка  = РазметкаГрупп.Получить(Стр.Группа);
		Если КодСтатьи = Коды.Амортизация Тогда
			// Амортизация покидает ОПЗ: свой блок между EBITDA и EBIT.
			Стр.СтрокаЛиста = "Амортизация";
			Стр.СортЛиста = 115;
		ИначеЕсли КодСтатьи = Коды.НалогНаПрибыль Тогда
			// Налог на прибыль покидает финансовую деятельность: он налог.
			Стр.СтрокаЛиста = "Налоги и сборы";
			Стр.СортЛиста = 140;
		ИначеЕсли Разметка <> Неопределено Тогда
			Стр.СтрокаЛиста = Разметка.Имя;
			Стр.СортЛиста = Разметка.Сорт;
		ИначеЕсли Стр.КолонкаСорт = 900100 Тогда
			Стр.СтрокаЛиста = "План без статьи PL (ДДС не привязана)";
			Стр.СортЛиста = 910;
			Стр.ВидСтроки = "ПланБезСтатьиPL";
			Стр.ПоказыватьСтатью = Ложь;
		Иначе
			Стр.СтрокаЛиста = "Вне структуры PL";
			Стр.СортЛиста = 900;
			Стр.ПоказыватьСтатью = Ложь;
		КонецЕсли;

		Ключ = Строка(Стр.Подразделение.УникальныйИдентификатор()) + "|" + Формат(Стр.КолонкаСорт, "ЧГ=");
		Данные = Итоги.Получить(Ключ);
		Если Данные <> Неопределено И (Разметка = Неопределено ИЛИ Разметка.Код <> "000000006") Тогда
			// «Итого затрат»: амортизация и три вида финрасходов; Дивиденды исключены
			// из отчёта (21.08.2026) — значит и из базы процента, иначе % не сверить по листу.
			Стр.БазаПроцента = Данные.СС.Ит + Данные.ДР.Ит + Данные.ОПЗ.Ит + Данные.Аморт.Ит
				+ Данные.МЗ.Ит + Данные.АЗ.Ит + Данные.НС.Ит
				+ Данные.ФинРасхКом.Ит + Данные.ФинРасхПроц.Ит + Данные.КурсРазн.Ит
				+ Данные.НалогНаПрибыль.Ит;
		КонецЕсли;
	КонецЦикла;

	// Водопад прибыли — свой в каждой колонке каждого подразделения.
	Для Каждого КлючЗначение Из Итоги Цикл
		Данные = КлючЗначение.Значение;
		В1 = РассчитатьВодопадКолонки(Данные, "Ф1");
		В2 = РассчитатьВодопадКолонки(Данные, "Ф2");
		ВИ = РассчитатьВодопадКолонки(Данные, "Ит");

		ДобавитьСтрокуПоказателя(ТаблицаДанных, Данные, 40,
			"Маржинальный доход, грн", "Показатель", В1.Марж, В2.Марж, ВИ.Марж, 0);
		ДобавитьСтрокуПоказателя(ТаблицаДанных, Данные, 50,
			"Маржинальный доход, %", "ПоказательПроцент",
			В1.Марж, В2.Марж, ВИ.Марж, ВИ.ОД);
		ДобавитьСтрокуПоказателя(ТаблицаДанных, Данные, 100,
			"EBITDA, грн", "Показатель", В1.EBITDA, В2.EBITDA, ВИ.EBITDA, 0);
		ДобавитьСтрокуПоказателя(ТаблицаДанных, Данные, 110,
			"EBITDA, %", "ПоказательПроцент",
			В1.EBITDA, В2.EBITDA, ВИ.EBITDA, ВИ.ОД);
		// «Названия на русском» меняет тексты EBIT-строк и процентной строки итога.
		Если НазванияНаРусском Тогда
			ИмяEBITГрн = "EBIT / Операционный доход, грн";
			ИмяEBITПроц = "EBIT / Операционный доход, %";
			ИмяЧистогоПроц = "Чистый доход, %";
		Иначе
			ИмяEBITГрн = "EBIT / Операционная прибыль, грн";
			ИмяEBITПроц = "EBIT / Операционная прибыль, %";
			ИмяЧистогоПроц = "Рентабельность продукции, %";
		КонецЕсли;
		ДобавитьСтрокуПоказателя(ТаблицаДанных, Данные, 120,
			ИмяEBITГрн, "Показатель",
			В1.EBIT, В2.EBIT, ВИ.EBIT, 0);
		ДобавитьСтрокуПоказателя(ТаблицаДанных, Данные, 125,
			ИмяEBITПроц, "ПоказательПроцент",
			В1.EBIT, В2.EBIT, ВИ.EBIT, ВИ.ОД);
		// Показатель НЕТТО поверх группы «Финансовая деятельность»: доход минус расходы,
		// как в листе Excel. Без него итог группы сложил бы доход с расходами.
		ДобавитьСтрокуПоказателя(ТаблицаДанных, Данные, 130,
			"Финансовая деятельность", "Показатель",
			В1.ФинДеят, В2.ФинДеят, ВИ.ФинДеят, 0);
		ДобавитьСтрокуПоказателя(ТаблицаДанных, Данные, 150,
			"Чистый доход", "Показатель", В1.Чистый, В2.Чистый, ВИ.Чистый, 0);
		// Строки «Дивиденды» и «Прибыль в распоряжении компании» убраны из отчёта
		// решением финансиста 21.08.2026: водопад заканчивается Чистым доходом,
		// процентная строка считается от него.
		ДобавитьСтрокуПоказателя(ТаблицаДанных, Данные, 190,
			ИмяЧистогоПроц, "ПоказательПроцент",
			В1.Чистый, В2.Чистый, ВИ.Чистый, ВИ.ОД);
	КонецЦикла;

	Если ПоказатьСлужебныеСтроки Тогда
		ДобавитьКонтрольныеСтроки(ТаблицаДанных, Итоги);
	КонецЕсли;

КонецПроцедуры

// Контрольные строки. Числа держим ТЕКСТОМ в СтрокаЛиста, а не в ресурсах: иначе итоги
// СКД посчитали бы план дважды.
Процедура ДобавитьКонтрольныеСтроки(ТаблицаДанных, Итоги)

	Для Каждого КлючЗначение Из Итоги Цикл
		Данные = КлючЗначение.Значение;
		Если Данные.КолонкаСорт <> 900100 ИЛИ Данные.ПланВсего = 0 Тогда
			Продолжить;
		КонецЕсли;

		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"Контроль плана: по статьям %1 + без статьи PL %2 = %3 (регистр А_БюджетыНаМесяц)",
			Формат(Данные.ПланВсего - Данные.ПланБезСтатьи, "ЧДЦ=0"),
			Формат(Данные.ПланБезСтатьи, "ЧДЦ=0"),
			Формат(Данные.ПланВсего, "ЧДЦ=0"));
		ДобавитьСтрокуПоказателя(ТаблицаДанных, Данные, 920, Текст, "Контроль", 0, 0, 0, 0);
	КонецЦикла;

	// Предупреждение: документов PL по подразделению нет вовсе — накопительное только из регистров.
	ЕстьДокПодр = Новый Соответствие;
	Для Каждого КлючЗначение Из Итоги Цикл
		Данные = КлючЗначение.Значение;
		Если Данные.ЕстьДокумент Тогда
			ЕстьДокПодр.Вставить(Данные.Подразделение, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючЗначение Из Итоги Цикл
		Данные = КлючЗначение.Значение;
		Если Данные.КолонкаСорт <> 900000 ИЛИ ЕстьДокПодр.Получить(Данные.Подразделение) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьСтрокуПоказателя(ТаблицаДанных, Данные, 921,
			"Внимание: документов А_ОтчетPL по объекту нет — накопительный факт
				|собран целиком из регистров ЕРП и может быть занижен",
			"Контроль", 0, 0, 0, 0);
	КонецЦикла;

КонецПроцедуры

// Водопад одной колонки Ф1/Ф2/Ит. ОД возвращается отдельно — он нужен знаменателем %-строк.
Функция РассчитатьВодопадКолонки(Данные, К)

	ОД = Данные.ОД[К];

	// Финансовые расходы тремя строками: комиссии (000000056), проценты, курсовые разницы.
	ФинРасх = Данные.ФинРасхКом[К] + Данные.ФинРасхПроц[К] + Данные.КурсРазн[К];
	// Налоги и сборы = НДС/прочие + налог на прибыль (он переехал из финдеятельности).
	Налоги  = Данные.НС[К] + Данные.НалогНаПрибыль[К];

	Марж    = ОД - Данные.СС[К];
	// EBITDA — прибыль ДО износа, процентов и налогов. Амортизация сюда не входит:
	// в накопителе она отделена от ОПЗ по коду статьи.
	EBITDA  = Марж - Данные.ОПЗ[К] - Данные.МЗ[К] - Данные.АЗ[К];
	EBIT    = EBITDA - Данные.Аморт[К];
	// Финансовая деятельность НЕТТО: плюс = заработали на финансах.
	ФинДеят = Данные.ФинДоход[К] - ФинРасх;
	// Дополнительные расходы (инвестиционная деятельность) — не операционные,
	// вычитаются ниже EBIT, как и было в старой форме.
	// Дивиденды исключены из отчёта (21.08.2026): водопад заканчивается Чистым доходом.
	Чистый  = EBIT + ФинДеят - Данные.ДР[К] - Налоги;

	Рез = Новый Структура;
	Рез.Вставить("ОД", ОД);
	Рез.Вставить("Марж", Марж);
	Рез.Вставить("EBITDA", EBITDA);
	Рез.Вставить("EBIT", EBIT);
	Рез.Вставить("ФинДеят", ФинДеят);
	Рез.Вставить("Чистый", Чистый);
	Возврат Рез;

КонецФункции

// Строка-показатель: СтатьяPL/Группа/Документ пустые (в расшифровку не попадает).
// У %-строк в суммах лежит ЧИСЛИТЕЛЬ, в Знаменателе — операционный доход этой же колонки.
Процедура ДобавитьСтрокуПоказателя(ТаблицаДанных, Данные, Порядок, Название, Вид, Ф1, Ф2, Ит, Знам)

	Стр = ТаблицаДанных.Добавить();
	Стр.Подразделение = Данные.Подразделение;
	Стр.НаправлениеДеятельности = Данные.Направление;
	Стр.КолонкаСорт = Данные.КолонкаСорт;
	Стр.КолонкаPL = Данные.КолонкаPL;
	Стр.ПодразделениеСтрока = "";
	Стр.Комментарий = "";
	Стр.СуммаФ1 = Ф1;
	Стр.СуммаФ2 = Ф2;
	Стр.СуммаИтого = Ит;
	Стр.СуммаСтатья = Ит;
	Стр.Знаменатель = Знам;
	Стр.ВидСтроки = Вид;
	Стр.СтрокаЛиста = Название;
	Стр.СортЛиста = Порядок;
	Стр.ПоказыватьСтатью = Ложь;

КонецПроцедуры

// Раскрытие источников факта в шапке подразделения.
// Без этих дат заниженный накопительный факт читается как перерасход бюджета.
Процедура ЗаполнитьРаскрытиеИсточников(ТаблицаДанных, СводыНаправлений, КонецПериода)

	ТаблицаДанных.Колонки.Добавить("НакопительноС", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("ДокументыПо", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("ЕРПС", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("ПланАктуаленНа", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("ИсточникиФакта",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Д.Подразделение КАК Подразделение,
	|	МИНИМУМ(НАЧАЛОПЕРИОДА(Д.Дата, МЕСЯЦ)) КАК НакопительноС,
	|	МАКСИМУМ(НАЧАЛОПЕРИОДА(Д.Дата, МЕСЯЦ)) КАК ДокументыПо
	|ИЗ
	|	Документ.А_ОтчетPL КАК Д
	|ГДЕ
	|	Д.Проведен
	|	И Д.ВключатьДочерние = &СводыНаправлений
	|СГРУППИРОВАТЬ ПО
	|	Д.Подразделение
	|;
	|
	|ВЫБРАТЬ
	|	Б.Подразделение КАК Подразделение,
	|	МАКСИМУМ(Б.Дата) КАК ПланАктуаленНа
	|ИЗ
	|	Документ.А_БюджетМесяц КАК Б
	|ГДЕ
	|	Б.Проведен
	|	И Б.ВидПериода = ЗНАЧЕНИЕ(Перечисление.А_ВидыПериодовБюджетирования.Объект)
	|СГРУППИРОВАТЬ ПО
	|	Б.Подразделение";
	Запрос.УстановитьПараметр("СводыНаправлений", СводыНаправлений);
	Пакет = Запрос.ВыполнитьПакет();

	ПоДокументам = Новый Соответствие;
	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		ПоДокументам.Вставить(Выборка.Подразделение,
			Новый Структура("НакопительноС, ДокументыПо", Выборка.НакопительноС, Выборка.ДокументыПо));
	КонецЦикла;
	ПоПлану = Новый Соответствие;
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		ПоПлану.Вставить(Выборка.Подразделение, Выборка.ПланАктуаленНа);
	КонецЦикла;

	Тексты = Новый Соответствие;
	Для Каждого Стр Из ТаблицаДанных Цикл
		Док = ПоДокументам.Получить(Стр.Подразделение);
		План = ПоПлану.Получить(Стр.Подразделение);
		// Границу задаёт ПЕРИОД ОТЧЁТА, а не последний заведённый документ:
		// последний месяц периода всегда регистровый, всё до него — документное.
		ЕРПМесяц = НачалоМесяца(КонецПериода);
		Если Док <> Неопределено Тогда
			Стр.НакопительноС = Док.НакопительноС;
			Стр.ДокументыПо = КонецМесяца(ДобавитьМесяц(ЕРПМесяц, -1));
			Стр.ЕРПС = ЕРПМесяц;
		КонецЕсли;
		Стр.ПланАктуаленНа = ?(План = Неопределено, Дата(1, 1, 1), НачалоДня(План));

		Текст = Тексты.Получить(Стр.Подразделение);
		Если Текст = Неопределено Тогда
			Если Док <> Неопределено Тогда
				Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					"Накопительно с %1; документы PL по %2; ЕРП за %3; план актуален на %4",
					ПредставлениеДаты(Стр.НакопительноС), ПредставлениеДаты(Стр.ДокументыПо),
					ПредставлениеДаты(Стр.ЕРПС), ПредставлениеДаты(Стр.ПланАктуаленНа));
			Иначе
				Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					"Документов PL нет — накопительно целиком из регистров ЕРП; план актуален на %1",
					ПредставлениеДаты(Стр.ПланАктуаленНа));
			КонецЕсли;
			Тексты.Вставить(Стр.Подразделение, Текст);
		КонецЕсли;
		Стр.ИсточникиФакта = Текст;
	КонецЦикла;

КонецПроцедуры

// Представление даты для шапки: пустая дата — прочерк.
Функция ПредставлениеДаты(Знач ДатаЗначение)

	Если НЕ ЗначениеЗаполнено(ДатаЗначение) Тогда
		Возврат "—";
	КонецЕсли;
	Возврат Формат(ДатаЗначение, "ДФ=dd.MM.yyyy");

КонецФункции

#КонецОбласти

#КонецЕсли
