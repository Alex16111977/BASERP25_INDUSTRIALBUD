		<query>ВЫБРАТЬ
	СС.Ссылка КАК СС,
	СС.Подразделение КАК Подр,
	СС.СкладПроизводство КАК СкладВир,
	СС.СкладМонтаж КАК СкладМонт
ПОМЕСТИТЬ ВТ_СС
ИЗ
	Справочник.А_СтруктураСебестоимости КАК СС
ГДЕ
	СС.Ссылка = &amp;СтруктураСебестоимости
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_СС.Подр КАК Подразделение,
	"1. Праця" КАК Блок,
	ВЫБОР КОГДА Р.НаВыезде ТОГДА "Монтаж" ИНАЧЕ "Виробництво" КОНЕЦ КАК Категория,
	Р.Этап КАК Этап,
	Р.Работа КАК Аналитика,
	Р.Количество КАК ПланЧасы,
	0 КАК ФактЧасы,
	Р.Сумма КАК ПланГрн,
	0 КАК ФактГрн
ПОМЕСТИТЬ ВТ_Детали
ИЗ
	Справочник.А_СтруктураСебестоимости.Работы КАК Р
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
		ПО Р.Ссылка = ВТ_СС.СС

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТ_СС.Подр,
	"2. Матеріали",
	ВЫБОР КОГДА К.Этап.Наименование ПОДОБНО "%Монтаж%" ТОГДА "Монтаж" ИНАЧЕ "Виробництво" КОНЕЦ,
	К.Этап,
	К.Номенклатура,
	0,
	0,
	К.Сумма,
	0
ИЗ
	Справочник.А_СтруктураСебестоимости.Комплектующие КАК К
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
		ПО К.Ссылка = ВТ_СС.СС

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Т.Подразделение,
	"1. Праця",
	"Виробництво",
	НЕОПРЕДЕЛЕНО,
	Т.Сотрудник.СотрудникЕРП.ФизическоеЛицо,
	0,
	Т.ЧасыФакт,
	0,
	0
ИЗ
	РегистрНакопления.А_ДанныеТабелирования КАК Т
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
		ПО Т.Подразделение = ВТ_СС.Подр
ГДЕ
	(Т.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
			ИЛИ &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВЗ.Подразделение,
	"1. Праця",
	"Виробництво",
	НЕОПРЕДЕЛЕНО,
	ВЗ.ФизическоеЛицо,
	0,
	0,
	0,
	ВЗ.СуммаВзаиморасчетов
ИЗ
	РегистрНакопления.А_ВзаиморасчетыССотрудниками КАК ВЗ
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
		ПО ВЗ.Подразделение = ВТ_СС.Подр
ГДЕ
	ВЗ.Регистратор ССЫЛКА Документ.ОтражениеЗарплатыВФинансовомУчете
	И ВЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	И (ВЗ.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
			ИЛИ &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТ_СС.Подр,
	"2. Матеріали",
	ВЫБОР КОГДА ВЫРАЗИТЬ(СТ.Регистратор КАК Документ.СборкаТоваров).Склад = ВТ_СС.СкладМонт ТОГДА "Монтаж" ИНАЧЕ "Виробництво" КОНЕЦ,
	НЕОПРЕДЕЛЕНО,
	СТ.АналитикаУчетаНоменклатуры.Номенклатура,
	0,
	0,
	0,
	СТ.СтоимостьУпр
ИЗ
	РегистрНакопления.СебестоимостьТоваров КАК СТ
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
		ПО ВЫРАЗИТЬ(СТ.Регистратор КАК Документ.СборкаТоваров).А_СтруктураСебестоимости = ВТ_СС.СС
ГДЕ
	СТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	И СТ.Регистратор ССЫЛКА Документ.СборкаТоваров
	И (СТ.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
			ИЛИ &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Детали.Подразделение КАК Подразделение,
	ВТ_Детали.Блок КАК Блок,
	ВТ_Детали.Категория КАК Категория,
	ВТ_Детали.Этап КАК Этап,
	ВТ_Детали.Аналитика КАК Аналитика,
	СУММА(ВТ_Детали.ПланЧасы) КАК ПланЧасы,
	СУММА(ВТ_Детали.ФактЧасы) КАК ФактЧасы,
	СУММА(ВТ_Детали.ПланГрн) КАК ПланГрн,
	СУММА(ВТ_Детали.ФактГрн) КАК ФактГрн,
	СУММА(ВТ_Детали.ФактЧасы) - СУММА(ВТ_Детали.ПланЧасы) КАК ОтклонениеЧасы,
	СУММА(ВТ_Детали.ФактГрн) - СУММА(ВТ_Детали.ПланГрн) КАК ОтклонениеГрн,
	ВЫБОР
		КОГДА СУММА(ВТ_Детали.ПланЧасы) = 0 ТОГДА NULL
		ИНАЧЕ СУММА(ВТ_Детали.ФактЧасы) / СУММА(ВТ_Детали.ПланЧасы) * 100
	КОНЕЦ КАК ПроцентЧасы,
	ВЫБОР
		КОГДА СУММА(ВТ_Детали.ПланГрн) = 0 ТОГДА NULL
		ИНАЧЕ СУММА(ВТ_Детали.ФактГрн) / СУММА(ВТ_Детали.ПланГрн) * 100
	КОНЕЦ КАК ПроцентГрн
ИЗ
	ВТ_Детали КАК ВТ_Детали
СГРУППИРОВАТЬ ПО
	ВТ_Детали.Подразделение,
	ВТ_Детали.Блок,
	ВТ_Детали.Категория,
	ВТ_Детали.Этап,
	ВТ_Детали.Аналитика

УПОРЯДОЧИТЬ ПО
	Блок,
	Категория,
	Этап</query>
	</dataSet>
	<totalField>
		<dataPath>ПланЧасы</dataPath>
		<expression>Сумма(ПланЧасы)</expression>
	</totalField>
	<totalField>
		<dataPath>ФактЧасы</dataPath>
		<expression>Сумма(ФактЧасы)</expression>
	</totalField>
	<totalField>
		<dataPath>ПланГрн</dataPath>
		<expression>Сумма(ПланГрн)</expression>
	</totalField>
	<totalField>
		<dataPath>ФактГрн</dataPath>
		<expression>Сумма(ФактГрн)</expression>
	</totalField>
	<totalField>
		<dataPath>ОтклонениеЧасы</dataPath>
		<expression>Сумма(ФактЧасы)-Сумма(ПланЧасы)</expression>
	</totalField>
	<totalField>
		<dataPath>ОтклонениеГрн</dataPath>
		<expression>Сумма(ФактГрн)-Сумма(ПланГрн)</expression>
	</totalField>
	<totalField>
		<dataPath>ПроцентЧасы</dataPath>
		<expression>ВЫБОР КОГДА Сумма(ПланЧасы) = 0 ТОГДА 0 ИНАЧЕ Сумма(ФактЧасы) / Сумма(ПланЧасы) * 100 КОНЕЦ</expression>
	</totalField>
	<totalField>
		<dataPath>ПроцентГрн</dataPath>
		<expression>ВЫБОР КОГДА Сумма(ПланГрн) = 0 ТОГДА 0 ИНАЧЕ Сумма(ФактГрн) / Сумма(ПланГрн) * 100 КОНЕЦ</expression>
	</totalField>
