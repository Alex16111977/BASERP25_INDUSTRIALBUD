		<query>ВЫБРАТЬ
	СС.Ссылка КАК СС,
	СС.Подразделение КАК Подр,
	СС.СкладПроизводство КАК СкладВир,
	СС.СкладМонтаж КАК СкладМонт
ПОМЕСТИТЬ ВТ_СС
ИЗ
	Справочник.А_СтруктураСебестоимости КАК СС
ГДЕ
	СС.Ссылка = &amp;СтруктураСебестоимости
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_СС.Подр КАК Подразделение,
	"1. Праця" КАК Блок,
	ВЫБОР КОГДА Р.НаВыезде ТОГДА "Монтаж" ИНАЧЕ "Виробництво" КОНЕЦ КАК Категория,
	"Години, чол/год" КАК Показатель,
	Р.Этап КАК Этап,
	Р.Работа КАК Работа,
	НЕОПРЕДЕЛЕНО КАК Номенклатура,
	НЕОПРЕДЕЛЕНО КАК ФизЛицо,
	НЕОПРЕДЕЛЕНО КАК Сотрудник,
	Р.Количество КАК План,
	0 КАК Факт
ПОМЕСТИТЬ ВТ_Детали
ИЗ
	Справочник.А_СтруктураСебестоимости.Работы КАК Р
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
		ПО Р.Ссылка = ВТ_СС.СС

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТ_СС.Подр,
	"1. Праця",
	ВЫБОР КОГДА Р.НаВыезде ТОГДА "Монтаж" ИНАЧЕ "Виробництво" КОНЕЦ,
	"Вартість, грн",
	Р.Этап,
	Р.Работа,
	НЕОПРЕДЕЛЕНО,
	НЕОПРЕДЕЛЕНО,
	НЕОПРЕДЕЛЕНО,
	Р.Сумма,
	0
ИЗ
	Справочник.А_СтруктураСебестоимости.Работы КАК Р
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
		ПО Р.Ссылка = ВТ_СС.СС

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТ_СС.Подр,
	"2. Матеріали",
	ВЫБОР КОГДА К.Этап.Наименование ПОДОБНО "%Монтаж%" ТОГДА "Монтаж" ИНАЧЕ "Виробництво" КОНЕЦ,
	"Вартість, грн",
	К.Этап,
	НЕОПРЕДЕЛЕНО,
	К.Номенклатура,
	НЕОПРЕДЕЛЕНО,
	НЕОПРЕДЕЛЕНО,
	К.Сумма,
	0
ИЗ
	Справочник.А_СтруктураСебестоимости.Комплектующие КАК К
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
		ПО К.Ссылка = ВТ_СС.СС

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Т.Подразделение,
	"1. Праця",
	"Виробництво",
	"Години, чол/год",
	НЕОПРЕДЕЛЕНО,
	НЕОПРЕДЕЛЕНО,
	НЕОПРЕДЕЛЕНО,
	Т.Сотрудник.СотрудникЕРП.ФизическоеЛицо,
	Т.Сотрудник,
	0,
	Т.ЧасыФакт
ИЗ
	РегистрНакопления.А_ДанныеТабелирования КАК Т
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
		ПО Т.Подразделение = ВТ_СС.Подр
ГДЕ
	(Т.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
			ИЛИ &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВЗ.Подразделение,
	"1. Праця",
	"Виробництво",
	"Вартість, грн",
	НЕОПРЕДЕЛЕНО,
	НЕОПРЕДЕЛЕНО,
	НЕОПРЕДЕЛЕНО,
	ВЗ.ФизическоеЛицо,
	НЕОПРЕДЕЛЕНО,
	0,
	ВЗ.СуммаВзаиморасчетов
ИЗ
	РегистрНакопления.А_ВзаиморасчетыССотрудниками КАК ВЗ
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
		ПО ВЗ.Подразделение = ВТ_СС.Подр
ГДЕ
	ВЗ.Регистратор ССЫЛКА Документ.ОтражениеЗарплатыВФинансовомУчете
	И ВЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	И (ВЗ.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
			ИЛИ &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТ_СС.Подр,
	"2. Матеріали",
	ВЫБОР КОГДА ВЫРАЗИТЬ(СТ.Регистратор КАК Документ.СборкаТоваров).Склад = ВТ_СС.СкладМонт ТОГДА "Монтаж" ИНАЧЕ "Виробництво" КОНЕЦ,
	"Вартість, грн",
	НЕОПРЕДЕЛЕНО,
	НЕОПРЕДЕЛЕНО,
	СТ.АналитикаУчетаНоменклатуры.Номенклатура,
	НЕОПРЕДЕЛЕНО,
	НЕОПРЕДЕЛЕНО,
	0,
	СТ.СтоимостьУпр
ИЗ
	РегистрНакопления.СебестоимостьТоваров КАК СТ
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
		ПО ВЫРАЗИТЬ(СТ.Регистратор КАК Документ.СборкаТоваров).А_СтруктураСебестоимости = ВТ_СС.СС
ГДЕ
	СТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	И СТ.Регистратор ССЫЛКА Документ.СборкаТоваров
	И (СТ.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
			ИЛИ &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Детали.Подразделение КАК Подразделение,
	ВТ_Детали.Блок КАК Блок,
	ВТ_Детали.Категория КАК Категория,
	ВТ_Детали.Показатель КАК Показатель,
	ВТ_Детали.Этап КАК Этап,
	ВТ_Детали.Работа КАК Работа,
	ВТ_Детали.Номенклатура КАК Номенклатура,
	ВТ_Детали.ФизЛицо КАК ФизЛицо,
	ВТ_Детали.Сотрудник КАК Сотрудник,
	СУММА(ВТ_Детали.План) КАК План,
	СУММА(ВТ_Детали.Факт) КАК Факт,
	СУММА(ВТ_Детали.Факт) - СУММА(ВТ_Детали.План) КАК Отклонение,
	ВЫБОР
		КОГДА СУММА(ВТ_Детали.План) = 0
			ТОГДА NULL
		ИНАЧЕ СУММА(ВТ_Детали.Факт) / СУММА(ВТ_Детали.План) * 100
	КОНЕЦ КАК ПроцентВыполнения
ИЗ
	ВТ_Детали КАК ВТ_Детали
СГРУППИРОВАТЬ ПО
	ВТ_Детали.Подразделение,
	ВТ_Детали.Блок,
	ВТ_Детали.Категория,
	ВТ_Детали.Показатель,
	ВТ_Детали.Этап,
	ВТ_Детали.Работа,
	ВТ_Детали.Номенклатура,
	ВТ_Детали.ФизЛицо,
	ВТ_Детали.Сотрудник

УПОРЯДОЧИТЬ ПО
	Блок,
	Категория,
	Показатель</query>
	</dataSet>
	<totalField>
		<dataPath>План</dataPath>
		<expression>Сумма(План)</expression>
	</totalField>
	<totalField>
		<dataPath>Факт</dataPath>
		<expression>Сумма(Факт)</expression>
	</totalField>
	<totalField>
		<dataPath>Отклонение</dataPath>
		<expression>Сумма(Факт)-Сумма(План)</expression>
	</totalField>
	<totalField>
		<dataPath>ПроцентВыполнения</dataPath>
		<expression>ВЫБОР КОГДА Сумма(План) = 0 ТОГДА 0 ИНАЧЕ Сумма(Факт) / Сумма(План) * 100 КОНЕЦ</expression>
	</totalField>
