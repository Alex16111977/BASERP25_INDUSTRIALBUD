
&НаКлиенте
Процедура Сформувати(Команда)

	Если Не ЗначениеЗаполнено(СтруктураСебестоимости) Тогда
		ПоказатьПредупреждение(, "Оберіть структуру себестоімості.");
		Возврат;
	КонецЕсли;

	ТабДок = СформуватиНаСервере();
	Если ТабДок <> Неопределено Тогда
		ТабДок.Показать("Звіт виробництва по табелях");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СформуватиНаСервере()

	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	ТабДок = Новый ТабличныйДокумент;
	Данные = ОтчетОбъект.ПолучитьДанныеАнализа(Период, СтруктураСебестоимости);
	ОтчетОбъект.СформироватьТабличныйДокумент(Данные, ТабДок);
	Возврат ТабДок;

КонецФункции
