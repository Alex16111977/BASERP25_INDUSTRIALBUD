// Внешний отчёт А_ПланФактныйПроизводствоПолный.
// «Звіт виробництва по табелях» — программный ТабличныйДокумент, одна структура себестоимости за прогон.
// План — карта Справочник.А_СтруктураСебестоимости (работы по НаВыезде, материалы по Этапу).
// Факт — табель (часы), А_ВзаиморасчетыССотрудниками ОЗФУ (реальная ЗП), СебестоимостьТоваров (списание материалов).
// Все запросы предварительно проверены Python-COM на BaseERP (Rule #-1).

#Область ПрограммныйИнтерфейс

// Регистрация во «Внешних обработках/отчётах» (БСП «Дополнительные отчёты»).
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	МассивНазначений = Новый Массив;
	МассивНазначений.Добавить("");

	ИмяОтчета = Метаданные().Представление();

	ПараметрыРегистрации.Вставить("Вид", "ДополнительныйОтчет");
	ПараметрыРегистрации.Вставить("Назначение", МассивНазначений);
	ПараметрыРегистрации.Вставить("Наименование", ИмяОтчета);
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Истина);
	ПараметрыРегистрации.Вставить("Информация", "План-факт виробництва (повний) по структуре себестоимости");

	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд, ИмяОтчета, Метаданные().ПолноеИмя(), "ОткрытиеФормы", Истина);
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);

	Возврат ПараметрыРегистрации;

КонецФункции

// Главный сбор данных по одной структуре себестоимости.
// Период — месяц отчёта (StandardPeriod-дата); пусто => все данные.
Функция ПолучитьДанныеАнализа(Период, СтруктураСебестоимости) Экспорт

	Данные = Новый Структура;
	СС = СтруктураСебестоимости;
	Подр = СС.Подразделение;

	Если ЗначениеЗаполнено(Период) Тогда
		НачМес = НачалоМесяца(Период);
		КонМес = КонецМесяца(Период);
	Иначе
		НачМес = '00010101000000';
		КонМес = '39991231235959';
	КонецЕсли;
	// «Проект в цілому» = весь срок проекта (как в Excel); Період ограничивает только блок «<місяць>».
	КонПроекта = '39991231235959';

	Данные.Вставить("Период", Период);
	Данные.Вставить("СС", СС);
	Данные.Вставить("Подразделение", Подр);
	Данные.Вставить("НазваПодразделения", Строка(Подр));
	Данные.Вставить("КолвоПроект", 1);

	ЗаполнитьПлан(Данные, СС);
	ЗаполнитьФактЧасов(Данные, Подр, НачМес, КонМес, КонПроекта);
	ЗаполнитьФактЗП(Данные, Подр, НачМес, КонМес, КонПроекта);
	ЗаполнитьФактМатериалов(Данные, СС, КонПроекта);
	ЗаполнитьПроизводные(Данные);

	Возврат Данные;

КонецФункции

// Построить итоговый ТабличныйДокумент (5 блоков + 2 колонки реальной ЗП).
Процедура СформироватьТабличныйДокумент(Данные, ТабДок) Экспорт

	ТабДок.Очистить();

	// === Заголовок отчёта ===
	Обл = ТабДок.Область(1, 1, 1, 51);
	Обл.Объединить();
	Обл.Текст = "Звіт виробництва по табелях — " + Данные.НазваПодразделения
		+ ?(ЗначениеЗаполнено(Данные.Период), " (" + Формат(Данные.Период, "ДФ='LLLL yyyy'") + ")", "");
	Обл.Шрифт = Новый Шрифт(, 12, Истина);
	Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;

	НазваМесяца = ?(ЗначениеЗаполнено(Данные.Период), Формат(Данные.Период, "ДФ='LLLL yyyy'"), "місяць");

	// Строки шапки: 3, 4, 5 (групп / подблок / План-Факт-%%), данные — строка 6.
	СтрГ1 = 3;
	СтрГ2 = 4;
	СтрГ3 = 5;
	СтрД  = 6;

	// === Идентификация (колонки 1-2, шапка объединена по вертикали) ===
	ШапкаВертикаль(ТабДок, СтрГ1, СтрГ3, 1, "Підрозділ");
	ШапкаВертикаль(ТабДок, СтрГ1, СтрГ3, 2, "Проект, шт");
	ВывестиЯчейку(ТабДок, СтрД, 1, Данные.НазваПодразделения, Ложь, ГоризонтальноеПоложение.Лево);
	ВывестиЯчейку(ТабДок, СтрД, 2, Формат(Данные.КолвоПроект, "ЧДЦ=0"), Ложь, ГоризонтальноеПоложение.Центр);

	// === Блок 1: Згідно СС (колонки 3-9, одиночные значения) ===
	ШапкаБлок(ТабДок, СтрГ1, 3, 9, "Згідно СС");
	ВывестиЗначение(ТабДок, СтрГ2, СтрГ3, СтрД, 3, "Вартість робіт, грн", Данные.РаботыГрн, "грн");
	ВывестиЗначение(ТабДок, СтрГ2, СтрГ3, СтрД, 4, "Матеріали Виробництво", Данные.МатВир, "грн");
	ВывестиЗначение(ТабДок, СтрГ2, СтрГ3, СтрД, 5, "Матеріали Монтаж", Данные.МатМонт, "грн");
	ВывестиЗначение(ТабДок, СтрГ2, СтрГ3, СтрД, 6, "Час Виробництво", Данные.ЧасВир, "час");
	ВывестиЗначение(ТабДок, СтрГ2, СтрГ3, СтрД, 7, "Ставка Виробництво", Данные.СтавкаВир, "грн");
	ВывестиЗначение(ТабДок, СтрГ2, СтрГ3, СтрД, 8, "Час Монтаж", Данные.ЧасМонт, "час");
	ВывестиЗначение(ТабДок, СтрГ2, СтрГ3, СтрД, 9, "Ставка Монтаж", Данные.СтавкаМонт, "грн");

	// === Блок 2: ВІДВАНТАЖЕННЯ, шт (колонки 10-13, факт отложен = 0) ===
	ШапкаБлок(ТабДок, СтрГ1, 10, 13, "ВІДВАНТАЖЕННЯ, шт");
	ВывестиПару(ТабДок, СтрГ2, СтрГ3, СтрД, 10, "Проект", Данные.КолвоПроект, 0, "шт");
	ВывестиПару(ТабДок, СтрГ2, СтрГ3, СтрД, 12, НазваМесяца, Данные.КолвоПроект, 0, "шт");

	// === Блок 3: ФОТ виробничого персоналу, Проект (колонки 14-29) ===
	ШапкаБлок(ТабДок, СтрГ1, 14, 29, "ФОТ виробничого персоналу, Проект");
	ВывестиТройку(ТабДок, СтрГ2, СтрГ3, СтрД, 14, "Вир+Монтаж, грн",      Данные.СумГрнПлан,  Данные.СумГрнФактПроект, "грн");
	ВывестиТройку(ТабДок, СтрГ2, СтрГ3, СтрД, 17, "Виробництво, чол/год", Данные.ЧасВир,      Данные.ФактЧасПроект,    "час");
	ВывестиТройку(ТабДок, СтрГ2, СтрГ3, СтрД, 20, "Виробництво, грн",     Данные.ВирГрнПлан,  Данные.ВирГрнФактПроект, "грн");
	ВывестиТройку(ТабДок, СтрГ2, СтрГ3, СтрД, 23, "Монтаж, чол/год",      Данные.ЧасМонт,     Данные.ФактЧасМонтПроект,"час");
	ВывестиТройку(ТабДок, СтрГ2, СтрГ3, СтрД, 26, "Монтаж, грн",          Данные.МонтГрнПлан, Данные.МонтГрнФакт,      "грн");
	ВывестиЗначение(ТабДок, СтрГ2, СтрГ3, СтрД, 29, "ЗП нарах., грн", Данные.ЗПнарахПроект, "грн");

	// === Блок 4: ФОТ виробничого персоналу, <місяць> (колонки 30-45) ===
	ШапкаБлок(ТабДок, СтрГ1, 30, 45, "ФОТ виробничого персоналу, " + НазваМесяца);
	ВывестиТройку(ТабДок, СтрГ2, СтрГ3, СтрД, 30, "Вир+Монтаж, грн",      Данные.СумГрнПлан,  Данные.СумГрнФактМесяц,  "грн");
	ВывестиТройку(ТабДок, СтрГ2, СтрГ3, СтрД, 33, "Виробництво, чол/год", Данные.ЧасВир,      Данные.ФактЧасМесяц,     "час");
	ВывестиТройку(ТабДок, СтрГ2, СтрГ3, СтрД, 36, "Виробництво, грн",     Данные.ВирГрнПлан,  Данные.ВирГрнФактМесяц,  "грн");
	ВывестиТройку(ТабДок, СтрГ2, СтрГ3, СтрД, 39, "Монтаж, чол/год",      Данные.ЧасМонт,     Данные.ФактЧасМонтМесяц, "час");
	ВывестиТройку(ТабДок, СтрГ2, СтрГ3, СтрД, 42, "Монтаж, грн",          Данные.МонтГрнПлан, Данные.МонтГрнФакт,      "грн");
	ВывестиЗначение(ТабДок, СтрГ2, СтрГ3, СтрД, 45, "ЗП нарах., грн", Данные.ЗПнарахМесяц, "грн");

	// === Блок 5: Списання матеріалів, грн (колонки 46-51) ===
	ШапкаБлок(ТабДок, СтрГ1, 46, 51, "Списання матеріалів, грн");
	ВывестиТройку(ТабДок, СтрГ2, СтрГ3, СтрД, 46, "Виробництво БЦ", Данные.МатВир,  Данные.МатВирФакт,  "грн");
	ВывестиТройку(ТабДок, СтрГ2, СтрГ3, СтрД, 49, "При монтажу",    Данные.МатМонт, Данные.МатМонтФакт, "грн");

	ТабДок.ФиксацияСлева = 2;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДанных

Процедура ЗаполнитьПлан(Данные, СС)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СС", СС);

	// Работы: часы и сумма по флагу НаВыезде (Ложь=Виробництво, Истина=Монтаж).
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.НаВыезде КАК НаВыезде,
	|	СУММА(Р.Количество) КАК Часы,
	|	СУММА(Р.Сумма) КАК Сумма
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Работы КАК Р
	|ГДЕ
	|	Р.Ссылка = &СС
	|СГРУППИРОВАТЬ ПО
	|	Р.НаВыезде";
	ЧасВир = 0; ЧасМонт = 0; РаботыГрн = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.НаВыезде Тогда
			ЧасМонт = ЧасМонт + Выборка.Часы;
		Иначе
			ЧасВир = ЧасВир + Выборка.Часы;
		КонецЕсли;
		РаботыГрн = РаботыГрн + Выборка.Сумма;
	КонецЦикла;
	Данные.Вставить("ЧасВир", ЧасВир);
	Данные.Вставить("ЧасМонт", ЧасМонт);
	Данные.Вставить("РаботыГрн", РаботыГрн);

	// Материалы: монтаж = этап с «Монтаж» в наименовании, остальное — производство.
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР КОГДА К.Этап.Наименование ПОДОБНО ""%Монтаж%"" ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК Монтаж,
	|	СУММА(К.Сумма) КАК Сумма
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Комплектующие КАК К
	|ГДЕ
	|	К.Ссылка = &СС
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР КОГДА К.Этап.Наименование ПОДОБНО ""%Монтаж%"" ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ";
	МатВир = 0; МатМонт = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Монтаж Тогда
			МатМонт = МатМонт + Выборка.Сумма;
		Иначе
			МатВир = МатВир + Выборка.Сумма;
		КонецЕсли;
	КонецЦикла;
	Данные.Вставить("МатВир", МатВир);
	Данные.Вставить("МатМонт", МатМонт);

	// Ставка чол/год = цена, на которую приходится больше всего часов (модальная по часам).
	Данные.Вставить("СтавкаВир", СтавкаПоЧасам(СС, Ложь));
	Данные.Вставить("СтавкаМонт", СтавкаПоЧасам(СС, Истина));

КонецПроцедуры

Функция СтавкаПоЧасам(СС, НаВыезде)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СС", СС);
	Запрос.УстановитьПараметр("НаВыезде", НаВыезде);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Р.Цена КАК Цена,
	|	СУММА(Р.Количество) КАК Часы
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Работы КАК Р
	|ГДЕ
	|	Р.Ссылка = &СС
	|	И Р.НаВыезде = &НаВыезде
	|	И Р.Количество > 0
	|СГРУППИРОВАТЬ ПО
	|	Р.Цена
	|УПОРЯДОЧИТЬ ПО
	|	Часы УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;
	Возврат 0;

КонецФункции

Процедура ЗаполнитьФактЧасов(Данные, Подр, НачМес, КонМес, КонПроекта)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Подр", Подр);
	Запрос.УстановитьПараметр("КонПроекта", КонПроекта);
	Запрос.УстановитьПараметр("НачМес", НачМес);
	Запрос.УстановитьПараметр("КонМес", КонМес);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(ВЫБОР КОГДА Т.Период <= &КонПроекта ТОГДА Т.ЧасыФакт ИНАЧЕ 0 КОНЕЦ) КАК ЧасПроект,
	|	СУММА(ВЫБОР КОГДА Т.Период МЕЖДУ &НачМес И &КонМес ТОГДА Т.ЧасыФакт ИНАЧЕ 0 КОНЕЦ) КАК ЧасМесяц
	|ИЗ
	|	РегистрНакопления.А_ДанныеТабелирования КАК Т
	|ГДЕ
	|	Т.Подразделение = &Подр
	|	И Т.Период <= &КонПроекта";
	ЧасПроект = 0; ЧасМесяц = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЧасПроект = ЧислоИлиНоль(Выборка.ЧасПроект);
		ЧасМесяц = ЧислоИлиНоль(Выборка.ЧасМесяц);
	КонецЕсли;
	Данные.Вставить("ФактЧасПроект", ЧасПроект);
	Данные.Вставить("ФактЧасМесяц", ЧасМесяц);

КонецПроцедуры

Процедура ЗаполнитьФактЗП(Данные, Подр, НачМес, КонМес, КонПроекта)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Подр", Подр);
	Запрос.УстановитьПараметр("КонПроекта", КонПроекта);
	Запрос.УстановитьПараметр("НачМес", НачМес);
	Запрос.УстановитьПараметр("КонМес", КонМес);
	// Реальная начисленная ЗП: только ОЗФУ, Приход, Общий Ф1+Ф2; ключ — Подразделение начисления.
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(ВЫБОР КОГДА ВЗ.Период <= &КонПроекта ТОГДА ВЗ.СуммаВзаиморасчетов ИНАЧЕ 0 КОНЕЦ) КАК ЗППроект,
	|	СУММА(ВЫБОР КОГДА ВЗ.Период МЕЖДУ &НачМес И &КонМес ТОГДА ВЗ.СуммаВзаиморасчетов ИНАЧЕ 0 КОНЕЦ) КАК ЗПМесяц
	|ИЗ
	|	РегистрНакопления.А_ВзаиморасчетыССотрудниками КАК ВЗ
	|ГДЕ
	|	ВЗ.Подразделение = &Подр
	|	И ВЗ.Регистратор ССЫЛКА Документ.ОтражениеЗарплатыВФинансовомУчете
	|	И ВЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И ВЗ.Период <= &КонПроекта";
	ЗППроект = 0; ЗПМесяц = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗППроект = ЧислоИлиНоль(Выборка.ЗППроект);
		ЗПМесяц = ЧислоИлиНоль(Выборка.ЗПМесяц);
	КонецЕсли;
	Данные.Вставить("ЗПнарахПроект", ЗППроект);
	Данные.Вставить("ЗПнарахМесяц", ЗПМесяц);

КонецПроцедуры

Процедура ЗаполнитьФактМатериалов(Данные, СС, КонПроекта)

	МатВирФакт = 0;
	МатМонтФакт = 0;
	Если ЗначениеЗаполнено(СС.СкладПроизводство) Тогда
		МатВирФакт = СтоимостьСписанияМатериалов(СС, СС.СкладПроизводство, КонПроекта);
	КонецЕсли;
	Если ЗначениеЗаполнено(СС.СкладМонтаж) Тогда
		МатМонтФакт = СтоимостьСписанияМатериалов(СС, СС.СкладМонтаж, КонПроекта);
	КонецЕсли;
	Данные.Вставить("МатВирФакт", МатВирФакт);
	Данные.Вставить("МатМонтФакт", МатМонтФакт);

КонецПроцедуры

Функция СтоимостьСписанияМатериалов(СС, Склад, КонПроекта)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СС", СС);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("КонПроекта", КонПроекта);
	// Себестоимость списания материалов документами СборкаТоваров по складу (управленческая).
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(СТ.СтоимостьУпр) КАК Стоимость
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров КАК СТ
	|ГДЕ
	|	СТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И СТ.Регистратор ССЫЛКА Документ.СборкаТоваров
	|	И ВЫРАЗИТЬ(СТ.Регистратор КАК Документ.СборкаТоваров).А_СтруктураСебестоимости = &СС
	|	И ВЫРАЗИТЬ(СТ.Регистратор КАК Документ.СборкаТоваров).Склад = &Склад
	|	И СТ.Период <= &КонПроекта";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат ЧислоИлиНоль(Выборка.Стоимость);
	КонецЕсли;
	Возврат 0;

КонецФункции

Процедура ЗаполнитьПроизводные(Данные)

	// Нотиональный ФОТ = часы × ставка.
	Данные.Вставить("ВирГрнПлан", Данные.ЧасВир * Данные.СтавкаВир);
	Данные.Вставить("ВирГрнФактПроект", Данные.ФактЧасПроект * Данные.СтавкаВир);
	Данные.Вставить("ВирГрнФактМесяц", Данные.ФактЧасМесяц * Данные.СтавкаВир);
	Данные.Вставить("МонтГрнПлан", Данные.ЧасМонт * Данные.СтавкаМонт);

	// Факт-часы из табеля не делятся Виробництво/Монтаж → Монтаж-факт = 0.
	Данные.Вставить("МонтГрнФакт", 0);
	Данные.Вставить("ФактЧасМонтПроект", 0);
	Данные.Вставить("ФактЧасМонтМесяц", 0);

	// Суммарный грн = Виробництво + Монтаж.
	Данные.Вставить("СумГрнПлан", Данные.ВирГрнПлан + Данные.МонтГрнПлан);
	Данные.Вставить("СумГрнФактПроект", Данные.ВирГрнФактПроект + Данные.МонтГрнФакт);
	Данные.Вставить("СумГрнФактМесяц", Данные.ВирГрнФактМесяц + Данные.МонтГрнФакт);

КонецПроцедуры

Функция ЧислоИлиНоль(Значение)
	Возврат ?(Значение = Null, 0, Значение);
КонецФункции

#КонецОбласти

#Область ПостроениеТаблицы

// Объединённая по вертикали ячейка шапки (идентификационные колонки).
Процедура ШапкаВертикаль(ТабДок, СтрНач, СтрКон, Кол, Текст)
	Обл = ТабДок.Область(СтрНач, Кол, СтрКон, Кол);
	Обл.Объединить();
	Обл.Текст = Текст;
	ОформитьШапку(Обл);
КонецПроцедуры

// Заголовок блока (строка 1 шапки), объединён по горизонтали над колонками блока.
Процедура ШапкаБлок(ТабДок, Стр, КолНач, КолКон, Текст)
	Обл = ТабДок.Область(Стр, КолНач, Стр, КолКон);
	Обл.Объединить();
	Обл.Текст = Текст;
	ОформитьШапку(Обл);
КонецПроцедуры

// Одиночная колонка-значение (шапка объединена по строкам Г2-Г3, данные в строке Д).
Процедура ВывестиЗначение(ТабДок, СтрГ2, СтрГ3, СтрД, Кол, Заголовок, Значение, ВидЧисла)
	Обл = ТабДок.Область(СтрГ2, Кол, СтрГ3, Кол);
	Обл.Объединить();
	Обл.Текст = Заголовок;
	ОформитьШапку(Обл);
	ВывестиЯчейку(ТабДок, СтрД, Кол, ФорматЧисла(Значение, ВидЧисла), Ложь, ГоризонтальноеПоложение.Право);
КонецПроцедуры

// Пара План/Факт (для блока Відвантаження).
Процедура ВывестиПару(ТабДок, СтрГ2, СтрГ3, СтрД, КолНач, Заголовок, План, Факт, ВидЧисла)
	Обл = ТабДок.Область(СтрГ2, КолНач, СтрГ2, КолНач + 1);
	Обл.Объединить();
	Обл.Текст = Заголовок;
	ОформитьШапку(Обл);
	ВывестиЯчейку(ТабДок, СтрГ3, КолНач,     "План", Ложь, ГоризонтальноеПоложение.Центр);
	ВывестиЯчейку(ТабДок, СтрГ3, КолНач + 1, "Факт", Ложь, ГоризонтальноеПоложение.Центр);
	ОформитьШапку(ТабДок.Область(СтрГ3, КолНач, СтрГ3, КолНач + 1));
	ВывестиЯчейку(ТабДок, СтрД, КолНач,     ФорматЧисла(План, ВидЧисла), Ложь, ГоризонтальноеПоложение.Право);
	ВывестиЯчейку(ТабДок, СтрД, КолНач + 1, ФорматЧисла(Факт, ВидЧисла), Ложь, ГоризонтальноеПоложение.Право);
КонецПроцедуры

// Тройка План / Факт / %% План-факт.
Процедура ВывестиТройку(ТабДок, СтрГ2, СтрГ3, СтрД, КолНач, Заголовок, План, Факт, ВидЧисла)
	Обл = ТабДок.Область(СтрГ2, КолНач, СтрГ2, КолНач + 2);
	Обл.Объединить();
	Обл.Текст = Заголовок;
	ОформитьШапку(Обл);
	ВывестиЯчейку(ТабДок, СтрГ3, КолНач,     "План",         Ложь, ГоризонтальноеПоложение.Центр);
	ВывестиЯчейку(ТабДок, СтрГ3, КолНач + 1, "Факт",         Ложь, ГоризонтальноеПоложение.Центр);
	ВывестиЯчейку(ТабДок, СтрГ3, КолНач + 2, "%% План/факт", Ложь, ГоризонтальноеПоложение.Центр);
	ВывестиЯчейку(ТабДок, СтрД, КолНач,     ФорматЧисла(План, ВидЧисла), Ложь, ГоризонтальноеПоложение.Право);
	ВывестиЯчейку(ТабДок, СтрД, КолНач + 1, ФорматЧисла(Факт, ВидЧисла), Ложь, ГоризонтальноеПоложение.Право);
	ВывестиЯчейку(ТабДок, СтрД, КолНач + 2, ФорматПроцента(План, Факт),  Ложь, ГоризонтальноеПоложение.Право);
КонецПроцедуры

// Запись текста в одну ячейку + контур.
Процедура ВывестиЯчейку(ТабДок, Стр, Кол, Текст, Жирный, Гориз)
	Обл = ТабДок.Область(Стр, Кол, Стр, Кол);
	Обл.Текст = Текст;
	Если Жирный Тогда
		Обл.Шрифт = Новый Шрифт(, , Истина);
	КонецЕсли;
	Обл.ГоризонтальноеПоложение = Гориз;
	УстановитьГраницы(Обл);
КонецПроцедуры

Процедура ОформитьШапку(Обл)
	Обл.Шрифт = Новый Шрифт(, , Истина);
	Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	Обл.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	Обл.ЦветФона = Новый Цвет(222, 234, 246);
	УстановитьГраницы(Обл);
КонецПроцедуры

// Сплошной контур области (ОбластьТабличногоДокумента.Граница напрямую не ставится).
Процедура УстановитьГраницы(Обл)
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	Обл.ГраницаСверху = Линия;
	Обл.ГраницаСнизу = Линия;
	Обл.ГраницаСлева = Линия;
	Обл.ГраницаСправа = Линия;
КонецПроцедуры

Функция ФорматЧисла(Значение, ВидЧисла)
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Если ВидЧисла = "шт" Тогда
		Возврат Формат(Значение, "ЧДЦ=0; ЧН=");
	КонецЕсли;
	Возврат Формат(Значение, "ЧДЦ=2; ЧРГ=' '; ЧН=");
КонецФункции

Функция ФорматПроцента(План, Факт)
	Если План = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Формат(Факт / План * 100, "ЧДЦ=1; ЧН=") + "%";
КонецФункции

#КонецОбласти

#Область РегистрацияОбработки

Функция ПолучитьТаблицуКоманд()
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
КонецПроцедуры

