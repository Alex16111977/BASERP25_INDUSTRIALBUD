#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Внешний отчёт А_ПланФактныйПроизводствоПолный.
// «Звіт виробництва по табелях» — программная компоновка СКД (ПриКомпоновкеРезультата):
// данные строит ObjectModule (ПолучитьДанные), затем передаются в СКД как внешний набор "Детали".
// Причина программной компоновки: маппинг факт-материалів на Етап через
// Номенклатура.А_ОбщееНазваниеНоменклатуры невозможен в запросе СКД на этой базе (1С-квирк
// с соединением по справочнику А_ОбщиеНазванияНоменклатуры), делается в BSL через Соответствие.
// Источники проверены Python-COM (Rule #-1).

#Область СлужебныйПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	МассивНазначений = Новый Массив;
	МассивНазначений.Добавить("");

	ИмяОтчета = Метаданные().Представление();

	ПараметрыРегистрации.Вставить("Вид", "ДополнительныйОтчет");
	ПараметрыРегистрации.Вставить("Назначение", МассивНазначений);
	ПараметрыРегистрации.Вставить("Наименование", ИмяОтчета);
	ПараметрыРегистрации.Вставить("Версия", "3.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Истина);
	ПараметрыРегистрации.Вставить("Информация", "Виробництво: план-факт за структурою собівартості (з розшифровкою)");

	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд, ИмяОтчета, Метаданные().ПолноеИмя(), "ОткрытиеФормы", Истина);
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);

	Возврат ПараметрыРегистрации;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Программная компоновка: данные готовятся в ПолучитьДанные и передаются в СКД
// как внешний набор данных "Детали". Расшифровка штатная (ДанныеРасшифровки прокидывается).
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	УстановитьПривилегированныйРежим(Истина);

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();

	Период = ПолучитьЗначениеПараметра(КомпоновщикНастроек, "Период");
	СС = ПолучитьЗначениеПараметра(КомпоновщикНастроек, "СтруктураСебестоимости");

	ТаблицаДетали = ПолучитьДанные(Период, СС);

	ВнешниеНаборыДанных = Новый Структура("Детали", ТаблицаДетали);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Главный сбор данных: строит плоскую ТЗ грейна по одной СС,
// затем разносит факт-материали по Етапу/Категорії через Номенклатура.А_ОбщееНазваниеНоменклатуры.
// Факт-материали = ЗАКУПКИ (СебестоимостьТоваров.Приход / ПриобретениеТоваровУслуг по подразделению СС),
// НЕ списание/остатки. Сверка: А_ПланФактныйАнализСебестоимости (тот же источник).
Функция ПолучитьДанные(Период, СС) Экспорт

	Если НЕ ЗначениеЗаполнено(СС) Тогда
		Возврат СоздатьПустуюТаблицу();
	КонецЕсли;

	// Границы периода обрабатываем НЕЗАВИСИМО: открытый период работает по любой заданной
	// границе (только конец = «с начала до даты X»). Оба пусты = весь срок («Проект в цілому»).
	Если ЗначениеЗаполнено(Период) И ЗначениеЗаполнено(Период.ДатаНачала) Тогда
		НачП = Период.ДатаНачала;
	Иначе
		НачП = '00010101000000';
	КонецЕсли;
	Если ЗначениеЗаполнено(Период) И ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		КонП = КонецДня(Период.ДатаОкончания);
	Иначе
		КонП = '39991231235959';
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СС", СС);
	Запрос.УстановитьПараметр("НачП", НачП);
	Запрос.УстановитьПараметр("КонП", КонП);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СС.Ссылка КАК СС,
	|	СС.Подразделение КАК Подр,
	|	СС.СкладПроизводство КАК СкладВир,
	|	СС.СкладМонтаж КАК СкладМонт
	|ПОМЕСТИТЬ ВТ_СС
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости КАК СС
	|ГДЕ
	|	СС.Ссылка = &СС
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Р.Работа КАК Работа,
	|	МАКСИМУМ(Р.НаВыезде) КАК НаВыезде
	|ПОМЕСТИТЬ ВТ_РаботыСС
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Работы КАК Р
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
	|		ПО Р.Ссылка = ВТ_СС.СС
	|СГРУППИРОВАТЬ ПО
	|	Р.Работа
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СС.Подр КАК Подразделение,
	|	""1. Праця"" КАК Блок,
	|	ВЫБОР КОГДА Р.НаВыезде ТОГДА ""Монтаж"" ИНАЧЕ ""Виробництво"" КОНЕЦ КАК Категория,
	|	Р.Этап КАК Этап,
	|	Р.Работа КАК Работа,
	|	ЗНАЧЕНИЕ(Справочник.А_ОбщиеНазванияНоменклатуры.ПустаяСсылка) КАК ОбщееНазвание,
	|	НЕОПРЕДЕЛЕНО КАК Документ,
	|	Р.Работа КАК Аналитика,
	|	"""" КАК НоменклатураНаименование,
	|	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) КАК Единица,
	|	Р.Количество КАК ПланЧасы,
	|	0 КАК ФактЧасы,
	|	0 КАК ВиконанняЧасы,
	|	0 КАК ПланКол,
	|	0 КАК ФактКол,
	|	Р.Сумма КАК ПланГрн,
	|	0 КАК ФактГрн
	|ПОМЕСТИТЬ ВТ_Детали
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Работы КАК Р
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
	|		ПО Р.Ссылка = ВТ_СС.СС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_СС.Подр,
	|	""2. Матеріали"",
	|	ВЫБОР КОГДА К.Этап.Наименование ПОДОБНО ""%Монтаж%"" ТОГДА ""Монтаж"" ИНАЧЕ ""Виробництво"" КОНЕЦ,
	|	К.Этап,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
	|	К.Номенклатура.А_ОбщееНазваниеНоменклатуры,
	|	К.Ссылка,
	|	К.Номенклатура,
	|	"""",
	|	К.Номенклатура.ЕдиницаИзмерения,
	|	0,
	|	0,
	|	0,
	|	К.Количество,
	|	0,
	|	К.Сумма,
	|	0
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Комплектующие КАК К
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
	|		ПО К.Ссылка = ВТ_СС.СС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Подразделение,
	|	""1. Праця"",
	|	""Виробництво"",
	|	НЕОПРЕДЕЛЕНО,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.А_ОбщиеНазванияНоменклатуры.ПустаяСсылка),
	|	НЕОПРЕДЕЛЕНО,
	|	Т.Сотрудник.СотрудникЕРП.ФизическоеЛицо,
	|	"""",
	|	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка),
	|	0,
	|	Т.ЧасыФакт,
	|	0,
	|	0,
	|	0,
	|	0,
	|	0
	|ИЗ
	|	РегистрНакопления.А_ДанныеТабелирования КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
	|		ПО Т.Подразделение = ВТ_СС.Подр
	|ГДЕ
	|	Т.Период МЕЖДУ &НачП И &КонП
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЗ.Подразделение,
	|	""1. Праця"",
	|	""Виробництво"",
	|	НЕОПРЕДЕЛЕНО,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.А_ОбщиеНазванияНоменклатуры.ПустаяСсылка),
	|	НЕОПРЕДЕЛЕНО,
	|	ВЗ.ФизическоеЛицо,
	|	"""",
	|	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка),
	|	0,
	|	0,
	|	0,
	|	0,
	|	0,
	|	0,
	|	ВЗ.СуммаВзаиморасчетов
	|ИЗ
	|	РегистрНакопления.А_ВзаиморасчетыССотрудниками КАК ВЗ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
	|		ПО ВЗ.Подразделение = ВТ_СС.Подр
	|ГДЕ
	|	ВЗ.Регистратор ССЫЛКА Документ.ОтражениеЗарплатыВФинансовомУчете
	|	И ВЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И ВЗ.Период МЕЖДУ &НачП И &КонП
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_СС.Подр,
	|	""2. Матеріали"",
	|	""Виробництво"",
	|	НЕОПРЕДЕЛЕНО,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
	|	СТ.АналитикаУчетаНоменклатуры.Номенклатура.А_ОбщееНазваниеНоменклатуры,
	|	ВЫРАЗИТЬ(СТ.Регистратор КАК Документ.ПриобретениеТоваровУслуг),
	|	СТ.АналитикаУчетаНоменклатуры.Номенклатура,
	|	СТ.АналитикаУчетаНоменклатуры.Номенклатура.Наименование,
	|	СТ.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения,
	|	0,
	|	0,
	|	0,
	|	0,
	|	СТ.Количество,
	|	0,
	|	СТ.СтоимостьБезНДС
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров КАК СТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
	|		ПО ВЫРАЗИТЬ(СТ.Регистратор КАК Документ.ПриобретениеТоваровУслуг).Подразделение = ВТ_СС.Подр
	|ГДЕ
	|	СТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И СТ.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыНаСкладах)
	|	И СТ.Регистратор ССЫЛКА Документ.ПриобретениеТоваровУслуг
	|	И СТ.Период МЕЖДУ &НачП И &КонП
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_СС.Подр,
	|	""1. Праця"",
	|	ВЫБОР КОГДА ЕСТЬNULL(РС.НаВыезде, ЛОЖЬ) ТОГДА ""Монтаж"" ИНАЧЕ ""Виробництво"" КОНЕЦ,
	|	ВРМ.Этап,
	|	ВРМ.Работа,
	|	ЗНАЧЕНИЕ(Справочник.А_ОбщиеНазванияНоменклатуры.ПустаяСсылка),
	|	НЕОПРЕДЕЛЕНО,
	|	ВРМ.Работа,
	|	"""",
	|	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка),
	|	0,
	|	0,
	|	ВРМ.ЧасыВыполнение,
	|	0,
	|	0,
	|	0,
	|	0
	|ИЗ
	|	РегистрНакопления.А_ВыполнениеРаботМодулей КАК ВРМ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СС КАК ВТ_СС
	|		ПО ВРМ.СтруктураСебестоимости = ВТ_СС.СС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РаботыСС КАК РС
	|		ПО ВРМ.Работа = РС.Работа
	|ГДЕ
	|	ВРМ.Период МЕЖДУ &НачП И &КонП
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Детали.Подразделение КАК Подразделение,
	|	ВТ_Детали.Блок КАК Блок,
	|	ВТ_Детали.Категория КАК Категория,
	|	ВТ_Детали.Этап КАК Этап,
	|	ВТ_Детали.Работа КАК Работа,
	|	ВТ_Детали.ОбщееНазвание КАК ОбщееНазвание,
	|	ВТ_Детали.Аналитика КАК Аналитика,
	|	ВТ_Детали.НоменклатураНаименование КАК НоменклатураНаименование,
	|	ВТ_Детали.Единица КАК Единица,
	|	ВТ_Детали.Документ КАК Документ,
	|	СУММА(ВТ_Детали.ПланЧасы) КАК ПланЧасы,
	|	СУММА(ВТ_Детали.ФактЧасы) КАК ФактЧасы,
	|	СУММА(ВТ_Детали.ВиконанняЧасы) КАК ВиконанняЧасы,
	|	СУММА(ВТ_Детали.ПланКол) КАК ПланКол,
	|	СУММА(ВТ_Детали.ФактКол) КАК ФактКол,
	|	СУММА(ВТ_Детали.ПланГрн) КАК ПланГрн,
	|	СУММА(ВТ_Детали.ФактГрн) КАК ФактГрн,
	|	СУММА(ВТ_Детали.ФактЧасы) - СУММА(ВТ_Детали.ПланЧасы) КАК ОтклонениеЧасы,
	|	СУММА(ВТ_Детали.ФактКол) - СУММА(ВТ_Детали.ПланКол) КАК ОтклонениеКол,
	|	СУММА(ВТ_Детали.ФактГрн) - СУММА(ВТ_Детали.ПланГрн) КАК ОтклонениеГрн,
	|	ВЫБОР
	|		КОГДА СУММА(ВТ_Детали.ПланЧасы) = 0 ТОГДА 0
	|		ИНАЧЕ СУММА(ВТ_Детали.ФактЧасы) / СУММА(ВТ_Детали.ПланЧасы) * 100
	|	КОНЕЦ КАК ПроцентЧасы,
	|	ВЫБОР
	|		КОГДА СУММА(ВТ_Детали.ПланКол) = 0 ТОГДА 0
	|		ИНАЧЕ СУММА(ВТ_Детали.ФактКол) / СУММА(ВТ_Детали.ПланКол) * 100
	|	КОНЕЦ КАК ПроцентКол,
	|	ВЫБОР
	|		КОГДА СУММА(ВТ_Детали.ПланГрн) = 0 ТОГДА 0
	|		ИНАЧЕ СУММА(ВТ_Детали.ФактГрн) / СУММА(ВТ_Детали.ПланГрн) * 100
	|	КОНЕЦ КАК ПроцентГрн,
	|	СУММА(ВТ_Детали.ФактЧасы) - СУММА(ВТ_Детали.ВиконанняЧасы) КАК ОтклонениеВиконання,
	|	ВЫБОР
	|		КОГДА СУММА(ВТ_Детали.ПланЧасы) = 0 ТОГДА 0
	|		ИНАЧЕ СУММА(ВТ_Детали.ВиконанняЧасы) / СУММА(ВТ_Детали.ПланЧасы) * 100
	|	КОНЕЦ КАК ПроцентВиконання,
	|	0 КАК ПланНаФактГрн,
	|	СУММА(ВТ_Детали.ФактГрн) КАК ПрогнозГрн,
	|	СУММА(ВТ_Детали.ФактГрн) - СУММА(ВТ_Детали.ПланГрн) КАК ОтклонениеПрогнозГрн,
	|	ВЫБОР
	|		КОГДА СУММА(ВТ_Детали.ПланГрн) = 0 ТОГДА 0
	|		ИНАЧЕ СУММА(ВТ_Детали.ФактГрн) / СУММА(ВТ_Детали.ПланГрн) * 100
	|	КОНЕЦ КАК ПроцентПрогнозГрн
	|ИЗ
	|	ВТ_Детали КАК ВТ_Детали
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Детали.Подразделение,
	|	ВТ_Детали.Блок,
	|	ВТ_Детали.Категория,
	|	ВТ_Детали.Этап,
	|	ВТ_Детали.Работа,
	|	ВТ_Детали.ОбщееНазвание,
	|	ВТ_Детали.Аналитика,
	|	ВТ_Детали.НоменклатураНаименование,
	|	ВТ_Детали.Единица,
	|	ВТ_Детали.Документ";

	ТЗ = Запрос.Выполнить().Выгрузить();

	ЗаполнитьЭтапФактМатериалов(ТЗ, СС);
	ЗаполнитьПланНаФакт(ТЗ);

	Возврат ТЗ;

КонецФункции

// Разнос факт-материалів (Блок="2. Матеріали", Етап пуст) по Етапу И Категорії:
// Номенклатура.А_ОбщееНазваниеНоменклатуры -> {Этап, Категория} из плана Комплектующие (через Соответствие).
// Категория Вир/Монт берётся по этапу — так же, как категоризируется план.
Процедура ЗаполнитьЭтапФактМатериалов(ТЗ, СС)

	Маппинг = МаппингОбщееНазваниеЭтап(СС);
	Если Маппинг.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ТипНоменклатура = Тип("СправочникСсылка.Номенклатура");

	Для Каждого СтрокаТЗ Из ТЗ Цикл
		Если СтрокаТЗ.Блок <> "2. Матеріали"
			ИЛИ ЗначениеЗаполнено(СтрокаТЗ.Этап)
			ИЛИ ТипЗнч(СтрокаТЗ.Аналитика) <> ТипНоменклатура Тогда
			Продолжить;
		КонецЕсли;
		ОбщееНазвание = СтрокаТЗ.Аналитика.А_ОбщееНазваниеНоменклатуры;
		Если НЕ ЗначениеЗаполнено(ОбщееНазвание) Тогда
			Продолжить;
		КонецЕсли;
		// Ключ — по ИМЕНИ общего названия (нормализация пробелов), т.к. у А_ОбщиеНазванияНоменклатуры
		// есть дубли ссылок с одинаковым именем — сопоставление по ссылке не находит.
		Ключ = СокрЛП(ОбщееНазвание.Наименование);
		ДанныеЭтапа = Маппинг.Получить(Ключ);
		Если ДанныеЭтапа <> Неопределено Тогда
			СтрокаТЗ.Этап = ДанныеЭтапа.Этап;
			СтрокаТЗ.Категория = ДанныеЭтапа.Категория;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// «План на факт» (ETC) / «Прогноз» (EAC) по материалам.
// Нетто ПланКол/ФактКол/ПланГрн строго ПО ОБЩЕЙ НАЗВЕ (Подразделение, ОбщееНазвание), stage/cat-agnostic:
// ПланЦена=ПланГрн/ПланКол; Залишок=max(0,ПланКол-ФактКол); ПланНаФакт=Залишок*ПланЦена.
// (Ключ БЕЗ Этап/Категория — иначе перерасход одного этапа не гасит остаток плана в другом, ETC завышается.)
// Вставляет синтетическую строку «залишок плану» на этап/категорию плана с макс. ПланГрн этой ОН
// (Аналитика/Единица/Документ — типизированные пустые ссылки, чтобы не плодить пустые строки в расшифровке).
// Прогноз/Відхилення/% — totalField в схеме (Сумма(ФактГрн)+Сумма(ПланНаФактГрн) и т.д.).
Процедура ЗаполнитьПланНаФакт(ТЗ)

	// 1) Нетто ПланКол/ФактКол/ПланГрн строго ПО ОБЩЕЙ НАЗВЕ (Подразделение, ОбщееНазвание) —
	//    stage/category-agnostic, чтобы перерасход одного этапа гасил недовыполнение плана другого.
	Агр = Новый ТаблицаЗначений;
	Агр.Колонки.Добавить("Подразделение");
	Агр.Колонки.Добавить("ОбщееНазвание");
	Агр.Колонки.Добавить("ПланКол");
	Агр.Колонки.Добавить("ФактКол");
	Агр.Колонки.Добавить("ПланГрн");

	// 2) Куда положить синт.строку: (Категория, Этап) плановой строки с макс. ПланГрн этой ОН.
	Размещение = Новый Соответствие;

	Для Каждого СтрокаТЗ Из ТЗ Цикл
		Если СтрокаТЗ.Блок <> "2. Матеріали" Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Агр.Добавить();
		НоваяСтрока.Подразделение = СтрокаТЗ.Подразделение;
		НоваяСтрока.ОбщееНазвание = СтрокаТЗ.ОбщееНазвание;
		НоваяСтрока.ПланКол = СтрокаТЗ.ПланКол;
		НоваяСтрока.ФактКол = СтрокаТЗ.ФактКол;
		НоваяСтрока.ПланГрн = СтрокаТЗ.ПланГрн;

		Если ЗначениеЗаполнено(СтрокаТЗ.ОбщееНазвание) И СтрокаТЗ.ПланГрн > 0 Тогда
			Ключ = КлючРазмещенияПланНаФакт(СтрокаТЗ.Подразделение, СтрокаТЗ.ОбщееНазвание);
			Тек = Размещение.Получить(Ключ);
			Если Тек = Неопределено ИЛИ СтрокаТЗ.ПланГрн > Тек.МаксГрн Тогда
				Размещение.Вставить(Ключ, Новый Структура("Категория, Этап, МаксГрн",
					СтрокаТЗ.Категория, СтрокаТЗ.Этап, СтрокаТЗ.ПланГрн));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Агр.Свернуть("Подразделение,ОбщееНазвание", "ПланКол,ФактКол,ПланГрн");

	ПустаяНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
	ПустаяЕдиница = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	ПустойДокумент = Документы.ПриобретениеТоваровУслуг.ПустаяСсылка();

	Для Каждого СтрокаАгр Из Агр Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаАгр.ОбщееНазвание) ИЛИ СтрокаАгр.ПланКол <= 0 Тогда
			Продолжить;
		КонецЕсли;
		ПланЦена = СтрокаАгр.ПланГрн / СтрокаАгр.ПланКол;
		Залишок = ?(СтрокаАгр.ПланКол - СтрокаАгр.ФактКол > 0, СтрокаАгр.ПланКол - СтрокаАгр.ФактКол, 0);
		ПланНаФакт = Залишок * ПланЦена;
		Если ПланНаФакт <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Разм = Размещение.Получить(КлючРазмещенияПланНаФакт(СтрокаАгр.Подразделение, СтрокаАгр.ОбщееНазвание));
		СинтСтрока = ТЗ.Добавить();
		СинтСтрока.Подразделение = СтрокаАгр.Подразделение;
		СинтСтрока.Блок = "2. Матеріали";
		СинтСтрока.Категория = ?(Разм = Неопределено, "Виробництво", Разм.Категория);
		СинтСтрока.Этап = ?(Разм = Неопределено, Неопределено, Разм.Этап);
		СинтСтрока.ОбщееНазвание = СтрокаАгр.ОбщееНазвание;
		СинтСтрока.Аналитика = ПустаяНоменклатура;
		СинтСтрока.Работа = ПустаяНоменклатура;
		СинтСтрока.Единица = ПустаяЕдиница;
		СинтСтрока.Документ = ПустойДокумент;
		СинтСтрока.ПланНаФактГрн = ПланНаФакт;
		СинтСтрока.ПрогнозГрн = ПланНаФакт;
		СинтСтрока.ОтклонениеПрогнозГрн = ПланНаФакт;
	КонецЦикла;

КонецПроцедуры

// Строковый ключ (Подразделение, ОбщееНазвание) для карты размещения синт.строк «План на факт».
Функция КлючРазмещенияПланНаФакт(Подразделение, ОбщееНазвание)
	Возврат Строка(Подразделение.УникальныйИдентификатор()) + "|" + Строка(ОбщееНазвание.УникальныйИдентификатор());
КонецФункции

// Соответствие ИМЯ общего названия (нормализованное) -> Структура{Этап, Категория} (макс. этап при нескольких).
// Ключ строковый (не ссылка): дубли ссылок А_ОбщиеНазванияНоменклатуры с одним именем.
// Карта строится по ВСЕМ СС с тем же именем (дубли карточек СС объединяются).
// Категория Вир/Монт вычисляется по имени этапа ТЕМ ЖЕ выражением, что и план (ПОДОБНО "%Монтаж%").
Функция МаппингОбщееНазваниеЭтап(СС)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", СС.Наименование);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.Номенклатура.А_ОбщееНазваниеНоменклатуры.Наименование КАК ОбщееНазвание,
	|	К.Этап КАК Этап,
	|	ВЫБОР КОГДА К.Этап.Наименование ПОДОБНО ""%Монтаж%"" ТОГДА ""Монтаж"" ИНАЧЕ ""Виробництво"" КОНЕЦ КАК Категория
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Комплектующие КАК К
	|ГДЕ
	|	К.Ссылка.Наименование = &Имя
	|	И К.Номенклатура.А_ОбщееНазваниеНоменклатуры <> ЗНАЧЕНИЕ(Справочник.А_ОбщиеНазванияНоменклатуры.ПустаяСсылка)
	|	И К.Этап <> ЗНАЧЕНИЕ(Справочник.А_ЭтапыРабот.ПустаяСсылка)";

	Маппинг = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = СокрЛП(Выборка.ОбщееНазвание);
		Если НЕ ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Текущий = Маппинг.Получить(Ключ);
		Если Текущий = Неопределено ИЛИ Строка(Выборка.Этап) > Строка(Текущий.Этап) Тогда
			Маппинг.Вставить(Ключ, Новый Структура("Этап, Категория", Выборка.Этап, Выборка.Категория));
		КонецЕсли;
	КонецЦикла;
	Возврат Маппинг;

КонецФункции

// Пустая ТЗ грейна (типы колонок = полям внешнего набора "Детали" схемы СКД).
Функция СоздатьПустуюТаблицу()

	ТЗ = Новый ТаблицаЗначений;
	ОписЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписСтрока50 = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50));
	ОписСтрока150 = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(150));
	МассивАналитика = Новый Массив;
	МассивАналитика.Добавить(Тип("СправочникСсылка.Номенклатура"));
	МассивАналитика.Добавить(Тип("СправочникСсылка.ФизическиеЛица"));
	МассивДокумент = Новый Массив;
	МассивДокумент.Добавить(Тип("ДокументСсылка.ПриобретениеТоваровУслуг"));
	МассивДокумент.Добавить(Тип("СправочникСсылка.А_СтруктураСебестоимости"));

	ТЗ.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ТЗ.Колонки.Добавить("Блок", ОписСтрока50);
	ТЗ.Колонки.Добавить("Категория", ОписСтрока50);
	ТЗ.Колонки.Добавить("Этап", Новый ОписаниеТипов("СправочникСсылка.А_ЭтапыРабот"));
	ТЗ.Колонки.Добавить("Работа", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("ОбщееНазвание", Новый ОписаниеТипов("СправочникСсылка.А_ОбщиеНазванияНоменклатуры"));
	ТЗ.Колонки.Добавить("Аналитика", Новый ОписаниеТипов(МассивАналитика));
	ТЗ.Колонки.Добавить("НоменклатураНаименование", ОписСтрока150);
	ТЗ.Колонки.Добавить("Единица", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	ТЗ.Колонки.Добавить("Документ", Новый ОписаниеТипов(МассивДокумент));
	ТЗ.Колонки.Добавить("ПланЧасы", ОписЧисло);
	ТЗ.Колонки.Добавить("ФактЧасы", ОписЧисло);
	ТЗ.Колонки.Добавить("ВиконанняЧасы", ОписЧисло);
	ТЗ.Колонки.Добавить("ПланКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ФактКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ПланГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ФактГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ОтклонениеЧасы", ОписЧисло);
	ТЗ.Колонки.Добавить("ОтклонениеКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ОтклонениеГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ПроцентЧасы", ОписЧисло);
	ТЗ.Колонки.Добавить("ПроцентКол", ОписЧисло);
	ТЗ.Колонки.Добавить("ПроцентГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ОтклонениеВиконання", ОписЧисло);
	ТЗ.Колонки.Добавить("ПроцентВиконання", ОписЧисло);
	ТЗ.Колонки.Добавить("ПланНаФактГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ПрогнозГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ОтклонениеПрогнозГрн", ОписЧисло);
	ТЗ.Колонки.Добавить("ПроцентПрогнозГрн", ОписЧисло);
	Возврат ТЗ;

КонецФункции

Функция ПолучитьЗначениеПараметра(Компоновщик, ИмяПараметра)
	Параметр = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(Компоновщик, ИмяПараметра);
	Возврат ?(Параметр = Неопределено, Неопределено, Параметр.Значение);
КонецФункции

Функция ПолучитьТаблицуКоманд()
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
КонецПроцедуры

#КонецОбласти

