#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	УстановитьПривилегированныйРежим(Истина);

	// Отримання параметрів з СКД
	ПоДням = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПоДням").Значение;
	ПоДокументам = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПоДокументам").Значение;
	ПараметрПериодОтчета = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Период").Значение;
	НачалоПериода = ПараметрПериодОтчета.ДатаНачала;
	КонецПериода = КонецДня(ПараметрПериодОтчета.ДатаОкончания);

	// =============================================
	// 1. ЗАЛИШКИ ERP (Безнал + Готівка)
	// =============================================
	ОстаткиДС_ЕРП = ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода, Ложь);

	ОстаткиДС_ПоДнямЕРП = Новый ТаблицаЗначений;
	Если ПоДням Тогда
		ОстаткиДС_ПоДнямЕРП = ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода, Истина);
	КонецЕсли;

	// =============================================
	// 2. ОБОРОТИ ERP по статтях ДДС
	// =============================================
	ОборотыДДС_ЕРП = ПолучитьОборотыЕРП(НачалоПериода, КонецПериода, Ложь);

	ОборотыДДС_ПоДнямЕРП = Новый ТаблицаЗначений;
	Если ПоДням Тогда
		ОборотыДДС_ПоДнямЕРП = ПолучитьОборотыЕРП(НачалоПериода, КонецПериода, Истина, ПоДокументам);
	КонецЕсли;

	// =============================================
	// 3. ПІДКЛЮЧЕННЯ ДО BuhKazn (COM)
	// =============================================
	СтрокаПодключенияKazna = А_ПодключенияБазСервер.СтрокаПодключения("kazna");
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияKazna));
	Исключение
		Сообщить("Помилка підключення до BuhKazn: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	// =============================================
	// 4. ЗАЛИШКИ КАЗНА
	// =============================================
	ОстаткиДС_Казна = ПолучитьОстаткиКазна(V83, НачалоПериода, КонецПериода, Ложь);

	ОстаткиДС_ПоДнямКазна = Новый ТаблицаЗначений;
	Если ПоДням Тогда
		ОстаткиДС_ПоДнямКазна = ПолучитьОстаткиКазна(V83, НачалоПериода, КонецПериода, Истина);
	КонецЕсли;

	// =============================================
	// 5. ОБОРОТИ КАЗНА по статтях ДДС
	// =============================================
	ОборотыДДС_Казна = ПолучитьОборотыКазна(V83, НачалоПериода, КонецПериода, Ложь);

	ОборотыДДС_ПоДнямКазна = Новый ТаблицаЗначений;
	Если ПоДням Тогда
		ОборотыДДС_ПоДнямКазна = ПолучитьОборотыКазна(V83, НачалоПериода, КонецПериода, Истина, ПоДокументам);
	КонецЕсли;

	// Звільнення COM-з'єднання
	V83 = Неопределено;
	V8 = Неопределено;

	// =============================================
	// 6. ПЕРЕДАЧА В СКД
	// =============================================
	ВнешниеНаборыДанных = Новый Структура(
		"ОстаткиДС_ЕРП, ОстаткиДС_Казна, ОстаткиДС_ПоДнямЕРП, ОстаткиДС_ПоДнямКазна, ОборотыДДС_ЕРП, ОборотыДДС_Казна, ОборотыДДС_ПоДнямЕРП, ОборотыДДС_ПоДнямКазна",
		ОстаткиДС_ЕРП,
		ОстаткиДС_Казна,
		ОстаткиДС_ПоДнямЕРП,
		ОстаткиДС_ПоДнямКазна,
		ОборотыДДС_ЕРП,
		ОборотыДДС_Казна,
		ОборотыДДС_ПоДнямЕРП,
		ОборотыДДС_ПоДнямКазна
	);

	// Формування звіту
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// =============================================================================
// ЗАЛИШКИ ERP (Безналичные + Наличные)
// =============================================================================

Функция ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода, ПоДням)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	ОписаниеТиповДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("БанковскийСчетКасса",
		Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчетаОрганизаций, СправочникСсылка.Кассы"));
	Результат.Колонки.Добавить("ТипДенежныхСредств",
		Новый ОписаниеТипов("ПеречислениеСсылка.ТипыДенежныхСредств"));

	Если ПоДням Тогда
		Результат.Колонки.Добавить("СуммаНачОст_ПоДнямЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаПриход_ПоДнямЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасход_ПоДнямЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаКонОст_ПоДнямЕРП", ТипЧисло);
		Результат.Колонки.Добавить("ПериодДень", ОписаниеТиповДата);
	Иначе
		Результат.Колонки.Добавить("СуммаНачОст_ЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаПриход_ЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасход_ЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаКонОст_ЕРП", ТипЧисло);
	КонецЕсли;
                      
	// --- Безналичные ---
	ЗапросБезнал = Новый Запрос;
	Если ПоДням Тогда
		ЗапросБезнал.Текст =
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ДС.БанковскийСчет.А_СчетДляСверкиПоКазне = ЗНАЧЕНИЕ(Справочник.БанковскиеСчетаОрганизаций.ПустаяСсылка)
		|			ТОГДА ДС.БанковскийСчет
		|		ИНАЧЕ ДС.БанковскийСчет.А_СчетДляСверкиПоКазне
		|	КОНЕЦ КАК БанковскийСчетКасса,
		|	ДС.СуммаНачальныйОстаток КАК СуммаНачОст_ПоДнямЕРП,
		|	ДС.СуммаПриход КАК СуммаПриход_ПоДнямЕРП,
		|	ДС.СуммаРасход КАК СуммаРасход_ПоДнямЕРП,
		|	ДС.СуммаКонечныйОстаток КАК СуммаКонОст_ПоДнямЕРП,
		|	ДС.Период КАК ПериодДень
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваБезналичные.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, День, , ) КАК ДС
		|ГДЕ
		|	НЕ ДС.БанковскийСчет.А_ПоУмолчаниюДляПустыхСчетовИзБухгалтерии";
	Иначе
		ЗапросБезнал.Текст =
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ДС.БанковскийСчет.А_СчетДляСверкиПоКазне = ЗНАЧЕНИЕ(Справочник.БанковскиеСчетаОрганизаций.ПустаяСсылка)
		|			ТОГДА ДС.БанковскийСчет
		|		ИНАЧЕ ДС.БанковскийСчет.А_СчетДляСверкиПоКазне
		|	КОНЕЦ КАК БанковскийСчетКасса,
		|	ДС.СуммаНачальныйОстаток КАК СуммаНачОст_ЕРП,
		|	ДС.СуммаПриход КАК СуммаПриход_ЕРП,
		|	ДС.СуммаРасход КАК СуммаРасход_ЕРП,
		|	ДС.СуммаКонечныйОстаток КАК СуммаКонОст_ЕРП
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваБезналичные.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ) КАК ДС
		|ГДЕ
		|	НЕ ДС.БанковскийСчет.А_ПоУмолчаниюДляПустыхСчетовИзБухгалтерии";
	КонецЕсли;

	ЗапросБезнал.УстановитьПараметр("НачалоПериода", НачалоПериода);
	ЗапросБезнал.УстановитьПараметр("КонецПериода", КонецПериода);

	ВыборкаБезнал = ЗапросБезнал.Выполнить().Выбрать();
	Пока ВыборкаБезнал.Следующий() Цикл
		НС = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НС, ВыборкаБезнал);
		НС.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Безналичные;
	КонецЦикла;

	// --- Наличные ---
	ЗапросНал = Новый Запрос;
	Если ПоДням Тогда
		ЗапросНал.Текст =
		"ВЫБРАТЬ
		|	ДС.Касса КАК БанковскийСчетКасса,
		|	ДС.СуммаНачальныйОстаток КАК СуммаНачОст_ПоДнямЕРП,
		|	ДС.СуммаПриход КАК СуммаПриход_ПоДнямЕРП,
		|	ДС.СуммаРасход КАК СуммаРасход_ПоДнямЕРП,
		|	ДС.СуммаКонечныйОстаток КАК СуммаКонОст_ПоДнямЕРП,
		|	ДС.Период КАК ПериодДень
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваНаличные.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, День, , ) КАК ДС";
	Иначе
		ЗапросНал.Текст =
		"ВЫБРАТЬ
		|	ДС.Касса КАК БанковскийСчетКасса,
		|	ДС.СуммаНачальныйОстаток КАК СуммаНачОст_ЕРП,
		|	ДС.СуммаПриход КАК СуммаПриход_ЕРП,
		|	ДС.СуммаРасход КАК СуммаРасход_ЕРП,
		|	ДС.СуммаКонечныйОстаток КАК СуммаКонОст_ЕРП
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваНаличные.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ) КАК ДС";
	КонецЕсли;

	ЗапросНал.УстановитьПараметр("НачалоПериода", НачалоПериода);
	ЗапросНал.УстановитьПараметр("КонецПериода", КонецПериода);

	ВыборкаНал = ЗапросНал.Выполнить().Выбрать();
	Пока ВыборкаНал.Следующий() Цикл
		НС = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НС, ВыборкаНал);
		НС.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Наличные;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// =============================================================================
// ОБОРОТИ ERP по статтях ДДС (Безналичные + Наличные)
// =============================================================================

Функция ПолучитьОборотыЕРП(НачалоПериода, КонецПериода, ПоДням, ПоДокументам = Ложь)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	ОписаниеТиповДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("СтатьяДДС",
		Новый ОписаниеТипов("СправочникСсылка.СтатьиДвиженияДенежныхСредств"));
	Результат.Колонки.Добавить("Подразделение",
		Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	Результат.Колонки.Добавить("ВидДенежныхСредств",
		Новый ОписаниеТипов("ПеречислениеСсылка.ТипыДенежныхСредств"));

	Если ПоДням И ПоДокументам Тогда
		Результат.Колонки.Добавить("Документ");
	КонецЕсли;

	Если ПоДням Тогда
		Результат.Колонки.Добавить("СуммаПриходОб_ПоДнямЕРП", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасходОб_ПоДнямЕРП", ТипЧисло);
		Результат.Колонки.Добавить("ПериодДеньОб", ОписаниеТиповДата);
	Иначе
		Результат.Колонки.Добавить("СуммаПриход_ЕРП_СтатьяДДС", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасход_ЕРП_СтатьяДДС", ТипЧисло);
	КонецЕсли;

	Запрос = Новый Запрос;

	Если ПоДням Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДвиженияДС.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
		|	НАЧАЛОПЕРИОДА(ДвиженияДС.Период, ДЕНЬ) КАК ПериодДеньОб,
		|	ДвиженияДС.Подразделение КАК Подразделение,
		|	ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Безналичные) КАК ВидДенежныхСредств,
		|	%ДокументВыборка%
		|	СУММА(ВЫБОР
		|			КОГДА ДвиженияДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|				ТОГДА ДвиженияДС.СуммаУпр
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаПриходОб_ПоДнямЕРП,
		|	СУММА(ВЫБОР
		|			КОГДА ДвиженияДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|				ТОГДА ДвиженияДС.СуммаУпр
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаРасходОб_ПоДнямЕРП
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваБезналичные КАК ДвиженияДС
		|ГДЕ
		|	ДвиженияДС.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ДвиженияДС.Активность
		|СГРУППИРОВАТЬ ПО
		|	ДвиженияДС.СтатьяДвиженияДенежныхСредств,
		|	НАЧАЛОПЕРИОДА(ДвиженияДС.Период, ДЕНЬ),
		|	ДвиженияДС.Подразделение
		|	%ДокументГруппировка%
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДвиженияДС.СтатьяДвиженияДенежныхСредств,
		|	НАЧАЛОПЕРИОДА(ДвиженияДС.Период, ДЕНЬ),
		|	ДвиженияДС.Подразделение,
		|	ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Наличные),
		|	%ДокументВыборка2%
		|	СУММА(ВЫБОР
		|			КОГДА ДвиженияДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|				ТОГДА ДвиженияДС.СуммаУпр
		|			ИНАЧЕ 0
		|		КОНЕЦ),
		|	СУММА(ВЫБОР
		|			КОГДА ДвиженияДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|				ТОГДА ДвиженияДС.СуммаУпр
		|			ИНАЧЕ 0
		|		КОНЕЦ)
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваНаличные КАК ДвиженияДС
		|ГДЕ
		|	ДвиженияДС.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ДвиженияДС.Активность
		|СГРУППИРОВАТЬ ПО
		|	ДвиженияДС.СтатьяДвиженияДенежныхСредств,
		|	НАЧАЛОПЕРИОДА(ДвиженияДС.Период, ДЕНЬ),
		|	ДвиженияДС.Подразделение
		|	%ДокументГруппировка%";

		// Підстановка маркерів для документа
		Если ПоДокументам Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ДокументВыборка%",
				"ДвиженияДС.Регистратор КАК Документ,");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ДокументВыборка2%",
				"ДвиженияДС.Регистратор,");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ДокументГруппировка%",
				", ДвиженияДС.Регистратор");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ДокументВыборка%", "");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ДокументВыборка2%", "");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ДокументГруппировка%", "");
		КонецЕсли;
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДвиженияДС.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
		|	ДвиженияДС.Подразделение КАК Подразделение,
		|	ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Безналичные) КАК ВидДенежныхСредств,
		|	СУММА(ВЫБОР
		|			КОГДА ДвиженияДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|				ТОГДА ДвиженияДС.СуммаУпр
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаПриход_ЕРП_СтатьяДДС,
		|	СУММА(ВЫБОР
		|			КОГДА ДвиженияДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|				ТОГДА ДвиженияДС.СуммаУпр
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаРасход_ЕРП_СтатьяДДС
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваБезналичные КАК ДвиженияДС
		|ГДЕ
		|	ДвиженияДС.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ДвиженияДС.Активность
		|
		|СГРУППИРОВАТЬ ПО
		|	ДвиженияДС.СтатьяДвиженияДенежныхСредств,
		|	ДвиженияДС.Подразделение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДвиженияДС.СтатьяДвиженияДенежныхСредств,
		|	ДвиженияДС.Подразделение,
		|	ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Наличные),
		|	СУММА(ВЫБОР
		|			КОГДА ДвиженияДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|				ТОГДА ДвиженияДС.СуммаУпр
		|			ИНАЧЕ 0
		|		КОНЕЦ),
		|	СУММА(ВЫБОР
		|			КОГДА ДвиженияДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|				ТОГДА ДвиженияДС.СуммаУпр
		|			ИНАЧЕ 0
		|		КОНЕЦ)
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваНаличные КАК ДвиженияДС
		|ГДЕ
		|	ДвиженияДС.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ДвиженияДС.Активность
		|
		|СГРУППИРОВАТЬ ПО
		|	ДвиженияДС.СтатьяДвиженияДенежныхСредств,
		|	ДвиженияДС.Подразделение";
	КонецЕсли;

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НС = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Выборка);
	КонецЦикла;

	// Свернути результат (бо ОБЪЕДИНИТЬ ВСЕ може дати дублі по статтях)
	Если ПоДням И ПоДокументам Тогда
		Результат.Свернуть("СтатьяДДС, ПериодДеньОб, Подразделение, ВидДенежныхСредств, Документ", "СуммаПриходОб_ПоДнямЕРП, СуммаРасходОб_ПоДнямЕРП");
	ИначеЕсли ПоДням Тогда
		Результат.Свернуть("СтатьяДДС, ПериодДеньОб, Подразделение, ВидДенежныхСредств", "СуммаПриходОб_ПоДнямЕРП, СуммаРасходОб_ПоДнямЕРП");
	Иначе
		Результат.Свернуть("СтатьяДДС, Подразделение, ВидДенежныхСредств", "СуммаПриход_ЕРП_СтатьяДДС, СуммаРасход_ЕРП_СтатьяДДС");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// =============================================================================
// ЗАЛИШКИ КАЗНА (РегістрНакопичення.ДенежныеСредства)
// =============================================================================

Функция ПолучитьОстаткиКазна(V83, НачалоПериода, КонецПериода, ПоДням)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	ОписаниеТиповДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("БанковскийСчетКасса",
		Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчетаОрганизаций, СправочникСсылка.Кассы"));
	Результат.Колонки.Добавить("ТипДенежныхСредств",
		Новый ОписаниеТипов("ПеречислениеСсылка.ТипыДенежныхСредств"));

	Если ПоДням Тогда
		Результат.Колонки.Добавить("СуммаНачОст_ПоДнямКазна", ТипЧисло);
		Результат.Колонки.Добавить("СуммаПриход_ПоДнямКазна", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасход_ПоДнямКазна", ТипЧисло);
		Результат.Колонки.Добавить("СуммаКонОст_ПоДнямКазна", ТипЧисло);
		Результат.Колонки.Добавить("ПериодДень", ОписаниеТиповДата);
	Иначе
		Результат.Колонки.Добавить("СуммаНачОст_Казна", ТипЧисло);
		Результат.Колонки.Добавить("СуммаПриход_Казна", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасход_Казна", ТипЧисло);
		Результат.Колонки.Добавить("СуммаКонОст_Казна", ТипЧисло);
	КонецЕсли;
	
	Результат.Колонки.Добавить("НомерСчетаКазна", ОбщегоНазначения.ОписаниеТипаСтрока(34));
	
	Запрос = V83.NewObject("Запрос");
	
	Если ПоДням Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
|	ДС.БанковскийСчетКасса КАК БанковскийСчетКасса,
|	ВЫБОР
|		КОГДА ДС.ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДенежныхСредств.Наличные)
|			ТОГДА ""Наличные""
|		ИНАЧЕ ""БезНал""
|	КОНЕЦ КАК ВидДенежныхСредств,
|	ДС.СуммаНачальныйОстаток КАК СуммаНачОст_ПоДнямКазна,
|	ДС.СуммаПриход КАК СуммаПриход_ПоДнямКазна,
|	ДС.СуммаРасход КАК СуммаРасход_ПоДнямКазна,
|	ДС.СуммаКонечныйОстаток КАК СуммаКонОст_ПоДнямКазна,
|	ДС.Период КАК ПериодДень
|ИЗ
|	РегистрНакопления.ДенежныеСредства.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, День, , ) КАК ДС
|ГДЕ
|	(ДС.СуммаНачальныйОстаток <> 0
|			ИЛИ ДС.СуммаПриход <> 0
|			ИЛИ ДС.СуммаРасход <> 0
|			ИЛИ ДС.СуммаКонечныйОстаток <> 0)
|	И (ДС.БанковскийСчетКасса.Владелец ССЫЛКА Справочник.Организации
|				И ДС.БанковскийСчетКасса.Владелец.А_ПереносЕРП
|			ИЛИ ДС.ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДенежныхСредств.Наличные))";   
	Иначе
		Запрос.Текст =
	        "ВЫБРАТЬ
			|	ДС.БанковскийСчетКасса КАК БанковскийСчетКасса,
			|	ВЫБОР
			|		КОГДА ДС.ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДенежныхСредств.Наличные)
			|			ТОГДА ""Наличные""
			|		ИНАЧЕ ""БезНал""
			|	КОНЕЦ КАК ВидДенежныхСредств,
			|	ДС.СуммаНачальныйОстаток КАК СуммаНачОст_Казна,
			|	ДС.СуммаПриход КАК СуммаПриход_Казна,
			|	ДС.СуммаРасход КАК СуммаРасход_Казна,
			|	ДС.СуммаКонечныйОстаток КАК СуммаКонОст_Казна
			|ИЗ
			|	РегистрНакопления.ДенежныеСредства.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ) КАК ДС
			|ГДЕ
|	(ДС.СуммаНачальныйОстаток <> 0
|			ИЛИ ДС.СуммаПриход <> 0
|			ИЛИ ДС.СуммаРасход <> 0
|			ИЛИ ДС.СуммаКонечныйОстаток <> 0)
|	И (ДС.БанковскийСчетКасса.Владелец ССЫЛКА Справочник.Организации
|				И ДС.БанковскийСчетКасса.Владелец.А_ПереносЕРП
|			ИЛИ ДС.ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДенежныхСредств.Наличные))";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	ТЗ = Запрос.Выполнить().Выгрузить();

	// Перечисление видов ДС в Казне
	ПеречислениеБезнал = V83.Перечисления.ВидыДенежныхСредств.Безналичные;

	// Конвертація посилань Казна -> ERP через UUID
	Для Каждого СтрокаТЗ Из ТЗ Цикл
		НС = Результат.Добавить();

		Если ПоДням Тогда
			НС.ПериодДень = СтрокаТЗ.ПериодДень;
			НС.СуммаНачОст_ПоДнямКазна = СтрокаТЗ.СуммаНачОст_ПоДнямКазна;
			НС.СуммаПриход_ПоДнямКазна = СтрокаТЗ.СуммаПриход_ПоДнямКазна;
			НС.СуммаРасход_ПоДнямКазна = СтрокаТЗ.СуммаРасход_ПоДнямКазна;
			НС.СуммаКонОст_ПоДнямКазна = СтрокаТЗ.СуммаКонОст_ПоДнямКазна;
		Иначе
			НС.СуммаНачОст_Казна = СтрокаТЗ.СуммаНачОст_Казна;
			НС.СуммаПриход_Казна = СтрокаТЗ.СуммаПриход_Казна;
			НС.СуммаРасход_Казна = СтрокаТЗ.СуммаРасход_Казна;
			НС.СуммаКонОст_Казна = СтрокаТЗ.СуммаКонОст_Казна;
		КонецЕсли;

		// Зіставлення по UUID (Казна -> ERP), fallback по НомерСчета
		Попытка
              Если СтрокаТЗ.ВидДенежныхСредств = "БезНал" Тогда
			  
			  	 ЭтоБезналичные =  Истина;
			 Иначе
				 ЭтоБезналичные =  Ложь;
 
			  
			  КонецЕсли; 
			Если СтрокаТЗ.БанковскийСчетКасса <> Неопределено Тогда
				Если ЭтоБезналичные  Тогда  
					   НС.НомерСчетаКазна =СокрЛП(СтрокаТЗ.БанковскийСчетКасса.НомерСчета);
					
					
						БанковскийСчетКасса_Код = V83.String(СтрокаТЗ.БанковскийСчетКасса.Код);
						 НайденнаяСсылка = Справочники.БанковскиеСчетаОрганизаций.НайтиПоРеквизиту("А_Код1С",СокрЛП(БанковскийСчетКасса_Код));
					
					// Спроба 1: по UUID
					//НайденнаяСсылка = А_Привилегированный.ПолучитьСправочникUID(
					//	"БанковскиеСчетаОрганизаций",
					//	V83.String(СтрокаТЗ.БанковскийСчетКасса.УникальныйИдентификатор()));
						
						//Если НайденнаяСсылка.ПолучитьОбъект()=Неопределено 
						//И ЗначениеЗаполнено(СтрокаТЗ.БанковскийСчетКасса.Код) Тогда
						// БанковскийСчетКасса_Код = V83.String(СтрокаТЗ.БанковскийСчетКасса.Код);
						// НайденнаяСсылка = Справочники.БанковскиеСчетаОрганизаций.НайтиПоРеквизиту("А_Код1С",СокрЛП(БанковскийСчетКасса_Код));
						//КонецЕсли;
					
					// Спроба 2: по НомерСчета (fallback)
					Если НЕ ЗначениеЗаполнено(НайденнаяСсылка)  
						И ЗначениеЗаполнено(СтрокаТЗ.БанковскийСчетКасса.НомерСчета) Тогда
						НомерСчетаКазна = V83.String(СтрокаТЗ.БанковскийСчетКасса.НомерСчета);
						Если ЗначениеЗаполнено(НомерСчетаКазна) Тогда
							НайденнаяСсылка = НайтиБанковскийСчетПоНомеру(НомерСчетаКазна);
						КонецЕсли;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(НайденнаяСсылка) И ЗначениеЗаполнено(НайденнаяСсылка.А_СчетДляСверкиПоКазне) Тогда
					
					НайденнаяСсылка = НайденнаяСсылка.А_СчетДляСверкиПоКазне;	
					
				КонецЕсли;  
				
				Если НЕ ЗначениеЗаполнено(НайденнаяСсылка) Тогда
					Сообщить("Не найден банковский счет по номеру "+СокрЛП(СтрокаТЗ.БанковскийСчетКасса.НомерСчета));
				КонецЕсли; 
				
					НС.БанковскийСчетКасса = НайденнаяСсылка;
					НС.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Безналичные;
				Иначе
					НС.БанковскийСчетКасса = А_Привилегированный.ПолучитьСправочникUID(
						"Кассы",
						V83.String(СтрокаТЗ.БанковскийСчетКасса.УникальныйИдентификатор()));
					НС.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Наличные;
				КонецЕсли;
			КонецЕсли;
		Исключение
			// Якщо не вдалося знайти відповідність - залишаємо порожню посилку
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// =============================================================================
// ОБОРОТИ КАЗНА по статтях ДДС (РегістрНакопичення.БДДС)
// =============================================================================

Функция ПолучитьОборотыКазна(V83, НачалоПериода, КонецПериода, ПоДням, ПоДокументам = Ложь)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	ОписаниеТиповДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("СтатьяДДС",
		Новый ОписаниеТипов("СправочникСсылка.СтатьиДвиженияДенежныхСредств"));
	Результат.Колонки.Добавить("Подразделение",
		Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	Результат.Колонки.Добавить("ВидДенежныхСредств",
		Новый ОписаниеТипов("ПеречислениеСсылка.ТипыДенежныхСредств"));

	Если ПоДням И ПоДокументам Тогда
		Результат.Колонки.Добавить("Документ");
	КонецЕсли;

	Если ПоДням Тогда
		Результат.Колонки.Добавить("СуммаПриходОб_ПоДнямКазна", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасходОб_ПоДнямКазна", ТипЧисло);
		Результат.Колонки.Добавить("ПериодДеньОб", ОписаниеТиповДата);
	Иначе
		Результат.Колонки.Добавить("СуммаПриход_Казна_СтатьяДДС", ТипЧисло);
		Результат.Колонки.Добавить("СуммаРасход_Казна_СтатьяДДС", ТипЧисло);
	КонецЕсли;

	Запрос = V83.NewObject("Запрос");

	Если ПоДням И ПоДокументам Тогда
		// RAW-запит з Регистратором (бо .Обороты() не має Регистратора)
		Запрос.Текст =
		"ВЫБРАТЬ
		|	БДДС.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
		|	НАЧАЛОПЕРИОДА(БДДС.Период, ДЕНЬ) КАК ПериодДеньОб,
		|	БДДС.Подразделение КАК Подразделение,
		|	БДДС.Направление КАК Направление,
		|	БДДС.ВидОплаты КАК ВидОплаты,
		|	БДДС.Регистратор КАК РегистраторКазна,
		|	СУММА(БДДС.СуммаПриход) КАК СуммаПриходОб_ПоДнямКазна,
		|	СУММА(БДДС.СуммаРасход) КАК СуммаРасходОб_ПоДнямКазна
		|ИЗ
		|	РегистрНакопления.БДДС КАК БДДС
		|ГДЕ
		|	БДДС.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ БДДС.ПланФакт
		|	И БДДС.Активность
		|СГРУППИРОВАТЬ ПО
		|	БДДС.СтатьяДвиженияДенежныхСредств,
		|	НАЧАЛОПЕРИОДА(БДДС.Период, ДЕНЬ),
		|	БДДС.Подразделение,
		|	БДДС.Направление,
		|	БДДС.ВидОплаты,
		|	БДДС.Регистратор";
	ИначеЕсли ПоДням Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	БДДС.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
		|	БДДС.Период КАК ПериодДеньОб,
		|	БДДС.Подразделение КАК Подразделение,
		|	БДДС.Направление КАК Направление,
		|	БДДС.ВидОплаты КАК ВидОплаты,
		|	БДДС.СуммаПриходОборот КАК СуммаПриходОб_ПоДнямКазна,
		|	БДДС.СуммаРасходОборот КАК СуммаРасходОб_ПоДнямКазна
		|ИЗ
		|	РегистрНакопления.БДДС.Обороты(&НачалоПериода, &КонецПериода, День, ПланФакт = ЛОЖЬ) КАК БДДС";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	БДДС.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
		|	БДДС.Подразделение КАК Подразделение,
		|	БДДС.Направление КАК Направление,
		|	БДДС.ВидОплаты КАК ВидОплаты,
		|	БДДС.СуммаПриходОборот КАК СуммаПриход_Казна_СтатьяДДС,
		|	БДДС.СуммаРасходОборот КАК СуммаРасход_Казна_СтатьяДДС
		|ИЗ
		|	РегистрНакопления.БДДС.Обороты(&НачалоПериода, &КонецПериода, , ПланФакт = ЛОЖЬ) КАК БДДС";
	КонецЕсли;

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	ТЗ = Запрос.Выполнить().Выгрузить();

	// Конвертація посилань Казна -> ERP через UUID
	Для Каждого СтрокаТЗ Из ТЗ Цикл
		НС = Результат.Добавить();

		Если ПоДням Тогда
			НС.ПериодДеньОб = СтрокаТЗ.ПериодДеньОб;
			НС.СуммаПриходОб_ПоДнямКазна = СтрокаТЗ.СуммаПриходОб_ПоДнямКазна;
			НС.СуммаРасходОб_ПоДнямКазна = СтрокаТЗ.СуммаРасходОб_ПоДнямКазна;
		Иначе
			НС.СуммаПриход_Казна_СтатьяДДС = СтрокаТЗ.СуммаПриход_Казна_СтатьяДДС;
			НС.СуммаРасход_Казна_СтатьяДДС = СтрокаТЗ.СуммаРасход_Казна_СтатьяДДС;
		КонецЕсли;

		// Зіставлення статті ДДС по UUID
		Попытка
			Если СтрокаТЗ.СтатьяДДС <> Неопределено Тогда
				//НС.СтатьяДДС = А_Привилегированный.ПолучитьСправочникUID(
				//	"СтатьиДвиженияДенежныхСредств",
				//	V83.String(СтрокаТЗ.СтатьяДДС.УникальныйИдентификатор()));
				//КонецЕсли; 
				
				СтатьяДДСКазна = Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
 
				КодСтатьяДДС = V83.String(СтрокаТЗ.СтатьяДДС.Код);
					Если ЗначениеЗаполнено(КодСтатьяДДС) Тогда
						СтатьяДДСКазна = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду(СокрЛП(КодСтатьяДДС));
					КонецЕсли;
				//КонецЕсли; 
				
				Если НЕ ЗначениеЗаполнено(СтатьяДДСКазна) Тогда
					НаименованиеСтатьяДДС = V83.String(СтрокаТЗ.СтатьяДДС.Наименование);
					Если ЗначениеЗаполнено(НаименованиеСтатьяДДС) Тогда
						СтатьяДДСКазна = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию(СокрЛП(НаименованиеСтатьяДДС));
					КонецЕсли;   
				КонецЕсли;

			НС.СтатьяДДС = СтатьяДДСКазна;
			КонецЕсли;

		Исключение
			// Якщо не вдалося знайти відповідність
		КонецПопытки;

		// Зіставлення підрозділу через Направление + ПодразделениеКазна
		Попытка
			ПодразделениеКазна = Неопределено;
			НаправлениеДеятельности = Неопределено;

			// 1. Маппінг підрозділу Казна -> ERP.СтруктураПредприятия
			Если СтрокаТЗ.Подразделение <> Неопределено Тогда 
				ПодразделениеКазна = Справочники.СтруктураПредприятия.ПустаяСсылка();
				//ПодразделениеКазна = А_Привилегированный.ПолучитьСправочникUID(
				//	"СтруктураПредприятия",
				//	V83.String(СтрокаТЗ.Подразделение.УникальныйИдентификатор()));
				//Если НЕ ЗначениеЗаполнено(ПодразделениеКазна) Тогда
					КодПодразделения = V83.String(СтрокаТЗ.Подразделение.Код);
					Если ЗначениеЗаполнено(КодПодразделения) Тогда
						ПодразделениеКазна = Справочники.СтруктураПредприятия.НайтиПоКоду(СокрЛП(КодПодразделения));
					КонецЕсли;
				//КонецЕсли; 
				
				Если НЕ ЗначениеЗаполнено(ПодразделениеКазна) Тогда
					НаименованиеПодразделение = V83.String(СтрокаТЗ.Подразделение.Наименование);
					Если ЗначениеЗаполнено(НаименованиеПодразделение) Тогда
						ПодразделениеКазна = Справочники.СтруктураПредприятия.НайтиПоНаименованию(СокрЛП(НаименованиеПодразделение));
					КонецЕсли;   
				КонецЕсли;

			КонецЕсли;

			// 2. Маппінг напрямку Казна.Направления -> ERP.НаправленияДеятельности
			Если СтрокаТЗ.Направление <> Неопределено Тогда 
				НаправлениеДеятельности = Справочники.НаправленияДеятельности.ПустаяСсылка();
				//НаправлениеДеятельности = А_Привилегированный.ПолучитьСправочникUID(
				//	"НаправленияДеятельности",
				//	V83.String(СтрокаТЗ.Направление.УникальныйИдентификатор())); 

				Если НЕ ЗначениеЗаполнено(НаправлениеДеятельности) Тогда
					КодНаправления = V83.String(СтрокаТЗ.Направление.Код);
					Если ЗначениеЗаполнено(КодНаправления) Тогда
						НаправлениеДеятельности = Справочники.НаправленияДеятельности.НайтиПоКоду(СокрЛП(КодНаправления));
					КонецЕсли; 
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(НаправлениеДеятельности) Тогда
					НаименованиеНаправления = V83.String(СтрокаТЗ.Направление.Наименование);
					Если ЗначениеЗаполнено(КодНаправления) Тогда
						НаправлениеДеятельности = Справочники.НаправленияДеятельности.НайтиПоНаименованию(СокрЛП(НаименованиеНаправления));
					КонецЕсли;   
				КонецЕсли;

			КонецЕсли;

			// 3. Визначення фінального підрозділу
			Если ЗначениеЗаполнено(ПодразделениеКазна) И ЗначениеЗаполнено(НаправлениеДеятельности) Тогда
				НС.Подразделение = А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны(
					НаправлениеДеятельности, ПодразделениеКазна);
			ИначеЕсли ЗначениеЗаполнено(ПодразделениеКазна) Тогда
				НС.Подразделение = ПодразделениеКазна;
			КонецЕсли;
		Исключение
			// Якщо не вдалося знайти відповідність підрозділу
		КонецПопытки;

		// Зіставлення ВидОплаты -> ТипыДенежныхСредств
		Попытка
			Если СтрокаТЗ.ВидОплаты <> Неопределено Тогда
				ВидОплатыСтрока = V83.String(СтрокаТЗ.ВидОплаты);
				Если Найти(ВидОплатыСтрока, "Безналичные") > 0 Тогда
					НС.ВидДенежныхСредств = Перечисления.ТипыДенежныхСредств.Безналичные;
				ИначеЕсли Найти(ВидОплатыСтрока, "Наличные") > 0 Тогда
					НС.ВидДенежныхСредств = Перечисления.ТипыДенежныхСредств.Наличные;
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;

		// Маппінг документа Казна → ERP (тільки коли ПоДокументам)
		Если ПоДням И ПоДокументам Тогда
			Попытка
				ДокументЗначение = Неопределено;
				Если СтрокаТЗ.РегистраторКазна <> Неопределено Тогда
					// 1. Отримати UUID документа Казна
					УИДКазна = V83.String(СтрокаТЗ.РегистраторКазна.УникальныйИдентификатор());

					// 2. Пошук в СоответствияОбъектовИнформационныхБаз
					ЗапросСоотв = Новый Запрос;
					ЗапросСоотв.Текст =
					"ВЫБРАТЬ ПЕРВЫЕ 1
					|	Соотв.УникальныйИдентификаторИсточника КАК ДокументERP
					|ИЗ
					|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соотв
					|ГДЕ
					|	Соотв.УникальныйИдентификаторПриемника = &УИДКазна";
					ЗапросСоотв.УстановитьПараметр("УИДКазна", УИДКазна);
					РезСоотв = ЗапросСоотв.Выполнить();

					Если НЕ РезСоотв.Пустой() Тогда
						ВыбСоотв = РезСоотв.Выбрать();
						ВыбСоотв.Следующий();
						Если ЗначениеЗаполнено(ВыбСоотв.ДокументERP) Тогда
							ДокументЗначение = ВыбСоотв.ДокументERP;
						КонецЕсли;
					КонецЕсли;

					// 3. Fallback: текстове представлення документа Казна
					Если ДокументЗначение = Неопределено Тогда
						ТипДок = V83.String(СтрокаТЗ.РегистраторКазна.Метаданные().Имя);
						НомерДок = V83.String(СтрокаТЗ.РегистраторКазна.Номер);
						ДатаДок = СтрокаТЗ.РегистраторКазна.Дата;
						ДокументЗначение = СтрШаблон("%1 %2 від %3 (Казна)",
							ТипДок, СокрЛП(НомерДок), Формат(ДатаДок, "ДФ=dd.MM.yyyy"));
					КонецЕсли;
				КонецЕсли;
				НС.Документ = ДокументЗначение;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// =============================================================================
// Пошук БанковскиеСчетаОрганизаций по НомерСчета (fallback)
// =============================================================================

Функция НайтиБанковскийСчетПоНомеру(НомерСчета)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	БС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчетаОрганизаций КАК БС
	|ГДЕ
	|	БС.НомерСчета = &НомерСчета
	|	И НЕ БС.А_НеИспользовать
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	БС.Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчетаОрганизаций КАК БС
	|ГДЕ
	|	БС.А_НомерСчетаКазна = &НомерСчета
	|	И НЕ БС.А_НеИспользовать";

	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);

	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.БанковскиеСчетаОрганизаций.ПустаяСсылка();

КонецФункции

#КонецОбласти

#КонецЕсли
