{
  "dataSets": [{
    "name": "Данные",
    "query": "@А_ОтчетПоСтатьямPL_ДДС_СтатьямРасходам.query.sql",
    "fields": [
      { "field": "ГруппаPL", "type": "CatalogRef.А_ГруппаСтатей_PL", "title": "Группа PL", "role": "dimension" },
      { "field": "ГруппаСорт", "type": "decimal(10,0)", "title": "Сорт группы" },
      { "field": "СтатьяPL", "type": "CatalogRef.А_Статьи_PL", "title": "Статья PL (где стоит статья денег)", "role": "dimension" },
      { "field": "КодPL", "type": "string(9)", "title": "Код PL" },
      { "field": "СортPL", "type": "decimal(10,0)", "title": "Сорт статьи PL" },
      { "field": "ТипСтатьи", "type": "EnumRef.А_ТипСтатьиPL", "title": "Тип статьи" },
      { "field": "ДДС", "type": "CatalogRef.СтатьиДвиженияДенежныхСредств", "title": "Статья денег (ДДС)", "role": "dimension" },
      { "field": "СтатьяЗатрат", "type": "ChartOfCharacteristicTypesRef.СтатьиРасходов", "title": "Статья затрат", "role": "dimension" },
      { "field": "ВидСвязи", "type": "string(40)", "title": "Связь" },
      { "field": "ДДСФакта", "type": "CatalogRef.СтатьиДвиженияДенежныхСредств", "title": "Статья денег у статьи затрат (по ней идёт факт)" },
      { "field": "PLФакта", "type": "CatalogRef.А_Статьи_PL", "title": "PL, куда уйдёт факт затрат" },
      { "field": "СтатейДенегУЗатрат", "type": "decimal(5,0)", "title": "Статей денег у статьи затрат" },
      { "field": "СтатейЗатратУДенег", "type": "decimal(5,0)", "title": "Статей затрат у статьи денег" },
      { "field": "ПроблемаЗатрат", "type": "decimal(5,0)", "title": "Статья затрат ↔ 2+ статей денег" },
      { "field": "ПроблемаДенег", "type": "decimal(5,0)", "title": "Статья денег ↔ 2+ статей затрат" },
      { "field": "ФактВнеPL", "type": "decimal(5,0)", "title": "Факт затрат вне PL" },
      { "field": "ФактВДругойPL", "type": "decimal(5,0)", "title": "Факт затрат в другой PL" },
      { "field": "НетСтатьиЗатрат", "type": "decimal(5,0)", "title": "Нет статьи затрат (расходная PL)" },
      { "field": "Проблем", "type": "decimal(5,0)", "title": "Проблем" },
      { "field": "Строк", "type": "decimal(5,0)", "title": "Строк" }
    ]
  }],
  "totalFields": [
    { "dataPath": "ГруппаСорт", "expression": "Максимум(ГруппаСорт)" },
    { "dataPath": "СортPL", "expression": "Максимум(СортPL)" },
    { "dataPath": "СтатейДенегУЗатрат", "expression": "Максимум(СтатейДенегУЗатрат)" },
    { "dataPath": "СтатейЗатратУДенег", "expression": "Максимум(СтатейЗатратУДенег)" },
    { "dataPath": "ПроблемаЗатрат", "expression": "Сумма(ПроблемаЗатрат)" },
    { "dataPath": "ПроблемаДенег", "expression": "Сумма(ПроблемаДенег)" },
    { "dataPath": "ФактВнеPL", "expression": "Сумма(ФактВнеPL)" },
    { "dataPath": "ФактВДругойPL", "expression": "Сумма(ФактВДругойPL)" },
    { "dataPath": "НетСтатьиЗатрат", "expression": "Сумма(НетСтатьиЗатрат)" },
    { "dataPath": "Проблем", "expression": "Сумма(Проблем)" },
    { "dataPath": "Строк", "expression": "Сумма(Строк)" }
  ],
  "settingsVariants": [
    {
      "name": "ПоСтатьямPL",
      "title": "По статьям PL: группа → статья PL → статьи денег и затрат",
      "settings": {
        "selection": ["ДДС", "СтатьяЗатрат", "ВидСвязи", "ДДСФакта", "PLФакта", "СтатейДенегУЗатрат", "СтатейЗатратУДенег", "Проблем"],
        "conditionalAppearance": [
          { "filter": ["Проблем > 0"], "appearance": { "ЦветФона": "web:MistyRose" }, "presentation": "Строка/группа с проблемой" },
          { "selection": ["СтатьяЗатрат", "СтатейДенегУЗатрат"], "filter": ["СтатейДенегУЗатрат >= 2"], "appearance": { "ЦветФона": "web:LightCoral" }, "presentation": "Статья затрат связана с 2+ статьями денег" },
          { "selection": ["ДДС", "СтатейЗатратУДенег"], "filter": ["СтатейЗатратУДенег >= 2"], "appearance": { "ЦветФона": "web:LightCoral" }, "presentation": "Статья денег связана с 2+ статьями затрат" },
          { "selection": ["ДДСФакта", "PLФакта"], "filter": ["ФактВДругойPL >= 1"], "appearance": { "ЦветФона": "web:Orange" }, "presentation": "Факт затрат уйдёт в другую PL, чем деньги" },
          { "selection": ["ДДСФакта", "PLФакта"], "filter": ["ФактВнеPL >= 1"], "appearance": { "ЦветФона": "web:Khaki" }, "presentation": "Факт затрат не попадёт ни в одну PL" },
          { "selection": ["СтатьяЗатрат", "ВидСвязи"], "filter": ["НетСтатьиЗатрат >= 1"], "appearance": { "ЦветФона": "web:Khaki" }, "presentation": "У статьи денег расходной PL нет статьи затрат" }
        ],
        "outputParameters": { "Заголовок": "Статьи денег ↔ статьи затрат по справочнику PL. Красным — связь 1:N, оранжевым — факт уходит в другую PL, жёлтым — нет связи" },
        "structure": [
          {
            "groupFields": ["ГруппаPL"],
            "order": ["ГруппаСорт", "Auto"],
            "children": [
              {
                "groupFields": ["СтатьяPL"],
                "order": ["СортPL", "Auto"],
                "children": [ { "groupFields": [], "order": ["ДДС", "СтатьяЗатрат"] } ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "ПоСтатьямЗатрат",
      "title": "По статьям затрат: статья затрат → её статьи денег и PL",
      "settings": {
        "selection": ["СтатьяPL", "ДДС", "ВидСвязи", "ДДСФакта", "PLФакта", "СтатейДенегУЗатрат", "СтатейЗатратУДенег", "Проблем"],
        "filter": ["СтатьяЗатрат filled"],
        "conditionalAppearance": [
          { "filter": ["Проблем > 0"], "appearance": { "ЦветФона": "web:MistyRose" }, "presentation": "Строка/группа с проблемой" },
          { "selection": ["СтатьяЗатрат", "СтатейДенегУЗатрат"], "filter": ["СтатейДенегУЗатрат >= 2"], "appearance": { "ЦветФона": "web:LightCoral" }, "presentation": "Статья затрат связана с 2+ статьями денег" },
          { "selection": ["ДДС", "СтатейЗатратУДенег"], "filter": ["СтатейЗатратУДенег >= 2"], "appearance": { "ЦветФона": "web:LightCoral" }, "presentation": "Статья денег связана с 2+ статьями затрат" },
          { "selection": ["ДДСФакта", "PLФакта"], "filter": ["ФактВДругойPL >= 1"], "appearance": { "ЦветФона": "web:Orange" }, "presentation": "Факт затрат уйдёт в другую PL, чем деньги" },
          { "selection": ["ДДСФакта", "PLФакта"], "filter": ["ФактВнеPL >= 1"], "appearance": { "ЦветФона": "web:Khaki" }, "presentation": "Факт затрат не попадёт ни в одну PL" },
          { "selection": ["СтатьяЗатрат", "ВидСвязи"], "filter": ["НетСтатьиЗатрат >= 1"], "appearance": { "ЦветФона": "web:Khaki" }, "presentation": "У статьи денег расходной PL нет статьи затрат" }
        ],
        "outputParameters": { "Заголовок": "Статьи затрат → статьи денег (в области справочника PL). Красным — 1:N, оранжевым — факт в другой PL" },
        "structure": [
          {
            "groupFields": ["СтатьяЗатрат"],
            "order": ["СтатейДенегУЗатрат desc", "Auto"],
            "children": [ { "groupFields": [], "order": ["СтатьяPL", "ДДС"] } ]
          }
        ]
      }
    },
    {
      "name": "ПоСтатьямДенег",
      "title": "По статьям денег: статья денег → её статьи затрат и PL",
      "settings": {
        "selection": ["СтатьяPL", "СтатьяЗатрат", "ВидСвязи", "ДДСФакта", "PLФакта", "СтатейДенегУЗатрат", "СтатейЗатратУДенег", "Проблем"],
        "conditionalAppearance": [
          { "filter": ["Проблем > 0"], "appearance": { "ЦветФона": "web:MistyRose" }, "presentation": "Строка/группа с проблемой" },
          { "selection": ["СтатьяЗатрат", "СтатейДенегУЗатрат"], "filter": ["СтатейДенегУЗатрат >= 2"], "appearance": { "ЦветФона": "web:LightCoral" }, "presentation": "Статья затрат связана с 2+ статьями денег" },
          { "selection": ["ДДС", "СтатейЗатратУДенег"], "filter": ["СтатейЗатратУДенег >= 2"], "appearance": { "ЦветФона": "web:LightCoral" }, "presentation": "Статья денег связана с 2+ статьями затрат" },
          { "selection": ["ДДСФакта", "PLФакта"], "filter": ["ФактВДругойPL >= 1"], "appearance": { "ЦветФона": "web:Orange" }, "presentation": "Факт затрат уйдёт в другую PL, чем деньги" },
          { "selection": ["ДДСФакта", "PLФакта"], "filter": ["ФактВнеPL >= 1"], "appearance": { "ЦветФона": "web:Khaki" }, "presentation": "Факт затрат не попадёт ни в одну PL" },
          { "selection": ["СтатьяЗатрат", "ВидСвязи"], "filter": ["НетСтатьиЗатрат >= 1"], "appearance": { "ЦветФона": "web:Khaki" }, "presentation": "У статьи денег расходной PL нет статьи затрат" }
        ],
        "outputParameters": { "Заголовок": "Статьи денег → статьи затрат (в области справочника PL). Красным — 1:N, оранжевым — факт в другой PL" },
        "structure": [
          {
            "groupFields": ["ДДС"],
            "order": ["СтатейЗатратУДенег desc", "Auto"],
            "children": [ { "groupFields": [], "order": ["СтатьяЗатрат"] } ]
          }
        ]
      }
    }
  ]
}
