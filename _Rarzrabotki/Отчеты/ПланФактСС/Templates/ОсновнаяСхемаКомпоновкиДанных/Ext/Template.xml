////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СводнаяТаблица.Подразделение КАК Подразделение,
	СводнаяТаблица.ОбщееНазвание КАК ОбщееНазвание,
	СводнаяТаблица.Номенклатура КАК Номенклатура,
	СводнаяТаблица.Единица КАК Единица,
	СУММА(СводнаяТаблица.КоличествоСС) КАК КоличествоСС,
	СУММА(СводнаяТаблица.СуммаСС) КАК СуммаСС,
	СУММА(СводнаяТаблица.Количество) КАК Количество,
	СУММА(СводнаяТаблица.Сумма) КАК Сумма,
	СУММА(СводнаяТаблица.Количество) - СУММА(СводнаяТаблица.КоличествоСС) КАК РазницаКоличество,
	СУММА(СводнаяТаблица.Сумма) - СУММА(СводнаяТаблица.СуммаСС) КАК РазницаСумма,
	ВЫБОР
		КОГДА СУММА(СводнаяТаблица.КоличествоСС) = 0
			ТОГДА NULL
		ИНАЧЕ (СУММА(СводнаяТаблица.Количество) - СУММА(СводнаяТаблица.КоличествоСС)) / СУММА(СводнаяТаблица.КоличествоСС) * 100
	КОНЕЦ КАК ПроцентОтклонениеКол,
	ВЫБОР
		КОГДА СУММА(СводнаяТаблица.СуммаСС) = 0
			ТОГДА NULL
		ИНАЧЕ (СУММА(СводнаяТаблица.Сумма) - СУММА(СводнаяТаблица.СуммаСС)) / СУММА(СводнаяТаблица.СуммаСС) * 100
	КОНЕЦ КАК ПроцентОтклонениеСум
ИЗ
	Сводная КАК СводнаяТаблица

СГРУППИРОВАТЬ ПО
	СводнаяТаблица.Подразделение,
	СводнаяТаблица.ОбщееНазвание,
	СводнаяТаблица.Номенклатура,
	СводнаяТаблица.Единица

