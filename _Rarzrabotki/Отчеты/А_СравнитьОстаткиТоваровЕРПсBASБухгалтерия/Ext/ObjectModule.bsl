#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	УстановитьПривилегированныйРежим(Истина);

	// Отримання параметрів з СКД
	ПоДням = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПоДням").Значение;
	Склад = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Склад").Значение;
	Номенклатура = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Номенклатура").Значение;
	ПоДокументам = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПоДокументам").Значение;

	ПараметрПериодОтчета = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Период").Значение;
	НачалоПериода = ПараметрПериодОтчета.ДатаНачала;
	КонецПериода = КонецДня(ПараметрПериодОтчета.ДатаОкончания);

	// =============================================
	// 1. ЗАЛИШКИ ERP (РегістрНакопления.ТоварыНаСкладах)
	// =============================================
	ТаблицаТовары_ЕРП = ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода, Ложь, Номенклатура, Склад);

	ТаблицаТовары_ПоДнямЕРП = Новый ТаблицаЗначений;
	Если ПоДням Тогда
		ТаблицаТовары_ПоДнямЕРП = ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода, Истина, Номенклатура, Склад);
	КонецЕсли;

	Товары_ПоДокументаммЕРП = Новый ТаблицаЗначений;
	Если ПоДокументам Тогда
		Товары_ПоДокументаммЕРП = ПолучитьОстаткиЕРППоДокументам(НачалоПериода, КонецПериода, Номенклатура, Склад);
	КонецЕсли;

	// =============================================
	// 2. ЗАЛИШКИ BUHBUD (COM + РегБух.Хозрасчетный)
	//    Рахунки: 281 (Товары), 20x (ПроизводственныеЗапасы),
	//             26 (ГотоваяПродукция), 22x (МБП)
	//    ОНОВЛЕНО: Динамічне визначення позиції субконто через ВидыСубконто!
	// =============================================
	СтрокаПодключенияBuhBud = А_ПодключенияБазСервер.СтрокаПодключения("BuhBud");
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияBuhBud));
	Исключение
		Сообщить("Помилка підключення до BuhBud: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ТаблицаТовары_УПП = ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода, Ложь, Номенклатура, Склад);

	ТаблицаТовары_ПоДнямУПП = Новый ТаблицаЗначений;
	Если ПоДням Тогда
		ТаблицаТовары_ПоДнямУПП = ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода, Истина, Номенклатура, Склад);
	КонецЕсли;

	Товары_ПоДокументамУПП = Новый ТаблицаЗначений;
	// Примітка: режим "по документах" для BuhBud потребує окремої реалізації
	// через регістри бухгалтерії, що є складнішим завданням

	// Звільнення COM-з'єднання
	V83 = Неопределено;
	V8 = Неопределено;

	// =============================================
	// 3. ПЕРЕДАЧА В СКД
	// =============================================
	ВнешниеНаборыДанных = Новый Структура(
		"Товары_ЕРП, Товары_УПП, Товары_ПоДнямЕРП, Товары_ПоДнямУПП, Товары_ПоДокументаммЕРП, Товары_ПоДокументамУПП",
		ТаблицаТовары_ЕРП,
		ТаблицаТовары_УПП,
		ТаблицаТовары_ПоДнямЕРП,
		ТаблицаТовары_ПоДнямУПП,
		Товары_ПоДокументаммЕРП,
		Товары_ПоДокументамУПП
	);

	// Формування звіту
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отримання залишків з ERP (РегістрНакопления.ТоварыНаСкладах)
//
// Параметри:
//  НачалоПериода - Дата - початок періоду
//  КонецПериода - Дата - кінець періоду
//  ПоДням - Булево - якщо Істина, то розбивка по днях
//  Номенклатура - СправочникСсылка.Номенклатура - фільтр по номенклатурі
//  Склад - СправочникСсылка.Склады - фільтр по складу
//
// Повертає:
//  ТаблицяЗначень - таблиця з залишками
//
Функция ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода, ПоДням, Номенклатура = Неопределено, Склад = Неопределено)

	Запрос = Новый Запрос;

	Если ПоДням Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТоварыНаСкладахОстаткиИОбороты.Номенклатура КАК Номенклатура,
		|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииНачальныйОстаток КАК КоличествоНачальныйОстаток_ПоДнямЕРП,
		|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииПриход КАК КоличествоПриход_ПоДнямЕРП,
		|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииРасход КАК КоличествоРасход_ПоДнямЕРП,
		|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииКонечныйОстаток КАК КоличествоКонечныйОстаток_ПоДнямЕРП,
		|	ТоварыНаСкладахОстаткиИОбороты.Склад КАК Склад,
		|	ТоварыНаСкладахОстаткиИОбороты.Период КАК ПериодДень
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			День,
		|			,
		|			(&ФильтрНоменклатура ИЛИ Номенклатура = &Номенклатура)
		|				И (&ФильтрСклад ИЛИ Склад = &Склад)) КАК ТоварыНаСкладахОстаткиИОбороты";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТоварыНаСкладахОстаткиИОбороты.Номенклатура КАК Номенклатура,
		|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииНачальныйОстаток КАК КоличествоНачальныйОстаток_ЕРП,
		|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииПриход КАК КоличествоПриход_ЕРП,
		|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииРасход КАК КоличествоРасход_ЕРП,
		|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииКонечныйОстаток КАК КоличествоКонечныйОстаток_ЕРП,
		|	ТоварыНаСкладахОстаткиИОбороты.Склад КАК Склад
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			,
		|			,
		|			(&ФильтрНоменклатура ИЛИ Номенклатура = &Номенклатура)
		|				И (&ФильтрСклад ИЛИ Склад = &Склад)) КАК ТоварыНаСкладахОстаткиИОбороты";
	КонецЕсли;

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ФильтрНоменклатура", НЕ ЗначениеЗаполнено(Номенклатура));
	Запрос.УстановитьПараметр("ФильтрСклад", НЕ ЗначениеЗаполнено(Склад));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Отримання залишків з ERP по документах
//
Функция ПолучитьОстаткиЕРППоДокументам(НачалоПериода, КонецПериода, Номенклатура = Неопределено, Склад = Неопределено)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыНаСкладахОстаткиИОбороты.Номенклатура КАК Номенклатура,
	|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииПриход КАК КоличествоПриход_ПоДокументамЕРП,
	|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииРасход КАК КоличествоРасход_ПоДокументамЕРП,
	|	ТоварыНаСкладахОстаткиИОбороты.Склад КАК Склад,
	|	ТоварыНаСкладахОстаткиИОбороты.Регистратор КАК ДокументДвижения,
	|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииПриход - ТоварыНаСкладахОстаткиИОбороты.ВНаличииРасход КАК КоличествоОборот_ПоДокументамЕРП,
	|	ПРЕДСТАВЛЕНИЕ(ТоварыНаСкладахОстаткиИОбороты.Регистратор) КАК ДокументДвиженияПредставление
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Авто,
	|			,
	|			(&ФильтрНоменклатура ИЛИ Номенклатура = &Номенклатура)
	|				И (&ФильтрСклад ИЛИ Склад = &Склад)) КАК ТоварыНаСкладахОстаткиИОбороты";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ФильтрНоменклатура", НЕ ЗначениеЗаполнено(Номенклатура));
	Запрос.УстановитьПараметр("ФильтрСклад", НЕ ЗначениеЗаполнено(Склад));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Отримання залишків з BuhBud через COM (РегістрБухгалтерії.Хозрасчетный)
// Рахунки: 281 (Товары), 20x (ПроизводственныеЗапасы), 26 (ГотоваяПродукция), 22x (МБП)
//
// ОНОВЛЕНО: Використовує динамічне визначення позиції субконто через
//           соединение з ПланСчетов.Хозрасчетный.ВидыСубконто!
//           Це дозволяє правильно працювати з рахунками де субконто
//           Номенклатура/Склад знаходяться на різних позиціях.
//
// Параметри:
//  V83 - COMОбъект - підключення до BuhBud
//  НачалоПериода - Дата - початок періоду
//  КонецПериода - Дата - кінець періоду
//  ПоДням - Булево - якщо Істина, то розбивка по днях
//  Номенклатура - СправочникСсылка.Номенклатура - фільтр по номенклатурі (для отримання А_ИдКод)
//  Склад - СправочникСсылка.Склады - фільтр по складу (для отримання А_ИдКод)
//
// Повертає:
//  ТаблицяЗначень - таблиця з залишками (з конвертованими посиланнями)
//
Функция ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода, ПоДням, Номенклатура = Неопределено, Склад = Неопределено)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 3);
	ОписаниеТиповДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура",
		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Склад",
		Новый ОписаниеТипов("СправочникСсылка.Склады"));

	Если ПоДням Тогда
		Результат.Колонки.Добавить("КоличествоНачальныйОстаток_ПоДнямУПП", ТипЧисло);
		Результат.Колонки.Добавить("КоличествоПриход_ПоДнямУПП", ТипЧисло);
		Результат.Колонки.Добавить("КоличествоРасход_ПоДнямУПП", ТипЧисло);
		Результат.Колонки.Добавить("КоличествоКонечныйОстаток_ПоДнямУПП", ТипЧисло);
		Результат.Колонки.Добавить("ПериодДень", ОписаниеТиповДата);
	Иначе
		Результат.Колонки.Добавить("КоличествоНачальныйОстаток_УПП", ТипЧисло);
		Результат.Колонки.Добавить("КоличествоПриход_УПП", ТипЧисло);
		Результат.Колонки.Добавить("КоличествоРасход_УПП", ТипЧисло);
		Результат.Колонки.Добавить("КоличествоКонечныйОстаток_УПП", ТипЧисло);
	КонецЕсли;

	// Підготовка параметрів фільтрації - використовуємо А_ИдКод!
	НоменклатураИдКод = "";
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		НоменклатураИдКод = СокрЛП(Номенклатура.А_ИдКод);
	КонецЕсли;

	СкладИдКод = "";
	Если ЗначениеЗаполнено(Склад) Тогда
		СкладИдКод = СокрЛП(Склад.А_ИдКод);
	КонецЕсли;
	
	
		ЗапросОрганизаций = Новый Запрос;
	ЗапросОрганизаций.Текст =
	"ВЫБРАТЬ
	|	Организации.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.А_ВБалансе = ИСТИНА
	|	И Организации.КодПоЕДРПОУ <> """"";

	масКодПоЕДРПОУ = Новый Массив;
	ВыборкаОрганизаций = ЗапросОрганизаций.Выполнить().Выбрать();
	Пока ВыборкаОрганизаций.Следующий() Цикл
		масКодПоЕДРПОУ.Добавить(ВыборкаОрганизаций.КодПоЕДРПОУ);
	КонецЦикла;

	Если масКодПоЕДРПОУ.Количество() = 0 Тогда
		Сообщить("Немає організацій з флагом А_ВБалансе!");
		Возврат Неопределено;
	КонецЕсли;

	Запрос = V83.NewObject("Запрос");
	
		масКодПоЕДРПОУ_V83 = V83.NewObject("Массив");
	Для Каждого КодЕДРПОУ Из масКодПоЕДРПОУ Цикл
		масКодПоЕДРПОУ_V83.Добавить(КодЕДРПОУ);
	КонецЦикла;

	// =====================================================================
	// НОВИЙ ЗАПИТ з динамічним визначенням позиції субконто!
	// Логіка перенесена з обробки "Перенос остатков номенклатуры"
	// =====================================================================
	
	Если ПоДням Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.НоменклатураИдКод КАК НоменклатураИдКод,
		|	ВложенныйЗапрос.СкладИдКод КАК СкладИдКод,
		|	ВложенныйЗапрос.СкладНаименование КАК СкладНаименование,
		|	СУММА(ВложенныйЗапрос.КоличествоНачальныйОстаток_ПоДнямУПП) КАК КоличествоНачальныйОстаток_ПоДнямУПП,
		|	СУММА(ВложенныйЗапрос.КоличествоПриход_ПоДнямУПП) КАК КоличествоПриход_ПоДнямУПП,
		|	СУММА(ВложенныйЗапрос.КоличествоРасход_ПоДнямУПП) КАК КоличествоРасход_ПоДнямУПП,
		|	СУММА(ВложенныйЗапрос.КоличествоКонечныйОстаток_ПоДнямУПП) КАК КоличествоКонечныйОстаток_ПоДнямУПП,
		|	ВложенныйЗапрос.ПериодДень КАК ПериодДень
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВЫБОР
		|			КОГДА ПозицияНоменклатуры.НомерСтроки = 1
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура).А_ИдКод
		|			КОГДА ПозицияНоменклатуры.НомерСтроки = 2
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Номенклатура).А_ИдКод
		|			КОГДА ПозицияНоменклатуры.НомерСтроки = 3
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Номенклатура).А_ИдКод
		|			ИНАЧЕ """"
		|		КОНЕЦ КАК НоменклатураИдКод,
		|		ВЫБОР
		|			КОГДА ПозицияСклада.НомерСтроки = 1
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Склады).А_ИдКод
		|			КОГДА ПозицияСклада.НомерСтроки = 2
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Склады).А_ИдКод
		|			КОГДА ПозицияСклада.НомерСтроки = 3
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Склады).А_ИдКод
		|			ИНАЧЕ """"
		|		КОНЕЦ КАК СкладИдКод,
		|		ВЫБОР
		|			КОГДА ПозицияСклада.НомерСтроки = 1
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Склады).Наименование
		|			КОГДА ПозицияСклада.НомерСтроки = 2
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Склады).Наименование
		|			КОГДА ПозицияСклада.НомерСтроки = 3
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Склады).Наименование
		|			ИНАЧЕ """"
		|		КОНЕЦ КАК СкладНаименование,
		|		Остатки.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток_ПоДнямУПП,
		|		Остатки.КоличествоОборотДт КАК КоличествоПриход_ПоДнямУПП,
		|		Остатки.КоличествоОборотКт КАК КоличествоРасход_ПоДнямУПП,
		|		Остатки.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток_ПоДнямУПП,
		|		Остатки.Период КАК ПериодДень
		|	ИЗ
		|		РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		|				&НачалоПериода,
		|				&КонецПериода,
		|				День,
		|				,
		|				Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Товары))
		|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПроизводственныеЗапасы))   
		|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПриобретениеИзготовлениеОсновныхСредств))
		|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПриобретениеДругихНеоборотныхМатериальныхАктивов)) 
		//|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.МалоценныеНеоборотныеМатериальныеАктивыКоличественно))
		|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ГотоваяПродукция))
		|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.МалоценныеИБыстроизнашивающиесяПредметы)),
		|				,
		|				) КАК Остатки
		|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозицияНоменклатуры
		|			ПО Остатки.Счет = ПозицияНоменклатуры.Ссылка
		|				И (ПозицияНоменклатуры.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура))
		|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозицияСклада
		|			ПО Остатки.Счет = ПозицияСклада.Ссылка
		|				И (ПозицияСклада.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады))
		|	ГДЕ
		|		(Остатки.КоличествоНачальныйОстаток <> 0
		|				ИЛИ Остатки.КоличествоОборотДт <> 0
		|				ИЛИ Остатки.КоличествоОборотКт <> 0)
		|		И Остатки.Организация.КодПоЕДРПОУ В (&масКодПоЕДРПОУ)) КАК ВложенныйЗапрос
		|ГДЕ
		|	(&ФильтрНоменклатура
		|			ИЛИ ВложенныйЗапрос.НоменклатураИдКод = &НоменклатураИдКод)
		|	И (&ФильтрСклад
		|			ИЛИ ВложенныйЗапрос.СкладИдКод = &СкладИдКод)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.НоменклатураИдКод,
		|	ВложенныйЗапрос.СкладИдКод,
		|	ВложенныйЗапрос.СкладНаименование,
		|	ВложенныйЗапрос.ПериодДень";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.НоменклатураИдКод КАК НоменклатураИдКод,
		|	ВложенныйЗапрос.СкладИдКод КАК СкладИдКод,
		|	ВложенныйЗапрос.СкладНаименование КАК СкладНаименование,
		|	СУММА(ВложенныйЗапрос.КоличествоНачальныйОстаток_УПП) КАК КоличествоНачальныйОстаток_УПП,
		|	СУММА(ВложенныйЗапрос.КоличествоПриход_УПП) КАК КоличествоПриход_УПП,
		|	СУММА(ВложенныйЗапрос.КоличествоРасход_УПП) КАК КоличествоРасход_УПП,
		|	СУММА(ВложенныйЗапрос.КоличествоКонечныйОстаток_УПП) КАК КоличествоКонечныйОстаток_УПП
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВЫБОР
		|			КОГДА ПозицияНоменклатуры.НомерСтроки = 1
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура).А_ИдКод
		|			КОГДА ПозицияНоменклатуры.НомерСтроки = 2
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Номенклатура).А_ИдКод
		|			КОГДА ПозицияНоменклатуры.НомерСтроки = 3
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Номенклатура).А_ИдКод
		|			ИНАЧЕ """"
		|		КОНЕЦ КАК НоменклатураИдКод,
		|		ВЫБОР
		|			КОГДА ПозицияСклада.НомерСтроки = 1
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Склады).А_ИдКод
		|			КОГДА ПозицияСклада.НомерСтроки = 2
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Склады).А_ИдКод
		|			КОГДА ПозицияСклада.НомерСтроки = 3
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Склады).А_ИдКод
		|			ИНАЧЕ """"
		|		КОНЕЦ КАК СкладИдКод,
		|		ВЫБОР
		|			КОГДА ПозицияСклада.НомерСтроки = 1
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Склады).Наименование
		|			КОГДА ПозицияСклада.НомерСтроки = 2
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Склады).Наименование
		|			КОГДА ПозицияСклада.НомерСтроки = 3
		|				ТОГДА ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Склады).Наименование
		|			ИНАЧЕ """"
		|		КОНЕЦ КАК СкладНаименование,
		|		Остатки.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток_УПП,
		|		Остатки.КоличествоОборотДт КАК КоличествоПриход_УПП,
		|		Остатки.КоличествоОборотКт КАК КоличествоРасход_УПП,
		|		Остатки.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток_УПП
		|	ИЗ
		|		РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		|				&НачалоПериода,
		|				&КонецПериода,
		|				,
		|				,
		|				Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Товары))
		|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПроизводственныеЗапасы))
		|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПриобретениеИзготовлениеОсновныхСредств))
		|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПриобретениеДругихНеоборотныхМатериальныхАктивов))
		|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ГотоваяПродукция))  
		//|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.МалоценныеНеоборотныеМатериальныеАктивыКоличественно))
		|					ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.МалоценныеИБыстроизнашивающиесяПредметы)),
		|				,
		|				) КАК Остатки
		|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозицияНоменклатуры
		|			ПО Остатки.Счет = ПозицияНоменклатуры.Ссылка
		|				И (ПозицияНоменклатуры.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура))
		|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ПозицияСклада
		|			ПО Остатки.Счет = ПозицияСклада.Ссылка
		|				И (ПозицияСклада.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады))
		|	ГДЕ
		|		(Остатки.КоличествоНачальныйОстаток <> 0
		|				ИЛИ Остатки.КоличествоОборотДт <> 0
		|				ИЛИ Остатки.КоличествоОборотКт <> 0)
		|		И Остатки.Организация.КодПоЕДРПОУ В(&масКодПоЕДРПОУ)) КАК ВложенныйЗапрос
		|ГДЕ
		|	(&ФильтрНоменклатура
		|			ИЛИ ВложенныйЗапрос.НоменклатураИдКод = &НоменклатураИдКод)
		|	И (&ФильтрСклад
		|			ИЛИ ВложенныйЗапрос.СкладИдКод = &СкладИдКод)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.НоменклатураИдКод,
		|	ВложенныйЗапрос.СкладИдКод,
		|	ВложенныйЗапрос.СкладНаименование";
	КонецЕсли;

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("НоменклатураИдКод", НоменклатураИдКод);
	Запрос.УстановитьПараметр("СкладИдКод", СкладИдКод);
	Запрос.УстановитьПараметр("ФильтрНоменклатура", НЕ ЗначениеЗаполнено(Номенклатура));
	Запрос.УстановитьПараметр("ФильтрСклад", НЕ ЗначениеЗаполнено(Склад));
    Запрос.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);
	
	Попытка
		ТЗ = Запрос.Выполнить().Выгрузить();
	Исключение
		Сообщить("Помилка виконання запиту до BuhBud: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	// Серіалізація та десеріалізація для передачі через COM
	стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗ);
	ТаблицаBuhBud = ЗначениеИзСтрокиВнутр(стр_ТЗ);

	// Конвертація посилань BuhBud -> ERP через запит з тимчасовою таблицею
	// (ефективніше ніж НайтиПоРеквизиту в циклі)
	Результат = КонвертироватьТЗ_BuhBud(ТаблицаBuhBud, ПоДням);

	Возврат Результат;

КонецФункции

// Конвертація таблиці залишків BuhBud -> ERP через запит з тимчасовою таблицею
// Пошук номенклатури та складу по А_ИдКод з fallback на код/наименование
//
// Параметри:
//  ТаблицаBuhBud - ТаблицяЗначень - вхідна таблиця з полями НоменклатураИдКод, СкладИдКод, СкладНаименование
//  ПоДням - Булево - якщо Істина, повертає дані з розбивкою по днях
//
// Повертає:
//  ТаблицяЗначень - таблиця з конвертованими посиланнями
//
Функция КонвертироватьТЗ_BuhBud(ТаблицаBuhBud, ПоДням)

	Запрос = Новый Запрос;

	Если ПоДням Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|    ВнутренняяТаблица.НоменклатураИдКод,
		|    ВнутренняяТаблица.СкладИдКод,
		|    ВнутренняяТаблица.КоличествоНачальныйОстаток_ПоДнямУПП,
		|    ВнутренняяТаблица.КоличествоПриход_ПоДнямУПП,
		|    ВнутренняяТаблица.КоличествоРасход_ПоДнямУПП,
		|    ВнутренняяТаблица.КоличествоКонечныйОстаток_ПоДнямУПП,
		|    ВнутренняяТаблица.ПериодДень
		|ПОМЕСТИТЬ ВнутренняяТаблица
		|ИЗ
		|    &ТЗ КАК ВнутренняяТаблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    Номенклатура.Ссылка КАК Номенклатура,
		|    Склады.Ссылка КАК Склад,
		|    ВнутренняяТаблица.КоличествоНачальныйОстаток_ПоДнямУПП,
		|    ВнутренняяТаблица.КоличествоПриход_ПоДнямУПП,
		|    ВнутренняяТаблица.КоличествоРасход_ПоДнямУПП,
		|    ВнутренняяТаблица.КоличествоКонечныйОстаток_ПоДнямУПП,
		|    ВнутренняяТаблица.ПериодДень
		|ИЗ
		|    ВнутренняяТаблица КАК ВнутренняяТаблица
		|        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|        ПО ВнутренняяТаблица.НоменклатураИдКод = Номенклатура.А_ИдКод
		|        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Склады КАК Склады
		|        ПО ВнутренняяТаблица.СкладИдКод = Склады.А_ИдКод";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|    ВнутренняяТаблица.НоменклатураИдКод,
		|    ВнутренняяТаблица.СкладИдКод,
		|    ВнутренняяТаблица.КоличествоНачальныйОстаток_УПП,
		|    ВнутренняяТаблица.КоличествоПриход_УПП,
		|    ВнутренняяТаблица.КоличествоРасход_УПП,
		|    ВнутренняяТаблица.КоличествоКонечныйОстаток_УПП
		|ПОМЕСТИТЬ ВнутренняяТаблица
		|ИЗ
		|    &ТЗ КАК ВнутренняяТаблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    Номенклатура.Ссылка КАК Номенклатура,
		|    Склады.Ссылка КАК Склад,
		|    ВнутренняяТаблица.КоличествоНачальныйОстаток_УПП,
		|    ВнутренняяТаблица.КоличествоПриход_УПП,
		|    ВнутренняяТаблица.КоличествоРасход_УПП,
		|    ВнутренняяТаблица.КоличествоКонечныйОстаток_УПП
		|ИЗ
		|    ВнутренняяТаблица КАК ВнутренняяТаблица
		|        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|        ПО ВнутренняяТаблица.НоменклатураИдКод = Номенклатура.А_ИдКод
		|        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Склады КАК Склады
		|        ПО ВнутренняяТаблица.СкладИдКод = Склады.А_ИдКод";
	КонецЕсли;

	Запрос.УстановитьПараметр("ТЗ", ТаблицаBuhBud);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#КонецЕсли
