	Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
		
		СтандартнаяОбработка = Ложь;
		
		УстановитьПривилегированныйРежим(Истина);
		
		ПоДням = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПоДням").Значение;
		Склад = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Склад").Значение;
		Номенклатура = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Номенклатура").Значение;
		ПоДокументам = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПоДокументам").Значение;

		ПараметрПериодОтчета  	  = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Период").Значение;
		НачалоПериода 	  = ПараметрПериодОтчета.ДатаНачала;
		КонецПериода  	  = КонецДня(ПараметрПериодОтчета.ДатаОкончания);
		
		ТаблицаТовары_ЕРП = Новый ТаблицаЗначений;
		ТаблицаТовары_УПП = Новый ТаблицаЗначений;
		ТаблицаТовары_ПоДнямЕРП = Новый ТаблицаЗначений;
		ТаблицаТовары_ПоДнямУПП = Новый ТаблицаЗначений;
	    Товары_ПоДокументаммЕРП = Новый ТаблицаЗначений;
		Товары_ПоДокументамУПП = Новый ТаблицаЗначений;
	

		
		
		Если ПоДням Тогда
			ЗапросПоДням = Новый Запрос;
			ЗапросПоДням.Текст = "ВЫБРАТЬ
			|	ТоварыНаСкладахОстаткиИОбороты.Номенклатура КАК Номенклатура,
			|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииНачальныйОстаток КАК КоличествоНачальныйОстаток_ПоДнямЕРП,
			|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииПриход КАК КоличествоПриход_ПоДнямЕРП,
			|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииРасход КАК КоличествоРасход_ПоДнямЕРП,
			|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииКонечныйОстаток КАК КоличествоКонечныйОстаток_ПоДнямЕРП,
			|	ТоварыНаСкладахОстаткиИОбороты.Склад КАК Склад,
			|	ТоварыНаСкладахОстаткиИОбороты.Период КАК ПериодДень
			|ИЗ
			|	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(
			|			&НачалоПериода,
			|			&КонецПериода,
			|			День,
			|			,
			|			Номенклатура = &Номенклатура
			|				И Склад = &Склад) КАК ТоварыНаСкладахОстаткиИОбороты" ;
			ЗапросПоДням.УстановитьПараметр("НачалоПериода", НачалоПериода);
			ЗапросПоДням.УстановитьПараметр("КонецПериода", КонецПериода);
			
			ЗапросПоДням.УстановитьПараметр("Номенклатура",Номенклатура);
			ЗапросПоДням.УстановитьПараметр("Склад",Склад);
			
			ТаблицаТовары_ПоДнямЕРП= ЗапросПоДням.Выполнить().Выгрузить();
			
			
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ТоварыНаСкладахОстаткиИОбороты.Номенклатура КАК Номенклатура,
			|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииНачальныйОстаток КАК КоличествоНачальныйОстаток_ЕРП,
			|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииПриход КАК КоличествоПриход_ЕРП,
			|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииРасход КАК КоличествоРасход_ЕРП,
			|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииКонечныйОстаток КАК КоличествоКонечныйОстаток_ЕРП,
			|	ТоварыНаСкладахОстаткиИОбороты.Склад КАК Склад
			|ИЗ
			|	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(
			|			&НачалоПериода,
			|			&КонецПериода,
			|			,
			|			,
			|			Номенклатура = &Номенклатура
			|				И Склад = &Склад) КАК ТоварыНаСкладахОстаткиИОбороты" ;
			
			
			
			Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
			Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
			Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
			Запрос.УстановитьПараметр("Склад",Склад);
			
			ТаблицаТовары_ЕРП= Запрос.Выполнить().Выгрузить();
		ИначеЕсли ПоДокументам Тогда
			
			
			
			
			ЗапросПоДокументам = Новый Запрос;
			ЗапросПоДокументам.Текст = "ВЫБРАТЬ
			                           |	ТоварыНаСкладахОстаткиИОбороты.Номенклатура КАК Номенклатура,
			                           |	ТоварыНаСкладахОстаткиИОбороты.ВНаличииПриход КАК КоличествоПриход_ПоДокументамЕРП,
			                           |	ТоварыНаСкладахОстаткиИОбороты.ВНаличииРасход КАК КоличествоРасход_ПоДокументамЕРП,
			                           |	ТоварыНаСкладахОстаткиИОбороты.Склад КАК Склад,
			                           |	ТоварыНаСкладахОстаткиИОбороты.Регистратор КАК ДокументДвижения,
			                           |	ТоварыНаСкладахОстаткиИОбороты.ВНаличииПриход - ТоварыНаСкладахОстаткиИОбороты.ВНаличииРасход КАК КоличествоОборот_ПоДокументамЕРП,
			                           |	ПРЕДСТАВЛЕНИЕ(ТоварыНаСкладахОстаткиИОбороты.Регистратор) КАК ДокументДвиженияПредставление
			                           |ИЗ
			                           |	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(
			                           |			&НачалоПериода,
			                           |			&КонецПериода,
			                           |			Авто,
			                           |			,
			                           |			Номенклатура = &Номенклатура
			                           |				И Склад = &Склад) КАК ТоварыНаСкладахОстаткиИОбороты" ;
			ЗапросПоДокументам.УстановитьПараметр("НачалоПериода", НачалоПериода);
			ЗапросПоДокументам.УстановитьПараметр("КонецПериода", КонецПериода);
			
			ЗапросПоДокументам.УстановитьПараметр("Номенклатура",Номенклатура);
			ЗапросПоДокументам.УстановитьПараметр("Склад",Склад);
			
			Товары_ПоДокументаммЕРП= ЗапросПоДокументам.Выполнить().Выгрузить();

			
			
				Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ТоварыНаСкладахОстаткиИОбороты.Номенклатура КАК Номенклатура,
			|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииНачальныйОстаток КАК КоличествоНачальныйОстаток_ЕРП,
			|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииПриход КАК КоличествоПриход_ЕРП,
			|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииРасход КАК КоличествоРасход_ЕРП,
			|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииКонечныйОстаток КАК КоличествоКонечныйОстаток_ЕРП,
			|	ТоварыНаСкладахОстаткиИОбороты.Склад КАК Склад
			|ИЗ
			|	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(
			|			&НачалоПериода,
			|			&КонецПериода,
			|			,
			|			,
			|			Номенклатура = &Номенклатура
			|				И Склад = &Склад) КАК ТоварыНаСкладахОстаткиИОбороты" ;
			
			
			
			Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
			Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
			Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
			Запрос.УстановитьПараметр("Склад",Склад);
			
			ТаблицаТовары_ЕРП= Запрос.Выполнить().Выгрузить();

			
		Иначе
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ТоварыНаСкладахОстаткиИОбороты.Номенклатура КАК Номенклатура,
			|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииНачальныйОстаток КАК КоличествоНачальныйОстаток_ЕРП,
			|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииПриход КАК КоличествоПриход_ЕРП,
			|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииРасход КАК КоличествоРасход_ЕРП,
			|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииКонечныйОстаток КАК КоличествоКонечныйОстаток_ЕРП,
			|	ТоварыНаСкладахОстаткиИОбороты.Склад КАК Склад
			|ИЗ
			|	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ) КАК ТоварыНаСкладахОстаткиИОбороты" ;
			
			
			
			Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
			Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
			
			
			ТаблицаТовары_ЕРП= Запрос.Выполнить().Выгрузить();
			
		КонецЕсли; 
		
		
		
		
		
		
		СтрокаПодключения1СУПП = "Srvr=""localhost"";Ref=""work"";Usr=""Оператор1С"";Pwd=""159""";
		V8=Новый COMОбъект("V83.COMConnector");
		Попытка
			V83 = V8.Connect(СокрЛП(СтрокаПодключения1СУПП)); 
		Исключение
			Сообщить("База данных не открыта "+ОписаниеОшибки());
		КонецПопытки;
		
		
		ТаблицаТовары_ПоДнямУПП = Новый ТаблицаЗначений;
		
		Если ПоДням Тогда
			ЗапросПоДням =  V83.NewObject("Запрос");
			ЗапросПоДням.УстановитьПараметр("НачалоПериода",НачалоПериода);
			ЗапросПоДням.УстановитьПараметр("КонецПериода",КонецПериода);
			
			ЗапросПоДням.УстановитьПараметр("НоменклатураКод",Номенклатура.ИдКод);
			ЗапросПоДням.УстановитьПараметр("СкладИдКод",Склад.ИдКод);
			
			
			ЗапросПоДням.Текст =			
			"ВЫБРАТЬ
			|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
			|	ВложенныйЗапрос.Склад.Наименование КАК СкладНаименование,
			|	ВложенныйЗапрос.Склад.ИдКод КАК СкладИдКод,
			|	ВложенныйЗапрос.Номенклатура.Код КАК НоменклатураКод,
			|	СУММА(ВложенныйЗапрос.КоличествоНачальныйОстаток_УПП) КАК КоличествоНачальныйОстаток_ПоДнямУПП,
			|	СУММА(ВложенныйЗапрос.КоличествоПриход_УПП) КАК КоличествоПриход_ПоДнямУПП,
			|	СУММА(ВложенныйЗапрос.КоличествоРасход_УПП) КАК КоличествоРасход_ПоДнямУПП,
			|	СУММА(ВложенныйЗапрос.КоличествоКонечныйОстаток_УПП) КАК КоличествоКонечныйОстаток_ПоДнямУПП,
			|	ВложенныйЗапрос.Склад КАК Склад,
			|	ВложенныйЗапрос.ПериодДень КАК ПериодДень
			|ИЗ
			|	(ВЫБРАТЬ
			|		ТоварыНаСкладахОстаткиИОбороты.Номенклатура КАК Номенклатура,
			|		0 КАК КоличествоНачальныйОстаток_УПП,
			|		ТоварыНаСкладахОстаткиИОбороты.КоличествоПриход КАК КоличествоПриход_УПП,
			|		ТоварыНаСкладахОстаткиИОбороты.КоличествоРасход КАК КоличествоРасход_УПП,
			|		0 КАК КоличествоКонечныйОстаток_УПП,
			|		ТоварыНаСкладахОстаткиИОбороты.Склад.А_СкладЕРПдляСверки КАК Склад,
			|		ВЫБОР
			|			КОГДА ТоварыНаСкладахОстаткиИОбороты.Регистратор ССЫЛКА Документ.РасходныйОрдерНаТовары
			|				ТОГДА НАЧАЛОПЕРИОДА(ТоварыНаСкладахОстаткиИОбороты.Регистратор.ДокументПередачи.Дата, ДЕНЬ)
			|			ИНАЧЕ ВЫБОР
			|					КОГДА ТоварыНаСкладахОстаткиИОбороты.Регистратор ССЫЛКА Документ.ПриходныйОрдерНаТовары
			|						ТОГДА НАЧАЛОПЕРИОДА(ТоварыНаСкладахОстаткиИОбороты.Регистратор.А_Распоряжение.Дата, ДЕНЬ)
			|					ИНАЧЕ НАЧАЛОПЕРИОДА(ТоварыНаСкладахОстаткиИОбороты.Период, ДЕНЬ)
			|				КОНЕЦ
			|		КОНЕЦ КАК ПериодДень
			|	ИЗ
			|		РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Регистратор, , ) КАК ТоварыНаСкладахОстаткиИОбороты
			|	ГДЕ
			|		ТоварыНаСкладахОстаткиИОбороты.Склад.Организация.ВБалансе
			|		И ТоварыНаСкладахОстаткиИОбороты.Номенклатура.ИдКод = &НоменклатураКод
			|		И ТоварыНаСкладахОстаткиИОбороты.Склад.А_СкладЕРПдляСверки.ИдКод = &СкладИдКод
			|		И НЕ(ТоварыНаСкладахОстаткиИОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
			|						И (ТоварыНаСкладахОстаткиИОбороты.Регистратор.А_ВнутренняяПродажа
			|							ИЛИ ТоварыНаСкладахОстаткиИОбороты.Регистратор.А_ВнутренняяПродажаЗаводу
			|							ИЛИ ТоварыНаСкладахОстаткиИОбороты.Регистратор.А_ЭтоДвижениеПодПродажуЧерезУпрКомпанию)
			|					ИЛИ ТоварыНаСкладахОстаткиИОбороты.Регистратор ССЫЛКА Документ.РасходныйОрдерНаТовары
			|						И ТоварыНаСкладахОстаткиИОбороты.Регистратор.А_ВнутренняяПродажа
			|					ИЛИ ТоварыНаСкладахОстаткиИОбороты.Регистратор ССЫЛКА Документ.ПриходныйОрдерНаТовары
			|						И ТоварыНаСкладахОстаткиИОбороты.Регистратор.А_ЭтоДвижениеПодПродажуЧерезУпрКомпанию
			|						И ТоварыНаСкладахОстаткиИОбороты.Регистратор.Контрагент.Код <> ""Р0003296"")) КАК ВложенныйЗапрос
			|
			|СГРУППИРОВАТЬ ПО
			|	ВложенныйЗапрос.Склад,
			|	ВложенныйЗапрос.Номенклатура,
			|	ВложенныйЗапрос.Склад.Наименование,
			|	ВложенныйЗапрос.Номенклатура.Код,
			|	ВложенныйЗапрос.ПериодДень,
			|	ВложенныйЗапрос.Склад.ИдКод";
			
			ТЗ = ЗапросПоДням.Выполнить().Выгрузить();
			
			
			стр_ТЗ    = V83.ЗначениеВСтрокуВнутр(ТЗ);
			ТаблицаТовары_ПоДнямУПП    = ЗначениеИзСтрокиВнутр(стр_ТЗ);
			
			ТаблицаТовары_ПоДнямУПП = КонвертироватьТЗ_ЕРПпоДням(ТаблицаТовары_ПоДнямУПП);
			 			
			
			
			Запрос =  V83.NewObject("Запрос");
			Запрос.УстановитьПараметр("НачалоПериода",НачалоПериода);
			Запрос.УстановитьПараметр("КонецПериода",КонецПериода);
			Запрос.УстановитьПараметр("НоменклатураКод",Номенклатура.ИдКод);
			Запрос.УстановитьПараметр("СкладИдКод",Склад.ИдКод);
			
			Запрос.Текст =
			
			"ВЫБРАТЬ
			|	ВложенныйЗапрос.Номенклатура,
			|	ВложенныйЗапрос.Склад.Наименование КАК СкладНаименование,
			|	ВложенныйЗапрос.Склад.ИдКод КАК СкладИдКод,
			|	ВложенныйЗапрос.Номенклатура.Код КАК НоменклатураКод,
			|	СУММА(ВложенныйЗапрос.КоличествоНачальныйОстаток_УПП) КАК КоличествоНачальныйОстаток_УПП,
			|	СУММА(ВложенныйЗапрос.КоличествоПриход_УПП) КАК КоличествоПриход_УПП,
			|	СУММА(ВложенныйЗапрос.КоличествоРасход_УПП) КАК КоличествоРасход_УПП,
