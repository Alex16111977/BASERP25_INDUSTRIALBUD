#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	УстановитьПривилегированныйРежим(Истина);

	// Отримання параметрів з СКД
	ПоДням = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПоДням").Значение;
	Склад = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Склад").Значение;
	Номенклатура = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Номенклатура").Значение;
	ПоДокументам = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПоДокументам").Значение;

	ПараметрПериодОтчета = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Период").Значение;
	НачалоПериода = ПараметрПериодОтчета.ДатаНачала;
	КонецПериода = КонецДня(ПараметрПериодОтчета.ДатаОкончания);

	// =============================================
	// 1. ЗАЛИШКИ ERP (РегістрНакопления.ТоварыНаСкладах)
	// =============================================
	ТаблицаТовары_ЕРП = ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода, Ложь, Номенклатура, Склад);

	ТаблицаТовары_ПоДнямЕРП = Новый ТаблицаЗначений;
	Если ПоДням Тогда
		ТаблицаТовары_ПоДнямЕРП = ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода, Истина, Номенклатура, Склад);
	КонецЕсли;

	Товары_ПоДокументаммЕРП = Новый ТаблицаЗначений;
	Если ПоДокументам Тогда
		Товары_ПоДокументаммЕРП = ПолучитьОстаткиЕРППоДокументам(НачалоПериода, КонецПериода, Номенклатура, Склад);
	КонецЕсли;

	// =============================================
	// 2. ЗАЛИШКИ BUHBUD (COM + РегБух.Хозрасчетный)
	//    Рахунки: 281 (Товары), 20x (ПроизводственныеЗапасы),
	//             26 (ГотоваяПродукция), 22x (МБП)
	// =============================================
	СтрокаПодключенияBuhBud = "Srvr=""SQLSERVER"";Ref=""BuhBud"";Usr=""1cAdmin"";Pwd=""""";
	V8 = Новый COMОбъект("V83.COMConnector");

	Попытка
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияBuhBud));
	Исключение
		Сообщить("Помилка підключення до BuhBud: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ТаблицаТовары_УПП = ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода, Ложь, Номенклатура, Склад);

	ТаблицаТовары_ПоДнямУПП = Новый ТаблицаЗначений;
	Если ПоДням Тогда
		ТаблицаТовары_ПоДнямУПП = ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода, Истина, Номенклатура, Склад);
	КонецЕсли;

	Товары_ПоДокументамУПП = Новый ТаблицаЗначений;
	// Примітка: режим "по документах" для BuhBud потребує окремої реалізації
	// через регістри бухгалтерії, що є складнішим завданням

	// Звільнення COM-з'єднання
	V83 = Неопределено;
	V8 = Неопределено;

	// =============================================
	// 3. ПЕРЕДАЧА В СКД
	// =============================================
	ВнешниеНаборыДанных = Новый Структура(
		"Товары_ЕРП, Товары_УПП, Товары_ПоДнямЕРП, Товары_ПоДнямУПП, Товары_ПоДокументаммЕРП, Товары_ПоДокументамУПП",
		ТаблицаТовары_ЕРП,
		ТаблицаТовары_УПП,
		ТаблицаТовары_ПоДнямЕРП,
		ТаблицаТовары_ПоДнямУПП,
		Товары_ПоДокументаммЕРП,
		Товары_ПоДокументамУПП
	);

	// Формування звіту
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отримання залишків з ERP (РегістрНакопления.ТоварыНаСкладах)
//
// Параметри:
//  НачалоПериода - Дата - початок періоду
//  КонецПериода - Дата - кінець періоду
//  ПоДням - Булево - якщо Істина, то розбивка по днях
//  Номенклатура - СправочникСсылка.Номенклатура - фільтр по номенклатурі
//  Склад - СправочникСсылка.Склады - фільтр по складу
//
// Повертає:
//  ТаблицяЗначень - таблиця з залишками
//
Функция ПолучитьОстаткиЕРП(НачалоПериода, КонецПериода, ПоДням, Номенклатура = Неопределено, Склад = Неопределено)

	Запрос = Новый Запрос;

	Если ПоДням Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТоварыНаСкладахОстаткиИОбороты.Номенклатура КАК Номенклатура,
		|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииНачальныйОстаток КАК КоличествоНачальныйОстаток_ПоДнямЕРП,
		|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииПриход КАК КоличествоПриход_ПоДнямЕРП,
		|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииРасход КАК КоличествоРасход_ПоДнямЕРП,
		|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииКонечныйОстаток КАК КоличествоКонечныйОстаток_ПоДнямЕРП,
		|	ТоварыНаСкладахОстаткиИОбороты.Склад КАК Склад,
		|	ТоварыНаСкладахОстаткиИОбороты.Период КАК ПериодДень
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			День,
		|			,
		|			(&ФильтрНоменклатура ИЛИ Номенклатура = &Номенклатура)
		|				И (&ФильтрСклад ИЛИ Склад = &Склад)) КАК ТоварыНаСкладахОстаткиИОбороты";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТоварыНаСкладахОстаткиИОбороты.Номенклатура КАК Номенклатура,
		|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииНачальныйОстаток КАК КоличествоНачальныйОстаток_ЕРП,
		|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииПриход КАК КоличествоПриход_ЕРП,
		|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииРасход КАК КоличествоРасход_ЕРП,
		|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииКонечныйОстаток КАК КоличествоКонечныйОстаток_ЕРП,
		|	ТоварыНаСкладахОстаткиИОбороты.Склад КАК Склад
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			,
		|			,
		|			(&ФильтрНоменклатура ИЛИ Номенклатура = &Номенклатура)
		|				И (&ФильтрСклад ИЛИ Склад = &Склад)) КАК ТоварыНаСкладахОстаткиИОбороты";
	КонецЕсли;

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ФильтрНоменклатура", НЕ ЗначениеЗаполнено(Номенклатура));
	Запрос.УстановитьПараметр("ФильтрСклад", НЕ ЗначениеЗаполнено(Склад));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Отримання залишків з ERP по документах
//
Функция ПолучитьОстаткиЕРППоДокументам(НачалоПериода, КонецПериода, Номенклатура = Неопределено, Склад = Неопределено)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыНаСкладахОстаткиИОбороты.Номенклатура КАК Номенклатура,
	|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииПриход КАК КоличествоПриход_ПоДокументамЕРП,
	|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииРасход КАК КоличествоРасход_ПоДокументамЕРП,
	|	ТоварыНаСкладахОстаткиИОбороты.Склад КАК Склад,
	|	ТоварыНаСкладахОстаткиИОбороты.Регистратор КАК ДокументДвижения,
	|	ТоварыНаСкладахОстаткиИОбороты.ВНаличииПриход - ТоварыНаСкладахОстаткиИОбороты.ВНаличииРасход КАК КоличествоОборот_ПоДокументамЕРП,
	|	ПРЕДСТАВЛЕНИЕ(ТоварыНаСкладахОстаткиИОбороты.Регистратор) КАК ДокументДвиженияПредставление
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Авто,
	|			,
	|			(&ФильтрНоменклатура ИЛИ Номенклатура = &Номенклатура)
	|				И (&ФильтрСклад ИЛИ Склад = &Склад)) КАК ТоварыНаСкладахОстаткиИОбороты";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ФильтрНоменклатура", НЕ ЗначениеЗаполнено(Номенклатура));
	Запрос.УстановитьПараметр("ФильтрСклад", НЕ ЗначениеЗаполнено(Склад));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Отримання залишків з BuhBud через COM (РегістрБухгалтерії.Хозрасчетный)
// Рахунки: 281 (Товары), 20x (ПроизводственныеЗапасы), 26 (ГотоваяПродукция), 22x (МБП)
//
// Параметри:
//  V83 - COMОбъект - підключення до BuhBud
//  НачалоПериода - Дата - початок періоду
//  КонецПериода - Дата - кінець періоду
//  ПоДням - Булево - якщо Істина, то розбивка по днях
//  Номенклатура - СправочникСсылка.Номенклатура - фільтр по номенклатурі (для отримання коду)
//  Склад - СправочникСсылка.Склады - фільтр по складу (для отримання ИдКод)
//
// Повертає:
//  ТаблицяЗначень - таблиця з залишками (з конвертованими посиланнями)
//
Функция ПолучитьОстаткиBuhBud(V83, НачалоПериода, КонецПериода, ПоДням, Номенклатура = Неопределено, Склад = Неопределено)

	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15, 3);
	ОписаниеТиповДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура",
		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Склад",
		Новый ОписаниеТипов("СправочникСсылка.Склады"));

	Если ПоДням Тогда
		Результат.Колонки.Добавить("КоличествоНачальныйОстаток_ПоДнямУПП", ТипЧисло);
		Результат.Колонки.Добавить("КоличествоПриход_ПоДнямУПП", ТипЧисло);
		Результат.Колонки.Добавить("КоличествоРасход_ПоДнямУПП", ТипЧисло);
		Результат.Колонки.Добавить("КоличествоКонечныйОстаток_ПоДнямУПП", ТипЧисло);
		Результат.Колонки.Добавить("ПериодДень", ОписаниеТиповДата);
	Иначе
		Результат.Колонки.Добавить("КоличествоНачальныйОстаток_УПП", ТипЧисло);
		Результат.Колонки.Добавить("КоличествоПриход_УПП", ТипЧисло);
		Результат.Колонки.Добавить("КоличествоРасход_УПП", ТипЧисло);
		Результат.Колонки.Добавить("КоличествоКонечныйОстаток_УПП", ТипЧисло);
	КонецЕсли;

	// Підготовка параметрів фільтрації
	НоменклатураКод = "";
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		НоменклатураКод = СокрЛП(Номенклатура.Код);
	КонецЕсли;

	СкладИдКод = "";
	Если ЗначениеЗаполнено(Склад) Тогда
		СкладИдКод = СокрЛП(Склад.А_КодПереноса);
	КонецЕсли;

	Запрос = V83.NewObject("Запрос");

	Если ПоДням Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура).Код КАК НоменклатураКод,
		|	ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Склады).Наименование КАК СкладНаименование,
		|	ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Склады).Код КАК СкладИдКод,
		|	Остатки.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток_ПоДнямУПП,
		|	Остатки.КоличествоОборотДт КАК КоличествоПриход_ПоДнямУПП,
		|	Остатки.КоличествоОборотКт КАК КоличествоРасход_ПоДнямУПП,
		|	Остатки.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток_ПоДнямУПП,
		|	Остатки.Период КАК ПериодДень,
		|	Остатки.Счет.Код КАК СчетКод
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			День,
		|			,
		|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Товары))
		|				ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПроизводственныеЗапасы))
		|				ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ГотоваяПродукция))
		|				ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.МалоценныеИБыстроизнашивающиесяПредметы)),
		|			,
		|			) КАК Остатки
		|ГДЕ
		|	(Остатки.КоличествоНачальныйОстаток <> 0
		|			ИЛИ Остатки.КоличествоОборотДт <> 0
		|			ИЛИ Остатки.КоличествоОборотКт <> 0)
		|	И (&ФильтрНоменклатура ИЛИ ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура).Код = &НоменклатураКод)
		|	И (&ФильтрСклад ИЛИ ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Склады).Код = &СкладИдКод)";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура).Код КАК НоменклатураКод,
		|	ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Склады).Наименование КАК СкладНаименование,
		|	ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Склады).Код КАК СкладИдКод,
		|	Остатки.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток_УПП,
		|	Остатки.КоличествоОборотДт КАК КоличествоПриход_УПП,
		|	Остатки.КоличествоОборотКт КАК КоличествоРасход_УПП,
		|	Остатки.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток_УПП,
		|	Остатки.Счет.Код КАК СчетКод
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			,
		|			,
		|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Товары))
		|				ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПроизводственныеЗапасы))
		|				ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ГотоваяПродукция))
		|				ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.МалоценныеИБыстроизнашивающиесяПредметы)),
		|			,
		|			) КАК Остатки
		|ГДЕ
		|	(Остатки.КоличествоНачальныйОстаток <> 0
		|			ИЛИ Остатки.КоличествоОборотДт <> 0
		|			ИЛИ Остатки.КоличествоОборотКт <> 0)
		|	И (&ФильтрНоменклатура ИЛИ ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура).Код = &НоменклатураКод)
		|	И (&ФильтрСклад ИЛИ ВЫРАЗИТЬ(Остатки.Субконто3 КАК Справочник.Склады).Код = &СкладИдКод)";
	КонецЕсли;

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("НоменклатураКод", НоменклатураКод);
	Запрос.УстановитьПараметр("СкладИдКод", СкладИдКод);
	Запрос.УстановитьПараметр("ФильтрНоменклатура", НЕ ЗначениеЗаполнено(Номенклатура));
	Запрос.УстановитьПараметр("ФильтрСклад", НЕ ЗначениеЗаполнено(Склад));

	ТЗ = Запрос.Выполнить().Выгрузить();

	// Серіалізація та десеріалізація для передачі через COM
	стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗ);
	ТаблицаBuhBud = ЗначениеИзСтрокиВнутр(стр_ТЗ);

	// Конвертація посилань BuhBud -> ERP
	Для Каждого СтрокаТЗ Из ТаблицаBuhBud Цикл
		НС = Результат.Добавить();

		Если ПоДням Тогда
			НС.ПериодДень = СтрокаТЗ.ПериодДень;
			НС.КоличествоНачальныйОстаток_ПоДнямУПП = СтрокаТЗ.КоличествоНачальныйОстаток_ПоДнямУПП;
			НС.КоличествоПриход_ПоДнямУПП = СтрокаТЗ.КоличествоПриход_ПоДнямУПП;
			НС.КоличествоРасход_ПоДнямУПП = СтрокаТЗ.КоличествоРасход_ПоДнямУПП;
			НС.КоличествоКонечныйОстаток_ПоДнямУПП = СтрокаТЗ.КоличествоКонечныйОстаток_ПоДнямУПП;
		Иначе
			НС.КоличествоНачальныйОстаток_УПП = СтрокаТЗ.КоличествоНачальныйОстаток_УПП;
			НС.КоличествоПриход_УПП = СтрокаТЗ.КоличествоПриход_УПП;
			НС.КоличествоРасход_УПП = СтрокаТЗ.КоличествоРасход_УПП;
			НС.КоличествоКонечныйОстаток_УПП = СтрокаТЗ.КоличествоКонечныйОстаток_УПП;
		КонецЕсли;

		// Зіставлення номенклатури по коду
		Попытка
			НоменклатураКодBuhBud = СокрЛП(СтрокаТЗ.НоменклатураКод);
			Если НЕ ПустаяСтрока(НоменклатураКодBuhBud) Тогда
				НоменклатураЕРП = Справочники.Номенклатура.НайтиПоКоду(НоменклатураКодBuhBud);
				Если НЕ ЗначениеЗаполнено(НоменклатураЕРП) Тогда
					// Спроба знайти без ведучих нулів
					НоменклатураЕРП = Справочники.Номенклатура.НайтиПоКоду(НоменклатураКодBuhBud, Истина);
				КонецЕсли;
				НС.Номенклатура = НоменклатураЕРП;
			КонецЕсли;
		Исключение
			// Якщо не вдалося знайти відповідність - залишаємо порожню посилку
		КонецПопытки;

		// Зіставлення складу по ИдКод або наименованию
		Попытка
			СкладИдКодBuhBud = СокрЛП(СтрокаТЗ.СкладИдКод);
			СкладНаименованиеBuhBud = СокрЛП(СтрокаТЗ.СкладНаименование);

			СкладЕРП = Неопределено;

			// Спочатку пробуємо знайти по ИдКод
			Если НЕ ПустаяСтрока(СкладИдКодBuhBud) Тогда
				СкладЕРП = Справочники.Склады.НайтиПоРеквизиту("А_КодПереноса", СкладИдКодBuhBud);
			КонецЕсли;

			// Якщо не знайшли по ИдКод - шукаємо по наименованию
			Если НЕ ЗначениеЗаполнено(СкладЕРП) И НЕ ПустаяСтрока(СкладНаименованиеBuhBud) Тогда
				СкладЕРП = Справочники.Склады.НайтиПоНаименованию(СкладНаименованиеBuhBud);
			КонецЕсли;

			НС.Склад = СкладЕРП;
		Исключение
			// Якщо не вдалося знайти відповідність - залишаємо порожню посилку
		КонецПопытки;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецЕсли
