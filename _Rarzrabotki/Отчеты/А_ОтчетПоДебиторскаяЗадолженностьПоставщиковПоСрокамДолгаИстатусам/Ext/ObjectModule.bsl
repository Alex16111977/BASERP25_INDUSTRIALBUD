Функция СписокСсылок(МенеджерСправочника, Идентификаторы)

	Список = Новый СписокЗначений;
	Для Каждого Идентификатор Из СтрРазделить(Идентификаторы, ",", Ложь) Цикл
		Список.Добавить(МенеджерСправочника.ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Идентификатор))));
	КонецЦикла;

	Возврат Список;

КонецФункции

// Интервалы из строки «7, 15, 30»: целые числа больше нуля, по возрастанию, без повторов.
// Пустая или непригодная строка — интервалы по умолчанию, как в рабочих настройках бухгалтера.
Функция РазобратьИнтервалы(СтрокаИнтервалов)

	Интервалы = Новый Массив;
	Если ТипЗнч(СтрокаИнтервалов) = Тип("Строка") Тогда
		ОписаниеЧисла = Новый ОписаниеТипов("Число");
		Для Каждого Часть Из СтрРазделить(СтрЗаменить(СтрокаИнтервалов, ";", ","), ",", Ложь) Цикл
			Дней = ОписаниеЧисла.ПривестиЗначение(СокрЛП(Часть));
			Дней = Цел(Дней);
			Если Дней > 0 И Интервалы.Найти(Дней) = Неопределено Тогда
				Интервалы.Добавить(Дней);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Интервалы.Количество() = 0 Тогда
		Интервалы.Добавить(7);
		Интервалы.Добавить(15);
		Интервалы.Добавить(30);
	КонецЕсли;

	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Интервалы);
	Список.СортироватьПоЗначению(НаправлениеСортировки.Возр);

	Возврат Список.ВыгрузитьЗначения();

КонецФункции

// Заголовок колонки интервала, как в типовом: «До 7 днів», «Від 8 до 15 днів», …, «Понад 30 днів».
Функция ЗаголовокИнтервала(Интервалы, Индекс)

	Если Индекс > Интервалы.Количество() Тогда
		Возврат "Понад " + Формат(Интервалы[Интервалы.Количество() - 1], "ЧГ=0") + " днів";
	ИначеЕсли Индекс = 1 Тогда
		Возврат "До " + Формат(Интервалы[0], "ЧГ=0") + " днів";
	КонецЕсли;

	Возврат "Від " + Формат(Интервалы[Индекс - 2] + 1, "ЧГ=0") + " до " + Формат(Интервалы[Индекс - 1], "ЧГ=0") + " днів";

КонецФункции

// Поля ОстатокПериодаK под текущие интервалы — перенос ЗаполнитьПоляВСоответствииСоСпискомИнтервалов типового.
// Колонки в папке «Загальна заборгованість по строках боргу» пересобираются, остальной выбор пользователя не трогается.
Процедура НастроитьПоляИнтервалов(СхемаОтчета, Настройки, Интервалы)

	Набор = СхемаОтчета.НаборыДанных.ОсновнойНабор;
	Для Индекс = -(Набор.Поля.Количество() - 1) По 0 Цикл
		Поле = Набор.Поля[-Индекс];
		Если СтрНачинаетсяС(Поле.ПутьКДанным, "ОстатокПериода") Тогда
			Набор.Поля.Удалить(Поле);
		КонецЕсли;
	КонецЦикла;
	Для Индекс = -(СхемаОтчета.ПоляИтога.Количество() - 1) По 0 Цикл
		ПолеИтога = СхемаОтчета.ПоляИтога[-Индекс];
		Если СтрНачинаетсяС(ПолеИтога.ПутьКДанным, "ОстатокПериода") Тогда
			СхемаОтчета.ПоляИтога.Удалить(ПолеИтога);
		КонецЕсли;
	КонецЦикла;

	КоличествоКолонок = Интервалы.Количество() + 1;
	Для Индекс = 1 По КоличествоКолонок Цикл
		ИмяПоля = "ОстатокПериода" + Формат(Индекс, "ЧГ=0");
		Поле = Набор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		Поле.Поле = ИмяПоля;
		Поле.ПутьКДанным = ИмяПоля;
		Поле.Заголовок = ЗаголовокИнтервала(Интервалы, Индекс);
		Поле.ТипЗначения = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
		Поле.Оформление.УстановитьЗначениеПараметра("Формат", "ЧЦ=15; ЧДЦ=0");
		Поле.ОграничениеИспользования.Группировка = Истина;
		Поле.ОграничениеИспользованияРеквизитов.Группировка = Истина;

		ПолеИтога = СхемаОтчета.ПоляИтога.Добавить();
		ПолеИтога.ПутьКДанным = ИмяПоля;
		ПолеИтога.Выражение = "Сумма(" + ИмяПоля + ")";
	КонецЦикла;

	Папка = ПапкаИнтервалов(Настройки.Выбор.Элементы);
	Если Папка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Папка.Элементы.Очистить();
	Для Индекс = 1 По КоличествоКолонок Цикл
		ВыбранноеПоле = Папка.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("ОстатокПериода" + Формат(Индекс, "ЧГ=0"));
		ВыбранноеПоле.Использование = Истина;
	КонецЦикла;

КонецПроцедуры

// Папка выбранных полей с колонками интервалов (в варианте «Загальна заборгованість по строках боргу»).
Функция ПапкаИнтервалов(ЭлементыВыбора)

	Для Каждого Элемент Из ЭлементыВыбора Цикл
		Если ТипЗнч(Элемент) <> Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Вложенный Из Элемент.Элементы Цикл
			Если ТипЗнч(Вложенный) = Тип("ВыбранноеПолеКомпоновкиДанных")
				И СтрНачинаетсяС(Строка(Вложенный.Поле), "ОстатокПериода") Тогда
				Возврат Элемент;
			КонецЕсли;
		КонецЦикла;
		Если СтрНайти(Элемент.Заголовок, "по строках боргу") > 0 Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Параметры запроса — перенос УстановитьПараметры типового: Период = начало следующего дня (остатки включая дату
// отчёта), границы интервалов от даты отчёта.
Процедура УстановитьПараметрыСхемы(СхемаОтчета, Настройки, ДатаОтчета, ОрганизацияОтчета, ДатаНачалаБас, Интервалы)

	Сутки = 60 * 60 * 24;
	Значения = Новый Соответствие;
	Значения.Вставить("Период", КонецДня(ДатаОтчета) + 1);
	Значения.Вставить("Организация", ОрганизацияОтчета);
	Значения.Вставить("ДатаНачалаБас", ДатаНачалаБас);
	Значения.Вставить("ВидыСубконтоКД", ВидыСубконтоРасчетов());
	Значения.Вставить("ИсключенныеСчета", ИсключенныеСчета());

	Предыдущее = 0;
	Для Индекс = 1 По Интервалы.Количество() Цикл
		Н = Формат(Индекс, "ЧГ=0");
		Дней = Интервалы[Индекс - 1];
		Значения.Вставить("НачалоИнтервала" + Н, НачалоДня(ДатаОтчета) - Дней * Сутки);
		Значения.Вставить("КонецИнтервала" + Н,
			?(Индекс = 1, КонецДня(ДатаОтчета), КонецДня(ДатаОтчета) - (Предыдущее + 1) * Сутки));
		Предыдущее = Дней;
	КонецЦикла;

	Для Каждого КлючИЗначение Из Значения Цикл
		Параметр = СхемаОтчета.Параметры.Найти(КлючИЗначение.Ключ);
		Если Параметр = Неопределено Тогда
			Параметр = СхемаОтчета.Параметры.Добавить();
			Параметр.Имя = КлючИЗначение.Ключ;
			Параметр.ОграничениеИспользования = Истина;
		КонецЕсли;
		Если ТипЗнч(КлючИЗначение.Значение) = Тип("СписокЗначений") Тогда
			Параметр.ДоступенСписокЗначений = Истина;
		КонецЕсли;
		Параметр.Значение = КлючИЗначение.Значение;

		ЗначениеВНастройках = Настройки.ПараметрыДанных.Элементы.Найти(КлючИЗначение.Ключ);
		Если ЗначениеВНастройках <> Неопределено Тогда
			ЗначениеВНастройках.Значение = КлючИЗначение.Значение;
			ЗначениеВНастройках.Использование = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Шапка как у типового отчёта: организация, заголовок на дату, «Відбір:», «Сортування:», пустая строка.
Процедура ВывестиШапку(ДокументРезультат, Настройки, ОрганизацияОтчета, ДатаОтчета)

	Шапка = Новый ТабличныйДокумент;

	Область = Шапка.Область(1, 1, 1, 1);
	Область.Текст = Строка(ОрганизацияОтчета);
	Область.Шрифт = Новый Шрифт(, , Истина);

	Область = Шапка.Область(2, 1, 2, 1);
	Область.Текст = "Дебіторська заборгованість постачальників по строках боргу на " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy");
	Область.Шрифт = Новый Шрифт(, 12, Истина);

	НомерСтроки = 2;
	ТекстОтбора = ТекстОтбора(Настройки.Отбор.Элементы);
	Если ЗначениеЗаполнено(ТекстОтбора) Тогда
		НомерСтроки = НомерСтроки + 2;
		Шапка.Область(НомерСтроки, 1, НомерСтроки, 1).Текст = "Відбір:";
		Шапка.Область(НомерСтроки, 2, НомерСтроки, 2).Текст = ТекстОтбора;
	КонецЕсли;
	ТекстПорядка = ТекстПорядка(Настройки.Порядок.Элементы);
	Если ЗначениеЗаполнено(ТекстПорядка) Тогда
		НомерСтроки = НомерСтроки + 2;
		Шапка.Область(НомерСтроки, 1, НомерСтроки, 1).Текст = "Сортування:";
		Шапка.Область(НомерСтроки, 2, НомерСтроки, 2).Текст = ТекстПорядка;
	КонецЕсли;
	// Пустая строка перед таблицей.
	Шапка.Область(НомерСтроки + 1, 1, НомерСтроки + 1, 1).Текст = " ";

	ДокументРезультат.Вывести(Шапка);

КонецПроцедуры

// Включённые отборы одной строкой по-украински: «Постачальник Не в списку "…" і Рахунок на оплату.Дата Більше "…"».
Функция ТекстОтбора(ЭлементыОтбора, ТипГруппы = Неопределено)

	Части = Новый Массив;
	Для Каждого Элемент Из ЭлементыОтбора Цикл
		Если НЕ Элемент.Использование Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ТекстГруппы = ТекстОтбора(Элемент.Элементы, Элемент.ТипГруппы);
			Если ЗначениеЗаполнено(ТекстГруппы) Тогда
				Части.Добавить("(" + ТекстГруппы + ")");
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Части.Добавить(ЗаголовокПоля(Элемент.ЛевоеЗначение) + " " + ПредставлениеВидаСравнения(Элемент.ВидСравнения)
			+ ТекстЗначенияОтбора(Элемент.ВидСравнения, Элемент.ПравоеЗначение));
	КонецЦикла;

	Текст = СтрСоединить(Части, ?(ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли, " або ", " і "));
	Если ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе И ЗначениеЗаполнено(Текст) Тогда
		Текст = "не " + Текст;
	КонецЕсли;

	Возврат Текст;

КонецФункции

Функция ТекстЗначенияОтбора(ВидСравнения, Значение)

	Если ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено
		ИЛИ ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("СписокЗначений") Тогда
		Представления = Новый Массив;
		Для Каждого ЭлементСписка Из Значение Цикл
			Представления.Добавить(Строка(ЭлементСписка.Значение));
		КонецЦикла;
		ТекстЗначения = СтрСоединить(Представления, "; ");
	ИначеЕсли ТипЗнч(Значение) = Тип("СтандартнаяДатаНачала") Тогда
		ТекстЗначения = Формат(Значение.Дата, "ДФ=dd.MM.yyyy");
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		ТекстЗначения = Формат(Значение, "ДФ=dd.MM.yyyy");
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		ТекстЗначения = ?(Значение, "Так", "Ні");
	Иначе
		ТекстЗначения = Строка(Значение);
	КонецЕсли;

	Возврат " """ + ТекстЗначения + """";

КонецФункции

Функция ПредставлениеВидаСравнения(ВидСравнения)

	Если ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
		Возврат "Дорівнює";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно Тогда
		Возврат "Не дорівнює";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Больше Тогда
		Возврат "Більше";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
		Возврат "Більше або дорівнює";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше Тогда
		Возврат "Менше";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
		Возврат "Менше або дорівнює";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда
		Возврат "В списку";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
		Возврат "Не в списку";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
		Возврат "В групі";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
		Возврат "Не в групі";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
		Возврат "В групі зі списку";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
		Возврат "Не в групі зі списку";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит Тогда
		Возврат "Містить";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит Тогда
		Возврат "Не містить";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НачинаетсяС Тогда
		Возврат "Починається з";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеНачинаетсяС Тогда
		Возврат "Не починається з";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Подобно Тогда
		Возврат "Схоже на";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеПодобно Тогда
		Возврат "Не схоже на";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
		Возврат "Заповнено";
	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
		Возврат "Не заповнено";
	КонецЕсли;

	Возврат Строка(ВидСравнения);

КонецФункции

Функция ТекстПорядка(ЭлементыПорядка)

	Части = Новый Массив;
	Для Каждого Элемент Из ЭлементыПорядка Цикл
		Если ТипЗнч(Элемент) <> Тип("ЭлементПорядкаКомпоновкиДанных") ИЛИ НЕ Элемент.Использование Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(ЗаголовокПоля(Элемент.Поле) + " "
			+ ?(Элемент.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв, "За спаданням", "За зростанням"));
	КонецЦикла;

	Возврат СтрСоединить(Части, ", ");

КонецФункции

// Заголовок поля, как его видит пользователь в настройках (из доступных полей компоновщика).
Функция ЗаголовокПоля(Поле)

	ДоступноеПоле = КомпоновщикНастроек.Настройки.Отбор.ДоступныеПоляОтбора.НайтиПоле(Поле);
	Если ДоступноеПоле = Неопределено Тогда
		ДоступноеПоле = КомпоновщикНастроек.Настройки.Порядок.ДоступныеПоляПорядка.НайтиПоле(Поле);
	КонецЕсли;

	Возврат ?(ДоступноеПоле = Неопределено, Строка(Поле), ДоступноеПоле.Заголовок);

КонецФункции

// Значение параметра компоновки из полученных настроек (без БСП: в bas_industrialbud нет
// КомпоновкаДанныхКлиентСервер.ПолучитьПараметр).
Функция ЗначениеПараметра(Настройки, ИмяПараметра)

	Параметр = Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);

	Возврат ?(Параметр = Неопределено, Неопределено, Параметр.Значение);

КонецФункции

Функция ПолучитьТаблицуКоманд()

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));

	Возврат Команды;

КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")

	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
