#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Внешний отчёт «Дебіторська заборгованість постачальників за строками боргу та статусами» (BuhBud).
//
// Данные — логика типового отчёта ДебиторскаяЗадолженностьПоставщиковПоСрокамДолгаРасширенная (модуль менеджера:
// ПолучитьТекстЗапроса, УстановитьПараметры, ЗаполнитьПоляВСоответствииСоСпискомИнтервалов,
// ПолучитьПросроченнуюЗадолженность), перенесена один в один. Отличия от типового:
//  - поле Статус по источнику строки: дебетовый остаток расчётов — «Передоплата», поступление без полученного
//    оригинала — «Немає оригіналу»; Статус входит в ключ всех соединений;
//  - отбор по организации — в условии виртуальных таблиц (в типовом его ставил отбор СКД);
//  - интервалы и дата начала учёта в BAS — параметры отчёта (в типовом — ТЧ формы и константа в коде).
//
// ТЗ: _Rarzrabotki/notebook/specs/2026-09-30-debitorka-postachalnykiv-statusy-PROMT.md
// Проверка запроса (Rule #-1): _Rarzrabotki/Python/test/otchet_debitorka_statusy_zapros.py — тот же текст.

#Область СлужебныйПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	МассивНазначений = Новый Массив;
	МассивНазначений.Добавить("");

	ИмяОтчета = Метаданные().Представление();

	ПараметрыРегистрации.Вставить("Вид", "ДополнительныйОтчет");
	ПараметрыРегистрации.Вставить("Назначение", МассивНазначений);
	ПараметрыРегистрации.Вставить("Наименование", ИмяОтчета);
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Истина);
	ПараметрыРегистрации.Вставить("Информация",
		"Дебіторська заборгованість постачальників за строками боргу: передоплата та поставки без оригіналу");

	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд, ИмяОтчета, Метаданные().ПолноеИмя(), "ОткрытиеФормы", Истина);
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);

	Возврат ПараметрыРегистрации;

КонецФункции

// БСП: включить событие ПередЗагрузкойНастроекВКомпоновщик в форме отчёта.
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт

	Настройки.События.ПередЗагрузкойНастроекВКомпоновщик = Истина;

КонецПроцедуры

// БСП: умолчания варианта, которые нельзя хранить в макете внешнего отчёта (ссылки на данные базы при сборке .erf
// превращаются в строки) — дата отчёта, основная организация и рабочие отборы бухгалтера. Заполняются только пустые.
Процедура ПередЗагрузкойНастроекВКомпоновщик(Контекст, КлючСхемы, КлючВарианта, НовыеНастройкиКД, НовыеПользовательскиеНастройкиКД) Экспорт

	Если НовыеНастройкиКД = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Параметр = НовыеНастройкиКД.ПараметрыДанных.Элементы.Найти("Период");
	Если Параметр <> Неопределено И НЕ ЗначениеЗаполнено(Параметр.Значение) Тогда
		Параметр.Значение = НачалоДня(ТекущаяДатаСеанса());
		Параметр.Использование = Истина;
	КонецЕсли;
	Параметр = НовыеНастройкиКД.ПараметрыДанных.Элементы.Найти("Организация");
	Если Параметр <> Неопределено И НЕ ЗначениеЗаполнено(Параметр.Значение) Тогда
		Параметр.Значение = БухгалтерскийУчетПереопределяемый.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация");
		Параметр.Использование = Истина;
	КонецЕсли;

	ОтборыПоУмолчанию = ОтборыПоУмолчанию();
	Для Каждого Элемент Из НовыеНастройкиКД.Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) <> Тип("ЭлементОтбораКомпоновкиДанных")
			ИЛИ Элемент.ВидСравнения <> ВидСравненияКомпоновкиДанных.НеВСписке Тогда
			Продолжить;
		КонецЕсли;
		Значения = ОтборыПоУмолчанию.Получить(Строка(Элемент.ЛевоеЗначение));
		Если Значения <> Неопределено И НЕ ЗначениеЗаполнено(Элемент.ПравоеЗначение) Тогда
			Элемент.ПравоеЗначение = Значения;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Текст основного запроса для заданного количества интервалов (перенос ПолучитьТекстЗапроса типового + Статус).
// Экспортная — чтобы приёмка проверила запрос через COM.
Функция ТекстЗапросаОтчета(КоличествоИнтервалов) Экспорт

	Передоплата = "ВЫРАЗИТЬ(""Передоплата"" КАК СТРОКА(20))";
	ВидыДоговоров = "ВЫРАЗИТЬ(Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВидДоговора В "
		+ "(ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком), "
		+ "ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СКомитентом))";
	РасширениеВТ = "{(Организация).*, (Субконто1).* КАК Контрагент, (Субконто2).* КАК Договор, (Субконто3).* КАК СчетНаОплату}";
	ПоляОстатков = Символы.ПС + Символы.Таб + "NULL," + Символы.ПС + Символы.Таб + "#Д#.СуммаДокумента";
	УсловиеОстатков = "#Д#.Дата МЕЖДУ &ДатаНачалаБас И &Период";

	Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СчетаКонтрагентов.Ссылка КАК Счет
	|ПОМЕСТИТЬ СчетаКД
	|ИЗ
	|	ПланСчетов.Хозрасчетный.ВидыСубконто КАК СчетаКонтрагентов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			ХозрасчетныйВидыСубконто.Ссылка КАК Ссылка
	|		ИЗ
	|			ПланСчетов.Хозрасчетный.ВидыСубконто КАК ХозрасчетныйВидыСубконто
	|		ГДЕ
	|			ХозрасчетныйВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры)) КАК СчетаДоговоров
	|		ПО СчетаКонтрагентов.Ссылка = СчетаДоговоров.Ссылка
	|ГДЕ
	|	СчетаКонтрагентов.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты)
	|	И НЕ СчетаКонтрагентов.Ссылка.Забалансовый
	|	И НЕ СчетаКонтрагентов.Ссылка В ИЕРАРХИИ (&ИсключенныеСчета)
	|	И НЕ СчетаКонтрагентов.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.НалоговыйКредитВсего))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОтправкаПолучениеДокументов.Документ КАК Документ
	|ПОМЕСТИТЬ ПолученныеДоки
	|ИЗ
	|	РегистрСведений.ОтправкаПолучениеДокументов КАК ОтправкаПолучениеДокументов
	|ГДЕ
	|	ОтправкаПолучениеДокументов.ДокументыПолучены
	|	И (ТИПЗНАЧЕНИЯ(ОтправкаПолучениеДокументов.Документ) = ТИП(Документ.ПоступлениеТоваровУслуг)
	|			ИЛИ ТИПЗНАЧЕНИЯ(ОтправкаПолучениеДокументов.Документ) = ТИП(Документ.ПоступлениеДопРасходов))
	|	И ОтправкаПолучениеДокументов.Документ.Организация = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВзаиморасчетыОстатки.Организация КАК Организация,
	|	ВЫРАЗИТЬ(ВзаиморасчетыОстатки.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|	ВЫРАЗИТЬ(ВзаиморасчетыОстатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов) КАК Договор,
	|	ВзаиморасчетыОстатки.Субконто3 КАК СчетНаОплату,
	|	" + Передоплата + " КАК Статус,
	|	ВзаиморасчетыОстатки.Счет КАК Счет,
	|	ВзаиморасчетыОстатки.СуммаРазвернутыйОстатокДт КАК ОстатокДолга0
	|ПОМЕСТИТЬ ВзаиморасчетыОстатки
	|{ВЫБРАТЬ
	|	Организация.*,
	|	Контрагент.*,
	|	Договор.*,
	|	СчетНаОплату.*}
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&Период,
	|			Счет В
	|				(ВЫБРАТЬ
	|					СчетаКД.Счет
	|				ИЗ
	|					СчетаКД КАК СчетаКД),
	|			&ВидыСубконтоКД,
	|			Организация = &Организация
	|				И " + ВидыДоговоров + " " + РасширениеВТ + ") КАК ВзаиморасчетыОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|" + ТекстВеткиДокумента("ПоступлениеТоваровУслуг", ПоляОстатков, УсловиеОстатков) + "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|" + ТекстВеткиДокумента("ПоступлениеДопРасходов", ПоляОстатков, УсловиеОстатков) + "
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	Контрагент,
	|	Договор,
	|	СчетНаОплату";

	ПоляОборотов = Символы.ПС + Символы.Таб + "#Д#.СуммаДокумента";
	Для Индекс = 1 По КоличествоИнтервалов Цикл
		Н = Формат(Индекс, "ЧГ=0");
		УсловиеИнтервала = "(ВЫБОР" + Символы.ПС
			+ Символы.Таб + Символы.Таб + Символы.Таб + "КОГДА &НачалоИнтервала" + Н + " > &ДатаНачалаБас" + Символы.ПС
			+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб
				+ "ТОГДА #Д#.Дата МЕЖДУ &НачалоИнтервала" + Н + " И &КонецИнтервала" + Н + Символы.ПС
			+ Символы.Таб + Символы.Таб + Символы.Таб + "ИНАЧЕ #Д#.Дата МЕЖДУ &ДатаНачалаБас И &КонецИнтервала" + Н + Символы.ПС
			+ Символы.Таб + Символы.Таб + "КОНЕЦ)";
		Текст = Текст + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВзаиморасчетыОбороты.Организация КАК Организация,
		|	ВЫРАЗИТЬ(ВзаиморасчетыОбороты.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
		|	ВЫРАЗИТЬ(ВзаиморасчетыОбороты.Субконто2 КАК Справочник.ДоговорыКонтрагентов) КАК Договор,
		|	ВзаиморасчетыОбороты.Субконто3 КАК СчетНаОплату,
		|	" + Передоплата + " КАК Статус,
		|	ВЫБОР
		|		КОГДА ВзаиморасчетыОбороты.СуммаОборотДт > 0
		|			ТОГДА ВзаиморасчетыОбороты.СуммаОборотДт
		|		ИНАЧЕ 0
		|	КОНЕЦ - ВЫБОР
		|		КОГДА ВзаиморасчетыОбороты.СуммаОборотКт < 0
		|			ТОГДА ВзаиморасчетыОбороты.СуммаОборотКт
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК УвеличениеДолга" + Н + "
		|ПОМЕСТИТЬ Обороты" + Н + "
		|{ВЫБРАТЬ
		|	Организация.*,
		|	Контрагент.*,
		|	Договор.*,
		|	СчетНаОплату.*}
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(
		|			&НачалоИнтервала" + Н + ",
		|			&КонецИнтервала" + Н + ",
		|			,
		|			Счет В
		|				(ВЫБРАТЬ
		|					СчетаКД.Счет
		|				ИЗ
		|					СчетаКД КАК СчетаКД),
		|			&ВидыСубконтоКД,
		|			Организация = &Организация
		|				И " + ВидыДоговоров + " " + РасширениеВТ + ",
		|			,
		|			) КАК ВзаиморасчетыОбороты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|" + ТекстВеткиДокумента("ПоступлениеТоваровУслуг", ПоляОборотов, УсловиеИнтервала) + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|" + ТекстВеткиДокумента("ПоступлениеДопРасходов", ПоляОборотов, УсловиеИнтервала) + "
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Организация,
		|	Контрагент,
		|	Договор,
		|	СчетНаОплату";
	КонецЦикла;

	Текст = Текст + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВзаиморасчетыОстатки.Счет,
	|	ВзаиморасчетыОстатки.Организация,
	|	ВзаиморасчетыОстатки.Контрагент,
	|	ВзаиморасчетыОстатки.Договор,
	|	ВзаиморасчетыОстатки.СчетНаОплату,
	|	ВзаиморасчетыОстатки.Статус,";
	Для Индекс = 1 По КоличествоИнтервалов Цикл
		Н = Формат(Индекс, "ЧГ=0");
		Текст = Текст + Символы.ПС + Символы.Таб
			+ "ЕСТЬNULL(Обороты" + Н + ".УвеличениеДолга" + Н + ", 0) КАК УвеличениеДолга" + Н + ",";
	КонецЦикла;
	Текст = Текст + "
	|	ВзаиморасчетыОстатки.ОстатокДолга0
	|ПОМЕСТИТЬ ОстатокИОбороты
	|ИЗ
	|	ВзаиморасчетыОстатки КАК ВзаиморасчетыОстатки";
	Для Индекс = 1 По КоличествоИнтервалов Цикл
		Н = Формат(Индекс, "ЧГ=0");
		Текст = Текст + "
		|		ЛЕВОЕ СОЕДИНЕНИЕ Обороты" + Н + " КАК Обороты" + Н + "
		|		ПО ВзаиморасчетыОстатки.Организация = Обороты" + Н + ".Организация
		|			И ВзаиморасчетыОстатки.Контрагент = Обороты" + Н + ".Контрагент
		|			И ВзаиморасчетыОстатки.Договор = Обороты" + Н + ".Договор
		|			И ВзаиморасчетыОстатки.СчетНаОплату = Обороты" + Н + ".СчетНаОплату
		|			И ВзаиморасчетыОстатки.Статус = Обороты" + Н + ".Статус";
	КонецЦикла;

	Текст = Текст + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстатокИОбороты.Организация,
	|	ОстатокИОбороты.Контрагент,
	|	ОстатокИОбороты.Договор,
	|	ОстатокИОбороты.СчетНаОплату,
	|	ОстатокИОбороты.Статус,";
	Для Индекс = 1 По КоличествоИнтервалов Цикл
		ТекстПоля = "ОстатокИОбороты.ОстатокДолга0";
		Для ПодИндекс = 1 По Индекс Цикл
			ТекстПоля = ТекстПоля + " - ОстатокИОбороты.УвеличениеДолга" + Формат(ПодИндекс, "ЧГ=0");
		КонецЦикла;
		Текст = Текст + "
		|	ВЫБОР
		|		КОГДА " + ТекстПоля + " > 0
		|			ТОГДА " + ТекстПоля + "
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ОстатокДолга" + Формат(Индекс, "ЧГ=0") + ",";
	КонецЦикла;

	Текст = Текст + "
	|	ОстатокИОбороты.ОстатокДолга0
	|ПОМЕСТИТЬ ОстаткиПоПериодам
	|ИЗ
	|	ОстатокИОбороты КАК ОстатокИОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиПоПериодам.Организация КАК Организация,
	|	ОстаткиПоПериодам.Контрагент КАК Контрагент,
	|	ОстаткиПоПериодам.Договор КАК Договор,
	|	ОстаткиПоПериодам.СчетНаОплату КАК СчетНаОплату,
	|	ОстаткиПоПериодам.Статус КАК Статус,";
	Для Индекс = 1 По КоличествоИнтервалов Цикл
		Текст = Текст + Символы.ПС + Символы.Таб + "ОстаткиПоПериодам.ОстатокДолга" + Формат(Индекс - 1, "ЧН=0; ЧГ=0")
			+ " - ОстаткиПоПериодам.ОстатокДолга" + Формат(Индекс, "ЧГ=0") + " КАК ОстатокПериода" + Формат(Индекс, "ЧГ=0") + ",";
	КонецЦикла;
	Текст = Текст + "
	|	ОстаткиПоПериодам.ОстатокДолга" + Формат(КоличествоИнтервалов, "ЧГ=0") + " КАК ОстатокПериода"
		+ Формат(КоличествоИнтервалов + 1, "ЧГ=0") + ",
	|	ОстаткиПоПериодам.ОстатокДолга0 КАК ОстатокДолга
	|{ВЫБРАТЬ
	|	Организация.*,
	|	Контрагент.*,
	|	Договор.*,
	|	СчетНаОплату.*,
	|	Статус,";
	Для Индекс = 1 По КоличествоИнтервалов + 1 Цикл
		Текст = Текст + Символы.ПС + Символы.Таб + "ОстатокПериода" + Формат(Индекс, "ЧГ=0") + ",";
	КонецЦикла;
	Текст = Текст + "
	|	ОстатокДолга}
	|ИЗ
	|	ОстаткиПоПериодам КАК ОстаткиПоПериодам
	|{ГДЕ
	|	ОстаткиПоПериодам.Организация.*,
	|	ОстаткиПоПериодам.Контрагент.*,
	|	ОстаткиПоПериодам.Договор.*,
	|	ОстаткиПоПериодам.СчетНаОплату.*,
	|	ОстаткиПоПериодам.Статус}";

	Возврат Текст;

КонецФункции

// Просроченная задолженность — внешний набор данных «ПросроченнаяЗадолженность».
// Перенос ПолучитьПросроченнуюЗадолженность типового + Статус в ключах.
Функция ПросроченнаяЗадолженность(Организация, ДатаОтчета, ДатаНачалаБас) Экспорт

	ВидыСубконтоКД = ВидыСубконтоРасчетов();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидыСубконтоКД", ВидыСубконтоКД);
	Запрос.УстановитьПараметр("ГраницаОстатков", Новый Граница(КонецДня(ДатаОтчета), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ДатаНачалаБАС", ДатаНачалаБас);
	Запрос.УстановитьПараметр("ДатаОстатков", КонецДня(ДатаОтчета));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СтандартныйСрокОплатыПокупателей", Константы.СрокОплатыПоставщикам.Получить());
	Запрос.УстановитьПараметр("КонецИнтервала", КонецДня(ДатаОтчета));
	Запрос.УстановитьПараметр("ИсключенныеСчета", ИсключенныеСчета());

	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	ТекстЗапросаПоОстаткам = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СчетаКонтрагентов.Ссылка КАК Счет
	|ПОМЕСТИТЬ СчетаКД
	|ИЗ
	|	ПланСчетов.Хозрасчетный.ВидыСубконто КАК СчетаКонтрагентов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			ХозрасчетныйВидыСубконто.Ссылка КАК Ссылка
	|		ИЗ
	|			ПланСчетов.Хозрасчетный.ВидыСубконто КАК ХозрасчетныйВидыСубконто
	|		ГДЕ
	|			ХозрасчетныйВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры)) КАК СчетаДоговоров
	|		ПО СчетаКонтрагентов.Ссылка = СчетаДоговоров.Ссылка
	|ГДЕ
	|	СчетаКонтрагентов.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты)
	|	И НЕ СчетаКонтрагентов.Ссылка.Забалансовый
	|	И НЕ СчетаКонтрагентов.Ссылка В ИЕРАРХИИ (&ИсключенныеСчета)
	|	И НЕ СчетаКонтрагентов.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.НалоговыйКредитВсего))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОтправкаПолучениеДокументов.Документ КАК Документ
	|ПОМЕСТИТЬ ПолученныеДоки
	|ИЗ
	|	РегистрСведений.ОтправкаПолучениеДокументов КАК ОтправкаПолучениеДокументов
	|ГДЕ
	|	ОтправкаПолучениеДокументов.ДокументыПолучены
	|	И ТИПЗНАЧЕНИЯ(ОтправкаПолучениеДокументов.Документ) = ТИП(Документ.ПоступлениеТоваровУслуг)
	|	И ОтправкаПолучениеДокументов.Документ.Организация = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Организация КАК Организация,
	|	ВложенныйЗапрос.Контрагент КАК Контрагент,
	|	ВложенныйЗапрос.Договор КАК Договор,
	|	ВложенныйЗапрос.СчетНаОплату КАК СчетНаОплату,
	|	ВложенныйЗапрос.Статус КАК Статус,
	|	ВложенныйЗапрос.СрокОплаты КАК СрокОплаты,
	|	ВложенныйЗапрос.СуммаОстаток КАК ОстатокДолга
	|ПОМЕСТИТЬ ОстаткиДолга
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВзаиморасчетыОстатки.Организация КАК Организация,
	|		ВзаиморасчетыОстатки.Субконто1 КАК Контрагент,
	|		ВзаиморасчетыОстатки.Субконто2 КАК Договор,
	|		ВзаиморасчетыОстатки.Субконто3 КАК СчетНаОплату,
	|		ВЫРАЗИТЬ(""Передоплата"" КАК СТРОКА(20)) КАК Статус,
	|		ВЫБОР
	|			КОГДА ВЫРАЗИТЬ(ВзаиморасчетыОстатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).УстановленСрокОплаты
	|				ТОГДА ВЫРАЗИТЬ(ВзаиморасчетыОстатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов).СрокОплаты
	|			ИНАЧЕ &СтандартныйСрокОплатыПокупателей
	|		КОНЕЦ КАК СрокОплаты,
	|		ВзаиморасчетыОстатки.Счет КАК Счет,
	|		ВзаиморасчетыОстатки.СуммаРазвернутыйОстатокДт КАК СуммаОстаток
	|	ИЗ
	|		РегистрБухгалтерии.Хозрасчетный.Остатки(
	|				&ГраницаОстатков,
	|				Счет В
	|					(ВЫБРАТЬ
	|						СчетаКД.Счет
	|					ИЗ
	|						СчетаКД КАК СчетаКД),
	|				&ВидыСубконтоКД,
	|				ВЫРАЗИТЬ(Субконто2 КАК Справочник.ДоговорыКонтрагентов).ВидДоговора В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СКомитентом))
	|					И Организация = &Организация) КАК ВзаиморасчетыОстатки
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ПоступлениеТоваровУслуг.Организация,
	|		ПоступлениеТоваровУслуг.Контрагент,
	|		ПоступлениеТоваровУслуг.ДоговорКонтрагента,
	|		ПоступлениеТоваровУслуг.Ссылка,
	|		ВЫРАЗИТЬ(""Немає оригіналу"" КАК СТРОКА(20)),
	|		&СтандартныйСрокОплатыПокупателей,
	|		NULL,
	|		ПоступлениеТоваровУслуг.СуммаДокумента
	|	ИЗ
	|		Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|	ГДЕ
	|		ПоступлениеТоваровУслуг.Организация = &Организация
	|		И ПоступлениеТоваровУслуг.Проведен
	|		И НЕ ПоступлениеТоваровУслуг.Ссылка В
	|					(ВЫБРАТЬ
	|						ПолученныеДоки.Документ КАК Документ
	|					ИЗ
	|						ПолученныеДоки КАК ПолученныеДоки)
	|		И ПоступлениеТоваровУслуг.Дата МЕЖДУ &ДатаНачалаБАС И &ДатаОстатков) КАК ВложенныйЗапрос
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент,
	|	Договор,
	|	СчетНаОплату
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ОстаткиДолга.СрокОплаты КАК СрокОплаты
	|ИЗ
	|	ОстаткиДолга КАК ОстаткиДолга
	|
	|УПОРЯДОЧИТЬ ПО
	|	СрокОплаты";
	Запрос.Текст = ТекстЗапросаПоОстаткам;

	МассивСроковОплаты = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СрокОплаты");
	Если МассивСроковОплаты.Количество() = 0 Тогда
		МассивСроковОплаты.Добавить(0);
	КонецЕсли;

	ТекстОстатки =
	"ВЫБРАТЬ
	|	ОстаткиДолга.Организация,
	|	ОстаткиДолга.Контрагент,
	|	ОстаткиДолга.Договор,
	|	ОстаткиДолга.СчетНаОплату,
	|	ОстаткиДолга.Статус,
	|	ОстаткиДолга.СрокОплаты,
	|	ОстаткиДолга.ОстатокДолга,
	|	СУММА(ЕСТЬNULL(Обороты.УвеличениеДолга, 0)) КАК УвеличениеДолга
	|ИЗ
	|	ОстаткиДолга КАК ОстаткиДолга";

	ТекстОборотыПоСроку =
	"ВЫБРАТЬ
	|	ВзаиморасчетыОбороты.Организация КАК Организация,
	|	ВзаиморасчетыОбороты.Субконто1 КАК Контрагент,
	|	ВзаиморасчетыОбороты.Субконто2 КАК Договор,
	|	ВзаиморасчетыОбороты.Субконто3 КАК СчетНаОплату,
	|	ВЫРАЗИТЬ(""Передоплата"" КАК СТРОКА(20)) КАК Статус,
	|	ВЫБОР
	|		КОГДА ВзаиморасчетыОбороты.СуммаОборотДт > 0
	|			ТОГДА ВзаиморасчетыОбороты.СуммаОборотДт
	|		ИНАЧЕ 0
	|	КОНЕЦ - ВЫБОР
	|		КОГДА ВзаиморасчетыОбороты.СуммаОборотКт < 0
	|			ТОГДА ВзаиморасчетыОбороты.СуммаОборотКт
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК УвеличениеДолга
	|ПОМЕСТИТЬ Обороты1
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			&НачалоИнтервала1,
	|			&КонецИнтервала,
	|			,
	|			Счет В
	|				(ВЫБРАТЬ
	|					СчетаКД.Счет
	|				ИЗ
	|					СчетаКД КАК СчетаКД),
	|			&ВидыСубконтоКД,
	|			(Субконто1, Субконто2, Субконто3) В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ОстаткиДолга.Контрагент,
	|						ОстаткиДолга.Договор,
	|						ОстаткиДолга.СчетНаОплату
	|					ИЗ
	|						ОстаткиДолга КАК ОстаткиДолга
	|					ГДЕ
	|						ОстаткиДолга.СрокОплаты = &СрокОплаты1)
	|				И Организация = &Организация,
	|			,
	|			) КАК ВзаиморасчетыОбороты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВзаиморасчетыОбороты.Организация,
	|	ВзаиморасчетыОбороты.Субконто1,
	|	ВзаиморасчетыОбороты.Субконто2,
	|	ВзаиморасчетыОбороты.Субконто3,
	|	ВЫРАЗИТЬ(""Передоплата"" КАК СТРОКА(20)),
	|	-(ВЫБОР
	|		КОГДА ВзаиморасчетыОбороты.СуммаОборотКт > 0
	|			ТОГДА ВзаиморасчетыОбороты.СуммаОборотКт
	|		ИНАЧЕ 0
	|	КОНЕЦ - ВЫБОР
	|		КОГДА ВзаиморасчетыОбороты.СуммаОборотДт < 0
	|			ТОГДА ВзаиморасчетыОбороты.СуммаОборотДт
	|		ИНАЧЕ 0
	|	КОНЕЦ)
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			&НачалоИнтервала1,
	|			&КонецИнтервала,
	|			,
	|			Счет В
	|				(ВЫБРАТЬ
	|					СчетаКД.Счет
	|				ИЗ
	|					СчетаКД КАК СчетаКД),
	|			&ВидыСубконтоКД,
	|			(Субконто1, Субконто2, Субконто3) В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ОстаткиДолга.Контрагент,
	|						ОстаткиДолга.Договор,
	|						ОстаткиДолга.СчетНаОплату
	|					ИЗ
	|						ОстаткиДолга КАК ОстаткиДолга
	|					ГДЕ
	|						ОстаткиДолга.СрокОплаты = &СрокОплаты1)
	|				И Организация = &Организация,
	|			,
	|			&ВидыСубконтоКД) КАК ВзаиморасчетыОбороты
	|ГДЕ
	|	ВзаиморасчетыОбороты.Субконто1 = ВзаиморасчетыОбороты.КорСубконто1
	|	И ВзаиморасчетыОбороты.Субконто2 = ВзаиморасчетыОбороты.КорСубконто2
	|	И ВзаиморасчетыОбороты.Субконто3 = ВзаиморасчетыОбороты.КорСубконто3
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Организация,
	|	ПоступлениеТоваровУслуг.Контрагент,
	|	ПоступлениеТоваровУслуг.ДоговорКонтрагента,
	|	ПоступлениеТоваровУслуг.Ссылка,
	|	ВЫРАЗИТЬ(""Немає оригіналу"" КАК СТРОКА(20)),
	|	ПоступлениеТоваровУслуг.СуммаДокумента
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	ПоступлениеТоваровУслуг.Организация = &Организация
	|	И ПоступлениеТоваровУслуг.Проведен
	|	И НЕ ПоступлениеТоваровУслуг.Ссылка В
	|				(ВЫБРАТЬ
	|					ПолученныеДоки.Документ КАК Документ
	|				ИЗ
	|					ПолученныеДоки КАК ПолученныеДоки)
	|	И ВЫБОР
	|			КОГДА &НачалоИнтервала1 > &ДатаНачалаБас
	|				ТОГДА ПоступлениеТоваровУслуг.Дата МЕЖДУ &НачалоИнтервала1 И &КонецИнтервала
	|			ИНАЧЕ ПоступлениеТоваровУслуг.Дата МЕЖДУ &ДатаНачалаБас И &КонецИнтервала
	|		КОНЕЦ";

	МаксКоличествоЧастей = 10;
	КоличествоСроковОплаты = МассивСроковОплаты.Количество();
	ОстатокОтДеления = КоличествоСроковОплаты % МаксКоличествоЧастей;
	КоличествоЧастей = (КоличествоСроковОплаты - ОстатокОтДеления) / МаксКоличествоЧастей + ?(ОстатокОтДеления > 0, 1, 0);

	ТекстОборотыПоВсемСрокам = "";
	ТекстВсеОбороты = "";
	Для ИндексЧасти = 1 По КоличествоЧастей Цикл
		НачальныйИндекс = МаксКоличествоЧастей * (ИндексЧасти - 1) + 1;
		КонечныйИндекс = Мин(КоличествоСроковОплаты, МаксКоличествоЧастей * ИндексЧасти);
		ТекстОбороты = "";
		Часть = Формат(ИндексЧасти, "ЧГ=0");

		Для ИндексЗапроса = НачальныйИндекс По КонечныйИндекс Цикл
			НомерСрока = Формат(ИндексЗапроса, "ЧГ=0");
			СрокОплаты = МассивСроковОплаты[ИндексЗапроса - 1];
			Запрос.УстановитьПараметр("НачалоИнтервала" + НомерСрока, НачалоДня(ДатаОтчета - (СрокОплаты - 1) * 60 * 60 * 24));
			Запрос.УстановитьПараметр("СрокОплаты" + НомерСрока, СрокОплаты);

			ТекстОборотыПоСрокуНом = СтрЗаменить(ТекстОборотыПоСроку, "&НачалоИнтервала1", "&НачалоИнтервала" + НомерСрока);
			ТекстОборотыПоСрокуНом = СтрЗаменить(ТекстОборотыПоСрокуНом, "&СрокОплаты1", "&СрокОплаты" + НомерСрока);
			Если ИндексЗапроса = НачальныйИндекс Тогда
				ТекстОборотыПоСрокуНом = СтрЗаменить(ТекстОборотыПоСрокуНом, "ПОМЕСТИТЬ Обороты1", "ПОМЕСТИТЬ Обороты" + Часть);
			Иначе
				ТекстОборотыПоСрокуНом = СтрЗаменить(ТекстОборотыПоСрокуНом, "ПОМЕСТИТЬ Обороты1", "");
			КонецЕсли;

			ТекстОбороты = ТекстОбороты
				+ ?(ПустаяСтрока(ТекстОбороты), "", "
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|")
				+ ТекстОборотыПоСрокуНом;
		КонецЦикла;

		ТекстВсеОбороты = ТекстВсеОбороты + ТекстОбороты + "
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Организация,
		|	Контрагент,
		|	Договор,
		|	СчетНаОплату
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|";

		ТекстОборотыПоВсемСрокам = ТекстОборотыПоВсемСрокам
			+ ?(ПустаяСтрока(ТекстОборотыПоВсемСрокам), "", "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|")
			+ "
			|ВЫБРАТЬ
			|	Обороты" + Часть + ".Организация,
			|	Обороты" + Часть + ".Контрагент,
			|	Обороты" + Часть + ".Договор,
			|	Обороты" + Часть + ".СчетНаОплату,
			|	Обороты" + Часть + ".Статус,
			|	Обороты" + Часть + ".УвеличениеДолга
			|ИЗ
			|	Обороты" + Часть + " КАК Обороты" + Часть;
	КонецЦикла;

	ТекстОстаткиИОбороты = ТекстОстатки + "
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	(" + ТекстОборотыПоВсемСрокам + ") КАК Обороты
	|	ПО ОстаткиДолга.Организация = Обороты.Организация
	|		И ОстаткиДолга.Контрагент = Обороты.Контрагент
	|		И ОстаткиДолга.Договор = Обороты.Договор
	|		И ОстаткиДолга.СчетНаОплату = Обороты.СчетНаОплату
	|		И ОстаткиДолга.Статус = Обороты.Статус
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиДолга.Организация,
	|	ОстаткиДолга.Контрагент,
	|	ОстаткиДолга.Договор,
	|	ОстаткиДолга.СчетНаОплату,
	|	ОстаткиДолга.Статус,
	|	ОстаткиДолга.ОстатокДолга,
	|	ОстаткиДолга.СрокОплаты";

	ТекстПросрочено =
	"ВЫБРАТЬ
	|	ОстаткиИОбороты.Организация,
	|	ОстаткиИОбороты.Контрагент,
	|	ОстаткиИОбороты.Договор,
	|	ОстаткиИОбороты.СчетНаОплату,
	|	ОстаткиИОбороты.Статус,
	|	ОстаткиИОбороты.СрокОплаты,
	|	ОстаткиИОбороты.ОстатокДолга,
	|	ОстаткиИОбороты.ОстатокДолга -
	|		ВЫБОР
	|			КОГДА ОстаткиИОбороты.ОстатокДолга < ОстаткиИОбороты.УвеличениеДолга
	|				ТОГДА ОстаткиИОбороты.ОстатокДолга
	|			ИНАЧЕ ОстаткиИОбороты.УвеличениеДолга
	|		КОНЕЦ КАК ПросроченнаяЗадолженность
	|ИЗ
	|	(" + ТекстОстаткиИОбороты + ") КАК ОстаткиИОбороты
	|ГДЕ
	|	ОстаткиИОбороты.ОстатокДолга -
	|		ВЫБОР
	|			КОГДА ОстаткиИОбороты.ОстатокДолга < ОстаткиИОбороты.УвеличениеДолга
	|				ТОГДА ОстаткиИОбороты.ОстатокДолга
	|			ИНАЧЕ ОстаткиИОбороты.УвеличениеДолга
	|		КОНЕЦ > 0";

	Запрос.Текст = ТекстВсеОбороты + ТекстПросрочено;

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СформироватьОтчет(ДокументРезультат, ДанныеРасшифровки);

КонецПроцедуры

// Экспортная точка входа — то же, что ПриКомпоновкеРезультата: приёмка вызывает её через COM
// (обработчик события COM-прокси не отдаёт).
Процедура СформироватьОтчет(ДокументРезультат, ДанныеРасшифровки = Неопределено) Экспорт

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();

	ДатаОтчета = ЗначениеПараметра(Настройки, "Период");
	ДатаОтчета = НачалоДня(?(ЗначениеЗаполнено(ДатаОтчета), ДатаОтчета, ТекущаяДатаСеанса()));

	ОрганизацияОтчета = ЗначениеПараметра(Настройки, "Организация");
	Если НЕ ЗначениеЗаполнено(ОрганизацияОтчета) Тогда
		ОрганизацияОтчета = БухгалтерскийУчетПереопределяемый.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ОрганизацияОтчета) Тогда
		ВызватьИсключение НСтр("ru = 'Вкажіть організацію.'; uk = 'Вкажіть організацію.'");
	КонецЕсли;

	ДатаНачалаБас = ЗначениеПараметра(Настройки, "ДатаНачалаБас");
	Если НЕ ЗначениеЗаполнено(ДатаНачалаБас) Тогда
		ДатаНачалаБас = Дата(2023, 7, 1);
	КонецЕсли;

	Интервалы = РазобратьИнтервалы(ЗначениеПараметра(Настройки, "Интервалы"));

	СхемаОтчета = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	СхемаОтчета.НаборыДанных.ОсновнойНабор.Запрос = ТекстЗапросаОтчета(Интервалы.Количество());
	НастроитьПоляИнтервалов(СхемаОтчета, Настройки, Интервалы);
	УстановитьПараметрыСхемы(СхемаОтчета, Настройки, ДатаОтчета, ОрганизацияОтчета, ДатаНачалаБас, Интервалы);

	ВнешниеНаборыДанных = Новый Структура("ПросроченнаяЗадолженность",
		ПросроченнаяЗадолженность(ОрганизацияОтчета, ДатаОтчета, ДатаНачалаБас));

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаОтчета, Настройки, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ДокументРезультат.Очистить();
	ВывестиШапку(ДокументРезультат, Настройки, ОрганизацияОтчета, ДатаОтчета);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстВеткиДокумента(ИмяДокумента, ПоляПослеСтатуса, УсловиеДаты)

	ТекстВетки = "
	|ВЫБРАТЬ
	|	#Д#.Организация,
	|	#Д#.Контрагент,
	|	#Д#.ДоговорКонтрагента,
	|	#Д#.Ссылка,
	|	ВЫРАЗИТЬ(""Немає оригіналу"" КАК СТРОКА(20)),#ПОЛЯ#
	|ИЗ
	|	Документ.#Д# КАК #Д#
	|ГДЕ
	|	#Д#.Организация = &Организация
	|	И #Д#.Проведен
	|	И НЕ #Д#.Ссылка В
	|				(ВЫБРАТЬ
	|					ПолученныеДоки.Документ КАК Документ
	|				ИЗ
	|					ПолученныеДоки КАК ПолученныеДоки)
	|	И #УСЛОВИЕ#";
	ТекстВетки = СтрЗаменить(ТекстВетки, "#ПОЛЯ#", ПоляПослеСтатуса);
	ТекстВетки = СтрЗаменить(ТекстВетки, "#УСЛОВИЕ#", УсловиеДаты);

	Возврат СтрЗаменить(ТекстВетки, "#Д#", ИмяДокумента);

КонецФункции

Функция ВидыСубконтоРасчетов()

	ВидыСубконто = Новый СписокЗначений;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ДокументыРасчетовСКонтрагентами);

	Возврат ВидыСубконто;

КонецФункции

Функция ИсключенныеСчета()

	// Персональная настройка пользователя «Настройка рахунків обліку розрахунків з постачальниками» (как в типовом).
	СписокСчетов = БухгалтерскиеОтчетыВызовСервера.ПолучитьСписокСчетовИсключаемыхИзРасчетаЗадолженности(2);
	Если СписокСчетов = Неопределено Тогда
		Возврат Новый СписокЗначений;
	ИначеЕсли ТипЗнч(СписокСчетов) = Тип("Массив") Тогда
		Список = Новый СписокЗначений;
		Список.ЗагрузитьЗначения(СписокСчетов);
		Возврат Список;
	КонецЕсли;

	Возврат СписокСчетов;

КонецФункции

