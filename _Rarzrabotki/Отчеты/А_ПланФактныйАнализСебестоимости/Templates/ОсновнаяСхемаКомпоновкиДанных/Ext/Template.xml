////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Сводная.Подразделение КАК Подразделение,
	Сводная.Документ КАК Документ,
	Сводная.ОбщееНазвание КАК ОбщееНазвание,
	Сводная.Номенклатура КАК Номенклатура,
	Сводная.Единица КАК Единица,
	Сводная.КоличествоСС КАК КоличествоСС,
	Сводная.СуммаСС КАК СуммаСС,
	Сводная.Количество КАК Количество,
	Сводная.Сумма КАК Сумма,
	Сводная.Количество - Сводная.КоличествоСС КАК РазницаКоличество,
	Сводная.Сумма - Сводная.СуммаСС КАК РазницаСумма,
	ВЫБОР
		КОГДА Сводная.КоличествоСС = 0
			ТОГДА NULL
		ИНАЧЕ (Сводная.Количество - Сводная.КоличествоСС) / Сводная.КоличествоСС * 100
	КОНЕЦ КАК ПроцентОтклонениеКол,
	ВЫБОР
		КОГДА Сводная.СуммаСС = 0
			ТОГДА NULL
		ИНАЧЕ (Сводная.Сумма - Сводная.СуммаСС) / Сводная.СуммаСС * 100
	КОНЕЦ КАК ПроцентОтклонениеСум
ИЗ
	Сводная КАК Сводная

УПОРЯДОЧИТЬ ПО
	Подразделение,
	ОбщееНазвание,
	Номенклатура</query>
