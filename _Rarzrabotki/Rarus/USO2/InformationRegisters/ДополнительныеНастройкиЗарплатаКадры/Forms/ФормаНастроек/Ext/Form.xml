										<v8:lang>ru</v8:lang>
										<v8:content>По месяцам расчета зарплаты</v8:content>
									</v8:item>
									<v8:item>
										<v8:lang>en</v8:lang>
										<v8:content>By salary calculation months</v8:content>
									</v8:item>
								</Presentation>
								<Value xsi:type="xr:DesignTimeRef">Enum.ВариантыОтраженияВзаиморасчетовССотрудниками.EnumValue.ПоМесяцамРасчетаЗарплаты</Value>
