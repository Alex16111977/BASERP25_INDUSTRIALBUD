
#Область ПрограммныйИнтерфейс

// Записывает дату окончания в регистр сведений "СМ_ОтветственныеЛица"
//
// Параметры:
//     СтруктураДляПередачи	- Структура - содержит данные для заполнения.
//
Процедура ЗаписатьДатуОкончания(СтруктураДляПередачи) Экспорт
	
	Попытка
		Запись=РегистрыСведений.СМ_ОтветственныеЛица.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, СтруктураДляПередачи);
		Запись.ДатаОкончания=ТекущаяДата();
		Запись.Записать();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при записи даты окончания полномочий ответственного",,,,);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти