
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Если Не Параметры.Просмотр Тогда
		СсылкаНаОбъект = Параметры.Ссылка;
		СравниваемыеВерсии = Параметры.СравниваемыеВерсии;
		ТолькоОтклонения = Параметры.ТолькоОтклонения;
		ТолькоРасчет = Параметры.ТолькоРасчет;
		
		СравниваемыеВерсии.СортироватьПоЗначению();
		Если СравниваемыеВерсии.Количество() > 1 Тогда
			СтрокаНомераВерсий = "";
			Для Каждого Версия Из СравниваемыеВерсии Цикл
				СтрокаНомераВерсий = СтрокаНомераВерсий + Строка(Версия.Представление) + ", ";
			КонецЦикла;
			
			СтрокаНомераВерсий = Лев(СтрокаНомераВерсий, СтрДлина(СтрокаНомераВерсий) - 2);
			
			Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Сравнение версий ""%1"" (№№ %2)'"),
			ОбщегоНазначения.ПредметСтрокой(СсылкаНаОбъект), СтрокаНомераВерсий);
		Иначе
			Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Версия объекта ""%1"" №%2'"),
			СсылкаНаОбъект, Строка(СравниваемыеВерсии[0].Представление));
		КонецЕсли;
		
		СформироватьОтчет(ТаблицаОтчета, СравниваемыеВерсии,ТолькоОтклонения,ТолькоРасчет);
	Иначе
		СсылкаНаОбъект = Параметры.Ссылка;
		СравниваемыеВерсии = Параметры.СравниваемыеВерсии;
		СравниваемыеВерсии.СортироватьПоЗначению();
		Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Просмотр версии №%2 объекта ""%1""'"),
		СсылкаНаОбъект, Строка(СравниваемыеВерсии[0].Представление));
		СформироватьОтчетПросмотр(ТаблицаОтчета, СравниваемыеВерсии[0]);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основная функция модуля, отвечающая за формирование отчета.
// В зависимости от числа версий в массиве вызывает либо функциональность
// формирования отчета по одной версии либо функциональность формирования
// отчета по изменениям между несколькими версиями.
//
&НаСервере
Процедура СформироватьОтчет(ТЧОтчета, СравниваемыеВерсии,ТолькоОтклонения,ТолькоРасчет)
	
	// Сверка по экспертизе.
	// СформироватьОтчетПоИзменениям(ТЧОтчета, СравниваемыеВерсии);
	
	// Сверка через сравнение.
	СформироватьОтчетПоСравнению(ТЧОтчета, СравниваемыеВерсии,ТолькоОтклонения,ТолькоРасчет);
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Функции для получения отчета по изменениям.
&НаСервере
Процедура СформироватьОтчетПоСравнению(ТЧОтчета, Знач СписокВерсий,ТолькоОтклонения,ТолькоРасчет)
	
	
	ТЧОтчета.Очистить();
	
	// Формируем массив номеров версий (так как некоторые могут отсутствовать
	// и иметь непоследовательную нумерацию), массив отсортирован по возрастанию.
	МассивНомеровВерсий = СписокВерсий.ВыгрузитьЗначения();
	
	НачатьТранзакцию();
	// Формируем начальные версии объекта, значения которых показываются всегда
	// (при наличии последующих изменений).
	ВерсияОбъекта_Пред = СчитатьНачальныеЗначенияРеквизитовИТабличныхЧастейСравнение(МассивНомеровВерсий[0]);
	
	Если ВерсияОбъекта_Пред.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	// СУДАРИКОВ:
	// может быть так что смета подчинена ОС и тогда ОС тоже будет в таблице
	МассивСмета2 = ВерсияОбъекта_Пред.НайтиСтроки(Новый Структура("ТипОбъекта, ИдРодителя", "СМ_ЛокальнаяСмета", Неопределено));
	Если МассивСмета2.Количество() > 0 Тогда
		Смета2 = МассивСмета2[МассивСмета2.Количество()-1].Ссылка.Ссылка;
	Иначе
		
		МассивСмета2 = ВерсияОбъекта_Пред.НайтиСтроки(Новый Структура("ТипОбъекта", "СМ_ЛокальнаяСмета"));
		Если МассивСмета2.Количество() > 0 Тогда
			Смета2 = МассивСмета2[МассивСмета2.Количество()-1].Ссылка.Ссылка;
		Иначе
			Возврат;
		КонецЕсли;

	КонецЕсли;
	
	Если МассивНомеровВерсий.Количество()>1 Тогда
		ВерсияОбъекта_Тек = СчитатьНачальныеЗначенияРеквизитовИТабличныхЧастейСравнение(МассивНомеровВерсий[1]);
		Если ВерсияОбъекта_Тек.Количество()=0 Тогда
			Смета1 = Параметры.Ссылка;
		Иначе
			// СУДАРИКОВ:
			// может быть так что смета подчинена ОС и тогда ОС тоже будет в таблице
			МассивСмета1 = ВерсияОбъекта_Тек.НайтиСтроки(Новый Структура("ТипОбъекта, ИдРодителя", "СМ_ЛокальнаяСмета", Неопределено));
			Если МассивСмета1.Количество() > 0 Тогда
				Смета1 = МассивСмета1[МассивСмета1.Количество()-1].Ссылка.Ссылка;
			Иначе
				МассивСмета1 = ВерсияОбъекта_Тек.НайтиСтроки(Новый Структура("ТипОбъекта", "СМ_ЛокальнаяСмета"));
				Если МассивСмета1.Количество() > 0 Тогда
					Смета1 = МассивСмета1[МассивСмета1.Количество()-1].Ссылка.Ссылка;
				Иначе
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Смета1 = Параметры.Ссылка;
	КонецЕсли;
	
	ПоляПозиции = Новый ТаблицаЗначений;
	ПоляПозиции.Колонки.Добавить("Поиск");
	ПоляПозиции.Колонки.Добавить("ИмяРеквизита");
	ПоляПозиции.Колонки.Добавить("ИмяРеквизитаДоп");
	
	НовСтрока = ПоляПозиции.Добавить();
	НовСтрока.ИмяРеквизита = "ОбоснСметнойСтоим1";
	НовСтрока.ИмяРеквизитаДоп = "ОбоснСметнойСтоим";
	НовСтрока.Поиск = Истина;

	НовСтрока = ПоляПозиции.Добавить();
	НовСтрока.ИмяРеквизита = "Наименование1";
	НовСтрока.ИмяРеквизитаДоп = "Наименование";
	НовСтрока.Поиск = Истина;

	НовСтрока = ПоляПозиции.Добавить();
	НовСтрока.ИмяРеквизита = "Измеритель1";
	НовСтрока.ИмяРеквизитаДоп = "Измеритель";
	НовСтрока.Поиск = Истина;

	ПараметрыВызоваСервера = Новый Структура();
	ПараметрыВызоваСервера.Вставить("ПоляПозиции", ПоляПозиции);
	ПараметрыВызоваСервера.Вставить("ТолькоОтклонения", ТолькоОтклонения);
	ПараметрыВызоваСервера.Вставить("ТолькоРасчет", ТолькоРасчет);
	ПараметрыВызоваСервера.Вставить("ШаблонСДанными", ТаблицаОтчета);
	ПараметрыВызоваСервера.Вставить("СметыСравнения", Новый Структура("Смета1,Смета2",Смета1,Смета2));
	ПараметрыВызоваСервера.Вставить("СравнениеПоАкту", Ложь);
		
	АдресХранилища = "";
	Обработки.СМ_СравнениеСмет.СравнитьСметы(ПараметрыВызоваСервера,АдресХранилища);
	ОтменитьТранзакцию();
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчетПросмотр(ТЧОтчета, Версия)
	
	ТЧОтчета.Очистить();
	
	НачатьТранзакцию();
	// Формируем начальные версии объекта, значения которых показываются всегда
	// (при наличии последующих изменений).
	ВерсияОбъекта = СчитатьНачальныеЗначенияРеквизитовИТабличныхЧастейСравнениеПросмотр(Версия);
	
	Если ВерсияОбъекта.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивСмета = ВерсияОбъекта.НайтиСтроки(Новый Структура("ТипОбъекта, ИдРодителя", "СМ_ЛокальнаяСмета", Неопределено));
	Если МассивСмета.Количество() > 0 Тогда
		Смета = МассивСмета[МассивСмета.Количество()-1].Ссылка.Ссылка;
	Иначе
		МассивСмета = ВерсияОбъекта.НайтиСтроки(Новый Структура("ТипОбъекта", "СМ_ЛокальнаяСмета"));
		Если МассивСмета.Количество() > 0 Тогда
			Смета = МассивСмета[МассивСмета.Количество()-1].Ссылка.Ссылка;
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыВызоваСервера = Новый Структура();
	ПараметрыВызоваСервера.Вставить("ШаблонСДанными", ТаблицаОтчета);
	ПараметрыВызоваСервера.Вставить("Смета", Смета);
	АдресХранилища = "";
	Обработки.СМ_СравнениеСмет.ПоказатьСмету(ПараметрыВызоваСервера,АдресХранилища,Ложь);
	ОтменитьТранзакцию();
	
КонецПроцедуры

&НаСервере
Функция ПредставлениеОбъекта(ДанныеОбъекта)
	Если ТипЗнч(ДанныеОбъекта) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Смета №%1 %2'"), Строка(ДанныеОбъекта.НомерСметы), Строка(ДанныеОбъекта.Наименование));
	ИначеЕсли ТипЗнч(ДанныеОбъекта) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Объектная смета №%1 %2'"), Строка(ДанныеОбъекта.НомерСметы), Строка(ДанныеОбъекта.Наименование));
	ИначеЕсли ТипЗнч(ДанныеОбъекта) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Сводная смета №%1 %2'"), Строка(ДанныеОбъекта.НомерСметы), (ДанныеОбъекта.Наименование));
	ИначеЕсли ТипЗнч(ДанныеОбъекта) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1 %2 %3 %4'"), Строка(ДанныеОбъекта.ШифрРасценки), Строка(ДанныеОбъекта.Наименование), Строка(ДанныеОбъекта.ЕдиницаИзмерения), Строка(ДанныеОбъекта.ТипНормативныхСборников));
	ИначеЕсли ТипЗнч(ДанныеОбъекта) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
		ИЛИ ТипЗнч(ДанныеОбъекта) = Тип("ДокументОбъект.СМ_РазделЛокальнойСметы") Тогда
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Раздел %1'"), Строка(ДанныеОбъекта.НаименованиеДляПечати));
	КонецЕсли;
	Возврат Представление;
КонецФункции

&НаСервере
Процедура ВывестиОбластьМассы(ТабДок,Макет,ОбластьСтрок,СтрокаМасс)
	Если СтрокаМасс.МассаН<>Неопределено ИЛИ СтрокаМасс.МассаН_СНБ<>Неопределено Тогда
		ОбластьСтроки = ОбластьСтрок.ОбластьНетто;
		ОбластьСтроки.Параметры.МассаН = "";
		ОбластьСтроки.Параметры.МассаН_СНБ = "";
		ОбластьСтроки.Параметры.Заполнить(СтрокаМасс);
		ТабДок.Вывести(ОбластьСтроки);
	КонецЕсли;
	Если СтрокаМасс.МассаБ<>Неопределено ИЛИ СтрокаМасс.МассаБ_СНБ<>Неопределено Тогда
		ОбластьСтроки = ОбластьСтрок.ОбластьБрутто;
		ОбластьСтроки.Параметры.МассаЮ = "";
		ОбластьСтроки.Параметры.МассаБ_СНБ = "";
		ОбластьСтроки.Параметры.Заполнить(СтрокаМасс);
		ТабДок.Вывести(ОбластьСтроки);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВывестиОбластьПодвал(ТабДок,Макет)
	ОбластьМакета = Макет.ПолучитьОбласть("Пунктирная");
	ТабДок.Вывести(ОбластьМакета);
КонецПроцедуры

&НаСервере
Функция СчитатьНачальныеЗначенияРеквизитовИТабличныхЧастейСравнение(Версия)
	
	// Выполняем разбор версии.
	ВерсияОбъекта  = СМ_ВерсионированиеСервер.РазборВерсии(СсылкаНаОбъект,Версия,Истина);
	
	Возврат ВерсияОбъекта;
	
КонецФункции

&НаСервере
Функция СчитатьНачальныеЗначенияРеквизитовИТабличныхЧастейСравнениеПросмотр(Версия)
	
	// Выполняем разбор версии.
	ВерсияОбъекта  = СМ_ВерсионированиеСервер.РазборВерсии(СсылкаНаОбъект,Версия.Значение,Истина);
	
	Возврат ВерсияОбъекта;
	
КонецФункции

