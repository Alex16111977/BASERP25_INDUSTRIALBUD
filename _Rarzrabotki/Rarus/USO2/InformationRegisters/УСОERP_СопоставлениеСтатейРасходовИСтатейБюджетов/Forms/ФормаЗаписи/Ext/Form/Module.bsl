
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновитьКодСДР();
	
	Если ЗначениеЗаполнено(Запись.Работа)
		И Параметры.Ключ.Пустой() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УСОERP_СтроительныеРаботы.Владелец.Организация КАК Организация,
		|	УСОERP_СтроительныеРаботы.Владелец.Владелец КАК ОбъектСтроительства
		|ИЗ
		|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
		|ГДЕ
		|	УСОERP_СтроительныеРаботы.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Запись.Работа);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
	КонецЕсли;
	
	Элементы.Работа.ТолькоПросмотр = (НЕ ЗначениеЗаполнено(Запись.ОбъектСтроительства) И НЕ ЗначениеЗаполнено(Запись.Работа)) ;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РаботаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(Запись.ОбъектСтроительства) тогда
		РабочийСценарий = ПолучитьРабочийСценарийОбъекта();
		
		Если Не ЗначениеЗаполнено(РабочийСценарий) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить рабочий сценарий планирования для объекта строительства: " +
						СокрЛП(Запись.ОбъектСтроительства) + ", по организации: " + СокрЛП(Запись.Организация) + ".");
			
			Возврат;
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("СценарийПланирования", РабочийСценарий);
		//ПараметрыФормы.Вставить("Организация", Запись.Организация);
		
		ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.ФормаВыбора", ПараметрыФормы, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаботаПриИзменении(Элемент)
	
	ОбновитьКодСДР();
	Элементы.Работа.ТолькоПросмотр = (НЕ ЗначениеЗаполнено(Запись.ОбъектСтроительства) И НЕ ЗначениеЗаполнено(Запись.Работа)) ;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектСтроительстваПриИзменении(Элемент)
	
	Элементы.Работа.ТолькоПросмотр = (НЕ ЗначениеЗаполнено(Запись.ОбъектСтроительства) И НЕ ЗначениеЗаполнено(Запись.Работа)) ;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьРабочийСценарийОбъекта()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_СценарииПланированияПроектовСтроительства.Ссылка КАК Сценарий
	|ИЗ
	|	Справочник.УСОERP_СценарииПланированияПроектовСтроительства КАК УСОERP_СценарииПланированияПроектовСтроительства
	|ГДЕ
	|	УСОERP_СценарииПланированияПроектовСтроительства.Организация = &Организация
	|	И УСОERP_СценарииПланированияПроектовСтроительства.ВидСценария = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыСценариевПланирования.Рабочий)
	|	И УСОERP_СценарииПланированияПроектовСтроительства.Владелец = &ОбъектСтроительства
	|	И УСОERP_СценарииПланированияПроектовСтроительства.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Организация", Запись.Организация);
	Запрос.УстановитьПараметр("ОбъектСтроительства", Запись.ОбъектСтроительства);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Справочники.УСОERP_СценарииПланированияПроектовСтроительства.ПустаяСсылка();
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Выборка.Следующий();
	
	Возврат Выборка.Сценарий;
	
КонецФункции

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(ТекущийОбъект.ОбъектСтроительства)
		И ЗначениеЗаполнено(ТекущийОбъект.Работа) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УСОERP_СтроительныеРаботы.Владелец.Владелец КАК ОбъектСтроительства
		|ИЗ
		|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
		|ГДЕ
		|	УСОERP_СтроительныеРаботы.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ТекущийОбъект.Работа);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		Если Выборка.ОбъектСтроительства <> ТекущийОбъект.ОбъектСтроительства Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбранная работа " + ТекущийОбъект.Работа.КодСДР + " " + ТекущийОбъект.Работа + " не относится к работам указанного объекта строительства: " +
			ТекущийОбъект.ОбъектСтроительства + ".");
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКодСДР()
	
	мКодСДР = СокрЛП(Запись.Работа.КодСДР);
	КодСДР = ?(ЗначениеЗаполнено(мКодСДР), "(" + мКодСДР + ")", "");
	
КонецПроцедуры

#КонецОбласти
