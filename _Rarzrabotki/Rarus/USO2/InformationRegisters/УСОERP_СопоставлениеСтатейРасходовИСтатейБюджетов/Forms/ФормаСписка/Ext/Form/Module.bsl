#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	Если Параметры.Свойство("Источник") Тогда
		Если ТипЗнч( Параметры.Источник) = Тип("СправочникСсылка.Организации") Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Организация", Параметры.Источник, ВидСравненияКомпоновкиДанных.Равно,,Истина);
		ИначеЕсли ТипЗнч( Параметры.Источник) = Тип("СправочникСсылка.СМ_ОбъектыСтроительства") Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ОбъектСтроительства", Параметры.Источник, ВидСравненияКомпоновкиДанных.Равно,,Истина);
		ИначеЕсли ТипЗнч(Параметры.Источник) = Тип("СправочникСсылка.УСОERP_СтроительныеРаботы") Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Работа", Параметры.Источник, ВидСравненияКомпоновкиДанных.Равно,,Истина);
		ИначеЕсли ТипЗнч(Параметры.Источник) = Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов") Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "СтатьяРасходов", Параметры.Источник, ВидСравненияКомпоновкиДанных.Равно,,Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
