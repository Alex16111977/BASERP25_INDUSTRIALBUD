&НаКлиенте
Процедура ОткрытьНормативВБазе(Команда)
	Если  СметнаяКомпонента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекДанные=Элементы.ДеревоНормативов.ТекущиеДанные;
	Если ТекДанные=Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выделите строку норматива", Ложь);
		Возврат;
	КонецЕсли;
	ИдФормы		= СметнаяКомпонента.ПоказатьОкноНорм("", ТекДанные.СметноНормативнаяБаза, СМ_СметаЗагрузкаВызовСервера.ОпределитьКодТипаСборника(ТекДанные.ТипНормативногоСборника), ТекДанные.Код, Ложь, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура Сравнить(Команда)
	
	МассивОбъектов=Новый Массив;
	Для Каждого Эл Из   Элементы.НормативныеСборники.ВыделенныеСтроки Цикл
		МассивОбъектов.Добавить(Эл);
	КонецЦикла;
	
	МассивНорм=Новый Массив;
	Для Каждого Эл Из   Элементы.ДеревоНормативов.ВыделенныеСтроки Цикл
		ОбъектДляЗаполнения=ДеревоНормативов.НайтиПоИдентификатору(Эл);
		Нормы		= СметнаяКомпонента.ОбновитьПоБазе(ОбъектДляЗаполнения.Код,"",ОбъектДляЗаполнения.СметноНормативнаяБаза,СМ_СметаЗагрузкаВызовСервера.ОпределитьКодТипаСборника(ОбъектДляЗаполнения.ТипНормативногоСборника),"","",0,Число(ОбъектДляЗаполнения.Секция),Истина);
		МассивНорм.Добавить(Нормы);
	КонецЦикла;

	ОтчетПоСравнению(МассивОбъектов,МассивНорм).Показать();
	
КонецПроцедуры


&НаСервере

Функция ОтчетПоСравнению(МассивОбъектов,МассивНорм)
	
	ТЗ=Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("НомерСравнения",ОбщегоНазначения.ОписаниеТипаЧисло(5));
	ТЗ.Колонки.Добавить("Порядок",ОбщегоНазначения.ОписаниеТипаЧисло(5));
	ТЗ.Колонки.Добавить("Таблица",ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТЗ.Колонки.Добавить("НомерСтроки",ОбщегоНазначения.ОписаниеТипаЧисло(5));
	ТЗ.Колонки.Добавить("Код",ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТЗ.Колонки.Добавить("Наименование",ОбщегоНазначения.ОписаниеТипаСтрока(500));
	ТЗ.Колонки.Добавить("ЕдиницаИзмерения",ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТЗ.Колонки.Добавить("Норма",ОбщегоНазначения.ОписаниеТипаЧисло(15,4));
	ТЗ.Колонки.Добавить("КодБазы",ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТЗ.Колонки.Добавить("НаименованиеБазы",ОбщегоНазначения.ОписаниеТипаСтрока(500));
	ТЗ.Колонки.Добавить("ЕдиницаИзмеренияБазы",ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТЗ.Колонки.Добавить("НормаБазы",ОбщегоНазначения.ОписаниеТипаЧисло(15,4));

	
	
    

	Сч1=0;
	Для Каждого Эл Из МассивОбъектов Цикл

		Для Каждого ТекНорма Из МассивНорм Цикл
			Если Найти(ТекНорма,"Norm")=0 Тогда 
				Продолжить;
			КонецЕсли;
			Сч1=Сч1+1;
			ЧтениеСхемыXML = Новый ЧтениеXML;
			ЧтениеСхемыXML.УстановитьСтроку(ТекНорма);
			ОбъектXDTO=ФабрикаXDTO.ПрочитатьXML(ЧтениеСхемыXML).Norm;
			СтруктураДляПроверки=Новый Структура("Code","");
			ЗаполнитьЗначенияСвойств(СтруктураДляПроверки,ОбъектXDTO);
			Если СтруктураДляПроверки.Code<>"" Тогда 
				ДобавитьСтрокуТаблицы(ТЗ,Эл,ОбъектXDTO,Сч1);
			Иначе
				Для Каждого ЭлементXDTO Из ОбъектXDTO Цикл
					ДобавитьСтрокуТаблицы(ТЗ,Эл,ЭлементXDTO,Сч1);
					Сч1=Сч1+1;
				КонецЦикла;
			КонецЕсли;
			
			
		КонецЦикла;
	КонецЦикла;
	
	СхемаКомпоновкиДанных=РегистрыСведений.СМ_АналогиОбъектовВНБ.ПолучитьМакет("СхемаКомпоновкиДанных");

	
	НастройкиСКД  = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ВТ",ТЗ);
	
	Результат=Новый ТабличныйДокумент;
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиСКД, ДанныеРасшифровки);
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,ВнешниеНаборыДанных ,ДанныеРасшифровки);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(Результат);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);  
	
	Результат.ОтображатьСетку=Ложь;
	Результат.ОтображатьЗаголовки=Ложь;
	
	
	Возврат Результат;

	
КонецФункции

&НаСервере
Процедура ДобавитьСтрокуТаблицы(ТЗ,Норматив,Норма,Сч1)
	
	Стр=ТЗ.Добавить();
	Стр.НомерСравнения=Сч1;
	Стр.Порядок=1;
	Стр.НомерСтроки=1;
	Стр.Таблица="Расценка";
	Стр.Код=Норматив.КодНормативнойРасценки;
	Стр.КодБазы=Норма.Code;
	Стр.Наименование=Норматив.Наименование;
	Стр.НаименованиеБазы=Норма.Name;
	Стр.ЕдиницаИзмерения=Строка(Норматив.ЕдиницаИзмерения);
	Стр.ЕдиницаИзмеренияБазы=Норма.Izm;


	
	ТЗ2=Новый ТаблицаЗначений;
	ТЗ2.Колонки.Добавить("НомерСтроки",ОбщегоНазначения.ОписаниеТипаЧисло(5));
	ТЗ2.Колонки.Добавить("Код",ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТЗ2.Колонки.Добавить("Наименование",ОбщегоНазначения.ОписаниеТипаСтрока(500));
	ТЗ2.Колонки.Добавить("ЕдиницаИзмерения",ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТЗ2.Колонки.Добавить("НормаРасхода",ОбщегоНазначения.ОписаниеТипаЧисло(15,4));

	
	                //РесурсыНормативныхСборников
	Инд=1;
	Для Каждого Эл Из Норма.Resources.Resource  Цикл
		Стр2=ТЗ2.Добавить();
		Стр2.НомерСтроки=Инд;
		Стр2.Код=Эл.code;
		Стр2.Наименование=Эл.name;
		Стр2.ЕдиницаИзмерения=Эл.unitname;
		Стр2.НормаРасхода=Эл.Rate;
		Инд=Инд+1;
	КонецЦикла;
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	ТЗ.НомерСтроки,
	                    |	ТЗ.Код,
	                    |	ТЗ.Наименование,
	                    |	ТЗ.ЕдиницаИзмерения,
	                    |	ТЗ.НормаРасхода
	                    |ПОМЕСТИТЬ ВТ
	                    |ИЗ
	                    |	&ТЗ КАК ТЗ
	                    |;
	                    |
	                    |////////////////////////////////////////////////////////////////////////////////
	                    |ВЫБРАТЬ
	                    |	ВЫБОР
	                    |		КОГДА СМ_НормативныеСборникиРесурсыНормативныхСборников.НомерСтроки ЕСТЬ NULL
	                    |			ТОГДА ВТ.НомерСтроки
	                    |		ИНАЧЕ СМ_НормативныеСборникиРесурсыНормативныхСборников.НомерСтроки
	                    |	КОНЕЦ КАК НомерСтроки,
	                    |	СМ_НормативныеСборникиРесурсыНормативныхСборников.НормаРасхода КАК Норма,
	                    |	СМ_НормативныеСборникиРесурсыНормативныхСборников.ТипРесурса,
	                    |	СМ_НормативныеСборникиРесурсыНормативныхСборников.Ресурс.Код КАК Код,
	                    |	СМ_НормативныеСборникиРесурсыНормативныхСборников.Ресурс.Наименование КАК Наименование,
	                    |	СМ_НормативныеСборникиРесурсыНормативныхСборников.Ресурс.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	                    |	СМ_НормативныеСборникиРесурсыНормативныхСборников.Ресурс.ВидРесурса КАК ВидРесурса,
	                    |	ВТ.НомерСтроки КАК НомерСтроки1,
	                    |	ВТ.Код КАК КодБазы,
	                    |	ВТ.Наименование КАК НаименованиеБазы,
	                    |	ВТ.ЕдиницаИзмерения КАК ЕдиницаИзмеренияБазы,
	                    |	ВТ.НормаРасхода КАК НормаБазы
	                    |ИЗ
	                    |	Справочник.СМ_НормативныеСборники.РесурсыНормативныхСборников КАК СМ_НормативныеСборникиРесурсыНормативныхСборников
	                    |		ПОЛНОЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	                    |		ПО СМ_НормативныеСборникиРесурсыНормативныхСборников.НомерСтроки = ВТ.НомерСтроки
	                    |ГДЕ
	                    |	СМ_НормативныеСборникиРесурсыНормативныхСборников.Ссылка = &Ссылка
	                    |	И ВЫБОР
	                    |			КОГДА &ИспользоватьСтатусы
	                    |				ТОГДА СМ_НормативныеСборникиРесурсыНормативныхСборников.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СМ_СтатусыФормированияНормативов.Утвержден)
	                    |			ИНАЧЕ ИСТИНА
	                    |		КОНЕЦ");
	
        Запрос.УстановитьПараметр("Ссылка",Норматив);
		Запрос.УстановитьПараметр("ТЗ",ТЗ2);
		Запрос.УстановитьПараметр("ИспользоватьСтатусы",ПолучитьФункциональнуюОпцию("СМ_ИспользоватьСтатусыНормативов"));
		Рез=Запрос.Выполнить().Выбрать();
		
		Пока Рез.Следующий() Цикл
			
			Стр=ТЗ.Добавить();
			ЗаполнитьЗначенияСвойств(Стр,Рез);
			Стр.НомерСравнения=Сч1;
			Стр.Порядок=2;
			Стр.НомерСтроки=Рез.НомерСтроки;
			Стр.Таблица="Ресурсы";
			
		КонецЦикла;
		

	ТЗ3=Новый ТаблицаЗначений;
	ТЗ3.Колонки.Добавить("НомерСтроки",ОбщегоНазначения.ОписаниеТипаЧисло(5));
	ТЗ3.Колонки.Добавить("Наименование",ОбщегоНазначения.ОписаниеТипаСтрока(500));
	Инд=1;
	Для Каждого Эл Из Норма.Works.Work  Цикл
		Стр2=ТЗ3.Добавить();
		Стр2.НомерСтроки=Инд;
		Стр2.Наименование=Эл.Description;
		Инд=Инд+1;
	КонецЦикла;

	Запрос.Текст="ВЫБРАТЬ
	             |	ТЗ.НомерСтроки,
	             |	ТЗ.Наименование
	             |ПОМЕСТИТЬ ВТ
	             |ИЗ
	             |	&ТЗ КАК ТЗ
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СМ_НормативныеСборникиСоставРабот.НомерСтроки КАК Код,
	             |	СМ_НормативныеСборникиСоставРабот.НаименованиеРаботы КАК Наименование,
	             |	СМ_НормативныеСборникиСоставРабот.Номер,
	             |	ВТ.НомерСтроки КАК КодБазы,
	             |	ВТ.Наименование КАК НаименованиеБазы
	             |ИЗ
	             |	Справочник.СМ_НормативныеСборники.СоставРабот КАК СМ_НормативныеСборникиСоставРабот
	             |		ПОЛНОЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	             |		ПО СМ_НормативныеСборникиСоставРабот.НомерСтроки = ВТ.НомерСтроки
	             |ГДЕ
	             |	СМ_НормативныеСборникиСоставРабот.Ссылка = &Ссылка
	             |	И ВЫБОР
	             |			КОГДА &ИспользоватьСтатусы
	             |				ТОГДА СМ_НормативныеСборникиСоставРабот.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СМ_СтатусыФормированияНормативов.Утвержден)
	             |			ИНАЧЕ ИСТИНА
	             |		КОНЕЦ";

      Запрос.УстановитьПараметр("ТЗ",ТЗ3);
	Запрос.УстановитьПараметр("ИспользоватьСтатусы",ПолучитьФункциональнуюОпцию("СМ_ИспользоватьСтатусыНормативов"));	
		Рез=Запрос.Выполнить().Выбрать();
		
		Пока Рез.Следующий() Цикл
			Стр=ТЗ.Добавить();
			ЗаполнитьЗначенияСвойств(Стр,Рез);
			Стр.НомерСравнения=Сч1;
			Стр.Порядок=3;
			Стр.Таблица="Работы";
		КонецЦикла;
	

КонецПроцедуры


