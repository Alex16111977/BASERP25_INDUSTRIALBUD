
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	Для Каждого ТекущаяЗапись Из ЭтотОбъект Цикл
		ТекШаблон = СокрЛП(ТекущаяЗапись.Шаблон);
		Если ПустаяСтрока(ТекШаблон) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСТр("ru = 'Не задан шаблон шифра'"),,,,Отказ);
			Прервать;
		КонецЕсли;
		
		ДлинаСтроки = СтрДлина(ТекШаблон);
		ЕстьОшибка = Ложь;
		сч = 1;
		
		Пока сч <= ДлинаСтроки Цикл
			
			Символ = Сред(ТекШаблон,сч,1);
			
			Если СтрНайти("Xx,- ",Символ) = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСТр("ru = 'В шаблоне присутствуют недопустимые символы, можно указать только: ""X"","","",""-"" или пробел'"),,,,Отказ);
				ЕстьОшибка = Истина;
				Прервать;
			КонецЕсли;
			
			сч = сч+1;
		КонецЦикла;
		
		Если ЕстьОшибка Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
