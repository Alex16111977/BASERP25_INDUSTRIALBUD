
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ПараметрКоманды = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	Если ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.Номенклатура") Тогда
		ПараметрыФормы.Вставить("Отбор", Новый Структура("Номенклатура", ПараметрКоманды));
	ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.УпаковкиЕдиницыИзмерения") Тогда 
		ПараметрыФормы.Вставить("Отбор", Новый Структура("ЕдиницаИзмерения", ПараметрКоманды));
	КонецЕсли;
	
	ОткрытьФорму("РегистрСведений.УСОERP_ПравилаОкругленияДляЕдиницИзмерения.ФормаСписка", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка);
	
КонецПроцедуры
