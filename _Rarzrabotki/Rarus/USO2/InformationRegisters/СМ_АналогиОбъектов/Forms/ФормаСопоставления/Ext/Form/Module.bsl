
&НаСервере
Процедура СоответствиеНаСервере(МассивОбъектов,МассивРесурсов,Действие="Добавить")
	
	
	Запрос=Новый Запрос( "ВЫБРАТЬ
	|	СМ_Ресурсы.Код КАК ШифрОбъекта,
	|	СМ_Ресурсы.ГруппаРесурсов КАК ИдентификаторГруппыОбъекта,
	|	СМ_Ресурсы.Ссылка
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
	|ГДЕ
	|	СМ_Ресурсы.Ссылка В(&Ссылка)
	|	И НЕ СМ_Ресурсы.ЭтоГруппа
	|	И НЕ СМ_Ресурсы.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_Ресурсы.Код КАК ШифрАналога,
	|	СМ_Ресурсы.ГруппаРесурсов КАК ИдентификаторГруппыАналога,
	|	СМ_Ресурсы.Ссылка
	|ПОМЕСТИТЬ ВТ2
	|ИЗ
	|	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
	|ГДЕ
	|	СМ_Ресурсы.Ссылка В(&Ссылка2)
	|	И НЕ СМ_Ресурсы.ЭтоГруппа
	|	И НЕ СМ_Ресурсы.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ШифрОбъекта,
	|	ВТ.ИдентификаторГруппыОбъекта,
	|	ВТ2.ШифрАналога,
	|	ВТ2.ИдентификаторГруппыАналога
	|ИЗ
	|	ВТ КАК ВТ,
	|	ВТ2 КАК ВТ2
	|ГДЕ
	|	ВТ.Ссылка <> ВТ2.Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка",МассивОбъектов);
	Запрос.УстановитьПараметр("Ссылка2",МассивРесурсов);
	СтрокиПроекта=Запрос.Выполнить().Выгрузить();
	
	ДатаВремя=ТекущаяДата();
	Ответственный=Пользователи.ТекущийПользователь();
	
	Если  Действие="Добавить" Тогда
		Для Каждого Эл Из   СтрокиПроекта Цикл
			Запись=РегистрыСведений.СМ_АналогиОбъектов.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись,Эл);
			Запись.Дата=ДатаВремя;
			Запись.Ответственный=Ответственный;
			Запись.Записать();
		КонецЦикла;	
	Иначе
		Для Каждого Эл Из   СтрокиПроекта Цикл
			Запись=РегистрыСведений.СМ_АналогиОбъектов.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись,Эл);
			Запись.Прочитать();
			Запись.Удалить();
			Запись=РегистрыСведений.СМ_АналогиОбъектов.СоздатьМенеджерЗаписи();
			Запись.ИдентификаторГруппыАналога=Эл.ИдентификаторГруппыОбъекта;
			Запись.ИдентификаторГруппыОбъекта=Эл.ИдентификаторГруппыАналога;
			Запись.ШифрАналога=Эл.ШифрОбъекта;
			Запись.ШифрОбъекта=Эл.ШифрАналога;
			Запись.Прочитать();
			Запись.Удалить();
			
		КонецЦикла;
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура СоответствиеНаСервереПоКоду(МассивОбъектов,МассивРесурсов)
	
	
	Запрос=Новый Запрос( "ВЫБРАТЬ
	|	СМ_Ресурсы.Код КАК ШифрОбъекта,
	|	СМ_Ресурсы.ГруппаРесурсов КАК ИдентификаторГруппыОбъекта,
	|	СМ_Ресурсы.Ссылка
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
	|ГДЕ
	|	СМ_Ресурсы.Ссылка В(&Ссылка)
	|	И НЕ СМ_Ресурсы.ЭтоГруппа
	|	И НЕ СМ_Ресурсы.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_Ресурсы.Код КАК ШифрАналога,
	|	СМ_Ресурсы.ГруппаРесурсов КАК ИдентификаторГруппыАналога,
	|	СМ_Ресурсы.Ссылка
	|ПОМЕСТИТЬ ВТ2
	|ИЗ
	|	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
	|ГДЕ
	|	СМ_Ресурсы.Ссылка В(&Ссылка2)
	|	И НЕ СМ_Ресурсы.ЭтоГруппа
	|	И НЕ СМ_Ресурсы.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ШифрОбъекта,
	|	ВТ.ИдентификаторГруппыОбъекта,
	|	ВТ2.ШифрАналога,
	|	ВТ2.ИдентификаторГруппыАналога
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ2 КАК ВТ2
	|		ПО ВТ.ШифрОбъекта = ВТ2.ШифрАналога
	|ГДЕ
	|	ВТ.Ссылка <> ВТ2.Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка",МассивОбъектов);
	Запрос.УстановитьПараметр("Ссылка2",МассивРесурсов);
	СтрокиПроекта=Запрос.Выполнить().Выгрузить();
	
	ДатаВремя=ТекущаяДата();
	Ответственный=Пользователи.ТекущийПользователь();
	
	Для Каждого Эл Из   СтрокиПроекта Цикл
		Запись=РегистрыСведений.СМ_АналогиОбъектов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись,Эл);
		Запись.Дата=ДатаВремя;
		Запись.Ответственный=Ответственный;
		Запись.Записать();
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСоответствие(Команда)
	Если Элементы.Ресурсы.ТекущаяСтрока<>Неопределено и Элементы.Ресурсы1.ТекущаяСтрока<>Неопределено Тогда
		МассивОбъектов=Новый Массив;
		МассивРесурсов=Новый Массив;
		Для Каждого Эл Из   Элементы.Ресурсы.ВыделенныеСтроки Цикл
			МассивОбъектов.Добавить(Эл);
		КонецЦикла;
		Для Каждого Эл Из   Элементы.Ресурсы1.ВыделенныеСтроки Цикл
			МассивРесурсов.Добавить(Эл);
		КонецЦикла;		
		СоответствиеНаСервере(МассивОбъектов,МассивРесурсов,"Добавить");
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выделите элементы в разных частях таблицы");
	КонецЕсли;
	СписокОбъектовПриАктивизацииСтроки(Неопределено);
КонецПроцедуры

