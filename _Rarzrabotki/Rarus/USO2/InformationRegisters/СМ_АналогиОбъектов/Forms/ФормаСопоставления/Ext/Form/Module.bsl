&НаКлиенте
Процедура СоздатьРесурс(Команда)
	ОткрытьФорму("Справочник.СМ_Ресурсы.ФормаОбъекта",ПолучитьДанныеЗаполнения(Элементы.Ресурсы.ТекущаяСтрока,Элементы.Ресурсы1.ТекущаяСтрока,Каталог), ЭтаФорма,,ВариантОткрытияОкна.ОтдельноеОкно,,,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьДанныеЗаполнения(Образец1,Образец2,Каталог)
	
	СтруктураЗаполнения=Новый Структура;
	СтруктураЗаполнения.Вставить("ЗначениеКопирования",Образец2);
	СтруктураЗаполнения.Вставить("Родитель",Образец1.Родитель);
	СтруктураЗаполнения.Вставить("ГруппаРесурсов",?(ЗначениеЗаполнено(Каталог),Каталог,Образец1.ГруппаРесурсов));
	
	// СУДАРИКОВ - Брать не просто код, а код без последней части
	// КодОбразца=Образец1.Код+"-";
	СимволТире = СтрНайти(Образец1.Код, "-", НаправлениеПоиска.СКонца);
	КОдОбразца = Лев(Образец1.Код, СимволТире);
	Запрос=Новый запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СМ_Ресурсы.Код
	|ИЗ
	|	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
	|ГДЕ
	|	СМ_Ресурсы.Код ПОДОБНО &Код
	|	И СМ_Ресурсы.ГруппаРесурсов = &ГруппаРесурсов");
	Запрос.УстановитьПараметр("Код",КодОбразца+"%");
	Запрос.УстановитьПараметр("ГруппаРесурсов",СтруктураЗаполнения.ГруппаРесурсов);
	
	Результат=Запрос.Выполнить().Выбрать();
	Макс=0;
	Пока Результат.Следующий() Цикл
		Кд=СтрЗаменить(Результат.Код,КодОбразца,"");
		Попытка
			КдЧисло=Число(Кд);
		Исключение
			КдЧисло=1;
		КонецПопытки;
		Если КдЧисло>Макс Тогда
			Макс=КдЧисло;
		КонецЕсли;
	КонецЦикла;
	
	
	Макс=Макс+1;	
	СтруктураЗаполнения.Вставить("Код",КодОбразца+?(Макс<10,"0"+Строка(Макс),Строка(Макс)));
	
	Возврат СтруктураЗаполнения;
КонецФункции


&НаКлиенте
Процедура Отчет(Команда)
ОткрытьФорму("Отчет.СМ_СопоставлениеРесурсов.Форма");
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если   ИмяСобытия="ЗаписанРесурс" Тогда
		МассивОбъектов=Новый Массив;
		МассивРесурсов=Новый Массив;
		МассивОбъектов.Добавить(Параметр);
		МассивРесурсов.Добавить(Элементы.Ресурсы1.ТекущаяСтрока);
		СоответствиеНаСервере(МассивОбъектов,МассивРесурсов,"Добавить");
	КонецЕсли;
КонецПроцедуры


