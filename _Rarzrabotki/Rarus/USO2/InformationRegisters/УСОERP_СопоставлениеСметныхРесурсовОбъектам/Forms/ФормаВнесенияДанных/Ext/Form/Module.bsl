	|	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_СопоставлениеСметныхРесурсовОбъектам КАК УСОERP_СопоставлениеСметныхРесурсовОбъектам
	|		ПО СМ_Ресурсы.Ссылка = УСОERP_СопоставлениеСметныхРесурсовОбъектам.СметныйРесурс
	|ГДЕ
	|	НЕ СМ_Ресурсы.ПометкаУдаления
	|	И НЕ СМ_Ресурсы.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	СМ_Ресурсы.ВидРесурса,
	|	СМ_Ресурсы.Наименование";
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ЗначениеВРеквизитФормы(ТЗ,"ТаблицаДанных");
	
КонецПроцедуры 

&НаКлиенте
Процедура КомандаЗаполнитьВсеРесурсы(Команда)
	КомандаЗаполнитьВсеРесурсыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДанныхСметныйРесурсОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
КонецПроцедуры

#Область СозданиеНоменклатуры

&НаКлиенте
Процедура КомандаСоздатьНоменклатуру(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("КомандаСоздатьНоменклатурыПродолжение",ЭтотОбъект);
	ОткрытьФорму("РегистрСведений.УСОERP_СопоставлениеСметныхРесурсовОбъектам.Форма.ФормаСозданияНоменклатуры",,ЭтотОбъект,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура  КомандаСоздатьНоменклатурыПродолжение(Результат,ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтр ИЗ Элементы.ТаблицаДанных.ВыделенныеСтроки Цикл
		
		СоздатьНоменклатуру(ТекСтр,Результат);		
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура СоздатьНоменклатуру(ТекСтр,Результат)
	
	Строка = ТаблицаДанных.НайтиПоИдентификатору(ТекСтр);
	
	Если ТаблицаДанных.НайтиПоИдентификатору(ТекСтр).СметныйРесурс.ВидРесурса <>  Перечисления.СМ_ВидыРесурсов.Материалы Тогда
		Возврат;
	КонецЕсли;
	
	ВидНоменклатуры = Результат.ВидНоменклатуры;
	
	Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	
	Если НайтиНоменклатуру(Строка.СметныйРесурс.Наименование,ВидНоменклатуры,Номенклатура) Тогда 
		
		Если Строка.ОбъектУСО = Номенклатура Тогда
			Возврат;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для сметного материала """+ Строка.СметныйРесурс.Наименование+""" есть номенклатура с данным наименованием. Новая номенклатура не создана"); 
		
		Строка.ОбъектУСО = Номенклатура;
		Строка.Характеристика = "";
		Строка.ХарактеристикиИспользуются = (Номенклатура.ИспользованиеХарактеристик <> Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать);
		Строка.Коэффициент = 1;
		
		Возврат;
		
	КонецЕсли;
	
	НовыйЭлемент = Справочники.Номенклатура.СоздатьЭлемент();
	НовыйЭлемент.ВидНоменклатуры = ВидНоменклатуры;
	НовыйЭлемент.Заполнить(ВидНоменклатуры);
	НовыйЭлемент.Наименование =  Строка.СметныйРесурс.Наименование;
	НовыйЭлемент.НаименованиеПолное = Строка.СметныйРесурс.Наименование;
	
	Если НЕ ЗначениеЗаполнено(НовыйЭлемент.ИспользованиеХарактеристик) Тогда
		НовыйЭлемент.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
	КонецЕсли;
	
	Для Каждого СтрокаТЧ ИЗ Результат.ОбязательныеРеквизиты Цикл
		
		НовыйЭлемент[СтрокаТЧ.ИмяРеквизита] = СтрокаТЧ.Значение;
		
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(Строка.СметныйРесурс.ЕдиницаИзмерения.КодОКЕИ) Тогда
		
		Единица = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду(Формат(Строка.СметныйРесурс.ЕдиницаИзмерения.КодОКЕИ,"ЧЦ=3; ЧВН="));
		
		Если ЗначениеЗаполнено(Единица) тогда
			НовыйЭлемент.ЕдиницаИзмерения = Единица;
			Строка.Коэффициент = Строка.СметныйРесурс.ЕдиницаИзмерения.КоэффициентПеревода;
		КонецЕсли; 		
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НовыйЭлемент.ЕдиницаИзмерения) Тогда
		НовыйЭлемент.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("796");
		Строка.Коэффициент = 1; 
	КонецЕсли;  
	
	Если НЕ ЗначениеЗаполнено(НовыйЭлемент.ЕдиницаДляОтчетов) Тогда
		НовыйЭлемент.ЕдиницаДляОтчетов = НовыйЭлемент.ЕдиницаИзмерения;
	КонецЕсли;
	
	НовыйЭлемент.ОбменДанными.Загрузка = Истина;
	НовыйЭлемент.УстановитьНовыйКод();
	НовыйЭлемент.Родитель = Результат.Родитель;
	НовыйЭлемент.Записать();
	
	Строка.ОбъектУСО = НовыйЭлемент.Ссылка;
	Строка.Номенклатура = Строка.ОбъектУСО;
	Строка.Характеристика = "";
	Строка.ХарактеристикиИспользуются = (Строка.Номенклатура.ИспользованиеХарактеристик <> Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиНоменклатуру(Наименование,ВидНоменклатуры,Номенклатура)    
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Наименование",Строка(Наименование));
	Запрос.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления
	|	И НЕ Номенклатура.ЭтоГруппа
	|	И (ВЫРАЗИТЬ(Номенклатура.Наименование КАК СТРОКА(100))) = (ВЫРАЗИТЬ(&Наименование КАК СТРОКА(100)))
	|	И Номенклатура.ВидНоменклатуры = &ВидНоменклатуры";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Номенклатура = Выборка.Ссылка;	   
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

   




