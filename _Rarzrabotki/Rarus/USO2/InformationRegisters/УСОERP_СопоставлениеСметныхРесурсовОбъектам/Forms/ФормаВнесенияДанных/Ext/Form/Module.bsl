
&НаСервере
Процедура КомандаЗаполнитьНесопоставленнымиНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_СопоставлениеСметныхРесурсовОбъектам.СметныйРесурс КАК СметныйРесурс
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	РегистрСведений.УСОERP_СопоставлениеСметныхРесурсовОбъектам КАК УСОERP_СопоставлениеСметныхРесурсовОбъектам
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_Ресурсы.Ссылка КАК СметныйРесурс,
	|	НЕОПРЕДЕЛЕНО КАК ОбъектУСО,
	//|	1 КАК Коэффициент,
	|	ВЫБОР КОГДА СМ_Ресурсы.ЕдиницаИзмерения.КоэффициентПеревода = 0 ТОГДА 1 ИНАЧЕ СМ_Ресурсы.ЕдиницаИзмерения.КоэффициентПеревода КОНЕЦ КАК Коэффициент,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
	|	ЛОЖЬ КАК ХарактеристикиИспользуются
	|ИЗ
	|	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
	|ГДЕ
	|	НЕ СМ_Ресурсы.Ссылка В
	|				(ВЫБРАТЬ
	|					ВрТаб.СметныйРесурс
	|				ИЗ
	|					ВрТаб)
	|	И НЕ СМ_Ресурсы.ПометкаУдаления
	|	И НЕ СМ_Ресурсы.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	СМ_Ресурсы.ВидРесурса,
	|	СМ_Ресурсы.Наименование";
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ЗначениеВРеквизитФормы(ТЗ,"ТаблицаДанных");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьНесопоставленными(Команда)
	
	КомандаЗаполнитьНесопоставленнымиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура КомандаЗаписатьНаСервере()
	
	ТЗ = РеквизитФормыВЗначение("ТаблицаДанных");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТЗ",ТЗ);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабДанных.СметныйРесурс КАК СметныйРесурс,
	|	ТабДанных.ОбъектУСО КАК ОбъектУСО,
	|	ТабДанных.Характеристика КАК Характеристика,
	|	ТабДанных.Коэффициент КАК Коэффициент
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	&ТЗ КАК ТабДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.СметныйРесурс КАК СметныйРесурс,
	|	ВрТаб.ОбъектУСО КАК ОбъектУСО,
	|	ВрТаб.Характеристика КАК Характеристика,
	|	ВрТаб.Коэффициент КАК Коэффициент
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|ГДЕ
	|	ВрТаб.СметныйРесурс <> ЗНАЧЕНИЕ(Справочник.СМ_Ресурсы.ПустаяСсылка)
	|	И ВрТаб.ОбъектУСО <> НЕОПРЕДЕЛЕНО
	|	И ВрТаб.ОбъектУСО <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И ВрТаб.ОбъектУСО <> ЗНАЧЕНИЕ(Справочник.УСОERP_Ресурсы.ПустаяСсылка)
	|	И ВрТаб.Коэффициент > 0";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	МенеджерЗаписи = РегистрыСведений.УСОERP_СопоставлениеСметныхРесурсовОбъектам.СоздатьМенеджерЗаписи();
	
	Пока Выборка.Следующий() Цикл		
		
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи,Выборка);
		МенеджерЗаписи.Прочитать();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи,Выборка);
		МенеджерЗаписи.Записать(Истина);
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаписать(Команда)
	
	КомандаЗаписатьНаСервере();
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура КомандаОбновитьНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_СопоставлениеСметныхРесурсовОбъектам.СметныйРесурс КАК СметныйРесурс,
	|	УСОERP_СопоставлениеСметныхРесурсовОбъектам.ОбъектУСО КАК ОбъектУСО,
	|	УСОERP_СопоставлениеСметныхРесурсовОбъектам.Характеристика КАК Характеристика,
	|	УСОERP_СопоставлениеСметныхРесурсовОбъектам.Коэффициент КАК Коэффициент,
	|	УСОERP_СопоставлениеСметныхРесурсовОбъектам.ОбъектУСО КАК Номенклатура,
	|	ЕСТЬNULL(УСОERP_СопоставлениеСметныхРесурсовОбъектам.ОбъектУСО.ИспользованиеХарактеристик, ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)) <> ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать) КАК ХарактеристикиИспользуются
	|ИЗ
	|	РегистрСведений.УСОERP_СопоставлениеСметныхРесурсовОбъектам КАК УСОERP_СопоставлениеСметныхРесурсовОбъектам
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_СопоставлениеСметныхРесурсовОбъектам.СметныйРесурс.ВидРесурса,
	|	УСОERP_СопоставлениеСметныхРесурсовОбъектам.СметныйРесурс.Наименование";
	
	ЗначениеВРеквизитФормы(Запрос.Выполнить().Выгрузить(),"ТаблицаДанных");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	КомандаОбновитьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДанныхПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекСтрока = Элементы.ТаблицаДанных.ТекущиеДанные;
		ТекСтрока.Коэффициент = 1;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДанныхСметныйРесурсПриИзменении(Элемент)
	
	ТекСтрока = Элементы.ТаблицаДанных.ТекущиеДанные;
	ЗаполнитьДанныеСтроительногоРесурса(ТекСтрока.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаСервере
Процедура  ЗаполнитьДанныеСтроительногоРесурса(ИдСтроки)
	
	ТекСтрока = ТаблицаДанных.НайтиПоИдентификатору(ИдСтроки);
	ТекСтрока.ОбъектУСО = Неопределено;
	ТекСтрока.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	ТекСтрока.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	ТекСтрока.ХарактеристикиИспользуются = Ложь;
	ТекСтрока.Коэффициент = ?(ТекСтрока.СметныйРесурс.ЕдиницаИзмерения.КоэффициентПеревода = 0,1,ТекСтрока.СметныйРесурс.ЕдиницаИзмерения.КоэффициентПеревода);
	
	НЗ = РегистрыСведений.УСОERP_СопоставлениеСметныхРесурсовОбъектам.СоздатьНаборЗаписей();
	НЗ.Отбор.СметныйРесурс.Установить(ТекСтрока.СметныйРесурс);
	НЗ.Прочитать();
	
	Если НЗ.Количество() Тогда
		ЗаполнитьЗначенияСвойств(ТекСтрока,НЗ.Получить(0),"ОбъектУСО,Характеристика,Коэффициент");
		ТекСтрока.Номенклатура = ТекСтрока.ОбъектУСО;
		ТекСтрока.ХарактеристикиИспользуются = ТекСтрока.Номенклатура.ИспользованиеХарактеристик <> Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
	КонецЕсли;
		
КонецПроцедуры


&НаСервереБезКонтекста
Функция ВидРесурса(Ресурс)
	
	Если Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
		Возврат Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
	КонецЕсли;
	
	Если Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов 
		ИЛИ Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих
		ИЛИ Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы 
		ИЛИ Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Оборудование Тогда
		Возврат Новый ОписаниеТипов("СправочникСсылка.УСОERP_Ресурсы");
	КонецЕсли; 
	
	Возврат Неопределено;
	
КонецФункции  

&НаКлиенте
Процедура КомандаЗаполнитьПоСмете(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПоСметеВыбор",ЭтотОбъект);
	
	ПоказатьВводЗначения(ОписаниеОповещения,ПредопределенноеЗначение("Документ.СМ_ЛокальнаяСмета.ПустаяСсылка"));
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьПоСметеВыбор(ВыбранноеЗначение,ДопПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоСметеНаСервере(ВыбранноеЗначение);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоСметеНаСервере(Смета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Смета",Смета);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ресурс КАК Ресурс
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	Документ.СМ_ПозицияЛокальнойСметы.РесурсыПозицииЛокальнойСметы КАК СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы
	|ГДЕ
	|	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ссылка.ИДСметы = &Смета
	|
	|СГРУППИРОВАТЬ ПО
	|	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ресурс
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.Ресурс КАК СметныйРесурс,
	|	ЕСТЬNULL(УСОERP_СопоставлениеСметныхРесурсовОбъектам.ОбъектУСО, НЕОПРЕДЕЛЕНО) КАК ОбъектУСО,
	|	ЕСТЬNULL(УСОERP_СопоставлениеСметныхРесурсовОбъектам.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ЕСТЬNULL(УСОERP_СопоставлениеСметныхРесурсовОбъектам.ОбъектУСО, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	//|	ЕСТЬNULL(УСОERP_СопоставлениеСметныхРесурсовОбъектам.Коэффициент, 1) КАК Коэффициент,
	|	ЕСТЬNULL(УСОERP_СопоставлениеСметныхРесурсовОбъектам.Коэффициент, ВЫБОР КОГДА ВрТаб.Ресурс.ЕдиницаИзмерения.КоэффициентПеревода = 0 ТОГДА 1 ИНАЧЕ ВрТаб.Ресурс.ЕдиницаИзмерения.КоэффициентПеревода КОНЕЦ) КАК Коэффициент, 
	|	ЕСТЬNULL(УСОERP_СопоставлениеСметныхРесурсовОбъектам.ОбъектУСО.ИспользованиеХарактеристик, ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)) <> ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать) КАК ХарактеристикиИспользуются
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_СопоставлениеСметныхРесурсовОбъектам КАК УСОERP_СопоставлениеСметныхРесурсовОбъектам
	|		ПО ВрТаб.Ресурс = УСОERP_СопоставлениеСметныхРесурсовОбъектам.СметныйРесурс
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВрТаб.Ресурс.ВидРесурса,
	|	ВрТаб.Ресурс.Наименование";
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ЗначениеВРеквизитФормы(ТЗ,"ТаблицаДанных");
	
КонецПроцедуры 

&НаКлиенте
Процедура ТаблицаДанныхОбъектУСОНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.ТаблицаДанных.ТекущиеДанные;
	Элемент.ОграничениеТипа = ВидРесурса(ТекСтрока.СметныйРесурс);
	Значение = ТекСтрока.ОбъектУСО;
	ТекСтрока.ОбъектУСО = Элемент.ОграничениеТипа.ПривестиЗначение(Значение);
	
КонецПроцедуры  

&НаКлиенте
Процедура ТаблицаДанныхХарактеристикаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.ТаблицаДанных.ТекущиеДанные;
	Если НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ТаблицаДанныхЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.ТаблицаДанных.ТекущиеДанные;
	Если ТипЗнч(ТекСтрока.ОбъектУСО) <> Тип("СправочникСсылка.Номенклатура") Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаДанныхОбъектУСОПриИзменении(Элемент)
	
	ТекСтрока = Элементы.ТаблицаДанных.ТекущиеДанные;
	ТекСтрока.Номенклатура = ТекСтрока.ОбъектУСО;
	ТекСтрока.ХарактеристикиИспользуются =  ИспользованиеХарактеристик(ТекСтрока.Номенклатура);
	
КонецПроцедуры

&НаСервереБезКонтекста
