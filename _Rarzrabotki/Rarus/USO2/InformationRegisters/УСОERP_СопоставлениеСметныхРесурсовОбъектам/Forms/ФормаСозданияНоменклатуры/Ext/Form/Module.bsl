&НаКлиенте
Процедура ВидНоменклатурыПриИзменении(Элемент)
	ОбязательныеРеквизиты.Очистить();
	ЗаполнитьОбязательныеРеквизиты();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбязательныеРеквизиты()
	
	Если НЕ ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		Возврат;
	КонецЕсли;
	
	ПустойСправочник = Справочники.Номенклатура.НайтиПоКоду("111111111111");
	
	Для Каждого СтрокаТЗ ИЗ ВидНоменклатуры.РеквизитыДляКонтроляНоменклатуры Цикл
		
		Если НЕ СтрокаТЗ.ОбязателенДляЗаполнения Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТЗ.ИмяРеквизита = "ВидНоменклатуры" ИЛИ СтрокаТЗ.ИмяРеквизита = "ЕдиницаИзмерения" Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТЗ.ЭтоДопРеквизит Тогда
			
			//Нстр = ОбязательныеРеквизиты.Добавить();
			//Нстр.ИмяРеквизита = СтрокаТЗ.ИмяРеквизита;
			//Нстр.ПредставлениеРеквизита = СтрокаТЗ.Свойство;
			//Нстр.ЭтоДопРеквизит = Истина;
			//Нстр.Свойство = СтрокаТЗ.Свойство;
			//Нстр.Значение = СтрокаТЗ.Свойство.ПривестиЗначение(Нстр.Значение);
			Продолжить;
			
		КонецЕсли;				
		
		Нстр = ОбязательныеРеквизиты.Добавить();
		Нстр.ИмяРеквизита = СтрокаТЗ.ИмяРеквизита;
		Нстр.ПредставлениеРеквизита = Метаданные.Справочники.Номенклатура.Реквизиты[Нстр.ИмяРеквизита].Синоним;
		
		Если Метаданные.Справочники.ВидыНоменклатуры.Реквизиты.Найти(Нстр.ИмяРеквизита) <> Неопределено Тогда
			
			Нстр.Значение = ВидНоменклатуры[Нстр.ИмяРеквизита];
			
		Иначе     			
			
			Нстр.Значение = ПустойСправочник[Нстр.ИмяРеквизита];
			
		КонецЕсли;
		
	КонецЦикла; 	
	
КонецПроцедуры 

&НаКлиенте
Процедура КомандаСоздатьНоменклатуру(Команда)
	
	ОшибкаЗаполнения = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено значение реквизита """"Вид номенклатуры""""");
        ОшибкаЗаполнения = Истина;
	КонецЕсли;
	
	Для Каждого СтрокаТЧ ИЗ ОбязательныеРеквизиты Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Значение) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено значение реквизита """""+СтрокаТЧ.ПредставлениеРеквизита+"""");
			 ОшибкаЗаполнения = Истина;
		 КонецЕсли;
	 КонецЦикла;
	 
	 Если ОшибкаЗаполнения Тогда
		 Возврат;
	 КонецЕсли;  	 
			
	ОповеститьОВыборе(Новый Структура("ВидНоменклатуры,Родитель,ОбязательныеРеквизиты",ВидНоменклатуры,ГруппаНоменклатуры,ОбязательныеРеквизиты));
	
КонецПроцедуры


