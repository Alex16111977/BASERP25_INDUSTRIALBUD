#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	Если Запись.ИсходныйКлючЗаписи = РегистрыСведений.СМ_СметныеЦеныРесурсов.ПустойКлюч() Тогда
		Запись.Период = НачалоМесяца(ТекущаяДатаСеанса());
		Запись.СметноНормативнаяБаза = Справочники.СМ_СметноНормативныеБазы.ПолучитьПоУмолчанию();
		Запись.Район = Справочники.СМ_ТерриториальныеРайоны.ПолучитьПоУмолчанию();
		Запись.ТипЦен = Перечисления.СМ_ТипыЦен.Базисная;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимость()
	ВидРесурса = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Запись.Ресурс, "ВидРесурса");
	ВидимостьЗатратыТруда = (ВидРесурса = ПредопределенноеЗначение("Перечисление.СМ_ВидыРесурсов.ЗатратыТрудаРабочих") ИЛИ ВидРесурса = ПредопределенноеЗначение("Перечисление.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов"));
	ВидимостьМашины = (ВидРесурса = ПредопределенноеЗначение("Перечисление.СМ_ВидыРесурсов.МашиныИМеханизмы") ИЛИ ВидРесурса = ПредопределенноеЗначение("Перечисление.СМ_ВидыРесурсов.Перебазировка") ИЛИ ВидРесурса = ПредопределенноеЗначение("Перечисление.СМ_ВидыРесурсов.Транспортировка"));
	ВидимостьМатериалы = (ВидРесурса = ПредопределенноеЗначение("Перечисление.СМ_ВидыРесурсов.Материалы") ИЛИ ВидРесурса = ПредопределенноеЗначение("Перечисление.СМ_ВидыРесурсов.Оборудование"));
	ВидимостьСправочно = ВидРесурса = ПредопределенноеЗначение("Перечисление.СМ_ВидыРесурсов.Справочно");
	Элементы.ГруппаЗатратыТруда.Видимость = ВидимостьЗатратыТруда;
	Элементы.ГруппаМатериалыОборудование.Видимость = ВидимостьМатериалы;
	Элементы.ГруппаМашины.Видимость = ВидимостьМашины;
	Элементы.ГруппаСправочно.Видимость = ВидимостьСправочно;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Запись.Период) Тогда
		Запись.Период = НачалоМесяца(Запись.Период);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти