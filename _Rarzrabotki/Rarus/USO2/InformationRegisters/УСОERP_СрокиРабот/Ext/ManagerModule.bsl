#Область ПрограммныйИнтерфейс

// Отменяет утверждение календарного плана-графика.
//
// Параметры:
//  ДокументСсылка  – ссылка на план-график;
//  Отказ           – признак наличия ошибок.
//
Процедура ОтменитьПризнакУтверждения(ДокументСсылка, Отказ = Ложь) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ДокументСсылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ТаблицаЗаписей = ПолучитьТаблицуЗаписей(ДокументСсылка);	
	
	Для Каждого мДанныеЗаписи Из ТаблицаЗаписей Цикл
		
		НаборЗаписей = РегистрыСведений.УСОERP_ПараметрыВыполненияРабот.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.Период.Установить(ДокументСсылка.Дата); 		
		НаборЗаписей.Отбор.ВидПланирования.Установить(мДанныеЗаписи.ВидПланирования);
		НаборЗаписей.Отбор.Работа.Установить(мДанныеЗаписи.Работа);
		
		НаборЗаписей.Прочитать();
		
		НаборЗаписей.Очистить();
		
		НоваяЗапись = НаборЗаписей.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяЗапись, мДанныеЗаписи);
		НоваяЗапись.Утверждена = Ложь;
		
		Попытка
			НаборЗаписей.Записать();
		Исключение
			ТекстСообщения = НСтр("ru = 'Не удалось отменить утверждение календарного план-графика %Ссылка% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Ссылка%", ДокументСсылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Документы.УСОERP_УтверждениеКалендарногоПланаГрафика, ДокументСсылка, ТекстСообщения);
			
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

Функция  ПолучитьТаблицуЗаписей(ДокументСсылка) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Период,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа КАК Работа,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ВидПланирования,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Утверждена,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОбъемРаботы,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ЕдиницаОбъема,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.НачалоРаботыПлан,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОкончаниеРаботыПлан,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ДлительностьПлан,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ЕдиницаДлительности,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.АвторИзменения
	|ИЗ
	|	РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(
	|			&КонецПериода,
	|			Период = &Период
	|				И Работа.Владелец.Владелец = &ОбъектСтроительства
	|				И Утверждена = ИСТИНА) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Период,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ВидПланирования,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Утверждена,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОбъемРаботы,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ЕдиницаОбъема,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.НачалоРаботыПлан,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОкончаниеРаботыПлан,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ДлительностьПлан,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ЕдиницаДлительности,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.АвторИзменения";
	
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(ДокументСсылка.Дата, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Период", ДокументСсылка.Дата);
	Запрос.УстановитьПараметр("ОбъектСтроительства",ДокументСсылка.ОбъектСтроительства);
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Выгрузить();
	
	
КонецФункции

#КонецОбласти

#КонецЕсли