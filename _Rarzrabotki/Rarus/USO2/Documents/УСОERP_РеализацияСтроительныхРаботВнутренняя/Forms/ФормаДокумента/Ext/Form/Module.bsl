&НаКлиенте
Процедура ЗаполнитьСубподрядныеСМР(Команда)
	
	СписокРабот	=	Новый СписокЗначений;
	Для каждого ЭлРабота Из Объект.Работы Цикл
		СписокРабот.Добавить(ЭлРабота.Работа);
	КонецЦикла;
	
	ЗаполнитьСубподрядныеСМРНаСервере(СписокРабот);
	
КонецПроцедуры

&НаКлиенте
Процедура Подбор(Команда)
	
	СтруктураОтбора = Новый Структура;
	ЗаполнитьСтруктуруОтбораНаСервере(СтруктураОтбора);

	ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаПодбора",СтруктураОтбора,ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтруктуруОтбораНаСервере(СтруктураОтбора) 	
		
	Если НовыйВариант Тогда
		
		СтруктураОтбора.Вставить("ДокументУтверждения",Объект.ДокументУтверждения);
		Возврат;
		
	КонецЕсли;
	
	СтруктураОтбора.Вставить("Организация",Объект.Организация);
	СтруктураОтбора.Вставить("ОбъектСтроительства",Объект.ОбъектСтроительства);
	СтруктураОтбора.Вставить("ПометкаУдаления",Ложь);
	СтруктураОтбора.Вставить("Утверждена",Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьАктНажатие(Элемент)
	
	Если ПодчиненныйДокументАктВыполненныхРабот.Пустая() Тогда		
		ВводитьДокумент = Истина;	
		Если (НЕ ЗначениеЗаполнено(Объект.Ссылка)
			ИЛИ НЕ Объект.Проведен
			ИЛИ Модифицированность) Тогда
			
			ПоказатьВопрос(Новый ОписаниеОповещения("",ЭтотОбъект),"Формирование документов возможно только после проведения документа. Провести?",РежимДиалогаВопрос.ДаНет);
			
		Иначе
			
			СформироватьАктНажатиеПродолжение(КодВозвратаДиалога.Да,Новый Структура);	
			
		КонецЕсли;
		
	Иначе
		ПараметрыФормы = Новый Структура("Ключ, УСОERP_ДокументОснование, ТолькоПросмотр", ПодчиненныйДокументАктВыполненныхРабот, Объект.Ссылка, Истина);
		ОткрытьФорму("Документ.АктВыполненныхРабот.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);		
	КонецЕсли;	
	
