&НаСервере
Процедура РаботыСтоимостьСНДСПриИзмененииНаСервере(ИдентификаторСтроки)
	
	ТекущаяСтрока					=	Объект.Работы.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если Не ТекущаяСтрока.СтоимостьВсего = 0 Тогда
		ТекущаяСтрока.ОбъемРеализации	=	?(ТекущаяСтрока.СтоимостьВсего = 0, 0, Окр(ТекущаяСтрока.СуммаСНДС * ТекущаяСтрока.ОбъемВсего / ТекущаяСтрока.СтоимостьВсего,2));
		ТекущаяСтрока.ПроцентРеализации	=	?(ТекущаяСтрока.ОбъемВсего = 0, 0, Окр(ТекущаяСтрока.ОбъемРеализации * 100 / ТекущаяСтрока.ОбъемВсего,2));
	Иначе
		ТекущаяСтрока.СуммаСНДС = 0;
	КонецЕсли;
	
	РассчитатьИтоговыеПоказателиВыполненияРабот(ЭтаФорма, ТекущаяСтрока) ;
	
КонецПроцедуры

