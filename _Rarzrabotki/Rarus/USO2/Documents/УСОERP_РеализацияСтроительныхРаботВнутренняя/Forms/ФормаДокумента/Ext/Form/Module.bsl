&НаКлиенте
Процедура СформироватьАктНажатиеПродолжение(Ответ,ДопПараметры)Экспорт 	
	
	ВводитьДокумент = Ответ = КодВозвратаДиалога.Да; 	
	
	Если (НЕ ЗначениеЗаполнено(Объект.Ссылка)
		ИЛИ НЕ Объект.Проведен
		ИЛИ Модифицированность) Тогда
		
		Попытка
			ВводитьДокумент = ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
		Исключение
			ПоказатьПредупреждение(,"Не удалось выполнить проведение документа");
			ВводитьДокумент = Ложь;
		КонецПопытки;
		
	КонецЕсли;	
	
	Если ВводитьДокумент Тогда 
		ФормаНового		=	ПолучитьФорму("Документ.АктВыполненныхРабот.Форма.ФормаДокумента", , ЭтаФорма); 
		ДанныеФормы		=	ФормаНового.Объект; 
		СформироватьАктВыполненныхРабот(ДанныеФормы);
	КонецЕсли;
	
	// формирование счет - фактуры выданной
	ПараметрыФормы = Новый Структура("Ключ, УСОERP_ДокументОснование, ТолькоПросмотр", ПодчиненныйДокументАктВыполненныхРабот, Объект.Ссылка, Истина);
	ФормаАкта = ПолучитьФорму("Документ.АктВыполненныхРабот.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
	
	УСОERP_ПродажиКлиентПереопределяемый.ВвестиСчетФактуруПослеВопроса(КодВозвратаДиалога.Да, Новый Структура("Исправление, Корректировочный, Организация, ОткрыватьСуществующую, Форма", Ложь, Ложь, Объект.Организация, Ложь, ФормаАкта));
	
КонецПроцедуры 

