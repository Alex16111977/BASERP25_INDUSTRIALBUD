&НаСервере
Процедура ЗаполнитьРаботыНаСервереПоДокументамУчета()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_УчетВыполненныхРаботОбороты.Регистратор
	|ПОМЕСТИТЬ ВТ_ДокументыУчетаВыполненныхРаботЗаПериод
	|ИЗ
	|	РегистрНакопления.УСОERP_УчетВыполненныхРабот.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			Организация = &Организация
	|				И ОбъектСтроительства = &ОбъектСтроительства) КАК УСОERP_УчетВыполненныхРаботОбороты
	|ГДЕ
	|	УСОERP_УчетВыполненныхРаботОбороты.Регистратор ССЫЛКА Документ.УСОERP_УчетВыполненныхРабот
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_УчетВыполненныхРаботОбороты.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_РеализацияСтроительныхРаботВнутренняяРаботы.ДокументОснование,
	|	ВТ_ДокументыУчетаВыполненныхРаботЗаПериод.Регистратор
	|ПОМЕСТИТЬ ВТ_НеДоступныеДокументыУчетаРабот
	|ИЗ
	|	Документ.УСОERP_РеализацияСтроительныхРаботВнутренняя.Работы КАК УСОERP_РеализацияСтроительныхРаботВнутренняяРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДокументыУчетаВыполненныхРаботЗаПериод КАК ВТ_ДокументыУчетаВыполненныхРаботЗаПериод
	|		ПО УСОERP_РеализацияСтроительныхРаботВнутренняяРаботы.ДокументОснование = ВТ_ДокументыУчетаВыполненныхРаботЗаПериод.Регистратор
	|ГДЕ
	|	УСОERP_РеализацияСтроительныхРаботВнутренняяРаботы.Ссылка.Проведен = ИСТИНА
	|	И ЕСТЬNULL(ВТ_ДокументыУчетаВыполненныхРаботЗаПериод.Регистратор, ЗНАЧЕНИЕ(Документ.УСОERP_УчетВыполненныхРабот.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Документ.УСОERP_УчетВыполненныхРабот.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДокументыУчетаВыполненныхРаботЗаПериод.Регистратор,
	|	УСОERP_РеализацияСтроительныхРаботВнутренняяРаботы.ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_НеДоступныеДокументыУчетаРабот.Регистратор КАК Регистратор,
	|	УСОERP_УчетВыполненныхРаботРаботы.Ссылка,
	|	УСОERP_УчетВыполненныхРаботРаботы.Работа,
	|	УСОERP_УчетВыполненныхРаботРаботы.ОбъемВсего,
	|	УСОERP_УчетВыполненныхРаботРаботы.ЕдиницаОбъема,
	|	УСОERP_УчетВыполненныхРаботРаботы.ПроцентВыполнения,
	|	УСОERP_УчетВыполненныхРаботРаботы.Объем КАК ОбъемВыполнения,
	|	ВТ_ДокументыУчетаВыполненныхРаботЗаПериод.Регистратор КАК ДокументОснование,
	|	УСОERP_УчетВыполненныхРаботРаботы.ДатаНачала,
	|	УСОERP_УчетВыполненныхРаботРаботы.ДатаОкончания
	|ИЗ
	|	ВТ_ДокументыУчетаВыполненныхРаботЗаПериод КАК ВТ_ДокументыУчетаВыполненныхРаботЗаПериод
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НеДоступныеДокументыУчетаРабот КАК ВТ_НеДоступныеДокументыУчетаРабот
	|		ПО (ВТ_НеДоступныеДокументыУчетаРабот.Регистратор <> ВТ_НеДоступныеДокументыУчетаРабот.Регистратор)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УСОERP_УчетВыполненныхРабот.Работы КАК УСОERP_УчетВыполненныхРаботРаботы
	|		ПО ВТ_ДокументыУчетаВыполненныхРаботЗаПериод.Регистратор = УСОERP_УчетВыполненныхРаботРаботы.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_УчетВыполненныхРаботРаботы.Ссылка.Дата,
	|	УСОERP_УчетВыполненныхРаботРаботы.Ссылка.Номер,
	|	УСОERP_УчетВыполненныхРаботРаботы.НомерСтроки";
	Запрос.УстановитьПараметр("НачалоПериода", Новый Граница(НачалоДня(Объект.ДатаНачалаПериода), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(Объект.ДатаОкончанияПериода), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ОбъектСтроительства", Объект.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Объект.Работы.Загрузить(Результат);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаботыНаСервере(СписокРабот = Неопределено, ПолучитьСписок = Ложь, Подбор = Ложь)
	
	Если Не ПолучитьСписок И Не Подбор Тогда
		Объект.Работы.Очистить();
	КонецЕсли;
	
	ДанныеПоРаботам = УСОERP_ЗащищенныеФункцииСервер.УСОERP_РеализацияСтроительныхРаботВнутренняя_ПолучитьДанныеПоВыполнениюРабот(ЭтотОбъект, СписокРабот);
	
	Если ПолучитьСписок Тогда
		СписокРабот = Новый СписокЗначений;
	КонецЕсли;
	
	СтавкаНДС = ?(Объект.Договор.СтавкаНДС = Перечисления.СтавкиНДС.ПустаяСсылка(),Перечисления.СтавкиНДС.НДС20,Объект.Договор.СтавкаНДС);
	
	Если ДанныеПоРаботам.Количество() > 0 Тогда
		Для каждого ЭлРабота Из ДанныеПоРаботам Цикл
			Если Не ПолучитьСписок Тогда
				НоваяСтрокаТЧ = Объект.Работы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ, ЭлРабота);
				Если НЕ ЗначениеЗаполнено(НоваяСтрокаТЧ.СтавкаНДС) Тогда
					Если НЕ НоваяСтрокаТЧ.СуммарнаяРабота
						И НоваяСтрокаТЧ.СтоимостьВсего<>0 Тогда
						НоваяСтрокаТЧ.СтавкаНДС	=	СтавкаНДС;
										
					КонецЕсли;
				КонецЕсли;
	
				НоваяСтрокаТЧ.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(НоваяСтрокаТЧ.СуммаСНДС, НоваяСтрокаТЧ.СтавкаНДС, Истина);

			Иначе
				СписокРабот.Добавить(ЭлРабота.Работа);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ СписокРабот = Неопределено Тогда 
		Для Каждого Эл из СписокРабот Цикл 
			Элемент = Эл.Значение; 
			Пока ЗначениеЗаполнено(Элемент.Родитель) Цикл
				Элемент = Элемент.Родитель; 
				СписокРабот.Добавить(Элемент);
			КонецЦикла;	
		КонецЦикла;	
	КонецЕсли;

		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСубподрядныеСМРНаСервере(СписокРабот)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Регистратор КАК ДокументПриемки,
		|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Организация,
		|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.ОбъектСтроительства,
		|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Партнер,
		|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Контрагент,
		|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Соглашение,
		|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Договор,
		|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Работа,
		|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.ОбъемРасход,
		|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.СуммаСНДСРасход КАК СуммаПоДокументуПриемкиСНДС
		|ИЗ
		|	РегистрНакопления.УСОERP_ВыполнениеРаботСубподрядчиком.Обороты(
		|			&ДатаНачалаПериода,
		|			&ДатаОкончанияПериода,
		|			Регистратор,
		|			Работа В (&СписокРабот)
		|				И ОбъектСтроительства = &ОбъектСтроительства
		|				И Организация = &Организация) КАК УСОERP_ВыполнениеРаботСубподрядчикомОбороты";

	Запрос.УстановитьПараметр("Организация",			Объект.Организация);
	Запрос.УстановитьПараметр("ОбъектСтроительства", 	Объект.ОбъектСтроительства);
	Запрос.УстановитьПараметр("ДатаНачалаПериода",		Объект.ДатаНачалаПериода);	
	Запрос.УстановитьПараметр("ДатаОкончанияПериода",	Объект.ДатаОкончанияПериода);
	Запрос.УстановитьПараметр("СписокРабот",			СписокРабот);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяРабота	=	Объект.СубподрядныеСМР.Добавить();  
		ЗаполнитьЗначенияСвойств(НоваяРабота, Выборка);
		РаботаПриИзмененииНаСервере(НоваяРабота.ПолучитьИдентификатор(), "СубподрядныеСМР");
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение, Табл, ИдентификаторСтроки = Неопределено)
	
	Если НовыйВариант И Табл = "Работы" Тогда
		
		ЗаполнитьТЧВыбраннымиРаботами_НовыйВариант(ВыбранноеЗначение);
		
	Иначе 		
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда 
		Для Каждого Элем из ВыбранноеЗначение Цикл
			ЗаполнитьТЧВыбраннымиРаботами(Элем, Табл, ИдентификаторСтроки);
		КонецЦикла;	
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.УСОERP_СтроительныеРаботы") Тогда
		ЗаполнитьТЧВыбраннымиРаботами(ВыбранноеЗначение, Табл, ИдентификаторСтроки);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбор этапа в данном случае не предусмотрен! Необходимо выбрать конкретную работу.'")
		                                                 + Символы.ПС + ОписаниеОшибки());
													 КонецЕсли;
	 КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧВыбраннымиРаботами(ВыбранноеЗначение, Табл, ИдентификаторСтроки = Неопределено)

	ЭтоСуммарнаяРабота = УСОERP_УправлениеСтроительнымПроизводством.ЭтоСуммарнаяРабота(ВыбранноеЗначение);
	Если Не ЭтоСуммарнаяРабота Тогда
		СтрокиРабот = Объект.Работы.НайтиСтроки(Новый Структура("Работа", ВыбранноеЗначение));
		Если СтрокиРабот.Количество() = 0 Тогда 
			Если ИдентификаторСтроки = Неопределено Тогда
				ТекущаяСтрока	=	Объект.Работы.Добавить();
			Иначе	
				ТекущаяСтрока	=	Объект.Работы.НайтиПоИдентификатору(ИдентификаторСтроки);
			КонецЕсли;
			ТекущаяСтрока.Работа = ВыбранноеЗначение;
			РаботаПриИзмененииНаСервере(ТекущаяСтрока.ПолучитьИдентификатор(), Табл);
		КонецЕсли;
	Иначе
		Если ИдентификаторСтроки = Неопределено Тогда
			// добавление этапа
			ТекущаяСтрока = Объект.Работы.Добавить();
			ТекущаяСтрока.Работа = ВыбранноеЗначение;
			РаботаПриИзмененииНаСервере(ТекущаяСтрока.ПолучитьИдентификатор(), Табл);
			// добавление подчиненных работ
			ПодчиненныеРаботы = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПодчиненныеРаботы(ВыбранноеЗначение, Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный, Дата("00010101"));
			Для каждого ЭлПодчиненныеРаботы Из ПодчиненныеРаботы Цикл
				СтрокиРабот = Объект.Работы.НайтиСтроки(Новый Структура("Работа", ЭлПодчиненныеРаботы.Работа));
				Если СтрокиРабот.Количество() = 0 Тогда 
					ТекущаяСтрока = Объект.Работы.Добавить();
					ТекущаяСтрока.Работа = ЭлПодчиненныеРаботы.Работа;
					РаботаПриИзмененииНаСервере(ТекущаяСтрока.ПолучитьИдентификатор(), Табл);
				КонецЕсли;
			КонецЦикла;
		Иначе	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбор этапа в данном случае не предусмотрен! Необходимо выбрать конкретную работу.'")
							+ Символы.ПС + ОписаниеОшибки());
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура  ЗаполнитьТЧВыбраннымиРаботами_НовыйВариант(ВыбранноеЗначение)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТабРаботы",Объект.Работы.Выгрузить().ВыгрузитьКолонку("Работа"));
	Запрос.УстановитьПараметр("МассивРабот",ВыбранноеЗначение);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботы.Ссылка КАК Работа,
	|	УСОERP_СтроительныеРаботы.ОбъемРаботы КАК ОбъемВсего,
	|	УСОERP_СтроительныеРаботы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	УСОERP_СтроительныеРаботы.ДатаНачала КАК ДатаНачала,
	|	УСОERP_СтроительныеРаботы.ДатаОкончания КАК ДатаОкончания,
	|	УСОERP_СтроительныеРаботы.СуммарнаяРабота КАК СуммарнаяРабота
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	УСОERP_СтроительныеРаботы.Ссылка В ИЕРАРХИИ(&МассивРабот)
	|	И НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
	|	И НЕ УСОERP_СтроительныеРаботы.Ссылка В (&ТабРаботы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_СтроительныеРаботы.ПорядокСортировки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если НЕ Выборка.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	
	Пока Выборка.Следующий() Цикл
		
		Если Объект.Работы.НайтиСтроки(Новый Структура("Работа",Выборка.Работа)).Количество() Тогда
			Продолжить;
		КонецЕсли;		
		
		Нстр = Объект.Работы.Добавить();
		ЗаполнитьЗначенияСвойств(Нстр,Выборка);
		
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ТабРабот",Объект.Работы.Выгрузить());
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТабРабот.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	ТабРабот.ОбъемВсего КАК ОбъемВсего,
	|	ТабРабот.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТабРабот.СтоимостьВсего КАК СтоимостьВсего,
	|	ТабРабот.ПроцентРеализованоНаНачалоПериода КАК ПроцентРеализованоНаНачалоПериода,
	|	ТабРабот.ОбъемНаНачалоПериода КАК ОбъемНаНачалоПериода,
	|	ТабРабот.СтоимостьСНДСНаНачалоПериода КАК СтоимостьСНДСНаНачалоПериода,
	|	ТабРабот.ПроцентВыполнения КАК ПроцентВыполнения,
	|	ТабРабот.ОбъемВыполнения КАК ОбъемВыполнения,
	|	ТабРабот.ПроцентРеализации КАК ПроцентРеализации,
	|	ТабРабот.ОбъемРеализации КАК ОбъемРеализации,
	|	ТабРабот.СуммаСНДС КАК СуммаСНДС,
	|	ТабРабот.СтавкаНДС КАК СтавкаНДС,
	|	ТабРабот.СуммаНДС КАК СуммаНДС,
	|	ТабРабот.ДатаНачала КАК ДатаНачала,
	|	ТабРабот.ДатаОкончания КАК ДатаОкончания,
	|	ТабРабот.СтоимостьСНДСВыполненоОбщая КАК СтоимостьСНДСВыполненоОбщая,
	|	ТабРабот.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	&ТабРабот КАК ТабРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.Работа КАК Работа,
	|	ВрТаб.ОбъемВсего КАК ОбъемВсего,
	|	ВрТаб.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ВрТаб.СтоимостьВсего КАК СтоимостьВсего,
	|	ВрТаб.ПроцентРеализованоНаНачалоПериода КАК ПроцентРеализованоНаНачалоПериода,
	|	ВрТаб.ОбъемНаНачалоПериода КАК ОбъемНаНачалоПериода,
	|	ВрТаб.СтоимостьСНДСНаНачалоПериода КАК СтоимостьСНДСНаНачалоПериода,
	|	ВрТаб.ПроцентВыполнения КАК ПроцентВыполнения,
	|	ВрТаб.ОбъемВыполнения КАК ОбъемВыполнения,
	|	ВрТаб.ПроцентРеализации КАК ПроцентРеализации,
	|	ВрТаб.ОбъемРеализации КАК ОбъемРеализации,
	|	ВрТаб.СуммаСНДС КАК СуммаСНДС,
	|	ВрТаб.СтавкаНДС КАК СтавкаНДС,
	|	ВрТаб.СуммаНДС КАК СуммаНДС,
	|	ВрТаб.ДатаНачала КАК ДатаНачала,
	|	ВрТаб.ДатаОкончания КАК ДатаОкончания,
	|	ВрТаб.СтоимостьСНДСВыполненоОбщая КАК СтоимостьСНДСВыполненоОбщая,
	|	ВрТаб.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов,
	|	ВрТаб.Работа.СуммарнаяРабота КАК СуммарнаяРабота
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВрТаб.Работа.ПорядокСортировки,
	|	ВрТаб.Работа.КодСДР";
	
	СписокРабот	=	Новый СписокЗначений;
	СписокРабот.ЗагрузитьЗначения(Объект.Работы.Выгрузить().ВыгрузитьКолонку("Работа"));
	
		ДанныеПоРаботам = УСОERP_ЗащищенныеФункцииСервер.УСОERP_РеализацияСтроительныхРаботВнутренняя_ПолучитьДанныеПоВыполнениюРабот(ЭтотОбъект, СписокРабот);
		
		Объект.Работы.Очистить();
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Нстр = Объект.Работы.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,Выборка);
			
		Строка = ДанныеПоРаботам.Найти(Нстр.Работа);
		
		Если Строка <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Нстр,Строка);
		КонецЕсли;
		
	КонецЦикла; 	
	
КонецПроцедуры 

&НаСервере
Процедура РаботаПриИзмененииНаСервере(ИдентификаторСтроки, Табл)
	
	ТекущаяСтрока = Объект[Табл].НайтиПоИдентификатору(ИдентификаторСтроки);
	
	СписокРабот	=	Новый СписокЗначений;
	СписокРабот.Добавить(ТекущаяСтрока.Работа);
	
	ДанныеПоРаботам = УСОERP_ЗащищенныеФункцииСервер.УСОERP_РеализацияСтроительныхРаботВнутренняя_ПолучитьДанныеПоВыполнениюРабот(ЭтотОбъект, СписокРабот);
	
	Если ДанныеПоРаботам.Количество() > 0 Тогда
		Для каждого ЭлРабота Из ДанныеПоРаботам Цикл
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока,	ЭлРабота);
		КонецЦикла;
	Иначе
		ТекущаяСтрока.ОбъемВсего 						= 	0;
		ТекущаяСтрока.ЕдиницаОбъема 					= 	Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
		ТекущаяСтрока.СтоимостьВсего					=	0;
		ТекущаяСтрока.ПроцентРеализованоНаНачалоПериода	=	0;
		ТекущаяСтрока.ОбъемНаНачалоПериода 				= 	0;
		ТекущаяСтрока.СтоимостьСНДСНаНачалоПериода		=	0;
		ТекущаяСтрока.ПроцентВыполнения					= 	0;
		ТекущаяСтрока.ОбъемВыполнения					=	0;
		ТекущаяСтрока.ДатаНачала 						= Дата("00010101");
		ТекущаяСтрока.ДатаОкончания 					= Дата("00010101");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.СтавкаНДС) Тогда
		ТекущаяСтрока.СтавкаНДС	=	Перечисления.СтавкиНДС.НДС18;
	КонецЕсли;   
	
	ТекущаяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(ТекущаяСтрока.СуммаСНДС, ТекущаяСтрока.СтавкаНДС, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуНДС(ИдентификаторСтроки, Табл)
	
	ТекущаяСтрока	=	Объект.Работы.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	ТекущаяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(ТекущаяСтрока.СуммаСНДС, ТекущаяСтрока.СтавкаНДС, Истина);
	
	РассчитатьИтоговыеПоказатели(ЭтаФорма, Табл);

КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммаСНДСНаСервере(ТекущаяСтрока, Табл)
	
	СтруктураДействий = Новый Структура;	
	СтруктураДействий.Вставить("СтроительствоПересчитатьСуммуНДС");
	ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, Неопределено);
	
	РассчитатьИтоговыеПоказатели(ЭтаФорма, Табл);

КонецПроцедуры

&НаСервере
Функция ПолучитьПодчиненныйДокумент(ИмяДокумента)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Док.Ссылка
	|ИЗ
	|	Документ." + ИмяДокумента + " КАК Док
	|ГДЕ
	|	Док.УСОERP_ДокументОснование = &Ссылка
	|	И НЕ Док.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура СформироватьАктВыполненныхРабот(ДанныеФормы)

	ДокументАктВыполненныхРаботОбъект = ДанныеФормыВЗначение(ДанныеФормы, Тип("ДокументОбъект.АктВыполненныхРабот")); 
	
	УсловияПродажПоУмолчанию = ПродажиСервер.ПолучитьУсловияПродажПоУмолчанию(
								Объект.Контрагент.Партнер,
								Новый Структура("ИсключитьГруппыСкладовДоступныеВЗаказах, ВыбранноеСоглашение, ХозяйственнаяОперация", 
								Истина, ДокументАктВыполненныхРаботОбъект.Соглашение, 
								Перечисления.ХозяйственныеОперации.РеализацияКлиенту));
	Если НЕ УсловияПродажПоУмолчанию	=	Неопределено Тогда  							 
		ЗаполнитьЗначенияСвойств(ДокументАктВыполненныхРаботОбъект, УсловияПродажПоУмолчанию);
	КонецЕсли;

	ДокументАктВыполненныхРаботОбъект.Дата 				        	= ТекущаяДата();
	ДокументАктВыполненныхРаботОбъект.Валюта 		            	= Объект.Договор.ВалютаВзаиморасчетов;
	ДокументАктВыполненныхРаботОбъект.Организация 		        	= Объект.Организация;
	ДокументАктВыполненныхРаботОбъект.БанковскийСчетОрганизации 	= ЗначениеНастроекПовтИсп.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(
																			ДокументАктВыполненныхРаботОбъект.Организация,
																			, 
																	    	ДокументАктВыполненныхРаботОбъект.БанковскийСчетОрганизации);
	ДокументАктВыполненныхРаботОбъект.Касса 						= ЗначениеНастроекПовтИсп.ПолучитьКассуОрганизацииПоУмолчанию(
																			ДокументАктВыполненныхРаботОбъект.Организация,
																			ДокументАктВыполненныхРаботОбъект.ФормаОплаты,
																			ДокументАктВыполненныхРаботОбъект.Касса);																		
	ДокументАктВыполненныхРаботОбъект.Контрагент 	            	= Объект.Контрагент;
	ДокументАктВыполненныхРаботОбъект.Партнер 	                	= Объект.Партнер;
	ДокументАктВыполненныхРаботОбъект.БанковскийСчетКонтрагента		= ЗначениеНастроекПовтИсп.ПолучитьБанковскийСчетКонтрагентаПоУмолчанию(Объект.Контрагент);
	ДокументАктВыполненныхРаботОбъект.Договор 		            	= Объект.Договор;
		
	ЗакупкиВызовСервера.ЗаполнитьБанковскиеСчетаПоДоговору(ДокументАктВыполненныхРаботОбъект.Договор, ДокументАктВыполненныхРаботОбъект.БанковскийСчетОрганизации, ДокументАктВыполненныхРаботОбъект.БанковскийСчетКонтрагента);	
	
	ДокументАктВыполненныхРаботОбъект.СуммаДокумента 	       		= Объект.СуммаДокумента;
	ДокументАктВыполненныхРаботОбъект.СуммаВзаиморасчетов      		= Объект.СуммаДокумента;
	ДокументАктВыполненныхРаботОбъект.ЦенаВключаетНДС           	= Истина;
	ДокументАктВыполненныхРаботОбъект.ВалютаВзаиморасчетов      	= Объект.Договор.ВалютаВзаиморасчетов;	
	ДокументАктВыполненныхРаботОбъект.НалогообложениеНДС        	= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	ДокументАктВыполненныхРаботОбъект.УСОERP_ДокументОснование        	= Объект.Ссылка;
	ДокументАктВыполненныхРаботОбъект.Менеджер                		= Пользователи.ТекущийПользователь();

	КоличествоСтрок =  Объект.Работы.Количество();
	Если КоличествоСтрок > 0 Тогда 
		ТекущаяСтрока = ДокументАктВыполненныхРаботОбъект.Услуги.Добавить();
		ТекущаяСтрока.Номенклатура				=	Объект.ОбъектСтроительства.НоменклатураРаботЗаказчика;
		ТекущаяСтрока.Содержание				=	"Реализация строительных работ по договору " + Объект.Договор.Наименование + " за период: " + Формат(Объект.ДатаНачалаПериода, "ДЛФ = Д") + " - " + Формат(Объект.ДатаОкончанияПериода, "ДЛФ = Д");
		ТекущаяСтрока.Количество				=	1;
		ТекущаяСтрока.СтавкаНДС					=	Объект.Работы[0].СтавкаНДС;	
		ТекущаяСтрока.СуммаНДС					=	ИтогиРаботыСуммаНДС + ИтогиСубподрядныеСМРСуммаНДС;
		ТекущаяСтрока.Сумма						=	ИтогиРаботыСуммаВсего + ИтогиСубподрядныеСМРСуммаВсего;
		ТекущаяСтрока.СуммаСНДС					=	ИтогиРаботыСуммаВсего + ИтогиСубподрядныеСМРСуммаВсего;
		ТекущаяСтрока.СуммаВзаиморасчетов		=	ИтогиРаботыСуммаВсего + ИтогиСубподрядныеСМРСуммаВсего;
		ТекущаяСтрока.Цена						=	ИтогиРаботыСуммаВсего + ИтогиСубподрядныеСМРСуммаВсего;
	КонецЕсли;
	
	ЗначениеВДанныеФормы(ДокументАктВыполненныхРаботОбъект, ДанныеФормы);
	Попытка
		ДокументАктВыполненныхРаботОбъект.Записать(РежимЗаписиДокумента.Проведение);
		ОбновитьСерверПодчиненныйДокумент();
	Исключение
	    
	КонецПопытки;
	
КонецПроцедуры

