Процедура ДатаПриИзмененииСервер()
	
	ОтветственныеЛицаСервер.ПриИзмененииСвязанныхРеквизитовДокумента(Объект);
	
КонецПроцедуры

#КонецОбласти

#Область Прочее

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ВалютаДокумента = Объект.Валюта;
	ВалютаВзаиморасчетовДокумента = Объект.ВалютаВзаиморасчетов;
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	РассчитатьИтоговыеПоказатели(ЭтаФорма, "Работы");	
		
	ОбновитьВспомогательныеРеквизитыТабличнойЧастиРаботы();
		
КонецПроцедуры

&НаКлиенте
Процедура ВыборПериода(Команда)
	
	//ОбщегоНазначенияУТКлиент.РедактироватьПериод(Объект, 
	//	Новый Структура("ДатаНачала, ДатаОкончания", "ДатаНачала", "ДатаОкончания"));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("РезультатВыбораПериода", ЭтаФорма);
	
	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериода",,,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатВыбораПериода(Результат, ДополнительныеПараметры) Экспорт

	Если Объект.Работы.Количество() > 0 Тогда
		ОчиститьТабличнуюЧасть(Результат, "ВыборПериода");
	ИначеЕсли Результат <> Неопределено Тогда
		Объект.ДатаНачалаПериода = Результат.НачалоПериода;
		Объект.ДатаОкончанияПериода = Результат.КонецПериода; 
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТабличнуюЧасть(ВыбранноеЗначение, ИмяЭлемента)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Значение", ВыбранноеЗначение);
	ДопПараметры.Вставить("Имя", ИмяЭлемента);
	
	Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеЗакрытияВопроса", ЭтаФорма, ДопПараметры);
	ПоказатьВопрос(Оповещение, "Табличная часть ""Работы"" и ""Субподрядные работы"" будут очищены. Продолжить?", РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеЗакрытияВопроса(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	Иначе
		Объект.Работы.Очистить();
		Объект.СубподрядныеСМР.Очистить();
		
		Если ТипЗнч(ДопПараметры.Значение) = Тип("СправочникСсылка.СМ_ОбъектыСтроительства") Тогда
			Объект.ОбъектСтроительства = ДопПараметры.Значение;
		ИначеЕсли ТипЗнч(ДопПараметры.Значение) = Тип("СправочникСсылка.Контрагенты") Тогда
			Объект.Контрагент = ДопПараметры.Значение;
		ИначеЕсли ТипЗнч(ДопПараметры.Значение) = Тип("СправочникСсылка.Партнеры") Тогда
			Объект.Партнер = ДопПараметры.Значение;
		ИначеЕсли ТипЗнч(ДопПараметры.Значение) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			Объект.Договор = ДопПараметры.Значение;	
		ИначеЕсли ТипЗнч(ДопПараметры.Значение) = Тип("Дата") Тогда
			Если ДопПараметры.Имя = "ДатаНачалаПериода" Тогда
				Объект.ДатаНачалаПериода = ДопПараметры.Значение;
			Иначе
				Объект.ДатаОкончанияПериода = ДопПараметры.Значение;
			КонецЕсли;
		ИначеЕсли ТипЗнч(ДопПараметры.Значение) = Тип("Структура") Тогда
			Объект.ДатаНачалаПериода = ДопПараметры.Значение.НачалоПериода;
			Объект.ДатаОкончанияПериода = ДопПараметры.Значение.КонецПериода;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДоговорПоУмолчанию()
	
	Договор = ПродажиСервер.ПолучитьДоговорПоУмолчанию(Объект, Объект.Договор.ХозяйственнаяОперация);
	
	Если Договор <> Объект.Договор Тогда
		Объект.Договор = Договор;
		Объект.Валюта = Объект.Договор.ВалютаВзаиморасчетов;
		Объект.ВалютаВзаиморасчетов = Объект.Договор.ВалютаВзаиморасчетов;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьИтоговыеПоказатели(Форма, Табл)
	
	Форма["Итоги" + Табл + "СуммаВсего"]     = Форма.Объект[Табл].Итог("СуммаСНДС");
	Форма["Итоги" + Табл + "СуммаНДС"]       = Форма.Объект[Табл].Итог("СуммаНДС");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСерверПодчиненныйДокумент()
	
	ПодчиненныйДокументАктВыполненныхРабот = ПолучитьПодчиненныйДокумент("АктВыполненныхРабот");
	ВидимостьПодчиненныйДокумент(ЭтаФорма, ПодчиненныйДокументАктВыполненныхРабот);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьПодчиненныйДокумент(Форма, ПодчиненныйДокументАктВыполненныхРабот)
	
	Если ПодчиненныйДокументАктВыполненныхРабот.Пустая() Тогда 
		Форма.Элементы.СформироватьАкт.Заголовок	    = "Сформировать документ ""Акт выполненных работ""";
		Форма.Элементы.КартинкаСформироватьАкт.Картинка	= Новый Картинка();
	Иначе 	
		Форма.Элементы.СформироватьАкт.Заголовок	=	"" + ПодчиненныйДокументАктВыполненныхРабот;
		Если ПодчиненныйДокументАктВыполненныхРабот.Проведен Тогда
			Форма.Элементы.КартинкаСформироватьАкт.Картинка = БиблиотекаКартинок.ДокументПроведенКоннекторНиз;			
		ИначеЕсли ПодчиненныйДокументАктВыполненныхРабот.ПометкаУдаления Тогда
			Форма.Элементы.КартинкаСформироватьАкт.Картинка = БиблиотекаКартинок.ДокументПомеченНаУдалениеКоннекторНиз;			
		Иначе
			Форма.Элементы.КартинкаСформироватьАкт.Картинка = БиблиотекаКартинок.ДокументЗаписанКоннекторНиз;			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодчиненныеСвойстваПоСтатистике(ИмяРеквизитаРодителя)
	
	ЗаполнениеСвойствПоСтатистикеСервер.ЗаполнитьПодчиненныеСвойства(Объект, ИмяРеквизитаРодителя);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВспомогательныеРеквизитыТабличнойЧастиРаботы()
	
	Для Каждого СтрокаРабота Из Объект.Работы Цикл
		СтрокаРабота.СуммарнаяРабота = СтрокаРабота.Работа.СуммарнаяРабота;
		СтрокаРабота.ДоступноКПриему = СтрокаРабота.ОбъемВыполнения - СтрокаРабота.ОбъемНаНачалоПериода;
		СтрокаРабота.СтоимостьДоступнаяКПриему = СтрокаРабота.СтоимостьСНДСВыполненоОбщая - СтрокаРабота.СтоимостьСНДСНаНачалоПериода;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСБуферомОбмена

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьИтоговыеПоказателиВыполненияРабот(Форма, ТекущаяСтрока = Неопределено)

	Если ТекущаяСтрока = Неопределено Тогда
		КоллекцияРаботы = Форма.Объект.Работы;
		Для каждого ЭлКоллекции Из КоллекцияРаботы Цикл
			ЭлКоллекции.ОбъемВыполненоВсего	=	ЭлКоллекции.ОбъемРеализации + ЭлКоллекции.ОбъемНаНачалоПериода;
			ЭлКоллекции.СуммаСНДСВсего		=	ЭлКоллекции.СтоимостьСНДСНаНачалоПериода + ЭлКоллекции.СуммаСНДС;
		КонецЦикла;
	Иначе
		ТекущаяСтрока.ОбъемВыполненоВсего	=	ТекущаяСтрока.ОбъемРеализации + ТекущаяСтрока.ОбъемНаНачалоПериода;
		ТекущаяСтрока.СуммаСНДСВсего		=	ТекущаяСтрока.СтоимостьСНДСНаНачалоПериода + ТекущаяСтрока.СуммаСНДС;
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти

#Область Дополнительно
&НаКлиенте
Процедура ЗаполнитьВыполненоВсего(Команда)
	ЗаполнитьВыполненоВсегоНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВыполненоВсегоНаСервере()
	
	Если НЕ ЗначениеЗаполнено(Объект.ОбъектСтроительства.НоменклатураРаботЗаказчика) Тогда
		ТекстОшибки = НСтр("ru='Для объекта строительства не заполнен реквизит ""Номенклатура работ при отгрузке заказчику"".'");
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЕдиницыИзмерения.Ссылка КАК Штука
		|ПОМЕСТИТЬ ЕдиницаИзмерения
		|ИЗ
		|	Справочник.УпаковкиЕдиницыИзмерения КАК ЕдиницыИзмерения
		|ГДЕ
		|	НЕ ЕдиницыИзмерения.ПометкаУдаления
		|	И ЕдиницыИзмерения.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.КоличествоШтук)
		|	И ЕдиницыИзмерения.НаименованиеПолное ПОДОБНО ""Штука""
		|	И ЕдиницыИзмерения.Владелец = ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.БазовыеЕдиницыИзмерения)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Работы.СуммаСНДС КАК Сумма,
		|	Работы.СтавкаНДС,
		|	Работы.СуммаНДС КАК СуммаНДС
		|ПОМЕСТИТЬ ТЧ_Работы
		|ИЗ
		|	&Работы КАК Работы
		|ГДЕ
		|	НЕ Работы.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СМ_ОбъектыСтроительства.НоменклатураРаботЗаказчика КАК Номенклатура,
		|	СМ_ОбъектыСтроительства.НоменклатураРаботЗаказчика.ГруппаФинансовогоУчета КАК НоменклатурнаяГруппа,
		|	1 КАК КоличествоУпаковок,
		|	ЕдиницаИзмерения.Штука КАК Упаковка,
		|	СУММА(ТЧ_Работы.Сумма) КАК Цена,
		|	СУММА(ТЧ_Работы.Сумма) КАК Сумма,
		|	ТЧ_Работы.СтавкаНДС,
		|	СУММА(ТЧ_Работы.СуммаНДС) КАК СуммаНДС
		|ИЗ
		|	ТЧ_Работы КАК ТЧ_Работы,
		|	ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Справочник.СМ_ОбъектыСтроительства КАК СМ_ОбъектыСтроительства
		|ГДЕ
		|	СМ_ОбъектыСтроительства.Ссылка = &ОбъектСтроительства
		|
		|СГРУППИРОВАТЬ ПО
		|	ТЧ_Работы.СтавкаНДС,
		|	ЕдиницаИзмерения.Штука,
		|	СМ_ОбъектыСтроительства.НоменклатураРаботЗаказчика,
		|	СМ_ОбъектыСтроительства.НоменклатураРаботЗаказчика.ГруппаФинансовогоУчета";
		
	Запрос.УстановитьПараметр("Работы", 				Объект.Работы.Выгрузить());
	Запрос.УстановитьПараметр("ОбъектСтроительства",	Объект.ОбъектСтроительства);
	
	ДанныеЗаполнения = Запрос.Выполнить().Выбрать();
	
	Если ДанныеЗаполнения.Количество() > 1 Тогда
		ТекстОшибки = НСтр("ru='В табличной части ""Работы"" введены несколько различных ставок НДС.'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Объект.ВыполненоВсего.Очистить();
	ДанныеЗаполнения.Следующий();
			
	// Заполнение ТЧ "ВыполненоВсего"
	НоваяСтрокаТЧ = Объект.ВыполненоВсего.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ, ДанныеЗаполнения);
	НоваяСтрокаТЧ.НаправлениеДеятельности = Объект.ДокументУтверждения.НаправлениеДеятельности;
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтложенныйНДСПриИзменении(Элемент)
	
	Элементы.ГруппаВыполненоВсего.Видимость = Объект.ОтложенныйНДС;
	
	Если НЕ Объект.ОтложенныйНДС Тогда
		Объект.ВыполненоВсего.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДокументУтвержденияПриИзмененииНаСервере()
	НовыйВариант = Объект.ДокументУтверждения.СценарийПланирования.НовыйВариант = Истина;
	Объект.НаправлениеДеятельности = Объект.ДокументУтверждения.НаправлениеДеятельности;
КонецПроцедуры

&НаКлиенте
Процедура ДокументУтвержденияПриИзменении(Элемент)
	ДокументУтвержденияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДокументУтвержденияОчистка(Элемент, СтандартнаяОбработка)
	ДокументУтвержденияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыполненоВсегоЦенаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ВыполненоВсего.ТекущиеДанные;
	ТекущаяСтрока.Сумма = ТекущаяСтрока.КоличествоУпаковок*ТекущаяСтрока.Цена;
	ПересчитатьСуммуНДС_(ТекущаяСтрока);

КонецПроцедуры

&НаКлиенте
Процедура ВыполненоВсегоКоличествоУпаковокПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ВыполненоВсего.ТекущиеДанные;
	ТекущаяСтрока.Сумма = ТекущаяСтрока.КоличествоУпаковок*ТекущаяСтрока.Цена;
	ПересчитатьСуммуНДС_(ТекущаяСтрока);

КонецПроцедуры

&НаКлиенте
Процедура ВыполненоВсегоСуммаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ВыполненоВсего.ТекущиеДанные;
	
	Если ТекущаяСтрока.КоличествоУпаковок Тогда
		ТекущаяСтрока.Цена = ТекущаяСтрока.Сумма/ТекущаяСтрока.КоличествоУпаковок;
	КонецЕсли;
		
	ПересчитатьСуммуНДС_(ТекущаяСтрока);

КонецПроцедуры

&НаКлиенте
Процедура ВыполненоВсегоСтавкаНДСПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ВыполненоВсего.ТекущиеДанные;
	
	ПересчитатьСуммуНДС_(ТекущаяСтрока);

КонецПроцедуры 

&НаКлиенте  
Процедура ПересчитатьСуммуНДС_(ТекущаяСтрока)
	
	ТекущаяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(ТекущаяСтрока.Сумма, ТекущаяСтрока.СтавкаНДС, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ВыполненоВсегоПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Объект.СуммаДокумента = ?(Объект.Работы.Количество(),Объект.Работы.Итог("СуммаСНДС"),Объект.ВыполненоВсего.Итог("Сумма"));
	Объект.СуммаНДС = ?(Объект.Работы.Количество(),Объект.Работы.Итог("СуммаНДС"),Объект.ВыполненоВсего.Итог("СуммаНДС"));
	СформироватьНадписьВалюты(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ВыполненоВсегоПослеУдаления(Элемент)
	Объект.СуммаДокумента = ?(Объект.Работы.Количество(),Объект.Работы.Итог("СуммаСНДС"),Объект.ВыполненоВсего.Итог("Сумма"));
	Объект.СуммаНДС = ?(Объект.Работы.Количество(),Объект.Работы.Итог("СуммаНДС"),Объект.ВыполненоВсего.Итог("СуммаНДС"));
	СформироватьНадписьВалюты(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура РаботыПослеУдаления(Элемент)
	
	Если НовыйВариант Тогда
		УдалитьПустыхРодителей();
	КонецЕсли;
	
	
	Объект.СуммаДокумента = ?(Объект.Работы.Количество(),Объект.Работы.Итог("СуммаСНДС"),Объект.ВыполненоВсего.Итог("Сумма"));
	Объект.СуммаНДС = ?(Объект.Работы.Количество(),Объект.Работы.Итог("СуммаНДС"),Объект.ВыполненоВсего.Итог("СуммаНДС"));
	СформироватьНадписьВалюты(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура РаботыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Объект.СуммаДокумента = ?(Объект.Работы.Количество(),Объект.Работы.Итог("СуммаСНДС"),Объект.ВыполненоВсего.Итог("Сумма"));
	Объект.СуммаНДС = ?(Объект.Работы.Количество(),Объект.Работы.Итог("СуммаНДС"),Объект.ВыполненоВсего.Итог("СуммаНДС"));
	СформироватьНадписьВалюты(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура РаботыПередУдалением(Элемент, Отказ)
	УдалитьПодчиненныеРаботы(Элемент.ТекущиеДанные.ПолучитьИдентификатор());
КонецПроцедуры

&НаСервере
Процедура УдалитьПодчиненныеРаботы(ИдСтроки)
	
	Если НЕ НовыйВариант Тогда
		Возврат;
	КонецЕсли;   	
	
	Строка = Объект.Работы.НайтиПоИдентификатору(ИдСтроки);
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Работа",Строка.Работа);
	
	МассивСтрокДляУдаления = Новый Массив;
	
	Если Строка.СуммарнаяРабота Тогда  		
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	УСОERP_СтроительныеРаботы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
		|ГДЕ
		|	УСОERP_СтроительныеРаботы.Ссылка В ИЕРАРХИИ(&Работа)";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтрокиРаботы = Объект.Работы.НайтиСтроки(Новый Структура("Работа",Выборка.Ссылка));
			
			Для Каждого СтрокаРаботы ИЗ СтрокиРаботы Цикл
				
				МассивСтрокДляУдаления.Добавить(СтрокаРаботы);
				
			КонецЦикла; 			
			
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого ЭлементМассива ИЗ МассивСтрокДляУдаления Цикл
		
		Объект.Работы.Удалить(ЭлементМассива);
		
	КонецЦикла;   		
	
КонецПроцедуры

&НаСервере
Процедура УдалитьПустыхРодителей()
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МассивРабот",Объект.Работы.Выгрузить().Скопировать(Новый Структура("СуммарнаяРабота",Ложь)).ВыгрузитьКолонку("Работа"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	УСОERP_СтроительныеРаботы.Ссылка В(&МассивРабот)
	|ИТОГИ ПО
	|	Ссылка ТОЛЬКО ИЕРАРХИЯ";
	
	ТЗРабот = Запрос.Выполнить().Выгрузить();
	
	МассивСтрокДляУдаления = Новый Массив;
	
	Строки = Объект.Работы.НайтиСтроки(Новый Структура("СуммарнаяРабота",Истина));
	
	Для Каждого НайденнаяСтрока ИЗ Строки Цикл
		
		Если ТЗРабот.Найти(НайденнаяСтрока.Работа) = Неопределено Тогда
			МассивСтрокДляУдаления.Добавить(НайденнаяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ЭлементМассива ИЗ МассивСтрокДляУдаления Цикл
		
		Объект.Работы.Удалить(ЭлементМассива);
		
	КонецЦикла;  	
	
КонецПроцедуры

