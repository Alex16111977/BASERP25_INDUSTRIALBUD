
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
		
	ИнициализироватьДокумент(ДанныеЗаполнения);
		
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Для ТекИндекс = 0 По СубподрядныеСМР.Количество()-1 Цикл
		
		АдресОшибки = НСтр("ru=' в строке %НомерСтроки% списка ""Работы""'");
		АдресОшибки = СтрЗаменить(АдресОшибки, "%НомерСтроки%", Работы[ТекИндекс].НомерСтроки);
		
		Если Не ЗначениеЗаполнено(Работы[ТекИндекс].СуммаСНДС) Тогда			
			ТекстОшибки = НСтр("ru='Не заполнено поле ""Стоимость с НДС""'");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			ТекстОшибки + АдресОшибки,
			ЭтотОбъект,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Работы", Работы[ТекИндекс].НомерСтроки, "Стоимость с НДС"),
			,
			Отказ);		
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Работы[ТекИндекс].СтавкаНДС) Тогда			
			ТекстОшибки = НСтр("ru='Не заполнено поле ""Ставка НДС""'");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			ТекстОшибки + АдресОшибки,
			ЭтотОбъект,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Работы", Работы[ТекИндекс].НомерСтроки, "Ставка НДС"),
			,
			Отказ);		
		КонецЕсли;
		
	КонецЦикла;	
	
	ПроверитьНаКорректностьОбъемыиСтоимостиПринимаемыхРабот(Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЦенаВключаетНДС = Истина;
	ВыполненоВсего.ЗагрузитьКолонку(ВыполненоВсего.ВыгрузитьКолонку("Сумма"),"СуммаСНДС");
	
	Если НЕ ЗначениеЗаполнено(НаправлениеДеятельности) Тогда
		НаправлениеДеятельности = ДокументУтверждения.НаправлениеДеятельности;
	КонецЕсли;  
	
	ПроведениеСерверУТ.УстановитьРежимПроведения(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
	СуммаДокумента = ПолучитьСуммуДокумента();
	
	СуммаНДС = ПолучитьСуммуНДСДокумента();
	
	Если ВыполненоВсего.Количество() Тогда
		
		СуммаДокумента = ВыполненоВсего.Итог("Сумма");
		СуммаНДС = ВыполненоВсего.Итог("СуммаНДС");
		
	КонецЕсли; 	
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		ВзаиморасчетыСервер.ЗаполнитьИдентификаторыСтрокВТабличнойЧасти(ВыполненоВсего);
		
		Для Каждого СтрокаТЧ ИЗ ВыполненоВсего   Цикл
			
			СтрокаТЧ.СуммаВзаиморасчетов = 0;
			
		КонецЦикла;
		
		СтруктураКурса = РаботаСКурсамиВалютУТ.СтруктураКурсаВалюты(Курс,Кратность); 		
		
		Ценообразование.РассчитатьСуммыВзаиморасчетовВТабличнойЧасти(ЭтотОбъект, "ВыполненоВсего", СтруктураКурса);
		
		ЗаполнитьСуммуВзаиморасчетов(СтруктураКурса); 
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСуммуВзаиморасчетов(СтруктураКурса)
	
	Если ВыполненоВсего.НайтиСтроки(Новый Структура("СуммаВзаиморасчетов", 0)).Количество()=0 Тогда
		
		СуммаВзаиморасчетов = ВыполненоВсего.Итог("СуммаВзаиморасчетов");
		
	Иначе
		
		ВзаиморасчетыСервер.ЗаполнитьСуммуВзаиморасчетов(ЭтотОбъект, "ВыполненоВсего" , СтруктураКурса);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	Документы.УСОERP_РеализацияСтроительныхРаботВнутренняя.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);  
	
	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	Если Статус = Перечисления.СтатусыПланов.Утвержден Тогда
		
		УСОERP_УправлениеСтроительнымПроизводством.ОтразитьДвиженияУчетПринятияРеализацииРабот(ДополнительныеСвойства, Движения, Отказ);
		
		ВзаиморасчетыСервер.ОтразитьСуммыДокументаВВалютеРегл(ДополнительныеСвойства, Движения, Отказ);
		
		РеглУчетПроведениеСервер.ЗарегистрироватьКОтражению(ЭтотОбъект, ДополнительныеСвойства, Движения, Отказ);		
		
	КонецЕсли;
	
	СформироватьСписокРегистровДляКонтроля(); 
	
	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСерверУТ.ВыполнитьКонтрольРезультатовПроведения(ЭтотОбъект, Отказ);    
	
	ПроведениеСерверУТ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	СформироватьСписокРегистровДляКонтроля();
	
	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСерверУТ.ВыполнитьКонтрольРезультатовПроведения(ЭтотОбъект, Отказ);
	
	ПроведениеСерверУТ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИнициализироватьДокумент();
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка ИЛИ ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Инициализация

Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Ответственный			=	Пользователи.ТекущийПользователь();
	Организация				=	ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Организация);
	ДатаНачалаПериода		=	НачалоМесяца(ТекущаяДата());
	ДатаОкончанияПериода	=	КонецМесяца(ТекущаяДата());

КонецПроцедуры

#КонецОбласти

#Область Прочее

Функция ПолучитьСуммуДокумента()
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	Работы.Работа КАК Работа,
	|	Работы.СуммаСНДС КАК СуммаСНДС
	|ПОМЕСТИТЬ
	|	Работы
	|ИЗ
	|	&Работы КАК Работы
	|;
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Работы.СуммаСНДС),0) КАК СуммаСНДС
	|ИЗ
	|	Работы КАК Работы
	|");
	
	Запрос.УстановитьПараметр("Работы", Работы.Выгрузить(,"Работа,СуммаСНДС"));	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	СуммаИтого = Выгрузка[0].СуммаСНДС;
	Возврат СуммаИтого;
	
КонецФункции

Функция ПолучитьСуммуНДСДокумента()
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	Работы.Работа КАК Работа,
	|	Работы.СуммаНДС КАК СуммаНДС
	|ПОМЕСТИТЬ
	|	Работы
	|ИЗ
	|	&Работы КАК Работы
	|;
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Работы.СуммаНДС),0) КАК СуммаНДС
	|ИЗ
	|	Работы КАК Работы
	|");
	
	Запрос.УстановитьПараметр("Работы", Работы.Выгрузить(,"Работа,СуммаНДС"));	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	СуммаИтого = Выгрузка[0].СуммаНДС;
	Возврат СуммаИтого;
	
КонецФункции

Процедура СформироватьСписокРегистровДляКонтроля()

	Массив = Новый Массив;
	
 	Если ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
	КонецЕсли;
	
	ДополнительныеСвойства.ДляПроведения.Вставить("РегистрыДляКонтроля", Массив);
	
КонецПроцедуры

#КонецОбласти

Процедура ПроверитьНаКорректностьОбъемыИСтоимостиПринимаемыхРабот(Отказ = Ложь)
	
	Для Каждого СтрокаРабота Из Работы Цикл
		ДопустимыйОбъем = СтрокаРабота.ОбъемВыполнения - СтрокаРабота.ОбъемНаНачалоПериода;
		Если Не СтрокаРабота.Работа.СуммарнаяРабота
			И СтрокаРабота.ОбъемРеализации > ДопустимыйОбъем Тогда
			СообщениеОбОшибке = НСтр("ru='Принимаемый объем работы %Работа% превышает допустимый объем к приему на %Количество% %ЕдиницаИзмерения%'");
			
			СообщениеОбОшибке = СтрЗаменить(СообщениеОбОшибке, "%Работа%",          	СтрокаРабота.Работа);
			СообщениеОбОшибке = СтрЗаменить(СообщениеОбОшибке, "%Количество%",          -(ДопустимыйОбъем -  СтрокаРабота.ОбъемРеализации));
			СообщениеОбОшибке = СтрЗаменить(СообщениеОбОшибке, "%ЕдиницаИзмерения%",    СтрокаРабота.ЕдиницаОбъема);
			
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Работы", СтрокаРабота.НомерСтроки, "ОбъемРеализации");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке, Ссылка,Поле, "Объект");
			
			Отказ = Истина;
			
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
