Функция ТекстЗапросаВтАналитика()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АналитикаНоменклатуры.КлючАналитики КАК АналитикаНоменклатуры,
	|	ТаблицаВыполнено.Номенклатура КАК Номенклатура,
	|	ТаблицаВыполнено.Характеристика КАК Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) КАК Склад
	|ПОМЕСТИТЬ ВтАналитика
	|ИЗ
	|	Документ.УСОERP_РеализацияСтроительныхРаботВнутренняя.ВыполненоВсего КАК ТаблицаВыполнено
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаНоменклатуры КАК АналитикаНоменклатуры
	|		ПО ТаблицаВыполнено.Номенклатура = АналитикаНоменклатуры.Номенклатура
	|			И ТаблицаВыполнено.Характеристика = АналитикаНоменклатуры.Характеристика
	|			И (ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) = АналитикаНоменклатуры.МестоХранения)
	|ГДЕ
	|	ТаблицаВыполнено.Ссылка = &Ссылка
	|	И ТаблицаВыполнено.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АналитикаНоменклатуры.КлючАналитики,
	|	ТаблицаВыполнено.Номенклатура,
	|	ТаблицаВыполнено.Характеристика,
	|	ТаблицаВыполнено.Ссылка.Подразделение
	|ИЗ
	|	Документ.УСОERP_РеализацияСтроительныхРаботВнутренняя.ВыполненоВсего КАК ТаблицаВыполнено
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаНоменклатуры КАК АналитикаНоменклатуры
	|		ПО ТаблицаВыполнено.Номенклатура = АналитикаНоменклатуры.Номенклатура
	|			И ТаблицаВыполнено.Характеристика = АналитикаНоменклатуры.Характеристика
	|			И (ТаблицаВыполнено.Ссылка.Подразделение = АналитикаНоменклатуры.МестоХранения)
	|ГДЕ
	|	ТаблицаВыполнено.Ссылка = &Ссылка
	|	И ТаблицаВыполнено.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	Возврат ТекстЗапроса;
	
