//       См. описание 1 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//   Параметры - Структура - Вспомогательные параметры. Для чтения.
//       См. описание 2 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//
Процедура ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании, НастройкиФормы) Экспорт 
	
	Документы.ВыпускПродукции.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании, Ложь);
	
КонецПроцедуры

#КонецОбласти
// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} }

#Область Отчеты

// Определяет список команд отчетов.
//
// Параметры:
//   КомандыОтчетов - ТаблицаЗначений - Таблица с командами отчетов. Для изменения.
//       См. описание 1 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
//   Параметры - Структура - Вспомогательные параметры. Для чтения.
//       См. описание 2 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
//
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, Параметры) Экспорт
	
	ВариантыОтчетовУТПереопределяемый.ДобавитьКомандуСтруктураПодчиненности(КомандыОтчетов);
	
КонецПроцедуры

#КонецОбласти

#Область Печать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "КС2";
	КомандаПечати.Представление = НСтр("ru = 'КС-2'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "КС3";
	КомандаПечати.Представление = НСтр("ru = 'КС-3'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
КонецПроцедуры

// Сформировать печатные формы объектов
//
// ВХОДЯЩИЕ:
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//
// ИСХОДЯЩИЕ:
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КС2") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "КС2", "КС-2", СформироватьПечатнуюФормуКС2(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КС3") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "КС3", "КС-3", СформироватьПечатнуюФормуКС3(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
	ФормированиеПечатныхФорм.ЗаполнитьПараметрыОтправки(ПараметрыВывода.ПараметрыОтправки, МассивОбъектов, КоллекцияПечатныхФорм);
	
КонецПроцедуры

Функция СформироватьПечатнуюФормуКС2(МассивОбъектов, ОбъектыПечати)
	
	Макет               = ПолучитьМакет("КС2");
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока		= Макет.ПолучитьОбласть("Строка");
	ОбластьЭтап			= Макет.ПолучитьОбласть("СтрокаЭтап");
	ОбластьИтогоПоЛисту = Макет.ПолучитьОбласть("ИтогоПоЛисту");
	ОбластьИтогоПоАкту	= Макет.ПолучитьОбласть("ИтогоПоАкту");
	ОбластьПодвал		= Макет.ПолучитьОбласть("Подвал");
	
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_УСОERP_РеализацияСтроительныхРабот_КС2";
	
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_РеализацияСтроительныхРабот.Номер КАК НомерДокумента,
	|	УСОERP_РеализацияСтроительныхРабот.Дата КАК ДатаДокумента,
	|	УСОERP_РеализацияСтроительныхРабот.Организация КАК ОрганизацияПолучатель,
	|	УСОERP_РеализацияСтроительныхРабот.Контрагент КАК ОрганизацияПоставщик,
	|	УСОERP_РеализацияСтроительныхРабот.ОбъектСтроительства КАК Проект,
	|	УСОERP_РеализацияСтроительныхРабот.Договор,
	|	УСОERP_РеализацияСтроительныхРабот.Договор.Номер,
	|	УСОERP_РеализацияСтроительныхРабот.СуммаДокумента,
	|	УСОERP_РеализацияСтроительныхРабот.Контрагент КАК Подрядчик,
	|	УСОERP_РеализацияСтроительныхРабот.Дата,
	|	УСОERP_РеализацияСтроительныхРабот.Договор.Дата,
	|	УСОERP_РеализацияСтроительныхРабот.ДатаНачалаПериода КАК НачалоРабот,
	|	УСОERP_РеализацияСтроительныхРабот.ДатаОкончанияПериода КАК ОкончаниеРабот,
	|	УСОERP_РеализацияСтроительныхРабот.Организация.КодПоОКПО,
	|	УСОERP_РеализацияСтроительныхРабот.Контрагент.КодПоОКПО,
	|	УСОERP_РеализацияСтроительныхРабот.Ссылка,
	|	УСОERP_РеализацияСтроительныхРабот.Организация,
	|	УСОERP_РеализацияСтроительныхРабот.Контрагент,
	|	УСОERP_РеализацияСтроительныхРабот.Ответственный,
	|	УСОERP_РеализацияСтроительныхРабот.ОбъектСтроительства.Наименование КАК ПроектНаименование,
	|	УСОERP_РеализацияСтроительныхРабот.ОбъектСтроительства.АдресОбъектаСтроительства КАК ПроектАдрес
	|ИЗ
	|	Документ.УСОERP_РеализацияСтроительныхРаботВнутренняя КАК УСОERP_РеализацияСтроительныхРабот
	|ГДЕ
	|	УСОERP_РеализацияСтроительныхРабот.Ссылка В(&МассивДокументов)";
	
	Запрос.УстановитьПараметр("МассивДокументов", 				МассивОбъектов);
	
	ДанныеПечати 		= Запрос.Выполнить().Выбрать();	
	
	Пока ДанныеПечати.Следующий() Цикл
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(РеализацияСтроительныхРабот.СуммаСНДС) КАК СуммаСНДС,
		|	СУММА(РеализацияСтроительныхРабот.СуммаНДС) КАК СуммаНДС,
		|	СУММА(РеализацияСтроительныхРабот.СуммаСНДС - РеализацияСтроительныхРабот.СуммаНДС) КАК Стоимость,
		|	РеализацияСтроительныхРабот.Работа КАК Работа,
		|	РеализацияСтроительныхРабот.ЕдиницаОбъема,
		|	РеализацияСтроительныхРабот.ОбъемРеализации КАК Количество,
		|	РеализацияСтроительныхРабот.Работа.КодСДР КАК КодРасценки,
		|	РеализацияСтроительныхРабот.Работа.Родитель КАК Этап,
		|	РеализацияСтроительныхРабот.Работа.Представление,
		|	ВЫБОР
		|		КОГДА РеализацияСтроительныхРабот.Работа = РеализацияСтроительныхРабот.Работа.Родитель
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК Порядок,
		|	РеализацияСтроительныхРабот.Работа.НомерРаботыВУровне КАК РаботаНомерРаботыВУровне
		|ИЗ
		|	Документ.УСОERP_РеализацияСтроительныхРаботВнутренняя.Работы КАК РеализацияСтроительныхРабот
		|ГДЕ
		|	РеализацияСтроительныхРабот.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	РеализацияСтроительныхРабот.Работа,
		|	РеализацияСтроительныхРабот.ЕдиницаОбъема,
		|	РеализацияСтроительныхРабот.ОбъемРеализации,
		|	РеализацияСтроительныхРабот.Работа.КодСДР,
		|	РеализацияСтроительныхРабот.Работа.Родитель,
		|	РеализацияСтроительныхРабот.Работа.Представление
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	Этап,
		|	РаботаНомерРаботыВУровне
		|ИТОГИ
		|	СУММА(СуммаСНДС),
		|	СУММА(СуммаНДС),
		|	СУММА(Стоимость),
		|	СУММА(Количество)
		|ПО
		|	Работа ТОЛЬКО ИЕРАРХИЯ";
		
		Запрос.УстановитьПараметр("Ссылка",      ДанныеПечати.Ссылка);
		Запрос.УстановитьПараметр("Организация", ДанныеПечати.Организация);
		Запрос.УстановитьПараметр("Контрагент",  ДанныеПечати.Контрагент);
		Запрос.УстановитьПараметр("Договор",     ДанныеПечати.Договор);
		Запрос.УстановитьПараметр("НПериод", 	 Новый Граница(НачалоГода(ДанныеПечати.Дата), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("КПериод", 	 Новый Граница(КонецДня(ДанныеПечати.Дата), ВидГраницы.Включая));
		
		Дерево = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		
		Руководители = ОтветственныеЛицаБП.ОтветственныеЛица(ДанныеПечати.Организация, ДанныеПечати.Дата);
		
		ОписаниеПодрядчик     = ФормированиеПечатныхФорм.ОписаниеОрганизации(ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ДанныеПечати.ОрганизацияПолучатель, ДанныеПечати.ДатаДокумента), "ПолноеНаименование,ЮридическийАдрес, Телефоны");
		ОписаниеЗаказчик      = ФормированиеПечатныхФорм.ОписаниеОрганизации(ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ДанныеПечати.ОрганизацияПоставщик, ДанныеПечати.ДатаДокумента),  "ПолноеНаименование,ЮридическийАдрес, Телефоны");
		
		ОписаниеСтройка       = ДанныеПечати.ПроектНаименование + ?(ПустаяСтрока(ДанныеПечати.ПроектАдрес), "", ", " + ДанныеПечати.ПроектАдрес); 
		
		ОбъектСтроительства   = ДанныеПечати.Проект;
		
		ОбластьЗаголовок.Параметры.Заказчик	 = ОписаниеЗаказчик;
		ОбластьЗаголовок.Параметры.Подрядчик = ОписаниеПодрядчик;
		ОбластьЗаголовок.Параметры.Инвестор  = "";
		ОбластьЗаголовок.Параметры.Стройка	 = ОписаниеСтройка;
		ОбластьЗаголовок.Параметры.Объект	 = ОбъектСтроительства;		
		ОбластьЗаголовок.Параметры.НомерДоговора = ДанныеПечати.ДоговорНомер;
		ОбластьЗаголовок.Параметры.День  = ?(ДанныеПечати.Договор.Пустая(), "", Формат(ДанныеПечати.ДоговорДата, "ДФ=dd"));
		ОбластьЗаголовок.Параметры.Месяц = ?(ДанныеПечати.Договор.Пустая(), "", Формат(ДанныеПечати.ДоговорДата, "ДФ=MMММ"));
		ОбластьЗаголовок.Параметры.Год   = ?(ДанныеПечати.Договор.Пустая(), "", Формат(ДанныеПечати.ДоговорДата, "ДФ=yy")); 		
		ОбластьЗаголовок.Параметры.ЗКодОКПО = ДанныеПечати.ОрганизацияКодПоОКПО;
		ОбластьЗаголовок.Параметры.ПКодОКПО = ДанныеПечати.КонтрагентКодПоОКПО;		
		ОбластьЗаголовок.Параметры.ДатаНач = Формат(ДанныеПечати.НачалоРабот, "ДФ=dd.MM.yyyy");
		ОбластьЗаголовок.Параметры.ДатаКон = Формат(ДанныеПечати.ОкончаниеРабот, "ДФ=dd.MM.yyyy");		
		ОбластьЗаголовок.Параметры.НомерДок = ДанныеПечати.НомерДокумента;
		ОбластьЗаголовок.Параметры.ДатаДок  = Формат(ДанныеПечати.ДатаДокумента, "ДФ=dd.MM.yyyy");		
		ОбластьЗаголовок.Параметры.Сумма =  ДанныеПечати.СуммаДокумента; 		
		
		ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент, Макет, ОбластьЗаголовок, ДанныеПечати.Ссылка);
		
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		НомерПоПорядку   = 1;
		КолвоПоЛисту	 = 0;
		СтоимостьПоЛисту = 0;
		КолвоПоАкту		 = 0;    	
		СтоимостьПоАкту	 = 0;
		
		ВсегоСтрокНаЛист = 504;
		ВысотаЗаголовок  = 336;
		ВысотаШапка		 = 53;
		ВысотаСтрока	 = 24;
		ВысотаИтогоПоЛисту = 12;
		ВысотаИтогоПоАкту  = 12;
		ВысотаПодвал	   = 132;
		
		СтруктураИтоги = Новый Структура("КолвоПоЛисту, СтоимостьПоЛисту, КолвоПоАкту, СтоимостьПоАкту, СуммаСНДС, СуммаНДС, НомерПоПорядку, ЗанятоСтрок, ВысотаШапка, ВсегоСтрокНаЛист, ВысотаСтрока");
		СтруктураИтоги.КолвоПоЛисту  = 0;
		СтруктураИтоги.СтоимостьПоЛисту  = 0;
		СтруктураИтоги.КолвоПоАкту  = 0;
		СтруктураИтоги.СтоимостьПоАкту  = 0;
		СтруктураИтоги.НомерПоПорядку  = 1;
		СтруктураИтоги.СуммаСНДС  = 0;
		СтруктураИтоги.СуммаНДС  = 0;
		
		СтруктураИтоги.ЗанятоСтрок = ВысотаЗаголовок + ВысотаШапка; 
		СтруктураИтоги.ВысотаШапка = ВысотаШапка;
		СтруктураИтоги.ВысотаСтрока = ВысотаСтрока;
		СтруктураИтоги.ВсегоСтрокНаЛист = ВсегоСтрокНаЛист;
		
		ТабличныйДокумент.НачатьАвтогруппировкуСтрок();
		ВывестиДеревоКС2(ТабличныйДокумент, Дерево, СтруктураИтоги, ОбластьЭтап, ОбластьСтрока);
		ТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();
		
		ОбластьИтогоПоЛисту.Параметры.КолвоПоЛисту	   = СтруктураИтоги.КолвоПоЛисту;
		ОбластьИтогоПоЛисту.Параметры.СтоимостьПоЛисту = СтруктураИтоги.СтоимостьПоЛисту;
		
		ОбластьИтогоПоАкту.Параметры.КолвоВсего	    = СтруктураИтоги.КолвоПоАкту;
		ОбластьИтогоПоАкту.Параметры.СтоимостьВсего = СтруктураИтоги.СтоимостьПоАкту;
		
		ОбластьИтогоПоАкту.Параметры.СуммаНДС  = СтруктураИтоги.СуммаНДС;
		ОбластьИтогоПоАкту.Параметры.СуммаСНДС = СтруктураИтоги.СуммаСНДС;	
		
		ТабличныйДокумент.Вывести(ОбластьИтогоПоАкту);
		
		ОбластьПодвал.Параметры.ФИОПодрядчика       = Руководители.РуководительПредставление;
		ОбластьПодвал.Параметры.ДолжностьПодрядчика = Руководители.РуководительДолжность;		
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();			
	КонецЦикла;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ПолеСверху = 0;
	ТабличныйДокумент.ПолеСлева = 0;
	ТабличныйДокумент.ПолеСправа = 0;
	ТабличныйДокумент.ПолеСнизу = 0;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура ВывестиДеревоКС2(ТабличныйДокумент, Дерево, СтруктураИтоги, ОбластьСтрокаЭтап, ОбластьСтрокаСтрока)
	
	Для каждого стр из Дерево.Строки Цикл
		Если Не ЗначениеЗаполнено(стр.Работа) Тогда 
			ВывестиДеревоКС2(ТабличныйДокумент, стр, СтруктураИтоги, ОбластьСтрокаЭтап, ОбластьСтрокаСтрока);
			Продолжить;
		КонецЕсли;
		
		Если стр.Строки.Количество()>0 Тогда
			ОбластьСтрока	= ОбластьСтрокаЭтап;
		Иначе
			ОбластьСтрока	= ОбластьСтрокаСтрока;
		КонецЕсли;
		ОбластьСтрока.Параметры.Заполнить(стр);
		
		Цена = 0;
		Если Не стр.Количество = 0 Тогда
			Цена = стр.Стоимость / стр.Количество;
		КонецЕсли;
		Если стр.Строки.Количество()=0 Тогда 
			ОбластьСтрока.Параметры.Цена = Цена;
			СтруктураИтоги.КолвоПоЛисту	 = СтруктураИтоги.КолвоПоЛисту + стр.Количество;
			СтруктураИтоги.СтоимостьПоЛисту  = СтруктураИтоги.СтоимостьПоЛисту + стр.Стоимость;
			СтруктураИтоги.КолвоПоАкту		 = СтруктураИтоги.КолвоПоАкту + стр.Количество;    	
			СтруктураИтоги.СтоимостьПоАкту	 = СтруктураИтоги.СтоимостьПоАкту + стр.Стоимость;	
			СтруктураИтоги.СуммаНДС      	 = СтруктураИтоги.СуммаНДС + стр.СуммаНДС;	
			СтруктураИтоги.СуммаСНДС	     = СтруктураИтоги.СуммаСНДС + стр.СуммаСНДС;	
		КонецЕсли;
		ОбластьСтрока.Параметры.НомерПоПорядку	= СтруктураИтоги.НомерПоПорядку;
		СтруктураИтоги.НомерПоПорядку = 1 + СтруктураИтоги.НомерПоПорядку;
		
		Уровень = 1;
		ПолучитьУровеньСтроки(стр,Уровень);
		
		ТабличныйДокумент.Вывести(ОбластьСтрока);
		
		ВывестиДеревоКС2(ТабличныйДокумент, стр, СтруктураИтоги, ОбластьСтрокаЭтап, ОбластьСтрокаСтрока);
		
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьУровеньСтроки(СтрокаДерева,Уровень)
	
	Родитель = СтрокаДерева.Родитель;
	Если Родитель <> Неопределено Тогда
		Уровень = Уровень + 1;
		ПолучитьУровеньСтроки(Родитель, Уровень);
	Иначе
		Возврат Уровень;
	КонецЕсли;
	
КонецФункции

Функция СформироватьПечатнуюФормуКС3(МассивОбъектов, ОбъектыПечати)
	
	Макет         = ПолучитьМакет("КС3");
	Шапка         = Макет.ПолучитьОбласть("Шапка");
	ШапкаТаблицы  = Макет.ПолучитьОбласть("ШапкаТаблицы");
	СтрокаТ       = Макет.ПолучитьОбласть("СтрокаРаботы");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_УСОERP_РеализацияСтроительныхРабот_КС3";
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_РеализацияСтроительныхРабот.Номер КАК НомерДокумента,
	|	УСОERP_РеализацияСтроительныхРабот.Дата КАК ДатаДокумента,
	|	УСОERP_РеализацияСтроительныхРабот.Организация КАК ОрганизацияПолучатель,
	|	УСОERP_РеализацияСтроительныхРабот.Контрагент КАК ОрганизацияПоставщик,
	|	УСОERP_РеализацияСтроительныхРабот.ОбъектСтроительства КАК Проект,
	|	УСОERP_РеализацияСтроительныхРабот.Договор,
	|	УСОERP_РеализацияСтроительныхРабот.Договор.Номер,
	|	УСОERP_РеализацияСтроительныхРабот.СуммаДокумента,
	|	УСОERP_РеализацияСтроительныхРабот.Контрагент КАК Подрядчик,
	|	УСОERP_РеализацияСтроительныхРабот.Дата,
	|	УСОERP_РеализацияСтроительныхРабот.Договор.Дата,
	|	УСОERP_РеализацияСтроительныхРабот.ДатаНачалаПериода КАК НачалоРабот,
	|	УСОERP_РеализацияСтроительныхРабот.ДатаОкончанияПериода КАК ОкончаниеРабот,
	|	УСОERP_РеализацияСтроительныхРабот.Организация.КодПоОКПО,
	|	УСОERP_РеализацияСтроительныхРабот.Контрагент.КодПоОКПО,
	|	УСОERP_РеализацияСтроительныхРабот.Ссылка,
	|	УСОERP_РеализацияСтроительныхРабот.Организация,
	|	УСОERP_РеализацияСтроительныхРабот.Контрагент,
	|	УСОERP_РеализацияСтроительныхРабот.Ответственный
	|ИЗ
	|	Документ.УСОERP_РеализацияСтроительныхРаботВнутренняя КАК УСОERP_РеализацияСтроительныхРабот
	|ГДЕ
	|	УСОERP_РеализацияСтроительныхРабот.Ссылка В(&МассивДокументов)";
	
	Запрос.УстановитьПараметр("МассивДокументов", 				МассивОбъектов);
	
	ДанныеПечати 		= Запрос.Выполнить().Выбрать();		
	
	Пока ДанныеПечати.Следующий() Цикл
		
		СтрокаТаблицы = Макет.ПолучитьОбласть("СтрокаТаблицы1");
		
		Руководители = ОтветственныеЛицаБП.ОтветственныеЛица(ДанныеПечати.Организация, ДанныеПечати.Дата);		
		
		Запрос.УстановитьПараметр("Ссылка",      ДанныеПечати.Ссылка);
		Запрос.УстановитьПараметр("Организация", ДанныеПечати.Организация);
		Запрос.УстановитьПараметр("Контрагент",  ДанныеПечати.Контрагент);
		Запрос.УстановитьПараметр("Договор",     ДанныеПечати.Договор);
		Запрос.УстановитьПараметр("НПериод", 	 Новый Граница(НачалоГода(ДанныеПечати.Дата), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("КПериод", 	 Новый Граница(КонецДня(ДанныеПечати.Дата), ВидГраницы.Включая));
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(РеализацияСтроительныхРабот.СуммаСНДС) КАК СуммаСНДС,
		|	СУММА(РеализацияСтроительныхРабот.СуммаНДС) КАК СуммаНДС,
		|	СУММА(РеализацияСтроительныхРабот.СуммаСНДС - РеализацияСтроительныхРабот.СуммаНДС) КАК СуммаБезНДС,
		|	РеализацияСтроительныхРабот.Работа
		|ПОМЕСТИТЬ Реализация
		|ИЗ
		|	Документ.УСОERP_РеализацияСтроительныхРаботВнутренняя.Работы КАК РеализацияСтроительныхРабот
		|ГДЕ
		|	РеализацияСтроительныхРабот.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	РеализацияСтроительныхРабот.Работа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВыполнениеРаботЗаказчика.СуммаСНДСРасход - ВыполнениеРаботЗаказчика.СуммаНДСРасход) КАК Сумма,
		|	СУММА(ВыполнениеРаботЗаказчика.ОбъемРасход) КАК Количество,
		|	ВыполнениеРаботЗаказчика.Работа
		|ПОМЕСТИТЬ ОборотыГод_Р
		|ИЗ
		|	РегистрНакопления.УСОERP_ВыполнениеРаботЗаказчика.Обороты(
		|			&НПериод,
		|			&КПериод,
		|			Период,
		|			Организация = &Организация
		|				И Контрагент = &Контрагент
		|				И Договор = &Договор
		|				И Работа В
		|					(ВЫБРАТЬ
		|						Реализация.Работа
		|					ИЗ
		|						Реализация КАК Реализация)) КАК ВыполнениеРаботЗаказчика
		|
		|СГРУППИРОВАТЬ ПО
		|	ВыполнениеРаботЗаказчика.Работа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВыполнениеРаботЗаказчика.СуммаСНДСРасход - ВыполнениеРаботЗаказчика.СуммаНДСРасход) КАК Сумма,
		|	СУММА(ВыполнениеРаботЗаказчика.ОбъемРасход) КАК Количество,
		|	ВыполнениеРаботЗаказчика.Работа
		|ПОМЕСТИТЬ ОборотыВесьПер_Р
		|ИЗ
		|	РегистрНакопления.УСОERP_ВыполнениеРаботЗаказчика.Обороты(
		|			,
		|			,
		|			Период,
		|			Организация = &Организация
		|				И Контрагент = &Контрагент
		|				И Договор = &Договор
		|				И Работа В
		|					(ВЫБРАТЬ
		|						Реализация.Работа
		|					ИЗ
		|						Реализация КАК Реализация)) КАК ВыполнениеРаботЗаказчика
		|
		|СГРУППИРОВАТЬ ПО
		|	ВыполнениеРаботЗаказчика.Работа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Реализация.СуммаБезНДС КАК СуммаБезНДС,
		|	ЕСТЬNULL(ОборотыГод_Р.Сумма, 0) КАК СуммаОборотГод,
		|	ЕСТЬNULL(ОборотыВесьПер_Р.Сумма, 0) КАК ОборотыВесьПер,
		|	Реализация.Работа,
		|	Реализация.СуммаНДС КАК СуммаНДС,
		|	Реализация.СуммаСНДС КАК СуммаСНДС
		|ИЗ
		|	Реализация КАК Реализация
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОборотыВесьПер_Р КАК ОборотыВесьПер_Р
		|		ПО Реализация.Работа = ОборотыВесьПер_Р.Работа
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОборотыГод_Р КАК ОборотыГод_Р
		|		ПО Реализация.Работа = ОборотыГод_Р.Работа
		|ИТОГИ
		|	СУММА(СуммаБезНДС),
		|	СУММА(СуммаОборотГод),
		|	СУММА(ОборотыВесьПер),
		|	СУММА(СуммаНДС),
		|	СУММА(СуммаСНДС)
		|ПО
		|	ОБЩИЕ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ Реализация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ОборотыГод_Р
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ОборотыВесьПер_Р";
		
		ВыборкаСуммы = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСуммы.Следующий() Цикл
			
			Подрядчик     = ФормированиеПечатныхФорм.ОписаниеОрганизации(ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ДанныеПечати.ОрганизацияПолучатель, ДанныеПечати.ДатаДокумента), "ПолноеНаименование");
			Заказчик      = ФормированиеПечатныхФорм.ОписаниеОрганизации(ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ДанныеПечати.ОрганизацияПоставщик, ДанныеПечати.ДатаДокумента), "ПолноеНаименование");
			
			СведенияОПодрядчике 			= ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ДанныеПечати.ОрганизацияПолучатель,  ДанныеПечати.Дата);
			СведенияОЗаказчике 				= ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ДанныеПечати.ОрганизацияПоставщик,  ДанныеПечати.Дата);
			
			Шапка.Параметры.АдресПодрядчик 	= СведенияОПодрядчике.ЮридическийАдрес + СведенияОПодрядчике.Телефоны;
			Шапка.Параметры.АдресЗаказчик 	= СведенияОЗаказчике.ЮридическийАдрес  + СведенияОЗаказчике.Телефоны;			
			Шапка.Параметры.Заполнить(ДанныеПечати);
			Шапка.Параметры.Заказчик        			= Заказчик;
			Шапка.Параметры.Подрядчик        			= Подрядчик;			
			Шапка.Параметры.Стройка                 = ДанныеПечати.Проект;
			Шапка.Параметры.ДоговорКонтрагентаНомер = ДанныеПечати.ДоговорНомер;
			Шапка.Параметры.ДатаДоговор             = ДанныеПечати.ДоговорДата;
			
			Если ЗначениеЗаполнено(ДанныеПечати.НачалоРабот) Тогда
				Шапка.Параметры.отчС = ДанныеПечати.НачалоРабот;
			Иначе
				Шапка.Параметры.отчС = НачалоМесяца(ДанныеПечати.дата);
			КонецЕсли;
			Если ЗначениеЗаполнено(ДанныеПечати.ОкончаниеРабот) Тогда
				Шапка.Параметры.отчПо = ДанныеПечати.ОкончаниеРабот;
			Иначе
				Шапка.Параметры.отчПо = КонецМесяца(ДанныеПечати.дата);
			КонецЕсли;
			Шапка.Параметры.ИКодПоОКПО = ДанныеПечати.ОрганизацияКодПоОКПО;
			Шапка.Параметры.ПКодПоОКПО = ДанныеПечати.КонтрагентКодПоОКПО;			
			
			ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент, Макет, Шапка, ДанныеПечати.Ссылка);
			
			ТабличныйДокумент.Вывести(Шапка);
			ТабличныйДокумент.Вывести(ШапкаТаблицы);
			
			СтрокаТаблицы.Параметры.СуммаОборот    = ВыборкаСуммы.ОборотыВесьПер;
			СтрокаТаблицы.Параметры.СуммаОборотГод = ВыборкаСуммы.СуммаОборотГод;
			СтрокаТаблицы.Параметры.Сумма          = ВыборкаСуммы.СуммаБезНДС;
			ТабличныйДокумент.Вывести(СтрокаТаблицы);
			
			Выборка = ВыборкаСуммы.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				СтрокаТ.Параметры.Номенклатура 			= Выборка.Работа;
				СтрокаТ.Параметры.СуммаОборотГод 		= Выборка.СуммаОборотГод;
				СтрокаТ.Параметры.СуммаОборот		 	= Выборка.ОборотыВесьПер;
				СтрокаТ.Параметры.Сумма 				= Выборка.СуммаБезНДС;
				ТабличныйДокумент.Вывести(СтрокаТ);
				
			КонецЦикла;	
			
			СтрокаТаблицы = Макет.ПолучитьОбласть("СтрокаТаблицы2");
			
			СтрокаТаблицы.Параметры.Итого      = ВыборкаСуммы.СуммаБезНДС;
			СтрокаТаблицы.Параметры.СуммаНДС   = ВыборкаСуммы.СуммаНДС;
			СтрокаТаблицы.Параметры.СуммаСНДС  = ВыборкаСуммы.СуммаСНДС;			
			СтрокаТаблицы.Параметры.ФИОПодрядчика       = Руководители.РуководительПредставление;
			СтрокаТаблицы.Параметры.ДолжностьПодрядчика = Руководители.РуководительДолжность;
			
			ТабличныйДокумент.Вывести(СтрокаТаблицы);
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
		КонецЦикла;
		
	КонецЦикла;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ПолеСверху = 0;
	ТабличныйДокумент.ПолеСлева = 1;
	ТабличныйДокумент.ПолеСнизу = 0;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ДоступныеДляШаблоновПечатныеФормы() Экспорт
	
	МассивДоступныхПечатныхФорм = Новый Массив;
	МассивДоступныхПечатныхФорм.Добавить(Новый Структура("Имя,Представление,МенеджерПечати,ПараметрыПечати,ИмяПечатнойФормыСУчетомПараметров","КС2", НСтр("ru = 'КС-2'"), "Документ.УСОERP_РеализацияСтроительныхРаботВнутренняя", Неопределено,Неопределено));									 
	МассивДоступныхПечатныхФорм.Добавить(Новый Структура("Имя,Представление,МенеджерПечати,ПараметрыПечати,ИмяПечатнойФормыСУчетомПараметров","КС3", НСтр("ru = 'КС-3'"), "Документ.УСОERP_РеализацияСтроительныхРаботВнутренняя", Неопределено,Неопределено));
	
	Возврат МассивДоступныхПечатныхФорм;
	
КонецФункции

Функция ТекстЗапросаТаблицаВыполнениеПринятие()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&Организация КАК Организация,
	|	&ОбъектСтроительства КАК ОбъектСтроительства,
	|	ТаблицаРаботы.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР КОГДА ТаблицаРаботы.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка) ТОГДА ТаблицаРаботы.Работа ИНАЧЕ ТаблицаРаботы.Работа.РаботаИсточник КОНЕЦ КАК Работа,
	|	ТаблицаРаботы.Объем КАК Объем,
	|	ТаблицаРаботы.СуммаСНДС КАК Стоимость,
	|	ТаблицаРаботы.ЕдиницаОбъема КАК ЕдиницаОбъема
	|ИЗ
	|	ВтТаблицаРаботы КАК ТаблицаРаботы
	|ГДЕ
	|	ТаблицаРаботы.Объем <> 0   И &Утвержден
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

