	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТабРабот",ТабРабот);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТабРабот.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	ТабРабот.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТабРабот.Подразделение КАК Подразделение,
	|	ТабРабот.Контрагент КАК Контрагент,
	|	ТабРабот.НачалоПериода КАК НачалоПериода,
	|	ТабРабот.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ТабРабот.ОбъемСобственный КАК ОбъемСобственный,
	|	ТабРабот.ОбъемСубподряда КАК ОбъемСубподряда,
	|	ТабРабот.СуммарнаяРабота КАК СуммарнаяРабота,
	|	ТабРабот.ЦенаЗаказчика КАК ЦенаЗаказчика,
	|	ТабРабот.ЦенаПодрядчикаКоэффициент КАК ЦенаПодрядчикаКоэффициент,
	|	ТабРабот.ЦенаПодрядчикаЦена КАК ЦенаПодрядчикаЦена,
	|	ТабРабот.ЦенаПодрядчикаРазность КАК ЦенаПодрядчикаРазность
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	&ТабРабот КАК ТабРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.Работа КАК Работа,
	|	ВрТаб.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ВрТаб.Подразделение КАК Подразделение,
	|	ВрТаб.Контрагент КАК Контрагент,
	|	ВрТаб.НачалоПериода КАК НачалоПериода,
	|	ВрТаб.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ВрТаб.ОбъемСобственный КАК ОбъемСобственный,
	|	ВрТаб.ОбъемСубподряда КАК ОбъемСубподряда,
	|	ВрТаб.СуммарнаяРабота КАК СуммарнаяРабота,
	|	ВЫБОР
	|		КОГДА ВрТаб.Работа.СуммарнаяРабота
	|			ТОГДА 0
	|		ИНАЧЕ ВрТаб.ЦенаЗаказчика
	|	КОНЕЦ КАК ЦенаЗаказчика,
	|	ВЫБОР
	|		КОГДА ВрТаб.Работа.СуммарнаяРабота
	|			ТОГДА 0
	|		ИНАЧЕ ВрТаб.ЦенаПодрядчикаКоэффициент
	|	КОНЕЦ КАК ЦенаПодрядчикаКоэффициент,
	|	ВЫБОР
	|		КОГДА ВрТаб.Работа.СуммарнаяРабота
	|			ТОГДА 0
	|		ИНАЧЕ ВрТаб.ЦенаПодрядчикаЦена
	|	КОНЕЦ КАК ЦенаПодрядчикаЦена,
	|	ВЫБОР
	|		КОГДА ВрТаб.Работа.СуммарнаяРабота
	|			ТОГДА 0
	|		ИНАЧЕ ВрТаб.ЦенаПодрядчикаРазность
	|	КОНЕЦ КАК ЦенаПодрядчикаРазность
	|ИЗ
	|	ВрТаб КАК ВрТаб";
	
	ТабРабот = Запрос.Выполнить().Выгрузить();
	
	Объект.Работы.Загрузить(ТабРабот);
	
	
КонецПроцедуры

