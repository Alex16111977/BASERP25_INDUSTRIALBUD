	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоРесурсыПоИсполнителям.Имя); 	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоРесурсыПоИсполнителям.УровеньСтроки");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборЭлемента.ПравоеЗначение = 2;   	
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(WindowsШрифты.ШрифтДиалоговИМеню,,,Истина));
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаГруппировкиОтчета2); 	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",Истина);

	
КонецПроцедуры

