&НаСервере
Процедура ВывестиДеревоРаботы(СтрокаЗапроса,СтрокаДерева)
	
	ЗаполнитьЗначенияСвойств(СтрокаДерева,СтрокаЗапроса); 
	
	Для Каждого ПодСтрока ИЗ СтрокаЗапроса.Строки Цикл
		
		Если ПодСтрока.Работа = СтрокаЗапроса.Работа Тогда
			Продолжить;
		КонецЕсли;		
		
		ВывестиДеревоРаботы(ПодСтрока,СтрокаДерева.Строки.Добавить());
		
	КонецЦикла;
	
КонецПроцедуры   

