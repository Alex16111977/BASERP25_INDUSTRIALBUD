&НаКлиенте
Перем ОтветПередЗаписью;

#Область Прочее

&НаСервере
Процедура ЗаполнитьТаблицуДаннымиДерева(Таблица, СтрокиДерева, ИмяКолонкиГруппировки, СписокГруппировок, СтруктураЗначенийГруппировки = Неопределено, Уровень = 1)
	
	Если СтруктураЗначенийГруппировки = Неопределено Тогда
		СтруктураЗначенийГруппировки = Новый Структура;
	КонецЕсли;
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		ИмяКлючаГруппировки = "Группировка" + Уровень;
		СтруктураЗначенийГруппировки.Вставить(ИмяКлючаГруппировки, СтрокаДерева[ИмяКолонкиГруппировки]);
		
		Если СписокГруппировок.Количество() > Уровень Тогда // рекурсия!
			
			Если ТипЗнч(СтрокаДерева[ИмяКолонкиГруппировки]) = Тип("СправочникСсылка.УСОERP_СтроительныеРаботы") Тогда
			    ЗаполнитьТаблицуДаннымиДерева(Таблица, СтрокаДерева.Строки, ИмяКолонкиГруппировки, СписокГруппировок, СтруктураЗначенийГруппировки, Уровень);
			Иначе
				ЗаполнитьТаблицуДаннымиДерева(Таблица, СтрокаДерева.Строки, ИмяКолонкиГруппировки, СписокГруппировок, СтруктураЗначенийГруппировки, Уровень +  1);
			КонецЕсли;
			
		Иначе // добавляем строку в таблицу по последней группировке
			
			СтрокаТаблицы = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаДерева);
			Для Каждого ЭлемментСпискаГруппировок Из СписокГруппировок Цикл
				Колонка = ЭлемментСпискаГруппировок.Значение;
				Если Колонка.ГруппироватьВОднойКолонке Тогда
					УровеньГруппировки = СписокГруппировок.Индекс(ЭлемментСпискаГруппировок) + 1;
					СтрокаТаблицы[Колонка.Имя] = СтруктураЗначенийГруппировки["Группировка" + УровеньГруппировки];
					//ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаТаблицы[Колонка.Имя]); // заполним подчиненный реквизиты, например, ВидНоменклатуры
				КонецЕсли;
			КонецЦикла;
			
			СтрокаТаблицы.ИндексСтрокиДерева = СтрокиДерева.Индекс(СтрокаДерева);
			
			Если СтрокаДерева.Строки.Количество() Тогда // рекурсия!
				ЗаполнитьТаблицуДаннымиДерева(Таблица, СтрокаДерева.Строки, ИмяКолонкиГруппировки, СписокГруппировок, СтруктураЗначенийГруппировки, Уровень);
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЦикла;
			
КонецПроцедуры

&НаСервере
Процедура СортироватьДеревоПоКодуСДРЧисло(Дерево, ИмяКолонкиГруппировки, СписокГруппировок)
	
	// Добавим в дерево и заполним числовое представление кода СДР.
	Если ТипЗнч(Дерево) = Тип("ДеревоЗначений") 
		И Дерево.Колонки.Найти("КодСДРЧисло") = Неопределено Тогда
		Дерево.Колонки.Добавить("КодСДРЧисло", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		
		Если СтрокаДерева.Строки.Количество() Тогда // рекурсия!
			СортироватьДеревоПоКодуСДРЧисло(СтрокаДерева, ИмяКолонкиГруппировки, СписокГруппировок);
		КонецЕсли;
		
		Если ТипЗнч(СтрокаДерева[ИмяКолонкиГруппировки]) = Тип("СправочникСсылка.УСОERP_СтроительныеРаботы") Тогда
			
			ВременнаяСтрокаКодСДР = СтрокаДерева[ИмяКолонкиГруппировки].КодСДР;
			
			ЧисловойЛитерал = "";
			ЕстьТочка = Ложь;
			Пока СтрДлина(ВременнаяСтрокаКодСДР) > 0 Цикл
				
				СимволКодаСДР = Лев(ВременнаяСтрокаКодСДР, 1);
				Если СимволКодаСДР <> "." Тогда
					Попытка
						Цифра = Число(СимволКодаСДР);
					Исключение
						Цифра = КодСимвола(СимволКодаСДР);
					КонецПопытки;
					ЧисловойЛитерал = ЧисловойЛитерал + Цифра;
				ИначеЕсли НЕ ЕстьТочка Тогда 
					ЧисловойЛитерал = ЧисловойЛитерал + ".";
					ЕстьТочка = Истина;
				КонецЕсли;
				
				ВременнаяСтрокаКодСДР = Прав(ВременнаяСтрокаКодСДР, СтрДлина(ВременнаяСтрокаКодСДР) - 1);
				
			КонецЦикла;
			
			СтрокаДерева.КодСДРЧисло = Число(?(ЧисловойЛитерал = "", 0, ЧисловойЛитерал));
			
		КонецЕсли;
			
	КонецЦикла;
	
	// Отсортируем дерево.
	Если ТипЗнч(Дерево) = Тип("ДеревоЗначений") Тогда
		
		// Сформируем строку сортировки.
		СтрокаСортировки = "";
		Для Каждого ЭлементСписка Из СписокГруппировок Цикл
			Колонка = ЭлементСписка.Значение;
			Если Колонка.Имя = "Работа" Тогда
				СтрокаСортировки = СтрокаСортировки + ?(НЕ ПустаяСтрока(СтрокаСортировки), ", ", "") + "КодСДРЧисло";
			ИначеЕсли Дерево.Колонки.Найти(Колонка.Имя) <> Неопределено Тогда 
				СтрокаСортировки = СтрокаСортировки + ?(НЕ ПустаяСтрока(СтрокаСортировки), ", ", "") + Колонка.Имя;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(СтрокаСортировки) Тогда
			Дерево.Строки.Сортировать(СтрокаСортировки, Истина);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуПоДереву(ИмяДереваЗначений, ИмяКолонкиГруппировки, СписокГруппировок, ЗаполнятьДанные = Истина) Экспорт
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("ИндексСтрокиДерева", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)));
	
	ДеревоЗначение = РеквизитФормыВЗначение(ИмяДереваЗначений);
	
	//Создадим колоки, по которым дерево группируется.
	Для Каждого ЭлемментСпискаГруппировок Из СписокГруппировок Цикл
		Колонка = ЭлемментСпискаГруппировок.Значение;
		ТаблицаРезультат.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);//, Колонка.Заголовок, Колонка.Ширина);
	КонецЦикла;
		
	// Скопируем структуру остальных колонок дерева.
	КоллекцияКолонок = ДеревоЗначение.Колонки;
	Для Каждого Колонка Из КоллекцияКолонок Цикл
		Если ТаблицаРезультат.Колонки.Найти(Колонка.Имя) = Неопределено 
			И НЕ Колонка.Имя = ИмяКолонкиГруппировки Тогда
			ТаблицаРезультат.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения, Колонка.Заголовок, Колонка.Ширина);
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЗаполнятьДанные Тогда
		Возврат ТаблицаРезультат;
	КонецЕсли;
	
	// Заполним таблицу данными дерева.
	ЗаполнитьТаблицуДаннымиДерева(ТаблицаРезультат, ДеревоЗначение.Строки, ИмяКолонкиГруппировки, СписокГруппировок);
	
	Возврат ТаблицаРезультат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДеревоФормы(СтрокаДереваДанных, СтрокаДереваФормы, ИмяКолонкиГруппировки, СписокГруппировок, Уровень = 1)
	
	Колонка = СписокГруппировок[Уровень - 1].Значение;
	
	Для Каждого СтрокаДерева Из СтрокаДереваДанных.Строки Цикл
		
		Если Колонка.Имя = "Работа" Тогда
			
			Родитель = СтрокаДерева.Работа.Родитель;
			Если Не ЗначениеЗаполнено(Родитель) Тогда 
				НоваяСтрокаДереваФормы		= СтрокаДереваФормы.Строки.Добавить();
			Иначе	
				НайденнаяСтрока = СтрокаДереваФормы.Строки.Найти(Родитель, ИмяКолонкиГруппировки, Истина);	
				Если НайденнаяСтрока = Неопределено Тогда
					НоваяСтрокаДереваФормы		= СтрокаДереваФормы.Строки.Добавить();  				
				Иначе
					НоваяСтрокаДереваФормы		= НайденнаяСтрока.Строки.Добавить();
				КонецЕсли;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДереваФормы, СтрокаДерева);
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДереваФормы, СтрокаДерева[Колонка.Имя]); // заполнение реквизитов группировки типа КодСДР, ВидНоменклатуры
			
			НоваяСтрокаДереваФормы[ИмяКолонкиГруппировки] = СтрокаДерева[Колонка.Имя];
			
			НоваяСтрокаДереваФормы.Уровень = НоваяСтрокаДереваФормы.Уровень();

		КонецЕсли;
		
		Если СтрокаДерева.Строки.Количество() Тогда // рекурсия!
			
			НоваяСтрокаДереваФормы = СтрокаДереваФормы.Строки.Добавить();
			
			ЗаполнитьДеревоФормы(СтрокаДерева, НоваяСтрокаДереваФормы, ИмяКолонкиГруппировки, СписокГруппировок, Уровень + 1);
			
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДереваФормы, СтрокаДерева);
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДереваФормы, СтрокаДерева[Колонка.Имя]); // заполнение реквизитов группировки типа КодСДР, ВидНоменклатуры
			
			НоваяСтрокаДереваФормы[ИмяКолонкиГруппировки] = СтрокаДерева[Колонка.Имя];
			
			НоваяСтрокаДереваФормы.Уровень = НоваяСтрокаДереваФормы.Уровень();
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПостроитьДеревоПоТаблице(Знач Таблица, ИмяДереваЗначений, ИмяКолонкиГруппировки, СписокГруппировок) Экспорт
	
	Если Таблица = Неопределено Тогда
		Таблица = ПолучитьТаблицуПоДереву(ИмяДереваЗначений, ИмяКолонкиГруппировки, СписокГруппировок);
	КонецЕсли;
	
	ТекстЗапроса = "";
	ТекстЗапросаВЫБРАТЬ = "ВЫБРАТЬ РАЗРЕШЕННЫЕ";
	Сч = 0;
	Пока Сч < Таблица.Колонки.Количество() Цикл
		Колонка = Таблица.Колонки[Сч];
		ТекстЗапросаВЫБРАТЬ = ТекстЗапросаВЫБРАТЬ + ?(Сч <> 0, ",", "") + "
		|	ВременнаяТаблица." + Колонка.Имя;
		Сч = Сч + 1;
	КонецЦикла;
	ТекстЗапроса = ТекстЗапросаВЫБРАТЬ + "
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ
	|	&Таблица КАК ВременнаяТаблица
	|;
	|
	|" + ТекстЗапросаВЫБРАТЬ + "
	|ИЗ
	|	ВременнаяТаблица КАК ВременнаяТаблица";
	Сч = 0;
	Пока Сч < СписокГруппировок.Количество() Цикл
		Колонка = СписокГруппировок[Сч].Значение;
		ТекстЗапроса = ТекстЗапроса + ?(Сч = 0, "
		|
		|УПОРЯДОЧИТЬ ПО", ",") + "
		|	ВременнаяТаблица." + ?(Колонка.Имя = "Работа", "Работа.НомерРаботыВУровне ИЕРАРХИЯ", Колонка.Имя);
		Сч = Сч + 1;
	КонецЦикла;
	

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Таблица", Таблица);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(Таблица);//передаем ТЗ
	ПостроительЗапроса.ДобавлениеПредставлений = ТипДобавленияПредставлений.НеДобавлять;
	Сч = 0;
	Пока Сч < СписокГруппировок.Количество()- 1 Цикл // последняя группировка - детали
		Колонка = СписокГруппировок[Сч].Значение;
		ПостроительЗапроса.ИсточникДанных.Колонки[Колонка.Имя].Измерение = Истина;//по этой колонке идет группировка
		Сч = Сч + 1;
	КонецЦикла;
	ПостроительЗапроса.ЗаполнитьНастройки();
	ПостроительЗапроса.Выполнить();
	ДеревоРезультат = ПостроительЗапроса.Результат.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ИмяКолонкиГруппировки = "Работа" Тогда
		Таблица = ПостроительЗапроса.Результат.Выгрузить();
		ДанныеДляДерева = Новый ТаблицаЗначений;
		ДанныеДляДерева.Колонки.Добавить("Работа",             Новый ОписаниеТипов("СправочникСсылка.УСОERP_СтроительныеРаботы"));		
		ДанныеДляДерева.Колонки.Добавить("РаботаРодитель",     Новый ОписаниеТипов("СправочникСсылка.УСОERP_СтроительныеРаботы"));		
		ДанныеДляДерева.Колонки.Добавить("КодСДР",             Новый ОписаниеТипов("Строка"));		
		ДанныеДляДерева.Колонки.Добавить("НомерРаботыВУровне", Новый ОписаниеТипов("Число"));		
		
		Для каждого Колонка Из Таблица.Колонки Цикл
			Если ДанныеДляДерева.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
				ДанныеДляДерева.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
			КонецЕсли; 
		КонецЦикла; 		
		
		Для каждого Колонка Из ДеревоРезультат.Колонки Цикл
			Если ДанныеДляДерева.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
				ДанныеДляДерева.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
			КонецЕсли; 
		КонецЦикла; 		
		
		
		Для каждого Строка Из Таблица Цикл
			НоваяСтрока = ДанныеДляДерева.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);;
			НоваяСтрока.Работа                            = Строка.Работа;
			НоваяСтрока.РаботаРодитель                    = Строка.Работа.Родитель;
			НоваяСтрока.КодСДР                            = Строка.Работа.КодСДР ;
			НоваяСтрока.НомерРаботыВУровне                = Строка.Работа.НомерРаботыВУровне;
		КонецЦикла;
		
		Справочник = Справочники.УСОERP_СтроительныеРаботы;
		ДеревоРезультат = УСОERP_ОбработкаТабличныхЧастей.УСОERP_ПодготовитьДанныеИСформироватьДеревоСВосстановлениемСтруктуры(ДанныеДляДерева,"Работа","РаботаРодитель",,Справочник);
		
		ВремРодноеДерево = РеквизитФормыВЗначение(ИмяДереваЗначений); // берется родная структура с родной типизацией
		ВремРодноеДерево.Строки.Очистить();
		УСОERP_ОбработкаТабличныхЧастей.УСОERP_ЗаполнитьРоднуюСтруктуруДереваИзВнешнего(ВремРодноеДерево.Строки, ДеревоРезультат.Строки); // и рекурсивно заполняется из дерева, где, возможн, типиация создаст проблемы
		ЗначениеВРеквизитФормы( ВремРодноеДерево, ИмяДереваЗначений);

	ИначеЕсли ИмяКолонкиГруппировки = "ВидНоменклатурыНоменклатураРабота" Тогда
		ДанныеДляДерева = Новый ТаблицаЗначений;
		Таблица = ПостроительЗапроса.Результат.Выгрузить();
		
		ТипыЗначений = Новый Массив; 
        ТипыЗначений.Добавить(Тип("СправочникСсылка.ВидыНоменклатуры")); 
        ТипыЗначений.Добавить(Тип("СправочникСсылка.Номенклатура")); 
        ТипыЗначений.Добавить(Тип("СправочникСсылка.УСОERP_СтроительныеРаботы")); 
		
		ДанныеДляДерева.Колонки.Добавить("ВидНоменклатурыНоменклатураРабота", Новый ОписаниеТипов(ТипыЗначений));		
		ДанныеДляДерева.Колонки.Добавить("Работа",             Новый ОписаниеТипов(ТипыЗначений));		
		ДанныеДляДерева.Колонки.Добавить("РаботаРодитель",     Новый ОписаниеТипов(ТипыЗначений));		
		ДанныеДляДерева.Колонки.Добавить("КодСДР",             Новый ОписаниеТипов("Строка"));		
		ДанныеДляДерева.Колонки.Добавить("НомерРаботыВУровне", Новый ОписаниеТипов("Число"));		
		ДанныеДляДерева.Колонки.Добавить("КодСДРЧисло",        Новый ОписаниеТипов("Число"));		
		
		Для каждого Колонка Из Таблица.Колонки Цикл
			Если ДанныеДляДерева.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
				ДанныеДляДерева.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
			КонецЕсли; 
		КонецЦикла; 		
		
		Для каждого Строка Из Таблица Цикл
			Если ЗначениеЗаполнено(Строка.ВидНоменклатуры) И НЕ ЗначениеЗаполнено(Строка.Номенклатура) И НЕ ЗначениеЗаполнено(Строка.Работа) Тогда
				НоваяСтрока = ДанныеДляДерева.Добавить();	
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);;
				НоваяСтрока.ВидНоменклатурыНоменклатураРабота = Строка.ВидНоменклатуры;
				НоваяСтрока.Работа                            = Строка.ВидНоменклатуры;
				НоваяСтрока.РаботаРодитель                    = Справочники.УСОERP_СтроительныеРаботы.ПустаяСсылка();
				НоваяСтрока.КодСДР                            = "";
				НоваяСтрока.НомерРаботыВУровне                = 0;
				НоваяСтрока.КодСДРЧисло                       = 0;
			ИначеЕсли ЗначениеЗаполнено(Строка.ВидНоменклатуры) И ЗначениеЗаполнено(Строка.Номенклатура) И НЕ ЗначениеЗаполнено(Строка.Работа) Тогда
				НоваяСтрока = ДанныеДляДерева.Добавить();	
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);;
				НоваяСтрока.ВидНоменклатурыНоменклатураРабота = Строка.Номенклатура;
				НоваяСтрока.Работа                            = Строка.Номенклатура;
				НоваяСтрока.РаботаРодитель                    = Строка.ВидНоменклатуры;
				НоваяСтрока.КодСДР                            = "";
				НоваяСтрока.НомерРаботыВУровне                = 0;
				НоваяСтрока.КодСДРЧисло                       = 0;
			ИначеЕсли ЗначениеЗаполнено(Строка.ВидНоменклатуры) И ЗначениеЗаполнено(Строка.Номенклатура) И ЗначениеЗаполнено(Строка.Работа) Тогда
				НоваяСтрока = ДанныеДляДерева.Добавить();	
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);;
				НоваяСтрока.ВидНоменклатурыНоменклатураРабота = Строка.Работа;
				НоваяСтрока.Работа                            = Строка.Работа;
				НоваяСтрока.РаботаРодитель                    = Строка.Номенклатура;
				НоваяСтрока.КодСДР                            = Строка.Работа.КодСДР;
				НоваяСтрока.НомерРаботыВУровне                = Строка.Работа.НомерРаботыВУровне;
			КонецЕсли; 
		КонецЦикла; 
		
		//Если вид номенклатуры лежит в папке, выводит лишние строки верхнего уровня (по числу вложенности)
		//Заремарено, добавлено ручное формирование дерева.
		
		//Справочник = Справочники.ВидыНоменклатуры;
		//ДеревоРезультат = УСОERP_ОбработкаТабличныхЧастей.УСОERP_ПодготовитьДанныеИСформироватьДерево(ДанныеДляДерева,"Работа","РаботаРодитель", Справочник);
		//
		//ЗаполнитьДатыНаУзлах(ДеревоРезультат.Строки);

		ВремРодноеДерево = РеквизитФормыВЗначение(ИмяДереваЗначений); // берется родная структура с родной типизацией
		//ВремРодноеДерево.Строки.Очистить();
		//
		//УСОERP_ОбработкаТабличныхЧастей.УСОERP_ЗаполнитьРоднуюСтруктуруДереваИзВнешнего(ВремРодноеДерево.Строки, ДеревоРезультат.Строки); // и рекурсивно заполняется из дерева, где, возможн, типиация создаст проблемы

		
		//Новый вариант 		
		ТЗ = ДанныеДляДерева.Скопировать();
		ТЗ.Свернуть("ВидНоменклатуры");
		ВремРодноеДерево.Строки.Очистить(); 
		
		Для Каждого СтрокаТЗ ИЗ ТЗ Цикл
			
			СтрокаВидНоменклатуры = ВремРодноеДерево.Строки.Добавить();
			СтрокаВидНоменклатуры.ВидНоменклатурыНоменклатураРабота = СтрокаТЗ.ВидНоменклатуры;
			
			ТабНоменклатуры = ДанныеДляДерева.Скопировать(Новый Структура("ВидНоменклатуры",СтрокаТЗ.ВидНоменклатуры));
			
			ТабНоменклатуры.Свернуть("Номенклатура");
			
			ПустыеСтроки = ТабНоменклатуры.НайтиСтроки(Новый Структура("Номенклатура",null));
			
			Для Каждого ПустаяСтрока ИЗ ПустыеСтроки Цикл
				ТабНоменклатуры.Удалить(ПустаяСтрока);
			КонецЦикла;
			
			Для Каждого СтрокаНом ИЗ ТабНоменклатуры Цикл
				
				Если НЕ ЗначениеЗаполнено(СтрокаНом.Номенклатура) Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаНоменклатура = СтрокаВидНоменклатуры.Строки.Добавить();
				СтрокаНоменклатура.ВидНоменклатурыНоменклатураРабота = СтрокаНом.Номенклатура;
				
				ТабРабот = ДанныеДляДерева.Скопировать(Новый Структура("ВидНоменклатуры,Номенклатура",СтрокаТЗ.ВидНоменклатуры,СтрокаНом.Номенклатура));
				ТабРабот.Сортировать("КодСДР");
				Для Каждого СтрокаРаб ИЗ ТабРабот Цикл
					
					Если ТипЗнч(СтрокаРаб.Работа) <> Тип("СправочникСсылка.УСОERP_СтроительныеРаботы") Тогда
						Продолжить;
					КонецЕсли;					
					
					СтрокаРабота = СтрокаНоменклатура.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРабота,СтрокаРаб);
					СтрокаРабота.ВидНоменклатурыНоменклатураРабота = СтрокаРаб.Работа;
					
				КонецЦикла; 				
				
			КонецЦикла;  			
			
		КонецЦикла;
		
		Для Каждого СтрокаДерева ИЗ  ВремРодноеДерево.Строки Цикл
			
			СтрокаДерева.КоличествоОбщее = 0;
			СтрокаДерева.КоличествоСобственное = 0;
			СтрокаДерева.КоличествоСубподряда = 0;
			
			Для Каждого ПодСтрока ИЗ СтрокаДерева.Строки Цикл
				
				ПодСтрока.КоличествоОбщее = 0;
				ПодСтрока.КоличествоСобственное = 0;
				ПодСтрока.КоличествоСубподряда = 0; 
				
				Для Каждого СтрокаНоменклатуры ИЗ ПодСтрока.Строки Цикл
					
					Если ПодСтрока.НачалоПериода = Дата(1,1,1) Тогда
						ПодСтрока.НачалоПериода = СтрокаНоменклатуры.НачалоПериода;
					КонецЕсли;
					
					Если ПодСтрока.ОкончаниеПериода = Дата(1,1,1) Тогда
						ПодСтрока.ОкончаниеПериода = СтрокаНоменклатуры.ОкончаниеПериода;
					КонецЕсли;
					
					ПодСтрока.НачалоПериода = Мин(ПодСТрока.НачалоПериода,СтрокаНоменклатуры.НачалоПериода);
					ПодСтрока.ОкончаниеПериода = Макс(ПодСтрока.ОкончаниеПериода,СтрокаНоменклатуры.ОкончаниеПериода);
					
					СтрокаНоменклатуры.Уровень = 2;
					
					ПодСтрока.КоличествоОбщее = СтрокаНоменклатуры.КоличествоОбщее+ПодСтрока.КоличествоОбщее;
					ПодСтрока.КоличествоСобственное = ПодСтрока.КоличествоСобственное +СтрокаНоменклатуры.КоличествоСобственное;
					ПодСтрока.КоличествоСубподряда = ПодСтрока.КоличествоСубподряда+СтрокаНоменклатуры.КоличествоСубподряда;
					
				КонецЦикла;
				
				Если СтрокаДерева.НачалоПериода = Дата(1,1,1) Тогда
					СтрокаДерева.НачалоПериода = ПодСтрока.НачалоПериода;
				Иначе
					СтрокаДерева.НачалоПериода = Мин(СтрокаДерева.НачалоПериода,ПодСтрока.НачалоПериода);
				КонецЕсли;
				
				Если СтрокаДерева.ОкончаниеПериода = Дата(1,1,1) Тогда
					СтрокаДерева.ОкончаниеПериода = ПодСтрока.ОкончаниеПериода;
				Иначе
					СтрокаДерева.ОкончаниеПериода = Макс(ПодСтрока.ОкончаниеПериода,СтрокаДерева.ОкончаниеПериода);
				КонецЕсли; 				
				
				СтрокаДерева.КоличествоОбщее = СтрокаДерева.КоличествоОбщее+ПодСтрока.КоличествоОбщее;
				СтрокаДерева.КоличествоСобственное = СтрокаДерева.КоличествоСобственное +ПодСтрока.КоличествоСобственное;
				СтрокаДерева.КоличествоСубподряда = СтрокаДерева.КоличествоСубподряда+ПодСтрока.КоличествоСубподряда;
				
			КонецЦикла;	
			
		КонецЦикла;		
			
		ЗначениеВРеквизитФормы( ВремРодноеДерево, ИмяДереваЗначений);
		
	Иначе
		
		ДанныеДляДерева = Новый ТаблицаЗначений;
		Таблица = ПостроительЗапроса.Результат.Выгрузить();
		
		ТипыЗначений = Новый Массив; 
        ТипыЗначений.Добавить(Тип("СправочникСсылка.УСОERP_Ресурсы")); 
        ТипыЗначений.Добавить(Тип("СправочникСсылка.УСОERP_СтроительныеРаботы")); 
		
		ДанныеДляДерева.Колонки.Добавить("РесурсРабота", Новый ОписаниеТипов(ТипыЗначений));		
		ДанныеДляДерева.Колонки.Добавить("Работа",             Новый ОписаниеТипов(ТипыЗначений));		
		ДанныеДляДерева.Колонки.Добавить("РаботаРодитель",     Новый ОписаниеТипов(ТипыЗначений));		
		ДанныеДляДерева.Колонки.Добавить("КодСДР",             Новый ОписаниеТипов("Строка"));		
		ДанныеДляДерева.Колонки.Добавить("НомерРаботыВУровне", Новый ОписаниеТипов("Число"));		
		ДанныеДляДерева.Колонки.Добавить("КодСДРЧисло",        Новый ОписаниеТипов("Число"));		
		
		Для каждого Колонка Из Таблица.Колонки Цикл
			Если ДанныеДляДерева.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
				ДанныеДляДерева.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
			КонецЕсли; 
		КонецЦикла; 		
		
		Для каждого Строка Из Таблица Цикл
			
			Если ЗначениеЗаполнено(Строка.Ресурс)  И НЕ ЗначениеЗаполнено(Строка.Работа) Тогда
				
				НоваяСтрока = ДанныеДляДерева.Добавить();	
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);;
				НоваяСтрока.РесурсРабота                      = Строка.Ресурс;
				НоваяСтрока.Работа                            = Строка.Ресурс;
				НоваяСтрока.РаботаРодитель                    = Справочники.УСОERP_СтроительныеРаботы.ПустаяСсылка();
				НоваяСтрока.КодСДР                            = "";
				НоваяСтрока.НомерРаботыВУровне                = 0;
				НоваяСтрока.КодСДРЧисло                       = 0;
				
				
			ИначеЕсли ЗначениеЗаполнено(Строка.Ресурс)  И  ЗначениеЗаполнено(Строка.Работа) Тогда
				
				НоваяСтрока = ДанныеДляДерева.Добавить();	
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);;
				НоваяСтрока.РесурсРабота                      = Строка.Работа;
				НоваяСтрока.Работа                            = Строка.Работа;
				НоваяСтрока.РаботаРодитель                    = Строка.Ресурс;
				НоваяСтрока.КодСДР                            = Строка.Работа.КодСДР;
				НоваяСтрока.НомерРаботыВУровне                = Строка.Работа.НомерРаботыВУровне;
				НоваяСтрока.Уровень = 1;
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		Справочник = Справочники.УСОERP_Ресурсы;
		ДеревоРезультат = УСОERP_ОбработкаТабличныхЧастей.УСОERP_ПодготовитьДанныеИСформироватьДерево(ДанныеДляДерева,"Работа","РаботаРодитель",Справочник);
		
		ВремРодноеДерево = РеквизитФормыВЗначение(ИмяДереваЗначений); // берется родная структура с родной типизацией
		ВремРодноеДерево.Строки.Очистить();
		УСОERP_ОбработкаТабличныхЧастей.УСОERP_ЗаполнитьРоднуюСтруктуруДереваИзВнешнего(ВремРодноеДерево.Строки, ДеревоРезультат.Строки); // и рекурсивно заполняется из дерева, где, возможн, типиация создаст проблемы
		
		Если ИмяДереваЗначений = "ДеревоРесурсы" Тогда			
			
			ВремРодноеДерево.Строки.Сортировать("КодСДР,РесурсРабота",Истина);
			
		КонецЕсли; 		
		
		ЗначениеВРеквизитФормы( ВремРодноеДерево, ИмяДереваЗначений);
		
	КонецЕсли;  

КонецПроцедуры

&НаСервере
Функция ЗаполнитьДатыНаУзлах(ДеревоСтроки)	
	
	Для Каждого Строка Из ДеревоСтроки Цикл
		
		Если Строка.Строки.Количество()> 0 Тогда
			
			СтруктураДат= ВыбратьДаты(Строка.Строки);
			Строка.НачалоПериода    = СтруктураДат.НачалоПериода;
			Строка.ОкончаниеПериода = СтруктураДат.ОкончаниеПериода;
			ЗаполнитьДатыНаУзлах(Строка.Строки)
			
		КонецЕсли;
		
	КонецЦикла;	

КонецФункции

&НаСервере
Функция ВыбратьДаты(Строки)
	
	СтруктураДат = Новый Структура("НачалоПериода, ОкончаниеПериода", ТекущаяДата(), ТекущаяДата());
	
	Для Каждого Строка Из Строки Цикл
		Если ЗначениеЗаполнено(Строка.НачалоПериода) и Строка.НачалоПериода < СтруктураДат.НачалоПериода Тогда
			 СтруктураДат.НачалоПериода = Строка.НачалоПериода
		КонецЕсли; 
		Если ЗначениеЗаполнено(Строка.ОкончаниеПериода) и Строка.ОкончаниеПериода > СтруктураДат.ОкончаниеПериода Тогда
			 СтруктураДат.ОкончаниеПериода = Строка.ОкончаниеПериода
		 КонецЕсли; 
	КонецЦикла;
	
	Возврат СтруктураДат;

КонецФункции
   
&НаКлиенте
Процедура РазвернутьДерево(ИмяДереваЗначений, ТекущаяСтрока = Неопределено)
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = ЭтаФорма[ИмяДереваЗначений];
	КонецЕсли;
	
	КоллекцияЭлементовДерева = ТекущаяСтрока.ПолучитьЭлементы();
	
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл
		
		ИдентификаторСтроки	= Строка.ПолучитьИдентификатор();
		Элементы[ИмяДереваЗначений].Развернуть(ИдентификаторСтроки,Истина);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьДерево(ИмяДереваЗначений, ТекущаяСтрока = Неопределено)
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = ЭтаФорма[ИмяДереваЗначений];
	КонецЕсли;
	
	КоллекцияЭлементовДерева = ТекущаяСтрока.ПолучитьЭлементы();
	
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл
		
		ИдентификаторСтроки	= Строка.ПолучитьИдентификатор();
		Элементы[ИмяДереваЗначений].Свернуть(ИдентификаторСтроки);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаботыНаСервере()
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_РазделительнаяВедомость_ЗаполнитьРаботыНаСервере(ЭтотОбъект, СписокГруппировокДереваРаботы, СписокГруппировокДереваМатериалы, СписокГруппировокДереваРесурсы);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаботы(Команда)
	
	Если НовыйВариант И НЕ ЗначениеЗаполнено(Объект.ДокументУтверждения) Тогда
		ПоказатьПредупреждение(,"Не указан документ утверждения!");
		Возврат;
	КонецЕсли;
	
	ДеревоРаботы.ПолучитьЭлементы().Очистить();
	ДеревоМатериалы.ПолучитьЭлементы().Очистить();
	ДеревоРесурсы.ПолучитьЭлементы().Очистить();
	Объект.Работы.Очистить();
	Объект.Материалы.Очистить();
	Объект.Ресурсы.Очистить();
		
	ЗаполнитьРаботыНаСервере();
	
	ЗаполнитьЦеныПодрядчика();

	
	//РазвернутьДерево("ДеревоРаботы");
	//РазвернутьДерево("ДеревоМатериалы");
	//РазвернутьДерево("ДеревоРесурсы");
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииГруппировок(ИмяДереваЗначений, СписокГруппировок)
	
	Если ИмяДереваЗначений = "ДеревоРаботы" Тогда
		Таблица = ПолучитьТаблицуПоДереву("ДеревоРаботы", "Работа", СписокГруппировокДереваРаботы);
		СписокГруппировокДереваРаботы = СписокГруппировок;
		ПостроитьДеревоПоТаблице(Таблица, "ДеревоРаботы", "Работа", СписокГруппировокДереваРаботы);
	ИначеЕсли ИмяДереваЗначений = "ДеревоМатериалы" Тогда
		Таблица = ПолучитьТаблицуПоДереву("ДеревоМатериалы", "ВидНоменклатурыНоменклатураРабота", СписокГруппировокДереваМатериалы);
		СписокГруппировокДереваМатериалы = СписокГруппировок;
		ПостроитьДеревоПоТаблице(Таблица, "ДеревоМатериалы", "ВидНоменклатурыНоменклатураРабота", СписокГруппировокДереваМатериалы);
	ИначеЕсли ИмяДереваЗначений = "ДеревоРесурсы" Тогда
		Таблица = ПолучитьТаблицуПоДереву("ДеревоРесурсы", "РесурсРабота", СписокГруппировокДереваРесурсы);
		СписокГруппировокДереваРесурсы = СписокГруппировок;
		ПостроитьДеревоПоТаблице(Таблица, "ДеревоРесурсы", "РесурсРабота", СписокГруппировокДереваРесурсы);
	КонецЕсли;
	
КонецПроцедуры

