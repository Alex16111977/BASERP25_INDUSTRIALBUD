&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)	
	
	Если ДеревоРаботы.ПолучитьЭлементы().Количество() > 0 Тогда
		
		ТекстВопроса = НСтр("ru = 'Табличные части работ, материалов и ресурсов будут очищены. Продолжить?'");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ОбъектСтроительстваПриИзмененииПродолжение",ЭтотОбъект),ТекстВопроса,РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ОбъектСтроительстваПриИзмененииПродолжение(КодВозвратаДиалога.ОК,Новый Структура);
		
	КонецЕсли; 
	
	ОрганизацияПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектСтроительстваПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ТекущийОбъектСтроительства)
		И ТекущийОбъектСтроительства <> Объект.ОбъектСтроительства Тогда
		
		Если ДеревоРаботы.ПолучитьЭлементы().Количество() > 0 Тогда
			ТекстВопроса = НСтр("ru = 'Табличные части работ, материалов и ресурсов будут очищены. Продолжить?'");
			
			ПоказатьВопрос(Новый ОписаниеОповещения("ОбъектСтроительстваПриИзмененииПродолжение",ЭтотОбъект),ТекстВопроса,РежимДиалогаВопрос.ДаНет);
			
		Иначе
			
			ОбъектСтроительстваПриИзмененииПродолжение(КодВозвратаДиалога.ОК,Новый Структура);
			
		КонецЕсли; 
		
	Иначе
		
		ОбъектСтроительстваПриИзмененииПродолжение(КодВозвратаДиалога.ОК,Новый Структура);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура  ОбъектСтроительстваПриИзмененииПродолжение(Ответ,ДопПараметры)Экспорт
	
	Если Ответ  = КодВозвратаДиалога.Нет Тогда
		Объект.ОбъектСтроительства = ТекущийОбъектСтроительства;
		Объект.Организация         = ТекущаяОрганизация;
		Объект.СценарийПланирования = ТекущийСценарий;
		Объект.ДокументУтверждения = ТекущийДокументУтверждения;
		НовыйВариант = ЭтоНовыйВариант(Объект.СценарийПланирования); 
		Возврат;
	КонецЕсли;	
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ДеревоРаботы.ПолучитьЭлементы().Очистить();
		ДеревоМатериалы.ПолучитьЭлементы().Очистить();
		ДеревоРесурсы.ПолучитьЭлементы().Очистить();
		Объект.Работы.Очистить();
		Объект.Материалы.Очистить();
		Объект.Ресурсы.Очистить();
	КонецЕсли;
	
	Объект.СценарийПланирования = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьРабочийСценарий(Объект.ОбъектСтроительства, Объект.Организация);
	Объект.ДокументУтверждения = УСОERP_ЗащищенныеФункцииСервер.ПолучитьПоследнийДокументУтверждения(Объект.ОбъектСтроительства,Объект.Организация);
	
	ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;
	ТекущаяОрганизация         = Объект.Организация;
	ТекущийСценарий            = Объект.СценарийПланирования;
	ТекущийДокументУтверждения = Объект.ДокументУтверждения;
	НовыйВариант = ЭтоНовыйВариант(Объект.СценарийПланирования);
	
КонецПроцедуры

