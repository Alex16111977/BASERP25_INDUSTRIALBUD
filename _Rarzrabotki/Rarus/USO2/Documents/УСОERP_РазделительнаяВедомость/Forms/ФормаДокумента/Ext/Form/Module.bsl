			СтрокаДерева.ВидНоменклатурыНоменклатураРабота = ВыборкаВидНоменклатуры.ВидНоменклатуры;
			
			ВыборкаНоменклатура = ВыборкаВидНоменклатуры.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Номенклатура");
			
			Пока ВыборкаНоменклатура.Следующий() Цикл
				
				ПодСтрока = СтрокаДерева.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(ПодСтрока,ВыборкаНоменклатура);
				ПодСтрока.ВидНоменклатурыНоменклатураРабота = ВыборкаНоменклатура.Номенклатура;
				
				ВыборкаРабота = ВыборкаНоменклатура.Выбрать();
				
				Пока ВыборкаРабота.Следующий() Цикл
					
					СтрокаРабота = ПодСтрока.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРабота,ВыборкаРабота);
					СтрокаРабота.ВидНоменклатурыНоменклатураРабота = ВыборкаРабота.Работа;
					СтрокаРабота.Уровень = 1;
					
				КонецЦикла;   			
				
			КонецЦикла;   		
			
		КонецЦикла;
		
		ЗначениеВРеквизитФормы(ДеревоМатериалыЗначение,"ДеревоМатериалы");
		
	КонецЕсли;
	
	Если ЗаполнятьРесурсы Тогда
		
		ДеревоРесурсыЗначение = РеквизитФормыВЗначение("ДеревоРесурсы");
		ДеревоРесурсыЗначение.Строки.Очистить();
		
		ВыборкаРесурсы = ПакетЗапросов[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Ресурс");
		
