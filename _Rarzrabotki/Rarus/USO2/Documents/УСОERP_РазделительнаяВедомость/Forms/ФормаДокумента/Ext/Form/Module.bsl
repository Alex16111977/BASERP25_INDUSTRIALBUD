&НаКлиенте
Процедура РаботыОбъемСобственныйПриИзменении(Элемент)
	
	СтрокаДерева = Элементы.ДеревоРаботы.ТекущиеДанные;
	
	СтрокаДерева.ОбъемСобственный = Мин(СтрокаДерева.ОбъемСобственный, СтрокаДерева.ОбъемОбщий);
	СтрокаДерева.ОбъемСубподряда  = СтрокаДерева.ОбъемОбщий - СтрокаДерева.ОбъемСобственный;
	
	ПересчитатьИтогиДереваРабот();
	
	ОтметитьСубподрядныеРаботы(СтрокаДерева);
	
	РазвернутьДерево("ДеревоМатериалы");
	РазвернутьДерево("ДеревоРесурсы");
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьСубподрядныеРаботы(СтрокаДереваРабот)
	
	СтрокаДереваРабот.ЕстьСубподряд = СтрокаДереваРабот.ОбъемСубподряда > 0;
	
	ОтметитьСубподрядныеРаботыНаСервере(СтрокаДереваРабот.Работа, СтрокаДереваРабот.ЕстьСубподряд);
	
	РазвернутьДерево("ДеревоМатериалы");
	РазвернутьДерево("ДеревоРесурсы");
	
КонецПроцедуры

&НаСервере
Процедура ОтметитьСубподрядныеРаботыНаСервере(Работа, ЕстьСубподряд)
	
	ДеревоМатериалыЗначение = РеквизитФормыВЗначение("ДеревоМатериалы");
	
	МассивСтрокМатериалы = ДеревоМатериалыЗначение.Строки.НайтиСтроки(Новый Структура("ВидНоменклатурыНоменклатураРабота", Работа), Истина);
	Для Каждого СтрокаМатериалы Из МассивСтрокМатериалы Цикл
		СтрокаМатериалы.ЕстьСубподряд = ЕстьСубподряд;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоМатериалыЗначение, "ДеревоМатериалы");
	
	ДеревоРесурсыЗначение = РеквизитФормыВЗначение("ДеревоРесурсы");
	
	МассивСтрокРесурсы = ДеревоРесурсыЗначение.Строки.НайтиСтроки(Новый Структура("РесурсРабота", Работа), Истина);
	Для Каждого СтрокаРесурсы Из МассивСтрокРесурсы Цикл
		СтрокаРесурсы.ЕстьСубподряд = ЕстьСубподряд;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоРесурсыЗначение, "ДеревоРесурсы");
	
КонецПроцедуры


&НаКлиенте
Процедура РаботыОбъемСубподрядаПриИзменении(Элемент)
	
	СтрокаДерева = Элементы.ДеревоРаботы.ТекущиеДанные;
	
	СтрокаДерева.ОбъемСубподряда   = Мин(СтрокаДерева.ОбъемСубподряда, СтрокаДерева.ОбъемОбщий);
	СтрокаДерева.ОбъемСобственный  = СтрокаДерева.ОбъемОбщий - СтрокаДерева.ОбъемСубподряда;
	
	ОтметитьСубподрядныеРаботы(СтрокаДерева);
	ПересчитатьИтогиДереваРабот();
КонецПроцедуры

&НаКлиенте
Процедура МатериалыКоличествоСобственноеПриИзменении(Элемент)
	
	СтрокаДерева = Элементы.ДеревоМатериалы.ТекущиеДанные;
	
	СтрокаДерева.КоличествоСобственное = Мин(СтрокаДерева.КоличествоСобственное, СтрокаДерева.КоличествоОбщее);
	СтрокаДерева.КоличествоСубподряда  = СтрокаДерева.КоличествоОбщее - СтрокаДерева.КоличествоСобственное;
	
	ПересчитатьИтогиДерева();
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыКоличествоСубподрядаПриИзменении(Элемент)
	
	СтрокаДерева = Элементы.ДеревоМатериалы.ТекущиеДанные;
	
	СтрокаДерева.КоличествоСубподряда   = Мин(СтрокаДерева.КоличествоСубподряда, СтрокаДерева.КоличествоОбщее);
	СтрокаДерева.КоличествоСобственное  = СтрокаДерева.КоличествоОбщее - СтрокаДерева.КоличествоСубподряда;
	
	ПересчитатьИтогиДерева();
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьИтогиДереваРабот()
	
	ТаблицаРаботы    = ПолучитьТаблицуПоДереву("ДеревоРаботы", "Работа", СписокГруппировокДереваРаботы);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТабРабот",ТаблицаРаботы);
	Запрос.УстановитьПараметр("НовыйВариант",Объект.СценарийПланирования.НовыйВариант);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТабРабот.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	ТабРабот.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТабРабот.Подразделение КАК Подразделение,
	|	ТабРабот.Контрагент КАК Контрагент,
	|	ТабРабот.НачалоПериода КАК НачалоПериода,
	|	ТабРабот.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ТабРабот.ОбъемСобственный КАК ОбъемСобственный,
	|	ТабРабот.ОбъемСубподряда КАК ОбъемСубподряда,
	|	ТабРабот.СуммарнаяРабота КАК СуммарнаяРабота,
	|	ТабРабот.ЦенаЗаказчика КАК ЦенаЗаказчика,
	|	ТабРабот.ЦенаПодрядчикаКоэффициент КАК ЦенаПодрядчикаКоэффициент,
	|	ТабРабот.ЦенаПодрядчикаЦена КАК ЦенаПодрядчикаЦена,
	|	ТабРабот.ЦенаПодрядчикаРазность КАК ЦенаПодрядчикаРазность
	|ПОМЕСТИТЬ ВрТабРабот
	|ИЗ
	|	&ТабРабот КАК ТабРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТабРабот.Работа.ВидРабот КАК ВидРабот,
	|	ВЫБОР
	|		КОГДА &НовыйВариант
	|			ТОГДА ВрТабРабот.Работа.ЕдиницаОбъема
	|		ИНАЧЕ ВрТабРабот.ЕдиницаОбъема
	|	КОНЕЦ КАК ЕдиницаОбъема,
	|	ВЫБОР
	|		КОГДА ВрТабРабот.ОбъемСубподряда > 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьСубподряд,
	|	ВрТабРабот.Контрагент КАК Контрагент,
	|	ВрТабРабот.ОбъемСобственный + ВрТабРабот.ОбъемСубподряда КАК ОбъемОбщий,
	|	ВрТабРабот.ОбъемСобственный КАК ОбъемСобственный,
	|	ВрТабРабот.ОбъемСубподряда КАК ОбъемСубподряда,
	|	ВЫБОР
	|		КОГДА &НовыйВариант
	|			ТОГДА ВрТабРабот.Работа.ДатаОкончания
	|		ИНАЧЕ ВрТабРабот.ОкончаниеПериода
	|	КОНЕЦ КАК ОкончаниеПериода,
	|	ВрТабРабот.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА &НовыйВариант
	|			ТОГДА ВрТабРабот.Работа.ДатаНачала
	|		ИНАЧЕ ВрТабРабот.НачалоПериода
	|	КОНЕЦ КАК НачалоПериода,
	|	ВрТабРабот.Работа КАК Работа,
	|	ВрТабРабот.СуммарнаяРабота КАК СуммарнаяРабота,
	|	ВЫБОР
	|		КОГДА ВрТабРабот.СуммарнаяРабота
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Уровень,
	|	ВрТабРабот.Контрагент КАК КоличествоКонтрагентов,
	|	ВрТабРабот.Подразделение КАК КоличествоПодразделений,
	|	ВрТабРабот.ЕдиницаОбъема КАК КоличествоЕдиниц,
	|	ВрТабРабот.ЦенаЗаказчика КАК ЦенаЗаказчика,
	|	ВрТабРабот.ЦенаПодрядчикаЦена КАК ЦенаПодрядчикаЦена,
	|	ВрТабРабот.ЦенаПодрядчикаРазность КАК ЦенаПодрядчикаРазность,
	|	ВрТабРабот.ЦенаПодрядчикаКоэффициент КАК ЦенаПодрядчикаКоэффициент
	|ИЗ
	|	ВрТабРабот КАК ВрТабРабот
	|ГДЕ
	|	ВрТабРабот.СуммарнаяРабота = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВрТабРабот.Работа.НомерРаботыВУровне
	|ИТОГИ
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЕдиницаОбъема) = 1
	|			ТОГДА МАКСИМУМ(ЕдиницаОбъема)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|	КОНЕЦ КАК ЕдиницаОбъема,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоКонтрагентов) = 1
	|			ТОГДА МАКСИМУМ(Контрагент)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЕдиницаОбъема) = 1
	|			ТОГДА СУММА(ОбъемОбщий)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ОбъемОбщий,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЕдиницаОбъема) = 1
	|				И КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоПодразделений) = 1
	|			ТОГДА СУММА(ОбъемСобственный)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ОбъемСобственный,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЕдиницаОбъема) = 1
	|				И КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоКонтрагентов) = 1
	|			ТОГДА СУММА(ОбъемСубподряда)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ОбъемСубподряда,
	|	МАКСИМУМ(ОкончаниеПериода),
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоПодразделений) = 1
	|			ТОГДА МАКСИМУМ(Подразделение)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	МИНИМУМ(НачалоПериода),
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоКонтрагентов),
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоПодразделений),
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоЕдиниц),
	|	СУММА(ЦенаЗаказчика),
	|	СУММА(ЦенаПодрядчикаЦена),
	|	СУММА(ЦенаПодрядчикаРазность),
	|	ВЫБОР
	|		КОГДА СУММА(ЦенаЗаказчика) = 0
	|			ТОГДА 0
	|		ИНАЧЕ СУММА(ЦенаПодрядчикаЦена) / СУММА(ЦенаЗаказчика)
	|	КОНЕЦ КАК ЦенаПодрядчикаКоэффициент
	|ПО
	|	Работа ИЕРАРХИЯ";
	
	ТЗ = Запрос.Выполнить().Выгрузить(); 
	
	СуммаЦенаЗаказчикаРазность = 0;
	
	Для Каждого ЭлементДерева ИЗ ДеревоРаботы.ПолучитьЭлементы() Цикл
		
		ЗаполнитьСтрокуИтоговДереваРабот(ЭлементДерева,ТЗ); 
		
		СуммаЦенаЗаказчикаРазность = СуммаЦенаЗаказчикаРазность+ЭлементДерева.ЦенаПодрядчикаЦена-ЭлементДерева.ЦенаЗаказчика;
		
	КонецЦикла;  
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуИтоговДереваРабот(ЭлементДерева,ТаблицаДанных)
	
	Строка = ТаблицаДанных.Найти(ЭлементДерева.Работа);
	
	ЗаполнитьЗначенияСвойств(ЭлементДерева,Строка,"ОбъемСобственный,ОбъемСубподряда,Подразделение,Контрагент,ЦенаЗаказчика,ЦенаПодрядчикаЦена,ЦенаПодрядчикаКоэффициент,ЦенаПодрядчикаРазность");
	
	Для Каждого ПодЭлемент ИЗ ЭлементДерева.ПолучитьЭлементы() Цикл
		
		ЗаполнитьСтрокуИтоговДереваРабот(ПодЭлемент,ТаблицаДанных);
		
	КонецЦикла; 	
	
КонецПроцедуры  

&НаСервере
Процедура ПересчитатьИтогиДерева() 	
	
	Для Каждого ЭлементДерева ИЗ ДеревоМатериалы.ПолучитьЭлементы() Цикл
		
		СуммаСобств = 0;
		СуммаПодр = 0;
		
		Для Каждого ПодЭлемент ИЗ ЭлементДерева.ПолучитьЭлементы() Цикл
			
			ПодСумма = 0;
			ПодСуммаПодр = 0;
			
			Для Каждого СтрокаСумма ИЗ ПодЭлемент.ПолучитьЭлементы() Цикл
				
				ПодСумма = ПодСумма+СтрокаСумма.КоличествоСобственное;
				ПодСуммаПодр = ПодСуммаПодр+СтрокаСумма.КоличествоСубподряда;
				
			КонецЦикла;
			
			ПодЭлемент.КоличествоСобственное = ПодСумма;
			ПодЭлемент.КоличествоСубподряда = ПодСуммаПодр;
			
			СуммаСобств = СуммаСобств+ПодЭлемент.КоличествоСобственное;
			СуммаПодр = СуммаПодр+ПодЭлемент.КоличествоСубподряда; 					
			
		КонецЦикла; 
		
		ЭлементДерева.КоличествоСобственное = СуммаСобств;
		ЭлементДерева.КоличествоСубподряда = СуммаПодр;  	
		
	КонецЦикла; 	
	
КонецПроцедуры 

&НаКлиенте
Процедура РесурсыКоличествоСобственноеПриИзменении(Элемент)
	
	СтрокаДерева = Элементы.ДеревоРесурсы.ТекущиеДанные;
	
	СтрокаДерева.КоличествоСобственное = Мин(СтрокаДерева.КоличествоСобственное, СтрокаДерева.КоличествоОбщее);
	СтрокаДерева.КоличествоСубподряда  = СтрокаДерева.КоличествоОбщее - СтрокаДерева.КоличествоСобственное;
	
КонецПроцедуры

&НаКлиенте
Процедура РесурсыКоличествоСубподрядаПриИзменении(Элемент)
	
	СтрокаДерева = Элементы.ДеревоРесурсы.ТекущиеДанные;
	
	СтрокаДерева.КоличествоСубподряда   = Мин(СтрокаДерева.КоличествоСубподряда, СтрокаДерева.КоличествоОбщее);
	СтрокаДерева.КоличествоСобственное  = СтрокаДерева.КоличествоОбщее - СтрокаДерева.КоличествоСубподряда;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПодразделениеИсполнительПоИерархии(СтрокаДерева, Подразделение,МассивРабот)
	
	ПодчиненныеСтрокиДерева = СтрокаДерева.ПолучитьЭлементы();
	
	Для Каждого ПодчиненнаяСтрока Из ПодчиненныеСтрокиДерева Цикл
		
		ПодчиненнаяСтрока.Подразделение = Подразделение;
		ПодчиненнаяСтрока.Контрагент = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		
		Если НЕ ЗначениеЗаполнено(ПодчиненнаяСтрока.Контрагент) 
			И ПодчиненнаяСтрока.ОбъемСобственный = 0 Тогда
			
			ПодчиненнаяСтрока.ОбъемСобственный = ПодчиненнаяСтрока.ОбъемСубподряда;
			ПодчиненнаяСтрока.ОбъемСубподряда = 0;
			ПодчиненнаяСтрока.ЕстьСубподряд = Ложь;
			
			Если МассивРабот.Найти(ПодчиненнаяСтрока.Работа) = Неопределено Тогда
				МассивРабот.Добавить(ПодчиненнаяСтрока.Работа);
			КонецЕсли;
			
			//ОтметитьСубподрядныеРаботы(ПодчиненнаяСтрока);
		КонецЕсли;
		
		Если ПодчиненнаяСтрока.ПолучитьЭлементы().Количество() Тогда // рекурсия!
			ЗаполнитьПодразделениеИсполнительПоИерархии(ПодчиненнаяСтрока, Подразделение,МассивРабот);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаполненияПодразделенияДереваРабот(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		МассивРабот = Новый Массив;;
		ЗаполнитьПодразделениеИсполнительПоИерархии(ДополнительныеПараметры.СтрокаДерева, ДополнительныеПараметры.Подразделение,МассивРабот);
		ОтметитьСубподрядныеРаботыПоМассивуРабот(МассивРабот,Ложь);
		
	КонецЕсли;
	
	ПересчитатьИтогиДереваРабот();
	
КонецПроцедуры

&НаСервере
Процедура ОтметитьСубподрядныеРаботыПоМассивуРабот(МассивРабот,ЕстьСубподряд)
	
	ДеревоМатериалыЗначение = РеквизитФормыВЗначение("ДеревоМатериалы");
	ДеревоРесурсыЗначение = РеквизитФормыВЗначение("ДеревоРесурсы");
	
   Для Каждого Работа ИЗ МассивРабот Цикл
	
	МассивСтрокМатериалы = ДеревоМатериалыЗначение.Строки.НайтиСтроки(Новый Структура("ВидНоменклатурыНоменклатураРабота", Работа), Истина);
	Для Каждого СтрокаМатериалы Из МассивСтрокМатериалы Цикл
		СтрокаМатериалы.ЕстьСубподряд = ЕстьСубподряд;
	КонецЦикла; 	
	
	МассивСтрокРесурсы = ДеревоРесурсыЗначение.Строки.НайтиСтроки(Новый Структура("РесурсРабота", Работа), Истина);
	Для Каждого СтрокаРесурсы Из МассивСтрокРесурсы Цикл
		СтрокаРесурсы.ЕстьСубподряд = ЕстьСубподряд;
	КонецЦикла;
	
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоМатериалыЗначение, "ДеревоМатериалы");	
	ЗначениеВРеквизитФормы(ДеревоРесурсыЗначение, "ДеревоРесурсы");

	
КонецПроцедуры

&НаКлиенте
Процедура РаботыПодразделениеПриИзменении(Элемент)
	
	СтрокаДерева = Элементы.ДеревоРаботы.ТекущиеДанные;
	
	Если СтрокаДерева.ПолучитьЭлементы().Количество() Тогда
		ДопПараметры = Новый Структура("СтрокаДерева, Подразделение", СтрокаДерева, СтрокаДерева.Подразделение);
		ПоказатьВопрос(Новый ОписаниеОповещения("ОбработкаЗаполненияПодразделенияДереваРабот", ЭтаФорма, ДопПараметры)
		, НСтр("ru = 'Заполнить подразделение у подчиненных элементов?'")
		, РежимДиалогаВопрос.ДаНет);
	ИначеЕсли ЗначениеЗаполнено(СтрокаДерева.Подразделение) Тогда
		
		Если НЕ ЗначениеЗаполнено(СтрокаДерева.Контрагент) 
			И СтрокаДерева.ОбъемСобственный = 0 Тогда
			
			СтрокаДерева.ОбъемСобственный = СтрокаДерева.ОбъемСубподряда;
			СтрокаДерева.ОбъемСубподряда = 0;
			ОтметитьСубподрядныеРаботы(СтрокаДерева);
			
		КонецЕсли;
		
		ПересчитатьИтогиДереваРабот(); 
		
		// если очистили подразделение, но заполнен контрагент
	ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаДерева.Подразделение) Тогда
		
		Если ЗначениеЗаполнено(СтрокаДерева.Контрагент) 
			И СтрокаДерева.ОбъемСубподряда = 0 Тогда
			
			СтрокаДерева.ОбъемСубподряда  = СтрокаДерева.ОбъемСобственный;
			СтрокаДерева.ОбъемСобственный = 0;
			ОтметитьСубподрядныеРаботы(СтрокаДерева);
			ПересчитатьИтогиДереваРабот();
			
		КонецЕсли;
		
		ПересчитатьИтогиДереваРабот();
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

