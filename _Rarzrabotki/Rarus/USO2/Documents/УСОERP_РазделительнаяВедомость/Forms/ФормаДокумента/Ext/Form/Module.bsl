КонецПроцедуры 

&НаСервере
Процедура ДеревоРесурсыПриОкончанииРедактированияНаСервере()
	
	ТаблицаРесурсы = ПолучитьТаблицуПоДереву("ДеревоРесурсы", "РесурсРабота", СписокГруппировокДереваРесурсы);
	Объект.Ресурсы.Загрузить(ТаблицаРесурсы);  
	ЗаполнитьДанныеФормыИзОбъекта(Ложь,Ложь,Ложь,Ложь,Истина);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьПередачуСырьяНаСервере()
	
	ТабРабот = Объект.Работы.Выгрузить();
	ТабМатериалы = Объект.Материалы.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТабРабот",ТабРабот);
	Запрос.УстановитьПараметр("ТабМатериалы",ТабМатериалы);
	Запрос.УстановитьПараметр("ОбъектСтроительства",Объект.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	Запрос.УстановитьПараметр("Дата",Объект.Дата);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(УСОERP_ДоговорССубподрядчиком.Дата) КАК Дата,
	|	УСОERP_ДоговорССубподрядчиком.Контрагент КАК Контрагент
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	Документ.УСОERP_ДоговорССубподрядчиком КАК УСОERP_ДоговорССубподрядчиком
	|ГДЕ
	|	УСОERP_ДоговорССубподрядчиком.Организация = &Организация
	|	И УСОERP_ДоговорССубподрядчиком.ОбъектСтроительства = &ОбъектСтроительства
	|	И УСОERP_ДоговорССубподрядчиком.Проведен
	|	И УСОERP_ДоговорССубподрядчиком.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|	И УСОERP_ДоговорССубподрядчиком.Дата <= &Дата
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ДоговорССубподрядчиком.Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_ДоговорССубподрядчиком.Ссылка КАК Ссылка,
	|	УСОERP_ДоговорССубподрядчиком.Контрагент КАК Контрагент,
	|	УСОERP_ДоговорССубподрядчиком.Партнер КАК Партнер,
	|	УСОERP_ДоговорССубподрядчиком.Договор КАК Договор,
	|	УСОERP_ДоговорССубподрядчиком.Соглашение КАК Соглашение
	|ПОМЕСТИТЬ ВрТабДокументы
	|ИЗ
	|	Документ.УСОERP_ДоговорССубподрядчиком КАК УСОERP_ДоговорССубподрядчиком
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВрТаб КАК ВрТаб
	|		ПО УСОERP_ДоговорССубподрядчиком.Контрагент = ВрТаб.Контрагент
	|			И УСОERP_ДоговорССубподрядчиком.Дата = ВрТаб.Дата
	|ГДЕ
	|	УСОERP_ДоговорССубподрядчиком.ОбъектСтроительства = &ОбъектСтроительства
	|	И УСОERP_ДоговорССубподрядчиком.Проведен
	|	И УСОERP_ДоговорССубподрядчиком.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|	И УСОERP_ДоговорССубподрядчиком.Организация = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТабРабот.Работа КАК Работа,
	|	ВЫРАЗИТЬ(ВрТабРабот.Контрагент КАК Справочник.Контрагенты) КАК Контрагент,
	|	ВрТабРабот.ОбъемСубподряда КАК ОбъемСубподряда,
	|	ВрТабРабот.СуммарнаяРабота КАК СуммарнаяРабота
	|ПОМЕСТИТЬ ВрТабРабот
	|ИЗ
	|	&ТабРабот КАК ВрТабРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабМатериалы.Работа КАК Работа,
	|	ТабМатериалы.Номенклатура КАК Номенклатура,
	|	ТабМатериалы.Характеристика КАК Характеристика,
	|	ТабМатериалы.КоличествоСобственное КАК КоличествоСобственное
	|ПОМЕСТИТЬ ВрТабМатериалы
	|ИЗ
	|	&ТабМатериалы КАК ТабМатериалы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТабРабот.Контрагент КАК Контрагент,
	|	ВрТабМатериалы.Номенклатура КАК Номенклатура,
	|	ВрТабМатериалы.Характеристика КАК Характеристика,
	|	ВрТабМатериалы.КоличествоСобственное КАК Количество,
	|	ВрТабДокументы.Партнер КАК Партнер,
	|	ВрТабДокументы.Договор КАК Договор,
	|	ВрТабДокументы.Соглашение КАК Соглашение,
	|	ВрТабДокументы.Ссылка.Валюта КАК Валюта
	|ИЗ
	|	ВрТабРабот КАК ВрТабРабот
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВрТабМатериалы КАК ВрТабМатериалы
	|		ПО ВрТабРабот.Работа = ВрТабМатериалы.Работа
	|			И (ВрТабМатериалы.КоличествоСобственное > 0)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВрТабДокументы КАК ВрТабДокументы
	|		ПО ВрТабРабот.Контрагент = ВрТабДокументы.Контрагент
	|ГДЕ
	|	ВрТабРабот.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|ИТОГИ
	|	МАКСИМУМ(Партнер),
	|	МАКСИМУМ(Договор),
	|	МАКСИМУМ(Соглашение),
	|	МАКСИМУМ(Валюта)
	|ПО
	|	Контрагент";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Контрагент");
	
	Пока Выборка.Следующий() Цикл
		
		Док = Документы.ПередачаСырьяПереработчику.СоздатьДокумент();
		Док.Автор = Пользователи.ТекущийПользователь();
		Док.Менеджер = Док.Автор;
		
		Док.Контрагент = Выборка.Контрагент;
		ЗаполнитьЗначенияСвойств(Док,Выборка,"Партнер,Договор,Валюта");
		
		Док.Основание = Объект.Ссылка;
		Док.ОснованиеДата = Объект.Дата;
		Док.ОснованиеНомер = Объект.Номер;
		Док.Дата = ТекущаяДата();
		Док.Организация = Объект.Организация;
		Док.Склад = Выборка.Соглашение.Склад;
		Док.ВидЦены = Константы.ВидЦеныПлановойСтоимостиМатериаловРабот.Получить();
		Док.ХозяйственнаяОперация = Метаданные.Документы.ПередачаСырьяПереработчику.Реквизиты.ХозяйственнаяОперация.ЗначениеЗаполнения;
		Док.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
		Док.Подразделение = ЗначениеНастроекПовтИсп.ПодразделениеПользователя(Док.Автор);
		Док.НаправлениеДеятельности = Объект.ДокументУтверждения.НаправлениеДеятельности;
		
		СтруктураПараметров = ДенежныеСредстваСервер.ПараметрыЗаполненияБанковскогоСчетаОрганизацииПоУмолчанию();
		СтруктураПараметров.Организация    		= Док.Организация;
		СтруктураПараметров.БанковскийСчет		= Док.БанковскийСчетОрганизации;
		
		Док.БанковскийСчетОрганизации = ЗначениеНастроекПовтИсп.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(СтруктураПараметров); 	
		Док.БанковскийСчетКонтрагента = ЗначениеНастроекПовтИсп.ПолучитьБанковскийСчетКонтрагентаПоУмолчанию(Док.Контрагент, , Док.БанковскийСчетКонтрагента);
		
		СтруктураПараметров = ДенежныеСредстваСервер.ПараметрыЗаполненияКассыОрганизацииПоУмолчанию();
		СтруктураПараметров.Организация = Док.Организация;
		СтруктураПараметров.Касса		= Док.Касса;
		Док.Касса                     = ЗначениеНастроекПовтИсп.ПолучитьКассуОрганизацииПоУмолчанию(СтруктураПараметров);
		
		ДатаРаспоряжения          = ТекущаяДатаСеанса();
		ХозяйственнаяОперация     = Метаданные.Документы.ПередачаСырьяПереработчику.Реквизиты.ХозяйственнаяОперация.ЗначениеЗаполнения; 
		
		СтруктураОтветственного = ПродажиСервер.ПолучитьОтветственногоПоСкладу(Док.Склад, Док.Менеджер);
		
		Если СтруктураОтветственного <> Неопределено Тогда
			Док.Отпустил          = СтруктураОтветственного.Ответственный;
			Док.ОтпустилДолжность = СтруктураОтветственного.ОтветственныйДолжность;
		КонецЕсли;
		
		ОтветственныеЛицаСервер.ПриИзмененииСвязанныхРеквизитовДокумента(Док); 		
		
		ВыборкаДетали = Выборка.Выбрать();
		
		Пока ВыборкаДетали.Следующий() Цикл
			
			Нстр = Док.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,ВыборкаДетали);
			
			Нстр.КоличествоУпаковок = Нстр.Количество;
			
			Нстр.Цена = ПродажиСервер.ПолучитьЦенуПоОтбору(Новый Структура("Дата,Номенклатура,Характеристика,Упаковка,ВидЦены,Валюта",Док.Дата,Нстр.Номенклатура,Нстр.Характеристика,Нстр.Упаковка,Док.ВидЦены,Док.Валюта));
			
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ПересчитатьСумму");
			
			ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(Нстр, СтруктураДействий, Неопределено);			
			
		КонецЦикла;  		
		
		Попытка
			
			Док.Записать(РежимЗаписиДокумента.Проведение);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ "+Док.Ссылка);
			
		Исключение 		
			
			Док.Записать(РежимЗаписиДокумента.Запись);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ "+Док.Ссылка);
			
		КонецПопытки; 	
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПередачуСырья(Команда)
	
	Если Модифицированность ИЛИ НЕ Объект.Проведен ИЛИ НЕ Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыПланов.Утвержден") Тогда
		
		ПоказатьПредупреждение(,"Вводить документы можно только на основании проведенного и утвержденного документа!");
		Возврат;
		
	КонецЕсли;
	
			
	СформироватьПередачуСырьяНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботыЦенаПодрядчикаКоэффициентПриИзменении(Элемент)
	
	ТекСтрока = Элементы.ДеревоРаботы.ТекущиеДанные;
	ТекСтрока.ЦенаПодрядчикаЦена = ТекСтрока.ЦенаЗаказчика*ТекСтрока.ЦенаПодрядчикаКоэффициент;
	ТекСтрока.ЦенаПодрядчикаРазность = ТекСтрока.ЦенаПодрядчикаЦена - ТекСтрока.ЦенаЗаказчика;
	ПересчитатьИтогиДереваРабот();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботыЦенаПодрядчикаЦенаПриИзменении(Элемент)
	
	ТекСтрока = Элементы.ДеревоРаботы.ТекущиеДанные;
	ТекСтрока.ЦенаПодрядчикаКоэффициент = ?(ТекСтрока.ЦенаЗаказчика = 0,0, ТекСтрока.ЦенаПодрядчикаЦена/ТекСтрока.ЦенаЗаказчика);
	ТекСтрока.ЦенаПодрядчикаРазность = ТекСтрока.ЦенаПодрядчикаЦена - ТекСтрока.ЦенаЗаказчика;
	ПересчитатьИтогиДереваРабот();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьКоэффициент(Команда)
	
	ВыбранноеЗначение = 1;
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьКоэффициентПродолжение",ЭтотОбъект);
	
	ПоказатьВводЧисла(ОписаниеОповещения,ВыбранноеЗначение,"Ввести коэффициент",10,2);
	
КонецПроцедуры

&НаКлиенте
Процедура   ЗаполнитьКоэффициентПродолжение(ВыбранноеЗначение,ДопПараметры)Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ВыделеннаяСтрока ИЗ Элементы.ДеревоРаботы.ВыделенныеСтроки Цикл
		
		Строка = ДеревоРаботы.НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		ЗаполнитьКоэффициентВСтроке(Строка,ВыбранноеЗначение);
		
	КонецЦикла; 
	
	ПересчитатьИтогиДереваРабот();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура  ЗаполнитьКоэффициентВСтроке(Строка,Коэффициент)	
	
	ПодЭлементы = Строка.ПолучитьЭлементы();
	
	Если Не ПодЭлементы.Количество() Тогда
		Строка.ЦенаПодрядчикаКоэффициент = Коэффициент;
		Строка.ЦенаПодрядчикаЦена = Строка.ЦенаЗаказчика*Коэффициент;
		Строка.ЦенаПодрядчикаРазность = Строка.ЦенаПодрядчикаЦена-Строка.ЦенаЗаказчика;
	КонецЕсли;
	
	Для Каждого ПодЭлемент ИЗ ПодЭлементы Цикл
		
		ЗаполнитьКоэффициентВСтроке(ПодЭлемент,Коэффициент);
		
	КонецЦикла; 	
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьЦеныПодрядчика()
	
	ТабРабот = Объект.Работы.Выгрузить();
	ТабРабот.ЗаполнитьЗначения(0,"ЦенаЗаказчика,ЦенаПодрядчикаЦена,ЦенаПодрядчикаРазность");
	ТабРабот.ЗаполнитьЗначения(1,"ЦенаПодрядчикаКоэффициент");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТабРабот",ТабРабот);
	Запрос.УстановитьПараметр("ДокументУтверждения",Объект.ДокументУтверждения);
	Запрос.УстановитьПараметр("Дата", КонецДня(Объект.Дата));
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УСОERP_ДоговорСЗаказчиком.Ссылка КАК Ссылка,
	|	1 КАК Порядок,
	|	УСОERP_ДоговорСЗаказчиком.Дата КАК Дата
	|ИЗ
	|	Документ.УСОERP_ДоговорСЗаказчиком КАК УСОERP_ДоговорСЗаказчиком
	|ГДЕ
	|	УСОERP_ДоговорСЗаказчиком.ДокументУтверждения = &ДокументУтверждения
	|	И УСОERP_ДоговорСЗаказчиком.Проведен
	|	И УСОERP_ДоговорСЗаказчиком.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|	И УСОERP_ДоговорСЗаказчиком.Дата <= &Дата
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	УСОERP_БюджетСтроительства.Ссылка,
	|	2,
	|	УСОERP_БюджетСтроительства.Дата
	|ИЗ
	|	Документ.УСОERP_БюджетСтроительства КАК УСОERP_БюджетСтроительства
	|ГДЕ
	|	УСОERP_БюджетСтроительства.ДокументОснование = &ДокументУтверждения
	|	И УСОERP_БюджетСтроительства.Проведен
	|	И УСОERP_БюджетСтроительства.Дата <= &Дата
	|	И УСОERP_БюджетСтроительства.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Дата УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если НЕ Выборка.Следующий() Тогда
		Объект.Работы.Загрузить(ТабРабот);
		Возврат;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка",Выборка.Ссылка);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ДоговорСЗаказчикомРаботы.Работа КАК Работа,
	|	УСОERP_ДоговорСЗаказчикомРаботы.СуммаСНДС КАК ЦенаЗаказчика,
	|	УСОERP_ДоговорСЗаказчикомРаботы.СуммаСНДС КАК ЦенаПодрядчикаЦена,
	|	1 КАК ЦенаПодрядчикаКоэффициент
	|ИЗ
	|	Документ.УСОERP_ДоговорСЗаказчиком.Работы КАК УСОERP_ДоговорСЗаказчикомРаботы
	|ГДЕ
	|	УСОERP_ДоговорСЗаказчикомРаботы.Ссылка = &Ссылка
	|	И НЕ УСОERP_ДоговорСЗаказчикомРаботы.Работа.СуммарнаяРабота
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УСОERP_БюджетСтроительстваРасценка.Работа,
	|	УСОERP_БюджетСтроительстваРасценка.СуммаСНДС,
	|	УСОERP_БюджетСтроительстваРасценка.СуммаСНДС,
	|	1
	|ИЗ
	|	Документ.УСОERP_БюджетСтроительства.Расценка КАК УСОERP_БюджетСтроительстваРасценка
	|ГДЕ
	|	УСОERP_БюджетСтроительстваРасценка.Ссылка = &Ссылка
	|	И НЕ УСОERP_БюджетСтроительстваРасценка.Работа.СуммарнаяРабота";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Строки = Объект.Работы.НайтиСтроки(Новый Структура("Работа",Выборка.Работа));
		
		Для Каждого СтрокаРабота ИЗ Строки Цикл
			
			ЗаполнитьЗначенияСвойств(СтрокаРабота,Выборка,"ЦенаЗаказчика,ЦенаПодрядчикаЦена,ЦенаПодрядчикаКоэффициент");
			
		КонецЦикла;
		
	КонецЦикла;
	
	
	ЗаполнитьДанныеФормыИзОбъекта(Истина,Ложь,Ложь,Ложь,Ложь);  
	ПересчитатьИтогиДереваРабот();	
	
	
	//ТЗ = Запрос.Выполнить().Выгрузить();
	
	
КонецПроцедуры

&НаСервере
