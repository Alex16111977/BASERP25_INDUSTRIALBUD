&НаСервере 
Процедура ДеревоМатериалыПоИсполнителямПриОкончанииРедактированияНаСервере()	
	
	Объект.Материалы.Очистить();
	Дерево = РеквизитФормыВЗначение("ДеревоМатериалыПоИсполнителям");
	Строки = Дерево.Строки.НайтиСтроки(Новый Структура("УровеньСтроки",2),Истина);
	
	Для Каждого НайденнаяСтрока ИЗ Строки Цикл
		
		Нстр = Объект.Материалы.Добавить();
		Нстр.Работа = НайденнаяСтрока.Родитель.Работа;
		Нстр.ЕдиницаОбъема = Нстр.Работа.ЕдиницаОбъема;
		Нстр.Номенклатура = НайденнаяСтрока.ИсполнительРаботаМатериал;
		Нстр.Характеристика = НайденнаяСтрока.Характеристика;
		Нстр.НачалоПериода = Нстр.Работа.ДатаНачала;
		Нстр.ОкончаниеПериода = Нстр.Работа.ДатаОкончания;
		Нстр.КоличествоСобственное = НайденнаяСтрока.КоличествоСобственное;
		Нстр.КоличествоСубподряда = НайденнаяСтрока.КоличествоСубподряда;
		
	КонецЦикла;
	
	ЗаполнитьДанныеФормыИзОбъекта(Ложь,Истина,Ложь,Ложь,Ложь);
	
КонецПроцедуры

