&НаКлиенте
Процедура ЗаполнитьСубподрядчикаПоИерархии(СтрокаДерева, Контрагент,МассивРабот)
	
	ПодчиненныеСтрокиДерева = СтрокаДерева.ПолучитьЭлементы();
	
	Для Каждого ПодчиненнаяСтрока Из ПодчиненныеСтрокиДерева Цикл
		
		ПодчиненнаяСтрока.Контрагент = Контрагент;
		ПодчиненнаяСтрока.Подразделение = ПредопределенноеЗначение("Справочник.СтруктураПредприятия.ПустаяСсылка");
		
		Если НЕ ЗначениеЗаполнено(ПодчиненнаяСтрока.Подразделение) 
			И ПодчиненнаяСтрока.ОбъемСубподряда = 0 Тогда
			
			ПодчиненнаяСтрока.ОбъемСубподряда = ПодчиненнаяСтрока.ОбъемСобственный;
			ПодчиненнаяСтрока.ОбъемСобственный = 0;
			ПодчиненнаяСтрока.ЕстьСубподряд = Истина;
			
			Если МассивРабот.Найти(ПодчиненнаяСтрока.Работа) = Неопределено Тогда
				МассивРабот.Добавить(ПодчиненнаяСтрока.Работа);
			КонецЕсли;
						
			//ОтметитьСубподрядныеРаботы(ПодчиненнаяСтрока);
		КонецЕсли;
		
		Если ПодчиненнаяСтрока.ПолучитьЭлементы().Количество() Тогда // рекурсия!
			ЗаполнитьСубподрядчикаПоИерархии(ПодчиненнаяСтрока, Контрагент,МассивРабот);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаполненияКонтрагентовДереваРабот(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		МассивРабот = Новый Массив;
		ЗаполнитьСубподрядчикаПоИерархии(ДополнительныеПараметры.СтрокаДерева, ДополнительныеПараметры.Контрагент,МассивРабот);
		ОтметитьСубподрядныеРаботыПоМассивуРабот(МассивРабот,Истина);
		
	КонецЕсли;
	
	ПересчитатьИтогиДереваРабот();
	
КонецПроцедуры

&НаКлиенте
Процедура РаботыКонтрагентПриИзменении(Элемент)
	
	СтрокаДерева = Элементы.ДеревоРаботы.ТекущиеДанные;
	
	Если СтрокаДерева.ПолучитьЭлементы().Количество() Тогда
		ДопПараметры = Новый Структура("СтрокаДерева, Контрагент", СтрокаДерева, СтрокаДерева.Контрагент);
		ПоказатьВопрос(Новый ОписаниеОповещения("ОбработкаЗаполненияКонтрагентовДереваРабот", ЭтаФорма, ДопПараметры)
		, НСтр("ru = 'Заполнить субподрядчика у подчиненных элементов?'")
		, РежимДиалогаВопрос.ДаНет);
	ИначеЕсли ЗначениеЗаполнено(СтрокаДерева.Контрагент) Тогда
		
		Если НЕ ЗначениеЗаполнено(СтрокаДерева.Подразделение) 
			И СтрокаДерева.ОбъемСубподряда = 0 Тогда
			
			СтрокаДерева.ОбъемСубподряда = СтрокаДерева.ОбъемСобственный;
			СтрокаДерева.ОбъемСобственный = 0;
			ОтметитьСубподрядныеРаботы(СтрокаДерева);
			
		КонецЕсли; 
		
		ПересчитатьИтогиДереваРабот();
		
	ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаДерева.Контрагент) Тогда
		
		Если ЗначениеЗаполнено(СтрокаДерева.Подразделение) 
			И СтрокаДерева.ОбъемСобственный = 0 Тогда
			
			СтрокаДерева.ОбъемСобственный = СтрокаДерева.ОбъемСубподряда;
			СтрокаДерева.ОбъемСубподряда = 0;
			ОтметитьСубподрядныеРаботы(СтрокаДерева);
			
		КонецЕсли;
		
		ПересчитатьИтогиДереваРабот(); 
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры  

