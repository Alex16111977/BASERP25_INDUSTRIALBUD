&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТаблицаРаботы    = ПолучитьТаблицуПоДереву("ДеревоРаботы", "Работа", СписокГруппировокДереваРаботы);
	ТаблицаМатериалы = ПолучитьТаблицуПоДереву("ДеревоМатериалы", "ВидНоменклатурыНоменклатураРабота", СписокГруппировокДереваМатериалы);
	ТаблицаРесурсы   = ПолучитьТаблицуПоДереву("ДеревоРесурсы", "РесурсРабота", СписокГруппировокДереваРесурсы);
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Для ТекИндекс = 0 По ТаблицаРаботы.Количество()-1 Цикл
			
			АдресОшибки = НСтр("ru='в строке работы ""%Работа%"" с кодом СДР %КодСДР% списка ""Работы""'");
			АдресОшибки = СтрЗаменить(АдресОшибки, "%Работа%", ТаблицаРаботы[ТекИндекс].Работа);
			АдресОшибки = СтрЗаменить(АдресОшибки, "%КодСДР%", ТаблицаРаботы[ТекИндекс].Работа.КодСДР);
			
			Если НЕ ЗначениеЗаполнено(ТаблицаРаботы[ТекИндекс].Подразделение) И ТаблицаРаботы[ТекИндекс].ОбъемСобственный <> 0 Тогда
				ТекстОшибки = НСтр("ru='Указан объем собственных работ %Колво% и не указано подразделение исполнитель'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Колво%", ТаблицаРаботы[ТекИндекс].ОбъемСобственный);
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					ТекстОшибки + " " + АдресОшибки,
					,
					,//"ДеревоРаботы[" + ТаблицаРаботы[ТекИндекс].ИндексСтрокиДерева + "].Подразделение",
					,
					Отказ);
			ИначеЕсли НЕ ЗначениеЗаполнено(ТаблицаРаботы[ТекИндекс].Контрагент) И ТаблицаРаботы[ТекИндекс].ОбъемСубподряда <> 0 Тогда
				ТекстОшибки = НСтр("ru='Указан объем субподрядных работ %Колво% и не указан исполнитель'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Колво%", ТаблицаРаботы[ТекИндекс].ОбъемСубподряда);
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					ТекстОшибки + " " + АдресОшибки,
					,
					,
					,
					Отказ);
			КонецЕсли;
			
		КонецЦикла;
				
	КонецЕсли;	
	
	Если Не Отказ Тогда
		ТекущийОбъект.Работы.Загрузить(ТаблицаРаботы);
		ТекущийОбъект.Материалы.Загрузить(ТаблицаМатериалы);
		ТекущийОбъект.Ресурсы.Загрузить(ТаблицаРесурсы);
	КонецЕсли;
	
	ОчиститьГруппировкиРабот();
	
	// Обработчик механизма "Свойства"
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
	
	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

