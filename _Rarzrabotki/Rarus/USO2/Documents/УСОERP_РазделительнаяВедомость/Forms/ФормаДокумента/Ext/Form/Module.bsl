	Элементы.ГруппаМатериалыПоИсполнителям.Видимость = ВидГруппировки = 1;
	Элементы.ГруппаМатериалы.Видимость = ВидГруппировки = 0;
	Элементы.ГруппаРесурсы.Видимость = ВидГруппировки = 0;
	Элементы.ГруппаРесурсыПоИсполнителям.Видимость = ВидГруппировки = 1;
	
	
КонецПроцедуры

