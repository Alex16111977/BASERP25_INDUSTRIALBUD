	|		КОГДА ВрТабРабот.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ТОГДА ВрТабРабот.Контрагент
	|		ИНАЧЕ ВрТабРабот.Подразделение
	|	КОНЕЦ КАК Исполнитель,
	|	ВрТабРесурсы.Работа КАК Работа,
	|	ВрТабРесурсы.Работа.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ВрТабРесурсы.Работа.ДатаНачала КАК ДатаНачала,
	|	ВрТабРесурсы.Работа.ДатаОкончания КАК ДатаОкончания,
	|	ВрТабРесурсы.Работа.ОбъемРаботы КАК Объем,
	|	ВрТабРесурсы.Ресурс КАК Ресурс,
	|	ВрТабРесурсы.КоличествоСобственное КАК КоличествоСобственное,
	|	ВрТабРесурсы.КоличествоСубподряда КАК КоличествоСубподряда,
	|	ВрТабРесурсы.КоличествоСобственное + ВрТабРесурсы.КоличествоСубподряда КАК Количество
	|ИЗ
	|	ВрТабРабот КАК ВрТабРабот
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВрТабРесурсы КАК ВрТабРесурсы
	|		ПО ВрТабРабот.Работа = ВрТабРесурсы.Работа
	|ГДЕ
	|	НЕ ВрТабРабот.Работа.СуммарнаяРабота
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВрТабРабот.Работа.ПорядокСортировки
	|ИТОГИ ПО
	|	Исполнитель,
	|	Работа";
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	Если ЗаполнятьРаботы Тогда
		
		ДеревоРаботыЗапрос = ПакетЗапросов[1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		
		ДеревоРаботыЗначение = РеквизитФормыВЗначение("ДеревоРаботы");
		ДеревоРаботыЗначение.Строки.Очистить();
		
		Для Каждого СтрокаЗапроса ИЗ ДеревоРаботыЗапрос.Строки Цикл
			СтрокаДерева = ДеревоРаботыЗначение.Строки.Добавить();
			ВывестиДеревоРаботы(СтрокаЗапроса,СтрокаДерева);
		КонецЦикла;
		
		ЗначениеВРеквизитФормы(ДеревоРаботыЗначение, "ДеревоРаботы");
		
	КонецЕсли;
	
	Если ЗаполнятьМатериалы Тогда
		
		ДеревоМатериалыЗначение = РеквизитФормыВЗначение("ДеревоМатериалы");
