&НаКлиенте
Процедура СценарийПланированияПриИзменении(Элемент)
	
	Если (ЗначениеЗаполнено(ТекущийСценарий) И Объект.СценарийПланирования <> ТекущийСценарий) ИЛИ (ЗначениеЗаполнено(ТекущийДокументУтверждения) И Объект.ДокументУтверждения <> ТекущийДокументУтверждения) И  ДеревоРаботы.ПолучитьЭлементы().Количество() Тогда
		
		ТекстВопроса = НСтр("ru = 'Табличные части работ, материалов и ресурсов будут очищены. Продолжить?'");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("СценарийПланированияПриИзмененииПродолжение",ЭтотОбъект),ТекстВопроса,РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		СценарийПланированияПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура СценарийПланированияПриИзмененииПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Объект.СценарийПланирования = ТекущийСценарий;
		Объект.ДокументУтверждения   = ТекущийДокументУтверждения;
		Возврат;
	КонецЕсли;
	
	Объект.Работы.Очистить();
	Объект.Материалы.Очистить();
	Объект.Ресурсы.Очистить();
	ДеревоМатериалы.ПолучитьЭлементы().Очистить();
	ДеревоРаботы.ПолучитьЭлементы().Очистить();
	ДеревоРесурсы.ПолучитьЭлементы().Очистить();
	
	ТекущийСценарий = Объект.СценарийПланирования;
	ТекущийДокументУтверждения = Объект.ДокументУтверждения; 
	
	НовыйВариант = ЭтоНовыйВариант(Объект.СценарийПланирования);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоНовыйВариант(Сценарий)
	Возврат Сценарий.НовыйВариант;
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПоДокументу(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПоДокументуПродолжение",ЭтотОбъект);
	ОтборФормы = Новый Структура("ОбъектСтроительства,Проведен,СценарийПланирования,Статус",Объект.ОбъектСтроительства,Истина,Объект.СценарийПланирования,ПредопределенноеЗначение("Перечисление.СтатусыПланов.Утвержден"));
	ДопПараметры = Новый Структура("Отбор",ОтборФормы);
	ОткрытьФорму("Документ.УСОERP_РазделительнаяВедомость.Форма.ФормаВыбора",ДопПараметры,ЭтотОбъект,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДокументуПродолжение(ВыбранноеЗначение,ДопПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоДокументуНаСервере(ВыбранноеЗначение);
	ПересчитатьИтогиДереваРабот();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументуНаСервере(ДокументЗаполнения)
	
	Если Модифицированность Тогда
		
		ТаблицаРаботы    = ПолучитьТаблицуПоДереву("ДеревоРаботы", "Работа", СписокГруппировокДереваРаботы);
		ТаблицаМатериалы = ПолучитьТаблицуПоДереву("ДеревоМатериалы", "ВидНоменклатурыНоменклатураРабота", СписокГруппировокДереваМатериалы);
		ТаблицаРесурсы   = ПолучитьТаблицуПоДереву("ДеревоРесурсы", "РесурсРабота", СписокГруппировокДереваРесурсы);
		
		Объект.Работы.Загрузить(ТаблицаРаботы);
		Объект.Материалы.Загрузить(ТаблицаМатериалы);
		Объект.Ресурсы.Загрузить(ТаблицаРесурсы);
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДокументЗаполнения",ДокументЗаполнения);
	Запрос.УстановитьПараметр("ТабРаботы",Объект.Работы.Выгрузить());
	Запрос.УстановитьПараметр("ТабМатериалы",Объект.Материалы.Выгрузить());
	Запрос.УстановитьПараметр("ТабРесурсы",Объект.Ресурсы.Выгрузить());
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_РазделительнаяВедомостьРаботы.Работа КАК Работа,
	|	УСОERP_РазделительнаяВедомостьРаботы.Подразделение КАК Подразделение,
	|	УСОERP_РазделительнаяВедомостьРаботы.Контрагент КАК Контрагент,
	|	УСОERP_РазделительнаяВедомостьРаботы.ОбъемСобственный КАК ОбъемСобственный,
	|	УСОERP_РазделительнаяВедомостьРаботы.ОбъемСубподряда КАК ОбъемСубподряда,
	|	УСОERP_РазделительнаяВедомостьРаботы.ЦенаЗаказчика КАК ЦенаЗаказчика,
	|	УСОERP_РазделительнаяВедомостьРаботы.ЦенаПодрядчикаКоэффициент КАК ЦенаПодрядчикаКоэффициент,
	|	УСОERP_РазделительнаяВедомостьРаботы.ЦенаПодрядчикаЦена КАК ЦенаПодрядчикаЦена,
	|	УСОERP_РазделительнаяВедомостьРаботы.ЦенаПодрядчикаРазность КАК ЦенаПодрядчикаРазность
	|ПОМЕСТИТЬ ВрТабРаботы
	|ИЗ
	|	Документ.УСОERP_РазделительнаяВедомость.Работы КАК УСОERP_РазделительнаяВедомостьРаботы
	|ГДЕ
	|	УСОERP_РазделительнаяВедомостьРаботы.Ссылка = &ДокументЗаполнения
	|	И НЕ УСОERP_РазделительнаяВедомостьРаботы.Работа.СуммарнаяРабота
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_РазделительнаяВедомостьМатериалы.Работа КАК Работа,
	|	УСОERP_РазделительнаяВедомостьМатериалы.Номенклатура КАК Номенклатура,
	|	УСОERP_РазделительнаяВедомостьМатериалы.Характеристика КАК Характеристика,
	|	УСОERP_РазделительнаяВедомостьМатериалы.КоличествоСобственное КАК КоличествоСобственное,
	|	УСОERP_РазделительнаяВедомостьМатериалы.КоличествоСубподряда КАК КоличествоСубподряда
	|ПОМЕСТИТЬ ВрТабМатериалы
	|ИЗ
	|	Документ.УСОERP_РазделительнаяВедомость.Материалы КАК УСОERP_РазделительнаяВедомостьМатериалы
	|ГДЕ
	|	УСОERP_РазделительнаяВедомостьМатериалы.Ссылка = &ДокументЗаполнения
	|	И НЕ УСОERP_РазделительнаяВедомостьМатериалы.Работа.СуммарнаяРабота
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_РазделительнаяВедомостьРесурсы.Работа КАК Работа,
	|	УСОERP_РазделительнаяВедомостьРесурсы.Ресурс КАК Ресурс,
	|	УСОERP_РазделительнаяВедомостьРесурсы.КоличествоСобственное КАК КоличествоСобственное,
	|	УСОERP_РазделительнаяВедомостьРесурсы.КоличествоСубподряда КАК КоличествоСубподряда
	|ПОМЕСТИТЬ ВрТабРесурсы
	|ИЗ
	|	Документ.УСОERP_РазделительнаяВедомость.Ресурсы КАК УСОERP_РазделительнаяВедомостьРесурсы
	|ГДЕ
	|	УСОERP_РазделительнаяВедомостьРесурсы.Ссылка = &ДокументЗаполнения
	|	И НЕ УСОERP_РазделительнаяВедомостьРесурсы.Работа.СуммарнаяРабота
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТабРаботы.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	ТабРаботы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТабРаботы.Контрагент КАК Контрагент,
	|	ТабРаботы.Подразделение КАК Подразделение,
	|	ТабРаботы.ОбъемСобственный КАК ОбъемСобственный,
	|	ТабРаботы.ОбъемСубподряда КАК ОбъемСубподряда,
	|	ТабРаботы.НачалоПериода КАК НачалоПериода,
	|	ТабРаботы.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ТабРаботы.СуммарнаяРабота КАК СуммарнаяРабота,
	|	ТабРаботы.ЦенаЗаказчика КАК ЦенаЗаказчика,
	|	ТабРаботы.ЦенаПодрядчикаЦена КАК ЦенаПодрядчикаЦена,
	|	ТабРаботы.ЦенаПодрядчикаКоэффициент КАК ЦенаПодрядчикаКоэффициент,
	|	ТабРаботы.ЦенаПодрядчикаРазность КАК ЦенаПодрядчикаРазность
	|ПОМЕСТИТЬ ТабРаботы
	|ИЗ
	|	&ТабРаботы КАК ТабРаботы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабРаботы.Работа КАК Работа,
	|	ТабРаботы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТабРаботы.НачалоПериода КАК НачалоПериода,
	|	ТабРаботы.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ТабРаботы.СуммарнаяРабота КАК СуммарнаяРабота,
	|	ЕСТЬNULL(ВрТабРаботы.Подразделение, ТабРаботы.Подразделение) КАК Подразделение,
	|	ЕСТЬNULL(ВрТабРаботы.Контрагент, ТабРаботы.Контрагент) КАК Контрагент,
	|	ЕСТЬNULL(ВрТабРаботы.ОбъемСобственный, ТабРаботы.ОбъемСобственный) КАК ОбъемСобственный,
	|	ЕСТЬNULL(ВрТабРаботы.ОбъемСубподряда, ТабРаботы.ОбъемСубподряда) КАК ОбъемСубподряда,
	|	ЕСТЬNULL(ВрТабРаботы.ЦенаЗаказчика, ТабРаботы.ЦенаЗаказчика) КАК ЦенаЗаказчика,
	|	ЕСТЬNULL(ВрТабРаботы.ЦенаПодрядчикаКоэффициент, ТабРаботы.ЦенаПодрядчикаКоэффициент) КАК ЦенаПодрядчикаКоэффициент,
	|	ЕСТЬNULL(ВрТабРаботы.ЦенаПодрядчикаЦена, ТабРаботы.ЦенаПодрядчикаЦена) КАК ЦенаПодрядчикаЦена
	|ИЗ
	|	ТабРаботы КАК ТабРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТабРаботы КАК ВрТабРаботы
	|		ПО ТабРаботы.Работа.РаботаИсточник = ВрТабРаботы.Работа.РаботаИсточник
	|			И ТабРаботы.Работа.ОбъемРаботы = ВрТабРаботы.Работа.ОбъемРаботы
	|			И ТабРаботы.Работа.ЕдиницаОбъема = ВрТабРаботы.Работа.ЕдиницаОбъема
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТабМатериалы.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	ТабМатериалы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТабМатериалы.Номенклатура КАК Номенклатура,
	|	ТабМатериалы.Характеристика КАК Характеристика,
	|	ТабМатериалы.НачалоПериода КАК НачалоПериода,
	|	ТабМатериалы.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ТабМатериалы.КоличествоСобственное КАК КоличествоСобственное,
	|	ТабМатериалы.КоличествоСубподряда КАК КоличествоСубподряда,
	|	ТабМатериалы.СуммарнаяРабота КАК СуммарнаяРабота
	|ПОМЕСТИТЬ ТабМатериалы
	|ИЗ
	|	&ТабМатериалы КАК ТабМатериалы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабМатериалы.Работа КАК Работа,
	|	ТабМатериалы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТабМатериалы.Номенклатура КАК Номенклатура,
	|	ТабМатериалы.Характеристика КАК Характеристика,
	|	ТабМатериалы.НачалоПериода КАК НачалоПериода,
	|	ТабМатериалы.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ТабМатериалы.СуммарнаяРабота КАК СуммарнаяРабота,
	|	ЕСТЬNULL(ВрТабМатериалы.КоличествоСобственное, ТабМатериалы.КоличествоСобственное) КАК КоличествоСобственное,
	|	ЕСТЬNULL(ВрТабМатериалы.КоличествоСубподряда, ТабМатериалы.КоличествоСубподряда) КАК КоличествоСубподряда
	|ИЗ
	|	ТабМатериалы КАК ТабМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТабМатериалы КАК ВрТабМатериалы
	|		ПО ТабМатериалы.Работа.РаботаИсточник = ВрТабМатериалы.Работа.РаботаИсточник
	|			И ТабМатериалы.Работа.ЕдиницаОбъема = ВрТабМатериалы.Работа.ЕдиницаОбъема
	|			И ТабМатериалы.Работа.ОбъемРаботы = ВрТабМатериалы.Работа.ОбъемРаботы
	|			И ТабМатериалы.Номенклатура = ВрТабМатериалы.Номенклатура
	|			И ТабМатериалы.Характеристика = ВрТабМатериалы.Характеристика
	|			И (ТабМатериалы.КоличествоСобственное + ТабМатериалы.КоличествоСубподряда = ВрТабМатериалы.КоличествоСобственное + ВрТабМатериалы.КоличествоСубподряда)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТабРесурсы.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	ТабРесурсы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТабРесурсы.Ресурс КАК Ресурс,
	|	ТабРесурсы.НачалоПериода КАК НачалоПериода,
	|	ТабРесурсы.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ТабРесурсы.СуммарнаяРабота КАК СуммарнаяРабота,
	|	ТабРесурсы.КоличествоСобственное КАК КоличествоСобственное,
	|	ТабРесурсы.КоличествоСубподряда КАК КоличествоСубподряда
	|ПОМЕСТИТЬ ТабРесурсы
	|ИЗ
	|	&ТабРесурсы КАК ТабРесурсы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабРесурсы.Работа КАК Работа,
	|	ТабРесурсы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТабРесурсы.Ресурс КАК Ресурс,
	|	ТабРесурсы.НачалоПериода КАК НачалоПериода,
	|	ТабРесурсы.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ТабРесурсы.СуммарнаяРабота КАК СуммарнаяРабота,
	|	ЕСТЬNULL(ВрТабРесурсы.КоличествоСобственное, ТабРесурсы.КоличествоСобственное) КАК КоличествоСобственное,
	|	ЕСТЬNULL(ВрТабРесурсы.КоличествоСубподряда, ТабРесурсы.КоличествоСубподряда) КАК КоличествоСубподряда
	|ИЗ
	|	ТабРесурсы КАК ТабРесурсы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТабРесурсы КАК ВрТабРесурсы
	|		ПО ТабРесурсы.Работа.РаботаИсточник = ВрТабРесурсы.Работа.РаботаИсточник
	|			И ТабРесурсы.Работа.ЕдиницаОбъема = ВрТабРесурсы.Работа.ЕдиницаОбъема
	|			И ТабРесурсы.Работа.ОбъемРаботы = ВрТабРесурсы.Работа.ОбъемРаботы
	|			И ТабРесурсы.Ресурс = ВрТабРесурсы.Ресурс
	|			И (ТабРесурсы.КоличествоСобственное + ТабРесурсы.КоличествоСубподряда = ВрТабРесурсы.КоличествоСобственное + ВрТабРесурсы.КоличествоСубподряда)";	
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	Объект.Работы.Загрузить(ПакетЗапросов[4].Выгрузить());
	Для Каждого СтрокаРаботы ИЗ Объект.Работы Цикл
		СтрокаРаботы.ЦенаПодрядчикаРазность = СтрокаРаботы.ЦенаПодрядчикаЦена-СтрокаРаботы.ЦенаЗаказчика;
	КонецЦикла;
	
	ДеревоРаботы.ПолучитьЭлементы().Очистить();
	
	Объект.Материалы.Загрузить(ПакетЗапросов[6].Выгрузить());
	ДеревоМатериалы.ПолучитьЭлементы().Очистить();
	
	Объект.Ресурсы.Загрузить(ПакетЗапросов[8].Выгрузить());
	ДеревоРесурсы.ПолучитьЭлементы().Очистить();
	
	ЗаполнитьДанныеФормыИзОбъекта();  
	
	Модифицированность = Истина;
	
КонецПроцедуры  

