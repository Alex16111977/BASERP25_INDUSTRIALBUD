#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстЗапросаТаблицаРазделительнаяВедомостьРаботы(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаРазделительнаяВедомостьМатериалы(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаРазделительнаяВедомостьРесурсы(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаУСОERP_ЦенаПодрядчикаВРазделительнойВедомости(Запрос, ТекстыЗапроса, Регистры);
	//ТекстыЗапроса.Добавить(ТекстЗапросаТаблицаРазделительнаяВедомостьРаботы(), "ТаблицаРазделительнаяВедомостьРаботы");
	//ТекстыЗапроса.Добавить(ТекстЗапросаТаблицаРазделительнаяВедомостьМатериалы(), "ТаблицаРазделительнаяВедомостьМатериалы");
	//ТекстыЗапроса.Добавить(ТекстЗапросаТаблицаРазделительнаяВедомостьРесурсы(), "ТаблицаРазделительнаяВедомостьРесурсы");
	//ТекстыЗапроса.Добавить(ТекстЗапросаТаблицаУСОERP_ЦенаПодрядчикаВРазделительнойВедомости(),"ТаблицаУСОERP_ЦенаПодрядчикаВРазделительнойВедомости");
	
	////////////////////////////////////////////////////////////////////////////
	// Выполним запрос и поместим результаты запроса в дополнительные свойства
	
	ПроведениеСерверУТ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений,Истина);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеДокумента.Дата КАК Период,
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.ОбъектСтроительства КАК ОбъектСтроительства
	|ИЗ
	|	Документ.УСОERP_РазделительнаяВедомость КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Результат = Запрос.Выполнить();
	Реквизиты = Результат.Выбрать();
	Реквизиты.Следующий();
	
	////////////////////////////////////////////////////////////////////////////
	// Уставноим параметры запроса
	
	Для Каждого Колонка из Результат.Колонки Цикл
		Запрос.УстановитьПараметр(Колонка.Имя, Реквизиты[Колонка.Имя]);
	КонецЦикла;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

КонецПроцедуры

Функция ТекстЗапросаТаблицаРазделительнаяВедомостьРаботы(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "УСОERP_РазделительнаяВедомостьРаботы";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаДокумента.НомерСтроки КАК НомерСтроки,
	|	&Период КАК Период,
	|	&Период КАК ДатаРегистратора,
	|	&ОбъектСтроительства КАК ОбъектСтроительства,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|			ТОГДА ТаблицаДокумента.Работа
	|		ИНАЧЕ ТаблицаДокумента.Работа.РаботаИсточник
	|	КОНЕЦ КАК Работа,
	|	ТаблицаДокумента.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТаблицаДокумента.Подразделение КАК Подразделение,
	|	ТаблицаДокумента.Контрагент КАК Контрагент,
	|	СУММА(ТаблицаДокумента.ОбъемСобственный) КАК ОбъемСобственный,
	|	СУММА(ТаблицаДокумента.ОбъемСубподряда) КАК ОбъемСубподряда
	|ИЗ
	|	Документ.УСОERP_РазделительнаяВедомость.Работы КАК ТаблицаДокумента
	|ГДЕ
	|	(ТаблицаДокумента.ОбъемСобственный <> 0
	|			ИЛИ ТаблицаДокумента.ОбъемСубподряда <> 0)
	|	И ТаблицаДокумента.Ссылка = &Ссылка
	|	И НЕ ТаблицаДокумента.Работа.СуммарнаяРабота
	|	И ТаблицаДокумента.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДокумента.НомерСтроки,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|			ТОГДА ТаблицаДокумента.Работа
	|		ИНАЧЕ ТаблицаДокумента.Работа.РаботаИсточник
	|	КОНЕЦ,
	|	ТаблицаДокумента.ЕдиницаОбъема,
	|	ТаблицаДокумента.Подразделение,
	|	ТаблицаДокумента.Контрагент
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	
	ТекстыЗапроса.Добавить(ТекстЗапроса,"ТаблицаРазделительнаяВедомостьРаботы");

	Возврат ТекстЗапроса;
	
КонецФункции

