Функция ТекстЗапросаТаблицаУСОERP_ЦенаПодрядчикаВРазделительнойВедомости(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "УСОERP_ЦенаПодрядчикаВРазделительнойВедомости";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;   
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ТаблицаДокумента.Ссылка.ОбъектСтроительства КАК ОбъектСтроительства,
	|	ТаблицаДокумента.Ссылка.СценарийПланирования КАК СценарийПланирования,
	|	ТаблицаДокумента.Работа КАК Работа,
	|	ТаблицаДокумента.Контрагент КАК Контрагент,
	|	ТаблицаДокумента.Ссылка.ДокументУтверждения КАК ДокументУтверждения,
	|	ТаблицаДокумента.Ссылка.Организация КАК Организация,
	|	ТаблицаДокумента.ЦенаПодрядчикаЦена КАК ЦенаПодрядчика
	|ИЗ
	|	Документ.УСОERP_РазделительнаяВедомость.Работы КАК ТаблицаДокумента
	|ГДЕ
	|	ТаблицаДокумента.Ссылка = &Ссылка
	|	И ТаблицаДокумента.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|	И ТаблицаДокумента.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	И НЕ ТаблицаДокумента.Работа.СуммарнаяРабота
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаДокумента.НомерСтроки"; 	

    ТекстыЗапроса.Добавить(ТекстЗапроса,"ТаблицаУСОERP_ЦенаПодрядчикаВРазделительнойВедомости");

	Возврат ТекстЗапроса;  
	
КонецФункции

