Процедура ОтправитьЭД(Команда)
	
	Элементы.КомандаОтправить.Доступность = Ложь;
	
	ПодключитьОбработчикОжидания("ОтправитьПакетыЭД", 0.1, Истина);
	
КонецПроцедуры

