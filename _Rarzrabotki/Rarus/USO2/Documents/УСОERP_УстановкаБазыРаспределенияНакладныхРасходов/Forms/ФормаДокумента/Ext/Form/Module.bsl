#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НаправлениеДеятельностиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Форма = ПолучитьФорму("Справочник.НаправленияДеятельности.Форма.ФормаВыбора",, Элемент);
	
	ГруппаОтбора = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Форма.Список.Отбор.Элементы, , ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, "ДополнительныеРеквизиты.Значение", Истина, ВидСравненияКомпоновкиДанных.Равно,,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, "ДополнительныеРеквизиты.Свойство", ПредопределенноеЗначение("ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.УСОERP_РаспределяемыеЗатраты"), ВидСравненияКомпоновкиДанных.Равно,,Истина);

	//ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.Список,"ДополнительныеРеквизиты.Свойство",Истина,ВидСравненияКомпоновкиДанных.Равно,,Истина);
	
	Форма.Открыть();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыБазаРаспределения

&НаКлиенте
Процедура БазаРаспределенияНаправлениеДеятельностиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка =  Ложь;
	СписокНаправлений = ПолучитьСписокДоступныхНаправлений();
	ФормаВыбора = ПолучитьФорму("Справочник.НаправленияДеятельности.Форма.ФормаВыбора", , Элемент);
	//ОбщегоНазначенияКлиентСЕрвер.УстановитьЭлементОтбораДинамическогоСписка(ФормаВыбора.Список, "ДополнительныеРеквизиты.Свойство", ПредопределенноеЗначение("ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.УСОERP_РаспределяемыеЗатраты"), ВидСравненияКомпоновкиДанных.Равно,,Истина);
	//ОбщегоНазначенияКлиентСЕрвер.УстановитьЭлементОтбораДинамическогоСписка(ФормаВыбора.Список, "ДополнительныеРеквизиты.Значение", Ложь, ВидСравненияКомпоновкиДанных.НеРавно,,Истина);
	ОбщегоНазначенияКлиентСЕрвер.УстановитьЭлементОтбораДинамическогоСписка(ФормаВыбора.Список, "Ссылка",СписокНаправлений, ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
	ФормаВыбора.открыть();
	//
КонецПроцедуры

#КонецОбласти

&НаСервереБезКонтекста
Функция ПолучитьСписокДоступныхНаправлений()
	
	Запрос = Новый Запрос;

	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НаправленияДеятельностиДополнительныеРеквизиты.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	Справочник.НаправленияДеятельности.ДополнительныеРеквизиты КАК НаправленияДеятельностиДополнительныеРеквизиты
	|ГДЕ
	|	НаправленияДеятельностиДополнительныеРеквизиты.Значение = ИСТИНА
	|	И НаправленияДеятельностиДополнительныеРеквизиты.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.УСОERP_РаспределяемыеЗатраты)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НаправленияДеятельности.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.НаправленияДеятельности КАК НаправленияДеятельности
	|ГДЕ
	|	НЕ НаправленияДеятельности.Ссылка В
	|				(ВЫБРАТЬ
	|					ВрТаб.Ссылка
	|				ИЗ
	|					ВрТаб)
	|	И НаправленияДеятельности.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыНаправленияДеятельности.Используется)";
	
	СписокВозврата = Новый СписокЗначений;
	СписокВозврата.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	Возврат СписокВозврата;
	
КонецФункции

