&НаКлиенте
Процедура ЗаполнитьПоОстаткам(Команда)
	
	Если Объект.БазаРаспределения.Количество() > 0 Тогда
		Ответ = Неопределено;		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьПоОстаткамЗавершение", ЭтотОбъект), НСтр("ru = 'Перед заполнением табличная часть будет очищена. Продолжить?'"), РежимДиалогаВопрос.ДаНет);			
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоОстаткамНаСервере();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОстаткамНаСервере()
	
	Объект.БазаРаспределения.Очистить();
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто1 КАК Справочник.ОбъектыЭксплуатации) КАК ОбъектЭксплуатации,
		|	ХозрасчетныйОстатки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ ВТ_ОстаткиПоОбъектам
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(&КонецПериода, Счет В ИЕРАРХИИ (&СчетУчета), &ВидСубконто, Организация = &Организация) КАК ХозрасчетныйОстатки
		|ГДЕ
		|	ХозрасчетныйОстатки.СуммаОстаток <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	АУН_ОбъектыНедвижимости.Ссылка КАК ОбъектНедвижимости,
		|	ВТ_ОстаткиПоОбъектам.ОбъектЭксплуатации.НаправлениеДеятельности КАК НаправлениеДеятельности,
		|	УПН_ПлощадиОбъектовНедвижимостиСрезПоследних.ОбщаяПлощадь КАК ПараметрРаспределения,
		|	ВТ_ОстаткиПоОбъектам.ОбъектЭксплуатации
		|ПОМЕСТИТЬ ВТ_ОбъектыНедвижимости
		|ИЗ
		|	ВТ_ОстаткиПоОбъектам КАК ВТ_ОстаткиПоОбъектам
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.АУН_ОбъектыНедвижимости КАК АУН_ОбъектыНедвижимости
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УПН_ПлощадиОбъектовНедвижимости.СрезПоследних(&КонецПериода, ) КАК УПН_ПлощадиОбъектовНедвижимостиСрезПоследних
		|			ПО АУН_ОбъектыНедвижимости.Ссылка = УПН_ПлощадиОбъектовНедвижимостиСрезПоследних.ОбъектНедвижимости
		|		ПО ВТ_ОстаткиПоОбъектам.ОбъектЭксплуатации = АУН_ОбъектыНедвижимости.ОбъектЭксплуатации
		|ГДЕ
		|	АУН_ОбъектыНедвижимости.КатегорияОбъекта = &Здания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ОбъектыНедвижимости.НаправлениеДеятельности КАК НаправлениеДеятельности,
		|	ВТ_ОбъектыНедвижимости.ПараметрРаспределения КАК ПараметрРаспределения,
		|	ЕСТЬNULL(ВложенныйЗапрос.Значение, ЛОЖЬ) КАК РаспределяемыеЗатраты
		|ИЗ
		|	ВТ_ОбъектыНедвижимости КАК ВТ_ОбъектыНедвижимости
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			НаправленияДеятельностиДополнительныеРеквизиты.Ссылка КАК Ссылка,
		|			НаправленияДеятельностиДополнительныеРеквизиты.Значение КАК Значение
		|		ИЗ
		|			Справочник.НаправленияДеятельности.ДополнительныеРеквизиты КАК НаправленияДеятельностиДополнительныеРеквизиты
		|		ГДЕ
		|			НаправленияДеятельностиДополнительныеРеквизиты.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.УСОERP_РаспределяемыеЗатраты)) КАК ВложенныйЗапрос
		|		ПО ВТ_ОбъектыНедвижимости.НаправлениеДеятельности = ВложенныйЗапрос.Ссылка
		|ГДЕ
		|	НЕ ЕСТЬNULL(ВТ_ОбъектыНедвижимости.ПараметрРаспределения, 0) = 0
		|	И ЕСТЬNULL(ВложенныйЗапрос.Значение, ЛОЖЬ) = ЛОЖЬ
		|	И ЕСТЬNULL(ВТ_ОбъектыНедвижимости.НаправлениеДеятельности, ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ОбъектыНедвижимости.НаправлениеДеятельности,
		|	ВТ_ОбъектыНедвижимости.ПараметрРаспределения,
		|	ЕСТЬNULL(ВложенныйЗапрос.Значение, ЛОЖЬ)";
	
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("СчетУчета", Справочники.УСОERP_ПредопределенныеЭлементы.СчетУчетаОбъектовНедвижимости.Значение);
	Запрос.УстановитьПараметр("ВидСубконто", ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ОбъектыСтроительства);
	Запрос.УстановитьПараметр("Здания", Перечисления.АУН_КатегорииОбъектовНедвижимости.Здание);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Объект.БазаРаспределения.Загрузить(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОстаткамЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоОстаткамНаСервере();
		Модифицированность = Истина;
	Конецесли;    
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрРаспределения(Команда)
	
	ЗаполнитьПараметрРаспределенияНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрРаспределенияНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбъектыЭксплуатации.Ссылка КАК ОбъектЭксплуатации,
	|	ОбъектыЭксплуатации.НаправлениеДеятельности
	|ПОМЕСТИТЬ ВТ_ОбъектыЭксплуатации
	|ИЗ
	|	Справочник.ОбъектыЭксплуатации КАК ОбъектыЭксплуатации
	|ГДЕ
	|	НЕ ОбъектыЭксплуатации.ПометкаУдаления
	|	И ОбъектыЭксплуатации.НаправлениеДеятельности В(&НаправленияДеятельности)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АУН_ОбъектыНедвижимости.Ссылка КАК ОбъектНедвижимости,
	|	ВТ_ОбъектыЭксплуатации.ОбъектЭксплуатации,
	|	ВТ_ОбъектыЭксплуатации.НаправлениеДеятельности,
	|	УПН_ПлощадиОбъектовНедвижимостиСрезПоследних.ОбщаяПлощадь КАК ПараметрРаспределения
	|ПОМЕСТИТЬ ВТ_ПлощадиОбъектов
	|ИЗ
	|	ВТ_ОбъектыЭксплуатации КАК ВТ_ОбъектыЭксплуатации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.АУН_ОбъектыНедвижимости КАК АУН_ОбъектыНедвижимости
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УПН_ПлощадиОбъектовНедвижимости.СрезПоследних(&КонецПериода, ) КАК УПН_ПлощадиОбъектовНедвижимостиСрезПоследних
	|			ПО АУН_ОбъектыНедвижимости.Ссылка = УПН_ПлощадиОбъектовНедвижимостиСрезПоследних.ОбъектНедвижимости
	|		ПО ВТ_ОбъектыЭксплуатации.ОбъектЭксплуатации = АУН_ОбъектыНедвижимости.ОбъектЭксплуатации
	|ГДЕ
	|	АУН_ОбъектыНедвижимости.КатегорияОбъекта = &Здания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПлощадиОбъектов.НаправлениеДеятельности,
	|	ВТ_ПлощадиОбъектов.ПараметрРаспределения
	|ИЗ
	|	ВТ_ПлощадиОбъектов КАК ВТ_ПлощадиОбъектов
	|ГДЕ
	|	НЕ ЕСТЬNULL(ВТ_ПлощадиОбъектов.ПараметрРаспределения, 0) = 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПлощадиОбъектов.НаправлениеДеятельности,
	|	ВТ_ПлощадиОбъектов.ПараметрРаспределения";
	
	Запрос.УстановитьПараметр("НаправленияДеятельности", Объект.БазаРаспределения.Выгрузить().ВыгрузитьКолонку("НаправлениеДеятельности"));
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Здания", Перечисления.АУН_КатегорииОбъектовНедвижимости.Здание);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрТЗ Из Объект.БазаРаспределения Цикл
		СтруктураПоиска = Новый Структура("НаправлениеДеятельности", СтрТЗ.НаправлениеДеятельности);
		МассивСтрок = Результат.НайтиСтроки(СтруктураПоиска);
		Если МассивСтрок.Количество() > 0 Тогда
			СтрТЗ.ПараметрРаспределения = МассивСтрок[0].ПараметрРаспределения;
		Иначе
			СтрТЗ.ПараметрРаспределения = 0;
		КонецЕсли;		
	КонецЦикла;
	
	
КонецПроцедуры

