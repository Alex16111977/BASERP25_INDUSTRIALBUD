Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_УстановкаБазыРаспределенияНакладныхРасходов.Ссылка
	|ИЗ
	|	Документ.УСОERP_УстановкаБазыРаспределенияНакладныхРасходов КАК УСОERP_УстановкаБазыРаспределенияНакладныхРасходов
	|ГДЕ
	|	УСОERP_УстановкаБазыРаспределенияНакладныхРасходов.Проведен
	|	И УСОERP_УстановкаБазыРаспределенияНакладныхРасходов.Организация = &Организация
	|	И УСОERP_УстановкаБазыРаспределенияНакладныхРасходов.НаправлениеДеятельности = &НаправлениеДеятельности
	|	И КОНЕЦПЕРИОДА(УСОERP_УстановкаБазыРаспределенияНакладныхРасходов.Дата, МЕСЯЦ) = КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)
	|	И НЕ УСОERP_УстановкаБазыРаспределенияНакладныхРасходов.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НаправлениеДеятельности", НаправлениеДеятельности);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для направления деятельности """ + НаправлениеДеятельности + """ в текущем месяце уже введена установка базы распределения:" +
		Символы.ПС + " - " + Выборка.Ссылка);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	
	ПроведениеСерверУТ.УстановитьРежимПроведения(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);

	Документы.УСОERP_УстановкаБазыРаспределенияНакладныхРасходов.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);

	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

	ОтразитьУстановкуБазыРаспределения(ДополнительныеСвойства, Движения, Отказ);
	
	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);

	ПроведениеСерверУТ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры

