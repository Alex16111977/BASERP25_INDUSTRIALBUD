#Область СлужебныеПроцедурыИФункции

Функция ДанныеДляПроведения()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ДатаСреза", Новый Граница(КонецДня(Ссылка.ДатаВерсииПлана), ВидГраницы.Включая));
	
	                      
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_АктуализацияПланаРаботы.Работа КАК СтроительнаяРабота,
	|	ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыПланированияСтроительныхРабот.Календарный) КАК ВидПланирования,
	|	УСОERP_АктуализацияПланаРаботы.ОбъемРаботы,
	|	УСОERP_АктуализацияПланаРаботы.ЕдиницаОбъема,
	|	УСОERP_АктуализацияПланаРаботы.НачалоРаботыПлан,
	|	УСОERP_АктуализацияПланаРаботы.ОкончаниеРаботыПлан,
	|	УСОERP_АктуализацияПланаРаботы.ДлительностьПлан,
	|	УСОERP_АктуализацияПланаРаботы.ЕдиницаДлительности,
	|	УСОERP_АктуализацияПланаРаботы.Ссылка.Ответственный КАК АвторИзменения,
	|	УСОERP_АктуализацияПланаРаботы.СуммарнаяРабота,
	|	УСОERP_АктуализацияПланаРаботы.ОбъемРаботыВыполненный,
	|	УСОERP_АктуализацияПланаРаботы.НачалоРаботыПослеПересчета,
	|	УСОERP_АктуализацияПланаРаботы.ОкончаниеРаботыПослеПересчета,
	|	УСОERP_АктуализацияПланаРаботы.ОкончаниеРаботыПослеПересчета2,
	|	УСОERP_АктуализацияПланаРаботы.ДатаВыполнения,
	|	УСОERP_АктуализацияПланаРаботы.ДлительностьПослеПересчета,
	|	УСОERP_АктуализацияПланаРаботы.ТипОграничения,
	|	УСОERP_АктуализацияПланаРаботы.ДатаОграничения,
	|	УСОERP_АктуализацияПланаРаботы.ДлительностьПослеРастягивания
	|ИЗ
	|	Документ.УСОERP_АктуализацияПлана.Работы КАК УСОERP_АктуализацияПланаРаботы
	|ГДЕ
	|	УСОERP_АктуализацияПланаРаботы.Ссылка = &Ссылка";				   
	ДанныеДляПроведения = Запрос.Выполнить().Выгрузить();
	
	Возврат ДанныеДляПроведения;
	
КонецФункции

Процедура СформироватьДвижения(ТаблицаДанных)
	
	Для каждого СтрокаРаботы из ТаблицаДанных Цикл
		НаборЗаписейПараметрыВР = РегистрыСведений.УСОERP_СрокиРабот.СоздатьНаборЗаписей();
		НаборЗаписейПараметрыВР.Отбор.Работа.Установить(СтрокаРаботы.СтроительнаяРабота);
		НаборЗаписейПараметрыВР.Отбор.Период.Установить(Ссылка.Дата);
		НаборЗаписейПараметрыВР.Прочитать();
		НаборЗаписейПараметрыВР.Очистить();
		НовыйКурс = НаборЗаписейПараметрыВР.Добавить();
		НовыйКурс.Работа = СтрокаРаботы.СтроительнаяРабота;
		ЗаполнитьЗначенияСвойств(НовыйКурс,СтрокаРаботы);
		НовыйКурс.Период = Ссылка.Дата;
		НовыйКурс.Утверждена = истина;
		НаборЗаписейПараметрыВР.Записать() ;
	КонецЦикла;
	
	
КонецПроцедуры

Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)

	Ответственный = Пользователи.ТекущийПользователь();

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	ИнициализироватьДокумент();
	
КонецПроцедуры

Процедура СформироватьСписокРегистровДляКонтроля()

	Массив = Новый Массив;
	
	Если ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
	КонецЕсли;
	
	ДополнительныеСвойства.ДляПроведения.Вставить("РегистрыДляКонтроля", Массив);
	
КонецПроцедуры

