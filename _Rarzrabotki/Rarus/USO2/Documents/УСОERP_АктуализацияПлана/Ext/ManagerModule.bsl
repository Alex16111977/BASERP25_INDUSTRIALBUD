
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	УСОERP_АктуализацияПланаРаботы.Ссылка КАК Ссылка,
	|	УСОERP_АктуализацияПланаРаботы.НомерСтроки КАК НомерСтроки,
	|	УСОERP_АктуализацияПланаРаботы.Работа КАК Работа,
	|	УСОERP_АктуализацияПланаРаботы.ОбъемРаботы КАК ОбъемРаботы,
	|	УСОERP_АктуализацияПланаРаботы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	УСОERP_АктуализацияПланаРаботы.НачалоРаботыПлан КАК НачалоРаботыПлан,
	|	УСОERP_АктуализацияПланаРаботы.ОкончаниеРаботыПлан КАК ОкончаниеРаботыПлан,
	|	УСОERP_АктуализацияПланаРаботы.ДлительностьПлан КАК ДлительностьПлан,
	|	УСОERP_АктуализацияПланаРаботы.ЕдиницаДлительности КАК ЕдиницаДлительности,
	|	УСОERP_АктуализацияПланаРаботы.СуммарнаяРабота КАК СуммарнаяРабота,
	|	УСОERP_АктуализацияПланаРаботы.ОбъемРаботыВыполненный КАК ОбъемРаботыВыполненный,
	|	УСОERP_АктуализацияПланаРаботы.НачалоРаботыПослеПересчета КАК НачалоРаботыПослеПересчета,
	|	УСОERP_АктуализацияПланаРаботы.ОкончаниеРаботыПослеПересчета КАК ОкончаниеРаботыПослеПересчета,
	|	УСОERP_АктуализацияПланаРаботы.ОкончаниеРаботыПослеПересчета2 КАК ОкончаниеРаботыПослеПересчета2,
	|	УСОERP_АктуализацияПланаРаботы.ДлительностьПослеПересчета КАК ДлительностьПослеПересчета,
	|	УСОERP_АктуализацияПланаРаботы.ДлительностьПослеРастягивания КАК ДлительностьПослеРастягивания,
	|	УСОERP_АктуализацияПланаРаботы.Ссылка.Дата КАК Период
	|ИЗ
	|	Документ.УСОERP_АктуализацияПлана.Работы КАК УСОERP_АктуализацияПланаРаботы
	|ГДЕ
	|	УСОERP_АктуализацияПланаРаботы.Ссылка = &Ссылка
	|	И НЕ УСОERP_АктуализацияПланаРаботы.Работа.СуммарнаяРабота";
	
	//Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
	//	Запрос.Текст = Запрос.Текст + ТекстЗапроса.Значение;
	//КонецЦикла;
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстыЗапроса.Добавить(ТекстЗапроса,	"ТаблицаСрокиРабот");
	
	Запрос.Текст = "";
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		Запрос.Текст = Запрос.Текст + ТекстЗапроса.Значение;
	КонецЦикла;
	
	
	////////////////////////////////////////////////////////////////////////////
	// Выполним запрос
	
	Результат = Запрос.ВыполнитьПакет();
	
	////////////////////////////////////////////////////////////////////////////
	// Поместим результаты запроса в дополнительные свойства
	
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		ИмяТаблицы = ТекстЗапроса.Представление;
		Если Не ПустаяСтрока(ИмяТаблицы) Тогда
			Индекс = ТекстыЗапроса.Индекс(ТекстЗапроса);
			ДополнительныеСвойства.ТаблицыДляДвижений.Вставить(ИмяТаблицы, Результат[Индекс].Выгрузить());
		КонецЕсли;
	КонецЦикла;
	
	//ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаСрокиРабот.ЗаполнитьЗначения(ДокументСсылка.Дата, "Период");
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	//Запрос.УстановитьПараметр("Работы", Работы);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.Ссылка,
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.Дата КАК Период,
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.Организация,
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.ОбъектСтроительства
	|ИЗ
	|	Документ.УСОERP_УтверждениеКалендарногоПланаГрафика КАК УСОERP_УтверждениеКалендарногоПланаГрафика
	|ГДЕ
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.Ссылка = &Ссылка";
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	//
	Запрос.УстановитьПараметр("ОбъектСтроительства",	Реквизиты.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Период",      			Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация", 			Реквизиты.Организация);
		
КонецПроцедуры

Процедура ОтразитьДвижения(ДополнительныеСвойства, Движения, Отказ) Экспорт 

	Таблица = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаСрокиРабот;
	
	Если Отказ ИЛИ Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Движения.УСОERP_СрокиРабот.Записывать = Истина;
	Движения.УСОERP_СрокиРабот.Загрузить(Таблица);
	

КонецПроцедуры

#КонецОбласти

