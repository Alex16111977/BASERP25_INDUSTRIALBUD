#Область ПроцедурыПересчет
&НаСервере
Процедура АктуализироватьГрафикНаСервере()
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_АктуализацияПлана_АктуализироватьГрафикНаСервере(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДатыРодителей()
	
	ТабРабот = Объект.Работы.Выгрузить();
	ТЗ = ТабРабот.Скопировать();
	ТЗ.Очистить();
	ДЗ = РеквизитФормыВЗначение("ДеревоРабот");
	
	Для Каждого СтрокаРабот ИЗ ТабРабот Цикл
		Строки = ДЗ.Строки.НайтиСтроки(Новый Структура("Работа",СтрокаРабот.Работа),Истина);
		ЗаполнитьЗначенияСвойств(ТЗ.Добавить(),Строки.Получить(0));
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТЗ",ТЗ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВрТаб.Работа,
	|	ВрТаб.НачалоРаботыПослеПересчета,
	|	ВрТаб.ОкончаниеРаботыПослеПересчета,
	|	ВрТаб.ОкончаниеРаботыПослеПересчета2
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	&ТЗ КАК ВрТаб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.Работа КАК Работа,
	|	ВрТаб.НачалоРаботыПослеПересчета КАК НачалоРаботыПослеПересчета,
	|	ВрТаб.ОкончаниеРаботыПослеПересчета КАК ОкончаниеРаботыПослеПересчета,
	|	ВрТаб.ОкончаниеРаботыПослеПересчета2 КАК ОкончаниеРаботыПослеПересчета2
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|ИТОГИ
	|	МИНИМУМ(НачалоРаботыПослеПересчета),
	|	МАКСИМУМ(ОкончаниеРаботыПослеПересчета),
	|	МАКСИМУМ(ОкончаниеРаботыПослеПересчета2)
	|ПО
	|	Работа ИЕРАРХИЯ";
	
	ТабРез = ЗАпрос.Выполнить().Выгрузить();
	
	
	ТекРабота = Неопределено;
	
	МассивБывшихРабот = Новый Массив;
	
	
	Для Каждого СтрокаРез ИЗ ТабРез Цикл
		
		Если ТекРабота = СтрокаРез.Работа Тогда
			ПродолжитЬ;
		КонецЕсли;  	
		
		Если МассивБывшихРабот.Найти(СтрокаРез.Работа) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МассивБывшихРабот.Добавить(СтрокаРез.Работа);
		
		ТекРабота = СтрокаРез.Работа; 
		
		СтруктураОтбора = Новый Структура("Работа",СтрокаРез.Работа);
		
		Строки = ДЗ.Строки.НайтиСтроки(СтруктураОтбора,Истина);
		Если Строки.Количество() Тогда
			
			НашаСтрока = Строки.Получить(0); 
			
			Если НашаСтрока.НачалоРаботыПослеПересчета <> СтрокаРез.НачалоРаботыПослеПересчета Тогда
				НашаСтрока.НачалоРаботыПослеПересчета = СтрокаРез.НачалоРаботыПослеПересчета;
			КонецЕсли;  	
			
			Если НашаСтрока.ОкончаниеРаботыПослеПересчета <> СтрокаРез.ОкончаниеРаботыПослеПересчета Тогда
				НашаСтрока.ОкончаниеРаботыПослеПересчета = СтрокаРез.ОкончаниеРаботыПослеПересчета;
			КонецЕсли;
			
			Если НашаСтрока.ОкончаниеРаботыПослеПересчета2 <> СтрокаРез.ОкончаниеРаботыПослеПересчета2 Тогда
				НашаСтрока.ОкончаниеРаботыПослеПересчета2 = СтрокаРез.ОкончаниеРаботыПослеПересчета2;
			КонецЕсли; 
			
			СтрокиРабот = Объект.Работы.НайтиСтроки(СтруктураОтбора);
			
			Для Каждого СтрокаРабот ИЗ СтрокиРабот Цикл
				
				СтрокаРабот.ОкончаниеРаботыПослеПересчета = СтрокаРез.ОкончаниеРаботыПослеПересчета;
				СтрокаРабот.ОкончаниеРаботыПослеПересчета = СтрокаРез.ОкончаниеРаботыПослеПересчета;
				СтрокаРабот.ОкончаниеРаботыПослеПересчета2 = СтрокаРез.ОкончаниеРаботыПослеПересчета2;
				
			КонецЦикла;  		
			
		КонецЕсли; 		
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДЗ,"ДеревоРабот");	
	
КонецПроцедуры


&НаКлиенте
Процедура АктуализироватьГрафик(Команда)
	
	Если Объект.ВидОперации	= ПредопределенноеЗначение("Перечисление.УСОERP_ВидыОперацийАктуализацияПланов.ПерепланированиеСУчетомФакта") Тогда		
		АктуализироватьГрафикНаСервере();
		//рассчитать новый КСГ
		м_Актуализирован = Истина;
		СформироватьДеревоРабот();
		СформироватьСетевойГрафикСУчетомВыполненных();
		ЗаполнитьДатыРодителей();
		ЗаполнитьДиаграммуГанта();
		РазвернутьДеревоРабот();	
	Иначе 			
		АСОНаСервере();		
	КонецЕсли; 
	
КонецПроцедуры

