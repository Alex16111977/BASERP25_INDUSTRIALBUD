&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗначенияДляЗаполнения = Новый Структура;
	ЗначенияДляЗаполнения.Вставить("Ответственный", "Объект.Ответственный");
	ЗарплатаКадры.ЗаполнитьПервоначальныеЗначенияВФорме(ЭтаФорма, ЗначенияДляЗаполнения);

	ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;
	ТекущаяОрганизация 		   = Объект.Организация;
	
	СформироватьДеревоРабот();
	
	УстановитьУсловноеОформление();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	СобытияФорм.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТабличнаяЧастьРаботы = ТекущийОбъект.Работы;
	ТабличнаяЧастьРаботы.Очистить();
	РеквизитРаботыДеревоЗначений = РеквизитФормыВЗначение("ДеревоРабот", Тип("ДеревоЗначений"));	
	ЗаполнитьТабличнуюЧастьРаботыИзДереваЗначений(РеквизитРаботыДеревоЗначений, ТабличнаяЧастьРаботы, 0, Отказ);  
	
	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьТабличнуюЧастьРаботыИзДереваЗначений(Дерево, ТабличнаяЧасть, НомерПоПрядку, Отказ)
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		НомерПоПрядку = НомерПоПрядку + 1;
		Если Не ЗначениеЗаполнено(СтрокаДерева.Работа) Тогда
			Сообщить(НСтр("ru='Не заполнено значение Работа в строке '")+ НомерПоПрядку);
			Отказ = Истина;
			Возврат Отказ;
		КонецЕсли;	
        ЗаполнитьЗначенияСвойств(ТабличнаяЧасть.Добавить(), СтрокаДерева);
        ЗаполнитьТабличнуюЧастьРаботыИзДереваЗначений(СтрокаДерева, ТабличнаяЧасть, НомерПоПрядку, Отказ);
    КонецЦикла;
    Возврат ТабличнаяЧасть;
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	РазвернутьДеревоРабот();
	ЗаполнитьДиаграммуГанта();
	ПолосаРегулированияДиаграммы = 25;	
	//Элементы.Диаграмма.Очистить();
	
	//МакетДок = МакетНаСервере();
	//Элементы.Диаграмма.Вывести(МакетДок);
	ВидОперацииПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроектПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ТекущийОбъектСтроительства)
		И ТекущийОбъектСтроительства <> Объект.ОбъектСтроительства Тогда
		
		Если Объект.Работы.Количество()>0 Тогда
			
			ПоказатьВопрос(Новый ОписаниеОповещения("ПроектПриИзмененииПродолжение",ЭтотОбъект),"Таблица работ будет перезаполнена. Продолжить?",РежимДиалогаВопрос.ДаНет,20,КодВозвратаДиалога.Нет);
			
		Иначе
			
			ПроектПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
			
		КонецЕсли;
		
	Иначе
		
		ПроектПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроектПриИзмененииПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Объект.ОбъектСтроительства = ТекущийОбъектСтроительства;
		Возврат;
	КонецЕсли;
	
	Если ТекущийОбъектСтроительства <> Объект.ОбъектСтроительства Тогда
		Объект.СценарийПланирования = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьРабочийСценарий(Объект.ОбъектСтроительства, Объект.Организация);
	КонецЕсли;
	
	ЗаполнитьТаблицуРабот();
	СформироватьДеревоРабот();
	РазвернутьДеревоРабот();
	
	ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;
	ТекущийСценарий = Объект.СценарийПланирования; 
	
КонецПроцедуры  

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если ТекущаяОрганизация <> Объект.Организация Тогда
		
		Объект.СценарийПланирования = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьРабочийСценарий(Объект.ОбъектСтроительства, Объект.Организация);
		
		ЗаполнитьТаблицуРабот();
		СформироватьДеревоРабот();
		РазвернутьДеревоРабот();
		
	КонецЕсли;
	
	ТекущаяОрганизация = Объект.Организация;
	ТекущийСценарий = Объект.СценарийПланирования;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаАктуализацииПриИзменении(Элемент)
	
	Объект.ДатаВерсииПлана 		= Объект.ДатаАктуализации;	
	Объект.ГоризонтПланирования = Объект.ДатаАктуализации;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДеревоРабот(Команда)
	ЗаполнитьТаблицуРабот();
	м_Актуализирован = Ложь;
	СформироватьДеревоРабот();
	ЗаполнитьДиаграммуГанта();
	РазвернутьДеревоРабот();	
КонецПроцедуры

&НаСервере
Процедура СформироватьДеревоРабот()
	
	ДанныеДляДерева = Объект.Работы.Выгрузить();
	ДанныеДляДерева = ЗаполнитьРодительскуюРаботу(ДанныеДляДерева);
	Справочник = Справочники.УСОERP_СтроительныеРаботы;
	ЗначениеДеревоРабот = УСОERP_ОбработкаТабличныхЧастей.УСОERP_ПодготовитьДанныеИСформироватьДеревоСВосстановлениемСтруктуры(ДанныеДляДерева,"Работа","РаботаРодитель",,Справочник);

	Если ЗначениеДеревоРабот.Колонки.Найти("Предшественники") = Неопределено Тогда
		ЗначениеДеревоРабот.Колонки.Добавить("Предшественники", Новый ОписаниеТипов("ТаблицаЗначений")); 
	КонецЕсли;
	Предшественники	= УСОERP_УправлениеСтроительнымПроизводством.ПолучитьСвязиМеждуРаботами(Объект.СценарийПланирования, КонецДня(Объект.ДатаВерсииПлана)); 
	ЗначениеДеревоРабот =  ЗаполнитьПредшественники(ЗначениеДеревоРабот,Предшественники);

	ЗначениеВРеквизитФормы(ЗначениеДеревоРабот, "ДеревоРабот");

КонецПроцедуры

&НаСервере
Функция ЗаполнитьРодительскуюРаботу(ДанныеДляДерева)
	Если ДанныеДляДерева.Колонки.Найти("РодительскаяРабота") = Неопределено Тогда
    	ДанныеДляДерева.Колонки.Добавить("РодительскаяРабота",Новый ОписаниеТипов("СправочникСсылка.УСОERP_СтроительныеРаботы"),"РодительскаяРабота");
	КонецЕсли;	
	
	Для каждого Строка из ДанныеДляДерева Цикл
		Строка.РодительскаяРабота = Строка.Работа.Родитель;			
	КонецЦикла; 
      
	Возврат ДанныеДляДерева;
КонецФункции

&НаСервере
Функция ЗаполнитьПредшественники(Дерево,Предшественники)
     
     Для каждого Строка из Дерево.Строки Цикл
			
		Строка.Предшественники.Колонки.Добавить("ОбъектСтроительстваПредшественника");
		Строка.Предшественники.Колонки.Добавить("РаботаПредшественник");
		Строка.Предшественники.Колонки.Добавить("ТипЗависимости");
		Строка.Предшественники.Колонки.Добавить("Задержка");
		Строка.Предшественники.Колонки.Добавить("ЕдиницаЗадержки");
		
		ТекущиеПредшественники = Предшественники.НайтиСтроки(Новый Структура("РаботаПоследователь", Строка.Работа));
		
		// предшественники
		Строка.Предшественники.Очистить();
		Для Каждого СтрокаТаблЧасти Из ТекущиеПредшественники Цикл
			СтрокаТаблицыЗначений	= Строка.Предшественники.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыЗначений, СтрокаТаблЧасти);
		КонецЦикла;
 
		ЗаполнитьПредшественники(Строка,Предшественники);
     КонецЦикла; 
      
	Возврат Дерево;
КонецФункции



&НаСервере
Процедура ЗаполнитьТаблицуРабот()
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_АктуализацияПлана_ЗаполнитьТаблицуРабот(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоРабот()
	
	КоллекцияЭлементовДерева = ДеревоРабот.ПолучитьЭлементы();	
	//Развернуть дерево 
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
		ИдентификаторСтроки=Строка.ПолучитьИдентификатор();
		Элементы.ДеревоРабот.Развернуть(ИдентификаторСтроки);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();

	//

	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоРабот.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоРабот.СуммарнаяРабота");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(WindowsШрифты.ШрифтДиалоговИМеню,,,Истина));

КонецПроцедуры

&НаКлиенте
Процедура СценарийПланированияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ТекущийСценарий)
		И ТекущийСценарий <> Объект.СценарийПланирования Тогда
		
		Если Объект.Работы.Количество()>0 Тогда
			
			ПоказатьВопрос(Новый ОписаниеОповещения("СценарийПланированияПриИзмененииПродолжение",ЭтотОбъект),"Таблица работ будет перезаполнена. Продолжить?",РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
			
		Иначе
			
			СценарийПланированияПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
			
		КонецЕсли;
		
	Иначе
		
		СценарийПланированияПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СценарийПланированияПриИзмененииПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		
		Объект.СценарийПланирования = ТекущийСценарий;
		
		Возврат;
		
	КонецЕсли;
	
	Если ТекущийСценарий <> Объект.СценарийПланирования Тогда
		
		ЗаполнитьТаблицуРабот();
		СформироватьДеревоРабот();
		ЗаполнитьДиаграммуГанта();
		РазвернутьДеревоРабот();
		
		ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;
		ТекущийСценарий = Объект.СценарийПланирования;
		
	КонецЕсли; 
	
КонецПроцедуры  

&НаКлиенте
Процедура УчитываемыеРесурсыПриАктивизацииСтроки(Элемент)
	
	// Получаем текущие данные таблицы
	ТекДанные = Элементы.УчитываемыеРесурсы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Создаем структуру отбора по полю "Товар"
	Отбор = Новый Структура;
	Отбор.Вставить("Ресурс", ТекДанные.Ресурс);
	// Задаем фиксированную структуру отбора для таблицы формы
	Элементы.ДоступныеРесурсы.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	Если Объект.ВидОперации	= ПредопределенноеЗначение("Перечисление.УСОERP_ВидыОперацийАктуализацияПланов.ПерепланированиеСУчетомФакта") Тогда		
		Элементы.ОптимизацияACO.Видимость 		= Ложь;
		Элементы.Ресурсы.Видимость 				= Ложь;
		Элементы.ФормаНастройкиАСО.Видимость 	= Ложь;
	Иначе 			
		Элементы.ОптимизацияACO.Видимость 		= Ложь;
		Элементы.Ресурсы.Видимость 				= Истина;
		Элементы.ФормаНастройкиАСО.Видимость 	= Истина;
		Элементы.ФормаНастройкиАСО.Пометка 		= Элементы.ОптимизацияACO.Видимость;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьЛегенду(Команда)
	ДиаграммаГанта.ОтображатьЛегенду = НЕ ДиаграммаГанта.ОтображатьЛегенду;	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиАСО(Команда)
	Элементы.ОптимизацияACO.Видимость 	= Не Элементы.ОптимизацияACO.Видимость;
	Элементы.ФормаНастройкиАСО.Пометка 	= Элементы.ОптимизацияACO.Видимость;
КонецПроцедуры
