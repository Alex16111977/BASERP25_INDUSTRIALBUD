&НаКлиенте
Процедура ДиаграммаГантаПриОкончанииРедактированияИнтервала(Элемент, Интервал, ОтменаРедактирования)
	СтруктураВозврата		= ДиаграммаГантаПриОкончанииРедактированияИнтервалаНаСервере(Интервал.Расшифровка, НачалоЧаса(Интервал.Начало), НачалоЧаса(Интервал.Конец));
	Интервал.Начало			= НачалоЧаса(Интервал.Начало) + 1;
	Интервал.Конец			= НачалоЧаса(Интервал.Конец) + 1;
	ОтменаРедактирования	= СтруктураВозврата.ОшибкаВСтроке; 
	Если Не ОтменаРедактирования Тогда
		СформироватьСетевойГрафикСУчетомВыполненных();		 
		ОбновитьДиаграмму(Неопределено);	
	КонецЕсли; 
КонецПроцедуры

&НаСервере
Функция ДиаграммаГантаПриОкончанииРедактированияИнтервалаНаСервере(Работа, НачалоРаботы, КонецРаботы)
	
	СтруктураВозврата = Новый Структура;
	НачалоВрем		= НачалоРаботы;
	КонецВрем		= КонецРаботы;
	НачалоРаботы	= НачалоЧаса(НачалоРаботы);
	КонецРаботы		= НачалоЧаса(КонецРаботы);

	Если Не ЗначениеЗаполнено(Работа) Тогда
		СтруктураВозврата.Вставить("ОшибкаВСтроке", Истина);
		Возврат СтруктураВозврата;	
	КонецЕсли; 
	
	ЗначениеДеревоРабот = РеквизитФормыВЗначение("ДеревоРабот", Тип("ДеревоЗначений"));		
	СтрокаРаботы = НайтиОтмеченноеЗначениеВДеревеЗначений(ЗначениеДеревоРабот.Строки, Работа);	
	//СтрокаРаботы.ДлительностьПослеРастягивания = 0;
	
	СтруктураВозврата.Вставить("ОшибкаВСтроке", Ложь);
	
	//нельзя сдвигать левее даты актуализации
	Если НачалоРаботы < Объект.ДатаАктуализации Тогда
		СтруктураВозврата.Вставить("ОшибкаВСтроке", Истина);
		Возврат СтруктураВозврата;		
	КонецЕсли; 
	
	
	Если НачалоВрем = СтрокаРаботы.НачалоРаботыПослеПересчета И КонецВрем <> СтрокаРаботы.ОкончаниеРаботыПослеПересчета2 Тогда
		//Если раздвигаем или сдвигаем колбаску
		Если КонецВрем > СтрокаРаботы.ОкончаниеРаботыПослеПересчета2 Тогда		
			ДельтаДлительности		= УСОERP_УправлениеСтроительнымПроизводством.РассчитатьДлительностьПериода(Работа,СтрокаРаботы.ОкончаниеРаботыПослеПересчета2, КонецВрем, СтрокаРаботы.ЕдиницаДлительности, Работа.ГрафикРаботы);			
		Иначе			
			ДельтаДлительности		= -УСОERP_УправлениеСтроительнымПроизводством.РассчитатьДлительностьПериода(Работа,КонецВрем, СтрокаРаботы.ОкончаниеРаботыПослеПересчета2, СтрокаРаботы.ЕдиницаДлительности, Работа.ГрафикРаботы);			
		КонецЕсли;  		
		СтрокаРаботы.ДлительностьПослеРастягивания = СтрокаРаботы.ДлительностьПослеРастягивания + ДельтаДлительности;
		СтрокаРаботы.ОкончаниеРаботыПослеПересчета2 = КонецВрем;		
	ИначеЕсли НачалоРаботы >  СтрокаРаботы.НачалоРаботыПослеПересчета Тогда
		//если сдвигаем вправо - устанавливается ограничение "начало не ранее"
		СтрокаРаботы.ТипОграничения 	= Перечисления.УСОERP_ТипыОграничений.НачалоНеРанее;
		СтрокаРаботы.ДатаОграничения	= НачалоРаботы + 1;
		СтрокаРаботы.НачалоРаботыПослеПересчета = НачалоРаботы + 1;
		СтрокаРаботы.ОкончаниеРаботыПослеПересчета2 = КонецРаботы + 1;	
	Иначе
		//если сдвигаем влево - если дата окончания предшественников меньше чем дата начала после сдвика и меньше чем дата актуализации 
		табПредшественников = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьВсехПредшественников(Работа, Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный, Объект.ГоризонтПланирования);
		НачалоРаботыВрем	= НачалоРаботы;
		Для каждого СтрПредшественник Из табПредшественников Цикл
			СтрокаРаботы = НайтиОтмеченноеЗначениеВДеревеЗначений(ЗначениеДеревоРабот.Строки, СтрПредшественник.Работа);
			Если СтрокаРаботы <> Неопределено Тогда
				НачалоРаботыВрем	= Макс(НачалоРаботыВрем,СтрокаРаботы.ОкончаниеРаботыПослеПересчета2);			
			КонецЕсли; 
		КонецЦикла; 
		Если НачалоРаботыВрем > НачалоРаботы Тогда
			СтрокаРаботы.ТипОграничения 	= "";
			СтрокаРаботы.ДатаОграничения	= "";	
			СтрокаРаботы.НачалоРаботыПослеПересчета = НачалоРаботыВрем + 1;
			СтрокаРаботы.ОкончаниеРаботыПослеПересчета2 = КонецРаботы + (НачалоРаботыВрем - НачалоРаботы) + 1;	
		Иначе 
			
			СтрокаРаботы.ТипОграничения 	= Перечисления.УСОERP_ТипыОграничений.НачалоНеРанее;
			СтрокаРаботы.ДатаОграничения	= НачалоРаботы + 1;
			СтрокаРаботы.НачалоРаботыПослеПересчета = НачалоРаботы + 1;
			СтрокаРаботы.ОкончаниеРаботыПослеПересчета2 = КонецРаботы + 1;	
			
		КонецЕсли; 
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ЗначениеДеревоРабот, "ДеревоРабот");
	
	Если НЕ СтруктураВозврата.ОшибкаВСтроке Тогда
		
		//в таблице документа запишем новое значение сроков в строку с работой
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Работа", Работа);
		МассивСтрок	= Объект.Работы.НайтиСтроки(СтруктураПоиска);
		Если МассивСтрок.Количество() <> 0 Тогда
			СтрокаТЧ = МассивСтрок[0];
			СтрокаТЧ.ТипОграничения 				= СтрокаРаботы.ТипОграничения;
			СтрокаТЧ.ДатаОграничения				= СтрокаРаботы.ДатаОграничения;
			СтрокаТЧ.НачалоРаботыПослеПересчета 	= СтрокаРаботы.НачалоРаботыПослеПересчета;
			СтрокаТЧ.ОкончаниеРаботыПослеПересчета2 = СтрокаРаботы.ОкончаниеРаботыПослеПересчета2;
			СтрокаТЧ.ДлительностьПослеРастягивания	= СтрокаРаботы.ДлительностьПослеРастягивания;
		КонецЕсли; 
		
	КонецЕсли; 
	
	Возврат СтруктураВозврата;	
	
КонецФункции

&НаСервере
Процедура СформироватьСетевойГрафикСУчетомВыполненных()
	
	ДопПараметры = ПолучитьДопПараметрыПоПеременнымМодуля();
