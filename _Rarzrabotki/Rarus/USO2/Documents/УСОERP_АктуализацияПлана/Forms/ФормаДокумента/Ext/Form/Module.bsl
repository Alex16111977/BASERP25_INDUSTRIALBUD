#Область Ресурсы
&НаКлиенте
Процедура ЗаполнитьРесурсы(Команда)
	
	Если Объект.УчитываемыеРесурсы.Количество() <> 0 
		ИЛИ Объект.ДоступныеРесурсы.Количество() <> 0 Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьРесурсыПродолжение",ЭтотОбъект),"Таблицы ресурсов будут очищены. Продолжить?", РежимДиалогаВопрос.ДаНет);		
		
	Иначе
		
		ЗаполнитьРесурсыПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРесурсыПродолжение(Ответ,ДопПараметры)Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРесурсыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРесурсыНаСервере()
	
	Объект.ДоступныеРесурсы.Очистить();
	Объект.УчитываемыеРесурсы.Очистить();
	
	Запрос = Новый Запрос;
	//количество ресурсов
	Запрос.Текст = "ВЫБРАТЬ
	|	УСОERP_АктуализацияПланаРаботы.Работа КАК Работа
	|ПОМЕСТИТЬ ВремРаботы
	|ИЗ
	|	Документ.УСОERP_АктуализацияПлана.Работы КАК УСОERP_АктуализацияПланаРаботы
	|ГДЕ
	|	УСОERP_АктуализацияПланаРаботы.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_ПотребностьВРесурсахСрезПоследних.Ресурс
	|ИЗ
	|	РегистрСведений.УСОERP_ПотребностьВРесурсах.СрезПоследних(
	|			&Период,
	|			Работа В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					времРаботы.Работа
	|				ИЗ
	|					времРаботы)) КАК УСОERP_ПотребностьВРесурсахСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ПотребностьВРесурсахСрезПоследних.Ресурс";
	
	
	Запрос.УстановитьПараметр("Период",КонецДня(Объект.ДатаАктуализации));		 
	Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);		 
	ВыборкаРесурсы = Запрос.Выполнить().Выбрать();
	
	
	СтруктураПоиска	= Новый Структура;
	
	Пока ВыборкаРесурсы.Следующий() Цикл
		СтрокаРесурсов 							= Объект.УчитываемыеРесурсы.Добавить();
		СтрокаРесурсов.Ресурс					= ВыборкаРесурсы.Ресурс;		
		СтрокаРесурсов.УчитыватьПриАктуализации	= Истина;
	КонецЦикла; 
	
	//--------------- 
	РасчитатьДоступныеРесурсы();
	
КонецПроцедуры

