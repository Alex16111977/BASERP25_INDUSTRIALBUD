#Область ПроцедурыДиаграммаГанта
////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ДИАГРАММА ГАНТА

&НаКлиенте
Процедура ОбновитьДиаграмму(Команда)
	ЗаполнитьДиаграммуГанта();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДиаграммуГанта()
	
	// Получаем диаграмму и запрещаем на время заполнения ее обновление.
	// В случае большого объема данных это существенно ускорит выполнение.
	Диаграмма = ДиаграммаГанта;
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	Диаграмма.ИнтервалыФона.Очистить();
	ОбъектСтроительства	= ЭтотОбъект.Объект; 
	
	Для Каждого Шкала Из Диаграмма.ОбластьПостроения.ШкалаВремени.Элементы Цикл
		Шкала.Метки.Очистить();
	КонецЦикла;	
	
	Диаграмма.ОтображатьЛегенду = Ложь;
	Диаграмма.ОтображатьЗаголовок = Ложь;
	Диаграмма.ОбластьПостроения.Право = 1;
		
	//шкалы времени
	// Оформление шкалы времени
	ЭлементыШкалыВремени = Диаграмма.ОбластьПостроения.ШкалаВремени.Элементы;
	// очистим коллекцию
	ПервыйЭлемент = ЭлементыШкалыВремени[0];// полностью коллекцию не очищаем, м_Т.к. один элемент д/б всегда
	Для Сч1 = 1 по ЭлементыШкалыВремени.Количество()-1 Цикл
		ЭлементыШкалыВремени.Удалить(ЭлементыШкалыВремени[1]);		
	КонецЦикла;
	//ПервыйЭлемент.Единица = ТипЕдиницыШкалыВремени.Год;
	//ПервыйЭлемент.ЛинииДелений = Новый Линия(ТипЛинииДиаграммы.Сплошная, 1);
	//
	//Элемент = ЭлементыШкалыВремени.Добавить();
	
	ПервыйЭлемент.Единица = ТипЕдиницыШкалыВремени.Месяц;
	ПервыйЭлемент.ЛинииДелений = Новый Линия(ТипЛинииДиаграммы.Точечная, 1);
	ПервыйЭлемент.Формат	= "ДФ='ММММ гггг'"; 
	
	
	Элемент = ЭлементыШкалыВремени.Добавить();
	Элемент.Единица = ТипЕдиницыШкалыВремени.День;
	Элемент.ЛинииДелений = Новый Линия(ТипЛинииДиаграммы.Точечная, 1);
	Элемент.ФорматДня =  ФорматДняШкалыВремени.ДеньМесяца;

	//
	
	// Создаем таблицу значений, в которую, по мере обхода запроса, будем заносить м_Связи.
	м_Связи = Новый ТаблицаЗначений;
	м_Связи.Колонки.Добавить("Конец");
	м_Связи.Колонки.Добавить("Начало");
	м_Связи.Колонки.Добавить("ТипЗависимости");
	
	// Серия будет одна.
	Серия = Диаграмма.Серии.Добавить();
	Серия.Цвет	= WebЦвета.СероСиний;
	//Серия факт	
	СерияФакт = Диаграмма.Серии.Добавить();
	СерияФакт.Цвет	= WebЦвета.Черный;
	
	// Заводим переменные для определения максимальной и минимальной дат работ.
	МаксимальнаяДата = NULL;
	МинимальнаяДата = NULL;
	
	Строки = ДеревоРабот.ПолучитьЭлементы();
	СписокРабот = Новый СписокЗначений;
	Для Каждого СтрокаДерева Из Строки Цикл
		ЗаполнитьОднуТочкуДиаграммыГанта(СтрокаДерева, м_Связи, Серия, МаксимальнаяДата, МинимальнаяДата);
		СписокРабот.Добавить(СтрокаДерева.Работа);
	КонецЦикла;
	
	Для Каждого СтрокаДерева Из Строки Цикл
		ЗаполнитьОднуТочкуДиаграммыГанта(СтрокаДерева, м_Связи, СерияФакт, МаксимальнаяДата, МинимальнаяДата, Ложь, Истина);
		СписокРабот.Добавить(СтрокаДерева.Работа);
	КонецЦикла;

		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ЗначенияКритичностиРабот.Работа,
	|	УСОERP_ЗначенияКритичностиРабот.РасчетКалендарногоПлана,
	|	УСОERP_ЗначенияКритичностиРабот.ДНКМР,
	|	УСОERP_ЗначенияКритичностиРабот.ДОКМР,
	|	УСОERP_ЗначенияКритичностиРабот.ДНКМП,
	|	УСОERP_ЗначенияКритичностиРабот.ДОКМП,
	|	УСОERP_ЗначенияКритичностиРабот.КритическаяРабота,
	|	УСОERP_ЗначенияКритичностиРабот.ЗапасВремениДни,
	|	УСОERP_ЗначенияКритичностиРабот.ЗапасВремениЧасы
	|ПОМЕСТИТЬ ВремТаб
	|ИЗ
	|	РегистрСведений.УСОERP_ЗначенияКритичностиРабот КАК УСОERP_ЗначенияКритичностиРабот
	|ГДЕ
	|	УСОERP_ЗначенияКритичностиРабот.Работа В (&Работы)
	|			И НЕ УСОERP_ЗначенияКритичностиРабот.Работа.Владелец = &СценарийПланированияТекущий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_СвязиМеждуРаботамиСрезПоследних.РаботаПредшественник КАК Работа,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.НачалоРаботыПлан,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОкончаниеРаботыПлан,
	|	УСОERP_СвязиМеждуРаботамиСрезПоследних.РаботаПредшественник.Наименование КАК Наименование,
	|	ВремТаб.КритическаяРабота
	|ИЗ
	|	РегистрСведений.УСОERP_СвязиМеждуРаботами.СрезПоследних(
	|			,
	|			РаботаПоследователь В (&Работы)
	|				И НЕ РаботаПредшественник.Владелец = &СценарийПланированияТекущий
	|				И НЕ ТипЗависимости = &ТипЗависимости) КАК УСОERP_СвязиМеждуРаботамиСрезПоследних
	//|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(, ВидПланирования = &ВидПланирования) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(, ) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
	|		ПО УСОERP_СвязиМеждуРаботамиСрезПоследних.РаботаПредшественник = УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК ВремТаб
	|		ПО УСОERP_СвязиМеждуРаботамиСрезПоследних.РаботаПредшественник = ВремТаб.Работа";
	
	Запрос.УстановитьПараметр("Работы", 						СписокРабот);
	Запрос.УстановитьПараметр("СценарийПланированияТекущий", 	ЭтотОбъект.ТекущийСценарий);
	Запрос.УстановитьПараметр("ТипЗависимости", 				Перечисления.УСОERP_ТипыЗависимостейРабот.ПустаяСсылка());
	Запрос.УстановитьПараметр("ВидПланирования", 				"");

	РезультатЗапроса = Запрос.Выполнить();
	
	РаботыДругогоВладельца = РезультатЗапроса.Выбрать();
	
	Пока РаботыДругогоВладельца.Следующий() Цикл
		//ЗаполнитьОднуТочкуДиаграммыГанта(РаботыДругогоВладельца, м_Связи, Серия, МаксимальнаяДата, МинимальнаяДата, Истина);
	КонецЦикла;
	
	// Теперь в интервале минимальной и максимальной дат заполняем интервалы выходных дней.
	Если МинимальнаяДата <> NULL Тогда
		
		День = 3600 * 24;
		Неделя = 3600 * 24 * 7;
		МаксимальнаяДата = МаксимальнаяДата + Неделя * 4;
		
		ГрафикРаботы = ОбъектСтроительства.ОбъектСтроительства.ГрафикРаботы;//ОбъектСтроительства.ГрафикРаботы;
		
		РабочиеДни = Справочники.Календари.ПрочитатьДанныеГрафикаИзРегистра(ГрафикРаботы, Год(МинимальнаяДата));
		Если Год(МаксимальнаяДата) > Год(МинимальнаяДата) Тогда 
			ТекГод = Год(МинимальнаяДата) + 1;
			Пока ТекГод <= Год(МаксимальнаяДата) Цикл
				врРабочиеДни = Справочники.Календари.ПрочитатьДанныеГрафикаИзРегистра(ГрафикРаботы, ТекГод);
				Для Каждого Элемент Из врРабочиеДни Цикл
					РабочиеДни.Вставить(Элемент.Ключ, Элемент.Значение);
				КонецЦикла;	
				ТекГод = ТекГод + 1;
			КонецЦикла;	
		КонецЕсли;	 
		
		ТекДата = МинимальнаяДата;
		Пока ТекДата <= МаксимальнаяДата Цикл;
			
			РабочийДень = (РабочиеДни.Получить(НачалоДня(ТекДата)) <> Неопределено);
			
			Если Не РабочийДень Тогда
			
				Кон = КонецДня(ТекДата);
				Нач = НачалоДня(ТекДата);
				Диаграмма.ИнтервалыФона.Добавить(Нач, Кон);
				
			КонецЕсли;	
			
			ТекДата = ТекДата + День;
			
		КонецЦикла;		
		
	КонецЕсли;
	
	// По заполненной таблице создаем м_Связи.
	СоздатьСвязиНаДиаграммеГанта(м_Связи, Диаграмма, Серия);
	СоздатьСвязиНаДиаграммеГанта(м_Связи, Диаграмма, СерияФакт, Истина);
	
	// Находим элемент шкалы времени для непериодических меток.
	ЭлементМеток = ПолучитьЭлементДляМеток(Диаграмма);
	
	// Создаем метку - текущая дата
	Метка = ЭлементМеток.Метки.Добавить(ТекущаяДата());
	Метка.Текст = НСтр("ru = 'Текущая дата'");
	Метка.ЦветТекста = WebЦвета.СинеСерый;
	Метка.ЦветЛинии = Метка.ЦветТекста;
	
	// Развертываем первую точку - рекурсивно. 
	Если Диаграмма.Точки.Количество() > 0 Тогда
		Диаграмма.РазвернутьТочку(Диаграмма.Точки.Получить(0), Истина);
	КонецЕсли;
	
	// Включаем обновление диаграммы.
	Диаграмма.Обновление = Истина;
	
	Диаграмма.ПоддержкаМасштаба = ПоддержкаМасштабаДиаграммыГанта.Авто;
	
	СерияПлан	= Диаграмма.Серии[0];
	СерияПлан.Текст  = "Работы до актуализации";
	СерияПлан.Цвет	= ЦветаСтиля.ПоясняющийОшибкуТекст;
	
	Если Диаграмма.Серии.Количество() > 1 Тогда		
		СерияПлан	= Диаграмма.Серии[1];
		СерияПлан.Текст  = "Актуализированные работы";
		СерияПлан.Цвет	= WebЦвета.Зеленый;	
	КонецЕсли; 
	
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОднуТочкуДиаграммыГанта(СтрокаДерева, м_Связи, Серия, МаксимальнаяДата, МинимальнаяДата, РаботыДругогоВладельца = Ложь, Факт = Ложь)
	
	Диаграмма = ДиаграммаГанта;
	Диаграмма.ОтображениеТекстаЗначения	= ОтображениеТекстаЗначенияДиаграммыГанта.Право;
	
	//ЦветЗапланированного 		= WebЦвета.Васильковый;
	//ЦветНеПросроченного  		= ЦветаСтиля.ОтметкаПоложительногоВыполненияЗадачи;
	//ЦветПросроченного    		= ЦветаСтиля.ПоясняющийОшибкуТекст;
	//ЦветВыполненного     		= ЦветаСтиля.ЗавершенныйБизнесПроцесс; 
	//ЦветНеНазначенного   		= WebЦвета.НейтральноКоричневый;
	//ЦветРодителя         		= WebЦвета.Черный;
	//ЦветРаботыДругогоВладельца 	= WebЦвета.ЗеленоватоЖелтый;
	//ЦветРаботыКритическая		= WebЦвета.Кирпичный;
	//ЦветСерииПоУмолчанию		= WebЦвета.СероСиний;
	//ЦветСерииФакт				= WebЦвета.Зеленый;
	
	//цвета плана - все красное, факт - зеленое, родитель - черное
	ЦветЗапланированного 		= ЦветаСтиля.ПоясняющийОшибкуТекст;
	ЦветНеПросроченного  		= ЦветаСтиля.ПоясняющийОшибкуТекст;
	ЦветПросроченного    		= ЦветаСтиля.ПоясняющийОшибкуТекст;
	ЦветВыполненного     		= ЦветаСтиля.ПоясняющийОшибкуТекст;
	ЦветНеНазначенного   		= ЦветаСтиля.ПоясняющийОшибкуТекст;
	ЦветРодителя         		= WebЦвета.Черный;
	ЦветРаботыДругогоВладельца 	= ЦветаСтиля.ПоясняющийОшибкуТекст;
	ЦветРаботыКритическая		= ЦветаСтиля.ПоясняющийОшибкуТекст;
	ЦветСерииПоУмолчанию		= ЦветаСтиля.ПоясняющийОшибкуТекст;
	ЦветСерииФакт				= WebЦвета.Зеленый;

	
	Если Факт Тогда		
		ДатаНачала 		= СтрокаДерева.НачалоРаботыПлан;
		ДатаОкончания 	= СтрокаДерева.ОкончаниеРаботыПослеПересчета; 			
	Иначе 
		ДатаНачала 		= СтрокаДерева.НачалоРаботыПлан;
		ДатаОкончания 	= СтрокаДерева.ОкончаниеРаботыПлан;
	КонецЕсли; 

	
	
	НужноДобавитьСтроку = Истина;
	//НужноДобавитьСтроку = НЕ Факт;
	
	// Если даты не заполнены и нет дочерних Работ - не добавляем точку
	Если Не ЗначениеЗаполнено(ДатаНачала) И Не ЗначениеЗаполнено(ДатаОкончания)
		И СтрокаДерева.ПолучитьЭлементы().Количество() = 0 Тогда
		
		НужноДобавитьСтроку = Ложь;
		
	КонецЕсли;	
	
	Если НужноДобавитьСтроку Тогда
		
		// Определяем статус Работы.
		Если ТипЗнч(СтрокаДерева) = Тип("ВыборкаИзРезультатаЗапроса") Тогда
			ЭтоРодитель = (СтрокаДерева.Ссылка.СуммарнаяРабота);
		Иначе
			ЭтоРодитель = (СтрокаДерева.ПолучитьЭлементы().Количество() <> 0);
		КонецЕсли;
		
		// Поскольку серия одна, каждой работе соответствует одна точка и одно значение.
		
	
	
		// Инициализируем точку.
		Точка = Диаграмма.УстановитьТочку(СтрокаДерева.Работа, 
											?(РаботыДругогоВладельца, Неопределено, 
												?(СтрокаДерева.РодительскаяРабота.Пустая(), 
				  									Неопределено,
													СтрокаДерева.РодительскаяРабота)));
		Если НЕ Факт Тогда
			Точка.Текст = СтрокаДерева.Работа;
		ИНаче
			ОБъемРаботыВып			= ?(СтрокаДерева.ОбъемРаботы <> 0, СтрокаДерева.ОбъемРаботыВыполненный / СтрокаДерева.ОбъемРаботы,0) * 100;			
			Точка.Текст = "" + СтрокаДерева.Работа + ?(ОБъемРаботыВып <> 0, "(" + Формат(ОБъемРаботыВып, "ЧДЦ=2") + "%)","") ;
		КонецЕсли; 
											
		
		
		Диаграмма.РазвернутьТочку(Точка, Истина);
		
		// Инициализируем значение.
		Значение = Диаграмма.ПолучитьЗначение(Точка, Серия);
		
		Если ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания) Тогда	
			 
			Значение.Редактирование = Истина;
			
			// Добавляем интервал. В данном примере у каждой работы единственный интервал.
			Интервал = Значение.Добавить();
			Интервал.Начало = ДатаНачала;
			Интервал.Конец  = ДатаОкончания;
						
			// Формируем подпись.
			//УстановитьТекстЗначения(Интервал);
						
			// Определяем статус Работы.
			Если ТипЗнч(СтрокаДерева) = Тип("ВыборкаИзРезультатаЗапроса") Тогда
				ЭтоРодитель = (СтрокаДерева.Ссылка.СуммарнаяРабота);
			Иначе
				ЭтоРодитель = (СтрокаДерева.ПолучитьЭлементы().Количество() <> 0);
			КонецЕсли;

			//Если КритическиеЗадачи и СтрокаДерева.КритическаяРабота И НЕ ЭтоРодитель Тогда
			//	Значение.Цвет	= ЦветРаботыКритическая;		
			//ИначеЕсли РаботыДругогоВладельца Тогда 
			Если Факт И НЕ ЭтоРодитель Тогда 
				Интервал.Цвет 			= ЦветСерииФакт;				
			ИНаче
				Если РаботыДругогоВладельца Тогда 
					Значение.Цвет = ЦветРаботыДругогоВладельца;
				Иначе				
					Если ЭтоРодитель Тогда
						Значение.Цвет = ЦветРодителя;				
					ИначеЕсли ДатаОкончания < ТекущаяДатаСеанса() Тогда
						Значение.Цвет = ЦветПросроченного;
					ИначеЕсли ДатаНачала < ТекущаяДатаСеанса() Тогда 		
						Значение.Цвет = ЦветНеНазначенного;
					Иначе
						Значение.Цвет = ЦветЗапланированного;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;		
			
			

			// Если надо, корректируем максимальную и минимальную даты.
			Если МаксимальнаяДата = NULL Или МаксимальнаяДата < ДатаОкончания Тогда
				МаксимальнаяДата = ДатаОкончания;
			КонецЕсли;				
			
			Если МинимальнаяДата = NULL Или МинимальнаяДата > ДатаНачала Тогда
				МинимальнаяДата = ДатаНачала;
			КонецЕсли;	
									
			// Получаем м_Связи данной работы и заносим в таблицу.
			Если НЕ РаботыДругогоВладельца И НЕ Факт Тогда 
				
				Для Каждого СтрокаДереваПред Из СтрокаДерева.Предшественники Цикл				
					Если Факт Тогда
						Продолжить;					
					КонецЕсли; 
				    
					Если ЗначениеЗаполнено(СтрокаДереваПред.РаботаПредшественник) И СтрокаДереваПред.РаботаПредшественник.ПометкаУдаления Тогда 
						Продолжить;
					КонецЕсли; 
					
					Связь = м_Связи.Добавить();
					Связь.Начало 		 = СтрокаДереваПред.РаботаПредшественник;
					Связь.Конец 		 = СтрокаДерева.Работа;
					Связь.ТипЗависимости = СтрокаДереваПред.ТипЗависимости;
				КонецЦикла;
			КонецЕсли;
			
			//ФАКТ
			Если Факт И НЕ ЭтоРодитель Тогда				
				// Добавляем интервал. В данном примере у каждой работы единственный интервал.
				Интервал = Значение.Добавить();
				Интервал.Начало = СтрокаДерева.НачалоРаботыПослеПересчета;
				Интервал.Конец  = СтрокаДерева.ОкончаниеРаботыПослеПересчета2;			
				Интервал.Расшифровка	= СтрокаДерева.Работа;
				
					// Формируем подпись.
				//УстановитьТекстЗначения(Интервал);
							
				// Определяем статус Работы.
				Если ТипЗнч(СтрокаДерева) = Тип("ВыборкаИзРезультатаЗапроса") Тогда
					ЭтоРодитель = (СтрокаДерева.Ссылка.СуммарнаяРабота);
				Иначе
					ЭтоРодитель = (СтрокаДерева.ПолучитьЭлементы().Количество() <> 0);
				КонецЕсли;

				//Если КритическиеЗадачи и СтрокаДерева.КритическаяРабота И НЕ ЭтоРодитель Тогда
				//	Значение.Цвет	= ЦветРаботыКритическая;		
				//ИначеЕсли РаботыДругогоВладельца Тогда 
				Если РаботыДругогоВладельца Тогда 
					Интервал.Цвет = ЦветРаботыДругогоВладельца;
				Иначе				
					Если ЭтоРодитель Тогда
						Интервал.Цвет = ЦветРодителя;
					ИначеЕсли Факт Тогда 
						Интервал.Цвет = ЦветСерииФакт;
					ИначеЕсли ДатаОкончания < ТекущаяДатаСеанса() Тогда
						Интервал.Цвет = ЦветПросроченного;
					ИначеЕсли ДатаНачала < ТекущаяДатаСеанса() Тогда 		
						Интервал.Цвет = ЦветНеНазначенного;
					Иначе
						Интервал.Цвет = ЦветЗапланированного;
					КонецЕсли;
				КонецЕсли;

				// Если надо, корректируем максимальную и минимальную даты.
				Если МаксимальнаяДата = NULL Или МаксимальнаяДата < ДатаОкончания Тогда
					МаксимальнаяДата = ДатаОкончания;
				КонецЕсли;				
				
				Если МинимальнаяДата = NULL Или МинимальнаяДата > ДатаНачала Тогда
					МинимальнаяДата = ДатаНачала;
				КонецЕсли;	
										
				// Получаем м_Связи данной работы и заносим в таблицу.
				Если НЕ РаботыДругогоВладельца И НЕ ФАКТ Тогда 
					
					Для Каждого СтрокаДереваПред Из СтрокаДерева.Предшественники Цикл				
						
					    //СтрокаВрем	= РеквизитФормыВЗначение(СтрокаДерева.Предшественники);
						Если ЗначениеЗаполнено(СтрокаДереваПред.РаботаПредшественник) И СтрокаДереваПред.РаботаПредшественник.ПометкаУдаления Тогда 
							Продолжить;
						КонецЕсли; 
						
						Связь = м_Связи.Добавить();
						Связь.Начало 		 = СтрокаДереваПред.РаботаПредшественник;
						Связь.Конец 		 = СтрокаДерева.Работа;
						Связь.ТипЗависимости = СтрокаДереваПред.ТипЗависимости;
					КонецЦикла;
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли; 
	
	
		Если НЕ РаботыДругогоВладельца Тогда 
			Строки = СтрокаДерева.ПолучитьЭлементы();
			Для Каждого Строка Из Строки Цикл
				ЗаполнитьОднуТочкуДиаграммыГанта(Строка, м_Связи, Серия, МаксимальнаяДата, МинимальнаяДата, Ложь, Факт);
			КонецЦикла;
			
		КонецЕсли;			
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура СоздатьСвязиНаДиаграммеГанта(м_Связи, Диаграмма, Серия, Факт = Ложь)
	
	ТекущаяТочка = NULL;
	Для Каждого Связь Из м_Связи Цикл 
		
		Если ТекущаяТочка = NULL Или ТекущаяТочка.Значение <> Связь.Конец Тогда
			ТекущаяТочка = Диаграмма.УстановитьТочку(Связь.Конец);
		КонецЕсли;			
		
		ТочкаНачала = Диаграмма.УстановитьТочку(Связь.Начало);
		Значение = Диаграмма.ПолучитьЗначение(ТочкаНачала, Серия);
		Для Каждого Интервал Из Значение Цикл
			ИнтервалНачала = Интервал;
			Если НЕ Факт Тогда
				Прервать;		
			КонецЕсли; 
		КонецЦикла;				
		Значение = Диаграмма.ПолучитьЗначение(ТекущаяТочка, Серия);
		Для Каждого Интервал Из Значение Цикл
			ИнтервалКонца = Интервал;
			Если НЕ Факт Тогда
				Прервать;		
			КонецЕсли; 
		КонецЦикла;	
		
		ИнтервалыРавны = Ложь;
		Если ИнтервалНачала <> Неопределено И ИнтервалКонца <> Неопределено Тогда
			Если (ИнтервалНачала.Значение <> Неопределено И ИнтервалКонца.Значение <> Неопределено И 
				ИнтервалНачала.Значение.Текст = ИнтервалКонца.Значение.Текст)
				И ИнтервалНачала.Конец = ИнтервалКонца.Конец 
				И ИнтервалНачала.Начало = ИнтервалКонца.Начало Тогда
				ИнтервалыРавны = Истина;
			КонецЕсли;	
		КонецЕсли;
		
		Если ИнтервалНачала = Неопределено ИЛИ ИнтервалКонца = Неопределено 
			ИЛИ ИнтервалыРавны Тогда
			Продолжить;
		КонецЕсли;
		
		СвязьДобавленная = ИнтервалНачала.Добавить(ИнтервалКонца);
		
		Если Связь.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.НачалоНачало Тогда
			СвязьДобавленная.ТипСвязи = ТипСвязиДиаграммыГанта.НачалоНачало;
		ИначеЕсли Связь.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.НачалоОкончание Тогда
			СвязьДобавленная.ТипСвязи = ТипСвязиДиаграммыГанта.НачалоКонец;
		ИначеЕсли Связь.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.ОкончаниеНачало Тогда
			СвязьДобавленная.ТипСвязи = ТипСвязиДиаграммыГанта.КонецНачало;
		ИначеЕсли Связь.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.ОкончаниеОкончание Тогда
			СвязьДобавленная.ТипСвязи = ТипСвязиДиаграммыГанта.КонецКонец;
		КонецЕсли;	
		
		//Если ИнтервалНачала.Конец <= ИнтервалКонца.Начало Тогда
		Если Факт Тогда
			СвязьДобавленная.Цвет = WebЦвета.Синий;
		Иначе			
			СвязьДобавленная.Цвет = WebЦвета.Коричневый;
		КонецЕсли;			
		
	КонецЦикла;				
	
КонецПроцедуры // СоздатьСвязи(м_Связи, Диаграмма, Серия)

