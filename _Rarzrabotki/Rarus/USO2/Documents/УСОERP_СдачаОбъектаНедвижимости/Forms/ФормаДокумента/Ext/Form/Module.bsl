// Функция проверяет заполнение необходимых реквизитов и возвращает результат данной проверки.
//
Функция ПроверитьЗаполнениеРеквизитовДляРаспределенияДанных()
	
	Отказ = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.ГруппаНоменклатуры) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Поле ""Группа"" не заполнено'"), Объект.Ссылка, "ГруппаНоменклатуры", "Объект", Отказ);  	
	КонецЕсли;
	
	Возврат Отказ;
	
КонецФункции // ПроверитьЗаполнениеРеквизитовДляРаспределенияДанных()

&НаСервере
Процедура ЗаполнитьНаправленияДеятельностиНаСервере()
	
   	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрочиеРасходы.Подразделение КАК Подразделение,
	|	ПрочиеРасходы.СтатьяРасходов КАК СтатьяРасходов,
	|	СУММА(ПрочиеРасходы.СуммаОстаток) КАК Сумма,
	|	СУММА(ПрочиеРасходы.СуммаБезНДСОстаток) КАК СуммаБезНДС,
	|	ПрочиеРасходы.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	СУММА(ПрочиеРасходы.СуммаРеглОстаток) КАК СуммаБУ,
	|	СУММА(ПрочиеРасходы.СуммаРеглОстаток - ПрочиеРасходы.ПостояннаяРазницаОстаток - ПрочиеРасходы.ВременнаяРазницаОстаток) КАК СуммаНУ,
	|	СУММА(ПрочиеРасходы.ПостояннаяРазницаОстаток) КАК СуммаПР,
	|	СУММА(ПрочиеРасходы.ВременнаяРазницаОстаток) КАК СуммаВР,
	|	СУММА(ПрочиеРасходы.СуммаУпрОстаток) КАК СуммаУУ,
	|	ЕСТЬNULL(ВложенныйЗапрос.Значение, ЗНАЧЕНИЕ(Перечисление.УСОERP_СпособыРаспределенияЗатратПоНаправлениямДеятельности.ПустаяСсылка)) КАК СпособРаспределения
	|ПОМЕСТИТЬ ТЧ_НаправленияДеятельности
	|ИЗ
	|	РегистрНакопления.ПрочиеРасходы.Остатки(
	|			&КонецПериода,
	|			СтатьяРасходов.СчетУчета В ИЕРАРХИИ (&СчетУчета)
	|				И Организация = &Организация
	|				И АналитикаРасходов = &ОбъектСтроительства) КАК ПрочиеРасходы
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			НаправленияДеятельностиДополнительныеРеквизиты.Значение КАК Значение,
	|			НаправленияДеятельностиДополнительныеРеквизиты.Ссылка КАК Ссылка
	|		ИЗ
	|			Справочник.НаправленияДеятельности.ДополнительныеРеквизиты КАК НаправленияДеятельностиДополнительныеРеквизиты
	|		ГДЕ
	|			НаправленияДеятельностиДополнительныеРеквизиты.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.УСОERP_СпособРаспределенияПоНаправлениямДеятельности)) КАК ВложенныйЗапрос
	|		ПО ПрочиеРасходы.НаправлениеДеятельности = ВложенныйЗапрос.Ссылка
	|ГДЕ
	|	(ПрочиеРасходы.СуммаРеглОстаток <> 0
	|			ИЛИ ПрочиеРасходы.ПостояннаяРазницаОстаток <> 0
	|			ИЛИ ПрочиеРасходы.СуммаУпрОстаток <> 0
	|			ИЛИ ПрочиеРасходы.ВременнаяРазницаОстаток <> 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрочиеРасходы.Подразделение,
	|	ПрочиеРасходы.СтатьяРасходов,
	|	ПрочиеРасходы.НаправлениеДеятельности,
	|	ЕСТЬNULL(ВложенныйЗапрос.Значение, ЗНАЧЕНИЕ(Перечисление.УСОERP_СпособыРаспределенияЗатратПоНаправлениямДеятельности.ПустаяСсылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Хозрасчетный.ПодразделениеДт КАК Подразделение,
	|	Хозрасчетный.СубконтоДт2 КАК СтатьяРасходов,
	|	Хозрасчетный.НаправлениеДеятельностиДт КАК НаправлениеДеятельности,
	|	СУММА(Хозрасчетный.СуммаОборот) КАК СуммаИнвестиционногоНДС
	|ПОМЕСТИТЬ ИнвестиционныйНДС
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(
	|			,
	|			&КонецПериода,
	|			Авто,
	|			СчетДт В (&СчетУчета),
	|			&ВидыСубконто,
	|			СчетКт В (&СчетаУчетаНДС)
	|				ИЛИ СчетКт В (&КорСчетУчета),
	|			,
	|			Организация = &Организация
	|				И СубконтоДт1 = &ОбъектСтроительства) КАК Хозрасчетный
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_ПараметрыРаспределенияНДСВСтроительстве.СрезПоследних(&КонецПериода, Организация = &Организация) КАК ПараметрыРаспределенияНДС
	|		ПО Хозрасчетный.СчетКт = ПараметрыРаспределенияНДС.СчетЗатрат
	|ГДЕ
	|	ВЫБОР
	|			КОГДА Хозрасчетный.СчетКт В (&КорСчетУчета)
	|				ТОГДА ВЫБОР
	|						КОГДА ЕСТЬNULL(ПараметрыРаспределенияНДС.ДопАналитика1, ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка)) = Хозрасчетный.СубконтоДт2
	|								И ЕСТЬNULL(ПараметрыРаспределенияНДС.ДопАналитика1, ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка)) <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка)
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ ЛОЖЬ
	|					КОНЕЦ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	Хозрасчетный.НаправлениеДеятельностиДт,
	|	Хозрасчетный.ПодразделениеДт,
	|	Хозрасчетный.СубконтоДт2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧ_НаправленияДеятельности.Подразделение,
	|	ТЧ_НаправленияДеятельности.СтатьяРасходов,
	|	СУММА(ТЧ_НаправленияДеятельности.Сумма) КАК Сумма,
	|	СУММА(ТЧ_НаправленияДеятельности.СуммаБезНДС) КАК СуммаБезНДС,
	|	ТЧ_НаправленияДеятельности.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	СУММА(ТЧ_НаправленияДеятельности.СуммаБУ) КАК СуммаБУ,
	|	СУММА(ТЧ_НаправленияДеятельности.СуммаНУ) КАК СуммаНУ,
	|	СУММА(ТЧ_НаправленияДеятельности.СуммаПР) КАК СуммаПР,
	|	СУММА(ТЧ_НаправленияДеятельности.СуммаВР) КАК СуммаВР,
	|	СУММА(ТЧ_НаправленияДеятельности.СуммаУУ) КАК СуммаУУ,
	|	ТЧ_НаправленияДеятельности.СпособРаспределения,
	|	СУММА(ЕСТЬNULL(ИнвестиционныйНДС.СуммаИнвестиционногоНДС, 0)) КАК СуммаИнвестиционногоНДС
	|ИЗ
	|	ТЧ_НаправленияДеятельности КАК ТЧ_НаправленияДеятельности
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИнвестиционныйНДС КАК ИнвестиционныйНДС
	|		ПО ТЧ_НаправленияДеятельности.Подразделение = ИнвестиционныйНДС.Подразделение
	|			И ТЧ_НаправленияДеятельности.НаправлениеДеятельности = ИнвестиционныйНДС.НаправлениеДеятельности
	|			И ТЧ_НаправленияДеятельности.СтатьяРасходов = ИнвестиционныйНДС.СтатьяРасходов
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧ_НаправленияДеятельности.Подразделение,
	|	ТЧ_НаправленияДеятельности.СтатьяРасходов,
	|	ТЧ_НаправленияДеятельности.НаправлениеДеятельности,
	|	ТЧ_НаправленияДеятельности.СпособРаспределения
	|
	|УПОРЯДОЧИТЬ ПО
	|	СуммаБУ,
	|	НаправлениеДеятельности";
	
	Запрос.УстановитьПараметр("Регистратор", Объект.Ссылка);
	
	Счет0833 = Справочники.УСОERP_ПредопределенныеЭлементы.СчетУчетаОбъектовНедвижимости.Значение;
	Запрос.УстановитьПараметр("СчетУчета", Счет0833);
	
	СчетаУчетаНДС = Новый Массив;
	СчетаУчетаНДС.Добавить(ПланыСчетов.Хозрасчетный.НДСпоПриобретеннымМПЗ);
	СчетаУчетаНДС.Добавить(ПланыСчетов.Хозрасчетный.НДСпоПриобретеннымУслугам);
	Запрос.УстановитьПараметр("СчетаУчетаНДС",	СчетаУчетаНДС);
	Запрос.УстановитьПараметр("КорСчетУчета", 	ПланыСчетов.Хозрасчетный.НайтиПоКоду("20.07.1"));
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ОбъектыСтроительства);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.СтатьиЗатрат);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ОбъектСтроительства", Объект.ОбъектСтроительства);
	//Запрос.УстановитьПараметр("СтатьяРасходов", Объект.СтатьяРасходов);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	РезультатСвертка = Результат.Скопировать(, "НаправлениеДеятельности, СуммаБУ, СуммаНУ, СуммаВР, СуммаПР, СуммаУУ, СпособРаспределения, СуммаИнвестиционногоНДС");
	РезультатСвертка.Свернуть("НаправлениеДеятельности, СпособРаспределения", "СуммаБУ, СуммаНУ, СуммаВР, СуммаПР, СуммаУУ,  СуммаИнвестиционногоНДС");
	Объект.НаправленияДеятельности.Загрузить(РезультатСвертка);
	
	Объект.ДетализацияПоНаправлениямДеятельности.Загрузить(Результат);

				   
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаправленияДеятельности(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.ОбъектСтроительства) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен объект строительства",,"ОбъектСтроительства","Объект.ОбъектСтроительства");
		Возврат;
		
	КонецЕсли; 	
	
	Если Объект.НаправленияДеятельности.Количество() Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьНаправленияДеятельностиПродолжение",ЭтотОбъект),"Табличная часть будет очищена, продолжить?",РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьНаправленияДеятельностиПродолжение(КодВозвратаДиалога.Да,Новый Структура);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаправленияДеятельностиПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНаправленияДеятельностиНаСервере();
	
	Модифицированность = Истина;
	
КонецПроцедуры 	

&НаКлиенте
