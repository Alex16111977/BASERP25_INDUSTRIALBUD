		|	ТаблицаОбъектов.ПаркингПР,
		|	ТаблицаОбъектов.ПаркингВР,
		|	ТаблицаОбъектов.ПаркингУУ,
		|	ТаблицаОбъектов.УслугиЗаказчикаНУ,
		|	ТаблицаОбъектов.УслугиЗаказчикаПР,
		|	ТаблицаОбъектов.УслугиЗаказчикаВР,
		|	ТаблицаОбъектов.УслугиЗаказчикаУУ,
		|	ТаблицаОбъектов.Подразделение,
		|	ТаблицаОбъектов.СтатьяРасходов,
		|	ТаблицаОбъектов.НаправлениеДеятельности,
		|	ТаблицаОбъектов.СуммаИнвестиционногоНДС
		|ПОМЕСТИТЬ ОбъектыНедвижимости
		|ИЗ
		|	&ТаблицаОбъектов КАК ТаблицаОбъектов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОбъектыНедвижимости.ОбъектНедвижимости,
		|	ОбъектыНедвижимости.ПлощадьПроектная,
		|	ОбъектыНедвижимости.ПлощадьФактическая КАК ПлощадьФактическая,
		//|	ВЫБОР
		//|		КОГДА ЕСТЬNULL(СоответствиеДоговоровИДолей.Регистратор, ЗНАЧЕНИЕ(Документ.УПН_ДоговорПоНедвижимости.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Документ.УПН_ДоговорПоНедвижимости.ПустаяСсылка)
		//|				И СоответствиеДоговоровИДолей.Регистратор ССЫЛКА Документ.УПН_ДоговорПоНедвижимости
		//|				И &ДатаСтрСоцИнфр > СоответствиеДоговоровИДолей.Регистратор.ДатаДоговора
		//|			ТОГДА 0
		//|		ИНАЧЕ
		|
		|	ОбъектыНедвижимости.ПлощадьФактическая КАК ПлощадиРаспределения,
		|	ОбъектыНедвижимости.СуммаЗатрат,
		|	ОбъектыНедвижимости.СуммаЗатратНУ,
		|	ОбъектыНедвижимости.СуммаЗатратПР,
		|	ОбъектыНедвижимости.СуммаЗатратВР,
		|	ОбъектыНедвижимости.СуммаЗатратУУ,
		|	ОбъектыНедвижимости.ВидОперации,
		|	ОбъектыНедвижимости.Контрагент,
		|	ОбъектыНедвижимости.Договор,
		|	ОбъектыНедвижимости.ОбъектСтроительства,
		|	ОбъектыНедвижимости.ЖилыеПомещения,
		|	ОбъектыНедвижимости.НежилыеПомещения,
		|	ОбъектыНедвижимости.Паркинг,
		|	ОбъектыНедвижимости.УслугиЗаказчика,
		|	ОбъектыНедвижимости.ОбъектСтроительстваНУ,
		|	ОбъектыНедвижимости.ОбъектСтроительстваПР,
		|	ОбъектыНедвижимости.ОбъектСтроительстваВР,
		|	ОбъектыНедвижимости.ОбъектСтроительстваУУ,
		|	ОбъектыНедвижимости.ЖилыеПомещенияНУ,
		|	ОбъектыНедвижимости.ЖилыеПомещенияПР,
		|	ОбъектыНедвижимости.ЖилыеПомещенияВР,
		|	ОбъектыНедвижимости.ЖилыеПомещенияУУ,
		|	ОбъектыНедвижимости.НежилыеПомещенияНУ,
		|	ОбъектыНедвижимости.НежилыеПомещенияПР,
		|	ОбъектыНедвижимости.НежилыеПомещенияВР,
		|	ОбъектыНедвижимости.НежилыеПомещенияУУ,
		|	ОбъектыНедвижимости.ПаркингНУ,
		|	ОбъектыНедвижимости.ПаркингПР,
		|	ОбъектыНедвижимости.ПаркингВР,
		|	ОбъектыНедвижимости.ПаркингУУ,
		|	ОбъектыНедвижимости.УслугиЗаказчикаНУ,
		|	ОбъектыНедвижимости.УслугиЗаказчикаПР,
		|	ОбъектыНедвижимости.УслугиЗаказчикаВР,
		|	ОбъектыНедвижимости.УслугиЗаказчикаУУ,
		|	ОбъектыНедвижимости.Подразделение,
		|	ОбъектыНедвижимости.СтатьяРасходов,
		|	ОбъектыНедвижимости.НаправлениеДеятельности,
		|	ОбъектыНедвижимости.СуммаИнвестиционногоНДС,
		|	СоответствиеДоговоровИДолей.Регистратор
		|ИЗ
		|	ОбъектыНедвижимости КАК ОбъектыНедвижимости
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_СоответствиеДоговоровИДолей.СрезПоследних(
		|				&КонецПериода,
		|				ВЫБОР
		|					КОГДА Регистратор ССЫЛКА Документ.УПН_ДоговорПоНедвижимости
		|						ТОГДА Регистратор.УСОERP_ВидДоговора В (ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыДоговоровПоНедвижимости.ДоговорДолевогоУчастия), ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыДоговоровПоНедвижимости.ИнвестиционныйДоговор))
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ) КАК СоответствиеДоговоровИДолей
		|		ПО ОбъектыНедвижимости.ОбъектНедвижимости = СоответствиеДоговоровИДолей.Доля
		|			И ОбъектыНедвижимости.Договор = СоответствиеДоговоровИДолей.Договор
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НаправленияДеятельности КАК НаправленияДеятельности
		|		ПО ОбъектыНедвижимости.НаправлениеДеятельности = НаправленияДеятельности.Ссылка";
	
	Запрос.УстановитьПараметр("КонецПериода",		Объект.Дата);
	Запрос.УстановитьПараметр("ТаблицаОбъектов",	Объект.ДетализацияПоОбъектамНедвижимости.Выгрузить());
	ТаблицаОбъектов = Запрос.Выполнить().Выгрузить();
	
	ТаблицаПараметров = Объект.ДетализацияПоНаправлениямДеятельности.Выгрузить();
	
	ТаблицаОбъектов.Колонки.Добавить("ТипНедвижимости", Новый ОписаниеТипов("ПеречислениеСсылка.УПН_ТипыНедвижимости"));
	
	Массив_ВсеОбъекты = ТаблицаОбъектов.ВыгрузитьКолонку("ПлощадиРаспределения");
	Если Массив_ВсеОбъекты.Количество()> 0 Тогда
		Если Объект.ОбъектыНедвижимости.Количество()>0
			И Объект.ДетализацияПоОбъектамНедвижимости[Объект.ДетализацияПоОбъектамНедвижимости.Количество()-1].ОбъектНедвижимости.КатегорияОбъекта = Перечисления.АУН_КатегорииОбъектовНедвижимости.Здание Тогда
			Массив_ВсеОбъекты[Массив_ВсеОбъекты.ВГраница()] = 0;
		КонецЕсли;
	КонецЕсли;
	
	Массив_Жилая 			= Новый Массив;
	Массив_Нежилая 			= Новый Массив;
	Массив_Паркинг 			= Новый Массив;
	Массив_НежилаяИПаркинг 	= Новый Массив;
	Массив_ЖилаяИПаркинг 	= Новый Массив;
	Массив_ЖилаяИНежилая 	= Новый Массив;
	Массив_ИнвестиционныйНДС = Новый Массив;	
	
	ТипЖилая = Перечисления.УПН_ТипыНедвижимости.Жилая;
	ТипНежилая = Перечисления.УПН_ТипыНедвижимости.Коммерческая;
	ТипПаркинг = Перечисления.УПН_ТипыНедвижимости.ГаражМашиноместо;
	
	Для Каждого СтрОбъект Из ТаблицаОбъектов Цикл
				
		СтрОбъект.ТипНедвижимости = СтрОбъект.ОбъектНедвижимости.ТипНедвижимости;
		Если СтрОбъект.ТипНедвижимости  = ТипЖилая Тогда
			Массив_Жилая.Добавить(СтрОбъект.ПлощадьФактическая);
			Массив_Нежилая.Добавить(0);
			Массив_Паркинг.Добавить(0);
			Массив_НежилаяИПаркинг.Добавить(0);
			Массив_ЖилаяИПаркинг.Добавить(СтрОбъект.ПлощадьФактическая);
			Массив_ЖилаяИНежилая.Добавить(СтрОбъект.ПлощадьФактическая);
			Массив_ИнвестиционныйНДС.Добавить(СтрОбъект.ПлощадьФактическая);
		ИначеЕсли ЗначениеЗаполнено(СтрОбъект.Регистратор) Тогда
			Массив_ИнвестиционныйНДС.Добавить(СтрОбъект.ПлощадьФактическая);
			Если СтрОбъект.ТипНедвижимости  = ТипНежилая Тогда
				Массив_Жилая.Добавить(0);
				Массив_Нежилая.Добавить(СтрОбъект.ПлощадьФактическая);
				Массив_Паркинг.Добавить(0);
				Массив_НежилаяИПаркинг.Добавить(СтрОбъект.ПлощадьФактическая);
				Массив_ЖилаяИПаркинг.Добавить(0);
				Массив_ЖилаяИНежилая.Добавить(СтрОбъект.ПлощадьФактическая);
			ИначеЕсли СтрОбъект.ТипНедвижимости  = ТипПаркинг Тогда
				Массив_Жилая.Добавить(0);
				Массив_Нежилая.Добавить(0);
				Массив_Паркинг.Добавить(СтрОбъект.ПлощадьФактическая);
				Массив_НежилаяИПаркинг.Добавить(СтрОбъект.ПлощадьФактическая);
				Массив_ЖилаяИПаркинг.Добавить(СтрОбъект.ПлощадьФактическая);
				Массив_ЖилаяИНежилая.Добавить(0);
			КонецЕсли;			
		ИначеЕсли СтрОбъект.ТипНедвижимости  = ТипНежилая Тогда
			Массив_Жилая.Добавить(0);
			Массив_Нежилая.Добавить(СтрОбъект.ПлощадьФактическая);
			Массив_Паркинг.Добавить(0);
			Массив_НежилаяИПаркинг.Добавить(СтрОбъект.ПлощадьФактическая);
			Массив_ЖилаяИПаркинг.Добавить(0);
			Массив_ЖилаяИНежилая.Добавить(СтрОбъект.ПлощадьФактическая);
			Массив_ИнвестиционныйНДС.Добавить(0);
		ИначеЕсли СтрОбъект.ТипНедвижимости  = ТипПаркинг Тогда
			Массив_Жилая.Добавить(0);
			Массив_Нежилая.Добавить(0);
			Массив_Паркинг.Добавить(СтрОбъект.ПлощадьФактическая);
			Массив_НежилаяИПаркинг.Добавить(СтрОбъект.ПлощадьФактическая);
			Массив_ЖилаяИПаркинг.Добавить(СтрОбъект.ПлощадьФактическая);
			Массив_ЖилаяИНежилая.Добавить(0);
			Массив_ИнвестиционныйНДС.Добавить(0);
		КонецЕсли;	
	КонецЦикла;
	
	Способ_НаВсеОбъекты 		= Перечисления.УСОERP_СпособыРаспределенияЗатратПоНаправлениямДеятельности.НаВсеОбъекты;
	Способ_НаЖилыеИНежилые 		= Перечисления.УСОERP_СпособыРаспределенияЗатратПоНаправлениямДеятельности.НаЖилыеИНежилые;
	Способ_НаЖилыеИПаркинг 		= Перечисления.УСОERP_СпособыРаспределенияЗатратПоНаправлениямДеятельности.НаЖилыеИПаркинг;
	Способ_НаЖилыеПомещения 	= Перечисления.УСОERP_СпособыРаспределенияЗатратПоНаправлениямДеятельности.НаЖилыеПомещения;
	Способ_НаНежилыеИПаркинг 	= Перечисления.УСОERP_СпособыРаспределенияЗатратПоНаправлениямДеятельности.НаНежилыеИПаркинг;
	Способ_НаНежилыеПомещения 	= Перечисления.УСОERP_СпособыРаспределенияЗатратПоНаправлениямДеятельности.НаНежилыеПомещения;
	Способ_НаПаркинг 			= Перечисления.УСОERP_СпособыРаспределенияЗатратПоНаправлениямДеятельности.НаПаркинг;
		
	Для Каждого СтрСтоимость Из  ТаблицаПараметров Цикл
		
		МассивВсеОбъекты 		= ПолучитьМассивРаспределенияПоСтатьямРасходов(ТаблицаОбъектов, СтрСтоимость.СтатьяРасходов, СтрСтоимость.Подразделение, СтрСтоимость.НаправлениеДеятельности, Массив_ВсеОбъекты);
		МассивЖилая 			= ПолучитьМассивРаспределенияПоСтатьямРасходов(ТаблицаОбъектов, СтрСтоимость.СтатьяРасходов, СтрСтоимость.Подразделение, СтрСтоимость.НаправлениеДеятельности, Массив_Жилая);
		МассивНежилая 			= ПолучитьМассивРаспределенияПоСтатьямРасходов(ТаблицаОбъектов, СтрСтоимость.СтатьяРасходов, СтрСтоимость.Подразделение, СтрСтоимость.НаправлениеДеятельности, Массив_Нежилая);
		МассивПаркинг 			= ПолучитьМассивРаспределенияПоСтатьямРасходов(ТаблицаОбъектов, СтрСтоимость.СтатьяРасходов, СтрСтоимость.Подразделение, СтрСтоимость.НаправлениеДеятельности, Массив_Паркинг);
		МассивНежилаяИПаркинг 	= ПолучитьМассивРаспределенияПоСтатьямРасходов(ТаблицаОбъектов, СтрСтоимость.СтатьяРасходов, СтрСтоимость.Подразделение, СтрСтоимость.НаправлениеДеятельности, Массив_НежилаяИПаркинг);
		МассивЖилаяИПаркинг 	= ПолучитьМассивРаспределенияПоСтатьямРасходов(ТаблицаОбъектов, СтрСтоимость.СтатьяРасходов, СтрСтоимость.Подразделение, СтрСтоимость.НаправлениеДеятельности, Массив_ЖилаяИПаркинг);
		МассивЖилаяИНежилая 	= ПолучитьМассивРаспределенияПоСтатьямРасходов(ТаблицаОбъектов, СтрСтоимость.СтатьяРасходов, СтрСтоимость.Подразделение, СтрСтоимость.НаправлениеДеятельности, Массив_ЖилаяИНежилая);
		МассивИнвестиционныйНДС = ПолучитьМассивРаспределенияПоСтатьямРасходов(ТаблицаОбъектов, СтрСтоимость.СтатьяРасходов, СтрСтоимость.Подразделение, СтрСтоимость.НаправлениеДеятельности, Массив_ИнвестиционныйНДС);	
				
		МассивСуммИнвестиционныйНДС = Новый Массив;
		ЗаполнитьРаспределениеИнвестиционногоНДС(СтрСтоимость, МассивИнвестиционныйНДС, ТаблицаОбъектов, МассивСуммИнвестиционныйНДС);
				
		Строки = Объект.НаправленияДеятельности.Выгрузить().НайтиСтроки(Новый Структура("НаправлениеДеятельности", СтрСтоимость.НаправлениеДеятельности));
		Если Строки.Количество() Тогда
			СтрСтоимость.СпособРаспределения = Строки[0].СпособРаспределения;
		Иначе
			СтрСтоимость.СпособРаспределения = Способ_НаВсеОбъекты;
		КонецЕсли;
		
		МассивСумм = Новый Массив;
		МассивСуммНУ = Новый Массив;
		МассивСуммПР = Новый Массив;
		МассивСуммВР = Новый Массив;
		МассивСуммУУ = Новый Массив;
						
		Если СтрСтоимость.СпособРаспределения = Способ_НаВсеОбъекты Тогда
			
			МассивСумм = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СтрСтоимость.СуммаБУ -  СтрСтоимость.СуммаИнвестиционногоНДС, МассивВсеОбъекты, 2); 
			МассивСуммНУ = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СтрСтоимость.СуммаНУ - СтрСтоимость.СуммаИнвестиционногоНДС, МассивВсеОбъекты, 2); 
			МассивСуммПР = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СтрСтоимость.СуммаПР, МассивВсеОбъекты, 2); 
			МассивСуммВР = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СтрСтоимость.СуммаВР, МассивВсеОбъекты, 2); 
