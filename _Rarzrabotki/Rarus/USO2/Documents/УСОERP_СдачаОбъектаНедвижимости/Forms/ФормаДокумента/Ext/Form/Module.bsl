		|	ДанныеТЧ.СуммаЗатратВР,
		|	ДанныеТЧ.СуммаЗатратУУ,
		|	ДанныеТЧ.СчетРасчетов,
		|	ДанныеТЧ.Контрагент,
		|	ДанныеТЧ.Договор,
		|	ДанныеТЧ.УслугиЗаказчика,
		|	ДанныеТЧ.УслугиЗаказчикаНУ,
		|	ДанныеТЧ.УслугиЗаказчикаПР,
		|	ДанныеТЧ.УслугиЗаказчикаВР,
		|	ДанныеТЧ.УслугиЗаказчикаУУ,
		|	ДанныеТЧ.СтоимостьПоДоговору,
		|	ДанныеТЧ.СтоимостьПоДоговоруНУ,
		|	ДанныеТЧ.СтоимостьПоДоговоруПР,
		|	ДанныеТЧ.СтоимостьПоДоговоруВР,
		|	ДанныеТЧ.СтоимостьПоДоговоруУУ,
		|	ДанныеТЧ.Выручка,
		|	ДанныеТЧ.НДС
		|ПОМЕСТИТЬ ДанныеТЧ_СОтбором
		|ИЗ
		|	ДанныеТЧ КАК ДанныеТЧ
		|ГДЕ
		|	ДанныеТЧ.НДС <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗакрытиеОбъектаСтроительства.Организация,
		|	ДанныеТЧ_СОтбором.Контрагент,
		|	ЗакрытиеОбъектаСтроительства.Дата,
		|	ЗакрытиеОбъектаСтроительства.ОбъектСтроительства КАК УСОERP_ОбъектЭксплуатации,
		|	ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПрочееНачислениеНДС) КАК ХозяйственнаяОперация,
		|	ДанныеТЧ_СОтбором.СтоимостьПоДоговору - ДанныеТЧ_СОтбором.СуммаЗатрат - ДанныеТЧ_СОтбором.УслугиЗаказчика КАК Сумма,
		|	ДанныеТЧ_СОтбором.СтоимостьПоДоговору - ДанныеТЧ_СОтбором.СуммаЗатрат - ДанныеТЧ_СОтбором.УслугиЗаказчика КАК СуммаДокумента,
		|	1 КАК Количество,
		|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18) КАК СтавкаНДС,
		|	ДанныеТЧ_СОтбором.НДС КАК СуммаНДС,
		|	ЗНАЧЕНИЕ(Перечисление.СобытияПоНДСПродажи.Реализация) КАК Событие,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыЦенностей.ОбъектыНезавершенногоСтроительства) КАК ВидЦенности,
		|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Продажи_НДС) КАК СчетУчета,
		|	ЗакрытиеОбъектаСтроительства.НоменклатурнаяГруппа КАК Субконто1,
		|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18) КАК Субконто2,
		|	НЕОПРЕДЕЛЕНО КАК Субконто3,
		|	ЗакрытиеОбъектаСтроительства.НоменклатураУслугЗаказчикаЗастройщика КАК Номенклатура
		|ПОМЕСТИТЬ ДанныеИтог
		|ИЗ
		|	Документ.УСОERP_СдачаОбъектаНедвижимости КАК ЗакрытиеОбъектаСтроительства
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеТЧ_СОтбором КАК ДанныеТЧ_СОтбором
		|		ПО (ИСТИНА)
		|ГДЕ
		|	ЗакрытиеОбъектаСтроительства.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеИтог.Организация,
		|	ДанныеИтог.Контрагент,
		|	ДанныеИтог.Дата,
		|	ДанныеИтог.УСОERP_ОбъектЭксплуатации,
		|	ДанныеИтог.ХозяйственнаяОперация,
		|	ДанныеИтог.Сумма,
		|	ДанныеИтог.СуммаДокумента,
		|	ДанныеИтог.Количество,
		|	ДанныеИтог.СтавкаНДС,
		|	ДанныеИтог.СуммаНДС,
		|	ДанныеИтог.Событие,
		|	ДанныеИтог.ВидЦенности,
		|	ДанныеИтог.СчетУчета,
		|	ДанныеИтог.Субконто1,
		|	ДанныеИтог.Субконто2,
		|	ДанныеИтог.Субконто3,
		|	ДанныеИтог.Номенклатура,
		|	ЕСТЬNULL(ЗаписьКнигиПродаж.Ссылка, ЗНАЧЕНИЕ(Документ.ЗаписьКнигиПродаж.ПустаяСсылка)) КАК ЗаписьКнигиПродаж
		|ИЗ
		|	ДанныеИтог КАК ДанныеИтог
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаписьКнигиПродаж КАК ЗаписьКнигиПродаж
		|		ПО ДанныеИтог.Дата = ЗаписьКнигиПродаж.Дата
		|			И ДанныеИтог.Организация = ЗаписьКнигиПродаж.Организация
		|			И ДанныеИтог.Контрагент = ЗаписьКнигиПродаж.Контрагент
		|			И ДанныеИтог.УСОERP_ОбъектЭксплуатации = ЗаписьКнигиПродаж.УСОERP_ОбъектЭксплуатации
		|			И (ДанныеИтог.СуммаДокумента + ДанныеИтог.СуммаНДС = ЗаписьКнигиПродаж.СуммаДокумента)
		|			И (ДанныеИтог.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПрочееНачислениеНДС))
		|			И (ЗаписьКнигиПродаж.Проведен)";
		
	Запрос.УстановитьПараметр("Ссылка", 			Объект.Ссылка);
	Запрос.УстановитьПараметр("ТЧСдачаИнвестору", 	Объект.СдачаИнвестору.Выгрузить());
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			Продолжить;
		КонецЕсли;
				
		Если Не ЗначениеЗаполнено(Выборка.ЗаписьКнигиПродаж) Тогда 
			
			НовыйДокумент = Документы.ЗаписьКнигиПродаж.СоздатьДокумент();
			
			ЗаполнитьЗначенияСвойств(НовыйДокумент, Выборка);
			НовыйДокумент.Валюта = Валюта;
			
			НоваяСтрокаТЧДокумента = НовыйДокумент.Ценности.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧДокумента, Выборка);
			
			Попытка
				
				НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
				НоваяСтрокаТЧОбъекта = Объект.СчетФактуры.Добавить();
				НоваяСтрокаТЧОбъекта.ЗаписьКнигиПродаж = НовыйДокумент.Ссылка;
				
				НоваяСчетФактура = Документы.СчетФактураВыданный.СоздатьДокумент();
				НоваяСчетФактура.ДокументОснование = НовыйДокумент.Ссылка;
				СтрокаТЧСчетФактура = НоваяСчетФактура.ДокументыОснования.Добавить();
				СтрокаТЧСчетФактура.ДокументОснование = НовыйДокумент.Ссылка;
				
				НоваяСчетФактура.ЗаполнитьПараметрыСчетаФактурыПоОснованию(НоваяСчетФактура.Ссылка);
				НоваяСчетФактура.ДатаВыставления = НовыйДокумент.Дата;
				НоваяСчетФактура.Записать(РежимЗаписиДокумента.Проведение);
				
			Исключение
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
				
			КонецПопытки;
			
		Иначе
			
			НоваяСтрокаТЧОбъекта = Объект.СчетФактуры.Добавить();
			НоваяСтрокаТЧОбъекта.ЗаписьКнигиПродаж = Выборка.ЗаписьКнигиПродаж;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Модифицированность = Истина;	

КонецПроцедуры

&НаКлиенте
Процедура СформироватьСчетаФактуры(Команда)
	СформироватьСчетаФактурыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСдачуИнвестору(Команда)
	ЗаполнитьСдачуИнвесторуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НаправленияДеятельностиПриАктивизацииСтроки(Элемент)
	
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		Элементы.ДетализацияПоНаправлениямДеятельности.ОтборСтрок = Новый ФиксированнаяСтруктура("НаправлениеДеятельности", Элемент.ТекущиеДанные.НаправлениеДеятельности);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбъектыНедвижимостиПриАктивизацииСтроки(Элемент)
	
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		Элементы.ДетализацияПоОбъектамНедвижимости.ОтборСтрок = Новый ФиксированнаяСтруктура("ОбъектНедвижимости", Элемент.ТекущиеДанные.ОбъектНедвижимости);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НаправленияДеятельностиПередУдалением(Элемент, Отказ)
	
	ТекСтрока = Элемент.ТекущиеДанные;
	
	Строки = Объект.ДетализацияПоНаправлениямДеятельности.НайтиСтроки(Новый Структура("НаправлениеДеятельности",ТекСтрока.НаправлениеДеятельности));
	
	Для Каждого НайденнаяСтрока Из Строки Цикл
		
		Объект.ДетализацияПоНаправлениямДеятельности.Удалить(НайденнаяСтрока);
		
	КонецЦикла; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыНедвижимостиПередУдалением(Элемент, Отказ)
	
	ТекСтрока = Элемент.ТекущиеДанные;
	
	Строки = Объект.ДетализацияПоОбъектамНедвижимости.НайтиСтроки(Новый Структура("ОбъектНедвижимости",ТекСтрока.ОбъектНедвижимости));
	
	Для Каждого НайденнаяСтрока Из Строки Цикл
		
		Объект.ДетализацияПоОбъектамНедвижимости.Удалить(НайденнаяСтрока);
		
	КонецЦикла; 	

КонецПроцедуры

#КонецОбласти


