
#Область ОбработчикиСобытийФормы

&НаСервере
// Процедура - обработчик события "ПриСозданииНаСервере" формы документа.
//
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма); 	
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтаФорма, ДополнительныеПараметры);
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 

	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры // ПриСозданииНаСервере()

&НаСервере
// Процедура - обработчик события "ПриЧтенииНаСервере" формы документа.
//
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриЧтенииСозданииНаСервере();
	
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	МодификацияКонфигурацииПереопределяемый.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);

КонецПроцедуры // ПриЧтенииНаСервере()

&НаСервере
// Процедура - обработчик события "ОбработкаПроверкиЗаполненияНаСервере" формы документа.
//
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
	
КонецПроцедуры // ОбработкаПроверкиЗаполненияНаСервере()

&НаСервере
// Процедура - обработчик события "ПередЗаписьюНаСервере" формы документа.
//
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи) 
	
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);

КонецПроцедуры // ПередЗаписьюНаСервере()

&НаСервере
// Процедура - обработчик события "ПослеЗаписиНаСервере" формы документа.
//
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	//Элементы.ГруппаКомментарий.Картинка = ОбщегоНазначения.ПолучитьКартинкуКомментария(Объект.Комментарий);
	МодификацияКонфигурацииПереопределяемый.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);

КонецПроцедуры // ПослеЗаписиНаСервере()

&НаКлиенте
// Процедура - обработчик события "ОбработкаОповещения" формы документа.
//
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтаФорма, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
	КонецЕсли;

КонецПроцедуры // ОбработкаОповещения()

&НаКлиенте
// Процедура - обработчик события "ПослеЗаписи" формы документа.
//
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	МодификацияКонфигурацииКлиентПереопределяемый.ПослеЗаписи(ЭтаФорма, ПараметрыЗаписи);

КонецПроцедуры // ПослеЗаписи()

#КонецОбласти

#Область ОбработчикиСобытийШапкиФормы

&НаКлиенте
// Процедура - обработчик события "ПриИзменении" флажка восстановления НДС.
//
Процедура ВосстанавливатьНДСПриИзменении(Элемент)
	
	ВосстанавливатьНДСПриИзмененииНаСервере();
	
КонецПроцедуры // ВосстанавливатьНДСПриИзменении()

&НаКлиенте
// Процедура - обработчик события "ПриИзменении" поля ввода суммы затрат (БУ).
//
Процедура СуммаЗатратПриИзменении(Элемент)
	
	Объект.СуммаЗатрат = СуммаЗатрат + СуммаНДСВключенногоВСтоимость;
	
КонецПроцедуры // СуммаЗатратПриИзменении()

&НаСервере
// Серверная процедура - обработчик события "ПриИзменении" флажка восстановления НДС.
//
Процедура ВосстанавливатьНДСПриИзмененииНаСервере()
	
	УправлениеЭлементамиФормы();
	РассчитатьСуммуНДСВключенногоВСтоимость();
	
КонецПроцедуры // ВосстанавливатьНДСПриИзмененииНаСервере()

#КонецОбласти

#Область ОбработчикиКомандФормы

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 


&НаКлиенте
// Процедура - обработчик события "Нажатие" команды расчета актуальных сумм документа.
//
Процедура РассчитатьСуммыДокумента(Команда)
	
	Если Не Объект.ВосстановлениеНДС.Количество() = 0
	 Или Не Объект.СуммаЗатрат = 0
	 Или Не Объект.СуммаЗатратНУ = 0
	 Или Не Объект.СуммаЗатратПР = 0 
	 Или Не Объект.СуммаЗатратВР = 0 
	 Или Не Объект.СуммаЗатратУУ = 0 Тогда

		ТекстВопроса = НСтр("ru='Перед расчетом сумм документа некоторые данные будут перезаполнены. Продолжить?'");
		ПоказатьВопрос(Новый ОписаниеОповещения("РассчитатьСуммыДокументаЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;

	КонецЕсли;
	
	РассчитатьСуммыДокументаНаСервере();
	
КонецПроцедуры // РассчитатьСуммыДокумента()

&НаКлиенте
// Завершение процедуры - обработчика события "Нажатие" команды расчета актуальных сумм документа.
//
Процедура РассчитатьСуммыДокументаЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
	ОтветНаВопрос = РезультатВопроса;
	Если ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
	    Возврат;
	КонецЕсли;
	
	РассчитатьСуммыДокументаНаСервере();

КонецПроцедуры // РассчитатьСуммыДокументаЗавершение()

&НаКлиенте
// Процедура - обработчик события "Нажатие" команды заполнения данными по объекту.
//
Процедура ЗаполнитьДаннымиПоОбъекту(Команда)
	
	Если Не Объект.ОбъектыНедвижимости.Количество() = 0 Тогда

		ТекстВопроса = НСтр("ru='Перед заполнением табл. часть ""Объекты недвижимости"" будет очищена. Продолжить?'");
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьДаннымиПоОбъектуЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;

	КонецЕсли;

	ЗаполнитьДаннымиПоОбъектуНаСервере();
	
КонецПроцедуры // ЗаполнитьДаннымиПоОбъекту()

&НаКлиенте
// Завершение процедуры - обработчика события "Нажатие" команды заполнения данными по объекту.
//
Процедура ЗаполнитьДаннымиПоОбъектуЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
	ОтветНаВопрос = РезультатВопроса;
	Если ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
	    Возврат;
	КонецЕсли;
	
	ЗаполнитьДаннымиПоОбъектуНаСервере();

КонецПроцедуры // ЗаполнитьДаннымиПоОбъектуЗавершение()

&НаКлиенте
// Процедура - обработчик события "Нажатие" команды распределения данных по объекту.
//
Процедура РаспределитьДанныеПоОбъекту(Команда)
	
	Если Объект.ОбъектыНедвижимости.Количество() = 0 
	 Или ПроверитьЗаполнениеРеквизитовДляРаспределенияДанных() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Объект.ПринятиеКУчету.Количество() = 0 
	 Или Не Объект.СдачаИнвестору.Количество() = 0 Тогда

		ТекстВопроса = НСтр("ru='Перед заполнением табл. части ""Принятие к учету"" и ""Сдача инвестору"" будут очищены. Продолжить?'");
		ПоказатьВопрос(Новый ОписаниеОповещения("РаспределитьДанныеПоОбъектуЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;

	КонецЕсли;

	РаспределитьДанныеПоОбъектуНаСервере();
	ЗаполнитьСдачуИнвесторуНаСервере();

	
КонецПроцедуры // РаспределитьДанныеПоОбъекту()

&НаСервере
Процедура ЗаполнитьСдачуИнвесторуНаСервере()
	
	ОбъектыНедвижимости = Объект.ОбъектыНедвижимости.Выгрузить();
	
	Строки_СдачаИнвестору = ОбъектыНедвижимости.Скопировать(Новый Структура("ВидОперации", Перечисления.УСОERP_ВидыОперацийСОбъектамиСтроительства.СдачаИнвестору));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ИсходныеДанные.ОбъектНедвижимости, ЗНАЧЕНИЕ(Справочник.АУН_ОбъектыНедвижимости.ПустаяСсылка)) КАК ОбъектНедвижимости,
	|	ЕСТЬNULL(ИсходныеДанные.ПлощадьПроектная, 0) КАК ПлощадьПроектная,
	|	ЕСТЬNULL(ИсходныеДанные.ПлощадьФактическая, 0) КАК ПлощадьФактическая,
	|	ЕСТЬNULL(ИсходныеДанные.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент,
	|	ЕСТЬNULL(ИсходныеДанные.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК Договор,
	|	ЕСТЬNULL(ИсходныеДанные.СуммаЗатрат, 0) КАК СуммаЗатрат,
	|	ЕСТЬNULL(ИсходныеДанные.СуммаЗатратНУ, 0) КАК СуммаЗатратНУ,
	|	ЕСТЬNULL(ИсходныеДанные.СуммаЗатратПР, 0) КАК СуммаЗатратПР,
	|	ЕСТЬNULL(ИсходныеДанные.СуммаЗатратВР, 0) КАК СуммаЗатратВР,
	|	ЕСТЬNULL(ИсходныеДанные.СуммаЗатратУУ, 0) КАК СуммаЗатратУУ,
	|	ЕСТЬNULL(ИсходныеДанные.УслугиЗаказчика, 0) КАК УслугиЗаказчика,
	|	ЕСТЬNULL(ИсходныеДанные.УслугиЗаказчикаНУ, 0) КАК УслугиЗаказчикаНУ,
	|	ЕСТЬNULL(ИсходныеДанные.УслугиЗаказчикаПР, 0) КАК УслугиЗаказчикаПР,
	|	ЕСТЬNULL(ИсходныеДанные.УслугиЗаказчикаВР, 0) КАК УслугиЗаказчикаВР,
	|	ЕСТЬNULL(ИсходныеДанные.УслугиЗаказчикаУУ, 0) КАК УслугиЗаказчикаУУ
	|ПОМЕСТИТЬ ВТ_ИсходныеДанные
	|ИЗ
	|	&ИсходныеДанные КАК ИсходныеДанные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ИсходныеДанные.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	ВТ_ИсходныеДанные.ПлощадьПроектная КАК ПлощадьПроектная,
	|	ВТ_ИсходныеДанные.ПлощадьФактическая КАК ПлощадьФактическая,
	|	ВТ_ИсходныеДанные.Контрагент КАК Контрагент,
	|	ВТ_ИсходныеДанные.Договор КАК Договор,
	|	ВТ_ИсходныеДанные.СуммаЗатрат КАК СуммаЗатрат,
	|	ВТ_ИсходныеДанные.СуммаЗатратНУ КАК СуммаЗатратНУ,
	|	ВТ_ИсходныеДанные.СуммаЗатратПР КАК СуммаЗатратПР,
	|	ВТ_ИсходныеДанные.СуммаЗатратВР КАК СуммаЗатратВР,
	|	ВТ_ИсходныеДанные.СуммаЗатратУУ КАК СуммаЗатратУУ,
	|	ВЫБОР
	|		КОГДА УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Регистратор.УСОERP_ВидДоговора В (ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыДоговоровПоНедвижимости.ИнвестиционныйДоговор))
	|			ТОГДА ВТ_ИсходныеДанные.УслугиЗаказчика
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК УслугиЗаказчика,
	|	ВЫБОР
	|		КОГДА УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Регистратор.УСОERP_ВидДоговора В (ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыДоговоровПоНедвижимости.ИнвестиционныйДоговор))
	|			ТОГДА ВТ_ИсходныеДанные.УслугиЗаказчикаНУ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК УслугиЗаказчикаНУ,
	|	ВЫБОР
	|		КОГДА УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Регистратор.УСОERP_ВидДоговора В (ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыДоговоровПоНедвижимости.ИнвестиционныйДоговор))
	|			ТОГДА ВТ_ИсходныеДанные.УслугиЗаказчикаПР
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК УслугиЗаказчикаПР,
	|	ВЫБОР
	|		КОГДА УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Регистратор.УСОERP_ВидДоговора В (ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыДоговоровПоНедвижимости.ИнвестиционныйДоговор))
	|			ТОГДА ВТ_ИсходныеДанные.УслугиЗаказчикаВР
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК УслугиЗаказчикаВР,
	|	ВЫБОР
	|		КОГДА УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Регистратор.УСОERP_ВидДоговора В (ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыДоговоровПоНедвижимости.ИнвестиционныйДоговор))
	|			ТОГДА ВТ_ИсходныеДанные.УслугиЗаказчикаУУ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК УслугиЗаказчикаУУ,
	|	УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Регистратор.УСОERP_ВидДоговора КАК ВидДоговора,
	|	ПорядокОтраженияРасчетовСПартнерами.СчетУчетаРасчетовСКлиентами КАК СчетРасчетов
	|ПОМЕСТИТЬ ВТ_ДанныеСоСчетами
	|ИЗ
	|	ВТ_ИсходныеДанные КАК ВТ_ИсходныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокОтраженияРасчетовСПартнерами КАК ПорядокОтраженияРасчетовСПартнерами
	|		ПО ВТ_ИсходныеДанные.Договор.ГруппаФинансовогоУчета = ПорядокОтраженияРасчетовСПартнерами.ГруппаФинансовогоУчета
	|			И (ПорядокОтраженияРасчетовСПартнерами.Организация = &Организация)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_СоответствиеДоговоровИДолей.СрезПоследних(&КонецПериода, ) КАК УСОERP_СоответствиеДоговоровИДолейСрезПоследних
	|		ПО ВТ_ИсходныеДанные.ОбъектНедвижимости = УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Доля
	|			И ВТ_ИсходныеДанные.Договор = УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто1 КАК Справочник.ДоговорыКонтрагентов) КАК Договор,
	|	ХозрасчетныйОстатки.СуммаОстатокКт КАК СуммаБУ,
	|	ХозрасчетныйОстатки.СуммаНУОстатокКт КАК СуммаНУ,
	|	ХозрасчетныйОстатки.СуммаПРОстатокКт КАК СуммаПР,
	|	ХозрасчетныйОстатки.СуммаВРОстатокКт КАК СуммаВР,
	|	ХозрасчетныйОстатки.СуммаУУОстатокКт КАК СуммаУУ
	|ПОМЕСТИТЬ ВТ_СуммыПоДоговорам
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&КонецПериода,
	|			Счет В (&Счета86),
	|			&ВидСубконто,
	|			Организация = &Организация
	|				И НаправлениеДеятельности = &НаправлениеДеятельности
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						ВТ_ДанныеСоСчетами.Договор
	|					ИЗ
	|						ВТ_ДанныеСоСчетами КАК ВТ_ДанныеСоСчетами)) КАК ХозрасчетныйОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеСоСчетами.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	ВТ_ДанныеСоСчетами.ПлощадьПроектная КАК ПлощадьПроектная,
	|	ВТ_ДанныеСоСчетами.ПлощадьФактическая КАК ПлощадьФактическая,
	|	ВТ_ДанныеСоСчетами.Контрагент КАК Контрагент,
	|	ВТ_ДанныеСоСчетами.Договор КАК Договор,
	|	ВТ_ДанныеСоСчетами.СуммаЗатрат КАК СуммаЗатрат,
	|	ВТ_ДанныеСоСчетами.СуммаЗатратНУ КАК СуммаЗатратНУ,
	|	ВТ_ДанныеСоСчетами.СуммаЗатратПР КАК СуммаЗатратПР,
	|	ВТ_ДанныеСоСчетами.СуммаЗатратВР КАК СуммаЗатратВР,
	|	ВТ_ДанныеСоСчетами.СуммаЗатратУУ КАК СуммаЗатратУУ,
	|	ВТ_ДанныеСоСчетами.УслугиЗаказчика КАК УслугиЗаказчика,
	|	ВТ_ДанныеСоСчетами.УслугиЗаказчикаНУ КАК УслугиЗаказчикаНУ,
	|	ВТ_ДанныеСоСчетами.УслугиЗаказчикаПР КАК УслугиЗаказчикаПР,
	|	ВТ_ДанныеСоСчетами.УслугиЗаказчикаВР КАК УслугиЗаказчикаВР,
	|	ВТ_ДанныеСоСчетами.УслугиЗаказчикаУУ КАК УслугиЗаказчикаУУ,
	|	ЕСТЬNULL(ВТ_ДанныеСоСчетами.СчетРасчетов, ВТ_ДанныеСоСчетами.Договор.ГруппаФинансовогоУчета.СчетУчетаРасчетовСКлиентами) КАК СчетРасчетов,
	|	ЕСТЬNULL(ВТ_СуммыПоДоговорам.СуммаБУ, 0) КАК СтоимостьПоДоговору,
	|	ЕСТЬNULL(ВТ_СуммыПоДоговорам.СуммаНУ, 0) КАК СтоимостьПоДоговоруНУ,
	|	ЕСТЬNULL(ВТ_СуммыПоДоговорам.СуммаПР, 0) КАК СтоимостьПоДоговоруПР,
	|	ЕСТЬNULL(ВТ_СуммыПоДоговорам.СуммаВР, 0) КАК СтоимостьПоДоговоруВР,
	|	ЕСТЬNULL(ВТ_СуммыПоДоговорам.СуммаУУ, 0) КАК СтоимостьПоДоговоруУУ,
	|	ЕСТЬNULL(ВТ_СуммыПоДоговорам.СуммаБУ, 0) - ВТ_ДанныеСоСчетами.СуммаЗатрат КАК Выручка,
	|	ЕСТЬNULL(ВТ_СуммыПоДоговорам.СуммаНУ, 0) - ВТ_ДанныеСоСчетами.СуммаЗатратНУ КАК ВыручкаНУ,
	|	ЕСТЬNULL(ВТ_СуммыПоДоговорам.СуммаПР, 0) - ВТ_ДанныеСоСчетами.СуммаЗатратПР КАК ВыручкаПР,
	|	ЕСТЬNULL(ВТ_СуммыПоДоговорам.СуммаВР, 0) - ВТ_ДанныеСоСчетами.СуммаЗатратВР КАК ВыручкаВР,
	|	ЕСТЬNULL(ВТ_СуммыПоДоговорам.СуммаУУ, 0) - ВТ_ДанныеСоСчетами.СуммаЗатратУУ КАК ВыручкаУУ,
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеСоСчетами.ВидДоговора В (ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыДоговоровПоНедвижимости.ИнвестиционныйДоговор))
	|				И ЕСТЬNULL(ВТ_СуммыПоДоговорам.СуммаБУ, 0) - ВТ_ДанныеСоСчетами.СуммаЗатрат > 0
	|			ТОГДА ВЫРАЗИТЬ((ЕСТЬNULL(ВТ_СуммыПоДоговорам.СуммаБУ, 0) - ВТ_ДанныеСоСчетами.СуммаЗатрат - ВТ_ДанныеСоСчетами.УслугиЗаказчика) * 18 / 118 КАК ЧИСЛО(15, 2))
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК НДС,
	|	0 КАК НДСНУ,
	|	0 КАК НДСПР,
	|	0 КАК НДСВР
	|ИЗ
	|	ВТ_ДанныеСоСчетами КАК ВТ_ДанныеСоСчетами
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СуммыПоДоговорам КАК ВТ_СуммыПоДоговорам
	|		ПО ВТ_ДанныеСоСчетами.Договор = ВТ_СуммыПоДоговорам.Договор";
	
	Запрос.УстановитьПараметр("ИсходныеДанные", Строки_СдачаИнвестору);
	
	Счета86 = Справочники.УСОERP_ПредопределенныеЭлементы.ПолучитьМассивЗначенийПредопределенныхЭлементов(Справочники.УСОERP_ПредопределенныеЭлементы.СчетУчетаРасчетовПоЦелевомуФинансированию);
	
	Запрос.УстановитьПараметр("Счета86", Счета86);
	Запрос.УстановитьПараметр("НаправлениеДеятельности", Объект.ОбъектСтроительства.НаправлениеДеятельности);
	
	ВидСубконто = Новый Массив;
	ВидСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры);
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ВидСубконто", ВидСубконто);
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	
	Результат = Запрос.ВыполнитьПакет();
	ТЗ_СдачаИнвестору 		= Результат[3].Выгрузить();
		
	Объект.СдачаИнвестору.Загрузить(ТЗ_СдачаИнвестору);
	
КонецПроцедуры  

&НаКлиенте
// Завершение процедуры - обработчика события "Нажатие" команды распределения данных по объекту.
//
Процедура РаспределитьДанныеПоОбъектуЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
