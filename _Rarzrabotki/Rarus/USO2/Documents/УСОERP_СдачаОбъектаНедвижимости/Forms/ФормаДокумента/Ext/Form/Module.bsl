&НаСервере
Процедура ЗаполнитьПолеСуммыВСтроке(СтрОбъект, ИмяПоля, МассивСумм, МассивСуммНУ, МассивСуммПР, МассивСуммВР, МассивСуммУУ, Индекс); 
	
	Если Не МассивСумм = Неопределено Тогда
		СтрОбъект[ИмяПоля] = СтрОбъект[ИмяПоля] + МассивСумм[индекс];
	КонецЕсли;
	
	Если Не МассивСуммНУ = Неопределено Тогда
		СтрОбъект[ИмяПоля + "НУ"] = СтрОбъект[ИмяПоля + "НУ"] + МассивСуммНУ[индекс];
	КонецЕсли;
	Если Не МассивСуммПР = Неопределено Тогда
		СтрОбъект[ИмяПоля + "ПР"] = СтрОбъект[ИмяПоля + "ПР"] + МассивСуммПР[индекс];
	КонецЕсли;
	Если Не МассивСуммВР = Неопределено Тогда
		СтрОбъект[ИмяПоля + "ВР"] = СтрОбъект[ИмяПоля + "ВР"] + МассивСуммВР[индекс];
	КонецЕсли;
	Если Не МассивСуммУУ = Неопределено Тогда
		СтрОбъект[ИмяПоля + "УУ"] = СтрОбъект[ИмяПоля + "УУ"] + МассивСуммУУ[индекс];
	КонецЕсли;

	РассчитатьстоимостьДолиПоСтроке(СтрОбъект);
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьстоимостьДолиПоСтроке(СтрОбъект)
	
	СтрОбъект.СуммаЗатрат =  СтрОбъект.ОбъектСтроительства
	+ СтрОбъект.ЖилыеПомещения 
	+ СтрОбъект.НежилыеПомещения 
	+ СтрОбъект.Паркинг
	+ СтрОбъект.СуммаИнвестиционногоНДС; 
		
	СтрОбъект.СуммаЗатратНУ =  СтрОбъект.ОбъектСтроительстваНУ
	+ СтрОбъект.ЖилыеПомещенияНУ
	+ СтрОбъект.НежилыеПомещенияНУ
	+ СтрОбъект.ПаркингНУ
	+ СтрОбъект.СуммаИнвестиционногоНДС;
	
	СтрОбъект.СуммаЗатратПР = СтрОбъект.ОбъектСтроительстваПР
	+ СтрОбъект.ЖилыеПомещенияПР
	+ СтрОбъект.НежилыеПомещенияПР
	+ СтрОбъект.ПаркингПР;
		
	СтрОбъект.СуммаЗатратВР =  СтрОбъект.ОбъектСтроительстваВР
	+ СтрОбъект.ЖилыеПомещенияВР
	+ СтрОбъект.НежилыеПомещенияВР
	+ СтрОбъект.ПаркингВР;
	
	СтрОбъект.СуммаЗатратУУ =  СтрОбъект.ОбъектСтроительстваУУ
	+ СтрОбъект.ЖилыеПомещенияУУ
	+ СтрОбъект.НежилыеПомещенияУУ
	+ СтрОбъект.ПаркингУУ;
	
КонецПроцедуры

&НаСервере
Процедура РаспределитьУслугиЗаказчикаЗастройщикаИСМР()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ВложенныйЗапрос.СуммаБУ) КАК СуммаБУ,
	|	СУММА(ВложенныйЗапрос.СуммаНУ) КАК СуммаНУ,
	|	СУММА(ВложенныйЗапрос.СуммаПР) КАК СуммаПР,
	|	СУММА(ВложенныйЗапрос.СуммаВР) КАК СуммаВР,
	|	СУММА(ВложенныйЗапрос.СуммаУУ) КАК СуммаУУ
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПрочиеРасходыОстатки.СуммаРеглОстаток КАК СуммаБУ,
	|		ПрочиеРасходыОстатки.СуммаРеглОстаток - ПрочиеРасходыОстатки.ПостояннаяРазницаОстаток - ПрочиеРасходыОстатки.ВременнаяРазницаОстаток КАК СуммаНУ,
	|		ПрочиеРасходыОстатки.ПостояннаяРазницаОстаток КАК СуммаПР,
	|		ПрочиеРасходыОстатки.ВременнаяРазницаОстаток КАК СуммаВР,
	|		ПрочиеРасходыОстатки.СуммаУпрОстаток КАК СуммаУУ
	|	ИЗ
	|		РегистрНакопления.ПрочиеРасходы.Остатки(
	|				&КонецПериода,
	|				Организация = &Организация
	|					И НаправлениеДеятельности = &НаправлениеДеятельности
	|					И СтатьяРасходов.СчетУчета В ИЕРАРХИИ (&Счет2001)) КАК ПрочиеРасходыОстатки
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПрочиеРасходы.СуммаРегл,
	|		ПрочиеРасходы.СуммаРегл - ПрочиеРасходы.ПостояннаяРазница - ПрочиеРасходы.ВременнаяРазница,
	|		ПрочиеРасходы.ПостояннаяРазница,
	|		ПрочиеРасходы.ВременнаяРазница,
	|		ПрочиеРасходы.СуммаУпр
	|	ИЗ
	|		РегистрНакопления.ПрочиеРасходы КАК ПрочиеРасходы
	|	ГДЕ
	|		ПрочиеРасходы.Регистратор = &Регистратор) КАК ВложенныйЗапрос";
	
	Счет2001 = Справочники.УСОERP_ПредопределенныеЭлементы.СчетУчетаЗатратПоВыполнениюФункцийЗаказчикаЗастройщика.Значение;
	Счет2002 = Справочники.УСОERP_ПредопределенныеЭлементы.СчетУчетаЗатратПоВыполнениюСтроительныхРабот.Значение;

	Счет0833 = Справочники.УСОERP_ПредопределенныеЭлементы.СчетУчетаОбъектовНедвижимости.Значение;
	
	ВидКорСубконто = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ОбъектыСтроительства;
	
	Запрос.УстановитьПараметр("КонецПериода", новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ОбъектСтроительства", объект.ОбъектСтроительства);
	Запрос.УстановитьПараметр("НаправлениеДеятельности", Объект.ОбъектСтроительства.НаправлениеДеятельности);
	Запрос.УстановитьПараметр("Счет2001", Счет2001);
	Запрос.УстановитьПараметр("Счет2002", Счет2002);
	Запрос.УстановитьПараметр("Счет0833", Счет0833);
	Запрос.УстановитьПараметр("ВидКорСубконто", ВидКорСубконто);
	Запрос.УстановитьПараметр("Регистратор", Объект.Ссылка);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ДанныеПоУслугамЗЗ = Результат[0].Выгрузить();
		
	МассивКоэффициентов = Объект.ОбъектыНедвижимости.Выгрузить().ВыгрузитьКолонку("ПлощадьФактическая");
	
	Если Не МассивКоэффициентов.Количество() = 0 Тогда 		
		Если Объект.ОбъектыНедвижимости.Количество()>0
			И Объект.ОбъектыНедвижимости[Объект.ОбъектыНедвижимости.Количество()-1].ОбъектНедвижимости.КатегорияОбъекта = Перечисления.АУН_КатегорииОбъектовНедвижимости.Здание Тогда
			МассивКоэффициентов[МассивКоэффициентов.ВГраница()] = 0;
		КонецЕсли;       		
	Иначе
		Возврат;
	КонецЕсли;
	
	РаспределятьУслуги = (ДанныеПоУслугамЗЗ.Количество()>0);
		
	Если РаспределятьУслуги Тогда
		
		МассивУслугиСуммыБУ = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(ДанныеПоУслугамЗЗ[0].СуммаБУ, МассивКоэффициентов, 2);
		МассивУслугиСуммыНУ = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(ДанныеПоУслугамЗЗ[0].СуммаНУ, МассивКоэффициентов, 2);
		МассивУслугиСуммыПР = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(ДанныеПоУслугамЗЗ[0].СуммаПР, МассивКоэффициентов, 2);
		МассивУслугиСуммыВР = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(ДанныеПоУслугамЗЗ[0].СуммаВР, МассивКоэффициентов, 2);
		МассивУслугиСуммыУУ = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(ДанныеПоУслугамЗЗ[0].СуммаУУ, МассивКоэффициентов, 2);
		
	КонецЕсли;

	индекс = 0;
	
	Для Каждого СтрТЧ Из Объект.ОбъектыНедвижимости Цикл
		
		Если РаспределятьУслуги Тогда
			Если НЕ  МассивУслугиСуммыБУ = Неопределено Тогда
				СтрТЧ.УслугиЗаказчика = МассивУслугиСуммыБУ[индекс];
			КонецЕсли;
			Если НЕ  МассивУслугиСуммыНУ = Неопределено Тогда
				СтрТЧ.УслугиЗаказчикаНУ = МассивУслугиСуммыНУ[индекс];
			КонецЕсли;
			Если НЕ  МассивУслугиСуммыПР = Неопределено Тогда
				СтрТЧ.УслугиЗаказчикаПР = МассивУслугиСуммыПР[индекс];
			КонецЕсли;
			Если НЕ  МассивУслугиСуммыВР = Неопределено Тогда
				СтрТЧ.УслугиЗаказчикаВР = МассивУслугиСуммыВР[индекс];
			КонецЕсли;
			Если НЕ  МассивУслугиСуммыУУ = Неопределено Тогда
				СтрТЧ.УслугиЗаказчикаУУ = МассивУслугиСуммыУУ[индекс];
			КонецЕсли;			
		КонецЕсли;
				
		индекс = индекс + 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаспределениеИнвестиционногоНДС(СтрСтоимость, МассивИнвестиционныйНДС, ТаблицаОбъектов, МассивСуммИнвестиционныйНДС)
	
	МассивСуммИнвестиционныйНДС = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СтрСтоимость.СуммаИнвестиционногоНДС, МассивИнвестиционныйНДС, 2); 
			
	индекс = 0;
	Для Каждого СтрОбъект Из Объект.ДетализацияПоОбъектамНедвижимости Цикл
		Если НЕ МассивСуммИнвестиционныйНДС = Неопределено Тогда
			СтрОбъект.СуммаИнвестиционногоНДС = СтрОбъект.СуммаИнвестиционногоНДС + МассивСуммИнвестиционныйНДС[Индекс];
		КонецЕсли;
				
		РассчитатьстоимостьДолиПоСтроке(СтрОбъект);
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивРаспределенияПоСтатьямРасходов(ТаблицаОбъектов, ТекСтатьяРасходов, ТекПодразделение, ТекНаправлениеДеятельности, МассивРаспределения)
	
	МассивРезультат = Новый Массив;
	
	Итератор = 0;
	Для Каждого ТекСтрокаМассива Из МассивРаспределения Цикл
		СтрокаТаблицыОбъектов = ТаблицаОбъектов[Итератор];
		Если СтрокаТаблицыОбъектов.СтатьяРасходов = ТекСтатьяРасходов
			И СтрокаТаблицыОбъектов.Подразделение = ТекПодразделение
			И СтрокаТаблицыОбъектов.НаправлениеДеятельности = ТекНаправлениеДеятельности Тогда
			МассивРезультат.Добавить(ТекСтрокаМассива);
		Иначе
			МассивРезультат.Добавить(0);
		КонецЕсли;
		Итератор = Итератор + 1;
	КонецЦикла;	
	
	Возврат МассивРезультат;
	
КонецФункции

