// Процедура формирует структуру параметров и вызывает функции/процедуры расчета актуальных сумм документа. 
//
Процедура РассчитатьСуммыДокументаНаСервере()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДатаДокумента"	   , Объект.Дата);
	СтруктураПараметров.Вставить("Организация"		   , Объект.Организация);
	СтруктураПараметров.Вставить("ОбъектСтроительства" , Объект.ОбъектСтроительства);
	СтруктураПараметров.Вставить("Счет"				   , Объект.Счет);
	
	Объект.ВосстановлениеНДС.Загрузить(Документы.УСОERP_СдачаОбъектаНедвижимости.ПолучитьДанныеЗаполненияВосстановленияНДС(СтруктураПараметров));
	ЗаполнитьЗначенияСвойств(Объект, Документы.УСОERP_СдачаОбъектаНедвижимости.ПолучитьДанныеПоОстаткамХозрасчетного(СтруктураПараметров));
	
	РассчитатьСвязанныеРеквизитыДокументаПоОбъектуСтроительства();
	
КонецПроцедуры // РассчитатьСуммыДокументаНаСервере()

&НаСервере
// Процедура формирует структуру параметров и вызывает функции/процедуры заполнения данными по объекту.
//
Процедура ЗаполнитьДаннымиПоОбъектуНаСервере()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДатаДокумента"	   , Объект.Дата);
	СтруктураПараметров.Вставить("ОбъектСтроительства" , Объект.ОбъектСтроительства);
	СтруктураПараметров.Вставить("ПлощадьФактическая"  , ПлощадьФактическая);
	СтруктураПараметров.Вставить("СуммаЗатрат"		   , СуммаЗатрат);
	СтруктураПараметров.Вставить("СуммаЗатратНУ"	   , Объект.СуммаЗатратНУ);
	СтруктураПараметров.Вставить("СуммаЗатратПР"	   , Объект.СуммаЗатратПР);
	СтруктураПараметров.Вставить("СуммаЗатратВР"	   , Объект.СуммаЗатратВР);
	СтруктураПараметров.Вставить("СуммаЗатратУУ"	   , Объект.СуммаЗатратУУ);

	Объект.ОбъектыНедвижимости.Загрузить(Документы.УСОERP_СдачаОбъектаНедвижимости.ПолучитьДанныеЗаполненияОбъектовНедвижимости(СтруктураПараметров));
	ИсправитьОшибкиОкругленияПослеЗаполненияОбъектовНедвижимости(СтруктураПараметров);
	
	Объект.ДетализацияПоОбъектамНедвижимости.Очистить();
	
	Для Каждого ТекСтрокаОбъекта Из Объект.ОбъектыНедвижимости Цикл	
		
		Для Каждого ТекСтрокаНаправления Из Объект.НаправленияДеятельности  Цикл
			
			ДетализацияПоНаправлению = Объект.ДетализацияПоНаправлениямДеятельности.НайтиСтроки(Новый Структура("НаправлениеДеятельности", ТекСтрокаНаправления.НаправлениеДеятельности));
			
			Для Каждого ТекСтрокаДетализация Из ДетализацияПоНаправлению Цикл
				
				СтрокиДетализацииПоПараметрам = Объект.ДетализацияПоОбъектамНедвижимости.НайтиСтроки(Новый Структура("ОбъектНедвижимости, Подразделение, СтатьяРасходов, НаправлениеДеятельности", ТекСтрокаОбъекта.ОбъектНедвижимости, ТекСтрокаДетализация.Подразделение, ТекСтрокаДетализация.СтатьяРасходов, ТекСтрокаДетализация.НаправлениеДеятельности));
				
				Если СтрокиДетализацииПоПараметрам.Количество() = 0 Тогда
					
					СтрокаДетализацияОбъект = Объект.ДетализацияПоОбъектамНедвижимости.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаДетализацияОбъект, ТекСтрокаОбъекта);
					СтрокаДетализацияОбъект.Подразделение 	= ТекСтрокаДетализация.Подразделение;
					СтрокаДетализацияОбъект.СтатьяРасходов 	= ТекСтрокаДетализация.СтатьяРасходов;
					СтрокаДетализацияОбъект.НаправлениеДеятельности = ТекСтрокаДетализация.НаправлениеДеятельности;
					
				Иначе
					
					СтрокаДетализацияОбъект = СтрокиДетализацииПоПараметрам[0];
					СтрокаДетализацияОбъект.СуммаЗатрат 	= СтрокаДетализацияОбъект.СуммаЗатрат 	+ ТекСтрокаОбъекта.СуммаЗатрат;
					СтрокаДетализацияОбъект.СуммаЗатратНУ	= СтрокаДетализацияОбъект.СуммаЗатратНУ + ТекСтрокаОбъекта.СуммаЗатратНУ;
					СтрокаДетализацияОбъект.СуммаЗатратПР	= СтрокаДетализацияОбъект.СуммаЗатратПР + ТекСтрокаОбъекта.СуммаЗатратПР;
					СтрокаДетализацияОбъект.СуммаЗатратВР	= СтрокаДетализацияОбъект.СуммаЗатратВР + ТекСтрокаОбъекта.СуммаЗатратВР;
					СтрокаДетализацияОбъект.СуммаЗатратУУ	= СтрокаДетализацияОбъект.СуммаЗатратУУ + ТекСтрокаОбъекта.СуммаЗатратУУ;
					
					СтрокаДетализацияОбъект.ОбъектСтроительства 	= СтрокаДетализацияОбъект.ОбъектСтроительства 	+ ТекСтрокаОбъекта.ОбъектСтроительства;
					СтрокаДетализацияОбъект.ОбъектСтроительстваНУ	= СтрокаДетализацияОбъект.ОбъектСтроительстваНУ + ТекСтрокаОбъекта.ОбъектСтроительстваНУ;
					СтрокаДетализацияОбъект.ОбъектСтроительстваПР	= СтрокаДетализацияОбъект.ОбъектСтроительстваПР + ТекСтрокаОбъекта.ОбъектСтроительстваПР;
					СтрокаДетализацияОбъект.ОбъектСтроительстваВР	= СтрокаДетализацияОбъект.ОбъектСтроительстваВР + ТекСтрокаОбъекта.ОбъектСтроительстваВР;
					СтрокаДетализацияОбъект.ОбъектСтроительстваУУ	= СтрокаДетализацияОбъект.ОбъектСтроительстваУУ + ТекСтрокаОбъекта.ОбъектСтроительстваУУ;
					
					СтрокаДетализацияОбъект.ЖилыеПомещения 		= СтрокаДетализацияОбъект.ЖилыеПомещения 	+ ТекСтрокаОбъекта.ЖилыеПомещения;
					СтрокаДетализацияОбъект.ЖилыеПомещенияНУ	= СтрокаДетализацияОбъект.ЖилыеПомещенияНУ 	+ ТекСтрокаОбъекта.ЖилыеПомещенияНУ;
					СтрокаДетализацияОбъект.ЖилыеПомещенияПР	= СтрокаДетализацияОбъект.ЖилыеПомещенияПР 	+ ТекСтрокаОбъекта.ЖилыеПомещенияПР;
					СтрокаДетализацияОбъект.ЖилыеПомещенияВР	= СтрокаДетализацияОбъект.ЖилыеПомещенияВР 	+ ТекСтрокаОбъекта.ЖилыеПомещенияВР;
					СтрокаДетализацияОбъект.ЖилыеПомещенияУУ	= СтрокаДетализацияОбъект.ЖилыеПомещенияУУ 	+ ТекСтрокаОбъекта.ЖилыеПомещенияУУ;
					
					СтрокаДетализацияОбъект.НежилыеПомещения	= СтрокаДетализацияОбъект.НежилыеПомещения 		+ ТекСтрокаОбъекта.НежилыеПомещения;
					СтрокаДетализацияОбъект.НежилыеПомещенияНУ	= СтрокаДетализацияОбъект.НежилыеПомещенияНУ 	+ ТекСтрокаОбъекта.НежилыеПомещенияНУ;
					СтрокаДетализацияОбъект.НежилыеПомещенияПР	= СтрокаДетализацияОбъект.НежилыеПомещенияПР 	+ ТекСтрокаОбъекта.НежилыеПомещенияПР;
					СтрокаДетализацияОбъект.НежилыеПомещенияВР	= СтрокаДетализацияОбъект.НежилыеПомещенияВР 	+ ТекСтрокаОбъекта.НежилыеПомещенияВР;
					СтрокаДетализацияОбъект.НежилыеПомещенияУУ	= СтрокаДетализацияОбъект.НежилыеПомещенияУУ 	+ ТекСтрокаОбъекта.НежилыеПомещенияУУ;
					
					СтрокаДетализацияОбъект.Паркинг		= СтрокаДетализацияОбъект.Паркинг 		+ ТекСтрокаОбъекта.Паркинг;
					СтрокаДетализацияОбъект.ПаркингНУ	= СтрокаДетализацияОбъект.ПаркингНУ 	+ ТекСтрокаОбъекта.ПаркингНУ;
					СтрокаДетализацияОбъект.ПаркингПР	= СтрокаДетализацияОбъект.ПаркингПР 	+ ТекСтрокаОбъекта.ПаркингПР;
					СтрокаДетализацияОбъект.ПаркингВР	= СтрокаДетализацияОбъект.ПаркингВР 	+ ТекСтрокаОбъекта.ПаркингВР;
					СтрокаДетализацияОбъект.ПаркингУУ	= СтрокаДетализацияОбъект.ПаркингУУ 	+ ТекСтрокаОбъекта.ПаркингУУ;
					
					СтрокаДетализацияОбъект.УслугиЗаказчика		= СтрокаДетализацияОбъект.УслугиЗаказчика	+ ТекСтрокаОбъекта.УслугиЗаказчика;
					СтрокаДетализацияОбъект.УслугиЗаказчикаНУ	= СтрокаДетализацияОбъект.УслугиЗаказчикаНУ	+ ТекСтрокаОбъекта.УслугиЗаказчикаНУ;
					СтрокаДетализацияОбъект.УслугиЗаказчикаПР	= СтрокаДетализацияОбъект.УслугиЗаказчикаПР	+ ТекСтрокаОбъекта.УслугиЗаказчикаПР;
					СтрокаДетализацияОбъект.УслугиЗаказчикаВР	= СтрокаДетализацияОбъект.УслугиЗаказчикаВР	+ ТекСтрокаОбъекта.УслугиЗаказчикаВР;
					СтрокаДетализацияОбъект.УслугиЗаказчикаУУ	= СтрокаДетализацияОбъект.УслугиЗаказчикаУУ	+ ТекСтрокаОбъекта.УслугиЗаказчикаУУ;
															
					СтрокаДетализацияОбъект.СуммаИнвестиционногоНДС		= СтрокаДетализацияОбъект.СуммаИнвестиционногоНДС	+ ТекСтрокаОбъекта.СуммаИнвестиционногоНДС;
					
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	РаспределитьПоНаправлениямДеятельности();
	
	Модифицированность = Истина;
	
КонецПроцедуры // ЗаполнитьДаннымиПоОбъектуНаСервере()

&НаСервере
Процедура РаспределитьПоНаправлениямДеятельности()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаОбъектов.ОбъектНедвижимости,
		|	ТаблицаОбъектов.ПлощадьПроектная,
