	|	НЕОПРЕДЕЛЕНО КАК СубконтоКт3,
	|	0 КАК ВалютнаяСуммаКт,
	|	0 КАК КоличествоКт,
	|	0 КАК СуммаНУКт,
	|	0 КАК СуммаПРКт,
	|	0 КАК СуммаВРКт,
	|	"""" КАК Содержание
	|ИЗ
	|	Документ.УСОERP_СдачаОбъектаНедвижимости.СдачаИнвестору КАК УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			УСОERP_ПредопределенныеЭлементы.Значение КАК СчетДт
	|		ИЗ
	|			Справочник.УСОERP_ПредопределенныеЭлементы КАК УСОERP_ПредопределенныеЭлементы
	|		ГДЕ
	|			УСОERP_ПредопределенныеЭлементы.Ссылка = ЗНАЧЕНИЕ(Справочник.УСОERP_ПредопределенныеЭлементы.СчетУчетаОбъектовНедвижимостиЗабаланс)) КАК ПредопределенныеЭлементы
	|		ПО (ИСТИНА)
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		КурсыВалют КАК КурсВалютыУпрУчета
	|	ПО
	|		КурсВалютыУпрУчета.Валюта = &ВалютаУпрУчета
	|		И КурсВалютыУпрУчета.Дата = НАЧАЛОПЕРИОДА(УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.Ссылка.Дата, День)		
	|ГДЕ
	|	УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.Ссылка,
	|	УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.Договор,
	|	УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.Контрагент,
	|	ПредопределенныеЭлементы.СчетДт,
	|	УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.Ссылка.Дата,
	|	УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.Ссылка.Организация,
	|	УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.Ссылка.Подразделение,
	|	УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.Ссылка.ОбъектСтроительства.НаправлениеДеятельности,
	|	УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.Ссылка.ОбъектСтроительства";

	Возврат ТекстЗапросаЗабаланс;
	
КонецФункции

#КонецОбласти

#Область Проведение

// Процедура инициализирует данные документа для их последующего отражения в связанных с документом регистрах.
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТекущийДокумент", ДокументСсылка);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеДокумента.Дата КАК Период,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.Назначение КАК Назначение,
	|	ДанныеДокумента.Склад КАК Склад,
	|	ДанныеДокумента.Номер КАК Номер
	|ИЗ
	|	Документ.УСОERP_СдачаОбъектаНедвижимости КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &ТекущийДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧСдачаИнвестору.Контрагент.Партнер КАК Партнер,
	|	ТЧСдачаИнвестору.Ссылка.Организация КАК Организация,
	|	ТЧСдачаИнвестору.Контрагент КАК Контрагент,
	|	ТЧСдачаИнвестору.Договор КАК Договор,
	|	ТЧСдачаИнвестору.Ссылка.ОбъектСтроительства.НаправлениеДеятельности КАК НаправлениеДеятельности
	|ИЗ
	|	Документ.УСОERP_СдачаОбъектаНедвижимости.СдачаИнвестору КАК ТЧСдачаИнвестору
	|ГДЕ
	|	ТЧСдачаИнвестору.Ссылка = &ТекущийДокумент
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧСдачаИнвестору.Договор,
	|	ТЧСдачаИнвестору.Ссылка.Организация,
	|	ТЧСдачаИнвестору.Контрагент,
	|	ТЧСдачаИнвестору.Ссылка.ОбъектСтроительства.НаправлениеДеятельности,
	|	ТЧСдачаИнвестору.Контрагент.Партнер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПринятиеКУчету.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ХарактеристикиНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК Серия,
	|	ПринятиеКУчету.Ссылка.Склад КАК Склад,
	|	ПринятиеКУчету.Ссылка.Назначение КАК Назначение,
	|	ЗНАЧЕНИЕ(Справочник.СтатьиКалькуляции.ПустаяСсылка) КАК СтатьяКалькуляции
	|ИЗ
	|	Документ.УСОERP_СдачаОбъектаНедвижимости.ПринятиеКУчету КАК ПринятиеКУчету
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаНоменклатуры КАК Аналитика
	|		ПО ПринятиеКУчету.Номенклатура = Аналитика.Номенклатура
	|			И (ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) = Аналитика.Серия)
	|			И ПринятиеКУчету.Ссылка.Назначение = Аналитика.Назначение
	|			И (ЗНАЧЕНИЕ(Справочник.СтатьиКалькуляции.ПустаяСсылка) = Аналитика.СтатьяКалькуляции)
	|			И ПринятиеКУчету.Ссылка.Склад = Аналитика.МестоХранения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|		ПО ПринятиеКУчету.Номенклатура = ХарактеристикиНоменклатуры.Владелец
	|ГДЕ
	|	ПринятиеКУчету.Ссылка = &ТекущийДокумент
	|	И Аналитика.Номенклатура ЕСТЬ NULL
	|	И ЕСТЬNULL(Аналитика.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) = ЕСТЬNULL(ХарактеристикиНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))";
	
	Результат = Запрос.ВыполнитьПакет();
	Реквизиты = Результат[0].Выбрать();
	Реквизиты.Следующий();
	                                                                                                                      
	Запрос.УстановитьПараметр("Период"					   , Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация"				   , Реквизиты.Организация);
	Запрос.УстановитьПараметр("Склад"					   , Реквизиты.Склад);
	Запрос.УстановитьПараметр("Назначение"				   , Реквизиты.Назначение);
	Запрос.УстановитьПараметр("Номер"                      , Реквизиты.Номер);  
	Запрос.УстановитьПараметр("УчитыватьПоВидамЗапасов"	   , ПолучитьФункциональнуюОпцию("УчитыватьСебестоимостьТоваровПоВидамЗапасов"));
	Запрос.УстановитьПараметр("ИспользоватьПартионныйУчет" , ПолучитьФункциональнуюОпцию("ИспользоватьПартионныйУчет"));	
	Запрос.УстановитьПараметр("Счет0833"                   ,Справочники.УСОERP_ПредопределенныеЭлементы.СчетУчетаОбъектовНедвижимости.Значение);
	Запрос.УстановитьПараметр("КонецПериода"               ,Новый Граница(КонецДня(Реквизиты.Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НаправлениеДеятельности"    ,ДокументСсылка.ОбъектСтроительства.НаправлениеДеятельности);
	Запрос.УстановитьПараметр("Регистратор"                ,ДокументСсылка);
	Запрос.УстановитьПараметр("ОбъектСтроительства"        ,ДокументСсылка.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Счет2001"                   ,Справочники.УСОERP_ПредопределенныеЭлементы.ПолучитьМассивЗначенийПредопределенныхЭлементов(Справочники.УСОERP_ПредопределенныеЭлементы.СчетУчетаЗатратПоВыполнениюФункцийЗаказчикаЗастройщика));
	
	Выборка = Результат[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		РегистрыСведений.АналитикаУчетаПоПартнерам.СоздатьКлючАналитики(Выборка);
	КонецЦикла;
	
	Выборка = Результат[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		РегистрыСведений.АналитикаУчетаНоменклатуры.СоздатьКлючАналитики(Выборка);
	КонецЦикла; 	
	
	Запрос.Текст =
	  ТекстЗапросаТаблицаПринятиеКУчету()
	+ ТекстЗапросаТаблицаТоварыНаСкладах()
	+ ТекстЗапросаТаблицаСвободныеОстатки()
	+ ТекстЗапросаТаблицаСебестоимостьТоваров()
	+ ТекстЗапросаТаблицаТоварыОрганизаций()
	+ ТекстЗапросаТаблицаПартииТоваровОрганизаций()
	+ ТекстЗапросаТаблицаНДСИнвестиционный()				
	+ ТекстЗапросаТаблицаПрочиеРасходы()
	+ ТекстЗапросаТаблицаРасчетыСКлиентами()
	+ ТекстЗапросаТаблицаОбеспечениеЗаказов(); 
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("ТаблицаТоварыНаСкладах"		  , Результат[1].Выгрузить());
	ТаблицыДляДвижений.Вставить("ТаблицаСвободныеОстатки"		  , Результат[2].Выгрузить());
	ТаблицыДляДвижений.Вставить("ТаблицаСебестоимостьТоваров"	  , Результат[3].Выгрузить());
	ТаблицыДляДвижений.Вставить("ТаблицаТоварыОрганизаций"		  , Результат[4].Выгрузить());
	ТаблицыДляДвижений.Вставить("ТаблицаПартииТоваровОрганизаций" , Результат[5].Выгрузить());
	ТаблицыДляДвижений.Вставить("ТаблицаНДСИнвестиционный"		  , Результат[6].Выгрузить());
	ТаблицыДляДвижений.Вставить("ТаблицаПрочиеРасходы",				Результат[7].Выгрузить()); 	
	ТаблицыДляДвижений.Вставить("ТаблицаРасчетыСКлиентами",			Результат[8].Выгрузить());
	ТаблицыДляДвижений.Вставить("ТаблицаОбеспечениеЗаказов",		Результат[9].Выгрузить());  
	
КонецПроцедуры // ИнициализироватьДанныеДокумента()

// Функция формирует и возвращает текст зпроса для подготовки виртуальной таблицы по табл. части "Принятие к учету".
//
Функция ТекстЗапросаТаблицаПринятиеКУчету()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаПринятиеКУчету.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	ТаблицаПринятиеКУчету.Ссылка.Подразделение КАК Подразделение,
	|	ТаблицаПринятиеКУчету.НомерСтроки КАК НомерСтроки,
	|	ТаблицаПринятиеКУчету.Номенклатура КАК Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
	|	ТаблицаПринятиеКУчету.Ссылка.Назначение КАК Назначение,
	|	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК Серия,
	|	РСАналитикаУчетаНоменклатуры.КлючАналитики КАК АналитикаУчетаНоменклатуры,
	|	1 КАК Количество,
	|	ТаблицаПринятиеКУчету.СуммаЗатрат КАК Сумма,
	|	ТаблицаПринятиеКУчету.СуммаЗатрат КАК СуммаБезНДС,
	|	ТаблицаПринятиеКУчету.СуммаЗатратПР КАК СуммаПР,
	|	ТаблицаПринятиеКУчету.СуммаЗатратВР КАК СуммаВР,
	|	ТаблицаПринятиеКУчету.СуммаЗатратУУ КАК СуммаУУ,
	|	ТаблицаПринятиеКУчету.ВидЗапасов КАК ВидЗапасов,
	|	ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка) КАК НомерГТД,
	|	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиУчетаПартий.ПустаяСсылка) КАК АналитикаУчетаПартий
	|ПОМЕСТИТЬ ТаблицаПринятиеКУчету
	|ИЗ
	|	Документ.УСОERP_СдачаОбъектаНедвижимости.ПринятиеКУчету КАК ТаблицаПринятиеКУчету
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаНоменклатуры КАК РСАналитикаУчетаНоменклатуры
	|		ПО ТаблицаПринятиеКУчету.Номенклатура = РСАналитикаУчетаНоменклатуры.Номенклатура
	|			И (РСАналитикаУчетаНоменклатуры.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	|			И (РСАналитикаУчетаНоменклатуры.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка))
	|			И (РСАналитикаУчетаНоменклатуры.МестоХранения = &Склад)
	|			И (РСАналитикаУчетаНоменклатуры.Назначение = &Назначение)
	|ГДЕ
	|	ТаблицаПринятиеКУчету.Ссылка = &ТекущийДокумент
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|"; 	
	
	Возврат ТекстЗапроса;
	
КонецФункции // ТекстЗапросаТаблицаПринятиеКУчету()

// Функция формирует и возвращает текст запроса для проведения документа по регистру накопления "Товары на складах".
//
Функция ТекстЗапросаТаблицаТоварыНаСкладах()
	
	ТекстЗапроса =
	"ВЫБРАТЬ //// [1] ТоварыНаСкладах
	|	ТаблицаПринятиеКУчету.НомерСтроки КАК НомерСтроки,
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&Склад КАК Склад,
	|	ЗНАЧЕНИЕ(Справочник.СкладскиеПомещения.ПустаяСсылка) КАК Помещение,
	|	ТаблицаПринятиеКУчету.Номенклатура КАК Номенклатура,
	|	ТаблицаПринятиеКУчету.Характеристика КАК Характеристика,
	|	ТаблицаПринятиеКУчету.Назначение КАК Назначение,
	|	ТаблицаПринятиеКУчету.Серия КАК Серия,
	|	ТаблицаПринятиеКУчету.Количество КАК ВНаличии
	|ИЗ
	|	ТаблицаПринятиеКУчету КАК ТаблицаПринятиеКУчету
	|
	|ГДЕ
	|	НЕ ТаблицаПринятиеКУчету.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	Возврат ТекстЗапроса; 
	
КонецФункции // ТекстЗапросаТаблицаТоварыНаСкладах()

// Функция формирует и возвращает текст запроса для проведения документа по регистру накопления "Свободные остатки".
//
Функция ТекстЗапросаТаблицаСвободныеОстатки()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ //// [2] СвободныеОстатки
	|	ТаблицаПринятиеКУчету.НомерСтроки КАК НомерСтроки,
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&Склад КАК Склад,
	|	ТаблицаПринятиеКУчету.Номенклатура КАК Номенклатура,
	|	ТаблицаПринятиеКУчету.Характеристика КАК Характеристика,
	|	ТаблицаПринятиеКУчету.Количество КАК ВНаличии
	|ИЗ
	|	ТаблицаПринятиеКУчету КАК ТаблицаПринятиеКУчету
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции // ТекстЗапросаТаблицаСвободныеОстатки()

// Функция формирует и возвращает текст запроса для проведения документа по регистру накопления "Себестоимость товаров".
//
Функция ТекстЗапросаТаблицаСебестоимостьТоваров()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаПринятиеКУчету.НомерСтроки КАК НомерСтроки,
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&Организация КАК Организация,
	|	ТаблицаПринятиеКУчету.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыНаСкладах) КАК РазделУчета,
	|	ВЫБОР
	|		КОГДА &УчитыватьПоВидамЗапасов
	|			ТОГДА ТаблицаПринятиеКУчету.ВидЗапасов
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ВидЗапасов,
	|	ТаблицаПринятиеКУчету.Подразделение,
	|	ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОприходованиеТоваров) КАК ХозяйственнаяОперация,
	|	СУММА(ТаблицаПринятиеКУчету.Сумма + ЕСТЬNULL(ТЧОбъектыНедвижимости.УслугиЗаказчика, 0)) КАК Стоимость,
	|	СУММА(ТаблицаПринятиеКУчету.СуммаБезНДС + ЕСТЬNULL(ТЧОбъектыНедвижимости.УслугиЗаказчика, 0)) КАК СтоимостьБезНДС,
	|	СУММА(ТаблицаПринятиеКУчету.Сумма + ЕСТЬNULL(ТЧОбъектыНедвижимости.УслугиЗаказчика, 0)) КАК СтоимостьРегл,
	|	СУММА(ТаблицаПринятиеКУчету.СуммаПР + ЕСТЬNULL(ТЧОбъектыНедвижимости.УслугиЗаказчикаПР, 0)) КАК ПостояннаяРазница,
	|	СУММА(ТаблицаПринятиеКУчету.СуммаВР + ЕСТЬNULL(ТЧОбъектыНедвижимости.УслугиЗаказчикаВР, 0)) КАК ВременнаяРазница,
	|	СУММА(ТаблицаПринятиеКУчету.СуммаУУ + ЕСТЬNULL(ТЧОбъектыНедвижимости.УслугиЗаказчикаУУ, 0)) КАК СтоимостьУпр,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыЗаписейПартий.Партия) КАК ТипЗаписи,
	|	ТаблицаПринятиеКУчету.Количество КАК Количество
	|ИЗ
	|	ТаблицаПринятиеКУчету КАК ТаблицаПринятиеКУчету
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ОбъектыНедвижимости.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|			ОбъектыНедвижимости.УслугиЗаказчика КАК УслугиЗаказчика,
	|			ОбъектыНедвижимости.УслугиЗаказчикаНУ КАК УслугиЗаказчикаНУ,
	|			ОбъектыНедвижимости.УслугиЗаказчикаПР КАК УслугиЗаказчикаПР,
	|			ОбъектыНедвижимости.УслугиЗаказчикаВР КАК УслугиЗаказчикаВР,
	|			ОбъектыНедвижимости.УслугиЗаказчикаУУ КАК УслугиЗаказчикаУУ
	|		ИЗ
	|			Документ.УСОERP_СдачаОбъектаНедвижимости.ОбъектыНедвижимости КАК ОбъектыНедвижимости
	|		ГДЕ
	|			ОбъектыНедвижимости.Ссылка = &ТекущийДокумент
	|			И ОбъектыНедвижимости.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийСОбъектамиСтроительства.ПринятиеКУчету)) КАК ТЧОбъектыНедвижимости
	|		ПО ТаблицаПринятиеКУчету.ОбъектНедвижимости = ТЧОбъектыНедвижимости.ОбъектНедвижимости
	|ГДЕ
	|	НЕ ТаблицаПринятиеКУчету.АналитикаУчетаНоменклатуры = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиУчетаНоменклатуры.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаПринятиеКУчету.Количество,
	|	ТаблицаПринятиеКУчету.НомерСтроки,
	|	ТаблицаПринятиеКУчету.АналитикаУчетаНоменклатуры,
	|	ТаблицаПринятиеКУчету.Подразделение,
	|	ВЫБОР
	|		КОГДА &УчитыватьПоВидамЗапасов
	|			ТОГДА ТаблицаПринятиеКУчету.ВидЗапасов
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции // ТекстЗапросаТаблицаСебестоимостьТоваров()

