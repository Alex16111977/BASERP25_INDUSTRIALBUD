#Область ПолучениеДанных

// Функция получает данные и возвращает таблицу значений для заполнения сведений о восстановлении НДС.
//
Функция ПолучитьДанныеЗаполненияВосстановленияНДС(СтруктураПараметров) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаДокумента"		, СтруктураПараметров.ДатаДокумента);
	Запрос.УстановитьПараметр("Организация"			, СтруктураПараметров.Организация);
	Запрос.УстановитьПараметр("ОбъектСтроительства"	, СтруктураПараметров.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Счет"				, СтруктураПараметров.Счет);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетнаяПолитика.СчетУчетаИнвестиционногоНДС КАК СчетУчетаИнвестиционногоНДС
	|ПОМЕСТИТЬ ВТУчетнаяПолитика
	|ИЗ
	|	РегистрСведений.УСОERP_УчетнаяПолитикаПоДолевомуСтроительству.СрезПоследних(&ДатаДокумента, Организация = &Организация) КАК УчетнаяПолитика
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетУчетаИнвестиционногоНДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НДСИнвестиционный.Контрагент КАК Контрагент,
	|	НДСИнвестиционный.ДокументПоступления КАК ДокументПоступления,
	|	НДСИнвестиционный.Номенклатура КАК Номенклатура,
	|	НДСИнвестиционный.СчетУчетаНДС КАК СчетУчетаНДС,
	|	ВЫБОР
	|		КОГДА НДСИнвестиционный.СуммаБезНДСРасход ЕСТЬ NULL 
	|				ИЛИ НДСИнвестиционный.СуммаНДСРасход ЕСТЬ NULL 
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)
	|		КОГДА НДСИнвестиционный.СуммаБезНДСРасход = 0
	|				ИЛИ НДСИнвестиционный.СуммаНДСРасход = 0
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|		КОГДА (ВЫРАЗИТЬ(НДСИнвестиционный.СуммаНДСРасход / НДСИнвестиционный.СуммаБезНДСРасход КАК ЧИСЛО(15, 2))) = 0.18
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18)
	|		КОГДА (ВЫРАЗИТЬ(НДСИнвестиционный.СуммаНДСРасход / НДСИнвестиционный.СуммаБезНДСРасход КАК ЧИСЛО(15, 2))) = 0.2
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20)
	|		КОГДА (ВЫРАЗИТЬ(НДСИнвестиционный.СуммаНДСРасход / НДСИнвестиционный.СуммаБезНДСРасход КАК ЧИСЛО(15, 2))) = 0.1
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС10)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)
	|	КОНЕЦ КАК СтавкаНДС,
	|	НДСИнвестиционный.СуммаБезНДСРасход КАК СуммаБезНДС,
	|	НДСИнвестиционный.СуммаНДСРасход КАК СуммаНДС,
	|	НДСИнвестиционный.СпособСтроительства КАК СпособСтроительства,
	|	&Счет КАК СчетСписанияНДС,
	|	НДСИнвестиционный.ОбъектСтроительства КАК ОбъектСтроительства
	|ИЗ
	|	РегистрНакопления.УСОERP_НДСИнвестиционный.Обороты(
	|			,
	|			&ДатаДокумента,
	|			,
	|			Организация = &Организация
	|				И ОбъектСтроительства = &ОбъектСтроительства
	|				И СчетУчетаНДС В
	|					(ВЫБРАТЬ
	|						ВТУчетнаяПолитика.СчетУчетаИнвестиционногоНДС
	|					ИЗ
	|						ВТУчетнаяПолитика КАК ВТУчетнаяПолитика)) КАК НДСИнвестиционный";
	
	Возврат Запрос.Выполнить().Выгрузить();			   
				   
КонецФункции // ПолучитьДанныеЗаполненияВосстановленияНДС()

// Функция получает данные и возвращает выборку данных для заполнения сведений о хозрасчетных суммах остатка.
//
Функция ПолучитьДанныеПоОстаткамХозрасчетного(СтруктураПараметров) Экспорт
	
	МассивСубконто = Новый Массив;
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ОбъектыСтроительства);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаДокумента"		, СтруктураПараметров.ДатаДокумента);
	Запрос.УстановитьПараметр("Организация"			, СтруктураПараметров.Организация);
	Запрос.УстановитьПараметр("ОбъектСтроительства"	, СтруктураПараметров.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Счет"				, СтруктураПараметров.Счет);
	Запрос.УстановитьПараметр("МассивСубконто"		, МассивСубконто);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ХозрасчетныйОстатки.СуммаОстаток КАК СуммаЗатрат,
	|	ХозрасчетныйОстатки.СуммаНУОстаток КАК СуммаЗатратНУ,
	|	ХозрасчетныйОстатки.СуммаПРОстаток КАК СуммаЗатратПР,
	|	ХозрасчетныйОстатки.СуммаВРОстаток КАК СуммаЗатратВР,
	|	ХозрасчетныйОстатки.СуммаУУОстаток КАК СуммаЗатратУУ
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&ДатаДокумента,
	|			Счет = &Счет,
	|			&МассивСубконто,
	|			Организация = &Организация
	|				И Субконто1 = &ОбъектСтроительства) КАК ХозрасчетныйОстатки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка;
	
КонецФункции // ПолучитьДанныеПоОстаткамХозрасчетного()	

// Функция получает данные и возвращает таблицу значений для заполнения сведений об объектах недвижимости.
//
Функция ПолучитьДанныеЗаполненияОбъектовНедвижимости(СтруктураПараметров) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаДокумента"		, СтруктураПараметров.ДатаДокумента);
	Запрос.УстановитьПараметр("ОбъектСтроительства"	, СтруктураПараметров.ОбъектСтроительства);
	Запрос.УстановитьПараметр("ПлощадьФактическая"	, СтруктураПараметров.ПлощадьФактическая);
	Запрос.УстановитьПараметр("СуммаЗатрат"			, СтруктураПараметров.СуммаЗатрат);
	Запрос.УстановитьПараметр("СуммаЗатратНУ"		, СтруктураПараметров.СуммаЗатратНУ);
	Запрос.УстановитьПараметр("СуммаЗатратПР"		, СтруктураПараметров.СуммаЗатратПР);
	Запрос.УстановитьПараметр("СуммаЗатратВР"		, СтруктураПараметров.СуммаЗатратВР);
	Запрос.УстановитьПараметр("СуммаЗатратУУ"		, СтруктураПараметров.СуммаЗатратУУ);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ОбъектыНедвижимости.Ссылка КАК ОбъектНедвижимости
	|ПОМЕСТИТЬ ВТОбъектыНедвижимости
	|ИЗ
	|	Справочник.АУН_ОбъектыНедвижимости КАК ОбъектыНедвижимости
	|ГДЕ
	|	ОбъектыНедвижимости.ОбъектЭксплуатации = &ОбъектСтроительства
	|	И НЕ ОбъектыНедвижимости.ПометкаУдаления
	|	И ОбъектыНедвижимости.КатегорияОбъекта <> ЗНАЧЕНИЕ(Перечисление.АУН_КатегорииОбъектовНедвижимости.Здание)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОбъектНедвижимости
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТОбъектыНедвижимости.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	ЕСТЬNULL(ПлощадиОбъектовНедвижимости.ОбщаяПлощадь, 0) КАК ПлощадьПроектная,
	|	ЕСТЬNULL(ПараметрыОбъектовНедвижимостиПоБТИ.ОбщаяПлощадь, 0) КАК ПлощадьФактическая
	|ПОМЕСТИТЬ ВТПлощадиОбъектовНедвижимости
	|ИЗ
	|	ВТОбъектыНедвижимости КАК ВТОбъектыНедвижимости
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УПН_ПлощадиОбъектовНедвижимости.СрезПоследних(
	|				&ДатаДокумента,
	|				ОбъектНедвижимости В
	|					(ВЫБРАТЬ
	|						ВТОбъектыНедвижимости.ОбъектНедвижимости
	|					ИЗ
	|						ВТОбъектыНедвижимости)) КАК ПлощадиОбъектовНедвижимости
	|		ПО ВТОбъектыНедвижимости.ОбъектНедвижимости = ПлощадиОбъектовНедвижимости.ОбъектНедвижимости
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УПН_ПараметрыОбъектовНедвижимостиПоБТИ.СрезПоследних(
	|				&ДатаДокумента,
	|				ОбъектНедвижимости В
	|					(ВЫБРАТЬ
	|						ВТОбъектыНедвижимости.ОбъектНедвижимости
	|					ИЗ
	|						ВТОбъектыНедвижимости)) КАК ПараметрыОбъектовНедвижимостиПоБТИ
	|		ПО ВТОбъектыНедвижимости.ОбъектНедвижимости = ПараметрыОбъектовНедвижимостиПоБТИ.ОбъектНедвижимости
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОбъектНедвижимости
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТПлощадиОбъектовНедвижимости.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	ВТПлощадиОбъектовНедвижимости.ПлощадьПроектная КАК ПлощадьПроектная,
	|	ВТПлощадиОбъектовНедвижимости.ПлощадьФактическая КАК ПлощадьФактическая,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА &ПлощадьФактическая = 0
	|				ТОГДА 0
	|			ИНАЧЕ ВТПлощадиОбъектовНедвижимости.ПлощадьФактическая / &ПлощадьФактическая * &СуммаЗатрат
	|		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК СуммаЗатрат,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА &ПлощадьФактическая = 0
	|				ТОГДА 0
	|			ИНАЧЕ ВТПлощадиОбъектовНедвижимости.ПлощадьФактическая / &ПлощадьФактическая * &СуммаЗатратНУ
	|		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК СуммаЗатратНУ,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА &ПлощадьФактическая = 0
	|				ТОГДА 0
	|			ИНАЧЕ ВТПлощадиОбъектовНедвижимости.ПлощадьФактическая / &ПлощадьФактическая * &СуммаЗатратПР
	|		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК СуммаЗатратПР,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА &ПлощадьФактическая = 0
	|				ТОГДА 0
	|			ИНАЧЕ ВТПлощадиОбъектовНедвижимости.ПлощадьФактическая / &ПлощадьФактическая * &СуммаЗатратВР
	|		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК СуммаЗатратВР,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА &ПлощадьФактическая = 0
	|				ТОГДА 0
	|			ИНАЧЕ ВТПлощадиОбъектовНедвижимости.ПлощадьФактическая / &ПлощадьФактическая * &СуммаЗатратУУ
	|		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК СуммаЗатратУУ,	
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СоответствиеДоговоровИДолей.Расторгнут, НЕОПРЕДЕЛЕНО) = ЛОЖЬ
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийСОбъектамиСтроительства.СдачаИнвестору)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийСОбъектамиСтроительства.ПринятиеКУчету)
	|	КОНЕЦ КАК ВидОперации,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СоответствиеДоговоровИДолей.Расторгнут, НЕОПРЕДЕЛЕНО) = ЛОЖЬ
	|			ТОГДА СоответствиеДоговоровИДолей.Контрагент
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СоответствиеДоговоровИДолей.Расторгнут, НЕОПРЕДЕЛЕНО) = ЛОЖЬ
	|			ТОГДА СоответствиеДоговоровИДолей.Договор
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Договор
	|ИЗ
	|	ВТПлощадиОбъектовНедвижимости КАК ВТПлощадиОбъектовНедвижимости
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_СоответствиеДоговоровИДолей.СрезПоследних(
	|				&ДатаДокумента,
	|				Доля В
	|					(ВЫБРАТЬ
	|						ВТОбъектыНедвижимости.ОбъектНедвижимости
	|					ИЗ
	|						ВТОбъектыНедвижимости)) КАК СоответствиеДоговоровИДолей
	|		ПО ВТПлощадиОбъектовНедвижимости.ОбъектНедвижимости = СоответствиеДоговоровИДолей.Доля";
	
	Возврат Запрос.Выполнить().Выгрузить();			   
				   
КонецФункции // ПолучитьДанныеЗаполненияОбъектовНедвижимости()

// Функция получает данные и возвращает таблицу значений для заполнения сведений о принятых к учету объектов недвижимости.
//
Функция ПолучитьДанныеЗаполненияПринятияКУчету(СтруктураПараметров) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбъектыНедвижимости", СтруктураПараметров.ОбъектыНедвижимости);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбъектыНедвижимости.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	ОбъектыНедвижимости.ПлощадьПроектная КАК ПлощадьПроектная,
	|	ОбъектыНедвижимости.ПлощадьФактическая КАК ПлощадьФактическая,
	|	ОбъектыНедвижимости.СуммаЗатрат КАК СуммаЗатрат,
	|	ОбъектыНедвижимости.СуммаЗатратНУ КАК СуммаЗатратНУ,
	|	ОбъектыНедвижимости.СуммаЗатратПР КАК СуммаЗатратПР,
	|	ОбъектыНедвижимости.СуммаЗатратВР КАК СуммаЗатратВР,
	|	ОбъектыНедвижимости.СуммаЗатратУУ КАК СуммаЗатратУУ
	|ПОМЕСТИТЬ ВТОбъектыНедвижимости
	|ИЗ
	|	&ОбъектыНедвижимости КАК ОбъектыНедвижимости
	|ГДЕ
	|	ОбъектыНедвижимости.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийСОбъектамиСтроительства.ПринятиеКУчету)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОбъектНедвижимости
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТОбъектыНедвижимости.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	СправочникОбъектыНедвижимости.Номенклатура КАК Номенклатура,
	|	ВТОбъектыНедвижимости.ПлощадьПроектная КАК ПлощадьПроектная,
	|	ВТОбъектыНедвижимости.ПлощадьФактическая КАК ПлощадьФактическая,
	|	ВТОбъектыНедвижимости.СуммаЗатрат КАК СуммаЗатрат,
	|	ВТОбъектыНедвижимости.СуммаЗатратНУ КАК СуммаЗатратНУ,
	|	ВТОбъектыНедвижимости.СуммаЗатратПР КАК СуммаЗатратПР,
	|	ВТОбъектыНедвижимости.СуммаЗатратВР КАК СуммаЗатратВР,
	|	ВТОбъектыНедвижимости.СуммаЗатратУУ КАК СуммаЗатратУУ,
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ГотоваяПродукция) КАК Счет
	|ИЗ
	|	ВТОбъектыНедвижимости КАК ВТОбъектыНедвижимости
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.АУН_ОбъектыНедвижимости КАК СправочникОбъектыНедвижимости
	|		ПО ВТОбъектыНедвижимости.ОбъектНедвижимости = СправочникОбъектыНедвижимости.Ссылка";
	
	Возврат Запрос.Выполнить().Выгрузить();			   
	
КонецФункции // ПолучитьДанныеЗаполненияПринятияКУчету()

// Функция получает данные и возвращает таблицу значений для заполнения сведений о сданных инвестору объектов недвижимости.
//
Функция ПолучитьДанныеЗаполненияСдачиИнвестору(СтруктураПараметров) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"			, СтруктураПараметров.Организация);
	Запрос.УстановитьПараметр("ОбъектыНедвижимости"	, СтруктураПараметров.ОбъектыНедвижимости);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбъектыНедвижимости.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	ОбъектыНедвижимости.ПлощадьПроектная КАК ПлощадьПроектная,
	|	ОбъектыНедвижимости.ПлощадьФактическая КАК ПлощадьФактическая,
	|	ОбъектыНедвижимости.СуммаЗатрат КАК СуммаЗатрат,
	|	ОбъектыНедвижимости.СуммаЗатратНУ КАК СуммаЗатратНУ,
	|	ОбъектыНедвижимости.СуммаЗатратПР КАК СуммаЗатратПР,
	|	ОбъектыНедвижимости.СуммаЗатратВР КАК СуммаЗатратВР,
	|	ОбъектыНедвижимости.СуммаЗатратУУ КАК СуммаЗатратУУ,
	|	ОбъектыНедвижимости.Контрагент КАК Контрагент,
	|	ОбъектыНедвижимости.Договор КАК Договор
	|ПОМЕСТИТЬ ВТОбъектыНедвижимости
	|ИЗ
	|	&ОбъектыНедвижимости КАК ОбъектыНедвижимости
	|ГДЕ
	|	ОбъектыНедвижимости.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийСОбъектамиСтроительства.СдачаИнвестору)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТОбъектыНедвижимости.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	ВТОбъектыНедвижимости.ПлощадьПроектная КАК ПлощадьПроектная,
	|	ВТОбъектыНедвижимости.ПлощадьФактическая КАК ПлощадьФактическая,
	|	ВТОбъектыНедвижимости.СуммаЗатрат КАК СуммаЗатрат,
	|	ВТОбъектыНедвижимости.СуммаЗатратНУ КАК СуммаЗатратНУ,
	|	ВТОбъектыНедвижимости.СуммаЗатратПР КАК СуммаЗатратПР,
	|	ВТОбъектыНедвижимости.СуммаЗатратВР КАК СуммаЗатратВР,
	|	ВТОбъектыНедвижимости.СуммаЗатратУУ КАК СуммаЗатратУУ,
	|	ПорядокОтраженияРасчетовСПартнерами.СчетУчетаРасчетовСКлиентами КАК СчетРасчетов,
	|	ВТОбъектыНедвижимости.Контрагент КАК Контрагент,
	|	ВТОбъектыНедвижимости.Договор КАК Договор
	|ИЗ
	|	ВТОбъектыНедвижимости КАК ВТОбъектыНедвижимости
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокОтраженияРасчетовСПартнерами КАК ПорядокОтраженияРасчетовСПартнерами
	|		ПО (ПорядокОтраженияРасчетовСПартнерами.Организация = &Организация)
	|			И ВТОбъектыНедвижимости.Договор.ГруппаФинансовогоУчета = ПорядокОтраженияРасчетовСПартнерами.ГруппаФинансовогоУчета";
	
	Возврат Запрос.Выполнить().Выгрузить();			   
	
КонецФункции // ПолучитьДанныеЗаполненияСдачиИнвестору()

#КонецОбласти

#Область СозданиеНоменклатуры

// Процедура формирует список необходимой номенклатуры и создает ее, привязывая до объектов строительства.
//
Процедура СоздатьНоменклатуруДляОбъектовНедвижимости(СтруктураПараметров) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаДокумента"		, СтруктураПараметров.ДатаДокумента);
	Запрос.УстановитьПараметр("Организация"			, СтруктураПараметров.Организация);
	Запрос.УстановитьПараметр("ГруппаНоменклатуры"	, СтруктураПараметров.ГруппаНоменклатуры);
	Запрос.УстановитьПараметр("ОбъектыНедвижимости"	, СтруктураПараметров.ОбъектыНедвижимости);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ОбъектыНедвижимости.ОбъектНедвижимости КАК ОбъектНедвижимости
	|ПОМЕСТИТЬ ВТОбъектыНедвижимости
	|ИЗ
	|	&ОбъектыНедвижимости КАК ОбъектыНедвижимости
	|ГДЕ
	|	ОбъектыНедвижимости.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийСОбъектамиСтроительства.ПринятиеКУчету)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОбъектНедвижимости
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетнаяПолитикаПоДолевомуСтроительству.ВидНоменклатуры КАК ВидНоменклатуры,
	|	УчетнаяПолитикаПоДолевомуСтроительству.ГруппаНастроекФинУчетаНоменклатуры КАК ГруппаФинансовогоУчета,
	|	УчетнаяПолитикаПоДолевомуСтроительству.ГруппаДоступаНоменклатуры КАК ГруппаДоступа,
	|	УчетнаяПолитикаПоДолевомуСтроительству.ЕдиницаИзмеренияНоменклатуры КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ВТУчетнаяПолитикаПоДолевомуСтроительству
	|ИЗ
	|	РегистрСведений.УСОERP_УчетнаяПолитикаПоДолевомуСтроительству.СрезПоследних(&ДатаДокумента, Организация = &Организация) КАК УчетнаяПолитикаПоДолевомуСтроительству
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТОбъектыНедвижимости.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	СправочникОбъектыНедвижимости.Наименование КАК Наименование,
	|	СправочникОбъектыНедвижимости.Наименование КАК НаименованиеПолное,
	|	&ГруппаНоменклатуры КАК Родитель,
	|	ЗНАЧЕНИЕ(Перечисление.ГрадацииКачества.Новый) КАК Качество,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18) КАК СтавкаНДС,
	|	ЕСТЬNULL(ВТУчетнаяПолитикаПоДолевомуСтроительству.ВидНоменклатуры, НЕОПРЕДЕЛЕНО) КАК ВидНоменклатуры,
	|	ЕСТЬNULL(ВТУчетнаяПолитикаПоДолевомуСтроительству.ГруппаФинансовогоУчета, НЕОПРЕДЕЛЕНО) КАК ГруппаФинансовогоУчета,
	|	ЕСТЬNULL(ВТУчетнаяПолитикаПоДолевомуСтроительству.ГруппаДоступа, НЕОПРЕДЕЛЕНО) КАК ГруппаДоступа,
	|	ЕСТЬNULL(ВТУчетнаяПолитикаПоДолевомуСтроительству.ЕдиницаИзмерения, НЕОПРЕДЕЛЕНО) КАК ЕдиницаИзмерения
	|ИЗ
	|	ВТОбъектыНедвижимости КАК ВТОбъектыНедвижимости
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.АУН_ОбъектыНедвижимости КАК СправочникОбъектыНедвижимости
	|		ПО ВТОбъектыНедвижимости.ОбъектНедвижимости = СправочникОбъектыНедвижимости.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТУчетнаяПолитикаПоДолевомуСтроительству КАК ВТУчетнаяПолитикаПоДолевомуСтроительству
	|		ПО (ИСТИНА)
	|ГДЕ
	|	СправочникОбъектыНедвижимости.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Не ПроверитьЗаполнениеУчетнойПолитикиПоДолевомуСтроительству(Выборка, СтруктураПараметров) Тогда
			Возврат; // полностью выйдем с процедуры
		КонецЕсли;
		
		СписокИсключаемыхСвойств = "Ссылка, Владелец, ПометкаУдаления, ВерсияДанных, Предопределенный, ЭтоГруппа, Родитель, Описание, Наименование, Код, ИмяПредопределенныхДанных";
		НоменклатураНедвижимости = Справочники.Номенклатура.СоздатьЭлемент();
		
		ЗаполнитьЗначенияСвойств(НоменклатураНедвижимости, Выборка.ВидНоменклатуры, , СписокИсключаемыхСвойств);
		ЗаполнитьЗначенияСвойств(НоменклатураНедвижимости, Выборка);
		
		Попытка
			НоменклатураНедвижимости.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не удалось создать номенклатуру """ + 
			Выборка.Наименование + """ по причине: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(НоменклатураНедвижимости.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ОбъектНедвижимости = Выборка.ОбъектНедвижимости.ПолучитьОбъект();
		ОбъектНедвижимости.Номенклатура = НоменклатураНедвижимости.Ссылка;
		
		Попытка
			ОбъектНедвижимости.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не удалось записать объект недвижимости """ + 
			ОбъектНедвижимости.Наименование + """ по причине: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;  		
	КонецЦикла;
	
КонецПроцедуры // СоздатьНоменклатуруДляОбъектовНедвижимости()

// Функция проверяет заполнение учетной политики по долевому строительству и возвращает результат данной проверки.
//
Функция ПроверитьЗаполнениеУчетнойПолитикиПоДолевомуСтроительству(Выборка, СтруктураПараметров)
	
	УчетнойПолитикаЗаполнена = (Выборка.ВидНоменклатуры <> Неопределено);
	Если Не УчетнойПолитикаЗаполнена Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='На дату " + Формат(СтруктураПараметров.ДатаДокумента, "ДФ=dd.MM.yyyy") + " для организации """ +
		Строка(СтруктураПараметров.Организация) + """ не заполнен регистр ""Учетная политика по долевому строительству"", создание номенклатуры невозможно'"));
	КонецЕсли;
	
	Возврат УчетнойПолитикаЗаполнена;
	
КонецФункции // ПроверитьЗаполнениеУчетнойПолитикиПоДолевомуСтроительству()

#КонецОбласти

