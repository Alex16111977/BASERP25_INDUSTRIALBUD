//
Функция ТекстОтраженияВРеглУчете() Экспорт	
							
	УслугиЗаказчикаЗастройщика = ТекстЗапросаУслугиЗаказчика();
	ТекстЗапросаСписаниеЗатрат = ТекстЗапросаСписаниеЗатрат();	
	ТекстЗапросаВыручка = ТекстЗапросаВыручка();
	ТекстЗапросаЗабаланс = ТекстЗапросаЗабаланс();
	//ТекстЗапросаНДСССМР = ТекстЗапросаНДСССМР();
	
	Возврат УслугиЗаказчикаЗастройщика 
	+ " ОБЪЕДИНИТЬ ВСЕ " + ТекстЗапросаСписаниеЗатрат
	//+ " ОБЪЕДИНИТЬ ВСЕ " + ТекстЗапросаНДСССМР
	+ " ОБЪЕДИНИТЬ ВСЕ " + ТекстЗапросаВыручка
	+ " ОБЪЕДИНИТЬ ВСЕ " + ТекстЗапросаЗабаланс; 	
	
КонецФункции // ТекстОтраженияВРеглУчете()

// Функция возвращает текст запроса дополнительных временных таблиц, 
// необходимых для отражения в регламетированном учете
//
Функция ТекстЗапросаВТОтраженияВРеглУчете() Экспорт
	
	ТекстЗапроса = "";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаУслугиЗаказчика()
	
	ТекстЗапросаУслугиЗаказчика = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Ссылка,
	|	ВложенныйЗапрос.Ссылка.Дата КАК Период,
	|	ВложенныйЗапрос.Ссылка.Организация КАК Организация,
	|	НЕОПРЕДЕЛЕНО КАК ИдентификаторСтроки,
	|	ЕСТЬNULL(ВложенныйЗапрос.СуммаБУ, 0) КАК Сумма,
	
	|	ЕСТЬNULL(ВложенныйЗапрос.СуммаУУ, 0) КАК СуммаУУ,

	|	НЕОПРЕДЕЛЕНО КАК ВидСчетаДт,
	|	НЕОПРЕДЕЛЕНО КАК АналитикаУчетаДт,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчетаДт,
	|	НЕОПРЕДЕЛЕНО КАК ВалютаДт,
	|	ВложенныйЗапрос.Ссылка.Подразделение КАК ПодразделениеДт,
	|	ВложенныйЗапрос.Ссылка.ОбъектСтроительства.НаправлениеДеятельности КАК НаправлениеДеятельностиДт,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийСОбъектамиСтроительства.Сдачаинвестору)
	|			ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СебестоимостьПродажНеЕНВД)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Готоваяпродукция)
	|	КОНЕЦ КАК СчетДт,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийСОбъектамиСтроительства.Сдачаинвестору)
	|			ТОГДА ВложенныйЗапрос.ОбъектНедвижимости.ОбъектЭксплуатации.УСОERP_ГруппаФинансовогоУчета
	|		ИНАЧЕ ВложенныйЗапрос.ОбъектНедвижимости.Номенклатура
	|	КОНЕЦ КАК СубконтоДт1,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийСОбъектамиСтроительства.Сдачаинвестору)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ВложенныйЗапрос.Ссылка.Склад
	|	КОНЕЦ КАК СубконтоДт2,
	|	НЕОПРЕДЕЛЕНО КАК СубконтоДт3,
	|	0 КАК ВалютнаяСуммаДт,
	|	0 КАК КоличествоДт,
	|	ВложенныйЗапрос.СуммаНУ КАК СуммаНУДт,
	|	ВложенныйЗапрос.СуммаПР КАК СуммаПРДт,
	|	ВложенныйЗапрос.СуммаВР КАК СуммаВРДт,
	|	НЕОПРЕДЕЛЕНО КАК ВидСчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК АналитикаУчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК ВалютаКт,
	|	ВложенныйЗапрос.Подразделение КАК ПодразделениеКт,
	|	ВложенныйЗапрос.НаправлениеДеятельности КАК НаправлениеДеятельностиКт,
	|	ВложенныйЗапрос.СтатьяРасходов.СчетУчета КАК СчетКт,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыЗатратРегл.Прочее) КАК СубконтоКт1,
	|	ВложенныйЗапрос.СтатьяРасходов КАК СубконтоКт2,
	|	НЕОПРЕДЕЛЕНО КАК СубконтоКт3,
	|	0 КАК ВалютнаяСуммаКт,
	|	0 КАК КоличествоКт,
	|	ВложенныйЗапрос.СуммаНУ КАК СуммаНУКт,
	|	ВложенныйЗапрос.СуммаПР КАК СуммаПРКт,
	|	ВложенныйЗапрос.СуммаВР КАК СуммаВРКт,
	|	""Услуги заказчика-застройщика"" КАК Содержание
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТаблицаДвижений.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|		ТаблицаДвижений.ВидОперации КАК ВидОперации,
	|		ТаблицаДвижений.Ссылка КАК Ссылка,
	|		ТаблицаДвижений.СтатьяРасходов КАК СтатьяРасходов,
	|		ТаблицаДвижений.СуммаБУ + ВЫБОР
	|			КОГДА ТаблицаДвижений.НомерСтроки = ТаблицаДвижений.КоличествоСтрок
	|					И ТаблицаДвижений.СуммаБУ_Итог <> ТаблицаДвижений.СуммаБУ_ИтогПР
