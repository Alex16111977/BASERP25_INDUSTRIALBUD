	|				ТОГДА 0
	|			ИНАЧЕ ЕСТЬNULL(ВЗ_Хозрасчетный.СуммаБезНДС, 0)
	|		КОНЕЦ) КАК СуммаБезНДС,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(ВЗ_ПрочиеРасходы.СуммаРеглОстаток, 0) = 0
	|				ТОГДА 0
	|			ИНАЧЕ ЕСТЬNULL(ВЗ_Хозрасчетный.СуммаОборот, 0)
	|		КОНЕЦ) КАК СуммаРегл,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(ВЗ_ПрочиеРасходы.ПостояннаяРазницаОстаток, 0) = 0
	|				ТОГДА 0
	|			ИНАЧЕ ЕСТЬNULL(ВЗ_Хозрасчетный.СуммаПРОборот, 0)
	|		КОНЕЦ) КАК ПостояннаяРазница,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(ВЗ_ПрочиеРасходы.ВременнаяРазницаОстаток, 0) = 0
	|				ТОГДА 0
	|			ИНАЧЕ ЕСТЬNULL(ВЗ_Хозрасчетный.СуммаВРОборот, 0)
	|		КОНЕЦ) КАК ВременнаяРазница,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(ВЗ_ПрочиеРасходы.СуммаУпрОстаток, 0) = 0
	|				ТОГДА 0
	|			ИНАЧЕ ЕСТЬNULL(ВЗ_Хозрасчетный.СуммаУУОборот, 0)
	|		КОНЕЦ) КАК СуммаУпр,	
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПрочиеРасходыОстатки.Организация КАК Организация,
	|		ПрочиеРасходыОстатки.Подразделение КАК Подразделение,
	|		ПрочиеРасходыОстатки.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|		ПрочиеРасходыОстатки.СтатьяРасходов КАК СтатьяРасходов,
	|		ПрочиеРасходыОстатки.АналитикаРасходов КАК АналитикаРасходов,
	|		ПрочиеРасходыОстатки.СуммаОстаток КАК СуммаОстаток,
	|		ПрочиеРасходыОстатки.СуммаБезНДСОстаток КАК СуммаБезНДСОстаток,
	|		ПрочиеРасходыОстатки.СуммаРеглОстаток КАК СуммаРеглОстаток,
	|		ПрочиеРасходыОстатки.ВременнаяРазницаОстаток КАК ВременнаяРазницаОстаток,
	|		ПрочиеРасходыОстатки.СуммаУпрОстаток КАК СуммаУпрОстаток,
	|		ПрочиеРасходыОстатки.ПостояннаяРазницаОстаток КАК ПостояннаяРазницаОстаток
	|	ИЗ
	|		РегистрНакопления.ПрочиеРасходы.Остатки(
	|				&КонецПериода,
	|				Организация = &Организация
	|					И АналитикаРасходов = &ОбъектСтроительства
	|					И (СтатьяРасходов, НаправлениеДеятельности) В
	|						(ВЫБРАТЬ
	|							ХозрасчетныйОбороты.Субконто2 КАК СтатьяРасходов,
	|							ХозрасчетныйОбороты.НаправлениеДеятельности КАК НаправлениеДеятельности
	|						ИЗ
	|							РегистрБухгалтерии.Хозрасчетный.Обороты(, &КонецПериода, Авто, Счет В ИЕРАРХИИ (&Счет0833), , Организация = &Организация
	|								И Субконто1 = &ОбъектСтроительства, , ) КАК ХозрасчетныйОбороты
	|						ГДЕ
	|							ХозрасчетныйОбороты.Регистратор <> &Регистратор
	|							И ХозрасчетныйОбороты.СуммаОборот <> 0
	|						СГРУППИРОВАТЬ ПО
	|							ХозрасчетныйОбороты.Субконто2,
	|							ХозрасчетныйОбороты.НаправлениеДеятельности)) КАК ПрочиеРасходыОстатки) КАК ВЗ_ПрочиеРасходы
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ХозрасчетныйОбороты.Субконто2 КАК СтатьяРасходов,
	|			ХозрасчетныйОбороты.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|			СУММА(ХозрасчетныйОбороты.СуммаОборот) КАК СуммаОборот,
	|			СУММА(ХозрасчетныйОбороты.СуммаНУОборот) КАК СуммаНУОборот,
	|			СУММА(ХозрасчетныйОбороты.СуммаПРОборот) КАК СуммаПРОборот,
	|			СУММА(ХозрасчетныйОбороты.СуммаВРОборот) КАК СуммаВРОборот,
	|			СУММА(ХозрасчетныйОбороты.СуммаУУОборот) КАК СуммаУУОборот,
	|			ХозрасчетныйОбороты.Подразделение КАК Подразделение,
	|			СРЕДНЕЕ(ЕСТЬNULL(Детализация.Сумма, 0)) КАК Сумма,
	|			СРЕДНЕЕ(ЕСТЬNULL(Детализация.СуммаБезНДС, 0)) КАК СуммаБезНДС
	|		ИЗ
	|			РегистрБухгалтерии.Хозрасчетный.Обороты(
	|					,
	|					&КонецПериода,
	|					Авто,
	|					Счет В ИЕРАРХИИ (&Счет0833),
	|					,
	|					Организация = &Организация
	|						И Субконто1 = &ОбъектСтроительства,
	|					,
	|					) КАК ХозрасчетныйОбороты
	|				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					ДетализацияПоНаправлениямДеятельности.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|					ДетализацияПоНаправлениямДеятельности.Подразделение КАК Подразделение,
	|					ДетализацияПоНаправлениямДеятельности.СтатьяРасходов КАК СтатьяРасходов,
	|					СУММА(ДетализацияПоНаправлениямДеятельности.Сумма) КАК Сумма,
	|					СУММА(ДетализацияПоНаправлениямДеятельности.СуммаБезНДС) КАК СуммаБезНДС
	|				ИЗ
	|					Документ.УСОERP_СдачаОбъектаНедвижимости.ДетализацияПоНаправлениямДеятельности КАК ДетализацияПоНаправлениямДеятельности
	|				ГДЕ
	|					ДетализацияПоНаправлениямДеятельности.Ссылка = &Регистратор
	|				
	|				СГРУППИРОВАТЬ ПО
	|					ДетализацияПоНаправлениямДеятельности.НаправлениеДеятельности,
	|					ДетализацияПоНаправлениямДеятельности.Подразделение,
	|					ДетализацияПоНаправлениямДеятельности.СтатьяРасходов) КАК Детализация
	|				ПО ХозрасчетныйОбороты.НаправлениеДеятельности = Детализация.НаправлениеДеятельности
	|					И ХозрасчетныйОбороты.Субконто2 = Детализация.СтатьяРасходов
	|					И ХозрасчетныйОбороты.Подразделение = Детализация.Подразделение
	|		ГДЕ
	|			ХозрасчетныйОбороты.Регистратор <> &Регистратор
	|			И ХозрасчетныйОбороты.СуммаОборот <> 0
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ХозрасчетныйОбороты.Субконто2,
	|			ХозрасчетныйОбороты.НаправлениеДеятельности,
	|			ХозрасчетныйОбороты.Подразделение) КАК ВЗ_Хозрасчетный
	|		ПО ВЗ_ПрочиеРасходы.Подразделение = ВЗ_Хозрасчетный.Подразделение
	|			И ВЗ_ПрочиеРасходы.НаправлениеДеятельности = ВЗ_Хозрасчетный.НаправлениеДеятельности
	|			И ВЗ_ПрочиеРасходы.СтатьяРасходов = ВЗ_Хозрасчетный.СтатьяРасходов
	|ГДЕ
	|	(ВЫБОР
	|				КОГДА ЕСТЬNULL(ВЗ_ПрочиеРасходы.СуммаОстаток, 0) = 0
	|					ТОГДА 0
	|				ИНАЧЕ ВЫРАЗИТЬ(ВЗ_Хозрасчетный.СуммаОборот * 1.18 КАК ЧИСЛО(15, 2))
	|			КОНЕЦ <> 0
	|			ИЛИ ВЫБОР
	|				КОГДА ЕСТЬNULL(ВЗ_ПрочиеРасходы.СуммаБезНДСОстаток, 0) = 0
	|					ТОГДА 0
	|				ИНАЧЕ ЕСТЬNULL(ВЗ_Хозрасчетный.СуммаОборот, 0)
	|			КОНЕЦ <> 0
	|			ИЛИ ВЫБОР
	|				КОГДА ЕСТЬNULL(ВЗ_ПрочиеРасходы.СуммаРеглОстаток, 0) = 0
	|					ТОГДА 0
	|				ИНАЧЕ ЕСТЬNULL(ВЗ_Хозрасчетный.СуммаОборот, 0)
	|			КОНЕЦ <> 0
	|			ИЛИ ВЫБОР
	|				КОГДА ЕСТЬNULL(ВЗ_ПрочиеРасходы.ПостояннаяРазницаОстаток, 0) = 0
	|					ТОГДА 0
	|				ИНАЧЕ ЕСТЬNULL(ВЗ_Хозрасчетный.СуммаПРОборот, 0)
	|			КОНЕЦ <> 0
	|			ИЛИ ВЫБОР
	|				КОГДА ЕСТЬNULL(ВЗ_ПрочиеРасходы.СуммаУпрОстаток, 0) = 0
	|					ТОГДА 0
	|				ИНАЧЕ ЕСТЬNULL(ВЗ_Хозрасчетный.СуммаУУОборот, 0)
	|			КОНЕЦ <> 0
	|			ИЛИ ВЫБОР
	|				КОГДА ЕСТЬNULL(ВЗ_ПрочиеРасходы.ВременнаяРазницаОстаток, 0) = 0
	|					ТОГДА 0
	|				ИНАЧЕ ЕСТЬNULL(ВЗ_Хозрасчетный.СуммаВРОборот, 0)
	|			КОНЕЦ <> 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЗ_ПрочиеРасходы.Организация,
	|	ВЗ_ПрочиеРасходы.Подразделение,
	|	ВЗ_ПрочиеРасходы.АналитикаРасходов,
	|	ВЗ_ПрочиеРасходы.НаправлениеДеятельности,
	|	ВЗ_ПрочиеРасходы.СтатьяРасходов
	|	;
	|/////////////////////////////////////////////////
	|";   
	
	Возврат ТекстЗапроса1 
	+ " ОБЪЕДИНИТЬ ВСЕ " + ТекстЗапроса2;
	
КонецФункции 

// Функция формирует и возвращает текст запроса для проведения документа по регистру накопления "Расчеты с клиентами".
//
Функция ТекстЗапросаТаблицаРасчетыСКлиентами() 	
	
	ТекстЗапроса = 
	" ВЫБРАТЬ //// [8] РасчетыСКлиентами
	|	&Период КАК Период,
	|	&Период КАК ДатаРегистратора,
	|	&Период КАК ДатаПлатежа,
	|	&Номер КАК НомерРегистратора,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	Аналитика.КлючАналитики КАК АналитикаУчетаПоПартнерам,
	|	ТЧ_СдачаИнвестору.Договор КАК ЗаказКлиента,
	|	ТЧ_СдачаИнвестору.Договор.ВалютаВзаиморасчетов КАК Валюта,
	|	ТЧ_СдачаИнвестору.Договор.ВалютаВзаиморасчетов КАК ВалютаДокумента,
	|	ТЧ_СдачаИнвестору.Договор.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
	|	ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияКлиенту) КАК ХозяйственнаяОперация,
	|	СУММА(ВЫРАЗИТЬ(ТЧ_СдачаИнвестору.Выручка КАК ЧИСЛО(15, 2))) КАК СуммаРегл,
	|	СУММА(ВЫРАЗИТЬ(ТЧ_СдачаИнвестору.ВыручкаУУ КАК ЧИСЛО(15, 2))) КАК СуммаУпр,
	|	СУММА(ТЧ_СдачаИнвестору.Выручка) КАК Сумма,
	|	СУММА(ТЧ_СдачаИнвестору.Выручка) КАК КОтгрузке
	|	,СУММА(0) КАК КОплате
	|ИЗ
	|	Документ.УСОERP_СдачаОбъектаНедвижимости КАК УСОERP_СдачаОбъектаНедвижимости
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_СдачаОбъектаНедвижимости.СдачаИнвестору КАК ТЧ_СдачаИнвестору
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|			ПО ТЧ_СдачаИнвестору.Договор = ДоговорыКонтрагентов.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК Аналитика
	|			ПО ТЧ_СдачаИнвестору.Ссылка.Организация = Аналитика.Организация
	|				И ТЧ_СдачаИнвестору.Контрагент = Аналитика.Контрагент
	|				И ТЧ_СдачаИнвестору.Контрагент.Партнер = Аналитика.Партнер
	|				И ТЧ_СдачаИнвестору.Договор = Аналитика.Договор
	|				И ТЧ_СдачаИнвестору.Ссылка.ОбъектСтроительства.НаправлениеДеятельности = Аналитика.НаправлениеДеятельности
	|		ПО УСОERP_СдачаОбъектаНедвижимости.Ссылка = ТЧ_СдачаИнвестору.Ссылка
	|ГДЕ
	|	УСОERP_СдачаОбъектаНедвижимости.Ссылка = &ТекущийДокумент
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧ_СдачаИнвестору.Договор,
	|	Аналитика.КлючАналитики,
	|	ТЧ_СдачаИнвестору.Договор.ВалютаВзаиморасчетов,
	|	ТЧ_СдачаИнвестору.Договор.ВалютаВзаиморасчетов
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";    
	
	Возврат ТекстЗапроса;
	
КонецФункции 

// Функция формирует и возвращает текст запроса для проведения документа по регистру накопления "Обеспечение заказов".
//
Функция ТекстЗапросаТаблицаОбеспечениеЗаказов()
	
	ТекстЗапроса =
	"ВЫБРАТЬ  //// [9] РасчетыСКлиентами
	|	ТаблицаПринятиеКУчету.НомерСтроки КАК НомерСтроки,
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ТаблицаПринятиеКУчету.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ХарактеристикиНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	&Склад КАК Склад,
	|	ТаблицаПринятиеКУчету.Назначение КАК Назначение,
	|	0 КАК Потребность,
	|	-1 КАК КЗаказу,
	|	1 КАК НаличиеПодЗаказ,
	|	ЛОЖЬ КАК КонтролироватьТолькоНаличиеПодЗаказ
	|ИЗ
	|	ТаблицаПринятиеКУчету КАК ТаблицаПринятиеКУчету
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|		ПО ТаблицаПринятиеКУчету.Номенклатура = ХарактеристикиНоменклатуры.Владелец
	|ГДЕ
	|	НЕ ТаблицаПринятиеКУчету.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции // ТекстЗапросаТаблицаОбеспечениеЗаказов()

