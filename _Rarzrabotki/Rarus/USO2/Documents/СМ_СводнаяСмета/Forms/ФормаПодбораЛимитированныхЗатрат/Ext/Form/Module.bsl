&НаКлиенте
Процедура КоэффициентТрудоемкостиПриИзменении(Элемент)
	
	ЗаполнитьЗначениеВСтрокеТЧ(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ТабЛимЗатратПриАктивизацииСтроки(Элемент)
	
	ТекДанные 			= Элементы.ТабЛимЗатрат.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	БазисноеЗначениеЛЗ 	= ТекДанные.БазисноеЗначениеЛимЗатраты;
	
	ЗаполнитьЗначенияЛЗ(ТекДанные.ЛимитированнаяЗатрата,БазисноеЗначениеЛЗ,ТекДанные.РучнойВвод);
	Если ТекДанные.РучнойВвод Тогда
		ЭтаФорма.ЗначениеЛимЗатраты                     = ТекДанные.ЗначениеЛимЗатраты;
		ЭтаФорма.БазисноеЗначениеЛимЗатраты             = ТекДанные.БазисноеЗначениеЛимЗатраты;
		ЭтаФорма.КоэффициентСметнойЗарплаты             = ТекДанные.КоэффициентСметнойЗарплаты;
		ЭтаФорма.КоэффициентТрудоемкости                = ТекДанные.КоэффициентТрудоемкости;
	Иначе
		ТекДанные.ЗначениеЛимЗатраты					= ЭтаФорма.ЗначениеЛимЗатраты;
		ТекДанные.БазисноеЗначениеЛимЗатраты            = ЭтаФорма.БазисноеЗначениеЛимЗатраты;
	КонецЕсли;
	ЭтаФорма.ФормулаЛимЗатраты                      = ТекДанные.ФормулаЛимЗатраты;
	ЭтаФорма.ФормулаБазисногоЗначениеЛимЗатраты     = ТекДанные.ФормулаБазисногоЗначениеЛимЗатраты;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаполнитьЗначениеВСтрокеТЧ(ИмяЗначения)
	
	ТекДанные 				= Элементы.ТабЛимЗатрат.ТекущиеДанные;
	ТекДанные[ИмяЗначения] 	= ЭтаФорма[ИмяЗначения];
	ТекДанные.РучнойВвод    = Истина;

	Если ТекДанные.ТипЗначенияЗатраты = ПредопределенноеЗначение("Перечисление.СМ_ТипыЗначенийЛимитированныхЗатрат.Процент") Тогда
		ТекДанные.БазисноеЗначениеЛимЗатраты 	= ЭтаФорма.ЗначениеЛимЗатраты;
		ЭтаФорма.БазисноеЗначениеЛимЗатраты		= ЭтаФорма.ЗначениеЛимЗатраты;
	КонецЕсли;
	ОбновитьРасчет();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРасчет()
	
	ТекДанные 			= Элементы.ТабЛимЗатрат.ТекущиеДанные;
	ТекДанные.Расчет 	= Ложь;
	
	Если ЗначениеЗаполнено(ЭтаФорма.ЗначениеЛимЗатраты)
		ИЛИ ЗначениеЗаполнено(ЭтаФорма.БазисноеЗначениеЛимЗатраты)
		ИЛИ ЗначениеЗаполнено(ЭтаФорма.КоэффициентСметнойЗарплаты)
		ИЛИ ЗначениеЗаполнено(ЭтаФорма.КоэффициентТрудоемкости) Тогда
		ТекДанные.Расчет = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьЗначенияЛЗ(ТекЛЗ,БазисноеЗначениеЛЗ,РучнойВвод)
	
	ТекОбъект 										= ТекЛЗ.ПолучитьОбъект();
	Если Не РучнойВвод Тогда
		ЭтаФорма.ЗначениеЛимЗатраты                     = ТекОбъект.ЗначениеЗатратыПоУмолчанию;
		ЭтаФорма.КоэффициентСметнойЗарплаты             = ТекОбъект.КоэффициентСметнойЗарплаты;
		ЭтаФорма.КоэффициентТрудоемкости                = ТекОбъект.КоэффициентТрудоемкости;
	КонецЕсли;

	Если ТекОбъект.ТипЗначенияЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Процент Тогда
		ЭтаФорма.БазисноеЗначениеЛимЗатраты	= ТекОбъект.ЗначениеЗатратыПоУмолчанию;
	Иначе
		ЭтаФорма.БазисноеЗначениеЛимЗатраты = БазисноеЗначениеЛЗ;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти