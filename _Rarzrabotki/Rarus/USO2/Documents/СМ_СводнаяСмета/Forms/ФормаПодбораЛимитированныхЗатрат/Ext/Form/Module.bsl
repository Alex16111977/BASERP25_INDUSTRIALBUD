#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	ПараметрыФормы = ЭтаФорма.Параметры;
	Если ЭтаФорма.Параметры.Свойство("СписокЛЗ") Тогда
		СписокЛЗ = Параметры.СписокЛЗ;
		ТабЛЗ 	 = СМ_СметныйСоставВызовСервера.ПолучитьЛимЗатратыОС(СписокЛЗ, Параметры.МетодикаРасчета);
        ЭтаФорма.ТабЛимЗатрат.Загрузить(ТабЛЗ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	
	МассивЛЗ = Новый Массив;
	
	Для Каждого ТекСтрока Из ЭтаФорма.ТабЛимЗатрат Цикл
		Если ТекСтрока.Расчет Тогда
			МассивЛЗ.Добавить(ТекСтрока);
		КонецЕсли;
	КонецЦикла;
	
	ОповеститьОВыборе(МассивЛЗ); 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеЛимЗатратыПриИзменении(Элемент)
	
	ЗаполнитьЗначениеВСтрокеТЧ(Элемент.Имя);
//	ТекДанные 								= Элементы.ТабЛимЗатрат.ТекущиеДанные;
//	ТекДанные.БазисноеЗначениеЛимЗатраты 	= ЭтаФорма.ЗначениеЛимЗатраты;
//	ЭтаФорма.БазисноеЗначениеЛимЗатраты		= ЭтаФорма.ЗначениеЛимЗатраты;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормулаЛимЗатратыПриИзменении(Элемент)
	
	ЗаполнитьЗначениеВСтрокеТЧ(Элемент.Имя);
	
	ТекущиеДанные = Элементы.ТабЛимЗатрат.ТекущиеДанные;
	ТекЗначение = ТекущиеДанные.ЗначениеЛимЗатраты;
	ТекФормула = СокрЛП(ТекущиеДанные.ФормулаЛимЗатраты);
	Если ТекФормула <> "" Тогда
		ТекФормула = СтрЗаменить(ТекФормула,",",".");
		ТекущиеДанные.ФормулаЛимЗатраты = ТекФормула;
		Попытка
			Формула = "ТекЗначение = " + ТекущиеДанные.ФормулаЛимЗатраты + "; ТекущиеДанные.ЗначениеЛимЗатраты = ТекЗначение;";
			Выполнить(Формула);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Ошибка в формуле, значение затраты не изменено'"));
		КонецПопытки;
	КонецЕсли;
	ЭтаФорма.ЗначениеЛимЗатраты = ТекЗначение;  
	ОбновитьРасчет();
КонецПроцедуры

&НаКлиенте
