Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
     СтандартнаяОбработка = Ложь;
     Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Сводная смета №%1 %2'"), Строка(Данные.НомерСметы), Строка(Данные.Наименование));
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
     СтандартнаяОбработка = Ложь;

     Поля.Добавить("НомерСметы");
	 Поля.Добавить("Наименование");
КонецПроцедуры
// ДокторСофт

#КонецОбласти

