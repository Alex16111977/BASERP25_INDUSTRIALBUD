
#Область РасчетСметы

Процедура ВыполнитьРасчетТекущейСводнойСметы(Ссылка)
	
	Если Не Ссылка.ПометкаУдаления Тогда // ранее было Ссылка.Проведен.. sudav
		СМ_СметаРасчетВызовСервера.РассчитатьЛимитированныеЗатраты(Ссылка);
	Иначе
		СМ_СметаВызовСервера.УдалитьДвижения(Ссылка);
	КонецЕсли;
	
КонецПроцедуры

// Основная процедура расчета сводной сметы, выполняет пересчет сметы.
// Параметры:
//   Объект - ДокументОбъект.СМ_СводнаяСмета или ДокументСсылка.СМ_СводнаяСмета.
//   СметыУжеРассчитаны - Булево - Истина - подчиненные сметы уже рассчитаны и их пересчет не требуется, 
//  					   		   Ложь - требуется пересчет подчиненных смет.
Процедура Перерасчет(Объект, СметыУжеРассчитаны = Ложь) Экспорт
	
	ВыполнитьРасчетТекущейСводнойСметы(Объект);
		
КонецПроцедуры

Процедура ПерерасчетПодчиненныхСмет(Объект) Экспорт
	
	Для Каждого СтрСмет Из Объект.Сметы Цикл
		
		Если СтрСмет.Смета.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(СтрСмет.Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			Документы.СМ_ЛокальнаяСмета.Перерасчет(СтрСмет.Смета,,Ложь);
		Иначе
			Документы.СМ_ОбъектнаяСмета.ПерерасчетВключаяПодчиненныеСметы(СтрСмет.Смета);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

#Область Печать

// Процедура для БСП Печать, добавляет список печатных форм.
//
// Параметры:
//   КомандыПечати - ТаблицаЗначений - таблица в которую добавляются строки, 
//					 				   описывающие команды печати документа СМ_СводнаяСмета.
//   Подробнее - см. подсистему Печать.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	   	
	// основная форма
	КомандаПечати 									= КомандыПечати.Добавить();
	КомандаПечати.менеджерПечати 					= "Документ.СМ_СводнаяСмета";
	КомандаПечати.Идентификатор 					= "ПФ_MXL_МакетСС";
	КомандаПечати.Представление 					= НСтр("ru = 'Печать'");
	КомандаПечати.ЗаголовокФормы					= НСтр("ru = 'Печать сводной сметы'");
	КомандаПечати.ПроверкаПроведенияПередПечатью 	= Истина;
	
	КомандаПечати 									= КомандыПечати.Добавить();
	КомандаПечати.менеджерПечати 					= "Документ.СМ_СводнаяСмета";
	КомандаПечати.Идентификатор 					= "ПФ_MXL_СМ_КЗ_МакетСС";
	КомандаПечати.Представление 					= НСтр("ru = 'Сметный расчет стоимости строительства (Казахстан)'");
	КомандаПечати.ЗаголовокФормы					= НСтр("ru = 'Печать сметного расчета стоимости строительства (Казахстан)'");
	КомандаПечати.ПроверкаПроведенияПередПечатью 	= Истина;
	
	КомандаПечати 									= КомандыПечати.Добавить();
	КомандаПечати.менеджерПечати 					= "Документ.СМ_СводнаяСмета";
	КомандаПечати.Идентификатор 					= "ПФ_MXL_СМ_КЗ_МакетСС_Сводный";
	КомандаПечати.Представление 					= НСтр("ru = 'Сводный сметный расчет (Казахстан)'");
	КомандаПечати.ЗаголовокФормы					= НСтр("ru = 'Печать сводного сметного расчета (Казахстан)'");
	КомандаПечати.ПроверкаПроведенияПередПечатью 	= Истина;
	
КонецПроцедуры

// Формирует печатные формы.
// ПАРАМЕТРЫ:
//  МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                          представление - имя области в которой был выведен объект (выходной параметр);
//  ПараметрыВывода - Структура - дополнительные параметры сформированных табличных документов (выходной параметр).
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	СМ_СметаПечатьВызовСервера.ПечатьСводнойСметы(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
		
	ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ПредставлениеОбъекта

