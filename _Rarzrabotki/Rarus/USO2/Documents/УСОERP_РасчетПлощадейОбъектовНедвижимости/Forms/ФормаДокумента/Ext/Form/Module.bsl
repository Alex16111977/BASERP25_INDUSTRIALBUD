	|УНИЧТОЖИТЬ ВТ_ДанныеПоДоговорам";
	
	Запрос.УстановитьПараметр("КонецПериода", Новый граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ОбъектЭксплуатации", Объект.ОбъектЭксплуатации);
	Запрос.УстановитьПараметр("ПоОбмерамБТИ", Объект.ПоОбмерамБТИ);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	ОтборПоОбъектуНедвижимости = Ложь;
	ОбъектНедвижимости = Справочники.АУН_ОбъектыНедвижимости.ПустаяСсылка();
	
	Если Не ИдентификаторСтроки = Неопределено Тогда
		ОтборПоОбъектуНедвижимости = Истина;
		СтрокаТЧ = Объект.ОбъектыНедвижимости.НайтиПоИдентификатору(ИдентификаторСтроки);
		ОбъектНедвижимости = СтрокаТЧ.ОбъектНедвижимости;
		СтрокаТЧ.ТипНедвижимости = СтрокаТЧ.ОбъектНедвижимости.ТипНедвижимости;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ОбъектНедвижимости", ОбъектНедвижимости);
	Запрос.УстановитьПараметр("ОтборПоОбъекту", ОтборПоОбъектуНедвижимости);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если ОтборПоОбъектуНедвижимости Тогда
		Если Результат.Количество() = 0 Тогда
			СтрокаТЧ.ПлощадьСобственныхЖилыхПомещений		= 0;	
			СтрокаТЧ.ПлощадьСобственныхНежилыхПомещений		= 0;
			СтрокаТЧ.ПлощадьСобственныхМашиномест 			= 0;
			СтрокаТЧ.ПлощадьЖилыхПомещенийДДУ 				= 0;
			СтрокаТЧ.ПлощадьНежилыхПомещенийДДУ 			= 0;
			СтрокаТЧ.ПлощадьМашиноместДДУ 					= 0;
			СтрокаТЧ.ПлощадьЖилыхПомещенийИнвест 			= 0;
			СтрокаТЧ.ПлощадьНежилыхПомещенийИнвест 			= 0;
			СтрокаТЧ.ПлощадьМашиноместИнвест 				= 0;
		Иначе
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, Результат[0]);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если НЕ ТолькоДанныеПоПлощадям Тогда
		Объект.ОбъектыНедвижимости.Очистить();
		Объект.ОбъектыНедвижимости.Загрузить(Результат);
	Иначе
		Для Каждого СтрОН Из Объект.ОбъектыНедвижимости Цикл
			МассивДанных = Результат.НайтиСтроки(Новый структура("ОбъектНедвижимости", СтрОН.ОбъектНедвижимости));
			Если МассивДанных.Количество() = 0 Тогда
				СтрОН.ПлощадьСобственныхЖилыхПомещений		= 0;	
				СтрОН.ПлощадьСобственныхНежилыхПомещений	= 0;
				СтрОН.ПлощадьСобственныхМашиномест 			= 0;
				СтрОН.ПлощадьЖилыхПомещенийДДУ 				= 0;
				СтрОН.ПлощадьНежилыхПомещенийДДУ 			= 0;
				СтрОН.ПлощадьМашиноместДДУ 					= 0;
				СтрОН.ПлощадьЖилыхПомещенийИнвест 			= 0;
				СтрОН.ПлощадьНежилыхПомещенийИнвест 		= 0;
				СтрОН.ПлощадьМашиноместИнвест 				= 0;
			Иначе
				ЗаполнитьЗначенияСвойств(СтрОН, МассивДанных[0]);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ОбъектыНедвижимостиТЧ = ТекущийОбъект.ОбъектыНедвижимости.Выгрузить();
		ОбъектыНедвижимостиТЧ.Свернуть("ОбъектНедвижимости");
		Если Не ОбъектыНедвижимостиТЧ.Количество() = ТекущийОбъект.ОбъектыНедвижимости.Количество() Тогда
			
			ТекстОшибок = "";
			Для Каждого СтрПроверка Из ОбъектыНедвижимостиТЧ Цикл
				ТекстОшибки = "";
				НомераСтрок = "";
				МассивДанных = ТекущийОбъект.ОбъектыНедвижимости.НайтиСтроки(Новый структура( "ОбъектНедвижимости", СтрПроверка.ОбъектНедвижимости));
				Если МассивДанных.Количество()>1 Тогда
					ТекстОшибки = "Данные по объекту ";
					ТекстОшибки = ТекстОшибки + СтрПроверка.ОбъектНедвижимости + " задублированы в строках: "; 				
					Для Каждого СтрДубль Из МассивДанных Цикл
						Если НомераСтрок = "" Тогда
							НомераСтрок = НомераСтрок +  Строка(СтрДубль.номерСтроки);
						Иначе
							НомераСтрок = НомераСтрок + ", " + Строка(СтрДубль.номерСтроки);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				ТекстОшибок = ТекстОшибок + ТекстОшибки + НомераСтрок + Символы.ПС;
			КонецЦикла;
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СокрЛП(ТекстОшибок));
			Отказ = Истина;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТипыНедвижимости()
	
	Для Каждого СтрокаТЗ Из Объект.ОбъектыНедвижимости Цикл
		СтрокаТЗ.ТипНедвижимости = СтрокаТЗ.ОбъектНедвижимости.ТипНедвижимости;
	КонецЦикла;
	
КонецПроцедуры

