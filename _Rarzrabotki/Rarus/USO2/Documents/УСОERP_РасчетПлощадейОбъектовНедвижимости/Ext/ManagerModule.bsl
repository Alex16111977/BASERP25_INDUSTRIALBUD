#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстЗапросаТаблицаСводныеПлощади(Запрос, ТекстыЗапроса, Регистры);
	
	ПроведениеСерверУТ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеДокумента.Дата КАК Период,
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.ОбъектЭксплуатации КАК ОбъектЭксплуатации,
	|	ДанныеДокумента.ПоОбмерамБТИ КАК ПоОбмерамБТИ
	|ИЗ
	|	Документ.УСОERP_РасчетПлощадейОбъектовНедвижимости КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &Ссылка";
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	
	Запрос.УстановитьПараметр("Период", 			Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация", 		Реквизиты.Организация);
	Запрос.УстановитьПараметр("ОбъектЭксплуатации", Реквизиты.ОбъектЭксплуатации);
	Запрос.УстановитьПараметр("ПоОбмерамБТИ", 		Реквизиты.ПоОбмерамБТИ);
	
КонецПроцедуры

Функция ТекстЗапросаТаблицаСводныеПлощади(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "УСОERP_СводныеПлощадиПоОбъектуНедвижимости";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.Ссылка,
	|	УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.Ссылка.Дата КАК Период,
	|	УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.Ссылка.Организация,
	|	УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.Ссылка.ОбъектЭксплуатации,
	|	УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.Ссылка.ПоОбмерамБТИ,
	|	СУММА(УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.ПлощадьСобственныхЖилыхПомещений) КАК ПлощадьСобственныхЖилыхПомещений,
	|	СУММА(УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.ПлощадьСобственныхНежилыхПомещений) КАК ПлощадьСобственныхНежилыхПомещений,
	|	СУММА(УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.ПлощадьСобственныхМашиномест) КАК ПлощадьСобственныхМашиномест,
	|	СУММА(УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.ПлощадьЖилыхПомещенийДДУ) КАК ПлощадьЖилыхПомещенийДДУ,
	|	СУММА(УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.ПлощадьНежилыхПомещенийДДУ) КАК ПлощадьНежилыхПомещенийДДУ,
	|	СУММА(УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.ПлощадьМашиноместДДУ) КАК ПлощадьМашиноместДДУ,
	|	СУММА(УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.ПлощадьЖилыхПомещенийИнвест) КАК ПлощадьЖилыхПомещенийИнвест,
	|	СУММА(УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.ПлощадьНежилыхПомещенийИнвест) КАК ПлощадьНежилыхПомещенийИнвест,
	|	СУММА(УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.ПлощадьМашиноместИнвест) КАК ПлощадьМашиноместИнвест,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.Договор, ЗНАЧЕНИЕ(Документ.УПН_ДоговорПоНедвижимости.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Документ.УПН_ДоговорПоНедвижимости.ПустаяСсылка)
//	|					И &ДатаНачалаСтроительстваСоцИнфраструктуры <= УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.Договор.ДатаДоговора
	|				ТОГДА УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.ПлощадьЖилыхПомещенийДДУ
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ПлощадьЖилыхПомещенийДДУЗаСчетСредствДольщиков,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.Договор, ЗНАЧЕНИЕ(Документ.УПН_ДоговорПоНедвижимости.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Документ.УПН_ДоговорПоНедвижимости.ПустаяСсылка)
	//|					И &ДатаНачалаСтроительстваСоцИнфраструктуры <= УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.Договор.ДатаДоговора
	|				ТОГДА УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.ПлощадьЖилыхПомещенийИнвест
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ПлощадьЖилыхПомещенийИнвестЗаСчетСредствДольщиков
	|ИЗ
	|	Документ.УСОERP_РасчетПлощадейОбъектовНедвижимости.ОбъектыНедвижимости КАК УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости
	|ГДЕ
	|	УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.Ссылка,
	|	УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.Ссылка.Дата,
	|	УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.Ссылка.Организация,
	|	УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.Ссылка.ОбъектЭксплуатации,
	|	УСОERP_РасчетПлощадейОбъектовНедвижимостиОбъектыНедвижимости.Ссылка.ПоОбмерамБТИ" ;
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;
	
КонецФункции

