&НаСервере
Процедура ОбновитьПредставлениеСчетаСписанияНДС()
	
	Для Каждого СтрТЗ Из Объект.РаспределениеНДС Цикл
		СтрТЗ.ПредставлениеСписанияНДС1 = Строка(СтрТЗ.СчетСписанияНДС1) + Строка(?(ЗначениеЗаполнено(СтрТЗ.ДопАналитика1), ", " + Строка(СтрТЗ.ДопАналитика1), "")) + Строка(?(ЗначениеЗаполнено(СтрТЗ.ДопАналитикаЗатрат), ", " + Строка(СтрТЗ.ДопАналитикаЗатрат), ""));
		СтрТЗ.ПредставлениеСписанияНДС2 = Строка(СтрТЗ.СчетСписанияНДС2) + Строка(?(ЗначениеЗаполнено(СтрТЗ.ДопАналитика2), ", " + СтрТЗ.ДопАналитика2, ""));
		СтрТЗ.ПредставлениеСписанияНДС3 = Строка(СтрТЗ.СчетСписанияНДС3) + Строка(?(ЗначениеЗаполнено(СтрТЗ.ДопАналитика3), ", " + СтрТЗ.ДопАналитика3, ""));
	КонецЦикла;
		
