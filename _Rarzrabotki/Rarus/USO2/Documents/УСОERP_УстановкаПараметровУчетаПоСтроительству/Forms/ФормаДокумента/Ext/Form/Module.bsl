#Область ОбработчикиСобытийТаблицыРезервы

&НаКлиенте
Процедура РезервыСчетРезерваНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ФормаВыбора = ПолучитьФорму("ПланСчетов.Хозрасчетный.ФормаВыбора",, Элемент);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ФормаВыбора.Список, "Ссылка", ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.РезервыПредстоящихРасходов"), ВидСравненияКомпоновкиДанных.ВИерархии,, Истина);
	ФормаВыбора.Открыть();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыРаспределениеНДС

&НаКлиенте
Процедура РаспределениеНДСВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле = Элементы.РаспределениеНДСПредставлениеСписанияНДС1 
		ИЛИ Поле = Элементы.РаспределениеНДСПредставлениеСписанияНДС2
		ИЛИ Поле = Элементы.РаспределениеНДСПредставлениеСписанияНДС3 Тогда
		
		ТекущиеДанные = Элементы.РаспределениеНДС.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Индекс = СтрЗаменить( Поле.Имя, "РаспределениеНДСПредставлениеСписанияНДС", "");
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("СчетСписанияНДС", 		ТекущиеДанные["СчетСписанияНДС" + Строка(Индекс)]);
		ПараметрыФормы.Вставить("ДопАналитика", 		ТекущиеДанные["ДопАналитика" + Строка(Индекс)]);
		ПараметрыФормы.Вставить("ДопАналитикаЗатрат", 	ТекущиеДанные["ДопАналитикаЗатрат"]);
		ПараметрыФормы.Вставить("ИдентификаторСтроки", 	ТекущиеДанные.ПолучитьИдентификатор());
		ПараметрыФормы.Вставить("Индекс", 				Индекс);
		ПараметрыФормы.Вставить("СчетЗатрат", 			ТекущиеДанные.СчетЗатрат);
		
		ОткрытьФорму("Документ.УСОERP_УстановкаПараметровУчетаПоСтроительству.Форма.ФормаВыбораСчетаСписанияНДС", ПараметрыФормы, Элемент, ,,, Новый ОписаниеОповещения("ПредставлениеСписанияНДСВыборЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		СтандартнаяОбработка = Ложь;
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеСписанияНДСВыборЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатВыбора = Неопределено Тогда
		Индекс = РезультатВыбора.Индекс;
		ТекущиеДанные = Объект.РаспределениеНДС.НайтиПоИдентификатору(РезультатВыбора.ИдентификаторСтроки);
		ТекущиеДанные["СчетСписанияНДС" + Строка(Индекс)] = РезультатВыбора.СчетСписанияНДС;
		ТекущиеДанные["ДопАналитика" 	+ Строка(Индекс)] = РезультатВыбора.ДопАналитика;
		ТекущиеДанные["ДопАналитикаЗатрат"] = РезультатВыбора.ДопАналитикаЗатрат;
		ТекущиеДанные["ПредставлениеСписанияНДС" + Строка(Индекс)] = Строка(ТекущиеДанные["СчетСписанияНДС" + Строка(Индекс)]) 
																	+ Строка(?(ЗначениеЗаполнено(ТекущиеДанные["ДопАналитика" + Строка(Индекс)]), ", " + ТекущиеДанные["ДопАналитика" + Строка(Индекс)], ""))
																	+ Строка(?(ЗначениеЗаполнено(ТекущиеДанные["ДопАналитикаЗатрат"]), ", " + ТекущиеДанные["ДопАналитикаЗатрат"], ""));
	КонецЕсли;
	
КонецПроцедуры

