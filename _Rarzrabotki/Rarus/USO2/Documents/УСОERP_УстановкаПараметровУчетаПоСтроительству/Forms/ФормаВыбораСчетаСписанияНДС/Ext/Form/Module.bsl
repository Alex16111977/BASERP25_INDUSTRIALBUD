
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИдентификаторСтроки = Параметры.ИдентификаторСтроки;
	СчетСписанияНДС 	= Параметры.СчетСписанияНДС;
	ДопАналитика 		= Параметры.ДопАналитика;
	ДопАналитикаЗатрат	= Параметры.ДопАналитикаЗатрат;
	Индекс 				= Параметры.Индекс;
	СчетЗатрат 			= Параметры.СчетЗатрат;
		
	УстановитьДоступностьДопАналитики();
	
	УстановитьПараметрыВыбораСчета();
	
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("СчетСписанияНДС", 		СчетСписанияНДС);
	СтруктураВозврата.Вставить("ДопАналитика", 			ДопАналитика);
	СтруктураВозврата.Вставить("ДопАналитикаЗатрат",	ДопАналитикаЗатрат);
	СтруктураВозврата.Вставить("ИдентификаторСтроки", 	ИдентификаторСтроки);
	СтруктураВозврата.Вставить("Индекс", 				Индекс);
	
	Закрыть(СтруктураВозврата);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВыбораСчета()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ХозрасчетныйВидыСубконто.Ссылка
	|ИЗ
	|	ПланСчетов.Хозрасчетный.ВидыСубконто КАК ХозрасчетныйВидыСубконто
	|ГДЕ
	|	ХозрасчетныйВидыСубконто.ВидСубконто В(&ВидыСубконто)
	|	И ХозрасчетныйВидыСубконто.Ссылка В ИЕРАРХИИ(&СчетаСписания)
	|	И НЕ ХозрасчетныйВидыСубконто.Ссылка = &СчетЗатрат
	|
	|СГРУППИРОВАТЬ ПО
	|	ХозрасчетныйВидыСубконто.Ссылка";
	МассивСчетов = Новый Массив;
	МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.ВложенияВоВнеоборотныеАктивы);
	МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.Продажи);
	МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.ПрочиеДоходыИРасходы);
	
	МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.ОсновноеПроизводство);
    МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.ВспомогательныеПроизводства);
	МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.ОбщепроизводственныеРасходы);
	МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.ОбщехозяйственныеРасходы);
	//МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.ПрочиеДоходыИРасходы);
	//МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.ПрочиеДоходыИРасходы);
	
	Запрос.УстановитьПараметр("СчетаСписания", 	МассивСчетов);
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ОбъектыСтроительства);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.НоменклатурныеГруппы);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ПрочиеДоходыИРасходы);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.СтатьиЗатрат);
	
	Запрос.УстановитьПараметр("ВидыСубконто", 	ВидыСубконто);
	Запрос.УстановитьПараметр("СчетЗатрат", 	СчетЗатрат);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	МассивПараметров = Новый Массив;
	МассивСчетов = Новый Массив;
	Для Каждого СтрСчет Из Результат Цикл
		МассивСчетов.Добавить(СтрСчет.Ссылка);
	КонецЦикла;
	
	МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", Новый ФиксированныйМассив(МассивСчетов)));
	ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
	
	Элементы.СчетСписанияНДС.ПараметрыВыбора = ПараметрыВыбора;

КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьДопАналитики()
	
	Элементы.ДопАналитика.Доступность = ЗначениеЗаполнено(СчетСписанияНДС);
	Если НЕ ЗначениеЗаполнено(СчетСписанияНДС) Тогда
		ДопАналитика 		= Неопределено;
		ДопАналитикаЗатрат 	= Неопределено;
	иначе
		Если НЕ ЗначениеЗаполнено(ДопАналитика) тогда
			Если СчетСписанияНДС.ПринадлежитЭлементу(ПланыСчетов.Хозрасчетный.ВложенияВоВнеоборотныеАктивы)
				ИЛИ СчетСписанияНДС = ПланыСчетов.Хозрасчетный.ВложенияВоВнеоборотныеАктивы 
				ИЛИ СчетСписанияНДС.ПринадлежитЭлементу(ПланыСчетов.Хозрасчетный.ПрочиеДоходыИРасходы)
				ИЛИ СчетСписанияНДС = ПланыСчетов.Хозрасчетный.ПрочиеДоходыИРасходы тогда
				ДопАналитика = ПланыВидовХарактеристик.СтатьиРасходов.ПустаяСсылка();
			ИначеЕсли СчетСписанияНДС.ПринадлежитЭлементу(ПланыСчетов.Хозрасчетный.Продажи)
				ИЛИ СчетСписанияНДС = ПланыСчетов.Хозрасчетный.Продажи Тогда
				ДопАналитика = Справочники.ГруппыФинансовогоУчетаНоменклатуры.ПустаяСсылка();
			Иначе
				ДопАналитика = ПланыВидовХарактеристик.СтатьиРасходов.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ДопАналитика.Заголовок = ?(ДопАналитика = Неопределено,"", Строка(ТипЗнч(ДопАналитика)));
	
	Если Индекс = "1" Тогда
		
		Элементы.СчетСписанияНДС.Заголовок 		= "Счет списания НДС и затрат";
		Элементы.ДопАналитика.Заголовок 		= "Статья расходов по НДС";
		Элементы.ДопАналитикаЗатрат.Заголовок 	= "Статья расходов по затратам";
		
		Элементы.ДопАналитикаЗатрат.Видимость	= Истина;
		Если Не ЗначениеЗаполнено(ДопАналитикаЗатрат) Тогда
			ДопАналитикаЗатрат = ПланыВидовХарактеристик.СтатьиРасходов.ПустаяСсылка();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетСписанияНДСПриИзменении(Элемент)
	УстановитьДоступностьДопАналитики();
КонецПроцедуры
