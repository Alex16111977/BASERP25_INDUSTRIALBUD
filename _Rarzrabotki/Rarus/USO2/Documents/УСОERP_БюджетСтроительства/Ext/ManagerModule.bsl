Функция ВТ_ТекстЗапросаФинансирование()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_БюджетСтроительстваФинансирование.Ссылка.Дата КАК Период,
	|	УСОERP_БюджетСтроительстваФинансирование.Ссылка КАК Регистратор,
	|	УСОERP_БюджетСтроительстваФинансирование.Ссылка.Организация,
	|	УСОERP_БюджетСтроительстваФинансирование.Ссылка.ОбъектСтроительства,
	|	УСОERP_БюджетСтроительстваФинансирование.Работа,
	|	ВЫБОР
	|		КОГДА УСОERP_БюджетСтроительстваФинансирование.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаясСылка)
	|			ТОГДА УСОERP_БюджетСтроительстваФинансирование.Контрагент
	|		ИНАЧЕ УСОERP_БюджетСтроительстваФинансирование.Подразделение
