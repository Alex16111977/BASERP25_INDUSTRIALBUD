
&НаКлиенте
Процедура ТаблицаСметПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСметПриИзменении(Элемент)
	
	Сч = 1;
	
	Для Каждого СтрокаТЗ ИЗ ТаблицаСмет Цикл
		СтрокаТЗ.Приоритет = Сч;
		Сч = Сч+1;		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРассчитать(Команда)
	
	ОповеститьОВыборе(ТаблицаСмет);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбъектСтроительства = Параметры.ОбъектСтроительства;
	
	Если НЕ ЗначениеЗАполнено(ОбъектСтроительства) Тогда
		Отказ = Истина;
	КонецЕсли;
	
	ЗаполнитьТаблицуСмет();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСмет()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбъектСтроительства",ОбъектСтроительства);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СМ_ЛокальнаяСмета.Ссылка КАК Смета,
	|	ИСТИНА КАК Отбор
	|ИЗ
	|	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	|ГДЕ
	|	СМ_ЛокальнаяСмета.Стройка = &ОбъектСтроительства
	|	И НЕ СМ_ЛокальнаяСмета.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	СМ_ЛокальнаяСмета.Дата УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТаблицаСмет.Очистить();
	
	Сч = 1;
	
	Пока Выборка.Следующий() Цикл
		
		Нстр = ТаблицаСмет.Добавить();
		Нстр.Приоритет = Сч;
		ЗаполнитьЗначенияСвойств(Нстр,Выборка);
		Сч = Сч+1;
		
	КонецЦикла; 	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновить(Команда)
	ЗаполнитьТаблицуСмет();
КонецПроцедуры

