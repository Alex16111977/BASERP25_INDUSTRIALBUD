			ТаблицаРесурсовРаботы = ТЗ_Ресурсы.Скопировать(Новый Структура("Работа", СтрокаРабота.Работа));
			
			Для Каждого СтрокаРесурс Из ТаблицаРесурсовРаботы Цикл
				
