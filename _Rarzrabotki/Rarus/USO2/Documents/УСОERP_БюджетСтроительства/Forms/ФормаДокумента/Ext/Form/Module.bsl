&НаКлиенте
Процедура ДобавитьДатуАктирования(Команда)
	
	ТекущиеДанные = Элементы.ДеревоАктирование.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Добавить новую дату актирования можно только для выделенной строки с работой'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			ТекстОшибки,
			Объект.Ссылка,
			"ДеревоАктирование",
			,
			);
		 Возврат;
		 
	 ИначеЕсли ТекущиеДанные.ГруппировкаПоИсполнителям Тогда
		 
		 ТекстОшибки = НСтр("ru='Добавить новую дату актирования можно только для выделенной строки с работой'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			ТекстОшибки,
			Объект.Ссылка,
			"ДеревоАктирование",
			,
			);
			
		Возврат;	
		
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтоРабота Тогда
		СтрокаРабота = ТекущиеДанные;
	Иначе
		СтрокаРабота = ТекущиеДанные.ПолучитьРодителя();
	КонецЕсли;
	
	НоваяСтрока = СтрокаРабота.ПолучитьЭлементы().Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРабота,, "ЭтоРабота, ДатаАктирования, ПроцентАктирования, СтоимостьВнешняя");	
	Элементы.ДеревоАктирование.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	Элементы.ДеревоАктирование.ТекущийЭлемент = Элементы.ДеревоАктированиеДатаАктирования;
	
	Модифицированность = Истина;
	
КонецПроцедуры

