&НаСервере
Процедура РассчитатьФинансированиеПоРаботам(СтрокиДерева, ДанныеПоГрафикамДоговоров)  	
	
	Для Каждого СтрокаРабота Из СтрокиДерева Цикл
		
		Если СтрокаРабота.ЭтоРабота Тогда
			
			Если НЕ СтрокаРАбота.ЗаключенДоговор Тогда 
				
				ВыполнитьРасчетПоГрафикуФинансирования(СтрокаРАбота.ПолучитьИдентификатор()); //СтруктураДанныхДляРасчета);
				
			Иначе 				
				МассивСтрок = ДанныеПоГрафикамДоговоров.НайтиСтроки(Новый Структура("Контрагент, Работа", СтрокаРабота.Контрагент, СтрокаРабота.Работа));
				Если МассивСтрок.Количество()>0 Тогда
					ЗаполнитьЗначенияСвойств(СтрокаРабота, МассивСтрок[0], , "Контрагент, Работа");
				Иначе
					ВыполнитьРасчетПоГрафикуФинансирования(СтрокаРабота.ПолучитьИдентификатор()); //СтруктураДанныхДляРасчета); 					
				КонецЕсли;				
			КонецЕсли;
			
		КонецЕсли;
		
		РассчитатьФинансированиеПоРаботам(СтрокаРабота.ПолучитьЭлементы(), ДанныеПоГрафикамДоговоров);
		
	КонецЦикла; 	
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьРасчетПоГрафикуФинансирования(ИдентификаторСтроки = Неопределено, СтрокаДереваЗначений = Неопределено)
	
	Если ИдентификаторСтроки = Неопределено
		И СтрокаДереваЗначений = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторСтроки <> Неопределено тогда
		ТекущаяСтрока = ДеревоФинансирование.НайтиПоИдентификатору(ИдентификаторСтроки);
		ТекущаяСтрока.ПолучитьЭлементы().Очистить();
	Иначе
		ТекущаяСтрока = СтрокаДереваЗначений;
	КонецЕсли;
  
	ТекущаяСтрока.ДатаАванс 						= Дата("00010101");
	ТекущаяСтрока.СуммаАванс 						= 0;
	ТекущаяСтрока.ДатаОстатокПлатежа				= Дата("00010101");
	ТекущаяСтрока.СуммаОстатокПлатежа 				= 0;
	ТекущаяСтрока.ДатаВозвратГарантийногоУдержания 	= Дата("00010101");
	ТекущаяСтрока.СуммаВозвратГарантийногоУдержания = 0;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ГрафикФинансирования) Тогда
		
		КалендарьОплаты = ТекущаяСтрока.ГрафикФинансирования.Календарь;
		
		мДеревоАктирования = РеквизитФормыВЗначение("ДеревоАктирование");
		СтрокиАктирования = мДеревоАктирования.Строки.НайтиСтроки(Новый Структура("Работа, ЭтоРабота", ТекущаяСтрока.Работа, Ложь), Истина);
		ЕстьСтрокиАктирования = (СтрокиАктирования.Количество()>0);
		
		ЭтапыОплаты = ТекущаяСтрока.ГрафикФинансирования.Этапы;
		Для Каждого СтрокаЭтапОплаты Из ЭтапыОплаты Цикл
			МассивДней = Новый Массив;
			МассивДней.Добавить(СтрокаЭтапОплаты.Сдвиг);

			Сдвиг = СтрокаЭтапОплаты.Сдвиг;
			Если СтрокаЭтапОплаты.ВариантОплаты = Перечисления.ВариантыОплатыПоставщику.АвансДоПодтверждения Тогда
				
				НоваяДата = текущаяСтрока.НачалоРаботыПлан - СтрокаЭтапОплаты.Сдвиг*24*60*60;
				Если ЗначениеЗаполнено(КалендарьОплаты) Тогда
					МассивДатПоКалендарю = КалендарныеГрафики.ПолучитьМассивДатПоКалендарю(КалендарьОплаты, НоваяДата, МассивДней);
					Если НЕ МассивДатПоКалендарю = Неопределено Тогда
						НоваяДата = МассивДатПоКалендарю[0];
					КонецЕсли; 
				КонецЕсли; 			
				ТекущаяСтрока.ДатаАванс = НоваяДата;
				
				ТекущаяСтрока.ВидДДС_Аванс = СтрокаЭтапОплаты.ВариантОплаты;
				ТекущаяСтрока.СуммаАванс = Окр(ТекущаяСтрока.СтоимостьВнешняя * СтрокаЭтапОплаты.ПроцентПлатежа/100,2);
				
			ИначеЕсли  СтрокаЭтапОплаты.ВариантОплаты = Перечисления.ВариантыОплатыПоставщику.УСОERP_ГарантийноеУдержание Тогда
				
				Если ЕстьСтрокиАктирования Тогда
					
					КоличествоСтрокАктирование = СтрокиАктирования.Количество();
					Счетчик = 0;
					ПерваяСтрока = Истина;
					Для Каждого СтрокаАктирование Из СтрокиАктирования Цикл
						Если ПерваяСтрока Тогда
							
							НоваяДата = СтрокаАктирование.ДатаАктирования + СтрокаЭтапОплаты.Сдвиг*24*60*60;
							Если ЗначениеЗаполнено(КалендарьОплаты) Тогда
								МассивДатПоКалендарю = КалендарныеГрафики.ПолучитьМассивДатПоКалендарю(КалендарьОплаты, НоваяДата, МассивДней);
								Если НЕ МассивДатПоКалендарю = Неопределено Тогда
									НоваяДата = МассивДатПоКалендарю[0];
								КонецЕсли; 
							КонецЕсли; 				
							ТекущаяСтрока.ДатаВозвратГарантийногоУдержания = НоваяДата;
							
							ТекущаяСтрока.ВидДДС_ВозвратГарантийногоУдержания = СтрокаЭтапОплаты.ВариантОплаты;
							ТекущаяСтрока.СуммаВозвратГарантийногоУдержания = Окр(Окр(ТекущаяСтрока.СтоимостьВнешняя * СтрокаЭтапОплаты.ПроцентПлатежа/100,2) * СтрокаАктирование.ПроцентАктирования /100,2);
							

							ПерваяСтрока = Ложь;
							Продолжить;
						КонецЕсли;
						
						Если Не ИдентификаторСтроки = Неопределено Тогда
							Если ТекущаяСтрока.ПолучитьЭлементы().Количество() + 1 <> КоличествоСтрокАктирование Тогда
								НоваяСтрока = ТекущаяСтрока.ПолучитьЭлементы().Добавить();
								ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока,, "ДатаАванс, ВидДДС_Аванс, СуммаАванс,
																				|ДатаВозвратГарантийногоУдержания, ВидДДС_ВозвратГарантийногоУдержания,  СуммаВозвратГарантийногоУдержания,
																			    |ДатаОстатокПлатежа, ВидДДС_ОстатокПлатежа,  СуммаОстатокПлатежа, ЭтоРабота");
								
								
							Иначе
								НоваяСтрока = ТекущаяСтрока.ПолучитьЭлементы()[Счетчик];
							КонецЕсли;
						Иначе
							Если ТекущаяСтрока.Строки.Количество() + 1 <> КоличествоСтрокАктирование Тогда
								НоваяСтрока = ТекущаяСтрока.Строки.Добавить();
								ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока,, "ДатаАванс, ВидДДС_Аванс, СуммаАванс,
																				|ДатаВозвратГарантийногоУдержания, ВидДДС_ВозвратГарантийногоУдержания,  СуммаВозвратГарантийногоУдержания,
																			    |ДатаОстатокПлатежа, ВидДДС_ОстатокПлатежа,  СуммаОстатокПлатежа, ЭтоРабота");
								
								
							Иначе
								НоваяСтрока = ТекущаяСтрока.Строки[Счетчик];
							КонецЕсли;
						КонецЕсли;
					
						НоваяДата = СтрокаАктирование.ДатаАктирования + СтрокаЭтапОплаты.Сдвиг*24*60*60;
						Если ЗначениеЗаполнено(КалендарьОплаты) Тогда
							МассивДатПоКалендарю = КалендарныеГрафики.ПолучитьМассивДатПоКалендарю(КалендарьОплаты, НоваяДата, МассивДней);
							Если НЕ МассивДатПоКалендарю = Неопределено Тогда
								НоваяДата = МассивДатПоКалендарю[0];
							КонецЕсли; 
						КонецЕсли; 				
						НоваяСтрока.ДатаВозвратГарантийногоУдержания = НоваяДата;
						
						НоваяСтрока.ВидДДС_ВозвратГарантийногоУдержания = СтрокаЭтапОплаты.ВариантОплаты;
						НоваяСтрока.СуммаВозвратГарантийногоУдержания = Окр(Окр(ТекущаяСтрока.СтоимостьВнешняя * СтрокаЭтапОплаты.ПроцентПлатежа/100,2) * СтрокаАктирование.ПроцентАктирования /100,2);
						
						Счетчик = Счетчик + 1;									
					КонецЦикла;
					
				Иначе
					НоваяДата = ТекущаяСтрока.ОкончаниеРаботыПлан + СтрокаЭтапОплаты.Сдвиг*24*60*60;
					Если ЗначениеЗаполнено(КалендарьОплаты) Тогда
						МассивДатПоКалендарю = КалендарныеГрафики.ПолучитьМассивДатПоКалендарю(КалендарьОплаты, НоваяДата, МассивДней);
						Если НЕ МассивДатПоКалендарю = Неопределено Тогда
							НоваяДата = МассивДатПоКалендарю[0];
						КонецЕсли; 
					КонецЕсли; 				
					ТекущаяСтрока.ДатаВозвратГарантийногоУдержания = НоваяДата;
					
					ТекущаяСтрока.ВидДДС_ВозвратГарантийногоУдержания = СтрокаЭтапОплаты.ВариантОплаты;
					ТекущаяСтрока.СуммаВозвратГарантийногоУдержания = ТекущаяСтрока.СуммаВозвратГарантийногоУдержания + Окр(ТекущаяСтрока.СтоимостьВнешняя * СтрокаЭтапОплаты.ПроцентПлатежа/100,2);
					
				КонецЕсли; 				
				
			Иначе
				
				Если ЕстьСтрокиАктирования Тогда
					
					КоличествоСтрокАктирование = СтрокиАктирования.Количество();
					Счетчик = 0;
					ПерваяСтрока = Истина;
					Для Каждого СтрокаАктирование Из СтрокиАктирования Цикл
						Если ПерваяСтрока Тогда
							
							НоваяДата = СтрокаАктирование.ДатаАктирования + СтрокаЭтапОплаты.Сдвиг*24*60*60;
							Если ЗначениеЗаполнено(КалендарьОплаты) Тогда
								МассивДатПоКалендарю = КалендарныеГрафики.ПолучитьМассивДатПоКалендарю(КалендарьОплаты, НоваяДата, МассивДней);
								Если НЕ МассивДатПоКалендарю = Неопределено Тогда
									НоваяДата = МассивДатПоКалендарю[0];
								КонецЕсли; 
							КонецЕсли; 				
							ТекущаяСтрока.ДатаОстатокПлатежа = НоваяДата;
							
							ТекущаяСтрока.ВидДДС_ОстатокПлатежа = СтрокаЭтапОплаты.ВариантОплаты;
							ТекущаяСтрока.СуммаОстатокПлатежа = Окр(Окр(ТекущаяСтрока.СтоимостьВнешняя * СтрокаЭтапОплаты.ПроцентПлатежа/100,2) * СтрокаАктирование.ПроцентАктирования/100, 2) ;
							
							
							ПерваяСтрока = Ложь;
							Продолжить;
						КонецЕсли;
						
						Если Не ИдентификаторСтроки = Неопределено Тогда
							Если ТекущаяСтрока.ПолучитьЭлементы().Количество() + 1 <> КоличествоСтрокАктирование Тогда
								НоваяСтрока = ТекущаяСтрока.ПолучитьЭлементы().Добавить();
								ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока,, "ДатаАванс, ВидДДС_Аванс, СуммаАванс,
																					|ДатаВозвратГарантийногоУдержания, ВидДДС_ВозвратГарантийногоУдержания,  СуммаВозвратГарантийногоУдержания,
																					|ДатаОстатокПлатежа, ВидДДС_ОстатокПлатежа,  СуммаОстатокПлатежа, ЭтоРабота");
								
								
							Иначе
								НоваяСтрока = ТекущаяСтрока.ПолучитьЭлементы()[Счетчик];
							КонецЕсли;
						Иначе
							Если ТекущаяСтрока.Строки.Количество() + 1 <> КоличествоСтрокАктирование Тогда
								НоваяСтрока = ТекущаяСтрока.Строки.Добавить();
								ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока,, "ДатаАванс, ВидДДС_Аванс, СуммаАванс,
																					|ДатаВозвратГарантийногоУдержания, ВидДДС_ВозвратГарантийногоУдержания,  СуммаВозвратГарантийногоУдержания,
																					|ДатаОстатокПлатежа, ВидДДС_ОстатокПлатежа,  СуммаОстатокПлатежа, ЭтоРабота");
								
								
							Иначе
								НоваяСтрока = ТекущаяСтрока.Строки[Счетчик];
							КонецЕсли;
						КонецЕсли;
						
						
						НоваяДата = СтрокаАктирование.ДатаАктирования + СтрокаЭтапОплаты.Сдвиг*24*60*60;
						Если ЗначениеЗаполнено(КалендарьОплаты) Тогда
							МассивДатПоКалендарю = КалендарныеГрафики.ПолучитьМассивДатПоКалендарю(КалендарьОплаты, НоваяДата, МассивДней);
							Если НЕ МассивДатПоКалендарю = Неопределено Тогда
								НоваяДата = МассивДатПоКалендарю[0];
							КонецЕсли; 
						КонецЕсли; 				
						НоваяСтрока.ДатаОстатокПлатежа = НоваяДата;
						
						НоваяСтрока.ВидДДС_ОстатокПлатежа = СтрокаЭтапОплаты.ВариантОплаты;
						НоваяСтрока.СуммаОстатокПлатежа =  Окр(Окр(НоваяСтрока.СтоимостьВнешняя * СтрокаЭтапОплаты.ПроцентПлатежа/100,2)* СтрокаАктирование.ПроцентАктирования/100, 2);
						
						Счетчик = Счетчик + 1;
					КонецЦикла;
					
				Иначе
					
					НоваяДата = ТекущаяСтрока.ОкончаниеРаботыПлан + СтрокаЭтапОплаты.Сдвиг*24*60*60;
					Если ЗначениеЗаполнено(КалендарьОплаты) Тогда
						МассивДатПоКалендарю = КалендарныеГрафики.ПолучитьМассивДатПоКалендарю(КалендарьОплаты, НоваяДата, МассивДней);
						Если НЕ МассивДатПоКалендарю = Неопределено Тогда
							НоваяДата = МассивДатПоКалендарю[0];
						КонецЕсли; 
					КонецЕсли; 				
					ТекущаяСтрока.ДатаОстатокПлатежа = НоваяДата;
					
					ТекущаяСтрока.ВидДДС_ОстатокПлатежа = СтрокаЭтапОплаты.ВариантОплаты;
					ТекущаяСтрока.СуммаОстатокПлатежа = ТекущаяСтрока.СуммаОстатокПлатежа + Окр(ТекущаяСтрока.СтоимостьВнешняя * СтрокаЭтапОплаты.ПроцентПлатежа/100,2);
				КонецЕсли;
			
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоФинансированияПриСоздании()
	
	
	Если Объект.Финансирование.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	мДеревоФинансирование = РеквизитФормыВЗначение("ДеревоФинансирование");
	мДеревоФинансирование.Строки.Очистить();

	ДанныеДляДерева = Новый ТаблицаЗначений;
	ТипыЗначений = Новый Массив; 
    ТипыЗначений.Добавить(Тип("Строка")); 
    ТипыЗначений.Добавить(Тип("СправочникСсылка.Контрагенты")); 
    ТипыЗначений.Добавить(Тип("СправочникСсылка.УСОERP_СтроительныеРаботы"));
    ТипыЗначений.Добавить(Тип("СправочникСсылка.СтруктураПредприятия"));
    ТипыЗначений.Добавить(Тип("СправочникСсылка.ПодразделенияОрганизаций"));
    ТипыЗначений.Добавить(Тип("СправочникСсылка.СтатьиБюджетов"));
	
	ДанныеДляДерева.Колонки.Добавить("ВыражениеИсточник",      Новый ОписаниеТипов(ТипыЗначений));		
	ДанныеДляДерева.Колонки.Добавить("ВыражениеПриемник",      Новый ОписаниеТипов(ТипыЗначений));		
	ДанныеДляДерева.Колонки.Добавить("КодСДР",                 Новый ОписаниеТипов("Строка"));		
	ДанныеДляДерева.Колонки.Добавить("НомерРаботыВУровне",     Новый ОписаниеТипов("Число"));		

	Для каждого Колонка Из мДеревоФинансирование.Колонки Цикл
		Если ДанныеДляДерева.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			ДанныеДляДерева.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
		КонецЕсли; 
	КонецЦикла; 		
	
	СтрокаДереваКонтрагенты = ДанныеДляДерева.Добавить();
	СтрокаДереваКонтрагенты.ИсполнительРабота = "Подрядчики";
	СтрокаДереваКонтрагенты.ВыражениеИсточник = "Подрядчики";
	СтрокаДереваКонтрагенты.ВыражениеПриемник = "";
	СтрокаДереваКонтрагенты.ВыделятьКурсивом = Истина;
	
	ТаблицаДокумента = Объект.Финансирование.Выгрузить();
	ТаблицаКонтрагентов = ТаблицаДокумента.Скопировать();
	ТаблицаКонтрагентов.Свернуть("Контрагент");
	
	Для Каждого СтрокаКонтрагент Из ТаблицаКонтрагентов Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаКонтрагент.Контрагент) Тогда
			продолжить;
		КонецЕсли;
		
		РаботыТекущегоКонтрагента = ТаблицаДокумента.Скопировать(Новый Структура("Контрагент", СтрокаКонтрагент.Контрагент));
		Если РаботыТекущегоКонтрагента.Количество()= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаКонтрагент = ДанныеДляДерева.Добавить();
		НоваяСтрокаКонтрагент.Контрагент = СтрокаКонтрагент.Контрагент;
		НоваяСтрокаКонтрагент.ИсполнительРабота = СтрокаКонтрагент.Контрагент;
		НоваяСтрокаКонтрагент.ГруппировкаПоИсполнителям = Истина;
		НоваяСтрокаКонтрагент.ВыражениеИсточник = НоваяСтрокаКонтрагент.ИсполнительРабота;
		НоваяСтрокаКонтрагент.ВыражениеПриемник = СтрокаДереваКонтрагенты.ВыражениеИсточник;
			
		ТЗ_Работы = РаботыТекущегоКонтрагента.Скопировать();
		ТЗ_Работы.Свернуть("Работа");
		
		Для Каждого СтрокаРабота Из ТЗ_Работы Цикл
			
			ДанныеПоРаботе = РаботыТекущегоКонтрагента.НайтиСтроки(Новый Структура("Работа", СтрокаРабота.Работа));
			
			КоличествоДанных = ДанныеПоРаботе.Количество();
			НоваяСтрокаГруппировкаРаботы = Неопределено;
			Для к = 1 По КоличествоДанных Цикл
				Если к = 1 Тогда
					НоваяСтрокаРабота = ДанныеДляДерева.Добавить();
					ЗаполнитьЗначенияСвойств( НоваяСтрокаРабота, ДанныеПоРаботе[к-1]);
					НоваяСтрокаРабота.ИсполнительРабота = ДанныеПоРаботе[к-1].Работа;
					НоваяСтрокаРабота.ЭтоРабота = Истина;
					НоваяСтрокаРабота.ВыражениеИсточник = НоваяСтрокаРабота.ИсполнительРабота;
					НоваяСтрокаРабота.ВыражениеПриемник = НоваяСтрокаКонтрагент.ВыражениеИсточник;
					НоваяСтрокаГруппировкаРаботы = НоваяСтрокаРабота;
					
				Иначе
					НоваяСтрокаРабота = ДанныеДляДерева.Добавить();
					ЗаполнитьЗначенияСвойств( НоваяСтрокаРабота, ДанныеПоРаботе[к-1]);
					НоваяСтрокаРабота.ИсполнительРабота = ДанныеПоРаботе[к-1].Работа;
					НоваяСтрокаРабота.ВыражениеИсточник = НоваяСтрокаРабота.ИсполнительРабота;
					НоваяСтрокаРабота.ВыражениеПриемник = НоваяСтрокаКонтрагент.ВыражениеИсточник;
					НоваяСтрокаРабота.ЭтоРабота = Ложь;
				Конецесли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	СтрокаДереваПодразделения = ДанныеДляДерева.Добавить();
	СтрокаДереваПодразделения.ИсполнительРабота = "Подразделения";
	СтрокаДереваПодразделения.ВыражениеИсточник = "Подразделения";
	СтрокаДереваПодразделения.ВыражениеПриемник = "";
	СтрокаДереваПодразделения.ВыделятьКурсивом = Истина;

	ТаблицаПодразделений = ТаблицаДокумента.Скопировать();
	ТаблицаПодразделений.Свернуть("Подразделение");
	
	Для Каждого СтрокаПодразделение Из ТаблицаПодразделений Цикл
		РаботыТекущегоПодразделения = ТаблицаДокумента.Скопировать(Новый Структура("Подразделение", СтрокаПодразделение.Подразделение));
		Если РаботыТекущегоПодразделения.Количество()= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаПодразделение = ДанныеДляДерева.Добавить();
		НоваяСтрокаПодразделение.Подразделение = СтрокаПодразделение.Подразделение;
		НоваяСтрокаПодразделение.ИсполнительРабота = СтрокаПодразделение.Подразделение;
		НоваяСтрокаПодразделение.ГруппировкаПоИсполнителям = Истина;
		НоваяСтрокаПодразделение.ВыражениеИсточник = НоваяСтрокаПодразделение.ИсполнительРабота;
		НоваяСтрокаПодразделение.ВыражениеПриемник = СтрокаДереваПодразделения.ВыражениеИсточник;
		
		Для Каждого СтрокаРабота Из РаботыТекущегоПодразделения Цикл
			Если ЗначениеЗаполнено(СтрокаРабота.Контрагент) Тогда
				Продолжить;
			КонецЕсли;
			 
			НоваяСтрокаРабота = ДанныеДляДерева.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРабота, СтрокаРабота);
			НоваяСтрокаРабота.ИсполнительРабота = СтрокаРабота.Работа;
			НоваяСтрокаРабота.ВыражениеИсточник = НоваяСтрокаРабота.ИсполнительРабота;
			НоваяСтрокаРабота.ВыражениеПриемник = НоваяСтрокаПодразделение.ВыражениеИсточник;
			НоваяСтрокаРабота.ЭтоРабота = Истина;
			 			
		КонецЦикла;
	КонецЦикла;

	ВыражениеИсточник = "ВыражениеИсточник";
	ВыражениеПриемник = "ВыражениеПриемник";
	ДеревоРезультат = УСОERP_ОбработкаТабличныхЧастей.УСОERP_СформироватьДеревоУниверсальная(ДанныеДляДерева, ВыражениеИсточник, ВыражениеПриемник, "");

	Для каждого СтрокаДереваПодразделения Из ДеревоРезультат.Строки Цикл
		Для каждого НоваяСтрокаПодразделение  Из СтрокаДереваПодразделения.Строки Цикл
			НоваяСтрокаПодразделение.СтоимостьРаботы 					= НоваяСтрокаПодразделение.Строки.Итог("СтоимостьРаботы");
			НоваяСтрокаПодразделение.СтоимостьВнешняя 				 	= НоваяСтрокаПодразделение.Строки.Итог("СтоимостьВнешняя");
			НоваяСтрокаПодразделение.СуммаАванс 						= НоваяСтрокаПодразделение.Строки.Итог("СуммаАванс");
			НоваяСтрокаПодразделение.СуммаОстатокПлатежа 				= НоваяСтрокаПодразделение.Строки.Итог("СуммаОстатокПлатежа");
			НоваяСтрокаПодразделение.СуммаВозвратГарантийногоУдержания  = НоваяСтрокаПодразделение.Строки.Итог("СуммаВозвратГарантийногоУдержания");
		КонецЦикла; 	
		СтрокаДереваПодразделения.СтоимостьРаботы 				  	= СтрокаДереваПодразделения.Строки.Итог("СтоимостьРаботы");
		СтрокаДереваПодразделения.СтоимостьВнешняя 				  	= СтрокаДереваПодразделения.Строки.Итог("СтоимостьВнешняя");
		СтрокаДереваПодразделения.СуммаАванс 						= СтрокаДереваПодразделения.Строки.Итог("СуммаАванс");
		СтрокаДереваПодразделения.СуммаОстатокПлатежа 			  	= СтрокаДереваПодразделения.Строки.Итог("СуммаОстатокПлатежа");
		СтрокаДереваПодразделения.СуммаВозвратГарантийногоУдержания = СтрокаДереваПодразделения.Строки.Итог("СуммаВозвратГарантийногоУдержания");
	КонецЦикла; 													

	УСОERP_ОбработкаТабличныхЧастей.УСОERP_ЗаполнитьРоднуюСтруктуруДереваИзВнешнего(мДеревоФинансирование.Строки, ДеревоРезультат.Строки); // и рекурсивно заполняется из дерева, где, возможн, типиация создаст проблемы
	ЗначениеВРеквизитФормы(мДеревоФинансирование, "ДеревоФинансирование");
	мДеревоФинансирование.Строки.Очистить(); // уборка за собой
	
КонецПроцедуры

&НаСервере
Процедура СохранитьФинансирование(ТекущийОбъект)
	
	Финансирование =  ТекущийОбъект.Финансирование;
	Финансирование.Очистить();
	
	мДеревоФинансирование = РеквизитФормыВЗначение("ДеревоФинансирование");
	СохранитьСтрокиФинансирования(мДеревоФинансирование.Строки, Финансирование);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьСтрокиФинансирования(СтрокиДерева, Финансирование)
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если СтрокаДерева.ЭтоРабота Тогда
			НоваяСтрока = Финансирование.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);
		ИначеЕсли НЕ СтрокаДерева.ЭтоРабота
			И НЕ СтрокаДерева.ВыделятьКурсивом
			И НЕ СтрокаДерева.ГруппировкаПоИсполнителям Тогда
			//И НЕ СтрокаДерева.ЭтоСтатьяБюджета
			НоваяСтрока = Финансирование.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);
		КонецЕсли;
		СохранитьСтрокиФинансирования(СтрокаДерева.Строки, Финансирование);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьФинансированиеНаСервере()   	
   	
	мГрафикиДвиженийПоДоговорам = РассчитатьФинансированиеПоДоговорамСубподряда();
	
	РассчитатьФинансированиеПоРаботам(ДеревоФинансирование.ПолучитьЭлементы(), мГрафикиДвиженийПоДоговорам);
	 	
	СоответствиеИтогов = Новый Соответствие;
	мДеревоФинансирование = РеквизитФормыВЗначение("ДеревоФинансирование");
	
	Для Каждого СтрокаГруппировка Из мДеревоФинансирование.Строки Цикл
		
		Для Каждого СтрокаИсполнитель Из СтрокаГруппировка.Строки Цикл
			
			СтрокаИсполнитель.СтоимостьРаботы 					= СтрокаИсполнитель.Строки.Итог("СтоимостьРаботы");
			СтрокаИсполнитель.СтоимостьВнешняя 				 	= СтрокаИсполнитель.Строки.Итог("СтоимостьВнешняя");
			СтрокаИсполнитель.СуммаАванс 						= СтрокаИсполнитель.Строки.Итог("СуммаАванс");
			
			СтрокаИсполнитель.СуммаОстатокПлатежа 				= СтрокаИсполнитель.Строки.Итог("СуммаОстатокПлатежа");
			СтрокаИсполнитель.СуммаВозвратГарантийногоУдержания = СтрокаИсполнитель.Строки.Итог("СуммаВозвратГарантийногоУдержания");

			ДопСтрокиРабот = СтрокаИсполнитель.Строки.НайтиСтроки(Новый Структура("ЭтоРабота", Ложь), Истина);
			
			Если ДопСтрокиРабот.Количество() > 0 Тогда
				Для Каждого СтрокаРабота Из ДопСтрокиРабот Цикл
					СтрокаИсполнитель.СуммаОстатокПлатежа = СтрокаИсполнитель.СуммаОстатокПлатежа + СтрокаРабота.СуммаОстатокПлатежа;
					СтрокаИсполнитель.СуммаВозвратГарантийногоУдержания = СтрокаИсполнитель.СуммаВозвратГарантийногоУдержания + СтрокаРабота.СуммаВозвратГарантийногоУдержания;
				КонецЦикла;
			КонецЕсли;
						
			СоответствиеИтогов.Вставить(СтрокаИсполнитель.ИсполнительРабота, 
				Новый Структура("СтоимостьРаботы, СтоимостьВнешняя, СуммаАванс, СуммаОстатокПлатежа, СуммаВозвратГарантийногоУдержания",
									СтрокаИсполнитель.СтоимостьРаботы,
									СтрокаИсполнитель.СтоимостьВнешняя,
									СтрокаИсполнитель.СуммаАванс,
									СтрокаИсполнитель.СуммаОстатокПлатежа,
									СтрокаИсполнитель.СуммаВозвратГарантийногоУдержания));
		КонецЦикла;
		СтрокаГруппировка.СтоимостьРаботы 					= СтрокаГруппировка.Строки.Итог("СтоимостьРаботы");
		СтрокаГруппировка.СтоимостьВнешняя 				 	= СтрокаГруппировка.Строки.Итог("СтоимостьВнешняя");
		СтрокаГруппировка.СуммаАванс 						= СтрокаГруппировка.Строки.Итог("СуммаАванс");
		СтрокаГруппировка.СуммаОстатокПлатежа 				= СтрокаГруппировка.Строки.Итог("СуммаОстатокПлатежа");
		СтрокаГруппировка.СуммаВозвратГарантийногоУдержания = СтрокаГруппировка.Строки.Итог("СуммаВозвратГарантийногоУдержания");
		
		СоответствиеИтогов.Вставить(СтрокаГруппировка.ИсполнительРабота, 
				Новый Структура("СтоимостьРаботы, СтоимостьВнешняя, СуммаАванс, СуммаОстатокПлатежа, СуммаВозвратГарантийногоУдержания",
									СтрокаГруппировка.СтоимостьРаботы,
									СтрокаГруппировка.СтоимостьВнешняя,
									СтрокаГруппировка.СуммаАванс,
									СтрокаГруппировка.СуммаОстатокПлатежа,
									СтрокаГруппировка.СуммаВозвратГарантийногоУдержания));
	КонецЦикла;
	
	ЭлементыДерева0 = ДеревоФинансирование.ПолучитьЭлементы();
	
	Для Каждого Элт0 Из ЭлементыДерева0 Цикл
		
		ЗаполнитьЗначенияСвойств(Элт0, СоответствиеИтогов[Элт0.ИсполнительРабота]);
		ЭлементоДерева1 = Элт0.ПолучитьЭлементы();
		Для Каждого Элт1 Из ЭлементоДерева1 Цикл
			ЗаполнитьЗначенияСвойств(Элт1, СоответствиеИтогов[Элт1.ИсполнительРабота]);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция РассчитатьФинансированиеПоДоговорамСубподряда()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ТаблицаРабот.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Организация,
	|	ЕСТЬNULL(ТаблицаРабот.ОбъектСтроительства, ЗНАЧЕНИЕ(Справочник.СМ_ОбъектыСтроительства.ПустаяСсылка)) КАК ОбъектСтроительства,
	|	ЕСТЬNULL(ТаблицаРабот.Работа, ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)) КАК Работа,
	|	ЕСТЬNULL(ТаблицаРабот.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент
	|ПОМЕСТИТЬ ВТ_ТаблицаРабот
	|ИЗ
	|	&ТаблицаРабот КАК ТаблицаРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Контрагент КАК Контрагент,
	|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Работа КАК Работа,
	|	МАКСИМУМ(УСОERP_ГрафикДвиженийПоДоговоруОбороты.ДатаСобытияПоДоговору) КАК ДатаСобытияПоДоговору,
	|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты КАК ПорядокОплаты,
	|	СУММА(УСОERP_ГрафикДвиженийПоДоговоруОбороты.ФинансированиеПланПриход) КАК ФинансированиеПланПриход
	|ПОМЕСТИТЬ ВТ_ДанныеПоГрафику
	|ИЗ
	|	РегистрНакопления.УСОERP_ГрафикДвиженийПоДоговору.Обороты(
	|			,
	|			,
	|			,
	|			(Организация, ОбъектСтроительства, Работа, Контрагент) В
	|					(ВЫБРАТЬ
	|						ВТ_ТаблицаРабот.Организация,
	|						ВТ_ТаблицаРабот.ОбъектСтроительства,
	|						ВТ_ТаблицаРабот.Работа,
	|						ВТ_ТаблицаРабот.Контрагент
	|					ИЗ
	|						ВТ_ТаблицаРабот КАК ВТ_ТаблицаРабот)
	|				И ПорядокОплаты ССЫЛКА Перечисление.ВариантыОплатыПоставщику) КАК УСОERP_ГрафикДвиженийПоДоговоруОбороты
	|ГДЕ
	|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.АвансДоПодтверждения)
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Контрагент,
	|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Работа,
	|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Контрагент,
	|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Работа,
	|	МАКСИМУМ(УСОERP_ГрафикДвиженийПоДоговоруОбороты.ДатаСобытияПоДоговору),
	|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты,
	|	СУММА(УСОERP_ГрафикДвиженийПоДоговоруОбороты.ФинансированиеПланПриход)
	|ИЗ
	|	РегистрНакопления.УСОERP_ГрафикДвиженийПоДоговору.Обороты(
	|			,
	|			,
	|			,
	|			(Организация, ОбъектСтроительства, Работа, Контрагент) В
	|					(ВЫБРАТЬ
	|						ВТ_ТаблицаРабот.Организация,
	|						ВТ_ТаблицаРабот.ОбъектСтроительства,
	|						ВТ_ТаблицаРабот.Работа,
	|						ВТ_ТаблицаРабот.Контрагент
	|					ИЗ
	|						ВТ_ТаблицаРабот КАК ВТ_ТаблицаРабот)
	|				И ПорядокОплаты ССЫЛКА Перечисление.ВариантыОплатыПоставщику) КАК УСОERP_ГрафикДвиженийПоДоговоруОбороты
	|ГДЕ
	|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.УСОERP_ГарантийноеУдержание)
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Контрагент,
	|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Работа,
	|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
