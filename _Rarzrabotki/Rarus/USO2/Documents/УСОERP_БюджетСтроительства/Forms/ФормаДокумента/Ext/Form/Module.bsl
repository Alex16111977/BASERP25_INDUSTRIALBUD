	|	УСОERP_СопоставлениеСтатейРасходовИСтатейБюджетовСрезПоследних.Работа,
	|	УСОERP_СопоставлениеСтатейРасходовИСтатейБюджетовСрезПоследних.СтатьяБюджетаБДР
	|ПОМЕСТИТЬ ВТ_СтатьиБДРПоОрганизации
	|ИЗ
	|	РегистрСведений.УСОERP_СопоставлениеСтатейРасходовИСтатейБюджетов.СрезПоследних(
	|			&КонецПериода,
	|			Организация В
	|					(ВЫБРАТЬ
	|						ВТ_Работы.Организация
	|					ИЗ
	|						ВТ_Работы КАК ВТ_Работы)
	|				И Работа = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|				И СтатьяРасходов = ЗНАЧЕНИЕ(ПланВидоВХарактеристик.СтатьиРасходов.ПустаяСсылка)
	|				И ОбъектСтроительства = ЗНАЧЕНИЕ(Справочник.СМ_ОбъектыСтроительства.ПустаяСсылка)) КАК УСОERP_СопоставлениеСтатейРасходовИСтатейБюджетовСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Работы.Организация,
	|	ВТ_Работы.ОбъектСтроительства,
	|	ВТ_Работы.Работа,
	|	ВТ_Работы.ГрафикАктирования,
	|	ВТ_Работы.Контрагент КАК Контрагент,
	|	ВТ_Работы.СтоимостьРаботы,
	|	ВТ_Работы.ЗаключенДоговор,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_СтатьиБДРПоРаботам.Работа, ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(ВТ_СтатьиБДРПоРаботам.СтатьяБюджетаБДР, ЗНАЧЕНИЕ(Справочник.СтатьиБюджетов.ПустаяСсылка))
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ЕСТЬNULL(ВТ_СтатьиБДРПоОбъектам.ОбъектСтроительства, ЗНАЧЕНИЕ(Справочник.СМ_ОбъектыСтроительства.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.СМ_ОбъектыСтроительства.ПустаяСсылка)
	|					ТОГДА ЕСТЬNULL(ВТ_СтатьиБДРПоОбъектам.СтатьяБюджетаБДР, ЗНАЧЕНИЕ(Справочник.СтатьиБюджетов.ПустаяСсылка))
	|				ИНАЧЕ ЕСТЬNULL(ВТ_СтатьиБДРПоОрганизации.СтатьяБюджетаБДР, ЗНАЧЕНИЕ(Справочник.СтатьиБюджетов.ПустаяСсылка))
	|			КОНЕЦ
	|	КОНЕЦ КАК СтатьяБюджета
	|ИЗ
	|	ВТ_Работы КАК ВТ_Работы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатьиБДРПоРаботам КАК ВТ_СтатьиБДРПоРаботам
	|		ПО ВТ_Работы.Организация = ВТ_СтатьиБДРПоРаботам.Организация
	|			И ВТ_Работы.ОбъектСтроительства = ВТ_СтатьиБДРПоРаботам.ОбъектСтроительства
	|			И ВТ_Работы.Работа = ВТ_СтатьиБДРПоРаботам.Работа
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатьиБДРПоОбъектам КАК ВТ_СтатьиБДРПоОбъектам
	|		ПО ВТ_Работы.Организация = ВТ_СтатьиБДРПоОбъектам.Организация
	|			И ВТ_Работы.ОбъектСтроительства = ВТ_СтатьиБДРПоОбъектам.ОбъектСтроительства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатьиБДРПоОрганизации КАК ВТ_СтатьиБДРПоОрганизации
	|		ПО ВТ_Работы.Организация = ВТ_СтатьиБДРПоОрганизации.Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагент,
	|	ВТ_Работы.Работа.КодСДР
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_РазделительнаяВедомостьМатериалыСрезПоследних.Работа,
	|	УСОERP_РазделительнаяВедомостьМатериалыСрезПоследних.Номенклатура,
	|	УСОERP_РазделительнаяВедомостьМатериалыСрезПоследних.Характеристика,
	|	СУММА(УСОERP_РазделительнаяВедомостьМатериалыСрезПоследних.КоличествоСобственное) КАК КоличествоСобственное
	|ИЗ
	|	РегистрСведений.УСОERP_РазделительнаяВедомостьМатериалы.СрезПоследних(
	|			&КонецПериода,
	|			Работа В
	|					(ВЫБРАТЬ
	|						ВТ_Работы.Работа
	|					ИЗ
	|						ВТ_Работы КАК ВТ_Работы)
	|				И Регистратор = &РазделительнаяВедомость) КАК УСОERP_РазделительнаяВедомостьМатериалыСрезПоследних
	|ГДЕ
	|	ЕСТЬNULL(УСОERP_РазделительнаяВедомостьМатериалыСрезПоследних.КоличествоСобственное, 0) <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_РазделительнаяВедомостьМатериалыСрезПоследних.Характеристика,
	|	УСОERP_РазделительнаяВедомостьМатериалыСрезПоследних.Работа,
	|	УСОERP_РазделительнаяВедомостьМатериалыСрезПоследних.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_РазделительнаяВедомостьРесурсыСрезПоследних.Работа,
	|	УСОERP_РазделительнаяВедомостьРесурсыСрезПоследних.Ресурс,
	|	СУММА(УСОERP_РазделительнаяВедомостьРесурсыСрезПоследних.КоличествоСобственное) КАК КоличествоСобственное,
	|	УСОERP_РазделительнаяВедомостьРесурсыСрезПоследних.КоличествоСубподряда
	|ИЗ
	|	РегистрСведений.УСОERP_РазделительнаяВедомостьРесурсы.СрезПоследних(
	|			&КонецПериода,
	|			Работа В
	|					(ВЫБРАТЬ
	|						ВТ_Работы.Работа
	|					ИЗ
	|						ВТ_Работы КАК ВТ_Работы)
	|				И Регистратор = &РазделительнаяВедомость) КАК УСОERP_РазделительнаяВедомостьРесурсыСрезПоследних
	|ГДЕ
	|	ЕСТЬNULL(УСОERP_РазделительнаяВедомостьРесурсыСрезПоследних.КоличествоСобственное, 0) <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_РазделительнаяВедомостьРесурсыСрезПоследних.Работа,
	|	УСОERP_РазделительнаяВедомостьРесурсыСрезПоследних.Ресурс,
	|	УСОERP_РазделительнаяВедомостьРесурсыСрезПоследних.КоличествоСубподряда";
	
	КонецЕсли;
	
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ТаблицаРабот", ТаблицаРабот);
	Запрос.УстановитьПараметр("РазделительнаяВедомость",Объект.РазделительнаяВедомость);  
	
	Результат = Запрос.ВыполнитьПакет();
	ТаблицаДанныхПоРаботам = Результат[11].Выгрузить();
	ТаблицаМатериалов 	= Результат[12].Выгрузить();
	ТаблицаРесурсов 	= Результат[13].Выгрузить();

	ТаблицаКонтрагентов =  ТаблицаДанныхПоРаботам.Скопировать(,"Контрагент");
	ТаблицаКонтрагентов.Свернуть("Контрагент");
	
	мДеревоФинансирования = РеквизитФормыВЗначение("ДеревоФинансирование");
	мДеревоАктирование = РеквизитФормыВЗначение("ДеревоАктирование");
	
	ДанныеДляДерева = Новый ТаблицаЗначений;
	ТипыЗначений = Новый Массив; 
    ТипыЗначений.Добавить(Тип("СправочникСсылка.Контрагенты")); 
    ТипыЗначений.Добавить(Тип("СправочникСсылка.УСОERP_СтроительныеРаботы")); 
	ДанныеДляДерева.Колонки.Добавить("ВыражениеИсточник",      Новый ОписаниеТипов(ТипыЗначений));		
	ДанныеДляДерева.Колонки.Добавить("ВыражениеПриемник",      Новый ОписаниеТипов(ТипыЗначений));		
	ДанныеДляДерева.Колонки.Добавить("КодСДР",                 Новый ОписаниеТипов("Строка"));		
	ДанныеДляДерева.Колонки.Добавить("НомерРаботыВУровне",     Новый ОписаниеТипов("Число"));		

	Для каждого Колонка Из мДеревоАктирование.Колонки Цикл
		
		Если ДанныеДляДерева.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			
			ДанныеДляДерева.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
			
		КонецЕсли; 
		
	КонецЦикла; 		
	
	Справочник =  Справочники.Контрагенты;
	
	Для Каждого СтрокаКонтрагент Из  ТаблицаКонтрагентов Цикл
		
		НоваяСтрокаКонтрагент = ДанныеДляДерева.Добавить();
		НоваяСтрокаКонтрагент.Контрагент = СтрокаКонтрагент.Контрагент;
		НоваяСтрокаКонтрагент.КонтрагентРабота = СтрокаКонтрагент.Контрагент;
		НоваяСтрокаКонтрагент.ГруппировкаПоИсполнителям = Истина;
		НоваяСтрокаКонтрагент.ВыражениеИсточник	= СтрокаКонтрагент.Контрагент;
		НоваяСтрокаКонтрагент.ВыражениеПриемник	= Справочник.ПустаяСсылка();
		
		ТаблицаРаботКонтрагента = ТаблицаДанныхПоРаботам.Скопировать(Новый Структура("Контрагент", СтрокаКонтрагент.Контрагент));
		
		СтоимостьИтого = 0; 
		
		Для Каждого СтрРабота Из ТаблицаРаботКонтрагента Цикл
			
			НоваяСтрокаРабота =  ДанныеДляДерева.Добавить();
			НоваяСтрокаРабота.Работа 			= СтрРабота.Работа;
			НоваяСтрокаРабота.КонтрагентРабота 	= СтрРабота.Работа;
			НоваяСтрокаРабота.Контрагент 		= СтрокаКонтрагент.Контрагент;
			НоваяСтрокаРабота.ЭтоРабота 		= Истина;
			НоваяСтрокаРабота.ЗаключенДоговор	= СтрРабота.ЗаключенДоговор;
			НоваяСтрокаРабота.ГрафикАктирования	= СтрРабота.ГрафикАктирования;
			НоваяСтрокаРабота.СтатьяБюджета		= СтрРабота.СтатьяБюджета;
			НоваяСтрокаРабота.ПроцентАктирования = 100;
			НоваяСтрокаРабота.ВыражениеИсточник	= СтрРабота.Работа;
			НоваяСтрокаРабота.ВыражениеПриемник	= НоваяСтрокаКонтрагент.ВыражениеИсточник;
			НоваяСтрокаРабота.ПорядокСортировки = СтрРабота.Работа.ПорядокСортировки;
		
			ДанныеПоРаботе = ТаблицаРабот.НайтиСтроки(Новый Структура("Работа", СтрРабота.Работа));
			
			Если ДанныеПоРаботе.Количество()<>0 Тогда
				
				НоваяСтрокаРабота.НачалоРаботы 			= ДанныеПоРаботе[0].НачалоРаботыПлан;
				НоваяСтрокаРабота.ОкончаниеРаботы 		= ДанныеПоРаботе[0].ОкончаниеРаботыПлан;
				НоваяСтрокаРабота.Длительность 			= ДанныеПоРаботе[0].ДлительностьПлан;
				НоваяСтрокаРабота.ЕдиницаДлительности 	= ДанныеПоРаботе[0].ЕдиницаДлительности;
				НоваяСтрокаРабота.СтоимостьРаботы       = ДанныеПоРаботе[0].СтоимостьРаботы;
				
			КонецЕсли;
			
			СтоимостьРаботы = 0;
			
			//проверка на использование собственных материалов и ресурсов
			СтрокиМатериалов = ТаблицаМатериалов.Скопировать(Новый Структура("Работа", НоваяСтрокаРабота.Работа));
		
			Для Каждого СтрМатериал Из СтрокиМатериалов Цикл
				
				СтрокиРасценкиМатериалов = Объект.СтоимостьМатериалов.НайтиСтроки(Новый Структура("Работа, Номенклатура, Характеристика", СтрМатериал.Работа, СтрМатериал.номенклатура, СтрМатериал.Характеристика));
				
				Для Каждого СтоимостьМатериала Из СтрокиРасценкиМатериалов Цикл
					
					СтоимостьРаботы = СтоимостьРаботы + СтоимостьМатериала.Цена * СтрМатериал.КоличествоСобственное;
				КонецЦикла;
				
			КонецЦикла;
			
			СтрокиРесурсов = ТаблицаРесурсов.Скопировать(Новый Структура("Работа", НоваяСтрокаРабота.Работа));
						
			Для Каждого СтрРесурс Из СтрокиРесурсов Цикл
				
				СтрокиРасценкиРесурсов = Объект.СтоимостьРесурсов.НайтиСтроки(Новый Структура("Работа, Ресурс", СтрРесурс.Работа, СтрРесурс.Ресурс));
				
				Для Каждого СтоимостьРесурс Из  СтрокиРасценкиРесурсов Цикл	
					
					СтоимостьРаботы = СтоимостьРаботы + Окр(СтоимостьРесурс.БазоваяЦена * Окр(СтрРесурс.КоличествоСобственное *СтоимостьРесурс.ОбъемРабот/(СтрРесурс.КоличествоСобственное + СтрРесурс.КоличествоСубподряда),2),2);
				
				КонецЦикла;
				
			КонецЦикла;

			НоваяСтрокаРабота.СтоимостьРаботы = СтоимостьРаботы;
			
			Если СтрРабота.ЗаключенДоговор Тогда
				
				НоваяСтрокаРабота.СтоимостьВнешняя = СтрРабота.СтоимостьРаботы;
			Иначе
				
				СтрокиФинансирования = мДеревоФинансирования.Строки.НайтиСтроки(Новый Структура("Контрагент, Работа", СтрокаКонтрагент.Контрагент, СтрРабота.Работа), Истина);
				
				Если СтрокиФинансирования.Количество() Тогда
					
					НоваяСтрокаРабота.СтоимостьВнешняя = ?(СтрокиФинансирования[0].СтоимостьВнешняя = 0, СтрокиФинансирования[0].СтоимостьРаботы,СтрокиФинансирования[0].СтоимостьВнешняя);
			
				КонецЕсли;
				
			КонецЕсли;
			
			СтоимостьИтого = СтоимостьИтого + НоваяСтрокаРабота.СтоимостьВнешняя;
			
		КонецЦикла;
		
		НоваяСтрокаКонтрагент.СтоимостьВнешняя = СтоимостьИтого;
		
	КонецЦикла;
	
	ВыражениеИсточник = "ВыражениеИсточник";
	ВыражениеПриемник = "ВыражениеПриемник";
	ДеревоРезультат = УСОERP_ОбработкаТабличныхЧастей.УСОERP_ПодготовитьДанныеИСформироватьДерево(ДанныеДляДерева,ВыражениеИсточник, ВыражениеПриемник, Справочник);
	
	Для каждого Строка Из ДеревоРезультат.Строки Цикл
		
		Строка.СтоимостьРаботы = Строка.Строки.Итог("СтоимостьРаботы");
		
	КонецЦикла;											
														
	мДеревоАктирование.Строки.Очистить();
	УСОERP_ОбработкаТабличныхЧастей.УСОERP_ЗаполнитьРоднуюСтруктуруДереваИзВнешнего(мДеревоАктирование.Строки, ДеревоРезультат.Строки); // и рекурсивно заполняется из дерева, где, возможн, типиация создаст проблемы
	мДеревоАктирование.Строки.Сортировать("ПорядокСортировки",Истина);
	ЗначениеВРеквизитФормы(мДеревоАктирование, "ДеревоАктирование");
	
	мДеревоАктирование.Строки.Очистить(); 
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьАктированиеНаСервере()
	
	СтрокиКонтрагентов = ДеревоАктирование.ПолучитьЭлементы();
	
	Для Каждого СтрокаКонтрагент Из СтрокиКонтрагентов Цикл
		
		СтрокиРаботы = СтрокаКонтрагент.ПолучитьЭлементы();
		
		Для Каждого СтрокаРабота Из СтрокиРаботы Цикл
			
			Если ЗначениеЗаполнено(СтрокаРабота.ГрафикАктирования) Тогда
				
				ВыполнитьРассчетАктированияНаСервере(СтрокаРабота.ПолучитьИдентификатор());
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьРассчетАктированияНаСервере(ИдентификаторСтроки)
	
	СтрокаДерева = ДеревоАктирование.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если СТрокаДЕрева = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиДат = СтрокаДерева.ПолучитьЭлементы();
	СтрокиДат.Очистить();
	
	ГрафикАктирования = СтрокаДерева.ГрафикАктирования;
	
	Если Не ЗначениеЗаполнено(ГрафикАктирования) Тогда
		Возврат;
	КонецЕсли;
	
	ВариантАктирования = ГрафикАктирования.ВариантАктирования;
	Календарь = ГрафикАктирования.Календарь;
	Сдвиг = ГрафикАктирования.Сдвиг;
	
	Если ВариантАктирования = Перечисления.УСОERP_ВариантыАктирования.НаДатуОкончанияРаботы Тогда
		
		НоваяДатаОкончания = СтрокаДерева.ОкончаниеРаботы + Сдвиг * 24 * 60 * 60;
		
		Если ЗначениеЗаполнено(Календарь) Тогда
			
			НачальныеДаты = Новый Массив;
			НачальныеДаты.Добавить(НоваяДатаОкончания);
			СоответствиеБлижайшихДат = КалендарныеГрафики.ПолучитьДатыРабочихДней(Календарь, НачальныеДаты, ,, ); 			
			НоваяДатаОкончания = СоответствиеБлижайшихДат[НачалоДня(НоваяДатаОкончания)];
			
		КонецЕсли;
		
		НоваяСтрока = СтрокиДат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева,, "ЭтоРабота");
		
		НоваяСтрока.ДатаАктирования 	= НоваяДатаОкончания;
		НоваяСтрока.ПроцентАктирования 	= 100;
		НоваяСтрока.СтоимостьРаботы 	= СтрокаДерева.СтоимостьРаботы;
		НоваяСтрока.СтоимостьВнешняя 	= СтрокаДерева.СтоимостьВнешняя;
		
	ИначеЕсли  ВариантАктирования = Перечисления.УСОERP_ВариантыАктирования.Ежемесячно Тогда
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	РАЗНОСТЬДАТ(&ДатаНачала, &ДатаОкончания, МЕСЯЦ) КАК КоличествоМесяцев";
		Запрос.УстановитьПараметр("ДатаНачала", СтрокаДерева.НачалоРаботы);
		Запрос.УстановитьПараметр("ДатаОкончания", СтрокаДерева.ОкончаниеРаботы);
		
		Результат = Запрос.Выполнить().Выбрать();
		Результат.Следующий();
		КоличествоМесяцев = Результат.КоличествоМесяцев + 1;
		
		ГрафикРаботы = ?(ЗначениеЗаполнено(СтрокаДерева.Работа.ГрафикРаботы), СтрокаДерева.Работа.ГрафикРаботы, Объект.ОбъектСтроительства.ГрафикРаботы);
		ОбщееКоличествоРабочихДней = КалендарныеГрафики.ПолучитьРазностьДатПоКалендарю(ГрафикРаботы, СтрокаДерева.НачалоРаботы, СтрокаДерева.ОкончаниеРаботы);
		
		ОбщийПроцент = 0;
		ОбщаяСтоимость = 0;
		
		ПредыдущаяСтрока = Неопределено;
		СтоимостьИтого = 0;
		СтоимостьРаботыИтого = 0;
		Для к = 1 По КоличествоМесяцев Цикл
			
			НоваяДатаОкончания = КонецМесяца(ДобавитьМесяц(КонецМесяца(СтрокаДерева.НачалоРаботы), к-1)) + Сдвиг * 24 * 60 * 60;
			
			Если ЗначениеЗаполнено(Календарь) Тогда
				
				НачальныеДаты = Новый Массив;
				НачальныеДаты.Добавить(НоваяДатаОкончания);
				СоответствиеБлижайшихДат = КалендарныеГрафики.ПолучитьДатыРабочихДней(Календарь, НачальныеДаты, ,, ); 			
				НоваяДатаОкончания = СоответствиеБлижайшихДат[НачалоДня(НоваяДатаОкончания)]; 				
				
			КонецЕсли;
			
			НоваяСтрока = СтрокиДат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева,, "ЭтоРабота");
			
			НоваяСтрока.ДатаАктирования 	= НоваяДатаОкончания;
			
			НачальнаяДата = ?(ПредыдущаяСтрока = Неопределено, СтрокаДерева.НачалоРаботы, ПредыдущаяСтрока.ДатаАктирования);
			КоличествоРабочихДней = КалендарныеГрафики.ПолучитьРазностьДатПоКалендарю(ГрафикРаботы, НачальнаяДата, НоваяСтрока.ДатаАктирования);
			
			СтоимостьАктирования = ?(ОбщееКоличествоРабочихДней = 0, 0, Окр(СтрокаДерева.СтоимостьВнешняя * КоличествоРабочихДней / ОбщееКоличествоРабочихДней, 2));
			
			Если СтрокаДерева.СтоимостьВнешняя - СтоимостьИтого<СтоимостьАктирования Тогда
				
				СтоимостьАктирования = СтрокаДерева.СтоимостьВнешняя - СтоимостьИтого;
				
			КонецЕсли;
			
			СтоимостьИтого = СтоимостьИтого +  СтоимостьАктирования;
		
			НоваяСтрока.СтоимостьВнешняя 	= СтоимостьАктирования;
			НоваяСтрока.ПроцентАктирования 	= ?(СтрокаДерева.СтоимостьВнешняя = 0, 0, Окр(СтоимостьАктирования/СтрокаДерева.СтоимостьВнешняя*100,2)) ; 			
			
			СтоимостьРаботы 	= Окр(НоваяСтрока.ПроцентАктирования *СтрокаДерева.СтоимостьРаботы/ 100, 2);
			Если СтрокаДерева.СтоимостьРаботы - СтоимостьРаботыИтого < СтоимостьРаботы Тогда
				СтоимостьРаботы = СтрокаДерева.СтоимостьРаботы - СтоимостьРаботыИтого;
			КОнецЕсли;
			НоваяСтрока.СтоимостьРаботы 	= СтоимостьРаботы;
			СтоимостьРаботыИтого = СтоимостьРаботыИтого + СтоимостьРаботы;

			ОбщийПроцент = ОбщийПроцент + НоваяСтрока.ПроцентАктирования;
			ОбщаяСтоимость = ОбщаяСтоимость + НоваяСтрока.СтоимостьВнешняя;
			
			ПредыдущаяСтрока = НоваяСтрока;
			
		КонецЦикла;
		
		ОшибкаПроцент = Ложь;
		ОшибкаСтоимость = Ложь;
		
		Если ОбщийПроцент <> 100 Тогда
			
			Разница = 100 - ОбщийПроцент;
			НоваяСтрока.ПроцентАктирования = НоваяСтрока.ПроцентАктирования+Разница;
			
		КонецЕсли;
		
		Если ОбщаяСтоимость <> СтрокаДерева.СтоимостьВнешняя Тогда
			
			Разница =  СтрокаДерева.СтоимостьВнешняя - ОбщаяСтоимость;
			НоваяСтрока.СтоимостьВнешняя = НоваяСтрока.СтоимостьВнешняя+Разница;
			
		КонецЕсли;
		
		СтрокиОшибок = СтрокаДерева.ПолучитьЭлементы();
		
		Для Каждого СтрОшибка Из СтрокиОшибок Цикл
			
			СтрОшибка.ОшибкаПроцент = ОшибкаПроцент;
			СтрОшибка.ОшибкаСтоимость = ОшибкаСтоимость;
			
		КонецЦикла;		  		
			
	ИначеЕсли  ВариантАктирования = Перечисления.УСОERP_ВариантыАктирования.Ежеквартально Тогда
		
		ГрафикРаботы = ?(ЗначениеЗаполнено(СтрокаДерева.Работа.ГрафикРаботы), СтрокаДерева.Работа.ГрафикРаботы, Объект.ОбъектСтроительства.ГрафикРаботы);
		ОбщееКоличествоРабочихДней = КалендарныеГрафики.ПолучитьРазностьДатПоКалендарю(ГрафикРаботы, СтрокаДерева.НачалоРаботы, СтрокаДерева.ОкончаниеРаботы);
		
		МассивДатОкончаниеКвартала = Новый Массив;
		Для мГод = Год(СтрокаДерева.НачалоРаботы) По Год(СтрокаДерева.ОкончаниеРаботы) Цикл
			Если мГод = Год(СтрокаДерева.НачалоРаботы) Тогда
				МасяцНачалаРаботы = Месяц(СтрокаДерева.НачалоРаботы);
				Если МасяцНачалаРаботы >= 1 И МасяцНачалаРаботы <= 3 Тогда
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, МасяцНачалаРаботы, 1)) + Сдвиг * 24 * 60 *60);
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, 6, 1)) + Сдвиг * 24 * 60 *60);				
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, 9, 1)) + Сдвиг * 24 * 60 *60);				
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, 12, 1)) + Сдвиг * 24 * 60 *60);
				ИначеЕсли МасяцНачалаРаботы >= 4 И МасяцНачалаРаботы <= 6 Тогда
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, МасяцНачалаРаботы, 1)) + Сдвиг * 24 * 60 *60);
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, 9, 1)) + Сдвиг * 24 * 60 *60);				
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, 12, 1)) + Сдвиг * 24 * 60 *60);
				ИначеЕсли МасяцНачалаРаботы >= 7 И МасяцНачалаРаботы <= 9 Тогда
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, МасяцНачалаРаботы, 1)) + Сдвиг * 24 * 60 *60);
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, 12, 1)) + Сдвиг * 24 * 60 *60);
				ИначеЕсли МасяцНачалаРаботы >= 10 И МасяцНачалаРаботы <= 12 Тогда
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, МасяцНачалаРаботы, 1)) + Сдвиг * 24 * 60 *60);
				КонецЕсли;
			ИначеЕсли мГод = Год(СтрокаДерева.ОкончаниеРаботы) Тогда
				МасяцОкончанияРаботы = Месяц(СтрокаДерева.ОкончаниеРаботы);
				Если МасяцОкончанияРаботы >= 1 И МасяцОкончанияРаботы <= 3 Тогда
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, МасяцОкончанияРаботы, 1)) + Сдвиг * 24 * 60 *60);	
				ИначеЕсли МасяцОкончанияРаботы >= 4 И МасяцОкончанияРаботы <= 6 Тогда
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, 3, 1)) + Сдвиг * 24 * 60 *60);
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, МасяцОкончанияРаботы, 1)) + Сдвиг * 24 * 60 *60);
				ИначеЕсли МасяцОкончанияРаботы >= 7 И МасяцОкончанияРаботы <= 9 Тогда
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, 3, 1)) + Сдвиг * 24 * 60 *60); 				
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, 6, 1)) + Сдвиг * 24 * 60 *60);
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, МасяцОкончанияРаботы, 1)) + Сдвиг * 24 * 60 *60);
				ИначеЕсли МасяцОкончанияРаботы >= 10 И МасяцОкончанияРаботы <= 12 Тогда
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, 3, 1)) + Сдвиг * 24 * 60 *60); 				
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, 6, 1)) + Сдвиг * 24 * 60 *60);				
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, 9, 1)) + Сдвиг * 24 * 60 *60);
					МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, МасяцОкончанияРаботы, 1)) + Сдвиг * 24 * 60 *60);
				КонецЕсли;
			Иначе
				МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, 3, 1)) + Сдвиг * 24 * 60 *60); 				
				МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, 6, 1)) + Сдвиг * 24 * 60 *60);				
				МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, 9, 1)) + Сдвиг * 24 * 60 *60);				
				МассивДатОкончаниеКвартала.Добавить(КонецМесяца(Дата(мГод, 12, 1)) + Сдвиг * 24 * 60 *60);
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Календарь) Тогда
			НачальныеДаты = Новый Массив;
			НачальныеДаты.Добавить(НоваяДатаОкончания);
			СоответствиеБлижайшихДат = КалендарныеГрафики.ПолучитьДатыРабочихДней(Календарь, МассивДатОкончаниеКвартала, ,, ); 		
			
			ДатыДляРасчета = СоответствиеБлижайшихДат;
		Иначе
			ДатыДляРасчета = МассивДатОкончаниеКвартала;
		КонецЕсли;
		
		ОбщийПроцент = 0;
		ОбщаяСтоимость = 0;

		ПредыдущаяСтрока = Неопределено;
		СтоимостьИтого = 0;
		СтоимостьРаботыИтого = 0;
		Для Каждого мДатаКвартала Из ДатыДляРасчета Цикл  			
			
			НоваяСтрока = СтрокиДат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева,, "ЭтоРабота");
			НоваяДатаОкончания = ?(ТипЗнч(мДатаКвартала) = Тип("Дата"), мДатаКвартала, мДатаКвартала.Значение);
			НоваяСтрока.ДатаАктирования 	= НоваяДатаОкончания;
			
			НачальнаяДата = ?(ПредыдущаяСтрока = Неопределено, СтрокаДерева.НачалоРаботы, ПредыдущаяСтрока.ДатаАктирования);
			КоличествоРабочихДней = КалендарныеГрафики.ПолучитьРазностьДатПоКалендарю(ГрафикРаботы, НачальнаяДата, НоваяСтрока.ДатаАктирования);
			
			СтоимостьАктирования = ?(ОбщееКоличествоРабочихДней = 0, 0, Окр(СтрокаДерева.СтоимостьВнешняя * КоличествоРабочихДней / ОбщееКоличествоРабочихДней, 2));
			
			Если СтрокаДерева.СтоимостьВнешняя - СтоимостьИтого<СтоимостьАктирования Тогда
				СтоимостьАктирования = СтрокаДерева.СтоимостьВнешняя - СтоимостьИтого;
			КонецЕсли;
			СтоимостьИтого = СтоимостьИтого +  СтоимостьАктирования;
			
			НоваяСтрока.СтоимостьВнешняя 	= СтоимостьАктирования;
			НоваяСтрока.ПроцентАктирования 	= ?(СтрокаДерева.СтоимостьВнешняя = 0, 0, Окр(СтоимостьАктирования/СтрокаДерева.СтоимостьВнешняя*100,2)) ; 			
			
			СтоимостьРаботы 	= Окр(НоваяСтрока.ПроцентАктирования *СтрокаДерева.СтоимостьРаботы/ 100, 2);
			Если СтрокаДерева.СтоимостьРаботы - СтоимостьРаботыИтого < СтоимостьРаботы Тогда
				СтоимостьРаботы = СтрокаДерева.СтоимостьРаботы - СтоимостьРаботыИтого;
			КОнецЕсли;
			НоваяСтрока.СтоимостьРаботы 	= СтоимостьРаботы;
			СтоимостьРаботыИтого = СтоимостьРаботыИтого + СтоимостьРаботы;
			
			ОбщийПроцент = ОбщийПроцент + НоваяСтрока.ПроцентАктирования;
			ОбщаяСтоимость = ОбщаяСтоимость + НоваяСтрока.СтоимостьВнешняя;
			
			ПредыдущаяСтрока = НоваяСтрока;
		КонецЦикла;
		
		ОшибкаПроцент = Ложь;
		ОшибкаСтоимость = Ложь;
		Если ОбщийПроцент <> 100 Тогда
			ОшибкаПроцент = Истина;
		КонецЕсли;
		Если ОбщаяСтоимость <> СтрокаДерева.СтоимостьВнешняя Тогда
			ОшибкаСтоимость = Истина;
		КонецЕсли;
		
		СтрокиОшибок = СтрокаДерева.ПолучитьЭлементы();
		Для Каждого СтрОшибка Из СтрокиОшибок Цикл
			СтрОшибка.ОшибкаПроцент = ОшибкаПроцент;
			СтрОшибка.ОшибкаСтоимость = ОшибкаСтоимость;
		КонецЦикла;
		 
	КонецЕсли;
	
	
КОнецПроцедуры

&НаСервере
Функция ПолучитьМассивРаспределенияНаСервере(РаспределяемоеЗначение, МассивРаспределения)
	
	Возврат ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(РаспределяемоеЗначение, МассивРаспределения,2);
	
КонецФункции

&НаСервере
Процедура СохранитьАктирование(ТекущийОбъект, Отказ, ПроверятьНаОшибки)
	
	ТаблицаАктирование = ТекущийОбъект.Актирование;
	ТаблицаАктирование.Очистить();
	
	мКонтрагенты = ДеревоАктирование.ПолучитьЭлементы();
	Для Каждого СтрКонтрагент Из мКонтрагенты Цикл
		Работы = СтрКонтрагент.ПолучитьЭлементы();
		Для Каждого СтрокаРабота Из Работы Цикл
			Актирование = СтрокаРабота.ПолучитьЭлементы();
			
			Если Актирование.Количество() = 0 Тогда
				НоваяСтрока = ТаблицаАктирование.добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРабота); 
			Иначе
				Для Каждого СтрокаАктирование Из Актирование Цикл
					
					Если СтрокаАктирование.ОшибкаПроцент 
						И ПроверятьНаОшибки Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Итоговый % актирования должен равняться 100", Объект.Ссылка, "ДеревоАктирование.ПроцентАктирование");
						Отказ = Истина;
						Возврат;
					ИначеЕсли  СтрокаАктирование.ОшибкаПроцент 
						И ПроверятьНаОшибки Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Общая стоимость актирования должена равняться стоимости работы", Объект.Ссылка, "ДеревоАктирование.СтоимостьВнешняя");
						Отказ = Истина;
						Возврат;
					Иначе
						НоваяСтрока = ТаблицаАктирование.добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАктирование); 
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоАктированиеПриСоздании()	
	
	ТаблицаДокумента = Объект.Актирование.Выгрузить();
	
	Если НЕ ТаблицаДокумента.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	Контрагенты = ТаблицаДокумента.Скопировать(,"Контрагент");
	Контрагенты.Свернуть("Контрагент");
	
	Работы = ТаблицаДокумента.Скопировать(,"Контрагент, Работа");
	Работы.Свернуть("Контрагент, Работа");
	
	мДеревоАктирование = РеквизитФормыВЗначение("ДеревоАктирование");
	ДанныеДляДерева = Новый ТаблицаЗначений;
	ТипыЗначений = Новый Массив; 
    ТипыЗначений.Добавить(Тип("СправочникСсылка.Контрагенты")); 
    ТипыЗначений.Добавить(Тип("СправочникСсылка.УСОERP_СтроительныеРаботы")); 
	ДанныеДляДерева.Колонки.Добавить("ВыражениеИсточник",      Новый ОписаниеТипов(ТипыЗначений));		
	ДанныеДляДерева.Колонки.Добавить("ВыражениеПриемник",      Новый ОписаниеТипов(ТипыЗначений));		
	ДанныеДляДерева.Колонки.Добавить("КодСДР",                 Новый ОписаниеТипов("Строка"));		
	ДанныеДляДерева.Колонки.Добавить("НомерРаботыВУровне",     Новый ОписаниеТипов("Число"));		

	Для каждого Колонка Из мДеревоАктирование.Колонки Цикл
		Если ДанныеДляДерева.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			ДанныеДляДерева.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
		КонецЕсли; 
	КонецЦикла; 		
	Справочник =  Справочники.Контрагенты;
	Для Каждого СтрокаКонтрагент Из Контрагенты Цикл
		НоваяСтрокаКонтрагент = ДанныеДляДерева.Добавить();
		НоваяСтрокаКонтрагент.Контрагент = СтрокаКонтрагент.Контрагент;
		НоваяСтрокаКонтрагент.КонтрагентРабота = СтрокаКонтрагент.Контрагент;
		НоваяСтрокаКонтрагент.ГруппировкаПоИсполнителям = Истина;
		НоваяСтрокаКонтрагент.ВыражениеИсточник	= СтрокаКонтрагент.Контрагент;
		НоваяСтрокаКонтрагент.ВыражениеПриемник	= Справочник.ПустаяСсылка();
			
		ТаблицаРаботКонтрагента = Работы.Скопировать(Новый Структура("Контрагент", СтрокаКонтрагент.Контрагент));
		
		СтоимостьИтого = 0; 
		Для Каждого СтрРабота Из ТаблицаРаботКонтрагента Цикл
			НоваяСтрокаРабота =  ДанныеДляДерева.Добавить();
			НоваяСтрокаРабота.Работа 			= СтрРабота.Работа;
			НоваяСтрокаРабота.КонтрагентРабота 	= СтрРабота.Работа;
			НоваяСтрокаРабота.Контрагент 		= СтрокаКонтрагент.Контрагент;
			НоваяСтрокаРабота.ЭтоРабота 		= Истина;
			НоваяСтрокаРабота.ВыражениеИсточник	= СтрРабота.Работа;
			НоваяСтрокаРабота.ВыражениеПриемник	= НоваяСтрокаКонтрагент.ВыражениеИсточник;
			
			ПерваяСтрока = Истина;
			СтрокиДанных = ТаблицаДокумента.Скопировать(Новый Структура("Контрагент, Работа", СтрРабота.Контрагент, СтрРабота.Работа));
			
			НоваяСтрокаРабота.СтоимостьРаботы = СтрокиДанных.Итог("СтоимостьРаботы");
			НоваяСтрокаРабота.СтоимостьВнешняя = СтрокиДанных.Итог("СтоимостьВнешняя");
			НоваяСтрокаРабота.ПроцентАктирования = СтрокиДанных.Итог("ПроцентАктирования");
			
			Для Каждого СтрДанные Из  СтрокиДанных Цикл
				
				Если ПерваяСтрока Тогда	
					НоваяСтрокаРабота.ЗаключенДоговор 		= СтрДанные.ЗаключенДоговор;
					НоваяСтрокаРабота.ГрафикАктирования		= СтрДанные.ГрафикАктирования;
					НоваяСтрокаРабота.СтатьяБюджета     	= СтрДанные.СтатьяБюджета;
					НоваяСтрокаРабота.НачалоРаботы 			= СтрДанные.НачалоРаботы;
					НоваяСтрокаРабота.ОкончаниеРаботы 		= СтрДанные.ОкончаниеРаботы;
					НоваяСтрокаРабота.Длительность 			= СтрДанные.Длительность;
					НоваяСтрокаРабота.ЕдиницаДлительности 	= СтрДанные.ЕдиницаДлительности;
					
					ПерваяСтрока = Ложь;
					Продолжить;
					
				КонецЕсли;
				
				НоваяСтрока =  ДанныеДляДерева.Добавить();
				ЗаполнитьЗначенияСвойств( НоваяСтрока, СтрДанные);
				НоваяСтрока.КонтрагентРабота = СтрДанные.Работа;
				НоваяСтрока.ВыражениеПриемник	= НоваяСтрокаРабота.ВыражениеИсточник;
				
			КонецЦикла;
			
			СтоимостьИтого = СтоимостьИтого + НоваяСтрокаРабота.СтоимостьВнешняя;
			
		КонецЦикла;
		
		НоваяСтрокаКонтрагент.СтоимостьВнешняя = СтоимостьИтого;
		
	КонецЦикла;
	
	ВыражениеИсточник = "ВыражениеИсточник";
	ВыражениеПриемник = "ВыражениеПриемник";
	ДеревоРезультат = УСОERP_ОбработкаТабличныхЧастей.УСОERP_ПодготовитьДанныеИСформироватьДерево(ДанныеДляДерева,ВыражениеИсточник, ВыражениеПриемник, Справочник);
	
	Для каждого Строка Из ДеревоРезультат.Строки Цикл
		Строка.СтоимостьРаботы = Строка.Строки.Итог("СтоимостьРаботы");
	КонецЦикла; 													
														
	мДеревоАктирование.Строки.Очистить();
	УСОERP_ОбработкаТабличныхЧастей.УСОERP_ЗаполнитьРоднуюСтруктуруДереваИзВнешнего(мДеревоАктирование.Строки, ДеревоРезультат.Строки); // и рекурсивно заполняется из дерева, где, возможн, типиация создаст проблемы
	ЗначениеВРеквизитФормы(мДеревоАктирование, "ДеревоАктирование");
	мДеревоАктирование.Строки.Очистить(); 														
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтоги()
	
	Контрагенты = ДеревоАктирование.ПолучитьЭлементы();
	Для Каждого СтрокаКонтрагент Из Контрагенты Цикл
		 Работы = СтрокаКонтрагент.ПолучитьЭлементы();
		 Для Каждого СтрокаРабота Из Работы Цикл
			 Данные = СтрокаРабота.ПолучитьЭлементы();
			 ОбщийПроцент = 0;
			 ОбщаяСтоимость = 0;
			 Для Каждого СтрДанные Из Данные Цикл
				 ОбщийПроцент = ОбщийПроцент + СтрДанные.ПроцентАктирования;
				 ОбщаяСтоимость = ОбщаяСтоимость + СтрДанные.СтоимостьВнешняя;
			 КонецЦикла;
			 
			 ОшибкаПроцент = Ложь;
			 ОшибкаСтоимость = Ложь;
			 Если ОбщийПроцент <> 100 Тогда
				 ОшибкаПроцент = Истина;
			 КонецЕсли;
			 Если ОбщаяСтоимость <> СтрокаРабота.СтоимостьВнешняя Тогда
				 ОшибкаСтоимость = Истина;
			 КонецЕсли;

			 Для Каждого СтрДанные Из Данные Цикл
				 СтрДанные.ОшибкаПроцент = ОшибкаПроцент;
				 СтрДанные.ОшибкаСтоимость = ОшибкаСтоимость;
			 КонецЦикла;
			 
		 КонецЦикла;
		 
	 КонецЦикла;
	 
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтоимостьФинансирования(ИдентификаторАктирования)
	
	СтрокаАктирования = ДеревоАктирование.НайтиПоИдентификатору(ИдентификаторАктирования);
	
	мДеревоФинансирования = РеквизитФормыВЗначение("ДеревоФинансирование");
	
	СтрокиФинансирования = мДеревоФинансирования.Строки.НайтиСтроки(Новый Структура("Работа", СтрокаАктирования.Работа), Истина);
	
	Если СтрокиФинансирования.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаФинанс Из СтрокиФинансирования Цикл		
		СтрокаФинанс.СтоимостьВнешняя = СтрокаАктирования.СтоимостьВнешняя;  	
		ВыполнитьРасчетПоГрафикуФинансирования(,СтрокаФинанс); 	
	КонецЦикла;
		
	ЗначениеВРеквизитФормы(мДеревоФинансирования, "ДеревоФинансирование");
	
	СоответствиеИтогов = Новый Соответствие;
	мДеревоФинансирование = РеквизитФормыВЗначение("ДеревоФинансирование");
	Для Каждого СтрокаГруппировка Из мДеревоФинансирование.Строки Цикл
		
		Для Каждого СтрокаИсполнитель Из СтрокаГруппировка.Строки Цикл
			
			СтрокаИсполнитель.СтоимостьРаботы 					= СтрокаИсполнитель.Строки.Итог("СтоимостьРаботы");
			СтрокаИсполнитель.СтоимостьВнешняя 				 	= СтрокаИсполнитель.Строки.Итог("СтоимостьВнешняя");
			СтрокаИсполнитель.СуммаАванс 						= СтрокаИсполнитель.Строки.Итог("СуммаАванс");
			
			СтрокаИсполнитель.СуммаОстатокПлатежа 				= СтрокаИсполнитель.Строки.Итог("СуммаОстатокПлатежа");
			СтрокаИсполнитель.СуммаВозвратГарантийногоУдержания = СтрокаИсполнитель.Строки.Итог("СуммаВозвратГарантийногоУдержания");

			ДопСтрокиРабот = СтрокаИсполнитель.Строки.НайтиСтроки(Новый Структура("ЭтоРабота", Ложь), Истина);
			Если ДопСтрокиРабот.Количество() > 0 Тогда
				Для Каждого СтрокаРабота Из ДопСтрокиРабот Цикл
					СтрокаИсполнитель.СуммаОстатокПлатежа = СтрокаИсполнитель.СуммаОстатокПлатежа + СтрокаРабота.СуммаОстатокПлатежа;
					СтрокаИсполнитель.СуммаВозвратГарантийногоУдержания = СтрокаИсполнитель.СуммаВозвратГарантийногоУдержания + СтрокаРабота.СуммаВозвратГарантийногоУдержания;
				КонецЦикла;
			КонецЕсли;
						
			СоответствиеИтогов.Вставить(СтрокаИсполнитель.ИсполнительРабота, 
				Новый Структура("СтоимостьРаботы, СтоимостьВнешняя, СуммаАванс, СуммаОстатокПлатежа, СуммаВозвратГарантийногоУдержания",
									СтрокаИсполнитель.СтоимостьРаботы,
									СтрокаИсполнитель.СтоимостьВнешняя,
									СтрокаИсполнитель.СуммаАванс,
									СтрокаИсполнитель.СуммаОстатокПлатежа,
									СтрокаИсполнитель.СуммаВозвратГарантийногоУдержания));
		КонецЦикла;
		
		СтрокаГруппировка.СтоимостьРаботы 					= СтрокаГруппировка.Строки.Итог("СтоимостьРаботы");
		СтрокаГруппировка.СтоимостьВнешняя 				 	= СтрокаГруппировка.Строки.Итог("СтоимостьВнешняя");
		СтрокаГруппировка.СуммаАванс 						= СтрокаГруппировка.Строки.Итог("СуммаАванс");
		СтрокаГруппировка.СуммаОстатокПлатежа 				= СтрокаГруппировка.Строки.Итог("СуммаОстатокПлатежа");
		СтрокаГруппировка.СуммаВозвратГарантийногоУдержания = СтрокаГруппировка.Строки.Итог("СуммаВозвратГарантийногоУдержания");
		
		СоответствиеИтогов.Вставить(СтрокаГруппировка.ИсполнительРабота, 
				Новый Структура("СтоимостьРаботы, СтоимостьВнешняя, СуммаАванс, СуммаОстатокПлатежа, СуммаВозвратГарантийногоУдержания",
									СтрокаГруппировка.СтоимостьРаботы,
									СтрокаГруппировка.СтоимостьВнешняя,
									СтрокаГруппировка.СуммаАванс,
									СтрокаГруппировка.СуммаОстатокПлатежа,
									СтрокаГруппировка.СуммаВозвратГарантийногоУдержания));
	КонецЦикла;
	
	ЭлементыДерева0 = ДеревоФинансирование.ПолучитьЭлементы();
	
	Для Каждого Элт0 Из ЭлементыДерева0 Цикл
		ЗаполнитьЗначенияСвойств(Элт0, СоответствиеИтогов[Элт0.ИсполнительРабота]);
		ЭлементоДерева1 = Элт0.ПолучитьЭлементы();
		Для Каждого Элт1 Из ЭлементоДерева1 Цикл
			ЗаполнитьЗначенияСвойств(Элт1, СоответствиеИтогов[Элт1.ИсполнительРабота]);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтогПоСтрокеФинансирования(ИдентификаторСтроки)
	
	ТекущиеДанные = ДеревоФинансирование.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	РодительСтроки = ТекущиеДанные.ПолучитьРодителя();
	Работы = РодительСтроки.ПолучитьЭлементы();
	СтоимостьИтого 			= 0;
	СтоимостьВнешняяИтого 	= 0;
	АвансИтого 				= 0;
	ПлатежИтого 			= 0;
	ГУИтого 				= 0;
	
	Для Каждого СтрокаРабота Из Работы Цикл
		СтоимостьИтого 			= СтоимостьИтого + СтрокаРабота.СтоимостьРаботы;
		СтоимостьВнешняяИтого 	= СтоимостьВнешняяИтого + СтрокаРабота.СтоимостьВнешняя;
		АвансИтого 				= АвансИтого + СтрокаРабота.СуммаАванс;
		ПлатежИтого 			= ПлатежИтого + СтрокаРабота.СуммаОстатокПлатежа;
		ГУИтого                 = ГУИтого + СтрокаРабота.СуммаВозвратГарантийногоУдержания;
		
		ДопСтроки = СтрокаРабота.ПолучитьЭлементы();
		Для Каждого  СтрДоп Из ДопСтроки Цикл
			ПлатежИтого 			= ПлатежИтого + СтрДоп.СуммаОстатокПлатежа;
			ГУИтого                 = ГУИтого + СтрДоп.СуммаВозвратГарантийногоУдержания;
		КонецЦикла;
		
	КонецЦикла;
	
	РодительСтроки.СтоимостьРаботы 					 = СтоимостьИтого;
	РодительСтроки.СтоимостьВнешняя 				 = СтоимостьВнешняяИтого;
	РодительСтроки.СуммаАванс 						 = АвансИтого;
	РодительСтроки.СуммаОстатокПлатежа 				 = ПлатежИтого;
	РодительСтроки.СуммаВозвратГарантийногоУдержания = ГУИтого;

	СтрокаОбщейГруппировки = РодительСтроки.ПолучитьРодителя();
    Исполнители = СтрокаОбщейГруппировки.ПолучитьЭлементы();
	СтоимостьИтого 			= 0;
	СтоимостьВнешняяИтого 	= 0;
	АвансИтого 				= 0;
	ПлатежИтого 			= 0;
	ГУИтого 				= 0;
	
	Для Каждого СтрокаИсполнитель Из Исполнители Цикл
		СтоимостьИтого 			= СтоимостьИтого + СтрокаИсполнитель.СтоимостьРаботы;
		СтоимостьВнешняяИтого 	= СтоимостьВнешняяИтого + СтрокаИсполнитель.СтоимостьВнешняя;
		АвансИтого 				= АвансИтого + СтрокаИсполнитель.СуммаАванс;
		ПлатежИтого 			= ПлатежИтого + СтрокаИсполнитель.СуммаОстатокПлатежа;
		ГУИтого                 = ГУИтого + СтрокаИсполнитель.СуммаВозвратГарантийногоУдержания;
	КонецЦикла;
	
	СтрокаОбщейГруппировки.СтоимостьРаботы 					 = СтоимостьИтого;
	СтрокаОбщейГруппировки.СтоимостьВнешняя 				 = СтоимостьВнешняяИтого;
	СтрокаОбщейГруппировки.СуммаАванс 						 = АвансИтого;
	СтрокаОбщейГруппировки.СуммаОстатокПлатежа 				 = ПлатежИтого;
	СтрокаОбщейГруппировки.СуммаВозвратГарантийногоУдержания = ГУИтого;

КонецПроцедуры

&НаСервере
Процедура ОбвитьАктирование(ИдентификаторСтроки, АктированиеОбновлено = Ложь)
	
	СтрокаФинансирования = ДеревоФинансирование.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	мДеревоАктирование = РеквизитФормыВЗначение("ДеревоАктирование");
	СтрокиАктирование = мДеревоАктирование.Строки.НайтиСтроки(Новый Структура("Работа, ЭтоРабота", СтрокаФинансирования.Работа, истина), Истина);
	
	Если СтрокиАктирование.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаРабота Из СтрокиАктирование Цикл
		СтрокаРабота.СтоимостьВнешняя = СтрокаФинансирования.СтоимостьВнешняя;
		
		СтоимостьАктированияИтого = 0;
		Для Каждого СтрокаДата Из СтрокаРабота.Строки Цикл
			СтоимостьВнешняя = Окр( СтрокаРабота.СтоимостьВнешняя * СтрокаДата.ПроцентАктирования/ 100, 2);
			Если СтрокаРабота.СтоимостьВнешняя - СтоимостьАктированияИтого < СтоимостьВнешняя тогда
				СтоимостьВнешняя = СтрокаРабота.СтоимостьВнешняя - СтоимостьАктированияИтого;
			Конецесли;
			СтрокаДата.СтоимостьВнешняя = СтоимостьВнешняя;
			СтоимостьАктированияИтого = СтоимостьАктированияИтого +  СтоимостьВнешняя;
		КонецЦикла;
		
		РодительСтроки = СтрокаРабота.Родитель;
		РодительСтроки.СтоимостьВнешняя = РодительСтроки.Строки.Итог("СтоимостьВнешняя");
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(мДеревоАктирование, "ДеревоАктирование");
	АктированиеОбновлено = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоАктированиеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	а = Поле;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если Объект.Организация <> ТекущаяОрганизация
		И ЗначениеЗаполнено(ТекущаяОрганизация)
		И ЗначениеЗаполнено(Объект.ОбъектСтроительства)
		И  ДеревоРабот.ПолучитьЭлементы().Количество() > 0 Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ОбъектСтроительстваПриИзмененииПродолжение",ЭтотОбъект),"Расценка объекта будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
		
	Иначе
		
		ОбъектСтроительстваПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьСметнымиРасценками(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("КомандаЗаполнитьСметнымиРасценкамиЗавершение",ЭтотОбъект);
	
	ОткрытьФорму("Документ.УСОERP_БюджетСтроительства.Форма.ФормаСметныхРасценок",Новый Структура("ОбъектСтроительства",Объект.ОбъектСтроительства),ЭтотОбъект,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьСметнымиРасценкамиЗавершение(ТаблицаСмет,ДопПараметры) Экспорт
	
	Если ТаблицаСмет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСметнымиРасценкамиНаСервере(ТаблицаСмет);
    РассчитатьИтогПоОбъекту();
	Модифицированность = Истина;
	ПересчитатьИтогиДереваНаКлиенте(Истина);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСметнымиРасценкамиНаСервере(ТаблицаСмет)
	
	ТабСмет = Новый ТаблицаЗначений;
	ТабСмет.Колонки.Добавить("Приоритет",Новый ОписаниеТипов("Число"));
	ТабСмет.Колонки.Добавить("Смета",Новый ОписаниеТипов("ДокументСсылка.СМ_ЛокальнаяСмета"));
	
	Строки = ТаблицаСмет.НайтиСтроки(Новый Структура("Отбор",Истина));
	
	Для Каждого НайденнаяСтрока ИЗ Строки Цикл
		
		ЗаполнитьЗначенияСвойств(ТабСмет.Добавить(),НайденнаяСтрока);
		
	КонецЦикла;
	
	ТабМатериалы = Объект.СтоимостьМатериалов.Выгрузить();
	ТабРесурсы   = Объект.СтоимостьРесурсов.Выгрузить(); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТабСмет",ТабСмет);
	Запрос.УстановитьПараметр("ТабМатериалы",ТабМатериалы);
	Запрос.УстановитьПараметр("ТабРесурсы",ТабРесурсы);
	Запрос.УстановитьПараметр("НовыйВариант",Объект.ДокументОснование.СценарийПланирования.НовыйВариант);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТабСмет.Приоритет КАК Приоритет,
	|	ТабСмет.Смета КАК Смета
	|ПОМЕСТИТЬ ТабСмет
	|ИЗ
	|	&ТабСмет КАК ТабСмет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТабМатериалы.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	ТабМатериалы.СтатьяРасходов КАК СтатьяРасходов,
	|	ТабМатериалы.Номенклатура КАК Номенклатура,
	|	ТабМатериалы.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ТабМатериалы
	|ИЗ
	|	&ТабМатериалы КАК ТабМатериалы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТабРесурсы.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	ТабРесурсы.Ресурс КАК Ресурс,
	|	ТабРесурсы.ОбъектРасценки КАК ОбъектРасценки,
	|	ТабРесурсы.СтатьяРасходов КАК СтатьяРасходов
	|ПОМЕСТИТЬ ТабРесурсы
	|ИЗ
	|	&ТабРесурсы КАК ТабРесурсы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабМатериалы.Работа КАК Работа,
	|	ТабМатериалы.Номенклатура КАК Номенклатура,
	|	ТабСмет.Приоритет КАК Приоритет,
	|	УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами.ПозицияЛС КАК ПозицияЛС,
	|	УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами.СметныйРесурс КАК СметныйРесурс,
	|	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.ТекущаяЦена КАК ТекущаяЦена,
	|	ТабМатериалы.Характеристика КАК Характеристика
	|ИЗ
	|	ТабМатериалы КАК ТабМатериалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами КАК УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабСмет КАК ТабСмет
	|			ПО УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами.ПозицияЛС.ИДСметы = ТабСмет.Смета
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СМ_ПозицияЛокальнойСметы.РесурсыПозицииЛокальнойСметы КАК СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы
	|			ПО УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами.ПозицияЛС = СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ссылка
	|				И УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами.СметныйРесурс = СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ресурс
	|		ПО (ТабМатериалы.Работа = УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами.Работа
	|				ИЛИ ТабМатериалы.Работа.РаботаИсточник = УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами.Работа)
	|			И ТабМатериалы.Номенклатура = УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами.ПлановыйРесурс
	|			И ТабМатериалы.Характеристика = УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами.Характеристика
	|ГДЕ
	|	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.ТипМатериала <> ЗНАЧЕНИЕ(Перечисление.СМ_ТипыМатериалов.НеУчтенный)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Работа,
	|	Номенклатура,
	|	Характеристика,
	|	Приоритет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабРесурсы.Работа КАК Работа,
	|	ТабРесурсы.Ресурс КАК Ресурс,
	|	ТабСмет.Приоритет КАК Приоритет,
	|	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.ТекущаяЦена КАК ТекущаяЦена
	|ИЗ
	|	ТабРесурсы КАК ТабРесурсы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами КАК УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабСмет КАК ТабСмет
	|			ПО (ТабСмет.Смета = УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами.ПозицияЛС.ИДСметы)
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СМ_ПозицияЛокальнойСметы.РесурсыПозицииЛокальнойСметы КАК СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы
	|			ПО УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами.ПозицияЛС = СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ссылка
	|				И УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами.СметныйРесурс = СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ресурс
	|		ПО (ТабРесурсы.Работа = УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами.Работа
	|				ИЛИ ТабРесурсы.Работа.РаботаИсточник = УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами.Работа)
	|			И ТабРесурсы.Ресурс = УСОERP_СоответствиеСметныхРесурсовСПланируемымиРесурсами.ПлановыйРесурс
	|ГДЕ
	|	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.ТипМатериала <> ЗНАЧЕНИЕ(Перечисление.СМ_ТипыМатериалов.НеУчтенный)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Работа,
	|	Ресурс,
	|	Приоритет"; 
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	ТаблицаЦеныМатериалов = ПакетЗапросов[3].Выгрузить();
	ТаблицаЦеныРесурсов   = ПакетЗапросов[4].Выгрузить();
	
	МассивИзмененныхРабот = Новый Массив; 	
	
	Для Каждого СтрокаМатериалы ИЗ Объект.СтоимостьМатериалов Цикл
		
		//Строки = ТаблицаЦеныМатериалов.НайтиСтроки(Новый Структура("Работа,Номенклатура",СтрокаМатериалы.Работа,СтрокаМатериалы.Номенклатура));
		Строки = ТаблицаЦеныМатериалов.НайтиСтроки(Новый Структура("Работа,Номенклатура,Характеристика",СтрокаМатериалы.Работа,СтрокаМатериалы.Номенклатура,СтрокаМатериалы.Характеристика));
		
		Если Строки.Количество() Тогда
			
			СтрокаМатериалы.Цена = Строки.Получить(0).ТекущаяЦена;
			СтрокаМатериалы.Сумма = СтрокаМатериалы.Цена*СтрокаМатериалы.Количество;
			
			Если МассивИзмененныхРабот.Найти(СтрокаМатериалы.Работа) = Неопределено Тогда
				
				МассивИзмененныхРабот.Добавить(СтрокаМатериалы.Работа);
				
			КонецЕсли;
			
		КонецЕсли;		
		
	КонецЦикла;
	
	Для Каждого СтрокаРесурсы ИЗ Объект.СтоимостьРесурсов Цикл
		
		Строки = ТаблицаЦеныРесурсов.НайтиСтроки(Новый Структура("Работа,Ресурс",СтрокаРесурсы.Работа,СтрокаРесурсы.Ресурс));
		
		Если Строки.Количество() Тогда
			
			СтрокаРесурсы.ЦенаСУчетомПоправки = Строки.Получить(0).ТекущаяЦена;
			СтрокаРесурсы.БазоваяЦена = СтрокаРесурсы.ЦенаСУчетомПоправки;
			СтрокаРесурсы.Сумма = СтрокаРесурсы.ОбъемРабот*СтрокаРесурсы.ЦенаСУчетомПоправки;
			
			Если МассивИзмененныхРабот.Найти(СтрокаРесурсы.Работа) = Неопределено Тогда
				
				МассивИзмененныхРабот.Добавить(СтрокаРесурсы.Работа);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ТабМатериалы",Объект.СтоимостьМатериалов.Выгрузить());
	Запрос.УстановитьПараметр("ТабРесурсы",Объект.СтоимостьРесурсов.Выгрузить());
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабМатериалы.Работа,
	|	ТабМатериалы.Сумма
	|ПОМЕСТИТЬ ТабМатериалы
	|ИЗ
	|	&ТабМатериалы КАК ТабМатериалы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабРесурсы.Работа,
	|	ТабРесурсы.Сумма
	|ПОМЕСТИТЬ ТабРесурсы
	|ИЗ
	|	&ТабРесурсы КАК ТабРесурсы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабРесурсыПоТипу.ОбъектРасценки,
	|	ТабРесурсыПоТипу.Сумма
	|ПОМЕСТИТЬ ТабРесурсыПоТипу
	|ИЗ
	|	&ТабРесурсы КАК ТабРесурсыПоТипу
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Работа,
	|	СУММА(ВложенныйЗапрос.Сумма) КАК Сумма
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТабМатериалы.Работа КАК Работа,
	|		ТабМатериалы.Сумма КАК Сумма
	|	ИЗ
	|		ТабМатериалы КАК ТабМатериалы
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТабРесурсы.Работа,
	|		ТабРесурсы.Сумма
	|	ИЗ
	|		ТабРесурсы КАК ТабРесурсы) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Работа";
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	ТабРабот = ПакетЗапросов[3].Выгрузить(); 
	
	КЧ = Новый КвалификаторыЧисла(15,2);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Число"));
	ТипЧисло = Новый ОписаниеТипов(Массив, , ,КЧ);
	
	ТабРабот.Колонки.Добавить("БазоваяСтоимость",ТипЧисло);
	ТабРабот.Колонки.Добавить("НакладныеРасходы",ТипЧисло);
	ТабРабот.Колонки.Добавить("СтоимостьСУчетомНакладныхРасходов",ТипЧисло);
	ТабРабот.Колонки.Добавить("СуммаСНДС",ТипЧисло);
	ТабРабот.Колонки.Добавить("СуммаНДС",ТипЧисло);
	
	ДеревоДанных = РеквизитФормыВЗначение("ДеревоРабот");
	
	ТекСтавкаНДС = ?(Объект.УчитыватьНДС,Объект.СтавкаНДС,Перечисления.СтавкиНДС.БезНДС);
	
	Для Каждого СтрокаРабот ИЗ ТабРабот Цикл
		
		СтрокаДерева = ДеревоДанных.Строки.НайтиСтроки(Новый Структура("Работа",СтрокаРабот.Работа),Истина).Получить(0);
		
		СтрокаДерева.БазоваяСтоимость = СтрокаРабот.Сумма;
		
		СтрокаДерева.СтоимостьСУчетомНакладныхРасходов = СтрокаДерева.БазоваяСтоимость+СтрокаДерева.НакладныеРасходы;
		
		СтрокаДерева.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СтрокаДерева.СтоимостьСУчетомНакладныхРасходов, ТекСтавкаНДС,Ложь);		
		
		СтрокаДерева.СуммаСНДС = СтрокаДерева.СтоимостьСУчетомНакладныхРасходов+СтрокаДерева.СуммаНДС;
		
		ЗаполнитьЗначенияСвойств(СтрокаРабот,СТрокаДерева,"БазоваяСтоимость,НакладныеРасходы,СтоимостьСУчетомНакладныхРасходов,СуммаСНДС,СуммаНДС");
		
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ТабРабот",ТабРабот);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабРабот.БазоваяСтоимость,
	|	ТабРабот.НакладныеРасходы,
	|	ТабРабот.СтоимостьСУчетомНакладныхРасходов,
	|	ТабРабот.СуммаСНДС,
	|	ТабРабот.СуммаНДС,
	|	ВЫРАЗИТЬ(ТабРабот.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа
	|ПОМЕСТИТЬ ТабРабот
	|ИЗ
	|	&ТабРабот КАК ТабРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабРабот.СуммаСНДС КАК СуммаСНДС,
	|	ТабРабот.Работа КАК Работа,
	|	ТабРабот.Работа.СуммарнаяРабота КАК СуммарнаяРабота,
	|	ТабРабот.СуммаНДС КАК СуммаНДС,
	|	ТабРабот.БазоваяСтоимость КАК БазоваяСтоимость,
	|	ТабРабот.НакладныеРасходы КАК НакладныеРасходы,
	|	ТабРабот.СтоимостьСУчетомНакладныхРасходов КАК СтоимостьСУчетомНакладныхРасходов
	|ИЗ
	|	ТабРабот КАК ТабРабот
	|ИТОГИ
	|	СУММА(СуммаСНДС),
	|	СУММА(СуммаНДС),
	|	СУММА(БазоваяСтоимость),
	|	СУММА(НакладныеРасходы),
	|	СУММА(СтоимостьСУчетомНакладныхРасходов)
	|ПО
	|	Работа ИЕРАРХИЯ";
	
	ТаблицаДерева = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицы ИЗ ТаблицаДерева Цикл
		
		Если НЕ СтрокаТаблицы.СуммарнаяРабота Тогда
			Продолжить;
		КонецЕсли;
		
		Строки = ДеревоДанных.Строки.НайтиСтроки(Новый Структура("Работа",СтрокаТаблицы.Работа));
		
		Если Строки.Количество() Тогда
			
			СтрокаДерева = Строки.Получить(0);
			
			ЗаполнитьЗначенияСвойств(СтрокаДерева,СтрокаТаблицы,"БазоваяСтоимость,НакладныеРасходы,СтоимостьСУчетомНакладныхРасходов,СуммаСНДС,СуммаНДС");
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоДанных,"ДеревоРабот"); 		  
	
КонецПроцедуры 

&НаКлиенте
Процедура ДеревоРаботОценкаСтоимостейКоэффициентПриИзменении(Элемент)
	
	ТекСтрока = Элементы.ДеревоРаботОценкаСтоимостей.ТекущиеДанные;	
	
	ЗаполнитьЗначенияКоэффициента(ТекСтрока,ТекСтрока.Коэффициент);
	
	Модифицированность = Истина;
	
	ПересчитатьИтогиДереваНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗначенияКоэффициента(ЭлементДерева,Коэффициент)
	
	СуммаРасчетная =  ЭлементДерева.СуммаСНДС*Объект.УчитыватьНДС + ЭлементДерева.СтоимостьСУчетомНакладныхРасходов*(НЕ Объект.УчитыватьНДС);
	ЭлементДерева.ЦенаЗаказчика = СуммаРасчетная*Коэффициент;
	ЭлементДерева.Коэффициент = Коэффициент;
	ЭлементДерева.ДобавленнаяСтоимость = ЭлементДерева.ЦенаЗаказчика-СуммаРасчетная;
	
	Для Каждого ПодЭлемент ИЗ ЭлементДерева.ПолучитьЭлементы() Цикл
		
		ЗаполнитьЗначенияКоэффициента(ПодЭлемент,Коэффициент);
		
	КонецЦикла; 		
	
КонецПроцедуры  	

&НаКлиенте
Процедура ДеревоРаботОценкаСтоимостейЦенаЗаказчикаПриИзменении(Элемент)
	
	ТекСтрока = Элементы.ДеревоРаботОценкаСтоимостей.ТекущиеДанные;
	СуммаРасчетная =  ТекСтрока.СуммаСНДС*Объект.УчитыватьНДС + ТекСтрока.СтоимостьСУчетомНакладныхРасходов*(НЕ Объект.УчитыватьНДС);
	ТекСтрока.Коэффициент = ?(СуммаРасчетная = 0,0,ТекСтрока.ЦенаЗаказчика/СуммаРасчетная);
	ТекСтрока.ДобавленнаяСтоимость = ТекСтрока.ЦенаЗаказчика-СуммаРасчетная;
	
	Модифицированность = Истина;
	
	ПересчитатьИтогиДереваНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтогиДереваНаКлиенте(ПересчитыватьЗначения = Ложь) 	
	
	ИтогЦенаЗаказчика = 0;
	ИтогДобавленнаяСтоимость = 0;
	ИтогСуммаСНДС = 0;	
	ПересчитатьСуммыДерева(ДеревоРабот,ПересчитыватьЗначения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммыДерева(Строки,ПересчитыватьЗначения) 	
	
	Для Каждого Строка ИЗ Строки.ПолучитьЭлементы() Цикл
		
		Если Строка.ПолучитьЭлементы().Количество() = 0 Тогда
			
			СуммаРасчетная =  (Строка.СуммаСНДС*Объект.УчитыватьНДС+Строка.СтоимостьСУчетомНакладныхРасходов*(НЕ Объект.УчитыватьНДС));
			
			Если ПересчитыватьЗначения Тогда 				
				
				Строка.ЦенаЗаказчика = СуммаРасчетная*Строка.Коэффициент;
				Строка.ДобавленнаяСтоимость = Строка.ЦенаЗаказчика-СуммаРасчетная;
				
			КонецЕсли;  			
			
			ИтогЦенаЗаказчика = ИтогЦенаЗаказчика+Строка.ЦенаЗаказчика;
			ИтогДобавленнаяСтоимость = ИтогДобавленнаяСтоимость+Строка.ДобавленнаяСтоимость;
			ИтогСуммаСНДС = ИтогСуммаСНДС+СуммаРасчетная;
			
			Продолжить;
			
		КонецЕсли;
		
		ПересчитатьСуммыДерева(Строка,ПересчитыватьЗначения);
		
		Строка.ЦенаЗаказчика = 0;
		Строка.ДобавленнаяСтоимость = 0;
		Строка.Коэффициент = 0;
		
		Для Каждого Элемент ИЗ Строка.ПолучитьЭлементы() Цикл 			
			
			Строка.ЦенаЗаказчика = Строка.ЦенаЗаказчика+Элемент.ЦенаЗаказчика;  			
			
		КонецЦикла;
		
		СуммаРасчетная =  (Строка.СуммаСНДС*Объект.УчитыватьНДС+Строка.СтоимостьСУчетомНакладныхРасходов*(НЕ Объект.УчитыватьНДС));
		
		Строка.ДобавленнаяСтоимость = Строка.ЦенаЗаказчика-СуммаРасчетная;
		Строка.Коэффициент = ?(СуммаРасчетная = 0,0,Строка.ЦенаЗаказчика/СуммаРасчетная);		
		
	КонецЦикла;	
	
КонецПроцедуры 

&НаСервере
Процедура  ПересчитатьИтогиДерева()
	
	Дерево = РеквизитФормыВЗначение("ДеревоРабот");
	
	соотвКолонок = Новый Соответствие;
	соотвКолонок.Вставить("ЦенаЗаказчика");
	соотвКолонок.Вставить("ДобавленнаяСтоимость");
	ИтогЦенаЗаказчика = 0;
	ИтогДобавленнаяСтоимость = 0;
	ИтогСуммаСНДС = 0;
	
	СчитатьСуммыДЗ(Дерево.Строки, соотвКолонок);
	
	Для Каждого СтрокаДерева ИЗ Дерево.Строки Цикл
		
		ИтогЦенаЗаказчика = ИтогЦенаЗаказчика+СтрокаДерева.ЦенаЗаказчика;
		ИтогДобавленнаяСтоимость = ИтогДобавленнаяСтоимость+СтрокаДерева.ДобавленнаяСтоимость;
		ИтогСуммаСНДС = ИтогСуммаСНДС+СтрокаДерева.СуммаСНДС*Объект.УчитыватьНДС+СтрокаДерева.СтоимостьСУчетомНакладныхРасходов*(НЕ Объект.УчитыватьНДС);
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево,"ДеревоРабот"); 	
	
КонецПроцедуры 

&НаСервере
Процедура СчитатьСуммыДЗ(СтрокиДЗ, соотвКолонок) Экспорт
	
	Для Каждого СтрокаДЗ Из СтрокиДЗ Цикл     
		
		Если СтрокаДЗ.Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СчитатьСуммыДЗ(СтрокаДЗ.Строки, соотвКолонок);
		
		Для Каждого СтрКолонки Из соотвКолонок Цикл
			
			СтрокаДЗ[СтрКолонки.Ключ] = СтрокаДЗ.Строки.Итог(СтрКолонки.Ключ);
			СтрокаДЗ.Коэффициент = ?(СтрокаДЗ.СуммаСНДС = 0,0,СтрокаДЗ.ЦенаЗаказчика/СтрокаДЗ.СуммаСНДС);
			
		КонецЦикла; 
		
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботОценкаСтоимостейПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботОценкаСтоимостейПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьКоэффициент(Команда)
	
	Число = 1;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("КомандаЗаполнитьКоэффициентПродолжение",ЭтотОбъект);
	
	ПоказатьВводЧисла(ОписаниеОповещения,Число,"Введите коэффициент",5,2);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьКоэффициентПродолжение(Число,ДопПараметры) Экспорт
	
	Если Число = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаДерева ИЗ Элементы.ДеревоРаботОценкаСтоимостей.ВыделенныеСтроки Цикл
		
		ЗаполнитьЗначенияКоэффициента(ДеревоРабот.НайтиПоИдентификатору(СтрокаДерева),Число);
		
	КонецЦикла;	
	
	Модифицированность = Истина;
	
	ПересчитатьИтогиДереваНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства

КонецПроцедуры

