							КОнецЕсли;
						КонецЕсли;

						МассивСтатейБюджета =  ТЗ_СтатьиБюджета.НайтиСтроки(Новый Структура("Работа, СтатьяРасходов", СтрокаРабота.Работа, СтрСтатьяРасхода.СтатьяРасходов));
						
						Если МассивСтатейБюджета.Количество()>0 Тогда
							НоваяСтрока.СтатьяБюджета = МассивСтатейБюджета[0].Статьябюджета;
						КонецЕсли;

					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;
						
			НоваяСтрока = ТаблицаРаботКонтрагентов.Добавить();
			НоваяСтрока.Контрагент = СтрокаРабота.Контрагент;
			НоваяСтрока.Работа = СтрокаРабота.Работа;
			НоваяСтрока.КодСДР = СтрокаРабота.Работа.КодСДР;
			НоваяСтрока.СтоимостьРаботы =  СтоимостьРаботы;
			
			МассивГрафиковОплаты = ТЗ_ГрафикиОплаты.НайтиСтроки(Новый Структура("Работа", СтрокаРабота.Работа));
			
			Если МассивГрафиковОплаты.Количество()<>0 Тогда
				НоваяСтрока.ГрафикФинансирования = МассивГрафиковОплаты[0].ГрафикФинансированияСПодрядчиком;
