Функция ПолучитьСтруктуруПересчетаСуммыНДСВСтрокеТЧ(Форма)
	
	СтруктураПересчетаСуммы = Новый Структура;
	СтруктураПересчетаСуммы.Вставить("ЦенаВключаетНДС", Форма.Объект.ТипЦеныМатериалов.ЦенаВключаетНДС); 
	СтруктураПересчетаСуммы.Вставить("НДСпоСтавкам4и2", Ложь);
	
	Возврат СтруктураПересчетаСуммы;
	
КонецФункции

&НаСервере
Процедура РассчитатьИтогиПоМатериаламИРесурсам(ТекущаяРабота)
	
	МассивСтрокМатериалы = Объект.СтоимостьМатериалов.НайтиСтроки(Новый Структура("Работа", ТекущаяРабота));
	СуммаПоМатериалам = 0;
	
	Для Каждого СтрокаМатериал Из МассивСтрокМатериалы Цикл
		СуммаПоМатериалам = СуммаПоМатериалам + СтрокаМатериал.Сумма;
	КонецЦикла;
	
	СуммаВсегоПоМатериалам = СуммаПоМатериалам;
	
	МассивСтрокРесурсы  = Объект.СтоимостьРесурсов.НайтиСтроки(Новый Структура("Работа", ТекущаяРабота));
	СуммаПоИсполнителям = 0;
	СуммаПоМашинам = 0;
	
	Для Каждого СтрокаРесурс Из МассивСтрокРесурсы Цикл
		Если ТипЗнч(СтрокаРесурс.ОбъектРасценки) = Тип("СправочникСсылка.Должности") Тогда
			СуммаПоИсполнителям = СуммаПоИсполнителям + СтрокаРесурс.Сумма;
		Иначе
			СуммаПоМашинам 		= СуммаПоМашинам + СтрокаРесурс.Сумма;
		КонецЕсли;
	КонецЦикла;
	
	СуммаВсегоПоИсполнителям = СуммаПоИсполнителям;
	СуммаВсегоПоМеханизамам  = СуммаПоМашинам;
	СуммаВсегоПоРесурсам 	 =  СуммаВсегоПоИсполнителям + СуммаВсегоПоМеханизамам;
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьНаКлиенте(мТекущаяСтрока = Неопределено)
	
	Если мТекущаяСтрока = Неопределено Тогда
		КоллекцияЭлементовДерева = ДеревоРабот.ПолучитьЭлементы();
	Иначе
		КоллекцияЭлементовДерева = мТекущаяСтрока.ПолучитьЭлементы();
	КонецЕсли;
	
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл
		ИдентификаторСтроки	= Строка.ПолучитьИдентификатор();
		Элементы.ДеревоРабот.Свернуть(ИдентификаторСтроки);
	КонецЦикла;  

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьНаКлиенте(мТекущаяСтрока = Неопределено)
	
	Если мТекущаяСтрока = Неопределено Тогда
		КоллекцияЭлементовДерева = ДеревоРабот.ПолучитьЭлементы();
	Иначе
		КоллекцияЭлементовДерева = мТекущаяСтрока.ПолучитьЭлементы();
	КонецЕсли;   
	
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл
		ИдентификаторСтроки	= Строка.ПолучитьИдентификатор();
		Элементы.ДеревоРабот.Развернуть(ИдентификаторСтроки);
		
		Если Строка.ПолучитьЭлементы().количество()>0 Тогда
			РазвернутьНаКлиенте(Строка);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура РаспределитьНакладныеРасходыНаСервере()
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_БюджетСтроительства_РаспределитьНакладныеРасходы(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьИзмененияБюджетаСтроительства(ТекущийОбъект)
	
	ТекущийОбъект.Расценка.Очистить();
	
	мДеревоРабот = РеквизитФормыВЗначение("ДеревоРабот", Тип("ДеревоЗначений"));
	СохранитьДеревоРабот(ТекущийОбъект.Расценка, мДеревоРабот);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьДеревоРабот(ТаблицаРасценки, СтрокаДереваРабот)
	
	Для Каждого СтрокаДерева из СтрокаДереваРабот.Строки Цикл
		
		НоваяСтрока = ТаблицаРасценки.Добавить();
		ЗаполнитьЗначенияСвойств( НоваяСтрока, СтрокаДерева);
		НоваяСтрока.НачалоРаботыПлан = СтрокаДерева.НачалоРаботы;
		НоваяСтрока.ОкончаниеРаботыПлан = СтрокаДерева.ОкончаниеРаботы;
		НоваяСтрока.ДлительностьПлан = СтрокаДерева.Длительность;
		НоваяСтрока.НачалоРаботыПлан = СтрокаДерева.НачалоРаботы;
		
		СохранитьДеревоРабот(ТаблицаРасценки, СтрокаДерева);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоРаботПриСоздании()
	
	Запрос = Новый Запрос;
		                   		
	Запрос.УстановитьПараметр("ТЗ",Объект.Расценка.Выгрузить());
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.НомерСтроки КАК НомерСтроки,
	|	ТЗ.Отметка КАК Отметка,
	|	ВЫРАЗИТЬ(ТЗ.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	ТЗ.ОбъектРасценки КАК ОбъектРасценки,
	|	ТЗ.Характеристки КАК Характеристки,
	|	ТЗ.ОбъемРаботы КАК ОбъемРаботы,
	|	ТЗ.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТЗ.НачалоРаботыПлан КАК НачалоРаботыПлан,
	|	ТЗ.ОкончаниеРаботыПлан КАК ОкончаниеРаботыПлан,
	|	ТЗ.ДлительностьПлан КАК ДлительностьПлан,
	|	ТЗ.ЕдиницаДлительности КАК ЕдиницаДлительности,
	|	ТЗ.ГрафикРаботы КАК ГрафикРаботы,
	|	ТЗ.Количество КАК Количество,
	|	ТЗ.БазоваяСтоимость КАК БазоваяСтоимость,
	|	ТЗ.СтоимостьСУчетомПоправок КАК СтоимостьСУчетомПоправок,
	|	ТЗ.НакладныеРасходы КАК НакладныеРасходы,
	|	ТЗ.СтоимостьСУчетомНакладныхРасходов КАК СтоимостьСУчетомНакладныхРасходов,
	|	ТЗ.Ресурс КАК Ресурс,
	|	ТЗ.СуммаНДС КАК СуммаНДС,
	|	ТЗ.СуммаСНДС КАК СуммаСНДС,
	|	ТЗ.СуммарнаяРабота КАК СуммарнаяРабота,
	|	ТЗ.Коэффициент КАК Коэффициент,
	|	ТЗ.ЦенаЗаказчика КАК ЦенаЗаказчика,
	|	ТЗ.ДобавленнаяСтоимость КАК ДобавленнаяСтоимость
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.НомерСтроки КАК НомерСтроки,
	|	ВрТаб.Отметка КАК Отметка,
	|	ВрТаб.Работа КАК Работа,
	|	ВрТаб.Работа.Родитель КАК РаботаРодитель,
	|	ВрТаб.Работа.КодСДР КАК КодСДР,
	|	ВрТаб.Работа.НомерРаботыВУровне КАК НомерРаботыВУровне,
	|	ВрТаб.ОбъектРасценки КАК ОбъектРасценки,
	|	ВрТаб.Характеристки КАК Характеристки,
	|	ВрТаб.ОбъемРаботы КАК ОбъемРаботы,
	|	ВрТаб.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ВрТаб.НачалоРаботыПлан КАК НачалоРаботы,
	|	ВрТаб.ОкончаниеРаботыПлан КАК ОкончаниеРаботы,
	|	ВрТаб.ДлительностьПлан КАК Длительность,
	|	ВрТаб.ЕдиницаДлительности КАК ЕдиницаДлительности,
	|	ВрТаб.ГрафикРаботы КАК ГрафикРаботы,
	|	ВрТаб.Количество КАК Количество,
	|	ВрТаб.БазоваяСтоимость КАК БазоваяСтоимость,
	|	ВрТаб.СтоимостьСУчетомПоправок КАК СтоимостьСУчетомПоправок,
	|	ВрТаб.НакладныеРасходы КАК НакладныеРасходы,
	|	ВрТаб.СтоимостьСУчетомНакладныхРасходов КАК СтоимостьСУчетомНакладныхРасходов,
	|	ВрТаб.Ресурс КАК Ресурс,
	|	ВрТаб.СуммаНДС КАК СуммаНДС,
	|	ВрТаб.СуммаСНДС КАК СуммаСНДС,
	|	ВрТаб.Работа.СуммарнаяРабота КАК СуммарнаяРабота,
	|	ТИПЗНАЧЕНИЯ(ВрТаб.Работа) = ТИП(Справочник.УСОERP_СтроительныеРаботы) КАК ЭтоРабота,
	|	ВрТаб.Коэффициент КАК Коэффициент,
	|	ВрТаб.ЦенаЗаказчика КАК ЦенаЗаказчика,
	|	ВрТаб.ДобавленнаяСтоимость КАК ДобавленнаяСтоимость
	|ИЗ
	|	ВрТаб КАК ВрТаб";	
	
	Результат = Запрос.Выполнить();

	ДанныеДляДерева = Результат.Выгрузить();
	Справочник        = Справочники.УСОERP_СтроительныеРаботы;
	ЗначениеДеревоРабот = УСОERP_ОбработкаТабличныхЧастей.УСОERP_ПодготовитьДанныеИСформироватьДеревоСВосстановлениемСтруктуры(ДанныеДляДерева,"Работа","РаботаРодитель",,Справочник);
	ЗначениеВРеквизитФормы(ЗначениеДеревоРабот, "ДеревоРабот");
	
	РассчитатьИтогПоОбъекту();		
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьИтогПоОбъекту()
	
	СуммаВсегоПоОбъекту = 0;
	ИтогЦенаЗаказчика = 0;
	ИтогДобавленнаяСтоимость = 0;
	
	Для Каждого СтрокаДерева Из ДеревоРабот.ПолучитьЭлементы() Цикл
		СуммаВсегоПоОбъекту = СуммаВсегоПоОбъекту + ?(Объект.УчитыватьНДС, СтрокаДерева.СуммаСНДС, СтрокаДерева.СтоимостьСУчетомНакладныхРасходов);
		ИтогЦенаЗаказчика = ИтогЦенаЗаказчика+СтрокаДерева.ЦенаЗаказчика;
		ИтогДобавленнаяСтоимость = ИтогДобавленнаяСтоимость+СтрокаДерева.ДобавленнаяСтоимость;
	Конеццикла;  
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьБюджетПроектаСУчетомНДС()
	
	ТекПроцентНДС = ?(Объект.УчитыватьНДС,Объект.СтавкаНДС,Перечисления.СтавкиНДС.БезНДС);
	
	мДеревоРабот = РеквизитФормыВЗначение("ДеревоРабот", Тип("ДеревоЗначений"));
	ПересчитатьСуммыНДС(ТекПроцентНДС, мДеревоРабот);
	ЗначениеВРеквизитФормы(мДеревоРабот, "ДеревоРабот");
	РассчитатьИтогПоОбъекту();
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммыНДС(ТекПроцентНДС, СтрокаДереваРабот)
	
	Для Каждого СтрокаДерева Из СтрокаДереваРабот.Строки Цикл
		СтрокаДерева.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СтрокаДерева.СтоимостьСУчетомНакладныхРасходов, ТекПроцентНДС,Ложь);
		СтрокаДерева.СуммаСНДС = СтрокаДерева.СтоимостьСУчетомНакладныхРасходов +  СтрокаДерева.СуммаНДС;
		
		ПересчитатьСуммыНДС(ТекПроцентНДС, СтрокаДерева);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСтоимостьМатериаловНаСервере(ИдентификаторСтроки)
	
	ТекущиеДанные = Объект.СтоимостьМатериалов.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.Сумма = Окр(ТекущиеДанные.Количество * ТекущиеДанные.Цена, 2);
		
	РассчитатьИтогиПоМатериаламИРесурсам(ТекущиеДанные.Работа);
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСтоимостьРесурсовНаСервере(ИдентификаторСтроки)
	
	ТекущиеДанные = Объект.СтоимостьРесурсов.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.Сумма = Окр(ТекущиеДанные.ОбъемРабот * ТекущиеДанные.БазоваяЦена, 2);
	
	РассчитатьИтогиПоМатериаламИРесурсам(ТекущиеДанные.Работа);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьБазовуюСтоимостьРаботы(ИдентификаторСтроки)
	
	ТекущиеДанныеПоРаботе = ДеревоРабот.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	БазоваяСтоимость = 0;

	СтрокиМатериалов = Объект.СтоимостьМатериалов.НайтиСтроки(Новый Структура("Работа", ТекущиеДанныеПоРаботе.Работа));
	Для Каждого СтрокаМатериал Из СтрокиМатериалов Цикл
		БазоваяСтоимость = БазоваяСтоимость + СтрокаМатериал.Сумма;
	КонецЦикла;
	
	СтрокиРесурсов = Объект.СтоимостьРесурсов.НайтиСтроки(Новый Структура("Работа", ТекущиеДанныеПоРаботе.Работа));
	Для Каждого СтрокаРесурс Из СтрокиРесурсов Цикл
		БазоваяСтоимость = БазоваяСтоимость + СтрокаРесурс.Сумма;
	КонецЦикла;
	
	ТекущиеДанныеПоРаботе.БазоваяСтоимость = БазоваяСтоимость;
	
	РодительСтроки = ТекущиеДанныеПоРаботе.ПолучитьРодителя();
	Пока РодительСтроки <> неопределено Цикл
		БазоваяСтоимостьПодИтог = 0;
		Для Каждого СтрРабота Из РодительСтроки.ПолучитьЭлементы() Цикл
			БазоваяСтоимостьПодИтог = БазоваяСтоимостьПодИтог + СтрРабота.БазоваяСтоимость;
		КонецЦикла;
		РодительСтроки.БазоваяСтоимость = БазоваяСтоимостьПодИтог;
		
		РодительСтроки = РодительСтроки.ПолучитьРодителя();
	КонецЦикла;
	
	СтрокиДереваРабот = ДеревоРабот.ПолучитьЭлементы();
	ОбнулитьНакладныеРасходыПоДеревуРабот(СтрокиДереваРабот);
	
	СуммаВсегоПоОбъекту = 0;
	
	Для Каждого СтрокаДерева Из СтрокиДереваРабот Цикл
		СуммаВсегоПоОбъекту = СуммаВсегоПоОбъекту + ?(Объект.УчитыватьНДС, СтрокаДерева.СуммаСНДС, СтрокаДерева.СтоимостьСУчетомНакладныхРасходов);
	Конеццикла; 	

КонецПроцедуры

&НаКлиенте
Процедура ОбнулитьНакладныеРасходыПоДеревуРабот(СтрокиДерева)	
		
	ТекПроцентНДС = ?(Объект.УчитыватьНДС,Объект.СтавкаНДС,ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС"));

	Для Каждого СтрокаРабота Из СтрокиДерева Цикл
		СтрокаРабота.НакладныеРасходы = 0;
		СтрокаРабота.СтоимостьСУчетомНакладныхРасходов = СтрокаРабота.БазоваяСтоимость;
		Если Объект.УчитыватьНДС Тогда
			СтрокаРабота.СуммаНДС  = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СтрокаРабота.СтоимостьСУчетомНакладныхРасходов, ТекПроцентНДС,Ложь);
			СтрокаРабота.СуммаСНДС = СтрокаРабота.СтоимостьСУчетомНакладныхРасходов +  СтрокаРабота.СуммаНДС;			
		КонецЕсли;

		ОбнулитьНакладныеРасходыПоДеревуРабот(СтрокаРабота.ПолучитьЭлементы());
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФинансированиеНаСервере()
	
	Запрос = Новый Запрос;
	
	Если НовыйВариант Тогда
		
		Запрос.УстановитьПараметр("ДокументУтверждения",Объект.ДокументОснование);
		Запрос.УстановитьПараметр("РазделительнаяВедомость",Объект.РазделительнаяВедомость);
		
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаРабот.Организация,
	|	ТаблицаРабот.ОбъектСтроительства,
	|	ЕСТЬNULL(ТаблицаРабот.Работа, ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)) КАК Работа
	|ПОМЕСТИТЬ ВТ_РаботыДокумента
	|ИЗ
	|	&ТаблицаРабот КАК ТаблицаРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_РазделительнаяВедомостьРаботы.ОбъектСтроительства,
	|	ВТ_РаботыДокумента.Работа,
	|	УСОERP_РазделительнаяВедомостьРаботы.ЕдиницаОбъема,
	|	УСОERP_РазделительнаяВедомостьРаботы.Контрагент,
	|	УСОERP_РазделительнаяВедомостьРаботы.ОбъемСубподряда
	|ИЗ
	|	РегистрСведений.УСОERP_РазделительнаяВедомостьРаботы КАК УСОERP_РазделительнаяВедомостьРаботы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РаботыДокумента КАК ВТ_РаботыДокумента
