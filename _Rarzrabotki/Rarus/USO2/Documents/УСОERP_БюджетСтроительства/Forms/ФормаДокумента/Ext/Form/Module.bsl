&НаСервере
Процедура СформироватьТаблицуСобственныхРабот(ТаблицаРабот, ТаблицаПодразделений, ТЗ_РаботыСобств, ТЗ_Материалы, ТЗ_Ресурсы, ТЗ_СтатьиБюджета, ТЗ_ГрафикиОплаты, ТаблицаРаботКонтрагентов, ТаблицаРаботПодразделений)
	
	Для Каждого СтрПодразделение  Из ТаблицаПодразделений Цикл
		
		Если Не ЗначениеЗаполнено(СтрПодразделение.Подразделение) Тогда
			Продолжить;
		КонецЕсли;
		
		РаботыПодразделений = ТЗ_РаботыСобств.Скопировать(Новый Структура("Подразделение", СтрПодразделение.Подразделение));
		
		Для Каждого СтрокаРабота Из РаботыПодразделений Цикл
			
			МассивРабот = ТаблицаРабот.НайтиСтроки(Новый Структура("Работа", СтрокаРабота.Работа));
			
			Если МассивРабот.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтоимостьРаботы = МассивРабот[0].СтоимостьРаботы;
			
			//материалы
			ТаблицаМатериаловРаботы = ТЗ_Материалы.Скопировать(Новый Структура("Работа", СтрокаРабота.Работа));
			
			Для Каждого СтрокаМатериал Из ТаблицаМатериаловРаботы Цикл
				
