					Если МассивСтатейРасходов.Количество() = 0 Тогда
						Продолжить;
					КонецЕсли;
					
					Для Каждого СтрСтатьяРасхода Из МассивСтатейРасходов Цикл					
						
						НоваяСтрока = ТаблицаРаботПодразделений.Добавить();
						НоваяСтрока.Работа = СтрокаРабота.Работа;
						НоваяСтрока.КодСДР = СтрокаРабота.Работа.КодСДР;
						НоваяСтрока.СтатьяРасходов = СтрСтатьяРасхода.СтатьяРасходов;
						НоваяСтрока.СтоимостьРаботы = Окр(СтрСтатьяРасхода.БазоваяЦена * Окр(СтрокаРесурс.КоличествоСобственное *СтрСтатьяРасхода.ОбъемРабот/(СтрокаРесурс.КоличествоСобственное + СтрокаРесурс.КоличествоСубподряда),2),2);
						СтоимостьРаботы = СтоимостьРаботы - НоваяСтрока.СтоимостьРаботы;
						
