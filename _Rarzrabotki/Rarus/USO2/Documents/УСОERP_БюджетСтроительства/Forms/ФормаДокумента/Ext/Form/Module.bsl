		СписокКнопок.Добавить(КодВозвратаДиалога.Нет);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьАктированиеЗавершение", ЭтотОбъект,);
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, СписокКнопок);
		
	Иначе
		
		ЗаполнитьАктированиеЗавершение(КодВозвратаДиалога.Да,Новый Структура);

		
