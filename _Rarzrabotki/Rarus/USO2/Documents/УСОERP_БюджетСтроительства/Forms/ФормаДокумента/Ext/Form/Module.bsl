&НаСервере
Процедура ДокументОснованиеПриИзмененииНаСервере()
	
	Объект.СценарийПланирования = Объект.ДокументОснование.СценарийПланирования;
	//Объект.НаправлениеДеятельности = ?(ЗначениеЗаполнено(Объект.ДокументОснование.НаправлениеДеятельности),Объект.ДокументОснование.НаправлениеДеятельности,Объект.ОбъектСтроительства.ОбъектСтроительства.НаправлениеДеятельности);
	НовыйВариант = Объект.ДокументОснование.СценарийПланирования.НовыйВариант = Истина;
	Объект.НаправлениеДеятельности = Объект.ДокументОснование.НаправлениеДеятельности;
	
	Запрос = Новый Запрос;
	
	Объект.РазделительнаяВедомость = "";
	Запрос.УстановитьПараметр("ДокументУтверждения",Объект.ДокументОснование);
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	Запрос.УстановитьПараметр("ОбъектСтроительства",Объект.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Статус",Перечисления.СтатусыПланов.Утвержден);
	Запрос.УстановитьПараметр("НовыйВариант",Объект.ДокументОснование.СценарийПланирования.НовыйВариант = Истина);
	Запрос.УстановитьПараметр("Дата",Объект.Дата);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_РазделительнаяВедомость.Ссылка,
	|	УСОERP_РазделительнаяВедомость.Дата КАК Дата
	|ИЗ
	|	Документ.УСОERP_РазделительнаяВедомость КАК УСОERP_РазделительнаяВедомость
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &НовыйВариант
	|				ТОГДА УСОERP_РазделительнаяВедомость.ДокументУтверждения = &ДокументУтверждения
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И УСОERP_РазделительнаяВедомость.Организация = &Организация
	|	И УСОERP_РазделительнаяВедомость.ОбъектСтроительства = &ОбъектСтроительства
	|	И УСОERP_РазделительнаяВедомость.Статус = &Статус
	|	И УСОERP_РазделительнаяВедомость.Проведен
	|	И УСОERP_РазделительнаяВедомость.Дата <= &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Объект.РазделительнаяВедомость = Выборка.Ссылка;
	КонецЕсли;  	
	
	УстановитьСвязиПараметровВыбора();	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвязиПараметровВыбора()
	
	МассивПВ = Новый Массив;
	ЭлементПВ = Новый СвязьПараметраВыбора("Отбор.ОбъектСтроительства","Объект.ОбъектСтроительства");
	МассивПВ.Добавить(ЭлементПВ);
	
	ЭлементПВ = Новый СвязьПараметраВыбора("Отбор.Организация","Объект.Организация");
	
	МассивПВ.Добавить(ЭлементПВ);
	
	Если  Объект.ДокументОснование.СценарийПланирования.НовыйВариант = Истина Тогда
		
		ЭлементПВ = Новый СвязьПараметраВыбора("Отбор.ДокументУтверждения","Объект.ДокументОснование");
		
		МассивПВ.Добавить(ЭлементПВ);
		
		
	КонецЕсли;
	
	Элементы.РазделительнаяВедомость.СвязиПараметровВыбора = Новый ФиксированныйМассив(МассивПВ);
	
КонецПроцедуры

