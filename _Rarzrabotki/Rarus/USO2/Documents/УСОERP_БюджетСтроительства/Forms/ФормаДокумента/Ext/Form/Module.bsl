	Запрос.УстановитьПараметр("ОбъектСтроительства", Объект.ОбъектСтроительства);
	Запрос.УстановитьПараметр("ТаблицаРабот", ТаблицаРабот);
	
	Запрос.УстановитьПараметр("РазделительнаяВедомость",Объект.РазделительнаяВедомость);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТЗ_РаботыКонтрагентов = Результат[1].Выгрузить();
	ТЗ_РаботыСобств 	  = Результат[2].Выгрузить();
	ТЗ_Материалы 		  = Результат[3].Выгрузить();
	ТЗ_Ресурсы 			  = Результат[4].Выгрузить();
	ТЗ_ГрафикиОплаты 	  = Результат[8].Выгрузить();
	ТЗ_СтатьиБюджета 	  = Результат[12].Выгрузить();
	ТЗ_ДоговораСубподряда = Результат[13].Выгрузить();
	
	ТаблицаКонтрагентов = ТЗ_РаботыКонтрагентов.Скопировать();
	ТаблицаКонтрагентов.СВернуть("Контрагент");
	
	ТаблицаПодразделений = ТЗ_РаботыСобств.Скопировать();
	ТаблицаПодразделений.СВернуть("Подразделение");
	
	ТаблицаРаботКонтрагентов = Новый ТаблицаЗначений;
	ТаблицаРаботКонтрагентов.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаРаботКонтрагентов.Колонки.Добавить("Работа", Новый ОписаниеТипов("СправочникСсылка.УСОERP_СтроительныеРаботы"));
	ТаблицаРаботКонтрагентов.Колонки.Добавить("КодСДР", Новый ОписаниеТипов("Строка"));
	ТаблицаРаботКонтрагентов.Колонки.Добавить("СтатьяБюджета", Новый ОписаниеТипов("СправочникСсылка.СтатьиБюджетов"));
	ТаблицаРаботКонтрагентов.Колонки.Добавить("СтатьяРасходов", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.СтатьиРасходов"));
	ТаблицаРаботКонтрагентов.Колонки.Добавить("ГрафикФинансирования", Новый ОписаниеТипов("СправочникСсылка.УСОERP_ГрафикиАктированияФинансирования"));
	ТаблицаРаботКонтрагентов.Колонки.Добавить("СтоимостьРаботы", Новый ОписаниеТипов("Число"));

	ТаблицаРаботПодразделений = Новый ТаблицаЗначений;
	ТаблицаРаботПодразделений.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ТаблицаРаботПодразделений.Колонки.Добавить("Работа", Новый ОписаниеТипов("СправочникСсылка.УСОERP_СтроительныеРаботы"));
	ТаблицаРаботПодразделений.Колонки.Добавить("КодСДР", Новый ОписаниеТипов("Строка"));
	ТаблицаРаботПодразделений.Колонки.Добавить("СтатьяБюджета", Новый ОписаниеТипов("СправочникСсылка.СтатьиБюджетов"));
	ТаблицаРаботПодразделений.Колонки.Добавить("СтатьяРасходов", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.СтатьиРасходов"));
	ТаблицаРаботПодразделений.Колонки.Добавить("ГрафикФинансирования", Новый ОписаниеТипов("СправочникСсылка.УСОERP_ГрафикиАктированияФинансирования"));
	ТаблицаРаботПодразделений.Колонки.Добавить("СтоимостьРаботы", Новый ОписаниеТипов("Число"));
	
	мДеревоФинансирование = РеквизитФормыВЗначение("ДеревоФинансирование");
	мДеревоФинансирование.Строки.Очистить();
	СтрокаДереваКонтрагенты = мДеревоФинансирование.Строки.Добавить();
	СтрокаДереваКонтрагенты.ИсполнительРабота = "Подрядчики";
	СтрокаДереваКонтрагенты.ВыделятьКурсивом = Истина;
	
	СтрокаДереваПодразделения = мДеревоФинансирование.Строки.Добавить();
	СтрокаДереваПодразделения.ИсполнительРабота = "Подразделения";
	СтрокаДереваПодразделения.ВыделятьКурсивом = Истина;

	СформироватьТаблицуРаботКонтрагента(ТаблицаРабот, ТаблицаКонтрагентов, ТЗ_РаботыКонтрагентов, ТЗ_Материалы, ТЗ_Ресурсы, ТЗ_СтатьиБюджета, ТЗ_ГрафикиОплаты, ТаблицаРаботКонтрагентов, ТаблицаРаботПодразделений);
	СформироватьТаблицуСобственныхРабот(ТаблицаРабот, ТаблицаПодразделений, ТЗ_РаботыСобств, ТЗ_Материалы, ТЗ_Ресурсы, ТЗ_СтатьиБюджета, ТЗ_ГрафикиОплаты, ТаблицаРаботКонтрагентов, ТаблицаРаботПодразделений);
	
	мДеревоФинансирование = РеквизитФормыВЗначение("ДеревоФинансирование");
	мДеревоФинансирование.Строки.Очистить();

	ДанныеДляДерева = Новый ДеревоЗначений;
		
	ДанныеДляДерева.Колонки.Добавить("КодСДР",                 Новый ОписаниеТипов("Строка"));		
	ДанныеДляДерева.Колонки.Добавить("НомерРаботыВУровне",     Новый ОписаниеТипов("Число"));		

	Для каждого Колонка Из мДеревоФинансирование.Колонки Цикл
		Если ДанныеДляДерева.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			ДанныеДляДерева.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
		КонецЕсли; 
	КонецЦикла; 		
	
	СтрокаДереваКонтрагенты = ДанныеДляДерева.Строки.Добавить();
	СтрокаДереваКонтрагенты.ИсполнительРабота = "Подрядчики";
	СтрокаДереваКонтрагенты.ВыделятьКурсивом = Истина;
	
	Для Каждого СтрокаКонтрагент Из ТаблицаКонтрагентов Цикл
		
		РаботыТекущегоКонтрагента = ТаблицаРаботКонтрагентов.Скопировать(Новый Структура("Контрагент", СтрокаКонтрагент.Контрагент));
		
		Если РаботыТекущегоКонтрагента.Количество()= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаКонтрагент = СтрокаДереваКонтрагенты.Строки.Добавить();
		НоваяСтрокаКонтрагент.Контрагент = СтрокаКонтрагент.Контрагент;
		НоваяСтрокаКонтрагент.ИсполнительРабота = СтрокаКонтрагент.Контрагент;
		НоваяСтрокаКонтрагент.ГруппировкаПоИсполнителям = Истина;
		
		РаботыТекущегоКонтрагента.Колонки.Добавить("КодСДРЧисло", Новый ОписаниеТипов("Число"));
		Для Каждого СтрокаТЗ Из РаботыТекущегоКонтрагента Цикл
			СтрокаТЗ.КодСДРЧисло = УСОERP_ОбработкаТабличныхЧастей.КодСДРвЧисло(СтрокаТЗ.КодСДР);
		КонецЦикла;
				
		РаботыТекущегоКонтрагента.Свернуть("Работа, КодСДР, КодСДРЧисло, СтатьяБюджета, СтатьяРасходов, ГрафикФинансирования", "СтоимостьРаботы");
		РаботыТекущегоКонтрагента.Сортировать("КодСДРЧисло Иерархия");
		
		СтоимостьВнешняяПоКонтрагенту = 0;
		
		Для Каждого СтрокаРабота Из РаботыТекущегоКонтрагента Цикл
			
			МассивРабот = ТаблицаРабот.НайтиСтроки(Новый Структура("Работа", СтрокаРабота.Работа));
			НачалоРаботыПлан 	= МассивРабот[0].НачалоРаботыПлан;
			ОкончаниеРаботыПлан = МассивРабот[0].ОкончаниеРаботыПлан;
			ДлительностьПлан 	= МассивРабот[0].ДлительностьПлан;
			ЕдиницаДлительности = МассивРабот[0].ЕдиницаДлительности;

			НоваяСтрокаРабота = НоваяСтрокаКонтрагент.Строки.Добавить();
			НоваяСтрокаРабота.Работа = СтрокаРабота.Работа;
			НоваяСтрокаРабота.СтатьяБюджета = СтрокаРабота.СтатьяБюджета;
			НоваяСтрокаРабота.СтатьяРасходов = СтрокаРабота.СтатьяРасходов;
			НоваяСтрокаРабота.Контрагент = СтрокаКонтрагент.Контрагент;
			НоваяСтрокаРабота.ИсполнительРабота = СтрокаРабота.Работа;
			НоваяСтрокаРабота.СтоимостьРаботы = СтрокаРабота.СтоимостьРаботы;
			НоваяСтрокаРабота.ГрафикФинансирования = СтрокаРабота.ГрафикФинансирования;
			НоваяСтрокаРабота.НачалоРаботыПлан = НачалоРаботыПлан;
			НоваяСтрокаРабота.ОкончаниеРаботыПлан = ОкончаниеРаботыПлан;
			НоваяСтрокаРабота.ДлительностьПлан = ДлительностьПлан;
			НоваяСтрокаРабота.ЕдиницаДлительности = ЕдиницаДлительности;
			НоваяСтрокаРабота.ЭтоРабота = Истина;
						
			//проверка на наличие договоров субподряда
			СтрокиСубподряда = ТЗ_ДоговораСубподряда.Скопировать(Новый Структура("Контрагент, Работа", СтрокаКонтрагент.Контрагент, СтрокаРабота.Работа));
			Если СтрокиСубподряда.Количество()<>0 Тогда
				НоваяСтрокаРабота.ЗаключенДоговор = Истина;
				НоваяСтрокаРабота.СтоимостьВнешняя = СтрокиСубподряда.Итог("СуммаСНДС");
			Иначе
				СтрокиАктирования = мДеревоАктирование.Строки.НайтиСтроки(Новый Структура("Работа, ЭтоРабота", НоваяСтрокаРабота.Работа, Истина), истина);
				Если СтрокиАктирования.Количество()>0 Тогда
					НоваяСтрокаРабота.СтоимостьВнешняя = СтрокиАктирования[0].СтоимостьВнешняя;
				КонецЕсли;
				
			КонецЕсли;
			
			СтоимостьВнешняяПоКонтрагенту = СтоимостьВнешняяПоКонтрагенту + НоваяСтрокаРабота.СтоимостьВнешняя;
					
		КонецЦикла;
		
	КонецЦикла;

	мПодразделения = ТаблицаРаботПодразделений.Скопировать();
	мПодразделения.Свернуть("Подразделение");
	мПодразделения.Сортировать("Подразделение");
	
	СтрокаДереваПодразделения = ДанныеДляДерева.Строки.Добавить();
	СтрокаДереваПодразделения.ИсполнительРабота = "Подразделения";
	СтрокаДереваПодразделения.ВыделятьКурсивом = Истина;
		
	ОбщаяСтоимость = 0;
	ОбщаяСтоимостьВнешняя = 0;
	
	Для Каждого СтрокаПодразделение Из мПодразделения Цикл
		
		РаботыТекущегоПодразделения = ТаблицаРаботПодразделений.Скопировать(Новый Структура("Подразделение", СтрокаПодразделение.Подразделение));
		
		Если РаботыТекущегоПодразделения.Количество()= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаПодразделение = СтрокаДереваПодразделения.Строки.Добавить();
		НоваяСтрокаПодразделение.Подразделение = СтрокаПодразделение.Подразделение;
		НоваяСтрокаПодразделение.ИсполнительРабота = СтрокаПодразделение.Подразделение;
		НоваяСтрокаПодразделение.ГруппировкаПоИсполнителям = Истина;
				
		РаботыТекущегоПодразделения.Колонки.Добавить("КодСДРЧисло", Новый ОписаниеТипов("Число"));
		
		Для Каждого СтрокаТЗ Из РаботыТекущегоПодразделения Цикл
			СтрокаТЗ.КодСДРЧисло = УСОERP_ОбработкаТабличныхЧастей.КодСДРвЧисло(СтрокаТЗ.КодСДР);
		КонецЦикла;
		
		РаботыТекущегоПодразделения.Свернуть("Работа, КодСДР, КодСДРЧисло, СтатьяБюджета, СтатьяРасходов, ГрафикФинансирования", "СтоимостьРаботы");
		РаботыТекущегоПодразделения.Сортировать("КодСДРЧисло Иерархия");
		
		Для Каждого СтрокаРабота Из РаботыТекущегоПодразделения Цикл
			
			МассивРабот = ТаблицаРабот.НайтиСтроки(Новый Структура("Работа", СтрокаРабота.Работа));
			НачалоРаботыПлан 	= МассивРабот[0].НачалоРаботыПлан;
			ОкончаниеРаботыПлан = МассивРабот[0].ОкончаниеРаботыПлан;
			ДлительностьПлан 	= МассивРабот[0].ДлительностьПлан;
			ЕдиницаДлительности = МассивРабот[0].ЕдиницаДлительности;

			НоваяСтрокаРабота = НоваяСтрокаПодразделение.Строки.Добавить();
			НоваяСтрокаРабота.Работа = СтрокаРабота.Работа;
			НоваяСтрокаРабота.СтатьяБюджета = СтрокаРабота.СтатьяБюджета;
			НоваяСтрокаРабота.СтатьяРасходов = СтрокаРабота.СтатьяРасходов;
			НоваяСтрокаРабота.Подразделение = СтрокаПодразделение.Подразделение;
			НоваяСтрокаРабота.ИсполнительРабота = СтрокаРабота.Работа;
			НоваяСтрокаРабота.СтоимостьРаботы = СтрокаРабота.СтоимостьРаботы;
			НоваяСтрокаРабота.СтоимостьВнешняя = СтрокаРабота.СтоимостьРаботы;
			
			НоваяСтрокаРабота.НачалоРаботыПлан = НачалоРаботыПлан;
			НоваяСтрокаРабота.ОкончаниеРаботыПлан = ОкончаниеРаботыПлан;
			НоваяСтрокаРабота.ДлительностьПлан = ДлительностьПлан;
			НоваяСтрокаРабота.ЕдиницаДлительности = ЕдиницаДлительности;
			НоваяСтрокаРабота.ЭтоРабота = Истина;
			
			НоваяСтрокаРабота.ГрафикФинансирования = СтрокаРабота.ГрафикФинансирования;
			
			КонецЦикла;
			
		КонецЦикла;

	Для каждого СтрокаДереваПодразделения Из ДанныеДляДерева.Строки Цикл // ур.1
		
		Для каждого НоваяСтрокаПодразделение  Из СтрокаДереваПодразделения.Строки Цикл // ур. 2
			
			НоваяСтрокаПодразделение.СтоимостьРаботы 					= НоваяСтрокаПодразделение.Строки.Итог("СтоимостьРаботы");
			НоваяСтрокаПодразделение.СтоимостьВнешняя 				 	= НоваяСтрокаПодразделение.Строки.Итог("СтоимостьВнешняя");
			НоваяСтрокаПодразделение.СуммаАванс 						= НоваяСтрокаПодразделение.Строки.Итог("СуммаАванс");
			НоваяСтрокаПодразделение.СуммаОстатокПлатежа 				= НоваяСтрокаПодразделение.Строки.Итог("СуммаОстатокПлатежа");
			НоваяСтрокаПодразделение.СуммаВозвратГарантийногоУдержания  = НоваяСтрокаПодразделение.Строки.Итог("СуммаВозвратГарантийногоУдержания");
			
		КонецЦикла; 	
		
		СтрокаДереваПодразделения.СтоимостьРаботы 				  	= СтрокаДереваПодразделения.Строки.Итог("СтоимостьРаботы");
		СтрокаДереваПодразделения.СтоимостьВнешняя 				  	= СтрокаДереваПодразделения.Строки.Итог("СтоимостьВнешняя");
		СтрокаДереваПодразделения.СуммаАванс 						= СтрокаДереваПодразделения.Строки.Итог("СуммаАванс");
		СтрокаДереваПодразделения.СуммаОстатокПлатежа 			  	= СтрокаДереваПодразделения.Строки.Итог("СуммаОстатокПлатежа");
		СтрокаДереваПодразделения.СуммаВозвратГарантийногоУдержания = СтрокаДереваПодразделения.Строки.Итог("СуммаВозвратГарантийногоУдержания");
		
	КонецЦикла; 													
	
	ЗначениеВРеквизитФормы(ДанныеДляДерева, "ДеревоФинансирование");
	
КонецПроцедуры

&НаСервере
Процедура СформироватьТаблицуРаботКонтрагента(ТаблицаРабот, ТаблицаКонтрагентов, ТЗ_РаботыКонтрагентов, ТЗ_Материалы, ТЗ_Ресурсы, ТЗ_СтатьиБюджета, ТЗ_ГрафикиОплаты, ТаблицаРаботКонтрагентов, ТаблицаРаботПодразделений)
	
	Для Каждого СтрКонтрагент  Из ТаблицаКонтрагентов Цикл
		
		Если Не ЗначениеЗаполнено(СтрКонтрагент.Контрагент) Тогда
			Продолжить;
		КонецЕсли;
		
		РаботыКонтрагента = ТЗ_РаботыКонтрагентов.Скопировать(Новый Структура("Контрагент", СтрКонтрагент.Контрагент));
		
		Для Каждого СтрокаРабота Из РаботыКонтрагента Цикл
			
			МассивРабот = ТаблицаРабот.НайтиСтроки(Новый Структура("Работа", СтрокаРабота.Работа));
			
			Если МассивРабот.Количество() = 0 Тогда
				Продолжить;
			КОнецЕсли;
			
			СтоимостьРаботы 	= МассивРабот[0].СтоимостьРаботы;
						
			//материалы
			ТаблицаМатериаловРаботы = ТЗ_Материалы.Скопировать(Новый Структура("Работа", СтрокаРабота.Работа));
			
			Для Каждого СтрокаМатериал Из ТаблицаМатериаловРаботы Цикл
				
				Если  СтрокаМатериал.КоличествоСобственное <> 0 Тогда
					
					МассивСтатейРасходов = Объект.СтоимостьМатериалов.НайтиСтроки(Новый Структура("Работа, Номенклатура, Характеристика", СтрокаРабота.Работа, СТрокаМатериал.Номенклатура, СтрокаМатериал.Характеристика));
					
					Если МассивСтатейРасходов.Количество() = 0 Тогда
						Продолжить;
					КонецЕсли;
					СтатьяРасходов = МассивСтатейРасходов[0].СтатьяРасходов;  				
					
					НоваяСтрока = ТаблицаРаботПодразделений.Добавить();
					НоваяСтрока.Работа = СтрокаРабота.Работа;
					НоваяСтрока.КодСДР = СтрокаРабота.Работа.КодСДР;
					НоваяСтрока.СтатьяРасходов = СтатьяРасходов;
					НоваяСтрока.СтоимостьРаботы = Окр(МассивСтатейРасходов[0].Цена * СтрокаМатериал.КоличествоСобственное,2);
