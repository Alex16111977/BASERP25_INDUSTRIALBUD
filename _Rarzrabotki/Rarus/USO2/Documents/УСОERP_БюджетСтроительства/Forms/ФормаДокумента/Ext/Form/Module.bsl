						НоваяСтрока.СтатьяБюджета = МассивСтатейБюджета[0].Статьябюджета;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
			//ресурсы
			ТаблицаРесурсовРаботы = ТЗ_Ресурсы.Скопировать(Новый Структура("Работа", СтрокаРабота.Работа));
			
			Для Каждого СтрокаРесурс Из ТаблицаРесурсовРаботы Цикл
				
				Если  СтрокаРесурс.КоличествоСобственное <> 0 Тогда
					
					МассивСтатейРасходов = Объект.СтоимостьРесурсов.НайтиСтроки(Новый Структура("Работа, Ресурс", СтрокаРабота.Работа, СтрокаРесурс.Ресурс));
					
					Если МассивСтатейРасходов.Количество() = 0 Тогда
						Продолжить;
					КонецЕсли;
					
					Для Каждого СтрСтатьяРасхода Из МассивСтатейРасходов Цикл					
						
						НоваяСтрока = ТаблицаРаботПодразделений.Добавить();
						НоваяСтрока.Работа = СтрокаРабота.Работа;
						НоваяСтрока.КодСДР = СтрокаРабота.Работа.КодСДР;
						НоваяСтрока.Подразделение = СтрокаРабота.Подразделение;
						НоваяСтрока.СтатьяРасходов = СтрСтатьяРасхода.СтатьяРасходов;
						
						МассивГрафиковОплаты = ТЗ_ГрафикиОплаты.НайтиСтроки(Новый Структура("Работа", СтрокаРабота.Работа));
						
						Если МассивГрафиковОплаты.Количество()<>0 Тогда
							
							Если ТипЗнч(СтрСтатьяРасхода.ОбъектРасценки) = Тип("СправочникСсылка.Должности") Тогда
								НоваяСтрока.ГрафикФинансирования = МассивГрафиковОплаты[0].ГрафикФинансированияТруд;
							Иначе
								НоваяСтрока.ГрафикФинансирования = МассивГрафиковОплаты[0].ГрафикФинансированияТехника;
							КонецЕсли;
							
						КонецЕсли;

						НоваяСтрока.СтоимостьРаботы = Окр(СтрСтатьяРасхода.БазоваяЦена * Окр(СтрокаРесурс.КоличествоСобственное *СтрСтатьяРасхода.ОбъемРабот/(СтрокаРесурс.КоличествоСобственное + СтрокаРесурс.КоличествоСубподряда),2),2);
						СтоимостьРаботы = СтоимостьРаботы - НоваяСтрока.СтоимостьРаботы;
						
						МассивСтатейБюджета =  ТЗ_СтатьиБюджета.НайтиСтроки(Новый Структура("Работа, СтатьяРасходов", СтрокаРабота.Работа, СтрСтатьяРасхода.СтатьяРасходов));
						Если МассивСтатейБюджета.Количество()>0 Тогда
							НоваяСтрока.СтатьяБюджета = МассивСтатейБюджета[0].Статьябюджета;
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;
						
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФинансированиеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Ответ = РезультатВопроса;
    Если Ответ <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
    
    ЗаполнитьФинансированиеНаСервере();
	РазвернутьДеревоФинансированияНаКлиенте();
	
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАктированиеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Ответ = РезультатВопроса;
    Если Ответ <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
    
    ЗаполнитьАктированиеНаСервере();
	РазвернутьДеревоАктирование();
	
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура СформироватьТаблицуРабот(СтрокаДереваРабот, ТаблицаРабот)
	
	Для Каждого СтрокаРабота из СтрокаДереваРабот.Строки Цикл
		
		НоваяСтрока = ТаблицаРабот.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРабота);
		НоваяСтрока.НачалоРаботыПлан = СтрокаРабота.НачалоРаботы;
		НоваяСтрока.ОкончаниеРаботыПлан = СтрокаРабота.ОкончаниеРаботы;
		НоваяСтрока.ДлительностьПлан = СтрокаРабота.Длительность;
		
		НоваяСтрока.ОбъектСтроительства = Объект.ОбъектСтроительства;
		НоваяСтрока.Организация = Объект.Организация;
		НоваяСтрока.СтоимостьРаботы = ?(Объект.УчитыватьНДС, СтрокаРабота.СуммаСНДС, СтрокаРабота.СтоимостьСУчетомНакладныхРасходов);
		СформироватьТаблицуРабот(СтрокаРабота, ТаблицаРабот);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоФинансированияНаКлиенте(мТекущаяСтрока = Неопределено)
	
	Если мТекущаяСтрока = Неопределено Тогда
		КоллекцияЭлементовДерева = ДеревоФинансирование.ПолучитьЭлементы();
	Иначе
		КоллекцияЭлементовДерева = мТекущаяСтрока.ПолучитьЭлементы();
	КонецЕсли;

	
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл
		
		ИдентификаторСтроки	= Строка.ПолучитьИдентификатор();
		Элементы.ДеревоФинансирование.Развернуть(ИдентификаторСтроки);
		
		Если Строка.ПолучитьЭлементы().количество()>0 Тогда
			РазвернутьДеревоФинансированияНаКлиенте(Строка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

