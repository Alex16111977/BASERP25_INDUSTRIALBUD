&НаКлиенте
Перем КэшированныеЗначения; //используется механизмом обработки изменения реквизитов ТЧ

&НаКлиенте
Перем ПредыдущиеРеквизитыСтроки; //используется для отвязки строки поступления от строки заказа

&НаКлиенте
Перем ТекущиеДанныеИдентификатор; //используется для передачи текущей строки в обработчик ожидания

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	// Обработчик подсистемы "Свойства"
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтаФорма, ДополнительныеПараметры);
		
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма); 	
		
	ЗаполнитьДеревоРаботПриСоздании();
	ЗаполнитьДеревоФинансированияПриСоздании();
	ЗаполнитьДеревоАктированиеПриСоздании();
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда  	
		ПриЧтенииСозданииНаСервере();               		
	КонецЕсли;	
	
	ТекущийОбъектСтроительства 	= Объект.ОбъектСтроительства;
	ТекущийСценарий 			= Объект.СценарийПланирования;
	ТекущийДокумент 			= Объект.ДокументОснование;
	ТекущаяОрганизация          = Объект.Организация;
	ТекущаяРазделительнаяВедомость = Объект.РазделительнаяВедомость;
	УстановитьСвязиПараметровВыбора();
	
	ОтображатьТипОбъектаРасценки = Ложь;
	Элементы.СтавкаНДС.Видимость = Объект.УчитыватьНДС;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ТолькоПросмотрФормы =  Объект.Статус = Перечисления.СтатусыПланов.Утвержден И Объект.Проведен;
	ЭтаФорма.ТолькоПросмотр = ТолькоПросмотрФормы;
	
	Элементы.РассчитатьСтоимостьОбъектаСтроительства.Доступность = НЕ ТолькоПросмотрФормы;
	Элементы.РаспределитьНакладныеРасходы.Доступность = НЕ ТолькоПросмотрФормы;
	Элементы.ДеревоРаботКомандаЗаполнитьСметнымиРасценками.Доступность = НЕ ТолькоПросмотрФормы;
	Элементы.ДеревоАктированиеДобавитьДатуАктирования.Доступность = НЕ ТолькоПросмотрФормы;
	Элементы.ДеревоАктированиеЗаполнитьАктирование.Доступность = НЕ ТолькоПросмотрФормы;
	Элементы.ДеревоАктированиеРассчитатьАктирование.Доступность = НЕ ТолькоПросмотрФормы;
	Элементы.ДеревоФинансированиеЗаполнитьСубподрядныеРаботы.Доступность = НЕ ТолькоПросмотрФормы;
	Элементы.ДеревоФинансированиеРассчитатьБюджетПоСубподряднымРаботам.Доступность = НЕ ТолькоПросмотрФормы;
	Элементы.ДеревоРаботОценкаСтоимостейКомандаЗаполнитьКоэффициент.Доступность = НЕ ТолькоПросмотрФормы;
	
	НовыйВариант = Объект.ДокументОснование.СценарийПланирования.НовыйВариант = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	РазвернутьНаКлиенте();	
	РазвернутьДеревоФинансированияНаКлиенте();
	РазвернутьДеревоАктирование();
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// Обработчик механизма "ДатыЗапретаИзменения"
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	ПриЧтенииСозданииНаСервере();
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 

	МодификацияКонфигурацииПереопределяемый.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
		
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СохранитьИзмененияБюджетаСтроительства(ТекущийОбъект);
	СохранитьФинансирование(ТекущийОбъект);
	СохранитьАктирование(ТекущийОбъект, Отказ, (ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение));
	
	// Обработчик подсистемы "Свойства"
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);

	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ТекущаяСтрока = Элементы.ДеревоРабот.ТекущиеДанные;
	Если НЕ ТекущаяСтрока = Неопределено  Тогда
		ТекущаяРабота = ТекущаяСтрока.Работа;
		РассчитатьИтогиПоМатериаламИРесурсам(ТекущаяРабота);
	КонецЕсли;	

	Оповестить("Запись_НазначениеИсполнителейРабот", ПараметрыЗаписи, Объект.Ссылка);

	МодификацияКонфигурацииКлиентПереопределяемый.ПослеЗаписи(ЭтаФорма, ПараметрыЗаписи);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	РассчитатьИтогПоОбъекту();
	
	НоменклатураСервер.ЗаполнитьПризнакИспользованияХарактеристик(Объект.СтоимостьМатериалов,);
	
	МодификацияКонфигурацииПереопределяемый.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОбъектСтроительстваПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ТекущийОбъектСтроительства)
		И ДеревоРабот.ПолучитьЭлементы().Количество() > 0
		И ТекущийОбъектСтроительства <> Объект.ОбъектСтроительства Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ОбъектСтроительстваПриИзмененииПродолжение",ЭтотОбъект),"Расценка объекта будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
		
	Иначе
		
		ОбъектСтроительстваПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектСтроительстваПриИзмененииПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		
		Объект.ОбъектСтроительства = ТекущийОбъектСтроительства;
		Объект.СценарийПланирования = ТекущийСценарий;
		Объект.ДокументОснование = ТекущийДокумент;
		Объект.Организация = ТекущаяОрганизация;
		Возврат;
		
	КонецЕсли;
	
	Если НЕ ТекущийОбъектСтроительства = Объект.ОбъектСтроительства
		Или ТекущаяОрганизация <> Объект.Организация  Тогда
		
		ДеревоРабот.ПолучитьЭлементы().Очистить();
		Объект.СтоимостьМатериалов.Очистить();
		Объект.СтоимостьРесурсов.Очистить();
		Объект.Расценка.Очистить();		
		//Объект.СценарийПланирования = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьРабочийСценарий(Объект.ОбъектСтроительства, Объект.Организация);
		Объект.ДокументОснование = ПредопределенноеЗначение("Документ.УСОERP_УтверждениеКалендарногоПланаГрафика.ПустаяСсылка");
		Объект.ДокументОснование = УСОERP_ЗащищенныеФункцииСервер.ПолучитьПоследнийДокументУтверждения(Объект.ОбъектСтроительства,Объект.Организация);
		ДокументОснованиеПриИзмененииНаСервере();
		
	КонецЕсли; 	
	
	ТекущийОбъектСтроительства 	= Объект.ОбъектСтроительства;
	ТекущийСценарий				= Объект.СценарийПланирования;
	ТекущийДокумент 			= Объект.ДокументОснование;
	ТекущаяОрганизация          = Объект.Организация;
	
КонецПроцедуры 

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ТекущийДокумент)
		И ДеревоРабот.ПолучитьЭлементы().Количество() > 0
		И ТекущийДокумент <> Объект.ДокументОснование Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ДокументОснованиеПриИзмененииПродолжение",ЭтотОбъект),"Расценка объекта будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
		
	Иначе
		
		ДокументОснованиеПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзмененииПродолжение(Ответ,ДопПараметры)Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Объект.ДокументОснование = ТекущийДокумент;
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекущийДокумент = Объект.ДокументОснование Тогда
		ДеревоРабот.ПолучитьЭлементы().Очистить();
		Объект.СтоимостьМатериалов.Очистить();
		Объект.СтоимостьРесурсов.Очистить();
		Объект.Расценка.Очистить(); 
	КонецЕсли;
	
	ДокументОснованиеПриИзмененииНаСервере(); 
	
	ТекущийОбъектСтроительства 	= Объект.ОбъектСтроительства;
	ТекущийСценарий				= Объект.СценарийПланирования;
	ТекущийДокумент 			= Объект.ДокументОснование; 
	ТекущаяРазделительнаяВедомость = Объект.РазделительнаяВедомость;
	
КонецПроцедуры    

&НаКлиенте
Процедура СценарийПланированияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ТекущийСценарий)
		И ДеревоРабот.ПолучитьЭлементы().Количество() > 0
		И ТекущийСценарий <> Объект.СценарийПланирования Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("СценарийПланированияПриИзмененииПродолжение",ЭтотОбъект),"Расценка объекта будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
		
	Иначе
		
		СценарийПланированияПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);	
		
	КонецЕсли;    	
	
КонецПроцедуры

&НаКлиенте
Процедура СценарийПланированияПриИзмененииПродолжение(Ответ,ДопПараметры)Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Объект.СценарийПланирования = ТекущийСценарий;
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекущийСценарий = Объект.СценарийПланирования Тогда
		
		ДеревоРабот.ПолучитьЭлементы().Очистить();	
		Объект.СтоимостьМатериалов.Очистить();
		Объект.СтоимостьРесурсов.Очистить();
		Объект.Расценка.Очистить();
		Объект.ДокументОснование = ПредопределенноеЗначение("Документ.УСОERP_УтверждениеКалендарногоПланаГрафика.ПустаяСсылка");

	КонецЕсли;
	
	ТекущийОбъектСтроительства 	= Объект.ОбъектСтроительства;
	ТекущийСценарий				= Объект.СценарийПланирования;
	ТекущийДокумент 			= Объект.ДокументОснование; 
	
КонецПроцедуры  

&НаКлиенте
Процедура УчитыватьНДСПриИзменении(Элемент)
	
	Элементы.СтавкаНДС.Видимость = Объект.УчитыватьНДС;
	
	ПересчитатьБюджетПроектаСУчетомНДС();
	ПересчитатьИтогиДереваНаКлиенте(Истина);
	РазвернутьНаКлиенте();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийДереваРабот

&НаКлиенте
Процедура ДеревоРаботПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.ДеревоРабот.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяРабота =  ТекущаяСтрока.Работа;

	Элементы.СтоимостьМатериалов.ОтборСтрок = Новый ФиксированнаяСтруктура("Работа", ТекущаяРабота); 
	Элементы.СтоимостьРесурсов.ОтборСтрок 	= Новый ФиксированнаяСтруктура("Работа", ТекущаяРабота);

	РассчитатьИтогиПоМатериаламИРесурсам(ТекущаяРабота);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийДереваФинансирование

&НаКлиенте
Процедура ДеревоФинансированиеГрафикФинансированияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоФинансирование.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.ПолучитьЭлементы().Очистить();
		
	ВыполнитьРасчетПоГрафикуФинансирования(ТекущиеДанные.ПолучитьИдентификатор()); //СтруктураДанныхДляРасчета);
	
	ОбновитьИтогПоСтрокеФинансирования(ТекущиеДанные.ПолучитьИдентификатор());

КонецПроцедуры

&НаКлиенте
Процедура ДеревоФинансированиеСтоимостьВнешняяПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоФинансирование.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьРасчетПоГрафикуФинансирования(ТекущиеДанные.ПолучитьИдентификатор()); 	
	ОбновитьИтогПоСтрокеФинансирования(ТекущиеДанные.ПолучитьИдентификатор());

	АктированиеОбновлено = Ложь;
	ОбвитьАктирование(ТекущиеДанные.ПолучитьИдентификатор(), АктированиеОбновлено);
			
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийДереваАктирование

&НаКлиенте
Процедура ДеревоАктированиеПередУдалением(Элемент, Отказ)
		
КонецПроцедуры

&НаКлиенте
Процедура ДеревоАктированиеПослеУдаления(Элемент)
	
	ОбновитьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоАктированиеПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если НоваяСтрока Тогда
		ОбновитьИтоги();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоАктированиеСтатьяБюджетаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоАктирование.ТекущиеДанные;
	
	Если ТекущиеДАнные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиАктирования = ТекущиеДанные.ПолучитьЭлементы();
	
	Для Каждого СтрокаАктирование Из СтрокиАктирования Цикл
		СтрокаАктирование.СтатьяБюджета = ТекущиеДанные.СтатьяБюджета;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоАктированиеГрафикАктированияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоАктирование.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьРассчетАктированияНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	РазвернутьДеревоАктирование(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоАктированиеПроцентАктированияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоАктирование.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные.ПроцентАктирования >100 Тогда
		ТекущиеДанные.ПроцентАктирования = 100;
	КонецЕсли;
	
	ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();
	СтрокаРаботы = ТекущиеДанные.ПолучитьРодителя();
	СтоимостьРаботы = СтрокаРаботы.СтоимостьРаботы;
	СтоимостьВнешняя = СтрокаРаботы.СтоимостьВнешняя;
	
	ТекущиеДанные.СтоимостьРаботы = Окр(ТекущиеДанные.ПроцентАктирования * СтоимостьРаботы/100, 2);
	ТекущиеДанные.СтоимостьВнешняя = Окр(ТекущиеДанные.ПроцентАктирования * СтоимостьВнешняя/100, 2);
	
	ОбщаяСуммаАктирования = 0;
	ОбщийПроцент = 0;
	
	Для Каждого СтрокаАктирования Из СтрокаРаботы.ПолучитьЭлементы() Цикл
		ОбщаяСуммаАктирования = ОбщаяСуммаАктирования + СтрокаАктирования.СтоимостьВнешняя;
		ОбщийПроцент = ОбщийПроцент + СтрокаАктирования.ПроцентАктирования;
	КонецЦикла;
	
	ОшибкаПроцент = Ложь;
	ОшибкаСтоимость = Ложь;
	
	Если ОбщийПроцент <> 100 Тогда
		ОшибкаПроцент = Истина;
	КонецЕсли;
	
	Если ОбщаяСуммаАктирования <> СтрокаРаботы.СтоимостьВнешняя Тогда
		ОшибкаСтоимость = Истина;
	КонецЕсли;
	
	Для Каждого СтрокаАктирования Из СтрокаРаботы.ПолучитьЭлементы() Цикл
		СтрокаАктирования.ОшибкаПроцент		 = ОшибкаПроцент;
		СтрокаАктирования.ОшибкаСтоимость 	 = ОшибкаСтоимость;
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ДеревоАктированиеСтоимостьВнешняяПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоАктирование.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные.ЭтоРабота Тогда
		
		СтоимостьВнешняя = ТекущиеДанные.СтоимостьВнешняя;
		СтоимостьРаботы  = ТекущиеДанные.СтоимостьРаботы;
		
		СтрокиАктирования = ТекущиеДанные.ПолучитьЭлементы();
		
		СтоимостьИтого = 0;
		СтоимостьВнешняяИтого = 0;
		
		Для Каждого СтрокаАкт Из СтрокиАктирования Цикл
			
			СтрокаАкт.СтоимостьВнешняя = Окр(СтрокаАкт.ПроцентАктирования * СтоимостьВнешняя, 2);
			
			мСтоимостьВнешняя= Окр(СтрокаАкт.ПроцентАктирования * СтоимостьВнешняя, 2);
			
			Если СтоимостьВнешняя - СтоимостьВнешняяИтого < мСтоимостьВнешняя Тогда
				мСтоимостьВнешняя = СтоимостьВнешняя - СтоимостьВнешняяИтого;
			КонецЕсли; 			
			
			СтрокаАкт.СтоимостьВнешняя = мСтоимостьВнешняя;
			СтоимостьВнешняяИтого = СтоимостьВнешняяИтого + мСтоимостьВнешняя;
			
			мСтоимостьРаботы = Окр(СтрокаАкт.ПроцентАктирования * СтоимостьРаботы, 2);
			
			Если СтоимостьРаботы - СтоимостьИтого < мСтоимостьРаботы Тогда
				мСтоимостьРаботы = СтоимостьРаботы - СтоимостьИтого;
			КонецЕсли; 			
			
			СтрокаАкт.СтоимостьРаботы = мСтоимостьРаботы;
			СтоимостьИтого = СтоимостьИтого + мСтоимостьРаботы;
			
		КонецЦикла;
		
		ОбновитьСтоимостьФинансирования(ТекущиеДанные.ПолучитьИдентификатор());
		
	Иначе
		
		ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();
		СтрокаРаботы = ТекущиеДанные.ПолучитьРодителя();
		СтоимостьВнешняя = СтрокаРаботы.СтоимостьВнешняя;
		
		Если ТекущиеДанные.СтоимостьВнешняя >СтоимостьВнешняя Тогда
			ТекущиеДанные.СтоимостьВнешняя = СтоимостьВнешняя;
		КонецЕсли;
		
		ТекущиеДанные.ПроцентАктирования = ?(СтоимостьВнешняя = 0, 0, Окр(ТекущиеДанные.СтоимостьВнешняя * 100/СтоимостьВнешняя, 2));
		ТекущиеДанные.СтоимостьРаботы = Окр(ТекущиеДанные.ПроцентАктирования  * СтрокаРаботы.СтоимостьРаботы/100,2);
		
		ОбщаяСуммаАктирования = 0;
		ОбщийПроцент = 0;
		
		Для Каждого СтрокаАктирования Из СтрокаРаботы.ПолучитьЭлементы() Цикл
			ОбщаяСуммаАктирования = ОбщаяСуммаАктирования + СтрокаАктирования.СтоимостьВнешняя;
			ОбщийПроцент = ОбщийПроцент + СтрокаАктирования.ПроцентАктирования;
		КонецЦикла;
		
		ОшибкаПроцент = Ложь;
		ОшибкаСтоимость = Ложь;
		
		Если ОбщийПроцент <> 100 Тогда
			ОшибкаПроцент = Истина;
		КонецЕсли;
		
		Если ОбщаяСуммаАктирования <> СтрокаРаботы.СтоимостьВнешняя Тогда
			ОшибкаСтоимость = Истина;
		КонецЕсли;
		
		Для Каждого СтрокаАктирования Из СтрокаРаботы.ПолучитьЭлементы() Цикл
			СтрокаАктирования.ОшибкаПроцент		 = ОшибкаПроцент;
			СтрокаАктирования.ОшибкаСтоимость 	 = ОшибкаСтоимость;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

