&НаКлиенте
Процедура ЦенаДеревоЗначенийПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ТекущиеДанные = Элементы.ЦенаДеревоЗначений.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Новая строка добавлена программно.
	// При отмене редактирования ее требуется удалить.
	Если СтрокаДобавлена И ОтменаРедактирования Тогда
		ЦенаДеревоЗначений.ПолучитьЭлементы().Удалить(ТекущиеДанные);
		СтрокаДобавлена = Ложь;
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные.Ресурс <> СтарыйРесурс Тогда
				
		Ресурсы = ЦенаДеревоЗначений.ПолучитьЭлементы();
		Для Каждого ЭлементРесурс Из Ресурсы Цикл
			Если ЭлементРесурс.Ресурс = ТекущиеДанные.Ресурс Тогда
				Если ТекущиеДанные.ПолучитьИдентификатор() <> ЭлементРесурс.ПолучитьИдентификатор() Тогда
					Если Не ОтменаРедактирования Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Такой ресурс уже присутствует в таблице цен.");
						Элементы.ЦенаДеревоЗначений.ЗакончитьРедактированиеСтроки(Истина);
					Иначе
						ТекущиеДанные.РесурсОбъектСтоимости = СтарыйРесурс;
						ТекущиеДанные.Ресурс = СтарыйРесурс;
						ТекущиеДанные.ПолучитьЭлементы().Очистить();
						ПодборРесурсовКлиент(ТекущиеДанные.Ресурс, Неопределено);
					КонецЕсли;
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	СтрокаДобавлена = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ЦенаДеревоЗначенийПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
