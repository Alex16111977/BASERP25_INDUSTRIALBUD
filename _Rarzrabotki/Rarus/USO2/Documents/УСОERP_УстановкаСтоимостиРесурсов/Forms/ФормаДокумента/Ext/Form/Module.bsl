&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ЦенаДеревоЗначенийЦенаНовая.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ЦенаДеревоЗначенийВалютаНовая.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЦенаДеревоЗначений.ЭтоРесурс");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ЦенаДеревоЗначенийРесурсОбъектСтоимости.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЦенаДеревоЗначений.ЭтоРесурс");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;

	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",Истина);
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ЦенаДеревоЗначений.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЦенаДеревоЗначений.ЭтоРесурс");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(WindowsШрифты.ШрифтДиалоговИМеню,,,Истина));

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	Элементы.ГруппаКомментарий.Картинка = ОбщегоНазначения.ПолучитьКартинкуКомментария(Объект.Комментарий);
	
КонецПроцедуры	

&НаСервере
Процедура ИзменитьНаПроцентСервер(ВведенноеЧисло, Параметры) Экспорт
	
	Если ВведенноеЧисло = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	ВалютаРегл = Константы.ВалютаРегламентированногоУчета.Получить();
	
	РеквизитЦенаДеревоЗначений = ЦенаДеревоЗначений.ПолучитьЭлементы();
	Для Каждого СтрокаРесурс Из РеквизитЦенаДеревоЗначений Цикл
	    ЦенаРесурсаРегУчет = 0;
		Для Каждого СтрокаОбъектСтоимости Из СтрокаРесурс.ПолучитьЭлементы() Цикл
			  СтрокаОбъектСтоимости.ЦенаНовая = СтрокаОбъектСтоимости.ЦенаСтарая + СтрокаОбъектСтоимости.ЦенаСтарая * ВведенноеЧисло/100;
			  Если  ВалютаРегл <> СтрокаОбъектСтоимости.ВалютаНовая Тогда
				  Коэффициенты = РаботаСКурсамивалютУТ.ПолучитьКоэффициентыПересчетаВалюты(СтрокаОбъектСтоимости.ВалютаНовая, СтрокаОбъектСтоимости.ВалютаНовая, Объект.Дата);
				  СтрокаОбъектСтоимости.ЦенаНоваяРегУчет =  СтрокаОбъектСтоимости.ЦенаНовая * Коэффициенты.КоэффициентПересчетаВВалютуРегл;
				  ЦенаРесурсаРегУчет = ЦенаРесурсаРегУчет + СтрокаОбъектСтоимости.ЦенаНоваяРегУчет; 
			  Иначе
				  СтрокаОбъектСтоимости.ЦенаНоваяРегУчет =  СтрокаОбъектСтоимости.ЦенаНовая;
				  ЦенаРесурсаРегУчет = ЦенаРесурсаРегУчет + СтрокаОбъектСтоимости.ЦенаНоваяРегУчет; 
			  КонецЕсли;
		КонецЦикла;
		// посчитать итог для реквизитов 
		СтрокаРесурс.ЦенаНоваяРегУчет = ЦенаРесурсаРегУчет
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ИзменитьВалютуОбъектовСтоимостиСервер(ВведеннаяВалюта, Параметры) Экспорт
	
	Если ВведеннаяВалюта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	ВалютаРегл = Константы.ВалютаРегламентированногоУчета.Получить();
	
	РеквизитЦенаДеревоЗначений = ЦенаДеревоЗначений.ПолучитьЭлементы();
	Для Каждого СтрокаРесурс Из РеквизитЦенаДеревоЗначений Цикл
	    ЦенаРесурсаРегУчет = 0;
		Для Каждого СтрокаОбъектСтоимости Из СтрокаРесурс.ПолучитьЭлементы() Цикл
			  СтрокаОбъектСтоимости.ВалютаНовая = ВведеннаяВалюта;
			  СтрокаОбъектСтоимости.КурсНовый = ПолучитьКурсВалюты(ВведеннаяВалюта);

			  // пересчитать цену рег учета
			  Если  ВалютаРегл <> ВведеннаяВалюта Тогда
				  Коэффициенты = РаботаСКурсамивалютУТ.ПолучитьКоэффициентыПересчетаВалюты(СтрокаОбъектСтоимости.ВалютаНовая, СтрокаОбъектСтоимости.ВалютаНовая, Объект.Дата);
				  СтрокаОбъектСтоимости.ЦенаНоваяРегУчет =  СтрокаОбъектСтоимости.ЦенаНовая * Коэффициенты.КоэффициентПересчетаВВалютуРегл;
				  ЦенаРесурсаРегУчет = ЦенаРесурсаРегУчет + СтрокаОбъектСтоимости.ЦенаНоваяРегУчет; 
			  Иначе
				  СтрокаОбъектСтоимости.ЦенаНоваяРегУчет =  СтрокаОбъектСтоимости.ЦенаНовая;
				  ЦенаРесурсаРегУчет = ЦенаРесурсаРегУчет + СтрокаОбъектСтоимости.ЦенаНоваяРегУчет; 
			  КонецЕсли;
		КонецЦикла;
		// посчитать итог для реквизитов 
		СтрокаРесурс.ЦенаНоваяРегУчет = ЦенаРесурсаРегУчет;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПодборРесурсовКлиент(ЗначенияВыбора, Параметры) Экспорт
	
	Если ЗначенияВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ЗначенияВыбора) = Тип("СправочникСсылка.УСОERP_Ресурсы") Тогда
		
		ИдентификаторТекущейСтроки = Элементы.ЦенаДеревоЗначений.ТекущиеДанные.ПолучитьИдентификатор();
		ДобавлениеРесурсаСервер(ЗначенияВыбора, Параметры, ИдентификаторТекущейСтроки);
		Элементы.ЦенаДеревоЗначений.Развернуть(ИдентификаторТекущейСтроки, Истина);
		
	Иначе
		
		ПодборРесурсовСервер(ЗначенияВыбора, Параметры);
		
		Для Каждого СтрокаРесурс Из ЦенаДеревоЗначений.ПолучитьЭлементы() Цикл
			
			Элементы.ЦенаДеревоЗначений.Развернуть(СтрокаРесурс.ПолучитьИдентификатор(), Истина);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры  

&НаСервере
Процедура ДобавлениеРесурсаСервер(ЗначениеВыбора, Параметры, ИдентификаторТекущейСтроки)
	
	МассивОбъектовСтоимости = Новый Массив;
	НовыйЭлементДерева = ЦенаДеревоЗначений.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	НовыйЭлементДерева.РесурсОбъектСтоимости = ЗначениеВыбора;
	НовыйЭлементДерева.Ресурс = ЗначениеВыбора;
	НовыйЭлементДерева.ЭтоРесурс = Истина;

	
	СоставРесурса = НовыйЭлементДерева.ПолучитьЭлементы();
	СоставИзменился = Ложь;
	
	Если СоставРесурса.Количество() > 0 Тогда
		
		Если СоставРесурса[0].Ресурс <> НовыйЭлементДерева.Ресурс Тогда
			СоставИзменился = Истина;
		КонецЕсли;                                                		
		
	Иначе
		
		СоставИзменился = Истина;
		
	КонецЕсли;
	
	Если СоставИзменился Тогда
		
		НовыйЭлементДерева.ПолучитьЭлементы().Очистить();		
		
		ДобавитьИсполнителей(ЗначениеВыбора, НовыйЭлементДерева, МассивОбъектовСтоимости);
		НовыйЭлементДерева.ЭтоРесурс = Истина;
		
		ЗначенияВыбора = Новый Массив;
		ЗначенияВыбора.Добавить(ЗначениеВыбора);
		
		ТаблицаСтоимостиРесурсов = ПолучитьТаблицуСтоимостиРесурсов(МассивОбъектовСтоимости); 
		ЗаполнитьЦеныОбъектовСтоимости(ТаблицаСтоимостиРесурсов, ЗначенияВыбора);
		
	КонецЕсли;
	
КонецПроцедуры
	
&НаСервере
Процедура ПодборРесурсовСервер(ЗначенияВыбора, Параметры)
	МассивОбъектовСтоимости = Новый Массив;
	ЭлементыДереваЦен = ЦенаДеревоЗначений.ПолучитьЭлементы();
		
	Для Каждого ЗначениеВыбора Из ЗначенияВыбора Цикл
		МассивСтрок = ТаблицаСоответствийСтрокДерева.НайтиСтроки(Новый Структура("Ресурс", ЗначениеВыбора));
		Если МассивСтрок.Количество() > 0 Тогда
			НовыйЭлементДерева = ЦенаДеревоЗначений.НайтиПоИдентификатору(МассивСтрок[0].СтрокаДерева);
		Иначе
			НовыйЭлементДерева = ЭлементыДереваЦен.Добавить();
			
			НоваяСтрока = ТаблицаСоответствийСтрокДерева.Добавить();
			НоваяСтрока.Ресурс = ЗначениеВыбора;
			НоваяСтрока.СтрокаДерева = НовыйЭлементДерева.ПолучитьИдентификатор();			
		КонецЕсли;
	
		НовыйЭлементДерева.РесурсОбъектСтоимости = ЗначениеВыбора;
		НовыйЭлементДерева.Ресурс = ЗначениеВыбора;
		НовыйЭлементДерева.ЭтоРесурс = Истина;
		ДобавитьИсполнителей(ЗначениеВыбора, НовыйЭлементДерева, МассивОбъектовСтоимости);
	КонецЦикла;	
	
    ТаблицаСтоимостиРесурсов = ПолучитьТаблицуСтоимостиРесурсов(МассивОбъектовСтоимости); 
	ЗаполнитьЦеныОбъектовСтоимости(ТаблицаСтоимостиРесурсов, ЗначенияВыбора)
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьИсполнителей(ТекущийРесурс, НовыйЭлементДерева, МассивОбъектовСтоимости)
	  ОбъектыСтоимостиРесурса = НовыйЭлементДерева.ПолучитьЭлементы();
	  ОбъектыСтоимостиРесурса.Очистить();
      // Добавить рабочих
	    Для Каждого СтрокаРабочий Из ТекущийРесурс.Рабочие Цикл
			  СтрокаОбъектСтоимости = ОбъектыСтоимостиРесурса.Добавить();
			  СтрокаОбъектСтоимости.РесурсОбъектСтоимости = СтрокаРабочий.Должность;
			  СтрокаОбъектСтоимости.Ресурс = НовыйЭлементДерева.Ресурс;
			  МассивОбъектовСтоимости.Добавить(СтрокаРабочий.Должность);
		КонецЦикла;	
	  // Добавить механизмы
	    Для Каждого СтрокаМеханизм Из ТекущийРесурс.Механизмы Цикл
			  СтрокаОбъектСтоимости = ОбъектыСтоимостиРесурса.Добавить();
			  СтрокаОбъектСтоимости.РесурсОбъектСтоимости = СтрокаМеханизм.ТипМеханизма;
			  СтрокаОбъектСтоимости.Ресурс = НовыйЭлементДерева.Ресурс;
			  МассивОбъектовСтоимости.Добавить(СтрокаМеханизм.ТипМеханизма);
		КонецЦикла;	
КонецПроцедуры	
	
&НаСервере
Функция ПолучитьТаблицуСтоимостиРесурсов(МассивОбъектовСтоимости)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УСОERP_СтоимостьРесурсовСрезПоследних.Ресурс,
		|	УСОERP_СтоимостьРесурсовСрезПоследних.ОбъектСтоимости КАК РесурсОбъектСтоимости,
		|	УСОERP_СтоимостьРесурсовСрезПоследних.Валюта КАК ВалютаСтарая,
		|	УСОERP_СтоимостьРесурсовСрезПоследних.Курс КАК КурсСтарый,
		|	УСОERP_СтоимостьРесурсовСрезПоследних.Стоимость КАК ЦенаСтарая,
		|	0 КАК ЦенаСтараяРегУчет
		|ИЗ
		|	РегистрСведений.УСОERP_СтоимостьРесурсов.СрезПоследних(
		|			&ДатаДокумента,
		|			ОбъектСтоимости В (&МассивОбъектовСтоимости)
		|				И Регистратор <> &ДокументРегистратор
		|				И ВидЦены = &ВидЦены) КАК УСОERP_СтоимостьРесурсовСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаДокумента", 				Объект.Дата);
	Запрос.УстановитьПараметр("МассивОбъектовСтоимости", 	МассивОбъектовСтоимости);
	Запрос.УстановитьПараметр("ДокументРегистратор", 		Объект.Ссылка);
	Запрос.УстановитьПараметр("ВидЦены", 					Объект.ВидЦены);
	
	СтоимостьОбъектовСтоимости = Запрос.Выполнить().Выгрузить(); 
	
	Для Каждого СтрокаСтоимостьОбъектовСтоимости Из СтоимостьОбъектовСтоимости Цикл
	   Коэффициенты = РаботаСКурсамивалютУТ.ПолучитьКоэффициентыПересчетаВалюты(СтрокаСтоимостьОбъектовСтоимости.ВалютаСтарая, СтрокаСтоимостьОбъектовСтоимости.ВалютаСтарая, Объект.Дата);
		   СтрокаСтоимостьОбъектовСтоимости.ЦенаСтараяРегУчет =  СтрокаСтоимостьОбъектовСтоимости.ЦенаСтарая *  Коэффициенты.КоэффициентПересчетаВВалютуРегл;
	КонецЦикла;
	
	Возврат СтоимостьОбъектовСтоимости;
КонецФункции

&НаСервере
Процедура ЗаполнитьЦеныОбъектовСтоимости(ТаблицаСтоимостиРесурсов, ЗначенияВыбора);
	ЭлементыДереваЦен = ЦенаДеревоЗначений.ПолучитьЭлементы();
	Для Каждого ЭлементДереваЦен Из ЭлементыДереваЦен Цикл
		
		Если ЗначенияВыбора.Найти(ЭлементДереваЦен.РесурсОбъектСтоимости) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ОбъектСтоимостиЭлементДереваЦен Из ЭлементДереваЦен.ПолучитьЭлементы() Цикл
			
			ОтборОбъектовСтоимости = Новый Структура();
			ОтборОбъектовСтоимости.Вставить("Ресурс", ЭлементДереваЦен.РесурсОбъектСтоимости);
			ОтборОбъектовСтоимости.Вставить("РесурсОбъектСтоимости", ОбъектСтоимостиЭлементДереваЦен.РесурсОбъектСтоимости);
			ОбъектыСтоимостиРесурса = ТаблицаСтоимостиРесурсов.НайтиСтроки(ОтборОбъектовСтоимости); 
			Если ОбъектыСтоимостиРесурса.Количество() > 0 Тогда
				Для Каждого ОбъектСтоимостиРесурса Из ОбъектыСтоимостиРесурса Цикл
					ЗаполнитьЗначенияСвойств(ОбъектСтоимостиЭлементДереваЦен, ОбъектСтоимостиРесурса);
					ОбъектСтоимостиЭлементДереваЦен.ЦенаНовая = ОбъектСтоимостиРесурса.ЦенаСтарая;
					ОбъектСтоимостиЭлементДереваЦен.ВалютаНовая = ОбъектСтоимостиРесурса.ВалютаСтарая;
					ОбъектСтоимостиЭлементДереваЦен.КурсНовый = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ОбъектСтоимостиЭлементДереваЦен.ВалютаНовая,Объект.Дата).Курс;
					
					Если  ВалютаРеглУчета <> ОбъектСтоимостиЭлементДереваЦен.ВалютаНовая Тогда
						Коэффициенты = ПолучитьКоэффициентыПересчетаВалюты(ОбъектСтоимостиЭлементДереваЦен.ВалютаНовая);
						ОбъектСтоимостиЭлементДереваЦен.ЦенаНоваяРегУчет =  ОбъектСтоимостиЭлементДереваЦен.ЦенаНовая * Коэффициенты.КоэффициентПересчетаВВалютуРегл;
					Иначе
						ОбъектСтоимостиЭлементДереваЦен.ЦенаНоваяРегУчет =  ОбъектСтоимостиЭлементДереваЦен.ЦенаНовая;
					КонецЕсли;

					Прервать;
				Конеццикла;	
			Иначе
				ОбъектСтоимостиЭлементДереваЦен.ВалютаНовая = Объект.Валюта;
				ОбъектСтоимостиЭлементДереваЦен.КурсНовый = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ОбъектСтоимостиЭлементДереваЦен.ВалютаНовая,Объект.Дата).Курс;
			КонецЕсли;
		КонецЦикла; 	 
	КонецЦикла
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличнуюЧастьИзДереваЗначений(РеквизитЦенаДеревоЗначений, ТабличнаяЧастьЦены, Отказ);  
	Для Каждого СтрокаРесурс Из РеквизитЦенаДеревоЗначений.Строки Цикл
		Для Каждого СтрокаОбъектСтоимости Из СтрокаРесурс.Строки Цикл
			     НоваяСтрокаТАбличнаяЧастьЦены = ТабличнаяЧастьЦены.Добавить();
			     ЗаполнитьЗначенияСвойств(НоваяСтрокаТабличнаяЧастьЦены, СтрокаОбъектСтоимости);
				 НоваяСтрокаТабличнаяЧастьЦены.Ресурс = СтрокаРесурс.РесурсОбъектСтоимости; 
				 НоваяСтрокаТабличнаяЧастьЦены.ОбъектСтоимости = СтрокаОбъектСтоимости.РесурсОбъектСтоимости;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры	

&НаСервере
Функция ПолучитьКурсВалюты(ТекущаяВалюта)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КурсыВалютСрезПоследних.Курс
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(&ДатаДокумента, ) КАК КурсыВалютСрезПоследних
	|ГДЕ
	|	КурсыВалютСрезПоследних.Валюта = &Валюта";
	
	Запрос.УстановитьПараметр("ДатаДокумента", Объект.Дата);
	Запрос.УстановитьПараметр("Валюта", ТекущаяВалюта);
	
	
	КурсВалюты = Запрос.Выполнить().Выбрать(); 
	
	Если КурсВалюты.Следующий() Тогда	
		Возврат КурсВалюты.Курс;
	КонецЕсли;
	Возврат 1;
КонецФункции	

&НаСервере
Функция ПолучитьВалютуРеглУчета()
	ВалютаРегл	= Константы.ВалютаРегламентированногоУчета.Получить();
	Возврат ВалютаРегл; 
КонецФункции

&НаСервере
Функция ПолучитьКоэффициентыПересчетаВалюты(НоваяВалюта)
	Коэффициенты = РаботаСКурсамивалютУТ.ПолучитьКоэффициентыПересчетаВалюты(НоваяВалюта, НоваяВалюта, Объект.Дата);
	Возврат Коэффициенты; 
КонецФункции

&НаКлиенте
Процедура ПолучитьИтогиПоРесурсуРегл(ТекущаяСтрока)
	РодительТекущейСтроки = ТекущаяСтрока.ПолучитьРодителя();
	РодительТекущейСтроки.ЦенаНоваяРегУчет = 0;
	РодительТекущейСтроки.ЦенаСтараяРегУчет = 0;

	Для Каждого СтрокаРодителя Из РодительТекущейСтроки.ПолучитьЭлементы() Цикл
		  РодительТекущейСтроки.ЦенаНоваяРегУчет = РодительТекущейСтроки.ЦенаНоваяРегУчет + СтрокаРодителя.ЦенаНоваяРегУчет;
		  РодительТекущейСтроки.ЦенаСтараяРегУчет = РодительТекущейСтроки.ЦенаСтараяРегУчет + СтрокаРодителя.ЦенаСтараяРегУчет;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ЭтоРесурс(ТекущийРесурсОбъектСтоимости)
	Если ТипЗнч(ТекущийРесурсОбъектСтоимости) = Тип("СправочникСсылка.УСОERP_Ресурсы") Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции	

&НаСервере
Процедура ЗаполнитьДеревоЦен()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УСОERP_УстановкаСтоимостиРесурсовЦены.Ресурс КАК Ресурс,
		|	УСОERP_УстановкаСтоимостиРесурсовЦены.ОбъектСтоимости КАК РесурсОбъектСтоимости,
		|	УСОERP_УстановкаСтоимостиРесурсовЦены.ВалютаСтарая,
		|	УСОERP_УстановкаСтоимостиРесурсовЦены.КурсСтарый,
		|	УСОERP_УстановкаСтоимостиРесурсовЦены.ЦенаСтарая,
		|	УСОERP_УстановкаСтоимостиРесурсовЦены.ЦенаСтараяРегУчет КАК ЦенаСтараяРегУчет,
		|	УСОERP_УстановкаСтоимостиРесурсовЦены.КурсНовый,
		|	УСОERP_УстановкаСтоимостиРесурсовЦены.ВалютаНовая,
		|	УСОERP_УстановкаСтоимостиРесурсовЦены.ЦенаНовая,
		|	УСОERP_УстановкаСтоимостиРесурсовЦены.ЦенаНоваяРегУчет КАК ЦенаНоваяРегУчет,
		|	УСОERP_УстановкаСтоимостиРесурсовЦены.ПроцентИзмененияЦены
		|ИЗ
		|	Документ.УСОERP_УстановкаСтоимостиРесурсов.Цены КАК УСОERP_УстановкаСтоимостиРесурсовЦены
		|ГДЕ
		|	УСОERP_УстановкаСтоимостиРесурсовЦены.Ссылка = &Ссылка
		|ИТОГИ
		|	СУММА(ЦенаСтараяРегУчет),
		|	СУММА(ЦенаНоваяРегУчет)
		|ПО
		|	Ресурс";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаРесурс = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ЭлементыЦенаДеревоЗначений = ЦенаДеревоЗначений.ПолучитьЭлементы();
	Пока ВыборкаРесурс.Следующий() Цикл
	    НовыйРесурс = ЭлементыЦенаДеревоЗначений.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйРесурс, ВыборкаРесурс);
		НовыйРесурс.РесурсОбъектСтоимости = ВыборкаРесурс.Ресурс;
		НовыйРесурс.ЭтоРесурс = Истина;
		ВыборкаДетальныеЗаписи = ВыборкаРесурс.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НовыйОбъектСтоимости = НовыйРесурс.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(НовыйОбъектСтоимости, ВыборкаДетальныеЗаписи);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуСоответствийСтрокДерева()
	
	ТаблицаСоответствийСтрокДерева.Очистить();
	ЭлементыДерева = ЦенаДеревоЗначений.ПолучитьЭлементы();
	
	Для Каждого СтрокаДерева Из ЭлементыДерева Цикл
		НоваяСтрока = ТаблицаСоответствийСтрокДерева.Добавить();
		НоваяСтрока.Ресурс = СтрокаДерева.Ресурс;
		НоваяСтрока.СтрокаДерева = СтрокаДерева.ПолучитьИдентификатор();
	КонецЦикла;
	 		
КонецПроцедуры

СтрокаДобавлена = Ложь;

#КонецОбласти
