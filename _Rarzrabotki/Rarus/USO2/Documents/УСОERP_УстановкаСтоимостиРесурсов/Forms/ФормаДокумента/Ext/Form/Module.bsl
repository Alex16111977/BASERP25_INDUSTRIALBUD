&НаКлиенте
Процедура Подбор(Команда)
	
	ОбновитьТаблицуСоответствийСтрокДерева();
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("МножественныйВыбор", Истина);
	ПараметрыОтбора.Вставить("ЗакрыватьПриВыборе", Ложь); 
	
	ОткрытьФорму("Справочник.УСОERP_Ресурсы.Форма.ФормаВыбора", ПараметрыОтбора, ЭтаФорма,,,,);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРесурс(Команда)
	
	ТекущийЭлемент = Элементы.ЦенаДеревоЗначений;
	
	НоваяСтрока = ЦенаДеревоЗначений.ПолучитьЭлементы().Добавить();
	Элементы.ЦенаДеревоЗначений.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	
	НоваяСтрока.РесурсОбъектСтоимости = ПредопределенноеЗначение("Справочник.УСОERP_Ресурсы.ПустаяСсылка");
	НоваяСтрока.ЭтоРесурс = Истина;
	Элементы.ЦенаДеревоЗначений.ИзменитьСтроку();
	
	СтрокаДобавлена = Истина;
	
КонецПроцедуры

