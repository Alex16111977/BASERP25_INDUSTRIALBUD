
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

#Область Проведение

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт

	Запрос = Новый Запрос(
	// 0 ТаблицаЦеныРесурсов
	"ВЫБРАТЬ
	|	ТаблицаЦеныРесурсов.Ресурс КАК Ресурс,
	|	ВЫБОР
	|		КОГДА ТаблицаЦеныРесурсов.ОбъектСтоимости ССЫЛКА Справочник.Должности
	|				И ТаблицаЦеныРесурсов.ОбъектСтоимости = ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		КОГДА ТаблицаЦеныРесурсов.ОбъектСтоимости ССЫЛКА Справочник.ТипыТранспортныхСредств
	|				И ТаблицаЦеныРесурсов.ОбъектСтоимости = ЗНАЧЕНИЕ(Справочник.ТипыТранспортныхСредств.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ТаблицаЦеныРесурсов.ОбъектСтоимости
	|	КОНЕЦ КАК ОбъектСтоимости,
	|	ТаблицаЦеныРесурсов.ЦенаНовая КАК Цена,
	|	ТаблицаЦеныРесурсов.ВалютаНовая КАК Валюта,
	|	ТаблицаЦеныРесурсов.ЦенаНовая КАК Стоимость,
	|	ТаблицаЦеныРесурсов.Ссылка.Дата КАК ПЕРИОД,
	|	ТаблицаЦеныРесурсов.КурсНовый КАК Курс,
	|	ТаблицаЦеныРесурсов.Ссылка.ВидЦены
	|ПОМЕСТИТЬ ВТ_ТаблицаДляЗаписи
	|ИЗ
	|	Документ.УСОERP_УстановкаСтоимостиРесурсов.Цены КАК ТаблицаЦеныРесурсов
	|ГДЕ
	|	ТаблицаЦеныРесурсов.Ссылка = &Ссылка
	|	И ТаблицаЦеныРесурсов.ОбъектСтоимости <> НЕОПРЕДЕЛЕНО
	//|	И ТаблицаЦеныРесурсов.ЦенаНовая <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаДляЗаписи.Ресурс,
	|	ВТ_ТаблицаДляЗаписи.ОбъектСтоимости,
	|	ВТ_ТаблицаДляЗаписи.Цена,
	|	ВТ_ТаблицаДляЗаписи.Валюта,
	|	ВТ_ТаблицаДляЗаписи.Стоимость,
	|	ВТ_ТаблицаДляЗаписи.ПЕРИОД,
	|	ВТ_ТаблицаДляЗаписи.Курс,
	|	ВТ_ТаблицаДляЗаписи.ВидЦены
	|ИЗ
	|	ВТ_ТаблицаДляЗаписи КАК ВТ_ТаблицаДляЗаписи
	|ГДЕ
	|	ВТ_ТаблицаДляЗаписи.ОбъектСтоимости <> НЕОПРЕДЕЛЕНО");

	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Результат = Запрос.Выполнить();

	ДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТаблицаЦеныРесурсов", Результат.Выгрузить());

КонецПроцедуры

#КонецОбласти

#Область Отчеты 
// Определяет список команд отчетов.
//
// Параметры:
//   КомандыОтчетов - ТаблицаЗначений - Таблица с командами отчетов. Для изменения.
//       См. описание 1 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
//   Параметры - Структура - Вспомогательные параметры. Для чтения.
//       См. описание 2 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
//
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, Параметры) Экспорт
	
	ВариантыОтчетовУТПереопределяемый.ДобавитьКомандуСтруктураПодчиненности(КомандыОтчетов);
	
КонецПроцедуры

#КонецОбласти

