&НаСервере
Процедура ИнициализироватьТаблицуДатНазначений()
	
	ТаблицаДат = ТаблицаДнейНазначений.Выгрузить();
	ТаблицаДат.Очистить();
	
	мДатаНачала = НачалоДня(Объект.ДатаНачала);
	мДатаОкончания = КонецДня(Объект.ДатаОкончания);
	
	ДатаЗаголовка = мДатаНачала;
	
	мПроизводственныйКалендарь = Объект.ОбъектСтроительства.ГрафикРаботы.ПроизводственныйКалендарь;
	ДанныеПроизводственногоКалендаря = Справочники.ПроизводственныеКалендари.ДанныеПроизводственногоКалендаря(мПроизводственныйКалендарь, Год(Объект.ДатаНачала));
	Если НЕ Год(Объект.ДатаНачала) = Год(Объект.ДатаОкончания) Тогда
		ДанныеПроизводственногоКалендаря2 = Справочники.ПроизводственныеКалендари.ДанныеПроизводственногоКалендаря(мПроизводственныйКалендарь, Год(Объект.ДатаОкончания));
	КонецЕсли;
	
	Пока ДатаЗаголовка<= мДатаОкончания Цикл
		НоваяСтрока = ТаблицаДат.Добавить();
		
		НоваяСтрока.Дата 				= НачалоДня(ДатаЗаголовка);
		НоваяСтрока.ИмяКолонки 			= "Дата" + СтрЗаменить(Формат(ДатаЗаголовка, "ДФ=dd.MM.yyyy"), ".", "");
		НоваяСтрока.ЗаголовокКолонки 	= Формат(ДатаЗаголовка, "ДФ=dd.MM");
		ДатаЗаголовка = ДатаЗаголовка + 86400;
		
		ДанныеПоКалендарю = ДанныеПроизводственногоКалендаря.НайтиСтроки(Новый Структура("Дата", НоваяСтрока.Дата));
		Если ДанныеПоКалендарю.Количество()>0 Тогда
			НоваяСтрока.ВидДня = ДанныеПоКалендарю[0].ВидДня;
		КонецЕсли;

		Если НЕ Год(Объект.ДатаНачала) = Год(Объект.ДатаОкончания) 
			И Год(Объект.ДатаОкончания) = Год(НоваяСтрока.Дата) Тогда
			ДанныеПоКалендарю = ДанныеПроизводственногоКалендаря.НайтиСтроки(Новый Структура("Дата", НоваяСтрока.Дата));
			Если ДанныеПоКалендарю.Количество()>0 Тогда
				НоваяСтрока.ВидДня = ДанныеПоКалендарю[0].ВидДня;
			КонецЕсли;
		КонецЕсли;
						
	КонецЦикла;
	
	ТаблицаДнейНазначений.Загрузить(ТаблицаДат);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокумент()
	
	СформироватьИЗаполнитьДеревоРаботИРесурсов();
		
	СформироватьДеревоТаблицуНазначений("ТаблицаНазначений");
	
	ЗаполнитьТаблицуНазначений(Истина);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьИЗаполнитьДеревоРаботИРесурсов()
	
	мДеревоРесурсов = РеквизитФормыВЗначение("ДеревоРабот", Тип("ДеревоЗначений"));
	мДеревоРесурсов.Строки.Очистить();
	
	ТаблицаРаботИРесурсов = Объект.Работы.Выгрузить();
	ТаблицаРабот = ТаблицаРаботИРесурсов.Скопировать();
	ТаблицаРабот.Свернуть("Работа");
	
	ДанныеДляДерева = Новый ДеревоЗначений;
	ТипыЗначений = Новый Массив; 
    ТипыЗначений.Добавить(Тип("СправочникСсылка.УСОERP_Ресурсы")); 
    ТипыЗначений.Добавить(Тип("СправочникСсылка.УСОERP_СтроительныеРаботы")); 
	ДанныеДляДерева.Колонки.Добавить("РаботаРесурс",           Новый ОписаниеТипов(ТипыЗначений));		
	ДанныеДляДерева.Колонки.Добавить("Работа",                 Новый ОписаниеТипов(ТипыЗначений));		
	ДанныеДляДерева.Колонки.Добавить("РаботаРодитель",         Новый ОписаниеТипов(ТипыЗначений));		
	ДанныеДляДерева.Колонки.Добавить("КодСДР",                 Новый ОписаниеТипов("Строка"));		
	ДанныеДляДерева.Колонки.Добавить("НомерРаботыВУровне",     Новый ОписаниеТипов("Число"));		
	ДанныеДляДерева.Колонки.Добавить("КодСДРЧисло",            Новый ОписаниеТипов("Число"));		
	
	ДанныеДляДерева.Колонки.Добавить("СоставРесурса",          Новый ОписаниеТипов("СправочникСсылка.УСОERP_СоставРесурсов"));		
	ДанныеДляДерева.Колонки.Добавить("Ресурс",                 Новый ОписаниеТипов("СправочникСсылка.УСОERP_Ресурсы"));		
	ДанныеДляДерева.Колонки.Добавить("ЭтоРабота",              Новый ОписаниеТипов("Булево"));		
	ДанныеДляДерева.Колонки.Добавить("ИдентификаторДляПоиска", Новый ОписаниеТипов("число"));		
	
	Для Каждого СтрокаРабота Из ТаблицаРабот Цикл
		НоваяСтрока_Работа                    = ДанныеДляДерева.Строки.Добавить();
		НоваяСтрока_Работа.Работа             = СтрокаРабота.Работа;
		НоваяСтрока_Работа.РаботаРесурс       = СтрокаРабота.Работа;
		НоваяСтрока_Работа.ЭтоРабота          = Истина;
		НоваяСтрока_Работа.РаботаРодитель     = Справочники.УСОERP_СтроительныеРаботы.ПустаяСсылка();
		НоваяСтрока_Работа.КодСДР             = СтрокаРабота.Работа.КодСДР;
		НоваяСтрока_Работа.НомерРаботыВУровне = СтрокаРабота.Работа.НомерРаботыВУровне;
		
		МассивРесурсов = ТаблицаРаботИРесурсов.НайтиСтроки(Новый Структура("Работа", СтрокаРабота.Работа));
		Для Каждого СтрокаРесурс Из  МассивРесурсов Цикл
			НоваяСтрока_Ресурс                = НоваяСтрока_Работа.Строки.Добавить();
			ЗаполнитьЗначенияСвойств            (НоваяСтрока_Ресурс,  СтрокаРесурс);
			//НоваяСтрока_Ресурс.Работа         = СтрокаРесурс.Ресурс;
			НоваяСтрока_Ресурс.РаботаРодитель = НоваяСтрока_Работа.Работа;
			НоваяСтрока_Ресурс.РаботаРесурс   = СтрокаРесурс.Ресурс;
		КонецЦикла;
	КонецЦикла;
	
	//ВыражениеИсточник = "Работа";
	//ВыражениеПриемник = "РаботаРодитель" ;
	//Справочник        = Справочники.УСОERP_СтроительныеРаботы;
	//ДеревоРезультат   = УСОERP_ОбработкаТабличныхЧастей.УСОERP_ПодготовитьДанныеИСформироватьДерево(ДанныеДляДерева,ВыражениеИсточник, ВыражениеПриемник, Справочник);	
	//
	//ВремРодноеДерево = РеквизитФормыВЗначение("ДеревоРабот"); // берется родная структура с родной типизацией
	//ВремРодноеДерево.Строки.Очистить();
	//УСОERP_ОбработкаТабличныхЧастей.УСОERP_ЗаполнитьРоднуюСтруктуруДереваИзВнешнего(ВремРодноеДерево.Строки, ДеревоРезультат.Строки); // и рекурсивно заполняется из дерева, где, возможн, типиация создаст проблемы
	//ЗначениеВРеквизитФормы(ВремРодноеДерево, "ДеревоРабот");
	//ВремРодноеДерево.Строки.Очистить(); // уборка за собой

	ЗначениеВРеквизитФормы(ДанныеДляДерева, "ДеревоРабот");
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДеревоТаблицуНазначений(ИмяТаблицы = "")
	
	Если ИмяТаблицы = "" Тогда
		ИмяТаблицы = "ДеревоНазначений";
	Конецесли;
	 
	ДобавляемыеКолонки = Новый Массив();
	УдаляемыеКолонки   = Новый Массив();
	УдаляемыеЭлементы  = Новый Массив();
	УсловныеОформления = Новый Массив();
	
	Если ИмяТаблицы = "" Тогда
		ДеревоЗначений = Новый ДеревоЗначений;
	Иначе
		ДеревоЗначений = Новый ТаблицаЗначений;
	КонецЕсли;
  
	ДеревоЗначений.Колонки.Добавить("Работа",             	Новый ОписаниеТипов("СправочникСсылка.УСОERP_СтроительныеРаботы"));
	ДеревоЗначений.Колонки.Добавить("Ресурс",             	Новый ОписаниеТипов("СправочникСсылка.УСОERP_Ресурсы"));
	ДеревоЗначений.Колонки.Добавить("СоставРесурса",      	Новый ОписаниеТипов("СправочникСсылка.УСОERP_СоставРесурсов"));
	ДеревоЗначений.Колонки.Добавить("Сотрудник",        	Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	ДеревоЗначений.Колонки.Добавить("Должность",        	Новый ОписаниеТипов("СправочникСсылка.Должности"));
	ДеревоЗначений.Колонки.Добавить("РеквизитСортировки", 	Новый ОписаниеТипов("Число"));
	ДеревоЗначений.Колонки.Добавить("КоличествоОбщее", Новый ОписаниеТипов("Число"));

	//Если ИмяТаблицы = "ТаблицаНазначений" Тогда
		ДеревоЗначений.Колонки.Добавить("ИдентификаторДляПоиска", Новый ОписаниеТипов("Число"));
	//КонецЕсли;
	
	
	Если ИмяТаблицы = "ДеревоНазначений" Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.Сотрудники"));
		МассивТипов.Добавить(Тип("СправочникСсылка.УСОERP_СтроительныеРаботы"));
		ДеревоЗначений.Колонки.Добавить("ИсполнительРабота", Новый ОписаниеТипов(МассивТипов));
	КонецЕсли;
	
	
	
	Для Каждого СтрокаДата Из ТаблицаДнейНазначений Цикл 		
		ИмяКолонки = СтрокаДата.ИмяКолонки; 		
		ДеревоЗначений.Колонки.Добавить( ИмяКолонки, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный)), Формат(СтрокаДата.Дата,"ДФ='dd.MM'"));		
	КонецЦикла;

	РеквизитыТаблицы = ПолучитьРеквизиты(ИмяТаблицы);
	Для Каждого Реквизит Из РеквизитыТаблицы Цикл
		Если Найти(Реквизит.Имя, "Дата") ИЛИ Найти(Реквизит.Имя, "КоличествоОбщее") Тогда
			УдаляемыеКолонки.Добавить(ИмяТаблицы + "." + Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Колонка Из ДеревоЗначений.Колонки Цикл
		
		Если Найти(Колонка.Имя, "Дата") ИЛИ Найти(Колонка.Имя, "КоличествоОбщее") Тогда
			УдаляемаяКолонка = УдаляемыеКолонки.Найти(ИмяТаблицы + "." + Колонка.Имя);
			Если УдаляемаяКолонка <> Неопределено Тогда
				УдаляемыеКолонки.Удалить(УдаляемаяКолонка);
			Иначе
				ДобавляемыеКолонки.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, ИмяТаблицы, Колонка.Заголовок, Истина));
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;
	
	Если УдаляемыеКолонки.Количество() > 0 Или ДобавляемыеКолонки.Количество() > 0 Тогда
		ИзменитьРеквизиты(ДобавляемыеКолонки, УдаляемыеКолонки);
	КонецЕсли;
	
	Для Каждого ТекЭлемент Из Элементы[ИмяТаблицы].ПодчиненныеЭлементы Цикл
		Если Найти(ТекЭлемент.Имя, "Дата")
			ИЛИ Найти(ТекЭлемент.Имя, "КоличествоОбщее") Тогда
			УдаляемыеЭлементы.Добавить(ТекЭлемент);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого УдаляемыйЭлемент Из УдаляемыеЭлементы Цикл
		Элементы.Удалить(УдаляемыйЭлемент);
	КонецЦикла;
	
	ШиринаКолонки = ?(ТаблицаДнейНазначений.Количество()>10, 6, 12);
	НовоеПоле = ДобавитьПолеФормы(ЭтаФорма,ИмяТаблицы, "КоличествоОбщее", "Итого", , , ШиринаКолонки, ЦветаСтиля.ЦветФонаГруппировкиОтчета2, ,,,,, Истина );	
	НовоеПоле.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
	
	Для Каждого СтрокаДата Из ТаблицаДнейНазначений Цикл
		
		ИмяКолонки = СтрокаДата.ИмяКолонки; 
		Если ЗначениеЗаполнено(СтрокаДата.ВидДня) Тогда
			Если СтрокаДата.ВидДня <> Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий
				И СтрокаДата.ВидДня <> Перечисления.ВидыДнейПроизводственногоКалендаря.Предпраздничный Тогда
				НовоеПоле = ДобавитьПолеФормы(ЭтаФорма,ИмяТаблицы, ИмяКолонки, Формат(СтрокаДата.Дата,"ДФ='dd.MM'"), "Подключаемый_" + ИмяТаблицы + "КоличествоПриИзменении", , ШиринаКолонки, ЦветаСтиля.ПолеСОшибкойФон, , WebЦвета.Красный,,,,,, Ложь);
			Иначе
				НовоеПоле = ДобавитьПолеФормы(ЭтаФорма,ИмяТаблицы, ИмяКолонки, Формат(СтрокаДата.Дата,"ДФ='dd.MM'"), "Подключаемый_" + ИмяТаблицы + "КоличествоПриИзменении", , ШиринаКолонки, , , ,,,,,, Ложь);
			КонецЕсли;
		Иначе
			Если ДеньНедели(СтрокаДата.Дата) = 6
				ИЛИ ДеньНедели(СтрокаДата.Дата) = 7 Тогда
				НовоеПоле = ДобавитьПолеФормы(ЭтаФорма,ИмяТаблицы, ИмяКолонки, Формат(СтрокаДата.Дата,"ДФ='dd.MM'"), "Подключаемый_" + ИмяТаблицы + "КоличествоПриИзменении", , ШиринаКолонки, ЦветаСтиля.ПолеСОшибкойФон, , WebЦвета.Красный,,,,,, Ложь);
			Иначе
				НовоеПоле = ДобавитьПолеФормы(ЭтаФорма,ИмяТаблицы, ИмяКолонки, Формат(СтрокаДата.Дата,"ДФ='dd.MM'"), "Подключаемый_" + ИмяТаблицы + "КоличествоПриИзменении", , ШиринаКолонки, , , ,,,,,, Ложь);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	
		
	ДеревоНазначенийЗначение = РеквизитФормыВЗначение(ИмяТаблицы);
	ДеревоНазначенийЗначение.Колонки.Очистить();
	
	Для Каждого Колонка Из ДеревоЗначений.Колонки Цикл
		ДеревоНазначенийЗначение.Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоНазначенийЗначение, ИмяТаблицы); 

КонецПроцедуры

&НаСервере
Функция ДобавитьПолеФормы(Форма,
						  ИмяТаблицы,
	                      Имя,
						  Заголовок = Неопределено,
						  ОбработчикПриИзменении = "",
						  ОбработчикНачалоВыбора = "",
						  ШиринаПоля,
						  ЦветФона = Неопределено,
						  ЦветФонаЗаголовка = Неопределено,
						  ЦветТекстаЗаголовка = Неопределено,
						  Родитель = Неопределено,
						  КартинкаШапки = Неопределено,
						  ПутьКДанным = Неопределено,
						  ТолькоПросмотрПоля = Ложь,
						  СвязиПараметровВыбора = Неопределено,
						  РастягиватьПоГоризонтали = Неопределено)
	
	НовоеПоле                     = Форма.Элементы.Добавить(ИмяТаблицы + Имя, Тип("ПолеФормы"), ?(Родитель = Неопределено, Форма.Элементы[ИмяТаблицы], Родитель));
	НовоеПоле.ПутьКДанным         = ?(ЗначениеЗаполнено(ПутьКДанным), ПутьКДанным, ИмяТаблицы + "." + Имя);
	НовоеПоле.Заголовок           = ?(ЗначениеЗаполнено(Заголовок), Заголовок, Имя);
	НовоеПоле.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
	НовоеПоле.Вид                 = ВидПоляФормы.ПолеВвода;
	НовоеПоле.ТолькоПросмотр      = ТолькоПросмотрПоля;
	НовоеПоле.Ширина              = ШиринаПоля;
	
	НовоеПоле.РастягиватьПоГоризонтали = Ложь;
	
	Если СвязиПараметровВыбора <> Неопределено Тогда
		НовоеПоле.СвязиПараметровВыбора = СвязиПараметровВыбора;
	КонецЕсли;
	
	Если ЦветФонаЗаголовка <> Неопределено Тогда
		НовоеПоле.ЦветФонаЗаголовка = ЦветФонаЗаголовка;
	КонецЕсли;
	
	Если ЦветФона <> Неопределено Тогда
		НовоеПоле.ЦветФона = ЦветФона;
	КонецЕсли;
	
	Если ЦветТекстаЗаголовка <> Неопределено Тогда
		НовоеПоле.ЦветТекстаЗаголовка = ЦветТекстаЗаголовка;
	КонецЕсли;
	
	Если КартинкаШапки <> Неопределено Тогда
		НовоеПоле.КартинкаШапки = КартинкаШапки;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ОбработчикПриИзменении) Тогда
		НовоеПоле.УстановитьДействие("ПриИзменении", ОбработчикПриИзменении);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбработчикНачалоВыбора) Тогда
		НовоеПоле.УстановитьДействие("НачалоВыбора", ОбработчикНачалоВыбора);
	КонецЕсли;
	
	Если РастягиватьПоГоризонтали <> Неопределено Тогда
		НовоеПоле.РастягиватьПоГоризонтали = РастягиватьПоГоризонтали;
	КонецЕсли;
	
	Возврат НовоеПоле;
	
КонецФункции

&НаКлиенте
Процедура РазвернутьДерево(ИмяДерева)
	
	КоллекцияЭлементовДерева = ЭтотОбъект[ИмяДерева].ПолучитьЭлементы();	
	//Развернуть дерево 
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
		ИдентификаторСтроки=Строка.ПолучитьИдентификатор();
		Элементы[ИмяДерева].Развернуть(ИдентификаторСтроки);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДеньНедели(мДата)
	
	ДеньНедели = ДеньНедели(мДата);
	Если ДеньНедели = 1 Тогда
		Возврат "Пн.";
	ИначеЕсли ДеньНедели = 2 Тогда
		Возврат "Вт.";
	ИначеЕсли ДеньНедели = 3 Тогда
		Возврат "Ср.";
	ИначеЕсли ДеньНедели = 4 Тогда
		Возврат "Чт.";
	ИначеЕсли ДеньНедели = 5 Тогда
		Возврат "Пт.";
	ИначеЕсли ДеньНедели = 6 Тогда
		Возврат "Сб.";
	ИначеЕсли ДеньНедели = 7 Тогда
		Возврат "Вс.";
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуНазначений(ЧтениеИзТабличнойЧасти = Ложь, ИденфикаторСтроки = Неопределено, ЗаполнитьПоТабелю = Истина)
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_НазначениеИсполнителейРабот_ЗаполнитьТаблицуНазначений(ЭтотОбъект, ЧтениеИзТабличнойЧасти, ИденфикаторСтроки, ЗаполнитьПоТабелю);
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьРаботыИРесурсыВТабличнуюЧасть(ТекущийОбъект)
	
	мДеревоРаботИРесурсов = РеквизитФормыВЗначение("ДеревоРабот", Тип("ДеревоЗначений"));
	ТекущийОбъект.Работы.Очистить();
	Для Каждого СтрокаРабота Из мДеревоРаботИРесурсов.Строки Цикл
		Для Каждого СтрокаРесурс Из СтрокаРабота.Строки Цикл
			НоваяСтрока = ТекущийОбъект.Работы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРесурс);
		КонецЦикла;
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ПоместитьНазначенияРаботВТабличнуюЧасть(ТекущийОбъект)
	
	ТекущийОбъект.Исполнители.Очистить();
	
	Если АктивнаяСтраница = "ГруппаИсполнители" Тогда
		мДеревоНазначений = РеквизитФормыВЗначение("ДеревоНазначений", Тип("ДеревоЗначений"));
		Для Каждого СтрокаСотрудник Из мДеревоНазначений.Строки Цикл
			Для Каждого СтрокаРесурс Из СтрокаСотрудник.Строки Цикл
				Для Каждого СтрокаДата из ТаблицаДнейНазначений Цикл
					НоваяСтрока = ТекущийОбъект.Исполнители.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРесурс);
					НоваяСтрока.Дата = НачалоДня(СтрокаДата.Дата);
					НоваяСтрока.КоличествоЧасов = СтрокаРесурс[СтрокаДата.ИмяКолонки];
					
				КонецЦикла;
				
			КонецЦикла;
		КонецЦикла;
		
	Иначе
		
		Для Каждого СтрокаНазначение Из ТаблицаНазначений Цикл
			
			Для Каждого СтрокаДата из ТаблицаДнейНазначений Цикл
				НоваяСтрока = ТекущийОбъект.Исполнители.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНазначение);
				НоваяСтрока.Дата = НачалоДня(СтрокаДата.Дата);
				НоваяСтрока.КоличествоЧасов = СтрокаНазначение[СтрокаДата.ИмяКолонки];
				
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуНазначенийПриИзмененииПериода(ЗаполнитьПоТабелю = Ложь);
	
	ТаблицаТекущихНазначений = ТаблицаНазначений.Выгрузить();
	
	СформироватьДеревоТаблицуНазначений("ТаблицаНазначений");
	ЗаполнитьТаблицуНазначений(,, ЗаполнитьПоТабелю);
	
	Если Не ЗаполнитьПоТабелю Тогда
		Для Каждого СтрокаТЗ Из ТаблицаТекущихНазначений Цикл
			
			СтруктураПоиска = Новый Структура("Работа, Ресурс, СоставРесурса, Сотрудник, Должность", СтрокаТЗ.Работа, СтрокаТЗ.Ресурс, СтрокаТЗ.СоставРесурса, СтрокаТЗ.Сотрудник, СтрокаТЗ.Должность);
			МассивСтрок = ТаблицаНазначений.НайтиСтроки(СтруктураПоиска);
			Для Каждого СтрокаМассива Из МассивСтрок Цикл
				ЗаполнитьЗначенияСвойств(СтрокаМассива, СтрокаТЗ); 
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если АктивнаяСтраница = "ГруппаРаботы" Тогда
		СформироватьДеревоТаблицуНазначений();
		ЗаполнитьДеревоНазначенийПриСменеСтраницы();  
		Если ТекущаяСтраница = Элементы.ГруппаИсполнители Тогда
			РазвернутьДерево("ДеревоНазначений"); 
		КонецЕсли;
	ИначеЕсли АктивнаяСтраница = "ГруппаИсполнители" Тогда
		СформироватьДеревоТаблицуНазначений("ТаблицаНазначений");
		ЗаполнитьТаблицуНазначенийПриСменеТаблицы();
	КонецЕсли;
	
	АктивнаяСтраница = ТекущаяСтраница.Имя; 
	
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоНазначенийПриСменеСтраницы(СменаПериода = Ложь, ЗаполнитьПоТабелю = Истина)
	
	Если СменаПериода Тогда
		мДеревоНазначенийТекущее = РеквизитФормыВЗначение("ДеревоНазначений", Тип("ДеревоЗначений"));
		
		СформироватьДеревоТаблицуНазначений();
		
		мДеревоНазначений = РеквизитФормыВЗначение("ДеревоНазначений", Тип("ДеревоЗначений"));
		
		Для Каждого СтрокаСотрудник Из мДеревоНазначенийТекущее.Строки Цикл
			СтрокаДерева_Сотрудник = мДеревоНазначений.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДерева_Сотрудник, СтрокаСотрудник);
			СтрокаДерева_Сотрудник.ИсполнительРабота = СтрокаСотрудник.Сотрудник;
			
			ТаблицаИтоговПоСотруднику = Новый ТаблицаЗначений;
			ТаблицаИтоговПоСотруднику.Колонки.Добавить("ИмяКолонки", Новый ОписаниеТипов("Строка"));
			ТаблицаИтоговПоСотруднику.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));

			Для Каждого СтрокаРесурс Из СтрокаСотрудник.Строки Цикл
				СтрокаДерева_Ресурс =  СтрокаДерева_Сотрудник.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДерева_Ресурс, СтрокаРесурс); 
				СтрокаДерева_Ресурс.ИсполнительРабота = СтрокаРесурс.Работа;
				
				Если ЗаполнитьПоТабелю Тогда
					СписокСотрудников = Новый Массив;
					СписокСотрудников.Добавить(СтрокаДерева_Ресурс.Сотрудник);
					
					ВыборкаДанныхОВремени = Документы.УСОERP_НазначениеИсполнителейРабот.ДанныеОВремениСотрудников(Объект, СписокСотрудников);
					
					ИтогоПоСортуднику = 0;
					Пока ВыборкаДанныхОВремени.СледующийПоЗначениюПоля("Сотрудник") Цикл
						Пока ВыборкаДанныхОВремени.СледующийПоЗначениюПоля("Дата") Цикл 								
							МассивСтрокДат = ТаблицаДнейНазначений.НайтиСтроки(Новый Структура("Дата", ВыборкаДанныхОВремени.Дата));
							Если МассивСтрокДат.Количество() <> 0 Тогда 
								ИмяКолонки = МассивСтрокДат[0].ИмяКолонки;  								
								СтрокаДерева_Ресурс[ИмяКолонки] = ВыборкаДанныхОВремени.НормаЧасов; 						
							КонецЕсли; 								
						КонецЦикла;	   							
					КонецЦикла;	
				КонецЕсли;
				
				КоличествоОбщее = 0;
				Для Каждого СтрокаДата Из ТаблицаДнейНазначений Цикл
					НоваяСтрокаИтог = ТаблицаИтоговПоСотруднику.Добавить();
					НоваяСтрокаИтог.ИмяКолонки = СтрокаДата.ИмяКолонки; 
					НоваяСтрокаИтог.Количество = СтрокаДерева_Ресурс[СтрокаДата.ИмяКолонки];
					КоличествоОбщее = КоличествоОбщее + СтрокаДерева_Ресурс[СтрокаДата.ИмяКолонки];
				КонецЦикла;
				СтрокаДерева_Ресурс.КоличествоОбщее = КоличествоОбщее;
			КонецЦикла;
			
			ТаблицаИтоговПоСотруднику.Свернуть("ИмяКолонки", "Количество");
			Для Каждого СтрокаИтог Из ТаблицаИтоговПоСотруднику Цикл
				СтрокаДерева_Сотрудник[СтрокаИтог.ИмяКолонки] = СтрокаИтог.Количество;
			КонецЦикла;
			СтрокаДерева_Сотрудник.КоличествоОбщее = ТаблицаИтоговПоСотруднику.Итог("Количество");
			
		КонецЦикла;
		
		ЗначениеВРеквизитФормы(мДеревоНазначений, "ДеревоНазначений");
		Возврат;
	КонецЕсли;
	
		
	ТаблицаИсполнителейИНазначений = ТаблицаНазначений.Выгрузить();
	
	ТаблСотрудников = ТаблицаИсполнителейИНазначений.Скопировать();
	ТаблСотрудников.Свернуть("Сотрудник, Должность");
		
	мДеревоНазначений = РеквизитФормыВЗначение("ДеревоНазначений", Тип("ДеревоЗначений"));
	
	мДеревоНазначений.Строки.Очистить();
	
	Для Каждого СтрСотрудник Из ТаблСотрудников Цикл
		СтрокаДерева_Сотрудник =  мДеревоНазначений.Строки.Добавить();
		
		ЗаполнитьЗначенияСвойств( СтрокаДерева_Сотрудник, СтрСотрудник);
		СтрокаДерева_Сотрудник.ИсполнительРабота = СтрСотрудник.Сотрудник;	
		МассивРесурсов = ТаблицаИсполнителейИНазначений.НайтиСтроки(Новый Структура("Сотрудник, Должность", СтрСотрудник.Сотрудник, СтрСотрудник.Должность));
		
		СтруктураИтоговПоСотруднику = ПолучитьСтруктуруДляИтогов();
		
		ИтогоПоСотруднику = 0;
		ТаблицаИтоговПоСотруднику = Новый ТаблицаЗначений;
		ТаблицаИтоговПоСотруднику.Колонки.Добавить("ИмяКолонки", Новый ОписаниеТипов("Строка"));
		ТаблицаИтоговПоСотруднику.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
		
		Для Каждого СтрокаРесурс Из МассивРесурсов цикл
			СтрокаДерева_Ресурс =  СтрокаДерева_Сотрудник.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДерева_Ресурс, СтрокаРесурс); 
			СтрокаДерева_Ресурс.ИсполнительРабота = СтрокаРесурс.Работа;
			
			Для Каждого СтрокаДата Из ТаблицаДнейНазначений Цикл
				СтруктураИтоговПоСотруднику[СтрокаДата.ИмяКолонки] = СтрокаРесурс[СтрокаДата.ИмяКолонки];
				ИтогоПоСотруднику = ИтогоПоСотруднику + СтруктураИтоговПоСотруднику[СтрокаДата.ИмяКолонки]; 
				НоваяСтрокаИтог = ТаблицаИтоговПоСотруднику.Добавить();
				НоваяСтрокаИтог.ИмяКолонки = СтрокаДата.ИмяКолонки; 
				НоваяСтрокаИтог.Количество = СтруктураИтоговПоСотруднику[СтрокаДата.ИмяКолонки];
			КонецЦикла;
			
		КонецЦикла;
		
		ТаблицаИтоговПоСотруднику.Свернуть("ИмяКолонки", "Количество");
		Для Каждого СтрокаИтога Из ТаблицаИтоговПоСотруднику Цикл
			СтрокаДерева_Сотрудник[СтрокаИтога.ИмяКолонки] = СтрокаИтога.Количество;
		КонецЦикла;
		СтрокаДерева_Сотрудник.КоличествоОбщее = ИтогоПоСотруднику;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(мДеревоНазначений, "ДеревоНазначений");
		
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруДляИтогов()
	
	СтруктураДляИтогов = Новый Структура();
	
	Для Каждого СтрокаДата Из ТаблицаДнейНазначений Цикл
		СтруктураДляИтогов.Вставить(СтрокаДата.ИмяКолонки, 0);
	КонецЦикла;
	
	Возврат СтруктураДляИтогов;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуНазначенийПриСменеТаблицы()
	
	мДеревоНазначений = РеквизитФормыВЗначение("ДеревоНазначений", Тип("ДеревоЗначений"));
	
	Для Каждого СтрокаСотрудник Из мДеревоНазначений.Строки Цикл
		Для Каждого СтрокаРесурс Из СтрокаСотрудник.Строки Цикл
			НоваяСтрока = ТаблицаНазначений.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаРесурс); 
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивИдентификаторовСтрокСОтборомПоРесурсуиСоставу(ИдентификаторСтроки)
	
	МассивИД = Новый Массив;
	
	ТекущаяСтрока = ТаблицаНазначений.НайтиПоИдентификатору(ИдентификаторСтроки);
	ОтборСтрок = Новый Структура("Работа, Ресурс, СоставРесурса", ТекущаяСтрока.Работа, ТекущаяСтрока.Ресурс, ТекущаяСтрока.СоставРесурса);
	
	МассивСтрок = ТаблицаНазначений.НайтиСтроки(ОтборСтрок);
	
	Для Каждого СтрокаМассива из МассивСтрок Цикл
		МассивИД.Добавить(СтрокаМассива.ПолучитьИдентификатор());
	КонецЦикла;
	
	Возврат МассивИД;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьЧасыИсполнителейПоТабелю(ИдентификаторСтроки)
	
	ТекущаяСтрока = ТаблицаНазначений.НайтиПоИдентификатору( ИдентификаторСтроки);
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 	
	
	Работа = ТекущаяСтрока.Работа; 
	СтруктураРаботы = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПараметрыВыполненияРаботы(Работа,Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный,Объект.ДатаОкончания,Истина);
	ДатаНачалаРаботы    =?(СтруктураРаботы.НачалоРаботыПлан = NULL,Дата(1,1,1), НачалоДня(СтруктураРаботы.НачалоРаботыПлан));
	ДатаОкончанияРаботы = ?(СтруктураРаботы.ОкончаниеРаботыПлан = NULL,Дата(1,1,1),КонецДня(СтруктураРаботы.ОкончаниеРаботыПлан));
	Если НовыйВариант Тогда
		ДатаНачалаРаботы = НачалоДня(Работа.ДатаНачала);
		ДатаОкончанияРаботы = КонецДня(Работа.ДатаОкончания);
	КонецЕсли;
	
	СписокСотрудников = Новый Массив;
	СписокСотрудников.Добавить(ТекущаяСтрока.Сотрудник);
	
	ВыборкаДанныхОВремени = Документы.УСОERP_НазначениеИсполнителейРабот.ДанныеОВремениСотрудников(Объект, СписокСотрудников);
	
	КоличествоОбщее = 0;
	
	Пока ВыборкаДанныхОВремени.СледующийПоЗначениюПоля("Сотрудник") Цикл
		
		Пока ВыборкаДанныхОВремени.СледующийПоЗначениюПоля("Дата") Цикл 								
			
			МассивСтрокДат = ТаблицаДнейНазначений.НайтиСтроки(Новый Структура("Дата", ВыборкаДанныхОВремени.Дата));			
			
			Если ВыборкаДанныхОВремени.Дата >= ДатаНачалаРаботы И ВыборкаДанныхОВремени.Дата<=ДатаОкончанияРаботы Тогда
				
				Если МассивСтрокДат.Количество() <> 0 Тогда 
					ИмяКолонки = МассивСтрокДат[0].ИмяКолонки;  								
					//- ДС Чабаненко
					//ТекущаяСтрока[ИмяКолонки] = ВыборкаДанныхОВремени.НормаЧасов; 	
					//+ ДС Чабаненко
					ТекущаяСтрока[ИмяКолонки] = ВыборкаДанныхОВремени.Часы; 	
					/// ДС Чабаненко
					КоличествоОбщее = КоличествоОбщее + ТекущаяСтрока[ИмяКолонки];
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЦикла;	   							
		
	КонецЦикла;	
	
	ТекущаяСтрока.КоличествоОбщее = КоличествоОбщее;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНазначенияПередУдалением(ИдентификаторСтроки)
	
	УдаляемаяСтрока = ДеревоРабот.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если УдаляемаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиНазначений = ТаблицаНазначений.НайтиСтроки(Новый Структура("Работа, Ресурс, СоставРесурса, ИдентификаторДляПоиска", УдаляемаяСтрока.Работа, УдаляемаяСтрока.Ресурс, УдаляемаяСтрока.СоставРесурса, УдаляемаяСтрока.ИдентификаторДляПоиска)); 	
	Для Каждого мСтрокаКУдалению Из СтрокиНазначений Цикл
		ТаблицаНазначений.Удалить(мСтрокаКУдалению);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДокументУтвержденияПриИзмененииНаСервере()
	НовыйВариант = Объект.ДокументУтверждения.СценарийПланирования.НовыйВариант = Истина;
	Объект.НаправлениеДеятельности = Объект.ДокументУтверждения.НаправлениеДеятельности;
КонецПроцедуры

&НаКлиенте
Процедура ДокументУтвержденияПриИзменении(Элемент)
	ДокументУтвержденияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДокументУтвержденияОчистка(Элемент, СтандартнаяОбработка)
	ДокументУтвержденияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства

КонецПроцедуры

// СтандартныеПодсистемы.Свойства 
&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаСервере
