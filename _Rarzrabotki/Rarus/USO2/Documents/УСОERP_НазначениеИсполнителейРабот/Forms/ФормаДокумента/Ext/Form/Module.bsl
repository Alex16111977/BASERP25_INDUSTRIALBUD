&НаКлиенте
Перем КэшированныеЗначения; //используется механизмом обработки изменения реквизитов ТЧ

&НаКлиенте
Перем ПредыдущиеРеквизитыСтроки; //используется для отвязки строки поступления от строки заказа

&НаКлиенте
Перем ТекущиеДанныеИдентификатор; //используется для передачи текущей строки в обработчик ожидания

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;   
		
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	     		
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ПриЧтенииСозданииНаСервере();
		
		Объект.ДатаНачала 		= НачалоНедели(ТекущаяДата());
		Объект.ДатаОкончания 	= КонецНедели(ТекущаяДата());
		
	КонецЕсли; 
	
	НовыйВариант = Объект.ДокументУтверждения.СценарийПланирования.НовыйВариант = Истина;
	
	ИнициализироватьТаблицуДатНазначений();
	ЗаполнитьДокумент();  	
	
	ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;
	ТекущаяДатаНачала = Объект.ДатаНачала;
	ТекущаяДатаОкончания = Объект.ДатаОкончания;
	
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	 // СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды   
	
	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	АктивнаяСтраница = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	
	РазвернутьДерево("ДеревоРабот");
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// Обработчик механизма "ДатыЗапретаИзменения"
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	ПриЧтенииСозданииНаСервере();
	
		// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды  
	
	МодификацияКонфигурацииПереопределяемый.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи) 	

	ПоместитьРаботыИРесурсыВТабличнуюЧасть(ТекущийОбъект);
	ПоместитьНазначенияРаботВТабличнуюЧасть(ТекущийОбъект); 	

	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства 	
	
	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);	

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("Запись_НазначениеИсполнителейРабот", ПараметрыЗаписи, Объект.Ссылка);

	МодификацияКонфигурацииКлиентПереопределяемый.ПослеЗаписи(ЭтаФорма, ПараметрыЗаписи);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	//Элементы.ГруппаКомментарий.Картинка = ОбщегоНазначения.ПолучитьКартинкуКомментария(Объект.Комментарий);
	
	МодификацияКонфигурацииПереопределяемый.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОбъектСтроительстваПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ТекущийОбъектСтроительства) Тогда
		Если ТекущийОбъектСтроительства <> Объект.ОбъектСтроительства 
			И (ТаблицаНазначений.Количество()>0
			ИЛИ ДеревоРабот.ПолучитьЭлементы().Количество()>0) Тогда
			
			ПоказатьВопрос(Новый ОписаниеОповещения("ОбъектСтроительстваПриИзмененииПродолжение",ЭтотОбъект),"Данные в табличных частях будут очищены. Продолжить?", РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет)
						
		Иначе
			
			ОбъектСтроительстваПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);

		КонецЕсли;	
		
	Иначе
		
		ОбъектСтроительстваПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
	
	КонецЕсли;   
		
КонецПроцедуры

&НаКлиенте
Процедура ОбъектСтроительстваПриИзмененииПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Объект.ОбъектСтроительства = ТекущийОбъектСтроительства;
		Возврат;
	КонецЕсли;
	
	ДеревоРабот.ПолучитьЭлементы().Очистить();
	ДеревоНазначений.ПолучитьЭлементы().Очистить();
	ТаблицаНазначений.Очистить();
	
	ИнициализироватьТаблицуДатНазначений();
	Если АктивнаяСтраница = "ГруппаИсполнители" Тогда
		СформироватьДеревоТаблицуНазначений();
	Иначе
		СформироватьДеревоТаблицуНазначений("ТаблицаНазначений");
	КонецЕсли;

	ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;

	
КонецПроцедуры 

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	
	Если Объект.ДатаНачала = Дата("00010101") Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ДатаОкончания = Дата("00010101") Тогда	
		Возврат;
	КонецЕсли;
	
	Если Объект.ДатаНачала> Объект.ДатаОкончания Тогда
		Возврат;
	КонецЕсли;
	
	ИнициализироватьТаблицуДатНазначений();
	
	ЗаполнитьПоТабелю = Истина;
	Если ТаблицаНазначений.Количество()>0
		Или ДеревоНазначений.ПолучитьЭлементы().Количество()>0 тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ДатаНачалаПриИзмененииПродолжение",ЭтотОБъект),"Заполнить по умолчанию количество часов из графика рабочего времени?", РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
		
	Иначе
		
		ДатаНачалаПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли;			
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзмененииПродолжение(Ответ,ДопПараметры)Экспорт
	
	ЗаполнитьПоТабелю = Ответ = КодВозвратаДиалога.Да;
	
	ЗаполнитьТаблицуНазначенийПриИзмененииПериода(ЗаполнитьПоТабелю);
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаИсполнители Тогда
		ЗаполнитьДеревоНазначенийПриСменеСтраницы(Истина,ЗаполнитьПоТабелю);
		РазвернутьДерево("ДеревоНазначений");
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)
	
	Если Объект.ДатаНачала = Дата("00010101") Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ДатаОкончания = Дата("00010101") Тогда	
		Возврат;
	КонецЕсли;
	
	Если Объект.ДатаНачала> Объект.ДатаОкончания Тогда
		Возврат;
	КонецЕсли;
	
	ИнициализироватьТаблицуДатНазначений();
	
	ЗаполнитьПоТабелю = Истина;
	Если ТаблицаНазначений.Количество()>0
		Или ДеревоНазначений.ПолучитьЭлементы().Количество()>0 тогда
		
	ПоказатьВопрос(Новый ОписаниеОповещения("ДатаОкончанияПриИзмененииПродолжение",ЭтотОБъект),"Заполнить по умолчанию количество часов из графика рабочего времени?", РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
		 
	 Иначе
		 
		 ДатаОкончанияПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		 
	 КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзмененииПродолжение(Ответ,ДопПараметры) Экспорт
	
	ЗаполнитьПоТабелю = Ответ = КодВозвратаДиалога.Да;	 
			
	ЗаполнитьТаблицуНазначенийПриИзмененииПериода(ЗаполнитьПоТабелю);
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаИсполнители Тогда
		ЗаполнитьДеревоНазначенийПриСменеСтраницы(Истина,ЗаполнитьПоТабелю);
		РазвернутьДерево("ДеревоНазначений");
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовДереваФормыДеревоРабот

&НаКлиенте
Процедура ДеревоРаботПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если не ТекущиеДанные = Неопределено Тогда
		ТекущиеДанные.ПолучитьЭлементы();
		Элементы.ТаблицаНазначений.ОтборСтрок = Новый ФиксированнаяСтруктура("Работа, Ресурс, ИдентификаторДляПоиска", ТекущиеДанные.Работа, ТекущиеДанные.Ресурс, ТекущиеДанные.ИдентификаторДляПоиска);
		УстановитьОформлениеКолонокПоРаботе(ТекущиеДанные.Работа);
	Иначе
		Элементы.ТаблицаНазначений.ОтборСтрок = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботПередУдалением(Элемент, Отказ)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если Не ТекущиеДанные = Неопределено Тогда
			
		Если ТекущиеДанные.ЭтоРабота Тогда
			СтрокиРесурсов = ТекущиеДанные.ПолучитьЭлементы();
			Для Каждого СтрРесурс Из СтрокиРесурсов Цикл
				ОбновитьНазначенияПередУдалением(СтрРесурс.ПолучитьИдентификатор());
			КонецЦикла;
		Иначе
			ОбновитьНазначенияПередУдалением(ТекущиеДанные.ПолучитьИдентификатор());
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОформлениеКолонокПоРаботе(Работа)
	
	Результат = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПараметрыВыполненияРаботы(Работа, Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный, ТекущаяДата(), Истина);
	
	Если Работа.Владелец.НовыйВариант Тогда
		Результат = ПараметрыВыполненияРаботы(Работа);
	КонецЕсли;
	
	Если ТипЗнч(Результат.НачалоРаботыПлан) = Тип("Дата") И ТипЗнч(Результат.ОкончаниеРаботыПлан) = Тип("Дата") И ТипЗнч(Объект.ДатаНачала) = Тип("Дата") Тогда
		
		НачалоРаботы 	= НачалоДня(Результат.НачалоРаботыПлан);
		ОкончаниеРаботы = НачалоДня(Результат.ОкончаниеРаботыПлан);
		НачалоПериода 	= НачалоДня(Объект.ДатаНачала);
		
		УстановитьУсловноеОформление();

		Пока НачалоПериода <= Объект.ДатаОкончания Цикл
			Если НачалоРаботы <= НачалоПериода И НачалоПериода <= ОкончаниеРаботы Тогда
				ТекКолонка = Элементы.ТаблицаНазначений.ПодчиненныеЭлементы.Найти("ТаблицаНазначенийДата" + Формат(НачалоПериода, "ДФ=ddMMyyyy"));
				Если ТекКолонка <> Неопределено 
					И ТекКолонка.ЦветФона <> ЦветаСтиля.ПолеСОшибкойФон Тогда

					Элемент = УсловноеОформление.Элементы.Добавить();
					
					ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
					ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТаблицаНазначенийДата" + Формат(НачалоПериода, "ДФ=ddMMyyyy"));
					Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаПолностьюОбеспечен);

				КонецЕсли;
			КонецЕсли;
			НачалоПериода = НачалоПериода + 60 * 60 * 24;
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПараметрыВыполненияРаботы(Работа) 	
	
	СтруктураВозврата = Новый Структура; 	
	
	СтруктураВозврата.Вставить("Ссылка",Работа);
	СтруктураВозврата.Вставить("Владелец",Работа.Владелец);
	СтруктураВозврата.Вставить("СценарийПланирования",Работа.Владелец);
	СтруктураВозврата.Вставить("ОбъектСтроительства",Работа.Владелец.Владелец);
	СтруктураВозврата.Вставить("Родитель",Работа.Родитель);
	СтруктураВозврата.Вставить("СуммарнаяРабота",Работа.СуммарнаяРабота);
	СтруктураВозврата.Вставить("ГрафикРаботы",Работа.ГрафикРаботы);
	СтруктураВозврата.Вставить("НачалоРаботыПлан",Работа.ДатаНачала);
	СтруктураВозврата.Вставить("ОкончаниеРаботыПлан",Работа.ДатаОкончания);
	СтруктураВозврата.Вставить("ДлительностьПлан",Работа.Длительность);
	СтруктураВозврата.Вставить("ЕдиницаДлительности",Работа.ЕдиницаДлительности);
	СтруктураВозврата.Вставить("ОбъемРаботы",Работа.ОбъемРаботы);
	СтруктураВозврата.Вставить("ЕдиницаОбъема",Работа.ЕдиницаОбъема);
	СтруктураВозврата.Вставить("Утверждена",Истина);
	СтруктураВозврата.Вставить("ВидПланирования",Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный);  
	СтруктураВозврата.Вставить("КритическаяРабота",Работа.КритическаяРабота);  	
	
	Возврат СтруктураВозврата;  	
	
КонецФункции

&НаКлиенте
Процедура ДеревоРаботСоставРесурсаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	ТекущиеДанные.ПолучитьЭлементы();
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Ресурс) Тогда
		СтандартнаяОбработка = Ложь;
		
		ОткрытьФорму("Справочник.УСОERP_СоставРесурсов.ФормаВыбора", Новый Структура("Ресурс", ТекущиеДанные.Ресурс), Элемент);
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботСоставРесурсаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	
	ЗаполнитьТаблицуНазначений(Ложь, ТекущиеДанные.ПолучитьИдентификатор());

	//РазвернутьДерево("ДеревоНазначений");
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТаблицаНазначенийКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаНазначений.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда
		ПолучитьИтогПоСтрокеНазначения(ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДеревоНазначенийКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоНазначений.ТекущиеДанные;
		
	Если НЕ ТекущиеДанные = Неопределено Тогда
		
		ТекущиеДанные.ПолучитьЭлементы();
		Родитель = ТекущиеДанные.ПолучитьРодителя();
		СтрокиРабот = Родитель.ПолучитьЭлементы();
		
		КоличествоОбщее = 0;
		Для Каждого СтрокаДата из ТаблицаДнейНазначений Цикл
			КоличествоОбщее = КоличествоОбщее + ТекущиеДанные[СтрокаДата.ИмяКолонки];
		КонецЦикла;
		ТекущиеДанные.КоличествоОбщее = КоличествоОбщее;
		
		ИтогоКоличествоОбщее = 0;
		ИтогоЗаДень 		 = 0;
		
		ИмяКолонки = СтрЗаменить(Элемент.Имя, "ДеревоНазначений", "");
		
		Для Каждого СтрокаРабота Из СтрокиРабот Цикл
			ИтогоКоличествоОбщее = ИтогоКоличествоОбщее + СтрокаРабота.КоличествоОбщее;
			ИтогоЗаДень 		 = ИтогоЗаДень + СтрокаРабота[ИмяКолонки];
		КонецЦикла;
		
		Родитель.КоличествоОбщее = ИтогоКоличествоОбщее;
		Родитель[ИмяКолонки]	 = ИтогоЗаДень;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьИтогПоСтрокеНазначения(ИдентификаторСтроки)
	
	ТекущаяСтрока = ТаблицаНазначений.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоИтог = 0;
	Для Каждого ЭлтДата Из ТаблицаДнейНазначений Цикл
		КоличествоИтог = КоличествоИтог + ТекущаяСтрока[ЭлтДата.ИмяКолонки];
	КонецЦикла;
	ТекущаяСтрока.КоличествоОбщее = КоличествоИтог;
	
КонецПроцедуры

