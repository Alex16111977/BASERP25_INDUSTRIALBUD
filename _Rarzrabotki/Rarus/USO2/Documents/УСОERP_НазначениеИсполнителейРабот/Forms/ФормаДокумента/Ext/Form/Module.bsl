&НаКлиенте
Процедура ВыбратьПериод(Команда)
	
	ПараметрыОткрытия 	= Новый Структура("НачалоПериода, КонецПериода", Объект.ДатаНачала, Объект.ДатаОкончания);
	ОписаниеОповещения 	= Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериода", ПараметрыОткрытия, Элементы.ВыбратьПериод, , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект.ДатаНачала = РезультатВыбора.НачалоПериода;
	Объект.ДатаОкончания = КонецДня(РезультатВыбора.КонецПериода);
	ТекущаяДатаНачала = Объект.ДатаНачала;
	ТекущаяДатаОкончания = Объект.ДатаОкончания;
	
	ИнициализироватьТаблицуДатНазначений();
	
	ЗаполнитьПоТабелю = Истина;
	Если ТаблицаНазначений.Количество()>0
		Или ДеревоНазначений.ПолучитьЭлементы().Количество()>0 тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ДатаОкончанияПриИзмененииПродолжение",ЭтотОБъект),"Заполнить по умолчанию количество часов из графика рабочего времени?", РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
		 
	 Иначе
		 
		 ДатаОкончанияПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		 
	 КонецЕсли;  
	 
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРесурсы(Команда)
	
	Если  ТаблицаНазначений.Количество() Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьРесурсыПродолжение",ЭтотОбъект),"Назначения исполнителей будут очищены. Продолжить?", РежимДиалогаВопрос.ДаНет, 30, КодВозвратаДиалога.Нет);
		
	Иначе
		
		ЗаполнитьРесурсыПродолжение(КодВозвратаДиалога.Да,Новый Структура);  		
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРесурсыПродолжение(Ответ,ДопПараметры)Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРесурсыНаСервере();
	Модифицированность = Истина;
	
	РазвернутьДерево("ДеревоРабот"); 	
	
КонецПроцедуры  

