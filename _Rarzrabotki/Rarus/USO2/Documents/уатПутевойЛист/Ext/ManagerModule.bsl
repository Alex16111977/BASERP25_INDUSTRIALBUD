		ИначеЕсли (ИмяМакета = "_4")  Или (ИмяМакета = "_6") Тогда
			ИмяФункцииПечати = "уатПечать" + ИмяМакета + "(ТекущийДокумент,ИмяМакета + ""_пп"", 0)";
		Иначе	
			ИмяФункцииПечати = "уатПечать" + ИмяМакета + "(ТекущийДокумент,ИмяМакета, 0)";
