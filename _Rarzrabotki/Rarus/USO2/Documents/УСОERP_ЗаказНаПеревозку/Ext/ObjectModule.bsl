Процедура ВыполнитьПроверкуКоличества(Отказ = Ложь)
	
	Движения.УСОERP_ДанныеДоставки.Очистить();
	Движения.УСОERP_ДанныеДоставки.Записать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_ЗаказНаПеревозкуКДоставке.ЗаказПоставщику,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Номенклатура,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Характеристика,
	|	СУММА(УСОERP_ЗаказНаПеревозкуКДоставке.КоличествоУпаковок) КАК КоличествоУпаковок,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Количество КАК Количество,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.Организация,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.АдресОтправления,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.АдресДоставки,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.НомерСтроки,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Упаковка
	|ПОМЕСТИТЬ ВТ_ЗаказыИМатериалыВДокументе
	|ИЗ
	|	Документ.УСОERP_ЗаказНаПеревозку.КДоставке КАК УСОERP_ЗаказНаПеревозкуКДоставке
	|ГДЕ
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка = &Ссылка
	|	И УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.Статус <> ЗНАЧЕНИЕ(Перечисление.УСОERP_СтатусыЗаказаНаПеревозку.Отменен)
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Номенклатура,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.ЗаказПоставщику,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Характеристика,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Количество,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.Организация,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.АдресОтправления,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.АдресДоставки,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.НомерСтроки,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Упаковка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ЗаказыИМатериалыВДокументе.НомерСтроки,
	|	ВТ_ЗаказыИМатериалыВДокументе.Номенклатура,
	|	ВТ_ЗаказыИМатериалыВДокументе.Характеристика,
	|	ВТ_ЗаказыИМатериалыВДокументе.Количество,
	|	ЕСТЬNULL(УСОERP_ДанныеДоставкиОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(УСОERP_ДанныеДоставкиОстатки.КоличествоОстаток, 0) - ВТ_ЗаказыИМатериалыВДокументе.Количество < 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьОшибкаКоличества,
	|	ВТ_ЗаказыИМатериалыВДокументе.АдресОтправления,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_ЗаказыИМатериалыВДокументе.Упаковка.Числитель, 1) = 0
	|			ТОГДА ВТ_ЗаказыИМатериалыВДокументе.Количество
	|		ИНАЧЕ ВЫРАЗИТЬ(ВТ_ЗаказыИМатериалыВДокументе.Количество * ЕСТЬNULL(ВТ_ЗаказыИМатериалыВДокументе.Упаковка.Знаменатель, 1) / ЕСТЬNULL(ВТ_ЗаказыИМатериалыВДокументе.Упаковка.Числитель, 1) КАК ЧИСЛО(15, 3))
	|	КОНЕЦ КАК КоличествоУпаковок,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_ЗаказыИМатериалыВДокументе.Упаковка.Числитель, 1) = 0
	|			ТОГДА ЕСТЬNULL(УСОERP_ДанныеДоставкиОстатки.КоличествоОстаток, 0)
	|		ИНАЧЕ ВЫРАЗИТЬ(ЕСТЬNULL(УСОERP_ДанныеДоставкиОстатки.КоличествоОстаток, 0) * ЕСТЬNULL(ВТ_ЗаказыИМатериалыВДокументе.Упаковка.Знаменатель, 1) / ЕСТЬNULL(ВТ_ЗаказыИМатериалыВДокументе.Упаковка.Числитель, 1) КАК ЧИСЛО(15, 3))
	|	КОНЕЦ КАК КоличествоУпаковокОстаток,
	|	ВЫБОР
	|		КОГДА ВТ_ЗаказыИМатериалыВДокументе.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА ВТ_ЗаказыИМатериалыВДокументе.Номенклатура.ЕдиницаИзмерения
	|		ИНАЧЕ ВТ_ЗаказыИМатериалыВДокументе.Упаковка
	|	КОНЕЦ КАК Упаковка
	|ИЗ
	|	ВТ_ЗаказыИМатериалыВДокументе КАК ВТ_ЗаказыИМатериалыВДокументе
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УСОERP_ДанныеДоставки.Остатки(
	|				&КонецПериода,
	|				(ЗаказПоставщику, Организация, Номенклатура, Характеристика) В
	|						(ВЫБРАТЬ
	|							ВТ_ЗаказыИМатериалыВДокументе.ЗаказПоставщику,
	|							ВТ_ЗаказыИМатериалыВДокументе.Организация,
	|							ВТ_ЗаказыИМатериалыВДокументе.Номенклатура,
	|							ВТ_ЗаказыИМатериалыВДокументе.Характеристика
	|						ИЗ
	|							ВТ_ЗаказыИМатериалыВДокументе КАК ВТ_ЗаказыИМатериалыВДокументе)
	|					И ЗаказНаДоставку <> &Ссылка) КАК УСОERP_ДанныеДоставкиОстатки
	|		ПО ВТ_ЗаказыИМатериалыВДокументе.ЗаказПоставщику = УСОERP_ДанныеДоставкиОстатки.ЗаказПоставщику
	|			И ВТ_ЗаказыИМатериалыВДокументе.Характеристика = УСОERP_ДанныеДоставкиОстатки.Характеристика
	|			И ВТ_ЗаказыИМатериалыВДокументе.Номенклатура = УСОERP_ДанныеДоставкиОстатки.Номенклатура
	|			И ВТ_ЗаказыИМатериалыВДокументе.Организация = УСОERP_ДанныеДоставкиОстатки.Организация
	|			И (ВТ_ЗаказыИМатериалыВДокументе.АдресОтправления = УСОERP_ДанныеДоставкиОстатки.АдресОтправления
	|					И УСОERP_ДанныеДоставкиОстатки.ЗаказНаДоставку = ЗНАЧЕНИЕ(Документ.УСОERP_ЗаказНаПеревозку.ПустаяСсылка)
	|				ИЛИ УСОERP_ДанныеДоставкиОстатки.ЗаказНаДоставку <> ЗНАЧЕНИЕ(Документ.УСОERP_ЗаказНаПеревозку.ПустаяСсылка)
	|					И ВТ_ЗаказыИМатериалыВДокументе.АдресОтправления = УСОERP_ДанныеДоставкиОстатки.АдресДоставки)
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ЕСТЬNULL(УСОERP_ДанныеДоставкиОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ВТ_ЗаказыИМатериалыВДокументе.Количество, 0) < 0
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ = ИСТИНА";
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(Дата, ВидГраницы.Включая));
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() тогда
		Возврат;
	Конецесли;
	
	Выборка = Результат.Выбрать();
	
	ТекстОшибки = "";
	Пока Выборка.Следующий() Цикл
		
		ТекстОшибки = "Для материала " + Выборка.Номенклатура + ?(ЗначениеЗаполнено(Выборка.Характеристика), ", " + Выборка.Характеристика, "")
					+ " количество к доставке " + Строка(Выборка.КоличествоУпаковок) + " " + СокрЛП(Выборка.Упаковка) 
					+ " превысило доступный остаток материала для заказа на перевозку " + Строка(Выборка.КоличествоУпаковокОстаток) + " " + СокрЛП(Выборка.Упаковка) 
					+ " по адресу отправления: " + СокрЛП(Выборка.АдресОтправления) + ".";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Ссылка,,ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("КДоставке", Выборка.НомерСтроки, "Номенклатура"));
		
	КонецЦикла;
	
	
	Отказ = Истина;	
	
КонецПроцедуры

Процедура ВыполнитьПроверкуСрокаДоставки(Отказ = Ложь)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&СрокДоставки,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.ЗаказПоставщику,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Номенклатура,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Характеристика,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.НомерСтроки,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.ДатаПоступления
	|ПОМЕСТИТЬ ВТ_ТаблицаДоставки
	|ИЗ
	|	&КДоставке КАК УСОERP_ЗаказНаПеревозкуКДоставке
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаДоставки.СрокДоставки,
	|	ВТ_ТаблицаДоставки.ЗаказПоставщику,
	|	ВТ_ТаблицаДоставки.Номенклатура,
	|	ВТ_ТаблицаДоставки.Характеристика,
	|	ВТ_ТаблицаДоставки.НомерСтроки,
	|	ВТ_ТаблицаДоставки.ДатаПоступления
	|ИЗ
	|	ВТ_ТаблицаДоставки КАК ВТ_ТаблицаДоставки
	|ГДЕ
	|	ВТ_ТаблицаДоставки.СрокДоставки > ВТ_ТаблицаДоставки.ДатаПоступления";
	Запрос.УстановитьПараметр("СрокДоставки", СрокДоставки);
	Запрос.УстановитьПараметр("КДоставке", КДоставке.Выгрузить());
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой()Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Срок доставки " + Формат(СрокДоставки, "ДЛФ = Д") + " материала " + Выборка.Номенклатура 
		+ ?(ЗначениеЗаполнено(Выборка.Характеристика), ", " + Выборка.Характеристика, "") + " превышает его дату поступления " + Формат(Выборка.ДатаПоступления, "ДЛФ=Д") + ".", ЭтотОбъект, ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("КДоставке", Выборка.НомерСтроки, "Номенклатура"));
		
	КонецЦикла;
	Отказ = Истина;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
