		//|	СУММА(ВТ_ЗарезервированноеКоличество.КоличествоНедоступно) КАК КоличествоНедоступно
		//|ПОМЕСТИТЬ ВТ_ДанныеПоТоварам
		//|ИЗ
		//|	ВТ_ЗарезервированноеКоличество КАК ВТ_ЗарезервированноеКоличество
		//|
		//|СГРУППИРОВАТЬ ПО
		//|	ВТ_ЗарезервированноеКоличество.Номенклатура,
		//|	ВТ_ЗарезервированноеКоличество.ЗаказПоставщику,
		//|	ВТ_ЗарезервированноеКоличество.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаказПоставщикуТовары.Номенклатура,
		|	ЗаказПоставщикуТовары.Характеристика,
		//|	ЕСТЬNULL(ЗаказПоставщикуТовары.Количество, 0) - ЕСТЬNULL(ВТ_ДанныеПоТоварам.КоличествоНедоступно, 0) КАК Количество,
		|	ЗаказПоставщикуТовары.Количество,
		|	ЗаказПоставщикуТовары.ДатаПоступления КАК СрокДоставки,
		|	ЗаказПоставщикуТовары.Ссылка КАК ЗаказПоставщику,
		|	ЗаказПоставщикуТовары.Упаковка
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		//|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеПоТоварам КАК ВТ_ДанныеПоТоварам
		//|		ПО ЗаказПоставщикуТовары.Ссылка = ВТ_ДанныеПоТоварам.ЗаказПоставщику
		//|			И ЗаказПоставщикуТовары.Номенклатура = ВТ_ДанныеПоТоварам.Номенклатура
		//|			И ЗаказПоставщикуТовары.Характеристика = ВТ_ДанныеПоТоварам.Характеристика
		|ГДЕ
		|	ЗаказПоставщикуТовары.Ссылка = &ДокументОснование
		//|	И ЕСТЬNULL(ЗаказПоставщикуТовары.Количество, 0) - ЕСТЬNULL(ВТ_ДанныеПоТоварам.КоличествоНедоступно, 0) > 0";
		|	ЗаказПоставщикуТовары.Количество";
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		РеквизитыЗаказа = РезультатЗапроса[0].Выбрать();
		РеквизитыЗаказа.Следующий();
		
		МассивДопустимыхСтатусов = Новый Массив();
		МассивДопустимыхСтатусов.Добавить(Перечисления.СтатусыЗаказовПоставщикам.Подтвержден);
		МассивДопустимыхСтатусов.Добавить(Перечисления.СтатусыЗаказовПоставщикам.Закрыт);
		
		ОбщегоНазначенияУТ.ПроверитьВозможностьВводаНаОсновании(
			РеквизитыЗаказа.ЗаказПоставщику,
			РеквизитыЗаказа.СтатусДокумента,
			РеквизитыЗаказа.ЕстьОшибкиПроведен,
			РеквизитыЗаказа.ЕстьОшибкиСтатус,
			МассивДопустимыхСтатусов);
		
		// Заполнение шапки.
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыЗаказа);
		
		// Заполнение материалов  		
		//МатериалыЗаказа = РезультатЗапроса[4].Выгрузить();
		МатериалыЗаказа = РезультатЗапроса[1].Выгрузить();
		
		//Если МатериалыЗаказа.Количество() = 0 Тогда
		//	ТекстОшибки = НСтр("ru='Для материалов к доставке в заказе поставщику уже определены заказы на перевозку, доступного количества по материалам нет. Ввод на основании недоступен.'");
		//			
		//	ВызватьИсключение ТекстОшибки;
		//КонецЕсли;
	
			
		КДоставке.Загрузить( МатериалыЗаказа);
		
		СтруктураДействий = Новый Структура;
		//СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу");
		СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");		                             
		ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(КДоставке, СтруктураДействий, Неопределено);

		
		МатериалыЗаказа.Сортировать("СрокДоставки Возр");
		
		Если МатериалыЗаказа.Количество()>0 Тогда
			СрокДоставки =  МатериалыЗаказа[0].СрокДоставки;
		КонецЕсли;
				
	КонецЕсли;
		
		
КонецПроцедуры

Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Ответственный                  = Пользователи.ТекущийПользователь();
	Валюта                         = ДоходыИРасходыСервер.ПолучитьВалютуУправленческогоУчета(Валюта);
	ВалютаВзаиморасчетов           = ДоходыИРасходыСервер.ПолучитьВалютуУправленческогоУчета(ВалютаВзаиморасчетов);
	
	Организация               = ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Организация);
	Склад                     = ЗначениеНастроекПовтИсп.ПолучитьСкладПоУмолчанию(Склад, Ложь, Истина);
		
КонецПроцедуры

