//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
КонецПроцедуры

#КонецОбласти

#Область ЗапросДляРасчетаСостоянийОтгрузки

// Возвращает текст запроса для расчета состояния отгрузки
//
Функция ТекстЗапросаДляРасчетаСостоянийОтгрузки() Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ЗаказНаПеревозку.Ссылка КАК Ссылка,
	|	ЗаказНаПеревозку.Проведен КАК Проведен,
	|	ВЫБОР
	|		КОГДА ЗаказНаПеревозку.Статус В (ЗНАЧЕНИЕ(Перечисление.УСОERP_СтатусыЗаказаНаПеревозку.Подготовлен),ЗНАЧЕНИЕ(Перечисление.УСОERP_СтатусыЗаказаНаПеревозку.Согласован),ЗНАЧЕНИЕ(Перечисление.УСОERP_СтатусыЗаказаНаПеревозку.ВРаботе)) 
	|			ТОГДА ""КОтгрузке""
	|		КОГДА ЗаказНаПеревозку.Статус В (ЗНАЧЕНИЕ(Перечисление.УСОERP_СтатусыЗаказаНаПеревозку.Завершен), ЗНАЧЕНИЕ(Перечисление.УСОERP_СтатусыЗаказаНаПеревозку.Отменен))
	|			ТОГДА ""Отгружено""
	|	КОНЕЦ КАК Статус,
	|	Значение(Перечисление.СпособыДоставки.ПустаяСсылка) КАК СпособДоставки,
	|	ЗаказНаПеревозку.Склад КАК Склад,
	|	ВЫБОР
	|		КОГДА ЗаказНаПеревозку.Склад.ИспользоватьОрдернуюСхемуПриОтгрузке
	|				И ЗаказНаПеревозку.Дата >= ЗаказНаПеревозку.Склад.ДатаНачалаОрдернойСхемыПриОтгрузке
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИспользоватьОрдернуюСхемуПриОтгрузке,
	|	ЗаказНаПеревозку.Склад.НачинатьОтгрузкуПослеФормированияЗаданияНаПеревозку КАК НачинатьОтгрузкуПослеФормированияЗаданияНаПеревозку,
	|	ЛОЖЬ КАК ЕстьРасхождения
	|ИЗ
	|	Документ.УСОERP_ЗаказНаПеревозку КАК ЗаказНаПеревозку
	|ГДЕ
	|	ЗаказНаПеревозку.Ссылка В(&ДокументыОтгрузки)";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
