#Область СлужебныеПроцедурыИФункции

#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстыЗапроса.Добавить(ТекстЗапросаВТ_ДанныеДоставки(),			"ВТ_ДанныеДоставки");
	ТекстыЗапроса.Добавить(ТекстЗапросаТаблицаДоставка(),			"ТаблицаДоставка");
	
	Запрос.Текст = "";
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		Запрос.Текст = Запрос.Текст + ТекстЗапроса.Значение;
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////
	// Выполним запрос
	
	Если Не Запрос.Текст ="" Тогда
		Результат = Запрос.ВыполнитьПакет();
	КонецЕсли;
	
	////////////////////////////////////////////////////////////////////////////
	// Поместим результаты запроса в дополнительные свойства
	
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		ИмяТаблицы = ТекстЗапроса.Представление;
		Если Не ПустаяСтрока(ИмяТаблицы) Тогда
			Индекс = ТекстыЗапроса.Индекс(ТекстЗапроса);
			ДополнительныеСвойства.ТаблицыДляДвижений.Вставить(ИмяТаблицы, Результат[Индекс].Выгрузить());
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_ЗаказНаПеревозку.Ссылка,
	|	УСОERP_ЗаказНаПеревозку.Дата КАК Период,
	|	УСОERP_ЗаказНаПеревозку.Организация,
	|	УСОERP_ЗаказНаПеревозку.СрокДоставки,
	|	УСОERP_ЗаказНаПеревозку.Партнер,
	|	УСОERP_ЗаказНаПеревозку.Контрагент,
	|	УСОERP_ЗаказНаПеревозку.АдресОтправления,
	|	УСОERP_ЗаказНаПеревозку.АдресДоставки,
	|	УСОERP_ЗаказНаПеревозку.Склад,
	|	УСОERP_ЗаказНаПеревозку.Договор,
	|	УСОERP_ЗаказНаПеревозку.ВидДоставки,
	|	УСОERP_ЗаказНаПеревозку.ВидОперации
	|ИЗ
	|	Документ.УСОERP_ЗаказНаПеревозку КАК УСОERP_ЗаказНаПеревозку
	|ГДЕ
	|	УСОERP_ЗаказНаПеревозку.Ссылка = &Ссылка";
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	//
	Запрос.УстановитьПараметр("Ссылка",	Реквизиты.Ссылка);
	Запрос.УстановитьПараметр("КонецПериода",	Новый Граница(КонецДня(Реквизиты.Ссылка.Дата), ВидГраницы.Включая));
	
КонецПроцедуры

Функция ТекстЗапросаВТ_ДанныеДоставки()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка КАК Регистратор,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.Дата КАК Период,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.Организация,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.ЗаказПоставщику,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Номенклатура,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Характеристика,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Количество,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.АдресОтправления,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.АдресДоставки,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.СрокДоставки КАК ОжидаемаяДатаДоставки,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.Статус,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка КАК ЗаказНаДоставку,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.ВидОперации КАК Исполнитель,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.ВидДоставки,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.Партнер,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.Контрагент,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.ДатаПоступления
	|ПОМЕСТИТЬ ВТ_ДанныеТоваровКДоставке
	|ИЗ
	|	Документ.УСОERP_ЗаказНаПеревозку.КДоставке КАК УСОERP_ЗаказНаПеревозкуКДоставке
	|ГДЕ
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаДоставка()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВТ_ДанныеТоваровКДоставке.Регистратор,
	|	ВТ_ДанныеТоваровКДоставке.Период,
	|	ВТ_ДанныеТоваровКДоставке.Организация,
	|	ВТ_ДанныеТоваровКДоставке.ЗаказПоставщику,
	|	ВТ_ДанныеТоваровКДоставке.Номенклатура,
	|	ВТ_ДанныеТоваровКДоставке.Характеристика,
	|	ЕСТЬNULL(ВТ_ДанныеТоваровКДоставке.Количество, 0) КАК Количество,
	|	УСОERP_ДанныеДоставкиОстатки.АдресОтправления,
	|	УСОERP_ДанныеДоставкиОстатки.АдресДоставки,
	|	УСОERP_ДанныеДоставкиОстатки.ОжидаемаяДатаДоставки КАК ОжидаемаяДатаДоставки,
	|	УСОERP_ДанныеДоставкиОстатки.ЗаказНаДоставку КАК ЗаказНаДоставку,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	УСОERP_ДанныеДоставкиОстатки.Исполнитель КАК Исполнитель,
	|	УСОERP_ДанныеДоставкиОстатки.ВидДоставки КАК ВидДоставки,
	|	УСОERP_ДанныеДоставкиОстатки.Партнер КАК Партнер,
	|	УСОERP_ДанныеДоставкиОстатки.Контрагент КАК Контрагент,
	|	УСОERP_ДанныеДоставкиОстатки.ДатаПоступления КАК ДатаПоступления
	|ИЗ
	|	ВТ_ДанныеТоваровКДоставке КАК ВТ_ДанныеТоваровКДоставке
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УСОERP_ДанныеДоставки.Остатки(
	|				&КонецПериода,
	|				(ЗаказПоставщику, Номенклатура, Характеристика, Организация) В
	|					(ВЫБРАТЬ
	|						ВТ_ДанныеТоваровКДоставке.ЗаказПоставщику,
	|						ВТ_ДанныеТоваровКДоставке.Номенклатура,
	|						ВТ_ДанныеТоваровКДоставке.Характеристика,
	|						ВТ_ДанныеТоваровКДоставке.Организация
	|					ИЗ
	|						ВТ_ДанныеТоваровКДоставке КАК ВТ_ДанныеТоваровКДоставке)) КАК УСОERP_ДанныеДоставкиОстатки
	|		ПО ВТ_ДанныеТоваровКДоставке.ЗаказПоставщику = УСОERP_ДанныеДоставкиОстатки.ЗаказПоставщику
	|			И ВТ_ДанныеТоваровКДоставке.Организация = УСОERP_ДанныеДоставкиОстатки.Организация
	|			И ВТ_ДанныеТоваровКДоставке.Номенклатура = УСОERP_ДанныеДоставкиОстатки.Номенклатура
	|			И ВТ_ДанныеТоваровКДоставке.Характеристика = УСОERP_ДанныеДоставкиОстатки.Характеристика
	|			И (ВТ_ДанныеТоваровКДоставке.АдресОтправления = УСОERP_ДанныеДоставкиОстатки.АдресОтправления
	|					И УСОERP_ДанныеДоставкиОстатки.ЗаказНаДоставку = ЗНАЧЕНИЕ(Документ.УСОERP_ЗаказНаПеревозку.ПустаяСсылка)
	|				ИЛИ УСОERP_ДанныеДоставкиОстатки.ЗаказНаДоставку <> ЗНАЧЕНИЕ(Документ.УСОERP_ЗаказНаПеревозку.ПустаяСсылка)
	|					И ВТ_ДанныеТоваровКДоставке.АдресОтправления = УСОERP_ДанныеДоставкиОстатки.АдресДоставки)
	|			И ВТ_ДанныеТоваровКДоставке.ДатаПоступления = УСОERP_ДанныеДоставкиОстатки.ДатаПоступления
	|ГДЕ
	|	НЕ ВТ_ДанныеТоваровКДоставке.Статус В (ЗНАЧЕНИЕ(Перечисление.УСОERP_СтатусыЗаказаНаПеревозку.Отменен))
	|	И ЕСТЬNULL(УСОERP_ДанныеДоставкиОстатки.КоличествоОстаток, 0) <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеТоваровКДоставке.Регистратор,
	|	УСОERP_ДанныеДоставкиОстатки.АдресДоставки,
	|	ВТ_ДанныеТоваровКДоставке.ЗаказНаДоставку,
	|	ВТ_ДанныеТоваровКДоставке.Организация,
	|	УСОERP_ДанныеДоставкиОстатки.ОжидаемаяДатаДоставки,
	|	ВТ_ДанныеТоваровКДоставке.ЗаказПоставщику,
	|	ВТ_ДанныеТоваровКДоставке.Номенклатура,
	|	УСОERP_ДанныеДоставкиОстатки.АдресОтправления,
	|	ВТ_ДанныеТоваровКДоставке.Период,
	|	ВТ_ДанныеТоваровКДоставке.Характеристика,
	|	УСОERP_ДанныеДоставкиОстатки.ЗаказНаДоставку,
	|	УСОERP_ДанныеДоставкиОстатки.Исполнитель,
	|	УСОERP_ДанныеДоставкиОстатки.ВидДоставки,
	|	УСОERP_ДанныеДоставкиОстатки.Партнер,
	|	УСОERP_ДанныеДоставкиОстатки.Контрагент,
	|	УСОERP_ДанныеДоставкиОстатки.ДатаПоступления,
	|	ЕСТЬNULL(ВТ_ДанныеТоваровКДоставке.Количество, 0)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ДанныеТоваровКДоставке.Регистратор,
	|	ВТ_ДанныеТоваровКДоставке.Период,
	|	ВТ_ДанныеТоваровКДоставке.Организация,
	|	ВТ_ДанныеТоваровКДоставке.ЗаказПоставщику,
	|	ВТ_ДанныеТоваровКДоставке.Номенклатура,
	|	ВТ_ДанныеТоваровКДоставке.Характеристика,
	|	ВТ_ДанныеТоваровКДоставке.Количество,
	|	ВТ_ДанныеТоваровКДоставке.АдресОтправления,
	|	ВТ_ДанныеТоваровКДоставке.АдресДоставки,
	|	ВТ_ДанныеТоваровКДоставке.ОжидаемаяДатаДоставки,
	|	ВТ_ДанныеТоваровКДоставке.ЗаказНаДоставку,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	ВТ_ДанныеТоваровКДоставке.Исполнитель,
	|	ВТ_ДанныеТоваровКДоставке.ВидДоставки,
	|	ВТ_ДанныеТоваровКДоставке.Партнер,
	|	ВТ_ДанныеТоваровКДоставке.Контрагент,
	|	ВТ_ДанныеТоваровКДоставке.ДатаПоступления
	|ИЗ
	|	ВТ_ДанныеТоваровКДоставке КАК ВТ_ДанныеТоваровКДоставке
	|ГДЕ
	|	НЕ ВТ_ДанныеТоваровКДоставке.Статус В (ЗНАЧЕНИЕ(Перечисление.УСОERP_СтатусыЗаказаНаПеревозку.Отменен))
	|	И ВТ_ДанныеТоваровКДоставке.Количество <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ДанныеТоваровКДоставке.Регистратор,
	|	ВТ_ДанныеТоваровКДоставке.Период,
	|	ВТ_ДанныеТоваровКДоставке.Организация,
	|	ВТ_ДанныеТоваровКДоставке.ЗаказПоставщику,
	|	ВТ_ДанныеТоваровКДоставке.Номенклатура,
	|	ВТ_ДанныеТоваровКДоставке.Характеристика,
	|	ВТ_ДанныеТоваровКДоставке.Количество,
	|	ВТ_ДанныеТоваровКДоставке.АдресОтправления,
	|	ВТ_ДанныеТоваровКДоставке.АдресДоставки,
	|	ВТ_ДанныеТоваровКДоставке.ОжидаемаяДатаДоставки,
	|	ВТ_ДанныеТоваровКДоставке.ЗаказНаДоставку,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	ВТ_ДанныеТоваровКДоставке.Исполнитель,
	|	ВТ_ДанныеТоваровКДоставке.ВидДоставки,
	|	ВТ_ДанныеТоваровКДоставке.Партнер,
	|	ВТ_ДанныеТоваровКДоставке.Контрагент,
	|	ВТ_ДанныеТоваровКДоставке.ДатаПоступления
	|ИЗ
	|	ВТ_ДанныеТоваровКДоставке КАК ВТ_ДанныеТоваровКДоставке
	|ГДЕ
	|	ВТ_ДанныеТоваровКДоставке.Статус В (ЗНАЧЕНИЕ(Перечисление.УСОERP_СтатусыЗаказаНаПеревозку.Завершен))
	|	И ВТ_ДанныеТоваровКДоставке.Количество <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Функция возвращает текст запроса для определения реквизитов доставки.
//
// Возвращаемое значение:
//	Строка - Текст запроса
//
Функция ТекстЗапросаРеквизитыДоставки() Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Шапка.Номер             КАК Номер,
	|	Шапка.Проведен          КАК Проведен,
	|	Шапка.Ссылка            КАК Ссылка,
	|	Шапка.Дата              КАК Дата,
	|	Шапка.Партнер           КАК ПолучательОтправитель,
	|	Шапка.Контрагент 		КАК Перевозчик,
	|	ВЫБОР 
	|		КОГДА Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УСОERP_ИсполнителиДоставки.СобственнымиСилами) 
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.НашимиСиламиСАдресаОтправителя)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.ПустаяСсылка) 
	|	КОНЕЦ 					КАК СпособДоставки, 
	|
	|	ЗНАЧЕНИЕ(Справочник.ЗоныДоставки.ПустаяССылка)	КАК Зона,
	|	Шапка.АдресДоставки 							КАК Адрес,
	|	Шапка.АдресДоставкиЗначенияПолей				КАК АдресЗначенияПолей,
	|
	|	ДАТАВРЕМЯ(1,1,1)    	КАК ВремяС,
	|	Шапка.СрокДоставки		КАК ВремяПо,
	|	""""					КАК ДополнительнаяИнформация,
	|	ЗаказКДоставке.Склад	КАК Склад,
	|	ИСТИНА                  КАК ДоставитьПолностью,
	|	ЛОЖЬ КАК ОсобыеУсловияПеревозки,
	|	"""" КАК ОсобыеУсловияПеревозкиОписание
	|
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		ЗаказКДоставке.Ссылка КАК Ссылка,
	|		ЗаказКДоставке.Ссылка.Склад КАК Склад
	|	ИЗ
	|		Документ.УСОERP_ЗаказНаПеревозку.КДоставке КАК ЗаказКДоставке
	|	ГДЕ
	|		ЗаказКДоставке.Ссылка В (&Ссылки)
	|		И ЗаказКДоставке.Номенклатура.ТипНоменклатуры В (ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар), ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара))
	|	) КАК ЗаказКДоставке
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_ЗаказНаПеревозку КАК Шапка
	|		ПО (Шапка.Ссылка = ЗаказКДоставке.Ссылка)";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область СозданиеНаОсновании

// Определяет список команд создания на основании.
//
// Параметры:
//   КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//       См. описание 1 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//   Параметры - Структура - Вспомогательные параметры. Для чтения.
//       См. описание 2 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//
Процедура ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании,НастройкиФормы) Экспорт
	
	
	Документы.ЗаданиеНаПеревозку.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании); 		
	Документы.ПриобретениеУслугПрочихАктивов.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);	
	
КонецПроцедуры

#КонецОбласти 

#Область Отчеты
// Определяет список команд отчетов.
//
// Параметры:
//   КомандыОтчетов - ТаблицаЗначений - Таблица с командами отчетов. Для изменения.
//       См. описание 1 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
//   Параметры - Структура - Вспомогательные параметры. Для чтения.
//       См. описание 2 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
//
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, Параметры) Экспорт
	
	ВариантыОтчетовУТПереопределяемый.ДобавитьКомандуСтруктураПодчиненности(КомандыОтчетов);
	
КонецПроцедуры

#КонецОбласти   

