Процедура ЗарегистрироватьОплатуНДСПоСчетамФактурам(Проведен)
	
	СчетаФактуры = УчетНДСУП.НоваяТаблицаСчетовФактур();
	//++ НЕ УТ
	Для каждого СтрокаТЧ Из РасшифровкаПлатежа Цикл
		СтрокаСчетаФактуры = СчетаФактуры.Добавить();
		СтрокаСчетаФактуры.СчетФактура = СтрокаТЧ.Субконто3;
		СтрокаСчетаФактуры.СуммаОплаты = СтрокаТЧ.Сумма;
	КонецЦикла;
	//-- НЕ УТ
	Если СчетаФактуры.Количество() = 0 Тогда
		СтрокаСчетаФактуры = СчетаФактуры.Добавить();
		СтрокаСчетаФактуры.СчетФактура = ДокументОснование;
		СтрокаСчетаФактуры.СуммаОплаты = СуммаДокумента;
	КонецЕсли;
	
	РеквизитыДокументаОплаты = Новый Структура();
	РеквизитыДокументаОплаты.Вставить("ДатаПеречисленияВБюджет", ДатаПроведенияБанком);
	РеквизитыДокументаОплаты.Вставить("НомерДокумента",          НомерВходящегоДокумента);
	РеквизитыДокументаОплаты.Вставить("ДатаДокумента",           ДатаВходящегоДокумента);
	РеквизитыДокументаОплаты.Вставить("ТипНалога",               ТипНалога);
	
	УчетНДСУП.ЗарегистрироватьОплатуНДСПоСчетамФактурам(СчетаФактуры, Ссылка, РеквизитыДокументаОплаты, Проведен);
	
КонецПроцедуры

