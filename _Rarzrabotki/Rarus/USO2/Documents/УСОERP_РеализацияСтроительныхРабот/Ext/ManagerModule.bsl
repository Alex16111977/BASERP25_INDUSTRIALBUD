	|	ТаблицаРаботы.Ссылка.СценарийПланированияЗаказчика КАК СценарийПланирования,
	|	ВЫБОР КОГДА ТаблицаРаботы.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка) ТОГДА ТаблицаРаботы.Работа ИНАЧЕ ТаблицаРаботы.Работа.РаботаИсточник КОНЕЦ  КАК Работа, 
	|	ТаблицаРаботы.Ссылка.Партнер,
	|	ТаблицаРаботы.Ссылка.Контрагент,
	|	ТаблицаРаботы.Ссылка.Соглашение,
	|	ТаблицаРаботы.Ссылка.Договор,
	|	ТаблицаРаботы.ОбъемРеализации КАК Объем,
	|	ТаблицаРаботы.СуммаСНДС,
	|	ТаблицаРаботы.СуммаНДС
	|ИЗ
	|	Документ.УСОERP_РеализацияСтроительныхРабот.РаботыЗаказчика КАК ТаблицаРаботы
	|ГДЕ
	|	ТаблицаРаботы.ОбъемРеализации <> 0
	|	И ТаблицаРаботы.Ссылка = &Ссылка
	|	И ТаблицаРаботы.Ссылка.ЗаполнятьРаботамиЗаказчика = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаРаботы.НомерСтроки";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса,"ВыполнениеРаботЗаказчикаВнешняя");	
	
	Возврат ТекстЗапроса;  
	
КонецФункции

Функция ТекстЗапросаГрафикДвиженийПоДоговору(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "УСОERP_ГрафикДвиженийПоДоговору";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.ВидДвижения КАК ВидДвижения,
	|	ВложенныйЗапрос.Период КАК Период,
	|	ВложенныйЗапрос.Организация КАК Организация,
	|	ВложенныйЗапрос.Партнер КАК Партнер,
	|	ВложенныйЗапрос.Соглашение КАК Соглашение,
	|	ВложенныйЗапрос.Контрагент КАК Контрагент,
	|	ВложенныйЗапрос.Договор КАК Договор,
	|	МАКСИМУМ(&Период) КАК ДатаСобытияПоДоговору,
	|	ВложенныйЗапрос.ПорядокДоходовРасходов КАК ПорядокДоходовРасходов,
	|	ВложенныйЗапрос.ВидРабот КАК ВидРабот,
	|	ВложенныйЗапрос.Работа КАК Работа,
	|	СУММА(ВложенныйЗапрос.ПорядокДоходовРасходовФакт) КАК ПорядокДоходовРасходовФакт,
	|	ВложенныйЗапрос.ОбъектСтроительства КАК ОбъектСтроительства,
	|	ВложенныйЗапрос.СтатьяБюджета КАК СтатьяБюджета,
	|	ВложенныйЗапрос.ВидОперации КАК ВидОперации,
	|	СУММА(ВложенныйЗапрос.ПорядокДоходовРасходовПлан) КАК ПорядокДоходовРасходовПлан
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|		1 КАК ВидОперации,
	|		&Период КАК Период,
	|		&Организация КАК Организация,
	|		&Партнер КАК Партнер,
	|		&Соглашение КАК Соглашение,
	|		&Контрагент КАК Контрагент,
	|		&Договор КАК Договор,
	|		ЗНАЧЕНИЕ(Перечисление.УСОERP_ПорядокДоходовРасходов.Реализация) КАК ПорядокДоходовРасходов,
	|		ВЫБОР
	|			КОГДА &ПоВидуРабот
	|				ТОГДА Данные.Работа.ВидРабот
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ КАК ВидРабот,
	|		ВЫБОР
	|			КОГДА &ПоРаботам
	|				ТОГДА ВЫБОР
	|						КОГДА Данные.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|							ТОГДА Данные.Работа
	|						ИНАЧЕ Данные.Работа.РаботаИсточник
	|					КОНЕЦ
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ КАК Работа,
	|		Данные.СуммаСНДС КАК ПорядокДоходовРасходовФакт,
	|		0 КАК ПорядокДоходовРасходовПлан,
	|		&ОбъектСтроительства КАК ОбъектСтроительства,
	|		Данные.СтатьяБюджета КАК СтатьяБюджета
	|	ИЗ
	|		Документ.УСОERP_РеализацияСтроительныхРабот.Работы КАК Данные
	|	ГДЕ
	|		Данные.Ссылка = &Ссылка
	|		И НЕ Данные.Работа.СуммарнаяРабота
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|		2,
	|		&Период,
	|		&Организация,
	|		&Партнер,
	|		&Соглашение,
	|		&Контрагент,
	|		&Договор,
	|		ЗНАЧЕНИЕ(Перечисление.УСОERP_ПорядокДоходовРасходов.Реализация),
	|		ВЫБОР
	|			КОГДА &ПоВидуРабот
	|				ТОГДА Данные.Работа.ВидРабот
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА &ПоРаботам
	|				ТОГДА ВЫБОР
	|						КОГДА Данные.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|							ТОГДА Данные.Работа
	|						ИНАЧЕ Данные.Работа.РаботаИсточник
	|					КОНЕЦ
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ,
	|		Данные.СуммаСНДС,
	|		0,
	|		&ОбъектСтроительства,
	|		Данные.СтатьяБюджета
	|	ИЗ
	|		Документ.УСОERP_РеализацияСтроительныхРабот.Работы КАК Данные
	|	ГДЕ
	|		Данные.Ссылка = &Ссылка
	|		И НЕ Данные.Работа.СуммарнаяРабота
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|		3,
	|		&Период,
	|		&Организация,
	|		&Партнер,
	|		&Соглашение,
	|		&Контрагент,
	|		&Договор,
	|		ЗНАЧЕНИЕ(Перечисление.УСОERP_ПорядокДоходовРасходов.Реализация),
	|		ВЫБОР
	|			КОГДА &ПоВидуРабот
	|				ТОГДА Данные.Работа.ВидРабот
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА &ПоРаботам
	|				ТОГДА ВЫБОР
	|						КОГДА Данные.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|							ТОГДА Данные.Работа
	|						ИНАЧЕ Данные.Работа.РаботаИсточник
	|					КОНЕЦ
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ,
	|		0,
	|		Данные.СуммаСНДС,
	|		&ОбъектСтроительства,
	|		Данные.СтатьяБюджета
	|	ИЗ
	|		Документ.УСОERP_РеализацияСтроительныхРабот.Работы КАК Данные
	|	ГДЕ
	|		Данные.Ссылка = &Ссылка
	|		И НЕ Данные.Работа.СуммарнаяРабота) КАК ВложенныйЗапрос
	|ГДЕ
	|	&ДвиженияПоАналитике = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ВидДвижения,
	|	ВложенныйЗапрос.Период,
	|	ВложенныйЗапрос.Организация,
	|	ВложенныйЗапрос.Партнер,
	|	ВложенныйЗапрос.Соглашение,
	|	ВложенныйЗапрос.Контрагент,
	|	ВложенныйЗапрос.Договор,
	|	ВложенныйЗапрос.ПорядокДоходовРасходов,
	|	ВложенныйЗапрос.ВидРабот,
	|	ВложенныйЗапрос.Работа,
	|	ВложенныйЗапрос.ОбъектСтроительства,
	|	ВложенныйЗапрос.СтатьяБюджета,
	|	ВложенныйЗапрос.ВидОперации";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса,ИмяРегистра);	
	
	Возврат ТекстЗапроса;

