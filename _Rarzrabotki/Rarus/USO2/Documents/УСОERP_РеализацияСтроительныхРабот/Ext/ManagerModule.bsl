	|	НЕОПРЕДЕЛЕНО 				КАК ИдентификаторСтроки,
	|
	|	Строки.СуммаГУ 																КАК Сумма,
	
	|	Строки.СуммаГУ / КурсВалютыУпрУчета.Курс 									КАК СуммаУУ,
	
	|
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСКлиентами) 				КАК ВидСчетаДт,
	|	НЕОПРЕДЕЛЕНО															 	КАК АналитикаУчетаДт,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) 									КАК МестоУчетаДт,
	|
	|	Операция.ВалютаВзаиморасчетов 												КАК ВалютаДт,
	|	ЕСТЬNULL(Расчеты.Подразделение, Операция.Подразделение) 					КАК ПодразделениеДт,
	|	Строки.НаправлениеДеятельности  											КАК НаправлениеДеятельностиДт,
	|	Значение(ПланСчетов.Хозрасчетный.РасчетыСПокупателямиПоГарантийнымУдержаниям) КАК СчетДт,
	|
	|	Операция.Контрагент 														КАК СубконтоДт1,
	|	ДопПараметры.Регистратор.ДоговорГарантийногоУдержания						КАК СубконтоДт2,
	|	НЕОПРЕДЕЛЕНО 																КАК СубконтоДт3,
	|
	|	0															 				КАК ВалютнаяСуммаДт,
	|	0 																			КАК КоличествоДт,
	|	Строки.СуммаГУ													 			КАК СуммаНУДт,
	|	0 																			КАК СуммаПРДт,
	|	0																			КАК СуммаВРДт,
	|
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСКлиентами) 				КАК ВидСчетаКт,
	|	ЕСТЬNULL(Расчеты.ГруппаФинансовогоУчета, Операция.ГруппаФинансовогоУчета)	КАК АналитикаУчетаКт,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) 									КАК МестоУчетаКт,
	|
	|	Операция.ВалютаВзаиморасчетов   											КАК ВалютаКт,
	|	ЕСТЬNULL(Расчеты.Подразделение, Операция.Подразделение)						КАК ПодразделениеКт,
	|	Строки.НаправлениеДеятельности 												КАК НаправлениеДеятельностиКт,
	|	Значение(ПланСчетов.Хозрасчетный.РасчетыСПокупателями)   					КАК СчетКт,
	|
	|	Операция.Контрагент															КАК СубконтоКт1,
	|	Операция.Договор 															КАК СубконтоКт2,
	|	НЕОПРЕДЕЛЕНО        														КАК СубконтоКт3,
	|
	|	0																			КАК ВалютнаяСуммаКт,
	|	0 																			КАК КоличествоКт,
	|	Строки.СуммаГУ													 			КАК СуммаНУКт,
	|	0 																			КАК СуммаПРКт,
	|	0																			КАК СуммаВРКт,
	|	"""" 																		КАК Содержание
	|ИЗ
	|	Документ.УСОERP_РеализацияСтроительныхРабот КАК Операция
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_РеализацияСтроительныхРабот.ВыполненоВсего КАК Строки
	|		ПО (Строки.Ссылка = Операция.Ссылка)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_ДополнительныеПараметрыПоДоговору.СрезПоследних(
	|				,
	|				(Договор, ОбъектСтроительства) В
	|					(ВЫБРАТЬ
	|						УСОERP_РеализацияСтроительныхРабот.Договор КАК Договор,
	|						УСОERP_РеализацияСтроительныхРабот.ОбъектСтроительства КАК ОбъектСтроительства
	|					ИЗ
	|						Документ.УСОERP_РеализацияСтроительныхРабот КАК УСОERP_РеализацияСтроительныхРабот
	|					ГДЕ
	|						УСОERP_РеализацияСтроительныхРабот.Ссылка = &Ссылка)) КАК ДопПараметры
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммыДокументовВВалютеРегл КАК Суммы
	|		ПО (Суммы.Регистратор = Строки.Ссылка)
	|	          И Суммы.ИдентификаторСтроки = Строки.ИдентификаторСтроки

	//|			И (Суммы.СуммаБезНДСРегл <> 0)
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
	|			Расчеты.ЗаказКлиента.Подразделение КАК Подразделение,
	|			Расчеты.ЗаказКлиента.ГруппаФинансовогоУчета КАК ГруппаФинансовогоУчета
	|		ИЗ
	|			РегистрНакопления.РасчетыСКлиентами КАК Расчеты
	|		ГДЕ
	|			Расчеты.Регистратор = &Ссылка) КАК Расчеты
	|		ПО (ИСТИНА)
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ
	|			КурсыВалют КАК КурсВалютыУпрУчета
	|		ПО
	|			КурсВалютыУпрУчета.Валюта = &ВалютаУпрУчета
	|			И КурсВалютыУпрУчета.Дата = НАЧАЛОПЕРИОДА(Операция.Дата, День)
	|
	|ГДЕ
	|	Операция.Ссылка = &Ссылка И Строки.СуммаГУ <> 0
	|	И (Строки.Номенклатура.Принципал = НЕОПРЕДЕЛЕНО
	|			ИЛИ Строки.Номенклатура.Принципал = Операция.Организация)
	|	И (ЕСТЬNULL(Строки.Характеристика.Принципал, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
	|			ИЛИ ЕСТЬNULL(Строки.Характеристика.Принципал, Операция.Организация) = Операция.Организация)";
	//|	И НЕ Операция.ОтложенныйНДС";
	
	Возврат ТекстЗавершениеРабот;
	
КонецФункции

// Функция возвращает текст запроса дополнительных временных таблиц, 
// необходимых для отражения в регламетированном учете
//
Функция ТекстЗапросаВТОтраженияВРеглУчете() Экспорт
	
	ТекстЗапроса = "";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	ИнициализироватьКлючиАналитикиНоменклатуры(Запрос);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстЗапросаВтТаблицаРаботы(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаВтАналитика(Запрос, ТекстыЗапроса);
	ТекстЗапросаВтРаботыУслуги(Запрос, ТекстыЗапроса);
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} {
	ТекстЗапросаТаблицаСебестоимостьТоваров(Запрос, ТекстыЗапроса, Регистры);
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} }
	ТекстЗапросаТаблицаВыполнениеРаботЗаказчика(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаВыполнениеПринятие(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаВыручкаИСебестоимостьПродаж(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаНДСЗаписиКнигиПродаж(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаРасчетыСКлиентами(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаВыполнениеПоПозициямСметы(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаВыполнениеРаботЗаказчикаВнешняя(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаГрафикДвиженийПоДоговору(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаСуммыДокументовВВалютеРегл(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаДанныеОснованийСчетовФактур(Запрос, ТекстыЗапроса, Регистры);
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} {
	ТекстЗапросаТаблицаМатериалыИРаботыВПроизводстве(Запрос, ТекстыЗапроса, Регистры);
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} }
	
	ПроведениеСерверУТ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_РеализацияСтроительныхРабот.Дата КАК Период,
	|	УСОERP_РеализацияСтроительныхРабот.ДатаНачалаПериода,
	|	УСОERP_РеализацияСтроительныхРабот.Ссылка КАК Ссылка,
	|	УСОERP_РеализацияСтроительныхРабот.ОбъектСтроительства,
	|	УСОERP_РеализацияСтроительныхРабот.Организация КАК Организация,
	|	УСОERP_РеализацияСтроительныхРабот.Контрагент КАК Контрагент,
	|	УСОERP_РеализацияСтроительныхРабот.Договор КАК Договор,
	|	УСОERP_РеализацияСтроительныхРабот.Партнер КАК Партнер,
	|	УСОERP_РеализацияСтроительныхРабот.Соглашение КАК Соглашение,
	|	УСОERP_РеализацияСтроительныхРабот.Подразделение,
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} {
	|	УСОERP_РеализацияСтроительныхРабот.Договор.ДопустимаяСуммаЗадолженности КАК ДопустимаяСуммаЗадолженности,
	|	УСОERP_РеализацияСтроительныхРабот.НалогообложениеНДС КАК НалогообложениеНДС
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} }
	|ИЗ
	|	Документ.УСОERP_РеализацияСтроительныхРабот КАК УСОERP_РеализацияСтроительныхРабот
	|ГДЕ
	|	УСОERP_РеализацияСтроительныхРабот.Ссылка = &Ссылка";
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	
	Реквизиты.Следующий();
	
	Коэффициенты = РаботаСКурсамивалютУТ.ПолучитьКоэффициентыПересчетаВалюты(ДокументСсылка.Валюта, ДокументСсылка.ВалютаВзаиморасчетов, ДокументСсылка.Дата);
	
	Запрос.УстановитьПараметр("ОбъектСтроительства",	Реквизиты.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Период",					Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация",			Реквизиты.Организация);
	Запрос.УстановитьПараметр("Контрагент",				Реквизиты.Контрагент);
	Запрос.УстановитьПараметр("Договор",				Реквизиты.Договор);
	Запрос.УстановитьПараметр("Партнер",				Реквизиты.Партнер);
	Запрос.УстановитьПараметр("Соглашение",				Реквизиты.Соглашение);
	Запрос.УстановитьПараметр("Подразделение",			Реквизиты.Подразделение);
	Запрос.УстановитьПараметр("Период",					Реквизиты.Период);
	Запрос.УстановитьПараметр("ДатаНачалаПериода",		Реквизиты.ДатаНачалаПериода);
	Запрос.УстановитьПараметр("ДопустимаяСуммаЗадолженности",				Реквизиты.ДопустимаяСуммаЗадолженности);
	Запрос.УстановитьПараметр("ХозяйственнаяОперация",						Перечисления.ХозяйственныеОперации.РеализацияКлиенту);
	Запрос.УстановитьПараметр("КоэффициентПересчетаВВалютуУПР",  			Коэффициенты.КоэффициентПересчетаВВалютуУПР);
	Запрос.УстановитьПараметр("КоэффициентПересчетаВВалютуРегл", 			Коэффициенты.КоэффициентПересчетаВВалютуРегл);
	Запрос.УстановитьПараметр("АналитикаУчетаПоПартнерам",       			РегистрыСведений.АналитикаУчетаПоПартнерам.ЗначениеКлючаАналитики(ДокументСсылка));
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", 			Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("АналитикаУчетаПоПартнерамГУ",       	РегистрыСведений.АналитикаУчетаПоПартнерам.ЗначениеКлючаАналитики(Новый Структура("Организация, Партнер, Контрагент, Договор, НаправлениеДеятельности", ДокументСсылка.Организация, ДокументСсылка.Партнер, 
	ДокументСсылка.Контрагент, УСОERP_УправлениеСтроительнымПроизводством.НайтиДоговорГарантийногоУдержания(ДокументСсылка.ОбъектСтроительства, ДокументСсылка.Договор, ДокументСсылка.Дата), ДокументСсылка.НаправлениеДеятельности)));
	
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} {
	Запрос.УстановитьПараметр("НалогообложениеНДС", 	Реквизиты.НалогообложениеНДС);
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} }
	
	ПоВидуРабот = Ложь;
	ПоРаботам = Ложь;
	
	ЗапросДопПараметры = Новый Запрос;
	
	ЗапросДопПараметры.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Ссылка КАК ДополнительныеПараметрыПоДоговору
	|ИЗ
	|	Документ.УСОERP_ДополнительныеПараметрыПоДоговору КАК УСОERP_ДополнительныеПараметрыПоДоговору
	|ГДЕ
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Договор = &Договор
	|	И НЕ УСОERP_ДополнительныеПараметрыПоДоговору.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Дата УБЫВ";
	
	ЗапросДопПараметры.УстановитьПараметр("Договор",Реквизиты.Договор);
	
	Выборка = ЗапросДопПараметры.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ПоВидуРабот = Выборка.ДополнительныеПараметрыПоДоговору.ПоВидамРабот;
		ПоРаботам =  Выборка.ДополнительныеПараметрыПоДоговору.ПоРаботам;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ПоВидуРабот",ПоВидуРабот);
	Запрос.УстановитьПараметр("ПоРаботам",ПоРаботам);
	Запрос.УстановитьПараметр("ДвиженияПоАналитике",НЕ ЗначениеЗаполнено(Документы.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.НайтиПоРеквизиту("ДокументОснование", ДокументСсылка)));
	Запрос.УстановитьПараметр("ВалютаВзаиморасчетов",   ДокументСсылка.ВалютаВзаиморасчетов);
	Запрос.УстановитьПараметр("Валюта"              ,   ДокументСсылка.Валюта);
	Запрос.УстановитьПараметр("ВалютаУправленческогоУчета",         Константы.ВалютаУправленческогоУчета.Получить());
	Запрос.УстановитьПараметр("Номер",					ДокументСсылка.Номер); 	
	Запрос.УстановитьПараметр("ГрафикИсполненияВДоговоре",Ложь);
	Запрос.УстановитьПараметр("РасчетыПоДоговорам",Истина);
	Запрос.УстановитьПараметр("РасчетыПоНакладным",Ложь);
	Запрос.УстановитьПараметр("ФормаОплаты",ДокументСсылка.ФормаОплаты); 
	//Запрос.УстановитьПараметр("ДопустимаяСуммаЗадолженности",ДокументСсылка.Договор.ДопустимаяСуммаЗадолженности*ДокументСсылка.Договор.ОграничиватьСуммуЗадолженности);
	Запрос.УстановитьПараметр("СуммаДокумента",ДокументСсылка.СуммаДокумента);
	Запрос.УстановитьПараметр("СуммаВзаиморасчетов",ДокументСсылка.СуммаВзаиморасчетов);
	Запрос.УстановитьПараметр("Утвержден",ДокументСсылка.Статус = Перечисления.СтатусыПланов.Утвержден);
	Запрос.УстановитьПараметр("ТипСчетаФактуры",				ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ.СчетФактураВыданный"));
	
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} {
	Запрос.УстановитьПараметр("ТолкающееНазначение", НаправленияДеятельностиСервер.ТолкающееНазначение(ДокументСсылка.НаправлениеДеятельности));
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} }
	
КонецПроцедуры

Процедура ИнициализироватьКлючиАналитикиНоменклатуры(Запрос)
	
	ЗапросАналитик = Новый Запрос("
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Таблица.Номенклатура КАК Номенклатура,
	|	Таблица.Характеристика КАК Характеристика,
	|	Таблица.Серия КАК Серия,
	|	Таблица.Назначение КАК Назначение,
	|	Таблица.СтатьяКалькуляции КАК СтатьяКалькуляции,
	|	Таблица.Склад КАК Склад
	|ИЗ
	|	(	
	|		ВЫБРАТЬ
	|			ТаблицаВыполнено.Номенклатура 	КАК Номенклатура,
	|			ТаблицаВыполнено.Характеристика КАК Характеристика,
	|			ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК Серия,
	|			ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК Назначение,
	|			ЗНАЧЕНИЕ(Справочник.СтатьиКалькуляции.ПустаяСсылка) КАК СтатьяКалькуляции,
	|			ВЫБОР
	|				КОГДА ТаблицаВыполнено.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|					ТОГДА ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|				ИНАЧЕ &Подразделение
	|			КОНЕЦ КАК Склад
	|		ИЗ
	|			Документ.УСОERP_РеализацияСтроительныхРабот.ВыполненоВсего КАК ТаблицаВыполнено
	|		ГДЕ
	|			ТаблицаВыполнено.Ссылка = &Ссылка
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			ТаблицаВыполнено.Номенклатура 	КАК Номенклатура,
	|			ТаблицаВыполнено.Характеристика КАК Характеристика,
	|			ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК Серия,
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} {
	|			&ТолкающееНазначение КАК Назначение,
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} }
	|			ЗНАЧЕНИЕ(Справочник.СтатьиКалькуляции.ПустаяСсылка) КАК СтатьяКалькуляции,
	|			&Подразделение КАК Склад
	|		ИЗ
	|			Документ.УСОERP_РеализацияСтроительныхРабот.ВыполненоВсего КАК ТаблицаВыполнено
	|		ГДЕ
	|			ТаблицаВыполнено.Ссылка = &Ссылка
	|			И ТаблицаВыполнено.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			ТаблицаВыполнено.Номенклатура 	КАК Номенклатура,
	|			ТаблицаВыполнено.Характеристика КАК Характеристика,
	|			ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК Серия,
	|			ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК Назначение,
	|			ЗНАЧЕНИЕ(Справочник.СтатьиКалькуляции.ПустаяСсылка) КАК СтатьяКалькуляции,
	|			ЕСТЬNULL(ТаблицаВыполнено.Характеристика.Принципал, СпрНоменклатура.Принципал) КАК Склад
	|		ИЗ
	|			Документ.УСОERP_РеализацияСтроительныхРабот.ВыполненоВсего КАК ТаблицаВыполнено
	|
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|			ПО СпрНоменклатура.Ссылка = ТаблицаВыполнено.Номенклатура
	|
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаНоменклатуры КАК Аналитика
	|			ПО ТаблицаВыполнено.Номенклатура = Аналитика.Номенклатура
	|				И ТаблицаВыполнено.Характеристика = Аналитика.Характеристика
	|				И ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) = Аналитика.Серия
	|				И ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) = Аналитика.Назначение
	|				И ЕСТЬNULL(ТаблицаВыполнено.Характеристика.Принципал, СпрНоменклатура.Принципал) = Аналитика.МестоХранения
	|				И ЗНАЧЕНИЕ(Справочник.СтатьиКалькуляции.ПустаяСсылка) = Аналитика.СтатьяКалькуляции
	|		ГДЕ
	|			ТаблицаВыполнено.Ссылка = &Ссылка
	|			И ЕСТЬNULL(ТаблицаВыполнено.Характеристика.Принципал, СпрНоменклатура.Принципал) <> НЕОПРЕДЕЛЕНО
	|			И ЕСТЬNULL(ТаблицаВыполнено.Характеристика.Принципал, СпрНоменклатура.Принципал) <> &Организация
	|			И Аналитика.КлючАналитики ЕСТЬ NULL
	|			И СпрНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|	) КАК Таблица
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаНоменклатуры КАК Аналитика
	|	ПО Аналитика.Номенклатура = Таблица.Номенклатура
	|		И Аналитика.Характеристика = Таблица.Характеристика
	|		И Аналитика.Серия = Таблица.Серия
	|		И Аналитика.Назначение = Таблица.Назначение
	|		И Аналитика.СтатьяКалькуляции = Таблица.СтатьяКалькуляции
	|		И Аналитика.МестоХранения = Таблица.Склад
	|ГДЕ
	|	Аналитика.Номенклатура ЕСТЬ NULL
	|");
	ЗапросАналитик.УстановитьПараметр("Ссылка",        Запрос.Параметры.Ссылка);
	ЗапросАналитик.УстановитьПараметр("Подразделение", Запрос.Параметры.Подразделение);
	ЗапросАналитик.УстановитьПараметр("Организация",   Запрос.Параметры.Организация);
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} {
	ЗапросАналитик.УстановитьПараметр("ТолкающееНазначение", Запрос.Параметры.ТолкающееНазначение);
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} }
	
	Выборка = ЗапросАналитик.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		РегистрыСведений.АналитикаУчетаНоменклатуры.СоздатьКлючАналитики(Выборка);
	КонецЦикла;
	
КонецПроцедуры

