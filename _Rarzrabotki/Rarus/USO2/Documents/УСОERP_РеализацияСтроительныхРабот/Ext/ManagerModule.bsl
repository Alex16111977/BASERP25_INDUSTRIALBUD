
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает текст запроса для расчета необходимости ввода счета-фактуры выданного.
//	Возвращаемое значение:
//		Строка - текст запроса
//
Функция ТекстЗапросаДляРасчетаНеобходимостиСчетаФактуры() Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка      КАК Основание,
	|	ДанныеДокумента.Дата        КАК ДатаДокумента,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.Контрагент  КАК Контрагент,
	|	ДанныеДокумента.Валюта      КАК Валюта,
	|	ВЫБОР
	|		КОГДА ТаблицаСчетовФактуры.СчетФактура ЕСТЬ NULL 
	|				И ДанныеДокумента.Проведен
	|				И %ТекстУсловия%
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ                       КАК Требуется
	|//ОператорПОМЕСТИТЬ
	|ИЗ
	|	Документ.УСОERP_РеализацияСтроительныхРабот КАК ДанныеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаСчетовФактуры КАК ТаблицаСчетовФактуры
	|		ПО ДанныеДокумента.Ссылка = ТаблицаСчетовФактуры.Основание
	|			И ДанныеДокумента.Организация = ТаблицаСчетовФактуры.Организация
	|			И ДанныеДокумента.Контрагент = ТаблицаСчетовФактуры.Контрагент
	|ГДЕ
	|	ДанныеДокумента.Ссылка В (&МассивОснований)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ТекстУсловия%", ТекстУсловияТребуетсяСчетФактура());
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Возвращает текст условия запроса, по которым документу требуется счет-фактура.
// Условие применяется для таблица "ДанныеДокумента", содержащую реквизиты документа.
//
// Параметры:
//	 ОграничитьПоТипуНалогообложения - Булево - Добавляет ограничительное условие на тип налогообложения.
//		см. РегистрыСведений.ТребуетсяОформлениеСчетаФактуры.МассивТиповНалогообложенияНДСТребуемыхОформления()
//
//	Возвращаемое значение:
//		Строка - текст условия запроса
//
Функция ТекстУсловияТребуетсяСчетФактура(ОграничитьПоТипуНалогообложения = Истина) Экспорт
	
	ТекстУсловия = "ИСТИНА";
	
	//Если ОграничитьПоТипуНалогообложения Тогда
	//	ТекстУсловия = "ДанныеДокумента.НалогообложениеНДС В (&ТипыНалогообложения)";
	//КонецЕсли;
	
	Возврат ТекстУсловия;
	
КонецФункции

#КонецОбласти

#Область ПроведениеПоРеглУчету

// Функция возвращает текст запроса для отражения документа в регламентированном учете.
//
// Возвращаемое значение:
//	Строка - Текст запроса
//
Функция ТекстОтраженияВРеглУчете() Экспорт
	
	Возврат ТекстЗавершениеРабот();
	
КонецФункции

Функция ТекстЗавершениеРабот()
	
	ТекстЗавершениеРабот = 
	"ВЫБРАТЬ
	|	Операция.Ссылка 		КАК Ссылка,
	|	Операция.Дата 			КАК Период,
	|	Операция.Организация 	КАК Организация,
	|	НЕОПРЕДЕЛЕНО 			КАК ИдентификаторСтроки,
	|	ЕСТЬNULL(Суммы.СуммаБезНДСРегл + Суммы.СуммаНДСРегл, Строки.Сумма) 			КАК Сумма,
	
	|	ЕСТЬNULL(Суммы.СуммаБезНДСУпр + Суммы.СуммаНДСУпр, Строки.Сумма / КурсВалютыУпрУчета.Курс) КАК СуммаУУ,
	
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСКлиентами) 				КАК ВидСчетаДт,
	|	ЕСТЬNULL(Расчеты.ГруппаФинансовогоУчета, Операция.ГруппаФинансовогоУчета) 	КАК АналитикаУчетаДт,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) 				КАК МестоУчетаДт,
	|	Операция.ВалютаВзаиморасчетов 							КАК ВалютаДт,
	|	ЕСТЬNULL(Расчеты.Подразделение, Операция.Подразделение) КАК ПодразделениеДт,
	|	Операция.НаправлениеДеятельности 						КАК НаправлениеДеятельностиДт,
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСПокупателями) 	КАК СчетДт,
	|	Операция.Контрагент 	КАК СубконтоДт1,
	|	Операция.Договор 		КАК СубконтоДт2,
	|	НЕОПРЕДЕЛЕНО 			КАК СубконтоДт3,
	|	0 						КАК ВалютнаяСуммаДт,
	|	0 						КАК КоличествоДт,
	|	ЕСТЬNULL(Суммы.СуммаБезНДСРегл + Суммы.СуммаНДСРегл, Строки.Сумма) КАК СуммаНУДт,
	|	0 						КАК СуммаПРДт,
	|	0 						КАК СуммаВРДт,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка) 					КАК ВидСчетаКт,
	|	ЕСТЬNULL(Расчеты.ГруппаФинансовогоУчета, Операция.ГруппаФинансовогоУчета) 	КАК АналитикаУчетаКт,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) 									КАК МестоУчетаКт,
	|	НЕОПРЕДЕЛЕНО 																КАК ВалютаКт,
	|	ЕСТЬNULL(Расчеты.Подразделение, Операция.Подразделение) 					КАК ПодразделениеКт,
	|	Строки.НаправлениеДеятельности 												КАК НаправлениеДеятельностиКт,
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВыполненныеЭтапыПоНезавершеннымРаботам) 	КАК СчетКт,
	|	Операция.Контрагент 	КАК СубконтоКт1,
	|	Операция.Договор 		КАК СубконтоКт2,
	|	ВЫБОР
	|		КОГДА Строки.НоменклатурнаяГруппа <> ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаНоменклатуры.ПустаяСсылка)
	|			ТОГДА Строки.НоменклатурнаяГруппа
	|		ИНАЧЕ Операция.ГруппаФинансовогоУчета
	|	КОНЕЦ 					КАК СубконтоКт3,
	|	0 						КАК ВалютнаяСуммаКт,
	|	0 						КАК КоличествоКт,
	|	ЕСТЬNULL(Суммы.СуммаБезНДСРегл, Строки.Сумма-Строки.СуммаНДС) КАК СуммаНУКт,
	|	0 						КАК СуммаПРКт,
	|	0 						КАК СуммаВРКт,
	|	"""" 					КАК Содержание
	|ИЗ
	|	Документ.УСОERP_РеализацияСтроительныхРабот КАК Операция
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_РеализацияСтроительныхРабот.ВыполненоВсего КАК Строки
	|		ПО (Строки.Ссылка = Операция.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммыДокументовВВалютеРегл КАК Суммы
	|		ПО (Суммы.Регистратор = Строки.Ссылка)
	|	          И Суммы.ИдентификаторСтроки = Строки.ИдентификаторСтроки
	//|			И (Суммы.СуммаБезНДСРегл <> 0)
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
	|			Расчеты.ЗаказКлиента.Подразделение КАК Подразделение,
	|			Расчеты.ЗаказКлиента.ГруппаФинансовогоУчета КАК ГруппаФинансовогоУчета
	|		ИЗ
	|			РегистрНакопления.РасчетыСКлиентами КАК Расчеты
	|		ГДЕ
	|			Расчеты.Регистратор = &Ссылка) КАК Расчеты
	|		ПО (ИСТИНА)
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ
	|			КурсыВалют КАК КурсВалютыУпрУчета
	|		ПО
	|			КурсВалютыУпрУчета.Валюта = &ВалютаУпрУчета
	|			И КурсВалютыУпрУчета.Дата = НАЧАЛОПЕРИОДА(Операция.Дата, День)
	|
	|ГДЕ
	|	Операция.Ссылка = &Ссылка
	|	И (Строки.Номенклатура.Принципал = НЕОПРЕДЕЛЕНО
	|			ИЛИ Строки.Номенклатура.Принципал = Операция.Организация)
	|	И (ЕСТЬNULL(Строки.Характеристика.Принципал, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
	|			ИЛИ ЕСТЬNULL(Строки.Характеристика.Принципал, Операция.Организация) = Операция.Организация)
	|	И Операция.ОтложенныйНДС";
	
	ТекстЗавершениеРабот = ТекстЗавершениеРабот +  " ОБЪЕДИНИТЬ ВСЕ " +
	"ВЫБРАТЬ //// (Дт <46> :: Кт <90.1>)
	|	Операция.Ссылка 			КАК Ссылка,
	|	Операция.Дата 				КАК Период,
	|	Операция.Организация 		КАК Организация,
	|	НЕОПРЕДЕЛЕНО 				КАК ИдентификаторСтроки,
	|
	|	0 							КАК Сумма,
	
	|	0 							КАК СуммаУУ,
	
	|
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка) 					КАК ВидСчетаДт,
	|	ЕСТЬNULL(Расчеты.ГруппаФинансовогоУчета, Операция.ГруппаФинансовогоУчета) 	КАК АналитикаУчетаДт,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) 									КАК МестоУчетаДт,
	|
	|	НЕОПРЕДЕЛЕНО				 												КАК ВалютаДт,
	|	ЕСТЬNULL(Расчеты.Подразделение, Операция.Подразделение) 					КАК ПодразделениеДт,
	|	Строки.НаправлениеДеятельности 												КАК НаправлениеДеятельностиДт,
	|	Значение(ПланСчетов.Хозрасчетный.ВыполненныеЭтапыПоНезавершеннымРаботам) 	КАК СчетДт,
	|
	|	Операция.Контрагент 														КАК СубконтоДт1,
	|	Операция.Договор 															КАК СубконтоДт2,
	|	ВЫБОР 
	|		КОГДА Строки.НоменклатурнаяГруппа <> ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаНоменклатуры.ПустаяСсылка) 
	|			ТОГДА Строки.НоменклатурнаяГруппа
	|			ИНАЧЕ Операция.ГруппаФинансовогоУчета
	|	КОНЕЦ																		КАК СубконтоДт3,
	|
	|	0																			КАК ВалютнаяСуммаДт,
	|	0																			КАК КоличествоДт,
	|	0																			КАК СуммаНУДт,
	|	0																			КАК СуммаПРДт,
	|	0																			КАК СуммаВРДт,
	|
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ВыручкаОтПродаж) 					КАК ВидСчетаКт,
	|	ВЫБОР 
	|		КОГДА Строки.НоменклатурнаяГруппа <> ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаНоменклатуры.ПустаяСсылка) 
	|			ТОГДА Строки.НоменклатурнаяГруппа
	|			ИНАЧЕ Операция.НоменклатурнаяГруппа
	|	КОНЕЦ																		КАК АналитикаУчетаКт,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) 									КАК МестоУчетаКт,
	|
	|	НЕОПРЕДЕЛЕНО 																КАК ВалютаКт,
	|	Операция.Подразделение 														КАК ПодразделениеКт,
	|	Строки.НаправлениеДеятельности 												КАК НаправлениеДеятельностиКт,
	|	НЕОПРЕДЕЛЕНО 																КАК СчетКт,
	|
	|	ВЫБОР 
	|		КОГДА Строки.НоменклатурнаяГруппа <> ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаНоменклатуры.ПустаяСсылка) 
	|			ТОГДА Строки.НоменклатурнаяГруппа
	|			ИНАЧЕ Операция.ГруппаФинансовогоУчета
	|	КОНЕЦ																		КАК СубконтоКт1,
	|	Строки.СтавкаНДС 															КАК СубконтоКт2,
	|	Строки.Номенклатура 														КАК СубконтоКт3,
	|
	|	0																			КАК ВалютнаяСуммаКт,
	|	0 																			КАК КоличествоКт,
	|	ЕСТЬNULL(Суммы.СуммаБезНДСРегл, Строки.Сумма-Строки.СуммаНДС) 			    КАК СуммаНУКт,
	|	0 																			КАК СуммаПРКт,
	|	-ЕСТЬNULL(Суммы.СуммаБезНДСРегл, Строки.Сумма-Строки.СуммаНДС) 		        КАК СуммаВРКт,
	|	"""" 																		КАК Содержание
	|ИЗ
	|	Документ.УСОERP_РеализацияСтроительныхРабот КАК Операция
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_РеализацияСтроительныхРабот.ВыполненоВсего КАК Строки
	|		ПО (Строки.Ссылка = Операция.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммыДокументовВВалютеРегл КАК Суммы
	|		ПО (Суммы.Регистратор = Строки.Ссылка)
	|	          И Суммы.ИдентификаторСтроки = Строки.ИдентификаторСтроки

	//|			И (Суммы.СуммаБезНДСРегл <> 0)
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
	|			Расчеты.ЗаказКлиента.Подразделение КАК Подразделение,
	|			Расчеты.ЗаказКлиента.ГруппаФинансовогоУчета КАК ГруппаФинансовогоУчета
	|		ИЗ
	|			РегистрНакопления.РасчетыСКлиентами КАК Расчеты
	|		ГДЕ
	|			Расчеты.Регистратор = &Ссылка) КАК Расчеты
	|		ПО (ИСТИНА)
	|ГДЕ
	|	Операция.Ссылка = &Ссылка
	|	И (Строки.Номенклатура.Принципал = НЕОПРЕДЕЛЕНО
	|			ИЛИ Строки.Номенклатура.Принципал = Операция.Организация)
	|	И (ЕСТЬNULL(Строки.Характеристика.Принципал, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
	|			ИЛИ ЕСТЬNULL(Строки.Характеристика.Принципал, Операция.Организация) = Операция.Организация)
	|	И Операция.ОтложенныйНДС";
	
	ТекстЗавершениеРабот = ТекстЗавершениеРабот +  " ОБЪЕДИНИТЬ ВСЕ " +
	"ВЫБРАТЬ
	|	Операция.Ссылка 		КАК Ссылка,
	|	Операция.Дата 			КАК Период,
	|	Операция.Организация 	КАК Организация,
	|	НЕОПРЕДЕЛЕНО 			КАК ИдентификаторСтроки,
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} {
	|	ЕСТЬNULL(ТЧ_НДС.СуммаНДС, ЕСТЬNULL(Суммы.СуммаНДСРегл, Строки.СуммаНДС)) 	КАК Сумма,
	|	ЕСТЬNULL(ТЧ_НДС.СуммаНДС, ЕСТЬNULL(Суммы.СуммаНДСУпр, Строки.СуммаНДС) / КурсВалютыУпрУчета.Курс) 	КАК СуммаУУ,
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} }
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка) 					КАК ВидСчетаДт,
	|	ЕСТЬNULL(Расчеты.ГруппаФинансовогоУчета, Операция.ГруппаФинансовогоУчета) 	КАК АналитикаУчетаДт,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) 									КАК МестоУчетаДт,
	|	НЕОПРЕДЕЛЕНО 																КАК ВалютаДт,
	|	ЕСТЬNULL(Расчеты.Подразделение, Операция.Подразделение) 					КАК ПодразделениеДт,
	|	Строки.НаправлениеДеятельности 												КАК НаправлениеДеятельностиДт,
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыПоНДСотложенномуДляУплатыВБюджет) 	КАК СчетДт,
	|	Операция.Контрагент 	КАК СубконтоДт1,
	|	ТЧ_НДС.Документ 		КАК СубконтоДт2,
	|	НЕОПРЕДЕЛЕНО 			КАК СубконтоДт3,
	|	0 						КАК ВалютнаяСуммаДт,
	|	0 						КАК КоличествоДт,
	|	0 						КАК СуммаНУДт,
	|	0 						КАК СуммаПРДт,
	|	0 						КАК СуммаВРДт,
