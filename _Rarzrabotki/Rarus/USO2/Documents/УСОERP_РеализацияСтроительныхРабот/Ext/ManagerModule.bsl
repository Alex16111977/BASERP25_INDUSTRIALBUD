	|	УСОERP_РеализацияСтроительныхРабот.Контрагент КАК ОрганизацияПоставщик,
	|	УСОERP_РеализацияСтроительныхРабот.ОбъектСтроительства КАК Проект,
	|	УСОERP_РеализацияСтроительныхРабот.Договор,
	|	УСОERP_РеализацияСтроительныхРабот.Договор.Номер,
	|	УСОERP_РеализацияСтроительныхРабот.СуммаДокумента,
	|	УСОERP_РеализацияСтроительныхРабот.Контрагент КАК Подрядчик,
	|	УСОERP_РеализацияСтроительныхРабот.Дата,
	|	УСОERP_РеализацияСтроительныхРабот.Договор.Дата,
	|	УСОERP_РеализацияСтроительныхРабот.ДатаНачалаПериода КАК НачалоРабот,
	|	УСОERP_РеализацияСтроительныхРабот.ДатаОкончанияПериода КАК ОкончаниеРабот,
	|	УСОERP_РеализацияСтроительныхРабот.Организация.КодПоОКПО,
	|	УСОERP_РеализацияСтроительныхРабот.Контрагент.КодПоОКПО,
	|	УСОERP_РеализацияСтроительныхРабот.Ссылка,
	|	УСОERP_РеализацияСтроительныхРабот.Организация,
	|	УСОERP_РеализацияСтроительныхРабот.Контрагент,
	|	УСОERP_РеализацияСтроительныхРабот.Ответственный
	|ИЗ
	|	Документ.УСОERP_РеализацияСтроительныхРабот КАК УСОERP_РеализацияСтроительныхРабот
	|ГДЕ
	|	УСОERP_РеализацияСтроительныхРабот.Ссылка В(&МассивДокументов)";
	
	Запрос.УстановитьПараметр("МассивДокументов", 				МассивОбъектов);
	
	ДанныеПечати 		= Запрос.Выполнить().Выбрать();		
	Пока ДанныеПечати.Следующий() Цикл
		СтрокаТаблицы = Макет.ПолучитьОбласть("СтрокаТаблицы1");

		Руководители = ОтветственныеЛицаБП.ОтветственныеЛица(ДанныеПечати.Организация, ДанныеПечати.Дата);		
		Запрос.УстановитьПараметр("Ссылка",      ДанныеПечати.Ссылка);
		Запрос.УстановитьПараметр("Организация", ДанныеПечати.Организация);
		Запрос.УстановитьПараметр("Контрагент",  ДанныеПечати.Контрагент);
		Запрос.УстановитьПараметр("Договор",     ДанныеПечати.Договор);
		Запрос.УстановитьПараметр("НПериод", 	 Новый Граница(НачалоГода(ДанныеПечати.Дата), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("КПериод", 	 Новый Граница(КонецДня(ДанныеПечати.Дата), ВидГраницы.Включая));
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(РеализацияСтроительныхРабот.СуммаСНДС) КАК СуммаСНДС,
		|	СУММА(РеализацияСтроительныхРабот.СуммаНДС) КАК СуммаНДС,
		|	СУММА(РеализацияСтроительныхРабот.СуммаСНДС - РеализацияСтроительныхРабот.СуммаНДС) КАК СуммаБезНДС,
		|	РеализацияСтроительныхРабот.Работа
		|ПОМЕСТИТЬ Реализация
		|ИЗ
		|	Документ.УСОERP_РеализацияСтроительныхРабот.Работы КАК РеализацияСтроительныхРабот
		|ГДЕ
		|	РеализацияСтроительныхРабот.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	РеализацияСтроительныхРабот.Работа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВыполнениеРаботЗаказчика.СуммаСНДСРасход - ВыполнениеРаботЗаказчика.СуммаНДСРасход) КАК Сумма,
		|	СУММА(ВыполнениеРаботЗаказчика.ОбъемРасход) КАК Количество,
		|	ВыполнениеРаботЗаказчика.Работа
		|ПОМЕСТИТЬ ОборотыГод_Р
		|ИЗ
		|	РегистрНакопления.УСОERP_ВыполнениеРаботЗаказчика.Обороты(
		|			&НПериод,
		|			&КПериод,
		|			Период,
		|			Организация = &Организация
		|				И Контрагент = &Контрагент
		|				И Договор = &Договор
		|				И Работа В
		|					(ВЫБРАТЬ
		|						Реализация.Работа
		|					ИЗ
		|						Реализация КАК Реализация)) КАК ВыполнениеРаботЗаказчика
		|
		|СГРУППИРОВАТЬ ПО
		|	ВыполнениеРаботЗаказчика.Работа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВыполнениеРаботЗаказчика.СуммаСНДСРасход - ВыполнениеРаботЗаказчика.СуммаНДСРасход) КАК Сумма,
		|	СУММА(ВыполнениеРаботЗаказчика.ОбъемРасход) КАК Количество,
		|	ВыполнениеРаботЗаказчика.Работа
		|ПОМЕСТИТЬ ОборотыВесьПер_Р
		|ИЗ
		|	РегистрНакопления.УСОERP_ВыполнениеРаботЗаказчика.Обороты(
		|			,
		|			,
		|			Период,
		|			Организация = &Организация
		|				И Контрагент = &Контрагент
		|				И Договор = &Договор
		|				И Работа В
		|					(ВЫБРАТЬ
		|						Реализация.Работа
		|					ИЗ
		|						Реализация КАК Реализация)) КАК ВыполнениеРаботЗаказчика
		|
		|СГРУППИРОВАТЬ ПО
		|	ВыполнениеРаботЗаказчика.Работа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Реализация.СуммаБезНДС КАК СуммаБезНДС,
		|	ЕСТЬNULL(ОборотыГод_Р.Сумма, 0) КАК СуммаОборотГод,
		|	ЕСТЬNULL(ОборотыВесьПер_Р.Сумма, 0) КАК ОборотыВесьПер,
		|	Реализация.Работа,
		|	Реализация.СуммаНДС КАК СуммаНДС,
		|	Реализация.СуммаСНДС КАК СуммаСНДС
		|ИЗ
		|	Реализация КАК Реализация
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОборотыВесьПер_Р КАК ОборотыВесьПер_Р
		|		ПО Реализация.Работа = ОборотыВесьПер_Р.Работа
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОборотыГод_Р КАК ОборотыГод_Р
		|		ПО Реализация.Работа = ОборотыГод_Р.Работа
		|ИТОГИ
		|	СУММА(СуммаБезНДС),
		|	СУММА(СуммаОборотГод),
		|	СУММА(ОборотыВесьПер),
		|	СУММА(СуммаНДС),
		|	СУММА(СуммаСНДС)
		|ПО
		|	ОБЩИЕ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ Реализация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ОборотыГод_Р
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ОборотыВесьПер_Р";
		
		ВыборкаСуммы = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСуммы.Следующий() Цикл
			Подрядчик     = ФормированиеПечатныхФорм.ОписаниеОрганизации(ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ДанныеПечати.ОрганизацияПолучатель, ДанныеПечати.ДатаДокумента), "ПолноеНаименование");
			Заказчик      = ФормированиеПечатныхФорм.ОписаниеОрганизации(ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ДанныеПечати.ОрганизацияПоставщик, ДанныеПечати.ДатаДокумента), "ПолноеНаименование");

			СведенияОПодрядчике 			= ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ДанныеПечати.ОрганизацияПолучатель,  ДанныеПечати.Дата);
			СведенияОЗаказчике 				= ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ДанныеПечати.ОрганизацияПоставщик,  ДанныеПечати.Дата);
			
			Шапка.Параметры.АдресПодрядчик 	= СведенияОПодрядчике.ЮридическийАдрес + СведенияОПодрядчике.Телефоны;
			Шапка.Параметры.АдресЗаказчик 	= СведенияОЗаказчике.ЮридическийАдрес  + СведенияОЗаказчике.Телефоны;
			
			Шапка.Параметры.Заполнить(ДанныеПечати);
			Шапка.Параметры.Заказчик        			= Заказчик;
			Шапка.Параметры.Подрядчик        			= Подрядчик;
			
			Шапка.Параметры.Стройка                 = ДанныеПечати.Проект;
			Шапка.Параметры.ДоговорКонтрагентаНомер = ДанныеПечати.ДоговорНомер;
			Шапка.Параметры.ДатаДоговор             = ДанныеПечати.ДоговорДата;
			Если ЗначениеЗаполнено(ДанныеПечати.НачалоРабот) Тогда
				Шапка.Параметры.отчС = ДанныеПечати.НачалоРабот;
			Иначе
				Шапка.Параметры.отчС = НачалоМесяца(ДанныеПечати.дата);
			КонецЕсли;
			Если ЗначениеЗаполнено(ДанныеПечати.ОкончаниеРабот) Тогда
				Шапка.Параметры.отчПо = ДанныеПечати.ОкончаниеРабот;
			Иначе
				Шапка.Параметры.отчПо = КонецМесяца(ДанныеПечати.дата);
			КонецЕсли;
			Шапка.Параметры.ИКодПоОКПО = ДанныеПечати.ОрганизацияКодПоОКПО;
			Шапка.Параметры.ПКодПоОКПО = ДанныеПечати.КонтрагентКодПоОКПО;
			
			ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент, Макет, Шапка, ДанныеПечати.Ссылка);
			
			ТабличныйДокумент.Вывести(Шапка);
			ТабличныйДокумент.Вывести(ШапкаТаблицы);

			СтрокаТаблицы.Параметры.СуммаОборот    = ВыборкаСуммы.ОборотыВесьПер;
			СтрокаТаблицы.Параметры.СуммаОборотГод = ВыборкаСуммы.СуммаОборотГод;
			СтрокаТаблицы.Параметры.Сумма          = ВыборкаСуммы.СуммаБезНДС;
			ТабличныйДокумент.Вывести(СтрокаТаблицы);
			
			индексНомераСтроки = 0; //+ ДС Чабаненко
			
			Выборка = ВыборкаСуммы.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				//+ ДС Чабаненко
				индексНомераСтроки = индексНомераСтроки + 1; 
				СтрокаТ.Параметры.НомС 					= индексНомераСтроки;
				/// ДС Чабаненко
				СтрокаТ.Параметры.Номенклатура 			= Выборка.Работа;
				СтрокаТ.Параметры.СуммаОборотГод 		= Выборка.СуммаОборотГод;
				СтрокаТ.Параметры.СуммаОборот		 	= Выборка.ОборотыВесьПер;
				СтрокаТ.Параметры.Сумма 				= Выборка.СуммаБезНДС;
				
				ТабличныйДокумент.Вывести(СтрокаТ);
			КонецЦикла;	

			СтрокаТаблицы = Макет.ПолучитьОбласть("СтрокаТаблицы2");
			СтрокаТаблицы.Параметры.Итого      = ВыборкаСуммы.СуммаБезНДС;
			СтрокаТаблицы.Параметры.СуммаНДС   = ВыборкаСуммы.СуммаНДС;
			СтрокаТаблицы.Параметры.СуммаСНДС  = ВыборкаСуммы.СуммаСНДС;
			
			СтрокаТаблицы.Параметры.ФИОПодрядчика       = Руководители.РуководительПредставление;
			СтрокаТаблицы.Параметры.ДолжностьПодрядчика = Руководители.РуководительДолжность;
			
			//Если ЗначениеЗаполнено(ФИОЗаказчика) Тогда
			//	СтрокаТаблицы.Параметры.ФИОЗаказчика = ФИОЗаказчика;
			//КонецЕсли;
			//Если ЗначениеЗаполнено(ДолжностьЗаказчика) Тогда
			//	СтрокаТаблицы.Параметры.ДолжностьЗаказчика = ДолжностьЗаказчика;
			//КонецЕсли;
			ТабличныйДокумент.Вывести(СтрокаТаблицы);
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЦикла;
	КонецЦикла;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ПолеСверху = 0;
	ТабличныйДокумент.ПолеСлева = 1;
	ТабличныйДокумент.ПолеСнизу = 0;

	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат ТабличныйДокумент;

КонецФункции

Процедура ЗаполнитьСтруктуруПолучателейПечатныхФорм(СтруктураДанныхОбъектаПечати) Экспорт
		
КонецПроцедуры

