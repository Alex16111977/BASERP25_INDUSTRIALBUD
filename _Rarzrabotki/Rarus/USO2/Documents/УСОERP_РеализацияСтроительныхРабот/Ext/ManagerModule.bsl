Функция ТекстЗапросаТаблицаДанныеОснованийСчетовФактур(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "ДанныеОснованийСчетовФактур";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 	
	
	//ИнициализироватьВтСуммыДокументовВалютахУчета(Запрос, ТекстыЗапроса);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Ценности.Ссылка.Дата КАК Период,
	|	&ТипСчетаФактуры КАК ТипСчетаФактуры,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыЦенностей.ПрочиеРаботыИУслуги) КАК ВидЦенности,
	|	МАКСИМУМ(ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.Услуга)) КАК ТипЗапасов,
	|	Ценности.СтавкаНДС КАК СтавкаНДС,
	|	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка)) КАК НомерГТД,
	|	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.КлассификаторТНВЭД.ПустаяСсылка)) КАК КодТНВЭД,
	|	МАКСИМУМ(ЛОЖЬ) КАК УменьшениеСуммы,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаСчетаФактурыКомиссионера,
	|	НЕОПРЕДЕЛЕНО КАК ПокупательКомиссионногоТовара,
	|	НЕОПРЕДЕЛЕНО КАК СчетФактураВыданныйКомиссионером,
	|	СУММА(Ценности.Сумма-Ценности.СуммаНДС) КАК СуммаБезНДС,
	|	СУММА(Ценности.СуммаНДС) КАК СуммаНДС,
	|	СУММА((Ценности.Сумма-Ценности.СуммаНДС) * &КоэффициентПересчетаВВалютуРегл) КАК СуммаБезНДСРегл,
	|	СУММА((Ценности.Сумма-Ценности.СуммаНДС) * &КоэффициентПересчетаВВалютуРегл) КАК БазаНДСРегл,
	|	СУММА(Ценности.СуммаНДС * &КоэффициентПересчетаВВалютуРегл) КАК СуммаНДСРегл,
	|	Ценности.Ссылка.Дата КАК Дата,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС) КАК НалогообложениеНДС,
	|	Ценности.Ссылка.Валюта КАК Валюта,
	|	Ценности.Ссылка.Организация КАК Организация,
	|	Ценности.Ссылка.Подразделение КАК Подразделение,
	|	Ценности.Ссылка.Контрагент КАК Контрагент,
	|	Ценности.Ссылка.Договор КАК Договор,
	|	Ценности.Ссылка.Грузоотправитель КАК Грузоотправитель,
	|	Ценности.Ссылка.Грузополучатель КАК Грузополучатель,
	|	ЛОЖЬ КАК ЭтоВозврат,
	|	ЛОЖЬ КАК ИсправлениеОшибок,
	|	ЛОЖЬ КАК КорректировкаПоСогласованиюСторон,
	|	НЕОПРЕДЕЛЕНО КАК КорректируемыйДокумент
	|ИЗ
	|	Документ.УСОERP_РеализацияСтроительныхРабот.ВыполненоВсего КАК Ценности
	|ГДЕ
	|	Ценности.Ссылка = &Ссылка
	|	И &Утвержден
	|
	|СГРУППИРОВАТЬ ПО
	|	Ценности.Ссылка,
	|	Ценности.СтавкаНДС,
	|	Ценности.Ссылка.Дата,
	|	Ценности.Ссылка.Валюта,
	|	Ценности.Ссылка.Организация,
	|	Ценности.Ссылка.Подразделение,
	|	Ценности.Ссылка.Контрагент,
	|	Ценности.Ссылка.Грузоотправитель,
	|	Ценности.Ссылка.Грузополучатель,
	|	Ценности.Ссылка.Договор,
	|	Ценности.Ссылка.Дата";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции

