&НаСервере
Процедура ОчиститьЭтапыРабот()
	
	Если НЕ НовыйВариант Тогда
		Возврат;
	КонецЕсли;
		
	ТабРаботы = Объект.Работы.Выгрузить();
	
	ТабЭтапов = ТабРаботы.Скопировать(Новый Структура("СуммарнаяРабота",Истина));
	ТабРабот = ТабРаботы.Скопировать(Новый Структура("СуммарнаяРабота",Ложь));
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТабЭтапов",ТабЭтапов);
	Запрос.УстановитьПараметр("ТабРабот",ТабРабот);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТабЭтапы.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Родитель
	|ПОМЕСТИТЬ ТабЭтапы
	|ИЗ
	|	&ТабЭтапов КАК ТабЭтапы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТабРабот.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа
	|ПОМЕСТИТЬ ТабРабот
	|ИЗ
	|	&ТабРабот КАК ТабРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабЭтапы.Родитель КАК Родитель,
	|	МАКСИМУМ(ТабРабот.Работа.Родитель) КАК РаботаРодитель
	|ИЗ
	|	ТабЭтапы КАК ТабЭтапы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабРабот КАК ТабРабот
	|		ПО ТабЭтапы.Родитель = ТабРабот.Работа.Родитель
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабЭтапы.Родитель
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ТабРабот.Работа.Родитель) ЕСТЬ NULL";
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	
	МассивСтрокДляУдаления = Новый Массив;
	
	Для Каждого СтрокаТЗ ИЗ ТЗ Цикл
		
		Строки = Объект.Работы.НайтиСтроки(Новый Структура("Работа",СтрокаТЗ.Родитель));
		
		Для Каждого НайденнаяСтрока ИЗ СТроки Цикл
			МассивСтрокДляУдаления.Добавить(НайденнаяСтрока);
		КонецЦикла; 		
		
	КонецЦикла;
	
	Для Каждого ЭлементМассива ИЗ МассивСтрокДляУдаления Цикл
		
		Объект.Работы.Удалить(ЭлементМассива);
		
	КонецЦикла; 	
	
	Объект.Работы.Сортировать("ПорядокСортировки");	
	
КонецПроцедуры 

