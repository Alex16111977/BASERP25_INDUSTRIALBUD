&НаСервере
Процедура ПересчитатьПроцентРеализацииЗаказчика(ИдентификаторСтроки)
	
	СтрокаТаблицы = Объект.РаботыЗаказчика.НайтиПоИдентификатору( ИдентификаторСтроки);
	
	СтрокаТаблицы.ПроцентРеализации = ?(СтрокаТаблицы.ОбъемВсего = 0, 0, Окр(СтрокаТаблицы.ОбъемРеализации / СтрокаТаблицы.ОбъемВсего *100, 2));
	СтрокаТаблицы.СуммаСНДС = Окр(СтрокаТаблицы.СтоимостьВсего * СтрокаТаблицы.ПроцентРеализации/100, 2);
	СтрокаТаблицы.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СтрокаТаблицы.СуммаСНДС, СтрокаТаблицы.СтавкаНДС, Истина);
	 	
КонецПроцедуры

