Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства

КонецПроцедуры

&НаКлиенте
Процедура РаботыПередУдалением(Элемент, Отказ)
	УдалитьПодчиненныеЭлементы(Элемент.ТекущиеДанные.ПолучитьИдентификатор(),Отказ);
КонецПроцедуры

&НаСервере
Процедура  УдалитьПодчиненныеЭлементы(ИдСтроки,Отказ)
	
	СтрокаРаботы = Объект.Работы.НайтиПоИдентификатору(ИдСТроки);
	Работа = СтрокаРаботы.Работа;
	
	Если Работа.СуммарнаяРабота Тогда
		
		Запрос = Новый Запрос;
		ЗАпрос.УстановитьПараметр("Работа",Работа);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УСОERP_СтроительныеРаботы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
		|ГДЕ
		|	УСОERP_СтроительныеРаботы.Ссылка В ИЕРАРХИИ(&Работа)";
		
		МассивСтрокДляУдаления = Новый Массив;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Строки = Объект.Работы.НайтиСтроки(Новый Структура("Работа",Выборка.Ссылка));
			
			Для Каждого НайденнаяСтрока ИЗ Строки Цикл
				МассивСтрокДляУдаления.Добавить(НайденнаяСтрока);
			КонецЦикла;
			
		КонецЦикла; 		
		
		Отказ = Истина;
		
		Для Каждого СтрокаМассива ИЗ МассивСтрокДляУдаления Цикл
			
			Объект.Работы.Удалить(СтрокаМассива);
			
		КонецЦикла;		
		
	КонецЕсли;  	
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьНаправлениеДеятельности()
	Возврат Объект.ДокументУтверждения.НаправлениеДеятельности;
КонецФункции

&НаКлиенте
Процедура ВыполненоВсегоПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		Элемент.ТекущиеДанные.НаправлениеДеятельности = ПолучитьНаправлениеДеятельности();
		
	КонецЕсли;
	
КонецПроцедуры


