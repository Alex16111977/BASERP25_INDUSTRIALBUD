	Попытка
		
		ТекСтрока.СуммаСНДС = СтруктураИтогов.ТекущиеПЗСНачислениямиНаОбъем;  		
		
	Исключение
		
		ТекСтрока.СуммаСНДС = 0;
		
	КонецПопытки;  
	
