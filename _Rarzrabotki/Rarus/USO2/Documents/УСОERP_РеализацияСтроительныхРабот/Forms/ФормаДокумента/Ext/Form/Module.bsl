&НаСервере
Функция ПроверитьСуммыПередЗаписью()
	
	Если Объект.ОтложенныйНДС И Объект.НДС.Количество() Тогда
		
		Если Объект.Работы.Количество() Тогда
			
			Возврат ?(ИтогиРаботыСуммаВсего = Объект.НДС.Итог("Сумма") И ИтогиРаботыСуммаНДС = Объект.НДС.Итог("СуммаНДС"), Ложь, Истина);
			
		Иначе
			
			Возврат Ложь;
			
		КонецЕсли;
		
		
	ИначеЕсли НЕ Объект.ОтложенныйНДС Тогда
		
		Возврат Ложь;
		
	Иначе
		
		Возврат Истина;
		
	КонецЕсли;
	
