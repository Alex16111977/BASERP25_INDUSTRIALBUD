Процедура ПересчитатьСуммуНДСПоРаботеЗаказчика(ИдентификаторСтроки)
	
	СтрокаТаблицы					=	Объект.РаботыЗаказчика.НайтиПоИдентификатору(ИдентификаторСтроки);
	СтрокаТаблицы.ПроцентРеализации = ?(СтрокаТаблицы.СтоимостьВсего = 0, 0, Окр(СтрокаТаблицы.СуммаСНДС / СтрокаТаблицы.СтоимостьВсего *100, 2));
	СтрокаТаблицы.ОбъемРеализации = Окр(СтрокаТаблицы.ОбъемВсего * СтрокаТаблицы.ПроцентРеализации/100, 2);
	СтрокаТаблицы.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СтрокаТаблицы.СуммаСНДС, СтрокаТаблицы.СтавкаНДС, Истина); 
		
КонецПроцедуры

