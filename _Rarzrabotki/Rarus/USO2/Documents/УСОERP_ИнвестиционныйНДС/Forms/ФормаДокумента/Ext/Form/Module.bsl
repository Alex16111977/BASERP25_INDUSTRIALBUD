&НаКлиенте
// Процедура - обработчик события "Нажатие" команды заполнения табл. части "НДС по СМР".
//
Процедура ЗаполнитьНДСПоСМР(Команда)
	
	Если ПроверитьВыполнениеНеобходимыхУсловийДляЗаполненияДокумента() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Объект.НДСПоСМР.Количество() = 0 Тогда

		ТекстВопроса = НСтр("ru='Перед заполнением табл. часть ""Накопление НДС по работам/услугам"" будет очищена. Продолжить?'");
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьНДСПоСМРЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;

	КонецЕсли;

	ЗаполнитьНДСПоСМРНаСервере();
	
КонецПроцедуры // ЗаполнитьНДСПоСМР()

&НаКлиенте
// Завершение процедуры - обработчика события "Нажатие" команды заполнения табл. части "НДС по СМР".
//
Процедура ЗаполнитьНДСПоСМРЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
	ОтветНаВопрос = РезультатВопроса;
	Если ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
	    Возврат;
	КонецЕсли;
	
	ЗаполнитьНДСПоСМРНаСервере();

КонецПроцедуры // ЗаполнитьНДСПоСМРЗавершение()

