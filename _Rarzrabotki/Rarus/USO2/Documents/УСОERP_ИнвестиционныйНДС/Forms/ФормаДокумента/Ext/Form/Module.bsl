	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("НачалоПериода"	   , НачалоМесяца(Объект.Дата));
	СтруктураПараметров.Вставить("ОкончаниеПериода"	   , КонецМесяца(Объект.Дата));
	СтруктураПараметров.Вставить("Организация"		   , Объект.Организация);
	СтруктураПараметров.Вставить("ОбъектСтроительства" , Объект.ОбъектСтроительства);

	Объект.НДСПоТМЦ.Загрузить(УСОERP_ДолевоеСтроительствоСервер.ПолучитьДанныеНакопленияНДСПоМатериалам(СтруктураПараметров));
		
КонецПроцедуры // ЗаполнитьНДСПоТМЦНаСервере()

