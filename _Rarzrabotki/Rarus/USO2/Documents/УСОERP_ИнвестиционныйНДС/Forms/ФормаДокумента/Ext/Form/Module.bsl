// Процедура формирует структуру параметров и вызывает функцию заполнения табл. части "Включение в стоимость". 
//
Процедура ЗаполнитьВключениеВСтоимостьНаСервере()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДатаДокумента"				 , Объект.Дата);
	СтруктураПараметров.Вставить("НачалоПериода"				 , НачалоМесяца(Объект.Дата));
	СтруктураПараметров.Вставить("ОкончаниеПериода"				 , КонецМесяца(Объект.Дата));
	СтруктураПараметров.Вставить("Организация"					 , Объект.Организация);
	СтруктураПараметров.Вставить("ОбъектСтроительства"			 , Объект.ОбъектСтроительства);
	СтруктураПараметров.Вставить("НакоплениеНДСПоРаботамУслугам" , Объект.НДСПоСМР.Выгрузить()); 
	СтруктураПараметров.Вставить("НакоплениеНДСПоМатериалам"	 , Объект.НДСПоТМЦ.Выгрузить()); 

	Объект.ВключениеВСтоимость.Загрузить(УСОERP_ДолевоеСтроительствоСервер.ПолучитьДанныеВключениеНДСВСтоимостьОбъекта(СтруктураПараметров));
		
КонецПроцедуры // ЗаполнитьВключениеВСтоимостьНаСервере()

