// Процедура формирует структуру параметров и вызывает функцию заполнения табл. части "НДС по СМР". 
//
Процедура ЗаполнитьНДСПоСМРНаСервере()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("НачалоПериода"	   , НачалоМесяца(Объект.Дата));
	СтруктураПараметров.Вставить("ОкончаниеПериода"	   , КонецМесяца(Объект.Дата));
	СтруктураПараметров.Вставить("Организация"		   , Объект.Организация);
	СтруктураПараметров.Вставить("ОбъектСтроительства" , Объект.ОбъектСтроительства);
	
	Объект.НДСПоСМР.Загрузить(УСОERP_ДолевоеСтроительствоСервер.ПолучитьДанныеНакопленияНДСПоРаботамУслугам(СтруктураПараметров));
		
КонецПроцедуры // ЗаполнитьНДСПоСМРНаСервере()

&НаСервере
// Процедура формирует структуру параметров и вызывает функцию заполнения табл. части "НДС по ТМЦ". 
//
