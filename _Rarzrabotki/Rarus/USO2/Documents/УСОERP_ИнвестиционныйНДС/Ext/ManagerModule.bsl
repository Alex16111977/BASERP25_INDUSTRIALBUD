	|	Строки.ДокументПоступления КАК СубконтоДт2,
	|	Строки.ОбъектСтроительства КАК СубконтоДт3,
	|
	|	0 КАК ВалютнаяСуммаДт,
	|	0 КАК КоличествоДт,
	|	0 КАК СуммаНУДт,
	|	0 КАК СуммаПРДт,
	|	0 КАК СуммаВРДт,
	|
	|	НЕОПРЕДЕЛЕНО КАК ВидСчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК АналитикаУчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчетаКт,
	|
	|	НЕОПРЕДЕЛЕНО КАК ВалютаКт,
	|	НЕОПРЕДЕЛЕНО КАК ПодразделениеКт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельностиКт,
	|	Строки.СчетУчетаНДС КАК СчетКт,
	|
	|	Строки.Контрагент КАК СубконтоКт1,
	|	Строки.ДокументПоступления КАК СубконтоКт2,
	|	Строки.ОбъектСтроительства КАК СубконтоКт3,
	|
	|	0 КАК ВалютнаяСуммаКт,
	|	0 КАК КоличествоКт,
	|	0 КАК СуммаНУКт,
	|	0 КАК СуммаПРКт,
	|	0 КАК СуммаВРКт,
	|	""Накопление НДС по материалам"" КАК Содержание
	|
	|ИЗ
	|	Документ.УСОERP_ИнвестиционныйНДС КАК Операция
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_ИнвестиционныйНДС.НДСПоТМЦ КАК Строки
	|		ПО (Строки.Ссылка = Операция.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_УчетнаяПолитикаПоДолевомуСтроительству.СрезПоследних(&Дата, ) КАК УчетнаяПолитика
	|		ПО Операция.Организация = УчетнаяПолитика.Организация
	|ГДЕ
	|	Операция.Ссылка = &Ссылка";
	
	ВключениеНДСВСтоимость = "
	|ВЫБРАТЬ //// Включение НДС в стоимость объекта (Дт 08.ХХ :: Кт 19.ХХ)
	|	Операция.Ссылка КАК Ссылка,
	|	Операция.Дата КАК Период,
	|	Операция.Организация КАК Организация,
	|	НЕОПРЕДЕЛЕНО КАК ИдентификаторСтроки,
	|
	|	Строки.СуммаНДС КАК Сумма,
	
	|	Строки.СуммаНДС КАК СуммаУУ,
	
	|
	|	НЕОПРЕДЕЛЕНО КАК ВидСчетаДт,
	|	НЕОПРЕДЕЛЕНО КАК АналитикаУчетаДт,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчетаДт,
	|
	|	НЕОПРЕДЕЛЕНО КАК ВалютаДт,
	|	НЕОПРЕДЕЛЕНО КАК ПодразделениеДт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельностиДт,
	|	Строки.СчетСписанияНДС КАК СчетДт,
	|
	|	Строки.ОбъектСтроительства КАК СубконтоДт1,
	|	Строки.Номенклатура КАК СубконтоДт2,
	|	Строки.СпособСтроительства КАК СубконтоДт3,
