	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_УчетнаяПолитикаПоДолевомуСтроительству.СрезПоследних(&Дата, ) КАК УчетнаяПолитика
	|		ПО Операция.Организация = УчетнаяПолитика.Организация
	|ГДЕ
	|	Операция.Ссылка = &Ссылка";
	
	Возврат НакоплениеНДСПоРаботамУслугам
	+ " ОБЪЕДИНИТЬ ВСЕ " + НакоплениеНДСПоМатериалам
	+ " ОБЪЕДИНИТЬ ВСЕ " + ВключениеНДСВСтоимость;

КонецФункции // ТекстОтраженияВРеглУчете()

// Функция возвращает текст запроса дополнительных временных таблиц, 
// необходимых для отражения в регламетированном учете
//
Функция ТекстЗапросаВТОтраженияВРеглУчете() Экспорт
	
	ТекстЗапроса = "";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область Проведение

// Процедура инициализирует данные документа для их последующего отражения в связанных с документом регистрах.
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", ДокументСсылка);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДанныеДокумента.Дата КАК Период,
	               |	ДанныеДокумента.Организация КАК Организация
	               |ИЗ
	               |	Документ.УСОERP_ИнвестиционныйНДС КАК ДанныеДокумента
	               |ГДЕ
	               |	ДанныеДокумента.Ссылка = &ТекущийДокумент";
				   
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	
	Запрос.УстановитьПараметр("Период"		, Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация"	, Реквизиты.Организация);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаНДСИнвестиционныйПоСМР.НомерСтроки КАК НомерСтроки,
	               |	&Период КАК Период,
	               |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	               |	&Организация КАК Организация,
	               |	ТаблицаНДСИнвестиционныйПоСМР.Контрагент КАК Контрагент,
	               |	ТаблицаНДСИнвестиционныйПоСМР.ДокументПоступления КАК ДокументПоступления,
	               |	ТаблицаНДСИнвестиционныйПоСМР.ОбъектСтроительства КАК ОбъектСтроительства,
	               |	УСОERP_УчетнаяПолитикаПоДолевомуСтроительствуСрезПоследних.СчетУчетаИнвестиционногоНДС КАК СчетУчетаНДС,
	               |	НЕОПРЕДЕЛЕНО КАК Номенклатура,
	               |	ТаблицаНДСИнвестиционныйПоСМР.СпособСтроительства КАК СпособСтроительства,
	               |	ТаблицаНДСИнвестиционныйПоСМР.СуммаБезНДС КАК СуммаБезНДС,
	               |	ТаблицаНДСИнвестиционныйПоСМР.СуммаНДС КАК СуммаНДС
	               |ИЗ
	               |	Документ.УСОERP_ИнвестиционныйНДС.НДСПоСМР КАК ТаблицаНДСИнвестиционныйПоСМР
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_УчетнаяПолитикаПоДолевомуСтроительству.СрезПоследних(&Период, ) КАК УСОERP_УчетнаяПолитикаПоДолевомуСтроительствуСрезПоследних
	               |		ПО ТаблицаНДСИнвестиционныйПоСМР.Ссылка.Организация = УСОERP_УчетнаяПолитикаПоДолевомуСтроительствуСрезПоследних.Организация
	               |ГДЕ
	               |	ТаблицаНДСИнвестиционныйПоСМР.Ссылка = &ТекущийДокумент
	               |	И (ТаблицаНДСИнвестиционныйПоСМР.СуммаБезНДС <> 0
	               |			ИЛИ ТаблицаНДСИнвестиционныйПоСМР.СуммаНДС <> 0)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ТаблицаНДСИнвестиционныйПоТМЦ.НомерСтроки,
	               |	&Период,
	               |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	               |	&Организация,
	               |	ТаблицаНДСИнвестиционныйПоТМЦ.Контрагент,
	               |	ТаблицаНДСИнвестиционныйПоТМЦ.ДокументПоступления,
	               |	ТаблицаНДСИнвестиционныйПоТМЦ.ОбъектСтроительства,
	               |	УСОERP_УчетнаяПолитикаПоДолевомуСтроительствуСрезПоследних.СчетУчетаИнвестиционногоНДС,
	               |	ТаблицаНДСИнвестиционныйПоТМЦ.Номенклатура,
	               |	ТаблицаНДСИнвестиционныйПоТМЦ.СпособСтроительства,
	               |	ТаблицаНДСИнвестиционныйПоТМЦ.СуммаБезНДС,
	               |	ТаблицаНДСИнвестиционныйПоТМЦ.СуммаНДС
	               |ИЗ
	               |	Документ.УСОERP_ИнвестиционныйНДС.НДСПоТМЦ КАК ТаблицаНДСИнвестиционныйПоТМЦ,
	               |	РегистрСведений.УСОERP_УчетнаяПолитикаПоДолевомуСтроительству.СрезПоследних(&Период, ) КАК УСОERP_УчетнаяПолитикаПоДолевомуСтроительствуСрезПоследних
	               |ГДЕ
	               |	ТаблицаНДСИнвестиционныйПоТМЦ.Ссылка = &ТекущийДокумент
	               |	И (ТаблицаНДСИнвестиционныйПоТМЦ.СуммаБезНДС <> 0
	               |			ИЛИ ТаблицаНДСИнвестиционныйПоТМЦ.СуммаНДС <> 0)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ТаблицаНДСИнвестиционныйВключениеВСтоимость.НомерСтроки,
	               |	&Период,
	               |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	               |	&Организация,
	               |	ТаблицаНДСИнвестиционныйВключениеВСтоимость.Контрагент,
	               |	ТаблицаНДСИнвестиционныйВключениеВСтоимость.ДокументПоступления,
	               |	ТаблицаНДСИнвестиционныйВключениеВСтоимость.ОбъектСтроительства,
	               |	УСОERP_УчетнаяПолитикаПоДолевомуСтроительствуСрезПоследних.СчетУчетаИнвестиционногоНДС,
	               |	ТаблицаНДСИнвестиционныйВключениеВСтоимость.Номенклатура,
	               |	ТаблицаНДСИнвестиционныйВключениеВСтоимость.СпособСтроительства,
	               |	ТаблицаНДСИнвестиционныйВключениеВСтоимость.СуммаБезНДС,
	               |	ТаблицаНДСИнвестиционныйВключениеВСтоимость.СуммаНДС
	               |ИЗ
	               |	Документ.УСОERP_ИнвестиционныйНДС.ВключениеВСтоимость КАК ТаблицаНДСИнвестиционныйВключениеВСтоимость,
	               |	РегистрСведений.УСОERP_УчетнаяПолитикаПоДолевомуСтроительству.СрезПоследних(&Период, ) КАК УСОERP_УчетнаяПолитикаПоДолевомуСтроительствуСрезПоследних
	               |ГДЕ
	               |	ТаблицаНДСИнвестиционныйВключениеВСтоимость.Ссылка = &ТекущийДокумент
	               |	И (ТаблицаНДСИнвестиционныйВключениеВСтоимость.СуммаБезНДС <> 0
	               |			ИЛИ ТаблицаНДСИнвестиционныйВключениеВСтоимость.СуммаНДС <> 0)";

	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("ТаблицаНДСИнвестиционный", Результат[0].Выгрузить());

КонецПроцедуры // ИнициализироватьДанныеДокумента()

#КонецОбласти

#Область Отчеты
	// Определяет список команд отчетов.
	//
	// Параметры:
	//   КомандыОтчетов - ТаблицаЗначений - Таблица с командами отчетов. Для изменения.
	//       См. описание 1 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
	//   Параметры - Структура - Вспомогательные параметры. Для чтения.
	//       См. описание 2 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
