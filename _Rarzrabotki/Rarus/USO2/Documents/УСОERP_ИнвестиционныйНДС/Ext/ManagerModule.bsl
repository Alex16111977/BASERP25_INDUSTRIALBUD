#Область СторнированиеДокументов

// Процедура формирует сторнирующие документы "Запись книги покупок" по данным регистра накопления "НДС Покупки".
//
Процедура СформироватьСторнирующиеДокументыЗаписьКнигиПокупок(ДокументСсылка, Отказ) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода"	 , НачалоМесяца(ДокументСсылка.Дата));
	Запрос.УстановитьПараметр("ОкончаниеПериода" , КонецМесяца(ДокументСсылка.Дата));
	Запрос.УстановитьПараметр("ТекущийДокумент"	 , ДокументСсылка);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	НакоплениеНДСПоРаботамУслугам.ДокументПоступления КАК СчетФактура,
	               |	НакоплениеНДСПоРаботамУслугам.СчетУчетаНДС КАК СчетУчетаНДС
	               |ПОМЕСТИТЬ ВТНакопленияИнвестиционныхНДСПоТаблицам
	               |ИЗ
	               |	Документ.УСОERP_ИнвестиционныйНДС.НДСПоСМР КАК НакоплениеНДСПоРаботамУслугам
	               |ГДЕ
	               |	НакоплениеНДСПоРаботамУслугам.Ссылка = &ТекущийДокумент
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НакоплениеНДСПоМатериалам.ДокументПоступления,
	               |	НакоплениеНДСПоМатериалам.СчетУчетаНДС
	               |ИЗ
	               |	Документ.УСОERP_ИнвестиционныйНДС.НДСПоТМЦ КАК НакоплениеНДСПоМатериалам
	               |ГДЕ
	               |	НакоплениеНДСПоМатериалам.Ссылка = &ТекущийДокумент
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВТНакопленияИнвестиционныхНДСПоТаблицам.СчетФактура КАК СчетФактура,
	               |	ВТНакопленияИнвестиционныхНДСПоТаблицам.СчетУчетаНДС КАК СчетУчетаНДС
	               |ПОМЕСТИТЬ ВТНакопленияИнвестиционныхНДС
	               |ИЗ
	               |	ВТНакопленияИнвестиционныхНДСПоТаблицам КАК ВТНакопленияИнвестиционныхНДСПоТаблицам
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	СчетФактура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВТНакопленияИнвестиционныхНДС.СчетФактура КАК ДокументРасчетов,
	               |	ВТНакопленияИнвестиционныхНДС.СчетУчетаНДС КАК СчетУчетаНДС,
	               |	ЕСТЬNULL(НДСЗаписиКнигиПокупок.ДатаСобытия, НЕОПРЕДЕЛЕНО) КАК Дата,
	               |	ЕСТЬNULL(НДСЗаписиКнигиПокупок.Организация, НЕОПРЕДЕЛЕНО) КАК Организация,
	               |	ЕСТЬNULL(НДСЗаписиКнигиПокупок.Поставщик, НЕОПРЕДЕЛЕНО) КАК Контрагент,
	               |	ЕСТЬNULL(НДСЗаписиКнигиПокупок.ЗаписьДополнительногоЛиста, НЕОПРЕДЕЛЕНО) КАК ЗаписьДополнительногоЛиста,
	               |	ЕСТЬNULL(НДСЗаписиКнигиПокупок.КорректируемыйПериод, НЕОПРЕДЕЛЕНО) КАК КорректируемыйПериод,
	               |	ЕСТЬNULL(ВалютаРегламентированногоУчета.Значение, НЕОПРЕДЕЛЕНО) КАК Валюта,
	               |	ЗНАЧЕНИЕ(Перечисление.СпособыКорректировкиНДС.Скорректировать) КАК СпособКорректировкиНДС,
	               |	ЕСТЬNULL(НДСЗаписиКнигиПокупок.ВидЦенности, НЕОПРЕДЕЛЕНО) КАК ВидЦенности,
	               |	ЕСТЬNULL(НДСЗаписиКнигиПокупок.Событие, НЕОПРЕДЕЛЕНО) КАК Событие,
	               |	ЕСТЬNULL(НДСЗаписиКнигиПокупок.СтавкаНДС, НЕОПРЕДЕЛЕНО) КАК СтавкаНДС,
	               |	ЕСТЬNULL(-НДСЗаписиКнигиПокупок.СуммаБезНДСОборот, 0) КАК Сумма,
	               |	ЕСТЬNULL(-НДСЗаписиКнигиПокупок.НДСОборот, 0) КАК СуммаНДС
	               |ИЗ
	               |	ВТНакопленияИнвестиционныхНДС КАК ВТНакопленияИнвестиционныхНДС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НДСЗаписиКнигиПокупок.Обороты(
	               |				&НачалоПериода,
	               |				&ОкончаниеПериода,
	               |				,
	               |				СчетФактура В
	               |					(ВЫБРАТЬ
	               |						ВТНакопленияИнвестиционныхНДС.СчетФактура
	               |					ИЗ
	               |						ВТНакопленияИнвестиционныхНДС)) КАК НДСЗаписиКнигиПокупок
	               |		ПО ВТНакопленияИнвестиционныхНДС.СчетФактура = НДСЗаписиКнигиПокупок.СчетФактура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Константа.ВалютаРегламентированногоУчета КАК ВалютаРегламентированногоУчета
	               |		ПО (ИСТИНА)
	               |ГДЕ
	               |	(НЕ НДСЗаписиКнигиПокупок.СуммаБезНДСОборот = 0
	               |			ИЛИ НЕ НДСЗаписиКнигиПокупок.НДСОборот = 0)";
	
	ТаблицаСторнирования = Запрос.Выполнить().Выгрузить();
	
	РеквизитыШапкиДокумента	= "ДокументРасчетов, СчетУчетаНДС, Дата, Организация, Контрагент, ЗаписьДополнительногоЛиста, КорректируемыйПериод, Валюта, СпособКорректировкиНДС";
	ТаблицаДокументов		= ТаблицаСторнирования.Скопировать();
	ТаблицаДокументов.Свернуть(РеквизитыШапкиДокумента);
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
		
		СообщениеОбОшибке	= НСтр("ru='Не удалось создать сторнирующий документ для документа """ + Строка(СтрокаТаблицы.ДокументРасчетов) + """ по причине:'");
		СтруктураРеквизитов = Новый Структура(РеквизитыШапкиДокумента);
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, СтрокаТаблицы);
		
		СторнирующийДокумент = Документы.ЗаписьКнигиПокупок.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(СторнирующийДокумент, СтруктураРеквизитов);
		
		СтрокиДокумента = ТаблицаСторнирования.НайтиСтроки(СтруктураРеквизитов);
		Для Каждого СтрокаДокумента Из СтрокиДокумента Цикл
			ЗаполнитьЗначенияСвойств(СторнирующийДокумент.Ценности.Добавить(), СтрокаДокумента);
		КонецЦикла;
		
		Попытка
			СторнирующийДокумент.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке + " " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), , , , Отказ);
		КонецПопытки;
		
		Если СторнирующийДокумент.Проведен Тогда
			ОтразитьЗаписьКнигиПокупокВРегламентированномУчете(СторнирующийДокумент.Ссылка, СтрокаТаблицы.ДокументРасчетов, СтрокаТаблицы.СчетУчетаНДС);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // СформироватьСторнирующиеДокументыЗаписьКнигиПокупок()

// Процедура отражает сформированный и проведенный перед этим документ "Запись книги покупок" в регламентированном учете.
//
Процедура ОтразитьЗаписьКнигиПокупокВРегламентированномУчете(СторнирующийДокументСсылка, ДокументРасчетов, СчетУчетаНДС)
	
	ЗаполнитьРегистрПорядокОтраженияПрочихОпераций(СторнирующийДокументСсылка, ДокументРасчетов, СчетУчетаНДС);
	
	СтруктураРеквизиты = Новый Структура("Ссылка, Дата, Организация", СторнирующийДокументСсылка, СторнирующийДокументСсылка.Дата, СторнирующийДокументСсылка.Организация);
	РеглУчетПроведениеСервер.ОтразитьДокумент(СтруктураРеквизиты, Истина);
	
КонецПроцедуры // ОтразитьЗаписьКнигиПокупокВРегламентированномУчете()

// Процедура заполняет регистр сведений "Порядок отражения прочих операций" необходимыми для проведения документа сведениями.
//
Процедура ЗаполнитьРегистрПорядокОтраженияПрочихОпераций(СторнирующийДокументСсылка, ДокументРасчетов, СчетУчетаНДС)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчетУчетаНДС"	 	 , СчетУчетаНДС);
	Запрос.УстановитьПараметр("ДокументРасчетов"	 , ДокументРасчетов);
	Запрос.УстановитьПараметр("СторнирующийДокумент" , СторнирующийДокументСсылка);

	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаписьКнигиПокупокЦенности.Ссылка КАК Документ,
	               |	ЗаписьКнигиПокупокЦенности.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	&СчетУчетаНДС КАК СчетУчета,
	               |	ЗаписьКнигиПокупок.Организация КАК Организация,
	               |	ЗаписьКнигиПокупок.Дата КАК Дата
	               |ПОМЕСТИТЬ ВТЦенностиЗаписиКнигиПокупок
	               |ИЗ
	               |	Документ.ЗаписьКнигиПокупок.Ценности КАК ЗаписьКнигиПокупокЦенности
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаписьКнигиПокупок КАК ЗаписьКнигиПокупок
	               |		ПО ЗаписьКнигиПокупокЦенности.Ссылка = ЗаписьКнигиПокупок.Ссылка
	               |ГДЕ
	               |	ЗаписьКнигиПокупокЦенности.Ссылка = &СторнирующийДокумент
	               |
	               |ИНДЕКСИРОВАТЬ ПО
