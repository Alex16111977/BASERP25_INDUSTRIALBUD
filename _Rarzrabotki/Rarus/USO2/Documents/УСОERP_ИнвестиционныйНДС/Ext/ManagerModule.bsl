
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПроверкиПередЗаполнением

// Функция проверяет наличие документов "Инвестиционный НДС" по заданным условиям и возвращает результат данной проверки.
//
Функция ПроверитьНаличиеДокументовИнвестиционныйНДСЗаПериод(Объект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода"		, НачалоМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("ОкончаниеПериода"	, КонецМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("ТекущийДокумент"		, Объект.Ссылка);
	Запрос.УстановитьПараметр("ОбъектСтроительства"	, Объект.ОбъектСтроительства);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ИнвестиционныйНДС.Ссылка КАК ДокументПоОбъектуСтроительства
	               |ИЗ
	               |	Документ.УСОERP_ИнвестиционныйНДС КАК ИнвестиционныйНДС
	               |ГДЕ
	               |	ИнвестиционныйНДС.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	               |	И НЕ ИнвестиционныйНДС.Ссылка = &ТекущийДокумент
	               |	И ИнвестиционныйНДС.ОбъектСтроительства = &ОбъектСтроительства
	               |	И ИнвестиционныйНДС.Проведен";
				   
	ДокументыСуществуют = Не Запрос.Выполнить().Пустой();
	Если ДокументыСуществуют Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='По выбранному объекту строительства за текущий месяц уже существуют документы ""Инвестиционный НДС""'"));
	КонецЕсли;
	
	Возврат ДокументыСуществуют;	
	
КонецФункции // ПроверитьНаличиеДокументовИнвестиционныйНДСЗаПериод()

// Функция проверяет наличие документов "Закрытие объекта строительства" по заданным условиям и возвращает результат данной проверки.
//
Функция ПроверитьНаличиеДокументовЗакрытиеОбъектаСтроительстваЗаПериод(Объект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода"		, НачалоМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("ОкончаниеПериода"	, КонецМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("ОбъектСтроительства"	, Объект.ОбъектСтроительства);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЗакрытиеОбъектаСтроительства.Ссылка КАК ДокументПоОбъектуСтроительства
	               |ИЗ
	               |	Документ.УСОERP_ЗакрытиеОбъектаСтроительства КАК ЗакрытиеОбъектаСтроительства
	               |ГДЕ
	               |	ЗакрытиеОбъектаСтроительства.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	               |	И ЗакрытиеОбъектаСтроительства.ОбъектСтроительства = &ОбъектСтроительства
	               |	И ЗакрытиеОбъектаСтроительства.Проведен";
				   
	ДокументыСуществуют = Не Запрос.Выполнить().Пустой();
	Если ДокументыСуществуют Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='По выбранному объекту строительства за текущий месяц уже существуют документы ""Закрытие объекта строительства""'"));
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	УСОERP_СдачаОбъектаНедвижимости.Ссылка КАК ДокументПоОбъектуСтроительства
	               |ИЗ
	               |	Документ.УСОERP_СдачаОбъектаНедвижимости КАК УСОERP_СдачаОбъектаНедвижимости
	               |ГДЕ
	               |	УСОERP_СдачаОбъектаНедвижимости.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	               |	И УСОERP_СдачаОбъектаНедвижимости.ОбъектСтроительства = &ОбъектСтроительства
	               |	И УСОERP_СдачаОбъектаНедвижимости.Проведен";
				   
	ДокументыСуществуют = Не Запрос.Выполнить().Пустой();
	Если ДокументыСуществуют Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='По выбранному объекту строительства за текущий месяц уже существуют документы ""Сдача объекта недвижимости в эксплуатацию""'"));
	КонецЕсли;

	
	Возврат ДокументыСуществуют;	
	
КонецФункции // ПроверитьНаличиеДокументовЗакрытиеОбъектаСтроительстваЗаПериод()

// Функция проверяет проведение текущего документа перед его заполнением и возвращает результат данной проверки.
//
Функция ПроверитьПроведениеТекущегоДокументаПередЗаполнением(Объект) Экспорт
	
	ДокументПроведен = Объект.Проведен;
	Если ДокументПроведен Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Заполнение доступно только для непроведенного документа, сначала необходимо отменить проведение'"));
	КонецЕсли;
	
	Возврат ДокументПроведен;	
	
КонецФункции // ПроверитьПроведениеТекущегоДокументаПередЗаполнением()

#КонецОбласти

#Область ПроводкиРеглУчета

// Функция формирует и возвращает текст запроса для отражения документа в регламентированном учете.
