	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 

&НаСервере
Процедура СформироватьТаБлицуПоказателиПоПериодамНаСервере()
	ПоказателиПоПериодам.Очистить();
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.УСОERP_РасчетЦелевыхПоказателей.Макет_ПоказателиПоПериодам");
	ОбластьМакета = Макет.ПолучитьОбласть("Показатели");
	
	ПоказателиПоПериодам.Вывести(ОбластьМакета);
	
	Если Объект.ПоказателиПоПериодам.Количество()> 0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("ЗначениеПоказателей");
		Для Каждого стр из Объект.ПоказателиПоПериодам Цикл
			ОбластьМакета.Параметры.Период 		= Формат(стр.Период,"ДЛФ=Д");
			ОбластьМакета.Параметры.ЗначениеЧДП = стр.ЧистыйДенежныйПоток;
			ОбластьМакета.Параметры.ЗначениеФД	= стр.ФакторДисконта;
			ОбластьМакета.Параметры.ЗначениеПС	= стр.ПриведеннаяСтоимость;
			ПоказателиПоПериодам.Присоединить(ОбластьМакета);
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьТаблицуПоказателиПоПериодам()
	
	СформироватьТаблицуПоказателиПоПериодамНаСервере();
	ЭтаФорма.ПоказателиПоПериодам.ФиксацияСлева = 1;
	//ЭтаФорма.ПоказателиПоПериодам.Показать();
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьПоказателиНаСервере()
	
	//Обновим таблицу показатели
	Объект.Показатели.Очистить();
	
	стр = Объект.Показатели.Добавить();
	стр.Показатель = Справочники.УСОERP_ЦелевыеПоказателиИПараметрыОбъектаСтроительства.ЧистаяПриведеннаяСтоимость;
	
	стр = Объект.Показатели.Добавить();
	стр.Показатель = Справочники.УСОERP_ЦелевыеПоказателиИПараметрыОбъектаСтроительства.Окупаемость;
	
	стр = Объект.Показатели.Добавить();
	стр.Показатель = Справочники.УСОERP_ЦелевыеПоказателиИПараметрыОбъектаСтроительства.ДисконтированнаяОкупаемость;
	
	стр = Объект.Показатели.Добавить();
	стр.Показатель = Справочники.УСОERP_ЦелевыеПоказателиИПараметрыОбъектаСтроительства.ВнутренняяНормаРентабельности;
	
	стр = Объект.Показатели.Добавить();
	стр.Показатель = Справочники.УСОERP_ЦелевыеПоказателиИПараметрыОбъектаСтроительства.БухгалтерскаяНормаПрибыли;
	
	//Обновим таблицу Параметры
	Объект.Параметры.Очистить();
	
	стр = Объект.Параметры.Добавить();
	стр.Показатель = Перечисления.УСОERP_ПараметрыДляРасчетаЦелевыхПоказателей.НачальныеИнвестиции;
	
	стр = Объект.Параметры.Добавить();
	стр.Показатель = Перечисления.УСОERP_ПараметрыДляРасчетаЦелевыхПоказателей.НачальнаяСтавкаДисконтирования;
	
	стр = Объект.Параметры.Добавить();
	стр.Показатель = Перечисления.УСОERP_ПараметрыДляРасчетаЦелевыхПоказателей.ШагДляСтавкиДисконтирования;
	
	стр = Объект.Параметры.Добавить();
	стр.Показатель = Перечисления.УСОERP_ПараметрыДляРасчетаЦелевыхПоказателей.МаксимальнаяСтавкаДисконтирования;
	
	стр = Объект.Параметры.Добавить();
	стр.Показатель = Перечисления.УСОERP_ПараметрыДляРасчетаЦелевыхПоказателей.СуммаИнвестиций;
	
	стр = Объект.Параметры.Добавить();
	стр.Показатель = Перечисления.УСОERP_ПараметрыДляРасчетаЦелевыхПоказателей.СреднегодоваяПрибыль;
	
	стр = Объект.Параметры.Добавить();
	стр.Показатель = Перечисления.УСОERP_ПараметрыДляРасчетаЦелевыхПоказателей.ОстаточнаяСтоимостьАктивов;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоказатели(Команда)	
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьПоказателиПродолжение",ЭтотОбъект),"Списки показателей и параметров будут очищены. Продолжить?!", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоказателиПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоказателиНаСервере();
	КонецЕсли;	
	
КонецПроцедуры  
&НаСервере
Процедура РассчитатьПоказателиНаСервере()
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_РасчетЦелевыхПоказателей_РассчитатьПоказателиНаСервере(ЭтотОбъект, Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтветственногоНаСервере()
	Объект.Ответственный = Пользователи.ТекущийПользователь();
КонецПроцедуры	

&НаКлиенте
Процедура РассчитатьПоказатели(Команда)
	РассчитатьПоказателиНаСервере();
	СформироватьТаблицуПоказателиПоПериодам();
	УстановитьОтветственногоНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВидБюджетаПриИзменении(Элемент)
	ВидБюджетаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВидБюджетаПриИзмененииНаСервере()
	Объект.СрокПроектаНачало	= Объект.ВидБюджета.НачалоПериода;
	Объект.СрокПроектаОкончание	= Объект.ВидБюджета.ОкончаниеПериода;
	Объект.Периодичность		= Объект.ВидБюджета.ВидБюджета.Периодичность;
КонецПроцедуры

&НаКлиенте
Процедура СтавкиДисконтированияДатаНачалаПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(ТекущийЭлемент.ТекущиеДанные.ДатаНачала) 
		ИЛИ ТекущийЭлемент.ТекущиеДанные.ДатаНачала < Объект.СрокПроектаНачало Тогда
		ТекущийЭлемент.ТекущиеДанные.ДатаНачала = Объект.СрокПроектаНачало;
	ИначеЕсли ТекущийЭлемент.ТекущиеДанные.ДатаНачала > Объект.СрокПроектаОкончание Тогда 	
		ТекущийЭлемент.ТекущиеДанные.ДатаНачала = Объект.СрокПроектаОкончание;
	КонецЕсли;	
	
КонецПроцедуры


&НаКлиенте
Процедура СтавкиДисконтированияЗначениеПриИзменении(Элемент)
	Если ТекущийЭлемент.ТекущиеДанные.Значение > 1 Тогда
		ТекущийЭлемент.ТекущиеДанные.Значение = 1;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ТекущийЭлемент.ТекущиеДанные.ДатаНачала) 
		ИЛИ ТекущийЭлемент.ТекущиеДанные.ДатаНачала < Объект.СрокПроектаНачало Тогда
		ТекущийЭлемент.ТекущиеДанные.ДатаНачала = Объект.СрокПроектаНачало;
	ИначеЕсли ТекущийЭлемент.ТекущиеДанные.ДатаНачала > Объект.СрокПроектаОкончание Тогда 	
		ТекущийЭлемент.ТекущиеДанные.ДатаНачала = Объект.СрокПроектаОкончание;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти
