&НаКлиенте
Процедура НоваяСтрока(Команда)
	
	ТекущаяСтрока = Элементы.ТабельДеревоЗначений.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.СоставРесурса) Тогда
		Если ТекущаяСтрока.ЭтоРесурс Тогда
			СтрокиСостава = ТекущаяСтрока.ПолучитьЭлементы();
			НоваяСтрока = СтрокиСостава.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			НоваяСтрока.ЭтоРабота 		= Ложь;
			НоваяСтрока.ЭтоРесурс 		= Ложь;
			НоваяСтрока.Работа 			= ТекущаяСтрока.Работа;
			НоваяСтрока.Ресурс 			= ТекущаяСтрока.Ресурс;
			НоваяСтрока.СоставРесурса 	= ТекущаяСтрока.СоставРесурса;

			Элементы.ТабельДеревоЗначений.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		Иначе
			Родитель = ТекущаяСтрока.ПолучитьРодителя();
			СтрокиСостава = Родитель.ПолучитьЭлементы();
			НоваяСтрока = СтрокиСостава.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Родитель);
			НоваяСтрока.ЭтоРабота 		= Ложь;
			НоваяСтрока.ЭтоРесурс 		= Ложь;
			НоваяСтрока.Работа 			= Родитель.Работа;
			НоваяСтрока.Ресурс 			= Родитель.Ресурс;
			НоваяСтрока.СоставРесурса 	= Родитель.СоставРесурса;
			
			Элементы.ТабельДеревоЗначений.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		КонецЕсли;
		Модифицированность = Истина;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Добавить сотрудника либо технику можно только к определенному составу ресурса.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРесурс(Команда)
	
	ТекущаяСтрока = Элементы.ТабельДеревоЗначений.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.Работа) Тогда
		Если ТекущаяСтрока.ЭтоРабота Тогда
			
			СтрокиРесурсов = ТекущаяСтрока.ПолучитьЭлементы();
			НоваяСтрока = СтрокиРесурсов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			НоваяСтрока.ЭтоРабота 		= Ложь;
			НоваяСтрока.ЭтоРесурс 		= Истина;
			НоваяСтрока.Работа 			= ТекущаяСтрока.Работа;
			НоваяСтрока.РаботаРесурс    = ПредопределенноеЗначение("Справочник.УСОERP_Ресурсы.ПустаяСсылка");
			НоваяСтрока.СоставРесурса 	= ПредопределенноеЗначение("Справочник.УСОERP_СоставРесурсов.ПустаяСсылка");
			НоваяСтрока.Ресурс 			= ПредопределенноеЗначение("Справочник.УСОERP_Ресурсы.ПустаяСсылка");
			
			Элементы.ТабельДеревоЗначений.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
			
		ИначеЕсли ТекущаяСтрока.ЭтоРесурс Тогда
			Родитель = ТекущаяСтрока.ПолучитьРодителя();
			СтрокиРесурсов = Родитель.ПолучитьЭлементы();
			НоваяСтрока = СтрокиРесурсов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Родитель);
			НоваяСтрока.ЭтоРабота 		= Ложь;
			НоваяСтрока.ЭтоРесурс 		= Истина;
			НоваяСтрока.Работа 			= ТекущаяСтрока.Работа;
			НоваяСтрока.РаботаРесурс    = ПредопределенноеЗначение("Справочник.УСОERP_Ресурсы.ПустаяСсылка");
			НоваяСтрока.СоставРесурса 	= ПредопределенноеЗначение("Справочник.УСОERP_СоставРесурсов.ПустаяСсылка");
			НоваяСтрока.Ресурс 			= ПредопределенноеЗначение("Справочник.УСОERP_Ресурсы.ПустаяСсылка");
			
			Элементы.ТабельДеревоЗначений.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		Иначе
			РодительРесурс = ТекущаяСтрока.ПолучитьРодителя();
			РодительРабота = РодительРесурс.ПолучитьРодителя();
			СтрокиРесурсов = РодительРабота.ПолучитьЭлементы();
			НоваяСтрока = СтрокиРесурсов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РодительРабота);
			НоваяСтрока.ЭтоРабота 		= Ложь;
			НоваяСтрока.ЭтоРесурс 		= Истина;
			НоваяСтрока.Работа 			= РодительРабота.Работа;
			НоваяСтрока.РаботаРесурс    = ПредопределенноеЗначение("Справочник.УСОERP_Ресурсы.ПустаяСсылка");
			
			Элементы.ТабельДеревоЗначений.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		КонецЕсли;
		Модифицированность = Истина;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Добавить ресурс можно только к определенной работе.");
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура РазбитьСтроку(Команда)
	ТекущаяСтрока = Элементы.ТабельДеревоЗначений.ТекущиеДанные;
	Попытка
	Если ЗначениеЗаполнено(ТекущаяСтрока.РаботаРесурс) Тогда
	Если ТипЗнч(ТекущаяСтрока.РаботаРесурс) = Тип("СправочникСсылка.УСОERP_Ресурсы") Тогда
		РодительСтроки = ТекущаяСтрока.ПолучитьРодителя();
		ЭлементыСтроки = РодительСтроки.ПолучитьЭлементы();   
	Иначе	 
		РодительСтроки = ТекущаяСтрока.ПолучитьРодителя();
		ЭлементыСтроки = ТекущаяСтрока.ПолучитьЭлементы();
	КонецЕсли;
	
	НоваяСтрока = ЭлементыСтроки.Добавить();
	НоваяСтрока.РаботаРодитель =  РодительСтроки;
	Иначе
		Элементы.ТабельДеревоЗначений.ДобавитьСтроку();
	КонецЕсли;
	Исключение
		Элементы.ТабельДеревоЗначений.ДобавитьСтроку();
	КонецПопытки;
	
КонецПроцедуры

