// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 

&НаКлиенте
Процедура ЗаполнитьПоДокументуОснованию(Команда)
	
	Если Объект.РаспределениеПоАналитикеДоговора.Количество() <> 0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьВопросПользователю", ЭтотОбъект), 
		"При автоматическом заполнении табличная часть документа будет очищена.", 
		РежимДиалогаВопрос.ОКОтмена);
		
	Иначе
		ЗаполнитьПоДокументуОснованиюНаСервере();
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументуОснованиюНаСервере()
	
	Объект.РаспределениеПоАналитикеДоговора.Очистить();
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ДокументОснование", Объект.ДокументОснование);
	ПараметрыЗаполнения.Вставить("Дата", Объект.Дата);
	ПараметрыЗаполнения.Вставить("Договор", Объект.Договор);
	ПараметрыЗаполнения.Вставить("ОбъектСтроительства", Объект.ОбъектСтроительства);
	ПараметрыЗаполнения.Вставить("ДанныеРаспределения", Объект.РаспределениеПоАналитикеДоговора.Выгрузить());
	ПараметрыЗаполнения.Вставить("ДокументУтверждения",Объект.ДокументУтверждения);
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.УСОERP_АктПриемкиРабот") Тогда
		Документы.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ЗаполнитьНаОснованииАктаПриемкиРабот(ПараметрыЗаполнения);
	ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.УСОERP_РеализацияСтроительныхРабот") Тогда
		Документы.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ЗаполнитьНаОснованииРеализацииСтроительныхРабот(ПараметрыЗаполнения);
	КонецЕсли;
	
	Объект.РаспределениеПоАналитикеДоговора.Загрузить(ПараметрыЗаполнения.ДанныеРаспределения);
	
КонецПроцедуры

&НаКлиенте
Процедура 	ЗаполнитьВопросПользователю(РезультатВопроса, ДополнительныеПараметры) Экспорт								
	
	Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.ОК Тогда
		ЗаполнитьПоДокументуОснованиюНаСервере();
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиПараметровФормы

&НаСервере
Функция 	СтруктураПараметрыФормы()												
	
	ПараметрыФормы 		= Новый Структура;
	
	
	НайтиДополнительныеПараметрыПоДоговору(ПараметрыФормы, Объект.Договор);
	
	
	МассивТипов = МассивТиповДоговоров(Объект.Договор);
	ПараметрыФормы.Вставить("МассивТипов", МассивТипов);
	
	
	ПараметрыФормы.Вставить("ВидПланирования", Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный);
	
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаСервереБезКонтекста
Процедура 	НайтиДополнительныеПараметрыПоДоговору(ПараметрыФормы, Договор)			
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Ссылка КАК ДополнительныеПараметрыПоДоговору
	|ИЗ
	|	Документ.УСОERP_ДополнительныеПараметрыПоДоговору КАК УСОERP_ДополнительныеПараметрыПоДоговору
	|ГДЕ
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Договор = &Договор
	|	И НЕ УСОERP_ДополнительныеПараметрыПоДоговору.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Договор", Договор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ДополнительныеПараметрыПоДоговору = Новый Структура;
		ДополнительныеПараметрыПоДоговору.Вставить("Ссылка", 							Выборка.ДополнительныеПараметрыПоДоговору);
		ДополнительныеПараметрыПоДоговору.Вставить("ПоВидамРабот", 						Выборка.ДополнительныеПараметрыПоДоговору.ПоВидамРабот);
		ДополнительныеПараметрыПоДоговору.Вставить("ПоРаботам", 						Выборка.ДополнительныеПараметрыПоДоговору.ПоРаботам);
		
		Если ПараметрыФормы.Свойство("ДополнительныеПараметрыПоДоговору") Тогда
			ПараметрыФормы.ДополнительныеПараметрыПоДоговору = ДополнительныеПараметрыПоДоговору;
		Иначе
			ПараметрыФормы.Вставить("ДополнительныеПараметрыПоДоговору", ДополнительныеПараметрыПоДоговору);
		КонецЕсли;
		
	Иначе
		
		ДополнительныеПараметрыПоДоговору = Новый Структура;
		ДополнительныеПараметрыПоДоговору.Вставить("Ссылка", 							Документы.УСОERP_ДополнительныеПараметрыПоДоговору.ПустаяСсылка());
		ДополнительныеПараметрыПоДоговору.Вставить("ПоВидамРабот", 						Ложь);
		ДополнительныеПараметрыПоДоговору.Вставить("ПоРаботам", 						Ложь);
		
		Если ПараметрыФормы.Свойство("ДополнительныеПараметрыПоДоговору") Тогда
			ПараметрыФормы.ДополнительныеПараметрыПоДоговору = ДополнительныеПараметрыПоДоговору;
		Иначе
			ПараметрыФормы.Вставить("ДополнительныеПараметрыПоДоговору", ДополнительныеПараметрыПоДоговору);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция		МассивТиповДоговоров(Договор)											
	
	МассивТипов = Новый Массив();   
	
	Если Договор.ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком 
		ИЛИ Договор.ТипДоговора = Перечисления.ТипыДоговоров.СПереработчиком Тогда
		МассивТипов.Добавить(Тип("ПеречислениеСсылка.ВариантыОплатыПоставщику"));
	ИначеЕсли Договор.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем 
		ИЛИ Договор.ТипДоговора = Перечисления.ТипыДоговоров.СДавальцем Тогда
		МассивТипов.Добавить(Тип("ПеречислениеСсылка.ВариантыОплатыКлиентом"));
	КонецЕсли;
	
	Возврат МассивТипов;
	
КонецФункции

&НаСервереБезКонтекста
Функция		ПолучитьобъектСтроительства(Договор)									
	
	Возврат Договор.УСОERP_ОсновнойПроект;
	
КонецФункции

#КонецОбласти 

#Область ОбработчикиПредставленияФормы

&НаКлиенте
Процедура 	ОбновитьФормуНаКлиенте()												
	
	МассивТипов 		= ПараметрыФормы.МассивТипов;
	
	Элементы.РаспределениеПоАналитикеДоговораПорядокРасчетов.ОграничениеТипа = Новый ОписаниеТипов(МассивТипов);
	
	Элементы.РаспределениеПоАналитикеДоговораВидРабот.Видимость 	= ПараметрыФормы.ДополнительныеПараметрыПоДоговору.ПоВидамРабот;
	Элементы.РаспределениеПоАналитикеДоговораРабота.Видимость 		= ПараметрыФормы.ДополнительныеПараметрыПоДоговору.ПоРаботам;
	Элементы.РаспределениеПоАналитикеДоговораРаботаКодСДР.Видимость = ПараметрыФормы.ДополнительныеПараметрыПоДоговору.ПоРаботам;
	
КонецПроцедуры

