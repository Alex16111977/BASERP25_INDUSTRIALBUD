&НаСервере
Процедура ЗаполнитьТипСоглашения()
	
	Если ЗначениеЗаполнено(Объект.Соглашение) Или ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Возврат;
	//  ДокументСсылка.АвансовыйОтчет
	//  ДокументСсылка.АктВыполненныхРабот
	//  ДокументСсылка.ВзаимозачетЗадолженности
	//  ДокументСсылка.ВозвратТоваровОтКлиента
	// ДокументСсылка.ЗаказКлиента 
	//ДокументСсылка.ЗаказПоставщику 
	// ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств 
	//ДокументСсылка.ОтчетДавальцу 
	// ДокументСсылка.ОтчетПереработчика 
	// ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств 
	// ДокументСсылка.ПриходныйКассовыйОрдер 
	// ДокументСсылка.РасходныйКассовыйОрдер
	// ДокументСсылка.РеализацияТоваровУслуг
	//ДокументСсылка.РеализацияУслугПрочихАктивов
	// ДокументСсылка.СписаниеБезналичныхДенежныхСредств 
	// ДокументСсылка.СписаниеЗадолженности
	//ДокументСсылка.ПриобретениеТоваровУслуг 
	// ДокументСсылка.УСОERP_АктПриемкиРабот
	//ДокументСсылка.УСОERP_РеализацияСтроительныхРабот	
	ТипОснования = ТипЗнч(Объект.ДокументОснование);
	
	Если ТипОснования = Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств") ИЛИ 
		ТипОснования = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") ИЛИ 
		ТипОснования = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		
		ОписаниеТипа = Новый ОписаниеТипов("СправочникСсылка.СоглашенияСПоставщиками");
		
	Иначе
		
		ОписаниеТипа = Новый ОписаниеТипов("СправочникСсылка.СоглашенияСКлиентами");
		
	КонецЕсли;
	
	Элементы.Соглашение.ОграничениеТипа = ОписаниеТипа;
	
	Элементы.Соглашение.ВыбиратьТип = Ложь; 	
	
КонецПроцедуры  

&НаСервере
Процедура 	ЗаполнитьДанныеФормыНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		
		ДопПараметры = Новый Структура;
		НайтиДополнительныеПараметрыПоДоговору(ДопПараметры, Объект.Договор);
		
	КонецЕсли;
	
	СценарийПланирования = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьРабочийСценарий(Объект.ОбъектСтроительства, Объект.Организация);
	
	Возврат;
	
	ДокументОснование 				= Объект.ДокументОснование;
	МетаданныеОснования 			= ДокументОснование.Метаданные();
	
	Если МетаданныеОснования.Реквизиты.Найти("Организация") <> Неопределено Тогда
		Объект.Организация 			= ДокументОснование.Организация;
	КонецЕсли;
	
	Если МетаданныеОснования.Реквизиты.Найти("Партнер") <> Неопределено Тогда 
		Объект.Партнер 				= ДокументОснование.Партнер;
	ИначеЕсли МетаданныеОснования.Реквизиты.Найти("Субподрядчик") <> Неопределено Тогда 
		Объект.Партнер 				= ДокументОснование.Субподрядчик;
	КонецЕсли;
	
	Если МетаданныеОснования.Реквизиты.Найти("Соглашение") <> Неопределено Тогда 
		Объект.Соглашение 			= ДокументОснование.Соглашение;
	КонецЕсли;
	
	Если МетаданныеОснования.Реквизиты.Найти("Контрагент") <> Неопределено Тогда 
		Объект.Контрагент 			= ДокументОснование.Контрагент;
	КонецЕсли;
	
	Если МетаданныеОснования.Реквизиты.Найти("Договор") <> Неопределено Тогда 
		Объект.Договор 				= ДокументОснование.Договор;
	КонецЕсли;
	
	Если МетаданныеОснования.Реквизиты.Найти("ДокументУтверждения") <> Неопределено Тогда 
		Объект.ДокументУтверждения 				= ДокументОснование.ДокументУтверждения;
	КонецЕсли;
	
	Если МетаданныеОснования.Реквизиты.Найти("НаправлениеДеятельности") <> Неопределено Тогда 
		Объект.НаправлениеДеятельности 				= ДокументОснование.НаправлениеДеятельности;
	КонецЕсли;
	
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ДопПараметры = Новый Структура;
		НайтиДополнительныеПараметрыПоДоговору(ДопПараметры, Объект.Договор);
		Объект.ОбъектСтроительства 	= ДопПараметры.ДополнительныеПараметрыПоДоговору.Ссылка.ОбъектСтроительства;
	КонецЕсли;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств")
		И МетаданныеОснования.Реквизиты.Найти("ДокументОснование") <> Неопределено Тогда
		
		Если ТипЗнч(ДокументОснование.ДокументОснование) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда 
			Объект.Договор 			= ДокументОснование.ДокументОснование;
		Иначе
			МетаданныеЗаявки 		= ДокументОснование.ДокументОснование.Метаданные();
			Если МетаданныеЗаявки.Реквизиты.Найти("Договор") <> Неопределено И ЗначениеЗаполнено(ДокументОснование.ДокументОснование.Договор) Тогда
				Объект.Договор 		= ДокументОснование.ДокументОснование.Договор;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств") Тогда
		Если МетаданныеОснования.Реквизиты.Найти("ЗаявкаНаРасходованиеДенежныхСредств") <> Неопределено 
			И ЗначениеЗаполнено(ДокументОснование.ЗаявкаНаРасходованиеДенежныхСредств.ДокументОснование) Тогда
			
			Если ТипЗнч(ДокументОснование.ЗаявкаНаРасходованиеДенежныхСредств.ДокументОснование) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
				Объект.Договор		= ДокументОснование.ЗаявкаНаРасходованиеДенежныхСредств.ДокументОснование;
			Иначе
				МетаданныеЗаявки = ДокументОснование.ЗаявкаНаРасходованиеДенежныхСредств.ДокументОснование.Метаданные();
				Если МетаданныеЗаявки.Реквизиты.Найти("Договор") <> Неопределено И ЗначениеЗаполнено(ДокументОснование.ЗаявкаНаРасходованиеДенежныхСредств.ДокументОснование.Договор) Тогда
					Объект.Договор 	= ДокументОснование.ЗаявкаНаРасходованиеДенежныхСредств.ДокументОснование.Договор;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура	ПередЗаписью(Отказ, ПараметрыЗаписи)									
	
	ПередЗаписьюНаСервере(Отказ);
	
КонецПроцедуры

&НаСервере
Процедура 	ПередЗаписьюНаСервере(Отказ)											
	
	ИтоговаяСумма = 0;
	ТЗ_СуммаПоДокументу = Объект.РаспределениеПоАналитикеДоговора.Выгрузить(,"Сумма");
	Если ТЗ_СуммаПоДокументу.Количество() <> 0 Тогда
		ТЗ_СуммаПоДокументу.Свернуть("", "Сумма");
		ИтоговаяСумма = ТЗ_СуммаПоДокументу[0].Сумма;
	КонецЕсли;
	
	Коэффициент = 1;
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование)
		И Объект.ДокументОснование.Метаданные().Реквизиты.Найти("СуммаДокумента") <> Неопределено Тогда
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ВозвратТоваровОтКлиента") И 
			Объект.ДокументОснование.СпособКомпенсации = Перечисления.СпособыКомпенсацииВозвратовТоваров.ВернутьДенежныеСредства Тогда
			Коэффициент = -1;
		КонецЕсли;
		
		Если ИтоговаяСумма*Коэффициент <> Объект.ДокументОснование.СуммаДокумента Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Сумма документа-основания: " + Объект.ДокументОснование + " должна соответствовать введенной сумме!" 
			+ Символы.ПС + "Сумма документа-основания: " + Объект.ДокументОснование.СуммаДокумента*Коэффициент
			+ Символы.ПС + "Сумма текущего распределения: " + ИтоговаяСумма;
			Сообщение.Сообщить();
			Отказ = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура 	ДоговорПриИзменении(Элемент)											
	
	НайтиДополнительныеПараметрыПоДоговору(ПараметрыФормы, Объект.Договор);
	ПараметрыФормы.МассивТипов = МассивТиповДоговоров(Объект.Договор);
	объект.ОбъектСтроительства = ПолучитьобъектСтроительства(Объект.Договор);
	ОбновитьФормуНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура 	РаспределениеПоАналитикеДоговораПорядокРасчетовПриИзменении(Элемент)	
	
	Элементы.РаспределениеПоАналитикеДоговораПорядокДоходовРасходов.ТолькоПросмотр = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура 	РаспределениеПоАналитикеДоговораПорядокДоходовРасходовПриИзменении(Элемент)										
	
	Элементы.РаспределениеПоАналитикеДоговораПорядокРасчетов.ТолькоПросмотр = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура 	РаспределениеПоАналитикеДоговораПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)	
	
	Элементы.РаспределениеПоАналитикеДоговораПорядокРасчетов.ТолькоПросмотр 		= Ложь;
	Элементы.РаспределениеПоАналитикеДоговораПорядокДоходовРасходов.ТолькоПросмотр 	= Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура 	РаспределениеПоАналитикеДоговораПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)			
	
	Если (Элемент.ТекущийЭлемент.Имя = "РаспределениеПоАналитикеДоговораПорядокРасчетов"
		И НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.ПорядокРасчетов)) 
		ИЛИ (Элемент.ТекущийЭлемент.Имя = "РаспределениеПоАналитикеДоговораПорядокДоходовРасходов" 
		И НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.ПорядокДоходовРасходов))  Тогда
		Элементы.РаспределениеПоАналитикеДоговораПорядокДоходовРасходов.ТолькоПросмотр 	= Ложь;
		Элементы.РаспределениеПоАналитикеДоговораПорядокРасчетов.ТолькоПросмотр 		= Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура 	РаспределениеПоАналитикеДоговораПослеУдаления(Элемент)															
	
	Элементы.РаспределениеПоАналитикеДоговораПорядокРасчетов.ТолькоПросмотр 		= Ложь;
	Элементы.РаспределениеПоАналитикеДоговораПорядокДоходовРасходов.ТолькоПросмотр 	= Ложь;
	
КонецПроцедуры

