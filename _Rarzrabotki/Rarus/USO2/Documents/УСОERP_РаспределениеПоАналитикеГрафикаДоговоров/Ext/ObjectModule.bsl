
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура 	ОбработкаПроведения(Отказ, РежимПроведения)											
	
	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	Документы.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	ОтразитьДвижения_ГрафикДвиженийПоДоговору(ДополнительныеСвойства, Движения, Отказ);
	
	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);

	ПроведениеСерверУТ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура 	ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)									
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	НаправлениеДеятельности = ДокументУтверждения.НаправлениеДеятельности;
	
	Если Не НайтиДополнительныеПараметрыПоДоговору() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ввод документа ""Распределение по аналитике графика договоров"" без дополнительных параметров по договору запрещен!",,,,Отказ);
	КонецЕсли; 	
	
	ПроведениеСерверУТ.УстановитьРежимПроведения(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиДвиженийДокумента

Процедура 	ОтразитьДвижения_ГрафикДвиженийПоДоговору(ДополнительныеСвойства, Движения, Отказ)	
	
	ТаблицаДвижений = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаРаспределениеПоАналитикеДоговора;
	
	Если Отказ ИЛИ ТаблицаДвижений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ДвиженияГрафик = Движения.УСОERP_ГрафикДвиженийПоДоговору;
	ДвиженияГрафик.Записывать = Истина;
	ДвиженияГрафик.Загрузить(ТаблицаДвижений);

КонецПроцедуры

#КонецОбласти

Функция	НайтиДополнительныеПараметрыПоДоговору()
	
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Возврат Истина;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Ссылка КАК ДополнительныеПараметрыПоДоговору
	|ИЗ
	|	Документ.УСОERP_ДополнительныеПараметрыПоДоговору КАК УСОERP_ДополнительныеПараметрыПоДоговору
	|ГДЕ
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Договор = &Договор
	|	И НЕ УСОERP_ДополнительныеПараметрыПоДоговору.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Договор", Договор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Следующий(); 	
	
КонецФункции

#КонецЕсли
