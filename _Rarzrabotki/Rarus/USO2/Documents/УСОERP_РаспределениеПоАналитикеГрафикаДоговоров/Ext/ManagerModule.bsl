
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Проведение

Процедура 	ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт				
	
	ДокументыДС = Новый СписокЗначений;
	ДокументыДС.Добавить(Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств"));
	ДокументыДС.Добавить(Тип("ДокументСсылка.ПриходныйКассовыйОрдер"));
	ДокументыДС.Добавить(Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств"));
	ДокументыДС.Добавить(Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств"));
	ДокументыДС.Добавить(Тип("ДокументСсылка.РасходныйКассовыйОрдер"));
	
	ДокументыДР = Новый СписокЗначений;
	ДокументыДР.Добавить(Тип("ДокументСсылка.ЗаказКлиента"));
	ДокументыДР.Добавить(Тип("ДокументСсылка.РеализацияТоваровУслуг"));
	ДокументыДР.Добавить(Тип("ДокументСсылка.РеализацияУслугПрочихАктивов"));
	ДокументыДР.Добавить(Тип("ДокументСсылка.ВозвратТоваровОтКлиента"));
	ДокументыДР.Добавить(Тип("ДокументСсылка.АктВыполненныхРабот"));
	ДокументыДР.Добавить(Тип("ДокументСсылка.ЗаказПоставщику"));
	ДокументыДР.Добавить(Тип("ДокументСсылка.ПриобретениеТоваровУслуг"));
	ДокументыДР.Добавить(Тип("ДокументСсылка.АвансовыйОтчет"));
	ДокументыДР.Добавить(Тип("ДокументСсылка.ОтчетПереработчика"));
	ДокументыДР.Добавить(Тип("ДокументСсылка.УСОERP_АктПриемкиРабот"));
	ДокументыДР.Добавить(Тип("ДокументСсылка.УСОERP_РеализацияСтроительныхРабот"));
	Если Метаданные.Документы.Найти("ОтчетДавальцу") <> Неопределено Тогда
		ДокументыДР.Добавить(Тип("ДокументСсылка.ОтчетДавальцу"));
	КонецЕсли;
	
	СписокЗаявок = Новый СписокЗначений;
	СписокЗаявок.Добавить(Тип("ДокументСсылка.ЗаказКлиента"));
	СписокЗаявок.Добавить(Тип("ДокументСсылка.ЗаказПоставщику"));
	СписокЗаявок.Добавить(Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств"));
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УСОERP_ДополнительныеПараметрыПоДоговору.Ссылка КАК ДополнительныеПараметрыПоДоговору
		|ПОМЕСТИТЬ ДопПараметрыПоДоговору
		|ИЗ
		|	Документ.УСОERP_ДополнительныеПараметрыПоДоговору КАК УСОERP_ДополнительныеПараметрыПоДоговору
		|ГДЕ
		|	УСОERP_ДополнительныеПараметрыПоДоговору.Договор = &Договор
		|	И НЕ УСОERP_ДополнительныеПараметрыПоДоговору.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	УСОERP_ДополнительныеПараметрыПоДоговору.Дата УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаявкаНаРасходованиеДенежныхСредств.Ссылка) КАК Количество
		|ПОМЕСТИТЬ КоличествоЗаявокНаРасходование
		|ИЗ
		|	Документ.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров КАК УСОERP_РаспределениеПоАналитикеГрафикаДоговоров
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаНаРасходованиеДенежныхСредств
		|		ПО УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ДокументОснование.ЗаявкаНаРасходованиеДенежныхСредств = ЗаявкаНаРасходованиеДенежныхСредств.Ссылка
		|ГДЕ
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Ссылка = &Ссылка
		|	И (УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ДокументОснование ССЫЛКА Документ.СписаниеБезналичныхДенежныхСредств
		|			ИЛИ УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ДокументОснование ССЫЛКА Документ.РасходныйКассовыйОрдер)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиента.Ссылка) КАК Количество
		|ПОМЕСТИТЬ КоличествоЗаказовКлиента
		|ИЗ
		|	Документ.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров КАК УСОERP_РаспределениеПоАналитикеГрафикаДоговоров
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
		|		ПО УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Организация = ЗаказКлиента.Организация
		|			И УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Партнер = ЗаказКлиента.Партнер
		|			И УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Соглашение = ЗаказКлиента.Соглашение
		|			И УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Контрагент = ЗаказКлиента.Контрагент
		|			И УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Договор = ЗаказКлиента.Договор
		|ГДЕ
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказПоставщику.Ссылка) КАК Количество
		|ПОМЕСТИТЬ КоличествоЗаказовПоставщику
		|ИЗ
		|	Документ.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров КАК УСОERP_РаспределениеПоАналитикеГрафикаДоговоров
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК ЗаказПоставщику
		|		ПО УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Организация = ЗаказПоставщику.Организация
		|			И УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Партнер = ЗаказПоставщику.Партнер
		|			И УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Соглашение = ЗаказПоставщику.Соглашение
		|			И УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Контрагент = ЗаказПоставщику.Контрагент
		|			И УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Договор = ЗаказПоставщику.Договор
		|ГДЕ
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&ВидДвиженияРасход КАК ВидДвижения,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Дата КАК Период,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.Ссылка КАК Регистратор,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Организация КАК Организация,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Партнер КАК Партнер,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Соглашение КАК Соглашение,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Контрагент КАК Контрагент,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Договор КАК Договор,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Дата КАК ДатаСобытияПоДоговору,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.ПорядокРасчетов КАК ПорядокОплаты,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.ПорядокДоходовРасходов КАК ПорядокДоходовРасходов,
		|	ВЫБОР
		|		КОГДА ДопПараметрыПоДоговору.ДополнительныеПараметрыПоДоговору.ПоВидамРабот
		|			ТОГДА УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.ВидРабот
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УСОERP_ВидыРабот.ПустаяСсылка)
		|	КОНЕЦ КАК ВидРабот,
		|	ВЫБОР
		|		КОГДА ДопПараметрыПоДоговору.ДополнительныеПараметрыПоДоговору.ПоРаботам
		|			ТОГДА ВЫБОР
		|					КОГДА УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
		|						ТОГДА УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.Работа
		|					ИНАЧЕ УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.Работа.РаботаИсточник
		|				КОНЕЦ
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
		|	КОНЕЦ КАК Работа,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ОбъектСтроительства КАК ОбъектСтроительства,
		|	ВЫБОР
		|		КОГДА УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ДокументОснование ССЫЛКА Документ.ЗаявкаНаРасходованиеДенежныхСредств
		|			ТОГДА ЕСТЬNULL(УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.Сумма, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ФинансированиеПлан,
		|	0 КАК ФинансированиеФакт,
		|	ВЫБОР
		|		КОГДА УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ДокументОснование ССЫЛКА Документ.ЗаказКлиента
		|				ИЛИ УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ДокументОснование ССЫЛКА Документ.ЗаказПоставщику
		|			ТОГДА ЕСТЬNULL(УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.Сумма, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПорядокДоходовРасходовПлан,
		|	0 КАК ПорядокДоходовРасходовФакт,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.СтатьяБюджета КАК СтатьяБюджета
		|ИЗ
		|	Документ.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.РаспределениеПоАналитикеДоговора КАК УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров КАК УСОERP_РаспределениеПоАналитикеГрафикаДоговоров
		|		ПО УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.Ссылка = УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Ссылка,
		|	ДопПараметрыПоДоговору КАК ДопПараметрыПоДоговору
		|ГДЕ
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.Ссылка = &Ссылка
		|	И ТИПЗНАЧЕНИЯ(УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ДокументОснование) В (&СписокЗаявок)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	&ВидДвиженияПриход,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Дата,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.Ссылка,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Организация,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Партнер,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Соглашение,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Контрагент,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Договор,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Дата,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.ПорядокРасчетов,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.ПорядокДоходовРасходов,
		|	ВЫБОР
		|		КОГДА ДопПараметрыПоДоговору.ДополнительныеПараметрыПоДоговору.ПоВидамРабот
		|			ТОГДА УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.ВидРабот
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УСОERP_ВидыРабот.ПустаяСсылка)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ДопПараметрыПоДоговору.ДополнительныеПараметрыПоДоговору.ПоРаботам
		|			ТОГДА ВЫБОР
		|					КОГДА УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
		|						ТОГДА УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.Работа
		|					ИНАЧЕ УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.Работа.РаботаИсточник
		|				КОНЕЦ
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
		|	КОНЕЦ,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ОбъектСтроительства,
		|	0,
		|	ВЫБОР
		|		КОГДА УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ДокументОснование ССЫЛКА Документ.ЗаявкаНаРасходованиеДенежныхСредств
		|			ТОГДА ЕСТЬNULL(УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.Сумма, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	0,
		|	ВЫБОР
		|		КОГДА УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ДокументОснование ССЫЛКА Документ.ЗаказКлиента
		|				ИЛИ УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ДокументОснование ССЫЛКА Документ.ЗаказПоставщику
		|			ТОГДА ЕСТЬNULL(УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.Сумма, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.СтатьяДвиженияДенежныхСредств,
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.СтатьяБюджета
		|ИЗ
		|	Документ.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.РаспределениеПоАналитикеДоговора КАК УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров КАК УСОERP_РаспределениеПоАналитикеГрафикаДоговоров
		|		ПО УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.Ссылка = УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Ссылка,
		|	ДопПараметрыПоДоговору КАК ДопПараметрыПоДоговору
		|ГДЕ
		|	УСОERP_РаспределениеПоАналитикеГрафикаДоговоровРаспределениеПоАналитикеДоговора.Ссылка = &Ссылка
