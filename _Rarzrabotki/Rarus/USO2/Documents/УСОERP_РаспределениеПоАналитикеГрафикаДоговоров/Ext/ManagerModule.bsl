Процедура ЗаполнитьНаОснованииАктаПриемкиРабот(ПараметрыЗаполнения) Экспорт
	
	ДокументОснование =  ПараметрыЗаполнения.ДокументОснование;
	ДанныеРаспределения =  ПараметрыЗаполнения.ДанныеРаспределения;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБюджетаБДР, ЗНАЧЕНИЕ(Справочник.СтатьиБюджетов.ПустаяСсылка)) КАК СтатьяБДР,
	|	УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.ПоВидамРабот КАК ПоВидамРабот
	|ПОМЕСТИТЬ ВТ_СтатьиБДР
	|ИЗ
	|	РегистрСведений.УСОERP_ДополнительныеПараметрыПоДоговору.СрезПоследних(
	|			&КонецПериода,
	|			Договор = &Договор
	|				И ОбъектСтроительства = &ОбъектСтроительства) КАК УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних
	|ГДЕ
	|	ЕСТЬNULL(УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБюджетаБДР, ЗНАЧЕНИЕ(Справочник.СтатьиБюджетов.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.СтатьиБюджетов.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_СтатьиБДР.ПоВидамРабот, ЛОЖЬ)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.Пустаяссылка)
	|		ИНАЧЕ УСОERP_АктПриемкиРаботРаботы.Работа
	|	КОНЕЦ КАК Работа,
	|	СУММА(УСОERP_АктПриемкиРаботРаботы.СуммаСНДС) КАК Сумма,
	|	ВТ_СтатьиБДР.СтатьяБДР КАК СтатьяБюджета,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_СтатьиБДР.ПоВидамРабот, ЛОЖЬ)
	|			ТОГДА УСОERP_АктПриемкиРаботРаботы.Работа.ВидРабот
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УСОERP_ВидыРабот.Пустаяссылка)
	|	КОНЕЦ КАК ВидРабот,
	|	ЗНАЧЕНИЕ(Перечисление.УСОERP_ПорядокДоходовРасходов.ПоступлениеЗатрат) КАК ПорядокДоходовРасходов
	|ИЗ
	|	Документ.УСОERP_АктПриемкиРабот.Работы КАК УСОERP_АктПриемкиРаботРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатьиБДР КАК ВТ_СтатьиБДР
	|		ПО (ИСТИНА)
	|ГДЕ
	|	УСОERP_АктПриемкиРаботРаботы.Ссылка = &ДокументОснование
	|	И УСОERP_АктПриемкиРаботРаботы.Работа.СуммарнаяРабота = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СтатьиБДР.СтатьяБДР,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_СтатьиБДР.ПоВидамРабот, ЛОЖЬ)
	|			ТОГДА УСОERP_АктПриемкиРаботРаботы.Работа.ВидРабот
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УСОERP_ВидыРабот.Пустаяссылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_СтатьиБДР.ПоВидамРабот, ЛОЖЬ)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.Пустаяссылка)
	|		ИНАЧЕ УСОERP_АктПриемкиРаботРаботы.Работа
	|	КОНЕЦ
	|
	|ИМЕЮЩИЕ
	|	СУММА(УСОERP_АктПриемкиРаботРаботы.СуммаСНДС) <> 0";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница( КонецДня(ПараметрыЗаполнения.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Договор", ПараметрыЗаполнения.Договор);
	Запрос.УстановитьПараметр("ОбъектСтроительства", ПараметрыЗаполнения.ОбъектСтроительства);
	
	Результат = Запрос.Выполнить();
	
	ДанныеРаспределения = Результат.Выгрузить();
	
	ПараметрыЗаполнения.ДанныеРаспределения = ДанныеРаспределения;
	
КонецПроцедуры

Процедура ЗаполнитьНаОснованииРеализацииСтроительныхРабот(ПараметрыЗаполнения) Экспорт
	
	ДокументОснование 	=  ПараметрыЗаполнения.ДокументОснование;
	ДанныеРаспределения =  ПараметрыЗаполнения.ДанныеРаспределения;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБюджетаБДР, ЗНАЧЕНИЕ(Справочник.СтатьиБюджетов.ПустаяСсылка)) КАК СтатьяБДР,
	|	УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.ПоВидамРабот КАК ПоВидамРабот
	|ПОМЕСТИТЬ ВТ_СтатьиБДР
	|ИЗ
	|	РегистрСведений.УСОERP_ДополнительныеПараметрыПоДоговору.СрезПоследних(
	|			&КонецПериода,
	|			Договор = &Договор
	|				И ОбъектСтроительства = &ОбъектСтроительства) КАК УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних
	|ГДЕ
	|	ЕСТЬNULL(УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБюджетаБДР, ЗНАЧЕНИЕ(Справочник.СтатьиБюджетов.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.СтатьиБюджетов.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_СтатьиБДР.ПоВидамРабот, ЛОЖЬ)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.Пустаяссылка)
	|		ИНАЧЕ УСОERP_РеализацияСтроительныхРаботРаботы.Работа
	|	КОНЕЦ КАК Работа,
	|	СУММА(УСОERP_РеализацияСтроительныхРаботРаботы.СуммаСНДС) КАК Сумма,
	|	ВТ_СтатьиБДР.СтатьяБДР КАК СтатьяБюджета,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_СтатьиБДР.ПоВидамРабот, ЛОЖЬ)
	|			ТОГДА УСОERP_РеализацияСтроительныхРаботРаботы.Работа.ВидРабот
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УСОERP_ВидыРабот.Пустаяссылка)
	|	КОНЕЦ КАК ВидРабот,
	|	ЗНАЧЕНИЕ(Перечисление.УСОERP_ПорядокДоходовРасходов.Реализация) КАК ПорядокДоходовРасходов
	|ИЗ
	|	Документ.УСОERP_РеализацияСтроительныхРабот.Работы КАК УСОERP_РеализацияСтроительныхРаботРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатьиБДР КАК ВТ_СтатьиБДР
	|		ПО (ИСТИНА)
	|ГДЕ
	|	УСОERP_РеализацияСтроительныхРаботРаботы.Ссылка = &ДокументОснование
	|	И НЕ УСОERP_РеализацияСтроительныхРаботРаботы.Работа.СуммарнаяРабота
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СтатьиБДР.СтатьяБДР,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_СтатьиБДР.ПоВидамРабот, ЛОЖЬ)
	|			ТОГДА УСОERP_РеализацияСтроительныхРаботРаботы.Работа.ВидРабот
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УСОERP_ВидыРабот.Пустаяссылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_СтатьиБДР.ПоВидамРабот, ЛОЖЬ)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.Пустаяссылка)
	|		ИНАЧЕ УСОERP_РеализацияСтроительныхРаботРаботы.Работа
	|	КОНЕЦ
	|
	|ИМЕЮЩИЕ
	|	СУММА(УСОERP_РеализацияСтроительныхРаботРаботы.СуммаСНДС) <> 0";
	
	Запрос.УстановитьПараметр("ДокументОснование", 		ДокументОснование);
	Запрос.УстановитьПараметр("КонецПериода", 			Новый Граница( КонецДня(ПараметрыЗаполнения.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Договор", 				ПараметрыЗаполнения.Договор);
	Запрос.УстановитьПараметр("ОбъектСтроительства", 	ПараметрыЗаполнения.ОбъектСтроительства);
	
	Результат = Запрос.Выполнить();
	
	ДанныеРаспределения = Результат.Выгрузить();
	
	ПараметрыЗаполнения.ДанныеРаспределения = ДанныеРаспределения;
	
КонецПроцедуры

