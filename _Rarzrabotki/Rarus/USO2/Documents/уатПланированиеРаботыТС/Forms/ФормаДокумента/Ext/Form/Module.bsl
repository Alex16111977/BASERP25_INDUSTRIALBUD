&НаКлиенте
Процедура УстановитьВидимостьДоступность()
	флПланированиеУслуг = (уатОбщегоНазначенияТиповые.ПолучитьЗначениеРеквизита(Объект.Сценарий, "Раздел") = ПредопределенноеЗначение("Перечисление.уатРазделыПланирования.ПредоставленныеУслуги"));
	
	Элементы.СоставПланаДоговор.Видимость = флПланированиеУслуг;
	Элементы.СоставПланаДоговор.Видимость = флПланированиеУслуг;
	Элементы.СоставПланаЦена.Видимость = флПланированиеУслуг;
	Элементы.СоставПланаСумма.Видимость = флПланированиеУслуг;
	Элементы.СоставПланаСтавкаНДС.Видимость = флПланированиеУслуг И Объект.УчитыватьНДС;
	Элементы.СоставПланаСуммаНДС.Видимость = флПланированиеУслуг И Объект.УчитыватьНДС;
	Элементы.СоставПланаВсего.Видимость = флПланированиеУслуг И Объект.УчитыватьНДС;
	Элементы.СоставПланаГруппаРассчитать.Видимость = флПланированиеУслуг;
	Элементы.СтраницыИтогов.Видимость = флПланированиеУслуг;
	
	Если флПланированиеУслуг Тогда
		Элементы.ГруппаСоставПлана.Заголовок = "Услуги";
		Если уатОбщегоНазначенияТиповые.ПолучитьЗначениеРеквизита(Объект.Сценарий, "ПланированиеПоГруппамУслуг") = Истина Тогда
			Элементы.СоставПланаНоменклатура.ВыборГруппИЭлементов = ГруппыИЭлементы.Группы;
		Иначе
			Элементы.СоставПланаНоменклатура.ВыборГруппИЭлементов = ГруппыИЭлементы.Элементы;
		КонецЕсли;
	Иначе
		Элементы.ГруппаСоставПлана.Заголовок = "Выработка";
		Элементы.СоставПланаНоменклатура.ВыборГруппИЭлементов = ГруппыИЭлементы.Элементы;
	КонецЕсли;
	
	ВывестиСуммовыеИтогиДокумента();
КонецПроцедуры

// Процедура для обновления надписи периода планирования в соответствии с периодичностью плана
//
&НаСервере
Процедура ОбновитьНадписьПериодПланирования()
	Если Объект.ДатаПланирования = '00010101' Тогда
		НадписьПериод = "<не указан>";
		Возврат;
	КонецЕсли;
	
	НачДата = Объект.ДатаПланирования;
	КонДата = Объект.ДатаПланирования;
	уатОбщегоНазначенияТиповые.уатВыровнятьПериод(НачДата, КонДата, Объект.Сценарий.Периодичность);
	НадписьПериод = Формат(НачДата, "ДФ = дд.ММ.гггг") + " - " + Формат(КонДата, "ДФ = дд.ММ.гггг");
КонецПроцедуры

// Устанавливает текст шапки в колонке "Детализация" ТС, Тип ТС или Модель ТС
&НаКлиенте
Процедура ФорматироватьКолонкуДетализации()
	ДетПланир = уатОбщегоНазначенияТиповые.ПолучитьЗначениеРеквизита(Объект.Сценарий, "ДетализацияПланирования");
	Если ДетПланир = ПредопределенноеЗначение("Перечисление.уатДетализацияПланирования.МодельТС") Тогда
		Элементы.СоставПланаДетализацияПланирования.Заголовок = НСтр("en='Vehicle model';ru='Модель ТС'");
		Элементы.СоставПланаДетализацияПланирования.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.уатМоделиТС");
	ИначеЕсли ДетПланир = ПредопределенноеЗначение("Перечисление.уатДетализацияПланирования.ТипТС") Тогда
		Элементы.СоставПланаДетализацияПланирования.Заголовок = НСтр("en='Vehicle type';ru='Тип ТС'");
		Элементы.СоставПланаДетализацияПланирования.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ТипыТранспортныхСредств");
	ИначеЕсли ДетПланир = ПредопределенноеЗначение("Перечисление.уатДетализацияПланирования.ТС") Тогда
		Элементы.СоставПланаДетализацияПланирования.Заголовок = НСтр("en='Vehicle';ru='ТС'");
		Элементы.СоставПланаДетализацияПланирования.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ТранспортныеСредства");
	Иначе
		Элементы.СоставПланаДетализацияПланирования.Заголовок = НСтр("en='Detail';ru='Детализация'");
		Элементы.СоставПланаДетализацияПланирования.ОграничениеТипа = Новый ОписаниеТипов("Неопределено");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуВсегоВстрокеТЧ(СтрокаТабличнойЧасти)
	СтрокаТабличнойЧасти.Всего = СтрокаТабличнойЧасти.Сумма + ?(Объект.СуммаВключаетНДС, 0, СтрокаТабличнойЧасти.СуммаНДС);
