	ТекущаяСтрока	=	Элементы.Работы.ТекущаяСтрока;
	ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение, ТекущаяСтрока);
	
	Если Окно <> Неопределено Тогда
		Окно.Активизировать();
	КонецЕсли;
	
КонецПроцедуры

