#КонецОбласти

#Область ПриИзмененииРеквизитовТЧнаСервере

&НаСервере
Процедура РаботыРаботаПриИзмененииНаСервере(ИдентификаторСтроки)
	
	ТекущаяСтрока = Объект.Работы.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	СписокРабот	=	Новый СписокЗначений;
	
	Если НовыйВариант Тогда
		
		СписокРабот.Добавить(ТекущаяСтрока.Работа.РаботаИсточник);
		
	Иначе
		
		СписокРабот.Добавить(ТекущаяСтрока.Работа);
		
	КонецЕсли; 	
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Организация", Объект.Организация);
	СтруктураПараметров.Вставить("ДатаСреза",	Объект.Дата);
	СтруктураПараметров.Вставить("ДатаНачала", Объект.ДатаНачалаПериода);
	СтруктураПараметров.Вставить("ДатаОкончания", Объект.ДатаОкончанияПериода);
	СтруктураПараметров.Вставить("Работа", СписокРабот);
	СтруктураПараметров.Вставить("ОбъектСтроительства", Объект.ОбъектСтроительства);
	СтруктураПараметров.Вставить("ДокументСсылка",Объект.Ссылка);
	
	Если Объект.ВидОперации	=	Перечисления.УСОERP_ВидыОперацийУчетаВыполненныхРабот.ВыполнениеСобственнымиСилами Тогда
		
		СтруктураПараметров.Вставить("Подразделение", Объект.Подразделение);
		СтруктураПараметров.Вставить("ВидПланирования", Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.НедельноСуточный);
		
		ДанныеПоРаботам = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьДанныеПоВыполнениюРабот(СтруктураПараметров);
		
		Если ДанныеПоРаботам.Количество() = 0 Тогда
			
			СтруктураПараметров.Вставить("ВидПланирования", Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Месячный);
			ДанныеПоРаботам = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьДанныеПоВыполнениюРабот(СтруктураПараметров);
			
		КонецЕсли;
		
		Если ДанныеПоРаботам.Количество() = 0 Тогда
			
			СтруктураПараметров.Вставить("ВидПланирования", Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный);
			ДанныеПоРаботам = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьДанныеПоВыполнениюРабот(СтруктураПараметров);
			
		КонецЕсли;
		
	Иначе
		
		СтруктураПараметров.Вставить("ИмяРегистра", ?(Не Объект.ОбъектСтроительства.ИспользоватьНедельноСуточныеПланы, "РегистрНакопления.УСОERP_ВыполнениеРаботСубподрядчиком", ""));
		СтруктураПараметров.Вставить("Партнер", Объект.Партнер);
		СтруктураПараметров.Вставить("Контрагент", Объект.Контрагент);
		
		ДанныеПоРаботам = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьДанныеПоВыполнениюРабот(СтруктураПараметров);
		
	КонецЕсли;
	
	СтруктураПараметров.ДатаОкончания = Дата(3999,1,1);
	
	ДанныеПоРаботамВсего = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьДанныеПоВыполнениюРабот(СтруктураПараметров);
	
	Если НовыйВариант Тогда
		
		ТекущаяСтрока.ОбъемВсего = ТекущаяСтрока.Работа.ОбъемРаботы;
		ТекущаяСтрока.ЕдиницаОбъема = ТекущаяСтрока.Работа.ЕдиницаОбъема;
		ТекущаяСтрока.Длительность = ТекущаяСтрока.Работа.Длительность;
		ТекущаяСтрока.ЕдиницаДлительности = ТекущаяСтрока.Работа.ЕдиницаДлительности;
		ТекущаяСтрока.ДатаНачала = ТекущаяСтрока.Работа.ДатаНачала;
		ТекущаяСтрока.ДатаОкончания = ТекущаяСтрока.Работа.ДатаОкончания;
		ТекущаяСтрока.ПроцентВыполненияНаНачалоПериода	= 0;
		ТекущаяСтрока.ОбъемНаНачалоПериода 				= 0;
		ТекущаяСтрока.ПорядокСортировки = ТекущаяСтрока.Работа.ПорядокСортировки;
		
		Если ДанныеПоРаботам.Количество() Тогда
			
			ТекущаяСтрока.ПроцентВыполненияНаНачалоПериода = ДанныеПоРаботам.Получить(0).ПроцентВыполненияНаНачалоПериода;
			ТекущаяСтрока.ОбъемНаНачалоПериода 			   = ДанныеПоРаботам.Получить(0).ОбъемНаНачалоПериода;			
			
		КонецЕсли;
		
		СтрокаРаботыВсего = ДанныеПоРаботамВсего.Найти(ТекущаяСтрока.Работа.РаботаИсточник);
		
		Если СтрокаРаботыВсего.ПроцентВыполненияНаНачалоПериода >= 100 Тогда
			
			ПутьКДанным = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Работы", ТекущаяСтрока.НомерСтроки, "ПроцентВыполненияНаНачалоПериода");

			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У работы "+СтрокаРаботыВсего.Работа.КодСДР+" "+СтрокаРаботыВсего.Работа+" процент выполнения больше 100",,,ПутьКДанным);
			
		КонецЕсли;  		
		
	Иначе  		
		
		Если ДанныеПоРаботам.Количество() > 0 Тогда
			
			Для каждого ЭлРабота Из ДанныеПоРаботам Цикл
				
				ТекущаяСтрока.ОбъемВсего 						= ЭлРабота.ОбъемВсего;
				ТекущаяСтрока.ЕдиницаОбъема 					= ЭлРабота.ЕдиницаОбъема;
				ТекущаяСтрока.Длительность 						= ЭлРабота.Длительность;
				ТекущаяСтрока.ЕдиницаДлительности 				= ЭлРабота.ЕдиницаДлительности;
				ТекущаяСтрока.ПроцентВыполненияНаНачалоПериода	= ЭлРабота.ПроцентВыполненияНаНачалоПериода;
				ТекущаяСтрока.ОбъемНаНачалоПериода 				= ЭлРабота.ОбъемНаНачалоПериода;
				ТекущаяСтрока.ДатаНачала 						= ЭлРабота.ДатаНачала;
				ТекущаяСтрока.ДатаОкончания 					= ЭлРабота.ДатаОкончания;
				
			КонецЦикла;
			
		Иначе
			
			ТекущаяСтрока.ОбъемВсего 						= 0;
			ТекущаяСтрока.ЕдиницаОбъема 					= Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
			ТекущаяСтрока.Длительность 						= 0;
			ТекущаяСтрока.ЕдиницаДлительности 				= Перечисления.УСОERP_ЕдиницыДлительности.ПустаяСсылка();
			ТекущаяСтрока.ПроцентВыполненияНаНачалоПериода	= 0;
			ТекущаяСтрока.ОбъемНаНачалоПериода 				= 0;
			ТекущаяСтрока.ДатаНачала 						= Дата("00010101");
			ТекущаяСтрока.ДатаОкончания 					= Дата("00010101");
			
		КонецЕсли;
		
	КонецЕсли;
	
	РассчитатьИтоговыеПоказателиВыполненияРабот(ЭтаФорма, ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура РаботыПроцентВыполненияПриИзмененииНаСервере(ИдентификаторСтроки)
	
	ТекущаяСтрока = Объект.Работы.НайтиПоИдентификатору(ИдентификаторСтроки);
	ТекущаяСтрока.Объем = ТекущаяСтрока.ОбъемВсего * ТекущаяСтрока.ПроцентВыполнения / 100;
	
	РассчитатьИтоговыеПоказателиВыполненияРабот(ЭтаФорма, ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура РаботыОбъемПриИзмененииНаСервере(ИдентификаторСтроки)
	
	ТекущаяСтрока = Объект.Работы.НайтиПоИдентификатору(ИдентификаторСтроки);
	ТекущаяСтрока.ПроцентВыполнения = ТекущаяСтрока.Объем * 100 / ТекущаяСтрока.ОбъемВсего;
	
	РассчитатьИтоговыеПоказателиВыполненияРабот(ЭтаФорма, ТекущаяСтрока);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандТЧ

&НаСервере
Процедура ЗаполнитьНаСервере(ВидПланирования, СписокРабот = Неопределено, ПолучитьСписок = Ложь)
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_УчетВыполненныхРабот_ЗаполнитьНаСервере(ЭтотОбъект, ВидПланирования, СписокРабот, ПолучитьСписок);
	
	Если НЕ НовыйВариант Тогда
	УСОERP_ОбработкаТабличныхЧастей.СортироватьТаблицу(Объект.Работы);
	КонецЕсли;
	
	РассчитатьИтоговыеПоказателиВыполненияРабот(ЭтаФорма);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзПланаГрафика(Команда)
	
	ВидПланирования = ПредопределенноеЗначение("Перечисление.УСОERP_ВидыПланированияСтроительныхРабот.Календарный");
	Если Не ЗначениеЗаполнено(Объект.Подразделение) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено подразделение.", Объект.Ссылка, "Подразделение", "Объект");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНаСервере(ВидПланирования); 	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзМесячныхПланов(Команда)
	
	ВидПланирования = ПредопределенноеЗначение("Перечисление.УСОERP_ВидыПланированияСтроительныхРабот.Месячный");
	ЗаполнитьНаСервере(ВидПланирования);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзНедельноСуточныхПланов(Команда)
	
	ВидПланирования = ПредопределенноеЗначение("Перечисление.УСОERP_ВидыПланированияСтроительныхРабот.НедельноСуточный");
	ЗаполнитьНаСервере(ВидПланирования);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоСубподрядчикуНаСервере(СписокРабот = Неопределено, ПолучитьСписок = Ложь)
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_УчетВыполненныхРабот_ЗаполнитьПоСубподрядчикуНаСервере(ЭтотОбъект, СписокРабот, ПолучитьСписок);
	
	Если НЕ НовыйВариант Тогда
		УСОERP_ОбработкаТабличныхЧастей.СортироватьТаблицу(Объект.Работы);
	КонецЕсли;
	
	РассчитатьИтоговыеПоказателиВыполненияРабот(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоВыполнениюОтСубподрядчика(Команда)
	
	ЗаполнитьПоСубподрядчикуНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область Прочее

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УстановитьВидимостьЭлементовПоВидуОперацииСервер();
	
	РассчитатьИтоговыеПоказателиВыполненияРабот(ЭтаФорма);
	
	//Элементы.ГруппаКомментарий.Картинка = ОбщегоНазначения.ПолучитьКартинкуКомментария(Объект.Комментарий);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовПоВидуОперацииСервер()
	
	Перем МассивВсехРеквизитов;
	Перем МассивРеквизитовОперации;
	
	Документы.УСОERP_УчетВыполненныхРабот.ЗаполнитьИменаРеквизитовПоОперации(
		Объект.ВидОперации,
		МассивВсехРеквизитов,
		МассивРеквизитовОперации);
		
	ДенежныеСредстваСервер.УстановитьВидимостьЭлементовПоМассиву(
		Элементы,
		МассивВсехРеквизитов,
		МассивРеквизитовОперации);
		
	УстановитьВидимостьКомандТЧ();
	ОчиститьРеквизитыШапки();
		
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьКомандТЧ()

	Элементы.ЗаполнитьИзПГ.Видимость						=	Объект.ВидОперации	=	Перечисления.УСОERP_ВидыОперацийУчетаВыполненныхРабот.ВыполнениеСобственнымиСилами;
	//Элементы.ЗаполнитьИзМесячныхПланов.Видимость			=	(Объект.ВидОперации	= Перечисления.УСОERP_ВидыОперацийУчетаВыполненныхРабот.ВыполнениеСобственнымиСилами
	//															И Объект.ОбъектСтроительства.ИспользоватьМесячныеПланы);
	//Элементы.ЗаполнитьИзНедельноСуточныхПланов.Видимость	=	(Объект.ВидОперации = Перечисления.УСОERP_ВидыОперацийУчетаВыполненныхРабот.ВыполнениеСобственнымиСилами
																//И Объект.ОбъектСтроительства.ИспользоватьНедельноСуточныеПланы);
	Элементы.ЗаполнитьПоВыполнениюОтСубподрядчика.Видимость	=	Объект.ВидОперации = Перечисления.УСОERP_ВидыОперацийУчетаВыполненныхРабот.ВыполнениеСиламиСубподрядчика;
	//Элементы.ЗаполнитьПоПлануСубподрядныхРабот.Видимость	=	(Объект.ВидОперации = Перечисления.УСОERP_ВидыОперацийУчетаВыполненныхРабот.ВыполнениеСиламиСубподрядчика
	//															И Объект.ОбъектСтроительства.ИспользоватьНедельноСуточныеПланы);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьРеквизитыШапки()

	Если Объект.ВидОперации = Перечисления.УСОERP_ВидыОперацийУчетаВыполненныхРабот.ВыполнениеСобственнымиСилами Тогда
		Объект.Партнер			=	Справочники.Партнеры.ПустаяСсылка();
		Объект.Контрагент		=	Справочники.Контрагенты.ПустаяСсылка();
	Иначе
		Объект.Подразделение	=	Справочники.СтруктураПредприятия.ПустаяСсылка();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыборПериода(Команда)
	
	//ОбщегоНазначенияУТКлиент.РедактироватьПериод(Объект, 
	//	Новый Структура("ДатаНачала, ДатаОкончания", "ДатаНачала", "ДатаОкончания"));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("РезультатВыбораПериода", ЭтаФорма);
	
	ПараметрыДат = Новый Структура("НачалоПериода,КонецПериода",?(ЗначениеЗаполнено(Объект.ДатаНачалаПериода),Объект.ДатаНачалаПериода,НачалоДня(Объект.Дата)),?(ЗначениеЗаполнено(Объект.ДатаОкончанияПериода),Объект.ДатаОкончанияПериода,КонецДня(Объект.Дата)));
	
	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериода",ПараметрыДат,,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатВыбораПериода(Результат, ДополнительныеПараметры) Экспорт

	Если Объект.Работы.Количество() > 0 Тогда
		ОчиститьТабличнуюЧасть(Результат, "ВыборПериода");
	ИначеЕсли Результат <> Неопределено Тогда
		Объект.ДатаНачалаПериода = Результат.НачалоПериода;
		Объект.ДатаОкончанияПериода = Результат.КонецПериода; 
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодчиненныеСвойстваПоСтатистике(ИмяРеквизитаРодителя)
	
	ЗаполнениеСвойствПоСтатистикеСервер.ЗаполнитьПодчиненныеСвойства(Объект, ИмяРеквизитаРодителя);
	
КонецПроцедуры

&НаСервере
Процедура ПодборРаботНаСервере(СписокРабот = Неопределено)
	
	Если СписокРабот <> Неопределено Тогда
		Если Объект.ВидОперации	=	Перечисления.УСОERP_ВидыОперацийУчетаВыполненныхРабот.ВыполнениеСобственнымиСилами Тогда
			ЗаполнитьНаСервере(Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный, СписокРабот, Истина);
		ИначеЕсли Объект.ВидОперации	=	Перечисления.УСОERP_ВидыОперацийУчетаВыполненныхРабот.ВыполнениеСиламиСубподрядчика Тогда
			ЗаполнитьПоСубподрядчикуНаСервере(СписокРабот, Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьДлительностьНаСервере(ИдентификаторСтроки)
	
	ТекущиеДанные = Объект.Работы.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ЗначениеЗаполнено(ТекущиеДанные.ДатаНачала)
		И ЗначениеЗаполнено(ТекущиеДанные.ДатаОкончания) Тогда
		
		
		ГрафикРаботы = Неопределено;
		Если ЗначениеЗаполнено(ТекущиеДанные.Работа) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УСОERP_СтроительныеРаботы.ГрафикРаботы
			|ИЗ
			|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
			|ГДЕ
			|	УСОERP_СтроительныеРаботы.Ссылка = &Ссылка";
			Запрос.УстановитьПараметр("Ссылка", ТекущиеДанные.Работа);
			результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			ГрафикРаботы = Выборка.ГрафикРаботы;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ГрафикРаботы) Тогда
			ГрафикРаботы = Объект.ОбъектСтроительства.ГрафикРаботы;
		КонецЕсли;
		
		ТекущиеДанные.ДатаНачала = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПервоеРабочееВремяДня(ГрафикРаботы, ТекущиеДанные.ДатаНачала);
		ТекущиеДанные.ДатаОкончания = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПоследнееРабочееВремяДня(ГрафикРаботы, ТекущиеДанные.ДатаОкончания);
		
		СтруктураДлительности = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьДлительностьПериода(ГрафикРаботы, ТекущиеДанные.ДатаНачала, ТекущиеДанные.ДатаОкончания,);
		
		Если ТекущиеДанные.ЕдиницаДлительности = Перечисления.ЕдиницыИзмеренияВремени.Час Тогда
			ТекущиеДанные.Длительность = СтруктураДлительности.ДлительностьЧас; 
		Иначе
			ТекущиеДанные.Длительность = СтруктураДлительности.ДлительностьДень;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьДатуОкончанияНаСервере(ИдентификаторСтроки)
	
	ТекущиеДанные = Объект.Работы.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ЗначениеЗаполнено(ТекущиеДанные.Длительность)
		И ЗначениеЗаполнено(ТекущиеДанные.ДатаНачала) Тогда
		
		ГрафикРаботы = Неопределено;
		Если ЗначениеЗаполнено(ТекущиеДанные.Работа) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УСОERP_СтроительныеРаботы.ГрафикРаботы
			|ИЗ
			|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
			|ГДЕ
			|	УСОERP_СтроительныеРаботы.Ссылка = &Ссылка";
			Запрос.УстановитьПараметр("Ссылка", ТекущиеДанные.Работа);
			результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			ГрафикРаботы = Выборка.ГрафикРаботы;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ГрафикРаботы) Тогда
			ГрафикРаботы = Объект.ОбъектСтроительства.ГрафикРаботы;
		КонецЕсли;
		
		СтроительнаяРаботаСтруктура = Новый Структура;
		//СтроительнаяРаботаСтруктура.Вставить("Владелец", 		ТекущиеДанные.Владелец);
		СтроительнаяРаботаСтруктура.Вставить("ГрафикРаботы", 	ГрафикРаботы);
		СтроительнаяРаботаСтруктура.Вставить("Ссылка", 			ТекущиеДанные.Работа);
		
		ТекущиеДанные.ДатаОкончания	= УСОERP_УправлениеСтроительнымПроизводством.РассчитатьОкончаниеПериода(СтроительнаяРаботаСтруктура, 
		ТекущиеДанные.ДатаНачала, 
		ТекущиеДанные.Длительность, 
		ТекущиеДанные.ЕдиницаДлительности);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область РаботаСБуферомОбмена

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьИтоговыеПоказателиВыполненияРабот(Форма, ТекущаяСтрока = Неопределено)

	Если ТекущаяСтрока = Неопределено Тогда
		КоллекцияРаботы = Форма.Объект.Работы;
		Для каждого ЭлКоллекции Из КоллекцияРаботы Цикл
			ЭлКоллекции.ОбъемВыполнено = ЭлКоллекции.Объем + ЭлКоллекции.ОбъемНаНачалоПериода;
			ЭлКоллекции.ЭтоСуммарнаяРабота	=	УСОERP_УправлениеСтроительнымПроизводством.ЭтоСуммарнаяРабота(ЭлКоллекции.Работа);
		КонецЦикла;
	Иначе
		ТекущаяСтрока.ОбъемВыполнено		=	ТекущаяСтрока.Объем + ТекущаяСтрока.ОбъемНаНачалоПериода;
		ТекущаяСтрока.ЭтоСуммарнаяРабота	=	УСОERP_УправлениеСтроительнымПроизводством.ЭтоСуммарнаяРабота(ТекущаяСтрока.Работа);
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ДокументУтвержденияПриИзмененииНаСервере()
	НовыйВариант = Объект.ДокументУтверждения.СценарийПланирования.НовыйВариант = Истина;
	Объект.НаправлениеДеятельности = Объект.ДокументУтверждения.НаправлениеДеятельности;
	Объект.Работы.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура ДокументУтвержденияПриИзменении(Элемент)
	ДокументУтвержденияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДокументУтвержденияОчистка(Элемент, СтандартнаяОбработка)
	ДокументУтвержденияПриИзмененииНаСервере();
