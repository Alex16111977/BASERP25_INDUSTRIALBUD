&НаКлиенте
Процедура ДатаНачалаПериодаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)  	
	
	Если ВыбранноеЗначение > Объект.ДатаОкончанияПериода Тогда
		ВыбранноеЗначение = Объект.ДатаОкончанияПериода;
		Объект.ДатаНачалаПериода = ВыбранноеЗначение;
	КонецЕсли;
	
	Если Объект.Работы.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
		ОчиститьТабличнуюЧасть(ВыбранноеЗначение, Элемент.Имя);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПериодаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение < Объект.ДатаНачалаПериода Тогда
		ВыбранноеЗначение = Объект.ДатаНачалаПериода;
		Объект.ДатаОкончанияПериода = ВыбранноеЗначение;
	КонецЕсли;
	
	
	Если Объект.Работы.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
		ОчиститьТабличнуюЧасть(ВыбранноеЗначение, Элемент.Имя);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТабличнуюЧасть(ВыбранноеЗначение, ИмяЭлемента)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Значение", ВыбранноеЗначение);
	ДопПараметры.Вставить("Имя", ИмяЭлемента);
	
	Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеЗакрытияВопроса", ЭтаФорма, ДопПараметры);
	ПоказатьВопрос(Оповещение, "Табличная часть ""Работы"" будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеЗакрытияВопроса(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	Иначе
		Объект.Работы.Очистить();
		Если ТипЗнч(ДопПараметры.Значение) = Тип("СправочникСсылка.СМ_ОбъектыСтроительства") Тогда
			Объект.ОбъектСтроительства = ДопПараметры.Значение;
		ИначеЕсли ТипЗнч(ДопПараметры.Значение) = Тип("СправочникСсылка.Контрагенты") Тогда
			Объект.Контрагент = ДопПараметры.Значение;
		ИначеЕсли ТипЗнч(ДопПараметры.Значение) = Тип("Дата") Тогда
			Если ДопПараметры.Имя = "ДатаНачалаПериода" Тогда
				Объект.ДатаНачалаПериода = ДопПараметры.Значение;
			Иначе
				Объект.ДатаОкончанияПериода = ДопПараметры.Значение;
			КонецЕсли;
		ИначеЕсли ТипЗнч(ДопПараметры.Значение) = Тип("Структура") Тогда
			Объект.ДатаНачалаПериода = ДопПараметры.Значение.НачалоПериода;
			Объект.ДатаОкончанияПериода = ДопПараметры.Значение.КонецПериода;
		ИначеЕсли ТипЗнч(ДопПараметры.Значение) = Тип("ПеречислениеСсылка.УСОERP_ВидыОперацийУчетаВыполненныхРабот") Тогда
			Объект.ВидОперации	=	ДопПараметры.Значение;
			ПриИзмененииВидаОперацииСервер();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

