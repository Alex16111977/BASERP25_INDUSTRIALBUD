&НаСервере
Процедура ДополнительныеОтчетыИОбработкиВыполнитьНазначаемуюКомандуНаСервере(ИмяЭлемента, РезультатВыполнения)
	
	ДополнительныеОтчетыИОбработки.ВыполнитьНазначаемуюКомандуНаСервере(ЭтаФорма, ИмяЭлемента, РезультатВыполнения);
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

&НаСервере
Процедура ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение, ИдентификаторСтроки = Неопределено)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда 
		
		Для Каждого Элем из ВыбранноеЗначение Цикл
			ЗаполнитьТЧВыбраннымиРаботами(Элем, ИдентификаторСтроки);
		КонецЦикла;
		
		Если НовыйВариант Тогда			
			Объект.Работы.Сортировать("ПорядокСортировки");
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.УСОERP_СтроительныеРаботы") Тогда
		
		ЗаполнитьТЧВыбраннымиРаботами(ВыбранноеЗначение, ИдентификаторСтроки);
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбор этапа в данном случае не предусмотрен! Необходимо выбрать конкретную работу.'")
		                                                 + Символы.ПС + ОписаниеОшибки());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧВыбраннымиРаботами(ВыбранноеЗначение, ИдентификаторСтроки = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;  	
	
	ЭтоСуммарнаяРабота = УСОERP_УправлениеСтроительнымПроизводством.ЭтоСуммарнаяРабота(ВыбранноеЗначение);
	
	Если Не ЭтоСуммарнаяРабота Тогда
		
		СтрокиРабот = Объект.Работы.НайтиСтроки(Новый Структура("Работа", ВыбранноеЗначение));
		
		Если СтрокиРабот.Количество() = 0 Тогда 
			
			ТекущаяСтрока	=	Объект.Работы.Добавить();
			ТекущаяСтрока.Работа = ВыбранноеЗначение;
			РаботыРаботаПриИзмененииНаСервере(ТекущаяСтрока.ПолучитьИдентификатор());
			
		КонецЕсли;
		
	Иначе
		
		//Если ИдентификаторСтроки = Неопределено Тогда
		// добавление этапа
		Если НовыйВариант Тогда
			
			ПодчиненныеРаботы = ПолучитьПодчиненныеРаботы(ВыбранноеЗначение);				
			
			//Иначе
			//	
			//ТекущаяСтрока = Объект.Работы.Добавить();
			//ТекущаяСтрока.Работа = ВыбранноеЗначение;
			//РаботыРаботаПриИзмененииНаСервере(ТекущаяСтрока.ПолучитьИдентификатор());
			//// добавление подчиненных работ
			//ПодчиненныеРаботы = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПодчиненныеРаботы(ВыбранноеЗначение, Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный, Дата("00010101"));
			
			//КонецЕсли;
			
			Для каждого ЭлПодчиненныеРаботы Из ПодчиненныеРаботы Цикл
				
				СтрокиРабот = Объект.Работы.НайтиСтроки(Новый Структура("Работа", ЭлПодчиненныеРаботы.Работа));
				
				Если СтрокиРабот.Количество() = 0 Тогда 
					
					ТекущаяСтрока = Объект.Работы.Добавить();
					ТекущаяСтрока.Работа = ЭлПодчиненныеРаботы.Работа;
					РаботыРаботаПриИзмененииНаСервере(ТекущаяСтрока.ПолучитьИдентификатор());
					
				КонецЕсли;
				
			КонецЦикла;
			
			Объект.Работы.Сортировать("ПорядокСортировки");
			
		Иначе	
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбор этапа в данном случае не предусмотрен! Необходимо выбрать конкретную работу.'")
			+ Символы.ПС + ОписаниеОшибки());
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере 
Функция   ПолучитьПодчиненныеРаботы(ВыбранноеЗначение)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Работа",ВыбранноеЗначение);
	Запрос.УстановитьПараметр("МассивРабот",Объект.Работы.Выгрузить().ВыгрузитьКолонку("Работа"));
	Запрос.УстановитьПараметр("Владелец",Объект.ДокументУтверждения.КопияСценария);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_СтроительныеРаботы.Ссылка КАК Работа
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	УСОERP_СтроительныеРаботы.Родитель В ИЕРАРХИИ(&Работа)
	|	И НЕ УСОERP_СтроительныеРаботы.СуммарнаяРабота
	|	И НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
	|	И НЕ УСОERP_СтроительныеРаботы.Ссылка В (&МассивРабот)
	|	И УСОERP_СтроительныеРаботы.Владелец = &Владелец
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_СтроительныеРаботы.ПорядокСортировки";	
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции  	

#КонецОбласти

