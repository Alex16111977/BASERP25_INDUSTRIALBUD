#Область Прочее

// Заполняет таблицу реквизитов, зависимых от хозяйственной операции
//
// Параметры:
//	ХозяйственнаяОперация - ПеречислениеСсылка.ХозяйственныеОперации - хозяйственная операция соглашения
//	МассивВсехРеквизитов - Массив - реквизиты, которые не зависят от хозяйственной операции
//	МассивРеквизитовОперации - Массив - реквизиты, которые зависят от хозяйственной операции
//
Процедура ЗаполнитьИменаРеквизитовПоОперации(ВидОперации, МассивВсехРеквизитов, МассивРеквизитовОперации) Экспорт
	
	МассивВсехРеквизитов = Новый Массив;
	МассивВсехРеквизитов.Добавить("Партнер");
	МассивВсехРеквизитов.Добавить("Контрагент");
	МассивВсехРеквизитов.Добавить("Подразделение");
	
	МассивРеквизитовОперации = Новый Массив;
	Если ВидОперации = Перечисления.УСОERP_ВидыОперацийУчетаВыполненныхРабот.ВыполнениеСобственнымиСилами Тогда
		МассивРеквизитовОперации.Добавить("Подразделение");
	ИначеЕсли ВидОперации = Перечисления.УСОERP_ВидыОперацийУчетаВыполненныхРабот.ВыполнениеСиламиСубподрядчика Тогда
		МассивРеквизитовОперации.Добавить("Партнер");
		МассивРеквизитовОперации.Добавить("Контрагент");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка,  ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстыЗапроса.Добавить(ТекстЗапросаТаблицаРаботы(),		"");
	ТекстыЗапроса.Добавить(ТекстЗапросаТаблицаВыполнение(),	"ТаблицаВыполнение");
	ТекстыЗапроса.Добавить(ТекстЗапросаТаблицаВыполнениеПринятие(),	"ТаблицаВыполнениеПринятие");


	Запрос.Текст = "";
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		Запрос.Текст = Запрос.Текст + ТекстЗапроса.Значение;
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////
	// Выполним запрос
	
	Результат = Запрос.ВыполнитьПакет();
	
	////////////////////////////////////////////////////////////////////////////
	// Поместим результаты запроса в дополнительные свойства
	
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		ИмяТаблицы = ТекстЗапроса.Представление;
		Если Не ПустаяСтрока(ИмяТаблицы) Тогда
			Индекс = ТекстыЗапроса.Индекс(ТекстЗапроса);
			ДополнительныеСвойства.ТаблицыДляДвижений.Вставить(ИмяТаблицы, Результат[Индекс].Выгрузить());
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	//Запрос.УстановитьПараметр("Работы", Работы);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_УчетВыполненныхРабот.Ссылка КАК Ссылка,
	|	УСОERP_УчетВыполненныхРабот.Дата КАК Период,
	|	УСОERP_УчетВыполненныхРабот.Организация КАК Организация,
	|	УСОERP_УчетВыполненныхРабот.ОбъектСтроительства КАК ОбъектСтроительства,
	|	УСОERP_УчетВыполненныхРабот.Партнер КАК Поставщик,
	|	ВЫБОР
	|		КОГДА УСОERP_УчетВыполненныхРабот.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийУчетаВыполненныхРабот.ВыполнениеСиламиСубподрядчика)
	|			ТОГДА УСОERP_УчетВыполненныхРабот.Контрагент
	|		ИНАЧЕ УСОERP_УчетВыполненныхРабот.Подразделение
	|	КОНЕЦ КАК Исполнитель,
	|	УСОERP_УчетВыполненныхРабот.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден) КАК Утвержден
	|ИЗ
	|	Документ.УСОERP_УчетВыполненныхРабот КАК УСОERP_УчетВыполненныхРабот
	|ГДЕ
	|	УСОERP_УчетВыполненныхРабот.Ссылка = &Ссылка";
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	//
	Запрос.УстановитьПараметр("ОбъектСтроительства",	Реквизиты.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Период",      			Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация", 			Реквизиты.Организация);
	Запрос.УстановитьПараметр("Поставщик",	 			Реквизиты.Поставщик);
	Запрос.УстановитьПараметр("Исполнитель", 			Реквизиты.Исполнитель);
	Запрос.УстановитьПараметр("Утвержден",              Реквизиты.Утвержден);
	
КонецПроцедуры

Функция ТекстЗапросаТаблицаРаботы()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	               |	УСОERP_УчетВыполненныхРабот.Работа,
				   |	УСОERP_УчетВыполненныхРабот.Объем,
	               |	УСОERP_УчетВыполненныхРабот.ЕдиницаОбъема,
	               |	УСОERP_УчетВыполненныхРабот.ДатаНачала,
	               |	УСОERP_УчетВыполненныхРабот.ДатаОкончания,
	               |	УСОERP_УчетВыполненныхРабот.Объем * УСОERP_УчетВыполненныхРабот.Длительность / УСОERP_УчетВыполненныхРабот.ОбъемВсего КАК Длительность,
	               |	УСОERP_УчетВыполненныхРабот.ЕдиницаДлительности,
	               |	УСОERP_УчетВыполненныхРабот.НомерСтроки
	               |ПОМЕСТИТЬ ВтТаблицаРаботы
	               |ИЗ
	               |	Документ.УСОERP_УчетВыполненныхРабот.Работы КАК УСОERP_УчетВыполненныхРабот
	               |ГДЕ
	               |	УСОERP_УчетВыполненныхРабот.Ссылка = &Ссылка
	               |	И УСОERP_УчетВыполненныхРабот.Работа.СуммарнаяРабота = ЛОЖЬ
				   |;
				   |////////////////////////////////////////////////////////////////////////////////
				   |";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаВыполнение()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&Организация КАК Организация,
	|	&ОбъектСтроительства КАК ОбъектСтроительства,
	|	&Поставщик КАК Поставщик,
	|	&Исполнитель КАК Исполнитель,
	|	ТаблицаРаботы.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР КОГДА ТаблицаРаботы.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка) ТОГДА ТаблицаРаботы.Работа ИНАЧЕ ТаблицаРаботы.Работа.РаботаИсточник КОНЕЦ КАК Работа, 
	|	ТаблицаРаботы.Объем КАК Объем,
	|	ТаблицаРаботы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТаблицаРаботы.ДатаНачала КАК ДатаНачала,
	|	ТаблицаРаботы.ДатаОкончания КАК ДатаОкончания,
	|	ТаблицаРаботы.Длительность КАК Длительность,
	|	ТаблицаРаботы.ЕдиницаДлительности КАК ЕдиницаДлительности
	|ИЗ
	|	ВтТаблицаРаботы КАК ТаблицаРаботы  ГДЕ &Утвержден
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаВыполнениеПринятие()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&Организация КАК Организация,
	|	&ОбъектСтроительства КАК ОбъектСтроительства,
	|	ТаблицаРаботы.НомерСтроки КАК НомерСтроки,
	//|	ТаблицаРаботы.Работа КАК Работа,
	|	ВЫБОР КОГДА ТаблицаРаботы.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка) ТОГДА ТаблицаРаботы.Работа ИНАЧЕ ТаблицаРаботы.Работа.РаботаИсточник КОНЕЦ КАК Работа, 
	|	ТаблицаРаботы.Объем КАК ОбъемВыполнено,
	|	ТаблицаРаботы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТаблицаРаботы.ДатаНачала КАК ДатаНачала,
	|	ТаблицаРаботы.ДатаОкончания КАК ДатаОкончания
	|ИЗ
	|	ВтТаблицаРаботы КАК ТаблицаРаботы
	|ГДЕ
	|	ТаблицаРаботы.Объем <> 0 И &Утвержден
	|
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

