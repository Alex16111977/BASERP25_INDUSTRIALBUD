
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка  Тогда
		Возврат;
	КонецЕсли;
	
	Если Ссылка.Пустая() И Не ДополнительныеСвойства.Свойство("Смета3") Тогда
		// Это совсем крайний вариант, вообще, мы ожидаем, что НомерВДереве всегда заполняется.
		Если Не ЗначениеЗаполнено(ИДПозицииВладельца) Тогда
			НомерВДеревеНовый = СМ_СметныйСоставВызовСервера.ПолучитьМаксимальныйНомерВДереве(ИДСметы, ИДРодителя) + 0.01;
			СМ_СметаВызовСервера.УстановитьНомерДокумента(ЭтотОбъект,,, НомерВДеревеНовый, , "СМ_ПозицияЛокальнойСметы");
		Иначе
			НомерВДеревеНовый = СМ_СметныйСоставВызовСервера.ПолучитьМаксимальныйНомерВДереве(ИДСметы, ИДРодителя,ИДПозицииВладельца) + 0.01;
			СМ_СметаВызовСервера.УстановитьНомерДокумента(ЭтотОбъект,,, НомерВДеревеНовый, , "СМ_ПозицияЛокальнойСметы");
		КонецЕсли;
	ИначеЕсли ДополнительныеСвойства.Свойство("НомерВДереве") Тогда
		СМ_СметаВызовСервера.УстановитьНомерДокумента(ЭтотОбъект,ДополнительныеСвойства.ПорНомер,ДополнительныеСвойства.НомерВПределахСметы,ДополнительныеСвойства.НомерВДереве, , "СМ_ПозицияЛокальнойСметы");
	КонецЕсли;
	
	Если не ЭтотОбъект.Ссылка.Пустая() И ПолучитьФункциональнуюОпцию("СМ_MSP_ИспользоватьИнтеграциюMSP") Тогда
		
		Запись=РегистрыСведений.СМ_MSP_СтатусыВыгрузкиДокументов.СоздатьМенеджерЗаписи();
		Запись.Документ=ЭтотОбъект.Ссылка;
		Запись.Прочитать();
		Если Запись.Статус=Перечисления.СМ_MSP_СтатусыВыгрузкиДокументов.Выгружен и ЭтотОбъект.ОбъемРабот<> ЭтотОбъект.Ссылка.ОбъемРабот Тогда
			 Запись.Документ=ЭтотОбъект.Ссылка;
			 Запись.Статус=Перечисления.СМ_MSP_СтатусыВыгрузкиДокументов.ИзмененПослеВыгрузки;
			 Запись.Записать();
	    КонецЕсли;
		 
	КонецЕсли;
	

КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	//СМ_СметаВызовСервера.УстановитьНомерДокумента(ЭтотОбъект, ПорНомер, НомерВПределахСметы, НомерВДереве, , "СМ_ПозицияЛокальнойСметы");
	
КонецПроцедуры

#КонецОбласти



