// процедура выполняет расчет сметы 
Процедура ВыполнитьРасчет(Объект, Акт = Неопределено) Экспорт
	
	ПромежуточнаяЗапись = Ложь;
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураПараметровОтбораРС = СМ_СметаВызовСервера.ПолучитьСтруктуруДанныхДляОтборовРегистра(Объект, Акт, "СМ_ПозицияЛокальнойСметы");
	
	Если НЕ ЗначениеЗаполнено(СтруктураПараметровОтбораРС.СсылкаНаСмету) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Нарушена структура данных!'"));
		Возврат;       		
	КонецЕсли;
	
	СтруктураДанныхРасчета = ИнициироватьТаблицыРасчета();
		
	РасчетСтоимостиРесурсов(Объект, СтруктураДанныхРасчета, Акт, СтруктураПараметровОтбораРС, ПромежуточнаяЗапись);
	                                                          	
	// Расчет исходных данных для применения поправок
	Если СтруктураПараметровОтбораРС.СсылкаНаСмету.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда  
		СМ_СметаРасчетВызовСервера.РасчитатьСоставляющиеЗатратПриРесурсномРасчете(Объект, СтруктураДанныхРасчета, СтруктураПараметровОтбораРС.СсылкаНаСмету, Акт, СтруктураПараметровОтбораРС, ПромежуточнаяЗапись);  
	КонецЕсли;

	// Расчет поправок и числовых параметров
	СМ_СметаРасчетВызовСервера.РасчитатьПоправки(Объект, СтруктураДанныхРасчета, СтруктураПараметровОтбораРС.СсылкаНаСмету, Акт, СтруктураПараметровОтбораРС, ПромежуточнаяЗапись);
	
	// Эрикос.zbikt 09.06.2014
	Если СтруктураПараметровОтбораРС.СсылкаНаСмету.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда  
		РесурсныйРасчет = Истина;
	Иначе
		РесурсныйРасчет = Ложь;
	КонецЕсли;

	СМ_СметаРасчетВызовСервера.РасчитатьЧП(Объект, СтруктураДанныхРасчета, СтруктураПараметровОтбораРС.СсылкаНаСмету, Объект.ОбъемРабот, РесурсныйРасчет,, СтруктураПараметровОтбораРС.СсылкаНаСмету.ПромежуточноеОкругление, Акт, СтруктураПараметровОтбораРС, ПромежуточнаяЗапись);

	// Расчет коэффициентов (индексов) пересчета
	Если СтруктураПараметровОтбораРС.СсылкаНаСмету.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный Тогда  
		СМ_СметаРасчетВызовСервера.РасчитатьКоэфициенты(Объект, СтруктураДанныхРасчета, СтруктураПараметровОтбораРС.СсылкаНаСмету, Акт, СтруктураПараметровОтбораРС, ПромежуточнаяЗапись);
	КонецЕсли;
	
	// Расчет нормы расходов и сметной прибыли
	РассчитатьНРиСП(Объект, СтруктураДанныхРасчета, СтруктураПараметровОтбораРС.СсылкаНаСмету, Акт, СтруктураПараметровОтбораРС, ПромежуточнаяЗапись);
	
	// Надо поместить результат до расчета средней стоиомсти
	Если Не ПромежуточнаяЗапись Тогда
		ПоместитьРезультатыРасчета(СтруктураПараметровОтбораРС, СтруктураДанныхРасчета);	
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("СМ_ИспользоватьРасчетСреднейСтоимости") Тогда
		СМ_СметаРасчетВызовСервера.ОтразитьСтоимостьПозицииВРегистреУСП(Объект, СтруктураДанныхРасчета, СтруктураПараметровОтбораРС.СсылкаНаСмету, Акт, СтруктураПараметровОтбораРС, ПромежуточнаяЗапись);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

// Основная процедура расчета позиции, выполняет пересчет позиции.
//
// Параметры:
//   ДокОбъект - ДокументОбъект.СМ_ПозицияЛокальнойСметы или ДокументСсылка.СМ_ПозицияЛокальнойСметы.
//   СметаУжеРассчитана - Булево
//		- Истина - смета уже рассчитана и ее пересчет не требуется.
//		- Ложь - требуется пересчет вышестоящей сметы.
//   Акт - ДокументОбъект.СМ_АктВыполненныхРабот или ДокументСсылка.СМ_АктВыполненныхРабот, 
//      задается если происходит пересчет позиции акта.
Процедура Перерасчет(ДокОбъект, СметаУжеРассчитана = Ложь, Акт = Неопределено) Экспорт
	
	// Перерасчет позциии, если стоит флаг расчета
	Если ДокОбъект.Расчет Тогда
		ВыполнитьРасчет(ДокОбъект, Акт);
	Иначе
		СМ_СметаВызовСервера.УдалитьДвижения(ДокОбъект.Ссылка, Акт);
	КонецЕсли;	
	
	Если Не СметаУжеРассчитана Тогда
		// Перересчет родителя позиции (раздела)
		Если ЗначениеЗаполнено(ДокОбъект.ИДРодителя) Тогда
			РодительОбъект = ДокОбъект.ИДРодителя.ПолучитьОбъект();
			Если (ТипЗнч(РодительОбъект.Ссылка) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")) Тогда
				Документы.СМ_РазделЛокальнойСметы.Перерасчет(РодительОбъект, Истина, Ложь, Акт);	
			ИначеЕсли Акт = Неопределено Тогда
				Документы.СМ_ЛокальнаяСмета.Перерасчет(РодительОбъект, Истина);
			Иначе
				Документы.СМ_АктВыполненныхРабот.Перерасчет(РодительОбъект, Истина);
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры

// процедура выполняет расчет стоимости ресурсов
Процедура РасчетСтоимостиРесурсов(Позиция, СтруктураДанныхРасчета, Акт = Неопределено, СтруктураПараметровОтбораРС = Неопределено, ИспользоватьРС = Истина)
	
	Если СтруктураПараметровОтбораРС = Неопределено Тогда
		СтруктураПараметровОтбораРС = СМ_СметаВызовСервера.ПолучитьСтруктуруДанныхДляОтборовРегистра(Позиция, Акт, "СМ_ПозицияЛокальнойСметы");
	КонецЕсли;
	
	Если ИспользоватьРС Тогда
		
		// очищаем существующие записи с расчетами стоимости ресурсов
		НаборЗаписей = РегистрыСведений.СМ_СтоимостьРесурсовПозиции.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.Позиция.Установить(СтруктураПараметровОтбораРС.СсылкаНаПозицию);
		НаборЗаписей.Отбор.Смета.Установить(СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
		НаборЗаписей.Прочитать();
	    СтруктураДанныхРасчета.СМ_СтоимостьРесурсовПозиции = НаборЗаписей.Выгрузить();
		
	КонецЕсли;
	
	СтруктураДанныхРасчета.СМ_СтоимостьРесурсовПозиции.Очистить();
	
	СписокПозиций = Новый СписокЗначений();
	СписокПозиций.Добавить(СтруктураПараметровОтбораРС.СсылкаНаПозицию);
	
	СтруктураДанныхРасчета.СМ_СтоимостьРесурсовПозиции = ?(Акт = Неопределено, СМ_СметаРасчетВызовСервера.ПолучитьТаблицуСтоимостиРесурсовСметы(СписокПозиций,,,,,,,Истина), СМ_СметаРасчетВызовСервера.ПолучитьТаблицуСтоимостиРесурсовАкта(Акт, , СписокПозиций));
	СтруктураДанныхРасчета.СМ_СтоимостьРесурсовПозиции.Колонки.Добавить("Позиция");
	СтруктураДанныхРасчета.СМ_СтоимостьРесурсовПозиции.Колонки.Добавить("Раздел");
	СтруктураДанныхРасчета.СМ_СтоимостьРесурсовПозиции.Колонки.Добавить("Смета");
	
	СтруктураДанныхРасчета.СМ_СтоимостьРесурсовПозиции.ЗаполнитьЗначения(СтруктураПараметровОтбораРС.СсылкаНаПозицию,"Позиция");
	СтруктураДанныхРасчета.СМ_СтоимостьРесурсовПозиции.ЗаполнитьЗначения(СтруктураПараметровОтбораРС.СсылкаНаРаздел,"Раздел");
	СтруктураДанныхРасчета.СМ_СтоимостьРесурсовПозиции.ЗаполнитьЗначения(СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета,"Смета");
	
	СтруктураДанныхРасчета.СМ_СтоимостьРесурсовПозиции.Свернуть("Смета, Раздел, Позиция, Ресурс, НаименованиеРесурса, СтатусРесурса, НомерСтрокиДокумента","НормаРасхода, Количество, СтоимостьБазисная, СтоимостьЗМБазисная, СтоимостьТекущая, СтоимостьТекущаяЗМ");
	        	
	Если ИспользоватьРС Тогда
		
		Отбор = Новый Структура("Позиция, Раздел, Смета",СтруктураПараметровОтбораРС.СсылкаНаПозицию,СтруктураПараметровОтбораРС.СсылкаНаРаздел,СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
		СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНаборТаблицей("СМ_СтоимостьРесурсовПозиции",Отбор,СтруктураДанныхРасчета.СМ_СтоимостьРесурсовПозиции);

	КонецЕсли;
	
