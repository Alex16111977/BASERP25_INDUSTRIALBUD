				КонецЕсли;
				
				Если ПравилоНачисленияНР <> Неопределено И ПравилоНачисленияНР = Перечисления.СМ_ПравилаРасчетаНРпоМетодике1984.РасчетКосвенныхРасходов Тогда	
					
					УсловиеНа84 = "";
					
				КонецЕсли; 
				
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;				 
	
	Запрос.Текст 	= Запрос.Текст 	+ УсловиеНа84;
	
	Запрос.УстановитьПараметр("ТипНормативногоСборника", Объект.ТипНормативныхСборников);
	Запрос.УстановитьПараметр("ВидРасценки", Объект.Определитель.ВидРасценки);
	Запрос.УстановитьПараметр("ВидРабот", Объект.Определитель.ВидРабот);
