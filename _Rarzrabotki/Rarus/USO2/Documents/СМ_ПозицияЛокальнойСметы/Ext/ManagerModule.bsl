// Старая процедура обновления НР и СП по методике 1984 года - можно удалить после 2018го года.
//
// Параметры:
//   Позиция - ДокументОбъект.СМ_ПозицияЛокальнойСметы или данные формы (представление объекта).
//   СтруктураПараметровЛС - Структура - данные ЛС, переданные из вызывающей процедуры.
//   РассчитатьСуммы - Булево - Истина, если помимо установки норм, требуется расчет сумм НР и СП.
Процедура УдалитьОбновитьНРиСП1984(Позиция,СтруктураПараметровЛС = Неопределено, РассчитатьСуммы = Истина) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СтруктураПараметровЛС) Тогда
		СтруктураПараметровЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(,Позиция.Ссылка);
	КонецЕсли;
	
	Если СтруктураПараметровЛС.Методика1984 Тогда
		ОчиститьНРиСП(Позиция);

		СписокКонстант = РегистрыСведений.СМ_НаборКонстантпоМетодике1984.Получить();
		Если СписокКонстант.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;	
		Если СтруктураПараметровЛС.РасчетНРиСПотПЗ Тогда
			// Расчет от прямых затрат.
			Если СтруктураПараметровЛС.МетодРасчета <> Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
				Если (СтруктураПараметровЛС.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
					И СтруктураПараметровЛС.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка
					И СтруктураПараметровЛС.БезПримененияКоэффициентов)
					Или (СтруктураПараметровЛС.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
					И СтруктураПараметровЛС.Уровень <> Перечисления.СМ_УровеньЗаданияИндексов.Расценка) 	Тогда
						// Аналогия старому методу без применения коэффициентов
						Позиция.КоэффициентТРвНР = СписокКонстант.КоэффициентТРвНР; 
						Позиция.КоэффициентОЗвНР = СписокКонстант.КоэффициентОЗвНР;
						Позиция.СметнаяПрибыльТекущие = СписокКонстант.СметнаяПрибыльБазисноИндексная;
						Позиция.СметнаяПрибыльБазисные = СписокКонстант.СметнаяПрибыльБазисноИндексная;
						Отбор = Новый Структура("Определитель",Позиция.Определитель.Ссылка);
						Выборка = РегистрыСведений.СМ_СоответствияОпределителяиНРдляМетодики1984.Получить(Отбор);
						Если Выборка.Количество() <> 0 Тогда
							Позиция.НакладныерасходыТекущие = Выборка.ЗначениеНРБазисноИндексное;
							Позиция.НакладныерасходыБазисные = Выборка.ЗначениеНРБазисноИндексное;
						КонецЕсли;
					ИначеЕсли (СтруктураПараметровЛС.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
						И СтруктураПараметровЛС.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка 
						И СтруктураПараметровЛС.БезПримененияКоэффициентов = Ложь)  Тогда
						// Коэффициенты к элементам затрат от ФОТ
						Позиция.КоэффициентТРвНР = 0; 
						Позиция.КоэффициентОЗвНР = 0;
						Позиция.НакладныеРасходыБазисные = СписокКонстант.НРБазисныеОтФОТ;
						Позиция.НакладныеРасходыТекущие  = СписокКонстант.НРТекущиеОтФОТ;
						Позиция.СметнаяПрибыльБазисные   = СписокКонстант.СПБазисныеОтФОТ;
						Позиция.СметнаяПрибыльТекущие    = СписокКонстант.СПТекущиеОтФОТ;
						
					КонецЕсли;	 
				ИначеЕсли СтруктураПараметровЛС.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
					// Для ресурсного метода Расчет от Прямых затрат.
					Позиция.КоэффициентТРвНР = 0; 
					Позиция.КоэффициентОЗвНР = 0;
					
					Позиция.НакладныерасходыТекущие  = СписокКонстант.НакладныерасходыРесурсные;
					Позиция.НакладныерасходыБазисные  = СписокКонстант.НакладныерасходыРесурсные;
					Позиция.СметнаяПрибыльБазисные = СписокКонстант.СметнаяПрибыльРесурсная;
					Позиция.СметнаяПрибыльТекущие = СписокКонстант.СметнаяПрибыльРесурсная;
			КонецЕсли;	
		Иначе
			// Расчет от ФОт для всех,
			// коэффициенты к элементам затрат от ФОТ.
			Позиция.КоэффициентТРвНР = 0; 
			Позиция.КоэффициентОЗвНР = 0;
			Позиция.НакладныеРасходыБазисные = СписокКонстант.НРБазисныеОтФОТ;
			Позиция.НакладныеРасходыТекущие  = СписокКонстант.НРТекущиеОтФОТ;
			Позиция.СметнаяПрибыльБазисные   = СписокКонстант.СПБазисныеОтФОТ;
			Позиция.СметнаяПрибыльТекущие    = СписокКонстант.СПТекущиеОтФОТ;
			
		КонецЕсли;	 
		
		Если РассчитатьСуммы Тогда
			// Судариков - расчет идет при записи, а не в момент обновления норм!
			РассчитатьНРиСП(Позиция, ИнициироватьТаблицыРасчета(), СМ_СметаВызовСервера.НайтиЛС(Позиция), , , Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

// Обновляет НР и СП по методике 1984 года.
//
// Параметры:
//   Позиция - ДокументОбъект.СМ_ПозицияЛокальнойСметы или данные формы (представление объекта).
//   СтруктураПараметровЛС - Структура - данные ЛС, переданные из вызывающей процедуры.
//   РассчитатьСуммы - Булево - Истина, если помимо установки норм, требуется расчет сумм НР и СП.
Процедура ОбновитьНРиСП1984(Позиция,СтруктураПараметровЛС = Неопределено, РассчитатьСуммы = Истина) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СтруктураПараметровЛС) Тогда
		СтруктураПараметровЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(,Позиция.Ссылка);
	КонецЕсли;
	
	Если СтруктураПараметровЛС.Методика1984 Тогда
		
		ОчиститьНРиСП(Позиция);

		СписокКонстант = РегистрыСведений.СМ_НаборКонстантпоМетодике1984.Получить();
		
		Если СписокКонстант.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;	
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	СМ_СоответствияОпределителяиНРдляМетодики1984.ПравилоНачисленияНР КАК ПравилоНачисленияНР,
		|	СМ_СоответствияОпределителяиНРдляМетодики1984.ЗначениеНРБазисноИндексное КАК ЗначениеНРБазисноИндексное,
		|	СМ_СоответствияОпределителяиНРдляМетодики1984.ПравилоНачисленияСП КАК ПравилоНачисленияСП
		|ИЗ
		|	РегистрСведений.СМ_СоответствияОпределителяиНРдляМетодики1984 КАК СМ_СоответствияОпределителяиНРдляМетодики1984
		|ГДЕ
		|	СМ_СоответствияОпределителяиНРдляМетодики1984.Определитель = &Определитель";
		
		Запрос.УстановитьПараметр("Определитель", Позиция.Определитель);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
		
			Позиция.ПравилаРасчетаНРПоМетодике1984  = Выборка.ПравилоНачисленияНР;
			Позиция.ПравилаРасчетаСППоМетодике1984  = Выборка.ПравилоНачисленияСП;
			Позиция.СметнаяПрибыльТекущие           = СписокКонстант.СметнаяПрибыльРесурсная;
			Позиция.СметнаяПрибыльБазисные          = СписокКонстант.СметнаяПрибыльРесурсная;
			Позиция.НакладныерасходыТекущие         = Выборка.ЗначениеНРБазисноИндексное;
			Позиция.НакладныерасходыБазисные         = Выборка.ЗначениеНРБазисноИндексное;
		
		Иначе
			
			Позиция.ПравилаРасчетаНРПоМетодике1984  = Перечисления.СМ_ПравилаРасчетаНРпоМетодике1984.Неначислять;
			Позиция.ПравилаРасчетаСППоМетодике1984  = Ложь;
			Позиция.СметнаяПрибыльТекущие           = 0;
			Позиция.СметнаяПрибыльБазисные          = 0;
			Позиция.НакладныерасходыТекущие         = 0;
			Позиция.НакладныерасходыБазисные         = 0;
		
		КонецЕсли;
		               	
		Если СтруктураПараметровЛС.РасчетНРиСПотПЗ Тогда
			// Расчет от прямых затрат.
			Если СтруктураПараметровЛС.МетодРасчета <> Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
				Если (СтруктураПараметровЛС.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
					И СтруктураПараметровЛС.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка
					И СтруктураПараметровЛС.БезПримененияКоэффициентов)
					Или (СтруктураПараметровЛС.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
					И СтруктураПараметровЛС.Уровень <> Перечисления.СМ_УровеньЗаданияИндексов.Расценка) 	Тогда
						// Аналогия старому методу без применения коэффициентов
						Позиция.КоэффициентТРвНР = СписокКонстант.КоэффициентТРвНР; 
						Позиция.КоэффициентОЗвНР = СписокКонстант.КоэффициентОЗвНР;
						////Позиция.СметнаяПрибыльТекущие = СписокКонстант.СметнаяПрибыльБазисноИндексная;
						////Позиция.СметнаяПрибыльБазисные = СписокКонстант.СметнаяПрибыльБазисноИндексная;
						////Отбор = Новый Структура("Определитель",Позиция.Определитель.Ссылка);
						////Выборка = РегистрыСведений.СМ_СоответствияОпределителяиНРдляМетодики1984.Получить(Отбор);
						////Если Выборка.Количество() <> 0 Тогда
						////	Позиция.НакладныерасходыТекущие = Выборка.ЗначениеНРБазисноИндексное;
						////	Позиция.НакладныерасходыБазисные = Выборка.ЗначениеНРБазисноИндексное;
						////КонецЕсли;
					ИначеЕсли (СтруктураПараметровЛС.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
						И СтруктураПараметровЛС.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка 
						И СтруктураПараметровЛС.БезПримененияКоэффициентов = Ложь)  Тогда
						// Коэффициенты к элементам затрат от ФОТ
						Позиция.КоэффициентТРвНР = 0; 
						Позиция.КоэффициентОЗвНР = 0;
						//Позиция.НакладныеРасходыБазисные = СписокКонстант.НРБазисныеОтФОТ;
						//Позиция.НакладныеРасходыТекущие  = СписокКонстант.НРТекущиеОтФОТ;
						//Позиция.СметнаяПрибыльБазисные   = СписокКонстант.СПБазисныеОтФОТ;
						//Позиция.СметнаяПрибыльТекущие    = СписокКонстант.СПТекущиеОтФОТ;
						
					КонецЕсли;	 
				ИначеЕсли СтруктураПараметровЛС.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
					// Для ресурсного метода Расчет от Прямых затрат.
					Позиция.КоэффициентТРвНР = 0; 
					Позиция.КоэффициентОЗвНР = 0;
					
					//Позиция.НакладныерасходыТекущие  = СписокКонстант.НакладныерасходыРесурсные;
					//Позиция.НакладныерасходыБазисные  = СписокКонстант.НакладныерасходыРесурсные;
					//Позиция.СметнаяПрибыльБазисные = СписокКонстант.СметнаяПрибыльРесурсная;
					//Позиция.СметнаяПрибыльТекущие = СписокКонстант.СметнаяПрибыльРесурсная;
			КонецЕсли;	
		Иначе
			// Расчет от ФОт для всех,
			// коэффициенты к элементам затрат от ФОТ.
			Позиция.КоэффициентТРвНР = 0; 
			Позиция.КоэффициентОЗвНР = 0;
			//Позиция.НакладныеРасходыБазисные = СписокКонстант.НРБазисныеОтФОТ;
			//Позиция.НакладныеРасходыТекущие  = СписокКонстант.НРТекущиеОтФОТ;
			//Позиция.СметнаяПрибыльБазисные   = СписокКонстант.СПБазисныеОтФОТ;
			//Позиция.СметнаяПрибыльТекущие    = СписокКонстант.СПТекущиеОтФОТ;
			
		КонецЕсли;	 
		
		Если РассчитатьСуммы Тогда
			// Судариков - расчет идет при записи, а не в момент обновления норм!
			РассчитатьНРиСП(Позиция, ИнициироватьТаблицыРасчета(), СМ_СметаВызовСервера.НайтиЛС(Позиция), , , Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

// Осуществляет обновление НР и СП
// Параметры:
//   Позиция - ДокументОбъект.СМ_ПозицияЛокальнойСметы или данные формы (представление объекта).
//   СтруктураПараметровЛС - Структура - данные ЛС, полученные методом СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС,
//	 	если не задана - будет получена в ходе выполнения процедуры.
//   РассчитатьСуммы - Булево - Истина, если помимо установки норм, требуется расчет сумм НР и СП.
Процедура ОбновитьНРиСП(Позиция, СтруктураПараметровЛС = Неопределено, РассчитатьСуммы = Истина) Экспорт
	
	ОчиститьНРиСП(Позиция);
	
	Если НЕ ЗначениеЗаполнено(СтруктураПараметровЛС) Тогда
		СтруктураПараметровЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(,Позиция.Ссылка);
	КонецЕсли;	
	
	Если СтруктураПараметровЛС.Методика1984 Тогда
		ОбновитьНРиСП1984(Позиция,СтруктураПараметровЛС, РассчитатьСуммы);
		Возврат;
	КонецЕсли;	

	РегиональнаяБазаПозиции = Позиция.РегиональнаяБаза;
	Если СМ_СметаЗагрузкаВызовСервера.ОпределитьУровеньСНБ(РегиональнаяБазаПозиции.Наименование, РегиональнаяБазаПозиции.Код)= Перечисления.СМ_УровниБазы.ТерриториальныйМосква Тогда
		Возврат;
	КонецЕсли;	
	
	ТекМетодика = Позиция.ИДСметы.МетодикаРасчета;
	Норматив 	= СМ_СметаВызовСервера.ПолучитьНормативыНРиСП(Позиция.ТипНормативныхСборников, СтруктураПараметровЛС.ТипРайона, Позиция.ШифрРасценки, ТекМетодика, СтруктураПараметровЛС.МетодикаКазахстана);
	Если Не Норматив = Неопределено Тогда
		
		Позиция.ВидРабот = Норматив.ВидРаботДляНачисленияНРиСП;
		
		СтрокаНорматива 					= Норматив.Нормативы.Найти(СтруктураПараметровЛС.ТипРайона);
		Позиция.НакладныеРасходыБазисные 	= СтрокаНорматива.НормативНакладныхРасходов;
		Позиция.СметнаяПрибыльБазисные 		= СтрокаНорматива.НормативСметнойПрибыли;
		Позиция.НакладныеРасходыТекущие 	= СтрокаНорматива.НормативНакладныхРасходов;
		Позиция.СметнаяПрибыльТекущие 		= СтрокаНорматива.НормативСметнойПрибыли;
		
		КоэффНРРемонтБазис 	= Константы.СМ_КоэффициентНРбазисныйРемонт.Получить();
		КоэффНРРемонт  		= Константы.СМ_КоэффициентНРтекущийРемонт.Получить();
		КоэффНРУСН 			= Константы.СМ_КоэффициентНРтекущийУСН.Получить();
		КоэффНРУСНБазис 	= Константы.СМ_КоэффициентНРбазисныйУСН.Получить();
		КоэффНРАЭС 			= Константы.СМ_КоэффициентНРтекущийАЭС.Получить();
		КоэффНРАЭСБазис 	= Константы.СМ_КоэффициентНРбазисныйАЭС.Получить();
		
		КоэффСПРемонтБазис 	= Константы.СМ_КоэффициентСПбазисныйРемонт.Получить();
		КоэффСПРемонт  		= Константы.СМ_КоэффициентСПтекущийРемонт.Получить();
		КоэффСПУСН 			= Константы.СМ_КоэффициентСПтекущийУСН.Получить();
		КоэффСПУСНБазис 	= Константы.СМ_КоэффициентСПбазисныйУСН.Получить();
		КоэффСПАЭС 			= Константы.СМ_КоэффициентСПтекущийАЭС.Получить();
		КоэффСПАЭСБазис 	= Константы.СМ_КоэффициентСПбазисныйАЭС.Получить();
		
		Если НЕ СтруктураПараметровЛС.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.НовоеСтроительство Тогда
			Если СтруктураПараметровЛС.ПрименятьКоэффициентыНРСП = Перечисления.СМ_НРИСПДляСметыНаРемонт.ПрименятьНРиСП Тогда
				Если Норматив.ПрименитьКоэффициентНР = Истина  Тогда
					Позиция.КоэффициентКНРНаРемонтБазисный = КоэффНРРемонтБазис;
					Позиция.КоэффициентКНРНаРемонтТекущий  = КоэффНРРемонт;
				КонецЕсли;
				Если Норматив.ПрименитьКоэффициентСП = Истина Тогда
					Позиция.КоэффициентКСПНаРемонтБазисный = КоэффСПРемонтБазис;
					Позиция.КоэффициентКСПНаРемонтТекущий  = КоэффСПРемонт; 
				КонецЕсли;
			ИначеЕсли СтруктураПараметровЛС.ПрименятьКоэффициентыНРСП = Перечисления.СМ_НРИСПДляСметыНаРемонт.ТолькоНР И Норматив.ПрименитьКоэффициентНР = Истина Тогда
				Позиция.КоэффициентКНРНаРемонтБазисный = КоэффНРРемонтБазис;
				Позиция.КоэффициентКНРНаРемонтТекущий  = КоэффНРРемонт;  				
			ИначеЕсли СтруктураПараметровЛС.ПрименятьКоэффициентыНРСП = Перечисления.СМ_НРИСПДляСметыНаРемонт.ТолькоСП И Норматив.ПрименитьКоэффициентСП = Истина Тогда
				Позиция.КоэффициентКСПНаРемонтБазисный = КоэффСПРемонтБазис;
				Позиция.КоэффициентКСПНаРемонтТекущий  = КоэффСПРемонт;
			КонецЕсли;
		КонецЕсли;
		
		Если СтруктураПараметровЛС.УпрощеннаяСН Тогда
			Позиция.КоэффициентКНРУСНБазисный 	= КоэффНРУСНБазис;
			Позиция.КоэффициентКНРУСНТекущий 	= КоэффНРУСН;
			Позиция.КоэффициентКСПУСНБазисный 	= КоэффСПУСНБазис;
			Позиция.КоэффициентКСПУСНТекущий 	= КоэффСПУСН;
		КонецЕсли;
		
		Если СтруктураПараметровЛС.РеконструкцияАЭС Тогда 
			Позиция.КоэффициентКНРАЭСБазисный 	= КоэффНРАЭСБазис;
			Позиция.КоэффициентКНРАЭСТекущий 	= КоэффНРАЭС;
			Позиция.КоэффициентКСПАЭСБазисный 	= КоэффСПАЭСБазис;
			Позиция.КоэффициентКСПАЭСТекущий 	= КоэффСПАЭС;
		КонецЕсли;
		
		Если Норматив.ПрименятьПоправочныйКоэффициентКНР Тогда
			Позиция.ПоправочныйКоэффициентКНРБазисный 	= Константы.СМ_ПоправочныйКоэффициентНРБазисный.Получить();
			Позиция.ПоправочныйКоэффициентКНРТекущий 	= Константы.СМ_ПоправочныйКоэффициентНРТекущий.Получить();
		КонецЕсли;	
		
		Если Норматив.ПрименятьПоправочныйКоэффициентКСП Тогда
			Позиция.ПоправочныйКоэффициентКСПБазисный 	= Константы.СМ_ПоправочныйКоэффициентСПБазисный.Получить();
			Позиция.ПоправочныйКоэффициентКСПТекущий 	= Константы.СМ_ПоправочныйКоэффициентСПТекущий.Получить();
		КонецЕсли;

	КонецЕсли;
	
	Если РассчитатьСуммы Тогда
		// Судариков - расчет идет при записи, а не в момент обновления норм!
		РассчитатьНРиСП(Позиция, ИнициироватьТаблицыРасчета(), СМ_СметаВызовСервера.НайтиЛС(Позиция), , , Истина);
	КонецЕсли;
	
КонецПроцедуры

// Производит расчет НР и СП и заполнение регистра СМ_НРиСП.
//
// Параметры:
//   Объект 						- ДокументОбъект.СМ_ПозицияЛокальнойСметы, данные формы (представление объекта) - данные объекта.
//   СтруктураДанныхРасчета 		- Структура - таблицы данных для расчета (см. менеджер СМ_ПозицияЛокальнойСметы).
//   ЛС 							- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на локальную смету.
//   Акт 							- ДокументыСсылка.СМ_АктВыполненныхРабот - ссылка на акт (если НР и СП для акта).
//   СтруктураПараметровОтбораРС 	- Структура - данные для регистров сведений,
//   											  полученные методом СМ_СметаВызовСервера.ПолучитьСтруктуруДанныхДляОтборовРегистра).
//												  Если параметр не задан, то структура будет получена в ходе выполнения процедуры.
// 	 ИспользоватьРС 				- Булево - если Ложь, то все считается без чтения и записи из РС.
//
Процедура РассчитатьНРиСП(Объект, СтруктураДанныхРасчета, ЛС, Акт = Неопределено, СтруктураПараметровОтбораРС = Неопределено, ИспользоватьРС = Истина) Экспорт
	
	Если Не Объект.Расчет Тогда 
		Возврат;
	КонецЕсли;
	
	Если СтруктураПараметровОтбораРС = Неопределено Тогда
		СтруктураПараметровОтбораРС = СМ_СметаВызовСервера.ПолучитьСтруктуруДанныхДляОтборовРегистра(Объект, Акт, "СМ_ПозицияЛокальнойСметы");
	КонецЕсли;
	
	ФОТБазис 			= 0;
	ФОТТек 				= 0;
	ОснЗарплБазис 		= 0;
	ОснЗарплТек 		= 0;
	ПрямЗатратыБазис 	= 0;
	ПрямЗатратыТек 		= 0;
	ЗарплМашинБазис 	= 0;
	ЗарплМашинТек 		= 0;
	
	ОснЗарплБазисНаОбъем 	= 0;
	ОснЗарплТекНаОбъем 		= 0;
	ПрямЗатратыБазисНаОбъем = 0;
	ПрямЗатратыТекНаОбъем 	= 0;
	ЗарплМашинБазисНаОбъем 	= 0;
	ЗарплМашинТекНаОбъем 	= 0;
	
	СуммаНР2Базисная 	= 0;
	СуммаНР2Текущая 	= 0;
	СуммаНР2БазиснаяНаОбъем = 0;
	СуммаНР2ТекущаяНаОбъем 	= 0;
	ПрямЗатратыБазисОборуд = 0;
	ПрямЗатратыТекОборуд = 0;   			
	
	СуммаСП2Базисная 	= 0;
	СуммаСП2Текущая 	= 0;
	СуммаСП2БазиснаяНаОбъем = 0;
	СуммаСП2ТекущаяНаОбъем 	= 0;
	ПрямЗатратыБазисНаОбъемОборуд = 0;
	ПрямЗатратыТекНаОбъемОборуд = 0;
			
	Методика1984 = Ложь;	
	Если ЛС.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_Методика84года Тогда
		Методика1984 = Истина;	
	КонецЕсли;
	
	МетодикаТСН = Ложь;
	Если ЛС.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква Тогда
		МетодикаТСН = Истина;	
	КонецЕсли;
	
	МетодикаМДС2017 = Ложь;
	Если ЛС.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаМДС2017 Тогда
		МетодикаМДС2017 = Истина;	
	КонецЕсли;
	
	МетодикаРСНБ = Ложь;
	Если ЛС.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_КЗ_РСНБ Тогда
		МетодикаРСНБ = Истина;	
	КонецЕсли;

	Если Акт = Неопределено Тогда
		Раздел 						= Объект.Ссылка.ИДРодителя;
		ОбъемРабот 					= Объект.ОбъемРабот;
		Округлять 					= ЛС.ОкруглятьДоРублей;
		РасчетНРиСПотПЗ 			= ЛС.РасчетНРиСПотПЗ;
		БезПримененияКоэффициентов 	= ЛС.БезПримененияКоэффициентов;
	Иначе
		РасчетНРиСПотПЗ 			= ЛС.РасчетНРиСПотПЗ;
		БезПримененияКоэффициентов 	= ЛС.БезПримененияКоэффициентов;
	
		Округлять 		= Акт.ОкруглятьДоРублей;
		СтрокаРаздела 	= СМ_СметаВызовСервера.СтрокаРазделаАкта(Акт, СтруктураПараметровОтбораРС.СсылкаНаРаздел) ;
		Если Не СтрокаРаздела = Неопределено Тогда
			Раздел = СтрокаРаздела.Раздел;
		Иначе  
			Возврат; 
		КонецЕсли;
		СтрокаПозиции = СМ_СметаВызовСервера.СтрокаПозицииАкта(Акт, Объект);
		Если Не СтрокаПозиции = Неопределено Тогда
			ОбъемРабот = СтрокаПозиции.ФактОбъем;
		Иначе 
			Возврат; 
		КонецЕсли;
	КонецЕсли;
	
	Если Округлять = Истина Тогда
		КолЗнаков = 0;
	Иначе
		КолЗнаков = 2;
	КонецЕсли;
	
	Если (Не Методика1984) И (Не МетодикаРСНБ) Тогда
		Если Объект.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал ИЛИ
			 Объект.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если ЛС.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный Тогда
		
		// 1. Получение ФОТ базис.
		
		Если ИспользоватьРС Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимПрямЗатраты,
			               |	БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимОснЗарплата,
			               |	БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимЗарплМашин
			               |ИЗ
			               |	РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП КАК БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП
			               |ГДЕ
			               |	БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция = &Позиция
			               |	И БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Смета = &Смета" ;
			
			Запрос.УстановитьПараметр("Позиция", СтруктураПараметровОтбораРС.СсылкаНаПозицию);
			Запрос.УстановитьПараметр("Смета", СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
			ТаблицаРегистра1 = Запрос.Выполнить().Выгрузить();
		Иначе
			ТаблицаРегистра1 = СтруктураДанныхРасчета.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Скопировать();
		КонецЕсли;
		
		Если ТаблицаРегистра1.Количество() > 0 Тогда
			ВыборкаРегистра1 = ТаблицаРегистра1[0];
			ФОТБазис = ВыборкаРегистра1.СтоимОснЗарплата + ВыборкаРегистра1.СтоимЗарплМашин;
			ОснЗарплБазисНаОбъем = ВыборкаРегистра1.СтоимОснЗарплата * ОбъемРабот;
			ЗарплМашинБазисНаОбъем = ВыборкаРегистра1.СтоимЗарплМашин  * ОбъемРабот;
			ПрямЗатратыБазисНаОбъем = ВыборкаРегистра1.СтоимПрямЗатраты  * ОбъемРабот;
			ПрямЗатратыТекНаОбъем = ВыборкаРегистра1.СтоимПрямЗатраты  * ОбъемРабот;
			ОснЗарплБазис = ВыборкаРегистра1.СтоимОснЗарплата;
			ЗарплМашинБазис = ВыборкаРегистра1.СтоимЗарплМашин;
			ПрямЗатратыБазис = ВыборкаРегистра1.СтоимПрямЗатраты ;
			ПрямЗатратыТек = ВыборкаРегистра1.СтоимПрямЗатраты ;
		КонецЕсли;
	
		// 2. Получение ФОТ текущей.
		Если ИспользоватьРС Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимОснЗарплата,
			               |	БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимЗарплМашин
			               |ИЗ
			               |	РегистрСведений.СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета КАК БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета
			               |ГДЕ
			               |	БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция = &Позиция
			               |	И БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета = &Смета" ;
			
			Запрос.УстановитьПараметр("Позиция",СтруктураПараметровОтбораРС.СсылкаНаПозицию);
			Запрос.УстановитьПараметр("Смета",СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
			ТаблицаРегистра2 = Запрос.Выполнить().Выгрузить();
		Иначе
			ТаблицаРегистра2 = СтруктураДанныхРасчета.СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Скопировать();
		КонецЕсли;
		Если ТаблицаРегистра2.Количество() > 0 Тогда
			ВыборкаРегистра2 = ТаблицаРегистра2[0];
			
			ФОТТек = ВыборкаРегистра2.СтоимОснЗарплата + ВыборкаРегистра2.СтоимЗарплМашин;
			ОснЗарплТекНаОбъем = ВыборкаРегистра2.СтоимОснЗарплата  * ОбъемРабот;
			ЗарплМашинТекНаОбъем = ВыборкаРегистра2.СтоимЗарплМашин  * ОбъемРабот;
			ОснЗарплТек = ВыборкаРегистра2.СтоимОснЗарплата;
			ЗарплМашинТек = ВыборкаРегистра2.СтоимЗарплМашин;
		КонецЕсли;
		
	ИначеЕсли ЛС.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
		                                                                       
		Если ИспользоватьРС Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	РесурснаяСтоимостьПозиции.СтоимОснЗарплата КАК СтоимОснЗарплата,
			               |	РесурснаяСтоимостьПозиции.СтоимЗарплМашин КАК СтоимЗарплМашин,
			               |	РесурснаяСтоимостьПозиции.СтоимПрямЗатраты КАК СтоимПрямЗатраты,
			               |	РесурснаяСтоимостьПозиции.ТекСтоимОснЗарплата КАК ТекСтоимОснЗарплата,
			               |	РесурснаяСтоимостьПозиции.ТекСтоимПрямЗатраты КАК ТекСтоимПрямЗатраты,
			               |	РесурснаяСтоимостьПозиции.ТекСтоимЗарплМашин КАК ТекСтоимЗарплМашин,
			               |	РесурснаяСтоимостьПозиции.ТекСтоимОборуд КАК ТекСтоимОборуд,
			               |	РесурснаяСтоимостьПозиции.СтоимОборуд КАК СтоимОборуд
			               |ИЗ
			               |	РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП КАК РесурснаяСтоимостьПозиции
			               |ГДЕ
			               |	РесурснаяСтоимостьПозиции.Позиция = &Позиция
			               |	И РесурснаяСтоимостьПозиции.Смета = &Смета" ;
			
			Запрос.УстановитьПараметр("Позиция",СтруктураПараметровОтбораРС.СсылкаНаПозицию);
			Запрос.УстановитьПараметр("Смета",СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
			ТаблицаРегистра3 = Запрос.Выполнить().Выгрузить();
		Иначе
			ТаблицаРегистра3 = СтруктураДанныхРасчета.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Скопировать();
		КонецЕсли;
		
		Если ТаблицаРегистра3.Количество() > 0 Тогда
			ВыборкаРегистра3 = ТаблицаРегистра3[0];
			
			ФОТТек = ВыборкаРегистра3.ТекСтоимОснЗарплата + ВыборкаРегистра3.ТекСтоимЗарплМашин;
			ФОТБазис = ВыборкаРегистра3.СтоимОснЗарплата + ВыборкаРегистра3.СтоимЗарплМашин;
			ОснЗарплБазисНаОбъем = ВыборкаРегистра3.СтоимОснЗарплата  * ОбъемРабот;
			ПрямЗатратыБазисНаОбъем = ВыборкаРегистра3.СтоимПрямЗатраты  * ОбъемРабот;
			ПрямЗатратыТекНаОбъем = ВыборкаРегистра3.ТекСтоимПрямЗатраты  * ОбъемРабот;
			ПрямЗатратыБазисНаОбъемОборуд = (ВыборкаРегистра3.СтоимПрямЗатраты+ВыборкаРегистра3.СтоимОборуд) * ОбъемРабот;
			ПрямЗатратыТекНаОбъемОборуд = (ВыборкаРегистра3.ТекСтоимПрямЗатраты+ВыборкаРегистра3.ТекСтоимОборуд) * ОбъемРабот;
			ОснЗарплТекНаОбъем = ВыборкаРегистра3.ТекСтоимОснЗарплата  * ОбъемРабот;
			ЗарплМашинБазисНаОбъем = ВыборкаРегистра3.СтоимЗарплМашин  * ОбъемРабот;
			ЗарплМашинТекНаОбъем = ВыборкаРегистра3.ТекСтоимЗарплМашин  * ОбъемРабот;
			
			ОснЗарплБазис = ВыборкаРегистра3.СтоимОснЗарплата;
			ПрямЗатратыБазис = ВыборкаРегистра3.СтоимПрямЗатраты;
			ПрямЗатратыТек = ВыборкаРегистра3.ТекСтоимПрямЗатраты;
			ПрямЗатратыБазисОборуд = ВыборкаРегистра3.СтоимПрямЗатраты+ВыборкаРегистра3.СтоимОборуд;
			ПрямЗатратыТекОборуд = ВыборкаРегистра3.ТекСтоимПрямЗатраты+ВыборкаРегистра3.ТекСтоимОборуд;
			ОснЗарплТек = ВыборкаРегистра3.ТекСтоимОснЗарплата;
			ЗарплМашинБазис = ВыборкаРегистра3.СтоимЗарплМашин;
			ЗарплМашинТек = ВыборкаРегистра3.ТекСтоимЗарплМашин;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Коэффициенты НР
	КоэффициентКНРНаРемонтБазисный 		= ?(Объект.КоэффициентКНРНаРемонтБазисный = 0,1,Объект.КоэффициентКНРНаРемонтБазисный);
	КоэффициентКНРНаРемонтТекущий		= ?(Объект.КоэффициентКНРНаРемонтТекущий = 0,1,Объект.КоэффициентКНРНаРемонтТекущий);

	КоэффициентКНРУСНБазисный			= ?(Объект.КоэффициентКНРУСНБазисный = 0,1,Объект.КоэффициентКНРУСНБазисный);
	КоэффициентКНРУСНТекущий			= ?(Объект.КоэффициентКНРУСНТекущий = 0,1,Объект.КоэффициентКНРУСНТекущий);

	КоэффициентКНРАЭСБазисный			= ?(Объект.КоэффициентКНРАЭСБазисный = 0,1,Объект.КоэффициентКНРАЭСБазисный);
	КоэффициентКНРАЭСТекущий			= ?(Объект.КоэффициентКНРАЭСТекущий = 0,1,Объект.КоэффициентКНРАЭСТекущий);
	
	ПоправочныйКоэффициентКНРБазисный 	= ?(Объект.ПоправочныйКоэффициентКНРБазисный = 0,1,Объект.ПоправочныйКоэффициентКНРБазисный);
	ПоправочныйКоэффициентКНРТекущий	= ?(Объект.ПоправочныйКоэффициентКНРТекущий = 0,1,Объект.ПоправочныйКоэффициентКНРТекущий);
	
	// Коэффициенты СП
	КоэффициентКСПНаРемонтБазисный		= ?(Объект.КоэффициентКСПНаРемонтБазисный = 0,1,Объект.КоэффициентКСПНаРемонтБазисный);
	КоэффициентКСПНаРемонтТекущий		= ?(Объект.КоэффициентКСПНаРемонтТекущий = 0,1,Объект.КоэффициентКСПНаРемонтТекущий);

	КоэффициентКСПУСНБазисный			= ?(Объект.КоэффициентКСПУСНБазисный = 0,1,Объект.КоэффициентКСПУСНБазисный);
	КоэффициентКСПУСНТекущий			= ?(Объект.КоэффициентКСПУСНТекущий = 0,1,Объект.КоэффициентКСПУСНТекущий);

	КоэффициентКСПАЭСБазисный			= ?(Объект.КоэффициентКСПАЭСБазисный = 0,1,Объект.КоэффициентКСПАЭСБазисный);
	КоэффициентКСПАЭСТекущий			= ?(Объект.КоэффициентКСПАЭСТекущий = 0,1,Объект.КоэффициентКСПАЭСТекущий);

	ПоправочныйКоэффициентКСПБазисный	= ?(Объект.ПоправочныйКоэффициентКСПБазисный = 0,1,Объект.ПоправочныйКоэффициентКСПБазисный);
	ПоправочныйКоэффициентКСПТекущий	= ?(Объект.ПоправочныйКоэффициентКСПТекущий = 0,1,Объект.ПоправочныйКоэффициентКСПТекущий);
	
	// Расчет базисных и текущих цен СП и НР.
	НормативНРБазисная		= 0;
	НормативНРТекущая 		= 0;
	НормативСПБазисная		= 0;
	НормативСПТекущая 		= 0;	
	НормативНРБазиснаяМашин = 0;
	НормативНРТекущаяМашин 	= 0;
	НормативСПБазиснаяМашин	= 0;
	НормативСПТекущаяМашин 	= 0;	
	
	Если МетодикаТСН Тогда
		
		// Нормативы для расчета НР и СП от зарплаты механизаторов берутся из констант.
		НормативНРБазиснаяМашин = Константы.СМ_НРТСНБазис.Получить();
		НормативНРТекущаяМашин 	= Константы.СМ_НРТСНТекущие.Получить();
		НормативСПБазиснаяМашин	= Константы.СМ_СПТСНБазис.Получить();
		НормативСПТекущаяМашин 	= Константы.СМ_СПТСНТекущие.Получить();	
		Если Акт <> Неопределено Тогда
			// для акта НР и СП в табличной части позиции.
			Если ЛС.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.НовоеСтроительство Тогда
				НормативНРБазисная	= СтрокаПозиции.НакладныеРасходыБазисные;
				НормативНРТекущая	= СтрокаПозиции.НакладныеРасходыТекущие;
				НормативСПБазисная	= СтрокаПозиции.СметнаяПрибыльБазисные;
				НормативСПТекущая 	= СтрокаПозиции.СметнаяПрибыльТекущие;	
				
			ИначеЕсли ЛС.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
				НормативНРБазисная	= СтрокаПозиции.НРТСНБазисРемонт;
				НормативНРТекущая 	= СтрокаПозиции.НРТСНТекущиеРемонт;
				НормативСПБазисная	= СтрокаПозиции.СПТСНБазисРемонт;
				НормативСПТекущая 	= СтрокаПозиции.СПТСНТекущиеРемонт;	
			КонецЕсли;
			
		Иначе
			
			Если ЛС.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.НовоеСтроительство Тогда
				НормативНРБазисная	= Объект.НакладныеРасходыБазисные;
				НормативНРТекущая	= Объект.НакладныеРасходыТекущие;
				НормативСПБазисная	= Объект.СметнаяПрибыльБазисные;
				НормативСПТекущая 	= Объект.СметнаяПрибыльТекущие;	
				
			ИначеЕсли ЛС.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
				НормативНРБазисная	= Объект.НРТСНБазисРемонт;
				НормативНРТекущая 	= Объект.НРТСНТекущиеРемонт;
				НормативСПБазисная	= Объект.СПТСНБазисРемонт;
				НормативСПТекущая 	= Объект.СПТСНТекущиеРемонт;	
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Методика1984 Тогда
		НормативНРБазисная	= Объект.НакладныеРасходыТекущие;
		НормативНРТекущая 	= Объект.НакладныеРасходыТекущие;
		НормативСПБазисная	= Объект.СметнаяПрибыльБазисные;
		НормативСПТекущая 	= Объект.СметнаяПрибыльТекущие;
		
	Иначе // Обычный расчет 
