		ПЗТекНаОбъем				= Окр(ПрямЗатратыТекНаОбъем,КолЗнаков);

		СуммаНРБазисная 			= ПрямЗатратыБазис * НормативНРБазисная/100;
		СуммаНРТекущая 				= ПрямЗатратыТек * НормативНРТекущая/100;
		СуммаСПБазисная 			= ПрямЗатратыБазис * НормативСПБазисная/100;
		СуммаСПТекущая 				= ПрямЗатратыТек * НормативСПТекущая/100;
		
		СуммаНРБазиснаяНаОбъем		= ПЗБазисНаОбъем * НормативНРБазисная/100;
		СуммаНРТекущаяНаОбъем  		= ПЗТекНаОбъем * НормативНРТекущая/100;
		СуммаСПБазиснаяНаОбъем	 	= ПЗБазисНаОбъем * НормативСПБазисная/100;
		СуммаСПТекущаяНаОбъем  		= ПЗТекНаОбъем * НормативСПТекущая/100;

		СуммаНРБазиснаяМаш 			= 0;
		СуммаНРТекущаяМаш 			= 0;
		СуммаСПБазиснаяМаш 			= 0;
		СуммаСПТекущаяМаш 			= 0;
		
		СуммаНРБазиснаяМашНаОбъем 	= 0;
		СуммаНРТекущаяМашНаОбъем  	= 0;
		СуммаСПБазиснаяМашНаОбъем 	= 0;
		СуммаСПТекущаяМашНаОбъем  	= 0;
		
		
	ИначеЕсли МетодикаРСНБ Тогда
		
		Если СпособРасчетаНРиСП = Перечисления.СМ_ОбработкаПогрешностиРасчетаНРиСП.РасчетОтСуммыОкругленных Тогда
			ФОТБазисНаОбъем = Окр(ОснЗарплБазисНаОбъем,КолЗнаков) + Окр(ЗарплМашинБазисНаОбъем,КолЗнаков);
			ФОТТекНаОбъем   = Окр(ОснЗарплТекНаОбъем,КолЗнаков) + Окр(ЗарплМашинТекНаОбъем,КолЗнаков);
		ИначеЕсли СпособРасчетаНРиСП = Перечисления.СМ_ОбработкаПогрешностиРасчетаНРиСП.РасчетОтОкругленнойСуммы Тогда
			ФОТБазисНаОбъем = Окр(ОснЗарплБазисНаОбъем + ЗарплМашинБазисНаОбъем,КолЗнаков);
			ФОТТекНаОбъем   = Окр(ОснЗарплТекНаОбъем + ЗарплМашинТекНаОбъем,КолЗнаков);
		Иначе
			ФОТБазисНаОбъем = Окр(ОснЗарплБазисНаОбъем,КолЗнаков) + Окр(ЗарплМашинБазисНаОбъем,КолЗнаков);
			ФОТТекНаОбъем   = Окр(ОснЗарплТекНаОбъем,КолЗнаков) + Окр(ЗарплМашинТекНаОбъем,КолЗнаков);
		КонецЕсли;	

		СуммаНРБазисная = ФОТБазис * НормативНРБазисная/100;
		СуммаНРТекущая 	= ФОТТек * НормативНРТекущая/100;
		СуммаСПБазисная = 0;
		СуммаСПТекущая 	= 0;
		СуммаНР2Базисная 	= (ПрямЗатратыБазисОборуд + СуммаНРБазисная) * ЛС.НР2_ВС/100;
		СуммаНР2Текущая 	= (ПрямЗатратыТекОборуд + СуммаНРТекущая) * ЛС.НР2_ВС/100;
		СуммаСП2Базисная 	= ((ПрямЗатратыБазисОборуд + СуммаНРБазисная) * (ЛС.НР2_ВС + 100) / 100) * ЛС.СП_ВС /100;
		СуммаСП2Текущая 	= ((ПрямЗатратыТекОборуд + СуммаНРТекущая) * (ЛС.НР2_ВС + 100) / 100) * ЛС.СП_ВС /100;
		
		СуммаНРБазиснаяНаОбъем = ФОТБазисНаОбъем * НормативНРБазисная/100;
		СуммаНРТекущаяНаОбъем  = ФОТТекНаОбъем * НормативНРТекущая/100;
		СуммаСПБазиснаяНаОбъем = 0;
		СуммаСПТекущаяНаОбъем  = 0;
		СуммаНР2БазиснаяНаОбъем = (ПрямЗатратыБазисНаОбъемОборуд + СуммаНРБазиснаяНаОбъем) * ЛС.НР2_ВС/100;
		СуммаНР2ТекущаяНаОбъем = (ПрямЗатратыТекНаОбъемОборуд + СуммаНРТекущаяНаОбъем) * ЛС.НР2_ВС/100;
		СуммаСП2БазиснаяНаОбъем = ((ПрямЗатратыБазисНаОбъемОборуд + СуммаНРБазиснаяНаОбъем) * (ЛС.НР2_ВС + 100) / 100) * ЛС.СП_ВС /100;
		СуммаСП2ТекущаяНаОбъем  = ((ПрямЗатратыТекНаОбъемОборуд + СуммаНРТекущаяНаОбъем) * (ЛС.НР2_ВС + 100) / 100) * ЛС.СП_ВС /100;
		
		СуммаНРБазиснаяМаш 	= 0;
		СуммаНРТекущаяМаш 	= 0;
		СуммаСПБазиснаяМаш 	= 0;
		СуммаСПТекущаяМаш 	= 0;
		
		СуммаНРБазиснаяМашНаОбъем = 0;
		СуммаНРТекущаяМашНаОбъем  = 0;
		СуммаСПБазиснаяМашНаОбъем = 0;
		СуммаСПТекущаяМашНаОбъем  = 0;
		
				
	// Методика МДС35 и др.
	Иначе	
		
		Если СпособРасчетаНРиСП = Перечисления.СМ_ОбработкаПогрешностиРасчетаНРиСП.РасчетОтСуммыОкругленных Тогда
			ФОТБазисНаОбъем = Окр(ОснЗарплБазисНаОбъем,КолЗнаков) + Окр(ЗарплМашинБазисНаОбъем,КолЗнаков);
			ФОТТекНаОбъем   = Окр(ОснЗарплТекНаОбъем,КолЗнаков) + Окр(ЗарплМашинТекНаОбъем,КолЗнаков);
		ИначеЕсли СпособРасчетаНРиСП = Перечисления.СМ_ОбработкаПогрешностиРасчетаНРиСП.РасчетОтОкругленнойСуммы Тогда
			ФОТБазисНаОбъем = Окр(ОснЗарплБазисНаОбъем + ЗарплМашинБазисНаОбъем,КолЗнаков);
			ФОТТекНаОбъем   = Окр(ОснЗарплТекНаОбъем + ЗарплМашинТекНаОбъем,КолЗнаков);
		Иначе
			ФОТБазисНаОбъем = Окр(ОснЗарплБазисНаОбъем,КолЗнаков) + Окр(ЗарплМашинБазисНаОбъем,КолЗнаков);
			ФОТТекНаОбъем   = Окр(ОснЗарплТекНаОбъем,КолЗнаков) + Окр(ЗарплМашинТекНаОбъем,КолЗнаков);
		КонецЕсли;	

		СуммаНРБазисная = ФОТБазис * НормативНРБазисная/100;
		СуммаНРТекущая 	= ФОТТек * НормативНРТекущая/100;
		СуммаСПБазисная = ФОТБазис * НормативСПБазисная/100;
		СуммаСПТекущая 	= ФОТТек * НормативСПТекущая/100;
		
		СуммаНРБазиснаяНаОбъем = ФОТБазисНаОбъем * НормативНРБазисная/100;
		СуммаНРТекущаяНаОбъем  = ФОТТекНаОбъем * НормативНРТекущая/100;
		СуммаСПБазиснаяНаОбъем = ФОТБазисНаОбъем * НормативСПБазисная/100;
		СуммаСПТекущаяНаОбъем  = ФОТТекНаОбъем * НормативСПТекущая/100;
		
		СуммаНРБазиснаяМаш 	= 0;
		СуммаНРТекущаяМаш 	= 0;
		СуммаСПБазиснаяМаш 	= 0;
		СуммаСПТекущаяМаш 	= 0;
		
		СуммаНРБазиснаяМашНаОбъем = 0;
		СуммаНРТекущаяМашНаОбъем  = 0;
		СуммаСПБазиснаяМашНаОбъем = 0;
		СуммаСПТекущаяМашНаОбъем  = 0;
				
	КонецЕсли;
	
	ДобавкаТР = 0;
	ДобавкаОЗ = 0;
	
	// Не понятно надо ли...
	//Если Методика1984 Тогда
	//	Если (РасчетНРиСПотПЗ) И  ЛС.МетодРасчета <> Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
	//		КоэффициентТРвНР = Объект.КоэффициентТРвНР;
	//		КоэффициентОЗвНР = Объект.КоэффициентОЗвНР;
	//		ДобавкаТР = СуммаНРБазиснаяНаОбъем * (КоэффициентТРвНР);
	//		ДобавкаОЗ = СуммаНРБазиснаяНаОбъем * (КоэффициентОЗвНР);
	//	КонецЕсли;
	//КонецЕсли;
	
	Если ИспользоватьРС Тогда

		// Формирование регистра СМ_НРиСП.
		НаборЗаписей = РегистрыСведений.СМ_НРиСП.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Позиция.Установить(СтруктураПараметровОтбораРС.СсылкаНаПозицию);
		НаборЗаписей.Отбор.Смета.Установить(СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
		
		// управляемая блокировка регистра НР и СП
		НаборЗаписей.Прочитать();
		СтруктураДанныхРасчета.СМ_НРиСП = НаборЗаписей.Выгрузить();
		
	КонецЕсли;
	
	СтруктураДанныхРасчета.СМ_НРиСП.Очистить();	
	
	Если (ОснЗарплБазис + ЗарплМашинБазис + ОснЗарплТек + ЗарплМашинТек <> 0) ИЛИ
		 (ПрямЗатратыБазис <> 0 Или ПрямЗатратыТек <> 0) ИЛИ
		 МетодикаРСНБ Тогда
		
		СтрокаНРиСП = СтруктураДанныхРасчета.СМ_НРиСП.Добавить();
		
		// Единичные значения.
		СтрокаНРиСП.СуммаНРЕдиничная = СуммаНРБазисная;
		СтрокаНРиСП.СуммаСПЕдиничная = СуммаСПБазисная;
		СтрокаНРиСП.СуммаНР2Единичная = СуммаНР2Базисная;
		СтрокаНРиСП.СуммаСП2Единичная = СуммаСП2Базисная;
		
		СтрокаНРиСП.ТекСуммаНРЕдиничная = СуммаНРТекущая;
		СтрокаНРиСП.ТекСуммаСПЕдиничная = СуммаСПТекущая;
		СтрокаНРиСП.ТекСуммаНР2Единичная = СуммаНР2Текущая;
		СтрокаНРиСП.ТекСуммаСП2Единичная = СуммаСП2Текущая;
		
		СтрокаНРиСП.СуммаНРМашинистовЕдиничная = СуммаНРБазиснаяМаш;
		СтрокаНРиСП.СуммаСПМашинистовЕдиничная = СуммаСПБазиснаяМаш;
		
		СтрокаНРиСП.ТекСуммаНРМашинистовЕдиничная = СуммаНРТекущаяМаш;
		СтрокаНРиСП.ТекСуммаСПМашинистовЕдиничная = СуммаСПТекущаяМаш;
		
		// Значения на объем.
		СтрокаНРиСП.СуммаНРНаОбъем = СуммаНРБазиснаяНаОбъем;
		СтрокаНРиСП.СуммаСПНаОбъем = СуммаСПБазиснаяНаОбъем;
		СтрокаНРиСП.СуммаНР2НаОбъем = СуммаНР2БазиснаяНаОбъем;
		СтрокаНРиСП.СуммаСП2НаОбъем = СуммаСП2БазиснаяНаОбъем;
		
		СтрокаНРиСП.ТекСуммаНРНаОбъем = СуммаНРТекущаяНаОбъем;
		СтрокаНРиСП.ТекСуммаСПНаОбъем = СуммаСПТекущаяНаОбъем;
		СтрокаНРиСП.ТекСуммаНР2НаОбъем = СуммаНР2ТекущаяНаОбъем;
		СтрокаНРиСП.ТекСуммаСП2НаОбъем = СуммаСП2ТекущаяНаОбъем;
		
		СтрокаНРиСП.СуммаНРМашинистовНаОбъем = СуммаНРБазиснаяМашНаОбъем;
		СтрокаНРиСП.СуммаСПМашинистовНаОбъем = СуммаСПБазиснаяМашНаОбъем;
		
		СтрокаНРиСП.ТекСуммаНРМашинистовНаОбъем = СуммаНРТекущаяМашНаОбъем;
		СтрокаНРиСП.ТекСуммаСПМашинистовНаОбъем = СуммаСПТекущаяМашНаОбъем;
			
		СтрокаНРиСП.ДобавкаТР = ДобавкаТР;
		СтрокаНРиСП.ДобавкаОЗ = ДобавкаОЗ; 

		СтруктураДанныхРасчета.СМ_НРиСП.ЗаполнитьЗначения(СтруктураПараметровОтбораРС.СсылкаНаПозицию,"Позиция");
		СтруктураДанныхРасчета.СМ_НРиСП.ЗаполнитьЗначения(СтруктураПараметровОтбораРС.СсылкаНаРаздел,"Раздел");
		
		СтруктураДанныхРасчета.СМ_НРиСП.ЗаполнитьЗначения(СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета,"Смета");
		
		Если ИспользоватьРС Тогда
			Отбор = Новый Структура("Позиция, Раздел, Смета",СтруктураПараметровОтбораРС.СсылкаНаПозицию, СтруктураПараметровОтбораРС.СсылкаНаРаздел, СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
			СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНаборТаблицей("СМ_НРиСП",Отбор,СтруктураДанныхРасчета.СМ_НРиСП);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Производит очистку НР и СП
// Параметры:
// Объект - ДокументОбъект.СМ_ПозицияЛокальнойСметы или данные формы (представление объекта).
Процедура ОчиститьНРиСП(Объект) Экспорт
	
	Объект.НакладныеРасходыБазисные 			= 0;
	Объект.СметнаяПрибыльБазисные 				= 0;
	Объект.НакладныеРасходыТекущие 				= 0;
	Объект.СметнаяПрибыльТекущие 				= 0;
	Объект.КоэффициентКНРНаРемонтБазисный 		= 0;
	Объект.КоэффициентКНРНаРемонтТекущий 		= 0;
	Объект.КоэффициентКСПНаРемонтБазисный 		= 0;
	Объект.КоэффициентКСПНаРемонтТекущий 		= 0;
	Объект.КоэффициентКНРУСНБазисный 			= 0;
	Объект.КоэффициентКНРУСНТекущий 			= 0;
	Объект.КоэффициентКСПУСНБазисный 			= 0;
	Объект.КоэффициентКСПУСНТекущий 			= 0;
	Объект.КоэффициентКНРАЭСБазисный 			= 0;
	Объект.КоэффициентКНРАЭСТекущий 			= 0;
	Объект.КоэффициентКСПАЭСБазисный 			= 0;
	Объект.КоэффициентКСПАЭСТекущий 			= 0;
	Объект.ПоправочныйКоэффициентКНРБазисный 	= 0;
	Объект.ПоправочныйКоэффициентКНРТекущий 	= 0;
	Объект.ПоправочныйКоэффициентКСПБазисный 	= 0;
	Объект.ПоправочныйКоэффициентКСПТекущий 	= 0;
	
КонецПроцедуры

// Эрикос.zbikt 26.06.2014
// Добавляет запись в регистр СМ_ЗаменаМатериаловПозиции,
// или удаляет запись о ресурсе, в случае его удаления.
// Параметры:
//   ТаблицаЗамен - ТаблицаЗначений - Таблицап содержащая информацию о проводимых заменах.
//   ТекущийОбъект - ДокументОбъект.СМ_ПозицияЛокальнойСметы или данные формы (представление объекта) - текущая позиция.
//   ЛС - ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на локальную смету.
Процедура ДобавитьДвиженияВРегЗамен(ТаблицаЗамен, ТекущийОбъект, Смета)Экспорт
	
	Отбор = Новый Структура();
	Отбор.Вставить("Позиция",ТекущийОбъект.Ссылка);
	Отбор.Вставить("Смета",Смета.Ссылка);
	
	// ***************************************************
	// ++ AVV
	Отбор.Вставить("НовыйРесурс",ТаблицаЗамен.НовыйРесурс);
	// -- AVV
	// ***************************************************
	
	НаборЗаписей = РегистрыСведений.СМ_ЗаменаМатериаловПозиции.СоздатьНаборЗаписей();
	Для Каждого СтрокаОтбор Из Отбор Цикл 
		НаборЗаписей.Отбор[СтрокаОтбор.Ключ].Установить(СтрокаОтбор.Значение);
	КонецЦикла;
	НаборЗаписей.Прочитать();
	ТаблЗаменРесурса = НаборЗаписей.Выгрузить();
	НаборЗаписей.Очистить();
	Если ТаблицаЗамен.НовыйРесурс <> Неопределено Тогда
		
		ОтборРес = Новый Структура();
		ОтборРес.Вставить("ЗамененныйРесурс",ТаблицаЗамен.СтарыйРесурс);
		Массив = ТаблЗаменРесурса.НайтиСтроки(Отбор);
		Если Массив.Количество() > 0 Тогда
			// вообще, такое - это ошибка, поэтому сначала почистим
			Для Каждого СтрокаКУдалению Из Массив Цикл
				ТаблЗаменРесурса.Удалить(СтрокаКУдалению);	
			КонецЦикла;
		КонецЕсли;	
		
		СтрокаТаблицы 								= ТаблЗаменРесурса.Добавить();
		СтрокаТаблицы.Смета 						= Смета.Ссылка;
		СтрокаТаблицы.Позиция 						= ТекущийОбъект.Ссылка;
		СтрокаТаблицы.ЗамененныйРесурс 				= ТаблицаЗамен.СтарыйРесурс;
		СтрокаТаблицы.НормаРасходаСтарогоМатериала 	= ТаблицаЗамен.НормаРасходаСтарогоМатериала;
		СтрокаТаблицы.БазиснаяЦенаСтарогоМатериала 	= ТаблицаЗамен.БазиснаяЦенаСтарогоМатериала;
		СтрокаТаблицы.ТекущаяЦенаСтарогоМатериала 	= ТаблицаЗамен.ТекущаяЦенаСтарогоМатериала;
		СтрокаТаблицы.БазисЗарплМашСтарРесурс 		= ТаблицаЗамен.БазисЗарплМашСтарРесурс;
