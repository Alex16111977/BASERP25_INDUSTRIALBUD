			Если (Смета.МетодРасчета <> Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный) ИЛИ
				 (Смета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный И
				 (Смета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка И Смета.БезПримененияКоэффициентов) ИЛИ
