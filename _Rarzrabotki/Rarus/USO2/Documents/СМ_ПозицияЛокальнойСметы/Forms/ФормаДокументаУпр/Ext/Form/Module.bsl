&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.Свойства") Тогда
		МодульУправлениеСвойствамиКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеСвойствамиКлиент");
		МодульУправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Свойства") Тогда
		МодульУправлениеСвойствами = ОбщегоНазначения.ОбщийМодуль("УправлениеСвойствами");
		МодульУправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВоВсеПозицииРазделаНаСервере()
Запрос=Новый Запрос ("ВЫБРАТЬ
                     |	СМ_ПозицияЛокальнойСметы.Ссылка
                     |ИЗ
                     |	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
                     |ГДЕ
                     |	СМ_ПозицияЛокальнойСметы.ИДРодителя = &ИДРодителя
                     |	И СМ_ПозицияЛокальнойСметы.Ссылка <> &Ссылка");
запрос.УстановитьПараметр("ИДРодителя",Объект.ИДРодителя);
запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);

Рез=запрос.Выполнить().Выбрать();
Пока рез.Следующий() Цикл
	Об=Рез.Ссылка.ПолучитьОбъект();
	Об.ДополнительныеРеквизиты.очистить();
	Об.ДополнительныеРеквизиты.Загрузить(Объект.ДополнительныеРеквизиты.Выгрузить());
	Об.Записать();
КонецЦикла;

	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВоВсеПозицииРаздела(Команда)
	Если ЭтотОбъект.Модифицированность Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед установкой документ необходимо записать!");
		Возврат;
	КонецЕсли;	
	ДобавитьВоВсеПозицииРазделаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТекущиеПЗФакт()
	
	НоваяПЗ							= ТекущиеОЗФакт + ТекущиеЭМФакт + ТекущиеСМФакт;
	ТекущиеПЗФакт  					= НоваяПЗ;
	ТекущиеПЗФакт1 					= НоваяПЗ * ФактОбъем;
	ТекущаяЦенаФакт 				= НоваяПЗ;
	ТекущаяЗарплатаМашинистовФакт 	= ТекущиеЗМФакт;

КонецПроцедуры	

&НаКлиенте
Процедура РедактироватьФормулуАкта(ИмяРеквизита, ИмяРеквизитаФормулы)
	
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриЗакрытииФормыРедактированияФормулыАкта",ЭтаФорма, Новый Структура("ИмяРеквизита, ИмяРеквизитаФормулы",ИмяРеквизита,ИмяРеквизитаФормулы));
	ПараметрыФормы = Новый Структура("ЗначениеЗаполнения",Новый Структура("Формула",ИмяРеквизитаФормулы));
	ОткрытьФорму("ОбщаяФорма.СМ_РедакторФормулСмета",ПараметрыФормы,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

