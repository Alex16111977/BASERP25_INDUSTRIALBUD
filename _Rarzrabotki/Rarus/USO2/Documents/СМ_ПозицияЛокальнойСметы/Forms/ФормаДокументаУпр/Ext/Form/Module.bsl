&НаКлиенте
Процедура ПоправкиПозицииКоэффПЗПриИзменении(Элемент)
	НовПЗ = Число(Элемент.ТекстРедактирования);
	ТекДанные = Элементы.ПоправкиПозиции.ТекущиеДанные;
	
	Если НовПЗ <> 0 И (ТекДанные.КоэффОЗ <> 0 Или ТекДанные.КоэффСМ <> 0
		Или ТекДанные.КоэффЭМ <> 0 Или ТекДанные.КоэффЗМ <> 0
		Или ТекДанные.КоэффТР <> 0 Или ТекДанные.КоэффТМ <> 0) Тогда 
		ТекДанные.КоэффОЗ = 0;
		ТекДанные.КоэффСМ = 0;
		ТекДанные.КоэффЭМ = 0;
		ТекДанные.КоэффЗМ = 0;
		ТекДанные.КоэффТР = 0;
		ТекДанные.КоэффТМ = 0;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Если задан коэффициент к ПЗ, то к составляющим коэффициенты не задаются!'"));
	КонецЕсли;
КонецПроцедуры

