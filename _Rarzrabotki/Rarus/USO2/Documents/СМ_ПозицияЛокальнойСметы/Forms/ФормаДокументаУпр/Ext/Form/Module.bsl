	Элементы.ГруппаПоправкиПозиции.Заголовок 		= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Поправки по тех. частям%1'"), ?(Объект.ПоправкиПозиции.НайтиСтроки(Отбор).Количество(), "*", ""));
	Элементы.ГруппаНачисленияПозиции.Заголовок 		= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Начисления%1'"			   ), ?(Объект.НачисленияПозиции.Итог("Значение") = Объект.НачисленияПозиции.Итог("СтандартноеЗначение"), "", "*"));
	Элементы.ГруппаКоэффициентыПересчета.Заголовок 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Коэффициенты пересчета%1'" ), ?((Объект.КоэффициентыПересчета.Количество()) ИЛИ (КоэффициентыПересчетаАкта.Количество()), "*", ""));
	
