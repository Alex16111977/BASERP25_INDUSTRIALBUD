	// Sudav - ГруппаРесурсыПозицииЛокальнойСметы.
	Если Параметры.РедактированиеЦен Тогда
		Элементы.РесурсыПозицииЛокальнойСметыКонтекстноеМеню.Доступность = Ложь;
		ДоступностьПодчиненных(Элементы.РесурсыПозицииЛокальнойСметыКонтекстноеМеню.ПодчиненныеЭлементы,Ложь);
		ДоступностьПодчиненных(Элементы.РесурсыПозицииЛокальнойСметыКоманднаяПанель.ПодчиненныеЭлементы,Ложь);
		Элементы.РесурсыПозицииЛокальнойСметыРасчетПоБазису.Доступность = Истина;
		Элементы.РесурсыПозицииЛокальнойСметыРасчетПоТек.Доступность = Истина;
		ПросмотрПодчиненных(Элементы.РесурсыПозицииЛокальнойСметы.ПодчиненныеЭлементы,Истина);
		Элементы.РесурсыПозицииЛокальнойСметыБазиснаяЦена.ТолькоПросмотр = Ложь;
		Элементы.РесурсыПозицииЛокальнойСметыТекущаяЦена.ТолькоПросмотр = Ложь;
		Элементы.РесурсыПозицииЛокальнойСметы.ИзменятьСоставСтрок = Ложь;
	Иначе
		Элементы.РесурсыПозицииЛокальнойСметы.ТолькоПросмотр = СуществуютАкты;
		Элементы.РесурсыПозицииЛокальнойСметыКонтекстноеМеню.Доступность = Не (СуществуютАкты);
		Элементы.РесурсыПозицииЛокальнойСметыКоманднаяПанель.Доступность = Не (СуществуютАкты);
		Элементы.РесурсыПозицииЛокальнойСметы.Доступность = Не (Параметры.ПозицияАкта);
