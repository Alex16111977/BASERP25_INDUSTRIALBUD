			Если МассивРесурсов.Количество() = 0  Тогда
				Элементы.ГруппаСтраницТекФакт.ПодчиненныеЭлементы.ТекущиеРеквизитамиФакт.Доступность = Истина;
			Иначе
				Элементы.ГруппаСтраницТекФакт.ПодчиненныеЭлементы.ТекущиеРеквизитамиФакт.Доступность = Ложь;
			КонецЕсли;
		Иначе
			Элементы.ГруппаСтраницТекФакт.Видимость = Ложь;
			Элементы.ГруппаСтраницТек.Видимость = ЭтоРабота;
			Элементы.ГруппаСтраницТек.Доступность = ЭтоРабота; 
			МассивРесурсов = Объект.РесурсыПозицииЛокальнойСметы.НайтиСтроки(Новый Структура("Удален",Ложь));
			Если МассивРесурсов.Количество() = 0 И СтруктураПараметровРасчетаЛС.ЭтоРесурсныйМетод Тогда
				Элементы.ГруппаСтраницТек.ТекущаяСтраница = Элементы.ГруппаСтраницТек.ПодчиненныеЭлементы.ТекущиеРеквизитами;
			Иначе
				Элементы.ГруппаСтраницТек.ТекущаяСтраница = Элементы.ГруппаСтраницТек.ПодчиненныеЭлементы.ТекущиеРегистром;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// Доступность индексов от метода применения индекса и для позиций только с ПЗ.
	Если Элементы.ГруппаКоэффициентыПересчета.Видимость = Истина И Элементы.ГруппаКоэффициентыПересчета.Доступность = Истина Тогда
		ВидимостьИндексовПересчета();
	КонецЕсли;	

	// sudav - панель формы
	Элементы.ФормаОбновитьПоНормативнойБазе.Видимость =  (Не Параметры.РедактированиеЦен) И (Не СуществуютАкты) И ((ЗначениеЗаполнено(Объект.РегиональнаяБаза)) И (Объект.ТипНормативныхСборников <> ПредопределенноеЗначение("Перечисление.СМ_ТипыНормативныхСборников.Калькуляция")));
	Элементы.ФормаОбновитьПоНормативнойБазе.Доступность = (Не Параметры.РедактированиеЦен) И (Не СуществуютАкты) И ((ЗначениеЗаполнено(Объект.РегиональнаяБаза)) И (Объект.ТипНормативныхСборников <> ПредопределенноеЗначение("Перечисление.СМ_ТипыНормативныхСборников.Калькуляция")));
	Элементы.ФормаПерейтиКНормативнымДанным.Видимость = ((ЗначениеЗаполнено(Объект.РегиональнаяБаза)) И (Объект.ТипНормативныхСборников <> ПредопределенноеЗначение("Перечисление.СМ_ТипыНормативныхСборников.Калькуляция")) И ЗначениеЗаполнено(Объект.ШифрРасценки));
	Элементы.ФормаПерейтиКНормативнымДанным.Доступность = ((ЗначениеЗаполнено(Объект.РегиональнаяБаза)) И (Объект.ТипНормативныхСборников <> ПредопределенноеЗначение("Перечисление.СМ_ТипыНормативныхСборников.Калькуляция")) И ЗначениеЗаполнено(Объект.ШифрРасценки));
	
	// Кнопка "Тех. часть"
	ВидимостьКнопкиТехчасть();
	
	Если (СуществуютАкты И (Не Параметры.ПозицияАкта)) Тогда
		ПоказатьПредупреждениеНаФорме(НСтр("ru='Существуют акты, введенные по данной смете. Позиция не может быть отредактирована!'"));
	КонецЕсли;
		
	ПозицияВладелецТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Привязана к позиции №%1'"), СМ_СметаКлиент.ПолучитьТекстИнформацииОПозиции(Объект.ИДПозицииВладельца));
	ПозицияКорректируемая = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Корректируемая позиция №%1'"), СМ_СметаКлиент.ПолучитьТекстИнформацииОПозиции(Объект.КорректируетПозицию));
	
	Если Параметры.ПозицияАкта Тогда
		Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Позиция №%1 %2'"), ПорНомер, СМ_СметаКлиент.ПолучитьТекстИнформацииОбАкте(Параметры.Акт, СтруктураПараметровРасчетаЛС, НСтр("ru='акта выполненных работ'")));
	Иначе
		Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Позиция №%1 %2'"), ПорНомер, СМ_СметаКлиент.ПолучитьТекстИнформацииОСмете(Объект, СтруктураПараметровРасчетаЛС, НСтр("ru='локальной сметы'")));                    
	КонецЕсли;
	
	ОпределитьВидимостьИтогов();
	
	ОпределитьЗаголовкиСтраниц();
	
	Если СметнаяКомпонента = Неопределено Тогда
		Элементы.ФормаОбновитьПоНормативнойБазе.Видимость = Ложь;
		Элементы.ФормаОткрытьТехЧасть.Видимость = Ложь;
		Элементы.ФормаПерейтиКНормативнымДанным.Видимость = Ложь;
		Элементы.РесурсыПозицииЛокальнойСметыДобавитьПлюсМинусВНБ.Видимость = Ложь;
	КонецЕсли;
	
	МассивРесурсов = Объект.РесурсыПозицииЛокальнойСметы.НайтиСтроки(Новый Структура("Удален",Ложь));
	Если МассивРесурсов.Количество() = 0 И СтруктураПараметровРасчетаЛС.ЭтоРесурсныйМетод Тогда
		Элементы.ГруппаСтраницТек.ТекущаяСтраница = Элементы.ГруппаСтраницТек.ПодчиненныеЭлементы.ТекущиеРеквизитами;
	Иначе
		Элементы.ГруппаСтраницТек.ТекущаяСтраница = Элементы.ГруппаСтраницТек.ПодчиненныеЭлементы.ТекущиеРегистром;
	КонецЕсли;
	
	Если ТолькоПросмотрФормы ИЛИ Параметры.СтатусРедактирования > 0 Тогда
		Для Каждого Элем Из ЭтаФорма.Элементы Цикл
			Если ТипЗнч(Элем) = Тип("ДекорацияФормы") ИЛИ ТипЗнч(Элем) = Тип("ДополнениеЭлементаФормы") ИЛИ Элем = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(Элем) = Тип("КнопкаФормы") Тогда
				Элем.Доступность = Ложь;
			Иначе
				Элем.ТолькоПросмотр = Истина;
			КонецЕсли;
		КонецЦикла;
		// ДокторСофт
		ЭтаФорма.КоманднаяПанель.Доступность = Ложь;
	КонецЕсли;
	
	Элементы.СтатусРесурса.Видимость = (ЭтоМатериал(Объект.Определитель) ИЛИ ЭтоОборудование(Объект.Определитель));
	Элементы.НеИзменятьЦены.Видимость = (ЭтоМатериал(Объект.Определитель) ИЛИ ЭтоОборудование(Объект.Определитель));
	
	// Видимость реквизитов "НормаРасхода" и "Количество ресурса"
	Элементы.ГруппаНормаРасхода.Видимость = (ЭтоМатериал(Объект.Определитель) ИЛИ ЭтоОборудование(Объект.Определитель));

	Если Параметры.СтатусРедактирования = 2 Тогда
		Элементы.ГруппаСтраницы.ТолькоПросмотр = Ложь;
		Элементы.СтраницаОсновное.ТолькоПросмотр = Ложь;
		Элементы.ГруппаПорядковыйНомерШифрВерсияРасчетОтмеченаВДереве.ТолькоПросмотр = Ложь;
		Элементы.Расчет.ТолькоПросмотр = Ложь;
	ИначеЕсли Параметры.СтатусРедактирования = 1 Тогда
		Элементы.ГруппаСтраницы.ТолькоПросмотр = Ложь;
		Элементы.СтраницаОсновное.ТолькоПросмотр = Ложь;
		ПросмотрПодчиненных(Элементы.СтраницаОсновное.ПодчиненныеЭлементы,Истина);
		Элементы.ГруппаОбъемРаботФормулаОбъемаФакт.ТолькоПросмотр = Ложь;
		Элементы.ГруппаОбъемРаботФормулаОбъема.ТолькоПросмотр = Ложь;
		Элементы.ФактОбъем.ТолькоПросмотр = Ложь;
		Элементы.ОбъемРабот.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	// Видимость кнопок перехода в справочник ресурсы
	Если ЭтоМатериал(Объект.Определитель) ИЛИ ЭтоОборудование(Объект.Определитель) Тогда
		Элементы.ФормаПерейтиВСправочникРесурсы.Видимость = Истина;	
		// ********************************************************************
		// ++ AVV Ошибки учета ресурсов акта.
		// Для позиций-ресурсов закрыт доступ к редактированию поправок.
		Элементы.ГруппаПоправкиПозиции.ТолькоПросмотр 						= Истина;
		Элементы.ПоправкиПозицииОбновитьПоправки.Доступность 				= Ложь;
		Элементы.ПоправкиПозицииДобавитьСобственную.Доступность				= Ложь;
		Элементы.ПоправкиПозицииДобавитьПоправкуИзСправочника.Доступность 	= Ложь;
		// -- AVV
		// ********************************************************************
	Иначе
		// ********************************************************************
		// ++ AVV Ошибки учета ресурсов акта.
		Элементы.ГруппаПоправкиПозиции.ТолькоПросмотр 						= Ложь;
		Элементы.ПоправкиПозицииОбновитьПоправки.Доступность 				= Истина;
		Элементы.ПоправкиПозицииДобавитьСобственную.Доступность				= Истина;
		Элементы.ПоправкиПозицииДобавитьПоправкуИзСправочника.Доступность 	= Истина;
		// -- AVV
		// ********************************************************************
		Элементы.ФормаПерейтиВСправочникРесурсы.Видимость 	= Ложь;		
	КонецЕсли;	
	
	Если ЭтоРабота(Объект.Определитель,Объект.ТипНормативныхСборников) Тогда
		Элементы.РесурсыПозицииЛокальнойСметыПерейтиВСправочникРесурсыРаб.Видимость = Истина;
		Элементы.РесурсыПозицииЛокальнойСметыКонтекстноеМенюПерейтиВСправочникРесурсыРаб.Видимость = Истина;
	Иначе
		Элементы.РесурсыПозицииЛокальнойСметыПерейтиВСправочникРесурсыРаб.Видимость = Ложь;
		Элементы.РесурсыПозицииЛокальнойСметыКонтекстноеМенюПерейтиВСправочникРесурсыРаб.Видимость = Ложь;
	КонецЕсли;

	// ********************************************************************
	// Не удалять 
	// Видимость кнопки установки цвета, при открытии формы позиции из акта
	//Если Параметры.Свойство("ПозицияАкта") Тогда
	//	Если Параметры.ПозицияАкта Тогда
	//		Элементы.ФормаГруппаПалитраЦветов.Доступность 		= Истина;
	//		Элементы.ФормаГруппаПалитраЦветов.ТолькоПросмотр 	= Ложь;
	//		ЭтаФорма.КоманднаяПанель.Доступность 				= Истина;
	//		Для Каждого ТекКнопка Из Элементы.ФормаГруппаПалитраЦветов.ПодчиненныеЭлементы Цикл
	//			ТекКнопка.Доступность = Истина;
	//		КонецЦикла;
	//	КонецЕсли;
	//КонецЕсли;
	// ********************************************************************
		
	// *********************************************
	// ++ AVV Роли в системе
	//Если ЭтоСметчик ИЛИ ЭтоСметчикМатериалы Тогда
	//	Элементы.ШифрРасценки.Доступность 									= Ложь;
	//	Элементы.Наименование.Доступность                               	= Ложь;
	//	Элементы.ТипНормативныхСборников.Доступность                    	= Ложь;
	//	Элементы.Определитель.Доступность                              	 	= Ложь;
	//	Элементы.ЕдиницаИзмерения.Доступность                           	= Ложь;
	//	Элементы.РесурсыПозицииЛокальнойСметыДобавитьЗаРасценку.Доступность = Ложь;
	//	Элементы.РесурсыПозицииЛокальнойСметыВычестьЗаРасценку.Доступность  = Ложь;
	//	Элементы.РесурсыПозицииЛокальнойСметыДобавитьПлюсМинус.Доступность  = Ложь;
	//	Если НЕ ЭтоСметчикМатериалы Тогда
	//		Элементы.РесурсыПозицииЛокальнойСметыБазиснаяЦена.Доступность  	= Ложь;
	//		Элементы.РесурсыПозицииЛокальнойСметыТекущаяЦена.Доступность 	= Ложь;
	//	КонецЕсли;
	//КонецЕсли;
	// -- AVV Роли в системе
	// *********************************************	
	
КонецПроцедуры	

&НаКлиенте
Процедура ДоступностьПодчиненных(СМ_ПодчиненныеЭлементы,ДоступностьЭлемента)
	Для каждого ПодчЭлем Из СМ_ПодчиненныеЭлементы Цикл
		ПодчЭлем.Доступность = ДоступностьЭлемента;
		Если ТипЗнч(ПодчЭлем) = Тип("ГруппаФормы") ИЛИ ТипЗнч(ПодчЭлем) = Тип("СтраницаФормы") Тогда
			ДоступностьПодчиненных(ПодчЭлем.ПодчиненныеЭлементы,ДоступностьЭлемента);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПросмотрПодчиненных(СМ_ПодчиненныеЭлементы,Просмотр)
	Для каждого ПодчЭлем Из СМ_ПодчиненныеЭлементы Цикл
		
		Если ТипЗнч(ПодчЭлем) = Тип("ДекорацияФормы")
			ИЛИ ТипЗнч(ПодчЭлем) = Тип("КнопкаФормы")
			ИЛИ ТипЗнч(ПодчЭлем) = Тип("ДополнениеЭлементаФормы")
			ИЛИ ПодчЭлем = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПодчЭлем.ТолькоПросмотр = Просмотр;
		Если ТипЗнч(ПодчЭлем) = Тип("ГруппаФормы") ИЛИ ТипЗнч(ПодчЭлем) = Тип("СтраницаФормы") Тогда
			ПросмотрПодчиненных(ПодчЭлем.ПодчиненныеЭлементы,Просмотр);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьИндексовПересчета()
	Если СтруктураПараметровРасчетаЛС.ЭтоИндексыПоЭлементам Тогда
		Если Объект.Оборудование + Объект.ОснЗарплата + Объект.СтоимМатериалов + Объект.ЭксплМашин = 0 И Объект.ПрямЗатраты <> 0 Тогда
			Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаКоэффПолнСтоимРабот.Видимость		 = Истина;
			Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаКоэффОборуд.Видимость				 = Ложь;
			Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаКоэффОснЗарплаты.Видимость			 = Ложь;
			Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаКоэффСтоимЗарплатеМашин.Видимость	 = Ложь;
			Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаКоэффСтоимМатериалов.Видимость		 = Ложь;
			Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаКоэффСтоимЭксплМашин.Видимость		 = Ложь;
			Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаВариантПересчетаЭММ.Видимость		 = Ложь;	
			Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаАкта.ПодчиненныеЭлементы.КоэффициентыПересчетаАктаВариантПересчетаЭММ.Видимость = Ложь;
			Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаАкта.ПодчиненныеЭлементы.КоэффициентыПересчетаАктаКоэффПолнСтоимРабот.Видимость = Истина;
			Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаАкта.ПодчиненныеЭлементы.КоэффициентыПересчетаАктаКоэффОборуд.Видимость		 = Ложь;
			Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаАкта.ПодчиненныеЭлементы.КоэффициентыПересчетаАктаКоэффОснЗарплаты.Видимость	 = Ложь;
			Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаАкта.ПодчиненныеЭлементы.КоэффициентыПересчетаАктаКоэффСтоимЗарплатеМашин.Видимость = Ложь;
			Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаАкта.ПодчиненныеЭлементы.КоэффициентыПересчетаАктаКоэффСтоимМатериалов.Видимость = Ложь;
			Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаАкта.ПодчиненныеЭлементы.КоэффициентыПересчетаАктаКоэффСтоимЭксплМашин.Видимость = Ложь;
		Иначе
			Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаКоэффПолнСтоимРабот.Видимость		  = Ложь;
			Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаАкта.ПодчиненныеЭлементы.КоэффициентыПересчетаАктаКоэффПолнСтоимРабот.Видимость = Ложь;
		КонецЕсли;
	Иначе
		Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаКоэффПолнСтоимРабот.Видимость 			= Истина;
		Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаКоэффОборуд.Видимость					= Ложь;
		Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаКоэффОснЗарплаты.Видимость 				= Ложь;
		Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаКоэффСтоимЗарплатеМашин.Видимость		= Ложь;
		Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаКоэффСтоимМатериалов.Видимость			= Ложь;
		Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаКоэффСтоимЭксплМашин.Видимость			= Ложь;
		Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаВариантПересчетаЭММ.Видимость 			= Ложь;	
		Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаАкта.ПодчиненныеЭлементы.КоэффициентыПересчетаАктаКоэффПолнСтоимРабот.Видимость	= Истина;
		Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаАкта.ПодчиненныеЭлементы.КоэффициентыПересчетаАктаКоэффОборуд.Видимость 			= Ложь;
		Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаАкта.ПодчиненныеЭлементы.КоэффициентыПересчетаАктаКоэффОснЗарплаты.Видимость 		= Ложь;
		Элементы.ГруппаКоэффициентыПересчета.ПодчиненныеЭлементы.КоэффициентыПересчетаАкта.ПодчиненныеЭлементы.КоэффициентыПересчетаАктаКоэффСтоимЗарплатеМашин.Видимость = Ложь;
