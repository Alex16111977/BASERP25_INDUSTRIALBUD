// Эрикос.zbikt 04.06.2014
// Осуществляет действия после закрытия формы выбора поправок.
// Параметры:
//   Результат - выбранная поправка
//   Параметры - Структура - дополнительные параметры переданные при формировании вопроса пользователю.
&НаКлиенте
Процедура ПриЗакрытииФормыВыбораПоправок(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("СправочникСсылка.СМ_ПоправкиПоТехническимЧастям") Тогда
		СтруктураПопр = Новый СписокЗначений;
		СтруктураПопр.Добавить(Результат);
		ДобавитьПоправкуИзСправочникаНаСервере(СтруктураПопр);
		ТекДанные = Объект.ПоправкиПозиции.Добавить();
		Для Сч = 1 По СтруктураПопр.Количество() - 1 Цикл
			Представление 			= СтруктураПопр.Получить(Сч).Представление;
			Значение 				= СтруктураПопр.Получить(Сч).Значение;
			ТекДанные.Применить 	= Истина;
			Если Представление = "УсловияПрименения" Тогда
				ТекДанные.УсловияПрименения = Значение;
			ИначеЕсли Представление = "Обоснование" Тогда
				ТекДанные.Обоснование = Значение;
			ИначеЕсли Представление = "КоэффициентКОсновнойЗарплате" Тогда
				ТекДанные.КоэффОЗ = Значение;
			ИначеЕсли Представление = "КоэффициентКЭксплуатацииМашин" Тогда
				ТекДанные.КоэффЭМ = Значение;
			ИначеЕсли Представление = "КоэффициентКЗарплатеМашинистов" Тогда
				ТекДанные.КоэффЗМ = Значение;
			ИначеЕсли Представление = "КоэффициентКСтоимостиМатериалов" Тогда
				ТекДанные.КоэффСМ = Значение;
			ИначеЕсли Представление = "КоэффициентКТрудозатратамРабочих" Тогда
				ТекДанные.КоэффТР = Значение;
			ИначеЕсли Представление = "КоэффициентКТрудозатратамМашинистов" Тогда
				ТекДанные.КоэффТМ = Значение;
			ИначеЕсли Представление = "ДобавитьКПрямымЗатратам" Тогда
				ТекДанные.ДобавПЗ = Значение;
			ИначеЕсли Представление = "ДобавитьКОсновнойЗарплате" Тогда
				ТекДанные.ДобавОЗ = Значение;
			ИначеЕсли Представление = "ДобавитьКЭксплуатацииМашин" Тогда
				ТекДанные.ДобавЭМ = Значение;
			ИначеЕсли Представление = "ДобавитьКЗарплатеМашинистов" Тогда
				ТекДанные.ДобавЗМ = Значение;
			ИначеЕсли Представление = "ДобавитьКСтоимостиМатериалов" Тогда
				ТекДанные.ДобавСМ = Значение;
			ИначеЕсли Представление = "ДобавитьКТрудозатратамРабочих" Тогда
				ТекДанные.ДобавТР = Значение;
			ИначеЕсли Представление = "ДобавитьКТрудозатратам" Тогда
				ТекДанные.ДобавТ = Значение;
			ИначеЕсли Представление = "Справка" Тогда
				ТекДанные.Справка = Значение;
			ИначеЕсли Представление = "ТипПоправки" Тогда
				ТекДанные.ТипПоправки = Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Эрикос.zbikt 04.06.2014
&НаСервереБезКонтекста
Процедура ДобавитьПоправкуИзСправочникаНаСервере(СтруктураПопр)
	// Вставить содержимое обработчика.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПоправкиПоТехническимЧастям.УсловияПрименения КАК УсловияПрименения,
	|	ПоправкиПоТехническимЧастям.Обоснование КАК Обоснование,
	|	ПоправкиПоТехническимЧастям.КоэффициентКОсновнойЗарплате КАК КоэффициентКОсновнойЗарплате,
	|	ПоправкиПоТехническимЧастям.КоэффициентКЭксплуатацииМашин КАК КоэффициентКЭксплуатацииМашин,
	|	ПоправкиПоТехническимЧастям.КоэффициентКЗарплатеМашинистов КАК КоэффициентКЗарплатеМашинистов,
	|	ПоправкиПоТехническимЧастям.КоэффициентКСтоимостиМатериалов КАК КоэффициентКСтоимостиМатериалов,
	|	ПоправкиПоТехническимЧастям.КоэффициентКТрудозатратамРабочих КАК КоэффициентКТрудозатратамРабочих,
	|	ПоправкиПоТехническимЧастям.КоэффициентКТрудозатратамМашинистов КАК КоэффициентКТрудозатратамМашинистов,
	|	ПоправкиПоТехническимЧастям.ДобавитьКПрямымЗатратам КАК ДобавитьКПрямымЗатратам,
	|	ПоправкиПоТехническимЧастям.ДобавитьКОсновнойЗарплате КАК ДобавитьКОсновнойЗарплате,
	|	ПоправкиПоТехническимЧастям.ДобавитьКЭксплуатацииМашин КАК ДобавитьКЭксплуатацииМашин,
	|	ПоправкиПоТехническимЧастям.ДобавитьКЗарплатеМашинистов КАК ДобавитьКЗарплатеМашинистов,
	|	ПоправкиПоТехническимЧастям.ДобавитьКСтоимостиМатериалов КАК ДобавитьКСтоимостиМатериалов,
	|	ПоправкиПоТехническимЧастям.ДобавитьКТрудозатратамРабочих КАК ДобавитьКТрудозатратамРабочих,
	|	ПоправкиПоТехническимЧастям.ДобавитьКТрудозатратам КАК ДобавитьКТрудозатратам,
	|	ПоправкиПоТехническимЧастям.ТипПоправки КАК ТипПоправки,
	|	ПоправкиПоТехническимЧастям.Справка КАК Справка
	|ИЗ
	|	Справочник.СМ_ПоправкиПоТехническимЧастям КАК ПоправкиПоТехническимЧастям
	|ГДЕ
	|	ПоправкиПоТехническимЧастям.Ссылка = &Ссылка";
	ТекПопр = СтруктураПопр.Получить(0);				   
	Запрос.УстановитьПараметр("Ссылка",ТекПопр.Значение);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Инд = 0;
	Для Каждого СтрЗнач Из РезультатЗапроса Цикл
		Для каждого колонка Из РезультатЗапроса.Колонки Цикл
			Наим = Колонка.Имя;
			СтруктураПопр.Добавить(СтрЗнач.Получить(Инд),Колонка.Имя);
			Инд = Инд +1;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Эрикос.zbikt 04.06.2014
&НаКлиенте
Процедура ДобавитьПоправкуИзСправочника(Команда)
	// Докторсофт
	НомерСборника = СМ_СметаВызовСервера.ОпределитьНомерСборника(Объект.ТипНормативныхСборников,Объект.ШифрРасценки);
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ТипНормативногоСборника",Объект.ТипНормативныхСборников);
	ПараметрыФормы.Вставить("СметноНормативнаяБаза",Объект.РегиональнаяБаза);
	ПараметрыФормы.Вставить("НомерСборника",НомерСборника);
	ПараметрыФормы.Вставить("ТекущаяСтрока",НайтиПоправку(НомерСборника));
	ОписаниеОЗакрытииФормыВыбораПоправок = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораПоправок",ЭтаФорма, );
	ОткрытьФорму("Справочник.СМ_ПоправкиПоТехническимЧастям.Форма.ФормаВыбора",ПараметрыФормы,ЭтаФорма,,,,ОписаниеОЗакрытииФормыВыбораПоправок,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
    // Докторсофт
КонецПроцедуры
// Эрикос.zbikt 06.06.2014

// Докторсофт
&НаСервере
Функция НайтиПоправку(НомерСборника)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СправочникСМ_ПоправкиПоТехническимЧастям.Ссылка,
	               |	СправочникСМ_ПоправкиПоТехническимЧастям.Наименование КАК Обоснование,
	               |	ВЫБОР
	               |		КОГДА ВЫБОР
	               |					КОГДА &ОтборНомера
	               |						ТОГДА СправочникСМ_ПоправкиПоТехническимЧастям.НомерСборника = &НомерСборника
	               |					ИНАЧЕ ИСТИНА
	               |				КОНЕЦ
	               |				И ВЫБОР
	               |					КОГДА &ОтборТНС
	               |						ТОГДА СправочникСМ_ПоправкиПоТехническимЧастям.СметноНормативнаяБаза = &СметноНормативнаяБаза
	               |					ИНАЧЕ ИСТИНА
	               |				КОНЕЦ
	               |				И СправочникСМ_ПоправкиПоТехническимЧастям.ТипНормативногоСборника = &ТипНормативногоСборника
	               |				И СправочникСМ_ПоправкиПоТехническимЧастям.ЭтоГруппа = ЛОЖЬ
	               |			ТОГДА 0
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК Порядок
	               |ИЗ
	               |	Справочник.СМ_ПоправкиПоТехническимЧастям КАК СправочникСМ_ПоправкиПоТехническимЧастям
	               |ГДЕ
	               |	СправочникСМ_ПоправкиПоТехническимЧастям.ЭтоГруппа = ЛОЖЬ
	               |	И ВЫБОР
	               |			КОГДА &ОтборНомера
	               |				ТОГДА СправочникСМ_ПоправкиПоТехническимЧастям.НомерСборника = &НомерСборника
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ОтборТНС
	               |				ТОГДА СправочникСМ_ПоправкиПоТехническимЧастям.СметноНормативнаяБаза = &СметноНормативнаяБаза
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И СправочникСМ_ПоправкиПоТехническимЧастям.ТипНормативногоСборника = &ТипНормативногоСборника
	               |			И СправочникСМ_ПоправкиПоТехническимЧастям.ЭтоГруппа = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Порядок,
	               |	Обоснование";
				  
	НеОтбирать = Истина;
	Запрос.УстановитьПараметр("НомерСборника",НомерСборника); 
	Запрос.УстановитьПараметр("ОтборНомера",?(НомерСборника=0,Ложь,Истина));
	Запрос.УстановитьПараметр("ТипНормативногоСборника",Объект.ТипНормативныхСборников); 
	Запрос.УстановитьПараметр("ОтборТНС",ЗначениеЗаполнено(Объект.ТипНормативныхСборников));
	НеОтбирать = Не ЗначениеЗаполнено(Объект.РегиональнаяБаза);
	Запрос.УстановитьПараметр("СметноНормативнаяБаза",Объект.РегиональнаяБаза); 
	Если НеОтбирать Тогда
		Возврат Неопределено;
	Иначе
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		Иначе
			Возврат Неопределено;
		КонецЕсли;	
	КонецЕсли;
КонецФункции
