// Процедура осуществляет действия после подтверждения пользователем обновления позиции.
// ПАРАМЕТРЫ:
//// Ответ - ответ пользователя на диалог.
//// ДополнительныеПараметры - дополнительные параметры переданные при формировании вопроса пользователю.
&НаКлиенте
Процедура ОбновитьПоНормативнойБазеОповещение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	СтарыйШифрРасценки = Неопределено;
	ЗаменаКода = Ложь;
	Если ДополнительныеПараметры.Количество() <> 0 Тогда
		СтарыйШифрРасценки = ДополнительныеПараметры.СтарыйШифр;
		ЗаменаКода = Истина;
	КонецЕсли;	
	Записать();
	
	СМ_СметаКлиент.ОбновитьПоНормативнойБазе(Объект.Ссылка, , ЗаменаКода);
	Если СтарыйШифрРасценки <> Неопределено Тогда
		Если ЗаменаКода = Ложь Тогда
			Объект.ШифрРасценки = СтарыйШифрРасценки;
			ЗаписатьОбъект();
		КонецЕсли;	
	КонецЕсли;	
		
	ЭтаФорма.Прочитать();
			
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоНормативнойБазе(Команда)
	
	Если СметнаяКомпонента = Неопределено Тогда
		ПоказатьПредупреждение(,НСтр("ru='Сметная компонента не подключена'"));
	Иначе
		Если (Не ЗначениеЗаполнено(Объект.РегиональнаяБаза))
			ИЛИ (Объект.ТипНормативныхСборников = ПредопределенноеЗначение("Перечисление.СМ_ТипыНормативныхСборников.Калькуляция")) Тогда
			Возврат;
		КонецЕсли;
		
		ОбновитьПоНормативнойБазеОповещение(КодВозвратаДиалога.Да, Новый Структура());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКНормативнымДанным(Команда)
	
	Если СметнаяКомпонента = Неопределено Тогда
		ПоказатьПредупреждение(,НСтр("ru='Сметная компонента не подключена'"));
	Иначе
		Если (Не ЗначениеЗаполнено(Объект.РегиональнаяБаза)) 
			ИЛИ (Объект.ТипНормативныхСборников = ПредопределенноеЗначение("Перечисление.СМ_ТипыНормативныхСборников.Калькуляция")) Тогда
			Возврат;
		КонецЕсли;
		
		Если (СокрЛП(Объект.ШифрРасценки) = "")
			Или (Не ЗначениеЗаполнено(Объект.ТипНормативныхСборников)) Тогда
			Возврат;
		КонецЕсли;
		
		ИдФормы = СметнаяКомпонента.ПоказатьОкноНорм(Строка(СтруктураПараметровРасчетаЛС.КодРайона),Строка(СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Объект.РегиональнаяБаза,"Код")),СМ_СметаЗагрузкаВызовСервера.ОпределитьКодТипаСборника(Объект.ТипНормативныхСборников),СокрЛП(Объект.ШифрРасценки));
		ВариантВыбораВНБ = "ВНБ"+ИдФормы;
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура НеХватаетМатериаловВКаталоге(Команда)
	Если Не ЗначениеЗаполнено(Объект.Ссылка)или ЭтаФорма.Модифицированность Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуЗаявкиНаМатериалыДиалог", ЭтаФорма, Новый Структура);
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru='Для создания заявки акт будет записан. Продолжить?'"), РежимДиалогаВопрос.ДаНет,0,,"Внимание");	
	Иначе
		ОткрытьФормуЗаявкиНаМатериалы();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиВСправочникРесурсы(Команда)
	
	НайденныйРесурс = НайтиРесурсПоКоду(Объект.ШифрРасценки); 
	ОткрытьФормуРесурса(НайденныйРесурс);

КонецПроцедуры

&НаКлиенте
Процедура ПерейтиВСправочникРесурсыРаб(Команда)
	
	ТекДанные = Элементы.РесурсыПозицииЛокальнойСметы.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
