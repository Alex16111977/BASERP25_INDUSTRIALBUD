
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	 
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	Позиция = РеквизитФормыВЗначение("Объект");

	Если Объект.Ссылка.Пустая() Тогда
		
		Если ЭтаФорма.Параметры.Свойство("Родитель") Тогда
			СМ_СметаВызовСервера.ЗаполнитьДанныеДокументаВСтруктуреСмет(Объект, Параметры.Родитель);
		КонецЕсли;	
	
		Если ЭтаФорма.Параметры.Свойство("ЛокальнаяСмета") Тогда
			СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(Параметры.ЛокальнаяСмета,Позиция);
		Иначе
			Если ЗначениеЗаполнено(Позиция.ИДРодителя) Тогда
				СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(,Позиция);
			КонецЕсли;
		КонецЕсли;
		
		Если Параметры.Свойство("СпособСоздания") Тогда
			Объект.СпособСоздания = Параметры.СпособСоздания;
		КонецЕсли;
		
		Если НЕ Объект.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.Калькуляция Тогда
			Документы.СМ_ПозицияЛокальнойСметы.ЗаполнитьНачисленияПозицииПоУмолчанию(Объект);
		КонецЕсли;
		
		ЗаполнитьНастройкиПозицииПоУмолчанию();
		
	Иначе
		
		ОбновитьЗначенияПоАкту();
		СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(Объект.ИДСметы,Позиция);
		ЗагрузитьДвиженияВТаблицы();
		
	КонецЕсли;
	
	ЭтоРабота = ЭтоРабота(Объект.Определитель,Объект.ТипНормативныхСборников);
	ТолькоПросмотрФормы = СМ_СметаВызовСервера.РольТолькоПросмотр();
	
	СуществуютАкты = СМ_УчетВыполненныхРаботСервер.СуществуютАктыПоСмете(Объект.ИДСметы) И Параметры.ЕстьАкт И Параметры.СтатусРедактирования>0;
	
	ВводОбъемовВБазовыхЕдИзм = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ВводОбъемовВБазовыхЕдИзм");
	
	ЗаполнитьСтандартноеЗначениеЧПИКартинкиРесурса();
	
	РасчитатьСтоимостьНаОбъем();
	
	Если ЭтоРабота = "Нет" Тогда
		Если Объект.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал Тогда
			БазиснаяЦена = Объект.СтоимМатериалов;
		Иначе
			БазиснаяЦена = Объект.Оборудование;
		КонецЕсли;	
	КонецЕсли;	
	
	МассивРесурсов = Объект.РесурсыПозицииЛокальнойСметы.НайтиСтроки(Новый Структура("Удален",Ложь));
	Если Не Объект.Ссылка.Пустая()
		И МассивРесурсов.Количество() > 0
		И СтруктураПараметровРасчетаЛС.ЭтоРесурсныйМетод Тогда
		РасчитатьТекСтоимостьНаОбъемРегистр();
		РасчитатьТекСтоимостьНаОбъем();
	Иначе
		РасчитатьТекСтоимостьНаОбъем();
	КонецЕсли;

	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Свойства") Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "СтраницаДополнительныеРеквизиты");
		ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Ложь);
		МодульУправлениеСвойствами = ОбщегоНазначения.ОбщийМодуль("УправлениеСвойствами");
		МодульУправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	КонецЕсли;
	
	ЭтоСметчик = Ложь;
	Если РольДоступна("СМ_Сметчик") Тогда
		ЭтоСметчик = Истина;
	КонецЕсли;	
	
	ЭтоСметчикМатериалы = Ложь;
	Если РольДоступна("СМ_СметчикМатериалы") Тогда
		ЭтоСметчикМатериалы = Истина;
	КонецЕсли;	
			
КонецПроцедуры

&НаСервере
Функция ПолучитьТекПоказателиРегистр()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(СМ_РесурснаяСтоимостьПозиции.ТекСтоимЗарплМашин) КАК ТекущаяЗарплМашинистов,
	               |	СУММА(СМ_РесурснаяСтоимостьПозиции.ТекСтоимОснЗарплата) КАК ТекущаяОснЗарплата,
	               |	СУММА(СМ_РесурснаяСтоимостьПозиции.ТекСтоимПрямЗатраты) КАК ТекущаяПрямЗатраты,
	               |	СУММА(СМ_РесурснаяСтоимостьПозиции.ТекСтоимСтоимМатер) КАК ТекущаяСтоимМатериалов,
	               |	СУММА(СМ_РесурснаяСтоимостьПозиции.ТекСтоимЭксплМашин) КАК ТекущаяЭксплМашин,
	               |	СМ_РесурснаяСтоимостьПозиции.Позиция
	               |ИЗ
	               |	РегистрСведений.СМ_РесурснаяСтоимостьПозиции КАК СМ_РесурснаяСтоимостьПозиции
	               |ГДЕ
	               |	СМ_РесурснаяСтоимостьПозиции.Смета = &Смета
	               |	И СМ_РесурснаяСтоимостьПозиции.Позиция = &Позиция
	               |	И СМ_РесурснаяСтоимостьПозиции.Раздел = &Раздел
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_РесурснаяСтоимостьПозиции.Позиция";
	Запрос.УстановитьПараметр("Смета",Объект.ИДСметы);
	Запрос.УстановитьПараметр("Позиция",Объект.Ссылка);
	Запрос.УстановитьПараметр("Раздел",Объект.ИДРодителя);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Функция ПолучитьТекЗначениеАктаИзРегистра(ПозицияСсылка)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(СМ_РесурснаяСтоимостьПозиции.ТекСтоимЗарплМашин) КАК ТекущаяЗарплМашинистов,
	               |	СУММА(СМ_РесурснаяСтоимостьПозиции.ТекСтоимОснЗарплата) КАК ТекущаяОснЗарплата,
	               |	СУММА(СМ_РесурснаяСтоимостьПозиции.ТекСтоимПрямЗатраты) КАК ТекущаяПрямЗатраты,
	               |	СУММА(СМ_РесурснаяСтоимостьПозиции.ТекСтоимСтоимМатер) КАК ТекущаяСтоимМатериалов,
	               |	СУММА(СМ_РесурснаяСтоимостьПозиции.ТекСтоимЭксплМашин) КАК ТекущаяЭксплМашин,
	               |	СМ_РесурснаяСтоимостьПозиции.Позиция
	               |ИЗ
	               |	РегистрСведений.СМ_РесурснаяСтоимостьПозиции КАК СМ_РесурснаяСтоимостьПозиции
	               |ГДЕ
	               |	СМ_РесурснаяСтоимостьПозиции.Смета = &Смета
	               |	И СМ_РесурснаяСтоимостьПозиции.Позиция = &Позиция
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_РесурснаяСтоимостьПозиции.Позиция";
	Запрос.УстановитьПараметр("Смета",Параметры.Акт);
	Запрос.УстановитьПараметр("Позиция",ПозицияСсылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Не (СуществуютАкты) И (Не Параметры.ПозицияАкта) Тогда
		// Эрикос.zbikt 11.06.2014
		Если ТекущийОбъект.Демонтаж Тогда
			// корректировка sudav - под удаление теперь другая функция
			СМ_СметаВызовСервера.УдалитьПодчиненныеПозицииЛСМатериалы(ТекущийОбъект.Ссылка); 		
		КонецЕсли;
		
		// Эрикос.zbikt 26.06.2014
		Если  Не ПустаяСтрока(АдресХранилищаЗамен) Тогда
			ТаблицаЗамен = ПолучитьИзВременногоХранилища(АдресХранилищаЗамен);
			ЛС 		= ТекущийОбъект.ИДСметы;
			Документы.СМ_ПозицияЛокальнойСметы.ДобавитьДвиженияВРегЗамен(ТаблицаЗамен, ТекущийОбъект, ЛС);
		КонецЕсли;
		
		Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(ТекущийОбъект, Ложь);
		
	КонецЕсли;
	
	ЗаписатьЗначенияПоАкту();
	ЗагрузитьДвиженияВТаблицы();
	СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(,ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗначенияПоАкту()
	
	Если Параметры.ПозицияАкта Тогда
		
		СтрокаПозиции = СМ_СметаВызовСервера.СтрокаПозицииАкта(Параметры.Акт, Объект.Ссылка);	
		Если СтрокаПозиции = Неопределено Тогда
			Возврат;
		КонецЕсли;
		РесурсыПозицииПоАкту = СМ_СметаВызовСервера.МассивСтрокРесурсовПозицииАкта(Параметры.Акт, Объект.Ссылка);
		
		// индексы могут отличаться
		КоэффициентыПересчетаАкта.Очистить();
		Если ЗначениеЗаполнено(СтрокаПозиции) Тогда
			Стр = КоэффициентыПересчетаАкта.Добавить();
			ЗаполнитьЗначенияСвойств(Стр, СтрокаПозиции);
			// текущие цены, если есть
			ТекущаяЦенаФакт 				= СтрокаПозиции.ТекущаяЦена;
			ФормулаТекЦеныФакт				= СтрокаПозиции.Позиция.ФормулаТекЦены;
			ТекущаяЗарплатаМашинистовФакт 	= СтрокаПозиции.ТекущаяЗарплатаМашинистов;
			// объем
			ФактОбъем 			= СтрокаПозиции.ФактОбъем;
			ФормулаФактОбъема 	= СтрокаПозиции.ФормулаОбъема;
		КонецЕсли;
		
		// ресурсы нужно обновить
		РесурсыПозицииАкта.Очистить();
		Для Каждого СтрокаРесурса Из РесурсыПозицииПоАкту Цикл
			Стр = РесурсыПозицииАкта.Добавить();	
			ЗаполнитьЗначенияСвойств(Стр, СтрокаРесурса); 			
		КонецЦикла;	
		
		// Нужно Обновить текущие стоимости прямых затрат по акту.
		Если Параметры.Акт.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
			МассивРесурсов = РесурсыПозицииАкта.НайтиСтроки(Новый Структура("Удален",Ложь));
			Если МассивРесурсов.Количество() = 0 Тогда
				ФормулаТекущейПЗФакт = СтрокаПозиции.ФормулаТекущейПЗ;
				ФормулаТекущейОЗФакт = СтрокаПозиции.ФормулаТекущейОЗ;
				ФормулаТекущейСМФакт = СтрокаПозиции.ФормулаТекущейСМ;
				ФормулаТекущейЗМФакт = СтрокаПозиции.ФормулаТекущейЗМ;
				ФормулаТекущейЭМФакт = СтрокаПозиции.ФормулаТекущейЭМ;
				ТекущиеПЗФакт = СтрокаПозиции.ТекущаяПрямЗатраты;
				ТекущиеОЗФакт = СтрокаПозиции.ТекущаяОснЗарплата;
				ТекущиеСМФакт = СтрокаПозиции.ТекущаяСтоимМатериалов;
				ТекущиеЗМФакт = СтрокаПозиции.ТекущаяЗарплМашинистов;
				ТекущиеЭМФакт = СтрокаПозиции.ТекущаяЭксплМашин;
				ТекущиеПЗФакт1 = СтрокаПозиции.ТекущаяПрямЗатраты * СтрокаПозиции.ФактОбъем;
				ТекущиеОЗФакт1 = СтрокаПозиции.ТекущаяОснЗарплата * СтрокаПозиции.ФактОбъем;
				ТекущиеСМФакт1 = СтрокаПозиции.ТекущаяСтоимМатериалов * СтрокаПозиции.ФактОбъем;
				ТекущиеЗМФакт1 = СтрокаПозиции.ТекущаяЗарплМашинистов * СтрокаПозиции.ФактОбъем;
				ТекущиеЭМФакт1 = СтрокаПозиции.ТекущаяЭксплМашин * СтрокаПозиции.ФактОбъем;
			Иначе
				ЗначениеРегистра = ПолучитьТекЗначениеАктаИзРегистра(СтрокаПозиции.Позиция.Ссылка); 
				ФормулаТекущейПЗФакт = "";
				ФормулаТекущейОЗФакт = "";
				ФормулаТекущейСМФакт = "";
				ФормулаТекущейЗМФакт = "";
				ФормулаТекущейЭМФакт = "";
				ТекущиеПЗФакт = 0;
				ТекущиеОЗФакт = 0;
				ТекущиеСМФакт = 0;
				ТекущиеЗМФакт = 0;
				ТекущиеЭМФакт = 0;
				ТекущиеПЗФакт1 = 0;
				ТекущиеОЗФакт1 = 0;
				ТекущиеСМФакт1 = 0;
				ТекущиеЗМФакт1 = 0;
				ТекущиеЭМФакт1 = 0;
				Если ЗначениеРегистра.Количество() <> 0 Тогда
					ТекущиеПЗФакт = ЗначениеРегистра[0].ТекущаяПрямЗатраты;
					ТекущиеОЗФакт = ЗначениеРегистра[0].ТекущаяОснЗарплата;
					ТекущиеСМФакт = ЗначениеРегистра[0].ТекущаяСтоимМатериалов;
					ТекущиеЗМФакт = ЗначениеРегистра[0].ТекущаяЗарплМашинистов;
					ТекущиеЭМФакт = ЗначениеРегистра[0].ТекущаяЭксплМашин;
					ТекущиеПЗФакт1 = ЗначениеРегистра[0].ТекущаяПрямЗатраты * СтрокаПозиции.ФактОбъем;
					ТекущиеОЗФакт1 = ЗначениеРегистра[0].ТекущаяОснЗарплата * СтрокаПозиции.ФактОбъем;
					ТекущиеСМФакт1 = ЗначениеРегистра[0].ТекущаяСтоимМатериалов * СтрокаПозиции.ФактОбъем;
					ТекущиеЗМФакт1 = ЗначениеРегистра[0].ТекущаяЗарплМашинистов * СтрокаПозиции.ФактОбъем;
					ТекущиеЭМФакт1 = ЗначениеРегистра[0].ТекущаяЭксплМашин * СтрокаПозиции.ФактОбъем;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЗначенияПоАкту()
	
	Если (Параметры.ПозицияАкта) И (ФактОбъем<>0) Тогда
		
		ОбъектАкт = Параметры.Акт.ПолучитьОбъект();
		СтрокаПозиции = СМ_СметаВызовСервера.СтрокаПозицииАкта(ОбъектАкт, Объект.Ссылка, Истина);	
		РесурсыПозицииПоАкту = СМ_СметаВызовСервера.МассивСтрокРесурсовПозицииАкта(ОбъектАкт, Объект.Ссылка);
		РесурсыПоАкту = ОбъектАкт.РесурсыПозицийАкта;

		// индексы могут отличаться
		Если ЗначениеЗаполнено(СтрокаПозиции) И (КоэффициентыПересчетаАкта.Количество() > 0) Тогда
			ЗаполнитьЗначенияСвойств(СтрокаПозиции, КоэффициентыПересчетаАкта[0]);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаПозиции) Тогда
			// текущие цены, если есть
			МассивРесурсов = РесурсыПоАкту.НайтиСтроки(Новый Структура("Удален",Ложь));
			Если МассивРесурсов.количество() <> 0 Тогда
				СтрокаПозиции.ТекущаяПрямЗатраты = ТекущиеПЗФакт;
				СтрокаПозиции.ТекущаяОснЗарплата = ТекущиеОЗФакт;
				СтрокаПозиции.ТекущаяЭксплМашин = ТекущиеЭМФакт;
				СтрокаПозиции.ТекущаяСтоимМатериалов = ТекущиеСМФакт;
				СтрокаПозиции.ТекущаяЗарплМашинистов = ТекущиеЗМФакт;
				СтрокаПозиции.ФормулаТекущейЗМ = ФормулаТекущейЗМФакт;
				СтрокаПозиции.ФормулаТекущейПЗ = ФормулаТекущейПЗФакт;
				СтрокаПозиции.ФормулаТекущейОЗ = ФормулаТекущейОЗФакт;
				СтрокаПозиции.ФормулаТекущейЭМ = ФормулаТекущейЭМФакт;
				СтрокаПозиции.ФормулаТекущейСМ = ФормулаТекущейСМФакт;
			КонецЕсли;
			СтрокаПозиции.ТекущаяЦена = ТекущаяЦенаФакт;
			СтрокаПозиции.ТекущаяЗарплатаМашинистов = ТекущаяЗарплатаМашинистовФакт;
			// объем
			СтрокаПозиции.ФактОбъем = ФактОбъем;
			СтрокаПозиции.ФормулаОбъема = ФормулаФактОбъема;
		КонецЕсли;
		
		// ресурсы нужно обновить
		СМ_СметаВызовСервера.ЗаполнитьТЧРесурсыАктаПоТаблице(ОбъектАкт, Объект.Ссылка, РесурсыПозицииАкта);
		
		ОбъектАкт.Записать();
		
	ИначеЕсли (Параметры.ПозицияАкта) Тогда
		
		ОбъектАкт = Параметры.Акт.ПолучитьОбъект();
		СМ_СметаВызовСервера.УдалитьСтрокуПозицииАкта(ОбъектАкт, Объект.Ссылка);
		ОбъектАкт.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

