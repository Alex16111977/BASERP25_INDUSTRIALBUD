//  Блок расчета базисной и текущей цен

&НаКлиенте
// Проверка формулы для сообщения пользователю.
Функция ПроверитьФормулу(ФормулаКП)
	СтрокаСимв = "1234567890+-*/().";
	Результат = Истина;
	Для сч = 1 По СтрДлина(ФормулаКП) Цикл
		ТекСимв = Сред(ФормулаКП,Сч,1);
		Если Найти(СтрокаСимв,ТекСимв) = 0 Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	Возврат (Результат);
КонецФункции

&НаКлиенте
// Расчет базисной и текущей цен
Процедура РасчетЦены(Команда)
	Вариант =  ВариантПересчета;
	Если ПустаяСтрока(Вариант) = Истина Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не выбран вариант пересчета'"));
	Иначе	
		Если Вариант = "0" Тогда
			// Расчет базисной цены по текущей.
			Если Объект.ТекущаяЦена = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не задана текущая цена'"));
			Иначе	
				Если  Объект.КоэффициентПересчетаЦен <> 0 Тогда 
					РезультатПересчета = Окр(Объект.ТекущаяЦена / Объект.КоэффициентПересчетаЦен,20,2);
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не задан коэффициент пересчета'"));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Вариант = "1" Тогда
			// Расчет текущей цены по базисной.
			
			Если ЭтоОборудование(Объект.Определитель)= Ложь Тогда
				БазиснаяЦена = Объект.СтоимМатериалов;
			Иначе
				БазиснаяЦена = Объект.Оборудование;
			КонецЕсли;	
			Если БазиснаяЦена = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не задана базисная цена'"));
			Иначе	
				Если  Объект.КоэффициентПересчетаЦен <> 0 Тогда 
					РезультатПересчета = Окр(БазиснаяЦена * Объект.КоэффициентПересчетаЦен,20,2);
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не задан коэффициент пересчета'"));
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;	
		Элементы.РезультатПересчета.Видимость = Истина;
		Если Вариант = "0" Тогда
			БазиснаяЦена = РезультатПересчета;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
// Процедура вычисляет коэффициент по заданной формуле.
Процедура ФормулаКоэффициентаПересчетаЦенПриИзменении(Элемент)
	
