	// Sudav - ГруппаИтоги - регламентируется ниже.
	// Sudav - ГруппаНРиСП.
	Элементы.ОбновитьНРиСП.Доступность = Не (СуществуютАкты ИЛИ Параметры.РедактированиеЦен);
