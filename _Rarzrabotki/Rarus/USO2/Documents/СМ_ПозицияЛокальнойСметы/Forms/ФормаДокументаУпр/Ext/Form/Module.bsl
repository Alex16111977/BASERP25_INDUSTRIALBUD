&НаСервере
Процедура ЗаполнитьНастройкиПозицииПоУмолчанию()
	
	Методика1984года = ПолучитьФункциональнуюОпцию("СМ_Методика84Года");
	Если Методика1984года = Истина Тогда Возврат; КонецЕсли;

	Объект.ПоправочныйКоэффициентКСПТекущий = Константы.СМ_ПоправочныйКоэффициентСПТекущий.Получить();
	Объект.ПоправочныйКоэффициентКСПБазисный= Константы.СМ_ПоправочныйКоэффициентСПБазисный.Получить();
	Объект.ПоправочныйКоэффициентКНРТекущий = Константы.СМ_ПоправочныйКоэффициентНРТекущий.Получить();
	Объект.ПоправочныйКоэффициентКНРБазисный= Константы.СМ_ПоправочныйКоэффициентНРБазисный.Получить();
	
	Объект.КоэффициентКНРНаРемонтБазисный 	= Константы.СМ_КоэффициентНРбазисныйРемонт.Получить();
	Объект.КоэффициентКНРНаРемонтТекущий    = Константы.СМ_КоэффициентНРтекущийРемонт.Получить();
	Объект.КоэффициентКСПНаРемонтБазисный   = Константы.СМ_КоэффициентСПбазисныйРемонт.Получить();
	Объект.КоэффициентКСПНаРемонтТекущий    = Константы.СМ_КоэффициентСПтекущийРемонт.Получить(); 
	
	Объект.КоэффициентКНРАЭСБазисный  		= Константы.СМ_КоэффициентНРбазисныйАЭС.Получить(); 
	Объект.КоэффициентКНРАЭСТекущий         = Константы.СМ_КоэффициентНРтекущийАЭС.Получить();
	Объект.КоэффициентКСПАЭСБазисный        = Константы.СМ_КоэффициентСПбазисныйАЭС.Получить();
	Объект.КоэффициентКСПАЭСТекущий         = Константы.СМ_КоэффициентСПтекущийАЭС.Получить();
	
	Объект.КоэффициентКНРУСНБазисный        = Константы.СМ_КоэффициентНРбазисныйУСН.Получить();
	Объект.КоэффициентКНРУСНТекущий         = Константы.СМ_КоэффициентНРтекущийУСН.Получить();
	Объект.КоэффициентКСПУСНБазисный        = Константы.СМ_КоэффициентСПбазисныйУСН.Получить();
	Объект.КоэффициентКСПУСНТекущий         = Константы.СМ_КоэффициентСПтекущийУСН.Получить();
			
КонецПроцедуры

