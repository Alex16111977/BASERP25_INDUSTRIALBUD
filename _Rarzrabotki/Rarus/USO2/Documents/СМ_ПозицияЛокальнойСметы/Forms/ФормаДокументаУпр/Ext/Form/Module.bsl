// Определение позиция материал, или оборудование
Функция ЭтоОборудование(Определитель)
	
	Если Определитель.видРасценки = Перечисления.СМ_ВидыРасценки.Оборудование Тогда
		Возврат истина;
	Иначе
		Возврат ложь;
	КонецЕсли;	
	
КонецФункции	

&НаКлиенте
// Занесения результата в соответствующие реквизиты позиции
Процедура ЗанестиРезультат(Команда)
	
	Вариант =  ВариантПересчета;
	ТекФормула = ОчиститьФормулу(Объект.ФормулаКоэффициентаПересчетаЦен);
	Объект.ФормулаКоэффициентаПересчетаЦен = ТекФормула;
	Если Вариант = "0" Тогда
		// Расчет Базисной цены от текущей.
		Если ЭтоОборудование(Объект.Определитель)= Ложь Тогда
			Объект.СтоимМатериалов = РезультатПересчета;
			РасчитатьСтоимостьНаОбъем("СтоимМатериалов"); 
			ПересчитатьПЗ();
			Если ПустаяСтрока(Объект.ФормулаКоэффициентаПересчетаЦен) = Истина Тогда
				Объект.ФормулаСМ = СокрЛП(Строка(Объект.ТекущаяЦена)) + "/" +СокрЛП(Строка(Объект.КоэффициентПересчетаЦен));
			Иначе	
				Объект.ФормулаСМ = СокрЛП(Строка(Объект.ТекущаяЦена)) + "/(" +СокрЛП(Объект.ФормулаКоэффициентаПересчетаЦен)+ ")";
			КонецЕсли;	
		Иначе
			Объект.Оборудование = РезультатПересчета;
			РасчитатьСтоимостьНаОбъем("Оборудование"); 
			Если ПустаяСтрока(Объект.ФормулаКоэффициентаПересчетаЦен) = Истина Тогда
				Объект.ФормулаОб = СокрЛП(Строка(Объект.ТекущаяЦена)) + "/" +СокрЛП(Строка(Объект.КоэффициентПересчетаЦен));
			Иначе
				Объект.ФормулаОб = СокрЛП(Строка(Объект.ТекущаяЦена)) + "/(" +СокрЛП(Объект.ФормулаКоэффициентаПересчетаЦен) + ")";
			КонецЕсли;	
		КонецЕсли;	
		Иначе
			Объект.ТекущаяЦена = РезультатПересчета;
			Если ЭтоОборудование(Объект.Определитель)= Ложь Тогда
				Если ПустаяСтрока(Объект.ФормулаКоэффициентаПересчетаЦен) = Истина Тогда
					Объект.ФормулаТекущейЦены = СокрЛП(Строка(Объект.СтоимМатериалов)) + "*" +СокрЛП(Строка(Объект.КоэффициентПересчетаЦен)); 
				Иначе
					Объект.ФормулаТекущейЦены = СокрЛП(Строка(Объект.СтоимМатериалов)) + "*(" +СокрЛП(Объект.ФормулаКоэффициентаПересчетаЦен) + ")"; 
				КонецЕсли;
			Иначе
				Если ПустаяСтрока(Объект.ФормулаКоэффициентаПересчетаЦен) = Истина Тогда
					Объект.ФормулаТекущейЦены = СокрЛП(Строка(Объект.Оборудование)) + "*" +СокрЛП(Строка(Объект.КоэффициентПересчетаЦен)); 
				Иначе
					Объект.ФормулаТекущейЦены = СокрЛП(Строка(Объект.Оборудование)) + "*(" +СокрЛП(Объект.ФормулаКоэффициентАПересчетаЦен) + ")"; 
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗаявкиНаМатериалыДиалог(Результат, СтруктураПараметров) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	Записать();
	Если ЗначениеЗаполнено(Объект.Ссылка)и не ЭтаФорма.Модифицированность Тогда
		ОткрытьФормуЗаявкиНаМатериалы();
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Документ не записан, заявка не может быть оформлена."));
	КонецЕсли;
