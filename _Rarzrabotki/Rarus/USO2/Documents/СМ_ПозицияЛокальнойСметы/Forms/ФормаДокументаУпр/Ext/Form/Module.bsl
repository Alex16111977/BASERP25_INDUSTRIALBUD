	Позиция = Объект.Ссылка.ПолучитьОбъект();
	Возврат(Позиция.ШифрРасценки);
КонецФункции

&НаСервере
Процедура РасчитатьСтоимостьНаОбъем(ИмяПоля = "", ОбъемИзменен = Ложь)
	
	Если ОбъемИзменен И ВводОбъемовВБазовыхЕдИзм Тогда
		Объект.ОбъемРабот = СМ_СметаВызовСервера.ПересчитатьВбазовыхЕдиницахИзмерения(Объект,Объект.ОбъемРабот);
		Если ЗначениеЗаполнено(Объект.ФормулаОбъема) Тогда
			Объект.ФормулаОбъема = СМ_СметаВызовСервера.ПересчитатьФормулаВбазовыхЕдиницахИзмерения(Объект,Объект.ФормулаОбъема);
	        ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Проверьте формулу!'"), Объект.Ссылка, "ФормулаОбъема");
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяПоля <> "" Тогда
		ЭтаФорма[ИмяПоля+"1"] = Объект[ИмяПоля]*Объект.ОбъемРабот;
		Возврат;
	КонецЕсли;
	
	ПрямЗатраты1 				= Объект.ПрямЗатраты * Объект.ОбъемРабот;
	ОснЗарплата1 				= Объект.ОснЗарплата * Объект.ОбъемРабот;
	ЭксплМашин1 				= Объект.ЭксплМашин * Объект.ОбъемРабот;
	ЗарплМашинистов1 			= Объект.ЗарплМашинистов * Объект.ОбъемРабот;
	СтоимМатериалов1 			= Объект.СтоимМатериалов * Объект.ОбъемРабот;
	Оборудование1 				= Объект.Оборудование * Объект.ОбъемРабот;
	ВозвратМатер1			 	= Объект.ВозвратМатер * Объект.ОбъемРабот;
	ЗатратыТрудаРабочих1 	 	= Объект.ЗатратыТрудаРабочих * Объект.ОбъемРабот;
	ЗатратыТрудаМашинистов1  	= Объект.ЗатратыТрудаМашинистов * Объект.ОбъемРабот;
	
КонецПроцедуры

&НаСервере
Процедура РасчитатьСтоимостьНаФактОбъем(ИмяПоля = "", ОбъемИзменен = Ложь)
	
	Если ОбъемИзменен И ВводОбъемовВБазовыхЕдИзм Тогда
		ФактОбъем = СМ_СметаВызовСервера.ПересчитатьВбазовыхЕдиницахИзмерения(Объект,ФактОбъем);
		Если ЗначениеЗаполнено(ФормулаФактОбъема) Тогда
			ФормулаФактОбъема = СМ_СметаВызовСервера.ПересчитатьФормулаВбазовыхЕдиницахИзмерения(Объект,ФормулаФактОбъема);	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Проверьте формулу!'"), Объект.Ссылка, "ФормулаОбъема");
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяПоля <> "" Тогда
		ЭтаФорма[ИмяПоля+"1"] = Объект[ИмяПоля]*Объект.ОбъемРабот;
		Возврат;
	КонецЕсли;
	
	ПрямЗатраты1 = Объект.ПрямЗатраты * ФактОбъем;
	ОснЗарплата1 = Объект.ОснЗарплата * ФактОбъем;
	ЭксплМашин1 = Объект.ЭксплМашин * ФактОбъем;
	ЗарплМашинистов1 = Объект.ЗарплМашинистов *ФактОбъем;
	СтоимМатериалов1 = Объект.СтоимМатериалов * ФактОбъем;
	Оборудование1 = Объект.Оборудование * ФактОбъем;
	ВозвратМатер1 = Объект.ВозвратМатер * ФактОбъем;
	ЗатратыТрудаРабочих1 = Объект.ЗатратыТрудаРабочих * ФактОбъем;
	ЗатратыТрудаМашинистов1 = Объект.ЗатратыТрудаМашинистов * ФактОбъем;
	// Zbikt
	// При изменении факт объема необходимо менять нормы расходов на объем.
	СтрокаПозиции = СМ_СметаВызовСервера.СтрокаПозицииАкта(Параметры.Акт, Объект.Ссылка);	
	СтарыйФактОбъем = СтрокаПозиции.ФактОбъем;
	Если СтарыйФактОбъем <> 0 Тогда
		КоэффицИзменения = ФактОбъем / СтарыйФактОбъем ; 
	Иначе
		КоэффицИзменения = ФактОбъем; 
	КонецЕсли;	
	ТаблРес = Новый ТаблицаЗначений;
	ТаблРес = ЭтаФорма.РесурсыПозицииАкта.Выгрузить();
	ЭтаФорма.РесурсыПозицииАкта.Очистить();

	Для Каждого СтрокаРесурса Из ТаблРес Цикл
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Ресурс",СтрокаРесурса.Ресурс);
		СтруктураОтбора.Вставить("СметныйКодРесурса",СтрокаРесурса.СметныйКодРесурса);
		
		МассивСтрок = Объект.РесурсыПозицииЛокальнойСметы.НайтиСтроки(СтруктураОтбора);
		ТекСтрока = Неопределено;
		Если МассивСтрок.Количество() > 0 Тогда
			ТекСтрока = МассивСтрок[0];	
		КонецЕсли;

		СтрокаРесурса.НормаРасходаОбъем	= ?(ТекСтрока = Неопределено,СтрокаРесурса.НормаРасходаОбъем,ТекСтрока.НормаРасхода) * ФактОбъем;
		СтрокаРесурса.ФактРасходаОбъем	= ?(ТекСтрока = Неопределено,СтрокаРесурса.ФактРасходаОбъем,?(СтрокаРесурса.ФактРасходаОбъем = 0,ТекСтрока.НормаРасхода,СтрокаРесурса.ФактРасходаОбъем)) * КоэффицИзменения;
		СтрокаРесурсаАкта = ЭтаФорма.РесурсыПозицииАкта.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРесурсаАкта,СтрокаРесурса);
	КонецЦикла;
	// Zbikt
	

КонецПроцедуры

&НаСервере
Процедура РассчитатьТекСтоимостиПоАкту()
	Если ЭтаФорма.Параметры.Акт.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
		МассивРесурсов = ЭтаФорма.РесурсыПозицииАкта.НайтиСтроки(Новый Структура("Удален",Ложь));	
		Если  МассивРесурсов.Количество() = 0 Тогда
			ТекущиеПЗФакт1 = ТекущиеПЗФакт * ФактОбъем;
			ТекущиеОЗФакт1 = ТекущиеОЗФакт * ФактОбъем;
			ТекущиеЭМФакт1 = ТекущиеЭМФакт * ФактОбъем;
			ТекущиеЗМФакт1 = ТекущиеЗМФакт * ФактОбъем;
			ТекущиеСМФакт1 = ТекущиеСМФакт * ФактОбъем;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДвиженияВТаблицы()
	
	// Vonokov - ссылки на документы заполняются при создании на сервере.  
	// СУДАРИКОВ - убрал, все вынесено на закладку "Итоги".
	ЛС 		= Объект.ИДСметы;
	Раздел 	= Объект.ИДРодителя;
		
	// sudav - добавлен расчет итогов
	СтруктураИтогов = СМ_СметныйСоставВызовСервера.ПолучитьСтруктуруСИтогамиПозиции(Объект.Ссылка, Раздел, ЛС, ?(Параметры.ПозицияАкта, ФактОбъем, Объект.ОбъемРабот), Объект, Параметры.Акт);
	Если СтруктураИтогов <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураИтогов);
	КонецЕсли;
	
	// Обновляем нумерацию.
	Номера = СМ_СметаВызовСервера.ПолучитьНомерДокумента(Объект.Ссылка, "СМ_ПозицияЛокальнойСметы");
	ПорНомер = Номера.ПорНомер;
		
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСтандартноеЗначениеЧПИКартинкиРесурса()
	
	ТЗ = Объект.РесурсыПозицииЛокальнойСметы.Выгрузить(,"НомерСтроки,Ресурс");
	
	МенВрТаб = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенВрТаб;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЗ.НомерСтроки КАК НомерСтроки,
	               |	ТЗ.Ресурс КАК Ресурс
	               |ПОМЕСТИТЬ ВТРесурсы
	               |ИЗ
	               |	&ТЗ КАК ТЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СтоимостьРесурсовПозиции.Количество КАК Количество,
	               |	ВТРесурсы.НомерСтроки,
	               |	ВТРесурсы.Ресурс,
	               |	СтоимостьРесурсовПозиции.НаименованиеРесурса,
	               |	СтоимостьРесурсовПозиции.НомерСтрокиДокумента
	               |ИЗ
	               |	ВТРесурсы КАК ВТРесурсы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СтоимостьРесурсовПозиции КАК СтоимостьРесурсовПозиции
	               |		ПО ВТРесурсы.Ресурс = СтоимостьРесурсовПозиции.Ресурс
	               |ГДЕ
	               |	СтоимостьРесурсовПозиции.Смета = &Смета
	               |	И СтоимостьРесурсовПозиции.Позиция = &Позиция";
	
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Запрос.УстановитьПараметр("Смета", Объект.ИдСметы);
	Запрос.УстановитьПараметр("Позиция",Объект.Ссылка);
	ТЗИтог = Запрос.Выполнить().Выгрузить();         
	
	Для Каждого СтрокаТаблицы Из Объект.РесурсыПозицииЛокальнойСметы Цикл
		
		Отбор = Новый Структура();
		Отбор.Вставить("НомерСтрокиДокумента",СтрокаТаблицы.НомерСтроки);
		
		Массив = ТЗИтог.НайтиСтроки(Отбор); 
		
		Если Массив.Количество() = 0 Тогда
			
			// Старый вариант, когда еще нет номера строки документа.
			           
			Отбор = Новый Структура();
			Отбор.Вставить("НомерСтроки",СтрокаТаблицы.НомерСтроки);
		    Отбор.Вставить("НаименованиеРесурса",""+СтрокаТаблицы.НомерСтроки+" "+СтрокаТаблицы.НаименованиеРесурса);
			
			Массив = ТЗИтог.НайтиСтроки(Отбор); 
		
		КонецЕсли;
		
		//СтрТЗ = ТЗИтог.Найти(СтрокаТаблицы.ПолучитьИдентификатор()+1,"НомерСтроки");
		
		//Если Не СтрТЗ = Неопределено Тогда
		Если Массив.Количество() > 0 Тогда
			
			СтрокаТаблицы.Количество = Массив[0].Количество*Объект.ОбъемРабот;
			СтрокаТаблицы.Стоимость = СтрокаТаблицы.Количество*СтрокаТаблицы.ТекущаяЦена;
			
		КонецЕсли;
		
		СтрокаТаблицы.Картинка = СМ_СметаКлиентСервер.ПолучитьКартинкуРесурса(СтрокаТаблицы.ТипМатериала, СтрокаТаблицы.ВидРесурса);
		
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из РесурсыПозицииАкта Цикл
		СтрокаТаблицы.Картинка = СМ_СметаКлиентСервер.ПолучитьКартинкуРесурса(СтрокаТаблицы.ТипМатериала, СтрокаТаблицы.ВидРесурса);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из Объект.НачисленияПозиции Цикл
		СтрокаТаблицы.СтандартноеЗначение = СтрокаТаблицы.ЧисловойПараметр.СтандартноеЗначение;
	КонецЦикла;
	

КонецФункции

&НаКлиенте
Процедура РедактироватьФормулу(ИмяРеквизита, ИмяРеквизитаФормулы)
	
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриЗакрытииФормыРедактированияФормулы",ЭтаФорма, Новый Структура("ИмяРеквизита, ИмяРеквизитаФормулы",ИмяРеквизита,ИмяРеквизитаФормулы));
	ПараметрыФормы = Новый Структура("ЗначениеЗаполнения",Новый Структура("Формула",Объект[ИмяРеквизитаФормулы]));
	ОткрытьФорму("ОбщаяФорма.СМ_РедакторФормулСмета",ПараметрыФормы,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// Осуществляет действия после закрытия формы редактирования формулы.
// Параметры:
//   Результат - выбранная формула
//   Параметры - Структура - дополнительные параметры переданные при формировании вопроса пользователю.
&НаКлиенте
Процедура ПриЗакрытииФормыРедактированияФормулы(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат = "" Тогда
		Возврат;
	КонецЕсли;
	
	Объект[Параметры.ИмяРеквизитаФормулы] = Результат;
	Объект[Параметры.ИмяРеквизита] = СМ_СметаКлиент.РасчитатьФормулу(Объект[Параметры.ИмяРеквизитаФормулы]);
	ЭтаФорма[Параметры.ИмяРеквизита+"1"] = Объект[Параметры.ИмяРеквизита] * Объект.ОбъемРабот;
	
КонецПроцедуры

// Осуществляет действия после закрытия формы редактирования формулы текущих затрат акта.
// Параметры:
//   Результат - выбранная формула
//   Параметры - Структура - дополнительные параметры переданные при формировании вопроса пользователю.
&НаКлиенте
Процедура ПриЗакрытииФормыРедактированияФормулыАкта(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат = "" Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма[Параметры.ИмяРеквизитаФормулы] = Результат;
	ЭтаФорма[Параметры.ИмяРеквизита] = СМ_СметаКлиент.РасчитатьФормулу(ЭтаФорма[Параметры.ИмяРеквизитаФормулы]);
	ЭтаФорма[Параметры.ИмяРеквизита+"1"] = ЭтаФорма[Параметры.ИмяРеквизита] * ФактОбъем;
	Если  Параметры.ИмяРеквизита <> "ТекущиеПЗФакт" Тогда
		ПересчитатьТекущиеПЗФакт();
	Иначе
		ТекущаяЦенаФакт = ЭтаФорма[Параметры.ИмяРеквизита];
	КонецЕсли;
КонецПроцедуры

