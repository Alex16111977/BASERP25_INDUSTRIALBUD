	ПроверитьПревышениеФактическогоРасхода(ТекДанные);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПревышениеФактическогоРасхода(ТекДанные)
	Если СМ_СметаВызовСервера.ЗначениеОпции("СМ_ПодтверждатьПревышениеОбъемаАкта")
		И ТекДанные.ФактРасходаОбъем > ТекДанные.НормаРасходаОбъем Тогда 
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ТекДанные",ТекДанные);
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораВариантаСписания", ЭтотОбъект, ДопПараметры);
		ПоказатьВводЗначения(Оповещение,ПредопределенноеЗначение("Перечисление.СМ_ВариантыСписанияПревышения.ДефектныйАкт"), "Вариант списания превышения");

	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораВариантаСписания(Результат, ДопПараметры) Экспорт
	Если Результат = ПредопределенноеЗначение("Перечисление.СМ_ВариантыСписанияПревышения.ДефектныйАкт") Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ВладелецФайла",  Параметры.Акт);
		ПараметрыФормы.Вставить("ТолькоПросмотр", Ложь);
		ПараметрыФормы.Вставить("РежимВыбора", Истина);
		
		ДопПараметры.Вставить("ВариантСписания", Результат);
		Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеВыбораФайлаДефектныйАкт", ЭтотОбъект, ДопПараметры);
		ОткрытьФорму("Документ.СМ_АктВыполненныхРабот.Форма.ПрисоединенныеФайлы",ПараметрыФормы,ЭтаФорма,Ложь,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли Результат = ПредопределенноеЗначение("Перечисление.СМ_ВариантыСписанияПревышения.ПредыдущийПериод") Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТекущийАкт",  Параметры.Акт);
		
		ДопПараметры.Вставить("ВариантСписания", Результат);
		Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеВыбораФайлаПредыдущийАкт", ЭтотОбъект, ДопПараметры);
		ОткрытьФорму("Документ.СМ_АктВыполненныхРабот.Форма.ФормаВыбораПредыдущего",ПараметрыФормы,ЭтаФорма,Ложь,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	Иначе
		ТекДанные = ДопПараметры.ТекДанные; 
		ТекДанные.ФактРасходаОбъем = ТекДанные.НормаРасходаОбъем;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Расход по факту установлен по норме.'"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораФайлаПредыдущийАкт(Результат, ДопПараметры) Экспорт
	ТекДанные = ДопПараметры.ТекДанные;
	Если Не Результат = Неопределено Тогда
		ТекДанные.ВариантСписанияПревышения = ДопПараметры.ВариантСписания;
		ТекДанные.СсылкаНаАкт = Результат.Акт;
		ТекДанные.СсылкаНаФайл = ПредопределенноеЗначение("Справочник.СМ_АктВыполненныхРаботПрисоединенныеФайлы.ПустаяСсылка");
		ТекДанные.КомментарийКФайлу = Результат.Комментарий;
	Иначе
		ТекДанные.ФактРасходаОбъем = ТекДанные.НормаРасходаОбъем;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Фактический расход установлен по норме.'"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораФайлаДефектныйАкт(Результат, ДопПараметры) Экспорт
	ТекДанные = ДопПараметры.ТекДанные;
	Если Не Результат = Неопределено Тогда
		ТекДанные.ВариантСписанияПревышения = ДопПараметры.ВариантСписания;
		ТекДанные.СсылкаНаФайл = Результат.Файл;
		ТекДанные.СсылкаНаАкт = ПредопределенноеЗначение("Документ.СМ_АктВыполненныхРабот.ПустаяСсылка");
		ТекДанные.КомментарийКФайлу = Результат.Комментарий;
	Иначе
		ТекДанные.ФактРасходаОбъем = ТекДанные.НормаРасходаОбъем;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Фактический расход установлен по норме.'"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтатусРесурсаПодрядчика(Команда)
	ТекДанные = Элементы.РесурсыПозицииЛокальнойСметы.ТекущиеДанные;
	ТекДанные.СтатусРесурса = ПредопределенноеЗначение("Перечисление.СМ_ОбеспечениеРесурса.Подрядчика");
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтатусРесурсаСобственный(Команда)
	ТекДанные = Элементы.РесурсыПозицииЛокальнойСметы.ТекущиеДанные;
	ТекДанные.СтатусРесурса = ПредопределенноеЗначение("Перечисление.СМ_ОбеспечениеРесурса.Собственный");
	Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Функция НайтиРесурсПоКоду(ТекКод)
	
	Если НЕ ЗначениеЗаполнено(ТекКод) Тогда
		Возврат Неопределено;
	КонецЕсли;	
		
	НайденныйРесурс = Справочники.СМ_Ресурсы.НайтиПоКоду(ТекКод);
	
	Если НайденныйРесурс = Справочники.СМ_Ресурсы.ПустаяСсылка() Тогда
		Возврат Неопределено;
	Иначе
		Возврат НайденныйРесурс;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуРесурса(НайденныйРесурс)
	
	Если НайденныйРесурс <> Неопределено Тогда 		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Ключ", НайденныйРесурс);
		ОткрытьФорму("Справочник.СМ_Ресурсы.ФормаОбъекта",СтруктураПараметров,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 	
	Иначе
	   	Сообщение 		= Новый СообщениеПользователю();
		Сообщение.Текст = "Элемент не найден";
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРасчеты(Команда)
	ПараметрыФормы = Новый Структура("ВыбранныйДокумент", Объект.Ссылка);
	ОткрытьФорму("ОбщаяФорма.СМ_ИтогиПоДокументу", ПараметрыФормы); 
КонецПроцедуры

&НаКлиенте
Процедура ФормулаТекЦеныПриИзменении()
	
	Если ЗначениеЗаполнено(Объект.ФормулаТекЦены) Тогда
		Попытка
			ТекФормула 				= Объект.ФормулаТекЦены;
			ТекФормула 				= ОчиститьФормулу(ТекФормула);
			Объект.ФормулаТекЦены 	= ТекФормула;
			Объект.ТекущаяЦена 		= Вычислить(ТекФормула);
		Исключение
			Объект.ТекущаяЦена = 0;
		КонецПопытки;
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура ФормулаТекЦеныФактПриИзменении()
	
	Если ЗначениеЗаполнено(Этаформа.Параметры.Акт) И ЗначениеЗаполнено(Объект.ФормулаТекЦены) Тогда
		Попытка
			ТекФормула 					= Объект.ФормулаТекЦены;
			ТекФормула 					= ОчиститьФормулу(ТекФормула);
			ЭтаФорма.ФормулаТекЦеныФакт = ТекФормула;
			ЭтаФорма.ТекущаяЦенаФакт	= Вычислить(ТекФормула);
		Исключение
			ТекущаяЦенаФакт	= 0;
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТекущаяЦенаПриИзменении(Элемент)
	
	Объект.ФормулаТекЦены = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущаяЦенаФактПриИзменении(Элемент)

	ЭтаФорма.ФормулаТекЦеныФакт = "";
	
КонецПроцедуры

