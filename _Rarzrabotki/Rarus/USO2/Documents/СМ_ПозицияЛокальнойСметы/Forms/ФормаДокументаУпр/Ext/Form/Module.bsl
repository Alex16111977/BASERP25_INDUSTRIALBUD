&НаСервереБезКонтекста
Функция ЭтоМатериал(Определитель)
	
	Если Определитель.видРасценки = Перечисления.СМ_ВидыРасценки.Материал Тогда
		Возврат истина;
	Иначе
		Возврат ложь;
	КонецЕсли;	
	
КонецФункции	

&НаСервереБезКонтекста
Функция ЭтоРабота(Определитель,ТипНормативныхСборников)
	
	Если Определитель.видРасценки = Перечисления.СМ_ВидыРасценки.Работа
		И (Не ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин
		И Не ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.Транспортировка) Тогда
		Возврат истина;
	Иначе
		Возврат ложь;
	КонецЕсли;	
	
КонецФункции	

&НаКлиенте
Процедура ОпределительПриИзменении(Элемент)
	
	ЭтоРабота = ЭтоРабота(Объект.Определитель,Объект.ТипНормативныхСборников);
	
	ОбновитьЧПНаСервере();
	
	ОпределитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Отказ = СМ_ЗащитаКлиент.ЗапускОбъекта();
	Если (СтруктураПараметровРасчетаЛС <> Неопределено) И (Не Отказ) Тогда
		ОпределитьВидимостьЭлементовФормы();
	КонецЕсли;
	
	// Элементы.ФормаКнопкаЦветШрифта.Картинка = ПолучитьКартинку();
	Элементы.ФормаГруппаПалитраЦветов.Картинка = ПолучитьКартинку();
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.Свойства") Тогда
		МодульУправлениеСвойствамиКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеСвойствамиКлиент");
		МодульУправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	
	Если Параметры.ПоказатьРядом Тогда
		ПодключитьОбработчикОжидания("ЗакрепитьСправа",1);
	КонецЕсли;
	
	ФормулаТекЦеныФактПриИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрепитьСправа()
    Если ЭтаФорма.ВводДоступен() Тогда
        WSHShell = Новый COMОбъект("WScript.Shell");
        WSHShell.SendKeys("%");
        WSHShell.SendKeys("{DOWN 5}");
        WSHShell.SendKeys("{RIGHT}");
        WSHShell.SendKeys("{UP 5}");
        WSHShell.SendKeys("{ENTER}");
        ОтключитьОбработчикОжидания("ЗакрепитьСправа");
		ПодключитьОбработчикОжидания("АктивизируемФормуСметы",0.1,Истина);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура АктивизируемФормуСметы() 
	ОткрытыеОкна = ПолучитьОкна();
	Для Каждого ТекОкно Из ОткрытыеОкна Цикл
		Если ТекОкно.Основное ИЛИ ТекОкно.НачальнаяСтраница Тогда
			Продолжить;
		КонецЕсли;
		ФормаОкна = ТекОкно.Содержимое[0];
		Если ЭтаФорма.ВладелецФормы = ФормаОкна Тогда
			ФормаОкна.Активизировать();
		КонецЕсли;
	КонецЦикла;
	ОтключитьОбработчикОжидания("АктивизируемФормуСметы");
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗаРасценку(Команда)
	
	ПараметрыПоиска = СМ_СметаКлиент.ИнициироватьСтруктуруОписанияРесурса(Объект, СтруктураПараметровРасчетаЛС);
	
	ТекДанные = Элементы.РесурсыПозицииЛокальнойСметы.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ПараметрыПоиска.Вставить("ТекРесурс",ТекДанные.Ресурс);
	КонецЕсли;	
	
	ОписаниеОЗакрытииФормыВыбораРесурса = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораРесурсаДобавить",ЭтаФорма,ПараметрыПоиска);
	ОткрытьФорму("Справочник.СМ_Ресурсы.Форма.ФормаВыбора",ПараметрыПоиска,ЭтаФорма,,,,ОписаниеОЗакрытииФормыВыбораРесурса,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	// ПоместитьВоВременноеХранилище(ПараметрыПоиска.Ресурс,АдресТаблицыРесурсов);
КонецПроцедуры

&НаКлиенте
Процедура ВынестиЗаРасценку(Команда)
	
	// Вынос позиции за расценку 
	ТекДанные = Элементы.РесурсыПозицииЛокальнойСметы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	ТекДанные.Удален 			= Истина;
	ЭтаФорма.Модифицированность = Истина;
	
	ПараметрыПоиска 						= СМ_СметаКлиент.ИнициироватьСтруктуруОписанияРесурса(Объект, СтруктураПараметровРасчетаЛС);
	ПараметрыПоиска.НаименованиеРесурса 	= ТекДанные.НаименованиеРесурса; 
	ПараметрыПоиска.ЕдиницаИзмеренияРесурса = ТекДанные.ЕдиницаИзмеренияРесурса;
	ПараметрыПоиска.Ресурс 					= ТекДанные.Ресурс;
	ПараметрыПоиска.БазиснаяЦена 			= ТекДанные.БазиснаяЦена;
	ПараметрыПоиска.ТекущаяЦена 			= ТекДанные.ТекущаяЦена;
	ПараметрыПоиска.БазиснаяЗарплМаш 		= ТекДанные.БазиснаяЗарплатаМашинистов;
	ПараметрыПоиска.ТекущаяЗарплМаш 		= ТекДанные.ТекущаяЗарплатаМашинистов;
	ПараметрыПоиска.Код 					= ТекДанные.СметныйКодРесурса;
	ПараметрыПоиска.ВидРесурса 				= ТекДанные.ВидРесурса;
	ПараметрыПоиска.ТипМатериала 			= ТекДанные.ТипМатериала;
	ПараметрыПоиска.Норма 					= СтрЗаменить(ТекДанные.НормаРасхода,",",".");
	ПараметрыПоиска.Код 					= ТекДанные.СметныйКодРесурса;
	
	ДобавитьЗаРасценкуНаСервере(ПараметрыПоиска);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗаРасценкой(Команда)
	
	// Вставка Позиции минус текущий ресурс 
	ТекДанные = Элементы.РесурсыПозицииЛокальнойСметы.ТекущиеДанные;
	СтарыйРесурс = ТекДанные.Ресурс;
	
	ПараметрыПоиска = СМ_СметаКлиент.ИнициироватьСтруктуруОписанияРесурса(Объект, СтруктураПараметровРасчетаЛС);
	
	ПараметрыПоиска.НаименованиеРесурса = ТекДанные.НаименованиеРесурса; 
	ПараметрыПоиска.ЕдиницаИзмеренияРесурса = ТекДанные.ЕдиницаИзмеренияРесурса;
	
	ПараметрыПоиска.Ресурс = СтарыйРесурс;
	ПараметрыПоиска.БазиснаяЦена = ТекДанные.БазиснаяЦена;
	ПараметрыПоиска.ТекущаяЦена = ТекДанные.ТекущаяЦена;
	ПараметрыПоиска.БазиснаяЗарплМаш = ТекДанные.БазиснаяЗарплатаМашинистов;
	ПараметрыПоиска.ТекущаяЗарплМаш = ТекДанные.ТекущаяЗарплатаМашинистов;
	ПараметрыПоиска.Код = ТекДанные.СметныйКодРесурса;
	ПараметрыПоиска.ВидРесурса = ТекДанные.ВидРесурса;
	ПараметрыПоиска.ТипМатериала = ТекДанные.ТипМатериала;
	НормаРасхода = СтрЗаменить(ТекДанные.НормаРасхода,",",".");
	ПараметрыПоиска.Норма = -1 * НормаРасхода;
	ПараметрыПоиска.Код = ТекДанные.СметныйКодРесурса;
	
	ДобавитьЗаРасценкуНаСервере(ПараметрыПоиска);

КонецПроцедуры

// Осуществляет действия после закрытия формы выбора ресурса.
// Параметры:
//   Результат - выбранный ресурс
//   ПараметрыПоиска - Структура - дополнительные параметры переданные при формировании вопроса пользователю.
&НаКлиенте
Процедура ПриЗакрытииФормыВыбораРесурсаДобавить(Результат, ПараметрыПоиска) Экспорт
	
	Результат = СМ_СметаКлиент.ПолучитьОдинРесурсИзМассива(Результат);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли; 
	
	ПараметрыПоиска.Ресурс = Результат;
	ПараметрыПоиска.Вставить("Раздел",Объект.ИДРодителя); 
	ПараметрыПоиска.Вставить("Владелец",Объект); 
	НаименованиеЕдИзм = СокрЛП(Строка(ПараметрыПоиска.ЕдИзм)); 
	Если НаименованиеЕдИзм = "" Тогда
		НаименованиеЕдИзм = ОпеределитьЕдИзм(ПараметрыПоиска.Ресурс);
	КонецЕсли;	
	НаименованиеЕдИзм = НаименованиеЕдИзм +")";
	Подсказка 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Введите норму (%1'"),НаименованиеЕдИзм);
	Оповещение 	= Новый ОписаниеОповещения("ПослеВводаКоличества", ЭтотОбъект,Новый Структура("ПараметрыПоиска,СтарыйРесурс,Результат",ПараметрыПоиска,Неопределено,Результат));
	ПоказатьВводЧисла(Оповещение, 1, Подсказка, 15, 6);
	
КонецПроцедуры

// Осуществляет действия после закрытия формы выбора ресурса.
// Параметры:
//   Результат - выбранный ресурс
//   ПараметрыПоиска - Структура - дополнительные параметры переданные при формировании вопроса пользователю.
&НаКлиенте
Процедура ПриЗакрытииФормыВыбораРесурса(Результат, ПараметрыПоиска) Экспорт  
	
	Результат = СМ_СметаКлиент.ПолучитьОдинРесурсИзМассива(Результат);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли; 
	
	СтарыйРесурс = ПараметрыПоиска.Ресурс;
	
	ДобавитьЗаРасценкуНаСервере(ПараметрыПоиска);
	
	ПараметрыПоиска.Норма 	= -1*ПараметрыПоиска.Норма;
	ПараметрыПоиска.Вставить("ТекРесурс",СтарыйРесурс);			
	ПараметрыПоиска.Ресурс 	= Результат;
	ПараметрыПоиска.Вставить("Раздел",Объект.ИДРодителя); 
	ПараметрыПоиска.Вставить("Владелец",Объект); 
	
	НоваяНорма 			= ПараметрыПоиска.Норма;
	НаименованиеЕдИзм 	= СокрЛП(Строка(ПараметрыПоиска.ЕдИзм)); 
	Если НаименованиеЕдИзм = "" Тогда
		НаименованиеЕдИзм = ОпеределитьЕдИзм(ПараметрыПоиска.Ресурс);
	КонецЕсли;	
	НаименованиеЕдИзм 	= НаименованиеЕдИзм +")";
	Подсказка 			= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Введите норму (%1'"),НаименованиеЕдИзм);
	Оповещение 			= Новый ОписаниеОповещения("ПослеВводаКоличества", ЭтотОбъект,Новый Структура("ПараметрыПоиска,СтарыйРесурс,Результат",ПараметрыПоиска,СтарыйРесурс,Результат));
	ПоказатьВводЧисла(Оповещение, НоваяНорма, Подсказка, 15, 6);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыВыбораРесурсаСНБ(Результат, ПараметрыПоиска)
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтарыйРесурс 			= ПараметрыПоиска.Ресурс;
	ПараметрыПоиска.Норма 	= -1*ПараметрыПоиска.Норма;
	ПараметрыПоиска.Вставить("ТекРесурс",СтарыйРесурс);	
	ПараметрыПоиска.Ресурс 	= Результат;
	ПараметрыПоиска.Вставить("Раздел",Объект.ИДРодителя); 
	ПараметрыПоиска.Вставить("Владелец",Объект); 
	
	НоваяНорма 			= ПараметрыПоиска.Норма;
	НаименованиеЕдИзм 	= СокрЛП(Строка(ПараметрыПоиска.ЕдИзм)); 
	Если НаименованиеЕдИзм = "" Тогда
		НаименованиеЕдИзм = ОпеределитьЕдИзм(ПараметрыПоиска.Ресурс);
	КонецЕсли;	
	НаименованиеЕдИзм 	= НаименованиеЕдИзм +")";
	Подсказка 			= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Введите норму (%1'"),НаименованиеЕдИзм);
	Оповещение 			= Новый ОписаниеОповещения("ПослеВводаКоличества", ЭтотОбъект,Новый Структура("ПараметрыПоиска,СтарыйРесурс,Результат",ПараметрыПоиска,СтарыйРесурс,Результат));
	ПоказатьВводЧисла(Оповещение, НоваяНорма, Подсказка, 15, 6);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаКоличества(НоваяНорма, Параметры) Экспорт
	Если НЕ НоваяНорма = Неопределено Тогда
		Если Параметры.СтарыйРесурс <> Неопределено Тогда
			СтараяЕдиницаИзмерения = ПолучитьЕдиницуИзмерения(Параметры.СтарыйРесурс);
			НоваяЕдиницаИзмерения =  ПолучитьЕдиницуИзмерения(Параметры.Результат);
			Если СтараяЕдиницаИзмерения <> НоваяЕдиницаИзмерения Тогда
				Состояние(НСтр("ru='Разные единицы измерения ресурсов, проверьте объем в позиции-ресурсе замены'"),100);
				НоваяНорма = ПересчитатьНорму(НоваяНорма,СтараяЕдиницаИзмерения,НоваяЕдиницаИзмерения);	
			КонецЕсли;	
		КонецЕсли;
		Параметры.ПараметрыПоиска.Норма = НоваяНорма;
		// Определение текущих цен из ВБ.
		// Если Автозагрузка цен из ИБ, вызывается модуль определения цен ВБ.
		ПолучитьПравоЗагрузкиТекущихЦен(Параметры.ПараметрыПоиска);
		Если Параметры.ПараметрыПоиска.ЗагружатьТекущиеЦены И ЗначениеЗаполнено(Параметры.ПараметрыПоиска.ФайлСборникаТекущихЦен) Тогда
			СтруктураЦен = Новый Структура();
			СтруктураЦен.Вставить("БазиснаяЦена");
			СтруктураЦен.Вставить("БазиснаяЗарплатаМашинистов");
			СтруктураЦен.Вставить("ТекущаяЦена");
			СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов");
			Район 						= Параметры.ПараметрыПоиска.Район;
			ИмяФайлаСборникаТекущихЦен 	= Параметры.ПараметрыПоиска.ФайлСборникаТекущихЦен;
			КодРегиональнойБазы 		= Параметры.ПараметрыПоиска.КодРегионаФайлаТекущихЦен; 
			СМ_СметаКлиент.ПолучитьЦеныНовогоРесурса(Параметры.Результат,Район,ИмяФайлаСборникаТекущихЦен,КодРегиональнойБазы,СтруктураЦен); 	
			Параметры.ПараметрыПоиска.ТекущаяЦена 		= СтруктураЦен.ТекущаяЦена;
			Параметры.ПараметрыПоиска.ТекущаяЗарплМаш 	= СтруктураЦен.ТекущаяЗарплатаМашинистов;
		ИначеЕсли Параметры.ПараметрыПоиска.ЗагружатьТекущиеЦены Тогда // Флаг обновление по текущим ценам включен, сборник тек цен не указан. 
			СтруктураЦен = Новый Структура();
			СтруктураЦен.Вставить("БазиснаяЦена",0);
			СтруктураЦен.Вставить("БазиснаяЗарплатаМашинистов",0);
			СтруктураЦен.Вставить("ТекущаяЦена",0);
			СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов",0);
		
			//ТекРесурс = ?(ЗначениеЗаполнено(Параметры.ПараметрыПоиска),СМ_СметаВызовСервера.НайтиРесурсПоКоду(Параметры.ПараметрыПоиска),Параметры.ПараметрыПоиска.Ресурс);
			//ТекРесурс = ?(ЗначениеЗаполнено(Параметры.ПараметрыПоиска.Код),СМ_СметаВызовСервера.НайтиРесурсПоКоду(Параметры.ПараметрыПоиска.Код), Параметры.ПараметрыПоиска.Ресурс);
			ТекРесурс 	= Параметры.ПараметрыПоиска.Ресурс;
						
			СМ_СметаВызовСервера.ПолучитьЦеныНовогоРесурса(ТекРесурс,Параметры.ПараметрыПоиска.Район,Параметры.ПараметрыПоиска.РегионДляВыбораЦен,Параметры.ПараметрыПоиска.ДатаТекущихЦен,СтруктураЦен,Истина);						
			Параметры.ПараметрыПоиска.ТекущаяЦена 		= СтруктураЦен.ТекущаяЦена;
			Параметры.ПараметрыПоиска.ТекущаяЗарплМаш 	= СтруктураЦен.ТекущаяЗарплатаМашинистов;			
		КонецЕсли;
		ДобавитьЗаРасценкуНаСервере(Параметры.ПараметрыПоиска, Истина);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ОпеределитьЕдИзм(ТекРесурс)
	Наим = "";
	Если ТекРесурс <> Неопределено Тогда
		Наим = СокрЛП(Строка(ТекРесурс.ЕдиницаИзмерения));
	КонецЕсли;	
	Возврат Наим;
КонецФункции

&НаСервере
Процедура ДобавитьЗаРасценкуНаСервере(СтруктураОписанияРесурса, ОбновитьПоВнутреннемуСправочнику = Ложь)
	
	Позиция = РеквизитФормыВЗначение("Объект");
	
	ПолучитьОписаниеРесурса(СтруктураОписанияРесурса); 
	
	Если СтруктураОписанияРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих
		Или СтруктураОписанияРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Ресурсы затраты труда не являются самостоятельной расценкой'"));
		Возврат;
	КонецЕсли;
	
	СМ_СметаВызовСервера.СоздатьПозициюНеучтенныйРесурс(Позиция, СтруктураОписанияРесурса, СтруктураПараметровРасчетаЛС);
	
	ЗначениеВДанныеФормы(Позиция, Объект);
	
	ЗаполнитьСтандартноеЗначениеЧПИКартинкиРесурса();
КонецПроцедуры

&НаКлиенте
Процедура РесурсыПозицииЛокальнойСметыРесурсПриИзменении(Элемент)
	
	ТекДанные = Элементы.РесурсыПозицииЛокальнойСметы.ТекущиеДанные;
	НовыйРесурс = ТекДанные.Ресурс;
	ПараметрыПоиска = СМ_СметаКлиент.ИнициироватьСтруктуруОписанияРесурса(Объект, СтруктураПараметровРасчетаЛС);
	ПараметрыПоиска.Ресурс = НовыйРесурс;
	
	// Получить данные о ресурсе
	ПолучитьОписаниеРесурса(ПараметрыПоиска);
	
	ТекДанные.НаименованиеРесурса = ПараметрыПоиска.НаименованиеРесурса;
	ТекДанные.ЕдиницаИзмеренияРесурса = ПараметрыПоиска.ЕдиницаИзмеренияРесурса;

	ТекДанные.СметныйКодРесурса = ПараметрыПоиска.Код;
	ТекДанные.ВидРесурса = ПараметрыПоиска.ВидРесурса;
	ТекДанные.БазиснаяЦена = ПараметрыПоиска.БазиснаяЦена;
	ТекДанные.БазиснаяЗарплатаМашинистов = ПараметрыПоиска.БазиснаяЗарплМаш;
	ТекДанные.ТекущаяЦена = ПараметрыПоиска.ТекущаяЦена;
	ТекДанные.ТекущаяЗарплатаМашинистов = ПараметрыПоиска.ТекущаяЗарплМаш;
	ТекДанные.ТипМатериала = ПараметрыПоиска.ТипМатериала;
	ТекДанные.Добавлен = Истина;
	
	// Если автозагрузка цен из ИБ, то вызывается модуль определения цен ВБ. 
	ПолучитьПравоЗагрузкиТекущихЦен(ПараметрыПоиска);
	Если ПараметрыПоиска.ЗагружатьТекущиеЦены И ЗначениеЗаполнено(ПараметрыПоиска.ФайлСборникаТекущихЦен) Тогда
		СтруктураЦен = Новый Структура();
		СтруктураЦен.Вставить("БазиснаяЦена");
		СтруктураЦен.Вставить("БазиснаяЗарплатаМашинистов");
		СтруктураЦен.Вставить("ТекущаяЦена");
		СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов");
		Район = ПараметрыПоиска.Район;
		ИмяФайлаСборникаТекущихЦен = ПараметрыПоиска.ФайлСборникаТекущихЦен;
		КодРегиональнойБазы = ПараметрыПоиска.КодРегионаФайлаТекущихЦен; 
		СМ_СметаКлиент.ПолучитьЦеныНовогоРесурса(НовыйРесурс,Район,ИмяФайлаСборникаТекущихЦен,КодРегиональнойБазы,СтруктураЦен); 	
		ТекДанные.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
		ТекДанные.ТекущаяЗарплатаМашинистов = СтруктураЦен.ТекущаяЗарплатаМашинистов;
	КонецЕсли;
	
	ЗаполнитьСтандартноеЗначениеЧПИКартинкиРесурса();
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьОписаниеРесурса(СтруктураОписанияРесурса,БезВызова = Ложь)
	// Для выбора цен из справочника(регистра сведений).
	СтруктураОписанияРесурса.Район = СтруктураПараметровРасчетаЛС.Район;
	СтруктураОписанияРесурса.ДатаТекущихЦен = СтруктураПараметровРасчетаЛС.ДатаТекущихЦен;
	СтруктураОписанияРесурса.ФайлСборникаТекущихЦен = СтруктураПараметровРасчетаЛС.ФайлСборникаТекущихЦен ;
	СтруктураОписанияРесурса.КодРегионаФайлаТекущихЦен = СтруктураПараметровРасчетаЛС.КодРегионаФайлаТекущихЦен;
	Если СтруктураПараметровРасчетаЛС.ФайлСборникаТекущихЦен = "" Тогда
		СтруктураОписанияРесурса.ЗагружатьТекущиеЦены = СтруктураПараметровРасчетаЛС.АвтозагрузкаЦен;
	Иначе
		СтруктураОписанияРесурса.ЗагружатьТекущиеЦены = Ложь;
	КонецЕсли;
	СМ_СметаВызовСервера.ПолучитьОписаниеРесурса(СтруктураОписанияРесурса);
КонецПроцедуры

&НаСервере
Процедура ПолучитьПравоЗагрузкиТекущихЦен(СтруктураОписанияРесурса)
	// Для выбора цен из ВБ.
	СтруктураОписанияРесурса.ЗагружатьТекущиеЦены = СтруктураПараметровРасчетаЛС.АвтозагрузкаЦен;
	СтруктураОписанияРесурса.ФайлСборникаТекущихЦен = СтруктураПараметровРасчетаЛС.ФайлСборникаТекущихЦен ;
	СтруктураОписанияРесурса.Район = СтруктураПараметровРасчетаЛС.Район;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПлюсМинус(Команда)
	
	// Вставка Позиции минус текущий ресурс 
	ТекДанные 		= Элементы.РесурсыПозицииЛокальнойСметы.ТекущиеДанные;
	СтарыйРесурс 	= ТекДанные.Ресурс;
	Позиция 		= Объект;
	НормаРасхода 	= СтрЗаменить(ТекДанные.НормаРасхода,",",".");
	ПараметрыПоиска = СМ_СметаКлиент.ИнициироватьСтруктуруОписанияРесурса(Позиция);
	
	ПараметрыПоиска.НаименованиеРесурса 	= ТекДанные.НаименованиеРесурса; 
	ПараметрыПоиска.ЕдиницаИзмеренияРесурса = ТекДанные.ЕдиницаИзмеренияРесурса;
	ПараметрыПоиска.Ресурс 					= СтарыйРесурс;
	ПараметрыПоиска.БазиснаяЦена 			= ТекДанные.БазиснаяЦена;
	ПараметрыПоиска.ТекущаяЦена 			= ТекДанные.ТекущаяЦена;
	ПараметрыПоиска.БазиснаяЗарплМаш 		= ТекДанные.БазиснаяЗарплатаМашинистов;
	ПараметрыПоиска.ТекущаяЗарплМаш 		= ТекДанные.ТекущаяЗарплатаМашинистов;
	ПараметрыПоиска.Код 					= ТекДанные.СметныйКодРесурса;
	ПараметрыПоиска.ВидРесурса 				= ТекДанные.ВидРесурса;
	ПараметрыПоиска.ТипМатериала 			= ТекДанные.ТипМатериала;
	ПараметрыПоиска.НеИндексировать 		= Истина;
	ПараметрыПоиска.Норма 					= -1 * НормаРасхода;
	ПараметрыПоиска.Вставить("СметныйКодРесурса",ТекДанные.СметныйКодРесурса);
	ПараметрыПоиска.Вставить("ТекРесурс",СтарыйРесурс);

	// Вставка  Позиции плюс из справочника
	ОписаниеОЗакрытииФормыВыбораРесурса = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораРесурса",ЭтаФорма,ПараметрыПоиска );
	ОткрытьФорму("Справочник.СМ_Ресурсы.Форма.ФормаВыбора",ПараметрыПоиска,ЭтаФорма,,,,ОписаниеОЗакрытииФормыВыбораРесурса,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъемРаботПриИзменении(Элемент)
	
	НовыйОбъем = Объект.ОбъемРабот;	
	Если НовыйОбъем < Параметры.ОбъемВсегоБезАкта И Параметры.ОбъемВсегоБезАкта > 0 Тогда
		СтарыйОбъем 		= СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Объект.Ссылка, "ОбъемРабот");
		Объект.ОбъемРабот 	= СтарыйОбъем;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Введенный объем работ меньше выполненного!'"));
		Возврат;
	КонецЕсли;

	РасчитатьСтоимостьНаОбъем("", Истина);
	СМ_СметаКлиентСервер.РассчитатьКоличествоРесурса(Объект);
	
	//**********************************************************
	// ++ AVV
	Если ЗначениеЗаполнено(Объект.ФормулаОбъема) Тогда
		
		ТекФормула = Объект.ФормулаОбъема;
		
		// Поиск и подстановка параметров в формулу из ЛС
		МассивПараметров = СМ_СметаКлиентСервер.ПолучитьСписокПараметровФормулы(Объект.ФормулаОбъема);
		Если МассивПараметров.Количество() > 0 Тогда
			//СтруктураПараметров = СМ_СметаКлиентСервер.ЗаполнитьЗначенияПараметров(МассивПараметров,Объект.ИДСметы);
			СтруктураПараметров = ЗаполнитьЗначенияПараметров(МассивПараметров);
			ТекФормула			= СМ_СметаКлиентСервер.ПодставитьПараметрыВФормулу(ТекФормула,СтруктураПараметров);
		КонецЕсли;
		
		Попытка
			ТекФормула 	= СтрЗаменить(ТекФормула,",",".");
			Формула 	= "ТекОбъем = " + ТекФормула+"; Объект.ОбъемРабот = ТекОбъем;";
			Выполнить(Формула);
		
			Если Объект.ОбъемРабот <> НовыйОбъем Тогда
				Объект.ОбъемРабот = НовыйОбъем;
				Если Объект.НормаРасходаРесурса = 1 Тогда
					Объект.ФормулаОбъема = "";	
				Иначе
					Объект.ФормулаОбъема = "" + Объект.НормаРасходаРесурса + "*" + Объект.КоличествоРесурса;		
				КонецЕсли;
				ФормулаИзменена = Истина;
			КонецЕсли;
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Ошибка в формуле, объем не изменен'"));
		КонецПопытки;

	КонецЕсли;	
	// -- AVV
	//**********************************************************

	Если ЗначениеЗаполнено(Объект.Ссылка) И СМ_СметаВызовСервера.ЕстьПривязанныеПозиции(Объект.Ссылка) Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбъем", ЭтаФорма);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Изменять пропорционально объем привязанных позиций?';"
		+ " en = 'Do you want to continue?'"), Режим, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НормаРасходаРесурсаПриИзменении(Элемент)
	
	СМ_СметаКлиентСервер.РассчитатьКоличествоРесурса(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбъем(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	НовыйОбъем 	= Объект.ОбъемРабот;	
	СтарыйОбъем = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Объект.Ссылка, "ОбъемРабот");
	ВыполнитьПересчетПривязанныхПозиций(НовыйОбъем,СтарыйОбъем);
	Записать();
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьПересчетПривязанныхПозиций(НовыйОбъем,СтарыйОбъем)
	
	СМ_СметаРасчетСервер.ВыполнитьПересчетПривязанныхПозиций(Объект.Ссылка,НовыйОбъем,СтарыйОбъем);
	
КонецПроцедуры

// Эрикос.zbikt 25.06.2014

&НаКлиенте
Процедура ЗаменаРесурсаИзНС(Команда)
	ТекДанные = Элементы.РесурсыПозицииЛокальнойСметы.ТекущиеДанные;
	СтарыйРесурс = ТекДанные.Ресурс;
	Ресурсы = Новый Структура();
	Ресурсы.Вставить("СтарыйРесурс", СтарыйРесурс);
	Ресурсы.Вставить("НормаРасходаСтарогоМатериала", ТекДанные.НормаРасхода);
	Ресурсы.Вставить("БазиснаяЦенаСтарогоМатериала", ТекДанные.БазиснаяЦена);
	Ресурсы.Вставить("ТекущаяЦенаСтарогоМатериала", ТекДанные.ТекущаяЦена);
	Ресурсы.Вставить("БазисЗарплМашСтарРесурс", ТекДанные.БазиснаяЗарплатаМашинистов);
	Ресурсы.Вставить("ТекЗарплМашСтарРесурс", ТекДанные.ТекущаяЗарплатаМашинистов);

	ПараметрыПоиска = СМ_СметаКлиент.ИнициироватьСтруктуруОписанияРесурса(Объект, СтруктураПараметровРасчетаЛС);  
	ПараметрыПоиска.Вставить("ЗаменяемыйРесурс",Ресурсы);
	ПолучитьОписаниеРесурса(ПараметрыПоиска,Истина);
	ПараметрыПоиска.Вставить("ТекРесурс",СтарыйРесурс);
	ПараметрыПоиска.Вставить("МестоЗамены","НС");
	ОписаниеОЗакрытииФормыВыбораРесурса = Новый ОписаниеОповещения("ПриЗакрытииФормыЗаменыРесурса",ЭтаФорма,ПараметрыПоиска );
	ОткрытьФорму("Справочник.СМ_НормативныеСборники.Форма.ФормаВыбора",,ЭтаФорма,,,,ОписаниеОЗакрытииФормыВыбораРесурса,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура Заменить(Команда)
	
	ТекДанные = Элементы.РесурсыПозицииЛокальнойСметы.ТекущиеДанные;
	СтарыйРесурс = ТекДанные.Ресурс;
	Ресурсы = Новый Структура();
	Ресурсы.Вставить("СтарыйРесурс", СтарыйРесурс);
	Ресурсы.Вставить("НормаРасходаСтарогоМатериала", ТекДанные.НормаРасхода);
	Ресурсы.Вставить("БазиснаяЦенаСтарогоМатериала", ТекДанные.БазиснаяЦена);
	Ресурсы.Вставить("ТекущаяЦенаСтарогоМатериала", ТекДанные.ТекущаяЦена);
	Ресурсы.Вставить("БазисЗарплМашСтарРесурс", ТекДанные.БазиснаяЗарплатаМашинистов);
	Ресурсы.Вставить("ТекЗарплМашСтарРесурс", ТекДанные.ТекущаяЗарплатаМашинистов);

	ПараметрыПоиска = СМ_СметаКлиент.ИнициироватьСтруктуруОписанияРесурса(Объект, СтруктураПараметровРасчетаЛС);  
	ПараметрыПоиска.Вставить("ЗаменяемыйРесурс",Ресурсы);
	ПолучитьОписаниеРесурса(ПараметрыПоиска,Истина);
	ПараметрыПоиска.Вставить("ТекРесурс",СтарыйРесурс);
	ПараметрыПоиска.Вставить("МестоЗамены","Ресурсы");
	ОписаниеОЗакрытииФормыВыбораРесурса = Новый ОписаниеОповещения("ПриЗакрытииФормыЗаменыРесурса",ЭтаФорма,ПараметрыПоиска );
	ОткрытьФорму("Справочник.СМ_Ресурсы.Форма.ФормаВыбора",ПараметрыПоиска,ЭтаФорма,,,,ОписаниеОЗакрытииФормыВыбораРесурса,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// Процедура осуществляет действия после закрытия формы выбора ресурса при замене.
// ПАРАМЕТРЫ:
//// Результат - выбранный ресурс.
//// ПараметрыПоиска - дополнительные параметры переданные при формировании вопроса пользователю.
&НаКлиенте
Процедура ПриЗакрытииФормыЗаменыРесурса(Результат, ПараметрыПоиска) Экспорт
	
	Результат = СМ_СметаКлиент.ПолучитьОдинРесурсИзМассива(Результат);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПоиска.МестоЗамены = "Ресурсы" Тогда
		ТаблРесурсы = ПараметрыПоиска.ЗаменяемыйРесурс;
		СтарыйРесурс = ТаблРесурсы.СтарыйРесурс;
		
		ТаблРесурсы.Вставить("НовыйРесурс", Результат);
		
		ТекДанные = Элементы.РесурсыПозицииЛокальнойСметы.ТекущиеДанные;
		ТекДанные.Ресурс = Результат;
		ПараметрыПоиска.Ресурс = Результат;
		
		СМ_СметаВызовСервера.ПолучитьОписаниеРесурса(ПараметрыПоиска);
		
		ТекДанные.НаименованиеРесурса = ПараметрыПоиска.НаименованиеРесурса;
		ТекДанные.ЕдиницаИзмеренияРесурса = ПараметрыПоиска.ЕдиницаИзмеренияРесурса;
		ТекДанные.Заменен = Истина;
		ТекДанные.СметныйКодРесурса = ПараметрыПоиска.Код;
		ТекДанные.ВидРесурса = ПараметрыПоиска.ВидРесурса;
		ТекДанные.БазиснаяЦена = ПараметрыПоиска.БазиснаяЦена;
		ТекДанные.БазиснаяЗарплатаМашинистов = ПараметрыПоиска.БазиснаяЗарплМаш;
		ТекДанные.ТекущаяЦена = ПараметрыПоиска.ТекущаяЦена;
		ТекДанные.ТекущаяЗарплатаМашинистов = ПараметрыПоиска.ТекущаяЗарплМаш;
		ТекДанные.ТипМатериала = ПараметрыПоиска.ТипМатериала;
		Если Не СметнаяКомпонента = Неопределено Тогда
			// Если Автозагрузка цен из ИБ , вызывается модуль определения цен ВБ 
			ПолучитьПравоЗагрузкиТекущихЦен(ПараметрыПоиска);
			Если  ПараметрыПоиска.ЗагружатьТекущиеЦены И ЗначениеЗаполнено(ПараметрыПоиска.ФайлСборникаТекущихЦен) Тогда
				СтруктураЦен = Новый Структура();
				СтруктураЦен.Вставить("БазиснаяЦена");
				СтруктураЦен.Вставить("БазиснаяЗарплатаМашинистов");
				СтруктураЦен.Вставить("ТекущаяЦена");
				СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов");
				Район = ПараметрыПоиска.Район;
				ИмяФайлаСборникаТекущихЦен = ПараметрыПоиска.ФайлСборникаТекущихЦен;
				КодРегиональнойБазы = ПараметрыПоиска.КодРегионаФайлаТекущихЦен; 
				СМ_СметаКлиент.ПолучитьЦеныНовогоРесурса(Результат,Район,ИмяФайлаСборникаТекущихЦен,КодРегиональнойБазы,СтруктураЦен); 	
				ТекДанные.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
				ТекДанные.ТекущаяЗарплатаМашинистов = СтруктураЦен.ТекущаяЗарплатаМашинистов;
			КонецЕсли;
		КонецЕсли;
		АдресХранилищаЗамен = ПоместитьВоВременноеХранилище(ТаблРесурсы, Новый УникальныйИдентификатор());
	ИначеЕсли ПараметрыПоиска.МестоЗамены = "НС" Тогда
		ТаблРесурсы = ПараметрыПоиска.ЗаменяемыйРесурс;
		СтарыйРесурс = ТаблРесурсы.СтарыйРесурс;
		ПараметрыПоиска.Вставить("ПозицияРесурса",Объект.Ссылка);
		СМ_СметаВызовСервера.ЗаполнитьДанныеРесурса(Результат,ПараметрыПоиска);
		ТаблРесурсы.Вставить("НовыйРесурс",ПараметрыПоиска.Ресурс);
		ТекДанные = Элементы.РесурсыПозицииЛокальнойСметы.ТекущиеДанные;
		ДопПараметры = Новый Структура("ПараметрыПоиска,ТаблРесурсы,ТекДанные",ПараметрыПоиска,ТаблРесурсы,ТекДанные);
		Определитель = ПараметрыПоиска.Определитель;
		ВидРасценки = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Определитель,"ВидРасценки");
		Если ВидРасценки = ПредопределенноеЗначение("Перечисление.СМ_ВидыРасценки.Транспортировка")
			ИЛИ ВидРасценки = ПредопределенноеЗначение("Перечисление.СМ_ВидыРасценки.Работа") Тогда
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("Продолжить_ПолучитьЗаменуРесурса", ЭтаФорма, ДопПараметры);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Выбран не материал. Продолжить?';"
			+ " en = 'Do you want to continue?'"), Режим, 0);
		Иначе
			Продолжить_ПолучитьЗаменуРесурса(КодВозвратаДиалога.Да, ДопПараметры);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
// Процедура продолжает обработку выбранного значения замены. 
//
// Параметры:
//     Структура - набор необходимых параметров.
//
Процедура Продолжить_ПолучитьЗаменуРесурса(Результат, Структура) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
    КонецЕсли;
	
	ПараметрыПоиска = Структура.ПараметрыПоиска;
	ТекДанные = Структура.ТекДанные;
	ТаблРесурсы = Структура.ТаблРесурсы;
	ТекДанные.Ресурс = ТаблРесурсы.НовыйРесурс;
	
	ТекДанные.НаименованиеРесурса = ?(ТипЗнч(ПараметрыПоиска.Ресурс) = Тип("СправочникСсылка.СМ_Ресурсы"),ПараметрыПоиска.Ресурс.ДлинноеНаименование,ПараметрыПоиска.Ресурс);
	ТекДанные.ЕдиницаИзмеренияРесурса = ПараметрыПоиска.ЕдиницаИзмерения;
	ТекДанные.Заменен = Истина;
	ТекДанные.СметныйКодРесурса = ?(ТипЗнч(ПараметрыПоиска.Ресурс) = Тип("СправочникСсылка.СМ_Ресурсы"),СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ПараметрыПоиска.Ресурс,"Код"),ПараметрыПоиска.ШифрРасценки);
	ВидРесурса = ?(ТипЗнч(ПараметрыПоиска.Ресурс) = Тип("СправочникСсылка.СМ_Ресурсы"),СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ПараметрыПоиска.Ресурс,"ВидРесурса"),СМ_СметаЗагрузкаВызовСервера.ОпределитьВидРесурсаПоШифру(ПараметрыПоиска.ШифрРасценки));
	ТекДанные.ВидРесурса = ВидРесурса;
	ТекДанные.БазиснаяЦена = ПараметрыПоиска.БазисЦена;
	ТекДанные.БазиснаяЗарплатаМашинистов = ПараметрыПоиска.БазисЗарплМаш;
	ТекДанные.ТекущаяЦена = ПараметрыПоиска.ТекЦена;
	ТекДанные.ТекущаяЗарплатаМашинистов = ПараметрыПоиска.ТекЗарплМаш;
	ТекДанные.ТипМатериала = ПредопределенноеЗначение("Перечисление.СМ_ТипыМатериалов.Учтенный");

	АдресХранилищаЗамен = ПоместитьВоВременноеХранилище(ТаблРесурсы, Новый УникальныйИдентификатор());

КонецПроцедуры

&НаКлиенте
Процедура РесурсыПозицииЛокальнойСметыПередУдалением(Элемент, Отказ)
	Отказ = Истина;
	УдалитьРесурсы(Неопределено);
	Возврат;
	// Эрикос.zbikt 26.06.2014
	ТекРесурс = Элементы.РесурсыПозицииЛокальнойСметы.ТекущиеДанные.Ресурс;
	Ресурсы = Новый Структура();
	Ресурсы.Вставить("СтарыйРесурс", ТекРесурс);
	Ресурсы.Вставить("НовыйРесурс");
	АдресХранилищаЗамен = ПоместитьВоВременноеХранилище(Ресурсы, Новый УникальныйИдентификатор());

КонецПроцедуры

&НаКлиенте
Процедура РасчетПоТек(Команда)
	// Эрикос.zbikt 07.07.2014
	// Расчет составляющих прямых затрат по текущим ценам составляющих позицию ресурсов.
	РасчетПоЦенамРесурсовНаСервере(Ложь); 
	РасчитатьСтоимостьНаОбъем();
	РасчитатьТекСтоимостьНаОбъем();
	ЗаполнитьСтандартноеЗначениеЧПИКартинкиРесурса();
КонецПроцедуры

&НаКлиенте
Процедура РасчетПоБазису(Команда)
	// Эрикос.zbikt 07.07.2014
	// Расчет составляющих прямых затрат по баз.ценам составляющих позицию ресурсов.
	РасчетПоЦенамРесурсовНаСервере(Истина);
	РасчитатьСтоимостьНаОбъем();
	РасчитатьТекСтоимостьНаОбъем();
	ЗаполнитьСтандартноеЗначениеЧПИКартинкиРесурса();
КонецПроцедуры

&НаСервере
Процедура РасчетПоЦенамРесурсовНаСервере(ПоБазису)
	
	// Эрикос.zbikt 07.07.2014
	Позиция = РеквизитФормыВЗначение("Объект");
		
	ВариантРасчетаЗМ = СтруктураПараметровРасчетаЛС.ВариантРасчетаЗМ;
	Если ВариантРасчетаЗМ.пустая() Тогда
		ВариантРасчетаЗМ = Перечисления.СМ_ВариантыРасчетаЗМ.Расчетный;
	КонецЕсли;	
	КЧ = Новый КвалификаторыЧисла(20,6);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Число"));
	ОписаниеТиповЧ = Новый ОписаниеТипов(Массив, , ,КЧ);
	
	ТаблЕдСтоим = Новый ТаблицаЗначений;
	ТаблЕдСтоим.Колонки.Добавить("ПрямЗатраты",		ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("ОснЗарплата",		ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("ЭксплМашин",		ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("ЗарплМашинистов",		ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("СтоимМатериалов",		ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("ЗатратыТрудаРабочих",		ОписаниеТиповЧ);
	
	// По базисным (текущим) ценам рассчитываем единичные составляющие прямых затрат.
	СМ_СметаРасчетБазисноИндексныйСервер.РасчетЕдиничныхЗначенийСоставляющих(Позиция,ВариантРасчетаЗМ,ТаблЕдСтоим,ПоБазису);
	Для Каждого Значения Из ТаблЕдСтоим Цикл
		Позиция.ПрямЗатраты = Значения.ПрямЗатраты;
		Позиция.СтоимМатериалов = Значения.СтоимМатериалов;
		Позиция.ЭксплМашин = Значения.ЭксплМашин;
		Позиция.ЗарплМашинистов = Значения.ЗарплМашинистов;
		Позиция.ОснЗарплата = Значения.ОснЗарплата;
		Позиция.ЗатратыТрудаРабочих = Значения.ЗатратыТрудаРабочих;
		Позиция.ЗатратыТрудаМашинистов = Позиция.ЗатратыТрудаМашинистов;
		// При изменении ресурсной части позиции мы не можем откорректировать затраты труда машинистов.
	КонецЦикла;
	ЗначениеВДанныеФормы(Позиция, Объект);
КонецПроцедуры

&НаКлиенте
Процедура КоэффициентыПересчетаПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ТекДанные = Элементы.КоэффициентыПересчета.ТекущиеДанные;
	
	Если НоваяСтрока И (ТекДанные<>Неопределено) И (Не ЗначениеЗаполнено(ТекДанные.ВариантПересчетаЭММ)) Тогда
		ТекДанные.ВариантПересчетаЭММ = СМ_СметаВызовСервера.ПолучитьВариантПересчетаЭММПоУмолчанию();		
	КонецЕсли;
	
КонецПроцедуры

