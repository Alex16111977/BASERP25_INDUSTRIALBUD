&НаКлиенте
Процедура ПересчитатьПЗ()
	
	НоваяПЗ		= Объект.ОснЗарплата + объект.ЭксплМашин + Объект.СтоимМатериалов;
	
	Попытка
		ПЗПоФормуле = Вычислить(объект.ФормулаПЗ);
	Исключение
		ПЗПоФормуле = 0;
	КонецПопытки;
	
	Если НоваяПЗ = 0 Тогда
		объект.ПрямЗатраты = ПЗПоФормуле;
		// Эрикос.zbikt 23.06.2014
		РасчитатьСтоимостьНаОбъем("");
		Возврат;
	КонецЕсли;
	
	Если ПЗПоФормуле = 0 Тогда
		объект.ПрямЗатраты = НоваяПЗ;
		// Эрикос.zbikt 23.06.2014
		РасчитатьСтоимостьНаОбъем("");
		Возврат;
	КонецЕсли;	
	
	Если НоваяПЗ <> ПЗПоФормуле Тогда
		
		ТекстВопроса = НСтр("ru='При расчете по ФОРМУЛЕ значение ПЗ равно: %ПзПоФормуле%, а расчет ПЗ по СОСТАВЛЯЮЩИМ равен: %НоваяПЗ% 
		|Сохранить значение расчета ПЗ по формуле (Кнопка ""Да"") ? Кнопка ""Нет"" оставит расчет ПЗ по составляющим.'");
		ТекстВопроса = СтрЗаменить(ТекстВопроса, "%ПзПоФормуле%", Сокрлп(ПзПоФормуле));
		ТекстВопроса = СтрЗаменить(ТекстВопроса, "%НоваяПЗ%", СокрЛП(НоваяПЗ));
		
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтаФорма, Новый Структура("ПЗПоФормуле,НоваяПЗ",ПЗПоФормуле,НоваяПЗ));
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
	Иначе
		Объект.ПрямЗатраты = НоваяПЗ;
		РасчитатьСтоимостьНаОбъем("");
	КонецЕсли;	
	
	 	// Эрикос.zbikt 23.06.2014
	 
	
КонецПроцедуры	

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОБъект.ПрямЗатраты = Параметры.ПЗПоФормуле;
	Иначе
		Объект.ПрямЗатраты = Параметры.НоваяПЗ;
	КонецЕсли;
	РасчитатьСтоимостьНаОбъем("");
КонецПроцедуры

