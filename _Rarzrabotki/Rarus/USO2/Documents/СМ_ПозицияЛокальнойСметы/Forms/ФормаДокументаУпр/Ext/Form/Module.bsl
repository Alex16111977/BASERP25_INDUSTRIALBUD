	// Методика 1984 года.
	Если СтруктураПараметровРасчетаЛС.Методика1984 Тогда
		Если СтруктураПараметровРасчетаЛС.РасчетНРиСПотПЗ Тогда
			Если (СтруктураПараметровРасчетаЛС.ЭтоБазисноИндексныйУровеньРасценка) И (Не Объект.НеПрименятьИндексы) Тогда
				Элементы.ГруппаКоэффициентыПересчета.Видимость = Не  (СтруктураПараметровРасчетаЛС.БезПримененияКоэффициентов);
				Элементы.ГруппаКоэффициентыПересчета.Доступность = Не  (СтруктураПараметровРасчетаЛС.БезПримененияКоэффициентов);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Не СтруктураПараметровРасчетаЛС.ЭтоРесурсныйМетод Тогда
