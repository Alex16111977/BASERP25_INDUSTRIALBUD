&НаСервере
Процедура РасчитатьТекСтоимостьНаОбъем(ИмяПоля = "", ОбъемИзменен = Ложь)
	
	Если ОбъемИзменен И ВводОбъемовВБазовыхЕдИзм Тогда
		Объект.ОбъемРабот = СМ_СметаВызовСервера.ПересчитатьВбазовыхЕдиницахИзмерения(Объект,Объект.ОбъемРабот);
		Если ЗначениеЗаполнено(Объект.ФормулаОбъема) Тогда
			Объект.ФормулаОбъема = СМ_СметаВызовСервера.ПересчитатьФормулаВбазовыхЕдиницахИзмерения(Объект,Объект.ФормулаОбъема);
	        ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Проверьте формулу!'"), Объект.Ссылка, "ФормулаОбъема");
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяПоля <> "" Тогда
		ЭтаФорма[ИмяПоля+"1"] = Объект[ИмяПоля]*Объект.ОбъемРабот;
		Возврат;
	КонецЕсли;
	
	ТекущаяОснЗарплата1 = Объект.ТекущаяОснЗарплата * Объект.ОбъемРабот;
	ТекущаяЭксплМашин1 = Объект.ТекущаяЭксплМашин * Объект.ОбъемРабот;
	ТекущаяЗарплМашинистов1 = Объект.ТекущаяЗарплМашинистов * Объект.ОбъемРабот;
	ТекущаяСтоимМатериалов1 = Объект.ТекущаяСтоимМатериалов * Объект.ОбъемРабот;
	ТекущаяПрямЗатраты1 = Объект.ТекущаяПрямЗатраты * Объект.ОбъемРабот;
	
КонецПроцедуры

&НаСервере
Процедура РасчитатьТекСтоимостьНаОбъемРегистр()
	
	ТекПоказатели = ПолучитьТекПоказателиРегистр();

	Если ТекПоказатели.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Показатели = ТекПоказатели[0];
	РегТекущаяОснЗарплата = Показатели.ТекущаяОснЗарплата;
	РегТекущаяЭксплМашин = Показатели.ТекущаяЭксплМашин;
	РегТекущаяЗарплМашинистов = Показатели.ТекущаяЗарплМашинистов;
	РегТекущаяСтоимМатериалов = Показатели.ТекущаяСтоимМатериалов;
	РегТекущаяПрямЗатраты = Показатели.ТекущаяПрямЗатраты;
	
	// Чтобы не влияло на округление - берем напрямую из таблицы единичные показатели
	РегТекущаяОснЗарплата1 = Показатели.ТекущаяОснЗарплата * Объект.ОбъемРабот;
	РегТекущаяЭксплМашин1 = Показатели.ТекущаяЭксплМашин * Объект.ОбъемРабот;
	РегТекущаяЗарплМашинистов1 = Показатели.ТекущаяЗарплМашинистов * Объект.ОбъемРабот;
	РегТекущаяСтоимМатериалов1 = Показатели.ТекущаяСтоимМатериалов * Объект.ОбъемРабот;
	РегТекущаяПрямЗатраты1 = Показатели.ТекущаяПрямЗатраты * Объект.ОбъемРабот;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьРесурсы(Команда)
	Для Каждого ИдентификаторСтроки Из Элементы.РесурсыПозицииЛокальнойСметы.ВыделенныеСтроки Цикл
		
		ВыбраннаяСтрока = Объект.РесурсыПозицииЛокальнойСметы.НайтиПоИдентификатору(ИдентификаторСтроки);
		ВыбраннаяСтрока.Удален = Не ВыбраннаяСтрока.Удален;
		
		Если ВыбраннаяСтрока.Удален Тогда
			ТекРесурс = ВыбраннаяСтрока.Ресурс;
			Ресурсы = Новый Структура();
			Ресурсы.Вставить("СтарыйРесурс", ТекРесурс);
			Ресурсы.Вставить("НовыйРесурс");
			АдресХранилищаЗамен = ПоместитьВоВременноеХранилище(Ресурсы, Новый УникальныйИдентификатор());
		КонецЕсли;
		
	КонецЦикла;
	Если Элементы.РесурсыПозицииЛокальнойСметы.ВыделенныеСтроки.Количество()>0 Тогда
		ЗаполнитьСтандартноеЗначениеЧПИКартинкиРесурса();
		Модифицированность = Истина;
	КонецЕсли;
	
	МассивРесурсов = Объект.РесурсыПозицииЛокальнойСметы.НайтиСтроки(Новый Структура("Удален",Ложь));
	Если МассивРесурсов.Количество() = 0 И СтруктураПараметровРасчетаЛС.ЭтоРесурсныйМетод Тогда
		Элементы.ГруппаСтраницТек.ТекущаяСтраница = Элементы.ГруппаСтраницТек.ПодчиненныеЭлементы.ТекущиеРеквизитами;
	Иначе
		Элементы.ГруппаСтраницТек.ТекущаяСтраница = Элементы.ГруппаСтраницТек.ПодчиненныеЭлементы.ТекущиеРегистром;
	КонецЕсли;

КонецПроцедуры

