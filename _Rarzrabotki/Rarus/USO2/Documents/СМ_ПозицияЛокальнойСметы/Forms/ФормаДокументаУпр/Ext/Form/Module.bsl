&НаКлиенте
Процедура ОткрытьФормуЗаявкиНаМатериалы()
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Объект", Объект.Ссылка);
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ПараметрыЗаполнения);
	ФормаНовогоДокумента = ПолучитьФорму("Документ.СМ_ЗаявкаНаМатериал.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма);
 	ФормаНовогоДокумента.Открыть();
КонецПроцедуры

