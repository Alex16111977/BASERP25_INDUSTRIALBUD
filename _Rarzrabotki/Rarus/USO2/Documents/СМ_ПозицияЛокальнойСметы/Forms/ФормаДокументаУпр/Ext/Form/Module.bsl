&НаКлиенте
Процедура ШифрРасценкиПриИзменении(Элемент)
	Если СметнаяКомпонента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если (Не ЗначениеЗаполнено(Объект.РегиональнаяБаза))
		ИЛИ	(Объект.ТипНормативныхСборников = ПредопределенноеЗначение("Перечисление.СМ_ТипыНормативныхСборников.Калькуляция")) Тогда
		Возврат;
	КонецЕсли;
	// Калькуляция можно менять шифр, ничего не меняя
	СтарыйШифр = ЗапомнитьСтарыйШифр();
	ДополнительныеПараметры = Новый Структура("ШифрРасценки,СтарыйШифр", Объект.ШифрРасценки,СтарыйШифр);

	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Обновить показатели расценки %1 по нормативной базе %2 ?'"), Объект.ШифрРасценки, Объект.РегиональнаяБаза);
	Оповещение = Новый ОписаниеОповещения("ОбновитьПоНормативнойБазеОповещение", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ФактОбъемПриИзменении(Элемент)
	
	
	ПроверитьПревышениеФактОбъем();

	// РасчитатьСтоимостьНаФактОбъем("", Истина);
	//// Текущие стоимости  по акту
	// РассчитатьТекСтоимостиПоАкту();
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПревышениеФактОбъем()
	Если СМ_СметаВызовСервера.ЗначениеОпции("СМ_ПодтверждатьПревышениеОбъемаАкта") Тогда
		НовыйОбъем 	= ФактОбъем;	

		Если НовыйОбъем > (Объект.ОбъемРабот-Параметры.ОбъемВсегоБезАкта) Тогда
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ВладелецФайла",  Параметры.Акт);
			ПараметрыФормы.Вставить("ТолькоПросмотр", Ложь);
			ПараметрыФормы.Вставить("РежимВыбора", Истина);
			
			Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеВыбораФайла", ЭтотОбъект);
			ОткрытьФорму("Документ.СМ_АктВыполненныхРабот.Форма.ПрисоединенныеФайлы",ПараметрыФормы,ЭтаФорма,Ложь,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе
			ОчиститьФайлТЧПозиции();
			РасчитатьСтоимостьНаФактОбъем("", Истина);
			РассчитатьТекСтоимостиПоАкту();
			Записать();
			Оповестить("ОбновитьДеревоСметы");
		КонецЕсли;
	Иначе
		 РасчитатьСтоимостьНаФактОбъем("", Истина);
		 РассчитатьТекСтоимостиПоАкту();
		 Записать();
		 Оповестить("ОбновитьДеревоСметы");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораФайла(Результат, ДопПараметры) Экспорт
	Если Не Результат = Неопределено Тогда
		ЗаполнитьФайлТЧПозиции(Результат);
		
		РасчитатьСтоимостьНаФактОбъем("", Истина);
		РассчитатьТекСтоимостиПоАкту();
		Записать();
		Оповестить("ОбновитьДеревоСметы");
	Иначе
		ФактОбъем = Параметры.СтарыйФактОбъем;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФайлТЧПозиции(СтруктураДанных)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Позиция",Объект.Ссылка);
	
	Акт = Параметры.Акт.ПолучитьОбъект();
	МассивСтрок = Акт.Позиции.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() > 0 Тогда
		НоваяСтрока = МассивСтрок[0];	
		НоваяСтрока.СсылкаНаФайл = СтруктураДанных.Файл;
		НоваяСтрока.КомментарийКФайлу = СтруктураДанных.Комментарий;
		Акт.Записать();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОчиститьФайлТЧПозиции()
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Позиция",Объект.Ссылка);
	Акт = Параметры.Акт.ПолучитьОбъект();
	МассивСтрок = Акт.Позиции.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() > 0 Тогда
		НоваяСтрока = МассивСтрок[0];	
		НоваяСтрока.СсылкаНаФайл = Справочники.СМ_АктВыполненныхРаботПрисоединенныеФайлы.ПустаяСсылка();
		НоваяСтрока.КомментарийКФайлу = "";
		Акт.Записать();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЕдиницаИзмеренияПриИзменении(Элемент)
	Объект.Измеритель = Элемент.ТекстРедактирования;
	Если ВводОбъемовВБазовыхЕдИзм Тогда
		Если ЗначениеЗаполнено(Объект.ФормулаОбъема) Тогда
			ФормулаОбъемаПриИзменении(Неопределено);
			ФормулаФактОбъемаПриИзменении(Неопределено);
		КонецЕсли;		
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЕдиницаИзмеренияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВводОбъемовВБазовыхЕдИзм Тогда
		Если ЗначениеЗаполнено(Объект.ФормулаОбъема) Тогда
			Объект.ФормулаОбъема = СМ_СметаВызовСервера.УдалитьФормулуБазовыхЕслиЕсть(Объект.ЕдиницаИзмерения,Объект.ФормулаОбъема);	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Проверьте формулу!'"), Объект.Ссылка, "ФормулаОбъема");
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

// ДокторСофт
&НаКлиенте
Процедура РасчетПриИзменении(Элемент)
	ПроставитьЗначениеВсемПодчиненнымПозициям(Объект.Ссылка,Объект.Расчет);
	Модифицированность = Ложь;
КонецПроцедуры

&НаСервере
Процедура ПроставитьЗначениеВсемПодчиненнымПозициям(ТекущаяСтрока,Значение)
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	Если ТипЗнч(ТекущаяСтрока) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		ТЗПодчиненных = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(ТекущаяСтрока,Ложь,Ложь, Истина, Ложь);
		Для каждого стр Из ТЗПодчиненных Цикл
			СМ_СметаВызовСервера.УстановитьРеквизитДокумента(стр.Ид, "Расчет", Значение, Истина);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТехЧасть(Команда)
	Если СметнаяКомпонента = Неопределено Тогда
		ПоказатьПредупреждение(,НСтр("ru='Сметная компонента не подключена'"));
	Иначе
		СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(,Объект.Ссылка);
		ПараметрыДляОбновления = СМ_СметаВызовСервера.ПолучитьПараметрыДляОбновления(Объект.Ссылка,СтруктураПараметровРасчетаЛС);
		Попытка
			СметнаяКомпонента.ОткрытьТехЧасть(ПараметрыДляОбновления.КодБазы, Строка(ПараметрыДляОбновления.НомерСборника), ПараметрыДляОбновления.ТипСборника);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры
// ДокторСофт

// Перенесение позиции в справочник СМ_НормативныеСборники.
&НаСервере
Процедура ПеренестиВНормСбНаСервере(ПараметрПереноса,РодительПозиции)
	
	Позиция = ПараметрПереноса.Позиция;
	СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(,Позиция);
	Район = СтруктураПараметровРасчетаЛС.Район;
	
	НовыйОбъект = Справочники.СМ_НормативныеСборники.СоздатьЭлемент();
	НовыйОбъект.Родитель = РодительПозиции;
	НовыйОбъект.КодНормативнойРасценки = Позиция.ШифрРасценки;
	НовыйОбъект.ЕдиницаИзмерения = Позиция.ЕдиницаИзмерения;
	НовыйОбъект.Измеритель = Позиция.Измеритель;
	НовыйОбъект.Наименование = СокрЛП(Сред(Позиция.Наименование,1,150));
	НовыйОбъект.ДлинноеНаименование = СокрП(Сред(Позиция.Наименование,151));
	НовыйОбъект.Определитель = Позиция.Определитель;	
	НовыйОбъект.ТипНормативногоСборника = Позиция.ТипНормативныхСборников;
	НовыйОбъект.УровеньЦен = Перечисления.СМ_ДатыБазисныхЦен.Ц2001;
	НовыйОбъект.МассаБруттоТ = Позиция.МассаБрутто;
	НовыйОбъект.МассаНеттоТ = Позиция.МассаНетто;
	НовыйОбъект.Статус = Перечисления.СМ_СтатусыФормированияНормативов.Утвержден;
	
	НоваяЦена = НовыйОбъект.ЦеныНормативныхСборников.Добавить();
	НоваяЦена.РегиональнаяБаза = Позиция.РегиональнаяБаза;
	НоваяЦена.Район = Район;
	НоваяЦена.ПрямыеЗатраты = Позиция.ПрямЗатраты;
	НоваяЦена.ОсновнаяЗарплата = Позиция.ОснЗарплата ;
	НоваяЦена.ЭксплуатацияМашинИМеханизмов = Позиция.ЭксплМашин;
	НоваяЦена.ВТомЧислеЗарплатаМашинистов = Позиция.ЗарплМашинистов;
	НоваяЦена.СтоимостьМатериалов = Позиция.СтоимМатериалов;
	НоваяЦена.СтоимостьОборудования = Позиция.Оборудование;
	НоваяЦена.ВозвратМатериалов = Позиция.ВозвратМатер;
	НоваяЦена.ЗатратыТрудаРабочих = Позиция.ЗатратыТрудаРабочих;
	НоваяЦена.ПроцентНР = Позиция.НакладныеРасходыТекущие;
	НоваяЦена.ПроцентСП = Позиция.СметнаяПрибыльТекущие;
	// Рассчитываемые реквизиты.
	НоваяЦена.НакладныеРасходыСумма = Окр((Позиция.ОснЗарплата + Позиция.ЗарплМашинистов)* Позиция.НакладныеРасходыТекущие/100,2);
	НоваяЦена.СметнаяПрибыльСумма = Окр((Позиция.ОснЗарплата + Позиция.ЗарплМашинистов)* Позиция.СметнаяПрибыльТекущие/100,2);
	
	ТЧРесурсыПозиции = Позиция.РесурсыПозицииЛокальнойСметы;
	Для Каждого РесурсПозиции Из ТЧРесурсыПозиции Цикл
		
		НовыйРесурс = НовыйОбъект.РесурсыНормативныхСборников.Добавить();
		НовыйРесурс.Ресурс = РесурсПозиции.Ресурс;
		НовыйРесурс.ТипРесурса = РесурсПозиции.ТипМатериала;
		НовыйРесурс.НормаРасхода = РесурсПозиции.НормаРасхода;
		НовыйРесурс.НаименованиеРесурса = РесурсПозиции.НаименованиеРесурса;
		НовыйРесурс.ЕдиницаИзмеренияРесурса = РесурсПозиции.ЕдиницаИзмеренияРесурса;
		НовыйРесурс.КодРесурса =  РесурсПозиции.СметныйКодРесурса;
	КонецЦикла;
	
	ТЧСоставРабот = Позиция.СоставРабот;
	Для Каждого Работа Из ТЧСоставРабот Цикл
		
		НовыйСостав = НовыйОбъект.СоставРабот.Добавить();
		НовыйСостав.Номер = Работа.Номер;
		НовыйСостав.НаименованиеРаботы = Работа.НаименованиеРаботы;
	КонецЦикла;

	Попытка
		НовыйОбъект.Записать();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Расценка сохранена в справочнике Нормативные сборники'"));

	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не удалось сохранить расценку в справочнике Нормативные сборники'"));
	КонецПопытки;

	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВНормСб(Команда)
	ПараметрПереноса = Новый Структура;
	ПараметрПереноса.Вставить("Позиция",Объект.Ссылка);
	ОписаниеОЗакрытииФормыВыбораНормСборника = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораНормСборника",ЭтаФорма,ПараметрПереноса);
	ОткрытьФорму("Справочник.СМ_НормативныеСборники.ФормаВыбораГруппы",ПараметрПереноса,ЭтаФорма,,,,ОписаниеОЗакрытииФормыВыбораНормСборника,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыВыбораНормСборника(Результат,ПараметрПереноса) Экспорт
	Если Результат <> Неопределено Тогда
		РодительПозиции = Результат;
		ПеренестиВНормСбНаСервере(ПараметрПереноса,РодительПозиции);
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ВидимостьКнопкиТехчасть()
	
	// Кнопка "Тех. часть"
	Если ЗначениеЗаполнено(Объект.РегиональнаяБаза) И СметнаяКомпонента <> Неопределено Тогда
		Элементы.ФормаОткрытьТехЧасть.Видимость  	= Истина;
		Элементы.ФормаОткрытьТехЧасть.Доступность   = Истина;
	Иначе
		Элементы.ФормаОткрытьТехЧасть.Видимость  	= Ложь;
		Элементы.ФормаОткрытьТехЧасть.Доступность   = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПлюсМинусВНБ(Команда)
	
	Если Элементы.РесурсыПозицииЛокальнойСметы.ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;

	ФайлСборникаТекущихЦен = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Объект.ИДСметы, "ФайлСборникаТекущихЦен");
	Если Не ЗначениеЗаполнено(ФайлСборникаТекущихЦен) Тогда
		Возврат;	
	КонецЕсли;
	
	Район = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Объект.ИДСметы, "Район");
	ИдФормы = СметнаяКомпонента.ПоказатьОкноТекущихЦен(СокрЛП(ФайлСборникаТекущихЦен), Строка(СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Район,"Код")),,,Истина,Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	Если Источник = "AddIn.Base" Тогда
		Если Событие = "SelectRasc"+ИдФормы Тогда
			Если Не СтрНайти(ВариантВыбораВНБ,"ТекЦены") = 0 Тогда // из СНБ
				Если ЗначениеЗаполнено(Данные) Тогда
					СМ_СметаКлиент.ОбновитьПозициюПоНорме(Объект.Ссылка,Данные);
					ЭтаФорма.Прочитать();
				КонецЕсли;
			Иначе
				Результат = ЗаполнитьДанныеРесурса(Данные);
				Если Результат = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Данный ресурс не найден в БД.'"));
					Возврат;
				КонецЕсли;
				
				// Вставка Позиции минус текущий ресурс 
				ТекДанные 				= Элементы.РесурсыПозицииЛокальнойСметы.ТекущиеДанные;
				НормаРасхода 			= СтрЗаменить(ТекДанные.НормаРасхода,",",".");
				СтарыйРесурс 			= ТекДанные.Ресурс;
				СтараяЕдиницаИзмерения 	= ПолучитьЕдиницуИзмерения(СтарыйРесурс);
				
				ПараметрыПоиска 					= СМ_СметаКлиент.ИнициироватьСтруктуруОписанияРесурса(Объект, СтруктураПараметровРасчетаЛС);
				ПараметрыПоиска.Ресурс 				= СтарыйРесурс;
				ПараметрыПоиска.БазиснаяЦена 		= ТекДанные.БазиснаяЦена;
				ПараметрыПоиска.ТекущаяЦена 		= ТекДанные.ТекущаяЦена;
				ПараметрыПоиска.БазиснаяЗарплМаш 	= ТекДанные.БазиснаяЗарплатаМашинистов;
				ПараметрыПоиска.ТекущаяЗарплМаш 	= ТекДанные.ТекущаяЗарплатаМашинистов;
				ПараметрыПоиска.Код 				= ТекДанные.СметныйКодРесурса;
				ПараметрыПоиска.ВидРесурса 			= ТекДанные.ВидРесурса;
				ПараметрыПоиска.ТипМатериала 		= ТекДанные.ТипМатериала;
				ПараметрыПоиска.НеИндексировать 	= Истина;
				ПараметрыПоиска.Норма 				= -1 * НормаРасхода;
				ПараметрыПоиска.Вставить("СметныйКодРесурса",ТекДанные.СметныйКодРесурса);

				ДобавитьЗаРасценкуНаСервере(ПараметрыПоиска);
				
				ПриЗакрытииФормыВыбораРесурсаСНБ(Результат.Ресурс, ПараметрыПоиска);
				
				ИдФормы = ИдФормы + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 

КонецПроцедуры

&НаСервере
Функция ПересчитатьНорму(Норма,СтараяЕдиницаИзмерения,НоваяЕдиницаИзмерения)
	НоваяНорма = Норма;
	БазоваяСтарая = СтараяЕдиницаИзмерения.БазоваяЕдиница;
	БазоваяНовая = НоваяЕдиницаИзмерения.БазоваяЕдиница;
	Если БазоваяНовая <> Неопределено Тогда
		Если БазоваяНовая = СтараяЕдиницаИзмерения Тогда
			Если НоваяЕдиницаИзмерения.КоэффициентПеревода <> 0 Тогда
				НоваяНорма = НоваяНорма / НоваяЕдиницаИзмерения.КоэффициентПеревода; 
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	Если БазоваяСтарая <> Неопределено Тогда
		Если БазоваяСтарая = НоваяЕдиницаИзмерения Тогда
			Если СтараяЕдиницаИзмерения.КоэффициентПеревода <> 0 Тогда
				НоваяНорма = НоваяНорма * СтараяЕдиницаИзмерения.КоэффициентПеревода; 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат НоваяНорма;
КонецФункции

Функция ПолучитьЕдиницуИзмерения(СтарыйРесурс)
	ЕдИзм = Неопределено;
	Если СтарыйРесурс <> Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	СправочникСмета.Ссылка КАК Ресурс,
		|	СправочникСмета.ЕдиницаИзмерения КАК ЕдиницаИзмерения
		|ИЗ
		|	Справочник.СМ_Ресурсы КАК СправочникСмета
		|ГДЕ
		|	СправочникСмета.Код = &Шифр";
		Запрос.УстановитьПараметр("Шифр",СтарыйРесурс.Код);
		РесурсыДанные = Запрос.Выполнить().Выбрать();
		Если РесурсыДанные.Следующий() Тогда
			ЕдИзм = РесурсыДанные.ЕдиницаИзмерения;
		КонецЕсли; 
	КонецЕсли; 
	Возврат ЕдИзм;

КонецФункции

Функция ЗаполнитьДанныеРесурса(Данные)
	ТаблицаРесурса = СМ_СметаЗагрузкаВызовСервера.ЗагрузитьТекущиеЦеныВТаблицу(Данные);
	Если ТаблицаРесурса.Количество()>0 Тогда
		СтрРесурс = ТаблицаРесурса[0];
		Ресурс = НайтиРесурсПоШифру(СтрРесурс.ШифрРасценки);
		Если Ресурс = Неопределено Тогда
			Возврат Неопределено;
		Иначе
			Структура = Новый Структура("Норма,Ресурс,ЕдиницаИзмерения",СтрРесурс.ОбъемРабот,Ресурс,СтрРесурс.ЕдиницаИзмерения);
			Возврат Структура;
		КонецЕсли;
	КонецЕсли;
КонецФункции

// Поиск в справочнике ресурсов.
//
Функция НайтиРесурсПоШифру(Шифр)
	Ресурс = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		               |	СправочникСмета.Ссылка КАК Ресурс
	    	           |ИЗ
	        	       |	Справочник.СМ_Ресурсы КАК СправочникСмета
	            	   |ГДЕ
		               |	СправочникСмета.Код = &Шифр";
	Запрос.УстановитьПараметр("Шифр",Шифр);
	РесурсыДанные = Запрос.Выполнить().Выбрать();
	Если РесурсыДанные.Следующий() Тогда
		Ресурс = РесурсыДанные.Ресурс;
	КонецЕсли; 
	Возврат Ресурс;
КонецФункции

