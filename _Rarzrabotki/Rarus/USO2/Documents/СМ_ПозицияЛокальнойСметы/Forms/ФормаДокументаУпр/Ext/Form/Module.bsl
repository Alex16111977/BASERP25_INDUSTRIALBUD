	    КонецЕсли;
		ТекФормула = ОчиститьФормулу(ТекФормула);
		Объект.ФормулаКоэффициентаПересчетаЦен = ТекФормула;
		Объект.КоэффициентПересчетаЦен = Окр(Вычислить(ТекФормула),7);
