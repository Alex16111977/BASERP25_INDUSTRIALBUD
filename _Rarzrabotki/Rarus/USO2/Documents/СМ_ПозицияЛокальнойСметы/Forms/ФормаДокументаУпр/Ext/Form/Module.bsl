	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоНС(Команда)

	ОбновитьПоНССервер();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоНССервер()
	
	// Поиск нормативного сборника, поиск производится по коду расценки, типу сборника, СНБ позиции.
	// Если СНБ не заполнена, поиск производится без учета СНБ.
	НормативныйСборник = СМ_СметаВызовСервера.НайтиНормативныйСборник(Объект.ТипНормативныхСборников,Объект.ШифрРасценки, Объект.РегиональнаяБаза);
	Если ЗначениеЗаполнено(НормативныйСборник) Тогда
		ТекОбъект = РеквизитФормыВЗначение("Объект");
		СМ_СметаВызовСервера.ОбновитьПозициюПоНормативномуСборнику(ТекОбъект,Объект.ИДСметы,Объект.ИДРодителя,НормативныйСборник);
		ЗначениеВРеквизитФормы(ТекОбъект,"Объект");
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура осуществляет действия после подтверждения пользователем пересчета позиции.
// ПАРАМЕТРЫ:
//// Результат - ответ пользователя на диалог.
//// Параметры - дополнительные параметры переданные при формировании вопроса пользователю.
&НаКлиенте
