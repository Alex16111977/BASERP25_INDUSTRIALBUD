	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	Иначе
		ЗаписатьОбъект();
	КонецЕсли;
	ВыполнитьРасчетНаСервере();
	ЗагрузитьДвиженияВТаблицы();
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьРасчетНаСервере()
	
