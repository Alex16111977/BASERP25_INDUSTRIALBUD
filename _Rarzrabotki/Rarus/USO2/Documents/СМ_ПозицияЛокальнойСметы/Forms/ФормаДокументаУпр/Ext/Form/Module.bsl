&НаСервере
Процедура УдалитьСтрокиДемонтажа()
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ТипПоправки",Перечисления.СМ_ТипыПоправок.ДемонтажМДС);
	МассивСтрок = Объект.ПоправкиПозиции.НайтиСтроки(СтруктураОтбора);
	Для Каждого ТекСтрока Из МассивСтрок Цикл
		Объект.ПоправкиПозиции.Удалить(ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДемонтажПриИзмененииНаСервере()
	// Эрикос.zbikt 11.06.2014
	
	Позиция = РеквизитФормыВЗначение("Объект");
	// снимается флаг применить с поправок
	Для Каждого СтрокаТЧ Из Позиция.ПоправкиПозиции Цикл
		СтрокаТЧ.Применить = Ложь;
	КонецЦикла;
	
	Для Каждого СтрокаТЧ Из Позиция.РесурсыПозицииЛокальнойСметы Цикл
		Если СтрокаТЧ.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
			СтрокаТЧ.Удален = Позиция.Демонтаж;
		КонецЕсли;
	КонецЦикла;
	
	// Расчет составляющих прямых затрат по баз.ценам составляющих позицию ресурсов
	ВариантРасчетаЗМ = Перечисления.СМ_ВариантыРасчетаЗМ.Расчетный;
	КЧ = Новый КвалификаторыЧисла(20,6);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Число"));
	ОписаниеТиповЧ = Новый ОписаниеТипов(Массив,,,КЧ);
	
	ТаблЕдСтоим = Новый ТаблицаЗначений;
	ТаблЕдСтоим.Колонки.Добавить("ПрямЗатраты",ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("ОснЗарплата",ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("ЭксплМашин",ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("ЗарплМашинистов",ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("СтоимМатериалов",ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("ЗатратыТрудаРабочих",ОписаниеТиповЧ);
	
	// По базисным ценам рассчитываем единичные составляющие прямых затрат
	СМ_СметаРасчетБазисноИндексныйСервер.РасчетЕдиничныхЗначенийСоставляющих(Позиция,ВариантРасчетаЗМ,ТаблЕдСтоим);
	Для Каждого Значения Из ТаблЕдСтоим Цикл
		Позиция.СтоимМатериалов = Значения.СтоимМатериалов;
		Позиция.ЭксплМашин = Значения.ЭксплМашин;
		Позиция.ОснЗарплата = Значения.ОснЗарплата;
		Если Не Позиция.Демонтаж Тогда
			Позиция.ПрямЗатраты = Значения.ПрямЗатраты;
			Позиция.ЗарплМашинистов = Значения.ЗарплМашинистов;
			Позиция.ЗатратыТрудаРабочих = Значения.ЗатратыТрудаРабочих;
			Позиция.ЗатратыТрудаМашинистов = Позиция.ЗатратыТрудаМашинистов;
			Позиция.ОснЗарплата = Значения.ОснЗарплата;
			Если Сред(Позиция.Наименование,1,9) = НСтр("ru = 'Демонтаж.'") Тогда
				Позиция.Наименование = СокрЛ(Сред(Позиция.Наименование,10));
			КонецЕсли;	
		Иначе
			Позиция.ПрямЗатраты = Позиция.ЭксплМашин + Позиция.ОснЗарплата;
			Позиция.Наименование =  НСтр("ru = 'Демонтаж.'")+" " + Позиция.Наименование; 

		КонецЕсли;
		// При изменении ресурсной части позиции, мы не можем
		// откорректировать затраты труда машинистов.
	КонецЦикла;
	ЗначениеВДанныеФормы(Позиция, Объект);

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьПозицию(Команда)
	Если ЭтотОбъект.Модифицированность Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("РассчетПозиции",ЭтаФорма);
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru='Для расчета необходимо сохранить изменения. Записать документ?'"),РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормулаОбъемаПриИзменении(Элемент)
	
	ТекФормула 		= СокрЛП(Объект.ФормулаОбъема);
    ФормулаИзменена = Ложь;
	Если ЗначениеЗаполнено(ТекФормула) Тогда
		
		ТекПозиция = СтрНайти(ТекФормула,"=");
		Если ТекПозиция > 0 Тогда
			ТекФормула = СокрЛП(Сред(ТекФормула,2));
		КонецЕсли;
		
		// Поиск и подстановка параметров в формулу из позиции ЛС
		МассивПараметров = СМ_СметаКлиентСервер.ПолучитьСписокПараметровФормулы(ТекФормула);
		Если МассивПараметров.Количество() > 0 Тогда
			//СтруктураПараметров = СМ_СметаКлиентСервер.ЗаполнитьЗначенияПараметров(МассивПараметров,Объект.ИДСметы);
			СтруктураПараметров = ЗаполнитьЗначенияПараметров(МассивПараметров);
			ТекФормула 			= СМ_СметаКлиентСервер.ПодставитьПараметрыВФормулу(ТекФормула,СтруктураПараметров);
		КонецЕсли;
		
		Попытка
			ТекФормула 	= СтрЗаменить(ТекФормула,",",".");
			Формула 	= "ТекОбъем = " + ТекФормула+"; Объект.ОбъемРабот = ТекОбъем;";
			Выполнить(Формула);
			
			Если Не ЗначениеЗаполнено(Объект.НормаРасходаРесурса) Тогда
				Объект.НормаРасходаРесурса = 1;	
			КонецЕсли;
			Объект.КоличествоРесурса = Объект.ОбъемРабот / Объект.НормаРасходаРесурса;
			
			// Эрикос.zbikt 23.06.2014
			РасчитатьСтоимостьНаОбъем("", Истина);
			// Эрикос.zbikt 23.06.2014
			ФормулаИзменена = Истина;
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Ошибка в формуле, объем не изменен'"));
		КонецПопытки;
		
		Если ЗначениеЗаполнено(Объект.Ссылка) И ФормулаИзменена И СМ_СметаВызовСервера.ЕстьПривязанныеПозиции(Объект.Ссылка) Тогда
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбъем", ЭтаФорма);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Изменять пропорционально объем привязанных позиций?';"
			+ " en = 'Do you want to continue?'"), Режим, 0);
		КонецЕсли;

	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ЗаполнитьЗначенияПараметров(МассивПараметров)
	
	СтруктураПараметров = СМ_СметаКлиентСервер.ЗаполнитьЗначенияПараметров(МассивПараметров,Объект.ИДСметы);
	Возврат СтруктураПараметров;
	
КонецФункции

&НаКлиенте
Процедура ФормулаФактОбъемаПриИзменении(Элемент)
	
	ТекОбъем = ФактОбъем;
	Если ЗначениеЗаполнено(ФормулаФактОбъема) Тогда
		ФормулаФактОбъема = ОчиститьФормулу(ФормулаФактОбъема);
		Попытка
			Формула = "ТекОбъем = " + ФормулаФактОбъема+"; ФактОбъем = ТекОбъем;";
			Выполнить(Формула);
			// Эрикос.zbikt 23.06.2014
			РасчитатьСтоимостьНаФактОбъем("", Истина);  // - Судариков: внутри процедуры все на Объект.Объем работ завязано. Видимо, она не подходит.
			// Эрикос.zbikt 23.06.2014
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Ошибка в формуле, объем не изменен'"));
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

