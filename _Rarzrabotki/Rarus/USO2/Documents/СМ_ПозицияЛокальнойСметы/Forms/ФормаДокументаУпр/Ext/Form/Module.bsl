&НаКлиенте
Процедура ПослеЗакрытияВопросаМатериалы(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Объект.Демонтаж = Ложь;
        Возврат;
    КонецЕсли;
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ТипПоправки",ПредопределенноеЗначение("Перечисление.СМ_ТипыПоправок.ДемонтажМДС"));
	ОписаниеОЗакрытииФормыВыбораПоправок = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораПоправок",ЭтаФорма,);
	ОткрытьФорму("Справочник.СМ_ПоправкиПоТехническимЧастям.Форма.ФормаВыбораПоправокДемонтаж",ПараметрыФормы,ЭтаФорма,,,,ОписаниеОЗакрытииФормыВыбораПоправок,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ДемонтажПриИзмененииНаСервере();
	РасчитатьСтоимостьНаОбъем();
	РасчитатьТекСтоимостьНаОбъем();
	ЗаполнитьСтандартноеЗначениеЧПИКартинкиРесурса();

КонецПроцедуры

