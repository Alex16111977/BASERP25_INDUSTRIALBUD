#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Раздел") И Параметры.Свойство("Позиция") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("ИДРодителя", Параметры.Раздел);
		Список.Параметры.УстановитьЗначениеПараметра("Позиция", Параметры.Позиция);
		Список.Параметры.УстановитьЗначениеПараметра("ИДСметы", Параметры.Позиция.ИДСметы);
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("ИДРодителя", Неопределено);
		Список.Параметры.УстановитьЗначениеПараметра("Позиция", Неопределено);
		Список.Параметры.УстановитьЗначениеПараметра("ИДСметы", Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.Список.ТекущиеДанные;	
	ЭтаФорма.Закрыть(ТекСтрока.Ссылка);

КонецПроцедуры

#КонецОбласти