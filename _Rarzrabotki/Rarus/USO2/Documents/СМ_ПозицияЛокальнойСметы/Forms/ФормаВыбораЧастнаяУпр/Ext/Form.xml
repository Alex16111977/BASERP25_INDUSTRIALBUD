			<UseAlways>
				<Field>Список.Ref</Field>
				<Field>Список.Наименование</Field>
				<Field>Список.ПорНомер</Field>
				<Field>Список.ШифрРасценки</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ПозицияЛокальнойСметы.Ссылка,
	ПозицияЛокальнойСметы.ШифрРасценки,
	ПозицияЛокальнойСметы.Наименование,
	ВложенныйЗапрос.ПорНомер
ИЗ
	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			СМ_НумерацияПозицийЛокальныхСмет.Раздел КАК Раздел,
			СМ_НумерацияПозицийЛокальныхСмет.Позиция КАК Позиция,
			СМ_НумерацияПозицийЛокальныхСмет.ПорНомер КАК ПорНомер,
			СМ_НумерацияПозицийЛокальныхСмет.Смета КАК Смета
		ИЗ
			РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
		ГДЕ
			СМ_НумерацияПозицийЛокальныхСмет.Смета = &amp;ИДСметы) КАК ВложенныйЗапрос
		ПО ПозицияЛокальнойСметы.Ссылка = ВложенныйЗапрос.Позиция
			И ПозицияЛокальнойСметы.ИДСметы = ВложенныйЗапрос.Смета
ГДЕ
	ПозицияЛокальнойСметы.ИДРодителя = &amp;ИДРодителя
	И ПозицияЛокальнойСметы.Определитель.ВидРасценки = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыРасценки.Работа)
	И ПозицияЛокальнойСметы.Ссылка &lt;&gt; &amp;Позиция</QueryText>
				<MainTable>Document.СМ_ПозицияЛокальнойСметы</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>ПорНомер</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
