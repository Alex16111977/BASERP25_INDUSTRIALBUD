
#Область РасчетРаздела

Процедура ВыполнитьРасчетТекущегоРаздела(СсылкаРаздел, Акт = Неопределено)
	
	СтруктураПараметровОтбораРС = СМ_СметаВызовСервера.ПолучитьСтруктуруДанныхДляОтборовРегистра(СсылкаРаздел, Акт, "СМ_РазделЛокальнойСметы");
	
	Если НЕ ЗначениеЗаполнено(СтруктураПараметровОтбораРС.СсылкаНаСмету) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Нарушена структура данных!'"));
		Возврат;
	КонецЕсли;
	
	СМ_СметаРасчетВызовСервера.СформироватьИтогиПоРазделу(СсылкаРаздел, СтруктураПараметровОтбораРС.СсылкаНаСмету, Акт, СтруктураПараметровОтбораРС);
		
КонецПроцедуры

Процедура ВыполнитьРасчет(ОбъектРаздел, ПозицииУжеРассчитаны = Ложь, СметаУжеРассчитана = Ложь, Акт = Неопределено)
	
	Если Не ПозицииУжеРассчитаны Тогда
		
		// Получаем подчиненные разделу позиции локальной сметы
		ТабРезультат = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(ОбъектРаздел.Ссылка, ложь, Истина, Истина, Ложь);
		Для Каждого ТекСтрока Из ТабРезультат Цикл
			// Пересчитываем позиции локальной сметы
			ТекОбъект = ТекСтрока.Ид.ПолучитьОбъект();
			Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(ТекОбъект, Истина, Акт);
		КонецЦикла;
		
		// Получаем подчиненные разделу позиции локальной сметы
		ТабРезультат = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(ОбъектРаздел.Ссылка, Истина, Ложь, Ложь, Ложь);
		Для Каждого ТекСтрока Из ТабРезультат Цикл
			// Пересчитываем разделы локальной сметы
			ТекОбъект = ТекСтрока.Ид.ПолучитьОбъект();
			Документы.СМ_РазделЛокальнойСметы.Перерасчет(ТекОбъект, Ложь, Истина, Акт);
		КонецЦикла;
		
	КонецЕсли;	
	
	Если ТипЗнч(ОбъектРаздел.Ссылка) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
		Если ОбъектРаздел.Расчет Тогда
			ВыполнитьРасчетТекущегоРаздела(ОбъектРаздел, Акт);
		Иначе
			СМ_СметаВызовСервера.УдалитьДвижения(СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(ОбъектРаздел,"СМ_РазделЛокальнойСметы"), Акт);
		КонецЕсли;
		
		Если Не СметаУжеРассчитана Тогда
			
			РодительОбъект = ОбъектРаздел.ИДРодителя.ПолучитьОбъект();
			Если ТипЗнч(РодительОбъект.Ссылка) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
				Документы.СМ_РазделЛокальнойСметы.Перерасчет(РодительОбъект, Истина, Ложь, Акт);	
			ИначеЕсли Акт = Неопределено Тогда
				// смета
				Документы.СМ_ЛокальнаяСмета.Перерасчет(РодительОбъект, Истина);
			Иначе
				Документы.СМ_АктВыполненныхРабот.Перерасчет(Акт, Истина);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Основная процедура расчета позиции, выполняет пересчет позиции
// Параметры:
//   РодительОбъект - ДокументОбъект.СМ_РазделЛокальнойСметы или ДокументСсылка.СМ_РазделЛокальнойСметы.
//   ПозицииУжеРассчитаны - Булево - Истина - подчиненные позиции расчитаны и их пересчет не требуется, 
//   					     		 Ложь - требуется пересчет подчиненных позиций.
//   СметаУжеРассчитана - Булево - Истина - смета уже рассчитана и ее пересчет не требуется, 
//   					           Ложь - требуется пересчет вышестоящей сметы.
//   Акт - ДокументОбъект.СМ_АктВыполненныхРабот или ДокументСсылка.СМ_АктВыполненныхРабот.
//         Задается если происходит пересчет позиции акта.
Процедура Перерасчет(РодительОбъект, ПозицииУжеРассчитаны = Ложь, СметаУжеРассчитана = Ложь, Акт = Неопределено) Экспорт
	
	ВыполнитьРасчет(РодительОбъект, ПозицииУжеРассчитаны, СметаУжеРассчитана, Акт);
	
КонецПроцедуры

#КонецОбласти
