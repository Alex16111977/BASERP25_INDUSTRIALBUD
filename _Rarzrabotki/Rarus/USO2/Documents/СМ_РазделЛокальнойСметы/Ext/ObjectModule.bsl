#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка  Тогда
		Возврат;
	КонецЕсли;

	Если Ссылка.Пустая() И Не ДополнительныеСвойства.Свойство("Смета3") Тогда
		// Это совсем крайний вариант, вообще, мы ожидаем, что НомерВДереве всегда заполняется.
		НомерВДеревеНовый = СМ_СметныйСоставВызовСервера.ПолучитьМаксимальныйНомерВДереве(ИДСметы, ИДРодителя) + 0.01;
		СМ_СметаВызовСервера.УстановитьНомерДокумента(ЭтотОбъект,,, НомерВДеревеНовый, , "СМ_РазделЛокальнойСметы");
	ИначеЕсли ДополнительныеСвойства.Свойство("НомерВДереве") Тогда
		СМ_СметаВызовСервера.УстановитьНомерДокумента(ЭтотОбъект,ДополнительныеСвойства.ПорНомер,ДополнительныеСвойства.НомерВПределахСметы,ДополнительныеСвойства.НомерВДереве, , "СМ_РазделЛокальнойСметы");
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если ОбменДанными.Загрузка  Тогда
		Возврат;
	КонецЕсли;

	Документы.СМ_РазделЛокальнойСметы.Перерасчет(ЭтотОбъект, Ложь, Ложь);
		
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

