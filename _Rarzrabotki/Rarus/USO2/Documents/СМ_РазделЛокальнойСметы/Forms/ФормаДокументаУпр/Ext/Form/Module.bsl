#Область ОбработчикиСобытий

//	ФОРМА

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Не ЗначениеРасчета = Объект.Расчет Тогда
		СМ_СметаВызовСервера.УстановитьРасчетУПодчиненных(Объект.Ссылка, Объект.Расчет);	
	КонецЕсли;
	
	Документы.СМ_РазделЛокальнойСметы.Перерасчет(ТекущийОбъект, Ложь, Ложь, ?(Параметры.РазделАкта, Параметры.Акт, Неопределено));// sudav - замена 
	
	ЗаписатьЗначенияПоАкту();
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Отказ = СМ_ЗащитаКлиент.ЗапускОбъекта();
	Если Не Отказ Тогда
		УправлениеВидимостью();
	КонецЕсли;
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.Свойства") Тогда
		МодульУправлениеСвойствамиКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеСвойствамиКлиент");
		МодульУправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;

	Если Параметры.ПоказатьРядом Тогда
		ПодключитьОбработчикОжидания("ЗакрепитьСправа",1);
	КонецЕсли;                                                                         

КонецПроцедуры

&НаКлиенте
Процедура ЗакрепитьСправа()
    Если ЭтаФорма.ВводДоступен() Тогда                          
        WSHShell = Новый COMОбъект("WScript.Shell");
        WSHShell.SendKeys("%");
        WSHShell.SendKeys("{DOWN 5}");
        WSHShell.SendKeys("{RIGHT}");
        WSHShell.SendKeys("{UP 5}");
		WSHShell.SendKeys("{ENTER}");
		ОтключитьОбработчикОжидания("ЗакрепитьСправа");
		ПодключитьОбработчикОжидания("АктивизируемФормуСметы",0.1,Истина);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура АктивизируемФормуСметы() 
	ОткрытыеОкна = ПолучитьОкна();
	Для Каждого ТекОкно Из ОткрытыеОкна Цикл
		Если ТекОкно.Основное ИЛИ ТекОкно.НачальнаяСтраница Тогда
			Продолжить;
		КонецЕсли;
		ФормаОкна = ТекОкно.Содержимое[0];
		Если ЭтаФорма.ВладелецФормы = ФормаОкна Тогда
			ФормаОкна.Активизировать();
		КонецЕсли;
	КонецЦикла;
	ОтключитьОбработчикОжидания("АктивизируемФормуСметы");
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОбновитьСтруктуруСметы();
	
	Если Параметры.РазделАкта Тогда
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("АктВыполненныхРабот",Параметры.Акт);
		Оповестить("ОбновитьДерево",СтруктураПараметров);
	Иначе
		СписокДействий = Новый Массив;
		СписокДействий.Добавить("ОбновитьДерево");
		СписокДействий.Добавить("ПеренумероватьДерево");
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("СписокДействий",СписокДействий);
		СтруктураПараметров.Вставить("Смета",Объект.ИДСметы);
		СтруктураПараметров.Вставить("НовыйОбъект",Объект.Ссылка);
		Оповестить("ОбновитьДеревоСметы",СтруктураПараметров);
	КонецЕсли;
	УправлениеВидимостью();
	
	Если Параметры.ПоказатьРядом Тогда
		ПодключитьОбработчикОжидания("АктивизируемФормуСметы",0.1,Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
    ЭтотОбъект.ПроверитьЗаполнение();
КонецПроцедуры

//	ЭЛЕМЕНТЫ ФОРМЫ

&НаКлиенте
Процедура РазделОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка	= Ложь;
	
	ДополнительныеПараметры	= Новый Структура("ВыбранноеЗначение", ВыбранноеЗначение);
	
	ОписаниеОповещения		= Новый ОписаниеОповещения("РазделПриИзмененииОповещениеНаКлиенте", ЭтотОбъект, ДополнительныеПараметры);
	
	Кнопки	= Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Отмена	, "Отмена");
	Кнопки.Добавить(КодВозвратаДиалога.ОК		, "Продолжить");
	
	ПоказатьВопрос(ОписаниеОповещения, НСтр("ru='Будет изменено наименование для печати!';"), Кнопки);
	
КонецПроцедуры

&НаКлиенте
Процедура РазделКорректируемыйНажатие(Элемент, СтандартнаяОбработка)
	Пар = Новый Структура("Ключ", Объект.КорректируетРаздел);
	ОткрытьФорму("Документ.СМ_РазделЛокальнойСметы.ФормаОбъекта",Пар,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	СтандартнаяОбработка = Ложь;	

КонецПроцедуры

&НаКлиенте
Процедура КоэффПолнСтоимРаботПриИзменении(Элемент)
	Если Объект.КоэффПолнСтоимРабот <> 0  Тогда
		Объект.КоэффОснЗарплаты = Объект.КоэффПолнСтоимРабот;
		Объект.КоэффОборуд = Объект.КоэффПолнСтоимРабот;
		Объект.КоэффСтоимЗарплатеМашин = Объект.КоэффПолнСтоимРабот;
		Объект.КоэффСтоимМатериалов =  Объект.КоэффПолнСтоимРабот;
		Объект.КоэффСтоимЭксплМашин =  Объект.КоэффПолнСтоимРабот;
		ПоказатьПредупреждениеНаФорме(НСтр("ru='Задан коэффициент к полной стоимости, коэффициенты к элементам равны коэффициенту к полной стоимости!'"));
	КонецЕсли;
КонецПроцедуры

