&НаКлиенте
Процедура РазделПриИзмененииОповещениеНаКлиенте(КодВозврата, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если КодВозврата = КодВозвратаДиалога.ОК Тогда
		
		Объект.Раздел					= ДополнительныеПараметры["ВыбранноеЗначение"][0];
		Объект.НаименованиеДляПечати	= СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ДополнительныеПараметры["ВыбранноеЗначение"][0], "Наименование");
		
		УправлениеВидимостью();
				
	КонецЕсли;
	
КонецПроцедуры //Процедура РазделПриИзмененииОповещениеНаКлиенте(КодВозврата, ДополнительныеПараметры = Неопределено) Экспорт

&НаСервере
Процедура ОбновитьСтруктуруСметы()
	
	Раздел = РеквизитФормыВЗначение("Объект");

	СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(Объект.ИДСметы,Раздел);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ЗначениеРасчета = Объект.Расчет;
	
	Если Объект.Ссылка.Пустая() Тогда
		Если ЗначениеЗаполнено(Объект.ИДРодителя) Тогда
			СМ_СметаВызовСервера.ЗаполнитьДанныеДокументаВСтруктуреСмет(Объект, Объект.ИДРодителя, ЛОЖЬ);
		КонецЕсли;
	Иначе
		// Обновляем нумерацию.
		Номера = СМ_СметаВызовСервера.ПолучитьНомерДокумента(Объект.Ссылка, "СМ_РазделЛокальнойСметы");
		ПорНомер = Номера.ПорНомер;   
	КонецЕсли;
	
	ОбновитьСтруктуруСметы();

	ТолькоПросмотрФормы = СМ_СметаВызовСервера.РольТолькоПросмотр();
	
	СуществуютАкты = СМ_УчетВыполненныхРаботСервер.СуществуютАктыПоСмете(Объект.ИДСметы);
	
	Если СтруктураПараметровРасчетаЛС = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Документ не имеет привязки к локальной смете.'"));
		СтандартнаяОбработка = Ложь;
		Отказ = Истина;
	КонецЕсли;
	
	ОбновитьЗначенияПоАкту();

	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Свойства") Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "СтраницаДополнительныеРеквизиты");
		ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Ложь);
		МодульУправлениеСвойствами = ОбщегоНазначения.ОбщийМодуль("УправлениеСвойствами");
		МодульУправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	КонецЕсли;
	
	Если Не Пользователи.РолиДоступны("СМ_АдминистраторСмета, ПолныеПрава") Тогда
		Элементы.ФормаПоказатьРасчеты.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПредупреждениеНаФорме(Текст)
	
	Элементы.ТекстПредупреждения.Видимость = Истина;
	Элементы.ТекстПредупреждения.Доступность = Истина;
	ТекстПредупреждения = Текст;
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьПредупреждениеНаФорме()
	
	Элементы.ТекстПредупреждения.Видимость = Ложь;
	Элементы.ТекстПредупреждения.Доступность = Ложь;
	ТекстПредупреждения = "";
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостью()
	
	СкрытьПредупреждениеНаФорме();
	
	Элементы.ГруппаСтраницы.Видимость = (СтруктураПараметровРасчетаЛС.ЭтоБазисноИндексныйУровеньРаздел);
	Элементы.ГруппаСтраницы.Доступность = (СтруктураПараметровРасчетаЛС.ЭтоБазисноИндексныйУровеньРаздел);
	
	Элементы.ГруппаКоэффициенты.Видимость = (СтруктураПараметровРасчетаЛС.ЭтоБазисноИндексныйУровеньРаздел)и(Не(Параметры.РазделАкта));
	Элементы.ГруппаКоэффициенты.Доступность = (СтруктураПараметровРасчетаЛС.ЭтоБазисноИндексныйУровеньРаздел)и(Не(Параметры.РазделАкта));
	
	Элементы.ГруппаКоэффициентыАкта.Видимость = (СтруктураПараметровРасчетаЛС.ЭтоБазисноИндексныйУровеньРаздел)и(Параметры.РазделАкта);
	Элементы.ГруппаКоэффициентыАкта.Доступность = (СтруктураПараметровРасчетаЛС.ЭтоБазисноИндексныйУровеньРаздел)и(Параметры.РазделАкта);
	
	Элементы.НаименованиеДляПечатиРес.Доступность 	= (НЕ СуществуютАкты);
		
	Элементы.ВидРабот.ТолькоПросмотр 					= (СуществуютАкты);
	Элементы.КоэффОснЗарплаты.ТолькоПросмотр 			= (СуществуютАкты);
	Элементы.КоэффСтоимЭксплМашин.ТолькоПросмотр 		= (СуществуютАкты);
	Элементы.КоэффСтоимЗарплатеМашин.ТолькоПросмотр 	= (СуществуютАкты);
	Элементы.КоэффСтоимМатериалов.ТолькоПросмотр 		= (СуществуютАкты);
	Элементы.КоэффОборуд.ТолькоПросмотр 				= (СуществуютАкты);
	Элементы.КоэффПолнСтоимРабот.ТолькоПросмотр 		= (СуществуютАкты);
	
	Элементы.ВидРаботАкта.ТолькоПросмотр 					= (Не Параметры.РазделАкта);
	Элементы.КоэффОснЗарплатыАкта.ТолькоПросмотр 			= (Не Параметры.РазделАкта);
	Элементы.КоэффСтоимЭксплМашинАкта.ТолькоПросмотр 		= (Не Параметры.РазделАкта);
	Элементы.КоэффСтоимЗарплатеМашинАкта.ТолькоПросмотр 	= (Не Параметры.РазделАкта);
	Элементы.КоэффСтоимМатериаловАкта.ТолькоПросмотр 		= (Не Параметры.РазделАкта);
	Элементы.КоэффОборудАкта.ТолькоПросмотр 				= (Не Параметры.РазделАкта);
	Элементы.КоэффПолнСтоимРаботАкта.ТолькоПросмотр 		= (Не Параметры.РазделАкта);
	
	Элементы.Раздел.Доступность 		= Не СуществуютАкты;
	Элементы.Расчет.Доступность 		= Не СуществуютАкты;    
	
	Если (СуществуютАкты И (Не Параметры.РазделАкта)) Тогда
		ПоказатьПредупреждениеНаФорме(НСтр("ru='Существуют акты, введенные по данной смете. Раздел не может быть отредактирован!'"));
	КонецЕсли;
	
	Если Параметры.РазделАкта Тогда
		Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Раздел №%1 %2'"), ПорНомер, СМ_СметаКлиент.ПолучитьТекстИнформацииОбАкте(Параметры.Акт, СтруктураПараметровРасчетаЛС, НСтр("ru='акта выполненных работ'")));
	Иначе
		Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Раздел №%1 %2'"), ПорНомер, СМ_СметаКлиент.ПолучитьТекстИнформацииОСмете(Объект,СтруктураПараметровРасчетаЛС, НСтр("ru='локальной сметы'")));                    
	КонецЕсли;
	Элементы.РазделКорректируемый.Видимость 		= ЗначениеЗаполнено(Объект.КорректируетРаздел);
	Элементы.РазделКорректируемый.Доступность		= ЗначениеЗаполнено(Объект.КорректируетРаздел);
	РазделКорректируемый = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Корректируемый раздел №%1'"), СМ_СметаКлиент.ПолучитьТекстИнформацииОРазделе(Объект.КорректируетРаздел));
	
	Если ТолькоПросмотрФормы Тогда
		Для каждого Элем Из ЭтаФорма.Элементы Цикл
			Если ТипЗнч(Элем) = Тип("ДекорацияФормы") ИЛИ ТипЗнч(Элем) = Тип("ДополнениеЭлементаФормы") ИЛИ Элем = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ТипЗнч(Элем) = Тип("КнопкаФормы") Тогда
				Элем.Доступность = Ложь;
			Иначе
				Элем.ТолькоПросмотр = Истина;
			КонецЕсли;
		КонецЦикла;
		// ДокторСофт
		ЭтаФорма.КоманднаяПанель.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьЗначенияПоАкту()
	
	Если (Параметры.РазделАкта) Тогда
		
		СтрокаРаздел = СМ_СметаВызовСервера.СтрокаРазделаАкта(Параметры.Акт, Объект.Ссылка);	
		
		// индексы могут отличаться
		Если ЗначениеЗаполнено(СтрокаРаздел) Тогда
			ЗаполнитьЗначенияСвойств(ЭтаФорма, СтрокаРаздел, "ВидРабот, КоэффОборуд, КоэффОснЗарплаты, КоэффПолнСтоимРабот, КоэффСтоимЗарплатеМашин, КоэффСтоимМатериалов, КоэффСтоимЭксплМашин");
		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЗначенияПоАкту()
	
	Если (Параметры.РазделАкта) Тогда
		
		ОбъектАкт = Параметры.Акт.ПолучитьОбъект();
		СтрокаРаздел = СМ_СметаВызовСервера.СтрокаРазделаАкта(ОбъектАкт, Объект.Ссылка);
		
		// индексы могут отличаться
		Если ЗначениеЗаполнено(СтрокаРаздел) Тогда
			ЗаполнитьЗначенияСвойств(СтрокаРаздел, ЭтаФорма, "ВидРабот, КоэффОборуд, КоэффОснЗарплаты, КоэффПолнСтоимРабот, КоэффСтоимЗарплатеМашин, КоэффСтоимМатериалов, КоэффСтоимЭксплМашин");
		КонецЕсли;
		
		ОбъектАкт.Записать();
				
	КонецЕсли;
	
КонецПроцедуры

