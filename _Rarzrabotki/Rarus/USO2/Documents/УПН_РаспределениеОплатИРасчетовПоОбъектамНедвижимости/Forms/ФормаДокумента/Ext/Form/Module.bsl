
////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

&НаСервере
Функция ПолучитьОбщуюПлощадьПоОбъектуНедвижимости(ОбъектНедвижимости)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", ?(Не ЗначениеЗаполнено(Объект.Ссылка), КонецДня(?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата())), Объект.Ссылка.МоментВремени()));
	Запрос.УстановитьПараметр("ОбъектНедвижимости", ОбъектНедвижимости);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПлощадиОбъектовНедвижимости.ОбщаяПлощадь
	|ИЗ
	|	РегистрСведений.УПН_ПлощадиОбъектовНедвижимости.СрезПоследних(&Период, ОбъектНедвижимости = &ОбъектНедвижимости) КАК ПлощадиОбъектовНедвижимости";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ОбщаяПлощадь;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьСтоимость(ТекущаяСтрока)
	
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Площадь * ТекущаяСтрока.Цена;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбщуюПлощадь()
	
	Для Каждого СтрокаТЧ Из Объект.УсловияПродажиОбъектов Цикл
		СтрокаТЧ.ОбщаяПлощадь = ПолучитьОбщуюПлощадьПоОбъектуНедвижимости(СтрокаТЧ.ОбъектНедвижимости);
	КонецЦикла;

КонецПроцедуры

