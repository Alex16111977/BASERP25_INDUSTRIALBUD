&НаСервере
Процедура ЗаполнитьПоКонтрагентуНаСервере()
	
	Объект.РасшифровкаПлатежа.Очистить();
	
	Если НЕ (ЗначениеЗаполнено(Объект.Контрагент) И ЗначениеЗаполнено(Объект.Организация)) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Регистратор ССЫЛКА Документ.УПН_ДоговорПоНедвижимости
	|			ТОГДА УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Регистратор.Партнер
	|		КОГДА УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Регистратор ССЫЛКА Документ.УПН_РасторжениеСделкиПоНедвижимости
	|			ТОГДА УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Регистратор.Партнер
	|	КОНЕЦ КАК Партнер,
	|	УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Договор КАК Договор,
	|	УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Доля КАК ОбъектНедвижимости,
	|	УСОERP_СоответствиеДоговоровИДолейСрезПоследних.ОбщаяПлощадь КАК ОбщаяПлощадь,
	|	УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Сумма КАК ОбщаяСтоимость
	|ПОМЕСТИТЬ ДанныеПоДолям
	|ИЗ
	|	РегистрСведений.УСОERP_СоответствиеДоговоровИДолей.СрезПоследних(&ДатаЗаполнения, ) КАК УСОERP_СоответствиеДоговоровИДолейСрезПоследних
	|ГДЕ
	|	НЕ УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Расторгнут
	|	И УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Контрагент = &Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеПоДолям.Партнер КАК Партнер,
	|	ДанныеПоДолям.Договор КАК Договор,
	|	ДанныеПоДолям.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	Аналитика.КлючАналитики КАК АналитикаУчетаПоПартнерам,
	|	ДанныеПоДолям.ОбщаяПлощадь КАК ОбщаяПлощадь,
	|	ДанныеПоДолям.ОбщаяСтоимость КАК ОбщаяСтоимость
	|ПОМЕСТИТЬ ДанныеПоДолямСАналитикойПоПартнерам
	|ИЗ
	|	ДанныеПоДолям КАК ДанныеПоДолям
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК Аналитика
	|		ПО (&Организация = Аналитика.Организация)
	|			И (&Контрагент = Аналитика.Контрагент)
	|			И ДанныеПоДолям.Партнер = Аналитика.Партнер
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКОнтрагентов.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ДанныеПоДолям.Договор = &Договор
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОстатки.АналитикаУчетаПоПартнерам.Партнер КАК АналитикаУчетаПоПартнерам,
	|	УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОстатки.Договор КАК Договор,
	|	УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОстатки.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	СУММА(УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОстатки.СуммаОстаток) КАК СуммаОстаток,
	|	СУММА(УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОстатки.ПлощадьОстаток) КАК ПлощадьОстаток
	|ПОМЕСТИТЬ ДанныеОстаткаСтоимости
	|ИЗ
	|	РегистрНакопления.УПН_РасчетыСКлиентамиПоОбъектамНедвижимости.Остатки(
	|			&ДатаЗаполнения,
	|			(Договор, ОбъектНедвижимости) В
	|					(ВЫБРАТЬ
	|						ДанныеПоДолям.Договор,
	|						ДанныеПоДолям.ОбъектНедвижимости
	|					ИЗ
	|						ДанныеПоДолям КАК ДанныеПоДолям)
	|				И АналитикаУчетаПоПартнерам.Контрагент = &Контрагент) КАК УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОстатки
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОстатки.Договор = &Договор
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОстатки.АналитикаУчетаПоПартнерам.Партнер,
	|	УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОстатки.Договор,
	|	УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОстатки.ОбъектНедвижимости
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеПоДолямСАналитикойПоПартнерам.Партнер КАК Партнер,
	|	ДанныеПоДолямСАналитикойПоПартнерам.Договор КАК Договор,
	|	ДанныеПоДолямСАналитикойПоПартнерам.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	ДанныеПоДолямСАналитикойПоПартнерам.ОбщаяПлощадь КАК ОбщаяПлощадь,
	|	ДанныеПоДолямСАналитикойПоПартнерам.ОбщаяСтоимость КАК ОбщаяСтоимость,
	|	ДанныеПоДолямСАналитикойПоПартнерам.ОбщаяПлощадь - ЕСТЬNULL(ДанныеОстаткаСтоимости.ПлощадьОстаток, 0) КАК ПлощадьУжеОплачено,
	|	ДанныеПоДолямСАналитикойПоПартнерам.ОбщаяСтоимость - ЕСТЬNULL(ДанныеОстаткаСтоимости.СуммаОстаток, 0) КАК СтоимостьУжеОплачено
	|ИЗ
	|	ДанныеПоДолям КАК ДанныеПоДолямСАналитикойПоПартнерам
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеОстаткаСтоимости КАК ДанныеОстаткаСтоимости
	|		ПО ДанныеПоДолямСАналитикойПоПартнерам.Договор = ДанныеОстаткаСтоимости.Договор
	|			И ДанныеПоДолямСАналитикойПоПартнерам.ОбъектНедвижимости = ДанныеОстаткаСтоимости.ОбъектНедвижимости
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ДанныеОстаткаСтоимости.Договор = &Договор
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ДанныеПоДолямСАналитикойПоПартнерам.Договор = &Договор
	|		КОНЕЦ";
	
	ДатаЗаполнения = ?(НЕ ЗначениеЗаполнено(Объект.Ссылка), ТекущаяДата(), Новый Граница(Объект.Дата,ВидГраницы.Исключая));
	
	Запрос.УстановитьПараметр("ДатаЗаполнения", ДатаЗаполнения);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	Запрос.УстановитьПараметр("Договор",Справочники.ДоговорыКонтрагентов.ПустаяСсылка());
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств") И
		Объект.ДокументОснование.РасшифровкаПлатежа.Количество() И
		ТипЗнч(Объект.ДокументОснование.РасшифровкаПлатежа.Получить(0).Заказ) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		Запрос.УстановитьПараметр("Договор",Объект.ДокументОснование.РасшифровкаПлатежа.Получить(0).Заказ);
	КонецЕсли;
	
	Объект.РасшифровкаПлатежа.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура РаспределитьСуммуОснованияНаСервере(ИмяРеквизитаБазыРаспределения = "ОбщаяПлощадь")
	
	ТаблицаРасшифровкиПлатежа = Объект.РасшифровкаПлатежа.Выгрузить();
	
	СуммаДокументаОснования = УСОERP_ОбработкаТабличныхЧастей.ПолучитьСуммуОснованияДляРаспределенияОплатПоОбъектамНедвижимости(Объект.ДокументОснование, Объект.Ссылка);
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СуммаДокументаОснования = СуммаДокументаОснования+Объект.ДокументОснование.СуммаДокумента;
	КонецЕсли;
	
	ОсталосьРаспределить    = СуммаДокументаОснования;
	БазаРаспределения       = ТаблицаРасшифровкиПлатежа.Итог(ИмяРеквизитаБазыРаспределения);
	КоличествоСтрок         = ТаблицаРасшифровкиПлатежа.Количество();
	
	Если БазаРаспределения = 0 Тогда
		ТаблицаРасшифровкиПлатежа.ЗаполнитьЗначения(0, "Сумма, Площадь");
		Возврат;
	КонецЕсли;
	
	Сч = 0;
	Пока Сч < КоличествоСтрок Цикл
		
		СтрокаРасшифровки = ТаблицаРасшифровкиПлатежа[Сч];
		
		Если Сч = КоличествоСтрок - 1 Тогда // последняя строка
			СтрокаРасшифровки.Сумма = ОсталосьРаспределить;
		Иначе
			Коэффициент = СтрокаРасшифровки[ИмяРеквизитаБазыРаспределения] / БазаРаспределения;
			СтрокаРасшифровки.Сумма = СуммаДокументаОснования * Коэффициент;
		КонецЕсли;
		
		СтрокаРасшифровки.Площадь = СтрокаРасшифровки.ОбщаяПлощадь * ?(СтрокаРасшифровки.ОбщаяСтоимость = 0, 0, СтрокаРасшифровки.Сумма / СтрокаРасшифровки.ОбщаяСтоимость);
		
		ОсталосьРаспределить = ОсталосьРаспределить - СтрокаРасшифровки.Сумма;
		
		Сч = Сч + 1;
		
	КонецЦикла;
	
	Объект.РасшифровкаПлатежа.Загрузить(ТаблицаРасшифровкиПлатежа);
	
КонецПроцедуры


ОтветПередЗаписью = Ложь;

#КонецОбласти

