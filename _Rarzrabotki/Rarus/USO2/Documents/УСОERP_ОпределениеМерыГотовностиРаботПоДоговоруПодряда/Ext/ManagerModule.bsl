
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Проведение

Процедура 	ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт				
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Выручка.Ссылка.Дата КАК Период,
	               |	Выручка.Ссылка.Организация,
	               |	Выручка.Ссылка.ОбъектСтроительства,
	               |	Выручка.Ссылка.Контрагент,
	               |	Выручка.Ссылка.ДоговорКонтрагента КАК Договор,
	               |	Выручка.НоменклатурнаяГруппа,
	               |	СУММА(Выручка.РазностьПланФакт) КАК Сумма
	               |ИЗ
	               |	Документ.УСОERP_ОпределениеМерыГотовностиРаботПоДоговоруПодряда.Выручка КАК Выручка
	               |ГДЕ
	               |	Выручка.Ссылка = &Ссылка
	               |	И Выручка.РазностьПланФакт <> 0
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Выручка.Ссылка.Организация,
	               |	Выручка.НоменклатурнаяГруппа,
	               |	Выручка.Ссылка.ОбъектСтроительства,
	               |	Выручка.Ссылка.Контрагент,
	               |	Выручка.Ссылка.ДоговорКонтрагента,
	               |	Выручка.Ссылка.Дата";
		
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("ТаблицаСуммыНепредъявленнойВыручки",	Результат[0].Выгрузить());
	
КонецПроцедуры

#КонецОбласти

#Область Отчеты
	// Определяет список команд отчетов.
	//
	// Параметры:
	//   КомандыОтчетов - ТаблицаЗначений - Таблица с командами отчетов. Для изменения.
	//       См. описание 1 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
	//   Параметры - Структура - Вспомогательные параметры. Для чтения.
	//       См. описание 2 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
	//
	Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, Параметры) Экспорт
		
		ВариантыОтчетовУТПереопределяемый.ДобавитьКомандуСтруктураПодчиненности(КомандыОтчетов);
		
	КонецПроцедуры
	
#КонецОбласти

