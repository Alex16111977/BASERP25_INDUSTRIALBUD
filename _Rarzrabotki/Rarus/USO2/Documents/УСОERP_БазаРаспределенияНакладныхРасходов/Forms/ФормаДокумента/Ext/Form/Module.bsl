Процедура ДокументОснованиеОчистка(Элемент, СтандартнаяОбработка)
	ДокументОснованиеПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	РабочийСценарий = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьРабочийСценарий(Объект.ОбъектСтроительства, Объект.Организация);
	
	СтруктураПараметров = Новый Структура("РабочийСценарий",РабочийСценарий); 	
	
	Если Объект.Организация <> ТекущаяОрганизация И ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.ОбъектСтроительства) И ДеревоРабот.ПолучитьЭлементы().Количество() Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ОбъектСтроительстваПриИзмененииПродолжение",ЭтотОбъект,СтруктураПараметров),"Дерево работ будет очищено. Продолжить?", РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
		
	Иначе
		
		Объект.СценарийПланирования = РабочийСценарий;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
		// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства

КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботПередУдалением(Элемент, Отказ)
	
	ТекСтрока = Элементы.ДеревоРабот.ТекущиеДанные;
	
	ТекСтрокаУдаления = ТекСтрока;
	
	Пока Истина Цикл
		
		Родитель = ТекСтрокаУдаления.ПолучитьРодителя(); 
		
		Если Родитель = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		
		Если Родитель.ПолучитьЭлементы().Количество() > 1 Тогда
			
			Прервать;
			
		КонецЕсли;
		
		ТекСтрокаУдаления = Родитель;
		
	КонецЦикла;  	
	
	Если ТекСтрока.ПолучитьИдентификатор() <> ТекСтрокаУдаления.ПолучитьИдентификатор() Тогда    		
		
		Родитель = ?(ТекСтрокаУдаления.ПолучитьРодителя() = Неопределено,ДеревоРабот,ТекСтрокаУдаления.ПолучитьРодителя());
		
		Родитель.ПолучитьЭлементы().Удалить(ТекСтрокаУдаления);
		
	КонецЕсли;  	
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботПослеУдаления(Элемент) 	
	
	ЗаполнитьДанныеОбъектаИзФормы();
	
	Модифицированность = Истина;  		
	
КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьДанныеОбъектаИзФормы()
	
	Если НЕ НовыйВариант Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ОбъектыРасценки.Очистить();
	ДеревоДанных = РеквизитФормыВЗначение("ДеревоРабот");
	
	Строки = ДеревоДанных.Строки.НайтиСтроки(Новый Структура("СуммарнаяРабота",Ложь),Истина);
	
	Для Каждого НайденнаяСтрока ИЗ Строки Цикл
		ЗаполнитьЗначенияСвойств(Объект.ОбъектыРасценки.Добавить(),НайденнаяСтрока);
	КонецЦикла;
	
КонецПроцедуры  

&НаКлиенте
