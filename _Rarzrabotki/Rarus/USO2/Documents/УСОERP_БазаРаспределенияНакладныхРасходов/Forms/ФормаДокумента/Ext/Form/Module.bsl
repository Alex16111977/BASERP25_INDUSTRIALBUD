&НаСервере
Процедура СформироватьЗаполнитьДеревоРабот(ЧтениеИзТабличнойЧасти = Ложь)
	
	Если НовыйВариант Тогда
		СформироватьЗаполнитьДеревоРаботНовыйВариант(ЧтениеИзТабличнойЧасти);
		Возврат;
	КонецЕсли;
	
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_БазаРаспределенияНакладныхРасходов_СформироватьЗаполнитьДеревоРабот(ЭтотОбъект, ЧтениеИзТабличнойЧасти);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьЗаполнитьДеревоРаботНовыйВариант(ЧтениеИзТабличнойЧасти)
	
	ТабРабот = Объект.ОбъектыРасценки.Выгрузить();
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТабРабот",ТабРабот);
	Запрос.УстановитьПараметр("КопияСценария",Объект.ДокументОснование.КопияСценария);
	Запрос.УстановитьПараметр("ЧтениеИзТабличнойЧасти",ЧтениеИзТабличнойЧасти);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТабРабот.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	ТабРабот.Отметка КАК Отметка
	|ПОМЕСТИТЬ ВрТабРабот
	|ИЗ
	|	&ТабРабот КАК ТабРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТабРабот.Работа КАК Работа,
	|	ВрТабРабот.Отметка КАК Отметка
	|ПОМЕСТИТЬ ТабРаботы
	|ИЗ
	|	ВрТабРабот КАК ВрТабРабот
	|ГДЕ
	|	&ЧтениеИзТабличнойЧасти
	|	И НЕ ВрТабРабот.Работа.СуммарнаяРабота
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботы.Ссылка,
	|	ЛОЖЬ
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	УСОERP_СтроительныеРаботы.Владелец = &КопияСценария
	|	И НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
	|	И НЕ УСОERP_СтроительныеРаботы.СуммарнаяРабота
	|	И &ЧтениеИзТабличнойЧасти = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабРаботы.Работа КАК Работа,
	|	ТабРаботы.Отметка КАК Отметка
	|ИЗ
	|	ТабРаботы КАК ТабРаботы
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТабРаботы.Работа.ПорядокСортировки,
	|	ТабРаботы.Работа.НомерРаботыВУровне
	|ИТОГИ
	|	МАКСИМУМ(Отметка)
	|ПО
	|	Работа ИЕРАРХИЯ";  	
	
	ДеревоЗапроса = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	ДеревоРаботы = РеквизитФормыВЗначение("ДеревоРабот");
	
	ДеревоРаботы.Строки.Очистить();
	
	Для Каждого СтрокаЗапроса ИЗ ДеревоЗапроса.Строки Цикл
		
		ВывестиДеревоРаботИзДереваЗапроса(СтрокаЗапроса,ДеревоРаботы);
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоРаботы,"ДеревоРабот");	
	
КонецПроцедуры

Процедура ВывестиДеревоРаботИзДереваЗапроса(СтрокаЗапроса,ДеревоРаботы)
	
	Нстр = ДеревоРаботы.Строки.Добавить();
	Нстр.Работа = СтрокаЗапроса.Работа;
	Нстр.СуммарнаяРабота = СтрокаЗапроса.Работа.СуммарнаяРабота;
	Нстр.Отметка = СтрокаЗапроса.Отметка*(НЕ Нстр.СуммарнаяРабота);
	
	Для Каждого ПодСтрока ИЗ СтрокаЗапроса.Строки Цикл
		
		Если ПодСтрока.Работа = СтрокаЗапроса.Работа Тогда
			Продолжить;
		КонецЕсли;
		
		ВывестиДеревоРаботИзДереваЗапроса(ПодСтрока,Нстр);
		
	КонецЦикла; 
	
КонецПроцедуры  

&НаСервере
Процедура СохранитьИзмененияБазыРаспределения(ТекущийОбъект)
	
	ТекущийОбъект.ОбъектыРасценки.Очистить();
		
	ПрочитатьДанныеИзДереваРабот(ТекущийОбъект, );
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеИзДереваРабот(ТекущийОбъект, СтрокаДерева = Неопределено)
	
	Если СтрокаДерева = Неопределено Тогда
		мДеревоРабот = РеквизитФормыВЗначение("ДеревоРабот", Тип("ДеревоЗначений"));
		СтрокиДереваРабот = мДеревоРабот.Строки;
	Иначе
		СтрокиДереваРабот = СтрокаДерева.Строки;
	КонецЕсли;
	
	Для Каждого СтрокаДерева Из СтрокиДереваРабот Цикл
		
		Если НовыйВариант Тогда
			
			Если НЕ СтрокаДерева.Работа.СуммарнаяРабота Тогда
				
				НоваяСтрокаТЧ = ТекущийОбъект.ОбъектыРасценки.Добавить();
				ЗаполнитьЗначенияСвойств( НоваяСтрокаТЧ, СтрокаДерева);
				
			КонецЕсли;
			
		Иначе
			
			НоваяСтрокаТЧ = ТекущийОбъект.ОбъектыРасценки.Добавить();
			ЗаполнитьЗначенияСвойств( НоваяСтрокаТЧ, СтрокаДерева);
			
		КонецЕсли;
		
		Если СтрокаДерева.Строки.количество()>0 Тогда
			ПрочитатьДанныеИзДереваРабот(ТекущийОбъект, СтрокаДерева);
		КонецЕсли;
		
	КонецЦикла; 	
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьСписокРабот()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_УтверждениеКалендарногоПланаГрафикаРаботы.Работа
	|ИЗ
	|	Документ.УСОERP_УтверждениеКалендарногоПланаГрафика.Работы КАК УСОERP_УтверждениеКалендарногоПланаГрафикаРаботы
	|ГДЕ
	|	УСОERP_УтверждениеКалендарногоПланаГрафикаРаботы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Объект.ДокументОснование);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат.ВыгрузитьКолонку("Работа");
	
КонецФункции

&НаКлиенте
Процедура СвернутьНаКлиенте(мТекущаяСтрока = Неопределено)
	
	Если мТекущаяСтрока = Неопределено Тогда
		КоллекцияЭлементовДерева = ДеревоРабот.ПолучитьЭлементы();
	Иначе
		КоллекцияЭлементовДерева = мТекущаяСтрока.ПолучитьЭлементы();
	КонецЕсли;
	 	
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл
		
		ИдентификаторСтроки	= Строка.ПолучитьИдентификатор();
		Элементы.ДеревоРабот.Свернуть(ИдентификаторСтроки);
		
	КонецЦикла;	

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьНаКлиенте(мТекущаяСтрока = Неопределено)
	
	Если мТекущаяСтрока = Неопределено Тогда
		КоллекцияЭлементовДерева = ДеревоРабот.ПолучитьЭлементы();
	Иначе
		КоллекцияЭлементовДерева = мТекущаяСтрока.ПолучитьЭлементы();
	КонецЕсли;  
	
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл
		
		ИдентификаторСтроки	= Строка.ПолучитьИдентификатор();
		Элементы.ДеревоРабот.Развернуть(ИдентификаторСтроки);
		
		Если Строка.ПолучитьЭлементы().количество()>0 Тогда
			РазвернутьНаКлиенте(Строка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьПодборРаботНаСервере( ВыбранноеЗначение)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	Если НовыйВариант Тогда
		ОбработатьПодборРаботНовыйВариант(ВыбранноеЗначение);
		Возврат;
	КонецЕсли;
		
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда 
		
		мДеревоРабот = РеквизитФормыВЗначение("ДеревоРабот", Тип("ДеревоЗначений"));
		
		Для Каждого Элем из ВыбранноеЗначение Цикл
			
			Если мДеревоРабот.Строки.найти(Элем, , Истина) = Неопределено 
				И НЕ Элем.СуммарнаяРабота Тогда
				НоваяСтрока = мДеревоРабот.Строки.Добавить();
				НоваяСтрока.Работа = Элем;
				НоваяСтрока.СуммарнаяРабота = Элем.СуммарнаяРабота;
			КонецЕсли;
			
		КонецЦикла;	
		
		ЗначениеВРеквизитФормы(мДеревоРабот, "ДеревоРабот");
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.УСОERP_СтроительныеРаботы") Тогда
		
		Если ВыбранноеЗначение.СуммарнаяРабота Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбор этапа в данном случае не предусмотрен! Необходимо выбрать конкретную работу.'")
			+ Символы.ПС + ОписаниеОшибки());
			Возврат;
			
		КонецЕсли;
		
		мДеревоРабот = РеквизитФормыВЗначение("ДеревоРабот", Тип("ДеревоЗначений")); 		
		
		Если мДеревоРабот.Строки.найти(ВыбранноеЗначение, , Истина) = Неопределено Тогда
			НоваяСтрока = мДеревоРабот.Строки.Добавить();
			НоваяСтрока.Работа = ВыбранноеЗначение;
			НоваяСтрока.СуммарнаяРабота = ВыбранноеЗначение.СуммарнаяРабота;
		КонецЕсли;
		
		ЗначениеВРеквизитФормы(мДеревоРабот, "ДеревоРабот");
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбор этапа в данном случае не предусмотрен! Необходимо выбрать конкретную работу.'")
		+ Символы.ПС + ОписаниеОшибки());
		
	КонецЕсли;   
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьПодборРаботНовыйВариант(ВыбранноеЗначение)
	
	Объект.ОбъектыРасценки.Очистить();
	
	ПрочитатьДанныеИзДереваРабот(Объект);
	
	ДеревоРабот.ПолучитьЭлементы().Очистить();     	
	
	Запрос = Новый Запрос ;
	Запрос.УстановитьПараметр("МассивРабот",ВыбранноеЗначение);
	Запрос.УстановитьПараметр("КопияСценария",Объект.ДокументОснование.КопияСценария);
	Запрос.УстановитьПараметр("МассивСуществующихРабот",Объект.ОбъектыРасценки.Выгрузить().ВыгрузитьКолонку("Работа"));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
	|	И УСОERP_СтроительныеРаботы.Ссылка В ИЕРАРХИИ(&МассивРабот)
	|	И НЕ УСОERP_СтроительныеРаботы.СуммарнаяРабота
	|	И УСОERP_СтроительныеРаботы.Владелец = &КопияСценария
	|	И НЕ УСОERP_СтроительныеРаботы.Ссылка В (&МассивСуществующихРабот)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Нстр = Объект.ОбъектыРасценки.Добавить();
		Нстр.Работа = Выборка.ссылка;
		
	КонецЦикла;
	
	СформироватьЗаполнитьДеревоРабот(Истина);
	
	Модифицированность = Истина;

КонецПроцедуры    

&НаСервере
