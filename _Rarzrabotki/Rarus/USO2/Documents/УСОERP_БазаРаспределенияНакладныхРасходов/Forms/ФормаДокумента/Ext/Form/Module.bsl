&НаКлиенте
Перем КэшированныеЗначения; //используется механизмом обработки изменения реквизитов ТЧ

&НаКлиенте
Перем ПредыдущиеРеквизитыСтроки; //используется для отвязки строки поступления от строки заказа

&НаКлиенте
Перем ТекущиеДанныеИдентификатор; //используется для передачи текущей строки в обработчик ожидания

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
		
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма); 	
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ПриЧтенииСозданииНаСервере();
		
	КонецЕсли;
	
	НовыйВариант = Объект.ДокументОснование.СценарийПланирования.НовыйВариант = Истина;
	
	СформироватьЗаполнитьДеревоРабот(Истина);

	ТекущийОбъектСтроительства 	 = Объект.ОбъектСтроительства;
	ТекущийСценарий 			 = Объект.СценарийПланирования;
	ТекущийПланПроизводстваРабот = Объект.ДокументОснование;
	ТекущаяОрганизация           = Объект.Организация;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды  
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// Обработчик механизма "ДатыЗапретаИзменения"
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	ПриЧтенииСозданииНаСервере();
	
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);

	МодификацияКонфигурацииПереопределяемый.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы =	"Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаВыбора" Тогда
		
		ОбработатьПодборРаботНаСервере( ВыбранноеЗначение);
	
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СохранитьИзмененияБазыРаспределения(ТекущийОбъект);
	
	// Обработчик подсистемы "Свойства"
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
		
	//Элементы.ГруппаКомментарий.Картинка = ОбщегоНазначения.ПолучитьКартинкуКомментария(Объект.Комментарий);

	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("Запись_НазначениеИсполнителейРабот", ПараметрыЗаписи, Объект.Ссылка);

	МодификацияКонфигурацииКлиентПереопределяемый.ПослеЗаписи(ЭтаФорма, ПараметрыЗаписи);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	//Элементы.ГруппаКомментарий.Картинка = ОбщегоНазначения.ПолучитьКартинкуКомментария(Объект.Комментарий);
	
	МодификацияКонфигурацииПереопределяемый.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОбъектСтроительстваПриИзменении(Элемент)
	
	РабочийСценарий = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьРабочийСценарий(Объект.ОбъектСтроительства, Объект.Организация);
	
	СтруктураПараметров = Новый Структура("РабочийСценарий",РабочийСценарий);
	
	Если ЗначениеЗаполнено(ТекущийОбъектСтроительства)
		И ДеревоРабот.ПолучитьЭлементы().Количество() > 0 Тогда
		
		Если ТекущийОбъектСтроительства <> Объект.ОбъектСтроительства Тогда
			
			ПоказатьВопрос(Новый ОписаниеОповещения("ОбъектСтроительстваПриИзмененииПродолжение",ЭтотОбъект,СтруктураПараметров),"Дерево работ будет очищено. Продолжить?", РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
			
		КонецЕсли;
		
	Иначе 
		
		ОбъектСтроительстваПриИзмененииПродолжение(КодВозвратаДиалога.Да,СтруктураПараметров);		
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектСтроительстваПриИзмененииПродолжение(Ответ,ДопПараметры)Экспорт  	
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Объект.ОбъектСтроительства = ТекущийОбъектСтроительства;
		Объект.Организация         = ТекущаяОрганизация;
		Возврат;
	КонецЕсли;
	
	РабочийСценарий = ДопПараметры.РабочийСценарий;
	
	Если    ТекущийОбъектСтроительства <> Объект.ОбъектСтроительства 
		Или ТекущаяОрганизация <> Объект.Организация                  Тогда
		ДеревоРабот.ПолучитьЭлементы().Очистить();
		Объект.СценарийПланирования = РабочийСценарий;
		ТекущийСценарий = Объект.СценарийПланирования;
		Объект.ДокументОснование = "";
		Объект.НаправлениеДеятельности = "";
		Объект.ДокументОснование = УСОERP_ЗащищенныеФункцииСервер.ПолучитьПоследнийДокументУтверждения(Объект.ОбъектСтроительства,Объект.Организация);
        ДокументОснованиеПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
	КонецЕсли;
	
	ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;
	ТекущаяОрганизация         = Объект.Организация;  	
	
КонецПроцедуры    

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ТекущийПланПроизводстваРабот)
		И ТекущийПланПроизводстваРабот <> Объект.ДокументОснование 
		И ДеревоРабот.ПолучитьЭлементы().Количество() > 0 Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ДокументОснованиеПриИзмененииПродолжение",ЭтотОбъект),"Дерево работ будет очищено. Продолжить?", РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
		
	Иначе
		
		ДокументОснованиеПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзмененииПродолжение(Ответ,ДопПараметры)Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Объект.ДокументОснование = ТекущийПланПроизводстваРабот;
		Возврат;
	КонецЕсли;
	
	ДеревоРабот.ПолучитьЭлементы().Очистить();
	ТекущийПланПроизводстваРабот = Объект.ДокументОснование;
	ДокументОснованиеПриИзмененииНаСервере(); 
	
КонецПроцедуры

&НаКлиенте
Процедура СценарийПланированияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ТекущийСценарий)
		И ТекущийСценарий <> Объект.СценарийПланирования 
		И ДеревоРабот.ПолучитьЭлементы().Количество() > 0 Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("СценарийПланированияПриИзмененииПродолжение",ЭтотОбъект),"Дерево работ будет очищено. Продолжить?", РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
		
	Иначе
		
		СценарийПланированияПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);	
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СценарийПланированияПриИзмененииПродолжение(Ответ,ДопПараметры)Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Объект.СценарийПланирования = ТекущийСценарий;
		Возврат;
	КонецЕсли;
	
	ДеревоРабот.ПолучитьЭлементы().Очистить();
	ТекущийСценарий = Объект.СценарийПланирования;
	
КонецПроцедуры  

#КонецОбласти

#Область ОбработчикиСобытийЭлементовДереваФормыДеревоРабот

#КонецОбласти  

#Область ОбработчикиКомандФормы

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Элементы.Список, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект,Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура Подключаемый_ВыполнитьПереопределяемуюКоманду(Команда)
	
	СобытияФормКлиент.ВыполнитьПереопределяемуюКоманду(ЭтаФорма, Команда);
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ОбъектСтроительства) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан объект строительства. Заполнение невозможно.", Объект.Ссылка, "ОбъектСтроительства", "Объект");
		Возврат;
	Конецесли;

	Если Не ЗначениеЗаполнено(Объект.СценарийПланирования) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан сценарий планирования. Заполнение невозможно.", Объект.Ссылка, "СценарийПланирования", "Объект");
		Возврат;
	Конецесли;

	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан внутренний план производства работ. Заполнение невозможно.", Объект.Ссылка, "ДокументОснование", "Объект");
		Возврат;
	Конецесли;
	
	Если ДеревоРабот.ПолучитьЭлементы().Количество() > 0 Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьПродолжение",ЭтотОбъект),"Дерево работ будет очищено перед заполнением. Продолжить?", РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
		
	Иначе
		
		ЗаполнитьПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиДереваРабот = ДеревоРабот.ПолучитьЭлементы();
	СтрокиДереваРабот.Очистить();
	
	СформироватьЗаполнитьДеревоРабот();
	
	//РазвернутьНаКлиенте();
	
КонецПроцедуры  

&НаКлиенте
Процедура Подбор(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ОбъектСтроительства) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан объект строительства. Заполнение невозможно.", Объект.Ссылка, "ОбъектСтроительства", "Объект");
		Возврат;
		
	Конецесли;

	Если Не ЗначениеЗаполнено(Объект.СценарийПланирования) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан сценарий планирования. Заполнение невозможно.", Объект.Ссылка, "СценарийПланирования", "Объект");
		Возврат;
		
	Конецесли;

	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан внутренний план производства работ. Заполнение невозможно.", Объект.Ссылка, "ДокументОснование", "Объект");
		Возврат;
		
	Конецесли;
	
	Если НовыйВариант Тогда
		
		СтруктураОтбора = Новый Структура("ДокументУтверждения,МножественныйВыбор",Объект.ДокументОснование,Истина);
		
	Иначе
		
		СтруктураОтбора = Новый Структура("Организация, ОбъектСтроительства, СценарийПланирования, Утверждена", Объект.Организация, Объект.ОбъектСтроительства, Объект.СценарийПланирования, Истина);
		
	КонецЕсли;
	
	ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.ФормаВыбора",СтруктураОтбора, ЭтаФорма,,,,,);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВсе(Команда)
	
	УстановитьСнятьОтметкиНаКлиентеРекурсивно(ДеревоРабот,Истина);   
	Модифицированность = Истина;
	ЗаполнитьДанныеОбъектаИзФормы();
	
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьСнятьОтметкиНаКлиентеРекурсивно(СтрокаДерева,Отметка)
	
	Для Каждого ПодСтрока ИЗ СтрокаДерева.ПолучитьЭлементы() Цикл
		
		Если НЕ ПодСтрока.СуммарнаяРабота Тогда
			ПодСтрока.Отметка = Отметка;
			Продолжить;
		КонецЕсли;
		
		УстановитьСнятьОтметкиНаКлиентеРекурсивно(ПодСтрока,Отметка);	
		
	КонецЦикла; 	
	
КонецПроцедуры 

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	УстановитьСнятьОтметкиНаКлиентеРекурсивно(ДеревоРабот,Ложь);	
	Модифицированность = Истина;
	ЗаполнитьДанныеОбъектаИзФормы(); 
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсе(Команда)
	
	РазвернутьНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсе(Команда)
	
	СвернутьНаКлиенте();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	//
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоРабот.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоРабот.СуммарнаяРабота");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(WindowsШрифты.ШрифтДиалоговИМеню,,,Истина));
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаГруппировкиОтчета2);

		
	//
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоРабот.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоРабот.Отметка");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаПолностьюОбеспечен);

	//
КонецПроцедуры

