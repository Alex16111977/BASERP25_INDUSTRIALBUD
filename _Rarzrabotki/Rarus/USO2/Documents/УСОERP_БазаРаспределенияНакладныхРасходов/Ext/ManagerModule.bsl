
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстыЗапроса.Добавить(ТекстЗапросаТаблицыБазыРаспределения(),		"ТаблицаБазыРаспределения");
	

	Запрос.Текст = "";
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		Запрос.Текст = Запрос.Текст + ТекстЗапроса.Значение;
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////
	// Выполним запрос
	
	Результат = Запрос.ВыполнитьПакет();
	
	////////////////////////////////////////////////////////////////////////////
	// Поместим результаты запроса в дополнительные свойства
	
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		ИмяТаблицы = ТекстЗапроса.Представление;
		Если Не ПустаяСтрока(ИмяТаблицы) Тогда
			Индекс = ТекстыЗапроса.Индекс(ТекстЗапроса);
			ДополнительныеСвойства.ТаблицыДляДвижений.Вставить(ИмяТаблицы, Результат[Индекс].Выгрузить());
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УСОERP_БазаРаспределенияНакладныхРасходов.Дата КАК Период,
	               |	УСОERP_БазаРаспределенияНакладныхРасходов.Ссылка КАК Ссылка,
	               |	УСОERP_БазаРаспределенияНакладныхРасходов.ОбъектСтроительства,
	               |	УСОERP_БазаРаспределенияНакладныхРасходов.СценарийПланирования,
	               |	УСОERP_БазаРаспределенияНакладныхРасходов.Организация КАК Организация
	               |ИЗ
	               |	Документ.УСОERP_БазаРаспределенияНакладныхРасходов КАК УСОERP_БазаРаспределенияНакладныхРасходов
	               |ГДЕ
	               |	УСОERP_БазаРаспределенияНакладныхРасходов.Ссылка = &Ссылка";
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	//
	Запрос.УстановитьПараметр("ОбъектСтроительства",	Реквизиты.ОбъектСтроительства);
	Запрос.УстановитьПараметр("СценарийПланирования",	Реквизиты.СценарийПланирования);
	Запрос.УстановитьПараметр("Период",					Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация",			Реквизиты.Организация);
		
КонецПроцедуры

Функция ТекстЗапросаТаблицыБазыРаспределения()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	УСОERP_БазаРаспределенияНакладныхРасходовОбъектыРасценки.Ссылка КАК Регистратор,
	|	УСОERP_БазаРаспределенияНакладныхРасходовОбъектыРасценки.Ссылка.Дата КАК Период,
	|	УСОERP_БазаРаспределенияНакладныхРасходовОбъектыРасценки.Ссылка.Организация КАК Организация,
	|	УСОERP_БазаРаспределенияНакладныхРасходовОбъектыРасценки.Ссылка.ОбъектСтроительства КАК ОбъектСтроительства,
	|	УСОERP_БазаРаспределенияНакладныхРасходовОбъектыРасценки.Ссылка.СценарийПланирования КАК СценарийПланирования,
	|	УСОERP_БазаРаспределенияНакладныхРасходовОбъектыРасценки.Ссылка.СтатьяРасходов КАК СтатьяРасходов,
	|	УСОERP_БазаРаспределенияНакладныхРасходовОбъектыРасценки.Отметка КАК Отметка,
	|	ВЫБОР
	|		КОГДА УСОERP_БазаРаспределенияНакладныхРасходовОбъектыРасценки.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|			ТОГДА УСОERP_БазаРаспределенияНакладныхРасходовОбъектыРасценки.Работа
	|		ИНАЧЕ УСОERP_БазаРаспределенияНакладныхРасходовОбъектыРасценки.Работа.РаботаИсточник
	|	КОНЕЦ КАК Работа
	|ИЗ
	|	Документ.УСОERP_БазаРаспределенияНакладныхРасходов.ОбъектыРасценки КАК УСОERP_БазаРаспределенияНакладныхРасходовОбъектыРасценки
	|ГДЕ
	|	УСОERP_БазаРаспределенияНакладныхРасходовОбъектыРасценки.Ссылка = &Ссылка
	|	И НЕ УСОERP_БазаРаспределенияНакладныхРасходовОбъектыРасценки.Работа.СуммарнаяРабота	
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

