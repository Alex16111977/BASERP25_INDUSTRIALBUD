// Процедуры проведения

// Процедура устанавливает статус сделки недвижимости
// как "Отменена".
//
// Параметры:
//  Нет.
//
Процедура Расторгнуть()
	
	// Спишем остатки задолженности
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РасчетыСКлиентамиПоОбъектамНедвижимости.АналитикаУчетаПоПартнерам,
	|	РасчетыСКлиентамиПоОбъектамНедвижимости.Договор,
	|	РасчетыСКлиентамиПоОбъектамНедвижимости.ОбъектНедвижимости,
	|	РасчетыСКлиентамиПоОбъектамНедвижимости.Валюта,
	|	РасчетыСКлиентамиПоОбъектамНедвижимости.СуммаОстаток КАК Сумма,
	|	РасчетыСКлиентамиПоОбъектамНедвижимости.ПлощадьОстаток КАК Площадь
	|ИЗ
	|	РегистрНакопления.УПН_РасчетыСКлиентамиПоОбъектамНедвижимости.Остатки(
	|			&Период,
	|			Договор = &Договор
	|				И ОбъектНедвижимости В (&ОбъектНедвижимости)) КАК РасчетыСКлиентамиПоОбъектамНедвижимости";
	
	Запрос.УстановитьПараметр("Договор", 			Договор);
	Запрос.УстановитьПараметр("ОбъектНедвижимости",	ОбъектыНедвижимости.ВыгрузитьКолонку("ОбъектНедвижимости"));
	Запрос.УстановитьПараметр("Период", 			МоментВремени());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ Выборка.Площадь Тогда
			Продолжить;
		КонецЕсли;
		
		//НоваяЗапись = Движения.УПН_РасчетыСКлиентамиПоОбъектамНедвижимости.Добавить();
		//НоваяЗапись.Период = Дата;
		//
		//ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
		//
		//НоваяЗапись.ВидДвижения = ВидДвиженияНакопления.Расход;
		//НоваяЗапись.Площадь     = Выборка.Площадь;
		//НоваяЗапись.Сумма       = 0;
		
		//Если Выборка.Сумма > 0 Тогда
		//	
		//	НоваяЗапись.ВидДвижения = ВидДвиженияНакопления.Приход;
		//	//НоваяЗапись.Сумма = - Выборка.Сумма;			
		//	НоваяЗапись.Площадь = - Выборка.Площадь;
		//	
		//Иначе
		//	
		//	НоваяЗапись.ВидДвижения = ВидДвиженияНакопления.Расход;
		//	//НоваяЗапись.Сумма = Выборка.Сумма;  		
		//	НоваяЗапись.Площадь = Выборка.Площадь;
		//	
		//КонецЕсли;		
		
	КонецЦикла; 
	
	// Сделаем расход по возврату клиенту и приход на сумму санкций
	АналитикаУчетаПоПартнерам = РегистрыСведений.АналитикаУчетаПоПартнерам.ЗначениеКлючаАналитики(ЭтотОбъект);
	
	Для Каждого СтрокаТЧ Из ОбъектыНедвижимости Цикл
		
		Если СтрокаТЧ.СуммаВозврата <> 0 Тогда
			
			НоваяЗапись = Движения.УПН_РасчетыСКлиентамиПоОбъектамНедвижимости.Добавить();
			НоваяЗапись.ВидДвижения = ВидДвиженияНакопления.Расход;
			НоваяЗапись.Период = Дата;
			НоваяЗапись.ОбъектНедвижимости = СтрокаТЧ.ОбъектНедвижимости;
			НоваяЗапись.АналитикаУчетаПоПартнерам = АналитикаУчетаПоПартнерам;
			НоваяЗапись.Договор = Договор;
			НоваяЗапись.Валюта = Договор.ВалютаВзаиморасчетов;
			НоваяЗапись.Сумма = СтрокаТЧ.СуммаВозврата;
			НоваяЗапись.Площадь = РегистрыНакопления.УПН_РасчетыСКлиентамиПоОбъектамНедвижимости.Остатки(МоментВремени(),Новый Структура("Договор,ОбъектНедвижимости",Договор,СтрокаТЧ.ОбъектНедвижимости),,"Площадь").Итог("Площадь");
			
		КонецЕсли;
		
		Если СтрокаТЧ.Санкции Тогда
			
			НоваяЗапись = Движения.УПН_РасчетыСКлиентамиПоОбъектамНедвижимости.Добавить();
			НоваяЗапись.ВидДвижения = ВидДвиженияНакопления.Приход;
			НоваяЗапись.Период = Дата;
			НоваяЗапись.ОбъектНедвижимости = СтрокаТЧ.ОбъектНедвижимости;
			НоваяЗапись.АналитикаУчетаПоПартнерам = АналитикаУчетаПоПартнерам;
			НоваяЗапись.Договор = Договор;
			НоваяЗапись.Валюта = Договор.ВалютаВзаиморасчетов;
			НоваяЗапись.Сумма = СтрокаТЧ.Санкции;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СоответствиеДоговоровИДолей()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасторжениеСделкиПоНедвижимости.Ссылка КАК Регистратор,
		|	РасторжениеСделкиПоНедвижимости.Ссылка.Дата КАК Период,
		|	РасторжениеСделкиПоНедвижимости.ОбъектНедвижимости КАК Доля,
		|	ИСТИНА КАК Расторгнут,
		|	РасторжениеСделкиПоНедвижимости.Ссылка.Договор КАК Договор,
		|	РасторжениеСделкиПоНедвижимости.Ссылка.Контрагент КАК Контрагент,
		|	РасторжениеСделкиПоНедвижимости.Ссылка.СтатусДокумента КАК Статус
		|ИЗ
		|	Документ.УПН_РасторжениеСделкиПоНедвижимости.ОбъектыНедвижимости КАК РасторжениеСделкиПоНедвижимости
		|ГДЕ
		|	РасторжениеСделкиПоНедвижимости.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяЗапись = Движения.УСОERP_СоответствиеДоговоровИДолей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);

	КонецЦикла;
	
КонецПроцедуры

