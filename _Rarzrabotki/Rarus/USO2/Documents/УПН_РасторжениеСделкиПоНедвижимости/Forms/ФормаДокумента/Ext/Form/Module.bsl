&НаСервере
Процедура ЗаполнитьОбъектыНедвижимостиНаСервере()
		
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(АналитикаУчетаПоПартнерам.КлючАналитики, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиУчетаПоПартнерам.ПустаяСсылка)) КАК КлючАналитики,
		|	ТЧ_ОбъектыНедвижимости.Ссылка.Договор,
		|	ТЧ_ОбъектыНедвижимости.Ссылка.ВалютаВзаиморасчетов,
		|	ТЧ_ОбъектыНедвижимости.ОбъектНедвижимости,
		|	ТЧ_ОбъектыНедвижимости.Сумма КАК СуммаВозврата
		|ПОМЕСТИТЬ ДанныеДокумента
		|ИЗ
		|	Документ.УПН_ДоговорПоНедвижимости.ОбъектыНедвижимости КАК ТЧ_ОбъектыНедвижимости
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам
		|		ПО ТЧ_ОбъектыНедвижимости.Ссылка.Партнер = АналитикаУчетаПоПартнерам.Партнер
		|			И ТЧ_ОбъектыНедвижимости.Ссылка.Организация = АналитикаУчетаПоПартнерам.Организация
		|			И ТЧ_ОбъектыНедвижимости.Ссылка.Контрагент = АналитикаУчетаПоПартнерам.Контрагент
		|			И ТЧ_ОбъектыНедвижимости.Ссылка.Договор = АналитикаУчетаПоПартнерам.Договор
		|			И ТЧ_ОбъектыНедвижимости.Ссылка.НаправлениеДеятельности = АналитикаУчетаПоПартнерам.НаправлениеДеятельности
		|ГДЕ
		|	ТЧ_ОбъектыНедвижимости.Ссылка = &ДоговорПоНедвижимости
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеДокумента.ОбъектНедвижимости,
		|	СУММА(ДанныеДокумента.СуммаВозврата - ЕСТЬNULL(РасчетыПоОбъектамНедвижимостиОбороты.СуммаРасход, 0)) КАК СуммаВозврата
		|ИЗ
		|	ДанныеДокумента КАК ДанныеДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УПН_РасчетыСКлиентамиПоОбъектамНедвижимости.Обороты(
		|				,
		|				&КонецПериода,
		|				Регистратор,
		|				(АналитикаУчетаПоПартнерам, Договор, Валюта, ОбъектНедвижимости) В
		|					(ВЫБРАТЬ
		|						ДанныеДокумента.КлючАналитики,
		|						ДанныеДокумента.Договор,
		|						ДанныеДокумента.ВалютаВзаиморасчетов,
		|						ДанныеДокумента.ОбъектНедвижимости
		|					ИЗ
		|						ДанныеДокумента КАК ДанныеДокумента)) КАК РасчетыПоОбъектамНедвижимостиОбороты
		|		ПО ДанныеДокумента.КлючАналитики = РасчетыПоОбъектамНедвижимостиОбороты.АналитикаУчетаПоПартнерам
		|			И ДанныеДокумента.Договор = РасчетыПоОбъектамНедвижимостиОбороты.Договор
		|			И ДанныеДокумента.ОбъектНедвижимости = РасчетыПоОбъектамНедвижимостиОбороты.ОбъектНедвижимости
		|			И ДанныеДокумента.ВалютаВзаиморасчетов = РасчетыПоОбъектамНедвижимостиОбороты.Валюта
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеДокумента.ОбъектНедвижимости
		|
		|ИМЕЮЩИЕ
		|	СУММА(ДанныеДокумента.СуммаВозврата - ЕСТЬNULL(РасчетыПоОбъектамНедвижимостиОбороты.СуммаРасход, 0)) <> 0";
		//|	И РасчетыПоОбъектамНедвижимостиОбороты.Регистратор <> &Ссылка";
	
	Запрос.УстановитьПараметр("ДоговорПоНедвижимости", 	Объект.ДоговорПоНедвижимости);
	Запрос.УстановитьПараметр("Ссылка"               , 	Объект.Ссылка);
	Запрос.УстановитьПараметр("КонецПериода"         ,  Новый Граница(Объект.Дата,ВидГраницы.Исключая));  	
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ОбъектыНедвижимости.Загрузить(Результат.Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОбъектыНедвижимости(Команда)
	
	Если ЗначениеЗаполнено(Объект.ДоговорПоНедвижимости) Тогда
		ЗаполнитьОбъектыНедвижимостиНаСервере();
		ОбновитьСуммуКВозвратуСУчетомСанкции();
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСуммуКВозвратуСУчетомСанкции()
	Для Каждого стр из Объект.ОбъектыНедвижимости Цикл
		стр.Квозврату = стр.СуммаВозврата - стр.Санкции;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ОбновитьСуммуКВозвратуСУчетомСанкции();
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыНедвижимостиСанкцииПриИзменении(Элемент)
	ОбновитьСуммуКВозвратуСУчетомСанкции();
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыНедвижимостиСуммаВозвратаПриИзменении(Элемент)
	
	ОбновитьСуммуКВозвратуСУчетомСанкции(); 
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыНедвижимостиКВозвратуПриИзменении(Элемент)
	ТекСтрока = Элементы.ОбъектыНедвижимости.ТекущиеДанные;
	ТекСтрока.СуммаВозврата = ТекСтрока.Санкции+ТекСтрока.КВозврату;
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения

	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	МодификацияКонфигурацииПереопределяемый.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект); 	

КонецПроцедуры

&НаСервере
Процедура ОбъектыНедвижимостиОбъектНедвижимостиПриИзмененииНаСервере(ИдСтроки)
	
	ТекСтрока = Объект.ОбъектыНедвижимости.НайтиПоИдентификатору(ИдСтроки);
	ТекСтрока.СуммаВозврата = Объект.ДоговорПоНедвижимости.ОбъектыНедвижимости.Выгрузить().Скопировать(Новый Структура("ОбъектНедвижимости",ТекСтрока.ОбъектНедвижимости)).Итог("Сумма");
	ТекСтрока.КВозврату = ТекСтрока.СуммаВозврата-ТекСтрока.Санкции;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыНедвижимостиОбъектНедвижимостиПриИзменении(Элемент)
	ОбъектыНедвижимостиОбъектНедвижимостиПриИзмененииНаСервере(Элементы.ОбъектыНедвижимости.ТекущиеДанные.ПолучитьИдентификатор());
КонецПроцедуры

#КонецОбласти

