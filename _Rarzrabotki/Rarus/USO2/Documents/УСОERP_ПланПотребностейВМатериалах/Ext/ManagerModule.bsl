
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Прочее

// Заполняет таблицу реквизитов, зависимых от хозяйственной операции
//
// Параметры:
//	ХозяйственнаяОперация - ПеречислениеСсылка.ХозяйственныеОперации - хозяйственная операция соглашения
//	МассивВсехРеквизитов - Массив - реквизиты, которые не зависят от хозяйственной операции
//	МассивРеквизитовОперации - Массив - реквизиты, которые зависят от хозяйственной операции
//
Процедура ЗаполнитьИменаРеквизитовПоОперации(ВидОперации, МассивВсехРеквизитов, МассивРеквизитовОперации) Экспорт
	
	МассивВсехРеквизитов = Новый Массив;
	МассивВсехРеквизитов.Добавить("Периодичность");
	МассивВсехРеквизитов.Добавить("Статус");
	МассивВсехРеквизитов.Добавить("ОбъектСтроительства");
	МассивВсехРеквизитов.Добавить("ВыделятьЦветомРабочиеДни");
	МассивВсехРеквизитов.Добавить("ДатаНачала");
	МассивВсехРеквизитов.Добавить("ДатаОкончания");
	
	МассивРеквизитовОперации = Новый Массив;	
	Если ВидОперации = Перечисления.УСОERP_ВидыОперацийПланаПотребности.ПоПлану Тогда
		МассивВсехРеквизитов.Добавить("Периодичность");
		МассивВсехРеквизитов.Добавить("Статус");
		МассивВсехРеквизитов.Добавить("ОбъектСтроительства");
		МассивВсехРеквизитов.Добавить("ВыделятьЦветомРабочиеДни");
		МассивВсехРеквизитов.Добавить("ДатаНачала");
		МассивВсехРеквизитов.Добавить("ДатаОкончания");
	Иначе 	
		МассивВсехРеквизитов.Добавить("Периодичность");
		МассивВсехРеквизитов.Добавить("Статус");
		МассивВсехРеквизитов.Добавить("ОбъектСтроительства");
		МассивВсехРеквизитов.Добавить("ВыделятьЦветомРабочиеДни");
		МассивВсехРеквизитов.Добавить("ДатаНачала");
		МассивВсехРеквизитов.Добавить("ДатаОкончания");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстыЗапроса.Добавить(ТекстЗапросаВтТаблицаРаботы(),				 		"");
	ТекстыЗапроса.Добавить(ТекстЗапросаТаблицаПланыПотребностейВМатериалах(),  	"ТаблицаПланыПотребностейВМатериалах");
	ТекстыЗапроса.Добавить(ТекстЗапросаТаблицаОбеспечениеЗаказов(),  			"ТаблицаОбеспечениеЗаказов");
	
	Запрос.Текст = "";
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		Запрос.Текст = Запрос.Текст + ТекстЗапроса.Значение;
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////
	// Выполним запрос
	
	Результат = Запрос.ВыполнитьПакет();
	
	////////////////////////////////////////////////////////////////////////////
	// Поместим результаты запроса в дополнительные свойства
	
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		
		ИмяТаблицы = ТекстЗапроса.Представление;
		
		Если Не ПустаяСтрока(ИмяТаблицы) Тогда
			
			Индекс = ТекстыЗапроса.Индекс(ТекстЗапроса);
			ДополнительныеСвойства.ТаблицыДляДвижений.Вставить(ИмяТаблицы, Результат[Индекс].Выгрузить());
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ПланПотребностейВМатериалах.Дата КАК Период,
	|	УСОERP_ПланПотребностейВМатериалах.Ссылка КАК Ссылка,
	|	УСОERP_ПланПотребностейВМатериалах.Организация КАК Организация,
	|	УСОERP_ПланПотребностейВМатериалах.ВидОперации КАК ВидОперации
	|ИЗ
	|	Документ.УСОERP_ПланПотребностейВМатериалах КАК УСОERP_ПланПотребностейВМатериалах
	|ГДЕ
	|	УСОERP_ПланПотребностейВМатериалах.Ссылка = &Ссылка";
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	//
	Запрос.УстановитьПараметр("Период",              	Реквизиты.Период);
	Запрос.УстановитьПараметр("ВидОперации",            Реквизиты.ВидОперации);
	Запрос.УстановитьПараметр("Организация",         	Реквизиты.Организация);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ПланПотребностейВМатериалах.Дата КАК Период,
	|	УСОERP_ПланПотребностейВМатериалах.Ссылка КАК Ссылка,
	|	УСОERP_ПланПотребностейВМатериалах.Организация КАК Организация,
	|	УСОERP_ПланПотребностейВМатериалах.ВидОперации КАК ВидОперации,
	|	УСОERP_ПланПотребностейВМатериалах.НачалоПериода,
	|	УСОERP_ПланПотребностейВМатериалах.ОкончаниеПериода,
	|	УСОERP_ПланПотребностейВМатериалах.Статус,
	|	УСОERP_ПланПотребностейВМатериалах.НаправлениеДеятельности,
	|	УСОERP_ПланПотребностейВМатериалах.ОбъектСтроительства
	|ИЗ
	|	Документ.УСОERP_ПланПотребностейВМатериалах КАК УСОERP_ПланПотребностейВМатериалах
	|ГДЕ
	|	УСОERP_ПланПотребностейВМатериалах.Ссылка = &Ссылка";
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	//
	Запрос.УстановитьПараметр("Период",              	Реквизиты.Период);
	Запрос.УстановитьПараметр("ВидОперации",            Реквизиты.ВидОперации);
	Запрос.УстановитьПараметр("Организация",         	Реквизиты.Организация);
	Запрос.УстановитьПараметр("НачалоПериода",         	Реквизиты.НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода",		Реквизиты.ОкончаниеПериода);
	Запрос.УстановитьПараметр("Статус",         		Реквизиты.Статус);
	Запрос.УстановитьПараметр("Дата",					Новый Граница(Реквизиты.Период,ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ОбъектСтроительства",	Реквизиты.ОбъектСтроительства);
	Запрос.УстановитьПараметр("НаправлениеДеятельности",Реквизиты.НаправлениеДеятельности);
	Запрос.УстановитьПараметр("ТипПередачиМатериаловВПроизводство",	Константы.УСОERP_ПередачаМатериаловВПроизводствоПоРасходуВСтроительстве.Получить());
	//Запрос.УстановитьПараметр("Склад", Реквизиты.Склад);
	
КонецПроцедуры

Функция ТекстЗапросаВтТаблицаРаботы()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПланПотребностейВМатериалах.Работа,
	|	ПланПотребностейВМатериалах.Номенклатура,
	|	ПланПотребностейВМатериалах.Характеристика,
	|	ПланПотребностейВМатериалах.ЕдиницаИзмерения,
	|	ПланПотребностейВМатериалах.Количество,
	|	ПланПотребностейВМатериалах.Период,
	|	ПланПотребностейВМатериалах.Склад,
	|	ПланПотребностейВМатериалах.Упаковка,
	|	ПланПотребностейВМатериалах.КоличествоУпаковок,
	|	ПланПотребностейВМатериалах.Ссылка.Статус КАК Статус,
	|	ПланПотребностейВМатериалах.НомерСтроки
	|ПОМЕСТИТЬ ВтТаблицаРаботы
	|ИЗ
	|	Документ.УСОERP_ПланПотребностейВМатериалах.Потребности КАК ПланПотребностейВМатериалах
	|ГДЕ
	|	ПланПотребностейВМатериалах.Ссылка = &Ссылка  И  ПланПотребностейВМатериалах.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаПланыПотребностейВМатериалах()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Организация КАК Организация,
	|	&ВидОперации КАК ВидПланаПотребности,
	|	ТаблицаРаботы.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР КОГДА ТаблицаРаботы.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка) ТОГДА ТаблицаРаботы.Работа ИНАЧЕ ТаблицаРаботы.Работа.РаботаИсточник КОНЕЦ КАК Работа,
	|	ТаблицаРаботы.Номенклатура КАК Номенклатура,
	|	ТаблицаРаботы.Характеристика КАК Характеристика,
	|	ТаблицаРаботы.Склад КАК Склад,
	|	ТаблицаРаботы.Период КАК ДатаПлана,
	|	ТаблицаРаботы.Количество КАК Количество
	|ИЗ
	|	ВтТаблицаРаботы КАК ТаблицаРаботы
	|ГДЕ
	|	ТаблицаРаботы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|	И ТаблицаРаботы.Количество > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Период,
	|	ВложенныйЗапрос.Организация,
	|	ВложенныйЗапрос.ВидПланаПотребности,
	|	СУММА(ВложенныйЗапрос.НомерСтроки) КАК НомерСтроки,
	|	ВложенныйЗапрос.Работа,
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.Характеристика,
	|	ВложенныйЗапрос.Склад,
	|	ВложенныйЗапрос.ДатаПлана,
	|	СУММА(ВложенныйЗапрос.Количество) КАК Количество
	|ИЗ
	|	(ВЫБРАТЬ
	|		&Период КАК Период,
	|		&Организация КАК Организация,
	|		&ВидОперации КАК ВидПланаПотребности,
	|		ТаблицаРаботы.НомерСтроки КАК НомерСтроки,
	|		ВЫБОР
	|			КОГДА ТаблицаРаботы.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|				ТОГДА ТаблицаРаботы.Работа
	|			ИНАЧЕ ТаблицаРаботы.Работа.РаботаИсточник
	|		КОНЕЦ КАК Работа,
	|		ТаблицаРаботы.Номенклатура КАК Номенклатура,
	|		ТаблицаРаботы.Характеристика КАК Характеристика,
	|		ТаблицаРаботы.Склад КАК Склад,
	|		ТаблицаРаботы.Период КАК ДатаПлана,
	|		ТаблицаРаботы.Количество КАК Количество
	|	ИЗ
	|		ВтТаблицаРаботы КАК ТаблицаРаботы
	|	ГДЕ
	|		ТаблицаРаботы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|		И ТаблицаРаботы.Количество > 0
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		&Период,
	|		&Организация,
	|		&ВидОперации,
	|		0,
	|		УСОERP_ПланыПотребностейВМатериалахСрезПоследних.Работа,
	|		УСОERP_ПланыПотребностейВМатериалахСрезПоследних.Номенклатура,
	|		УСОERP_ПланыПотребностейВМатериалахСрезПоследних.Характеристика,
	|		УСОERP_ПланыПотребностейВМатериалахСрезПоследних.Склад,
	|		УСОERP_ПланыПотребностейВМатериалахСрезПоследних.ДатаПлана,
	|		0
	|	ИЗ
	|		РегистрСведений.УСОERP_ПланыПотребностейВМатериалах.СрезПоследних(
	|				&Дата,
	|				Склад.УСОERP_ОбъектСтроительства = &ОбъектСтроительства
	|					И ВидПланаПотребности = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийПланаПотребности.ПоПлану)
	|					И (ДатаПлана МЕЖДУ &НачалоПериода И &ОкончаниеПериода)) КАК УСОERP_ПланыПотребностейВМатериалахСрезПоследних
	|	ГДЕ
	|		&ВидОперации = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийПланаПотребности.ПоПлану)
	|		И &Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Период,
	|	ВложенныйЗапрос.Организация,
	|	ВложенныйЗапрос.ВидПланаПотребности,
	|	ВложенныйЗапрос.Работа,
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.Характеристика,
	|	ВложенныйЗапрос.Склад,
	|	ВложенныйЗапрос.ДатаПлана
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаОбеспечениеЗаказов()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ИСТИНА КАК Активность,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	Потребности.Номенклатура КАК Номенклатура,
	|	Потребности.Характеристика КАК Характеристика,
	|	Потребности.Ссылка.ЦеховаяКладовая КАК Склад,
	|	ДанныеНазначений.Ссылка КАК Назначение,
	|	Потребности.КоличествоУпаковок КАК Потребность,
	|	Потребности.КоличествоУпаковок КАК КЗаказу,
	|	0 КАК НаличиеПодЗаказ,
	|	ЛОЖЬ КАК КонтролироватьТолькоНаличиеПодЗаказ
	|ИЗ
	|	Документ.УСОERP_ПланПотребностейВМатериалах.Потребности КАК Потребности
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
	|			Назначения.Ссылка КАК Ссылка
	|		ИЗ
	|			Справочник.Назначения КАК Назначения
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					ЗаказМатериаловВПроизводство.Ссылка КАК Заказ
	|				ИЗ
	|					Документ.ЗаказМатериаловВПроизводство КАК ЗаказМатериаловВПроизводство
	|				ГДЕ
	|					ЗаказМатериаловВПроизводство.ДокументОснование = &Ссылка
	|					И НЕ ЗаказМатериаловВПроизводство.ПометкаУдаления
	|					И 0 <> &ТипПередачиМатериаловВПроизводство
	|				
	|				ОБЪЕДИНИТЬ ВСЕ
	|				
	|				ВЫБРАТЬ
	|					ЗаказНаВнутреннееПотребление.Ссылка
	|				ИЗ
	|					Документ.ЗаказНаВнутреннееПотребление КАК ЗаказНаВнутреннееПотребление
	|				ГДЕ
	|					ЗаказНаВнутреннееПотребление.ДокументОснование = &Ссылка
	|					И НЕ ЗаказНаВнутреннееПотребление.ПометкаУдаления
	|					И 0 = &ТипПередачиМатериаловВПроизводство) КАК ЗаказыМатериалов
	|				ПО Назначения.Заказ = ЗаказыМатериалов.Заказ
	|		ГДЕ
	|			(Назначения.НаправлениеДеятельности = &НаправлениеДеятельности
	|					ИЛИ Назначения.НаправлениеДеятельности = ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка))
	|		
	|		УПОРЯДОЧИТЬ ПО
	|			Назначения.НаправлениеДеятельности УБЫВ) КАК ДанныеНазначений
	|		ПО НЕ ДанныеНазначений.Ссылка ЕСТЬ NULL
	|ГДЕ
	|	Потребности.Ссылка = &Ссылка
	|	И 2 = &ТипПередачиМатериаловВПроизводство
	|	И Потребности.Ссылка.ОбеспечиватьОбособленно
	|;";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область Отчеты
// Определяет список команд отчетов.
//
// Параметры:
//   КомандыОтчетов - ТаблицаЗначений - Таблица с командами отчетов. Для изменения.
//       См. описание 1 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
//   Параметры - Структура - Вспомогательные параметры. Для чтения.
//       См. описание 2 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
//
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, Параметры) Экспорт
	
	ВариантыОтчетовУТПереопределяемый.ДобавитьКомандуСтруктураПодчиненности(КомандыОтчетов);
	
КонецПроцедуры

#КонецОбласти  

#Область Печать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// График обеспечения материалами
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "ГрафикОбеспеченияМатериалами";
	КомандаПечати.Представление = НСтр("ru = 'График обеспечения материалами'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "ГрафикОбеспеченияМатериаламиСумма";
	КомандаПечати.Представление = НСтр("ru = 'График обеспечения материалами (с суммой)'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "КомплектовочнаяВедомость";
	КомандаПечати.Представление = НСтр("ru = 'Комплектовочная ведомость'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "КомплектовочнаяВедомостьСумма";
	КомандаПечати.Представление = НСтр("ru = 'Комплектовочная ведомость (с суммой)'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "КомплектовочнаяВедомостьПоСрокам";
	КомандаПечати.Представление = НСтр("ru = 'Комплектовочная ведомость по срокам'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "КомплектовочнаяВедомостьПоСрокамСумма";
	КомандаПечати.Представление = НСтр("ru = 'Комплектовочная ведомость по срокам (с суммой)'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина; 
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ГрафикОбеспеченияМатериалами") Тогда
		ПараметрыПечати.Вставить("Сумма",Ложь);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ГрафикОбеспеченияМатериалами",
		НСтр("ru = 'График обеспечения материалами'"),
		СформироватьПечатнуюФормуПлана(МассивОбъектов, ОбъектыПечати, ПараметрыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ГрафикОбеспеченияМатериаламиСумма") Тогда
		ПараметрыПечати.Вставить("Сумма",Истина);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ГрафикОбеспеченияМатериаламиСумма",
		НСтр("ru = 'График обеспечения материалами'"),
		СформироватьПечатнуюФормуПлана(МассивОбъектов, ОбъектыПечати, ПараметрыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КомплектовочнаяВедомость") Тогда
		
		ПараметрыПечати.Вставить("Сумма", Ложь);
		ПараметрыПечати.Вставить("ПоСрокам", Ложь);
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"КомплектовочнаяВедомость",
		НСтр("ru = 'Комплектовочная ведомость'"),
		СформироватьПечатнуюФормуКомплектовочнойВедомости(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
		);
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КомплектовочнаяВедомостьПоСрокам") Тогда
		
		ПараметрыПечати.Вставить("Сумма", Ложь);
		ПараметрыПечати.Вставить("ПоСрокам", Истина);
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"КомплектовочнаяВедомостьПоСрокам",
		НСтр("ru = 'Комплектовочная ведомость по срокам'"),
		СформироватьПечатнуюФормуКомплектовочнойВедомости(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
		);
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КомплектовочнаяВедомостьСумма") Тогда
		
		ПараметрыПечати.Вставить("Сумма", Истина);
		ПараметрыПечати.Вставить("ПоСрокам", Ложь); 
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"КомплектовочнаяВедомостьСумма",
		НСтр("ru = 'Комплектовочная ведомость (с суммой)'"),
		СформироватьПечатнуюФормуКомплектовочнойВедомости(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
		);
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КомплектовочнаяВедомостьПоСрокамСумма") Тогда
		
		ПараметрыПечати.Вставить("Сумма", Истина);
		ПараметрыПечати.Вставить("ПоСрокам", Истина); 
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"КомплектовочнаяВедомостьПоСрокамСумма",
		НСтр("ru = 'Комплектовочная ведомость (с суммой)'"),
		СформироватьПечатнуюФормуКомплектовочнойВедомости(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
		);
	КонецЕсли;  
	
	ФормированиеПечатныхФорм.ЗаполнитьПараметрыОтправки(ПараметрыВывода.ПараметрыОтправки, МассивОбъектов, КоллекцияПечатныхФорм);
	
КонецПроцедуры

Функция СформироватьПечатнуюФормуПлана(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ПараметрыПечати <> Неопределено И ПараметрыПечати.Свойство("КроссТаблица") Тогда
		ПоУмолчаниюКроссТаблица = ПараметрыПечати.КроссТаблица = Истина;
		ПоУмолчаниюТаблица = ПараметрыПечати.КроссТаблица = Ложь;
	Иначе
		ПоУмолчаниюКроссТаблица = Ложь;
		ПоУмолчаниюТаблица = Ложь;
	КонецЕсли; 
	
	ВыводитьШапку = Истина;
	Если ПараметрыПечати <> Неопределено И ПараметрыПечати.Свойство("ВыводитьШапку") Тогда
		ВыводитьШапку = ПараметрыПечати.ВыводитьШапку;
	КонецЕсли;
	
	ВыводитьСценарий 		= Ложь;
	ВыводитьПериодСтатус	= Истина;
	ВыводитьПодразделение	= Ложь;
	ВыводитьПартнера 		= Ложь;
	ВыводитьСоглашение 		= Ложь;
	ВыводитьСклад 			= Истина;
	ВыводитьПартнераВТЧ 	= Ложь;
	ВыводитьСоглашениеВТЧ 	= Ложь;
	ВыводитьСкладВТЧ 		= Истина;
	
	//Если ПараметрыПечати <> Неопределено И НЕ ПараметрыПечати.Свойство("ВыводитьСценарий", ВыводитьСценарий) Тогда
	//	ВыводитьСценарий 	= Истина;
	//КонецЕсли;
	Если ПараметрыПечати <> Неопределено И НЕ ПараметрыПечати.Свойство("ВыводитьПериодСтатус", ВыводитьПериодСтатус) Тогда
		ВыводитьПериодСтатус	= Истина;
	КонецЕсли;
	//Если ПараметрыПечати <> Неопределено И НЕ ПараметрыПечати.Свойство("ВыводитьПодразделение", ВыводитьПодразделение) Тогда
	//	ВыводитьПодразделение 	= Истина;
	//КонецЕсли;
	//Если ПараметрыПечати <> Неопределено И НЕ ПараметрыПечати.Свойство("ВыводитьПартнера", ВыводитьПартнера) Тогда
	//	ВыводитьПартнера 		= Истина;
	//КонецЕсли;
	//Если ПараметрыПечати <> Неопределено И НЕ ПараметрыПечати.Свойство("ВыводитьСоглашение", ВыводитьСоглашение) Тогда
	//	ВыводитьСоглашение 		= Истина;
	//КонецЕсли;
	Если ПараметрыПечати <> Неопределено И НЕ ПараметрыПечати.Свойство("ВыводитьСклад", ВыводитьСклад) Тогда
		ВыводитьСклад 			= Истина;
	КонецЕсли;
	//Если ПараметрыПечати <> Неопределено И НЕ ПараметрыПечати.Свойство("ВыводитьПартнераВТЧ", ВыводитьПартнераВТЧ) Тогда
	//	ВыводитьПартнераВТЧ 	= Истина;
	//КонецЕсли;
	//Если ПараметрыПечати <> Неопределено И НЕ ПараметрыПечати.Свойство("ВыводитьСоглашениеВТЧ", ВыводитьСоглашениеВТЧ) Тогда
	//	ВыводитьСоглашениеВТЧ 	= Истина;
	//КонецЕсли;
	Если ПараметрыПечати <> Неопределено И НЕ ПараметрыПечати.Свойство("ВыводитьСкладВТЧ", ВыводитьСкладВТЧ) Тогда
		ВыводитьСкладВТЧ 		= Истина;
	КонецЕсли;
	
	КолонкаКодов = ФормированиеПечатныхФорм.ИмяДополнительнойКолонки();
	ВыводитьКоды = ЗначениеЗаполнено(КолонкаКодов);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ПланПотребностейВМатериалах.ДокументУтверждения КАК ДокументУтверждения
	|ПОМЕСТИТЬ ВрТабДокУтверждения
	|ИЗ
	|	Документ.УСОERP_ПланПотребностейВМатериалах КАК УСОERP_ПланПотребностейВМатериалах
	|ГДЕ
	|	УСОERP_ПланПотребностейВМатериалах.Ссылка В(&МассивДокументов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(УСОERP_БюджетСтроительства.Дата) КАК Дата,
	|	УСОERP_БюджетСтроительства.ДокументОснование КАК ДокументУтверждения
	|ПОМЕСТИТЬ ВрТабБюджеты
	|ИЗ
	|	Документ.УСОERP_БюджетСтроительства КАК УСОERP_БюджетСтроительства
	|ГДЕ
	|	УСОERP_БюджетСтроительства.Проведен
	|	И УСОERP_БюджетСтроительства.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|	И УСОERP_БюджетСтроительства.ДокументОснование.КопияСценария <> ЗНАЧЕНИЕ(Справочник.УСОERP_СценарииПланированияПроектовСтроительства.ПустаяСсылка)
	|	И &ПоСумме
	|	И УСОERP_БюджетСтроительства.ДокументОснование В
	|			(ВЫБРАТЬ
	|				ВрТабДокУтверждения.ДокументУтверждения
	|			ИЗ
	|				ВрТабДокУтверждения)
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_БюджетСтроительства.ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТабБюджеты.ДокументУтверждения КАК ДокументУтверждения,
	|	УСОERP_БюджетСтроительства.Ссылка КАК Бюджет
	|ПОМЕСТИТЬ ВрТабДокБюджет
	|ИЗ
	|	ВрТабБюджеты КАК ВрТабБюджеты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_БюджетСтроительства КАК УСОERP_БюджетСтроительства
	|		ПО ВрТабБюджеты.Дата = УСОERP_БюджетСтроительства.Дата
	|			И ВрТабБюджеты.ДокументУтверждения = УСОERP_БюджетСтроительства.ДокументОснование
	|ГДЕ
	|	УСОERP_БюджетСтроительства.Проведен
	|	И УСОERP_БюджетСтроительства.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|	И УСОERP_БюджетСтроительства.ДокументОснование.КопияСценария <> ЗНАЧЕНИЕ(Справочник.УСОERP_СценарииПланированияПроектовСтроительства.ПустаяСсылка)
	|	И &ПоСумме
	|	И УСОERP_БюджетСтроительства.ДокументОснование В
	|			(ВЫБРАТЬ
	|				ВрТабДокУтверждения.ДокументУтверждения
	|			ИЗ
	|				ВрТабДокУтверждения)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_СтоимостьМатериаловВБюджетеСтроительства.Номенклатура КАК Номенклатура,
	|	УСОERP_СтоимостьМатериаловВБюджетеСтроительства.Характеристика КАК Характеристика,
	|	СРЕДНЕЕ(УСОERP_СтоимостьМатериаловВБюджетеСтроительства.БазоваяЦена) КАК БазоваяЦена,
	|	ВрТабДокБюджет.ДокументУтверждения КАК ДокументУтверждения
	|ПОМЕСТИТЬ ВрТабЦены
	|ИЗ
	|	РегистрСведений.УСОERP_СтоимостьМатериаловВБюджетеСтроительства КАК УСОERP_СтоимостьМатериаловВБюджетеСтроительства
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВрТабДокБюджет КАК ВрТабДокБюджет
	|		ПО УСОERP_СтоимостьМатериаловВБюджетеСтроительства.Регистратор = ВрТабДокБюджет.Бюджет
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_СтоимостьМатериаловВБюджетеСтроительства.Номенклатура,
	|	УСОERP_СтоимостьМатериаловВБюджетеСтроительства.Характеристика,
	|	ВрТабДокБюджет.ДокументУтверждения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Номенклатура КАК Номенклатура,
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Характеристика КАК Характеристика,
	|	СУММА(УСОERP_ПланПотребностейВМатериалахПотребности.Количество) КАК Количество,
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Работа КАК Работа
	|ПОМЕСТИТЬ ВТ_ИтогПоТовару
	|ИЗ
	|	Документ.УСОERP_ПланПотребностейВМатериалах.Потребности КАК УСОERP_ПланПотребностейВМатериалахПотребности
	|ГДЕ
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Ссылка В(&МассивДокументов)
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Номенклатура,
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Характеристика,
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Работа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокумента.Ссылка КАК Ссылка,
	|	ТаблицаДокумента.Номер КАК Номер,
	|	ТаблицаДокумента.Дата КАК Дата,
	|	ТаблицаДокумента.Ответственный КАК Ответственный,
	|	ТаблицаДокумента.Статус КАК Статус,
	|	ТаблицаДокумента.Периодичность КАК Периодичность,
	|	ТаблицаДокумента.НачалоПериода КАК НачалоПериода,
	|	ТаблицаДокумента.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ТаблицаДокумента.ВидОперации КАК ВидПлана,
	|	ВЫБОР
	|		КОГДА &ПоУмолчаниюКроссТаблица
	|				ИЛИ ТаблицаДокумента.КроссТаблица
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК КроссТаблица,
	|	ИСТИНА КАК ЗаполнятьСкладВТЧ,
	|	Пользователи.ФизическоеЛицо КАК ОтветственныйФизЛицо,
	|	ТаблицаДокумента.Склад КАК Склад
	|ИЗ
	|	Документ.УСОERP_ПланПотребностейВМатериалах КАК ТаблицаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|		ПО ТаблицаДокумента.Ответственный = Пользователи.Ссылка
	|ГДЕ
	|	ТаблицаДокумента.Ссылка В(&МассивДокументов)
