	|	ТоварНаименованиеПолное,
	|	ХарактеристикаНаименованиеПолное,
	|	Склад,
	|	ЕдиницаИзмерения,
	|	ДатаПериода
	|ИТОГИ
	|	СРЕДНЕЕ(Цена),
	|	СУММА(Сумма)
	|ПО
	|	Ссылка";
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_УСОERP_ПланПотребностейВМатериалах_ГрафикОбеспеченияМатериалами";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивОбъектов);
	Запрос.УстановитьПараметр("ПоУмолчаниюКроссТаблица", ПоУмолчаниюКроссТаблица);
	Запрос.УстановитьПараметр("ПоУмолчаниюТаблица", ПоУмолчаниюТаблица);
	Запрос.УстановитьПараметр("ПоСумме",ПараметрыПечати.Сумма);
	
	МассивРезультатов 		= Запрос.ВыполнитьПакет();
	ДанныеПечати			= МассивРезультатов[5].Выбрать();
	ВыборкаПоДокументам 	= МассивРезультатов[6].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТаблицаНоменклатуры = МассивРезультатов[6].Выгрузить();
	Строки = ТаблицаНоменклатуры.НайтиСтроки(Новый Структура("Номенклатура",NULL));
	Для Каждого НайденнаяСтрока ИЗ Строки Цикл
		ТаблицаНоменклатуры.Удалить(НайденнаяСтрока);
	КонецЦикла;
	
	ТаблицаНоменклатурыПолная = ТаблицаНоменклатуры.Скопировать();
	ТаблицаНоменклатуры.Свернуть("Ссылка,Номенклатура,ТоварНаименованиеПолное,Склад,Код,Артикул,Характеристика,ХарактеристикаНаименованиеПолное,ЕдиницаИзмерения,Цена","Количество,Сумма");
	ТаблицаНоменклатуры.Колонки.Количество.Имя = "КоличествоИтог";  	
	
	ПервыйДокумент = Истина;
	ЕстьДокументыССуммами = Ложь;
	ЕстьКроссТаблицы = Ложь;
	НачалоШапки = 0;
	ОкончаниеШапки = 0;
	ШиринаНомера = 0;
	ОкончаниеНомера = 0;
	
	ИспользоватьХарактеристикиНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	
	Пока ДанныеПечати.Следующий() Цикл
		
		ПланироватьПоСумме = ПараметрыПечати.Сумма;
		// Найдем в выборке товары по текущему документу
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеПечати.Ссылка);
		НайденСледующий = ВыборкаПоДокументам.НайтиСледующий(СтруктураПоиска);
		ВыборкаПоТоварам = ВыборкаПоДокументам.Выбрать();
		
		КроссТаблица = ДанныеПечати.КроссТаблица;
		
		Если КроссТаблица Тогда
			ТаблицаПериодов = УСОERP_МатериальноТехническоеОбеспечение.ПолучитьТаблицуПериодов();
			УСОERP_МатериальноТехническоеОбеспечение.ЗаполнитьТаблицуПериодов(ТаблицаПериодов, 
			ДанныеПечати.Периодичность, 
			ДанныеПечати.НачалоПериода, 
			ДанныеПечати.ОкончаниеПериода, 
			?(ВыводитьШапку, Ложь, Ложь));
			КроссТаблица = ТаблицаПериодов.Количество() > 1 ИЛИ НЕ ВыводитьШапку;
		КонецЕсли;
		
		// Макет необходимо получать для каждого документа, т.к. размеры колонок изменяются динамически.
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.УСОERP_ПланПотребностейВМатериалах.ПФ_MXL_ГрафикОбеспеченияМатериалами");
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент    = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		// Выводим шапку плана
		Если ВыводитьШапку Тогда
			
			ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
			ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент, Макет, ОбластьМакета, ДанныеПечати.Ссылка);
			
			ТекстЗаголовка = ОбщегоНазначенияУТКлиентСервер.СформироватьЗаголовокДокумента(ДанныеПечати, НСтр("ru='График обеспечения материалами'"));
			ОбластьМакета.Параметры.ТекстЗаголовка = ТекстЗаголовка;
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			Если ВыводитьСценарий Тогда
				ОбластьМакета                                  = Макет.ПолучитьОбласть("Сценарий");
				ПредставлениеСценария                          = Строка(ДанныеПечати.Сценарий) + ", "+ Строка(ДанныеПечати.Периодичность);
				Если ПланироватьПоСумме Тогда
					ПредставлениеСценария                      = ПредставлениеСценария + ", " + Строка(ДанныеПечати.Валюта);
				КонецЕсли; 
				ОбластьМакета.Параметры.ПредставлениеСценария  = ПредставлениеСценария;
				ОбластьМакета.Параметры.Сценарий               = ДанныеПечати.Сценарий;
				ПредставлениеВидаПлана                         = Строка(ДанныеПечати.ВидПлана);
				ОбластьМакета.Параметры.ПредставлениеВидаПлана = ПредставлениеВидаПлана;
				ОбластьМакета.Параметры.ВидПлана               = ДанныеПечати.ВидПлана;
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли;
			
			Если ВыводитьПериодСтатус Тогда
				ОбластьМакета                                = Макет.ПолучитьОбласть("ПериодСтатус");
				ПредставлениеПериода                         = НСтр("ru='Период с %1 по %2'");
				ПредставлениеПериода                         = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПредставлениеПериода,
				Формат(ДанныеПечати.НачалоПериода, "ДЛФ=D"), 
				Формат(ДанныеПечати.ОкончаниеПериода, "ДЛФ=D"));
				ОбластьМакета.Параметры.ПредставлениеПериода = ПредставлениеПериода;
				ОбластьМакета.Параметры.Статус = Строка(ДанныеПечати.Статус);
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли;
			
			Если  ВыводитьПодразделение Тогда
				ОбластьМакета                                       = Макет.ПолучитьОбласть("Подразделение");
				ПредставлениеПодразделения                          = Строка(ДанныеПечати.Подразделение);
				ОбластьМакета.Параметры.ПредставлениеПодразделения  = ПредставлениеПодразделения;
				ОбластьМакета.Параметры.Подразделение               = ДанныеПечати.Подразделение;
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли;
			
			Если  ВыводитьПартнера Тогда
				ОбластьМакета                                 = Макет.ПолучитьОбласть("Партнер");
				ПредставлениеПартнер                          = Строка(ДанныеПечати.Партнер);
				ОбластьМакета.Параметры.ПредставлениеПартнера = ПредставлениеПартнер;
				ОбластьМакета.Параметры.Партнер               = ДанныеПечати.Партнер;
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли; 
			
			Если  ВыводитьСоглашение Тогда
				ОбластьМакета                                   = Макет.ПолучитьОбласть("Соглашение");
				ПредставлениеСоглашения                         = Строка(ДанныеПечати.Соглашение);
				ОбластьМакета.Параметры.ПредставлениеСоглашения = ПредставлениеСоглашения;
				ОбластьМакета.Параметры.Соглашение              = ДанныеПечати.Соглашение;
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли;
			
			Если  ВыводитьСклад Тогда
				ОбластьМакета                               = Макет.ПолучитьОбласть("Склад");
				ПредставлениеСклада                         = Строка(ДанныеПечати.Склад);
				ОбластьМакета.Параметры.ПредставлениеСклада = ПредставлениеСклада;
				ОбластьМакета.Параметры.Склад               = ДанныеПечати.Склад;
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли;
			
		КонецЕсли;
		
		// Выводим заголовок таблицы Товары
		ДопПоля = Новый Массив;
		Если ДанныеПечати.ЗаполнятьСкладВТЧ Тогда
			СтруктураДопПоля = Новый Структура;
			СтруктураДопПоля.Вставить("Заголовок", НСтр("ru='Склад'"));
			СтруктураДопПоля.Вставить("КолонкаЗначения", "Склад");
			ДопПоля.Добавить(СтруктураДопПоля);
		КонецЕсли;
		
		СуффиксОбластиКолонки = ?(ПланироватьПоСумме, "Сумма", "");
		
		СуффиксКроссТаблицы = ?(КроссТаблица, "Кросс","");
		
		БезХарактеристик = НЕ (ВыводитьШапку ИЛИ ИспользоватьХарактеристикиНоменклатуры);
		// Расчет ширины колонки товара
		ШиринаКолонкиТовара = Макет.Область("Товар"+?(БезХарактеристик,"БезХарактеристик", "")).ШиринаКолонки * 2; // Область содержит 2 колонки - номенклатура и характеристика
		
		Если ПланироватьПоСумме Тогда
			ШиринаКолонкиТовара = ШиринаКолонкиТовара - 12;
		КонецЕсли; 
		Если НЕ ВыводитьКоды Тогда
			ШиринаКолонкиТовара = ШиринаКолонкиТовара + Макет.Область("КолонкаКодов").ШиринаКолонки;
		КонецЕсли; 
		Если ДопПоля.Количество() > 0 Тогда
			ШиринаКолонкиТовара = ШиринаКолонкиТовара -Макет.Область("Товар" + СуффиксОбластиКолонки + "ДопПоле"+ Формат(ДопПоля.Количество(), "ЧДЦ=0; ЧГ=0")).ШиринаКолонки * ДопПоля.Количество();
		КонецЕсли; 
		Если ВыводитьШапку ИЛИ ИспользоватьХарактеристикиНоменклатуры Тогда
			ШиринаКолонкиТовара = ШиринаКолонкиТовара / 2;
		КонецЕсли; 
		Макет.Область("Товар"+?(БезХарактеристик,"БезХарактеристик", "")).ШиринаКолонки = ШиринаКолонкиТовара;
		
		ПериодовНаПервойСтранице = 2;
		ПериодовНаСтранице = 7;
		
		ОбластьНомера                   = Макет.ПолучитьОбласть("ШапкаТаблицы|НомерСтроки");
		ОбластьУИ                       = Макет.ПолучитьОбласть("ШапкаТаблицы|УникальныеИдентификаторы");
		ОбластьКодов                    = Макет.ПолучитьОбласть("ШапкаТаблицы|КолонкаКодов");
		ОбластьТовар                    = Макет.ПолучитьОбласть("ШапкаТаблицы"+?(ВыводитьШапку,"","НХ")+"|Товар" +?(БезХарактеристик,"БезХарактеристик", ""));
		ОбластьДанных                   = Макет.ПолучитьОбласть("ШапкаТаблицы"+?(ВыводитьШапку ИЛИ КроссТаблица,"","НХ")+"|Количество" + СуффиксОбластиКолонки + СуффиксКроссТаблицы);
		
		Если ПланироватьПоСумме И КроссТаблица Тогда
			
			ОбластьДанныхНачало                   = Макет.ПолучитьОбласть("ШапкаТаблицы"+?(ВыводитьШапку ИЛИ КроссТаблица,"","НХ")+"|Количество" + СуффиксОбластиКолонки + СуффиксКроссТаблицы+"Цена");
			
		Иначе
			
			ОбластьДанныхНачало = ОбластьДанных;
			
		КонецЕсли;
		
		ОбластьДанныхКроссОкончание     = Макет.ПолучитьОбласть("ШапкаТаблицы|Количество" + СуффиксОбластиКолонки + "КроссОкончание");
		ОбластьДатаПериод               = Макет.ПолучитьОбласть("ШапкаТаблицы|ДатаПериод");
		ОбластьКроссЕдиницаИзмерения    = Макет.ПолучитьОбласть("ШапкаТаблицы|КроссЕдиницаИзмерения");
		Если ДопПоля.Количество() > 0 Тогда
			ОбластьТоварДопПоле         = Макет.ПолучитьОбласть("ШапкаТаблицы|Товар" + СуффиксОбластиКолонки + "ДопПоле"+ Формат(ДопПоля.Количество(), "ЧДЦ=0; ЧГ=0"));
		КонецЕсли; 
		
		ТабличныйДокумент.Вывести(ОбластьНомера);
		Если Не ВыводитьШапку Тогда
			ТабличныйДокумент.Присоединить(ОбластьУИ);
		КонецЕсли;
		
		Если ВыводитьКоды Тогда
			ОбластьКодов.Параметры.ИмяКолонкиКодов = КолонкаКодов;
			ТабличныйДокумент.Присоединить(ОбластьКодов);
		КонецЕсли;
		
		ТабличныйДокумент.Присоединить(ОбластьТовар);
		
		Для каждого ДопПоле Из ДопПоля Цикл
			ОбластьТоварДопПоле.Параметры.Заголовок = ДопПоле.Заголовок;
			ТабличныйДокумент.Присоединить(ОбластьТоварДопПоле);
		КонецЦикла; 
		
		НомерСтраницы = 1;
		Если КроссТаблица Тогда
			
			ТабличныйДокумент.Присоединить(ОбластьКроссЕдиницаИзмерения);			
			
			ОбластьДанныхНачало.Параметры.Заголовок = "Количество"; 
			ТабличныйДокумент.Присоединить(ОбластьДанныхНачало);
			
			СуммыПериодов = Новый Структура;
			
			Для каждого Период Из ТаблицаПериодов Цикл
				//СуммыПериодов.Вставить("Сумма_"+Период.ИмяКолонки, 0);
				СуммыПериодов.Вставить("Сумма_"+Период.ИмяКолонки, ТаблицаНоменклатурыПолная.Скопировать(Новый Структура("ДатаПериода",Период.ДатаНачала)).Итог("Сумма"));
				Индекс = ТаблицаПериодов.Индекс(Период);
				
				Если Индекс = ТаблицаПериодов.Количество()-1 Тогда
					ОбластьДанныхКроссОкончание.Параметры.Заголовок = Период.Заголовок;
					ТабличныйДокумент.Присоединить(ОбластьДанныхКроссОкончание);
				Иначе
					ОбластьДанных.Параметры.Заголовок = Период.Заголовок;
					ТабличныйДокумент.Присоединить(ОбластьДанных);
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			ТабличныйДокумент.Присоединить(ОбластьДатаПериод);
			ТабличныйДокумент.Присоединить(ОбластьДанных);
			
		КонецЕсли; 
		
		НачалоШапки = ТабличныйДокумент.ВысотаТаблицы - ОбластьНомера.ВысотаТаблицы +1;
		ОкончаниеШапки = ТабличныйДокумент.ВысотаТаблицы;
		ШиринаНомера = ОбластьНомера.ШиринаТаблицы;
		
		ОбластьНомера                   = Макет.ПолучитьОбласть("СтрокаТаблицы|НомерСтроки");
		ОбластьУИ                       = Макет.ПолучитьОбласть("СтрокаТаблицы|УникальныеИдентификаторы");
		ОбластьКодов                    = Макет.ПолучитьОбласть("СтрокаТаблицы|КолонкаКодов");
		ОбластьТовар                    = Макет.ПолучитьОбласть("СтрокаТаблицы|Товар"+?(БезХарактеристик,"БезХарактеристик", ""));
		ОбластьДанных                   = Макет.ПолучитьОбласть("СтрокаТаблицы|Количество" + СуффиксОбластиКолонки + СуффиксКроссТаблицы);
		
		Если ПланироватьПоСумме И КроссТаблица Тогда
			ОбластьДанныхНачало =        Макет.ПолучитьОбласть("СтрокаТаблицы|Количество" + СуффиксОбластиКолонки + СуффиксКроссТаблицы+"Цена");
		Иначе
			ОбластьДанныхНачало = ОбластьДанных;
		КонецЕсли;
		
		ОбластьДанныхКроссОкончание     = Макет.ПолучитьОбласть("СтрокаТаблицы|Количество" + СуффиксОбластиКолонки + "КроссОкончание");
		ОбластьДатаПериод               = Макет.ПолучитьОбласть("СтрокаТаблицы|ДатаПериод");
		ОбластьКроссЕдиницаИзмерения    = Макет.ПолучитьОбласть("СтрокаТаблицы|КроссЕдиницаИзмерения");
		Если ДопПоля.Количество() > 0 Тогда
			ОбластьТоварДопПоле         = Макет.ПолучитьОбласть("СтрокаТаблицы|Товар" + СуффиксОбластиКолонки + "ДопПоле"+ Формат(ДопПоля.Количество(), "ЧДЦ=0; ЧГ=0") );
		КонецЕсли;
		
		ТекущаяСтрока  = Новый Структура("Номенклатура, Характеристика, Склад, ЕдиницаИзмерения");
		Сумма          = 0;
		ТекущийПериод  = 0;
		НомерСтроки    = 0;
		
		// Выводим строки таблицы Товары
		
		Для Каждого ВыборкаПоТоварам ИЗ ТаблицаНоменклатуры Цикл
			
			ОдинаковыеСтроки = Истина;
			Если КроссТаблица Тогда
				Для каждого Элемент Из ТекущаяСтрока Цикл
					Если ВыборкаПоТоварам[Элемент.Ключ] <> Элемент.Значение Тогда
						ОдинаковыеСтроки = Ложь;
						Прервать;
					КонецЕсли; 
				КонецЦикла; 
			КонецЕсли;
			
			Если НЕ КроссТаблица ИЛИ КроссТаблица И НЕ ОдинаковыеСтроки Тогда
				
				ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ВыборкаПоТоварам);
				ТекущийПериод = 0;
				
				НомерСтроки = НомерСтроки + 1;
				
				ОбластьНомера.Параметры.НомерСтроки = НомерСтроки;
				ТабличныйДокумент.Вывести(ОбластьНомера);
				
				Если Не ВыводитьШапку Тогда
					
					ОбластьУИ.Параметры.УникальныйИдентификаторНоменклатура          = Строка(ВыборкаПоТоварам.Номенклатура.УникальныйИдентификатор());
					ОбластьУИ.Параметры.УникальныйИдентификаторХарактеристика        = Строка(ВыборкаПоТоварам.Характеристика.УникальныйИдентификатор());
					ОбластьУИ.Параметры.УникальныйИдентификаторУпаковка              = Строка(ВыборкаПоТоварам.Упаковка.УникальныйИдентификатор());
					
					ОбластьУИ.Параметры.УникальныйИдентификаторПартнер           = Строка(ВыборкаПоТоварам.Партнер.УникальныйИдентификатор());
					ОбластьУИ.Параметры.УникальныйИдентификаторСоглашение        = Строка(ВыборкаПоТоварам.Соглашение.УникальныйИдентификатор());
					ОбластьУИ.Параметры.УникальныйИдентификаторСклад             = Строка(ВыборкаПоТоварам.Склад.УникальныйИдентификатор());
					
					ТабличныйДокумент.Присоединить(ОбластьУИ);
					
				КонецЕсли;
				
				Если ВыводитьКоды Тогда
					
					ОбластьКодов.Параметры.Артикул = ВыборкаПоТоварам[КолонкаКодов];
					ТабличныйДокумент.Присоединить(ОбластьКодов);
					
				КонецЕсли;
				
				ОбластьТовар.Параметры.Заполнить(ВыборкаПоТоварам);
				
				ОбластьТовар.Параметры.Товар = НоменклатураКлиентСервер.ПредставлениеНоменклатурыДляПечати(
				ВыборкаПоТоварам.ТоварНаименованиеПолное,
				ВыборкаПоТоварам.ХарактеристикаНаименованиеПолное);
				
				ТабличныйДокумент.Присоединить(ОбластьТовар);
				
				Для каждого ДопПоле Из ДопПоля Цикл
					ОбластьТоварДопПоле.Параметры.Значение = ВыборкаПоТоварам[ДопПоле.КолонкаЗначения];
					ТабличныйДокумент.Присоединить(ОбластьТоварДопПоле);
				КонецЦикла;
				
				Если КроссТаблица Тогда
					
					ОбластьКроссЕдиницаИзмерения.Параметры.Заполнить(ВыборкаПоТоварам);
					ТабличныйДокумент.Присоединить(ОбластьКроссЕдиницаИзмерения);		
					
					ОбластьДанныхНАчало.Параметры.Количество = ВыборкаПоТоварам.КоличествоИтог;
					
					Если ПланироватьПоСумме Тогда
						ОбластьДанныхНачало.Параметры.Сумма = ВыборкаПоТоварам.Сумма;
						ОбластьДанныхНачало.Параметры.Цена = ВыборкаПоТоварам.Цена;
					КонецЕсли;
					
					ТабличныйДокумент.Присоединить(ОбластьДанныхНачало);   
									
				КонецЕсли;  				
				
			КонецЕсли;
			
			ТаблицаОтбора = ТаблицаНоменклатурыПолная.Скопировать(Новый Структура("Ссылка,Номенклатура,ЕдиницаИзмерения,Характеристика,Склад",ВыборкаПоТоварам.Ссылка,ВыборкаПоТоварам.Номенклатура,ВыборкаПоТоварам.ЕдиницаИзмерения,ВыборкаПоТоварам.Характеристика,ВыборкаПоТоварам.Склад));
			
			Если КроссТаблица Тогда
				
				//ТаблицаОтбора = ТаблицаНоменклатурыПолная.Скопировать(Новый Структура("Ссылка,Номенклатура,ЕдиницаИзмерения,Характеристика,Склад",ВыборкаПоТоварам.Ссылка,ВыборкаПоТоварам.Номенклатура,ВыборкаПоТоварам.ЕдиницаИзмерения,ВыборкаПоТоварам.Характеристика,ВыборкаПоТоварам.Склад));
				
				Для Каждого СтрокаПериод ИЗ ТаблицаПериодов Цикл
					
					ТаблицаСтроки = ТаблицаОтбора.Скопировать(Новый Структура("ДатаПериода",СтрокаПериод.ДатаНачала));
					
					ОбластьДанных.Параметры.Количество = ТаблицаСтроки.Итог("Количество");
					
					Если ПланироватьПоСумме Тогда
						
						ОбластьДанных.Параметры.Сумма  =  ТаблицаСтроки.Итог("Сумма");
						
					КонецЕсли; 
					
					ТабличныйДокумент.Присоединить(ОбластьДанных);
					
				КонецЦикла;
				
			Иначе
				
			//	ОбластьДатаПериод.Параметры.Заполнить(ВыборкаПоТоварам);
				ОбластьДатаПериод.Параметры.ДатаПериода = ТаблицаОтбора[0].ДатаПериода;
				ТабличныйДокумент.Присоединить(ОбластьДатаПериод);
				
				ОбластьДанных.Параметры.Заполнить(ВыборкаПоТоварам);
				ОбластьДанных.Параметры.Количество = ТаблицаОтбора.Итог("КоличествоИтог");
				
				Если ПланироватьПоСумме Тогда
					ОбластьДанных.Параметры.Сумма = ТаблицаОтбора.Итог("Сумма");
				КонецЕсли; 			
				
				//Область = ОбластьДанных.Область("R1C1:R1C1");
				//Область.Примечание.Текст = ВыборкаПоТоварам.Комментарий;
				ТабличныйДокумент.Присоединить(ОбластьДанных);
				
			КонецЕсли;
			
		КонецЦикла;
		
		// Выводим подвал, в том случае если выводили шапку
		Если ВыводитьШапку  Тогда
			
			ОбластьНомера                   = Макет.ПолучитьОбласть("ПодвалТаблицы|НомерСтроки");
			ОбластьУИ                       = Макет.ПолучитьОбласть("ПодвалТаблицы|УникальныеИдентификаторы");
			ОбластьКодов                    = Макет.ПолучитьОбласть("ПодвалТаблицы|КолонкаКодов");
			ОбластьТовар                    = Макет.ПолучитьОбласть("ПодвалТаблицы|Товар"+?(БезХарактеристик,"БезХарактеристик", ""));
			ОбластьДанных                   = Макет.ПолучитьОбласть("ПодвалТаблицы|Количество" + СуффиксОбластиКолонки + СуффиксКроссТаблицы);
			
			Если ПланироватьПоСумме И КроссТаблица Тогда
				ОбластьДанныхНачало	            =  Макет.ПолучитьОбласть("ПодвалТаблицы|Количество" + СуффиксОбластиКолонки + СуффиксКроссТаблицы+"Цена");
			Иначе
				ОбластьДанныхНачало = ОбластьДанных;
			КонецЕсли;
			
			ОбластьДанныхКроссОкончание     = Макет.ПолучитьОбласть("ПодвалТаблицы|Количество" + СуффиксОбластиКолонки + "КроссОкончание");
			ОбластьДатаПериод               = Макет.ПолучитьОбласть("ПодвалТаблицы|ДатаПериод");
			ОбластьКроссЕдиницаИзмерения    = Макет.ПолучитьОбласть("ПодвалТаблицы|КроссЕдиницаИзмерения");
			
			Если ДопПоля.Количество() > 0 Тогда
				ОбластьТоварДопПоле         = Макет.ПолучитьОбласть("ПодвалТаблицы|Товар" + СуффиксОбластиКолонки + "ДопПоле"+ Формат(ДопПоля.Количество(), "ЧДЦ=0; ЧГ=0") );
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьНомера);
			
			Если ВыводитьКоды Тогда
				ТабличныйДокумент.Присоединить(ОбластьКодов);
			КонецЕсли;
			
			ТабличныйДокумент.Присоединить(ОбластьТовар);
			Для каждого ДопПоле Из ДопПоля Цикл
				ТабличныйДокумент.Присоединить(ОбластьТоварДопПоле);
			КонецЦикла; 
			
			Если ПланироватьПоСумме И НЕ КроссТаблица Тогда
				
				ТабличныйДокумент.Присоединить(ОбластьДатаПериод);
				ОбластьДанных.Параметры.Всего = ФормированиеПечатныхФорм.ФорматСумм(Сумма);
				ОбластьДанных.Параметры.Всего = ФормированиеПечатныхФорм.ФорматСумм(ТаблицаНоменклатуры.Итог("Сумма"));
				ТабличныйДокумент.Присоединить(ОбластьДанных);
				
			ИначеЕсли КроссТаблица Тогда
				
				ТабличныйДокумент.Присоединить(ОбластьКроссЕдиницаИзмерения);
				
				Если ПланироватьПоСумме Тогда
					
					ОбластьДанныхНачало.Параметры.Всего = ТаблицаНоменклатуры.Итог("Сумма");
					
					ТабличныйДокумент.Присоединить(ОбластьДанныхНачало);
					
				КонецЕсли;
				
				
				Для каждого Период Из ТаблицаПериодов Цикл
					
					Если Период.Активная И Период.НомерКолонки <= 0 Тогда
						Продолжить;
					КонецЕсли; 
					
					Если ПланироватьПоСумме Тогда
						ОбластьДанных.Параметры.Всего = ФормированиеПечатныхФорм.ФорматСумм(СуммыПериодов["Сумма_"+Период.ИмяКолонки]);
					КонецЕсли;
					
					ТабличныйДокумент.Присоединить(ОбластьДанных);
					
				КонецЦикла;
				
			Иначе
				
				ТабличныйДокумент.Присоединить(ОбластьДатаПериод);
				ТабличныйДокумент.Присоединить(ОбластьДанных);
				
			КонецЕсли;
			
			ОкончаниеНомера = ТабличныйДокумент.ВысотаТаблицы;
			
			// Выводим Сумму прописью
			ОбластьМакета = Макет.ПолучитьОбласть("ИтоговаяСтрока");
			
			Если ПланироватьПоСумме Тогда
				
				СуммаКПрописи = Сумма;
				
				СуммаКПрописи = ТаблицаНоменклатуры.Итог("Сумма");
				Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
				
				ИтоговаяСтрока = НСтр("ru='Всего наименований %КоличествоНаименований%, на сумму %СуммаДокумента%'");
				ИтоговаяСтрока = СтрЗаменить(ИтоговаяСтрока, "%КоличествоНаименований%", НомерСтроки);
				//ИтоговаяСтрока = СтрЗаменить(ИтоговаяСтрока, "%СуммаДокумента%", ФормированиеПечатныхФорм.ФорматСумм(СуммаКПрописи, ДанныеПечати.Валюта));
				ИтоговаяСтрока = СтрЗаменить(ИтоговаяСтрока, "%СуммаДокумента%", ФормированиеПечатныхФорм.ФорматСумм(СуммаКПрописи, Валюта));
				
				ОбластьМакета.Параметры.ИтоговаяСтрока = ИтоговаяСтрока;
				
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
				ОбластьМакета = Макет.ПолучитьОбласть("СуммаПрописью");
				//ОбластьМакета.Параметры.СуммаПрописью  = РаботаСКурсамиВалют.СформироватьСуммуПрописью(СуммаКПрописи, ДанныеПечати.Валюта);
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
			Иначе
				
				ИтоговаяСтрока = НСтр("ru='Всего наименований %КоличествоНаименований%.'");
				ИтоговаяСтрока = СтрЗаменить(ИтоговаяСтрока, "%КоличествоНаименований%", НомерСтроки);
				ОбластьМакета.Параметры.ИтоговаяСтрока = ИтоговаяСтрока;
				
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
			КонецЕсли;
			
			// Выводим подписи
			ОбластьМакета = Макет.ПолучитьОбласть("Подписи");
			
			Если ЗначениеЗаполнено(ДанныеПечати.ОтветственныйФизЛицо) Тогда
				ОбластьМакета.Параметры.ПредствлениеОтветственного = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ДанныеПечати.ОтветственныйФизЛицо);
				ОбластьМакета.Параметры.Ответственный = ДанныеПечати.ОтветственныйФизЛицо;
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
		
		Если КроссТаблица Тогда
			ЕстьКроссТаблицы = Истина;
		КонецЕсли; 
		Если ПланироватьПоСумме Тогда
			ЕстьДокументыССуммами = Истина;
		КонецЕсли; 
		
	КонецЦикла;
	
	Если ДанныеПечати.Количество() = 1 И ЕстьКроссТаблицы Тогда
		
		ОбластьШапки = ТабличныйДокумент.Область(НачалоШапки, , ОкончаниеШапки, );
		ТабличныйДокумент.ПовторятьПриПечатиСтроки = ОбластьШапки;
		
		ОбластьНомера = ТабличныйДокумент.Область(, 1, , ШиринаНомера);
		ТабличныйДокумент.ПовторятьПриПечатиКолонки = ОбластьНомера;
		
	КонецЕсли; 
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция СформироватьПечатнуюФормуКомплектовочнойВедомости(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ПланПотребностейВМатериалах.ДокументУтверждения КАК ДокументУтверждения
	|ПОМЕСТИТЬ ВрТабДокУтверждения
	|ИЗ
	|	Документ.УСОERP_ПланПотребностейВМатериалах КАК УСОERP_ПланПотребностейВМатериалах
	|ГДЕ
	|	УСОERP_ПланПотребностейВМатериалах.Ссылка В(&МассивДокументов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(УСОERP_БюджетСтроительства.Дата) КАК Дата,
	|	УСОERP_БюджетСтроительства.ДокументОснование КАК ДокументУтверждения
	|ПОМЕСТИТЬ ВрТабБюджеты
	|ИЗ
	|	Документ.УСОERP_БюджетСтроительства КАК УСОERP_БюджетСтроительства
	|ГДЕ
	|	УСОERP_БюджетСтроительства.Проведен
	|	И УСОERP_БюджетСтроительства.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|	И УСОERP_БюджетСтроительства.ДокументОснование.КопияСценария <> ЗНАЧЕНИЕ(Справочник.УСОERP_СценарииПланированияПроектовСтроительства.ПустаяСсылка)
	|	И &ПоСумме
	|	И УСОERP_БюджетСтроительства.ДокументОснование В
	|			(ВЫБРАТЬ
	|				ВрТабДокУтверждения.ДокументУтверждения
	|			ИЗ
	|				ВрТабДокУтверждения)
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_БюджетСтроительства.ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТабБюджеты.ДокументУтверждения КАК ДокументУтверждения,
	|	УСОERP_БюджетСтроительства.Ссылка КАК Бюджет
	|ПОМЕСТИТЬ ВрТабДокБюджет
	|ИЗ
	|	ВрТабБюджеты КАК ВрТабБюджеты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_БюджетСтроительства КАК УСОERP_БюджетСтроительства
	|		ПО ВрТабБюджеты.Дата = УСОERP_БюджетСтроительства.Дата
	|			И ВрТабБюджеты.ДокументУтверждения = УСОERP_БюджетСтроительства.ДокументОснование
	|ГДЕ
	|	УСОERP_БюджетСтроительства.Проведен
	|	И УСОERP_БюджетСтроительства.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|	И УСОERP_БюджетСтроительства.ДокументОснование.КопияСценария <> ЗНАЧЕНИЕ(Справочник.УСОERP_СценарииПланированияПроектовСтроительства.ПустаяСсылка)
	|	И &ПоСумме
	|	И УСОERP_БюджетСтроительства.ДокументОснование В
	|			(ВЫБРАТЬ
	|				ВрТабДокУтверждения.ДокументУтверждения
	|			ИЗ
	|				ВрТабДокУтверждения)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_СтоимостьМатериаловВБюджетеСтроительства.Номенклатура КАК Номенклатура,
	|	УСОERP_СтоимостьМатериаловВБюджетеСтроительства.Характеристика КАК Характеристика,
	|	СРЕДНЕЕ(УСОERP_СтоимостьМатериаловВБюджетеСтроительства.БазоваяЦена) КАК БазоваяЦена,
	|	ВрТабДокБюджет.ДокументУтверждения КАК ДокументУтверждения
	|ПОМЕСТИТЬ ВрТабЦены
	|ИЗ
	|	РегистрСведений.УСОERP_СтоимостьМатериаловВБюджетеСтроительства КАК УСОERP_СтоимостьМатериаловВБюджетеСтроительства
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВрТабДокБюджет КАК ВрТабДокБюджет
	|		ПО УСОERP_СтоимостьМатериаловВБюджетеСтроительства.Регистратор = ВрТабДокБюджет.Бюджет
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_СтоимостьМатериаловВБюджетеСтроительства.Номенклатура,
	|	УСОERP_СтоимостьМатериаловВБюджетеСтроительства.Характеристика,
	|	ВрТабДокБюджет.ДокументУтверждения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказМатериаловВПроизводствоТовары.Ссылка.ДокументОснование КАК ДокументОснование,
	|	ЗаказМатериаловВПроизводствоТовары.Номенклатура КАК Номенклатура,
	|	ЗаказМатериаловВПроизводствоТовары.Номенклатура.ТипНоменклатуры КАК Тип,
	|	ЗаказМатериаловВПроизводствоТовары.Номенклатура.Марка КАК Марка,
	|	ЗаказМатериаловВПроизводствоТовары.Характеристика КАК Характеристика,
	|	ЗаказМатериаловВПроизводствоТовары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЗаказМатериаловВПроизводствоТовары.КоличествоУпаковок КАК Количество,
	|	ЗаказМатериаловВПроизводствоТовары.НачалоОтгрузки КАК СрокПоставки,
	|	ЗаказМатериаловВПроизводствоТовары.Ссылка.ДокументОснование.ДокументУтверждения КАК ДокументУтверждения
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	Документ.ЗаказМатериаловВПроизводство.Товары КАК ЗаказМатериаловВПроизводствоТовары
	|ГДЕ
	|	ЗаказМатериаловВПроизводствоТовары.Ссылка.ДокументОснование В(&МассивДокументов)
	|	И НЕ ЗаказМатериаловВПроизводствоТовары.Ссылка.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаказНаВнутреннееПотреблениеТовары.Ссылка.ДокументОснование,
	|	ЗаказНаВнутреннееПотреблениеТовары.Номенклатура,
	|	ЗаказНаВнутреннееПотреблениеТовары.Номенклатура.ТипНоменклатуры,
	|	ЗаказНаВнутреннееПотреблениеТовары.Номенклатура.Марка,
	|	ЗаказНаВнутреннееПотреблениеТовары.Характеристика,
	|	ЗаказНаВнутреннееПотреблениеТовары.Номенклатура.ЕдиницаИзмерения,
	|	ЗаказНаВнутреннееПотреблениеТовары.КоличествоУпаковок,
	|	ЗаказНаВнутреннееПотреблениеТовары.ДатаОтгрузки,
	|	ЗаказНаВнутреннееПотреблениеТовары.Ссылка.ДокументОснование.ДокументУтверждения
	|ИЗ
	|	Документ.ЗаказНаВнутреннееПотребление.Товары КАК ЗаказНаВнутреннееПотреблениеТовары
	|ГДЕ
	|	ЗаказНаВнутреннееПотреблениеТовары.Ссылка.ДокументОснование В(&МассивДокументов)
	|	И НЕ ЗаказНаВнутреннееПотреблениеТовары.Ссылка.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.ДокументОснование КАК ДокументОснование,
	|	ВрТаб.Номенклатура КАК Номенклатура,
	|	ВрТаб.Тип КАК Тип,
	|	ВрТаб.Марка КАК Марка,
	|	ВрТаб.Характеристика КАК Характеристика,
	|	ВрТаб.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СУММА(ВрТаб.Количество) КАК Количество,
	|	ВрТаб.СрокПоставки КАК СрокПоставки,
	|	СУММА(ВрТабЦены.БазоваяЦена) КАК Цена,
	|	СУММА(ВрТаб.Количество * ЕСТЬNULL(ВрТабЦены.БазоваяЦена, 0)) КАК Сумма
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТабЦены КАК ВрТабЦены
	|		ПО ВрТаб.ДокументУтверждения = ВрТабЦены.ДокументУтверждения
	|			И ВрТаб.Номенклатура = ВрТабЦены.Номенклатура
	|			И ВрТаб.Характеристика = ВрТабЦены.Характеристика
	|
	|СГРУППИРОВАТЬ ПО
	|	ВрТаб.Марка,
	|	ВрТаб.ЕдиницаИзмерения,
	|	ВрТаб.Номенклатура,
	|	ВрТаб.ДокументОснование,
	|	ВрТаб.СрокПоставки,
	|	ВрТаб.Тип,
	|	ВрТаб.Характеристика
	|ИТОГИ ПО
	|	ДокументОснование";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивОбъектов);
	Запрос.УстановитьПараметр("ПоСумме",ПараметрыПечати.Сумма);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Результат 			= Запрос.Выполнить();
	ВыборкаПоДокументам = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДанныеПечати 		= Результат.Выгрузить();
	
	Пока ВыборкаПоДокументам.Следующий() Цикл 		
		
		МассивСтрок = ДанныеПечати.НайтиСтроки(Новый Структура("ДокументОснование",	ВыборкаПоДокументам.ДокументОснование));
		
		ТаблицаСтрок = ДанныеПечати.Скопировать(Новый Структура("ДокументОснование",ВыборкаПоДокументам.ДокументОснование));
		
		Если НЕ ПараметрыПечати.ПоСрокам Тогда
			
			ТаблицаСтрок.Свернуть("ДокументОснование,Номенклатура,Тип,Марка,Характеристика,ЕдиницаИзмерения,Цена","Количество,Сумма");
			ТаблицаСтрок.Колонки.Добавить("СрокПоставки");
			ТаблицаСтрок.Сортировать("Номенклатура,Характеристика");
			
		КонецЕсли;
		
		// Макет необходимо получать для каждого документа, т.к. размеры колонок изменяются динамически.
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.УСОERP_ПланПотребностейВМатериалах.ПФ_КомплектовочнаяВедомость");
		
		Макет.Области.СрокПоставки.Видимость = ПараметрыПечати.ПоСрокам;
		Макет.Области.ОбластьСумма.Видимость = ПараметрыПечати.Сумма;
		
		ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		
		ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент, Макет, ОбластьЗаголовок, ВыборкаПоДокументам.ДокументОснование);
		
		ОбластьЗаголовок.Параметры.Номер 							= ВыборкаПоДокументам.ДокументОснование.Номер;
		ОбластьЗаголовок.Параметры.Дата 							= Формат(ВыборкаПоДокументам.ДокументОснование.Дата, "ДЛФ=ДД");
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		ОбластьОрганизация = Макет.ПолучитьОбласть("Организация");
		ОбластьОрганизация.Параметры.Организация 					= ВыборкаПоДокументам.ДокументОснование.Организация;
		ТабличныйДокумент.Вывести(ОбластьОрганизация);
		
		ОбластьОбъектСтроительства = Макет.ПолучитьОбласть("ОбъектСтроительства");
		ОбластьОбъектСтроительства.Параметры.ОбъектСтроительства 	= ВыборкаПоДокументам.ДокументОснование.ОбъектСтроительства;
		ТабличныйДокумент.Вывести(ОбластьОбъектСтроительства);
		
		ОбластьШапка = Макет.ПолучитьОбласть("ШапкаТаблицы");
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		Итератор = 0;
		
		Для Каждого ТекСтрока Из ТаблицаСтрок Цикл
			
			Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
				
				Итератор = Итератор + 1;
				
				ОбластьНоваяСтрока = Макет.ПолучитьОбласть("СтрокаТаблицы");
				ОбластьНоваяСтрока.Параметры.НомерСтроки 		= Итератор;
				ОбластьНоваяСтрока.Параметры.Наименование	 	= ТекСтрока.Номенклатура;
				ОбластьНоваяСтрока.Параметры.ТипМарка 			= Строка(ТекСтрока.Тип) + ", " + Строка(ТекСтрока.Марка) + ", " + Строка(ТекСтрока.Характеристика);
				ОбластьНоваяСтрока.Параметры.ЕдиницаИзмерения 	= ТекСтрока.ЕдиницаИзмерения;
				ОбластьНоваяСтрока.Параметры.Количество 		= ТекСтрока.Количество;
				ОбластьНоваяСтрока.Параметры.СрокПоставки 		= ТекСтрока.СрокПоставки;
				ОбластьНоваяСтрока.Параметры.Цена = ТекСтрока.Цена;
				ОбластьНоваяСтрока.Параметры.Сумма = ТекСтрока.Сумма;
				
				ТабличныйДокумент.Вывести(ОбластьНоваяСтрока);
				
			КонецЕсли;
			
		КонецЦикла;
		
		ОбластьПодвалТаблицы = Макет.ПолучитьОбласть("ПодвалТаблицы");
		ОбластьПодвалТаблицы.Параметры.Заполнить(ВыборкаПоДокументам);
		ТабличныйДокумент.Вывести(ОбластьПодвалТаблицы);
		
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
	КонецЦикла;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

