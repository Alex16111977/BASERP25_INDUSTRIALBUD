// Процедура заполняет таблицу периодов датами для получения порядка и формирует поля крос-таблицы
&НаСервере
Процедура ПриИзмененииПериодовНаСервере(КорректироватьНачалоОкончаниеПериода = Ложь)
	
	Если КорректироватьНачалоОкончаниеПериода Тогда
		ПланированиеКлиентСервер.УстановитьНачалоОкончаниеПериодаПлана(Объект.Периодичность, Объект.НачалоПериода,  Объект.ОкончаниеПериода);
	КонецЕсли; 
	
	ТаблицаПериоды = РеквизитФормыВЗначение("Периоды", Тип("ТаблицаЗначений"));
	
	Планирование.ЗаполнитьТаблицуПериодов(ТаблицаПериоды, Объект.Периодичность, Объект.НачалоПериода, Объект.ОкончаниеПериода, Ложь);	
	
	ОбработатьТаблицуПериодов_НовыйВариант(ТаблицаПериоды);  	
	
	ЭтоОдинПериод = ТаблицаПериоды.НайтиСтроки(Новый Структура("Активная", Истина)).Количество() = 1;		
	
	ПараметрыВывода = Новый Структура;
	ПараметрыВывода.Вставить("ИмяРеквизитаКроссТаблицы", "ДеревоМатериалы");
	ПараметрыВывода.Вставить("ЭлементФормыКроссТаблицы", "ДеревоМатериалы");
	ПараметрыВывода.Вставить("ТаблицаПериодов", ТаблицаПериоды);
	ПараметрыВывода.Вставить("Периодичность", Объект.Периодичность);
	
	ПараметрыВывода.Вставить("СоздаватьОбщуюГруппу", НЕ ЭтоОдинПериод);
	ПараметрыВывода.Вставить("ЗаголовокПоляГруппировки", НСтр("ru = 'Периоды планирования'"));
	ПараметрыВывода.Вставить("СоздаватьГруппуПериода", ЭтоОдинПериод);
		
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПриИзменении", "Подключаемый_ПриИзмененииКоличества");
	Планирование.ДобавитьПолеКроссТаблицыКоличество(
		ПараметрыВывода,
		Истина,
		Ложь, 
		ЭтоОдинПериод, 
		СтруктураДействий);
	
	Планирование.ОбновитьСтруктуруВыводаКроссТаблицы(ЭтаФорма, ПараметрыВывода);
	
	ЗначениеВРеквизитФормы(ТаблицаПериоды,"Периоды");
	
	Если ПланированиеКлиентСервер.НеобходимоОбновитьИнтерфейс(Объект, ЭтаФорма, "РеквизитыДоИзменения") Тогда
	
		УстановитьУсловноеОформление();
		УстановитьУсловноеОформлениеКроссТаблицы();
	
	КонецЕсли; 
	
	СохранитьНовыйПериодСервер();
	
КонецПроцедуры

&НаСервере
Процедура  ОбработатьТаблицуПериодов_НовыйВариант(ТаблицаПериоды)
	
	
	Строки = ТаблицаПериоды.НайтиСтроки(Новый Структура("Активная", ЛОжь));
	Для Каждого НайденнаяСтрока ИЗ Строки Цикл
		ТаблицаПериоды.Удалить(НайденнаяСтрока);
	КонецЦикла;
	
	Если Объект.Периодичность = Перечисления.Периодичность.Год Тогда
		ТаблицаПериоды.Сортировать("ДатаНачала");
		СтрокаНачало = ТаблицаПериоды.Получить(0);
		СтрокаНачало.ДатаНачала = НачалоГода(СтрокаНачало.ДатаНАчала);
		СтрокаОкончание = ТаблицаПериоды.Получить(ТаблицаПериоды.Количество()-1);
		СтрокаОкончание.ДатаОкончания = КонецГода(СтрокаОкончание.ДатаОкончания);
		Возврат;
	КонецЕсли;
	
	
	ТаблицаДобавляемыхСтрок = ТаблицаПериоды.СкопироватьКолонки();
	ТаблицаДобавляемыхСтрок.Очистить();  	
	
	КоличествоСтрок = ТаблицаПериоды.Количество();
	
	Для Каждого СтрокаПериод ИЗ ТаблицаПериоды Цикл
		
		СтрокаПериод.ДатаНачала = Макс(СтрокаПериод.ДатаНачала,Объект.НачалоПериода);
		СтрокаПериод.ДатаОкончания = Мин(СтрокаПериод.ДатаОкончания,Объект.ОкончаниеПериода);
		
		Если Месяц(СтрокаПериод.ДатаНачала) <> Месяц(СтрокаПериод.ДатаОкончания) Тогда
			
			Нстр = ТаблицаДобавляемыхСтрок.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,СтрокаПериод);
			Нстр.ИмяКолонки = СтрЗаменить(Строка(Новый УникальныйИдентификатор()),"-","_");
			Нстр.ДатаНачала = НачалоМесяца(СтрокаПериод.ДатаОкончания);
			
			СтрокаПериод.ДатаОкончания = КонецМесяца(СтрокаПериод.ДатаНачала);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаДоп ИЗ ТаблицаДобавляемыхСтрок Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаПериоды.Добавить(),СтрокаДоп);
	КонецЦикла;
	
	ТаблицаПериоды.Сортировать("ДатаНачала");
	Сч = 1;
	
	Для Каждого СтрокаПериод ИЗ ТаблицаПериоды Цикл
		
		СтрокаПериод.Заголовок = ""+Формат(СтрокаПериод.ДатаНачала,"ДФ=dd.MM")+" - "+Формат(СтрокаПериод.ДатаОкончания,"ДФ=dd.MM");
		СтрокаПериод.НомерКолонки = Сч;
		Сч = Сч+1;
		
	КонецЦикла;
	
КонецПроцедуры  

