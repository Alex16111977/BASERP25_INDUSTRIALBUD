&НаСервере
Процедура ЗаполнитьМатериалыНаСервере()
	
	ТаблицаМатериалы = УСОERP_ЗащищенныеФункцииСервер.УСОERP_ПланПотребностейВМатериалах_ЗаполнитьМатериалыНаСервере(ЭтотОбъект);
	
	Если ЗаполнениеПоРаспределению Тогда
		
		//Объект.Потребности.Загрузить(ТаблицаМатериалы);
		ДеревоМатериалы.ПолучитьЭлементы().Очистить();
		ПрочитатьТабличнуюЧастьПотребностиВДеревоМатериаловНаСервере();

		ЗаполнениеПоРаспределению = Ложь;
		Возврат;
		
	КонецЕсли;  	
	
	ПостроитьДеревоПоТаблицеМатериалов(ТаблицаМатериалы);
	
КонецПроцедуры

&НаСервере
Процедура ПостроитьДеревоПоТаблицеМатериалов(Знач ТаблицаМатериалы)
	
	Если ТаблицаМатериалы = Неопределено Тогда
		ТаблицаМатериалы = УСОERP_ЗащищенныеФункцииСервер.УСОERP_ПланПотребностейВМатериалах_ПолучитьТаблицуПоДеревуМатериалов(ЭтотОбъект);
	КонецЕсли;
	
	ИмяРеквизитаГруппировки = ?(ИтогДереваРабота, "Работа", "Номенклатура");
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТаблицаМатериалы);//передаем ТЗ
	ПостроительЗапроса.ДобавлениеПредставлений = ТипДобавленияПредставлений.НеДобавлять;
	ПостроительЗапроса.ИсточникДанных.Колонки[ИмяРеквизитаГруппировки].Измерение = Истина;//по этой колонке идет группировка
	ПостроительЗапроса.ЗаполнитьНастройки();
	ПостроительЗапроса.Выполнить();
	ДеревоРезультат = ПостроительЗапроса.Результат.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДеревоМатериалыЗначение = РеквизитФормыВЗначение("ДеревоМатериалы");
	ДеревоМатериалыЗначение.Строки.Очистить();
	
	//обход дерева с заполнением поля РаботаНоменклатура
	Для каждого СтрокаУровень1 из ДеревоРезультат.Строки Цикл
		
		СтрокаГруппировки = ДеревоМатериалыЗначение.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаГруппировки, СтрокаУровень1);
		СтрокаГруппировки.РаботаНоменклатура = ?(ИтогДереваРабота, СтрокаУровень1.Работа, СтрокаУровень1.Номенклатура);	
				
		Для каждого СтрокаУровень2 из СтрокаУровень1.Строки Цикл
			
			СтрокаДетали = СтрокаГруппировки.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДетали, СтрокаУровень2);
			СтрокаДетали.РаботаНоменклатура = ?(НЕ ЭтаФорма.ИтогДереваРабота, СтрокаУровень2.Работа, СтрокаУровень2.Номенклатура);
					
		КонецЦикла;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоМатериалыЗначение, "ДеревоМатериалы");

	ДанныеДляДерева = ПостроительЗапроса.Результат.Выгрузить(ОбходРезультатаЗапроса.Прямой);
	
	ТипыЗначений = Новый Массив; 
    ТипыЗначений.Добавить(Тип("СправочникСсылка.Номенклатура")); 
    ТипыЗначений.Добавить(Тип("СправочникСсылка.УСОERP_СтроительныеРаботы")); 
 	Если ДанныеДляДерева.Колонки.Найти("КодСДР") = Неопределено Тогда
		ДанныеДляДерева.Колонки.Добавить("КодСДР", Новый ОписаниеТипов("Строка"),"КодСДР"); 
	КонецЕсли;
	Если ДанныеДляДерева.Колонки.Найти("КодСДРЧисло") = Неопределено Тогда
		ДанныеДляДерева.Колонки.Добавить("КодСДРЧисло",Новый ОписаниеТипов("Число"),"КодСДРЧисло");	
	КонецЕсли;
	Если ДанныеДляДерева.Колонки.Найти("НомерРаботыВУровне") = Неопределено Тогда
		ДанныеДляДерева.Колонки.Добавить("НомерРаботыВУровне", Новый ОписаниеТипов("Число"),"НомерРаботыВУровне");
	КонецЕсли;
	Если ДанныеДляДерева.Колонки.Найти("ВыражениеПриемник") = Неопределено Тогда
		ДанныеДляДерева.Колонки.Добавить("ВыражениеПриемник", Новый ОписаниеТипов(ТипыЗначений),"ВыражениеПриемник");
	КонецЕсли;
	Если ДанныеДляДерева.Колонки.Найти("ВыражениеИсточник") = Неопределено Тогда
		ДанныеДляДерева.Колонки.Добавить("ВыражениеИсточник", Новый ОписаниеТипов(ТипыЗначений),"ВыражениеИсточник");
	КонецЕсли;  
	
	Если НЕ ИтогДереваРабота Тогда
		
		Для Каждого Строка Из ДанныеДляДерева Цикл
			
			Если ЗначениеЗаполнено(Строка.Работа)  Тогда
				
				Строка.КодСДР             = Строка.Работа.КодСДР;
				Строка.НомерРаботыВУровне = Строка.Работа.НомерРаботыВУровне;
				Строка.ВыражениеИсточник  = Строка.Работа; 
				Строка.ВыражениеПриемник  = Строка.Номенклатура; 
				Строка.РаботаНоменклатура = Строка.Работа; 
				Строка.КодСДР = ?(Строка.Работа.Владелец.ВидКодаСДР,Строка.Работа.Код,Строка.Работа.КодСДР);
				
			Иначе
				
				Строка.ВыражениеИсточник  = Строка.Номенклатура;
				Строка.ВыражениеПриемник  = Справочники.Номенклатура.ПустаяСсылка();
				Строка.РаботаНоменклатура = Строка.Номенклатура;
				
			КонецЕсли; 
						
		КонецЦикла;
		
	Иначе
		
		ВременнаяТаблица = Новый ТаблицаЗначений;
		
		Для каждого Колонка  Из ДанныеДляДерева.Колонки Цикл
			 ВременнаяТаблица.Колонки.Добавить(Колонка.Имя,Колонка.ТипЗначения);
		КонецЦикла;
		
		Для каждого СтрокаТЗ Из ДанныеДляДерева Цикл 
        	ЗаполнитьЗначенияСвойств(ВременнаяТаблица.Добавить(), СтрокаТЗ) 
		КонецЦикла; 

		ДанныеДляДерева.Очистить();
		
		Для Каждого Строка Из ВременнаяТаблица Цикл
			
			Если ЗначениеЗаполнено(Строка.Номенклатура) Тогда
				
				Если ДанныеДляДерева.Найти(Строка.Работа,"ВыражениеИсточник") = Неопределено Тогда
					
					НоваяСтрока = ДанныеДляДерева.Добавить();
					НоваяСтрока.ВыражениеИсточник  = Строка.Работа;
					НоваяСтрока.КодСДР             = Строка.Работа.КодСДР;
					НоваяСтрока.НомерРаботыВУровне = Строка.Работа.НомерРаботыВУровне;
					НоваяСтрока.ВыражениеПриемник  = Справочники.УСОERP_СтроительныеРаботы.ПустаяСсылка();
					НоваяСтрока.РаботаНоменклатура = Строка.Работа;
					НоваяСтрока.КодСДР = ?(Строка.Работа.Владелец.ВидКодаСДР,Строка.Работа.Код,Строка.Работа.КодСДР);
					
				КонецЕсли; 
				
				НоваяВетка =  ДанныеДляДерева.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяВетка,Строка);
				НоваяВетка.ВыражениеИсточник  = Строка.Номенклатура;
				НоваяВетка.ВыражениеПриемник  = Строка.Работа;
				НоваяВетка.РаботаНоменклатура = Строка.Номенклатура;				
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЕсли;	
	
	НачальныйУровеньДерева = ?(ИтогДереваРабота,Справочники.УСОERP_СтроительныеРаботы.ПустаяСсылка(),Справочники.Номенклатура.ПустаяСсылка());

	ДеревоМатериалыЗначение = УСОERP_ОбработкаТабличныхЧастей.УСОERP_СформироватьДеревоУниверсальная(ДанныеДляДерева,"ВыражениеИсточник","ВыражениеПриемник",НачальныйУровеньДерева);
	ВремРодноеДерево = РеквизитФормыВЗначение("ДеревоМатериалы"); // берется родная структура с родной типизацией
	ВремРодноеДерево.Строки.Очистить();
	ВремРодноеДерево.Колонки.ДОбавить("КодСДРЧисло");
	УСОERP_ОбработкаТабличныхЧастей.УСОERP_ЗаполнитьРоднуюСтруктуруДереваИзВнешнего(ВремРодноеДерево.Строки, ДеревоМатериалыЗначение.Строки); // и рекурсивно заполняется из дерева, где, возможн, типиация создаст проблемы
	ВремРодноеДерево.Строки.Сортировать("КодСДР");
	ВремРодноеДерево.Строки.Сортировать("КодСДРЧисло",Истина);
	
	Если НовыйВариант Тогда
		
		ВремРодноеДерево.Колонки.Добавить("ПорядокСортировки",Новый ОписаниеТипов("Строка"));
		
		Строки = ВремРодноеДерево.Строки.НайтиСтроки(Новый Структура("ПорядокСортировки",""),Истина);
		
		Для Каждого НайденнаяСтрока ИЗ Строки Цикл 		
		                                        			
			НайденнаяСтрока.ПорядокСортировки = ?(ЗначениеЗаполнено(НайденнаяСтрока.Работа),НайденнаяСтрока.Работа.ПорядокСортировки,?(ТипЗнч(НайденнаяСтрока.РаботаНоменклатура) = Тип("СправочникСсылка.УСОERP_СтроительныеРаботы"),НайденнаяСтрока.РаботаНоменклатура.ПорядокСортировки,""));
			
		КонецЦикла;
		
		ВремРодноеДерево.Строки.Сортировать("ПорядокСортировки,КодСДРЧисло,КодСДР",Истина);
		
	КонецЕсли;   
	
	Если НЕ ИтогДереваРабота Тогда
		
		Для Каждого СтрокаДерева ИЗ  ВремРодноеДерево.Строки Цикл
			
			СтрокаДерева.КоличествоПотребность = 0;
			СтрокаДерева.ЕдиницаИзмерения = СтрокаДерева.Номенклатура.ЕдиницаИзмерения;
			
			Для Каждого ПодСтрока ИЗ СтрокаДерева.Строки Цикл
				
				Для Каждого СтрокаТЗ ИЗ ЭтаФорма.Периоды Цикл
					
					СтрокаДерева["Количество_"+СтрокаТЗ.ИмяКолонки] =  СтрокаДерева["Количество_"+СтрокаТЗ.ИмяКолонки]+ПодСтрока["Количество_"+СтрокаТЗ.ИмяКолонки];
					
				КонецЦикла;  
				
				СтрокаДерева.КоличествоПотребность = СтрокаДерева.КоличествоПотребность+ПодСтрока.КоличествоПотребность;
				СтрокаДерева.КоличествоПоПериодам = СтрокаДерева.КоличествоПоПериодам+ПодСтрока.КоличествоПоПериодам;
				
			КонецЦикла;  		
			
		КонецЦикла;  		
		
	КонецЕсли;
	
	ВремРодноеДерево.Колонки.Удалить("КодСДРЧисло");
	
	ЗначениеВРеквизитФормы( ВремРодноеДерево, "ДеревоМатериалы");
	 	
КонецПроцедуры

&НаСервере
Процедура ДобавитьМатериалНаСервере(ВыбранноеЗначение)
	
	ТаблицаМатериалы = УСОERP_ЗащищенныеФункцииСервер.УСОERP_ПланПотребностейВМатериалах_ПолучитьТаблицуПоДеревуМатериалов(ЭтотОбъект);
	ДеревоДанных = РеквизитФормыВЗначение("ДеревоМатериалы"); 	
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ВыбранноеЗначение",ВыбранноеЗначение);
	Запрос.УстановитьПараметр("Дата",Объект.Дата);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботы.Ссылка,
	|	ВложенныйЗапрос.НачалоРаботыПлан,
	|	ВложенныйЗапрос.ОкончаниеРаботыПлан
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа КАК Работа,
	|			УСОERP_ПараметрыВыполненияРаботСрезПоследних.НачалоРаботыПлан КАК НачалоРаботыПлан,
	|			УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОкончаниеРаботыПлан КАК ОкончаниеРаботыПлан
	|		ИЗ
	|			РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(&Дата, Утверждена) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних) КАК ВложенныйЗапрос
	|		ПО УСОERP_СтроительныеРаботы.Ссылка = ВложенныйЗапрос.Работа
	|ГДЕ
	|	УСОERP_СтроительныеРаботы.Ссылка В ИЕРАРХИИ(&ВыбранноеЗначение)
	|	И НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
	|	И НЕ УСОERP_СтроительныеРаботы.СуммарнаяРабота";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ТаблицаМатериалы.Найти(Выборка.Ссылка) = Неопределено Тогда
			НоваяСтрока = ТаблицаМатериалы.Добавить();
			НоваяСтрока.РаботаНоменклатура = Выборка.Ссылка;
			НоваяСтрока.Работа = Выборка.Ссылка;
			СтрокаДерева = ДеревоДанных.Строки.Добавить();
			СтрокаДерева.РаботаНоменклатура = Выборка.Ссылка;
			СтрокаДерева.Работа = Выборка.Ссылка;
			СтрокаДерева.КодСДР = ?(Выборка.Ссылка.Владелец.ВидКодаСДР,Выборка.Ссылка.Код,Выборка.Ссылка.КодСДР);
			
			Если НЕ Объект.ДокументУтверждения.СценарийПланирования.НовыйВариант Тогда
				
				СтрокаДерева.НачалоРаботыПлан = Выборка.НачалоРаботыПлан;
				СтрокаДерева.ОкончаниеРаботыПлан = Выборка.ОкончаниеРаботыПлан;
				
			Иначе
				
				//СтрокаДат = ТаблицаПроекта.Найти(Выборка.Ссылка);
				СтрокаДерева.НачалоРаботыПлан = Выборка.Ссылка.ДатаНачала;
				СтрокаДерева.ОкончаниеРаботыПлан = Выборка.Ссылка.ДатаОкончания;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоДанных,"ДеревоМатериалы");
	
	//ПостроитьДеревоПоТаблицеМатериалов(ТаблицаМатериалы);

КонецПроцедуры

Процедура ДобавитьХарактеристикуНаСервере(ИдСтроки,ВыбранноеЗначение)
	
	СтрокаДерева = ДеревоМатериалы.НайтиПоИдентификатору(ИдСтроки);
	
	КоличествоЭлементов = СтрокаДерева.ПолучитьЭлементы().Количество();
	
	НашаСтрока = СтрокаДерева.ПолучитьЭлементы().Получить(СтрокаДерева.ПолучитьЭлементы().Количество()-1);
	
	НашаСтрока.Характеристика = ВыбранноеЗначение;		
		
	
КонецПроцедуры


#КонецОбласти

