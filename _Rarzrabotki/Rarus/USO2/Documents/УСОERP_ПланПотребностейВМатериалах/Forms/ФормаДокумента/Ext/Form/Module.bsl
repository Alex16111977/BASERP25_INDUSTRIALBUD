&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	ИтогДереваРабота = Истина;

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Объект.КроссТаблица = Истина;
		
		Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			Объект.НачалоПериода    = НачалоМесяца(Объект.ОкончаниеПериода + 1); 
			Объект.ОкончаниеПериода = КонецМесяца(Объект.НачалоПериода);
			Объект.Дата          = Объект.НачалоПериода; 
		Иначе
			Объект.НачалоПериода = НачалоМесяца(ТекущаяДата());
			Объект.ОкончаниеПериода = КонецМесяца(ТекущаяДата());
		КонецЕсли;
		
		Объект.ВидОперации = Перечисления.УСОERP_ВидыОперацийПланаПотребности.ПоПлану;
		
		Если ЗначениеЗаполнено(Объект.ДокументУтверждения) Тогда
			Если НЕ Объект.ДокументУтверждения.Проведен ИЛИ НЕ Объект.ДокументУтверждения.Статус = Перечисления.СтатусыПланов.Утвержден ИЛИ НЕ Объект.ДокументУтверждения.СценарийПланирования.НовыйВариант Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("План потребностей можно создавать только на основании проведенного документа в статусе ""Утвержден"", созданного по новому варианту сценария",,,,Отказ);
			КонецЕсли;
		КонецЕсли;
		
		
	КонецЕсли;
	
	СценарийПланирования = Объект.ДокументУтверждения.КопияСценария;
	
	ПриЧтенииСозданииНаСервере();
	
	УстановитьОтборЗаказов();

	СохранитьНовыйПериодСервер();
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов 	
		
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборот.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства 

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды   	

	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	НовыйВариант = Объект.ДокументУтверждения.СценарийПланирования.НовыйВариант = Истина;
	
	ТекущийДокументУтверждения = Объект.ДокументУтверждения;
	ТекущаяОрганизация = Объект.Организация;
	ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;
	
	УстановитьУсловноеОформление();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект) 	
	
	// Обработчик механизма "ДатыЗапретаИзменения"
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);

	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект); 
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 
	
КонецПроцедуры

