&НаСервере
Процедура ПриИзмененииВидаОперацииСервер()
	
	УстановитьВидимостьЭлементовПоВидуОперацииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииОчиститьТаблицы(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.да Тогда
		
		ТоварыПоПериодам.Очистить();
		ОбновитьДеревоМатериалы(?(ЭтаФорма.ИтогДереваРабота,"Работа","Номенклатура"));
		
		ТекущаяОрганизация = Объект.Организация;
		ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;
		ТекущийДокументУтверждения = Объект.ДокументУтверждения;
		ДокументУтвержденияПриИзмененииНаСервере();

	Иначе
		
		Объект.Организация = ТекущаяОрганизация;
		Объект.ОбъектСтроительства = ТекущийОбъектСтроительства;
		Объект.ДокументУтверждения = ТекущийДокументУтверждения;
		ДокументУтвержденияПриИзмененииНаСервере();

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТаблицыПриИзменении() 
	ТоварыПоПериодам.Очистить();
	ОбновитьДеревоМатериалы(?(ЭтаФорма.ИтогДереваРабота,"Работа","Номенклатура"));
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПериодичность(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.да Тогда
       ОчиститьТаблицыПриИзменении();
    Иначе
		Объект.Периодичность = Периодичность;
		возврат;
	КонецЕсли;
	
КонецПроцедуры
	
