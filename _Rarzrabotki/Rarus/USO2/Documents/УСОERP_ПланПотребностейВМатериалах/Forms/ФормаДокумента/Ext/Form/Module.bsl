			ДокументЗаказ.УСОERP_РаспределениеМатериаловПоРаботам.Очистить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ДокументЗаказ, РезультатЗапросаСклады);
		ДокументЗаказ.Дата 						= Объект.НачалоПериода;
		ДокументЗаказ.Статус 					= Перечисления.СтатусыВнутреннихЗаказов.КОбеспечению;
		ДокументЗаказ.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию;
		ДокументЗаказ.НаправлениеДеятельности 	= Объект.НаправлениеДеятельности;
		ДокументЗаказ.ПометкаУдаления 			= Ложь;
		ДокументЗаказ.Комментарий				= "#Документ создан автоматически при проведении документа «"+Объект.Ссылка+"»#";
		
		РезультатЗапросаПотребности = РезультатЗапросаСклады.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока РезультатЗапросаПотребности.Следующий() Цикл
			
			НоваяСтрока = ДокументЗаказ.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(ДокументЗаказ,	РезультатЗапросаПотребности);
			ЗаполнитьЗначенияСвойств(НоваяСтрока,	РезультатЗапросаПотребности);
			НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Требуется;
			
			Если Объект.ОбеспечиватьОбособленно Тогда
				НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Обособленно; 				
			КонецЕсли;
			
			Если РезультатЗапросаСклады.Склад.УСОERP_ОбъектСтроительства.УСОERP_ВестиРаспределениеМатериаловПоРаботам Тогда
								
				НоваяСтрока = ДокументЗаказ.УСОERP_РаспределениеМатериаловПоРаботам.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,РезультатЗапросаПотребности);
				НоваяСтрока.ДатаПоступления = РезультатЗапросаПотребности.ДатаОтгрузки;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ДокументЗаказ.Товары.Свернуть("Номенклатура,Характеристика,Упаковка,ДатаОтгрузки,Отменено,КодСтроки,СтатьяРасходов,АналитикаРасходов,ФизическоеЛицо,СтатусУказанияСерий,ВариантОбеспечения,Серия,КатегорияЭксплуатации,ГруппаПродукции,АналитикаАктивовПассивов","КоличествоУпаковок,Количество");
		
		ДокументЗаказ.ДокументОснование = Объект.Ссылка;
		ДокументЗаказ.Ответственный 	= Пользователи.ТекущийПользователь();
		ДокументЗаказ.Записать();
		
		Попытка
			ДокументЗаказ.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьНоменклатуру(Команда)
	
	Если НЕ ИтогДереваРабота Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ТекСтрока = Элементы.ДеревоМатериалы.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено ИЛИ ТипЗнч(ТекСтрока.РаботаНоменклатура) <> Тип("СправочникСсылка.УСОERP_СтроительныеРаботы") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьМатериал_НовыйВариантОкончание",ЭтотОбъект);
	
	ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаВыбора",,ЭтотОбъект,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьМатериал_НовыйВариантОкончание(ВыбранноеЗначение,ДопПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдСтроки = Элементы.ДеревоМатериалы.ТекущиеДанные.ПолучитьИдентификатор();
	
	ДобавитьМатериал_НовыйВариантОкончаниеНаСервере(ВыбранноеЗначение,ИдСтроки);
	
	Если НужноВыбратьХарактеристики(ВыбранноеЗначение) Тогда
		
		ОткрытьФорму("Справочник.ХарактеристикиНоменклатуры.Форма.ФормаВыбора",Новый Структура("Номенклатура",ВыбранноеЗначение),ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НужноВыбратьХарактеристики(Номенклатура) 	
	
	Возврат Номенклатура.ИспользованиеХарактеристик <> Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;  	
	
КонецФункции 

&НаСервере
Процедура ДобавитьМатериал_НовыйВариантОкончаниеНаСервере(ВыбранноеЗначение,ИдСтроки)
	
	СтрокаДерева = ДеревоМатериалы.НайтиПоИдентификатору(ИдСТроки);
	
	ТекСтрока = СтрокаДерева.ПолучитьЭлементы().Добавить();
	ТекСтрока.РаботаНоменклатура = ВыбранноеЗначение;
	ТекСтрока.Номенклатура = ВыбранноеЗначение;
	ТекСтрока.ЕдиницаИзмерения = ВыбранноеЗначение.ЕдиницаИзмерения;
	ТекСтрока.Склад = Объект.Склад;
	ТекСтрока.Работа = СтрокаДерева.РаботаНоменклатура;
	ТекСтрока.НачалоРаботыПлан = СтрокаДерева.НачалоРаботыПлан;
	ТекСтрока.ОкончаниеРаботыПлан = СтрокаДерева.ОкончаниеРаботыПлан;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументУтвержденияПриИзменении(Элемент)
	
	ДокументУтвержденияПриИзмененииНаСервере();
	
	Если НовыйВариант Тогда
		
		Если Объект.ДокументУтверждения <> ТекущийДокументУтверждения И ДеревоМатериалы.ПолучитьЭлементы().Количество() Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ДокументУтвержденияПродолжение",ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещения,"Табличные части будут очищены, продолжить?",РежимДиалогаВопрос.ДаНет);
			
		Иначе
			
			ТекущийДокументУтверждения = Объект.ДокументУтверждения;
			ДокументУтвержденияПродолжение(КодВозвратаДиалога.Да,Новый Структура);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументУтвержденияПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Объект.ДокументУтверждения = ТекущийДокументУтверждения;
		ДокументУтвержденияПриИзмененииНаСервере();
		Возврат;
	КонецЕсли;
	
	Объект.Потребности.Очистить();
	ТоварыПоПериодам.Очистить();
	ДеревоМатериалы.ПолучитьЭлементы().Очистить();
	
	ДокументУтвержденияПриИзмененииНаСервере();
	ТекущийДокументУтверждения = Объект.ДокументУтверждения;
	
КонецПроцедуры 

&НаСервере
Процедура  ДокументУтвержденияПриИзмененииНаСервере()
	
	НовыйВариант  = Объект.ДокументУтверждения.СценарийПланирования.НовыйВариант = Истина;
	
	СценарийПланирования = Объект.ДокументУтверждения.КопияСценария;
	
	Объект.НаправлениеДеятельности = Объект.ДокументУтверждения.НаправлениеДеятельности;
	
КонецПроцедуры  

&НаКлиенте
Процедура ДокументУтвержденияОчистка(Элемент, СтандартнаяОбработка)
	
	ДокументУтвержденияПриИзменении(Элемент);
	
КонецПроцедуры

&НаСервере
Процедура СтатьяРасходовПриИзмененииНаСервере()
	
	Если ТипЗнч(Объект.СтатьяРасходов) <> Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов") Тогда
		Объект.АналитикаРасходов = "";
		Возврат;
	КонецЕсли;
	
	ДоходыИРасходыСервер.СтатьяРасходовПриИзменении(Объект, Объект.СтатьяРасходов,Объект.АналитикаРасходов);
	
КонецПроцедуры

&НаКлиенте
Процедура СтатьяРасходовПриИзменении(Элемент)
	СтатьяРасходовПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура АналитикаРасходовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если ТипЗнч(Объект.СтатьяРасходов) <> Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов") ИЛИ НЕ ЗначениеЗаполнено(Объект.СтатьяРасходов) Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаказМатериаловВПроизводствоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ПоказатьЗначение(,Элементы.ЗаказМатериаловВПроизводство.ТекущиеДанные.Ссылка);
