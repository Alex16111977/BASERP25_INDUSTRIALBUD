	|	Документ.УСОERP_ПланПотребностейВМатериалах.Потребности КАК УСОERP_ПланПотребностейВМатериалахПотребности
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТаб КАК ВрТаб
	|		ПО УСОERP_ПланПотребностейВМатериалахПотребности.Работа = ВрТаб.Работа
	|ГДЕ
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Ссылка = &Ссылка
	|	И УСОERP_ПланПотребностейВМатериалахПотребности.Количество > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Номенклатура,
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Характеристика,
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Ссылка,
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Количество,
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Склад,
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Период,
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Упаковка,
	|	УСОERP_ПланПотребностейВМатериалахПотребности.КоличествоУпаковок,
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Ссылка.Организация,
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Работа,
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Ссылка.Подразделение,
	|	ВрТаб.Контрагент
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_ПланПотребностейВМатериалахПотребности.Период
	|ИТОГИ ПО
	|	Контрагент,
	|	Склад
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	ЗапросДанныхДляПередачи.УстановитьПараметр("Дата",Объект.Дата);
	ЗапросДанныхДляПередачи.УстановитьПараметр("ОбъектСтроительства",Объект.ОбъектСтроительства);
	
	ЗапросДанныхДляПередачи.УстановитьПараметр("Ссылка",Объект.Ссылка);
	ПакетЗапросов = ЗапросДанныхДляПередачи.ВыполнитьПакет();
	ТаблицаРазделительнойВедомости = ПакетЗапросов[0].Выгрузить();
	
	РезультатЗапросаКонтрагенты = ПакетЗапросов[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока  РезультатЗапросаКонтрагенты.Следующий() Цикл
		
		РезультатЗапросаСклады = РезультатЗапросаКонтрагенты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока РезультатЗапросаСклады.Следующий() Цикл
			// поиск заказа по организации, складу 
			ПараметрыОтбора = Новый Структура("Организация,Склад,Контрагент",Объект.Организация,РезультатЗапросаСклады.Склад,РезультатЗапросаКонтрагенты.Контрагент);
			
			НайденныйЗаказ = ТаблицаЗаказов.НайтиСтроки(ПараметрыОтбора);
			
			Если НЕ ЗначениеЗаполнено(РезультатЗапросаСклады.Контрагент) Тогда
				
				Если НайденныйЗаказ.Количество() = 0 тогда
					//Создание документа Заказ на каждый склад отдельно
					ДокументЗаказ = Документы.ЗаказМатериаловВПроизводство.СоздатьДокумент();
				Иначе
					ДокументЗаказ = НайденныйЗаказ[0].Ссылка.ПолучитьОбъект();
					ДокументЗаказ.Товары.Очистить();
					ДокументЗаказ.УСОERP_РаспределениеМатериаловПоРаботам.Очистить();
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(ДокументЗаказ, РезультатЗапросаСклады);
				ДокументЗаказ.НеОтгружатьЧастями    = Ложь;
				ДокументЗаказ.Дата 					= МИН(ТекущаяДата(),Объект.НачалоПериода);
				ДокументЗаказ.Статус 				= Перечисления.СтатусыЗаказовМатериаловВПроизводство.КОбеспечению;
				ДокументЗаказ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаВПроизводство;
				ДокументЗаказ.ПометкаУдаления 		= Ложь;
				ДокументЗаказ.УправлениеПроизводством2_2 	= ПолучитьФункциональнуюОпцию("ИспользоватьУправлениеПроизводством2_2");
				
				Если ДокументЗаказ.УправлениеПроизводством2_2 Тогда
					ДокументЗаказ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаМатериаловВКладовую;
				КонецЕсли; 		
				
				ДокументЗаказ.НаправлениеДеятельности		= Объект.НаправлениеДеятельности;
				ДокументЗаказ.ЦеховаяКладовая		= Объект.ЦеховаяКладовая;
				ДокументЗаказ.Комментарий			= "#Документ создан автоматически при проведении документа «"+Объект.Ссылка+"»#";
				
				РезультатЗапросаПотребности = РезультатЗапросаСклады.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока РезультатЗапросаПотребности.Следующий() Цикл  						
					
					НоваяСтрока = ДокументЗаказ.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(ДокументЗаказ,РезультатЗапросаПотребности);
					ЗаполнитьЗначенияСвойств(НоваяСтрока,РезультатЗапросаПотребности);
					НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Требуется;
					
					Если Объект.ОбеспечиватьОбособленно Тогда
						НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Обособленно; 				
					КонецЕсли;
					
					Если  Объект.ОбъектСтроительства.УСОERP_ВестиРаспределениеМатериаловПоРаботам Тогда
						
						НоваяСтрока = ДокументЗаказ.УСОERP_РаспределениеМатериаловПоРаботам.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока,РезультатЗапросаПотребности);
						НоваяСтрока.ОбъектСтроительства = РезультатЗапросаСклады.Склад.УСОERP_ОбъектСтроительства;
						НоваяСтрока.ДатаПоступления = РезультатЗапросаПотребности.НачалоОтгрузки;	
						
					КонецЕсли;
					
				КонецЦикла;
				
				ДокументЗаказ.Товары.Свернуть("Номенклатура,Характеристика,Назначение,Упаковка,НачалоОтгрузки,Отменено,КодСтроки,СтатусУказанияСерий,ВариантОбеспечения,Серия,ГруппаПродукции,ОкончаниеПоступления","Количество,КоличествоУпаковок");
				ДокументЗаказ.Ответственный 	= Пользователи.ТекущийПользователь();
				
			Иначе
				
				Если НайденныйЗаказ.Количество() = 0 тогда
					//Создание документа Заказ на каждый склад отдельно
					ДокументЗаказ = Документы.ЗаказПереработчику.СоздатьДокумент();
				Иначе
					ДокументЗаказ = НайденныйЗаказ[0].Ссылка.ПолучитьОбъект();
					ДокументЗаказ.Продукция.Очистить();
					ДокументЗаказ.Материалы.Очистить();
					ДокументЗаказ.Услуги.Очистить();
				КонецЕсли;  			
				
				ДокументЗаказ.НеОтгружатьЧастями    = Ложь;
				ДокументЗаказ.Дата 					= МИН(ТекущаяДата(),Объект.НачалоПериода);
				ДокументЗаказ.Статус 				= Перечисления.СтатусыЗаказовПереработчикам.КОбеспечению;
				ДокументЗаказ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПроизводствоУПереработчика;
				ДокументЗаказ.ПометкаУдаления 		= Ложь;
				ДокументЗаказ.НаправлениеДеятельности		= Объект.НаправлениеДеятельности;
				ДокументЗаказ.Организация = Объект.Организация;
				ДокументЗаказ.Автор = Пользователи.ТекущийПользователь();
				ДокументЗаказ.Менеджер 	= Пользователи.ТекущийПользователь();
				ДокументЗаказ.Контрагент = РезультатЗапросаСклады.Контрагент;
				ДокументЗаказ.ГруппировкаЗатрат = Перечисления.ГруппировкиЗатратВЗаказеПереработчику.ПоПродукции;
				ДокументЗаказ.Партнер = ДокументЗаказ.Контрагент.Партнер;
				ДокументЗаказ.Приоритет = Справочники.Приоритеты.ПолучитьНизшийПриоритет();
				ДокументЗаказ.УслугиПоПереработке = Перечисления.ВариантыОформленияУслугДокументовПереработки.ОформляютсяОтдельно;
				ДокументЗаказ.Подразделение = Объект.Подразделение;
				ДокументЗаказ.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
				ДокументЗаказ.ЗакупкаПодДеятельность =  Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
				ДокументЗаказ.Комментарий = "#Документ создан автоматически при проведении документа «"+Объект.Ссылка+"»#";
				ДокументЗаказ.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
				ДокументЗаказ.НаправлениеДеятельности = ?(ЗначениеЗаполнено(Объект.НаправлениеДеятельности),Объект.НаправлениеДеятельности,Объект.ДокументУтверждения.НаправлениеДеятельности);
				
				ДокументЗаказ.ВариантПриемкиТоваров = ЗакупкиСервер.ПолучитьВариантПриемкиТоваров(ДокументЗаказ.Распоряжение,ДокументЗаказ.Договор);
				
				РезультатЗапросаПотребности = РезультатЗапросаСклады.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				СтатьяКалькуляции = ПолучитьСтатьюКалькуляции();
				
				Нстр = ДокументЗаказ.Продукция.Добавить();
				Нстр.Номенклатура = Объект.ОбъектСтроительства.УСОERP_НоменклатураДляЗаказаПереработчика;
				Нстр.Количество = 1;
				Нстр.КоличествоУпаковок = 1;
				Нстр.ДатаПоступления = ТекущаяДата();
				Нстр.Получатель = ?(Нстр.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар,Объект.Склад,Объект.Подразделение);
				Нстр.КодСтроки = 1;
				Нстр.НомерГруппыЗатрат = 1;
				
				Нстр = ДокументЗаказ.Услуги.Добавить();
				Нстр.КодСтрокиПродукция = 1;
				Нстр.НомерГруппыЗатрат = 1;   
				
				Пока РезультатЗапросаПотребности.Следующий() Цикл  						
					
					НоваяСтрока = ДокументЗаказ.Материалы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока,РезультатЗапросаПотребности);
					НоваяСтрока.ДатаОтгрузки =  РезультатЗапросаПотребности.НачалоОтгрузки;
					НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Требуется;
					НоваяСтрока.СтатьяКалькуляции = СтатьяКалькуляции;
					НоваяСтрока.КодСтроки = НоваяСтрока.НомерСТроки;
					НоваяСтрока.НомерГруппыЗатрат = 1;  					
										
					Если Объект.ОбеспечиватьОбособленно Тогда
						НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Обособленно; 				
					КонецЕсли; 			
					
				КонецЦикла;  				
								
			КонецЕсли;
			
			ДокументЗаказ.ДокументОснование = Объект.Ссылка;
			
			ДокументЗаказ.Записать();
			Попытка
				ДокументЗаказ.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСтатьюКалькуляции()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СтатьиКалькуляции.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтатьиКалькуляции КАК СтатьиКалькуляции
	|ГДЕ
	|	НЕ СтатьиКалькуляции.ПометкаУдаления
	|	И НЕ СтатьиКалькуляции.ЭтоГруппа
	|	И СтатьиКалькуляции.ТипЗатрат = ЗНАЧЕНИЕ(Перечисление.ТипыЗатрат.Материальные)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.СтатьиКалькуляции.ПустаяСсылка();
	
КонецФункции


