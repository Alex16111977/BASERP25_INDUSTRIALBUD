&НаСервере
Процедура СкопироватьЭлементУправления(ЭлементыИсточник,ЭлементыПриемник,СтрокаИсточник,СтрокаПриемник)
	Для каждого ЭлементИсточник из ЭлементыИсточник.ПодчиненныеЭлементы Цикл
		НовыйЭлемент = Элементы.Добавить(СтрЗаменить(ЭлементИсточник.Имя,СтрокаИсточник,СтрокаПриемник), ТипЗнч(ЭлементИсточник), ЭлементыПриемник);
		НовыйЭлемент.Заголовок = ЭлементИсточник.Заголовок;
		Если ТипЗнч(ЭлементИсточник) = тип("ПолеФормы") Тогда
			ЗаполнитьЗначенияСвойств(НовыйЭлемент,ЭлементИсточник,"Вид,Ширина,ОтображатьВШапке,ОтображатьВПодвале,ПропускатьПриВводе,ТолькоПросмотр,РастягиватьПоГоризонтали,РастягиватьПоВертикали");
			//НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
			//НовыйЭлемент.Ширина = ЭлементИсточник.Ширина;
			НовыйЭлемент.ПутьКДанным = СтрЗаменить(ЭлементИсточник.ПутьКДанным,СтрокаИсточник,СтрокаПриемник);
		ИначеЕсли ТипЗнч(ЭлементИсточник) = тип("ГруппаФормы") Тогда
			//СкопироватьЭлементУправления(ЭлементИсточник,ЭлементыПриемник,СтрокаИсточник,СтрокаПриемник);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаПодбора" Тогда
		Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда	
			ДобавитьМатериалНаСервере(ВыбранноеЗначение);  	
			РазвернутьДеревоМатериалы();
		КонецЕсли;	
	КонецЕсли;
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.ХарактеристикиНоменклатуры.Форма.ФормаВыбора" Тогда
		
		Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
			
			ДобавитьХарактеристикуНаСервере(Элементы.ДеревоМатериалы.ТекущиеДанные.ПолучитьИдентификатор(),ВыбранноеЗначение);
						
		КонецЕсли;
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		ТаблицаМатериалы = УСОERP_ЗащищенныеФункцииСервер.УСОERP_ПланПотребностейВМатериалах_ПолучитьТаблицуПоДеревуМатериалов(ЭтотОбъект);
	
		Для ТекИндекс = 0 По ТаблицаМатериалы.Количество()-1 Цикл
			
			АдресОшибки = НСтр("ru=' в строке работы %Работа% у номенклатуры %Номенклатура% списка ""Потребности""'");
			АдресОшибки = СтрЗаменить(АдресОшибки, "%Работа%", ТаблицаМатериалы[ТекИндекс].Работа);
			АдресОшибки = СтрЗаменить(АдресОшибки, "%Номенклатура%", ТаблицаМатериалы[ТекИндекс].Номенклатура);
			
			Если (ТаблицаМатериалы[ТекИндекс].КоличествоПотребность <> ТаблицаМатериалы[ТекИндекс].КоличествоПоПериодам) Тогда			
				ТекстОшибки = НСтр("ru='Итоговое количество по периодам %Колво% не совпадает с плановым количеством %ВесРаботы%'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Колво%", ТаблицаМатериалы[ТекИндекс].КоличествоПоПериодам);
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ВесРаботы%", ТаблицаМатериалы[ТекИндекс].КоличествоПотребность);
				
				Сообщить(ТекстОшибки + АдресОшибки);
				Отказ = истина;
			КонецЕсли;
			
		КонецЦикла;
				
	КонецЕсли;	
	
	Если Не Отказ Тогда
		ЗаполнитьТабличнуюЧастьПотребностиПоДеревуМатериаловНаСервере(ТекущийОбъект);
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства 	
	
	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);	
	
КонецПроцедуры

