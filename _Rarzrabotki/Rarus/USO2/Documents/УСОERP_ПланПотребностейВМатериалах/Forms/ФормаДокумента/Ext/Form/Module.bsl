&НаКлиенте
Процедура ПродолжитьРедактирование(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ТоварыПоПериодам.Очистить();
		ОбновитьДеревоМатериалы(?(ЭтаФорма.ИтогДереваРабота,"Работа","Номенклатура"));
		Оповещение = Новый ОписаниеОповещения(
			"РезультатВыбораПериода",
			ЭтотОбъект);
			
		ОбщегоНазначенияУТКлиент.РедактироватьПериод(
			Объект, 
			Новый Структура("НачалоПериода, ОкончаниеПериода", "ДатаНачала", "ДатаОкончания"),
			Оповещение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РезультатВыбораПериода(Результат, ДополнительныеПараметры) Экспорт

	Объект.НачалоПериода = Результат.ДатаНачала;
	Объект.ОкончаниеПериода = Результат.ДатаОкончания; 

КонецПроцедуры

&НаКлиенте
Процедура ДеревоМатериалыПриАктивизацииЯчейки(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ТекущееПоле = Элемент.ТекущийЭлемент;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураТолькоЧтениеДляПолейГруппировки = Новый Структура;
	СтруктураТолькоЧтениеДляПолейГруппировки.Вставить(Элемент.Имя + "Склад", Ложь);
	
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда;
		
		ТекущееПоле.ТолькоПросмотр = Истина; // группировочные строки не редактируются
		
	Иначе
		
		ТолькоЧтение = Истина;
		Если СтруктураТолькоЧтениеДляПолейГруппировки.Свойство(ТекущееПоле.Имя, ТолькоЧтение) Тогда
			ТекущееПоле.ТолькоПросмотр = ТолькоЧтение;
		Иначе
			ТекущееПоле.ТолькоПросмотр = НЕ Найти(ТекущееПоле.Имя, "Количество_");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииКоличества(Элемент)
	
	СтрокаМатериалов = Элементы.ДеревоМатериалы.ТекущиеДанные;
	
	СтрокаМатериалов.КоличествоПоПериодам = 0;
	
	Для каждого СтрокаПериода Из ЭтаФорма.Периоды Цикл
		
		Если НЕ СтрокаПериода.Активная Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаМатериалов.КоличествоПоПериодам = СтрокаМатериалов.КоличествоПоПериодам + СтрокаМатериалов["Количество_" + СтрокаПериода.ИмяКолонки];
		
	КонецЦикла;
	
	Если  Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.УСОERP_ВидыОперацийПланаПотребности.СверхПлана") Тогда
		
		СтрокаМатериалов.КоличествоПотребность = СтрокаМатериалов.КоличествоПоПериодам;
		
	КонецЕсли;
	
	Если НЕ ИтогДереваРабота Тогда
		
		СтрокаРодитель = СтрокаМатериалов.ПолучитьРодителя();
		
		Для каждого СтрокаПериода Из ЭтаФорма.Периоды Цикл
			
			Если НЕ СтрокаПериода.Активная Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаРОдитель["Количество_"+СтрокаПериода.ИмяКолонки] = 0;			
			
			Для Каждого ПодСтрока ИЗ СтрокаРодитель.ПолучитьЭлементы() Цикл
				
				СтрокаРОдитель["Количество_"+СтрокаПериода.ИмяКолонки] = СтрокаРОдитель["Количество_"+СтрокаПериода.ИмяКолонки]+ПодСтрока["Количество_"+СтрокаПериода.ИмяКолонки];		
				
			КонецЦикла;  		
			
		КонецЦикла;   		
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьТабличнуюЧастьПотребностиВДеревоМатериаловНаСервере()
	
	ТаблицаМатериалы = УСОERP_ЗащищенныеФункцииСервер.УСОERP_ПланПотребностейВМатериалах_ПолучитьТаблицуПоДеревуМатериалов(ЭтотОбъект, Ложь);
	
	ТаблицаПериоды = РеквизитФормыВЗначение("Периоды", Тип("ТаблицаЗначений"));
	
	СтруктураПоискаМатериала = Новый Структура("Работа, Номенклатура, Характеристика, Склад, ЕдиницаИзмерения");
	Для Каждого СтрокаТЧ Из Объект.Потребности Цикл
		
		СтрокиПериода = ТаблицаПериоды.НайтиСтроки(Новый Структура("ДатаНачала, Активная", СтрокаТЧ.Период, Истина));
		Если СтрокиПериода.Количество() Тогда
			
			СтрокаПериода = СтрокиПериода[0];
			
			ЗаполнитьЗначенияСвойств(СтруктураПоискаМатериала, СтрокаТЧ);
			СтрокиМатериалов = ТаблицаМатериалы.НайтиСтроки(СтруктураПоискаМатериала);
			Если СтрокиМатериалов.Количество() Тогда
				НоваяСтрока = СтрокиМатериалов[0];
			Иначе
				НоваяСтрока = ТаблицаМатериалы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			КонецЕсли;
			
			НоваяСтрока["Количество_"+СтрокаПериода.ИмяКолонки] = СтрокаТЧ.Количество;
			
			// Расчет итоговых количеств по периодам.
			НоваяСтрока.КоличествоПотребность = НоваяСтрока.КоличествоПотребность + СтрокаТЧ.Количество;
			НоваяСтрока.КоличествоПоПериодам  = НоваяСтрока.КоличествоПоПериодам  + СтрокаТЧ.Количество;
			
		КонецЕсли;;
		
	КонецЦикла;
	
	ПостроитьДеревоПоТаблицеМатериалов(ТаблицаМатериалы);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличнуюЧастьПотребностиПоДеревуМатериаловНаСервере(ТекущийОбъект, КэшированныеЗначения = Неопределено)
	
	Если КэшированныеЗначения = Неопределено Тогда
		КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	КонецЕсли;
	
	ТаблицаМатериалы = УСОERP_ЗащищенныеФункцииСервер.УСОERP_ПланПотребностейВМатериалах_ПолучитьТаблицуПоДеревуМатериалов(ЭтотОбъект);
	
	ТаблицаПериоды = РеквизитФормыВЗначение("Периоды", Тип("ТаблицаЗначений"));
	
	Потребности = ТекущийОбъект.Потребности;
	Потребности.Очистить();
	
	Для Каждого СтрокаМатериалы Из ТаблицаМатериалы Цикл
		
		Для Каждого СтрокаПериода из ТаблицаПериоды Цикл
			
			Если Не СтрокаПериода.Активная Тогда
				Продолжить;
			КонецЕсли;
			
			Количество = СтрокаМатериалы["Количество_"+СтрокаПериода.ИмяКолонки];
			Если Количество Тогда
				
				НоваяСтрока = Потребности.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМатериалы);
				
				НоваяСтрока.Период = СтрокаПериода.ДатаНачала;
				НоваяСтрока.КоличествоУпаковок = Количество;
				
				СтруктураДействий = Новый Структура;
				ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий);
				//СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
				//СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу",         НоваяСтрока.Характеристика);
				СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу",      НоваяСтрока.Упаковка);
				
				СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
				ЭтаФорма.ИмяФормы, "Потребности"));
				
				ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
			
КонецПроцедуры

&НаСервере
Функция СуществуетЗаказНаВнутреннееПотребление()
	
	ЗапросВнутреннееПотребление = Новый Запрос("ВЫБРАТЬ
				|	ЗаказНаВнутреннееПотребление.Ссылка,
				|	ЗаказНаВнутреннееПотребление.Организация,
				|	ЗаказНаВнутреннееПотребление.Склад,
				|	ЗаказНаВнутреннееПотребление.Подразделение
				|ИЗ
				|	Документ.ЗаказНаВнутреннееПотребление КАК ЗаказНаВнутреннееПотребление
				|ГДЕ
				|	НЕ ЗаказНаВнутреннееПотребление.ПометкаУдаления
				|	И ЗаказНаВнутреннееПотребление.ДокументОснование = &ДокументОснование");
	ЗапросВнутреннееПотребление.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	РезультатЗапроса = ЗапросВнутреннееПотребление.Выполнить().Выгрузить();
	// пометка на удаление всех существующих
	ВыборкаЗапроса = ЗапросВнутреннееПотребление.Выполнить().Выбрать();
	Пока ВыборкаЗапроса.Следующий() Цикл
		
		ЗаказОбъект = ВыборкаЗапроса.Ссылка.ПолучитьОбъект();
		ЗаказОбъект.ПометкаУдаления = истина;
		ЗаказОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);
		
	КонецЦикла;
	
	Возврат РезультатЗапроса;
	
КонецФункции

