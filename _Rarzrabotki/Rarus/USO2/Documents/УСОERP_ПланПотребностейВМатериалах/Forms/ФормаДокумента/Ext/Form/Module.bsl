&НаСервере
Процедура ОчиститьПериоды()
	МассивУдаляемыхРеквизитов = Новый массив;
	
	Для каждого КолонкаДереваМатериалов из ЭтаФорма.ПолучитьРеквизиты("ДеревоМатериалы") Цикл
		
		Если Лев(КолонкаДереваМатериалов.Имя,6) = "Период" Тогда
			МассивУдаляемыхРеквизитов.Добавить("ДеревоМатериалы."+КолонкаДереваМатериалов.Имя);		
		КонецЕсли;  
	КонецЦикла;
	ЭтаФорма.ИзменитьРеквизиты(,МассивУдаляемыхРеквизитов);
	
	ИндЭлемент = 0;
	Пока ИндЭлемент < ЭтаФорма.Элементы.ДеревоМатериалы.ПодчиненныеЭлементы.Количество() цикл
		ЭлементДеревоМатериалы = ЭтаФорма.Элементы.ДеревоМатериалы.ПодчиненныеЭлементы[ИндЭлемент];		
		Если Лев(ЭлементДеревоМатериалы.Имя,6) = "Период" Тогда
			ЭтаФорма.Элементы.Удалить(ЭлементДеревоМатериалы);		
		Иначе
			ИндЭлемент = ИндЭлемент+1;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

