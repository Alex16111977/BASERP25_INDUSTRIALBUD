&НаКлиенте
Процедура ПриИзмененииПериода(ДатаПериод)
	
	Если ДатаПериод = Объект.НачалоПериода Тогда 
		Объект.НачалоПериода    = НачалоДня(ДатаПериод); 
		Объект.ОкончаниеПериода = ?(Объект.НачалоПериода > Объект.ОкончаниеПериода, КонецДня(Объект.НачалоПериода), КонецДня(Объект.ОкончаниеПериода));
	Иначе 
		Объект.ОкончаниеПериода = КонецДня(ДатаПериод);
		Объект.НачалоПериода = ?(Объект.НачалоПериода > Объект.ОкончаниеПериода, НачалоДня(Объект.ОкончаниеПериода), НачалоДня(Объект.НачалоПериода));
	КонецЕсли;

КонецПроцедуры

