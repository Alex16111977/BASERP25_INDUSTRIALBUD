&НаСервере
Процедура ЗаписатьДокумент() 
	Записать();
	ОбъектДокумент = РеквизитФормыВЗначение("Объект");
	ОбъектДокумент.Записать();
	ЗначениеВРеквизитФормы(ОбъектДокумент, "Объект");
	Модифицированность = Ложь;
КонецПроцедуры

&НаСервере
Процедура СозданиеЗаказМатериаловВПроизводство() 
	
	Если НЕ ПолучитьФункциональнуюОпцию("УСОERP_ИспользоватьМатериальноТехническоеОбеспечение")Тогда
		Возврат;
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("УСОERP_ПередачаМатериаловВПроизводствоПоРасходуВСтроительстве") = 0 Тогда
		ПолучитьДанныеДляЗаказаНаВнутреннееПотребление(СуществуетЗаказНаВнутреннееПотребление());
	Иначе
		ПолучитьДанныеДляЗаказаМатериаловВПроизводство(СуществуетЗаказМатериаловВПроизводство());
	КонецЕсли;
	
	УстановитьОтборЗаказов();

КонецПроцедуры

&НаСервере
Функция СуществуетЗаказМатериаловВПроизводство()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказМатериаловВПроизводство.Ссылка КАК Ссылка,
	|	ЗаказМатериаловВПроизводство.Организация КАК Организация,
	|	ЗаказМатериаловВПроизводство.Склад КАК Склад,
	|	ЗаказМатериаловВПроизводство.Подразделение КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент
	|ИЗ
	|	Документ.ЗаказМатериаловВПроизводство КАК ЗаказМатериаловВПроизводство
	|ГДЕ
	|	НЕ ЗаказМатериаловВПроизводство.ПометкаУдаления
	|	И ЗаказМатериаловВПроизводство.ДокументОснование = &ДокументОснование
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаказПереработчику.Ссылка,
	|	ЗаказПереработчику.Организация,
	//|	ЗаказПереработчику.Склад,
	| ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка),
	|	ЗаказПереработчику.Подразделение,
	|	ЗаказПереработчику.Контрагент
	|ИЗ
	|	Документ.ЗаказПереработчику КАК ЗаказПереработчику
	|ГДЕ
	|	НЕ ЗаказПереработчику.ПометкаУдаления
	|	И ЗаказПереработчику.ДокументОснование = &ДокументОснование";
	
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	// пометка на удаление всех существующих
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаЗапроса.Следующий() Цикл
		
		ЗаказОбъект = ВыборкаЗапроса.Ссылка.ПолучитьОбъект();
		ЗаказОбъект.ПометкаУдаления = истина;
		ЗаказОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);
		
	КонецЦикла;
	
	Возврат РезультатЗапроса;
	
КонецФункции

