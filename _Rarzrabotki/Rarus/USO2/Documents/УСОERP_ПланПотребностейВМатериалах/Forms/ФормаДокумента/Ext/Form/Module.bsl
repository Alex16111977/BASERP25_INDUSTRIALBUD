&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();
	
	Если Объект.ВыделятьЦветомРабочиеДни и объект.Периодичность = Перечисления.Периодичность.День Тогда
		ДанныеГрафика = ПолучитьДанныеГрафика();
		ТаблицаПериоды = РеквизитФормыВЗначение("Периоды", Тип("ТаблицаЗначений"));
		
		Элемент = УсловноеОформление.Элементы.Добавить();
		
		Для каждого СтрокаПериода из ТаблицаПериоды ЦИкл
			Если не СтрокаПериода.Активная Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыОтбора = новый структура();
			ПараметрыОтбора.Вставить("ДатаГрафика",СтрокаПериода.ДатаНачала);
			найденныеСтроки = ДанныеГрафика.НайтиСтроки(ПараметрыОтбора);
			Если найденныеСтроки.Количество() <> 0 И найденныеСтроки[0].ДеньВключенВГрафик Тогда
				ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
				ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы["ДеревоМатериалыКоличество_"+СтрокаПериода.ИмяКолонки].Имя);
			КонецЕсли;
		КонецЦикла;
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаКорректногоКонтрагентаВДокументе);
	КонецЕсли;

	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СтатьяРасходов.Имя);
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(Элемент.Поля, Элементы["СтатьяРасходов"].Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СтатьяРасходов");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	
	Элементы.СтатьяРасходов.Видимость = ПолучитьФункциональнуюОпцию("УСОERP_ИспользоватьМатериальноТехническоеОбеспечение")
										И ПолучитьФункциональнуюОпцию("УСОERP_ПередачаМатериаловВПроизводствоПоРасходуВСтроительстве") = 0;
										
	Элементы.АналитикаРасходов.Видимость = Элементы.СтатьяРасходов.Видимость;
	
	Элементы.ЦеховаяКладовая.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьУправлениеПроизводством2_2");
	
	Элементы.ОбеспечиватьОбособленно.Видимость = ПолучитьФункциональнуюОпцию("УСОERP_ПередачаМатериаловВПроизводствоПоРасходуВСтроительстве") = 2;
	
	
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоМатериалы.Имя);
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(Элемент.Поля, Элементы["ДеревоМатериалы"].Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоМатериалы.КодСДР");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ИтогДереваРабота");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;

	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,,Истина));

	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеГрафика()
	
	ЗапросГрафика = новый запрос("ВЫБРАТЬ
	                             |	КалендарныеГрафики.Календарь,
	                             |	КалендарныеГрафики.Год,
	                             |	КалендарныеГрафики.ДатаГрафика,
	                             |	КалендарныеГрафики.ДеньВключенВГрафик,
	                             |	КалендарныеГрафики.КоличествоДнейВГрафикеСНачалаГода
	                             |ИЗ
	                             |	РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
	                             |ГДЕ
	                             |	КалендарныеГрафики.Календарь = &Календарь
	                             |	И КалендарныеГрафики.ДатаГрафика МЕЖДУ &НачалоПериода И &КонецПериода");
	ЗапросГрафика.УстановитьПараметр("Календарь",Объект.ОбъектСтроительства.ГрафикРаботы);
	ЗапросГрафика.УстановитьПараметр("НачалоПериода",Объект.НачалоПериода);
	ЗапросГрафика.УстановитьПараметр("КонецПериода",Объект.ОкончаниеПериода);
	
	Возврат ЗапросГрафика.Выполнить().Выгрузить();
	
КонецФункции

