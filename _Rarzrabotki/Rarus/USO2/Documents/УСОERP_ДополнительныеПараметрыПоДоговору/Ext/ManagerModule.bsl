
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

#Область Прочее

Функция ПолучитьПараметрыГрафикаОплатПоДоговору(Договор,ДокументУтверждения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Договор",Договор);
	Запрос.УстановитьПараметр("ДокументУтверждения",ДокументУтверждения);
	
	МассивАвансов = Новый Массив;
	МассивАвансов.Добавить(Перечисления.ВариантыОплатыКлиентом.АвансДоОбеспечения);
	МассивАвансов.Добавить(Перечисления.ВариантыОплатыКлиентом.ПредоплатаДоОтгрузки);
	МассивАвансов.Добавить(Перечисления.ВариантыОплатыПоставщику.АвансДоПодтверждения);
	МассивАвансов.Добавить(Перечисления.ВариантыОплатыПоставщику.ПредоплатаДоПоступления);
	
	Запрос.УстановитьПараметр("МассивАвансов",МассивАвансов);
	
	МассивКредитов = Новый Массив;
	МассивКредитов.Добавить(Перечисления.ВариантыОплатыКлиентом.КредитПослеОтгрузки);
	МассивКредитов.Добавить(Перечисления.ВариантыОплатыКлиентом.КредитСдвиг);
	МассивКредитов.Добавить(Перечисления.ВариантыОплатыПоставщику.КредитПослеПоступления);
	МассивКредитов.Добавить(Перечисления.ВариантыОплатыПоставщику.КредитСдвиг);
	
	Запрос.УстановитьПараметр("МассивКредитов",МассивКредитов);
	
	МассивГУ = Новый Массив;
	МассивГУ.Добавить(Перечисления.ВариантыОплатыКлиентом.УСОERP_ГарантийноеУдержание);
	МассивГУ.Добавить(Перечисления.ВариантыОплатыПоставщику.УСОERP_ГарантийноеУдержание);
	
	Запрос.УстановитьПараметр("МассивГУ",МассивГУ);	
	
	СоглашениеПоДоговору = Справочники.СоглашенияСКлиентами.ПустаяСсылка();
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_ДоговорСЗаказчиком.Соглашение КАК Соглашение
	|ИЗ
	|	Документ.УСОERP_ДоговорСЗаказчиком КАК УСОERP_ДоговорСЗаказчиком
	|ГДЕ
	|	УСОERP_ДоговорСЗаказчиком.Договор = &Договор
	|	И УСОERP_ДоговорСЗаказчиком.ДокументУтверждения = &ДокументУтверждения
	|	И УСОERP_ДоговорСЗаказчиком.Проведен
	|	И УСОERP_ДоговорСЗаказчиком.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ДоговорСЗаказчиком.Соглашение
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УСОERP_ДоговорССубподрядчиком.Соглашение
	|ИЗ
	|	Документ.УСОERP_ДоговорССубподрядчиком КАК УСОERP_ДоговорССубподрядчиком
	|ГДЕ
	|	УСОERP_ДоговорССубподрядчиком.Договор = &Договор
	|	И УСОERP_ДоговорССубподрядчиком.ДокументУтверждения = &ДокументУтверждения
	|	И УСОERP_ДоговорССубподрядчиком.Проведен
	|	И УСОERP_ДоговорССубподрядчиком.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ДоговорССубподрядчиком.Соглашение";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если  Выборка.Следующий() Тогда
		СоглашениеПоДоговору = Выборка.Соглашение;
	КонецЕсли;
		
	Запрос.Текст = 
	"ВЫБРАТЬ 
	|	СоглашенияСКлиентамиЭтапыГрафикаОплаты.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА СоглашенияСКлиентамиЭтапыГрафикаОплаты.ВариантОплаты В (&МассивАвансов)
	|			ТОГДА ""Аванс""
	|		КОГДА СоглашенияСКлиентамиЭтапыГрафикаОплаты.ВариантОплаты В (&МассивКредитов)
	|			ТОГДА ""Кредит""
	|		КОГДА СоглашенияСКлиентамиЭтапыГрафикаОплаты.ВариантОплаты В (&МассивГУ)
	|			ТОГДА ""ГУ""
	|	КОНЕЦ КАК ВариантОплаты,
	|	СоглашенияСКлиентамиЭтапыГрафикаОплаты.Сдвиг КАК Сдвиг,
	|	СоглашенияСКлиентамиЭтапыГрафикаОплаты.ПроцентПлатежа КАК ПроцентПлатежа
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	Справочник.СоглашенияСКлиентами.ЭтапыГрафикаОплаты КАК СоглашенияСКлиентамиЭтапыГрафикаОплаты
	|ГДЕ
	|	СоглашенияСКлиентамиЭтапыГрафикаОплаты.Ссылка = &СоглашениеПоДоговору
	|	И &ИспользоватьЭтапыОплаты
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СоглашенияСПоставщикамиЭтапыГрафикаОплаты.Ссылка,
	|	ВЫБОР
	|		КОГДА СоглашенияСПоставщикамиЭтапыГрафикаОплаты.ВариантОплаты В (&МассивАвансов)
	|			ТОГДА ""Аванс""
	|		КОГДА СоглашенияСПоставщикамиЭтапыГрафикаОплаты.ВариантОплаты В (&МассивКредитов)
	|			ТОГДА ""Кредит""
	|		КОГДА СоглашенияСПоставщикамиЭтапыГрафикаОплаты.ВариантОплаты В (&МассивГУ)
	|			ТОГДА ""ГУ""
	|	КОНЕЦ,
	|	СоглашенияСПоставщикамиЭтапыГрафикаОплаты.Сдвиг,
	|	СоглашенияСПоставщикамиЭтапыГрафикаОплаты.ПроцентПлатежа
	|ИЗ
	|	Справочник.СоглашенияСПоставщиками.ЭтапыГрафикаОплаты КАК СоглашенияСПоставщикамиЭтапыГрафикаОплаты
	|ГДЕ
	|	СоглашенияСПоставщикамиЭтапыГрафикаОплаты.Ссылка = &СоглашениеПоДоговору
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СоглашенияСКлиентами.Ссылка,
	|	ВЫБОР
	|		КОГДА ГрафикиОплатыЭтапы.ВариантОплаты В (&МассивАвансов)
	|			ТОГДА ""Аванс""
	|		КОГДА ГрафикиОплатыЭтапы.ВариантОплаты В (&МассивКредитов)
	|			ТОГДА ""Кредит""
	|		КОГДА ГрафикиОплатыЭтапы.ВариантОплаты В (&МассивГУ)
	|			ТОГДА ""ГУ""
	|	КОНЕЦ,
	|	ГрафикиОплатыЭтапы.Сдвиг,
	|	ГрафикиОплатыЭтапы.ПроцентПлатежа
	|ИЗ
	|	Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГрафикиОплаты.Этапы КАК ГрафикиОплатыЭтапы
	|		ПО СоглашенияСКлиентами.ГрафикОплаты = ГрафикиОплатыЭтапы.Ссылка
	|ГДЕ
	|	СоглашенияСКлиентами.Ссылка = &СоглашениеПоДоговору
	|	И СоглашенияСКлиентами.Ссылка.ГрафикОплаты <> ЗНАЧЕНИЕ(Справочник.ГрафикиОплаты.ПустаяСсылка)
	|	И НЕ &ИспользоватьЭтапыОплаты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.Ссылка КАК Ссылка,
	|	ВрТаб.ВариантОплаты КАК ВариантОплаты,
	|	МАКСИМУМ(ВрТаб.Сдвиг) КАК Сдвиг,
	|	СУММА(ВрТаб.ПроцентПлатежа) КАК ПроцентПлатежа
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|
	|СГРУППИРОВАТЬ ПО
	|	ВрТаб.Ссылка,
	|	ВрТаб.ВариантОплаты";
	
	Запрос.УстановитьПараметр("СоглашениеПоДоговору", 		СоглашениеПоДоговору);
	Запрос.УстановитьПараметр("ИспользоватьЭтапыОплаты", 	СоглашениеПоДоговору.ЭтапыГрафикаОплаты.Количество() > 0 Или Не ПолучитьФункциональнуюОпцию("ИспользоватьГрафикиОплаты"));
	
	
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
	
#КонецОбласти

#Область Проведение

Процедура 	ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт				
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Дата КАК Период,
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Ссылка КАК Регистратор,
	|	ДоговорыКонтрагентов.Контрагент,
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Договор КАК Договор,
	|	УСОERP_ДополнительныеПараметрыПоДоговору.ДоговорРодитель КАК ДоговорРодитель,
	|	УСОERP_ДополнительныеПараметрыПоДоговору.ОбъектСтроительства,
	|	УСОERP_ДополнительныеПараметрыПоДоговору.СуммаДоговора,
	|	УСОERP_ДополнительныеПараметрыПоДоговору.СуммаНДС
	|ИЗ
	|	Документ.УСОERP_ДополнительныеПараметрыПоДоговору КАК УСОERP_ДополнительныеПараметрыПоДоговору
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО УСОERP_ДополнительныеПараметрыПоДоговору.Договор = ДоговорыКонтрагентов.Ссылка
	|ГДЕ
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("ТаблицаДополнительныеПараметрыПоДоговору",	Результат[0].Выгрузить());
	
КонецПроцедуры

#КонецОбласти

#Область Отчеты
// Определяет список команд отчетов.
//
// Параметры:
//   КомандыОтчетов - ТаблицаЗначений - Таблица с командами отчетов. Для изменения.
//       См. описание 1 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
//   Параметры - Структура - Вспомогательные параметры. Для чтения.
//       См. описание 2 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
//
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, Параметры) Экспорт
	
	ВариантыОтчетовУТПереопределяемый.ДобавитьКомандуСтруктураПодчиненности(КомандыОтчетов);
	
КонецПроцедуры

#КонецОбласти   

#Область Печать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
