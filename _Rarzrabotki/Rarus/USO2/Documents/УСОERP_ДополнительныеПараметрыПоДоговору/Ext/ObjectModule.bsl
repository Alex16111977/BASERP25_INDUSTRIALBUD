
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура 	ОбработкаПроведения(Отказ, РежимПроведения)													
	
	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	Документы.УСОERP_ДополнительныеПараметрыПоДоговору.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	ОтразитьДвижения_ДополнительныеПараметрыПоДоговору(ДополнительныеСвойства, Движения, Отказ);
	
	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);

	ПроведениеСерверУТ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура 	ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)											
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПредусмотреныГарантийныеУдержанияПоДоговору = Истина;
	
	//Если НЕ ЗначениеЗаполнено(Договор.УСОERP_ОсновнойПроект) Тогда
	//	Дог = Договор.ПолучитьОбъект();
	//	Дог.УСОERP_ОсновнойПроект = ОбъектСтроительства;
	//	Дог.ОбменДанными.Загрузка = Истина;
	//	Дог.Записать();
	//КонецЕсли;
	
	Если Детализация <> 1 Тогда
		ПроцентГарантийныхУдержанийПоРаботам.Очистить();
	КонецЕсли;
	
	Если Детализация <> 2 Тогда
		ПроцентГарантийныхУдержанийПоВидамРабот.Очистить();
	КонецЕсли;
	
	УчитыватьПроцентГарантийныхУдержанийПоРаботам = Детализация = 1;
	ПоРаботам = Детализация = 1;
	
	УчитыватьПроцентГарантийныхУдержанийПоВидамРабот = Детализация = 2;
	ПоВидамРабот = Детализация = 2; 		
	
	Если Статус = Перечисления.РезультатыСогласования.Согласовано Тогда
		ПроверитьНаСуществованиеДокумента(Отказ);
	КонецЕсли;
	
	ПроведениеСерверУТ.УстановитьРежимПроведения(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") И ДанныеЗаполнения.Свойство("Договор") Тогда
		
		Организация = ДанныеЗаполнения.Договор.Организация;
		Договор = ДанныеЗаполнения.Договор;
		ОбъектСтроительства = Договор.УСОERP_ОсновнойПроект;
		Если ЗначениеЗаполнено(ОбъектСтроительства) Тогда
			ДокументУтверждения = УСОERP_ЗащищенныеФункцииСервер.ПолучитьПоследнийДокументУтверждения(ОбъектСтроительства,Организация);
		КонецЕсли;
				
	КонецЕсли; 	
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,ОбъектКопирования,,"Номер,Дата");		
	
КонецПроцедуры 

Процедура ПроверитьНаСуществованиеДокумента(Отказ)
	
	Если НЕ ЗначениеЗаполнено(ДокументУтверждения) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Запрос.УстановитьПараметр("ДокументУтверждения",ДокументУтверждения);
	Запрос.УстановитьПараметр("Договор",Договор);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УСОERP_ДополнительныеПараметрыПоДоговору КАК УСОERP_ДополнительныеПараметрыПоДоговору
	|ГДЕ
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Проведен
	|	И УСОERP_ДополнительныеПараметрыПоДоговору.ДокументУтверждения = &ДокументУтверждения
	|	И УСОERP_ДополнительныеПараметрыПоДоговору.Статус = ЗНАЧЕНИЕ(Перечисление.РезультатыСогласования.Согласовано)
	|	И УСОERP_ДополнительныеПараметрыПоДоговору.Ссылка <> &Ссылка
	|	И УСОERP_ДополнительныеПараметрыПоДоговору.Договор = &Договор";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если  Выборка.Следующий() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По документу утверждения уже есть доп.параметры! ("+Выборка.Ссылка+")");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиДвиженийДокумента

Процедура 	ОтразитьДвижения_ДополнительныеПараметрыПоДоговору(ДополнительныеСвойства, Движения, Отказ)	
	
	ТаблицаДвижений = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаДополнительныеПараметрыПоДоговору;
	
	Если Отказ ИЛИ ТаблицаДвижений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ДвиженияГрафик = Движения.УСОERP_ДополнительныеПараметрыПоДоговору;
	ДвиженияГрафик.Записывать = Истина;
	ДвиженияГрафик.Загрузить(ТаблицаДвижений);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ПроцентАванса+ПроцентКредита+ПроцентГарантийныхУдержаний <> 100 И ПроцентАванса+ПроцентКредита+ПроцентГарантийныхУдержаний <> 0 Тогда		
			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Общая сумма распределения платежа не равна 100%!",,,,Отказ); 
		
	КонецЕсли;
	
	
	Если УчитыватьПроцентГарантийныхУдержанийПоРаботам+УчитыватьПроцентГарантийныхУдержанийПоВидамРабот Тогда
		
		Запрос = Новый Запрос;
		
		Если УчитыватьПроцентГарантийныхУдержанийПоРаботам Тогда  		
			
			Запрос.УстановитьПараметр("Таблица",ПроцентГарантийныхУдержанийПоРаботам.Выгрузить()); 		
			
		КонецЕсли;
		
		Если УчитыватьПроцентГарантийныхУдержанийПоВидамРабот Тогда
			
			Запрос.УстановитьПараметр("Таблица",ПроцентГарантийныхУдержанийПоВидамРабот.Выгрузить());
			
		КонецЕсли;
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Таблица.НомерСтроки КАК НомерСтроки,
		|	Таблица.ПроцентАванса КАК ПроцентАванса,
		|	Таблица.ПроцентКредита КАК ПроцентКредита,
		|	Таблица.ЗначениеПроцентаГарантийногоУдержания КАК ЗначениеПроцентаГарантийногоУдержания
		|ПОМЕСТИТЬ ВрТаб
		|ИЗ
		|	&Таблица КАК Таблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТаб.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	ВрТаб КАК ВрТаб
		|ГДЕ
		|	ВрТаб.ПроцентАванса + ВрТаб.ПроцентКредита + ВрТаб.ЗначениеПроцентаГарантийногоУдержания <> 100
		|	И ВрТаб.ПроцентАванса + ВрТаб.ПроцентКредита + ВрТаб.ЗначениеПроцентаГарантийногоУдержания <> 0";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
				
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(" В строке № "+Выборка.НомерСтроки+" общая сумма распределения не равна 100%!",,,,Отказ);
			
		КонецЦикла;  		
		
	КонецЕсли; 	
	
КонецПроцедуры


#КонецОбласти

#КонецЕсли
