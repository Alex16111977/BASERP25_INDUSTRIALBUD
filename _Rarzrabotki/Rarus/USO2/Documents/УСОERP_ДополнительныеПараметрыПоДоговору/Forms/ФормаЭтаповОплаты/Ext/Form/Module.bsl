
&НаКлиенте
Процедура ТаблицаЭтаповОплатыПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЭтаповОплатыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 	
	
	Если Параметры.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем Тогда
		
		Нстр = ТаблицаЭтаповОплаты.Добавить();
		Нстр.ВариантОплаты = Перечисления.ВариантыОплатыКлиентом.АвансДоОбеспечения;
		Нстр.Сдвиг = Параметры.СрокАванса;
		Нстр.Процент = Параметры.ПроцентАванса;
		
		Нстр = ТаблицаЭтаповОплаты.Добавить();
		Нстр.ВариантОплаты = Перечисления.ВариантыОплатыКлиентом.КредитПослеОтгрузки;
		Нстр.Сдвиг = Параметры.СрокКредита;
		Нстр.Процент = Параметры.ПроцентКредита;
		
		Нстр = ТаблицаЭтаповОплаты.Добавить();
		Нстр.ВариантОплаты = Перечисления.ВариантыОплатыКлиентом.УСОERP_ГарантийноеУдержание;
		Нстр.Сдвиг = Параметры.СрокГарантийныхУдержаний;
		Нстр.Процент = Параметры.ПроцентГарантийныхУдержаний;
		
	ИначеЕсли Параметры.ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком Тогда
		
		Нстр = ТаблицаЭтаповОплаты.Добавить();
		Нстр.ВариантОплаты = Перечисления.ВариантыОплатыПоставщику.АвансДоПодтверждения;
		Нстр.Сдвиг = Параметры.СрокАванса;
		Нстр.Процент = Параметры.ПроцентАванса;
		
		Нстр = ТаблицаЭтаповОплаты.Добавить();
		Нстр.ВариантОплаты = Перечисления.ВариантыОплатыПоставщику.КредитПослеПоступления;
		Нстр.Сдвиг = Параметры.СрокКредита;
		Нстр.Процент = Параметры.ПроцентКредита;
		
		Нстр = ТаблицаЭтаповОплаты.Добавить();
		Нстр.ВариантОплаты = Перечисления.ВариантыОплатыПоставщику.УСОERP_ГарантийноеУдержание;
		Нстр.Сдвиг = Параметры.СрокГарантийныхУдержаний;
		Нстр.Процент = Параметры.ПроцентГарантийныхУдержаний;  		
		
	Иначе 	
		
		Отказ = Истина;
		
	КонецЕсли; 
	
	УчетОтсрочки = Параметры.ПоРабочимДням;
	
	СуммаПроцентов = ТаблицаЭтаповОплаты.Итог("Процент");
	Элементы.ТаблицаЭтаповОплатыПроцентОплаты.ЦветТекстаПодвала = ?(СуммаПроцентов <> 100,WebЦвета.Красный,WebЦвета.Черный);
	
КонецПроцедуры


&НаКлиенте
Процедура КомандаЗакрыть(Команда)
	
	Если СуммаПроцентов <> 100 Тогда
		
		ПоказатьПредупреждение(,"Общая сумма процентов не равна 100!");
		Возврат;
		
	КонецЕсли;
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ПоРабочимДням",УчетОтсрочки);
	СтруктураВозврата.Вставить("Таблица",ТаблицаЭтаповОплаты);
	
	ОповеститьОВыборе(СтруктураВозврата);
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаЭтаповОплатыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	
	СуммаПроцентов = ТаблицаЭтаповОплаты.Итог("Процент");
	
	Элементы.ТаблицаЭтаповОплатыПроцентОплаты.ЦветТекстаПодвала = ?(СуммаПроцентов <> 100,WebЦвета.Красный,WebЦвета.Черный);
	
КонецПроцедуры

