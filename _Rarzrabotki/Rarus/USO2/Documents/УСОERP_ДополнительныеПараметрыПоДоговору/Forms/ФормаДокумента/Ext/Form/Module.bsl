&НаКлиенте
Процедура ДетализацияПриИзменении(Элемент)
	ОбновитьФорму();
КонецПроцедуры

&НаКлиенте
Процедура ДокументУтвержденияПриИзменении(Элемент)
	
	Объект.ПроцентГарантийныхУдержанийПоВидамРабот.Очистить();
	Объект.ПроцентГарантийныхУдержанийПоРаботам.Очистить();
	
	СтруктураОплаты = ПолучитьСтруктуруОплаты();
	
	ЗаполнитьЗначенияСвойств(Объект,СтруктураОплаты);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоГрафикуФинансирования(Команда)
	
	СписокДанных = ПолучитьСписокГрафиковФинансирования();
	
	Если СписокДанных.Количество() = 0 Тогда
		ПоказатьПредупреждение(,"Нет графиков финансирования для объекта "+Объект.ОбъектСтроительства);
		Возврат;
	КонецЕсли;
	
	Если СписокДанных.Количество() = 1 Тогда
		
		ЗаполнитьПоГрафикуПродолжение(СписокДанных.Получить(0).Значение,Новый Структура);
		
	Иначе
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПоГрафикуПродолжение",ЭтотОбъект);
		
		СписокДанных.ПоказатьВыборЭлемента(ОписаниеОповещения);	
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура  ЗаполнитьПоГрафикуПродолжение(ВыбранноеЗначение,ДопПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ГрафикФинансирования = ?(ТипЗнч(ВыбранноеЗначение) = Тип("ЭлементСпискаЗначений"),ВыбранноеЗначение.Значение,ВыбранноеЗначение);
	
	СтруктураПараметров = Новый Структура("ГрафикФинансирования",ГрафикФинансирования);
	
	Если Объект.ПроцентАванса+Объект.СрокАванса+Объект.ПроцентКредита+Объект.СрокКредита+Объект.ПроцентГарантийныхУдержаний+Объект.СрокГарантийныхУдержаний = 0 Тогда
		
		ЗаполнитьПоГрафикуЗавершение(КодВозвратаДиалога.Да,СтруктураПараметров);
		
	Иначе		
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПоГрафикуЗавершение",ЭтотОбъект,СтруктураПараметров); 		
		
		ПоказатьВопрос(ОписаниеОповещения,"Данные графика будут перезаполнены, продолжить?",РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;  	
	
КонецПроцедуры  

&НаКлиенте
Процедура  ЗаполнитьПоГрафикуЗавершение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да  Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоГрафикуФинансированияНаСервере(ДопПараметры.ГрафикФинансирования);
	
	ЗаполнитьНадписьЭтаповОплаты();
	
	Модифицированность = Истина;	
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьПоГрафикуФинансированияНаСервере(ГрафикФинансирования);
	
	Объект.ПроцентАванса = 0;
	Объект.СрокАванса = 0;
	Объект.ПроцентКредита = 0;
	Объект.СрокКредита = 0;
	Объект.ПроцентГарантийныхУдержаний = 0;
	Объект.СрокГарантийныхУдержаний = 0;
	
	Для Каждого СтрокаТЧ ИЗ ГрафикФинансирования.Этапы Цикл
		
		Если СтрокаТЧ.ВариантОплаты = Перечисления.ВариантыОплатыКлиентом.АвансДоОбеспечения ИЛИ
			СтрокаТЧ.ВариантОплаты = Перечисления.ВариантыОплатыПоставщику.АвансДоПодтверждения Тогда
			
			Объект.ПроцентАванса = СтрокаТЧ.ПроцентПлатежа;
			Объект.СрокАванса = СтрокаТЧ.Сдвиг;
			
		КонецЕсли;
		
		
		Если СтрокаТЧ.ВариантОплаты = Перечисления.ВариантыОплатыКлиентом.КредитПослеОтгрузки ИЛИ
			СтрокаТЧ.ВариантОплаты = Перечисления.ВариантыОплатыПоставщику.КредитПослеПоступления Тогда
			
			Объект.ПроцентКредита = СтрокаТЧ.ПроцентПлатежа;
			Объект.СрокКредита = СтрокаТЧ.Сдвиг;
			
		КонецЕсли;  		
		
		Если СтрокаТЧ.ВариантОплаты = Перечисления.ВариантыОплатыКлиентом.УСОERP_ГарантийноеУдержание ИЛИ
			СтрокаТЧ.ВариантОплаты = Перечисления.ВариантыОплатыПоставщику.УСОERP_ГарантийноеУдержание Тогда
			
			Объект.ПроцентГарантийныхУдержаний = СтрокаТЧ.ПроцентПлатежа;
			Объект.СрокГарантийныхУдержаний = СтрокаТЧ.Сдвиг;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьТабличныеЧастиПоГрафику(); 	
	
КонецПроцедуры 

&НаСервере
Процедура  ЗаполнитьТабличныеЧастиПоГрафику()
	
	Возврат;
	
	Для Каждого СтрокаТЧ ИЗ Объект.ПроцентГарантийныхУдержанийПоВидамРабот Цикл
		
		ЗаполнитьЗначенияСвойств(СтрокаТЧ,Объект,"ПроцентКредита,СрокКредита,ПроцентАванса,СрокАванса");
		СтрокаТЧ.ЗначениеПроцентаГарантийногоУдержания = Объект.ПроцентГарантийныхУдержаний;
		СтрокаТЧ.СрокГарантийногоУдержания = Объект.СрокГарантийныхУдержаний;
		
	КонецЦикла;
	
	Для Каждого СтрокаТЧ ИЗ Объект.ПроцентГарантийныхУдержанийПоРаботам Цикл
		
		ЗаполнитьЗначенияСвойств(СтрокаТЧ,Объект,"ПроцентКредита,СрокКредита,ПроцентАванса,СрокАванса");
		СтрокаТЧ.ЗначениеПроцентаГарантийногоУдержания = Объект.ПроцентГарантийныхУдержаний;
		СтрокаТЧ.СрокГарантийногоУдержания = Объект.СрокГарантийныхУдержаний; 
		
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Функция  ПолучитьСписокГрафиковФинансирования()
	
	СписокВозврата = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбъектСтроительства",Объект.ОбъектСтроительства);
	Запрос.УстановитьПараметр("ЭтоЗаказчик",Объект.Договор.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА &ЭтоЗаказчик
	|			ТОГДА УСОERP_УсловияАктированияФинансирования.УсловияФинансированияСЗаказчиком
	|		ИНАЧЕ УСОERP_УсловияАктированияФинансирования.УсловияФинансированияСПодрядчиком
	|	КОНЕЦ КАК УсловияФинансирования
	|ИЗ
	|	РегистрСведений.УСОERP_УсловияАктированияФинансирования КАК УСОERP_УсловияАктированияФинансирования
	|ГДЕ
	|	УСОERP_УсловияАктированияФинансирования.ОбъектСтроительства = &ОбъектСтроительства
	|	И УСОERP_УсловияАктированияФинансирования.Работа = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|	И ВЫБОР
	|			КОГДА &ЭтоЗаказчик
	|				ТОГДА УСОERP_УсловияАктированияФинансирования.УсловияФинансированияСЗаказчиком <> ЗНАЧЕНИЕ(Справочник.УСОERP_ГрафикиАктированияФинансирования.ПустаяСсылка)
	|			ИНАЧЕ УСОERP_УсловияАктированияФинансирования.УсловияФинансированияСПодрядчиком <> ЗНАЧЕНИЕ(Справочник.УСОERP_ГрафикиАктированияФинансирования.ПустаяСсылка)
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА &ЭтоЗаказчик
	|			ТОГДА УСОERP_УсловияАктированияФинансирования.УсловияФинансированияСЗаказчиком
	|		ИНАЧЕ УСОERP_УсловияАктированияФинансирования.УсловияФинансированияСПодрядчиком
	|	КОНЕЦ";
	
	СписокВозврата.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("УсловияФинансирования"));	
	
	Возврат СписокВозврата;
	
КонецФункции  

&НаКлиенте
Процедура ДекорацияЭтапыОплатыНажатие(Элемент)
	
	ПараметрыОткрытия = Новый Структура("ПроцентАванса,СрокАванса,ПроцентГарантийныхУдержаний,СрокГарантийныхУдержаний,ПроцентКредита,СрокКредита,ПоРабочимДням");
	ЗаполнитьЗначенияСвойств(ПараметрыОткрытия,Объект);
	//ТипДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор,"ТипДоговора");
	ПараметрыОткрытия.Вставить("ТипДоговора",ТипДоговора(Объект.Договор));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЭтапыОплатыПродолжение",ЭтотОбъект);
	
	ОткрытьФорму("Документ.УСОERP_ДополнительныеПараметрыПоДоговору.Форма.ФормаЭтаповОплаты",ПараметрыОткрытия,ЭтотОбъект,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНадписьЭтаповОплаты()
	
	Если Объект.ПроцентАванса+Объект.ПроцентКредита+Объект.ПроцентГарантийныхУдержаний = 0 Тогда
		
		Элементы.ДекорацияЭтапыОплаты.Заголовок = "Этапы оплаты: Не указаны";
		Элементы.ДекорацияЭтапыОплаты.ЦветТекста = WebЦвета.Красный;
		
	Иначе
		
		Элементы.ДекорацияЭтапыОплаты.Заголовок = "Этапы оплаты: Аванс "+Объект.ПроцентАванса+" % ("+Объект.СрокАванса+ "дн), Кредит "+Объект.ПроцентКредита+" %("+Объект.СрокКредита+" дн), ГУ "+Объект.ПроцентГарантийныхУдержаний+" %("+Объект.СрокГарантийныхУдержаний+" дн), "+?(Объект.ПоРабочимДням,"по рабочим дням","по календарным дням");
		
		Элементы.ДекорацияЭтапыОплаты.ЦветТекста = WebЦвета.Синий;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ТипДоговора(Договор)
	
	Возврат Договор.ТипДоговора;
	
КонецФункции   

&НаКлиенте
Процедура ЭтапыОплатыПродолжение(ВыбранноеЗначение,ДопПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Таблица = ВыбранноеЗначение.Таблица; 	
	
	Объект.ПроцентАванса = Таблица.Получить(0).Процент;
	Объект.СрокАванса = Таблица.Получить(0).Сдвиг;
	
	Объект.ПроцентКредита = Таблица.Получить(1).Процент;
	Объект.СрокКредита = Таблица.Получить(1).Сдвиг;
	
	Объект.ПроцентГарантийныхУдержаний = Таблица.Получить(2).Процент;
	Объект.СрокГарантийныхУдержаний = Таблица.Получить(2).Сдвиг;
	
	Объект.ПоРабочимДням = ВыбранноеЗначение.ПоРабочимДням;
	
	Модифицированность = Истина;
	ЗаполнитьНадписьЭтаповОплаты();
	
	ЗаполнитьТабличныеЧастиПоГрафику();
	
КонецПроцедуры 

#КонецОбласти

#КонецОбласти
