&НаКлиенте
Функция СтруктураПараметрыФормы()												
	
	ПараметрыФормы = СтруктураПараметрыФормыНаСервере();
	
	ПараметрыФормы.Вставить("Договор", 	Объект.ДоговорРодитель);
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаСервере
Функция СтруктураПараметрыФормыНаСервере()										
	
	ПараметрыФормы 		= Новый Структура;	
	
	ПараметрыФормы.Вставить("Отказ", 	Ложь);	
	ПараметрыФормы.Вставить("Контрагент", Объект.Договор.Контрагент);	
	
	ЗаполнитьДоговорыССубподрядчикомСЗаказчиком(ПараметрыФормы, Объект.ДоговорРодитель); 
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Процедура 	ЗаполнитьДанныеФормыНаКлиенте()											
	
	ДобавитьТЧДокументыПоДоговору(ПараметрыФормы);	
	
КонецПроцедуры

&НаСервере
Процедура 	ДобавитьТЧДокументыПоДоговору(ПараметрыФормы)							
	
	Если ПараметрыФормы.Свойство("ДокументыПоДоговору") И ПараметрыФормы.ДокументыПоДоговору.Количество() <> 0 Тогда
		
		ТипДоговора = Объект.ДоговорРодитель.ТипДоговора;
		
		МассивТиповДокументов = Новый Массив;
		МассивТиповДокументов.Добавить(Тип("ДокументСсылка.УСОERP_ДоговорССубподрядчиком"));
		МассивТиповДокументов.Добавить(Тип("ДокументСсылка.УСОERP_ДоговорСЗаказчиком"));
		
		МассивДобавляемыхРеквизитов = Новый Массив;
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ТЧДокументыПоДоговору", 	Новый ОписаниеТипов("ТаблицаЗначений")));
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ДокументПоДоговору", 		Новый ОписаниеТипов(МассивТиповДокументов), "ТЧДокументыПоДоговору"));
		
		ИзменитьРеквизиты(МассивДобавляемыхРеквизитов); 
		
		ГруппаФормы = Элементы.Добавить("ГруппаТЧДокументыПоДоговору", Тип("ГруппаФормы"), Элементы.Страницы);
		Если ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком 
			ИЛИ ТипДоговора = Перечисления.ТипыДоговоров.СПереработчиком Тогда
			ГруппаФормы.Заголовок = "Договоры с субподрядчиками";
		ИначеЕсли ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем 
			ИЛИ ТипДоговора = Перечисления.ТипыДоговоров.СДавальцем Тогда
			ГруппаФормы.Заголовок = "Договоры с заказчиком";
		Иначе
			ГруппаФормы.Заголовок = "Договоры";
		КонецЕсли;
		
		ТаблицаФормы = Элементы.Добавить("ТЧДокументыПоДоговору", Тип("ТаблицаФормы"), ГруппаФормы); 
		ТаблицаФормы.ПутьКДанным 				= "ТЧДокументыПоДоговору"; 
		ТаблицаФормы.ПоложениеКоманднойПанели 	= ПоложениеКоманднойПанелиЭлементаФормы.Нет;
		ТаблицаФормы.ТолькоПросмотр				= Истина;
		
		НоваяКолонка = Элементы.Добавить("ДокументПоДоговору", Тип("ПолеФормы"), ТаблицаФормы);
		НоваяКолонка.Вид 			= ВидПоляФормы.ПолеВвода;
		НоваяКолонка.Заголовок 		= "Документы по договору"; 
		НоваяКолонка.ПутьКДанным 	= "ТЧДокументыПоДоговору.ДокументПоДоговору";
		НоваяКолонка.КнопкаОткрытия = Истина;
		
		ТЗ_ДокументыПоДоговору = РеквизитФормыВЗначение("ТЧДокументыПоДоговору");
		Пока ТЗ_ДокументыПоДоговору.Количество() < ПараметрыФормы.ДокументыПоДоговору.Количество() Цикл
			ТЗ_ДокументыПоДоговору.Добавить();
		КонецЦикла;
		ТЗ_ДокументыПоДоговору.ЗагрузитьКолонку(ПараметрыФормы.ДокументыПоДоговору, "ДокументПоДоговору");
		ЗначениеВРеквизитФормы(ТЗ_ДокументыПоДоговору, "ТЧДокументыПоДоговору");
		
		ТаблицаФормы.УстановитьДействие("Выбор", "ВыборДокументПоДоговору");
		
	КонецЕсли;
	
КонецПроцедуры

