&НаСервере
Процедура ПересчитатьСуммуНДС()
	
	СтавкаНДС = ?(ЗначениеЗаполнено(Объект.Договор.СтавкаНДС),Объект.Договор.СтавкаНДС,Перечисления.СтавкиНДС.БезНДС); 
	Объект.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(Объект.СуммаДоговора, СтавкаНДС, Ложь);
	Объект.СуммаБезНДС = Объект.СуммаДоговора-Объект.СуммаНДС;
	
КонецПроцедуры  

&НаКлиенте
Процедура 	СуммаНДСПриИзменении(Элемент)
	ПересчитатьСуммыДополнительныхПараметров();
КонецПроцедуры

&НаКлиенте
Процедура 	СуммаБезНДСПриИзменении(Элемент)
	ПересчитатьСуммыДополнительныхПараметров();
КонецПроцедуры

&НаКлиенте
Процедура 	ПересчитатьСуммыДополнительныхПараметров()
	Если Объект.СуммаДоговора >= ?(Объект.СуммаНДС, Объект.СуммаНДС, 0) Тогда
		Объект.СуммаБезНДС = Объект.СуммаДоговора - ?(Объект.СуммаНДС, Объект.СуммаНДС, 0);
	Иначе
		Объект.СуммаБезНДС = 0;
	КонецЕсли;	
КонецПроцедуры

