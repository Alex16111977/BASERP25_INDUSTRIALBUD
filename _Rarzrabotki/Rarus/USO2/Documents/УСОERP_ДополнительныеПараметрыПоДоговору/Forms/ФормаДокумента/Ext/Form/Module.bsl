&НаКлиенте
Процедура ДоговорРодительНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗначениеОтбора  	= Новый Структура("Контрагент", ПараметрыФормы.Контрагент);
	ПараметрыОткрытия 	= Новый Структура("Отбор", 		ЗначениеОтбора);
	ОткрытьФорму("Справочник.ДоговорыКонтрагентов.Форма.ФормаВыбора", ПараметрыОткрытия,,,,, Новый ОписаниеОповещения("ДоговорРодительНачалоВыбораЗавершение", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорРодительНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт	
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Объект.ДоговорРодитель) = ТипЗнч(Результат) Тогда
		Объект.ДоговорРодитель 		= Результат;
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СвязанныеДоговора(Команда)												
	
	ТабДокРезультат = ТабДокРезультат_СвязанныеДоговора(Объект.Дата, Объект.ОбъектСтроительства);
	
	ФормаОтчета = ПолучитьФорму("Отчет.УСОERP_СвязанныеДоговоры.Форма");
	ФормаОтчета.ОтчетТабличныйДокумент = ТабДокРезультат;
	ФормаОтчета.Элементы.ОтчетТабличныйДокумент.ОтображениеСостояния.Видимость = Ложь;
	ФормаОтчета.Элементы.ОтчетТабличныйДокумент.ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.НеИспользовать;
	ФормаОтчета.Открыть();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТабДокРезультат_СвязанныеДоговора(Дата, ОбъектСтроительства)			
	
	ОтчетОбъект = Отчеты.УСОERP_СвязанныеДоговоры.Создать();
	
	Схема 		= ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Настройки 	= Схема.НастройкиПоУмолчанию;
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ОбъектСтроительства", 	ОбъектСтроительства);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", 				Дата);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет);
	
	ТабДокРезультат = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабДокРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Возврат ТабДокРезультат;
	
КонецФункции

