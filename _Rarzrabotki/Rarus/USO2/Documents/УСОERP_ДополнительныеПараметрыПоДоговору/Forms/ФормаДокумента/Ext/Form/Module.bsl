
&НаКлиенте
Перем ПараметрыФормы;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура 	ПриОткрытии(Отказ)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) И НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
		ПоказатьПредупреждение(,"Документ можно создавать только из справочника ""Договоры с контрагентами""!",30);
		Отказ = Истина;
		Возврат;
	КонецЕсли;  	
	
	ПараметрыФормы = СтруктураПараметрыФормы();
	
	ЗаполнитьДанныеФормыНаКлиенте();
	
	ЗаполнитьДополнительныеРеквизитыТабличнойЧасти();
	
	ЗаполнитьНадписьЭтаповОплаты();
	
КонецПроцедуры

&НаСервере
Процедура 	ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)						
	
	Если Параметры.Свойство("Договор") И ЗначениеЗаполнено(Параметры.Договор) Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
			
			Объект.Договор = Параметры.Договор;
			Объект.СуммаДоговора = Объект.Договор.Сумма;
			Объект.Организация = Объект.Договор.Организация;	
			Объект.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(Объект.СуммаДоговора,Объект.Договор.СтавкаНДС,Истина);
			Объект.СуммаБезНДС = Объект.СуммаДоговора - Объект.СуммаНДС; 		
			ЗаполнитьДанныеФормыНаСервере();
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	СобытияФорм.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.ДоговорыКонтрагентов.Форма.ФормаВыбора" Тогда
		Объект.ДоговорГарантийногоУдержания = ВыбранноеЗначение;
	КонецЕсли;
	
КонецПроцедуры

