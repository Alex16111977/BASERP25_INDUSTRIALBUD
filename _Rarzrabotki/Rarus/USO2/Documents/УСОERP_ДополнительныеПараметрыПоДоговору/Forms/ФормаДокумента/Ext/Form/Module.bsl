&НаСервереБезКонтекста
Процедура 	ЗаполнитьДоговорыССубподрядчикомСЗаказчиком(ПараметрыФормы, Договор)	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ДоговорССубподрядчикомРаботы.Ссылка КАК ДокументПоДоговору,
	|	ЗНАЧЕНИЕ(Перечисление.УСОERP_ПорядокДоходовРасходов.ПоступлениеЗатрат) КАК ПорядокДоходовРасходов
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УСОERP_ДоговорССубподрядчиком.Работы КАК УСОERP_ДоговорССубподрядчикомРаботы
	|		ПО ДоговорыКонтрагентов.Ссылка = УСОERP_ДоговорССубподрядчикомРаботы.Ссылка.Договор
	|ГДЕ
	|	УСОERP_ДоговорССубподрядчикомРаботы.Ссылка.Проведен
	|	И ДоговорыКонтрагентов.Ссылка = &Договор
	|	И (ДоговорыКонтрагентов.Ссылка.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПоставщиком)
	|			ИЛИ ДоговорыКонтрагентов.Ссылка.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПереработчиком))
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	УСОERP_ДоговорСЗаказчикомРаботы.Ссылка,
	|	ЗНАЧЕНИЕ(Перечисление.УСОERP_ПорядокДоходовРасходов.Реализация)
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УСОERP_ДоговорСЗаказчиком.Работы КАК УСОERP_ДоговорСЗаказчикомРаботы
	|		ПО ДоговорыКонтрагентов.Ссылка = УСОERP_ДоговорСЗаказчикомРаботы.Ссылка.Договор
	|ГДЕ
	|	УСОERP_ДоговорСЗаказчикомРаботы.Ссылка.Проведен
	|	И ДоговорыКонтрагентов.Ссылка = &Договор
	|	И (ДоговорыКонтрагентов.Ссылка.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПокупателем)
	|			ИЛИ ДоговорыКонтрагентов.Ссылка.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СДавальцем))";
	
	Запрос.УстановитьПараметр("Договор", Договор);
	
	ТЗ_ДокументыПоДоговору = Запрос.Выполнить().Выгрузить();
	
	ПараметрыФормы.Вставить("ДокументыПоДоговору", ТЗ_ДокументыПоДоговору.ВыгрузитьКолонку("ДокументПоДоговору"));
	
КонецПроцедуры

&НаКлиенте
Процедура ПроцентГарантийныхУдержанийПоРаботамРаботаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(Объект.ДокументУтверждения) Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыборРаботОбработкаВыбора",ЭтотОбъект);
		
		ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаВыбора",Новый Структура("ДокументУтверждения",Объект.ДокументУтверждения),ЭтотОбъект,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли ЗначениеЗаполнено(Объект.ОбъектСтроительства) Тогда
		//СтандартнаяОбработка = Ложь;
		ПараметрыОтбора = Новый Структура("СценарийПланирования", ВернутьСценарийПланирования(Объект.ОбъектСтроительства));
		ФормаВыбора = ПолучитьФорму("Справочник.УСОERP_СтроительныеРаботы.ФормаВыбора", ПараметрыОтбора, Элемент);
		ФормаВыбора.Открыть();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборРаботОбработкаВыбора(ВыбранноеЗначение,ДопПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ПроцентГарантийныхУдержанийПоРаботам.ТекущиеДанные.Работа = ВыбранноеЗначение;
	
КонецПроцедуры   

&НаСервере
Функция ВернутьСценарийПланирования(ОбъектСтроительства)
	Если ЗначениеЗаполнено(ОбъектСтроительства) Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ОбъектСтроительства", Объект.ОбъектСтроительства);
		Запрос.Текст ="ВЫБРАТЬ
		|	УСОERP_СценарииПланированияПроектовСтроительства.Ссылка КАК СценарийПланирования
		|ИЗ
		|	Справочник.УСОERP_СценарииПланированияПроектовСтроительства КАК УСОERP_СценарииПланированияПроектовСтроительства
		|ГДЕ
		|	УСОERP_СценарииПланированияПроектовСтроительства.Владелец = &ОбъектСтроительства
		|	И УСОERP_СценарииПланированияПроектовСтроительства.ВидСценария = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыСценариевПланирования.Рабочий)";
		результат = Запрос.Выполнить().Выбрать();
		Если результат.Следующий() Тогда
			Возврат результат.СценарийПланирования;
		КонецЕсли;	
		Возврат Справочники.УСОERP_СценарииПланированияПроектовСтроительства.ПустаяСсылка();
	КонецЕсли;
КонецФункции

&НаКлиенте
