
////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма, РеквизитФормыВЗначение("Объект"));
	
КонецПроцедуры

// Заполнение графика платежей

&НаСервере
Процедура ЗаполнитьДокументПоБТИНаСервере()
	
	Документ = РеквизитФормыВЗначение("Объект");
	Документ.ЗаполнитьДокументПоБТИ();
	ЗначениеВРеквизитФормы(Документ, "Объект");

КонецПроцедуры

// Процедуры расчета

&НаКлиенте
Процедура РассчитатьСуммуРассрочки()
	
	Объект.СуммаРассрочки = Объект.ГрафикПлатежей.Итог("СуммаПроцентаРассрочки");
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДоговора()
	
	Объект.СуммаДоговора = Объект.СуммаДоговораБезРассрочки + Объект.СуммаРассрочки;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДоговораБезРассрочки()
	
	Объект.СуммаДоговораБезРассрочки = Объект.ОбъектыНедвижимости.Итог("Сумма");

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииПартнераСервер()
	
	ПартнерыИКонтрагенты.ЗаполнитьКонтрагентаПартнераПоУмолчанию(Объект.Партнер, Объект.Контрагент);
	
	Если Объект.Договор.Контрагент <> Объект.Контрагент ИЛИ Объект.Договор.Организация <> Объект.Организация Тогда
		Объект.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ДЛЯ УПРАВЛЕНИЯ ВНЕШНИМ ВИДОМ ФОРМЫ

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	
	// Обработчик механизма "Свойства"
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтаФорма, ДополнительныеПараметры);
	
	Если Параметры.Свойство("Основание") Тогда
		Если ТипЗнч(Параметры.Основание) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			Если  НЕ Параметры.Основание.УСОERP_ДоговорДолевогоСтроительства Тогда
				Отказ = Истина;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьДоступностьЭлементовСвязанныхСдоговоромАгента();
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ТекущаяДатаДокумента = Объект.Дата;
	ТекущаяВалюта = Объект.Валюта;
	ТекущийВидЦены = Объект.ВидЦены;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Контрагент = Объект.Контрагент;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды


КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// Обработчик механизма "Свойства"
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтаФорма, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Обработчик механизма "Свойства"
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
	
	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуОбъектыНедвижимостиНаСервере(ВыбранноеЗначение)
	
	НоваяСтрока = Объект.ОбъектыНедвижимости.Добавить();
	НоваяСтрока.ОбъектНедвижимости = ВыбранноеЗначение;
	НоваяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.НДС18;
	НоваяСтрока.СтавкаНДС = Объект.Договор.СтавкаНДС;
	НоваяСтрока.ОбщаяПлощадь = УПН_ОбщиеПроцедуры.ПолучитьОбщуюПлощадьПоОбъектуНедвижимости(ВыбранноеЗначение,?(ЗначениеЗаполнено(Объект.Дата),Объект.Дата,ТекущаяДата()));
	НоваяСтрока.Цена = УПН_ОбщиеПроцедуры.ПолучитьЦенуПоОбъектуНедвижимости(ВыбранноеЗначение,Объект.ВидЦены,Объект.ТипОперации,Объект.Валюта,?(ЗначениеЗаполнено(Объект.Дата),Объект.Дата,ТекущаяДата()));
	НоваяСтрока.Сумма = НоваяСтрока.ОбщаяПлощадь*НоваяСтрока.Цена;
	НоваяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(НоваяСтрока.Сумма, НоваяСтрока.СтавкаНДС,Объект.ВидЦены.ЦенаВключаетНДС);
	
КонецПроцедуры

