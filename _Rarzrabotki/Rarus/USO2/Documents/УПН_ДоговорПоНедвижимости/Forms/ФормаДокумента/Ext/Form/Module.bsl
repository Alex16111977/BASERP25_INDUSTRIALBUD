&НаКлиенте
Процедура ОбъектыНедвижимостиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ДобавитьСтрокуОбъектыНедвижимостиНаСервере(ВыбранноеЗначение);
	ПересчитатьИтоговыеСуммыДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыНедвижимостиПриИзменении(Элемент)
	  ПересчитатьИтоговыеСуммыДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтоговыеСуммыДокумента()
	РассчитатьСуммуДоговораБезРассрочки();
	РассчитатьСуммуРассрочки();
	РассчитатьСуммуДоговора();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьГрафикПлатежей(Команда)
	Если Объект.ГрафикПлатежей.Количество()>0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ОчиститьГрафикПлатежейИЗаполнить",ЭтотОбъект),"Табличная часть графика платежей будет очищена, продолжить?",РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьГрафикПлатежейКлиент();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьГрафикПлатежейИЗаполнить(РезультатВопроса,ДополнительныеПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Объект.ГрафикПлатежей.Очистить();
		ЗаполнитьГрафикПлатежейКлиент();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьГрафикПлатежейКлиент() 
	Если Объект.КоличествоПлатежей=0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Поле = "Объект.КоличествоПлатежей";
		Сообщение.Текст = "Укажите количество платежей!";
		Сообщение.Сообщить();
		Возврат;	
	КонецЕсли;
	СуммаРазовогоПлатежа = Окр(Объект.СуммаДоговораБезРассрочки/Объект.КоличествоПлатежей,0);
	УчтеннаяСумма = 0;
	ОстатокВыплат = Объект.СуммаДоговораБезРассрочки;
	Для Смещение = 0 По Объект.КоличествоПлатежей-1 Цикл
		 НоваяСтрока = Объект.ГрафикПлатежей.Добавить();
		 НоваяСтрока.ДатаПлатежа = БюджетированиеКлиентСервер.ДобавитьИнтервал(Объект.ДатаПервоначальногоПлатежа, Объект.ПериодичностьОплаты, Смещение);
		 День = ДеньНедели(НоваяСтрока.ДатаПлатежа);
		 Если День>=6 Тогда
			НоваяСтрока.ДатаПлатежа = БюджетированиеКлиентСервер.ДобавитьИнтервал(НоваяСтрока.ДатаПлатежа, ПредопределенноеЗначение("Перечисление.Периодичность.День"), 8-День); 
		 КонецЕсли;
		 НоваяСтрока.СуммаВыплатыБезРассрочки = ?(Смещение=Объект.КоличествоПлатежей-1,Объект.СуммаДоговораБезРассрочки - УчтеннаяСумма,СуммаРазовогоПлатежа);
		 НоваяСтрока.ОстатокВыплат = ОстатокВыплат;
		 НоваяСтрока.СуммаВыплаты = НоваяСтрока.СуммаВыплатыБезРассрочки;
		 ОстатокВыплат = ОстатокВыплат - НоваяСтрока.СуммаВыплаты;
		 УчтеннаяСумма = СуммаРазовогоПлатежа + УчтеннаяСумма;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ГрафикПлатежейПроцентРассрочкиПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ГрафикПлатежей.ТекущиеДанные;
	ТекущаяСтрока.СуммаПроцентаРассрочки = ТекущаяСтрока.ПроцентРассрочки*ТекущаяСтрока.СуммаВыплатыБезРассрочки/100;
	ТекущаяСтрока.СуммаВыплаты = ТекущаяСтрока.СуммаПроцентаРассрочки + ТекущаяСтрока.СуммаВыплатыБезРассрочки;
	ПересчитатьИтоговыеСуммыДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьГрафикПлатежей(Команда)
	ПоказатьВопрос(Новый ОписаниеОповещения("ОчиститьГрафикПлатежейКлиент",ЭтотОбъект),"Очистить график платежей?",РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

