&НаКлиенте
Процедура ПоказанияОбъектАрендыПриИзменении(Элемент) 	
	
	ПоказанияОбъектАрендыПриИзмененииНаСервере(Элементы.Показания.ТекущиеДанные.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаСервере
Процедура ПоказанияОбъектАрендыПриИзмененииНаСервере(ИД) 
	
	ТекСтрока = Объект.Показания.НайтиПоИдентификатору(ИД);
	
	ОбъектАренды = ТекСтрока.ОбъектАренды;
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.АУН_ЗаключениеДоговораАренды") Тогда
		
		СтрокаДокумента = Объект.ДокументОснование.ПостояннаяЧастьАренднойПлаты.Найти(ОбъектАренды,"ОбъектАренды");
		
		Если СтрокаДокумента <> Неопределено Тогда
			
			ТекСтрока.Площадь = СтрокаДокумента.Количество;
			
			Возврат;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.АУН_РегистрацияОбъемовПотребленияУслугПеременнойЧасти") Тогда
		
		СтрокаДокумента = Объект.ДокументОснование.Показания.Найти(ОбъектАренды,"ОбъектАренды");
		Если СтрокаДокумента <> Неопределено Тогда
			ТекСтрока.Площадь = СтрокаДокумента.Площадь;
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	ТекСтрока.Площадь = 0;
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеПериодаПриИзменении(Элемент)
	
	Объект.НачалоПериода = Мин(Объект.НачалоПериода,Объект.ОкончаниеПериода);
	ВидПериодаПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоПериодаПриИзменении(Элемент)
	
	Объект.ОкончаниеПериода = Макс(Объект.НачалоПериода,Объект.ОкончаниеПериода);
	ВидПериодаПриИзменении(Элемент);
	
КонецПроцедуры


#КонецОбласти
