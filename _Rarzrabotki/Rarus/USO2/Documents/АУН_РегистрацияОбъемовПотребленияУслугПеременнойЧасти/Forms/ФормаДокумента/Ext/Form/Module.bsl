&НаКлиенте
Процедура  ПериодНачалоВыбораПродолжение(ДопПараметры,ДанныеВыбора) Экспорт
	
	Если ДопПараметры.НачалоПериода = Дата(1,1,1) Тогда
		ВОзврат;
	КонецЕсли;
	
	Объект.НачалоПериода = ДопПараметры.НачалоПериода;
	Объект.ОкончаниеПериода = ДопПараметры.КонецПериода; 
	УправлениеФормой(ЭтаФорма);

