#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции
	
// Инициализирует новый документ.
//
Процедура ИнициализироватьДокумент()

	Ответственный             = ПараметрыСеанса.ТекущийПользователь;
	Организация               = ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Организация);
	
	//>{УСО 2.0}:{Управление строительным предприятием}{Последов Д.В.}
	Если  ПараметрыОбъектов.Количество()>0 Тогда
		Если ЗначениеЗаполнено(ПараметрыОбъектов[0].ОбъектНедвижимости) Тогда
			ЗапросКРегиструСоответствияДоговоровИДолей = Новый Запрос;
			ЗапросКРегиструСоответствияДоговоровИДолей.Текст = 
			"ВЫБРАТЬ
			|	УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Договор.Организация КАК Организация,
			|	УСОERP_СоответствиеДоговоровИДолейСрезПоследних.Расторгнут
			|ИЗ
			|	РегистрСведений.УСОERP_СоответствиеДоговоровИДолей.СрезПоследних(, Доля = &Доля) КАК УСОERP_СоответствиеДоговоровИДолейСрезПоследних";
			
			ЗапросКРегиструСоответствияДоговоровИДолей.Параметры.Вставить("Доля",ПараметрыОбъектов[0].ОбъектНедвижимости);
			Выборка = ЗапросКРегиструСоответствияДоговоровИДолей.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Если НЕ Выборка.Расторгнут И ЗначениеЗаполнено(Выборка.Организация) Тогда
					Организация = Выборка.Организация;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//<{УСО 2.0}:{Управление строительным предприятием}{Последов Д.В.}
КонецПроцедуры // ИнициализироватьДокумент()

/////////////////////////////////////////////////////////////
// Процедуры проведения

// Процедура делает движения по регистру Квартирограммы и Статусы ОбъектНедвижимости.
//
// Параметры:
//  Нет.
//
Процедура Зарегистрировать()
	
	Если ЭтотОбъект.ВидОперации = Перечисления.УПН_ВидыОперацийРегистрацияПараметровОбъектовНедвижимости.ИзменениеПлощадей Тогда
		НаборЗаписей = ЭтотОбъект.Движения.УПН_ПлощадиОбъектовНедвижимости;
		НаборЗаписей.Записывать = Истина;
		Для Каждого СтрокаТЧ Из ЭтотОбъект.ПараметрыОбъектов Цикл
			НоваяСтрока = НаборЗаписей.Добавить();
			НоваяСтрока.Период = Дата;
			НоваяСтрока.Регистратор = Ссылка;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		КонецЦикла;
			
	Иначе
		
		НаборЗаписей = ЭтотОбъект.Движения.УПН_ПараметрыОбъектовНедвижимостиПоБТИ;
		НаборЗаписей.Записывать = Истина;
		Для Каждого СтрокаТЧ Из ЭтотОбъект.ПараметрыОбъектов Цикл
			НоваяСтрока = НаборЗаписей.Добавить();
			НоваяСтрока.Период = Дата;
			НоваяСтрока.Регистратор = Ссылка;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		КонецЦикла;
		
		Если ОбновитьИнформациюОФактическихПлощадяхОбъектов Тогда
			НаборЗаписей = ЭтотОбъект.Движения.УПН_ПлощадиОбъектовНедвижимости;
			НаборЗаписей.Записывать = Истина;
			Для Каждого СтрокаТЧ Из ЭтотОбъект.ПараметрыОбъектов Цикл
				НоваяСтрока = НаборЗаписей.Добавить();
				НоваяСтрока.Период = Дата;
				НоваяСтрока.Регистратор = Ссылка;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// КОНТРОЛЬ ПРОВЕДЕНИЯ

Процедура СформироватьСписокРегистровДляКонтроля()

	Массив = Новый Массив;

	ДополнительныеСвойства.ДляПроведения.Вставить("РегистрыДляКонтроля", Массив);

КонецПроцедуры // СформироватьСписокРегистровДляКонтроля()

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.АУН_ОбъектыНедвижимости") Тогда
		Здание = ДанныеЗаполнения;
	КонецЕсли;
	
	
	ИнициализироватьДокумент();
	
КонецПроцедуры

// Процедура - обработчик события "ПередЗаписью".
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТЗ ИЗ ПараметрыОбъектов Цикл
		
		Если СтрокаТЗ.ОбщаяПлощадь < СтрокаТЗ.ЖилаяПлощадь Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке № "+СтрокаТЗ.НомерСтроки+" жилая площадь превышает общую",,"ПараметрыОбъектов["+(СтрокаТЗ.НомерСтроки-1)+"].ОбщаяПлощадь",,Отказ);
		КонецЕсли;
		
	КонецЦикла; 	

	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
КонецПроцедуры // ПередЗаписью()

// Процедура - обработчик события "ОбработкаПроведения".
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);

	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

	Зарегистрировать();
	
	СформироватьСписокРегистровДляКонтроля();

	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);

	ПроведениеСерверУТ.ВыполнитьКонтрольРезультатовПроведения(ЭтотОбъект, Отказ);

	ПроведениеСерверУТ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры // ОбработкаПроведения()

// Процедура - обработчик события "ОбработкаУдаленияПроведения".
//
Процедура ОбработкаУдаленияПроведения(Отказ)

	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);

	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

	СформироватьСписокРегистровДляКонтроля();

	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);

	ПроведениеСерверУТ.ВыполнитьКонтрольРезультатовПроведения(ЭтотОбъект, Отказ);

	ПроведениеСерверУТ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры // ОбработкаУдаленияПроведения()

#КонецОбласти

#КонецЕсли
