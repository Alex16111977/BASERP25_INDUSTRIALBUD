	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	
	ЗаполнитьДанныеПоБТИ();
	
		// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	
КонецПроцедуры

// Процедура - обработчик события "ПриОткрытии" формы
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Установить видимость реквизитов и заголовков колонок.
	УстановитьВидимостьНаКлиенте();
	
КонецПроцедуры // ПриОткрытии()

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ЗаполнитьДанныеПоБТИ();
	ОповеститьОЗаписиНового(Объект.Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекущимиДанными(Команда)
	
	Если Объект.ПараметрыОбъектов.Количество() > 0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьТекущимиДаннымиЗавершение", ЭтотОбъект), "Табличная часть будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
        Возврат;
	КонецЕсли;
	
	ЗаполнитьТекущимиДаннымиФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекущимиДаннымиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
    
    ЗаполнитьТекущимиДаннымиФрагмент();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекущимиДаннымиФрагмент()
    
    Перем Отказ;
    
    Отказ = Ложь;
    
    Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
        Отказ = Истина;
        Сообщить("Необходимо заполнить реквизит ""Организация""!", СтатусСообщения.Важное);
    КонецЕсли;
    
    Если Отказ Тогда
        Возврат;
    КонецЕсли;
    
    ЗаполнитьТекущимиДаннымиНаСервере();
	
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	ЗаполнитьДанныеПоБТИ();
	УстановитьВидимостьНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыОбъектовОбъектНедвижимостиПриИзменении(Элемент)
	
	НомерСтроки = Элементы.ПараметрыОбъектов.ТекущиеДанные.НомерСтроки;
	ЗаполнитьДанныеПоБТИВСтроке(НомерСтроки);
	Элементы.ПараметрыОбъектов.ТекущиеДанные.ОбщаяПлощадь = Элементы.ПараметрыОбъектов.ТекущиеДанные.ОбщаяПлощадьДоБТИ;
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыОбъектовОбщаяПлощадьПриИзменении(Элемент)
	
	//НомерСтроки = Элементы.ПараметрыОбъектов.ТекущиеДанные.НомерСтроки;
	//ЗаполнитьДанныеПоБТИВСтроке(НомерСтроки);
	
	ТекСтрока = Элементы.ПараметрыОбъектов.ТекущиеДанные;
	ТекСтрока.Отклонение = ТекСтрока.ОбщаяПлощадь - ТекСтрока.ОбщаяПлощадьДоБТИ;
	
КонецПроцедуры

