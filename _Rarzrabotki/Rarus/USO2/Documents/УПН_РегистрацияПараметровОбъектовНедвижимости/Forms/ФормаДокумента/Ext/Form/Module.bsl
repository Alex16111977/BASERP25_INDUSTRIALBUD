
#Область Общее

&НаСервере
Функция ЭтоОперацияИзменениеПлощадей()
	
	Возврат (Объект.ВидОперации = Перечисления.УПН_ВидыОперацийРегистрацияПараметровОбъектовНедвижимости.ИзменениеПлощадей);
	
КонецФункции

&НаКлиенте
Функция ЭтоЧисло(знач ЧислоСтрока)
	
	Если СтрЧислоВхождений(ЧислоСтрока, ".") + СтрЧислоВхождений(ЧислоСтрока, ",") > 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЧислоСтрока = СтрЗаменить(ЧислоСтрока, ",", "");
	ЧислоСтрока = СтрЗаменить(ЧислоСтрока, ".", "");
	
	Результат = Истина;
	Для Сч = 1 По СтрДлина(ЧислоСтрока) Цикл
		Если Найти("0123456789", Сред(ЧислоСтрока, Сч, 1)) = 0 Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеПоБТИВСтроке(СтрокаТаб)
	
	Если ТипЗнч(СтрокаТаб) = Тип("Число") Тогда
		СтрокаТЧ = Объект.ПараметрыОбъектов[СтрокаТаб - 1];
	Иначе
		СтрокаТЧ = СтрокаТаб;
	КонецЕсли;
	
	//СтрокаТЧ.ОбщаяПлощадь = 0;
	СтрокаТЧ.ОбщаяПлощадьДоБТИ = 0;
	//СтрокаТЧ.ЖилаяПлощадь = 0;
	//СтрокаТЧ.КоличествоЖилыхКомнат = 0;  
	
	Запрос = Новый Запрос;
	
	Дата = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
	
	Запрос.УстановитьПараметр("Период", ?(ЗначениеЗаполнено(Объект.Ссылка), Дата - 24*60*60, Дата));
	Запрос.УстановитьПараметр("ОбъектНедвижимости", СтрокаТЧ.ОбъектНедвижимости);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПлощадиОбъектовНедвижимости.ОбщаяПлощадь
	|ИЗ
	|	РегистрСведений.УПН_ПлощадиОбъектовНедвижимости.СрезПоследних(&Период, ОбъектНедвижимости = &ОбъектНедвижимости) КАК ПлощадиОбъектовНедвижимости";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		//СтрокаТЧ.ОбщаяПлощадь       = Выборка.ОбщаяПлощадь;
		СтрокаТЧ.ОбщаяПлощадьДоБТИ = Выборка.ОбщаяПлощадь;
		
	КонецЕсли;
	
	СтрокаТЧ.Отклонение = СтрокаТЧ.ОбщаяПлощадь - СтрокаТЧ.ОбщаяПлощадьДоБТИ;		
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоБТИ()
	
	Если Объект.ВидОперации = Перечисления.УПН_ВидыОперацийРегистрацияПараметровОбъектовНедвижимости.ТехническаяИнвентаризация Тогда
		Для Каждого СтрокаТЧ Из Объект.ПараметрыОбъектов Цикл
			ЗаполнитьДанныеПоБТИВСтроке(СтрокаТЧ);
		КонецЦикла;                        	
	КонецЕсли;  	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекущимиДаннымиНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Здание", Объект.Здание);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОбъектыНедвижимости.Ссылка КАК ОбъектНедвижимости,
	|	ПлощадиОбъектовНедвижимости.ОбщаяПлощадь КАК ОбщаяПлощадь,
	|	ПлощадиОбъектовНедвижимости.ЖилаяПлощадь КАК ЖилаяПлощадь,
	|	ПлощадиОбъектовНедвижимости.КоличествоЖилыхКомнат КАК КоличествоЖилыхКомнат
	|ИЗ
	|	Справочник.АУН_ОбъектыНедвижимости КАК ОбъектыНедвижимости
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УПН_ПлощадиОбъектовНедвижимости.СрезПоследних КАК ПлощадиОбъектовНедвижимости
	|		ПО (ПлощадиОбъектовНедвижимости.ОбъектНедвижимости = ОбъектыНедвижимости.Ссылка)
	|ГДЕ
	|	(ОбъектыНедвижимости.ПринадлежитОбъекту = &Здание
	|			ИЛИ ОбъектыНедвижимости.Ссылка = &Здание)
	|	И НЕ ОбъектыНедвижимости.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПлощадиОбъектовНедвижимости.ОбъектНедвижимости";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Объект.ПараметрыОбъектов.Очистить();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Количество() > 1 И Выборка.ОбъектНедвижимости = Объект.Здание Тогда
			Продолжить;				
		КонецЕсли;
		НоваяСтрока = Объект.ПараметрыОбъектов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		ЗаполнитьДанныеПоБТИВСтроке(НоваяСтрока);
		НоваяСтрока.ОбщаяПлощадь = НоваяСтрока.ОбщаяПлощадьДоБТИ;
	КонецЦикла;
			
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьМодифицированностьВФорме(Знач Оповещение)
	
	Результат = Ложь;
	
	Если ЭтаФорма.Модифицированность ИЛИ Не Объект.Проведен Тогда
		
		Если ЭтаФорма.Модифицированность Тогда
			Текст = "Документ изменен. Для формирования доп. соглашения его необходимо записать и провести.
			|Записать и провести?";
		Иначе
			Текст = "Документ не проведен. Для формирования доп. соглашения его необходимо провести.
			|Провести?";
		КонецЕсли;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПроверитьМодифицированностьВФормеВопросЗавершение", ЭтотОбъект, Новый Структура("Оповещение, Результат", Оповещение, Результат)), Текст, РежимДиалогаВопрос.ОКОтмена,, КодВозвратаДиалога.Отмена, "Документ изменен");
        Возврат;
		
	Иначе
		Результат = Истина;
	КонецЕсли;
	
	ПроверитьМодифицированностьВФормеФрагмент(Оповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьМодифицированностьВФормеВопросЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Оповещение = ДополнительныеПараметры.Оповещение;
    Результат = ДополнительныеПараметры.Результат;
    
    Если РезультатВопроса = КодВозвратаДиалога.ОК Тогда
        
        Попытка
            
            Отказ = Не ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
            
        Исключение
            
            ПоказатьПредупреждение(Новый ОписаниеОповещения("ПроверитьМодифицированностьВФормеЗавершение", ЭтотОбъект, Новый Структура("Оповещение, Результат", Оповещение, Результат)), "Операция не выполнена!");
            Возврат;
            
        КонецПопытки;
        
        Если Отказ Тогда
            ВыполнитьОбработкуОповещения(Оповещение, Результат = Истина);
            Возврат;
        КонецЕсли;
        
        Результат = Истина;
        
    КонецЕсли;
    
    ПроверитьМодифицированностьВФормеФрагмент(Оповещение, Результат);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьМодифицированностьВФормеФрагмент(Знач Оповещение, Знач Результат)
    
    ВыполнитьОбработкуОповещения(Оповещение, Результат);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьМодифицированностьВФормеЗавершение(ДополнительныеПараметры) Экспорт
    
    Оповещение = ДополнительныеПараметры.Оповещение;
    Результат = ДополнительныеПараметры.Результат;
    
    ВыполнитьОбработкуОповещения(Оповещение, Результат = Истина);

КонецПроцедуры

// Процедура устанавливает видимость для тех колонок в табличной части 
// "Товары", видимость которых определяется реквизитами документа.
//
// Параметры:
//  Нет.
//
&НаКлиенте
Процедура УстановитьВидимостьНаКлиенте()

	ОперацияИзменениеПлощадей = ЭтоОперацияИзменениеПлощадей();
	Элементы.НомерТехПаспортаБТИ.Видимость = Не ОперацияИзменениеПлощадей;
	Элементы.ДатаТехПаспортаБТИ.Видимость = Не ОперацияИзменениеПлощадей;
	Элементы.ОбновитьИнформациюОФактическихПлощадяхОбъектов.Видимость = Не ОперацияИзменениеПлощадей;
	Элементы.ПараметрыОбъектовОбщаяПлощадьДоБТИ.Видимость = Не ОперацияИзменениеПлощадей;
	Элементы.ПараметрыОбъектовОтклонение.Видимость = Не ОперацияИзменениеПлощадей;
	
КонецПроцедуры // УстановитьВидимость()

#КонецОбласти

