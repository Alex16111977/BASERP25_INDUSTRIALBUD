
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Переменные

Перем ПометкаУдаленияДо;

#КонецОбласти

#Область События

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка  Тогда
		Возврат;
	КонецЕсли;
	
	Архив = (Ссылка.Статус = Перечисления.СМ_СтатусыСметныхДокументов.Архив И Не Пользователи.РолиДоступны("СМ_АдминистраторСмета, ПолныеПрава",,Ложь));
	Если Архив Тогда
		Отказ = Истина;
	КонецЕсли;

	ПометкаУдаленияДо = Ссылка.ПометкаУдаления;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка  Тогда
		Возврат;
	КонецЕсли;

	// Удаление подчиненных документов по ТЧ сметы.
	Если ЭтотОбъект.ПометкаУдаления <> ПометкаУдаленияДо Тогда
		
		Если ЭтотОбъект.ПометкаУдаления <> ПометкаУдаленияДо Тогда
			// Устанавливаем пометку удаления
			Если ЭтотОбъект.ПометкаУдаления Тогда
				СнятиеПометки = Ложь;
			// Снимаем пометку удаления	
			Иначе
				СнятиеПометки = Истина;
			КонецЕсли;
		КонецЕсли;
		
		ОчищатьТЧСметы = Ложь;
		Для Каждого ТекСтрока Из ЭтотОбъект.ЛокальныеСметы Цикл
			Если ЗначениеЗаполнено(ТекСтрока.ЛокальнаяСмета.ИДРодителя) Тогда
				СМ_СметаВызовСервера.УстановитьСнятьПометкуУдаленияПоТЧСметы(ТекСтрока.ЛокальнаяСмета,СнятиеПометки);
			Иначе
				ОчищатьТЧСметы = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если ОчищатьТЧСметы Тогда 
			ЭтотОбъект.ЛокальныеСметы.Очистить();
		КонецЕсли;
  		
	КонецЕсли;
	
	// Проверка соответствия организаций в сметах
	ОшибкиЗаполнения = Новый Массив;
	Для Каждого ТекСтрока Из ЭтотОбъект.ЛокальныеСметы Цикл
		Если ТекСтрока.ЛокальнаяСмета.Организация <> ЭтотОбъект.Организация Тогда
			ОшибкиЗаполнения.Добавить("В локальной смете: " + ТекСтрока.ЛокальнаяСмета.Наименование + " - неправильно заполнена организация."); 	
		КонецЕсли;
	КонецЦикла;
	
	// Вывод информации об ошибках заполнения организации в сметах
	Если ОшибкиЗаполнения.Количество() > 0 Тогда
		ТекстОшибки = "";
		Для Каждого ТекОшибка Из ОшибкиЗаполнения Цикл
			ТекстОшибки = ТекстОшибки + ТекОшибка + Символы.ПС;
		КонецЦикла;
	    Сообщение = Новый СообщениеПользователю();
	    Сообщение.Текст = ТекстОшибки;
	    Сообщение.Сообщить();
		Отказ = Истина;	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
