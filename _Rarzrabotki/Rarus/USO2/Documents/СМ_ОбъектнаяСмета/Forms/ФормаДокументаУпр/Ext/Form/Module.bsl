&НаСервере
Процедура ОчиститьИдРодителяЛС(ТекЛС = Неопределено)
	
	ПустаяСсылка = Документы.СМ_ОбъектнаяСмета.ПустаяСсылка();
	Если ТипЗнч(ТекЛС) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		Если ТекЛС.ИдРодителя <> ПустаяСсылка Тогда
			Попытка 
				ТекОбъект 				= ТекЛС.ПолучитьОбъект();
				ТекОбъект.ИдРодителя 	= ПустаяСсылка;
				ТекОбъект.Записать();
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Ошибка изменения объекта %1'"), ТекЛС));
			КонецПопытки;
		КонецЕсли;
	Иначе
		Для Каждого ТекСтрока Из Объект.ЛокальныеСметы Цикл
			Если ТекСтрока.ЛокальнаяСмета.ИдРодителя <> ПустаяСсылка Тогда
				Попытка 
					ТекОбъект 				= ТекСтрока.ЛокальнаяСмета.ПолучитьОбъект();
					ТекОбъект.ИдРодителя 	= ПустаяСсылка;
					ТекОбъект.Записать();
				Исключение
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Ошибка изменения объекта %1'"), ТекСтрока.ЛокальнаяСмета));
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

	
&НаКлиенте
Процедура ОбновитьДеревоОС(СохраненнаяСтрока = Неопределено) 

	ТекДанные = Элементы.ДеревоОС.ТекущиеДанные;
	СтрокаДерева = Неопределено;
	СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(СтрокаДерева, ТекДанные, Элементы.ДеревоОС, ДеревоОС.ПолучитьЭлементы());
	Если СохраненнаяСтрока <> Неопределено Тогда
		СтрокаДерева.ТекущийЭлемент = СохраненнаяСтрока;
	КонецЕсли;
 	ОбновитьДеревоОСНаСервере();
	СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.ДеревоОС, ДеревоОС.ПолучитьЭлементы(), ДеревоОС, СтрокаДерева);
	                      	
КонецПроцедуры	
	
