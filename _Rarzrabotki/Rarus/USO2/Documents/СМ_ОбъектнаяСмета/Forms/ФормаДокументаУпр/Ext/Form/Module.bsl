	ОбновитьДеревоОС();
	ВывестиСоставОС();
	
КонецПроцедуры


&НаКлиенте
Процедура ДеревоОСРасчетПриИзменении(Элемент)

	ТекДанные 	= Элементы.ДеревоОС.ТекущиеДанные;
	ДеревоОСРасчетПриИзмененииНаСервере(ТекДанные.Элемент,ТекДанные.Расчет);
	
КонецПроцедуры

&НаСервере
Процедура ДеревоОСРасчетПриИзмененииНаСервере(ТекЭлемент,ТекРасчет)
	
	СтруктураОтбора = Новый Структура;
	
	Если ТипЗнч(ТекЭлемент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		СтруктураОтбора.Вставить("ЛокальнаяСмета",ТекЭлемент);	
		МассивСтрок = Объект.ЛокальныеСметы.НайтиСтроки(СтруктураОтбора);
	ИначеЕсли ТипЗнч(ТекЭлемент) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда	
		СтруктураОтбора.Вставить("ЛимитированнаяЗатрата",ТекЭлемент);	
		МассивСтрок = Объект.ЛимитированныеЗатраты.НайтиСтроки(СтруктураОтбора);
	Иначе
		Возврат;
	КонецЕсли;	
	
	Если МассивСтрок.Количество() > 0 Тогда
		ТекСтрока 			= МассивСтрок[0];	
		ТекСтрока.Расчет 	= ТекРасчет;
	КонецЕсли;	
	
КонецПроцедуры

// ДокторСофт
&НаКлиенте
&НаКлиенте
Процедура Мобильное(Команда)
	Если Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Документ не записан в базе!'"),СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;
	СписокУзлов = ПолучитьУзлыПоУмолчанию();
	Если СписокУзлов = Неопределено Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораУзлов", ЭтаФорма);
		ОткрытьФорму("Обработка.СМ_ВыборУзловМП.Форма.Форма",,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли СписокУзлов.Количество() = 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораУзлов", ЭтаФорма);
		ОткрытьФорму("Обработка.СМ_ВыборУзловМП.Форма.Форма",,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		МобильноеНаСервере(СписокУзлов);
		ВидимостьМобильнойКнопки();
	КонецЕсли;		

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораУзлов(Результат, СтруктураПараметров) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МассивСтруктур = Новый Массив;
	МассивСтруктур.Добавить(ОписаниеНастройки(
	"НастройкиПользователяСмета",
	"ОсновнойУзелМП",
	Результат));
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранитьМассивИОбновитьПовторноИспользуемыеЗначения(МассивСтруктур);
	
	МобильноеНаСервере(Результат);
	ВидимостьМобильнойКнопки();

КонецПроцедуры

Функция ОписаниеНастройки(Объект, Настойка, Значение)
	
	Элемент = Новый Структура;
	Элемент.Вставить("Объект", Объект);
	Элемент.Вставить("Настройка", Настойка);
	Элемент.Вставить("Значение", Значение);
	
	Возврат Элемент;
	
КонецФункции


&НаСервере
Функция ПолучитьУзлыПоУмолчанию()
    СписокУзлов = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнойУзелМП");
	Возврат СписокУзлов;
КонецФункции

&НаСервере
Процедура МобильноеНаСервере(СписокУзлов)
	Для каждого ВыбУзел Из СписокУзлов Цикл
		Если ВыбУзел.Значение.Ссылка =  ПланыОбмена.СМ_ОбменСметаМобильное.ЭтотУзел() ИЛИ ВыбУзел.Значение.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		НайденаЛС = ВыбУзел.Значение.ДокументыДляОбмена.Найти(Объект.Ссылка,"ДокументОтбор");
		Если НайденаЛС = Неопределено Тогда
			Узел = ВыбУзел.Значение.ПолучитьОбъект();
			Стр = Узел.ДокументыДляОбмена.Добавить();
			Стр.ДокументОтбор = Объект.Ссылка;
			Для каждого Смета Из Объект.ЛокальныеСметы Цикл
				Стр = Узел.ДокументыДляОбмена.Добавить();
				Стр.ДокументОтбор = Смета.ЛокальнаяСмета;
			КонецЦикла;
			Узел.Записать();
		КонецЕсли;
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СМ_ОбменСметаМобильноеДокументыДляОбмена.Ссылка
	|ИЗ
	|	ПланОбмена.СМ_ОбменСметаМобильное.ДокументыДляОбмена КАК СМ_ОбменСметаМобильноеДокументыДляОбмена
	|ГДЕ
	|	СМ_ОбменСметаМобильноеДокументыДляОбмена.ДокументОтбор = &Док";
	Запрос.УстановитьПараметр("Док",Объект.Ссылка);
	МассивУзлов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов,Объект.Ссылка);
	
	Для каждого Смета Из Объект.ЛокальныеСметы Цикл 
		ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов,Смета.ЛокальнаяСмета);
		СМ_ОбменСМобильнымСервер.РегистрацияПозицийРазделов(МассивУзлов,Смета.ЛокальнаяСмета)
	КонецЦикла;
	
КонецПроцедуры
&НаСервере
Функция ЕстьУзлы()
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	СМ_ОбменСметаМобильноеДокументыДляОбмена.Ссылка
		|ИЗ
		|	ПланОбмена.СМ_ОбменСметаМобильное.ДокументыДляОбмена КАК СМ_ОбменСметаМобильноеДокументыДляОбмена
		|ГДЕ
		|	СМ_ОбменСметаМобильноеДокументыДляОбмена.ДокументОтбор = &Док";
		Запрос.УстановитьПараметр("Док",Объект.Ссылка);
		Результат = Запрос.Выполнить();
		Возврат Результат.Пустой();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ВидимостьМобильнойКнопки() 
	ЕстьУзлы = ЕстьУзлы();
    Элементы.Мобильное.Видимость =  ?(ЕстьУзлы = Неопределено,Ложь,ЕстьУзлы);
	Элементы.УбратьМобильное.Видимость = ?(ЕстьУзлы = Неопределено,Ложь,Не ЕстьУзлы);
КонецПроцедуры

&НаКлиенте
Процедура УбратьМобильное(Команда)
	УбратьМобильноеНаСервере();
	ВидимостьМобильнойКнопки();
КонецПроцедуры

&НаСервере
Процедура УбратьМобильноеНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СМ_ОбменСметаМобильноеДокументыДляОбмена.Ссылка
	|ИЗ
	|	ПланОбмена.СМ_ОбменСметаМобильное.ДокументыДляОбмена КАК СМ_ОбменСметаМобильноеДокументыДляОбмена
	|ГДЕ
	|	СМ_ОбменСметаМобильноеДокументыДляОбмена.ДокументОтбор = &Док";
	Запрос.УстановитьПараметр("Док",Объект.Ссылка);
	МассивУзлов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	ПланыОбмена.УдалитьРегистрациюИзменений(МассивУзлов,Объект.Ссылка);
	Для каждого эл Из МассивУзлов Цикл
		Узел = эл.ПолучитьОбъект();
		НайденаЛС = Узел.ДокументыДляОбмена.Найти(Объект.Ссылка,"ДокументОтбор");
		Если Не НайденаЛС = Неопределено Тогда
			Узел.ДокументыДляОбмена.Удалить(НайденаЛС);
			Узел.Записать();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область События

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	Если Объект.БазисныеЦены Тогда
		ЭтаФорма.ТипЦен	= 1;
	Иначе
		ЭтаФорма.ТипЦен	= 2;
	КонецЕсли;

	Элементы.СоставСметы.Видимость 	= Ложь;
	ЭтаФорма.СкрытьТабДок 			= Истина;
	
	ТолькоПросмотрФормы = СМ_СметаВызовСервера.РольТолькоПросмотр();
	Архив = (Объект.Статус = Перечисления.СМ_СтатусыСметныхДокументов.Архив);
	Админ = Пользователи.РолиДоступны("СМ_АдминистраторСмета, ПолныеПрава",,Ложь);
	ТолькоПросмотрФормы = ?(Архив,Архив,ТолькоПросмотрФормы);

	ОбновитьДеревоОСНаСервере(); 
	ВывестиСоставОС();
	
	// Заполнить настройки пользователя по умолчанию
	Если Объект.Ссылка.Пустая() Тогда
		СМ_СметаВызовСервера.ЗаполнитьНастройкиПользователяПоУмолчанию(Объект);
		Объект.ПроводитьОкругление 	= Истина;
		Объект.ФорматОкругления 	= 3;
	КонецЕсли;
	
	// Вывод информации о сводной смете
	СтрокаСС = СМ_СметаВызовСервера.ПолучитьТекстИнформацииОСводнойСмете(Объект.Ссылка);
	Если ЗначениеЗаполнено(СтрокаСС) Тогда 
		Элементы.СтрокаСводнаяСмета.Видимость = Истина;
		Элементы.СтрокаСводнаяСмета.Заголовок = СтрокаСС;
	Иначе
		Элементы.СтрокаСводнаяСмета.Видимость = Ложь;
	КонецЕсли;
	
	Если Параметры.Свойство("Стройка") Тогда
		Объект.Стройка = Параметры.Стройка;
		СМ_СметаВызовСервера.ЗаполнитьНаименованиеНомерИзШаблона(Объект, Элементы.Наименование, "НумераторОбъектныхСмет");
	КонецЕсли;
	
	Если Параметры.Свойство("ЛимЗатрата") Тогда
		Стр = Объект.ЛимитированныеЗатраты.Выгрузить().Найти(Параметры.ЛимЗатрата,"ЛимитированнаяЗатрата");
		Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаЛимитированныеЗатраты;
		Элементы.ЛимитированныеЗатраты.ТекущаяСтрока = Стр.НомерСтроки-1;
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// Оповещение открытых форм об изменении
	// ОповещаемСС.
	СписокСвязанных = ПолучитьСС(Объект.Ссылка);
	Если СписокСвязанных.Количество()>0 Тогда
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("СписокСмет",СписокСвязанных);
		Оповестить("ОбновитьДеревоССОС",СтруктураПараметров);
	КонецЕсли;
	// Например обработки "Дерево смет"
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Стройка",Объект.Стройка);
	СтруктураПараметров.Вставить("Смета",Объект.Ссылка);
	Оповестить("ОбновитьДеревоСмет",СтруктураПараметров);
	ОбновитьДеревоОС();
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Заполнение реквизита "ИдРодителя" для ЛС из табличной части "Локальные сметы"
	Для Каждого ТекСтрока Из Объект.ЛокальныеСметы Цикл
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ЛокальнаяСмета.ИдРодителя) Тогда
			Попытка 
				ТекОбъект 				= ТекСтрока.ЛокальнаяСмета.ПолучитьОбъект();
				ТекОбъект.ИдРодителя 	= Объект.Ссылка;
				ТекОбъект.Записать();
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Ошибка изменения объекта %1'"), ТекСтрока.ЛокальнаяСмета));
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Документы.СМ_ОбъектнаяСмета.Перерасчет(Объект.Ссылка);

КонецПроцедуры

