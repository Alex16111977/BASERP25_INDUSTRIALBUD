&НаКлиенте
Процедура ДеревоОСВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ДеревоОС.ТекущиеДанные;
	ТекЭлемент = ТекДанные.Элемент;
	Если ТипЗнч(ТекЭлемент) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
		СтандартнаяОбработка = Ложь;
	    Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаЛимитированныеЗатраты;
		ТекИндекс = ПолучитьИндексТекСтроки(ТекЭлемент);
		Элементы.ЛимитированныеЗатраты.ТекущаяСтрока = ТекИндекс;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИндексТекСтроки(ТекСсылка)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	НайденнаяСтрока = ТекОбъект.ЛимитированныеЗатраты.Найти(ТекСсылка,"ЛимитированнаяЗатрата");
	Если НайденнаяСтрока = Неопределено Тогда
		ТекИндекс = 0;		
	Иначе
		ТекИндекс = ТекОбъект.ЛимитированныеЗатраты.Индекс(НайденнаяСтрока);
	КонецЕсли;
	
	Возврат ТекИндекс;
	
КонецФункции

