&НаКлиенте
Процедура ДобавитьСтроку(Команда)
	ТекДанные = Элементы.ДеревоОС.ТекущиеДанные;
	Если Не ТипЗнч(ТекДанные.Элемент) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		Состояние(НСтр("ru='Необходимо выбрать объектную смету.'"),100,"",БиблиотекаКартинок.Предупреждение32);
		Возврат;
	КонецЕсли;
	Элементы.ДеревоОС.ДобавитьСтроку();
	НовСтрока = Элементы.ДеревоОС.ТекущиеДанные;
	НовСтрока.Расчет = Истина;
	ТекСч = Объект.ЛокальныеСметы.Количество()+1;
	НовСтрока.НомерПП				= ТекСч;
	НовСтрока.НоваяЛС               = Истина;
	НовСтрока.СметаРассчитана = Истина;
	Элементы.ДеревоОС.ТекущийЭлемент = Элементы.ДеревоОСГруппа1.ПодчиненныеЭлементы.ДеревоОСНаимРаботИЗатрат;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоОСПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ТекДанные = Элементы.ДеревоОС.ТекущиеДанные;
	Если ТекДанные.НоваяЛС Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтаФорма, Новый Структура("ТекДанные",ТекДанные));
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Сохранить локальную смету?';"+ " en = 'Do you want to continue?'"), Режим, 0);
	Иначе
		Рассчитана = СметаРассчитана(ТекДанные.Элемент);
		Если Рассчитана Тогда
			
			Если Объект.БазисныеЦены Тогда
				ИмяРесурса = "ПрямЗатраты,ОснЗарплата,Смета,Итог";
			Иначе
				ИмяРесурса = "ТекПрямЗатраты,ТекОснЗарплата,Смета,Итог";
			КонецЕсли;

			ДанныеДляЗаписи = Новый Структура(ИмяРесурса,ТекДанные.СтроительныеРаботы*1000,ТекДанные.ОплатаТруда*1000,ТекДанные.Элемент,ПредопределенноеЗначение("Справочник.СМ_ИтогиСметыПоВидамРабот.СтроитРаб"));
			Отбор = Новый Структура("Смета,Итог",ТекДанные.Элемент,ПредопределенноеЗначение("Справочник.СМ_ИтогиСметыПоВидамРабот.СтроитРаб"));
			СМ_СметаВызовСервера.ДополнитьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоВидамРабот", Отбор, ДанныеДляЗаписи);
			
			Если Объект.БазисныеЦены Тогда
				ИмяРесурса = "ПрямЗатраты,Смета,Итог";
			Иначе
				ИмяРесурса = "ТекПрямЗатраты,Смета,Итог";
			КонецЕсли;
			
			ДанныеДляЗаписи = Новый Структура(ИмяРесурса,ТекДанные.МонтажныеРаботы*1000,ТекДанные.Элемент,ПредопределенноеЗначение("Справочник.СМ_ИтогиСметыПоВидамРабот.МонтажнРаб"));
			Отбор = Новый Структура("Смета,Итог",ТекДанные.Элемент,ПредопределенноеЗначение("Справочник.СМ_ИтогиСметыПоВидамРабот.МонтажнРаб"));
			СМ_СметаВызовСервера.ДополнитьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоВидамРабот", Отбор, ДанныеДляЗаписи);
			
			
			ДанныеДляЗаписи = Новый Структура(ИмяРесурса,ТекДанные.Прочие*1000,ТекДанные.Элемент,ПредопределенноеЗначение("Справочник.СМ_ИтогиСметыПоВидамРабот.ПрочРаб"));
			Отбор = Новый Структура("Смета,Итог",ТекДанные.Элемент,ПредопределенноеЗначение("Справочник.СМ_ИтогиСметыПоВидамРабот.ПрочРаб"));
			СМ_СметаВызовСервера.ДополнитьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоВидамРабот", Отбор, ДанныеДляЗаписи);
			
			Если Объект.БазисныеЦены Тогда
				ИмяРесурса = "Оборуд,Смета,Итог";
			Иначе
				ИмяРесурса = "ТекОборуд,Смета,Итог";
			КонецЕсли;
			
			ДанныеДляЗаписи = Новый Структура(ИмяРесурса,ТекДанные.Оборудование*1000,ТекДанные.Элемент,ПредопределенноеЗначение("Справочник.СМ_ИтогиСметыПоВидамРабот.Оборуд"));
			Отбор = Новый Структура("Смета,Итог",ТекДанные.Элемент,ПредопределенноеЗначение("Справочник.СМ_ИтогиСметыПоВидамРабот.Оборуд"));
			СМ_СметаВызовСервера.ДополнитьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоВидамРабот", Отбор, ДанныеДляЗаписи);

		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СметаРассчитана(СметаЭл)
	Если ТипЗнч(СметаЭл) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета")
		И СметаЭл.СметаРассчитана Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ТекДанные = Параметры.ТекДанные;
		НоваяЛС = СМ_СметаВызовСервера.СоздатьНовуюЛокальнуюСметуРассчитанную(ТекДанные.НаимРаботИЗатрат,Объект.Ссылка,ТекДанные.НомерСметныхРасчетов);
		ТекДанные.НоваяЛС = Ложь;
		НоваяСтрока 					= Объект.ЛокальныеСметы.Добавить();
		НоваяСтрока.ЛокальнаяСмета 		= НоваяЛС;
		НоваяСтрока.КоличествоОбъектов 	= 1;
		НоваяСтрока.НомерПП				= ТекДанные.НомерПП;
		НоваяСтрока.Расчет				= Истина;
		
		Если Объект.БазисныеЦены Тогда
			ИмяРесурса = "ПрямЗатраты,ОснЗарплата,Смета,Итог";
		Иначе
			ИмяРесурса = "ТекПрямЗатраты,ТекОснЗарплата,Смета,Итог";
		КонецЕсли;
		
		ДанныеДляЗаписи = Новый Структура(ИмяРесурса,ТекДанные.СтроительныеРаботы*1000,ТекДанные.ОплатаТруда*1000,НоваяЛС,ПредопределенноеЗначение("Справочник.СМ_ИтогиСметыПоВидамРабот.СтроитРаб"));
		Отбор = Новый Структура("Смета,Итог",НоваяЛС,ПредопределенноеЗначение("Справочник.СМ_ИтогиСметыПоВидамРабот.СтроитРаб"));
		СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоВидамРабот", Отбор, ДанныеДляЗаписи);
		
		Если Объект.БазисныеЦены Тогда
			ИмяРесурса = "ПрямЗатраты,Смета,Итог";
		Иначе
			ИмяРесурса = "ТекПрямЗатраты,Смета,Итог";
		КонецЕсли;
		
		ДанныеДляЗаписи = Новый Структура(ИмяРесурса,ТекДанные.МонтажныеРаботы*1000,НоваяЛС,ПредопределенноеЗначение("Справочник.СМ_ИтогиСметыПоВидамРабот.МонтажнРаб"));
		Отбор = Новый Структура("Смета,Итог",НоваяЛС,ПредопределенноеЗначение("Справочник.СМ_ИтогиСметыПоВидамРабот.МонтажнРаб"));
		СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоВидамРабот", Отбор, ДанныеДляЗаписи);
		
		
		ДанныеДляЗаписи = Новый Структура(ИмяРесурса,ТекДанные.Прочие*1000,НоваяЛС,ПредопределенноеЗначение("Справочник.СМ_ИтогиСметыПоВидамРабот.ПрочРаб"));
		Отбор = Новый Структура("Смета,Итог",НоваяЛС,ПредопределенноеЗначение("Справочник.СМ_ИтогиСметыПоВидамРабот.ПрочРаб"));
		СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоВидамРабот", Отбор, ДанныеДляЗаписи);
		
			Если Объект.БазисныеЦены Тогда
				ИмяРесурса = "Оборуд,Смета,Итог";
			Иначе
				ИмяРесурса = "ТекОборуд,Смета,Итог";
			КонецЕсли;
		
		ДанныеДляЗаписи = Новый Структура(ИмяРесурса,ТекДанные.Оборудование*1000,НоваяЛС,ПредопределенноеЗначение("Справочник.СМ_ИтогиСметыПоВидамРабот.Оборуд"));
		Отбор = Новый Структура("Смета,Итог",НоваяЛС,ПредопределенноеЗначение("Справочник.СМ_ИтогиСметыПоВидамРабот.Оборуд"));
		СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоВидамРабот", Отбор, ДанныеДляЗаписи);


		Записать();
		ОбновитьДеревоОС();
		ВывестиСоставОС();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ОбновитьДеревоССОС" Тогда
		Если Параметр.Свойство("СписокСмет") Тогда
			ИндексСтроки = Параметр.СписокСмет.Найти(Объект.Ссылка);
			Если Не ИндексСтроки = Неопределено Тогда
				ОбновитьДеревоОС();
				// ОповещаемСС.
				СписокСвязанных = ПолучитьСС(Объект.Ссылка);
				Если СписокСвязанных.Количество()>0 Тогда
					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("СписокСмет",СписокСвязанных);
					Оповестить("ОбновитьДеревоССОС",СтруктураПараметров);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьСС(Смета)
	МассивСмет = Новый Массив;
	МассивСмет.Добавить(Смета);
	
	ВключитьОбъекты = Новый Массив;
	ВключитьОбъекты.Добавить(Метаданные.Документы.СМ_СводнаяСмета);
	
	ТабСсылок = НайтиПоСсылкам(МассивСмет, Новый Массив, ВключитьОбъекты);	
	Возврат ТабСсылок.ВыгрузитьКолонку("Данные");
КонецФункции

&НаСервере
Процедура ОбработатьЛимЗатратыСметы(Смета) 
	ИспользоватьЛимЗатратыВсегда = СМ_СметаВызовСервера.ЗначениеОпции("СМ_ИспользоватьЛимитированныеЗатратыПодчиненныхСмет");
	Если Не ИспользоватьЛимЗатратыВсегда Тогда
		Если Смета.ЛимитированныеЗатраты.Количество()>0 Тогда
			ОбСмета = Смета.ПолучитьОбъект();
			ТЗ = ОбСмета.ЛимитированныеЗатраты.Выгрузить();
			ТЗ.ЗаполнитьЗначения(Ложь,"Расчет");
			ОбСмета.ЛимитированныеЗатраты.Загрузить(ТЗ);
			ОбСмета.Записать();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Лимитированные затраты локальной сметы при включении ее в состав объектной сметы при расчете не учитываются.'"));
			// Очищаем движения по локальной смете.
			Отбор = Новый Структура("Смета",Смета);
			СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоГлавам", Отбор, Новый ТаблицаЗначений);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СтрокаСводнаяСметаНажатие(Элемент)
	Если ТипЗнч(Объект.ИДРодителя) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		Пар = Новый Структура("Ключ", Объект.ИДРодителя);
		ОткрытьФорму("Документ.СМ_СводнаяСмета.ФормаОбъекта",Пар,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		СтандартнаяОбработка = Ложь;	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПредупреждениеНаФорме(Текст)
	
	Элементы.ТекстПредупреждения.Видимость 		= Истина;
	Элементы.ТекстПредупреждения.Доступность 	= Истина;
	ТекстПредупреждения = Текст;
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьПредупреждениеНаФорме()
	
	Элементы.ТекстПредупреждения.Видимость 		= Ложь;
	Элементы.ТекстПредупреждения.Доступность 	= Ложь;
	ТекстПредупреждения = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьДоступностьЭлементовНаФорме()
	
	СкрытьПредупреждениеНаФорме();
	Если (Объект.Статус = ПредопределенноеЗначение("Перечисление.СМ_СтатусыСметныхДокументов.Согласован")) или ТолькоПросмотрФормы Тогда
		Если Не ТолькоПросмотрФормы Тогда
			ПоказатьПредупреждениеНаФорме(НСтр("ru='Смета согласована, для изменения смените статус!'"));
		КонецЕсли;
		Для каждого Элем Из ЭтаФорма.Элементы Цикл
			Если ТипЗнч(Элем) = Тип("ДекорацияФормы") ИЛИ ТипЗнч(Элем) = Тип("ДополнениеЭлементаФормы") ИЛИ Элем = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Найти(ВРЕГ(Элем.Имя),"ПЕЧАТ")>0 ИЛИ Элем.Имя = "ФормаЗакрыть" 
				ИЛИ Элем.Имя = "УбратьМобильное" ИЛИ Элем.Имя = "Мобильное"
				ИЛИ Элем.Имя = "ФормаПрисоединенныеФайлы" ИЛИ Элем.Имя = "ФормаЗаписать" Тогда
				Продолжить;
			КонецЕсли;
			Если ТипЗнч(Элем) = Тип("КнопкаФормы") Тогда
				Элем.Доступность = Ложь;
			Иначе
				Элем.ТолькоПросмотр = Истина;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ЭтаФорма.ТолькоПросмотр = Ложь;
		Для каждого Элем Из ЭтаФорма.Элементы Цикл
			Если ТипЗнч(Элем) = Тип("ДекорацияФормы") ИЛИ ТипЗнч(Элем) = Тип("ДополнениеЭлементаФормы") ИЛИ Элем = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Найти(ВРЕГ(Элем.Имя),"ПЕЧАТ")>0 ИЛИ Элем.Имя = "ФормаЗакрыть" 
				ИЛИ Элем.Имя = "УбратьМобильное" ИЛИ Элем.Имя = "Мобильное"
				ИЛИ Элем.Имя = "ФормаПрисоединенныеФайлы" ИЛИ Элем.Имя = "ФормаЗаписать" Тогда
				Продолжить;
			КонецЕсли;
			Если ТипЗнч(Элем) = Тип("КнопкаФормы") Тогда
				Элем.Доступность = Истина;
			Иначе
				Элем.ТолькоПросмотр = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Админ Тогда
		Элементы.Статус.ТолькоПросмотр = Ложь;
		Элементы.ГруппаГлавная.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусПриИзменении(Элемент)
	Если Объект.Статус = ПредопределенноеЗначение("Перечисление.СМ_СтатусыСметныхДокументов.Согласован") И Не Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	КонецЕсли;
	ВидимостьДоступностьЭлементовНаФорме();

КонецПроцедуры

&НаСервере
Процедура ПерерасчетНаСервере()
	Документы.СМ_ОбъектнаяСмета.ПерерасчетПодчиненныхСмет(Объект.Ссылка);
КонецПроцедуры

&НаКлиенте
Процедура Перерасчет(Команда)
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ПерерасчетНаСервере();
КонецПроцедуры

&НаСервере
Процедура НаименованиеОбработкаВыбораНаСервере(ВыбранноеЗначение, СтандартнаяОбработка)
	
	Смета = ДанныеФормыВЗначение(Объект, Тип("ДокументОбъект.СМ_ОбъектнаяСмета"));
	СМ_СметаВызовСервера.ЗаполнитьНомерПоСпискуВыбораШаблона(Смета, ВыбранноеЗначение, СтандартнаяОбработка, "НумераторОбъектныхСмет");
	ЗначениеВДанныеФормы(Смета, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	НаименованиеОбработкаВыбораНаСервере(ВыбранноеЗначение, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура СтройкаПриИзменении(Элемент)
	СМ_СметаВызовСервера.ИзменитьСтройку(Объект.Ссылка,  Объект.Стройка);
КонецПроцедуры

