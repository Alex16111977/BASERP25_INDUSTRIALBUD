Процедура ОбновитьДеревоОСНаСервере() 
	
	ДеревоЗначений = РеквизитФормыВЗначение("ДеревоОС", Тип("ДеревоЗначений"));
	ДеревоЗначений.Строки.Очистить();
	СМ_СметныйСоставВызовСервера.ВывестиДеревоОСПоТаблице(ДеревоЗначений,Объект);
	ЗначениеВРеквизитФормы(ДеревоЗначений,"ДеревоОС");
	
КонецПроцедуры

