#Область ОбработкиНажатия

&НаКлиенте
Процедура ДобавитьЛС(Команда)
	
	// Получаем массив ЛС из ТЧ
	МассивОС = Новый Массив;
	Для Каждого ТекСтрока Из Объект.ЛокальныеСметы Цикл
		МассивОС.Добавить(ТекСтрока.ЛокальнаяСмета);
	КонецЦикла;

	ОтборСмет = Новый Структура("МассивОС,Стройка",МассивОС,Объект.Стройка);
	ОткрытьФорму("Документ.СМ_ЛокальнаяСмета.Форма.ФормаВыбораУпр",ОтборСмет,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ИсточникВыбора) = Тип("УправляемаяФорма") Тогда
		Если ИсточникВыбора.ИмяФормы = "Документ.СМ_ОбъектнаяСмета.Форма.ФормаПодбораЛимитированныхЗатрат" Тогда
			Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
				Если ВыбранноеЗначение.Количество() > 0 Тогда   
					Для Каждого ТекЭлемент Из ВыбранноеЗначение Цикл
						НоваяСтрока = Объект.ЛимитированныеЗатраты.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекЭлемент);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.СМ_ШаблоныЛимитированныхЗатрат.Форма.ФормаВыбора" Тогда
			Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.СМ_ШаблоныЛимитированныхЗатрат") Тогда
				ЗаполнитьТЧСтрокамиШаблонаЛЗ(ВыбранноеЗначение);
			КонецЕсли;
		ИначеЕсли ИсточникВыбора.ИмяФормы = "Документ.СМ_ЛокальнаяСмета.Форма.ФормаВыбораУпр" Тогда	
			ТекСч = Объект.ЛокальныеСметы.Количество();
			Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
				Если ВыбранноеЗначение.Количество() > 0 Тогда   
					Для Каждого ТекЭлемент Из ВыбранноеЗначение Цикл
						ТекСч 							= ТекСч + 1;
						НоваяСтрока 					= Объект.ЛокальныеСметы.Добавить();
						НоваяСтрока.ЛокальнаяСмета 		= ТекЭлемент;
						НоваяСтрока.КоличествоОбъектов 	= 1;
						НоваяСтрока.НомерПП				= ТекСч;
						НоваяСтрока.Расчет				= Истина;
						ОбработатьЛимЗатратыСметы(ТекЭлемент);
					КонецЦикла;
				КонецЕсли;
			Иначе
				Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
					ТекСч 							= ТекСч + 1;
					НоваяСтрока 					= Объект.ЛокальныеСметы.Добавить();
					НоваяСтрока.ЛокальнаяСмета 		= ВыбранноеЗначение;
					НоваяСтрока.КоличествоОбъектов 	= 1;
					НоваяСтрока.НомерПП				= ТекСч;
					НоваяСтрока.Расчет				= Истина;
					ОбработатьЛимЗатратыСметы(ВыбранноеЗначение);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;  
		ЭтаФорма.Модифицированность = Истина;
		ОбновитьДеревоОС(); 
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧСтрокамиШаблонаЛЗ(ВыбранноеЗначение)
	
	ТекОбъект 	= ВыбранноеЗначение.ПолучитьОбъект();
	ТекОбъектОС = РеквизитФормыВЗначение("Объект");
	
	Для Каждого СтрокаЛЗ Из ТекОбъект.ЛимитированныеЗатраты Цикл
		ТекСтрока = ТекОбъектОС.ЛимитированныеЗатраты.Найти(СтрокаЛЗ.ЛимЗатрата); 
		Если ТекСтрока <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока 						= Объект.ЛимитированныеЗатраты.Добавить();
		НоваяСтрока.ЛимитированнаяЗатрата 	= СтрокаЛЗ.ЛимЗатрата;
		НоваяСтрока.Расчет 					= Истина;
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ВывестиСоставОС()
	
	СоставСметы.Очистить();
	
	КолЗнаков = 2;
	Если Объект.ПроводитьОкругление = Истина Тогда
		КолЗнаков = Объект.ФорматОкругления;		
	КонецЕсли;
	
	ТекОбъект 	= РеквизитФормыВЗначение("Объект");
	ТекМакет 	= ТекОбъект.ПолучитьМакет("ПФ_MXL_МакетОС");
	
	МассивЛС 	= ТекОбъект.ЛокальныеСметы.ВыгрузитьКолонку("ЛокальнаяСмета"); 
	ТекОС	 	= Объект.Ссылка;
	
	ВТекущихЦенах = Истина;
	Если Объект.БазисныеЦены Тогда
		ВТекущихЦенах = Ложь;	
	КонецЕсли;
	
	ТабЛС = СМ_СметныйСоставВызовСервера.ПолучитьИтогиПоВидамРабот(ТекОС,МассивЛС,ВТекущихЦенах);
	
	ОбластьШапка 		= ТекМакет.ПолучитьОбласть("ШапкаЛС");
	ОбластьЗаголовокЛС  = ТекМакет.ПолучитьОбласть("ВерхЛС");
	ОбластьСтрокаЛС     = ТекМакет.ПолучитьОбласть("СтрокаЛС");
	ОбластьИтогЛС       = ТекМакет.ПолучитьОбласть("ИтогЛС");
	
	СоставСметы.Вывести(ОбластьШапка);	
	СоставСметы.Вывести(ОбластьЗаголовокЛС);
	
	ТекКартинка = БиблиотекаКартинок.СинхронизацияДанных;
	
	СтруктураИтогов = Новый Структура;
	СтруктураИтогов.Вставить("СтроительныеРаботы",0);
	СтруктураИтогов.Вставить("МонтажныеРаботы",0);
	СтруктураИтогов.Вставить("Оборудование",0);
	СтруктураИтогов.Вставить("Прочие",0);
	СтруктураИтогов.Вставить("ОплатаТруда",0);
	СтруктураИтогов.Вставить("ВсегоПоСтроке",0);
	
	Для Каждого ТекСтрока Из ТабЛС Цикл
		
		ОбластьСтрокаЛС.Параметры.НаименованиеЛокальнойСметы 	= СокрЛП(ТекСтрока.Смета.Наименование); 
		ОбластьСтрокаЛС.Параметры.ТекКартинка 					= ТекКартинка;
		ОбластьСтрокаЛС.Параметры.НомерСметы					= ТекСтрока.Смета.НомерСметы;
		ОбластьСтрокаЛС.Параметры.МонтажныеРаботы 				= Окр(ТекСтрока.МонтажныеРаботы/1000,КолЗнаков);
		ОбластьСтрокаЛС.Параметры.Оборудование          		= Окр(ТекСтрока.Оборудование/1000,КолЗнаков);
		ОбластьСтрокаЛС.Параметры.ОплатаТруда           		= Окр(ТекСтрока.ОплатаТруда/1000,КолЗнаков);
		ОбластьСтрокаЛС.Параметры.Прочие                		= Окр(ТекСтрока.Прочие/1000,КолЗнаков);
		ОбластьСтрокаЛС.Параметры.СтроительныеРаботы			= Окр(ТекСтрока.СтроительныеРаботы/1000,КолЗнаков);
		ОбластьСтрокаЛС.Параметры.ВсегоПоСтроке 				= ОбластьСтрокаЛС.Параметры.СтроительныеРаботы + ОбластьСтрокаЛС.Параметры.МонтажныеРаботы + ОбластьСтрокаЛС.Параметры.Оборудование + ОбластьСтрокаЛС.Параметры.Прочие;
		
		СоставСметы.Вывести(ОбластьСтрокаЛС);	
				
		СтруктураИтогов.СтроительныеРаботы = СтруктураИтогов.СтроительныеРаботы + ОбластьСтрокаЛС.Параметры.СтроительныеРаботы;
		СтруктураИтогов.МонтажныеРаботы    = СтруктураИтогов.МонтажныеРаботы + ОбластьСтрокаЛС.Параметры.МонтажныеРаботы;
		СтруктураИтогов.Оборудование       = СтруктураИтогов.Оборудование + ОбластьСтрокаЛС.Параметры.Оборудование;
		СтруктураИтогов.Прочие             = СтруктураИтогов.Прочие + ОбластьСтрокаЛС.Параметры.Прочие;
		СтруктураИтогов.ОплатаТруда        = СтруктураИтогов.ОплатаТруда + ОбластьСтрокаЛС.Параметры.ОплатаТруда;
		СтруктураИтогов.ВсегоПоСтроке      = СтруктураИтогов.ВсегоПоСтроке + ОбластьСтрокаЛС.Параметры.ВсегоПоСтроке;
		
	КонецЦикла;
	
	ОбластьИтогЛС.Параметры.Заполнить(СтруктураИтогов);
	СоставСметы.Вывести(ОбластьИтогЛС);	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруПараметровЛЗ()
	
	ТекОбъект 				= РеквизитФормыВЗначение("Объект");
	СписокЛЗ 				= ТекОбъект.ЛимитированныеЗатраты.ВыгрузитьКолонку("ЛимитированнаяЗатрата");
	СтруктураПараметровЛЗ 	= Новый Структура("СписокЛЗ, МетодикаРасчета",СписокЛЗ, Объект.МетодикаРасчета);
	
	Возврат СтруктураПараметровЛЗ; 
	
КонецФункции

&НаКлиенте
Процедура ДобавитьЛЗ(Команда)
	
	СтруктураПараметровЛЗ 	= ПолучитьСтруктуруПараметровЛЗ();
	ОткрытьФорму("Документ.СМ_ОбъектнаяСмета.Форма.ФормаПодбораЛимитированныхЗатрат",СтруктураПараметровЛЗ,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЛЗПоШаблону(Команда)
	
	Если Объект.ЛимитированныеЗатраты.Количество()>0 Тогда
		
		ТекстВопроса = НСтр("ru='При вставке шаблона будут удалены уже введенные лимитированные затраты! 
		|Продолжать (Кнопка ""Да"") ? Кнопка ""Нет"" отказ.'");
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаШаблон", ЭтаФорма);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
	Иначе
		ОЗакрытииФормыВыбораШаблона = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораШаблона",ЭтаФорма);
		ОткрытьФорму("Справочник.СМ_ШаблоныЛимитированныхЗатрат.ФормаВыбора",,ЭтаФорма,,,,ОЗакрытииФормыВыбораШаблона,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаШаблон(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	ОЗакрытииФормыВыбораШаблона = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораШаблона",ЭтаФорма);
	ОткрытьФорму("Справочник.СМ_ШаблоныЛимитированныхЗатрат.ФормаВыбора",,ЭтаФорма,,,,ОЗакрытииФормыВыбораШаблона,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервере
Процедура ОчиститьЛЗНаСервере()
	
	Попытка
		ОчиститьИдРодителяЛС();
		Объект.ЛокальныеСметы.Очистить();
		Объект.ЛимитированныеЗатраты.Очистить();
		ТекОбъект = РеквизитФормыВЗначение("Объект");
		ТекОбъект.Записать(РежимЗаписиДокумента.Запись);
		ЗначениеВРеквизитФормы(ТекОбъект,"Объект");
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Произошла ошибка при очистке табличных частей объекта'"));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЛЗ(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтаФорма);
	ПоказатьВопрос(Оповещение, НСтр("ru='Будут очищены табличные части ""Локальные сметы"" и ""Лимитированные затраты"", продолжить?'"), Режим, 0);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОчистка(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
	
	ОчиститьЛЗНаСервере();
	ОбновитьДеревоОС();

КонецПроцедуры

&НаСервере
Процедура СтрокаВверхНаСервере(ТекЛС)
	
	ТекОбъект 			= РеквизитФормыВЗначение("Объект");
	ТабЛокальныеСметы 	= ТекОбъект.ЛокальныеСметы;
	НайденнаяСтрока 	= ТабЛокальныеСметы.Найти(ТекЛС);
	Если НайденнаяСтрока <> Неопределено Тогда
		
		НовыйНомер 		= НайденнаяСтрока.НомерПП - 1;
		НомерПредСтроки = НайденнаяСтрока.НомерПП;
		
		Если НовыйНомер = 0 Тогда
			НайденнаяСтрока.НомерПП = ТабЛокальныеСметы.Количество();
			ТекНомПП = 1;
			Для Каждого ТекСтрока Из ТабЛокальныеСметы  Цикл
				Если ТекСтрока <> НайденнаяСтрока Тогда
					ТекСтрока.НомерПП = ТекНомПП;
					ТекНомПП = ТекНомПП + 1;
				КонецЕсли;
			КонецЦикла;
		Иначе
			НайденнаяСтрока.НомерПП = НовыйНомер;
		    ИндексТекСтроки 		= ТабЛокальныеСметы.Индекс(НайденнаяСтрока);
			ПредСтрока 				= ТабЛокальныеСметы.Получить(ИндексТекСтроки-1);			
			ПредСтрока.НомерПП 		= НомерПредСтроки;
		КонецЕсли;
		
	КонецЕсли;
	
	ТабЛокальныеСметы.Сортировать("НомерПП Возр");
	
	ЗначениеВРеквизитФормы(ТабЛокальныеСметы,"Объект.ЛокальныеСметы");
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаВверх(Команда)
	
	ТекДанные = Элементы.ДеревоОС.ТекущиеДанные;
	Если ТипЗнч(ТекДанные.Элемент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		СтрокаВверхНаСервере(ТекДанные.Элемент);
		ОбновитьДеревоОС();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СтрокаВнизНаСервере(ТекЛС)
	
	ТекОбъект 			= РеквизитФормыВЗначение("Объект");
	ТабЛокальныеСметы 	= ТекОбъект.ЛокальныеСметы;
	НайденнаяСтрока 	= ТабЛокальныеСметы.Найти(ТекЛС);
	Если НайденнаяСтрока <> Неопределено Тогда
		
		НовыйНомер 		= НайденнаяСтрока.НомерПП + 1;
		НомерПредСтроки = НайденнаяСтрока.НомерПП;
		Если НовыйНомер > ТабЛокальныеСметы.Количество() Тогда
			НайденнаяСтрока.НомерПП = 1;
			ТекНомПП = 2;
			Для Каждого ТекСтрока Из ТабЛокальныеСметы  Цикл
				Если ТекСтрока <> НайденнаяСтрока Тогда
					ТекСтрока.НомерПП = ТекНомПП;
					ТекНомПП = ТекНомПП + 1;
				КонецЕсли;
			КонецЦикла;
		Иначе
			НайденнаяСтрока.НомерПП = НовыйНомер;
		    ИндексТекСтроки 		= ТабЛокальныеСметы.Индекс(НайденнаяСтрока);
			ПредСтрока 				= ТабЛокальныеСметы.Получить(ИндексТекСтроки+1);			
			ПредСтрока.НомерПП 		= НомерПредСтроки;
		КонецЕсли;
		
	КонецЕсли;
	
	ТабЛокальныеСметы.Сортировать("НомерПП Возр");
	
	ЗначениеВРеквизитФормы(ТабЛокальныеСметы,"Объект.ЛокальныеСметы");
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаВниз(Команда)
	
	ТекДанные = Элементы.ДеревоОС.ТекущиеДанные;
	Если ТипЗнч(ТекДанные.Элемент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		СтрокаВнизНаСервере(ТекДанные.Элемент);
		ОбновитьДеревоОС();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокуЛЗНаСервере(ТекСсылка)
	
	СтруктураОтбора 		= Новый Структура;
	МассивУдаляемыхСтрок 	= Новый Массив;
	НазваниеТЧ				= "";
	Если ТипЗнч(ТекСсылка) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		СтруктураОтбора.Вставить("ЛокальнаяСмета",ТекСсылка);		
		МассивУдаляемыхСтрок = Объект.ЛокальныеСметы.НайтиСтроки(СтруктураОтбора);
		НазваниеТЧ = "ЛокальныеСметы";
		ОчиститьИдРодителяЛС(ТекСсылка);
	ИначеЕсли ТипЗнч(ТекСсылка) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
		СтруктураОтбора.Вставить("ЛимитированнаяЗатрата",ТекСсылка);	
		МассивУдаляемыхСтрок = Объект.ЛимитированныеЗатраты.НайтиСтроки(СтруктураОтбора);
		НазваниеТЧ = "ЛимитированныеЗатраты";
	КонецЕсли;
	
	Если МассивУдаляемыхСтрок.Количество() > 0 Тогда
		Для Каждого ТекСтрока Из МассивУдаляемыхСтрок Цикл
			Объект[НазваниеТЧ].Удалить(ТекСтрока);
		КонецЦикла;
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтрокуЛЗ(Команда)
	
	ТекДанные = Элементы.ДеревоОС.ТекущиеДанные;
	СсылкаЛС = ТекДанные.Элемент;
	ТекСтрока = СМ_СметныйСоставКлиент.ТекущаяСтрокаПослеУдаленияВДереве(ДеревоОС, ТекДанные);
	УдалитьСтрокуЛЗНаСервере(ТекДанные.Элемент);
	ОбновитьДеревоОС(ТекСтрока);
	ВывестиСоставОС();
	Если ТипЗнч(СсылкаЛС) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") 
		И ЭтаСметаРассчитана(СсылкаЛС) Тогда
		Записать();
		СМ_СметаВызовСервера.УдалитьДвижения(СсылкаЛС);
		СМ_СметаВызовСервера.УдалитьЛС(СсылкаЛС);
	КонецЕсли;
КонецПроцедуры

