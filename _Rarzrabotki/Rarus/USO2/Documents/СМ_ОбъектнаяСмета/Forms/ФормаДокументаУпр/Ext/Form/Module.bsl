&НаСервере
Процедура ВыборИзШаблонаНаСервере(Ссылка)
	
	Смета = РеквизитФормыВЗначение("Объект");
	Смета.ЛимитированныеЗатраты.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Шаблоны.ЛимЗатрата,
	               |	Шаблоны.Значение КАК ЗначениеПоУмолчанию
	               |ИЗ
	               |	Справочник.СМ_ШаблоныЛимитированныхЗатрат.ЛимитированныеЗатраты КАК Шаблоны
	               |ГДЕ
	               |	Шаблоны.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрЗапроса Из РезультатЗапроса Цикл
		НоваяСтрока = Смета.ЛимитированныеЗатраты.Добавить();
		НоваяСтрока.ЛимитированнаяЗатрата = СтрЗапроса.ЛимЗатрата;
		НоваяСтрока.ЗначениеЛимЗатраты = СтрЗапроса.ЗначениеПоУмолчанию;
		НоваяСтрока.БазисноеЗначениеЛимЗатраты = СтрЗапроса.ЗначениеПоУмолчанию;
		НоваяСтрока.Расчет = Истина;	
	КонецЦикла;
	ЗначениеВДанныеФормы(Смета, Объект);
	Модифицированность = Истина;
	
КонецПроцедуры

// Процедура осуществляет действия после закрытия формы выбора шаблона лим затрат для сметы.
// ПАРАМЕТРЫ:
//// Результат - ссылка на выбранный элемент.
//// Параметры - дополнительные параметры переданные при формировании вопроса пользователю.
