&НаКлиенте
Процедура ТипЦенПриИзменении()
	
	Если ЭтаФорма.ТипЦен = 2 Тогда
		Объект.БазисныеЦены = Ложь;
	Иначе
		Объект.БазисныеЦены = Истина;
	КонецЕсли;
	
	ОбновитьДеревоОС();
	ВывестиСоставОС();

