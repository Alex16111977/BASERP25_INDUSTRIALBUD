			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
    ДокументуатЗаправкаГСМ.Ссылка КАК Ссылка,
    ДокументуатЗаправкаГСМ.ПометкаУдаления КАК ПометкаУдаления,
    ДокументуатЗаправкаГСМ.Номер КАК Номер,
    ДокументуатЗаправкаГСМ.Дата КАК Дата,
    ДокументуатЗаправкаГСМ.Проведен КАК Проведен,
    ДокументуатЗаправкаГСМ.ВидДвиженияГСМ КАК ВидДвиженияГСМ,
    ДокументуатЗаправкаГСМ.Организация КАК Организация,
    ДокументуатЗаправкаГСМ.Ответственный КАК Ответственный,
    ДокументуатЗаправкаГСМ.АЗС КАК АЗС,
    ДокументуатЗаправкаГСМ.Страна КАК Страна,
    ДокументуатЗаправкаГСМ.ОбщееКоличество КАК ОбщееКоличество,
    ДокументуатЗаправкаГСМ.ПодразделениеОрганизации КАК ПодразделениеОрганизации,
    ДокументуатЗаправкаГСМ.СуммаВключаетНДС КАК СуммаВключаетНДС,
    ДокументуатЗаправкаГСМ.ДоговорКонтрагента КАК ДоговорКонтрагента,
    ДокументуатЗаправкаГСМ.СуммаДокумента КАК СуммаДокумента,
    ДокументуатЗаправкаГСМ.КоличествоДокумента КАК КоличествоДокумента,
    ДокументуатЗаправкаГСМ.УчитыватьНДС КАК УчитыватьНДС,
    ДокументуатЗаправкаГСМ.Колонна КАК Колонна,
    ДокументуатЗаправкаГСМ.Комментарий КАК Комментарий,
    ДокументуатЗаправкаГСМ.ДокументОснование КАК ДокументОснование,
    ДокументуатЗаправкаГСМ.Заправки.(
        Ссылка КАК Ссылка,
        НомерСтроки КАК НомерСтроки,
        Дата КАК Дата,
        ТС КАК ТС,
        ГСМ КАК ГСМ,
        Водитель КАК Водитель,
        ПластиковаяКарта КАК ПластиковаяКарта,
        Количество КАК Количество,
        Сумма КАК Сумма,
        Валюта КАК Валюта,
        СтавкаНДС КАК СтавкаНДС,
        СуммаНДС КАК СуммаНДС,
        ПутевойЛист КАК ПутевойЛист,
        Плотность КАК Плотность,
        НомераТалонов КАК НомераТалонов,
        Цена КАК Цена,
        ВидЦеныПоставщика КАК ВидЦеныПоставщика
    ) КАК Заправки,
    ДокументуатЗаправкаГСМ.МоментВремени КАК МоментВремени,
    ВЫБОР
        КОГДА ЕСТЬNULL(ТД.Колич, 0) = 0
            ТОГДА 0
        ИНАЧЕ 1
    КОНЕЦ КАК ФлагТД,
    ДокументуатЗаправкаГСМ.СписокТС КАК СписокТС
ИЗ
    Документ.уатЗаправкаГСМ КАК ДокументуатЗаправкаГСМ
        ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
            уатТиповыеДокументы.ДокументУАТ КАК Ссылка,
            КОЛИЧЕСТВО(уатТиповыеДокументы.ТиповойДокумент) КАК Колич
        ИЗ
            РегистрСведений.уатТиповыеДокументы КАК уатТиповыеДокументы
        
        СГРУППИРОВАТЬ ПО
            уатТиповыеДокументы.ДокументУАТ) КАК ТД
        ПО ДокументуатЗаправкаГСМ.Ссылка = ТД.Ссылка</QueryText>
				<MainTable>Document.уатЗаправкаГСМ</MainTable>
				<ListSettings>
