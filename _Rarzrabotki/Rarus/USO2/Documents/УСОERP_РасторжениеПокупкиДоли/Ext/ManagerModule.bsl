
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПроведениеПоРеглУчету

// Функция возвращает текст запроса для отражения документа в регламентированном учете.
//
// Возвращаемое значение:
//	Строка - Текст запроса
//
Функция ТекстОтраженияВРеглУчете() Экспорт
	
	Возврат ТекстРасторжениеПокупкиДоли();
	
КонецФункции

Функция ТекстРасторжениеПокупкиДоли()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Операция.Ссылка 						КАК Ссылка,
	|	Операция.Дата 							КАК Период,
	|	Операция.Организация 					КАК Организация,
	|	НЕОПРЕДЕЛЕНО 							КАК ИдентификаторСтроки,
	|	ЕСТЬNULL(-Операция.СуммаДокумента, 0)	КАК Сумма,
	
	|	ЕСТЬNULL(-Операция.СуммаДокумента, 0) / КурсВалютыУпрУчета.Курс	КАК СуммаУУ,
	//|	ЕСТЬNULL(Операция.СуммаДокумента, 0)	КАК Сумма,
	//
	//|	ЕСТЬNULL(Операция.СуммаДокумента, 0) / КурсВалютыУпрУчета.Курс	КАК СуммаУУ,
	
	|
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСКлиентами)	КАК ВидСчетаДт,
	|	Операция.ГруппаФинансовогоУчета 								КАК ГруппаФинансовогоУчетаДт,
	|	НЕОПРЕДЕЛЕНО 													КАК МестоУчетаДт,
	|	Операция.Валюта 												КАК ВалютаДт,
	|	ЕСТЬNULL(Расчеты.Подразделение, Операция.Подразделение) 		КАК ПодразделениеДт,
	//|   Операция.Подразделение 		                                    КАК ПодразделениеДт,  
	|	Операция.НаправлениеДеятельности 								КАК НаправлениеДеятельностиДт,
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка) 					КАК СчетДт,
	|	Операция.Контрагент 											КАК СубконтоДт1,
	|	Операция.Договор 												КАК СубконтоДт2,
	|	НЕОПРЕДЕЛЕНО 													КАК СубконтоДт3,
	|	0 																КАК ВалютнаяСуммаДт,
	|	0 																КАК КоличествоДт,
	|	-Операция.СуммаДокумента 										КАК СуммаНУДт,
	//|	Операция.СуммаДокумента 										КАК СуммаНУДт,

	|	0 																КАК СуммаПРДт,
	|	0 																КАК СуммаВРДт,
	|
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка)	КАК ВидСчетаКт,
	|	НЕОПРЕДЕЛЕНО 											КАК АналитикаУчетаКт,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) 				КАК МестоУчетаКт,
	|	НЕОПРЕДЕЛЕНО 											КАК ВалютаКт,
	//|	ЕСТЬNULL(Расчеты.Подразделение, Операция.Подразделение)	КАК ПодразделениеКт,
	|	Операция.Подразделение                              	КАК ПодразделениеКт, 
	|	Операция.НаправлениеДеятельности 						КАК НаправлениеДеятельностиКт,
	|	Операция.СчетУчета 										КАК СчетКт,
	|	Операция.НазначениеЦелевыхСредств 						КАК СубконтоКт1,
	|	Операция.Договор 										КАК СубконтоКт2,
	|	Операция.ДвижениеЦелевыхСредств 						КАК СубконтоКт3,
	|	0 														КАК ВалютнаяСуммаКт,
	|	0 														КАК КоличествоКт,
	|	-Операция.СуммаДокумента 								КАК СуммаНУКт,
	//|	Операция.СуммаДокумента 								КАК СуммаНУКт,
	|	0 														КАК СуммаПРКт,
	|	0 														КАК СуммаВРКт,
	|
	|	""Расторжение покупки доли"" КАК Содержание
	|ИЗ
	|	Документ.УСОERP_РасторжениеПокупкиДоли КАК Операция
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммыДокументовВВалютеРегл КАК Суммы
	|		ПО (Суммы.Регистратор = Операция.Ссылка)
	|			И (Суммы.СуммаБезНДСРегл <> 0)
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		КурсыВалют КАК КурсВалютыУпрУчета
	|	ПО
	|		КурсВалютыУпрУчета.Валюта = &ВалютаУпрУчета
	|		И КурсВалютыУпрУчета.Дата = НАЧАЛОПЕРИОДА(Операция.Дата, День)	
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
	|			Расчеты.ЗаказКлиента.Подразделение КАК Подразделение,
	|			Расчеты.ЗаказКлиента.ГруппаФинансовогоУчета КАК ГруппаФинансовогоУчета
	|		ИЗ
	|			РегистрНакопления.РасчетыСКлиентами КАК Расчеты
	|		ГДЕ
	|			Расчеты.Регистратор = &Ссылка) КАК Расчеты
	|		ПО (ИСТИНА)
	|ГДЕ
	|	Операция.Ссылка = &Ссылка";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстЗапросаТаблицаРасчетыСКлиентами(Запрос, ТекстыЗапроса, Регистры);
	
	ПроведениеСерверУТ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_РасторжениеПокупкиДоли.Дата КАК Период,
	|	УСОERP_РасторжениеПокупкиДоли.Дата КАК ДатаНачалаПериода,
	|	УСОERP_РасторжениеПокупкиДоли.Ссылка КАК Ссылка,
	|	УСОERP_РасторжениеПокупкиДоли.ОбъектСтроительства КАК ОбъектСтроительства,
	|	УСОERP_РасторжениеПокупкиДоли.Организация КАК Организация,
	|	УСОERP_РасторжениеПокупкиДоли.Контрагент КАК Контрагент,
	|	УСОERP_РасторжениеПокупкиДоли.Договор КАК Договор,
	|	УСОERP_РасторжениеПокупкиДоли.Партнер КАК Партнер,
	|	УСОERP_РасторжениеПокупкиДоли.Соглашение КАК Соглашение,
	|	УСОERP_РасторжениеПокупкиДоли.Подразделение КАК Подразделение,
	|	УСОERP_РасторжениеПокупкиДоли.Договор.ДопустимаяСуммаЗадолженности КАК ДопустимаяСуммаЗадолженности,
	|	УСОERP_РасторжениеПокупкиДоли.Номер КАК Номер
	|ИЗ
	|	Документ.УСОERP_РасторжениеПокупкиДоли КАК УСОERP_РасторжениеПокупкиДоли
	|ГДЕ
	|	УСОERP_РасторжениеПокупкиДоли.Ссылка = &Ссылка";
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	
	Реквизиты.Следующий();

	Коэффициенты = РаботаСКурсамивалютУТ.ПолучитьКоэффициентыПересчетаВалюты(ДокументСсылка.Валюта, ДокументСсылка.Валюта, ДокументСсылка.Дата);
	
	Запрос.УстановитьПараметр("ОбъектСтроительства",	Реквизиты.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Период",					Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация",			Реквизиты.Организация);
	Запрос.УстановитьПараметр("Контрагент",				Реквизиты.Контрагент);
	Запрос.УстановитьПараметр("Договор",				Реквизиты.Договор);
	Запрос.УстановитьПараметр("Партнер",				Реквизиты.Партнер);
	Запрос.УстановитьПараметр("Соглашение",				Реквизиты.Соглашение);
	Запрос.УстановитьПараметр("Подразделение",			Реквизиты.Подразделение);
	Запрос.УстановитьПараметр("Период",					Реквизиты.Период);
	Запрос.УстановитьПараметр("ДатаНачалаПериода",		Реквизиты.ДатаНачалаПериода);
	Запрос.УстановитьПараметр("ДопустимаяСуммаЗадолженности",				Реквизиты.ДопустимаяСуммаЗадолженности);
	Запрос.УстановитьПараметр("ХозяйственнаяОперация",						Перечисления.ХозяйственныеОперации.РеализацияКлиенту);
	Запрос.УстановитьПараметр("КоэффициентПересчетаВВалютуУПР",  			Коэффициенты.КоэффициентПересчетаВВалютуУПР);
	Запрос.УстановитьПараметр("КоэффициентПересчетаВВалютуРегл", 			Коэффициенты.КоэффициентПересчетаВВалютуРегл);
	Запрос.УстановитьПараметр("АналитикаУчетаПоПартнерам",       			РегистрыСведений.АналитикаУчетаПоПартнерам.ЗначениеКлючаАналитики(ДокументСсылка));
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", 			Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("ИспользоватьРасширенныеВозможностиЗаказаКлиента",ПолучитьФункциональнуюОпцию("ИспользоватьРасширенныеВозможностиЗаказаКлиента"));
	Запрос.УстановитьПараметр("Номер",                  Реквизиты.Номер);
	
КонецПроцедуры

Процедура ТекстЗапросаТаблицаРасчетыСКлиентами(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "РасчетыСКлиентами";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Период КАК ДатаРегистратора,
	|	&Номер КАК НомерРегистратора, 
	|	&ДатаНачалаПериода КАК ДатаПлатежа,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	УСОERP_РасторжениеПокупкиДоли.Валюта КАК Валюта,
	|	УСОERP_РасторжениеПокупкиДоли.Валюта КАК ВалютаДокумента,
	|	&АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам,
	|	&Договор КАК ЗаказКлиента,
	|	НЕОПРЕДЕЛЕНО КАК ПродажаПоЗаказу,
	|	&ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	ИСТИНА КАК ИсключатьПриКонтроле,
	|	НЕОПРЕДЕЛЕНО КАК ФормаОплаты,
	|	-&ДопустимаяСуммаЗадолженности КАК ДопустимаяСуммаЗадолженности,
	|	-УСОERP_РасторжениеПокупкиДоли.СуммаДокумента КАК Сумма,
	|	0 КАК КОплате,
	|	ВЫБОР
	|		КОГДА &ИспользоватьРасширенныеВозможностиЗаказаКлиента
	|			ТОГДА -СУММА(УСОERP_РасторжениеПокупкиДоли.СуммаДокумента)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КОтгрузке,
	|	ВЫРАЗИТЬ(СУММА(-УСОERP_РасторжениеПокупкиДоли.СуммаДокумента) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2)) КАК СуммаРегл,
	|	ВЫРАЗИТЬ(СУММА(-УСОERP_РасторжениеПокупкиДоли.СуммаДокумента) * &КоэффициентПересчетаВВалютуУпр КАК ЧИСЛО(15, 2)) КАК СуммаУпр,
	|	&Организация КАК Организация
	|ИЗ
	|	Документ.УСОERP_РасторжениеПокупкиДоли КАК УСОERP_РасторжениеПокупкиДоли
	|ГДЕ
	|	УСОERP_РасторжениеПокупкиДоли.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_РасторжениеПокупкиДоли.Валюта,
	|	-УСОERP_РасторжениеПокупкиДоли.СуммаДокумента
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	&Период,
	|	&Период,
	|	&Номер,
	|	&ДатаНачалаПериода,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	УСОERP_РасторжениеПокупкиДоли.Валюта,
	|	УСОERP_РасторжениеПокупкиДоли.Валюта,
	|	&АналитикаУчетаПоПартнерам,
	|	&Договор,
	|	НЕОПРЕДЕЛЕНО,
	|	&ХозяйственнаяОперация,
	|	ИСТИНА,
	|	НЕОПРЕДЕЛЕНО,
	|	-&ДопустимаяСуммаЗадолженности,
	|	0,
	|	-УСОERP_РасторжениеПокупкиДоли.СуммаДокумента,
	|	0,
	|	0,
	|	0,
	|	&Организация
	|ИЗ
	|	Документ.УСОERP_РасторжениеПокупкиДоли КАК УСОERP_РасторжениеПокупкиДоли
	|ГДЕ
	|	НЕ &ИспользоватьРасширенныеВозможностиЗаказаКлиента
	|	И УСОERP_РасторжениеПокупкиДоли.Ссылка = &Ссылка";
	
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Период КАК ДатаРегистратора,
	|	&Номер КАК НомерРегистратора, 
	|	&ДатаНачалаПериода КАК ДатаПлатежа,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	УСОERP_РасторжениеПокупкиДоли.Валюта КАК Валюта,
	|	УСОERP_РасторжениеПокупкиДоли.Валюта КАК ВалютаДокумента,
	|	&АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам,
	|	&Договор КАК ЗаказКлиента,
	|	НЕОПРЕДЕЛЕНО КАК ПродажаПоЗаказу,
	|	&ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	ИСТИНА КАК ИсключатьПриКонтроле,
	|	НЕОПРЕДЕЛЕНО КАК ФормаОплаты,
	|	&ДопустимаяСуммаЗадолженности КАК ДопустимаяСуммаЗадолженности,
	|	УСОERP_РасторжениеПокупкиДоли.СуммаДокумента КАК Сумма,
	|	0 КАК КОплате,
	|	ВЫБОР
	|		КОГДА &ИспользоватьРасширенныеВозможностиЗаказаКлиента
	|			ТОГДА СУММА(УСОERP_РасторжениеПокупкиДоли.СуммаДокумента)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КОтгрузке,
	|	ВЫРАЗИТЬ(СУММА(УСОERP_РасторжениеПокупкиДоли.СуммаДокумента) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2)) КАК СуммаРегл,
	|	ВЫРАЗИТЬ(СУММА(УСОERP_РасторжениеПокупкиДоли.СуммаДокумента) * &КоэффициентПересчетаВВалютуУпр КАК ЧИСЛО(15, 2)) КАК СуммаУпр,
	|	&Организация КАК Организация
	|ИЗ
	|	Документ.УСОERP_РасторжениеПокупкиДоли КАК УСОERP_РасторжениеПокупкиДоли
	|ГДЕ
	|	УСОERP_РасторжениеПокупкиДоли.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_РасторжениеПокупкиДоли.Валюта,
	|	УСОERP_РасторжениеПокупкиДоли.СуммаДокумента
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	&Период,
	|	&Период,
	|	&Номер,
	|	&ДатаНачалаПериода,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	УСОERP_РасторжениеПокупкиДоли.Валюта,
	|	УСОERP_РасторжениеПокупкиДоли.Валюта,
	|	&АналитикаУчетаПоПартнерам,
	|	&Договор,
	|	НЕОПРЕДЕЛЕНО,
	|	&ХозяйственнаяОперация,
	|	ИСТИНА,
	|	НЕОПРЕДЕЛЕНО,
	|	&ДопустимаяСуммаЗадолженности,
	|	0,
	|	УСОERP_РасторжениеПокупкиДоли.СуммаДокумента,
	|	0,
	|	0,
	|	0,
	|	&Организация
	|ИЗ
	|	Документ.УСОERP_РасторжениеПокупкиДоли КАК УСОERP_РасторжениеПокупкиДоли
	|ГДЕ
	|	НЕ &ИспользоватьРасширенныеВозможностиЗаказаКлиента
	|	И УСОERP_РасторжениеПокупкиДоли.Ссылка = &Ссылка";

	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
КонецПроцедуры

// Функция возвращает текст запроса дополнительных временных таблиц, 
// необходимых для отражения в регламетированном учете
//
Функция ТекстЗапросаВТОтраженияВРеглУчете() Экспорт
	
