#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЗначениеКопирования") Тогда
		
		Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
	КонецЕсли;  	
	
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

	ЗначенияДляЗаполнения = Новый Структура;
	ЗначенияДляЗаполнения.Вставить("Ответственный", "Объект.Ответственный");
	ЗарплатаКадры.ЗаполнитьПервоначальныеЗначенияВФорме(ЭтаФорма, ЗначенияДляЗаполнения);
	
	ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;
	ТекущаяОрганизация = Объект.Организация;
	ТекущийСценарий    = Объект.СценарийПланирования;   	
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(РаботыДС,"КопияСценария",Объект.КопияСценария,Истина);
	ЭлементОтбора = РаботыДС.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));	
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ПравоеЗначение = Объект.КопияСценария;
	
	СформироватьДеревоРабот();
	
	УстановитьУсловноеОформление();
	
	// Обработчик подсистемы "Свойства"
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтаФорма, ДополнительныеПараметры);
	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	
	СобытияФорм.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
	НовыйВариант  = ЭтоНовыйВариантСценария(Объект.СценарийПланирования);
	
	УправлениеЭлементамиФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	

	РазвернутьДеревоРабот();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если ТекущаяОрганизация = Объект.Организация Тогда
		
		Объект.СценарийПланирования = ТекущийСценарий;
		ТекущаяОрганизация = Объект.Организация;
		
	Иначе
		
		РабочийСценарий = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьРабочийСценарий(Объект.ОбъектСтроительства, Объект.Организация);
		
		Объект.Актуальный = Ложь;
		
		Если ЗначениеЗаполнено(Объект.СценарийПланирования) И 
			РабочийСценарий <> Объект.СценарийПланирования И 			
			Объект.Работы.Количество()>0 Тогда
			
			ПоказатьВопрос(Новый ОписаниеОповещения("ОрганизацияПриИзмененииПродолжение",ЭтотОбъект),"Таблица работ будет перезаполнена. Продолжить?", РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
			
		Иначе
			
			ОрганизацияПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
			
		КонецЕсли;
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеЭлементамиФормы(Форма)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	ЭтоНовый = НЕ ЗначениеЗаполнено(Форма.Объект.Ссылка);
	НовыйВариант = Форма.НовыйВариант;
	СтарыйВариант = ЗначениеЗаполнено(Форма.Объект.ОбъектСтроительства) И НовыйВариант = Ложь;
	
	ИменаЭлементов = Новый Массив;
	
	ИменаЭлементов.Добавить("Дата");
	ИменаЭлементов.Добавить("ДатаВерсииПлана");
	ИменаЭлементов.Добавить("Статус");
	ИменаЭлементов.Добавить("Организация");
	ИменаЭлементов.Добавить("Проект");
	ИменаЭлементов.Добавить("СценарийПланирования");	
	
	ОбщегоНазначенияУТКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов, "ТолькоПросмотр", НовыйВариант И Объект.Работы.Количество() И НЕ ЭтоНовый);
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ДеревоРаботОбновитьДеревоРабот");
	ИменаЭлементов.Добавить("Актуальный");	
	ОбщегоНазначенияУТКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов, "Видимость", НЕ НовыйВариант);
	
	Элементы.РаботыДССоздатьКопиюСценария.Видимость = НЕ ЗначениеЗаполнено(Объект.КопияСценария);
	
	Элементы.РаботыДСКомандаЗаполнитьРаспределениеРабот.Видимость = ВидимостьКнопкиЗаполнитьРаспределение(Объект.КопияСценария);
	Элементы.ДеревоРаботКомандаЗаполнитьРаспределениеРабот.Видимость = Элементы.РаботыДСКомандаЗаполнитьРаспределениеРабот.Видимость;
	Элементы.ДатаВерсииПлана.Видимость = СтарыйВариант;
	 
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзмененииПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		
		Объект.СценарийПланирования = ТекущийСценарий;
		Возврат;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ОбъектСтроительства) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	РабочийСценарий = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьРабочийСценарий(Объект.ОбъектСтроительства, Объект.Организация);
	
	Объект.СценарийПланирования = РабочийСценарий;
	НовыйВариант = ЭтоНовыйВариантСценария(Объект.СценарийПланирования);
	ЗаполнитьТаблицуРабот();
	СформироватьДеревоРабот();
	РазвернутьДеревоРабот();
	
	ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;
	ТекущийСценарий = Объект.СценарийПланирования;
	
	ТекущаяОрганизация = Объект.Организация; 
	
	УправлениеЭлементамиФормы(ЭтаФорма);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПроектПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ТекущийОбъектСтроительства)
		И ТекущийОбъектСтроительства <> Объект.ОбъектСтроительства Тогда		
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПроектПриИзмененииПродолжение",ЭтотОбъект),"Таблица работ будет перезаполнена. Продолжить?", РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
		
	Иначе
		
		ПроектПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроектПриИзмененииПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		
		Объект.ОбъектСтроительства = ТекущийОбъектСтроительства;
		Объект.СценарийПланирования = ТекущийСценарий;
		Возврат;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		
		ОбъектСтроительстваПриИзмененииНаСервере();	

		Возврат;
		
	КонецЕсли;  	
	
	Если ТекущийОбъектСтроительства <> Объект.ОбъектСтроительства Тогда
		
		Объект.СценарийПланирования = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьРабочийСценарий(Объект.ОбъектСтроительства, Объект.Организация);
		
		Объект.Актуальный = Ложь;
		НовыйВариант  = ЭтоНовыйВариантСценария(Объект.СценарийПланирования);
		
	Иначе
		
		Объект.СценарийПланирования = ТекущийСценарий;
		
	КонецЕсли;
	
	ОбъектСтроительстваПриИзмененииНаСервере();	
	
	ЗаполнитьТаблицуРабот();
	СформироватьДеревоРабот();
	РазвернутьДеревоРабот();
	
	ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;
	ТекущийСценарий = Объект.СценарийПланирования;
	
	УправлениеЭлементамиФормы(ЭтаФорма); 
	
КонецПроцедуры 

&НаСервере
Процедура  	ОбъектСтроительстваПриИзмененииНаСервере()
	Объект.НаправлениеДеятельности = Объект.ОбъектСтроительства.ОбъектСтроительства.НаправлениеДеятельности;
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ЭтоНовыйВариантСценария(СценарийПланирования) Экспорт
	
	Возврат СценарийПланирования.НовыйВариант;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьДеревоРабот(Команда)
	
	Если ЗначениеЗаполнено(Объект.КопияСценария) Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьДеревоРаботЗавершение",ЭтотОбъект);
		
		ТекстВопроса = ПолучитьТекстВопросаПоСценарию();
		
		ПоказатьВопрос(ОписаниеОповещения,ТекстВопроса,РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
		
	Иначе
		
		ОбновитьДеревоРаботЗавершение(КодВозвратаДиалога.Да, Новый Структура);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТекстВопросаПоСценарию()
	
	ТекстВопроса = "На данный момент существует копия сценария № "+Объект.КопияСценария.НомерВерсии+" от "+Формат(Объект.КопияСценария.ДатаСохранения,"ДФ=dd.MM.yyyy")+". Будет создана новая копия. Продолжить?";
	
	Возврат ТекстВопроса;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьДеревоРаботЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		ЗаполнитьТаблицуРабот();
		СформироватьДеревоРабот();
		РазвернутьДеревоРабот();
		ЭтаФорма.Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДеревоРабот()
	
	Если Объект.СценарийПланирования.НовыйВариант = Истина Тогда
		
		Элементы.ГруппаРаботы.Видимость = Объект.Работы.Количество();
		Элементы.ГруппаРаботыДС.Видимость = НЕ Объект.Работы.Количество();		
		Элементы.РаботыДССоздатьКопиюСценария.Видимость = НЕ ЗначениеЗаполнено(Объект.КопияСценария);
		Элементы.ДеревоРаботОбновитьДеревоРабот.Видимость = Ложь;		
		Элементы.РаботыДСКомандаЗаполнитьРаспределениеРабот.Видимость = ВидимостьКнопкиЗаполнитьРаспределение(Объект.КопияСценария);
		Элементы.ДеревоРаботКомандаЗаполнитьРаспределениеРабот.Видимость = Элементы.РаботыДСКомандаЗаполнитьРаспределениеРабот.Видимость;
		
		Если НЕ Объект.Работы.Количество() Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ГруппаРаботы.Видимость = Истина;
	
	Элементы.ГруппаРаботыДС.Видимость = Ложь;	
	
	ДанныеДляДерева = Объект.Работы.Выгрузить();
	РаботыВерхнегоУровня = ДанныеДляДерева.НайтиСтроки(Новый Структура("Родитель", Справочники.УСОERP_СтроительныеРаботы.ПустаяСсылка()));
	
	ВремРодноеДерево = РеквизитФормыВЗначение("ДеревоРабот"); // берется родная структура с родной типизацией
	ВремРодноеДерево.Строки.Очистить();
	
	Если Объект.СценарийПланирования.НовыйВариант Тогда
		
		Для Каждого РаботаВерхнегоУровня Из РаботыВерхнегоУровня Цикл
			НоваяСтрокаДерева = ВремРодноеДерево.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДерева, РаботаВерхнегоУровня);
			ЗаполнитьДеревоРаботРекурсивно(ДанныеДляДерева, НоваяСтрокаДерева);
		КонецЦикла;
		
	Иначе
		
		Справочник = Справочники.УСОERP_СтроительныеРаботы;
		ДеревоРезультат = УСОERP_ОбработкаТабличныхЧастей.УСОERP_ПодготовитьДанныеИСформироватьДеревоСВосстановлениемСтруктуры(ДанныеДляДерева,"Работа","РаботаРодитель",,Справочники.УСОERP_СтроительныеРаботы);		
		УСОERP_ОбработкаТабличныхЧастей.УСОERP_ЗаполнитьРоднуюСтруктуруДереваИзВнешнего(ВремРодноеДерево.Строки, ДеревоРезультат.Строки); // и рекурсивно заполняется из дерева, где, возможн, типиация создаст проблемы
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ВремРодноеДерево, "ДеревоРабот");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоРаботРекурсивно(ДанныеДляДерева, Строка)
	
	РаботыПоРодителю = ДанныеДляДерева.НайтиСтроки(Новый Структура("Родитель", Строка.Работа));
	Для Каждого РаботаПоРодителю Из РаботыПоРодителю Цикл
		НоваяСтрокаДерева = Строка.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаДерева, РаботаПоРодителю);
		ЗаполнитьДеревоРаботРекурсивно(ДанныеДляДерева, НоваяСтрокаДерева);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуРабот()
	
	Если Объект.СценарийПланирования.НовыйВариант = Истина Тогда
		Возврат;
	КонецЕсли; 	
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_УтверждениеКалендарногоПланаГрафика_ЗаполнитьТаблицуРабот(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоРабот()
	
	КоллекцияЭлементовДерева = ДеревоРабот.ПолучитьЭлементы();	
	//Развернуть дерево 
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
		ИдентификаторСтроки=Строка.ПолучитьИдентификатор();
		Элементы.ДеревоРабот.Развернуть(ИдентификаторСтроки);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить(); 
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоРабот.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоРабот.СуммарнаяРабота");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(WindowsШрифты.ШрифтДиалоговИМеню,,,Истина));
	
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.РаботыДС.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("РаботыДС.СуммарнаяРабота");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(WindowsШрифты.ШрифтДиалоговИМеню,,,Истина)); 	
	
КонецПроцедуры

&НаКлиенте
Процедура СценарийПланированияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ТекущийСценарий)
		И ТекущийСценарий <> Объект.СценарийПланирования И 		
		Объект.Работы.Количество()>0 Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("СценарийПланированияПриИзмененииПродолжение",ЭтотОбъект),"Таблица работ будет перезаполнена. Продолжить?", РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
		
	Иначе
		
		СценарийПланированияПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли;  	 
	
КонецПроцедуры

&НаКлиенте
Процедура СценарийПланированияПриИзмененииПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Объект.СценарийПланирования = ТекущийСценарий;
		Возврат;
	КонецЕсли;
	
	НовыйВариант = ЭтоНовыйВариантСценария(Объект.СценарийПланирования);
	
	Если ТекущийСценарий <> Объект.СценарийПланирования Тогда
		
		ЗаполнитьТаблицуРабот();
		СформироватьДеревоРабот();
		РазвернутьДеревоРабот();
		
		ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;
		ТекущийСценарий = Объект.СценарийПланирования;
		
	КонецЕсли;
	
	УправлениеЭлементамиФормы(ЭтаФорма);
	
КонецПроцедуры  

&НаКлиенте
Процедура ДеревоРаботРаботаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекРабота = Элементы.ДеревоРабот.ТекущиеДанные.Работа;
	
	Если ЗначениеЗаполнено(Объект.КопияСценария) Тогда
		ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаЭлементаДинамическая",Новый Структура("Ключ",ТекРабота));
	Иначе
		ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаЭлемента",Новый Структура("Ключ",ТекРабота));
	КонецЕсли;
	
КонецПроцедуры

