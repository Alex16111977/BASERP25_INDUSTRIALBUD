КонецПроцедуры

&НаКлиенте
Процедура СоздатьКопиюСценария(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьКопиюСценарияПродолжения",ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения,"Будет создана копия сценария, может занять продолжительное время,продолжить?",РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКопиюСценарияПродолжения(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = "";
	
	Если НЕ ПроверитьСценарийНаЗаполненность(ТекстОшибки) Тогда
		ПоказатьПредупреждение(,ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	СоздатьКопиюСценарияНаСервере(); 	
	Элементы.РаботыДС.Обновить();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьСценарийНаЗаполненность(ТекстОшибки)
	
	ТекстОшибки = "";
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("СценарийПланирования",Объект.СценарийПланирования);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_СтроительныеРаботы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	НЕ УСОERP_СтроительныеРаботы.СуммарнаяРабота
	|	И НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
	|	И (УСОERP_СтроительныеРаботы.ОбъемРаботы = 0
	|			ИЛИ УСОERP_СтроительныеРаботы.ЕдиницаОбъема = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка))
	|	И УСОERP_СтроительныеРаботы.Владелец = &СценарийПланирования";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТекстОшибки = ТекстОшибки+""+УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДР(Выборка.Ссылка)+"."+Выборка.Ссылка+""+Символы.ПС;
		
	КонецЦикла; 		
	
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		ТекстОшибки = "Есть работы с незаполненным объемом: "+Символы.ПС+СокрЛП(ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		ТекстОшибки = "НЕ ЗАПОЛНЕНЫ ЗНАЧЕНИЯ "+Символы.ПС+ТекстОшибки;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина; 		
	
КонецФункции  

&НаСервере
Процедура СоздатьКопиюСценарияНаСервере()
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_УтверждениеКалендарногоПланаГрафика_ЗаполнитьТаблицуРабот(ЭтотОбъект);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(РаботыДС,"КопияСценария",Объект.КопияСценария,Истина);
	РаботыДС.Отбор.Элементы.Очистить();
	ЭлементОтбора = РаботыДС.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));	
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ПравоеЗначение = Объект.КопияСценария; 	
	
КонецПроцедуры

