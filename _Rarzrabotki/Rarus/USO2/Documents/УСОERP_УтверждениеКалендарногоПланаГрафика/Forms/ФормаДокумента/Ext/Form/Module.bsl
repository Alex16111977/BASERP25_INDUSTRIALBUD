&НаСервереБезКонтекста
Функция ВидимостьКнопкиЗаполнитьРаспределение(КопияСценария)
	
	Если НЕ ЗначениеЗаполнено(КопияСценария) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Результат = Ложь;
	
	Выборка = Справочники.УСОERP_СтроительныеРаботы.Выбрать(,КопияСценария);
	
	Пока Выборка.Следующий() Цикл
		
		Если ПустаяСтрока(Выборка.ПорядокСортировки) Тогда
			
			Результат = Истина;
			Прервать;
			
		КонецЕсли;
		
		Если НЕ Выборка.ПометкаУдаления И НЕ Выборка.СуммарнаяРабота Тогда
			
			Результат = НЕ Выборка.Распределение.Количество();
			
			ПрерватЬ;
			
		КонецЕсли;
		
	КонецЦикла; 	
	
	Возврат Результат;	
	
КонецФункции


