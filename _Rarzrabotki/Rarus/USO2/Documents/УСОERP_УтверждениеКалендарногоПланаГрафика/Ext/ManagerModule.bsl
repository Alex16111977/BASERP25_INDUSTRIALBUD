
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстыЗапроса.Добавить(ТекстЗапросаТаблицаРаботы(),		"");
	ТекстыЗапроса.Добавить(ТекстЗапросаТаблицаВыполнениеПринятие(),	"ТаблицаВыполнениеПринятие");


	Запрос.Текст = "";
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		Запрос.Текст = Запрос.Текст + ТекстЗапроса.Значение;
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////
	// Выполним запрос
	
	Результат = Запрос.ВыполнитьПакет();
	
	////////////////////////////////////////////////////////////////////////////
	// Поместим результаты запроса в дополнительные свойства
	
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		ИмяТаблицы = ТекстЗапроса.Представление;
		Если Не ПустаяСтрока(ИмяТаблицы) Тогда
			Индекс = ТекстыЗапроса.Индекс(ТекстЗапроса);
			ДополнительныеСвойства.ТаблицыДляДвижений.Вставить(ИмяТаблицы, Результат[Индекс].Выгрузить());
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	//Запрос.УстановитьПараметр("Работы", Работы);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.Ссылка,
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.Дата КАК Период,
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.Организация,
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.ОбъектСтроительства
	|ИЗ
	|	Документ.УСОERP_УтверждениеКалендарногоПланаГрафика КАК УСОERP_УтверждениеКалендарногоПланаГрафика
	|ГДЕ
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.Ссылка = &Ссылка";
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	//
	Запрос.УстановитьПараметр("ОбъектСтроительства",	Реквизиты.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Период",      			Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация", 			Реквизиты.Организация);
		
КонецПроцедуры

Функция ТекстЗапросаТаблицаРаботы()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.Работа,
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.ОбъемРаботы КАК Объем,
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.ЕдиницаОбъема,
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.НачалоРаботыПлан КАК ДатаНачала,
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.ОкончаниеРаботыПлан КАК ДатаОкончания,
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.НомерСтроки
	|ПОМЕСТИТЬ ВтТаблицаРаботы
	|ИЗ
	|	Документ.УСОERP_УтверждениеКалендарногоПланаГрафика.Работы КАК УСОERP_УтверждениеКалендарногоПланаГрафика
	|ГДЕ
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.Ссылка = &Ссылка
	|	И УСОERP_УтверждениеКалендарногоПланаГрафика.Работа.СуммарнаяРабота = ЛОЖЬ
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаВыполнениеПринятие()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&Организация КАК Организация,
	|	&ОбъектСтроительства КАК ОбъектСтроительства,
	|	ТаблицаРаботы.НомерСтроки КАК НомерСтроки,
	|	ТаблицаРаботы.Работа КАК Работа,
	|	ТаблицаРаботы.Объем КАК ОбъемУтверждено,
	|	ТаблицаРаботы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТаблицаРаботы.ДатаНачала КАК ДатаНачала,
	|	ТаблицаРаботы.ДатаОкончания КАК ДатаОкончания
	|ИЗ
	|	ВтТаблицаРаботы КАК ТаблицаРаботы
	|ГДЕ
	|	ТаблицаРаботы.Объем <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

