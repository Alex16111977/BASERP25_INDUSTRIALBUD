	//РегистрыСведений.УСОERP_ПараметрыВыполненияРабот.ОтменитьПризнакУтверждения(Ссылка, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеДляПроведения()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ДатаСреза", Новый Граница(КонецДня(Ссылка.ДатаВерсииПлана), ВидГраницы.Включая));   	
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаРабот.Работа КАК СтроительнаяРабота,
	|	ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыПланированияСтроительныхРабот.Календарный) КАК ВидПланирования,
	|	ТаблицаРабот.ОбъемРаботы,
	|	ТаблицаРабот.ЕдиницаОбъема,
	|	ТаблицаРабот.НачалоРаботыПлан,
	|	ТаблицаРабот.ОкончаниеРаботыПлан,
	|	ТаблицаРабот.ДлительностьПлан,
	|	ТаблицаРабот.ЕдиницаДлительности,
	|	ТаблицаРабот.Ссылка.Ответственный КАК АвторИзменения
	|ИЗ
	|	Документ.УСОERP_УтверждениеКалендарногоПланаГрафика.Работы КАК ТаблицаРабот
	|ГДЕ
	|	ТаблицаРабот.Ссылка = &Ссылка
	|	И ТаблицаРабот.Ссылка.СценарийПланирования.ВидСценария = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыСценариевПланирования.Рабочий)";				   
	ДанныеДляПроведения = Запрос.Выполнить().Выгрузить();
	
	Возврат ДанныеДляПроведения;
	
КонецФункции

Процедура СформироватьДвижения(ТаблицаДанных, Записывать = Истина)
	
	Если НЕ Актуальный Тогда
		Возврат;
	КонецЕсли;	
	
	Для каждого СтрокаРаботы из ТаблицаДанных Цикл
		
		ТекРабота = ?(ЗначениеЗаполнено(СтрокаРаботы.СтроительнаяРабота.РаботаИсточник),СтрокаРаботы.СтроительнаяРабота.РаботаИсточник,СтрокаРаботы.СтроительнаяРабота);
				
		НаборЗаписейПараметрыВР = РегистрыСведений.УСОERP_ПараметрыВыполненияРабот.СоздатьНаборЗаписей();
		НаборЗаписейПараметрыВР.Отбор.Работа.Установить(ТекРабота);
		НаборЗаписейПараметрыВР.Отбор.Утверждена.Установить(Истина);		
		НаборЗаписейПараметрыВР.Прочитать();
		НаборЗаписейПараметрыВР.Очистить();
		
		Если Записывать Тогда
			
			НовыйКурс = НаборЗаписейПараметрыВР.Добавить();
			НовыйКурс.Работа = ТекРабота;
			ЗаполнитьЗначенияСвойств(НовыйКурс,СтрокаРаботы);
			НовыйКурс.Период = Ссылка.Дата;
			НовыйКурс.Утверждена = Истина;
			НовыйКурс.Документ = Ссылка;
			
		КонецЕсли;
		
		НаборЗаписейПараметрыВР.Записать();
		
	КонецЦикла;
	
	Если СценарийПланирования.НовыйВариант Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СценарийПланирования",СценарийПланирования);
		Запрос.УстановитьПараметр("КопияСценария",КопияСценария);
		Запрос.УстановитьПараметр("Период",Дата);
		Запрос.УстановитьПараметр("Ответственный",Ответственный);
		Запрос.УстановитьПараметр("Документ",Ссылка);
		Запрос.Текст =
		"ВЫБРАТЬ
