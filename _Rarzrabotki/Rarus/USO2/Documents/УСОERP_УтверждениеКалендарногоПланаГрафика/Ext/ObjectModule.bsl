
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаправлениеДеятельности) Тогда
		НаправлениеДеятельности = ОбъектСтроительства.ОбъектСтроительства.НаправлениеДеятельности;
	КонецЕсли;
		
	Если СценарийПланирования.НовыйВариант И Работы.Количество() Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя изменять документы для сценария, переведенного на новый вариант",,,,Отказ);
		
	КонецЕсли; 		
	
	ПроведениеСерверУТ.УстановитьРежимПроведения(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
	Если Актуальный И (РежимЗаписи = РежимЗаписиДокумента.Проведение ИЛИ РежимЗаписи = РежимЗаписиДокумента.Запись И Проведен) Тогда
		ПроверитьНаСуществующиеДокументы(Отказ);
	КонецЕсли;
	
	УдалитьДанныеИзРегистра(); 
	
КонецПроцедуры

Процедура  ПроверитьНаСуществующиеДокументы(Отказ)
	
	Если СценарийПланирования.НовыйВариант Тогда
		Возврат;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СценарийПланирования",СценарийПланирования);
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.Ссылка
	|ИЗ
	|	Документ.УСОERP_УтверждениеКалендарногоПланаГрафика КАК УСОERP_УтверждениеКалендарногоПланаГрафика
	|ГДЕ
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.Проведен
	|	И УСОERP_УтверждениеКалендарногоПланаГрафика.СценарийПланирования = &СценарийПланирования
	|	И УСОERP_УтверждениеКалендарногоПланаГрафика.Ссылка <> &Ссылка
	|	И УСОERP_УтверждениеКалендарногоПланаГрафика.Актуальный";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий()  Тогда
		
		Отказ = Истина;
		Сообщить("Уже есть актуальные документы ""Внутренний план производства работ"" по сценарию " + СценарийПланирования + ". Необходимо отменить их актуальность.");	
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура УдалитьДанныеИзРегистра()
	
	Если ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ",Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ПараметрыВыполненияРабот.Период,
	|	УСОERP_ПараметрыВыполненияРабот.Работа,
	|	УСОERP_ПараметрыВыполненияРабот.ВидПланирования,
	|	УСОERP_ПараметрыВыполненияРабот.Утверждена,
	|	УСОERP_ПараметрыВыполненияРабот.ОбъемРаботы,
	|	УСОERP_ПараметрыВыполненияРабот.ЕдиницаОбъема,
	|	УСОERP_ПараметрыВыполненияРабот.НачалоРаботыПлан,
	|	УСОERP_ПараметрыВыполненияРабот.ОкончаниеРаботыПлан,
	|	УСОERP_ПараметрыВыполненияРабот.ДлительностьПлан,
	|	УСОERP_ПараметрыВыполненияРабот.ЕдиницаДлительности,
	|	УСОERP_ПараметрыВыполненияРабот.АвторИзменения,
	|	УСОERP_ПараметрыВыполненияРабот.Документ
	|ИЗ
	|	РегистрСведений.УСОERP_ПараметрыВыполненияРабот КАК УСОERP_ПараметрыВыполненияРабот
	|ГДЕ
	|	УСОERP_ПараметрыВыполненияРабот.Документ = &Документ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МЗ = РегистрыСведений.УСОERP_ПараметрыВыполненияРабот.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ,Выборка);
		МЗ.Прочитать();	
		МЗ.Удалить();
		
	КонецЦикла;
	
	Если СценарийПланирования.НовыйВариант Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УСОERP_ПотребностьВМатериалах.Период,
		|	УСОERP_ПотребностьВМатериалах.Работа,
		|	УСОERP_ПотребностьВМатериалах.Номенклатура,
		|	УСОERP_ПотребностьВМатериалах.Характеристика,
		|	УСОERP_ПотребностьВМатериалах.ВидПланирования,
		|	УСОERP_ПотребностьВМатериалах.СценарийПланирования,
		|	УСОERP_ПотребностьВМатериалах.Упаковка,
		|	УСОERP_ПотребностьВМатериалах.КоличествоНаЕдиницуОбъема,
		|	УСОERP_ПотребностьВМатериалах.КоличествоУпаковокНаЕдиницуОбъема,
		|	УСОERP_ПотребностьВМатериалах.КоличествоНаОбъемРаботы,
		|	УСОERP_ПотребностьВМатериалах.КоличествоУпаковокНаОбъемРаботы,
		|	УСОERP_ПотребностьВМатериалах.АвторИзмерения,
		|	УСОERP_ПотребностьВМатериалах.Документ
		|ИЗ
		|	РегистрСведений.УСОERP_ПотребностьВМатериалах КАК УСОERP_ПотребностьВМатериалах
		|ГДЕ
		|	УСОERP_ПотребностьВМатериалах.Документ = &Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УСОERP_ПотребностьВРесурсах.Период,
		|	УСОERP_ПотребностьВРесурсах.Работа,
		|	УСОERP_ПотребностьВРесурсах.Ресурс,
		|	УСОERP_ПотребностьВРесурсах.ВидПланирования,
		|	УСОERP_ПотребностьВРесурсах.СценарийПланирования,
		|	УСОERP_ПотребностьВРесурсах.Количество,
		|	УСОERP_ПотребностьВРесурсах.ЗагрузкаПроцент,
		|	УСОERP_ПотребностьВРесурсах.ГрафикРаботы,
		|	УСОERP_ПотребностьВРесурсах.Трудоемкость,
		|	УСОERP_ПотребностьВРесурсах.Машиноемкость,
		|	УСОERP_ПотребностьВРесурсах.АвторИзмерения,
		|	УСОERP_ПотребностьВРесурсах.Документ
		|ИЗ
		|	РегистрСведений.УСОERP_ПотребностьВРесурсах КАК УСОERP_ПотребностьВРесурсах
		|ГДЕ
		|	УСОERP_ПотребностьВРесурсах.Документ = &Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УСОERP_СвязиМеждуРаботами.Период,
		|	УСОERP_СвязиМеждуРаботами.ОбъектСтроительстваПредшественника,
		|	УСОERP_СвязиМеждуРаботами.РаботаПредшественник,
		|	УСОERP_СвязиМеждуРаботами.РаботаПоследователь,
		|	УСОERP_СвязиМеждуРаботами.СценарийПланирования,
		|	УСОERP_СвязиМеждуРаботами.ТипЗависимости,
		|	УСОERP_СвязиМеждуРаботами.Задержка,
		|	УСОERP_СвязиМеждуРаботами.ЕдиницаЗадержки,
		|	УСОERP_СвязиМеждуРаботами.АвторИзмерения,
		|	УСОERP_СвязиМеждуРаботами.Документ
		|ИЗ
		|	РегистрСведений.УСОERP_СвязиМеждуРаботами КАК УСОERP_СвязиМеждуРаботами
		|ГДЕ
		|	УСОERP_СвязиМеждуРаботами.Документ = &Документ";
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		Выборка = РезультатЗапроса[0].Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			МЗ = РегистрыСведений.УСОERP_ПотребностьВМатериалах.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МЗ,Выборка);
			МЗ.Прочитать();	
			МЗ.Удалить();
			
		КонецЦикла;
		
		Выборка = РезультатЗапроса[1].Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			МЗ = РегистрыСведений.УСОERP_ПотребностьВРесурсах.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МЗ,Выборка);
			МЗ.Прочитать();	
			МЗ.Удалить();
			
		КонецЦикла;
		
		Выборка = РезультатЗапроса[2].Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			МЗ = РегистрыСведений.УСОERP_СвязиМеждуРаботами.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МЗ,Выборка);
			МЗ.Прочитать();	
			
			МЗ.Удалить();
			
		КонецЦикла;  	
		
	КонецЕсли; 	
	
КонецПроцедуры

Процедура УдалитьУтвержденныеРаботы() 	
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Сценарий",СценарийПланирования);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ПараметрыВыполненияРабот.Период,
	|	УСОERP_ПараметрыВыполненияРабот.Работа,
	|	УСОERP_ПараметрыВыполненияРабот.ВидПланирования,
	|	УСОERP_ПараметрыВыполненияРабот.Утверждена,
	|	УСОERP_ПараметрыВыполненияРабот.ОбъемРаботы,
	|	УСОERP_ПараметрыВыполненияРабот.ЕдиницаОбъема,
	|	УСОERP_ПараметрыВыполненияРабот.НачалоРаботыПлан,
	|	УСОERP_ПараметрыВыполненияРабот.ОкончаниеРаботыПлан,
	|	УСОERP_ПараметрыВыполненияРабот.ДлительностьПлан,
	|	УСОERP_ПараметрыВыполненияРабот.ЕдиницаДлительности,
	|	УСОERP_ПараметрыВыполненияРабот.АвторИзменения,
	|	УСОERP_ПараметрыВыполненияРабот.Документ
	|ИЗ
	|	РегистрСведений.УСОERP_ПараметрыВыполненияРабот КАК УСОERP_ПараметрыВыполненияРабот
	|ГДЕ
	|	УСОERP_ПараметрыВыполненияРабот.Утверждена
	|	И УСОERP_ПараметрыВыполненияРабот.Работа.Владелец = &Сценарий
	|	И УСОERP_ПараметрыВыполненияРабот.Документ = ЗНАЧЕНИЕ(Документ.УСОERP_УтверждениеКалендарногоПланаГрафика.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МЗ = РегистрыСведений.УСОERP_ПараметрыВыполненияРабот.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ,Выборка);
		МЗ.Прочитать();	
		МЗ.Удалить();
		
	КонецЦикла; 	
	
КонецПроцедуры  

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если НЕ ЗначениеЗаполнено(КопияСценария) Тогда
		
		Если СценарийПланирования.НовыйВариант = Истина Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не создана копия сценария!",,,,Отказ);
		КонецЕсли;
			
	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	УдалитьУтвержденныеРаботы();

	//ОтменитьПризнакУтверждения();
	
	//// все не суммарные работы
	//НеСуммарныеРаботы = Новый СписокЗначений;
	//Для каждого ТекСтрока Из Работы Цикл
	//	ЭтоСуммарнаяРабота = УСОERP_УправлениеСтроительнымПроизводством.ЭтоСуммарнаяРабота(ТекСтрока.Работа);
	//	Если Не ЭтоСуммарнаяРабота Тогда
	//		НеСуммарныеРаботы.Добавить(ТекСтрока.Работа);
	//	КонецЕсли;
	//КонецЦикла; 
	
	Документы.УСОERP_УтверждениеКалендарногоПланаГрафика.ИнициализироватьДанныеДокумента(Ссылка,  ДополнительныеСвойства);  	
	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	СформироватьСписокРегистровДляКонтроля(); 
	
	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСерверУТ.ВыполнитьКонтрольРезультатовПроведения(ЭтотОбъект, Отказ);    
	
	ПроведениеСерверУТ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
	ДанныеДляПроведения = ДанныеДляПроведения();
	
	СформироватьДвижения(ДанныеДляПроведения);
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	СформироватьСписокРегистровДляКонтроля();
	
	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСерверУТ.ВыполнитьКонтрольРезультатовПроведения(ЭтотОбъект, Отказ);
	
	ПроведениеСерверУТ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
