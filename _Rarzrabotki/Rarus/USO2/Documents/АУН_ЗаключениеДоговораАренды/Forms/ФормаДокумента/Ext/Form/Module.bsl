#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьВидимость()
		
	//Видимость элементов формы на закладке "Депозит"
	Элементы.СуммаДепозита.Видимость = Объект.УчитыватьДепозит;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСуммыПостояннойЧасти()
	
	ИтогоСумма = 0;
	ИтогоВсего = 0;
	ИтогоНДС = 0;
	
	Для Каждого СтрокаТЧ Из Объект.ПостояннаяЧастьАренднойПлаты Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.СтавкаНДС) Тогда
			СтрокаТЧ.СтавкаНДС = ?(ЗначениеЗаполнено(СтрокаТЧ.Номенклатура.СтавкаНДС),СтрокаТЧ.Номенклатура.СтавкаНДС,Объект.Договор.СтавкаНДС);
		КонецЕсли;
		
		СтрокаТЧ.Сумма = Окр(АУН_ОбщиеПроцедуры.ПолучитьСтавку(СтрокаТЧ.Ставка) * СтрокаТЧ.Количество, 2);
		ИтогоСумма = ИтогоСумма + СтрокаТЧ.Сумма;
		ПересчитатьСуммуНДС(СтрокаТЧ, Объект.ЦенаВключаетНДС);
		ИтогоНДС = ИтогоНДС + СтрокаТЧ.СуммаНДС;
		ИтогоВсего = ИтогоВсего + СтрокаТЧ.Всего;
		
	КонецЦикла;
	
	ОбщаяСуммаПостояннойЧасти = ИтогоСумма;
	
КонецПроцедуры

&НаКлиенте
//Процедура предназначена для выравнивания сроков аренды объектов на границы действия договора
Процедура ОбновитьСрокиАренды(ТипИзмененияСроков = 1) // 1 - изменены и даты начала и дата окончания; 2 - только дата начала; 3 - только дата окончания
	
	Для Каждого СтрокаТЧ Из Объект.ПостояннаяЧастьАренднойПлаты Цикл
		Если ТипИзмененияСроков = 1 Тогда
			СтрокаТЧ.ДатаНачалаСрокаАренды = Объект.ДатаЗаключенияДоговора;
			СтрокаТЧ.ДатаОкончанияСрокаАренды = Объект.ДатаОкончанияДоговора;
		ИначеЕсли ТипИзмененияСроков = 2 Тогда
			СтрокаТЧ.ДатаНачалаСрокаАренды = Объект.ДатаЗаключенияДоговора;
		Иначе
			СтрокаТЧ.ДатаОкончанияСрокаАренды = Объект.ДатаОкончанияДоговора;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаТЧ Из Объект.ПеременнаяЧастьАренднойПлаты Цикл
		Если ТипИзмененияСроков = 1 Тогда
			СтрокаТЧ.ДатаНачалаСрокаАренды = Объект.ДатаЗаключенияДоговора;
			СтрокаТЧ.ДатаОкончанияСрокаАренды = Объект.ДатаОкончанияДоговора;
		ИначеЕсли ТипИзмененияСроков = 2 Тогда
			СтрокаТЧ.ДатаНачалаСрокаАренды = Объект.ДатаЗаключенияДоговора;
		Иначе
			СтрокаТЧ.ДатаОкончанияСрокаАренды = Объект.ДатаОкончанияДоговора;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставитьСоСрокамиДоговора(Значение)
	
	Если Значение < Объект.ДатаЗаключенияДоговора Тогда
		Значение = Объект.ДатаЗаключенияДоговора;
	ИначеЕсли Значение > Объект.ДатаОкончанияДоговора Тогда
		Значение = Объект.ДатаОкончанияДоговора;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьВсего(ТекущиеДанные, ЦенаВключаетНДС)

	ТекущиеДанные.Всего = ТекущиеДанные.Сумма + ?(ЦенаВключаетНДС, 0, ТекущиеДанные.СуммаНДС);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммуНДС(ТекущиеДанные, ЦенаВключаетНДС)

	//ТекПроцентНДС = ЦенообразованиеКлиентСервер.ПолучитьСтавкуНДСЧислом(ТекущиеДанные.СтавкаНДС);
	ТекущиеДанные.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(ТекущиеДанные.Сумма, ТекущиеДанные.СтавкаНДС, ЦенаВключаетНДС);
	ПересчитатьВсего(ТекущиеДанные, ЦенаВключаетНДС);
	
КонецПроцедуры

#Область ПриИзмененииРеквизитов

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	
	КонтрагентОбработатьИзменение();

КонецПроцедуры

&НаСервере
Процедура КонтрагентОбработатьИзменение()

	СписокВидовДоговоров = Новый Массив;
	СписокВидовДоговоров.Добавить(ПредопределенноеЗначение("Перечисление.ТипыДоговоров.СПокупателем"));
	
	СписокВидовДоговоров.Добавить(ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РеализацияКлиенту"));
	
	СтруктураОтбора = Новый Структура("ЗначениеОтбора", Истина); 
	СтруктураПараметров = Новый Структура("АУН_АрендныйДоговор", СтруктураОтбора);
	
	БухгалтерскийУчетПереопределяемый.УстановитьДоговорКонтрагента(
		Объект.Договор, Объект.Контрагент, Объект.Организация, 
		СписокВидовДоговоров, СтруктураПараметров);
		
	Объект.НаправлениеДеятельности = Объект.Договор.НаправлениеДеятельности;

КонецПроцедуры

&НаСервере
Процедура ПартнерПриИзмененииНаСервере()
	
	ПартнерыИКонтрагенты.ЗаполнитьКонтрагентаПартнераПоУмолчанию(Объект.Партнер, Объект.Контрагент);
	КонтрагентОбработатьИзменение();
	
КонецПроцедуры

#КонецОбласти

#Область ПриИзмененииРеквизитовТабличнойЧасти

&НаКлиенте
Процедура ПриВыбореОбъектаАренды(ТекСтрока,ИмяТЧ)
	
	ТекСтрока.Количество = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ТекСтрока.ОбъектАренды, "ОбщаяПлощадь");
	
	ЗаполнитьДанныеПоСтроке(Элементы[ИмяТЧ].ТекущиеДанные.ПолучитьИдентификатор(),ИмяТЧ);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоСтроке(ИдСтроки,ИмяТЧ)
	
	ТекСтрока = Объект[ИмяТЧ].НайтиПоИдентификатору(ИдСтроки);
	СтруктураОтбора = Новый Структура("ОбъектНедвижимости",ТекСтрока.ОбъектАренды); 	
	
	НЗ = РегистрыСведений.УПН_ПлощадиОбъектовНедвижимости.СрезПоследних(Объект.Дата,СтруктураОтбора);
	
	Если НЗ.Количество() Тогда
		ТекСтрока.Количество = НЗ.Получить(0).ОбщаяПлощадь;
	КонецЕсли;   	
	
КонецПроцедуры  

&НаКлиенте
Процедура ПриИзмененииУслуги(ТекущиеДанные)
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Количество) Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Прочее

&НаКлиенте
Процедура ОбновитьСрокиАрендыСпроситьОбИзменении(ТекстВопроса, ВариантДействия)
	
	ДополнительныеПараметры = Новый Структура("ВариантДействия", ВариантДействия);
	Оповещение = Новый ОписаниеОповещения("ОбновитьСрокиАрендыЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет, "Вопрос");	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСрокиАрендыЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОбновитьСрокиАренды(ДополнительныеПараметры.ВариантДействия);		
	КонецЕсли;                                                       	
		
КонецПроцедуры

&НаКлиенте
Процедура ВыборПериодаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		Объект.ДатаЗаключенияДоговора = Результат.ДатаНачала;
		Объект.ДатаОкончанияДоговора = Результат.ДатаОкончания;	
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДатаОкончанияДоговора) И Объект.ДатаОкончанияДоговора < Объект.ДатаЗаключенияДоговора Тогда
		ТекстСообщения = "Дата окончания договора не может быть меньше даты заключения договора";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, "ДатаЗаключенияДоговора");
		Объект.ДатаЗаключенияДоговора = '00010101';
		Возврат;
	КонецЕсли;		
	
	Если (Объект.ПостояннаяЧастьАренднойПлаты.Количество()>0 ИЛИ
		Объект.ПеременнаяЧастьАренднойПлаты.Количество()>0) Тогда
		ОбновитьСрокиАрендыСпроситьОбИзменении("Выровнять сроки аренды по периоду действия договора?", 1);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	ДоговорПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДоговорПриИзмененииНаСервере()
	Объект.НаправлениеДеятельности = Объект.Договор.НаправлениеДеятельности;
КонецПроцедуры

&НаКлиенте
Процедура ДоговорОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		
		Если ВыбранноеЗначение <> ТекущийДоговор Тогда
		
		Объект.Договор = ВыбранноеЗначение;
		
		Если ПолучитьСтавкуНДСПоДоговору(Объект.Договор) <> ПолучитьСтавкуНДСПоДоговору(ТекущийДоговор) Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ДоговорОбработкаВыбораПродолжение",ЭтотОбъект);
		
		Если Объект.ПостояннаяЧастьАренднойПлаты.Количество()+Объект.ПеременнаяЧастьАренднойПлаты.Количество() Тогда
			
			ПоказатьВопрос(ОписаниеОповещения,"Изменить ставку НДС в табличных частях?",РежимДиалогаВопрос.ДаНет);
			
		КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;
	
	ТекущийДоговор = Объект.Договор;
	
	ДоговорПриИзменении(Элемент);
	
КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорОбработкаВыбораПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтавкаНДС = ПолучитьСтавкуНДСПоДоговору(Объект.Договор);
	
	Для Каждого СтрокаТЧ ИЗ Объект.ПостояннаяЧастьАренднойПлаты Цикл
		
		СтрокаТЧ.СтавкаНДС = ТекСтавкаНДС;
		//СтрокаТЧ.Ставка = ПолучитьСтавку(Объект.Дата,СтрокаТЧ.ОбъектАренды,СтрокаТЧ.Номенклатура,Объект.Договор,СтрокаТЧ.СпособНачисления,СтрокаТЧ.Ставка);
		
	КонецЦикла;	
	
	Для Каждого СтрокаТЧ ИЗ Объект.ПеременнаяЧастьАренднойПлаты Цикл
		
		СтрокаТЧ.СтавкаНДС = ТекСтавкаНДС;
		//ПолучитьСтавку(Объект.Дата,СтрокаТЧ.ОбъектАренды,СтрокаТЧ.Номенклатура,Объект.Договор,СтрокаТЧ.СпособНачисления,СтрокаТЧ.Ставка);
		
	КонецЦикла;

	ЗаполнитьСуммыПостояннойЧасти();
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтавкуНДСПоДоговору(Договор)
	
	Возврат ?(ЗначениеЗаполнено(Договор.СтавкаНДС),Договор.СтавкаНДС,Перечисления.СтавкиНДС.БезНДС);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСтавку(Дата,ОбъектАренды,Услуга,Договор,СпособНачисления,ТекущаяСтавка)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Дата",?(ЗначениеЗаполнено(Дата),Дата,ТекущаяДата()));
	Запрос.УстановитьПараметр("Услуга",Услуга);
	Запрос.УстановитьПараметр("Договор",Договор);
	Запрос.УстановитьПараметр("ОбъектАренды",ОбъектАренды);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АУН_СтавкиСрезПоследних.Ставка КАК Ставка
	|ИЗ
	|	РегистрСведений.АУН_Ставки.СрезПоследних(
	|			&Дата,
	|			Услуга = &Услуга
	|				И ОбъектАренды = &ОбъектАренды
	|				И Договор = &Договор) КАК АУН_СтавкиСрезПоследних";
	
	Выборка = ЗАпрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ставка;
	КонецЕсли;
		
	Возврат ТекущаяСтавка;
	
КонецФункции

#КонецОбласти

&НаСервереБезКонтекста
Функция ПолучитьПризнакВключенияНДСВЦенуИзСоглашения(Соглашение)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка", Соглашение);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоглашенияСКлиентами.ЦенаВключаетНДС КАК ЦенаВключаетНДС
	|ИЗ
	|	Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
	|ГДЕ
	|	СоглашенияСКлиентами.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.ЦенаВключаетНДС;
		
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // ПолучитьПризнакВключенияНДСВЦенуИзСоглашения()

#КонецОбласти
