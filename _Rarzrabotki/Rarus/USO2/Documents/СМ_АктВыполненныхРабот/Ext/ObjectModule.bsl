
Перем ПометкаУдаленияДо;

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// sudav - вынесено в модуль менеджера
	Документы.СМ_АктВыполненныхРабот.Перерасчет(ЭтотОбъект);

	СсылкаНаТекущийДокумент = СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(ЭтотОбъект);
	
	ТабПозиций = ТаблицаВыполненийПоАктуПоСмете(СсылкаНаТекущийДокумент);
	
	Документы.СМ_АктВыполненныхРабот.КонтрольОстатков(СсылкаНаТекущийДокумент,ТабПозиций,Отказ);
	
	Если Не Отказ Тогда
			
		СМ_УчетВыполненныхРаботВызовСервера.ЗаполнитьФактическийРасход(Движения.СМ_ВыполнениеПоСмете, ТабПозиций, СсылкаНаТекущийДокумент);
	Иначе
		
		СМ_СметаВызовСервера.УдалитьДвижения(СсылкаНаТекущийДокумент);
		
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// sudav - вынесено в модуль менеджера
	Документы.СМ_АктВыполненныхРабот.Перерасчет(ЭтотОбъект);
	
	СМ_УчетВыполненныхРаботВызовСервера.ЗаполнитьФактическийРасход(Движения.СМ_ВыполнениеПоСмете, Новый ТаблицаЗначений());
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка  Тогда
		Возврат;
	КонецЕсли;

	ПометкаУдаленияДо = Ссылка.ПометкаУдаления;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка  Тогда
		Возврат;
	КонецЕсли;

	Если ЭтотОбъект.ПометкаУдаления <> ПометкаУдаленияДо Тогда
		// Устанавливаем пометку удаления
		Если ЭтотОбъект.ПометкаУдаления Тогда
			СМ_СметаВызовСервера.УстановитьСнятьПометкуУдаления(ЭтотОбъект,,Ложь);
		// Снимаем пометку удаления	
		Иначе
			СнятиеПометки = Истина;
			СМ_СметаВызовСервера.УстановитьСнятьПометкуУдаления(ЭтотОбъект,СнятиеПометки,Ложь);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеФункции

Функция ТаблицаВыполненийПоАктуПоСмете(СсылкаНаАкт)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	АктВыполненныхРаботПозиции.Позиция,
	|	АктВыполненныхРаботПозиции.ФактОбъем
	|ИЗ
	|	Документ.СМ_АктВыполненныхРабот.Позиции КАК АктВыполненныхРаботПозиции
	|ГДЕ
	|	АктВыполненныхРаботПозиции.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаАкт);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти
