#Область РасчетАкта

Процедура ВыполнитьРасчетТекущейЛокальнойСметы(Ссылка)
	
	СМ_СметаРасчетВызовСервера.СформироватьИтогиПоВидамРабот(Ссылка);
	СМ_СметаРасчетВызовСервера.СформироватьИтогиПоСмете(Ссылка);	
	СМ_СметаРасчетВызовСервера.РассчитатьЛимитированныеЗатраты(Ссылка);
	
КонецПроцедуры

Процедура ВыполнитьРасчет(ОбъектАкт, РазделыУжеРассчитаны = Ложь)
	
	Если Не РазделыУжеРассчитаны Тогда
		
		// Получаем подчиненные разделу позиции локальной сметы
		ТабРезультат = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(ОбъектАкт.ЛокальнаяСмета, Ложь, Истина, Истина, Ложь);
		Для Каждого ТекСтрока Из ТабРезультат Цикл
			// Пересчитываем позиции локальной сметы
			ТекОбъект = ТекСтрока.Ид.ПолучитьОбъект();
			Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(ТекОбъект, Истина, ОбъектАкт.Ссылка);
		КонецЦикла;
		
		// Получаем подчиненные разделу позиции локальной сметы
		ТабРезультат = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(ОбъектАкт.ЛокальнаяСмета, Истина, Ложь, Ложь, Ложь);
		Для Каждого ТекСтрока Из ТабРезультат Цикл
			// Пересчитываем разделы локальной сметы
			ТекОбъект = ТекСтрока.Ид.ПолучитьОбъект();
			Документы.СМ_РазделЛокальнойСметы.Перерасчет(ТекОбъект, Ложь, Истина, ОбъектАкт.Ссылка);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ОбъектАкт.Проведен Тогда
		ВыполнитьРасчетТекущейЛокальнойСметы(ОбъектАкт.Ссылка);
	Иначе
		СМ_СметаВызовСервера.УдалитьДвижения(ОбъектАкт.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

// Основная процедура расчета акта, выполняет пересчет акта
// ПАРАМЕТРЫ:
//  Объект - ДокументОбъект.СМ_АктВыполненныхРабот или ДокументСсылка.СМ_АктВыполненныхРабот
//  РазделыУжеРассчитаны - Истина - разделы уже рассчитаны и их пересчет не требуется, 
//  					   Ложь - требуется пересчет подчиненных разделов.
Процедура Перерасчет(Объект, РазделыУжеРассчитаны = Ложь) Экспорт
	
	ВыполнитьРасчет(Объект, РазделыУжеРассчитаны);
		
КонецПроцедуры

