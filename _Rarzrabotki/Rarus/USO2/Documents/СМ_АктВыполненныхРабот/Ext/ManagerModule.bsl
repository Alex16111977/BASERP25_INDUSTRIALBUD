Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
     СтандартнаяОбработка = Ложь;
     Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Акт №%1 по смете №%2 %3'"), Строка(Данные.НомерАкта), Строка(Данные.ЛокальнаяСмета.НомерСметы), Строка(Данные.ЛокальнаяСмета.Наименование));
	 
 КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	 
     СтандартнаяОбработка = Ложь;

     Поля.Добавить("НомерАкта");
	 Поля.Добавить("Наименование");
	 Поля.Добавить("ЛокальнаяСмета");
	 
 КонецПроцедуры
// ДокторСофт

#КонецОбласти

#Область СлужебныеПроцедуры

Процедура КонтрольОстатков(ТекущийДокумент,ТабПозиций,Отказ) Экспорт
	
	ПараметрыКонтроляЛимитов = СМ_КонтрольЛимитовВызовСервера.ПараметрыКонтроляЛимитов(ТекущийДокумент.Стройка);
	
	Если Не ПараметрыКонтроляЛимитов.КонтролироватьОстатокПоАкту Тогда
		Возврат;
	КонецЕсли;
	
	// Контроль РН.
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СМ_ВыполнениеПоСметеОстатки.Позиция КАК ПозицияЛС,
	|	ЕСТЬNULL(СМ_ВыполнениеПоСметеОстатки.ОбъемОстаток, 0) КАК ОбъемОстаток
	|ИЗ
	|	РегистрНакопления.СМ_ВыполнениеПоСмете.Остатки(&МоментДокумента, ЛокальнаяСмета = &Смета) КАК СМ_ВыполнениеПоСметеОстатки";
				   
	Запрос.УстановитьПараметр("МоментДокумента",Новый Граница (ТекущийДокумент.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Смета",ТекущийДокумент.ЛокальнаяСмета);
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекСтрока Из ТабПозиций Цикл
		НайденнаяСтрока = ТабРезультат.Найти(ТекСтрока.Позиция,"ПозицияЛС");
		Если НайденнаяСтрока <> Неопределено Тогда
			Если ТекСтрока.ФактОбъем > НайденнаяСтрока.ОбъемОстаток 
				И НайденнаяСтрока.ОбъемОстаток>=0 Тогда
				ТекстСообщения = НСтр("ru = 'Превышен остаток объема по позиции %Смета% на %Количество% единиц'");
				ПредставлениеСметы = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='№%1 шифр %2 %3'"),Строка(ТекСтрока.Позиция.ПорНомер),Строка(ТекСтрока.Позиция.ШифрРасценки),Строка(ТекСтрока.Позиция.Наименование));
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Смета%",ПредставлениеСметы);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Количество%",ТекСтрока.ФактОбъем  - ?(НайденнаяСтрока.ОбъемОстаток < 0,0,НайденнаяСтрока.ОбъемОстаток));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,ТекущийДокумент); 
				Если ПараметрыКонтроляЛимитов.ЗапретитьПроведениеАктаПревышениеЛимитаСметы Тогда
					Отказ = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Контроль РС.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ИтогиПоСмете.Смета.ЛокальнаяСмета,
	               |	СУММА(СМ_ИтогиПоСмете.ВозвратМатер) КАК ВозвратМатер,
	               |	СУММА(СМ_ИтогиПоСмете.ЗарплМашин) КАК ЗарплМашин,
	               |	СУММА(СМ_ИтогиПоСмете.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
	               |	СУММА(СМ_ИтогиПоСмете.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
	               |	СУММА(СМ_ИтогиПоСмете.Оборуд) КАК Оборуд,
	               |	СУММА(СМ_ИтогиПоСмете.ОснЗарплата) КАК ОснЗарплата,
	               |	СУММА(СМ_ИтогиПоСмете.ПрямЗатраты) КАК ПрямЗатраты,
	               |	СУММА(СМ_ИтогиПоСмете.СтоимМатер) КАК СтоимМатер,
	               |	СУММА(СМ_ИтогиПоСмете.ТекВозвратМатер) КАК ТекВозвратМатер,
	               |	СУММА(СМ_ИтогиПоСмете.ТекЗарплМашин) КАК ТекЗарплМашин,
	               |	СУММА(СМ_ИтогиПоСмете.ТекОборуд) КАК ТекОборуд,
	               |	СУММА(СМ_ИтогиПоСмете.ТекОснЗарплата) КАК ТекОснЗарплата,
	               |	СУММА(СМ_ИтогиПоСмете.ТекПрямЗатраты) КАК ТекПрямЗатраты,
	               |	СУММА(СМ_ИтогиПоСмете.ТекСтоимМатер) КАК ТекСтоимМатер,
	               |	СУММА(СМ_ИтогиПоСмете.ТекЭксплМашин) КАК ТекЭксплМашин,
	               |	СУММА(СМ_ИтогиПоСмете.ЭксплМашин) КАК ЭксплМашин,
	               |	СМ_ИтогиПоСмете.Итог
	               |ПОМЕСТИТЬ ДанныеПоАктам
	               |ИЗ
	               |	РегистрСведений.СМ_ИтогиПоСмете КАК СМ_ИтогиПоСмете
	               |ГДЕ
	               |	СМ_ИтогиПоСмете.Смета ССЫЛКА Документ.СМ_АктВыполненныхРабот
	               |	И СМ_ИтогиПоСмете.Смета.ЛокальнаяСмета = &ЛокальнаяСмета
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_ИтогиПоСмете.Смета.ЛокальнаяСмета,
	               |	СМ_ИтогиПоСмете.Итог
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СМ_ИтогиПоСмете.Итог КАК Итог,
	               |	СУММА(СМ_ИтогиПоСмете.ВозвратМатер - ЕСТЬNULL(ДанныеПоАктам.ВозвратМатер, 0)) КАК ВозвратМатер,
	               |	СУММА(СМ_ИтогиПоСмете.ЗарплМашин - ЕСТЬNULL(ДанныеПоАктам.ЗарплМашин, 0)) КАК ЗарплМашин,
	               |	СУММА(СМ_ИтогиПоСмете.ЗатратыТрудаМашин - ЕСТЬNULL(ДанныеПоАктам.ЗатратыТрудаМашин, 0)) КАК ЗатратыТрудаМашин,
	               |	СУММА(СМ_ИтогиПоСмете.ЗатратыТрудаРабочих - ЕСТЬNULL(ДанныеПоАктам.ЗатратыТрудаРабочих, 0)) КАК ЗатратыТрудаРабочих,
	               |	СУММА(СМ_ИтогиПоСмете.Оборуд - ЕСТЬNULL(ДанныеПоАктам.Оборуд, 0)) КАК Оборуд,
	               |	СУММА(СМ_ИтогиПоСмете.ОснЗарплата - ЕСТЬNULL(ДанныеПоАктам.ОснЗарплата, 0)) КАК ОснЗарплата,
	               |	СУММА(СМ_ИтогиПоСмете.ПрямЗатраты - ЕСТЬNULL(ДанныеПоАктам.ПрямЗатраты, 0)) КАК ПрямЗатраты,
	               |	СУММА(СМ_ИтогиПоСмете.СтоимМатер - ЕСТЬNULL(ДанныеПоАктам.СтоимМатер, 0)) КАК СтоимМатер,
	               |	СУММА(СМ_ИтогиПоСмете.ТекВозвратМатер - ЕСТЬNULL(ДанныеПоАктам.ТекВозвратМатер, 0)) КАК ТекВозвратМатер,
	               |	СУММА(СМ_ИтогиПоСмете.ТекЗарплМашин - ЕСТЬNULL(ДанныеПоАктам.ТекЗарплМашин, 0)) КАК ТекЗарплМашин,
	               |	СУММА(СМ_ИтогиПоСмете.ТекОборуд - ЕСТЬNULL(ДанныеПоАктам.ТекОборуд, 0)) КАК ТекОборуд,
	               |	СУММА(СМ_ИтогиПоСмете.ТекОснЗарплата - ЕСТЬNULL(ДанныеПоАктам.ТекОснЗарплата, 0)) КАК ТекОснЗарплата,
	               |	СУММА(СМ_ИтогиПоСмете.ТекПрямЗатраты - ЕСТЬNULL(ДанныеПоАктам.ТекПрямЗатраты, 0)) КАК ТекПрямЗатраты,
	               |	СУММА(СМ_ИтогиПоСмете.ТекСтоимМатер - ЕСТЬNULL(ДанныеПоАктам.ТекСтоимМатер, 0)) КАК ТекСтоимМатер,
	               |	СУММА(СМ_ИтогиПоСмете.ТекЭксплМашин - ЕСТЬNULL(ДанныеПоАктам.ТекЭксплМашин, 0)) КАК ТекЭксплМашин,
	               |	СУММА(СМ_ИтогиПоСмете.ЭксплМашин - ЕСТЬNULL(ДанныеПоАктам.ЭксплМашин, 0)) КАК ЭксплМашин
	               |ИЗ
	               |	РегистрСведений.СМ_ИтогиПоСмете КАК СМ_ИтогиПоСмете
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеПоАктам КАК ДанныеПоАктам
	               |		ПО СМ_ИтогиПоСмете.Смета = ДанныеПоАктам.СметаЛокальнаяСмета
	               |			И СМ_ИтогиПоСмете.Итог = ДанныеПоАктам.Итог
	               |ГДЕ
	               |	СМ_ИтогиПоСмете.Смета ССЫЛКА Документ.СМ_ЛокальнаяСмета
	               |	И СМ_ИтогиПоСмете.Смета = &ЛокальнаяСмета
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_ИтогиПоСмете.Итог
	               |ИТОГИ
	               |	СУММА(ВозвратМатер),
	               |	СУММА(ЗарплМашин),
	               |	СУММА(ЗатратыТрудаМашин),
	               |	СУММА(ЗатратыТрудаРабочих),
	               |	СУММА(Оборуд),
	               |	СУММА(ОснЗарплата),
	               |	СУММА(ПрямЗатраты),
	               |	СУММА(СтоимМатер),
	               |	СУММА(ТекВозвратМатер),
	               |	СУММА(ТекЗарплМашин),
	               |	СУММА(ТекОборуд),
	               |	СУММА(ТекОснЗарплата),
	               |	СУММА(ТекПрямЗатраты),
	               |	СУММА(ТекСтоимМатер),
	               |	СУММА(ТекЭксплМашин),
	               |	СУММА(ЭксплМашин)
	               |ПО
	               |	Итог";
	Запрос.УстановитьПараметр("ЛокальнаяСмета",ТекущийДокумент.ЛокальнаяСмета);
	ВыборкаИтог = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	РегИзмер = Метаданные.РегистрыСведений.СМ_ИтогиПоСмете.Ресурсы;
	Пока ВыборкаИтог.Следующий() Цикл
		Выборка = ВыборкаИтог.Выбрать();
		Пока Выборка.Следующий() Цикл
			Для Каждого Изм Из РегИзмер Цикл
				Если Выборка[Изм.Имя]<0 Тогда
					ТекстСообщения = НСтр("ru = 'Превышен остаток %Ресурс% по итогу %Итог% по смете %Смета% на %Количество% единиц'");
					ПредставлениеСметы = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Смета №%1 %2'"),Строка(ТекущийДокумент.ЛокальнаяСмета.НомерСметы),Строка(ТекущийДокумент.ЛокальнаяСмета.Наименование));
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Ресурс%",Изм);
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Итог%",ВыборкаИтог.Итог);
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Смета%",ПредставлениеСметы);
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Количество%",-Выборка[Изм.Имя]);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,ТекущийДокумент); 
					Если ПараметрыКонтроляЛимитов.ЗапретитьПроведениеАктаПревышениеЛимитаСметы Тогда
						Отказ = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
    КонецЦикла
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыОбменWS

Процедура ЗаполнитьОстаткиПоАкту(ТекущийДокумент,Стройка) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ресурс
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	Документ.СМ_АктВыполненныхРабот.РесурсыПозицийАкта КАК СМ_АктВыполненныхРаботРесурсыПозицийАкта
	                      |ГДЕ
	                      |	СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ссылка = &Акт
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	СМ_WS_БуферЗагрузки.ОбъектСтроительства,
	                      |	СМ_WS_БуферЗагрузки.Ресурс,
	                      |	СМ_WS_БуферЗагрузки.ПредставлениеОбъекта1 КАК Код,
	                      |	СМ_WS_БуферЗагрузки.ПредставлениеОбъекта КАК Наименование,
	                      |	СУММА(СМ_WS_БуферЗагрузки.ЧисловойПараметр1) КАК Остаток,
	                      |	СМ_WS_БуферЗагрузки.GUID
	                      |ИЗ
	                      |	РегистрСведений.СМ_WS_БуферЗагрузки КАК СМ_WS_БуферЗагрузки
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	                      |		ПО СМ_WS_БуферЗагрузки.Ресурс = ВТ.Ресурс
	                      |ГДЕ
	                      |	СМ_WS_БуферЗагрузки.ТипОбъекта = ""balance""
	                      |	И СМ_WS_БуферЗагрузки.ОбъектСтроительства = &ОбъектСтроительства
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	СМ_WS_БуферЗагрузки.ОбъектСтроительства,
	                      |	СМ_WS_БуферЗагрузки.Ресурс,
	                      |	СМ_WS_БуферЗагрузки.ПредставлениеОбъекта1,
	                      |	СМ_WS_БуферЗагрузки.ПредставлениеОбъекта,
	                      |	СМ_WS_БуферЗагрузки.GUID");
						  
Запрос.УстановитьПараметр("ОбъектСтроительства",Стройка);
Запрос.УстановитьПараметр("Акт",ТекущийДокумент);

Рез=Запрос.Выполнить().Выбрать();

Набор=РегистрыСведений.СМ_WS_ОстаткиПоАкту.СоздатьНаборЗаписей();
Набор.Отбор.Акт.Установить(ТекущийДокумент); 
Набор.Очистить();

Пока Рез.Следующий() Цикл
	Запись=Набор.Добавить();
	ЗаполнитьЗначенияСвойств(Запись,Рез);
	Запись.Акт=ТекущийДокумент;
КонецЦикла;
Набор.Записать();


КонецПроцедуры

Процедура ДобавитьОстаткиПоАкту(ТекущийДокумент,Стройка) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ресурс
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	Документ.СМ_АктВыполненныхРабот.РесурсыПозицийАкта КАК СМ_АктВыполненныхРаботРесурсыПозицийАкта
	                      |ГДЕ
	                      |	СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ссылка = &Акт
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	СМ_WS_БуферЗагрузки.ОбъектСтроительства,
	                      |	СМ_WS_БуферЗагрузки.Ресурс,
	                      |	СМ_WS_БуферЗагрузки.ПредставлениеОбъекта1 КАК Код,
	                      |	СМ_WS_БуферЗагрузки.ПредставлениеОбъекта КАК Наименование,
	                      |	СУММА(СМ_WS_БуферЗагрузки.ЧисловойПараметр1) КАК Остаток,
	                      |	СМ_WS_БуферЗагрузки.GUID
	                      |ИЗ
	                      |	РегистрСведений.СМ_WS_БуферЗагрузки КАК СМ_WS_БуферЗагрузки
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	                      |		ПО СМ_WS_БуферЗагрузки.Ресурс = ВТ.Ресурс
	                      |			И (СМ_WS_БуферЗагрузки.ТипОбъекта = ""balance"")
	                      |			И (СМ_WS_БуферЗагрузки.ОбъектСтроительства = &ОбъектСтроительства)
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_WS_ОстаткиПоАкту КАК СМ_WS_ОстаткиПоАкту
	                      |		ПО СМ_WS_БуферЗагрузки.Ресурс = СМ_WS_ОстаткиПоАкту.Ресурс
	                      |			И (СМ_WS_ОстаткиПоАкту.Акт = &Акт)
	                      |ГДЕ
	                      |	СМ_WS_ОстаткиПоАкту.Остаток ЕСТЬ NULL 
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	СМ_WS_БуферЗагрузки.ОбъектСтроительства,
	                      |	СМ_WS_БуферЗагрузки.Ресурс,
	                      |	СМ_WS_БуферЗагрузки.ПредставлениеОбъекта1,
	                      |	СМ_WS_БуферЗагрузки.ПредставлениеОбъекта,
	                      |	СМ_WS_БуферЗагрузки.GUID");
						  
Запрос.УстановитьПараметр("ОбъектСтроительства",Стройка);
Запрос.УстановитьПараметр("Акт",ТекущийДокумент);

Рез=Запрос.Выполнить().Выбрать();



Пока Рез.Следующий() Цикл
	Запись=РегистрыСведений.СМ_WS_ОстаткиПоАкту.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Запись,Рез);
	Запись.Акт=ТекущийДокумент;
	Запись.Записать();
КонецЦикла;



КонецПроцедуры

Функция НетОстатковПоАкту(ТекущийДокумент) Экспорт
		Запрос=Новый Запрос("ВЫБРАТЬ  ПЕРВЫЕ 1
		                    |	СМ_WS_ОстаткиПоАкту.Ресурс
		                    |ИЗ
		                    |	РегистрСведений.СМ_WS_ОстаткиПоАкту КАК СМ_WS_ОстаткиПоАкту
		                    |ГДЕ
		                    |	СМ_WS_ОстаткиПоАкту.Акт = &Акт");
		Запрос.УстановитьПараметр("Акт",ТекущийДокумент);	
		Рез=Запрос.Выполнить();
		Возврат Рез.Пустой();
КонецФункции

Функция ПолучитьОстаткиРесурсов(ТекущийДокумент) Экспорт
	Запрос=Новый Запрос("ВЫБРАТЬ 
	                    |	СМ_WS_ОстаткиПоАкту.Ресурс,
	                    |	СМ_WS_ОстаткиПоАкту.Код,
	                    |	СМ_WS_ОстаткиПоАкту.Наименование,
	                    |	СМ_WS_ОстаткиПоАкту.Остаток
	                    |ИЗ
	                    |	РегистрСведений.СМ_WS_ОстаткиПоАкту КАК СМ_WS_ОстаткиПоАкту
	                    |ГДЕ
	                    |	СМ_WS_ОстаткиПоАкту.Акт = &Акт");
		Запрос.УстановитьПараметр("Акт",ТекущийДокумент);	
		Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

