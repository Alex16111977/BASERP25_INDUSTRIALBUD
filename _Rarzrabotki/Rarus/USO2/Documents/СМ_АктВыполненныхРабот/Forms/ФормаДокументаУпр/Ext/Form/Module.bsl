&НаКлиенте
Функция ОписаниеНастройки(Объект, Настойка, Значение)
	
	Элемент = Новый Структура;
	Элемент.Вставить("Объект", Объект);
	Элемент.Вставить("Настройка", Настойка);
	Элемент.Вставить("Значение", Значение);
	
	Возврат Элемент;
	
КонецФункции

&НаСервере
Функция ПолучитьУзлыПоУмолчанию()
    СписокУзлов = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнойУзелМП");
	Возврат СписокУзлов;
КонецФункции

&НаСервере
Процедура МобильноеНаСервере(СписокУзлов)
	Для каждого ВыбУзел Из СписокУзлов Цикл
		Если ВыбУзел.Значение.Ссылка =  ПланыОбмена.СМ_ОбменСметаМобильное.ЭтотУзел() ИЛИ ВыбУзел.Значение.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		НайденаЛС = ВыбУзел.Значение.ДокументыДляОбмена.Найти(Объект.Ссылка,"ДокументОтбор");
		Если НайденаЛС = Неопределено Тогда
			Узел = ВыбУзел.Значение.ПолучитьОбъект();
			Стр = Узел.ДокументыДляОбмена.Добавить();
			Стр.ДокументОтбор = Объект.Ссылка;
			Если Не Объект.ЛокальнаяСмета.Пустая() Тогда
				Стр = Узел.ДокументыДляОбмена.Добавить();
				Стр.ДокументОтбор = Объект.ЛокальнаяСмета.Ссылка;
			КонецЕсли;
			Узел.Записать();
		КонецЕсли;
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СМ_ОбменСметаМобильноеДокументыДляОбмена.Ссылка
	|ИЗ
	|	ПланОбмена.СМ_ОбменСметаМобильное.ДокументыДляОбмена КАК СМ_ОбменСметаМобильноеДокументыДляОбмена
	|ГДЕ
	|	СМ_ОбменСметаМобильноеДокументыДляОбмена.ДокументОтбор = &Док";
	Запрос.УстановитьПараметр("Док",Объект.Ссылка);
	МассивУзлов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов,Объект.Ссылка);
	Если МассивУзлов.Количество()>0 Тогда
		Если Не Объект.ЛокальнаяСмета.Пустая() Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов,Объект.ЛокальнаяСмета.Ссылка);
			СМ_ОбменСМобильнымСервер.РегистрацияПозицийРазделов(МассивУзлов,Объект.ЛокальнаяСмета.Ссылка)
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЕстьУзлы()
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	СМ_ОбменСметаМобильноеДокументыДляОбмена.Ссылка
		|ИЗ
		|	ПланОбмена.СМ_ОбменСметаМобильное.ДокументыДляОбмена КАК СМ_ОбменСметаМобильноеДокументыДляОбмена
		|ГДЕ
		|	СМ_ОбменСметаМобильноеДокументыДляОбмена.ДокументОтбор = &Док";
		Запрос.УстановитьПараметр("Док",Объект.Ссылка);
		Результат = Запрос.Выполнить();
		Возврат Результат.Пустой();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ВидимостьМобильнойКнопки() 
	ЕстьУзлы = ЕстьУзлы();
    Элементы.Мобильное.Видимость =  ?(ЕстьУзлы = Неопределено,Ложь,ЕстьУзлы);
	Элементы.УбратьМобильное.Видимость = ?(ЕстьУзлы = Неопределено,Ложь,Не ЕстьУзлы);
КонецПроцедуры

&НаСервере
Процедура УбратьМобильноеНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СМ_ОбменСметаМобильноеДокументыДляОбмена.Ссылка
	|ИЗ
	|	ПланОбмена.СМ_ОбменСметаМобильное.ДокументыДляОбмена КАК СМ_ОбменСметаМобильноеДокументыДляОбмена
	|ГДЕ
	|	СМ_ОбменСметаМобильноеДокументыДляОбмена.ДокументОтбор = &Док";
	Запрос.УстановитьПараметр("Док",Объект.Ссылка);
	МассивУзлов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	ПланыОбмена.УдалитьРегистрациюИзменений(МассивУзлов,Объект.Ссылка);
	Для каждого эл Из МассивУзлов Цикл
		Узел = эл.ПолучитьОбъект();
		НайденаЛС = Узел.ДокументыДляОбмена.Найти(Объект.Ссылка,"ДокументОтбор");
		Если Не НайденаЛС = Неопределено Тогда
			Узел.ДокументыДляОбмена.Удалить(НайденаЛС);
			Узел.Записать();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

