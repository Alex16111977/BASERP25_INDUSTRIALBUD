Процедура СводныеРесурсыФактРасходаПриИзменении(Элемент)
	
	ТекДанные = Элементы.СводныеРесурсы.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Если НЕ ТекДанные.ИзмененФактРасход Тогда
			ПроверитьПревышениеФактическогоРасхода(ТекДанные);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьРасход(ТекДанные)	
	
	Если Не ТекДанные.ЭтоУчтенный Тогда
		ТипСборника = СМ_СметаЗагрузкаВызовСервера.ОпределитьТипНормСборникаПоШифру(ТекДанные.КодРесурса);
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("РасходПоФакту",ТекДанные.РасходПоФакту);
		СтруктураПараметров.Вставить("Шифр",ТекДанные.КодРесурса);
		СтруктураПараметров.Вставить("ТипСборника",ТипСборника);
		СтруктураПараметров.Вставить("ТекущаяЦена",ТекДанные.ЦенаТекущая);
		СтруктураПараметров.Вставить("БазиснаяЦена",ТекДанные.ЦенаБазисная);
		СтруктураПараметров.Вставить("НеИзменятьЦены",ТекДанные.НеИзменятьЦены);
		ИзменитьОбъемНеучтенных(СтруктураПараметров);
	Иначе 
		РасходПоФакту = ТекДанные.РасходПоФакту;         	
		ИзменитьФактРасходРесурсовСервер(ТекДанные.КодРесурса,ТекДанные.НаименованиеРесурса,ТекДанные.ЦенаТекущая, РасходПоФакту);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПревышениеФактическогоРасхода(ТекДанные)
	
	Если СМ_СметаВызовСервера.ЗначениеОпции("СМ_ПодтверждатьПревышениеОбъемаАкта") И
		 ТекДанные.РасходПоФакту > ТекДанные.РасходПоНорме И
		 ТекДанные.РасходПоНорме >= 0 Тогда 
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ТекДанные",ТекДанные);
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораВариантаСписания", ЭтотОбъект, ДопПараметры);
		ПоказатьВводЗначения(Оповещение,ПредопределенноеЗначение("Перечисление.СМ_ВариантыСписанияПревышения.ДефектныйАкт"), "Вариант списания превышения");
		
	ИначеЕсли ТекДанные.РасходПоФакту < ТекДанные.РасходПоНорме	И ТекДанные.РасходПоНорме >= 0 Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ТекДанные",ТекДанные);
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораВариантаОтклонения", ЭтотОбъект, ДопПараметры);
		ПоказатьВводЗначения(Оповещение,ПредопределенноеЗначение("Перечисление.СМ_ВариантыОтклоненияНормы.Экономия"), "Вариант отклонения от нормы");
	Иначе
		ЗаполнитьВариантОтклоненияТЧРесурсы(ТекДанные.КодРесурса,ТекДанные.НаименованиеРесурса,ПредопределенноеЗначение("Перечисление.СМ_ВариантыОтклоненияНормы.ПустаяСсылка"));
		РаспределитьРасход(ТекДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораВариантаСписания(Результат, ДопПараметры) Экспорт
	
	Если Результат = ПредопределенноеЗначение("Перечисление.СМ_ВариантыСписанияПревышения.ДефектныйАкт") Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ВладелецФайла",  Объект.Ссылка);
		ПараметрыФормы.Вставить("ТолькоПросмотр", Ложь);
		ПараметрыФормы.Вставить("РежимВыбора", Истина);
		
		ДопПараметры.Вставить("ВариантСписания", Результат);
		Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеВыбораФайлаДефектныйАкт", ЭтотОбъект, ДопПараметры);
		ОткрытьФорму("Документ.СМ_АктВыполненныхРабот.Форма.ПрисоединенныеФайлы",ПараметрыФормы,ЭтаФорма,Ложь,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли Результат = ПредопределенноеЗначение("Перечисление.СМ_ВариантыСписанияПревышения.ПредыдущийПериод") Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТекущийАкт",  Объект.Ссылка);
		
		ДопПараметры.Вставить("ВариантСписания", Результат);
		Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеВыбораФайлаПредыдущийАкт", ЭтотОбъект, ДопПараметры);
		ОткрытьФорму("Документ.СМ_АктВыполненныхРабот.Форма.ФормаВыбораПредыдущего",ПараметрыФормы,ЭтаФорма,Ложь,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	Иначе
		ТекДанные = ДопПараметры.ТекДанные; 
		ТекДанные.РасходПоФакту = ТекДанные.РасходПоНорме;
		РаспределитьРасход(ТекДанные);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Расход по факту установлен по норме.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораВариантаОтклонения(Результат, ДопПараметры) Экспорт
	
	ТекДанные = ДопПараметры.ТекДанные;
	Если Результат = Неопределено Тогда
		ТекДанные.РасходПоФакту = ТекДанные.РасходПоНорме;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Фактический расход установлен по норме.'"));
		Возврат;
	КонецЕсли;
	ЗаполнитьВариантОтклоненияТЧРесурсы(ДопПараметры.ТекДанные.КодРесурса,ТекДанные.НаименованиеРесурса,Результат);
	РаспределитьРасход(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораФайлаПредыдущийАкт(Результат, ДопПараметры) Экспорт
	ТекДанные = ДопПараметры.ТекДанные;
	Если Не Результат = Неопределено Тогда
		ЗаполнитьФайлТЧРесурсыПредыдущий(ДопПараметры.ВариантСписания,ДопПараметры.ТекДанные.КодРесурса,ТекДанные.НаименованиеРесурса,Результат);
	Иначе
		ТекДанные.РасходПоФакту = ТекДанные.РасходПоНорме;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Фактический расход установлен по норме.'"));
	КонецЕсли;
	РаспределитьРасход(ТекДанные);
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораФайлаДефектныйАкт(Результат, ДопПараметры) Экспорт
	ТекДанные = ДопПараметры.ТекДанные;
	Если Не Результат = Неопределено Тогда
		ЗаполнитьФайлТЧРесурсыДефект(ДопПараметры.ВариантСписания,ДопПараметры.ТекДанные.КодРесурса,ТекДанные.НаименованиеРесурса,Результат);
	Иначе
		ТекДанные.РасходПоФакту = ТекДанные.РасходПоНорме;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Фактический расход установлен по норме.'"));
	КонецЕсли;
	РаспределитьРасход(ТекДанные);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВариантОтклоненияТЧРесурсы(КодРесурса,НаименованиеРесурса,ВариантОтклонения)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("СметныйКодРесурса",КодРесурса);
	СтруктураОтбора.Вставить("НаименованиеРесурса",НаименованиеРесурса);
	
	МассивСтрок = Объект.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
	Для Каждого НоваяСтрока Из МассивСтрок Цикл
		НоваяСтрока.ВариантОтклонения = ВариантОтклонения;
		НоваяСтрока.СсылкаНаФайл = Справочники.СМ_АктВыполненныхРаботПрисоединенныеФайлы.ПустаяСсылка();
		НоваяСтрока.СсылкаНаАкт = Документы.СМ_АктВыполненныхРабот.ПустаяСсылка();
		НоваяСтрока.КомментарийКФайлу = "";
		НоваяСтрока.ВариантСписанияПревышения = Перечисления.СМ_ВариантыСписанияПревышения.ПустаяСсылка();
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФайлТЧРесурсыПредыдущий(ВариантСписания,КодРесурса,НаименованиеРесурса,СтруктураДанных)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("СметныйКодРесурса",КодРесурса);
	СтруктураОтбора.Вставить("НаименованиеРесурса",НаименованиеРесурса);
	
	МассивСтрок = Объект.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
	Для Каждого НоваяСтрока Из МассивСтрок Цикл
		НоваяСтрока.ВариантСписанияПревышения = ВариантСписания;
		НоваяСтрока.СсылкаНаАкт = СтруктураДанных.Акт;
		НоваяСтрока.СсылкаНаФайл = Справочники.СМ_АктВыполненныхРаботПрисоединенныеФайлы.ПустаяСсылка();
		НоваяСтрока.КомментарийКФайлу = СтруктураДанных.Комментарий;
		НоваяСтрока.ВариантОтклонения = Перечисления.СМ_ВариантыОтклоненияНормы.ПустаяСсылка();
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФайлТЧРесурсыДефект(ВариантСписания,КодРесурса,НаименованиеРесурса,СтруктураДанных)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("СметныйКодРесурса",КодРесурса);
	СтруктураОтбора.Вставить("НаименованиеРесурса",НаименованиеРесурса);
	
	МассивСтрок = Объект.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
	Для Каждого НоваяСтрока Из МассивСтрок Цикл
		НоваяСтрока.ВариантСписанияПревышения = ВариантСписания;
		НоваяСтрока.СсылкаНаФайл = СтруктураДанных.Файл;
		НоваяСтрока.СсылкаНаАкт = Документы.СМ_АктВыполненныхРабот.ПустаяСсылка();
		НоваяСтрока.КомментарийКФайлу = СтруктураДанных.Комментарий;
		НоваяСтрока.ВариантОтклонения = Перечисления.СМ_ВариантыОтклоненияНормы.ПустаяСсылка();
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФайлПозиции(Команда)
	ТекущиеДанные = Элементы.ДеревоЛС.ТекущиеДанные;
	Если ТипЗнч(ТекущиеДанные.Элемент) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")
		ИЛИ Не ТекущиеДанные.ЕстьФайл Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураФайла = ПолучитьДанныеФайла(ТекущиеДанные.Элемент);
	
	Если Не СтруктураФайла.Свойство("СсылкаНаФайл") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВладелецФайла",  Объект.Ссылка);
	ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
	ПараметрыФормы.Вставить("СтруктураФайла", СтруктураФайла);
	
	ОткрытьФорму("Документ.СМ_АктВыполненныхРабот.Форма.ПрисоединенныеФайлы",ПараметрыФормы,ЭтаФорма,Ложь,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеФайла(ТекПозиция)
	СтруктураФайла = Новый Структура;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Позиция",ТекПозиция);
	
	МассивСтрок = Объект.Позиции.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() > 0 Тогда
		НайденнаяСтрока = МассивСтрок[0];	
		
		СтруктураФайла.Вставить("СсылкаНаФайл",НайденнаяСтрока.СсылкаНаФайл);
		СтруктураФайла.Вставить("КомментарийКФайлу",НайденнаяСтрока.КомментарийКФайлу);
		
	КонецЕсли;
	
	Возврат СтруктураФайла; 
КонецФункции

&НаКлиенте
Процедура СводныеРесурсыНеИзменятьЦеныПриИзменении(Элемент)
	ТекДанные 	= Элементы.СводныеРесурсы.ТекущиеДанные;
	ЗаполнитьНеИзменятьЦеныСервер(ТекДанные.КодРесурса,ТекДанные.НаименованиеРесурса,ТекДанные.НеИзменятьЦены);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНеИзменятьЦеныСервер(КодРесурса,НаименованиеРесурса,НеИзменятьЦены)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("СметныйКодРесурса",КодРесурса);
	СтруктураОтбора.Вставить("НаименованиеРесурса",НаименованиеРесурса);
	
	МассивСтрок = Объект.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
	Для Каждого НоваяСтрока Из МассивСтрок Цикл
		НоваяСтрока.НеИзменятьЦены = НеИзменятьЦены;
	КонецЦикла;
	Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Процедура WS_ВыгрузитьАктНаСервере(Ответ)
	СМ_WS_ВызовСервера.ВыгрузитьАкт(Объект.Ссылка,Ответ);
	Если Ответ.Количество()=0 Тогда
		Объект.Статус=Перечисления.СМ_СтатусыСметныхДокументов.Согласован;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура WS_ВыгрузитьАкт(Команда)
	Если ЭтаФорма.Модифицированность Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	КонецЕсли;	
	Ответ=Неопределено;
	WS_ВыгрузитьАктНаСервере(Ответ);
	Если Ответ.Количество()>0 Тогда
		Для Каждого Эл Из Ответ Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Эл);
		КонецЦикла;
		Возврат;	
	Конецесли;	
	Если Объект.Статус = ПредопределенноеЗначение("Перечисление.СМ_СтатусыСметныхДокументов.Согласован") Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	КонецЕсли;
	ВидимостьДоступностьЭлементовНаФорме();
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка завершена");
КонецПроцедуры

&НаКлиенте
Процедура WS_ЗагрузитьЦены(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	КонецЕсли;	
	Ответ=Неопределено;
	
	WS_ЗагрузитьЦеныНаСервере(Ответ);
	ЭтаФорма.Модифицированность=Истина;
	Если Ответ.Количество()>0 Тогда
	Для Каждого Эл Из Ответ Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Эл);
	КонецЦикла;
	Возврат;	
	КонецЕсли;	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загрузка завершена");

КонецПроцедуры

&НаСервере
Процедура WS_ЗагрузитьЦеныНаСервере(Ответ)
	СМ_WS_ВызовСервера.ЗагрузитьЦены(Объект,Ответ);
КонецПроцедуры

&НаКлиенте
Процедура СводныеРесурсыПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.СводныеРесурсы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТекДанные.РасходПоФакту = ТекДанные.РасходПоНорме Тогда
		Элементы.НадписьОтклоненияРесурсы.Заголовок = ПолучитьСведенияОтклоненияТЧРесурсы(ТекДанные.КодРесурса,ТекДанные.НаименованиеРесурса);
	Иначе
		Элементы.НадписьОтклоненияРесурсы.Заголовок = "";		
	КонецЕсли;
	
	Элементы.СводныеРесурсыЗаменитьРесурс.Доступность 	= НЕ ТекДанные.Заменен; 
	Элементы.СводныеРесурсыУдалитьЗамену.Доступность 	= ТекДанные.ЭтоЗамена; 
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСведенияОтклоненияТЧРесурсы(КодРесурса,НаименованиеРесурса)
	Причина = "Причина отклонения: ";
	ДопПричина = "";
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("СметныйКодРесурса",КодРесурса);
	СтруктураОтбора.Вставить("НаименованиеРесурса",НаименованиеРесурса);
	
	МассивСтрок = Объект.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
	
	Если МассивСтрок.Количество()>0 Тогда
		ДопПричина = ?(ЗначениеЗаполнено(МассивСтрок[0].ВариантОтклонения),Строка(МассивСтрок[0].ВариантОтклонения),Строка(МассивСтрок[0].ВариантСписанияПревышения));
	КонецЕсли;
	
	Если ДопПричина = "" Тогда
		ДопПричина = "не указано."
	КонецЕсли;
	
	Возврат Причина+ДопПричина;
КонецФункции

&НаКлиенте
Процедура СкопироватьЗамены(Команда)
	Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеВыбораАктаЗамены", ЭтотОбъект);
	ОткрытьФорму("Документ.СМ_АктВыполненныхРабот.Форма.ФормаВыбора",,ЭтаФорма,Новый УникальныйИдентификатор(),,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораАктаЗамены(Результат, ДопПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЭтаФорма.Модифицированность = МассоваяЗамена(Результат);
КонецПроцедуры

&НаСервере
Функция МассоваяЗамена(АктЗамен) 
	
	
	
	СписокАктов 	= Новый СписокЗначений();
	СписокАктов.Добавить(АктЗамен);
	ТаблицаПредыдущихЗамен = СМ_СметаВызовСервера.ПолучитьЗамененныеРесурсыАктов(СписокАктов); 
	
	Если ТаблицаПредыдущихЗамен.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СводныеРесурсы.Очистить();
	Для Каждого стр Из ТаблицаПредыдущихЗамен Цикл
		
		Если ТипЗнч(стр.ЗамененныйРесурс) = Тип("СправочникСсылка.СМ_Ресурсы") Тогда
			МассивСтрок = Объект.РесурсыПозицийАкта.НайтиСтроки(Новый Структура("Позиция,Ресурс",стр.Позиция,стр.ЗамененныйРесурс));
		Иначе
			МассивСтрок = Объект.РесурсыПозицийАкта.НайтиСтроки(Новый Структура("Позиция,НаименованиеРесурса",стр.Позиция,стр.ЗамененныйРесурс));
		КонецЕсли;
		
		Если МассивСтрок.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;
		НайденаСтрока = МассивСтрок[0];
		НайденаСтрока.Ресурс = стр.НовыйРесурс; 
		НайденаСтрока.НаименованиеРесурса = стр.НовыйРесурс.ДлинноеНаименование;
		НайденаСтрока.СметныйКодРесурса = стр.НовыйРесурс.Код;
		НайденаСтрока.Заменен = Истина;
	КонецЦикла;
	
	ТаблСтоимРес = СМ_СметаРасчетСервер.ПолучитьТаблицуСтоимостиРесурсовАкта(Объект,Истина,,,,Истина,,Истина,Истина);
	
	
	СводныеРесурсы.Загрузить(ТаблСтоимРес);
	
	Возврат Истина;
КонецФункции

