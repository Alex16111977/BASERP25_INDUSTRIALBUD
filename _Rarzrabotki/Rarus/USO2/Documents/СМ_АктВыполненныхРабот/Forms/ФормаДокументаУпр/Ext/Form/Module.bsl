КонецПроцедуры

&НаСервере
Функция НайтиНовыйРесурс(ТекРесурс)
	
	ТекИндекс 		= 0;
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Ресурс",ТекРесурс);	
	СтруктураОтбора.Вставить("ЭтоЗамена",Истина);
	МассивСтрок = ЭтаФорма.СводныеРесурсы.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() > 0 Тогда
		ТекИндекс = МассивСтрок[0].ПолучитьИдентификатор();
	КонецЕсли;
	
	Возврат ТекИндекс;
	
КонецФункции

&НаСервере
Процедура УдалитьЗаменуНаСервере(ТекРесурс, ПозицияЛС = "")
	
	МассивПозиций 			= Новый Массив;
	МассивСтарогоРесурса 	= Новый Массив;	
	
	// 1. Удаление замены ресурса из регистра замен.
	Запрос 			= Новый Запрос;
	ТекстЗапроса 	= "
	|ВЫБРАТЬ
	|	СМ_ЗаменаМатериаловПозиции.Смета,
	|	СМ_ЗаменаМатериаловПозиции.Позиция,
	|	СМ_ЗаменаМатериаловПозиции.ЗамененныйРесурс,
	|	СМ_ЗаменаМатериаловПозиции.БазисЗарплМашСтарРесурс,
	|	СМ_ЗаменаМатериаловПозиции.БазиснаяЦенаСтарогоМатериала,
	|	СМ_ЗаменаМатериаловПозиции.НовыйРесурс,
	|	СМ_ЗаменаМатериаловПозиции.НормаРасходаСтарогоМатериала,
	|	СМ_ЗаменаМатериаловПозиции.ТекЗарплМашСтарРесурс,
	|	СМ_ЗаменаМатериаловПозиции.ТекущаяЦенаСтарогоМатериала
	|ИЗ
	|	РегистрСведений.СМ_ЗаменаМатериаловПозиции КАК СМ_ЗаменаМатериаловПозиции
	|ГДЕ
	|	СМ_ЗаменаМатериаловПозиции.НовыйРесурс = &НовыйРесурс И
	|	СМ_ЗаменаМатериаловПозиции.Смета = &Смета";
	
	Запрос.УстановитьПараметр("НовыйРесурс",ТекРесурс);
	Запрос.УстановитьПараметр("Смета",Объект.Ссылка);
	
	Если ЗначениеЗаполнено(ПозицияЛС) Тогда
		ТекстЗапроса = ТекстЗапроса + " И СМ_ЗаменаМатериаловПозиции.Позиция = &ПозицияЛС";	
		Запрос.УстановитьПараметр("ПозицияЛС",ПозицияЛС);
	КонецЕсли;
	
	Запрос.Текст 		= ТекстЗапроса; 
	РезультатЗапроса 	= Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		ЗамененныйРесурс = РезультатЗапроса.ЗамененныйРесурс;
	
		// 2. Формирование структуры для добавления строк старого ресурса (возврат в ТЧ).
		СтруктураСтарогоРесурса = Новый Структура;
		СтруктураСтарогоРесурса.Вставить("Позиция",РезультатЗапроса.Позиция);
		СтруктураСтарогоРесурса.Вставить("СметныйКодРесурса",ЗамененныйРесурс.Код);
		СтруктураСтарогоРесурса.Вставить("Ресурс",ЗамененныйРесурс);
		СтруктураСтарогоРесурса.Вставить("ВидРесурса",ЗамененныйРесурс.ВидРесурса);
		СтруктураСтарогоРесурса.Вставить("НормаРасходаОбъем",РезультатЗапроса.Позиция.ОбъемРабот * РезультатЗапроса.НормаРасходаСтарогоМатериала);
		СтруктураСтарогоРесурса.Вставить("ФактРасходаОбъем",РезультатЗапроса.Позиция.ОбъемРабот * РезультатЗапроса.НормаРасходаСтарогоМатериала);
		СтруктураСтарогоРесурса.Вставить("БазиснаяЦена",РезультатЗапроса.БазиснаяЦенаСтарогоМатериала);
		СтруктураСтарогоРесурса.Вставить("БазиснаяЗарплатаМашинистов",РезультатЗапроса.БазисЗарплМашСтарРесурс);
		СтруктураСтарогоРесурса.Вставить("ТекущаяЦена",РезультатЗапроса.ТекущаяЦенаСтарогоМатериала);
		СтруктураСтарогоРесурса.Вставить("ТекущаяЗарплатаМашинистов",РезультатЗапроса.ТекЗарплМашСтарРесурс);
		СтруктураСтарогоРесурса.Вставить("Заменен",Ложь);
		СтруктураСтарогоРесурса.Вставить("Удален",Ложь);
		СтруктураСтарогоРесурса.Вставить("Добавлен",Ложь);
		СтруктураСтарогоРесурса.Вставить("НаименованиеРесурса",ЗамененныйРесурс.ДлинноеНаименование);
		СтруктураСтарогоРесурса.Вставить("ЕдиницаИзмеренияРесурса",ЗамененныйРесурс.ЕдиницаИзмерения);
		СтруктураСтарогоРесурса.Вставить("СтатусРесурса",РезультатЗапроса.Позиция.СтатусРесурса);
		СтруктураСтарогоРесурса.Вставить("НеИзменятьЦены",РезультатЗапроса.Позиция.НеИзменятьЦены);
	//	СтруктураСтарогоРесурса.Вставить("УдалитьСтатусРесурсаАкт",РезультатЗапроса.Позиция.СтатусРесурсаАкт);
		СтруктураСтарогоРесурса.Вставить("НомерСтрокиДокумента",СМ_СметаВызовСервера.ПолучитьНомерДокумента(РезультатЗапроса.Позиция,"СМ_ПозицияЛокальнойСметы"));
		СтруктураСтарогоРесурса.Вставить("ТипМатериала",Перечисления.СМ_ТипыМатериалов.Учтенный);
		
		МассивСтарогоРесурса.Добавить(СтруктураСтарогоРесурса);
		МассивПозиций.Добавить(РезультатЗапроса.Позиция);

		// 3. Удаление строк замены ресурса из регистра сведений "СМ_ЗаменаМатериаловПозиции".
		ТекМенеджерЗаписи 					= РегистрыСведений.СМ_ЗаменаМатериаловПозиции.СоздатьМенеджерЗаписи();
		ТекМенеджерЗаписи.Смета 			= Объект.Ссылка;
		ТекМенеджерЗаписи.Позиция 			= РезультатЗапроса.Позиция;
		ТекМенеджерЗаписи.ЗамененныйРесурс  = РезультатЗапроса.ЗамененныйРесурс;
		ТекМенеджерЗаписи.НовыйРесурс  		= РезультатЗапроса.НовыйРесурс;
	    ТекМенеджерЗаписи.Прочитать();
		Если ТекМенеджерЗаписи.Выбран() Тогда
			ТекМенеджерЗаписи.Удалить();
		КонецЕсли;	

		// 4. Удаление строк замены ресурса из табличной части "РесурсыПозицийАкта".
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Ресурс",РезультатЗапроса.НовыйРесурс);
		СтруктураОтбора.Вставить("Позиция",РезультатЗапроса.Позиция);
		СтруктураОтбора.Вставить("Заменен",Истина);
		МассивСтрок = Объект.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
		Для Каждого ТекСтрока Из МассивСтрок Цикл
			Объект.РесурсыПозицийАкта.Удалить(ТекСтрока);				
		КонецЦикла;
	КонецЦикла;
	
	// 5. Проверка остались еще замены по ресурсу.
	ТабРезультат 	= ПолучитьВсеЗаменыРесурсаВАкте(ЗамененныйРесурс, Объект.Ссылка, ПозицияЛС);
	ОсталосьЗамен 	= ТабРезультат.Количество();

	// 6. Возврат строк старого ресурса в табличную часть РесурсыПозицийАкта.
	// Если замен ресурса не осталось, то необходимо возвратить старый ресурс (добавить строки по позициям) в ТЧ.
	Если ОсталосьЗамен = 0 Тогда
		// Позиции в которые нужно вернуть старый ресурс берем из массива позиций.
		// Массив позиций заполняется при удалении замен ресурса.
		Для Каждого ТекЭлемент Из МассивСтарогоРесурса Цикл
			НоваяСтрока = Объект.РесурсыПозицийАкта.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекЭлемент);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
// Функция удаляет все замены ресурса и старый ресурс возвращается в ТЧ
Функция УдалитьВсеЗаменыРесурсаПоЗамене(ЗамененныйРесурс)
	
	// Получаем все замены старого ресурса в текущем акте и удаляем их
	ТабЗамен = ПолучитьВсеЗаменыРесурсаВАкте(ЗамененныйРесурс, Объект.Ссылка);
	Для Каждого ТекСтрока Из ТабЗамен Цикл
		УдалитьЗаменуНаСервере(ТекСтрока.НовыйРесурс);
	КонецЦикла;
	
	// Перезаполнение сводных ресурсов акта после удаления всех замен и возврата старого ресурса.
	ЗаполнитьТаблицуРесурсовАкта();	
	
	// Получение сводных данных по старому ресурсу
	ТабСводныхРесурсов = РеквизитФормыВЗначение("СводныеРесурсы");
	НайденнаяСтрока = ТабСводныхРесурсов.Найти(ЗамененныйРесурс);		
	Если НайденнаяСтрока <> Неопределено Тогда
		СтруктураВозврата = Новый Структура;
		СтруктураВозврата.Вставить("Ресурс",ЗамененныйРесурс);
		СтруктураВозврата.Вставить("РасходПоНорме",НайденнаяСтрока.РасходПоНорме);
		СтруктураВозврата.Вставить("РасходПоФакту",НайденнаяСтрока.РасходПоФакту);
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	Возврат Неопределено;
			
КонецФункции

&НаСервере
Функция ПолучитьЗамененныйРесурсПоЗамене(НовыйРесурс)

	ЗамененныйРесурс = Неопределено;
	
	РегЗамена = РегистрыСведений.СМ_ЗаменаМатериаловПозиции.СоздатьНаборЗаписей();
	РегЗамена.Отбор.Смета.Установить(Объект.Ссылка);
	РегЗамена.Отбор.НовыйРесурс.Установить(НовыйРесурс);
	РегЗамена.Прочитать();
	
	Если РегЗамена.Количество()>0 Тогда
		ЗамененныйРесурс = РегЗамена.Получить(0).ЗамененныйРесурс;
	КонецЕсли;
	
	Возврат ЗамененныйРесурс;
	
КонецФункции

&НаСервере
Функция ПолучитьВсеЗаменыРесурсаВАкте(ЗамененныйРесурс, Акт, ПозицияЛС = "")

	Запрос 			= Новый Запрос;
	ТекстЗапроса 	= "
	|ВЫБРАТЬ
	|	СМ_ЗаменаМатериаловПозиции.Смета,
	|	СМ_ЗаменаМатериаловПозиции.ЗамененныйРесурс,
	|	СМ_ЗаменаМатериаловПозиции.НовыйРесурс
	|ИЗ
	|	РегистрСведений.СМ_ЗаменаМатериаловПозиции КАК СМ_ЗаменаМатериаловПозиции
	|ГДЕ
	|	СМ_ЗаменаМатериаловПозиции.ЗамененныйРесурс = &ЗамененныйРесурс И 
	|	СМ_ЗаменаМатериаловПозиции.Смета = &Акт";

	Запрос.УстановитьПараметр("ЗамененныйРесурс",ЗамененныйРесурс);
	Запрос.УстановитьПараметр("Акт",Акт);

	Если ЗначениеЗаполнено(ПозицияЛС) Тогда
		ТекстЗапроса = ТекстЗапроса + " И СМ_ЗаменаМатериаловПозиции.Позиция = &ПозицияЛС ";	
		Запрос.УстановитьПараметр("ПозицияЛС",ПозицияЛС);
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|СГРУППИРОВАТЬ ПО
	|	СМ_ЗаменаМатериаловПозиции.Смета,
	|	СМ_ЗаменаМатериаловПозиции.ЗамененныйРесурс,
	|	СМ_ЗаменаМатериаловПозиции.НовыйРесурс";
	
	Запрос.Текст = ТекстЗапроса;
	ТабРезультат = Запрос.Выполнить().Выгрузить();

	Возврат ТабРезультат;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПерезаменуРесурса(РесурсЗамена)
	
	// Получаем замененный ресурс по ресурсу-замене.
	ЗамененныйРесурс = ПолучитьЗамененныйРесурсПоЗамене(РесурсЗамена);
	Если ЗамененныйРесурс = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не найден замененный ресурс'"));
		Возврат;
	КонецЕсли;
	
	// Удаляем все замены ресурса и старый ресурс возвращается в ТЧ.
	// Возвращается структура старого ресурса для вызова его новой замены.
	СтруктураРесурса = УдалитьВсеЗаменыРесурсаПоЗамене(ЗамененныйРесурс);
	Если СтруктураРесурса = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не удалось провести перезамену ресурса'"));
		Возврат;	
	КонецЕсли;
	
	Структура 					= Новый Структура("ЗаменяемыйРесурс, Ресурс, РасходПоНорме, РасходПоФакту,БазисЦена,БазисЗарплМаш,ТекЦена,ТекЗарплМаш");
	Структура.ЗаменяемыйРесурс 	= СтруктураРесурса.Ресурс;
	Структура.РасходПоНорме 	= СтруктураРесурса.РасходПоНорме;
	Структура.РасходПоФакту 	= СтруктураРесурса.РасходПоФакту;
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("РегиональнаяБаза", СтруктураПараметровРасчетаЛС.РегионДляВыбораЦен);
	ПараметрыПоиска.Вставить("Район",СтруктураПараметровРасчетаЛС.Район);
	ПараметрыПоиска.Вставить("ДатаТекущихЦен",Объект.ДатаТекущихЦен);
	ПараметрыПоиска.Вставить("ТекРесурс",СтруктураРесурса.Ресурс);
	ПараметрыПоиска.Вставить("Проект",Объект.Стройка);
	ПараметрыПоиска.Вставить("Акт",Объект.Ссылка);
	
	Оповещение = Новый ОписаниеОповещения("ПолучитьЗаменуРесурса", ЭтотОбъект,Структура);
	ОткрытьФорму("Справочник.СМ_Ресурсы.Форма.ФормаВыбора",ПараметрыПоиска,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаСервере
Функция УсловияВыполняются(Условия, ТекДанные)
	
	Для Каждого Условие Из Условия Цикл
		
		ИмяРеквизита = Условие.Реквизит;
		
		Если ИмяРеквизита = "МетодикаРасчета" Тогда
			ЗначенияРеквизитов = ТекДанные.ЛокальнаяСмета;	
		Иначе
			ЗначенияРеквизитов = ТекДанные;
			Если Не ЗначенияРеквизитов.Свойство(ИмяРеквизита) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
	
		УсловиеВыполняется = Истина;
		Если Условие.ВидСравнения = ВидСравнения.Равно
			Или Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
			УсловиеВыполняется = ЗначенияРеквизитов[ИмяРеквизита] = Условие.Значение;
		ИначеЕсли Условие.ВидСравнения = ВидСравнения.Больше
			Или Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше Тогда
			УсловиеВыполняется = ЗначенияРеквизитов[ИмяРеквизита] > Условие.Значение;
		ИначеЕсли Условие.ВидСравнения = ВидСравнения.БольшеИлиРавно
			Или Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
			УсловиеВыполняется = ЗначенияРеквизитов[ИмяРеквизита] >= Условие.Значение;
		ИначеЕсли Условие.ВидСравнения = ВидСравнения.Меньше
			Или Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше Тогда
			УсловиеВыполняется = ЗначенияРеквизитов[ИмяРеквизита] < Условие.Значение;
		ИначеЕсли Условие.ВидСравнения = ВидСравнения.МеньшеИлиРавно
			Или Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
			УсловиеВыполняется = ЗначенияРеквизитов[ИмяРеквизита] <= Условие.Значение;
		ИначеЕсли Условие.ВидСравнения = ВидСравнения.НеРавно
			Или Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно Тогда
			УсловиеВыполняется = ЗначенияРеквизитов[ИмяРеквизита] <> Условие.Значение;
		ИначеЕсли Условие.ВидСравнения = ВидСравнения.ВСписке
			Или Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда
			УсловиеВыполняется = Условие.Значение.Найти(ЗначенияРеквизитов[ИмяРеквизита]) <> Неопределено;
		ИначеЕсли Условие.ВидСравнения = ВидСравнения.НеВСписке
			Или Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
			УсловиеВыполняется = Условие.Значение.Найти(ЗначенияРеквизитов[ИмяРеквизита]) = Неопределено;
		ИначеЕсли Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
			УсловиеВыполняется = ЗначениеЗаполнено(ЗначенияРеквизитов[ИмяРеквизита]);
		ИначеЕсли Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
			УсловиеВыполняется = Не ЗначениеЗаполнено(ЗначенияРеквизитов[ИмяРеквизита]);
		КонецЕсли;
		Если Не УсловиеВыполняется Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

