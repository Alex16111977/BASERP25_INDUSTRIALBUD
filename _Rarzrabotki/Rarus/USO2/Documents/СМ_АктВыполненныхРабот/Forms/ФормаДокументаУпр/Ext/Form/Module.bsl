&НаКлиенте
Процедура УстановитьСтатусРесурсаПодрядчика(Команда)
	
	СтатусРесурса = ПредопределенноеЗначение("Перечисление.СМ_ОбеспечениеРесурса.Подрядчика");
	ИзменитьСтатусРесурса(СтатусРесурса);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтатусРесурсаСобственный(Команда)
	
	СтатусРесурса = ПредопределенноеЗначение("Перечисление.СМ_ОбеспечениеРесурса.Собственный");
	ИзменитьСтатусРесурса(СтатусРесурса);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСтатусРесурса(СтатусРесурса)
	
	ТекДанные = Элементы.СводныеРесурсы.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
	
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("СметныйКодРесурса",ТекДанные.КодРесурса);
		СтруктураОтбора.Вставить("НаименованиеРесурса",ТекДанные.НаименованиеРесурса);
		СтруктураОтбора.Вставить("СтатусРесурса",ТекДанные.СтатусРесурса);
		СтруктураОтбора.Вставить("БазиснаяЦена", ТекДанные.ЦенаБазисная);
		СтруктураОтбора.Вставить("ТекущаяЦена",  ТекДанные.ЦенаТекущая);
		
		Если ТекДанные.ЭтоУчтенный Тогда
			СтруктураОтбора.Вставить("ЕдиницаИзмеренияРесурса",Строка(ТекДанные.ЕдиницаИзмеренияРесурса));
			ЗаполнитьСтатусАктТЧРесурсыНовая(СтруктураОтбора,СтатусРесурса);
		Иначе
			СтруктураОтбора.Вставить("ЕдиницаИзмеренияРесурса",ТекДанные.ЕдиницаИзмеренияРесурса);
			ЗаполнитьСтатусАктТЧПозиции(СтруктураОтбора,СтатусРесурса);	
		КонецЕсли;
		
		ТекДанные.СтатусРесурса = СтатусРесурса;
		Модифицированность 		= Истина;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтатусАктТЧПозиции(СтруктураОтбора,СтатусРесурса)
	
	ТабПозиций 		= Объект.Позиции.Выгрузить();
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ
	|	ПозицииАкта.Позиция КАК Позиция,
	|	ПозицииАкта.СтатусРесурса КАК СтатусРесурса
	|ПОМЕСТИТЬ ТабПозиции
	|ИЗ
	|	&ТабПозиций КАК ПозицииАкта;
	|
	|ВЫБРАТЬ
	| 	ТабПозиции.Позиция
	|ИЗ 
	| 	ТабПозиции КАК ТабПозиции
	|ГДЕ
	|	ТабПозиции.Позиция.ШифрРасценки = &ШифрРасценки И
	|	ТабПозиции.Позиция.Наименование ПОДОБНО &НаименованиеРесурса И
	|	ТабПозиции.СтатусРесурса = &СтатусРесурса И
	|	ТабПозиции.Позиция.ЕдиницаИзмерения = &ЕдиницаИзмерения";
	
	Запрос.УстановитьПараметр("ТабПозиций",ТабПозиций);
	Запрос.УстановитьПараметр("ШифрРасценки",СтруктураОтбора.СметныйКодРесурса);
	Запрос.УстановитьПараметр("НаименованиеРесурса",СтруктураОтбора.НаименованиеРесурса);	
	Запрос.УстановитьПараметр("СтатусРесурса",СтруктураОтбора.СтатусРесурса);	
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",СтруктураОтбора.ЕдиницаИзмеренияРесурса);
	
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	Для Каждого ТекСтрока Из ТабРезультат Цикл
		
		// Поиск и замена статуса у позиций-ресурсов в ТЧ "Позиции"
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Позиция",ТекСтрока.Позиция);
		НайденныеСтроки = Объект.Позиции.НайтиСтроки(СтруктураОтбора);
		Для Каждого ТекСтрокаПозиции Из НайденныеСтроки Цикл
			ТекСтрокаПозиции.СтатусРесурса = СтатусРесурса;	
		КонецЦикла;
		
		// Поиск и замена статуса у позиций-ресурсов в ДеревеСостава
		ТекДерево 		= РеквизитФормыВЗначение("ДеревоЛС");
		СтрокаДерева 	= ТекДерево.Строки.Найти(ТекСтрока.Позиция, "Элемент",Истина);
		Если СтрокаДерева <> Неопределено Тогда
			СтрокаДерева.СтатусРесурса = СтатусРесурса;	
			ЗначениеВРеквизитФормы(ТекДерево,"ДеревоЛС");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСтатусАктТЧРесурсыНовая(СтруктураОтбора,СтатусРесурса)
	
	МассивСтрок = Объект.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
	Для Каждого НоваяСтрока Из МассивСтрок Цикл
		НоваяСтрока.СтатусРесурса = СтатусРесурса;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтатусРесурсаПодрядчикаПозиция(Команда)
	
	СтатусПозиции = ПредопределенноеЗначение("Перечисление.СМ_ОбеспечениеРесурса.Подрядчика");
	УстановитьСтатусРесурсаПозиции(СтатусПозиции);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтатусРесурсаСобственныйПозиция(Команда)
	
	СтатусПозиции = ПредопределенноеЗначение("Перечисление.СМ_ОбеспечениеРесурса.Собственный");
	УстановитьСтатусРесурсаПозиции(СтатусПозиции);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтатусРесурсаПозиции(СтатусПозиции)

	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, НСтр("ru='Новый документ необходимо сначала записать.'"),,НСтр("ru='Внимание'"));
		Возврат;
	КонецЕсли;
	
	Позиция = Элементы.ДеревоЛС.ТекущиеДанные.Элемент;
	Если ТипЗнч(Позиция) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда		
		Если Не РазрешитьМенятьСтатус(Позиция) Тогда
			ПоказатьПредупреждение(,НСтр("ru='Менять статус можно только для ""материала"" или ""оборудования"" !'"));
		Иначе
			ТекДанные 			= Элементы.ДеревоЛС.ТекущиеДанные;
			СтарыйСтатус 		= ТекДанные.СтатусРесурса;
			НаименованиеРесурса	= ТекДанные.Наименование;
			ЕдиницаИзмерения	= ТекДанные.Измеритель;
			
			СменитьСтатусПозицииРесурсаАкта(Позиция,СтарыйСтатус,СтатусПозиции);
			ТекДанные.СтатусРесурса = СтатусПозиции;
		КонецЕсли;
	Иначе
		Состояние(НСтр("ru='Менять статус можно только для Позиции'"),100,НСтр("ru='Внимание: Вы выбрали раздел локальной сметы!'"),БиблиотекаКартинок.Информация32);
	КонецЕсли;  	
	
КонецПроцедуры

&НаСервере
Процедура СменитьСтатусПозицииРесурсаАкта(Позиция,СтарыйСтатус,СтатусРесурса)
	
	// Изменение статуса ресурса в ТЧ "Позиции"
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Позиция",Позиция);
	НайденныеСтроки = Объект.Позиции.НайтиСтроки(СтруктураОтбора);
	Для Каждого ТекСтрока Из НайденныеСтроки Цикл
		ТекСтрока.СтатусРесурса = СтатусРесурса;
	КонецЦикла;
	
	// Изменение статуса ресурса в таблице сводных ресурсов
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("КодРесурса",Позиция.ШифрРасценки);
	СтруктураОтбора.Вставить("НаименованиеРесурса",Позиция.Наименование);
	СтруктураОтбора.Вставить("ЕдиницаИзмеренияРесурса",Позиция.ЕдиницаИзмерения);
	СтруктураОтбора.Вставить("СтатусРесурса",СтарыйСтатус);
	
	НайденныеСтроки = ЭтаФорма.СводныеРесурсы.НайтиСтроки(СтруктураОтбора);	
	Для Каждого ТекСтрока Из НайденныеСтроки Цикл
		ТекСтрока.СтатусРесурса = СтатусРесурса;	
	КонецЦикла;
	
	Модифицированность = Истина;
		
КонецПроцедуры

