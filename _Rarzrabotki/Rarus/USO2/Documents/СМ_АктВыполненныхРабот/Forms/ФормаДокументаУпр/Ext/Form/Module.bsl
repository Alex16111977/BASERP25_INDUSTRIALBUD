#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПрограммныйИнтерфейс

// Осуществляет замену расхода ресурсов после диалога пользователя (из функции ЗаменаРесурсовПоПозиции).
// 
// Параметры:
// 		СтруктураПараметров - Структура	- дополнительные параметры.
//		ПозицияЛС	 		- ДокументСсылка.СМ_ПозицияЛокальнойСметы - ссылка на позицию локальной сметы.
//
&НаКлиенте
Процедура ПолучитьРасходРесурсов(СтруктураПараметров, ПозицияЛС) Экспорт
	
	Если СтруктураПараметров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьЗаменыРесурсов(СтруктураПараметров, ПозицияЛС);
	ЭтаФорма.Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура ОбработкаИзмененияРесурсов(ТабРесурсы,ПозицияЛС)
	
	Для Каждого ТекСтрока Из ТабРесурсы Цикл
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Позиция",ПозицияЛС);
		СтруктураОтбора.Вставить("Ресурс",ТекСтрока.Ресурс);
		
		НайденныеСтроки = Объект.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
		Для Каждого ТекСтрокаРесурсов Из НайденныеСтроки Цикл
			// Если изменился факт расхода ресурса, нужно запретить редактирование факт расхода в форме.
			Если ТекСтрокаРесурсов.ФактРасходаОбъем <> ТекСтрока.ФактРасходаОбъем Тогда
				ТекСтрокаРесурсов.ИзмененФактРасход	= Истина;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ТекСтрокаРесурсов,ТекСтрока);	
		КонецЦикла;
	КонецЦикла;
	
	Если ТабРесурсы.Количество() > 0 Тогда
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьЗаменыРесурсов(СтруктураПараметров,ПозицияЛС)
	
	АдресТабЗамен   	= СтруктураПараметров.АдресТабЗамен;
	АдресТабУдаления    = СтруктураПараметров.АдресТабУдаления;
	АдресТабРесурсы		= СтруктураПараметров.АдресТабРесурсы;
	
	ТабЗамен 	= ПолучитьИзВременногоХранилища(АдресТабЗамен);
	ТабУдаления = ПолучитьИзВременногоХранилища(АдресТабУдаления);
	ТабРесурсы	= ПолучитьИзВременногоХранилища(АдресТабРесурсы);
	
	ОбработкаИзмененияРесурсов(ТабРесурсы,ПозицияЛС);
	
	// 1. Удаление замен ресурсов
	Для Каждого ТекСтрока Из ТабУдаления Цикл 
		УдалитьЗаменуНаСервере(ТекСтрока.Ресурс, ПозицияЛС);
	КонецЦикла;
	
	МассивПозиций = Новый Массив;
	МассивПозиций.Добавить(ПозицияЛС);
	
	// Получение факт объема текущей позиции из таб. части акта
	ФактОбъем 		= 0;
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Позиция",ПозицияЛС);
	МассивСтрок = Объект.Позиции.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() > 0 Тогда
		ФактОбъем = МассивСтрок[0].ФактОбъем;
	КонецЕсли;
	
	// 2. Нужно добавить замены ресурсов
	Для Каждого ТекСтрока Из ТабЗамен Цикл
	
		СтруктураРесурса = Новый Структура;
		СтруктураРесурса.Вставить("ЗаменяемыйРесурс",ТекСтрока.ЗамененныйРесурс);
		СтруктураРесурса.Вставить("Ресурс",ТекСтрока.Ресурс);
		СтруктураРесурса.Вставить("РасходПоНорме");
		СтруктураРесурса.Вставить("РасходПоФакту");
		СтруктураРесурса.Вставить("БазисЦена",ТекСтрока.БазиснаяЦена);
		СтруктураРесурса.Вставить("БазисЗарплМаш",ТекСтрока.БазиснаяЗарплатаМашинистов);
		СтруктураРесурса.Вставить("ТекЦена",ТекСтрока.ТекущаяЦена);
		СтруктураРесурса.Вставить("ТекЗарплМаш",ТекСтрока.ТекущаяЗарплатаМашинистов);
		
		СтруктураРесурса.ЗаменяемыйРесурс	= ТекСтрока.ЗамененныйРесурс;	
		СтруктураРесурса.Ресурс				= ТекСтрока.Ресурс;
		Если ФактОбъем > 0 Тогда
			СтруктураРесурса.РасходПоНорме	= ТекСтрока.НормаРасходаОбъем / ФактОбъем;
			СтруктураРесурса.РасходПоФакту	= ТекСтрока.ФактРасходаОбъем / ФактОбъем;
		Иначе
			СтруктураРесурса.РасходПоНорме	= 0;
			СтруктураРесурса.РасходПоФакту	= 0;
		КонецЕсли;
		СМ_СметаВызовСервера.ЗаменитьРесурсВТЧРесурсыАкта(Объект,СтруктураРесурса,МассивПозиций,Истина); 	
	КонецЦикла;
	
	// 3. Удалить строку замененного ресурса по позиции, если были замены
	Если ТабЗамен.Количество() > 0 Тогда
		ТабЗамен.Свернуть("ЗамененныйРесурс");
		МассивЗамененных = ТабЗамен.ВыгрузитьКолонку("ЗамененныйРесурс");
		Для Каждого ТекРесурс Из МассивЗамененных Цикл
			СтруктураРесурса = Новый Структура;
			СтруктураРесурса.Вставить("Ресурс",ТекРесурс);
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Ресурс",ТекРесурс);
			СтруктураОтбора.Вставить("Позиция",ПозицияЛС);

			МассивСтрок = Объект.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
			Для Каждого ТекСтрока Из МассивСтрок Цикл
				Объект.РесурсыПозицийАкта.Удалить(ТекСтрока);	
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	// 3. Перезаполнение ресурсов акта
	ЗаполнитьТаблицуРесурсовАкта();
	
КонецПроцедуры

// Осуществляет замену ресурсов после диалога пользователя (из функции ЗаменаРесурсовПоПозиции).
//
// Параметры:
//   Результат - Произвольный - ответ пользователя на вопрос (продолжать или нет).
//   СтруктураПараметров - Структура - структура описания нового ресурса.
//
&НаКлиенте
Процедура ПровестиЗаменуРесурса(Результат, СтруктураПараметров) Экспорт

	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	// Получение текущих и базисных цен
	СтруктураЦен = Новый Структура();
	СтруктураЦен.Вставить("БазиснаяЦена");
	СтруктураЦен.Вставить("БазиснаяЗарплатаМашинистов");
	СтруктураЦен.Вставить("ТекущаяЦена");
	СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов");
	
	СтруктураДопПараметров = Новый Структура();
	СтруктураДопПараметров.Вставить("Район");
	СтруктураДопПараметров.Вставить("ДатаТекущихЦен");
	СтруктураДопПараметров.Вставить("ФайлТекущихЦен");
	СтруктураДопПараметров.Вставить("АвтозагрузкаЦен");
	СтруктураДопПараметров.Вставить("КодРегионаФайлаТекущихЦен");

	ПолучитьЦеныНовогоРесурса(СтруктураПараметров.Ресурс,СтруктураЦен,СтруктураДопПараметров);
	СтруктураПараметров.БазисЦена 		= СтруктураЦен.БазиснаяЦена;
	СтруктураПараметров.БазисЗарплМаш 	= СтруктураЦен.БазиснаяЗарплатаМашинистов;
	СтруктураПараметров.ТекЦена 		= СтруктураЦен.ТекущаяЦена;
	СтруктураПараметров.ТекЗарплМаш 	= СтруктураЦен.ТекущаяЗарплатаМашинистов;
	
	Если Не СметнаяКомпонента = Неопределено Тогда
		Если СтруктураДопПараметров.АвтозагрузкаЦен = Истина И СтруктураДопПараметров.ФайлТекущихЦен <> "" Тогда
			СМ_СметаКлиент.ПолучитьЦеныНовогоРесурса(СтруктураПараметров.Ресурс,СтруктураДопПараметров.Район,СтруктураДопПараметров.ФайлТекущихЦен,СтруктураДопПараметров.КодРегионаФайлаТекущихЦен,СтруктураЦен); 
			СтруктураПараметров.ТекЦена 		= СтруктураЦен.ТекущаяЦена;
			СтруктураПараметров.ТекЗарплМаш 	= СтруктураЦен.ТекущаяЗарплатаМашинистов;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ЛокальнаяСмета",Объект.ЛокальнаяСмета);
	СтруктураПараметров.Вставить("МестоВызова", "АктЗаменаРесурса");
	
	Оповещение = Новый ОписаниеОповещения("ВводРасходаРесурса", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.СМ_ВводРасходаРесурса",СтруктураПараметров,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры
	
// Осуществляет диалог пользователя (из функции ЗаменаРесурсовПоПозиции).
//
// Параметры:
//   Результат - Произвольный - ответ пользователя на вопрос (продолжать или нет).
//   СтруктураРесурса - Структура - структура описания нового ресурса.
//
&НаКлиенте
Процедура ПолучитьЗаменуРесурса(Результат, СтруктураРесурса) Экспорт
	
	СтруктураРесурса.Ресурс = СМ_СметаКлиент.ПолучитьОдинРесурсИзМассива(Результат);
	
	Если Не ЗначениеЗаполнено(СтруктураРесурса.Ресурс) Тогда
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПровестиЗаменуРесурса", ЭтотОбъект, СтруктураРесурса);
	ПоказатьВопрос(Оповещение, НСтр("ru='Документ будет записан. Продолжить?'"), РежимДиалогаВопрос.ДаНет,0,,"Внимание");	
	
КонецПроцедуры

// Осуществляет ввод расхода ресурсов после диалога пользователя (из функции ЗаменаРесурсовПоПозиции).
//
// Параметры:
//   Результат - Произвольный - ответ пользователя на вопрос (продолжать или нет).
//   Структура - Структура - структура параметров переданных при формировании вопроса пользователю.
//
&НаКлиенте
Процедура ВводРасходаРесурса(Результат, Структура) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.СводныеРесурсы.ТекущиеДанные;
	СтрокаДерева = Неопределено;
	Если ТекущиеДанные <> Неопределено Тогда
		СтрокаДерева = ТекущиеДанные.Ресурс;
	КонецЕсли;
	
	ЗаменитьРесурсыСервер(Результат);
	
КонецПроцедуры

// Осуществляет обновление индексов после диалога пользователя
// 
// Параметры:
//   Результат - Произвольный - ответ пользователя на вопрос (продолжать или нет).
//   СтруктураПараметров - Структура - дополнительные параметры переданные при формировании вопроса пользователю.
//
&НаКлиенте
Процедура ОбновитьИндексыПоСмете(Результат, СтруктураПараметров) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Записать();
	
	Если (Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Расценка")) Тогда
		Если Объект.АвтозагрузкаИндексов И ЗначениеЗаполнено(Объект.ФайлСборникаКоэффициентов) Тогда
			СтруктураДанных = Новый Структура("СборникКоэффициентов", Объект.ФайлСборникаКоэффициентов);
			ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОбИндексахПересчета(Объект.Ссылка, , СтруктураДанных);
			ОбновитьИндексыПоСметеСервер(ДанныеИнд);	 			
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

// Осуществляет обновление текущих цен после диалога пользователя
//
// Параметры:
//   Результат - Произвольный - ответ пользователя на вопрос (продолжать или нет).
//   СтруктураПараметров - Структура - дополнительные параметры переданные при формировании вопроса пользователю.
//
&НаКлиенте
Процедура ОбновитьТекущиеЦеныПоСмете(Результат, СтруктураПараметров) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	Записать();
	Если Объект.АвтозагрузкаЦен Тогда
		Если ЗначениеЗаполнено(Объект.ФайлСборникаТекущихЦен) Тогда
			// обновляем индексы
			СтруктураДанных = Новый Структура("СборникТекущихЦен, КодРегиональнойБазы", Объект.ФайлСборникаТекущихЦен, Объект.КодРегионаФайлаТекущихЦен);
			ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОТекущихЦенах(Объект.Ссылка, , СтруктураДанных);
			ОбновитьТекущиеЦеныПоСметеСервер(ДанныеИнд);
		Иначе
			ОбновитьТекущиеЦеныПоСметеПоРегиструСервер();
		КонецЕсли;
	КонецЕсли;					
КонецПроцедуры

// Процедура открывает диалог формы заявки на материалы
//
// Параметры:
//   Результат - Произвольный - ответ пользователя на вопрос (продолжать или нет).
//   СтруктураПараметров - Структура - дополнительные параметры переданные при формировании вопроса пользователю.
//
&НаКлиенте
Процедура ОткрытьФормуЗаявкиНаМатериалыДиалог(Результат, СтруктураПараметров) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Записать();
	
	Если ЗначениеЗаполнено(Объект.Ссылка)и не ЭтаФорма.Модифицированность Тогда
		ОткрытьФормуЗаявкиНаМатериалы();
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Документ не записан, заявка не может быть оформлена."));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ВидимостьЭлементовФормы

&НаКлиенте
Процедура ПолучитьВариантПоУмолчанию()
	
	Если НЕ ЗначениеЗаполнено(Объект.МетодРасчета) Тогда
		Элементы.МетодРасчета.Видимость			= Истина;
		Элементы.Уровень.Видимость				= Ложь;
		Элементы.СпособРасчетаИндексов.Видимость= Ложь;
		Элементы.ВариантПересчетаЭММ.Видимость	= Ложь;
		Элементы.ВариантРасчетаЗМ.Видимость     = Ложь;
		Элементы.КоэффФОТ.Видимость				= Ложь;
		Элементы.КоэффСМР.Видимость				= Ложь;
		Элементы.КоэффСтоимЭксплМашин.Видимость	= Ложь;
		Элементы.КоэффОборуд.Видимость			= Ложь;
		Элементы.КоэффПрочРаб.Видимость			= Ложь;
		Элементы.КоэффСтоимМатериалов.Видимость = Ложь;
		Элементы.КоэффПолнСтоимРабот.Видимость	= Ложь;
		Элементы.КоэффФОТ.Видимость				= Ложь;
		Элементы.КоэффСМР.Видимость				= Ложь;
		Элементы.КоэффСтоимЭксплМашин.Видимость	= Ложь;
		Элементы.АвтозагрузкаИндексов.Видимость = Ложь;
		Элементы.ИзФайла.Видимость 				= Ложь;
		Элементы.ДатаВыпускаИндексов.Видимость 	= Ложь;
		Элементы.АвтозагрузкаЦен.Видимость 		= Ложь;
		Элементы.ФайлСборника.Видимость 		= Ложь;
		Элементы.ДатаТекущихЦен.Видимость 		= Ложь;
		Элементы.ОбновитьИндексы.Видимость 	= Ложь;
		Элементы.ОбновитьТекЦены.Видимость 	= Ложь;
		Элементы.ГруппаКомандПараметров.ПодчиненныеЭлементы.ВыбранВариант.Заголовок = НСтр("ru='Выбран начальный вариант'");
	Иначе
		СМ_СметаКлиент.ОтобразитьУровеньМетодРасчета(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьОкруглятьДоРублей()
	Если Объект.ОкруглятьДоРублей = Истина Тогда
		Элементы.НеОкруглятьНДС.Доступность = Истина;
	Иначе
		Если ПравоИзменение() Тогда
			Объект.НеОкруглятьНДС = Истина;
		КонецЕсли;
		Элементы.НеОкруглятьНДС.Доступность = Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПравоИзменение()
	Возврат ПравоДоступа("Изменение",Метаданные.Документы.СМ_АктВыполненныхРабот); 	
КонецФункции

&НаКлиенте
Процедура ВидимостьДоступностьЭлементовНаФорме()
	СкрытьПредупреждениеНаФорме();
	СкрытьПредупреждениеИндексовНаФорме();
	// в зависимости от метода счета
	Элементы.КоэффСМР.Видимость				= (СтруктураРасчета.ЭтоБазисноИндексныйУровеньСмета) И (НЕ СтруктураРасчета.ЭтоРасчетПоЭлементамЗатрат) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.КоэффФОТ.Видимость				= (СтруктураРасчета.ЭтоБазисноИндексныйУровеньСмета) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.КоэффОборуд.Видимость			= (СтруктураРасчета.ЭтоБазисноИндексныйУровеньСмета) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.КоэффПрочРаб.Видимость			= (СтруктураРасчета.ЭтоБазисноИндексныйУровеньСмета) И (НЕ СтруктураРасчета.ЭтоРасчетПоЭлементамЗатрат) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.КоэффСтоимЭксплМашин.Видимость	= (СтруктураРасчета.ЭтоБазисноИндексныйУровеньСмета) И (СтруктураРасчета.ЭтоРасчетПоЭлементамЗатрат) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.КоэффСтоимМатериалов.Видимость = (СтруктураРасчета.ЭтоБазисноИндексныйУровеньСмета) И (СтруктураРасчета.ЭтоРасчетПоЭлементамЗатрат) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.КоэффПолнСтоимРабот.Видимость	= Ложь;
	
	Элементы.АвтозагрузкаИндексов.Видимость = (СтруктураРасчета.ЭтоБазисноИндексныйУровеньРасценка) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.ИзФайла.Видимость 				= (СтруктураРасчета.ЭтоБазисноИндексныйУровеньРасценка) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.ДатаВыпускаИндексов.Видимость 	= (СтруктураРасчета.ЭтоБазисноИндексныйУровеньРасценка) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.ОбновитьИндексы.Видимость 		= (СтруктураРасчета.ЭтоБазисноИндексныйУровеньРасценка) И ЗначениеЗаполнено(Объект.МетодРасчета);
	
	Элементы.АвтозагрузкаЦен.Видимость 	= ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.ФайлСборника.Видимость		= ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.ДатаТекущихЦен.Видимость 	= ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.ОбновитьТекЦены.Видимость 	= ЗначениеЗаполнено(Объект.МетодРасчета);

	Элементы.ДатаТекущихЦен.АвтоОтметкаНезаполненного 			= (СтруктураРасчета.ЭтоРесурсныйМетод);

	Элементы.ГруппаРазделы.Видимость 		= НЕ СтруктураРасчета.ЭтоРесурсныйМетод;
	Элементы.ГруппаРазделы.Доступность 		= НЕ СтруктураРасчета.ЭтоРесурсныйМетод;	
	
	Заголовок = СМ_СметаКлиент.ПолучитьТекстИнформацииОбАкте(Объект, СтруктураПараметровРасчетаЛС, НСтр("ru='Акт выполненных работ'"));
	
	ДоступностьВыбораФайла();
	ДоступностьВыбораФайлаЦен();
	ВидимостьСостава();
	
	// Видимость / доступность коэффициентов на закладке состав акта
	Элементы.КоэффициентОснЗарплаты.Видимость 			= Ложь;
	Элементы.КоэффициентСтоимЭксплМашин.Видимость     	= Ложь;
	Элементы.КоэффициентСтоимЗарплатеМашин.Видимость  	= Ложь;
	Элементы.КоэффициентСтоимМатериалы.Видимость      	= Ложь;
	Элементы.КоэффициентОборудование.Видимость        	= Ложь;
	Элементы.КоэффициентСтоимостьРабот.Видимость      	= Ложь;
	Элементы.КоэффициентСМР.Видимость                 	= Ложь;
	Элементы.КоэффициентФОТ.Видимость                	= Ложь;
	Элементы.КоэффициентПрочРаб.Видимость             	= Ложь;
	Элементы.ТекстКоэффициентов.Видимость = Ложь;
	Элементы.ПоказатьИндексы.Видимость = Ложь;
	
	Если  СтруктураРасчета.ЭтоБазисноИндексныйУровеньРаздел Тогда
		Элементы.ГруппаРазделы.ПодчиненныеЭлементы.Подразделы.ПодчиненныеЭлементы.Позиция.Видимость = Ложь;
		Элементы.ГруппаРазделы.ПодчиненныеЭлементы.Подразделы.ПодчиненныеЭлементы.Смета.Видимость = Ложь;
		Элементы.ГруппаРазделы.ПодчиненныеЭлементы.Подразделы.ПодчиненныеЭлементы.Раздел.Видимость = Истина;
	КонецЕсли;

	// Уровень - "Расценка / раздел" 
	Если СтруктураРасчета.ЭтоБазисноИндексныйУровеньРасценка
		ИЛИ СтруктураРасчета.ЭтоБазисноИндексныйУровеньРаздел Тогда
		Элементы.ТекстКоэффициентов.Видимость = Истина;
		Элементы.ПоказатьИндексы.Видимость = Истина;
		 // Способ расчета - "По элементам затрат":
		Если СтруктураРасчета.ЭтоРасчетПоЭлементамЗатрат Тогда
			Элементы.КоэффициентОснЗарплаты.Видимость			= Истина;
			Элементы.КоэффициентСтоимЭксплМашин.Видимость     	= Истина;
			Элементы.КоэффициентСтоимЗарплатеМашин.Видимость  	= Истина;
			Элементы.КоэффициентСтоимМатериалы.Видимость      	= Истина;
			Элементы.КоэффициентОборудование.Видимость        	= Истина;
		// Способ расчета - "К полной стоимости":
		Иначе
			Элементы.КоэффициентСтоимостьРабот.Видимость = Истина;
		КонецЕсли;
		
    // Уровень - "Смета"
	ИначеЕсли СтруктураРасчета.ЭтоБазисноИндексныйУровеньСмета Тогда
		Элементы.ТекстКоэффициентов.Видимость = Истина;
		Элементы.ПоказатьИндексы.Видимость = Истина;
		// Способ расчета - "По элементам затрат":
		Если СтруктураРасчета.ЭтоРасчетПоЭлементамЗатрат Тогда
			Элементы.КоэффициентСтоимЭксплМашин.Видимость     	= Истина;
			Элементы.КоэффициентСтоимМатериалы.Видимость      	= Истина;
			Элементы.КоэффициентОборудование.Видимость        	= Истина;
			Элементы.КоэффициентФОТ.Видимость                 	= Истина;
		// Способ расчета - "К полной стоимости":	
		Иначе
			Элементы.КоэффициентОборудование.Видимость = Истина;
			Элементы.КоэффициентСМР.Видимость          = Истина;
	        Элементы.КоэффициентФОТ.Видимость          = Истина;
			Элементы.КоэффициентПрочРаб.Видимость      = Истина;
		КонецЕсли;
		
	КонецЕсли;
		
	Если СтруктураРасчета.ЭтоБазисноИндексныйУровеньСмета Тогда
		Элементы.ТекстКоэффициентов.Видимость = Истина;
		Элементы.ПоказатьИндексы.Видимость = Истина;
		Элементы.КоэффициентОснЗарплаты.Доступность 		= Ложь;
		Элементы.КоэффициентСтоимЭксплМашин.Доступность     = Ложь;
		Элементы.КоэффициентСтоимЗарплатеМашин.Доступность  = Ложь;
		Элементы.КоэффициентСтоимМатериалы.Доступность      = Ложь;
		Элементы.КоэффициентОборудование.Доступность        = Ложь;
		Элементы.КоэффициентСтоимостьРабот.Доступность      = Ложь;
		Элементы.КоэффициентСМР.Доступность                 = Ложь;
		Элементы.КоэффициентФОТ.Доступность                 = Ложь;
		Элементы.КоэффициентПрочРаб.Доступность             = Ложь;
	
	КонецЕсли;
	
	Если СметнаяКомпонента = Неопределено Тогда
		Элементы.АвтозагрузкаИндексов.Видимость = Ложь;
		Элементы.ДатаВыпускаИндексов.Видимость = Ложь;
		Элементы.ИзФайла.Видимость = Ложь;
		Элементы.ФайлСборника.Видимость = Ложь;
	КонецЕсли;
	
	Если (Объект.Статус = ПредопределенноеЗначение("Перечисление.СМ_СтатусыСметныхДокументов.Согласован")
		И СМ_СметаВызовСервера.ЗначениеОпции("СМ_ИспользоватьСтатусыДокументов")) или ТолькоПросмотрФормы Тогда
		Если Не ТолькоПросмотрФормы Тогда
			ПоказатьПредупреждениеНаФорме(НСтр("ru='Акт согласован, для изменения смените статус!'"));
		КонецЕсли;
		// ДокторСофт
		Для каждого Элем Из ЭтаФорма.Элементы Цикл
			Если ТипЗнч(Элем) = Тип("ДекорацияФормы") ИЛИ ТипЗнч(Элем) = Тип("ДополнениеЭлементаФормы") ИЛИ Элем = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Найти(ВРЕГ(Элем.Имя),"ПЕЧАТ")>0 ИЛИ Элем.Имя = "ФормаЗакрыть" 
				ИЛИ Элем.Имя = "УбратьМобильное" ИЛИ Элем.Имя = "Мобильное"
				ИЛИ Элем.Имя = "ФормаПрисоединенныеФайлы" ИЛИ Элем.Имя = "ФормаЗаписать" Тогда
				Продолжить;
			ИначеЕсли Элем.Имя = "ТаблицаВыполненияВвестиАкт" ИЛИ Элем.Имя = "ТаблицаВыполненияУдалитьАкт" Тогда
				Элем.Доступность = Ложь;
			КонецЕсли;
			Если ТипЗнч(Элем) = Тип("КнопкаФормы") Тогда
				Элем.Доступность = Ложь;
			Иначе
				Элем.ТолькоПросмотр = Истина;
			КонецЕсли;
		КонецЦикла;
		Элементы.ОсновнойСостав.ТолькоПросмотр = Ложь;
		Элементы.Акт.ТолькоПросмотр = Ложь;
		Элементы.Страницы.ТолькоПросмотр = Ложь;
		Элементы.ГруппаНастроекПечати.ТолькоПросмотр = Ложь;
		ПросмотрПодчиненных(Элементы.ГруппаНастроекПечати.ПодчиненныеЭлементы,Ложь);
		// ДокторСофт
		Элементы.ДеревоЛС.КоманднаяПанель.Видимость = Ложь;
		Элементы.ДеревоЛС.КоманднаяПанель.Доступность = Ложь;
	Иначе
		ЭтаФорма.ТолькоПросмотр = Ложь;
		Элементы.ДеревоЛС.КоманднаяПанель.Видимость = Истина;
		Элементы.ДеревоЛС.КоманднаяПанель.Доступность = Истина;
		Для каждого Элем Из ЭтаФорма.Элементы Цикл
			Если ТипЗнч(Элем) = Тип("ДекорацияФормы") ИЛИ ТипЗнч(Элем) = Тип("ДополнениеЭлементаФормы") ИЛИ Элем = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Найти(ВРЕГ(Элем.Имя),"ПЕЧАТ")>0 ИЛИ Элем.Имя = "ФормаЗакрыть" 
				ИЛИ Элем.Имя = "УбратьМобильное" ИЛИ Элем.Имя = "Мобильное"
				ИЛИ Элем.Имя = "ФормаПрисоединенныеФайлы" ИЛИ Элем.Имя = "ФормаЗаписать" Тогда
				Продолжить;
			КонецЕсли;
			Если ТипЗнч(Элем) = Тип("КнопкаФормы") Тогда
				Элем.Доступность = Истина;
			Иначе
				Элем.ТолькоПросмотр = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Админ Тогда
		Элементы.ГруппаГлавная.ТолькоПросмотр = Ложь;
		Элементы.ГруппаСтатус.ТолькоПросмотр = Ложь;
		Элементы.Статус.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	Элементы.Состав.Доступность = ЗначениеЗаполнено(Объект.Ссылка);
	Элементы.Стройка.Доступность = Ложь;
	Элементы.ДеревоЛС.ПодчиненныеЭлементы.ОбъемыВсего.Видимость  = ВидимостьОбъемыВсего();
	
КонецПроцедуры

&НаСервере
Функция ВидимостьОбъемыВсего()
	Возврат ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ПоказыватьВсегоНачало",Ложь); 	
КонецФункции

&НаСервере
Процедура ВидимостьИндексов()
	Элементы.ГруппаРазделы.Видимость = ?(Объект.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный И Объект.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел,Истина,Ложь); 	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьНаВкладкеНастройкаПечати()
	
	ЭтоРесурсный = Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.Ресурсный");
	Элементы.РазвернутыйОтчет.Видимость = ЭтоРесурсный;
	Если НЕ Элементы.РазвернутыйОтчет.Видимость И ПравоИзменение() Тогда
		Объект.РазвернутыйОтчет = Ложь;
	КонецЕсли;
	Элементы.ПоГруппамРесурсов.Видимость = Объект.РазвернутыйОтчет И ЭтоРесурсный;
	
	Если НЕ Объект.ПечататьЗаголовкиРазделов И ПравоИзменение() Тогда
		Объект.ПечататьИтогиПоРазделам = ПредопределенноеЗначение("Перечисление.СМ_ПечатьИтоговРаздела.НеПечатать");
	КонецЕсли;
	
	ПечататьРасшифровку = Не Объект.ПечататьИтогиПоРазделам = ПредопределенноеЗначение("Перечисление.СМ_ПечатьИтоговРаздела.НеПечатать");
	Элементы.ПечататьРасшифровку.Видимость = ПечататьРасшифровку;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьСостава()
	
	Если ЗначениеЗаполнено(Объект.Номер) Тогда
		Элементы.ДеревоЛС.ТолькоПросмотр 				= Ложь;
		Элементы.ДеревоЛС.КоманднаяПанель.Доступность 	= Истина;
	Иначе 
		Элементы.ДеревоЛС.ТолькоПросмотр 				= Истина;
		Элементы.ДеревоЛС.КоманднаяПанель.Доступность 	= Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти        

#Область ЗаполнениеСоставаСметы

&НаСервере
Процедура ЗаполнитьИзСметыНаСервере()
	Объект.КоэффСМР = Объект.ЛокальнаяСмета.КоэффСМР;
	Объект.КоэффФОТ = Объект.ЛокальнаяСмета.КоэффФОТ; 
	Объект.КоэффСтоимМатериалов = Объект.ЛокальнаяСмета.КоэффСтоимМатериалов;
	Объект.КоэффСтоимЭксплМашин = Объект.ЛокальнаяСмета.КоэффСтоимЭксплМашин; 
	Объект.КоэффПрочРаб = Объект.ЛокальнаяСмета.КоэффПрочРаб;
КонецПроцедуры

&НаСервере
Процедура ОбновитьДеревоНаСервере(Действие = "Обновить", СтруктураПараметров = Неопределено, СохраненнаяСтрока = Неопределено, НеОбновлятьТабличныеЧасти = Ложь)
	
	УчитаватьЗамены = Ложь;
	
	// Создание структуры параметров вывода дерева
	Если СтруктураПараметров = Неопределено Тогда
		СтруктураПараметров = Новый Структура;	
	КонецЕсли;
	
	// Вывод дерева акта
	Дерево = РеквизитФормыВЗначение("ДеревоЛС");
	
	Если Действие = "Обновить" Тогда
		СМ_СметныйСоставВызовСервера.ВывестиОбновитьДерево(Объект.ЛокальнаяСмета,Дерево,Объект,НеОбновлятьТабличныеЧасти);
	ИначеЕсли Действие = "Процентовать" Тогда
		СМ_СметныйСоставВызовСервера.ПроцентоватьОбновитьДеревоАкт(Дерево,Объект.ЛокальнаяСмета,СтруктураПараметров,Объект);
		УчитаватьЗамены = Истина;
	ИначеЕсли Действие = "ЗаполнитьПоОстаткам" Тогда
		СМ_СметныйСоставВызовСервера.ЗаполнитьПоОстаткамОбновитьДерево(Дерево,Объект.ЛокальнаяСмета,СтруктураПараметров,Объект);
		УчитаватьЗамены = Истина;
	КонецЕсли;
	
	ЗначениеВДанныеФормы(Дерево,ДеревоЛС); 
	
	ЗаполнитьТаблицуРесурсовАкта(УчитаватьЗамены);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработкиСметногоСостава

&НаСервере
Процедура ПроцентоватьНаСервере(Процент,МассивПозиций=Неопределено)
	
	СтруктураПараметров = Новый Структура;
	// СтруктураПараметров.Вставить("ПроцентоватьАкт",Истина);
	СтруктураПараметров.Вставить("Процент",Процент);
	СтруктураПараметров.Вставить("МассивПозиций",МассивПозиций);

	ОбновитьДеревоНаСервере("Процентовать",СтруктураПараметров);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОстаткамНаСервере(МассивПозиций=Неопределено)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("МассивПозиций",МассивПозиций);
	ОбновитьДеревоНаСервере("ЗаполнитьПоОстаткам",СтруктураПараметров);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоСметеНаСервере(МассивПозиций=Неопределено)
	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("Процент",0);
	СтруктураПараметров.Вставить("МассивПозиций",МассивПозиций);

	// Созраняем объемы
	ТаблицаИсходногоАкта = Объект.Позиции.Выгрузить(,"Позиция, ФактОбъем");
	
	Объект.Разделы.Очистить();
	Объект.Позиции.Очистить();
	Объект.РесурсыПозицийАкта.Очистить();
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("КопироватьИндексы",Истина);
	СтруктураПараметров.Вставить("Процентовать",Истина);
	СтруктураПараметров.Вставить("Процент",0);
	СтруктураПараметров.Вставить("ЗаполнитьПоОстаткам",Ложь);
	СтруктураПараметров.Вставить("МассивПозиций",МассивПозиций);
	СтруктураПараметров.Вставить("ТаблицаСтарыхОбъемов",ТаблицаИсходногоАкта);
	
	ОбновитьДеревоНаСервере("Процентовать",СтруктураПараметров);
	
	ЭтаФорма.Модифицированность = Истина;
	
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеТабличныхЧастейАкта

&НаСервере
Процедура ЗаполнитьПодписиНаСервере()
	Объект.Подписи.Загрузить(Объект.ЛокальнаяСмета.Подписи.Выгрузить());
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЛимитированныеЗатраты()
	
	// Табличная часть "Лимитированные затраты"
	// Заполнение ЛЗ из локальной сметы.
	ТекОбъект = Объект;
	ТекЛокальнаяСмета = Объект.ЛокальнаяСмета;
	ТекОбъект.ЛимитированныеЗатраты.Очистить();
	ДобавитьЛЗизДокумента(ТекОбъект, ТекЛокальнаяСмета);
	
	Если ЗначениеЗаполнено(ТекЛокальнаяСмета.ИДРодителя) Тогда
		ТекРодитель = ТекЛокальнаяСмета.ИДРодителя;
		
		// Заполнение ЛЗ по родителю локальной сметы (Сводная или объектная смета)
		ДобавитьЛЗизДокумента(ТекОбъект,ТекРодитель);
		
		// Заполнение ЛЗ из сводной сметы, которой подчинена объектная смета
		Если ТипЗнч(ТекЛокальнаяСмета.ИДРодителя) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
			Если ЗначениеЗаполнено(ТекРодитель.ИДРодителя) Тогда
				ДобавитьЛЗизДокумента(ТекОбъект,ТекРодитель.ИДРодителя);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ТЗ = ТекОбъект.ЛимитированныеЗатраты.выгрузить();
	ТЗ.Свернуть("ЛимитированнаяЗатрата,ФормулаЛимЗатраты,ФормулаБазисногоЗначениеЛимЗатраты,Примечание,Расчет","ЗначениеЛимЗатраты,БазисноеЗначениеЛимЗатраты,КоэффициентСметнойЗарплаты,КоэффициентТрудоемкости");
	ТекОбъект.ЛимитированныеЗатраты.Загрузить(ТЗ);	
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЛЗизДокумента(ТекОбъект, ТекДокумент)
	
	Для Каждого ТекСтрокаЛимитированныеЗатраты Из ТекДокумент.ЛимитированныеЗатраты Цикл
		НоваяСтрока = ТекОбъект.ЛимитированныеЗатраты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрокаЛимитированныеЗатраты);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуРесурсовАкта(УчитыватьЗамены = Ложь)

	СводныеРесурсы.Очистить();
	Если УчитыватьЗамены Тогда
		Запрос 			= Новый Запрос;
		Запрос.Текст 	= "
		|ВЫБРАТЬ
		|	СМ_АктВыполненныхРабот.Ссылка
		|ИЗ
		|	Документ.СМ_АктВыполненныхРабот КАК СМ_АктВыполненныхРабот
		|ГДЕ
		|	СМ_АктВыполненныхРабот.Проведен И
		|	СМ_АктВыполненныхРабот.ЛокальнаяСмета = &ЛокальнаяСмета";
		Запрос.УстановитьПараметр("ЛокальнаяСмета",Объект.ЛокальнаяСмета);
		
		СписокАктов = Новый СписокЗначений();
		СписокАктов.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
		ТаблицаПредыдущихЗамен = СМ_СметаВызовСервера.ПолучитьЗамененныеРесурсыАктов(СписокАктов); 
		Для Каждого стр Из ТаблицаПредыдущихЗамен Цикл
			
			Если ТипЗнч(стр.ЗамененныйРесурс) = Тип("СправочникСсылка.СМ_Ресурсы") Тогда
				МассивСтрок = Объект.РесурсыПозицийАкта.НайтиСтроки(Новый Структура("Позиция,Ресурс",стр.Позиция,стр.ЗамененныйРесурс));
			Иначе
				МассивСтрок = Объект.РесурсыПозицийАкта.НайтиСтроки(Новый Структура("Позиция,НаименованиеРесурса",стр.Позиция,стр.ЗамененныйРесурс));
			КонецЕсли;
			
			Если МассивСтрок.Количество() = 0 Тогда
				Продолжить;                                                                      
			КонецЕсли;
			
			НайденаСтрока 						= МассивСтрок[0];
			НайденаСтрока.Ресурс 				= стр.НовыйРесурс; 
			НайденаСтрока.НаименованиеРесурса 	= стр.НовыйРесурс.ДлинноеНаименование;
			НайденаСтрока.СметныйКодРесурса 	= стр.НовыйРесурс.Код;
			НайденаСтрока.Заменен 				= Истина;
			
		КонецЦикла;
	КонецЕсли;

	ТаблСтоимРес = СМ_СметаРасчетСервер.ПолучитьТаблицуСтоимостиРесурсовАкта(Объект,Истина,,,,Истина,,Истина,Истина,,Истина);
	
	СводныеРесурсы.Загрузить(ТаблСтоимРес);
	
КонецПроцедуры

#КонецОбласти

#Область Прочее

&НаСервере
Процедура ВывестиСтрокуИтога()
	
	ВыделенныеСтроки = Элементы.ДеревоЛС.ВыделенныеСтроки;
	Элементы.ТекстИтога.Заголовок = "";
	
	МассивСмет = Новый Массив;
	МассивРазделов = Новый Массив;
	МассивПозиций = Новый Массив;
	
	Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		ТекСтрока = ДеревоЛС.НайтиПоИдентификатору(ИдентификаторСтроки);
		ТекДокумент = ТекСтрока.Элемент.Ссылка;
		Если ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			МассивСмет.Добавить(ТекДокумент);
		ИначеЕсли ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда 
			МассивРазделов.Добавить(ТекДокумент);
		ИначеЕсли ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			МассивПозиций.Добавить(ТекДокумент);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивСмет.Количество() > 0 Тогда
		// Выводим итог по смете
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СМ_ИтогиПоСмете.ТекПрямЗатраты КАК Сумма
		               |ИЗ
		               |	РегистрСведений.СМ_ИтогиПоСмете КАК СМ_ИтогиПоСмете
		               |ГДЕ
		               |	СМ_ИтогиПоСмете.Смета = &Смета
		               |	И СМ_ИтогиПоСмете.Итог = &Итог";
		Запрос.УстановитьПараметр("Смета", Объект.Ссылка);
		Запрос.УстановитьПараметр("Итог", Справочники.СМ_ИтогиПоСмете.ВсегоПоСмете);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если Выборка.Сумма <> Null Тогда
				Элементы.ТекстИтога.Заголовок = НСтр("ru='Итого по акту: '") + " " + Формат(Выборка.Сумма, "ЧДЦ=2");
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли МассивРазделов.Количество() > 0 Тогда
		// Выводим итог по разделам
		МассивРазделовДляРасчета = Новый Массив;
		ЗаполнитьМассивРазделамиДляСтрокиИтогов(ДеревоЛС, МассивРазделов, МассивРазделовДляРасчета);
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СУММА(СМ_ИтогиПоРазделу.ТекПрямЗатраты) КАК Сумма
		               |ИЗ
		               |	РегистрСведений.СМ_ИтогиПоРазделу КАК СМ_ИтогиПоРазделу
		               |ГДЕ
		               |	СМ_ИтогиПоРазделу.Смета = &Смета
		               |	И СМ_ИтогиПоРазделу.Раздел В(&Раздел)
		               |	И СМ_ИтогиПоРазделу.Итог = &Итог";
		Запрос.УстановитьПараметр("Смета", Объект.Ссылка);
		Запрос.УстановитьПараметр("Раздел", МассивРазделовДляРасчета);
		Запрос.УстановитьПараметр("Итог", Справочники.СМ_ИтогиПоРазделу.ВсегоПоРазделу);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если Выборка.Сумма <> Null Тогда
				Элементы.ТекстИтога.Заголовок = НСтр("ru='Итого по разделу:'") + " " + Формат(Выборка.Сумма, "ЧДЦ=2");
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли МассивПозиций.Количество() > 0 Тогда 
		// Выводим итог позициям
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	СМ_ПозицияЛокальнойСметы.Ссылка КАК Позиция
		               |ПОМЕСТИТЬ Позиции
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметы.Ссылка В(&МассивПозиций)
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	СМ_ПозицияЛокальнойСметы.Ссылка
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметы.ИДПозицииВладельца В(&МассивПозиций)
		               |;
					   |
		               |////////////////////////////////////////////////////////////////////////////////
					   |";
		Если СтруктураРасчета.ЭтоБазисноИндексныйУровеньРасценка Тогда
			Запрос.Текст = Запрос.Текст + 	
	          "ВЫБРАТЬ
	          |	СУММА(СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимПрямЗатраты) КАК Сумма,
	          |	МАКСИМУМ(ВЫБОР
	          |			КОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция.ИДПозицииВладельца = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	          |				ТОГДА ЛОЖЬ
	          |			ИНАЧЕ ИСТИНА
	          |		КОНЕЦ) КАК ЕстьНеучтенные
	          |ИЗ
	          |	РегистрСведений.СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета КАК СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета
	          |ГДЕ
	          |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета = &Смета
	          |	И СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция В
	          |			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	          |				Позиции.Позиция
	          |			ИЗ
	          |				Позиции)";
		Иначе
			Запрос.Текст = Запрос.Текст + 
			  "ВЫБРАТЬ
			  |	СУММА(СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимПрямЗатраты) КАК Сумма,
			  |	МАКСИМУМ(ВЫБОР
			  |			КОГДА СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.ИДПозицииВладельца = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
			  |				ТОГДА ЛОЖЬ
			  |			ИНАЧЕ ИСТИНА
			  |		КОНЕЦ) КАК ЕстьНеучтенные
			  |ИЗ
			  |	РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП КАК СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП
			  |ГДЕ
			  |	СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Смета = &Смета
			  |	И СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция В
			  |			(ВЫБРАТЬ РАЗЛИЧНЫЕ
			  |				Позиции.Позиция
			  |			ИЗ
			  |				Позиции)";
		КонецЕсли;
		Запрос.УстановитьПараметр("Смета", Объект.Ссылка);
		Запрос.УстановитьПараметр("МассивПозиций", МассивПозиций);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если Выборка.Сумма <> Null Тогда
				Если Выборка.ЕстьНеучтенные Тогда
					Элементы.ТекстИтога.Заголовок = НСтр("ru='Итого с неучтенными:'") + " " + Формат(Выборка.Сумма, "ЧДЦ=2");
				Иначе
					Элементы.ТекстИтога.Заголовок = НСтр("ru='Итог по позиции:'") + " " + Формат(Выборка.Сумма, "ЧДЦ=2"); 
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМассивРазделамиДляСтрокиИтогов(СтрокаДерева, МассивРазделов, МассивРазделовДляРасчета)
	
	Для Каждого ТекСтрока Из СтрокаДерева.ПолучитьЭлементы() Цикл
		ИндексЭлемента = МассивРазделов.Найти(ТекСтрока.Элемент);
		Если ИндексЭлемента = Неопределено Тогда
			ЗаполнитьМассивРазделамиДляСтрокиИтогов(ТекСтрока, МассивРазделов, МассивРазделовДляРасчета);	
		Иначе
			МассивРазделовДляРасчета.Добавить(МассивРазделов[ИндексЭлемента]);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтогиПоАкту(НовыйОбъем, СохраненнаяСтрока = Неопределено)
	
	ТекДанные = Элементы.ДеревоЛС.ТекущиеДанные;
	Позиция	  = ТекДанные.Элемент;
	
	СтрокаДерева = Неопределено;
	СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(СтрокаДерева, ТекДанные, Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы());
	
	// Сохранение текущей строки дерева
	Если СохраненнаяСтрока <> Неопределено Тогда
		СтрокаДерева.ТекущийЭлемент = СохраненнаяСтрока;
	КонецЕсли;
	
	Если Объект.ОкруглятьДоРублей Тогда
		ТекДанные.ОбщВсего 					= Окр(ТекДанные.ЕдВсего * НовыйОбъем,0);
		ТекДанные.ОбщОснЗП 					= Окр(ТекДанные.ЕдОснЗП * НовыйОбъем,0);
		ТекДанные.ОбщЭксплМашин				= Окр(ТекДанные.ЕдЭксплМашин * НовыйОбъем,0);
		ТекДанные.ОбщЭМЗарПлата 			= Окр(ТекДанные.ЕдЭМЗарПлата * НовыйОбъем,0);
		ТекДанные.ОбщСтоимостьМатериалов	= Окр(ТекДанные.ЕдСтоимостьМатериалов * НовыйОбъем,0);
	Иначе
		ТекДанные.ОбщВсего 					= ТекДанные.ЕдВсего * НовыйОбъем;
		ТекДанные.ОбщОснЗП 					= ТекДанные.ЕдОснЗП * НовыйОбъем;
		ТекДанные.ОбщЭксплМашин				= ТекДанные.ЕдЭксплМашин * НовыйОбъем;
		ТекДанные.ОбщЭМЗарПлата 			= ТекДанные.ЕдЭМЗарПлата * НовыйОбъем;
		ТекДанные.ОбщСтоимостьМатериалов	= ТекДанные.ЕдСтоимостьМатериалов * НовыйОбъем;
	КонецЕсли;
	
	ТекДанные.ОбщЗатрТрРаб 	= ТекДанные.ЕдЗатрТрРаб * НовыйОбъем;
	ТекДанные.ОбщЗатрТрМех 	= ТекДанные.ЕдЗатрТрМех * НовыйОбъем;
	
	ОбновитьТЧПозицииРесурсы(Позиция,НовыйОбъем);
	
	// Восстановление текущей строки дерева
	СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы(), ДеревоЛС, СтрокаДерева);         	
	
	ЭтаФорма.Модифицированность = Истина;

	ЗаполнитьТаблицуРесурсовАкта();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТЧПозицииРесурсы(ТекПозиция,НовыйОбъем)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Позиция",ТекПозиция);
	
	// Обновление табличной части "Позиции"
	МассивСтрок = Объект.Позиции.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() > 0 Тогда
		НоваяСтрока = МассивСтрок[0];		
	Иначе
		НоваяСтрока = Объект.Позиции.Добавить();	
	КонецЕсли;
	
	НоваяСтрока.Позиция               		= ТекПозиция;
	НоваяСтрока.ФактОбъем                   = НовыйОбъем;
	НоваяСтрока.ФормулаОбъема               = ТекПозиция.ФормулаОбъема;
	НоваяСтрока.ВидРабот                    = ТекПозиция.Определитель.ВидРабот;
	НоваяСтрока.ТекущаяЦена					= ТекПозиция.ТекущаяЦена;
	НоваяСтрока.ТекущаяЗарплатаМашинистов	= ТекПозиция.ЗарплМашинистов;
	НоваяСтрока.НормРасход                  = НовыйОбъем;
	
	// Перерасчет позиции ЛС при изменении объема.
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(ТекПозиция,Ложь,ТекОбъект);
	
	// Поиск удаленных / замененных / добавленных ресурсов.
	// Обновление табличной части "РесурсыПозицийАкта".
	Для Каждого ТекСтрока Из ТекПозиция.РесурсыПозицииЛокальнойСметы Цикл
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Позиция",ТекПозиция);
		СтруктураОтбора.Вставить("Ресурс",ТекСтрока.Ресурс);
		СтруктураОтбора.Вставить("СметныйКодРесурса",ТекСтрока.СметныйКодРесурса);
		
		МассивСтрок = Объект.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 Тогда
			НоваяСтрока = МассивСтрок[0];	
		Иначе
			НоваяСтрока = Объект.РесурсыПозицийАкта.Добавить();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрока);
		
		// ***********************************************
		// ++ AVV Ошибки учета ресурсов акта.
		// При изменении факт объема по акту, нужно изменить норму расхода на объем.
		// Если этого не делать, то норма расхода на объем в акте, остается рассчитанной по объему позиции из сметы.
		ТаблПоправок = ТекПозиция.ПоправкиПозиции;
		Если НоваяСтрока.НормаРасходаОбъем = 0 Тогда
			ТекНормаРасхода 	= ТекСтрока.НормаРасхода;
			КоэффициентПоправки = 1;
			
			Для Каждого СтрокаТаблПоправок Из ТаблПоправок Цикл
				Если НЕ СтрокаТаблПоправок.Применить Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда	
					КоэффициентПоправки = СтрокаТаблПоправок.КоэффТР;	
				ИначеЕсли ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда	
					КоэффициентПоправки = СтрокаТаблПоправок.КоэффТМ;	
				ИначеЕсли ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда	
					КоэффициентПоправки = СтрокаТаблПоправок.КоэффСМ;	
				ИначеЕсли ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда	
					КоэффициентПоправки = СтрокаТаблПоправок.КоэффЭМ;	
				КонецЕсли;
					
			КонецЦикла;
			
			Если КоэффициентПоправки = 0 Тогда
				КоэффициентПоправки = 1;	
			КонецЕсли;
			
			НоваяСтрока.НормаРасходаОбъем 	= КоэффициентПоправки * ТекНормаРасхода * НовыйОбъем;
			НоваяСтрока.ФактРасходаОбъем	= КоэффициентПоправки * ТекНормаРасхода * НовыйОбъем;
		Иначе
			Если НовыйОбъем <> 0 Тогда
				КоэффициентОбъема 				= НовыйОбъем / ТекПозиция.ОбъемРабот;
				НоваяСтрока.НормаРасходаОбъем 	= ТекСтрока.НормаРасхода * НовыйОбъем * КоэффициентОбъема;
				НоваяСтрока.ФактРасходаОбъем	= ТекСтрока.НормаРасхода * НовыйОбъем * КоэффициентОбъема;
			Иначе
				НоваяСтрока.НормаРасходаОбъем 	= ТекСтрока.НормаРасхода * НовыйОбъем;
				НоваяСтрока.ФактРасходаОбъем	= ТекСтрока.НормаРасхода * НовыйОбъем;
			КонецЕсли;
		КонецЕсли;
	
		НоваяСтрока.Позиция = ТекПозиция;
		// -- AVV
		// *******************************************************************
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроставитьЗначениеПотомкамВсем(ТекущаяСтрока, Значение, Имя, Перерасчет = Ложь)
	
	Для Каждого Строка Из ТекущаяСтрока.ПолучитьЭлементы() Цикл
		Строка[Имя] = Значение;
		ПроставитьЗначениеПотомкамВсем(Строка, Значение, Имя);
	КонецЦикла;	
	СМ_СметаВызовСервера.УстановитьРеквизитДокумента(ТекущаяСтрока.Элемент, Имя, Значение, Перерасчет);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКоэффициента(НаименованиеКоэффициента, ЗначениеКоэффициента,ТекДок)

	// 1. Базисно-индексный метод и уровень расчета индексов "Позиция/Расценка"
	Если Объект.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
		И Объект.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка Тогда
		
		// Обновить коэффициенты позиции
		Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			ОбновитьИндексПоДокументу(ТекДок,НаименованиеКоэффициента,ЗначениеКоэффициента)
			// Обновить коэффициенты разделов и позиций ЛС, подчиненных текущему разделы
		ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			ТабДокументов = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(ТекДок,Истина,Истина,Ложь,Ложь);
			Для Каждого ТекСтрока Из ТабДокументов Цикл
				ОбновитьИндексПоДокументу(ТекСтрока.ИД,НаименованиеКоэффициента,ЗначениеКоэффициента);
			КонецЦикла;
			// Обновить коэффициенты всех позиций ЛС, подчиненных локальной смете
		ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			ТабДокументов = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(ТекДок,Ложь,Истина,Истина,Истина);
			Для Каждого ТекСтрока Из ТабДокументов Цикл
				ОбновитьИндексПоДокументу(ТекСтрока.ИД,НаименованиеКоэффициента,ЗначениеКоэффициента);
			КонецЦикла;
		КонецЕсли;		
		
		// 2. Базисно-индексный метод и уровень расчета индексов "Раздел"
	ИначеЕсли Объект.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
		И Объект.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда
		
		// Обновить коэффициенты текущего раздела и разделов, подчиненных текущему
		Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			
			ОбновитьИндексПоДокументу(ТекДок,НаименованиеКоэффициента,ЗначениеКоэффициента);
			
			ТабДокументов = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(ТекДок,Истина,Ложь,Ложь,Ложь);
			Для Каждого ТекСтрока Из ТабДокументов Цикл
		     	ОбновитьИндексПоДокументу(ТекСтрока.ИД,НаименованиеКоэффициента,ЗначениеКоэффициента);
			КонецЦикла;
		
		// Обновить коэффициенты всех разделов ЛС, подчиненных локальной смете
		ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			
			ТабДокументов = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(ТекДок,Истина,Ложь,Ложь,Ложь);
			Для Каждого ТекСтрока Из ТабДокументов Цикл
		     	ОбновитьИндексПоДокументу(ТекСтрока.ИД,НаименованиеКоэффициента,ЗначениеКоэффициента);
			КонецЦикла;

		КонецЕсли;			
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИндексПоДокументу(ТекДок,НаименованиеКоэффициента,ЗначениеКоэффициента)
	
	Если ТекДок.Расчет Тогда
		// Обновить коэффициент позиции
		Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Позиция",ТекДок);
			МассивСтрок = Объект.Позиции.НайтиСтроки(СтруктураОтбора);
		// Обновить коэффициент раздела
		ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Раздел",ТекДок);
			МассивСтрок = Объект.Разделы.НайтиСтроки(СтруктураОтбора);
		КонецЕсли;	
		
		Для Каждого ТекСтрока Из МассивСтрок Цикл
			ТекСтрока[НаименованиеКоэффициента] = ЗначениеКоэффициента;	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

