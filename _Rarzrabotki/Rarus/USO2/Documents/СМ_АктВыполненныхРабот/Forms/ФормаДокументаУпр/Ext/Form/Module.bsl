&НаСервере
Функция ПолучитьСтруктуруПараметров(ПозицияЛС)

	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Позиция", ПозицияЛС);
	
	ТабРесурсы 			= Объект.РесурсыПозицийАкта.Выгрузить();
	МассивСтрокРесурсов = Объект.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора); 
	СсылкаНаРесурсы 	= ПоместитьВоВременноеХранилище(МассивСтрокРесурсов); 	
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Позиция",ПозицияЛС);
	СтруктураПараметров.Вставить("АктВыполненныхРабот",Объект.Ссылка);
	СтруктураПараметров.Вставить("АдресРесурсов",СсылкаНаРесурсы);

	Возврат СтруктураПараметров;

КонецФункции

