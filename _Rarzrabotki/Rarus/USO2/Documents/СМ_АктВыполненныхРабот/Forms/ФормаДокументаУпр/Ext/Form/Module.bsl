#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоЛС

&НаКлиенте
Процедура ДеревоЛСВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущийДокумент 		= Элементы.ДеревоЛС.ТекущиеДанные.Элемент;
	СтруктураОткрытия 		= Новый Структура("Ключ",ТекущийДокумент);
	ТекЭлем				= Элементы.ДеревоЛС.ТекущийЭлемент.Имя;
		
	Если ТекЭлем <> "ДеревоЛСКол"
		И ТекЭлем <> "ДеревоЛСОбъемПоАктуПроцент"
		И ТекЭлем <> "ДеревоЛСОбъемПоАкту"
		И СтрНайти(ТекЭлем,"ДопРеквизит_")=0 Тогда
		 
    	СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(ТекСтрокаДерева, Элементы.ДеревоЛС.ТекущиеДанные, Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы());
 
		Если ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			ТекДанные = Элементы.ДеревоЛС.ТекущиеДанные;
			СтатусРедактирования = Элементы.ДеревоЛС.ТекущиеДанные.СтатусРедактирования;
			СтатусРедактирования = ?(Не СМ_СметаВызовСервера.ЗначениеОпции("СМ_РазрешитьРедактированиеЗакрытыхСмет") И СтатусРедактирования = 1,2,СтатусРедактирования);

			СтруктураОткрытия.Вставить("ПозицияАкта",Истина);
			СтруктураОткрытия.Вставить("Акт",Объект.Ссылка);
			СтруктураОткрытия.Вставить("СтарыйФактОбъем",ТекДанные.ОбъемПоАкту);
			СтруктураОткрытия.Вставить("ОбъемВсегоБезАкта",ТекДанные.ОбъемВсего - ТекДанные.ОбъемПоАкту);
			СтруктураОткрытия.Вставить("СтатусРедактирования",СтатусРедактирования);
			ФормаДокумента = "Документ.СМ_ПозицияЛокальнойСметы.ФормаОбъекта";
			// Для раскраски позции акта - пока не удалять
			// ОповещениеПозиция = Новый ОписаниеОповещения("ПослеЗакрытияФормыПозиции",ЭтотОбъект,ТекущийДокумент);
			// ОткрытьФорму(ФормаДокумента,СтруктураОткрытия,ЭтаФорма,,,,ОповещениеПозиция,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			СтруктураОткрытия.Вставить("ПозицияАкта",Истина);
			СтруктураОткрытия.Вставить("Акт",Объект.Ссылка);
			ФормаДокумента = "Документ.СМ_РазделЛокальнойСметы.ФормаОбъекта";
		ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			ФормаДокумента = "Документ.СМ_ЛокальнаяСмета.ФормаОбъекта";
		КонецЕсли;	
		
		ОткрытьФорму(ФормаДокумента,СтруктураОткрытия,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЛСПриАктивизацииСтроки(Элемент)
	
	Если Не ЭтаФорма.открыта() Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ДеревоЛС.ТекущиеДанные = Неопределено Тогда
		Элементы.ТекстИтога.Заголовок = "";
		Элементы.ТекстКоэффициентов.Видимость = Элементы.ПоказатьИндексы.Пометка;
		Возврат;
	КонецЕсли;

	ТекДок = Элементы.ДеревоЛС.ТекущиеДанные.Элемент;
	
	Если ТекЭлемент <> ТекДок Тогда
		ТекЭлемент = ТекДок;
		ВывестиСтрокуИтога();
	КонецЕсли;
	
	Если СтруктураРасчета.ЭтоБазисноИндексныйУровеньРасценка Тогда
		
		Элементы.ТекстКоэффициентов.Заголовок = "";
		УстановитьДоступностьИндексовСостава(Истина);
		
		// Индексы доступны для редактирования 
		Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			ПоказатьКоэффициентыПоПозиции(ТекДок);
		ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			Элементы.ТекстКоэффициентов.Заголовок = НСтр("ru='Введенные коэффициенты будут занесены во все позиции раздела'");
			ПоказатьКоэффициентыПоРазделу(ТекДок);
		ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			Элементы.ТекстКоэффициентов.Заголовок = НСтр("ru='Введенные коэффициенты будут занесены во все позиции сметы'");
			ПоказатьКоэффициентыПоСмете();	
		КонецЕсли;
		
	ИначеЕсли СтруктураРасчета.ЭтоБазисноИндексныйУровеньРаздел Тогда
		
		УстановитьДоступностьИндексовСостава(Истина);
		
		// Индексы недоступны для редактирования, 
		// Отображаются значения равные значениям вышестоящего раздела.
		Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			
			УстановитьДоступностьИндексовСостава(Ложь);
			ТекРодитель = ПолучитьРодителяЭлемента(ТекДок);
			
			Если ЗначениеЗаполнено(ТекРодитель) Тогда
				Если ТипЗнч(ТекРодитель) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда				
					ПоказатьКоэффициентыПоРазделу(ТекРодитель);
				Иначе
					ПоказатьКоэффициентыПоРазделу();
				КонецЕсли;
			Иначе
				ПоказатьКоэффициентыПоРазделу();
			КонецЕсли;
			
		Иначе
			ПоказатьКоэффициентыПоРазделу(ТекДок);	
		КонецЕсли;
		
	ИначеЕсли СтруктураРасчета.ЭтоБазисноИндексныйУровеньСмета Тогда
		
		// Индексы недоступны для редактирования
		// Индексы отображаются информативно (они едины для всех элементов дерева). 
		ПоказатьКоэффициентыПоСмете();
		
	КонецЕсли;

	// ОбновитьИтогиПоАкту(НовыйОбъем);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЛСПередНачаломИзменения(Элемент, Отказ)

	ТекЭлем 	= Элементы.ДеревоЛС.ТекущийЭлемент;
	
	СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(ТекСтрокаДерева, Элементы.ДеревоЛС.ТекущиеДанные, Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы());

	// В дереве акта нельзя отключать признак «Расчет». 
	// Если позиция не должна попасть в акт, у нее будет нулевой объем.
	Если ТекЭлем.Имя = "ДеревоЛСРасчет" Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если ТекЭлем.Имя <> "ДеревоЛСОбъемПоАкту"
		И ТекЭлем.Имя <> "ДеревоЛСОбъемПоАктуПроцент" 
		И ТекЭлем.Имя <> "ДеревоЛСРасчет"
		И СтрНайти(ТекЭлем.Имя,"ДопРеквизит_")=0 Тогда
		
		Отказ = Истина;
		Возврат;
	
	КонецЕсли;
	
	Если ТекЭлем.Имя = "ДеревоЛСОбъем"  Тогда
		ТекДанные 	= Элемент.ТекущиеДанные.Элемент;
		Если Не ТипЗнч(ТекДанные) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	ИначеЕсли СтрНайти(ТекЭлем.Имя,"ДопРеквизит_")>0 Тогда
		ТекДанные 	= Элемент.ТекущиеДанные.Элемент;
		Если ТипЗнч(ТекДанные) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоЛСПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы(), ДеревоЛС, ТекСтрокаДерева);
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЛСРасчетПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ДеревоЛС.ТекущиеДанные;
	ПроставитьЗначениеПотомкамВсем(ТекущаяСтрока, ТекущаяСтрока.Расчет, "Расчет", Истина);
	
КонецПроцедуры

// Функция заполнения структуры параметров вывода дерева акта, по параметрам формы
&НаКлиенте
Процедура ДеревоЛСОбъемПоАктуПриИзменении(Элемент)
	
	ТекДанные 		= Элементы.ДеревоЛС.ТекущиеДанные;
	ТекДокумент 	= ТекДанные.Элемент;
	НовыйОбъем 		= ТекДанные.ОбъемПоАкту;
	СтарыйПроцент 	= ТекДанные.ОбъемПоАктуПроцент;
	
	Если СтрНайти(НовыйОбъем,"=") > 0 Тогда
		НовыйОбъем 		= СтрЗаменить(НовыйОбъем,",",".");
		ФормулаИзменена = Ложь;
		ТекФормула 		= СокрЛП(Сред(НовыйОбъем,2));
		Если ЗначениеЗаполнено(ТекФормула) Тогда
			ТекФормула = ОчиститьФормулу(ТекФормула);
			Попытка
				Формула = "ТекОбъем = " + ТекФормула+"; ФактОбъем = ТекОбъем;";
				Выполнить(Формула);
				ТекФормула 		= СМ_СметаВызовСервера.ПересчитатьФормулаВбазовыхЕдиницахИзмерения(ТекДокумент,ТекФормула);
				ФормулаИзменена = Истина;
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Ошибка в формуле, объем не изменен'"));
			КонецПопытки;
			
			Если ФормулаИзменена Тогда
				ТекДанные.ОбъемПоАктуПроцент = НовыйОбъем / ТекДанные.Кол * 100;
				ОбновитьИтогиПоАкту(НовыйОбъем);
				
				ТекДанные 	= Элементы.ДеревоЛС.ТекущиеДанные;
				ТекДокумент = ТекДанные.Элемент;
				НовыйОбъем 	= ТекДанные.Кол;	
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если ВводОбъемовВБазовыхЕдИзм Тогда
			НовыйОбъем = СМ_СметаВызовСервера.ПересчитатьВбазовыхЕдиницахИзмерения(ТекДокумент,ТекДанные.ОбъемПоАкту);
		КонецЕсли;	
	
		Если НовыйОбъем = 0 Тогда
			НовыйПроцент = 0;
		Иначе	
			Если ТекДанные.Кол <> 0 Тогда
				НовыйПроцент = НовыйОбъем / ТекДанные.Кол * 100;
			Иначе 
				НовыйПроцент = 0;
			КонецЕсли;
		КонецЕсли;
		
		ПроверитьПревышениеОбъема(ТекДанные,НовыйОбъем,НовыйПроцент);
		
		// Пересчет объема подчиненных позиций
		Если СМ_СметаВызовСервера.ЕстьПривязанныеПозиции(ТекДокумент) Тогда
			
			ОбщийОбъемРаботПоПозиции 	= СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ТекДокумент, "ОбъемРабот");
			СтарыйОбъем 				= ОбщийОбъемРаботПоПозиции * СтарыйПроцент / 100;
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("Позиция",ТекДокумент); 			
			ДопПараметры.Вставить("НовыйОбъем",НовыйОбъем);
			ДопПараметры.Вставить("СтарыйОбъем",СтарыйОбъем);
			
			Режим 		= РежимДиалогаВопрос.ДаНет;
			Оповещение 	= Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбъем", ЭтаФорма, ДопПараметры);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Изменять пропорционально объем привязанных позиций?';"+ " en = 'Do you want to continue?'"), Режим, 0);
		Иначе
			ПослеЗакрытияВопросаОбъем(КодВозвратаДиалога.Нет, ДопПараметры);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоЛСОбъемПоАктуПроцентПриИзменении(Элемент)

	НовыйПроцент 			= Элементы.ДеревоЛС.ТекущиеДанные.ОбъемПоАктуПроцент;
	ТекДанные				= Элементы.ДеревоЛС.ТекущиеДанные;
	ТекДокумент 			= ТекДанные.Элемент;
	НовыйОбъем				= ТекДанные.Кол * НовыйПроцент / 100;
	СтарыйОбъем				= ТекДанные.ОбъемПоАкту;
	
	ПроверитьПревышениеОбъема(ТекДанные,НовыйОбъем,НовыйПроцент,Истина);
	
	// Пересчет объема подчиненных позиций
	Если СМ_СметаВызовСервера.ЕстьПривязанныеПозиции(ТекДокумент) Тогда
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Позиция",ТекДокумент); 			
		ДопПараметры.Вставить("НовыйОбъем",НовыйОбъем);
		ДопПараметры.Вставить("СтарыйОбъем",СтарыйОбъем);
		
		Режим 		= РежимДиалогаВопрос.ДаНет;
		Оповещение 	= Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбъем", ЭтаФорма, ДопПараметры);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Изменять пропорционально объем привязанных позиций?';"+ " en = 'Do you want to continue?'"), Режим, 0);
	Иначе
		ПослеЗакрытияВопросаОбъем(КодВозвратаДиалога.Нет, ДопПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПревышениеОбъема(ТекДанные,НовыйОбъем,НовыйПроцент,ИзменилиПроцент = Ложь)
	
	РазрешитьРедактирование = СМ_СметаВызовСервера.ЗначениеОпции("СМ_РазрешитьРедактированиеЗакрытыхСмет");
	Если СМ_СметаВызовСервера.ЗначениеОпции("СМ_ПодтверждатьПревышениеОбъемаАкта") Тогда
		Если ИзменилиПроцент Тогда
			ОбъемВсегоБезАкта = ТекДанные.ОбъемВсего - ТекДанные.ОбъемПоАкту;
			Если НовыйОбъем > (ТекДанные.Кол-ОбъемВсегоБезАкта) И ТекДанные.Кол >=0 Тогда
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("ВладелецФайла",  Объект.Ссылка);
				ПараметрыФормы.Вставить("ТолькоПросмотр", Ложь);
				ПараметрыФормы.Вставить("РежимВыбора", Истина);
				
				ПараметрыОповещения = Новый Структура;
				ПараметрыОповещения.Вставить("ТекДанные",  ТекДанные);
				ПараметрыОповещения.Вставить("НовыйОбъем", НовыйОбъем);
				ПараметрыОповещения.Вставить("НовыйПроцент", НовыйПроцент);
				ПараметрыОповещения.Вставить("ИзменилиПроцент", ИзменилиПроцент);
				
				Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеВыбораФайла", ЭтотОбъект, ПараметрыОповещения);
				ОткрытьФорму("Документ.СМ_АктВыполненныхРабот.Форма.ПрисоединенныеФайлы",ПараметрыФормы,ЭтаФорма,Ложь,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			Иначе
				НовыйОбъемВсего = ТекДанные.ОбъемВсего - ТекДанные.ОбъемПоАкту + НовыйОбъем;
				Если ТекДанные.Кол = 0 Тогда
					НовыйПроцентВсего = 100;
				Иначе
					НовыйПроцентВсего = НовыйОбъемВсего / ТекДанные.Кол *100;  
				КонецЕсли;
				ТекДанные.ОбъемВсегоПроцент = НовыйПроцентВсего;
				ТекДанные.ОбъемВсего 		= НовыйОбъемВсего;
				ТекДанные.ОбъемПоАкту 		= НовыйОбъем;
				ОчиститьФайлТЧПозиции(ТекДанные.Элемент);
				ОбновитьИтогиПоАкту(НовыйОбъем);
				Если ТекДанные.ОбъемВсего>=ТекДанные.Кол Тогда
					ТекДанные.СтатусРедактирования = 2;
				Иначе
					ТекДанные.СтатусРедактирования = ?(РазрешитьРедактирование,1,2);
				КонецЕсли;
			КонецЕсли;
		Иначе
			СтарыйОбъемПоАкту = ТекДанные.Кол * ТекДанные.ОбъемПоАктуПроцент /100;
			ОбъемВсегоБезАкта = ТекДанные.ОбъемВсего - СтарыйОбъемПоакту;
			Если НовыйОбъем > (ТекДанные.Кол-ОбъемВсегоБезАкта) И ТекДанные.Кол >= 0 Тогда
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("ВладелецФайла",  Объект.Ссылка);
				ПараметрыФормы.Вставить("ТолькоПросмотр", Ложь);
				ПараметрыФормы.Вставить("РежимВыбора", Истина);
				
				ПараметрыОповещения = Новый Структура;
				ПараметрыОповещения.Вставить("ТекДанные",  ТекДанные);
				ПараметрыОповещения.Вставить("НовыйОбъем", НовыйОбъем);
				ПараметрыОповещения.Вставить("НовыйПроцент", НовыйПроцент);
				ПараметрыОповещения.Вставить("ИзменилиПроцент", ИзменилиПроцент);
				
				Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеВыбораФайла", ЭтотОбъект, ПараметрыОповещения);
				ОткрытьФорму("Документ.СМ_АктВыполненныхРабот.Форма.ПрисоединенныеФайлы",ПараметрыФормы,ЭтаФорма,Ложь,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			Иначе
				НовыйОбъемВсего = ТекДанные.ОбъемВсего - СтарыйОбъемПоакту + НовыйОбъем;
				Если ТекДанные.Кол = 0 Тогда
					НовыйОбъемВсегоПроцент = 0;
				Иначе	
					НовыйОбъемВсегоПроцент = НовыйОбъемВсего / ТекДанные.Кол * 100;
				КонецЕсли;	
				ТекДанные.ОбъемВсегоПроцент 	= НовыйОбъемВсегоПроцент;
				ТекДанные.ОбъемВсего 			= НовыйОбъемВсего;
				ТекДанные.ОбъемПоАкту 			= НовыйОбъем;
				ТекДанные.ОбъемПоАктуПроцент 	= НовыйОбъем / ТекДанные.Кол * 100;
				ОчиститьФайлТЧПозиции(ТекДанные.Элемент);
				ОбновитьИтогиПоАкту(НовыйОбъем);
				
				ТекДанные 	= Элементы.ДеревоЛС.ТекущиеДанные;
				ТекДокумент = ТекДанные.Элемент;
			//	НовыйОбъем 	= ТекДанные.Кол;
				Если ТекДанные.ОбъемВсего >= ТекДанные.Кол Тогда
					ТекДанные.СтатусРедактирования = 2;
				Иначе
					ТекДанные.СтатусРедактирования = ?(РазрешитьРедактирование,1,2);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если ИзменилиПроцент Тогда
			НовыйОбъемВсего = ТекДанные.ОбъемВсего - ТекДанные.ОбъемПоАкту + НовыйОбъем;
			Если ТекДанные.Кол = 0 Тогда
				НовыйПроцентВсего = 100;
			Иначе
				НовыйПроцентВсего = НовыйОбъемВсего / ТекДанные.Кол *100;  
			КонецЕсли;
			ТекДанные.ОбъемВсегоПроцент = НовыйПроцентВсего;
			ТекДанные.ОбъемВсего 		= НовыйОбъемВсего;
			ТекДанные.ОбъемПоАкту 		= НовыйОбъем;
			ОбновитьИтогиПоАкту(НовыйОбъем);
		Иначе
			СтарыйОбъемПоакту 	= ТекДанные.Кол * ТекДанные.ОбъемПоАктуПроцент /100;
			НовыйОбъемВсего 	= ТекДанные.ОбъемВсего - СтарыйОбъемПоакту + НовыйОбъем;
			Если ТекДанные.Кол = 0 Тогда
				НовыйОбъемВсегоПроцент = 0;
			Иначе	
				НовыйОбъемВсегоПроцент = НовыйОбъемВсего / ТекДанные.Кол * 100;
			КонецЕсли;	
			ТекДанные.ОбъемВсегоПроцент 	= НовыйОбъемВсегоПроцент;
			ТекДанные.ОбъемВсего 			= НовыйОбъемВсего;
			ТекДанные.ОбъемПоАкту 			= НовыйОбъем;
			ТекДанные.ОбъемПоАктуПроцент 	= НовыйОбъем / ТекДанные.Кол * 100;
			ОбновитьИтогиПоАкту(НовыйОбъем);
			ТекДанные 	= Элементы.ДеревоЛС.ТекущиеДанные;
			ТекДокумент = ТекДанные.Элемент;
		//	НовыйОбъем 	= ТекДанные.Кол;	
		КонецЕсли;
		
		Если ТекДанные.ОбъемВсего >= ТекДанные.Кол Тогда
			ТекДанные.СтатусРедактирования = 2;
		Иначе
			ТекДанные.СтатусРедактирования = ?(РазрешитьРедактирование,1,2);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбъем(Результат, ДопПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Нет Тогда
		ВыполнитьПересчетПривязанныхПозицийВАкте(ДопПараметры);	
		ОбновитьДеревоНаСервере("Обновить");
	КонецЕсли;
	
КонецПроцедуры

// Пересчет привязанных позиций при изменении объема основной позиции. 
//
// Параметры:
//     ПозицияВладелец - ДокументСсылка - ссылка на документ СМ_ПозицияЛокальнойСметы.
//     НовыйОбъем      - новый объем работ по позиции.
//     СтарыйОбъем     - объем работ до изменения 	по позиции.
//
&НаСервере
Процедура ВыполнитьПересчетПривязанныхПозицийВАкте(ДопПараметры)
	
	ПозицияВладелец = ДопПараметры.Позиция;
	НовыйОбъем		= ДопПараметры.НовыйОбъем;
	СтарыйОбъем		= ДопПараметры.СтарыйОбъем;
	
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "ВЫБРАТЬ
	             	  |	СМ_АктВыполненныхРаботПозиции.Ссылка КАК Ссылка,
	             	  |	СМ_АктВыполненныхРаботПозиции.Позиция КАК Позиция,
	             	  |	СМ_АктВыполненныхРаботПозиции.ФактОбъем КАК ФактОбъем,
	             	  |	СМ_АктВыполненныхРаботПозиции.ФактРасход КАК ФактРасход,
	             	  |	СМ_АктВыполненныхРаботПозиции.НормРасход КАК НормРасход,
	             	  |	СМ_АктВыполненныхРаботПозиции.ФормулаОбъема КАК ФормулаОбъема,
	             	  |	СМ_АктВыполненныхРаботПозиции.Позиция.ИДПозицииВладельца КАК ПозицияИДПозицииВладельца,
	             	  |	СМ_АктВыполненныхРаботПозиции.Позиция.НормаРасходаРесурса КАК НормаРасходаРесурса
	             	  |ИЗ
	             	  |	Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_АктВыполненныхРаботПозиции
	             	  |ГДЕ
	             	  |	СМ_АктВыполненныхРаботПозиции.Ссылка = &Акт
	             	  |	И СМ_АктВыполненныхРаботПозиции.Позиция.ИДПозицииВладельца = &ИДПозицииВладельца";	
		
	Запрос.УстановитьПараметр("ИДПозицииВладельца",ПозицияВладелец);
	Запрос.УстановитьПараметр("Акт",Объект.Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();  
	Пока Выборка.Следующий() Цикл
		
		СтарыйОбъемПозиции	= Выборка.ФактОбъем;
		СтарыйФактРасход    = Выборка.НормРасход;
		СтарыйНормРасход	= Выборка.ФактРасход;
		ТекФормула			= Выборка.ФормулаОбъема;
		
		Если СтарыйОбъем = 0 Тогда
			НовыйОбъемПозиции = Выборка.НормаРасходаРесурса * НовыйОбъем;
		Иначе
			НовыйОбъемПозиции = НовыйОбъем / СтарыйОбъем * СтарыйОбъемПозиции;
		КонецЕсли;
		
		ОбновитьТЧПозицииРесурсы(Выборка.Позиция,НовыйОбъемПозиции);
		
	//	СтруктураОтбора = Новый Структура;
	//	СтруктураОтбора.Вставить("Позиция",Выборка.Позиция);
	//	НайденныеСтроки = Объект.Позиции.НайтиСтроки(СтруктураОтбора);
	//	СтрокаПозиции 	= НайденныеСтроки[0];	
	//		
	//	НоваяФормула = "";
	//	Если ЗначениеЗаполнено(ТекФормула) Тогда 
	//		ТекФормула 	= СтрЗаменить(ТекФормула,",",".");
	//		НайденОбъем = СтрНайти(ТекФормула,СтарыйОбъемПозиции);
	//		Если НайденОбъем > 0 Тогда
	//			НоваяФормула = СтрЗаменить(ТекФормула,СтарыйОбъемПозиции,НовыйОбъемПозиции);	
	//		Иначе	
	//			НоваяФормула = "="+НовыйОбъемПозиции; 		
	//		КонецЕсли;
	//	КонецЕсли;
	//	
	//	СтрокаПозиции.ФактОбъем   	= НовыйОбъемПозиции;
	//	СтрокаПозиции.ФормулаОбъема = НоваяФормула;
	//
	//	Если СтрокаПозиции.ФактРасход = 0 Тогда
	//		СтрокаПозиции.НормРасход  = 0;
	//	Иначе
	//		СтрокаПозиции.НормРасход  = НовыйОбъемПозиции / СтрокаПозиции.ФактРасход;
	//	КонецЕсли;
	//	
	//	Если СтарыйФактРасход = СтарыйНормРасход Тогда 
	//		СтрокаПозиции.ФактРасход = СтрокаПозиции.НормРасход;
	//	КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораФайла(Результат, ДопПараметры) Экспорт
	
	ТекДанные 				= ДопПараметры.ТекДанные;
	НовыйОбъем 				= ДопПараметры.НовыйОбъем;
	НовыйПроцент 			= ДопПараметры.НовыйПроцент;
	ИзменилиПроцент 		= ДопПараметры.ИзменилиПроцент;
	РазрешитьРедактирование = СМ_СметаВызовСервера.ЗначениеОпции("СМ_РазрешитьРедактированиеЗакрытыхСмет");
	
	Если Не Результат = Неопределено Тогда
		
		Если ИзменилиПроцент Тогда
			НовыйОбъемВсего = ТекДанные.ОбъемВсего - ТекДанные.ОбъемПоАкту + НовыйОбъем;
			Если ТекДанные.Кол = 0 Тогда
				НовыйПроцентВсего = 100;
			Иначе
				НовыйПроцентВсего = НовыйОбъемВсего / ТекДанные.Кол *100;  
			КонецЕсли;
			ТекДанные.ОбъемВсегоПроцент = НовыйПроцентВсего;
			ТекДанные.ОбъемВсего = НовыйОбъемВсего;
			
			ТекДанные.ОбъемПоАкту 	= НовыйОбъем;
			
			ОбновитьИтогиПоАкту(НовыйОбъем);
		Иначе
			СтарыйОбъемПоакту = ТекДанные.Кол * ТекДанные.ОбъемПоАктуПроцент /100;
			
			НовыйОбъемВсего = ТекДанные.ОбъемВсего - СтарыйОбъемПоакту + НовыйОбъем;
			Если ТекДанные.Кол = 0 Тогда
				НовыйОбъемВсегоПроцент = 0;
			Иначе	
				НовыйОбъемВсегоПроцент = НовыйОбъемВсего / ТекДанные.Кол * 100;
			КонецЕсли;	
			ТекДанные.ОбъемВсегоПроцент = НовыйОбъемВсегоПроцент;
			ТекДанные.ОбъемВсего = НовыйОбъемВсего;
			ТекДанные.ОбъемПоАкту 	= НовыйОбъем;
			ТекДанные.ОбъемПоАктуПроцент = ?(ТекДанные.Кол = 0,0,НовыйОбъем / ТекДанные.Кол * 100);
			ОбновитьИтогиПоАкту(НовыйОбъем);
			
			ТекДанные 	= Элементы.ДеревоЛС.ТекущиеДанные;
			ТекДокумент = ТекДанные.Элемент;
			НовыйОбъем 	= ТекДанные.Кол;	
		КонецЕсли;
		
		Если ТекДанные.ОбъемВсего>=ТекДанные.Кол Тогда
			ТекДанные.СтатусРедактирования = 2;
		Иначе
			ТекДанные.СтатусРедактирования = ?(РазрешитьРедактирование,1,2);
		КонецЕсли;

		ТекДанные.ЕстьФайл = Истина;
		ЗаполнитьФайлТЧПозиции(ДопПараметры.ТекДанные.Элемент,Результат);
	Иначе
		Если ИзменилиПроцент Тогда 
			ТекДанные.ОбъемПоАктуПроцент 	= ?(ТекДанные.Кол = 0,100,ТекДанные.ОбъемПоАкту/ТекДанные.Кол * 100);
		Иначе
			ТекДанные.ОбъемПоАкту 	= ТекДанные.Кол * ТекДанные.ОбъемПоАктуПроцент /100;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФайлТЧПозиции(ТекПозиция,СтруктураДанных)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Позиция",ТекПозиция);
	
	МассивСтрок = Объект.Позиции.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() > 0 Тогда
		НоваяСтрока = МассивСтрок[0];	
		
		НоваяСтрока.СсылкаНаФайл = СтруктураДанных.Файл;
		НоваяСтрока.КомментарийКФайлу = СтруктураДанных.Комментарий;
		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОчиститьФайлТЧПозиции(ТекПозиция)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Позиция",ТекПозиция);
	
	МассивСтрок = Объект.Позиции.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() > 0 Тогда
		НоваяСтрока = МассивСтрок[0];	
		
		НоваяСтрока.СсылкаНаФайл = Справочники.СМ_АктВыполненныхРаботПрисоединенныеФайлы.ПустаяСсылка();
		НоваяСтрока.КомментарийКФайлу = "";
		
	КонецЕсли;
КонецПроцедуры

