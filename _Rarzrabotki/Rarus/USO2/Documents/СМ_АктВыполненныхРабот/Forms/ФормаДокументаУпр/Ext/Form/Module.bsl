	Если ТипЗнч(ТекДокумент) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		ПоказатьПредупреждение(,НСтр("ru='Редактирование ресурсов возможно только для позиции локальной сметы!'"));
	Иначе
		СтруктураПараметров = ПолучитьСтруктуруПараметров(ТекДокумент);
		ОписаниеОповещения 	= Новый ОписаниеОповещения("ПолучитьРасходРесурсов",ЭтаФорма,ТекДокумент);
		ОткрытьФорму("Документ.СМ_АктВыполненныхРабот.Форма.РедакторРасходаРесурсовУпр", СтруктураПараметров,,,,,ОписаниеОповещения);	
	КонецЕсли;
	
