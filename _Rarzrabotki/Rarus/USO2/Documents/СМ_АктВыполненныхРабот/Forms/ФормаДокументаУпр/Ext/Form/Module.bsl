
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Отказ = СМ_ЗащитаКлиент.ЗапускОбъекта();
	Если Не Отказ Тогда
		
		ПолучитьВариантПоУмолчанию();
		НастройкаОтображенияДерева = 1;
		ВидимостьОкруглятьДоРублей();
		ВидимостьДоступностьЭлементовНаФорме();
		ОбновитьВидимостьНаВкладкеНастройкаПечати();
		ВидимостьМобильнойКнопки();
	    ВидимостьИндексов();
		Элементы.ПоказатьИндексы.Пометка = Ложь;
		ВидимостьГруппаИндексы();
		ОтмеченаВДереве = 1;
	КонецЕсли;
	КлючВариантаСостава = 1;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Неопределено;
	Действие = "Обновить";
	
	// Заполнение по локальной смете
	Если Объект.Ссылка.Пустая() Тогда
		Если ЭтаФорма.Параметры.Свойство("ЛокальнаяСмета") Тогда
			// Заполнение реквизитов и ТЧ акта по смете
			ТекОбъект = РеквизитФормыВЗначение("Объект");
			СМ_СметаВызовСервера.ЗаполнитьАктПоСмете(ЭтаФорма.Параметры,ТекОбъект); 
			ЗначениеВРеквизитФормы(ТекОбъект,"Объект");
			
			// Заполнение структуры параметров вывода дерева акта, по параметрам формы
			СтруктураПараметров 			= СМ_СметаВызовСервера.ЗаполнитьСтруктуруПараметровСозданияАкта(ЭтаФорма.Параметры);
			СтруктураПараметровРасчетаЛС 	= СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(Параметры.ЛокальнаяСмета);
			Если СтруктураПараметров.ЗаполнитьПоОстаткам Тогда
				Действие = "ЗаполнитьПоОстаткам";			
			ИначеЕсли СтруктураПараметров.Процентовать Тогда
				Действие = "Процентовать";	
			КонецЕсли;
			
			Если Параметры.ЛокальнаяСмета.Статус = Перечисления.СМ_СтатусыСметныхДокументов.Архив Тогда
				Объект.Статус = Перечисления.СМ_СтатусыСметныхДокументов.Архив;
			КонецЕсли;
			
		КонецЕсли;
		
		// Заполнение значений по умолчанию
		Объект.Дата		= ТекущаяДатаСеанса();
		Объект.ПериодОт = НачалоМесяца(ТекущаяДатаСеанса());
		Объект.ПериодДо = КонецМесяца(ТекущаяДатаСеанса()); 
		
	Иначе
		СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(Объект.ЛокальнаяСмета);
	КонецЕсли;	
	
	ВводОбъемовВБазовыхЕдИзм = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ВводОбъемовВБазовыхЕдИзм");
	
	ТолькоПросмотрФормы = СМ_СметаВызовСервера.РольТолькоПросмотр();
	Архив = (Объект.Статус = Перечисления.СМ_СтатусыСметныхДокументов.Архив);
	Админ = Пользователи.РолиДоступны("СМ_АдминистраторСмета, ПолныеПрава",,Ложь);
	ТолькоПросмотрФормы = ?(Архив,Архив,ТолькоПросмотрФормы);
	// Вывод дерева акта
	
	ВыводитьДопРеквизиты = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","СМ_ВыводитьДополнительныеРеквизитыДерево");
	ВыводитьДопРеквизиты = ?(ВыводитьДопРеквизиты = Неопределено,Ложь,ВыводитьДопРеквизиты);
	Если ВыводитьДопРеквизиты Тогда
		СписокРеквизитов = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","СМ_СписокДопРеквизитовДерева");
		Если СписокРеквизитов.Количество() > 0 Тогда
			ДобавляемыеРеквизиты = Новый Массив;
			Для Каждого доп Из СписокРеквизитов Цикл
				GUID = СМ_ВерсионированиеСервер.ПолучитьGUIDПоУИД(доп.Значение.УникальныйИдентификатор());
				НовРеквизит = Новый РеквизитФормы("ДопРеквизит_"+GUID,доп.Значение.ТипЗначения,"ДеревоЛС", доп.Значение.Заголовок);
				ДобавляемыеРеквизиты.Добавить(НовРеквизит);
			КонецЦикла;
			ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
			
			Для Каждого доп Из СписокРеквизитов Цикл
				GUID = СМ_ВерсионированиеСервер.ПолучитьGUIDПоУИД(доп.Значение.УникальныйИдентификатор());
				НовыйЭлемент = Элементы.Добавить("ДопРеквизит_"+GUID, Тип("ПолеФормы"), Элементы.ДеревоЛСГруппаДопРеквизиты);
				НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
				НовыйЭлемент.ПутьКДанным = "ДеревоЛС.ДопРеквизит_"+GUID;
				НовыйЭлемент.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
				НовыйЭлемент.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
				НовыйЭлемент.УстановитьДействие("ПриИзменении", "ВыполнитьДействиеПриИзмененииДопРеквизита");
				НовыйЭлемент.УстановитьДействие("НачалоВыбора", "ВыполнитьДействиеНачалоВыбораДопРеквизита");
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	ОбновитьДеревоНаСервере(Действие,СтруктураПараметров,,Не Объект.Ссылка.Пустая());
	ОбновитьПодменюПечати();
	СтруктураРасчета = Новый Структура;
	СтруктураРасчета.Вставить("ЭтоБазисноИндексныйУровеньРасценка", (Объект.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный) И (Объект.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка));
	СтруктураРасчета.Вставить("ЭтоБазисноИндексныйУровеньРаздел", (Объект.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный) И (Объект.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел));
	СтруктураРасчета.Вставить("ЭтоБазисноИндексныйУровеньСмета", (Объект.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный) И (Объект.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета));
	СтруктураРасчета.Вставить("ЭтоРесурсныйМетод", Объект.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный);
	СтруктураРасчета.Вставить("ЭтоРасчетПоЭлементамЗатрат", Объект.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат);
	
	Элементы.ТекстКоэффициентов.Заголовок = "";
	
	Если ПолучитьФункциональнуюОпцию("СМ_WS_ИспользоватьИнтеграцию") Тогда
		ДополнитьСводныеРесурсыОстатками();
	КонецЕсли;
	
	Если Не Пользователи.РолиДоступны("СМ_АдминистраторСмета, ПолныеПрава") Тогда
		Элементы.ФормаПоказатьРасчеты.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеНачалоВыбораДопРеквизита(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекДанные 	= Элементы.ДеревоЛС.ТекущиеДанные;
	GUID = СтрЗаменить(Элемент.Имя,"ДопРеквизит_","");
    ВладелецСвойства = ПолучитьСвойство(GUID);
	Если ТипЗнч(ТекДанные[Элемент.Имя]) = Тип("СправочникСсылка.ЗначенияСвойствОбъектов") Тогда
		СтандартнаяОбработка = Ложь;
		СтрОтбор = Новый Структура("Владелец",ВладелецСвойства);
		ОткрытьФорму("Справочник.ЗначенияСвойствОбъектов.Форма.ФормаСписка",Новый Структура("Отбор,РежимВыбора",СтрОтбор,Истина),Элемент)
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьСвойство(GUID) 
    УИН = СМ_ВерсионированиеСервер.ПолучитьУИДПоGUID(GUID);
	Возврат ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПолучитьСсылку(Новый УникальныйИдентификатор(УИН));
КонецФункции

&НаКлиенте
Процедура ВыполнитьДействиеПриИзмененииДопРеквизита(Элемент)
	ТекДанные 	= Элементы.ДеревоЛС.ТекущиеДанные;
	ТекДокумент = ТекДанные.Элемент;
	GUID = СтрЗаменить(Элемент.Имя,"ДопРеквизит_","");
	ЗначениеРеквизита = ТекДанные[Элемент.Имя];
    ВыполнитьДействиеПриИзмененииДопРеквизитаНаСервере(ТекДокумент,GUID,ЗначениеРеквизита);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьДействиеПриИзмененииДопРеквизитаНаСервере(ТекДокумент,GUID,ЗначениеРеквизита)
    УИН = СМ_ВерсионированиеСервер.ПолучитьУИДПоGUID(GUID);
	ДопРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПолучитьСсылку(Новый УникальныйИдентификатор(УИН));
	УстановитьДополнительныйРеквизитОбъекта(ТекДокумент, ДопРеквизит,ЗначениеРеквизита);
КонецПроцедуры

&НаСервере
Процедура УстановитьДополнительныйРеквизитОбъекта(ДокументСсылка, ПВХ_Ссылка, ЗначениеРеквизита)
     ТекДокумент = ДокументСсылка.ПолучитьОбъект();
     СтрДопРеквизиты = ТекДокумент.ДополнительныеРеквизиты.Найти(ПВХ_Ссылка, "Свойство");
     Если СтрДопРеквизиты = Неопределено Тогда
         СтрДопРеквизиты = ТекДокумент.ДополнительныеРеквизиты.Добавить();
     КонецЕсли;
     СтрДопРеквизиты.Свойство = ПВХ_Ссылка;
     СтрДопРеквизиты.Значение = ЗначениеРеквизита;
     ТекДокумент.ОбменДанными.Загрузка = Истина;
	 ТекДокумент.Записать()
 КонецПроцедуры
 
