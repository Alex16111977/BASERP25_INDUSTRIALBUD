&НаКлиенте
Процедура ЗаменаРесурсовПоПозиции(Команда)
	
	ТекДокумент = Элементы.РесурсыПозицийАкта.ТекущиеДанные.Позиция;
	Если ТекДокумент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Ресурсы",Объект.РесурсыПозицийАкта);
	СтруктураПараметров.Вставить("Позиция",ТекДокумент);
	СтруктураПараметров.Вставить("АктВыполненныхРабот",Объект.Ссылка);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолучитьРасходРесурсов",ЭтаФорма);
	ОткрытьФорму("Документ.СМ_АктВыполненныхРабот.Форма.РедакторРасходаРесурсовУпр", СтруктураПараметров,,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьРесурс(Команда)
	
	ТекДанные = Элементы.СводныеРесурсы.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Если ТекДанные.ЭтоНеучтенный ИЛИ ТекДанные.ЭтоОборудование Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Можно заменять только учтенные ресурсы, а не отдельные сметные позиции'"));
		Возврат;	
	КонецЕсли;
	
	ТекРесурс 		= ТекДанные.Ресурс;
	РасходПоНорме	= ТекДанные.РасходПоНорме;
	РасходПоФакту   = ТекДанные.РасходПоФакту;
	
	// Перезамена (замена уже замененного ресурса)
	Если ТекДанные.ЭтоЗамена Тогда
		Оповещение = Новый ОписаниеОповещения("ПерезаменаРесурсаПодтверждение", ЭтотОбъект,ТекРесурс);
		ТекстВопроса = "Текущая замена будет удалена. Продолжить?"; 
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет); 
	Иначе
		Структура 					= Новый Структура("ЗаменяемыйРесурс, Ресурс, РасходПоНорме, РасходПоФакту,БазисЦена,БазисЗарплМаш,ТекЦена,ТекЗарплМаш");
		Структура.ЗаменяемыйРесурс 	= ТекРесурс;
		Структура.РасходПоНорме 	= РасходПоНорме;
		Структура.РасходПоФакту 	= ТекДанные.РасходПоФакту;
		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("РегиональнаяБаза", СтруктураПараметровРасчетаЛС.РегионДляВыбораЦен);
		ПараметрыПоиска.Вставить("Район",СтруктураПараметровРасчетаЛС.Район);
		ПараметрыПоиска.Вставить("ДатаТекущихЦен",Объект.ДатаТекущихЦен);
		ПараметрыПоиска.Вставить("ТекРесурс",ТекРесурс);
		ПараметрыПоиска.Вставить("Проект",Объект.Стройка);
		ПараметрыПоиска.Вставить("Акт",Объект.Ссылка);
		
		Оповещение = Новый ОписаниеОповещения("ПолучитьЗаменуРесурса", ЭтотОбъект,Структура);
		ОткрытьФорму("Справочник.СМ_Ресурсы.Форма.ФормаВыбора",ПараметрыПоиска,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте 
Процедура ПерезаменаРесурсаПодтверждение(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = КодВозвратаДиалога.Да Тогда 
		ВыполнитьПерезаменуРесурса(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура УдалитьЗамену(Команда)
	
	ТекДанные = Элементы.СводныеРесурсы.ТекущиеДанные;
	
	// Удаление замены ресурса в регистре замен
	УдалитьЗаменуНаСервере(ТекДанные.Ресурс);
	ЗаполнитьТаблицуРесурсовАкта();	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзСметы(Команда)   
	ЗаполнитьИзСметыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЛимитыИзСметы(Команда)
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтаФорма, Параметры);
	ПоказатьВопрос(Оповещение, НСтр("ru='Табличная часть будет очищена.'")+Символы.ПС+НСтр("ru='Продолжить выполнение операции?'"), Режим, 0);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ЛокальнаяСмета) Тогда
		ЗаполнитьЛимитированныеЗатраты();
		Модифицированность = Истина;
