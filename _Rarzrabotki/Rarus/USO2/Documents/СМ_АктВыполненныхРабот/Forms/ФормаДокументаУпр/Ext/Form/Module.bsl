&НаСервере
Процедура ПолучитьЦеныНовогоРесурса(ТекРесурс,СтруктураЦен,СтруктураДопПараметров) 
	СписокПозиций = Новый СписокЗначений(); 
	СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(Объект.ЛокальнаяСмета);
	Район = СтруктураПараметровРасчетаЛС.Район;
	АвтоЗагрузкаЦен = СтруктураПараметровРасчетаЛС.АвтозагрузкаЦен;
	ДатаТекущихЦен = СтруктураПараметровРасчетаЛС.ДатаТекущихЦен;
	РегиональнаяБаза = СтруктураПараметровРасчетаЛС.РегионДляВыбораЦен;
	КодРегионаФайлаТекущихЦен = СтруктураПараметровРасчетаЛС.КодРегионаФайлаТекущихЦен;
	ФайлТекущихЦен = СтруктураПараметровРасчетаЛС.ФайлСборникаТекущихЦен;
	СтруктураДопПараметров.Вставить("АвтоЗагрузкаЦен",АвтоЗагрузкаЦен);
	СтруктураДопПараметров.Вставить("Район",Район);
	СтруктураДопПараметров.Вставить("ДатаТекущихЦен",ДатаТекущихЦен);
	СтруктураДопПараметров.Вставить("ФайлТекущихЦен",ФайлТекущихЦен);
	СтруктураДопПараметров.Вставить("КодРегионаФайлаТекущихЦен",КодРегионаФайлаТекущихЦен);
	
	// получим цены	
	ВыбиратьТекущиеЦены = ?(ФайлТекущихЦен = "", Истина, Ложь);			
	СМ_СметаВызовСервера.ПолучитьЦеныНовогоРесурса(ТекРесурс,Район,РегиональнаяБаза,ДатаТекущихЦен,СтруктураЦен,ВыбиратьТекущиеЦены);

КонецПроцедуры

&НаСервере
Процедура ЗаменитьРесурсыСервер(Структура)
	
	МассивПозиций = Новый Массив;
	Если Структура.Свойство("Позиция") Тогда
		Если ЗначениеЗаполнено(Структура.Позиция) Тогда
			МассивПозиций.Добавить(Структура.Позиция);	
		КонецЕсли;
	КонецЕсли;	
	
	// 1. Добавление дополнительных строк по замене ресурса.
	// Сначала нужно добавить дополнительные строки по замене ресурсов.
	// До изменения табличной части акта при замене по первому ресурсу.
	Модифицированность1 = Ложь;
	Если Структура.ДополнительныеЗамены.Количество() > 0 Тогда
		Для Каждого ТекСтруктура Из Структура.ДополнительныеЗамены Цикл
			Если МассивПозиций.Количество() > 0 Тогда
				Модифицированность1 = СМ_СметаВызовСервера.ЗаменитьРесурсВТЧРесурсыАкта(Объект,ТекСтруктура,МассивПозиций,Истина);	
			Иначе	
				Модифицированность1 = СМ_СметаВызовСервера.ЗаменитьРесурсВТЧРесурсыАкта(Объект,ТекСтруктура,,Истина); 
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// 2. Замена ресурса в строках табличной части ресурсов акта.
	Если МассивПозиций.Количество() > 0 Тогда
		Модифицированность2 = СМ_СметаВызовСервера.ЗаменитьРесурсВТЧРесурсыАкта(Объект,Структура,МассивПозиций); 	
	Иначе	
		Модифицированность2 = СМ_СметаВызовСервера.ЗаменитьРесурсВТЧРесурсыАкта(Объект,Структура); 
	КонецЕсли;
	
	Если Модифицированность1 ИЛИ Модифицированность2 Тогда
		ЭтаФорма.Модифицированность = Истина;
		ЗаполнитьТаблицуРесурсовАкта();	
	КонецЕсли;
	
	// 3. Восстановление текущей строки таблицы ресурсов на форме.
	ТекИндекс = НайтиНовыйРесурс(Структура.Ресурс);
	Элементы.СводныеРесурсы.ТекущаяСтрока = ТекИндекс;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьФактРасходРесурсовСервер(КодРесурса,НаименованиеРесурса,ТекущаяЦена,КоличествоНаОбъемАкт)
	
	РаспределениеПоНорме = Ложь;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("СметныйКодРесурса",КодРесурса);
	СтруктураОтбора.Вставить("НаименованиеРесурса",НаименованиеРесурса);
	СтруктураОтбора.Вставить("ТекущаяЦена",ТекущаяЦена);
	
	МассивСтрок = Объект.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() > 0 Тогда
		
		// Получаем суммарный старый факт расход
		СтарыйФактРасход 	= 0;
		СтараяНормаРасхода	= 0;
		Для Каждого ТекСтрока Из МассивСтрок Цикл
			СтарыйФактРасход 	= СтарыйФактРасход + ТекСтрока.ФактРасходаОбъем;
			СтараяНормаРасхода	= СтараяНормаРасхода + ТекСтрока.НормаРасходаОбъем;
		КонецЦикла;
		
		Если СтарыйФактРасход = 0 Тогда
			РаспределениеПоНорме = Истина;
			ТекКоэффициент = КоличествоНаОбъемАкт / СтараяНормаРасхода; 
		Иначе	
			ТекКоэффициент = КоличествоНаОбъемАкт / СтарыйФактРасход; 
		КонецЕсли;
		
		// Пересчет факт расхода
		Для Каждого ТекСтрока Из МассивСтрок Цикл
			Если РаспределениеПоНорме Тогда
				ТекСтрока.ФактРасходаОбъем = ТекСтрока.НормаРасходаОбъем * ТекКоэффициент;	
			Иначе
				ТекСтрока.ФактРасходаОбъем = ТекСтрока.ФактРасходаОбъем * ТекКоэффициент;		
			КонецЕсли;
		КонецЦикла;
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьОбъемНеучтенных(СтруктураПараметров)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СМ_АктВыполненныхРаботПозиции.Позиция,
	               |	СУММА(СМ_АктВыполненныхРаботПозиции.ФактОбъем) КАК ФактОбъем,
	               |	СУММА(СМ_АктВыполненныхРаботПозиции.ФактРасход) КАК ФактРасход
	               |ИЗ
	               |	Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_АктВыполненныхРаботПозиции
	               |ГДЕ
	               |	СМ_АктВыполненныхРаботПозиции.Ссылка = &Акт
	               |	И СМ_АктВыполненныхРаботПозиции.Позиция.ШифрРасценки = &ШифрРасценки
	               |	И СМ_АктВыполненныхРаботПозиции.Позиция.ТипНормативныхСборников = &ТипНормативныхСборников
	               |	И ВЫБОР
	               |			КОГДА СМ_АктВыполненныхРаботПозиции.Позиция.Определитель.ВидРасценки = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыРасценки.Материал)
	               |				ТОГДА СМ_АктВыполненныхРаботПозиции.Позиция.Оборудование
	               |			ИНАЧЕ СМ_АктВыполненныхРаботПозиции.Позиция.СтоимМатериалов
	               |		КОНЕЦ = &БазиснаяЦена
	               |	И СМ_АктВыполненныхРаботПозиции.ТекущаяЦена = &ТекущаяЦена
	               |	И СМ_АктВыполненныхРаботПозиции.Позиция.НеИзменятьЦены = &НеИзменятьЦены
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_АктВыполненныхРаботПозиции.Позиция";
	Запрос.УстановитьПараметр("Акт",Объект.Ссылка);
	Запрос.УстановитьПараметр("ШифрРасценки",СтруктураПараметров.Шифр);
	Запрос.УстановитьПараметр("ТипНормативныхСборников",СтруктураПараметров.ТипСборника);
	Запрос.УстановитьПараметр("БазиснаяЦена",СтруктураПараметров.БазиснаяЦена);
	Запрос.УстановитьПараметр("ТекущаяЦена",СтруктураПараметров.ТекущаяЦена);
	Запрос.УстановитьПараметр("НеИзменятьЦены",СтруктураПараметров.НеИзменятьЦены);
	
	ТабПозиций 			= Запрос.Выполнить().Выгрузить();
	СтарыйФактОбъем 	= ТабПозиций.Итог("ФактОбъем");
	СтарыйФактРасход 	= ТабПозиций.Итог("ФактРасход");
	МассивСтрок 		= ТабПозиций.ВыгрузитьКолонку("Позиция");
	
	//Если СтарыйФактОбъем = 0 Тогда
	//	Возврат;
	//КонецЕсли;
	
	Если СтарыйФактРасход = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если МассивСтрок.Количество() > 0 Тогда
		Для Каждого ТекСтрока Из МассивСтрок Цикл
			
			// 1. "Фактический объем" (или норм.расход) в табличной части "Позиции" - не изменяется, 
			// он изменяется только при именении колонки "факт объема" в дереве составе акта
			// "Фактический объем" при изменении в сводной табилце меняться не будет. 
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Позиция",ТекСтрока);
			СтрокаАкта = Объект.Позиции.НайтиСтроки(СтруктураОтбора);
			СтрокаАкта[0].ФактОбъем = (СтруктураПараметров.РасходПоФакту * СтрокаАкта[0].ФактОбъем) / СтарыйФактОбъем;
			
			// 2. Будет меняться "фактический расход" по формуле: 
			// Фактический расход = НовыйФактРасход * СтарыйФактРасход / ВсегоСтарыйФактРасход.
			Если ТекСтрока.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал ИЛИ 
				 ТекСтрока.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование Тогда
				СтрокаАкта[0].ФактРасход = (СтруктураПараметров.РасходПоФакту * СтрокаАкта[0].ФактРасход) / СтарыйФактРасход;
			КонецЕсли;
		
		КонецЦикла;
		
		ЭтаФорма.Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СводныеРесурсыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ТекСтрока = Элементы.СводныеРесурсы.ТекущиеДанные;
	
	Если ТекСтрока <> Неопределено Тогда
		
		ИмяКолонки = Элемент.ТекущийЭлемент.Имя;
	
		Если (ИмяКолонки = "СводныеРесурсыЦенаТекущая") ИЛИ (ИмяКолонки = "СводныеРесурсыЦенаТекущаяЗМ") Тогда
			
			ТекРесурс = Новый Структура();
			ТекРесурс.Вставить("Код",ТекСтрока.КодРесурса);
			ТекРесурс.Вставить("Вид",ТекСтрока.ВидРесурса);
			ТекРесурс.Вставить("Наименование",ТекСтрока.НаименованиеРесурса);
			ТекРесурс.Вставить("ЕдиницаИзмерения",ТекСтрока.ЕдиницаИзмеренияРесурса);
			ТекРесурс.Вставить("Ресурс",ТекСтрока.Ресурс);
			ТекРесурс.Вставить("БазиснаяЦена",ТекСтрока.ЦенаБазисная);
			ТекРесурс.Вставить("БазиснаяЗарплатаМашинистов",ТекСтрока.ЦенаЗМБазисная);
						
			ТекущаяЦена	= ТекСтрока.ЦенаТекущая;
			ТекущаяЗПМ 	= ТекСтрока.ЦенаТекущаяЗМ;
			
			ЭтоНеучтенный  	= ТекСтрока.ЭтоНеучтенный;
			ЭтоОборудование = ТекСтрока.ЭтоОборудование;
			ОбновитьПоказателиРесурсовВТЧСервер(ТекРесурс,ТекущаяЦена,ТекущаяЗПМ,ЭтоНеучтенный,ЭтоОборудование);
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоказателиРесурсовВТЧСервер(ТекРесурс,ТекущаяЦена,ТекущаяЗПМ,ЭтоНеучтенный,ЭтоОборудование)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	СМ_СметаВызовСервера.ОбновитьПоказателиРесурсовВТЧРесурсыАкта(ТекОбъект,ТекРесурс,ТекущаяЦена,ТекущаяЗПМ,ЭтоНеучтенный Или ЭтоОборудование);
	ЗначениеВРеквизитФормы(ТекОбъект,"Объект");
	
КонецПроцедуры

