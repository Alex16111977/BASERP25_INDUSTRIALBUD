&НаКлиенте
Процедура ЗаполнитьПоОстаткам(Команда)
	
	// Сохранение текущей строки дерева
	СтрокаДерева = Неопределено;
	СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(СтрокаДерева, Элементы.ДеревоЛС.ТекущиеДанные, Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы());
	
	// Обновление дерева
	ЗаполнитьПоОстаткамНаСервере();
	
	// Восстановление текущей строки дерева
	СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы(), ДеревоЛС, СтрокаДерева);
		
КонецПроцедуры

&НаКлиенте
Процедура НеХватаетМатериаловВКаталоге(Команда)
	Если Не ЗначениеЗаполнено(Объект.Ссылка)или ЭтаФорма.Модифицированность Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуЗаявкиНаМатериалыДиалог", ЭтаФорма, Новый Структура);
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru='Для создания заявки акт будет записан. Продолжить?'"), РежимДиалогаВопрос.ДаНет,0,,"Внимание");	
	Иначе
		ОткрытьФормуЗаявкиНаМатериалы();
	КонецЕсли;
КонецПроцедуры

// ДокторСофт

&НаКлиенте
Процедура ЗаполнитьПоОстаткамПозиций(Команда)
	
	Если Элементы.ДеревоЛС.ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	// Сохранение текущей строки дерева
	СтрокаДерева = Неопределено;
	СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(СтрокаДерева, Элементы.ДеревоЛС.ТекущиеДанные, Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы());
	ЗаполнитьПоОстаткамНаСервере(ВыделенныеПозицииВМассив());
	СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы(), ДеревоЛС, СтрокаДерева);
КонецПроцедуры

&НаКлиенте
Функция ВыделенныеПозицииВМассив()
	
	ВыделенныеСтроки = Элементы.ДеревоЛС.ВыделенныеСтроки;
	
	// Массив позиций для обновления
	МассивПозиций=Новый Массив;
	Для Каждого Стр Из ВыделенныеСтроки Цикл
		Если ТипЗнч(Стр) = Тип("Число") Тогда
			ДанныеСтроки = Элементы.ДеревоЛС.ДанныеСтроки(Стр);
			Если ТипЗнч(ДанныеСтроки.Элемент)=Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				МассивПозиций.Добавить(ДанныеСтроки.Элемент);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивПозиций;
	
КонецФункции

&НаКлиенте
Процедура Мобильное(Команда)
	Если Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Документ не записан в базе!'"),СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;
	СписокУзлов = ПолучитьУзлыПоУмолчанию();
	Если СписокУзлов = Неопределено Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораУзлов", ЭтаФорма);
		ОткрытьФорму("Обработка.СМ_ВыборУзловМП.Форма.Форма",,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли СписокУзлов.Количество() = 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораУзлов", ЭтаФорма);
		ОткрытьФорму("Обработка.СМ_ВыборУзловМП.Форма.Форма",,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		МобильноеНаСервере(СписокУзлов);
		ВидимостьМобильнойКнопки();
	КонецЕсли;		

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораУзлов(Результат, СтруктураПараметров) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МассивСтруктур = Новый Массив;
	МассивСтруктур.Добавить(ОписаниеНастройки(
	"НастройкиПользователяСмета",
	"ОсновнойУзелМП",
	Результат));
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранитьМассивИОбновитьПовторноИспользуемыеЗначения(МассивСтруктур);
	
	МобильноеНаСервере(Результат);
	ВидимостьМобильнойКнопки();

КонецПроцедуры

