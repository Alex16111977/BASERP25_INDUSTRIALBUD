// Процедура осуществляет обновление текущих цен после диалога пользователя
// ПАРАМЕТРЫ:
//	Результат - ответ пользователя на вопрос (продолжать или нет).
//	СтруктураПараметров - дополнительные параметры переданные при формировании вопроса пользователю.
//
&НаКлиенте
Процедура ОбновитьВсеДанныеПоСмете(Результат, СтруктураПараметров) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	Записать();
	// Сохранение текущей строки дерева
	СтрокаДерева = Неопределено;
	СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(СтрокаДерева, Элементы.ДеревоЛС.ТекущиеДанные, Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы());		
	
	// Обновление дерева
	Если Параметры.Свойство("ВыделенныеСтроки") И Параметры.ВыделенныеСтроки=Истина Тогда
		ОбновитьПоСметеНаСервере(ВыделенныеПозицииВМассив());
	Иначе
		ОбновитьПоСметеНаСервере();
	КонецЕсли;		
	// Восстановление текущей строки дерева
	СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы(), ДеревоЛС, СтрокаДерева);
	
	ЭтаФорма.Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьАктПоСмете(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьВсеДанныеПоСмете", ЭтаФорма, Новый Структура);
	ПоказатьВопрос(ОписаниеОповещения, НСтр("ru='Обновить все данные о структуре акта и ресурсах по смете (акт будет записан)?'"), РежимДиалогаВопрос.ДаНет,0,,"Внимание");	
	                                                                	
КонецПроцедуры

