&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Не ТекущийОбъект.Проведен Тогда
		Документы.СМ_АктВыполненныхРабот.Перерасчет(ТекущийОбъект, Ложь);
	КонецЕсли;
	
	СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(ТекущийОбъект.ЛокальнаяСмета);   		
	
	Если ПолучитьФункциональнуюОпцию("СМ_WS_ИспользоватьИнтеграцию") Тогда
		Документы.СМ_АктВыполненныхРабот.ДобавитьОстаткиПоАкту(Объект.Ссылка,Объект.Стройка);	
		ДополнитьСводныеРесурсыОстатками();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// Сохранение текущей строки дерева
	СтрокаДерева = Неопределено;
	ТекДанные = Элементы.ДеревоЛС.ТекущиеДанные;
	СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(СтрокаДерева, ТекДанные, Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы());

	Если ИмяСобытия = "ОбновитьДеревоСметы" Тогда
		ЭтаФорма.Прочитать();
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
	
			// Обновляем только нужную смету
			Если Объект.ЛокальнаяСмета = Параметр.Смета Тогда
				СписокДействий = Параметр.СписокДействий;
				Для Каждого ТекДействие Из СписокДействий Цикл
					Если ТекДействие = "ОбновитьДерево" Тогда
						ОбновитьДеревоНаСервере(,,,Не Объект.Ссылка.Пустая());
					ИначеЕсли ТекДействие = "ПеренумероватьДерево" Тогда
						ОбновитьДеревоНаСервере(,,,Не Объект.Ссылка.Пустая());
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "ОбновитьДерево" Тогда
		Если ТипЗнч(Параметр) = Тип("Структура")
			И Параметр.Свойство("АктВыполненныхРабот") Тогда
			Если Объект.Ссылка = Параметр.АктВыполненныхРабот Тогда
				ЭтаФорма.Прочитать();

				ОбновитьДеревоНаСервере(,,,Не Объект.Ссылка.Пустая());
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Восстановление текущей строки дерева
	Если СтрокаДерева <> Неопределено Тогда
		СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы(), ДеревоЛС, СтрокаДерева);
	КонецЕсли;


КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ВидимостьСостава();
	Оповестить("ОбновитьВыполнениеСмета");	
	
	Если ЗначениеЗаполнено(Объект.ЛокальнаяСмета) Тогда
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ЛокальнаяСмета",Объект.ЛокальнаяСмета);
		Оповестить("ОбновитьСостояние",СтруктураПараметров);
	КонецЕсли;

	СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(ТекСтрокаДерева, Элементы.ДеревоЛС.ТекущиеДанные, Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы());

	ОбновитьДеревоНаСервере(,,,Не Объект.Ссылка.Пустая());

	СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы(), ДеревоЛС, ТекСтрокаДерева);
	Элементы.Состав.Доступность = ЗначениеЗаполнено(Объект.Ссылка);
	
КонецПроцедуры

