&НаСервере
Процедура ДополнитьСводныеРесурсыОстатками()
	
	
	
	ОстаткиРесурсов=Документы.СМ_АктВыполненныхРабот.ПолучитьОстаткиРесурсов(Объект.Ссылка);
	Для Каждого Эл Из СводныеРесурсы Цикл
		Мас=ОстаткиРесурсов.НайтиСтроки(Новый Структура("Ресурс",Эл.Ресурс));
		Если Мас.Количество()>0 Тогда
			Эл.WS_Остаток=Мас[0].Остаток;
			Эл.WS_Код=Мас[0].Код;
			Эл.WS_Наименование=Мас[0].Наименование;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьОстаткиНаСервере()
	Документы.СМ_АктВыполненныхРабот.ЗаполнитьОстаткиПоАкту(Объект.Ссылка,Объект.Стройка);
	ДополнитьСводныеРесурсыОстатками();
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьОстатки(Команда)
