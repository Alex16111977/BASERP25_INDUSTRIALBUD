&НаКлиенте
Функция ОчиститьФормулу(ТекФормула)
	
	ТекФормула = СтрЗаменить(ТекФормула,",",".");
	НоваяФормула = "";
	СтрокаСимв = "1234567890+-*/().";	
	Для сч = 1 По СтрДлина(ТекФормула) Цикл
		ТекСимв = Сред(ТекФормула,Сч,1);
		Если Найти(СтрокаСимв,ТекСимв) <> 0 Тогда
			НоваяФормула = НоваяФормула + ТекСимв;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат (НоваяФормула);
	
КонецФункции

