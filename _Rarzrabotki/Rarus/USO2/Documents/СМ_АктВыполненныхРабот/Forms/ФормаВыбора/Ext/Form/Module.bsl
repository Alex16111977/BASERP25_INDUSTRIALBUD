
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЭтаФорма.Параметры.Свойство("ЛокальнаяСмета") Тогда
		Если ЗначениеЗаполнено(Параметры.ЛокальнаяСмета) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,"ЛокальнаяСмета",Параметры.ЛокальнаяСмета,ВидСравненияКомпоновкиДанных.Равно,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтаФорма.Параметры.Свойство("Стройка") Тогда
		Если ЗначениеЗаполнено(Параметры.Стройка) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,"Стройка",Параметры.Стройка,ВидСравненияКомпоновкиДанных.Равно,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		КонецЕсли;
	ИначеЕсли ЭтаФорма.Параметры.Свойство("Акт") Тогда
		Если ЗначениеЗаполнено(Параметры.Акт.Стройка) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,"Стройка",Параметры.Акт.Стройка,ВидСравненияКомпоновкиДанных.Равно,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		КонецЕсли;
	КонецЕсли;		
	
	Если ЭтаФорма.Параметры.Свойство("ДатаОтбора") Тогда
		Если ЗначениеЗаполнено(Параметры.ДатаОтбора) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,"Дата",Параметры.ДатаОтбора,ВидСравненияКомпоновкиДанных.БольшеИлиРавно,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	    КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаСервере
Процедура СписокПередЗагрузкойПользовательскихНастроекНаСервере(Элемент, Настройки)
	
	ЭлементыОтбораДС = ЭтаФорма.Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы;
	
	// Удаление пользовательских отборов при пересечении с переданными отборами
	МассивУдаляемыхЭлементов 	= Новый Массив;
	ЭлементыНастройкиОтбораКД 	= Настройки.Элементы;
	Если ЭлементыНастройкиОтбораКД.Количество() > 0 Тогда
		Для Каждого ТекЭлемент ИЗ ЭлементыНастройкиОтбораКД Цикл
			
			Если ТипЗнч(ТекЭлемент) <> Тип("ЭлементОтбораКомпоновкиДанных") Тогда
				Продолжить;
			КонецЕсли;
			
			НазваниеЭлемента = Строка(ТекЭлемент.ЛевоеЗначение);
			Если НЕ ЗначениеЗаполнено(НазваниеЭлемента) Тогда
				Продолжить;	
			КонецЕсли;
			
			НайденныйЭлемент = ЭлементыОтбораДС.Найти(НазваниеЭлемента);
			Если НайденныйЭлемент <> Неопределено Тогда
				МассивУдаляемыхЭлементов.Добавить(ТекЭлемент);		
			КонецЕсли;
			
			Если Параметры.Отбор.Свойство(НазваниеЭлемента) Тогда
				МассивУдаляемыхЭлементов.Добавить(ТекЭлемент);	 		
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ТекЭлемент Из МассивУдаляемыхЭлементов Цикл
		ЭлементыНастройкиОтбораКД.Удалить(ТекЭлемент);	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти



