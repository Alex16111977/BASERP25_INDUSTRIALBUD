Процедура ПроверитьЗаполнениеТМЦВЭксплуатации(НепроверяемыеРеквизиты, Отказ)
	
	Если ТипОперации <> Перечисления.ТипыОперацийВводаОстатков.ОстаткиТМЦВЭксплуатации Тогда
		Возврат;
	КонецЕсли;
	
	НепроверяемыеРеквизиты.Добавить("ТМЦВЭксплуатации.ИнвентарныйНомер");
	НепроверяемыеРеквизиты.Добавить("ТМЦВЭксплуатации.Сумма");
	НепроверяемыеРеквизиты.Добавить("ТМЦВЭксплуатации.СуммаПР");
	НепроверяемыеРеквизиты.Добавить("ТМЦВЭксплуатации.СуммаВР");
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Таблица.НомерСтроки КАК ЧИСЛО) КАК НомерСтроки,
		|	ВЫРАЗИТЬ(Таблица.КатегорияЭксплуатации КАК Справочник.КатегорииЭксплуатации) КАК КатегорияЭксплуатации,
		|	ВЫРАЗИТЬ(Таблица.ИнвентарныйНомер КАК СТРОКА(11)) КАК ИнвентарныйНомер,
		|	ВЫРАЗИТЬ(Таблица.Сумма КАК ЧИСЛО) КАК Сумма,
		|	ВЫРАЗИТЬ(Таблица.СуммаПР КАК ЧИСЛО) КАК СуммаПР,
		|	ВЫРАЗИТЬ(Таблица.СуммаВР КАК ЧИСЛО) КАК СуммаВР
		|ПОМЕСТИТЬ Таблица
		|ИЗ
		|	&Таблица КАК Таблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Таблица.НомерСтроки КАК НомерСтроки,
		|	ЕСТЬNULL(Таблица.КатегорияЭксплуатации.ИнвентарныйУчет, ЛОЖЬ) КАК ИнвентарныйУчет,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(Таблица.КатегорияЭксплуатации.ИнвентарныйУчет, ЛОЖЬ)
		|				И Таблица.ИнвентарныйНомер В
		|					(ВЫБРАТЬ
		|						ТаблицаДублей.ИнвентарныйНомер
		|					ИЗ
		|						Таблица КАК ТаблицаДублей
		|					ГДЕ
		|						ТаблицаДублей.ИнвентарныйНомер = Таблица.ИнвентарныйНомер
		|						И ТаблицаДублей.НомерСтроки <> Таблица.НомерСтроки)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьОшибкиДубль
		|ИЗ
		|	Таблица КАК Таблица"
	);
	Запрос.УстановитьПараметр("Таблица", ТМЦВЭксплуатации.Выгрузить(, "НомерСтроки, КатегорияЭксплуатации, ИнвентарныйНомер, Сумма, СуммаПР, СуммаВР"));
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		
		ШаблонОшибкаПустойИнвентарныйНомер = НСтр("ru = 'Не заполнена колонка ""Инвентарный номер""
			|в строке %НомерСтроки% списка ""ТМЦ в эксплуатации""';
			|en = 'The ""Inventory number"" column is not filled out
			|in%НомерСтроки% line of the ""Inventory in operation"" list'");
		
		ШаблонОшибкаДубль = НСтр("ru = 'Инвентарный номер ""%ИнвентарныйНомер%""
			|в строке %НомерСтроки% списка ""ТМЦ в эксплуатации"" повторяется в других строках документа';
			|en = 'Inventory number ""%ИнвентарныйНомер%""
			|in line %НомерСтроки% of list ""Inventory in operation"" is repeated in other lines of the document'");
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			СтрокаТЧ = ТМЦВЭксплуатации[Выборка.НомерСтроки-1];
			Если Выборка.ИнвентарныйУчет И (ПустаяСтрока(СтрокаТЧ.ИнвентарныйНомер) Или Выборка.ЕстьОшибкиДубль) Тогда
				
				Если ПустаяСтрока(СтрокаТЧ.ИнвентарныйНомер) Тогда
					ТекстСообщения = СтрЗаменить(ШаблонОшибкаПустойИнвентарныйНомер, "%НомерСтроки%", СтрокаТЧ.НомерСтроки);
				ИначеЕсли Выборка.ЕстьОшибкиДубль Тогда
					ТекстСообщения = СтрЗаменить(ШаблонОшибкаДубль, "%ИнвентарныйНомер%", СтрокаТЧ.ИнвентарныйНомер);
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", СтрокаТЧ.НомерСтроки);
				КонецЕсли;
				
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТМЦВЭксплуатации", Выборка.НомерСтроки, "ИнвентарныйНомер");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеРасходовПриУСН(Отказ)
	
	Для ТекИндекс = 0 По РасходыПриУСН.Количество()-1 Цикл
		
		Строка = РасходыПриУСН[ТекИндекс];
		
		Если Строка.СуммаОплаты > Строка.СуммаРасходов Тогда
			
			ТекстОшибки = НСтр("ru = 'Сумма ранее совершенной оплаты не может превышать сумму расходов к признанию';
								|en = 'Amount of the previous payment cannot exceed the amount of expenses for recognition'");
			ТекстОшибки =  СтрЗаменить(ТекстОшибки, "%НомерСтроки%", РасходыПриУСН[ТекИндекс].НомерСтроки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					ТекстОшибки,
					ЭтотОбъект,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("РасходыПриУСН", РасходыПриУСН[ТекИндекс].НомерСтроки, "СуммаОплаты"),
					,
					Отказ);
		КонецЕсли;
		
		Если Строка.СуммаОтгрузки > Строка.СуммаРасходов Тогда
			ТекстОшибки = НСтр("ru = 'Сумма ранее совершенной отгрузки не может превышать сумму расходов к признанию';
								|en = 'Amount of the previous shipment cannot exceed the amount of expenses for recognition'");
			ТекстОшибки =  СтрЗаменить(ТекстОшибки, "%НомерСтроки%", РасходыПриУСН[ТекИндекс].НомерСтроки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					ТекстОшибки,
					ЭтотОбъект,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("РасходыПриУСН", РасходыПриУСН[ТекИндекс].НомерСтроки, "СуммаОплаты"),
					,
					Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

