			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
    ДокументуатОтчетПоставщикаПЦ.Ссылка КАК Ссылка,
    ДокументуатОтчетПоставщикаПЦ.ВерсияДанных КАК ВерсияДанных,
    ДокументуатОтчетПоставщикаПЦ.ПометкаУдаления КАК ПометкаУдаления,
    ДокументуатОтчетПоставщикаПЦ.Номер КАК Номер,
    ДокументуатОтчетПоставщикаПЦ.Дата КАК Дата,
    ДокументуатОтчетПоставщикаПЦ.Проведен КАК Проведен,
    ДокументуатОтчетПоставщикаПЦ.Контрагент КАК Контрагент,
    ДокументуатОтчетПоставщикаПЦ.АЗС КАК АЗС,
    ДокументуатОтчетПоставщикаПЦ.ВалютаДокумента КАК ВалютаДокумента,
    ДокументуатОтчетПоставщикаПЦ.Ответственный КАК Ответственный,
    ДокументуатОтчетПоставщикаПЦ.Организация КАК Организация,
    ДокументуатОтчетПоставщикаПЦ.Комментарий КАК Комментарий,
    ДокументуатОтчетПоставщикаПЦ.Заправки.(
        Ссылка КАК Ссылка,
        НомерСтроки КАК НомерСтроки,
        ГСМ КАК ГСМ,
        Дата КАК Дата,
        Количество КАК Количество,
        МестоЗаправкиКод КАК МестоЗаправкиКод,
        МестоЗаправкиНаименование КАК МестоЗаправкиНаименование,
        НоменклатураОтчета КАК НоменклатураОтчета,
        ПластиковаяКарта КАК ПластиковаяКарта,
        ПластиковаяКартаОтчета КАК ПластиковаяКартаОтчета,
        Проверено КАК Проверено,
        Сумма КАК Сумма,
        ТС КАК ТС,
        ТСОтчета КАК ТСОтчета,
        СтавкаНДС КАК СтавкаНДС,
        СуммаНДС КАК СуммаНДС
    ) КАК Заправки,
    ДокументуатОтчетПоставщикаПЦ.МоментВремени КАК МоментВремени,
    ЕСТЬNULL(ДанныеТЧ.Сумма, 0) КАК Сумма,
    ЕСТЬNULL(ДанныеТЧ.Количество, 0) КАК Количество,
    ДокументуатОтчетПоставщикаПЦ.СписокТС КАК СписокТС
ИЗ
    Документ.уатОтчетПоставщикаПЦ КАК ДокументуатОтчетПоставщикаПЦ
        ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
            ДокументуатОтчетПоставщикаПЦ1.Ссылка КАК Ссылка,
            СУММА(ДокументуатОтчетПоставщикаПЦ1.Сумма) КАК Сумма,
            СУММА(ДокументуатОтчетПоставщикаПЦ1.Количество) КАК Количество
        ИЗ
            Документ.уатОтчетПоставщикаПЦ.Заправки КАК ДокументуатОтчетПоставщикаПЦ1
        
        СГРУППИРОВАТЬ ПО
            ДокументуатОтчетПоставщикаПЦ1.Ссылка) КАК ДанныеТЧ
        ПО ДокументуатОтчетПоставщикаПЦ.Ссылка = ДанныеТЧ.Ссылка</QueryText>
				<MainTable>Document.уатОтчетПоставщикаПЦ</MainTable>
