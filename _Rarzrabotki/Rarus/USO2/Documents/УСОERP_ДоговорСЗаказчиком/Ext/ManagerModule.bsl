
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстыЗапроса.Добавить(ТекстЗапросаВтТаблицаРаботы(),				 		 "");
	ТекстыЗапроса.Добавить(ТекстЗапросаТаблицаВыполнениеРаботЗаказчика(),		 "ТаблицаВыполнениеРаботЗаказчика");
	ТекстыЗапроса.Добавить(ТекстЗапросаТаблицаВыполнениеРаботЗаказчикаВнешняя(), "ТаблицаВыполнениеРаботЗаказчикаВнешняя");

	//График движения по договору
	ТекстыЗапроса.Добавить(ТекстЗапроса_ГрафикДвиженийПоДоговору(ДокументСсылка),	"ТаблицаГрафикДвиженийПоДоговору");
//	ТекстыЗапроса.Добавить(ТекстЗапроса_РегистрНакопленияРасчеты(ДокументСсылка),	"ТаблицаРегистрНакопленияРасчеты");
	ТекстыЗапроса.Добавить(ТекстЗапроса_РегистрНакопленияРасчеты(ДокументСсылка),	"ТаблицаРасчетыСКлиентами");
	//Конец График движения по договору
	                                   	
	Запрос.Текст = "";
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		Запрос.Текст = Запрос.Текст + ТекстЗапроса.Значение;
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////
	// Выполним запрос
	
	Результат = Запрос.ВыполнитьПакет();
	
	////////////////////////////////////////////////////////////////////////////
	// Поместим результаты запроса в дополнительные свойства
	
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		
		ИмяТаблицы = ТекстЗапроса.Представление;
		
		Если Не ПустаяСтрока(ИмяТаблицы) Тогда
			
			Индекс = ТекстыЗапроса.Индекс(ТекстЗапроса);
			ДополнительныеСвойства.ТаблицыДляДвижений.Вставить(ИмяТаблицы, Результат[Индекс].Выгрузить());
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ДоговорСЗаказчиком.Дата КАК Период,
	|	УСОERP_ДоговорСЗаказчиком.Ссылка КАК Ссылка,
	|	УСОERP_ДоговорСЗаказчиком.ОбъектСтроительства,
	|	УСОERP_ДоговорСЗаказчиком.Организация КАК Организация,
	|	УСОERP_ДоговорСЗаказчиком.Партнер КАК Партнер,
	|	УСОERP_ДоговорСЗаказчиком.Договор КАК Договор,
	|	УСОERP_ДоговорСЗаказчиком.Валюта КАК Валюта,
	|	УСОERP_ДоговорСЗаказчиком.Контрагент,
	|	УСОERP_ДоговорСЗаказчиком.Соглашение
	|ИЗ
	|	Документ.УСОERP_ДоговорСЗаказчиком КАК УСОERP_ДоговорСЗаказчиком
	|ГДЕ
	|	УСОERP_ДоговорСЗаказчиком.Ссылка = &Ссылка";
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	//
	Запрос.УстановитьПараметр("Соглашение",                                  Реквизиты.Соглашение);
	Запрос.УстановитьПараметр("Партнер",                                     Реквизиты.Партнер);
	Запрос.УстановитьПараметр("ОбъектСтроительства",                         Реквизиты.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Период",                                      Реквизиты.Период);
	Запрос.УстановитьПараметр("Валюта",                                      Реквизиты.Валюта);
	Запрос.УстановитьПараметр("Организация",                                 Реквизиты.Организация);
	Запрос.УстановитьПараметр("Контрагент",                                  Реквизиты.Контрагент);
	Запрос.УстановитьПараметр("Договор",                               		 Реквизиты.Договор);
	
	Запрос.УстановитьПараметр("Планирование_ЗаказКлиента", 		             Перечисления.ХозяйственныеОперации.ПланированиеПоЗаказуКлиента);
	Запрос.УстановитьПараметр("Планирование_ЗаказПоставщику",	             Перечисления.ХозяйственныеОперации.ПланированиеПоЗаказуПоставщику);
	Запрос.УстановитьПараметр("Ссылка", 						             ДокументСсылка);
	
	АналитикаУчетаПоПартнерам = РегистрыСведений.АналитикаУчетаПоПартнерам.ЗначениеКлючаАналитики(ДокументСсылка);
	Если НЕ ЗначениеЗаполнено(АналитикаУчетаПоПартнерам) Тогда
		АналитикаУчетаПоПартнерам = РегистрыСведений.АналитикаУчетаПоПартнерам.СоздатьКлючАналитики(ДокументСсылка);
	КонецЕсли;
	
	//Запрос.УстановитьПараметр("АналитикаУчетаПоПартнерам",		РегистрыСведений.АналитикаУчетаПоПартнерам.ЗначениеКлючаАналитики(ДокументСсылка));
	Запрос.УстановитьПараметр("АналитикаУчетаПоПартнерам",		АналитикаУчетаПоПартнерам);
	
	ДокументДопПараметры = УСОERP_МодификацияКонфигурации.ПолучитьДополнительныеПараметрыПоДоговору(ДокументСсылка.Договор,ДокументСсылка.ОбъектСтроительства,ДокументСсылка.Дата,Истина,ДокументСсылка.ДокументУтверждения);
	Запрос.УстановитьПараметр("ДопПараметрыПоДоговору",         УСОERP_МодификацияКонфигурации.ПолучитьДополнительныеПараметрыПоДоговору(ДокументСсылка.Договор,ДокументСсылка.ОбъектСтроительства,ДокументСсылка.Дата,Истина,ДокументСсылка.ДокументУтверждения));
	Запрос.УстановитьПараметр("ПоВидамРабот", ДокументДопПараметры.ПоВидамРабот);
	Запрос.УстановитьПараметр("ПоРаботам",ДокументДопПараметры.ПоРаботам);
	Запрос.УстановитьПараметр("ГраницаДаты",Новый Граница(ДокументСсылка,ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Дата",ДокументСсылка.Дата);
	Запрос.УстановитьПараметр("ДелатьСторно",ДокументСсылка.ГрафикДвиженияПоДоговору.Количество()>0);
	
КонецПроцедуры

Функция ТекстЗапросаВтТаблицаРаботы()
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	УСОERP_ДоговорСЗаказчикомРаботы.Работа,
	|	УСОERP_ДоговорСЗаказчикомРаботы.Объем,
	|	УСОERP_ДоговорСЗаказчикомРаботы.ЕдиницаОбъема,
	|	УСОERP_ДоговорСЗаказчикомРаботы.ДатаНачала,
	|	УСОERP_ДоговорСЗаказчикомРаботы.ДатаОкончания,
	|	УСОERP_ДоговорСЗаказчикомРаботы.Длительность,
	|	УСОERP_ДоговорСЗаказчикомРаботы.ЕдиницаДлительности,
	|	УСОERP_ДоговорСЗаказчикомРаботы.СуммаСНДС,
	|	УСОERP_ДоговорСЗаказчикомРаботы.СтавкаНДС,
	|	УСОERP_ДоговорСЗаказчикомРаботы.СуммаНДС,
	|	УСОERP_ДоговорСЗаказчикомРаботы.НомерСтроки
	|ПОМЕСТИТЬ ВтТаблицаРаботы
	|ИЗ
	|	Документ.УСОERP_ДоговорСЗаказчиком.Работы КАК УСОERP_ДоговорСЗаказчикомРаботы
	|ГДЕ
	|	УСОERP_ДоговорСЗаказчикомРаботы.Ссылка = &Ссылка
	|	И НЕ УСОERP_ДоговорСЗаказчикомРаботы.Работа.СуммарнаяРабота
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаВыполнениеРаботЗаказчика()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&Организация КАК Организация,
	|	&ОбъектСтроительства КАК ОбъектСтроительства,
	|	&Контрагент КАК Контрагент,
	|	&Договор КАК Договор,
	|	&Соглашение КАК Соглашение,
	|	&Партнер КАК Партнер,
	|	ТаблицаРаботы.НомерСтроки КАК НомерСтроки,
	//|	ТаблицаРаботы.Работа КАК Работа,
	|	ВЫБОР КОГДА ТаблицаРаботы.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка) ТОГДА ТаблицаРаботы.Работа ИНАЧЕ ТаблицаРаботы.Работа.РаботаИсточник КОНЕЦ КАК Работа,
	|	ТаблицаРаботы.Объем КАК Объем,
	|	ТаблицаРаботы.СуммаСНДС КАК СуммаСНДС,
	|	ТаблицаРаботы.СуммаНДС КАК СуммаНДС,
	|	ТаблицаРаботы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТаблицаРаботы.ДатаНачала КАК ДатаНачала,
	|	ТаблицаРаботы.ДатаОкончания КАК ДатаОкончания,
	|	ТаблицаРаботы.Длительность КАК Длительность,
	|	ТаблицаРаботы.ЕдиницаДлительности КАК ЕдиницаДлительности
	|ИЗ
	|	ВтТаблицаРаботы КАК ТаблицаРаботы
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
    //Сторно всех работ предыдущих документов
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Период КАК Период,
	|	ВложенныйЗапрос.ВидДвижения КАК ВидДвижения,
	|	ВложенныйЗапрос.Организация КАК Организация,
	|	ВложенныйЗапрос.ОбъектСтроительства КАК ОбъектСтроительства,
	|	ВложенныйЗапрос.Контрагент КАК Контрагент,
	|	ВложенныйЗапрос.Договор КАК Договор,
	|	ВложенныйЗапрос.Соглашение КАК Соглашение,
	|	ВложенныйЗапрос.Партнер КАК Партнер,
	|	СУММА(ВложенныйЗапрос.НомерСтроки) КАК НомерСтроки,
	|	ВложенныйЗапрос.Работа КАК Работа,
	|	СУММА(ВложенныйЗапрос.Объем) КАК Объем,
	|	СУММА(ВложенныйЗапрос.СуммаСНДС) КАК СуммаСНДС,
	|	СУММА(ВложенныйЗапрос.СуммаНДС) КАК СуммаНДС,
	|	ВложенныйЗапрос.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ВложенныйЗапрос.ДатаНачала КАК ДатаНачала,
	|	ВложенныйЗапрос.ДатаОкончания КАК ДатаОкончания,
	|	ВложенныйЗапрос.Длительность КАК Длительность,
	|	ВложенныйЗапрос.ЕдиницаДлительности КАК ЕдиницаДлительности
	|ИЗ
	|	(ВЫБРАТЬ
	|		&Период КАК Период,
	|		ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|		&Организация КАК Организация,
	|		&ОбъектСтроительства КАК ОбъектСтроительства,
	|		&Контрагент КАК Контрагент,
	|		&Договор КАК Договор,
	|		&Соглашение КАК Соглашение,
	|		&Партнер КАК Партнер,
	|		ТаблицаРаботы.НомерСтроки КАК НомерСтроки,
	|		ВЫБОР
	|			КОГДА ТаблицаРаботы.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|				ТОГДА ТаблицаРаботы.Работа
	|			ИНАЧЕ ТаблицаРаботы.Работа.РаботаИсточник
	|		КОНЕЦ КАК Работа,
	|		ТаблицаРаботы.Объем КАК Объем,
	|		ТаблицаРаботы.СуммаСНДС КАК СуммаСНДС,
	|		ТаблицаРаботы.СуммаНДС КАК СуммаНДС,
	|		ТаблицаРаботы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|		ТаблицаРаботы.ДатаНачала КАК ДатаНачала,
	|		ТаблицаРаботы.ДатаОкончания КАК ДатаОкончания,
	|		ТаблицаРаботы.Длительность КАК Длительность,
	|		ТаблицаРаботы.ЕдиницаДлительности КАК ЕдиницаДлительности
	|	ИЗ
	|		ВтТаблицаРаботы КАК ТаблицаРаботы
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		&Период,
	|		ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|		УСОERP_ВыполнениеРаботЗаказчика.Организация,
	|		УСОERP_ВыполнениеРаботЗаказчика.ОбъектСтроительства,
	|		УСОERP_ВыполнениеРаботЗаказчика.Контрагент,
	|		УСОERP_ВыполнениеРаботЗаказчика.Договор,
	|		УСОERP_ВыполнениеРаботЗаказчика.Соглашение,
	|		УСОERP_ВыполнениеРаботЗаказчика.Партнер,
	|		0,
	|		УСОERP_ВыполнениеРаботЗаказчика.Работа,
	|		-УСОERP_ВыполнениеРаботЗаказчика.Объем,
	|		-УСОERP_ВыполнениеРаботЗаказчика.СуммаСНДС,
	|		-УСОERP_ВыполнениеРаботЗаказчика.СуммаНДС,
	|		УСОERP_ВыполнениеРаботЗаказчика.ЕдиницаОбъема,
	|		УСОERP_ВыполнениеРаботЗаказчика.ДатаНачала,
	|		УСОERP_ВыполнениеРаботЗаказчика.ДатаОкончания,
	|		УСОERP_ВыполнениеРаботЗаказчика.Длительность,
	|		УСОERP_ВыполнениеРаботЗаказчика.ЕдиницаДлительности
	|	ИЗ
	|		РегистрНакопления.УСОERP_ВыполнениеРаботЗаказчика КАК УСОERP_ВыполнениеРаботЗаказчика
	|	ГДЕ
	|		УСОERP_ВыполнениеРаботЗаказчика.Период <= &Период
	|		И УСОERP_ВыполнениеРаботЗаказчика.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		И УСОERP_ВыполнениеРаботЗаказчика.Организация = &Организация
	|		И УСОERP_ВыполнениеРаботЗаказчика.ОбъектСтроительства = &ОбъектСтроительства
	|		И УСОERP_ВыполнениеРаботЗаказчика.Регистратор <> &Ссылка) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Период,
	|	ВложенныйЗапрос.ВидДвижения,
	|	ВложенныйЗапрос.Организация,
	|	ВложенныйЗапрос.ОбъектСтроительства,
	|	ВложенныйЗапрос.Контрагент,
	|	ВложенныйЗапрос.Договор,
	|	ВложенныйЗапрос.Соглашение,
	|	ВложенныйЗапрос.Партнер,
	|	ВложенныйЗапрос.Работа,
	|	ВложенныйЗапрос.ЕдиницаОбъема,
	|	ВложенныйЗапрос.ДатаНачала,
	|	ВложенныйЗапрос.ДатаОкончания,
	|	ВложенныйЗапрос.Длительность,
	|	ВложенныйЗапрос.ЕдиницаДлительности
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВложенныйЗапрос.Объем) <> 0 ИЛИ
	|	СУММА(ВложенныйЗапрос.СуммаСНДС) <> 0 ИЛИ
	|	СУММА(ВложенныйЗапрос.СуммаНДС) <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";


	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаВыполнениеРаботЗаказчикаВнешняя()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&Организация КАК Организация,
	|	&ОбъектСтроительства КАК ОбъектСтроительства,
	|	&Контрагент КАК Контрагент,
	|	&Договор КАК Договор,
	|	&Соглашение КАК Соглашение,
	|	&Партнер КАК Партнер,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.Ссылка.СценарийПланирования,
	|	ВЫБОР
	|		КОГДА УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|			ТОГДА УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.Работа
	|		ИНАЧЕ УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.Работа.РаботаИсточник
	|	КОНЕЦ КАК Работа,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.Объем,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.ЕдиницаОбъема,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.ДатаНачала,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.ДатаОкончания,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.Длительность,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.ЕдиницаДлительности,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.СуммаСНДС,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.СуммаНДС
	|ИЗ
