&НаСервере
Функция ЗаполнитьТабличнуюЧастьИзДереваЗначений(Дерево, ТабличнаяЧасть, НомерПоПрядку, Отказ)
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		НомерПоПрядку = НомерПоПрядку + 1;
		Если Не ЗначениеЗаполнено(СтрокаДерева.Работа) Тогда
			Сообщить(НСтр("ru='Не заполнено значение Работа в строке '")+ НомерПоПрядку);
			Отказ = Истина;
			Возврат Отказ;
		КонецЕсли;	
        ЗаполнитьЗначенияСвойств(ТабличнаяЧасть.Добавить(), СтрокаДерева);
        ЗаполнитьТабличнуюЧастьИзДереваЗначений(СтрокаДерева, ТабличнаяЧасть, НомерПоПрядку, Отказ);
    КонецЦикла;
    Возврат ТабличнаяЧасть;
КонецФункции

&НаКлиенте
Функция РассчитатьИтоговыеПоказатели()
	
	СтрокиДеревоЗначений = РаботыДеревоЗначений.ПолучитьЭлементы();
	ЗаполнитьИтоговыеДанныеПоСуммарнымРаботам(СтрокиДеревоЗначений);
	
	СуммаВсего = 0;
	СуммаНДС   = 0;
	Для Каждого СтрокаСтрокиДеревоЗначений Из СтрокиДеревоЗначений Цикл
		СуммаВсего = СуммаВсего + СтрокаСтрокиДеревоЗначений.СуммаСНДС;
		СуммаНДС   = СуммаНДС + СтрокаСтрокиДеревоЗначений.СуммаНДС;
	КонецЦикла;	
	
	СуммаВсего_ПоЗаказчику = 0;
	СуммаНДС_ПоЗаказчику   = 0;
	
	СтрокиДеревоЗначений = ДеревоРаботЗаказчика.ПолучитьЭлементы();
	ЗаполнитьИтоговыеДанныеПоСуммарнымРаботам(СтрокиДеревоЗначений);
	
	Для Каждого СтрокаСтрокиДеревоЗначений Из СтрокиДеревоЗначений Цикл
		СуммаВсего_ПоЗаказчику = СуммаВсего_ПоЗаказчику + СтрокаСтрокиДеревоЗначений.СуммаСНДС;
		СуммаНДС_ПоЗаказчику   = СуммаНДС_ПоЗаказчику + СтрокаСтрокиДеревоЗначений.СуммаНДС;
	КонецЦикла;	
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьИтоговыеДанныеПоСуммарнымРаботам(СтрокиРаботДеревоЗначений, СтрокаРодитель = Неопределено)
	
	Если СтрокаРодитель <> Неопределено Тогда
		СтрокаРодитель.СуммаСНДС 		= 0;
		СтрокаРодитель.СуммаНДС 		= 0;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из СтрокиРаботДеревоЗначений Цикл
		ПодчиненныеРаботыПоСтроке = ТекСтрока.ПолучитьЭлементы();
		Если ПодчиненныеРаботыПоСтроке.Количество() <> 0 Тогда
			ЗаполнитьИтоговыеДанныеПоСуммарнымРаботам(ПодчиненныеРаботыПоСтроке, ТекСтрока);
		КонецЕсли;
		Если СтрокаРодитель <> Неопределено Тогда
			СтрокаРодитель.СуммаСНДС 		= СтрокаРодитель.СуммаСНДС 			+ ТекСтрока.СуммаСНДС;
			СтрокаРодитель.СуммаНДС 		= СтрокаРодитель.СуммаНДС 			+ ТекСтрока.СуммаНДС;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьИтоговыеПоказателиРодителей(ТекущаяСтрока, СуммаСНДСДОбавить)
	
	ТекущаяСтрока = Элементы.РаботыДеревоЗначений.ТекущиеДанные;	
	
	Пока ТекущаяСтрока.ПолучитьРодителя() <> Неопределено Цикл
		
		Родитель =  ТекущаяСтрока.ПолучитьРодителя();
		Родитель.СуммаСНДС = Родитель.СуммаСНДС + СуммаСНДСДОбавить;
		
		Если Не ЗначениеЗаполнено(Родитель.СтавкаНДС) Тогда
			Родитель.СтавкаНДС = ТекущаяСтрока.СтавкаНДС;
		КонецЕсли;
		
		Родитель.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(Родитель.СуммаСНДС, Родитель.СтавкаНДС, Истина);
		
		ТекущаяСтрока = Родитель;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВнутренниеРаботыНаОснованииРаботЗаказчика(ТекущийОбъект, ТабличнаяЧастьРаботы)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.НомерСтроки,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.КодСДР,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.Работа,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.Объем,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.ЕдиницаОбъема,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.ДатаНачала,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.ДатаОкончания,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.Длительность,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.ЕдиницаДлительности,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.СуммаСНДС,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.СтавкаНДС,
	|	УСОERP_ДоговорСЗаказчикомРаботыЗаказчика.СуммаНДС
	|ПОМЕСТИТЬ ВТ_РаботыЗаказчика
	|ИЗ
	|	&РаботыЗаказчика КАК УСОERP_ДоговорСЗаказчикомРаботыЗаказчика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_РаботыЗаказчика.НомерСтроки,
	|	ВТ_РаботыЗаказчика.Работа КАК РаботаЗаказчика,
	|	ВТ_РаботыЗаказчика.Объем,
	|	ВТ_РаботыЗаказчика.СуммаСНДС,
	|	ВТ_РаботыЗаказчика.СтавкаНДС,
	|	ВТ_РаботыЗаказчика.СуммаНДС,
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.Работа КАК Работа,
	|	ЕСТЬNULL(УСОERP_СоответствиеРаботРаботамЗаказчика.РаспределениеСтоимостиРабот, 0) КАК Распределение
	|ПОМЕСТИТЬ ВТ_СоответсвиеРабот
	|ИЗ
	|	ВТ_РаботыЗаказчика КАК ВТ_РаботыЗаказчика
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_СоответствиеРаботРаботамЗаказчика КАК УСОERP_СоответствиеРаботРаботамЗаказчика
	|		ПО ВТ_РаботыЗаказчика.Работа = УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя
	|ГДЕ
	|	ЕСТЬNULL(УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя, ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|	И ЕСТЬNULL(УСОERP_СоответствиеРаботРаботамЗаказчика.Работа, ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СоответсвиеРабот.НомерСтроки,
	|	ВТ_СоответсвиеРабот.РаботаЗаказчика,
	|	ВТ_СоответсвиеРабот.Объем КАК ОбъемЗаказчика,
	|	ВТ_СоответсвиеРабот.СуммаСНДС КАК СуммаСНДСЗаказчика,
	|	ВТ_СоответсвиеРабот.СуммаНДС КАК СуммаНДСЗаказчика,
	|	ВТ_СоответсвиеРабот.Работа КАК Работа,
	|	ВТ_СоответсвиеРабот.Распределение,
	|	ВТ_СоответсвиеРабот.Работа.КодСДР КАК КодСДР,
	|	ЕСТЬNULL(УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОбъемРаботы, 0) КАК Объем,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ЕдиницаОбъема,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.НачалоРаботыПлан КАК ДатаНачала,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОкончаниеРаботыПлан КАК ДатаОкончания,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ДлительностьПлан КАК Длительность,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ЕдиницаДлительности
	|ИЗ
	|	ВТ_СоответсвиеРабот КАК ВТ_СоответсвиеРабот
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(
	|				&КонецПериода,
	|				Работа В
	|						(ВЫБРАТЬ
	|							ВТ_СоответсвиеРабот.Работа
	|						ИЗ
	|							ВТ_СоответсвиеРабот КАК ВТ_СоответсвиеРабот)
	|					И ВидПланирования = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыПланированияСтроительныхРабот.Календарный)
	|					И Утверждена = ИСТИНА) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
	|		ПО ВТ_СоответсвиеРабот.Работа = УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа
	|ИТОГИ ПО
	|	Работа";
	Запрос.УстановитьПараметр("РаботыЗаказчика", ТекущийОбъект.РаботыЗаказчика.Выгрузить());
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	
	Результат = Запрос.Выполнить();
	
	ВыборкаРабота = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРабота.Следующий() Цикл
		
		//ОбъемРаботы = 0;
		СуммаСНДС = 0;
		СуммаНДС = 0;
		
		Выборка = ВыборкаРабота.Выбрать();
		
		СтруктураЗаполнения = Новый Структура("Работа, Объем, ЕдиницаОбъема, КодСДР, ДатаНачала, ДатаОкончания, Длительность, ЕдиницаДлительности");
		ЭтоПервый = Истина;
		Пока Выборка.Следующий() Цикл
			Если ЭтоПервый Тогда
				ЗаполнитьЗначенияСвойств(СтруктураЗаполнения, Выборка);
				ЭтоПервый = Ложь;
			КонецЕсли;
			
			СуммаСНДС = СуммаСНДС + Окр(Выборка.СуммаСНДСЗаказчика / (Выборка.Распределение/100), 2);
			СуммаНДС = СуммаНДС + Окр(Выборка.СуммаНДСЗаказчика / (Выборка.Распределение/100), 2);
		КонецЦикла;
		
		Если Не СуммаСНДС = 0 Тогда
			НоваяСтрока = ТабличнаяЧастьРаботы.Добавить();
			ЗаполнитьЗначенияСВойств(НоваяСтрока, СтруктураЗаполнения);
			НоваяСтрока.СуммаСНДС = СуммаСНДС;
			НоваяСтрока.СуммаНДС = СуммаНДС;
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаботыЗаказчикаПередЗаписью(СтрокаДерева, РаботыЗаказчика)
	
	Для Каждого СтрокаРабот Из СтрокаДерева.Строки Цикл
		НоваяСтрока = РаботыЗаказчика.добавить();
		ЗаполнитьЗначенияСвойств( НоваяСтрока, СтрокаРабот);
		
		ЗаполнитьРаботыЗаказчикаПередЗаписью(СтрокаРабот, РаботыЗаказчика)

	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоРаботЗаказчикаПриСоздании()
	
	Если Объект.РаботыЗаказчика.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТабличнаяЧастьРаботы.КодСДР,
		|	ТабличнаяЧастьРаботы.Работа,
		|	ТабличнаяЧастьРаботы.Объем,
		|	ТабличнаяЧастьРаботы.ЕдиницаОбъема,
		|	ТабличнаяЧастьРаботы.ДатаНачала,
		|	ТабличнаяЧастьРаботы.ДатаОкончания,
		|	ТабличнаяЧастьРаботы.Длительность,
		|	ТабличнаяЧастьРаботы.ЕдиницаДлительности,
		|	ТабличнаяЧастьРаботы.СуммаСНДС,
		|	ТабличнаяЧастьРаботы.СтавкаНДС,
		|	ТабличнаяЧастьРаботы.СуммаНДС
		|ПОМЕСТИТЬ ВременнаяТаблицаРаботы
		|ИЗ
		|	&ТабличнаяЧастьРаботы КАК ТабличнаяЧастьРаботы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВременнаяТаблицаРаботы.КодСДР КАК КодСДР,
		|	УСОERP_СтроительныеРаботы.Ссылка КАК Работа,
		|	УСОERP_СтроительныеРаботы.Ссылка.СУммарнаяРабота КАК СуммарнаяРабота,
		|	ВременнаяТаблицаРаботы.Объем,
		|	ВременнаяТаблицаРаботы.ЕдиницаОбъема,
		|	ВременнаяТаблицаРаботы.ДатаНачала,
		|	ВременнаяТаблицаРаботы.ДатаОкончания,
		|	ВременнаяТаблицаРаботы.Длительность,
		|	ВременнаяТаблицаРаботы.ЕдиницаДлительности,
		|	ВременнаяТаблицаРаботы.СуммаСНДС,
		|	ВременнаяТаблицаРаботы.СтавкаНДС,
		|	ВременнаяТаблицаРаботы.СуммаНДС
		|ИЗ
		|	ВременнаяТаблицаРаботы КАК ВременнаяТаблицаРаботы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
		|		ПО ВременнаяТаблицаРаботы.Работа = УСОERP_СтроительныеРаботы.Ссылка
		|ГДЕ
		|	ВременнаяТаблицаРаботы.Работа В(&МассивРабот)
		|ИТОГИ ПО
		|	Работа ТОЛЬКО ИЕРАРХИЯ";
		
		Запрос.УстановитьПараметр("МассивРабот", Объект.РаботыЗаказчика.Выгрузить(,"Работа"));
		Запрос.УстановитьПараметр("ТабличнаяЧастьРаботы", Объект.РаботыЗаказчика.Выгрузить());
				
		ДанныеДляДерева =  Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		//ДеревоРабот = УСОERP_ОбработкаТабличныхЧастей.УСОERP_ПодготовитьДанныеИСформироватьДеревоСВосстановлениемСтруктуры(ДанныеДляДерева,"Работа","РаботаРодитель",,Справочники.УСОERP_СтроительныеРаботы);		
		УСОERP_ОбработкаТабличныхЧастей.ОбработатьСтрокиДереваЗначений(ДанныеДляДерева.Строки, "Работа");
		ДанныеДляДерева.Колонки.Добавить("КодСДРЧисло", Новый ОписаниеТипов("Число"));
		ЗаполнитьКодСДРВЧислоВДеревеРабот(ДанныеДляДерева.Строки);
		
		ДанныеДляДерева.Строки.Сортировать("КодСДРЧисло Возр", Истина);
		
		ВремРодноеДерево = РеквизитФормыВЗначение("ДеревоРаботЗаказчика"); // берется родная структура с родной типизацией
		ВремРодноеДерево.Строки.Очистить();
		УСОERP_ОбработкаТабличныхЧастей.УСОERP_ЗаполнитьРоднуюСтруктуруДереваИзВнешнего(ВремРодноеДерево.Строки, ДанныеДляДерева.Строки); // и рекурсивно заполняется из дерева, где, возможн, типиация создаст проблемы
		ЗначениеВРеквизитФормы(ВремРодноеДерево, "ДеревоРаботЗаказчика");

КонецПроцедуры
	
&НаСервере
Процедура ЗаполнитьКодСДРВЧислоВДеревеРабот(Строки)
	
	Для Каждого СтрокаТЗ Из Строки Цикл
		СтрокаТЗ.КодСДРЧисло = УСОERP_ОбработкаТабличныхЧастей.КодСДРвЧисло(СтрокаТЗ.Работа.КодСДР);
		ЗаполнитьКодСДРВЧислоВДеревеРабот(СтрокаТЗ.Строки);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьЗакладкиРаботЗаказчика()
	
	Элементы.ГруппаРаботыЗаказчика.Видимость = Объект.ЗаполнятьРаботамиЗаказчика;
	
	Если НЕ Объект.ЗаполнятьРаботамиЗаказчика Тогда
		Объект.РаботыЗаказчика.Очистить();
		СтрокиДереваРабот = ДеревоРаботЗаказчика.ПолучитьЭлементы();
		СтрокиДереваРабот.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаботыДеревоЗначенийПослеУдаления(Элемент)
    РассчитатьИтоговыеПоказатели();
	Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Процедура РассчитатьИтогиЭтаповЗаказчика(СтрокаДереваРабот)
	
	ЭлементыКоллекции = СтрокаДереваРабот.ПолучитьЭлементы();

	Для Каждого СтрокаДерева Из ЭлементыКоллекции Цикл
		Если СтрокаДерева.СуммарнаяРабота Тогда
			СтруктураСуммВходящих = ПолучитьСуммуВходящихРабот(СтрокаДерева);
			 СтрокаДерева.СуммаСНДС = СтрокаДерева.СУммаСНДС + СтруктураСуммВходящих.СуммаСНДС;
			 СтрокаДерева.СуммаНДС = СтрокаДерева.СУммаНДС + СтруктураСуммВходящих.СуммаНДС;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументУтвержденияПриИзменении(Элемент)	
	
	Если Объект.ДокументУтверждения = ТекущийДокументУтверждения Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ЭтоНовыйВариант(Объект.ДокументУтверждения) ИЛИ ЭтоНовыйВариант(ТекущийДокументУтверждения) Тогда
		
		Если Объект.ДокументУтверждения <> ТекущийДокументУтверждения Тогда
			
			Если РаботыДеревоЗначений.ПолучитьЭлементы().Количество() +ДеревоРаботЗаказчика.ПолучитьЭлементы().Количество()+Объект.ГрафикДвиженияПоДоговору.Количество() Тогда
				
				ОписаниеОповещения= Новый ОписаниеОповещения("ДокументУтвержденияПриИзмененииПродолжение",ЭтотОбъект);
				
				ПоказатьВопрос(ОписаниеОповещения,"Табличные части будут очищены, продолжить?",РежимДиалогаВопрос.ДаНет);
				
			Иначе
				
				ДокументУтвержденияПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	НовыйВариант = ЭтоНовыйВариант(Объект.ДокументУтверждения); 
	
	ПараметрыФормы = СтруктураПараметрыФормы();		
	ОбновитьФормуНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументУтвержденияПриИзмененииПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Объект.ДокументУтверждения = ТекущийДокументУтверждения;
		Возврат;
	КонецЕсли;  
	
	ОбъектСтроительстваПриИзмененииНаСервере(Ложь);
	
КонецПроцедуры


&НаКлиенте
Процедура ДокументУтвержденияОчистка(Элемент, СтандартнаяОбработка)
	
	ДокументУтвержденияПриИзменении(Элемент);

КонецПроцедуры

#Область ГрафикДвижений

&НаКлиенте
Процедура РассчитатьГрафикДвижений(Команда)
	
	РассчитатьГрафикДвиженийНаСервере(ПараметрыФормы);
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура 	РассчитатьГрафикДвиженийНаСервере(ПараметрыФормы)		
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_ГрафикДвиженийПоДоговору_РассчитатьГрафикДвиженийНаСервере(ЭтотОбъект, ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьГрафикДвижений(Команда)
	
	Если Модифицированность Тогда
		ЗаполнитьТабЧастьРаботы();
	КонецЕсли;
	
	Если Объект.ГрафикДвиженияПоДоговору.Количество() = 0 Тогда
		ЗаполнитьГрафикДвиженияПоДоговору(ПараметрыФормы);
		Модифицированность = Истина;
		Возврат;
	КонецЕсли;
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьВопросПользователю", ЭтотОбъект), 
	"При автоматическом заполнении табличная часть документа будет очищена.", 
	РежимДиалогаВопрос.ОКОтмена);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабЧастьРаботы()
	
	Объект.Работы.Очистить();
	РеквизитРаботыДеревоЗначений = РеквизитФормыВЗначение("РаботыДеревоЗначений", Тип("ДеревоЗначений"));	
	ЗаполнитьТабличнуюЧастьИзДереваЗначений(РеквизитРаботыДеревоЗначений, Объект.Работы,0,Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура 	ЗаполнитьВопросПользователю(РезультатВопроса, ДополнительныеПараметры) Экспорт								
	
	Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.ОК Тогда
		ЗаполнитьГрафикДвиженияПоДоговору(ПараметрыФормы);
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура 	ЗаполнитьГрафикДвиженияПоДоговору(ПараметрыФормы)					
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_ГрафикДвиженийПоДоговору_ЗаполнитьГрафикДвиженияПоДоговору(ЭтотОбъект, ПараметрыФормы);
    РассчитатьГрафикДвиженийНаСервере(ПараметрыФормы);
	
	Если НЕ Объект.УСОERP_РасширенныйГрафикДвижений Тогда
		СвернутьГрафикДвижений();
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура СвернутьГрафикДвижений() 

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТабГрафик",Объект.ГрафикДвиженияПоДоговору.Выгрузить());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.ДатаСобытия КАК ДатаСобытия,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.ВидДвиженияДенежныхСредств КАК ВидДвиженияДенежныхСредств,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.ВидДвиженияДоходРасход КАК ВидДвиженияДоходРасход,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.ОбщаяСумма КАК ОбщаяСумма,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.СтатьяБюджета КАК СтатьяБюджета,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.ВидРабот КАК ВидРабот,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.Работа КАК Работа,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.ДатаАванс КАК ДатаАванс,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.СуммаАванс КАК СуммаАванс,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.ДатаПриемРабот КАК ДатаПриемРабот,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.СуммаПриемРабот КАК СуммаПриемРабот,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.ДатаОстатокПлатежа КАК ДатаОстатокПлатежа,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.СуммаОстатокПлатежа КАК СуммаОстатокПлатежа,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.СуммаУдержаниеОстатокПлатежа КАК СуммаУдержаниеОстатокПлатежа,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.СуммаИтогоОстатокПлатежа КАК СуммаИтогоОстатокПлатежа,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.ДатаВозвратГарантийногоУдержания КАК ДатаВозвратГарантийногоУдержания,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.СуммаВозвратГарантийногоУдержания КАК СуммаВозвратГарантийногоУдержания,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.ВидДДС_Аванс КАК ВидДДС_Аванс,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.ВидДДС_ПризнаниеДоходаРасхода КАК ВидДДС_ПризнаниеДоходаРасхода,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.ВидДДС_ОстатокПлатежа КАК ВидДДС_ОстатокПлатежа,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.ВидДДС_ВозвратГарантийногоУдержания КАК ВидДДС_ВозвратГарантийногоУдержания,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.СтатьяБюджета_Аванс КАК СтатьяБюджета_Аванс,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.СтатьяБюджета_ПризнаниеДоходаРасхода КАК СтатьяБюджета_ПризнаниеДоходаРасхода,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.СтатьяБюджета_ОстатокПлатежа КАК СтатьяБюджета_ОстатокПлатежа,
	|	УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору.СтатьяБюджета_ВозвратГарантийногоУдержания КАК СтатьяБюджета_ВозвратГарантийногоУдержания
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	&ТабГрафик КАК УСОERP_ДоговорСЗаказчикомГрафикДвиженияПоДоговору
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.ВидДДС_Аванс КАК ВидДвиженияДенежныхСредств,
	|	ВрТаб.ДатаАванс КАК ДатаСобытия,
	|	ВрТаб.СуммаАванс КАК ОбщаяСумма,
	|	ВрТаб.СтатьяБюджета_Аванс КАК СтатьяБюджета
	|ПОМЕСТИТЬ ВрТабРезультат
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВрТаб.ВидДДС_ОстатокПлатежа,
	|	ВрТаб.ДатаОстатокПлатежа,
	|	ВрТаб.СуммаИтогоОстатокПлатежа,
	|	ВрТаб.СтатьяБюджета_ОстатокПлатежа
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВрТаб.ВидДДС_ВозвратГарантийногоУдержания,
	|	ВрТаб.ДатаВозвратГарантийногоУдержания,
	|	ВрТаб.СуммаВозвратГарантийногоУдержания,
	|	ВрТаб.СтатьяБюджета_ВозвратГарантийногоУдержания
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.ВидДвиженияДенежныхСредств КАК ВидДвиженияДенежныхСредств,
	|	ВложенныйЗапрос.ДатаСобытия КАК ДатаСобытия,
	|	ВложенныйЗапрос.ОбщаяСумма КАК ОбщаяСумма,
	|	ВложенныйЗапрос.СтатьяБюджета КАК СтатьяБюджета,
	|	ЗНАЧЕНИЕ(Перечисление.УСОERP_ПорядокДоходовРасходов.Реализация) КАК ВидДвиженияДоходРасход
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВрТабРезультат.ВидДвиженияДенежныхСредств КАК ВидДвиженияДенежныхСредств,
	|		ВрТабРезультат.ДатаСобытия КАК ДатаСобытия,
	|		СУММА(ВрТабРезультат.ОбщаяСумма) КАК ОбщаяСумма,
	|		ВрТабРезультат.СтатьяБюджета КАК СтатьяБюджета
	|	ИЗ
	|		ВрТабРезультат КАК ВрТабРезультат
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВрТабРезультат.ВидДвиженияДенежныхСредств,
	|		ВрТабРезультат.ДатаСобытия,
	|		ВрТабРезультат.СтатьяБюджета) КАК ВложенныйЗапрос
	|ГДЕ
	|	ВложенныйЗапрос.ОбщаяСумма > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСобытия";
	
	Объект.ГрафикДвиженияПоДоговору.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры  

&НаСервере
Функция СтруктураПараметрыФормы()											
	
	ПараметрыФормы 	= Новый Структура; 	
	
	ПараметрыФормы.Вставить("Отказ", Ложь); 		
	
	НайтиДополнительныеПараметрыПоДоговору(ПараметрыФормы); 	
	
	ПараметрыФормы.Вставить("ДополнительноеСоглашение", Ложь);
	
	Если ПараметрыФормы.Свойство("ДополнительныеПараметрыПоДоговору") И ЗначениеЗаполнено(ПараметрыФормы.ДополнительныеПараметрыПоДоговору.Ссылка) Тогда
		
		ДополнительныеПараметрыПоДоговору = ПараметрыФормы.ДополнительныеПараметрыПоДоговору.Ссылка;
		
		Если ДополнительныеПараметрыПоДоговору.ДополнительноеСоглашение И ЗначениеЗаполнено(ДополнительныеПараметрыПоДоговору.ДоговорРодитель) Тогда
			ПараметрыФормы.ДополнительноеСоглашение = Истина;
		КонецЕсли;
		
	КонецЕсли; 	
	
	Если ПараметрыФормы.ДополнительноеСоглашение Тогда
		НайтиГрафикДвиженийПоДоговору(ПараметрыФормы);
	КонецЕсли; 	
	
	ПараметрыФормы.Вставить("СоглашениеПоДоговору", Объект.Соглашение);
	
	ВидыДДСпоДоговорам 	= Новый Структура;
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		
		Если Объект.Договор.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем 
			ИЛИ Объект.Договор.ТипДоговора = Перечисления.ТипыДоговоров.СДавальцем Тогда
			
			ВидыДДСпоДоговорам.Вставить("Аванс", 						Перечисления.ВариантыОплатыКлиентом.АвансДоОбеспечения);
			ВидыДДСпоДоговорам.Вставить("ПриемРабот", 					Перечисления.УСОERP_ПорядокДоходовРасходов.Реализация);
			ВидыДДСпоДоговорам.Вставить("ОстатокПлатежа", 				Перечисления.ВариантыОплатыКлиентом.КредитПослеОтгрузки);
			ВидыДДСпоДоговорам.Вставить("ВозвратГарантийногоУдержания", Перечисления.ВариантыОплатыКлиентом.УСОERP_ГарантийноеУдержание);
			
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ВидыДДСпоДоговорам", ВидыДДСпоДоговорам);
	
	МассивТипов = Новый Массив();   
	
	Если Объект.Договор.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем 
		ИЛИ Объект.Договор.ТипДоговора = Перечисления.ТипыДоговоров.СДавальцем Тогда
		МассивТипов.Добавить(Тип("ПеречислениеСсылка.ВариантыОплатыКлиентом"));
	КонецЕсли;
	
	ПараметрыФормы.Вставить("МассивТипов", МассивТипов); 	
	
	ПараметрыФормы.Вставить("ВидПланирования", Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный);	
	
	Возврат ПараметрыФормы;
	
КонецФункции 

&НаСервере
Процедура 	НайтиДополнительныеПараметрыПоДоговору(ПараметрыФормы)		
	
	ДокументДопПараметры = УСОERP_МодификацияКонфигурации.ПолучитьДополнительныеПараметрыПоДоговору(Объект.Договор,Объект.ОбъектСтроительства,Объект.Дата,Истина,Объект.ДокументУтверждения);

	Если НЕ ЗначениеЗаполнено(ДокументДопПараметры) Тогда
		
		ПараметрыФормы.Вставить("Отказ", Истина);
		ПараметрыФормы.Вставить("ДополнительныеПараметрыПоДоговору", 	Документы.УСОERP_ДополнительныеПараметрыПоДоговору.ПустаяСсылка());	
			
	Иначе
		
		ДополнительныеПараметрыПоДоговору = Новый Структура;
		ДополнительныеПараметрыПоДоговору.Вставить("Ссылка", 							ДокументДопПараметры);
		ДополнительныеПараметрыПоДоговору.Вставить("ПоВидамРабот", 						ДокументДопПараметры.ПоВидамРабот ИЛИ ДокументДопПараметры.Детализация = 2);
		ДополнительныеПараметрыПоДоговору.Вставить("ПоРаботам", 						ДокументДопПараметры.ПоРаботам ИЛИ ДокументДопПараметры.Детализация = 1);
		ДополнительныеПараметрыПоДоговору.Вставить("СтатьяБюджетаБДР",					ДокументДопПараметры.СтатьяБюджетаБДР);
		ДополнительныеПараметрыПоДоговору.Вставить("СтатьяБДДСАвансовогоПлатежа",		ДокументДопПараметры.СтатьяБДДСАвансовогоПлатежа);
		ДополнительныеПараметрыПоДоговору.Вставить("СтатьяБДДСОсновногоПлатежа",		ДокументДопПараметры.СтатьяБДДСОсновногоПлатежа);
		ДополнительныеПараметрыПоДоговору.Вставить("СтатьяБДДСГарантийногоУдержания",	ДокументДопПараметры.СтатьяБДДСГарантийногоУдержания);
		
		ПараметрыФормы.Вставить("ДополнительныеПараметрыПоДоговору", 	ДополнительныеПараметрыПоДоговору);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура 	НайтиГрафикДвиженийПоДоговору(ПараметрыФормы)						
	
	ДополнительныеПараметрыПоДоговору = ПараметрыФормы.ДополнительныеПараметрыПоДоговору.Ссылка;
	Договор = ДополнительныеПараметрыПоДоговору.ДоговорРодитель;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УСОERP_ГрафикДвиженийПоДоговору.Ссылка КАК ГрафикДвиженийПоДоговору
		|ИЗ
		|	Документ.УСОERP_ГрафикДвиженийПоДоговору КАК УСОERP_ГрафикДвиженийПоДоговору
		|ГДЕ
		|	УСОERP_ГрафикДвиженийПоДоговору.Договор = &Договор
		|	И УСОERP_ГрафикДвиженийПоДоговору.Проведен
		//|	И НЕ УСОERP_ГрафикДвиженийПоДоговору.УСОERP_ВведенПодчиненныйГрафик
		|
		|УПОРЯДОЧИТЬ ПО
		|	УСОERP_ГрафикДвиженийПоДоговору.Дата УБЫВ";
	Запрос.УстановитьПараметр("Договор", 	Договор);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ПараметрыФормы.Вставить("ГрафикДвиженийПоДоговору", Выборка.ГрафикДвиженийПоДоговору);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура БазовыйГрафикДвиженияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если (Элемент.ТекущийЭлемент.Имя = "БазовыйГрафикДвиженияВидДвиженияДенежныхСредств"
		И НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.ВидДвиженияДенежныхСредств)) 
		ИЛИ (Элемент.ТекущийЭлемент.Имя = "БазовыйГрафикДвиженияВидДвиженияДоходРасход" 
		И НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.ВидДвиженияДоходРасход))  Тогда
		Элементы.БазовыйГрафикДвиженияВидДвиженияДоходРасход.ТолькоПросмотр 	= Ложь;
		Элементы.БазовыйГрафикДвиженияВидДвиженияДенежныхСредств.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	Если Элемент.ТекущийЭлемент.Имя = "БазовыйГрафикДвиженияВидДвиженияДенежныхСредств"
		И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ВидДвиженияДенежныхСредств) Тогда
		Элемент.ТекущиеДанные.СтатьяБюджета = СтатьюБюджетаПоДопПараметрамДоговора(Элемент.ТекущиеДанные.ВидДвиженияДенежныхСредств, ПараметрыФормы);
	ИначеЕсли Элемент.ТекущийЭлемент.Имя = "БазовыйГрафикДвиженияВидДвиженияДоходРасход"
		И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ВидДвиженияДоходРасход) Тогда
		Элемент.ТекущиеДанные.СтатьяБюджета = ПараметрыФормы.ДополнительныеПараметрыПоДоговору.СтатьяБюджетаБДР;
	КонецЕсли;

КонецПроцедуры 

&НаКлиенте
Процедура 	БазовыйГрафикДвиженияВидДвиженияДенежныхСредствПриИзменении(Элемент)
	
	Элементы.БазовыйГрафикДвиженияВидДвиженияДоходРасход.ТолькоПросмотр 	= Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура 	БазовыйГрафикДвиженияВидДвиженияДоходРасходПриИзменении(Элемент)	
	
	Элементы.БазовыйГрафикДвиженияВидДвиженияДенежныхСредств.ТолькоПросмотр = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура 	БазовыйГрафикДвиженияПослеУдаления(Элемент)							
	
	Элементы.БазовыйГрафикДвиженияВидДвиженияДоходРасход.ТолькоПросмотр 	= Ложь;
	Элементы.БазовыйГрафикДвиженияВидДвиженияДенежныхСредств.ТолькоПросмотр = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура 	БазовыйГрафикДвиженияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)		
	
	Элементы.БазовыйГрафикДвиженияВидДвиженияДоходРасход.ТолькоПросмотр 	= Ложь;
	Элементы.БазовыйГрафикДвиженияВидДвиженияДенежныхСредств.ТолькоПросмотр = Ложь;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция 	СтатьюБюджетаПоДопПараметрамДоговора(ВидДДС, ПараметрыФормы)		
	
	Если ВидДДС = Перечисления.ВариантыОплатыКлиентом.АвансДоОбеспечения 
		//ИЛИ ВидДДС = Перечисления.ВариантыОплатыПоставщику.АвансДоПодтверждения 
		ИЛИ ВидДДС = Перечисления.ВариантыОплатыКлиентом.ПредоплатаДоОтгрузки 
	//	ИЛИ ВидДДС = Перечисления.ВариантыОплатыПоставщику.ПредоплатаДоПоступления 
		Тогда
		
		Возврат ПараметрыФормы.ДополнительныеПараметрыПоДоговору.СтатьяБДДСАвансовогоПлатежа;
		
	ИначеЕсли ВидДДС = Перечисления.ВариантыОплатыКлиентом.КредитПослеОтгрузки Тогда
	//	ИЛИ ВидДДС = Перечисления.ВариантыОплатыПоставщику.КредитПослеПоступления Тогда
		
		Возврат ПараметрыФормы.ДополнительныеПараметрыПоДоговору.СтатьяБДДСОсновногоПлатежа;
		
	ИначеЕсли ВидДДС = Перечисления.ВариантыОплатыКлиентом.УСОERP_ГарантийноеУдержание Тогда
		//ИЛИ ВидДДС = Перечисления.ВариантыОплатыПоставщику.УСОERP_ГарантийноеУдержание Тогда
		
		Возврат ПараметрыФормы.ДополнительныеПараметрыПоДоговору.СтатьяБДДСГарантийногоУдержания;
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура	УСОERP_РасширенныйГрафикДвиженийПриИзменении(Элемент)					
	
	ВидыДДСпоДоговорам 	= ПараметрыФормы.ВидыДДСпоДоговорам;
	
	Если НЕ ЗначениеЗаполнено(ВидыДДСпоДоговорам) Тогда
		
		Объект.УСОERP_РасширенныйГрафикДвижений = Ложь;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст 	= "Для ввода расширенного графика договор: " + Элементы.НаименованиеДоговор.Заголовок + 
							" должен иметь один из типов:"  
							//+ Символы.ПС + """С поставщиком""," 
							//+ Символы.ПС + """С переработчиком""," 
							+ Символы.ПС + """C давальцем"" либо" 
							+ Символы.ПС + """С покупателем"".";
		Сообщение.Сообщить();
		
	ИначеЕсли Объект.ГрафикДвиженияПоДоговору.Количество() <> 0 Тогда
		
		ОбработкаПользовательскогоВыбора_ОчисткаТЧ();
				
	КонецЕсли;
		
	ОбновитьФормуНаСервере(ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура 	РасширенныйГрафикДвиженияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)							
		
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ВидыДДСпоДоговорам 	= ПараметрыФормы.ВидыДДСпоДоговорам;
		
		Элемент.ТекущиеДанные.ВидДДС_Аванс 								= ВидыДДСпоДоговорам.Аванс;
		Элемент.ТекущиеДанные.ВидДДС_ПризнаниеДоходаРасхода 			= ВидыДДСпоДоговорам.ПриемРабот;
		Элемент.ТекущиеДанные.ВидДДС_ОстатокПлатежа 					= ВидыДДСпоДоговорам.ОстатокПлатежа;
		Элемент.ТекущиеДанные.ВидДДС_ВозвратГарантийногоУдержания 		= ВидыДДСпоДоговорам.ВозвратГарантийногоУдержания;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура 	РасширенныйГрафикДвиженияРаботаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)					
	
КонецПроцедуры

&НаКлиенте
Процедура 	ОбработкаПользовательскогоВыбора_ОчисткаТЧ()						
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ОбработкаПользовательскогоВыбора_ОчисткаТЧЗавершение", ЭтотОбъект), "При смене режима ввода графика движений по договору таблица движений будет очищена.", РежимДиалогаВопрос.ОКОтмена);
	
КонецПроцедуры

&НаКлиенте
Процедура 	ОбработкаПользовательскогоВыбора_ОчисткаТЧЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт		
    
    Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.ОК Тогда
		Объект.ГрафикДвиженияПоДоговору.Очистить();
	Иначе
		Объект.УСОERP_РасширенныйГрафикДвижений = НЕ Объект.УСОERP_РасширенныйГрафикДвижений;
	КонецЕсли;
	
	ОбновитьФормуНаСервере(ПараметрыФормы);
    
КонецПроцедуры

&НаСервере
Процедура 	ОбновитьФормуНаСервере(ПараметрыФормы)								
		
	Элементы.БазовыйГрафикДвижения.Видимость 		= НЕ Объект.УСОERP_РасширенныйГрафикДвижений;
	Элементы.БазовыйГрафикДвижения.Доступность 		= НЕ Объект.УСОERP_РасширенныйГрафикДвижений;
	
	Элементы.РасширенныйГрафикДвижения.Видимость 	= Объект.УСОERP_РасширенныйГрафикДвижений;
	Элементы.РасширенныйГрафикДвижения.Доступность 	= Объект.УСОERP_РасширенныйГрафикДвижений;
	
	Если ПараметрыФормы.Свойство("ДополнительныеПараметрыПоДоговору") И ЗначениеЗаполнено(ПараметрыФормы.ДополнительныеПараметрыПоДоговору.Ссылка) Тогда
		Объект.ОбъектСтроительства = ПараметрыФормы.ДополнительныеПараметрыПоДоговору.Ссылка.ОбъектСтроительства;
	КонецЕсли;
				
КонецПроцедуры

&НаКлиенте
Процедура 	ОбновитьФормуНаКлиенте()
	
	Если ПараметрыФормы.Отказ Тогда
		
		Элементы.ГруппаГрафик.Видимость = Ложь;
		
		Если Объект.ГрафикДвиженияПоДоговору.Количество() Тогда
			Объект.ГрафикДвиженияПоДоговору.Очистить();
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаГрафик.Видимость = Истина; 
	
	МассивТипов 		= ПараметрыФормы.МассивТипов;
	
	Элементы.БазовыйГрафикДвиженияВидДвиженияДенежныхСредств.ОграничениеТипа = Новый ОписаниеТипов(МассивТипов);
	
	Элементы.РасширенныйГрафикДвиженияВидРабот.Видимость 	= ПараметрыФормы.ДополнительныеПараметрыПоДоговору.ПоВидамРабот;
	Элементы.РасширенныйГрафикДвиженияГруппаРаботаКодСДР.Видимость 		= ПараметрыФормы.ДополнительныеПараметрыПоДоговору.ПоРаботам;
		
	ОбновитьФормуНаСервере(ПараметрыФормы);
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьСтоимостиПоБюджетуНаСервере(БюджетСтроительства)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("БюджетСтроительства",БюджетСтроительства);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_БюджетСтроительстваРасценка.Работа КАК Работа,
	|	УСОERP_БюджетСтроительстваРасценка.СтоимостьСУчетомНакладныхРасходов КАК СуммаСНДС,
	|	УСОERP_БюджетСтроительстваРасценка.СуммаНДС КАК СуммаНДС,
	|	УСОERP_БюджетСтроительстваРасценка.Ссылка.СтавкаНДС КАК СтавкаНДС
	|ИЗ
	|	Документ.УСОERP_БюджетСтроительства.Расценка КАК УСОERP_БюджетСтроительстваРасценка
	|ГДЕ
	|	УСОERP_БюджетСтроительстваРасценка.Ссылка = &БюджетСтроительства
	|	И НЕ УСОERP_БюджетСтроительстваРасценка.Работа.СуммарнаяРабота";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДеревоРабот = РеквизитФормыВЗначение("РаботыДеревоЗначений");
	
	Пока Выборка.Следующий() Цикл
		
		Строки = ДеревоРабот.Строки.НайтиСтроки(Новый Структура("Работа",Выборка.Работа),Истина);
		
		Для Каждого НайденнаяСтрока ИЗ Строки Цикл
			
			ЗаполнитьЗначенияСвойств(НайденнаяСтрока,Выборка,"СуммаСНДС,СуммаНДС,СтавкаНДС");
			
			Если НайденнаяСтрока.СтавкаНДС  = Перечисления.СтавкиНДС.ПустаяСсылка() Тогда
				НайденнаяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
			КонецЕсли;
			
			Если НайденнаяСтрока.СуммаНДС = 0 Тогда
				НайденнаяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(НайденнаяСтрока.СуммаСНДС, НайденнаяСтрока.СтавкаНДС, Истина);
			КонецЕсли; 		
			
		КонецЦикла; 	
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоРабот,"РаботыДеревоЗначений");	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтоимостиПоБюджету(Команда)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Организация",Объект.Организация);
	СтруктураОтбора.Вставить("ОбъектСтроительства",Объект.ОбъектСтроительства);
	СтруктураОтбора.Вставить("Проведен",Истина);
	
	Если НовыйВариант Тогда
		
		СтруктураОтбора.Вставить("ДокументОснование",Объект.ДокументУтверждения);
		
	КонецЕсли;
	
	ОткрытьФорму("Документ.УСОERP_БюджетСтроительства.Форма.ФормаВыбора",Новый Структура("Отбор",СтруктураОтбора),ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура РаботыДеревоЗначенийПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботЗаказчикаПослеУдаления(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботЗаказчикаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура РасширенныйГрафикДвиженияРаботаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЭтоСуммарнаяРабота(ВыбранноеЗначение) Тогда
		
		СтандартнаяОбработка = Ложь;	
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоСуммарнаяРабота(Работа) 
	
	Если ТипЗнч(Работа) = Тип("Массив") Тогда
		
		Если НЕ Работа.Количество() Тогда
			Возврат Истина;
			
		КонецЕсли;
		
		Возврат Работа.Получить(0).СуммарнаяРабота;
		
	Иначе
		
		Возврат Работа.СуммарнаяРабота;
		
	КонецЕсли;	
	
КонецФункции 

&НаСервереБезКонтекста
Функция ЭтоНовыйВариант(Документ) 
	
	Возврат Документ.СценарийПланирования.НовыйВариант;
	
КонецФункции 

&НаКлиенте
Процедура ОбъектСтроительстваПриИзменении(Элемент)	
	
	Если Объект.ОбъектСтроительства = ТекущийОбъектСтроительства Тогда
		Объект.ДокументУтверждения = ТекущийДокументУтверждения;
		Возврат;
	КонецЕсли;
		
	Если (Объект.ГрафикДвиженияПоДоговору.Количество()+Объект.Работы.Количество()+Объект.РаботыЗаказчика.Количество()) И (Объект.ОбъектСтроительства <> ТекущийОбъектСтроительства ИЛИ Объект.ДокументУтверждения <> ТекущийДокументУтверждения) Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбъектСтроительстваПриИзмененииПродолжение",ЭтотОбъект);
		
		ПоказатьВопрос(ОписаниеОповещения,"Табличные части будут очищены, продолжить?",РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ОбъектСтроительстваПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);  		
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектСтроительстваПриИзмененииПродолжение (Ответ,ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Объект.ОбъектСтроительства = ТекущийОбъектСтроительства;
		Объект.ДокументУтверждения = ТекущийДокументУтверждения;
		Возврат;
		
	КонецЕсли;
	
	ОбъектСтроительстваПриИзмененииНаСервере(); 
	
	ПараметрыФормы = СтруктураПараметрыФормы();		
	ОбновитьФормуНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура ОбъектСтроительстваПриИзмененииНаСервере(ПодбиратьДокументУтверждения = Истина)
	
	Объект.ГрафикДвиженияПоДоговору.Очистить();
	Объект.Работы.Очистить();
	РаботыДеревоЗначений.ПолучитьЭлементы().Очистить();
	
	Если ПодбиратьДокументУтверждения Тогда
		
		Объект.ДокументУтверждения = УСОERP_ЗащищенныеФункцииСервер.ПолучитьПоследнийДокументУтверждения(Объект.ОбъектСтроительства,Объект.Организация);
		
	КонецЕсли;
	
	ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;
	ТекущийДокументУтверждения = Объект.ДокументУтверждения; 
	НовыйВариант = Объект.ДокументУтверждения.СценарийПланирования.НовыйВариант;
	Объект.НаправлениеДеятельности = Объект.ДокументУтверждения.НаправлениеДеятельности;
	
КонецПроцедуры 

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	КонтрагентПриИзмененииСервер();
	
	ПараметрыФормы = СтруктураПараметрыФормы();		
	ОбновитьФормуНаКлиенте(); 

КонецПроцедуры  

&НаСервере
Процедура  КонтрагентПриИзмененииСервер()
	
	ДопПараметры = ЗакупкиСервер.ДополнительныеПараметрыОтбораДоговоров();
	ДопПараметры.ВалютаВзаиморасчетов = Объект.Валюта;
	ДопПараметры.НаправлениеДеятельности = Объект.НаправлениеДеятельности;
	Объект.Договор = ПродажиСервер.ПолучитьДоговорПоУмолчанию(Объект,Перечисления.ХозяйственныеОперации.РеализацияКлиенту,Объект.Валюта,Объект.НаправлениеДеятельности);
	
	ТекущийДоговор = Объект.Договор;
		
КонецПроцедуры 		

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если Объект.Организация <> ТекущаяОрганизация И ЗначениеЗаполнено(ТекущаяОрганизация) Тогда
		
		Если Объект.Работы.Количество()+Объект.ГрафикДвиженияПоДоговору.Количество() Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ОрганизацияПриИзмененииПродолжение",ЭтотОбъект);
			
			ПоказатьВопрос(ОписаниеОповещения,"Табличные части будут очищены,продолжить?",РежимДиалогаВопрос.ДаНет);
			
		Иначе
			
			ОрганизацияПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
			
		КонецЕсли;  		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзмененииПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Объект.Организация = ТекущаяОрганизация;
		Объект.Договор = ТекущийДоговор;
		Объект.ДокументУтверждения = ТекущийДокументУтверждения;
		Возврат;
		
	КонецЕсли;
	
	ОрганизацияПриИзмененииНаСервере();
	ПараметрыФормы = СтруктураПараметрыФормы();		
	ОбновитьФормуНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	Объект.Работы.Очистить();
	Объект.ГрафикДвиженияПоДоговору.Очистить();
	РаботыДеревоЗначений.ПолучитьЭлементы().Очистить();
	Объект.ДокументУтверждения = УСОERP_ЗащищенныеФункцииСервер.ПолучитьПоследнийДокументУтверждения(Объект.ОбъектСтроительства,Объект.Организация,,Объект.Дата);
	
	ТекущаяОрганизация         = Объект.Организация;
	ТекущийДоговор             = Объект.Договор;
	ТекущийДокументУтверждения = Объект.ДокументУтверждения; 
		
КонецПроцедуры

&НаКлиенте
Процедура СценарийПланированияПриИзменении(Элемент)
	
	ДеревоРаботЗаказчика.ПолучитьЭлементы().Очистить();
	Объект.РаботыЗаказчика.Очистить();
	
	Если ЗначениеЗаполнено(Объект.СценарийПланирования) И РаботыДеревоЗначений.ПолучитьЭлементы().Количество() Тогда
		ЗаполнитьРаботыЗаказчика(Истина);
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьПоДокументуНаСервере(ДокументЗаполнения)
	
	ТабличнаяЧастьРаботы = Объект.Работы;
	ТабличнаяЧастьРаботы.Очистить();
	РеквизитРаботыДеревоЗначений = РеквизитФормыВЗначение("РаботыДеревоЗначений", Тип("ДеревоЗначений"));	
	ЗаполнитьТабличнуюЧастьИзДереваЗначений(РеквизитРаботыДеревоЗначений, ТабличнаяЧастьРаботы, 0, Ложь); 		
	
	ТЗ = Объект.Работы.Выгрузить();
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДокументЗаполнения",ДокументЗаполнения);
	Запрос.УстановитьПараметр("ТЗ",ТЗ);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ДоговорСЗаказчикомРаботы.Работа КАК Работа,
	|	УСОERP_ДоговорСЗаказчикомРаботы.СуммаСНДС КАК СуммаСНДС,
	|	УСОERP_ДоговорСЗаказчикомРаботы.СтавкаНДС КАК СтавкаНДС,
	|	УСОERP_ДоговорСЗаказчикомРаботы.СуммаНДС КАК СуммаНДС
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	Документ.УСОERP_ДоговорСЗаказчиком.Работы КАК УСОERP_ДоговорСЗаказчикомРаботы
	|ГДЕ
	|	УСОERP_ДоговорСЗаказчикомРаботы.Ссылка = &ДокументЗаполнения
	|	И НЕ УСОERP_ДоговорСЗаказчикомРаботы.Работа.СуммарнаяРабота
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_ДоговорСЗаказчикомРаботы.КодСДР КАК КодСДР,
	|	ВЫРАЗИТЬ(УСОERP_ДоговорСЗаказчикомРаботы.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	УСОERP_ДоговорСЗаказчикомРаботы.Объем КАК Объем,
	|	УСОERP_ДоговорСЗаказчикомРаботы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	УСОERP_ДоговорСЗаказчикомРаботы.ДатаНачала КАК ДатаНачала,
	|	УСОERP_ДоговорСЗаказчикомРаботы.ДатаОкончания КАК ДатаОкончания,
	|	УСОERP_ДоговорСЗаказчикомРаботы.Длительность КАК Длительность,
	|	УСОERP_ДоговорСЗаказчикомРаботы.ЕдиницаДлительности КАК ЕдиницаДлительности,
	|	УСОERP_ДоговорСЗаказчикомРаботы.СуммаСНДС КАК СуммаСНДС,
	|	УСОERP_ДоговорСЗаказчикомРаботы.СтавкаНДС КАК СтавкаНДС,
	|	УСОERP_ДоговорСЗаказчикомРаботы.СуммаНДС КАК СуммаНДС
	|ПОМЕСТИТЬ ТаблицаРабот
	|ИЗ
	|	&ТЗ КАК УСОERP_ДоговорСЗаказчикомРаботы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаРабот.КодСДР КАК КодСДР,
	|	ТаблицаРабот.Работа КАК Работа,
	|	ТаблицаРабот.Объем КАК Объем,
	|	ТаблицаРабот.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТаблицаРабот.ДатаНачала КАК ДатаНачала,
	|	ТаблицаРабот.ДатаОкончания КАК ДатаОкончания,
	|	ТаблицаРабот.Длительность КАК Длительность,
	|	ТаблицаРабот.ЕдиницаДлительности КАК ЕдиницаДлительности,
	|	isnull(ВрТаб.СуммаСНДС,ТаблицаРабот.СуммаСНДС) КАК СуммаСНДС,
	|	isnull(ВрТаб.СтавкаНДС,ТаблицаРабот.СтавкаНДС) КАК СтавкаНДС,
	|	isnull(ВрТаб.СуммаНДС,ТаблицаРабот.СуммаНДС) КАК СуммаНДС
	|ИЗ
	|	ТаблицаРабот КАК ТаблицаРабот
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТаб КАК ВрТаб
	|		ПО ТаблицаРабот.Работа.РаботаИсточник = ВрТаб.Работа.РаботаИсточник
	|			И ТаблицаРабот.Работа.ОбъемРаботы = ВрТаб.Работа.ОбъемРаботы
	|			И ТаблицаРабот.Работа.ЕдиницаОбъема = ВрТаб.Работа.ЕдиницаОбъема";
	
	Объект.Работы.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ПриОткрытииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДокументу(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПоДокументуПродолжение",ЭтотОбъект);
	ОтборФормы = Новый Структура("ОбъектСтроительства,Проведен",Объект.ОбъектСтроительства,Истина);
	ДопПараметры = Новый Структура("Отбор",ОтборФормы);
	ОткрытьФорму("Документ.УСОERP_ДоговорСЗаказчиком.Форма.ФормаВыбора",ДопПараметры,ЭтотОбъект,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
