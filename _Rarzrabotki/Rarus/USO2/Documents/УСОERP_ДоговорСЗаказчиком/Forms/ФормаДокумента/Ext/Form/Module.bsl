
&НаКлиенте
Перем КэшированныеЗначения; //используется механизмом обработки изменения реквизитов ТЧ
&НаКлиенте
Перем ПараметрыФормы;

#Область ПриИзмененииРеквизитов

&НаКлиенте
Процедура РаботыДеревоЗначенийПередНачаломИзменения(Элемент, Отказ)
	Если Элементы.РаботыДеревоЗначений.ТекущиеДанные.ПолучитьЭлементы().Количество() > 0 Тогда
		Отказ = Истина;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	Если Объект.Договор <> ТекущийДоговор И ЗначениеЗаполнено(ТекущийДоговор) И Объект.ГрафикДвиженияПоДоговору.Количество() Тогда 		
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ДоговорПриИзмененииПродолжение",ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения,"Таб.часть ""График движения по договору"" будет очищена, продолжить?",РежимДиалогаВопрос.ДаНет);
		
	Иначе 		
		
		ДоговорПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);  	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзмененииПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Объект.Договор = ТекущийДоговор;
		Возврат;
	КонецЕсли;
	
	ДоговорПриИзмененииНаСервере();
	ПараметрыФормы = СтруктураПараметрыФормы();	
	ОбновитьФормуНаКлиенте(); 
	
КонецПроцедуры

&НаСервере
Процедура ДоговорПриИзмененииНаСервере()
	
	Объект.ДатаДоговора = Объект.Договор.Дата;
	Объект.НомерДоговора = Объект.Договор.Номер;
	Объект.НаправлениеДеятельности = Объект.Договор.НаправлениеДеятельности;
	
	Объект.ГрафикДвиженияПоДоговору.Очистить(); 	
	ТекущийДоговор = Объект.Договор;
	
КонецПроцедуры

&НаКлиенте
Процедура СоглашениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
		
	ПараметрыВыбораСоглашения = ПродажиКлиент.ПараметрыНачалаВыбораСоглашенияСКлиентом();
	
	ПараметрыВыбораСоглашения.Элемент                     = Элемент;
	ПараметрыВыбораСоглашения.Партнер                     = Объект.Партнер;
	ПараметрыВыбораСоглашения.Документ                    = Объект.Соглашение;
	ПараметрыВыбораСоглашения.ДатаДокумента               = Объект.Дата;
	ПараметрыВыбораСоглашения.ХозяйственнаяОперация       = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РеализацияКлиенту");
	ПараметрыВыбораСоглашения.ДанныеФормыСтруктура        = Объект;
	
	ПродажиКлиент.НачалоВыбораСоглашенияСКлиентом(ПараметрыВыбораСоглашения, СтандартнаяОбработка);	
	
КонецПроцедуры

&НаКлиенте
Процедура РаботыДеревоЗначенийПередУдалением(Элемент, Отказ)
	
	Если НовыйВариант Тогда
		
		Отказ = Истина;
		
	Иначе  		
		
		ТекущаяСтрока = Элемент.ТекущиеДанные;
		
		УдаляемаяСтрока = Элемент.ТекущиеДанные;
		
		Пока ТекущаяСтрока.ПолучитьРодителя() <> Неопределено Цикл
			
			Родитель =  ТекущаяСтрока.ПолучитьРодителя();
			Родитель.СуммаСНДС = Родитель.СуммаСНДС - УдаляемаяСтрока.СуммаСНДС;
			
			Если Не ЗначениеЗаполнено(Родитель.СтавкаНДС) Тогда
				Родитель.СтавкаНДС = УдаляемаяСтрока.СтавкаНДС;
			КонецЕсли;		
			
			Родитель.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(Родитель.СуммаСНДС, Родитель.СтавкаНДС, Истина);
			
			ТекущаяСтрока = Родитель;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура СуммаСНДСПриИзменении(Элемент)
	
	РассчитатьИтоговыеПоказатели();
	
КонецПроцедуры

&НаКлиенте
Процедура РаботыДеревоЗначенийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

   Отказ = Истина;
   
КонецПроцедуры

&НаКлиенте
Процедура СуммаСНДСОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.РаботыДеревоЗначений.ТекущиеДанные;	

	СуммаСНДСДоИзменения = ?(ЗначениеЗаполнено(ТекущаяСтрока.СуммаСНДС), ТекущаяСтрока.СуммаСНДС, 0);
	СуммаСНДСПослеИзменения = ?(ЗначениеЗаполнено(ВыбранноеЗначение), ВыбранноеЗначение, 0);   	
	
	ТекущаяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СуммаСНДСПослеИзменения, ТекущаяСтрока.СтавкаНДС, Истина);
	
	РассчитатьИтоговыеПоказателиРодителей(ТекущаяСтрока, СуммаСНДСПослеИзменения - СуммаСНДСДоИзменения);
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаСНДСОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.РаботыДеревоЗначений.ТекущиеДанные;	
	
	СуммаСНДСДоИзменения = ?(ЗначениеЗаполнено(ТекущаяСтрока.СуммаСНДС), ТекущаяСтрока.СуммаСНДС, 0);
	СуммаСНДСПослеИзменения = ?(ЗначениеЗаполнено(Текст), Число(Текст), 0); 	
	
	ТекущаяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СуммаСНДСПослеИзменения, ТекущаяСтрока.СтавкаНДС, Истина);
	
	РассчитатьИтоговыеПоказателиРодителей(ТекущаяСтрока, СуммаСНДСПослеИзменения - СуммаСНДСДоИзменения);
	
	#Если ВебКлиент Тогда
		Элементы.РаботыДеревоЗначений.ТекущиеДанные.СуммаСНДС = СуммаСНДСПослеИзменения;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура РаботаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектСтроительства", Объект.ОбъектСтроительства);
	ПараметрыОтбора.Вставить("МножественныйВыбор", 	Ложь);
	ПараметрыОтбора.Вставить("Организация", 		Объект.Организация);
	ПараметрыОтбора.Вставить("ПометкаУдаления", 	Ложь);
	ПараметрыОтбора.Вставить("Утверждена", 			Истина);
	
	Форма = ПолучитьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаПодбора", ПараметрыОтбора, Элемент);	
	Форма.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура РаботаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.РаботыДеревоЗначений.ТекущиеДанные;
	СписокПараметровРаботы = ПолучитьПараметрыВыполненияРаботы(ВыбранноеЗначение); 
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СписокПараметровРаботы); 
	РассчитатьИтоговыеПоказатели();
	
КонецПроцедуры

&НаКлиенте
Процедура СтавкаНДСПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.РаботыДеревоЗначений.ТекущиеДанные;
	
	ТекущаяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(ТекущаяСтрока.СуммаСНДС, ТекущаяСтрока.СтавкаНДС, Истина);
	РассчитатьИтоговыеПоказателиРодителей(ТекущаяСтрока, 0);
	РассчитатьИтоговыеПоказатели();
	
КонецПроцедуры

