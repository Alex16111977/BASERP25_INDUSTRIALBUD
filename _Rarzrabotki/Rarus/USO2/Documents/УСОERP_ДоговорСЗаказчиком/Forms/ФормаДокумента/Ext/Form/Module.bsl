Процедура ДеревоРаботЗаказчикаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр) 
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботЗаказчикаПередНачаломИзменения(Элемент, Отказ)
	
	Если Элементы.ДеревоРаботЗаказчика.ТекущиеДанные.ПолучитьЭлементы().Количество() > 0 Тогда
		Отказ = Истина;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботЗаказчикаПередУдалением(Элемент, Отказ)
	
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	
	УдаляемаяСтрока = Элемент.ТекущиеДанные;
	
	Пока ТекущаяСтрока.ПолучитьРодителя() <> Неопределено Цикл
		
		Родитель =  ТекущаяСтрока.ПолучитьРодителя();
		Родитель.СуммаСНДС = Родитель.СуммаСНДС - УдаляемаяСтрока.СуммаСНДС;
		
		Если Не ЗначениеЗаполнено(Родитель.СтавкаНДС) Тогда
			Родитель.СтавкаНДС = УдаляемаяСтрока.СтавкаНДС;
		КонецЕсли;
		
		Родитель.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(Родитель.СуммаСНДС, Родитель.СтавкаНДС, Истина);
		
		ТекущаяСтрока = Родитель;
		
	КонецЦикла;	
	
	РассчитатьИтоговыеПоказатели();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботЗаказчикаСуммаСНДСПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ДеревоРаботЗаказчика.ТекущиеДанные;
	
	ТекущаяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(ТекущаяСтрока.СуммаСНДС, ТекущаяСтрока.СтавкаНДС, Истина);
	
    РассчитатьИтоговыеПоказателиЭтапаЗаказчика(ТекущаяСтрока);
	РассчитатьИтоговыеПоказатели();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьИтоговыеПоказателиЭтапаЗаказчика(СтрокаДереваРабот)
	
	РодительСтроки = СтрокаДереваРабот.ПолучитьРодителя();
	
	Пока Не РодительСтроки = Неопределено Цикл
		
		РодительСтроки.СуммаСНДС = 0;
		РодительСтроки.СуммаНДС = 0;
		СтрокиРабот = РодительСтроки.ПолучитьЭлементы();
		
		Для Каждого СтрокаРабота Из СтрокиРабот Цикл
			РодительСтроки.СуммаСНДС = РодительСтроки.СуммаСНДС + СтрокаРабота.СуммаСНДС;
			РодительСтроки.СуммаНДС = РодительСтроки.СуммаНДС + СтрокаРабота.СуммаНДС;
		КонецЦикла;
		
		РодительСтроки = РодительСтроки.ПолучитьРодителя();
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботЗаказчикаСтавкаНДСПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ДеревоРаботЗаказчика.ТекущиеДанные;
	ТекущаяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(ТекущаяСтрока.СуммаСНДС, ТекущаяСтрока.СтавкаНДС, Истина);
	РассчитатьИтоговыеПоказателиЭтапаЗаказчика(ТекущаяСтрока);
	РассчитатьИтоговыеПоказатели();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнятьРаботамиЗаказчикаПриИзменении(Элемент)
	
	СуммаВсего_ПоЗаказчику = 0;
	СуммаНДС_ПоЗаказчику   = 0;
	НастроитьВидимостьЗакладкиРаботЗаказчика();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства

	ЗаполнитьДеревоРаботЗаказчикаПриСоздании();
	НастроитьВидимостьЗакладкиРаботЗаказчика();
	НовыйВариант = Объект.ДокументУтверждения.СценарийПланирования.НовыйВариант = Истина;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды   
		
	СобытияФорм.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
	ТекущийДокументУтверждения = Объект.ДокументУтверждения;
	ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;
	ТекущийДоговор             = Объект.Договор;
	ТекущийКонтрагент          = Объект.Контрагент;
	ТекущаяОрганизация         = Объект.Организация;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Не ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		
		ДеревоРабот = РеквизитФормыВЗначение("ДеревоРаботЗаказчика");
		РаботыЗаказчика = ТекущийОбъект.РаботыЗаказчика;
		РаботыЗаказчика.Очистить();
		ЗаполнитьРаботыЗаказчикаПередЗаписью(ДеревоРабот, РаботыЗаказчика);
		
		
		ТабличнаяЧастьРаботы = ТекущийОбъект.Работы;
		ТабличнаяЧастьРаботы.Очистить();
		РеквизитРаботыДеревоЗначений = РеквизитФормыВЗначение("РаботыДеревоЗначений", Тип("ДеревоЗначений"));	
		ЗаполнитьТабличнуюЧастьИзДереваЗначений(РеквизитРаботыДеревоЗначений, ТабличнаяЧастьРаботы, 0, Отказ); 		
		
		// Проверить заполнение договора. В случае отсутствия - подобрать или создать
		
		Если Не ЗначениеЗаполнено(Объект.Договор) Тогда
			
			СтруктураРеквизитовДоговора = Новый Структура;
			СтруктураРеквизитовДоговора.Вставить("Контрагент", Объект.Контрагент);
			СтруктураРеквизитовДоговора.Вставить("НомерДоговора", Объект.НомерДоговора);
			СтруктураРеквизитовДоговора.Вставить("ДатаДоговора", Объект.ДатаДоговора);
			СтруктураРеквизитовДоговора.Вставить("Проект", Объект.ОбъектСтроительства);
			СтруктураРеквизитовДоговора.Вставить("Организация", Объект.Организация);
			СтруктураРеквизитовДоговора.Вставить("Партнер", Объект.Партнер);
			СтруктураРеквизитовДоговора.Вставить("Соглашение", Объект.Соглашение);
			ТекущийДоговор = ПодобратьДоговорКонтрагента(СтруктураРеквизитовДоговора);	
			
			Если Не ЗначениеЗаполнено(ТекущийДоговор) Тогда
				ТекущийОбъект.Договор = СоздатьДоговорКонтрагента(СтруктураРеквизитовДоговора, Отказ);
			Иначе 
				ТекущийОбъект.Договор = ТекущийДоговор;
			КонецЕсли;	   
			
		КонецЕсли;
		
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства 	
	
	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПриОткрытииНаСервере();
	РассчитатьИтоговыеПоказатели();
	
	ПараметрыФормы = СтруктураПараметрыФормы();	
	ОбновитьФормуНаКлиенте();
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды  
	
КонецПроцедуры

&НаСервере
Процедура ПриОткрытииНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТабличнаяЧастьРаботы.КодСДР,
		|	ТабличнаяЧастьРаботы.Работа,
		|	ТабличнаяЧастьРаботы.Объем,
		|	ТабличнаяЧастьРаботы.ЕдиницаОбъема,
		|	ТабличнаяЧастьРаботы.ДатаНачала,
		|	ТабличнаяЧастьРаботы.ДатаОкончания,
		|	ТабличнаяЧастьРаботы.Длительность,
		|	ТабличнаяЧастьРаботы.ЕдиницаДлительности,
		|	ТабличнаяЧастьРаботы.СуммаСНДС,
		|	ТабличнаяЧастьРаботы.СтавкаНДС,
		|	ТабличнаяЧастьРаботы.СуммаНДС
		|ПОМЕСТИТЬ ВременнаяТаблицаРаботы
		|ИЗ
		|	&ТабличнаяЧастьРаботы КАК ТабличнаяЧастьРаботы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВременнаяТаблицаРаботы.КодСДР КАК КодСДР,
		|	УСОERP_СтроительныеРаботы.Ссылка КАК Работа,
		|	УСОERP_СтроительныеРаботы.Ссылка.Родитель КАК РаботаРодитель,
		|	УСОERP_СтроительныеРаботы.Ссылка.СуммарнаяРабота КАК СуммарнаяРабота,
		|	ВременнаяТаблицаРаботы.Объем,
		|	ВременнаяТаблицаРаботы.ЕдиницаОбъема,
		|	ВременнаяТаблицаРаботы.ДатаНачала,
		|	ВременнаяТаблицаРаботы.ДатаОкончания,
		|	ВременнаяТаблицаРаботы.Длительность,
		|	ВременнаяТаблицаРаботы.ЕдиницаДлительности,
		|	ВременнаяТаблицаРаботы.СуммаСНДС,
		|	ВременнаяТаблицаРаботы.СтавкаНДС,
		|	ВременнаяТаблицаРаботы.СуммаНДС
		|ИЗ
		|	ВременнаяТаблицаРаботы КАК ВременнаяТаблицаРаботы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
		|		ПО ВременнаяТаблицаРаботы.Работа = УСОERP_СтроительныеРаботы.Ссылка
		|ГДЕ
		|	ВременнаяТаблицаРаботы.Работа В(&МассивРабот)
		|
		|УПОРЯДОЧИТЬ ПО
		|	УСОERP_СтроительныеРаботы.Ссылка ИЕРАРХИЯ,
		|	КодСДР";
		
		Запрос.УстановитьПараметр("МассивРабот", Объект.Работы.Выгрузить(,"Работа"));
		Запрос.УстановитьПараметр("ТабличнаяЧастьРаботы", Объект.Работы.Выгрузить());
		
		ДанныеДляДерева = Запрос.Выполнить().Выгрузить();
		ДеревоРабот = УСОERP_ОбработкаТабличныхЧастей.УСОERP_ПодготовитьДанныеИСформироватьДеревоСВосстановлениемСтруктуры(ДанныеДляДерева,"Работа","РаботаРодитель",,Справочники.УСОERP_СтроительныеРаботы);		
				
		ВремРодноеДерево = РеквизитФормыВЗначение("РаботыДеревоЗначений"); // берется родная структура с родной типизацией
		ВремРодноеДерево.Строки.Очистить();
		УСОERP_ОбработкаТабличныхЧастей.УСОERP_ЗаполнитьРоднуюСтруктуруДереваИзВнешнего(ВремРодноеДерево.Строки, ДеревоРабот.Строки); // и рекурсивно заполняется из дерева, где, возможн, типиация создаст проблемы
		ЗначениеВРеквизитФормы( ВремРодноеДерево, "РаботыДеревоЗначений");
		
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодборПоПроектуНаСервере(ВыбранноеЗначениеМассив)
	
	РеквизитРаботыДеревоЗначений = РеквизитФормыВЗначение("РаботыДеревоЗначений", Тип("ДеревоЗначений"));
	РаботыТаблицаЗначений = 	Объект.Работы.Выгрузить();
	РаботыТаблицаЗначений.Очистить();
	
	УСОERP_ОбработкаТабличныхЧастей.ЗаполнитьТаблицуИзДереваЗначений(РеквизитРаботыДеревоЗначений, РаботыТаблицаЗначений); 
	                    
	Для Каждого ВыбранноеЗначение Из ВыбранноеЗначениеМассив Цикл
		Если РаботыТаблицаЗначений.Найти(ВыбранноеЗначение.Ссылка, "Работа") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;	   
		НоваяСтрока =  РеквизитРаботыДеревоЗначений.Строки.Добавить();
		ДобавитьСтрокиВДеревоЗначений(ВыбранноеЗначение, НоваяСтрока, РаботыТаблицаЗначений, РеквизитРаботыДеревоЗначений);
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(РеквизитРаботыДеревоЗначений, "РаботыДеревоЗначений");
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокиВДеревоЗначений(ВыбранноеЗначение, СтрокаДерева, РаботыТаблицаЗначений, РеквизитРаботыДеревоЗначений)

	СписокПараметровРаботы = ПолучитьПараметрыВыполненияРаботы(ВыбранноеЗначение.Ссылка); 
	
	Если НовыйВариант Тогда
		
		СписокПараметровРаботы = Новый Структура;
		СписокПараметровРаботы.Вставить("Работа", ВыбранноеЗначение.Ссылка);
		СписокПараметровРаботы.Вставить("КодСДР", ВыбранноеЗначение.КодСДР);
		СписокПараметровРаботы.Вставить("Объем", ВыбранноеЗначение.ОбъемРаботы);
		СписокПараметровРаботы.Вставить("ЕдиницаОбъема", ВыбранноеЗначение.ЕдиницаОбъема);
		СписокПараметровРаботы.Вставить("ДатаНачала", ВыбранноеЗначение.ДатаНачала);
		СписокПараметровРаботы.Вставить("ДатаОкончания", ВыбранноеЗначение.ДатаОкончания);
		СписокПараметровРаботы.Вставить("Длительность", ВыбранноеЗначение.Длительность);
		СписокПараметровРаботы.Вставить("ЕдиницаДлительности", ВыбранноеЗначение.ЕдиницаДлительности);
		
	КонецЕсли;
	

	ЗаполнитьЗначенияСвойств(СтрокаДерева, СписокПараметровРаботы); 
	
	ВыборкаРабот  = Справочники.УСОERP_СтроительныеРаботы.Выбрать(ВыбранноеЗначение.Ссылка);
	
	Пока ВыборкаРабот.Следующий() Цикл
		Если РаботыТаблицаЗначений.Найти(ВыборкаРабот.Ссылка, "Работа") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;	   
		
		НоваяСтрокаДерева = СтрокаДерева.Строки.Добавить();
		ДобавитьСтрокиВДеревоЗначений(ВыборкаРабот.Ссылка, НоваяСтрокаДерева, РаботыТаблицаЗначений, РеквизитРаботыДеревоЗначений);
	КонецЦикла; 
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыВыполненияРаботы(Работа)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	
	"ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботы.Ссылка КАК Работа,
	|	УСОERP_СтроительныеРаботы.КодСДР КАК КодСДР,
	|	МАКСИМУМ(УСОERP_ПараметрыВыполненияРаботСрезПоследних.Период) КАК Период,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ВидПланирования
	|ПОМЕСТИТЬ ВТ_РаботыПоПериоду
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(, ) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
	|		ПО (УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа = УСОERP_СтроительныеРаботы.Ссылка)
	|ГДЕ
	|	УСОERP_СтроительныеРаботы.Ссылка = &Работа
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_СтроительныеРаботы.Ссылка,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ВидПланирования,
	|	УСОERP_СтроительныеРаботы.КодСДР
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РаботыПоПериоду.Работа,
	|	ВТ_РаботыПоПериоду.КодСДР,
	|	ВТ_РаботыПоПериоду.Работа.СуммарнаяРабота КАК СуммарнаяРабота,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОбъемРаботы КАК Объем,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.НачалоРаботыПлан КАК ДатаНачала,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОкончаниеРаботыПлан КАК ДатаОкончания,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ДлительностьПлан КАК Длительность,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ЕдиницаДлительности КАК ЕдиницаДлительности
	|ИЗ
	|	ВТ_РаботыПоПериоду КАК ВТ_РаботыПоПериоду
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
	|		ПО (УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа = ВТ_РаботыПоПериоду.Работа)
	|			И (УСОERP_ПараметрыВыполненияРаботСрезПоследних.ВидПланирования = ВТ_РаботыПоПериоду.ВидПланирования)
	|			И (УСОERP_ПараметрыВыполненияРаботСрезПоследних.Период = ВТ_РаботыПоПериоду.Период)";
	
	
	
	Запрос.УстановитьПараметр("Работа", Работа);
	
	ДанныеПоРаботе = Запрос.Выполнить().Выгрузить();
	СтруктураДанныхПоРаботе = Новый Структура;
	
	Для Каждого СтрокаДанныеПоРаботе Из ДанныеПоРаботе Цикл
		СтруктураДанныхПоРаботе.Вставить("Работа", СтрокаДанныеПоРаботе.Работа);
		СтруктураДанныхПоРаботе.Вставить("КодСДР", СтрокаДанныеПоРаботе.КодСДР);
		СтруктураДанныхПоРаботе.Вставить("Объем", СтрокаДанныеПоРаботе.Объем);
		СтруктураДанныхПоРаботе.Вставить("ЕдиницаОбъема", СтрокаДанныеПоРаботе.ЕдиницаОбъема);
		СтруктураДанныхПоРаботе.Вставить("ДатаНачала", СтрокаДанныеПоРаботе.ДатаНачала);
		СтруктураДанныхПоРаботе.Вставить("ДатаОкончания", СтрокаДанныеПоРаботе.ДатаОкончания);
		СтруктураДанныхПоРаботе.Вставить("Длительность", СтрокаДанныеПоРаботе.Длительность);
		СтруктураДанныхПоРаботе.Вставить("ЕдиницаДлительности", СтрокаДанныеПоРаботе.ЕдиницаДлительности);
		Прервать;
	КонецЦикла;
	
	Возврат СтруктураДанныхПоРаботе;
КонецФункции	

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаПодбора" Тогда
		ОбработкаВыбораПодборПоПроектуНаСервере(ВыбранноеЗначение);
		РассчитатьИтоговыеПоказатели();
	КонецЕсли;
	
	Если ИсточникВыбора.ИмяФормы = "Документ.УСОERP_БюджетСтроительства.Форма.ФормаВыбора" Тогда
		Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		 ЗаполнитьСтоимостиПоБюджетуНаСервере(ВыбранноеЗначение);
		 РассчитатьИтоговыеПоказатели();
		 Модифицированность = Истина;
        КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

