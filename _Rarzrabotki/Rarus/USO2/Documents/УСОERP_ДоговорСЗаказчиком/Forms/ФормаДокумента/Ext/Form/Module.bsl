&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение И Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыПланов.Утвержден") Тогда
		
		ПроверитьНаДубликаты(Отказ,ПараметрыЗаписи);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаДубликаты(Отказ,ПараметрыЗаписи)
	
	СтруктураДубликатов =  ПроверитьНаДубликатыНаСервере();
	
	Если СтруктураДубликатов.Результат Тогда
		
		Отказ = Истина;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьНаДубликатыПродолжение",ЭтотОбъект,Новый Структура("Отказ,Документ,ПараметрыЗаписи",Отказ,СтруктураДубликатов.Документ,ПараметрыЗаписи));
		
		ТекстВопроса = "По объекту "+Объект.ОбъектСтроительства+" уже есть утвержденный документ (№ "+СтруктураДубликатов.Номер+" от "+СтруктураДубликатов.Дата+")";
		ПоказатьВопрос(ОписаниеОповещения,ТекстВопроса+", отменить утверждение указанного документа?",РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаДубликатыПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ОтменитьПроведениеДубликата(ДопПараметры.Документ);
		Записать(ДопПараметры.ПараметрыЗаписи);
		
	Исключение
		
		ВызватьИсключение("Не удалось изменить статус документа "+ДопПараметры.Документ);
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура  ОтменитьПроведениеДубликата(Документ)
	
	Док = Документ.ПолучитьОбъект();
	Док.Статус = Перечисления.СтатусыПланов.Отменен;
	Док.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры  

&НаСервере
Функция ПроверитьНаДубликатыНаСервере()
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Результат",Ложь);
	СтруктураВозврата.Вставить("Документ");
	СтруктураВозврата.Вставить("Номер");
	СтруктураВозврата.Вставить("Дата");  	 
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ОбъектСтроительства",Объект.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_ДоговорСЗаказчиком.Ссылка КАК Ссылка,
	|	УСОERP_ДоговорСЗаказчиком.Номер КАК Номер,
	|	УСОERP_ДоговорСЗаказчиком.Дата КАК Дата
	|ИЗ
	|	Документ.УСОERP_ДоговорСЗаказчиком КАК УСОERP_ДоговорСЗаказчиком
	|ГДЕ
	|	УСОERP_ДоговорСЗаказчиком.Проведен
	|	И УСОERP_ДоговорСЗаказчиком.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|	И УСОERP_ДоговорСЗаказчиком.ОбъектСтроительства = &ОбъектСтроительства
	|	И УСОERP_ДоговорСЗаказчиком.Ссылка <> &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		СтруктураВозврата.Результат = Истина;
		СтруктураВозврата.Документ = Выборка.Ссылка;
		СтруктураВозврата.Номер = Выборка.Номер;
		СтруктураВозврата.Дата = Выборка.Дата;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции 


