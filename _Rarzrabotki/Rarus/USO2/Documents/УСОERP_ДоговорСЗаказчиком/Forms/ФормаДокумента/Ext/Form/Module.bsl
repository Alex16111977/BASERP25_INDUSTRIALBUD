&НаКлиенте
Процедура ЗаполнитьРаботамиПоПроекту(Команда)
	
	СтрокиДереваРабот = РаботыДеревоЗначений.ПолучитьЭлементы();
	
	Если СтрокиДереваРабот.Количество()> 0 Тогда
			ТекстВопроса = НСтр("ru='Очистить табличную часть «Работы»?'");
			ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗаполнениемОчистить", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе		
		ЗаполнитьРаботамиПоПроектуНаСервере();
	КонецЕсли;
	СуммаВсего = 0;
	СуммаНДС   = 0;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаполнениемОчистить(ОтветНаВопрос, Параметры) Экспорт
	Если ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
		Возврат;
	Иначе
		ЗаполнитьРаботамиПоПроектуНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаполнениемОчиститьРаботыЗаказчика(ОтветНаВопрос, Параметры) Экспорт
	Если ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
		Возврат;
	Иначе
		ЗаполнитьРаботамиЗаказчикаНаСервере();
		РассчитатьИтоговыеПоказатели();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаботамиПоПроектуНаСервере()
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_ДоговорСЗаказчиком_ЗаполнитьРаботамиПоПроектуНаСервере(ЭтотОбъект);
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ПодобратьПоПроекту(Команда)
	
	СтруктураОтбора = Новый Структура;
	ЗаполнитьСтруктуруОтбораНаСервере(СтруктураОтбора);

	ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаПодбора",СтруктураОтбора,ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтруктуруОтбораНаСервере(СтруктураОтбора)
	
	Если НовыйВариант Тогда
		СтруктураОтбора.Вставить("ДокументУтверждения",Объект.ДокументУтверждения);
		Возврат;
	КонецЕсли;
	
	СтруктураОтбора.Вставить("Организация",Объект.Организация);
	СтруктураОтбора.Вставить("ОбъектСтроительства",Объект.ОбъектСтроительства);
	СтруктураОтбора.Вставить("ПометкаУдаления",Ложь);
	СтруктураОтбора.Вставить("Утверждена",Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаботыЗаказчика(Команда)
	
	СтрокиДереваРаботОсн = РаботыДеревоЗначений.ПолучитьЭлементы();
	
	Если СтрокиДереваРаботОсн.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнены внутренние работы.", Объект.Ссылка);
		Возврат;
	КонецЕсли;
	
	СтрокиДереваРабот = ДеревоРаботЗаказчика.ПолучитьЭлементы();
	Если СтрокиДереваРабот.Количество()> 0 Тогда
			ТекстВопроса = НСтр("ru='Очистить табличную часть «Работы заказчика»?'");
			ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗаполнениемОчиститьРаботыЗаказчика", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе		
		ЗаполнитьРаботамиЗаказчикаНаСервере();
		РассчитатьИтоговыеПоказатели();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаботамиЗаказчикаНаСервере()
	
	Отказ = Истина;
	ТабличнаяЧастьРаботы = Объект.Работы;
	ТабличнаяЧастьРаботы.Очистить();
	РеквизитРаботыДеревоЗначений = РеквизитФормыВЗначение("РаботыДеревоЗначений", Тип("ДеревоЗначений"));	
	ЗаполнитьТабличнуюЧастьИзДереваЗначений(РеквизитРаботыДеревоЗначений, ТабличнаяЧастьРаботы, 0, Отказ);  
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_ДоговорСЗаказчиком_ЗаполнитьРаботамиЗаказчикаНаСервере(ЭтотОбъект);
	Модифицированность = Истина;
	
КонецПроцедуры

