#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстыЗапроса.Добавить(ТекстЗапросаУСОERP_ДоступныеРесурсы(),			"УСОERP_ДоступныеРесурсы");
	

	Запрос.Текст = "";
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		Запрос.Текст = Запрос.Текст + ТекстЗапроса.Значение;
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////
	// Выполним запрос
	
	Если Не Запрос.Текст ="" Тогда
		Результат = Запрос.ВыполнитьПакет();
	КонецЕсли;
	
	////////////////////////////////////////////////////////////////////////////
	// Поместим результаты запроса в дополнительные свойства
	
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		ИмяТаблицы = ТекстЗапроса.Представление;
		Если Не ПустаяСтрока(ИмяТаблицы) Тогда
			Индекс = ТекстыЗапроса.Индекс(ТекстЗапроса);
			ДополнительныеСвойства.ТаблицыДляДвижений.Вставить(ИмяТаблицы, Результат[Индекс].Выгрузить());
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
			
КонецПроцедуры

Функция ТекстЗапросаУСОERP_ДоступныеРесурсы()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_ИзменениеКоличестваДоступныхРесурсовТаблицаРесурсов.Ссылка КАК Регистратор,
	|	УСОERP_ИзменениеКоличестваДоступныхРесурсовТаблицаРесурсов.Ссылка.Дата КАК Период,
	|	УСОERP_ИзменениеКоличестваДоступныхРесурсовТаблицаРесурсов.Ссылка.Организация,
	|	УСОERP_ИзменениеКоличестваДоступныхРесурсовТаблицаРесурсов.Ссылка.Статус,
	|	УСОERP_ИзменениеКоличестваДоступныхРесурсовТаблицаРесурсов.Подразделение,
	|	УСОERP_ИзменениеКоличестваДоступныхРесурсовТаблицаРесурсов.Количество,
	|	УСОERP_ИзменениеКоличестваДоступныхРесурсовТаблицаРесурсов.Ресурс
	|ИЗ
	|	Документ.УСОERP_ИзменениеКоличестваДоступныхРесурсов.ТаблицаРесурсов КАК УСОERP_ИзменениеКоличестваДоступныхРесурсовТаблицаРесурсов
	|ГДЕ
	|	УСОERP_ИзменениеКоличестваДоступныхРесурсовТаблицаРесурсов.Ссылка = &Ссылка";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ОтразитьДвижения(ДополнительныеСвойства, Движения, Отказ) Экспорт 

	Таблица = ДополнительныеСвойства.ТаблицыДляДвижений.УСОERP_ДоступныеРесурсы;
	
	Если Отказ ИЛИ Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Движения.УСОERP_ДоступныеРесурсы.Записывать = Истина;
	Движения.УСОERP_ДоступныеРесурсы.Загрузить(Таблица);
	

КонецПроцедуры

#КонецОбласти

