
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстыЗапроса.Добавить(ТекстЗапроса_ГрафикДвиженийПоДоговору(ДокументСсылка), "ГрафикДвиженийПоДоговору");
	ТекстыЗапроса.Добавить(ТекстЗапроса_РегистрНакопленияРасчеты(ДокументСсылка), "РегистрНакопленияРасчеты");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("АналитикаУчетаПоПартнерам",		РегистрыСведений.АналитикаУчетаПоПартнерам.ЗначениеКлючаАналитики(ДокументСсылка));
	Запрос.УстановитьПараметр("ВидДвиженияПриход", 				ВидДвиженияНакопления.Приход);
	Запрос.УстановитьПараметр("ВидДвиженияРасход", 				ВидДвиженияНакопления.Расход);
	Запрос.УстановитьПараметр("Планирование_ЗаказКлиента", 		Перечисления.ХозяйственныеОперации.ПланированиеПоЗаказуКлиента);
	Запрос.УстановитьПараметр("Планирование_ЗаказПоставщику",	Перечисления.ХозяйственныеОперации.ПланированиеПоЗаказуПоставщику);
	Запрос.УстановитьПараметр("Ссылка", 						ДокументСсылка);
	Запрос.УстановитьПараметр("Договор", 						ДокументСсылка.Договор);
	
	Запрос.Текст = "";
	Для Каждого ТекстЗапроса Из ТекстыЗапроса Цикл
		Запрос.Текст = Запрос.Текст + ТекстЗапроса.Значение;
	КонецЦикла;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("ТаблицаГрафикДвиженийПоДоговору", Результат[1].Выгрузить());
	
	Если Результат.Количество() >= 3 Тогда
		ДанныеГрафика = Результат[2].Выгрузить();
		
		Если ДанныеГрафика.Колонки.Найти("ЗаказКлиента") <> Неопределено Тогда
			ДанныеГрафика.Свернуть("ВидДвижения, Период, АналитикаУчетаПоПартнерам, ЗаказКлиента, Валюта, ВалютаДокумента, ХозяйственнаяОперация, ДатаРегистратора, НомерРегистратора, ДатаПлатежа", "КОплате, КОтгрузке");
			
		ИначеЕсли ДанныеГрафика.Колонки.Найти("ЗаказПоставщику") <> Неопределено Тогда
			ДанныеГрафика.Свернуть("ВидДвижения, Период, АналитикаУчетаПоПартнерам, ЗаказПоставщику, Валюта, ВалютаДокумента, ХозяйственнаяОперация, ДатаРегистратора, НомерРегистратора, ДатаПлатежа", "КОплате, КПоступлению");
		КонецЕсли;
		
		Если ДокументСсылка.Договор.ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком 
				Или ДокументСсылка.Договор.ТипДоговора = Перечисления.ТипыДоговоров.СПереработчиком Тогда
			ТаблицыДляДвижений.Вставить("ТаблицаРасчетыСПоставщиками", ДанныеГрафика);
			ТаблицыДляДвижений.Вставить("ТаблицаРасчетыСКлиентами",    Новый ТаблицаЗначений);
			
		Иначе
			ТаблицыДляДвижений.Вставить("ТаблицаРасчетыСКлиентами",    ДанныеГрафика);
			ТаблицыДляДвижений.Вставить("ТаблицаРасчетыСПоставщиками", Новый ТаблицаЗначений);
		КонецЕсли;
		
	Иначе
		ТаблицыДляДвижений.Вставить("ТаблицаРасчетыСПоставщиками", Новый ТаблицаЗначений);
		ТаблицыДляДвижений.Вставить("ТаблицаРасчетыСКлиентами",    Новый ТаблицаЗначений);
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстЗапроса_ГрафикДвиженийПоДоговору(ДокументСсылка)
	
	Если ДокументСсылка.УСОERP_РасширенныйГрафикДвижений Тогда
		
		ТекстЗапроса = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	УСОERP_ДополнительныеПараметрыПоДоговору.Ссылка КАК ДополнительныеПараметрыПоДоговору
			|ПОМЕСТИТЬ ДопПараметрыПоДоговору
			|ИЗ
			|	Документ.УСОERP_ДополнительныеПараметрыПоДоговору КАК УСОERP_ДополнительныеПараметрыПоДоговору
			|ГДЕ
			|	УСОERP_ДополнительныеПараметрыПоДоговору.Договор = &Договор
			|	И НЕ УСОERP_ДополнительныеПараметрыПоДоговору.ПометкаУдаления
			|
			|УПОРЯДОЧИТЬ ПО
			|	УСОERP_ДополнительныеПараметрыПоДоговору.Дата УБЫВ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	&ВидДвиженияПриход КАК ВидДвижения,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ДатаАванс КАК Период,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка КАК Регистратор,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Организация КАК Организация,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Партнер КАК Партнер,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Контрагент КАК Контрагент,
			|	ДоговорыКонтрагентов.Ссылка КАК Договор,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ДатаАванс КАК ДатаСобытияПоДоговору,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ВидДДС_Аванс КАК ПорядокОплаты,
			|	ЗНАЧЕНИЕ(Перечисление.УСОERP_ПорядокДоходовРасходов.ПустаяСсылка) КАК ПорядокДоходовРасходов,
			|	ВЫБОР
			|		КОГДА ДопПараметрыПоДоговору.ДополнительныеПараметрыПоДоговору.ПоВидамРабот
			|			ТОГДА УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ВидРабот
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УСОERP_ВидыРабот.ПустаяСсылка)
			|	КОНЕЦ КАК ВидРабот,
			|	ВЫБОР
			|		КОГДА ДопПараметрыПоДоговору.ДополнительныеПараметрыПоДоговору.ПоРаботам
			|			ТОГДА ВЫБОР
			|					КОГДА УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
			|						ТОГДА УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Работа
			|					ИНАЧЕ УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Работа.РаботаИсточник
			|				КОНЕЦ
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
			|	КОНЕЦ КАК Работа,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.ОбъектСтроительства КАК ОбъектСтроительства,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.СуммаАванс КАК ФинансированиеПлан,
			|	0 КАК ФинансированиеФакт,
			|	0 КАК ПорядокДоходовРасходовПлан,
			|	0 КАК ПорядокДоходовРасходовФакт,
			|	ДоговорыКонтрагентов.Ссылка.СтатьяДвиженияДенежныхСредств КАК СсылкаСтатьяДвиженияДенежныхСредств,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.СтатьяБюджета_Аванс КАК СтатьяБюджета,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Дата КАК Дата
			|ИЗ
			|	Документ.УСОERP_ГрафикДвиженийПоДоговору.ГрафикДвиженияПоДоговору КАК УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
			|		ПО УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Договор = ДоговорыКонтрагентов.Ссылка,
			|	ДопПараметрыПоДоговору КАК ДопПараметрыПоДоговору
			|ГДЕ
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка = &Ссылка
			|	И УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ДатаАванс <> ДАТАВРЕМЯ(1, 1, 1)
			|	И НЕ УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.ПометкаУдаления
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	&ВидДвиженияПриход,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ДатаОстатокПлатежа,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Организация,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Партнер,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Контрагент,
			|	ДоговорыКонтрагентов.Ссылка,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ДатаОстатокПлатежа,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ВидДДС_ОстатокПлатежа,
			|	ЗНАЧЕНИЕ(Перечисление.УСОERP_ПорядокДоходовРасходов.ПустаяСсылка),
			|	ВЫБОР
			|		КОГДА ДопПараметрыПоДоговору.ДополнительныеПараметрыПоДоговору.ПоВидамРабот
			|			ТОГДА УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ВидРабот
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УСОERP_ВидыРабот.ПустаяСсылка)
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА ДопПараметрыПоДоговору.ДополнительныеПараметрыПоДоговору.ПоРаботам
			|			ТОГДА ВЫБОР
			|					КОГДА УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
			|						ТОГДА УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Работа
			|					ИНАЧЕ УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Работа.РаботаИсточник
			|				КОНЕЦ
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
			|	КОНЕЦ,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.ОбъектСтроительства,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.СуммаОстатокПлатежа,
			|	0,
			|	0,
			|	0,
			|	ДоговорыКонтрагентов.Ссылка.СтатьяДвиженияДенежныхСредств,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.СтатьяБюджета_ОстатокПлатежа,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Дата
			|ИЗ
			|	Документ.УСОERP_ГрафикДвиженийПоДоговору.ГрафикДвиженияПоДоговору КАК УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
			|		ПО УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Договор = ДоговорыКонтрагентов.Ссылка,
			|	ДопПараметрыПоДоговору КАК ДопПараметрыПоДоговору
			|ГДЕ
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка = &Ссылка
			|	И УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ДатаОстатокПлатежа <> ДАТАВРЕМЯ(1, 1, 1)
			|	И НЕ УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.ПометкаУдаления
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	&ВидДвиженияПриход,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ДатаВозвратГарантийногоУдержания,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Организация,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Партнер,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Контрагент,
			|	ДоговорыКонтрагентов.Ссылка,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ДатаВозвратГарантийногоУдержания,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ВидДДС_ВозвратГарантийногоУдержания,
			|	ЗНАЧЕНИЕ(Перечисление.УСОERP_ПорядокДоходовРасходов.ПустаяСсылка),
			|	ВЫБОР
			|		КОГДА ДопПараметрыПоДоговору.ДополнительныеПараметрыПоДоговору.ПоВидамРабот
			|			ТОГДА УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ВидРабот
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УСОERP_ВидыРабот.ПустаяСсылка)
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА ДопПараметрыПоДоговору.ДополнительныеПараметрыПоДоговору.ПоРаботам
			|			ТОГДА ВЫБОР
			|					КОГДА УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
			|						ТОГДА УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Работа
			|					ИНАЧЕ УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Работа.РаботаИсточник
			|				КОНЕЦ
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
			|	КОНЕЦ,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.ОбъектСтроительства,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.СуммаВозвратГарантийногоУдержания,
			|	0,
			|	0,
			|	0,
			|	ДоговорыКонтрагентов.Ссылка.СтатьяДвиженияДенежныхСредств,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.СтатьяБюджета_ВозвратГарантийногоУдержания,
			|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Дата
			|ИЗ
			|	Документ.УСОERP_ГрафикДвиженийПоДоговору.ГрафикДвиженияПоДоговору КАК УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
			|		ПО УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Договор = ДоговорыКонтрагентов.Ссылка,
			|	ДопПараметрыПоДоговору КАК ДопПараметрыПоДоговору
			|ГДЕ
