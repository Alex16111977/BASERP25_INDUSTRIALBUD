// Функция формирует и возвращает текст запроса для проведения документа по регистру накопления "Себестоимость товаров".
//
Функция ТекстЗапросаТаблицаСебестоимостьТоваров()
	
	ТекстЗапроса = "ВЫБРАТЬ //// [3] СебестоимостьТоваров
	               |	ТаблицаПринятиеКУчету.НомерСтроки КАК НомерСтроки,
	               |	&Период КАК Период,
	               |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	               |	&Организация КАК Организация,
	               |	ТаблицаПринятиеКУчету.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	               |	ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыНаСкладах) КАК РазделУчета,
	               |	ВЫБОР
	               |		КОГДА &УчитыватьПоВидамЗапасов
	               |			ТОГДА ТаблицаПринятиеКУчету.ВидЗапасов
	               |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	               |	КОНЕЦ КАК ВидЗапасов,
	               |	ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОприходованиеТоваров) КАК ХозяйственнаяОперация,
	               |	ТаблицаПринятиеКУчету.Сумма КАК Стоимость,
	               |	ТаблицаПринятиеКУчету.СуммаБезНДС КАК СтоимостьБезНДС,
	               |	ТаблицаПринятиеКУчету.Сумма КАК СтоимостьРегл,
	               |	ТаблицаПринятиеКУчету.СуммаПР КАК ПостояннаяРазница,
	               |	ТаблицаПринятиеКУчету.СуммаВР КАК ВременнаяРазница,
	               |	ТаблицаПринятиеКУчету.Количество КАК Количество
	               |ИЗ
	               |	ТаблицаПринятиеКУчету КАК ТаблицаПринятиеКУчету
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки
	               |;
	               |////////////////////////////////////////////////////////////////////////////////
	               |";
	
	Возврат ТекстЗапроса;
	
КонецФункции // ТекстЗапросаТаблицаСебестоимостьТоваров()

