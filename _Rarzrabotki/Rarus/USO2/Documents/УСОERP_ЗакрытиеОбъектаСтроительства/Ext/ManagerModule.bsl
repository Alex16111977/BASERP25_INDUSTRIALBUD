// Функция формирует и возвращает текст запроса для проведения документа по регистру накопления "НДС инвестиционный".
//
Функция ТекстЗапросаТаблицаНДСИнвестиционный()
	
	ТекстЗапроса = "ВЫБРАТЬ //// [6] НДСИнвестиционный
	               |	ТаблицаНДСИнвестиционный.НомерСтроки КАК НомерСтроки,
	               |	&Период КАК Период,
	               |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	               |	&Организация КАК Организация,
	               |	ТаблицаНДСИнвестиционный.Контрагент КАК Контрагент,
	               |	ТаблицаНДСИнвестиционный.ДокументПоступления КАК ДокументПоступления,
	               |	ТаблицаНДСИнвестиционный.ОбъектСтроительства КАК ОбъектСтроительства,
	               |	ТаблицаНДСИнвестиционный.СчетУчетаНДС КАК СчетУчетаНДС,
	               |	ТаблицаНДСИнвестиционный.Номенклатура КАК Номенклатура,
	               |	ТаблицаНДСИнвестиционный.СпособСтроительства КАК СпособСтроительства,
	               |	ТаблицаНДСИнвестиционный.СуммаБезНДС КАК СуммаБезНДС,
	               |	ТаблицаНДСИнвестиционный.СуммаНДС КАК СуммаНДС
	               |ИЗ
	               |	Документ.УСОERP_ЗакрытиеОбъектаСтроительства.ВосстановлениеНДС КАК ТаблицаНДСИнвестиционный
	               |ГДЕ
	               |	ТаблицаНДСИнвестиционный.Ссылка = &ТекущийДокумент
	               |	И (ТаблицаНДСИнвестиционный.СуммаБезНДС <> 0
	               |			ИЛИ ТаблицаНДСИнвестиционный.СуммаНДС <> 0)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки
	               |;
	               |////////////////////////////////////////////////////////////////////////////////
	               |";
	
	Возврат ТекстЗапроса;
	
КонецФункции // ТекстЗапросаТаблицаНДСИнвестиционный()

