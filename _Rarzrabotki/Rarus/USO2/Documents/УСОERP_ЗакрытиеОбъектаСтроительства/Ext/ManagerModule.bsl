	|	ТаблицаПринятиеКУчету.НомерСтроки КАК НомерСтроки,
	|	ТаблицаПринятиеКУчету.Номенклатура КАК Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК Назначение,
	|	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК Серия,
	|	ТаблицаПринятиеКУчету.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	1 КАК Количество,
	|	ТаблицаПринятиеКУчету.СуммаЗатрат КАК Сумма,
	|	ТаблицаПринятиеКУчету.СуммаЗатрат КАК СуммаБезНДС,
	|	ТаблицаПринятиеКУчету.СуммаЗатратПР КАК СуммаПР,
	|	ТаблицаПринятиеКУчету.СуммаЗатратВР КАК СуммаВР,
	|	ЗНАЧЕНИЕ(Справочник.ВидыЗапасов.ПустаяСсылка) КАК ВидЗапасов,
	|	ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка) КАК НомерГТД,
	|	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиУчетаПартий.ПустаяСсылка) КАК АналитикаУчетаПартий
	|ПОМЕСТИТЬ ТаблицаПринятиеКУчету
	|ИЗ
	|	Документ.УСОERP_ЗакрытиеОбъектаСтроительства.ПринятиеКУчету КАК ТаблицаПринятиеКУчету
	//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры
	//|		ПО ТаблицаПринятиеКУчету.Номенклатура = АналитикаУчетаНоменклатуры.Номенклатура
	//|			И (АналитикаУчетаНоменклатуры.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	//|			И (АналитикаУчетаНоменклатуры.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка))
	//|			И (АналитикаУчетаНоменклатуры.Склад = &Склад)
	|ГДЕ
	|	ТаблицаПринятиеКУчету.Ссылка = &ТекущийДокумент
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	
	Возврат ТекстЗапроса;
	
КонецФункции // ТекстЗапросаТаблицаПринятиеКУчету()

