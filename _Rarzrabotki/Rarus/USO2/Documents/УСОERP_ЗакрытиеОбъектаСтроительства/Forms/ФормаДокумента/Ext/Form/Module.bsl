// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 

&НаКлиенте
// Процедура - обработчик события "Нажатие" команды расчета актуальных сумм документа.
//
Процедура РассчитатьСуммыДокумента(Команда)
	
	Если Не Объект.ВосстановлениеНДС.Количество() = 0
	 Или Не Объект.СуммаЗатрат = 0
	 Или Не Объект.СуммаЗатратНУ = 0
	 Или Не Объект.СуммаЗатратПР = 0 
	 Или Не Объект.СуммаЗатратВР = 0 Тогда

		ТекстВопроса = НСтр("ru='Перед расчетом сумм документа некоторые данные будут перезаполнены. Продолжить?'");
		ПоказатьВопрос(Новый ОписаниеОповещения("РассчитатьСуммыДокументаЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;

	КонецЕсли;
	
	РассчитатьСуммыДокументаНаСервере();
	
КонецПроцедуры // РассчитатьСуммыДокумента()

&НаКлиенте
// Завершение процедуры - обработчика события "Нажатие" команды расчета актуальных сумм документа.
//
Процедура РассчитатьСуммыДокументаЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
	ОтветНаВопрос = РезультатВопроса;
	Если ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
	    Возврат;
	КонецЕсли;
	
	РассчитатьСуммыДокументаНаСервере();

КонецПроцедуры // РассчитатьСуммыДокументаЗавершение()

&НаКлиенте
// Процедура - обработчик события "Нажатие" команды заполнения данными по объекту.
//
Процедура ЗаполнитьДаннымиПоОбъекту(Команда)
	
	Если Не Объект.ОбъектыНедвижимости.Количество() = 0 Тогда

		ТекстВопроса = НСтр("ru='Перед заполнением табл. часть ""Объекты недвижимости"" будет очищена. Продолжить?'");
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьДаннымиПоОбъектуЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;

	КонецЕсли;

	ЗаполнитьДаннымиПоОбъектуНаСервере();
	
КонецПроцедуры // ЗаполнитьДаннымиПоОбъекту()

&НаКлиенте
// Завершение процедуры - обработчика события "Нажатие" команды заполнения данными по объекту.
//
Процедура ЗаполнитьДаннымиПоОбъектуЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
	ОтветНаВопрос = РезультатВопроса;
	Если ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
	    Возврат;
	КонецЕсли;
	
	ЗаполнитьДаннымиПоОбъектуНаСервере();

КонецПроцедуры // ЗаполнитьДаннымиПоОбъектуЗавершение()

&НаКлиенте
// Процедура - обработчик события "Нажатие" команды распределения данных по объекту.
//
Процедура РаспределитьДанныеПоОбъекту(Команда)
	
	Если Объект.ОбъектыНедвижимости.Количество() = 0 
	 Или ПроверитьЗаполнениеРеквизитовДляРаспределенияДанных() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Объект.ПринятиеКУчету.Количество() = 0 
	 Или Не Объект.СдачаИнвестору.Количество() = 0 Тогда

		ТекстВопроса = НСтр("ru='Перед заполнением табл. части ""Принятие к учету"" и ""Сдача инвестору"" будут очищены. Продолжить?'");
		ПоказатьВопрос(Новый ОписаниеОповещения("РаспределитьДанныеПоОбъектуЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;

	КонецЕсли;

	РаспределитьДанныеПоОбъектуНаСервере();
	
КонецПроцедуры // РаспределитьДанныеПоОбъекту()

&НаКлиенте
// Завершение процедуры - обработчика события "Нажатие" команды распределения данных по объекту.
//
Процедура РаспределитьДанныеПоОбъектуЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
	ОтветНаВопрос = РезультатВопроса;
	Если ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
	    Возврат;
	КонецЕсли;
	
	РаспределитьДанныеПоОбъектуНаСервере();

КонецПроцедуры // РаспределитьДанныеПоОбъектуЗавершение()

&НаСервере
// Процедура формирует структуру параметров и вызывает функции/процедуры расчета актуальных сумм документа. 
//
Процедура РассчитатьСуммыДокументаНаСервере()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДатаДокумента"	   , Объект.Дата);
	СтруктураПараметров.Вставить("Организация"		   , Объект.Организация);
	СтруктураПараметров.Вставить("ОбъектСтроительства" , Объект.ОбъектСтроительства);
	СтруктураПараметров.Вставить("Счет"				   , Объект.Счет);
	
	Объект.ВосстановлениеНДС.Загрузить(Документы.УСОERP_ЗакрытиеОбъектаСтроительства.ПолучитьДанныеЗаполненияВосстановленияНДС(СтруктураПараметров));
	ЗаполнитьЗначенияСвойств(Объект, Документы.УСОERP_ЗакрытиеОбъектаСтроительства.ПолучитьДанныеПоОстаткамХозрасчетного(СтруктураПараметров));
	
	РассчитатьСвязанныеРеквизитыДокументаПоОбъектуСтроительства();
	
КонецПроцедуры // РассчитатьСуммыДокументаНаСервере()

&НаСервере
// Процедура формирует структуру параметров и вызывает функции/процедуры заполнения данными по объекту.
//
Процедура ЗаполнитьДаннымиПоОбъектуНаСервере()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДатаДокумента"	   , Объект.Дата);
	СтруктураПараметров.Вставить("ОбъектСтроительства" , Объект.ОбъектСтроительства);
	СтруктураПараметров.Вставить("ПлощадьФактическая"  , ПлощадьФактическая);
	СтруктураПараметров.Вставить("СуммаЗатрат"		   , СуммаЗатрат);
	СтруктураПараметров.Вставить("СуммаЗатратНУ"	   , Объект.СуммаЗатратНУ);
	СтруктураПараметров.Вставить("СуммаЗатратПР"	   , Объект.СуммаЗатратПР);
	СтруктураПараметров.Вставить("СуммаЗатратВР"	   , Объект.СуммаЗатратВР);
	
	Объект.ОбъектыНедвижимости.Загрузить(Документы.УСОERP_ЗакрытиеОбъектаСтроительства.ПолучитьДанныеЗаполненияОбъектовНедвижимости(СтруктураПараметров));
	ИсправитьОшибкиОкругленияПослеЗаполненияОбъектовНедвижимости(СтруктураПараметров);
	
КонецПроцедуры // ЗаполнитьДаннымиПоОбъектуНаСервере()

&НаСервере
// Процедура формирует структуру параметров и вызывает функции/процедуры распределения данных по объекту.
//
Процедура РаспределитьДанныеПоОбъектуНаСервере()

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДатаДокумента"	   , Объект.Дата);
	СтруктураПараметров.Вставить("Организация"		   , Объект.Организация);
	СтруктураПараметров.Вставить("ГруппаНоменклатуры"  , Объект.ГруппаНоменклатуры);
	СтруктураПараметров.Вставить("ОбъектыНедвижимости" , Объект.ОбъектыНедвижимости.Выгрузить());
	
	Документы.УСОERP_ЗакрытиеОбъектаСтроительства.СоздатьНоменклатуруДляОбъектовНедвижимости(СтруктураПараметров);
	Объект.ПринятиеКУчету.Загрузить(Документы.УСОERP_ЗакрытиеОбъектаСтроительства.ПолучитьДанныеЗаполненияПринятияКУчету(СтруктураПараметров));
	Объект.СдачаИнвестору.Загрузить(Документы.УСОERP_ЗакрытиеОбъектаСтроительства.ПолучитьДанныеЗаполненияСдачиИнвестору(СтруктураПараметров));

КонецПроцедуры // РаспределитьДанныеПоОбъектуНаСервере()

#КонецОбласти

#Область Прочее

&НаСервере
// Процедура вызывается при чтении и создании формы документа на сервере.
//
Процедура ПриЧтенииСозданииНаСервере()

	//Элементы.ГруппаКомментарий.Картинка = ОбщегоНазначения.ПолучитьКартинкуКомментария(Объект.Комментарий);

	УправлениеЭлементамиФормы();
	РассчитатьСвязанныеРеквизитыДокументаПоОбъектуСтроительства();
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере()

&НаСервере
// Процедура управляет видимостью/доступностью/просмотром элементов формы по установленным условиям.
//
Процедура УправлениеЭлементамиФормы()
	
	Элементы.ГруппаВосстановлениеНДС.Видимость = Объект.ВосстанавливатьНДС;
	
КонецПроцедуры // УправлениеЭлементамиФормы()

&НаСервере
// Процедура рассчитывает связанные реквизиты документа по указанному объекту строительства.
//
Процедура РассчитатьСвязанныеРеквизитыДокументаПоОбъектуСтроительства()
	
	РассчитатьПроектнуюПлощадьОбъектаСтроительства();
	РассчитатьФактическуюПлощадьОбъектаСтроительства();
	РассчитатьСуммуНДСВключенногоВСтоимость();

КонецПроцедуры // РассчитатьСвязанныеРеквизитыДокументаПоОбъектуСтроительства()

&НаСервере
// Процедура рассчитывает значение реквизита "Общая проектная площадь" по данным регистра сведений.
//
Процедура РассчитатьПроектнуюПлощадьОбъектаСтроительства()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаДокумента"		, Объект.Дата);
	Запрос.УстановитьПараметр("ОбъектСтроительства"	, Объект.ОбъектСтроительства);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЕСТЬNULL(СУММА(ПлощадиОбъектовНедвижимости.ОбщаяПлощадь), 0) КАК ПлощадьПроектная
	               |ИЗ
	               |	РегистрСведений.УПН_ПлощадиОбъектовНедвижимости.СрезПоследних(&ДатаДокумента, ОбъектНедвижимости.ОбъектЭксплуатации = &ОбъектСтроительства) КАК ПлощадиОбъектовНедвижимости";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
	
КонецПроцедуры // РассчитатьПроектнуюПлощадьОбъектаСтроительства()

&НаСервере
// Процедура рассчитывает значение реквизита "Общая фактическая площадь" по данным регистра сведений.
//
Процедура РассчитатьФактическуюПлощадьОбъектаСтроительства()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаДокумента"		, Объект.Дата);
	Запрос.УстановитьПараметр("ОбъектСтроительства"	, Объект.ОбъектСтроительства);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЕСТЬNULL(СУММА(ПараметрыОбъектовНедвижимостиПоБТИ.ОбщаяПлощадь), 0) КАК ПлощадьФактическая
	               |ИЗ
	               |	РегистрСведений.УПН_ПараметрыОбъектовНедвижимостиПоБТИ.СрезПоследних(&ДатаДокумента, ОбъектНедвижимости.ОбъектЭксплуатации = &ОбъектСтроительства) КАК ПараметрыОбъектовНедвижимостиПоБТИ";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
	
КонецПроцедуры // РассчитатьФактическуюПлощадьОбъектаСтроительства()

&НаСервере
// Процедура рассчитывает значение реквизита "Сумма НДС включенного в стоимость" по данным табл. части документа.
//
Процедура РассчитатьСуммуНДСВключенногоВСтоимость()
	
	СуммаНДСВключенногоВСтоимость = ?(Объект.ВосстанавливатьНДС, Объект.ВосстановлениеНДС.Итог("СуммаНДС"), 0);
	СуммаЗатрат					  = Объект.СуммаЗатрат - СуммаНДСВключенногоВСтоимость;
	
КонецПроцедуры // РассчитатьСуммуНДСВключенногоВСтоимость()

&НаСервере
// Процедура исправляет ошибки округления сумм после заполнения табл. части "Объекты недвижимости".
//
Процедура ИсправитьОшибкиОкругленияПослеЗаполненияОбъектовНедвижимости(СтруктураПараметров)
	
	ИтогСуммыЗатрат = Объект.ОбъектыНедвижимости.Итог("СуммаЗатрат");
	Если Не ИтогСуммыЗатрат = СтруктураПараметров.СуммаЗатрат Тогда
		ОбработатьОшибкуОкругленияПоследнейСтроки(ИтогСуммыЗатрат, СтруктураПараметров.СуммаЗатрат, "СуммаЗатрат");	
	КонецЕсли;
	
	ИтогСуммыЗатратНУ = Объект.ОбъектыНедвижимости.Итог("СуммаЗатратНУ");
	Если Не ИтогСуммыЗатратНУ = СтруктураПараметров.СуммаЗатратНУ Тогда
		ОбработатьОшибкуОкругленияПоследнейСтроки(ИтогСуммыЗатратНУ, СтруктураПараметров.СуммаЗатратНУ, "СуммаЗатратНУ");	
	КонецЕсли;
	
	ИтогСуммыЗатратПР = Объект.ОбъектыНедвижимости.Итог("СуммаЗатратПР");
	Если Не ИтогСуммыЗатратПР = СтруктураПараметров.СуммаЗатратПР Тогда
		ОбработатьОшибкуОкругленияПоследнейСтроки(ИтогСуммыЗатратПР, СтруктураПараметров.СуммаЗатратПР, "СуммаЗатратПР");	
	КонецЕсли;
	
	ИтогСуммыЗатратВР = Объект.ОбъектыНедвижимости.Итог("СуммаЗатратВР");
	Если Не ИтогСуммыЗатратВР = СтруктураПараметров.СуммаЗатратВР Тогда
		ОбработатьОшибкуОкругленияПоследнейСтроки(ИтогСуммыЗатратВР, СтруктураПараметров.СуммаЗатратВР, "СуммаЗатратВР");	
	КонецЕсли;
	
КонецПроцедуры // ИсправитьОшибкиОкругленияПослеЗаполненияОбъектовНедвижимости()

&НаСервере
// Процедура обрабатывает ошибку округления в последней строке табл. части "Объекты недвижимости". 
//
Процедура ОбработатьОшибкуОкругленияПоследнейСтроки(ИтогСуммы, КорректнаяСумма, ИмяКолонки)
	
	РазницаРассчитаныхСумм = ИтогСуммы - КорректнаяСумма;
	КоличествоСтрок		   = Объект.ОбъектыНедвижимости.Количество();
	ИндексПоследнейСтроки  = КоличествоСтрок - 1;
	
	Если Не ИндексПоследнейСтроки < 0 Тогда
		Объект.ОбъектыНедвижимости[ИндексПоследнейСтроки][ИмяКолонки] = Объект.ОбъектыНедвижимости[ИндексПоследнейСтроки][ИмяКолонки] - РазницаРассчитаныхСумм;	
	КонецЕсли;
	
КонецПроцедуры // ОбработатьОшибкуОкругленияПоследнейСтроки()

&НаСервере
// Процедура обновляет элементы дополнительных реквизитов при оповещении с других форм.
//
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
	
КонецПроцедуры // ОбновитьЭлементыДополнительныхРеквизитов()

&НаКлиенте
// Функция проверяет заполнение необходимых реквизитов и возвращает результат данной проверки.
//
Функция ПроверитьЗаполнениеРеквизитовДляРаспределенияДанных()
	
	Отказ = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.ГруппаНоменклатуры) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Поле ""Группа"" не заполнено'"), Объект.Ссылка, "ГруппаНоменклатуры", "Объект", Отказ);  	
	КонецЕсли;
	
	Возврат Отказ;
	
КонецФункции // ПроверитьЗаполнениеРеквизитовДляРаспределенияДанных()


#КонецОбласти

