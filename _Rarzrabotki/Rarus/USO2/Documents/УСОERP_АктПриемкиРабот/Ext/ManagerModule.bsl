	|	&Период,
	|	&Период,
	|	&Номер,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	&АналитикаУчетаПоПартнерам,
	|	ВЫБОР
	|		КОГДА Справка.Договор.ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоДоговорамКонтрагентов)
	|			ТОГДА &Договор
	|		ИНАЧЕ &Ссылка
	|	КОНЕЦ,
	|	НЕОПРЕДЕЛЕНО,
	|	&ВалютаВзаиморасчетов,
	|	&ВалютаВзаиморасчетов,
	|	&ХозяйственнаяОперация,
	|	НЕОПРЕДЕЛЕНО,
	|	0,
	|	0,
	|	0,
	|	0,
	|	Справка.СуммаДокумента - ТЧВыполненоВсего.СуммаГУ,
	|	&Организация
	|ИЗ
	|	Документ.УСОERP_АктПриемкиРабот КАК Справка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_АктПриемкиРабот.ВыполненоВсего КАК ТЧВыполненоВсего
	|		ПО (ТЧВыполненоВсего.Ссылка = Справка.Ссылка)
	|ГДЕ
	|	Справка.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период,
	|	&Период,
	|	&Период,
	|	&Номер,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	&АналитикаУчетаПоПартнерамГУ,
	|	УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.ДоговорГарантийногоУдержания,
	|	НЕОПРЕДЕЛЕНО,
	|	&ВалютаВзаиморасчетов,
	|	&ВалютаВзаиморасчетов,
	|	&ХозяйственнаяОперация,
	|	НЕОПРЕДЕЛЕНО,
	|	ТЧВыполненоВсего.СуммаГУ,
	|	ВЫРАЗИТЬ(ТЧВыполненоВсего.СуммаГУ * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2)),
	|	ВЫРАЗИТЬ(ТЧВыполненоВсего.СуммаГУ * &КоэффициентПересчетаВВалютуУпр КАК ЧИСЛО(15, 2)),
	|	ТЧВыполненоВсего.СуммаГУ,
	|	0,
	|	&Организация
	|ИЗ
	|	Документ.УСОERP_АктПриемкиРабот.ВыполненоВсего КАК ТЧВыполненоВсего
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_АктПриемкиРабот КАК Справка
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_ДополнительныеПараметрыПоДоговору.СрезПоследних(
	|					&Период,
	|					Договор = &Договор
	|						И ОбъектСтроительства = &ОбъектСтроительства) КАК УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних
	|			ПО (ИСТИНА)
	|		ПО ТЧВыполненоВсего.Ссылка = Справка.Ссылка
	|ГДЕ
	|	Справка.Ссылка = &Ссылка
	|	И ТЧВыполненоВсего.СуммаГУ <> 0"; 
 // Новый вариант
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);

	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаПрочиеРасходыНезавершенногоПроизводства(Запрос, ТекстыЗапроса, Регистры)
	
