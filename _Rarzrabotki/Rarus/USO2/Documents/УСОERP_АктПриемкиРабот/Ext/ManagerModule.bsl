Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	ИнициализироватьКлючиАналитикиНоменклатуры(Запрос);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
		
	ТекстЗапросаВтТаблицаРаботы(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаВтТаблицаМатериалы(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаПродукция(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаВтРаботыУслуги(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаСебестоимостьТоваров(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаУслугиПереработчиковКОформлению(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаТоварыПереданныеПереработчику(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаРасчетыСПоставщиками(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаПрочиеРасходыНезавершенногоПроизводства(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаСуммыДокументовВВалютеРегл(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаМатериалыИРаботыВПроизводстве(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаПрочиеРасходы(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаВыполнениеРаботСубподрядчиком(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаРасходМатериаловВСтроительстве(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаНДСПредъявленный(Запрос, ТекстыЗапроса, Регистры);  	
	ТекстЗапросаГрафикДвиженийПоДоговору(Запрос, ТекстыЗапроса, Регистры);
	
	ПроведениеСерверУТ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	 	
КонецПроцедуры

Процедура ИнициализироватьКлючиАналитикиНоменклатуры(Запрос) 
	
	Если Запрос.Параметры.Свойство("КлючиАналитикиУчетаНоменклатурыИнициализированы") Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросАналитик = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаТовары.Серия          КАК Серия,
	|	ТаблицаТовары.Склад          КАК Склад,
	|	ТаблицаТовары.Номенклатура   КАК Номенклатура,
	|	ТаблицаТовары.Характеристика КАК Характеристика
	|ИЗ
	|	(ВЫБРАТЬ
	|		&Субподрядчик       								КАК Склад,
	|		ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК Серия,
	|		Аналитика.Номенклатура     							КАК Номенклатура,
	|		Аналитика.Характеристика   							КАК Характеристика
	|	ИЗ
	|		Документ.УСОERP_АктПриемкиРабот.Материалы КАК ТаблицаМатериалы
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РегистрСведений.АналитикаУчетаНоменклатуры КАК Аналитика
	|	ПО 
	|		ТаблицаМатериалы.АналитикаУчетаНоменклатуры = Аналитика.КлючАналитики
	|
	|	ГДЕ
	|		ТаблицаМатериалы.Ссылка = &Ссылка) КАК ТаблицаТовары
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РегистрСведений.АналитикаУчетаНоменклатуры КАК Аналитика
	|	ПО
	|		  ТаблицаТовары.Номенклатура   = Аналитика.Номенклатура
	|		И ТаблицаТовары.Характеристика = Аналитика.Характеристика
	|		И ТаблицаТовары.Серия          = Аналитика.Серия
	|		И ТаблицаТовары.Склад          = Аналитика.МестоХранения
	|
	|ГДЕ
	|	Аналитика.Номенклатура ЕСТЬ NULL");
	
	ЗапросАналитик.УстановитьПараметр("Ссылка",			Запрос.Параметры.Ссылка);
	ЗапросАналитик.УстановитьПараметр("Субподрядчик",	Запрос.Параметры.Субподрядчик);
	
	Выборка = ЗапросАналитик.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		РегистрыСведений.АналитикаУчетаНоменклатуры.СоздатьКлючАналитики(Выборка);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("КлючиАналитикиУчетаНоменклатурыИнициализированы", Истина);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = "ВЫБРАТЬ
	|	УСОERP_АктПриемкиРабот.Дата КАК Период,
	|	УСОERP_АктПриемкиРабот.Ссылка КАК Ссылка,
	|	УСОERP_АктПриемкиРабот.ОбъектСтроительства,
	|	УСОERP_АктПриемкиРабот.Организация КАК Организация,
	|	УСОERP_АктПриемкиРабот.Подразделение КАК Подразделение,
	|	УСОERP_АктПриемкиРабот.Контрагент КАК Контрагент,
	|	УСОERP_АктПриемкиРабот.Договор КАК Договор,
	|	УСОERP_АктПриемкиРабот.ДатаНачала,
	|	УСОERP_АктПриемкиРабот.ДатаОкончания,
	|	УСОERP_АктПриемкиРабот.НомерКС2,
	|	УСОERP_АктПриемкиРабот.ДатаКС2,
	|	УСОERP_АктПриемкиРабот.НомерКС3,
	|	УСОERP_АктПриемкиРабот.ДатаКС3,
	|	УСОERP_АктПриемкиРабот.Субподрядчик,
	|	УСОERP_АктПриемкиРабот.Соглашение
	|ИЗ
	|	Документ.УСОERP_АктПриемкиРабот КАК УСОERP_АктПриемкиРабот
	|ГДЕ
	|	УСОERP_АктПриемкиРабот.Ссылка = &Ссылка";
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	
	Коэффициенты = РаботаСКурсамивалютУТ.ПолучитьКоэффициентыПересчетаВалюты(ДокументСсылка.Валюта, ДокументСсылка.ВалютаВзаиморасчетов, ДокументСсылка.Дата);
	
	Запрос.УстановитьПараметр("ОбъектСтроительства",   	Реквизиты.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Период",              	Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация",         	Реквизиты.Организация);
	Запрос.УстановитьПараметр("Подразделение",         	Реквизиты.Подразделение);
	Запрос.УстановитьПараметр("Субподрядчик",          	Реквизиты.Субподрядчик);
	Запрос.УстановитьПараметр("Соглашение",          	Реквизиты.Соглашение);
	Запрос.УстановитьПараметр("Контрагент",          	Реквизиты.Контрагент);
	Запрос.УстановитьПараметр("Договор",             	Реквизиты.Договор);
	Запрос.УстановитьПараметр("НомерКС2",            	Реквизиты.НомерКС2);
	Запрос.УстановитьПараметр("ДатаКС2",             	Реквизиты.ДатаКС2);
	Запрос.УстановитьПараметр("НомерКС3",            	Реквизиты.НомерКС3);
	Запрос.УстановитьПараметр("ДатаКС3",             	Реквизиты.ДатаКС3);
	Запрос.УстановитьПараметр("ВалютаВзаиморасчетов",   ДокументСсылка.ВалютаВзаиморасчетов);
	Запрос.УстановитьПараметр("ХозяйственнаяОперация", 	Перечисления.ХозяйственныеОперации.ПроизводствоУПереработчика);
	Запрос.УстановитьПараметр("КоэффициентПересчетаВВалютуУПР",  	Коэффициенты.КоэффициентПересчетаВВалютуУПР);
	Запрос.УстановитьПараметр("КоэффициентПересчетаВВалютуРегл", 	Коэффициенты.КоэффициентПересчетаВВалютуРегл);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", 	Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("АналитикаУчетаПоПартнерам",       	РегистрыСведений.АналитикаУчетаПоПартнерам.ЗначениеКлючаАналитики(Новый Структура("Организация, Партнер, Контрагент, Договор, НаправлениеДеятельности", ДокументСсылка.Организация, ДокументСсылка.Субподрядчик, ДокументСсылка.Контрагент, ДокументСсылка.Договор, ДокументСсылка.НаправлениеДеятельности)));
	Запрос.УстановитьПараметр("УчитыватьСебестоимостьТоваровПоВидамЗапасов",   ПолучитьФункциональнуюОпцию("УчитыватьСебестоимостьТоваровПоВидамЗапасов"));
	Запрос.УстановитьПараметр("Валюта",                             ДокументСсылка.Валюта);
	Запрос.УстановитьПараметр("ВалютаУправленческогоУчета",         Константы.ВалютаУправленческогоУчета.Получить());
	Запрос.УстановитьПараметр("АналитикаУчетаПоПартнерамГУ",       	РегистрыСведений.АналитикаУчетаПоПартнерам.ЗначениеКлючаАналитики(Новый Структура("Организация, Партнер, Контрагент, Договор, НаправлениеДеятельности", ДокументСсылка.Организация, ДокументСсылка.Субподрядчик, 
	ДокументСсылка.Контрагент, УСОERP_УправлениеСтроительнымПроизводством.НайтиДоговорГарантийногоУдержания(ДокументСсылка.ОбъектСтроительства, ДокументСсылка.Договор, ДокументСсылка.Дата), ДокументСсылка.НаправлениеДеятельности)));
	
	Запрос.УстановитьПараметр("НалогообложениеНДС",Справочники.Организации.НалогообложениеНДС(Реквизиты.Организация,, Реквизиты.Период));
	Запрос.УстановитьПараметр("УправленческийУчетОрганизаций",УниверсальныеМеханизмыПартийИСебестоимостиПовтИсп.УправленческийУчетОрганизаций(НачалоМесяца(Реквизиты.Период)));

	ПоВидуРабот = Ложь;
	ПоРаботам = Ложь;
	
	ЗапросДопПараметры = Новый Запрос;
	ЗапросДопПараметры.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УСОERP_ДополнительныеПараметрыПоДоговору.Ссылка КАК ДополнительныеПараметрыПоДоговору
		|ИЗ
		|	Документ.УСОERP_ДополнительныеПараметрыПоДоговору КАК УСОERP_ДополнительныеПараметрыПоДоговору
		|ГДЕ
		|	УСОERP_ДополнительныеПараметрыПоДоговору.Договор = &Договор
		|	И НЕ УСОERP_ДополнительныеПараметрыПоДоговору.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	УСОERP_ДополнительныеПараметрыПоДоговору.Дата УБЫВ";
	ЗапросДопПараметры.УстановитьПараметр("Договор",Реквизиты.Договор);
	
	Выборка = ЗапросДопПараметры.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ПоВидуРабот = Выборка.ДополнительныеПараметрыПоДоговору.ПоВидамРабот;
		ПоРаботам =  Выборка.ДополнительныеПараметрыПоДоговору.ПоРаботам;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ПоВидуРабот",ПоВидуРабот);
	Запрос.УстановитьПараметр("ПоРаботам",ПоРаботам);
	Запрос.УстановитьПараметр("ДвиженияПоАналитике",НЕ ЗначениеЗаполнено(Документы.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.НайтиПоРеквизиту("ДокументОснование", ДокументСсылка)));
	Запрос.УстановитьПараметр("Номер",ДокументСсылка.Номер);
	
КонецПроцедуры

Функция ТекстЗапросаВтТаблицаРаботы(Запрос, ТекстыЗапроса, Регистры)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	УСОERP_АктПриемкиРаботРаботы.Работа,
	|	УСОERP_АктПриемкиРаботРаботы.ОбъемОбщий,
	|	УСОERP_АктПриемкиРаботРаботы.ОбъемПринятыхРабот,
	|	УСОERP_АктПриемкиРаботРаботы.ЕдиницаОбъема,
	|	УСОERP_АктПриемкиРаботРаботы.ДатаНачала,
	|	УСОERP_АктПриемкиРаботРаботы.ДатаОкончания,
	|	УСОERP_АктПриемкиРаботРаботы.Длительность,
	|	УСОERP_АктПриемкиРаботРаботы.ЕдиницаДлительности,
	|	УСОERP_АктПриемкиРаботРаботы.СуммаСНДС,
	|	УСОERP_АктПриемкиРаботРаботы.СтавкаНДС,
	|	УСОERP_АктПриемкиРаботРаботы.СуммаНДС,
	|	УСОERP_АктПриемкиРаботРаботы.НомерСтроки
	|ПОМЕСТИТЬ ВтТаблицаРаботы
	|ИЗ
	|	Документ.УСОERP_АктПриемкиРабот.Работы КАК УСОERP_АктПриемкиРаботРаботы
	|ГДЕ
	|	УСОERP_АктПриемкиРаботРаботы.Ссылка = &Ссылка";
		
	ТекстыЗапроса.Добавить(ТекстЗапроса, "");
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВтТаблицаМатериалы(Запрос, ТекстыЗапроса, Регистры)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Ссылка                                  КАК Ссылка,
	|	ТаблицаТовары.Ссылка.СуммаДокумента 	 КАК СуммаДокумента,
	|	&Субподрядчик							 КАК Склад,
	|	&Организация                             КАК Организация,
	|	ТаблицаТовары.НомерСтроки                КАК НомерСтроки,
	|	ТаблицаТовары.ЗаказПереработчику	 	 КАК ЗаказПереработчику,
	|	ТаблицаТовары.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	АналитикаНоменклатуры.Номенклатура       КАК Номенклатура,
	|	АналитикаНоменклатуры.Характеристика     КАК Характеристика,
	|	ТаблицаТовары.КодСтроки                  КАК КодСтроки,
	|	ТаблицаТовары.ВидЗапасов				 КАК ВидЗапасов,
	|	ТаблицаТовары.ВидЗапасов.ТипЗапасов		 КАК ТипЗапасов,
	|	ТаблицаТовары.КоличествоУпаковок		 КАК Количество
	|
	|ПОМЕСТИТЬ ВтТаблицаМатериалы
	|
	|ИЗ
	|	Документ.УСОERP_АктПриемкиРабот.Материалы КАК ТаблицаТовары
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РегистрСведений.АналитикаУчетаНоменклатуры КАК АналитикаНоменклатуры
	|	ПО 
	|		ТаблицаТовары.АналитикаУчетаНоменклатуры = АналитикаНоменклатуры.КлючАналитики
	|
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Ссылка";
		
	ТекстыЗапроса.Добавить(ТекстЗапроса, "");

	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаПродукция(Запрос, ТекстыЗапроса, Регистры)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
