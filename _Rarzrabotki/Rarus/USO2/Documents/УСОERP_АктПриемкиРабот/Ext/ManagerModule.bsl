	|ГДЕ
	|	Справка.Ссылка = &Ссылка
	|	И ТЧВыполненоВсего.СуммаГУ <> 0"; 
	
	//Новый вариант
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Период КАК ДатаРегистратора,
