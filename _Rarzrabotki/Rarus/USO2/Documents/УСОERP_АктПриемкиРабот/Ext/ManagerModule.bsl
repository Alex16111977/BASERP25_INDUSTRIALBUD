Функция ТекстЗапросаТаблицаПрочиеРасходы(Запрос, ТекстыЗапроса, Регистры) 	
	
	ИмяРегистра = "ПрочиеРасходы";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&Период КАК Период,
	|	&Организация КАК Организация,
	|	&Подразделение КАК Подразделение,
	|	ВложенныйЗапрос.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ВложенныйЗапрос.СтатьяРасходов КАК СтатьяРасходов,
	|	ВложенныйЗапрос.АналитикаРасходов КАК АналитикаРасходов,
	|	СУММА(ВложенныйЗапрос.Сумма) КАК Сумма,
	|	СУММА(ВложенныйЗапрос.СуммаБезНДС) КАК СуммаБезНДС,
	|	СУММА(ВложенныйЗапрос.СуммаРегл) КАК СуммаРегл,
	|	&ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	СУММА(ВложенныйЗапрос.СуммаУпр) КАК СуммаУпр
	|ИЗ
	|	(ВЫБРАТЬ
	|		РаботыУслуги.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|		РаботыУслуги.СтатьяРасходов КАК СтатьяРасходов,
	|		РаботыУслуги.АналитикаРасходов КАК АналитикаРасходов,
	|		ВЫБОР
	|			КОГДА &ВалютаВзаиморасчетов = &ВалютаУправленческогоУчета
	|				ТОГДА РаботыУслуги.СуммаСНДС
	|			ИНАЧЕ ВЫРАЗИТЬ(РаботыУслуги.СуммаСНДС * &КоэффициентПересчетаВВалютуУпр КАК ЧИСЛО(15, 2))
	|		КОНЕЦ КАК Сумма,
	|		ВЫБОР
	|			КОГДА &ВалютаВзаиморасчетов = &ВалютаУправленческогоУчета
	|				ТОГДА РаботыУслуги.СуммаСНДС - РаботыУслуги.СуммаНДС
	|			ИНАЧЕ ВЫРАЗИТЬ((РаботыУслуги.СуммаСНДС - РаботыУслуги.СуммаНДС) * &КоэффициентПересчетаВВалютуУпр КАК ЧИСЛО(15, 2))
	|		КОНЕЦ КАК СуммаБезНДС,
	|		ВЫБОР
	|			КОГДА &ВалютаВзаиморасчетов = &ВалютаРегламентированногоУчета
	|					И &Валюта <> &ВалютаРегламентированногоУчета
	|				ТОГДА РаботыУслуги.СуммаСНДС - РаботыУслуги.СуммаНДС
	|			ИНАЧЕ ВЫРАЗИТЬ((РаботыУслуги.СуммаСНДС - РаботыУслуги.СуммаНДС) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))
	|		КОНЕЦ КАК СуммаРегл,
	|		ВЫБОР
	|			КОГДА &ВалютаВзаиморасчетов = &ВалютаУправленческогоУчета
	|					И &Валюта <> &ВалютаВзаиморасчетов
	|				ТОГДА РаботыУслуги.СуммаСНДС - РаботыУслуги.СуммаНДС
	|			ИНАЧЕ ВЫРАЗИТЬ((РаботыУслуги.СуммаСНДС - РаботыУслуги.СуммаНДС) * &КоэффициентПересчетаВВалютуУПР КАК ЧИСЛО(15, 2))
	|		КОНЕЦ КАК СуммаУпр
	|	ИЗ
	|		ВтРаботыУслуги КАК РаботыУслуги
	|			ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.СтатьиРасходов КАК СтатьиРасходов
	|			ПО РаботыУслуги.СтатьяРасходов = СтатьиРасходов.Ссылка) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.НаправлениеДеятельности,
	|	ВложенныйЗапрос.АналитикаРасходов,
	|	ВложенныйЗапрос.СтатьяРасходов";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции

