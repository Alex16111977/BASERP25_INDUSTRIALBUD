
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	
	Если ТипДанныхЗаполнения = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект,ДанныеЗаполнения);
	КонецЕсли;	
	
	ЗаполнениеСвойствПоСтатистикеСервер.ЗаполнитьСвойстваОбъекта(ЭтотОбъект, ДанныеЗаполнения);
	
	ИнициализироватьДокумент(ДанныеЗаполнения); 	
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивВсехРеквизитов = Новый Массив;
	МассивРеквизитовОперации = Новый Массив;
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	Для ТекИндекс = 0 По Работы.Количество()-1 Цикл
		
		АдресОшибки = НСтр("ru=' в строке %НомерСтроки% списка ""Работы""'");
		АдресОшибки = СтрЗаменить(АдресОшибки, "%НомерСтроки%", Работы[ТекИндекс].НомерСтроки);
		
		Если Не Работы[ТекИндекс].Работа.СуммарнаяРабота Тогда
			Если Не ЗначениеЗаполнено(Работы[ТекИндекс].СуммаСНДС) Тогда			
				ТекстОшибки = НСтр("ru='Не заполнено поле ""Стоимость с НДС""'");
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстОшибки + АдресОшибки,
				ЭтотОбъект,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Работы", Работы[ТекИндекс].НомерСтроки, "СуммаСНДС"),
				,
				Отказ);		
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Работы[ТекИндекс].СтавкаНДС) Тогда			
				ТекстОшибки = НСтр("ru='Не заполнено поле ""Ставка НДС""'");
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстОшибки + АдресОшибки,
				ЭтотОбъект,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Работы", Работы[ТекИндекс].НомерСтроки, "СтавкаНДС"),
				,
				Отказ);		
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ПроверяемыеРеквизиты.Добавить("Контрагент");
	ПроверяемыеРеквизиты.Добавить("Договор");
	ПроверяемыеРеквизиты.Добавить("Валюта"); 
	
	Если СтатьяУчетаРасходов.КонтролироватьЗаполнениеАналитики Тогда
		ПроверяемыеРеквизиты.Добавить("АналитикаРасходов");
	КонецЕсли;
		
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты,МассивНепроверяемыхРеквизитов);
	
	ПроверитьНаКорректностьОбъемыиСтоимостиПринимаемыхРабот(Отказ);
	
	Если ВыполненоВсего.Количество() И Работы.Количество() Тогда
	
		Если Работы.Итог("СуммаСНДС") <> ВыполненоВсего.Итог("Сумма") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не совпадают суммы в таб.частях ""Работы"" и ""Выполнено всего""",,,,Отказ);
		КонецЕсли;
		
		Если Работы.Итог("СуммаНДС") <> ВыполненоВсего.Итог("СуммаНДС") Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не совпадают суммы в таб.частях ""Работы"" и ""Выполнено всего""",,,,Отказ);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаправлениеДеятельности) Тогда
		НаправлениеДеятельности = ДокументУтверждения.НаправлениеДеятельности;
	КонецЕсли;
			
	ЦенаВключаетНДС = Истина;
	ВыполненоВсего.ЗагрузитьКолонку(ВыполненоВсего.ВыгрузитьКолонку("Сумма"),"СуммаСНДС");
	
	ПроведениеСерверУТ.УстановитьРежимПроведения(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
	СуммаДокумента = ПолучитьСуммуДокумента();	
	СуммаНДС = ПолучитьСуммуНДС();	
	
	Если НЕ Работы.Количество() Тогда
		
		СуммаДокумента = ВыполненоВсего.Итог("Сумма");
		СуммаНДС = ВыполненоВсего.Итог("СуммаНДС");
		
	КонецЕсли;		
	
	Документы.СчетФактураПолученный.ПроверитьРеквизитыСчетФактуры(Ссылка, ПометкаУдаления, Организация);
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		ВзаиморасчетыСервер.ЗаполнитьИдентификаторыСтрокВТабличнойЧасти(ВыполненоВсего);
		
		Для Каждого СтрокаТЧ ИЗ ВыполненоВсего   Цикл
			
			СтрокаТЧ.СуммаВзаиморасчетов = 0;
			
		КонецЦикла;
		
		СтруктураКурса = РаботаСКурсамиВалютУТ.СтруктураКурсаВалюты(Курс,Кратность); 		
		
		Ценообразование.РассчитатьСуммыВзаиморасчетовВТабличнойЧасти(ЭтотОбъект, "ВыполненоВсего", СтруктураКурса);
		
		ЗаполнитьСуммуВзаиморасчетов(СтруктураКурса);  		
		
		МестаУчета = РегистрыСведений.АналитикаУчетаНоменклатуры.МестаУчета(
		Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика,
		Неопределено,
		Подразделение,
		Субподрядчик);
		
		МестаУчета.Вставить("Товар", Субподрядчик);
		
		ИменаПолей = РегистрыСведений.АналитикаУчетаНоменклатуры.ИменаПолейКоллекцииПоУмолчанию();
		ИменаПолей.Назначение 			= "";
		ИменаПолей.СтатусУказанияСерий 	= 0;
		
		РегистрыСведений.АналитикаУчетаНоменклатуры.ЗаполнитьВКоллекции(Материалы, МестаУчета, ИменаПолей);
		ЗаполнитьВидыЗапасовДокумента(Отказ);
		
	КонецЕсли;
	
	НалогообложениеНДС = Справочники.Организации.НалогообложениеНДС(Организация,, Дата);
	
КонецПроцедуры

Процедура ЗаполнитьСуммуВзаиморасчетов(СтруктураКурса)
	
	Если ВыполненоВсего.НайтиСтроки(Новый Структура("СуммаВзаиморасчетов", 0)).Количество()=0 Тогда
		
		СуммаВзаиморасчетов = ВыполненоВсего.Итог("СуммаВзаиморасчетов");
		
	Иначе
		
		ВзаиморасчетыСервер.ЗаполнитьСуммуВзаиморасчетов(ЭтотОбъект, "ВыполненоВсего" , СтруктураКурса);
		
	КонецЕсли;
	
КонецПроцедуры  

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	Документы.УСОERP_АктПриемкиРабот.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	ЕстьДвиженияВыполнения = ПроверитьНаличиеДвиженийВыполнения();
	
	Если Статус = Перечисления.СтатусыПланов.Утвержден Тогда
		
		УСОERP_УправлениеСтроительнымПроизводством.ОтразитьДвиженияВыполнениеРаботСубподрядчиком(ДополнительныеСвойства, Движения, Отказ);
		
		ДоходыИРасходыСервер.ОтразитьСебестоимостьТоваров(ДополнительныеСвойства, Движения, Отказ);
		
		ВзаиморасчетыСервер.ОтразитьСуммыДокументаВВалютеРегл(ДополнительныеСвойства, Движения, Отказ);
		
		ДоходыИРасходыСервер.ОтразитьПрочиеРасходы(ДополнительныеСвойства, Движения, Отказ);
		
		ЗапасыСервер.ОтразитьТоварыПереданныеПереработчику(ДополнительныеСвойства, Движения, Отказ);
		
		ЗаказыСервер.ОтразитьУслугиПереработчиковКОформлению(ДополнительныеСвойства, Движения, Отказ);
		
		ВзаиморасчетыСервер.ОтразитьРасчетыСПоставщиками(ДополнительныеСвойства, Движения, Отказ);
		
		ЗатратыСервер.ОтразитьПрочиеРасходыНезавершенногоПроизводства(ДополнительныеСвойства, Движения, Отказ);
		
		ЗатратыСервер.ОтразитьМатериалыИРаботыВПроизводстве(ДополнительныеСвойства, Движения, Отказ);	
		
		УСОERP_УправлениеСтроительнымПроизводством.ОтразитьДвиженияРасходМатериаловВСтроительстве(ДополнительныеСвойства, Движения, Отказ);
		
		ОтразитьГрафикДвиженийПоДоговору(ДополнительныеСвойства, Движения, Отказ);
		
		УчетНДСУП.СформироватьДвиженияВРегистры(ДополнительныеСвойства, Движения, Отказ);
		
		РеглУчетПроведениеСервер.ЗарегистрироватьКОтражению(ЭтотОбъект, ДополнительныеСвойства, Движения, Отказ); 		
		
	КонецЕсли;
	
	СформироватьСписокРегистровДляКонтроля();
	
	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСерверУТ.ВыполнитьКонтрольРезультатовПроведения(ЭтотОбъект, Отказ);  
	
	ПроведениеСерверУТ.СформироватьЗаписиРегистровЗаданий(ЭтотОбъект);
	
	ПроведениеСерверУТ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Функция ПроверитьНаличиеДвиженийВыполнения()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_УчетВыполненныхРаботОбороты.Работа,
	|	СУММА(УСОERP_УчетВыполненныхРаботОбороты.ОбъемПриход) КАК ОбъемПриход
	|ИЗ
	|	РегистрНакопления.УСОERP_УчетВыполненныхРабот.Обороты(
	|			&НачалоРаботы,
	|			&ОкончаниеРаботы,
	|			Регистратор,
	|			Организация = &Организация
	|				И ОбъектСтроительства = &ОбъектСтроительства
	|				И Исполнитель = &Исполнитель
	|				И Работа В
	|					(ВЫБРАТЬ
	|						УСОERP_АктПриемкиРаботРаботы.Работа
	|					ИЗ
	|						Документ.УСОERP_АктПриемкиРабот.Работы КАК УСОERP_АктПриемкиРаботРаботы
	|					ГДЕ
	|						УСОERP_АктПриемкиРаботРаботы.Ссылка = &Ссылка)) КАК УСОERP_УчетВыполненныхРаботОбороты
	|ГДЕ
	|	УСОERP_УчетВыполненныхРаботОбороты.Регистратор <> &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_УчетВыполненныхРаботОбороты.Работа";
	
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Запрос.УстановитьПараметр("ОбъектСтроительства",ОбъектСтроительства);
	Запрос.УстановитьПараметр("Исполнитель",Контрагент);
	Запрос.УстановитьПараметр("НачалоРаботы",ДатаНачала);
	Запрос.УстановитьПараметр("ОкончаниеРаботы",ДатаОкончания);
	
	РезультатНаличияДвижений = Запрос.Выполнить().Выбрать();
	
	Если РезультатНаличияДвижений.Следующий() Тогда
		Если РезультатНаличияДвижений.ОбъемПриход > 0 Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	СформироватьСписокРегистровДляКонтроля();
	
	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСерверУТ.ВыполнитьКонтрольРезультатовПроведения(ЭтотОбъект, Отказ);
	
	ПроведениеСерверУТ.СформироватьЗаписиРегистровЗаданий(ЭтотОбъект);
	
	ПроведениеСерверУТ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИнициализироватьДокумент();
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка ИЛИ ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Возврат;
	КонецЕсли;
	
	Документы.СчетФактураПолученный.АктуализироватьСчетФактуру(ЭтотОбъект.Ссылка, ЭтотОбъект.Проведен);
	
КонецПроцедуры

#КонецОбласти

#Область ВидыЗапасов

Процедура ЗаполнитьВидыЗапасовДокумента(Отказ)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ТЗ = Материалы.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТЗ",ТЗ);
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("ХозяйственнаяОперация",Перечисления.ХозяйственныеОперации.РеализацияКлиенту);
	Запрос.УстановитьПараметр("ТипЗапасов",Перечисления.ТипыЗапасов.Товар);
	Запрос.УстановитьПараметр("Валюта",Валюта);
	Запрос.УстановитьПараметр("НалогообложениеНДС",Справочники.Организации.НалогообложениеНДС(Организация, , Дата));
	Запрос.УстановитьПараметр("ВидЦены",ЭтотОбъект.Договор.УСОERP_ТипЦены);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВрТаб.НомерСтроки КАК НомерСтроки,
	|	ВрТаб.Номенклатура КАК Номенклатура,
	|	ВрТаб.ВидЗапасов КАК ВидЗапасов,
	|	&Организация КАК Организация,
	|	&ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	&ТипЗапасов КАК ТипЗапасов,
	|	&Валюта КАК Валюта,
	|	&НалогообложениеНДС КАК НалогообложениеНДС
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	&ТЗ КАК ВрТаб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.НомерСтроки КАК НомерСтроки,
	|	ВрТаб.Номенклатура КАК Номенклатура,
	|	ВрТаб.Организация КАК Организация,
	|	ВрТаб.Организация КАК ВладелецТовара,
	|	ВрТаб.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	ВрТаб.ТипЗапасов КАК ТипЗапасов,
	|	ВрТаб.Валюта КАК Валюта,
	|	ВрТаб.НалогообложениеНДС КАК НалогообложениеНДС,
	|	ВрТаб.НалогообложениеНДС КАК НалогообложениеОрганизации,
	|	ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка) КАК Поставщик,
	|	НЕОПРЕДЕЛЕНО КАК Соглашение,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КАК Договор,
	|	НЕОПРЕДЕЛЕНО КАК ГруппаПродукции,
	|	&ВидЦены КАК ВидЦены,
	|	ВрТаб.ВидЗапасов КАК ТекущийВидЗапасов,
	|	ЛОЖЬ КАК ЭтоВозвратнаяТара
	|ПОМЕСТИТЬ ИсходнаяТаблицаТоваров
	|ИЗ
	|	ВрТаб КАК ВрТаб";	
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Выполнить();
	
	ЗапасыСервер.ЗаполнитьВидыЗапасовПоУмолчанию(МенеджерВременныхТаблиц, Материалы);
	
КонецПроцедуры

#КонецОбласти   

#Область Инициализация

Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Ответственный        = Пользователи.ТекущийПользователь();
	Организация          = ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Организация);
	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаВзаиморасчетов = Валюта;
	НалогообложениеНДС = Справочники.Организации.НалогообложениеНДС(Организация,, ТекущаяДата());
	
КонецПроцедуры

#КонецОбласти

#Область Прочее

Функция ПолучитьСуммуДокумента()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Работы.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	Работы.СуммаСНДС КАК Сумма
	|ПОМЕСТИТЬ Работы
	|ИЗ
	|	&Работы КАК Работы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Работы.Сумма), 0) КАК Сумма
	|ИЗ
	|	Работы КАК Работы
	|ГДЕ
	|	НЕ Работы.Работа.СуммарнаяРабота";
	
	Запрос.УстановитьПараметр("Работы", Работы.Выгрузить(,"Работа,СуммаСНДС"));	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	СуммаИтого = Выгрузка[0].Сумма;
	
	Возврат СуммаИтого;
	
КонецФункции

