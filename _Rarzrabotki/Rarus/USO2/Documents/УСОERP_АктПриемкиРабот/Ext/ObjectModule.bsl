Процедура ПроверитьНаКорректностьОбъемыИСтоимостиПринимаемыхРабот(Отказ = Ложь)
	
	Для Каждого СтрокаРабота Из Работы Цикл
		
		ДопустимыйОбъем = СтрокаРабота.ОбъемВыполнения - СтрокаРабота.ОбъемНачалоПериода;
		
		Если Не СтрокаРабота.Работа.СуммарнаяРабота
			И СтрокаРабота.ОбъемПринятыхРабот > ДопустимыйОбъем Тогда
			СообщениеОбОшибке = НСтр("ru='Принимаемый объем работы %Работа% превышает допустимый объем к приему на %Количество% %ЕдиницаИзмерения%'");
			
			СообщениеОбОшибке = СтрЗаменить(СообщениеОбОшибке, "%Работа%",          	СтрокаРабота.Работа);
			СообщениеОбОшибке = СтрЗаменить(СообщениеОбОшибке, "%Количество%",          -(ДопустимыйОбъем -  СтрокаРабота.ОбъемПринятыхРабот));
			СообщениеОбОшибке = СтрЗаменить(СообщениеОбОшибке, "%ЕдиницаИзмерения%",    СтрокаРабота.ЕдиницаОбъема);
			
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Работы", СтрокаРабота.НомерСтроки, "ОбъемПринятыхРабот");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке, Ссылка,Поле, "Объект");
			
			Отказ = Истина;
			
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

Процедура ОтразитьГрафикДвиженийПоДоговору(ДополнительныеСвойства, Движения, Отказ)
	
	ТаблицаДвижений = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаУСОERP_ГрафикДвиженийПоДоговору;
	
	Если Отказ ИЛИ ТаблицаДвижений.Количество() = 0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Движения.УСОERP_ГрафикДвиженийПоДоговору.Записывать = Истина;
	Движения.УСОERP_ГрафикДвиженийПоДоговору.Загрузить(ТаблицаДвижений);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
