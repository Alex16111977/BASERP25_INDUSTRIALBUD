	ТекущаяСтрока.СуммаСНДС = ТекущаяСтрока.Сумма;
	ТекущаяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(ТекущаяСтрока.Сумма, ТекущаяСтрока.СтавкаНДС, Истина); 	
	
