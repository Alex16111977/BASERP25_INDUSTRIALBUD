&НаСервере
Процедура ЗаполнитьСтруктуруОтбораНаСервере(СтруктураОтбора)	
	
	Если НовыйВариант Тогда
		
		СтруктураОтбора.Вставить("ДокументУтверждения",Объект.ДокументУтверждения);
		Возврат;
		
	КонецЕсли;  
	
	СтруктураОтбора.Вставить("Организация",Объект.Организация);
	СтруктураОтбора.Вставить("ОбъектСтроительства",Объект.ОбъектСтроительства);
	СтруктураОтбора.Вставить("ПометкаУдаления",Ложь);
	СтруктураОтбора.Вставить("Утверждена",Истина);	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоСубподрядчикуНаСервере(СписокРабот = Неопределено, ПолучитьСписок = Ложь)
	
	Если Не ПолучитьСписок Тогда
		Объект.Работы.Очистить();
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ИмяРегистра", "РегистрНакопления.УСОERP_ВыполнениеРаботСубподрядчиком");
	СтруктураПараметров.Вставить("Организация", Объект.Организация);
	СтруктураПараметров.Вставить("ДатаНачала", Объект.ДатаНачала);
	СтруктураПараметров.Вставить("ДатаОкончания", Объект.ДатаОкончания);
	СтруктураПараметров.Вставить("Партнер", Объект.Субподрядчик);
	СтруктураПараметров.Вставить("ДатаСреза", Объект.Дата);
	
	ИспользоватьСоглашенияСПоставщиками	=	ПолучитьФункциональнуюОпцию("УСОERP_ИспользоватьСоглашенияСПоставщиками");
	Если ИспользоватьСоглашенияСПоставщиками Тогда
		СтруктураПараметров.Вставить("Соглашение", Объект.Соглашение);
	КонецЕсли;
	
	СтруктураПараметров.Вставить("Контрагент", Объект.Контрагент);
	
	ИспользоватьДоговорыСПоставщиками	=	ПолучитьФункциональнуюОпцию("УСОERP_ИспользоватьДоговорыСПоставщиками");
	Если ИспользоватьДоговорыСПоставщиками Тогда
		СтруктураПараметров.Вставить("Договор", Объект.Договор);
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ОбъектСтроительства", Объект.ОбъектСтроительства);
	
	ДанныеПоРаботам = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьДанныеПоВыполнениюРабот(СтруктураПараметров);
	
	Если ДанныеПоРаботам.Количество() > 0 Тогда
		
		Для каждого ЭлРабота Из ДанныеПоРаботам Цикл
			Если Не ПолучитьСписок Тогда
				НоваяСтрокаТЧ = Объект.Работы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ, ЭлРабота);
			Иначе
				СписокРабот.Добавить(ЭлРабота.Работа);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ СписокРабот = Неопределено Тогда 
		
		Для Каждого Эл из СписокРабот Цикл 
			Элемент = Эл.Значение; 
			Пока ЗначениеЗаполнено(Элемент.Родитель) Цикл
				Элемент = Элемент.Родитель; 
				СписокРабот.Добавить(Элемент);
			КонецЦикла;	
		КонецЦикла;	
		
	КонецЕсли;
	
КонецПроцедуры

