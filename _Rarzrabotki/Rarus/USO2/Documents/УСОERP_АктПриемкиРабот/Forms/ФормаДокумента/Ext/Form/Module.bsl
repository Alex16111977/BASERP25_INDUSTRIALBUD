Процедура СубподрядчикПриИзменении(Элемент)
	
	ПартнерПриИзмененииСервер();
	
	КонтрагентПриИзменении(Элемент);

КонецПроцедуры

&НаСервере 
Процедура ПартнерПриИзмененииСервер() 
	
	СтруктураОтбора = Новый Структура("УчитыватьГруппыСкладов, ВыбранноеСоглашение, ПустаяСсылкаДокумента",	Истина,	Объект.Соглашение, 	Документы.ЗаказПоставщику.ПустаяСсылка());
	
	УсловияПродажПоУмолчанию = 	ЗакупкиСервер.ПолучитьУсловияЗакупокПоУмолчанию(Объект.Субподрядчик,СтруктураОтбора); 			
	
	Если УсловияПродажПоУмолчанию <> Неопределено Тогда
		
		Объект.Соглашение = УсловияПродажПоУмолчанию.Соглашение;
		
	КонецЕсли; 			
	
	ПартнерыИКонтрагенты.ЗаполнитьКонтрагентаПартнераПоУмолчанию(Объект.Субподрядчик, Объект.Контрагент);
	
КонецПроцедуры

