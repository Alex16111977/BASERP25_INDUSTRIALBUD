		Объект.СуммаДокумента = Объект.ВыполненоВсего.Итог("Сумма");
	Иначе
		Объект.СуммаДокумента = Объект.Работы.Итог("СуммаСНДС");
	КонецЕсли;

	СформироватьНадписьВалюты(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СоглашениеПриИзменении(Элемент)
	СоглашениеПриИзмененииСервер();
КонецПроцедуры 

&НаСервере
Процедура СоглашениеПриИзмененииСервер()
	
	ВалютаДокумента = Объект.Соглашение.Валюта;
	ВалютаВзаиморасчетов = Объект.Соглашение.ВалютаВзаиморасчетов;
	Объект.Валюта = ВалютаДокумента;
	Объект.ВалютаВзаиморасчетов = ВалютаВзаиморасчетов;
	РаботаСКурсамиВалютУТ.ЗаполнитьКурсКратностьПоУмолчанию(Объект.Курс, Объект.Кратность, ВалютаДокумента, ВалютаВзаиморасчетов);
	СформироватьНадписьВалюты(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВалютыСервер(НоваяВалюта)
	
	СтараяВалюта                = ВалютаДокумента;
	ДатаДокумента               = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата,ТекущаяДатаСеанса());
	СтруктураКурсовСтаройВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтараяВалюта, ДатаДокумента);
	СтруктураКурсовНовойВалюты  = РаботаСКурсамиВалют.ПолучитьКурсВалюты(НоваяВалюта,  ДатаДокумента);
	
	Для Каждого ТекСтрока ИЗ Объект.ВыполненоВсего Цикл 		
		
		ТекСтрока.Сумма = РаботаСКурсамиВалютКлиентСервер.ПересчитатьИзВалютыВВалюту(
		ТекСтрока.Сумма,
		СтараяВалюта,НоваяВалюта,
		СтруктураКурсовСтаройВалюты.Курс,СтруктураКурсовНовойВалюты.Курс,
		СтруктураКурсовСтаройВалюты.Кратность,СтруктураКурсовНовойВалюты.Кратность);
		
		ТекСтрока.СуммаСНДС = ТекСтрока.Сумма; 		
		
	КонецЦикла; 		
	
	Для Каждого ТекСтрока ИЗ Объект.Работы Цикл
		
		ТекСтрока.СуммаСНДС = РаботаСКурсамиВалютКлиентСервер.ПересчитатьИзВалютыВВалюту(
		ТекСтрока.СуммаСНДС,
		СтараяВалюта,НоваяВалюта,
		СтруктураКурсовСтаройВалюты.Курс,СтруктураКурсовНовойВалюты.Курс,
		СтруктураКурсовСтаройВалюты.Кратность,СтруктураКурсовНовойВалюты.Кратность);
		
		ТекСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(ТекСтрока.СуммаСНДС, ТекСтрока.СтавкаНДС, Истина);
		
	КонецЦикла;
	
	Объект.СуммаДокумента = ?(Объект.Работы.Количество(),Объект.Работы.Итог("СуммаСНДС"),ОБъект.ВыполненоВсего.Итог("СуммаСНДС"));	
	Объект.СуммаНДС = ?(Объект.Работы.Количество(),Объект.Работы.Итог("СуммаНДС"),ОБъект.ВыполненоВсего.Итог("СуммаНДС"));
	
	//СтруктураПересчета = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруПересчетаСуммыНДСВТЧ(Объект);
	СтруктураПересчета = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчета);
	СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
	ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Объект.ВыполненоВсего, СтруктураДействий, Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура МатериалыПередачаСырьяПриИзмененииНаСервере(ИД)
	
 ТекСтрока =   Объект.Материалы.НайтиПоИдентификатору(ИД);
 ТекСтрока.ЗаказПереработчику = ТекСтрока.ПередачаСырья.ЗаказПереработчику;
	
КонецПроцедуры

