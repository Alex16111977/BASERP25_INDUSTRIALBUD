	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.РаботыСтавкаНДС.Имя);   
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.РаботыСуммаНДС.Имя);  
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Работы.СуммарнаяРабота");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;   
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "-");  	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьКнопокЗаполнения()
	
	Элементы.ЗаполнитьМесяц.Видимость = Объект.ОбъектСтроительства.ИспользоватьМесячныеПланы;		
	Элементы.ЗаполнитьНеделя.Видимость = Объект.ОбъектСтроительства.ИспользоватьНедельноСуточныеПланы;		
	
КонецПроцедуры
// СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

&НаСервере
Процедура ДополнительныеОтчетыИОбработкиВыполнитьНазначаемуюКомандуНаСервере(ИмяЭлемента, РезультатВыполнения)
	
	ДополнительныеОтчетыИОбработки.ВыполнитьНазначаемуюКомандуНаСервере(ЭтаФорма, ИмяЭлемента, РезультатВыполнения);
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

&НаСервере
Процедура ЗаполнитьНаСервере(СписокРабот = Неопределено, ПолучитьСписок = Ложь, СписокСсылок = Неопределено)
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_АктПриемкиРабот_ЗаполнитьПоВидуПланирования(ЭтотОбъект, Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный,СписокРабот, ПолучитьСписок, СписокСсылок);
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ДокументРаспределение) Тогда
		
		СтатьяБюджета = ПолучитьСтатьюБюджета(Объект.Договор,Объект.Дата);
		
	    ТЗ = Объект.Работы.Выгрузить();
		ТЗ.ЗаполнитьЗначения(СтатьяБюджета,"СтатьяБюджета");
		Объект.Работы.Загрузить(ТЗ);
		
	КонецЕсли; 
	
	Если НовыйВариант Тогда
		ОбновитьВспомогательныеРеквизитыТабличнойЧастиРаботы();
		Объект.Работы.Сортировать("ПорядокСортировки");
	КонецЕсли;
		
	РассчитатьИтоговыеПоказатели(ЭтаФорма);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтатьюБюджета(Договор,Дата)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Договор",Договор);
	Запрос.УстановитьПараметр("Дата",Дата);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБюджетаБДР КАК СтатьяБюджета
	|ИЗ
	|	РегистрСведений.УСОERP_ДополнительныеПараметрыПоДоговору.СрезПоследних(
	|			&Дата,
	|			Договор = &Договор
	|				И Регистратор ССЫЛКА Документ.УСОERP_ДополнительныеПараметрыПоДоговору) КАК УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий()Тогда
		Возврат Выборка.СтатьяБюджета;
	КонецЕсли;
	
	Возврат Справочники.СтатьиБюджетов.ПустаяСсылка(); 	
	
КонецФункции  

&НаСервере
Процедура ЗаполнитьНаСервереМесяц()
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_АктПриемкиРабот_ЗаполнитьПоВидуПланирования(ЭтотОбъект, Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Месячный);
	Если НовыйВариант Тогда
		ОбновитьВспомогательныеРеквизитыТабличнойЧастиРаботы();
		Объект.Работы.Сортировать("ПорядокСортировки");
	КонецЕсли;
	РассчитатьИтоговыеПоказатели(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервереНеделя()
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_АктПриемкиРабот_ЗаполнитьПоВидуПланирования(ЭтотОбъект, Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.НедельноСуточный);
	Если НовыйВариант Тогда
		ОбновитьВспомогательныеРеквизитыТабличнойЧастиРаботы();
		Объект.Работы.Сортировать("ПорядокСортировки");
	КонецЕсли;
	РассчитатьИтоговыеПоказатели(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ДоИзменения_ЗаполнитьПоВидуПланирования(ВидПланирования,СписокРабот = Неопределено, ПолучитьСписок = Ложь, СписокСсылок = Неопределено, КэшированныеЗначения = Неопределено,ОбновитьПараметры = ложь)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	УСОERP_СценарииПланированияПроектовСтроительства.Владелец КАК СтроительныйПроект,
	|	УСОERP_СценарииПланированияПроектовСтроительства.Ссылка КАК СценарийПланирования,
	|	УСОERP_СтроительныеРаботы.Ссылка КАК СтроительнаяРабота
	|ПОМЕСТИТЬ ВТ_РаботыПроекта
	|ИЗ
	|	Справочник.УСОERP_СценарииПланированияПроектовСтроительства КАК УСОERP_СценарииПланированияПроектовСтроительства
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|			ПО УСОERP_СценарииПланированияПроектовСтроительства.Ссылка = УСОERP_СтроительныеРаботы.Владелец
	|ГДЕ
	|	УСОERP_СценарииПланированияПроектовСтроительства.Владелец = &ОбъектСтроительства
	|;
	| ВЫБРАТЬ
	|	ДанныеПоРаботам.Работа,
	|	ДанныеПоРаботам.Партнер,
	|	ДанныеПоРаботам.Контрагент,
	|	ДанныеПоРаботам.Соглашение,
	|	ДанныеПоРаботам.Договор,
	|	ДанныеПоРаботам.ОбъемОстаток,
	|	ДанныеПоРаботам.Организация,
	|	ДанныеПоРаботам.ОбъектСтроительства
	|ПОМЕСТИТЬ ДанныеПоРаботам
	|ИЗ
	| РегистрНакопления.УСОERP_ВыполнениеРаботСубподрядчиком.Остатки(&ДатаСреза, Организация = &Организация
	|				И ОбъектСтроительства = &ОбъектСтроительства  " + ?(НЕ ПолучитьСписок, "
	|				И Работа В (&Работы)
	|				И Работа В
	|					(ВЫБРАТЬ
	|						Работы.СтроительнаяРабота
	|					ИЗ
	|						ВТ_РаботыПроекта КАК Работы)", "") + ")  КАК ДанныеПоРаботам
	|ГДЕ
	|	ДанныеПоРаботам.ОбъемОстаток > 0	
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РаботыПроекта.СтроительныйПроект,
	|	ВТ_РаботыПроекта.СценарийПланирования,
	|	ВТ_РаботыПроекта.СтроительнаяРабота КАК Работа,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Период,
	|	ВЫБОР
	|		КОГДА УСОERP_ПараметрыВыполненияРаботСрезПоследних.НачалоРаботыПлан > &НачалоРаботы
	|			ТОГДА УСОERP_ПараметрыВыполненияРаботСрезПоследних.НачалоРаботыПлан
	|		ИНАЧЕ &НачалоРаботы
	|	КОНЕЦ КАК ДатаНачала,
	|	ВЫБОР
	|		КОГДА УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОкончаниеРаботыПлан < &ОкончаниеРаботы
	|			ТОГДА УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОкончаниеРаботыПлан
	|		ИНАЧЕ &ОкончаниеРаботы
	|	КОНЕЦ КАК ДатаОкончания
	|ПОМЕСТИТЬ Работы
	|ИЗ
	|	ВТ_РаботыПроекта КАК ВТ_РаботыПроекта
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(&ДатаСреза, ВидПланирования = &ВидПланирования И Утверждена = Истина) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
	|		ПО ВТ_РаботыПроекта.СтроительнаяРабота = УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеПоРаботам
	|		ПО ВТ_РаботыПроекта.СтроительнаяРабота = ДанныеПоРаботам.Работа
	|ГДЕ
	|	(УСОERP_ПараметрыВыполненияРаботСрезПоследних.НачалоРаботыПлан >= &НачалоРаботы
	|				И УСОERP_ПараметрыВыполненияРаботСрезПоследних.НачалоРаботыПлан <= &ОкончаниеРаботы
	|			ИЛИ УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОкончаниеРаботыПлан >= &НачалоРаботы
	|				И УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОкончаниеРаботыПлан <= &ОкончаниеРаботы
	|			ИЛИ УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОкончаниеРаботыПлан >= &НачалоРаботы
	|				И УСОERP_ПараметрыВыполненияРаботСрезПоследних.НачалоРаботыПлан <= &НачалоРаботы
	|			ИЛИ УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа В (&Работы))
	|;
	|ВЫБРАТЬ
	|	УСОERP_УчетВыполненияОбъемовРаботОбороты.Работа,
	|	СУММА(УСОERP_УчетВыполненияОбъемовРаботОбороты.ОбъемПриход) КАК ОбъемВыполнено
	|ПОМЕСТИТЬ УчетВыполненияОбъемовРабот
	|ИЗ
	|	РегистрНакопления.УСОERP_УчетВыполненныхРабот.Обороты(
	|			,
	|			,
	|			,
	|			Организация = &Организация
	|				И ОбъектСтроительства = &ОбъектСтроительства  " + ?(НЕ ПолучитьСписок, "
	|				И Работа В (&Работы)
	|				И Работа В
	|					(ВЫБРАТЬ
	|						Работы.Работа
	|					ИЗ
	|						Работы КАК Работы)", "") + ") КАК УСОERP_УчетВыполненияОбъемовРаботОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_УчетВыполненияОбъемовРаботОбороты.Работа
	|;
	|ВЫБРАТЬ
	|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Работа,
	|	СУММА(УСОERP_ВыполнениеРаботСубподрядчикомОбороты.СуммаСНДСПриход) КАК СтоимостьРаботы
	|ПОМЕСТИТЬ ВРСубподрядчикомСтоимость
	|ИЗ
	|	РегистрНакопления.УСОERP_ВыполнениеРаботСубподрядчиком.Обороты(
	|			,
	|			,
	|			,
	|			Организация = &Организация
	|				И ОбъектСтроительства = &ОбъектСтроительства  " + ?(НЕ ПолучитьСписок, "
	|				И Работа В (&Работы)
	|				И Работа В
	|					(ВЫБРАТЬ
	|						Работы.Работа
	|					ИЗ
	|						Работы КАК Работы)", "") + ") КАК УСОERP_ВыполнениеРаботСубподрядчикомОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Работа
	|;
	|ВЫБРАТЬ
	|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Работа,
	|	СУММА(УСОERP_ВыполнениеРаботСубподрядчикомОбороты.ОбъемРасход) КАК ОбъемПринято,
	|	СУММА(УСОERP_ВыполнениеРаботСубподрядчикомОбороты.СуммаСНДСРасход) КАК СтоимостьПринято
	|ПОМЕСТИТЬ ВРСубподрядчикомПринято
	|ИЗ
	|	РегистрНакопления.УСОERP_ВыполнениеРаботСубподрядчиком.Обороты(
	|			,
	|			&НачалоРаботы,
	|			,
	|			Организация = &Организация
	|				И ОбъектСтроительства = &ОбъектСтроительства  " + ?(НЕ ПолучитьСписок, "
	|				И Работа В (&Работы)
	|				И Работа В
	|					(ВЫБРАТЬ
	|						Работы.Работа
	|					ИЗ
	|						Работы КАК Работы)", "") + ") КАК УСОERP_ВыполнениеРаботСубподрядчикомОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Работа
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ
	|	Работы.Работа,
	|	ЕСТЬNULL(УчетВыполненияОбъемовРабот.ОбъемВыполнено,0) КАК ОбъемВыполнения,
	|	ЕСТЬNULL(ВРСубподрядчикомСтоимость.СтоимостьРаботы,0) КАК СтоимостьВсего,
	|	ЕСТЬNULL(ВРСубподрядчикомПринято.ОбъемПринято,0) КАК ОбъемНачалоПериода,
	|	ЕСТЬNULL(ВРСубподрядчикомПринято.СтоимостьПринято,0) КАК СуммаСНДСНачалоПериода
	|ПОМЕСТИТЬ Табл
	|ИЗ
	|	Работы КАК Работы
	|	ЛЕВОЕ СОЕДИНЕНИЕ УчетВыполненияОбъемовРабот КАК УчетВыполненияОбъемовРабот
	|	ПО Работы.Работа = УчетВыполненияОбъемовРабот.Работа
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВРСубподрядчикомСтоимость КАК ВРСубподрядчикомСтоимость
	|	ПО Работы.Работа = ВРСубподрядчикомСтоимость.Работа
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВРСубподрядчикомПринято КАК ВРСубподрядчикомПринято
	|	ПО Работы.Работа = ВРСубподрядчикомПринято.Работа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Работы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ УчетВыполненияОбъемовРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВРСубподрядчикомСтоимость
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВРСубподрядчикомПринято
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Табл.Работа,
	|	Табл.ОбъемВыполнения,
	|	Табл.ОбъемНачалоПериода,
	|	Табл.СтоимостьВсего,
	|	Табл.СуммаСНДСНачалоПериода
	|ИЗ
	|	Табл КАК Табл";
	
	Если СписокРабот = Неопределено Тогда 
		Если НЕ ПолучитьСписок Тогда 	
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИЛИ Работа В (&Работы)", "");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Работа В (&Работы)", "");	
			Объект.Работы.Очистить(); 
		КонецЕсли;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИЛИ УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа В (&Работы)", "");		
	Иначе 	
		Запрос.УстановитьПараметр("Работы", СписокРабот);
	КонецЕсли;
	Запрос.УстановитьПараметр("ВидПланирования", 	ВидПланирования);
	Запрос.УстановитьПараметр("Организация", 	 	Объект.Организация);
	Запрос.УстановитьПараметр("ОбъектСтроительства",Объект.ОбъектСтроительства);
	Запрос.УстановитьПараметр("НачалоРаботы",    	Объект.ДатаНачала);
	Запрос.УстановитьПараметр("ОкончаниеРаботы", 	Объект.ДатаОкончания);
	Запрос.УстановитьПараметр("ДатаСреза",      	Объект.Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СтруктураДействий = Новый Структура;	
	СтруктураДействий.Вставить("УправлениеСтоительнымПроизводством_ПересчитатьСуммуНДС");
	
	Пока Выборка.Следующий() Цикл
		Если ПолучитьСписок Тогда 
			СписокСсылок.Добавить(Выборка.Работа);	
		Иначе 	
			
			Если СписокРабот = Неопределено Тогда 
				
				НоваяРабота        = Объект.Работы.Добавить();  
				ЗаполнитьЗначенияСвойств(НоваяРабота, Выборка);
				РаботыРаботаПриИзмененииНаСервере(НоваяРабота.ПолучитьИдентификатор());
				НоваяРабота.ОбъемПринятыхРабот				= НоваяРабота.ОбъемВыполнения - НоваяРабота.ОбъемНачалоПериода;
				НоваяРабота.ПроцентВыполнения               = ?(НоваяРабота.ОбъемОбщий = 0, 0, Окр(НоваяРабота.ОбъемВыполнения * 100 / НоваяРабота.ОбъемОбщий, 2));
				НоваяРабота.ПроцентПринятыхРабот 			= ?(НоваяРабота.ОбъемОбщий = 0, 0, Окр(НоваяРабота.ОбъемПринятыхРабот * 100 / НоваяРабота.ОбъемОбщий, 2));	
				НоваяРабота.ПроцентПринятоНаНачалоПериода 	= ?(НоваяРабота.ОбъемОбщий = 0, 0, Окр(НоваяРабота.ОбъемНачалоПериода * 100 / НоваяРабота.ОбъемОбщий, 2));
				НоваяРабота.СуммаСНДС						= ?(НоваяРабота.ОбъемОбщий = 0, 0, Окр(НоваяРабота.СтоимостьВсего * НоваяРабота.ОбъемПринятыхРабот / НоваяРабота.ОбъемОбщий,2));
				ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяРабота, СтруктураДействий, КэшированныеЗначения);
				НоваяРабота.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(НоваяРабота.СуммаСНДС, НоваяРабота.СтавкаНДС, Истина);
				
			Иначе 
				
				СтрокаРаботы = Объект.Работы.НайтиСтроки(Новый Структура("Работа", Выборка.Работа));
				
				Для Каждого Эл из СтрокаРаботы Цикл 
					ЗаполнитьЗначенияСвойств(Эл, Выборка);
					
					Эл.ПроцентВыполнения    			= ?(Эл.ОбъемОбщий = 0, 0, Окр(Эл.ОбъемВыполнения * 100 / Эл.ОбъемОбщий, 2));
					Эл.ПроцентПринятыхРабот 			= ?(Эл.ОбъемОбщий = 0, 0, Окр(Эл.ОбъемПринятыхРабот * 100 / Эл.ОбъемОбщий, 2));	
					Эл.ПроцентПринятоНаНачалоПериода 	= ?(Эл.ОбъемОбщий = 0, 0, Окр(Эл.ОбъемНачалоПериода * 100 / Эл.ОбъемОбщий, 2));	
					
				КонецЦикла;	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ СписокСсылок = Неопределено Тогда 
		Для Каждого Эл из СписокСсылок Цикл 
			Элемент = Эл.Значение; 
			Пока ЗначениеЗаполнено(Элемент.Родитель) Цикл
				Элемент = Элемент.Родитель; 
				СписокСсылок.Добавить(Элемент);
			КонецЦикла;	
		КонецЦикла;	
	КонецЕсли;
	
	РассчитатьИтоговыеПоказатели(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение)
	
	СписокРаботОбновить = Новый СписокЗначений;	
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда 
		Для Каждого Элем из ВыбранноеЗначение Цикл 
			СтрокиРабот = Объект.Работы.НайтиСтроки(Новый Структура("Работа",Элем));
			Если СтрокиРабот.Количество() = 0 Тогда 
				ТекущаяСтрока = Объект.Работы.Добавить();
				ТекущаяСтрока.Работа = Элем;
				ТекущаяСтрока.СтатьяБюджета = ПолучитьСтатьюБюджета(Объект.Договор,Объект.Дата);
				РаботыРаботаПриИзмененииНаСервере(ТекущаяСтрока.ПолучитьИдентификатор());
				СписокРаботОбновить.Добавить(Элем);
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;	
	ЗаполнитьНаСервере(СписокРаботОбновить);
	
КонецПроцедуры

&НаСервере
Процедура РаботыДлительностьПриИзмененииНаСервере(ИдентификаторСтроки)
	ТекущаяСтрока = Объект.Работы.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ЗначениеЗаполнено(ТекущаяСтрока.ДатаОкончания) Тогда 		
		ТекущаяСтрока.ДатаНачала    = УСОERP_УправлениеСтроительнымПроизводством.РассчитатьНачалоПериода(ТекущаяСтрока.Работа, ТекущаяСтрока.ДатаОкончания, ТекущаяСтрока.Длительность, ТекущаяСтрока.ЕдиницаДлительности);			
	ИначеЕсли ЗначениеЗаполнено(ТекущаяСтрока.ДатаНачала) Тогда 
		ТекущаяСтрока.ДатаОкончания = УСОERP_УправлениеСтроительнымПроизводством.РассчитатьОкончаниеПериода(ТекущаяСтрока.Работа, ТекущаяСтрока.ДатаНачала, ТекущаяСтрока.Длительность, ТекущаяСтрока.ЕдиницаДлительности);
	КонецЕсли;			
КонецПроцедуры  

&НаСервере
Процедура РаботыРаботаПриИзмененииНаСервере(ИдентификаторСтроки) Экспорт
	
	ТекущаяСтрока = Объект.Работы.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если НовыйВариант Тогда
		
		ТекущаяСтрока.ОбъемОбщий       	  = ТекущаяСтрока.Работа.ОбъемРаботы;
		ТекущаяСтрока.Длительность 		  = ТекущаяСтрока.Работа.Длительность;
		ТекущаяСтрока.ЕдиницаОбъема       = ТекущаяСтрока.Работа.ЕдиницаОбъема;
		ТекущаяСтрока.ЕдиницаДлительности = ТекущаяСтрока.Работа.ЕдиницаДлительности;
		
	Иначе
		
		Результат = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьДанныеРаботы(ТекущаяСтрока.Работа,Объект.Дата);
		
		ТекущаяСтрока.ОбъемОбщий       	  = Результат.ОбъемОбщий;
		ТекущаяСтрока.Длительность 		  = Результат.ДлительностьПлан;
		ТекущаяСтрока.ЕдиницаОбъема       = Результат.ЕдиницаОбъема;
		ТекущаяСтрока.ЕдиницаДлительности = Результат.ЕдиницаДлительности;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.СтавкаНДС) Тогда
		ТекущаяСтрока.СтавкаНДС             = ?(ЗначениеЗаполнено(Объект.Договор.СтавкаНДС),Объект.Договор.СтавкаНДС,Перечисления.СтавкиНДС.НДС18);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПодчиненныйДокумент(ИмяДокумента)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Док.Ссылка
	|ИЗ
	|	Документ." + ИмяДокумента + " КАК Док
	|ГДЕ
	|	Док.УСОERP_Основание = &Ссылка
	|	И НЕ Док.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область ПриИзмененииРеквизитов

&НаСервере
Процедура ПриИзмененииОрганизацииСервер()
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		
		НастроитьПредставлениеСчетаФактуры();			
		
	КонецЕсли;
	
	Объект.НалогообложениеНДС = Справочники.Организации.НалогообложениеНДС(Объект.Организация,, Объект.Дата);
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииСервер()
	
	ОтветственныеЛицаСервер.ПриИзмененииСвязанныхРеквизитовДокумента(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПериода(ДатаПериод)
	
	Если ДатаПериод = Объект.ДатаНачала Тогда 
		Объект.ДатаНачала    = НачалоДня(ДатаПериод); 
		Объект.ДатаОкончания = ?(Объект.ДатаНачала > Объект.ДатаОкончания, КонецДня(Объект.ДатаНачала), КонецДня(Объект.ДатаОкончания));
	Иначе 
		Объект.ДатаОкончания = КонецДня(ДатаПериод);
		Объект.ДатаНачала = ?(Объект.ДатаНачала > Объект.ДатаОкончания, НачалоДня(Объект.ДатаОкончания), НачалоДня(Объект.ДатаНачала));
	КонецЕсли;
	Если Объект.Дата < Объект.ДатаНачала ИЛИ Объект.Дата > Объект.ДатаОкончания Тогда 
		Объект.Дата = Объект.ДатаНачала;	
	КонецЕсли;		
	
КонецПроцедуры

#КонецОбласти

#Область Прочее

&НаКлиенте
Процедура ТекстСчетФактураОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	ПараметрыРегистрации = ПараметрыРегистрацииСчетовФактурПолученных(Объект);
	УчетНДСУПКлиент.ОбработкаНавигационнойСсылкиСчетаФактурыПолученные(
		ЭтаФорма,
		НавигационнаяСсылкаФорматированнойСтроки,
		СтандартнаяОбработка,
		ПараметрыРегистрации);
	
КонецПроцедуры  	

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыРегистрацииСчетовФактурПолученных(Объект)
	
	ПараметрыРегистрации = УчетНДСУПКлиентСервер.ПараметрыРегистрацииСчетовФактурПолученных();
	ПараметрыРегистрации.Ссылка = Объект.Ссылка;
	ПараметрыРегистрации.Организация = Объект.Организация;
	ПараметрыРегистрации.Контрагент = Объект.Контрагент;
	ПараметрыРегистрации.НалогообложениеНДС = Объект.НалогообложениеНДС;
	ПараметрыРегистрации.ПриобретениеТоваровРаботУслуг = Истина;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции  

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ВалютаДокумента = Объект.Валюта;
	ВалютаВзаиморасчетовДокумента = Объект.ВалютаВзаиморасчетов;
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	РассчитатьИтоговыеПоказатели(ЭтаФорма);  	
	
	НастроитьПредставлениеСчетаФактуры();
	
	ОбновитьВспомогательныеРеквизитыТабличнойЧастиРаботы();
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьВидимостьЭлементовПоВидуОперацииСервер()
	
	Перем МассивВсехРеквизитов;
	Перем МассивРеквизитовОперации;
	
	Документы.УСОERP_АктПриемкиРабот.ЗаполнитьИменаРеквизитовПоОперации(
	Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика,
	МассивВсехРеквизитов,
	МассивРеквизитовОперации);
	ДенежныеСредстваСервер.УстановитьВидимостьЭлементовПоМассиву(
	Элементы,
	МассивВсехРеквизитов,
	МассивРеквизитовОперации);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьПредставлениеСчетаФактуры(НеТребуетсяВводСчетаФактуры = Неопределено)  	

	ПараметрыРегистрации = ПараметрыРегистрацииСчетовФактурПолученных(Объект);
	СчетаФактурыПолученныеНаОсновании = УчетНДСУП.СчетаФактурыПолученныеНаОсновании(ПараметрыРегистрации);
	
	ТекстСчетФактура = СчетаФактурыПолученныеНаОсновании.Представление; 
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьИтоговыеПоказатели(Форма)
	
	Форма.СуммаВсего = Форма.Объект.Работы.Итог("СуммаСНДС");
	Форма.СуммаНДС   = Форма.Объект.Работы.Итог("СуммаНДС");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьИтоговыеПоказатели(Форма, ПриемкаОтСубподрядчика)
	
	Форма.Элементы.СуммаНДС.Видимость        		 = ПриемкаОтСубподрядчика;
	Форма.Элементы.СуммаВсегоСНДС.Видимость  		 = ПриемкаОтСубподрядчика;
	Форма.Элементы.ГруппаИтогиТЧ.Видимость     		 = ПриемкаОтСубподрядчика;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСерверПодчиненныйДокумент()
	
	ПодчиненныйДокументПоступления 					= ПолучитьПодчиненныйДокумент("ПриобретениеТоваровУслуг");
	ВидимостьПодчиненныйДокумент(ЭтаФорма, ПодчиненныйДокументПоступления);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьПодчиненныйДокумент(Форма, ПодчиненныйДокументПоступления)
	
	Если ПодчиненныйДокументПоступления.Пустая() Тогда 
		Форма.Элементы.СформироватьПоступление.Заголовок	    = "Сформировать документ ""Поступление товаров и услуг""";
		Форма.Элементы.КартинкаСформироватьПоступление.Картинка	= Новый Картинка();
	Иначе 	
		Форма.Элементы.СформироватьПоступление.Заголовок        = "" + ПодчиненныйДокументПоступления;
		Если ПодчиненныйДокументПоступления.Проведен Тогда
			Форма.Элементы.КартинкаСформироватьПоступление.Картинка = БиблиотекаКартинок.ДокументПроведенКоннекторНиз;			
		ИначеЕсли ПодчиненныйДокументПоступления.ПометкаУдаления Тогда
			Форма.Элементы.КартинкаСформироватьПоступление.Картинка = БиблиотекаКартинок.ДокументПомеченНаУдалениеКоннекторНиз;			
		Иначе
			Форма.Элементы.КартинкаСформироватьПоступление.Картинка = БиблиотекаКартинок.ДокументЗаписанКоннекторНиз;			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектСтроительстваПриИзменении(Элемент)
	
	УстановитьВидимостьКнопокЗаполнения();
	
	Объект.ДокументУтверждения = УСОERP_ЗащищенныеФункцииСервер.ПолучитьПоследнийДокументУтверждения(Объект.ОбъектСтроительства,Объект.Организация);
	ДокументУтвержденияПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СоглашениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЗакупкиКлиент.НачалоВыбораСоглашенияСПоставщиком(
	Элемент,
	СтандартнаяОбработка,
	Объект.Субподрядчик,
	Объект.Соглашение,
	Объект.Дата);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборПериода(Команда)
	
	ТекстВопроса = НСтр("ru='Редактирование периода приведет к очистке табличных частей документа. Продолжить редактирование?'");
	
	Оповещение = Новый ОписаниеОповещения("ПродолжитьРедактирование", ЭтаФорма);
	ПоказатьВопрос(Оповещение,ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьРедактирование(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.Работы.Очистить();
		Оповещение = Новый ОписаниеОповещения(
		"РезультатВыбораПериода",
		ЭтотОбъект);
		
		ОбщегоНазначенияУТКлиент.РедактироватьПериод(
		Объект, 
		Новый Структура("ДатаНачала, ДатаОкончания", "ДатаНачала", "ДатаОкончания"),
		Оповещение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РезультатВыбораПериода(Результат, ДополнительныеПараметры) Экспорт
	
	Если Объект.Работы.Количество() > 0 Тогда
		ОчиститьТабличнуюЧасть(Результат, "ВыборПериода");
	ИначеЕсли Результат <> Неопределено Тогда
		Объект.ДатаНачала = Результат.ДатаНачала;
		Объект.ДатаОкончания = Результат.ДатаОкончания; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТабличнуюЧасть(ВыбранноеЗначение, ИмяЭлемента)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Значение", ВыбранноеЗначение);
	ДопПараметры.Вставить("Имя", ИмяЭлемента);
	
	Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеЗакрытияВопроса", ЭтаФорма, ДопПараметры);
	ПоказатьВопрос(Оповещение, "Табличная часть ""Работы"" будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеЗакрытияВопроса(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	Иначе
		Объект.Работы.Очистить();
		
		Если ТипЗнч(ДопПараметры.Значение) = Тип("СправочникСсылка.СМ_ОбъектыСтроительства") Тогда
			Объект.ОбъектСтроительства = ДопПараметры.Значение;
		ИначеЕсли ТипЗнч(ДопПараметры.Значение) = Тип("СправочникСсылка.Контрагенты") Тогда
			Объект.Контрагент = ДопПараметры.Значение;
		ИначеЕсли ТипЗнч(ДопПараметры.Значение) = Тип("СправочникСсылка.Партнеры") Тогда
			Объект.Субподрядчик = ДопПараметры.Значение;
		ИначеЕсли ТипЗнч(ДопПараметры.Значение) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			Объект.Договор = ДопПараметры.Значение;	
		ИначеЕсли ТипЗнч(ДопПараметры.Значение) = Тип("Дата") Тогда
			Если ДопПараметры.Имя = "ДатаНачалаПериода" Тогда
				Объект.ДатаНачала = ДопПараметры.Значение;
			Иначе
				Объект.ДатаОкончания = ДопПараметры.Значение;
			КонецЕсли;
		ИначеЕсли ТипЗнч(ДопПараметры.Значение) = Тип("Структура") Тогда
			Объект.ДатаНачала = ДопПараметры.Значение.НачалоПериода;
			Объект.ДатаОкончания = ДопПараметры.Значение.КонецПериода;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОчисткуРаботы(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	Иначе
		Объект.Работы.Очистить();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммаСНДСНаСервере(ТекущаяСтрока)
	
	ТекущаяСтрока.СуммаСНДС = Окр(ТекущаяСтрока.СуммаЗаказчика * ТекущаяСтрока.ПонижающийКоэффициент / 100, 2);	
	
КонецПроцедуры

&НаКлиенте
Процедура РаботыРаботаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;	
	
	СтруктураОтбора = Новый Структура;
	ЗаполнитьСтруктуруОтбораНаСервере(СтруктураОтбора); 	
	ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаПодбора",СтруктураОтбора,ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область КлючевыеРеквизитыЗаполненияФормы

// Функция возвращает описание таблиц формы подключенных к механизму ключевых реквизитов формы.
&НаСервере
Функция КлючевыеРеквизитыЗаполненияФормыТаблицыОчищаемыеПриИзменении() Экспорт
	Массив = Новый Массив;
	Массив.Добавить("Объект.Работы");
	Возврат Массив;
КонецФункции 

// Функция возвращает массив реквизитов формы подключенных к механизму ключевых реквизитов формы.
&НаСервере
Функция КлючевыеРеквизитыЗаполненияФормыОписаниеКлючевыхРеквизитов() Экспорт
	Массив = Новый Массив;
	Массив.Добавить(Новый Структура("ЭлементФормы, Представление", "Организация",					Нстр("ru = 'организации'")));
	Массив.Добавить(Новый Структура("ЭлементФормы, Представление", "ДатаНачалаРабот",				Нстр("ru = 'периода'")));
	Массив.Добавить(Новый Структура("ЭлементФормы, Представление", "ДатаОкончанияРабот",			Нстр("ru = 'периода'")));
	Массив.Добавить(Новый Структура("ЭлементФормы, Представление", "ОбъектСтроительства", 			Нстр("ru = 'объекта строительства'")));
	Возврат Массив;
КонецФункции

&НаКлиенте
Процедура РаботыПослеУдаления(Элемент)
	РассчитатьИтоговыеПоказатели(ЭтаФорма);
	СформироватьНадписьВалюты(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура РаботыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	РассчитатьИтоговыеПоказатели(ЭтаФорма);
	СформироватьНадписьВалюты(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ОбновитьВспомогательныеРеквизитыТабличнойЧастиРаботы()
	
	Для Каждого СтрокаРабота Из Объект.Работы Цикл
		
		СтрокаРабота.СуммарнаяРабота = СтрокаРабота.Работа.СуммарнаяРабота;
		СтрокаРабота.ДоступноКПриему = СтрокаРабота.ОбъемВыполнения - СтрокаРабота.ОбъемНачалоПериода;
		СтрокаРабота.СтоимостьДоступнаяКПриему = СтрокаРабота.СуммаВыполнения - СтрокаРабота.СуммаСНДСНачалоПериода;
		СтрокаРабота.ПорядокСортировки = ?(ПустаяСтрока(СтрокаРабота.Работа.ПорядокСортировки),Справочники.УСОERP_СтроительныеРаботы.ПорядокСортировки(СтрокаРабота.Работа.КодСДР),СтрокаРабота.Работа.ПорядокСортировки);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокВладельцев(ОбъектСтроительства)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_СценарииПланированияПроектовСтроительства.Ссылка КАК Владелец
	|ИЗ
	|	Справочник.УСОERP_СценарииПланированияПроектовСтроительства КАК УСОERP_СценарииПланированияПроектовСтроительства
	|ГДЕ
	|	УСОERP_СценарииПланированияПроектовСтроительства.Владелец = &ОбъектСтроительств
	|	И УСОERP_СценарииПланированияПроектовСтроительства.ВидСценария = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыСценариевПланирования.Рабочий)";
	Запрос.УстановитьПараметр("ОбъектСтроительств", ОбъектСтроительства);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса.ВыгрузитьКолонку("Владелец");
	
КонецФункции

&НаСервере
Процедура ЗаполнитьВыполненоВсегоНаСервере()
	
	Если НЕ ЗначениеЗаполнено(Объект.ОбъектСтроительства.НоменклатураРаботЗаказчика) Тогда
		ТекстОшибки = НСтр("ru='Для объекта строительства не заполнен реквизит ""Номенклатура работ при отгрузке заказчику"".'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕдиницыИзмерения.Ссылка КАК Штука
	|ПОМЕСТИТЬ ЕдиницаИзмерения
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК ЕдиницыИзмерения
	|ГДЕ
	|	НЕ ЕдиницыИзмерения.ПометкаУдаления
	|	И ЕдиницыИзмерения.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.КоличествоШтук)
	|	И ЕдиницыИзмерения.НаименованиеПолное ПОДОБНО ""Штука""
	|	И ЕдиницыИзмерения.Владелец = ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.БазовыеЕдиницыИзмерения)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Работы.СуммаСНДС КАК Сумма,
	|	Работы.СтавкаНДС КАК СтавкаНДС,
	|	Работы.СуммаНДС КАК СуммаНДС,
	|	Работы.Работа КАК Работа
	|ПОМЕСТИТЬ ТЧ_Работы
	|ИЗ
	|	&Работы КАК Работы
	|ГДЕ
	|	НЕ Работы.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)
	//|	И ВЫРАЗИТЬ(Работы.Работа КАК Справочник.УСОERP_СтроительныеРаботы).СуммарнаяРабота = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ВТ_ДопПараметры
	|ИЗ
	|	РегистрСведений.УСОERP_ДополнительныеПараметрыПоДоговору.СрезПоследних(
	|			&Дата,
	|			Договор = &Договор
	|				И ОбъектСтроительства = &ОбъектСтроительства) КАК УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_ДопПараметры.Регистратор.ПредусмотреныГарантийныеУдержанияПоДоговору, ЛОЖЬ) = ЛОЖЬ
	|			ТОГДА 0
	|		КОГДА ЕСТЬNULL(УСОERP_ДополнительныеПараметрыПоДоговоруПроцентГарантийныхУдержанийПоРаботам.ЗначениеПроцентаГарантийногоУдержания, 0) <> 0
	|			ТОГДА УСОERP_ДополнительныеПараметрыПоДоговоруПроцентГарантийныхУдержанийПоРаботам.ЗначениеПроцентаГарантийногоУдержания * ТЧ_Работы.Сумма / 100
	|		КОГДА ЕСТЬNULL(УСОERP_ДополнительныеПараметрыПоДоговоруПроцентГарантийныхУдержанийПоВидамРабот.ЗначениеПроцентаГарантийногоУдержания, 0) <> 0
	|			ТОГДА УСОERP_ДополнительныеПараметрыПоДоговоруПроцентГарантийныхУдержанийПоВидамРабот.ЗначениеПроцентаГарантийногоУдержания * ТЧ_Работы.Сумма / 100
	|		ИНАЧЕ ВТ_ДопПараметры.Регистратор.ПроцентГарантийныхУдержаний * ТЧ_Работы.Сумма / 100
	|	КОНЕЦ КАК СуммаГУ,
	|	ТЧ_Работы.СтавкаНДС КАК СтавкаНДС,
	|	ТЧ_Работы.СуммаНДС КАК СуммаНДС,
	|	ТЧ_Работы.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_РаботыСГУ
	|ИЗ
	|	ТЧ_Работы КАК ТЧ_Работы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДопПараметры КАК ВТ_ДопПараметры
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УСОERP_ДополнительныеПараметрыПоДоговору.ПроцентГарантийныхУдержанийПоРаботам КАК УСОERP_ДополнительныеПараметрыПоДоговоруПроцентГарантийныхУдержанийПоРаботам
	|		ПО ТЧ_Работы.Работа = УСОERP_ДополнительныеПараметрыПоДоговоруПроцентГарантийныхУдержанийПоРаботам.Работа
	|			И (УСОERP_ДополнительныеПараметрыПоДоговоруПроцентГарантийныхУдержанийПоРаботам.Ссылка В
	|				(ВЫБРАТЬ
	|					ВТ_ДопПараметры.Регистратор КАК Регистратор
	|				ИЗ
	|					ВТ_ДопПараметры КАК ВТ_ДопПараметры))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УСОERP_ДополнительныеПараметрыПоДоговору.ПроцентГарантийныхУдержанийПоВидамРабот КАК УСОERP_ДополнительныеПараметрыПоДоговоруПроцентГарантийныхУдержанийПоВидамРабот
	|		ПО (ВЫРАЗИТЬ(ТЧ_Работы.Работа КАК Справочник.УСОERP_СтроительныеРаботы).ВидРабот = УСОERP_ДополнительныеПараметрыПоДоговоруПроцентГарантийныхУдержанийПоВидамРабот.ВидРабот)
	|			И (УСОERP_ДополнительныеПараметрыПоДоговоруПроцентГарантийныхУдержанийПоВидамРабот.Ссылка В
	|				(ВЫБРАТЬ
	|					ВТ_ДопПараметры.Регистратор КАК Регистратор
	|				ИЗ
	|					ВТ_ДопПараметры КАК ВТ_ДопПараметры))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_ОбъектыСтроительства.НоменклатураРаботЗаказчика КАК Номенклатура,
	|	СМ_ОбъектыСтроительства.НоменклатураРаботЗаказчика.ГруппаАналитическогоУчета КАК НоменклатурнаяГруппа,
	|	1 КАК КоличествоУпаковок,
	|	ЕдиницаИзмерения.Штука КАК Упаковка,
	|	СУММА(ТЧ_Работы.Сумма) КАК Цена,
	|	СУММА(ТЧ_Работы.Сумма) КАК Сумма,
	|	СУММА(ТЧ_Работы.Сумма) КАК СуммаСНДС,
	|	ТЧ_Работы.СтавкаНДС КАК СтавкаНДС,
	|	СУММА(ТЧ_Работы.СуммаНДС) КАК СуммаНДС,
	|	СУММА(ТЧ_Работы.СуммаГУ) КАК СуммаГУ
	|ИЗ
	|	ВТ_РаботыСГУ КАК ТЧ_Работы,
	|	ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Справочник.СМ_ОбъектыСтроительства КАК СМ_ОбъектыСтроительства
	|ГДЕ
	|	СМ_ОбъектыСтроительства.Ссылка = &ОбъектСтроительства
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧ_Работы.СтавкаНДС,
	|	ЕдиницаИзмерения.Штука,
	|	СМ_ОбъектыСтроительства.НоменклатураРаботЗаказчика,
	|	СМ_ОбъектыСтроительства.НоменклатураРаботЗаказчика.ГруппаАналитическогоУчета";
	
	//Запрос.УстановитьПараметр("Работы", 				Объект.Работы.Выгрузить());
	
	ТабРабот = Объект.Работы.Выгрузить();
	Строки = ТабРабот.НайтиСтроки(Новый Структура("СуммарнаяРабота",Истина));
	Для Каждого НайденнаяСтрока ИЗ СТроки Цикл
		ТабРабот.Удалить(НайденнаяСтрока);
	КонецЦикла;
	
	ЗАпрос.УстановитьПараметр("Работы",ТабРабот);
	Запрос.УстановитьПараметр("ОбъектСтроительства",	Объект.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Договор",	            Объект.Договор);
	Запрос.УстановитьПараметр("Дата",					Объект.Дата);
	
	ДанныеЗаполнения = Запрос.Выполнить().Выбрать();
	
	Если ДанныеЗаполнения.Количество() > 1 Тогда
		ТекстОшибки = НСтр("ru='В табличной части ""Работы"" введены несколько различных ставок НДС.'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Объект.ВыполненоВсего.Очистить();
	ДанныеЗаполнения.Следующий();
	
	// Заполнение ТЧ "ВыполненоВсего"
	НоваяСтрокаТЧ = Объект.ВыполненоВсего.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ, ДанныеЗаполнения);
	НоваяСтрокаТЧ.НаправлениеДеятельности = Объект.ДокументУтверждения.НаправлениеДеятельности;
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВыполненоВсего(Команда)
	
	ЗаполнитьВыполненоВсегоНаСервере();
	
	Если Объект.ВыполненоВсего.Количество() > 0 Тогда
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
		ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(Объект.ВыполненоВсего[0], СтруктураДействий, КэшированныеЗначения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПоПередачеСырья(Команда)
	ЗаполнениеПоПередачеСырья(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоПередачеСырья(Команда)
	ЗаполнениеПоПередачеСырья(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеПоПередачеСырья(ОчищатьТЧМатериалы = Истина)
	
	ЗначениеОтбора = Новый Структура;
	ЗначениеОтбора.Вставить("Организация", 		Объект.Организация);
	ЗначениеОтбора.Вставить("Партнер", 			Объект.Субподрядчик);
	ЗначениеОтбора.Вставить("Контрагент", 		Объект.Контрагент);
	ПараметрыОткрытия = Новый Структура("Отбор",ЗначениеОтбора);
	
	ОткрытьФорму("Документ.ПередачаСырьяПереработчику.ФормаВыбора", ПараметрыОткрытия,,,,, Новый ОписаниеОповещения("ЗаполнениеПоПередачеСырьяЗавершение", ЭтотОбъект, Новый Структура("ОчищатьТЧМатериалы", ОчищатьТЧМатериалы)));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоРасходуМатериаловВСтроительстве(Команда)
	ЗаполнениеПоРасходуМатериаловВСтроительствеНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеПоРасходуМатериаловВСтроительствеНаСервере()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТЧ_Работы.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	ТЧ_Работы.ОбъемОбщий КАК ОбъемОбщий,
	|	ТЧ_Работы.ОбъемПринятыхРабот КАК ОбъемПринятыхРабот
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	&Работы КАК ТЧ_Работы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.Работа КАК Работа,
	|	СУММА(ВрТаб.ОбъемОбщий) КАК ОбъемОбщий,
	|	СУММА(ВрТаб.ОбъемПринятыхРабот) КАК ОбъемПринятыхРабот
	|ПОМЕСТИТЬ ОбъемПоРаботам
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|
	|СГРУППИРОВАТЬ ПО
	|	ВрТаб.Работа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбъемПоРаботам.Работа КАК Работа,
	|	РасходМатериаловОстатки.Номенклатура КАК Номенклатура,
	|	РасходМатериаловОстатки.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ОбъемПоРаботам.ОбъемОбщий = 0
	|				ИЛИ РасходМатериаловОстатки.ОбъемОстаток = 0
	|			ТОГДА 0
	|		ИНАЧЕ РасходМатериаловОстатки.КоличествоОстаток * ОбъемПоРаботам.ОбъемПринятыхРабот / РасходМатериаловОстатки.ОбъемОстаток
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ОбъемПоРаботам.ОбъемОбщий = 0
	|				ИЛИ РасходМатериаловОстатки.ОбъемОстаток = 0
	|			ТОГДА 0
	|		ИНАЧЕ РасходМатериаловОстатки.КоличествоОстаток * ОбъемПоРаботам.ОбъемПринятыхРабот / РасходМатериаловОстатки.ОбъемОстаток
	|	КОНЕЦ КАК КоличествоУпаковок
	|ИЗ
	|	ОбъемПоРаботам КАК ОбъемПоРаботам
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.УСОERP_РасходМатериаловВСтроительстве.Остатки(
	|				&Дата,
	|				Организация = &Организация
	|					И ОбъектСтроительства = &ОбъектСтроительства) КАК РасходМатериаловОстатки
	|		ПО (ВЫБОР
	|				КОГДА ОбъемПоРаботам.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|					ТОГДА ОбъемПоРаботам.Работа = РасходМатериаловОстатки.Работа
	|				ИНАЧЕ ОбъемПоРаботам.Работа.РаботаИсточник = РасходМатериаловОстатки.Работа
	|			КОНЕЦ)"; 	
	
	Запрос.УстановитьПараметр("Ссылка", 				Объект.Ссылка);
	//Запрос.УстановитьПараметр("Период", 				КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("Дата",                   Новый Граница(КонецДня(Объект.Дата),ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", 			Объект.Организация);
	Запрос.УстановитьПараметр("ОбъектСтроительства", 	Объект.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Контрагент", 			Объект.Контрагент);
	Запрос.УстановитьПараметр("Работы", 				Объект.Работы.Выгрузить());
	
	Объект.Материалы.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеПоПередачеСырьяЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("ДокументСсылка.ПередачаСырьяПереработчику") И ДополнительныеПараметры.Свойство("ОчищатьТЧМатериалы") Тогда
		ЗаполнитьМатериалыПоПередачеСырьяПереработчику(Результат, ДополнительныеПараметры.ОчищатьТЧМатериалы);	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМатериалыПоПередачеСырьяПереработчику(ПередачаСырьяПереработчику, ОчищатьТЧМатериалы = Истина)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПередачаСырьяПереработчику", ПередачаСырьяПереработчику);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПередачаСырьяПереработчикуТовары.Номенклатура,
	|	ПередачаСырьяПереработчикуТовары.Характеристика,
	|	ПередачаСырьяПереработчикуТовары.Упаковка,
	|	ПередачаСырьяПереработчикуТовары.КоличествоУпаковок,
	|	ПередачаСырьяПереработчикуТовары.Количество,
	|	ПередачаСырьяПереработчикуТовары.КодСтроки,
	|	ПередачаСырьяПереработчикуТовары.АналитикаУчетаНоменклатуры,
	|	ПередачаСырьяПереработчикуТовары.Ссылка.ЗаказПереработчику КАК ЗаказПереработчику,
	|	ПередачаСырьяПереработчикуТовары.Ссылка КАК ПередачаСырья,
	|	ЕСТЬNULL(ПередачаСырьяПереработчикуВидыЗапасов.ВидЗапасов, ЗНАЧЕНИЕ(Справочник.ВидыЗапасов.ПустаяСсылка)) КАК ВидЗапасов
	|ИЗ
	|	Документ.ПередачаСырьяПереработчику.Товары КАК ПередачаСырьяПереработчикуТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВидыЗапасов.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|			ВидыЗапасов.ВидЗапасов КАК ВидЗапасов
	|		ИЗ
	|			Документ.ПередачаСырьяПереработчику.ВидыЗапасов КАК ВидыЗапасов
	|		ГДЕ
	|			ВидыЗапасов.Ссылка = &ПередачаСырьяПереработчику
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ВидыЗапасов.ВидЗапасов,
	|			ВидыЗапасов.АналитикаУчетаНоменклатуры) КАК ПередачаСырьяПереработчикуВидыЗапасов
	|		ПО ПередачаСырьяПереработчикуТовары.АналитикаУчетаНоменклатуры = ПередачаСырьяПереработчикуВидыЗапасов.АналитикаУчетаНоменклатуры
	|ГДЕ
	|	ПередачаСырьяПереработчикуТовары.Ссылка = &ПередачаСырьяПереработчику";
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	
	Если ОчищатьТЧМатериалы Тогда
		Объект.Материалы.Очистить();
	КонецЕсли;
	
	Пока Реквизиты.Следующий() Цикл
		
		НоваяСтрокаТЧМатериалы = Объект.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧМатериалы, Реквизиты);
		
	КонецЦикла;
	
КонецПроцедуры   

&НаКлиенте
Процедура МатериалыРасходМатериаловНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СтруктураОтбора = Новый Структура;
	ЗаполнитьСтруктуруОтбораНаСервере(СтруктураОтбора);
	ОписаниеОповещения = Новый ОписаниеОповещения("МатериалыРасходМатериаловВыборРаботы",ЭтотОбъект);
	ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаПодбора",СтруктураОтбора,Этотобъект,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыРасходМатериаловВыборРаботы(ДанныеВыбора, ДопПараметры)Экспорт
	
	Если ДанныеВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекРабота = ДанныеВыбора[0];
	
	Если ЭтоСуммарнаяРабота(ТекРабота) Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.Материалы.ТекущиеДанные.Работа = ТекРабота;  	
	
КонецПроцедуры

