&НаКлиенте
Процедура РаботыРаботаПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Работы.ТекущаяСтрока;
	РаботыРаботаПриИзмененииНаСервере(ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура РаботыПроцентВыполненияПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Работы.ТекущиеДанные;
	ТекущаяСтрока.ОбъемВыполнения      = Окр(ТекущаяСтрока.ОбъемОбщий *  ТекущаяСтрока.ПроцентВыполнения / 100, 3);
	
	ТекущаяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(ТекущаяСтрока.СуммаСНДС, ТекущаяСтрока.СтавкаНДС, Истина);		
	
	РассчитатьИтоговыеПоказатели(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РаботыОбъемПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Работы.ТекущиеДанные;
	ТекущаяСтрока.ПроцентВыполнения = ?(ТекущаяСтрока.ОбъемОбщий = 0, 0, Окр(ТекущаяСтрока.ОбъемВыполнения * 100 / ТекущаяСтрока.ОбъемОбщий, 2));	
	ТекущаяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(ТекущаяСтрока.СуммаСНДС, ТекущаяСтрока.СтавкаНДС, Истина);
	
	РассчитатьИтоговыеПоказатели(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РаботыОбъемПринятоПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Работы.ТекущиеДанные;
	ТекущаяСтрока.ПроцентПринятыхРабот	= ?(ТекущаяСтрока.ОбъемОбщий = 0, 0, Окр(ТекущаяСтрока.ОбъемПринятыхРабот * 100 / ТекущаяСтрока.ОбъемОбщий, 2));	
	ТекущаяСтрока.СуммаСНДС				= ?(ТекущаяСтрока.ОбъемОбщий = 0, 0, Окр(ТекущаяСтрока.СтоимостьВсего * ТекущаяСтрока.ОбъемПринятыхРабот / ТекущаяСтрока.ОбъемОбщий,2));	
	
	ТекущаяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(ТекущаяСтрока.СуммаСНДС, ТекущаяСтрока.СтавкаНДС, Истина);  	
	
	РассчитатьИтоговыеПоказатели(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РаботыПроцентПринятоПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Работы.ТекущиеДанные;
	ТекущаяСтрока.ОбъемПринятыхРабот = Окр(ТекущаяСтрока.ОбъемОбщий *  ТекущаяСтрока.ПроцентПринятыхРабот / 100, 3);
	ТекущаяСтрока.СуммаСНДС			 = ?(ТекущаяСтрока.ОбъемОбщий = 0, 0, Окр(ТекущаяСтрока.СтоимостьВсего * ТекущаяСтрока.ОбъемПринятыхРабот / ТекущаяСтрока.ОбъемОбщий,2));	

	ТекущаяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(ТекущаяСтрока.СуммаСНДС, ТекущаяСтрока.СтавкаНДС, Истина); 
	
	РассчитатьИтоговыеПоказатели(ЭтаФорма);
	
КонецПроцедуры  

