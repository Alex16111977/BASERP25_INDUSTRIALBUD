
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаявкаИзменена = Ложь;
	Если Объект.Материалы.Количество() = 0 Тогда
		НоваяСтрока = Объект.Материалы.Добавить();
	Иначе
		НоваяСтрока = Объект.Материалы[0];
	КонецЕсли; 
	Если Не ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Объект.Ответственный = ПолучитьОтветственного();
	КонецЕсли;
	
	УстановитьДоступностьЭлементовНаСервере();
	
КонецПроцедуры

&НаСервере          
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Не ЗначениеЗаполнено(Объект.Автор) Тогда
		Объект.Автор = ПолучитьТекущегоПользователя();
	КонецЕсли; 
	Если Не ЗначениеЗаполнено(ТекущийОбъект.Ответственный) Тогда
		ТекущийОбъект.Ответственный = ПолучитьОтветственного();
	КонецЕсли; 
	Если ТекущийОбъект.Материалы.Количество() = 1 Тогда
		Если ТекущийОбъект.Материалы[0].ЕстьСметныйКод Тогда
			ОтправитьСообщение(НСтр("ru='Ресурс есть в справочнике материалов 1С'"));
		КонецЕсли;
		Если ТекущийОбъект.Материалы[0].НеОтноситсяКМатериалам Тогда
			ОтправитьСообщение(НСтр("ru='Ресурс не относится к строительным материалам'"));
		КонецЕсли;
	КонецЕсли; 
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если ТекущийОбъект.ПолноеНаименование <> Объект.Ссылка.ПолноеНаименование
			ИЛИ ТекущийОбъект.ГруппаРесурсов <> Объект.Ссылка.ГруппаРесурсов 
			ИЛИ ТекущийОбъект.ЕдиницаИзмерения <> Объект.Ссылка.ЕдиницаИзмерения 
			ИЛИ ТекущийОбъект.Проект <> Объект.Ссылка.Проект Тогда
			ЗаявкаИзменена = Истина;	
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЗаявкаИзменена Тогда
		ОтправитьСообщение(НСтр("ru='Исходные данные заявки были изменены'"));
	КонецЕсли;
	УстановитьДоступностьЭлементовНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЕстьСметныйКод_НеОтноситсяКМатериаламПриИзменении(Элемент)
	Если Объект.Материалы.Количество() = 1 Тогда
		УстановитьДоступностьМатериалов(Не (Объект.Материалы[0].ЕстьСметныйКод ИЛИ Объект.Материалы[0].НеОтноситсяКМатериалам));
	Иначе
		УстановитьДоступностьМатериалов(Ложь);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыНаименованиеСправочникаПриИзменении(Элемент)
	ДлинноеНаименование = ВернутьДлинноеНаименование();
	Если ДлинноеНаименование <> "" Тогда
		Если Элемент.ТекстРедактирования <> ДлинноеНаименование Тогда
			ОбработкаВыбораМатериалаНаСервере("ОчиститьСсылку");
			Объект.Материалы[0].Код = ПолучитьНовыйКод();
			УстановитьДоступностьМатериаловПриВыбореРесурса();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыНаименованиеСправочникаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОткрытьФорму("Справочник.СМ_Ресурсы.Форма.ФормаВыбора",, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура МатериалыНаименованиеСправочникаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	 ОбработкаВыбораМатериалаНаСервере(ВыбранноеЗначение);
	 УстановитьДоступностьМатериаловПриВыбореРесурса();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СкопироватьПолноеНаименование(Команда)
	
	СкопироватьПолноеНаименованиеНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрисвоитьКод(Команда)
	
	Если Объект.Материалы.Количество() = 1 Тогда
		Объект.Материалы[0].Код = ПолучитьНовыйКод();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура Отправить(Команда)
	
	ОтправитьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗапрос(Команда)
	
	Если Не ПроверитьЗаполнениеРеквизитовШапки() Тогда
	    Сообщение = Новый СообщениеПользователю();
	    Сообщение.Текст = НСтр("ru = 'Проверьте заполнение реквизитов шапки'");
	    Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Автор) Тогда
		Объект.Автор = ПолучитьТекущегоПользователя();
	КонецЕсли; 
	
	ОтправитьСообщение(НСтр("ru='Отправлен запрос на добавление ресурса в базу 1С'"));
	Элементы.КомандыОбработкиЗапроса.ПодчиненныеЭлементы.ОтправитьЗапрос.Доступность = Ложь;
	Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура Добавить(Команда)
	
	Если Объект.Материалы.Количество() = 1 Тогда
		ТекСтрокаМатериалы = Объект.Материалы[0];
		Если ЗначениеЗаполнено(ТекСтрокаМатериалы.ПолноеНаименование) Тогда
			Если ЗначениеЗаполнено(ТекСтрокаМатериалы.Группа) Тогда
				Если ЗначениеЗаполнено(ТекСтрокаМатериалы.ЕдиницаИзмерения) Тогда
					Если ЗначениеЗаполнено(ТекСтрокаМатериалы.Код) Тогда
						Если Не ПроверитьЗаполнениеРеквизитовШапки() Тогда
						    Сообщение = Новый СообщениеПользователю();
						    Сообщение.Текст = НСтр("ru = 'Проверьте заполнение реквизитов шапки'");
						    Сообщение.Сообщить();
							Возврат;
						КонецЕсли;
						СоздатьНовыйРесурс();
						//Элементы.КомандыОбработкиЗапроса.ПодчиненныеЭлементы.Добавить.Доступность = Ложь;
					Иначе
					    Сообщение = Новый СообщениеПользователю();
					    Сообщение.Текст = НСтр("ru = 'Не указан сметный код!'");
					    Сообщение.Сообщить();
					КонецЕсли; 
				Иначе
				    Сообщение = Новый СообщениеПользователю();
				    Сообщение.Текст = НСтр("ru = 'Не указана единица измерения!'");
				    Сообщение.Сообщить();
				КонецЕсли; 
			Иначе
			    Сообщение = Новый СообщениеПользователю();
			    Сообщение.Текст = НСтр("ru = 'Не указана группа!'");
			    Сообщение.Сообщить();
			КонецЕсли; 
		Иначе
		    Сообщение = Новый СообщениеПользователю();
		    Сообщение.Текст = НСтр("ru = 'Не указано полное наименование!'");
		    Сообщение.Сообщить();
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьДоступностьЭлементовНаСервере()
	
	Элементы.КомандыОбработкиЗапроса.ПодчиненныеЭлементы.ОтправитьЗапрос.Доступность = Не ЗначениеЗаполнено(Объект.Автор);
	УстановитьДоступностьШапки(Не ЗначениеЗаполнено(Объект.Автор));
	ПроверкаЗаполненияРеквизитов = ПроверитьЗаполнениеРеквизитов();
	Если ПроверкаЗаполненияРеквизитов Тогда
		Элементы.ГруппаОбработкаЗапроса.Доступность	= Ложь;
		Элементы.КомандыОбработкиЗапроса.ПодчиненныеЭлементы.Записать.Доступность = Ложь;
		УстановитьДоступностьДобавить(Ложь);
	Иначе
		ИмеетПраво = ПроверитьДоступностьРолей();
		Элементы.ГруппаОбработкаЗапроса.Доступность	= ИмеетПраво;
		Элементы.КомандыОбработкиЗапроса.ПодчиненныеЭлементы.Записать.Доступность = ИмеетПраво;
		УстановитьДоступностьДобавить(ИмеетПраво);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьДоступностьШапки(ШапкаДоступность = Истина)
	Элементы.ГруппаНомерИДата.Доступность				= ШапкаДоступность;
	Элементы.ПолноеНаименование.Доступность				= ШапкаДоступность;
	Элементы.ГруппаРесурсов.Доступность					= ШапкаДоступность;
	Элементы.ГруппаЕдиницаИзмеренияИПроект.Доступность	= ШапкаДоступность;
КонецПроцедуры

Функция ПроверитьДоступностьРолей()
	Возврат РольДоступна("СМ_АдминистраторСмета") ИЛИ РольДоступна("ПолныеПрава") ИЛИ ПараметрыСеанса.ТекущийПользователь = Объект.Ответственный;
КонецФункции

Функция ПроверитьЗаполнениеРеквизитов()
	Возврат (ЗначениеЗаполнено(Объект.Материалы[0].Наименование) И ТипЗнч(Объект.Материалы[0].Наименование) = Тип("СправочникСсылка.СМ_Ресурсы"))
			ИЛИ (Объект.Материалы[0].ЕстьСметныйКод ИЛИ Объект.Материалы[0].НеОтноситсяКМатериалам);
КонецФункции

&НаСервере
Функция ПроверитьЗаполнениеРеквизитовШапки()
	Возврат ЗначениеЗаполнено(Объект.ПолноеНаименование) И ЗначениеЗаполнено(Объект.ГруппаРесурсов)
			 И ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) И ЗначениеЗаполнено(Объект.Проект);
КонецФункции

Функция УстановитьДоступностьМатериалов(МатериалыДоступность)
	Элементы.МатериалыНаименованиеСправочника.Доступность													= МатериалыДоступность;
	Элементы.ГруппаНаименованиеСправочника.ПодчиненныеЭлементы.СкопироватьПолноеНаименование.Доступность	= МатериалыДоступность;
	Элементы.МатериалыПолноеНаименование.Доступность														= МатериалыДоступность;
	Элементы.МатериалыГруппа.Доступность																	= МатериалыДоступность;
	Элементы.МатериалыЕдиница.Доступность																	= МатериалыДоступность;
	Элементы.МатериалыКод1.Доступность																		= МатериалыДоступность;
	Элементы.ГруппаСметныйКод.ПодчиненныеЭлементы.ПрисвоитьКод.Доступность									= МатериалыДоступность;
	Элементы.КомандыОбработкиЗапроса.ПодчиненныеЭлементы.Добавить.Доступность								= МатериалыДоступность;
КонецФункции

Функция УстановитьДоступностьМатериаловПриВыбореРесурса()
	МатериалыДоступность = НЕ ПроверитьЗаполнениеРеквизитов();
	Элементы.МатериалыНаименованиеСправочника.Доступность													= Истина;
	Элементы.МатериалыПолноеНаименование.Доступность														= МатериалыДоступность;
	Элементы.МатериалыГруппа.Доступность																	= МатериалыДоступность;
	Элементы.МатериалыЕдиница.Доступность																	= МатериалыДоступность;
	Элементы.МатериалыКод1.Доступность																		= МатериалыДоступность;
	Элементы.МатериалыЕстьСметныйКод.Доступность															= МатериалыДоступность;
	Элементы.МатериалыНеОтноситсяКМатериалам.Доступность													= МатериалыДоступность;
	Элементы.ГруппаСметныйКод.ПодчиненныеЭлементы.ПрисвоитьКод.Доступность									= МатериалыДоступность;
	Элементы.КомандыОбработкиЗапроса.ПодчиненныеЭлементы.Добавить.Доступность								= МатериалыДоступность;
КонецФункции

Функция УстановитьДоступностьДобавить(ДоступностьКоманды = Неопределено)
	Если ДоступностьКоманды = Неопределено Тогда
		Элементы.КомандыОбработкиЗапроса.ПодчиненныеЭлементы.Добавить.Доступность = Не ПроверитьЗаполнениеРеквизитов();
	Иначе
		Элементы.КомандыОбработкиЗапроса.ПодчиненныеЭлементы.Добавить.Доступность = ДоступностьКоманды;
	КонецЕсли;
КонецФункции

Функция ПолучитьОтветственного()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ОтветственныеЛица.Пользователь КАК Пользователь
				   |ИЗ	
				   |	РегистрСведений.СМ_ОтветственныеЛица КАК СМ_ОтветственныеЛица
				   |	ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ	
				   //|			ОтветственныеЛица.Организация,
				   |			МАКСИМУМ(СМ_ОтветственныеЛица.ДатаНачала) КАК ДатаНачала
	               |		ИЗ
	               |			РегистрСведений.СМ_ОтветственныеЛица КАК СМ_ОтветственныеЛица
				   //|		ГДЕ
				   //|			СМ_ОтветственныеЛица.Организация = &Организация
				   //|		СГРУППИРОВАТЬ ПО 
				   //|			ОтветственныеЛица.Организация
				   |	) КАК ВложенныйЗапрос
				   //|	ПО СМ_ОтветственныеЛица.Организация = ВложенныйЗапрос.Организация
				   |	ПО СМ_ОтветственныеЛица.ДатаНачала = ВложенныйЗапрос.ДатаНачала
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_ОтветственныеЛица.Пользователь";
	//Запрос.УстановитьПараметр("Организация", Организация);	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Пользователь;
	Иначе
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли; 
КонецФункции // ()

&НаСервереБезКонтекста
Функция ПолучитьТекущегоПользователя()
	Возврат ПараметрыСеанса.ТекущийПользователь;
КонецФункции // ()

&НаСервере
Функция ВернутьДлинноеНаименование()
	Если ЗначениеЗаполнено(Объект.Материалы[0].Наименование) Тогда
		Если ТипЗнч(Объект.Материалы[0].Наименование) = Тип("СправочникСсылка.СМ_Ресурсы") Тогда
			Возврат Объект.Материалы[0].Наименование.ДлинноеНаименование;
		Иначе
			Возврат Объект.Материалы[0].Наименование;
		КонецЕсли;
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

&НаСервере
Процедура СкопироватьПолноеНаименованиеНаСервере()
	Объект.Материалы[0].ПолноеНаименование = Объект.ПолноеНаименование;
	Если ЗначениеЗаполнено(Объект.Материалы[0].Наименование) И ТипЗнч(Объект.Материалы[0].Наименование) = Тип("СправочникСсылка.СМ_Ресурсы") Тогда
		ОбработкаВыбораМатериалаНаСервере("ОчиститьСсылку");
		Объект.Материалы[0].Код = ПолучитьНовыйКод();
		УстановитьДоступностьМатериаловПриВыбореРесурса();
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьНовыйКод()
	Если Объект.Материалы.Количество() = 1 Тогда 
		ТекСтрока = Объект.Материалы[0];
		//Если ЗначениеЗаполнено(Объект.Проект) Тогда
		//	ПрефиксКода = Объект.Проект.Код + "-" + ТекСтрока.Группа.Код + "-";
		//Иначе
		ПрефиксКода = ТекСтрока.Группа.Код + "-";		
		//КонецЕсли; 
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	МАКСИМУМ(СМ_Ресурсы.Код) КАК Код
		               |ИЗ
		               |	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
		               |ГДЕ
		               |	СМ_Ресурсы.Ссылка В ИЕРАРХИИ(&Группа)
		               |	И СМ_Ресурсы.Код ПОДОБНО &Код";
		Запрос.УстановитьПараметр("Код", ПрефиксКода + "%");
		Запрос.УстановитьПараметр("Группа", ТекСтрока.Группа);
		МассивКодовВГруппе = ПолучитьМассивКодовВГруппе(ТекСтрока.Группа);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если СтрДлина(Выборка.Код) >= 4 Тогда
				Попытка
					ТекКод = Число(Прав(Выборка.Код, 4));
				Исключение
					Возврат "";
				КонецПопытки;
				Если ЗначениеЗаполнено(Объект.Проект) Тогда
					ТекКод = ТекКод + 1;
				Иначе
					ТекКодПерем = ТекКод;
					ТекКодНайденный = ТекКод;
					Для Индекс = 1 По ТекКод - 1 Цикл
					    ТекКодПерем = ТекКод - Индекс;					
						ТекКодПеремСтрока = ПрефиксКода + Лев("0000", 4 - СтрДлина(Строка(ТекКодПерем))) + Строка(Формат(ТекКодПерем,"ЧГ=0"));
						Если МассивКодовВГруппе.Найти(ТекКодПеремСтрока) = Неопределено Тогда
							ТекКодНайденный = ТекКодПерем;
							Прервать;
						КонецЕсли; 
					КонецЦикла; 
					Если ТекКодНайденный = ТекКод Тогда
						ТекКод 	= ТекКод + 1;
					    Сообщение = Новый СообщениеПользователю();
					    Сообщение.Текст = НСтр("ru = 'Свободных кодов в группе нет! Уточните назначенный код вручную'");
					    Сообщение.Сообщить();
					Иначе
						ТекКод = ТекКодНайденный;
					КонецЕсли; 
				КонецЕсли;
				ТекКодСтрока = Строка(Формат(ТекКод,"ЧГ=0"));
				Возврат ПрефиксКода + Лев("0000", 4 - СтрДлина(ТекКодСтрока)) + ТекКодСтрока;
			Иначе
				Возврат ПрефиксКода + "0001";	
			КонецЕсли; 
		Иначе
		    Возврат ПрефиксКода + "0001";
		КонецЕсли; 
	КонецЕсли;
	Возврат "";
КонецФункции // ()

Процедура ОтправитьНаСервере()
	ОтправитьСообщение(Сообщение);
	Если Объект.Материалы.Количество() = 1 Тогда
		ТекСтрокаМатериалы = Объект.Материалы[0];
		Если Не ЗначениеЗаполнено(ТекСтрокаМатериалы.Наименование) Тогда
			Объект.ТребуетУточнения = Не Объект.ТребуетУточнения;
			Если Объект.ТребуетУточнения Тогда
				Объект.КоличествоУточнений = Объект.КоличествоУточнений + 1;
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли; 
	Записать();
КонецПроцедуры

Процедура ОтправитьСообщение(ТекстСообщения)
	Объект.ИсторияСообщений = Объект.ИсторияСообщений + Символы.ПС + Символы.ВК 
								+ Строка(ТекущаяДата()) + " " + Строка(ПараметрыСеанса.ТекущийПользователь) + ": " + ТекстСообщения;
	Если Объект.Ответственный <> ПараметрыСеанса.ТекущийПользователь Тогда
		ОтправитьПисьмо(ПолучитьАдресЭПизПользователя(Объект.Ответственный), НСтр("ru='Заявка на внесение материала в фирменный каталог №'") + Объект.Номер + " от " + Строка(Объект.Дата), Строка(ТекущаяДата()) + " " + Строка(ПараметрыСеанса.ТекущийПользователь) + ": " + ТекстСообщения);
	Иначе
		ОтправитьПисьмо(ПолучитьАдресЭПизПользователя(Объект.Автор), НСтр("ru='Заявка на внесение материала в фирменный каталог №'") + Объект.Номер + " от " + Строка(Объект.Дата), Строка(ТекущаяДата()) + " " + Строка(ПараметрыСеанса.ТекущийПользователь) + ": " + ТекстСообщения);
	КонецЕсли; 
КонецПроцедуры

