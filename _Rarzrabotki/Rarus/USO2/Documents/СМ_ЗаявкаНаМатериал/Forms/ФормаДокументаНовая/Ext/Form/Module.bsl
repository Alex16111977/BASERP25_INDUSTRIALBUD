Процедура СоздатьНовыйРесурс_()
	
	ТекСтрока = Объект.Материалы[0];
	
	ПользовательИнформационнойБазы = Обработки.НастройкиПользователей.ИмяПользователяИБ(Пользователи.ТекущийПользователь());
	
	СписокНастроек	= СМ_СметаВызовСервера.ПолучитьСписокНастроек();
	
	Для каждого КлючИЗначение из СписокНастроек Цикл
		
		Если КлючИЗначение.Ключ = "НСИ_ГруппаРесурсов" Тогда
			ГруппаРесурсов = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета",
								КлючИЗначение.Ключ,КлючИЗначение.Значение.ЗначениеПоУмолчанию,,ПользовательИнформационнойБазы);
		КонецЕсли;
		
		Если КлючИЗначение.Ключ = "НСИ_КлассГруза" Тогда
			КлассГруза = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета",
								КлючИЗначение.Ключ,КлючИЗначение.Значение.ЗначениеПоУмолчанию,,ПользовательИнформационнойБазы);
		КонецЕсли;
		
	КонецЦикла;
	
	РесурсОбъект = Справочники.СМ_Ресурсы.СоздатьЭлемент();
	РесурсОбъект.Код = ТекСтрока.Код;
	РесурсОбъект.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы;
	РесурсОбъект.Наименование = Строка(ТекСтрока.ПолноеНаименование);
	РесурсОбъект.ДлинноеНаименование = Строка(ТекСтрока.ПолноеНаименование);
	РесурсОбъект.ЕдиницаИзмерения = ТекСтрока.ЕдиницаИзмерения;
	РесурсОбъект.Родитель = ТекСтрока.Группа;
	РесурсОбъект.ГруппаРесурсов = ГруппаРесурсов;
	РесурсОбъект.КлассГруза = КлассГруза;
	РесурсОбъект.ГодВыпуска = Перечисления.СМ_ГодыВыпускаБазы.г2017;
	РесурсОбъект.Записать();
	//Элементы.МатериалыНаименованиеСправочника.СписокВыбора.Добавить(РесурсОбъект.Ссылка);
	ТекСтрока.Наименование = РесурсОбъект.Ссылка;
	ОтправитьСообщение(НСтр("ru='Ресурс добавлен в базу 1С "+Символы.ПС+"Код: "+ТекСтрока.Код+Символы.ПС+"Наименование: "+Строка(ТекСтрока.ПолноеНаименование)+"'"));
	
КонецПроцедуры

