
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Ответственный = ПолучитьОтветственного();
	Если ПараметрыСеанса.ТекущийПользователь = Ответственный Тогда
	Иначе		
		Если РольДоступна("СМ_АдминистраторСмета") ИЛИ РольДоступна("ПолныеПрава") Тогда
		Иначе
			ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.Использование = Истина;
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Автор");
			ЭлементОтбора.ПравоеЗначение = ПараметрыСеанса.ТекущийПользователь;
			ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОтветственного()
	
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ
	|	СМ_ОтветственныеЛица.Пользователь КАК Пользователь
	|ИЗ	
	|	РегистрСведений.СМ_ОтветственныеЛица КАК СМ_ОтветственныеЛица
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ	
	|			МАКСИМУМ(СМ_ОтветственныеЛица.ДатаНачала) КАК ДатаНачала
	|		ИЗ
	|			РегистрСведений.СМ_ОтветственныеЛица КАК СМ_ОтветственныеЛица) КАК ВложенныйЗапрос
	|	ПО СМ_ОтветственныеЛица.ДатаНачала = ВложенныйЗапрос.ДатаНачала
	|
	|СГРУППИРОВАТЬ ПО
	|	СМ_ОтветственныеЛица.Пользователь";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Пользователь;
	Иначе
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

#КонецОбласти

