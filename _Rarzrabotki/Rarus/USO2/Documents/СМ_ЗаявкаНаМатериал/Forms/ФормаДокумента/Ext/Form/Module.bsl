
#Область КомандыФормы

&НаКлиенте
Процедура Отправить(Команда)
	Если Объект.Ссылка.Пустая() Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаписатьДокумент", ЭтотОбъект, Неопределено);
		ПоказатьВопрос(Оповещение,"Для отправки писем документ будет записан. Продолжить?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, НСтр("ru = 'Отправка уведомлений ответственным'"));
	Иначе
		ОтправитьНаСервере();	
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Объект.ДокументОснование) И   ТипЗнч(Объект.ДокументОснование)=Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		СметаПозиции=ОБъект.ДокументОснование.ИдСметы;
	КонецЕсли;
	ТолькоПросмотрФормы = СМ_СметаВызовСервера.РольТолькоПросмотр();  	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		Если ТипЗнч(Объект.ДокументОснование)=Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Элемент.ТекущиеДанные.Позиция=Объект.ДокументОснование;	
			Элемент.ТекущиеДанные.Смета=СметаПозиции;
		Иначе
			Элемент.ТекущиеДанные.Смета=Объект.ДокументОснование;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Служебные

&НаСервере
Процедура ОтправитьНаСервере()
	Ответ=Документы.СМ_ЗаявкаНаМатериал.ОтправитьСсылкуОтветственнымЛицам(Объект.Ссылка);
	Если Ответ.Отправлено Тогда
		Объект.ДатаОтправки=ТекущаяДата();
		Записать();
	КонецЕсли;
	Для Каждого Текст Из Ответ.МассивСообщений Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1'"),Текст));
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьДокумент(Знач Результат, Знач ПараметрКоманды) Экспорт
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;	
	Записать();
	ОтправитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ТолькоПросмотр = ТолькоПросмотрФормы;
КонецПроцедуры

#КонецОбласти


