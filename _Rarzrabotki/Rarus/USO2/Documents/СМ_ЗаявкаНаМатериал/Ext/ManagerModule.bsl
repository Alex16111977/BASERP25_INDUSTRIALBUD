
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Отправляет письмо со ссылкой на документ ответственным лицам
//
// Параметры:
//    Ссылка - ДокументСсылка.СМ_ЗаявкаНаМатериал - содержит ссылку на документ.
//
// Возвращаемое значение:
//     Структура - содержит поля результата отправки письма.
//
Функция ОтправитьСсылкуОтветственнымЛицам(Ссылка) Экспорт
	
	Отправлено=Ложь;
	МассивСообщений=Новый Массив;
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	СМ_ОтветственныеЛица.Пользователь
	             |ИЗ
	             |	РегистрСведений.СМ_ОтветственныеЛица КАК СМ_ОтветственныеЛица
	             |ГДЕ
	             |	СМ_ОтветственныеЛица.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	             |	И СМ_ОтветственныеЛица.Организация = &Организация";
	Запрос.УстановитьПараметр("Организация",Ссылка.Организация);
	Результат=Запрос.Выполнить().Выбрать();
	
	СсылкаНаДокумент=СтрЗаменить(ПолучитьНавигационнуюСсылку(Ссылка),"""","'");
	ТекстПисьма="Создана новая заявка на внесение материала в каталог. Открыть: <a href='#'>"+СсылкаНаДокумент+"</a>";
	
	Пока Результат.Следующий() Цикл
		Адрес = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		Результат.Пользователь, Справочники.ВидыКонтактнойИнформации.EmailПользователя);
		Если ПустаяСтрока(Адрес) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Уведомление не было отправлено, так как у пользователя %1 не задан адрес электронной почты.'"),Результат.Пользователь);
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Заявки на внесение материалов'",ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			МассивСообщений.Добавить(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		ПараметрыПисьма = Новый Структура;
		ПараметрыПисьма.Вставить("Кому", Адрес);
		ПараметрыПисьма.Вставить("Тема", "Создана новая заявка на внесение материала в каталог");
		ПараметрыПисьма.Вставить("Тело", ТекстПисьма);
		ПараметрыПисьма.Вставить("ТипТекста", "HTML");
		
		Попытка
			РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись(), ПараметрыПисьма);
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Уведомление о заявке успешно отправлено на адрес %1.'"), Результат.Пользователь);
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Уведомление о заявке'",ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			МассивСообщений.Добавить(ТекстСообщения);
			Отправлено=Истина;
		Исключение
			ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка при отправке уведомления о просроченных задачах: %1.'"),ОписаниеОшибки);
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Уведомление о заявке'",ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			МассивСообщений.Добавить(ТекстСообщения);
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Новый Структура("Отправлено,МассивСообщений",Отправлено,МассивСообщений);
	
КонецФункции

#КонецОбласти

#КонецЕсли



