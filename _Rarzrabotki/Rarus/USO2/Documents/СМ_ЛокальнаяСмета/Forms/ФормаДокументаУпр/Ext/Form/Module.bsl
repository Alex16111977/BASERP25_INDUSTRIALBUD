Функция ПереместитьПривязанныеПозиции(Владелец,ЗначениеРодителя)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Позиция,
	               |	СМ_НумерацияПозицийЛокальныхСмет.Раздел,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
	               |ПОМЕСТИТЬ Номера
	               |ИЗ
	               |	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |ГДЕ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Позиция.ИДПозицииВладельца = &ИДПозицииВладельца
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПозицияЛокальнойСметы.Ссылка
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Номера КАК Номера
	               |		ПО (Номера.Позиция = ПозицияЛокальнойСметы.Ссылка)
	               |			И (Номера.Раздел = ПозицияЛокальнойСметы.ИДРодителя)
	               |ГДЕ
	               |	ПозицияЛокальнойСметы.ИДПозицииВладельца = &ИДПозицииВладельца
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номера.ПорНомер";
	
	Запрос.УстановитьПараметр("ИДПозицииВладельца",Владелец);
	ВыборкаПривязанных = Запрос.Выполнить().Выбрать();
	Пока ВыборкаПривязанных.Следующий() Цикл
		ОбъектОбработки = ВыборкаПривязанных.Ссылка.ПолучитьОбъект();
		СМ_СметаВызовСервера.ЗаполнитьДанныеДокументаВСтруктуреСмет(ОбъектОбработки, Владелец);
		ОбъектОбработки.ИДРодителя = Владелец.ИДРодителя;
		ОбъектОбработки.ИДПозицииВладельца = ВыборкаПривязанных.Ссылка.ИДПозицииВладельца;
		ОбъектОбработки.ПорНомер = 0;
		ОбъектОбработки.Записать(РежимЗаписиДокумента.Запись);
	КонецЦикла;

КонецФункции
// ДокторСофт

&НаСервере
Функция ПолучитьПривязанные(Позиция)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПозицияЛокальнойСметы.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	               |ГДЕ
	               |	ПозицияЛокальнойСметы.ИДПозицииВладельца = &ИДПозицииВладельца";
	Запрос.УстановитьПараметр("ИДПозицииВладельца",Позиция);
	Выборка = запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Возврат выборка;
	
	
КонецФункции	

// процедура удаляет ветку из дерева со всеми потомками
&НаСервере
Процедура ПодготовитьМассивОбъектовКУдалению(СтрокаДерева, МассивУдаления)
	
	МассивУдаления.Добавить(СтрокаДерева.Элемент);
	Для Каждого СтрокаДереваВлож Из СтрокаДерева.ПолучитьЭлементы() Цикл
		ПодготовитьМассивОбъектовКУдалению(СтрокаДереваВлож, МассивУдаления);	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроставитьЗначениеПотомкамВсем(ТекущаяСтрока, Значение, Имя, Перерасчет = Ложь)
	
	Для каждого Строка Из ТекущаяСтрока.ПолучитьЭлементы() Цикл
		Строка[Имя] = Значение;
		ПроставитьЗначениеПотомкамВсем(Строка, Значение, Имя);
	КонецЦикла;	
	СМ_СметаВызовСервера.УстановитьРеквизитДокумента(ТекущаяСтрока.Элемент, Имя, Значение, Перерасчет);
КонецПроцедуры

&НаКлиенте
Процедура ПроставитьЗначениеВсемПодчиненным(ТекущаяСтрока, Значение, Имя, Перерасчет = Ложь)
	
	Если ТекущаяСтрока.ПолучитьРодителя() = Неопределено Тогда
		Возврат;
	КонецЕсли;  	
	
	НомерВРазделе = ТекущаяСтрока.ПолучитьРодителя().ПолучитьЭлементы().Индекс(ТекущаяСтрока)+1;
	Если НомерВРазделе = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВсегоВРазделе = ТекущаяСтрока.ПолучитьРодителя().ПолучитьЭлементы().Количество();
	ЕстьПодчиненные = Истина;
	
	Пока (ВсегоВРазделе>НомерВРазделе) И ЕстьПодчиненные Цикл 
		Строка = ТекущаяСтрока.ПолучитьРодителя().ПолучитьЭлементы().Получить(НомерВРазделе);
		Если Строка.ИндексПривязана <> 0 Тогда
			// не привязана
			ЕстьПодчиненные = Ложь;
		Иначе
			Строка[Имя] = Значение;
			СМ_СметаВызовСервера.УстановитьРеквизитДокумента(Строка.Элемент, Имя, Значение, Перерасчет);
		КонецЕсли;
		НомерВРазделе = НомерВРазделе + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоРабота(Позиция)
	
	Если Позиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Работа Тогда
		Возврат истина;
	Иначе
		Возврат ложь;
	КонецЕсли;	
	
КонецФункции	

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ОбновитьВыполнениеСмета" Тогда
		ЗаполнитьВыполнение();	
	ИначеЕсли ИмяСобытия = "ОбновитьПослеКопирования" Тогда
		Если Объект.Ссылка = Параметр.Смета Тогда
			ОбновитьПеренумероватьДерево(Истина,,Истина);
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "ОбновитьДеревоСметы" Тогда
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
			// Обновляем только нужную смету
			Если Объект.Ссылка = Параметр.Смета Тогда
				СписокДействий = Параметр.СписокДействий;
				Для Каждого ТекДействие Из СписокДействий Цикл
					Если ТекДействие = "ОбновитьДерево" Тогда
						ОбновитьПеренумероватьДерево(Ложь,Параметр.НовыйОбъект,Истина);
					ИначеЕсли ТекДействие = "ПеренумероватьДерево" Тогда
						ОбновитьПеренумероватьДерево(Истина,Параметр.НовыйОбъект,Истина);
					КонецЕсли;
				КонецЦикла;
				// Оповещаем СС и ОС.
				СписокСвязанных = ПолучитьССиОС(Объект.Ссылка);
				Если СписокСвязанных.Количество()>0 Тогда
					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("СписокСмет",СписокСвязанных);
					Оповестить("ОбновитьДеревоССОС",СтруктураПараметров);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "ОбновитьСостояние" Тогда
		Если ТипЗнч(Параметр) = Тип("Структура") 
			И Параметр.Свойство("ЛокальнаяСмета") Тогда
			Если Объект.Ссылка = Параметр.ЛокальнаяСмета Тогда
				СуществуютАкты = ПолучитьСуществуютАкты(Объект.Ссылка);
				ВидимостьДоступностьЭлементовНаФорме();
				
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Смета",Объект.Ссылка);
				СтруктураПараметров.Вставить("Стройка",Объект.Стройка);
				Оповестить("ОбновитьДеревоСмет",СтруктураПараметров);		
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.Свойства") Тогда
		МодульУправлениеСвойствамиКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеСвойствамиКлиент");
		Если МодульУправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
			ОбновитьЭлементыДополнительныхРеквизитов();
			МодульУправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьСуществуютАкты(Смета)
	Возврат СМ_УчетВыполненныхРаботСервер.СуществуютАктыПоСмете(Смета);
КонецФункции

&НаСервере
Функция ПолучитьССиОС(Смета)
	МассивСмет = Новый Массив;
	МассивСмет.Добавить(Смета);
	
	ВключитьОбъекты = Новый Массив;
	ВключитьОбъекты.Добавить(Метаданные.Документы.СМ_ОбъектнаяСмета);
	ВключитьОбъекты.Добавить(Метаданные.Документы.СМ_СводнаяСмета);
	
	ТабСсылок = НайтиПоСсылкам(МассивСмет, Новый Массив, ВключитьОбъекты);	
	Возврат ТабСсылок.ВыгрузитьКолонку("Данные");
КонецФункции

&НаСервере
Функция ПозицияВладельцаЗаполнена(ТекЭл)
	
	
	Возврат ЗначениеЗаполнено(ТекЭл.ИДПозицииВладельца);
	
КонецФункции	

&НаСервере
Функция ПереписатьРодителя(ТекЭл,КудаЭл)
	
	об = ТекЭл.получитьОбъект();
	об.ИдРодителя = КудаЭл;
	Если об.проведен Тогда
		об.записать(РежимЗаписиДокумента.Проведение);
	Иначе
		об.записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
	МассивПривязанных = ПолучитьПривязанные(ТекЭл);
	Для каждого Привязанная Из МассивПривязанных Цикл
		
		об = Привязанная.получитьОбъект();
		об.ИдРодителя = КудаЭл;
		Если об.проведен Тогда
			об.записать(РежимЗаписиДокумента.Проведение);
		Иначе
			об.записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		
	КонецЦикла;	
	
КонецФункции	

&НаКлиенте
Процедура ТипРайонаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(объект.ТипРайона) Тогда
		Если ОБъект.ТипРайона <> ВыбранноеЗначение Тогда
			ПоказатьПредупреждение(,НСтр("ru='Обновите нормативы НР и СП. Пересчитайте смету.'"),,"Важно !");
		КонецЕсли;
	КонецЕсли;
		
	
КонецПроцедуры

&НаКлиенте
Функция ПреобразоватьФормулу(ЗаданнаяФормула)
	Если ЗаданнаяФормула = "" Тогда
		НоваяФормула = "";
		Возврат(НоваяФормула);
	КонецЕсли;
	ЗаданнаяФормула = СтрЗаменить(ЗаданнаяФормула,",",".");
	НоваяФормула = "";
	СтрокаСимв = "1234567890+-*/().";
	Для сч = 1 По СтрДлина(ЗаданнаяФормула) Цикл
		ТекСимв = Сред(ЗаданнаяФормула,Сч,1);
		Если Найти(СтрокаСимв,ТекСимв) <> 0 Тогда
			НоваяФормула = НоваяФормула + ТекСимв;
		КонецЕсли;
	КонецЦикла;	
	Результат = НоваяФормула;
	Возврат(Результат);
КонецФункции	

&НаКлиенте
Процедура ОкруглятьДоРублейПриИзменении(Элемент)
	ИЗменитьФорматДанных();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДеревоКлиент(Команда)
	
	СохраненнаяСтрока = Неопределено;
	ОбновитьПеренумероватьДерево(Ложь, СохраненнаяСтрока); // sudav - рефакторинг кода
	
КонецПроцедуры

&НаКлиенте
Процедура ЛимитированныеЗатратыЛимитированнаяЗатратаПриИзменении(Элемент)
	
	ТекДанные = Элементы.ЛимитированныеЗатраты.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.Расчет 						= ЗначениеЗаполнено(ТекДанные.ЛимитированнаяЗатрата);
	ЗначениеПоУмолчанию 					= НайтиЗначениеПоУмолчанию(ТекДанные.ЛимитированнаяЗатрата);
	ТекДанные.ЗначениеЛимЗатраты 			= ЗначениеПоУмолчанию;
	ТекДанные.БазисноеЗначениеЛимЗатраты 	= ЗначениеПоУмолчанию;
	
КонецПроцедуры

&НаСервере
Функция НайтиЗначениеПоУмолчанию(Ссылка)
ЗначениеПоУмолчанию = 0;	
Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛимитированныеЗатраты.ЗначениеЗатратыПоУмолчанию КАК ЗначениеПоУмолчанию	
	|ИЗ
	|	Справочник.СМ_ЛимитированныеЗатраты КАК ЛимитированныеЗатраты
	|ГДЕ
	|	ЛимитированныеЗатраты.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество() <> 0 Тогда
		ЗначениеПоУмолчанию = РезультатЗапроса[0].ЗначениеПоУмолчанию;
	КонецЕсли;	
	Возврат(ЗначениеПоУмолчанию);	
КонецФункции

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Не ТекущийОбъект.Проведен Тогда
		Документы.СМ_ЛокальнаяСмета.Перерасчет(ТекущийОбъект, Ложь);
	КонецЕсли;

	Если ПараметрыИзменены Тогда
		// Обновление параметров и перерасчет объема по формулам в позициях 
		ТабПозицийЛС = ПолучитьПозицииПоЛокальнойСмете(Объект.Ссылка);
		ОбновитьЗначенияПараметровВПозициях(ТабПозицийЛС);
		
		// Обновление параметров и перерасчет объема по формулам в связанных позициях 
		МассивПозицийЛС 		= ТабПозицийЛС.ВыгрузитьКолонку("Позиция");
		ТабСвязанныхПозицийЛС 	= ПолучитьСвязанныеПозицииЛС(МассивПозицийЛС);
		ОбновитьЗначенияПараметровВПозициях(ТабСвязанныхПозицийЛС);

		// Обновление таблицы параметров, чтобы убрать изменения параметров
		Для Каждого ТекСтрока Из Объект.Параметры Цикл
			ТекСтрока.СтароеЗначение = ТекСтрока.ЗначениеПараметра;
		КонецЦикла;
		ПараметрыИзменены = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЛимитированныеЗатратыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Копирование Тогда
		Элемент.ТекущиеДанные.Расчет = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПозициюПоКоду(Команда)
	
	Если НЕ ПроверитьВозможностьДобавленияПозиции() Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтрока = Элементы.ДеревоЛС.ТекущиеДанные;
	Родитель = ТекСтрока.Элемент;
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	Иначе
		Если ТипЗнч(ТекСтрока.Элемент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			Состояние(НСтр("ru='Необходимо расположиться внутри раздела.'"),100,"",БиблиотекаКартинок.Предупреждение32);
			Возврат;
		ИначеЕсли ТипЗнч(ТекСтрока.Элемент) <> Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			РодительЭлемента = ПолучитьРодителяЭлемента(ТекСтрока.Элемент);
			Родитель = РодительЭлемента; 
			Если ТипЗнч(РодительЭлемента) <> Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
				Состояние(НСтр("ru='Необходимо расположиться внутри раздела.'"),100,"",БиблиотекаКартинок.Предупреждение32);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ТекСтрока.Элемент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
		ИЛИ ТипЗнч(ТекСтрока.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")Тогда
		ИдентификаторВерхнейСтроки = ПолучитьНомерВДереве(ТекСтрока.Элемент);
	Иначе
		ИдентификаторВерхнейСтроки = -1;
	КонецЕсли;

	Элементы.ДеревоЛС.ДобавитьСтроку();
	НовСтрока = Элементы.ДеревоЛС.ТекущиеДанные;
	НовСтрока.Расчет				= Истина;
	НовСтрока.ИндексПривязана		= 1;
	НовСтрока.ИндексПересчет		= 1;
	НовСтрока.ИндексНеИндексировать = 1;
	НовСтрока.ИндексПоправки		= 1;
	НовСтрока.НоваяСтрока			= Истина;
	НовСтрока.РодительРасценки		= Родитель;
	Элементы.ДеревоЛС.ТекущийЭлемент = Элементы.ДеревоЛСГруппаОбоснования.ПодчиненныеЭлементы.ДеревоЛСОбоснСметнойСтоим;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЛСОбоснСметнойСтоимПриИзменении(Элемент)
	
	СписокБаз 		= Неопределено;
	СписокСборников = Неопределено;	
	ТаблицаВыбораРасценок.Очистить();
	ТекСтрока = Элементы.ДеревоЛС.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекСтрока.ОбоснСметнойСтоим) Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтрока.ОбоснСметнойСтоим = ВРег(ТекСтрока.ОбоснСметнойСтоим);
	Если ТекСтрока.НоваяСтрока Тогда // новая
		СтруктураПараметров = СМ_СметаВызовСервера.ПолучитьШифр(ТекСтрока.ОбоснСметнойСтоим);
		КодБазы  		= ?(ЗначениеЗаполнено(Объект.КодРегионаФайлаТекущихЦен),Объект.КодРегионаФайлаТекущихЦен,СтруктураПараметров.РегиональнаяБаза);
		ШифрРасценки 	= ?(ЗначениеЗаполнено(СтруктураПараметров.ШифрПозиции),СтруктураПараметров.ШифрПозиции,ТекСтрока.ОбоснСметнойСтоим);
		ТипСборника 	= СтруктураПараметров.ТНС;
		КодРайона 		= НайтиКод(Объект.Район);
		
		Если НЕ ЗначениеЗаполнено(КодБазы) 
			И ЗначениеЗаполнено(Объект.РегионДляВыбораЦен) Тогда
			КодБазы = ПолучитьКодБазы(Объект.РегионДляВыбораЦен);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(КодБазы) Тогда
			 СписокБаз = СМ_СметаВызовСервера.ПолучитьВсеБазы();
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТипСборника) Тогда
			СписокСборников = СМ_СметаВызовСервера.ПолучитьВсеСборники();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КодБазы) И ЗначениеЗаполнено(ТипСборника) Тогда
			НомерСборника = СокрЛП(СМ_СметаВызовСервера.ОпределитьНомерСборника(ТипСборника,ШифрРасценки));
			Данные = СметнаяКомпонента.ОбновитьПоБазе(ШифрРасценки,КодРайона,КодБазы,ТипСборника,НомерСборника);
			Если ЗначениеЗаполнено(Данные) И СМ_СметаЗагрузкаВызовСервера.ЕстьДанные(Данные) = Ложь Тогда
				Возврат;
			КонецЕсли;
			Если ЗначениеЗаполнено(Данные) Тогда
				ПолучитьДанныеПозиции(Данные);
			КонецЕсли;
		Иначе
			Попытка
				Данные = СметнаяКомпонента.ПоискРасценок(КодРайона,ШифрРасценки,"");
				Если ЗначениеЗаполнено(Данные) И СМ_СметаЗагрузкаВызовСервера.ЕстьДанные(Данные) = Ложь Тогда
				Иначе
					ПолучитьДанныеВсеПозиции(Данные);
				КонецЕсли;
			Исключение
				Возврат;
			КонецПопытки;
		КонецЕсли;
        
		Если ТаблицаВыбораРасценок.Количество() = 1 Тогда
			ТекСтрока.НоваяСтрока 	= Ложь;
			Данные 					= ТаблицаВыбораРасценок[0].Данные;
			ТекРаздел 				= ТекСтрока.РодительРасценки;
			НомерВДереве 			= ИдентификаторВерхнейСтроки+0.01;
			СпособСоздания			= ПредопределенноеЗначение("Перечисление.СМ_ИсточникиДобавленияПозиций.ВнешняяНормативнаяБаза");
			ПозицияЛС 				= ЗаполнитьДанныеДокумента(ТекРаздел,НомерВДереве,СпособСоздания,ШифрРасценки);
			ТекСтрока.Элемент 		= ПозицияЛС;
			СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(ОбщТекРаздел, ТекСтрока, Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы());
			
			ИзмерительПозиции = ПолучитьИзмерительПозиции(Данные);
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ТекСтрока",ТекСтрока);
			ДопПараметры.Вставить("Данные",Данные);
			ДопПараметры.Вставить("ПозицияЛС",ПозицияЛС);
			
			ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеВводаФомрулыОбъема",ЭтаФорма,ДопПараметры);
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("ИзмерительПозиции",ИзмерительПозиции);
			ОткрытьФорму("Документ.СМ_ЛокальнаяСмета.Форма.ФормаВводаФормулы",СтруктураПараметров,ЭтаФорма,,,,ОповещениеОЗакрытии,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ИначеЕсли ТаблицаВыбораРасценок.Количество() > 1 Тогда
			ТекСтрока.НоваяСтрока = Ложь;
	  	  ПараметрыОповещения = Новый Структура;
	  	  ПараметрыОповещения.Вставить("СпособСоздания",ПредопределенноеЗначение("Перечисление.СМ_ИсточникиДобавленияПозиций.ВнешняяНормативнаяБаза"));
	  	  ПараметрыОповещения.Вставить("ИсточникСоздания",ШифрРасценки);
			ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеВыбораПозиции",ЭтаФорма,ПараметрыОповещения);
			СтруктураПараметров = Новый Структура("ТаблицаВыбораРасценок,Шифр,Район",ТаблицаВыбораРасценок,ШифрРасценки,КодРайона);
			ОткрытьФорму("Документ.СМ_ЛокальнаяСмета.Форма.ФормаВыбораРасценок",СтруктураПараметров,ЭтаФорма,,,,ОповещениеОЗакрытии,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе
			ТекстВопроса = НСтр("ru='С подобным кодом не найдено расценок! 
			|Хотите открыть поиск по всем базам (Кнопка ""Да"") ? Кнопка ""Нет"" отказ.'");
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаКод", ЭтаФорма, Новый Структура("ТекСтрока,ШифрРасценки,КодРайона",ТекСтрока,ШифрРасценки,КодРайона));
			ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
		КонецЕсли;

	Иначе // подмена
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаКод(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		СтрокаВвода = ДеревоЛС.НайтиПоИдентификатору(ЭЛементы.ДеревоЛС.ТекущаяСтрока);
		Родитель 	= СтрокаВвода.ПолучитьРодителя();
		ТекСтрока 	= Родитель.Элемент;
		Родитель 	= Родитель.ПолучитьЭлементы();
		Родитель.Удалить(Родитель.количество()-1);
		ОбновитьПеренумероватьДерево(Ложь,ТекСтрока);
	Иначе
	  	ПараметрыОповещения = Новый Структура;
	  	ПараметрыОповещения.Вставить("СпособСоздания",ПредопределенноеЗначение("Перечисление.СМ_ИсточникиДобавленияПозиций.ВнешняяНормативнаяБаза"));
	  	ПараметрыОповещения.Вставить("ИсточникСоздания",Параметры.ШифрРасценки);
		Параметры.ТекСтрока.НоваяСтрока = Ложь;
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеВыбораПозиции",ЭтаФорма,ПараметрыОповещения);
		СтруктураПараметров = Новый Структура("ТаблицаВыбораРасценок,Шифр,Район",ТаблицаВыбораРасценок,Параметры.ШифрРасценки,Параметры.КодРайона);
		ОткрытьФорму("Документ.СМ_ЛокальнаяСмета.Форма.ФормаВыбораРасценок",СтруктураПараметров,ЭтаФорма,,,,ОповещениеОЗакрытии,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьДанныеДокумента(ТекРаздел,НомерВДереве,СпособСоздания = Неопределено,ИсточникСоздания = "")
	
	ПозицияЛС 			= СМ_СметаВызовСервера.СоздатьНовуюПозицию();
	СМ_СметаВызовСервера.ЗаполнитьДанныеДокументаВСтруктуреСмет(ПозицияЛС, ТекРаздел);
	ПозицияЛС.Расчет 			= Истина;
	ПозицияЛС.Дата 				= ТекущаяДатаСеанса();
	ПозицияЛС.ИсточникСоздания 	= ИсточникСоздания;
	Если СпособСоздания <> Неопределено Тогда
		ПозицияЛС.СпособСоздания = СпособСоздания;
	КонецЕсли;
	ПозицияЛС.Записать();
	СМ_СметаВызовСервера.УстановитьНомерДокумента(ПозицияЛС.Ссылка, , , НомерВДереве, , "СМ_ПозицияЛокальнойСметы");
	
	Возврат ПозицияЛС.Ссылка;
	
КонецФункции

&НаКлиенте
Процедура ПослеВводаФомрулыОбъема(Результат, Параметры) Экспорт
	ПозицияСсылка = Параметры.ПозицияЛС;
	ПозицияЛС = ПозицияСсылка;
	Данные = Параметры.Данные;

	
	ПараметрыЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(,ПозицияЛС);
	СтруктураПараметровФормыВыбораВНБ = СМ_СметаВызовСервера.ОбновитьДанныеВПозицииЛС(Данные, ПозицияСсылка ,Истина,,ПараметрыЛС,СМ_ВерсияКомпоненты);
	ЗаполнитьОбъемФормулу(Результат,ПозицияЛС);
	
	Если (Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Расценка")) Тогда
		Если Объект.АвтозагрузкаИндексов И ЗначениеЗаполнено(Объект.ФайлСборникаКоэффициентов) И (ПозицияЛС <> Неопределено) Тогда
			// обновляем индексы
			СтруктураДанных = Новый Структура("СборникКоэффициентов", Объект.ФайлСборникаКоэффициентов);
			Если Объект.ПрименятьИндексыКоВсемБазам Тогда
				СтруктураДанных.Вставить("КодРегиональнойБазы", Объект.КодРегионаФайлаИндексовПересчета);
			КонецЕсли;
			ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОбИндексахПересчета(ПозицияЛС, , СтруктураДанных);
			СМ_СметаВызовСервера.ЗагрузитьИндексыВПозиции(ПозицияЛС, ДанныеИнд, Объект.ВариантПересчетаЭММ, Истина, Истина,);	
		КонецЕсли;
	КонецЕсли;
	
	// вставка текущих цен если отмечено
	Если Объект.АвтозагрузкаЦен И ЗначениеЗаполнено(Объект.ФайлСборникаТекущихЦен) И (ПозицияЛС <> Неопределено) Тогда
		// обновляем индексы
		СтруктураДанных = Новый Структура("СборникТекущихЦен, КодРегиональнойБазы", Объект.ФайлСборникаТекущихЦен, Объект.КодРегионаФайлаТекущихЦен);
		ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОТекущихЦенах(ПозицияЛС, , СтруктураДанных);
		СМ_СметаВызовСервера.ЗагрузитьТекущиеЦеныВПозиции(ПозицияЛС, ДанныеИнд, Истина,  Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.Ресурсный"));
	КонецЕсли;
	
	ОбновитьПеренумероватьДерево(Истина, Параметры.ТекСтрока.Элемент);

	НадоОБновлять = Ложь;
	Если ТипЗнч(СтруктураПараметровФормыВыбораВНБ) = Тип("Структура") Тогда
		
		Если Объект.ФайлСборникаТекущихЦен <> "" Тогда
			ТаблицаРесурсов = ПолучитьНеучтенныеРесурсы(СтруктураПараметровФормыВыбораВНБ.Ресурсы);
			СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(,ПозицияЛС);
			Для Каждого стр Из ТаблицаРесурсов Цикл
				СтруктураЦен = Новый Структура();
				СтруктураЦен.Вставить("БазиснаяЦена");
				СтруктураЦен.Вставить("БазиснаяЗарплатаМашинистов");
				СтруктураЦен.Вставить("ТекущаяЦена");
				СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов");
				СМ_СметаКлиент.ПолучитьЦеныНовогоРесурса(стр.Ресурс,Объект.Район,Объект.ФайлСборникаТекущихЦен,СтруктураПараметровРасчетаЛС.КодРегионаФайлаТекущихЦен,СтруктураЦен);
				Если ЗначениеЗаполнено(СтруктураЦен.ТекущаяЦена) Тогда
					стр.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
				КонецЕсли;
			КонецЦикла;
			
			ПомещениеНеучтенныхРесурсов(ТаблицаРесурсов,СтруктураПараметровФормыВыбораВНБ.Ресурсы);
		Иначе
			ЗаполнитьЦеныНеучтенныхРесурсов(СтруктураПараметровФормыВыбораВНБ.Ресурсы);
		КонецЕсли;
		
		СМ_СметаКлиент.ОткрытьФормуПодбораНеучтенныхРесурсов(СтруктураПараметровФормыВыбораВНБ,НадоОБновлять);
		СтруктураПараметровФормыВыбораВНБ = Неопределено;
	КонецЕсли;
	Если НадоОБновлять Тогда
		ОбновитьПеренумероватьДерево(Истина, Параметры.ТекСтрока.Элемент);
	КонецЕсли;

	СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы(), ДеревоЛС, ОбщТекРаздел);
	Элементы.ДеревоЛС.ТекущийЭлемент = Элементы.ДеревоЛСГруппа2.ПодчиненныеЭлементы.ДеревоЛСКол;

КонецПроцедуры

&НаСервере
Функция ПолучитьКодБазы(РегионДляВыбораЦен)
    Возврат СокрЛП(РегионДляВыбораЦен.Код);	
КонецФункции

&НаСервере
Процедура ЗаполнитьОбъемФормулу(СтруктураПараметров,ПозицияСсылка)
	
	ПозицияЛС = ПозицияСсылка.ПолучитьОбъект();
	Если СтруктураПараметров = Неопределено Тогда
		ПозицияЛС.ОбъемРабот = 0;
		ПозицияЛС.ФормулаОбъема = "";
	Иначе
		ПозицияЛС.ОбъемРабот = СтруктураПараметров.ОбъемРабот;
		ПозицияЛС.ФормулаОбъема = СтруктураПараметров.ФормулаОбъема;
	КонецЕсли;

	ВводОбъемовВБазовыхЕдИзм = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ВводОбъемовВБазовыхЕдИзм", Ложь);
	Если ВводОбъемовВБазовыхЕдИзм Тогда
		ПозицияЛС.ОбъемРабот = СМ_СметаВызовСервера.ПересчитатьВбазовыхЕдиницахИзмерения(ПозицияЛС,ПозицияЛС.ОбъемРабот);
		Если ЗначениеЗаполнено(ПозицияЛС.ФормулаОбъема) Тогда
			ПозицияЛС.ФормулаОбъема = СМ_СметаВызовСервера.ПересчитатьФормулаВбазовыхЕдиницахИзмерения(ПозицияЛС,ПозицияЛС.ФормулаОбъема);	
		КонецЕсли;
	КонецЕсли;
	ПозицияЛС.ОбменДанными.Загрузка = Истина;
	ПозицияЛС.Записать()
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПозиции(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		СтрокаВвода = ДеревоЛС.НайтиПоИдентификатору(ЭЛементы.ДеревоЛС.ТекущаяСтрока);
		Родитель 	= СтрокаВвода.ПолучитьРодителя();
		ТекСтрока 	= Родитель.Элемент;
		Родитель 	= Родитель.ПолучитьЭлементы();
		Родитель.Удалить(Родитель.количество()-1);
		ОбновитьПеренумероватьДерево(Ложь,ТекСтрока);
		Возврат;
	КонецЕсли;
	
	ИсточникСоздания 	= "";
	СпособСоздания		= "";
	Параметры.Свойство("ИсточникСоздания",ИсточникСоздания);
	Параметры.Свойство("СпособСоздания",СпособСоздания);
	
	ТекСтрока 			= Элементы.ДеревоЛС.ТекущиеДанные;
	ТекРаздел 			= ТекСтрока.РодительРасценки;
	Данные 				= Результат.Данные;
	НомерВДереве 		= ИдентификаторВерхнейСтроки+0.01;
	ПозицияЛС 			= ЗаполнитьДанныеДокумента(ТекРаздел,НомерВДереве,СпособСоздания,ИсточникСоздания);
	ТекСтрока.Элемент 	= ПозицияЛС;
	СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(ОбщТекРаздел, ТекСтрока, Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы());

	ИзмерительПозиции = ПолучитьИзмерительПозиции(Данные);
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ТекСтрока",ТекСтрока);
	ДопПараметры.Вставить("Данные",Данные);
	ДопПараметры.Вставить("ПозицияЛС",ПозицияЛС);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеВводаФомрулыОбъема",ЭтаФорма,ДопПараметры);
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ИзмерительПозиции",ИзмерительПозиции);
	ОткрытьФорму("Документ.СМ_ЛокальнаяСмета.Форма.ФормаВводаФормулы",СтруктураПараметров,ЭтаФорма,,,,ОповещениеОЗакрытии,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИзмерительПозиции(Данные)
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Данные);
	Пока ЧтениеXML.Прочитать() Цикл
		Если (ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента)ИЛИ(ЧтениеXML.ТипУзла = ТипУзлаXML.Текст) Тогда
			Имя = НРег(ЧтениеXML.Имя);
			Если Имя = "norm" Тогда
				ИзмерительПозиции = ВернутьНаименованиеЕдиницуИзXML(ЧтениеXML);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат ИзмерительПозиции;
КонецФункции

&НаСервере
Функция ВернутьНаименованиеЕдиницуИзXML(Тег)
	ИзмерительПозиции = "";
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
			Продолжить;
		КонецЕсли;
		ТегИмя = НРег(Тег.Имя);
		Если ТегИмя = "unit" Тогда
			ИзмерительПозиции = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоКоду(Тег.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат ИзмерительПозиции;
КонецФункции

&НаСервере
Процедура ПолучитьДанныеПозиции(Данные)
	ПозицияЛС = ТаблицаВыбораРасценок.Добавить();	
	ПозицияЛС.Данные = Данные;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Данные);
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если (ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента)ИЛИ(ЧтениеXML.ТипУзла = ТипУзлаXML.Текст) Тогда
			Имя = НРег(ЧтениеXML.Имя);
			Если Имя = "collection" Тогда
				ЗаполнитьНСПозицииЛСИзXML(ЧтениеXML,ПозицияЛС);
			ИначеЕсли Имя = "norm" Тогда
				ЗаполнитьНаименованиеЕдиницуИзXML(ЧтениеXML,ПозицияЛС);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПолучитьДанныеВсеПозиции(Данные)
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Данные);
	ДанныеУрезаны = Данные;
	Пока ЧтениеXML.Прочитать() Цикл
		Если (ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента)ИЛИ(ЧтениеXML.ТипУзла = ТипУзлаXML.Текст) Тогда
			Имя = НРег(ЧтениеXML.Имя);
			Если Имя = "norm" Тогда
				
				ПозицияЛС = ТаблицаВыбораРасценок.Добавить();	
				
				НачальныйСимв = СТРНайти(ДанныеУрезаны,"<Norm");
				КонечСимвол = СТРНайти(ДанныеУрезаны,"</Norm>")+7;
				
				СтрЗамена = Сред(ДанныеУрезаны,НачальныйСимв,КонечСимвол-НачальныйСимв);
				ПозицияЛС.Данные = СтрЗамена;
				ДанныеУрезаны = СтрЗаменить(ДанныеУрезаны,СтрЗамена,"");

				ЗаполнитьНаименованиеЕдиницуИзXML(ЧтениеXML,ПозицияЛС);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНСПозицииЛСИзXML(Тег,СтрТЗ)
	
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
			Продолжить;
		КонецЕсли;
		Если Тег.Имя = "code" Тогда
			СтрТЗ.РегиональнаяБаза = Справочники.СМ_СметноНормативныеБазы.НайтиПоКоду(Тег.Значение);	
		ИначеЕсли Тег.Имя = "worktype" Тогда
			СтрТЗ.ТипНормативныхСборников = СМ_СметаЗагрузкаВызовСервера.ОпределитьТипНормСборникаПоКоду(Тег.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаименованиеЕдиницуИзXML(Тег, СтрТЗ)
	
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
			Продолжить;
		КонецЕсли;
		ТегИмя = НРег(Тег.Имя);
		Если ТегИмя = "code" Тогда
			СтрТЗ.Шифр = Тег.Значение;
		ИначеЕсли ТегИмя = "name" Тогда
			СтрТЗ.Наименование = Тег.Значение;
		ИначеЕсли ТегИмя = "unit" Тогда
			СтрТЗ.ЕдиницаИзмерения = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоКоду(Тег.Значение);
		ИначеЕсли ТегИмя = "normtypecode" Тогда
			СтрТЗ.ТипНормативныхСборников = СМ_СметаЗагрузкаВызовСервера.ОпределитьТипНормСборникаПоКоду(Тег.Значение);
		ИначеЕсли ТегИмя = "regioncode" Тогда
			СтрТЗ.РегиональнаяБаза = Справочники.СМ_СметноНормативныеБазы.НайтиПоКоду(Тег.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЛСПередУдалением(Элемент, Отказ)
	Если ЗначениеЗаполнено(ИдФормы) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ВыполнитьУдаление();
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьУдаление()
	
	// Если СуществуютАкты Тогда
	//	Возврат;
	// КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(,НСтр("ru='Новый документ необходимо сначала записать.'"),,НСтр("ru='Внимание'"));
		Возврат;
	КонецЕсли;
	
	Если Элементы.ДеревоЛС.ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(,НСтр("ru='Выберите строку документа'"),,НСтр("ru='Внимание'"));
		Возврат;
	КонецЕсли;    
	
	ТекСтрока = Неопределено;
	Для Каждого ИдентификаторСтроки Из Элементы.ДеревоЛС.ВыделенныеСтроки Цикл
		
		ВыбраннаяСтрока = ДеревоЛС.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		Если ВыбраннаяСтрока.ИндексПривязана = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Позиция ""%1"" является привязанной, чтобы ее удалить надо сначала отвязать от позиции'"), ВыбраннаяСтрока.Наименование));
			Продолжить;
		КонецЕсли;
		
		ТекСтрока = СМ_СметныйСоставКлиент.ТекущаяСтрокаПослеУдаленияВДереве(ДеревоЛС, ВыбраннаяСтрока);
		
		Если ТекСтрока = Неопределено Тогда
			ПоказатьПредупреждение(,НСтр("ru='Нельзя удалить корень документа'"),,НСтр("ru='Внимание'"));
			Возврат;
		Иначе
			
			УдалитьЭлементСервер(ВыбраннаяСтрока.Элемент, Объект.Ссылка);   
			
		КонецЕсли;
	КонецЦикла;

	ОбновитьПеренумероватьДерево(Истина, ТекСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура МетодикаТСНПриИзменении(Элемент)
	
	Если Объект.МетодикаТСН = Истина Тогда
		Объект.Методика1984 				= Ложь;
		Объект.РасчетНРиСПотПЗ				= Ложь;
		Объект.БезПримененияКоэффициентов 	= Ложь;
		Объект.БазисныеЦены  				= Ложь;
		Элементы.БазисныеЦены.Доступность 	= Ложь;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура Методика1984ПриИзменении(Элемент)
	
	Если Объект.Методика1984 = Истина Тогда
		Объект.МетодикаТСН = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МетодикаРасчетаПриИзменении(Элемент)

	Если Объект.МетодикаРасчета = ПредопределенноеЗначение("Справочник.СМ_МетодикиРасчета.СМ_Методика84года") Тогда
		
		Элементы.СтраницаМетодикаТСН.Видимость 		= Ложь;
		Элементы.СтраницаМетодикаТСН.Доступность	= Ложь;
		Элементы.БазисныеЦены.Доступность			= Истина;
		
	ИначеЕсли Объект.МетодикаРасчета = ПредопределенноеЗначение("Справочник.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква") Тогда
		
		Объект.РасчетНРиСПотПЗ 						= Ложь;
		Объект.БезПримененияКоэффициентов 			= Ложь;
		Объект.БазисныеЦены  						= Ложь;

		Элементы.СтраницаМетодикаТСН.Видимость 		= Истина;
		Элементы.СтраницаМетодикаТСН.Доступность	= Истина;
		Элементы.БазисныеЦены.Доступность 			= Ложь;
		
	Иначе
		
		Объект.РасчетНРиСПотПЗ 						= Ложь;
		Объект.БезПримененияКоэффициентов 			= Ложь;
		Объект.БазисныеЦены  						= Ложь;
		
		Элементы.СтраницаМетодикаТСН.Видимость 		= Ложь;
		Элементы.СтраницаМетодикаТСН.Доступность	= Ложь;
		Элементы.БазисныеЦены.Доступность			= Истина;
		
	КонецЕсли;

	Если Объект.МетодикаРасчета = ПредопределенноеЗначение("Справочник.СМ_МетодикиРасчета.СМ_КЗ_РСНБ") Тогда
		
		Объект.ПечататьСетку 				= Истина;
		Объект.ПечататьЗаголовкиРазделов 	= Истина;
		Объект.ПечататьИтогиПоРазделам 		= ПредопределенноеЗначение("Перечисление.СМ_ПечатьИтоговРаздела.ПечататьПервые");
		Объект.РасшифроватьСостав 			= Истина;
		
		Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.Ресурсный");
		СМ_СметаКлиент.ОтобразитьУровеньМетодРасчета(ЭтаФорма); 
		ВидимостьДоступностьЭлементовНаФорме();
		
		Объект.АвтозагрузкаЦен 		= Истина;
		Объект.ДатаТекущихЦен 		= НачалоКвартала(Объект.Дата);
		Объект.РегионДляВыбораЦен 	= ПолучитьКЗ_РСНБ();
	КонецЕсли;
	
	ВидимостьСМ_КЗ_РСНБ();
	
	СМ_СметаКлиентСервер.ЗаполнитьРеквизитыПоУмолчанию(Объект, Объект.МетодикаРасчета);
	СМ_СметаКлиентСервер.НастройкиВидимостиДоступности(ЭтаФорма, Объект.МетодикаРасчета);
	МассивСообшений = СМ_СметаКлиентСервер.ПроверитьКорректностьЗаполненныхРеквизитов(Объект, Объект.МетодикаРасчета);
	Для Каждого ТекСообщение Из МассивСообшений Цикл
		Сообщение 		= Новый СообщениеПользователю();
		Сообщение.Текст = ТекСообщение;
		Сообщение.Сообщить();	
	КонецЦикла;

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

