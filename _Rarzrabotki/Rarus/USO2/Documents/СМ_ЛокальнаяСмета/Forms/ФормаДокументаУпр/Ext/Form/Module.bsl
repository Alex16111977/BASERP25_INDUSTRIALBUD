Процедура УдалитьЭлемент(Команда)
	
	ВыполнитьУдаление();
			
КонецПроцедуры

&НаКлиенте
Процедура ПривязатьОтвязатьПозицию(Команда)
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, НСтр("ru='Новый документ необходимо сначала записать.'"),,НСтр("ru='Внимание'"));
		Возврат;
	КонецЕсли;
	Позиция = Элементы.ДеревоЛС.ТекущиеДанные.Элемент;
	
	Если ТипЗнч(Позиция)=Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда		
		ИДПозицииВладельца = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Позиция, "ИДПозицииВладельца");
		Если ЗначениеЗаполнено(ИДПозицииВладельца) Тогда
			ИДПозицииВладельца = ПредопределенноеЗначение("Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка");
			ПриЗакрытииФормыВыбораНовогоВладельцаПриПривязке(ИДПозицииВладельца, Новый Структура("ВызовПриЗакрытии, Позиция", Ложь, Позиция));
		Иначе
			
			Если ЭтоРабота(Позиция) Тогда
				ПоказатьПредупреждение(,НСтр("ru='Привязывать можно только ""Не работы"" !'"));
			Иначе
				ИдРодителя = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Позиция, "ИдРодителя");
				
				ПараметрыПозиции = Новый Структура;
				ПараметрыПозиции.Вставить("Раздел",ИдРодителя);
				ПараметрыПозиции.Вставить("Позиция",Позиция);
				
				
				ОписаниеОповещения = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораНовогоВладельцаПриПривязке",ЭтаФорма,Новый Структура("ВызовПриЗакрытии, Позиция", Истина, Позиция));
				ОткрытьФорму("Документ.СМ_ПозицияЛокальнойСметы.Форма.ФормаВыбораЧастнаяУпр",ПараметрыПозиции,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			КонецЕсли;
		КонецЕсли;   
	Иначе
		Состояние(НСтр("ru='Отвязывать и привязывать можно только Позиции'"),100,НСтр("ru='Внимание: Вы выбрали раздел локальной сметы!'"),БиблиотекаКартинок.Информация32);
	КонецЕсли;   
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПеренумероватьДерево(Перенумеровать = Истина, СохраненнаяСтрока = Неопределено, ПолноеОбновление = Ложь)
	
	ТекущиеДанные = Элементы.ДеревоЛС.ТекущиеДанные;
	СтрокаДерева = Неопределено;
	СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(СтрокаДерева, ТекущиеДанные, Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы());
	
	Если СохраненнаяСтрока <> Неопределено Тогда
		СтрокаДерева.ТекущийЭлемент = СохраненнаяСтрока;
	КонецЕсли;
	
	Если ИдентификаторВерхнейСтроки = Неопределено Тогда  //KS
		ОбновитьДерево(Перенумеровать, ?(ПолноеОбновление,Неопределено,СтрокаДерева.ТекущийЭлемент));
	Иначе
		ОбновитьДерево(Перенумеровать, ?(ПолноеОбновление,Неопределено,СтрокаДерева.ТекущийЭлемент),ИдентификаторВерхнейСтроки);
	КонецЕсли;
	
	Если ПустаяСтрока(ИдФормы) Тогда
		ИдентификаторВерхнейСтроки = Неопределено;
	КонецЕсли;
	
	СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы(), ДеревоЛС, СтрокаДерева);
		
КонецПроцедуры

&НаКлиенте
Процедура Перенумеровать(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, НСтр("ru='Новый документ необходимо сначала записать.'"),,НСтр("ru='Внимание'"));
		Возврат;
	КонецЕсли;
	ОбновитьПеренумероватьДерево(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНачальногоЗаполненияПараметровАкта(Результат, Структура) Экспорт
	СтруктураПараметров = Результат;
	Если СтруктураПараметров = Неопределено Тогда
		СтруктураПараметров = Новый Структура;
	КонецЕсли;
	
	ТекАкт = СоздатьНовыйАктСервер();
	СтруктураПараметров.Вставить("ЛокальнаяСмета",Объект.Ссылка);
	СтруктураПараметров.Вставить("Ключ",ТекАкт);
	
	ОткрытьФорму("Документ.СМ_АктВыполненныхРабот.ФормаОбъекта",СтруктураПараметров);

