	СтруктураДерева = СМ_СметаШаблоныВызовСервера.ПолучитьДанныеИзХранилищаДереваРазделов(Объект);
	
	Если СтруктураДерева.ЗаполнитьИзШаблона Тогда
		// TO DO: Исправить.
		// Реквизиты фомы не нужны, но сейчас используются.
		Если ЗначениеЗаполнено(СтруктураДерева.ДеревоРазделов) Тогда
			ЗначениеВРеквизитФормы(СтруктураДерева.ДеревоРазделов, "ДеревоРазделов");
		КонецЕсли;
		Если ЗначениеЗаполнено(СтруктураДерева.НаборШифров) Тогда
			ЗначениеВРеквизитФормы(СтруктураДерева.НаборШифров, "НаборШифров");
		КонецЕсли;
		// TO DO: Тут должна быть процедура типа:
		// СМ_СметаШаблоныВызовСервера.СоздатьСтруктуруПоШаблону(Объект, СтруктураДерева.ДеревоРазделов, СтруктураДерева.НаборШифров).
		// Учесть что смета может еще не записана.
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПодчиненныеРазделыИзШаблона(СтрокаШаблона, Родитель)
	
	Для Каждого ТекСтрока Из СтрокаШаблона.ПолучитьЭлементы() Цикл
		Если Не ЗначениеЗаполнено(ТекСтрока.Раздел) Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйРаздел = СоздатьРаздел(ТекСтрока.Раздел, Новый Структура("Родитель", Родитель));
		СоздатьПозицииПоНаборуШифров(ТекСтрока, НовыйРаздел);
		СоздатьПодчиненныеРазделыИзШаблона(ТекСтрока, НовыйРаздел);
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция НайтиШифрРасценкиВНормСборнике(ИдентификаторСтроки)
	
	ТекСтрока = НаборШифров.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ТекСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЗапросПоНормСборнику = Новый Запрос;
	ЗапросПоНормСборнику.Текст = "ВЫБРАТЬ
	                             |	СМ_НормативныеСборники.Ссылка
	                             |ИЗ
	                             |	Справочник.СМ_НормативныеСборники КАК СМ_НормативныеСборники
	                             |ГДЕ
	                             |	СМ_НормативныеСборники.КодНормативнойРасценки = &КодНормативнойРасценки
	                             |	И СМ_НормативныеСборники.ТипНормативногоСборника = &ТипНормативногоСборника
	                             |	И ВЫБОР
	                             |			КОГДА &ИспользоватьСтатусы
	                             |				ТОГДА СМ_НормативныеСборники.Статус = ЗНАЧЕНИЕ(Перечисление.СМ_СтатусыФормированияНормативов.Утвержден)
	                             |			ИНАЧЕ ИСТИНА
	                             |		КОНЕЦ";
	ЗапросПоНормСборнику.УстановитьПараметр("КодНормативнойРасценки", ТекСтрока.ШифрРасценки);
	ЗапросПоНормСборнику.УстановитьПараметр("ТипНормативногоСборника", ТекСтрока.ТипНормативныхСборников);
	ЗапросПоНормСборнику.УстановитьПараметр("ИспользоватьСтатусы",ПолучитьФункциональнуюОпцию("СМ_ИспользоватьСтатусыНормативов"));
	ВыборкаПоНормСборнику = ЗапросПоНормСборнику.Выполнить().Выбрать();
	Если ВыборкаПоНормСборнику.Следующий() Тогда
		Возврат ВыборкаПоНормСборнику.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции

&НаСервере
Функция НайтиШифрРасценкиВРесурсах(ИдентификаторСтроки)
	
	ТекСтрока = НаборШифров.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ТекСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗапросПоРесурсам 		= Новый Запрос;
	ЗапросПоРесурсам.Текст 	= "
	|ВЫБРАТЬ
	|	СМ_Ресурсы.Ссылка
	|ИЗ
	|	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
	|ГДЕ
	|	СМ_Ресурсы.Код = &Код И
	|	(СМ_Ресурсы.ЕдиницаИзмерения = &ЕдиницаИзмерения ИЛИ &ЕдиницаИзмеренияНеУказана)";
	ЗапросПоРесурсам.УстановитьПараметр("Код", ТекСтрока.ШифрРасценки);
	ЗапросПоРесурсам.УстановитьПараметр("ЕдиницаИзмерения", ТекСтрока.ЕдиницаИзмерения);
	ЗапросПоРесурсам.УстановитьПараметр("ЕдиницаИзмеренияНеУказана", ?(ЗначениеЗаполнено(ТекСтрока.ЕдиницаИзмерения), Ложь, Истина));
	
	ВыборкаПоРесурсам = ЗапросПоРесурсам.Выполнить().Выбрать();
	Если ВыборкаПоРесурсам.Следующий() Тогда
		Возврат ВыборкаПоРесурсам.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура СоздатьПозицииПоНаборуШифров(СтрокаШаблона, ТекРаздел)
	
	Если Не ЗначениеЗаполнено(СтрокаШаблона.КлючСтроки) Тогда 
		Возврат;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура("КлючСтроки", СтрокаШаблона.КлючСтроки);
	МассивШифров = НаборШифров.НайтиСтроки(ПараметрыОтбора);
	Если МассивШифров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НомерВДереве = ИдентификаторВерхнейСтроки;
	Для Каждого ТекСтрока Из МассивШифров Цикл
		НомерВДереве = НомерВДереве + 0.01;
		// Поиск в справочнике нормативных сборников
		РезультатПоиска = НайтиШифрРасценкиВНормСборнике(ТекСтрока.ПолучитьИдентификатор());
		Если РезультатПоиска <> Неопределено Тогда
			СтруктураПараметровФормыВыбораВНБ = СМ_СметаВызовСервера.СоздатьПозициюЛокальнойСметыПутемПодбораИзНормативногоСборника(Объект.Ссылка, РезультатПоиска, ТекРаздел,НомерВДереве, , , 1);
			Продолжить;
		КонецЕсли;
		
		// Поиск в справочнике ресурсов
		Если ТекСтрока.ТипНормативныхСборников = ПредопределенноеЗначение("Перечисление.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы")
			 Или ТекСтрока.ТипНормативныхСборников = ПредопределенноеЗначение("Перечисление.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин") Тогда
			РезультатПоиска = НайтиШифрРасценкиВРесурсах(ТекСтрока.ПолучитьИдентификатор());
			
			Если РезультатПоиска <> Неопределено Тогда
				ПараметрыРесурса = СМ_СметаКлиент.ИнициироватьСтруктуруОписанияРесурсаСмета(Объект, ТекРаздел);
				ПараметрыРесурса.Ресурс = РезультатПоиска; 
				Если ПараметрыРесурса.ЗагружатьТекущиеЦены И ЗначениеЗаполнено(Объект.ФайлСборникаТекущихЦен) Тогда
					СтруктураЦен = Новый Структура();
					СтруктураЦен.Вставить("БазиснаяЦена");
					СтруктураЦен.Вставить("БазиснаяЗарплатаМашинистов");
					СтруктураЦен.Вставить("ТекущаяЦена");
					СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов");
					СМ_СметаКлиент.ПолучитьЦеныНовогоРесурса(РезультатПоиска,Объект.Район,Объект.ФайлСборникаТекущихЦен,Объект.КодРегионаФайлаТекущихЦен,СтруктураЦен); 	
					ПараметрыРесурса.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
					ПараметрыРесурса.ТекущаяЗарплМаш = СтруктураЦен.ТекущаяЗарплатаМашинистов;
				КонецЕсли;
				
				СтруктураПараметровЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(Объект.Ссылка);
				Район = СтруктураПараметровЛС.Район;
				ДатаТекущихЦен = СтруктураПараметровЛС.ДатаТекущихЦен;
				РегиональнаяБаза = СтруктураПараметровЛС.РегионДляВыбораЦен;
				
				СтруктураЦенРегистр = Новый Структура();
				СтруктураЦенРегистр.Вставить("БазиснаяЦена");
				СтруктураЦенРегистр.Вставить("БазиснаяЗарплатаМашинистов");
				СтруктураЦенРегистр.Вставить("ТекущаяЦена");
				СтруктураЦенРегистр.Вставить("ТекущаяЗарплатаМашинистов");
				СМ_СметаВызовСервера.ПолучитьЦеныНовогоРесурса(РезультатПоиска,Район,РегиональнаяБаза,ДатаТекущихЦен,СтруктураЦенРегистр,Истина);
				
				Если Не ЗначениеЗаполнено(ПараметрыРесурса.ТекущаяЦена) Тогда
					ПараметрыРесурса.ТекущаяЦена = СтруктураЦенРегистр.ТекущаяЦена;
				КонецЕсли;
				Если Не ЗначениеЗаполнено(ПараметрыРесурса.ТекущаяЗарплМаш) Тогда
					ПараметрыРесурса.ТекущаяЗарплМаш = СтруктураЦенРегистр.ТекущаяЗарплатаМашинистов;
				КонецЕсли;

				ПараметрыРесурса.БазиснаяЦена = СтруктураЦенРегистр.БазиснаяЦена;
				ПараметрыРесурса.БазиснаяЗарплМаш = СтруктураЦенРегистр.БазиснаяЗарплатаМашинистов;

				СМ_СметаВызовСервера.ПолучитьОписаниеРесурса(ПараметрыРесурса);
				СтруктураПараметровФормыВыбораВНБ = СМ_СметаВызовСервера.СоздатьПозициюЛокальнойСметыПутемПодбораИзСправочникаРесурсы(Объект.Ссылка, РезультатПоиска, ТекРаздел,ПараметрыРесурса,НомерВДереве, Неопределено, Неопределено, 1);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		// Поиск во ВНБ
		Если СметнаяКомпонента <> Неопределено Тогда
			ТаблицаВыбораРасценок.Очистить();
			ШифрРасценки = ВРег(ТекСтрока.ШифрРасценки);
			
			СтруктураПараметров = СМ_СметаВызовСервера.ПолучитьШифр(ШифрРасценки);
			КодБазы  		= ?(ЗначениеЗаполнено(Объект.КодРегионаФайлаТекущихЦен),Объект.КодРегионаФайлаТекущихЦен,СтруктураПараметров.РегиональнаяБаза);
			ШифрРасценки 	= ?(ЗначениеЗаполнено(СтруктураПараметров.ШифрПозиции),СтруктураПараметров.ШифрПозиции,ШифрРасценки);
			ТипСборника 	= СтруктураПараметров.ТНС;
			КодРайона 		= НайтиКод(Объект.Район);
			
			Если НЕ ЗначениеЗаполнено(КодБазы) 
				И ЗначениеЗаполнено(Объект.РегионДляВыбораЦен) Тогда
				КодБазы = ПолучитьКодБазы(Объект.РегионДляВыбораЦен);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(КодБазы) И ЗначениеЗаполнено(ТипСборника) Тогда
				НомерСборника = СокрЛП(СМ_СметаВызовСервера.ОпределитьНомерСборника(ТипСборника,ШифрРасценки));
				Данные = СметнаяКомпонента.ОбновитьПоБазе(ШифрРасценки,КодРайона,КодБазы,ТипСборника,НомерСборника);
				Если ЗначениеЗаполнено(Данные) И СМ_СметаЗагрузкаВызовСервера.ЕстьДанные(Данные) = Ложь Тогда
					Возврат;
				КонецЕсли;
				Если ЗначениеЗаполнено(Данные) Тогда
					ПолучитьДанныеПозиции(Данные);
				КонецЕсли;
			Иначе
				Попытка
					Данные = СметнаяКомпонента.ПоискРасценок(КодРайона,ШифрРасценки,"");
					Если ЗначениеЗаполнено(Данные) И СМ_СметаЗагрузкаВызовСервера.ЕстьДанные(Данные) = Ложь Тогда
					Иначе
						ПолучитьДанныеВсеПозиции(Данные);
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;
			
			Если ТаблицаВыбораРасценок.Количество() > 0 Тогда
				Данные 			= ТаблицаВыбораРасценок[0].Данные;
				СпособСоздания	= ПредопределенноеЗначение("Перечисление.СМ_ИсточникиДобавленияПозиций.ВнешняяНормативнаяБаза");
				ПозицияЛС 		= ЗаполнитьДанныеДокумента(ТекРаздел,НомерВДереве,СпособСоздания,ШифрРасценки);
				ЗаполнитьОбъемФормулу(Новый Структура("ОбъемРабот,ФормулаОбъема", 1, ТекСтрока.ФормулаОбъема), ПозицияЛС);
				ПараметрыЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(Объект.Ссылка);
				СтруктураПараметровФормыВыбораВНБ = СМ_СметаВызовСервера.ОбновитьДанныеВПозицииЛС(Данные, ПозицияЛС,,,ПараметрыЛС,СМ_ВерсияКомпоненты);
				
				Если (Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Расценка")) Тогда
					Если Объект.АвтозагрузкаИндексов И ЗначениеЗаполнено(Объект.ФайлСборникаКоэффициентов) И (ПозицияЛС <> Неопределено) Тогда
						// обновляем индексы
						СтруктураДанных = Новый Структура("СборникКоэффициентов", Объект.ФайлСборникаКоэффициентов);
						Если Объект.ПрименятьИндексыКоВсемБазам Тогда
							СтруктураДанных.Вставить("КодРегиональнойБазы", Объект.КодРегионаФайлаИндексовПересчета);
						КонецЕсли;
						ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОбИндексахПересчета(ПозицияЛС, , СтруктураДанных);
						СМ_СметаВызовСервера.ЗагрузитьИндексыВПозиции(ПозицияЛС, ДанныеИнд, Объект.ВариантПересчетаЭММ, Истина, Истина,);	
					КонецЕсли;
				КонецЕсли;
				
				// вставка текущих цен если отмечено
				Если Объект.АвтозагрузкаЦен И ЗначениеЗаполнено(Объект.ФайлСборникаТекущихЦен) И (ПозицияЛС <> Неопределено) Тогда
					// обновляем индексы
					СтруктураДанных = Новый Структура("СборникТекущихЦен, КодРегиональнойБазы", Объект.ФайлСборникаТекущихЦен, Объект.КодРегионаФайлаТекущихЦен);
					ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОТекущихЦенах(ПозицияЛС, , СтруктураДанных);
					СМ_СметаВызовСервера.ЗагрузитьТекущиеЦеныВПозиции(ПозицияЛС, ДанныеИнд, Истина,  Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.Ресурсный"));
				КонецЕсли;
	
				Продолжить;
				
			КонецЕсли;
		КонецЕсли;
		
		// Если нигде не нашли, сообщить пользователю
		СообщениеПользователю = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось создать позицию с шифром %1'"), ТекСтрока.ШифрРасценки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеПользователю);
		
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если СуществуютАкты Тогда 
		Возврат;
	КонецЕсли;
	
	Если ЗаполнитьСоставСметыПоШаблону Тогда
		ПолучитьДанныеИзХранилищаДереваРазделов();
		// TO DO: Исправить.
		// Реквизиты фомы не нужны, но сейчас используются.
	 	Если ДеревоРазделов.ПолучитьЭлементы().Количество() > 0 Тогда
			ПерваяСтрока = ДеревоРазделов.ПолучитьЭлементы()[0];
			СоздатьПодчиненныеРазделыИзШаблона(ПерваяСтрока, Объект.Ссылка);
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьПеренумероватьДерево(Ложь,,Истина);
	
	Если ДеревоЛС.ПолучитьЭлементы().Количество() = 0 Тогда
		Стр 				= ДеревоЛС.ПолучитьЭлементы().Добавить();
		Стр.Элемент 		= Объект.Ссылка;
		Стр.Наименование	= Объект.Наименование;
	КонецЕсли;
	
	ВидимостьДоступностьЭлементовНаФорме();
	
	// Оповещение открытых форм об изменении
	// Оповещаем СС и ОС.
	СписокСвязанных = ПолучитьССиОС(Объект.Ссылка);
	Если СписокСвязанных.Количество()>0 Тогда
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("СписокСмет",СписокСвязанных);
		Оповестить("ОбновитьДеревоССОС",СтруктураПараметров);
	КонецЕсли;
	
	// Например обработки "Дерево смет"
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Стройка",Объект.Стройка);
	СтруктураПараметров.Вставить("Смета",Объект.Ссылка);
	Оповестить("ОбновитьДеревоСмет",СтруктураПараметров);

	ОбновитьВидимостьЗаголовкаПараметров();

КонецПроцедуры

#КонецОбласти

