								Прервать;
							КонецЕсли;
							ТекИндекс = ТекИндекс - 1;
						КонецЦикла;
						ОсуществитьПеремещение(Документ, Неопределено, ПервыйПривязанныйДокумент, ПоследнийПривязанныйДокумент, -1);
						ВыполненоПеремещение = Истина;
					КонецЕсли;
					ТекИндекс = ТекИндекс + 1;
				КонецЦикла;
