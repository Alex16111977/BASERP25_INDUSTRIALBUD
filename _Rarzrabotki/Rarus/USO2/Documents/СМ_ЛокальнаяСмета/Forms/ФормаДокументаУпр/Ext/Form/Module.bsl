&НаКлиенте
Процедура УстановитьСтатусРесурсаПодрядчика(Команда)
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, НСтр("ru='Новый документ необходимо сначала записать.'"),,НСтр("ru='Внимание'"));
		Возврат;
	КонецЕсли;
	
	Позиция = Элементы.ДеревоЛС.ТекущиеДанные.Элемент;
	Если ТипЗнч(Позиция)=Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда		
		Если Не РазрешитьМенятьСтатус(Позиция) Тогда
			ПоказатьПредупреждение(,НСтр("ru='Менять статус можно только для ""материала"" или ""оборудования"" !'"));
		Иначе
			СтатусРесурса = ПредопределенноеЗначение("Перечисление.СМ_ОбеспечениеРесурса.Подрядчика");
			Элементы.ДеревоЛС.ТекущиеДанные.СтатусРесурса = СтатусРесурса;
			СменитьСтатусПозицииРесурса(СтатусРесурса,Позиция);
		КонецЕсли;
	Иначе
		Состояние(НСтр("ru='Менять статус можно только для Позиции'"),100,НСтр("ru='Внимание: Вы выбрали раздел локальной сметы!'"),БиблиотекаКартинок.Информация32);
	КонецЕсли;   

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтатусРесурсаСобственный(Команда)
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, НСтр("ru='Новый документ необходимо сначала записать.'"),,НСтр("ru='Внимание'"));
		Возврат;
	КонецЕсли;
	
	Позиция = Элементы.ДеревоЛС.ТекущиеДанные.Элемент;
	Если ТипЗнч(Позиция)=Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда		
		Если Не РазрешитьМенятьСтатус(Позиция) Тогда
			ПоказатьПредупреждение(,НСтр("ru='Менять статус можно только для ""материала"" или ""оборудования"" !'"));
		Иначе
			СтатусРесурса = ПредопределенноеЗначение("Перечисление.СМ_ОбеспечениеРесурса.Собственный");
			Элементы.ДеревоЛС.ТекущиеДанные.СтатусРесурса = СтатусРесурса;
			СменитьСтатусПозицииРесурса(СтатусРесурса,Позиция);
		КонецЕсли;
	Иначе
		Состояние(НСтр("ru='Менять статус можно только для Позиции'"),100,НСтр("ru='Внимание: Вы выбрали раздел локальной сметы!'"),БиблиотекаКартинок.Информация32);
	КонецЕсли;   
КонецПроцедуры

&НаСервере
Процедура СменитьСтатусПозицииРесурса(СтатусРесурса,Позиция)
	ПозицияОб = Позиция.ПолучитьОбъект();
	ПозицияОб.СтатусРесурса = СтатусРесурса;
	ПозицияОб.Записать();
	Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Функция РазрешитьМенятьСтатус(Позиция)
