
#Область ОписаниеПеременных

&НаКлиенте
Перем КомпонентаРенга;

&НаКлиенте
Перем ОбщТекРаздел;

&НаКлиенте
Перем ФормаДлительнойОперации;

&НаКлиенте
Перем ПараметрыОбработчика;

#КонецОбласти

#Область ОбработчикиСобытийФормы	

&НаКлиенте
Процедура ПоказатьИндексы(Команда)
	Элементы.ПоказатьИндексы.Пометка = Не Элементы.ПоказатьИндексы.Пометка;
	ВидимостьГруппаИндексы();
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьГруппаИндексы()
	Элементы.ГруппаКоэффициентыПересчета.Видимость = Элементы.ПоказатьИндексы.Пометка;
	Элементы.ТекстКоэффициентов.Видимость = Элементы.ПоказатьИндексы.Пометка;
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьСоставаИндексов(СтруктураРасчета = Неопределено)
	Если СтруктураРасчета = Неопределено Тогда
		СтруктураРасчета = Новый Структура();
		СтруктураРасчета.Вставить("ЭтоБазисноИндексныйУровеньРасценка", (Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Расценка")));
		СтруктураРасчета.Вставить("ЭтоБазисноИндексныйУровеньРаздел", (Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Раздел")));
		СтруктураРасчета.Вставить("ЭтоБазисноИндексныйУровеньСмета", (Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Смета")));
		СтруктураРасчета.Вставить("ЭтоРесурсныйМетод", (Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.Ресурсный")));
		СтруктураРасчета.Вставить("ЭтоРасчетПоЭлементамЗатрат", Объект.СпособРасчетаИндексов = ПредопределенноеЗначение("Перечисление.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат"));
	КонецЕсли;
	// Видимость / доступность коэффициентов на закладке состав акта
	Элементы.КоэффициентОснЗарплаты.Видимость 			= Ложь;
	Элементы.КоэффициентСтоимЭксплМашин.Видимость     	= Ложь;
	Элементы.КоэффициентСтоимЗарплатеМашин.Видимость  	= Ложь;
	Элементы.КоэффициентСтоимМатериалы.Видимость      	= Ложь;
	Элементы.КоэффициентОборудование.Видимость        	= Ложь;
	Элементы.КоэффициентСтоимостьРабот.Видимость      	= Ложь;
	Элементы.КоэффициентСМР.Видимость                 	= Ложь;
	Элементы.КоэффициентФОТ.Видимость                	= Ложь;
	Элементы.КоэффициентПрочРаб.Видимость             	= Ложь;
	Элементы.ТекстКоэффициентов.Видимость = Ложь;
	Элементы.ПоказатьИндексы.Видимость = Ложь;
	// Уровень - "Расценка / раздел" 
	Если СтруктураРасчета.ЭтоБазисноИндексныйУровеньРасценка
		ИЛИ СтруктураРасчета.ЭтоБазисноИндексныйУровеньРаздел Тогда
		Элементы.ТекстКоэффициентов.Видимость = Истина И Элементы.ПоказатьИндексы.Пометка;
		Элементы.ПоказатьИндексы.Видимость = Истина;

		// Способ расчета - "По элементам затрат":
		Если СтруктураРасчета.ЭтоРасчетПоЭлементамЗатрат Тогда
			Элементы.КоэффициентОснЗарплаты.Видимость			= Истина;
			Элементы.КоэффициентСтоимЭксплМашин.Видимость     	= Истина;
			Элементы.КоэффициентСтоимЗарплатеМашин.Видимость  	= Истина;
			Элементы.КоэффициентСтоимМатериалы.Видимость      	= Истина;
			Элементы.КоэффициентОборудование.Видимость        	= Истина;
			// Способ расчета - "К полной стоимости":
		Иначе
			Элементы.КоэффициентСтоимостьРабот.Видимость = Истина;
		КонецЕсли;
		
		// Уровень - "Смета"
	ИначеЕсли СтруктураРасчета.ЭтоБазисноИндексныйУровеньСмета Тогда
		Элементы.ТекстКоэффициентов.Видимость = Истина И Элементы.ПоказатьИндексы.Пометка;
		Элементы.ПоказатьИндексы.Видимость = Истина;
		
		// Способ расчета - "По элементам затрат":
		Если СтруктураРасчета.ЭтоРасчетПоЭлементамЗатрат Тогда
			Элементы.КоэффициентСтоимЭксплМашин.Видимость     	= Истина;
			Элементы.КоэффициентСтоимМатериалы.Видимость      	= Истина;
			Элементы.КоэффициентОборудование.Видимость        	= Истина;
			Элементы.КоэффициентФОТ.Видимость                 	= Истина;
			// Способ расчета - "К полной стоимости":	
		Иначе
			Элементы.КоэффициентОборудование.Видимость = Истина;
			Элементы.КоэффициентСМР.Видимость          = Истина;
			Элементы.КоэффициентФОТ.Видимость          = Истина;
			Элементы.КоэффициентПрочРаб.Видимость      = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураРасчета.ЭтоБазисноИндексныйУровеньСмета Тогда
		Элементы.ТекстКоэффициентов.Видимость = Истина И Элементы.ПоказатьИндексы.Пометка;
		Элементы.ПоказатьИндексы.Видимость = Истина;
		
		Элементы.КоэффициентОснЗарплаты.Доступность 		= Ложь;
		Элементы.КоэффициентСтоимЭксплМашин.Доступность     = Ложь;
		Элементы.КоэффициентСтоимЗарплатеМашин.Доступность  = Ложь;
		Элементы.КоэффициентСтоимМатериалы.Доступность      = Ложь;
		Элементы.КоэффициентОборудование.Доступность        = Ложь;
		Элементы.КоэффициентСтоимостьРабот.Доступность      = Ложь;
		Элементы.КоэффициентСМР.Доступность                 = Ложь;
		Элементы.КоэффициентФОТ.Доступность                 = Ложь;
		Элементы.КоэффициентПрочРаб.Доступность             = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьДоступностьЭлементовНаФорме()
	
	СкрытьПредупреждениеНаФорме();
	
	Структура = Новый Структура();
	Структура.Вставить("НомерСметы", Объект.НомерСметы);
	Структура.Вставить("Наименование", Объект.Наименование);
	Структура.Вставить("ЭтоБазисноИндексныйУровеньРасценка", (Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Расценка")));
	Структура.Вставить("ЭтоБазисноИндексныйУровеньРаздел", (Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Раздел")));
	Структура.Вставить("ЭтоБазисноИндексныйУровеньСмета", (Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Смета")));
	Структура.Вставить("ЭтоРесурсныйМетод", (Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.Ресурсный")));
	Структура.Вставить("ЭтоРасчетПоЭлементамЗатрат", Объект.СпособРасчетаИндексов = ПредопределенноеЗначение("Перечисление.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат"));
	Структура.Вставить("МетодикаТСН",Ложь);
	Структура.Вставить("Методика1984",Ложь);
	Структура.Вставить("РасчетНРиСПотПЗ", Ложь);
	Структура.Вставить("БезПримененияКоэффициентов", 0);
	
	//Метод1984 = СМ_СметаВызовСервера.ЗначениеОпции("СМ_Методика84Года");
	//Если Метод1984 Тогда
	//	Структура.Вставить("Методика1984", Объект.Методика1984);
	//	Структура.Вставить("РасчетНРиСПотПЗ", Объект.РасчетНРиСПотПЗ);
	//	Структура.Вставить("БезПримененияКоэффициентов", Объект.БезПримененияКоэффициентов);
	//КонецЕсли;	

	Если Объект.МетодикаРасчета = ПредопределенноеЗначение("Справочник.СМ_МетодикиРасчета.СМ_Методика84года") Тогда
		Структура.Методика1984 = Истина;	
	ИначеЕсли Объект.МетодикаРасчета = ПредопределенноеЗначение("Справочник.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква") Тогда
		Структура.МетодикаТСН = Истина;	
	КонецЕсли;

	НовыйЭлемент 									= Не ЗначениеЗаполнено(Объект.Ссылка);
	Элементы.ДеревоЛС.ТолькоПросмотр				= НовыйЭлемент;
	Элементы.ДеревоЛС.КоманднаяПанель.Доступность	= Не НовыйЭлемент;
	Элементы.СтраницаСостав.Видимость				= Не НовыйЭлемент;
	Элементы.СтраницаСостав.Доступность				= Не НовыйЭлемент;
	Элементы.ФормаЗаполнитьПоШаблону.Видимость 		= НовыйЭлемент;
	
	// в зависимости от метода счета
	Элементы.КоэффСМР.Видимость				= (Структура.ЭтоБазисноИндексныйУровеньСмета) И (НЕ Структура.ЭтоРасчетПоЭлементамЗатрат) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.КоэффФОТ.Видимость				= (Структура.ЭтоБазисноИндексныйУровеньСмета) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.КоэффОборуд.Видимость			= (Структура.ЭтоБазисноИндексныйУровеньСмета) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.КоэффПрочРаб.Видимость			= (Структура.ЭтоБазисноИндексныйУровеньСмета) И (НЕ Структура.ЭтоРасчетПоЭлементамЗатрат) И ЗначениеЗаполнено(Объект.МетодРасчета);
	
	Элементы.КоэффСтоимЭксплМашин.Видимость	= (Структура.ЭтоБазисноИндексныйУровеньСмета) И (Структура.ЭтоРасчетПоЭлементамЗатрат) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.КоэффСтоимМатериалов.Видимость = (Структура.ЭтоБазисноИндексныйУровеньСмета) И (Структура.ЭтоРасчетПоЭлементамЗатрат) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.КоэффПолнСтоимРабот.Видимость	= Ложь;
	Элементы.АвтозагрузкаИндексов.Видимость = (Структура.ЭтоБазисноИндексныйУровеньРасценка) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.ИзФайла.Видимость 				= (Структура.ЭтоБазисноИндексныйУровеньРасценка) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.ДатаВыпускаИндексов.Видимость 	= (Структура.ЭтоБазисноИндексныйУровеньРасценка) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.ОбновитьИндексы.Видимость 		= (Структура.ЭтоБазисноИндексныйУровеньРасценка) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.ПрименятьИндексыКоВсемБазам.Видимость 	= (Структура.ЭтоБазисноИндексныйУровеньРасценка) И ЗначениеЗаполнено(Объект.МетодРасчета);
	
	Элементы.АвтозагрузкаЦен.Видимость 		= ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.ФайлСборника.Видимость			= ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.ДатаТекущихЦен.Видимость 		= ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.БратьЦеныАналогов.Видимость 	= ЗначениеЗаполнено(Объект.МетодРасчета);
	
	Элементы.ДеревоЛСПодборПозицииИзСборникаТекущихЦен.Видимость = (ЗначениеЗаполнено(Объект.МетодРасчета)) И (ЗначениеЗаполнено(Объект.ФайлСборникаТекущихЦен));
	Элементы.ОбновитьИндексы.Доступность 	= Элементы.ДатаВыпускаИндексов.Доступность;
	Элементы.ОбновитьТекЦены.Доступность 	= Элементы.ДатаТекущихЦен.Доступность;
	
	Элементы.ДатаТекущихЦен.АвтоОтметкаНезаполненного = Структура.ЭтоРесурсныйМетод;
	
	Элементы.СтраницаИндексы.Видимость 				= Структура.ЭтоБазисноИндексныйУровеньРаздел;
	Элементы.СтраницаИндексы.Доступность 			= Структура.ЭтоБазисноИндексныйУровеньРаздел;
	Элементы.СтраницаМетодикаТСН.Видимость 			= Структура.МетодикаТСН;
	Элементы.СтраницаМетодикаТСН.Доступность 		= Структура.МетодикаТСН;
	Если Структура.МетодикаТСН И ПравоИзменение() Тогда 
		Объект.БазисныеЦены  = Ложь; 
	КонецЕсли;	
	Элементы.БазисныеЦены.Доступность 				= Не(Структура.МетодикаТСН);
//	Элементы.Группа1984.Видимость					= Структура.Методика1984;
//	Элементы.БезПримененияКоэффициентов.Видимость 	= Структура.ЭтоБазисноИндексныйУровеньРасценка И Структура.Методика1984 И Структура.РасчетНРиСПотПЗ;    
	Элементы.КорректируетСмету.Видимость 			= ЗначениеЗаполнено(Объект.КорректируетСмету);
	Элементы.ГруппаАвтозагрузка.Видимость			= НЕ Структура.Методика1984;
	
	Заголовок = СМ_СметаКлиент.ПолучитьТекстИнформацииОСмете(Объект, Структура, НСтр("ru='Локальная смета'"));
	
	Если (Объект.Статус = ПредопределенноеЗначение("Перечисление.СМ_СтатусыСметныхДокументов.Согласован")
		И СМ_СметаВызовСервера.ЗначениеОпции("СМ_ИспользоватьСтатусыДокументов")) или ТолькоПросмотрФормы Тогда
		Если Не ТолькоПросмотрФормы Тогда
			ПоказатьПредупреждениеНаФорме(НСтр("ru='Смета согласована, для изменения смените статус!'"));	
		КонецЕсли;
		// ДокторСофт
		Для каждого Элем Из ЭтаФорма.Элементы Цикл
			Если ТипЗнч(Элем) = Тип("ДекорацияФормы") ИЛИ ТипЗнч(Элем) = Тип("ДополнениеЭлементаФормы") ИЛИ Элем = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Найти(ВРЕГ(Элем.Имя),"ПЕЧАТ")>0 ИЛИ Элем.Имя = "ФормаЗакрыть" 
				ИЛИ Элем.Имя = "УбратьМобильное" ИЛИ Элем.Имя = "Мобильное"
				ИЛИ Элем.Имя = "ФормаПрисоединенныеФайлы" ИЛИ Элем.Имя = "ФормаЗаписать"
				ИЛИ Элем.Имя = "СкопироватьВБуфер" ИЛИ Элем.Имя = "ЗаписатьВерсию" ИЛИ Элем.Имя = "СоздатьВерсию"
				ИЛИ Элем.Имя = "ВставитьИзБуфера" ИЛИ Элем.Имя = "ДеревоЛСПривязатьОтвязатьПозицию" Тогда
				Продолжить;
			ИначеЕсли Элем.Имя = "ТаблицаВыполненияВвестиАкт" ИЛИ Элем.Имя = "ТаблицаВыполненияУдалитьАкт" Тогда
				Элем.Доступность = Ложь;
			КонецЕсли;
			Если ТипЗнч(Элем) = Тип("КнопкаФормы") Тогда
				Элем.Доступность = Ложь;
			Иначе
				Элем.ТолькоПросмотр = Истина;
			КонецЕсли;
		КонецЦикла;
		Элементы.ГруппаСтраницы.ТолькоПросмотр 			= Ложь;
		Элементы.СтраницаЛокальнаяСмета.ТолькоПросмотр 	= Ложь;
		Элементы.СтраницыЛокальнойСметы.ТолькоПросмотр 	= Ложь;
