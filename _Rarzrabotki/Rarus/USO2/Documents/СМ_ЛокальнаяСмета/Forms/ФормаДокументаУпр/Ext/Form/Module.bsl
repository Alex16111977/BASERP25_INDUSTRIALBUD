&НаСервереБезКонтекста
Функция ПолучитьСтруктуруЭлемента(Элемент)
	
	СтруктураЭлемента = Новый Структура;
	Для каждого реквизит Из элемент.Метаданные().Реквизиты Цикл
		СтруктураЭлемента.Вставить(реквизит.имя,Элемент[реквизит.имя]);
	КонецЦикла;	
	
	Для каждого реквизит Из Элемент.метаданные().ТабличныеЧасти Цикл
		Если реквизит.имя = "ПоправкиПозиции" Тогда
			нОтбор = Новый Структура;
			нОтбор.Вставить("Применить",истина);
			нСтроки = Элемент[реквизит.имя].найтиСтроки(нОтбор);
			СтруктураЭлемента.Вставить(реквизит.имя+"Количество",нСтроки.количество()); 
		Иначе	
			СтруктураЭлемента.Вставить(реквизит.имя+"Количество",Элемент[реквизит.имя].Количество());
		КонецЕсли;
	КонецЦикла;	
	
	// Добавляем правильный ПорНомер
	Номера = СМ_СметаВызовСервера.ПолучитьНомерДокумента(Элемент.Ссылка, "СМ_ПозицияЛокальнойСметы");
	ЗаполнитьЗначенияСвойств(СтруктураЭлемента, Номера); 	
	
	Возврат СтруктураЭлемента;
	
КонецФункции	

&НаСервере
Функция ПолучитьКолонки()
	
	ДеревоЗначений = РеквизитФормыВЗначение("ДеревоЛС", Тип("ДеревоЗначений"));

	Массив = Новый Массив;
	Для каждого колонка Из ДеревоЗначений.колонки Цикл

		Массив.Добавить(колонка.имя);
		
	КонецЦикла;	
	
	Возврат Массив;
	
КонецФункции	

&НаКлиенте
Функция ВернутьСтруктуруСтрокиДерева(СтрокаДерева)
	
	Колонки = ПолучитьКолонки();
	

	СтруктураСтроки = Новый Структура;
	Для каждого колонка Из колонки Цикл
		СтруктураСтроки.Вставить(колонка,СтрокаДерева[колонка]);
	КонецЦикла; 
	
	Возврат СтруктураСтроки;
	
КонецФункции	

// Процедура обрабатывает события после закрытия формы позиции или раздела.
//
// Параметры:
//   Результат 		- Произвольный - закрытый документ.
//   ФлагРасчета 	- Булево - значение расчета.
//
&НаКлиенте
Процедура ПриЗакрытииФормыДокумента(Результат, ФлагРасчета) Экспорт
	
	Если Результат = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаДерева = Элементы.ДеревоЛС.ТекущиеДанные;
	ОбъектДанных = СМ_СметаВызовСервера.НайтиЛС(СтрокаДерева.Элемент);
	
	СтрокаДерева.ИндексПересчет			= 1;
	СтрокаДерева.ИндексПривязана 		= 1;
	СтрокаДерева.ИндексНеИндексировать 	= 1;
	СтрокаДерева.ИндексПоправки			= 1;

	СтруктураЭлемента = ПолучитьСтруктуруЭлемента(СтрокаДерева.элемент);
	
	Если ТипЗнч(СтрокаДерева.Элемент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда 
		СтрокаДерева.Наименование = СтруктураЭлемента.Наименование;
		СтрокаДерева.Расчет 		= ""; 
	ИначеЕсли ТипЗнч(СтрокаДерева.Элемент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда 
		СтрокаДерева.Наименование 	= СтруктураЭлемента.НаименованиеДляПечати;
		СтрокаДерева.Расчет 		= СтруктураЭлемента.Расчет;
	ИначеЕсли ТипЗнч(СтрокаДерева.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда 
		СтрокаДерева.Наименование 	= СтруктураЭлемента.Наименование;
		СтрокаДерева.Расчет 		= СтруктураЭлемента.Расчет;
		СтрокаДерева.НомерПП 		= СтруктураЭлемента.ПорНомер;
		
		// Позиция привязана
		Если ЗначениеЗаполнено(СтруктураЭлемента.ИДПозицииВладельца) Тогда
			СтрокаДерева.ИндексПривязана = 0;
		КонецЕсли;
		
		// Не применять индексы
		Если СтруктураЭлемента.НеПрименятьИндексы Тогда
			СтрокаДерева.ИндексНеИндексировать = 0;	
		КонецЕсли;
		
		// Заданы коэффициенты пересчета
		Если СтруктураЭлемента.КоэффициентыПересчетаКоличество > 0 Тогда
			СтрокаДерева.ИндексПересчет = 0;
		КонецЕсли;
		
		// Поправки по тех. частям позиции
		Если СтруктураЭлемента.ПоправкиПозицииКоличество > 0 Тогда
			СтрокаДерева.ИндексПоправки	= 0;
		КонецЕсли;
		
	КонецЕсли;
	
	Смета 						= ОбъектДанных;
	СтруктураСтрокиДерева 		= ВернутьСтруктуруСтрокиДерева(СтрокаДерева);
	// СУДАРИКОВ - это все прийдет с обновлением дерева.
	СтрокаДерева.Наименование 	= СтруктураСтрокиДерева.Наименование;
	
	Если ТипЗнч(СтрокаДерева.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда 
		
		ОбновитьПеренумероватьДерево(Истина, СтрокаДерева.Элемент);   
		
	КонецЕсли;	
		
КонецПроцедуры	

&НаКлиенте
Процедура ДеревоЛСВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Архив Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийДокумент 		= Элементы.ДеревоЛС.ТекущиеДанные.Элемент;
	СтруктураОткрытия 		= Новый Структура("Ключ",ТекущийДокумент);
	ТекЭлем				= Элементы.ДеревоЛС.ТекущийЭлемент.Имя;
	
	Если ТекЭлем = "ДеревоЛСОбоснСметнойСтоим" И Элементы.ДеревоЛС.ТекущиеДанные.НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	Если Не ТекЭлем = "ДеревоЛСКол" И Не СтрНайти(ТекЭлем,"ДопРеквизит_")>0 Тогда

		СтандартнаяОбработка = Ложь;
		Если ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			
			СтатусРедактирования = Элементы.ДеревоЛС.ТекущиеДанные.СтатусРедактирования;
			СтатусРедактирования = ?(Не СМ_СметаВызовСервера.ЗначениеОпции("СМ_РазрешитьРедактированиеЗакрытыхСмет") И СтатусРедактирования = 1,2,СтатусРедактирования);
			
			СтруктураОткрытия.Вставить("ЕстьАкт",Элементы.ДеревоЛС.ТекущиеДанные.ОбъемВсего>0);
			СтруктураОткрытия.Вставить("ОбъемВсегоБезАкта",Элементы.ДеревоЛС.ТекущиеДанные.ОбъемВсего);
			СтруктураОткрытия.Вставить("РедактированиеЦен",РедактированиеЦен);
			СтруктураОткрытия.Вставить("СтатусРедактирования",СтатусРедактирования);
			ФормаДокумента = "Документ.СМ_ПозицияЛокальнойСметы.ФормаОбъекта";
		ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			ФормаДокумента = "Документ.СМ_РазделЛокальнойСметы.ФормаОбъекта";
		ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			ФормаДокумента = "Документ.СМ_ЛокальнаяСмета.ФормаОбъекта";
		Иначе
			Возврат;
		КонецЕсли;	
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПриЗакрытииФормыДокумента",ЭтаФорма,Элементы.ДеревоЛС.ТекущиеДанные.расчет);
		Если Элементы.ДеревоЛСПоказатьРядом.Пометка Тогда
			СтруктураОткрытия.Вставить("ПоказатьРядом",Истина);
			СтруктураОткрытия.Вставить("ЗакрыватьПриЗакрытииВладельца",Истина);
			ОткрытьФорму(ФормаДокумента,СтруктураОткрытия,ЭтаФорма,,,,ОповещениеОЗакрытии,РежимОткрытияОкнаФормы.Независимый);
		Иначе
			ОткрытьФорму(ФормаДокумента,СтруктураОткрытия,ЭтаФорма,,,,ОповещениеОЗакрытии,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьИндексовСостава(ТекДоступность)

	Элементы.КоэффициентОснЗарплаты.Доступность			= ТекДоступность;
