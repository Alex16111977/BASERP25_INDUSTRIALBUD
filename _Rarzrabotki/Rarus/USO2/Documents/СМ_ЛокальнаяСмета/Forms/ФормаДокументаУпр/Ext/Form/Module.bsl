&НаСервере
Функция ПозицияНеПодходит(Позиция)
	Если Не ТипЗнч(Позиция) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Позиция.ИДПозицииВладельца) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Позиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Работа Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ПодборПозицииИзСборникаТекущихЦен(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ФайлСборникаТекущихЦен) Тогда
		Возврат;	
	КонецЕсли;
	
	Если НЕ ПроверитьВозможностьДобавленияПозиции() Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.ДеревоЛС.ТекущаяСтрока;
	ТекущиеДанные = Элементы.ДеревоЛС.ТекущиеДанные;
	
	ЗапретитьВставку = ЗапретВставки();

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	Иначе
		Если ЗапретитьВставку И ПозицияНеПодходит(ТекущиеДанные.Элемент) Тогда
			Состояние(НСтр("ru='Необходимо выделить позицию-работу'"),100,"",БиблиотекаКартинок.Предупреждение32);
			Возврат;
		ИначеЕсли ТипЗнч(ТекущиеДанные.Элемент) <> Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") 
			И ТипЗнч(ТекущиеДанные.Элемент) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Состояние(НСтр("ru='Необходимо выделить раздел или позицию'"),100,"",БиблиотекаКартинок.Предупреждение32);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
		ИЛИ ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")Тогда
		ИдентификаторВерхнейСтроки = ПолучитьНомерВДереве(ТекущиеДанные.Элемент);
	Иначе
		ИдентификаторВерхнейСтроки = -1;
	КонецЕсли;

	СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(ОбщТекРаздел, ТекущиеДанные, Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы());
		
	ДокументЛС 							= Объект.Ссылка;
	Район 								= СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ДокументЛС, "Район");
	СтруктураПараметровФормыВыбораВНБ	= Неопределено;
	СтрокаДляВНБ 						= ТекущиеДанные.Элемент;
	ПоказыватьВводКоличества			= ПолучитьЗначениеНастройкиНаСервере("НастройкиПользователяСмета", "Оповещения_ДобавлениеПозицииСпрашиватьВводКоличества");
	ПоказыватьВводКоличества    		= ?(ПоказыватьВводКоличества = Неопределено,Ложь,ПоказыватьВводКоличества);
	ИдФормы 							= СметнаяКомпонента.ПоказатьОкноТекущихЦен(СокрЛП(Объект.ФайлСборникаТекущихЦен), Строка(СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Район,"Код")));
	ВариантВыбораВНБ 					= "ТекЦены"+ИдФормы;
	
КонецПроцедуры

