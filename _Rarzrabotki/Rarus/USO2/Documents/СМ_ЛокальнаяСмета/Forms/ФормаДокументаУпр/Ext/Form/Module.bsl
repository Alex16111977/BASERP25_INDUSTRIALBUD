&НаСервере
Функция ЗапретВставки()
	
	Возврат Константы.СМ_ЗапртетитьВставкуПозицийРесурсов.Получить();
	
КонецФункции	

&НаКлиенте
Процедура ДобавитьПозициюИзРесурсов(Команда)
	
	Если НЕ ПроверитьВозможностьДобавленияПозиции() Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ДеревоЛС.ТекущиеДанные;
	
	ЗапретитьВставку = ЗапретВставки();
	ПозицияВладелец = Неопределено;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	Иначе
		Если ЗапретитьВставку И ПозицияНеПодходит(ТекущиеДанные.Элемент) Тогда
			Состояние(НСтр("ru='Необходимо выделить позицию-работу'"),100,"",БиблиотекаКартинок.Предупреждение32);
			Возврат;
		ИначеЕсли ТипЗнч(ТекущиеДанные.Элемент) <> Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") 
			И ТипЗнч(ТекущиеДанные.Элемент) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Состояние(НСтр("ru='Необходимо выделить раздел или позицию'"),100,"",БиблиотекаКартинок.Предупреждение32);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗапретитьВставку Тогда
		ПозицияВладелец = ТекущиеДанные.Элемент;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
		ИЛИ ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")Тогда
		ИдентификаторВерхнейСтроки = ПолучитьНомерВДереве(ТекущиеДанные.Элемент);
	Иначе
		ИдентификаторВерхнейСтроки = -1;
	КонецЕсли;

	ОписаниеОЗакрытииФормыВыбораНС = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораРесурса",ЭтаФорма, Новый Структура("Родитель,ПозицияВладелец",Элементы.ДеревоЛС.ТекущиеДанные.Элемент,ПозицияВладелец));
	ПараметрыФормы = Новый Структура();// "Отбор", ПараметрыОтбор);
	ОткрытьФорму("Справочник.СМ_Ресурсы.Форма.ФормаВыбора",ПараметрыФормы,ЭтаФорма,,,,ОписаниеОЗакрытииФормыВыбораНС,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыВыбораРесурса(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ДеревоЛС.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	Иначе
		
		Если ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			ТекРаздел = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ТекущиеДанные.Элемент, "ИДРодителя");
		Иначе
			ТекРаздел = ТекущиеДанные.Элемент;
		КонецЕсли;
		
		СтруктураПараметровФормыВыбораВНБ = Неопределено;
		НадоОБновлять = Истина;
		
		Результат = СМ_СметаКлиент.ПолучитьОдинРесурсИлиМассив(Результат);
		
		Если ТипЗнч(Результат) = Тип("СправочникСсылка.СМ_Ресурсы") Тогда
			
			СсылкаНаРесурс				= Результат;
			ЗаголовокПодбора			= ОпределитьЗаголовок(СсылкаНаРесурс);
			ПараметрыОповещения			= Новый Структура("СсылкаЭлемент, ТекРаздел, ПозицияВладелец", СсылкаНаРесурс, ТекРаздел, Параметры.ПозицияВладелец);
			ПоказыватьВводКоличества	= ПолучитьЗначениеНастройкиНаСервере("НастройкиПользователяСмета", "Оповещения_ДобавлениеПозицииСпрашиватьВводКоличества");
			ПоказыватьВводКоличества    = ?(ПоказыватьВводКоличества = Неопределено,Ложь,ПоказыватьВводКоличества);
			Если ПоказыватьВводКоличества Тогда
				Оповещение = Новый ОписаниеОповещения("ПослеВводаКоличества", ЭтотОбъект, ПараметрыОповещения);
				ПоказатьВводЧисла(Оповещение, 0, ЗаголовокПодбора, 15, 5);
			Иначе
				ПослеВводаКоличества(0, ПараметрыОповещения);	
			КонецЕсли;
			
		Иначе
			
			ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеВыбораПозицииСправочник",ЭтаФорма,Новый Структура("ТекРаздел, ПозицияВладелец",ТекРаздел, Параметры.ПозицияВладелец));
			СтруктураПараметров = Новый Структура("ТаблицаВыбораНС",Результат);
			ОткрытьФорму("Документ.СМ_ЛокальнаяСмета.Форма.ФормаВыбораПозиций",СтруктураПараметров,ЭтаФорма,,,,ОповещениеОЗакрытии,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗаполнитьМассивВыделенныхСтрок()//МассивРазделов, МассивСмет)
	
	// Соберем выделенные позиции в массивы.
	СтруктураВыделенныхСтрок = Новый Структура();
	
	СтруктураВыделенныхСтрок.Вставить("МассивСмет", Новый Массив);
	СтруктураВыделенныхСтрок.Вставить("МассивРазделов", Новый Массив);
	СтруктураВыделенныхСтрок.Вставить("МассивПозиций", Новый Массив);
	
	Для Каждого ИдентификаторСтроки Из Элементы.ДеревоЛС.ВыделенныеСтроки Цикл
		ТекСтрока = ДеревоЛС.НайтиПоИдентификатору(ИдентификаторСтроки);
		ТекДокумент = СМ_СметаВызовСервера.ПолучитьСсылкуСтрокиДереваСмет(ТекСтрока);
		Если ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			ИндексЭлемента = СтруктураВыделенныхСтрок.МассивСмет.Найти(ТекДокумент);
			Если ИндексЭлемента = Неопределено Тогда
				СтруктураВыделенныхСтрок.МассивСмет.Добавить(ТекДокумент);
			КонецЕсли;
		ИначеЕсли ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда 
			ИндексЭлемента = СтруктураВыделенныхСтрок.МассивРазделов.Найти(ТекДокумент);
			Если ИндексЭлемента = Неопределено Тогда
				СтруктураВыделенныхСтрок.МассивРазделов.Добавить(ТекДокумент);
			КонецЕсли;
		ИначеЕсли ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			ИндексЭлемента = СтруктураВыделенныхСтрок.МассивПозиций.Найти(ТекДокумент);
			Если ИндексЭлемента = Неопределено Тогда
				СтруктураВыделенныхСтрок.МассивПозиций.Добавить(ТекДокумент);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;   
	
	Возврат СтруктураВыделенныхСтрок;
		
КонецФункции

&НаКлиенте
Процедура ТехЧастьИндексы(Команда)
	Если СметнаяКомпонента = Неопределено Тогда
		ПоказатьПредупреждение(,НСтр("ru='Сметная компонента не подключена'"));
	Иначе
		Попытка
			СметнаяКомпонента.ОткрытьТехЧасть(Объект.КодРегионаФайлаИндексовПересчета,Формат(Объект.ДатаВыпускаИндексов,"ДФ=yyMMdd"),"KF");
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТехЧастьЦены(Команда)
	Если СметнаяКомпонента = Неопределено Тогда
		ПоказатьПредупреждение(,НСтр("ru='Сметная компонента не подключена'"));
	Иначе
		Попытка
			СметнаяКомпонента.ОткрытьТехЧасть(Объект.КодРегионаФайлаТекущихЦен,Формат(Объект.ДатаТекущихЦен,"ДФ=yyMMdd"),"TC");
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗаявкиНаМатериалыДиалог(Результат, СтруктураПараметров) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	Записать();
	Если ЗначениеЗаполнено(Объект.Ссылка)и не ЭтаФорма.Модифицированность Тогда
		ОткрытьФормуЗаявкиНаМатериалы();
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Документ не записан, заявка не может быть оформлена."));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗаявкиНаМатериалы()
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Объект", Объект.Ссылка);
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ПараметрыЗаполнения);
	ФормаНовогоДокумента = ПолучитьФорму("Документ.СМ_ЗаявкаНаМатериал.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма);
 	ФормаНовогоДокумента.Открыть();
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаПозиций(Команда)
	ФоновоеЗадание = Ложь;
	ВыполнитьФоновоеЗаданиеНаСервере(АдресХранилища, ФоновоеЗадание);
	Если ФоновоеЗадание Тогда
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеНаКлиенте", 1, Истина);
		ПараметрыОбработчика.МаксимальныйИнтервал = 5;
		ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтотОбъект, ИдентификаторЗадания);
	Иначе
		СтруктураХранилища = ПолучитьИзВременногоХранилища(АдресХранилища);
		ТабДок = СтруктураХранилища.ТабДок;
		Если Не ТабДок = Неопределено Тогда
			ТабДок.Защита = Истина;
			ТабДок.ОтображатьЗаголовки = Ложь;
			ТабДок.ОтображатьСетку = Ложь;
			ТабДок.АвтоМасштаб = Истина;
			ТабДок.Показать("Контроль полноты заполнения реквизитов позиции.");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВыполнитьФоновоеЗаданиеНаСервере(АдресХранилища,ФоновоеЗадание = Ложь)
	
	СтруктураПараметров = Новый Структура;    
	СтруктураПараметров.Вставить("Смета", Объект.Ссылка);

	РезультатФоновогоЗадания = ДлительныеОперации.ЗапуститьВыполнениеВФоне(УникальныйИдентификатор, 
	"Документы.СМ_ЛокальнаяСмета.ПроверкаПозиций", 
	СтруктураПараметров, 
	НСтр("ru = 'Контроль полноты заполнения реквизитов позиции.'"));
	
	Если РезультатФоновогоЗадания.ЗаданиеВыполнено Тогда
		АдресХранилища = РезультатФоновогоЗадания.АдресХранилища;
	Иначе
		ФоновоеЗадание = Истина;
		ИдентификаторЗадания  = РезультатФоновогоЗадания.ИдентификаторЗадания;
		АдресХранилища = РезультатФоновогоЗадания.АдресХранилища;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФоновоеЗаданиеНаКлиенте()
	Результат = ФоновоеЗаданиеПолучитьРезультат();
	Если Результат.ФоновоеЗаданиеВыполнено Тогда
		Если ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = ИдентификаторЗадания Тогда
			ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		КонецЕсли;
		СтруктураХранилища = ПолучитьИзВременногоХранилища(АдресХранилища);
		ТабДок = СтруктураХранилища.ТабДок;
		Если Не ТабДок = Неопределено Тогда
			ТабДок.Защита = Истина;
			ТабДок.ОтображатьЗаголовки = Ложь;
			ТабДок.ОтображатьСетку = Ложь;
			ТабДок.АвтоМасштаб = Истина;
			ТабДок.Показать("Контроль полноты заполнения реквизитов позиции.");
		КонецЕсли;
	Иначе
		ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеНаКлиенте", ПараметрыОбработчика.ТекущийИнтервал, Истина);
		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ФоновоеЗаданиеПолучитьРезультат()
	Результат = Новый Структура;
	Результат.Вставить("ФоновоеЗаданиеВыполнено", Ложь);
	Результат.ФоновоеЗаданиеВыполнено = ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ВыгрузкаВMSP(Команда)

	Если Не Объект.Ссылка.Пустая() Тогда
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Смета",Объект.Ссылка);
		ОткрытьФорму("Обработка.СМ_MSP_НастройкаСинхронизации.Форма.ФормаВыгрузки",СтруктураПараметров);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Для выгрузки документ необходимо записать'"));
	КонецЕсли;
	
КонецПроцедуры

