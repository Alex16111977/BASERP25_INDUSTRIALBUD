#Область ПриЗакрытииФормы

// Процедура осуществляет действия после закрытия формы справочника Раздела.
// ПАРАМЕТРЫ:
//// Результат - массив элементов справочника, форма которого закрыта.
//// Параметры - дополнительные параметры переданные при формировании вопроса пользователю.
&НаКлиенте
Процедура ПриЗакрытииФормыДокументаРаздел(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Сч = 0 По Результат.Количество() - 1 Цикл
		СсылкаНаРаздел = Результат.Получить(Сч) ;
		// Создание нового документа "Раздел ЛС".
		НовыйРаздел = СоздатьРаздел(СсылкаНаРаздел, Параметры);
		Если НовыйРаздел <> Неопределено Тогда
			ОбновитьПеренумероватьДерево(Истина, НовыйРаздел);
		КонецЕсли;
	КонецЦикла;
	
	
КонецПроцедуры

// Создание нового документа "Раздел ЛС".
// ПАРАМЕТРЫ:
//// СсылкаНаРаздел - Ссылка на элемент справочника "СМ_РазделыЛокальнойСметы.
//// Параметры - дополнительные параметры переданные при формировании вопроса пользователю.
&НаСервере
Функция СоздатьРаздел(СсылкаНаРаздел,Параметры)
	// Проверка на соответствие шаблону.
	Если ЗначениеЗаполнено(Объект.ШаблонРазделовСметы) Тогда
		Если Не СМ_СметаШаблоныВызовСервера.РазделСоответствуетШаблону(Объект.Ссылка, СсылкаНаРаздел, Параметры.Родитель) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не удалось создать раздел сметы. Раздел не соответствует шаблону сметы.'"));
		Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	НовДокументРаздел				= СМ_СметаВызовСервера.СоздатьНовыйРаздел();
	НовДокументРаздел.Дата			= ТекущаяДатаСеанса();
	НовДокументРаздел.Раздел 		= СсылкаНаРаздел; 
	НовДокументРаздел.НаименованиеДляПечати	= СсылкаНаРаздел.наименование; 
	НовДокументРаздел.Расчет 		= Истина; 
	Если ТипЗнч(Параметры.Родитель) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		НовДокументРаздел.ИДСметы    = Параметры.Родитель;
		НовДокументРаздел.ИДРодителя = Параметры.Родитель;
	ИначеЕсли ТипЗнч(Параметры.Родитель) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
		НовДокументРаздел.ИДСметы    = Параметры.Родитель.ИДСметы;
		НовДокументРаздел.ИДРодителя = Параметры.Родитель;
	Иначе Возврат Неопределено;
	КонецЕсли;
	НовДокументРаздел.Записать();
	Возврат НовДокументРаздел.Ссылка;
КонецФункции

// Процедура осуществляет действия после закрытия формы документа Позиции.
