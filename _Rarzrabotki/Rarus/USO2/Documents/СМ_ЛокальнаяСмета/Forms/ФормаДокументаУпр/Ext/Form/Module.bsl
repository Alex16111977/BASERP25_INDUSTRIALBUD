			ОткрытьФорму("Обработка.СМ_ДеревоСметПростое.Форма",Новый Структура("ЗначениеЗаполнения,ВключатьРазделы,ИсключитьРаздел",Новый Структура("ЭлементКорня",Объект.Ссылка),Истина,СсылкаНаОбъект),ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца)
		Иначе
			ОткрытьФорму("Обработка.СМ_ДеревоСметПростое.Форма",Новый Структура("ЗначениеЗаполнения,ВключатьРазделы",Новый Структура("ЭлементКорня",Объект.Ссылка),Истина),ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца)
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере    
Процедура ОсуществитьПеремещение(Документ, ПеремещаемыйДокумент = Неопределено, ПервыйЭлементГруппы = Неопределено, ПоследнийЭлементГруппы = Неопределено, Направление = 0);
	
	НомераДокумента = СМ_СметаВызовСервера.ПолучитьНомерДокумента(Документ);
	
