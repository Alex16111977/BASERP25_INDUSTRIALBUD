		Элементы.ГруппаШапка.ТолькоПросмотр 		= Ложь;
		Элементы.ГруппаШапкаВерх.ТолькоПросмотр 	= Ложь;
		Элементы.ГруппаШапкаПраво.ТолькоПросмотр 	= Ложь;
	КонецЕсли;
	
	РазделятьПозиции = ПолучитьЗначениеНастройкиНаСервере("НастройкиПользователяСмета","РазделятьПозицииЗакрытыеАктами");
	РазделятьПозиции = ?(РазделятьПозиции = Неопределено,Ложь,РазделятьПозиции);

	Элементы.СоздатьВерсию.Видимость = РазделятьПозиции;
	Элементы.ДеревоЛСПоказатьРядом.Доступность = Истина;
	
	ВидимостьСМ_КЗ_РСНБ();
	ВидимостьНР1_ВС();
	Элементы.ФормаПоказатьРасчеты.Доступность = Истина;
	
	// Ранжирование ресурсов
	Если Объект.МетодикаРасчета = ПредопределенноеЗначение("Справочник.СМ_МетодикиРасчета.СМ_МетодикаМДС2017") Тогда
		Элементы.СтраницаРанжирование.Видимость 		= Истина;
		Элементы.ДеревоЛСРанжированиеРесурсов.Видимость = Истина;
	Иначе
		Элементы.СтраницаРанжирование.Видимость 		= Ложь;
		Элементы.ДеревоЛСРанжированиеРесурсов.Видимость = Ложь;
	КонецЕсли;

	// *********************************************
	// ++ AVV Роли в системе
	// УстановитьДоступностьПоРолям();
	// -- AVV Роли в системе
	// *********************************************		
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьСМ_КЗ_РСНБ()
	
	Если Объект.МетодикаРасчета = ПредопределенноеЗначение("Справочник.СМ_МетодикиРасчета.СМ_КЗ_РСНБ") Тогда
		Элементы.ГруппаРСНБКазахстана.Видимость = Истина;
		Элементы.МетодРасчета.ТолькоПросмотр 	= Истина; 
	Иначе
		Элементы.ГруппаРСНБКазахстана.Видимость = Ложь;
		Элементы.МетодРасчета.ТолькоПросмотр 	= Ложь;
	КонецЕсли;
	
	ОбновитьПодменюПечати();
	
КонецПроцедуры

&НаСервере
Функция ВидимостьОбъемыВсего()
	Возврат ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ПоказыватьВсегоНачало",Ложь); 	
КонецФункции

&НаКлиенте
Процедура ВидимостьКнопокТехчасть()
	
	Если СметнаяКомпонента <> Неопределено Тогда
		Элементы.КнопкаТехЧастьИндексы.Видимость 	= Объект.АвтозагрузкаИндексов И ЗначениеЗаполнено(Объект.ФайлСборникаКоэффициентовПредставление);
		Элементы.КнопкаТехЧастьЦены.Видимость 		= Объект.АвтозагрузкаЦен И ЗначениеЗаполнено(Объект.ФайлСборникаТекущихЦенПредставление);
	Иначе
		Элементы.КнопкаТехЧастьИндексы.Видимость	= Ложь;
		Элементы.КнопкаТехЧастьЦены.Видимость       = Ложь;
	КонецЕсли;
	
КонецПроцедуры
// ДокторСофт

&НаСервере
Функция ПолучитьДанныеСметы(СметаРодитель)
	Возврат Новый Структура("НомерСметы,Наименование",СметаРодитель.НомерСметы,СметаРодитель.Наименование);
КонецФункции

&НаКлиенте
Процедура ДоступностьПодчиненных(СМ_ПодчиненныеЭлементы,ДоступностьЭлемента)
	Для каждого ПодчЭлем Из СМ_ПодчиненныеЭлементы Цикл
		ПодчЭлем.Доступность = ДоступностьЭлемента;
		Если ТипЗнч(ПодчЭлем) = Тип("ГруппаФормы") ИЛИ ТипЗнч(ПодчЭлем) = Тип("СтраницаФормы") Тогда
			ДоступностьПодчиненных(ПодчЭлем.ПодчиненныеЭлементы,ДоступностьЭлемента);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПросмотрПодчиненных(СМ_ПодчиненныеЭлементы,Просмотр)
	Для каждого ПодчЭлем Из СМ_ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ПодчЭлем) <> Тип("КнопкаФормы") Тогда
			ПодчЭлем.ТолькоПросмотр = Просмотр;
		КонецЕсли;
		Если ТипЗнч(ПодчЭлем) = Тип("ГруппаФормы") ИЛИ ТипЗнч(ПодчЭлем) = Тип("СтраницаФормы") Тогда
			ПросмотрПодчиненных(ПодчЭлем.ПодчиненныеЭлементы,Просмотр);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
// ДокторСофт

// Выполняется при создании формы.
// Выполняется обновление дерева на вкладке состав.
// Заполняется таблица актов выполненных работю.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	СтруктураПараметровКОбновлению = Новый Структура;
	СтруктураПараметровКОбновлению.Вставить("ПромежуточноеОкругление",Объект.ПромежуточноеОкругление);
	СтруктураПараметровКОбновлению.Вставить("ОкруглятьДоРублей",Объект.ОкруглятьДоРублей);
	СтруктураПараметровКОбновлению.Вставить("ОбрабатыватьПогрешность",Объект.ОбрабатыватьПогрешность);

	// Заблокировать подчиненные разделы и позиции локальной сметы
	Если Параметры.Свойство("Стройка") Тогда
		Если Параметры.Стройка.ЭтоГруппа Тогда
			Объект.Стройка = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнаяСтройка");
		Иначе
			Объект.Стройка = Параметры.Стройка;
		КонецЕсли;
		СМ_СметаВызовСервера.ЗаполнитьНаименованиеНомерИзШаблона(Объект, Элементы.Наименование);
	КонецЕсли;

	Если Параметры.Свойство("ШаблонСмет") Тогда
		Объект.ШаблонСметы = Параметры.ШаблонСмет;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Автор = Пользователи.ТекущийПользователь();
		СМ_СметаВызовСервера.ЗаполнитьНастройкиПользователяПоУмолчанию(Объект);
		СМ_СметаВызовСервера.ЗаполнитьСметуПоШаблону(Объект);
		// Заполнение методики расчета в новых сметах
		МетодикаМДС35		= ПолучитьФункциональнуюОпцию("СМ_МетодикаМДС35");
		МетодикаТСН 		= ПолучитьФункциональнуюОпцию("СМ_МетодикаТСНГородаМосква");
		Методика1984года 	= ПолучитьФункциональнуюОпцию("СМ_Методика84Года");
		Если МетодикаМДС35 И НЕ МетодикаТСН И НЕ Методика1984года Тогда
			Объект.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаМДС35;	
		ИначеЕсли МетодикаТСН И НЕ МетодикаМДС35 И НЕ Методика1984года Тогда
			Объект.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква;	
		ИначеЕсли Методика1984года И НЕ	МетодикаМДС35 И НЕ МетодикаТСН Тогда
			Объект.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_Методика84года;	
		КонецЕсли;
		ЗаполнитьРанжирование();
	Иначе
		СуществуютАкты = СМ_УчетВыполненныхРаботСервер.СуществуютАктыПоСмете(Объект.Ссылка);
	КонецЕсли;
	
	Элементы.ДеревоЛС.ФиксацияСлева = 7;
	ВыводитьДопРеквизиты = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","СМ_ВыводитьДополнительныеРеквизитыДерево");
	ВыводитьДопРеквизиты = ?(ВыводитьДопРеквизиты = Неопределено,Ложь,ВыводитьДопРеквизиты);
	Если ВыводитьДопРеквизиты Тогда
		СписокРеквизитов = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","СМ_СписокДопРеквизитовДерева");
		Если СписокРеквизитов.Количество() > 0 Тогда
			ДобавляемыеРеквизиты = Новый Массив;
			
			Для Каждого доп Из СписокРеквизитов Цикл
				GUID = СМ_ВерсионированиеСервер.ПолучитьGUIDПоУИД(доп.Значение.УникальныйИдентификатор());
				НовРеквизит = Новый РеквизитФормы("ДопРеквизит_"+GUID,доп.Значение.ТипЗначения,"ДеревоЛС", доп.Значение.Заголовок);
				ДобавляемыеРеквизиты.Добавить(НовРеквизит);
			КонецЦикла;
			ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
			
			Для Каждого доп Из СписокРеквизитов Цикл
				
				GUID = СМ_ВерсионированиеСервер.ПолучитьGUIDПоУИД(доп.Значение.УникальныйИдентификатор());
				НовыйЭлемент = Элементы.Добавить("ДопРеквизит_"+GUID, Тип("ПолеФормы"), Элементы.ДеревоЛСГруппаДопРеквизиты);
				НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
				НовыйЭлемент.ПутьКДанным = "ДеревоЛС.ДопРеквизит_"+GUID;
				НовыйЭлемент.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
				НовыйЭлемент.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
				НовыйЭлемент.УстановитьДействие("ПриИзменении", "ВыполнитьДействиеПриИзмененииДопРеквизита");
				НовыйЭлемент.УстановитьДействие("НачалоВыбора", "ВыполнитьДействиеНачалоВыбораДопРеквизита");
			КонецЦикла;
			Элементы.ДеревоЛС.ФиксацияСлева = 8;
		КонецЕсли;
	КонецЕсли;

	//	"На остаток"
	Если Параметры.Свойство("НаОстаток") И Параметры.НаОстаток Тогда
		Дерево = РеквизитФормыВЗначение("ДеревоЛС");
		СМ_СметныйСоставВызовСервера.ЗаполнитьСметуПоОстаткам(Дерево,Параметры.СтараяСмета,Объект);
		ЗначениеВДанныеФормы(Дерево,ДеревоЛС); 
	КонецЕсли;    
	
	ВводОбъемовВБазовыхЕдИзм = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ВводОбъемовВБазовыхЕдИзм");
	
	ОбновитьДерево();
	ЗаполнитьВыполнение();
	ОбновитьПодменюПечати();
	Элементы.ГруппаСтраницы.ТекущаяСтраница = ?(Объект.Ссылка.Пустая(), Элементы.ГруппаСтраницы.ПодчиненныеЭлементы.СтраницаЛокальнаяСмета, Элементы.ГруппаСтраницы.ПодчиненныеЭлементы.СтраницаСостав);
	
	ТолькоПросмотрФормы = СМ_СметаВызовСервера.РольТолькоПросмотр();
	РедактированиеЦен = (Объект.Статус = Перечисления.СМ_СтатусыСметныхДокументов.РедактированиеЦен И СМ_СметаВызовСервера.ЗначениеОпции("СМ_ИспользоватьСтатусыДокументов"));
	Архив = (Объект.Статус = Перечисления.СМ_СтатусыСметныхДокументов.Архив);
	Админ = Пользователи.РолиДоступны("СМ_АдминистраторСмета, ПолныеПрава",,Ложь);
	ТолькоПросмотрФормы = ?(Архив,Архив,ТолькоПросмотрФормы);
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Валюта = Справочники.Валюты.НайтиПоКоду("643");
	КонецЕсли;
	
	Если Параметры.Свойство("ЛимЗатрата") Тогда
		Стр = Объект.ЛимитированныеЗатраты.Выгрузить().Найти(Параметры.ЛимЗатрата,"ЛимитированнаяЗатрата");
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаЛокальнаяСмета;
		Элементы.СтраницаЛокальнаяСмета.ПодчиненныеЭлементы.СтраницыЛокальнойСметы.ТекущаяСтраница = Элементы.СтраницаЛимитированныеЗатраты;
		Элементы.ЛимитированныеЗатраты.ТекущаяСтрока = Стр.НомерСтроки-1;
	КонецЕсли;
	
	Элементы.ТекстКоэффициентов.Заголовок = "";
	
	СтатусВыгрузкиВMSP=СМ_MSP_ВызовСервера.СтатусВыгрузкиСметы(Объект.Ссылка);
	Если СтатусВыгрузкиВMSP="" Тогда 
		Элементы.СтатусВыгрузкиВMSP.Видимость=Ложь;
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Свойства") Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "СтраницаДополнительныеРеквизиты");
		ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Ложь);
		МодульУправлениеСвойствами = ОбщегоНазначения.ОбщийМодуль("УправлениеСвойствами");
		МодульУправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	КонецЕсли;
	
	ДоступнаКомандаMSP = Ложь;
	
	Если Не СМ_СметаВызовСервера.ЗначениеОпции("СМ_ИспользоватьСтатусыДокументов") Тогда
		ДоступнаКомандаMSP = Истина;
	Иначе
		СтруктураПараметров = СМ_MSP_ВызовСервера.ПрочитатьНастройкиОбменаMSP();
		Если СтруктураПараметров.Свойство("ДополнительныеДанные") Тогда
			Допы = СтруктураПараметров.ДополнительныеДанные.Получить();
			Если Допы.Свойство("РазрешенныеСтатусы") Тогда
				Если  Допы.РазрешенныеСтатусы.НайтиСтроки(Новый Структура("Статус",Объект.Статус)).Количество()>0 Тогда
					ДоступнаКомандаMSP = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
	ИспользоватьЛимЗатратыВсегда = СМ_СметаВызовСервера.ЗначениеОпции("СМ_ИспользоватьЛимитированныеЗатратыПодчиненныхСмет");
	
	ПараметрыИзменены = Ложь;
	ОбработатьТЧПараметры();
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// *********************************************
	// ++ AVV Роли в системе
	// ЭтоСметчикПрайсы = Ложь;
	//Если РольДоступна("СМ_СметчикПрайсы") Тогда
	//	ЭтоСметчикПрайсы = Истина;	
	//КонецЕсли;
	// -- AVV Роли в системе
	// *********************************************
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеНачалоВыбораДопРеквизита(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекДанные 	= Элементы.ДеревоЛС.ТекущиеДанные;
	GUID = СтрЗаменить(Элемент.Имя,"ДопРеквизит_","");
    ВладелецСвойства = ПолучитьСвойство(GUID);
	Если ТипЗнч(ТекДанные[Элемент.Имя]) = Тип("СправочникСсылка.ЗначенияСвойствОбъектов") Тогда
		СтандартнаяОбработка = Ложь;
		СтрОтбор = Новый Структура("Владелец",ВладелецСвойства);
		ОткрытьФорму("Справочник.ЗначенияСвойствОбъектов.Форма.ФормаСписка",Новый Структура("Отбор,РежимВыбора",СтрОтбор,Истина),Элемент)
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьСвойство(GUID) 
    УИН = СМ_ВерсионированиеСервер.ПолучитьУИДПоGUID(GUID);
	Возврат ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПолучитьСсылку(Новый УникальныйИдентификатор(УИН));
КонецФункции

&НаКлиенте
Процедура ВыполнитьДействиеПриИзмененииДопРеквизита(Элемент)
	ТекДанные 	= Элементы.ДеревоЛС.ТекущиеДанные;
	Если ТекДанные.НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	ТекДокумент = ТекДанные.Элемент;
	GUID = СтрЗаменить(Элемент.Имя,"ДопРеквизит_","");
	ЗначениеРеквизита = ТекДанные[Элемент.Имя];
    ВыполнитьДействиеПриИзмененииДопРеквизитаНаСервере(ТекДокумент,GUID,ЗначениеРеквизита);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьДействиеПриИзмененииДопРеквизитаНаСервере(ТекДокумент,GUID,ЗначениеРеквизита)
    УИН = СМ_ВерсионированиеСервер.ПолучитьУИДПоGUID(GUID);
	ДопРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПолучитьСсылку(Новый УникальныйИдентификатор(УИН));
	УстановитьДополнительныйРеквизитОбъекта(ТекДокумент, ДопРеквизит,ЗначениеРеквизита);
КонецПроцедуры

&НаСервере
Процедура УстановитьДополнительныйРеквизитОбъекта(ДокументСсылка, ПВХ_Ссылка, ЗначениеРеквизита)
     ТекДокумент = ДокументСсылка.ПолучитьОбъект();
     СтрДопРеквизиты = ТекДокумент.ДополнительныеРеквизиты.Найти(ПВХ_Ссылка, "Свойство");
     Если СтрДопРеквизиты = Неопределено Тогда
         СтрДопРеквизиты = ТекДокумент.ДополнительныеРеквизиты.Добавить();
     КонецЕсли;
     СтрДопРеквизиты.Свойство = ПВХ_Ссылка;
     СтрДопРеквизиты.Значение = ЗначениеРеквизита;
     ТекДокумент.ОбменДанными.Загрузка = Истина;
	 ТекДокумент.Записать()
 КонецПроцедуры
 
