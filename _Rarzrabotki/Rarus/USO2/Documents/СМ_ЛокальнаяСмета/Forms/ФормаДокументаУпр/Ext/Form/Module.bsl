&НаКлиенте
Процедура ДобавитьПозицию(Команда)
	
	Если НЕ ПроверитьВозможностьДобавленияПозиции() Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтрока = Элементы.ДеревоЛС.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	Иначе
		Если ТипЗнч(ТекСтрока.Элемент) <> Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") 
			И ТипЗнч(ТекСтрока.Элемент) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Состояние(НСтр("ru='Необходимо выделить раздел или позицию'"),100,"",БиблиотекаКартинок.Предупреждение32);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ТекСтрока.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		Родитель = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ТекСтрока.Элемент, "ИДРодителя");
	Иначе
		Родитель = ТекСтрока.Элемент;
	КонецЕсли;  		
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПриЗакрытииФормыОбъектаПозиции",ЭтаФорма, Новый Структура("Родитель",Родитель));
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ЛокальнаяСмета",Объект.Ссылка);
	СтруктураПараметров.Вставить("Родитель",Родитель);
	СтруктураПараметров.Вставить("ТипНормативныхСборников",ПредопределенноеЗначение("Перечисление.СМ_ТипыНормативныхСборников.Калькуляция"));
	СтруктураПараметров.Вставить("СпособСоздания",ПредопределенноеЗначение("Перечисление.СМ_ИсточникиДобавленияПозиций.Вручную"));
	
	Форма 		= ОткрытьФорму("Документ.СМ_ПозицияЛокальнойСметы.ФормаОбъекта",СтруктураПараметров,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ДанныеФормы = Форма.Объект;
	ЗаполнитьПозициюЛокальнойСметы(Родитель, ДанныеФормы);
	КопироватьДанныеФормы(ДанныеФормы, Форма.Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРаздел(Команда)
	
	Если НЕ ПроверитьВозможностьДобавленияПозиции() Тогда
		Возврат;
	КонецЕсли;
	
	ТекПозиция = Элементы.ДеревоЛС.ТекущиеДанные;	
	
	Если ТекПозиция = Неопределено Тогда
		ПоказатьПредупреждение(,НСтр("ru='Укажите куда добавляем раздел'"),,НСтр("ru='Внимание'"));
		Возврат;
	КонецЕсли;
	
	СоздатьНовыйРаздел(ТекПозиция);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПозицииИзВНБ(Команда)
	
	Если ЗначениеЗаполнено(ИдФормы) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ПроверитьВозможностьДобавленияПозиции() Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.ДеревоЛС.ТекущаяСтрока;
	ТекущиеДанные = Элементы.ДеревоЛС.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	Иначе
		Если ТипЗнч(ТекущиеДанные.Элемент) <> Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") 
			И ТипЗнч(ТекущиеДанные.Элемент) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Состояние(НСтр("ru='Необходимо выделить раздел или позицию'"),100,"",БиблиотекаКартинок.Предупреждение32);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
		ИЛИ ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")Тогда
		ИдентификаторВерхнейСтроки = ПолучитьНомерВДереве(ТекущиеДанные.Элемент);
	Иначе
		ИдентификаторВерхнейСтроки = -1;
	КонецЕсли;

	СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(ОбщТекРаздел, ТекущиеДанные, Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы());
		
	ДокументЛС							= Объект.Ссылка;
	Район								= СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ДокументЛС, "Район");
	СтруктураПараметровФормыВыбораВНБ	= Неопределено;
	СтрокаДляВНБ						= ТекущиеДанные.Элемент;

	ПоказыватьВводКоличества			= ПолучитьЗначениеНастройкиНаСервере("НастройкиПользователяСмета", "Оповещения_ДобавлениеПозицииСпрашиватьВводКоличества");
	ПоказыватьВводКоличества    = ?(ПоказыватьВводКоличества = Неопределено,Ложь,ПоказыватьВводКоличества);		
	ИдФормы								= СметнаяКомпонента.ПоказатьОкноНорм(Строка(СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Район,"Код")), "", "", "", Ложь, ПоказыватьВводКоличества);
	ВариантВыбораВНБ 					= "ВНБ"+ИдФормы;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборИзФрагментов(Команда)
	Если НЕ ПроверитьВозможностьДобавленияПозиции() Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ДеревоЛС.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	Иначе
		Если ТипЗнч(ТекущиеДанные.Элемент) <> Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") 
			И ТипЗнч(ТекущиеДанные.Элемент) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Состояние(НСтр("ru='Необходимо выделить раздел или позицию'"),100,"",БиблиотекаКартинок.Предупреждение32);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
		ИЛИ ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")Тогда
		ИдентификаторВерхнейСтроки = ПолучитьНомерВДереве(ТекущиеДанные.Элемент);
	Иначе
		ИдентификаторВерхнейСтроки = -1;
	КонецЕсли;

	Структура = Новый Структура();
	Структура.Вставить("ТекущиеДанные",ТекущиеДанные.Элемент);
	Структура.Вставить("СНБ");
	Структура.Вставить("Фрагмент");
	Структура.Вставить("ОбъемФрагмента");

	Оповещение = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораФрагмента", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.СМ_ВыборСНБиФрагмента",Структура,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

