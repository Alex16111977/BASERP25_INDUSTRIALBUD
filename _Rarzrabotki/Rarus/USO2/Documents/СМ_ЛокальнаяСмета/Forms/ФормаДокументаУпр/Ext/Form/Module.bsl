		НомераПервыйЭлементГруппы = СМ_СметаВызовСервера.ПолучитьНомерДокумента(ПервыйЭлементГруппы);
		НомераПоследнийЭлементГруппы = СМ_СметаВызовСервера.ПолучитьНомерДокумента(ПоследнийЭлементГруппы);
		
		НомерВДеревеПервого = НомераПервыйЭлементГруппы.НомерВДереве;
		НомерВДеревеПоследнего = НомераПоследнийЭлементГруппы.НомерВДереве;
		Если Направление > 0 Тогда
			Если НомерВДеревеПервого > НомерВДеревеПоследнего Тогда
				НомерВДеревеПоследнего = НомерВДеревеПервого;
			КонецЕсли;
			ТребуемыйНомер = НомерВДеревеПоследнего;
		Иначе
		    Если НомерВДеревеПервого > НомерВДеревеПоследнего Тогда
				НомерВДеревеПервого = НомерВДеревеПоследнего;
			КонецЕсли;
			ТребуемыйНомер = НомерВДеревеПервого;
		КонецЕсли;
		
		//ИзменяемыйОбъект = Документ.ПолучитьОбъект();
		//ИзменяемыйОбъект.НомерВДереве = НомераДокумента.НомерВДереве + ТребуемыйНомер - НомераДокумента.НомерВДереве + Направление;
		//ИзменяемыйОбъект.Записать();
		
		СМ_СметаВызовСервера.УстановитьНомерДокумента(Документ, , , НомераДокумента.НомерВДереве + ТребуемыйНомер - НомераДокумента.НомерВДереве + Направление); 
			
	Иначе
		
		НомераПеремещаемогоДокумента = СМ_СметаВызовСервера.ПолучитьНомерДокумента(ПеремещаемыйДокумент);
		
		НомерВДеревеПеремещаемогоДокумента = НомераПеремещаемогоДокумента.НомерВДереве;
		ПорНомерПеремещаемогоДокумента = НомераПеремещаемогоДокумента.ПорНомер;
		
		//ПеремещаемыйОбъект = ПеремещаемыйДокумент.ПолучитьОбъект();
		//ПеремещаемыйОбъект.ПорНомер = Документ.ПорНомер;
		//ПеремещаемыйОбъект.НомерВДереве = Документ.НомерВДереве;
		//ПеремещаемыйОбъект.Записать();
		//
		//ИзменяемыйОбъект = Документ.ПолучитьОбъект();
		//ИзменяемыйОбъект.ПорНомер = ПорНомерПеремещаемогоДокумента;
		//ИзменяемыйОбъект.НомерВДереве = НомерВДеревеПеремещаемогоДокумента;
		//ИзменяемыйОбъект.Записать();
		
		СМ_СметаВызовСервера.УстановитьНомерДокумента(ПеремещаемыйДокумент, НомераДокумента.ПорНомер, , НомераДокумента.НомерВДереве); 
		СМ_СметаВызовСервера.УстановитьНомерДокумента(Документ, ПорНомерПеремещаемогоДокумента, , НомерВДеревеПеремещаемогоДокумента); 
			
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
