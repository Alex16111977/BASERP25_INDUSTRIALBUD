&НаСервере
Процедура ОбновитьИндексыПоСметеСервер(ДанныеИнд)
	СМ_СметаВызовСервера.ЗагрузитьИндексыВПозиции(Объект.Ссылка, ДанныеИнд, Объект.ВариантПересчетаЭММ, Истина, Ложь);
	ЛокСмета = РеквизитФормыВЗначение("Объект");
	Документы.СМ_ЛокальнаяСмета.Перерасчет(ЛокСмета, Ложь);
	ЗначениеВДанныеФормы(ЛокСмета, Объект);
	ОбновитьДерево();
КонецПроцедуры

// Осуществляет обновление индексов после диалога пользователя.
//
// Параметры:
//   Результат - Произвольный - ответ пользователя на вопрос (продолжать или нет).
//   СтруктураПараметров - Структура - дополнительные параметры переданные при формировании вопроса пользователю.
//
&НаКлиенте
Процедура ОбновитьИндексыПоСмете(Результат, СтруктураПараметров) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	Записать();
	Если (Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Расценка")) Тогда
		Если Объект.АвтозагрузкаИндексов И ЗначениеЗаполнено(Объект.ФайлСборникаКоэффициентов) Тогда
			СтруктураДанных = Новый Структура("СборникКоэффициентов", Объект.ФайлСборникаКоэффициентов);
			Если Объект.ПрименятьИндексыКоВсемБазам Тогда
				СтруктураДанных.Вставить("КодРегиональнойБазы", Объект.КодРегионаФайлаИндексовПересчета);
			КонецЕсли;
			ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОбИндексахПересчета(Объект.Ссылка, , СтруктураДанных);
			ТекущиеДанные = Элементы.ДеревоЛС.ТекущиеДанные;
			СтрокаДерева = Неопределено;
			СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(СтрокаДерева, ТекущиеДанные, Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы());
			ОбновитьИндексыПоСметеСервер(ДанныеИнд);
			СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы(), ДеревоЛС, СтрокаДерева);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура АвтозагрузкаЦенПриИзменении(Элемент)
	ВидимостьКнопокТехчасть();
	ДоступностьВыбораФайлаЦен();
	Если Объект.АвтозагрузкаЦен И ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьТекущиеЦеныПоСмете", ЭтаФорма, Новый Структура);
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru='Обновить все цены на ресурсы по смете (смета будет записана)?'"), РежимДиалогаВопрос.ДаНет,0,,НСтр("ru='Внимание'"));	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТекущиеЦеныПоСметеСервер(ДанныеИнд)
	СМ_СметаВызовСервера.ЗагрузитьТекущиеЦеныВПозиции(Объект.Ссылка, ДанныеИнд, Истина, Ложь,,Истина,,Объект.Ссылка.БратьЦеныАналогов);
	ЛокСмета = РеквизитФормыВЗначение("Объект");
	Документы.СМ_ЛокальнаяСмета.Перерасчет(ЛокСмета, Ложь);
	ЗначениеВДанныеФормы(ЛокСмета, Объект);
	ОбновитьДерево();
КонецПроцедуры

&НаСервере
Процедура ОбновитьТекущиеЦеныПоСметеПоРегиструСервер()
	СМ_СметаВызовСервера.ЗагрузитьТекущиеЦеныВПозицииИзРегистра(Объект.Ссылка, Истина, Ложь,,Истина,Объект.Ссылка.БратьЦеныАналогов);
	ЛокСмета = РеквизитФормыВЗначение("Объект");
	Документы.СМ_ЛокальнаяСмета.Перерасчет(ЛокСмета, Ложь);
	ЗначениеВДанныеФормы(ЛокСмета, Объект);
	ОбновитьДерево();
КонецПроцедуры

// Процедура осуществляет обновление текущих цен после диалога пользователя.
//
// Параметры:
// 	Результат 			- ответ пользователя на вопрос (продолжать или нет).
// 	СтруктураПараметров - дополнительные параметры переданные при формировании вопроса пользователю.
//
&НаКлиенте
Процедура ОбновитьТекущиеЦеныПоСмете(Результат, СтруктураПараметров) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	Записать();
	Если Объект.АвтозагрузкаЦен Тогда
		Если ЗначениеЗаполнено(Объект.ФайлСборникаТекущихЦен) Тогда
			// обновляем индексы
			СтруктураДанных = Новый Структура("СборникТекущихЦен, КодРегиональнойБазы", Объект.ФайлСборникаТекущихЦен, Объект.КодРегионаФайлаТекущихЦен);
			ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОТекущихЦенах(Объект.Ссылка, , СтруктураДанных);
			ТекущиеДанные = Элементы.ДеревоЛС.ТекущиеДанные;
			СтрокаДерева = Неопределено;
			СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(СтрокаДерева, ТекущиеДанные, Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы());
			ОбновитьТекущиеЦеныПоСметеСервер(ДанныеИнд);
			СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы(), ДеревоЛС, СтрокаДерева);
		Иначе
			ТекущиеДанные = Элементы.ДеревоЛС.ТекущиеДанные;
			СтрокаДерева = Неопределено;
			СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(СтрокаДерева, ТекущиеДанные, Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы());
			ОбновитьТекущиеЦеныПоСметеПоРегиструСервер();
			СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.ДеревоЛС, ДеревоЛС.ПолучитьЭлементы(), ДеревоЛС, СтрокаДерева);
		КонецЕсли;
	КонецЕсли;					
КонецПроцедуры

