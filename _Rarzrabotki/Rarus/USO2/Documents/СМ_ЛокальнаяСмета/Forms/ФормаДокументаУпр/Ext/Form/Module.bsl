&НаКлиенте
Процедура РасставитьПривязанныеПозиции(СтрокаДерева)
	
	Для каждого ПодСтрока Из СтрокаДерева Цикл
		
		Если ЗначениеЗаполнено(ПодСтрока.Элемент) Тогда
			Если ТипЗнч(ПодСтрока.Элемент) = тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				МассивПривязанных = ПолучитьПривязанные(ПодСтрока.Элемент);
				Если МассивПривязанных.количество() > 0 Тогда
					ТекущийИндекс   = СтрокаДерева.индекс(ПодСтрока);
					сч = 1;
					Для каждого прив Из МассивПривязанных Цикл
						ПозицияПрив = СМ_СметныйСоставКлиент.ПроверитьСтрокуДерева(ПодСтрока.получитьРодителя().ПолучитьЭлементы(),прив,"Индекс");
						
						Если ПозицияПрив > ТекущийИндекс Тогда
							сдвиг =  -1 * (ПозицияПрив-ТекущийИндекс-сч);
						Иначе
							сдвиг = ТекущийИндекс - ПозицияПрив;
						КонецЕсли;
						
						СтрокаДерева.сдвинуть(ПозицияПрив,сдвиг);
						сч = сч + 1;
						
					КонецЦикла;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
		РасставитьПривязанныеПозиции(ПодСтрока.ПолучитьЭлементы());
	КонецЦикла;
	
	
КонецПроцедуры	

// Процедура обновляет дерево состава сметы и выполняет действия (при необходимости)
// обработка идет в общем модуле СМ_СметныйСостав.
// ПАРАМЕТРЫ:
//// Перенумеровать - нужна ли полная перенумерация подчиненных документов.
&НаСервере
Процедура ОбновитьДерево(Перенумеровать = Ложь, ТекущийЭлемент = Неопределено, НомерПересчета = 0)
	
	ДеревоЗначений = РеквизитФормыВЗначение("ДеревоЛС", Тип("ДеревоЗначений"));
	Если Перенумеровать Тогда
		СМ_СметныйСоставВызовСервера.ПеренумероватьОбновитьДерево(Объект.Ссылка, ДеревоЗначений, ТекущийЭлемент,НомерПересчета);
	Иначе
		СМ_СметныйСоставВызовСервера.ВывестиОбновитьДерево(Объект.Ссылка, ДеревоЗначений, , , ТекущийЭлемент);
	КонецЕсли;
	ЗначениеВРеквизитФормы(ДеревоЗначений,"ДеревоЛС");
	
	ЗаполнитьТаблицуИндексовРаздела();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВыполнение()
	
	ВидИтогаВсегоСНДС = Справочники.СМ_ИтогиПоГлавам.НайтиПоРеквизиту("Идентификатор","ИП4");
	Если ВидИтогаВсегоСНДС = Справочники.СМ_ИтогиПоГлавам.ПустаяСсылка() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не найден итог: Всего с НДС в справочнике итоги по главам!'"));
	КонецЕсли;
	
	ТаблицаВыполнения.Параметры.УстановитьЗначениеПараметра("ВидИтога",ВидИтогаВсегоСНДС);
	ТаблицаВыполнения.Параметры.УстановитьЗначениеПараметра("ЛокальнаяСмета",Объект.Ссылка);

КонецПроцедуры

