	Иначе
		ОткрытьФормуЗаявкиНаМатериалы();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПозициюИзExcel(Команда)
	
	Если НЕ ПроверитьВозможностьДобавленияПозиции() Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтрока = Элементы.ДеревоЛС.ТекущиеДанные;
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	Иначе
		Если ТипЗнч(ТекСтрока.Элемент) <> Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") И
			 ТипЗнч(ТекСтрока.Элемент) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Состояние(НСтр("ru='Необходимо выделить раздел или позицию'"),100,"",БиблиотекаКартинок.Предупреждение32);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ТекСтрока.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		Родитель = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ТекСтрока.Элемент, "ИДРодителя");
	Иначе
		Родитель = ТекСтрока.Элемент;
	КонецЕсли;  		
	
	ТекущаяСтрокаДерева = Элементы.ДеревоЛС.ТекущаяСтрока;
	//ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПриЗакрытииФормыВставкиПозиции",ЭтаФорма,ТекущаяСтрокаДерева);
	
	СтруктураОповещения = Новый Структура;
	СтруктураОповещения.Вставить("ТекущаяСтрокаДерева",ТекущаяСтрокаДерева);
	СтруктураОповещения.Вставить("СохраненнаяСтрока",ТекСтрока.Элемент);
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПриЗакрытииФормыВставкиПозиции",ЭтаФорма,СтруктураОповещения);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ЛокальнаяСмета",Объект.Ссылка);
	СтруктураПараметров.Вставить("Родитель",Родитель);
	ОткрытьФорму("Документ.СМ_ЛокальнаяСмета.Форма.ФормаДобавленияПозиций",СтруктураПараметров,ЭтаФорма,,,,ОповещениеОЗакрытии,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	
КонецПроцедуры

