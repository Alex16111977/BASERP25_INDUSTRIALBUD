		Иначе
			Оповещение = Новый ОписаниеОповещения("ФормаНачальногоЗаполненияПараметровАкта", ЭтотОбъект,);
			ОткрытьФорму("ОбщаяФорма.СМ_ФормаНачальногоЗаполненияПараметровАкта",,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
