&НаСервере
Функция ПолучитьКартинку(ОтмеченаВДереве)
	ДеревоЗначений = РеквизитФормыВЗначение("ДеревоЛС", Тип("ДеревоЗначений"));
	СМ_СметныйСоставВызовСервера.ФильтрДерева(Объект.Ссылка, ДеревоЗначений,ОтмеченаВДереве);
	ЗначениеВРеквизитФормы(ДеревоЗначений,"ДеревоЛС");

	Если ОтмеченаВДереве = 0 Тогда
		Возврат БиблиотекаКартинок.СМ_ЦветаЧерный;
	ИначеЕсли ОтмеченаВДереве = 1 Тогда
		Возврат БиблиотекаКартинок.СМ_ЦветаБелый;	
	ИначеЕсли ОтмеченаВДереве = 2 Тогда
		Возврат БиблиотекаКартинок.СМ_ЦветаСиний;	
	ИначеЕсли ОтмеченаВДереве = 3 Тогда
		Возврат БиблиотекаКартинок.СМ_ЦветаЖелтый;	
	ИначеЕсли ОтмеченаВДереве = 4 Тогда
		Возврат БиблиотекаКартинок.СМ_ЦветаЗеленый;	
	ИначеЕсли ОтмеченаВДереве = 5 Тогда
		Возврат БиблиотекаКартинок.СМ_ЦветаКрасный;	
	ИначеЕсли ОтмеченаВДереве = 6 Тогда
		Возврат БиблиотекаКартинок.СМ_ЦветаФиолетовый;	
	КонецЕсли;
КонецФункции

