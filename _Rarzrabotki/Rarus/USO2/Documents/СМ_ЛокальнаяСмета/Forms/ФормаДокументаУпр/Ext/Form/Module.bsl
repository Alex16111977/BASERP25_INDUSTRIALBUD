&НаСервере
Функция ПолучитьКоэффициенты(ТекДок)
	
	СтруктураКоэф = Новый Структура;
	Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		Если ТекДок.КоэффициентыПересчета.Количество()=1 Тогда
			СтруктураКоэф.Вставить("КоэффОснЗарплаты",ТекДок.КоэффициентыПересчета[0].КоэффОснЗарплаты);
			СтруктураКоэф.Вставить("КоэффСтоимЭксплМашин",ТекДок.КоэффициентыПересчета[0].КоэффСтоимЭксплМашин);
			СтруктураКоэф.Вставить("КоэффСтоимЗарплатеМашин",ТекДок.КоэффициентыПересчета[0].КоэффСтоимЗарплатеМашин);
			СтруктураКоэф.Вставить("КоэффСтоимМатериалов",ТекДок.КоэффициентыПересчета[0].КоэффСтоимМатериалов);
			СтруктураКоэф.Вставить("КоэффОборуд",ТекДок.КоэффициентыПересчета[0].КоэффОборуд);
			СтруктураКоэф.Вставить("КоэффПолнСтоимРабот",ТекДок.КоэффициентыПересчета[0].КоэффПолнСтоимРабот);
		ИначеЕсли ТекДок.КоэффициентыПересчета.Количество()>1 Тогда
			КоэффОснЗарплаты = 1;
			КоэффСтоимЭксплМашин = 1;
			КоэффСтоимЗарплатеМашин = 1;
			КоэффСтоимМатериалов = 1;
			КоэффОборуд = 1;
			КоэффПолнСтоимРабот = 1;
			Для Каждого СтрКоэф Из ТекДок.КоэффициентыПересчета Цикл
				КоэффОснЗарплаты = КоэффОснЗарплаты * ?(СтрКоэф.КоэффОснЗарплаты=0,1,СтрКоэф.КоэффОснЗарплаты);
				КоэффСтоимЭксплМашин = КоэффСтоимЭксплМашин * ?(СтрКоэф.КоэффСтоимЭксплМашин=0,1,СтрКоэф.КоэффСтоимЭксплМашин);
				КоэффСтоимЗарплатеМашин = КоэффСтоимЗарплатеМашин * ?(СтрКоэф.КоэффСтоимЗарплатеМашин=0,1,СтрКоэф.КоэффСтоимЗарплатеМашин);
				КоэффСтоимМатериалов = КоэффСтоимМатериалов * ?(СтрКоэф.КоэффСтоимМатериалов=0,1,СтрКоэф.КоэффСтоимМатериалов);
				КоэффОборуд = КоэффОборуд * ?(СтрКоэф.КоэффОборуд=0,1,СтрКоэф.КоэффОборуд);
				КоэффПолнСтоимРабот = КоэффПолнСтоимРабот * ?(СтрКоэф.КоэффПолнСтоимРабот=0,1,СтрКоэф.КоэффПолнСтоимРабот);
			КонецЦикла;
			СтруктураКоэф.Вставить("КоэффОснЗарплаты",КоэффОснЗарплаты);
			СтруктураКоэф.Вставить("КоэффСтоимЭксплМашин",КоэффСтоимЭксплМашин);
			СтруктураКоэф.Вставить("КоэффСтоимЗарплатеМашин",КоэффСтоимЗарплатеМашин);
			СтруктураКоэф.Вставить("КоэффСтоимМатериалов",КоэффСтоимМатериалов);
			СтруктураКоэф.Вставить("КоэффОборуд",КоэффОборуд);
			СтруктураКоэф.Вставить("КоэффПолнСтоимРабот",КоэффПолнСтоимРабот);
		Иначе
			СтруктураКоэф.Вставить("КоэффОснЗарплаты",0);
			СтруктураКоэф.Вставить("КоэффСтоимЭксплМашин",0);
			СтруктураКоэф.Вставить("КоэффСтоимЗарплатеМашин",0);
			СтруктураКоэф.Вставить("КоэффСтоимМатериалов",0);
			СтруктураКоэф.Вставить("КоэффОборуд",0);
			СтруктураКоэф.Вставить("КоэффПолнСтоимРабот",0);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
		СтруктураКоэф.Вставить("КоэффОснЗарплаты",ТекДок.КоэффОснЗарплаты);
		СтруктураКоэф.Вставить("КоэффСтоимЭксплМашин",ТекДок.КоэффСтоимЭксплМашин);
		СтруктураКоэф.Вставить("КоэффСтоимЗарплатеМашин",ТекДок.КоэффСтоимЗарплатеМашин);
		СтруктураКоэф.Вставить("КоэффСтоимМатериалов",ТекДок.КоэффСтоимМатериалов);
		СтруктураКоэф.Вставить("КоэффОборуд",ТекДок.КоэффОборуд);
		СтруктураКоэф.Вставить("КоэффПолнСтоимРабот",ТекДок.КоэффПолнСтоимРабот);
	Иначе
		СтруктураКоэф.Вставить("КоэффОснЗарплаты",0);
		СтруктураКоэф.Вставить("КоэффСтоимЭксплМашин",ТекДок.КоэффСтоимЭксплМашин);
		СтруктураКоэф.Вставить("КоэффСтоимЗарплатеМашин",0);
		СтруктураКоэф.Вставить("КоэффСтоимМатериалов",ТекДок.КоэффСтоимМатериалов);
		СтруктураКоэф.Вставить("КоэффОборуд",ТекДок.КоэффОборуд);
		СтруктураКоэф.Вставить("КоэффПолнСтоимРабот",ТекДок.КоэффПолнСтоимРабот);
	КонецЕсли;
	Возврат СтруктураКоэф;
	
КонецФункции	

&НаСервере
Функция ПолучитьРодителяЭлемента(ТекДок)

	Возврат ТекДок.ИдРодителя;
	
КонецФункции	

&НаКлиенте
Процедура ДеревоЛСПриАктивизацииСтроки(Элемент)
	
	Если Не ЭтаФорма.открыта() Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ДеревоЛС.ТекущиеДанные = Неопределено Тогда
		Элементы.ТекстИтога.Заголовок = "";
		Элементы.ТекстКоэффициентов.Видимость = Элементы.ПоказатьИндексы.Пометка;
		Возврат;
	КонецЕсли;
	
	ТекДок = Элементы.ДеревоЛС.ТекущиеДанные.Элемент;
	Если ТекЭлемент <> ТекДок Тогда
		ТекЭлемент = ТекДок;
	КонецЕсли;
	
	ПоказатьДанныеДокумента(ТекДок);
	
	Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		ДоступностьУдалить = Истина;
		Для Каждого ИдентификаторСтроки Из Элементы.ДеревоЛС.ВыделенныеСтроки Цикл
			ВыбраннаяСтрока = ДеревоЛС.НайтиПоИдентификатору(ИдентификаторСтроки);
			Если Не ТипЗнч(ВыбраннаяСтрока.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")
				И СуществуютАкты Тогда
				ДоступностьУдалить = Ложь;
				Прервать;
			КонецЕсли;
			
			Если ВыбраннаяСтрока.СтатусРедактирования >0 Тогда
				ДоступностьУдалить = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Элементы.ДеревоЛС.ТекущиеДанные.ОбъемВсего = 0 И ДоступностьУдалить Тогда
			Элементы.ДеревоЛСУдалитьЭлемент.Доступность = Истина;
		Иначе
			Элементы.ДеревоЛСУдалитьЭлемент.Доступность = Ложь;
		КонецЕсли;
	Иначе
		Элементы.ДеревоЛСУдалитьЭлемент.Доступность = Не СуществуютАкты;
	КонецЕсли;

	СтруктураВыделенныхСтрок = ЗаполнитьМассивВыделенныхСтрок();
	
	ТекстИтога = СМ_СметныйСоставВызовСервера.ВывестиСтрокуИтога(Объект.Ссылка, СтруктураВыделенныхСтрок);
	
	ПеремещаемыеСтроки = Новый Массив;
	МассивРодителей = Новый Массив;
	Для Каждого ИдентификаторСтроки Из Элементы.ДеревоЛС.ВыделенныеСтроки Цикл
		ВыделеннаяСтрока = ДеревоЛС.НайтиПоИдентификатору(ИдентификаторСтроки);
		Родитель = ВыделеннаяСтрока.ПолучитьРодителя();
		Если МассивРодителей.Найти(Родитель) = Неопределено Тогда
			МассивРодителей.Добавить(Родитель);
		КонецЕсли;
	КонецЦикла;
	
	ДоступностьКнопок = МассивРодителей.Количество() = 1;
	
	Элементы.ДеревоЛСПереместитьВверх.Доступность = ДоступностьКнопок;
	Элементы.ДеревоЛСПереместитьВниз.Доступность = ДоступностьКнопок;
	
	СтруктураРасчета = Новый Структура();
	СтруктураРасчета.Вставить("ЭтоБазисноИндексныйУровеньРасценка", (Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Расценка")));
	СтруктураРасчета.Вставить("ЭтоБазисноИндексныйУровеньРаздел", (Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Раздел")));
	СтруктураРасчета.Вставить("ЭтоБазисноИндексныйУровеньСмета", (Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Смета")));

	//Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
	//	Элементы.ТекстИтога.Заголовок = НСтр("ru='Итог по позиции:'")+" " + Формат(Элементы.ДеревоЛС.ТекущиеДанные.ОбщВсего,"ЧДЦ=2");
	//ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
	//	Элементы.ТекстИтога.Заголовок = НСтр("ru='Итог по разделу:'")+" " + Формат(Элементы.ДеревоЛС.ТекущиеДанные.ОбщВсего,"ЧДЦ=2");
	//ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
	//	Элементы.ТекстИтога.Заголовок = НСтр("ru='Итог по смете:'")+" " + Формат(Элементы.ДеревоЛС.ТекущиеДанные.ОбщВсего,"ЧДЦ=2");
	//КонецЕсли;
	
	Если СтруктураРасчета.ЭтоБазисноИндексныйУровеньРасценка Тогда
		
		Элементы.ТекстКоэффициентов.Заголовок = "";
		УстановитьДоступностьИндексовСостава(Истина);
		
		// Индексы доступны для редактирования 
		Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			ПоказатьКоэффициентыПоПозиции(ТекДок);
		ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			Элементы.ТекстКоэффициентов.Заголовок = НСтр("ru='Введенные коэффициенты будут занесены во все позиции раздела'");
			ПоказатьКоэффициентыПоРазделу(ТекДок);
		ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			Элементы.ТекстКоэффициентов.Заголовок = НСтр("ru='Введенные коэффициенты будут занесены во все позиции сметы'");
			ПоказатьКоэффициентыПоСмете();	
		КонецЕсли;
		
	ИначеЕсли СтруктураРасчета.ЭтоБазисноИндексныйУровеньРаздел Тогда
		
		УстановитьДоступностьИндексовСостава(Истина);
		
		// Индексы недоступны для редактирования. 
		// Отображаются значения равные значениям вышестоящего раздела.
		Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			
			УстановитьДоступностьИндексовСостава(Ложь);
			ТекРодитель = ПолучитьРодителяЭлемента(ТекДок);
			
			Если ЗначениеЗаполнено(ТекРодитель) Тогда
				Если ТипЗнч(ТекРодитель) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда				
					ПоказатьКоэффициентыПоРазделу(ТекРодитель);
				Иначе
					ПоказатьКоэффициентыПоРазделу();
				КонецЕсли;
			Иначе
				ПоказатьКоэффициентыПоРазделу();
			КонецЕсли;
			
		Иначе
			ПоказатьКоэффициентыПоРазделу(ТекДок);	
		КонецЕсли;
		
	ИначеЕсли СтруктураРасчета.ЭтоБазисноИндексныйУровеньСмета Тогда
		
		// Индексы недоступны для редактирования.
		// Индексы отображаются информативно (они едины для всех элементов дерева).
		ПоказатьКоэффициентыПоСмете();
		
	КонецЕсли;

	Если НеАктивизировать Тогда
		НеАктивизировать = Ложь;
		Возврат;
	КонецЕсли;

	Если Элементы.ДеревоЛСПоказатьРядом.Пометка Тогда

		Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")
			ИЛИ ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")Тогда
			
			СтруктураОткрытия 		= Новый Структура("Ключ",ТекДок);
			СтруктураОткрытия.Вставить("ПоказатьРядом",Истина);
			СтруктураОткрытия.Вставить("ЗакрыватьПриЗакрытииВладельца",Истина);
			
			Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				ФормаДокумента = "Документ.СМ_ПозицияЛокальнойСметы.ФормаОбъекта";
				
				СтатусРедактирования = Элементы.ДеревоЛС.ТекущиеДанные.СтатусРедактирования;
				СтатусРедактирования = ?(Не СМ_СметаВызовСервера.ЗначениеОпции("СМ_РазрешитьРедактированиеЗакрытыхСмет") И СтатусРедактирования = 1,2,СтатусРедактирования);

				СтруктураОткрытия.Вставить("ЕстьАкт",Элементы.ДеревоЛС.ТекущиеДанные.ОбъемВсего>0);
				СтруктураОткрытия.Вставить("РедактированиеЦен",РедактированиеЦен);
				СтруктураОткрытия.Вставить("СтатусРедактирования",СтатусРедактирования);
				СтрокаПоиска = "СМ_ПозицияЛокальнойСметы";
			Иначе
				ФормаДокумента = "Документ.СМ_РазделЛокальнойСметы.ФормаОбъекта";
				СтрокаПоиска = "СМ_РазделЛокальнойСметы";
			КонецЕсли;
			
			ОткрытыеОкна = ПолучитьОкна();
			Для Каждого ТекОкно Из ОткрытыеОкна Цикл
				Если ТекОкно.Основное ИЛИ ТекОкно.НачальнаяСтраница Тогда
					Продолжить;
				КонецЕсли;
				ФормаОкна = ТекОкно.Содержимое[0];
				Если ФормаОкна.ВладелецФормы = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если ФормаОкна.ВладелецФормы = ЭтаФорма Тогда
					ОповеститьОбАктивизации(ТекДок);
				КонецЕсли;
			КонецЦикла;			
			ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПриЗакрытииФормыДокумента",ЭтаФорма,Истина);
			ОткрытьФорму(ФормаДокумента,СтруктураОткрытия,ЭтаФорма,,,,ОповещениеОЗакрытии,РежимОткрытияОкнаФормы.Независимый);
		КонецЕсли;
	КонецЕсли;
	
	Если КомпонентаРенга <> Неопределено Тогда
		СписокКонструктивов = ПолучитьКонструктивы(ТекДок);
		Если ЗначениеЗаполнено(СписокКонструктивов) Тогда
			КомпонентаРенга.SelectModelObjects(СписокКонструктивов);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоЛСКолПриИзменении(Элемент)
	 
	ТекДанные = Элементы.ДеревоЛС.ТекущиеДанные;
	Если ТекДанные.НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	ТекДокумент = ТекДанные.Элемент;
	НовыйОбъем 	= ТекДанные.Кол;	
	
	Если СтрНайти(НовыйОбъем,"=") > 0 Тогда
		НовыйОбъем 		= СтрЗаменить(НовыйОбъем,",",".");
		ФормулаИзменена = Ложь;
		ТекФормула 		= СокрЛП(Сред(НовыйОбъем,2));
		Если ЗначениеЗаполнено(ТекФормула) Тогда
			
			// Поиск и подстановка параметров в формулу из ЛС
			МассивПараметров = СМ_СметаКлиентСервер.ПолучитьСписокПараметровФормулы(ТекФормула);
			Если МассивПараметров.Количество() > 0 Тогда
				//СтруктураПараметров = СМ_СметаКлиентСервер.ЗаполнитьЗначенияПараметров(МассивПараметров,Объект.Ссылка);
				СтруктураПараметров = ЗаполнитьЗначенияПараметров(МассивПараметров);
				ТекФормула 			= СМ_СметаКлиентСервер.ПодставитьПараметрыВФормулу(ТекФормула,СтруктураПараметров);
			КонецЕсли;

			Попытка
				Формула = "ТекОбъем = " + ТекФормула+"; НовыйОбъем = ТекОбъем;";
				Выполнить(Формула);
				// Эрикос.zbikt 23.06.2014
				ФормулаИзменена = Истина;
				ТекФормула 		= СМ_СметаВызовСервера.ПересчитатьФормулаВбазовыхЕдиницахИзмерения(ТекДокумент,ТекФормула);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Ошибка в формуле, объем не изменен'"));
			КонецПопытки;
			
			Если ФормулаИзменена Тогда
				Если Число(НовыйОбъем) < ТекДанные.ОбъемВсего И ТекДанные.ОбъемВсего > 0 Тогда
					СтарыйОбъем 	= СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ТекДокумент, "ОбъемРабот");
					ТекДанные.Кол 	= СтарыйОбъем;
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Введенный объем работ меньше выполненного!'"));
					Возврат;
				КонецЕсли;
				СтарыйОбъем 	= СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ТекДокумент, "ОбъемРабот");
				ТекДанные.Кол	= НовыйОбъем;
				ИзменитьОбъемПозицииЛС(ТекДокумент,НовыйОбъем, ВводОбъемовВБазовыхЕдИзм,ТекФормула);
			КонецЕсли;

			Если ФормулаИзменена И СМ_СметаВызовСервера.ЕстьПривязанныеПозиции(ТекДокумент) Тогда
				ДопПараметры = Новый Структура;
				ДопПараметры.Вставить("Позиция",ТекДокумент);
				ДопПараметры.Вставить("НовыйОбъем",НовыйОбъем);
				ДопПараметры.Вставить("СтарыйОбъем",СтарыйОбъем);
				
				Режим = РежимДиалогаВопрос.ДаНет;
				Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбъем", ЭтаФорма, ДопПараметры);
				ПоказатьВопрос(Оповещение, НСтр("ru = 'Изменять пропорционально объем привязанных позиций?';"
				+ " en = 'Do you want to continue?'"), Режим, 0);
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		СтарыйОбъем = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ТекДокумент, "ОбъемРабот");
		Попытка
			ПроверкаЧисла = Число(НовыйОбъем);
		Исключение
			ТекДанные.Кол = СтарыйОбъем;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Введены некорректные данные!'"));
			Возврат;
		КонецПопытки;
		
		Если Число(НовыйОбъем) < ТекДанные.ОбъемВсего И ТекДанные.ОбъемВсего > 0 Тогда
			ТекДанные.Кол = СтарыйОбъем;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Введенный объем работ меньше выполненного!'"));
			Возврат;
		КонецЕсли;

		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Позиция",ТекДокумент); 		
		СтарыйОбъем = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ТекДокумент, "ОбъемРабот");
		ИзменитьОбъемПозицииЛС(ТекДокумент,НовыйОбъем, ВводОбъемовВБазовыхЕдИзм);
		
		Если СМ_СметаВызовСервера.ЕстьПривязанныеПозиции(ТекДокумент) Тогда
			ДопПараметры.Вставить("НовыйОбъем",НовыйОбъем);
			ДопПараметры.Вставить("СтарыйОбъем",СтарыйОбъем);
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбъем", ЭтаФорма, ДопПараметры);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Изменять пропорционально объем привязанных позиций?';"
			+ " en = 'Do you want to continue?'"), Режим, 0);
		Иначе
			ПослеЗакрытияВопросаОбъем(КодВозвратаДиалога.Нет, ДопПараметры);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьЗначенияПараметров(МассивПараметров)
	
	СтруктураПараметров = СМ_СметаКлиентСервер.ЗаполнитьЗначенияПараметров(МассивПараметров,Объект.Ссылка);
	Возврат СтруктураПараметров;
	
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбъем(Результат, ДопПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Нет Тогда
		ВыполнитьПересчетПривязанныхПозиций(ДопПараметры);	
	КонецЕсли;
		
	ОбновитьПеренумероватьДерево(Ложь, ДопПараметры.Позиция);
	// ЭтаФорма.Модифицированность = Не СуществуютАкты;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьПересчетПривязанныхПозиций(ДопПараметры)
	СМ_СметаРасчетСервер.ВыполнитьПересчетПривязанныхПозиций(ДопПараметры.Позиция,ДопПараметры.НовыйОбъем,ДопПараметры.СтарыйОбъем);
КонецПроцедуры

&НаСервереБезКонтекста    
Процедура ИзменитьОбъемПозицииЛС(ТекДокумент, НовыйОбъем, ВводОбъемовВБазовыхЕдИзм, Формула = Неопределено);
	
	Если ВводОбъемовВБазовыхЕдИзм Тогда
		НовыйОбъем = СМ_СметаВызовСервера.ПересчитатьВбазовыхЕдиницахИзмерения(ТекДокумент,НовыйОбъем);
	КонецЕсли;
	
	ТекОбъект 				= ТекДокумент.ПолучитьОбъект();
	ТекОбъект.ОбъемРабот 	= НовыйОбъем;
	Если Не Формула = Неопределено Тогда
		ТекОбъект.ФормулаОбъема = Формула;
	КонецЕсли;
	СМ_СметаКлиентСервер.РассчитатьКоличествоРесурса(ТекОбъект);
	
	ТекОбъект.Записать();
		
	Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(ТекОбъект);
	
КонецПроцедуры

#Область Коэффициенты

&НаСервере
Процедура ПриИзмененииКоэффициента(НаименованиеКоэффициента, ЗначениеКоэффициента,ТекДок)

	// 1. Базисно-индексный метод и уровень расчета индексов "Позиция/Расценка"
	Если Объект.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
		И Объект.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка Тогда
		
		// Обновить коэффициенты позиции
		Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			ОбновитьИндексПоДокументу(ТекДок,НаименованиеКоэффициента,ЗначениеКоэффициента);
			Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(ТекДок);
			// Обновить коэффициенты разделов и позиций ЛС, подчиненных текущему разделы
		ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			ТабДокументов = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(ТекДок,Истина,Истина,Ложь,Ложь);
			Для Каждого ТекСтрока Из ТабДокументов Цикл
				ОбновитьИндексПоДокументу(ТекСтрока.ИД,НаименованиеКоэффициента,ЗначениеКоэффициента);
			КонецЦикла;
			Документы.СМ_РазделЛокальнойСметы.Перерасчет(ТекДок);
			// Обновить коэффициенты всех позиций ЛС, подчиненных локальной смете
		ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			ТабДокументов = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(ТекДок,Ложь,Истина,Истина,Истина);
			Для Каждого ТекСтрока Из ТабДокументов Цикл
				ОбновитьИндексПоДокументу(ТекСтрока.ИД,НаименованиеКоэффициента,ЗначениеКоэффициента);
			КонецЦикла;
			Документы.СМ_ЛокальнаяСмета.Перерасчет(Объект,Ложь);
		КонецЕсли;		
		// 2. Базисно-индексный метод и уровень расчета индексов "Раздел"
	ИначеЕсли Объект.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
		И Объект.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда
		
		// Обновить коэффициенты текущего раздела и разделов, подчиненных текущему
		Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			
			ОбновитьИндексПоДокументу(ТекДок,НаименованиеКоэффициента,ЗначениеКоэффициента);
		
		ТабДокументов = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(ТекДок,Истина,Ложь,Ложь,Ложь);
		Для Каждого ТекСтрока Из ТабДокументов Цикл
			ОбновитьИндексПоДокументу(ТекСтрока.ИД,НаименованиеКоэффициента,ЗначениеКоэффициента);
		КонецЦикла;
		Документы.СМ_РазделЛокальнойСметы.Перерасчет(ТекДок);
		// Обновить коэффициенты всех разделов ЛС, подчиненных локальной смете
	ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		
		ТабДокументов = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(ТекДок,Истина,Ложь,Ложь,Ложь);
			Для Каждого ТекСтрока Из ТабДокументов Цикл
		     	ОбновитьИндексПоДокументу(ТекСтрока.ИД,НаименованиеКоэффициента,ЗначениеКоэффициента);
			КонецЦикла;
            Документы.СМ_ЛокальнаяСмета.Перерасчет(Объект,Ложь);
		КонецЕсли;			
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИндексПоДокументу(ТекДок,НаименованиеКоэффициента,ЗначениеКоэффициента)
	
	Если ТекДок.Расчет Тогда
		// Обновить коэффициент позиции
		Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			ТекОб = ТекДок.ПолучитьОбъект();
			Если ТекОб.КоэффициентыПересчета.Количество() = 0 Тогда
				ТекСтр = ТекОб.КоэффициентыПересчета.Добавить();
			Иначе
				ТекСтр = ТекОб.КоэффициентыПересчета[0] ;
			КонецЕсли;
			ТекСтр[НаименованиеКоэффициента] = ЗначениеКоэффициента;
			ТекОб.ОбменДанными.Загрузка = Истина;
			ТекОб.Записать();
			// Обновить коэффициент раздела
		ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			ТекОб = ТекДок.ПолучитьОбъект();
			ТекОб[НаименованиеКоэффициента] = ЗначениеКоэффициента;
			ТекОб.ОбменДанными.Загрузка = Истина;
			ТекОб.Записать();
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры

