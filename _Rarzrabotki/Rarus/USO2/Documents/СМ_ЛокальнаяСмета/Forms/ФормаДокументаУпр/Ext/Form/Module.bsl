&НаСервере
Функция ПолучитьПозицииПоЛокальнойСмете(ЛокальнаяСмета, МассивПозиций = Ложь)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ 
	|	СМ_ПозицияЛокальнойСметы.Ссылка КАК Позиция,
	|	СМ_ПозицияЛокальнойСметы.ФормулаОбъема КАК ФормулаОбъема
	|ИЗ
	|	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
	|ГДЕ 
	|	СМ_ПозицияЛокальнойСметы.ИДСметы = &ЛокальнаяСмета И 
	| 	СМ_ПозицияЛокальнойСметы.Расчет = ИСТИНА И
	|	СМ_ПозицияЛокальнойСметы.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	СМ_ПозицияЛокальнойСметы.Дата";	
	
	Запрос.УстановитьПараметр("ЛокальнаяСмета", Объект.Ссылка);
	ТабПозиций = Запрос.Выполнить().Выгрузить();

	Если МассивПозиций Тогда
		ТекМассив = ТабПозиций.ВыгрузитьКолонку("Позиция");	
		Возврат ТекМассив;
	Иначе
		Возврат ТабПозиций;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьСвязанныеПозицииЛС(МассивПозиций)
	
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СМ_ПозицияЛокальнойСметы.Ссылка КАК Позиция,
	|	СМ_ПозицияЛокальнойСметы.ФормулаОбъема КАК ФормулаОбъема
	|ИЗ
	|	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
	|ГДЕ
	|	СМ_ПозицияЛокальнойСметы.ИДПозицииВладельца В (&МассивПозиций) И
	| 	СМ_ПозицияЛокальнойСметы.Расчет = ИСТИНА И
	|	СМ_ПозицияЛокальнойСметы.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	СМ_ПозицияЛокальнойСметы.Дата";
	
	Запрос.УстановитьПараметр("МассивПозиций",МассивПозиций);
	ТабПозиций = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабПозиций;

КонецФункции

&НаСервере
Процедура ОбновитьЗначенияПараметровВПозициях(ТабПозицийЛС)

	Для Каждого ТекСтрока Из ТабПозицийЛС Цикл
		ТекПозицияЛС 	= ТекСтрока.Позиция;
		ТекФормула 		= ТекСтрока.ФормулаОбъема;
		Если НЕ ЗначениеЗаполнено(ТекФормула) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекПозицияЗнака = СтрНайти(ТекФормула,"=");
		Если ТекПозицияЗнака > 0 Тогда
			ТекФормула = СокрЛП(Сред(ТекФормула,2));
		КонецЕсли;
			
		МассивПараметров = СМ_СметаКлиентСервер.ПолучитьСписокПараметровФормулы(ТекФормула);
		Если МассивПараметров.Количество() > 0 Тогда
			СтруктураПараметров = СМ_СметаКлиентСервер.ЗаполнитьЗначенияПараметров(МассивПараметров,Объект.Ссылка);
			ТекФормула 			= СМ_СметаКлиентСервер.ПодставитьПараметрыВФормулу(ТекФормула,СтруктураПараметров);
			НовыйОбъем 			= 0;
			Попытка
				Формула = "НовыйОбъем = " + ТекФормула;
				Выполнить(Формула);
				Если ТекПозицияЛС.ОбъемРабот <> НовыйОбъем Тогда
					ИзменитьОбъемПозицииЛС(ТекПозицияЛС,НовыйОбъем, ВводОбъемовВБазовыхЕдИзм, ТекСтрока.ФормулаОбъема);
				КонецЕсли;
			   	ИзменитьОбъемПозицииЛС(ТекПозицияЛС,НовыйОбъем, ВводОбъемовВБазовыхЕдИзм, ТекСтрока.ФормулаОбъема);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Ошибка в формуле, объем не изменен'"));
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыВставкиПозиции(Результат, ДопПараметры) Экспорт
	
	Если Результат Тогда
		Если ДопПараметры.ТекущаяСтрокаДерева <> Неопределено Тогда
			Элементы.ДеревоЛС.Свернуть(ДопПараметры.ТекущаяСтрокаДерева);
			Элементы.ДеревоЛС.Развернуть(ДопПараметры.ТекущаяСтрокаДерева);
		КонецЕсли;
		ОбновитьПеренумероватьДерево(Истина,ДопПараметры.СохраненнаяСтрока);  
	КонецЕсли;
	
КонецПроцедуры

