&НаКлиенте
Процедура ПоказатьДанныеДокумента(ТекДок)
	
	Возврат;
	
	Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		Этаформа.ТекПозицияДерева 			= ТекДок;
		Элементы.ДанныеДокументов.Видимость = Истина;
		Элементы.СтраницыПозиции.Видимость 	= Истина;
		Элементы.СтраницыРаздела.Видимость 	= Ложь;
	ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
		Этаформа.ТекРазделДерева 			= ТекДок;
		Элементы.ДанныеДокументов.Видимость = Истина;
		Элементы.СтраницыПозиции.Видимость 	= Ложь;
		Элементы.СтраницыРаздела.Видимость 	= Истина;
		Если Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И 
			 Объект.Уровень	= ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Раздел")	Тогда
			Элементы.СтраницаКоэффициенты.Видимость = Истина;
		Иначе	 
			Элементы.СтраницаКоэффициенты.Видимость = Ложь;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ТекДок) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		Элементы.СтраницыПозиции.Видимость	= Ложь;
		Элементы.СтраницыРаздела.Видимость 	= Ложь;
		Элементы.ДанныеДокументов.Видимость = Ложь;
	КонецЕсли;

	// ПоказатьКоэффициентыПоПозиции(ТекДок);
	// ПоказатьКоэффициентыПоРазделу(ТекДок);
	
КонецПроцедуры

