// Процедура осуществляет действия после закрытия формы справочника Фрагменты.
// ПАРАМЕТРЫ:
//// Результат - ссылка на справочник, форма которого закрыта.
//// Параметры - дополнительные параметры переданные при формировании вопроса пользователю.
&НаКлиенте
Процедура ПриЗакрытииФормыВыбораФрагмента(Результат, Структура) Экспорт
	ТекущиеДанные = Элементы.ДеревоЛС.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	РегиональнаяБаза = Результат.СНБ;
	Фрагмент = Результат.Фрагмент;
	ФормулаФрагмента = ПреобразоватьФормулу(СокрЛП(Результат.ОбъемФрагмента));
	
	
	Если РегиональнаяБаза.Пустая() Или Фрагмент.Пустая() Тогда
		Возврат;
	КонецЕсли;	
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	Иначе
		Если ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			ТекРаздел = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ТекущиеДанные.Элемент, "ИДРодителя");
		Иначе
			ТекРаздел = ТекущиеДанные.Элемент;
		КонецЕсли;
		Если  СметнаяКомпонента = Неопределено Тогда
			Возврат;
		КонецЕсли;
		НомерВДереве = ИдентификаторВерхнейСтроки+0.01;
		СозданныеПозиции = Новый СписокЗначений;
		СМ_СметаВызовСервера.СоздатьПозициюЛокальнойСметыПутемПодбораИзФрагментов(Объект.Ссылка, РегиональнаяБаза, Фрагмент, ФормулаФрагмента, ТекРаздел,СозданныеПозиции,НомерВДереве);
		// Обновление по базе для выбранных позиций.
		
		СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(Объект.Ссылка);
		КодРегиона = НайтиКод(РегиональнаяБаза);
		КодРайона = НайтиКод(СтруктураПараметровРасчетаЛС.Район);
		
			// Загрузка коэффициентов пересчета.
		МетодРасчета = СтруктураПараметровРасчетаЛС.МетодРасчета;
		Уровень = СтруктураПараметровРасчетаЛС.Уровень;
		ВариантПересчетаЭММ =  СтруктураПараметровРасчетаЛС.ВариантПересчетаЭММ;
		ФайлИндексов = СтруктураПараметровРасчетаЛС.ФайлСборникаКоэффициентов;
		ПрименятьИндексыКоВсемБазам  = СтруктураПараметровРасчетаЛС.ПрименятьИндексыКоВсемБазам;
		АвтозагрузкаИндексов  = СтруктураПараметровРасчетаЛС.АвтозагрузкаИндексов;
		КодРегионаФайлаИндексовПересчета = СтруктураПараметровРасчетаЛС.КодРегионаФайлаИндексовПересчета;
		Загрузитьиндексы = Ложь;
		Если (МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный")
			И Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Расценка")) Тогда
			Если АвтозагрузкаИндексов И ЗначениеЗаполнено(ФайлИндексов) Тогда
				СтруктураДанных = Новый Структура("СборникКоэффициентов", ФайлИндексов);
				Если ПрименятьИндексыКоВсемБазам Тогда
					СтруктураДанных.Вставить("КодРегиональнойБазы", КодРегионаФайлаИндексовПересчета);
				КонецЕсли;
				Загрузитьиндексы = Истина;
			КонецЕсли;
		КонецЕсли;
		// Загрузка текущих цен.
		АвтозагрузкаЦен 		= СтруктураПараметровРасчетаЛС.АвтозагрузкаЦен;
		ФайлСборникаТекущихЦен 	= СтруктураПараметровРасчетаЛС.ФайлСборникаТекущихЦен;
		КодРегионаФайлаТекущихЦен = СтруктураПараметровРасчетаЛС.КодРегионаФайлаТекущихЦен;
		ЗагрузитьЦены = Ложь;

		Если АвтозагрузкаЦен И ЗначениеЗаполнено(ФайлСборникаТекущихЦен) Тогда
			СтруктураДанныхЦен = Новый Структура("СборникТекущихЦен, КодРегиональнойБазы", ФайлСборникаТекущихЦен, КодРегионаФайлаТекущихЦен);
			ЗагрузитьЦены = Истина;
		КонецЕсли;
		
		ФлЗагрузки = Ложь;
		Для Каждого ПозицияОбновления Из СозданныеПозиции Цикл

			ПараметрыОбновленияПозиции = Новый Структура("ТипСборникаПереч,ШифрРасценки,ПозицияВладелец");
			ТекущаяПозиция = ПозицияОбновления.Значение;
			НайтиПараметрыОбновления(ПараметрыОбновленияПозиции,ТекущаяПозиция);
			ТипСборника = СМ_СметаЗагрузкаВызовСервера.ОпределитьКодТипаСборника(ПараметрыОбновленияПозиции.ТипСборникаПереч);
			ШифрРасценки = ПараметрыОбновленияПозиции.ШифрРасценки;
			ПозицияВладелец = ПараметрыОбновленияПозиции.ПозицияВладелец;
			НомерСборника = СокрЛП(Строка(СМ_СметаВызовСервера.ОпределитьНомерСборника(ТипСборника, ШифрРасценки)));
			Если ТипСборника = ПредопределенноеЗначение("Перечисление.СМ_ТипыНормативныхСборников.Калькуляция") Тогда
				Продолжить;
			КонецЕсли;	
			Если НомерСборника = "0" Тогда
				Продолжить;
			КонецЕсли;
			Данные = СметнаяКомпонента.ОбновитьПоБазе(ШифрРасценки,КодРайона,КодРегиона,ТипСборника,НомерСборника);
			Если ЗначениеЗаполнено(Данные) И СМ_СметаЗагрузкаВызовСервера.ЕстьДанные(Данные) = Ложь Тогда
				Продолжить;
			КонецЕсли;
			Если ЗначениеЗаполнено(Данные) Тогда
				Если СтруктураПараметровФормыВыбораВНБ = Неопределено Тогда
					СтруктураПараметровФормыВыбораВНБ = Новый Структура("Пометить",?(ПозицияОбновления.Представление = "Истина",Истина,Ложь));
				Иначе
					СтруктураПараметровФормыВыбораВНБ.Вставить("Пометить",?(ПозицияОбновления.Представление = "Истина",Истина,Ложь)); 
				КонецЕсли;
				СтруктураПараметровФормыВыбораВНБ = СМ_СметаВызовСервера.ОбновитьДанныеВПозицииЛС(Данные, ПозицияОбновления.Значение, Истина, СтруктураПараметровФормыВыбораВНБ, СтруктураПараметровРасчетаЛС, СМ_ВерсияКомпоненты, Истина);
				Если ПозицияОбновления.Представление = "Истина" Тогда
					// Если установлен хотя бы один признак Загружать ресурсы по проекту,
					// вызывается модуль загрузки ресурсов по проекту.
					ФлЗагрузки = Истина;	
				КонецЕсли;
	
			КонецЕсли;
			Если ЗагрузитьИндексы = Истина Тогда
				ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОбИндексахПересчета(ТекущаяПозиция, , СтруктураДанных);
				СМ_СметаВызовСервера.ЗагрузитьИндексыВПозиции(ТекущаяПозиция, ДанныеИнд, ВариантПересчетаЭММ, Истина, Ложь);
			КонецЕсли;	
			Если ЗагрузитьЦены Тогда
				ДанныеЦен = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОТекущихЦенах(ТекущаяПозиция, , СтруктураДанныхЦен);
				СМ_СметаВызовСервера.ЗагрузитьТекущиеЦеныВПозиции(ТекущаяПозиция, ДанныеЦен, Истина, Ложь);
			КонецЕсли;					

		КонецЦикла;	
		
		Если ФлЗагрузки  = Истина Тогда
			
			Если ТипЗнч(СтруктураПараметровФормыВыбораВНБ) = Тип("Структура") Тогда
				Если Объект.ФайлСборникаТекущихЦен <> "" Тогда
					ТаблицаРесурсов = ПолучитьНеучтенныеРесурсы(СтруктураПараметровФормыВыбораВНБ.Ресурсы);
					СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(Объект.Ссылка);
					Для Каждого стр Из ТаблицаРесурсов Цикл
						СтруктураЦен = Новый Структура();
						СтруктураЦен.Вставить("БазиснаяЦена");
						СтруктураЦен.Вставить("БазиснаяЗарплатаМашинистов");
						СтруктураЦен.Вставить("ТекущаяЦена");
						СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов");
						СМ_СметаКлиент.ПолучитьЦеныНовогоРесурса(стр.Ресурс,Объект.Район,Объект.ФайлСборникаТекущихЦен,СтруктураПараметровРасчетаЛС.КодРегионаФайлаТекущихЦен,СтруктураЦен);
						Если ЗначениеЗаполнено(СтруктураЦен.ТекущаяЦена) Тогда
							стр.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
						КонецЕсли;
					КонецЦикла;
					ПомещениеНеучтенныхРесурсов(ТаблицаРесурсов,СтруктураПараметровФормыВыбораВНБ.Ресурсы);
				Иначе
					ЗаполнитьЦеныНеучтенныхРесурсов(СтруктураПараметровФормыВыбораВНБ.Ресурсы);
				КонецЕсли;
			КонецЕсли;

			СМ_СметаКлиент.ОткрытьФормуПодбораНеучтенныхРесурсов(СтруктураПараметровФормыВыбораВНБ);
			ОбновитьПеренумероватьДерево(Истина, ТекущаяПозиция);
		Иначе
			ОбновитьПеренумероватьДерево(Истина, ТекущаяПозиция);
			//ОбновитьДерево(Истина);		
		КонецЕсли;	

	    СтруктураПараметровФормыВыбораВНБ = Неопределено;
	КонецЕсли;
	
КонецПроцедуры


// Процедура осуществляет действия после закрытия формы справочника Нормативные сборники.
// ПАРАМЕТРЫ:
//// Результат - Массив строк справочника, форма которого закрыта.
//// Параметры - дополнительные параметры переданные при формировании вопроса пользователю.
&НаКлиенте
Процедура ПриЗакрытииФормыВыбораНС(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Элементы.ДеревоЛС.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	Иначе
		Если ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			ТекРаздел = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ТекущиеДанные.Элемент, "ИДРодителя");
		Иначе
			ТекРаздел = ТекущиеДанные.Элемент;
		КонецЕсли;
		СтруктураПараметровФормыВыбораВНБ = Неопределено;
		НадоОБновлять = Истина;
		Если Результат.Количество() = 1 Тогда
			
			СсылкаНаНормСборн	= Результат[0];
			ЗаголовокПодбора	= ОпределитьЗаголовок(СсылкаНаНормСборн);
			ПараметрыОповещения	= Новый Структура("СсылкаЭлемент, ТекРаздел", СсылкаНаНормСборн, ТекРаздел);
			
			ПоказыватьВводКоличества	= 	ПолучитьЗначениеНастройкиНаСервере("НастройкиПользователяСмета", "Оповещения_ДобавлениеПозицииСпрашиватьВводКоличества");
			ПоказыватьВводКоличества    = ?(ПоказыватьВводКоличества = Неопределено,Ложь,ПоказыватьВводКоличества);
			Если ПоказыватьВводКоличества Тогда
				Оповещение = Новый ОписаниеОповещения("ПослеВводаКоличества", ЭтотОбъект, ПараметрыОповещения);
				ПоказатьВводЧисла(Оповещение, 0, ЗаголовокПодбора, 15, 5);
			Иначе
				ПослеВводаКоличества(0, ПараметрыОповещения);	
			КонецЕсли;
			
		Иначе
			ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеВыбораПозицииСправочник",ЭтаФорма,Новый Структура("ТекРаздел",ТекРаздел));
			СтруктураПараметров = Новый Структура("ТаблицаВыбораНС",Результат);
			ОткрытьФорму("Документ.СМ_ЛокальнаяСмета.Форма.ФормаВыбораПозиций",СтруктураПараметров,ЭтаФорма,,,,ОповещениеОЗакрытии,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьЗначениеНастройкиНаСервере(КлючОбъекта, КлючНастроек)
	
	УстановитьПривилегированныйРежим(Истина);
	
	СвойстваПользователя = Пользователи.НовоеОписаниеПользователяИБ();	
	Пользователи.ПрочитатьПользователяИБ(ПараметрыСеанса.ТекущийПользователь.ИдентификаторПользователяИБ, СвойстваПользователя);     	
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КлючОбъекта, КлючНастроек,,,СвойстваПользователя.Имя);
											
КонецФункции //Функция ПолучитьЗначениеНастройкиНаСервере(КлючОбъекта, КлючНастроек)

&НаКлиенте
Процедура ПослеВыбораПозицииСправочник(Результат, Параметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтруктураПараметровФормыВыбораВНБ = Неопределено;
	НадоОБновлять = Истина;
	НомерВДереве = ИдентификаторВерхнейСтроки;
	Для Каждого стр Из Результат Цикл
		НомерВДереве = НомерВДереве+0.01;
		СсылкаЭлемент = стр.Ссылка;
		НоваяПозиция = Неопределено;
		Объем = стр.Количество;
		Если ТипЗнч(СсылкаЭлемент) = Тип("СправочникСсылка.СМ_НормативныеСборники") Тогда
			СтруктураПараметровФормыВыбораВНБ = СМ_СметаВызовСервера.СоздатьПозициюЛокальнойСметыПутемПодбораИзНормативногоСборника(Объект.Ссылка, СсылкаЭлемент, Параметры.ТекРаздел,НомерВДереве, СтруктураПараметровФормыВыбораВНБ, НоваяПозиция,Объем);
		ИначеЕсли ТипЗнч(СсылкаЭлемент) = Тип("СправочникСсылка.СМ_Ресурсы") Тогда
			ПараметрыРесурса = СМ_СметаКлиент.ИнициироватьСтруктуруОписанияРесурсаСмета(Объект,Параметры.ТекРаздел);
			ПараметрыРесурса.Ресурс = СсылкаЭлемент; 
			Если ПараметрыРесурса.ЗагружатьТекущиеЦены И ЗначениеЗаполнено(Объект.ФайлСборникаТекущихЦен) Тогда
				СтруктураЦен = Новый Структура();
				СтруктураЦен.Вставить("БазиснаяЦена");
				СтруктураЦен.Вставить("БазиснаяЗарплатаМашинистов");
				СтруктураЦен.Вставить("ТекущаяЦена");
				СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов");
				СМ_СметаКлиент.ПолучитьЦеныНовогоРесурса(СсылкаЭлемент,Объект.Район,Объект.ФайлСборникаТекущихЦен,Объект.КодРегионаФайлаТекущихЦен,СтруктураЦен); 	
				ПараметрыРесурса.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
				ПараметрыРесурса.ТекущаяЗарплМаш = СтруктураЦен.ТекущаяЗарплатаМашинистов;
			КонецЕсли;
			СМ_СметаВызовСервера.ПолучитьОписаниеРесурса(ПараметрыРесурса);
			СтруктураПараметровФормыВыбораВНБ = СМ_СметаВызовСервера.СоздатьПозициюЛокальнойСметыПутемПодбораИзСправочникаРесурсы(Объект.Ссылка, СсылкаЭлемент, Параметры.ТекРаздел,ПараметрыРесурса,НомерВДереве, СтруктураПараметровФормыВыбораВНБ, НоваяПозиция,Объем,Параметры.ПозицияВладелец);
		КонецЕсли;
	КонецЦикла;
	Если ТипЗнч(СтруктураПараметровФормыВыбораВНБ) = Тип("Структура") Тогда
		СМ_СметаКлиент.ОткрытьФормуПодбораНеучтенныхРесурсов(СтруктураПараметровФормыВыбораВНБ);
	КонецЕсли;
	ОбновитьПеренумероватьДерево(Истина,НоваяПозиция);   
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаКоличества(Число, Параметры) Экспорт
	Если НЕ Число = Неопределено Тогда
		НомерВДереве = ИдентификаторВерхнейСтроки+0.01;
		НоваяПозиция = Неопределено;
		Если ТипЗнч(Параметры.СсылкаЭлемент) = Тип("СправочникСсылка.СМ_НормативныеСборники") Тогда
			ДанныеЦен = Неопределено;
			Если Объект.АвтозагрузкаЦен И ЗначениеЗаполнено(Объект.ФайлСборникаТекущихЦен) Тогда
				СтруктураДанных = Новый Структура("СборникТекущихЦен, КодРегиональнойБазы", Объект.ФайлСборникаТекущихЦен, Объект.КодРегионаФайлаТекущихЦен);
				ДанныеЦен = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОТекущихЦенахРесурсов(Параметры.СсылкаЭлемент,СтруктураДанных,Объект.Ссылка);
			КонецЕсли;
			СтруктураПараметровФормыВыбораВНБ = СМ_СметаВызовСервера.СоздатьПозициюЛокальнойСметыПутемПодбораИзНормативногоСборника(Объект.Ссылка, Параметры.СсылкаЭлемент, Параметры.ТекРаздел,НомерВДереве, СтруктураПараметровФормыВыбораВНБ, НоваяПозиция,Число,ДанныеЦен);
		ИначеЕсли ТипЗнч(Параметры.СсылкаЭлемент) = Тип("СправочникСсылка.СМ_Ресурсы") Тогда
			ПараметрыРесурса = СМ_СметаКлиент.ИнициироватьСтруктуруОписанияРесурсаСмета(Объект,Параметры.ТекРаздел);
			ПараметрыРесурса.Ресурс = Параметры.СсылкаЭлемент; 
			Если ПараметрыРесурса.ЗагружатьТекущиеЦены
				И ЗначениеЗаполнено(Объект.ФайлСборникаТекущихЦен) Тогда
				СтруктураЦен = Неопределено;
				СМ_СметаКлиент.ПолучитьЦеныНовогоРесурса(Параметры.СсылкаЭлемент,Объект.Район,Объект.ФайлСборникаТекущихЦен,Объект.КодРегионаФайлаТекущихЦен,СтруктураЦен); 	
				ПараметрыРесурса.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
				ПараметрыРесурса.ТекущаяЗарплМаш = СтруктураЦен.ТекущаяЗарплатаМашинистов;
			КонецЕсли;
			СтруктураПараметровФормыВыбораВНБ = СМ_СметаВызовСервера.СоздатьПозициюЛокальнойСметыПутемПодбораИзСправочникаРесурсы(Объект.Ссылка, Параметры.СсылкаЭлемент, Параметры.ТекРаздел,ПараметрыРесурса, НомерВДереве,СтруктураПараметровФормыВыбораВНБ, НоваяПозиция,Число,Параметры.ПозицияВладелец);
		КонецЕсли;
		
		// вставка индексов если БИ по позициям
		Если Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный")
			И Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Расценка") Тогда
			Если Объект.АвтозагрузкаИндексов
				И ЗначениеЗаполнено(Объект.ФайлСборникаКоэффициентов)
				И Не НоваяПозиция = Неопределено Тогда
				// обновляем индексы
				СтруктураДанных = Новый Структура("СборникКоэффициентов", Объект.ФайлСборникаКоэффициентов);
				Если Объект.ПрименятьИндексыКоВсемБазам Тогда
					СтруктураДанных.Вставить("КодРегиональнойБазы", Объект.КодРегионаФайлаИндексовПересчета);
				КонецЕсли;
				ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОбИндексахПересчета(НоваяПозиция, , СтруктураДанных);
				СМ_СметаВызовСервера.ЗагрузитьИндексыВПозиции(НоваяПозиция, ДанныеИнд, Объект.ВариантПересчетаЭММ, Истина, Истина,);	
			КонецЕсли;
		КонецЕсли;

		Если ТипЗнч(СтруктураПараметровФормыВыбораВНБ) = Тип("Структура") Тогда
			СМ_СметаКлиент.ОткрытьФормуПодбораНеучтенныхРесурсов(СтруктураПараметровФормыВыбораВНБ);
		КонецЕсли;
		ОбновитьПеренумероватьДерево(Истина,НоваяПозиция); 
    КонецЕсли;
КонецПроцедуры

// Процедура осуществляет действия после закрытия формы выбора документов (при перемещении в другой раздел).
// ПАРАМЕТРЫ:
//// Результат - ссылка на выбранный документ.
//// Параметры - дополнительные параметры переданные при формировании вопроса пользователю.
&НаКлиенте
Процедура ПриЗакрытииФормыВыбораНовогоРодителя(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СсылкаНаОбъект = Параметры.СсылкаНаОбъект;
	ЗначениеНовогоРодителя = Результат;
	ЗаменитьРодителя(ЗначениеНовогоРодителя, СсылкаНаОбъект);
	// ДокторСофт
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		ПереместитьПривязанныеПозиции(СсылкаНаОбъект,ЗначениеНовогоРодителя);
		Параметры.Вставить("ТекущаяСмета",Объект.Ссылка);
		ЗаменитьРодителяОбновитьПересчитатьСметыСервер(Результат,Параметры);
		ОбновитьПеренумероватьДерево(Истина, СсылкаНаОбъект);   // sudav - рефакторинг одинакового кода
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
		ВыбратьПривязанныеРазделы(СсылкаНаОбъект);
		Параметры.Вставить("ТекущаяСмета",Объект.Ссылка);
		ЗаменитьРодителяОбновитьПересчитатьСметыСервер(Результат,Параметры);
		ОбновитьПеренумероватьДерево(Истина,,Истина);   // sudav - рефакторинг одинакового кода
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура ЗаменитьРодителя(ЗначениеНовогоРодителя, СсылкаНаОбъект)
	НовОбъект = СсылкаНаОбъект.ПолучитьОбъект();
	СМ_СметаВызовСервера.ЗаменитьРодителя(ЗначениеНовогоРодителя, НовОбъект);
	НовОбъект.Записать(РежимЗаписиДокумента.Запись);
КонецПроцедуры

&НаСервере
Функция ОпределитьЗаголовок(СсылкаЭлемент)
	ЗаголовокПодбора = "";
	Если СсылкаЭлемент <> Неопределено Тогда
		Попытка
			ЗаголовокПодбора =  СокрЛП(СсылкаЭлемент.Наименование) + "  [" + СокрЛП(СсылкаЭлемент.ЕдиницаИзмерения.Наименование) + "]";
		Исключение
			ЗаголовокПодбора =  Строка(СсылкаЭлемент);
		КонецПопытки;
	КонецЕсли;
	Возврат(ЗаголовокПодбора);
КонецФункции

&НаСервере
Функция НайтиКод(СпрСсылка)
	 Код = СокрЛП(СпрСсылка.Код);	
	 Возврат(Код);
КонецФункции

&НаСервере
Процедура НайтиПараметрыОбновления(ПараметрыОбновленияПозиции,СсылкаНаДокумент)
	 ПараметрыОбновленияПозиции.Вставить("ТипСборникаПереч", СсылкаНаДокумент.ТипНормативныхСборников);
	 ПараметрыОбновленияПозиции.Вставить("ШифрРасценки", СсылкаНаДокумент.ШифрРасценки);
	 ПараметрыОбновленияПозиции.Вставить("ПозицияВладелец", СсылкаНаДокумент.ИДПозицииВладельца);
КонецПроцедуры	

// ДокторСофт
&НаСервере
Функция ПроверитьОбъект(СсылкаНаОбъект)
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		Если ЗначениеЗаполнено(СсылкаНаОбъект.ИДПозицииВладельца) Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаСервере
Процедура ЗаменитьРодителяОбновитьПересчитатьСметыСервер(Результат,Параметры)
	СметаНовая = ПеренумероватьСметуНазначения(Результат,Параметры.ТекущаяСмета);
	ПересчетСметы(Параметры.СсылкаНаОбъект,Параметры.ТекущаяСмета);
	Если (Параметры.ТекущаяСмета<>СметаНовая) Тогда
		ПересчетСметы(,СметаНовая);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПеренумероватьСметуНазначения(НовыйРодитель,Смета)

	ЛС = СМ_СметаВызовСервера.НайтиЛС(НовыйРодитель);
	Если ЛС <> Смета Тогда
		ОбъектЛС = ЛС.ПолучитьОбъект();
		СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(ОбъектЛС);
	КонецЕсли;
	
	Возврат ЛС;  
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПересчетСметы(ОбъектДляОперации = Неопределено, Смета = Неопределено)
	Если ТипЗнч(Смета) = тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		СМ_СметаВызовСервера.УдалитьДвижения(Смета);
		Документы.СМ_ЛокальнаяСмета.Перерасчет(Смета, Ложь);
	КонецЕсли;
	Если (ОбъектДляОперации <> Неопределено) Тогда
		ПересчитатьПозиции(ОбъектДляОперации);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПересчитатьПозиции(ОбъектДляОперации)
	Если ТипЗнч(ОбъектДляОперации) = тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		СМ_СметаВызовСервера.УдалитьДвижения(ОбъектДляОперации);
		Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(ОбъектДляОперации, Ложь);
	ИначеЕсли ТипЗнч(ОбъектДляОперации) = тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
		СМ_СметаВызовСервера.УдалитьДвижения(ОбъектДляОперации);
		Документы.СМ_РазделЛокальнойСметы.Перерасчет(ОбъектДляОперации, Ложь);
	КонецЕсли;
		
КонецПроцедуры

// ДокторСофт

&НаКлиенте
Процедура СкопироватьСтроку(СтрокаКоторуюПрикрепляем,нов)
	
	нов.ЕдВсего =  СтрокаКоторуюПрикрепляем.ЕдВсего;
	нов.ЕдЗатрТрМех	 =  СтрокаКоторуюПрикрепляем.ЕдЗатрТрМех;
	нов.ЕдЗатрТрРаб =  СтрокаКоторуюПрикрепляем.ЕдЗатрТрРаб;
	нов.ЕдОснЗП =  СтрокаКоторуюПрикрепляем.ЕдОснЗП;
	нов.ЕдСтоимостьМатериалов =  СтрокаКоторуюПрикрепляем.ЕдСтоимостьМатериалов;
	нов.ЕдЭМЗарПлата =  СтрокаКоторуюПрикрепляем.ЕдЭМЗарПлата;
	нов.ЕдЭксплМашин =  СтрокаКоторуюПрикрепляем.ЕдЭксплМашин;
	нов.Измеритель =  СтрокаКоторуюПрикрепляем.Измеритель;
	нов.ИндексНеИндексировать =  СтрокаКоторуюПрикрепляем.ИндексНеИндексировать;
	нов.индексПересчет =  СтрокаКоторуюПрикрепляем.индексПересчет;

	нов.ИндексПоправки =  СтрокаКоторуюПрикрепляем.ИндексПоправки;
	нов.ИндексПривязана =  СтрокаКоторуюПрикрепляем.ИндексПривязана;
	нов.Кол =  СтрокаКоторуюПрикрепляем.Кол;
	нов.НаимРаботИЗатрат =  СтрокаКоторуюПрикрепляем.НаимРаботИЗатрат;
	нов.наименование =  СтрокаКоторуюПрикрепляем.наименование;
	нов.ОбоснСметнойСтоим =  СтрокаКоторуюПрикрепляем.ОбоснСметнойСтоим;
	нов.ОбщВсего =  СтрокаКоторуюПрикрепляем.ОбщВсего;
	нов.ОбщЗатрТрМех =  СтрокаКоторуюПрикрепляем.ОбщЗатрТрМех;
	нов.ОбщЗатрТрРаб =  СтрокаКоторуюПрикрепляем.ОбщЗатрТрРаб;
	нов.ОбщОснЗП =  СтрокаКоторуюПрикрепляем.ОбщОснЗП;
	нов.ОбщСтоимостьМатериалов =  СтрокаКоторуюПрикрепляем.ОбщСтоимостьМатериалов;
	нов.ОбщЭМЗарПлата =  СтрокаКоторуюПрикрепляем.ОбщЭМЗарПлата;
	нов.ОбщЭксплМашин =  СтрокаКоторуюПрикрепляем.ОбщЭксплМашин;
	нов.Расчет =  СтрокаКоторуюПрикрепляем.Расчет;
	нов.Стоимостьединицы =  СтрокаКоторуюПрикрепляем.Стоимостьединицы;
	
	
	
	
КонецПроцедуры	

// Процедура осуществляет действия после закрытия формы выбора позиции, к которой привязывается текущая.
// ПАРАМЕТРЫ:
//// Результат - ссылка на выбранный документ.
//// Параметры - дополнительные параметры переданные при формировании вопроса пользователю.
&НаКлиенте
Процедура ПриЗакрытииФормыВыбораНовогоВладельцаПриПривязке(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ИдВладельца = ИдПозицииВладельца(Параметры.Позиция);

	СменитьВладельца(Результат, Параметры);
	
	СтрокаКоторуюПрикрепляем = ДеревоЛС.НайтиПоИдентификатору(ЭЛементы.ДеревоЛС.ТекущаяСтрока);
	
	Если Результат.пустая() Тогда
		Идент = СМ_СметныйСоставКлиент.ПроверитьСтрокуДерева(ДеревоЛС.ПолучитьЭлементы(),СтрокаКоторуюПрикрепляем.ПолучитьРодителя().Элемент,"Идентификатор");	
	Иначе	
	
		Идент = СМ_СметныйСоставКлиент.ПроверитьСтрокуДерева(ДеревоЛС.ПолучитьЭлементы(),Результат,"Идентификатор");
	КонецЕсли;
	
	СтрокаККомуПрикреплеяем =  ДеревоЛС.НайтиПоИдентификатору(Идент);
	
	Искомыйиндекс = 0;
	
	Если Результат.пустая() Тогда
		СтруктураРодителя = СтрокаККомуПрикреплеяем.ПолучитьЭлементы();	
		
		 Для каждого эл Из СтруктураРодителя Цикл
			
			Если типЗнч(эл.Элемент) = тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Если ИдПозицииВладельца(эл.Элемент) = ИдВладельца И эл.Элемент <> СтрокаКоторуюПрикрепляем.Элемент Тогда
				 Искомыйиндекс = СтруктураРодителя.индекс(Эл);
			 КонецЕсли;	
			 КонецЕсли;
			
		КонецЦикла;	
	
	Иначе	
		
	СтруктураРодителя =  СтрокаККомуПрикреплеяем.ПолучитьРодителя().ПолучитьЭлементы();
	КонецЕсли;
	
	Для каждого эл Из СтруктураРодителя Цикл
		
		Если эл.Элемент = СтрокаККомуПрикреплеяем.элемент Тогда
			Искомыйиндекс = СтруктураРодителя.индекс(Эл);
		КонецЕсли;	
		
		Если типЗнч(эл.Элемент) = тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		Если ИдПозицииВладельца(эл.Элемент) = СтрокаККомуПрикреплеяем.элемент И эл.Элемент <> СтрокаКоторуюПрикрепляем.Элемент Тогда
			 Искомыйиндекс = СтруктураРодителя.индекс(Эл);
		 КонецЕсли;	
		 КонецЕсли;
		
	КонецЦикла;	
	
	нов = СтруктураРодителя.вставить(Искомыйиндекс+1);
	СкопироватьСтроку(СтрокаКоторуюПрикрепляем,нов);
	//
	
	элПозиция 	= СтрокаКоторуюПрикрепляем.Элемент;
	Родитель 	= СтрокаКоторуюПрикрепляем.ПолучитьРодителя();
	Родитель 	= Родитель.ПолучитьЭлементы();
	
	Искомыйиндекс = 0;
	Для Каждого эл Из Родитель Цикл
		Если эл.Элемент =  СтрокаКоторуюПрикрепляем.Элемент Тогда
			Искомыйиндекс = СтруктураРодителя.индекс(Эл);
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
	
	Родитель.Удалить(Искомыйиндекс);
	нов.элемент = элПозиция;
	
	ОбновитьПеренумероватьДерево(Истина, Параметры.Позиция);   // sudav - рефакторинг одинакового кода
	
КонецПроцедуры

&наСервереБезКонтекста
Функция ИдПозицииВладельца(Элемент)
	
	Возврат Элемент.ИДпозицииВладельца;
	
КонецФункции	

&НаСервере
Процедура СменитьВладельца(Результат, Параметры)
	
	ПозицияВладелец = Документы.СМ_ПозицияЛокальнойСметы.ПустаяСсылка();
	Если Параметры.ВызовПриЗакрытии Тогда
		Если ЗначениеЗаполнено(Результат) Тогда
			ПозицияВладелец = Результат;
		КонецЕсли;
	КонецЕсли;
	ПозицияОбъект = Параметры.Позиция.ПолучитьОбъект();
	ПозицияОбъект.ИДПозицииВладельца = ПозицияВладелец;

	// Пересчет нормы расхода и количества при привязке позиции 
	Если ЗначениеЗаполнено(ПозицияВладелец) Тогда
		Если ПозицияОбъект.ОбъемРабот > 0 И ПозицияВладелец.ОбъемРабот > 0 Тогда
			ПозицияОбъект.НормаРасходаРесурса = ПозицияОбъект.ОбъемРабот / ПозицияВладелец.ОбъемРабот;		
			СМ_СметаКлиентСервер.РассчитатьКоличествоРесурса(ПозицияОбъект);
		КонецЕсли
	КонецЕсли;		
	
	ПозицияОбъект.Записать();
	
КонецПроцедуры	

#КонецОбласти

&НаКлиенте
Процедура СоздатьНовыйРаздел(ТекущаяСтрокаДерева)
	
	Родитель = Неопределено;

	Если ТипЗнч(ТекущаяСтрокаДерева) <> Тип("Неопределено") Тогда
		Родитель = СМ_СметаКлиент.ПолучитьСсылкуСтрокиДереваСмет(ТекущаяСтрокаДерева);
	КонецЕсли;
	
	Если ТипЗнч(Родитель) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Установите курсор на раздел, чтобы создать подчинённый'"));
		Возврат;
	КонецЕсли;	
	
	СтруктураПарамеров = Новый Структура;
	СтруктураПарамеров.Вставить("Смета",Объект.Ссылка);
	СтруктураПарамеров.Вставить("Родитель",Родитель);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПриЗакрытииФормыДокументаРаздел",ЭтаФорма, Новый Структура("Родитель",Родитель));
	ОткрытьФорму("Справочник.СМ_РазделыЛокальнойСметы.ФормаВыбора",СтруктураПарамеров,ЭтаФорма,,,,ОповещениеОЗакрытии,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьПозициюЛокальнойСметы(Родитель, ДанныеФормы)
	
	ДанныеФормы.Дата 					= Объект.Дата;
	ДанныеФормы.ИДРодителя 				= Родитель;
	ДанныеФормы.Расчет 					= Истина;
	ДанныеФормы.ТипНормативныхСборников = ПредопределенноеЗначение("Перечисление.СМ_ТипыНормативныхСборников.Калькуляция");
	
КонецФункции

// ДокторСофт
&НаСервере
Функция ВыбратьПривязанныеРазделы(Владелец)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Раздел,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
	               |ПОМЕСТИТЬ Номера
	               |ИЗ
	               |	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |ГДЕ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Раздел.ИДРодителя = &ИДРодителя
	               |	И СМ_НумерацияПозицийЛокальныхСмет.Позиция = ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СМ_РазделЛокальнойСметы.Ссылка
	               |ИЗ
	               |	Документ.СМ_РазделЛокальнойСметы КАК СМ_РазделЛокальнойСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Номера КАК Номера
	               |		ПО (Номера.Раздел = СМ_РазделЛокальнойСметы.Ссылка)
	               |ГДЕ
	               |	СМ_РазделЛокальнойСметы.ИДРодителя = &ИДРодителя
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номера.ПорНомер";
	
	Запрос.УстановитьПараметр("ИДРодителя",Владелец);
	ВыборкаПривязанных = Запрос.Выполнить().Выбрать();
	
	ВыбратьПривязанныеРазделуПозиции(Владелец);
	Пока ВыборкаПривязанных.Следующий() Цикл
		ОбъектОбработки = ВыборкаПривязанных.Ссылка.ПолучитьОбъект();
		СМ_СметаВызовСервера.ЗаполнитьДанныеДокументаВСтруктуреСмет(ОбъектОбработки, Владелец);
		ОбъектОбработки.ПорНомер = 0;
		ОбъектОбработки.Записать(РежимЗаписиДокумента.Запись);
		ВыбратьПривязанныеРазделуПозиции(ВыборкаПривязанных.Ссылка);
	КонецЦикла;

КонецФункции

&НаСервере
Функция ВыбратьПривязанныеРазделуПозиции(Владелец)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Позиция,
	               |	СМ_НумерацияПозицийЛокальныхСмет.Раздел,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
	               |ПОМЕСТИТЬ Номера
	               |ИЗ
	               |	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |ГДЕ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Раздел = &ИДРодителя
	               |	И СМ_НумерацияПозицийЛокальныхСмет.Позиция <> ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПозицияЛокальнойСметы.Ссылка
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Номера КАК Номера
	               |		ПО (Номера.Позиция = ПозицияЛокальнойСметы.Ссылка)
	               |			И (Номера.Раздел = ПозицияЛокальнойСметы.ИДРодителя)
	               |ГДЕ
	               |	ПозицияЛокальнойСметы.ИДРодителя = &ИДРодителя
	               |	И ПозицияЛокальнойСметы.ИДПозицииВладельца = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номера.ПорНомер";
	
	Запрос.УстановитьПараметр("ИДРодителя",Владелец);
	ВыборкаПривязанных = Запрос.Выполнить().Выбрать();
	Пока ВыборкаПривязанных.Следующий() Цикл
		ОбъектОбработки = ВыборкаПривязанных.Ссылка.ПолучитьОбъект();
		СМ_СметаВызовСервера.ЗаполнитьДанныеДокументаВСтруктуреСмет(ОбъектОбработки, Владелец);
		ОбъектОбработки.ИДПозицииВладельца = ВыборкаПривязанных.Ссылка.ИДПозицииВладельца;
		ОбъектОбработки.ПорНомер = 0;
		ОбъектОбработки.Записать(РежимЗаписиДокумента.Запись);
		ПереместитьПривязанныеПозиции(ВыборкаПривязанных.Ссылка, Владелец);
	КонецЦикла;

КонецФункции

