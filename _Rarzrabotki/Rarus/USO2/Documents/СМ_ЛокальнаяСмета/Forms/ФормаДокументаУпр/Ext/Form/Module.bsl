&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Судариков чтобы работала система
	Отказ = СМ_ЗащитаКлиент.ЗапускОбъекта();
	Если Объект.СметаРассчитана Тогда
		Отказ = Истина;
		ОткрытьФорму("Документ.СМ_ЛокальнаяСмета.Форма.ФормаРассчитаннойСметы",Новый Структура("Ключ",Объект.Ссылка));
	КонецЕсли;
	
	Если Не Отказ Тогда
		ПолучитьВариантПоУмолчанию();
		ИзменитьФорматДанных();
		СМ_СметаКлиент.ОтобразитьУровеньМетодРасчета(ЭтаФорма);
		ВидимостьДоступностьЭлементовНаФорме();
		ОбновитьВидимостьНаВкладкеНастройкаПечати();
		ВидимостьМобильнойКнопки();
		Элементы.ПоказатьИндексы.Пометка = Ложь;
		ВидимостьГруппаИндексы();
		ОтмеченаВДереве = 1;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.Свойства") Тогда
		МодульУправлениеСвойствамиКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеСвойствамиКлиент");
		МодульУправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ИЗменитьФорматДанных()
	
	Если Объект.ОкруглятьДоРублей Тогда
		
		Элементы.ДеревоЛСОбщаяСтоимость.Формат					= "";
		Элементы.ДеревоЛСОбщаяСтоимость.Форматредактирования	= "";
        Элементы.ДеревоЛСОбщВсего.Формат						= "";
		Элементы.ДеревоЛСОбщВсего.Форматредактирования			= "";
		Элементы.ДеревоЛСОбщЭксплМашин.Формат					= "";
		Элементы.ДеревоЛСОбщЭксплМашин.Форматредактирования		= "";
		Элементы.ДеревоЛСОбщСтоимостьМатериалов.Формат			= "";
		Элементы.ДеревоЛСОбщСтоимостьМатериалов.Форматредактирования = "";
		Элементы.ДеревоЛСОбщОснЗП.Формат						= "";
		Элементы.ДеревоЛСОбщОснЗП.Форматредактирования			= "";
		Элементы.ДеревоЛСОбщЭМЗарПлата.Формат					= "";
		Элементы.ДеревоЛСОбщЭМЗарПлата.Форматредактирования		= "";
		Элементы.НеОкруглятьНДС.Доступность						= Истина;
	Иначе	
		
		Элементы.ДеревоЛСОбщаяСтоимость.Формат					= "ЧДЦ=2";
		Элементы.ДеревоЛСОбщаяСтоимость.Форматредактирования	= "ЧДЦ=2";
        Элементы.ДеревоЛСОбщВсего.Формат						= "ЧДЦ=2";
		Элементы.ДеревоЛСОбщВсего.Форматредактирования			= "ЧДЦ=2";
		Элементы.ДеревоЛСОбщЭксплМашин.Формат					= "ЧДЦ=2";
		Элементы.ДеревоЛСОбщЭксплМашин.Форматредактирования		= "ЧДЦ=2";
		Элементы.ДеревоЛСОбщСтоимостьМатериалов.Формат			= "ЧДЦ=2";
		Элементы.ДеревоЛСОбщСтоимостьМатериалов.Форматредактирования = "ЧДЦ=2";
		Элементы.ДеревоЛСОбщОснЗП.Формат						= "ЧДЦ=2";
		Элементы.ДеревоЛСОбщОснЗП.Форматредактирования			= "ЧДЦ=2";
		Элементы.ДеревоЛСОбщЭМЗарПлата.Формат					= "ЧДЦ=2";
		Элементы.ДеревоЛСОбщЭМЗарПлата.Форматредактирования		= "ЧДЦ=2";
		//Элементы.НеОкруглятьНДС = Истина;
		Элементы.НеОкруглятьНДС.Доступность						= Ложь;
		
	КонецЕсли;
	
	ТекущаяСтрокаДерева =  Элементы.ДеревоЛС.ТекущаяСтрока;
	
	Если ТекущаяСтрокаДерева <> Неопределено Тогда
	
		Элементы.ДеревоЛС.Свернуть(ТекущаяСтрокаДерева);
		Элементы.ДеревоЛС.Развернуть(ТекущаяСтрокаДерева);
	
	КонецЕсли;
	
	
	
	
КонецПроцедуры	

// Обрабатывает внешнее событие от ВНБ
// Источник - "AddIn.Base"
// Событие - Строка - Внешнее событие.
// Данные - данные в виде XML.
// Параметры внешнего события передаются на обработку в общие модули: Обработчики Сметы.
&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	Если Источник = "AddIn.Base" Тогда
		ЗапретитьВставку = ЗапретВставки();
		Если Событие = "SelectRasc"+ИдФормы Тогда
			
			ТекущиеДанные = СтрокаДляВНБ;
			Если ТекущиеДанные = Неопределено Тогда
				Возврат;
			Иначе
				Если ТипЗнч(ТекущиеДанные) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
					ТекРаздел = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ТекущиеДанные, "ИДРодителя");
				Иначе
					ТекРаздел = ТекущиеДанные;
				КонецЕсли;
				
				НомерВДереве = ИдентификаторВерхнейСтроки+0.01;
				СсылкаНаПозицию = Неопределено;
				
				ЗаполнитьВерсию = Ложь;
				ПозицияВладелец = Неопределено;
				Если ВариантВыбораВНБ = "ТекЦены"+ИдФормы Тогда
					ЗаполнитьВерсию = Истина;
					Если ЗапретитьВставку Тогда
						ПозицияВладелец = ТекущиеДанные;
					КонецЕсли;
				КонецЕсли;

				СтруктураПараметровФормыВыбораВНБ = СМ_СметаВызовСервера.ЗагрузитьДанныеВПозициюЛС(Данные,ТекРаздел, Истина, СтруктураПараметровФормыВыбораВНБ, , СМ_ВерсияКомпоненты, СсылкаНаПозицию,НомерВДереве,ЗаполнитьВерсию,ПозицияВладелец);	
				Если СтрНайти(ВариантВыбораВНБ,"ТекЦены") = 0 Тогда // из СНБ.
					
					Если Объект.АвтозагрузкаЦен
						И ЗначениеЗаполнено(Объект.ФайлСборникаТекущихЦен)
						И Не СсылкаНаПозицию = Неопределено Тогда // Флаг обновление по текущим ценам включен, сборник тек цен указан.
						
						СтруктураДанных = Новый Структура("СборникТекущихЦен, КодРегиональнойБазы", Объект.ФайлСборникаТекущихЦен, Объект.КодРегионаФайлаТекущихЦен);
						ДанныеЦен = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОТекущихЦенах(СсылкаНаПозицию, , СтруктураДанных);
						СМ_СметаВызовСервера.ЗагрузитьТекущиеЦеныВПозиции(СсылкаНаПозицию, ДанныеЦен, Истина,  Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.Ресурсный"),,,Истина);
						
					ИначеЕсли Объект.АвтозагрузкаЦен И Не СсылкаНаПозицию = Неопределено Тогда // Флаг обновление по текущим ценам включен, сборник тек цен не указан.
						СМ_СметаВызовСервера.ОбновитьЦены(СсылкаНаПозицию,Объект.Район,Объект.РегионДляВыбораЦен,Истина);
					ИначеЕсли Не Объект.АвтозагрузкаЦен И Не СсылкаНаПозицию = Неопределено Тогда // Флаг обновление по текущим ценам не включен
						СМ_СметаВызовСервера.ОбновитьЦены(СсылкаНаПозицию,Объект.Район);
					КонецЕсли;
				Иначе // из текущих цен.
					
					// Уже в процессе заполнения заполняется текущая цена.
					
					// Если Объект.АвтозагрузкаЦен
					//	И ЗначениеЗаполнено(Объект.ФайлСборникаТекущихЦен)
					//	И Не СсылкаНаПозицию = Неопределено Тогда 
					//	
					//	СтруктураДанных = Новый Структура("СборникТекущихЦен, КодРегиональнойБазы", Объект.ФайлСборникаТекущихЦен, Объект.КодРегионаФайлаТекущихЦен);
					//	ДанныеЦен = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОТекущихЦенах(СсылкаНаПозицию, , СтруктураДанных);
					//	СМ_СметаВызовСервера.ЗагрузитьТекущиеЦеныВПозиции(СсылкаНаПозицию, ДанныеЦен, Истина,  Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.Ресурсный"));
					//	
					// КонецЕсли;
					
					Если Не СсылкаНаПозицию = Неопределено Тогда
						СМ_СметаВызовСервера.ЗагрузитьБазисныеЦеныВПозицию(СсылкаНаПозицию,Объект.Район);
					КонецЕсли;
					
				КонецЕсли;
				
				// вставка индексов если БИ по позициям
				Если Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный")
					И Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Расценка")
					И СтрНайти(ВариантВыбораВНБ,"ТекЦены") = 0 Тогда
					Если Объект.АвтозагрузкаИндексов
						И ЗначениеЗаполнено(Объект.ФайлСборникаКоэффициентов)
						И Не СсылкаНаПозицию = Неопределено Тогда
						// обновляем индексы
						СтруктураДанных = Новый Структура("СборникКоэффициентов", Объект.ФайлСборникаКоэффициентов);
						Если Объект.ПрименятьИндексыКоВсемБазам Тогда
							СтруктураДанных.Вставить("КодРегиональнойБазы", Объект.КодРегионаФайлаИндексовПересчета);
						КонецЕсли;
						ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОбИндексахПересчета(СсылкаНаПозицию, , СтруктураДанных);
						СМ_СметаВызовСервера.ЗагрузитьИндексыВПозиции(СсылкаНаПозицию, ДанныеИнд, Объект.ВариантПересчетаЭММ, Истина, Истина,);	
					КонецЕсли;
				КонецЕсли;

				// *********************************************
				// ++ AVV Роли в системе
				//Если ЭтоСметчикПрайсы Тогда
				//	НеПоказыватьНеучтенные 	= СМ_СметаВызовСервера.ПолучитьНастройкуНеучтенных("НеПоказыватьНеучтенные");
				//	ВставлятьНеучтенные 	= СМ_СметаВызовСервера.ПолучитьНастройкуНеучтенных("ВставлятьНеучтенныеАвтоматически");	
				//Иначе
				//	НеПоказыватьНеучтенные 	= Истина;
				//	ВставлятьНеучтенные		= Ложь;
				//КонецЕсли;
				// -- AVV Роли в системе
				// *********************************************

				НеПоказыватьНеучтенные 	= СМ_СметаВызовСервера.ПолучитьНастройкуНеучтенных("НеПоказыватьНеучтенные");
				ВставлятьНеучтенные 	= СМ_СметаВызовСервера.ПолучитьНастройкуНеучтенных("ВставлятьНеучтенныеАвтоматически");	
						
				Если НеПоказыватьНеучтенные Тогда
					Если ВставлятьНеучтенные Тогда
						Если ТипЗнч(СтруктураПараметровФормыВыбораВНБ) = Тип("Структура") Тогда
							Если Объект.ФайлСборникаТекущихЦен <> "" Тогда
								ТаблицаРесурсов = ПолучитьНеучтенныеРесурсы(СтруктураПараметровФормыВыбораВНБ.Ресурсы);
								СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(Объект.Ссылка);
								Для Каждого стр Из ТаблицаРесурсов Цикл
									СтруктураЦен = Неопределено;
									СМ_СметаКлиент.ПолучитьЦеныНовогоРесурса(стр.Ресурс,Объект.Район,Объект.ФайлСборникаТекущихЦен,СтруктураПараметровРасчетаЛС.КодРегионаФайлаТекущихЦен,СтруктураЦен);
									Если ЗначениеЗаполнено(СтруктураЦен.ТекущаяЦена) Тогда
										стр.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
									КонецЕсли;
								КонецЦикла;
								ПомещениеНеучтенныхРесурсов(ТаблицаРесурсов,СтруктураПараметровФормыВыбораВНБ.Ресурсы);
							Иначе
								ЗаполнитьЦеныНеучтенныхРесурсов(СтруктураПараметровФормыВыбораВНБ.Ресурсы);
							КонецЕсли;
						КонецЕсли;
						СМ_СметаКлиент.ОткрытьФормуПодбораНеучтенныхРесурсов(СтруктураПараметровФормыВыбораВНБ,Истина,Истина);
					КонецЕсли;
					СтруктураПараметровФормыВыбораВНБ = Неопределено;
				КонецЕсли;
				ОбновитьПеренумероватьДерево(Истина, СсылкаНаПозицию);
				ИдентификаторВерхнейСтроки = ПолучитьНомерВДереве(СсылкаНаПозицию);
			КонецЕсли;
			
		ИначеЕсли Событие = "FormClosed"+ИдФормы Тогда 
			
			ИдФормы = "";
			ИдентификаторВерхнейСтроки = Неопределено;
			Если ОбщТекРаздел = Неопределено Тогда
				Возврат;
			КонецЕсли;
			НадоОБновлять = Ложь;
			
			Если ТипЗнч(СтруктураПараметровФормыВыбораВНБ) = Тип("Структура") Тогда
				Если Объект.ФайлСборникаТекущихЦен <> "" Тогда
					ТаблицаРесурсов = ПолучитьНеучтенныеРесурсы(СтруктураПараметровФормыВыбораВНБ.Ресурсы);
					СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(Объект.Ссылка);
					Для Каждого стр Из ТаблицаРесурсов Цикл
						СтруктураЦен = Неопределено;
						СМ_СметаКлиент.ПолучитьЦеныНовогоРесурса(стр.Ресурс,Объект.Район,Объект.ФайлСборникаТекущихЦен,СтруктураПараметровРасчетаЛС.КодРегионаФайлаТекущихЦен,СтруктураЦен);
						Если ЗначениеЗаполнено(СтруктураЦен.ТекущаяЦена) Тогда
							стр.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
						КонецЕсли;
					КонецЦикла;
					ПомещениеНеучтенныхРесурсов(ТаблицаРесурсов,СтруктураПараметровФормыВыбораВНБ.Ресурсы);
				Иначе
					ЗаполнитьЦеныНеучтенныхРесурсов(СтруктураПараметровФормыВыбораВНБ.Ресурсы);
				КонецЕсли;
				
				// *********************************************
				// ++ AVV Роли в системе
				//Если ЭтоСметчикПрайсы Тогда
				//	НеПоказыватьНеучтенные 	= СМ_СметаВызовСервера.ПолучитьНастройкуНеучтенных("НеПоказыватьНеучтенные");
				//	ВставлятьНеучтенные 	= СМ_СметаВызовСервера.ПолучитьНастройкуНеучтенных("ВставлятьНеучтенныеАвтоматически");	
				//Иначе
				//	НеПоказыватьНеучтенные 	= Истина;
				//	ВставлятьНеучтенные		= Ложь;
				//КонецЕсли;
				// -- AVV Роли в системе
				// *********************************************
				
				НеПоказыватьНеучтенные 	= СМ_СметаВызовСервера.ПолучитьНастройкуНеучтенных("НеПоказыватьНеучтенные");
				ВставлятьНеучтенные 	= СМ_СметаВызовСервера.ПолучитьНастройкуНеучтенных("ВставлятьНеучтенныеАвтоматически");	

				Если Не НеПоказыватьНеучтенные Тогда
					СМ_СметаКлиент.ОткрытьФормуПодбораНеучтенныхРесурсов(СтруктураПараметровФормыВыбораВНБ,НадоОБновлять);
				Иначе
					Если ВставлятьНеучтенные Тогда
						 СМ_СметаКлиент.ОткрытьФормуПодбораНеучтенныхРесурсов(СтруктураПараметровФормыВыбораВНБ,НадоОБновлять,Истина);
					КонецЕсли;
				КонецЕсли;
				СтруктураПараметровФормыВыбораВНБ = Неопределено;
			КонецЕсли;
			
			Если НадоОБновлять Тогда
				
				ОбновитьПеренумероватьДерево(Истина, СсылкаНаПозицию);   // sudav - рефакторинг одинакового кода

			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЦеныНеучтенныхРесурсов(АдресТаблицыРесурсов)
	ТаблицаРесурсов = ПолучитьИзВременногоХранилища(АдресТаблицыРесурсов);
	СтруктураПараметровЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(Объект.Ссылка);
	Район = СтруктураПараметровЛС.Район;
	ДатаТекущихЦен = СтруктураПараметровЛС.ДатаТекущихЦен;
	РегиональнаяБаза = СтруктураПараметровЛС.РегионДляВыбораЦен;

	Для Каждого стр Из ТаблицаРесурсов Цикл
		СтруктураЦен = Новый Структура();
		СтруктураЦен.Вставить("БазиснаяЦена");
		СтруктураЦен.Вставить("БазиснаяЗарплатаМашинистов");
		СтруктураЦен.Вставить("ТекущаяЦена");
		СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов");
		СМ_СметаВызовСервера.ПолучитьЦеныНовогоРесурса(стр.Ресурс,Район,РегиональнаяБаза,ДатаТекущихЦен,СтруктураЦен,Истина);
		Если ЗначениеЗаполнено(СтруктураЦен.ТекущаяЦена) Тогда
			стр.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
		КонецЕсли;
	КонецЦикла;
	ПоместитьВоВременноеХранилище(ТаблицаРесурсов, АдресТаблицыРесурсов)
КонецПроцедуры

&НаСервере
Функция ПолучитьНеучтенныеРесурсы(АдресТаблицыРесурсов) 
	ТаблицаРесурсов = ПолучитьИзВременногоХранилища(АдресТаблицыРесурсов);
	Возврат СМ_СметаВызовСервера.ПреобразоватьТаблицуЗначенийВМассив(ТаблицаРесурсов);
КонецФункции

&НаСервере
Процедура ПомещениеНеучтенныхРесурсов(МассивРесурсов,АдресТаблицыРесурсов) 
	ТаблицаРесурсов = СМ_СметаВызовСервера.ПреобразоватьМассивВТаблицуЗначений(МассивРесурсов);
	ПоместитьВоВременноеХранилище(ТаблицаРесурсов, АдресТаблицыРесурсов) ;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЛСПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	Возврат;
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Строка") Тогда 
		Если ЗначениеЗаполнено(Строка) Тогда
			ТекущиеДанные 	= ДеревоЛС.НайтиПоидентификатору(Строка);
			Если ТипЗнч(ТекущиеДанные.Элемент) <> Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") 
				И ТипЗнч(ТекущиеДанные.Элемент) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				Состояние(НСтр("ru='Необходимо выделить раздел или позицию'"),100,"",БиблиотекаКартинок.Предупреждение32);
				Возврат;
			КонецЕсли;
		КонецЕсли;	
	ИначеЕсли ЗначениеЗаполнено(Строка) Тогда
		
		ТекЭл 	= ДеревоЛС.НайтиПоидентификатору(Элемент.ТекущаяСтрока).Элемент;
		КудаЭл 	= ДеревоЛС.НайтиПоидентификатору(Строка).Элемент;
		
		Если ТипЗнч(ТекЭл) = тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Если ПозицияВладельцаЗаполнена(ТекЭл) Тогда
				 ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.НеОбрабатывать;
				 Возврат;
			КонецЕсли;		 
		КонецЕсли;	
		
		Если ТипЗнч(ДеревоЛС.НайтиПоидентификатору(Элемент.ТекущаяСтрока).Элемент) = тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")
			И ТипЗнч(ДеревоЛС.НайтиПоидентификатору(Строка).Элемент)  = тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
			ИЛИ ТипЗнч(ДеревоЛС.НайтиПоидентификатору(Элемент.ТекущаяСтрока).Элемент) = тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
			И ТипЗнч(ДеревоЛС.НайтиПоидентификатору(Строка).Элемент)  = тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			СтандартнаяОбработка = ложь;
		Иначе
			Если ТипЗнч(ТекЭл) = тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")
				И ТипЗнч(КудаЭл) = тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.Перемещение;
			Иначе
				ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.НеОбрабатывать;
			КонецЕсли;
		КонецЕсли;
		 
	КонецЕсли;
	 
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЛСПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	Возврат;
	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Строка") Тогда 
		Если ЗначениеЗаполнено(Строка) Тогда
			Данные = ПараметрыПеретаскивания.Значение;
			ТекущиеДанные 	= ДеревоЛС.НайтиПоидентификатору(Строка);
			Если ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				ТекРаздел = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ТекущиеДанные.Элемент, "ИДРодителя");
			Иначе
				ТекРаздел = ТекущиеДанные.Элемент;
			КонецЕсли;
			
			СсылкаНаПозицию = Неопределено;
			СтруктураПараметровФормыВыбораВНБ = СМ_СметаВызовСервера.ЗагрузитьДанныеВПозициюЛС(Данные,ТекРаздел, Истина, СтруктураПараметровФормыВыбораВНБ, , СМ_ВерсияКомпоненты, СсылкаНаПозицию);	
			
			// вставка индексов если БИ по позициям
			Если (Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Расценка")) Тогда
				Если Объект.АвтозагрузкаИндексов И ЗначениеЗаполнено(Объект.ФайлСборникаКоэффициентов) И (СсылкаНаПозицию <> Неопределено) Тогда
					// обновляем индексы
					СтруктураДанных = Новый Структура("СборникКоэффициентов", Объект.ФайлСборникаКоэффициентов);
					Если Объект.ПрименятьИндексыКоВсемБазам Тогда
						СтруктураДанных.Вставить("КодРегиональнойБазы", Объект.КодРегионаФайлаИндексовПересчета);
					КонецЕсли;
					ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОбИндексахПересчета(СсылкаНаПозицию, , СтруктураДанных);
					СМ_СметаВызовСервера.ЗагрузитьИндексыВПозиции(СсылкаНаПозицию, ДанныеИнд, Объект.ВариантПересчетаЭММ, Истина, Истина,);	
				КонецЕсли;
			КонецЕсли;
			
			// вставка текущих цен если отмечено
			Если Объект.АвтозагрузкаЦен И ЗначениеЗаполнено(Объект.ФайлСборникаТекущихЦен) И (СсылкаНаПозицию <> Неопределено) Тогда
				// обновляем индексы
				СтруктураДанных = Новый Структура("СборникТекущихЦен, КодРегиональнойБазы", Объект.ФайлСборникаТекущихЦен, Объект.КодРегионаФайлаТекущихЦен);
				ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОТекущихЦенах(СсылкаНаПозицию, , СтруктураДанных);
				СМ_СметаВызовСервера.ЗагрузитьТекущиеЦеныВПозиции(СсылкаНаПозицию, ДанныеИнд, Истина,  Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.Ресурсный"));
			КонецЕсли;
			
			Если ТипЗнч(СтруктураПараметровФормыВыбораВНБ) = Тип("Структура") Тогда
				СМ_СметаКлиент.ОткрытьФормуПодбораНеучтенныхРесурсов(СтруктураПараметровФормыВыбораВНБ);
				СтруктураПараметровФормыВыбораВНБ = Неопределено;
			КонецЕсли;
			ОбщТекРаздел.ТекущийЭлемент = СсылкаНаПозицию;
			ОбновитьПеренумероватьДерево(Истина, ОбщТекРаздел.ТекущийЭлемент);   // sudav - рефакторинг одинакового кода
			
		КонецЕсли;	
	ИначеЕсли ЗначениеЗаполнено(Строка) Тогда
		ТекЭл =  ДеревоЛС.НайтиПоидентификатору(Элемент.ТекущаяСтрока).Элемент;
		КудаЭл =  ДеревоЛС.НайтиПоидентификатору(Строка).Элемент;
		Если ТипЗнч(ТекЭл) = тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")
			И ТипЗнч(КудаЭл)  = тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
			ИЛИ ТипЗнч(ДеревоЛС.НайтиПоидентификатору(Элемент.ТекущаяСтрока).Элемент) = тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
			И ТипЗнч(ДеревоЛС.НайтиПоидентификатору(Строка).Элемент)  = тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			
			ПереписатьРодителя(ТекЭл,КудаЭл);
			ЗаменитьРодителяОбновитьПересчитатьСметыСервер(КудаЭл,Новый Структура("ТекущаяСмета,СсылкаНаОбъект",Объект.Ссылка,ТекЭл));
			ОбновитьПеренумероватьДерево(Истина, ТекЭл);   // sudav - рефакторинг одинакового кода
		ИначеЕсли ТипЗнч(ТекЭл) = тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")
			И ТипЗнч(КудаЭл) = тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			
			Документ = ТекЭл;
			
			ПеремещаемыеСтроки = Новый Массив;
			МассивРодителей = Новый Массив;
			
			ПеремещаемаяСтрока = ДеревоЛС.НайтиПоИдентификатору(Элемент.ТекущаяСтрока);
			ПеремещаемыеСтроки.Добавить(ПеремещаемаяСтрока);
			Родитель = ПеремещаемаяСтрока.ПолучитьРодителя();
			Если МассивРодителей.Найти(Родитель) = Неопределено Тогда
				МассивРодителей.Добавить(Родитель);
			КонецЕсли;
			
			ВместоПеремещаемаяСтрока = ДеревоЛС.НайтиПоИдентификатору(Строка);
			Родитель = ВместоПеремещаемаяСтрока.ПолучитьРодителя();
			Если МассивРодителей.Найти(Родитель) = Неопределено Тогда
				МассивРодителей.Добавить(Родитель);
			КонецЕсли;
			
			Если МассивРодителей.Количество() > 1 Тогда
				ПоказатьПредупреждение(,НСтр("ru='Перемещаемые элементы должны быть в одной группе.'"),,НСтр("ru='Внимание'"));
				Возврат;
			КонецЕсли;
			
			Если Элемент.ТекущаяСтрока<Строка Тогда
				ПредыдущийДокумент = Неопределено;
				ИндексПеремещаемойСтроки = ПеремещаемаяСтрока.ПолучитьРодителя().ПолучитьЭлементы().Индекс(ПеремещаемаяСтрока);
				ИндексВставки = ПеремещаемаяСтрока.ПолучитьРодителя().ПолучитьЭлементы().Индекс(ВместоПеремещаемаяСтрока)+1;
				ТекИндекс = ИндексПеремещаемойСтроки;
				Если ТекИндекс = ИндексВставки Тогда
					Возврат;
				КонецЕсли;
				ТекСтрокаПривязана = ПеремещаемаяСтрока.ИндексПривязана = 0;
				ЭлементыГруппы = МассивРодителей[0].ПолучитьЭлементы();
				КоличествоЭлементовГруппы = ИндексВставки;
				ВыполненоПеремещение = Ложь;
				Пока Не ВыполненоПеремещение Цикл
					ТекИндекс = ТекИндекс + 1;
					Пока ТекИндекс <=КоличествоЭлементовГруппы-1 Цикл
						ПредыдущаяСтрока = ЭлементыГруппы.Получить(ТекИндекс);
						Если ПеремещаемыеСтроки.Найти(ПредыдущаяСтрока) = Неопределено И ПредыдущаяСтрока.ТипСтроки = ПеремещаемаяСтрока.ТипСтроки Тогда
							ПредыдущийДокумент = ПредыдущаяСтрока.Элемент;
							ОсуществитьПеремещение(Документ, ПредыдущийДокумент);
							ВыполненоПеремещение = Истина;
						КонецЕсли;
						
						Если ПредыдущаяСтрока.ТипСтроки <> ПеремещаемаяСтрока.ТипСтроки И ТекСтрокаПривязана Тогда
							ТекИндекс = ТекИндекс - 1;
							ПервыйПривязанныйДокумент = ЭлементыГруппы[ТекИндекс].Элемент;
							ПоследнийПривязанныйДокумент = ПервыйПривязанныйДокумент;
							Пока ТекИндекс < КоличествоЭлементовГруппы Цикл 
								ПоследнийПривязанныйДокумент = ЭлементыГруппы[ТекИндекс].Элемент;
								Если ЭлементыГруппы[ТекИндекс].ИндексПривязана = 1 Тогда
									Прервать;
								КонецЕсли;
								ТекИндекс = ТекИндекс - 1;
							КонецЦикла;
							ОсуществитьПеремещение(Документ, Неопределено, ПервыйПривязанныйДокумент, ПоследнийПривязанныйДокумент, -1);
							ВыполненоПеремещение = Истина;
						КонецЕсли;
						ТекИндекс = ТекИндекс + 1;
					КонецЦикла;
				КонецЦикла;
			Иначе
				ПредыдущийДокумент = Неопределено;
				ИндексПеремещаемойСтроки = ПеремещаемаяСтрока.ПолучитьРодителя().ПолучитьЭлементы().Индекс(ПеремещаемаяСтрока);
				ТекИндекс = ИндексПеремещаемойСтроки;
				ИндексВставки = ПеремещаемаяСтрока.ПолучитьРодителя().ПолучитьЭлементы().Индекс(ВместоПеремещаемаяСтрока)+1;
				Если ТекИндекс = ИндексВставки Тогда
					Возврат;
				КонецЕсли;
				ТекСтрокаПривязана = ПеремещаемаяСтрока.ИндексПривязана = 0;
				ЭлементыГруппы = МассивРодителей[0].ПолучитьЭлементы();
				КоличествоЭлементовГруппы = ИндексВставки;
				ВыполненоПеремещение = Ложь;
				Пока Не ВыполненоПеремещение Цикл
					ТекИндекс = ТекИндекс - 1;
					Пока ТекИндекс >=ИндексВставки Цикл
						ПредыдущаяСтрока = ЭлементыГруппы.Получить(ТекИндекс);
						Если ПеремещаемыеСтроки.Найти(ПредыдущаяСтрока) = Неопределено И ПредыдущаяСтрока.ТипСтроки = ПеремещаемаяСтрока.ТипСтроки Тогда
							ПредыдущийДокумент = ПредыдущаяСтрока.Элемент;
							ОсуществитьПеремещение(Документ, ПредыдущийДокумент);
							ВыполненоПеремещение = Истина;
						КонецЕсли;
						
						Если ПредыдущаяСтрока.ТипСтроки <> ПеремещаемаяСтрока.ТипСтроки И ТекСтрокаПривязана Тогда
							ТекИндекс = ТекИндекс + 1;
							ПервыйПривязанныйДокумент = ЭлементыГруппы[ТекИндекс].Элемент;
							ПоследнийПривязанныйДокумент = ПервыйПривязанныйДокумент;
							Пока ТекИндекс < КоличествоЭлементовГруппы Цикл 
								ПоследнийПривязанныйДокумент = ЭлементыГруппы[ТекИндекс].Элемент;
								Если ЭлементыГруппы[ТекИндекс].ИндексПривязана = 1 Тогда
									Прервать;
								КонецЕсли;
								ТекИндекс = ТекИндекс + 1;
							КонецЦикла;
							ОсуществитьПеремещение(Документ, Неопределено, ПервыйПривязанныйДокумент, ПоследнийПривязанныйДокумент, 1);
							ВыполненоПеремещение = Истина;
						КонецЕсли;
						ТекИндекс  = ТекИндекс - 1;
					КонецЦикла;
				КонецЦикла;
				
			КонецЕсли;
			ОбновитьПеренумероватьДерево(Истина, );
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если СуществуютАкты Тогда 
		Возврат;
	КонецЕсли;
	
	Если Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.Ресурсный") Тогда
		Если НЕ ЗначениеЗаполнено(объект.ДатаТекущихЦен) Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не заполнено поле ""Дата текущих цен""'"));
			отказ = истина;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(объект.ВариантРасчетаЗМ) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не заполнено поле ""Вариант расчета ЗМ""'"));
			отказ = истина;
		КонецЕсли;	
	ИначеЕсли Объект.МетодРасчета =  ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") Тогда
		Если Элементы.ВариантПересчетаЭММ.Видимость Тогда
			Если НЕ ЗначениеЗаполнено(объект.ВариантПересчетаЭММ) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не заполнено поле ""Вариант расчета ЭММ""'"));
				отказ = истина;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.МетодикаРасчета) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не заполнено поле ""Методика расчета""'"));
		Отказ = истина;
	КонецЕсли;	

	ЗаполнитьСоставСметыПоШаблону = Не ЗначениеЗаполнено(Объект.Ссылка) И (ЗначениеЗаполнено(Объект.ШаблонСметы) ИЛИ ЗначениеЗаполнено(Объект.ШаблонРазделовСметы));
	
КонецПроцедуры

&НаСервере
