&НаКлиенте
Процедура ЛимитированныеЗатратыФормулаЛимЗатратыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЛимитированныеЗатраты.ТекущиеДанные;
	ТекЗначение = ТекущиеДанные.ЗначениеЛимЗатраты;
	ТекФормула = СокрЛП(ТекущиеДанные.ФормулаЛимЗатраты);
	Если ТекФормула <> "" Тогда
		ТекФормула = СтрЗаменить(ТекФормула,",",".");
		ТекущиеДанные.ФормулаЛимЗатраты = ТекФормула;
		Попытка
			Формула = "ТекЗначение = " + ТекущиеДанные.ФормулаЛимЗатраты + "; ТекущиеДанные.ЗначениеЛимЗатраты = ТекЗначение;";
			Выполнить(Формула);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Ошибка в формуле, значение затраты не изменено'"));
		КонецПопытки;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЛимитированныеЗатратыФормулаБазисногоЗначениеЛимЗатратыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЛимитированныеЗатраты.ТекущиеДанные;
	ТекЗначение = ТекущиеДанные.БазисноеЗначениеЛимЗатраты;
	ТекФормула = СокрЛП(ТекущиеДанные.ФормулаБазисногоЗначениеЛимЗатраты);
	Если ТекФормула <> "" Тогда
		ТекФормула = СтрЗаменить(ТекФормула,",",".");
		ТекущиеДанные.ФормулаБазисногоЗначениеЛимЗатраты = ТекФормула;
		Попытка
			Формула = "ТекЗначение = " + ТекущиеДанные.ФормулаБазисногоЗначениеЛимЗатраты + "; ТекущиеДанные.БазисноеЗначениеЛимЗатраты = ТекЗначение;";
			Выполнить(Формула);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Ошибка в формуле, значение затраты не изменено'"));
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЛимитированныеЗатратыЗначениеЛимЗатратыПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ЛимитированныеЗатраты.ТекущиеДанные;
	ТекЗначение = ТекущиеДанные.ЗначениеЛимЗатраты;
	ТекФормула = СокрЛП(ТекущиеДанные.ФормулаЛимЗатраты);
	Если ТекФормула <> "" Тогда
		ТекФормула = СтрЗаменить(ТекФормула,",",".");
		ТекущиеДанные.ФормулаЛимЗатраты = ТекФормула;
		РассчитанноеЗначение = 0;
		Попытка
			Формула = "РассчитанноеЗначение = " + ТекущиеДанные.ФормулаЛимЗатраты;
			Выполнить(Формула);
			Если ТекЗначение <>  РассчитанноеЗначение Тогда
				ПоказатьПредупреждение(,НСтр("ru= 'Значение затраты отличается от рассчитанного по формуле!'"));
			КонецЕсли;	
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Ошибка в формуле, проверьте формулу'"));
		КонецПопытки;
	КонецЕсли;		
КонецПроцедуры

