	|ИЗ
	|	Документ.СМ_ОбъектнаяСмета.ЛокальныеСметы КАК СМ_ОбъектнаяСметаЛокальныеСметы
	|ГДЕ
	|	СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета = &ЛокальнаяСмета
	|	И СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка.Проведен = ИСТИНА";
	Запрос.УстановитьПараметр("ЛокальнаяСмета",Объект.Ссылка);
	Результат = Запрос.Выполнить();
	Возврат Не Результат.Пустой();
КонецФункции

&НаКлиенте
Процедура ОбновитьИндексы(Команда)
	Если Объект.АвтозагрузкаИндексов И ЗначениеЗаполнено(Объект.Ссылка) И ЗначениеЗаполнено(Объект.ФайлСборникаКоэффициентов) Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьИндексыПоСмете", ЭтаФорма, Новый Структура);
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru='Обновить все индексы по смете (смета будет записана)?'"), РежимДиалогаВопрос.ДаНет,0,,"Внимание");	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТекЦены(Команда)
	Если Объект.АвтозагрузкаЦен И ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьТекущиеЦеныПоСмете", ЭтаФорма, Новый Структура);
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru='Обновить все цены на ресурсы по смете (смета будет записана)?'"), РежимДиалогаВопрос.ДаНет,0,,"Внимание");	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВходитВСметуНажатие(Элемент, СтандартнаяОбработка)
	Если ТипЗнч(Объект.ИДРодителя) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		Пар = Новый Структура("Ключ", Объект.ИДРодителя);
		ОткрытьФорму("Документ.СМ_ОбъектнаяСмета.ФормаОбъекта",Пар,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		СтандартнаяОбработка = Ложь;	
	ИначеЕсли ТипЗнч(Объект.ИДРодителя) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		Пар = Новый Структура("Ключ", Объект.ИДРодителя);
		ОткрытьФорму("Документ.СМ_СводнаяСмета.ФормаОбъекта",Пар,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		СтандартнаяОбработка = Ложь;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СтатусПриИзменении(Элемент)
	Если Объект.Статус = ПредопределенноеЗначение("Перечисление.СМ_СтатусыСметныхДокументов.Согласован") И Не Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	КонецЕсли;
	ВидимостьДоступностьЭлементовНаФорме();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЛСПередНачаломИзменения(Элемент, Отказ)
	ТекЭлем 	= Элементы.ДеревоЛС.ТекущийЭлемент;
	Если ТекЭлем.Имя = "ДеревоЛСКол" Тогда
		ТекДанные 	= Элемент.ТекущиеДанные.Элемент;
		Если Не ТипЗнч(ТекДанные) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	ИначеЕсли СтрНайти(ТекЭлем.Имя,"ДопРеквизит_")>0 Тогда
		ТекДанные 	= Элемент.ТекущиеДанные.Элемент;
		Если ТипЗнч(ТекДанные) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьПоСтроке(Команда)
	
	ТекущиеДанные = Элементы.ДеревоЛС.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	Иначе
		Если ТипЗнч(ТекущиеДанные.Элемент) <> Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") 
			И ТипЗнч(ТекущиеДанные.Элемент) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Состояние(НСтр("ru='Необходимо выделить раздел или позицию'"),100,"",БиблиотекаКартинок.Предупреждение32);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	//ПараметрыОткрытия = Новый  Структура;
	//ПараметрыОткрытия.Вставить("ВыбраннаСмета"	, Объект.Ссылка);
	//ПараметрыОткрытия.Вставить("ТекущийЭлемент"		, ТекущиеДанные.Элемент);
	//ПараметрыОткрытия.Вставить("ПоУмолчаниюДействие", "Копировать");
	
	ПараметрыОткрытия = Новый  Структура;
	ПараметрыОткрытия.Вставить("ТекущийДокумент"	, Объект.Ссылка);
	ПараметрыОткрытия.Вставить("ТекущийЭлемент"		, ТекущиеДанные.Элемент);
	ПараметрыОткрытия.Вставить("ПоУмолчаниюДействие", "Копировать");
	
	ОткрытьФорму("Обработка.СМ_ГрупповаяОбработкаПозиций.Форма.Форма", ПараметрыОткрытия);

КонецПроцедуры

&НаКлиенте
Процедура СкопироватьВБуфер(Команда)
	Если Элементы.ДеревоЛС.ВыделенныеСтроки.Количество() > 1 Тогда
		МассивЭлементов = Новый Массив;
		Для Каждого ИдентификаторСтроки Из Элементы.ДеревоЛС.ВыделенныеСтроки Цикл
			ВыделеннаяСтрока = ДеревоЛС.НайтиПоИдентификатору(ИдентификаторСтроки);
			Элемент = ВыделеннаяСтрока.Элемент;
			Если ТипЗнч(Элемент) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				Состояние(НСтр("ru='Необходимо выделить только позиции'"),100,"",БиблиотекаКартинок.Предупреждение32);
				Возврат;
			КонецЕсли;
			МассивЭлементов.Добавить(Элемент);
		КонецЦикла;
		ДопПараметры = Новый Структура("Элемент,КопироватьПодчиненные",МассивЭлементов,Ложь);
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаБуфер", ЭтаФорма, ДопПараметры);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Копировать привязанные позиции?';"
		+ " en = 'Do you want to continue?'"), Режим, 0);
	Иначе
		ТекущаяСтрока = Элементы.ДеревоЛС.ТекущаяСтрока;
		ТекущиеДанные = Элементы.ДеревоЛС.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		Иначе
			Если ТипЗнч(ТекущиеДанные.Элемент) <> Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") 
				И ТипЗнч(ТекущиеДанные.Элемент) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				Состояние(НСтр("ru='Необходимо выделить раздел или позицию'"),100,"",БиблиотекаКартинок.Предупреждение32);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ДопПараметры = Новый Структура("Элемент,КопироватьПодчиненные",ТекущиеДанные.Элемент,Ложь);
		Если ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаБуфер", ЭтаФорма, ДопПараметры);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Копировать раздел со всеми позициями?';"
			+ " en = 'Do you want to continue?'"), Режим, 0);
		ИначеЕсли ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")
			И СМ_СметаВызовСервера.ЕстьПривязанныеПозиции(ТекущиеДанные.Элемент)Тогда
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаБуфер", ЭтаФорма, ДопПараметры);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Копировать привязанные позиции?';"
			+ " en = 'Do you want to continue?'"), Режим, 0);
		Иначе
			СкопироватьВБуферСервер(ДопПараметры);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаБуфер(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ДопПараметры.КопироватьПодчиненные = Истина;
	КонецЕсли;
	СкопироватьВБуферСервер(ДопПараметры);

КонецПроцедуры

&НаСервере
Процедура СкопироватьВБуферСервер(СтруктураБуфера)
	Дерево = РеквизитФормыВЗначение("ДеревоЛС");
	Буфер = ПоместитьВоВременноеХранилище(СтруктураБуфера,Новый УникальныйИдентификатор());
	ОбщегоНазначения.СкопироватьВБуферОбмена(Дерево,Буфер);
КонецПроцедуры

&НаКлиенте
Процедура ВставитьИзБуфера(Команда)
	
	ТекущаяСтрока = Элементы.ДеревоЛС.ТекущаяСтрока;
	ТекущиеДанные = Элементы.ДеревоЛС.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗапретитьВставку = ЗапретВставки();

	Если ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") ИЛИ
		 ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") ИЛИ
		 ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		ИдентификаторВерхнейСтроки = ПолучитьНомерВДереве(ТекущиеДанные.Элемент);
	Иначе
		// ИдентификаторВерхнейСтроки = -1;
		Состояние(НСтр("ru='Необходимо выделить раздел, позицию или локальную смету'"),100,"",БиблиотекаКартинок.Предупреждение32);
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		НовыйРодитель = ДеревоЛС.НайтиПоИдентификатору(Элементы.ДеревоЛС.ТекущаяСтрока).ИДРодителя;
	Иначе
		НовыйРодитель = ТекущиеДанные.Элемент;
	КонецЕсли;
	
	НужноВыбрать = ПроверкаНаПозициюРесурс();
	Если НужноВыбрать Тогда
		Если ЗапретитьВставку И ПозицияНеПодходит(ТекущиеДанные.Элемент) Тогда
			Состояние(НСтр("ru='Необходимо выделить позицию-работу'"),100,"",БиблиотекаКартинок.Предупреждение32);
			Возврат;
		ИначеЕсли Не ЗапретитьВставку Тогда
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаВставкаБуфер", ЭтаФорма,Новый Структура("ТекущаяСтрока,НовыйРодитель,ПозицияВладелец",ТекущаяСтрока,НовыйРодитель,ТекущиеДанные.Элемент));
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Привязать позицию?';"
			+ " en = 'Do you want to continue?'"), Режим, 0);
		Иначе
			ПослеЗакрытияВопросаВставкаБуфер(КодВозвратаДиалога.Да, Новый Структура("ТекущаяСтрока,НовыйРодитель,ПозицияВладелец",ТекущаяСтрока,НовыйРодитель,ТекущиеДанные.Элемент));
		КонецЕсли;
	Иначе
		ПослеЗакрытияВопросаВставкаБуфер(КодВозвратаДиалога.Нет, Новый Структура("ТекущаяСтрока,НовыйРодитель,ПозицияВладелец",ТекущаяСтрока,НовыйРодитель,Неопределено));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаВставкаБуфер(Результат, ДопПараметры) Экспорт
	ПозицияВладелец = Неопределено;
	ТекущаяСтрока = ДопПараметры.ТекущаяСтрока;
	НовыйРодитель = ДопПараметры.НовыйРодитель;
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПозицияВладелец = ДопПараметры.ПозицияВладелец;	
		Если ПозицияНеПодходит(ПозицияВладелец) Тогда
			Состояние(НСтр("ru='Необходимо выделить позицию-работу'"),100,"",БиблиотекаКартинок.Предупреждение32);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Элемент = ВставитьИзБуфераСервер(ТекущаяСтрока,НовыйРодитель,ПозицияВладелец);
	Если ТипЗнч(Элемент) = Тип("СправочникСсылка.СМ_НормативныеСборники")
		ИЛИ ТипЗнч(Элемент) = Тип("СправочникСсылка.СМ_Ресурсы") Тогда
		ЗаголовокПодбора = ОпределитьЗаголовок(Элемент);
		Оповещение = Новый ОписаниеОповещения("ПослеВводаКоличества", ЭтотОбъект,Новый Структура("СсылкаЭлемент,ТекРаздел,ПозицияВладелец",Элемент,НовыйРодитель,ПозицияВладелец));
		ПоказатьВводЧисла(Оповещение, 0, ЗаголовокПодбора, 15, 5);
	Иначе
		ОбновитьПеренумероватьДерево(Истина, Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверкаНаПозициюРесурс()
	
	ЕстьПривязанные = Ложь;
	Результат 	= ОбщегоНазначения.СтрокиИзБуфераОбмена();
	Данные		= Результат.Данные;
	Если ТипЗнч(Данные) = Тип("ДеревоЗначений") Тогда
		Дерево 		= Данные;
		Источник 	= ПолучитьИзВременногоХранилища(Результат.Источник);
		Если ТипЗнч(Источник.Элемент) = Тип("Массив") Тогда
			Для Каждого Элемент Из Источник.Элемент Цикл
				Если ЗначениеЗаполнено(Элемент.ИДПозицииВладельца) Тогда
					Если Источник.Элемент.Найти(Элемент.ИДПозицииВладельца) = Неопределено Тогда
						ЕстьПривязанные = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		Иначе
			ЭлементКопирования = Источник.Элемент;
			Если ТипЗнч(ЭлементКопирования) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")
				И ЗначениеЗаполнено(ЭлементКопирования.ИДПозицииВладельца) Тогда
				ЕстьПривязанные = Истина;
			КонецЕсли;
		КонецЕсли;
		Возврат ЕстьПривязанные;
	ИначеЕсли Данные = "РЕСУРС" Тогда
		Возврат Истина;
	ИначеЕсли Данные = "НС" Тогда
		ТекЭлемент = ПолучитьИзВременногоХранилища(Результат.Источник);
		Если ТекЭлемент.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал Тогда
			Возврат Истина;
		Иначе	
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

КонецФункции

&НаСервере
Функция ВставитьИзБуфераСервер(ТекущаяСтрока,НовыйРодитель,ПозицияВладелец = Неопределено)
	
	Результат 	= ОбщегоНазначения.СтрокиИзБуфераОбмена();
	Данные		= Результат.Данные;
	НомерВДереве = ИдентификаторВерхнейСтроки;
	Если ТипЗнч(Данные) = Тип("ДеревоЗначений") Тогда
		Дерево 		= Данные;
		Источник 	= ПолучитьИзВременногоХранилища(Результат.Источник);
		Если ТипЗнч(Источник.Элемент) = Тип("Массив") Тогда
			
			// **********************************************************
			// Попытка вставки в корень сметы
			Если ТипЗнч(НовыйРодитель) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			    Сообщение 		= Новый СообщениеПользователю();
			    Сообщение.Текст = "Необходимо выделить раздел или позицию!";
			    Сообщение.Сообщить();
				Возврат НовыйРодитель;	
			КонецЕсли;
			// **********************************************************
			
			Если Не ПозицияВладелец = Неопределено Тогда
				
				Для Каждого Элемент Из Источник.Элемент Цикл
					
					Если Не ЗначениеЗаполнено(Элемент.ИДПозицииВладельца) Тогда
						Продолжить;
					КонецЕсли;
					
					Если Не Источник.Элемент.Найти(Элемент.ИДПозицииВладельца) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					// *********************************************
					// ++ AVV Роли в системе
	                // Проверка на соответствие объекта строительства и наличия необходимой роли
					//РезультатПроверки = ПроверкаСтройкиПриВставке(Элемент);
					//Если НЕ РезультатПроверки Тогда
					//	Продолжить;
					//КонецЕсли;
					// -- AVV Роли в системе
					// *********************************************	
	
					НомерВДереве 		= НомерВДереве+0.01;
					СтрокаДерева 		= Дерево.Строки.Найти(Элемент,"Элемент",Истина); 
					ЭлементКопирования 	= Элемент;
					
					НоваяПозиция = СМ_СметаВызовСервера.СоздатьНовуюПозицию();
					СМ_СметаВызовСервера.СкопироватьПозицию(НоваяПозиция, ЭлементКопирования,Истина);
					СМ_СметаВызовСервера.ЗаменитьРодителя(НовыйРодитель, НоваяПозиция);
					НоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Скопирована;
					НоваяПозиция.ИсточникСоздания	= ЭлементКопирования.Номер;
					НоваяПозиция.ДополнительныеСвойства.Вставить("Смета3");
					НоваяПозиция.ИДПозицииВладельца = ПозицияВладелец;
					НоваяПозиция.Записать();
					СМ_СметаВызовСервера.УстановитьНомерДокумента(НоваяПозиция.Ссылка, , , НомерВДереве, , "СМ_ПозицияЛокальнойСметы");
					
				КонецЦикла;
				
			КонецЕсли;
			
			ПерваяПозиция = Неопределено;
			
			Для Каждого Элемент Из Источник.Элемент Цикл
				
				Если ЗначениеЗаполнено(Элемент.ИДПозицииВладельца) Тогда
					Продолжить;
				КонецЕсли;
				
				// *********************************************
				// ++ AVV Роли в системе
				// Проверка на соответствие объекта строительства и наличия необходимой роли
				//РезультатПроверки = ПроверкаСтройкиПриВставке(Элемент);
				//Если НЕ РезультатПроверки Тогда
				//	Продолжить;
				//КонецЕсли;
				// -- AVV Роли в системе
				// *********************************************
				
				НомерВДереве 		= НомерВДереве+0.01;
				СтрокаДерева 		= Дерево.Строки.Найти(Элемент,"Элемент",Истина); 
				ЭлементКопирования 	= Элемент;
				
				Если Источник.КопироватьПодчиненные Тогда
					ОбъектыКопирования = Новый Массив;
					ПривязанныеПозиции = СМ_СметаВызовСервера.ПолучитьПривязанныеПозиции(ЭлементКопирования);
					Для Каждого ЭлСтрока Из ПривязанныеПозиции Цикл
						ОбъектыКопирования.Добавить(ЭлСтрока.Ссылка);
					КонецЦикла;	
				КонецЕсли;
				
				НоваяПозиция = СМ_СметаВызовСервера.СоздатьНовуюПозицию();
				СМ_СметаВызовСервера.СкопироватьПозицию(НоваяПозиция, ЭлементКопирования,Истина);
				СМ_СметаВызовСервера.ЗаменитьРодителя(НовыйРодитель, НоваяПозиция);
				НоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Скопирована;
				НоваяПозиция.ИсточникСоздания	= ЭлементКопирования.Номер;
				НоваяПозиция.ДополнительныеСвойства.Вставить("Смета3");
				НоваяПозиция.Записать();
				СМ_СметаВызовСервера.УстановитьНомерДокумента(НоваяПозиция.Ссылка,,,НомерВДереве,,"СМ_ПозицияЛокальнойСметы");
					
				Если Источник.КопироватьПодчиненные Тогда
					СМ_СметаВызовСервера.СкопироватьПривязанныеПозиции(ОбъектыКопирования,НоваяПозиция.Ссылка);
				КонецЕсли;
				Если ПерваяПозиция = Неопределено Тогда
					ПерваяПозиция = НоваяПозиция.Ссылка;
				КонецЕсли;
			КонецЦикла;
			
			Возврат ПерваяПозиция;
		Иначе
			
			// *********************************************
			// ++ AVV Роли в системе
			// Проверка на соответствие объекта строительства и наличия необходимой роли
			//РезультатПроверки = ПроверкаСтройкиПриВставке(Источник.Элемент);
			//Если НЕ РезультатПроверки Тогда
			//	Возврат Неопределено;
			//КонецЕсли;
			// -- AVV Роли в системе
			// *********************************************	
			
			НомерВДереве 		= НомерВДереве+0.01;
			СтрокаДерева 		= Дерево.Строки.Найти(Источник.Элемент,"Элемент",Истина); 
			ЭлементКопирования 	= Источник.Элемент;
			
			ОбъектыКопирования = Новый Массив;
			Если Источник.КопироватьПодчиненные Тогда
				ОбъектыКопирования = ПолучитьОтмеченныеОбъекты(СтрокаДерева.Строки,ОбъектыКопирования);
			КонецЕсли;
			
			Если ТипЗнч(ЭлементКопирования) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")
				И Источник.КопироватьПодчиненные Тогда
				ПривязанныеПозиции = СМ_СметаВызовСервера.ПолучитьПривязанныеПозиции(ЭлементКопирования);
				Для Каждого ЭлСтрока Из ПривязанныеПозиции Цикл
					ОбъектыКопирования.Добавить(ЭлСтрока.Ссылка);
				КонецЦикла;	
			КонецЕсли;
			
			Если ТипЗнч(ЭлементКопирования) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
				НомерПоПорядкуРаздел = СМ_СметныйСоставВызовСервера.ПолучитьМаксимальныйНомерВДереве(?(ТипЗнч(НовыйРодитель) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"),НовыйРодитель,НовыйРодитель.ИДСметы));
				НомерПоПорядку       = СМ_СметныйСоставВызовСервера.ПолучитьМаксимальныйНомерВДереве(?(ТипЗнч(НовыйРодитель) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"),НовыйРодитель,НовыйРодитель.ИДСметы));
				
				НовыйРаздел = СМ_СметаВызовСервера.СоздатьНовыйРаздел();
				СМ_СметаВызовСервера.СкопироватьРаздел(НовыйРаздел, ЭлементКопирования);
				НовыйРаздел.ДополнительныеСвойства.Вставить("Смета3"); 
				НомерПоПорядкуРаздел = НомерПоПорядкуРаздел + 1;
				СМ_СметаВызовСервера.ЗаменитьРодителя(НовыйРодитель, НовыйРаздел);
				НовыйРаздел.Записать();
				СМ_СметаВызовСервера.УстановитьНомерДокумента(НовыйРаздел.Ссылка, НомерПоПорядкуРаздел, , , , "СМ_РазделЛокальнойСметы");
								
				Если Источник.КопироватьПодчиненные Тогда
					СМ_СметаВызовСервера.СкопироватьОбъекты(ОбъектыКопирования,НовыйРаздел.Ссылка,ЭлементКопирования);
				КонецЕсли;
				
				Возврат НовыйРаздел.Ссылка;
			Иначе
				
				// **********************************************************
				// Попытка вставки в корень сметы
				Если ТипЗнч(НовыйРодитель) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
				    Сообщение 		= Новый СообщениеПользователю();
				    Сообщение.Текст = "Невозможно скопировать позиции без разделов в корень локальной сметы";
				    Сообщение.Сообщить();
					Возврат НовыйРодитель;	
				КонецЕсли;
				// **********************************************************
			
				НоваяПозиция = СМ_СметаВызовСервера.СоздатьНовуюПозицию();
				СМ_СметаВызовСервера.СкопироватьПозицию(НоваяПозиция, ЭлементКопирования,Истина);
				СМ_СметаВызовСервера.ЗаменитьРодителя(НовыйРодитель, НоваяПозиция);
				НоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Скопирована;
				НоваяПозиция.ИсточникСоздания	= ЭлементКопирования.Номер;
				НоваяПозиция.ДополнительныеСвойства.Вставить("Смета3");
				
				Если ЗначениеЗаполнено(ЭлементКопирования.ИДПозицииВладельца)
					И Не ПозицияВладелец = Неопределено Тогда
					НоваяПозиция.ИДПозицииВладельца = ПозицияВладелец;
				КонецЕсли;

				НоваяПозиция.Записать();
				СМ_СметаВызовСервера.УстановитьНомерДокумента(НоваяПозиция.Ссылка, , , НомерВДереве, , "СМ_ПозицияЛокальнойСметы");
								
				Если Источник.КопироватьПодчиненные Тогда
					СМ_СметаВызовСервера.СкопироватьПривязанныеПозиции(ОбъектыКопирования,НоваяПозиция.Ссылка);
				КонецЕсли;
				
				Возврат НоваяПозиция.Ссылка;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Данные = "НС" ИЛИ Данные = "РЕСУРС" Тогда
		Источник = ПолучитьИзВременногоХранилища(Результат.Источник);
		Возврат Источник;
	КонецЕсли;

КонецФункции

&НаСервере
