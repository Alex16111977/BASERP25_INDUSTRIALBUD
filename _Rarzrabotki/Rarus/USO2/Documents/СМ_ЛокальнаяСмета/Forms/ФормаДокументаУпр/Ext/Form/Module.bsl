&НаСервере
Функция ПолучитьДеревоРазделов()

	ТекДеревоРазделов = Новый ДеревоЗначений; 
	ТекДеревоРазделов.Колонки.Добавить("Раздел");
	ТекДеревоРазделов.Колонки.Добавить("КлючСтроки");
	
	ТекДеревоЛС 	= РеквизитФормыВЗначение("ДеревоЛС");
	КоллекцияСтрок 	= ТекДеревоЛС.Строки;
	ТекРодитель 	= Неопределено;
	ПостроениеДереваРазделов(КоллекцияСтрок,ТекДеревоРазделов,Неопределено);
	
	ХранилищеДерева = Новый ХранилищеЗначения(ТекДеревоРазделов);
	
	Возврат ХранилищеДерева;
	
КонецФункции

&НаСервере
Процедура ПостроениеДереваРазделов(КоллекцияСтрок,ТекДеревоРазделов,ТекРодитель)

	Для Каждого ТекСтрока Из КоллекцияСтрок Цикл
		
		НоваяСтрока = Неопределено;
		
		Если ТипЗнч(ТекСтрока.Элемент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			
			Если ТекРодитель <> Неопределено Тогда
				НоваяСтрока = ТекРодитель.Строки.Добавить();	
			Иначе
				НоваяСтрока = ТекДеревоРазделов.Строки.Добавить();	
			КонецЕсли;
			
			НоваяСтрока.Раздел  	= ТекСтрока.Элемент.Раздел;
			НоваяСтрока.КлючСтроки  = ТекСтрока.НомерПП;
			
		КонецЕсли;		
				
		ПодчиненныеСтроки = ТекСтрока.Строки;
		Если ПодчиненныеСтроки.Количество() > 0 Тогда
			ПостроениеДереваРазделов(ПодчиненныеСтроки,ТекДеревоРазделов,НоваяСтрока);	
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура СоздатьШаблон(Команда)
	
	ХранилищеДерева 	= ПолучитьДеревоРазделов();
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДеревоРазделов",ХранилищеДерева);
	СтруктураПараметров.Вставить("Смета",Объект.Ссылка);
	ТекФорма = ОткрытьФорму("Справочник.СМ_ШаблоныСмет.ФормаОбъекта",СтруктураПараметров,ЭтаФорма);

КонецПроцедуры

