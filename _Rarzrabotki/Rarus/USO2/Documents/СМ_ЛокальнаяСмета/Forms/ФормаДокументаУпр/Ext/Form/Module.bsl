	Для Каждого ЭлСтрока Из СтрокаДерева Цикл
		МассивОбъектов.Добавить(ЭлСтрока.Элемент);
		рез = получитьОтмеченныеОбъекты(ЭлСтрока.Строки,массивОбъектов);
	КонецЦикла;	
	
	Возврат массивОбъектов;
	
КонецФункции	

