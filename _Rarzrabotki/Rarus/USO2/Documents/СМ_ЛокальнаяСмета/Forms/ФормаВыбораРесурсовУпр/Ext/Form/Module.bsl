#Область Переменные

Перем МассивПозиций;
&НаСервере
Перем ТаблицаРесурсов;

#КонецОбласти

#Область События

&НаКлиенте
Процедура Ок(Команда)
		
	ВыбранныеРесурсы = ПолучитьПараметрыЗакрытияФормы();
		
	ЭтаФорма.Закрыть(ВыбранныеРесурсы);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыЗакрытияФормы()
	
	ТаблицаРесурсов = ЗначениеИзСтрокиВнутр(ТаблицаРесурсовСтр);
	ТаблицаРесурсов.Колонки.Добавить("НовыйРесурс");
	ТаблицаРесурсов.Колонки.Добавить("ЕдиницаИзмерения");
	// Если Это Прайсы, то нужно добавить признак и определитель, тип Норм Сборника.
	ТаблицаРесурсов.Колонки.Добавить("Определитель");
	ТаблицаРесурсов.Колонки.Добавить("ФлПрайс");
	ТаблицаРесурсов.Колонки.Добавить("НормСборник");
	ТаблицаРесурсов.Колонки.Добавить("Измеритель");
	ТаблицаРесурсов.Колонки.Добавить("Прайс");
	ТаблицаРесурсов.Колонки.Добавить("ПереноситьПоправки");
	ТаблицаРесурсов.Колонки.Добавить("ПереноситьЧП");
	ТаблицаРесурсов.Колонки.Добавить("ПереноситьПримечания");

	Ресурсы = Новый Массив;
	
	
	Дерево = РеквизитФормыВЗначение("ДеревоРесурсов", Тип("ДеревоЗначений"));
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		Для Каждого СтрокаРесурса Из СтрокаДерева.Строки Цикл			
			Если НЕ СтрокаРесурса.Выбран Тогда
				Продолжить;
			КонецЕсли;
			// ДокторСофт
			Если СтрокаРесурса.Индекс = -1 Тогда
				СтрокаПозиции = ТаблицаРесурсов.Найти(СтрокаДерева.Значение,"Позиция");
				НоваяСтрока =  ТаблицаРесурсов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаПозиции,"ТипМатериала,Позиция,ВидРесурса");
				НоваяСтрока.Ресурс = СтрокаРесурса.Ресурс;
				Если ТипЗнч(СтрокаРесурса.Ресурс)<>Тип("СправочникСсылка.СМ_Ресурсы") Тогда
					НоваяСтрока.НовыйРесурс = СтрокаРесурса.Ресурс;
					НоваяСтрока.ЕдиницаИзмерения = СтрокаРесурса.ЕдиницаИзмерения;
					Если СтрокаРесурса.ФлПрайс = Истина Тогда
						НоваяСтрока.флПрайс = Истина;
						НоваяСтрока.Измеритель = СтрокаРесурса.Измеритель;
						НоваяСтрока.НормСборник = СтрокаРесурса.НормСборник;
						НоваяСтрока.Прайс = СтрокаРесурса.Прайс;
						НоваяСтрока.ПереноситьПоправки = СтрокаРесурса.ПереноситьПоправки;
						НоваяСтрока.ПереноситьЧП = СтрокаРесурса.ПереноситьЧП;
						НоваяСтрока.ПереноситьПримечания = СтрокаРесурса.ПереноситьПримечания;
					КонецЕсли;	

				КонецЕсли;
				НоваяСтрока.СметныйКодРесурса = ?(ТипЗнч(СтрокаРесурса.Ресурс)=Тип("СправочникСсылка.СМ_Ресурсы"),СтрокаРесурса.Ресурс.Код,СтрокаРесурса.ШифрРасценки);
				НоваяСтрока.ТекущаяЦена = СтрокаРесурса.ТекущаяЦена;
				НоваяСтрока.БазиснаяЦена = СтрокаРесурса.БазиснаяЦена;
				НоваяСтрока.ТекущаяЗарплатаМашинистов = СтрокаРесурса.ТекущаяЗарплатаМашинистов;
				НоваяСтрока.БазиснаяЗарплатаМашинистов = СтрокаРесурса.БазиснаяЗарплатаМашинистов;
				НоваяСтрока.НормаРасхода = СтрокаРесурса.НормаРасхода;
				НоваяСтрока.НеИндексировать = СтрокаРесурса.НеИндексировать;
				НоваяСтрока.ФлагОборудование = СтрокаРесурса.ФлагОборудование;
				НоваяСтрока.ВидРесурса = СтрокаРесурса.ВидРесурса;
				НоваяСтрока.Определитель = СтрокаРесурса.Определитель;
				Ресурсы.Добавить(НоваяСтрока);
			Иначе
				Если СтрокаРесурса.НоваяСтрока Тогда
					НайденнаяСтрока = ТаблицаРесурсов.Добавить();
					СтрокаПозиции = ТаблицаРесурсов.Найти(СтрокаДерева.Значение,"Позиция");
					ЗаполнитьЗначенияСвойств(НайденнаяСтрока,СтрокаПозиции,"ТипМатериала,Позиция,ВидРесурса");
				Иначе
					НайденнаяСтрока = ТаблицаРесурсов.Получить(СтрокаРесурса.Индекс);
				КонецЕсли;
				НайденнаяСтрока.Ресурс = СтрокаРесурса.Ресурс;
				Если ТипЗнч(СтрокаРесурса.Ресурс)<>Тип("СправочникСсылка.СМ_Ресурсы") Тогда
					НайденнаяСтрока.НовыйРесурс = СтрокаРесурса.Ресурс;
					НайденнаяСтрока.ЕдиницаИзмерения = СтрокаРесурса.ЕдиницаИзмерения;
					Если СтрокаРесурса.ФлПрайс = Истина Тогда
						НайденнаяСтрока.флПрайс = Истина;
						НайденнаяСтрока.Измеритель= СтрокаРесурса.Измеритель;
						НайденнаяСтрока.НормСборник = СтрокаРесурса.НормСборник;
						НайденнаяСтрока.Прайс = СтрокаРесурса.Прайс;
						НайденнаяСтрока.ПереноситьПоправки = СтрокаРесурса.ПереноситьПоправки;
						НайденнаяСтрока.ПереноситьЧП = СтрокаРесурса.ПереноситьЧП;
						НайденнаяСтрока.ПереноситьПримечания = СтрокаРесурса.ПереноситьПримечания;
					КонецЕсли;	

				КонецЕсли;
				НайденнаяСтрока.СметныйКодРесурса = ?(ТипЗнч(СтрокаРесурса.Ресурс)=Тип("СправочникСсылка.СМ_Ресурсы"),СтрокаРесурса.Ресурс.Код,СтрокаРесурса.ШифрРасценки);
				НайденнаяСтрока.ТекущаяЦена = СтрокаРесурса.ТекущаяЦена;
				НайденнаяСтрока.БазиснаяЦена = СтрокаРесурса.БазиснаяЦена;
				НайденнаяСтрока.ТекущаяЗарплатаМашинистов = СтрокаРесурса.ТекущаяЗарплатаМашинистов;
				НайденнаяСтрока.БазиснаяЗарплатаМашинистов = СтрокаРесурса.БазиснаяЗарплатаМашинистов;
				НайденнаяСтрока.НормаРасхода = СтрокаРесурса.НормаРасхода;
				НайденнаяСтрока.НеИндексировать = СтрокаРесурса.НеИндексировать;
				НайденнаяСтрока.ФлагОборудование = СтрокаРесурса.ФлагОборудование;
				НайденнаяСтрока.ВидРесурса = СтрокаРесурса.ВидРесурса;
				НайденнаяСтрока.Определитель = СтрокаРесурса.Определитель;
				Ресурсы.Добавить(НайденнаяСтрока);
			
			КонецЕсли;
			// ДокторСофт
		КонецЦикла;
	КонецЦикла;
	
	
	АдресВХранилищеРесурсы = ПоместитьВоВременноеХранилище(Ресурсы, Новый УникальныйИдентификатор());
	
	Если Ресурсы.Количество() > 0 Тогда
		ВыбранныеРесурсы = Новый Структура("Ресурсы", АдресВХранилищеРесурсы);
	Иначе
		ВыбранныеРесурсы = Неопределено;
	КонецЕсли;
	
	Возврат ВыбранныеРесурсы;
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	Если Не Параметры.Свойство("Параметры") Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Параметры.Параметры.СтруктураПараметров) = Тип("Массив") Тогда
		
		Для каждого ЭлМассива Из  Параметры.Параметры.СтруктураПараметров Цикл
			ВремТабл = ПолучитьИзВременногоХранилища(ЭлМассива.Ресурсы);
			Если ТаблицаРесурсов = Неопределено Тогда
				ТаблицаРесурсов = ВремТабл.скопировать();
			Иначе
				Для каждого СтрокаВремТабл Из ВремТабл Цикл
					Для каждого кол Из ВремТабл.колонки Цикл
						НовСтрока = ТаблицаРесурсов.добавить();
						НовСтрока[кол.Имя] = СтрокаВремТабл[кол.имя];
					КонецЦикла;	
				КонецЦикла;
			КонецЕсли;	
		КонецЦикла;
	Иначе	
		АдресТаблицыРесурсов = Параметры.Параметры.СтруктураПараметров.Ресурсы;
		ТаблицаРесурсов = ПолучитьИзВременногоХранилища(АдресТаблицыРесурсов);
	КонецЕсли;   
	
	ВставлятьНеучтенные = СМ_СметаВызовСервера.ПолучитьНастройкуНеучтенных("ВставлятьНеучтенныеАвтоматически");	
	
	МассивПозиций = ТаблицаРесурсов.Скопировать(,"Позиция");
	МассивПозиций.Свернуть("Позиция");
	МассивПозиций = МассивПозиций.ВыгрузитьКолонку("Позиция");
	Колонки = ТаблицаРесурсов.Колонки;
	Если Колонки.Найти("НеИндексировать") = Неопределено Тогда
		Колонки.Добавить("НеИндексировать",Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	Если Колонки.Найти("ФлагОборудование") = Неопределено Тогда
		Колонки.Добавить("ФлагОборудование",Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	Дерево = РеквизитФормыВЗначение("ДеревоРесурсов", Тип("ДеревоЗначений"));
	Дерево.Строки.Очистить();
	Для Каждого СтрокаМассива Из МассивПозиций Цикл
		НайденныеСтроки = ТаблицаРесурсов.НайтиСтроки(Новый Структура("Позиция", СтрокаМассива));		
		Корень = Дерево.Строки.Добавить();
		// Корень.Выбран = ?(НайденныеСтроки[0].Пометить = Неопределено,ВставлятьНеучтенные,НайденныеСтроки[0].Пометить);
		Корень.Выбран = Истина;
		Корень.Значение = СтрокаМассива.Ссылка;
		Корень.Наименование = СтрокаМассива.Ссылка.ШифрРасценки + " " + СокрЛП(СтрокаМассива.Ссылка.Наименование)+ " [" + СокрЛП(СтрокаМассива.Ссылка.ЕдиницаИзмерения)+ "]";
		Для Каждого НайдСтрока Из НайденныеСтроки Цикл
			НоваяСтрока = Корень.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НайдСтрока);
			// НоваяСтрока.Выбран = ?(НайдСтрока.Пометить = Неопределено,ВставлятьНеучтенные,НайдСтрока.Пометить);
			НоваяСтрока.Выбран = Истина;
			НоваяСтрока.Значение = НайдСтрока.Ресурс;
			НоваяСтрока.Наименование = НайдСтрока.Ресурс.Код + " " +СокрЛП(НайдСтрока.Ресурс.Наименование) + " " + НайдСтрока.Ресурс.ЕдиницаИзмерения;
			НоваяСтрока.НеИндексировать = Истина;
			НоваяСтрока.ФлагОборудование = Ложь;
			НоваяСтрока.Индекс = ТаблицаРесурсов.Индекс(НайдСтрока);
			НоваяСтрока.БазиснаяЦена = НайдСтрока.БазиснаяЦена;
			НоваяСтрока.ТекущаяЦена = НайдСтрока.ТекущаяЦена;
			НоваяСтрока.БазиснаяЗарплатаМашинистов = НайдСтрока.БазиснаяЗарплатаМашинистов;
			НоваяСтрока.ТекущаяЗарплатаМашинистов = НайдСтрока.ТекущаяЗарплатаМашинистов;
			НоваяСтрока.ВидРесурса = НайдСтрока.ВидРесурса;
		КонецЦикла;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоРесурсов");
	ТаблицаРесурсовСтр = ЗначениеВСтрокуВнутр(ТаблицаРесурсов);	
    Элементы.ПодборРесурсаИзСборникаТекущихЦен.Видимость = Ложь;;
	Если МассивПозиций.Количество()>0 Тогда
		ИДСметы = МассивПозиций[0].ИДСметы;
		Если ЗначениеЗаполнено(ИДСметы.ФайлСборникаТекущихЦен) Тогда
			Элементы.ПодборРесурсаИзСборникаТекущихЦен.Видимость = Истина;
		КонецЕсли;
		
		Элементы.СводныеРесурсыЗаменитьРесурс.Видимость = Не ИДСметы.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_КЗ_РСНБ;
		Элементы.ДеревоРесурсовНеИндексировать.Видимость = Не ИДСметы.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРесурсовВыбранПриИзменении(Элемент)
	ТекДанные = Элементы.ДеревоРесурсов.ТекущиеДанные;
	Для Каждого СтрокаДерева Из ТекДанные.ПолучитьЭлементы() Цикл
		СтрокаДерева.Выбран = ТекДанные.Выбран;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРесурсовНеИндексироватьПриИзменении(Элемент)
	// Вставить содержимое обработчика.
	ТекДанные = Элементы.ДеревоРесурсов.ТекущиеДанные;
	Для Каждого СтрокаДерева Из ТекДанные.ПолучитьЭлементы() Цикл
		СтрокаДерева.НеИндексировать = ТекДанные.НеИндексировать;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоРесурсовФлагОборудованиеПриИзменении(Элемент)
	// Вставить содержимое обработчика.
	ТекДанные = Элементы.ДеревоРесурсов.ТекущиеДанные;
	Для Каждого СтрокаДерева Из ТекДанные.ПолучитьЭлементы() Цикл
		СтрокаДерева.ФлагОборудование = ТекДанные.ФлагОборудование;
	КонецЦикла;
	
КонецПроцедуры

// Доктор софт
&НаКлиенте
Процедура ДеревоРесурсовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если ТипЗнч(Элемент.ТекущиеДанные.Значение)<>Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		Отказ = Истина;
	КонецЕсли;
	ПозицияРесурса = Элемент.ТекущиеДанные.Значение;
КонецПроцедуры

&НаКлиенте
Процедура ПриНачалеРедактированияРесурса(Результат, Элемент) Экспорт
	
	РесурсВыб	= СМ_СметаКлиент.ПолучитьОдинРесурсИзМассива(Результат);
	
	Если Не ЗначениеЗаполнено(РесурсВыб) Тогда
		Возврат;
	КонецЕсли; 
	
	Элемент.ТекущиеДанные.Значение = РесурсВыб;
	Элемент.ТекущиеДанные.Ресурс = РесурсВыб;
	Элемент.ТекущиеДанные.Наименование = НаименованиеРесурса(РесурсВыб);
	Элемент.ТекущиеДанные.НеИндексировать = Истина;
	Элемент.ТекущиеДанные.ФлагОборудование = Ложь;
	Элемент.ТекущиеДанные.Индекс = -1;
	СтруктураЦен = Новый Структура();
	СтруктураЦен.Вставить("БазиснаяЦена");
	СтруктураЦен.Вставить("БазиснаяЗарплатаМашинистов");
	СтруктураЦен.Вставить("ТекущаяЦена");
	СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов");
	СтруктураДопПараметров = Новый Структура();
	СтруктураДопПараметров.Вставить("Район");
	СтруктураДопПараметров.Вставить("ДатаТекущихЦен");
	СтруктураДопПараметров.Вставить("ФайлСборникаТекущихЦен");
	СтруктураДопПараметров.Вставить("АвтозагрузкаЦен");
	СтруктураДопПараметров.Вставить("КодРегионаФайлаТекущихЦен");
	
	ПолучитьЦены(РесурсВыб, ПозицияРесурса, СтруктураЦен,СтруктураДопПараметров);
	Элемент.ТекущиеДанные.БазиснаяЦена = СтруктураЦен.БазиснаяЦена;
	Элемент.ТекущиеДанные.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
	Элемент.ТекущиеДанные.БазиснаяЗарплатаМашинистов = СтруктураЦен.БазиснаяЗарплатаМашинистов;
	Элемент.ТекущиеДанные.ТекущаяЗарплатаМашинистов = СтруктураЦен.ТекущаяЗарплатаМашинистов;
	Если Не СметнаяКомпонента = Неопределено Тогда
		Если СтруктураДопПараметров.АвтозагрузкаЦен = Истина И СтруктураДопПараметров.ФайлСборникаТекущихЦен <> "" Тогда
			СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(,ПозицияРесурса);
			ДанныеЦен = СметнаяКомпонента.ПолучитьТекущиеЦены(ПолучитьКодРесурса(РесурсВыб), СтруктураПараметровРасчетаЛС.КодРайона, СтруктураПараметровРасчетаЛС.КодРегионаФайлаТекущихЦен, СтруктураПараметровРасчетаЛС.ФайлСборникаТекущихЦен);
			ПолучитьЦеныВНБ(ДанныеЦен,Элемент.ТекущиеДанные.ТекущаяЦена,Элемент.ТекущиеДанные.ТекущаяЗарплатаМашинистов);
		КонецЕсли;
	КонецЕсли;
	Элемент.ТекущийЭлемент = Элементы.ДеревоРесурсов.ПодчиненныеЭлементы.ДеревоРесурсовГруппа1.ПодчиненныеЭлементы.ДеревоРесурсовНормаРасхода;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРесурсовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		Оповещение = Новый ОписаниеОповещения("ПриНачалеРедактированияРесурса", ЭтотОбъект,Элемент);
		ОткрытьФорму("Справочник.СМ_Ресурсы.Форма.ФормаВыбора",,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПолучитьЦены(РесурсВыб,ПозицияРесурса,СтруктураЦен,СтруктураДопПараметров)
	
	РесурсыПозиций = Новый ТаблицаЗначений();
	
	РесурсыПозиций.Колонки.Добавить("Позиция",Новый ОписаниеТипов("ДокументСсылка.СМ_ПозицияЛокальнойСметы"));
	РесурсыПозиций.Колонки.Добавить("Ресурс",Новый ОписаниеТипов("СправочникСсылка.СМ_Ресурсы"));
	
	Стр = РесурсыПозиций.Добавить();
	Стр.Позиция = ПозицияРесурса;
	Стр.Ресурс = РесурсВыб;
	ИДСметы = ПозицияРесурса.ИДСметы;
	СтруктураПараметровЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(ИДСметы);
	Район = СтруктураПараметровЛС.Район;
	АвтоЗагрузкаЦен = СтруктураПараметровЛС.АвтозагрузкаЦен;
	ДатаТекущихЦен = СтруктураПараметровЛС.ДатаТекущихЦен;
	РегиональнаяБаза = СтруктураПараметровЛС.РегионДляВыбораЦен;
	КодРегионаФайлаТекущихЦен = СтруктураПараметровЛС.КодРегионаФайлаТекущихЦен;
	ФайлТекущихЦен = СтруктураПараметровЛС.ФайлСборникаТекущихЦен;
	СтруктураДопПараметров.Вставить("Район",Район);
	СтруктураДопПараметров.Вставить("АвтоЗагрузкаЦен",АвтоЗагрузкаЦен);
	СтруктураДопПараметров.Вставить("ДатаТекущихЦен",ДатаТекущихЦен);
	СтруктураДопПараметров.Вставить("КодРегионаФайлаТекущихЦен",КодРегионаФайлаТекущихЦен);
	СтруктураДопПараметров.Вставить("ФайлТекущихЦен",ФайлТекущихЦен);
	ВыбиратьТекущиеЦены = Истина;
	Если ФайлТекущихЦен = ""  Тогда
		ВыбиратьТекущиеЦены = Ложь;
	КонецЕсли;
	СМ_СметаВызовСервера.ПолучитьЦеныНовогоРесурса(РесурсВыб,Район,РегиональнаяБаза,ДатаТекущихЦен,СтруктураЦен,ВыбиратьТекущиеЦены);
	БазиснаяЦена = СтруктураЦен.БазиснаяЦена;
	ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
	БазиснаяЗарплатаМашинистов = СтруктураЦен.БазиснаяЗарплатаМашинистов;
	ТекущаяЗарплатаМашинистов = СтруктураЦен.ТекущаяЗарплатаМашинистов;
КонецПроцедуры

&НаСервереБезКонтекста
Функция НаименованиеРесурса(РесурсВыб)
    Возврат РесурсВыб.Код + " " +СокрЛП(РесурсВыб.Наименование) + " " + РесурсВыб.ЕдиницаИзмерения;	
КонецФункции

&НаСервере
Функция ПолучитьКодРесурса(Ресурс)
	Возврат Ресурс.Код;
КонецФункции

&НаСервере
Процедура ПолучитьЦеныВНБ(ДанныеЦен,ТекЦена,ТекЗарплМаш)
	ТаблицаТЦ = СМ_СметаЗагрузкаВызовСервера.ЗагрузитьТекущиеЦеныВТаблицу(ДанныеЦен);
	Если ТаблицаТЦ.Количество()>0 Тогда
		ТекЦена = ТаблицаТЦ[0].ТекущаяЦена;
		ТекЗарплМаш = ТаблицаТЦ[0].ТекущаяЗарплатаМашинистов;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьРесурс(Команда)
	
	Если ТипЗнч(Элементы.ДеревоРесурсов.ТекущиеДанные.Значение)<>Тип("СправочникСсылка.СМ_Ресурсы")  Тогда
		Возврат;	
	КонецЕсли;
	
	ТекРесурс 					= Элементы.ДеревоРесурсов.ТекущиеДанные.Значение;
	РасходПоНорме			    = Элементы.ДеревоРесурсов.ТекущиеДанные.НормаРасхода;
	
	Структура = Новый Структура("ПозицияРесурса,Форма,ВариантЗамены,ЗаменяемыйРесурс,Ресурс,РасходПоНорме,МестоВызова,БазисЦена,БазисЗарплМаш,ТекЦена,ТекЗарплМаш");
	Структура.ЗаменяемыйРесурс = ТекРесурс;
	Структура.РасходПоНорме = РасходПоНорме;
	Структура.ВариантЗамены = "СМ_Ресурсы";
	Структура.Форма = ЭтаФорма;
	Структура.МестоВызова = "ЛСВыборРесурса";
	Структура.ПозицияРесурса = ПозицияРесурса;
    СМ_СметаКлиент.ВыполнитьЗаменуРесурса(Структура);

КонецПроцедуры

&НаКлиенте
Процедура ДеревоРесурсовПередНачаломИзменения(Элемент, Отказ)
	Если ТипЗнч(Элемент.ТекущиеДанные.Значение)=Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		ПозицияРесурса = Элемент.ТекущиеДанные.Значение;
	ИначеЕсли Элемент.ТекущийЭлемент.Имя = "ДеревоРесурсовНеИндексировать" Тогда
		Элемент.ТекущиеДанные.НеИндексировать = Не Элемент.ТекущиеДанные.НеИндексировать;
	ИначеЕсли Элемент.ТекущийЭлемент.Имя = "ДеревоРесурсовФлагОборудование" Тогда
		Элемент.ТекущиеДанные.ФлагОборудование = Не Элемент.ТекущиеДанные.ФлагОборудование;
	ИначеЕсли Элемент.ТекущийЭлемент.Имя = "ДеревоРесурсовНаименование" Тогда
		Элемент.ТекущиеДанные.Выбран = Не Элемент.ТекущиеДанные.Выбран;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменаРесурсаИзСборникаТекущихЦен(Команда)
	Если ТипЗнч(Элементы.ДеревоРесурсов.ТекущиеДанные.Значение)=Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")  Тогда
		Возврат;	
	КонецЕсли;
	ДокументЛС = ПолучитьСмету(ПозицияРесурса);
	ФайлСборникаТекущихЦен = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ДокументЛС, "ФайлСборникаТекущихЦен");
	Если ФайлСборникаТекущихЦен <> Неопределено Тогда
		Район = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ДокументЛС, "Район");
		Если ТипЗнч(Элементы.ДеревоРесурсов.ТекущиеДанные.Значение)=Тип("СправочникСсылка.СМ_Ресурсы")  Тогда
			КодРесурса = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Элементы.ДеревоРесурсов.ТекущиеДанные.Значение, "Код");
		Иначе
			КодРесурса = Элементы.ДеревоРесурсов.ТекущиеДанные.ШифрРасценки;
		КонецЕсли;
		ВидОперации = "Замена";
		ИдФормы = СметнаяКомпонента.ПоказатьОкноТекущихЦен(СокрЛП(ФайлСборникаТекущихЦен), Строка(СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Район,"Код")),"ER",КодРесурса,Истина,Ложь);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьСмету(Позиция);
	Возврат Позиция.ИДСметы;
КонецФункции

// Процедура обрабатывает внешнее событие от ВНБ
//
// Параметры:
//   Источник - "AddIn.Base" - Источник внешнего события.
//   Событие - Строка - Описание события.
//   Данные - данные в виде XML - Параметры внешнего события,
//   передаются на обработку в общие модули - Обработчики Сметы.
&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	Если Источник = "AddIn.Base" Тогда
		Если Событие = "SelectRasc"+ИдФормы Тогда
			
			Если ВидОперации = "Замена" Тогда
				ТекРесурс 					= Элементы.ДеревоРесурсов.ТекущиеДанные.Значение;
				РасходПоНорме			    = Элементы.ДеревоРесурсов.ТекущиеДанные.НормаРасхода;
				
				Структура = Новый Структура("Данные,ПозицияРесурса,Форма,ВариантЗамены,ЗаменяемыйРесурс,Ресурс,РасходПоНорме,МестоВызова,БазисЦена,БазисЗарплМаш,ТекЦена,ТекЗарплМаш");
				Структура.Данные = Данные;
				Структура.ЗаменяемыйРесурс = ТекРесурс;
				Структура.РасходПоНорме = РасходПоНорме;
				Структура.ВариантЗамены = Неопределено;
				Структура.Форма = ЭтаФорма;
				Структура.МестоВызова = "ЛСВыборРесурса";
				Структура.ПозицияРесурса = ПозицияРесурса;
				СМ_СметаКлиент.ВыполнитьЗаменуРесурса(Структура);
			ИначеЕсли ВидОперации = "Добавление" Тогда
				Структура = ЗаполнитьДанныеРесурса(Данные);
				ДобавитьСтрокуДерева(Структура,Элементы.ДеревоРесурсов.ТекущиеДанные.Индекс);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуДерева(Структура,Индекс)
	Дерево = РеквизитФормыВЗначение("ДеревоРесурсов", Тип("ДеревоЗначений"));
	СтрокаДерева = Дерево.Строки.Найти(ПозицияРесурса,"Значение");
	КоличествоСтрок = СтрокаДерева.Строки.Количество();
	СтрокаРесурса = СтрокаДерева.Строки.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаРесурса,Структура);
	СтрокаРесурса.Выбран = СтрокаДерева.Выбран;
	СтрокаРесурса.НеИндексировать = Истина;	
	СтрокаРесурса.Индекс = КоличествоСтрок;
	СтрокаРесурса.НоваяСтрока = Истина;
	ЗначениеВРеквизитФормы(Дерево, "ДеревоРесурсов") 
КонецПроцедуры

&НаСервере
Функция ЗаполнитьДанныеРесурса(Данные)
	Структура = Новый Структура("ПозицияРесурса,Наименование,Значение,ШифрРасценки,Ресурс,Определитель,ЕдиницаИзмерения,Измеритель,ТекЦена,ТекЗарплМаш,ОбъемРабот,БазисЗарплМаш,БазисЦена");
	Структура.ПозицияРесурса = ПозицияРесурса;
	СМ_СметаВызовСервера.ЗаполнитьДанныеРесурса(Данные,Структура);
	Возврат Структура;
КонецФункции

&НаКлиенте
Процедура ПодборРеусрсаИзВНБ(Команда)
	Если ТипЗнч(Элементы.ДеревоРесурсов.ТекущиеДанные.Значение)<>Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")  Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не выбрана позиция для добавления ресурса.'"));
		Возврат;	
	КонецЕсли;
	ДокументЛС = ПолучитьСмету(ПозицияРесурса);
	ФайлСборникаТекущихЦен = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ДокументЛС, "ФайлСборникаТекущихЦен");
	Если ФайлСборникаТекущихЦен <> Неопределено Тогда
	Район = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ДокументЛС, "Район");
	ВидОперации = "Добавление";
	ИдФормы = СметнаяКомпонента.ПоказатьОкноТекущихЦен(СокрЛП(ФайлСборникаТекущихЦен), Строка(СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Район,"Код")));
	КонецЕсли;	
КонецПроцедуры


// Доктор софт

&НаКлиенте
Процедура ПолучитьЗаменуРесурсаИзПрайса(Результат, Структура) Экспорт
	ЗаменяемыйРесурс = Структура.ЗаменяемыйРесурс;
	РасходПоНорме = Структура.РасходПоНорме;
	СписокПрайсовЗамены = Результат;
	
	Если  СписокПрайсовЗамены = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Сч = 1;
	Для Каждого ПрайсИзСписка Из СписокПрайсовЗамены Цикл 
		Если  Сч = 1 Тогда
			Элементы.ДеревоРесурсов.ТекущиеДанные.Прайс = ПрайсИзСписка.Значение.Прайс;
			Элементы.ДеревоРесурсов.ТекущиеДанные.ШифрРасценки = ПрайсИзСписка.Значение.ШифрРасценки;
			Элементы.ДеревоРесурсов.ТекущиеДанные.Значение = ПрайсИзСписка.Значение.ШифрРасценки+" "+ПрайсИзСписка.Значение.Наименование;
			Элементы.ДеревоРесурсов.ТекущиеДанные.Ресурс = ПрайсИзСписка.Значение.Наименование;
			Элементы.ДеревоРесурсов.ТекущиеДанные.Наименование = ПрайсИзСписка.Значение.ШифрРасценки + ПрайсИзСписка.Значение.Наименование;
			Элементы.ДеревоРесурсов.ТекущиеДанные.НормаРасхода = ПрайсИзСписка.Значение.НормаРасхода;
			Элементы.ДеревоРесурсов.ТекущиеДанные.БазиснаяЦена = ПрайсИзСписка.Значение.БазиснаяЦена;
			Элементы.ДеревоРесурсов.ТекущиеДанные.ТекущаяЦена = ПрайсИзСписка.Значение.ТекущаяЦена;
			Элементы.ДеревоРесурсов.ТекущиеДанные.ФлагОборудование = ПрайсИзСписка.Значение.ФлОборудование;
			Элементы.ДеревоРесурсов.ТекущиеДанные.Определитель = ПрайсИзСписка.Значение.Определитель;
			Элементы.ДеревоРесурсов.ТекущиеДанные.Измеритель = ПрайсИзСписка.Значение.Измеритель;
			Элементы.ДеревоРесурсов.ТекущиеДанные.ЕдиницаИзмерения = ПрайсИзСписка.Значение.ЕдиницаИзмерения;
			Элементы.ДеревоРесурсов.ТекущиеДанные.НормСборник = ПрайсИзСписка.Значение.НормСборник;
			Элементы.ДеревоРесурсов.ТекущиеДанные.ПереноситьЧП = ПрайсИзСписка.Значение.ПереноситьЧП;
			Элементы.ДеревоРесурсов.ТекущиеДанные.ПереноситьПоправки = ПрайсИзСписка.Значение.ПереноситьПоправки;
			Элементы.ДеревоРесурсов.ТекущиеДанные.ПереноситьПримечания = ПрайсИзСписка.Значение.ПереноситьПримечания;
			Элементы.ДеревоРесурсов.ТекущиеДанные.ФлПрайс = Истина;
			Сч = Сч + 1;	
		Иначе
			// Операция добавить.
			Структура = Новый Структура("Прайс,Наименование,Значение,ШифрРасценки,Ресурс,Определитель,ЕдиницаИзмерения,Измеритель,ТекущаяЦена,ТекущаяЗарплатаМашинистов,ОбъемРабот,БазиснаяЗарплатаМашинистов,БазиснаяЦена,ПереноситьЧП,ПереноситьПримечания,ПереноситьПоправки");
			Структура.Вставить("Прайс",ПрайсИзСписка.Значение.Прайс);
			Структура.Вставить("ШифрРасценки",ПрайсИзСписка.Значение.ШифрРасценки);
			Структура.Вставить("Наименование",ПрайсИзСписка.Значение.ШифрРасценки+" "+ПрайсИзСписка.Значение.Наименование);
			Структура.Вставить("Значение",ПрайсИзСписка.Значение.ШифрРасценки+" "+ПрайсИзСписка.Значение.Наименование);
			Структура.Вставить("Ресурс",ПрайсИзСписка.Значение.Наименование);
			Структура.Вставить("ТекущаяЦена",ПрайсИзСписка.Значение.ТекущаяЦена);
			Структура.Вставить("ТекущаяЗарплатаМашинистов",0);
			Структура.Вставить("НормаРасхода",ПрайсИзСписка.Значение.НормаРасхода);
			Структура.Вставить("Определитель",ПрайсИзСписка.Значение.Определитель);
			Структура.Вставить("ЕдиницаИзмерения",ПрайсИзСписка.Значение.ЕдиницаИзмерения);
			Структура.Вставить("Измеритель",ПрайсИзСписка.Значение.Измеритель);
			Структура.Вставить("БазиснаяЗарплатаМашинистов",0);
			Структура.Вставить("БазиснаяЦена",ПрайсИзСписка.Значение.БазиснаяЦена);
			Структура.Вставить("НормСборник",ПрайсИзСписка.Значение.НормСборник);
			Структура.Вставить("ФлПрайс",Истина);
			Структура.Вставить("ПереноситьЧП",ПрайсИзСписка.Значение.ПереноситьЧП);
			Структура.Вставить("ПереноситьПоправки",ПрайсИзСписка.Значение.ПереноситьПоправки);
			Структура.Вставить("ПереноситьПримечания",ПрайсИзСписка.Значение.ПереноситьПримечания);
			
			ДобавитьСтрокуДерева(Структура,Элементы.ДеревоРесурсов.ТекущиеДанные.Индекс);
			
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ПодборРесурсовИзПрайса(Команда)
	Если ТипЗнч(Элементы.ДеревоРесурсов.ТекущиеДанные.Значение)<>Тип("СправочникСсылка.СМ_Ресурсы")  Тогда
		Возврат;	
	КонецЕсли;
	
	ТекРесурс 					= Элементы.ДеревоРесурсов.ТекущиеДанные.Значение;
	РасходПоНорме			    = Элементы.ДеревоРесурсов.ТекущиеДанные.НормаРасхода;
	
	Структура = Новый Структура("ЗаменяемыйРесурс, РасходПоНорме,МестоВызова");
	Структура.ЗаменяемыйРесурс = ТекРесурс;
	Структура.РасходПоНорме = РасходПоНорме;
	Структура.МестоВызова = "";
	Прайсы = Новый СписокЗначений;
	
	СтруктураПараметров = Новый Структура("ЛокСмета,НормаРасхода,Прайсы,ПереноситьПоправки,ПереноситьЧП,ПереноситьПримечания");
	СтруктураПараметров.ЛокСмета = ПолучитьСмету(ПозицияРесурса);
	СтруктураПараметров.НормаРасхода = РасходПоНорме;
	СтруктураПараметров.Прайсы = Прайсы;
	СтруктураПараметров.ПереноситьПоправки = Ложь;
	СтруктураПараметров.ПереноситьЧП = Ложь;
	СтруктураПараметров.ПереноситьПримечания = Ложь;

	
	Оповещение = Новый ОписаниеОповещения("ПолучитьЗаменуРесурсаИзПрайса", ЭтотОбъект,Структура);
	ОткрытьФорму("ОбщаяФорма.СМ_ФормаВыбораПрайсов",СтруктураПараметров,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРесурсовПриАктивизацииСтроки(Элемент)
	Если ТипЗнч(Элемент.ТекущиеДанные.Значение)=Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		ПозицияРесурса = Элемент.ТекущиеДанные.Значение;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Параметры.НеОткрывать Тогда
		ЭтаФорма.ПодключитьОбработчикОжидания("ЗакрытьФорму",0.1,Истина);
	Иначе
		ВидимостьДоступностьЭлементовНаФорме();
	КонецЕсли;                                 	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму()
	ВыбранныеРесурсы = ПолучитьПараметрыЗакрытияФормы();
	ЭтаФорма.Закрыть(ВыбранныеРесурсы);
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьДоступностьЭлементовНаФорме()
	
	Если СметнаяКомпонента = Неопределено Тогда
		Элементы.ПодборРесурсаИзСборникаТекущихЦен.Видимость = Ложь;
		Элементы.ДобавитьРесурсИзВНБ.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаменаРесурсаИзНС(Команда)
	Если ТипЗнч(Элементы.ДеревоРесурсов.ТекущиеДанные.Значение)<>Тип("СправочникСсылка.СМ_Ресурсы")  Тогда
		Возврат;	
	КонецЕсли;
	
	ТекРесурс 					= Элементы.ДеревоРесурсов.ТекущиеДанные.Значение;
	РасходПоНорме			    = Элементы.ДеревоРесурсов.ТекущиеДанные.НормаРасхода;
	
	Структура = Новый Структура("ПозицияРесурса,Форма,ВариантЗамены,ЗаменяемыйРесурс,Ресурс,РасходПоНорме,МестоВызова,БазисЦена,БазисЗарплМаш,ТекЦена,ТекЗарплМаш");
	Структура.ЗаменяемыйРесурс = ТекРесурс;
	Структура.РасходПоНорме = РасходПоНорме;
	Структура.ВариантЗамены = "СМ_НормативныеСборники";
	Структура.Форма = ЭтаФорма;
	Структура.МестоВызова = "ЛСВыборРесурса";
	Структура.ПозицияРесурса = ПозицияРесурса;
    СМ_СметаКлиент.ВыполнитьЗаменуРесурса(Структура);
КонецПроцедуры

#КонецОбласти