
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЛокальнаяСмета") Тогда
		ЭтаФорма.ЛокальнаяСмета = Параметры.ЛокальнаяСмета;
	КонецЕсли;
	
	Если Параметры.Свойство("Родитель") Тогда
		ЭтаФорма.Родитель = Параметры.Родитель;
	КонецЕсли;
	
	СозданыНовыеПозиции = Ложь;
	СформироватьМакетПоТипуЗагрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Закрыть(СозданыНовыеПозиции);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыШаблонСДанными

&НаКлиенте
Процедура ШаблонСДаннымиПриИзмененииСодержимогоОбласти(Элемент, Область)

	НомерСтрокиНачало		= Область.Верх;
	НомерСтрокиКонец		= Область.Низ;
	НомерПервойКолонки      = Область.Лево;
	НомерПоследнейКолонки  	= Область.Право;
	
	ПроверкаВставляемойОбласти(НомерСтрокиНачало,НомерСтрокиКонец,НомерПервойКолонки,НомерПоследнейКолонки);
	
	ТекОбласть = ШаблонСДанными.Область(1,1);
	Элементы.ШаблонСДанными.ТекущаяОбласть = ТекОбласть;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьДанные(Команда)
	
	ЗаписатьДанныеШаблона();
	ЭтаФорма.Закрыть(СозданыНовыеПозиции);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьМакетПоТипуЗагрузки()
	
	Макет 						= Документы.СМ_ЛокальнаяСмета.ПолучитьМакет("ВставкаПозицийИзФайла");
	ИнформацияПоКолонкамТаблица = РеквизитФормыВЗначение("ИнформацияПоКолонкам");
	ОбластьЗаголовокТаблицы 	= ОбластьЗаголовкаШаблонаТаблицы(Макет);
	Если ИнформацияПоКолонкам.Количество() = 0 Тогда
		СоздатьИнформациюПоКолонкамНаОснованиеШаблона(ОбластьЗаголовокТаблицы,ИнформацияПоКолонкамТаблица);
	КонецЕсли;
		
	ЗначениеВРеквизитФормы(ИнформацияПоКолонкамТаблица, "ИнформацияПоКолонкам");
	
	ШаблонСДанными.Очистить();
	Шапка = Обработки.ЗагрузкаДанныхИзФайла.ШапкаБланкаДляЗаполненияПоИнформацииПоКолонкам(ИнформацияПоКолонкамТаблица);
	ШаблонСДанными.Вывести(Шапка);
	
КонецПроцедуры

&НаСервере
Функция ОбластьЗаголовкаШаблонаТаблицы(Шаблон)
	
	ВысотаШапки = 1;
	Для НомерКолонки = 1 По Шаблон.ШиринаТаблицы Цикл
		Ячейка = Шаблон.ПолучитьОбласть(2, НомерКолонки, 2, НомерКолонки).ТекущаяОбласть;
		Если ЗначениеЗаполнено(Ячейка.Текст) Тогда
			ВысотаШапки = 2;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ОбластьЗаголовокТаблицы = Шаблон.ПолучитьОбласть(1, 1, ВысотаШапки, Шаблон.ШиринаТаблицы);
	
	Возврат ОбластьЗаголовокТаблицы;
	
КонецФункции

&НаСервере
// Заполняет таблицу о колонках в макете. Информация используется для построения таблицы сопоставления.
//
// Параметры:
//  ОбластьЗаголовокТаблицы	 - ТекстовыйДокумент - Область заголовка макета.
//  ИнформацияПоКолонкам	 - ТаблицаЗначений - Таблица с описание колонок.
Процедура СоздатьИнформациюПоКолонкамНаОснованиеШаблона(ОбластьЗаголовокТаблицы,ИнформацияПоКолонкам)
	
	ИнформацияПоКолонкам.Очистить();
	СоответствиеТипаДанныхКолонок = Новый Соответствие;
	Позиция 	= 1;
	ВысотаШапки = ОбластьЗаголовокТаблицы.ВысотаТаблицы;
	Если ВысотаШапки = 2 Тогда
		НомерКолонки = 1;
		Группы = Новый Соответствие;
		ИспользуетсяГруппировка = Истина;
		Пока НомерКолонки <= ОбластьЗаголовокТаблицы.ШиринаТаблицы Цикл
			Область = ОбластьЗаголовокТаблицы.ПолучитьОбласть(1, НомерКолонки);
			Ячейка = ОбластьЗаголовокТаблицы.ПолучитьОбласть(1, НомерКолонки, 1, НомерКолонки).ТекущаяОбласть;
			Группа = Ячейка.Текст;
			Для Индекс = НомерКолонки По НомерКолонки + Область.ШиринаТаблицы -1 Цикл
				Группы.Вставить(Индекс, Группа);
			КонецЦикла;
			НомерКолонки = НомерКолонки + Область.ШиринаТаблицы;
		КонецЦикла;
	Иначе
		ИспользуетсяГруппировка = Ложь;
	КонецЕсли;
	
	Для НомерКолонки = 1 По ОбластьЗаголовокТаблицы.ШиринаТаблицы Цикл
		Ячейка = ОбластьЗаголовокТаблицы.ПолучитьОбласть(ВысотаШапки, НомерКолонки, ВысотаШапки, НомерКолонки).ТекущаяОбласть;
		Если СтрНайти(Ячейка.Имя, "R") > 0 И СтрНайти(Ячейка.Имя, "C") > 0 Тогда
			ИмяРеквизита = ?(ЗначениеЗаполнено(Ячейка.ПараметрРасшифровки), Ячейка.ПараметрРасшифровки, Ячейка.Текст);
			ПредставлениеРеквизита = ?(ЗначениеЗаполнено(Ячейка.Текст), Ячейка.Текст, Ячейка.ПараметрРасшифровки);
			ТекРодитель = ?(ЗначениеЗаполнено(Ячейка.ПараметрРасшифровки), Ячейка.ПараметрРасшифровки, Ячейка.Текст);
		Иначе
			ИмяРеквизита = Ячейка.Имя;
			ПредставлениеРеквизита = ?(ЗначениеЗаполнено(Ячейка.Текст), Ячейка.Текст, Ячейка.Имя);
			ТекРодитель = ?(ЗначениеЗаполнено(Ячейка.ПараметрРасшифровки), Ячейка.ПараметрРасшифровки, Ячейка.Имя);
		КонецЕсли;
		
		ТипДанныхКолонки = Новый ОписаниеТипов("Строка");
		Если ЗначениеЗаполнено(ИмяРеквизита) Тогда
			СтрокаИнфоПроКолонки 							= ИнформацияПоКолонкам.Добавить();
			СтрокаИнфоПроКолонки.ИмяКолонки 				= ИмяРеквизита;
			СтрокаИнфоПроКолонки.ПредставлениеКолонки 		= ПредставлениеРеквизита;
			СтрокаИнфоПроКолонки.ТипКолонки 				= ТипДанныхКолонки;
			СтрокаИнфоПроКолонки.ОбязательнаДляЗаполнения 	= Ячейка.Шрифт.Жирный;
			СтрокаИнфоПроКолонки.Позиция 					= Позиция;
			СтрокаИнфоПроКолонки.Родитель 					= ТекРодитель;
			Если ИспользуетсяГруппировка Тогда
				СтрокаИнфоПроКолонки.Группа = Группы.Получить(НомерКолонки);
			КонецЕсли;
			СтрокаИнфоПроКолонки.Видимость 		= Истина;
			СтрокаИнфоПроКолонки.Примечание 	= Ячейка.Примечание.Текст;
			СтрокаИнфоПроКолонки.Ширина 		= Ячейка.ШиринаКолонки;
			Позиция = Позиция + 1;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДанныеШаблона()
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаДанных.Колонки.Добавить("ЗПМ");
	ТаблицаДанных.Колонки.Добавить("ЗТМ");
	ТаблицаДанных.Колонки.Добавить("ЗТР");
	ТаблицаДанных.Колонки.Добавить("Идентификатор");
	ТаблицаДанных.Колонки.Добавить("Наименование");
	ТаблицаДанных.Колонки.Добавить("ОЗ");
	ТаблицаДанных.Колонки.Добавить("Объем");
	ТаблицаДанных.Колонки.Добавить("ПЗ");
	ТаблицаДанных.Колонки.Добавить("СМ");
	ТаблицаДанных.Колонки.Добавить("Шифр");
	ТаблицаДанных.Колонки.Добавить("ЭМ");
	
	ТекИнформацияПоКолонкам	= РеквизитФормыВЗначение("ИнформацияПоКолонкам");
	ЗаполнитьТаблицуДанных(ЭтаФорма.ШаблонСДанными, ТекИнформацияПоКолонкам,ТаблицаДанных);
	СоздатьПозиции(ЭтаФорма.ЛокальнаяСмета,ЭтаФорма.Родитель,ТаблицаДанных);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуДанных(ШаблонСДанными,ТаблицаИнформацияПоКолонкам,ТаблицаДанных)
	
	ПерваяСтрокаТаблицы = ?(ЗагрузкаДанныхИзФайлаКлиентСервер.КолонкиИмеютГруппировку(ТаблицаИнформацияПоКолонкам), 3, 2);
	
	КорректировкаИдентификатора = ПерваяСтрокаТаблицы - 2;
	Для НомерСтроки = ПерваяСтрокаТаблицы По ШаблонСДанными.ВысотаТаблицы Цикл 
		
		СтрокаТаблицыПустая 		= Истина;
		НоваяСтрока 				= ТаблицаДанных.Добавить();
		НоваяСтрока.Идентификатор 	= НомерСтроки - 1 - КорректировкаИдентификатора;
	
		Для НомерКолонки = 1 По ШаблонСДанными.ШиринаТаблицы Цикл
			Ячейка 	= ШаблонСДанными.ПолучитьОбласть(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).ТекущаяОбласть;
			Колонка = НайтиИнформациюОКолонке(ТаблицаИнформацияПоКолонкам, "Позиция", НомерКолонки);
			Если Колонка <> Неопределено Тогда
				ИмяКолонки 				= Колонка.ИмяКолонки;
				ДанныеЯчейки 			= СокрЛП(Ячейка.Текст);
				НоваяСтрока[ИмяКолонки] = ДанныеЯчейки;
				Если СтрокаТаблицыПустая Тогда
					СтрокаТаблицыПустая = НЕ ЗначениеЗаполнено(ДанныеЯчейки);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаТаблицыПустая Тогда
			ТаблицаДанных.Удалить(НоваяСтрока);
			КорректировкаИдентификатора = КорректировкаИдентификатора + 1;
		КонецЕсли;
	
		// Прерываем после первой пустой строки обработку дальнейшей части табличного документа,
		// т.к. при вставке их Excel вставляется большое число строк и высота таблицы стремится к бесконечности.
		Если СтрокаТаблицыПустая Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НайтиИнформациюОКолонке(ТаблицаИнформацияПоКолонкам, ИмяКолонки, Значение)
	
	Отбор 				= Новый Структура(ИмяКолонки, Значение);
	НайденныеКолонки 	= ТаблицаИнформацияПоКолонкам.НайтиСтроки(Отбор);
	Колонка 			= Неопределено;
	Если НайденныеКолонки.Количество() > 0 Тогда 
		Колонка = НайденныеКолонки[0];
	КонецЕсли;
	
	Возврат Колонка;
	
КонецФункции

// Возвращает имя объекта в виде структуры.
//
// Параметры:
//	ПолноеИмяОбъекта 		- Структура - Имя объекта.
//		* ТипОбъекта 		- Строка - Тип объекта.
//		* НазваниеОбъекта 	- Строка - Название объекта.
//		* ИмяТабличнойЧасти - Строка - Имя табличной части.
//
&НаСервере
Функция РазложитьПолноеИмяОбъекта(ПолноеИмяОбъекта)
	
	Результат 	= СтрРазделить(ПолноеИмяОбъекта, ".", Ложь);
	ИмяОбъекта 	= Новый Структура;
	ИмяОбъекта.Вставить("ПолноеИмяОбъекта", ПолноеИмяОбъекта);
	ИмяОбъекта.Вставить("ТипОбъекта");
	ИмяОбъекта.Вставить("НазваниеОбъекта");
	ИмяОбъекта.Вставить("ИмяТабличнойЧасти");
	
	Если Результат.Количество() = 2 Тогда
		Если Результат[0] = "Документ" ИЛИ Результат[0] = "Справочник" ИЛИ Результат[0] = "БизнесПроцесс" 
			ИЛИ Результат[0] = "Перечисление" ИЛИ Результат[0] = "ПланВидовХарактеристик"
			ИЛИ Результат[0] = "ПланСчетов" Тогда
				ИмяОбъекта.ТипОбъекта 		= Результат[0];
				ИмяОбъекта.НазваниеОбъекта 	= Результат[1];
		Иначе
				ИмяОбъекта.ТипОбъекта 			= ОпределитьТипОбъектаМетаданныхПоИмени(Результат[0]);
				ИмяОбъекта.НазваниеОбъекта 		= Результат[0];
				ИмяОбъекта.ИмяТабличнойЧасти 	= Результат[1];
		КонецЕсли;
	ИначеЕсли Результат.Количество() = 3 Тогда
		ИмяОбъекта.ТипОбъекта = Результат[0];
		ИмяОбъекта.НазваниеОбъекта = Результат[1];
		ИмяОбъекта.ИмяТабличнойЧасти = Результат[2];
	ИначеЕсли Результат.Количество() = 4 Тогда 
		ИмяОбъекта.ТипОбъекта = Результат[0];
		ИмяОбъекта.НазваниеОбъекта = Результат[1];
		ИмяОбъекта.ИмяТабличнойЧасти = Результат[3];
	ИначеЕсли Результат.Количество() = 1 Тогда
		ИмяОбъекта.ТипОбъекта = ОпределитьТипОбъектаМетаданныхПоИмени(Результат[0]);
		ИмяОбъекта.НазваниеОбъекта = Результат[0];
	КонецЕсли;

	Возврат ИмяОбъекта;
	
КонецФункции

&НаСервере
Функция ОпределитьТипОбъектаМетаданныхПоИмени(Имя)
	
	Для каждого Объект Из Метаданные.Справочники Цикл 
		Если Объект.Имя = Имя Тогда 
			Возврат "Справочник";
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Объект Из Метаданные.Документы Цикл 
		Если Объект.Имя = Имя Тогда 
			Возврат "Документ";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ПроверкаВставляемойОбласти(НомерСтрокиНачало,НомерСтрокиКонец,НомерПервойКолонки,НомерПоследнейКолонки)
	
	ТаблицаИнформацияПоКолонкам	= РеквизитФормыВЗначение("ИнформацияПоКолонкам");
	
	Для НомерСтроки = НомерСтрокиНачало По НомерСтрокиКонец Цикл 
		СтрокаТаблицыПустая = Истина;
		Для НомерКолонки = 1 По ШаблонСДанными.ШиринаТаблицы Цикл
			Ячейка 	= ШаблонСДанными.ПолучитьОбласть(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).ТекущаяОбласть;
			Колонка = НайтиИнформациюОКолонке(ТаблицаИнформацияПоКолонкам, "Позиция", НомерКолонки);
			Если Колонка <> Неопределено Тогда
				ДанныеЯчейки = Ячейка.Текст;
				Если СтрокаТаблицыПустая Тогда
					СтрокаТаблицыПустая = НЕ ЗначениеЗаполнено(ДанныеЯчейки);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		// Прерываем после первой пустой строки обработку дальнейшей части табличного документа,
		// т.к. при вставке их Excel вставляется большое число строк и высота таблицы стремится к бесконечности.
		НомерПоследнейСтроки = НомерСтроки;
		Если СтрокаТаблицыПустая Тогда
			Прервать;
		Иначе
			ОбработатьСтрокуОбласти(НомерСтроки,НомерПервойКолонки,НомерПоследнейКолонки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьСтрокуОбласти(НомерСтроки,НомерПервойКолонки,НомерПоследнейКолонки)
	
	ТаблицаСдвигов = Новый ТаблицаЗначений;
	ТаблицаСдвигов.Колонки.Добавить("НомерКолонки");
	ТаблицаСдвигов.Колонки.Добавить("Сдвиг");
	
	// В первый проход получаем области сдвига. 
	// Записываем с какой позиции / колонки и на сколько нужно сдвинуть значения.
	ПредСдвиг	= 0;
	Для ТекНомер = НомерПервойКолонки По НомерПоследнейКолонки Цикл
	 	ТекОбласть 	= ШаблонСДанными.Область(НомерСтроки,ТекНомер);
		ТекЛево 	= ТекОбласть.Лево;
		ТекПраво    = ТекОбласть.Право;
		Если ТекЛево <> ТекПраво Тогда
			ТекОбласть.Разъединить();
			НоваяСтрока 				= ТаблицаСдвигов.Добавить();
			НоваяСтрока.НомерКолонки    = ТекНомер + 1 - ПредСдвиг;
			НоваяСтрока.Сдвиг           = ТекПраво - ТекЛево + ПредСдвиг;
			ПредСдвиг 					= НоваяСтрока.Сдвиг;
		КонецЕсли;
	КонецЦикла;
	
	// Вторым проходом сдвигаем значения
	ТекСдвиг = 0;
	Для ТекНомер = НомерПервойКолонки По НомерПоследнейКолонки Цикл
		НайденнаяСтрока = ТаблицаСдвигов.Найти(ТекНомер,"НомерКолонки");
		Если НайденнаяСтрока <> Неопределено Тогда
			ТекСдвиг = НайденнаяСтрока.Сдвиг;
		КонецЕсли;
		ТекОбласть 			= ШаблонСДанными.Область(НомерСтроки,ТекНомер);
		ОбластьСдвига 		= ШаблонСДанными.Область(НомерСтроки,ТекНомер+ТекСдвиг);	
		ТекОбласть.Текст 	= ОбластьСдвига.Текст;
	КонецЦикла;

	ОбластьПЗ 		= ШаблонСДанными.Области.Найти("ПЗ");
	НачалоОбласти  	= ОбластьПЗ.Лево;
	
	// Третим проходом разделяем значения по разделителям
	ТекСдвиг = 0;
	Для ТекНомер = НомерПервойКолонки По НомерПоследнейКолонки Цикл
		Если ТекНомер >= НачалоОбласти Тогда
			ТекОбласть = ШаблонСДанными.Область(НомерСтроки,ТекНомер);
			ТекЗначение = ТекОбласть.Текст;		
			
			ТекМассив1 = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекЗначение,"/",Истина,Истина);
			ТекМассив2 = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекЗначение,"\",Истина,Истина);
			ТекМассив3 = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекЗначение," ",Истина,Истина);
			ТекМассив4 = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекЗначение,Символы.ПС,Истина,Истина);
			
			Если ТекМассив1.Количество() > 1 Тогда
				ПеренестиЗначенияПоЯчейкам(ТекМассив1,НомерСтроки,ТекНомер);	
			ИначеЕсли ТекМассив2.Количество() > 1 Тогда
				ПеренестиЗначенияПоЯчейкам(ТекМассив2,НомерСтроки,ТекНомер);		
			ИначеЕсли ТекМассив3.Количество() > 1 Тогда
				ПеренестиЗначенияПоЯчейкам(ТекМассив3,НомерСтроки,ТекНомер);	
			ИначеЕсли ТекМассив4.Количество() > 1 Тогда
				ПеренестиЗначенияПоЯчейкам(ТекМассив4,НомерСтроки,ТекНомер);	
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиЗначенияПоЯчейкам(МассивЗначений,НомерСтроки,ТекНомер)

	КоличествоЭлементов = МассивЗначений.Количество();
	Для Сч = 0 ПО КоличествоЭлементов-1 Цикл
		ТекОбласть 			= ШаблонСДанными.Область(НомерСтроки,ТекНомер + Сч);	
		ТекОбласть.Текст 	= МассивЗначений[Сч];
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
// Вынести в общий модуль какой-то.
// Функция есть в модуле менеджера обработки "СМ_ОбменДаннымиВФорматеАРПС".
Функция ПолучитьПрефиксШифра(ШифрПозиции)
	
	Префикс 	= "";
	КолСиволов 	= СтрДлина(ШифрПозиции);
	сч 			= 1;
	Пока сч <= КолСиволов Цикл
		Символ = Сред(ШифрПозиции,сч,1);
		Если СтрНайти("0123456789",Символ)>0 Тогда
			Прервать;
		КонецЕсли;
		Префикс = Префикс + Строка(Символ);
		сч = сч+1;
	КонецЦикла;	
	
	Возврат Префикс;
	
КонецФункции

&НаСервере
Процедура СоздатьПозиции(Смета,Родитель,ТаблицаДанных)
	
	ТаблицаДанных.Сортировать("Идентификатор Убыв");
	
	Для Каждого ТекСтрока Из ТаблицаДанных Цикл
	
		НовыйПозиция 					= Документы.СМ_ПозицияЛокальнойСметы.СоздатьДокумент();  // EXCEL
		НовыйПозиция.Расчет 			= Истина;
		НовыйПозиция.Дата 				= Смета.Дата;
		НовыйПозиция.ИДРодителя 		= Родитель.Ссылка;
		НовыйПозиция.ИДСметы 			= Родитель.ИДСметы;
		НовыйПозиция.ШифрРасценки		= ТекСтрока.Шифр;
		НовыйПозиция.Наименование 		= ТекСтрока.Наименование;
		НовыйПозиция.ОбъемРабот 		= ТекСтрока.Объем;
		НовыйПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.EXCEL;

		Если ЗначениеЗаполнено(ЭтаФорма.СметнаяПрограмма) Тогда
			НовыйПозиция.ИсточникСоздания = ЭтаФорма.СметнаяПрограмма.Наименование; 	
		Иначе	
			НовыйПозиция.ИсточникСоздания = Справочники.СМ_СметныеПрограммы.ГрандСмета.Наименование;		
		КонецЕсли;
		
		// Определение единицы измерения
		Если ЗначениеЗаполнено(ТекСтрока.ЕдиницаИзмерения) Тогда
			ТекЕдИзм = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоНаименованию(ТекСтрока.ЕдиницаИзмерения,Истина);
			Если ТекЕдИзм = Справочники.СМ_ЕдиницыИзмеренияСмета.ПустаяСсылка() Тогда
				ТекЕдИзм = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоНаименованию("шт",Истина);
			КонецЕсли;
		Иначе
			ТекЕдИзм = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоНаименованию("шт",Истина);
		КонецЕсли;
		
		НовыйПозиция.ЕдиницаИзмерения 	= ТекЕдИзм;
		НовыйПозиция.Измеритель 		= ТекЕдИзм.Наименование;

		ТекПрефикс = ПолучитьПрефиксШифра(НовыйПозиция.ШифрРасценки);
		
		// Если в шифре есть префикс - по нему определить тип норм сборника и определитель (есть общие функции как при загрузке).
		Если ЗначениеЗаполнено(ТекПрефикс) Тогда
			ПрефиксыПрограммы 	= СМ_АРПС_ОбменВызовСервера.ПолучитьПрефиксы(Справочники.СМ_СметныеПрограммы.Смета30);
			НужнаяСтрока 		= Неопределено;
			Если ПрефиксыПрограммы <> Неопределено И ПрефиксыПрограммы.Количество() > 0 Тогда
				НужнаяСтрока = СМ_АРПС_ОбменВызовСервера.НайтиСтрокуПоПрефиксу(НовыйПозиция.ШифрРасценки,ПрефиксыПрограммы);
				Если НЕ НужнаяСтрока = Неопределено Тогда
					НовыйПозиция.ШифрРасценки 				= НужнаяСтрока.ШифрБезПрефикса;
					НовыйПозиция.Определитель 				= НужнаяСтрока.Определитель;
					НовыйПозиция.ТипНормативныхСборников 	= НужнаяСтрока.ТНС; 
				КонецЕсли;
			КонецЕсли;
			
			Если НужнаяСтрока = Неопределено Тогда
				НовыйПозиция.ТипНормативныхСборников 	= СМ_СметаЗагрузкаВызовСервера.ОпределитьТипНормСборникаПоШифру(НовыйПозиция.ШифрРасценки);
				НовыйПозиция.Определитель 				= Справочники.СМ_Определители.НайтиПоТипуНормативногоСборника(НовыйПозиция.ТипНормативныхСборников);
			КонецЕсли;
			
		// Если в шифре нет префиска и есть ЗПМ, то тип и определитель - общестроительные работы.
		ИначеЕсли ЗначениеЗаполнено(ТекСтрока.ЗПМ) Тогда
			НовыйПозиция.ТипНормативныхСборников 	= Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы;
			НовыйПозиция.Определитель				= Справочники.СМ_Определители.НайтиПоТипуНормативногоСборника(НовыйПозиция.ТипНормативныхСборников);
		// Иначе - тип и определитель сметные цены на материалы.		
		Иначе	
			НовыйПозиция.ТипНормативныхСборников 	= Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;
			НовыйПозиция.Определитель				= Справочники.СМ_Определители.НайтиПоТипуНормативногоСборника(НовыйПозиция.ТипНормативныхСборников);
		КонецЕсли;
		
		// ПЗ		- ПрямЗатраты
		// ОЗ	    - ОснЗарплата
		// ЭМ		- Эксплуатация машин в том. числе зарплата машинистов.
		// ЗПМ		- ЗарплМашинистов. 
		// СМ       - СтоимМатериалов.
		// ЗТР	    - ЗатратыТрудаРабочих.
		// ЗТМ      - ЗатратыТрудаМашинистов.
		
		// Машина или траспортировка:
		// может быть 2 составляющих: ЭМ и ЗПМ.
		// Прямые затраты = зарплаты рабочих (ОЗ) + стоимости эксплуатации машин (ЭМ) (включающей в себя зарплату машинистов (ЗПМ) и стоимости материалов (СМ).
		// Поскольку у машины нет ОЗ и СМ, то ПЗ = ЭМ, а зарплата сама по себе, она уже включена в ЭМ.
		// Поэтому одна или две колонки не имеет значения, расчет всегда один.		
		
		// Работа: 
		// ПЗ = ОЗ + ЭМ + СM, ЗПМ в том числе.
		// Кстати, обычно в печатных формах ПЗ и ОЗ в одной колонке, как у нас на форме состава ЛС.		
		
		// Для материалов - текущая цена из ПЗ и это же значение в базисные ПЗ и СМ.
		Если НовыйПозиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал Тогда
			НовыйПозиция.ПрямЗатраты       		= ТекСтрока.ПЗ;
			НовыйПозиция.СтоимМатериалов    	= ТекСтрока.СМ;
			НовыйПозиция.ТекущаяПрямЗатраты 	= ТекСтрока.ПЗ;
			НовыйПозиция.ТекущаяСтоимМатериалов = ТекСтрока.СМ;
		// Для машин - текущая цена из ПЗ, текущаяЗПМ из ЗПМ и аналогично ПЗ = ЭМ и ЗПМ. 		
		ИначеЕсли НовыйПозиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование ИЛИ 
   				  НовыйПозиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Транспортировка Тогда
			НовыйПозиция.ТекущаяЦена            = ТекСтрока.ПЗ;
			НовыйПозиция.ТекущаяЗарплМашинистов = ТекСтрока.ЗПМ;
			НовыйПозиция.ПрямЗатраты			= ТекСтрока.ЭМ;
		// Для работ - все в текущие показатели (ПЗ, ОЗ и т.д.) и в базисные тоже.
		ИначеЕсли НовыйПозиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Работа Тогда
			НовыйПозиция.ОснЗарплата 				= ТекСтрока.ОЗ;
			НовыйПозиция.ЭксплМашин 				= ТекСтрока.ЭМ;
			НовыйПозиция.ЗарплМашинистов		 	= ТекСтрока.ЗПМ;
			НовыйПозиция.СтоимМатериалов 			= ТекСтрока.СМ;
			НовыйПозиция.ПрямЗатраты 				= ТекСтрока.ПЗ;

			НовыйПозиция.ТекущаяОснЗарплата			= ТекСтрока.ОЗ;
			НовыйПозиция.ТекущаяЭксплМашин			= ТекСтрока.ЭМ;
			НовыйПозиция.ТекущаяЗарплМашинистов 	= ТекСтрока.ЗПМ;
			НовыйПозиция.ТекущаяСтоимМатериалов		= ТекСтрока.СМ;
			НовыйПозиция.ТекущаяПрямЗатраты			= ТекСтрока.ПЗ;
			
			НовыйПозиция.ЗатратыТрудаРабочих 		= ТекСтрока.ЗТР;
			НовыйПозиция.ЗатратыТрудаМашинистов 	= ТекСтрока.ЗТМ;
		КонецЕсли;
		
		НовыйПозиция.Записать();
		
		Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(НовыйПозиция,Ложь);
		
		СозданыНовыеПозиции = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

