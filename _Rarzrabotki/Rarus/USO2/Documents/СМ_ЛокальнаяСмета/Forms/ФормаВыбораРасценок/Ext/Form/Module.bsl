#Область ОбработчикиСобытийФормы	

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	Если Не Параметры.Свойство("ТаблицаВыбораРасценок") Тогда
		Возврат;
	КонецЕсли;
	ТЗ = РеквизитФормыВЗначение("ТаблицаВыбораРасценок");
	ТЗ = Параметры.ТаблицаВыбораРасценок.Выгрузить();
	ЗначениеВРеквизитФормы(ТЗ, "ТаблицаВыбораРасценок") ;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВыбораРасценокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Не ВыбраннаяСтрока = Неопределено Тогда
		Закрыть(Элемент.ТекущиеДанные);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоВсемСНБ(Команда)
	ТаблицаВыбораРасценок.Очистить();
	СписокБаз = Неопределено;
	СписокСборников = Неопределено;	
	СтруктураПараметров = СМ_СметаВызовСервера.ПолучитьШифр(Параметры.Шифр);
	ШифрРасценки = ?(ЗначениеЗаполнено(СтруктураПараметров.ШифрПозиции),СтруктураПараметров.ШифрПозиции,Параметры.Шифр);
	ТипСборника = СтруктураПараметров.ТНС;
	КодРайона = Параметры.Район;
	
	
	СписокБаз = СМ_СметаВызовСервера.ПолучитьВсеБазы();
	
	Если НЕ ЗначениеЗаполнено(ТипСборника) Тогда
		СписокСборников = СМ_СметаВызовСервера.ПолучитьВсеСборники();
	КонецЕсли;
	
	Если НЕ СписокБаз = Неопределено И НЕ СписокСборников = Неопределено Тогда
		Для Каждого ЭлБаз Из СписокБаз Цикл
			Для Каждого ЭлСборник Из СписокСборников Цикл
				НомерСборника = СокрЛП(СМ_СметаВызовСервера.ОпределитьНомерСборника(ЭлСборник.Значение,ШифрРасценки));
				Попытка
					Данные = СметнаяКомпонента.ОбновитьПоБазе(ШифрРасценки,КодРайона,ЭлБаз.Значение,ЭлСборник.Значение,НомерСборника);
					Если ЗначениеЗаполнено(Данные) И СМ_СметаЗагрузкаВызовСервера.ЕстьДанные(Данные) = Ложь Тогда
						Продолжить;
					КонецЕсли;
					Если ЗначениеЗаполнено(Данные) Тогда
						ПолучитьДанныеПозиции(Данные);
					КонецЕсли;
				Исключение
					Продолжить;
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
	ИначеЕсли Не СписокБаз = Неопределено И СписокСборников = Неопределено Тогда
		НомерСборника = СокрЛП(СМ_СметаВызовСервера.ОпределитьНомерСборника(ТипСборника,ШифрРасценки));
		Для Каждого ЭлБаз Из СписокБаз Цикл
			Попытка
				Данные = СметнаяКомпонента.ОбновитьПоБазе(ШифрРасценки,КодРайона,ЭлБаз.Значение,ТипСборника,НомерСборника);
				Если ЗначениеЗаполнено(Данные) И СМ_СметаЗагрузкаВызовСервера.ЕстьДанные(Данные) = Ложь Тогда
					Продолжить;
				КонецЕсли;
				Если ЗначениеЗаполнено(Данные) Тогда
					ПолучитьДанныеПозиции(Данные);
				КонецЕсли;
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПолучитьДанныеПозиции(Данные)
    ПозицияЛС = ТаблицаВыбораРасценок.Добавить();	
	ПозицияЛС.Данные = Данные;
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Данные);
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если (ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента)ИЛИ(ЧтениеXML.ТипУзла = ТипУзлаXML.Текст) Тогда
			Имя = НРег(ЧтениеXML.Имя);
			Если Имя = "collection" Тогда
				ЗаполнитьНСПозицииЛСИзXML(ЧтениеXML,ПозицияЛС);
			ИначеЕсли Имя = "norm" Тогда
				ЗаполнитьНаименованиеЕдиницуИзXML(ЧтениеXML,ПозицияЛС);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНСПозицииЛСИзXML(Тег,СтрТЗ)
	
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
			Продолжить;
		КонецЕсли;
		Если Тег.Имя = "code" Тогда
			СтрТЗ.РегиональнаяБаза = Справочники.СМ_СметноНормативныеБазы.НайтиПоКоду(Тег.Значение);	
		ИначеЕсли Тег.Имя = "worktype" Тогда
			СтрТЗ.ТипНормативныхСборников = СМ_СметаЗагрузкаВызовСервера.ОпределитьТипНормСборникаПоКоду(Тег.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаименованиеЕдиницуИзXML(Тег, СтрТЗ)
	
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
			Продолжить;
		КонецЕсли;
		ТегИмя = НРег(Тег.Имя);
		Если ТегИмя = "code" Тогда
			СтрТЗ.Шифр = Тег.Значение;
		ИначеЕсли ТегИмя = "name" Тогда
			СтрТЗ.Наименование = Тег.Значение;
		ИначеЕсли ТегИмя = "unit" Тогда
			СтрТЗ.ЕдиницаИзмерения = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоКоду(Тег.Значение);
		ИначеЕсли ТегИмя = "normtypecode" Тогда
			СтрТЗ.ТипНормативныхСборников = СМ_СметаЗагрузкаВызовСервера.ОпределитьТипНормСборникаПоКоду(Тег.Значение);
		ИначеЕсли ТегИмя = "regioncode" Тогда
			СтрТЗ.РегиональнаяБаза = Справочники.СМ_СметноНормативныеБазы.НайтиПоКоду(Тег.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

