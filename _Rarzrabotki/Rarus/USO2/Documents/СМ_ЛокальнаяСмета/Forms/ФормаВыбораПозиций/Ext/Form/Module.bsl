#Область ОбработчикиСобытийФормы	

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	Если Не Параметры.Свойство("ТаблицаВыбораНС") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Норм Из Параметры.ТаблицаВыбораНС Цикл
		 Стр = ТаблицаВыбораНС.Добавить();
		 Стр.Ссылка = Норм;
		 Стр.Шифр = Норм.Код;
		 Стр.Наименование = Норм.Наименование;
		 Стр.ЕдиницаИзмерения = Норм.ЕдиницаИзмерения;
		 Стр.Количество = 0;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	Закрыть(ТаблицаВыбораНС);
КонецПроцедуры

#КонецОбласти

