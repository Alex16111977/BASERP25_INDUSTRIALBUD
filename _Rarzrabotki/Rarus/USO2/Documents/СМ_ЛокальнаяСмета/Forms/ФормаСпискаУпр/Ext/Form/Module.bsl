
#Область ПриСоздании

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	//ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

#КонецОбласти

#Область Выгрузка

&НаКлиенте
Процедура ВыгрузкаЗагрузкаАРПС(Команда)
	
	СтруктураПараметров = Новый Структура;
	ТекДанные 	= Элементы.Список.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ТекСмета = ТекДанные.Ссылка;
		СтруктураПараметров.Вставить("Смета",ТекСмета);
	КонецЕсли;
	ОткрытьФорму("Обработка.СМ_ОбменДаннымиВФорматеАРПС.Форма",СтруктураПараметров);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузкаВMSP(Команда)
	СтруктураПараметров = Новый Структура;
	ТекДанные 	= Элементы.Список.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ТекСмета = ТекДанные.Ссылка;
		СтруктураПараметров.Вставить("Смета",ТекСмета);
	КонецЕсли;
	ОткрытьФорму("Обработка.СМ_MSP_НастройкаСинхронизации.Форма.ФормаВыгрузки",СтруктураПараметров);
КонецПроцедуры

#КонецОбласти

#Область ПодключаемыеКоманды

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Элементы.Список);
	
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат)
	
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Элементы.Список, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

