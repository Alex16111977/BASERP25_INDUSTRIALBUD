// Формирует печатные формы.
// ПАРАМЕТРЫ:
//  МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                          представление - имя области в которой был выведен объект (выходной параметр);
//  ПараметрыВывода - Структура - дополнительные параметры сформированных табличных документов (выходной параметр).
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	СМ_СметаПечатьВызовСервера.ПечатьЛокальнойСметы(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);     
		
	ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;
		
КонецПроцедуры

#КонецОбласти

#Область ПредставлениеОбъекта

// ДокторСофт
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
     СтандартнаяОбработка = Ложь;
     Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Смета №%1 %2'"),Строка(Данные.НомерСметы),Строка(Данные.Наименование));
 КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

     Поля.Добавить("НомерСметы");
	 Поля.Добавить("Наименование");
	 
 КонецПроцедуры
// ДокторСофт

#КонецОбласти

#Область ПроверкаЗаполненияПозиций

Процедура ПроверкаПозиций(ПараметрыВызоваСервера, АдресХранилища) Экспорт
	
	Смета = ПараметрыВызоваСервера.Смета;
	
	ТаблицаОшибок = СобратьДанные(Смета);
	Если ТаблицаОшибок.Количество() = 0 Тогда
		ТабДок = Неопределено;
	Иначе
		ТабДок = Новый ТабличныйДокумент;
		Макет = Документы.СМ_ЛокальнаяСмета.ПолучитьМакет("ПФ_MXL_ПРОТОКОЛ");
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ОбластьМакета.Параметры.НомерЛС = Смета.НомерСметы;
		ТабДок.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Строки");
		Для Каждого стр Из ТаблицаОшибок Цикл
			ОбластьМакета.Параметры.Заполнить(стр);
			ТабДок.Вывести(ОбластьМакета);
		КонецЦикла;
		
		ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
		ТабДок.Вывести(ОбластьМакета);
		ТабДок.Защита = Истина;
		ТабДок.ОтображатьЗаголовки = Ложь;
		ТабДок.ОтображатьСетку = Ложь;
		ТабДок.АвтоМасштаб = Истина;
	КонецЕсли;
	Структура = Новый Структура("ТабДок",ТабДок);
	АдресХранилища = ПоместитьВоВременноеХранилище(Структура, АдресХранилища);
	
КонецПроцедуры

Функция СобратьДанные(Смета)
	
    ТаблицаОшибок = Новый ТаблицаЗначений;
	ТаблицаОшибок.Колонки.Добавить("Номер");
	ТаблицаОшибок.Колонки.Добавить("Позиция");
	ТаблицаОшибок.Колонки.Добавить("Наименование");
	ТаблицаОшибок.Колонки.Добавить("Описание");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Раздел,
	               |	СМ_НумерацияПозицийЛокальныхСмет.Позиция,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
	               |ПОМЕСТИТЬ Номера
	               |ИЗ
	               |	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |ГДЕ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Смета = &ИДСметы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СМ_ПозицияЛокальнойСметы.Ссылка,
	               |	СМ_ПозицияЛокальнойСметы.Наименование,
	               |	Номера.ПорНомер КАК ПорНомер
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Номера КАК Номера
	               |		ПО (Номера.Позиция = СМ_ПозицияЛокальнойСметы.Ссылка)
	               |			И (Номера.Раздел = СМ_ПозицияЛокальнойСметы.ИДРодителя)
	               |ГДЕ
	               |	СМ_ПозицияЛокальнойСметы.ИДСметы = &ИДСметы
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПорНомер";
	Запрос.УстановитьПараметр("ИДСметы",Смета);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Описание = "";
		
		Если Не ЗначениеЗаполнено(СокрЛП(Выборка.Ссылка.ШифрРасценки)) Тогда
			Описание = "Шифр расценки"
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Выборка.Ссылка.Определитель) Тогда
			Описание = Описание+?(ЗначениеЗаполнено(Описание),", Определитель","Определитель");
		КонецЕсли;
		Если Выборка.Ссылка.ОбъемРабот = 0 Тогда
			Описание = Описание+?(ЗначениеЗаполнено(Описание),", Объем работ","Объем работ")
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Выборка.Ссылка.ЕдиницаИзмерения) Тогда
			Описание = Описание+?(ЗначениеЗаполнено(Описание),", Единица измерения","Единица измерения");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Описание) Тогда
			Продолжить;
		КонецЕсли;
		
		НовСтрока = ТаблицаОшибок.Добавить();
		НовСтрока.Номер = Выборка.ПорНомер;
		НовСтрока.Позиция = Выборка.Ссылка;
		НовСтрока.Наименование = СокрЛП(Выборка.Наименование);
		НовСтрока.Описание = Описание;
		
	КонецЦикла;
	
	Возврат ТаблицаОшибок;
КонецФункции

#КонецОбласти

#КонецЕсли



