#Область РасчетСметы

Процедура ВыполнитьРасчетТекущейЛокальнойСметы(Ссылка)
	
	СМ_СметаРасчетВызовСервера.СформироватьИтогиПоВидамРабот(Ссылка);
	СМ_СметаРасчетВызовСервера.СформироватьИтогиПоСмете(Ссылка);	
	СМ_СметаРасчетВызовСервера.РассчитатьЛимитированныеЗатраты(Ссылка);
	
КонецПроцедуры

Процедура ВыполнитьРасчет(ОбъектСмета, РазделыУжеРассчитаны = Ложь)
	
	Если Не РазделыУжеРассчитаны Тогда
		
		// Получаем подчиненные разделу позиции локальной сметы
		ТабРезультат = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(ОбъектСмета.Ссылка, Ложь, Истина, Истина, Ложь);
		Для Каждого ТекСтрока Из ТабРезультат Цикл
			// Пересчитываем позиции локальной сметы
			ТекОбъект = ТекСтрока.Ид.ПолучитьОбъект();
			Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(ТекОбъект, Истина);
		КонецЦикла;
		
		// Получаем подчиненные разделу позиции локальной сметы
		ТабРезультат = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(ОбъектСмета.Ссылка, Истина, Ложь, Ложь, Ложь);
		Для Каждого ТекСтрока Из ТабРезультат Цикл
			// Пересчитываем разделы локальной сметы
			ТекОбъект = ТекСтрока.Ид.ПолучитьОбъект();
			Документы.СМ_РазделЛокальнойСметы.Перерасчет(ТекОбъект, Ложь, Истина);
		КонецЦикла;
		
	КонецЕсли;
	
	// СУДАРИКОВ - программист, прежде чем менять - подумай трижды нужно ли подвязываться на проведение сметы!
	ВыполнитьРасчетТекущейЛокальнойСметы(ОбъектСмета.Ссылка);
	
КонецПроцедуры

// Основная процедура расчета сметы, выполняет пересчет сметы.
//
// Параметры:
// 		Объект 					- ДокументОбъект.СМ_ЛокальнаяСмета или ДокументСсылка.СМ_ЛокальнаяСмета.
//  	РазделыУжеРассчитаны 	- Истина - разделы уже рассчитаны и их пересчет не требуется, 
//  					   		  Ложь - требуется пересчет подчиненных разделов.
//
Процедура Перерасчет(Объект, РазделыУжеРассчитаны = Ложь, ВключаяПодчиненные = Истина, СоздаватьВерсию = Истина) Экспорт
	
	ВыполнитьРасчет(Объект, РазделыУжеРассчитаны);
	
	Сохраняем = СМ_ВерсионированиеВызовСервера.СохранятьПриПересчете();
	Если Сохраняем И СоздаватьВерсию Тогда
		СМ_ВерсионированиеВызовСервера.ЗаписатьВерсиюОбъекта(Объект.Ссылка);
	КонецЕсли;
	
	Если Константы.СМ_ПересчитыватьОСиСС.Получить() И ВключаяПодчиненные Тогда
		СписокОС = ПолучитьОС(Объект.Ссылка);
		Для Каждого эл Из СписокОС Цикл
			Документы.СМ_ОбъектнаяСмета.Перерасчет(эл,Истина);
		КонецЦикла;
		
		СписокСС = ПолучитьСС(Объект.Ссылка,СписокОС);
		Для Каждого эл Из СписокСС Цикл
			Документы.СМ_СводнаяСмета.Перерасчет(эл,Истина);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьОС(Смета)
	МассивСмет = Новый Массив;
	МассивСмет.Добавить(Смета);
	
	ВключитьОбъекты = Новый Массив;
	ВключитьОбъекты.Добавить(Метаданные.Документы.СМ_ОбъектнаяСмета);
	
	ТабСсылок = НайтиПоСсылкам(МассивСмет, Новый Массив, ВключитьОбъекты);	
	Возврат ТабСсылок.ВыгрузитьКолонку("Данные");
КонецФункции

Функция ПолучитьСС(Смета,МассивСмет)
	МассивСмет.Добавить(Смета);
	
	ВключитьОбъекты = Новый Массив;
	ВключитьОбъекты.Добавить(Метаданные.Документы.СМ_СводнаяСмета);
	
	ТабСсылок = НайтиПоСсылкам(МассивСмет, Новый Массив, ВключитьОбъекты);	
	Возврат ТабСсылок.ВыгрузитьКолонку("Данные");
КонецФункции

