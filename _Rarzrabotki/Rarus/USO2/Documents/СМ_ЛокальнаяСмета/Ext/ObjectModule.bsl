
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Переменные

Перем ПометкаУдаленияДо;
Перем СуществуютАкты;// ДокторСофт

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка  Тогда
		Возврат;
	КонецЕсли;
	
	Архив = (Ссылка.Статус = Перечисления.СМ_СтатусыСметныхДокументов.Архив И Не Пользователи.РолиДоступны("СМ_АдминистраторСмета, ПолныеПрава",,Ложь));
	Если Архив Тогда
		Отказ = Истина;
	КонецЕсли;
	
	СМ_ВерсионированиеСервер.ОбработатьОбъект(ЭтотОбъект,РежимЗаписи);
	
	// Запоминаем состояние пометки удаления до изменения. 
	СуществуютАкты = СМ_УчетВыполненныхРаботВызовСервера.СуществуютАктыПоСмете(Ссылка); // ДокторСофт
	ПометкаУдаленияДо = Ссылка.ПометкаУдаления;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка  Тогда
		Возврат;
	КонецЕсли;

	Если (СуществуютАкты) И (ЭтотОбъект.ПометкаУдаления = ПометкаУдаленияДо) Тогда //ДокторСофт
		Возврат;		
	КонецЕсли;
	
	Если ЭтотОбъект.ПометкаУдаления <> ПометкаУдаленияДо Тогда
		// Устанавливаем пометку удаления
		СМ_СметаВызовСервера.УстановитьСнятьПометкуУдаления(ЭтотОбъект, Не ЭтотОбъект.ПометкаУдаления, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если СуществуютАкты
		И Не СМ_СметаВызовСервера.ЗначениеОпции("СМ_РазрешитьРедактированиеЗакрытыхСмет")
		И Не ДополнительныеСвойства.Свойство("ЗагрузкаГранд") Тогда // ДокторСофт
		Возврат;
	КонецЕсли;

	// sudav - вынесено в модуль менеджера
	Документы.СМ_ЛокальнаяСмета.Перерасчет(ЭтотОбъект);
	
	// регистр ВыполнениеПоСмете Приход
	Движения.СМ_ВыполнениеПоСмете.Записывать = Истина;
	
	СсылкаНаТекущийДокумент = СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(ЭтотОбъект);
	
	ТабПозиций = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(СсылкаНаТекущийДокумент, Ложь, Истина, Истина, Истина);
	
	СМ_УчетВыполненныхРаботВызовСервера.ЗаполнитьПлановыйПриход(Движения.СМ_ВыполнениеПоСмете, ТабПозиций, СсылкаНаТекущийДокумент);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ) Экспорт
	
	// sudav - вынесено в модуль менеджера
	Документы.СМ_ЛокальнаяСмета.Перерасчет(ЭтотОбъект);
	
	СМ_УчетВыполненныхРаботВызовСервера.ЗаполнитьПлановыйПриход(Движения.СМ_ВыполнениеПоСмете, Новый ТаблицаЗначений());	

КонецПроцедуры

#КонецОбласти

#КонецЕсли
