#Область Прочее

Функция ПроверитьНаИзменеияВРегистреДанныеРеестраДоговоров(ПараметрыПоиска)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Договор", ПараметрыПоиска.Договор);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УСОERP_ДанныеРеестраДоговоровСрезПоследних.Организация,
	               |	УСОERP_ДанныеРеестраДоговоровСрезПоследних.ОбъектСтроительства,
	               |	УСОERP_ДанныеРеестраДоговоровСрезПоследних.Контрагент,
	               |	УСОERP_ДанныеРеестраДоговоровСрезПоследних.ПервоначальнаяСуммаПоДоговоруСНДС,
	               |	УСОERP_ДанныеРеестраДоговоровСрезПоследних.ТекущаяСуммаПоДоговоруСНДС,
	               |	УСОERP_ДанныеРеестраДоговоровСрезПоследних.НачалоРасчетаПБУ,
	               |	УСОERP_ДанныеРеестраДоговоровСрезПоследних.ОкончаниеРасчетаПБУ,
	               |	УСОERP_ДанныеРеестраДоговоровСрезПоследних.СпособРасчетаВыручкиПоПБУ
	               |ИЗ
	               |	РегистрСведений.УСОERP_ДанныеРеестраДоговоров.СрезПоследних(
	               |			&Дата,
	               |			Договор = &Договор
	               |				И Организация = &Организация) КАК УСОERP_ДанныеРеестраДоговоровСрезПоследних";
	РезультатПоиска = Запрос.Выполнить().Выбрать();			   
	Если РезультатПоиска.Следующий() Тогда
		Если РезультатПоиска.ОбъектСтроительства = ПараметрыПоиска.ОбъектСтроительства
			И РезультатПоиска.ПервоначальнаяСуммаПоДоговоруСНДС = ПараметрыПоиска.ПервоначальнаяСуммаПоДоговоруСУчетомНДС
			И РезультатПоиска.ТекущаяСуммаПоДоговоруСНДС = ПараметрыПоиска.ТекущаяСуммаПоДоговоруСУчетомНДС
			И РезультатПоиска.НачалоРасчетаПБУ = ПараметрыПоиска.НачалоРасчетаПБУ_2_2008
			И РезультатПоиска.ОкончаниеРасчетаПБУ = ПараметрыПоиска.ОкончаниеРасчетаПБУ_2_2008
			И РезультатПоиска.СпособРасчетаВыручкиПоПБУ = ПараметрыПоиска.СпособРасчетаВыручкиПБУ_2_2008 
			Тогда
				Возврат Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Истина;
КонецФункции	

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если ЭтотОбъект.СостояниеСогласования = Перечисления.УСОERP_СтатусыСогласованияДокументов.Согласован Тогда
		Для каждого стрДоговор из ЭтотОбъект.Договора Цикл
			//ПараметрыПроверки = Новый Структура;
			//ПараметрыПроверки.Вставить("Договор", стрДоговор.Договор);
			//ПараметрыПроверки.Вставить("Организация", ЭтотОбъект.Организация);
			//ПараметрыПроверки.Вставить("ОбъектСтроительства", стрДоговор.ОбъектСтроительства);
			//ПараметрыПроверки.Вставить("Контрагент", стрДоговор.Заказчик);
			//ПараметрыПроверки.Вставить("ПервоначальнаяСуммаПоДоговоруСНДС
			Если ПроверитьНаИзменеияВРегистреДанныеРеестраДоговоров(стрДоговор)Тогда
				
				Движения.УСОERP_ДанныеРеестраДоговоров.Записывать = Истина;
				
				зРеестраДоговоров = Движения.УСОERP_ДанныеРеестраДоговоров.Добавить();
				
				зРеестраДоговоров.Период							= ЭтотОбъект.Дата;
				зРеестраДоговоров.Регистратор						= Ссылка;
				зРеестраДоговоров.Договор 							= стрДоговор.Договор;
				зРеестраДоговоров.Контрагент    					= стрДоговор.Заказчик;
				зРеестраДоговоров.ОбъектСтроительства				= стрДоговор.ОбъектСтроительства;
				зРеестраДоговоров.НачалоРасчетаПБУ					= стрДоговор.НачалоРасчетаПБУ_2_2008;
				зРеестраДоговоров.ОкончаниеРасчетаПБУ				= стрДоговор.ОкончаниеРасчетаПБУ_2_2008;
				зРеестраДоговоров.Организация						= ЭтотОбъект.Организация;
				зРеестраДоговоров.ПервоначальнаяСуммаПоДоговоруСНДС	= стрДоговор.ПервоначальнаяСуммаПоДоговоруСУчетомНДС;
				зРеестраДоговоров.ТекущаяСуммаПоДоговоруСНДС		= стрДоговор.ТекущаяСуммаПоДоговоруСУчетомНДС;
				зРеестраДоговоров.СпособРасчетаВыручкиПоПБУ			= стрДоговор.СпособРасчетаВыручкиПБУ_2_2008;
				
			КонецЕсли;	
		КонецЦикла;
		//Движения.УСОERP_ДанныеРеестраДоговоров.Записать();
	КонецЕсли;	
КонецПроцедуры

