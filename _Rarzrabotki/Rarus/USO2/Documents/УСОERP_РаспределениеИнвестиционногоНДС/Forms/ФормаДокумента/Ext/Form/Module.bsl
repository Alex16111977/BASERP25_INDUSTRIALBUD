&НаСервере
Процедура ПерезаполнитьТабличныеЧасти(ТекущийОбъект = Неопределено)
	
	Если ТекущийОбъект = Неопределено Тогда
		Объект.ПринятиеКУчету.Очистить();
		Объект.СдачаИнвестору.Очистить();
		ДЗПринятиеКУчету.ПолучитьЭлементы().Очистить();
		ДЗСдачаИнвестору.ПолучитьЭлементы().Очистить();
		
		ОбработатьПодчиненныеСтрокиПриПерезаполнении(ДЗПринятиеКУчету, "ПринятиеКУчету");
		ОбработатьПодчиненныеСтрокиПриПерезаполнении(ДЗСдачаИнвестору, "СдачаИнвестору");
	Иначе
		ТекущийОбъект.ПринятиеКУчету.Очистить();
		ТекущийОбъект.СдачаИнвестору.Очистить();
		ОбработатьПодчиненныеСтрокиПриПерезаполнении(ДЗПринятиеКУчету, "ПринятиеКУчету", ТекущийОбъект); 
		ОбработатьПодчиненныеСтрокиПриПерезаполнении(ДЗСдачаИнвестору, "СдачаИнвестору", ТекущийОбъект);
	КонецЕсли;
	
КонецПроцедуры

