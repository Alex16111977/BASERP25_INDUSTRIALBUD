КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоПоРезультатуЗапроса(РезультатЗапроса, РеквизитФормы)
	
	ДеревоОбъект=РеквизитФормыВЗначение(РеквизитФормы, Тип("ДеревоЗначений"));
	ДеревоОбъект.Строки.Очистить();
	
	ДеревоРезультат=РезультатЗапроса.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ИтогоСуммаНДС_ПринятиеКУчету = 0;
	
	ЗаполнитьПодчиненныеСтроки(ДеревоОбъект, ДеревоРезультат, РеквизитФормы);
	ЗначениеВРеквизитФормы(ДеревоОбъект, РеквизитФормы);
	//Элементы[РеквизитФормы].НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодчиненныеСтроки(ПриемникРодитель, ИсточникРодитель, РеквизитФормы)
	
	Для Каждого СтрокаИсточника ИЗ ИсточникРодитель.Строки Цикл
		СтрокаПриемника=ПриемникРодитель.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПриемника,СтрокаИсточника);
		Если СтрокаИсточника.Уровень() = 0 Тогда
			СтрокаПриемника.ОбъектНедвижимости = СтрокаИсточника.ОбъектНедвижимости;
			СтрокаПриемника.ЭтоОбъектНедвижимости = Истина
		Иначе	
			Если РеквизитФормы = "ДЗСдачаИнвестору" Тогда
				СтрокаПриемника.НДСПоДДУ = 0;	
			Иначе
				СтрокаПриемника.ОбъектНедвижимости = СтрокаИсточника.Номенклатура;	
				ИтогоСуммаНДС_ПринятиеКУчету = ИтогоСуммаНДС_ПринятиеКУчету + СтрокаИсточника.СуммаНДС;
			КонецЕсли; 
		    СтрокаПриемника.СуммаЗатрат = 0;
			СтрокаПриемника.ПлощадьФактическая = 0;
		КонецЕсли; 
		
		ЗаполнитьПодчиненныеСтроки(СтрокаПриемника,СтрокаИсточника, РеквизитФормы);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДЗПринятиеКУчетуСуммаБезНДСПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ДЗПринятиеКУчету.ТекущиеДанные;
	ПересчитатьСуммуНДСВСтрокеТаблицы(ТекущаяСтрока, ПолучитьСтавкуНДСНаСервере(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ДокументПоступления));
	Родитель = ТекущаяСтрока.ПолучитьРодителя();
	Если Родитель<>Неопределено Тогда
		ОбновитьИтоговыеПоказателиПринятиеКУчету(Родитель);
	КонецЕсли;
	ОбновитьИтоговыеПоказателиСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ДЗПринятиеКУчетуСуммаНДСПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ДЗПринятиеКУчету.ТекущиеДанные;
	ПересчитатьСуммуБезНДСВСтрокеТаблицы(ТекущаяСтрока, ПолучитьСтавкуНДСНаСервере(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ДокументПоступления));

	Родитель = ТекущаяСтрока.ПолучитьРодителя();
	Если Родитель<>Неопределено Тогда
		ОбновитьИтоговыеПоказателиПринятиеКУчету(Родитель);
	КонецЕсли;
	ОбновитьИтоговыеПоказателиСервер();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуВТаблицуПриПерезаполнении(ЭлементДерева, ИмяТаблицы, ТекущийОбъект = Неопределено)
	
	Родитель=ЭлементДерева.ПолучитьРодителя();
	Если Родитель<>Неопределено Тогда

		Если ТекущийОбъект = Неопределено Тогда
			НоваяСтрока = Объект[ИмяТаблицы].Добавить();
		Иначе
			НоваяСтрока = ТекущийОбъект[ИмяТаблицы].Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементДерева);
		НоваяСтрока.ПлощадьФактическая = Родитель.ПлощадьФактическая;
		НоваяСтрока.СуммаЗатрат        = Родитель.СуммаЗатрат;
		Если ИмяТаблицы = "ПринятиеКУчету" Тогда
			НоваяСтрока.ОбъектНедвижимости = Родитель.ОбъектНедвижимости;
		Иначе	
			НоваяСтрока.НДСПоДДУ        = Родитель.НДСПоДДУ;
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьПодчиненныеСтрокиПриПерезаполнении(ЭлементДереваРодитель, ИмяТаблицы, ТекущийОбъект = Неопределено)
	ЭлементыДерева=ЭлементДереваРодитель.ПолучитьЭлементы();
	Для Каждого ЭлементДерева ИЗ ЭлементыДерева Цикл
		Если ЭлементДерева.ЭтоОбъектНедвижимости Тогда
			ОбработатьПодчиненныеСтрокиПриПерезаполнении(ЭлементДерева, ИмяТаблицы, ТекущийОбъект);
		Иначе
			ДобавитьСтрокуВТаблицуПриПерезаполнении(ЭлементДерева, ИмяТаблицы, ТекущийОбъект);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура НДСИнвестиционныйНоменклатураПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.НДСИнвестиционный.ТекущиеДанные;
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС"));
	ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
    ПересчитатьСуммуНДСВСтрокеТаблицы(ТекущаяСтрока, ТекущаяСтрока.СтавкаНДС);

КонецПроцедуры

&НаКлиенте
Процедура ДЗПринятиеКУчетуПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДЗСдачаИнвесторуВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.ДЗСдачаИнвестору.ТекущиеДанные;
	Если Поле.Имя = "ДЗСдачаИнвесторуСчетФактура" И ЗначениеЗаполнено(ТекСтрока.СчетФактура) Тогда
		ПоказатьЗначение(,ТекСтрока.СчетФактура);
	КонецЕсли;
	
КонецПроцедуры


