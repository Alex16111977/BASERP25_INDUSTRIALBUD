&НаКлиентеНаСервереБезКонтекста
// Процедура пересчитывает поле ввода "Сумма без НДС" в строке табл. части по данным ставки НДС и суммы НДС.
//
Процедура ПересчитатьСуммуБезНДСВСтрокеТаблицы(СтрокаТаблицы, СтавкаНДС)
	
	ТекущийПроцентНДС		  = ЦенообразованиеКлиентСервер.ПолучитьСтавкуНДСЧислом(СтавкаНДС);
	СтрокаТаблицы.СуммаБезНДС = ?(ТекущийПроцентНДС = 0, 0, СтрокаТаблицы.СуммаНДС / ТекущийПроцентНДС); 
	
КонецПроцедуры // ПересчитатьСуммуБезНДСВСтрокеТаблицы()

&НаКлиентеНаСервереБезКонтекста
// Процедура пересчитывает поле ввода "Сумма без НДС" в строке табл. части по данным ставки НДС и суммы НДС.
//
Процедура ПересчитатьСуммуНДСВСтрокеТаблицы(СтрокаТаблицы, СтавкаНДС) 	
	
	СтрокаТаблицы.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СтрокаТаблицы.СуммаБезНДС, СтавкаНДС, Ложь);
	
КонецПроцедуры // ПересчитатьСуммуНДСВСтрокеТаблицы()

&НаСервере
Процедура ОбновитьИтоговыеПоказателиСервер()
	
	ДеревоОбъект = РеквизитФормыВЗначение("ДЗПринятиеКУчету",Тип("ДеревоЗначений"));
	ИтогоСуммаНДС_ПринятиеКУчету    = ДеревоОбъект.Строки.Итог("СуммаНДС");
	ИтогоСуммаБезНДС_ПринятиеКУчету = ДеревоОбъект.Строки.Итог("СуммаБезНДС");
	
	ДеревоОбъект = РеквизитФормыВЗначение("ДЗСдачаИнвестору",Тип("ДеревоЗначений"));
	ИтогоСуммаНДС_СдачаИнвестору                 = ДеревоОбъект.Строки.Итог("СуммаНДС");
	ИтогоСуммаБезНДС_СдачаИнвестору              = ДеревоОбъект.Строки.Итог("СуммаБезНДС");
	ИтогоСуммаБезНДСПрочиеРасходы_СдачаИнвестору = ДеревоОбъект.Строки.Итог("СуммаБезНДСПрочиеРасходы");
	ИтогоСуммаНДСПрочиеРасходы_СдачаИнвестору    = ДеревоОбъект.Строки.Итог("СуммаНДСПрочиеРасходы");
	
	ДеревоОбъект=Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтоговыеПоказателиПринятиеКУчету(Родитель)
	
	ЭлементыРодителя=Родитель.ПолучитьЭлементы();
	ИтогоСуммаНДС = 0;
	ИтогоСуммаБезНДС = 0;
	Для Каждого ЭлементРодителя ИЗ ЭлементыРодителя Цикл
		ИтогоСуммаНДС = ИтогоСуммаНДС + ЭлементРодителя.СуммаНДС;
		ИтогоСуммаБезНДС = ИтогоСуммаБезНДС + ЭлементРодителя.СуммаБезНДС;
	КонецЦикла;
	Родитель.СуммаНДС    = ИтогоСуммаНДС;
	Родитель.СуммаБезНДС = ИтогоСуммаБезНДС;

КонецПроцедуры

&НаСервере
Функция ПолучитьСтавкуНДСНаСервере(Номенклатура, ДокументПоступления)

	мсСтрок = Объект.НДСИнвестиционный.НайтиСтроки(Новый Структура("Номенклатура, ДокументПоступления", Номенклатура, ДокументПоступления));
	Если мсСтрок.Количество() > 0  Тогда
		возврат мсСтрок[0].СтавкаНДС;
	Иначе	
		Возврат Перечисления.СтавкиНДС.НДС18;	
	КонецЕсли; 

КонецФункции // ()

