&НаСервере
Процедура СоздатьСчетФактурыНаСервере()
	
	СписокОбъектовНедвижимости = Объект.СдачаИнвестору.Выгрузить( , "ОбъектНедвижимости, Контрагент, Договор, СчетФактура");
	СписокОбъектовНедвижимости.Свернуть("ОбъектНедвижимости, Контрагент, Договор, СчетФактура");
	
	Для Каждого ТекСтрока Из СписокОбъектовНедвижимости Цикл
		
		СтрокиПоОбъектуНедвижимости = Объект.СдачаИнвестору.НайтиСтроки(Новый Структура("ОбъектНедвижимости, Контрагент, Договор, СчетФактура", ТекСтрока.ОбъектНедвижимости, ТекСтрока.Контрагент, ТекСтрока.Договор, ТекСтрока.СчетФактура));
		
		Попытка
			
			Если ЗначениеЗаполнено(ТекСтрока.СчетФактура) Тогда
				НоваяСчетФактура = ТекСтрока.СчетФактура.ПолучитьОбъект();
			Иначе
				НоваяСчетФактура = Документы.СчетФактураВыданный.СоздатьДокумент();
				НоваяСчетФактура.Ответственный = Пользователи.ТекущийПользователь();
			КонецЕсли;
			
			НоваяСчетФактура.Дата = Объект.Дата;
			НоваяСчетФактура.Организация = Объект.Организация;
			НоваяСчетФактура.Контрагент = ТекСтрока.Контрагент;
			НоваяСчетФактура.ДокументОснование = Объект.Ссылка;
			НоваяСчетФактура.КодВидаОперации = 27;
			НоваяСчетФактура.Валюта = ТекСтрока.Договор.ВалютаВзаиморасчетов;
			НоваяСчетФактура.ДатаВыставления = Объект.Дата;
			
			СтрокаОснования = НоваяСчетФактура.ДокументыОснования.Добавить();
			СтрокаОснования.ДокументОснование = Объект.Ссылка;
			
			НоваяСчетФактура.Записать(РежимЗаписиДокумента.Запись);
			
			Для Каждого СтрокаСчетФактуры Из СтрокиПоОбъектуНедвижимости Цикл
				СтрокаСчетФактуры.СчетФактура = НоваяСчетФактура.Ссылка;
			КонецЦикла;
			
		Исключение
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЦикла;
	
	ЗаполнитьДеревоСдачаИнвестору();	
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьСчетФактуры(Команда)
	
	Если НЕ Объект.Проведен ИЛИ Модифицированность Тогда
		ПоказатьПредупреждение(,"Необходимо провести документ!");
		Возврат;
	КонецЕсли;
		
	СоздатьСчетФактурыНаСервере();
	
	ОбщегоНазначенияУТКлиент.Записать(ЭтаФорма, Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнвестиционныйНДСПоОстаткамНаСервере()
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	Запрос.УстановитьПараметр("ОбъектСтроительства",Объект.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Дата",Новый Граница(Объект.Дата,ВидГраницы.Включая));
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_НДСИнвестиционныйОстатки.Контрагент,
	|	УСОERP_НДСИнвестиционныйОстатки.ДокументПоступления,
	|	УСОERP_НДСИнвестиционныйОстатки.Номенклатура,
	|	УСОERP_НДСИнвестиционныйОстатки.СчетУчетаНДС,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18) КАК СтавкаНДС,
	|	УСОERP_НДСИнвестиционныйОстатки.СуммаБезНДСОстаток КАК СуммаБезНДС,
	|	УСОERP_НДСИнвестиционныйОстатки.СуммаНДСОстаток КАК СуммаНДС,
	|	0 КАК СуммаНДСПринятиеКУчету,
	|	УСОERP_НДСИнвестиционныйОстатки.СуммаНДСОстаток КАК СуммаНДСПередачаИнвестору
	|ИЗ
	|	РегистрНакопления.УСОERP_НДСИнвестиционный.Остатки(
	|			&Дата,
	|			Организация = &Организация
	|				И ОбъектСтроительства = &ОбъектСтроительства) КАК УСОERP_НДСИнвестиционныйОстатки";
	
	Объект.НДСИнвестиционный.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

