&НаСервере
Процедура ЗаполнитьИнвестиционныйНДСНаСервере(РасчетПоСуммеЗатрат, СтруктураОбъектаСтроительства)

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Организация",         Объект.Организация);
	СтруктураПараметров.Вставить("ОбъектСтроительства", Объект.ОбъектСтроительства);
	СтруктураПараметров.Вставить("ДокументОснование",   Объект.ДокументОснование);
	СтруктураПараметров.Вставить("НачалоПериода",       НачалоМесяца(Объект.Дата));
	СтруктураПараметров.Вставить("КонецПериода",        КонецМесяца(Объект.Дата));
	СтруктураПараметров.Вставить("Дата",                Объект.Дата);
	СтруктураПараметров.Вставить("НачалоСтроительства",    НачалоДня(СтруктураОбъектаСтроительства.НачалоСтроительства));
	СтруктураПараметров.Вставить("ОкончаниеСтроительства", КонецДня(СтруктураОбъектаСтроительства.ОкончаниеСтроительства));
	
	ИтогоПлощадьФактическаяПринятиеКУчету = Объект.ДокументОснование.ПринятиеКУчету.Итог("ПлощадьФактическая");
	ИтогоСуммаЗатратПринятиеКУчету        = Объект.ДокументОснование.ПринятиеКУчету.Итог("СуммаЗатрат");
	
	ИтогоПлощадьФактическаяСдачаИнвестору = Объект.ДокументОснование.СдачаИнвестору.Итог("ПлощадьФактическая");
	ИтогоСуммаЗатратСдачаИнвестору        = Объект.ДокументОснование.СдачаИнвестору.Итог("СуммаЗатрат");
	
	ИтогоПлощадьФактическая = ИтогоПлощадьФактическаяПринятиеКУчету + ИтогоПлощадьФактическаяСдачаИнвестору;
	ИтогоСуммаЗатрат        = ИтогоСуммаЗатратПринятиеКУчету + ИтогоСуммаЗатратСдачаИнвестору;
	
	СтруктураПараметров.Вставить("ИтогоПлощадьФактическая",               ИтогоПлощадьФактическая);
	СтруктураПараметров.Вставить("ИтогоСуммаЗатрат",                      ИтогоСуммаЗатрат);
	СтруктураПараметров.Вставить("ИтогоПлощадьФактическаяПринятиеКУчету", ИтогоПлощадьФактическаяПринятиеКУчету);
	СтруктураПараметров.Вставить("ИтогоСуммаЗатратПринятиеКУчету",        ИтогоСуммаЗатратПринятиеКУчету);
	СтруктураПараметров.Вставить("ИтогоПлощадьФактическаяСдачаИнвестору", ИтогоПлощадьФактическаяСдачаИнвестору);
	СтруктураПараметров.Вставить("ИтогоСуммаЗатратСдачаИнвестору",        ИтогоСуммаЗатратСдачаИнвестору);
	
	СтруктураПараметров.Вставить("РасчетПоСуммеЗатрат", РасчетПоСуммеЗатрат);
	
	СтруктураТаблиц = Документы.УСОERP_РаспределениеИнвестиционногоНДС.ПолучитьДанныеЗаполненияИнвестиционныйНДС(СтруктураПараметров);
	
	Объект.НДСИнвестиционный.Загрузить(СтруктураТаблиц.ИнвестиционныйНДС);
	Объект.ПринятиеКУчету.Загрузить(СтруктураТаблиц.ПринятиеКУчету);
	Объект.СдачаИнвестору.Загрузить(СтруктураТаблиц.СдачаИнвестору);
	
	ЗаполнитьДеревоПринятиеКУчету();
	ЗаполнитьДеревоСдачаИнвестору();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИнвестиционныйНДСЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
	ОтветНаВопрос = РезультатВопроса;
	Если ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
	    Возврат;
	КонецЕсли;
	СтруктураОбъектаСтроительства = ПроверитьОбъектСтроительства();
	ЗаполнитьИнвестиционныйНДСНаСервере(ДополнительныеПараметры, СтруктураОбъектаСтроительства);
    ОбновитьИтоговыеПоказателиСервер();
	РазвернутьДеревья();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИнвестиционныйНДСПоСуммеЗатрат(Команда)
	
	ЗаполнитьИнвестиционныйНДСНаКлиенте(Истина);
	
КонецПроцедуры

