&НаСервере
Процедура РаспределитьИнвестиционныйНДСНаСервере(РаспределятьПоСуммеЗатрат)	
	
	СтруктураОбъектаСтроительства = ПроверитьОбъектСтроительства();
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Организация",         Объект.Организация);
	СтруктураПараметров.Вставить("ОбъектСтроительства", Объект.ОбъектСтроительства);
	СтруктураПараметров.Вставить("ДокументОснование",   Объект.ДокументОснование);
	СтруктураПараметров.Вставить("НачалоПериода",       НачалоМесяца(Объект.Дата));
	СтруктураПараметров.Вставить("КонецПериода",        КонецМесяца(Объект.Дата));
	СтруктураПараметров.Вставить("Дата",                Объект.Дата);
	СтруктураПараметров.Вставить("НачалоСтроительства",    НачалоДня(СтруктураОбъектаСтроительства.НачалоСтроительства));
	СтруктураПараметров.Вставить("ОкончаниеСтроительства", КонецДня(СтруктураОбъектаСтроительства.ОкончаниеСтроительства));
	
	ИтогоПлощадьФактическаяПринятиеКУчету = Объект.ДокументОснование.ПринятиеКУчету.Итог("ПлощадьФактическая");
	ИтогоСуммаЗатратПринятиеКУчету        = Объект.ДокументОснование.ПринятиеКУчету.Итог("СуммаЗатрат");
	
	ИтогоПлощадьФактическаяСдачаИнвестору = Объект.ДокументОснование.СдачаИнвестору.Итог("ПлощадьФактическая");
	ИтогоСуммаЗатратСдачаИнвестору        = Объект.ДокументОснование.СдачаИнвестору.Итог("СуммаЗатрат");
	
	ИтогоПлощадьФактическая = ИтогоПлощадьФактическаяПринятиеКУчету + ИтогоПлощадьФактическаяСдачаИнвестору;
	ИтогоСуммаЗатрат        = ИтогоСуммаЗатратПринятиеКУчету + ИтогоСуммаЗатратСдачаИнвестору;
	
	СтруктураПараметров.Вставить("ИтогоПлощадьФактическая",               ИтогоПлощадьФактическая);
	СтруктураПараметров.Вставить("ИтогоСуммаЗатрат",                      ИтогоСуммаЗатрат);
	СтруктураПараметров.Вставить("ИтогоПлощадьФактическаяПринятиеКУчету", ИтогоПлощадьФактическаяПринятиеКУчету);
	СтруктураПараметров.Вставить("ИтогоСуммаЗатратПринятиеКУчету",        ИтогоСуммаЗатратПринятиеКУчету);
	СтруктураПараметров.Вставить("ИтогоПлощадьФактическаяСдачаИнвестору", ИтогоПлощадьФактическаяСдачаИнвестору);
	СтруктураПараметров.Вставить("ИтогоСуммаЗатратСдачаИнвестору",        ИтогоСуммаЗатратСдачаИнвестору);
	
	СтруктураПараметров.Вставить("РасчетПоСуммеЗатрат", РаспределятьПоСуммеЗатрат); 	
	
	СтруктураТаблиц = Документы.УСОERP_РаспределениеИнвестиционногоНДС.ПолучитьДанныеЗаполненияИнвестиционныйНДС(СтруктураПараметров);
	
	Объект.ПринятиеКУчету.Загрузить(СтруктураТаблиц.ПринятиеКУчету);
	Объект.СдачаИнвестору.Загрузить(СтруктураТаблиц.СдачаИнвестору);
	
	
	ТЗПринятиеКУчетуОригинал = Объект.ПринятиеКУчету.Выгрузить();
	ТЗПринятиеКУчетуОригинал.ЗаполнитьЗначения("", "ДокументПоступления");
	ТЗПринятиеКУчетуОригинал.ЗаполнитьЗначения(0, "СуммаБезНДС");
	ТЗПринятиеКУчетуОригинал.ЗаполнитьЗначения(0, "СуммаНДС");
	ТЗПринятиеКУчетуОригинал.ЗаполнитьЗначения("", "СчетСписанияНДС");
	ТЗПринятиеКУчетуОригинал.Свернуть("ОбъектНедвижимости, Номенклатура, ПлощадьФактическая, СуммаЗатрат, СчетУчетаНДС, ДокументПоступления, СчетСписанияНДС, СуммаБезНДС, СуммаНДС");
	
	ТЗПринятиеКУчету = Объект.ПринятиеКУчету.Выгрузить();
	ТЗПринятиеКУчету.Очистить();
	
	ТЗСдачаИнвесторуОригинал = Объект.СдачаИнвестору.Выгрузить();
	ТЗСдачаИнвесторуОригинал.ЗаполнитьЗначения("", "ДокументПоступления");
	ТЗСдачаИнвесторуОригинал.ЗаполнитьЗначения(0, "СуммаБезНДС");
	ТЗСдачаИнвесторуОригинал.ЗаполнитьЗначения(0, "СуммаНДС");
	ТЗСдачаИнвесторуОригинал.ЗаполнитьЗначения(0, "СуммаБезНДСПрочиеРасходы");
	ТЗСдачаИнвесторуОригинал.ЗаполнитьЗначения(0, "СуммаНДСПрочиеРасходы");
	
	ТЗСдачаИнвесторуОригинал.Свернуть("ОбъектНедвижимости, ПлощадьФактическая, СуммаЗатрат, НДСПоДДУ, ДокументПоступления, СуммаБезНДС, СуммаНДС, СуммаБезНДСПрочиеРасходы, СуммаНДСПрочиеРасходы, СчетРасчетов, Контрагент, Договор");
	
	ТЗСдачаИнвестору = Объект.СдачаИнвестору.Выгрузить();
	ТЗСдачаИнвестору.Очистить();
	
	ИтогоПлощадьФактическаяПринятиеКУчету = Объект.ПринятиеКУчету.Итог("ПлощадьФактическая");
	ИтогоСуммаЗатратПринятиеКУчету        = Объект.ПринятиеКУчету.Итог("СуммаЗатрат");
	
	ИтогоПлощадьФактическаяСдачаИнвестору = Объект.СдачаИнвестору.Итог("ПлощадьФактическая");
	ИтогоСуммаЗатратСдачаИнвестору        = Объект.СдачаИнвестору.Итог("СуммаЗатрат");
	
	Счет43 = ПланыСчетов.Хозрасчетный.ГотоваяПродукция;
	Счет68_02 = ПланыСчетов.Хозрасчетный.НДС;
	
	Для каждого Строка Из Объект.НДСИнвестиционный Цикл
		
		Сумма_ПринятиеКУчету = 0;
		Сумма_СдачаИнвестору = 0;
		БылоРаспределениеПринятиеКУчету = Ложь;
		БылоРаспределениеСдачаИнвестору = Ложь;
		
		Строка.СуммаНДСПринятиеКУчету = ?(ИтогоПлощадьФактическаяПринятиеКУчету + ИтогоПлощадьФактическаяСдачаИнвестору = 0 ,0,Строка.СуммаНДС * ИтогоПлощадьФактическаяПринятиеКУчету / (ИтогоПлощадьФактическаяПринятиеКУчету + ИтогоПлощадьФактическаяСдачаИнвестору));
		Строка.СуммаНДСПередачаИнвестору = Строка.СуммаНДС - Строка.СуммаНДСПринятиеКУчету;
		
		Для каждого СтрокаПринятиеКУчету Из ТЗПринятиеКУчетуОригинал Цикл			
			
			Если СтрокаПринятиеКУчету.ОбъектНедвижимости.ТипНедвижимости <> Перечисления.УПН_ТипыНедвижимости.Жилая Тогда
				Продолжить;
			КонецЕсли;			
			
			НоваяСтрока = ТЗПринятиеКУчету.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПринятиеКУчету);
			
			Если РаспределятьПоСуммеЗатрат Тогда
				СуммаНДС = ?(ИтогоСуммаЗатратПринятиеКУчету = 0, 0, Строка.СуммаНДСПринятиеКУчету / ИтогоСуммаЗатратПринятиеКУчету * СтрокаПринятиеКУчету.СуммаЗатрат)
			Иначе	
				СуммаНДС = ?(ИтогоПлощадьФактическаяПринятиеКУчету = 0, 0, Строка.СуммаНДСПринятиеКУчету / ИтогоПлощадьФактическаяПринятиеКУчету * СтрокаПринятиеКУчету.ПлощадьФактическая)
			КонецЕсли; 
			
			НоваяСтрока.СуммаНДС = СуммаНДС;
			
			Сумма_ПринятиеКУчету = Сумма_ПринятиеКУчету + НоваяСтрока.СуммаНДС;
			НоваяСтрока.ДокументПоступления = Строка.ДокументПоступления;
			НоваяСтрока.СчетСписанияНДС = ?(СтрокаПринятиеКУчету.ОбъектНедвижимости.ТипНедвижимости = Перечисления.УПН_ТипыНедвижимости.Жилая, Счет43, Счет68_02); 
			НоваяСтрока.СчетУчетаНДС    = Строка.СчетУчетаНДС; 
			ПересчитатьСуммуБезНДСВСтрокеТаблицы(НоваяСтрока, Строка.СтавкаНДС);
			БылоРаспределениеПринятиеКУчету = Истина;
			
		КонецЦикла;
		
		Для каждого СтрокаСдачаИнвестору Из ТЗСдачаИнвесторуОригинал Цикл
			
			НоваяСтрока = ТЗСдачаИнвестору.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСдачаИнвестору);
			Если РаспределятьПоСуммеЗатрат Тогда
				СуммаНДС = ?(ИтогоСуммаЗатратСдачаИнвестору = 0, 0, Строка.СуммаНДСПередачаИнвестору / ИтогоСуммаЗатратСдачаИнвестору * СтрокаСдачаИнвестору.СуммаЗатрат)
			Иначе	
				СуммаНДС = ?(ИтогоПлощадьФактическаяСдачаИнвестору = 0, 0, Строка.СуммаНДСПередачаИнвестору / ИтогоПлощадьФактическаяСдачаИнвестору * СтрокаСдачаИнвестору.ПлощадьФактическая)
			КонецЕсли; 
			
			НоваяСтрока.СуммаНДС = СуммаНДС;
			Сумма_СдачаИнвестору = Сумма_СдачаИнвестору + НоваяСтрока.СуммаНДС;
			ПересчитатьСуммуБезНДСВСтрокеТаблицы(НоваяСтрока, Строка.СтавкаНДС);
			
			НоваяСтрока.ДокументПоступления = Строка.ДокументПоступления;
			БылоРаспределениеСдачаИнвестору = Истина;
		КонецЦикла;
		
		Если НЕ Строка.СуммаНДСПринятиеКУчету = Сумма_ПринятиеКУчету И ТЗПринятиеКУчету.Количество() > 0  И БылоРаспределениеПринятиеКУчету Тогда
			ТЗПринятиеКУчету[ТЗПринятиеКУчету.Количество() - 1].СуммаНДС = ТЗПринятиеКУчету[ТЗПринятиеКУчету.Количество() - 1].СуммаНДС + (Строка.СуммаНДСПринятиеКУчету - Сумма_ПринятиеКУчету);
			ПересчитатьСуммуБезНДСВСтрокеТаблицы(ТЗПринятиеКУчету[ТЗПринятиеКУчету.Количество() - 1], Строка.СтавкаНДС);
		КонецЕсли; 
		
		Если НЕ Строка.СуммаНДСПередачаИнвестору = Сумма_СдачаИнвестору И ТЗСдачаИнвестору.Количество() > 0 И БылоРаспределениеСдачаИнвестору Тогда
			ТЗСдачаИнвестору[ТЗСдачаИнвестору.Количество() - 1].СуммаНДС = ТЗСдачаИнвестору[ТЗСдачаИнвестору.Количество() - 1].СуммаНДС + (Строка.СуммаНДСПередачаИнвестору - Сумма_СдачаИнвестору);
			ПересчитатьСуммуБезНДСВСтрокеТаблицы(ТЗСдачаИнвестору[ТЗСдачаИнвестору.Количество() - 1], Строка.СтавкаНДС);
		КонецЕсли; 
		
	КонецЦикла;  
	
	ТЗПринятиеКУчету.Свернуть("ОбъектНедвижимости, Номенклатура, ПлощадьФактическая, СуммаЗатрат, ДокументПоступления, СчетУчетаНДС, СчетСписанияНДС", "СуммаБезНДС, СуммаНДС");
	ТЗПринятиеКУчету.Сортировать("ОбъектНедвижимости, ДокументПоступления");
	
	ТЗСдачаИнвестору.Свернуть("ОбъектНедвижимости, ПлощадьФактическая, СуммаЗатрат, НДСПоДДУ, ДокументПоступления, СчетРасчетов, Контрагент, Договор", "СуммаБезНДС, СуммаНДС, СуммаБезНДСПрочиеРасходы, СуммаНДСПрочиеРасходы");
	ТЗСдачаИнвестору.Сортировать("ОбъектНедвижимости, ДокументПоступления");
	Объект.ПринятиеКУчету.Загрузить(ТЗПринятиеКУчету);
	Объект.СдачаИнвестору.Загрузить(ТЗСдачаИнвестору);
	
	ЗаполнитьДеревоПринятиеКУчету();
	ЗаполнитьДеревоСдачаИнвестору();
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьИнвестиционныйНДСПоСуммеЗатрат(Команда)

	РаспределитьИнвестиционныйНДСНаСервере(Истина);
	ОбновитьИтоговыеПоказателиСервер();
	РазвернутьДеревья();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьИнвестиционныйНДСПоПлощали(Команда)
	
	
	РаспределитьИнвестиционныйНДСНаСервере(Ложь);
	ОбновитьИтоговыеПоказателиСервер();
	РазвернутьДеревья();
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСДеревьями

&НаКлиенте
Процедура РазвернутьДеревья()

	Для Каждого Строка Из ДЗПринятиеКУчету.ПолучитьЭлементы() Цикл
		ИдентификаторСтроки=Строка.ПолучитьИдентификатор();
		Элементы.ДЗПринятиеКУчету.Развернуть(ИдентификаторСтроки, Истина);
	КонецЦикла;	
	
	Для Каждого Строка Из ДЗСдачаИнвестору.ПолучитьЭлементы() Цикл
		ИдентификаторСтроки=Строка.ПолучитьИдентификатор();
		Элементы.ДЗСдачаИнвестору.Развернуть(ИдентификаторСтроки, Истина);
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоПринятиеКУчету()

	ТаблицаИсточник = Объект.ПринятиеКУчету.Выгрузить();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПринятиеКУчету.ОбъектНедвижимости,
	|	ПринятиеКУчету.Номенклатура,
	|	ПринятиеКУчету.ПлощадьФактическая,
	|	ПринятиеКУчету.СуммаЗатрат,
	|	ПринятиеКУчету.ДокументПоступления,
	|	ПринятиеКУчету.СуммаБезНДС,
	|	ПринятиеКУчету.СуммаНДС,
	|	ПринятиеКУчету.СчетУчетаНДС,
	|	ПринятиеКУчету.СчетСписанияНДС
	|ПОМЕСТИТЬ ВТ_ПринятиеКУчету
	|ИЗ
	|	&ТаблицаИсточник КАК ПринятиеКУчету
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПринятиеКУчету.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	ВТ_ПринятиеКУчету.Номенклатура,
	|	ВТ_ПринятиеКУчету.ПлощадьФактическая КАК ПлощадьФактическая,
	|	ВТ_ПринятиеКУчету.СуммаЗатрат КАК СуммаЗатрат,
	|	ВТ_ПринятиеКУчету.ДокументПоступления КАК ДокументПоступления,
	|	ВТ_ПринятиеКУчету.СуммаБезНДС КАК СуммаБезНДС,
	|	ВТ_ПринятиеКУчету.СуммаНДС КАК СуммаНДС,
	|	ВТ_ПринятиеКУчету.СчетУчетаНДС,
	|	ВТ_ПринятиеКУчету.СчетСписанияНДС
	|ИЗ
	|	ВТ_ПринятиеКУчету КАК ВТ_ПринятиеКУчету
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбъектНедвижимости,
	|	ДокументПоступления
	|ИТОГИ
	|	МАКСИМУМ(ПлощадьФактическая),
	|	МАКСИМУМ(СуммаЗатрат),
	|	СУММА(СуммаБезНДС),
	|	СУММА(СуммаНДС)
	|ПО
	|	ОбъектНедвижимости";
	
	Запрос.МенеджерВременныхТаблиц=МенеджерВТ;
	Запрос.УстановитьПараметр("ТаблицаИсточник",ТаблицаИсточник);
	
	РезультатПакета=Запрос.ВыполнитьПакет();
	ИндексРезультата=РезультатПакета.Количество()-1;
	РезультатЗапроса=РезультатПакета[ИндексРезультата];
	
	ЗаполнитьДеревоПоРезультатуЗапроса(РезультатЗапроса, "ДЗПринятиеКУчету");

КонецПроцедуры

