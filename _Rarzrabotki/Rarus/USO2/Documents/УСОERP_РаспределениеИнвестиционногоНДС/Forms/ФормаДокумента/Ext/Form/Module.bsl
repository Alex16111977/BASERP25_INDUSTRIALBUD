	ЗаполнитьИнвестиционныйНДСНаКлиенте(Ложь);
	
КонецПроцедуры

&НаСервере
Функция ПроверитьОбъектСтроительства()

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СМ_ОбъектыСтроительства.Ссылка,
	|	СМ_ОбъектыСтроительства.НачалоСтроительства,
	|	СМ_ОбъектыСтроительства.ОкончаниеСтроительства
	|ИЗ
	|	Справочник.СМ_ОбъектыСтроительства КАК СМ_ОбъектыСтроительства
	|ГДЕ
	|	СМ_ОбъектыСтроительства.ОбъектСтроительства = &ОбъектСтроительства";
	
	Запрос.УстановитьПараметр("ОбъектСтроительства", Объект.ОбъектСтроительства);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() ТОгда
		Если НЕ ЗначениеЗаполнено(Выборка.НачалоСтроительства)
			ИЛИ НЕ ЗначениеЗаполнено(Выборка.ОкончаниеСтроительства)
			ИЛИ Выборка.НачалоСтроительства > Выборка.ОкончаниеСтроительства Тогда
			Сообщить("Проверьте корректность заполнения периода строительства у объекта строительства " + Выборка.Ссылка);
			Возврат Новый Структура("НачалоСтроительства, ОкончаниеСтроительства, Проверка", Выборка.НачалоСтроительства, Выборка.ОкончаниеСтроительства, Ложь);
		КонецЕсли; 
		Возврат Новый Структура("НачалоСтроительства, ОкончаниеСтроительства, Проверка", Выборка.НачалоСтроительства, Выборка.ОкончаниеСтроительства, Истина);
	Иначе
		Сообщить("Объект эксплуатации " + Объект.ОбъектСтроительства + " не связан ни с одним объектом строительства!");
		Возврат Новый Структура("Проверка", Ложь);
	КонецЕсли; 
	
КонецФункции // ()

&НаКлиенте
Процедура ЗаполнитьИнвестиционныйНДСНаКлиенте(ПоСуммеЗатрат) 
	
	Если НЕ ЗначениеЗаполнено(Объект.ОбъектСтроительства) Тогда
		Сообщить("Необходимо заполнить Объект строительства!");
		Возврат;	
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Сообщить("Необходимо заполнить Документ основания!");
		Возврат;	
	КонецЕсли; 
	
	СтруктураОбъектаСтроительства = ПроверитьОбъектСтроительства();
	Если НЕ СтруктураОбъектаСтроительства.Проверка Тогда
		Возврат;	
	КонецЕсли; 
	
	Если Не Объект.НДСИнвестиционный.Количество() = 0 Тогда

		ТекстВопроса = НСтр("ru='Перед заполнением табл. часть ""Инвестиционный НДС"" будет очищена. Продолжить?'");
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьИнвестиционныйНДСЗавершение", ЭтотОбъект, ПоСуммеЗатрат), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;

	КонецЕсли;
	
	ЗаполнитьИнвестиционныйНДСНаСервере(ПоСуммеЗатрат, СтруктураОбъектаСтроительства);
	ОбновитьИтоговыеПоказателиСервер();
	РазвернутьДеревья();
	
	Модифицированность = Истина;
	
КонецПроцедуры	

