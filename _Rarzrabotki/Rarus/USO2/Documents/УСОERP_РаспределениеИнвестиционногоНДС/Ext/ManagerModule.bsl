
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПроводкиРеглУчета

// Функция формирует и возвращает текст запроса для отражения документа в регламентированном учете.
//
Функция ТекстОтраженияВРеглУчете() Экспорт
	
	Если ПолучитьФункциональнуюОпцию("УСОERP_НоваяУчетнаяПолитикаПоДолевомуСтроительству") = Истина Тогда
		Возврат "";
	КонецЕсли;
	

	ТекстПринятиеКУчету = "
	|ВЫБРАТЬ //// Принятие к учету (Дт Счет списания НДС :: Кт Счет НДС)
	|	Операция.Ссылка КАК Ссылка,
	|	Операция.Дата КАК Период,
	|	Операция.Организация КАК Организация,
	|	НЕОПРЕДЕЛЕНО КАК ИдентификаторСтроки,
	|
	|	Строки.СуммаНДС КАК Сумма,
	
	|	Строки.СуммаНДС КАК СуммаУУ,

	|
	|	НЕОПРЕДЕЛЕНО КАК ВидСчетаДт,
	|	НЕОПРЕДЕЛЕНО КАК АналитикаУчетаДт,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчетаДт,
	|
	|	НЕОПРЕДЕЛЕНО КАК ВалютаДт,
	|	НЕОПРЕДЕЛЕНО КАК ПодразделениеДт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельностиДт,
	|	Строки.СчетСписанияНДС КАК СчетДт,
	|
	|	ВЫБОР КОГДА Строки.СчетСписанияНДС В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ГотоваяПродукция)) ТОГДА Строки.Номенклатура ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыПлатежейВГосБюджет.Налог) КОНЕЦ КАК СубконтоДт1,
	|	ВЫБОР КОГДА Строки.СчетСписанияНДС В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ГотоваяПродукция)) ТОГДА Операция.ДокументОснование.Склад ИНАЧЕ НЕОПРЕДЕЛЕНО КОНЕЦ КАК СубконтоДт2,
	|	НЕОПРЕДЕЛЕНО КАК СубконтоДт3,
	|	
	|	0 КАК ВалютнаяСуммаДт,
	|	1 КАК КоличествоДт,
	|	0 КАК СуммаНУДт,
	|	0 КАК СуммаПРДт,
	|	0 КАК СуммаВРДт,
	|	
	|	НЕОПРЕДЕЛЕНО КАК ВидСчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК АналитикаУчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчетаКт,
	|
	|	НЕОПРЕДЕЛЕНО КАК ВалютаКт,
	|	НЕОПРЕДЕЛЕНО КАК ПодразделениеКт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельностиКт,
	|	УчетнаяПолитикаПоДолевомуСтроительству.СчетУчетаИнвестиционногоНДС КАК СчетКт,
	|	Строки.ДокументПоступления.Контрагент КАК СубконтоКт1,
	|	Строки.ДокументПоступления КАК СубконтоКт2,
	|	Операция.ОбъектСтроительства КАК СубконтоКт3,
	|
	|	0 КАК ВалютнаяСуммаКт,
	|	0 КАК КоличествоКт,
	|	0 КАК СуммаНУКт,
	|	0 КАК СуммаПРКт,
	|	0 КАК СуммаВРКт,
	|	""Принятие к учету"" КАК Содержание
	|
	|ИЗ
	|	Документ.УСОERP_РаспределениеИнвестиционногоНДС КАК Операция
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		Документ.УСОERP_РаспределениеИнвестиционногоНДС.ПринятиеКУчету КАК Строки
	|	ПО
	|		Строки.Ссылка = Операция.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_УчетнаяПолитикаПоДолевомуСтроительству.СрезПоследних КАК УчетнаяПолитикаПоДолевомуСтроительству
	|	ПО Операция.Организация = УчетнаяПолитикаПоДолевомуСтроительству.Организация
	|ГДЕ
	|	Операция.Ссылка = &Ссылка";
	
	ТекстСдачаИнвестору = "
	|ВЫБРАТЬ //// Сдача инвестору (Дт Счет расчетов :: Кт ?????)
	|	Операция.Ссылка КАК Ссылка,
	|	Операция.Дата КАК Период,
	|	Операция.Организация КАК Организация,
	|	НЕОПРЕДЕЛЕНО КАК ИдентификаторСтроки,
	|
	|	Строки.СуммаНДС КАК Сумма,
	
	|	Строки.СуммаНДС КАК СуммаУУ,

	|
	|	НЕОПРЕДЕЛЕНО КАК ВидСчетаДт,
	|	НЕОПРЕДЕЛЕНО КАК АналитикаУчетаДт,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчетаДт,
	|
	|	НЕОПРЕДЕЛЕНО КАК ВалютаДт,
	|	НЕОПРЕДЕЛЕНО КАК ПодразделениеДт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельностиДт,
	|	Строки.СчетРасчетов КАК СчетДт,
	|
	|	Строки.Контрагент КАК СубконтоДт1,
	|	Строки.Договор КАК СубконтоДт2,
	|	НЕОПРЕДЕЛЕНО КАК СубконтоДт3,
	|	
	|	0 КАК ВалютнаяСуммаДт,
	|	0 КАК КоличествоДт,
	|	0 КАК СуммаНУДт,
	|	0 КАК СуммаПРДт,
	|	0 КАК СуммаВРДт,
	|	
	|	НЕОПРЕДЕЛЕНО КАК ВидСчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК АналитикаУчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчетаКт,
	|
	|	НЕОПРЕДЕЛЕНО КАК ВалютаКт,
	|	НЕОПРЕДЕЛЕНО КАК ПодразделениеКт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельностиКт,
	|	УчетнаяПолитикаПоДолевомуСтроительству.СчетУчетаИнвестиционногоНДС КАК СчетКт,
	|	Строки.ДокументПоступления.Контрагент КАК СубконтоКт1,
	|	Строки.ДокументПоступления КАК СубконтоКт2,
	|	Операция.ОбъектСтроительства КАК СубконтоКт3,
	|
	|	0 КАК ВалютнаяСуммаКт,
	|	0 КАК КоличествоКт,
	|	0 КАК СуммаНУКт,
	|	0 КАК СуммаПРКт,
	|	0 КАК СуммаВРКт,
	|	""Сдача инвестору"" КАК Содержание
	|
	|ИЗ
	|	Документ.УСОERP_РаспределениеИнвестиционногоНДС КАК Операция
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		Документ.УСОERP_РаспределениеИнвестиционногоНДС.СдачаИнвестору КАК Строки
	|	ПО
	|		Строки.Ссылка = Операция.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_УчетнаяПолитикаПоДолевомуСтроительству.СрезПоследних КАК УчетнаяПолитикаПоДолевомуСтроительству
	|	ПО Операция.Организация = УчетнаяПолитикаПоДолевомуСтроительству.Организация
	|
	|ГДЕ
	|	Операция.Ссылка = &Ссылка";
	
	Возврат ТекстПринятиеКУчету 
			+ " ОБЪЕДИНИТЬ ВСЕ " + ТекстСдачаИнвестору;

КонецФункции // ТекстОтраженияВРеглУчете()

#КонецОбласти

#Область Проведение

// Процедура инициализирует данные документа для их последующего отражения в связанных с документом регистрах.
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", ДокументСсылка);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДанныеДокумента.Дата КАК Период,
	               |	ДанныеДокумента.Организация КАК Организация,
	               |	ДанныеДокумента.ОбъектСтроительства КАК ОбъектСтроительства,
	               |	ДанныеДокумента.ДокументОснование.Склад КАК Склад
	               |ИЗ
	               |	Документ.УСОERP_РаспределениеИнвестиционногоНДС КАК ДанныеДокумента
	               |ГДЕ
	               |	ДанныеДокумента.Ссылка = &ТекущийДокумент";
				   
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	
	Запрос.УстановитьПараметр("Период",                     Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация",                Реквизиты.Организация);
	Запрос.УстановитьПараметр("Склад",                      Реквизиты.Склад);
	Запрос.УстановитьПараметр("УчитыватьПоВидамЗапасов",    ПолучитьФункциональнуюОпцию("УчитыватьСебестоимостьТоваровПоВидамЗапасов"));
	Запрос.УстановитьПараметр("ИспользоватьПартионныйУчет", ПолучитьФункциональнуюОпцию("ИспользоватьПартионныйУчет"));

	Запрос.Текст = ТекстЗапросаТаблицаПринятиеКУчету()
				 + ТекстЗапросаТаблицаСебестоимостьТоваров()
				 + ТекстЗапросаТаблицаПартииТоваровОрганизаций();
				 
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("ТаблицаСебестоимостьТоваров"	  , Результат[1].Выгрузить());
	ТаблицыДляДвижений.Вставить("ТаблицаПартииТоваровОрганизаций" , Результат[2].Выгрузить());
	
КонецПроцедуры // ИнициализироватьДанныеДокумента()

// Функция формирует и возвращает текст запроса для подготовки виртуальной таблицы по табл. части "Принятие к учету".
//
Функция ТекстЗапросаТаблицаПринятиеКУчету()
	
	ТекстЗапроса = "ВЫБРАТЬ //// [1] ТаблицаПринятиеКУчету
	               |	ТаблицаПринятиеКУчету.НомерСтроки КАК НомерСтроки,
	               |	ТаблицаПринятиеКУчету.Номенклатура КАК Номенклатура,
	               |	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
	               |	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК Назначение,
	               |	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК Серия,
	               |	АналитикаУчетаНоменклатуры.КлючАналитики КАК АналитикаУчетаНоменклатуры,
	               |	1 КАК Количество,
	               |	ТаблицаПринятиеКУчету.СуммаБезНДС + ТаблицаПринятиеКУчету.СуммаНДС КАК Сумма,
	               |	ТаблицаПринятиеКУчету.СуммаБезНДС КАК СуммаБезНДС,
				   |	ТаблицаПринятиеКУчету.СуммаНДС КАК СуммаНДС,
	               |	0 КАК СуммаПР,
	               |	0 КАК СуммаВР,
	               |	ЗНАЧЕНИЕ(Справочник.ВидыЗапасов.ПустаяСсылка) КАК ВидЗапасов,
	               |	ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка) КАК НомерГТД,
	               |	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиУчетаПартий.ПустаяСсылка) КАК АналитикаУчетаПартий
	               |ПОМЕСТИТЬ ТаблицаПринятиеКУчету
	               |ИЗ
	               |	Документ.УСОERP_РаспределениеИнвестиционногоНДС.ПринятиеКУчету КАК ТаблицаПринятиеКУчету
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры
	               |		ПО ТаблицаПринятиеКУчету.Номенклатура = АналитикаУчетаНоменклатуры.Номенклатура
	               |			И (АналитикаУчетаНоменклатуры.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	               |			И (АналитикаУчетаНоменклатуры.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка))
	               |			И (АналитикаУчетаНоменклатуры.МестоХранения = &Склад)
	               |ГДЕ
	               |	ТаблицаПринятиеКУчету.Ссылка = &ТекущийДокумент
				   |	И ТаблицаПринятиеКУчету.СчетСписанияНДС В ИЕРАРХИИ(Значение(ПланСчетов.Хозрасчетный.ГотоваяПродукция))
	               |;
	               |////////////////////////////////////////////////////////////////////////////////
	               |";
	
	Возврат ТекстЗапроса;
	
КонецФункции // ТекстЗапросаТаблицаПринятиеКУчету()

// Функция формирует и возвращает текст запроса для проведения документа по регистру накопления "Себестоимость товаров".
//
Функция ТекстЗапросаТаблицаСебестоимостьТоваров()
	
	ТекстЗапроса = "ВЫБРАТЬ //// [3] СебестоимостьТоваров
	               |	ТаблицаПринятиеКУчету.НомерСтроки КАК НомерСтроки,
	               |	&Период КАК Период,
	               |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	               |	&Организация КАК Организация,
	               |	ТаблицаПринятиеКУчету.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	               |	ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыНаСкладах) КАК РазделУчета,
	               |	ВЫБОР
	               |		КОГДА &УчитыватьПоВидамЗапасов
	               |			ТОГДА ТаблицаПринятиеКУчету.ВидЗапасов
	               |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	               |	КОНЕЦ КАК ВидЗапасов,
	               |	ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОприходованиеТоваров) КАК ХозяйственнаяОперация,
	               |	ТаблицаПринятиеКУчету.Сумма КАК Стоимость,
	               |	ТаблицаПринятиеКУчету.СуммаБезНДС КАК СтоимостьБезНДС,
	               |	ТаблицаПринятиеКУчету.Сумма КАК СтоимостьРегл,
	               |	ТаблицаПринятиеКУчету.СуммаПР КАК ПостояннаяРазница,
	               |	ТаблицаПринятиеКУчету.СуммаВР КАК ВременнаяРазница,
	               |	ТаблицаПринятиеКУчету.Количество КАК Количество
	               |ИЗ
	               |	ТаблицаПринятиеКУчету КАК ТаблицаПринятиеКУчету
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки
	               |;
	               |////////////////////////////////////////////////////////////////////////////////
	               |";
	
	Возврат ТекстЗапроса;
	
КонецФункции // ТекстЗапросаТаблицаСебестоимостьТоваров()

// Функция формирует и возвращает текст запроса для проведения документа по регистру накопления "Партии товаров организаций".
//
Функция ТекстЗапросаТаблицаПартииТоваровОрганизаций()
	
	ТекстЗапроса = "ВЫБРАТЬ //// [2] ПартииТоваровОрганизаций
	               |	ТаблицаПринятиеКУчету.НомерСтроки КАК НомерСтроки,
	               |	&Период КАК Период,
	               |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	               |	&Организация КАК Организация,
	               |	ТаблицаПринятиеКУчету.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	               |	&ТекущийДокумент КАК ДокументПоступления,
	               |	ТаблицаПринятиеКУчету.ВидЗапасов КАК ВидЗапасов,
	               |	ТаблицаПринятиеКУчету.Количество КАК Количество,
	               |	ТаблицаПринятиеКУчету.АналитикаУчетаПартий КАК АналитикаУчетаПартий,
	               |	ТаблицаПринятиеКУчету.Сумма КАК Стоимость,
	               |	ТаблицаПринятиеКУчету.СуммаБезНДС КАК СтоимостьБезНДС,
	               |	ТаблицаПринятиеКУчету.Сумма КАК СтоимостьРегл,
	               |	ТаблицаПринятиеКУчету.СуммаПР КАК ПостояннаяРазница,
	               |	ТаблицаПринятиеКУчету.СуммаВР КАК ВременнаяРазница,
	               |	ТаблицаПринятиеКУчету.СуммаНДС КАК НДСРегл,
	               |	ТаблицаПринятиеКУчету.Номенклатура КАК Номенклатура,
	               |	ТаблицаПринятиеКУчету.Характеристика КАК Характеристика,
	               |	ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПустаяСсылка) КАК НалогообложениеНДС,
	               |	ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОприходованиеТоваров) КАК ХозяйственнаяОперация,
	               |	ИСТИНА КАК Первичное,
	               |	НЕОПРЕДЕЛЕНО КАК ДокументИсточник
	               |ИЗ
	               |	ТаблицаПринятиеКУчету КАК ТаблицаПринятиеКУчету
	               |ГДЕ
	               |	&ИспользоватьПартионныйУчет
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки
	               |;
	               |////////////////////////////////////////////////////////////////////////////////
	               |";
	
	Возврат ТекстЗапроса;
	
КонецФункции // ТекстЗапросаТаблицаПартииТоваровОрганизаций()

