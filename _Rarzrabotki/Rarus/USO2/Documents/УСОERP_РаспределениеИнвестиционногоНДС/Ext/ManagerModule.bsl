#Область ЗаписьКнигиПокупок

// Процедура формирует сторнирующие документы "Запись книги покупок" по данным регистра накопления "НДС Покупки".
//
Процедура СформироватьДокументыЗаписьКнигиПокупок(ДокументСсылка, Отказ) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("НачалоПериода"	 , НачалоМесяца(ДокументСсылка.Дата));
	Запрос.УстановитьПараметр("ОкончаниеПериода" , КонецМесяца(ДокументСсылка.Дата));
	Запрос.УстановитьПараметр("ТекущийДокумент"	 , ДокументСсылка);
	Запрос.УстановитьПараметр("Счет68"	         , ПланыСчетов.Хозрасчетный.РасчетыПоНалогам);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПринятиеКУчету.ДокументПоступления КАК СчетФактура,
	|	ПринятиеКУчету.СчетУчетаНДС КАК СчетУчетаНДС,
	|	ПринятиеКУчету.Номенклатура,
	|	ПринятиеКУчету.СуммаБезНДС,
	|	ПринятиеКУчету.СуммаНДС,
	|	ПринятиеКУчету.НомерСтроки
	|ПОМЕСТИТЬ ВТПринятиеКУчету
	|ИЗ
	|	Документ.УСОERP_РаспределениеИнвестиционногоНДС.ПринятиеКУчету КАК ПринятиеКУчету
	|ГДЕ
	|	ПринятиеКУчету.Ссылка = &ТекущийДокумент
	|	И ПринятиеКУчету.СчетСписанияНДС В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыПоНалогам))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетФактура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТПринятиеКУчету.СчетФактура КАК СчетФактура,
	|	ВТПринятиеКУчету.СчетУчетаНДС КАК СчетУчетаНДС,
	|	ДокументЗаписьКнигиПокупок.Ссылка КАК ЗаписьКнигиПокупок,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыЦенностей.ПрочиеРаботыИУслуги) КАК ВидЦенности,
	|	ЗНАЧЕНИЕ(Перечисление.СобытияПоНДСПокупки.ПереданНДСНаСтроительство) КАК Событие,
	|	ВТПринятиеКУчету.Номенклатура,
	|	ВТПринятиеКУчету.СуммаБезНДС КАК Сумма,
	|	ВТПринятиеКУчету.СуммаНДС,
	|	ВЫБОР
	|		КОГДА ВЫБОР
	|				КОГДА ВТПринятиеКУчету.СуммаБезНДС = 0
	|					ТОГДА 0
	|				ИНАЧЕ ВЫРАЗИТЬ(ВТПринятиеКУчету.СуммаНДС / ВТПринятиеКУчету.СуммаБезНДС КАК ЧИСЛО(15, 2))
	|			КОНЕЦ = 0
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0)
	|		КОГДА ВЫБОР
	|				КОГДА ВТПринятиеКУчету.СуммаБезНДС = 0
	|					ТОГДА 0
	|				ИНАЧЕ ВЫРАЗИТЬ(ВТПринятиеКУчету.СуммаНДС / ВТПринятиеКУчету.СуммаБезНДС КАК ЧИСЛО(15, 2))
	|			КОНЕЦ = 0.18
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18)
	|		КОГДА ВЫБОР
	|				КОГДА ВТПринятиеКУчету.СуммаБезНДС = 0
	|					ТОГДА 0
	|				ИНАЧЕ ВЫРАЗИТЬ(ВТПринятиеКУчету.СуммаНДС / ВТПринятиеКУчету.СуммаБезНДС КАК ЧИСЛО(15, 2))
	|			КОНЕЦ = 0.2
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20)
	|		КОГДА ВЫБОР
	|				КОГДА ВТПринятиеКУчету.СуммаБезНДС = 0
	|					ТОГДА 0
	|				ИНАЧЕ ВЫРАЗИТЬ(ВТПринятиеКУчету.СуммаНДС / ВТПринятиеКУчету.СуммаБезНДС КАК ЧИСЛО(15, 2))
	|			КОНЕЦ = 0.1
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС10)
	|	КОНЕЦ КАК СтавкаНДС,
	|	ВТПринятиеКУчету.НомерСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	ВТПринятиеКУчету КАК ВТПринятиеКУчету
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаписьКнигиПокупок.Ценности КАК ДокументЗаписьКнигиПокупок
	|		ПО ВТПринятиеКУчету.СчетФактура = ДокументЗаписьКнигиПокупок.Ссылка.ДокументРасчетов
	|			И (ДокументЗаписьКнигиПокупок.Ссылка.УСОERP_СторнируемыйДокумент = ЗНАЧЕНИЕ(Документ.ЗаписьКнигиПокупок.ПустаяСсылка))
	|ИТОГИ
	|	МАКСИМУМ(ЗаписьКнигиПокупок)
	|ПО
	|	СчетФактура";
	
	ВыборкаСФ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСФ.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаСФ.ЗаписьКнигиПокупок) Тогда
			ЗаписьКнигиПокупок = ВыборкаСФ.ЗаписьКнигиПокупок.ПолучитьОбъект();
		Иначе
			ЗаписьКнигиПокупок = Документы.ЗаписьКнигиПокупок.СоздатьДокумент();
		КонецЕсли;
		
		ДокументПоступления	 = ВыборкаСФ.СчетФактура;
		ЗаполняемыеСвойства	 = "Организация, Контрагент, Валюта, Подразделение";
		СообщениеОбОшибке	 = НСтр("ru='Не удалось создать документ ""Запись книги покупок"" по причине:'");
		
		ЗаполнитьЗначенияСвойств(ЗаписьКнигиПокупок, ДокументПоступления, ЗаполняемыеСвойства);
		ЗаписьКнигиПокупок.Ценности.Очистить();
		
		ЗаписьКнигиПокупок.СпособКорректировкиНДС = Перечисления.СпособыКорректировкиНДС.Отложить;
		ЗаписьКнигиПокупок.ДокументРасчетов       = ДокументПоступления;
		ЗаписьКнигиПокупок.Дата					  = ДокументСсылка.Дата;
		
		Выборка = ВыборкаСФ.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ЗаписьКнигиПокупок.Ценности.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла;
		
		
		Попытка
			ЗаписьКнигиПокупок.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке + " " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), , , , Отказ);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры // СформироватьСторнирующиеДокументыЗаписьКнигиПокупок()

#КонецОбласти

#Область Заполнение

Функция ПолучитьДанныеЗаполненияИнвестиционныйНДС(СтруктураПараметров) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_НДСИнвестиционныйОстатки.Контрагент КАК Контрагент,
	|	УСОERP_НДСИнвестиционныйОстатки.ДокументПоступления КАК ДокументПоступления,
	|	NULL КАК Номенклатура,
	|	УСОERP_НДСИнвестиционныйОстатки.СчетУчетаНДС КАК СчетУчетаНДС,
	|	УСОERP_НДСИнвестиционныйОстатки.СуммаБезНДСОстаток КАК СуммаБезНДС,
	|	УСОERP_НДСИнвестиционныйОстатки.СуммаНДСОстаток КАК СуммаНДС
	|ПОМЕСТИТЬ ВТ_ИнвестиционныйНДС
	|ИЗ
	|	РегистрНакопления.УСОERP_НДСИнвестиционный.Остатки(
	|			&Дата,
	|			Организация = &Организация
	|				И ОбъектСтроительства = &ОбъектСтроительства
	|				И ДокументПоступления ССЫЛКА Документ.ПриобретениеУслугПрочихАктивов
	|				И Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК УСОERP_НДСИнвестиционныйОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УСОERP_НДСИнвестиционныйОстатки.Контрагент,
	|	УСОERP_НДСИнвестиционныйОстатки.ДокументПоступления,
	|	УСОERP_НДСИнвестиционныйОстатки.Номенклатура,
	|	УСОERP_НДСИнвестиционныйОстатки.СчетУчетаНДС,
	|	СУММА(ЕСТЬNULL(ПартииТоваровОрганизацийОбороты.СтоимостьРеглРасход, 0)),
	|	СУММА(ЕСТЬNULL(ПартииТоваровОрганизацийОбороты.НДСРеглРасход, 0))
	|ИЗ
	|	РегистрНакопления.УСОERP_НДСИнвестиционный.Остатки(
	|			&Дата,
	|			Организация = &Организация
	|				И ОбъектСтроительства = &ОбъектСтроительства
	|				И НЕ Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК УСОERP_НДСИнвестиционныйОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПартииТоваровОрганизаций.Обороты(&НачалоСтроительства, &ОкончаниеСтроительства, , Организация = &Организация) КАК ПартииТоваровОрганизацийОбороты
	|		ПО УСОERP_НДСИнвестиционныйОстатки.Номенклатура = ПартииТоваровОрганизацийОбороты.АналитикаУчетаНоменклатуры.Номенклатура
	|			И УСОERP_НДСИнвестиционныйОстатки.ДокументПоступления = ПартииТоваровОрганизацийОбороты.ДокументПоступления
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_НДСИнвестиционныйОстатки.Номенклатура,
	|	УСОERP_НДСИнвестиционныйОстатки.СчетУчетаНДС,
	|	УСОERP_НДСИнвестиционныйОстатки.Контрагент,
	|	УСОERP_НДСИнвестиционныйОстатки.ДокументПоступления
	|
	|ИМЕЮЩИЕ
	|	СУММА(ЕСТЬNULL(ПартииТоваровОрганизацийОбороты.СтоимостьРеглРасход, 0)) <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ИнвестиционныйНДС.Контрагент КАК Контрагент,
	|	ВТ_ИнвестиционныйНДС.ДокументПоступления КАК ДокументПоступления,
	|	ВТ_ИнвестиционныйНДС.Номенклатура КАК Номенклатура,
	|	ВТ_ИнвестиционныйНДС.СчетУчетаНДС КАК СчетУчетаНДС,
	|	ВТ_ИнвестиционныйНДС.СуммаБезНДС КАК СуммаБезНДС,
	|	ВТ_ИнвестиционныйНДС.СуммаНДС КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ВЫБОР
	|				КОГДА ВТ_ИнвестиционныйНДС.СуммаБезНДС = 0
	|					ТОГДА 0
	|				ИНАЧЕ ВЫРАЗИТЬ(ВТ_ИнвестиционныйНДС.СуммаНДС / ВТ_ИнвестиционныйНДС.СуммаБезНДС КАК ЧИСЛО(15, 2))
	|			КОНЕЦ = 0
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0)
	|		КОГДА ВЫБОР
	|				КОГДА ВТ_ИнвестиционныйНДС.СуммаБезНДС = 0
	|					ТОГДА 0
	|				ИНАЧЕ ВЫРАЗИТЬ(ВТ_ИнвестиционныйНДС.СуммаНДС / ВТ_ИнвестиционныйНДС.СуммаБезНДС КАК ЧИСЛО(15, 2))
	|			КОНЕЦ = 0.18
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18)
	|		КОГДА ВЫБОР
	|				КОГДА ВТ_ИнвестиционныйНДС.СуммаБезНДС = 0
	|					ТОГДА 0
	|				ИНАЧЕ ВЫРАЗИТЬ(ВТ_ИнвестиционныйНДС.СуммаНДС / ВТ_ИнвестиционныйНДС.СуммаБезНДС КАК ЧИСЛО(15, 2))
	|			КОНЕЦ = 0.2
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20)
	|		КОГДА ВЫБОР
	|				КОГДА ВТ_ИнвестиционныйНДС.СуммаБезНДС = 0
	|					ТОГДА 0
	|				ИНАЧЕ ВЫРАЗИТЬ(ВТ_ИнвестиционныйНДС.СуммаНДС / ВТ_ИнвестиционныйНДС.СуммаБезНДС КАК ЧИСЛО(15, 2))
	|			КОНЕЦ = 0.1
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС10)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18)
	|	КОНЕЦ КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА &РасчетПоСуммеЗатрат
	|			ТОГДА ВЫБОР
	|					КОГДА &ИтогоСуммаЗатрат = 0
	|						ТОГДА 0
	|					ИНАЧЕ ВТ_ИнвестиционныйНДС.СуммаНДС * &ИтогоСуммаЗатратПринятиеКУчету / &ИтогоСуммаЗатрат
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА &ИтогоПлощадьФактическая = 0
	|					ТОГДА 0
	|				ИНАЧЕ ВТ_ИнвестиционныйНДС.СуммаНДС * &ИтогоПлощадьФактическаяПринятиеКУчету / &ИтогоПлощадьФактическая
	|			КОНЕЦ
	|	КОНЕЦ КАК СуммаНДСПринятиеКУчету,
	|	ВЫБОР
	|		КОГДА &РасчетПоСуммеЗатрат
	|			ТОГДА ВЫБОР
	|					КОГДА &ИтогоСуммаЗатрат = 0
	|						ТОГДА 0
	|					ИНАЧЕ ВТ_ИнвестиционныйНДС.СуммаНДС - ВТ_ИнвестиционныйНДС.СуммаНДС * &ИтогоСуммаЗатратПринятиеКУчету / &ИтогоСуммаЗатрат
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА &ИтогоПлощадьФактическая = 0
	|					ТОГДА 0
	|				ИНАЧЕ ВТ_ИнвестиционныйНДС.СуммаНДС - ВТ_ИнвестиционныйНДС.СуммаНДС * &ИтогоПлощадьФактическаяПринятиеКУчету / &ИтогоПлощадьФактическая
	|			КОНЕЦ
	|	КОНЕЦ КАК СуммаНДСПередачаИнвестору
	|ИЗ
	|	ВТ_ИнвестиционныйНДС КАК ВТ_ИнвестиционныйНДС
	|ГДЕ
	|	ВТ_ИнвестиционныйНДС.СуммаБезНДС <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_ЗакрытиеОбъектаСтроительстваПринятиеКУчету.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	УСОERP_ЗакрытиеОбъектаСтроительстваПринятиеКУчету.Номенклатура КАК Номенклатура,
	|	УСОERP_ЗакрытиеОбъектаСтроительстваПринятиеКУчету.ПлощадьФактическая КАК ПлощадьФактическая,
	|	УСОERP_ЗакрытиеОбъектаСтроительстваПринятиеКУчету.СуммаЗатрат КАК СуммаЗатрат,
	|	УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОбороты.СуммаОборот КАК СуммаОборот,
	|	УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОбороты.ПлощадьОборот КАК ПлощадьОборот
	|ИЗ
	|	Документ.УСОERP_ЗакрытиеОбъектаСтроительства.ПринятиеКУчету КАК УСОERP_ЗакрытиеОбъектаСтроительстваПринятиеКУчету
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УПН_РасчетыСКлиентамиПоОбъектамНедвижимости.Обороты(, , Регистратор, ) КАК УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОбороты
	|		ПО УСОERP_ЗакрытиеОбъектаСтроительстваПринятиеКУчету.ОбъектНедвижимости = УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОбороты.ОбъектНедвижимости
	|			И (УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОбороты.Регистратор ССЫЛКА Документ.УПН_ДоговорПоНедвижимости)
	|ГДЕ
	|	УСОERP_ЗакрытиеОбъектаСтроительстваПринятиеКУчету.Ссылка = &ДокументОснование
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УСОERP_СдачаОбъектаНедвижимостиПринятиеКУчету.ОбъектНедвижимости,
	|	УСОERP_СдачаОбъектаНедвижимостиПринятиеКУчету.Номенклатура,
	|	УСОERP_СдачаОбъектаНедвижимостиПринятиеКУчету.ПлощадьФактическая,
	|	УСОERP_СдачаОбъектаНедвижимостиПринятиеКУчету.СуммаЗатрат,
	|	УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОбороты.СуммаОборот,
	|	УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОбороты.ПлощадьОборот
	|ИЗ
	|	Документ.УСОERP_СдачаОбъектаНедвижимости.ПринятиеКУчету КАК УСОERP_СдачаОбъектаНедвижимостиПринятиеКУчету
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УПН_РасчетыСКлиентамиПоОбъектамНедвижимости.Обороты(, , Регистратор, ) КАК УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОбороты
	|		ПО УСОERP_СдачаОбъектаНедвижимостиПринятиеКУчету.ОбъектНедвижимости = УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОбороты.ОбъектНедвижимости
	|			И (УПН_РасчетыСКлиентамиПоОбъектамНедвижимостиОбороты.Регистратор ССЫЛКА Документ.УПН_ДоговорПоНедвижимости)
	|ГДЕ
	|	УСОERP_СдачаОбъектаНедвижимостиПринятиеКУчету.Ссылка = &ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_ЗакрытиеОбъектаСтроительстваСдачаИнвестору.ОбъектНедвижимости КАК ОбъектНедвижимости,
	|	УСОERP_ЗакрытиеОбъектаСтроительстваСдачаИнвестору.ПлощадьФактическая КАК ПлощадьФактическая,
	|	УСОERP_ЗакрытиеОбъектаСтроительстваСдачаИнвестору.СуммаЗатрат КАК СуммаЗатрат,
	|	УСОERP_ЗакрытиеОбъектаСтроительстваСдачаИнвестору.СчетРасчетов КАК СчетРасчетов,
	|	УСОERP_ЗакрытиеОбъектаСтроительстваСдачаИнвестору.Контрагент КАК Контрагент,
	|	УСОERP_ЗакрытиеОбъектаСтроительстваСдачаИнвестору.Договор КАК Договор,
	|	УПН_ДоговорПоНедвижимостиОбъектыНедвижимости.СуммаНДС КАК НДСПоДДУ
	|ИЗ
	|	Документ.УСОERP_ЗакрытиеОбъектаСтроительства.СдачаИнвестору КАК УСОERP_ЗакрытиеОбъектаСтроительстваСдачаИнвестору
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УПН_ДоговорПоНедвижимости.ОбъектыНедвижимости КАК УПН_ДоговорПоНедвижимостиОбъектыНедвижимости
	|		ПО УСОERP_ЗакрытиеОбъектаСтроительстваСдачаИнвестору.ОбъектНедвижимости = УПН_ДоговорПоНедвижимостиОбъектыНедвижимости.ОбъектНедвижимости
	|			И УСОERP_ЗакрытиеОбъектаСтроительстваСдачаИнвестору.Ссылка.Организация = УПН_ДоговорПоНедвижимостиОбъектыНедвижимости.Ссылка.Организация
	|ГДЕ
	|	УСОERP_ЗакрытиеОбъектаСтроительстваСдачаИнвестору.Ссылка = &ДокументОснование
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.ОбъектНедвижимости,
	|	УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.ПлощадьФактическая,
	|	УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.СуммаЗатрат,
	|	УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.СчетРасчетов,
	|	УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.Контрагент,
	|	УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.Договор,
	|	УПН_ДоговорПоНедвижимостиОбъектыНедвижимости.СуммаНДС
	|ИЗ
	|	Документ.УСОERP_СдачаОбъектаНедвижимости.СдачаИнвестору КАК УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УПН_ДоговорПоНедвижимости.ОбъектыНедвижимости КАК УПН_ДоговорПоНедвижимостиОбъектыНедвижимости
	|		ПО УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.ОбъектНедвижимости = УПН_ДоговорПоНедвижимостиОбъектыНедвижимости.ОбъектНедвижимости
	|			И УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.Ссылка.Организация = УПН_ДоговорПоНедвижимостиОбъектыНедвижимости.Ссылка.Организация
	|ГДЕ
	|	УСОERP_СдачаОбъектаНедвижимостиСдачаИнвестору.Ссылка = &ДокументОснование";

	Запрос.УстановитьПараметр("Организация",            СтруктураПараметров.Организация);
	Запрос.УстановитьПараметр("ОбъектСтроительства",    СтруктураПараметров.ОбъектСтроительства);
	Запрос.УстановитьПараметр("ДокументОснование",      СтруктураПараметров.ДокументОснование);
	Запрос.УстановитьПараметр("НачалоПериода",          СтруктураПараметров.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",           СтруктураПараметров.КонецПериода);
	Запрос.УстановитьПараметр("Дата",                   Новый Граница(СтруктураПараметров.Дата,ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НачалоСтроительства",    СтруктураПараметров.НачалоСтроительства);
	Запрос.УстановитьПараметр("ОкончаниеСтроительства", СтруктураПараметров.ОкончаниеСтроительства);
	
	Запрос.УстановитьПараметр("ИтогоПлощадьФактическая",               СтруктураПараметров.ИтогоПлощадьФактическая);
	Запрос.УстановитьПараметр("ИтогоСуммаЗатрат",                      СтруктураПараметров.ИтогоСуммаЗатрат);
	Запрос.УстановитьПараметр("ИтогоПлощадьФактическаяПринятиеКУчету", СтруктураПараметров.ИтогоПлощадьФактическаяПринятиеКУчету);
	Запрос.УстановитьПараметр("ИтогоСуммаЗатратПринятиеКУчету",        СтруктураПараметров.ИтогоСуммаЗатратПринятиеКУчету);
	Запрос.УстановитьПараметр("ИтогоПлощадьФактическаяСдачаИнвестору", СтруктураПараметров.ИтогоПлощадьФактическаяСдачаИнвестору);
	Запрос.УстановитьПараметр("ИтогоСуммаЗатратСдачаИнвестору",        СтруктураПараметров.ИтогоСуммаЗатратСдачаИнвестору);
	
	Запрос.УстановитьПараметр("РасчетПоСуммеЗатрат", СтруктураПараметров.РасчетПоСуммеЗатрат);
	
	Пакет = Запрос.ВыполнитьПакет();
	
	ТЗ_ИнвестиционныйНДС = Пакет[1].Выгрузить();
	ТЗ_ПринятиеКУчету    = Пакет[2].Выгрузить();
	ТЗ_СдачаИнвестору    = Пакет[3].Выгрузить();
	
	Возврат Новый Структура("ИнвестиционныйНДС, ПринятиеКУчету, СдачаИнвестору", ТЗ_ИнвестиционныйНДС, ТЗ_ПринятиеКУчету, ТЗ_СдачаИнвестору);
	
