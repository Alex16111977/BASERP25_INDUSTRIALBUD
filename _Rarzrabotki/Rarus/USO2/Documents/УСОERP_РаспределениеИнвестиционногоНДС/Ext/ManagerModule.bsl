// Сформировать печатные формы объектов
//
// ВХОДЯЩИЕ:
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//
// ИСХОДЯЩИЕ:
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "РеестрСчетФактурПолученных") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "РеестрСчетФактурПолученных", "Реестр счет-фактур полученных", СформироватьПечатнуюФормуРеестрСчетФактурПолученных(МассивОбъектов, ОбъектыПечати,ПараметрыПечати));
	КонецЕсли;

	ФормированиеПечатныхФорм.ЗаполнитьПараметрыОтправки(ПараметрыВывода.ПараметрыОтправки, МассивОбъектов, КоллекцияПечатныхФорм);
	
КонецПроцедуры

Функция СформироватьПечатнуюФормуРеестрСчетФактурПолученных(МассивОбъектов, ОбъектыПечати,ПараметрыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Макет	= Документы.УСОERP_РаспределениеИнвестиционногоНДС.ПолучитьМакет("РеестрСчетФактурПолученных");
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СдачаИнвестору.ОбъектНедвижимости,
	|	СдачаИнвестору.ПлощадьФактическая,
	|	СдачаИнвестору.СуммаЗатрат,
	|	СдачаИнвестору.ДокументПоступления,
	|	СдачаИнвестору.НДСПоДДУ,
	|	СдачаИнвестору.СуммаБезНДС,
	|	СдачаИнвестору.СуммаНДС,
	|	СдачаИнвестору.СуммаБезНДСПрочиеРасходы,
	|	СдачаИнвестору.СуммаНДСПрочиеРасходы,
	|	СдачаИнвестору.СчетРасчетов,
	|	СдачаИнвестору.Контрагент,
	|	СдачаИнвестору.Договор,
	|	СдачаИнвестору.СчетФактура,
	|	СдачаИнвестору.ДокументПоступления.Контрагент КАК Поставщик,
	|	СдачаИнвестору.ДокументПоступления.Договор КАК ДоговорПоставщика
	|ИЗ
	|	Документ.УСОERP_РаспределениеИнвестиционногоНДС.СдачаИнвестору КАК СдачаИнвестору
	|ГДЕ
	|	СдачаИнвестору.Ссылка = &ДокументСсылка
	|	И СдачаИнвестору.Контрагент = &Контрагент
	|	И СдачаИнвестору.Договор = &Договор";
	
	Запрос.УстановитьПараметр("ДокументСсылка", МассивОбъектов);
	Запрос.УстановитьПараметр("Контрагент",ПараметрыПечати.Контрагент);
	Запрос.УстановитьПараметр("Договор",ПараметрыПечати.Договор);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;  	
	
	Область = Макет.ПолучитьОбласть("Шапка");
	Область.Параметры.Контрагент 	= ПараметрыПечати.Контрагент;
	Область.Параметры.Договор 		= ПараметрыПечати.Договор;
	ТабличныйДокумент.Вывести(Область);
	
	Для Каждого ТекСтрока Из Результат Цикл
		
		Строка = Макет.ПолучитьОбласть("Строка");
		Строка.Параметры.Поставщик 			= ТекСтрока.Поставщик;
		Строка.Параметры.ДоговорПоставщика 	= ТекСтрока.ДоговорПоставщика;
		Строка.Параметры.СчетФактура 		= ТекСтрока.ДокументПоступления;
		Строка.Параметры.СтавкаНДС 			= Перечисления.СтавкиНДС.НДС18;
		Строка.Параметры.СтавкаНДС 			= ?(ЗначениеЗаполнено(ТекСтрока.ДоговорПоставщика.СтавкаНДС),ТекСтрока.ДоговорПоставщика.СтавкаНДС,Перечисления.СтавкиНДС.НДС18);
		Строка.Параметры.СуммаБезНДС		= ТекСтрока.СуммаБезНДС;
		Строка.Параметры.НДС 				= ТекСтрока.СуммаНДС;
		Строка.Параметры.СуммаСНДС 			= ТекСтрока.СуммаБезНДС + ТекСтрока.СуммаНДС;
		
		ТабличныйДокумент.Вывести(Строка);
		
	КонецЦикла; 		
	
	Возврат ТабличныйДокумент;  	
	
КонецФункции 

// Функция формирует и возвращает текст запроса для подготовки виртуальной таблицы по табл. части "НДС инвестиционный".
//
Функция ТекстЗапросаТаблицаНДСИнвестиционный()
	
	ТекстЗапроса = "ВЫБРАТЬ //// [4] ТаблицаНДСИнвестиционный
	               |	ТаблицаНДСИнвестиционный.НомерСтроки КАК НомерСтроки,
	               |	&Период КАК Период,
	               |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	               |	&Организация КАК Организация,
				   |	ТаблицаНДСИнвестиционный.Контрагент КАК Контрагент,
				   |	ТаблицаНДСИнвестиционный.ДокументПоступления КАК ДокументПоступления,
				   |	ТаблицаНДСИнвестиционный.Ссылка.ОбъектСтроительства КАК ОбъектСтроительства,
				   |	ТаблицаНДСИнвестиционный.СчетУчетаНДС КАК СчетУчетаНДС,
				   |	ТаблицаНДСИнвестиционный.Номенклатура КАК Номенклатура,
				   |	ТаблицаНДСИнвестиционный.СпособСтроительства КАК СпособСтроительства,
				   |	ТаблицаНДСИнвестиционный.СуммаБезНДС КАК СуммаБезНДС,
				   |	ТаблицаНДСИнвестиционный.СуммаНДС КАК СуммаНДС
	               |ИЗ
	               |	Документ.УСОERP_РаспределениеИнвестиционногоНДС.НДСИнвестиционный КАК ТаблицаНДСИнвестиционный
	               |ГДЕ
	               |	ТаблицаНДСИнвестиционный.Ссылка = &ТекущийДокумент
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки
	               |;
	               |////////////////////////////////////////////////////////////////////////////////
	               |";
	
	Возврат ТекстЗапроса;
	
КонецФункции // ТекстЗапросаТаблицаПринятиеКУчету()

#Область ПрограммныйИнтерфейс

// Возвращает текст запроса для расчета необходимости ввода счета-фактуры выданного.
//	Возвращаемое значение:
//		Строка - текст запроса
//
Функция ТекстЗапросаДляРасчетаНеобходимостиСчетаФактуры() Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеДокумента.Ссылка КАК Основание,
	|	ДанныеДокумента.Ссылка.Дата КАК ДатаДокумента,
	|	ДанныеДокумента.Ссылка.Организация КАК Организация,
	|	ДанныеДокумента.Контрагент КАК Контрагент,
	|	ДанныеДокумента.Ссылка.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА ТаблицаСчетовФактуры.СчетФактура ЕСТЬ NULL 
	|				И ДанныеДокумента.Ссылка.Проведен
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Требуется
	|ИЗ
	|	Документ.УСОERP_РаспределениеИнвестиционногоНДС.СдачаИнвестору КАК ДанныеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаСчетовФактуры КАК ТаблицаСчетовФактуры
	|		ПО ДанныеДокумента.Ссылка = ТаблицаСчетовФактуры.Основание
	|			И ДанныеДокумента.Ссылка.Организация = ТаблицаСчетовФактуры.Организация
	|			И ДанныеДокумента.Контрагент = ТаблицаСчетовФактуры.Контрагент
	|ГДЕ
	|	ДанныеДокумента.Ссылка В(&МассивОснований)";
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ТекстУсловия%", ТекстУсловияТребуетсяСчетФактура());
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Возвращает текст условия запроса, по которым документу требуется счет-фактура.
// Условие применяется для таблица "ДанныеДокумента", содержащую реквизиты документа.
//
// Параметры:
//	 ОграничитьПоТипуНалогообложения - Булево - Добавляет ограничительное условие на тип налогообложения.
//		см. РегистрыСведений.ТребуетсяОформлениеСчетаФактуры.МассивТиповНалогообложенияНДСТребуемыхОформления()
//
//	Возвращаемое значение:
//		Строка - текст условия запроса
//
Функция ТекстУсловияТребуетсяСчетФактура(ОграничитьПоТипуНалогообложения = Истина) Экспорт
	
	ТекстУсловия = "ИСТИНА";
		
	Возврат ТекстУсловия;
	
КонецФункции

// Формирует текст запроса для получения данных основания при печати Счет-фактуры.
//
Функция ТекстЗапросаДанныхОснованияДляПечатнойФормыСчетФактура() Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДанныеДокументов.Ссылка										КАК Ссылка,
	|	ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПустаяСсылка) 	КАК ХозяйственнаяОперация,
	|	ДанныеДокументов.Валюта										КАК Валюта,
	|	ДанныеДокументов.Организация								КАК Организация,
	|	ДанныеДокументов.НалогообложениеНДС                         КАК НалогообложениеНДС, 
	|	ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)		КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)                  	КАК Склад,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)             	КАК Грузоотправитель,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)             	КАК Грузополучатель,
	|	ЛОЖЬ                                                      	КАК РасчетыЧерезОтдельногоКонтрагента,
	|	НЕОПРЕДЕЛЕНО                                              	КАК Номенклатура,
	|	""""                                                      	КАК Содержание,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)             	КАК Комиссионер,
	|	НЕОПРЕДЕЛЕНО                                              	КАК Основание,
	|	НЕОПРЕДЕЛЕНО                                                КАК ОснованиеДата,
	|	НЕОПРЕДЕЛЕНО                                                КАК ОснованиеНомер, 
	|	НЕОПРЕДЕЛЕНО                                              	КАК ДоверенностьНомер,
	|	НЕОПРЕДЕЛЕНО                                              	КАК ДоверенностьДата,
	|	НЕОПРЕДЕЛЕНО                                              	КАК ДоверенностьВыдана,
	|	НЕОПРЕДЕЛЕНО                                              	КАК ДоверенностьЛицо,
	|	НЕОПРЕДЕЛЕНО                                              	КАК Кладовщик,
	|	НЕОПРЕДЕЛЕНО                                              	КАК ДолжностьКладовщика
	|
	|//ОператорПОМЕСТИТЬ
	|ИЗ
	|	Документ.УСОERP_РаспределениеИнвестиционногоНДС КАК ДанныеДокументов
	|ГДЕ
	|	ДанныеДокументов.Ссылка В (&ДокументОснование_УСОERP_РаспределениеИнвестиционногоНДС)";
		
	Возврат ТекстЗапроса;
	
КонецФункции

// Формирует временную таблицу, содержащую табличную часть по таблице данных документов.
//
// Параметры:
//	МенеджерВременныхТаблиц - МенеджерВременныхТаблиц - Менеджер временных таблиц, содержащий таблицу ТаблицаДанныхДокументов с полями:
//		Ссылка,
//		Валюта.
//
//	ПараметрыЗаполнения - Структура - структура, возвращаемая функцией ПродажиСервер.ПараметрыЗаполненияВременнойТаблицыТоваров
//
Процедура ПоместитьВременнуюТаблицуТоваров(МенеджерВременныхТаблиц, ПараметрыЗаполнения = Неопределено) Экспорт
	
	Если ПараметрыЗаполнения = Неопределено Тогда
		ПараметрыЗаполнения = ПродажиСервер.ПараметрыЗаполненияВременнойТаблицыТоваров();
	КонецЕсли;
	
	ЗапросСФ = Новый Запрос;
	ЗапросСФ.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ЗапросСФ.Текст = "ВЫБРАТЬ
	|	СчетаФактурыОснования.Ссылка
	|ИЗ
	|	СчетаФактурыОснования КАК СчетаФактурыОснования";
	Результат = ЗапросСФ.Выполнить().Выгрузить();
	Результат.Свернуть("Ссылка");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("ПересчитыватьВВалютуРегл",       ПараметрыЗаполнения.ПересчитыватьВВалютуРегл);
	Запрос.УстановитьПараметр("ПустаяГТД",                      Справочники.НомераГТД.ПустаяСсылка());
	
	Если Результат.Количество() <> 0 Тогда
		Запрос.УстановитьПараметр("СчетФактура",                      Результат[0].Ссылка);
	Иначе
		Запрос.УстановитьПараметр("СчетФактура",                      Документы.СчетФактураВыданный.ПустаяСсылка());
	КонецЕсли;
	
	Если ПараметрыЗаполнения.ПересчитыватьВВалютуРегл И ПараметрыЗаполнения.АктуализироватьРасчеты Тогда
		
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РасчетыСКлиентами.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам
		|ИЗ
		|	РегистрНакопления.РасчетыСКлиентами КАК РасчетыСКлиентами
		|
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|		ТаблицаДанныхДокументов КАК ДанныеДокументов
		|	ПО
		|		РасчетыСКлиентами.Регистратор = ДанныеДокументов.Ссылка
		|
		|ГДЕ
		|	ДанныеДокументов.Валюта <> &ВалютаРегламентированногоУчета
		|	И РасчетыСКлиентами.Активность
		|";
		ТаблицаАналитик = Запрос.Выполнить().Выгрузить();
		МассивАналитикУчетаПоПартнерам = ТаблицаАналитик.ВыгрузитьКолонку("АналитикаУчетаПоПартнерам");
		
		ОкончаниеПериодаРасчета = ТекущаяДатаСеанса();
		РаспределениеВзаиморасчетовВызовСервера.РаспределитьВсеРасчетыСКлиентами(ОкончаниеПериодаРасчета, МассивАналитикУчетаПоПартнерам);
		
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаДокумента.Ссылка КАК Ссылка,
	|	МАКСИМУМ(ТаблицаДокумента.НомерСтроки) КАК НомерСтроки,
	|	""Выполнение СМР по объекту строительства: "" + ТаблицаДокумента.Ссылка.ОбъектСтроительства.Наименование КАК Содержание,
	|	1 КАК Количество,
	|	1 КАК КоличествоУпаковок,
	|	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) КАК ЕдиницаИзмерения,
	|	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) КАК Упаковка,
	|	СУММА(ТаблицаДокумента.СуммаБезНДС) КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.Договор.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18)
	|		ИНАЧЕ ТаблицаДокумента.Договор.СтавкаНДС
	|	КОНЕЦ КАК СтавкаНДС,
	|	СУММА(ТаблицаДокумента.СуммаНДС) КАК СуммаНДС,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
	|	&ПустаяГТД КАК НомерГТД,
	|	ЛОЖЬ КАК ЭтоТовар,
	|	ЛОЖЬ КАК ВернутьМногооборотнуюТару
	|ПОМЕСТИТЬ УСОERP_РаспределениеИнвестиционногоНДСТаблицаТоваров
	|ИЗ
	|	Документ.УСОERP_РаспределениеИнвестиционногоНДС.СдачаИнвестору КАК ТаблицаДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхДокументов КАК ДанныеДокументов
	|		ПО ТаблицаДокумента.Ссылка = ДанныеДокументов.Ссылка
	|ГДЕ
	|	ТаблицаДокумента.СчетФактура = &СчетФактура
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДокумента.Ссылка,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.Договор.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18)
	|		ИНАЧЕ ТаблицаДокумента.Договор.СтавкаНДС
	|	КОНЕЦ,
	|	""Выполнение СМР по объекту строительства: "" + ТаблицаДокумента.Ссылка.ОбъектСтроительства.Наименование";
	
	Запрос.Выполнить();
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли

