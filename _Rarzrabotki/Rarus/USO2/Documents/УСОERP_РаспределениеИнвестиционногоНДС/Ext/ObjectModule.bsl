#Область ОбработчикиСобытий

// Процедура - обработчик события "ОбработкаЗаполнения" модуля объекта документа.
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УСОERP_ЗакрытиеОбъектаСтроительства") 
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УСОERP_СдачаОбъектаНедвижимости") 
		Тогда
		Организация = ДанныеЗаполнения.Организация;
		ДокументОснование = ДанныеЗаполнения.Ссылка;
		ОбъектСтроительства = ДанныеЗаполнения.ОбъектСтроительства;
	КонецЕсли;
	
	ИнициализироватьДокумент(ДанныеЗаполнения);
	
КонецПроцедуры // ОбработкаЗаполнения()

// Процедура - обработчик события "ПриКопировании" модуля объекта документа.
//
Процедура ПриКопировании(ОбъектКопирования)
	
	ИнициализироватьДокумент();
	
КонецПроцедуры // ПриКопировании()

// Процедура - обработчик события "ОбработкаПроверкиЗаполнения" модуля объекта документа.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если НДСИнвестиционный.Итог("СуммаНДСПринятиеКУчету") <> ПринятиеКУчету.Итог("СуммаНДС") Тогда
		ТекстСообщения = НСтр("ru = 'Сумма по колонке ""Сумма НДС"" ТЧ ""Принятие к учету"" не равна итоговой сумме НДС к принятию.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , , "Объект", Отказ);
	КонецЕсли; 
	
	Если НДСИнвестиционный.Итог("СуммаНДСПередачаИнвестору") <> СдачаИнвестору.Итог("СуммаНДС") + СдачаИнвестору.Итог("СуммаНДСПрочиеРасходы") Тогда
		ТекстСообщения = НСтр("ru = 'Сумма по колонкам ""Сумма НДС"" и ""Сумма НДС (прочие расходы)"" ТЧ ""Передача инвестору"" не равна итоговой сумме НДС к передаче.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , , "Объект", Отказ);
	КонецЕсли; 
	
КонецПроцедуры // ОбработкаПроверкиЗаполнения()

// Процедура - обработчик события "ПередЗаписью" модуля объекта документа.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		Валюта        = Константы.ВалютаРегламентированногоУчета.Получить();
    КонецЕсли;

	ПроведениеСерверУТ.УстановитьРежимПроведения(ЭтотОбъект, РежимЗаписи, РежимПроведения);

	ДополнительныеСвойства.Вставить("ЭтоНовый"	  , ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи" , РежимЗаписи);
	
	НалогообложениеНДС = Справочники.Организации.НалогообложениеНДС(Организация,,Дата);
	
КонецПроцедуры // ПередЗаписью()

// Процедура - обработчик события "ОбработкаПроведения" модуля объекта документа.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)	
	
	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения); 
	Документы.УСОERP_РаспределениеИнвестиционногоНДС.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	Если ПолучитьФункциональнуюОпцию("УСОERP_НоваяУчетнаяПолитикаПоДолевомуСтроительству") = Ложь Тогда
		
	ДоходыИРасходыСервер.ОтразитьСебестоимостьТоваров(ДополнительныеСвойства, Движения, Отказ);
	ПартионныйУчетСервер.ОтразитьПартииТоваровОрганизаций(ДополнительныеСвойства, Движения, Отказ);
	
	РеглУчетПроведениеСервер.ЗарегистрироватьКОтражению(ЭтотОбъект, ДополнительныеСвойства, Движения, Отказ);
	
	//Документы.УСОERP_РаспределениеИнвестиционногоНДС.СформироватьДокументыЗаписьКнигиПокупок(Ссылка, Отказ);
   КонецЕсли;

	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	ПроведениеСерверУТ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
		
КонецПроцедуры // ОбработкаПроведения()

