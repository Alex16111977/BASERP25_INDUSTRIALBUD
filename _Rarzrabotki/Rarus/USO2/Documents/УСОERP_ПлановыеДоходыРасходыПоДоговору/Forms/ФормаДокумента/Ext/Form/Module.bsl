&НаСервере
Функция ВернутьОборотыНаДату(Организация, Контрагент, Договор, ОбъектСтроительства, НачалоПериода, ОкончаниеПериода)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("ОбъектСтроительства", ОбъектСтроительства);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УСОERP_ПлановыеРасходыОбороты.Период КАК Период,
	               |	УСОERP_ПлановыеРасходыОбороты.Подразделение КАК Подразделение,
	               |	УСОERP_ПлановыеРасходыОбороты.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	               |	СУММА(ЕСТЬNULL(УСОERP_ПлановыеРасходыОбороты.ПланируемаяСуммаДоходовПоДоговоруОборот, 0)) КАК СуммаДоходов,
	               |	СУММА(ЕСТЬNULL(УСОERP_ПлановыеРасходыОбороты.ПланируемаяСуммаРасходовПоДоговоруОборот, 0)) КАК СуммаРасходов
	               |ИЗ
	               |	РегистрНакопления.УСОERP_ПлановыеДоходыРасходы.Обороты(
	               |			&НачалоПериода,
	               |			&ОкончаниеПериода,
	               |			Месяц,
	               |			Организация = &Организация
	               |				И Контрагент = &Контрагент
	               |				И Договор = &Договор
	               |				И ОбъектСтроительства = &ОбъектСтроительства) КАК УСОERP_ПлановыеРасходыОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	УСОERP_ПлановыеРасходыОбороты.Подразделение,
	               |	УСОERP_ПлановыеРасходыОбороты.НоменклатурнаяГруппа,
	               |	УСОERP_ПлановыеРасходыОбороты.Период
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Подразделение,
	               |	НоменклатурнаяГруппа,
	               |	Период";
	Возврат Запрос.Выполнить().Выбрать();			   
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПлановыеСуммыРасходовНаСервере(Отказ = Ложь, ТекстОшибки ="")
	
	Объект.ПлановыеСуммыРасходовПоПериодам.Очистить();
	
	Если НЕ ЗначениеЗаполнено(Объект.ПериодНачала) Или НЕ ЗначениеЗаполнено(Объект.ПериодОкончания) Тогда
		Отказ = Истина;
		ТекстОшибки = "Не определен период формирования данных!"; 
		Возврат;
	КонецЕсли;	
	
	Если  НЕ ЗначениеЗаполнено(Объект.Организация) Или НЕ ЗначениеЗаполнено(Объект.Контрагент) 
		Или НЕ ЗначениеЗаполнено(Объект.Договор) Или НЕ ЗначениеЗаполнено(Объект.ОбъектСтроительства) Тогда
		Отказ = Истина;
		ТекстОшибки = "Не все реквизиты заполнены!";
		Возврат;
	КонецЕсли;
	
	РезультатЗапроса = ВернутьОборотыНаДату(Объект.Организация, Объект.Контрагент, Объект.Договор, Объект.ОбъектСтроительства, Объект.ПериодНачала, Объект.ПериодОкончания);
	
	Пока РезультатЗапроса.Следующий() Цикл
		стрПлановыхСумм 									= Объект.ПлановыеСуммыРасходовПоПериодам.Добавить();
		стрПлановыхСумм.Период 								= РезультатЗапроса.Период;
		стрПлановыхСумм.Подразделение 						= РезультатЗапроса.Подразделение;
		стрПлановыхСумм.НоменклатурнаяГруппа 				= РезультатЗапроса.НоменклатурнаяГруппа;			
		стрПлановыхСумм.ПланируемаяСуммаРасходовНаНачало 	= РезультатЗапроса.СуммаРасходов;
		стрПлановыхСумм.ПланируемаяСуммаДоходовНаНачало 	= РезультатЗапроса.СуммаДоходов;
	КонецЦикла;	
												
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПлановыеСуммыРасходов(Команда)
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьПлановыеСуммыРасходовПродолжение",ЭтотОбъект),"Табличная часть будет очищена! Продолжить?", РежимДиалогаВопрос.ДаНет);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПлановыеСуммыРасходовПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	ТекстОшибки ="";

	ЗаполнитьПлановыеСуммыРасходовНаСервере(Отказ, ТекстОшибки);
	Модифицированность = Истина;
	
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;	
	
КонецПроцедуры

