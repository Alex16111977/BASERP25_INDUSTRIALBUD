&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	ДанныеДоговора = ПолучитьДанныеПоДоговору(Объект.Договор);
	ЗаполнитьЗначенияСвойств(Объект, ДанныеДоговора);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеПоДоговору(Договор)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УСОERP_ДополнительныеПараметрыПоДоговору.Ссылка КАК ДополнительныеПараметрыПоДоговору,
		|	УСОERP_ДополнительныеПараметрыПоДоговору.ОбъектСтроительства
		|ИЗ
		|	Документ.УСОERP_ДополнительныеПараметрыПоДоговору КАК УСОERP_ДополнительныеПараметрыПоДоговору
		|ГДЕ
		|	УСОERP_ДополнительныеПараметрыПоДоговору.Договор = &Договор
		|	И НЕ УСОERP_ДополнительныеПараметрыПоДоговору.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	УСОERP_ДополнительныеПараметрыПоДоговору.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Договор", Договор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбъектСтроительства = Справочники.СМ_ОбъектыСтроительства.ПустаяСсылка();
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ОбъектСтроительства = Выборка.ОбъектСтроительства;
	КонецЕсли;
	
	Возврат Новый Структура("Организация, ОбъектСтроительства, ПериодНачала, ПериодОкончания", Договор.Организация, ОбъектСтроительства, Договор.ДатаНачалаДействия, Договор.ДатаОкончанияДействия);
	
КонецФункции

