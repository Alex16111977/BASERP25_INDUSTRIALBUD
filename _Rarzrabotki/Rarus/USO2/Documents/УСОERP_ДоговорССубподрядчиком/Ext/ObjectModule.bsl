
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ЗаполнениеСвойствПоСтатистикеСервер.ЗаполнитьСвойстваОбъекта(ЭтотОбъект, ДанныеЗаполнения);	
	ИнициализироватьДокумент(ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаправлениеДеятельности) Тогда
		НаправлениеДеятельности = ДокументУтверждения.НаправлениеДеятельности;
	КонецЕсли; 
	
	ДатаДоговора = Договор.Дата;
	НомерДоговора = Договор.Номер;
	
	ПроведениеСерверУТ.УстановитьРежимПроведения(ЭтотОбъект, РежимЗаписи, РежимПроведения);

	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
	ПроверитьВхождениеРаботВДоговораССубподрядчиком(Отказ);
	ПроверитьОбъемРабот(Отказ);
	КонецЕсли;

	СуммаДокумента = ПолучитьСуммуДокумента();

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	Документы.УСОERP_ДоговорССубподрядчиком.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	Если Статус = Перечисления.СтатусыПланов.Утвержден Тогда
		
		ПроверитьНаДубликаты(Отказ);
		
		УСОERP_УправлениеСтроительнымПроизводством.ОтразитьДвиженияВыполнениеРаботСубподрядчиком(ДополнительныеСвойства, Движения, Отказ);
		ОтразитьДвижения_ГрафикДвиженийПоДоговору(ДополнительныеСвойства, Движения, Отказ);
		ВзаиморасчетыСервер.ОтразитьРасчетыСПоставщиками(ДополнительныеСвойства, Движения, Отказ);
		
	КонецЕсли;
	
	СформироватьСписокРегистровДляКонтроля(); 
	
	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСерверУТ.ВыполнитьКонтрольРезультатовПроведения(ЭтотОбъект, Отказ);    
	
	ПроведениеСерверУТ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	СформироватьСписокРегистровДляКонтроля();
	
	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСерверУТ.ВыполнитьКонтрольРезультатовПроведения(ЭтотОбъект, Отказ);
	
	ПроведениеСерверУТ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИнициализироватьДокумент();
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка ИЛИ ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьНаДубликаты(Отказ)
	
	Запрос = Новый Запрос;	

	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_ДоговорССубподрядчикомРаботы.Работа КАК Работа,
	|	УСОERP_ДоговорССубподрядчикомРаботы.Работа.КодСДР КАК КодСДР,
	|	УСОERP_ДоговорССубподрядчикомРаботы1.Ссылка КАК Ссылка,
	|	УСОERP_ДоговорССубподрядчикомРаботы1.Ссылка.Номер КАК Номер,
	|	УСОERP_ДоговорССубподрядчикомРаботы1.Ссылка.Дата КАК Дата
	|ИЗ
	|	Документ.УСОERP_ДоговорССубподрядчиком.Работы КАК УСОERP_ДоговорССубподрядчикомРаботы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_ДоговорССубподрядчиком.Работы КАК УСОERP_ДоговорССубподрядчикомРаботы1
	|		ПО УСОERP_ДоговорССубподрядчикомРаботы.Работа.РаботаИсточник = УСОERP_ДоговорССубподрядчикомРаботы1.Работа.РаботаИсточник
	|			И УСОERP_ДоговорССубподрядчикомРаботы.Ссылка.Договор = УСОERP_ДоговорССубподрядчикомРаботы1.Ссылка.Договор
	|ГДЕ
	|	УСОERP_ДоговорССубподрядчикомРаботы.Ссылка = &Ссылка
	|	И УСОERP_ДоговорССубподрядчикомРаботы1.Ссылка.Проведен
	|	И УСОERP_ДоговорССубподрядчикомРаботы1.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|	И УСОERP_ДоговорССубподрядчикомРаботы1.Ссылка.Ссылка <> &Ссылка
	|	И НЕ УСОERP_ДоговорССубподрядчикомРаботы.Работа.СуммарнаяРабота";
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Пока Выборка.Следующий() Цикл
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По работе "+Выборка.Работа+"("+Выборка.КодСДР+") уже есть утвержденный документ (№ "+Выборка.Номер+" от "+Выборка.Дата+")",,,,Отказ);
			
	КонецЦикла; 	
	
КонецФункции  

#КонецОбласти

#Область ОбработчикиДвиженийДокумента

Процедура ОтразитьДвижения_ГрафикДвиженийПоДоговору(ДополнительныеСвойства, Движения, Отказ)
	
	ТаблицаДвижений = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаГрафикДвиженийПоДоговору;
	
	Если Отказ ИЛИ ТаблицаДвижений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ДвиженияГрафик = Движения.УСОERP_ГрафикДвиженийПоДоговору;
	ДвиженияГрафик.Записывать = Истина;
	ДвиженияГрафик.Загрузить(ТаблицаДвижений);

КонецПроцедуры

Процедура ОтразитьДвижения_РегистрНакопленияРасчеты(ДополнительныеСвойства, Движения, Отказ)
	
	ТаблицаДвижений = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаРегистрНакопленияРасчеты;
	
	Если Отказ ИЛИ ТаблицаДвижений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если Договор.ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком 
		ИЛИ Договор.ТипДоговора = Перечисления.ТипыДоговоров.СПереработчиком Тогда
		ДвиженияГрафик = Движения.РасчетыСПоставщиками;
	Иначе
		Возврат;
	КонецЕсли;
	
	ДвиженияГрафик.Записывать = Истина;
	ДвиженияГрафик.Загрузить(ТаблицаДвижений);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ДатыЗаполнены = Истина;
	
	Если НЕ ИспользоватьПонижающийКоэффициент Тогда
		
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ПонижающийКоэффициент"));
		
	КонецЕсли;
	
	
	Для каждого Строка  Из ГрафикДвиженияПоДоговору  Цикл
		
		ДатыЗаполнены = ЗначениеЗаполнено(Строка.ДатаСобытия)
						ИЛИ ЗначениеЗаполнено(Строка.ДатаАванс)
						ИЛИ ЗначениеЗаполнено(Строка.ДатаПриемРабот)
						ИЛИ ЗначениеЗаполнено(Строка.ДатаОстатокПлатежа)
						ИЛИ ЗначениеЗаполнено(Строка.ДатаВозвратГарантийногоУдержания);
		
	    Если Не ДатыЗаполнены Тогда
		
			Прервать;
		
		КонецЕсли; 
	КонецЦикла; 
	
	Если Не ДатыЗаполнены Тогда
		ТекстСообщения = НСтр("ru = 'Неверно заполнены даты'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
		Отказ = Истина;		
	
	КонецЕсли; 
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

#Область Инициализация

Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Ответственный        = Пользователи.ТекущийПользователь(); 
	Валюта                = ЗначениеНастроекПовтИсп.ПолучитьВалютуРегламентированногоУчета(Валюта); 
	Организация          = ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Организация);

КонецПроцедуры

#КонецОбласти

#Область Прочее

Функция ПолучитьСуммуДокумента()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Работы.Работа КАК Работа,
	|	Работы.СуммаСНДС КАК СуммаСНДС
	|ПОМЕСТИТЬ Работы
	|ИЗ
	|	&Работы КАК Работы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Работы.СуммаСНДС), 0) КАК СуммаСНДС
	|ИЗ
	|	Работы КАК Работы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УСОERP_СтроительныеРаботы КАК СтроительныеРаботы
	|		ПО Работы.Работа = СтроительныеРаботы.Ссылка
	|ГДЕ
	|	НЕ СтроительныеРаботы.СуммарнаяРабота");
	
	Запрос.УстановитьПараметр("Работы", Работы.Выгрузить(,"Работа,СуммаСНДС"));	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	СуммаИтого = Выгрузка[0].СуммаСНДС;
	Возврат СуммаИтого;
	
КонецФункции

Процедура СформироватьСписокРегистровДляКонтроля()

	Массив = Новый Массив;
	
 	Если ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
	КонецЕсли;
	
	ДополнительныеСвойства.ДляПроведения.Вставить("РегистрыДляКонтроля", Массив);
	
КонецПроцедуры

Процедура ПроверитьВхождениеРаботВДоговораССубподрядчиком(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_ДоговорССубподрядчикомРаботы.НомерСтроки,
	|	УСОERP_ДоговорССубподрядчикомРаботы.КодСДР,
	|	ВЫРАЗИТЬ(УСОERP_ДоговорССубподрядчикомРаботы.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа
	|ПОМЕСТИТЬ ВТ_РаботыДокумента
	|ИЗ
	|	&Работы КАК УСОERP_ДоговорССубподрядчикомРаботы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Регистратор,
	|	ВТ_РаботыДокумента.НомерСтроки КАК НомерСтроки,
	|	ВТ_РаботыДокумента.КодСДР,
	|	ВТ_РаботыДокумента.Работа КАК Работа,
	|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Работа КАК Работа1
	|ИЗ
	|	ВТ_РаботыДокумента КАК ВТ_РаботыДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УСОERP_ВыполнениеРаботСубподрядчиком.Обороты(
	|				,
	|				,
	|				Авто,
	|				Работа В
	|						(ВЫБРАТЬ
	|							ВТ_РаботыДокумента.Работа
	|						ИЗ
	|							ВТ_РаботыДокумента КАК ВТ_РаботыДокумента)
	|					И Организация = &Организация) КАК УСОERP_ВыполнениеРаботСубподрядчикомОбороты
	|		ПО ВТ_РаботыДокумента.Работа = УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Работа
	|ГДЕ
	|	ЕСТЬNULL(УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Работа, ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|	И УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Регистратор ССЫЛКА Документ.УСОERP_ДоговорССубподрядчиком
	|	И УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Регистратор <> &Ссылка
	|	И ВТ_РаботыДокумента.Работа.СуммарнаяРабота
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки,
	|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Регистратор.Дата,
	|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Регистратор.Номер
	|ИТОГИ ПО
	|	Работа";
	Запрос.УстановитьПараметр("Работы", Работы.Выгрузить());
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Соглашение", Соглашение);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаРабота = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРабота.Следующий() Цикл
		
		СтрокаДокументов = "";
		Выборка = ВыборкаРабота.Выбрать();
		КодСДР = "";
		Пока Выборка.Следующий() Цикл
			Если СтрокаДокументов = "" Тогда
				СтрокаДокументов = СтрокаДокументов + Выборка.Регистратор;
			Иначе
				СтрокаДокументов = СтрокаДокументов + ", " + Символы.ПС + Выборка.Регистратор;
			КонецЕсли;
			КодСДР = Выборка.КодСДР;
		КонецЦикла;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для работы " + СокрЛП(КодСДР) + " " +
					СокрЛП(ВыборкаРабота.Работа) + " уже есть созданный договор с субподрядчиком: " +
					СокрЛП(СтрокаДокументов));
								
	КонецЦикла;
	Отказ = Истина;
	
КонецПроцедуры

Процедура ПроверитьОбъемРабот(Отказ)
	
	Запрос = Новый Запрос;

	Если ДокументУтверждения.СценарийПланирования.НовыйВариант Тогда
		
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_ДоговорССубподрядчикомРаботы.НомерСтроки КАК НомерСтроки,
	|	УСОERP_ДоговорССубподрядчикомРаботы.КодСДР КАК КодСДР,
	|	ВЫРАЗИТЬ(УСОERP_ДоговорССубподрядчикомРаботы.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	УСОERP_ДоговорССубподрядчикомРаботы.Объем КАК Объем,
	|	УСОERP_ДоговорССубподрядчикомРаботы.ЕдиницаОбъема КАК ЕдиницаОбъема
	|ПОМЕСТИТЬ ВТ_РаботыДокумента
	|ИЗ
	|	&Работы КАК УСОERP_ДоговорССубподрядчикомРаботы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РаботыДокумента.НомерСтроки КАК НомерСтроки,
	|	ВТ_РаботыДокумента.КодСДР КАК КодСДР,
	|	ВТ_РаботыДокумента.Работа КАК Работа,
	|	ВТ_РаботыДокумента.Объем КАК Объем,
	|	ВТ_РаботыДокумента.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ВТ_РаботыДокумента.Работа.ОбъемРаботы КАК ОбъемПлан
	|ИЗ
	|	ВТ_РаботыДокумента КАК ВТ_РаботыДокумента
	|ГДЕ
	|	ВТ_РаботыДокумента.Объем > ВТ_РаботыДокумента.Работа.ОбъемРаботы
	|	И НЕ ВТ_РаботыДокумента.Работа.СуммарнаяРабота
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки"; 
		
		
	Иначе
		
	
		Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_ДоговорССубподрядчикомРаботы.НомерСтроки,
	|	УСОERP_ДоговорССубподрядчикомРаботы.КодСДР,
	|	УСОERP_ДоговорССубподрядчикомРаботы.Работа,
	|	УСОERP_ДоговорССубподрядчикомРаботы.Объем,
	|	УСОERP_ДоговорССубподрядчикомРаботы.ЕдиницаОбъема
	|ПОМЕСТИТЬ ВТ_РаботыДокумента
	|ИЗ
	|	&Работы КАК УСОERP_ДоговорССубподрядчикомРаботы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РаботыДокумента.НомерСтроки КАК НомерСтроки,
	|	ВТ_РаботыДокумента.КодСДР,
	|	ВТ_РаботыДокумента.Работа,
	|	ВТ_РаботыДокумента.Объем,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа КАК Работа1,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОбъемРаботы КАК ОбъемПлан,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_РаботыДокумента.Объем, 0) > ЕСТЬNULL(УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОбъемРаботы, 0)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьОшибкаОбъема,
	|	ВТ_РаботыДокумента.ЕдиницаОбъема
	|ИЗ
	|	ВТ_РаботыДокумента КАК ВТ_РаботыДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(
	|				&КонецПериода,
	|				Работа В
	|						(ВЫБРАТЬ
	|							ВТ_РаботыДокумента.Работа
	|						ИЗ
	|							ВТ_РаботыДокумента КАК ВТ_РаботыДокумента)
	|					И Утверждена = ИСТИНА
	|					И ВидПланирования = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыПланированияСтроительныхРабот.Календарный)) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
	|		ПО ВТ_РаботыДокумента.Работа = УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа
	|ГДЕ
	|	ЕСТЬNULL(ВТ_РаботыДокумента.Объем, 0) > ЕСТЬNULL(УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОбъемРаботы, 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
КонецЕсли;

	Запрос.УстановитьПараметр("Работы", Работы.Выгрузить());
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	
	Результат  = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для работы " + СокрЛП(Выборка.КодСДР) + " " +
					СокрЛП(Выборка.Работа) + " указанный объем в документе " +
					Строка(Выборка.Объем) + " " + СокрЛП(Выборка.ЕдиницаОбъема) +
					" превышает плановый утвержденный объем " +
					Строка(Выборка.ОбъемПлан) + " " + СокрЛП(Выборка.ЕдиницаОбъема));

	КонецЦикла;
	Отказ = Истина;	
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
