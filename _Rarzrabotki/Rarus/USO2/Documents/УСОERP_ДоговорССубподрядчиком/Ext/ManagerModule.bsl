
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Прочее

// Заполняет таблицу реквизитов, зависимых от хозяйственной операции
//
// Параметры:
//	ХозяйственнаяОперация - ПеречислениеСсылка.ХозяйственныеОперации - хозяйственная операция соглашения
//	МассивВсехРеквизитов - Массив - реквизиты, которые не зависят от хозяйственной операции
//	МассивРеквизитовОперации - Массив - реквизиты, которые зависят от хозяйственной операции
//
Процедура ЗаполнитьИменаРеквизитовПоОперации(ВидОперации, МассивВсехРеквизитов, МассивРеквизитовОперации) Экспорт
	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка); 	
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса 
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстЗапросаВтТаблицаРаботы(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаВыполнениеРаботСубподрядчиком(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапроса_ГрафикДвиженийПоДоговору(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапроса_РегистрНакопленияРасчеты(Запрос, ТекстыЗапроса, Регистры);
	ПроведениеСерверУТ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);	
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_ДоговорССубподрядчиком.Дата КАК Период,
	|	УСОERP_ДоговорССубподрядчиком.Ссылка КАК Ссылка,
	|	УСОERP_ДоговорССубподрядчиком.ОбъектСтроительства КАК ОбъектСтроительства,
	|	УСОERP_ДоговорССубподрядчиком.Организация КАК Организация,
	|	УСОERP_ДоговорССубподрядчиком.Контрагент КАК Контрагент,
	|	УСОERP_ДоговорССубподрядчиком.Договор КАК Договор,
	|	УСОERP_ДоговорССубподрядчиком.Валюта КАК Валюта,
	|	УСОERP_ДоговорССубподрядчиком.Соглашение КАК Соглашение,
	|	УСОERP_ДоговорССубподрядчиком.Партнер КАК Партнер,
	|	УСОERP_ДоговорССубподрядчиком.УСОERP_РасширенныйГрафикДвижений КАК РасширенныйГрафикДвижений,
	|	УСОERP_ДоговорССубподрядчиком.Номер КАК Номер
	|ИЗ
	|	Документ.УСОERP_ДоговорССубподрядчиком КАК УСОERP_ДоговорССубподрядчиком
	|ГДЕ
	|	УСОERP_ДоговорССубподрядчиком.Ссылка = &Ссылка";
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	
	Реквизиты.Следующий();
	
	Запрос.УстановитьПараметр("Соглашение",                                  Реквизиты.Соглашение);
	Запрос.УстановитьПараметр("Партнер",                                     Реквизиты.Партнер);
	Запрос.УстановитьПараметр("ОбъектСтроительства",                         Реквизиты.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Период",                                      Реквизиты.Период);
	Запрос.УстановитьПараметр("Валюта",                                      Реквизиты.Валюта);
	Запрос.УстановитьПараметр("Организация",                                 Реквизиты.Организация);
	Запрос.УстановитьПараметр("Контрагент",                                  Реквизиты.Контрагент);
	Запрос.УстановитьПараметр("Договор",                               		 Реквизиты.Договор);
	Запрос.УстановитьПараметр("РасширенныйГрафикДвижений",                   Реквизиты.РасширенныйГрафикДвижений);
	Запрос.УстановитьПараметр("Номер",                                       Реквизиты.Номер);   	

	Запрос.УстановитьПараметр("Планирование_ЗаказПоставщику",	             Перечисления.ХозяйственныеОперации.ПланированиеПоЗаказуПоставщику);
	Запрос.УстановитьПараметр("Ссылка", 						             ДокументСсылка);
	
	АналитикаУчетаПоПартнерам = РегистрыСведений.АналитикаУчетаПоПартнерам.ЗначениеКлючаАналитики(ДокументСсылка);
	
	Если НЕ ЗначениеЗаполнено(АналитикаУчетаПоПартнерам) Тогда
		АналитикаУчетаПоПартнерам = РегистрыСведений.АналитикаУчетаПоПартнерам.СоздатьКлючАналитики(ДокументСсылка);
	КонецЕсли; 	

	Запрос.УстановитьПараметр("АналитикаУчетаПоПартнерам",		АналитикаУчетаПоПартнерам);
	
	ДокументДопПараметры = УСОERP_МодификацияКонфигурации.ПолучитьДополнительныеПараметрыПоДоговору(ДокументСсылка.Договор,ДокументСсылка.ОбъектСтроительства,ДокументСсылка.Дата,Истина,ДокументСсылка.ДокументУтверждения);
	Запрос.УстановитьПараметр("ДопПараметрыПоДоговору",УСОERP_МодификацияКонфигурации.ПолучитьДополнительныеПараметрыПоДоговору(ДокументСсылка.Договор,ДокументСсылка.ОбъектСтроительства,ДокументСсылка.Дата,Истина,ДокументСсылка.ДокументУтверждения));
	Запрос.УстановитьПараметр("ПоВидамРабот",          ДокументДопПараметры.ПоВидамРабот);
	Запрос.УстановитьПараметр("ПоРаботам",             ДокументДопПараметры.ПоРаботам); 	
	Запрос.УстановитьПараметр("ГраницаДаты",           Новый Граница(ДокументСсылка,ВидГраницы.Исключая)); 
	Запрос.УстановитьПараметр("ДелатьСторно",          ДокументСсылка.ГрафикДвиженияПоДоговору.Количество()>0);	
	
КонецПроцедуры

Функция ТекстЗапросаВтТаблицаРаботы(Запрос, ТекстыЗапроса, Регистры)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	УСОERP_ДоговорССубподрядчикомРаботы.Работа,
	|	УСОERP_ДоговорССубподрядчикомРаботы.Объем,
	|	УСОERP_ДоговорССубподрядчикомРаботы.ЕдиницаОбъема,
	|	УСОERP_ДоговорССубподрядчикомРаботы.ДатаНачала,
	|	УСОERP_ДоговорССубподрядчикомРаботы.ДатаОкончания,
	|	УСОERP_ДоговорССубподрядчикомРаботы.Длительность,
	|	УСОERP_ДоговорССубподрядчикомРаботы.ЕдиницаДлительности,
	|	УСОERP_ДоговорССубподрядчикомРаботы.СуммаСНДС,
	|	УСОERP_ДоговорССубподрядчикомРаботы.СтавкаНДС,
	|	УСОERP_ДоговорССубподрядчикомРаботы.СуммаНДС,
	|	УСОERP_ДоговорССубподрядчикомРаботы.НомерСтроки
	|ПОМЕСТИТЬ ВтТаблицаРаботы
	|ИЗ
	|	Документ.УСОERP_ДоговорССубподрядчиком.Работы КАК УСОERP_ДоговорССубподрядчикомРаботы
	|ГДЕ
	|	УСОERP_ДоговорССубподрядчикомРаботы.Ссылка = &Ссылка
	|	И НЕ УСОERP_ДоговорССубподрядчикомРаботы.Работа.СуммарнаяРабота";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "");
	
	Возврат ТекстЗапроса;	
	
КонецФункции

Функция ТекстЗапросаТаблицаВыполнениеРаботСубподрядчиком(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "ВыполнениеРаботСубподрядчиком";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Период,
	|	ВложенныйЗапрос.ВидДвижения,
	|	ВложенныйЗапрос.Организация,
	|	ВложенныйЗапрос.ОбъектСтроительства,
	|	ВложенныйЗапрос.Контрагент,
	|	ВложенныйЗапрос.Договор,
	|	ВложенныйЗапрос.Соглашение,
	|	ВложенныйЗапрос.Партнер,
	|	СУММА(ВложенныйЗапрос.НомерСтроки) КАК НомерСтроки,
	|	ВложенныйЗапрос.Работа,
	|	СУММА(ВложенныйЗапрос.Объем) КАК Объем,
	|	СУММА(ВложенныйЗапрос.СуммаСНДС) КАК СуммаСНДС,
	|	СУММА(ВложенныйЗапрос.СуммаНДС) КАК СуммаНДС,
	|	ВложенныйЗапрос.ЕдиницаОбъема,
	|	ВложенныйЗапрос.ДатаНачала,
	|	ВложенныйЗапрос.ДатаОкончания,
	|	ВложенныйЗапрос.Длительность,
	|	ВложенныйЗапрос.ЕдиницаДлительности
	|ИЗ
	|	(ВЫБРАТЬ
	|		&Период КАК Период,
	|		ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|		&Организация КАК Организация,
	|		&ОбъектСтроительства КАК ОбъектСтроительства,
	|		&Контрагент КАК Контрагент,
	|		&Договор КАК Договор,
	|		&Соглашение КАК Соглашение,
	|		&Партнер КАК Партнер,
	|		ТаблицаРаботы.НомерСтроки КАК НомерСтроки,
	|		ВЫБОР
	|			КОГДА ТаблицаРаботы.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|				ТОГДА ТаблицаРаботы.Работа
	|			ИНАЧЕ ТаблицаРаботы.Работа.РаботаИсточник
	|		КОНЕЦ КАК Работа,
	|		ТаблицаРаботы.Объем КАК Объем,
	|		ТаблицаРаботы.СуммаСНДС КАК СуммаСНДС,
	|		ТаблицаРаботы.СуммаНДС КАК СуммаНДС,
	|		ТаблицаРаботы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|		ТаблицаРаботы.ДатаНачала КАК ДатаНачала,
	|		ТаблицаРаботы.ДатаОкончания КАК ДатаОкончания,
	|		ТаблицаРаботы.Длительность КАК Длительность,
	|		ТаблицаРаботы.ЕдиницаДлительности КАК ЕдиницаДлительности
	|	ИЗ
	|		ВтТаблицаРаботы КАК ТаблицаРаботы
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		&Период,
	|		ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|		УСОERP_ВыполнениеРаботСубподрядчиком.Организация,
	|		УСОERP_ВыполнениеРаботСубподрядчиком.ОбъектСтроительства,
	|		УСОERP_ВыполнениеРаботСубподрядчиком.Контрагент,
	|		УСОERP_ВыполнениеРаботСубподрядчиком.Договор,
	|		УСОERP_ВыполнениеРаботСубподрядчиком.Соглашение,
	|		УСОERP_ВыполнениеРаботСубподрядчиком.Партнер,
	|		0,
	|		УСОERP_ВыполнениеРаботСубподрядчиком.Работа,
	|		-УСОERP_ВыполнениеРаботСубподрядчиком.Объем,
	|		-УСОERP_ВыполнениеРаботСубподрядчиком.СуммаСНДС,
	|		-УСОERP_ВыполнениеРаботСубподрядчиком.СуммаНДС,
	|		УСОERP_ВыполнениеРаботСубподрядчиком.ЕдиницаОбъема,
	|		УСОERP_ВыполнениеРаботСубподрядчиком.ДатаНачала,
	|		УСОERP_ВыполнениеРаботСубподрядчиком.ДатаОкончания,
	|		УСОERP_ВыполнениеРаботСубподрядчиком.Длительность,
	|		УСОERP_ВыполнениеРаботСубподрядчиком.ЕдиницаДлительности
	|	ИЗ
	|		РегистрНакопления.УСОERP_ВыполнениеРаботСубподрядчиком КАК УСОERP_ВыполнениеРаботСубподрядчиком
	|	ГДЕ
	|		УСОERP_ВыполнениеРаботСубподрядчиком.Период <= &Период
	|		И УСОERP_ВыполнениеРаботСубподрядчиком.Регистратор <> &Ссылка
	|		И УСОERP_ВыполнениеРаботСубподрядчиком.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		И УСОERP_ВыполнениеРаботСубподрядчиком.Контрагент = &Контрагент
	|		И УСОERP_ВыполнениеРаботСубподрядчиком.Договор = &Договор 
	|		И УСОERP_ВыполнениеРаботСубподрядчиком.ОбъектСтроительства = &ОбъектСтроительства
	|		И УСОERP_ВыполнениеРаботСубподрядчиком.Организация = &Организация) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Период,
	|	ВложенныйЗапрос.ВидДвижения,
	|	ВложенныйЗапрос.Организация,
	|	ВложенныйЗапрос.ОбъектСтроительства,
	|	ВложенныйЗапрос.Контрагент,
	|	ВложенныйЗапрос.Договор,
	|	ВложенныйЗапрос.Соглашение,
	|	ВложенныйЗапрос.Партнер,
	|	ВложенныйЗапрос.Работа,
	|	ВложенныйЗапрос.ЕдиницаОбъема,
	|	ВложенныйЗапрос.ДатаНачала,
	|	ВложенныйЗапрос.ДатаОкончания,
	|	ВложенныйЗапрос.Длительность,
	|	ВложенныйЗапрос.ЕдиницаДлительности
	|
	|ИМЕЮЩИЕ
	|	(СУММА(ВложенныйЗапрос.Объем) <> 0
	|		ИЛИ СУММА(ВложенныйЗапрос.СуммаСНДС) <> 0
	|		ИЛИ СУММА(ВложенныйЗапрос.СуммаНДС) <> 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_ГрафикДвиженийПоДоговору(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "ГрафикДвиженийПоДоговору";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;  	
	
	Если Запрос.Параметры.РасширенныйГрафикДвижений Тогда  		
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ДатаАванс КАК Период,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка КАК Регистратор,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Организация КАК Организация,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Партнер КАК Партнер,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.Контрагент КАК Контрагент,
		|	ДоговорыКонтрагентов.Ссылка КАК Договор,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ДатаАванс КАК ДатаСобытияПоДоговору,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ВидДДС_Аванс КАК ПорядокОплаты,
		|	ЗНАЧЕНИЕ(Перечисление.УСОERP_ПорядокДоходовРасходов.ПустаяСсылка) КАК ПорядокДоходовРасходов,
		|	ВЫБОР
		|		КОГДА &ПоВидамРабот
		|			ТОГДА УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ВидРабот
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УСОERP_ВидыРабот.ПустаяСсылка)
		|	КОНЕЦ КАК ВидРабот,
		|	ВЫБОР
		|		КОГДА &ПоРаботам
		|			ТОГДА ВЫБОР
		|					КОГДА УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
		|						ТОГДА УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Работа
		|					ИНАЧЕ УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Работа.РаботаИсточник
		|				КОНЕЦ
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
		|	КОНЕЦ КАК Работа,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка.ОбъектСтроительства КАК ОбъектСтроительства,
