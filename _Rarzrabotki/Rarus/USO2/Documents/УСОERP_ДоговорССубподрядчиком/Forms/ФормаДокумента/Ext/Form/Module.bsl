&НаСервере
Процедура ПриОткрытииНаСервере()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТабличнаяЧастьРаботы.КодСДР,
	|	ТабличнаяЧастьРаботы.Работа,
	|	ТабличнаяЧастьРаботы.Объем,
	|	ТабличнаяЧастьРаботы.ЕдиницаОбъема,
	|	ТабличнаяЧастьРаботы.ДатаНачала,
	|	ТабличнаяЧастьРаботы.ДатаОкончания,
	|	ТабличнаяЧастьРаботы.Длительность,
	|	ТабличнаяЧастьРаботы.ЕдиницаДлительности,
	|	ТабличнаяЧастьРаботы.СуммаЗаказчика,
	|	ТабличнаяЧастьРаботы.ПонижающийКоэффициент,
	|	ТабличнаяЧастьРаботы.СуммаСНДС,
	|	ТабличнаяЧастьРаботы.СтавкаНДС,
	|	ТабличнаяЧастьРаботы.СуммаНДС
	|ПОМЕСТИТЬ ВременнаяТаблицаРаботы
	|ИЗ
	|	&ТабличнаяЧастьРаботы КАК ТабличнаяЧастьРаботы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВременнаяТаблицаРаботы.КодСДР КАК КодСДР,
	|	УСОERP_СтроительныеРаботы.Ссылка КАК Работа,
	|	ВЫБОР КОГДА УСОERP_СтроительныеРаботы.Ссылка.СуммарнаяРабота ТОГДА 0 ИНАЧЕ 1 КОНЕЦ КАК Уровень,
	|	УСОERP_СтроительныеРаботы.Родитель КАК РаботаРодитель,
	|	ВременнаяТаблицаРаботы.Объем,
	|	ВременнаяТаблицаРаботы.ЕдиницаОбъема,
	|	ВременнаяТаблицаРаботы.ДатаНачала,
	|	ВременнаяТаблицаРаботы.ДатаОкончания,
	|	ВременнаяТаблицаРаботы.Длительность,
	|	ВременнаяТаблицаРаботы.ЕдиницаДлительности,
	|	ВременнаяТаблицаРаботы.СуммаЗаказчика,
	|	ВременнаяТаблицаРаботы.ПонижающийКоэффициент,
	|	ВременнаяТаблицаРаботы.СуммаСНДС,
	|	ВременнаяТаблицаРаботы.СтавкаНДС,
	|	ВременнаяТаблицаРаботы.СуммаНДС
	|ИЗ
	|	ВременнаяТаблицаРаботы КАК ВременнаяТаблицаРаботы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|		ПО ВременнаяТаблицаРаботы.Работа = УСОERP_СтроительныеРаботы.Ссылка
	|ГДЕ
	|	ВременнаяТаблицаРаботы.Работа В(&МассивРабот)
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_СтроительныеРаботы.Ссылка ИЕРАРХИЯ,
	|	КодСДР
	|";
	
	Запрос.УстановитьПараметр("МассивРабот", Объект.Работы.Выгрузить(,"Работа"));
	Запрос.УстановитьПараметр("ТабличнаяЧастьРаботы", Объект.Работы.Выгрузить());
	
	ДанныеДляДерева =  Запрос.Выполнить().Выгрузить();
	Справочник =  Справочники.УСОERP_СтроительныеРаботы;
	ДеревоРабот = УСОERP_ОбработкаТабличныхЧастей.УСОERP_ПодготовитьДанныеИСформироватьДеревоСВосстановлениемСтруктуры(ДанныеДляДерева,"Работа","РаботаРодитель",,Справочники.УСОERP_СтроительныеРаботы);		
	
	ВремРодноеДерево = РеквизитФормыВЗначение("РаботыДеревоЗначений"); // берется родная структура с родной типизацией
	ВремРодноеДерево.Строки.Очистить();
	УСОERP_ОбработкаТабличныхЧастей.УСОERP_ЗаполнитьРоднуюСтруктуруДереваИзВнешнего(ВремРодноеДерево.Строки, ДеревоРабот.Строки); // и рекурсивно заполняется из дерева, где, возможн, типиация создаст проблемы
	ЗначениеВРеквизитФормы( ВремРодноеДерево, "РаботыДеревоЗначений");
	
КонецПроцедуры

