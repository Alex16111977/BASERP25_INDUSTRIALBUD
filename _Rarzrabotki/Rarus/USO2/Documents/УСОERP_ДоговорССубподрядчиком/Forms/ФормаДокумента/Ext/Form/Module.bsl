&НаСервере
Функция ЗаполнитьТабличнуюЧастьРаботыИзДереваЗначений(Дерево, ТабличнаяЧасть, НомерПоПрядку, Отказ)
	
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		
		НомерПоПрядку = НомерПоПрядку + 1;
		
		Если Не ЗначениеЗаполнено(СтрокаДерева.Работа) Тогда
			Сообщить(НСтр("ru='Не заполнено значение Работа в строке '")+ НомерПоПрядку);
			Отказ = Истина;
			Возврат Отказ;
		КонецЕсли;	
		
		Нстр = ТабличнаяЧасть.Добавить();
		
		ЗаполнитьЗначенияСвойств(Нстр, СтрокаДерева);
		
		Если СтрокаДерева.Работа.СуммарнаяРабота Тогда
			Нстр.Объем = 0;
		КонецЕсли;
		
		ЗаполнитьТабличнуюЧастьРаботыИзДереваЗначений(СтрокаДерева, ТабличнаяЧасть, НомерПоПрядку, Отказ);
		
	КонецЦикла;
	
	Возврат ТабличнаяЧасть;
	
КонецФункции

