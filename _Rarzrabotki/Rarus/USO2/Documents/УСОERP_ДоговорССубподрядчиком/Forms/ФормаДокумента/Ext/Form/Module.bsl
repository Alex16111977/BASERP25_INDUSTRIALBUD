&НаКлиенте
Перем КэшированныеЗначения; //используется механизмом обработки изменения реквизитов ТЧ

&НаКлиенте
Перем ТекущиеДанныеИдентификатор; //используется для передачи текущей строки в обработчик ожидания

&НаКлиенте
Перем ПараметрыФормы;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПриЧтенииСозданииНаСервере();
		Если НЕ ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			Объект.ДатаДоговора 			= ТекущаяДата();
			Объект.ПонижающийКоэффициент 	= 1;
		КонецЕсли;
	КонецЕсли;
	
	НовыйВариант = Объект.ДокументУтверждения.СценарийПланирования.НовыйВариант = Истина;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ТекущийДокументУтверждения = Объект.ДокументУтверждения;
	ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;
	ТекущийДоговор             = Объект.Договор;
	ТекущийКонтрагент          = Объект.Контрагент;
	ТекущаяОрганизация         = Объект.Организация;
	ТекущийПартнер             = Объект.Партнер;
	ТекущееСоглашение          = Объект.Соглашение;

	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриЧтенииСозданииНаСервере();
	
	// Обработчик механизма "ДатыЗапретаИзменения"
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	МодификацияКонфигурацииПереопределяемый.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаПодбора" Тогда
		ОбработкаВыбораПодборПоПроектуНаСервере(ВыбранноеЗначение);
		РассчитатьИтоговыеПоказатели();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодборПоПроектуНаСервере(ВыбранноеЗначениеМассив)
	
	РеквизитРаботыДеревоЗначений = РеквизитФормыВЗначение("РаботыДеревоЗначений", Тип("ДеревоЗначений"));
	РаботыТаблицаЗначений = 	Объект.Работы.Выгрузить();
	РаботыТаблицаЗначений.Очистить();
	УСОERP_ОбработкаТабличныхЧастей.ЗаполнитьТаблицуИзДереваЗначений(РеквизитРаботыДеревоЗначений, РаботыТаблицаЗначений); 
	
	Для Каждого ВыбранноеЗначение Из ВыбранноеЗначениеМассив Цикл
		
		Если РаботыТаблицаЗначений.Найти(ВыбранноеЗначение.Ссылка, "Работа") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;	   
		
		НоваяСтрока =  РеквизитРаботыДеревоЗначений.Строки.Добавить();
		ДобавитьСтрокиВДеревоЗначений(ВыбранноеЗначение, НоваяСтрока, РаботыТаблицаЗначений, РеквизитРаботыДеревоЗначений);
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(РеквизитРаботыДеревоЗначений, "РаботыДеревоЗначений");
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокиВДеревоЗначений(ВыбранноеЗначение, СтрокаДерева, РаботыТаблицаЗначений, РеквизитРаботыДеревоЗначений)
	
	СписокПараметровРаботы = ПолучитьПараметрыВыполненияРаботы(ВыбранноеЗначение.Ссылка); 
	
	ЗаполнитьЗначенияСвойств(СтрокаДерева, СписокПараметровРаботы);
	СтрокаДерева.СтавкаНДС = ПолучитьСтавкуНДСПоДоговору(Объект.Договор);
	СтрокаДерева.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СтрокаДерева.СуммаСНДС,СтрокаДерева.СтавкаНДС);
	ВыборкаРабот  = Справочники.УСОERP_СтроительныеРаботы.Выбрать(ВыбранноеЗначение.Ссылка);
	
	Пока ВыборкаРабот.Следующий() Цикл
		
		Если РаботыТаблицаЗначений.Найти(ВыборкаРабот.Ссылка, "Работа") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;	   
		
		НоваяСтрокаДерева = СтрокаДерева.Строки.Добавить();
		ДобавитьСтрокиВДеревоЗначений(ВыборкаРабот.Ссылка, НоваяСтрокаДерева, РаботыТаблицаЗначений, РеквизитРаботыДеревоЗначений);
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыВыполненияРаботы(Работа)
	
	СтруктураДанныхПоРаботе = Новый Структура;
	
	Коэффициент = ?(Объект.ИспользоватьПонижающийКоэффициент, Объект.ПонижающийКоэффициент, 0);
	Если (Объект.ИспользоватьПонижающийКоэффициент) И (Не ЗначениеЗаполнено(Коэффициент)) Тогда
		Сообщить(НСтр("ru='Заполните значение понижающего коэффициента '"));
		Возврат СтруктураДанныхПоРаботе;
	КонецЕсли;
	
	СтавкаНДС = ?(ЗначениеЗаполнено(Объект.Договор.СтавкаНДС),Объект.Договор.СтавкаНДС,Перечисления.СтавкиНДС.НДС18);
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("СтавкаНДС",СтавкаНДС);
	
	КоэффициентНДС = 0;
	
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС10 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
		
		КоэффициентНДС = 10/110;
		
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
		
		КоэффициентНДС = 18/118;
		
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
		
		КоэффициентНДС = 20/120;

	КонецЕсли;
	
	Запрос.УстановитьПараметр("КоэффициентНДС",КоэффициентНДС);
	
	Если НовыйВариант Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	УСОERP_СтроительныеРаботы.Ссылка КАК Работа,
		|	УСОERP_СтроительныеРаботы.КодСДР,
		|	УСОERP_СтроительныеРаботы.ОбъемРаботы КАК Объем,
		|	УСОERP_СтроительныеРаботы.ЕдиницаОбъема,
		|	УСОERP_СтроительныеРаботы.Длительность,
		|	УСОERP_СтроительныеРаботы.ЕдиницаДлительности,
		|	УСОERP_СтроительныеРаботы.ДатаНачала,
		|	УСОERP_СтроительныеРаботы.ДатаОкончания,
		|	УСОERP_ВыполнениеРаботЗаказчикаОстатки.СуммаСНДСОстаток КАК СуммаЗаказчика,
		|	&Коэффициент КАК ПонижающийКоэффициент,
		|	ВЫБОР
		|		КОГДА &ИспользоватьПонижающийКоэффициент
		|			ТОГДА УСОERP_ВыполнениеРаботЗаказчикаОстатки.СуммаСНДСОстаток * &Коэффициент / 100
		|		ИНАЧЕ УСОERP_ВыполнениеРаботЗаказчикаОстатки.СуммаСНДСОстаток
		|	КОНЕЦ КАК СуммаСНДС,
		|	&СтавкаНДС КАК СтавкаНДС,
		|	ВЫБОР
		|		КОГДА &ИспользоватьПонижающийКоэффициент
		|			ТОГДА УСОERP_ВыполнениеРаботЗаказчикаОстатки.СуммаСНДСОстаток * (&Коэффициент / 100) * &КоэффициентНДС
		|		ИНАЧЕ УСОERP_ВыполнениеРаботЗаказчикаОстатки.СуммаСНДСОстаток * &КоэффициентНДС
		|	КОНЕЦ КАК СуммаНДС
		|ИЗ
		|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УСОERP_ВыполнениеРаботЗаказчика.Остатки(&Дата, ) КАК УСОERP_ВыполнениеРаботЗаказчикаОстатки
		|		ПО УСОERP_СтроительныеРаботы.РаботаИсточник = УСОERP_ВыполнениеРаботЗаказчикаОстатки.Работа
		|ГДЕ
		|	УСОERP_СтроительныеРаботы.Ссылка = &Работа";
		
	Иначе
		
		Запрос.Текст = 
		
		"ВЫБРАТЬ
		|	УСОERP_СтроительныеРаботы.Ссылка КАК Работа,
		|	МАКСИМУМ(УСОERP_ПараметрыВыполненияРаботСрезПоследних.Период) КАК Период,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ВидПланирования
		|ПОМЕСТИТЬ ВТ_РаботыПоПериоду
		|ИЗ
		|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(, Работа = &Работа) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
		|		ПО (УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа = УСОERP_СтроительныеРаботы.Ссылка)
		|ГДЕ
		|	УСОERP_СтроительныеРаботы.Ссылка = &Работа
		|
		|СГРУППИРОВАТЬ ПО
		|	УСОERP_СтроительныеРаботы.Ссылка,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ВидПланирования
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_РаботыПоПериоду.Работа,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа.КодСДР КАК КодСДР,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОбъемРаботы КАК Объем,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ЕдиницаОбъема КАК ЕдиницаОбъема,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.НачалоРаботыПлан КАК ДатаНачала,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОкончаниеРаботыПлан КАК ДатаОкончания,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ДлительностьПлан КАК Длительность,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.ЕдиницаДлительности КАК ЕдиницаДлительности,
		|	УСОERP_ВыполнениеРаботЗаказчикаОстатки.СуммаСНДСОстаток КАК СуммаЗаказчика,
		|	&Коэффициент КАК ПонижающийКоэффициент,
		|	ВЫБОР
		|		КОГДА &ИспользоватьПонижающийКоэффициент
		|			ТОГДА УСОERP_ВыполнениеРаботЗаказчикаОстатки.СуммаСНДСОстаток * &Коэффициент / 100
		|		ИНАЧЕ УСОERP_ВыполнениеРаботЗаказчикаОстатки.СуммаСНДСОстаток
		|	КОНЕЦ КАК СуммаСНДС,
		|	&СтавкаНДС КАК СтавкаНДС,
		|	ВЫБОР
		|		КОГДА &ИспользоватьПонижающийКоэффициент
		|			ТОГДА УСОERP_ВыполнениеРаботЗаказчикаОстатки.СуммаСНДСОстаток * (&Коэффициент / 100) * &КоэффициентНДС
		|		ИНАЧЕ УСОERP_ВыполнениеРаботЗаказчикаОстатки.СуммаСНДСОстаток * &КоэффициентНДС
		|	КОНЕЦ КАК СуммаНДС,
		|	ВТ_РаботыПоПериоду.Период
		|ИЗ
		|	ВТ_РаботыПоПериоду КАК ВТ_РаботыПоПериоду
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(, Работа = &Работа) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
		|		ПО (УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа = ВТ_РаботыПоПериоду.Работа)
		|			И (УСОERP_ПараметрыВыполненияРаботСрезПоследних.ВидПланирования = ВТ_РаботыПоПериоду.ВидПланирования)
		|			И (УСОERP_ПараметрыВыполненияРаботСрезПоследних.Период = ВТ_РаботыПоПериоду.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УСОERP_ВыполнениеРаботЗаказчика.Остатки(&Дата, Работа = &Работа) КАК УСОERP_ВыполнениеРаботЗаказчикаОстатки
		|		ПО (УСОERP_ВыполнениеРаботЗаказчикаОстатки.Работа = ВТ_РаботыПоПериоду.Работа)
		|ГДЕ
		|	ВТ_РаботыПоПериоду.Работа = &Работа";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Работа", Работа);
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Коэффициент", Коэффициент);
	Запрос.УстановитьПараметр("ИспользоватьПонижающийКоэффициент", Объект.ИспользоватьПонижающийКоэффициент);
	
	ДанныеПоРаботе = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаДанныеПоРаботе Из ДанныеПоРаботе Цикл
		
		СтруктураДанныхПоРаботе.Вставить("Работа", СтрокаДанныеПоРаботе.Работа);
		СтруктураДанныхПоРаботе.Вставить("КодСДР", СтрокаДанныеПоРаботе.КодСДР);
		СтруктураДанныхПоРаботе.Вставить("Объем", СтрокаДанныеПоРаботе.Объем);
		СтруктураДанныхПоРаботе.Вставить("ЕдиницаОбъема", СтрокаДанныеПоРаботе.ЕдиницаОбъема);
		СтруктураДанныхПоРаботе.Вставить("ДатаНачала", СтрокаДанныеПоРаботе.ДатаНачала);
		СтруктураДанныхПоРаботе.Вставить("ДатаОкончания", СтрокаДанныеПоРаботе.ДатаОкончания);
		СтруктураДанныхПоРаботе.Вставить("Длительность", СтрокаДанныеПоРаботе.Длительность);
		СтруктураДанныхПоРаботе.Вставить("ЕдиницаДлительности", СтрокаДанныеПоРаботе.ЕдиницаДлительности);
		СтруктураДанныхПоРаботе.Вставить("ПонижающийКоэффициент", СтрокаДанныеПоРаботе.ПонижающийКоэффициент);
		СтруктураДанныхПоРаботе.Вставить("СуммаСНДС", СтрокаДанныеПоРаботе.СуммаСНДС);
		СтруктураДанныхПоРаботе.Вставить("СтавкаНДС", СтрокаДанныеПоРаботе.СтавкаНДС);
		СтруктураДанныхПоРаботе.Вставить("СуммаНДС", СтрокаДанныеПоРаботе.СуммаНДС);  
		СтруктураДанныхПоРаботе.Вставить("СуммаЗаказчика", СтрокаДанныеПоРаботе.СуммаЗаказчика);
		СтруктураДанныхПоРаботе.Вставить("Уровень",?(СтрокаДанныеПоРаботе.Работа.СуммарнаяРабота,0,1));
		
		Прервать;
	КонецЦикла;
	
	Возврат СтруктураДанныхПоРаботе;
	
КонецФункции	

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТабличнаяЧастьРаботы = ТекущийОбъект.Работы;
	ТабличнаяЧастьРаботы.Очистить();
	РеквизитРаботыДеревоЗначений = РеквизитФормыВЗначение("РаботыДеревоЗначений", Тип("ДеревоЗначений"));	
	ЗаполнитьТабличнуюЧастьРаботыИзДереваЗначений(РеквизитРаботыДеревоЗначений, ТабличнаяЧастьРаботы, 0, Отказ);	
		
	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	МодификацияКонфигурацииПереопределяемый.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	МодификацияКонфигурацииКлиентПереопределяемый.ПослеЗаписи(ЭтаФорма, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ПонижающийКоэффициент.Видимость = Объект.ИспользоватьПонижающийКоэффициент;
