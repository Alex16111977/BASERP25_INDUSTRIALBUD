&НаКлиенте
Процедура ЗаполнитьРаботамиПоПроекту(Команда)
	
	ОтборПоРазделительнойВедомости = Ложь;
	СтрокиДереваРабот = РаботыДеревоЗначений.ПолучитьЭлементы();
	
	Если СтрокиДереваРабот.Количество()> 0 Тогда
		
		ТекстВопроса = НСтр("ru='Очистить табличную часть «Работы»?'");
		ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗаполнениемОчистить", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	Иначе		
		
		ЗаполнитьРаботамиПоПроектуНаСервере();
		РассчитатьИтоговыеПоказатели();
		РазвернутьНаКлиенте();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаполнениемОчистить(ОтветНаВопрос, Параметры) Экспорт
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
		
		Возврат;
		
	Иначе
		
		ЗаполнитьРаботамиПоПроектуНаСервере();
		РассчитатьИтоговыеПоказатели();
		РазвернутьНаКлиенте();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаботамиПоПроектуНаСервере()
	
	УСОERP_ЗащищенныеФункцииСервер.УСОERP_ДоговорССубподрядчиком_ЗаполнитьРаботамиПоПроектуНаСервере(ЭтотОбъект, ОтборПоРазделительнойВедомости);
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьНДСРекурсивно(СтрокиДереваРабот)
	
	ПустаяСтавкаНДС =  ПолучитьСтавкуНДСПоДоговору(Объект.Договор);
	
	Для Каждого ЭлементДерева Из СтрокиДереваРабот Цикл
		
		Если ЭлементДерева.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.ПустаяСсылка") Тогда
			ЭлементДерева.СтавкаНДС = ПустаяСтавкаНДС;
		КонецЕсли;
		
		ЭлементыСтрокиДереваРабот = ЭлементДерева.ПолучитьЭлементы();
		
		Если ЭлементыСтрокиДереваРабот.Количество() <> 0 Тогда
			
			ПерезаполнитьНДСРекурсивно(ЭлементыСтрокиДереваРабот);
			
		КонецЕсли;
		
		ЭлементДерева.СуммаНДС  = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(ЭлементДерева.СуммаСНДС, ЭлементДерева.СтавкаНДС, Истина);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтавкуНДСПоДоговору(Договор)
	
	Возврат ?(Не ЗначениеЗаполнено(Договор.СтавкаНДС),Перечисления.СтавкиНДС.НДС20,Договор.СтавкаНДС);
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьИтоговыеДанныеПоСуммарнымРаботам(СтрокиРаботДеревоЗначений, СтрокаРодитель = Неопределено)
	
	Если СтрокаРодитель <> Неопределено Тогда
		
		СтрокаРодитель.СуммаЗаказчика 	= 0;
		СтрокаРодитель.СуммаСНДС 		= 0;
		
	КонецЕсли;
	
	Для Каждого ТекСтрока Из СтрокиРаботДеревоЗначений Цикл
		
		ПодчиненныеРаботыПоСтроке = ТекСтрока.ПолучитьЭлементы();
		
		Если ПодчиненныеРаботыПоСтроке.Количество() <> 0 Тогда
			ЗаполнитьИтоговыеДанныеПоСуммарнымРаботам(ПодчиненныеРаботыПоСтроке, ТекСтрока);
		КонецЕсли;
		
		Если СтрокаРодитель <> Неопределено Тогда
			
			СтрокаРодитель.СуммаЗаказчика 	= СтрокаРодитель.СуммаЗаказчика 	+ ТекСтрока.СуммаЗаказчика;
			СтрокаРодитель.СуммаСНДС 		= СтрокаРодитель.СуммаСНДС 			+ ТекСтрока.СуммаСНДС;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Подбор(Команда)
	
	СтруктураОтбора = Новый Структура;
	
	ЗаполнитьСтруктуруОтбораНаСервере(СтруктураОтбора);
	
	ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаПодбора",СтруктураОтбора,ЭтотОбъект); 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтруктуруОтбораНаСервере(СтруктураОтбора)
	
	Если НовыйВариант Тогда
		СтруктураОтбора.Вставить("ДокументУтверждения",Объект.ДокументУтверждения);
		Возврат;
	КонецЕсли;
		
	СтруктураОтбора.Вставить("Организация",Объект.Организация);
	СтруктураОтбора.Вставить("ОбъектСтроительства",Объект.ОбъектСтроительства);
	СтруктураОтбора.Вставить("ПометкаУдаления",Ложь);
	СтруктураОтбора.Вставить("Утверждена",Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсе(Команда)
	
	СвернутьНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсе(Команда)
	
	РазвернутьНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСОтбором(Команда)
	
	ОтборПоРазделительнойВедомости = Истина;
	СтрокиДереваРабот = РаботыДеревоЗначений.ПолучитьЭлементы();
	
	Если СтрокиДереваРабот.Количество()> 0 Тогда
		
		ТекстВопроса = НСтр("ru='Очистить табличную часть «Работы»?'");
		ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗаполнениемОчистить", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе		
		
		ЗаполнитьРаботамиПоПроектуНаСервере();
		РассчитатьИтоговыеПоказатели();
		РазвернутьНаКлиенте();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммаСНДС(ТекущаяСтрока)
	
	Если Объект.ИспользоватьПонижающийКоэффициент Тогда
		СуммаСНДСДоИзменения = ?(ЗначениеЗаполнено(ТекущаяСтрока.СуммаСНДС), ТекущаяСтрока.СуммаСНДС, 0);
	Иначе
		СуммаСНДСДоИзменения = 0;
	КонецЕсли;
	
	СуммаСНДСПослеИзменения = Окр(ТекущаяСтрока.СуммаЗаказчика - ТекущаяСтрока.СуммаЗаказчика * ТекущаяСтрока.ПонижающийКоэффициент / 100, 2); 
	
	ТекущаяСтрока.СуммаНДС  = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СуммаСНДСПослеИзменения, ТекущаяСтрока.СтавкаНДС, Истина);
	ТекущаяСтрока.СуммаСНДС = СуммаСНДСПослеИзменения;
	
	РассчитатьИтоговыеПоказателиРодителей(ТекущаяСтрока, СуммаСНДСПослеИзменения - СуммаСНДСДоИзменения);
	РассчитатьИтоговыеПоказатели();
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммаСНДСНаСервере(ТекущаяСтрока)
	
	Коэффициент = ?(Объект.ИспользоватьПонижающийКоэффициент, ТекущаяСтрока.ПонижающийКоэффициент, 100);
	
	ТекущаяСтрока.СуммаСНДС = Окр(ТекущаяСтрока.СуммаЗаказчика * Коэффициент / 100, 2);	
	
	СтруктураДействий = Новый Структура;	
	СтруктураДействий.Вставить("СтроительствоПересчитатьСуммуНДС");
	ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.РаботыДеревоЗначений.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("РаботыДеревоЗначений.Уровень");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 0;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(WindowsШрифты.ШрифтДиалоговИМеню,,,Истина));
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаГруппировкиОтчета2);  
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьСтоимостьЗаказчикаПоРаботе(ИдентификаторСтроки)
	
	ТекущаяСтрока = Объект.Работы.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	РаботыСуммаЗаказчик  = ПолучитьСтоимостьЗаказчика(ТекущаяСтрока.Работа);
	СуммаЗаказчикаРабота = РаботыСуммаЗаказчик.Получить(ТекущаяСтрока.Работа);
	
	Если НЕ СуммаЗаказчикаРабота = Неопределено Тогда 
		ТекущаяСтрока.СуммаЗаказчика = СуммаЗаказчикаРабота;
		РассчитатьСуммаСНДСНаСервере(ТекущаяСтрока);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтоимостьЗаказчика(Работы)
	
	Если ТипЗнч(Работы) = Тип("СписокЗначений") Тогда 
		РаботыСписок = Новый СписокЗначений;
		РаботыСписок.Добавить(Работы);
	Иначе 
		РаботыСписок = Работы;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ВыполнениеРаботЗаказчикаОстатки.Работа,
	|	СУММА(УСОERP_ВыполнениеРаботЗаказчикаОстатки.СуммаСНДСОстаток) КАК СуммаЗаказчика
	|ИЗ
	|	РегистрНакопления.УСОERP_ВыполнениеРаботЗаказчика.Остатки(
	|			&Период,
	|			Проект = &Проект
	|				И Работа В (&Работы)
	|				И Организация = &Организация) КАК УСОERP_ВыполнениеРаботЗаказчикаОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ВыполнениеРаботЗаказчикаОстатки.Работа";
	
	Запрос.УстановитьПараметр("Организация", 	Объект.Организация);
	Запрос.УстановитьПараметр("Период", 		Новый Граница(Объект.Дата, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Проект", 		Объект.Проект);
	Запрос.УстановитьПараметр("Работы", 		РаботыСписок);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	РаботыСуммаЗаказчик = Новый Соответствие();
	Пока Выборка.Следующий() Цикл
		РаботыСуммаЗаказчик.Вставить(Выборка.Работа, Выборка.СуммаЗаказчика);
	КонецЦикла;
	
	Возврат РаботыСуммаЗаказчик;
	
КонецФункции

#КонецОбласти   

#Область ПриИзмененииРеквизитов

&НаКлиенте
Процедура РаботыДеревоЗначенийПередУдалением(Элемент, Отказ)
	
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	УдаляемаяСтрока = Элемент.ТекущиеДанные;
	
	Пока ТекущаяСтрока.ПолучитьРодителя() <> Неопределено Цикл
		
		Родитель =  ТекущаяСтрока.ПолучитьРодителя();
		Родитель.СуммаСНДС = Родитель.СуммаСНДС - УдаляемаяСтрока.СуммаСНДС;
		Родитель.СуммаЗаказчика = Родитель.СуммаЗаказчика - УдаляемаяСтрока.СуммаЗаказчика;
		
		Если Не ЗначениеЗаполнено(Родитель.СтавкаНДС) Тогда
			Родитель.СтавкаНДС = УдаляемаяСтрока.СтавкаНДС;
		КонецЕсли;  		
	
		Родитель.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(Родитель.СуммаСНДС,Родитель.СтавкаНДС, Истина);
		
		ТекущаяСтрока = Родитель;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииСервер()
	
	ОтветственныеЛицаСервер.ПриИзмененииСвязанныхРеквизитовДокумента(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	
	ТекущиеДанные       = Элементы.РаботыДеревоЗначений.ТекущиеДанные;
	ГрафикРаботыПроекта = ПолучитьЗначениеГрафикаПроекта(Объект.ОбъектСтроительства, "ГрафикРаботы");
	ГрафикРаботыОбъекта	= ПолучитьЗничениеГрафикаСтроительнойРаботы(ТекущиеДанные.Работа);
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДатаНачала) И ТекущиеДанные.ДатаНачала = НачалоДня(ТекущиеДанные.ДатаНачала) Тогда
		
		ГрафикРаботы		= ?(ЗначениеЗаполнено(ГрафикРаботыОбъекта), ГрафикРаботыОбъекта, ГрафикРаботыПроекта);
		
		ТекущиеДанные.ДатаНачала	= УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПервоеРабочееВремяДня(ГрафикРаботы, ТекущиеДанные.ДатаНачала);
		
	КонецЕсли;  	
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ДатаНачала) Тогда 	
		
		ТекущиеДанные.Длительность	= 0;
		
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ДатаОкончания) Тогда 
		
		ТекущиеДанные.Длительность	= УСОERP_УправлениеСтроительнымПроизводством.РассчитатьДлительностьПериода(ТекущиеДанные.Работа, 
		ТекущиеДанные.ДатаНачала, 
		ТекущиеДанные.ДатаОкончания, 
		ТекущиеДанные.ЕдиницаДлительности);
		
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Длительность) Тогда 	
		
		ТекущиеДанные.ДатаОкончания	= УСОERP_УправлениеСтроительнымПроизводством.РассчитатьОкончаниеПериода(ТекущиеДанные.Работа, 
		ТекущиеДанные.ДатаНачала, 
		ТекущиеДанные.Длительность, 
		ТекущиеДанные.ЕдиницаДлительности);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.РаботыДеревоЗначений.ТекущиеДанные;
	ГрафикРаботыПроекта = ПолучитьЗначениеГрафикаПроекта(Объект.ОбъектСтроительства, "ГрафикРаботы");
	ГрафикРаботыОбъекта	= ПолучитьЗничениеГрафикаСтроительнойРаботы(ТекущиеДанные.Работа);
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДатаОкончания) И ТекущиеДанные.ДатаОкончания = НачалоДня(ТекущиеДанные.ДатаОкончания) Тогда
		
		ГрафикРАботы = ?(ЗначениеЗаполнено(ГрафикРаботыОбъекта), ГрафикРаботыОбъекта, ГрафикРаботыПроекта);
		
		ТекущиеДанные.ДатаОкончания = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПоследнееРабочееВремяДня(ГрафикРаботы, ТекущиеДанные.ДатаОкончания);
		
	КонецЕсли;  	
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ДатаОкончания) Тогда 
		
		ТекущиеДанные.Длительность = 0;	
		
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ДатаНачала) Тогда 	
		
		ТекущиеДанные.Длительность = УСОERP_УправлениеСтроительнымПроизводством.РассчитатьДлительностьПериода(ТекущиеДанные.Работа, 
		ТекущиеДанные.ДатаНачала, 
		ТекущиеДанные.ДатаОкончания, 
		ТекущиеДанные.ЕдиницаДлительности);
		
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Длительность) Тогда 
		
		ТекущиеДанные.ДатаНачала = УСОERP_УправлениеСтроительнымПроизводством.РассчитатьНачалоПериода(ТекущиеДанные.Работа, 
		ТекущиеДанные.ДатаОкончания, 
		ТекущиеДанные.Длительность, 
		ТекущиеДанные.ЕдиницаДлительности);	
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДлительностьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.РаботыДеревоЗначений.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДатаНачала) Тогда 
		
		ТекущиеДанные.ДатаОкончания	= УСОERP_УправлениеСтроительнымПроизводством.РассчитатьОкончаниеПериода(
		ТекущиеДанные.Работа, 
		ТекущиеДанные.ДатаНачала, 
		ТекущиеДанные.Длительность, 
		ТекущиеДанные.ЕдиницаДлительности);	
		
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ДатаОкончания) Тогда 		
		
		ТекущиеДанные.ДатаНачала    = УСОERP_УправлениеСтроительнымПроизводством.РассчитатьНачалоПериода(ТекущиеДанные.Работа,
		ТекущиеДанные.ДатаОкончания,
		ТекущиеДанные.Длительность, 
		ТекущиеДанные.ЕдиницаДлительности);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЕдиницаДлительностиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.РаботыДеревоЗначений.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДатаНачала) Тогда 
		
		ТекущиеДанные.ДатаОкончания	= УСОERP_УправлениеСтроительнымПроизводством.РассчитатьОкончаниеПериода(ТекущиеДанные.Работа, 
		ТекущиеДанные.ДатаНачала, 
		ТекущиеДанные.Длительность, 
		ТекущиеДанные.ЕдиницаДлительности);	
		
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ДатаОкончания) Тогда 		
		
		ТекущиеДанные.ДатаНачала    = УСОERP_УправлениеСтроительнымПроизводством.РассчитатьНачалоПериода(
		ТекущиеДанные.Работа,
		ТекущиеДанные.ДатаОкончания,
		ТекущиеДанные.Длительность, 
		ТекущиеДанные.ЕдиницаДлительности);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаСНДСПриИзменении(Элемент)
	РассчитатьИтоговыеПоказатели();
КонецПроцедуры

&НаКлиенте
Процедура РаботыДеревоЗначенийСуммаСНДСОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.РаботыДеревоЗначений.ТекущиеДанные;	
	
	СуммаСНДСДоИзменения = ?(ЗначениеЗаполнено(ТекущаяСтрока.СуммаСНДС), ТекущаяСтрока.СуммаСНДС, 0);
	СуммаСНДСПослеИзменения = ?(ЗначениеЗаполнено(ВыбранноеЗначение), ВыбранноеЗначение, 0); 
	
	ТекущаяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СуммаСНДСПослеИзменения, ТекущаяСтрока.СтавкаНДС, Истина);
	
	РассчитатьИтоговыеПоказателиРодителей(ТекущаяСтрока, СуммаСНДСПослеИзменения - СуммаСНДСДоИзменения);
	
КонецПроцедуры

&НаКлиенте
Процедура РаботыДеревоЗначенийСуммаСНДСОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.РаботыДеревоЗначений.ТекущиеДанные;	
	
	СуммаСНДСДоИзменения = ?(ЗначениеЗаполнено(ТекущаяСтрока.СуммаСНДС), ТекущаяСтрока.СуммаСНДС, 0);
	СуммаСНДСПослеИзменения = ?(ЗначениеЗаполнено(Текст), Число(Текст), 0); 
	
	ТекущаяСтрока.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СуммаСНДСПослеИзменения, ТекущаяСтрока.СтавкаНДС, Истина);
	
	РассчитатьИтоговыеПоказателиРодителей(ТекущаяСтрока, СуммаСНДСПослеИзменения - СуммаСНДСДоИзменения);
	
КонецПроцедуры

