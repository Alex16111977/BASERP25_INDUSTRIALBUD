&НаКлиенте
Функция РассчитатьИтоговыеПоказатели()
	
	РаботыДеревоЗначенийЭлементы = РаботыДеревоЗначений.ПолучитьЭлементы();
	ЗаполнитьИтоговыеДанныеПоСуммарнымРаботам(РаботыДеревоЗначенийЭлементы);
	ПерезаполнитьНДСРекурсивно(РаботыДеревоЗначенийЭлементы);
	
	СуммаВсего = 0;
	СуммаНДС   = 0;
	СуммаЗаказчика = 0;
	Для Каждого СтрокаСтрокиДеревоЗначений Из РаботыДеревоЗначенийЭлементы Цикл
		СуммаВсего = СуммаВсего + СтрокаСтрокиДеревоЗначений.СуммаСНДС;
		СуммаНДС   = СуммаНДС + СтрокаСтрокиДеревоЗначений.СуммаНДС;
		СуммаЗаказчика = СуммаЗаказчика + СтрокаСтрокиДеревоЗначений.СуммаЗаказчика;
	КонецЦикла;	
	Объект.СуммаДокумента = СуммаВсего;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьИтоговыеПоказателиРодителей(ТекущаяСтрока, СуммаСНДСДОбавить)
	
	ТекущаяСтрока = Элементы.РаботыДеревоЗначений.ТекущиеДанные;
	
	Пока ТекущаяСтрока <> Неопределено И ТекущаяСтрока.ПолучитьРодителя() <> Неопределено Цикл
		
		Родитель =  ТекущаяСтрока.ПолучитьРодителя();
		
		ПодЭлементы = Родитель.ПолучитьЭлементы(); 
		
		МассивСтавокНДС = Новый Массив;
		Родитель.СуммаСНДС = 0;
		Родитель.СуммаНДС = 0; 
		
		Для Каждого ПодЭлемент ИЗ ПодЭлементы Цикл
			
			Родитель.СуммаСНДС = Родитель.СуммаСНДС +ПодЭлемент.СуммаСНДС;
			Родитель.СуммаНДС = Родитель.СуммаНДС+ПодЭлемент.СуммаНДС;
			
			Если МассивСтавокНДС.Найти(ПодЭлемент.СтавкаНДС) = Неопределено Тогда
				МассивСтавокНДС.Добавить(ПодЭлемент.СтавкаНДС);
			КонецЕсли; 			
			
		КонецЦикла;
		
		Родитель.СтавкаНДС = ?(МассивСтавокНДС.Количество() = 1,МассивСтавокНДС.Получить(0),ПредопределенноеЗначение("Перечисление.СтавкиНДС.ПустаяСсылка"));
		
		ТекущаяСтрока = Родитель;
		
	КонецЦикла	
	
КонецПроцедуры

&НаСервере
Функция СоздатьДоговорКонтрагента(СтруктураРеквизитовДоговора, Отказ)
	
	НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	СоглашениеСПоставщиком = СтруктураРеквизитовДоговора.Соглашение;
	
	НовыйДоговор.ТипДоговора            = Перечисления.ТипыДоговоров.СПоставщиком;
	НовыйДоговор.Номер                  = СтруктураРеквизитовДоговора.НомерДоговора;
	НовыйДоговор.Дата                   = СтруктураРеквизитовДоговора.ДатаДоговора;
	НовыйДоговор.ВалютаВзаиморасчетов   = ?(ЗначениеЗаполнено(Объект.Валюта), Объект.Валюта, ДоходыИРасходыСервер.ПолучитьВалютуУправленческогоУчета());
	НовыйДоговор.Контрагент             = СтруктураРеквизитовДоговора.Контрагент;
	НовыйДоговор.Организация            = СтруктураРеквизитовДоговора.Организация;
	НовыйДоговор.Партнер                = СтруктураРеквизитовДоговора.Партнер;
	НовыйДоговор.Наименование           = СтруктураРеквизитовДоговора.НомерДоговора + " от " + СтруктураРеквизитовДоговора.ДатаДоговора;
	НовыйДоговор.ПорядокОплаты          = СоглашениеСПоставщиком.ПорядокОплаты;
	НовыйДоговор.ПорядокРасчетов        = СоглашениеСПоставщиком.ПорядокРасчетов;
	НовыйДоговор.УСОERP_ОсновнойПроект     = СтруктураРеквизитовДоговора.Проект;
	
	Если Не ЗначениеЗаполнено(НовыйДоговор.ПорядокРасчетов) Тогда 
		НовыйДоговор.ПорядокРасчетов        = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
	КонецЕсли;
	
	ЗаполнитьБанковскийСчетКонтрагентаПоУмолчанию(НовыйДоговор.Контрагент, СоглашениеСПоставщиком.ПорядокОплаты, НовыйДоговор.БанковскийСчетКонтрагента);
	ЗаполнитьБанковскийСчетОрганизацииПоУмолчанию(НовыйДоговор.Организация, СоглашениеСПоставщиком.ПорядокОплаты, НовыйДоговор.БанковскийСчет);
	НовыйДоговор.Статус = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
	
	Попытка
		НовыйДоговор.Записать();
		Объект.Договор = НовыйДоговор.Ссылка;
		Возврат НовыйДоговор.Ссылка;
	Исключение
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьБанковскийСчетОрганизацииПоУмолчанию(Организация, ПорядокОплаты, БанковскийСчет)
	
	Если ЗначениеЗаполнено(БанковскийСчет)
		ИЛИ НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	ОплатаВВалюте = ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВВалютеОплатаВВалюте;
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ ПЕРВЫЕ 2
	|	БанковскиеСчетаОрганизаций.Ссылка КАК БанковскийСчет
	|ИЗ
	|	Справочник.БанковскиеСчетаОрганизаций КАК БанковскиеСчетаОрганизаций
	|ГДЕ
	|	БанковскиеСчетаОрганизаций.Владелец = &Организация
	|	И ((БанковскиеСчетаОрганизаций.ВалютаДенежныхСредств = &ВалютаРегл И НЕ &ОплатаВВалюте)
	|	ИЛИ (БанковскиеСчетаОрганизаций.ВалютаДенежныхСредств <> &ВалютаРегл И &ОплатаВВалюте))
	|	И Не БанковскиеСчетаОрганизаций.ПометкаУдаления
	|");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОплатаВВалюте", ОплатаВВалюте);
	Запрос.УстановитьПараметр("ВалютаРегл", Константы.ВалютаРегламентированногоУчета.Получить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 И Выборка.Следующий() Тогда
		БанковскийСчет = Выборка.БанковскийСчет;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
