	СуммаЗаказчикаПослеИзменения = ?(ЗначениеЗаполнено(ВыбранноеЗначение), ВыбранноеЗначение, 0); 
	
	СуммаДобавить = СуммаЗаказчикаПослеИзменения - СуммаЗаказчикаДоИзменения;
	Пока ТекущаяСтрока.ПолучитьРодителя() <> Неопределено Цикл
		Родитель =  ТекущаяСтрока.ПолучитьРодителя();
		Родитель.СуммаЗаказчика = Родитель.СуммаЗаказчика + СуммаДОбавить;
		ТекущаяСтрока = Родитель;
	КонецЦикла;	
	
