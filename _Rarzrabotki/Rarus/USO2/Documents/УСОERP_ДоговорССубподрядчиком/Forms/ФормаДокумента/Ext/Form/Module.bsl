&НаКлиенте
Процедура 	ОбработатьГрафикиОснованияВопросПользователю(РезультатВопроса, ДополнительныеПараметры) Экспорт				
	
	Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОбработатьГрафики(ПараметрыФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура 	ОбработатьГрафики(ПараметрыФормы)									
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ДатаСобытия,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ВидДвиженияДенежныхСредств,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ВидДвиженияДоходРасход,
		|	-УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ОбщаяСумма КАК ОбщаяСумма,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.СтатьяБюджета,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Комментарий,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ВидРабот,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Работа,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ДатаАванс,
		|	-УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.СуммаАванс КАК СуммаАванс,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ДатаПриемРабот,
		|	-УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.СуммаПриемРабот КАК СуммаПриемРабот,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ДатаОстатокПлатежа,
		|	-УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.СуммаОстатокПлатежа КАК СуммаОстатокПлатежа,
		|	-УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.СуммаУдержаниеОстатокПлатежа КАК СуммаУдержаниеОстатокПлатежа,
		|	-УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.СуммаИтогоОстатокПлатежа КАК СуммаИтогоОстатокПлатежа,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ДатаВозвратГарантийногоУдержания,
		|	-УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.СуммаВозвратГарантийногоУдержания КАК СуммаВозвратГарантийногоУдержания,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ВидДДС_Аванс,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ВидДДС_ПризнаниеДоходаРасхода,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ВидДДС_ОстатокПлатежа,
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.ВидДДС_ВозвратГарантийногоУдержания,
		|	ИСТИНА КАК Сторно
		|ИЗ
		|	Документ.УСОERP_ГрафикДвиженийПоДоговору.ГрафикДвиженияПоДоговору КАК УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору
		|ГДЕ
		|	УСОERP_ГрафикДвиженийПоДоговоруГрафикДвиженияПоДоговору.Ссылка = &ГрафикДвиженийПоДоговору";
	
	Запрос.УстановитьПараметр("ГрафикДвиженийПоДоговору", ПараметрыФормы.ГрафикДвиженийПоДоговору);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТЗ_ТаблицаГрафикаОснования 	= РезультатЗапроса.Выгрузить();
	
	Объект.ГрафикДвиженияПоДоговору.Очистить();
	Объект.ГрафикДвиженияПоДоговору.Загрузить(ТЗ_ТаблицаГрафикаОснования);
	Элементы.УСОERP_РасширенныйГрафикДвижений.ТолькоПросмотр = Истина;
	ЭтаФорма.Модифицированность = Истина;
	ОбновитьФормуНаСервере(ПараметрыФормы);
			
КонецПроцедуры

&НаКлиенте
Процедура РаботыДеревоЗначенийПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если Объект.Организация <> ТекущаяОрганизация И ЗначениеЗаполнено(ТекущаяОрганизация) Тогда
		
		Если Объект.Работы.Количество()+Объект.ГрафикДвиженияПоДоговору.Количество() Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ОрганизацияПриИзмененииПродолжение",ЭтотОбъект);
			
			ПоказатьВопрос(ОписаниеОповещения,"Табличные части будут очищены,продолжить?",РежимДиалогаВопрос.ДаНет);
			
		Иначе
			
			ОрганизацияПриИзмененииНаСервере();
			ПараметрыФормы = СтруктураПараметрыФормы();		
	        ОбновитьФормуНаКлиенте(); 
			
		КонецЕсли;  		
		
	КонецЕсли;   	

КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзмененииПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Объект.Организация = ТекущаяОрганизация;
		Объект.Договор = ТекущийДоговор;
		Объект.ДокументУтверждения = ТекущийДокументУтверждения;
		Возврат;
		
	КонецЕсли;
	
	ОрганизацияПриИзмененииНаСервере();
	ПараметрыФормы = СтруктураПараметрыФормы();		
	ОбновитьФормуНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	Объект.Работы.Очистить();
	Объект.ГрафикДвиженияПоДоговору.Очистить();
	РаботыДеревоЗначений.ПолучитьЭлементы().Очистить();
	Объект.ДокументУтверждения = УСОERP_ЗащищенныеФункцииСервер.ПолучитьПоследнийДокументУтверждения(Объект.ОбъектСтроительства,Объект.Организация,,Объект.Дата);
	
	ТекущаяОрганизация         = Объект.Организация;
	ТекущийДоговор             = Объект.Договор;
	ТекущийДокументУтверждения = Объект.ДокументУтверждения; 
		
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	Если Объект.Договор <> ТекущийДоговор И ЗначениеЗаполнено(ТекущийДоговор) И Объект.ГрафикДвиженияПоДоговору.Количество() Тогда 		
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ДоговорПриИзмененииПродолжение",ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения,"Таб.часть ""График движения по договору"" будет очищена, продолжить?",РежимДиалогаВопрос.ДаНет);
		
	Иначе 		
		
		ДоговорПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзмененииПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Объект.Контрагент = ТекущийКонтрагент;
		Объект.Договор = ТекущийДоговор;
		Объект.Партнер = ТекущийПартнер;
		Объект.Соглашение = ТекущееСоглашение;
		Возврат;
		
	КонецЕсли;
	
	ДоговорПриИзмененииНаСервере();
	
	ПараметрыФормы = СтруктураПараметрыФормы();	
	ОбновитьФормуНаКлиенте(); 	
	
КонецПроцедуры

&НаСервере
Процедура ДоговорПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Договор.ВалютаВзаиморасчетов) И НЕ Объект.Валюта = Объект.Договор.ВалютаВзаиморасчетов Тогда 
		
		Объект.Валюта   = Объект.Договор.ВалютаВзаиморасчетов;
		ВалютаДокумента = Объект.Валюта;
		
	КонецЕсли;	
	          	
	Объект.ДатаДоговора = Объект.Договор.Дата;
	Объект.НомерДоговора = Объект.Договор.Номер;
	Объект.НаправлениеДеятельности = Объект.Договор.НаправлениеДеятельности;
	
	Объект.ГрафикДвиженияПоДоговору.Очистить(); 
	ТекущийКонтрагент = Объект.Контрагент;
	ТекущийДоговор = Объект.Договор;
	ТекущийПартнер = Объект.Партнер;
	ТекущееСоглашение = Объект.Соглашение;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектСтроительстваПриИзменении(Элемент)
	
	Если (Объект.ГрафикДвиженияПоДоговору.Количество()+Объект.Работы.Количество()) И (Объект.ОбъектСтроительства <> ТекущийОбъектСтроительства ИЛИ Объект.ДокументУтверждения <> ТекущийДокументУтверждения) Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбъектСтроительстваПриИзмененииПродолжение",ЭтотОбъект);
		
		ПоказатьВопрос(ОписаниеОповещения,"Табличные части будут очищены, продолжить?",РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ОбъектСтроительстваПриИзмененииПродолжение(КодВозвратаДиалога.Да,Новый Структура); 		
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектСтроительстваПриИзмененииПродолжение (Ответ,ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Объект.ОбъектСтроительства = ТекущийОбъектСтроительства;
		Объект.ДокументУтверждения = ТекущийДокументУтверждения;
		Возврат;
		
	КонецЕсли;
	
	ОбъектСтроительстваПриИзмененииНаСервере(); 
	
	ПараметрыФормы = СтруктураПараметрыФормы();		
	ОбновитьФормуНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура ОбъектСтроительстваПриИзмененииНаСервере(ПодбиратьДокументУтверждения = Истина)
	
	Объект.ГрафикДвиженияПоДоговору.Очистить();
	Объект.Работы.Очистить();
	РаботыДеревоЗначений.ПолучитьЭлементы().Очистить();
	
	Если ПодбиратьДокументУтверждения Тогда
		
		Объект.ДокументУтверждения = УСОERP_ЗащищенныеФункцииСервер.ПолучитьПоследнийДокументУтверждения(Объект.ОбъектСтроительства,Объект.Организация);
		
	КонецЕсли;

	ТекущийОбъектСтроительства = Объект.ОбъектСтроительства;
	ТекущийДокументУтверждения = Объект.ДокументУтверждения;
	НовыйВариант = ЭтоНовыйВариант(Объект.ДокументУтверждения);
	Объект.НаправлениеДеятельности = Объект.ДокументУтверждения.НаправлениеДеятельности;
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ЭтоСуммарнаяРабота(Работа) 
	
	Если ТипЗнч(Работа) = Тип("Массив") Тогда
		
		Если НЕ Работа.Количество() Тогда
			Возврат Истина;
			
		КонецЕсли;
		
		Возврат Работа.Получить(0).СуммарнаяРабота;
		
	Иначе
		
		Возврат Работа.СуммарнаяРабота;
		
	КонецЕсли;	
	
КонецФункции 

&НаСервереБезКонтекста
Функция ЭтоНовыйВариант(Документ) 
	
	Возврат Документ.СценарийПланирования.НовыйВариант;
	
КонецФункции 

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	Если Объект.Контрагент <> ТекущийКонтрагент И ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		
		ДоговорПриИзменении(Элемент);

	КонецЕсли;
	
	КонтрагентПриИзмененииСервер();
		
КонецПроцедуры 

&НаСервере
Процедура  КонтрагентПриИзмененииСервер()
	
	ДопПараметры = ЗакупкиСервер.ДополнительныеПараметрыОтбораДоговоров();
	ДопПараметры.ВалютаВзаиморасчетов = Объект.Валюта;
	ДопПараметры.НаправлениеДеятельности = Объект.НаправлениеДеятельности;
	Объект.Договор = ЗакупкиСервер.ПолучитьДоговорПоУмолчанию(Объект,Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика,ДопПараметры);
	ТекущийДоговор = Объект.Договор;
		
КонецПроцедуры 						

&НаКлиенте
Процедура ПартнерПриИзменении(Элемент)
	
	ПартнерПриИзмененииНаСервере();
	КонтрагентПриИзменении(Элемент);
	
КонецПроцедуры

&НаСервере
Процедура   ПартнерПриИзмененииНаСервере()
ПартнерыИКонтрагенты.ЗаполнитьКонтрагентаПартнераПоУмолчанию(Объект.Партнер,Объект.Контрагент,Истина);	
КонецПроцедуры  

&НаКлиенте
Процедура ЗаполнитьПоДокументу(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПоДокументуПродолжение",ЭтотОбъект);
	ОтборФормы = Новый Структура("ОбъектСтроительства,Проведен,Контрагент,Договор",Объект.ОбъектСтроительства,Истина,Объект.Контрагент,Объект.Договор);
	ДопПараметры = Новый Структура("Отбор",ОтборФормы);
	ОткрытьФорму("Документ.УСОERP_ДоговорССубподрядчиком.Форма.ФормаВыбора",ДопПараметры,ЭтотОбъект,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДокументуПродолжение(ВыбранноеЗначение,ДопПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоДокументуНаСервере(ВыбранноеЗначение);
	РассчитатьИтоговыеПоказатели();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументуНаСервере(ДокументЗаполнения)
	
	Если Модифицированность Тогда   
		
		ТабличнаяЧастьРаботы = Объект.Работы;
		ТабличнаяЧастьРаботы.Очистить();
		РеквизитРаботыДеревоЗначений = РеквизитФормыВЗначение("РаботыДеревоЗначений", Тип("ДеревоЗначений"));	
		ЗаполнитьТабличнуюЧастьРаботыИзДереваЗначений(РеквизитРаботыДеревоЗначений, ТабличнаяЧастьРаботы, 0, Ложь);
		
	КонецЕсли;
	
	ТЗ = Объект.Работы.Выгрузить();
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДокументЗаполнения",ДокументЗаполнения);
	Запрос.УстановитьПараметр("ТЗ",ТЗ);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ДоговорССубподрядчикомРаботы.Работа КАК Работа,
	|	УСОERP_ДоговорССубподрядчикомРаботы.СуммаСНДС КАК СуммаСНДС,
	|	УСОERP_ДоговорССубподрядчикомРаботы.СтавкаНДС КАК СтавкаНДС,
	|	УСОERP_ДоговорССубподрядчикомРаботы.СуммаНДС КАК СуммаНДС
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	Документ.УСОERP_ДоговорССубподрядчиком.Работы КАК УСОERP_ДоговорССубподрядчикомРаботы
	|ГДЕ
	|	УСОERP_ДоговорССубподрядчикомРаботы.Ссылка = &ДокументЗаполнения
	|	И НЕ УСОERP_ДоговорССубподрядчикомРаботы.Работа.СуммарнаяРабота
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаРабот.КодСДР КАК КодСДР,
	|	ВЫРАЗИТЬ(ТаблицаРабот.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	ТаблицаРабот.Объем КАК Объем,
	|	ТаблицаРабот.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТаблицаРабот.ДатаНачала КАК ДатаНачала,
	|	ТаблицаРабот.ДатаОкончания КАК ДатаОкончания,
	|	ТаблицаРабот.Длительность КАК Длительность,
	|	ТаблицаРабот.ЕдиницаДлительности КАК ЕдиницаДлительности,
	|	ТаблицаРабот.СуммаЗаказчика КАК СуммаЗаказчика,
	|	ТаблицаРабот.ПонижающийКоэффициент КАК ПонижающийКоэффициент,
	|	ТаблицаРабот.СуммаСНДС КАК СуммаСНДС,
	|	ТаблицаРабот.СтавкаНДС КАК СтавкаНДС,
	|	ТаблицаРабот.СуммаНДС КАК СуммаНДС
	|ПОМЕСТИТЬ ТаблицаРабот
	|ИЗ
	|	&ТЗ КАК ТаблицаРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаРабот.КодСДР КАК КодСДР,
	|	ТаблицаРабот.Работа КАК Работа,
	|	ТаблицаРабот.Объем КАК Объем,
	|	ТаблицаРабот.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ТаблицаРабот.ДатаНачала КАК ДатаНачала,
	|	ТаблицаРабот.ДатаОкончания КАК ДатаОкончания,
	|	ТаблицаРабот.Длительность КАК Длительность,
	|	ТаблицаРабот.ЕдиницаДлительности КАК ЕдиницаДлительности,
	|	ВрТаб.СуммаСНДС КАК СуммаСНДС,
	|	ВрТаб.СтавкаНДС КАК СтавкаНДС,
	|	ВрТаб.СуммаНДС КАК СуммаНДС,
	|	ТаблицаРабот.СуммаЗаказчика КАК СуммаЗаказчика,
	|	ТаблицаРабот.ПонижающийКоэффициент КАК ПонижающийКоэффициент
	|ИЗ
	|	ТаблицаРабот КАК ТаблицаРабот
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТаб КАК ВрТаб
	|		ПО ТаблицаРабот.Работа.РаботаИсточник = ВрТаб.Работа.РаботаИсточник
	|			И ТаблицаРабот.Работа.ОбъемРаботы = ВрТаб.Работа.ОбъемРаботы
	|			И ТаблицаРабот.Работа.ЕдиницаОбъема = ВрТаб.Работа.ЕдиницаОбъема";
	
	Объект.Работы.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ПриОткрытииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура КомандаЗаполнитьЦенамиРазделительнойВедомостиНаСервере()
	
	ТабличнаяЧастьРаботы = Объект.Работы;
	ТабличнаяЧастьРаботы.Очистить();
	РеквизитРаботыДеревоЗначений = РеквизитФормыВЗначение("РаботыДеревоЗначений", Тип("ДеревоЗначений"));	
	ЗаполнитьТабличнуюЧастьРаботыИзДереваЗначений(РеквизитРаботыДеревоЗначений, ТабличнаяЧастьРаботы, 0, Ложь);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументУтверждения",Объект.ДокументУтверждения);
	Запрос.УстановитьПараметр("Контрагент",Объект.Контрагент);
	Запрос.УстановитьПараметр("Дата",Объект.Дата);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ЦенаПодрядчикаВРазделительнойВедомостиСрезПоследних.Работа КАК Работа,
	|	УСОERP_ЦенаПодрядчикаВРазделительнойВедомостиСрезПоследних.ЦенаПодрядчика КАК ЦенаПодрядчика
	|ИЗ
	|	РегистрСведений.УСОERP_ЦенаПодрядчикаВРазделительнойВедомости.СрезПоследних(
	|			,
	|			ДокументУтверждения = &ДокументУтверждения
	|				И Контрагент = &Контрагент) КАК УСОERP_ЦенаПодрядчикаВРазделительнойВедомостиСрезПоследних";
	
	
	Выборка = ЗАпрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Строки = Объект.Работы.НайтиСтроки(Новый Структура("Работа",Выборка.Работа));
		
		Для Каждого СтрокаРаботы ИЗ Строки Цикл
			
			СтрокаРаботы.СуммаСНДС = Выборка.ЦенаПодрядчика;
			СтрокаРаботы.СтавкаНДС = ?(ЗначениеЗаполнено(Объект.Договор.СтавкаНДС),Объект.Договор.СтавкаНДС,Перечисления.СтавкиНДС.НДС20);
			СтрокаРаботы.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СтрокаРаботы.СуммаСНДС,СтрокаРаботы.СтавкаНДС,Истина,Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС);
			
		КонецЦикла;
		
	КонецЦикла;
	
	ПриОткрытииНаСервере(); 	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьЦенамиРазделительнойВедомости(Команда)
	
	КомандаЗаполнитьЦенамиРазделительнойВедомостиНаСервере();
	РассчитатьИтоговыеПоказатели();
	
КонецПроцедуры  


#КонецОбласти



#КонецОбласти

