
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Заголовок = "Подбор материалов для строительной работы: " + Символы.ПС + Параметры.Работа;
	
	ВидОперации =	 Параметры.ВидОперации;
	НачалоПериода =	 Параметры.НачалоПериода;
	КонецПериода =	 Параметры.КонецПериода;
	Склад =			 Параметры.Склад;
	Партнер =		 Параметры.Партнер;
	Контрагент =	 Параметры.Контрагент;
	Договор =		 Параметры.Договор;
	Соглашение =	 Параметры.Соглашение;
	
	Работа = Параметры.Работа;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ТаблицаМатериаловНаСкладах, "КонецПериода",	Новый Граница(КонецДня(Параметры.КонецПериода), ВидГраницы.Включая),Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ТаблицаМатериаловНаСкладах, "Склад",			Параметры.Склад, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ТаблицаМатериаловНаСкладах, "ВидОперации",	Параметры.ВидОперации, Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ТаблицаМатериаловПереданных, "КонецПериода",	Новый Граница(КонецДня(Параметры.КонецПериода), ВидГраницы.Включая),Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ТаблицаМатериаловПереданных, "Склад",		Параметры.Склад, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ТаблицаМатериаловПереданных, "Поставщик",	Параметры.Партнер, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ТаблицаМатериаловПереданных, "Контрагент",	Параметры.Контрагент,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ТаблицаМатериаловПереданных, "Соглашение",	Параметры.Соглашение, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ТаблицаМатериаловПереданных, "Договор",		Параметры.Договор, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ТаблицаМатериаловПереданных, "ВидОперации",	Параметры.ВидОперации, Истина);

	Элементы.ГруппаМатериалыПереданныеСубподрядчику.Видимость = (Параметры.ВидОперации = Перечисления.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.МатериалыПереданныеСубподрядчику);
	Элементы.ГруппаСобственныеМатериалы.Видимость 			  = (Параметры.ВидОперации = Перечисления.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.СобственныеМатериалы);
	
	ТекущийСписокНоменклатуры = ?(ВидОперации = перечисления.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.МатериалыПереданныеСубподрядчику, "ТаблицаМатериаловПереданных", "ТаблицаМатериаловНаСкладах");
		
	КодФормы = "Форма_ПодборМатериаловДляОтраженияРасходаВСтроительстве";
	
	Настройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КодФормы, "");
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Если Настройки.Свойство("ТекущаяИерархияНоменклатуры") тогда
			Если ЗначениеЗаполнено(Настройки.ТекущаяИерархияНоменклатуры) Тогда
				Элементы.ИерархияНоменклатуры.ТекущаяСтрока = Настройки.ТекущаяИерархияНоменклатуры;
				ТекущаяИерархияНоменклатуры = Настройки.ТекущаяИерархияНоменклатуры;
			КонецЕсли;
		КонецЕсли;
		Если Настройки.Свойство("ТолькоВНаличии") тогда
			ТолькоВНаличии =  Настройки.ТолькоВНаличии;
		КонецЕсли;
		Если Настройки.Свойство("ИспользоватьФильтры") тогда
			ИспользоватьФильтры =  Настройки.ИспользоватьФильтры;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьСнятьФильтрПоИерархии();
	УстановитьОтборТолькоВНаличииНаСервере();
	
	УстановитьУсловноеОформление();


КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	СохранитьЗначенияНастроекФормыНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийРеквизитовФормы

&НаКлиенте
Процедура ТолькоВНаличииПриИзменении(Элемент)
	
	УстановитьОтборТолькоВНаличииНаСервере();
		
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьФильтрыПриИзменении(Элемент)
	УстановитьСнятьФильтрПоИерархии();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицФормыТаблицаМатериалыНаСкладах

&НаКлиенте
Процедура ТаблицаМатериаловНаСкладахВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Не ЗначениеЗаполнено(ВыбраннаяСтрока) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы[ТекущийСписокНоменклатуры].ТекущиеДанные;
	
	ХарактеристикиИспользуются = ПолучитьПризнакХарактеристикиИспользуются(ВыбраннаяСтрока);
	Если ХарактеристикиИспользуются Тогда
		ТекущаяНоменклатура = ВыбраннаяСтрока;
		Элементы.ГруппаХарактеристики.Видимость = Истина;
		Элементы.ГруппаМатериалы.Видимость = Ложь;

		ЗаполнитьХарактеристикиНоменклатурыНаСервере();
	Иначе
		мПараметрыФормы = Новый Структура;
		мПараметрыФормы.Вставить("Номенклатура", ВыбраннаяСтрока);
		мПараметрыФормы.Вставить("КоличествоОстаток", ТекущиеДанные.КоличествоОстаток);
		мПараметрыФормы.Вставить("ХарактеристикиИспользуются", ХарактеристикиИспользуются);
		
		
		ПараметрыМатериалов = Новый Структура;
		ОткрытьФорму("Документ.УСОERP_РасходМатериаловВСтроительстве.Форма.ФормаВводаКоличества", мПараметрыФормы,,,,,Новый ОписаниеОповещения("ДобавитьМатериалыВТаблицу", ЭтотОбъект,ПараметрыМатериалов),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		
	КонецЕсли;   	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицФормыТаблицаМатериалыПереданные

&НаКлиенте
Процедура ТаблицаМатериаловПереданныхВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если Не ЗначениеЗаполнено(ВыбраннаяСтрока) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы[ТекущийСписокНоменклатуры].ТекущиеДанные;
	
	ХарактеристикиИспользуются = ПолучитьПризнакХарактеристикиИспользуются(ВыбраннаяСтрока);
	Если ХарактеристикиИспользуются Тогда
		ТекущаяНоменклатура = ВыбраннаяСтрока;
		Элементы.ГруппаХарактеристики.Видимость = Истина;
		Элементы.ГруппаМатериалы.Видимость = Ложь;

		ЗаполнитьХарактеристикиНоменклатурыНаСервере();
	Иначе
		мПараметрыФормы = Новый Структура;
		мПараметрыФормы.Вставить("Номенклатура", ВыбраннаяСтрока);
		мПараметрыФормы.Вставить("КоличествоОстаток", ТекущиеДанные.КоличествоОстаток);
		мПараметрыФормы.Вставить("ХарактеристикиИспользуются", ХарактеристикиИспользуются);
		
		
		ПараметрыМатериалов = Новый Структура;
		ОткрытьФорму("Документ.УСОERP_РасходМатериаловВСтроительстве.Форма.ФормаВводаКоличества", мПараметрыФормы,,,,,Новый ОписаниеОповещения("ДобавитьМатериалыВТаблицу", ЭтотОбъект,ПараметрыМатериалов),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		
	КонецЕсли;  
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицФормыТаблицаХарактеристик

&НаКлиенте
Процедура ТаблицаХарактеристикВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ТаблицаХарактеристик.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбраннаяСтрокаХарактеристики = ПолучитьВыбраннуюХарактеристику(ТекущиеДанные.ПолучитьИдентификатор());
	
	мПараметрыФормы = Новый Структура;
	мПараметрыФормы.Вставить("Номенклатура", ТекущаяНоменклатура);
	мПараметрыФормы.Вставить("Характеристика", ВыбраннаяСтрокаХарактеристики.Характеристика);
	мПараметрыФормы.Вставить("КоличествоОстаток", ВыбраннаяСтрокаХарактеристики.КоличествоОстаток);
	мПараметрыФормы.Вставить("ХарактеристикиИспользуются", Истина);
	
	
	ПараметрыМатериалов = Новый Структура;
	ОткрытьФорму("Документ.УСОERP_РасходМатериаловВСтроительстве.Форма.ФормаВводаКоличества", мПараметрыФормы,,,,,Новый ОписаниеОповещения("ДобавитьМатериалыВТаблицу", ЭтотОбъект,ПараметрыМатериалов),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	

	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицФормыИерархияНоменклатуры

&НаКлиенте
Процедура ИерархияНоменклатурыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ИерархияНоменклатурыПриАктивизацииСтроки(Элемент)
	
	УстановитьСнятьФильтрПоИерархии();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ПоместитьВыбранныеМатериалыВХранилище();
	ПарметрыВозврата = Новый Структура;
	ПарметрыВозврата.Вставить("АдресМатериаловВоВременномХранилище", АдресВоВременномХранилище);
	ПарметрыВозврата.Вставить("Работа", Работа);
	
	Закрыть( ПарметрыВозврата);
	
КонецПроцедуры

&НаКлиенте
Процедура КарточкаНоменклатуры(Команда)
	
	ТекущиеДанные = Неопределено;
	ТекущиеДанные = Элементы[ТекущийСписокНоменклатуры].ТекущиеДанные;
		
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	мНоменклатура = ТекущиеДанные.Номенклатура;
	Если Не ЗначениеЗаполнено(мНоменклатура) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ФормаОбъекта = ПолучитьФорму("Справочник.Номенклатура.ФормаОбъекта", Новый Структура("Ключ", мНоменклатура));
		ФормаОбъекта.Открыть();
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутьсяКВыборуМатериала(Команда)
	Элементы.ГруппаМатериалы.Видимость = Истина;
	Элементы.ГруппаХарактеристики.Видимость = Ложь;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборТолькоВНаличииНаСервере()
	
	ГруппаОтбораТолькоВНаличииНоменклатура = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
					ОбщегоНазначенияУТКлиентСервер.ПолучитьОтборДинамическогоСписка(ЭтаФорма[ТекущийСписокНоменклатуры]).Элементы,
					"ГруппаТолькоВНаличии", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
		
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
					ГруппаОтбораТолькоВНаличииНоменклатура,
					"КоличествоОстаток", 0, ВидСравненияКомпоновкиДанных.Больше,,ТолькоВНаличии);

	
КонецПроцедуры

&НаСервере
Процедура УстановитьСнятьФильтрПоИерархии()
	
		
	ТекущаяИерархияНоменклатуры = Элементы.ИерархияНоменклатуры.ТекущаяСтрока;
			
	Если Элементы.ИерархияНоменклатуры.ТекущаяСтрока = Неопределено Тогда
		ОтборПоИерархииНоменклатуры = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
	Иначе
		ОтборПоИерархииНоменклатуры = Элементы.ИерархияНоменклатуры.ТекущаяСтрока;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЭтаФорма[ТекущийСписокНоменклатуры], "Родитель", ОтборПоИерархииНоменклатуры, 
		ВидСравненияКомпоновкиДанных.Равно, "Родитель", ИспользоватьФильтры);


КонецПроцедуры

&НаСервере
Процедура СохранитьЗначенияНастроекФормыНаСервере()
	
	НастройкиФормыПодбора = Новый Структура;
	НастройкиФормыПодбора.Вставить("ТекущаяИерархияНоменклатуры", ТекущаяИерархияНоменклатуры);
	НастройкиФормыПодбора.Вставить("ИспользоватьФильтры", ИспользоватьФильтры);
	НастройкиФормыПодбора.Вставить("ТолькоВНаличии", ТолькоВНаличии);
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(КодФормы, , НастройкиФормыПодбора);
	

КонецПроцедуры

&НаСервере
Функция ПолучитьПризнакХарактеристикиИспользуются(Номенклатура)
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат ложь;
	КонецЕсли;
	
	Возврат (Номенклатура.ИспользованиеХарактеристик <> Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать);
	
КонецФункции

&НаКлиенте
Процедура ДобавитьМатериалыВТаблицу(ПодобранныеМатериалы, ДополнительныеПараметры) Экспорт
	
	Если ПодобранныеМатериалы<> Неопределено Тогда
		ДобавитьМатериалыВТаблицуНаСервере(ПодобранныеМатериалы, ДополнительныеПараметры);
	КонецЕсли;
 
КонецПроцедуры

&НаСервере
Процедура ДобавитьМатериалыВТаблицуНаСервере(ПодобранныеМатериалы, ДополнительныеПараметры)
	
	Если НЕ ПодобранныеМатериалы.ПереноситьВДокумент Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиТаблицыМатериалов = ВыбранныеМатериалы.НайтиСтроки( Новый Структура("Номенклатура, Характеристика", ПодобранныеМатериалы.Номенклатура, ПодобранныеМатериалы.Характеристика));
	
	Если СтрокиТаблицыМатериалов.Количество() = 0 Тогда
		НоваяСтрока = ВыбранныеМатериалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПодобранныеМатериалы);
	Иначе
		СтрокиТаблицыМатериалов[0].Количество = СтрокиТаблицыМатериалов[0].Количество + ПодобранныеМатериалы.Количество;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьХарактеристикиНоменклатурыНаСервере()
	
	ТаблицаХарактеристик.Очистить();
	Запрос = Новый Запрос;
	Если ВидОперации = Перечисления.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.МатериалыПереданныеСубподрядчику Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТоварыПереданныеПереработчикуОстатки.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
		|	СУММА(ЕСТЬNULL(ТоварыПереданныеПереработчикуОстатки.КоличествоОстаток, 0)) КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ТоварыПереданныеПереработчику.Остатки(
		|			&КонецПериода,
		|			АналитикаУчетаНоменклатуры.СкладскаяТерритория = &Склад
		|				И АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура
		|				И ВидЗапасов.ВладелецТовара = &Поставщик
		|				И ВидЗапасов.Контрагент = &Контрагент
		|				И ВидЗапасов.Договор = &Договор
		|				И ВидЗапасов.Соглашение = &Соглашение) КАК ТоварыПереданныеПереработчикуОстатки
		|ГДЕ
		|	ЕСТЬNULL(ТоварыПереданныеПереработчикуОстатки.КоличествоОстаток, 0) > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыПереданныеПереработчикуОстатки.АналитикаУчетаНоменклатуры.Характеристика";

	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТоварыНаСкладахОстатки.Характеристика,
		|	СУММА(ЕСТЬNULL(ТоварыНаСкладахОстатки.ВНаличииОстаток, 0)) КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|			&КонецПериода,
		|			Склад = &Склад
		|				И Номенклатура = &Номенклатура) КАК ТоварыНаСкладахОстатки
		|ГДЕ
		|	ЕСТЬNULL(ТоварыНаСкладахОстатки.ВНаличииОстаток, 0) > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыНаСкладахОстатки.Характеристика
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТоварыНаСкладахОстатки.Характеристика.Наименование";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(КонецПериода), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", ТекущаяНоменклатура);
	Запрос.УстановитьПараметр("Поставщик", Партнер);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Соглашение", Соглашение);
	
	Результат = Запрос.Выполнить();
	
	ТаблицаХарактеристик.Загрузить(Результат.Выгрузить());
	
Конецпроцедуры

&НаСервере
Функция ПолучитьВыбраннуюХарактеристику(ИдентификаторСтроки)
	
	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат Новый Структура("Характеристика, КоличествоОстаток", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(), 0);
	КонецЕсли;
	
	ТекущаяСтрока = ТаблицаХарактеристик.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат Новый Структура("Характеристика, КоличествоОстаток", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(), 0);
	КонецЕсли;

	Возврат Новый Структура("Характеристика, КоличествоОстаток",ТекущаяСтрока.Характеристика, ТекущаяСтрока.КоличествоОстаток);
	
КонецФункции

&НаСервере
Процедура ПоместитьВыбранныеМатериалыВХранилище()
	
	ТаблицаВыбранныхМатериалов = ВыбранныеМатериалы.Выгрузить();
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(ТаблицаВыбранныхМатериалов, ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	//

	Элемент = УсловноеОформление.Элементы.Добавить();

		
	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтаФорма, 
																			 "ВыбранныеМатериалыХарактеристика",
																		     "ВыбранныеМатериалы.ХарактеристикиИспользуются");

	
КонецПроцедуры

#КонецОбласти
