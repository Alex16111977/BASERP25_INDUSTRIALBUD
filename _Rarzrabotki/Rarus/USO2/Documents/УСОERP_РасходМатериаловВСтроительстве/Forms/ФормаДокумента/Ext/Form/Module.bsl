&НаСервере
Процедура ОбновитьРаботуВНовойСтрокеМатериалов(ИдентификаторСтроки)
	
	СтрокаДерева = ДеревоМатериалы.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаДерева = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	РодительСтроки = СтрокаДерева.ПолучитьРодителя();
	Если РодительСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаДерева.Работа 		= РодительСтроки.Работа;
	СтрокаДерева.Объем 			= РодительСтроки.Объем;
	СтрокаДерева.ЕдиницаОбъема 	= РодительСтроки.ЕдиницаОбъема;
	
	СтрокаДерева.ЭтоРабота = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтвойствоСтроки_ЭтоРабота(ИдентификаторСтроки)
	
	ТекущиеДанные = ДеревоМатериалы.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные.ЭтоРабота = Истина;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеПоРаботеВСтрокеИПодчиненныхСтроках(ИдентификаторСтроки)
	
	ТекущиеДанные = ДеревоМатериалы.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Работа", ТекущиеДанные.Работа);
	СтруктураПараметров.Вставить("ОбъектСтроительства", Объект.ОбъектСтроительства);

	//УСОERP_УправлениеСтроительнымПроизводством.ПолучитьДанныеПоРаботам(СтруктураПараметров);
	
	ПодчиненныеСтроки = ТекущиеДанные.ПолучитьЭлементы();
	Для Каждого СтрМатериал Из ПодчиненныеСтроки Цикл
		СтрМатериал.Работа 			= ТекущиеДанные.Работа;
		СтрМатериал.Объем 			= ТекущиеДанные.Объем;
		СтрМатериал.ЕдиницаОбъема 	= ТекущиеДанные.ЕдиницаОбъема;
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьДеревоМатериаловиРабот()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка КАК Ссылка,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.НомерСтроки КАК НомерСтроки,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Работа КАК Работа,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Работа.Родитель КАК РаботаРодитель,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Объем КАК Объем,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Номенклатура КАК Номенклатура,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Характеристика КАК Характеристика,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Упаковка КАК Упаковка,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.КоличествоУпаковок КАК КоличествоУпаковок,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Количество КАК Количество,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Работа КАК РаботаСсылка
	|ИЗ
	|	Документ.УСОERP_РасходМатериаловВСтроительстве.Материалы КАК УСОERP_РасходМатериаловВСтроительствеМатериалы
	|ГДЕ
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ ПО
	|	Работа";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	Результат = Запрос.Выполнить();
	
	мДеревоМатериалов = РеквизитФормыВЗначение("ДеревоМатериалы");
	мДеревоМатериалов.Колонки.Добавить("КодСДРЧисло", Новый ОписаниеТипов("Число"));
	
	ВыборкаРабота = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Работа");
	Пока ВыборкаРабота.Следующий() Цикл
		ПерваяСтрока = Истина;
		НоваяСтрокаРабота = мДеревоМатериалов.Строки.Добавить();
		НоваяСтрокаРабота.КодСДРЧисло = УСОERP_ОбработкаТабличныхЧастей.КодСДРвЧисло(ВыборкаРабота.Работа.КодСДР);
		НоваяСтрокаРабота.Работа = ВыборкаРабота.Работа;
		НоваяСтрокаРабота.РаботаСсылка = ВыборкаРабота.РаботаСсылка;
		
		ВыборкаДанные = ВыборкаРабота.Выбрать();
		Пока ВыборкаДанные.Следующий() Цикл
			Если ПерваяСтрока тогда
				НоваяСтрокаРабота.Объем = ВыборкаДанные.Объем;
				НоваяСтрокаРабота.ЕдиницаОбъема = ВыборкаДанные.ЕдиницаОбъема;
				НоваяСтрокаРабота.ЭтоРабота = Истина;
				ПерваяСтрока = Ложь;
			КонецЕсли;
			
			НоваяСтрокаМатериал =  НоваяСтрокаРабота.Строки.Добавить();
			НоваяСтрокаМатериал.КодСДРЧисло = УСОERP_ОбработкаТабличныхЧастей.КодСДРвЧисло(ВыборкаДанные.Работа.КодСДР);
			ЗаполнитьЗначенияСвойств( НоваяСтрокаМатериал, ВыборкаДанные);
			
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
			
			ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрокаМатериал, СтруктураДействий, );  
			
		КонецЦикла;
	КонецЦикла;
	
	мДеревоМатериалов.Строки.Сортировать("КодСДРЧисло Возр", Истина);
	
	ЗначениеВРеквизитФормы(мДеревоМатериалов, "ДеревоМатериалы");
	
КонецПроцедуры

&НаСервере
Процедура ОбойтиДеревоМатериаловОбновитьЗависимыеРеквизиты()
	
	СтрокиРаботы = ДеревоМатериалы.ПолучитьЭлементы();
	Для Каждого мСтрокаДерева Из СтрокиРаботы Цикл 
		мСтрокаДерева.ЭтоРабота = Истина;
		СтрокиМатериалы = мСтрокаДерева.ПолучитьЭлементы();
		Для Каждого мСтрокаМатериал Из СтрокиМатериалы Цикл
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
			
			ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(мСтрокаМатериал, СтруктураДействий, ); 
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОчиститьЗависимыеРеквизиты()
	
	Если (ПредыдущиеРеквизитыШапки.ОбъектСтроительства<> Объект.ОбъектСтроительства И ЗначениеЗаполнено(ПредыдущиеРеквизитыШапки.ОбъектСтроительства))
		ИЛИ (ПредыдущиеРеквизитыШапки.Партнер <> Объект.Партнер И ЗначениеЗаполнено(ПредыдущиеРеквизитыШапки.Партнер))
		ИЛИ (ПредыдущиеРеквизитыШапки.Подразделение <> Объект.Подразделение И ЗначениеЗаполнено(ПредыдущиеРеквизитыШапки.Подразделение))
		ИЛИ (ПредыдущиеРеквизитыШапки.ДатаНачала <> Объект.ДатаНачала  И ЗначениеЗаполнено(ПредыдущиеРеквизитыШапки.ДатаНачала))
		ИЛИ (ПредыдущиеРеквизитыШапки.ДатаОкончания <> Объект.ДатаОкончания И ЗначениеЗаполнено(ПредыдущиеРеквизитыШапки.ДатаОкончания)) Тогда
		
		Если ДеревоМатериалы.ПолучитьЭлементы().Количество()>0 Тогда
			
			ПоказатьВопрос(Новый ОписаниеОповещения("ПроверитьОчиститьЗависимыеРеквизитыПродолжение",ЭтотОбъект),"Табличная часть материалов и работ будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет, 30, КодВозвратаДиалога.Нет);
			
		Иначе
			
			ПроверитьОчиститьЗависимыеРеквизитыПродолжение(КодВозвратаДиалога.Да,Новый Структура);
			
		КонецЕсли; 
		
	Иначе
		
		ПроверитьОчиститьЗависимыеРеквизитыПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОчиститьЗависимыеРеквизитыПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Объект.ОбъектСтроительства	= ПредыдущиеРеквизитыШапки.ОбъектСтроительства;
		Объект.Партнер				= ПредыдущиеРеквизитыШапки.Партнер;
		Объект.Подразделение		= ПредыдущиеРеквизитыШапки.Подразделение;
		Объект.ДатаНачала			= ПредыдущиеРеквизитыШапки.ДатаНачала;
		Объект.ДатаОкончания		= ПредыдущиеРеквизитыШапки.ДатаОкончания; 				
		Возврат; 
		
	КонецЕсли;
	
	
	ПредыдущиеРеквизитыШапки.ОбъектСтроительства	= Объект.ОбъектСтроительства;
	ПредыдущиеРеквизитыШапки.Партнер				= Объект.Партнер;
	ПредыдущиеРеквизитыШапки.Подразделение			= Объект.Подразделение;
	ПредыдущиеРеквизитыШапки.ДатаНачала				= Объект.ДатаНачала;
	ПредыдущиеРеквизитыШапки.ДатаОкончания			= Объект.ДатаОкончания;
	
	Если ПоказыватьМатериалыСводно Тогда
		ОбновитьСводныеДанныеПоМатериалам();
	КонецЕсли;  	
	
КонецПроцедуры  

&НаСервере
Процедура ОбновитьСводныеДанныеПоМатериалам()
	
	ДеревоРаботИМатериалов = РеквизитФормыВЗначение("ДеревоМатериалы");
	
	ТаблицаМатериалов = МатериалыСводно.Выгрузить();
	ТаблицаМатериалов.Очистить();
	Для Каждого СтрокаРабота Из ДеревоРаботИМатериалов.Строки Цикл
		Для Каждого СтрокаМатериал Из СтрокаРабота.Строки   Цикл
			   НоваяСтрокаМатериал = ТаблицаМатериалов.Добавить();
			   ЗаполнитьЗначенияСвойств(НоваяСтрокаМатериал, СтрокаМатериал);
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаМатериалов.Свернуть("Номенклатура, Характеристика", "Количество, Остаток");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ТаблицаМатериалов.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ЕСТЬNULL(ТаблицаМатериалов.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ЕСТЬNULL(&Склад, ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)) КАК Склад,
	|	ЕСТЬNULL(ТаблицаМатериалов.Количество, 0) КАК Количество
	|ПОМЕСТИТЬ ВТ_ДанныеОтбора
	|ИЗ
	|	&ТаблицаМатериалов КАК ТаблицаМатериалов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыНаСкладахОстатки.Номенклатура,
	|	ТоварыНаСкладахОстатки.Характеристика,
	|	СУММА(ТоварыНаСкладахОстатки.ВНаличииОстаток) КАК Остаток
	|ПОМЕСТИТЬ ВТ_ОстаткиТоваров
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			&КонецПериода,
	|			(Номенклатура, Характеристика, Склад) В
	|				(ВЫБРАТЬ
	|					ВТ_ДанныеОтбора.Номенклатура,
	|					ВТ_ДанныеОтбора.Характеристика,
	|					ВТ_ДанныеОтбора.Склад
	|				ИЗ
	|					ВТ_ДанныеОтбора КАК ВТ_ДанныеОтбора)) КАК ТоварыНаСкладахОстатки
	|ГДЕ
	|	&ВидОперации = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.СобственныеМатериалы)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыНаСкладахОстатки.Номенклатура,
	|	ТоварыНаСкладахОстатки.Характеристика
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТоварыПереданныеПереработчикуОстатки.АналитикаУчетаНоменклатуры.Номенклатура,
	|	ТоварыПереданныеПереработчикуОстатки.АналитикаУчетаНоменклатуры.Характеристика,
	|	СУММА(ТоварыПереданныеПереработчикуОстатки.КоличествоОстаток)
	|ИЗ
	|	РегистрНакопления.ТоварыПереданныеПереработчику.Остатки(
	|			&КонецПериода,
	|			(АналитикаУчетаНоменклатуры.Номенклатура, АналитикаУчетаНоменклатуры.Характеристика, АналитикаУчетаНоменклатуры.СкладскаяТерритория) В
	|					(ВЫБРАТЬ
	|						ВТ_ДанныеОтбора.Номенклатура,
	|						ВТ_ДанныеОтбора.Характеристика,
	|						ВТ_ДанныеОтбора.Склад
	|					ИЗ
	|						ВТ_ДанныеОтбора КАК ВТ_ДанныеОтбора)
	//|				И ВидЗапасов.Поставщик = &Поставщик
	|				И ВидЗапасов.Контрагент = &Контрагент
	|				И ВидЗапасов.Соглашение = &Соглашение
	|				И ВидЗапасов.Договор = &Договор) КАК ТоварыПереданныеПереработчикуОстатки
	|ГДЕ
	|	&ВидОперации = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.МатериалыПереданныеСубподрядчику)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыПереданныеПереработчикуОстатки.АналитикаУчетаНоменклатуры.Номенклатура,
	|	ТоварыПереданныеПереработчикуОстатки.АналитикаУчетаНоменклатуры.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеОтбора.Номенклатура,
	|	ВТ_ДанныеОтбора.Характеристика,
	|	СУММА(ВТ_ДанныеОтбора.Количество) КАК Количество,
	|	СУММА(ЕСТЬNULL(ВТ_ОстаткиТоваров.Остаток, 0)) КАК Остаток
	|ИЗ
	|	ВТ_ДанныеОтбора КАК ВТ_ДанныеОтбора
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиТоваров КАК ВТ_ОстаткиТоваров
	|		ПО ВТ_ДанныеОтбора.Номенклатура = ВТ_ОстаткиТоваров.Номенклатура
	|			И ВТ_ДанныеОтбора.Характеристика = ВТ_ОстаткиТоваров.Характеристика
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеОтбора.Номенклатура,
	|	ВТ_ДанныеОтбора.Характеристика";
	
	Запрос.УстановитьПараметр("КонецПериода", 		Новый Граница(КонецДня(Объект.ДатаОкончания), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Склад", 				Объект.Склад);
	Запрос.УстановитьПараметр("Поставщик", 			Объект.Партнер);
	Запрос.УстановитьПараметр("Контрагент", 		Объект.Контрагент);
	Запрос.УстановитьПараметр("Договор", 			Объект.Договор);
	Запрос.УстановитьПараметр("Соглашение", 		Объект.Соглашение);
	Запрос.УстановитьПараметр("ВидОперации", 		Объект.ВидОперации);
	
	Запрос.УстановитьПараметр("ТаблицаМатериалов", 	ТаблицаМатериалов);
	
	результат = Запрос.Выполнить();
	
	МатериалыСводно.Загрузить(Результат.Выгрузить());
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	мКэшированныеЗначения = Неопределено; 		
	ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(МатериалыСводно, СтруктураДействий, мКэшированныеЗначения);
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьПараметрыДляФормыПодбораНаСервере(ПарметрыФормы, ИдентификаторСтроки, Отказ = Ложь, ТекстСообщенияОшибки)
	
	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = ДеревоМатериалы.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.Работа) Тогда
		ТекстСообщенияОшибки = "В выделенной строке не указана работа, для которой необходимо подобрать материалы.";
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ТекущийРодитель = ТекущаяСтрока.ПолучитьРодителя();
	Если  ТекущийРодитель = Неопределено Тогда
		ТекущийРодитель = ТекущаяСтрока;
	КонецЕсли;
	
	ПарметрыФормы.Вставить("Работа", ТекущийРодитель.Работа);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВыбранныеМатериалыКРаботе(ВыбранныеМатериалы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеМатериалы<> Неопределено Тогда
		ДобавитьМатериалыВТаблицуНаСервере(ВыбранныеМатериалы, ДополнительныеПараметры);
		
		Если ПоказыватьМатериалыСводно Тогда
			ОбновитьСводныеДанныеПоМатериалам();
		КонецЕсли;
		
	КонецЕсли;
 
КонецПроцедуры

&НаСервере
Процедура ДобавитьМатериалыВТаблицуНаСервере(ВыбранныеМатериалы, ДополнительныеПараметры)
	
	КэшированныеЗначения = неопределено;
	
	ТаблВыбранныхМатериалов = ПолучитьИзВременногоХранилища(ВыбранныеМатериалы.АдресМатериаловВоВременномХранилище);
	Если ТаблВыбранныхМатериалов.Количество() >0 Тогда
		мТекущаяРабота = ВыбранныеМатериалы.Работа;
		Если мТекущаяРабота = Неопределено Тогда
			Возврат;
		конецЕсли;
		
		мДеревоМатериалов = РеквизитФормыВЗначение("ДеревоМатериалы"); 		
		СтрокиРаботы = мДеревоМатериалов.Строки.НайтиСтроки(Новый Структура("Работа", мТекущаяРабота));
		
		КоличествоСтрокМатериалов = 0;
		Если СтрокиРаботы.Количество()>0 Тогда
			ТекущаяСтрокаДереваМатериалов_Работа = СтрокиРаботы[0];
			
			СтрокиМатериалов = ТекущаяСтрокаДереваМатериалов_Работа.Строки;
			
			Для Каждого мСтрокаВыбранныйМатериал Из ТаблВыбранныхМатериалов Цикл
				МассивНаличиеМатериаловВДокументе = СтрокиМатериалов.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", мСтрокаВыбранныйМатериал.Номенклатура, мСтрокаВыбранныйМатериал.Характеристика));
				Если МассивНаличиеМатериаловВДокументе.Количество()>0 Тогда
					НоваяСтрокаМатериал = МассивНаличиеМатериаловВДокументе[0];
					НоваяСтрокаМатериал.Количество = НоваяСтрокаМатериал.Количество + мСтрокаВыбранныйМатериал.Количество;
				Иначе
					НоваяСтрокаМатериал = СтрокиМатериалов.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаМатериал, мСтрокаВыбранныйМатериал);
					НоваяСтрокаМатериал.Работа = ТекущаяСтрокаДереваМатериалов_Работа.Работа;
					НоваяСтрокаМатериал.Объем = ТекущаяСтрокаДереваМатериалов_Работа.Объем;
					НоваяСтрокаМатериал.ЕдиницаОбъема = ТекущаяСтрокаДереваМатериалов_Работа.ЕдиницаОбъема;
				КонецЕсли;
				
				СтруктураДействий = Новый Структура;
				СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу",       	НоваяСтрокаМатериал.Характеристика);
				СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу",    	НоваяСтрокаМатериал.Упаковка);
				СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок",    			НоваяСтрокаМатериал.Упаковка);
								
				ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрокаМатериал, СтруктураДействий, КэшированныеЗначения);
				  				
			КонецЦикла;
			
			КоличествоСтрокМатериалов = СтрокиМатериалов.Количество();
		КонецЕсли;
		
		ЗначениеВДанныеФормы(мДеревоМатериалов, ДеревоМатериалы);
		
		Если КоличествоСтрокМатериалов >0 Тогда
			ЭлементыДереваМатериалов = ДеревоМатериалы.ПолучитьЭлементы();
			Для Каждого СтрРабота Из ЭлементыДереваМатериалов Цикл
				Если СтрРабота.Работа = мТекущаяРабота Тогда
					ЭлементыРаботы = СтрРабота.ПолучитьЭлементы();
					Элементы.ДеревоМатериалы.ТекущаяСтрока = ЭлементыРаботы[КоличествоСтрокМатериалов-1].ПолучитьИдентификатор();
				КонецЕсли; 			
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗависимыеРеквизитыНаСервере()
	АвтоматическиЗаполнятьПлановыйРасходМатериалов = Объект.ОбъектСтроительства.АвтоматическиЗаполнятьПлановыйРасходМатериалов;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокДокументовРасхода(ЭтотОбъект, ДополнительныеПараметры) Экспорт
	
	НастроитьОтображениеДокументовРасхода();
	
	УстановитьВидимостьРеквизитов();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьОтображениеДокументовРасхода()
	
	Если Объект.ВидОперации = Перечисления.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.МатериалыПереданныеСубподрядчику тогда
		СписокДокументовРасходов.Очистить();
	Иначе
		СписокДокументовРасходов.Очистить();
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВнутреннееПотреблениеТоваров.Ссылка КАК ДокументРасхода
		|ИЗ
		|	Документ.ВнутреннееПотреблениеТоваров КАК ВнутреннееПотреблениеТоваров
		|ГДЕ
		|	ВнутреннееПотреблениеТоваров.ЗаказНаВнутреннееПотребление = &Ссылка
		|	И ВнутреннееПотреблениеТоваров.ПометкаУдаления = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПередачаМатериаловВПроизводство.Ссылка
		|ИЗ
		|	Документ.ПередачаМатериаловВПроизводство КАК ПередачаМатериаловВПроизводство
		|ГДЕ
		|	ПередачаМатериаловВПроизводство.ПометкаУдаления = ЛОЖЬ
		|	И ПередачаМатериаловВПроизводство.Распоряжение = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДвижениеПродукцииИМатериалов.Ссылка
		|ИЗ
		|	Документ.ДвижениеПродукцииИМатериалов КАК ДвижениеПродукцииИМатериалов
		|ГДЕ
		|	ДвижениеПродукцииИМатериалов.ПометкаУдаления = ЛОЖЬ
		|	И ДвижениеПродукцииИМатериалов.ДокументОснование = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		
		Результат = Запрос.Выполнить();
		
		СписокДокументовРасходов.Загрузить(Результат.Выгрузить());
		
		ДокументРасхода = "";
		
		Для Каждого СтрДокумент из СписокДокументовРасходов Цикл
			Если ДокументРасхода = "" тогда
				ДокументРасхода = ДокументРасхода + СтрДокумент.ДокументРасхода;
			Иначе
				ДокументРасхода = ДокументРасхода + "; " + СтрДокумент.ДокументРасхода;
			КонецЕсли;
		КонецЦикла;	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументРасходаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если СписокДокументовРасходов.Количество() = 1 
		И Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.СобственныеМатериалы") 
		И ТипЗнч(СписокДокументовРасходов[0].ДокументРасхода) = Тип("ДокументСсылка.ПередачаМатериаловВПроизводство") Тогда
		//Если ТипЗнч(ПолучитьПараметрыФормыДокументаРасхода().Ключ) = Тип("ДокументСсылка.ПередачаМатериаловВПроизводство") Тогда
			ОткрытьФорму("Документ.ПередачаМатериаловВПроизводство.ФормаОбъекта", ПолучитьПараметрыФормыДокументаРасхода(),,,,,Новый ОписаниеОповещения("ОбновитьСписокДокументовРасхода", ЭтотОбъект));
		//Иначе
		//	ОткрытьФорму("Документ.ВнутреннееПотреблениеТоваров.ФормаОбъекта", ПолучитьПараметрыФормыДокументаРасхода());
		//КонецЕсли;
	ИначеЕсли СписокДокументовРасходов.Количество() > 1 
		И Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.СобственныеМатериалы") 
		И ПередачаМатериаловВПроизводствоПоРасходуВСтроительстве = 1 Тогда
		
		ФормаСписка = ПолучитьФорму("Документ.ПередачаМатериаловВПроизводство.ФормаСписка");
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ФормаСписка.Список, "Распоряжение", Объект.Ссылка);
		ФормаСписка.Открыть();
		
	ИначеЕсли СписокДокументовРасходов.Количество() = 1 
		И Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.СобственныеМатериалы") 
		И ТипЗнч(СписокДокументовРасходов[0].ДокументРасхода) = Тип("ДокументСсылка.ВнутреннееПотреблениеТоваров") Тогда
		
		ОткрытьФорму("Документ.ВнутреннееПотреблениеТоваров.ФормаОбъекта", ПолучитьПараметрыФормыДокументаРасхода(),,,,,Новый ОписаниеОповещения("ОбновитьСписокДокументовРасхода", ЭтотОбъект));
				
	ИначеЕсли СписокДокументовРасходов.Количество() = 1 
		И Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.СобственныеМатериалы") 
		И ТипЗнч(СписокДокументовРасходов[0].ДокументРасхода) = Тип("ДокументСсылка.ДвижениеПродукцииИМатериалов") Тогда
		
		ОткрытьФорму("Документ.ДвижениеПродукцииИМатериалов.ФормаОбъекта", ПолучитьПараметрыФормыДокументаРасхода(),,,,,Новый ОписаниеОповещения("ОбновитьСписокДокументовРасхода", ЭтотОбъект));
		
	ИначеЕсли СписокДокументовРасходов.Количество() > 1 
		И Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.СобственныеМатериалы") 
		И ПередачаМатериаловВПроизводствоПоРасходуВСтроительстве = 0 Тогда
		
		ФормаСписка = ПолучитьФорму("Документ.ВнутреннееПотреблениеТоваров.ФормаСписка");
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ФормаСписка.Список, "ЗаказНаВнутреннееПотребление", Объект.Ссылка);
		ФормаСписка.Открыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыФормыДокументаРасхода()
	
	ПарметрыФормы = Новый Структура("Ключ", СписокДокументовРасходов[0].ДокументРасхода);
	Возврат ПарметрыФормы;
	
КонецФункции

&НаСервере
Функция СформироватьМассивТоваров()
	
	МассивТоваров = Новый Массив;
	
	Для Каждого СтрокаМатериал Из Объект.Материалы Цикл
		СтруктураСтроки = Новый Структура("Номенклатура, Характеристика, Назначение, Упаковка, КоличествоУпаковок, Количество, КодСтроки");
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, СтрокаМатериал);
		СтруктураСтроки.КодСтроки = СтрокаМатериал.НомерСтроки;
		МассивТоваров.Добавить(СтруктураСтроки);
	КонецЦикла;
	
	Возврат МассивТоваров;
КонецФункции

&НаСервере
Процедура УстановитьКомандуАвтозаполненияДокументаРасхода()
	
	ИспользоватьМатериальноТехническоеОбеспечение       	= ПолучитьФункциональнуюОпцию("УСОERP_ИспользоватьМатериальноТехническоеОбеспечение");
	ПередачаМатериаловВПроизводствоПоРасходуВСтроительстве	= ПолучитьФункциональнуюОпцию("УСОERP_ПередачаМатериаловВПроизводствоПоРасходуВСтроительстве");
	
	Элементы.ГруппаДокументРасхода.Видимость = ИспользоватьМатериальноТехническоеОбеспечение;
	
	Если ПередачаМатериаловВПроизводствоПоРасходуВСтроительстве = 2 Тогда
		Элементы.СформироватьВнутреннееПотребление.Заголовок = "Сформировать передачу в кладовую";
	ИначеЕсли ПередачаМатериаловВПроизводствоПоРасходуВСтроительстве = 1 Тогда
		Элементы.СформироватьВнутреннееПотребление.Заголовок = "Сформировать передачу в производство";
	Иначе
		Элементы.СформироватьВнутреннееПотребление.Заголовок = "Сформировать внутреннее потребление";       
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДокументРасхода(Команда)
	
	Если Модифицированность Тогда
		ПоказатьПредупреждение(,"Для продолжения необходимо записать документ!");
		Возврат;
	КонецЕсли; 	
	
	Если Объект.Проведен = Ложь  Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыПланов.Утвержден") Тогда
		Возврат;
	КонецЕсли;  
	
	Если ПередачаМатериаловВПроизводствоПоРасходуВСтроительстве = 2 Тогда
		СформироватьПередачуМатериаловВКладовую();
	ИначеЕсли ПередачаМатериаловВПроизводствоПоРасходуВСтроительстве = 1 Тогда
		СформироватьПередачуМатериаловВПроизводство();
	Иначе
		СформироватьВнутреннееПотребление();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПередачуМатериаловВКладовую()
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("СформироватьПередачуМатериаловВКладовуюПродолжение",ЭтотОбъект),"Перед созданием передачи в кладовую необходимо записать текущий документ. Записать?", РежимДиалогаВопрос.ДаНет,30,КодВозвратаДиалога.Нет);
		
	Иначе
		
		СформироватьПередачуМатериаловВКладовуюПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАктуальныеДанныеТЗМатериалы()
	
	ТЗ = Объект.Материалы.Выгрузить(, "Номенклатура, Характеристика, Упаковка, Количество, КоличествоУпаковок");
	ТЗ.Свернуть("Номенклатура, Характеристика, Упаковка", "Количество, КоличествоУпаковок");
	ТЗМатериалы.Загрузить(ТЗ);
	
	Итератор = 1;
	Для Каждого ТекСтрока Из ТЗМатериалы Цикл
		ТекСтрока.КодСтроки = Итератор;
		Итератор = Итератор + 1;
	КонецЦикла;
	
	Возврат ТЗМатериалы;
	
КонецФункции

&НаКлиенте
Процедура СформироватьПередачуМатериаловВКладовуюПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ЭтотОбъект.Записать();
		
	КонецЕсли;
	
	РеквизитыШапки = Новый Структура;
	РеквизитыШапки.Вставить("Организация", 					Объект.Организация);
	РеквизитыШапки.Вставить("Отправитель", 					Объект.Склад);
	РеквизитыШапки.Вставить("Получатель", 					Объект.Подразделение);
	РеквизитыШапки.Вставить("НаправлениеДеятельности", 		Объект.НаправлениеДеятельности);
	РеквизитыШапки.Вставить("ПотреблениеДляДеятельности", 	ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС"));
	РеквизитыШапки.Вставить("ХозяйственнаяОперация", 		ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаМатериаловВКладовую"));
	РеквизитыШапки.Вставить("ДокументОснование", 			Объект.Ссылка);
	
	мПараметрыФормы = Новый Структура;    	
	мПараметрыФормы.Вставить("РеквизитыШапки", 				РеквизитыШапки);
	мПараметрыФормы.Вставить("Товары", 						ПолучитьАктуальныеДанныеТЗМатериалы());
	
	ПараметрыФормы = Новый Структура;    	
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", 			мПараметрыФормы);
	
	ОткрытьФорму(
	"Документ.ДвижениеПродукцииИМатериалов.ФормаОбъекта",
	ПараметрыФормы,
	ЭтаФорма,
	,
	,
	,
	Новый ОписаниеОповещения("ОбновитьСписокДокументовРасхода", ЭтотОбъект),
	);  	 
	
КонецПроцедуры 

&НаКлиенте
Процедура СформироватьПередачуМатериаловВПроизводство()
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("СформироватьПередачуМатериаловВПроизводствоПродолжение",ЭтотОбъект),"Перед созданием передачи в производство необходимо записать текущий документ. Записать?", РежимДиалогаВопрос.ДаНет,30,КодВозвратаДиалога.Нет);
		
	Иначе
		
		СформироватьПередачуМатериаловВПроизводствоПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПередачуМатериаловВПроизводствоПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ЭтотОбъект.Записать();
		
	КонецЕсли;
	
	РеквизитыШапки = Новый Структура;
	РеквизитыШапки.Вставить("Организация", 					Объект.Организация);
	РеквизитыШапки.Вставить("Склад", 						Объект.Склад);
	РеквизитыШапки.Вставить("Подразделение", 				Объект.Подразделение);
	РеквизитыШапки.Вставить("Распоряжение", 				Объект.Ссылка);
	РеквизитыШапки.Вставить("ПередачаПоРаспоряжениям", 		Ложь);
	РеквизитыШапки.Вставить("ХозяйственнаяОперация", 		ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаВПроизводство"));
	
	мПараметрыФормы = Новый Структура;    	
	мПараметрыФормы.Вставить("РеквизитыШапки", 				РеквизитыШапки);
	мПараметрыФормы.Вставить("Товары", 						Объект.Материалы);
	
	ПараметрыФормы = Новый Структура;    	
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", 			мПараметрыФормы);
	
	ОткрытьФорму(
	"Документ.ПередачаМатериаловВПроизводство.ФормаОбъекта",
	ПараметрыФормы,
	ЭтаФорма,
	,
	,
	,
	Новый ОписаниеОповещения("ОбновитьСписокДокументовРасхода", ЭтотОбъект),
	);  	 
	
КонецПроцедуры 

&НаСервере
Процедура ДокументУтвержденияПриИзмененииНаСервере()
	НовыйВариант = Объект.ДокументУтверждения.СценарийПланирования.НовыйВариант = Истина;
	Объект.НаправлениеДеятельности = Объект.ДокументУтверждения.НаправлениеДеятельности;
КонецПроцедуры

&НаКлиенте
Процедура ДокументУтвержденияПриИзменении(Элемент)
	ДокументУтвержденияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДокументУтвержденияОчистка(Элемент, СтандартнаяОбработка)
	ДокументУтвержденияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРаботу(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьРаботуПродолжение",ЭтотОбъект);
	
	ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаВыбора",Новый структура("ДокументУтверждения",Объект.ДокументУтверждения),ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРаботуПродолжение(ВыбранноеЗначение,ДопПараметры)Экспорт
	
	СтруктураЗаполнения = ПолучитьСтруктуруЗаполненияРаботы(ВыбранноеЗначение);
	
	Если СтруктураЗаполнения.Отказ = Истина Тогда
		
		Возврат;
		
	КонецЕсли;
	
	
	Нстр = ДеревоМатериалы.ПолучитьЭлементы().Добавить();
	ЗаполнитьЗначенияСвойств(Нстр,СтруктураЗаполнения);	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруЗаполненияРаботы(ВыбранноеЗначение)
	
	СтруктураВозврата = Новый Структура("Отказ,ЭтоРабота",Истина,Истина);
	
	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) ИЛИ ВыбранноеЗначение.СуммарнаяРабота Тогда
		
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
	ДеревоМ = РеквизитФормыВЗначение("ДеревоМатериалы");
	
	Если ДеревоМ.Строки.НайтиСтроки(Новый Структура("Работа",ВыбранноеЗначение)).Количество() Тогда
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	СтруктураВозврата.Вставить("Работа",ВыбранноеЗначение);
	СтруктураВозврата.Вставить("РаботаСсылка",ВыбранноеЗначение);
	СтруктураВозврата.Вставить("ЕдиницаОбъема",ВыбранноеЗначение.ЕдиницаОбъема);
	СтруктураВозврата.Вставить("Объем",ВыбранноеЗначение.ОбъемРаботы);
	СтруктураВозврата.Отказ = Ложь;
	
	Возврат СтруктураВозврата; 	
	
КонецФункции 

#КонецОбласти