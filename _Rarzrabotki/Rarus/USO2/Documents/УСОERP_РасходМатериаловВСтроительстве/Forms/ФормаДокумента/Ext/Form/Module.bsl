&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Обработчик подсистемы "Свойства"
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
	
	ТекущийОбъект.Материалы.Очистить();
	Дерево = РеквизитФормыВЗначение("ДеревоМатериалы");
	Для Каждого Уров1 из Дерево.Строки Цикл		
		Для Каждого Уров2 из Уров1.Строки Цикл
			НовСтр = ТекущийОбъект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Уров2);
			НовСтр.Работа = Уров1.Работа;
		КонецЦикла;			
	КонецЦикла;		
	
	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);  

	//Элементы.ГруппаКомментарий.Картинка = ОбщегоНазначения.ПолучитьКартинкуКомментария(Объект.Комментарий);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("Запись_РасходМатериаловВСтроительстве", ПараметрыЗаписи, Объект.Ссылка);

	УстановитьВидимостьРеквизитов();
	
	МодификацияКонфигурацииКлиентПереопределяемый.ПослеЗаписи(ЭтаФорма, ПараметрыЗаписи);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	МодификацияКонфигурацииПереопределяемый.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	
	ОбойтиДеревоМатериаловОбновитьЗависимыеРеквизиты();
	ОбновитьЗависимыеРеквизитыНаСервере();
	НастроитьОтображениеДокументовРасхода();
	
	ЭтотОбъект.ТолькоПросмотр = ТекущийОбъект.Проведен И ТекущийОбъект.Статус = Перечисления.СтатусыПланов.Утвержден;
	Элементы.ДеревоМатериалыДобавитьРаботу.Доступность = НЕ ЭтотОбъект.ТолькоПросмотр;
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	УстановитьВидимостьРеквизитов();
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.СобственныеМатериалы") Тогда
		Объект.Партнер 		= ПредопределенноеЗначение("Справочник.Партнеры.ПустаяСсылка");
		Объект.Контрагент 	= ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		Объект.Договор 		= ПредопределенноеЗначение("Справочник.ДоговорыКонтрагентов.ПустаяСсылка");
		Объект.Соглашение 	= ПредопределенноеЗначение("Справочник.СоглашенияСПоставщиками.ПустаяСсылка");
	Иначе
		Объект.Подразделение = ПредопределенноеЗначение("Справочник.СтруктураПредприятия.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ОрганизацияПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	ОтветственныеЛицаСервер.ПриИзмененииСвязанныхРеквизитовДокумента(Объект);
КонецПроцедуры

&НаКлиенте
Процедура ПартнерПриИзменении(Элемент)
	
	ПроверитьОчиститьЗависимыеРеквизиты();
	
	Если Не ЗначениеЗаполнено(Объект.Партнер) Тогда
		Объект.Соглашение = ПредопределенноеЗначение("Справочник.СоглашенияСПоставщиками.ПустаяСсылка");
		Возврат;
	КонецЕсли;
	
	ПартнерПриИзмененииНаСервере();
	
	
КонецПроцедуры

&НаСервере
Процедура ПартнерПриИзмененииНаСервере()
	
	ДокументРасходов = РеквизитФормыВЗначение("Объект");
	ДокументРасходов.ЗаполнитьУсловияЗакупокПоУмолчанию(Ложь);
	ЗначениеВРеквизитФормы(ДокументРасходов, "Объект");
	
	УстановитьДоступностьСоглашений();
	
	ЗакупкиСервер.УстановитьДоступностьДоговора(Объект, Элементы.Договор.Доступность, Элементы.Договор.Видимость, Объект.Договор);
		
	ОтветственныеЛицаСервер.ПриИзмененииСвязанныхРеквизитовДокумента(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	КонтрагентПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	
	ЗакупкиСервер.УстановитьДоступностьДоговора(
		Объект,
		Элементы.Договор.Доступность,
		Элементы.Договор.Видимость,
		Объект.Договор);
	
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		
		ЗаполнитьДоговорПоУмолчанию();
				
	КонецЕсли;
	
		
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент) 	
		
	Если ЗначениеЗаполнено(Объект.ДатаНачала)
		И ЗначениеЗаполнено(Объект.ДатаОкончания)
		И Объект.ДатаНачала>Объект.ДатаОкончания Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата начала не может быть больше даты окончания.", Объект.Ссылка, "ДатаНачала", "Объект");
		
		ПроверитьОчиститьЗависимыеРеквизитыПродолжение(КодВозвратаДиалога.Нет,Новый Структура); 

	КонецЕсли;
	
	ПроверитьОчиститьЗависимыеРеквизиты();

КонецПроцедуры

&НаКлиенте
Процедура ОбъектСтроительстваПриИзменении(Элемент)
	
	ПроверитьОчиститьЗависимыеРеквизиты();
	
	ОбновитьЗависимыеРеквизитыНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	ПроверитьОчиститьЗависимыеРеквизиты();
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)
	
	Объект.ДатаОкончания = КонецДня(Объект.ДатаОкончания);
	
	Если ЗначениеЗаполнено(Объект.ДатаНачала)
		И ЗначениеЗаполнено(Объект.ДатаОкончания)
		И Объект.ДатаНачала>Объект.ДатаОкончания Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата окончания не может быть меньше даты начала.", Объект.Ссылка, "ДатаОкончания", "Объект");
		
		ПроверитьОчиститьЗависимыеРеквизитыПродолжение(КодВозвратаДиалога.Нет,Новый Структура); 

	КонецЕсли;
	
	ПроверитьОчиститьЗависимыеРеквизиты();

КонецПроцедуры

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	Если ПоказыватьМатериалыСводно Тогда
		ОбновитьСводныеДанныеПоМатериалам();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоМатериалы

&НаКлиенте
Процедура ДеревоМатериалыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ДеревоМатериалы.ТекущиеДанные;
	Если ТекущаяСтрока.ЭтоРабота
		И Поле.Имя = "ДеревоМатериалыРабота" тогда
		ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.ФормаОбъекта", Новый Структура("Ключ", ТекущаяСтрока.Работа));
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМатериалыПриАктивизацииЯчейки(Элемент)
	
	Если Элемент.ТекущиеДанные = Неопределено
		Или Элемент.ТекущийЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.ТекущийЭлемент.Имя = "ДеревоМатериалыНоменклатура"
		ИЛИ Элемент.ТекущийЭлемент.Имя = "ДеревоМатериалыХарактеристика" 
		ИЛИ Элемент.ТекущийЭлемент.Имя = "ДеревоМатериалыУпаковка" 
		ИЛИ Элемент.ТекущийЭлемент.Имя = "ДеревоМатериалыКоличествоУпаковок" Тогда
		Если Элемент.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
			Элемент.ТекущийЭлемент.ТолькоПросмотр = Истина;
		Иначе
			Элемент.ТекущийЭлемент.ТолькоПросмотр = Ложь;
		КонецЕсли;
	ИначеЕсли Элемент.ТекущийЭлемент.Имя = "ДеревоМатериалыРабота" 
		ИЛИ Элемент.ТекущийЭлемент.Имя = "ДеревоМатериалыОбъем" 
		ИЛИ Элемент.ТекущийЭлемент.Имя = "ДеревоМатериалыЕдиницаОбъема" Тогда   		
			Элемент.ТекущийЭлемент.ТолькоПросмотр = Истина;
	КонецЕсли;

КонецПроцедуры

