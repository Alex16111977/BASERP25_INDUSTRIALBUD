&НаКлиенте
Процедура ПодборМатериалов(Команда)
	
	ТекущаяСтрока = Элементы.ДеревоМатериалы.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Подбор материалов доступен только для определенной работы из табличной части.");
		Возврат;
	КонецЕсли;
	
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НачалоПериода",		Объект.ДатаНачала);
	ПараметрыФормы.Вставить("КонецПериода", 		Объект.ДатаОкончания);
	ПараметрыФормы.Вставить("Организация", 			Объект.Организация);
	ПараметрыФормы.Вставить("Подразделение", 		Объект.Подразделение);
	ПараметрыФормы.Вставить("Склад", 				Объект.Склад);
	ПараметрыФормы.Вставить("Партнер", 				Объект.Партнер);
	ПараметрыФормы.Вставить("Контрагент", 			Объект.Контрагент);
	ПараметрыФормы.Вставить("Договор", 				Объект.Договор);
	ПараметрыФормы.Вставить("Соглашение", 			Объект.Соглашение);
	ПараметрыФормы.Вставить("ВидОперации", 			Объект.ВидОперации);
	ПараметрыФормы.Вставить("ОбъектСтроительства",	Объект.ОбъектСтроительства);
	
	Отказ = Ложь;
	ТекстСообщенияОшибки = "";
	ДополнитьПараметрыДляФормыПодбораНаСервере(ПараметрыФормы, ТекущаяСтрока.ПолучитьИдентификатор(), Отказ, ТекстСообщенияОшибки);
	
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщенияОшибки);
		Возврат;
	КонецЕсли;
	ПараметрыВыбранныхМатериалов = Новый Структура;
	ОткрытьФорму("Документ.УСОERP_РасходМатериаловВСтроительстве.Форма.ФормаПодбораМатериалов", ПараметрыФормы,,,,,Новый ОписаниеОповещения("ДобавитьВыбранныеМатериалыКРаботе", ЭтотОбъект,ПараметрыВыбранныхМатериалов),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
		
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериод(Команда)
	
	ПараметрыОткрытия 	= Новый Структура("НачалоПериода, КонецПериода", Объект.ДатаНачала, Объект.ДатаОкончания);
	ОписаниеОповещения 	= Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериода", ПараметрыОткрытия, Элементы.ВыбратьПериод, , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект.ДатаНачала = РезультатВыбора.НачалоПериода;
	Объект.ДатаОкончания = КонецДня(РезультатВыбора.КонецПериода);
	
	ПроверитьОчиститьЗависимыеРеквизиты();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьМатериал(Команда)
	
	ТекущиеДанные = Элементы.ДеревоМатериалы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ТекущийРодитель = ТекущиеДанные.ПолучитьРодителя();
	Если ТекущийРодитель = Неопределено Тогда
		ТекущийРодитель = ТекущиеДанные;
	КонецЕсли;

	Если ТекущийРодитель = Неопределено ИЛИ Не ЗначениеЗаполнено(ТекущийРодитель.Работа) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Для того, чтобы выбрать материал необходимо предварительно заполнить работу.'"),Объект.Ссылка, "ДеревоМатериалыРаботаНоменклатура", "Объект");
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = ТекущийРодитель.ПолучитьЭлементы().Добавить();
	Элементы.ДеревоМатериалы.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	Элементы.ДеревоМатериалы.ТекущийЭлемент =  Элементы.ДеревоМатериалыРаботаНоменклатура;
	
	ОбновитьРаботуВНовойСтрокеМатериалов(НоваяСтрока.ПолучитьИдентификатор());
	
	НоваяСтрока.РаботаСсылка = НоваяСтрока.Работа;
	
	ОбновитьСводныеДанныеПоМатериалам();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаботыИМатериалы(Команда)
	
	ЗаполнениеВозможно = Истина;
	Если Не ЗначениеЗаполнено(Объект.ОбъектСтроительства) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед заполнением необходимо указать объект строительства.", Объект.Ссылка, "ОбъектСтроительства", "Объект");
		ЗаполнениеВозможно = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед заполнением необходимо указать период (не заполнена дата начала).", Объект.Ссылка, "ДатаНачала", "Объект");
		ЗаполнениеВозможно = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед заполнением необходимо указать период (не заполнена дата окончания).", Объект.Ссылка, "ДатаОкончания", "Объект");
		ЗаполнениеВозможно = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ВидОперации) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед заполнением необходимо указать вид операции.", Объект.Ссылка, "ВидОперации", "Объект");
		ЗаполнениеВозможно = Ложь; 
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Склад) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед заполнением необходимо указать склад.", Объект.Ссылка, "Склад", "Объект");
		ЗаполнениеВозможно = Ложь; 
	КонецЕсли;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.МатериалыПереданныеСубподрядчику") Тогда
		Если Не ЗначениеЗаполнено(Объект.Партнер) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед заполнением необходимо указать субподрядчика.", Объект.Ссылка, "Партнер", "Объект");
			ЗаполнениеВозможно = Ложь; 
		КонецЕсли;	
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.СобственныеМатериалы") Тогда
		Если Не ЗначениеЗаполнено(Объект.Подразделение) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед заполнением необходимо указать подразделение.", Объект.Ссылка, "Подразделение", "Объект");
			ЗаполнениеВозможно = Ложь; 
		КонецЕсли;	
	КонецЕсли;

	Если Не ЗаполнениеВозможно Тогда
		Возврат;
	КонецЕсли;
	
	Если ДеревоМатериалы.ПолучитьЭлементы().Количество()>0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьРаботыИМатериалыЗавершение", ЭтотОбъект), "Перед заполнением табличная часть будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет, 30, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьРаботыИМатериалыЗавершение(КодВозвратаДиалога.Да,Новый Структура);
	КонецЕсли; 	
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаботыИМатериалыЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьРаботыИМатериалыНаСервере();

	Если ПоказыватьМатериалыСводно Тогда
		ОбновитьСводныеДанныеПоМатериалам();
	КонецЕсли;
	
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура РазбитьСтроку(Команда)
	
	ТекущаяСтрока = Элементы.ДеревоМатериалы.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	Конецесли;
	
	ТекущийРодитель =  ТекущаяСтрока.ПолучитьРодителя();
	Если ТекущийРодитель = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Разбить можно только строку материала.");
		Возврат;
	КонецЕсли;
	
	ТаблицаФормы  = Элементы.ДеревоМатериалы;
	ДанныеТаблицы = ТекущийРодитель.ПолучитьЭлементы();
	
	Оповещение = Новый ОписаниеОповещения("РазбитьСтрокуЗавершение", ЭтотОбъект);
	ОбщегоНазначенияУТКлиент.РазбитьСтрокуТЧ(ДанныеТаблицы, ТаблицаФормы, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура РазбитьСтрокуЗавершение(НоваяСтрока, ДополнительныеПараметры) Экспорт 
	
	ТекущаяСтрока = Элементы.ДеревоМатериалы.ТекущиеДанные;
	
	Если НоваяСтрока <> Неопределено Тогда
			
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц",    			ТекущаяСтрока.Упаковка); 	
		СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
			ЭтаФорма.ИмяФормы, "ДеревоМатериалы"));

		ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц",    			НоваяСтрока.Упаковка); 	
		СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
			ЭтаФорма.ИмяФормы, "ДеревоМатериалы"));

		ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьМатериалыСводно(Команда)
	
	ПоказыватьМатериалыСводно = Не ПоказыватьМатериалыСводно;
	Элементы.ГруппаМатериалыСводно.Видимость = ПоказыватьМатериалыСводно;
	
	Если ПоказыватьМатериалыСводно Тогда
		ОбновитьСводныеДанныеПоМатериалам();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СформироватьВнутреннееПотребление()
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("СформироватьВнутреннееПотреблениеПродолжение",ЭтотОбъект),"Перед созданием передачи в производство необходимо записать текущий документ. Записать?", РежимДиалогаВопрос.ДаНет,30,КодВозвратаДиалога.Нет);
		
	Иначе
		
		СформироватьВнутреннееПотреблениеПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьВнутреннееПотреблениеПродолжение(Ответ,ДопПараметры)Экспорт
	
	Если Ответ<>КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЭтотОбъект.Записать();
	КонецЕсли;
	
	ФормаДокумента = ПолучитьФорму("Документ.ВнутреннееПотреблениеТоваров.Форма.ФормаДокумента");	
	ДанныеФормы = ФормаДокумента.Объект;
	ЗаполнитьТаблицуМатериаловДляВП(ДанныеФормы);	
	
	РеквизитыШапки = Новый Структура;
	РеквизитыШапки.Вставить("ДокументОснование"       ,Объект.Ссылка);
	РеквизитыШапки.Вставить("ЗаказНаВнутреннееПотребление"       ,Объект.Ссылка);
	РеквизитыШапки.Вставить("Организация"             ,Объект.Организация);
	РеквизитыШапки.Вставить("Склад"                   ,Объект.Склад);
	РеквизитыШапки.Вставить("Подразделение"           ,Объект.Подразделение);
	РеквизитыШапки.Вставить("НаправлениеДеятельности" ,Объект.НаправлениеДеятельности); 
				
	мПараметрыФормы = Новый Структура;
	мПараметрыФормы.Вставить("РеквизитыШапки", 				РеквизитыШапки);
	мПараметрыФормы.Вставить("Товары",						ДанныеФормы.Товары);

	ПараметрыФормы = Новый Структура;    	
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", 			мПараметрыФормы);
	
	ОткрытьФорму(
	"Документ.ВнутреннееПотреблениеТоваров.ФормаОбъекта",
	ПараметрыФормы,
	ЭтаФорма,
	,
	,
	,
	Новый ОписаниеОповещения("ОбновитьСписокДокументовРасхода", ЭтотОбъект),
	);   		
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьТаблицуМатериаловДляВП(ДанныеФормы)
	
	ТабМатериалов = Объект.Материалы.Выгрузить();
	
	ТабМатериалов.Колонки.Добавить("СтатьяРасходов");
	ТабМатериалов.Колонки.Добавить("АналитикаРасходов");
	
	Для Каждого ТекущаяСтрока ИЗ ТабМатериалов Цикл
		
		СтатьяАналитика = ДоходыИРасходыСервер.СтатьяАналитикаРасходовПоУмолчанию(
		Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию,
		Объект.Организация,
		Объект.Подразделение,
		ТекущаяСтрока.Номенклатура);
		
		Если СтатьяАналитика.Следующий() Тогда
			ТекущаяСтрока.СтатьяРасходов		= СтатьяАналитика.СтатьяРасходов;
			ТекущаяСтрока.АналитикаРасходов	= СтатьяАналитика.АналитикаРасходов;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ДанныеФормы.Товары.Добавить(),ТекущаяСТрока);
		
	КонецЦикла;  		
	
КонецПроцедуры 

#КонецОбласти


#Область РаботаСБуферомОбмена

&НаСервере
Процедура СкопироватьСтрокиНаСервере()
	
	КопируемыеТовары = Новый ТаблицаЗначений;
	МассивТипов = Новый Массив;
	МассивТипов.Добавить( Тип("СправочникСсылка.Номенклатура"));
	МассивТипов.Добавить( Тип("СправочникСсылка.УСОERP_СтроительныеРаботы"));
	КопируемыеТовары.Колонки.Добавить("РаботаМатериал",           Новый ОписаниеТипов(, МассивТипов));
	КопируемыеТовары.Колонки.Добавить("Характеристика",         Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	КопируемыеТовары.Колонки.Добавить("Упаковка",               Новый ОписаниеТипов("СправочникСсылка.УпаковкиНоменклатуры"));
	
	Для Каждого ТекСтрока Из Элементы.ДеревоМатериалы.ВыделенныеСтроки Цикл
		
		ТекЭлементНоменклатура = ДеревоМатериалы.НайтиПоИдентификатору(ТекСтрока);
		
		ПоместитьСтрокуВТабличнуюЧасть(КопируемыеТовары, ТекЭлементНоменклатура);
		
	КонецЦикла;
	
	КопированиеСтрокСервер.ПоместитьВыделенныеСтрокиВБуферОбмена(, КопируемыеТовары);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтрокиИзБуфераОбмена(ЗаполняемыйВидЦен)
	
	ТаблицаТоваров = КопированиеСтрокСервер.ПолучитьСтрокиИзБуфераОбмена();
	
	ДанныеДляРасчетаВычисляемыхЦенНаКлиенте = УстановкаЦенСервер.ДобавитьТоварыПоОтбору(ЭтаФорма,,ТаблицаТоваров, ЗаполняемыйВидЦен);
	
	Возврат ДанныеДляРасчетаВычисляемыхЦенНаКлиенте;
	
КонецФункции

&НаСервере
Процедура УстановитьДоступностьКомандБуфераОбмена()
	
	МассивЭлементов = Новый Массив();
	МассивЭлементов.Добавить("ТоварыВставитьСтроки");
	МассивЭлементов.Добавить("ТоварыКонтекстноеМенюВставитьСтроки");
	
	Если ПравоДоступа("СохранениеДанныхПользователя", Метаданные) Тогда
		
		ОбщегоНазначенияУТКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Доступность", НЕ ОбщегоНазначения.ПустойБуферОбмена());
		
	Иначе
		
		МассивЭлементов.Добавить("ТоварыСкопироватьСтроки");
		МассивЭлементов.Добавить("ТоварыКонтекстноеМенюСкопироватьСтроки");
		
		ОбщегоНазначенияУТКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Видимость", Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКомандБуфераОбменаНаКлиенте()
	
	МассивЭлементов = Новый Массив();
	МассивЭлементов.Добавить("ТоварыВставитьСтроки");
	МассивЭлементов.Добавить("ТоварыКонтекстноеМенюВставитьСтроки");
	
	ОбщегоНазначенияУТКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Доступность", Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьСтрокуВТабличнуюЧасть(ПомещаемыеТовары, СтрокаЦен) Экспорт
	
	НоваяСтрока                = ПомещаемыеТовары.Добавить();
	НоваяСтрока.Номенклатура   = СтрокаЦен.Номенклатура;
	НоваяСтрока.Характеристика = СтрокаЦен.Характеристика;
	
	Если ИспользоватьУпаковкиНоменклатуры Тогда
		ИмяКолонки = "Упаковка" + ИмяКолонки;
		Если СтрокаЦен.Свойство(ИмяКолонки) Тогда
			НоваяСтрока.Упаковка = СтрокаЦен[ИмяКолонки];
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

