
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Номенклатура = Параметры.Номенклатура;
	ЭтаФорма.Характеристика = Параметры.Характеристика;
	ЭтаФорма.Количество = Параметры.КоличествоОстаток;
	ЭтаФорма.ХарактеристикиИспользуются = Параметры.ХарактеристикиИспользуются;
	
	ЭтаФорма.Заголовок = СокрЛП(Номенклатура) + ?(ХарактеристикиИспользуются, ", " + СокрЛП(Характеристика), "");
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменаВыбора(Команда)
	
	ПараметрыЗакрытия = Новый Структура;
	ПараметрыЗакрытия.Вставить("ПереноситьВДокумент", ложь);
	ЭтаФорма.Закрыть(ПараметрыЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ПараметрыЗакрытия = Новый Структура;
	ПараметрыЗакрытия.Вставить("ПереноситьВДокумент", Истина);
	ПараметрыЗакрытия.Вставить("Номенклатура", Номенклатура);
	ПараметрыЗакрытия.Вставить("Характеристика", Характеристика);
	ПараметрыЗакрытия.Вставить("Количество", Количество);
	ПараметрыЗакрытия.Вставить("ХарактеристикиИспользуются", ХарактеристикиИспользуются);
	ЭтаФорма.Закрыть(ПараметрыЗакрытия);

КонецПроцедуры
