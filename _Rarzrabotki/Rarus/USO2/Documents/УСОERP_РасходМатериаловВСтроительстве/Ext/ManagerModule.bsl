#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстыЗапроса.Добавить(ТекстЗапросаТаблицаРасходМатериалов(),	"ТаблицаРасходМатериаловВСтроительстве");

	Запрос.Текст = "";
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		Запрос.Текст = Запрос.Текст + ТекстЗапроса.Значение;
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////
	// Выполним запрос
	
	Результат = Запрос.ВыполнитьПакет();
	
	////////////////////////////////////////////////////////////////////////////
	// Поместим результаты запроса в дополнительные свойства
	
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		ИмяТаблицы = ТекстЗапроса.Представление;
		Если Не ПустаяСтрока(ИмяТаблицы) Тогда
			Индекс = ТекстыЗапроса.Индекс(ТекстЗапроса);
			ДополнительныеСвойства.ТаблицыДляДвижений.Вставить(ИмяТаблицы, Результат[Индекс].Выгрузить());
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_РасходМатериаловВСтроительстве.Ссылка,
	|	УСОERP_РасходМатериаловВСтроительстве.Дата КАК Период,
	|	УСОERP_РасходМатериаловВСтроительстве.Организация,
	|	УСОERP_РасходМатериаловВСтроительстве.ОбъектСтроительства,
	|	УСОERP_РасходМатериаловВСтроительстве.Партнер КАК Поставщик,
	|	ВЫБОР
	|		КОГДА УСОERP_РасходМатериаловВСтроительстве.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.МатериалыПереданныеСубподрядчику)
	|			ТОГДА УСОERP_РасходМатериаловВСтроительстве.Контрагент
	|		ИНАЧЕ УСОERP_РасходМатериаловВСтроительстве.Подразделение
	|	КОНЕЦ КАК Исполнитель,
	|	УСОERP_РасходМатериаловВСтроительстве.Соглашение,
	|	УСОERP_РасходМатериаловВСтроительстве.Договор КАК Договор
	|ИЗ
	|	Документ.УСОERP_РасходМатериаловВСтроительстве КАК УСОERP_РасходМатериаловВСтроительстве
	|ГДЕ
	|	УСОERP_РасходМатериаловВСтроительстве.Ссылка = &Ссылка";
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	//
	Запрос.УстановитьПараметр("ОбъектСтроительства",	Реквизиты.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Период",      			Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация", 			Реквизиты.Организация);
	Запрос.УстановитьПараметр("Поставщик",	 			Реквизиты.Поставщик);
	Запрос.УстановитьПараметр("Соглашение",	 			Реквизиты.Соглашение);
	Запрос.УстановитьПараметр("Исполнитель", 			Реквизиты.Исполнитель);
	Запрос.УстановитьПараметр("Договор",	 			Реквизиты.Договор);
	
КонецПроцедуры

Функция ТекстЗапросаТаблицаРасходМатериалов()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.Ссылка КАК Регистратор,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.Дата КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.Организация КАК Организация,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.Склад КАК Склад,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.ОбъектСтроительства КАК ОбъектСтроительства,
	|	ВЫБОР
	|		КОГДА УСОERP_РасходМатериаловВСтроительствеМатериалы.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|			ТОГДА УСОERP_РасходМатериаловВСтроительствеМатериалы.Работа
	|		ИНАЧЕ УСОERP_РасходМатериаловВСтроительствеМатериалы.Работа.РаботаИсточник
	|	КОНЕЦ КАК Работа,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Номенклатура КАК Номенклатура,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Характеристика КАК Характеристика,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.Партнер КАК Партнер,
	|	ВЫБОР
	|		КОГДА УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.МатериалыПереданныеСубподрядчику)
	|			ТОГДА УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.Контрагент
	|		ИНАЧЕ УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.Подразделение
	|	КОНЕЦ КАК Исполнитель,
	|	СУММА(УСОERP_РасходМатериаловВСтроительствеМатериалы.Количество) КАК Количество,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.ДатаНачала КАК ДатаНачала,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.ДатаОкончания КАК ДатаОкончания,
	|	СУММА(УСОERP_РасходМатериаловВСтроительствеМатериалы.Объем) КАК Объем
	|ИЗ
	|	Документ.УСОERP_РасходМатериаловВСтроительстве.Материалы КАК УСОERP_РасходМатериаловВСтроительствеМатериалы
	|ГДЕ
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Номенклатура,
	|	ВЫБОР
	|		КОГДА УСОERP_РасходМатериаловВСтроительствеМатериалы.Работа.РаботаИсточник = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
	|			ТОГДА УСОERP_РасходМатериаловВСтроительствеМатериалы.Работа
	|		ИНАЧЕ УСОERP_РасходМатериаловВСтроительствеМатериалы.Работа.РаботаИсточник
	|	КОНЕЦ,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.Ссылка,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Характеристика,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.Дата,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.Организация,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.Склад,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.ОбъектСтроительства,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.Партнер,
	|	ВЫБОР
	|		КОГДА УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыОперацийРасходаМатериаловВСтроительстве.МатериалыПереданныеСубподрядчику)
	|			ТОГДА УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.Контрагент
	|		ИНАЧЕ УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.Подразделение
	|	КОНЕЦ,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.ДатаНачала,
	|	УСОERP_РасходМатериаловВСтроительствеМатериалы.Ссылка.ДатаОкончания	
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";

				   
	Возврат ТекстЗапроса;
	
КонецФункции

