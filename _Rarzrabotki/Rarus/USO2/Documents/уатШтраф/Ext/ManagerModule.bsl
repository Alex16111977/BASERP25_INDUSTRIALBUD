		//	КонецЕсли;		
		//	Обл.Параметры.РуководительФИО = мРезультат;
		//	
		//КонецЕсли;
		
		мДолжность = "";
		мФИО = "";
		
		Если ЗначениеЗаполнено(ТекущийДокумент.Водитель.ФизическоеЛицо) Тогда
			
			мЗапрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
			                       |	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо,
			                       |	ТекущиеКадровыеДанныеСотрудников.ТекущаяДолжность
			                       |ПОМЕСТИТЬ ВТ_Физлицо
			                       |ИЗ
			                       |	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
			                       |ГДЕ
			                       |	ТекущиеКадровыеДанныеСотрудников.Сотрудник = &Сотрудник
			                       |	И ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо = &ФизическоеЛицо
			                       |;
			                       |
			                       |////////////////////////////////////////////////////////////////////////////////
			                       |ВЫБРАТЬ РАЗРЕШЕННЫЕ
			                       |	ВТ_Физлицо.ФизическоеЛицо.Наименование КАК Наименование,
			                       |	ВТ_Физлицо.ФизическоеЛицо.Пол КАК Пол,
			                       |	ФИОФизическихЛицСрезПоследних.Фамилия,
			                       |	ФИОФизическихЛицСрезПоследних.Имя,
			                       |	ФИОФизическихЛицСрезПоследних.Отчество,
			                       |	ВТ_Физлицо.ТекущаяДолжность КАК ТекущаяДолжность
			                       |ИЗ
			                       |	ВТ_Физлицо КАК ВТ_Физлицо
			                       |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц.СрезПоследних(&ДатаСреза, ) КАК ФИОФизическихЛицСрезПоследних
			                       |		ПО ВТ_Физлицо.ФизическоеЛицо = ФИОФизическихЛицСрезПоследних.ФизическоеЛицо");
			
			мЗапрос.УстановитьПараметр("ДатаСреза", ТекущийДокумент.Дата);
			мЗапрос.УстановитьПараметр("Сотрудник", ТекущийДокумент.Водитель);
			мЗапрос.УстановитьПараметр("ФизическоеЛицо", ТекущийДокумент.Водитель.ФизическоеЛицо);
			мВыборка = мЗапрос.Выполнить().Выбрать();
			
			Если мВыборка.Следующий() Тогда
				
				Если мВыборка.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
					мПол = 1;
				ИначеЕсли мВыборка.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
					мПол = 2;
				Иначе
					мПол = Неопределено;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(мВыборка.Фамилия) Тогда
					ФИОПолные = мВыборка.Фамилия + " " + мВыборка.Имя + " " + мВыборка.Отчество;
					ОбщегоНазначения.Просклонять(СокрЛП(ФИОПолные), 2, мФИО, мПол);	
				Иначе
					ОбщегоНазначения.Просклонять(СокрЛП(мВыборка.Наименование), 2, мФИО, мПол);		
				КонецЕсли;
				
				мДолжность = СокрЛП(мВыборка.ТекущаяДолжность);
				Если ЗначениеЗаполнено(мДолжность) Тогда
					ОбщегоНазначения.Просклонять(мДолжность, 2, мДолжность, 1);
				КонецЕсли;
				//мДолжность = мВыборка.ТекущаяДолжность.ДолжностьРодительныйПадежь;
			Иначе
				
				мЗапрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ТекущиеКадровыеДанныеСотрудников.Сотрудник.Наименование КАК Наименование,
				|	ТекущиеКадровыеДанныеСотрудников.ТекущаяДолжность КАК ТекущаяДолжность
				|ИЗ
				|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
				|ГДЕ
				|	ТекущиеКадровыеДанныеСотрудников.Сотрудник = &Сотрудник");
				
				мЗапрос.УстановитьПараметр("Сотрудник", ТекущийДокумент.Водитель);
				мВыборка = мЗапрос.Выполнить().Выбрать();
				
				Если мВыборка.Следующий() Тогда
					ОбщегоНазначения.Просклонять(СокрЛП(мВыборка.Наименование), 2, мФИО, Неопределено);
					
					мДолжность = СокрЛП(мВыборка.ТекущаяДолжность);
					Если ЗначениеЗаполнено(мДолжность) Тогда
						ОбщегоНазначения.Просклонять(мДолжность, 2, мДолжность, 1);
					КонецЕсли;
					//мДолжность = мВыборка.ТекущаяДолжность.ДолжностьРодительныйПадежь;
								
				Иначе
					ОбщегоНазначения.Просклонять(СокрЛП(ТекущийДокумент.Водитель.Наименование), 2, мФИО, Неопределено);
				КонецЕсли;
				
			КонецЕсли;
			
			
		Иначе
			
			мЗапрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
			                       |	ТекущиеКадровыеДанныеСотрудников.Сотрудник.Наименование КАК Наименование,
			                       |	ТекущиеКадровыеДанныеСотрудников.ТекущаяДолжность КАК ТекущаяДолжность
			                       |ИЗ
			                       |	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
			                       |ГДЕ
			                       |	ТекущиеКадровыеДанныеСотрудников.Сотрудник = &Сотрудник");
			
			мЗапрос.УстановитьПараметр("Сотрудник", ТекущийДокумент.Водитель);
			мВыборка = мЗапрос.Выполнить().Выбрать();
			
			Если мВыборка.Следующий() Тогда
				ОбщегоНазначения.Просклонять(СокрЛП(мВыборка.Наименование), 2, мФИО, Неопределено);
				
				мДолжность = СокрЛП(мВыборка.ТекущаяДолжность);
				Если ЗначениеЗаполнено(мДолжность) Тогда
					ОбщегоНазначения.Просклонять(мДолжность, 2, мДолжность, Неопределено);
				КонецЕсли;
				//мДолжность = мВыборка.ТекущаяДолжность.ДолжностьРодительныйПадежь;
				
				
			Иначе
				ОбщегоНазначения.Просклонять(СокрЛП(ТекущийДокумент.Водитель.Наименование), 2, мФИО, Неопределено);
			КонецЕсли;
				
		КонецЕсли;
		
		Обл.Параметры.ВодительФИО = мФИО;
		Обл.Параметры.ВодительДолжность = НРег(мДолжность);
		
		   
		ТабличныйДокумент.Вывести(Обл);
				
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ТекущийДокумент);
		
	КонецЦикла;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабличныйДокумент;
	
КонецФункции // ПечатнаяФорма()

