		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа,
	ЕСТЬNULL(УСОERP_УчетВыполненныхРаботОбороты.ОбъемОборот, 0) КАК ВыполненоРабот,
	УСОERP_УчетВыполненныхРаботОбороты.Регистратор,
	0 КАК РеализованоРабот
ИЗ
	РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(
			{(&amp;Период)},
			Утверждена
				И НЕ Работа.СуммарнаяРабота
				И ВидПланирования = &amp;ВидПланирования
				И Работа.Владелец.Владелец = &amp;ОбъектСтроительства
				И Работа.Владелец.ВидСценария = &amp;Рабочий) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УСОERP_УчетВыполненныхРабот.Обороты(
				,
				{(&amp;КонецПериода)},
				Регистратор,
				ОбъектСтроительства = &amp;ОбъектСтроительства
					И Организация = &amp;Организация
					И НЕ Работа.СуммарнаяРабота) КАК УСОERP_УчетВыполненныхРаботОбороты
		ПО УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа = УСОERP_УчетВыполненныхРаботОбороты.Работа
ГДЕ
	ЕСТЬNULL(УСОERP_УчетВыполненныхРаботОбороты.ОбъемОборот, 0) &lt;&gt; 0

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа,
	0,
	УСОERP_ВыполнениеРаботЗаказчикаОбороты.Регистратор,
	ЕСТЬNULL(УСОERP_ВыполнениеРаботЗаказчикаОбороты.ОбъемРасход, 0)
ИЗ
	РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(
			{(&amp;Период)},
			Утверждена
				И НЕ Работа.СуммарнаяРабота
				И ВидПланирования = &amp;ВидПланирования
				И Работа.Владелец.Владелец = &amp;ОбъектСтроительства
				И Работа.Владелец.ВидСценария = &amp;Рабочий) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УСОERP_ВыполнениеРаботЗаказчика.Обороты(
				,
				{(&amp;КонецПериода)},
				Регистратор,
				ОбъектСтроительства = &amp;ОбъектСтроительства
					И Организация = &amp;Организация
					И НЕ Работа.СуммарнаяРабота) КАК УСОERP_ВыполнениеРаботЗаказчикаОбороты
		ПО УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа = УСОERP_ВыполнениеРаботЗаказчикаОбороты.Работа
ГДЕ
	ЕСТЬNULL(УСОERP_ВыполнениеРаботЗаказчикаОбороты.ОбъемОборот, 0) &lt;&gt; 0</query>
