		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ПараметрыРабот.Работа,
	ЕСТЬNULL(УчетВыполненныхРабот.ОбъемОборот, 0) КАК ВыполненоРабот,
	0 КАК РеализованоРабот
ПОМЕСТИТЬ ВТ_Работы
ИЗ
	РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(
			{(&amp;Период)},
			Утверждена
				И НЕ Работа.СуммарнаяРабота
				И ВидПланирования = &amp;ВидПланирования
				И Работа.Владелец.Владелец = &amp;ОбъектСтроительства
				И Работа.Владелец.ВидСценария = &amp;Рабочий) КАК ПараметрыРабот
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УСОERP_УчетВыполненныхРабот.Обороты(
				,
				{(&amp;КонецПериода)},
				,
				ОбъектСтроительства = &amp;ОбъектСтроительства
					И Организация = &amp;Организация
					И НЕ Работа.СуммарнаяРабота) КАК УчетВыполненныхРабот
		ПО ПараметрыРабот.Работа = УчетВыполненныхРабот.Работа
ГДЕ
	ЕСТЬNULL(УчетВыполненныхРабот.ОбъемОборот, 0) &lt;&gt; 0

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ПараметрыРабот.Работа,
	0,
	ЕСТЬNULL(ВыполнениеРаботЗаказчика.ОбъемРасход, 0)
ИЗ
	РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(
			{(&amp;Период)},
			Утверждена
				И НЕ Работа.СуммарнаяРабота
				И ВидПланирования = &amp;ВидПланирования
				И Работа.Владелец.Владелец = &amp;ОбъектСтроительства
				И Работа.Владелец.ВидСценария = &amp;Рабочий) КАК ПараметрыРабот
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УСОERP_ВыполнениеРаботЗаказчика.Обороты(
				,
				{(&amp;КонецПериода)},
				,
				ОбъектСтроительства = &amp;ОбъектСтроительства
					И Организация = &amp;Организация
					И НЕ Работа.СуммарнаяРабота) КАК ВыполнениеРаботЗаказчика
		ПО ПараметрыРабот.Работа = ВыполнениеРаботЗаказчика.Работа
ГДЕ
	ЕСТЬNULL(ВыполнениеРаботЗаказчика.ОбъемОборот, 0) &lt;&gt; 0
;

