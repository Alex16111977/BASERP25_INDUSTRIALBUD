#Область ОбработчикиСобытий

&НаСервере
Процедура СформироватьНаСервере()
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Использовать",Истина);
	МассивЛимЗатрат = ЛимитированныеЗатраты.Выгрузить(ПараметрыОтбора).ВыгрузитьКолонку("ЛимитированнаяЗатрата");
	
	СписокЛимЗатратНДС = Новый СписокЗначений();
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Использовать",Истина);
	ПараметрыОтбора.Вставить("НДС",Истина);
	СписокЛимЗатратНДС.ЗагрузитьЗначения(ЛимитированныеЗатраты.Выгрузить(ПараметрыОтбора).ВыгрузитьКолонку("ЛимитированнаяЗатрата"));
	СписокЛимЗатратНДС.Добавить(ЛимЗатратаНДС);
	
	Результат.Очистить();
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	ОтчетОбъект.ПолучитьЗаполненныйОтчет(Период,Результат, Смета, СписокЛимЗатратНДС, МассивЛимЗатрат);
	Результат.АвтоМасштаб = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ГлобальнаяСтрокаДереваСмет = Неопределено И Не ГлобальнаяСтрокаДереваСмет.ПометкаУдаления Тогда
		Смета = ГлобальнаяСтрокаДереваСмет.Ссылка;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Период.ДатаНачала) ИЛИ Не ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		Период.Вариант = ВариантСтандартногоПериода.ЭтотМесяц;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЛимЗатратаНДС) Тогда
		ЗаполнитьЛимЗатратуНДСНаСервере();
	КонецЕсли;
	
	Если ЛимитированныеЗатраты.Количество()=0 Тогда
		ОбновитьТаблицуЛимЗатрат();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЛимЗатратуНДСНаСервере()
	
	ЛимЗатратаНДС = Справочники.СМ_ЛимитированныеЗатраты.НайтиПоРеквизиту("Идентификатор","ЛЗ64");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуЛимЗатрат()
	
	Если Не ЗначениеЗаполнено(Смета) Тогда
		ЛимитированныеЗатраты.Очистить();
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	СМ_АктВыполненныхРаботЛимитированныеЗатраты.ЛимитированнаяЗатрата,
		               |	СМ_АктВыполненныхРаботЛимитированныеЗатраты.ЛимитированнаяЗатрата.НомерПоПорядку КАК ЛимитированнаяЗатратаНомерПоПорядку
		               |ИЗ
		               |	Документ.СМ_АктВыполненныхРабот.ЛимитированныеЗатраты КАК СМ_АктВыполненныхРаботЛимитированныеЗатраты
		               |ГДЕ
		               |	СМ_АктВыполненныхРаботЛимитированныеЗатраты.Ссылка.ЛокальнаяСмета = &Смета
		               |	И СМ_АктВыполненныхРаботЛимитированныеЗатраты.Ссылка.ПометкаУдаления = ЛОЖЬ
		               |	И СМ_АктВыполненныхРаботЛимитированныеЗатраты.ЛимитированнаяЗатрата.ПометкаУдаления = ЛОЖЬ
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ЛимитированнаяЗатратаНомерПоПорядку";
	ИначеЕсли ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	СМ_АктВыполненныхРаботЛимитированныеЗатраты.ЛимитированнаяЗатрата,
		               |	СМ_АктВыполненныхРаботЛимитированныеЗатраты.ЛимитированнаяЗатрата.НомерПоПорядку КАК ЛимитированнаяЗатратаНомерПоПорядку
		               |ИЗ
		               |	Документ.СМ_ОбъектнаяСмета.ЛокальныеСметы КАК СМ_ОбъектнаяСметаЛокальныеСметы
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СМ_АктВыполненныхРабот.ЛимитированныеЗатраты КАК СМ_АктВыполненныхРаботЛимитированныеЗатраты
		               |		ПО СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета = СМ_АктВыполненныхРаботЛимитированныеЗатраты.Ссылка.ЛокальнаяСмета
		               |ГДЕ
		               |	СМ_ОбъектнаяСметаЛокальныеСметы.Расчет = ИСТИНА
		               |	И СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка = &Смета
		               |	И СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета.ПометкаУдаления = ЛОЖЬ
		               |	И СМ_АктВыполненныхРаботЛимитированныеЗатраты.ЛимитированнаяЗатрата.ПометкаУдаления = ЛОЖЬ
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ЛимитированнаяЗатратаНомерПоПорядку";
	ИначеЕсли ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		Запрос.Текст =  "ВЫБРАТЬ РАЗЛИЧНЫЕ
		                |	СМ_АктВыполненныхРаботЛимитированныеЗатраты.ЛимитированнаяЗатрата,
		                |	СМ_АктВыполненныхРаботЛимитированныеЗатраты.ЛимитированнаяЗатрата.НомерПоПорядку КАК ЛимитированнаяЗатратаНомерПоПорядку
		                |ИЗ
		                |	Документ.СМ_СводнаяСмета.Сметы КАК СМ_СводнаяСметаСметы
		                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СМ_ОбъектнаяСмета.ЛокальныеСметы КАК СМ_ОбъектнаяСметаЛокальныеСметы
		                |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СМ_АктВыполненныхРабот.ЛимитированныеЗатраты КАК СМ_АктВыполненныхРаботЛимитированныеЗатраты
		                |			ПО СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета = СМ_АктВыполненныхРаботЛимитированныеЗатраты.Ссылка.ЛокальнаяСмета
		                |		ПО СМ_СводнаяСметаСметы.Смета = СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка
		                |ГДЕ
		                |	СМ_СводнаяСметаСметы.Ссылка = &Смета
		                |	И СМ_ОбъектнаяСметаЛокальныеСметы.Расчет = ИСТИНА
		                |	И СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета.ПометкаУдаления = ЛОЖЬ
		                |	И СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка.ПометкаУдаления = ЛОЖЬ
		                |	И СМ_АктВыполненныхРаботЛимитированныеЗатраты.ЛимитированнаяЗатрата.ПометкаУдаления = ЛОЖЬ
		                |
		                |ОБЪЕДИНИТЬ ВСЕ
		                |
		                |ВЫБРАТЬ
		                |	СМ_АктВыполненныхРаботЛимитированныеЗатраты.ЛимитированнаяЗатрата,
		                |	СМ_АктВыполненныхРаботЛимитированныеЗатраты.ЛимитированнаяЗатрата.НомерПоПорядку
		                |ИЗ
		                |	Документ.СМ_СводнаяСмета.Сметы КАК СМ_СводнаяСметаСметы
		                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СМ_АктВыполненныхРабот.ЛимитированныеЗатраты КАК СМ_АктВыполненныхРаботЛимитированныеЗатраты
		                |		ПО СМ_СводнаяСметаСметы.Смета = СМ_АктВыполненныхРаботЛимитированныеЗатраты.Ссылка.ЛокальнаяСмета
		                |ГДЕ
		                |	СМ_СводнаяСметаСметы.Ссылка = &Смета
		                |	И СМ_СводнаяСметаСметы.Смета.ПометкаУдаления = ЛОЖЬ
		                |	И СМ_АктВыполненныхРаботЛимитированныеЗатраты.Ссылка.ПометкаУдаления = ЛОЖЬ
		                |	И СМ_АктВыполненныхРаботЛимитированныеЗатраты.ЛимитированнаяЗатрата.ПометкаУдаления = ЛОЖЬ
		                |
		                |УПОРЯДОЧИТЬ ПО
		                |	ЛимитированнаяЗатратаНомерПоПорядку";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Смета",Смета);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	ЛимитированныеЗатраты.Загрузить(РезультатЗапроса);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЛимЗатратуНДС()
	
	ЭтаФорма.ЛимзатратаНДС = Справочники.СМ_ЛимитированныеЗатраты.ПустаяСсылка();	
	Для Каждого ТекСтрока Из ЭтаФорма.Смета.ЛимитированныеЗатраты Цикл
		ТекНаименование = НРЕГ(ТекСтрока.ЛимитированнаяЗатрата.Наименование);
		Позиция1 = СтрНайти(ТекНаименование,"налог на добавленную стоимость");
		Позиция2 = СтрНайти(ТекНаименование,"ндс");
		Если Позиция1 > 0 ИЛИ Позиция2 > 0 Тогда
			ЭтаФорма.ЛимзатратаНДС = ТекСтрока.ЛимитированнаяЗатрата;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.ЛимЗатратаНДС) Тогда
		ЭтаФорма.ЛимЗатратаНДС = Справочники.СМ_ЛимитированныеЗатраты.НайтиПоРеквизиту("Идентификатор","ЛЗ64");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СметаПриИзменении(Элемент)
	
	ОбновитьТаблицуЛимЗатрат();
	ЗаполнитьЛимЗатратуНДС();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	ПеременнаяТипаСтандартныйПериод = Новый СтандартныйПериод();
	Диалог.Период = ПеременнаяТипаСтандартныйПериод;
	Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеПоказа", ЭтотОбъект, Новый Структура("ПеременнаяТипаСтандартныйПериод",ПеременнаяТипаСтандартныйПериод));
	Диалог.Показать(Оповещение);
	// Если Диалог.Показать(Оповещение) Тогда
	//	ПеременнаяТипаСтандартныйПериод = Диалог.Период;
	//	Период = ПеременнаяТипаСтандартныйПериод;
	// КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеПоказа(ТекПериод,ТекПараметр) Экспорт
	Если ТекПериод = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекПараметр.ПеременнаяТипаСтандартныйПериод = ТекПериод;
	Период = ТекПараметр.ПеременнаяТипаСтандартныйПериод;
КонецПроцедуры

&НаКлиенте
Процедура СметаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка 			= Ложь;
	ОписаниеОЗакрытииФормыВыбораЛС 	= Новый ОписаниеОповещения("ПриЗакрытииФормыПодбораЛС",ЭтаФорма);
	СтруктураПараметров 			= Новый Структура;
	СтруктураПараметров.Вставить("ВключатьОС",Истина);
	СтруктураПараметров.Вставить("ВключатьСС",Истина);
	СтруктураПараметров.Вставить("БезПомеченных",Истина);
	СтруктураПараметров.Вставить("ОтборСтройка",Истина);
	
	ОткрытьФорму("Обработка.СМ_ДеревоСметПростое.Форма.ФормаУпр",СтруктураПараметров,ЭтаФорма,,,,ОписаниеОЗакрытииФормыВыбораЛС,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыПодбораЛС(ТекЛС,ТекПараметр) Экспорт
	
	Если ТекЛС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Смета = ТекЛС;
	ОбновитьТаблицуЛимЗатрат();
	ЗаполнитьЛимЗатратуНДС();

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если РольДоступна(Метаданные.Роли.ПолныеПрава) ИЛИ 
  		 РольДоступна(Метаданные.Роли.СМ_АдминистраторСмета) ИЛИ
		 РольДоступна(Метаданные.Роли.СМ_РедактированиеНСИ) Тогда
		Элементы.ЛимзатратаНДС.Доступность 		= Истина;
		Элементы.ЛимзатратаНДС.ТолькоПросмотр 	= Ложь;
	Иначе
		Элементы.ЛимзатратаНДС.Доступность 		= Ложь;
		Элементы.ЛимзатратаНДС.ТолькоПросмотр 	= Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти