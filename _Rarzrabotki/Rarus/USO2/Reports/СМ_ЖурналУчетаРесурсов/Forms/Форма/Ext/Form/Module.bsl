
#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ПараметрыЗаполнения") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры.ПараметрыЗаполнения);
	КонецЕсли;
	
	Отчет.ВыводитьМашины 		= Истина;
	Отчет.ВыводитьМатериалы    	= Истина;
	Отчет.ВыводитьТрудозатраты 	= Истина;
	
	ЗаполнитьСписокГруппировок();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Период.Вариант = ВариантСтандартногоПериода.ЭтотМесяц;
	ВключатьВОтчет = 1;
	
	Если Не ЗначениеЗаполнено(КлючТипЦен) Тогда
		КлючТипЦен = "ТекущиеЦены";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КлючОбъектСмета) Тогда
		КлючОбъектСмета = "ПоСметам";
		Если Не ГлобальнаяСтрокаДереваСмет = Неопределено И Не ГлобальнаяСтрокаДереваСмет.ПометкаУдаления Тогда
			// Смета = ГлобальнаяСтрокаДереваСмет.Ссылка;
			СписокСмет.Очистить();
			СписокСмет.Добавить(ГлобальнаяСтрокаДереваСмет.Ссылка);
			ОбъектСтроительства = ГлобальнаяСтрокаДереваСмет.Стройка;
		КонецЕсли;
	КонецЕсли;
	
	ВидимостьЭлементов();
	ВключатьВОтчетПриИзменении();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СметаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка 			= Ложь;
	ОписаниеОЗакрытииФормыВыбораЛС 	= Новый ОписаниеОповещения("ПриЗакрытииФормыПодбораЛС",ЭтаФорма);
	СтруктураПараметров 			= Новый Структура;
	СтруктураПараметров.Вставить("ВключатьОС",Истина);
	СтруктураПараметров.Вставить("ВключатьСС",Истина);
	СтруктураПараметров.Вставить("БезПомеченных",Истина);
	СтруктураПараметров.Вставить("ОтборСтройка",Истина);
	СтруктураПараметров.Вставить("МножественныйВыбор",Истина);
	
	//ОткрытьФорму("Обработка.СМ_ДеревоСметПростое.Форма.ФормаУпр",СтруктураПараметров,ЭтаФорма);
	ОткрытьФорму("Обработка.СМ_ДеревоСметПростое.Форма.ФормаУпр",СтруктураПараметров,ЭтаФорма,Новый УникальныйИдентификатор(),,,ОписаниеОЗакрытииФормыВыбораЛС,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура КлючТекущегоВариантаПриИзменении(Элемент)
	
	ВидимостьЭлементов();
	ЗаполнитьСписокГруппировок();
	
КонецПроцедуры

&НаКлиенте
Процедура ВключатьВОтчетПриИзменении()
	
	Если ВключатьВОтчет = 4 Тогда
		Элементы.Период.Видимость = Истина;	
	Иначе
		Элементы.Период.Видимость = Ложь;	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	
	СформироватьНаСервере(ФактическиеРесурсы);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВидимостьЭлементов()
	
	Элементы.Объект.Видимость 	= КлючОбъектСмета = "ПоОбъектам";	
	Элементы.Смета.Видимость 	= КлючОбъектСмета <> "ПоОбъектам";
	
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере(ФактическиеРесурсы)
	
	// Если Смета.ПометкаУдаления Тогда
	//	Возврат;
	// КонецЕсли;

	Результат.Очистить();
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	Если ВключатьВОтчет = 1 Тогда
		МесяцНачала 	= НачалоМесяца(ТекущаяДатаСеанса());
		МесяцОкончания 	= НачалоМесяца(ТекущаяДатаСеанса());
	Иначе
		МесяцНачала 	= НачалоМесяца(Период.ДатаНачала);
		МесяцОкончания 	= НачалоМесяца(Период.ДатаОкончания);
	КонецЕсли;
	
	ДанныеДляПостроения = Новый Структура;
	Если (КлючОбъектСмета = "ПоОбъектам") Тогда
		ДанныеДляПостроения.Вставить("Смета",ОбъектСтроительства);
		ДанныеДляПостроения.Вставить("ЭтоСмета",Ложь);
	Иначе
		// ДанныеДляПостроения = Смета;
		ДанныеДляПостроения.Вставить("Смета",СписокСмет);
		ДанныеДляПостроения.Вставить("ЭтоСмета",Истина);
	КонецЕсли;
	
	ОтчетОбъект.ПолучитьЗаполненныйОтчет(ДанныеДляПостроения,Результат,ФактическиеРесурсы, МесяцНачала, МесяцОкончания,ВключатьВОтчет, ВыводитьОстатки, КлючТипЦен, УчитыватьКорректировки, СписокГруппировок);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокГруппировок()

	СписокГруппировок.Очистить();
	
	Если КлючОбъектСмета = "ПоОбъектам" Тогда
		СписокГруппировок.Добавить(Тип("СправочникСсылка.СМ_ОбъектыСтроительства"),"Объекты строительства",Истина);
		СписокГруппировок.Добавить(Тип("ДокументСсылка.СМ_СводнаяСмета"),"Сводные сметы",Истина);
		СписокГруппировок.Добавить(Тип("ДокументСсылка.СМ_ОбъектнаяСмета"),"Объектные сметы",Истина);
		СписокГруппировок.Добавить(Тип("ДокументСсылка.СМ_ЛокальнаяСмета"),"Локальные сметы",Истина);
		СписокГруппировок.Добавить(Тип("ДокументСсылка.СМ_РазделЛокальнойСметы"),"Разделы",Истина);
		СписокГруппировок.Добавить(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"),"Позиции",Истина);
	Иначе
		СписокГруппировок.Добавить(Тип("ДокументСсылка.СМ_СводнаяСмета"),"Сводные сметы",Истина);
		СписокГруппировок.Добавить(Тип("ДокументСсылка.СМ_ОбъектнаяСмета"),"Объектные сметы",Истина);
		СписокГруппировок.Добавить(Тип("ДокументСсылка.СМ_ЛокальнаяСмета"),"Локальные сметы",Истина);
		СписокГруппировок.Добавить(Тип("ДокументСсылка.СМ_РазделЛокальнойСметы"),"Разделы",Истина);
		СписокГруппировок.Добавить(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"),"Позиции",Истина);	
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыПодбораЛС(ТекЛС,ТекПараметр) Экспорт
	
	Если ТекЛС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Смета = ТекЛС;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	СписокСмет.Добавить(ВыбранноеЗначение);
КонецПроцедуры

&НаКлиенте
Процедура СметаОткрытие(Элемент, СтандартнаяОбработка)
	ОписаниеОп = Новый ОписаниеОповещения("ПриЗакрытииСпискаЛС",ЭтаФорма);
	СписокСмет.ПоказатьВыборЭлемента(ОписаниеОп,НСтр("ru='Какую смету убрать?'"));

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииСпискаЛС(ТекЛС,ТекПараметр) Экспорт
	Если ТекЛС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СписокСмет.Удалить(ТекЛС);
КонецПроцедуры

#КонецОбласти







