Процедура ВывестиШапкуОтчета()
	
	ТекущийГод 		= Неопределено;
	НомерКолонки 	= 8;
	ШапкаТаблицы 	= Новый ТабличныйДокумент;
	ОбластьШапка 	= Макет.ПолучитьОбласть("Шапка|Основная");
	ШапкаТаблицы.Вывести(ОбластьШапка);
	Для Каждого СтрокаПериода Из ТаблицаПериодов Цикл
		Если ТекущийГод = Неопределено Тогда
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
			БылоВыполнениеВГоду = Ложь;
		ИначеЕсли ТекущийГод <> НачалоГода(СтрокаПериода.Дата) Тогда
			Если БылоВыполнениеВГоду Тогда
				БылоВыполнениеВГоду 					= Ложь;
				Область 								= Макет.ПолучитьОбласть("Шапка|Год");
				Область.Параметры.Дата 					= "за "+Формат(ТекущийГод,"ДФ=гггг")+" год";
				Область.Параметры.НомерСтрокиКоличество = НомерКолонки;
				Область.Параметры.НомерСтрокиСтоимость 	= НомерКолонки + 1;
				НомерКолонки 							= НомерКолонки + 2;
				ШапкаТаблицы.Присоединить(Область);
			КонецЕсли;
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
		КонецЕсли;
		ВыводитьВОтчет = МассивПериодовНаПечать.Найти(СтрокаПериода.Дата) <> Неопределено;
		Если ВыводитьВОтчет Тогда
			БылоВыполнениеВГоду 					= Истина;
			Область 								= Макет.ПолучитьОбласть("Шапка|Месяц");
			ЗаполнитьЗначенияСвойств(Область.Параметры,СтрокаПериода);
			Область.Параметры.НомерСтрокиКоличество = НомерКолонки;
			Область.Параметры.НомерСтрокиЦена 		= НомерКолонки+1;
			Область.Параметры.НомерСтрокиСтоимость 	= НомерКолонки + 2;
			НомерКолонки 							= НомерКолонки + 3;
			ШапкаТаблицы.Присоединить(Область);
		КонецЕсли;
	КонецЦикла;
	Область 								= Макет.ПолучитьОбласть("Шапка|Год");
	Область.Параметры.Дата 					= "за "+Формат(ТекущийГод,"ДФ=гггг")+" год";
	Область.Параметры.НомерСтрокиКоличество = НомерКолонки;
	Область.Параметры.НомерСтрокиСтоимость 	= НомерКолонки + 1;
	НомерКолонки 							= НомерКолонки + 2;
	ШапкаТаблицы.Присоединить(Область);
	Если мВыводитьОстатки Тогда
		Область 								= Макет.ПолучитьОбласть("Шапка|Остатки");
		Область.Параметры.НомерСтрокиКоличество = НомерКолонки;
		Область.Параметры.НомерСтрокиСтоимость 	= НомерКолонки + 1;
		НомерКолонки							= НомерКолонки + 2;
		ШапкаТаблицы.Присоединить(Область);
	КонецЕсли;
	ТабДок.Вывести(ШапкаТаблицы);
	
КонецПроцедуры

Процедура ВывестиКолонкиПериодов()
	
	ТекущийГод = Неопределено;
	Для Каждого СтрокаПериода Из ТаблицаПериодов Цикл
		Если ТекущийГод = Неопределено Тогда
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
			БылоВыполнениеВГоду = Ложь;
		ИначеЕсли ТекущийГод <> НачалоГода(СтрокаПериода.Дата) Тогда
			Если БылоВыполнениеВГоду Тогда
				Область = Макет.ПолучитьОбласть("Строка|Год");
				ТабДок.Присоединить(Область);
				БылоВыполнениеВГоду = Ложь;
			КонецЕсли;
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
		КонецЕсли;
		ВыводитьВОтчет = МассивПериодовНаПечать.Найти(СтрокаПериода.Дата) <> Неопределено;
		Если ВыводитьВОтчет Тогда
			БылоВыполнениеВГоду = Истина;
			Область = Макет.ПолучитьОбласть("Строка|Месяц");
			ТабДок.Присоединить(Область);
		КонецЕсли;
	КонецЦикла;
	Область = Макет.ПолучитьОбласть("Строка|Год");
	ТабДок.Присоединить(Область);
	Если мВыводитьОстатки Тогда
		Область = Макет.ПолучитьОбласть("Строка|Остатки");
		ТабДок.Присоединить(Область);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиДеревоИерархия(Дерево,ТабДок,ОбластьСтрока)
	
	Для Каждого ТекСтрока Из Дерево.Строки Цикл
		
		ОбластьСтрока.Параметры.ПечОбъект = ТекСтрока.Стройка;
	
		Если ТекСтрока.Стройка.ЭтоГруппа Тогда
			ТабДок.Вывести(ОбластьСтрока,ТекСтрока.Уровень());
			ВывестиКолонкиПериодов();
		Иначе
			НужноВыводить = ОпределитьГруппировку(ТекСтрока.Стройка);
			Если НужноВыводить Тогда
				ТабДок.Вывести(ОбластьСтрока,ТекСтрока.Уровень());
				ВывестиКолонкиПериодов();
			КонецЕсли;
		
			// Получаем список локальных смет, которые относятся к текущей стройке
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Стройка",ТекСтрока.Стройка);
			ТабЛС 		= ТабПозицийСводная.Выгрузить().Скопировать(СтруктураОтбора, "ЛокальнаяСмета"); 
			ТабЛС.Свернуть("ЛокальнаяСмета");
			СписокЛС	= ТабЛС.ВыгрузитьКолонку("ЛокальнаяСмета"); 
			
			// Получаем дерево смет, которые относятся к текущей стройке
			ТабСметОбъекта = ПолучитьДеревоСметПоОбъекту(ТекСтрока.Стройка,СписокЛС);
			ТабСметОбъекта.Сортировать("Родитель,Смета");
			ТабСметСводная = ТабСметОбъекта.Скопировать();
			
			Для Каждого ТекСтрокаСмет Из ТабСметОбъекта Цикл
				
				ТекУровень = ТекСтрока.Уровень() + 1;
				
				Если ТекСтрокаСмет.ЭтоПозиция ИЛИ ТекСтрокаСмет.ЭтоРаздел ИЛИ ЗначениеЗаполнено(ТекСтрокаСмет.Родитель) Тогда
					 Продолжить;
				КонецЕсли;
				
				ПечНомер = ТекСтрокаСмет.НомерСметы;
			
				// Вывести строки сметам первого уровня подчиненных объекту
				Если ТекСтрокаСмет.ЭтоЛокальная Тогда
					ПечОбъект 	= "Локальная смета: " + ТекСтрокаСмет.Наименование;
				ИначеЕсли ТекСтрокаСмет.ЭтоОбъектная Тогда
					ПечОбъект 	= "Объектная смета: " + ТекСтрокаСмет.Наименование;
				ИначеЕсли ТекСтрокаСмет.ЭтоСводная Тогда
					ПечОбъект 	= "Сводная смета: " + ТекСтрокаСмет.Наименование;
				КонецЕсли;

				НужноВыводить = ОпределитьГруппировку(ТекСтрокаСмет.Смета);
				Если НужноВыводить Тогда
					УровеньВывода 							= ТекСтрока.Уровень() + 1;
					ОбластьСтрока.Параметры.ПечОбъект 		= ПечОбъект;
					ОбластьСтрока.Параметры.НомерПоПорядку 	= ПечНомер;
					ТабДок.Вывести(ОбластьСтрока,ТекУровень);
					ВывестиКолонкиПериодов();
					ВывестиСтроку(ТекСтрокаСмет.Смета,ТабСметСводная,УровеньВывода,ОбластьСтрока);
				Иначе
					УровеньВывода = ТекСтрока.Уровень();	
					ВывестиСтроку(ТекСтрокаСмет.Смета,ТабСметСводная,УровеньВывода,ОбластьСтрока);
				КонецЕсли;
				
				// Вывести группировку итогов по сметам первого уровня подчиненных объекту
				Если НужноВыводить Тогда
					СтруктураОтбора = Новый Структура;
					Если ТекСтрокаСмет.ЭтоЛокальная Тогда
						ОбластьСтрока.Параметры.ПечОбъект = "Итого по локальной смете: " + ТекСтрокаСмет.Наименование;
						СтруктураОтбора.Вставить("Смета",ТекСтрокаСмет.Смета);
					ИначеЕсли ТекСтрокаСмет.ЭтоОбъектная Тогда
						ОбластьСтрока.Параметры.ПечОбъект = "Итого по объектной смете: " + ТекСтрокаСмет.Наименование;
						СтруктураОтбора.Вставить("ОбъектнаяСмета",ТекСтрокаСмет.Смета);
					ИначеЕсли ТекСтрокаСмет.ЭтоСводная Тогда
						ОбластьСтрока.Параметры.ПечОбъект = "Итого по сводной смете: " + ТекСтрокаСмет.Наименование;
						СтруктураОтбора.Вставить("СводнаяСмета",ТекСтрокаСмет.Смета);
					КонецЕсли;	
					ОбластьСтрока.Параметры.НомерПоПорядку = "";
					ТабДок.Вывести(ОбластьСтрока,ТекУровень + 1);
					ВывестиКолонкиПериодов();
					ВывестиРесурсыПоСмете(ТекСтрокаСмет.Смета,ТекУровень + 1,СтруктураОтбора);
				КонецЕсли;
				
			КонецЦикла;
			
			// Вывести итоги по объекту
			НужноВыводить = ОпределитьГруппировку(ТекСтрока.Стройка);
			Если НужноВыводить Тогда 
				ОбластьСтрока.Параметры.ПечОбъект 		= "Итого по объекту: " + ТекСтрока.Стройка;
				ОбластьСтрока.Параметры.НомерПоПорядку 	= "";
				ТабДок.Вывести(ОбластьСтрока,ТекУровень);
				СтруктураОтбора = Новый Структура;
			    СтруктураОтбора.Вставить("Стройка",ТекСтрока.Стройка);
				ВывестиКолонкиПериодов();
				ВывестиРесурсыПоСмете(ТекСтрока.Стройка,ТекУровень + 1,СтруктураОтбора);
			КонецЕсли;
			
		КонецЕсли;
		
		ВывестиДеревоИерархия(ТекСтрока,ТабДок,ОбластьСтрока);

		// Вывести итоги по группе объектов
		Если ТекСтрока.Стройка.ЭтоГруппа Тогда
			ОбластьСтрока.Параметры.ПечОбъект 		= "Итого по группе: " + ТекСтрока.Стройка;
			ОбластьСтрока.Параметры.НомерПоПорядку 	= "";
			ТабДок.Вывести(ОбластьСтрока,ТекСтрока.Уровень() + 1);
			СтруктураОтбора = Новый Структура;
		    СтруктураОтбора.Вставить("Стройка",ТекСтрока.Стройка);
			ВывестиКолонкиПериодов();
			ВывестиРесурсыПоСмете(ТекСтрока.Стройка,ТекСтрока.Уровень() + 1,СтруктураОтбора);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиСтроку(ТекОбъект,ТабОбъектов,ТекУровень,ОбластьСтрока)
		
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Родитель",ТекОбъект);
	МассивСтрок = ТабОбъектов.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() > 0 Тогда
		УровеньВывода = ТекУровень + 1;
		Для Каждого ТекЭлемент Из МассивСтрок Цикл
			
			ТекСмета = ТекЭлемент.Смета;
			ПечНомер = ТекЭлемент.НомерСметы;
			
			Если ТекЭлемент.ЭтоЛокальная Тогда
				ПечОбъект = "Локальная смета: " + ТекЭлемент.Наименование;
			ИначеЕсли ТекЭлемент.ЭтоОбъектная Тогда
				ПечОбъект = "Объектная смета: " + ТекЭлемент.Наименование;
			Иначе
				ПечОбъект = ТекЭлемент.Наименование;
			КонецЕсли;

			// TO DO (1):
			// 1. Поля НомерСметы, НаименованиеДляПечати, ПорНомер, Наименование можно сразу в запросе изначальном получить, чтобы тут по ссылке не ходить.
			// 2. В таблицу ТабОбъектов можно добавить поле, что за группировака ЭтоОбъктная, ЭтоЛокальная и т.п.
			
			СтруктураОтбора = Новый Структура;
			ВыводитьРесурсы = Истина;
			
			// Выводим / пропускаем уровень группировки, в зависимости от настроек вывода группировок.
			НужноВыводить = ОпределитьГруппировку(ТекСмета);
			Если НужноВыводить Тогда
				
				// По позициям с видом расценки материал или оборудование ресурсы не выводятся.
				// Сама позиция выводится отдельно как ресурс, но в строке позиции.
				Если ТекЭлемент.ЭтоПозиция Тогда
					Если ТекСмета.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал ИЛИ 
						 ТекСмета.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование Тогда				
						ВыводитьРесурсы = Ложь;
						СтруктураОтбора.Вставить("Позиция",ТекСмета);
						ВывестиРесурсыПоПроекту(ТекСмета,ТекУровень,СтруктураОтбора,ПечНомер);
						// Вывести позицию как ресурс	
					Иначе
						УровеньВывода 							= ТекУровень + 1;			
						ОбластьСтрока.Параметры.ПечОбъект 		= ПечОбъект;
						ОбластьСтрока.Параметры.НомерПоПорядку 	= ПечНомер;
						ТабДок.Вывести(ОбластьСтрока,УровеньВывода);
						ВывестиКолонкиПериодов();
					КонецЕсли;
				Иначе
					УровеньВывода 							= ТекУровень + 1;			
					ОбластьСтрока.Параметры.ПечОбъект 		= ПечОбъект;
					ОбластьСтрока.Параметры.НомерПоПорядку 	= ПечНомер;
					ТабДок.Вывести(ОбластьСтрока,УровеньВывода);
					ВывестиКолонкиПериодов();
	            КонецЕсли;
			Иначе
				УровеньВывода = ТекУровень;	
			КонецЕсли;
			
			//// Выводим / пропускаем уровень группировки, в зависимости от настроек вывода группировок
			//НужноВыводить = ОпределитьГруппировку(ТекСмета);
			//Если НужноВыводить Тогда
			//	УровеньВывода 							= ТекУровень + 1;			
			//	ОбластьСтрока.Параметры.ПечОбъект 		= ПечОбъект;
			//	ОбластьСтрока.Параметры.НомерПоПорядку 	= ПечНомер;
			//	ТабДок.Вывести(ОбластьСтрока,УровеньВывода);
			//	ВывестиКолонкиПериодов();
			//Иначе
			//	УровеньВывода = ТекУровень;	
			//КонецЕсли;
			
			ВывестиСтроку(ТекСмета,ТабОбъектов,УровеньВывода,ОбластьСтрока);
			//СтруктураОтбора = Новый Структура;
			
			Если НЕ ВыводитьРесурсы Тогда
				Продолжить;	
			КонецЕсли;
			
			// Вывести ресурсы по позиции
			Если ТекЭлемент.ЭтоПозиция И НужноВыводить Тогда
				СтруктураОтбора.Вставить("Позиция",ТекСмета);
			 	ВывестиРесурсыПоСмете(ТекСмета,УровеньВывода,СтруктураОтбора,Истина);
			// Вывести ресурсы по разделу	
			ИначеЕсли ТекЭлемент.ЭтоРаздел И НужноВыводить Тогда
				ОбластьСтрока.Параметры.ПечОбъект 		= "Итого по разделу: " + ТекЭлемент.Наименование;
				ОбластьСтрока.Параметры.НомерПоПорядку 	= "";
				ТабДок.Вывести(ОбластьСтрока,УровеньВывода + 1);
				ИзменитьРодителяПоРазделуРесурсы(ТекСмета,ТекСмета);
				ИзменитьРодителяПоРазделуВыполнение(ТекСмета,ТекСмета);
				СтруктураОтбора.Вставить("Родитель",ТекСмета);
				ВывестиКолонкиПериодов();
				ВывестиРесурсыПоСмете(ТекСмета,УровеньВывода + 1,СтруктураОтбора);
			// Вывести ресурсы по локальной смете	
			ИначеЕсли ТекЭлемент.ЭтоЛокальная И НужноВыводить Тогда
				ОбластьСтрока.Параметры.ПечОбъект 		= "Итого по локальной смете: " + ТекЭлемент.Наименование;
				ОбластьСтрока.Параметры.НомерПоПорядку 	= "";
				СтруктураОтбора.Вставить("Смета",ТекСмета);
				ТабДок.Вывести(ОбластьСтрока,УровеньВывода + 1);
				ВывестиКолонкиПериодов();
				ВывестиРесурсыПоСмете(ТекСмета,УровеньВывода + 1,СтруктураОтбора);
			// Вывести ресурсы по объектной смете	
			ИначеЕсли ТекЭлемент.ЭтоОбъектная И НужноВыводить Тогда
				ОбластьСтрока.Параметры.ПечОбъект 		= "Итого по объектной смете: " + ТекЭлемент.Наименование;
				ОбластьСтрока.Параметры.НомерПоПорядку 	= "";
				ТабДок.Вывести(ОбластьСтрока,УровеньВывода + 1);
				СтруктураОтбора.Вставить("ОбъектнаяСмета",ТекСмета);
				ВывестиКолонкиПериодов();
				ВывестиРесурсыПоСмете(ТекСмета,УровеньВывода + 1,СтруктураОтбора);
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		УровеньВывода = ТекУровень; 	
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиРесурсыПоСмете(ТекСмета,ТекУровень,СтруктураОтбора,ПоПозицииЛС = Ложь)
	
	МассивСтрокОтбора 		= ТаблицаРесурсовОбщая.НайтиСтроки(СтруктураОтбора);
	ТаблицаРесурсовСводная 	= ТаблицаРесурсовОбщая.Скопировать(МассивСтрокОтбора); 
	
	// TO DO (1):
	// Наверное, чтобы не сверять типы, логично структуру отбора сделать параметром настоящей функции.
	// А уровнем выше сразу устанавливать что и как мы отбираем.
	// Подумать, чтобы в таблицу добавить колонку тогда ЭтоРаздел, ЭтоПозиция, ... . И, может, ее сразу отчетом вытащить.
	// Возможно и ТаблицаРесурсовСводная можно сделать параметром.
	
	Если ПоПозицииЛС Тогда
		ТаблицаРесурсовСводная.Сортировать("ВидРесурса, КодРесурса, ПорНомер");
		ТаблицаРесурсовСводная.Свернуть("Ресурс, КодРесурса, ВидРесурса, НаименованиеРесурса, ЕдиницаИзмеренияРесурса, ЭтоНеучтенный, ЭтоОборудование, ЭтоПозицияРесурс, ПозицияРесурс","Количество, НормаРасхода, СтоимостьБазисная, СтоимостьТекущая, РасходПоНорме, СтоимостьБазиснаяПоНорме, СтоимостьТекущаяПоНорме"); 
		//ТаблицаРесурсовСводная.Свернуть("Ресурс, КодРесурса, ВидРесурса, НаименованиеРесурса, ЕдиницаИзмеренияРесурса, ЭтоНеучтенный, ЭтоОборудование, ЭтоПозицияРесурс, ПозицияРесурс, ПорНомер","Количество, НормаРасхода, СтоимостьБазисная, СтоимостьТекущая, РасходПоНорме, СтоимостьБазиснаяПоНорме, СтоимостьТекущаяПоНорме"); 
		//ТаблицаРесурсовСводная.Сортировать("ВидРесурса, КодРесурса, ПорНомер");
	Иначе
		ТаблицаРесурсовСводная.Сортировать("ТипРесурса, ВидРесурса, КодРесурса, ПорНомер");
		ТаблицаРесурсовСводная.Свернуть("Ресурс, КодРесурса, ВидРесурса, НаименованиеРесурса, ЕдиницаИзмеренияРесурса, ЭтоНеучтенный, ЭтоОборудование, ЭтоПозицияРесурс, ПозицияРесурс, ТипРесурса","Количество, НормаРасхода, СтоимостьБазисная, СтоимостьТекущая, РасходПоНорме, СтоимостьБазиснаяПоНорме, СтоимостьТекущаяПоНорме"); 
		//ТаблицаРесурсовСводная.Свернуть("Ресурс, КодРесурса, ВидРесурса, НаименованиеРесурса, ЕдиницаИзмеренияРесурса, ЭтоНеучтенный, ЭтоОборудование, ЭтоПозицияРесурс, ПозицияРесурс, ТипРесурса, ПорНомер","Количество, НормаРасхода, СтоимостьБазисная, СтоимостьТекущая, РасходПоНорме, СтоимостьБазиснаяПоНорме, СтоимостьТекущаяПоНорме");
		//ТаблицаРесурсовСводная.Сортировать("ТипРесурса, ВидРесурса, КодРесурса, ПорНомер");
	КонецЕсли;
	
	ОбластьСтрока	= Макет.ПолучитьОбласть("Строка|Основная");
	ОбластьРаздел 	= Макет.ПолучитьОбласть("Раздел|Основная");
	НомерПоПорядку 	= 0;
	ТипРесурса 		= 0;
	ВидРесурса 		= Неопределено;
	
	СтруктураОтбора.Вставить("ДатаАкта");
	СтруктураОтбора.Вставить("Ресурс");
	СтруктураОтбора.Вставить("КодРесурса");
	
	Для Каждого ТекСтрока Из ТаблицаРесурсовСводная Цикл
		
		Если НЕ ПоПозицииЛС Тогда
			// При смене типа ресурса выводим строку группировки по типу в документ 
			Если ТипРесурса <> ТекСтрока.ТипРесурса Тогда
				ТипРесурса = ТекСтрока.ТипРесурса;
				Если ТипРесурса = 1 Тогда
					ОбластьРаздел.Параметры.НаименованиеРаздела = НСтр("ru='Ресурсы по проекту'");
					ТабДок.Вывести(ОбластьРаздел, ТекУровень + 1);
					ВывестиКолонкиПериодов();
				Иначе
					ОбластьРаздел.Параметры.НаименованиеРаздела = НСтр("ru='Ресурсы по нормам СНиП'");
					ТабДок.Вывести(ОбластьРаздел, ТекУровень + 1);
					ВывестиКолонкиПериодов();
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
		
		// При смене вида ресурса выводим строку группировки по виду в документ
		Если ВидРесурса <> ТекСтрока.ВидРесурса Тогда
			ВидРесурса = ТекСтрока.ВидРесурса;
			ОбластьРаздел.Параметры.НаименованиеРаздела = СокрЛП(ВидРесурса);
			ТабДок.Вывести(ОбластьРаздел, ТекУровень + 2);
			ВывестиКолонкиПериодов();
		КонецЕсли;
				
		НомерПоПорядку 								= НомерПоПорядку + 1;
		ОбластьСтрока.Параметры.НомерПоПорядку 		= НомерПоПорядку;
		
		// Вывод строки позиции, которая является ресурсом, в документ.
		Если ТекСтрока.ЭтоПозицияРесурс Тогда
			ОбластьСтрока.Параметры.Шифр                = ТекСтрока.ПозицияРесурс.ШифрРасценки;
			ОбластьСтрока.Параметры.НаименованиеРесурса	= ТекСтрока.ПозицияРесурс.Наименование;
			ОбластьСтрока.Параметры.ЕдиницаИзмерения 	= ТекСтрока.ПозицияРесурс.ЕдиницаИзмерения;
			ОбластьСтрока.Параметры.Количество 			= ТекСтрока.ПозицияРесурс.ОбъемРабот;
			Если ТипЦен = "Текущая" Тогда
				ТекЦена = ТекСтрока.ПозицияРесурс.ТекущаяЦена;
			Иначе
				ТекЦена = ТекСтрока.ПозицияРесурс.СтоимМатериалов;
			КонецЕсли;
			ОбластьСтрока.Параметры.Цена		= ТекЦена;
			СтоимостьРесурса 					= ТекЦена * ТекСтрока.ПозицияРесурс.ОбъемРабот;
			ОбластьСтрока.Параметры.Стоимость 	= СтоимостьРесурса;
		// Вывод строки ресурса в документ.
		Иначе
			СтоимостьРесурса 							= ТекСтрока[НаименованиеСтоимостиПоНорме]; 
			ОбластьСтрока.Параметры.Шифр 				= ТекСтрока.КодРесурса;
			ОбластьСтрока.Параметры.НаименованиеРесурса = ТекСтрока.НаименованиеРесурса;
			ОбластьСтрока.Параметры.ЕдиницаИзмерения 	= ТекСтрока.ЕдиницаИзмеренияРесурса;
			ОбластьСтрока.Параметры.Количество 			= ТекСтрока.РасходПоНорме;
			ОбластьСтрока.Параметры.Стоимость 			= ТекСтрока[НаименованиеСтоимостиПоНорме];
			Если ТекСтрока.РасходПоНорме > 0 Тогда
				ОбластьСтрока.Параметры.Цена = ТекСтрока[НаименованиеСтоимостиПоНорме] / ТекСтрока.РасходПоНорме; 
			Иначе
				ОбластьСтрока.Параметры.Цена = 0;	
			КонецЕсли;
		КонецЕсли;
		ТабДок.Вывести(ОбластьСтрока,ТекУровень + 3);

		// Присоединение строк по периодам выполнения
		ТекущийГод 			= Неопределено;
		КоличествоЗаГод 	= 0;
		СтоимостьЗаГод 		= 0;
		КоличествоСНачала 	= 0;
		СтоимостьСНачала 	= 0;
		
		// Если выполнения по ресурсу не было вообще, то не ищем строки по периодам
		СтруктураОтбораПериод = Новый Структура;
		СтруктураОтбораПериод.Вставить("Ресурс", ТекСтрока.Ресурс);
		СтруктураОтбораПериод.Вставить("КодРесурса", ТекСтрока.КодРесурса);		
		КоличествоВыполнения = ТаблицаВыполненияОбщая.НайтиСтроки(СтруктураОтбораПериод).Количество();
		
		
		Для Каждого СтрокаПериода Из ТаблицаПериодов Цикл
			
			Если ТекущийГод = Неопределено Тогда
				ТекущийГод 			= НачалоГода(СтрокаПериода.Дата);
				БылоВыполнениеВГоду = Ложь;
				КоличествоЗаГод 	= 0;
				СтоимостьЗаГод 		= 0;
			ИначеЕсли ТекущийГод <> НачалоГода(СтрокаПериода.Дата) Тогда
				Если БылоВыполнениеВГоду Тогда
					БылоВыполнениеВГоду 			= Ложь;
					Область 						= Макет.ПолучитьОбласть("Строка|Год");
					Область.Параметры.Количество 	= КоличествоЗаГод;
					Область.Параметры.Стоимость 	= СтоимостьЗаГод;
					ТабДок.Присоединить(Область);
				КонецЕсли;
				КоличествоЗаГод = 0;
				СтоимостьЗаГод	= 0;
				ТекущийГод 		= НачалоГода(СтрокаПериода.Дата);
			КонецЕсли;
			
			ТаблицаВыполненияСводная = Новый ТаблицаЗначений;
			Если ТаблицаВыполненияОбщая.Количество() > 0 И КоличествоВыполнения > 0 Тогда
				
				 Если ТекСтрока.ЭтоПозицияРесурс Тогда
					СтруктураОтбораПроект = Новый Структура;
					СтруктураОтбораПроект.Вставить("ДатаАкта", СтрокаПериода.Дата);
					СтруктураОтбораПроект.Вставить("Позиция", ТекСтрока.ПозицияРесурс);
					МассивСтрокОтбора 			= ТаблицаВыполненияОбщая.НайтиСтроки(СтруктураОтбораПроект);
					ТаблицаВыполненияСводная 	= ТаблицаВыполненияОбщая.Скопировать(МассивСтрокОтбора); 
					Если ТипЦен = "Текущая" Тогда
						ТаблицаВыполненияСводная.Свернуть("Позиция,ФактОбъемПроект","СтоимостьБазисная, СтоимостьТекущая");
						ТаблицаВыполненияСводная.Колонки.Добавить("ЦенаТекущая");
					Иначе
						ТаблицаВыполненияСводная.Свернуть("Позиция,ФактОбъемПроект","СтоимостьБазисная, СтоимостьТекущая");
						ТаблицаВыполненияСводная.Колонки.Добавить("ЦенаБазисная");
					КонецЕсли;
					
					Если ТаблицаВыполненияСводная.Количество() > 0 Тогда
						Если ТипЦен = "Текущая" Тогда
							ТаблицаВыполненияСводная[0].ЦенаТекущая = ?(ТаблицаВыполненияСводная[0].ФактОбъемПроект = 0,0,ТаблицаВыполненияСводная[0].СтоимостьТекущая/ТаблицаВыполненияСводная[0].ФактОбъемПроект);
						Иначе
							ТаблицаВыполненияСводная[0].ЦенаБазисная = ?(ТаблицаВыполненияСводная[0].ФактОбъемПроект = 0 ,0,ТаблицаВыполненияСводная[0].СтоимостьБазисная/ТаблицаВыполненияСводная[0].ФактОбъемПроект);
						КонецЕсли;
					КонецЕсли;
				Иначе
					СтруктураОтбора.ДатаАкта		= СтрокаПериода.Дата;
					СтруктураОтбора.Ресурс			= ТекСтрока.Ресурс;
					СтруктураОтбора.КодРесурса		= ТекСтрока.КодРесурса;					
					
					МассивСтрокОтбора 			= ТаблицаВыполненияОбщая.НайтиСтроки(СтруктураОтбора);
					ТаблицаВыполненияСводная 	= ТаблицаВыполненияОбщая.Скопировать(МассивСтрокОтбора); 
					Если ТипЦен = "Текущая" Тогда
						ТаблицаВыполненияСводная.Свернуть("Ресурс, КодРесурса","РасходПоФакту, СтоимостьБазисная, СтоимостьТекущая");
						ТаблицаВыполненияСводная.Колонки.Добавить("ЦенаТекущая");
					Иначе
						ТаблицаВыполненияСводная.Свернуть("Ресурс, КодРесурса","РасходПоФакту, СтоимостьБазисная, СтоимостьТекущая");
						ТаблицаВыполненияСводная.Колонки.Добавить("ЦенаБазисная");
					КонецЕсли;
					
					Если ТаблицаВыполненияСводная.Количество() > 0 Тогда
						Если ТипЦен = "Текущая" Тогда
							ТаблицаВыполненияСводная[0].ЦенаТекущая = ?(ТаблицаВыполненияСводная[0].РасходПоФакту = 0,0,ТаблицаВыполненияСводная[0].СтоимостьТекущая/ТаблицаВыполненияСводная[0].РасходПоФакту);
						Иначе
							ТаблицаВыполненияСводная[0].ЦенаБазисная = ?(ТаблицаВыполненияСводная[0].РасходПоФакту = 0 ,0,ТаблицаВыполненияСводная[0].СтоимостьБазисная/ТаблицаВыполненияСводная[0].РасходПоФакту);
						КонецЕсли;
					КонецЕсли;

				КонецЕсли;

				// TO DO (1):
				// ТаблицаВыполненияОбщая.НайтиСтроки(СтруктураОтбора) отъедает много времени из-за частого повторения.
				// Как идеи:
				// 1. Можно в запросе, где ищутся ресурсы позиций установить сразу количество ресурсов в данной позиции. Если их нет, то и не вызывать.
				// 2. Можно добавить в теблицу ТаблицаВыполненияОбщая индекс по полям "Смета, ОбъектнаяСмета, Позиция, Родитель, СводнаяСмета, ГруппаОбъекта, Стройка".
				// Там где она заполняется ТаблицаВыполненияОбщая.Индексы.Добавить("...")
				// 3. Может как-то собрать данные за год по другому предварительно, а тут если не ВыводитьВОтчет так и не делать этого всего..
				
			КонецЕсли;
			
			
			Если ТаблицаВыполненияСводная.Количество() = 0 Тогда
				Количество 	= 0;
				Цена 		= 0;
				Стоимость 	= 0;
			Иначе	
				
				СтрокаДанных = ТаблицаВыполненияСводная[0];
				
				Если ТекСтрока.ЭтоПозицияРесурс Тогда
					Количество 	= СтрокаДанных.ФактОбъемПроект;
					Стоимость 	= СтрокаДанных["Стоимость" + ТипЦен];
					Если Количество > 0 Тогда
						Цена = Стоимость / Количество;
					Иначе
						Цена 		= 0;
						Стоимость 	= 0;
					КонецЕсли;
				Иначе	
					Количество 	= СтрокаДанных.РасходПоФакту;
					Цена 		= СтрокаДанных["Цена" + ТипЦен];
					Стоимость 	= СтрокаДанных["Стоимость" + ТипЦен];
				КонецЕсли;
			КонецЕсли;
	
			ВыводитьВОтчет = МассивПериодовНаПечать.Найти(СтрокаПериода.Дата) <> Неопределено;
			Если ВыводитьВОтчет Тогда
				БылоВыполнениеВГоду 			= Истина;
				Область 						= Макет.ПолучитьОбласть("Строка|Месяц");
				Область.Параметры.Количество 	= Количество;
				Область.Параметры.Цена 			= Цена;
				Область.Параметры.Стоимость 	= Стоимость;
				// Если количество за месяц не заполнено, 
				// то цена ресурса за этот месяц не выводится.
				Если Количество = 0 Тогда
					Область.Параметры.Цена = 0;	
				КонецЕсли;
				ТабДок.Присоединить(Область);
			КонецЕсли;
			
			КоличествоЗаГод 	= КоличествоЗаГод + Количество;
			СтоимостьЗаГод 		= СтоимостьЗаГод + Стоимость;
			КоличествоСНачала 	= КоличествоСНачала + Количество;
			СтоимостьСНачала 	= СтоимостьСНачала + Стоимость;
			
		КонецЦикла;
	
		Область 						= Макет.ПолучитьОбласть("Строка|Год");
		Область.Параметры.Количество 	= КоличествоЗаГод;
		Область.Параметры.Стоимость 	= СтоимостьЗаГод;
		ТабДок.Присоединить(Область);
		Если мВыводитьОстатки Тогда
			Область 						= Макет.ПолучитьОбласть("Строка|Остатки");
			Область.Параметры.Количество	= ТекСтрока.РасходПоНорме - КоличествоСНачала;
			Область.Параметры.Стоимость 	= СтоимостьРесурса - СтоимостьСНачала;
			ТабДок.Присоединить(Область);
		КонецЕсли;
	
	КонецЦикла;
	 	
КонецПроцедуры

Процедура ВывестиРесурсыПоПроекту(ТекСмета,ТекУровень,СтруктураОтбора,ПечНомер)
	
	ТекОбласть			= Макет.ПолучитьОбласть("СтрокаПозиция|Основная");
	ОбластьРаздел 		= Макет.ПолучитьОбласть("Раздел|Основная");
	НомерПоПорядку 		= 0;

	УровеньВывода 								= ТекУровень + 1;			
	ТекОбласть.Параметры.НомерПоПорядку 		= ПечНомер;
	ТекОбласть.Параметры.Шифр                   = ТекСмета.ШифрРасценки;
	ТекОбласть.Параметры.НаименованиеПозиции	= ТекСмета.Наименование;
	ТекОбласть.Параметры.ЕдиницаИзмерения 		= ТекСмета.ЕдиницаИзмерения;
	ТекОбласть.Параметры.Количество 			= ТекСмета.ОбъемРабот;
		
	Если ТипЦен = "Текущая" Тогда
		ТекОбласть.Параметры.Цена = ТекСмета.ТекущаяЦена;
	Иначе
		ТекОбласть.Параметры.Цена = ТекСмета.СтоимМатериалов;	
	КонецЕсли;
	
	ТекОбласть.Параметры.Стоимость = ТекОбласть.Параметры.Цена * ТекСмета.ОбъемРабот;
	ТабДок.Вывести(ТекОбласть,УровеньВывода);
	
	СтоимостьРесурса = ТекОбласть.Параметры.Цена * ТекСмета.ОбъемРабот;
	
	// Присоединение строк по периодам выполнения.
	ТекущийГод 			= Неопределено;
	КоличествоЗаГод 	= 0;
	СтоимостьЗаГод 		= 0;
	КоличествоСНачала 	= 0;
	СтоимостьСНачала 	= 0;
	
	// Если выполнения по позиции (как ресурса) не было вообще, то не ищем строки по периодам.
	КоличествоВыполнения = ТаблицаВыполненияОбщая.НайтиСтроки(СтруктураОтбора).Количество();
	Для Каждого СтрокаПериода Из ТаблицаПериодов Цикл
		
		Если ТекущийГод = Неопределено Тогда
			ТекущийГод 			= НачалоГода(СтрокаПериода.Дата);
			БылоВыполнениеВГоду = Ложь;
			КоличествоЗаГод 	= 0;
			СтоимостьЗаГод 		= 0;
		ИначеЕсли ТекущийГод <> НачалоГода(СтрокаПериода.Дата) Тогда
			Если БылоВыполнениеВГоду Тогда
				БылоВыполнениеВГоду 			= Ложь;
				Область 						= Макет.ПолучитьОбласть("Строка|Год");
				Область.Параметры.Количество 	= КоличествоЗаГод;
				Область.Параметры.Стоимость 	= СтоимостьЗаГод;
				ТабДок.Присоединить(Область);
			КонецЕсли;
			КоличествоЗаГод = 0;
			СтоимостьЗаГод	= 0;
			ТекущийГод 		= НачалоГода(СтрокаПериода.Дата);
		КонецЕсли;
		
		ТаблицаВыполненияСводная = Новый ТаблицаЗначений;
		Если ТаблицаВыполненияОбщая.Количество() > 0 И КоличествоВыполнения > 0 Тогда
			СтруктураОтбора.Вставить("ДатаАкта", СтрокаПериода.Дата);
			МассивСтрокОтбора 			= ТаблицаВыполненияОбщая.НайтиСтроки(СтруктураОтбора);
			ТаблицаВыполненияСводная 	= ТаблицаВыполненияОбщая.Скопировать(МассивСтрокОтбора); 
		КонецЕсли;
		
		Если ТаблицаВыполненияСводная.Количество() = 0 Тогда
			Количество 	= 0;
			Цена 		= 0;
			Стоимость 	= 0;
		Иначе
			Количество 	= ТаблицаВыполненияСводная[0].ФактОбъемПроект;
			Стоимость 	= ТаблицаВыполненияСводная[0]["Стоимость" + ТипЦен];
			Если Количество > 0 Тогда
				Цена = Стоимость / Количество;
			Иначе
				Цена 		= 0;
				Стоимость 	= 0;
			КонецЕсли;
		КонецЕсли;
				
		ВыводитьВОтчет = МассивПериодовНаПечать.Найти(СтрокаПериода.Дата) <> Неопределено;
		Если ВыводитьВОтчет Тогда
			БылоВыполнениеВГоду 			= Истина;
			Область 						= Макет.ПолучитьОбласть("Строка|Месяц");
			Область.Параметры.Количество 	= Количество;
			Область.Параметры.Цена 			= Цена;
			Область.Параметры.Стоимость 	= Стоимость;
			// Если количество за месяц не заполнено, 
			// то цена ресурса за этот месяц не выводится.
			Если Количество = 0 Тогда
				Область.Параметры.Цена = 0;	
			КонецЕсли;
			ТабДок.Присоединить(Область);
		КонецЕсли;
		
		КоличествоЗаГод 	= КоличествоЗаГод + Количество;
		СтоимостьЗаГод 		= СтоимостьЗаГод + Стоимость;
		КоличествоСНачала 	= КоличествоСНачала + Количество;
		СтоимостьСНачала 	= СтоимостьСНачала + Стоимость;
	
	КонецЦикла;
		
	Область 						= Макет.ПолучитьОбласть("Строка|Год");
	Область.Параметры.Количество 	= КоличествоЗаГод;
	Область.Параметры.Стоимость 	= СтоимостьЗаГод;
	ТабДок.Присоединить(Область);
	
	Если мВыводитьОстатки Тогда
		Область 						= Макет.ПолучитьОбласть("Строка|Остатки");
		Область.Параметры.Количество	= ТекСмета.ОбъемРабот - КоличествоСНачала;
		Область.Параметры.Стоимость 	= СтоимостьРесурса - СтоимостьСНачала;
		ТабДок.Присоединить(Область);
	КонецЕсли;
		
КонецПроцедуры

Процедура ИзменитьРодителяПоРазделуРесурсы(ТекРаздел,НовыйРаздел)

	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Родитель",ТекРаздел);
	МассивСтрокРаздела = ДеревоСмет.НайтиСтроки(СтруктураОтбора);
	Для Каждого ТекЭлемент Из МассивСтрокРаздела Цикл
		Если ТипЗнч(ТекЭлемент.Смета) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			СтруктураОтбораРаздел = Новый Структура;
			СтруктураОтбораРаздел.Вставить("Раздел",ТекЭлемент.Смета);
			МассивСтрокРесурсов = ТаблицаРесурсовОбщая.НайтиСтроки(СтруктураОтбораРаздел);
			Для Каждого ТекСтрокаРесурса Из МассивСтрокРесурсов Цикл
				ТекСтрокаРесурса.Родитель = НовыйРаздел;
			КонецЦикла;
			ИзменитьРодителяПоРазделуРесурсы(ТекЭлемент.Смета,НовыйРаздел);	
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

Процедура ИзменитьРодителяПоРазделуВыполнение(ТекРаздел,НовыйРаздел)

	СтруктураОтбора 	= Новый Структура;
	СтруктураОтбора.Вставить("Родитель",ТекРаздел);
	МассивСтрокРаздела 	= ДеревоСмет.НайтиСтроки(СтруктураОтбора);
	Для Каждого ТекЭлемент Из МассивСтрокРаздела Цикл
		Если ТипЗнч(ТекЭлемент.Смета) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			СтруктураОтбораРаздел = Новый Структура;
			СтруктураОтбораРаздел.Вставить("Раздел",ТекЭлемент.Смета);
			Если ТаблицаВыполненияОбщая.Количество() > 0 Тогда
				МассивСтрокВыполнения = ТаблицаВыполненияОбщая.НайтиСтроки(СтруктураОтбораРаздел);
				Для Каждого ТекСтрокаВыполнения Из МассивСтрокВыполнения Цикл
					ТекСтрокаВыполнения.Родитель = НовыйРаздел;
				КонецЦикла;
			КонецЕсли;
			ИзменитьРодителяПоРазделуВыполнение(ТекЭлемент.Смета,НовыйРаздел);	
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуПериодов(ТаблицаАктов,ВключатьВОтчет,МесяцНачала,МесяцОкончания)
	
	// *********************************************
	// ОПРЕДЕЛЕНИЕ ПЕРИОДОВ ДЛЯ ВЫВОДА В ОТЧЕТ
	ТаблицаАктов.Свернуть("Дата");
	ТаблицаАктов.Сортировать("Дата Убыв");
	
	// ****************************************************
	// Заполнение таблицы периодов
	ОписаниеТиповЧ 	= Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла());
	ТаблицаПериодов = Новый ТаблицаЗначений;
	ТаблицаПериодов.Колонки.Добавить("Дата");
	
	// Текущий месяц
	Если ВключатьВОтчет = 1 Тогда
		
		НоваяСтрока 		= ТаблицаПериодов.Добавить();
		НоваяСтрока.Дата 	= НачалоМесяца(ТекущаяДата());
		
	// Все месяцы где было выполнение 	
	ИначеЕсли ВключатьВОтчет = 2 Тогда
		
		ТаблицаАктов.Сортировать("Дата");
		Для Каждого ТекСтрокаПериоды Из ТаблицаАктов Цикл
			НоваяСтрока 		= ТаблицаПериодов.Добавить();
			НоваяСтрока.Дата 	= ТекСтрокаПериоды.Дата;
		КонецЦикла;
		
	// Все с начала строительства
	ИначеЕсли ВключатьВОтчет = 3 Тогда
		
		// Определение даты первого акта
		Если ТаблицаАктов.Количество()> 0 Тогда
			ТаблицаАктов.Сортировать("Дата Возр");
			ТекМесяцНачала = ТаблицаАктов[0].Дата; 
		Иначе
			ТекМесяцНачала = НачалоМесяца(ТекущаяДата());
		КонецЕсли;
	
		ПоследняяДата = НачалоМесяца(ТекущаяДата());
		Пока ТекМесяцНачала <= ПоследняяДата Цикл
			НоваяСтрока 		= ТаблицаПериодов.Добавить();
			НоваяСтрока.Дата 	= ТекМесяцНачала;
			ТекМесяцНачала 		= НачалоМесяца(ДобавитьМесяц(ТекМесяцНачала,1));
		КонецЦикла;
		
	// Все месяцы из заданного периода	
	ИначеЕсли ВключатьВОтчет = 4 Тогда
		ТекМесяцНачала 		= МесяцНачала;
		ТекМесяцОкончания 	= МесяцОкончания;
		Пока ТекМесяцНачала <= ТекМесяцОкончания Цикл
			НоваяСтрока 		= ТаблицаПериодов.Добавить();
			НоваяСтрока.Дата 	= ТекМесяцНачала;
			ТекМесяцНачала 		= НачалоМесяца(ДобавитьМесяц(ТекМесяцНачала,1));
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаПериодов.Сортировать("Дата");
	МассивПериодовНаПечать = ТаблицаПериодов.ВыгрузитьКолонку("Дата");			
	ТаблицаПериодов.Очистить();
	
	// Определение даты первого акта
	Если ТаблицаАктов.Количество()> 0 Тогда
		ТаблицаАктов.Сортировать("Дата Возр");
		ТекМесяцНачала = ТаблицаАктов[0].Дата; 
	Иначе
		ТекМесяцНачала = НачалоМесяца(ТекущаяДата());
	КонецЕсли;
	
	ПоследняяДата = КонецГода(ТекущаяДата());
	Пока ТекМесяцНачала <= ПоследняяДата Цикл
		НоваяСтрока 		= ТаблицаПериодов.Добавить();
		НоваяСтрока.Дата 	= ТекМесяцНачала;
		ТекМесяцНачала 		= НачалоМесяца(ДобавитьМесяц(ТекМесяцНачала,1));
	КонецЦикла;

	// Добавляем текущий период 
	ТаблицаПериодов.Свернуть("Дата");
	ТаблицаПериодов.Сортировать("Дата");
	
КонецПроцедуры

