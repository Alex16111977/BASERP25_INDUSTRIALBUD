КонецФункции

Функция ПолучитьТаблицуСтоимостиРесурсовСметы(СписокПозиций)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СМ_НумерацияПозицийЛокальныхСмет.Позиция КАК Позиция,
	|	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве КАК НомерВДереве,
	|	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы КАК НомерВПределахСметы,
	|	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер КАК ПорНомер
	|ПОМЕСТИТЬ ТабНумерации
	|ИЗ
	|	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	|ГДЕ 
	|	СМ_НумерацияПозицийЛокальныхСмет.Позиция В (&СписокПозиций)
	|;
	|	
	|ВЫБРАТЬ
	|	СМ_СтоимостьРесурсовПозиции.Смета,
	|	СМ_СтоимостьРесурсовПозиции.Раздел,
	|	СМ_СтоимостьРесурсовПозиции.Позиция,
	|	СМ_СтоимостьРесурсовПозиции.Ресурс,
	|	СМ_СтоимостьРесурсовПозиции.Ресурс.Код КАК КодРесурса,
	|	СМ_СтоимостьРесурсовПозиции.Ресурс.ВидРесурса КАК ВидРесурса,
	|	СМ_СтоимостьРесурсовПозиции.Ресурс.ЕдиницаИзмерения КАК ЕдиницаИзмеренияРесурса,
	|	СМ_СтоимостьРесурсовПозиции.Ресурс.Наименование КАК НаименованиеРесурса,
	|	СМ_СтоимостьРесурсовПозиции.СтатусРесурса,
	|	СМ_СтоимостьРесурсовПозиции.Количество,
	|	СМ_СтоимостьРесурсовПозиции.НормаРасхода,
	|	СМ_СтоимостьРесурсовПозиции.СтоимостьБазисная,
	|	СМ_СтоимостьРесурсовПозиции.СтоимостьТекущая,
	|   СМ_СтоимостьРесурсовПозиции.Количество * СМ_СтоимостьРесурсовПозиции.Позиция.ОбъемРабот КАК РасходПоНорме,
	|	СМ_СтоимостьРесурсовПозиции.СтоимостьБазисная * СМ_СтоимостьРесурсовПозиции.Позиция.ОбъемРабот КАК СтоимостьБазиснаяПоНорме,
	|	СМ_СтоимостьРесурсовПозиции.СтоимостьТекущая * СМ_СтоимостьРесурсовПозиции.Позиция.ОбъемРабот КАК СтоимостьТекущаяПоНорме,
	|	ТабНумерации.ПорНомер КАК ПорНомер
	|ИЗ
	|	РегистрСведений.СМ_СтоимостьРесурсовПозиции КАК СМ_СтоимостьРесурсовПозиции
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТабНумерации ПО СМ_СтоимостьРесурсовПозиции.Позиция = ТабНумерации.Позиция
	|
	|ГДЕ
	|	СМ_СтоимостьРесурсовПозиции.Позиция В (&СписокПозиций) И 
	|	СМ_СтоимостьРесурсовПозиции.Смета Ссылка Документ.СМ_ЛокальнаяСмета";	
	
	Запрос.УстановитьПараметр("СписокПозиций",СписокПозиций);
	
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабРезультат;
	
КонецФункции

Функция ПолучитьТаблицуСтоимостиРесурсовАкта(СписокАктов,СписокПозиций)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_СтоимостьРесурсовПозиции.Смета.ЛокальнаяСмета КАК Смета,
	               |	СМ_СтоимостьРесурсовПозиции.Смета КАК Акт,
	               |	ЕСТЬNULL(НАЧАЛОПЕРИОДА(СМ_СтоимостьРесурсовПозиции.Смета.ПериодОт, МЕСЯЦ), НАЧАЛОПЕРИОДА(СМ_СтоимостьРесурсовПозиции.Смета.Дата, МЕСЯЦ)) КАК ДатаАкта,
	               |	СМ_СтоимостьРесурсовПозиции.Раздел,
	               |	СМ_СтоимостьРесурсовПозиции.Позиция,
	               |	СМ_СтоимостьРесурсовПозиции.Ресурс,
	               |	СМ_СтоимостьРесурсовПозиции.Ресурс.Код КАК КодРесурса,
	               |	СМ_СтоимостьРесурсовПозиции.Ресурс.ВидРесурса КАК ВидРесурса,
	               |	СМ_СтоимостьРесурсовПозиции.Ресурс.ЕдиницаИзмерения КАК ЕдиницаИзмеренияРесурса,
	               |	СМ_СтоимостьРесурсовПозиции.НаименованиеРесурса,
	               |	СМ_СтоимостьРесурсовПозиции.СтатусРесурса,
	               |	СМ_СтоимостьРесурсовПозиции.Количество,
	               |	СМ_СтоимостьРесурсовПозиции.НормаРасхода КАК РасходПоНорме,
	               |	СМ_СтоимостьРесурсовПозиции.СтоимостьБазисная,
	               |	СМ_СтоимостьРесурсовПозиции.СтоимостьТекущая,
	               |	ЗапросПозиции.СметныйКодРесурса,
	               |	ЗапросПозиции.БазиснаяЦена КАК ЦенаБазисная,
	               |	ЗапросПозиции.ТекущаяЦена КАК ЦенаТекущая,
	               |	ЗапросПозиции.РасходПоФакту,
	               |	ЗапросПроект.ТекущаяЦена КАК ЦенаТекущаяПроект,
	               |	ЗапросПроект.ФактОбъем КАК ФактОбъемПроект,
	               |	ЗапросПроект.ТекущаяСтоимМатериалов КАК ТекущаяСМ,
	               |	ЗапросПроект.ТекущаяОснЗарплата КАК ТекущаяОЗ,
	               |	ЗапросПроект.ТекущаяПрямЗатраты КАК ТекущаяПЗ
	               |ИЗ
	               |	РегистрСведений.СМ_СтоимостьРесурсовПозиции КАК СМ_СтоимостьРесурсовПозиции
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ссылка КАК Акт,
	               |			СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ресурс КАК Ресурс,
	               |			СМ_АктВыполненныхРаботРесурсыПозицийАкта.Позиция КАК Позиция,
	               |			СМ_АктВыполненныхРаботРесурсыПозицийАкта.СметныйКодРесурса КАК СметныйКодРесурса,
	               |			СМ_АктВыполненныхРаботРесурсыПозицийАкта.БазиснаяЦена КАК БазиснаяЦена,
	               |			СМ_АктВыполненныхРаботРесурсыПозицийАкта.ТекущаяЦена КАК ТекущаяЦена,
	               |			СМ_АктВыполненныхРаботРесурсыПозицийАкта.НормаРасходаОбъем КАК НормаРасходаОбъем,
	               |			СМ_АктВыполненныхРаботРесурсыПозицийАкта.ФактРасходаОбъем КАК РасходПоФакту
	               |		ИЗ
	               |			Документ.СМ_АктВыполненныхРабот.РесурсыПозицийАкта КАК СМ_АктВыполненныхРаботРесурсыПозицийАкта
	               |		ГДЕ
	               |			СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ссылка В(&СписокАктов)
	               |			И СМ_АктВыполненныхРаботРесурсыПозицийАкта.Позиция В(&СписокПозиций)
	               |			И СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ссылка.ПометкаУдаления = ЛОЖЬ) КАК ЗапросПозиции
	               |		ПО СМ_СтоимостьРесурсовПозиции.Смета = ЗапросПозиции.Акт
	               |			И СМ_СтоимостьРесурсовПозиции.Позиция = ЗапросПозиции.Позиция
	               |			И СМ_СтоимостьРесурсовПозиции.Ресурс = ЗапросПозиции.Ресурс
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			СМ_АктВыполненныхРаботПозиции.Ссылка КАК Акт,
	               |			СМ_АктВыполненныхРаботПозиции.Позиция КАК Позиция,
	               |			СМ_АктВыполненныхРаботПозиции.ТекущаяЦена КАК ТекущаяЦена,
	               |			СМ_АктВыполненныхРаботПозиции.ФактОбъем КАК ФактОбъем,
	               |			СМ_АктВыполненныхРаботПозиции.ТекущаяСтоимМатериалов КАК ТекущаяСтоимМатериалов,
	               |			СМ_АктВыполненныхРаботПозиции.ТекущаяОснЗарплата КАК ТекущаяОснЗарплата,
	               |			СМ_АктВыполненныхРаботПозиции.ТекущаяПрямЗатраты КАК ТекущаяПрямЗатраты
	               |		ИЗ
	               |			Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_АктВыполненныхРаботПозиции
	               |		ГДЕ
	               |			СМ_АктВыполненныхРаботПозиции.Ссылка В(&СписокАктов)
	               |			И СМ_АктВыполненныхРаботПозиции.Позиция В(&СписокПозиций)
	               |			И СМ_АктВыполненныхРаботПозиции.Ссылка.ПометкаУдаления = ЛОЖЬ) КАК ЗапросПроект
	               |		ПО СМ_СтоимостьРесурсовПозиции.Смета = ЗапросПроект.Акт
	               |			И СМ_СтоимостьРесурсовПозиции.Позиция = ЗапросПроект.Позиция
	               |ГДЕ
	               |	СМ_СтоимостьРесурсовПозиции.Смета В(&СписокАктов)
	               |	И СМ_СтоимостьРесурсовПозиции.Смета ССЫЛКА Документ.СМ_АктВыполненныхРабот";	
	
	Запрос.УстановитьПараметр("СписокАктов",СписокАктов);
	Запрос.УстановитьПараметр("СписокПозиций",СписокПозиций);

	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабРезультат;
	
КонецФункции

