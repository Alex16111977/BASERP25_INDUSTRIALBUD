
Перем мТолькоФактическиеРесурсы, мВыводитьОстатки, мСписокГруппировок, ТабДок, НаименованиеЦены, НаименованиеСтоимости, Макет, МассивПериодовНаПечать, ТипЦен;
Перем ТаблицаПериодов,ТаблицаРесурсовОбщая,ТаблицаВыполненияОбщая,ДеревоСмет, НаименованиеСтоимостиПоНорме, ТабПозицийСводная;

#Область ОбработчикиСобытий

// Процедура формирует табличный документ отчета (используется для печати из форм списков и элементов).
//
// Параметры:
//     Смета - ссылка на один из документов "ЛокальнаяСмета", "ОбъектнаяСмета", "СводнаяСмета" или
//		на справочник "Объекты строительства".
//
Процедура ПолучитьЗаполненныйОтчет(ДанныеОтчета,ДокументРезультат,ТолькоФактическиеРесурсы, МесяцНачала, МесяцОкончания, ВключатьВОтчет, ВыводитьОстатки = Ложь, КлючТипЦен = "ТекущиеЦены", УчитыватьКорректировки = Ложь,СписокГруппировок) Экспорт
	
	мТолькоФактическиеРесурсы 	= ТолькоФактическиеРесурсы;
	мВыводитьОстатки			= ВыводитьОстатки;
	мСписокГруппировок			= СписокГруппировок;
	
	Если КлючТипЦен = "ТекущиеЦены" Тогда
		ТипЦен 							= "Текущая";
		НаименованиеЦены    			= "ЦенаТекущая";
		НаименованиеСтоимости   		= "СтоимостьТекущая";
		НаименованиеСтоимостиПоНорме 	= "СтоимостьТекущаяПоНорме";
	Иначе
		ТипЦен 							= "Базисная";
		НаименованиеЦены    			= "ЦенаБазисная";
		НаименованиеСтоимости			= "СтоимостьБазисная";
		НаименованиеСтоимостиПоНорме 	= "СтоимостьБазиснаяПоНорме";
	КонецЕсли;

	
	ТабДок 			= ДокументРезультат;
	Макет 			= ЭтотОбъект.ПолучитьМакет("Макет");		
	ОбластьСтрока 	= Макет.ПолучитьОбласть("Смета|Основная");
	
	// ТабДок.НачатьАвтогруппировкуСтрок();
	
	// TO DO (1):
	// Логично заранее получить тут Списки ЛС, СС и ОС, чтобы использовать во всех местах, где нужно.
	// см. хамечание в ПолучитьДеревоСметПоСводнойСмете().
	
	
	СписокСмет = ДанныеОтчета.Смета;
	ЭтоСмета = ДанныеОтчета.ЭтоСмета;
	Если Не ЭтоСмета И (ТипЗнч(СписокСмет) = Тип("СправочникСсылка.СМ_ОбъектыСтроительства") ИЛИ
		 ТипЗнч(СписокСмет) = Тип("СписокЗначений")) Тогда
		ТекУровень 		= 0; 
		ТабПозицийСводная	= ПолучитьПозицииПоОбъекту(СписокСмет);
		СписокЛС			= ТабПозицийСводная.Выгрузить().ВыгрузитьКолонку("ЛокальнаяСмета");
		ТабСметСводная		= ПолучитьДеревоСметПоОбъекту(СписокСмет,СписокЛС);
		СформироватьПоОбъектуСтроительства(СписокСмет,ТекУровень,ТабДок,Макет,ОбластьСтрока,СписокЛС,ТабСметСводная, МесяцНачала, МесяцОкончания, ВключатьВОтчет);
		
	Иначе
		ТекУровень 		= 0;
		Для Каждого ЗначСписка Из СписокСмет Цикл
			ЭтоПервая = ТекУровень = 0;
			Смета = ЗначСписка.Значение;
			СформироватьПоСмете(ЭтоПервая,Смета,ТекУровень,ТабДок,Макет,ОбластьСтрока,СписокЛС,ТабСметСводная, МесяцНачала, МесяцОкончания, ВключатьВОтчет);
			ТекУровень = ТекУровень+1;
		КонецЦикла;
		
	КонецЕсли;
	
	
	// ТабДок.ЗакончитьАвтогруппировкуСтрок();
	ТабДок.НижнийКолонтитул.Выводить 		= Истина;
	ТабДок.НижнийКолонтитул.Шрифт 			= Новый Шрифт(ТабДок.НижнийКолонтитул.Шрифт,,,,Истина);
	ТабДок.НижнийКолонтитул.ТекстВЦентре 	= НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	ТабДок.ПовторятьПриПечатиСтроки 		= ТабДок.Область(3,,3);
	ТабДок.АвтоМасштаб 						= Истина;
	ТабДок.СохранятьСвойстваОтображения 	= Истина;
	ТабДок.ОтображатьСетку 					= Истина;
	ТабДок.ОриентацияСтраницы 				= ОриентацияСтраницы.Ландшафт;
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СформироватьПоОбъектуСтроительства(Смета,ТекУровень,ТабДок,Макет,ОбластьСтрока,СписокЛС,ТабСметСводная, МесяцНачала, МесяцОкончания, ВключатьВОтчет)
	ТипРаздел  			= Тип("ДокументСсылка.СМ_РазделЛокальнойСметы");
	ТипОбъектнаяСмета   = Тип("ДокументСсылка.СМ_ОбъектнаяСмета");
	ТипСводнаяСмета   	= Тип("ДокументСсылка.СМ_СводнаяСмета");
	ТипЛокальнаяСмета	= Тип("ДокументСсылка.СМ_ЛокальнаяСмета");

	
	ДеревоСмет = ТабСметСводная.Скопировать();
	
	// Получение данных по ресурсам позиций из переданного списка
	СписокПозицийСводный = Новый СписокЗначений;
	СписокПозицийСводный.ЗагрузитьЗначения(ТабПозицийСводная.Выгрузить().ВыгрузитьКолонку("Позиция"));
	
	МассивУдаляемыхРесурсов = Новый Массив;
	
	// **********************************************************************************************
	ТаблицаРесурсовОбщая = ПолучитьТаблицуСтоимостиРесурсовСметы(СписокПозицийСводный);
	ТаблицаРесурсовОбщая.Колонки.Добавить("Родитель");
	ТаблицаРесурсовОбщая.Колонки.Добавить("ОбъектнаяСмета");
	ТаблицаРесурсовОбщая.Колонки.Добавить("СводнаяСмета");
	ТаблицаРесурсовОбщая.Колонки.Добавить("ТипРесурса");
	ТаблицаРесурсовОбщая.Колонки.Добавить("Стройка");
	ТаблицаРесурсовОбщая.Колонки.Добавить("ГруппаОбъекта");
	ТаблицаРесурсовОбщая.Колонки.Добавить("ЭтоНеучтенный");
	ТаблицаРесурсовОбщая.Колонки.Добавить("ЭтоОборудование");
	ТаблицаРесурсовОбщая.Колонки.Добавить("ЭтоПозицияРесурс");
	ТаблицаРесурсовОбщая.Колонки.Добавить("ПозицияРесурс");
	
	Для Каждого ТекСтрока Из ТаблицаРесурсовОбщая Цикл
		
		ВидРасценки = ТекСтрока.Позиция.Определитель.ВидРасценки;
		
		Если ТипЗнч(ТекСтрока.Позиция.ИдРодителя) = ТипРаздел Тогда
			ТекСтрока.Раздел = ТекСтрока.Позиция.ИдРодителя;	
		Иначе
			ТекСтрока.Раздел = Документы.СМ_РазделЛокальнойСметы.ПустаяСсылка();	
		КонецЕсли;
		
		Если ТипЗнч(ТекСтрока.Смета.ИДРодителя) = ТипОбъектнаяСмета Тогда
			ТекСтрока.ОбъектнаяСмета 	= ТекСтрока.Смета.ИДРодителя;
			ТекСтрока.СводнаяСмета		= ТекСтрока.Смета.ИДРодителя.ИдРодителя;
		Иначе	
			ТекСтрока.ОбъектнаяСмета 	= Документы.СМ_ОбъектнаяСмета.ПустаяСсылка();
			ТекСтрока.СводнаяСмета		= ТекСтрока.Смета.ИДРодителя;
		КонецЕсли;
		
		ТекСтрока.ЭтоНеучтенный 	= Ложь;
		ТекСтрока.ЭтоОборудование 	= Ложь;
		ТекСтрока.ЭтоПозицияРесурс 	= Ложь;

		Если ТекСтрока.Позиция.РесурсыПозицииЛокальнойСметы.Количество() = 0 Тогда
			Если ТекСтрока.Позиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование ИЛИ 
				 ТекСтрока.Позиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал Тогда
				ТекСтрока.ЭтоОборудование 	= Истина;
				ТекСтрока.ТипРесурса 		= 1;
				
				// Позиции вынесенные за расценку или смету, которые сами являются ресурсам.
				Если НЕ ЗначениеЗаполнено(ТекСтрока.Ресурс) Тогда
					ТекСтрока.ЭтоПозицияРесурс 	= Истина; 	
					ТекСтрока.ПозицияРесурс 	= ТекСтрока.Позиция; 	
					
					Если ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал Тогда
						ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы;
					ИначеЕсли ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование Тогда 
						ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Оборудование;
					ИначеЕсли ВидРасценки = Перечисления.СМ_ВидыРасценки.Транспортировка Тогда 
						ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Транспортировка;
					ИначеЕсли ВидРасценки = Перечисления.СМ_ВидыРасценки.Работа Тогда 	
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Позиция с видом расценки работа в отчет выводиться не должна!'"));
					КонецЕсли;
				КонецЕсли;
			Иначе
				ТекСтрока.ЭтоНеучтенный	 	= Истина;
				ТекСтрока.ТипРесурса 		= 2;
			КонецЕсли;	
		КонецЕсли;
	
		ТекСтрока.Родитель 		= ТекСтрока.Позиция.ИдРодителя;
		ТекСтрока.Стройка		= ТекСтрока.Смета.Стройка;
		ТекСтрока.ГруппаОбъекта	= ТекСтрока.Смета.Стройка.Родитель;

		// Удаляем ненужные виды ресурсов
		Если НЕ ЭтотОбъект.ВыводитьМатериалы И ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
			МассивУдаляемыхРесурсов.Добавить(ТекСтрока);	
		КонецЕсли;
		
		Если НЕ ЭтотОбъект.ВыводитьТрудозатраты И 
			(ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов ИЛИ 
			ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих) Тогда
			МассивУдаляемыхРесурсов.Добавить(ТекСтрока);	
		КонецЕсли;
	
		Если НЕ ЭтотОбъект.ВыводитьМашины И  
			(ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы ИЛИ 
			ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Оборудование ИЛИ
			ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Перебазировка ИЛИ
			ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Транспортировка) Тогда
			МассивУдаляемыхРесурсов.Добавить(ТекСтрока);		
		КонецЕсли;
	
	КонецЦикла;
	
	// Удаляем ненужные строки по видам ресурсов
	Для Каждого ТекЭлемент Из МассивУдаляемыхРесурсов Цикл
		ТаблицаРесурсовОбщая.Удалить(ТекЭлемент);		
	КонецЦикла;
	
	ТабЛС = ТабСметСводная.Скопировать();
	ТабЛС.Свернуть("ЛокальнаяСмета");
	МассивЛС = ТабЛС.ВыгрузитьКолонку("ЛокальнаяСмета"); 
	
	// TO DO (1):
	// Лучше использовать списки для отбора. Замечания как в ПолучитьДеревоСметПоСводнойСмете().
	// Можно будет тогда из таблицы не выгружать, а взять сразу готовый список.

	ТаблицаВсехАктов 	= ПолучитьАктыПоЛокальнымСметам(МассивЛС);
	ТекТаблицаВсехАктов	= ТаблицаВсехАктов.Скопировать();
	ЗаполнитьТаблицуПериодов(ТекТаблицаВсехАктов,ВключатьВОтчет,МесяцНачала,МесяцОкончания);
	
	// Получение всех ресурсов по всем актам
	ТекТаблицаВсехАктов		= ТаблицаВсехАктов.Скопировать();
	ТекТаблицаВсехАктов.Свернуть("Акт");	
	СписокАктов				= ТекТаблицаВсехАктов.ВыгрузитьКолонку("Акт");
	ТаблицаВыполненияОбщая 	= ПолучитьТаблицуСтоимостиРесурсовАкта(СписокАктов,СписокПозицийСводный);
	ТаблицаВыполненияОбщая.Колонки.Добавить("Родитель");
	ТаблицаВыполненияОбщая.Колонки.Добавить("ОбъектнаяСмета");
	ТаблицаВыполненияОбщая.Колонки.Добавить("СводнаяСмета");
	ТаблицаВыполненияОбщая.Колонки.Добавить("Стройка");
	ТаблицаВыполненияОбщая.Колонки.Добавить("ГруппаОбъекта");
	
	Для Каждого ТекСтрока Из ТаблицаВыполненияОбщая Цикл
			
		Если ТипЗнч(ТекСтрока.Позиция.ИдРодителя) = ТипРаздел Тогда
			ТекСтрока.Раздел = ТекСтрока.Позиция.ИдРодителя;	
		Иначе
			ТекСтрока.Раздел = Документы.СМ_РазделЛокальнойСметы.ПустаяСсылка();	
		КонецЕсли;
		
		Если ТипЗнч(ТекСтрока.Акт.ИДРодителя) = ТипОбъектнаяСмета Тогда
			ТекСтрока.ОбъектнаяСмета 	= ТекСтрока.Акт.ИДРодителя;
			ТекСтрока.СводнаяСмета		= ТекСтрока.Акт.ИДРодителя.ИдРодителя;
		Иначе	
			ТекСтрока.ОбъектнаяСмета 	= Документы.СМ_ОбъектнаяСмета.ПустаяСсылка();
			ТекСтрока.СводнаяСмета		= ТекСтрока.Акт.ИДРодителя;
		КонецЕсли;
		
		ТекСтрока.Родитель 		= ТекСтрока.Позиция.ИдРодителя;
		ТекСтрока.Стройка		= ТекСтрока.Акт.Стройка;
		ТекСтрока.ГруппаОбъекта	= ТекСтрока.Акт.Стройка.Родитель;

	КонецЦикла;

	// Вывод шапки таблицы
	ВывестиШапкуОтчета();
	
	ТабДок.НачатьАвтогруппировкуСтрок();

	// Вывод строк в отчет
	
	ДеревоИерархия 	= ПолучитьДеревоИерархия(Смета);
	ВывестиДеревоИерархия(ДеревоИерархия,ТабДок,ОбластьСтрока);

	ТабДок.ЗакончитьАвтогруппировкуСтрок();
КонецПроцедуры	

Процедура СформироватьПоСмете(ЭтоПервая,Смета,ТекУровень,ТабДок,Макет,ОбластьСтрока,СписокЛС,ТабСметСводная, МесяцНачала, МесяцОкончания, ВключатьВОтчет)
	СтруктураОтбора = Новый Структура;
	СписокЛС = Новый Массив;
	СписокОС = Новый Массив;

	ТипРаздел  			= Тип("ДокументСсылка.СМ_РазделЛокальнойСметы");
	ТипОбъектнаяСмета   = Тип("ДокументСсылка.СМ_ОбъектнаяСмета");
	ТипСводнаяСмета   	= Тип("ДокументСсылка.СМ_СводнаяСмета");
	ТипЛокальнаяСмета	= Тип("ДокументСсылка.СМ_ЛокальнаяСмета");

	
	Если ТипЗнч(Смета) = ТипСводнаяСмета Тогда
		
		// Собираем список ЛС и ОС для отборов в запросе 
		Для Каждого ТекСтрокаСС Из Смета.Сметы Цикл
			Если ТекСтрокаСС.Смета.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(ТекСтрокаСС.Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
				СписокЛС.Добавить(ТекСтрокаСС.Смета);
			Иначе
				Для Каждого ТекСтрокаОС Из ТекСтрокаСС.Смета.ЛокальныеСметы Цикл
					Если ТекСтрокаОС.ЛокальнаяСмета.ПометкаУдаления Тогда
						Продолжить;
					КонецЕсли;
					СписокЛС.Добавить(ТекСтрокаОС.ЛокальнаяСмета);
				КонецЦикла;
				СписокОС.Добавить(ТекСтрокаСС.Смета);
			КонецЕсли;
		КонецЦикла;
		
		ТабПозицийСводная	= ПолучитьПозицииПоСводнойСмете(Смета,СписокОС,СписокЛС);
		ТабСметСводная		= ПолучитьДеревоСметПоСводнойСмете(Смета,СписокОС,СписокЛС);
		СтруктураОтбора.Вставить("СводнаяСмета",Смета);
		ПечОбъект 	= "Сводная смета: ";
		ПечИтог		= "Итого по сводной смете: ";
	ИначеЕсли ТипЗнч(Смета) = ТипОбъектнаяСмета Тогда
		
		Для Каждого ТекСтрокаОС Из Смета.ЛокальныеСметы Цикл
			Если ТекСтрокаОС.ЛокальнаяСмета.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			СписокЛС.Добавить(ТекСтрокаОС.ЛокальнаяСмета);
		КонецЦикла;
		
		ТабПозицийСводная	= ПолучитьПозицииПоОбъектнойСмете(Смета,СписокЛС);
		ТабСметСводная		= ПолучитьДеревоСметПоОбъектнойСмете(Смета,СписокЛС);
		СтруктураОтбора.Вставить("ОбъектнаяСмета",Смета);
		ПечОбъект 	= "Объектная смета: ";
		ПечИтог		= "Итого по объектной смете: ";
	ИначеЕсли ТипЗнч(Смета) = ТипЛокальнаяСмета Тогда
		ТабСметСводная		= ПолучитьДеревоСметПоЛокальнойСмете(Смета);
		ТабПозицийСводная	= ПолучитьПозицииПоЛокальнойСмете(Смета);
		СтруктураОтбора.Вставить("Смета",Смета);
		ПечОбъект 	= "Локальная смета: ";
		ПечИтог		= "Итого по локальной смете: ";
	КонецЕсли;
	
	
	ДеревоСмет = ТабСметСводная.Скопировать();
	
	// Получение данных по ресурсам позиций из переданного списка
	СписокПозицийСводный = Новый СписокЗначений;
	СписокПозицийСводный.ЗагрузитьЗначения(ТабПозицийСводная.Выгрузить().ВыгрузитьКолонку("Позиция"));
	
	МассивУдаляемыхРесурсов = Новый Массив;
	
	// **********************************************************************************************
	ТаблицаРесурсовОбщая = ПолучитьТаблицуСтоимостиРесурсовСметы(СписокПозицийСводный);
	ТаблицаРесурсовОбщая.Колонки.Добавить("Родитель");
	ТаблицаРесурсовОбщая.Колонки.Добавить("ОбъектнаяСмета");
	ТаблицаРесурсовОбщая.Колонки.Добавить("СводнаяСмета");
	ТаблицаРесурсовОбщая.Колонки.Добавить("ТипРесурса");
	ТаблицаРесурсовОбщая.Колонки.Добавить("Стройка");
	ТаблицаРесурсовОбщая.Колонки.Добавить("ГруппаОбъекта");
	ТаблицаРесурсовОбщая.Колонки.Добавить("ЭтоНеучтенный");
	ТаблицаРесурсовОбщая.Колонки.Добавить("ЭтоОборудование");
	ТаблицаРесурсовОбщая.Колонки.Добавить("ЭтоПозицияРесурс");
	ТаблицаРесурсовОбщая.Колонки.Добавить("ПозицияРесурс");
	
	Для Каждого ТекСтрока Из ТаблицаРесурсовОбщая Цикл
		
		ВидРасценки = ТекСтрока.Позиция.Определитель.ВидРасценки;
		
		Если ТипЗнч(ТекСтрока.Позиция.ИдРодителя) = ТипРаздел Тогда
			ТекСтрока.Раздел = ТекСтрока.Позиция.ИдРодителя;	
		Иначе
			ТекСтрока.Раздел = Документы.СМ_РазделЛокальнойСметы.ПустаяСсылка();	
		КонецЕсли;
		
		Если ТипЗнч(ТекСтрока.Смета.ИДРодителя) = ТипОбъектнаяСмета Тогда
			ТекСтрока.ОбъектнаяСмета 	= ТекСтрока.Смета.ИДРодителя;
			ТекСтрока.СводнаяСмета		= ТекСтрока.Смета.ИДРодителя.ИдРодителя;
		Иначе	
			ТекСтрока.ОбъектнаяСмета 	= Документы.СМ_ОбъектнаяСмета.ПустаяСсылка();
			ТекСтрока.СводнаяСмета		= ТекСтрока.Смета.ИДРодителя;
		КонецЕсли;
		
		ТекСтрока.ЭтоНеучтенный 	= Ложь;
		ТекСтрока.ЭтоОборудование 	= Ложь;
		ТекСтрока.ЭтоПозицияРесурс 	= Ложь;

		Если ТекСтрока.Позиция.РесурсыПозицииЛокальнойСметы.Количество() = 0 Тогда
			Если ТекСтрока.Позиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование ИЛИ 
				 ТекСтрока.Позиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал Тогда
				ТекСтрока.ЭтоОборудование 	= Истина;
				ТекСтрока.ТипРесурса 		= 1;
				
				// Позиции вынесенные за расценку или смету, которые сами являются ресурсам
				Если НЕ ЗначениеЗаполнено(ТекСтрока.Ресурс) Тогда
					ТекСтрока.ЭтоПозицияРесурс 	= Истина; 	
					ТекСтрока.ПозицияРесурс 	= ТекСтрока.Позиция; 	
					
					Если ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал Тогда
						ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы;
					ИначеЕсли ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование Тогда 
						ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Оборудование;
					ИначеЕсли ВидРасценки = Перечисления.СМ_ВидыРасценки.Транспортировка Тогда 
						ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Транспортировка;
					ИначеЕсли ВидРасценки = Перечисления.СМ_ВидыРасценки.Работа Тогда 	
					    Сообщение 		= Новый СообщениеПользователю();
					    Сообщение.Текст = НСтр("ru = 'Позиция с видом расценки работа в отчет выводиться не должна!'");
					    Сообщение.Сообщить();
					КонецЕсли;
				КонецЕсли;
			Иначе
				ТекСтрока.ЭтоНеучтенный	 	= Истина;
				ТекСтрока.ТипРесурса 		= 2;
			КонецЕсли;	
		КонецЕсли;
	
		ТекСтрока.Родитель 		= ТекСтрока.Позиция.ИдРодителя;
		ТекСтрока.Стройка		= ТекСтрока.Смета.Стройка;
		ТекСтрока.ГруппаОбъекта	= ТекСтрока.Смета.Стройка.Родитель;

		// Удаляем ненужные виды ресурсов
		Если НЕ ЭтотОбъект.ВыводитьМатериалы И ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
			МассивУдаляемыхРесурсов.Добавить(ТекСтрока);	
		КонецЕсли;
		
		Если НЕ ЭтотОбъект.ВыводитьТрудозатраты И 
			(ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов ИЛИ 
			ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих) Тогда
			МассивУдаляемыхРесурсов.Добавить(ТекСтрока);	
		КонецЕсли;
	
		Если НЕ ЭтотОбъект.ВыводитьМашины И  
			(ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы ИЛИ 
			ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Оборудование ИЛИ
			ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Перебазировка ИЛИ
			ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Транспортировка) Тогда
			МассивУдаляемыхРесурсов.Добавить(ТекСтрока);		
		КонецЕсли;
	
	КонецЦикла;
	
	// Удаляем ненужные строки по видам ресурсов
	Для Каждого ТекЭлемент Из МассивУдаляемыхРесурсов Цикл
		ТаблицаРесурсовОбщая.Удалить(ТекЭлемент);		
	КонецЦикла;
	
	ТабЛС = ТабСметСводная.Скопировать();
	ТабЛС.Свернуть("ЛокальнаяСмета");
	МассивЛС = ТабЛС.ВыгрузитьКолонку("ЛокальнаяСмета"); 
	
	// TO DO (1):
	// Лучше использовать списки для отбора. Замечания как в ПолучитьДеревоСметПоСводнойСмете().
	// Можно будет тогда из таблицы не выгружать, а взять сразу готовый список.

	ТаблицаВсехАктов 	= ПолучитьАктыПоЛокальнымСметам(МассивЛС);
	ТекТаблицаВсехАктов	= ТаблицаВсехАктов.Скопировать();
	ЗаполнитьТаблицуПериодов(ТекТаблицаВсехАктов,ВключатьВОтчет,МесяцНачала,МесяцОкончания);
	
	// Получение всех ресурсов по всем актам
	ТекТаблицаВсехАктов		= ТаблицаВсехАктов.Скопировать();
	ТекТаблицаВсехАктов.Свернуть("Акт");	
	СписокАктов				= ТекТаблицаВсехАктов.ВыгрузитьКолонку("Акт");
	ТаблицаВыполненияОбщая 	= ПолучитьТаблицуСтоимостиРесурсовАкта(СписокАктов,СписокПозицийСводный);
	ТаблицаВыполненияОбщая.Колонки.Добавить("Родитель");
	ТаблицаВыполненияОбщая.Колонки.Добавить("ОбъектнаяСмета");
	ТаблицаВыполненияОбщая.Колонки.Добавить("СводнаяСмета");
	ТаблицаВыполненияОбщая.Колонки.Добавить("Стройка");
	ТаблицаВыполненияОбщая.Колонки.Добавить("ГруппаОбъекта");
	
	Для Каждого ТекСтрока Из ТаблицаВыполненияОбщая Цикл
			
		Если ТипЗнч(ТекСтрока.Позиция.ИдРодителя) = ТипРаздел Тогда
			ТекСтрока.Раздел = ТекСтрока.Позиция.ИдРодителя;	
		Иначе
			ТекСтрока.Раздел = Документы.СМ_РазделЛокальнойСметы.ПустаяСсылка();	
		КонецЕсли;
		
		Если ТипЗнч(ТекСтрока.Акт.ИДРодителя) = ТипОбъектнаяСмета Тогда
			ТекСтрока.ОбъектнаяСмета 	= ТекСтрока.Акт.ИДРодителя;
			ТекСтрока.СводнаяСмета		= ТекСтрока.Акт.ИДРодителя.ИдРодителя;
		Иначе	
			ТекСтрока.ОбъектнаяСмета 	= Документы.СМ_ОбъектнаяСмета.ПустаяСсылка();
			ТекСтрока.СводнаяСмета		= ТекСтрока.Акт.ИДРодителя;
		КонецЕсли;
		
		ТекСтрока.Родитель 		= ТекСтрока.Позиция.ИдРодителя;
		ТекСтрока.Стройка		= ТекСтрока.Акт.Стройка;
		ТекСтрока.ГруппаОбъекта	= ТекСтрока.Акт.Стройка.Родитель;

	КонецЦикла;

	// Вывод шапки таблицы
	Если ЭтоПервая Тогда
		ВывестиШапкуОтчета();
	КонецЕсли;
	
	ТабДок.НачатьАвтогруппировкуСтрок();

	// Вывод строк в отчет
	
	ОбластьСтрока.Параметры.ПечОбъект 		= ПечОбъект + Смета.Наименование;
	ОбластьСтрока.Параметры.НомерПоПорядку 	= Смета.НомерСметы;
	ТабДок.Вывести(ОбластьСтрока,ТекУровень);
	ВывестиКолонкиПериодов();
	ВывестиСтроку(Смета,ТабСметСводная,ТекУровень,ОбластьСтрока);
	
	// Вывод итогов ресурсов по смете
	ОбластьСтрока.Параметры.ПечОбъект 		= ПечИтог + Смета.Наименование;
	ОбластьСтрока.Параметры.НомерПоПорядку 	= "";
	ТабДок.Вывести(ОбластьСтрока, ТекУровень + 1);
	ВывестиКолонкиПериодов();
	ВывестиРесурсыПоСмете(Смета,ТекУровень + 1,СтруктураОтбора);

	ТабДок.ЗакончитьАвтогруппировкуСтрок();
	
	ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
КонецПроцедуры

Функция ПолучитьДеревоСметПоОбъекту(СписокОбъектов,СписокЛС)

	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ
	|	ВЫБОР КОГДА СМ_НумерацияПозицийЛокальныхСмет.Позиция <> ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка) ТОГДА 
	|		СМ_НумерацияПозицийЛокальныхСмет.Позиция
	|	ИНАЧЕ 
	|		ВЫБОР КОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел <> ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка) ТОГДА 
	|			СМ_НумерацияПозицийЛокальныхСмет.Раздел
	|		ИНАЧЕ
	|			СМ_НумерацияПозицийЛокальныхСмет.Смета
	|		КОНЕЦ
	|	КОНЕЦ КАК Документ,
	|	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве КАК НомерВДереве,
	|	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы КАК НомерВПределахСметы,
	|	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер КАК ПорНомер
	|ПОМЕСТИТЬ ТабНумерации
	|ИЗ
	|	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	|ГДЕ 
	|	ВЫБОР КОГДА СМ_НумерацияПозицийЛокальныхСмет.Позиция <> ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка) ТОГДА 
	|  		СМ_НумерацияПозицийЛокальныхСмет.Позиция.ИДСметы
	|	ИНАЧЕ 
	|		ВЫБОР КОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел <> ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка) ТОГДА 
	|       	СМ_НумерацияПозицийЛокальныхСмет.Раздел.ИДСметы
	|		ИНАЧЕ
	|       	СМ_НумерацияПозицийЛокальныхСмет.Смета	
	|		КОНЕЦ
	|	КОНЕЦ В (&СписокЛС)
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СМ_СводнаяСмета.Ссылка КАК Смета,
	|	"""" КАК Родитель,
	|	СМ_СводнаяСмета.Стройка КАК Стройка,
	|	СМ_СводнаяСмета.НомерСметы КАК НомерСметы,
	|	СМ_СводнаяСмета.Наименование КАК Наименование,
	|   СМ_СводнаяСмета.Ссылка КАК СводнаяСмета,
	|	Значение(Документ.СМ_ОбъектнаяСмета.ПустаяСсылка) КАК ОбъектнаяСмета,
	|	Значение(Документ.СМ_ЛокальнаяСмета.ПустаяСсылка) КАК ЛокальнаяСмета,
	|	ИСТИНА КАК ЭтоСводная,
	|	ЛОЖЬ КАК ЭтоОбъектная,
	|	ЛОЖЬ КАК ЭтоЛокальная,
	|	ЛОЖЬ КАК ЭтоРаздел,
	|	ЛОЖЬ КАК ЭтоПозиция
	|ПОМЕСТИТЬ ТаблицаСмет
	|ИЗ
	|	Документ.СМ_СводнаяСмета КАК СМ_СводнаяСмета
	|ГДЕ 
	|	СМ_СводнаяСмета.Стройка В ИЕРАРХИИ (&ОбъектСтроительства)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СМ_ОбъектнаяСмета.Ссылка КАК Смета,
	|	СМ_ОбъектнаяСмета.ИДРодителя КАК Родитель,
	|	СМ_ОбъектнаяСмета.Стройка КАК Стройка,
	|	СМ_ОбъектнаяСмета.НомерСметы,
	|	СМ_ОбъектнаяСмета.Наименование,
	|   СМ_ОбъектнаяСмета.ИДРодителя КАК СводнаяСмета,
	|	СМ_ОбъектнаяСмета.Ссылка КАК ОбъектнаяСмета,
	|	Значение(Документ.СМ_ЛокальнаяСмета.ПустаяСсылка) КАК ЛокальнаяСмета,
	|	ЛОЖЬ КАК ЭтоСводная,
	|	ИСТИНА КАК ЭтоОбъектная,
	|	ЛОЖЬ КАК ЭтоЛокальная,
	|	ЛОЖЬ КАК ЭтоРаздел,
	|	ЛОЖЬ КАК ЭтоПозиция
	|ИЗ
	|	Документ.СМ_ОбъектнаяСмета КАК СМ_ОбъектнаяСмета 
	|ГДЕ	
	|	СМ_ОбъектнаяСмета.Стройка В ИЕРАРХИИ (&ОбъектСтроительства) 
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|	
	|ВЫБРАТЬ
	|	СМ_ЛокальнаяСмета.Ссылка КАК Смета,
	|	СМ_ЛокальнаяСмета.ИДРодителя КАК Родитель,
	|	СМ_ЛокальнаяСмета.Стройка КАК Стройка,
	|	СМ_ЛокальнаяСмета.НомерСметы,
	|	СМ_ЛокальнаяСмета.Наименование,
	|   ВЫБОР КОГДА СМ_ЛокальнаяСмета.ИДРодителя Ссылка Документ.СМ_СводнаяСмета ТОГДА
	|		СМ_ЛокальнаяСмета.ИДРодителя
	|	ИНАЧЕ
	|		Значение(Документ.СМ_СводнаяСмета.ПустаяСсылка)		
	|	КОНЕЦ КАК СводнаяСмета,
	|   ВЫБОР КОГДА СМ_ЛокальнаяСмета.ИДРодителя Ссылка Документ.СМ_ОбъектнаяСмета ТОГДА
	|		СМ_ЛокальнаяСмета.ИДРодителя
	|	ИНАЧЕ
	|		Значение(Документ.СМ_ОбъектнаяСмета.ПустаяСсылка)	
	|	КОНЕЦ КАК ОбъектнаяСмета,
	|	СМ_ЛокальнаяСмета.Ссылка КАК ЛокальнаяСмета,
	|	ЛОЖЬ КАК ЭтоСводная,
	|	ЛОЖЬ КАК ЭтоОбъектная,
	|	ИСТИНА КАК ЭтоЛокальная,
	|	ЛОЖЬ КАК ЭтоРаздел,
	|	ЛОЖЬ КАК ЭтоПозиция
	|ИЗ
	|	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	|ГДЕ 
	|	СМ_ЛокальнаяСмета.Стройка В ИЕРАРХИИ (&ОбъектСтроительства)
	| 
	|ОБЪЕДИНИТЬ ВСЕ
	|	
	|ВЫБРАТЬ 
	|	СМ_ПозицияЛокальнойСметы.Ссылка КАК Смета,
	|	СМ_ПозицияЛокальнойСметы.ИДРодителя КАК Родитель,
	|	СМ_ПозицияЛокальнойСметы.ИДСметы.Стройка КАК Стройка,
	|	СМ_ПозицияЛокальнойСметы.НомерВДереве КАК НомерСметы,
