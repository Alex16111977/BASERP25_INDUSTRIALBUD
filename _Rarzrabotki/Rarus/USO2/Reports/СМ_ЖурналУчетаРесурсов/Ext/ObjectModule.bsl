	|		ТаблицаСмет.Смета Ссылка Документ.СМ_ЛокальнаяСмета ТОГДА
	|		ТаблицаСмет.НомерСметы	
	|	ИНАЧЕ
	|		ТабНумерации.ПорНомер
	|	КОНЕЦ КАК ПорНомер,
	|	ТаблицаСмет.Наименование,
	|	ТаблицаСмет.СводнаяСмета,
	|	ТаблицаСмет.ОбъектнаяСмета,
	|	ТаблицаСмет.ЛокальнаяСмета,
	|	ТаблицаСмет.ЭтоСводная,
	|	ТаблицаСмет.ЭтоОбъектная,
	|	ТаблицаСмет.ЭтоЛокальная,
	|	ТаблицаСмет.ЭтоРаздел,
	|	ТаблицаСмет.ЭтоПозиция
	|ИЗ 
	|	ТаблицаСмет КАК ТаблицаСмет	
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТабНумерации 
	|	ПО ТаблицаСмет.Смета = ТабНумерации.Документ
	|УПОРЯДОЧИТЬ ПО 
	|	ПорНомер";

	Запрос.УстановитьПараметр("ОбъектнаяСмета", ОбъектнаяСмета);
	Запрос.УстановитьПараметр("СписокЛС", СписокЛС);

	ТабРезультат = Запрос.Выполнить().Выгрузить();

	Возврат ТабРезультат;
	
