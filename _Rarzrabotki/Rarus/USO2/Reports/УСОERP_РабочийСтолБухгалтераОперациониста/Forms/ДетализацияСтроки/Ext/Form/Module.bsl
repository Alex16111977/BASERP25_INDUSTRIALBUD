
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.Свойство("ТекстЗапроса") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	СхемаКомпоновкиДанных = Отчеты.УСОERP_РабочийСтолБухгалтераОперациониста.ПолучитьМакет("СхемаКомпоновкиДанныхДетализацияСтроки");
	
	СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Запрос = Параметры.ТекстЗапроса;
	
	АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, Новый УникальныйИдентификатор);
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновкиДанных));
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	
	// Объект строительства
	ПараметрКомпоновкиДанных = Новый ПараметрКомпоновкиДанных("ОбъектСтроительства");
	Если ПараметрКомпоновкиДанных <> Неопределено Тогда
		ПараметрКомпоновкиДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКомпоновкиДанных);
		Если ПараметрКомпоновкиДанных <> Неопределено Тогда
			ПараметрКомпоновкиДанных.Значение = Параметры.ОбъектСтроительства;
			ПараметрКомпоновкиДанных.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
			ПараметрКомпоновкиДанных.Использование = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// Контрагент
	Если НЕ (Параметры.ТипКонтрагента = "Заказчики" И Параметры.Поле = "ПБУ2_2008") Тогда
		ПараметрКомпоновкиДанных = Новый ПараметрКомпоновкиДанных("Контрагент");
		Если ПараметрКомпоновкиДанных <> Неопределено Тогда
			ПараметрКомпоновкиДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКомпоновкиДанных);
			Если ПараметрКомпоновкиДанных <> Неопределено Тогда
				ПараметрКомпоновкиДанных.Значение = Параметры.Контрагент;
				ПараметрКомпоновкиДанных.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
				ПараметрКомпоновкиДанных.Использование = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Договор
	Если НЕ (Параметры.ТипКонтрагента = "Заказчики" И Параметры.Поле = "ПБУ2_2008") Тогда
		ПараметрКомпоновкиДанных = Новый ПараметрКомпоновкиДанных("Договор");
		Если ПараметрКомпоновкиДанных <> Неопределено Тогда
			ПараметрКомпоновкиДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКомпоновкиДанных);
			Если ПараметрКомпоновкиДанных <> Неопределено Тогда
				ПараметрКомпоновкиДанных.Значение = Параметры.Договор;
				ПараметрКомпоновкиДанных.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
				ПараметрКомпоновкиДанных.Использование = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Устанавливаем период
	// Начало периода
	Если НЕ (Параметры.ТипКонтрагента = "Заказчики" И Параметры.Поле = "ПБУ2_2008") Тогда
		ПараметрКомпоновкиДанных = Новый ПараметрКомпоновкиДанных("мНачалоПериода");
		Если ПараметрКомпоновкиДанных <> Неопределено Тогда
			ПараметрКомпоновкиДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКомпоновкиДанных);
			Если ПараметрКомпоновкиДанных <> Неопределено Тогда
				ПараметрКомпоновкиДанных.Значение = ?(ЗначениеЗаполнено(Параметры.НачалоПериода), НачалоДня(Параметры.НачалоПериода), Дата("00010101000000"));
				ПараметрКомпоновкиДанных.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
				ПараметрКомпоновкиДанных.Использование = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Конец периода
	ПараметрКомпоновкиДанных = Новый ПараметрКомпоновкиДанных("мКонецПериода");
	Если ПараметрКомпоновкиДанных <> Неопределено Тогда
		ПараметрКомпоновкиДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКомпоновкиДанных);
		Если ПараметрКомпоновкиДанных <> Неопределено Тогда
			ПараметрКомпоновкиДанных.Значение = ?(ЗначениеЗаполнено(Параметры.КонецПериода), КонецДня(Параметры.КонецПериода), Дата("39991231235959"));
			ПараметрКомпоновкиДанных.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
			ПараметрКомпоновкиДанных.Использование = Истина;
		КонецЕсли;
	КонецЕсли;
	
	АдресНастроек = ПоместитьВоВременноеХранилище(КомпоновщикНастроек.ПолучитьНастройки(), ЭтаФорма.УникальныйИдентификатор);
	
	ТабличныйДокумент.Очистить();
	
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Вывод
	КомпоновщикМакетаКомпоновкиДанных = Новый КомпоновщикМакетаКомпоновкиДанных();
	Макет = КомпоновщикМакетаКомпоновкиДанных.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.ПолучитьНастройки(), ДанныеРасшифровки);
	ВыводВТабличныйДокумент = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент();
	ВыводВТабличныйДокумент.УстановитьДокумент(ТабличныйДокумент);
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных();
	ПроцессорКомпоновкиДанных.Инициализировать(Макет,, ДанныеРасшифровки);
	ВыводВТабличныйДокумент.Вывести(ПроцессорКомпоновкиДанных);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	АдресРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровки, Новый УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Регистратор = ОбработатьРасшифровку(Расшифровка, АдресРасшифровки, АдресСхемыКомпоновкиДанных);
	
	ПоказатьЗначение(,Регистратор);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбработатьРасшифровку(Расшифровка, АдресРасшифровки, АдресСхемыКомпоновкиДанных)
	
	ДанныеРасшифровки = ПолучитьИзВременногоХранилища(АдресРасшифровки);
	СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных);
	
	Поля = ДанныеРасшифровки.Элементы.Получить(Расшифровка).ПолучитьПоля();
	
	Если Поля.Количество() Тогда
		Возврат Поля[0].Значение;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции
