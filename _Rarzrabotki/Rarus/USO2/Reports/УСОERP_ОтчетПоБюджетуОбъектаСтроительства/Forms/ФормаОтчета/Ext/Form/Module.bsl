
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВариантГруппировки = "ПоВидамРабот";
	
	Если Параметры.Свойство("ДокументРасчета")
		И ЗначениеЗаполнено(Параметры.ДокументРасчета) Тогда
		Отчет.ДокументРасчета = Параметры.ДокументРасчета;
		СформироватьОтчетНаСервере();
	КонецЕсли;
	 	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	СформироватьОтчетНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчетНаСервере()
	
	Объект = Отчеты.УСОERP_ОтчетПоБюджетуОбъектаСтроительства.Создать();
	Объект.СформироватьОтчет(Отчет.ДокументРасчета, ТабличныйДокумент, ВариантГруппировки, ВыводитьДетально);
	
КонецПроцедуры
