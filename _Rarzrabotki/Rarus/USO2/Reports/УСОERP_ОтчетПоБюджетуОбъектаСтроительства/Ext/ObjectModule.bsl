
#Область ОбработчикиСобытий

Процедура СформироватьОтчет(ДокументРасчета, ТабличныйДокумент, ВариантГруппировки, ВыводитьДетально = Ложь)  Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Очистить();
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ФиксацияСверху = 7;
	ТабличныйДокумент.ФиксацияСлева  = 4;
	
	Если ВариантГруппировки = "ПоВидамРабот" Тогда
		Макет = ПолучитьМакет("МакетСГруппировкойПоВидамРабот");
	Иначе
		Макет = ПолучитьМакет("МакетСГруппировкойПоЭтапамРабот");
	КонецЕсли;
	
	ОбластьШапка	 	 = Макет.ПолучитьОбласть("Шапка|ОсновнаяЧасть");	
	ОбластьШапкаНДС	 	 = Макет.ПолучитьОбласть("Шапка|ГруппаНДС");
	
	ОбластьГруппировка	 = Макет.ПолучитьОбласть("ГруппировкаОсновная|ОсновнаяЧасть");	
	ОбластьГруппировкаНДС= Макет.ПолучитьОбласть("ГруппировкаОсновная|ГруппаНДС");	
	
	ОбластьРабота	 	 = Макет.ПолучитьОбласть("ГруппировкаПоРаботам|ОсновнаяЧасть");	
	ОбластьРаботаНДС	 = Макет.ПолучитьОбласть("ГруппировкаПоРаботам|ГруппаНДС");	
	
	ОбластьВидСтатьи	 = Макет.ПолучитьОбласть("ГруппировкаПоСтатьям|ОсновнаяЧасть");	
	ОбластьВидСтатьиНДС	 = Макет.ПолучитьОбласть("ГруппировкаПоСтатьям|ГруппаНДС");	
	
	ОбластьСтрока	 	 = Макет.ПолучитьОбласть("ОбластьСтрока|ОсновнаяЧасть");	
	ОбластьСтрокаНДС	 = Макет.ПолучитьОбласть("ОбластьСтрока|ГруппаНДС");	
	
	Если ДокументРасчета.УчитыватьНДС Тогда
		ОбластьНР	 		 = Макет.ПолучитьОбласть("ОбластьНакладныеРасходыНДС");
	Иначе
		ОбластьНР	 		 = Макет.ПолучитьОбласть("ОбластьНакладныеРасходы");
	КонецЕсли;
	
	ОбластьИтоги	 	 = Макет.ПолучитьОбласть("ОбластьИтоги|ОсновнаяЧасть");	
	ОбластьИтогиНДС	 	 = Макет.ПолучитьОбласть("ОбластьИтоги|ГруппаНДС");	
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");	
		
	СтруктураОбластей = Новый Структура();
	СтруктураОбластей.Вставить("ОбластьШапка", 			ОбластьШапка);
	СтруктураОбластей.Вставить("ОбластьГруппировка", 	ОбластьГруппировка);
	СтруктураОбластей.Вставить("ОбластьРабота", 		ОбластьРабота);
	СтруктураОбластей.Вставить("ОбластьВидСтатьи", 		ОбластьВидСтатьи);
	СтруктураОбластей.Вставить("ОбластьСтрока", 		ОбластьСтрока);
	СтруктураОбластей.Вставить("ОбластьНР", 			ОбластьНР);
	СтруктураОбластей.Вставить("ОбластьИтоги", 			ОбластьИтоги);
	СтруктураОбластей.Вставить("ОбластьПодвал", 		ОбластьПодвал);
		
	СтруктураОбластей.Вставить("ОбластьШапкаНДС", 			ОбластьШапкаНДС);
	СтруктураОбластей.Вставить("ОбластьГруппировкаНДС", 	ОбластьГруппировкаНДС);
	СтруктураОбластей.Вставить("ОбластьРаботаНДС", 			ОбластьРаботаНДС);
	СтруктураОбластей.Вставить("ОбластьВидСтатьиНДС", 		ОбластьВидСтатьиНДС);
	СтруктураОбластей.Вставить("ОбластьСтрокаНДС", 			ОбластьСтрокаНДС);
	СтруктураОбластей.Вставить("ОбластьИтогиНДС", 			ОбластьИтогиНДС);
	
	
	СтруктураОбластей.Вставить("ОбластьШапкаМатериалы", 	Макет.ПолучитьОбласть("ШапкаМатериалы|ОсновнаяЧасть"));
	СтруктураОбластей.Вставить("ОбластьСтрокаМатериалы", 	Макет.ПолучитьОбласть("СтрокаМатериалы|ОсновнаяЧасть"));
	СтруктураОбластей.Вставить("ОбластьШапкаИсполнители", 	Макет.ПолучитьОбласть("ШапкаИсполнители|ОсновнаяЧасть"));
	СтруктураОбластей.Вставить("ОбластьСтрокаИсполнители", 	Макет.ПолучитьОбласть("СтрокаИсполнители|ОсновнаяЧасть"));
	СтруктураОбластей.Вставить("ОбластьШапкаМеханизмы", 	Макет.ПолучитьОбласть("ШапкаМеханизмы|ОсновнаяЧасть"));
	СтруктураОбластей.Вставить("ОбластьСтрокаМеханизмы", 	Макет.ПолучитьОбласть("СтрокаМеханизмы|ОсновнаяЧасть"));
	
	СтруктураОбластей.Вставить("ОбластьШапкаМатериалыНДС", 		Макет.ПолучитьОбласть("ШапкаМатериалы|ГруппаНДС"));
	СтруктураОбластей.Вставить("ОбластьСтрокаМатериалыНДС", 	Макет.ПолучитьОбласть("СтрокаМатериалы|ГруппаНДС"));
	СтруктураОбластей.Вставить("ОбластьШапкаИсполнителиНДС", 	Макет.ПолучитьОбласть("ШапкаИсполнители|ГруппаНДС"));
	СтруктураОбластей.Вставить("ОбластьСтрокаИсполнителиНДС", 	Макет.ПолучитьОбласть("СтрокаИсполнители|ГруппаНДС"));
	СтруктураОбластей.Вставить("ОбластьШапкаМеханизмыНДС", 		Макет.ПолучитьОбласть("ШапкаМеханизмы|ГруппаНДС"));
	СтруктураОбластей.Вставить("ОбластьСтрокаМеханизмыНДС", 	Макет.ПолучитьОбласть("СтрокаМеханизмы|ГруппаНДС"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_БюджетСтроительстваРасценка.Ссылка,
	|	УСОERP_БюджетСтроительстваРасценка.НомерСтроки КАК НомерСтроки,
	|	УСОERP_БюджетСтроительстваРасценка.Работа,
	|	УСОERP_БюджетСтроительстваРасценка.Работа.Родитель КАК Родитель,
	|	УСОERP_БюджетСтроительстваРасценка.ОбъемРаботы,
	|	УСОERP_БюджетСтроительстваРасценка.ЕдиницаОбъема,
	|	УСОERP_БюджетСтроительстваРасценка.НачалоРаботыПлан,
	|	УСОERP_БюджетСтроительстваРасценка.ОкончаниеРаботыПлан,
	|	УСОERP_БюджетСтроительстваРасценка.ДлительностьПлан,
	|	УСОERP_БюджетСтроительстваРасценка.ЕдиницаДлительности,
	|	УСОERP_БюджетСтроительстваРасценка.ГрафикРаботы,
	|	УСОERP_БюджетСтроительстваРасценка.БазоваяСтоимость,
	|	УСОERP_БюджетСтроительстваРасценка.СтоимостьСУчетомПоправок,
	|	УСОERP_БюджетСтроительстваРасценка.НакладныеРасходы,
	|	УСОERP_БюджетСтроительстваРасценка.СтоимостьСУчетомНакладныхРасходов,
	|	УСОERP_БюджетСтроительстваРасценка.СуммаНДС,
	|	УСОERP_БюджетСтроительстваРасценка.СуммаСНДС,
	|	УСОERP_БюджетСтроительстваРасценка.Работа.СуммарнаяРабота КАК СуммарнаяРабота,
	|	УСОERP_БюджетСтроительстваРасценка.Работа.КодСДР КАК КодСДР,
	|	УСОERP_БюджетСтроительстваРасценка.Работа.ВидРабот КАК ВидРаботы
	|ИЗ
	|	Документ.УСОERP_БюджетСтроительства.Расценка КАК УСОERP_БюджетСтроительстваРасценка
	|ГДЕ
	|	УСОERP_БюджетСтроительстваРасценка.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_БюджетСтроительстваСтоимостьМатериалов.Ссылка,
	|	СУММА(УСОERP_БюджетСтроительстваСтоимостьМатериалов.Сумма) КАК БазоваяСтоимость,
	|	УСОERP_БюджетСтроительстваСтоимостьМатериалов.Работа,
	|	УСОERP_БюджетСтроительстваСтоимостьМатериалов.СтатьяРасходов КАК СтатьяРасходов,
	|	УСОERP_БюджетСтроительстваСтоимостьМатериалов.Номенклатура,
	|	УСОERP_БюджетСтроительстваСтоимостьМатериалов.Характеристика,
	|	СУММА(УСОERP_БюджетСтроительстваСтоимостьМатериалов.Количество) КАК Количество,
	|	УСОERP_БюджетСтроительстваСтоимостьМатериалов.Цена
	|ИЗ
	|	Документ.УСОERP_БюджетСтроительства.СтоимостьМатериалов КАК УСОERP_БюджетСтроительстваСтоимостьМатериалов
	|ГДЕ
	|	УСОERP_БюджетСтроительстваСтоимостьМатериалов.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_БюджетСтроительстваСтоимостьМатериалов.СтатьяРасходов,
	|	УСОERP_БюджетСтроительстваСтоимостьМатериалов.Работа,
	|	УСОERP_БюджетСтроительстваСтоимостьМатериалов.Ссылка,
	|	УСОERP_БюджетСтроительстваСтоимостьМатериалов.Номенклатура,
	|	УСОERP_БюджетСтроительстваСтоимостьМатериалов.Характеристика,
	|	УСОERP_БюджетСтроительстваСтоимостьМатериалов.Цена
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтатьяРасходов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_БюджетСтроительстваСтоимостьРесурсов.Ссылка,
	|	УСОERP_БюджетСтроительстваСтоимостьРесурсов.Работа,
	|	СУММА(УСОERP_БюджетСтроительстваСтоимостьРесурсов.Сумма) КАК БазоваяСтоимость,
	|	УСОERP_БюджетСтроительстваСтоимостьРесурсов.СтатьяРасходов КАК СтатьяРасходов,
	|	ВЫБОР
	|		КОГДА УСОERP_БюджетСтроительстваСтоимостьРесурсов.ОбъектРасценки ССЫЛКА Справочник.Должности
	|			ТОГДА ""ФОТ""
	|		ИНАЧЕ ""Автотранспорт""
	|	КОНЕЦ КАК ВидСтатьи,
	|	УСОERP_БюджетСтроительстваСтоимостьРесурсов.ОбъектРасценки,
	|	УСОERP_БюджетСтроительстваСтоимостьРесурсов.Ресурс,
	|	УСОERP_БюджетСтроительстваСтоимостьРесурсов.БазоваяЦена,
	|	УСОERP_БюджетСтроительстваСтоимостьРесурсов.ОбъемРабот
	|ИЗ
	|	Документ.УСОERP_БюджетСтроительства.СтоимостьРесурсов КАК УСОERP_БюджетСтроительстваСтоимостьРесурсов
	|ГДЕ
	|	УСОERP_БюджетСтроительстваСтоимостьРесурсов.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_БюджетСтроительстваСтоимостьРесурсов.Ссылка,
	|	УСОERP_БюджетСтроительстваСтоимостьРесурсов.СтатьяРасходов,
	|	УСОERP_БюджетСтроительстваСтоимостьРесурсов.Работа,
	|	ВЫБОР
	|		КОГДА УСОERP_БюджетСтроительстваСтоимостьРесурсов.ОбъектРасценки ССЫЛКА Справочник.Должности
	|			ТОГДА ""ФОТ""
	|		ИНАЧЕ ""Автотранспорт""
	|	КОНЕЦ,
	|	УСОERP_БюджетСтроительстваСтоимостьРесурсов.ОбъектРасценки,
	|	УСОERP_БюджетСтроительстваСтоимостьРесурсов.Ресурс,
	|	УСОERP_БюджетСтроительстваСтоимостьРесурсов.БазоваяЦена,
	|	УСОERP_БюджетСтроительстваСтоимостьРесурсов.ОбъемРабот
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтатьяРасходов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_БюджетСтроительства.СуммаНакладныхРасходов
	|ИЗ
	|	Документ.УСОERP_БюджетСтроительства КАК УСОERP_БюджетСтроительства
	|ГДЕ
	|	УСОERP_БюджетСтроительства.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокументРасчета);
	
	СтруктураВидовСтатей = Новый Структура("Материальные, ФОТ, Автотранспорт", "Материальные", "ФОТ", "Автотранспорт");
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаРабот 		= Результат[0].Выгрузить();
	ТаблицаМатериалов 	= Результат[1].Выгрузить();
	ТаблицаРесурсов 	= Результат[2].Выгрузить();
	ТаблицаНР 			= Результат[3].Выгрузить();
	
	ТаблицаРабот.Колонки.Добавить("КодСДРЧисло", Новый ОписаниеТИпов("Число"));
	ТаблицаРабот.Колонки.Добавить("ВидРаботыЧисло", Новый ОписаниеТИпов("Число"));
	Для Каждого СтрокаТЗ Из ТаблицаРабот Цикл
		КодСДР = СтрокаТЗ.КодСДР;
		СтрокаТЗ.КодСДРЧисло    = УСОERP_ОбработкаТабличныхЧастей.КодСДРвЧисло(КодСДР);
		СтрокаТЗ.ВидРаботыЧисло = ВидРаботыВЧисло(СтрокаТЗ.ВидРаботы);
	КонецЦикла;
	ТаблицаРабот.Сортировать("КодСДРЧисло");
	
	
	СтруктураТаблиц = Новый Структура("ТаблицаРабот, ТаблицаМатериалов, ТаблицаРесурсов, ТаблицаНР", ТаблицаРабот, ТаблицаМатериалов, ТаблицаРесурсов, ТаблицаНР);
	Если ВариантГруппировки = "ПоВидамРабот" Тогда
		СформироватьОтчетПоВидамРабот(ТабличныйДокумент, СтруктураОбластей, СтруктураТаблиц, СтруктураВидовСтатей, ДокументРасчета.УчитыватьНДС, ДокументРасчета , ВыводитьДетально);
	Иначе
		СформироватьОтчетПоЭтапам(ТабличныйДокумент, СтруктураОбластей, СтруктураТаблиц, СтруктураВидовСтатей, ДокументРасчета.УчитыватьНДС, ДокументРасчета, ВыводитьДетально);
	КонецЕсли;
		
	
КонецПроцедуры

Процедура СформироватьОтчетПоВидамРабот(ТабличныйДокумент, СтруктураОбластей, СтруктураТаблиц, СтруктураВидовСтатей, УчитыватьНДС, ДокументРасчета, ВыводитьДетально)
	
	ОбластьШапка	 	 = СтруктураОбластей.ОбластьШапка;	
	ОбластьГруппировка	 = СтруктураОбластей.ОбластьГруппировка;		
	ОбластьРабота	 	 = СтруктураОбластей.ОбластьРабота;    		
	ОбластьВидСтатьи	 = СтруктураОбластей.ОбластьВидСтатьи;		
	ОбластьСтрока	 	 = СтруктураОбластей.ОбластьСтрока;    		
	ОбластьНР	 		 = СтруктураОбластей.ОбластьНР;        		
	ОбластьИтоги	 	 = СтруктураОбластей.ОбластьИтоги;
	ОбластьПодвал 		 = СтруктураОбластей.ОбластьПодвал;
	
	ОбластьШапкаНДС	 	 = СтруктураОбластей.ОбластьШапкаНДС;	
	ОбластьГруппировкаНДС= СтруктураОбластей.ОбластьГруппировкаНДС;		
	ОбластьРаботаНДС	 = СтруктураОбластей.ОбластьРаботаНДС;    		
	ОбластьВидСтатьиНДС	 = СтруктураОбластей.ОбластьВидСтатьиНДС;		
	ОбластьСтрокаНДС	 = СтруктураОбластей.ОбластьСтрокаНДС;    		
	ОбластьИтогиНДС	 	 = СтруктураОбластей.ОбластьИтогиНДС;

	ОбластьШапкаМатериалы 		= СтруктураОбластей.ОбластьШапкаМатериалы;
	ОбластьСтрокаМатериалы 		= СтруктураОбластей.ОбластьСтрокаМатериалы;
	ОбластьШапкаИсполнители 	= СтруктураОбластей.ОбластьШапкаИсполнители;
	ОбластьСтрокаИсполнители 	= СтруктураОбластей.ОбластьСтрокаИсполнители;
	ОбластьШапкаМеханизмы 		= СтруктураОбластей.ОбластьШапкаМеханизмы;
	ОбластьСтрокаМеханизмы 		= СтруктураОбластей.ОбластьСтрокаМеханизмы;
	
	ОбластьШапкаМатериалыНДС 	= СтруктураОбластей.ОбластьШапкаМатериалыНДС;
	ОбластьСтрокаМатериалыНДС 	= СтруктураОбластей.ОбластьСтрокаМатериалыНДС;
	ОбластьШапкаИсполнителиНДС 	= СтруктураОбластей.ОбластьШапкаИсполнителиНДС;
	ОбластьСтрокаИсполнителиНДС = СтруктураОбластей.ОбластьСтрокаИсполнителиНДС;
	ОбластьШапкаМеханизмыНДС 	= СтруктураОбластей.ОбластьШапкаМеханизмыНДС;
	ОбластьСтрокаМеханизмыНДС 	= СтруктураОбластей.ОбластьСтрокаМеханизмыНДС;
		
		
	ТаблицаРаботОбщая 	= СтруктураТаблиц.ТаблицаРабот;
	ТаблицаМатериалов 	= СтруктураТаблиц.ТаблицаМатериалов;
	ТаблицаРесурсов 	= СтруктураТаблиц.ТаблицаРесурсов;
	ТаблицаНР 			= СтруктураТаблиц.ТаблицаНР;

	ТаблицаВидовРабот = ТаблицаРаботОбщая.Скопировать(Новый Структура("СуммарнаяРабота", Ложь));
	ТаблицаВидовРабот.Свернуть("ВидРаботы, ВидРаботыЧисло", "БазоваяСтоимость, НакладныеРасходы, СтоимостьСУчетомНакладныхРасходов, СуммаНДС, СуммаСНДС");
	ТаблицаВидовРабот.Сортировать("ВидРаботыЧисло,ВидРаботы");
	
	ТаблицаРабот = ТаблицаРаботОбщая.Скопировать( Новый Структура("СуммарнаяРабота", Ложь));

	ОбластьШапка.Параметры.Организация 			= СокрЛП(ДокументРасчета.Организация.НаименованиеПолное);
	ОбластьШапка.Параметры.НомерДокумента 		= ПрефиксацияОбъектовКлиентСервер.ПолучитьНомерНаПечать(ДокументРасчета.Номер,,);
	ОбластьШапка.Параметры.ДатаДокумента 		= Формат(ДокументРасчета.Дата, "ДЛФ=DD");
	ОбластьШапка.Параметры.ОбъектСтроительства 	= СокрЛП(ДокументРасчета.ОбъектСтроительства);  	
	ОбластьШапка.Параметры.СценарийПланирования = СокрЛП(ДокументРасчета.СценарийПланирования);  	
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	Если УчитыватьНДС Тогда
		ТабличныйДокумент.Присоединить(ОбластьШапкаНДС); 
	КонецЕсли;
	
	Для Каждого СтрокаВидРаботы Из ТаблицаВидовРабот Цикл 
		ТабличныйДокумент.НачатьАвтогруппировкуСтрок();
		
		ОбластьГруппировка.Параметры.Заполнить(СтрокаВидРаботы);
		ТабличныйДокумент.Вывести(ОбластьГруппировка,0);
		
		Если УчитыватьНДС Тогда
			ОбластьГруппировкаНДС.Параметры.Заполнить(СтрокаВидРаботы);
			ТабличныйДокумент.Присоединить(ОбластьГруппировкаНДС,0);
		КонецЕсли;
	
		МассивСтрокРабот  = ТаблицаРабот.НайтиСтроки(Новый Структура("ВидРаботы", СтрокаВидРаботы.ВидРаботы));
		
		Для Каждого СтрокаРабота Из МассивСтрокРабот Цикл
			ОбластьРабота.Параметры.Заполнить(СтрокаРабота);
			ТабличныйДокумент.Вывести(ОбластьРабота,1);
			
			Если УчитыватьНДС Тогда
				ОбластьРаботаНДС.Параметры.Заполнить(СтрокаВидРаботы);
				ТабличныйДокумент.Присоединить(ОбластьРаботаНДС,1);
			КонецЕсли;

			ТаблицаСтрокМатериалов = ТаблицаМатериалов.Скопировать(Новый Структура("Работа", СтрокаРабота.Работа));
			Если ВыводитьДетально Тогда
				ТаблицаСтатейРасходов = ТаблицаСтрокМатериалов.Скопировать();
				ТаблицаСтатейРасходов.Свернуть("СтатьяРасходов", "БазоваяСтоимость");
				Если ТаблицаСтатейРасходов.Количество()>0 Тогда     
					ОбластьВидСтатьи.Параметры.СтатьяРасходов = "Материальные";
					ОбластьВидСтатьи.Параметры.БазоваяСтоимость = ТаблицаСтрокМатериалов.Итог("БазоваяСтоимость");				
					ТабличныйДокумент.Вывести(ОбластьВидСтатьи,2); 
					
					Если УчитыватьНДС Тогда
						ТабличныйДокумент.Присоединить(ОбластьВидСтатьиНДС,2);
					КонецЕсли;
					
					Для Каждого СтрокаСтатьи Из ТаблицаСтатейРасходов Цикл
						ОбластьСтрока.Параметры.Заполнить(СтрокаСтатьи);
						ТабличныйДокумент.Вывести(ОбластьСтрока,3);
						
						Если УчитыватьНДС Тогда
							ОбластьСтрокаНДС.Параметры.Заполнить(СтрокаСтатьи);
							ТабличныйДокумент.Присоединить(ОбластьСтрокаНДС,3);
						КонецЕсли;	
						
						ТаблицаМатериаловДетально = ТаблицаСтрокМатериалов.Скопировать(Новый Структура( "СтатьяРасходов", СтрокаСтатьи.СтатьяРасходов));
						
						ТабличныйДокумент.Вывести(ОбластьШапкаМатериалы,4);
						Если УчитыватьНДС Тогда
							ТабличныйДокумент.Присоединить(ОбластьШапкаМатериалыНДС,4);
						КонецЕсли;
						НомерПП = 1;
						Для Каждого СтрокаМатериал Из ТаблицаМатериаловДетально Цикл
							ОбластьСтрокаМатериалы.Параметры.Заполнить(СтрокаМатериал);
							ОбластьСтрокаМатериалы.Параметры.Номенклатура = НоменклатураКлиентСервер.ПредставлениеНоменклатуры(СтрокаМатериал.Номенклатура, СтрокаМатериал.Характеристика);
							ОбластьСтрокаМатериалы.Параметры.НомерПП = НомерПП;
							НомерПП = НомерПП + 1;
							ТабличныйДокумент.Вывести(ОбластьСтрокаМатериалы,4);
							Если УчитыватьНДС Тогда
								ТабличныйДокумент.Присоединить(ОбластьСтрокаМатериалыНДС,4);
							КонецЕсли;
						КонецЦикла;
						
					КонецЦикла;
				КонецЕсли;
			Иначе
				ТаблицаСтрокМатериалов.Свернуть("СтатьяРасходов", "БазоваяСтоимость");
				Если ТаблицаСтрокМатериалов.Количество()>0 Тогда     
					ОбластьВидСтатьи.Параметры.СтатьяРасходов = "Материальные";
					ОбластьВидСтатьи.Параметры.БазоваяСтоимость = ТаблицаСтрокМатериалов.Итог("БазоваяСтоимость");				
					ТабличныйДокумент.Вывести(ОбластьВидСтатьи,2); 
					
					Если УчитыватьНДС Тогда
						ТабличныйДокумент.Присоединить(ОбластьВидСтатьиНДС,2);
					КонецЕсли;
					
					Для Каждого СтрокаМатериал Из ТаблицаСтрокМатериалов Цикл
						ОбластьСтрока.Параметры.Заполнить(СтрокаМатериал);
						ТабличныйДокумент.Вывести(ОбластьСтрока,3);
						
						Если УчитыватьНДС Тогда
							ОбластьСтрокаНДС.Параметры.Заполнить(СтрокаМатериал);
							ТабличныйДокумент.Присоединить(ОбластьСтрокаНДС,3);
						КонецЕсли;						
					КонецЦикла; 				
				КонецЕсли;
			КонецЕсли;
		
			ТаблицаСтрокФОТ = ТаблицаРесурсов.Скопировать(Новый Структура("Работа, ВидСтатьи", СтрокаРабота.Работа, "ФОТ"));
			Если ВыводитьДетально Тогда
				
				Если ТаблицаСтрокФОТ.Количество()>0 Тогда     
					ОбластьВидСтатьи.Параметры.СтатьяРасходов = "ФОТ";
					ОбластьВидСтатьи.Параметры.БазоваяСтоимость = ТаблицаСтрокФОТ.Итог("БазоваяСтоимость");				
					ТабличныйДокумент.Вывести(ОбластьВидСтатьи,2); 	
					
					Если УчитыватьНДС Тогда
						ТабличныйДокумент.Присоединить(ОбластьВидСтатьиНДС,2);
					КонецЕсли;
					
					ТаблицаСтатейРасходовФОТ = ТаблицаСтрокФОТ.Скопировать();
					ТаблицаСтатейРасходовФОТ.Свернуть("СтатьяРасходов", "БазоваяСтоимость");
					
					Для Каждого СтрокаСтатьяФОТ Из ТаблицаСтатейРасходовФОТ Цикл
						ОбластьСтрока.Параметры.Заполнить(СтрокаСтатьяФОТ);
						ТабличныйДокумент.Вывести(ОбластьСтрока,3);
						
						Если УчитыватьНДС Тогда
							ТабличныйДокумент.Присоединить(ОбластьСтрокаНДС,3);
						КонецЕсли;
						
						ТаблицаДетальноИсполнители = ТаблицаСтрокФОТ.Скопировать(Новый Структура("СтатьяРасходов", СтрокаСтатьяФОТ.СтатьяРасходов));
						ТаблицаДетальноИсполнители.Свернуть("ОбъектРасценки, БазоваяЦена", "ОбъемРабот, БазоваяСтоимость");
						ТабличныйДокумент.Вывести(ОбластьШапкаИсполнители,4);
						Если УчитыватьНДС Тогда
							ТабличныйДокумент.Присоединить(ОбластьШапкаИсполнителиНДС,4);
						КонецЕсли;
						
						НомерПП = 1;
						Для Каждого СтрокаИсполнитель Из ТаблицаДетальноИсполнители Цикл
							ОбластьСтрокаИсполнители.Параметры.Заполнить(СтрокаИсполнитель);
							ОбластьСтрокаИсполнители.Параметры.НомерПП = НомерПП;
							НомерПП = НомерПП + 1;   
							ТабличныйДокумент.Вывести(ОбластьСтрокаИсполнители,4);
							Если УчитыватьНДС Тогда
								ТабличныйДокумент.Присоединить(ОбластьСтрокаИсполнителиНДС,4);
							КонецЕсли;
						КонецЦикла;
					КонецЦикла; 				
				КонецЕсли;

			Иначе
				ТаблицаСтрокФОТ.Свернуть("СтатьяРасходов", "БазоваяСтоимость");
				Если ТаблицаСтрокФОТ.Количество()>0 Тогда     
					ОбластьВидСтатьи.Параметры.СтатьяРасходов = "ФОТ";
					ОбластьВидСтатьи.Параметры.БазоваяСтоимость = ТаблицаСтрокФОТ.Итог("БазоваяСтоимость");				
					ТабличныйДокумент.Вывести(ОбластьВидСтатьи,2); 	
					
					Если УчитыватьНДС Тогда
						ТабличныйДокумент.Присоединить(ОбластьВидСтатьиНДС,2);
					КонецЕсли;
					
					Для Каждого СтрокаФОТ Из ТаблицаСтрокФОТ Цикл
						ОбластьСтрока.Параметры.Заполнить(СтрокаФОТ);
						ТабличныйДокумент.Вывести(ОбластьСтрока,3);
						
						Если УчитыватьНДС Тогда
							ОбластьСтрокаНДС.Параметры.Заполнить(СтрокаФОТ);
							ТабличныйДокумент.Присоединить(ОбластьСтрокаНДС,3);
						КонецЕсли;
						
					КонецЦикла; 				
				КонецЕсли;
			КонецЕсли;
		
			ТаблицаСтрокАвтотранспорт = ТаблицаРесурсов.Скопировать(Новый Структура("Работа, ВидСтатьи", СтрокаРабота.Работа, "Автотранспорт"));
			Если ВыводитьДетально Тогда
				
				ТаблицаСтатейАвтотранспорт = ТаблицаСтрокАвтотранспорт.Скопировать();
				ТаблицаСтатейАвтотранспорт.Свернуть("СтатьяРасходов", "БазоваяСтоимость");
				Если ТаблицаСтрокАвтотранспорт.Количество()>0 Тогда     
					ОбластьВидСтатьи.Параметры.СтатьяРасходов = "Автотранспорт";
					ОбластьВидСтатьи.Параметры.БазоваяСтоимость = ТаблицаСтрокАвтотранспорт.Итог("БазоваяСтоимость");				
					ТабличныйДокумент.Вывести(ОбластьВидСтатьи,2); 	
					
					Если УчитыватьНДС Тогда
						ТабличныйДокумент.Присоединить(ОбластьВидСтатьиНДС,2);
					КонецЕсли;
					
					Для Каждого СтрокаСтатьяРасходов Из ТаблицаСтатейАвтотранспорт Цикл
						ОбластьСтрока.Параметры.Заполнить(СтрокаСтатьяРасходов);
						ТабличныйДокумент.Вывести(ОбластьСтрока,3);
						
						Если УчитыватьНДС Тогда
							ТабличныйДокумент.Присоединить(ОбластьСтрокаНДС,3);
						КонецЕсли;
						
						ТаблицаДетальноМеханизмы = ТаблицаСтрокАвтотранспорт.Скопировать(Новый Структура("СтатьяРасходов", СтрокаСтатьяРасходов.СтатьяРасходов));
						ТаблицаДетальноМеханизмы.Свернуть("ОбъектРасценки, БазоваяЦена", "ОбъемРабот, БазоваяСтоимость");
						ТабличныйДокумент.Вывести(ОбластьШапкаМеханизмы,4);
						Если УчитыватьНДС Тогда
							ТабличныйДокумент.Присоединить(ОбластьШапкаМеханизмыНДС,4);
						КонецЕсли;
						
						НомерПП = 1;
						Для Каждого СтрокаМеханизм Из ТаблицаДетальноМеханизмы Цикл
							ОбластьСтрокаМеханизмы.Параметры.Заполнить(СтрокаМеханизм);
							ОбластьСтрокаМеханизмы.Параметры.НомерПП = НомерПП;
							НомерПП = НомерПП + 1;   
							ТабличныйДокумент.Вывести(ОбластьСтрокаМеханизмы,4);
							Если УчитыватьНДС Тогда
								ТабличныйДокумент.Присоединить(ОбластьСтрокаМеханизмыНДС,4);
							КонецЕсли;
						КонецЦикла;
						
					КонецЦикла; 				
				КонецЕсли;

			Иначе
				ТаблицаСтрокАвтотранспорт.Свернуть("СтатьяРасходов", "БазоваяСтоимость");
				Если ТаблицаСтрокАвтотранспорт.Количество()>0 Тогда     
					ОбластьВидСтатьи.Параметры.СтатьяРасходов = "Автотранспорт";
					ОбластьВидСтатьи.Параметры.БазоваяСтоимость = ТаблицаСтрокАвтотранспорт.Итог("БазоваяСтоимость");				
					ТабличныйДокумент.Вывести(ОбластьВидСтатьи,2); 	
					
					Если УчитыватьНДС Тогда
						ТабличныйДокумент.Присоединить(ОбластьВидСтатьиНДС,2);
					КонецЕсли;
					
					Для Каждого СтрокаАвтотранспорт Из ТаблицаСтрокАвтотранспорт Цикл
						ОбластьСтрока.Параметры.Заполнить(СтрокаАвтотранспорт);
						ТабличныйДокумент.Вывести(ОбластьСтрока,3);
						
						Если УчитыватьНДС Тогда
							ОбластьСтрокаНДС.Параметры.Заполнить(СтрокаАвтотранспорт);
							ТабличныйДокумент.Присоединить(ОбластьСтрокаНДС,3);
						КонецЕсли;
						
					КонецЦикла; 				
				КонецЕсли;
			КонецЕсли;
		
		КонецЦикла;
		
		ТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();
	КонецЦикла;
	
	Если ТаблицаВидовРабот.Итог("НакладныеРасходы") = 0 Тогда
		ОбластьНР.Параметры.НакладныеРасходы = ТаблицаНР.Итог("СуммаНакладныхРасходов");
		ТабличныйДокумент.Вывести(ОбластьНР);
	КонецЕсли;
	
	ОбластьИтоги.Параметры.БазоваяСтоимость					 = ТаблицаВидовРабот.Итог("БазоваяСтоимость");
	ОбластьИтоги.Параметры.НакладныеРасходы					 = ТаблицаВидовРабот.Итог("НакладныеРасходы");
	ОбластьИтоги.Параметры.СтоимостьСУчетомНакладныхРасходов = ТаблицаВидовРабот.Итог("СтоимостьСУчетомНакладныхРасходов");
	ТабличныйДокумент.Вывести(ОбластьИтоги);
	
	Если УчитыватьНДС Тогда
		ОбластьИтогиНДС.Параметры.СуммаНДС 						 = ТаблицаВидовРабот.Итог("СуммаНДС");
		ОбластьИтогиНДС.Параметры.СуммаСНДС						 = ТаблицаВидовРабот.Итог("СуммаСНДС");
		
		ТабличныйДокумент.Присоединить(ОбластьИтогиНДС);
	КонецЕсли;

	ОбластьПодвал.Параметры.Ответственный = ДокументРасчета.Ответственный;
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
КонецПроцедуры

Процедура СформироватьОтчетПоЭтапам(ТабличныйДокумент, СтруктураОбластей, СтруктураТаблиц, СтруктураВидовСтатей, УчитыватьНДС, ДокументРасчета, ВыводитьДетально)
	
	ОбластьШапка	 	 = СтруктураОбластей.ОбластьШапка;
	ОбластьНР	 		 = СтруктураОбластей.ОбластьНР;        		
	ОбластьИтоги	 	 = СтруктураОбластей.ОбластьИтоги;
    ОбластьПодвал 		 = СтруктураОбластей.ОбластьПодвал;
	
	ОбластьШапкаНДС	 	 = СтруктураОбластей.ОбластьШапкаНДС;	
	ОбластьИтогиНДС	 	 = СтруктураОбластей.ОбластьИтогиНДС;

	ОбластьШапка.Параметры.Организация 			= СокрЛП(ДокументРасчета.Организация.НаименованиеПолное);
	ОбластьШапка.Параметры.НомерДокумента 		= ПрефиксацияОбъектовКлиентСервер.ПолучитьНомерНаПечать(ДокументРасчета.Номер,,);
	ОбластьШапка.Параметры.ДатаДокумента 		= Формат(ДокументРасчета.Дата, "ДЛФ=DD");
	ОбластьШапка.Параметры.ОбъектСтроительства 	= СокрЛП(ДокументРасчета.ОбъектСтроительства);
	ОбластьШапка.Параметры.СценарийПланирования = СокрЛП(ДокументРасчета.СценарийПланирования);  	
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	Если УчитыватьНДС Тогда
		ТабличныйДокумент.Присоединить(ОбластьШапкаНДС); 
	КонецЕсли;

	ТаблицаРаботОбщая 	= СтруктураТаблиц.ТаблицаРабот;
	ТаблицаНР 			= СтруктураТаблиц.ТаблицаНР;

	ДеревоРабот = СформироватьДеревоРабот(ТаблицаРаботОбщая);
	
	ВывестиДеревоРабот(ДеревоРабот, ТабличныйДокумент, СтруктураОбластей, СтруктураТаблиц, УчитыватьНДС, ВыводитьДетально);
	
	Если ТаблицаРаботОбщая.Итог("НакладныеРасходы") = 0 Тогда
		ОбластьНР.Параметры.НакладныеРасходы = ТаблицаНР.Итог("СуммаНакладныхРасходов");
		ТабличныйДокумент.Вывести(ОбластьНР);
	КонецЕсли;
	
	ТаблицаРабот = ТаблицаРаботОбщая.Скопировать(Новый Структура("СуммарнаяРабота", Ложь));
	ОбластьИтоги.Параметры.БазоваяСтоимость					 = ТаблицаРабот.Итог("БазоваяСтоимость");
	ОбластьИтоги.Параметры.НакладныеРасходы					 = ТаблицаРабот.Итог("НакладныеРасходы");
	ОбластьИтоги.Параметры.СтоимостьСУчетомНакладныхРасходов = ТаблицаРабот.Итог("СтоимостьСУчетомНакладныхРасходов");
	ТабличныйДокумент.Вывести(ОбластьИтоги);
	
	Если УчитыватьНДС Тогда
		ОбластьИтогиНДС.Параметры.СуммаНДС 						 = ТаблицаРабот.Итог("СуммаНДС");
		ОбластьИтогиНДС.Параметры.СуммаСНДС						 = ТаблицаРабот.Итог("СуммаСНДС");
		
		ТабличныйДокумент.Присоединить(ОбластьИтогиНДС);
	КонецЕсли;
	
	ОбластьПодвал.Параметры.Ответственный = ДокументРасчета.Ответственный;
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
КонецПроцедуры

Процедура ВывестиДеревоРабот(СтрокаДереваРабот, ТабличныйДокумент, СтруктураОбластей, СтруктураТаблиц, УчитыватьНДС, ВыводитьДетально)
	

	ОбластьГруппировка	 = СтруктураОбластей.ОбластьГруппировка;		
	ОбластьРабота	 	 = СтруктураОбластей.ОбластьРабота;    		
	ОбластьВидСтатьи	 = СтруктураОбластей.ОбластьВидСтатьи;		
	ОбластьСтрока	 	 = СтруктураОбластей.ОбластьСтрока;    		
		
	
	ОбластьГруппировкаНДС= СтруктураОбластей.ОбластьГруппировкаНДС;		
	ОбластьРаботаНДС	 = СтруктураОбластей.ОбластьРаботаНДС;    		
	ОбластьВидСтатьиНДС	 = СтруктураОбластей.ОбластьВидСтатьиНДС;		
	ОбластьСтрокаНДС	 = СтруктураОбластей.ОбластьСтрокаНДС;    		
	
    ОбластьШапкаМатериалы 		= СтруктураОбластей.ОбластьШапкаМатериалы;
	ОбластьСтрокаМатериалы 		= СтруктураОбластей.ОбластьСтрокаМатериалы;
	ОбластьШапкаИсполнители 	= СтруктураОбластей.ОбластьШапкаИсполнители;
	ОбластьСтрокаИсполнители 	= СтруктураОбластей.ОбластьСтрокаИсполнители;
	ОбластьШапкаМеханизмы 		= СтруктураОбластей.ОбластьШапкаМеханизмы;
	ОбластьСтрокаМеханизмы 		= СтруктураОбластей.ОбластьСтрокаМеханизмы;
	
	ОбластьШапкаМатериалыНДС 	= СтруктураОбластей.ОбластьШапкаМатериалыНДС;
	ОбластьСтрокаМатериалыНДС 	= СтруктураОбластей.ОбластьСтрокаМатериалыНДС;
	ОбластьШапкаИсполнителиНДС 	= СтруктураОбластей.ОбластьШапкаИсполнителиНДС;
	ОбластьСтрокаИсполнителиНДС = СтруктураОбластей.ОбластьСтрокаИсполнителиНДС;
	ОбластьШапкаМеханизмыНДС 	= СтруктураОбластей.ОбластьШапкаМеханизмыНДС;
	ОбластьСтрокаМеханизмыНДС 	= СтруктураОбластей.ОбластьСтрокаМеханизмыНДС;

	ТаблицаРаботОбщая 	= СтруктураТаблиц.ТаблицаРабот;
	ТаблицаМатериалов 	= СтруктураТаблиц.ТаблицаМатериалов;
	ТаблицаРесурсов 	= СтруктураТаблиц.ТаблицаРесурсов;
	
	
	Для Каждого СтрокаДерева Из  СтрокаДереваРабот.Строки Цикл
		
		ТабличныйДокумент.НачатьАвтогруппировкуСтрок();
		
		УровеньГруппировки = СтрокаДерева.УровеньСтроки;
		
		Если СтрокаДерева.СуммарнаяРабота Тогда
			ОбластьГруппировка.Параметры.Заполнить(СтрокаДерева);
			ТабличныйДокумент.Вывести(ОбластьГруппировка,УровеньГруппировки);
			
			Если УчитыватьНДС Тогда
				ОбластьГруппировкаНДС.Параметры.Заполнить(СтрокаДерева);
				ТабличныйДокумент.Присоединить(ОбластьГруппировкаНДС,УровеньГруппировки);
			КонецЕсли;
			
		иначе
			
			ОбластьРабота.Параметры.Заполнить(СтрокаДерева);
			ТабличныйДокумент.Вывести(ОбластьРабота,УровеньГруппировки);
			
			Если УчитыватьНДС Тогда
				ОбластьРаботаНДС.Параметры.Заполнить(СтрокаДерева);
				ТабличныйДокумент.Присоединить(ОбластьРаботаНДС,УровеньГруппировки);
			КонецЕсли;
			
			УровеньГруппировкиВидСтатьи = УровеньГруппировки + 1;
			УровеньГруппировкиСтроки    = УровеньГруппировки + 2;
			УровеньГруппировкиДетально  = УровеньГруппировки + 3;
			
			ТаблицаСтрокМатериалов = ТаблицаМатериалов.Скопировать(Новый Структура("Работа", СтрокаДерева.Работа));
			Если ВыводитьДетально Тогда
				ТаблицаСтатейРасходов = ТаблицаСтрокМатериалов.Скопировать();
				ТаблицаСтатейРасходов.Свернуть("СтатьяРасходов", "БазоваяСтоимость");
				Если ТаблицаСтатейРасходов.Количество()>0 Тогда     
					ОбластьВидСтатьи.Параметры.СтатьяРасходов = "Материальные";
					ОбластьВидСтатьи.Параметры.БазоваяСтоимость = ТаблицаСтрокМатериалов.Итог("БазоваяСтоимость");				
					ТабличныйДокумент.Вывести(ОбластьВидСтатьи,УровеньГруппировкиВидСтатьи); 
					
					Если УчитыватьНДС Тогда
						ТабличныйДокумент.Присоединить(ОбластьВидСтатьиНДС,УровеньГруппировкиВидСтатьи);
					КонецЕсли;
					
					Для Каждого СтрокаСтатьи Из ТаблицаСтатейРасходов Цикл
						ОбластьСтрока.Параметры.Заполнить(СтрокаСтатьи);
						ТабличныйДокумент.Вывести(ОбластьСтрока,УровеньГруппировкиСтроки);
						
						Если УчитыватьНДС Тогда
							ОбластьСтрокаНДС.Параметры.Заполнить(СтрокаСтатьи);
							ТабличныйДокумент.Присоединить(ОбластьСтрокаНДС,УровеньГруппировкиСтроки);
						КонецЕсли;	
						
						ТаблицаМатериаловДетально = ТаблицаСтрокМатериалов.Скопировать(Новый Структура( "СтатьяРасходов", СтрокаСтатьи.СтатьяРасходов));
						
						ТабличныйДокумент.Вывести(ОбластьШапкаМатериалы, УровеньГруппировкиДетально);
						Если УчитыватьНДС Тогда
							ТабличныйДокумент.Присоединить(ОбластьШапкаМатериалыНДС, УровеньГруппировкиДетально);
						КонецЕсли;
						НомерПП = 1;
						Для Каждого СтрокаМатериал Из ТаблицаМатериаловДетально Цикл
							ОбластьСтрокаМатериалы.Параметры.Заполнить(СтрокаМатериал);
							ОбластьСтрокаМатериалы.Параметры.Номенклатура = НоменклатураКлиентСервер.ПредставлениеНоменклатуры(СтрокаМатериал.Номенклатура, СтрокаМатериал.Характеристика);
							ОбластьСтрокаМатериалы.Параметры.НомерПП = НомерПП;
							НомерПП = НомерПП + 1;
							ТабличныйДокумент.Вывести(ОбластьСтрокаМатериалы, УровеньГруппировкиДетально);
							Если УчитыватьНДС Тогда
								ТабличныйДокумент.Присоединить(ОбластьСтрокаМатериалыНДС, УровеньГруппировкиДетально);
							КонецЕсли;
						КонецЦикла;
						
					КонецЦикла;
				КонецЕсли;
			Иначе
				ТаблицаСтрокМатериалов.Свернуть("СтатьяРасходов", "БазоваяСтоимость");
				Если ТаблицаСтрокМатериалов.Количество()>0 Тогда     
					ОбластьВидСтатьи.Параметры.СтатьяРасходов = "Материальные";
					ОбластьВидСтатьи.Параметры.БазоваяСтоимость = ТаблицаСтрокМатериалов.Итог("БазоваяСтоимость");				
					ТабличныйДокумент.Вывести(ОбластьВидСтатьи, УровеньГруппировкиВидСтатьи); 
					
					Если УчитыватьНДС Тогда
						ТабличныйДокумент.Присоединить(ОбластьВидСтатьиНДС, УровеньГруппировкиВидСтатьи);
					КонецЕсли;
					
					Для Каждого СтрокаМатериал Из ТаблицаСтрокМатериалов Цикл
						ОбластьСтрока.Параметры.Заполнить(СтрокаМатериал);
						ТабличныйДокумент.Вывести(ОбластьСтрока,УровеньГруппировкиСтроки);
						
						Если УчитыватьНДС Тогда
							ОбластьСтрокаНДС.Параметры.Заполнить(СтрокаМатериал);
							ТабличныйДокумент.Присоединить(ОбластьСтрокаНДС, УровеньГруппировкиСтроки);
						КонецЕсли;
						
					КонецЦикла; 				
				КонецЕсли;
			КонецЕсли;
			
			ТаблицаСтрокФОТ = ТаблицаРесурсов.Скопировать(Новый Структура("Работа, ВидСтатьи", СтрокаДерева.Работа, "ФОТ"));
			Если ВыводитьДетально Тогда
				
				Если ТаблицаСтрокФОТ.Количество()>0 Тогда     
					ОбластьВидСтатьи.Параметры.СтатьяРасходов = "ФОТ";
					ОбластьВидСтатьи.Параметры.БазоваяСтоимость = ТаблицаСтрокФОТ.Итог("БазоваяСтоимость");				
					ТабличныйДокумент.Вывести(ОбластьВидСтатьи,УровеньГруппировкиВидСтатьи); 	
					
					Если УчитыватьНДС Тогда
						ТабличныйДокумент.Присоединить(ОбластьВидСтатьиНДС, УровеньГруппировкиВидСтатьи);
					КонецЕсли;
					
					ТаблицаСтатейРасходовФОТ = ТаблицаСтрокФОТ.Скопировать();
					ТаблицаСтатейРасходовФОТ.Свернуть("СтатьяРасходов", "БазоваяСтоимость");
					
					Для Каждого СтрокаСтатьяФОТ Из ТаблицаСтатейРасходовФОТ Цикл
						ОбластьСтрока.Параметры.Заполнить(СтрокаСтатьяФОТ);
						ТабличныйДокумент.Вывести(ОбластьСтрока, УровеньГруппировкиСтроки);
						
						Если УчитыватьНДС Тогда
							ТабличныйДокумент.Присоединить(ОбластьСтрокаНДС, УровеньГруппировкиСтроки);
						КонецЕсли;
						
						ТаблицаДетальноИсполнители = ТаблицаСтрокФОТ.Скопировать(Новый Структура("СтатьяРасходов", СтрокаСтатьяФОТ.СтатьяРасходов));
						ТаблицаДетальноИсполнители.Свернуть("ОбъектРасценки, БазоваяЦена", "ОбъемРабот, БазоваяСтоимость");
						ТабличныйДокумент.Вывести(ОбластьШапкаИсполнители, УровеньГруппировкиДетально);
						Если УчитыватьНДС Тогда
							ТабличныйДокумент.Присоединить(ОбластьШапкаИсполнителиНДС, УровеньГруппировкиДетально);
						КонецЕсли;
						
						НомерПП = 1;
						Для Каждого СтрокаИсполнитель Из ТаблицаДетальноИсполнители Цикл
							ОбластьСтрокаИсполнители.Параметры.Заполнить(СтрокаИсполнитель);
							ОбластьСтрокаИсполнители.Параметры.НомерПП = НомерПП;
							НомерПП = НомерПП + 1;   
							ТабличныйДокумент.Вывести(ОбластьСтрокаИсполнители, УровеньГруппировкиДетально);
							Если УчитыватьНДС Тогда
								ТабличныйДокумент.Присоединить(ОбластьСтрокаИсполнителиНДС, УровеньГруппировкиДетально);
							КонецЕсли;
						КонецЦикла;
					КонецЦикла; 				
				КонецЕсли;
				
			Иначе
				ТаблицаСтрокФОТ.Свернуть("СтатьяРасходов", "БазоваяСтоимость");
				Если ТаблицаСтрокФОТ.Количество()>0 Тогда     
					ОбластьВидСтатьи.Параметры.СтатьяРасходов = "ФОТ";
					ОбластьВидСтатьи.Параметры.БазоваяСтоимость = ТаблицаСтрокФОТ.Итог("БазоваяСтоимость");				
					ТабличныйДокумент.Вывести(ОбластьВидСтатьи, УровеньГруппировкиВидСтатьи); 	
					
					Если УчитыватьНДС Тогда
						ТабличныйДокумент.Присоединить(ОбластьВидСтатьиНДС, УровеньГруппировкиВидСтатьи);
					КонецЕсли;
					
					Для Каждого СтрокаФОТ Из ТаблицаСтрокФОТ Цикл
						ОбластьСтрока.Параметры.Заполнить(СтрокаФОТ);
						ТабличныйДокумент.Вывести(ОбластьСтрока, УровеньГруппировкиСтроки);
						
						Если УчитыватьНДС Тогда
							ОбластьСтрокаНДС.Параметры.Заполнить(СтрокаФОТ);
							ТабличныйДокумент.Присоединить(ОбластьСтрокаНДС, УровеньГруппировкиСтроки);
						КонецЕсли;
						
					КонецЦикла; 				
				КонецЕсли;
			КонецЕсли;
		
			ТаблицаСтрокАвтотранспорт = ТаблицаРесурсов.Скопировать(Новый Структура("Работа, ВидСтатьи", СтрокаДерева.Работа, "Автотранспорт"));
			Если ВыводитьДетально Тогда
				
				ТаблицаСтатейАвтотранспорт = ТаблицаСтрокАвтотранспорт.Скопировать();
				ТаблицаСтатейАвтотранспорт.Свернуть("СтатьяРасходов", "БазоваяСтоимость");
				Если ТаблицаСтрокАвтотранспорт.Количество()>0 Тогда     
					ОбластьВидСтатьи.Параметры.СтатьяРасходов = "Автотранспорт";
					ОбластьВидСтатьи.Параметры.БазоваяСтоимость = ТаблицаСтрокАвтотранспорт.Итог("БазоваяСтоимость");				
					ТабличныйДокумент.Вывести(ОбластьВидСтатьи, УровеньГруппировкиВидСтатьи); 	
					
					Если УчитыватьНДС Тогда
						ТабличныйДокумент.Присоединить(ОбластьВидСтатьиНДС, УровеньГруппировкиВидСтатьи);
					КонецЕсли;
					
					Для Каждого СтрокаСтатьяРасходов Из ТаблицаСтатейАвтотранспорт Цикл
						ОбластьСтрока.Параметры.Заполнить(СтрокаСтатьяРасходов);
						ТабличныйДокумент.Вывести(ОбластьСтрока, УровеньГруппировкиСтроки);
						
						Если УчитыватьНДС Тогда
							ТабличныйДокумент.Присоединить(ОбластьСтрокаНДС, УровеньГруппировкиСтроки);
						КонецЕсли;
						
						ТаблицаДетальноМеханизмы = ТаблицаСтрокАвтотранспорт.Скопировать(Новый Структура("СтатьяРасходов", СтрокаСтатьяРасходов.СтатьяРасходов));
						ТаблицаДетальноМеханизмы.Свернуть("ОбъектРасценки, БазоваяЦена", "ОбъемРабот, БазоваяСтоимость");
						ТабличныйДокумент.Вывести(ОбластьШапкаМеханизмы, УровеньГруппировкиДетально);
						Если УчитыватьНДС Тогда
							ТабличныйДокумент.Присоединить(ОбластьШапкаМеханизмыНДС, УровеньГруппировкиДетально);
						КонецЕсли;
						
						НомерПП = 1;
						Для Каждого СтрокаМеханизм Из ТаблицаДетальноМеханизмы Цикл
							ОбластьСтрокаМеханизмы.Параметры.Заполнить(СтрокаМеханизм);
							ОбластьСтрокаМеханизмы.Параметры.НомерПП = НомерПП;
							НомерПП = НомерПП + 1;   
							ТабличныйДокумент.Вывести(ОбластьСтрокаМеханизмы, УровеньГруппировкиДетально);
							Если УчитыватьНДС Тогда
								ТабличныйДокумент.Присоединить(ОбластьСтрокаМеханизмыНДС, УровеньГруппировкиДетально);
							КонецЕсли;
						КонецЦикла;
						
					КонецЦикла; 				
				КонецЕсли;
				
			Иначе
				ТаблицаСтрокАвтотранспорт.Свернуть("СтатьяРасходов", "БазоваяСтоимость");
				Если ТаблицаСтрокАвтотранспорт.Количество()>0 Тогда     
					ОбластьВидСтатьи.Параметры.СтатьяРасходов = "Автотранспорт";
					ОбластьВидСтатьи.Параметры.БазоваяСтоимость = ТаблицаСтрокАвтотранспорт.Итог("БазоваяСтоимость");				
					ТабличныйДокумент.Вывести(ОбластьВидСтатьи, УровеньГруппировкиВидСтатьи); 	
					
					Если УчитыватьНДС Тогда
						ТабличныйДокумент.Присоединить(ОбластьВидСтатьиНДС, УровеньГруппировкиВидСтатьи);
					КонецЕсли;
					
					Для Каждого СтрокаАвтотранспорт Из ТаблицаСтрокАвтотранспорт Цикл
						ОбластьСтрока.Параметры.Заполнить(СтрокаАвтотранспорт);
						ТабличныйДокумент.Вывести(ОбластьСтрока, УровеньГруппировкиСтроки);
						
						Если УчитыватьНДС Тогда
							ОбластьСтрокаНДС.Параметры.Заполнить(СтрокаАвтотранспорт);
							ТабличныйДокумент.Присоединить(ОбластьСтрокаНДС, УровеньГруппировкиСтроки);
						КонецЕсли;
						
					КонецЦикла; 				
				КонецЕсли;
			КонецЕсли;
		
		КонецЕсли;
		
		Если СтрокаДереваРабот.Строки.количество()>0 Тогда
			ВывестиДеревоРабот(СтрокаДерева, ТабличныйДокумент, СтруктураОбластей, СтруктураТаблиц, УчитыватьНДС, ВыводитьДетально)
		КонецЕсли;
		
		ТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();

	КонецЦикла;  
	
КонецПроцедуры

Функция СформироватьДеревоРабот(ТаблицаРабот)
	
	ДеревоРабот = Новый деревоЗначений;
	ДеревоРабот.Колонки.Добавить("УровеньСтроки", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,0)));

	Для Каждого Колонка Из ТаблицаРабот.Колонки Цикл
		ДеревоРабот.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Для Каждого СтрокаТЗ Из ТаблицаРабот Цикл
		Родитель = СтрокаТЗ.Родитель;
		Если Не ЗначениеЗаполнено(Родитель) Тогда 
			НоваяСтрока		= ДеревоРабот.Строки.Добавить();
			НоваяСтрока.УровеньСтроки = 0;
		Иначе	
			НайденнаяСтрока = ДеревоРабот.Строки.Найти(Родитель, "Работа", Истина);	
			Если НайденнаяСтрока = Неопределено Тогда
				НоваяСтрока		= ДеревоРабот.Строки.Добавить();
				НоваяСтрока.УровеньСтроки = 0;
			Иначе
				НоваяСтрока		= НайденнаяСтрока.Строки.Добавить();
				
				УровеньСтроки = 0; 
				СтрокаДерева = НоваяСтрока;
				РодительСтроки = НоваяСтрока.Родитель;
				Пока Не РодительСтроки = Неопределено Цикл
					РодительСтроки = РодительСтроки.Родитель;
					УровеньСтроки = УровеньСтроки + 1;
				КонецЦикла;
				
				НоваяСтрока.УровеньСтроки = УровеньСтроки;
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
		
	КонецЦикла;
	
	Возврат ДеревоРабот;

КонецФункции

#КонецОбласти


#Область СлужебныеФункции

Функция ВидРаботыВЧисло(ВидРаботы) Экспорт
	СтрЧисло = "";
	Если  НЕ ВидРаботы = неопределено 
		И НЕ ВидРаботы = Справочники.УСОERP_ВидыРабот.ПустаяСсылка() Тогда
		пВидРаботы = ВидРаботы;
		Инд = 1;
		Пока Инд < СтрДлина(пВидРаботы) Цикл
			Симв = Сред(пВидРаботы, Инд, 1); 
			Если   НЕ Симв = "1" 
			     И НЕ Симв = "2"
			     И НЕ Симв = "3"
			     И НЕ Симв = "4"
			     И НЕ Симв = "5"
			     И НЕ Симв = "6"
			     И НЕ Симв = "7"
			     И НЕ Симв = "8"
			     И НЕ Симв = "9"
			     И НЕ Симв = "0"
                 Тогда Прервать
			Иначе
				СтрЧисло = СтрЧисло + Симв;									 
			КонецЕсли;
			Инд = Инд + 1;
		КонецЦикла;
	КонецЕсли; 
	Если СтрЧисло = ""  Тогда
		СтрЧисло = "0";	
	КонецЕсли; 
	ВидРаботыЧисло = Число(СтрЧисло);	
	      
	Возврат ВидРаботыЧисло;

КонецФункции

#КонецОбласти

