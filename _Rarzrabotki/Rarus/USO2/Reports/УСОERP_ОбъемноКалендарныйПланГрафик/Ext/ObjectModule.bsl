
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
#Область СлужебныйПрограммныйИнтерфейс

// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
//   Форма - УправляемаяФорма - Форма отчета.
//   КлючВарианта - Строка - Имя предопределенного варианта отчета или уникальный идентификатор пользовательского.
//   Настройки - Структура - см. возвращаемое значение ОтчетыКлиентСервер.ПолучитьНастройкиОтчетаПоУмолчанию().
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	Настройки.Вставить("РазрешеноМенятьВарианты", Ложь);
	Настройки.События.ПриСозданииНаСервере = Истина;
	Настройки.События.ПередЗагрузкойВариантаНаСервере = Истина;
КонецПроцедуры

// Вызывается в обработчике одноименного события формы отчета после выполнения кода формы.
//
// Параметры:
//   Форма - УправляемаяФорма - Форма отчета.
//   Отказ - Передается из параметров обработчика "как есть".
//   СтандартнаяОбработка - Передается из параметров обработчика "как есть".
//
// См. также:
//   "УправляемаяФорма.ПриСозданииНаСервере" в синтакс-помощнике.
//
Процедура ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка) Экспорт
	ЭтаФорма.РежимВариантаОтчета = Ложь;
КонецПроцедуры

// Вызывается в одноименном обработчике формы отчета после выполнения кода формы.
//
// Подробнее - см. ОтчетыПереопределяемый.ПередЗагрузкойВариантаНаСервере
//
Процедура ПередЗагрузкойВариантаНаСервере(ЭтаФорма, НовыеНастройкиКД) Экспорт
	
	Отчет = ЭтаФорма.Отчет;
	КомпоновщикНастроекФормы = Отчет.КомпоновщикНастроек; 
		
	НовыеНастройкиКД = КомпоновщикНастроекФормы.Настройки;

КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПользовательскиеНастройкиМодифицированы = Ложь;
	Данные = Новый ДеревоЗначений;
	
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();	
	
	СтрокаОбласти = ОпределитьОбластиВывода(НастройкиОтчета);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	//КомпоновкаДанныхСервер.УстановитьЗаголовкиМакетаКомпоновки(ПолучитьСтруктуруЗаголовковПолей(), МакетКомпоновки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Данные);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	ВывестиМакет(ДокументРезультат, Данные, СтрокаОбласти);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВывестиМакет(ДокументРезультат, Данные, СтрокаОбласти)
	
	ДокументРезультат.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ДокументРезультат.АвтоМасштаб = Истина;
	
	ТекущийЛист = Новый ТабличныйДокумент;
	
	Попытка
		Макет = УправлениеПечатью.МакетПечатнойФормы("Отчет.УСОERP_ОбъемноКалендарныйПланГрафик.Общий"); 	
	Исключение
		Макет = ПолучитьМакет("Общий");
	КонецПопытки;
	
	ОбластьШапка         = Макет.ПолучитьОбласть("Шапка");
	ОбластьЗаголовок     = Макет.ПолучитьОбласть(СокрЛП("Заголовок" + СтрокаОбласти));
	ОбластьСтрокаРабота  = Макет.ПолучитьОбласть(СокрЛП("СтрокаРабота" + СтрокаОбласти));  
	ОбластьСтрокаДетальныеЗаписи        = Макет.ПолучитьОбласть(СокрЛП("СтрокаДетальныеЗаписи" + СтрокаОбласти));
	
	ТекущийЛист.Вывести(ОбластьШапка);
	ТекущийЛист.Вывести(ОбластьЗаголовок);
	ТекущийЛист.НачатьАвтогруппировкуСтрок();
	Для Каждого ДанныеРабота Из Данные.Строки Цикл	
		ОбластьСтрокаРабота.Параметры.Заполнить(ДанныеРабота);
		ТекущийЛист.Вывести(ОбластьСтрокаРабота, 0);
		
		ТаблицаРесурсов = СместитьСтрокиОтчета(ДанныеРабота.Строки, СтрокаОбласти);
		
		Для Каждого ДанныеДетальныеЗаписи Из ТаблицаРесурсов Цикл
			Если ЗначениеЗаполнено(ДанныеДетальныеЗаписи.Номенклатура) Или ЗначениеЗаполнено(ДанныеДетальныеЗаписи.Должность) Или
				ЗначениеЗаполнено(ДанныеДетальныеЗаписи.ТипМеханизма) Тогда
				ОбластьСтрокаДетальныеЗаписи.Параметры.Заполнить(ДанныеДетальныеЗаписи);			
				ТекущийЛист.Вывести(ОбластьСтрокаДетальныеЗаписи, 1);	
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ТекущийЛист.ЗакончитьАвтогруппировкуСтрок();
	ТекущийЛист.ВывестиГоризонтальныйРазделительСтраниц();				
	
	Если ТекущийЛист.ВысотаТаблицы > 0 Тогда
		ДокументРезультат.Вывести(ТекущийЛист);
	КонецЕсли;
	
КонецПроцедуры	

Функция	ОпределитьОбластиВывода(НастройкиОтчета);
	ПараметрВыводитьДанныеОМатериалах  = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВыводитьДанныеОМатериалах"));
	ПараметрВыводитьДанныеОРабочих     = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВыводитьДанныеОРабочих"));
	ПараметрВыводитьДанныеОМеханизмах  = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВыводитьДанныеОМеханизмах"));
	
	СтрокаОбласти = "";
	
	Если ПараметрВыводитьДанныеОМатериалах.Использование И ПараметрВыводитьДанныеОМатериалах.Значение Тогда
		  СтрокаОбласти = "Материалы";
	КонецЕсли;	
	
	Если ПараметрВыводитьДанныеОРабочих.Использование И ПараметрВыводитьДанныеОРабочих.Значение Тогда	
		  СтрокаОбласти = СтрокаОбласти + "Рабочие";
	КонецЕсли;	
	
	Если ПараметрВыводитьДанныеОМеханизмах.Использование И ПараметрВыводитьДанныеОМеханизмах.Значение Тогда	
		  СтрокаОбласти = СтрокаОбласти + "Механизмы";
	КонецЕсли;	
	Возврат СтрокаОбласти;  
КонецФункции

Функция СместитьСтрокиОтчета(СтрокиДереваЗначений, СтрокаОбласти)
	ТаблицаРесурсов = Новый ТаблицаЗначений;
	ТаблицаРесурсов.Колонки.Добавить("Номенклатура",, "Номенклатура");
	ТаблицаРесурсов.Колонки.Добавить("МатериалыЕдиницаИзмерения",, "МатериалыЕдиницаИзмерения");
	ТаблицаРесурсов.Колонки.Добавить("МатериалыКоличествоНаЕдиницуОбъема",, "МатериалыКоличествоНаЕдиницуОбъема");
	ТаблицаРесурсов.Колонки.Добавить("МатериалыКоличествоНаОбъемРаботы",, "МатериалыКоличествоНаОбъемРаботы");
	ТаблицаРесурсов.Колонки.Добавить("Должность",, "Должность");
	ТаблицаРесурсов.Колонки.Добавить("РабочиеКоличество",, "РабочиеКоличество");
	ТаблицаРесурсов.Колонки.Добавить("РабочиеТрудоемкость",, "РабочиеТрудоемкость");
	ТаблицаРесурсов.Колонки.Добавить("ТипМеханизма",, "ТипМеханизма");
	ТаблицаРесурсов.Колонки.Добавить("МеханизмыКоличество",, "МеханизмыКоличество");
	ТаблицаРесурсов.Колонки.Добавить("МеханизмыМашиноемкость",, "МеханизмыМашиноемкость");
	
	КоличествоСтрок = СтрокиДереваЗначений.Количество();
	ИндексСтрокиМатериалы = 0;
	ИндексСтрокиРабочие = 0;
	ИндексСтрокиМеханизмы = 0;
	
	Для Каждого ДанныеДетальныеЗаписи Из СтрокиДереваЗначений Цикл
		НоваяСтрока = ТаблицаРесурсов.Добавить();
	КонецЦикла;
	
	Для Каждого ДанныеДетальныеЗаписи Из СтрокиДереваЗначений Цикл
		
		Если ЗначениеЗаполнено(ДанныеДетальныеЗаписи.Номенклатура) И Найти(СтрокаОбласти, "Материалы") <> 0 Тогда
			НоваяСтрока = ТаблицаРесурсов[ИндексСтрокиМатериалы];
			НоваяСтрока.Номенклатура 						= ДанныеДетальныеЗаписи.Номенклатура;
			НоваяСтрока.МатериалыЕдиницаИзмерения 			= ДанныеДетальныеЗаписи.МатериалыЕдиницаИзмерения;
			НоваяСтрока.МатериалыКоличествоНаЕдиницуОбъема 	= ДанныеДетальныеЗаписи.МатериалыКоличествоНаЕдиницуОбъема;
			НоваяСтрока.МатериалыКоличествоНаОбъемРаботы 	= ДанныеДетальныеЗаписи.МатериалыКоличествоНаОбъемРаботы;
			ИндексСтрокиМатериалы = ИндексСтрокиМатериалы + 1;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеДетальныеЗаписи.Должность)  И Найти(СтрокаОбласти, "Рабочие") <> 0 Тогда
			НоваяСтрока = ТаблицаРесурсов[ИндексСтрокиРабочие];
			НоваяСтрока.Должность 							= ДанныеДетальныеЗаписи.Должность;
			НоваяСтрока.РабочиеКоличество 					= ДанныеДетальныеЗаписи.РабочиеКоличество;
			НоваяСтрока.РабочиеТрудоемкость 				= ДанныеДетальныеЗаписи.РабочиеТрудоемкость;
			ИндексСтрокиРабочие = ИндексСтрокиРабочие + 1;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеДетальныеЗаписи.ТипМеханизма)  И Найти(СтрокаОбласти, "Механизмы") <> 0 Тогда
			НоваяСтрока = ТаблицаРесурсов[ИндексСтрокиМеханизмы];
			НоваяСтрока.ТипМеханизма 						= ДанныеДетальныеЗаписи.ТипМеханизма;
			НоваяСтрока.МеханизмыКоличество 				= ДанныеДетальныеЗаписи.МеханизмыКоличество;
			НоваяСтрока.МеханизмыМашиноемкость 				= ДанныеДетальныеЗаписи.МеханизмыМашиноемкость;
			ИндексСтрокиМеханизмы = ИндексСтрокиМеханизмы + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаРесурсов; 
КонецФункции	

#КонецОбласти

#КонецЕсли

