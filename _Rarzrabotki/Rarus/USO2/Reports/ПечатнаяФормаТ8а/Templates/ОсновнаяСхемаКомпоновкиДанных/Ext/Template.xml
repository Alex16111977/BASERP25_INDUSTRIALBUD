			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>Работа.ПодразделениеНаПечать</dataPath>
		<expression>ЗарплатаКадрыОтчеты.ПодразделениеНаПечать(Работа.Подразделение)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
