ВЫБРАТЬ
	ВТ2.ШифрБазовый,
	ВТ2.ГруппаБазовая,
	ВТ2.ШифрАналога,
	ВТ2.ШифрАналога КАК Ш1,
	ВТ2.ГруппаАналога,
	ВТ2.РесурсБазовый,
	ВТ2.РесурсАналог,
	ВТ2.Ответственный,
	ВТ2.Дата,
	ВТ2.РесурсБазовый.ЕдиницаИзмерения КАК ЕдиницаБазовая,
	ВТ2.РесурсАналог.ЕдиницаИзмерения КАК ЕдиницаАналога
ИЗ
	ВТ КАК ВТ2
ГДЕ
	ВТ2.Дата МЕЖДУ &amp;ДатаНачала И КОНЕЦПЕРИОДА(ВЫБОР
				КОГДА &amp;ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
					ТОГДА ДАТАВРЕМЯ(2050, 1, 1)
				ИНАЧЕ &amp;ДатаОкончания
			КОНЕЦ, ДЕНЬ)

СГРУППИРОВАТЬ ПО
	ВТ2.ШифрБазовый,
	ВТ2.ГруппаБазовая,
	ВТ2.ШифрАналога,
	ВТ2.ГруппаАналога,
	ВТ2.РесурсБазовый,
	ВТ2.РесурсАналог,
	ВТ2.Ответственный,
	ВТ2.Дата,
	ВТ2.РесурсБазовый.ЕдиницаИзмерения,
	ВТ2.РесурсАналог.ЕдиницаИзмерения,
	ВТ2.ШифрАналога</query>
