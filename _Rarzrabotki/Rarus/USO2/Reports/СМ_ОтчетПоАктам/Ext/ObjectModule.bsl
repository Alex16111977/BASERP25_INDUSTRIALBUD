	|			ИЛИ РесурсыАкта.Ссылка.ЛокальнаяСмета.ИДРодителя = &Смета
	|			ИЛИ РесурсыАкта.Ссылка.ЛокальнаяСмета.ИДРодителя.ИДРодителя = &Смета)
