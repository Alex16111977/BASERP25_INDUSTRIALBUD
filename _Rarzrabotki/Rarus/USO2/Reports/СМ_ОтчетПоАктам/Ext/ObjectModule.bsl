
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Процедура формирует табличный документ отчета (используется для печати из форм списков и элементов).
//
// Параметры:
//     Смета - ссылка на один из документов "ЛокальнаяСмета", "ОбъектнаяСмета", "СводнаяСмета" или
//		на справочник "Объекты строительства".
//
Процедура ПолучитьЗаполненныйОтчет(Смета,Результат,ДанныеРасшифровки,ИмяМакета) Экспорт
	ТабДок = Результат;
	Если ИмяМакета = "ДопРаботы" Тогда
		ВывестиДопРаботы(Смета,ТабДок,ИмяМакета);
	ИначеЕсли ИмяМакета = "НаСписание" Тогда
		ВывестиСписание(Смета,ТабДок,ИмяМакета);
	ИначеЕсли ИмяМакета = "ПоДефектам" Тогда
		ВывестиДефект(Смета,ТабДок,ИмяМакета);
	ИначеЕсли ИмяМакета = "Экономия" Тогда
		ВывестиЭкономия(Смета,ТабДок,ИмяМакета);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ВывестиДопРаботы(Смета,ТабДок,ИмяМакета)
	КолЗнаков = 2;
	Макет = ЭтотОбъект.ПолучитьМакет(ИмяМакета);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапроса();
	Запрос.УстановитьПараметр("Смета",Смета);
	ЭтоЛокальная = ?(ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"),Истина,Ложь);
	Запрос.УстановитьПараметр("ЭтоЛокальная",ЭтоЛокальная);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	// Вывод шапки
	СтрокаЗаголовка = НСтр("ru='Отчёт по актам на дополнительные работы по '");
	ВыводШапки(ТабДок,Макет,Смета,СтрокаЗаголовка);
	ИтогПоСмете = Новый Структура("Наименование, Итог");
	ИтогПоСмете.Итог = 0;
	
	ИтогПоОбъекту = Новый Структура("Наименование, Итог");
	ИтогПоОбъекту.Итог = 0;
	
	ИтогПоСводу= Новый Структура("Наименование, Итог");
	ИтогПоСводу.Итог = 0;
	ПрошлСмета	= "";
	ПрошлСметаОбъект	= "";
	РезультатЗапроса.Сортировать("Сводная,Объектная,Локальная");
	Для каждого СтрокаЗапроса Из РезультатЗапроса Цикл
		// Вывод заголовков, наименований смет.
		ТекСмета = СтрокаЗапроса.Локальная;
		ТекОбъектная = СтрокаЗапроса.Объектная;
		Если  ПрошлСметаОбъект <> ТекОбъектная И ТекОбъектная <> NULL Тогда
			НаименованиеОС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ОС № %1   ,%2'") ,СокрЛП(ТекОбъектная.НомерСметы) , СокрЛП(ТекОбъектная.Наименование));
			ВывестиПодзаголовок(ТабДок,Макет,НаименованиеОС);
			ПрошлСметаОбъект	=  ТекОбъектная;
			Если ИтогПоОбъекту.Итог <> 0 Тогда 
				ВывестиПодИтог(ТабДок,Макет,ИтогПоОбъекту);
				ИтогПоОбъекту.Очистить();
			КонецЕсли;	
		КонецЕсли;	
		Если ТекСмета <> ПрошлСмета  И ТекСмета <> NULL Тогда
			НаименованиеЛС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ЛС № %1   %2'") ,СокрЛП(ТекСмета.НомерСметы) , СокрЛП(ТекСмета.Наименование));
			ВывестиПодзаголовок(ТабДок,Макет,НаименованиеЛС);
			ПрошлСмета	= ТекСмета;
			Если ИтогПоСмете.Итог <> 0 Тогда
				ВывестиПодИтог(ТабДок,Макет,ИтогПоСмете);
				ИтогПоСмете.Очистить();
			КонецЕсли;	
		КонецЕсли;	
		ТекПозиция = СтрокаЗапроса.Позиция;
		ТекАкт = СтрокаЗапроса.Акт;
		Разница = СтрокаЗапроса.Разница;
		Файл = СтрокаЗапроса.Файл;
		Основание =  СтрокаЗапроса.Основание;
		// Расчет единичной стоимости с ЛЗ.
		ЕдиничныеСтоимости = ПолучитьЕдиничныеСтоимостиПозиции(ТекПозиция.Ссылка,ТекАкт.Ссылка);
		// Расчет стоимости разницы.
		Если ТекПозиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование Тогда
			СтоимВсего = Окр((ЕдиничныеСтоимости.ТекСтоимОборуд * Разница),КолЗнаков);
		Иначе
			СтоимВсего = Окр((ЕдиничныеСтоимости.ТекСтоимПрямЗатраты * Разница),КолЗнаков);
		КонецЕсли;
		
		СтоимВсего = Окр((ЕдиничныеСтоимости.ТекСтоимПрямЗатраты * Разница),КолЗнаков);
		// Вывод детальной строки.
		ВыводДетальнойСтроки(ТабДок,Макет,ТекПозиция,ЕдиничныеСтоимости,СтоимВсего,Разница,Основание,Файл);
		// Подсчет итогов.
		ИтогПоСмете.Итог = ИтогПоСмете.Итог + СтоимВсего;
		ИтогПоСмете.Наименование = НаименованиеЛС;
		Если ЭтоЛокальная = Ложь Тогда
			ИтогПоОбъекту.Итог = ИтогПоОбъекту.Итог + СтоимВсего;
			ИтогПоОбъекту.Наименование = НаименованиеОС; 
			ИтогПоСводу.Итог = ИтогПоСводу.Итог + СтоимВсего;
			ИтогПоСводу.Наименование = "";
		КонецЕсли;
		
	КонецЦикла;	
	
	// Вывод результирующих итогов.
	ВывестиПодИтог(ТабДок,Макет,ИтогПоСмете);
	Если ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета")Тогда
		ВывестиПодИтог(ТабДок,Макет,ИтогПоОбъекту);
	ИначеЕсли ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		ВывестиПодИтог(ТабДок,Макет,ИтогПоОбъекту);
		ИтогПоСводу.Наименование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='СС № %1   %2'"), СокрЛП(Смета.НомерСметы), СокрЛП(Смета.Наименование));
		ВывестиПодИтог(ТабДок,Макет,ИтогПоСводу);
	КонецЕсли;	
КонецПроцедуры

Процедура ВывестиСписание(Смета,ТабДок,ИмяМакета)
	КолЗнаков = 2;
	Макет = ЭтотОбъект.ПолучитьМакет(ИмяМакета);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаСписание();
	Запрос.УстановитьПараметр("Смета",Смета);
	ЭтоЛокальная = ?(ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"),Истина,Ложь);
	Запрос.УстановитьПараметр("ЭтоЛокальная",ЭтоЛокальная);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	// Вывод шапки
	СтрокаЗаголовка = НСтр("ru='Отчёт по актам на списание материалов за прошедший период по '");
	
	ВыводШапки(ТабДок,Макет,Смета,СтрокаЗаголовка);
	
	ИтогПоСмете = Новый Структура("Наименование, Итог");
	ИтогПоСмете.Итог = 0;
	
	ИтогПоОбъекту = Новый Структура("Наименование, Итог");
	ИтогПоОбъекту.Итог = 0;
	
	ИтогПоСводу= Новый Структура("Наименование, Итог");
	ИтогПоСводу.Итог = 0;
	ПрошлСмета	= "";
	ПрошлАкт	= "";
	ПрошлСметаОбъект	= "";
	НаименованиеОС = "";
	РезультатЗапроса.Сортировать("Сводная,Объектная,Локальная,ТекущийАкт");
	РезультатЗапроса.Свернуть("Объектная,Локальная,Ресурс,ТекущийАкт,Акт,Цена","Разница");
	Для каждого СтрокаЗапроса Из РезультатЗапроса Цикл
		// Вывод заголовков, наименований смет.
		ТекСмета = СтрокаЗапроса.Локальная;
		ТекОбъектная = СтрокаЗапроса.Объектная;
		ТекущийАкт = СтрокаЗапроса.ТекущийАкт; 
		Если  ПрошлСметаОбъект <> ТекОбъектная И ТекОбъектная <> NULL Тогда
			НаименованиеОС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ОС № %1   ,%2'") ,СокрЛП(ТекОбъектная.НомерСметы) , СокрЛП(ТекОбъектная.Наименование));
			ВывестиПодзаголовок(ТабДок,Макет,НаименованиеОС);
			ПрошлСметаОбъект	=  ТекОбъектная;
			Если ИтогПоОбъекту.Итог <> 0 Тогда 
				ВывестиПодИтог(ТабДок,Макет,ИтогПоОбъекту);
				ИтогПоОбъекту.Очистить();
			КонецЕсли;	
		КонецЕсли;	
		Если ТекСмета <> ПрошлСмета  И ТекСмета <> NULL Тогда
			НаименованиеЛС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ЛС № %1   %2'") ,СокрЛП(ТекСмета.НомерСметы) , СокрЛП(ТекСмета.Наименование));
			ВывестиПодзаголовок(ТабДок,Макет,НаименованиеЛС);
			ПрошлСмета	= ТекСмета;
			Если ИтогПоСмете.Итог <> 0 Тогда
				ВывестиПодИтог(ТабДок,Макет,ИтогПоСмете);
				ИтогПоСмете.Очистить();
			КонецЕсли;	
		КонецЕсли;	
		Если ТекущийАкт <> ПрошлАкт  И ТекущийАкт <> NULL Тогда
			НаименованиеАкт = НСтр("ru='Акт выполненных работ № '");
			НаименованиеАкт = НаименованиеАкт + СокрЛП(ТекущийАкт.НомерАкта);
			НаименованиеАкт = НаименованиеАкт + НСтр("ru=' от  '") + Формат(ТекущийАкт.Дата,"ДФ = dd.MM.yyyy") + " г.";
			ВывестиПодзаголовок(ТабДок,Макет,НаименованиеАкт);
			ПрошлАкт	= ТекущийАкт;
		КонецЕсли;	
		ТекРесурс = СтрокаЗапроса.Ресурс;
		ТекАкт = СтрокаЗапроса.Акт;
		Разница = СтрокаЗапроса.Разница;
		Файл = СтрокаЗапроса.Акт;
		Основание =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Списание материалов за прошлый период не списанных по акту  %1  от %2 г. '"), СокрЛП(Файл.НомерАкта), Формат(ТекущийАкт.Дата,"ДФ = dd.MM.yyyy")) ;
		Основание =  Основание + НаименованиеЛС; 
		Основание =  Основание + " " + НаименованиеОС; 
		
		СтоимостьЕдиницы = СтрокаЗапроса.Цена;
		
		// ЛЗ не считаем. 
		// Расчет стоимости разницы.
		СтоимВсего = Окр((СтоимостьЕдиницы * Разница),КолЗнаков);
		// Вывод детальной строки.
		ВыводДетальнойСтрокиСписание(ТабДок,Макет,ТекРесурс,СтоимостьЕдиницы,СтоимВсего,Разница,Основание,Файл,Истина);
		// Подсчет итогов.
		ИтогПоСмете.Итог = ИтогПоСмете.Итог + СтоимВсего;
		ИтогПоСмете.Наименование = НаименованиеЛС;
		Если ЭтоЛокальная = Ложь Тогда
			ИтогПоОбъекту.Итог = ИтогПоОбъекту.Итог + СтоимВсего;
			ИтогПоОбъекту.Наименование = НаименованиеОС; 
			ИтогПоСводу.Итог = ИтогПоСводу.Итог + СтоимВсего;
			ИтогПоСводу.Наименование = "";
		КонецЕсли;
	КонецЦикла;
	// Вывод результирующих итогов.
	ВывестиПодИтог(ТабДок,Макет,ИтогПоСмете);
	Если ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета")Тогда
		ВывестиПодИтог(ТабДок,Макет,ИтогПоОбъекту);
	ИначеЕсли ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		ВывестиПодИтог(ТабДок,Макет,ИтогПоОбъекту);
		ИтогПоСводу.Наименование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='СС № %1   %2'"), СокрЛП(Смета.НомерСметы), СокрЛП(Смета.Наименование));
		ВывестиПодИтог(ТабДок,Макет,ИтогПоСводу);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ВывестиДефект(Смета,ТабДок,ИмяМакета)
	КолЗнаков = 2;
	Макет = ЭтотОбъект.ПолучитьМакет(ИмяМакета);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаДефект();
	Запрос.УстановитьПараметр("Смета",Смета);
	ЭтоЛокальная = ?(ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"),Истина,Ложь);
	Запрос.УстановитьПараметр("ЭтоЛокальная",ЭтоЛокальная);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	// Вывод шапки
	СтрокаЗаголовка =  НСтр("ru='Отчёт по дефектным актам по '");
	
	ВыводШапки(ТабДок,Макет,Смета,СтрокаЗаголовка);
	ИтогПоСмете = Новый Структура("Наименование, Итог");
	ИтогПоСмете.Итог = 0;
	
	ИтогПоОбъекту = Новый Структура("Наименование, Итог");
	ИтогПоОбъекту.Итог = 0;
	
	ИтогПоСводу= Новый Структура("Наименование, Итог");
	ИтогПоСводу.Итог = 0;
	ПрошлСмета	= "";
	ПрошлСметаОбъект	= "";
	РезультатЗапроса.Сортировать("Сводная,Объектная,Локальная");
	РезультатЗапроса.Свернуть("Объектная,Локальная,Ресурс,Файл,Основание,Цена","Разница");
	Для каждого СтрокаЗапроса Из РезультатЗапроса Цикл
		// Вывод заголовков, наименований смет.
		ТекСмета = СтрокаЗапроса.Локальная;
		ТекОбъектная = СтрокаЗапроса.Объектная;
		Если  ПрошлСметаОбъект <> ТекОбъектная И ТекОбъектная <> NULL Тогда
			НаименованиеОС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ОС № %1   ,%2'") ,СокрЛП(ТекОбъектная.НомерСметы) , СокрЛП(ТекОбъектная.Наименование));
			ВывестиПодзаголовок(ТабДок,Макет,НаименованиеОС);
			ПрошлСметаОбъект	=  ТекОбъектная;
			Если ИтогПоОбъекту.Итог <> 0 Тогда 
				ВывестиПодИтог(ТабДок,Макет,ИтогПоОбъекту);
				ИтогПоОбъекту.Очистить();
			КонецЕсли;	
		КонецЕсли;	
		Если ТекСмета <> ПрошлСмета  И ТекСмета <> NULL Тогда
			НаименованиеЛС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ЛС № %1   %2'") ,СокрЛП(ТекСмета.НомерСметы) , СокрЛП(ТекСмета.Наименование));
			ВывестиПодзаголовок(ТабДок,Макет,НаименованиеЛС);
			ПрошлСмета	= ТекСмета;
			Если ИтогПоСмете.Итог <> 0 Тогда
				ВывестиПодИтог(ТабДок,Макет,ИтогПоСмете);
				ИтогПоСмете.Очистить();
			КонецЕсли;	
		КонецЕсли;	
		ТекРесурс = СтрокаЗапроса.Ресурс;
		Разница = СтрокаЗапроса.Разница;
		Файл = СтрокаЗапроса.Файл;
		Основание =  СтрокаЗапроса.Основание;
		
		СтоимостьЕдиницы = СтрокаЗапроса.Цена;
		
		СтоимВсего = Окр((СтоимостьЕдиницы * Разница),КолЗнаков);
		// Вывод детальной строки.
		ВыводДетальнойСтрокиСписание(ТабДок,Макет,ТекРесурс,СтоимостьЕдиницы,СтоимВсего,Разница,Основание,Файл);
		// Подсчет итогов.
		ИтогПоСмете.Итог = ИтогПоСмете.Итог + СтоимВсего;
		ИтогПоСмете.Наименование = НаименованиеЛС;
		Если ЭтоЛокальная = Ложь Тогда
			ИтогПоОбъекту.Итог = ИтогПоОбъекту.Итог + СтоимВсего;
			ИтогПоОбъекту.Наименование = НаименованиеОС; 
			ИтогПоСводу.Итог = ИтогПоСводу.Итог + СтоимВсего;
			ИтогПоСводу.Наименование = "";
		КонецЕсли;
	КонецЦикла;
	// Вывод результирующих итогов.
	ВывестиПодИтог(ТабДок,Макет,ИтогПоСмете);
	Если ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета")Тогда
		ВывестиПодИтог(ТабДок,Макет,ИтогПоОбъекту);
	ИначеЕсли ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		ВывестиПодИтог(ТабДок,Макет,ИтогПоОбъекту);
		ИтогПоСводу.Наименование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='СС № %1   %2'"), СокрЛП(Смета.НомерСметы), СокрЛП(Смета.Наименование));
		ВывестиПодИтог(ТабДок,Макет,ИтогПоСводу);
	КонецЕсли;	
	
	
КонецПроцедуры

Процедура ВывестиЭкономия(Смета,ТабДок,ИмяМакета)
	КолЗнаков = 2;
	Макет = ЭтотОбъект.ПолучитьМакет(ИмяМакета);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаЭкономия();
	Запрос.УстановитьПараметр("Смета",Смета);
	ЭтоЛокальная = ?(ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"),Истина,Ложь);
	Запрос.УстановитьПараметр("ЭтоЛокальная",ЭтоЛокальная);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	// Вывод шапки
	СтрокаЗаголовка =  НСтр("ru='Отчёт по сэкономленным ресурсам по '");
	
	ВыводШапки(ТабДок,Макет,Смета,СтрокаЗаголовка);
	ИтогПоСмете = Новый Структура("Наименование, Итог");
	ИтогПоСмете.Итог = 0;
	
	ИтогПоОбъекту = Новый Структура("Наименование, Итог");
	ИтогПоОбъекту.Итог = 0;
	
	ИтогПоСводу= Новый Структура("Наименование, Итог");
	ИтогПоСводу.Итог = 0;
	ПрошлСмета	= "";
	ПрошлСметаОбъект	= "";
	РезультатЗапроса.Сортировать("Сводная,Объектная,Локальная");
	РезультатЗапроса.Свернуть("Объектная,Локальная,Ресурс,Основание,Цена","Разница");
	Для каждого СтрокаЗапроса Из РезультатЗапроса Цикл
		// Вывод заголовков, наименований смет.
		ТекСмета = СтрокаЗапроса.Локальная;
		ТекОбъектная = СтрокаЗапроса.Объектная;
		Если  ПрошлСметаОбъект <> ТекОбъектная И ТекОбъектная <> NULL Тогда
			НаименованиеОС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ОС № %1   ,%2'") ,СокрЛП(ТекОбъектная.НомерСметы) , СокрЛП(ТекОбъектная.Наименование));
			ВывестиПодзаголовок(ТабДок,Макет,НаименованиеОС);
			ПрошлСметаОбъект	=  ТекОбъектная;
			Если ИтогПоОбъекту.Итог <> 0 Тогда 
				ВывестиПодИтог(ТабДок,Макет,ИтогПоОбъекту);
				ИтогПоОбъекту.Очистить();
			КонецЕсли;	
		КонецЕсли;	
		Если ТекСмета <> ПрошлСмета  И ТекСмета <> NULL Тогда
			НаименованиеЛС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ЛС № %1   %2'") ,СокрЛП(ТекСмета.НомерСметы) , СокрЛП(ТекСмета.Наименование));
			ВывестиПодзаголовок(ТабДок,Макет,НаименованиеЛС);
			ПрошлСмета	= ТекСмета;
			Если ИтогПоСмете.Итог <> 0 Тогда
				ВывестиПодИтог(ТабДок,Макет,ИтогПоСмете);
				ИтогПоСмете.Очистить();
			КонецЕсли;	
		КонецЕсли;	
		ТекРесурс = СтрокаЗапроса.Ресурс;
		Разница = СтрокаЗапроса.Разница;
		Основание =  СтрокаЗапроса.Основание;
		
		СтоимостьЕдиницы = СтрокаЗапроса.Цена;
		
		СтоимВсего = Окр((СтоимостьЕдиницы * Разница),КолЗнаков);
		// Вывод детальной строки.
		ВыводДетальнойСтрокиСписание(ТабДок,Макет,ТекРесурс,СтоимостьЕдиницы,СтоимВсего,Разница,Основание,Неопределено,Истина);
		// Подсчет итогов.
		ИтогПоСмете.Итог = ИтогПоСмете.Итог + СтоимВсего;
		ИтогПоСмете.Наименование = НаименованиеЛС;
		Если ЭтоЛокальная = Ложь Тогда
			ИтогПоОбъекту.Итог = ИтогПоОбъекту.Итог + СтоимВсего;
			ИтогПоОбъекту.Наименование = НаименованиеОС; 
			ИтогПоСводу.Итог = ИтогПоСводу.Итог + СтоимВсего;
			ИтогПоСводу.Наименование = "";
		КонецЕсли;
	КонецЦикла;
	// Вывод результирующих итогов.
	ВывестиПодИтог(ТабДок,Макет,ИтогПоСмете);
	Если ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета")Тогда
		ВывестиПодИтог(ТабДок,Макет,ИтогПоОбъекту);
	ИначеЕсли ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		ВывестиПодИтог(ТабДок,Макет,ИтогПоОбъекту);
		ИтогПоСводу.Наименование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='СС № %1   %2'"), СокрЛП(Смета.НомерСметы), СокрЛП(Смета.Наименование));
		ВывестиПодИтог(ТабДок,Макет,ИтогПоСводу);
	КонецЕсли;	
	
	
КонецПроцедуры

#КонецОбласти

#Область ВыводаШапкиПодножия

Процедура ВыводШапки(ТабДок,Макет,Смета,СтрокаЗаголовка)
	ШапкаТаблицы = Новый ТабличныйДокумент;
	ОбластьШапка = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка.Параметры.СтрокаЗаголовок = СтрокаЗаголовка + СокрЛП(Смета.Наименование) ;
	ШапкаТаблицы.Вывести(ОбластьШапка);
	ТабДок.Вывести(ШапкаТаблицы);
	ШапкаДоп  = Новый ТабличныйДокумент;
	ОбластьШапкаДоп = Макет.ПолучитьОбласть("ЗаголовокДоп");
	ОбластьШапкаДоп.Параметры.ДатаСметы = "по состоянию на  " + Формат(ТекущаяДата(),"ДФ = dd.MM.yyyy") + " г.";
	ШапкаДоп.Вывести(ОбластьШапкаДоп);
	ТабДок.Вывести(ШапкаДоп);
	ШапкаТаблицы = Новый ТабличныйДокумент;
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ШапкаТаблицы.Вывести(ОбластьШапка);
	ТабДок.Вывести(ШапкаТаблицы);
	
КонецПроцедуры

Процедура ВывестиПодзаголовок(ТабДок,Макет,ЗаголовокСмета)
	Подзаголовок = Новый ТабличныйДокумент;
	ОбластьПодзаголовка = Макет.ПолучитьОбласть("ПодЗаголовок");
	ОбластьПодзаголовка.Параметры.СтрокаПодЗаголовка = СокрЛП(ЗаголовокСмета) ;
	Подзаголовок.Вывести(ОбластьПодзаголовка);
	ТабДок.Вывести(Подзаголовок);
КонецПроцедуры

Процедура ВывестиПодИтог(ТабДок,Макет,СтруктураИтога)
	Если СтруктураИтога.Итог <> 0 Тогда
		ПодИтог = Новый ТабличныйДокумент;
		ОбластьПодИтог = Макет.ПолучитьОбласть("ПодИтог");
		ОбластьПодИтог.Параметры.Наименование = "Итого по " + СокрЛП(СтруктураИтога.Наименование) ;
		ОбластьПодИтог.Параметры.Всего = СтруктураИтога.Итог;
		ПодИтог.Вывести(ОбластьПодИтог);
		ТабДок.Вывести(ПодИтог);
	Конецесли;
КонецПроцедуры

Процедура ВыводДетальнойСтроки(ТабДок,Макет,ТекПозиция,ЕдиничныеСтоимости,СтоимВсего,Разница,Основание,Файл);
	ДетальнаяСтрока = Новый ТабличныйДокумент;
	ОбластьДетСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьДетСтрока.Параметры.Код = ТекПозиция.ШифрРасценки;
	ОбластьДетСтрока.Параметры.Наименование = СокрЛП(ТекПозиция.Наименование);
	ЕдИзм = ?(ПустаяСтрока(ТекПозиция.Измеритель) = Истина,СокрЛП(ТекПозиция.ЕдиницаИзмерения.Наименование),СокрЛП(ТекПозиция.Измеритель));
	ОбластьДетСтрока.Параметры.ЕдИзм = ЕдИзм;
	Если ТекПозиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование Тогда
		ОбластьДетСтрока.Параметры.ЕдЦена = Окр(ЕдиничныеСтоимости.ТекСтоимОборуд,2);
	Иначе
		ОбластьДетСтрока.Параметры.ЕдЦена = Окр(ЕдиничныеСтоимости.ТекСтоимПрямЗатраты,2);
	КонецЕсли;
	ОбластьДетСтрока.Параметры.Разница = Разница;
	ОбластьДетСтрока.Параметры.Стоимость = СтоимВсего;
	ОбластьДетСтрока.Параметры.Обоснование = Основание;
	ОбластьДетСтрока.Параметры.Файл = Файл;
	ОбластьДетСтрока.Параметры.Расшифровка = Файл;
	ДетальнаяСтрока.Вывести(ОбластьДетСтрока);
	ТабДок.Вывести(ДетальнаяСтрока);
КонецПроцедуры

Процедура ВыводДетальнойСтрокиСписание(ТабДок,Макет,ТекРесурс,ЕдиничныеСтоимости,СтоимВсего,Разница,Основание,Файл,ФлСписание = Ложь);
	ДетальнаяСтрока = Новый ТабличныйДокумент;
	ОбластьДетСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьДетСтрока.Параметры.Код = ТекРесурс.Код;
	ОбластьДетСтрока.Параметры.Наименование = СокрЛП(ТекРесурс.ДлинноеНаименование);
	ЕдИзм = СокрЛП(ТекРесурс.ЕдиницаИзмерения.Наименование);
	ОбластьДетСтрока.Параметры.ЕдИзм = ЕдИзм;
	ОбластьДетСтрока.Параметры.ЕдЦена = Окр(ЕдиничныеСтоимости,2);
	ОбластьДетСтрока.Параметры.Разница = Разница;
	ОбластьДетСтрока.Параметры.Стоимость = СтоимВсего;
	ОбластьДетСтрока.Параметры.Обоснование = Основание;
	Если ФлСписание = Ложь Тогда
		ОбластьДетСтрока.Параметры.Файл = Файл;
	КонецЕсли;
	Если Не Файл = Неопределено Тогда
		ОбластьДетСтрока.Параметры.Расшифровка = Файл;
	КонецЕсли;
	ДетальнаяСтрока.Вывести(ОбластьДетСтрока);
	ТабДок.Вывести(ДетальнаяСтрока);
КонецПроцедуры

#КонецОбласти

#Область Запросов

Функция ПолучитьТекстЗапроса()
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЛокальнаяСмета.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ЛокальнаяСметаВременная
	|ИЗ
	|	Документ.СМ_ЛокальнаяСмета КАК ЛокальнаяСмета
	|ГДЕ
	|	(ЛокальнаяСмета.Ссылка = &Смета
	|			ИЛИ ЛокальнаяСмета.ИДРодителя = &Смета
	|			ИЛИ ЛокальнаяСмета.ИДРодителя.ИДРодителя = &Смета)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_АктВыполненныхРаботПозиции.Позиция,
	|	СУММА(СМ_АктВыполненныхРаботПозиции.ФактОбъем) КАК Всего
	|ПОМЕСТИТЬ ПозицииАктов
	|ИЗ
	|	Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_АктВыполненныхРаботПозиции
	|ГДЕ
	|	(СМ_АктВыполненныхРаботПозиции.Ссылка.ЛокальнаяСмета = &Смета
	|			ИЛИ СМ_АктВыполненныхРаботПозиции.Ссылка.ЛокальнаяСмета.ИДРодителя = &Смета
	|			ИЛИ СМ_АктВыполненныхРаботПозиции.Ссылка.ЛокальнаяСмета.ИДРодителя.ИДРодителя = &Смета)
	|	И СМ_АктВыполненныхРаботПозиции.Ссылка.Проведен = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	СМ_АктВыполненныхРаботПозиции.Позиция
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_АктВыполненныхРаботПозиции.Ссылка,
	|	СМ_АктВыполненныхРаботПозиции.Позиция,
	|	МАКСИМУМ(СМ_АктВыполненныхРаботПозиции.СсылкаНаФайл) КАК СсылкаНаФайл,
	|	МАКСИМУМ(ВЫРАЗИТЬ(СМ_АктВыполненныхРаботПозиции.КомментарийКФайлу КАК СТРОКА(150))) КАК КомментарийКФайлу
	|ПОМЕСТИТЬ ПозицииАкта
	|ИЗ
	|	Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_АктВыполненныхРаботПозиции
	|ГДЕ
	|	(СМ_АктВыполненныхРаботПозиции.Ссылка.ЛокальнаяСмета = &Смета
	|			ИЛИ СМ_АктВыполненныхРаботПозиции.Ссылка.ЛокальнаяСмета.ИДРодителя = &Смета
	|			ИЛИ СМ_АктВыполненныхРаботПозиции.Ссылка.ЛокальнаяСмета.ИДРодителя.ИДРодителя = &Смета)
	|	И СМ_АктВыполненныхРаботПозиции.Ссылка.Проведен = ИСТИНА
	|	И НЕ СМ_АктВыполненныхРаботПозиции.СсылкаНаФайл = ЗНАЧЕНИЕ(Справочник.СМ_АктВыполненныхРаботПрисоединенныеФайлы.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	СМ_АктВыполненныхРаботПозиции.Ссылка,
	|	СМ_АктВыполненныхРаботПозиции.Позиция
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПозицияЛокальнойСметы.Ссылка КАК Позиция,
	|	ПозицияЛокальнойСметы.ИДСметы,
	|	ПозицияЛокальнойСметы.ОбъемРабот,
	|	ПозицияЛокальнойСметы.ШифрРасценки,
	|	ПозицияЛокальнойСметы.Измеритель,
	|	ЕСТЬNULL(ПозицииАктов.Всего, 0) КАК ОбъемВсего,
	|	ПозицииАкта.Ссылка КАК Акт,
	|	ПозицииАкта.СсылкаНаФайл КАК Файл,
	|	ПозицииАкта.КомментарийКФайлу КАК Основание,
	|	ЕСТЬNULL(ПозицииАктов.Всего, 0) - ПозицияЛокальнойСметы.ОбъемРабот КАК Разница
	|ПОМЕСТИТЬ ПозицииЛокальнойСметыВременная
	|ИЗ
	|	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПозицииАктов КАК ПозицииАктов
	|		ПО ПозицияЛокальнойСметы.Ссылка = ПозицииАктов.Позиция
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПозицииАкта КАК ПозицииАкта
	|		ПО ПозицияЛокальнойСметы.Ссылка = ПозицииАкта.Позиция
	|ГДЕ
	|	(ПозицияЛокальнойСметы.ИДСметы = &Смета
	|			ИЛИ ПозицияЛокальнойСметы.ИДСметы.ИДРодителя = &Смета
	|			ИЛИ ПозицияЛокальнойСметы.ИДСметы.ИДРодителя.ИДРодителя = &Смета)
	|	И ЕСТЬNULL(ПозицииАктов.Всего, 0) - ПозицияЛокальнойСметы.ОбъемРабот > 0
	|	И НЕ ПозицииАкта.СсылкаНаФайл = ЗНАЧЕНИЕ(Справочник.СМ_АктВыполненныхРаботПрисоединенныеФайлы.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_ЛокальнаяСмета.Ссылка КАК ЛокальнаяСмета,
	|	NULL КАК ОбъектнаяСмета,
	|	NULL КАК СводнаяСмета
	|ПОМЕСТИТЬ ВТСметы
	|ИЗ
	|	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	|ГДЕ
	|	(СМ_ЛокальнаяСмета.ИДРодителя = ЗНАЧЕНИЕ(Документ.СМ_ОбъектнаяСмета.ПустаяСсылка)
	|			ИЛИ СМ_ЛокальнаяСмета.ИДРодителя = ЗНАЧЕНИЕ(Документ.СМ_СводнаяСмета.ПустаяСсылка)
	|			ИЛИ СМ_ЛокальнаяСмета.ИДРодителя = НЕОПРЕДЕЛЕНО
	|			ИЛИ СМ_ЛокальнаяСмета.ИДРодителя ЕСТЬ NULL
	|			ИЛИ &ЭтоЛокальная)
	|	И СМ_ЛокальнаяСмета.Ссылка = &Смета
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета,
	|	СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка,
	|	NULL
	|ИЗ
	|	Документ.СМ_ОбъектнаяСмета.ЛокальныеСметы КАК СМ_ОбъектнаяСметаЛокальныеСметы
	|ГДЕ
	|	(СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка.ИДРодителя = ЗНАЧЕНИЕ(Документ.СМ_СводнаяСмета.ПустаяСсылка)
	|			ИЛИ СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка.ИДРодителя = НЕОПРЕДЕЛЕНО
