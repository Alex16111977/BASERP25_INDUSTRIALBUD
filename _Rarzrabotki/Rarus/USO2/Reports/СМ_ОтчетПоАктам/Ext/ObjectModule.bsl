	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_ЛокальнаяСмета.Ссылка КАК ЛокальнаяСмета,
	|	NULL КАК ОбъектнаяСмета,
	|	NULL КАК СводнаяСмета
	|ПОМЕСТИТЬ ВТСметы
	|ИЗ
	|	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	|ГДЕ
	|	(СМ_ЛокальнаяСмета.ИДРодителя = ЗНАЧЕНИЕ(Документ.СМ_ОбъектнаяСмета.ПустаяСсылка)
	|			ИЛИ СМ_ЛокальнаяСмета.ИДРодителя = ЗНАЧЕНИЕ(Документ.СМ_СводнаяСмета.ПустаяСсылка)
	|			ИЛИ СМ_ЛокальнаяСмета.ИДРодителя = НЕОПРЕДЕЛЕНО
	|			ИЛИ СМ_ЛокальнаяСмета.ИДРодителя ЕСТЬ NULL 
	|			ИЛИ &ЭтоЛокальная)
	|	И СМ_ЛокальнаяСмета.Ссылка = &Смета
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета,
	|	СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка,
	|	NULL
	|ИЗ
	|	Документ.СМ_ОбъектнаяСмета.ЛокальныеСметы КАК СМ_ОбъектнаяСметаЛокальныеСметы
	|ГДЕ
	|	(СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка.ИДРодителя = ЗНАЧЕНИЕ(Документ.СМ_СводнаяСмета.ПустаяСсылка)
	|			ИЛИ СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка.ИДРодителя = НЕОПРЕДЕЛЕНО
	|			ИЛИ СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка.ИДРодителя ЕСТЬ NULL )
	|	И СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка = &Смета
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета,
	|	СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка,
	|	СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка.ИДРодителя
	|ИЗ
	|	Документ.СМ_ОбъектнаяСмета.ЛокальныеСметы КАК СМ_ОбъектнаяСметаЛокальныеСметы
	|ГДЕ
	|	(СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка.ИДРодителя <> ЗНАЧЕНИЕ(Документ.СМ_СводнаяСмета.ПустаяСсылка)
	|			ИЛИ СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка.ИДРодителя <> НЕОПРЕДЕЛЕНО
	|			ИЛИ СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка.ИДРодителя <> NULL)
	|	И СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка = &Смета
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СМ_СводнаяСметаСметы.Смета.Ссылка,
	|	NULL,
	|	СМ_СводнаяСметаСметы.Ссылка
	|ИЗ
	|	Документ.СМ_СводнаяСмета.Сметы КАК СМ_СводнаяСметаСметы
	|ГДЕ
	|	СМ_СводнаяСметаСметы.Смета ССЫЛКА Документ.СМ_ЛокальнаяСмета
	|	И СМ_СводнаяСметаСметы.Ссылка = &Смета
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета,
	|	СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка,
	|	СМ_СводнаяСметаСметы.Ссылка
	|ИЗ
	|	Документ.СМ_СводнаяСмета.Сметы КАК СМ_СводнаяСметаСметы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_ОбъектнаяСмета.ЛокальныеСметы КАК СМ_ОбъектнаяСметаЛокальныеСметы
	|		ПО СМ_СводнаяСметаСметы.Смета = СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка
	|ГДЕ
	|	СМ_СводнаяСметаСметы.Смета ССЫЛКА Документ.СМ_ОбъектнаяСмета
	|	И СМ_СводнаяСметаСметы.Ссылка = &Смета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСметы.ЛокальнаяСмета КАК Локальная,
	|	ВТСметы.ОбъектнаяСмета КАК Объектная,
	|	ВТСметы.СводнаяСмета КАК Сводная,
	|	ПозицииЛокальнойСметыВременная.Основание,
	|	ПозицииЛокальнойСметыВременная.Разница,
	|	ПозицииЛокальнойСметыВременная.СметныйКодРесурса КАК КодРесурса,
	|	ПозицииЛокальнойСметыВременная.ЕдиницаИзмеренияРесурса КАК ЕдиницаИзмерения,
	|	ПозицииЛокальнойСметыВременная.Цена,
	|	ПозицииЛокальнойСметыВременная.Всего,
	|	ПозицииЛокальнойСметыВременная.Норма,
	|	ПозицииЛокальнойСметыВременная.Ресурс
	|ИЗ
	|	ПозицииЛокальнойСметыВременная КАК ПозицииЛокальнойСметыВременная
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСметы КАК ВТСметы
	|		ПО ПозицииЛокальнойСметыВременная.ИДСметы = ВТСметы.ЛокальнаяСмета";
	
	Возврат(ТекстЗапроса);
	
КонецФункции

Функция ПолучитьЕдиничныеСтоимостиПозиции(Ссылка,ТекАкт)
	
	
	Стоимости = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ДопЗМТек) КАК ДопЗМ,
	|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимОборуд) КАК ТекСтоимОборуд,
	|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимПрямЗатраты) КАК ТекСтоимПрямЗатраты,
	|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимОснЗарплата) КАК ТекСтоимОснЗарплата,
	|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимЭксплМашин) КАК ТекСтоимЭксплМашин,
	|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимСтоимМатер) КАК ТекСтоимСтоимМатер,
	|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
	|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
	|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимЗарплМашин) КАК ТекСтоимЗарплМашин
	|ИЗ
	|	РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП КАК БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП
	|ГДЕ
	|	БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция = &Позиция 
	|	И БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Смета = &Акт";
	
	Запрос.УстановитьПараметр("Позиция",Ссылка);
	Запрос.УстановитьПараметр("Акт",ТекАкт);
	
	
	КолЗнаков = 2;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Стоимости.Вставить("ТекСтоимОборуд", 		Окр(Выборка.ТекСтоимОборуд,		2));
		Если (Выборка.ТекСтоимОснЗарплата + Выборка.ТекСтоимЭксплМашин + Выборка.ТекСтоимСтоимМатер) <> 0 Тогда
			Стоимости.Вставить("ТекСтоимПрямЗатраты", 	Окр((Выборка.ТекСтоимОснЗарплата + Выборка.ТекСтоимЭксплМашин + Выборка.ТекСтоимСтоимМатер),2));
		Иначе
			Стоимости.Вставить("ТекСтоимПрямЗатраты", 	Окр(Выборка.ТекСтоимПрямЗатраты,2));
		КонецЕсли;
		Стоимости.Вставить("ДопЗМ", 	Окр(Выборка.ДопЗМ,2));
		Стоимости.Вставить("ТекСтоимОснЗарплата", 	Окр(Выборка.ТекСтоимОснЗарплата,2));
		Стоимости.Вставить("ТекСтоимЭксплМашин", 	Окр(Выборка.ТекСтоимЭксплМашин,	2));
		Стоимости.Вставить("ТекСтоимЗарплМашин", 	Окр(Выборка.ТекСтоимЗарплМашин,	2));
		Стоимости.Вставить("ТекСтоимСтоимМатер", 	Окр(Выборка.ТекСтоимСтоимМатер,	2));
		Стоимости.Вставить("ЗатратыТрудаРабочих", 	Выборка.ЗатратыТрудаРабочих);
		Стоимости.Вставить("ЗатратыТрудаМашин", 	Выборка.ЗатратыТрудаМашин);
	Иначе
		Стоимости.Вставить("ДопЗМ", 	0);
		Стоимости.Вставить("ТекСтоимОборуд", 		0);
		Стоимости.Вставить("ТекСтоимПрямЗатраты", 	0);
		Стоимости.Вставить("ТекСтоимОснЗарплата", 	0);
		Стоимости.Вставить("ТекСтоимЭксплМашин", 	0);
		Стоимости.Вставить("ТекСтоимЗарплМашин", 	0);
		Стоимости.Вставить("ТекСтоимСтоимМатер", 	0);
		Стоимости.Вставить("ТекВозвратМатер", 0);
		Стоимости.Вставить("ВозвратМатер", 0);
		Стоимости.Вставить("ЗатратыТрудаРабочих", 0);
		Стоимости.Вставить("ЗатратыТрудаМашин", 0);
	КонецЕсли;	
	
	РасчетЛимЗатратНаЕдиничныеСтоимости(Стоимости,Ссылка,ТекАкт);
	Возврат Стоимости;
	
КонецФункции

Процедура РасчетКоэффициентов(Стоимости,Ссылка,Акт)
	
	Уровень = Акт.Уровень;
	ВариантПересчетаЭММ = Акт.ВариантПересчетаЭММ;
	СпособРасчетаИндексов = Акт.СпособРасчетаИндексов;
	СтруктураКоэффициентов = ПолучитьКоэффициентыПозицииАкта(Акт,Уровень,СпособРасчетаИндексов,Ссылка);
	Если Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка Тогда
		РассчитатьКоэффициентыПоРасценке(Стоимости,СтруктураКоэффициентов,Ссылка,СпособРасчетаИндексов,ВариантПересчетаЭММ);
	ИначеЕсли Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда
		РассчитатьКоэффициентыПоРазделу(Стоимости,СтруктураКоэффициентов,Ссылка,СпособРасчетаИндексов,ВариантПересчетаЭММ);
	Иначе
		РассчитатьКоэффициентыПоСмете(Стоимости,СтруктураКоэффициентов,Ссылка,СпособРасчетаИндексов,ВариантПересчетаЭММ);
	КонецЕсли;	
КонецПроцедуры	

Функция ПолучитьКоэффициентыПозицииАкта(ТекущийАкт,Уровень,СпособРасчетаИндексов,Позиция)
	СтруктураКоэфф = Новый Структура;
	СтруктураКоэфф.Вставить("КоэффОборуд",1);
	СтруктураКоэфф.Вставить("КоэффОснЗарплаты",1);
	СтруктураКоэфф.Вставить("КоэффПолнСтоимРабот",1);
	СтруктураКоэфф.Вставить("КоэффСтоимЗарплатеМашин",1);
	СтруктураКоэфф.Вставить("КоэффСтоимМатериалов",1);
	СтруктураКоэфф.Вставить("КоэффСтоимЭксплМашин",1);
	Если Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка Тогда
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Позиция",Позиция);
		МассивСтрок = ТекущийАкт.Позиции.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() <> 0 Тогда
			СтруктураКоэфф.КоэффОборуд	= ?(МассивСтрок[0].КоэффОборуд = 0,1,МассивСтрок[0].КоэффОборуд); 
			СтруктураКоэфф.КоэффОснЗарплаты	= ?(МассивСтрок[0].КоэффОснЗарплаты = 0,1,МассивСтрок[0].КоэффОснЗарплаты); 
			СтруктураКоэфф.КоэффПолнСтоимРабот	= ?(МассивСтрок[0].КоэффПолнСтоимРабот = 0,1,МассивСтрок[0].КоэффПолнСтоимРабот); 
			СтруктураКоэфф.КоэффСтоимЗарплатеМашин	= ?(МассивСтрок[0].КоэффСтоимЗарплатеМашин = 0,1,МассивСтрок[0].КоэффСтоимЗарплатеМашин); 
			СтруктураКоэфф.КоэффСтоимМатериалов	= ?(МассивСтрок[0].КоэффСтоимМатериалов = 0,1,МассивСтрок[0].КоэффСтоимМатериалов); 
			СтруктураКоэфф.КоэффСтоимЭксплМашин	= ?(МассивСтрок[0].КоэффСтоимЭксплМашин = 0,1,МассивСтрок[0].КоэффСтоимЭксплМашин); 
		КонецЕсли;	
	ИначеЕсли Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда
		Раздел  = Позиция.ИДРодителя;
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Раздел",Раздел);
		МассивСтрок = ТекущийАкт.Разделы.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() <> 0 Тогда
			СтруктураКоэфф.КоэффОборуд	= ?(МассивСтрок[0].КоэффОборуд = 0,1,МассивСтрок[0].КоэффОборуд); 
			СтруктураКоэфф.КоэффОснЗарплаты	= ?(МассивСтрок[0].КоэффОснЗарплаты = 0,1,МассивСтрок[0].КоэффОснЗарплаты); 
			СтруктураКоэфф.КоэффПолнСтоимРабот	= ?(МассивСтрок[0].КоэффПолнСтоимРабот = 0,1,МассивСтрок[0].КоэффПолнСтоимРабот); 
			СтруктураКоэфф.КоэффСтоимЗарплатеМашин	= ?(МассивСтрок[0].КоэффСтоимЗарплатеМашин = 0,1,МассивСтрок[0].КоэффСтоимЗарплатеМашин); 
			СтруктураКоэфф.КоэффСтоимМатериалов	= ?(МассивСтрок[0].КоэффСтоимМатериалов = 0,1,МассивСтрок[0].КоэффСтоимМатериалов); 
			СтруктураКоэфф.КоэффСтоимЭксплМашин	= ?(МассивСтрок[0].КоэффСтоимЭксплМашин = 0,1,МассивСтрок[0].КоэффСтоимЭксплМашин); 
		КонецЕсли;
	ИначеЕсли Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета Тогда
		Если СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат Тогда
			СтруктураКоэфф.КоэффОборуд	= ?(ТекущийАкт.КоэффОборуд = 0,1,ТекущийАкт.КоэффОборуд); 
			СтруктураКоэфф.КоэффОснЗарплаты	= ?(ТекущийАкт.КоэффФОТ = 0,1,ТекущийАкт.КоэффФОТ); 
			СтруктураКоэфф.КоэффПолнСтоимРабот	= ?(ТекущийАкт.КоэффПолнСтоимРабот = 0,1,ТекущийАкт.КоэффПолнСтоимРабот); 
			СтруктураКоэфф.КоэффСтоимЗарплатеМашин	= ?(ТекущийАкт.КоэффФОТ = 0,1,ТекущийАкт.КоэффФОТ); 
			СтруктураКоэфф.КоэффСтоимМатериалов	= ?(ТекущийАкт.КоэффСтоимМатериалов = 0,1,ТекущийАкт.КоэффСтоимМатериалов); 
			СтруктураКоэфф.КоэффСтоимЭксплМашин	= ?(ТекущийАкт.КоэффСтоимЭксплМашин = 0,1,ТекущийАкт.КоэффСтоимЭксплМашин); 
		Иначе
			Если Позиция.Определитель.ВидРабот  = Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы Тогда
				СтруктураКоэфф.КоэффОборуд	= ?(ТекущийАкт.КоэффОборуд = 0,1,ТекущийАкт.КоэффОборуд); 
				СтруктураКоэфф.КоэффОснЗарплаты	= ?(ТекущийАкт.КоэффФОТ = 0,1,ТекущийАкт.КоэффФОТ); 
				СтруктураКоэфф.КоэффПолнСтоимРабот	= ?(ТекущийАкт.КоэффПрочРаб = 0,1,ТекущийАкт.КоэффПрочРаб); 
				СтруктураКоэфф.КоэффСтоимЗарплатеМашин	= ?(ТекущийАкт.КоэффФОТ = 0,1,ТекущийАкт.КоэффФОТ); 
				СтруктураКоэфф.КоэффСтоимМатериалов	= ?(ТекущийАкт.КоэффПрочРаб = 0,1,ТекущийАкт.КоэффПрочРаб); 
				СтруктураКоэфф.КоэффСтоимЭксплМашин	= ?(ТекущийАкт.КоэффПрочРаб = 0,1,ТекущийАкт.КоэффПрочРаб); 
			Иначе
				СтруктураКоэфф.КоэффОборуд	= ?(ТекущийАкт.КоэффОборуд = 0,1,ТекущийАкт.КоэффОборуд); 
				СтруктураКоэфф.КоэффОснЗарплаты	= ?(ТекущийАкт.КоэффФОТ = 0,1,ТекущийАкт.КоэффФОТ); 
				СтруктураКоэфф.КоэффПолнСтоимРабот	= ?(ТекущийАкт.КоэффСМР = 0,1,ТекущийАкт.КоэффСМР); 
				СтруктураКоэфф.КоэффСтоимЗарплатеМашин	= ?(ТекущийАкт.КоэффФОТ = 0,1,ТекущийАкт.КоэффФОТ); 
				СтруктураКоэфф.КоэффСтоимМатериалов	= ?(ТекущийАкт.КоэффСМР = 0,1,ТекущийАкт.КоэффСМР); 
				СтруктураКоэфф.КоэффСтоимЭксплМашин	= ?(ТекущийАкт.КоэффСМР = 0,1,ТекущийАкт.КоэффСМР); 
				
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	Возврат(СтруктураКоэфф);
КонецФункции

Процедура РассчитатьКоэффициентыПоРасценке(Стоимости,СтруктураКоэффициентов,Ссылка,СпособРасчетаИндексов,ВариантПересчетаЭММ)
	НеПрименятьИндексы = Ссылка.НеПрименятьИндексы;
	ВР = Ссылка.Определитель.ВидРасценки;
	Материал = Ложь ;
	Оборудование = Ложь ;
	Прочее = Ложь ;
	Если ВР = Перечисления.СМ_ВидыРасценки.Материал Тогда
		Материал = Истина
	ИначеЕсли ВР = Перечисления.СМ_ВидыРасценки.Оборудование Тогда
		Оборудование = Истина
	Иначе
		Прочее = Истина;	
	КонецЕсли;
	
	Если НеПрименятьИндексы = Ложь Тогда 
		Если СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат Тогда
			Если СтруктураКоэффициентов.КоэффПолнСтоимРабот <> 1 Тогда
				Стоимости.ТекСтоимОборуд 		= Окр(Стоимости.ТекСтоимОборуд * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);	
				Если Стоимости.ТекСтоимЭксплМашин + Стоимости.ТекСтоимОснЗарплата + Стоимости.ТекСтоимСтоимМатер + Стоимости.ТекСтоимОборуд = 0 Тогда
					Стоимости.ТекСтоимПрямЗатраты = Окр(Стоимости.ТекСтоимПрямЗатраты  * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2)	
				КОнецЕсли;	
			Иначе	
				
				НачДобавЗМ = Стоимости.ДопЗМ;
				Стоимости.ТекСтоимЭксплМашин = Стоимости.ТекСтоимЭксплМашин - НачДобавЗМ;
				Стоимости.ТекСтоимЗарплМашин = Стоимости.ТекСтоимЗарплМашин;
				ИндексироватьДопЗМФот = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ИндексироватьДопЗМФот",Ложь);	
				КоэффЗМ = ?(ИндексироватьДопЗМФот, СтруктураКоэффициентов.КоэффОснЗарплаты,СтруктураКоэффициентов.КоэффСтоимЭксплМашин);					// к расценке применяются индексы
				Если ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Одинаковые Тогда
					Стоимости.ТекСтоимЭксплМашин = Окр(Стоимости.ТекСтоимЭксплМашин * СтруктураКоэффициентов.КоэффСтоимЭксплМашин,2);	
					Стоимости.ТекСтоимЗарплМашин = Окр(Стоимости.ТекСтоимЗарплМашин * СтруктураКоэффициентов.КоэффСтоимЭксплМашин,2);
				ИначеЕсли ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Разные Тогда
					Стоимости.ТекСтоимЭксплМашин = Окр(Стоимости.ТекСтоимЭксплМашин * СтруктураКоэффициентов.КоэффСтоимЭксплМашин,2);	
					Стоимости.ТекСтоимЗарплМашин = Окр(Стоимости.ТекСтоимЗарплМашин * СтруктураКоэффициентов.КоэффСтоимЗарплатеМашин,2);	  
				ИначеЕсли ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.РазныеКРазности Тогда
					Стоимости.ТекСтоимЗарплМашин = Окр(Стоимости.ТекСтоимЗарплМашин * СтруктураКоэффициентов.КоэффСтоимЗарплатеМашин,2);	
					Стоимости.ТекСтоимЭксплМашин = Окр((Стоимости.ТекСтоимЭксплМашин - Стоимости.ТекСтоимЗарплМашин) * СтруктураКоэффициентов.КоэффСтоимЭксплМашин,2);	
					Стоимости.ТекСтоимЭксплМашин = Стоимости.ТекСтоимЭксплМашин + Стоимости.ТекСтоимЗарплМашин;	
				КонецЕсли;
				УчитыватьДопЗМ = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","УчитыватьДопЗМ",Ложь);	
				Если УчитыватьДопЗМ  Тогда
					Стоимости.ТекСтоимЭксплМашин = Стоимости.ТекСтоимЭксплМашин  + Окр(НачДобавЗМ * КоэффЗМ,2);
					Стоимости.ТекСтоимЗарплМашин = Стоимости.ТекСтоимЗарплМашин; 	
				КонецЕсли;
				Стоимости.ТекСтоимОснЗарплата  = Окр(Стоимости.ТекСтоимОснЗарплата * СтруктураКоэффициентов.КоэффОснЗарплаты,2);
				Стоимости.ТекСтоимСтоимМатер 	= Окр(Стоимости.ТекСтоимСтоимМатер * СтруктураКоэффициентов.КоэффСтоимМатериалов,2);	
				Стоимости.ТекСтоимОборуд 		= Окр(Стоимости.ТекСтоимОборуд * СтруктураКоэффициентов.КоэффОборуд,2);	
			КонецЕсли;	
		Иначе
			// Коэффициент к полной стоимости.   
			Стоимости.ТекСтоимЭксплМашин   = Окр(Стоимости.ТекСтоимЭксплМашин * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);	
			Стоимости.ТекСтоимЗарплМашин   = Окр(Стоимости.ТекСтоимЗарплМашин * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);
			Стоимости.ТекСтоимОснЗарплата  = Окр(Стоимости.ТекСтоимОснЗарплата * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);
			Стоимости.ТекСтоимСтоимМатер 	= Окр(Стоимости.ТекСтоимСтоимМатер * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);	
			Стоимости.ТекСтоимОборуд 		= Окр(Стоимости.ТекСтоимОборуд * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);	
		КонецЕсли;
	КонецЕсли;
	Если НеПрименятьИндексы Тогда
		// Для оборудования и материалов берутся текущие цены.
		Если Материал Тогда
			Стоимости.ТекСтоимСтоимМатер 	= Окр(Стоимости.ТекСтоимСтоимМатер,2);	
			Стоимости.ТекСтоимПрямЗатраты 	= Окр(Стоимости.ТекСтоимСтоимМатер,2);	
		ИначеЕсли Оборудование Тогда	
			Стоимости.ТекСтоимОборуд 		= Окр(Стоимости.ТекСтоимОборуд,2);	
		Иначе
			Если (Стоимости.ТекСтоимСтоимМатер = Стоимости.ТекСтоимПрямЗатраты) Тогда
				Стоимости.ТекСтоимСтоимМатер 	= Окр(Стоимости.ТекСтоимСтоимМатер,2);	
				Стоимости.ТекСтоимПрямЗатраты 	= Окр(Стоимости.ТекСтоимСтоимМатер,2);	
			Иначе	
				Стоимости.ТекСтоимЭксплМашин 		= Окр(Стоимости.ТекСтоимЭксплМашин,2);	
				Стоимости.ТекСтоимПрямЗатраты 		= Окр(Стоимости.ТекСтоимЭксплМашин,2);	
				Стоимости.ТекСтоимЗарплМашин 		= Окр(Стоимости.ТекСтоимЗарплМашин,2);	
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	Если  Стоимости.ТекСтоимОснЗарплата + Стоимости.ТекСтоимЭксплМашин + Стоимости.ТекСтоимСтоимМатер <> 0 Тогда
		Стоимости.ТекСтоимПрямЗатраты = Стоимости.ТекСтоимОснЗарплата + Стоимости.ТекСтоимЭксплМашин + Стоимости.ТекСтоимСтоимМатер;	
	КонецЕсли;	
	
	
КонецПроцедуры	

Процедура РассчитатьКоэффициентыПоРазделу(Стоимости,СтруктураКоэффициентов,Ссылка,СпособРасчетаИндексов,ВариантПересчетаЭММ);
	НеПрименятьИндексы = Ссылка.НеПрименятьИндексы;
	Если НеПрименятьИндексы = Ложь Тогда			
		Если СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости 	
			Или (СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат 
			И СтруктураКоэффициентов.КоэффПолнСтоимРабот <> 0) Тогда
			Стоимости.ТекСтоимОснЗарплата = Окр(Стоимости.ТекСтоимОснЗарплата * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);
			Стоимости.ТекСтоимЭксплМашин = Окр(Стоимости.ТекСтоимЭксплМашин * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);
			Стоимости.ТекСтоимЗарплМашин = Окр(Стоимости.ТекСтоимЗарплМашин * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);
			Стоимости.ТекСтоимСтоимМатер = Окр(Стоимости.ТекСтоимСтоимМатер * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);
			Стоимости.ТекСтоимПрямЗатраты = Окр(Стоимости.ТекСтоимПрямЗатраты * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);
			Стоимости.ТекСтоимОборуд = Окр(Стоимости.ТекСтоимОборуд * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);
			
		ИначеЕсли СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат	
			И СтруктураКоэффициентов.КоэффПолнСтоимРабот = 0  Тогда
			Стоимости.ТекСтоимОснЗарплата = Окр(Стоимости.ТекСтоимОснЗарплата * СтруктураКоэффициентов.КоэффОснЗарплаты,2);
			Стоимости.ТекСтоимСтоимМатер = Окр(Стоимости.ТекСтоимСтоимМатер * СтруктураКоэффициентов.КоэффСтоимМатериалов,2);
			НачДобавЗМ = Стоимости.ДопЗМ;
			ТекЭМ = ТекЭМ - НачДобавЗМ;
			Стоимости.ТекСтоимЭксплМашин = Стоимости.ТекСтоимЭксплМашин - НачДобавЗМ;
			ИндексироватьДопЗМФот = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ИндексироватьДопЗМФот",Ложь);	
			КоэффЗМ = ?(ИндексироватьДопЗМФот, СтруктураКоэффициентов.КоэффОснЗарплаты, СтруктураКоэффициентов.КоэффСтоимЭксплМашин);					// к расценке применяются индексы
			Если ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Разные Тогда
				Стоимости.ТекСтоимЗарплМашин = Окр(Стоимости.ТекСтоимЗарплМашин  * СтруктураКоэффициентов.КоэффОснЗарплаты,2);
				Стоимости.ТекСтоимЭксплМашин = Окр(Стоимости.ТекСтоимЭксплМашин * СтруктураКоэффициентов.КоэффСтоимЭксплМашин,2) + Окр(НачДобавЗМ * КоэффЗМ,2);
			ИначеЕсли ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Одинаковые Тогда
				Стоимости.ТекСтоимЭксплМашин = Окр(Стоимости.ТекСтоимЭксплМашин * СтруктураКоэффициентов.КоэффСтоимЭксплМашин,2) + Окр(НачДобавЗМ * СтруктураКоэффициентов.КоэффСтоимЭксплМашин,2);
				Стоимости.ТекСтоимЗарплМашин = Окр(Стоимости.ТекСтоимЗарплМашин * СтруктураКоэффициентов.КоэффСтоимЭксплМашин,2);
			ИначеЕсли ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.РазныеКРазности Тогда
				КоэффЗМ = СтруктураКоэффициентов.КоэффСтоимЭксплМашин;
				Стоимости.ТекСтоимЭксплМашин = Окр((Стоимости.ТекСтоимЭксплМашин - Стоимости.ТекСтоимЗарплМашин)* КоэффЗМ,2);
				Стоимости.ТекСтоимЗарплМашин = Окр(Стоимости.ТекСтоимЗарплМашин * СтруктураКоэффициентов.КоэффОснЗарплаты,2);
				Стоимости.ТекСтоимЭксплМашин = Стоимости.ТекСтоимЭксплМашин + Стоимости.ТекСтоимЗарплМашин + Окр(НачДобавЗМ * КоэффЗМ,2);
			КонецЕсли;	
			Если Стоимости.ТекСтоимЭксплМашин + Стоимости.ТекСтоимСтоимМатер + Стоимости.ТекСтоимОснЗарплата <> 0 Тогда
				Стоимости.ТекСтоимПрямЗатраты = Стоимости.ТекСтоимЭксплМашин + Стоимости.ТекСтоимСтоимМатер + Стоимости.ТекСтоимОснЗарплата ;
			КонецЕсли;
			Стоимости.ТекСтоимОборуд 		= Окр(Стоимости.ТекСтоимОборуд * СтруктураКоэффициентов.КоэффОборуд,2);	
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

Процедура РассчитатьКоэффициентыПоСмете(Стоимости,СтруктураКоэффициентов,Ссылка,СпособРасчетаИндексов,ВариантПересчетаЭММ);
	Если СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат Тогда	
		Стоимости.ТекСтоимОснЗарплата = Окр(Стоимости.ТекСтоимОснЗарплата * СтруктураКоэффициентов.КоэффОснЗарплаты,2);
		Стоимости.ТекСтоимСтоимМатер = Окр(Стоимости.ТекСтоимСтоимМатер * СтруктураКоэффициентов.КоэффСтоимМатериалов,2);
		Если ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Разные Тогда
			Стоимости.ТекСтоимЭксплМашин = Окр(Стоимости.ТекСтоимЭксплМашин * СтруктураКоэффициентов.КоэффСтоимЭксплМашин,2);
			Стоимости.ТекСтоимЗарплМашин = Окр(Стоимости.ТекСтоимЗарплМашин * СтруктураКоэффициентов.КоэффОснЗарплаты,2);
		ИначеЕсли ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Одинаковые Тогда
			Стоимости.ТекСтоимЭксплМашин = Окр(Стоимости.ТекСтоимЭксплМашин * СтруктураКоэффициентов.КоэффСтоимЭксплМашин,2);
			Стоимости.ТекСтоимЗарплМашин = Окр(Стоимости.ТекСтоимЗарплМашин * СтруктураКоэффициентов.КоэффСтоимЭксплМашин,2);
		ИначеЕсли ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.РазныеКРазности Тогда
			Стоимости.ТекСтоимЭксплМашин = Окр((Стоимости.ТекСтоимЭксплМашин - Стоимости.ЗарплМашин)* СтруктураКоэффициентов.КоэффСтоимЭксплМашин,2);
			Стоимости.ТекСтоимЗарплМашин = Окр(Стоимости.ТекСтоимЗарплМашин * СтруктураКоэффициентов.СтруктураКоэффициентов.КоэффОснЗарплаты,2);
			Стоимости.ТекСтоимЭксплМашин = Стоимости.ТекСтоимЭксплМашин + Стоимости.СтоимЗарплМашин;
		КонецЕсли;	
		Если Стоимости.ТекСтоимЭксплМашин + Стоимости.ТекСтоимОснЗарплата + Стоимости.ТекСтоимСтоимМатер <> 0 Тогда
			Стоимости.ТекСтоимПрямЗатраты = Стоимости.ТекСтоимЭксплМашин + Стоимости.ТекСтоимОснЗарплата + Стоимости.ТекСтоимСтоимМатер;
		КонецЕсли;
		Стоимости.ТекСтоимОборуд 		= Окр(Стоимости.ТекСтоимОборуд * СтруктураКоэффициентов.КоэффОборуд,2);	
	КонецЕсли;
	Если СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости Тогда	
		Стоимости.ТекСтоимПрямЗатраты = Окр(Стоимости.ТекСтоимПрямЗатраты * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);	
		Стоимости.ТекСтоимОснЗарплата = Окр(Стоимости.ТекСтоимОснЗарплата * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);	
		Стоимости.ТекСтоимЭксплМашин = Окр(Стоимости.ТекСтоимЭксплМашин   * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);;	
		Стоимости.ТекСтоимЗарплМашин = Окр(Стоимости.ТекСтоимЗарплМашин   * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);;	
		Стоимости.ТекСтоимСтоимМатер = Окр(Стоимости.ТекСтоимСтоимМатер   * СтруктураКоэффициентов.КоэффПолнСтоимРабот,2);;	
		Стоимости.ТекСтоимОборуд   = Окр(Стоимости.ТекСтоимОборуд         * СтруктураКоэффициентов.КоэффОборуд,2);	
		Если Стоимости.ТекСтоимЭксплМашин + Стоимости.ТекСтоимОснЗарплата + Стоимости.ТекСтоимСтоимМатер <> 0 Тогда
			Стоимости.ТекСтоимПрямЗатраты = Стоимости.ТекСтоимЭксплМашин + Стоимости.ТекСтоимОснЗарплата + Стоимости.ТекСтоимСтоимМатер;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РасчетаЛЗ

Процедура РасчетЛимЗатратНаЕдиничныеСтоимости(Стоимости,Ссылка,Акт)
	КолЗнаков = 2;
	Если Акт.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный Тогда
		РасчетКоэффициентов(Стоимости,Ссылка,Акт);
	КонецЕсли;
	
	ИтогиПоГлавам = СоздатьТаблицу(Акт);
	
	ИтогиПоВР = Новый ТаблицаЗначений;
	
	СоздатьТаблицуИтогаВидаРаботы(ИтогиПоВР,Стоимости,Ссылка,Акт);
	
	СписокВидыЗатрат = Новый Массив;
	СписокВидыЗатрат.Добавить(Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы);
	СписокВидыЗатрат.Добавить(Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы);
	СписокВидыЗатрат.Добавить(Перечисления.СМ_ВидыЗатратСмета.Оборудование);
	СписокВидыЗатрат.Добавить(Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы);
	
	ФормированиеТаблицыИтогиПоГлавам(ИтогиПоГлавам, ИтогиПоВР,Акт,СписокВидыЗатрат);
	
	РасчетЛимЗатраты(ИтогиПоГлавам, ИтогиПоВР,Акт,КолЗнаков);
	Для Каждого СтрокаТабл Из ИтогиПоГлавам Цикл
		Итог = СтрокаТабл.Итог;	
		Если ТипЗнч(Итог) = ТИП("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда 
			Стоимости.ТекСтоимПрямЗатраты = Стоимости.ТекСтоимПрямЗатраты + СтрокаТабл.ТекПрямЗатраты; 
			Стоимости.ТекСтоимОснЗарплата = Стоимости.ТекСтоимОснЗарплата + СтрокаТабл.ТекОснЗарплата; 
			Стоимости.ТекСтоимЭксплМашин = Стоимости.ТекСтоимЭксплМашин + СтрокаТабл.ТекЭксплМашин; 
			Стоимости.ТекСтоимЗарплМашин = Стоимости.ТекСтоимЗарплМашин + СтрокаТабл.ТекЗарплМашин; 
			Стоимости.ТекСтоимСтоимМатер = Стоимости.ТекСтоимСтоимМатер + СтрокаТабл.ТекСтоимМатер; 
			Стоимости.ТекСтоимОборуд = Стоимости.ТекСтоимОборуд + СтрокаТабл.ТекОборуд; 
			
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры

Функция СоздатьТаблицу(Ссылка)
	НаборЗаписей = РегистрыСведений.СМ_ИтогиПоГлавам.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Смета.Установить(Ссылка);
	НаборЗаписей.Прочитать();
	ИтогиПоГлавам = НаборЗаписей.Выгрузить();
	ИтогиПоГлавам.Очистить();
	Если ИтогиПоГлавам.Колонки.Найти("ПорНомерИтога") = Неопределено Тогда 
		ИтогиПоГлавам.Колонки.Добавить("ПорНомерИтога");
		ИтогиПоГлавам.Колонки.Добавить("Накопительный");
		ИтогиПоГлавам.Колонки.Добавить("КодГлавы");
	КонецЕсли;
	Возврат(ИтогиПоГлавам);
КонецФункции	

Процедура ФормированиеТаблицыИтогиПоГлавам(ИтогиПоГлавам, ИтогиПоВР,Ссылка,СписокВидыЗатрат)
	
	ТекВыборка = Справочники.СМ_ИтогиПоГлавам.Выбрать();
	
	Пока ТекВыборка.Следующий() Цикл
		
		Если ТекВыборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ТекВидЗатрат Из СписокВидыЗатрат Цикл
			НоваяСтрока 				= ИтогиПоГлавам.Добавить();	
			НоваяСтрока.Смета       	= Ссылка;
			НоваяСтрока.Глава      	 	= ТекВыборка.ГлаваССРС;
			НоваяСтрока.Итог        	= ТекВыборка.Ссылка;
			НоваяСтрока.ВидРабот    	= ТекВидЗатрат;
			НоваяСтрока.Накопительный 	= ТекВыборка.Накопительный;
			НоваяСтрока.ПорНомерИтога 	= ТекВыборка.ПорядковыйНомер;
			НоваяСтрока.КодГлавы		= ТекВыборка.ГлаваССРС.Код;
			ПрямЗатраты             	= 0;
			ОснЗарплата             	= 0;
			ЭксплМашин             		= 0;
			ЗарплМашин              	= 0;
			СтоимМатер              	= 0;
			Оборуд                 	 	= 0;
			ТекПрямЗатраты             	= 0;
			ТекОснЗарплата             	= 0;
			ТекЭксплМашин             	= 0;
			ТекЗарплМашин              	= 0;
			ТекСтоимМатер              	= 0;
			ТекОборуд                 	= 0;
			ВозвратМатер           		= 0;
			ЗатратыТрудаРабочих     	= 0;
			ЗатратыТрудаМашин      		= 0;
		КонецЦикла;                 
	КонецЦикла;
	
	Итог0 			= Справочники.СМ_ИтогиПоГлавам.НайтиПоРеквизиту("Идентификатор","И0");
	СписокСвойств 	= "ПрямЗатраты,ОснЗарплата,ЭксплМашин,ЗарплМашин,СтоимМатер,Оборуд,ВозвратМатер,ЗатратыТрудаРабочих,ЗатратыТрудаМашин,ТекПрямЗатраты,ТекОснЗарплата,ТекЭксплМашин,ТекЗарплМашин,ТекСтоимМатер,ТекОборуд,ТекВозвратМатер";
	
	
	Для Каждого ТекСтрока Из ИтогиПоВР Цикл
		
		// Заполнение нулевого итога.
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Итог",Итог0);
		СтруктураОтбора.Вставить("ВидРабот",ТекСтрока.ВидРабот);
		
		МассивСтрок = ИтогиПоГлавам.НайтиСтроки(СтруктураОтбора);
		Для Каждого НайденнаяСтрока Из МассивСтрок Цикл
			ЗаполнитьЗначенияСвойств(НайденнаяСтрока,ТекСтрока,СписокСвойств);
		КонецЦикла;
		
		// Заполнение накопительных итогов.
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Накопительный",Истина);
		СтруктураОтбора.Вставить("ВидРабот",ТекСтрока.ВидРабот);
		
		МассивСтрок = ИтогиПоГлавам.НайтиСтроки(СтруктураОтбора);
		Для Каждого НайденнаяСтрока Из МассивСтрок Цикл
			ЗаполнитьЗначенияСвойств(НайденнаяСтрока,ТекСтрока,СписокСвойств);
		КонецЦикла;
		
	КонецЦикла;
	
	ИтогиПоГлавам.Сортировать("ПорНомерИтога Возр");  
	
КонецПроцедуры	

Процедура СоздатьТаблицуИтогаВидаРаботы(ИтогиПоВР,Стоимости,Позиция,Акт)
	ТипСоставляющей = Новый  ОписаниеТипов("Число");
	ИтогиПоВР.Колонки.Добавить("Итог");
	ИтогиПоВР.Колонки.Добавить("ВидРабот");
	ИтогиПоВР.Колонки.Добавить("Смета");
	ИтогиПоВР.Колонки.Добавить("ПрямЗатраты",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ОснЗарплата",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ЭксплМашин",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ЗарплМашин",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("СтоимМатер",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("Оборуд",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ЗатратыТрудаРабочих",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ЗатратыТрудаМашин",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ВозвратМатер",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ТекПрямЗатраты",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ТекОснЗарплата",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ТекЭксплМашин",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ТекЗарплМашин",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ТекСтоимМатер",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ТекОборуд",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ТекВозвратМатер",ТипСоставляющей);
	
	СтрокаТабл = ИтогиПоВР.Добавить();	
	СтрокаТабл.Смета = Акт;
	ТекВид = Позиция.Определитель.ВидРабот;
	Если ТекВид = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
		СтрокаТабл.ВидРабот = ТекВид;
		НайденнаяСсылка = Справочники.СМ_ИтогиСметыПоВидамРабот.НайтиПоРеквизиту("Идентификатор","Оборуд");
		СтрокаТабл.Итог = НайденнаяСсылка;
	ИначеЕсли ТекВид = Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы Тогда
		СтрокаТабл.ВидРабот = ТекВид;	
		НайденнаяСсылка = Справочники.СМ_ИтогиСметыПоВидамРабот.НайтиПоРеквизиту("Идентификатор","МонтажнРаб");
		СтрокаТабл.Итог = НайденнаяСсылка;
	ИначеЕсли ТекВид = Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы Тогда
		СтрокаТабл.ВидРабот = ТекВид;	
		НайденнаяСсылка = Справочники.СМ_ИтогиСметыПоВидамРабот.НайтиПоРеквизиту("Идентификатор","СтроитРаб");
		СтрокаТабл.Итог = НайденнаяСсылка;
		
	ИначеЕсли ТекВид = Перечисления.СМ_ВидыЗатратСмета.МеталломонтажныеРаботы Тогда
		СтрокаТабл.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы;	
		НайденнаяСсылка = Справочники.СМ_ИтогиСметыПоВидамРабот.НайтиПоРеквизиту("Идентификатор","Металлоконстр");
		СтрокаТабл.Итог = НайденнаяСсылка;
	ИначеЕсли ТекВид = Справочники.СМ_ИтогиСметыПоВидамРабот.СантехнРаб Тогда
		СтрокаТабл.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы;	
		НайденнаяСсылка = Справочники.СМ_ИтогиСметыПоВидамРабот.НайтиПоРеквизиту("Идентификатор","СантехнРаб");
		СтрокаТабл.Итог = НайденнаяСсылка;
		
	ИначеЕсли ТекВид = Перечисления.СМ_ВидыЗатратСмета.БуровзрывныеРаботы Тогда
		СтрокаТабл.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы;	
		НайденнаяСсылка = Справочники.СМ_ИтогиСметыПоВидамРабот.НайтиПоРеквизиту("Идентификатор","БуровзрывнРаб");
		СтрокаТабл.Итог = НайденнаяСсылка;
	ИначеЕсли ТекВид = Перечисления.СМ_ВидыЗатратСмета.ГорнопроходческиеРаботы Тогда
		СтрокаТабл.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы;	
		НайденнаяСсылка = Справочники.СМ_ИтогиСметыПоВидамРабот.НайтиПоРеквизиту("Идентификатор","ГорнопрохРаб");
		СтрокаТабл.Итог = НайденнаяСсылка;
	ИначеЕсли ТекВид = Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы Тогда
		СтрокаТабл.ВидРабот = ТекВид;
		НайденнаяСсылка = Справочники.СМ_ИтогиСметыПоВидамРабот.НайтиПоРеквизиту("Идентификатор","ПрочРаб");
		СтрокаТабл.Итог = НайденнаяСсылка;
	Иначе
		СтрокаТабл.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы;	
		НайденнаяСсылка = Справочники.СМ_ИтогиСметыПоВидамРабот.НайтиПоРеквизиту("Идентификатор","СтроитРаб");
		СтрокаТабл.Итог = НайденнаяСсылка;
	КонецЕсли;
	// Заполнение составляющих ПЗ.
	СтрокаТабл.ТекОснЗарплата = Стоимости.ТекСтоимОснЗарплата;
	СтрокаТабл.ТекЭксплМашин = Стоимости.ТекСтоимЭксплМашин;
	СтрокаТабл.ТекЗарплМашин = Стоимости.ТекСтоимЗарплМашин;
	СтрокаТабл.ТекСтоимМатер = Стоимости.ТекСтоимСтоимМатер;
	СтрокаТабл.ТекПрямЗатраты = Стоимости.ТекСтоимОснЗарплата + Стоимости.ТекСтоимЭксплМашин + Стоимости.ТекСтоимСтоимМатер;
	СтрокаТабл.ТекОборуд = Стоимости.ТекСтоимОборуд;
	СтрокаТабл.ЗатратыТрудаРабочих = Стоимости.ЗатратыТрудаРабочих;
	СтрокаТабл.ЗатратыТрудаМашин = Стоимости.ЗатратыТрудаМашин;
	СтрокаТабл.ОснЗарплата = 0;
	СтрокаТабл.ЭксплМашин = 0;
	СтрокаТабл.ЗарплМашин = 0;
	СтрокаТабл.СтоимМатер = 0;
	СтрокаТабл.Оборуд = 0;
	СтрокаТабл.ТекВозвратМатер = 0;
	СтрокаТабл.ВозвратМатер = 0;
КонецПроцедуры

Процедура РасчетЛимЗатраты(ИтогиПоГлавам, ИтогиПоВР,Ссылка,КолЗнаковРасчета)
	// Значения реквизита "Откуда":
	// 1 - от итога. 
	// 2 - от затраты.
	// 3 - по формуле.
	// Нужно лим затраты сортировать по реквизиту НомерПоПорядку, справочника лимитированные затраты.
	ТаблицаЗатрат = Ссылка.ЛимитированныеЗатраты.Выгрузить();
	ТаблицаЗатрат.Колонки.Добавить("НомерПоПорядку");
	Для каждого ЛЗ Из ТаблицаЗатрат Цикл
		ЛЗ.НомерПоПорядку = ЛЗ.ЛимитированнаяЗатрата.НомерПоПорядку;
	КонецЦикла;	
	ТаблицаЗатрат.Сортировать("НомерПоПорядку Возр", );
	
	Для Каждого ТекСтрока Из ТаблицаЗатрат Цикл
		
		ЛимитЗатрата 	= ТекСтрока.ЛимитированнаяЗатрата;
		КолЗнаков = КолЗнаковРасчета;
		Если  ЛимитЗатрата.Идентификатор = "ЛЗ64" Или ЛимитЗатрата.Идентификатор = "ЛЗ108"  Или ЛимитЗатрата.Идентификатор = "ЛЗ109" Тогда
			Продолжить;
		КонецЕсли;	
		
		Расчет =  ТекСтрока.Расчет;
		
		Если  Расчет = Ложь Тогда  Продолжить; 	КонецЕсли;	
		
		ТипЗатраты		= ЛимитЗатрата.ТипЗначенияЗатраты;
		ЗначениеЗатраты	= ТекСтрока.ЗначениеЛимЗатраты;
		БазисЗначениеЗатраты	= ТекСтрока.БазисноеЗначениеЛимЗатраты;
		
		КоэффициентТрудоемкости = ТекСтрока.КоэффициентТрудоемкости;
		КоэффициентСметнойЗарплаты = ТекСтрока.КоэффициентСметнойЗарплаты;
		
		ТекИтог  		= ТекСтрока.ЛимитированнаяЗатрата.ОтИтога;
		ТекГлава		= ТекИтог.ГлаваССРС;
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Глава",ТекГлава);
		СтруктураОтбора.Вставить("Итог",ТекИтог);
		
		СтруктураОтбора2 = Новый Структура;
		СтруктураОтбора2.Вставить("Смета",Ссылка);
		
		// Базисный уровень цен.
		ИсточникСтроитРаботПЗ = 0;
		ИсточникСтроитРаботОЗ = 0;
		ИсточникСтроитРаботЭМ = 0;
		ИсточникСтроитРаботЗМ = 0;
		ИсточникСтроитРаботСМ = 0;
		
		ИсточникМонтажРаботПЗ = 0;
		ИсточникМонтажРаботОЗ = 0;
		ИсточникМонтажРаботЭМ = 0;
		ИсточникМонтажРаботЗМ = 0;
		ИсточникМонтажРаботСМ = 0;
		
		ИсточникОборуд = 0;
		
		ИсточникПрочихРаботПЗ = 0;
		ИсточникПрочихРаботОЗ = 0;
		ИсточникПрочихРаботЭМ = 0;
		ИсточникПрочихРаботЗМ = 0;
		ИсточникПрочихРаботСМ = 0;
		
		// Текущий уровень цен.
