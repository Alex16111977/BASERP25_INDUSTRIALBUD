Функция СобратьСтрокуРасчета(Ссылка,ВидРаботИсточник,ТекСтрока,ИтогиПоГлавам, ИтогиПоВР)
	ТекИтог  		= ТекСтрока.ЛимитированнаяЗатрата.ОтИтога;
	ТекГлава		= ТекИтог.ГлаваССРС;
	ЛимитЗатрата =  ТекСтрока.ЛимитированнаяЗатрата;
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Глава",ТекГлава);
	СтруктураОтбора.Вставить("Итог",ТекИтог);
	СтруктураОтбора2 = Новый Структура;
	СтруктураОтбора2.Вставить("Смета",Ссылка);
	СтруктураОтбора.Вставить("ВидРабот",ВидРаботИсточник);
	Если ЛимитЗатрата.Откуда = 3 Тогда
		МассивСтрок = СобратьИтогиПоФормуле(ЛимитЗатрата, ВидРаботИсточник, ИтогиПоГлавам, ИтогиПоВР);
	ИначеЕсли ЛимитЗатрата.Откуда = 2 Тогда
		СтруктураОтбора.Итог = ЛимитЗатрата.ОтЗатраты;
		СтруктураОтбора.Глава = ЛимитЗатрата.ОтЗатраты.ГлаваССРС;
		МассивСтрок = ИтогиПоГлавам.НайтиСтроки(СтруктураОтбора);
	Иначе
		Если ТекИтог.Накопительный Тогда
			СтруктураОтбора.Глава = ТекГлава;
			СтруктураОтбора.Итог = ТекИтог;
			МассивСтрок = ИтогиПоГлавам.НайтиСтроки(СтруктураОтбора);
		Иначе
			СтруктураОтбора2.Вставить("ВидРабот",ВидРаботИсточник);
			МассивСтрок = ИтогиПоВР.НайтиСтроки(СтруктураОтбора2);
		КонецЕсли;
	КонецЕсли;
	
	Возврат(МассивСтрок);
КонецФункции

Процедура ДобавлениеЗатратыВНакопительныеИтоги(ИтогиПоГлавам,ТабНакопительныхИтогов,ТекВидРабот,ЛимитЗатрата,БазисЗначениеЗатраты,ЗначениеЗатраты)
	
	Для Каждого ТекущийИтог Из ТабНакопительныхИтогов Цикл
		СтруктураОтбора3 = Новый Структура;
		СтруктураОтбора3.Вставить("Глава",ТекущийИтог.Итог.ГлаваССРС);
		СтруктураОтбора3.Вставить("Итог",ТекущийИтог.Итог);
		СтруктураОтбора3.Вставить("ВидРабот",ТекВидРабот);
		Если ТекВидРабот = Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы Тогда
			ПриемникПЗ = ЛимитЗатрата.ПриемникСтроитРаботПЗ;
			ПриемникОЗ = ЛимитЗатрата.ПриемникСтроитРаботОЗ;
			ПриемникЭМ = ЛимитЗатрата.ПриемникСтроитРаботЭМ;
			ПриемникЗМ = ЛимитЗатрата.ПриемникСтроитРаботЗМ;
			ПриемникСМ = ЛимитЗатрата.ПриемникСтроитРаботСМ;
		ИначеЕсли ТекВидРабот = Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы	Тогда
			ПриемникПЗ = ЛимитЗатрата.ПриемникМонтажРаботПЗ;
			ПриемникОЗ = ЛимитЗатрата.ПриемникМонтажРаботОЗ;
			ПриемникЭМ = ЛимитЗатрата.ПриемникМонтажРаботЭМ;
			ПриемникЗМ = ЛимитЗатрата.ПриемникМонтажРаботЗМ;
			ПриемникСМ = ЛимитЗатрата.ПриемникМонтажРаботСМ;
			
		ИначеЕсли ТекВидРабот = Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы	Тогда
			ПриемникПЗ = ЛимитЗатрата.ПриемникПрочихРаботПЗ;
			ПриемникОЗ = ЛимитЗатрата.ПриемникПрочихРаботОЗ;
			ПриемникЭМ = ЛимитЗатрата.ПриемникПрочихРаботЭМ;
			ПриемникЗМ = ЛимитЗатрата.ПриемникПрочихРаботЗМ;
			ПриемникСМ = ЛимитЗатрата.ПриемникПрочихРаботСМ;
			
		ИначеЕсли ТекВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование	Тогда
			ПриемникОборуд = ЛимитЗатрата.ПриемникОборуд;
			МассивСтрок3 = ИтогиПоГлавам.НайтиСтроки(СтруктураОтбора3);
			Если МассивСтрок3.Количество() > 0 Тогда
				ТекущаяСтрока3 = МассивСтрок3[0];
				ТекущаяСтрока3.Оборуд = ТекущаяСтрока3.Оборуд + ?(ПриемникОборуд,БазисЗначениеЗатраты,0);
				ТекущаяСтрока3.ТекОборуд 	= ТекущаяСтрока3.ТекОборуд + ?(ПриемникОборуд,ЗначениеЗатраты,0);
				ТекущаяСтрока3.ПрямЗатраты	= ТекущаяСтрока3.Оборуд + ?(ПриемникОборуд,БазисЗначениеЗатраты,0);
				ТекущаяСтрока3.ТекПрямЗатраты = ТекущаяСтрока3.ТекОборуд + ?(ПриемникОборуд,ЗначениеЗатраты,0);
			КонецЕсли;
			Возврат;
		КонецЕсли;	
		
		МассивСтрок3 = ИтогиПоГлавам.НайтиСтроки(СтруктураОтбора3);
		Если МассивСтрок3.Количество() > 0 Тогда
			ТекущаяСтрока3 = МассивСтрок3[0];
			
			ТекущаяСтрока3.ПрямЗатраты		= ТекущаяСтрока3.ПрямЗатраты + ?(ПриемникПЗ,БазисЗначениеЗатраты,0);
			ТекущаяСтрока3.ОснЗарплата     	= ТекущаяСтрока3.ОснЗарплата + ?(ПриемникОЗ,БазисЗначениеЗатраты,0);
			ТекущаяСтрока3.ЭксплМашин      	= ТекущаяСтрока3.ЭксплМашин + ?(ПриемникЭМ,БазисЗначениеЗатраты,0);
			ТекущаяСтрока3.ЗарплМашин      	= ТекущаяСтрока3.ЗарплМашин + ?(ПриемникЗМ,БазисЗначениеЗатраты,0);
			ТекущаяСтрока3.СтоимМатер      	= ТекущаяСтрока3.СтоимМатер + ?(ПриемникСМ,БазисЗначениеЗатраты,0);
			
			ТекущаяСтрока3.ТекПрямЗатраты  	= ТекущаяСтрока3.ТекПрямЗатраты + ?(ПриемникПЗ,ЗначениеЗатраты,0);
			ТекущаяСтрока3.ТекОснЗарплата  	= ТекущаяСтрока3.ТекОснЗарплата + ?(ПриемникОЗ,ЗначениеЗатраты,0);
			ТекущаяСтрока3.ТекЭксплМашин   	= ТекущаяСтрока3.ТекЭксплМашин + ?(ПриемникЭМ,ЗначениеЗатраты,0);
			ТекущаяСтрока3.ТекЗарплМашин   	= ТекущаяСтрока3.ТекЗарплМашин + ?(ПриемникЗМ,ЗначениеЗатраты,0);
			ТекущаяСтрока3.ТекСтоимМатер   	= ТекущаяСтрока3.ТекСтоимМатер + ?(ПриемникСМ,ЗначениеЗатраты,0);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	

Функция НайтиЛимЗатрату(ИтогиПоГлавам,СсылкаЛЗ,Ссылка,ТекВидРабот)
	СтруктураОтбораЛЗ = Новый Структура;
	СтруктураОтбораЛЗ.Вставить("ВидРабот",ТекВидРабот);
	СтруктураОтбораЛЗ.Вставить("Итог",СсылкаЛЗ);
	СтруктураОтбораЛЗ.Вставить("Смета",Ссылка);
	МассивСтрокЛЗ = ИтогиПоГлавам.НайтиСтроки(СтруктураОтбораЛЗ);
	Если МассивСтрокЛЗ.Количество() > 0 Тогда 
		НоваяСтрока 			= МассивСтрокЛЗ[0];
	Иначе
		НоваяСтрока 			= ИтогиПоГлавам.Добавить(); 
		НоваяСтрока.Смета       = Ссылка;
		НоваяСтрока.Глава      	= СсылкаЛЗ.ГлаваССРС;
		НоваяСтрока.Итог        = СсылкаЛЗ;
		НоваяСтрока.ВидРабот    = ТекВидРабот;
		
	КонецЕсли;
	Возврат(НоваяСтрока);	
КонецФункции

Функция ОпределитьСоотвИстПриемЛимЗатрат(ЛимЗатр)
	
	ПрямоеНачисление = Ложь;
	Если ЛимЗатр.ИсточникМонтажРабот = ЛимЗатр.ПриемникМонтажРабот
		И ЛимЗатр.ИсточникСтроитРабот = ЛимЗатр.ПриемникСтроитРабот
		И ЛимЗатр.ИсточникОборуд = ЛимЗатр.ПриемникОборуд
		И ЛимЗатр.ИсточникПрочихРабот = ЛимЗатр.ПриемникПрочихРабот Тогда
		ПрямоеНачисление = Истина;	
	КонецЕсли;
	
	Возврат ПрямоеНачисление;
	
КонецФункции

Функция ПолучитьИтогиПоГлавамПоПорядковомуНомеру(ПорНомер)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИтогиПоГлавам.Ссылка КАК Итог,
	|	ИтогиПоГлавам.Наименование,
	|	ИтогиПоГлавам.ГлаваССРС,
	|	ИтогиПоГлавам.Накопительный,
	|	ИтогиПоГлавам.ПорядковыйНомер
	|ИЗ
	|	Справочник.СМ_ИтогиПоГлавам КАК ИтогиПоГлавам
	|ГДЕ
	|	ИтогиПоГлавам.ПорядковыйНомер > &ПорядковыйНомер
	|	И ИтогиПоГлавам.Накопительный = ИСТИНА";
	
	Запрос.УстановитьПараметр("ПорядковыйНомер",ПорНомер);
	ТабИтогов = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабИтогов;
	
КонецФункции

Функция СобратьИтогиПоФормуле(ЛимитЗатрата, ВидРаботИсточник, ИтогиГлав, ИтогиПоВР)
	СтрокаДействий = "+-";
	Табл = Новый ТаблицаЗначений;
	Табл.Колонки.Добавить("ПрямЗатраты",        Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,6)));
	Табл.Колонки.Добавить("ОснЗарплата",    Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,6)));
	Табл.Колонки.Добавить("ЭксплМашин",     Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,6)));
	Табл.Колонки.Добавить("ЗарплМашин", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,6)));
	Табл.Колонки.Добавить("СтоимМатер", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,6)));
	Табл.Колонки.Добавить("Оборуд", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,6)));
	Табл.Колонки.Добавить("ЗатратыТрудаРабочих", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,2)));
	Табл.Колонки.Добавить("ЗатратыТрудаМашин", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,2)));
	Табл.Колонки.Добавить("ТекПрямЗатраты",        Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,6)));
	Табл.Колонки.Добавить("ТекОснЗарплата",    Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,6)));
	Табл.Колонки.Добавить("ТекЭксплМашин",     Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,6)));
	Табл.Колонки.Добавить("ТекЗарплМашин", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,6)));
	Табл.Колонки.Добавить("ТекСтоимМатер", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,6)));
	Табл.Колонки.Добавить("ТекОборуд", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,6)));
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора2 = Новый Структура;
	СтруктураОтбора.Вставить("ВидРабот", ВидРаботИсточник);
	ФормулаЛЗ = СокрЛП(ЛимитЗатрата.ОтФормулы);
	Если ФормулаЛЗ = Неопределено Тогда
		Возврат Табл;
	КонецЕсли;
	ФормулаЛЗ = СтрЗаменить(ФормулаЛЗ," ","");
	ПервыйИтог = Истина;
	ДействиеФормулы = "";
	Пока  СтрДлина(ФормулаЛЗ) <> 0  Цикл
		Поз = 0;
		Для Сч = 1 По СтрДлина(ФормулаЛЗ) Цикл
			ТекСимв = Сред(ФормулаЛЗ,сч,1);
			Если Найти(СтрокаДействий,ТекСимв) = 0 Тогда Продолжить;
			Иначе
				Поз = Сч;
				Прервать;
			КонецЕсли;	
		КонецЦикла;		
		Если Поз = 0 Тогда
			Итог = ФормулаЛЗ;
			ФормулаЛЗ = "";
		Иначе
			Итог = Сред(ФормулаЛЗ,1,Поз - 1);
