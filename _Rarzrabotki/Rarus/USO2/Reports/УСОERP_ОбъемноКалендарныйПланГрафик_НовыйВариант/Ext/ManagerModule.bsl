#Область ПрограммныйИнтерфейс

Функция ПолучитьПредставлениеПериодаДляОтчета(ДатаПоГрафику, Периодичность=Неопределено, Заголовок="") Экспорт 
	
	Если Периодичность = Перечисления.Периодичность.Год Тогда 
		ПредставлениеПериода = Формат(ДатаПоГрафику, "ДФ='yyyy ''год'''");
		
	ИначеЕсли Периодичность = Перечисления.Периодичность.Месяц Тогда 
		ПредставлениеПериода = Формат(ДатаПоГрафику, "ДФ='MMM yy ''г.'''");
		
	ИначеЕсли Периодичность = Перечисления.Периодичность.Неделя Тогда 
		ПредставлениеПериода = СтрШаблон("%1 - %2", Формат(НачалоНедели(ДатаПоГрафику), "ДФ=dd.MM"), Формат(КонецНедели(ДатаПоГрафику), "ДФ=dd.MM"));
		
	ИначеЕсли Периодичность = Перечисления.Периодичность.День Тогда 
		ПредставлениеПериода = Формат(ДатаПоГрафику, "ДФ=dd.MM.yy");
		
	Иначе
		ПредставлениеПериода = "Всего";
	КонецЕсли;
	
	Если Заголовок = "" Тогда 
		Возврат ПредставлениеПериода;
		
	Иначе 
		Возврат Заголовок + Символы.ПС + "(" + ПредставлениеПериода + ")";
	КонецЕсли;
	
КонецФункции

