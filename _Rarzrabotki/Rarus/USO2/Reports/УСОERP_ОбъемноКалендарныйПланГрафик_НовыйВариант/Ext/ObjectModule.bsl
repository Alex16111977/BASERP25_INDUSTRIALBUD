#Область ПрограммныйИнтерфейс

// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
//   Форма - УправляемаяФорма - Форма отчета.
//   КлючВарианта - Строка - Имя предопределенного варианта отчета или уникальный идентификатор пользовательского.
//   Настройки - Структура - см. возвращаемое значение ОтчетыКлиентСервер.ПолучитьНастройкиОтчетаПоУмолчанию().
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт 
	
	Настройки.События.ПриСозданииНаСервере = Истина;
	
КонецПроцедуры

// Вызывается в обработчике одноименного события формы отчета после выполнения кода формы.
//
// Параметры:
//   Форма - УправляемаяФорма - Форма отчета.
//   Отказ - Передается из параметров обработчика "как есть".
//   СтандартнаяОбработка - Передается из параметров обработчика "как есть".
//
// См. также:
//   "УправляемаяФорма.ПриСозданииНаСервере" в синтакс-помощнике.
//
Процедура ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка) Экспорт
	
	Параметры = ЭтаФорма.Параметры;
	
	Если Параметры.Свойство("ПараметрКоманды")
			И Параметры.Свойство("ОписаниеКоманды")
			И Параметры.ОписаниеКоманды.Свойство("ДополнительныеПараметры") Тогда
		
		Если Параметры.ОписаниеКоманды.ДополнительныеПараметры.Свойство("ДокументУтверждения") Тогда
			
			ЭтаФорма.ФормаПараметры.Отбор.Вставить("ДокументУтверждения", Параметры.ПараметрКоманды);
			ЭтаФорма.ФормаПараметры.Отбор.Вставить("ОбъектСтроительства",Параметры.ПараметрКоманды.ОбъектСтроительства);
			ЭтаФорма.Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
			
		КонецЕсли;          
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриОпределенииНастроекОтчета(НастройкиОтчета, НастройкиВариантов) Экспорт
	
	НастройкиОтчета.ПоказыватьНастройкиДиаграммыНаФормеОтчета = Ложь;
	
КонецПроцедуры

Процедура ОбновитьНастройкиНаФорме(НастройкиОтчета, НастройкиСКД, Форма) Экспорт
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДокументРезультат.Очистить();
	
	НастройкиКомпоновки = КомпоновщикНастроек.ПолучитьНастройки();
	
	ПараметрыДанных = НастройкиКомпоновки.ПараметрыДанных;
	
	ДокументУтверждения = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДокументУтверждения")).Значение;
	РазделятьОбъемПоСтрокам = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("РазделятьОбъемПоСтрокам")).Значение;
	
	ПараметрПериодичность = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Периодичность"));
	
	Если ПараметрПериодичность <> Неопределено И ПараметрПериодичность.Значение <> Неопределено
			И ПараметрПериодичность.Значение <> Перечисления.Периодичность.ПустаяСсылка()
			И ПараметрПериодичность.Использование Тогда 
		Периодичность = ПараметрПериодичность.Значение;
	Иначе 
		Периодичность = Неопределено;
	КонецЕсли;
	
	Если Не ПараметрПериодичность = Неопределено И Периодичность = Неопределено Тогда 
		ПараметрПериодичность.Использование = Истина;
		ПараметрПериодичность.Значение = Перечисления.Периодичность.ПустаяСсылка();
	КонецЕсли;
	
	Если ДокументУтверждения = Неопределено Тогда 
		ДокументУтверждения = Документы.УСОERP_УтверждениеКалендарногоПланаГрафика.ПустаяСсылка();
	КонецЕсли;
	
	СценарийПланирования = ДокументУтверждения.КопияСценария;
	
	НастройкиКомпоновки.ПараметрыВывода.Элементы.Найти("Заголовок").Значение = СтрШаблон(
		"%1 (№ %2 от %3)",
		СценарийПланирования,
		СценарийПланирования.НомерВерсии,
		Формат(СценарийПланирования.ДатаСохранения, "ДФ=dd.MM.yyyy"));
	
	Если Периодичность = Неопределено Тогда 
		ПараметрИтоги = НастройкиКомпоновки.ПараметрыВывода.Элементы.Найти("ГоризонтальноеРасположениеОбщихИтогов");
		
		Если Не ПараметрИтоги = Неопределено Тогда 
			ПараметрИтоги.Значение = РасположениеИтоговКомпоновкиДанных.Нет;
			ПараметрИтоги.Использование = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ТаблицаОтчета", ПолучитьТаблицуДляОтчета(ДокументУтверждения, Периодичность, РазделятьОбъемПоСтрокам));
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновки, ДанныеРасшифровки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных();
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент();
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
КонецПроцедуры 

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьТаблицуДляОтчета(ДокументУтверждения, Периодичность, РазделятьОбъемПоСтрокам)
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц();
	
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.УстановитьПараметр("ДокументУтверждения", ДокументУтверждения);
	Запрос.УстановитьПараметр("Периодичность",       Периодичность);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_СтроительныеРаботы.Ссылка КАК СтроительнаяРабота,
	|	УСОERP_СтроительныеРаботы.ДатаНачала КАК ДатаНачала,
	|	УСОERP_СтроительныеРаботы.ДатаОкончания КАК ДатаОкончания,
	|	УСОERP_СтроительныеРаботы.ГрафикРаботы КАК ГрафикРаботы,
	|	НАЧАЛОПЕРИОДА(УСОERP_СтроительныеРаботы.ДатаНачала, ДЕНЬ) КАК ДатаНачалаПоГрафику,
	|	НАЧАЛОПЕРИОДА(УСОERP_СтроительныеРаботы.ДатаОкончания, ДЕНЬ) КАК ДатаОкончанияПоГрафику,
	|	УСОERP_СтроительныеРаботы.ОбъемРаботы КАК ОбъемРаботы,
	|	УСОERP_СтроительныеРаботы.ЕдиницаОбъема КАК ЕдиницаОбъема
	|ПОМЕСТИТЬ ВТ_ФормированиеГрафика
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
	|	И УСОERP_СтроительныеРаботы.Владелец = ВЫРАЗИТЬ(&ДокументУтверждения КАК Документ.УСОERP_УтверждениеКалендарногоПланаГрафика).КопияСценария
	|	И НЕ УСОERP_СтроительныеРаботы.СуммарнаяРабота
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СтроительнаяРабота,
	|	ГрафикРаботы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ФормированиеГрафика.СтроительнаяРабота КАК СтроительнаяРабота
	|ПОМЕСТИТЬ ВТ_СтроительныеРаботы
	|ИЗ
	|	ВТ_ФормированиеГрафика КАК ВТ_ФормированиеГрафика
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СтроительнаяРабота
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(ВТ_ФормированиеГрафика.ДатаНачалаПоГрафику) КАК ДатаНачалаПоГрафику,
	|	МАКСИМУМ(ВТ_ФормированиеГрафика.ДатаОкончанияПоГрафику) КАК ДатаОкончанияПоГрафику
	|ИЗ
	|	ВТ_ФормированиеГрафика КАК ВТ_ФормированиеГрафика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ФормированиеГрафика.ГрафикРаботы КАК ГрафикРаботы
	|ИЗ
	|	ВТ_ФормированиеГрафика КАК ВТ_ФормированиеГрафика";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Если Периодичность = Неопределено Тогда 
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВТ_ФормированиеГрафика.СтроительнаяРабота КАК СтроительнаяРабота,
		|	ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) КАК ДатаГрафика,
		|	1 КАК КоличествоДней
		|ПОМЕСТИТЬ ВТ_ДниГрафика
		|ИЗ
		|	ВТ_ФормированиеГрафика КАК ВТ_ФормированиеГрафика";
		
		Запрос.Выполнить();
		
	Иначе 
		ВыборкаДат = РезультатЗапроса[2].Выбрать();
		Если ВыборкаДат.Следующий() Тогда 
			ОбщаяДатаНачала    = ВыборкаДат.ДатаНачалаПоГрафику;
			ОбщаяДатаОкончания = ВыборкаДат.ДатаОкончанияПоГрафику;
		Иначе 
			ОбщаяДатаНачала    = '00010101';
			ОбщаяДатаОкончания = '00010101';
		КонецЕсли;
		
		ИспользуемыеГрафики = РезультатЗапроса[3].Выгрузить().ВыгрузитьКолонку("ГрафикРаботы");
		
		ГрафикиРаботы.СоздатьВТРасписанияРаботыНаПериод(
			МенеджерВТ,
			ИспользуемыеГрафики,
			ОбщаяДатаНачала,
			ОбщаяДатаОкончания);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВТ_ФормированиеГрафика.СтроительнаяРабота КАК СтроительнаяРабота,
		|	РасписанияРаботы.ДатаГрафика КАК ДатаГрафика,
		|	1 КАК КоличествоДней
		|ПОМЕСТИТЬ ВТ_ДниГрафика
		|ИЗ
		|	ВТ_ФормированиеГрафика КАК ВТ_ФормированиеГрафика
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТРасписанияРаботы КАК РасписанияРаботы
		|		ПО ВТ_ФормированиеГрафика.ГрафикРаботы = РасписанияРаботы.ГрафикРаботы
		|			И (РасписанияРаботы.ДатаГрафика >= ВТ_ФормированиеГрафика.ДатаНачалаПоГрафику)
		|			И (РасписанияРаботы.ДатаГрафика <= ВТ_ФормированиеГрафика.ДатаОкончанияПоГрафику)";
		
		Запрос.Выполнить();
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_СтроительныеРаботы.СтроительнаяРабота КАК СтроительнаяРабота,
	|	ЕСТЬNULL(ВложенныйЗапрос.НомерСтроки, 0) КАК НомерСтроки,
	|	ВложенныйЗапрос.ВидЗатрат КАК ВидЗатрат,
	|	ЕСТЬNULL(ВложенныйЗапрос.ВидЗатрат, """") КАК ВидЗатратДляПоиска,
	|	ЕСТЬNULL(ВложенныйЗапрос.Ресурс, ЗНАЧЕНИЕ(Справочник.УСОERP_Ресурсы.ПустаяСсылка)) КАК Ресурс,
	|	ЕСТЬNULL(ВложенныйЗапрос.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ЕСТЬNULL(ВложенныйЗапрос.Количество, 0) КАК Количество,
	|	ЕСТЬNULL(ВложенныйЗапрос.Трудоемкость, 0) КАК Трудоемкость,
	|	ЕСТЬNULL(ВложенныйЗапрос.Машиноемкость, 0) КАК Машиноемкость,
	|	ЕСТЬNULL(ВложенныйЗапрос.Упаковка, 0) КАК Упаковка,
	|	УСОERP_СтроительныеРаботы.ДатаНачала КАК ДатаНачала,
	|	УСОERP_СтроительныеРаботы.ДатаОкончания КАК ДатаОкончания,
	|	УСОERP_СтроительныеРаботы.ОбъемРаботы КАК ОбъемРаботы,
	|	УСОERP_СтроительныеРаботы.ЕдиницаОбъема КАК ЕдиницаОбъема,
	|	ЕСТЬNULL(ВложенныйЗапрос.РесурсДляОтбора, ЗНАЧЕНИЕ(Справочник.УСОERP_Ресурсы.ПустаяСсылка)) КАК РесурсДляОтбора,
	|	ЕСТЬNULL(ВложенныйЗапрос.НоменклатураДляОтбора, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК НоменклатураДляОтбора,
	|	ЕСТЬNULL(ВложенныйЗапрос.КонструктивДляОтбора, ЗНАЧЕНИЕ(Справочник.УСОERP_Конструктив.ПустаяСсылка)) КАК КонструктивДляОтбора,
	|	ЕСТЬNULL(ВложенныйЗапрос.КоличествоПовторенийОбъема, 1) КАК КоличествоПовторенийОбъема
	|ПОМЕСТИТЬ ВТ_ОбщиеДанные
	|ИЗ
	|	ВТ_ФормированиеГрафика КАК УСОERP_СтроительныеРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			УСОERP_СтроительныеРаботыРесурсы.Ссылка КАК СтроительнаяРабота,
	|			УСОERP_СтроительныеРаботыРесурсы.Ресурс КАК Ресурс,
	|			УСОERP_СтроительныеРаботыРесурсы.Количество КАК Количество,
	|			""Ресурсы"" КАК ВидЗатрат,
	|			УСОERP_СтроительныеРаботыРесурсы.НомерСтроки КАК НомерСтроки,
	|			УСОERP_СтроительныеРаботыРесурсы.Трудоемкость КАК Трудоемкость,
	|			УСОERP_СтроительныеРаботыРесурсы.Машиноемкость КАК Машиноемкость,
	|			УСОERP_СтроительныеРаботыРесурсы.ЗагрузкаПроцент КАК Характеристика,
	|			ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) КАК Упаковка,
	|			УСОERP_СтроительныеРаботыРесурсы.Ресурс КАК РесурсДляОтбора,
	|			ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК НоменклатураДляОтбора,
	|			ЗНАЧЕНИЕ(Справочник.УСОERP_Конструктив.ПустаяСсылка) КАК КонструктивДляОтбора,
	|			1 КАК КоличествоПовторенийОбъема
	|		ИЗ
	|			Справочник.УСОERP_СтроительныеРаботы.Ресурсы КАК УСОERP_СтроительныеРаботыРесурсы
	|		ГДЕ
	|			УСОERP_СтроительныеРаботыРесурсы.Ссылка В
	|					(ВЫБРАТЬ
	|						ВТ.СтроительнаяРабота
	|					ИЗ
	|						ВТ_СтроительныеРаботы КАК ВТ)
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ
	|			УСОERP_СтроительныеРаботыМатериалы.Ссылка,
	|			УСОERP_СтроительныеРаботыМатериалы.Номенклатура,
	|			УСОERP_СтроительныеРаботыМатериалы.КоличествоУпаковокНаОбъемРаботы,
	|			""Материалы"",
	|			УСОERP_СтроительныеРаботыМатериалы.НомерСтроки,
	|			0,
	|			0,
	|			УСОERP_СтроительныеРаботыМатериалы.Характеристика,
	|			ВЫБОР
	|				КОГДА УСОERP_СтроительныеРаботыМатериалы.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|					ТОГДА УСОERP_СтроительныеРаботыМатериалы.Номенклатура.ЕдиницаИзмерения
	|				ИНАЧЕ УСОERP_СтроительныеРаботыМатериалы.Упаковка
	|			КОНЕЦ,
	|			ЗНАЧЕНИЕ(Справочник.УСОERP_Ресурсы.ПустаяСсылка),
	|			УСОERP_СтроительныеРаботыМатериалы.Номенклатура,
	|			ЗНАЧЕНИЕ(Справочник.УСОERP_Конструктив.ПустаяСсылка),
	|			1
	|		ИЗ
	|			Справочник.УСОERP_СтроительныеРаботы.Материалы КАК УСОERP_СтроительныеРаботыМатериалы
	|		ГДЕ
	|			УСОERP_СтроительныеРаботыМатериалы.Ссылка В
	|					(ВЫБРАТЬ
	|						ВТ.СтроительнаяРабота
	|					ИЗ
	|						ВТ_СтроительныеРаботы КАК ВТ)
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ
	|			УСОERP_СтроительныеРаботыКонструктивы.Ссылка,
