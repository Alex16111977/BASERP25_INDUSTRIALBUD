	|	ВТ_ОбщиеДанные.КонструктивДляОтбора КАК КонструктивДляОтбора,
	|	ВТ_ДниГрафика.ДатаГрафика КАК ДатаПоГрафику,
	|	ВТ_ВсегоДней.КоличествоДней КАК ВсегоДней,
	|	ВТ_ИтогиКоличество.ОбъемРаботы КАК ВсегоОбъемРаботы,
	|	ВТ_ИтогиКоличество.Количество КАК ВсегоКоличество,
	|	ВТ_ИтогиКоличество.Трудоемкость КАК ВсегоТрудоемкость,
	|	ВТ_ИтогиКоличество.Машиноемкость КАК ВсегоМашиноемкость,
	|	ВТ_КоличествоПовторенийОбъема.КоличествоПовторенийОбъема КАК КоличествоПовторенийОбъема
	|ИЗ
	|	ВТ_ОбщиеДанные КАК ВТ_ОбщиеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДниГрафика КАК ВТ_ДниГрафика
	|		ПО ВТ_ОбщиеДанные.СтроительнаяРабота = ВТ_ДниГрафика.СтроительнаяРабота
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВсегоДней КАК ВТ_ВсегоДней
	|		ПО ВТ_ОбщиеДанные.СтроительнаяРабота = ВТ_ВсегоДней.СтроительнаяРабота
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИтогиКоличество КАК ВТ_ИтогиКоличество
	|		ПО ВТ_ОбщиеДанные.СтроительнаяРабота = ВТ_ИтогиКоличество.СтроительнаяРабота
	|			И ВТ_ОбщиеДанные.НомерСтроки = ВТ_ИтогиКоличество.НомерСтроки
	|			И ВТ_ОбщиеДанные.ВидЗатратДляПоиска = ВТ_ИтогиКоличество.ВидЗатратДляПоиска
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоПовторенийОбъема КАК ВТ_КоличествоПовторенийОбъема
	|		ПО ВТ_ОбщиеДанные.СтроительнаяРабота = ВТ_КоличествоПовторенийОбъема.СтроительнаяРабота";
	
	ОтраженныеСтрокиШапки = Новый ТаблицаЗначений();
	ОтраженныеСтрокиШапки.Колонки.Добавить("СтроительнаяРабота");
	
	ОтраженныеСтрокиТЧ = Новый ТаблицаЗначений();
	ОтраженныеСтрокиТЧ.Колонки.Добавить("СтроительнаяРабота");
	ОтраженныеСтрокиТЧ.Колонки.Добавить("НомерСтроки");
	ОтраженныеСтрокиТЧ.Колонки.Добавить("ВидЗатратДляПоиска");
	
	ТаблицаДляОтчета = Запрос.Выполнить().Выгрузить();
	
	ТаблицаДляОтчета.Колонки.Добавить("ОбъемРаботы",   Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(22, 8)));
	ТаблицаДляОтчета.Колонки.Добавить("Количество",    Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(22, 8)));
	ТаблицаДляОтчета.Колонки.Добавить("Трудоемкость",  Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(22, 8)));
	ТаблицаДляОтчета.Колонки.Добавить("Машиноемкость", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(22, 8)));
	
	Для Каждого СтрокаТаблицы Из ТаблицаДляОтчета Цикл 
		ФильтрПоискаШапки = Новый Структура();
		ФильтрПоискаШапки.Вставить("СтроительнаяРабота", СтрокаТаблицы.СтроительнаяРабота);
		
		ФильтрПоискаТЧ = Новый Структура();
		ФильтрПоискаТЧ.Вставить("СтроительнаяРабота", СтрокаТаблицы.СтроительнаяРабота);
		ФильтрПоискаТЧ.Вставить("НомерСтроки",        СтрокаТаблицы.НомерСтроки);
		ФильтрПоискаТЧ.Вставить("ВидЗатратДляПоиска", СтрокаТаблицы.ВидЗатратДляПоиска);
		
		ОбъемРаботыВДень   = Окр(СтрокаТаблицы.ВсегоОбъемРаботы / (?(СтрокаТаблицы.ВсегоДней = 0, 1, СтрокаТаблицы.ВсегоДней) * ?(РазделятьОбъемПоСтрокам, СтрокаТаблицы.КоличествоПовторенийОбъема, 1)), 8);
		КоличествоВДень    = Окр(СтрокаТаблицы.ВсегоКоличество / ?(СтрокаТаблицы.ВсегоДней = 0, 1, СтрокаТаблицы.ВсегоДней), 8);
		ТрудоемкостьВДень  = Окр(СтрокаТаблицы.ВсегоТрудоемкость / ?(СтрокаТаблицы.ВсегоДней = 0, 1, СтрокаТаблицы.ВсегоДней), 8);
		МашиноемкостьВДень = Окр(СтрокаТаблицы.ВсегоМашиноемкость / ?(СтрокаТаблицы.ВсегоДней = 0, 1, СтрокаТаблицы.ВсегоДней), 8);
		
		Если ОтраженныеСтрокиШапки.НайтиСтроки(ФильтрПоискаШапки).Количество() = 0 Тогда 
			ОбъемРаботыВДень = ОбъемРаботыВДень + (СтрокаТаблицы.ВсегоОбъемРаботы - (ОбъемРаботыВДень * ?(СтрокаТаблицы.ВсегоДней = 0, 1, СтрокаТаблицы.ВсегоДней) * ?(РазделятьОбъемПоСтрокам, СтрокаТаблицы.КоличествоПовторенийОбъема, 1)));
			ЗаполнитьЗначенияСвойств(ОтраженныеСтрокиШапки.Добавить(), ФильтрПоискаШапки);
		КонецЕсли;
		
		Если ОтраженныеСтрокиТЧ.НайтиСтроки(ФильтрПоискаТЧ).Количество() = 0 Тогда 
			КоличествоВДень    = КоличествоВДень + (СтрокаТаблицы.ВсегоКоличество - (КоличествоВДень * ?(СтрокаТаблицы.ВсегоДней = 0, 1, СтрокаТаблицы.ВсегоДней)));
			ТрудоемкостьВДень  = ТрудоемкостьВДень + (СтрокаТаблицы.ВсегоТрудоемкость - (ТрудоемкостьВДень * ?(СтрокаТаблицы.ВсегоДней = 0, 1, СтрокаТаблицы.ВсегоДней)));
			МашиноемкостьВДень = МашиноемкостьВДень + (СтрокаТаблицы.ВсегоМашиноемкость - (МашиноемкостьВДень * ?(СтрокаТаблицы.ВсегоДней = 0, 1, СтрокаТаблицы.ВсегоДней)));
			
			ЗаполнитьЗначенияСвойств(ОтраженныеСтрокиТЧ.Добавить(), ФильтрПоискаТЧ);
		КонецЕсли;
		
		СтрокаТаблицы.ОбъемРаботы   = ОбъемРаботыВДень;
		СтрокаТаблицы.Количество    = КоличествоВДень;
		СтрокаТаблицы.Трудоемкость  = ТрудоемкостьВДень;
		СтрокаТаблицы.Машиноемкость = МашиноемкостьВДень;
		
		Если Периодичность = Перечисления.Периодичность.Год Тогда 
			СтрокаТаблицы.ДатаПоГрафику = НачалоГода(СтрокаТаблицы.ДатаПоГрафику);
		ИначеЕсли Периодичность = Перечисления.Периодичность.Месяц Тогда 
			СтрокаТаблицы.ДатаПоГрафику = НачалоМесяца(СтрокаТаблицы.ДатаПоГрафику);
		ИначеЕсли Периодичность = Перечисления.Периодичность.Неделя Тогда 
			СтрокаТаблицы.ДатаПоГрафику = НачалоНедели(СтрокаТаблицы.ДатаПоГрафику);
		ИначеЕсли Периодичность = Перечисления.Периодичность.День Тогда 
			СтрокаТаблицы.ДатаПоГрафику = НачалоДня(СтрокаТаблицы.ДатаПоГрафику);
		КонецЕсли;
	КонецЦикла;
	
	МенеджерВТ.Закрыть();
	
	Возврат ТаблицаДляОтчета;
	
КонецФункции

