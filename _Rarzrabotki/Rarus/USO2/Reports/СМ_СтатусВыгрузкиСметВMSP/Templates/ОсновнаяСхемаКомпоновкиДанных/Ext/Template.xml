		<query>ВЫБРАТЬ
	СМ_ЛокальнаяСмета.Ссылка
ПОМЕСТИТЬ Сметы
ИЗ
	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
ГДЕ
	СМ_ЛокальнаяСмета.Стройка = &amp;Стройка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СМ_ПозицияЛокальнойСметы.Ссылка,
	ЕСТЬNULL(СМ_MSP_СтатусыВыгрузкиДокументов.Статус, ЗНАЧЕНИЕ(Перечисление.СМ_MSP_СтатусыВыгрузкиДокументов.НеВыгружен)) КАК Статус,
	СМ_ПозицияЛокальнойСметы.ИДСметы,
	СМ_ПозицияЛокальнойСметы.ИДРодителя,
	СМ_ПозицияЛокальнойСметы.ПорНомер
ПОМЕСТИТЬ Позиции
ИЗ
	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_MSP_СтатусыВыгрузкиДокументов КАК СМ_MSP_СтатусыВыгрузкиДокументов
		ПО (СМ_MSP_СтатусыВыгрузкиДокументов.Документ = СМ_ПозицияЛокальнойСметы.Ссылка)
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Сметы КАК Сметы
		ПО СМ_ПозицияЛокальнойСметы.ИДСметы = Сметы.Ссылка

ИНДЕКСИРОВАТЬ ПО
	СМ_ПозицияЛокальнойСметы.ИДСметы
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Позиции.ИДСметы,
	Позиции.Статус,
	КОЛИЧЕСТВО(Позиции.Ссылка) КАК Количество
ПОМЕСТИТЬ ВТКоличествоСтатусов
ИЗ
	Позиции КАК Позиции

СГРУППИРОВАТЬ ПО
	Позиции.ИДСметы,
	Позиции.Статус
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Позиции.ИДСметы,
	КОЛИЧЕСТВО(Позиции.Ссылка) КАК Количество
ПОМЕСТИТЬ ВТКоличествоПозиций
ИЗ
	Позиции КАК Позиции

СГРУППИРОВАТЬ ПО
	Позиции.ИДСметы
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Сметы.Ссылка,
	ВТКоличествоСтатусов.Количество КАК Выгружено,
	ВТКоличествоСтатусов1.Количество КАК Измененных,
	ВТКоличествоПозиций.Количество,
	ВЫБОР
		КОГДА ЕСТЬNULL(ВТКоличествоСтатусов.Количество, 0) &gt; 0
				И ЕСТЬNULL(ВТКоличествоСтатусов.Количество, 0) = ЕСТЬNULL(ВТКоличествоПозиций.Количество, 0)
			ТОГДА "Выгружена"
		КОГДА ЕСТЬNULL(ВТКоличествоСтатусов.Количество, 0) &gt; 0
				И ЕСТЬNULL(ВТКоличествоСтатусов.Количество, 0) &lt;&gt; ЕСТЬNULL(ВТКоличествоПозиций.Количество, 0)
			ТОГДА "Выгружена частично"
		ИНАЧЕ "Не выгружена"
	КОНЕЦ КАК СостояниеВыгрузки,
	ВЫБОР
		КОГДА ЕСТЬNULL(ВТКоличествоСтатусов1.Количество, 0) &gt; 0
			ТОГДА "Изменена после выгрузки"
		ИНАЧЕ "Не изменялась"
	КОНЕЦ КАК ИзмененияПослеВыгрузки
ПОМЕСТИТЬ ВтСметы
ИЗ
	Сметы КАК Сметы
		ЛЕВОЕ СОЕДИНЕНИЕ ВТКоличествоСтатусов КАК ВТКоличествоСтатусов
		ПО Сметы.Ссылка = ВТКоличествоСтатусов.ИДСметы
			И (ВТКоличествоСтатусов.Статус = ЗНАЧЕНИЕ(Перечисление.СМ_MSP_СтатусыВыгрузкиДокументов.Выгружен))
		ЛЕВОЕ СОЕДИНЕНИЕ ВТКоличествоСтатусов КАК ВТКоличествоСтатусов1
		ПО Сметы.Ссылка = ВТКоличествоСтатусов1.ИДСметы
			И (ВТКоличествоСтатусов1.Статус = ЗНАЧЕНИЕ(Перечисление.СМ_MSP_СтатусыВыгрузкиДокументов.ИзмененПослеВыгрузки))
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКоличествоПозиций КАК ВТКоличествоПозиций
		ПО Сметы.Ссылка = ВТКоличествоПозиций.ИДСметы
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВтСметы.Ссылка КАК Смета,
	1 КАК ВсегоПозиций,
	ВтСметы.СостояниеВыгрузки,
	ВтСметы.ИзмененияПослеВыгрузки,
	Позиции.Ссылка КАК Позиция,
	Позиции.Статус КАК СтатусПозиции,
	Позиции.ИДРодителя КАК Раздел,
	Позиции.ПорНомер,
	ВЫБОР
		КОГДА Позиции.Статус = ЗНАЧЕНИЕ(Перечисление.СМ_MSP_СтатусыВыгрузкиДокументов.Выгружен)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК Выгружено,
	ВЫБОР
		КОГДА Позиции.Статус = ЗНАЧЕНИЕ(Перечисление.СМ_MSP_СтатусыВыгрузкиДокументов.ИзмененПослеВыгрузки)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК Измененных
ИЗ
	ВтСметы КАК ВтСметы
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Позиции КАК Позиции
		ПО ВтСметы.Ссылка = Позиции.ИДСметы</query>
