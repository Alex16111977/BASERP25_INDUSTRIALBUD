#Область ОбработчикиСобытий

&НаКлиенте
Процедура ЛокальнаяСметаПриИзменении(Элемент)
	
	ПодобратьАктыВыполненныхРаботНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПодобратьАктыВыполненныхРаботНаСервере()
	
	АктыВыполненныхРабот.ПолучитьЭлементы().Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_АктВыполненныхРабот.Ссылка КАК АктВыполненныхРабот,
	               |	СМ_АктВыполненныхРабот.ЛокальнаяСмета КАК Смета,
	               |	ИСТИНА КАК Использовать
	               |ИЗ
	               |	Документ.СМ_АктВыполненныхРабот КАК СМ_АктВыполненныхРабот
	               |ГДЕ
	               |	СМ_АктВыполненныхРабот.ЛокальнаяСмета В (&ЛокальнаяСмета)
	               |	И НЕ СМ_АктВыполненныхРабот.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Смета";
				   
	Запрос.УстановитьПараметр("ЛокальнаяСмета",ЛокальнаяСмета);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Дерево = АктыВыполненныхРабот.ПолучитьЭлементы();
	Смета = Неопределено;
	Для Каждого СтрокаЗапроса Из РезультатЗапроса Цикл
		Если Смета <> СтрокаЗапроса.Смета Тогда
			Смета = СтрокаЗапроса.Смета;
			НоваяСтрока = Дерево.Добавить();
			НоваяСтрока.Смета = Смета;
			НоваяСтрока.Использовать = Истина;
		КонецЕсли;
		СтрокаПодчинения = НоваяСтрока.ПолучитьЭлементы().Добавить();
		СтрокаПодчинения.АктВыполненныхРабот = СтрокаЗапроса.АктВыполненныхРабот;
		СтрокаПодчинения.Использовать = Истина;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Не ГлобальнаяСтрокаДереваСмет = Неопределено И Не ГлобальнаяСтрокаДереваСмет.ПометкаУдаления Тогда
		ЛокальнаяСмета.Очистить();
		ЛокальнаяСмета.Добавить(ГлобальнаяСтрокаДереваСмет.Ссылка);
	КонецЕсли;
	ПодобратьАктыВыполненныхРаботНаСервере();
	ПодобратьДеревоАктовНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	
	Разделять = Ложь;
	Если Элементы.ГруппаШапка.ТекущаяСтраница = Элементы.ГруппаСмета Тогда
		Результат.Очистить();
		ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
		
		ЭлементыДерева = АктыВыполненныхРабот.ПолучитьЭлементы();
		МассивАктов = Новый Массив;
		// МассивСмет = Новый Массив;
		
		Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
			ПодчиненныеЭлементыДерева = ЭлементДерева.ПолучитьЭлементы();
			Для Каждого ПодчиненныйЭлементДерева Из ПодчиненныеЭлементыДерева Цикл
				Если ПодчиненныйЭлементДерева.Использовать Тогда
					МассивАктов.Добавить(ПодчиненныйЭлементДерева);
				КонецЕсли;
			КонецЦикла;
			// Если ЭлементДерева.Использовать Тогда
			//	МассивСмет.Добавить(ЭлементДерева);
			// КонецЕсли;
			Если МассивАктов.Количество()>0 Тогда
				ОтчетОбъект.ПолучитьЗаполненныйОтчет(Разделять,МассивАктов,Результат,,ТолькоМатериалы, ТолькоФакт,,ИсключатьМатериалы,ВыводитьДоговор,ВыводитьПодрядчика,ВыводитьПодписи);
				МассивАктов.Очистить();
			КонецЕсли;
		КонецЦикла;
		
		Результат.АвтоМасштаб = Истина;
	Иначе
		Результат.Очистить();
		ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
		ЭлементыДерева = ДеревоАктов.ПолучитьЭлементы();
		МассивАктов = Новый Массив;
		Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
			ПодчиненныеЭлементыДерева = ЭлементДерева.ПолучитьЭлементы();
			Для Каждого ПодчиненныйЭлементДерева Из ПодчиненныеЭлементыДерева Цикл
				Если ПодчиненныйЭлементДерева.Использовать Тогда
					МассивАктов.Добавить(ПодчиненныйЭлементДерева);
				КонецЕсли;
			КонецЦикла;
			Если Не Сводный И МассивАктов.Количество()>0 Тогда
				ОтчетОбъект.ПолучитьЗаполненныйОтчет(Разделять,МассивАктов,Результат,,ТолькоМатериалы, ТолькоФакт,,ИсключатьМатериалы,ВыводитьДоговор,ВыводитьПодрядчика,ВыводитьПодписи);
				МассивАктов.Очистить();
			КонецЕсли
		КонецЦикла;
		Если Сводный Тогда
			ПредставлениеПериода = СокрЛП(ПредставлениеПериода(Период.ДатаНачала,Период.ДатаОкончания));
			ОтчетОбъект.ПолучитьЗаполненныйОтчет(Разделять,МассивАктов,Результат,ПредставлениеПериода,ТолькоМатериалы,ТолькоФакт,,,,,ВыводитьПодписи);
		КонецЕсли;
		Результат.ОтображатьСетку = Ложь;
		Результат.АвтоМасштаб = Истина;
		Элементы.Результат.ОтображатьСетку = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаказчикПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Период.ДатаНачала) И ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		ПодобратьДеревоАктовНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Заказчик) Тогда
		ПодобратьДеревоАктовНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПодобратьДеревоАктовНаСервере()
	
	ДеревоАктов.ПолучитьЭлементы().Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_АктВыполненныхРабот.Ссылка КАК АктВыполненныхРабот,
	               |	СМ_АктВыполненныхРабот.ЛокальнаяСмета КАК Смета,
	               |	ИСТИНА КАК Использовать
	               |ИЗ
	               |	Документ.СМ_АктВыполненныхРабот КАК СМ_АктВыполненныхРабот
	               |ГДЕ
	               |	СМ_АктВыполненныхРабот.Заказчик = &Заказчик
	               |	И СМ_АктВыполненныхРабот.ПериодОт >= &ДатаНачала
	               |	И СМ_АктВыполненныхРабот.ПериодДо <= &ДатаОкончания
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Смета";
	Запрос.УстановитьПараметр("Заказчик",Заказчик);
	Запрос.УстановитьПараметр("ДатаНачала",Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",Период.ДатаОкончания);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Дерево = ДеревоАктов.ПолучитьЭлементы();
	Смета = Неопределено;
	Для Каждого СтрокаЗапроса Из РезультатЗапроса Цикл
		Если Смета <> СтрокаЗапроса.Смета Тогда
			Смета = СтрокаЗапроса.Смета;
			НоваяСтрока = Дерево.Добавить();
			НоваяСтрока.Смета = Смета;
			НоваяСтрока.Использовать = Истина;
		КонецЕсли;
		СтрокаПодчинения = НоваяСтрока.ПолучитьЭлементы().Добавить();
		СтрокаПодчинения.АктВыполненныхРабот = СтрокаЗапроса.АктВыполненныхРабот;
		СтрокаПодчинения.Использовать = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоАктовИспользоватьПриИзменении(Элемент)
	
	Если Элементы.ДеревоАктов.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		ЭлементыДерева = Элементы.ДеревоАктов.ТекущиеДанные.ПолучитьЭлементы();
		Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
			ЭлементДерева.Использовать = Элементы.ДеревоАктов.ТекущиеДанные.Использовать;
		КонецЦикла;
	Иначе
		ИзменитьПризнакРодителя = Истина;
		ЭлементыДерева = Элементы.ДеревоАктов.ТекущиеДанные.ПолучитьРодителя().ПолучитьЭлементы();
		Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
			Если ЭлементДерева.Использовать <> Элементы.ДеревоАктов.ТекущиеДанные.Использовать Тогда
				ИзменитьПризнакРодителя = Ложь;
			КонецЕсли;
		КонецЦикла;
		Если ИзменитьПризнакРодителя Тогда
			Элементы.ДеревоАктов.ТекущиеДанные.ПолучитьРодителя().Использовать = Элементы.ДеревоАктов.ТекущиеДанные.Использовать;	
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ЛокальнаяСметаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка 			= Ложь;
	ОписаниеОЗакрытииФормыВыбораЛС 	= Новый ОписаниеОповещения("ПриЗакрытииФормыПодбораЛС",ЭтаФорма);
	СтруктураПараметров 			= Новый Структура;
	СтруктураПараметров.Вставить("БезПомеченных",Истина);
	СтруктураПараметров.Вставить("МножественныйВыбор",Истина);
	СтруктураПараметров.Вставить("ЗакрыватьПриВыборе",Ложь);
	СтруктураПараметров.Вставить("ЕстьАкты",Истина);
	СтруктураПараметров.Вставить("ОтборСтройка",Истина);
	
	ОткрытьФорму("Обработка.СМ_ДеревоСметПростое.Форма.ФормаУпр",СтруктураПараметров,ЭтаФорма,Новый УникальныйИдентификатор(),,,ОписаниеОЗакрытииФормыВыбораЛС,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыПодбораЛС(ТекЛС,ТекПараметр) Экспорт
	Если ТекЛС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЛокальнаяСмета.Добавить(ТекЛС);
	ПодобратьАктыВыполненныхРаботНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура АктыВыполненныхРаботИспользоватьПриИзменении(Элемент)
		
	Если Элементы.АктыВыполненныхРабот.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		ЭлементыДерева = Элементы.АктыВыполненныхРабот.ТекущиеДанные.ПолучитьЭлементы();
		Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
			ЭлементДерева.Использовать = Элементы.АктыВыполненныхРабот.ТекущиеДанные.Использовать;
		КонецЦикла;
	Иначе
		ИзменитьПризнакРодителя = Истина;
		ЭлементыДерева = Элементы.АктыВыполненныхРабот.ТекущиеДанные.ПолучитьРодителя().ПолучитьЭлементы();
		Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
			Если ЭлементДерева.Использовать <> Элементы.АктыВыполненныхРабот.ТекущиеДанные.Использовать Тогда
				ИзменитьПризнакРодителя = Ложь;
			КонецЕсли;
		КонецЦикла;
		Если ИзменитьПризнакРодителя Тогда
			Элементы.АктыВыполненныхРабот.ТекущиеДанные.ПолучитьРодителя().Использовать = Элементы.АктыВыполненныхРабот.ТекущиеДанные.Использовать;	
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	ЛокальнаяСмета.Добавить(ВыбранноеЗначение);
	ПодобратьАктыВыполненныхРаботНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЛокальнаяСметаОткрытие(Элемент, СтандартнаяОбработка)
	ОписаниеОп = Новый ОписаниеОповещения("ПриЗакрытииСпискаЛС",ЭтаФорма);
	ЛокальнаяСмета.ПоказатьВыборЭлемента(ОписаниеОп,НСтр("ru='Какую смету убрать?'"));
КонецПроцедуры


&НаКлиенте
Процедура ПриЗакрытииСпискаЛС(ТекЛС,ТекПараметр) Экспорт
	Если ТекЛС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЛокальнаяСмета.Удалить(ТекЛС);
	ПодобратьАктыВыполненныхРаботНаСервере();
КонецПроцедуры

#КонецОбласти