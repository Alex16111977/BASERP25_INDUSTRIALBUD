		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    уатПутевойЛист.Ссылка КАК ПутевойЛист,
    НАЧАЛОПЕРИОДА(уатПутевойЛист.ДатаЗакрытия, НЕДЕЛЯ) КАК ПериодНеделя,
    НАЧАЛОПЕРИОДА(уатПутевойЛист.ДатаЗакрытия, ДЕНЬ) КАК ПериодДень,
    НАЧАЛОПЕРИОДА(уатПутевойЛист.ДатаЗакрытия, ДЕКАДА) КАК ПериодДекада,
    НАЧАЛОПЕРИОДА(уатПутевойЛист.ДатаЗакрытия, МЕСЯЦ) КАК ПериодМесяц,
    НАЧАЛОПЕРИОДА(уатПутевойЛист.ДатаЗакрытия, КВАРТАЛ) КАК ПериодКвартал,
    НАЧАЛОПЕРИОДА(уатПутевойЛист.ДатаЗакрытия, ПОЛУГОДИЕ) КАК ПериодПолугодие,
    НАЧАЛОПЕРИОДА(уатПутевойЛист.ДатаЗакрытия, ГОД) КАК ПериодГод,
    уатПутевойЛист.ТранспортноеСредство КАК ТС,
    уатПутевойЛист.ТранспортноеСредство.Код КАК ГосНомер,
    уатПутевойЛист.ТранспортноеСредство.уатГаражныйНомер КАК ГарНомер,
    уатПутевойЛист.Водитель1 КАК Водитель,
    уатПутевойЛист.СпидометрВыезда КАК СпидометрВыезда,
    уатПутевойЛист.СпидометрВозвращения КАК СпидометрВозвращения,
    уатПутевойЛист.ДатаВыезда КАК ДатаВыезда,
    уатПутевойЛист.ДатаВозвращения КАК ДатаВозвращения,
    уатПутевойЛистРасходГСМ.ГСМ КАК ГСМ,
    уатПутевойЛистРасходГСМ.РасходПоНорме КАК РасходПоНорме,
    уатПутевойЛистРасходГСМ.РасходПоФакту КАК РасходПоФакту,
    уатПутевойЛистРасходГСМ.ОстатокПриВыезде КАК ОстатокПриВыезде,
    уатПутевойЛистРасходГСМ.Выдано КАК Выдано,
    уатПутевойЛистРасходГСМ.ОстатокПриВозвращении КАК ОстатокПриВозвращении,
    ВЫБОР
        КОГДА уатПутевойЛистРасходГСМ.Ссылка.РаботаНаДвухВидахТоплива
            ТОГДА уатПутевойЛистРасходГСМ.Пробег
        ИНАЧЕ ВЫБОР
                КОГДА уатПутевойЛистРасходГСМ.ТС.уатМодель.НаличиеСпидометра
                    ТОГДА уатПутевойЛистВыработкаТС.Количество
                ИНАЧЕ уатПутевойЛистВыработкаТС.Количество / 3600
            КОНЕЦ
    КОНЕЦ КАК Пробег,
    ВЫБОР
        КОГДА уатПутевойЛистРасходГСМ.РасходПоНорме &gt; уатПутевойЛистРасходГСМ.РасходПоФакту
            ТОГДА уатПутевойЛистРасходГСМ.РасходПоНорме - уатПутевойЛистРасходГСМ.РасходПоФакту
        ИНАЧЕ 0
    КОНЕЦ КАК Экономия,
    ВЫБОР
        КОГДА уатПутевойЛистРасходГСМ.РасходПоНорме &lt; уатПутевойЛистРасходГСМ.РасходПоФакту
            ТОГДА уатПутевойЛистРасходГСМ.РасходПоФакту - уатПутевойЛистРасходГСМ.РасходПоНорме
        ИНАЧЕ 0
    КОНЕЦ КАК Пережог,
    ВЫБОР
        КОГДА уатПраваИНастройки.Значение = 1
            ТОГДА 1
        ИНАЧЕ ВЫБОР
                КОГДА уатПраваИНастройки.Значение = 2
                    ТОГДА 2
                ИНАЧЕ ВЫБОР
                        КОГДА уатПраваИНастройки.Значение = 3
                            ТОГДА 3
                        ИНАЧЕ 0
                    КОНЕЦ
            КОНЕЦ
    КОНЕЦ КАК Точность,
    ВЫРАЗИТЬ(ЕСТЬNULL(уатМестонахождениеТССрезПоследних.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Справочник.Организации) КАК МестоположениеТС
ИЗ
    Документ.уатПутевойЛист КАК уатПутевойЛист
        ЛЕВОЕ СОЕДИНЕНИЕ Документ.уатПутевойЛист.РасходГСМ КАК уатПутевойЛистРасходГСМ
            ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.уатНоменклатураГСМ КАК уатНоменклатураГСМ
            ПО уатПутевойЛистРасходГСМ.ГСМ = уатНоменклатураГСМ.Номенклатура
                И (уатНоменклатураГСМ.ГруппаГСМ = ЗНАЧЕНИЕ(Перечисление.уатГруппыГСМ.Топливо))
        ПО уатПутевойЛист.Ссылка = уатПутевойЛистРасходГСМ.Ссылка
            И уатПутевойЛист.ТранспортноеСредство = уатПутевойЛистРасходГСМ.ТС
        ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
            уатПутевойЛистВыработкаТС1.Ссылка КАК Ссылка,
            уатПутевойЛистВыработкаТС1.ТС КАК ТС,
            уатПутевойЛистВыработкаТС1.ПараметрВыработки КАК ПараметрВыработки,
            СУММА(уатПутевойЛистВыработкаТС1.Количество) КАК Количество
        ИЗ
            Документ.уатПутевойЛист.ВыработкаТС КАК уатПутевойЛистВыработкаТС1
        ГДЕ
            (уатПутевойЛистВыработкаТС1.ТС.уатМодель.НаличиеСпидометра
                        И уатПутевойЛистВыработкаТС1.ПараметрВыработки = ЗНАЧЕНИЕ(Справочник.уатПараметрыВыработки.ПробегОбщий)
                    ИЛИ НЕ уатПутевойЛистВыработкаТС1.ТС.уатМодель.НаличиеСпидометра
                        И уатПутевойЛистВыработкаТС1.ПараметрВыработки = ЗНАЧЕНИЕ(Справочник.уатПараметрыВыработки.ВремяВРаботе))
        
        СГРУППИРОВАТЬ ПО
            уатПутевойЛистВыработкаТС1.Ссылка,
            уатПутевойЛистВыработкаТС1.ТС,
            уатПутевойЛистВыработкаТС1.ПараметрВыработки) КАК уатПутевойЛистВыработкаТС
        ПО (уатПутевойЛистРасходГСМ.Ссылка = уатПутевойЛистВыработкаТС.Ссылка)
            И (уатПутевойЛистРасходГСМ.ТС = уатПутевойЛистВыработкаТС.ТС)
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уатПраваИНастройки КАК уатПраваИНастройки
        ПО уатПутевойЛист.Организация = уатПраваИНастройки.Объект
            И (уатПраваИНастройки.ПравоНастройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.уатПраваИНастройки.ТочностьОстатковТоплива))
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уатМестонахождениеТС.СрезПоследних КАК уатМестонахождениеТССрезПоследних
        ПО уатПутевойЛист.ТранспортноеСредство = уатМестонахождениеТССрезПоследних.ТС
ГДЕ
    уатПутевойЛистРасходГСМ.Ссылка.Проведен
    И уатПутевойЛистРасходГСМ.Ссылка.Рассчитан
    И уатПутевойЛистРасходГСМ.Активен
    И уатПутевойЛистРасходГСМ.Ссылка.ДатаЗакрытия МЕЖДУ &amp;ДатаНачала И &amp;ДатаКонца
    И (&amp;ОтображатьВыбывшиеТС
            ИЛИ уатПутевойЛистРасходГСМ.ТС.уатДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1))</query>
	</dataSet>
