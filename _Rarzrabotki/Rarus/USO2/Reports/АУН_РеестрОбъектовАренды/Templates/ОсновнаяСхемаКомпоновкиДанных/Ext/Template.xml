;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	АУН_СтатусыОбъектовАрендыСрезПоследних.Услуга КАК Услуга,
	АУН_СтатусыОбъектовАрендыСрезПоследних.ОбъектАренды,
	ВТСтавки.Ставка КАК Ставка,
	АУН_СтатусыОбъектовАрендыСрезПоследних.Договор,
	АУН_СтатусыОбъектовАрендыСрезПоследних.Договор.Контрагент КАК Контрагент,
	АУН_СтатусыОбъектовАрендыСрезПоследних.ДатаОкончанияАренды КАК ДатаОкончанияПоле,
	ВТСтавки.СпособНачисления
ПОМЕСТИТЬ ВТСтатусыОбъектовАренды
ИЗ
	РегистрСведений.АУН_СтатусыОбъектовАренды.СрезПоследних(, НЕ ОбъектАренды = ЗНАЧЕНИЕ(Справочник.АУН_ОбъектыНедвижимости.ПустаяСсылка)) КАК АУН_СтатусыОбъектовАрендыСрезПоследних
		ЛЕВОЕ СОЕДИНЕНИЕ ВТСтавки КАК ВТСтавки
		ПО АУН_СтатусыОбъектовАрендыСрезПоследних.ОбъектАренды = ВТСтавки.ОбъектАренды
			И АУН_СтатусыОбъектовАрендыСрезПоследних.Услуга = ВТСтавки.Услуга
			И АУН_СтатусыОбъектовАрендыСрезПоследних.Договор = ВТСтавки.Договор
ГДЕ
	АУН_СтатусыОбъектовАрендыСрезПоследних.ДатаНачалаАренды &lt;= &amp;ПериодНД
	И (&amp;ПериодНД &lt;= АУН_СтатусыОбъектовАрендыСрезПоследних.ДатаОкончанияАренды
			ИЛИ АУН_СтатусыОбъектовАрендыСрезПоследних.ДатаОкончанияАренды = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
;

