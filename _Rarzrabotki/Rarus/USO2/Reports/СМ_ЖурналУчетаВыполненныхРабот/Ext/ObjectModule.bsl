
#Область СлужебныеПроцедурыИФункции

Перем ТабДок, Макет, ТаблицаПериодов, мВыводитьОстатки, МассивПериодовНаПечать, мВыводитьИтоги, ТаблицаСоответствия;
Перем ИтогИтогоПоСмете, ТабИтогиПоСметам, ТаблицаИтоговОбъекта, ТаблицаИтоговОбъектаФакт,ВыводитьНомераИтогов; 

// Функция формирует табличный документ отчета (используется для печати из форм списков и элементов).
//
// Параметры:
//     Смета - ссылка на один из документов "ЛокальнаяСмета", "ОбъектнаяСмета", "СводнаяСмета".
//     Месяц - строка с представлением периода, если заполнена выводится сводная шапка.
//     ВключатьВОтчет - число (1 = только текущий месяц, 2 = все месяцы с начала работ, где было
//										выполнение, 3 = все месяцы с начала работ).
//     ВыводитьТитульныйЛист - выводить или нет титульный лист.
//     ВыводитьОстатки - выводить или нет колонку с остатками.
//
// Возвращаемое значение:
//     ТабличныйДокумент - результат формирования отчета с заданными параметрами.
//
Процедура ПолучитьЗаполненныйОтчет(Смета,ДокументРезультат, МесяцНачала, МесяцОкончания, ВключатьВОтчет, ВыводитьТитульныйЛист = Ложь, ВыводитьОстатки = Ложь, ВыводитьИтоги = Ложь,УчитыватьКорректировки = Ложь) Экспорт
	
	ВыводитьНомераИтогов= Ложь;
	мВыводитьОстатки 	= ВыводитьОстатки;
	мВыводитьИтоги 		= ВыводитьИтоги;
	КорректировкаУровня = 0;
	ТабДок 				= ДокументРезультат;
	Макет 				= ЭтотОбъект.ПолучитьМакет("Макет");	
	ИтогИтогоПоСмете	= Справочники.СМ_ИтогиПоГлавам.НайтиПоРеквизиту("Идентификатор","ИП2");
	
	// ****************************************************
	ЕстьКорректировки   = Ложь;

	ТаблицаСоответствия = Новый ТаблицаЗначений;
	ТаблицаСоответствия.Колонки.Добавить("ГруппаОС");
	ТаблицаСоответствия.Колонки.Добавить("ОС");
	ТаблицаСоответствия.Колонки.Добавить("СводнаяСмета");
	ТаблицаСоответствия.Колонки.Добавить("ОбъектнаяСмета");
	ТаблицаСоответствия.Колонки.Добавить("ЛокальнаяСмета");
	ТаблицаСоответствия.Колонки.Добавить("ДатаЛС");
	ТаблицаСоответствия.Колонки.Добавить("НомерПП");

	ТаблицаИтоговОбъекта = Новый ТаблицаЗначений;
	ТаблицаИтоговОбъекта.Колонки.Добавить("ГруппаОбъекта");
	ТаблицаИтоговОбъекта.Колонки.Добавить("ОбъектСтроительства");
	ТаблицаИтоговОбъекта.Колонки.Добавить("Итог");
	ТаблицаИтоговОбъекта.Колонки.Добавить("ПорядковыйНомер");
	ТаблицаИтоговОбъекта.Колонки.Добавить("Стоимость");
	ТаблицаИтоговОбъекта.Колонки.Добавить("СортировкаИтогов");
	
	ТаблицаИтоговОбъектаФакт = ТаблицаИтоговОбъекта.Скопировать();
	ТаблицаИтоговОбъектаФакт.Колонки.Добавить("Период");
	
	// Объект строительства, группа объекта строительства
	МассивСметСКД = Новый Массив;
	Если ТипЗнч(Смета) = Тип("СправочникСсылка.СМ_ОбъектыСтроительства") ИЛИ
		 ТипЗнч(Смета) = Тип("СписокЗначений") Тогда
		ВыборкаГруппа = ПолучитьСметыПоОбъекту(Смета);
		Пока ВыборкаГруппа.Следующий() Цикл
			ГруппаОС 		= ВыборкаГруппа.ГруппаОбъекта;
			ВыборкаОбъект 	= ВыборкаГруппа.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"ОбъектСтроительства");
			Пока ВыборкаОбъект.Следующий() Цикл
				ОС 				= ВыборкаОбъект.ОбъектСтроительства;
				ВыборкаСмета 	= ВыборкаОбъект.Выбрать();
				Пока ВыборкаСмета.Следующий() Цикл
					Если ТипЗнч(ВыборкаСмета.Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
						СводнаяСмета = ВыборкаСмета.Смета;
						Для Каждого ТекСтрокаСС Из ВыборкаСмета.Смета.Сметы Цикл
							Если ТипЗнч(ТекСтрокаСС.Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
								ОбъектнаяСмета = ТекСтрокаСС.Смета;
								Для Каждого ТекСтрокаОС Из ТекСтрокаСС.Смета.ЛокальныеСметы Цикл
									ЛокальнаяСмета = ТекСтрокаОС.ЛокальнаяСмета; 
									ТекНомер = Строка(ТекСтрокаСС.НомерПП) + Строка(ТекСтрокаОС.НомерПП);
									ЗаполнитьСтрокуТаблицыСоответствия(ТаблицаСоответствия,ГруппаОС,ОС,СводнаяСмета,ОбъектнаяСмета,ЛокальнаяСмета,ТекНомер);
								КонецЦикла;
							Иначе
								ОбъектнаяСмета = "";
								ЛокальнаяСмета = ТекСтрокаСС.Смета;
								ЗаполнитьСтрокуТаблицыСоответствия(ТаблицаСоответствия,ГруппаОС,ОС,СводнаяСмета,ОбъектнаяСмета,ЛокальнаяСмета,ТекСтрокаСС.НомерПП);
							КонецЕсли;	
						КонецЦикла;
					ИначеЕсли ТипЗнч(ВыборкаСмета.Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
						СводнаяСмета 	= "";
						ОбъектнаяСмета 	= ВыборкаСмета.Смета;
						Для Каждого ТекСтрокаОС Из ВыборкаСмета.Смета.ЛокальныеСметы Цикл
							ЛокальнаяСмета  = ТекСтрокаОС.ЛокальнаяСмета; 
							ЗаполнитьСтрокуТаблицыСоответствия(ТаблицаСоответствия,ГруппаОС,ОС,СводнаяСмета,ОбъектнаяСмета,ЛокальнаяСмета,ТекСтрокаОС.НомерПП);
						КонецЦикла;
					Иначе
						СводнаяСмета 	= "";
						ОбъектнаяСмета 	= "";
						ЛокальнаяСмета 	= ВыборкаСмета.Смета;
						ЗаполнитьСтрокуТаблицыСоответствия(ТаблицаСоответствия,ГруппаОС,ОС,СводнаяСмета,ОбъектнаяСмета,ЛокальнаяСмета,ВыборкаСмета.Смета.ПорНомер);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
	// ЛС, ОС или СС	
	Иначе
		ГруппаОС = "";
		ОС       = "";
		Если ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
			СводнаяСмета = Смета;
			Для Каждого ТекСтрокаСС Из Смета.Сметы Цикл
				Если ТипЗнч(ТекСтрокаСС.Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
					ОбъектнаяСмета = ТекСтрокаСС.Смета;
					Для Каждого ТекСтрокаОС Из ТекСтрокаСС.Смета.ЛокальныеСметы Цикл
						ЛокальнаяСмета  = ТекСтрокаОС.ЛокальнаяСмета; 
						ЗаполнитьСтрокуТаблицыСоответствия(ТаблицаСоответствия,ГруппаОС,ОС,СводнаяСмета,ОбъектнаяСмета,ЛокальнаяСмета,ТекСтрокаОС.НомерПП);
					КонецЦикла;
				Иначе
					ОбъектнаяСмета 	= "";
					ЛокальнаяСмета 	= ТекСтрокаСС.Смета;
					ЗаполнитьСтрокуТаблицыСоответствия(ТаблицаСоответствия,ГруппаОС,ОС,СводнаяСмета,ОбъектнаяСмета,ЛокальнаяСмета,ТекСтрокаСС.НомерПП);
				КонецЕсли;	
			КонецЦикла;
		ИначеЕсли ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
			СводнаяСмета 	= "";
			ОбъектнаяСмета 	= Смета;
			Для Каждого ТекСтрокаОС Из Смета.ЛокальныеСметы Цикл
				ЛокальнаяСмета  = ТекСтрокаОС.ЛокальнаяСмета; 
				ЗаполнитьСтрокуТаблицыСоответствия(ТаблицаСоответствия,ГруппаОС,ОС,СводнаяСмета,ОбъектнаяСмета,ЛокальнаяСмета,ТекСтрокаОС.НомерПП);
			КонецЦикла;
		Иначе
			СводнаяСмета 	= "";
			ОбъектнаяСмета 	= "";
			ЛокальнаяСмета 	= Смета;
			ЗаполнитьСтрокуТаблицыСоответствия(ТаблицаСоответствия,ГруппаОС,ОС,СводнаяСмета,ОбъектнаяСмета,ЛокальнаяСмета,1);
			ЕстьКорректировки = (СМ_СметныйСоставВызовСервера.ЕстьКорректировкиСметы(Смета) И УчитыватьКорректировки); 
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаОС = ТаблицаСоответствия.Скопировать();
	ТаблицаСС = ТаблицаСоответствия.Скопировать();
	ТаблицаЛС = ТаблицаСоответствия.Скопировать();
	
	ТаблицаСС.Свернуть("СводнаяСмета");
	ТаблицаОС.Свернуть("ОбъектнаяСмета");
	ТаблицаЛС.Свернуть("ЛокальнаяСмета");
	
	МассивСС = ТаблицаСС.ВыгрузитьКолонку("СводнаяСмета");
	МассивОС = ТаблицаОС.ВыгрузитьКолонку("ОбъектнаяСмета");
	МассивЛС = ТаблицаЛС.ВыгрузитьКолонку("ЛокальнаяСмета");

    ТабИтогиПоСметам = СобратьИтогиПоСметам(МассивОС,МассивСС);
	
	СписокСмет = Новый СписокЗначений;
	Если ЕстьКорректировки Тогда
		// Пока не ясно как его применить..
		// ДеревоКорректировок = СМ_СметныйСоставВызовСервера.ПолучитьДеревоКорректировок(Смета,СписокСмет);
		Если ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
			ТаблицаКорректировок = Неопределено;
			Для Каждого эл Из МассивЛС Цикл
				ТаблицаКорректировок = СМ_СметныйСоставВызовСервера.ПолучитьТаблицуКорректировок(эл,СписокСмет,ТаблицаКорректировок);
			КонецЦикла;
		Иначе
			ТаблицаКорректировок = СМ_СметныйСоставВызовСервера.ПолучитьТаблицуКорректировок(Смета,СписокСмет);
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьКорректировки Тогда
		СхемаКомпоновкиДанных 	= ЭтотОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанныхКорректировки");
		Настройки 				= ЭтотОбъект.КомпоновщикНастроек.Настройки; // СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ЛокальнаяСмета",СписокСмет);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Затраты",ЭтотОбъект.ВыводитьТрудозатраты);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Материалы",ЭтотОбъект.ВыводитьМатериалы);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Машины",ЭтотОбъект.ВыводитьМашины);
		
		КомпоновщикМакета 		= Новый КомпоновщикМакетаКомпоновкиДанных;
		ДанныеРасшифровки 		= "";
		МакетКомпоновки 		= КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных,Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	Иначе
		СхемаКомпоновкиДанных 	= ЭтотОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
		Настройки 				= ЭтотОбъект.КомпоновщикНастроек.Настройки; // СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
		
		ФильтрСмета = Новый СписокЗначений;
		ФильтрСмета.ЗагрузитьЗначения(МассивЛС);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ЛокальнаяСмета",ФильтрСмета);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Затраты",ЭтотОбъект.ВыводитьТрудозатраты);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Материалы",ЭтотОбъект.ВыводитьМатериалы);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Машины",ЭтотОбъект.ВыводитьМашины);
		
		КомпоновщикМакета 	= Новый КомпоновщикМакетаКомпоновкиДанных;
		ДанныеРасшифровки 	= "";
		МакетКомпоновки 	= КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных,Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	КонецЕсли;

    ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,,);
    
    ТабДок.ОтображатьСетку = Ложь;
	
	ДеревоЗначений 	= Новый ДеревоЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ДеревоЗначений);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	// ***********************************************************
	// ++ AVV
	ТабНумерацииРазделов = ПолучитьНомераРазделов(МассивЛС);
	// Заполнение номеров разделов во всех строках дерева
	ЗаполнитьНомераРазделов(ДеревоЗначений,ТабНумерацииРазделов);	
	// -- AVV
	// ***********************************************************
	
	// *********************************************
	// ОПРЕДЕЛЕНИЕ ПЕРИОДОВ ДЛЯ ВЫВОДА В ОТЧЕТ
	ДеревоДат = Новый ТаблицаЗначений;
	ДеревоДат.Колонки.Добавить("Дата");
	Для Каждого СтрДерева Из ДеревоЗначений.Строки Цикл
		Если Не ЗначениеЗаполнено(СтрДерева.ЛокальнаяСмета) Тогда
			ИндексСтрокиДанных = ДеревоЗначений.Строки.Индекс(СтрДерева)+1;
			Прервать;
		КонецЕсли;
		Для Каждого СтрДат Из СтрДерева.Строки Цикл
			Стр 		= ДеревоДат.Добавить();
			Стр.Дата 	= СтрДат.Дата; 
		КонецЦикла;
	КонецЦикла;
	ДеревоДат.Свернуть("Дата");
	ДеревоДат.Сортировать("Дата Убыв");
	
	// ****************************************************
	// Заполнение таблицы периодов

	ОписаниеТиповЧ 	= Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла());
	ТаблицаПериодов = Новый ТаблицаЗначений;
	ТаблицаПериодов.Колонки.Добавить("Дата");
	ТаблицаПериодов.Колонки.Добавить("Месяц");
	ТаблицаПериодов.Колонки.Добавить("ФактОбъем",ОписаниеТиповЧ);
	ТаблицаПериодов.Колонки.Добавить("Стоимость",ОписаниеТиповЧ);
	
	// Текущий месяц
	Если ВключатьВОтчет = 1 Тогда
		НоваяСтрока 		= ТаблицаПериодов.Добавить();
		НоваяСтрока.Дата 	= НачалоМесяца(ТекущаяДата());
	// Все месяцы где было выполнение 	
	ИначеЕсли ВключатьВОтчет = 2 Тогда
		ТабФактаПериоды = ПолучитьФактПоСметам(МассивЛС);	
		ТабФактаПериоды.Свернуть("МесяцАкта");
		ТабФактаПериоды.Сортировать("МесяцАкта");
		Для Каждого ТекСтрокаПериоды Из ТабФактаПериоды Цикл
			НоваяСтрока 		= ТаблицаПериодов.Добавить();
			НоваяСтрока.Дата 	= ТекСтрокаПериоды.МесяцАкта;
		КонецЦикла;
	// Все месяцы с даты первой ЛС по дату последнего акта
	ИначеЕсли ВключатьВОтчет = 3 Тогда
		
		// Определение даты первой сметы
		Если ТаблицаСоответствия.Количество() > 0 Тогда
			ТаблицаСоответствия.Сортировать("ДатаЛС");
			ТекМесяцНачала 	= НачалоМесяца(ТаблицаСоответствия[0].ДатаЛС);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не найдено данных для вывода в отчет!'"));
			Возврат;
		КонецЕсли;
		
		// Определение даты последнего акта
		ТабФактаПериоды = ПолучитьФактПоСметам(МассивЛС);	
		Если ТабФактаПериоды.Количество()> 0 Тогда
			ТабФактаПериоды.Свернуть("МесяцАкта");
			ТабФактаПериоды.Сортировать("МесяцАкта Убыв");
			ПоследняяДата = ТабФактаПериоды[0].МесяцАкта; 
		Иначе
			ПоследняяДата = ТекМесяцНачала;	
		КонецЕсли;
		
		Пока ТекМесяцНачала <= ПоследняяДата Цикл
			НоваяСтрока 		= ТаблицаПериодов.Добавить();
			НоваяСтрока.Дата 	= ТекМесяцНачала;
			ТекМесяцНачала 		= НачалоМесяца(ДобавитьМесяц(ТекМесяцНачала,1));
		КонецЦикла;
		
	// Все месяцы из заданного периода	
	ИначеЕсли ВключатьВОтчет = 4 Тогда
		ТекМесяцНачала 		= МесяцНачала;
		ТекМесяцОкончания 	= МесяцОкончания;
		Пока ТекМесяцНачала <= ТекМесяцОкончания Цикл
			НоваяСтрока 		= ТаблицаПериодов.Добавить();
			НоваяСтрока.Дата 	= ТекМесяцНачала;
			ТекМесяцНачала 		= НачалоМесяца(ДобавитьМесяц(ТекМесяцНачала,1));
		КонецЦикла;
	КонецЕсли;
	ТаблицаПериодов.Сортировать("Дата");
	МассивПериодовНаПечать = ТаблицаПериодов.ВыгрузитьКолонку("Дата");	

	// ****************************************************
	// ВЫВОД ТИТУЛЬНОГО ЛИСТА
	Если ВыводитьТитульныйЛист Тогда
		Область 					= Макет.ПолучитьОбласть("ТитульныйЛист"); 
		Область.Параметры.Заказчик 	= Смета.Заказчик.Наименование;
		Область.Параметры.Подрядчик = Смета.Подрядчик;
		Область.Параметры.Объект 	= Смета.Стройка;
		Если МассивПериодовНаПечать.Количество()=1 Тогда
			Область.Параметры.Период = Формат(МассивПериодовНаПечать[0],"ДФ=""ММММ гггг 'г.'""");
		ИначеЕсли МассивПериодовНаПечать.Количество()>1 Тогда
			НачалоПериода 	= Формат(МассивПериодовНаПечать[0],"ДФ=""ММММ гггг 'г.'""");
			КонецПериода 	= Формат(МассивПериодовНаПечать[МассивПериодовНаПечать.ВГраница()],"ДФ=""ММММ гггг 'г.'""");
			Область.Параметры.Период = НачалоПериода + " - " + КонецПериода;
		КонецЕсли;
		ИП4 		= Справочники.СМ_ИтогиПоГлавам.НайтиПоРеквизиту("Идентификатор","ИП4");
		Запрос 		= Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	СУММА(СМ_ИтогиПоГлавам.ТекПрямЗатраты + СМ_ИтогиПоГлавам.ТекОборуд) КАК Сумма
		|ИЗ
		|	РегистрСведений.СМ_ИтогиПоГлавам КАК СМ_ИтогиПоГлавам
		|ГДЕ
		|	СМ_ИтогиПоГлавам.Смета в (&Смета)
		|	И СМ_ИтогиПоГлавам.Итог = &Итог";
		
		Если ЕстьКорректировки Тогда
			Запрос.УстановитьПараметр("Смета",СписокСмет);
		Иначе
			Запрос.УстановитьПараметр("Смета",ФильтрСмета);
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Итог",ИП4);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Область.Параметры.Сумма = Выборка.Сумма;
		КонецЕсли;
		ТабДок.Вывести(Область);
		ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	// ****************************************************
	// ВЫВОД ШАПКИ ТАБЛИЦЫ
	ШапкаТаблицы = Новый ТабличныйДокумент;
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка|Основная");
	ШапкаТаблицы.Вывести(ОбластьШапка);
	ТекущийГод = Неопределено;
	НомерКолонки = 9;
	Для Каждого СтрокаПериода Из ТаблицаПериодов Цикл
		Если ТекущийГод = Неопределено Тогда
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
			БылоВыполнениеВГоду = Ложь;
		ИначеЕсли ТекущийГод <> НачалоГода(СтрокаПериода.Дата) Тогда
			Если БылоВыполнениеВГоду Тогда
				Область = Макет.ПолучитьОбласть("Шапка|Год");
				Область.Параметры.Дата = "за "+Формат(ТекущийГод,"ДФ=гггг")+" год";
				Область.Параметры.НомерСтрокиКоличество = НомерКолонки;
				Область.Параметры.НомерСтрокиСтоимость = НомерКолонки + 1;
				НомерКолонки = НомерКолонки + 2;
				ШапкаТаблицы.Присоединить(Область);
				БылоВыполнениеВГоду = Ложь;
			КонецЕсли;
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
		КонецЕсли;
		ВыводитьВОтчет = МассивПериодовНаПечать.Найти(СтрокаПериода.Дата) <> Неопределено;
		Если ВыводитьВОтчет Тогда
			БылоВыполнениеВГоду = Истина;
			Область = Макет.ПолучитьОбласть("Шапка|Месяц");
			ЗаполнитьЗначенияСвойств(Область.Параметры,СтрокаПериода);
			Область.Параметры.НомерСтрокиКоличество = НомерКолонки;
			Область.Параметры.НомерСтрокиСтоимость = НомерКолонки+1;
			Область.Параметры.НомерСтрокиСтоимостьСНачала = НомерКолонки + 2;
			НомерКолонки = НомерКолонки + 3;
			ШапкаТаблицы.Присоединить(Область);
		КонецЕсли;
	КонецЦикла;
	Область = Макет.ПолучитьОбласть("Шапка|Год");
	Область.Параметры.Дата = "за "+Формат(ТекущийГод,"ДФ=гггг")+" год";
	Область.Параметры.НомерСтрокиКоличество = НомерКолонки;
	Область.Параметры.НомерСтрокиСтоимость = НомерКолонки + 1;
	НомерКолонки = НомерКолонки + 2;
	ШапкаТаблицы.Присоединить(Область);
	Если мВыводитьОстатки Тогда
		Область = Макет.ПолучитьОбласть("Шапка|Остатки");
		Область.Параметры.НомерСтрокиКоличество = НомерКолонки;
		Область.Параметры.НомерСтрокиСтоимость = НомерКолонки + 1;
		НомерКолонки = НомерКолонки + 2;
		ШапкаТаблицы.Присоединить(Область);
	КонецЕсли;
	ТабДок.Вывести(ШапкаТаблицы);
	
	// ****************************************************
	// Объект строительства, группа объекта строительства
	ТабДок.НачатьАвтогруппировкуСтрок();
	Если ТипЗнч(Смета) = Тип("СправочникСсылка.СМ_ОбъектыСтроительства") ИЛИ
		 ТипЗнч(Смета) = Тип("СписокЗначений") Тогда
		УровеньГруппировки = 0; 
		ВыборкаГруппа = ПолучитьСметыПоОбъекту(Смета);
		Пока ВыборкаГруппа.Следующий() Цикл
			УровеньГруппировки = 1;
			
			Если ЗначениеЗаполнено(ВыборкаГруппа.ГруппаОбъекта) Тогда
				ВывестиСтрокуГруппыОбъектаСтроительства(ВыборкаГруппа.ГруппаОбъекта,УровеньГруппировки);
			КонецЕсли;
			
			ВыборкаОбъект = ВыборкаГруппа.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"ОбъектСтроительства");
			Пока ВыборкаОбъект.Следующий() Цикл
				УровеньГруппировки = 2;
				ВывестиСтрокуОбъектаСтроительства(ВыборкаОбъект.ОбъектСтроительства,УровеньГруппировки);
				ВыборкаСмета = ВыборкаОбъект.Выбрать();
				Пока ВыборкаСмета.Следующий() Цикл
					УровеньГруппировки 	= 3;
					Если ТипЗнч(ВыборкаСмета.Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
						ВывестиСтрокуСводнойСметы(ВыборкаСмета.Смета,ДеревоЗначений,ИндексСтрокиДанных,УровеньГруппировки);
					ИначеЕсли ТипЗнч(ВыборкаСмета.Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
						ВывестиСтрокуОбъектнойСметы(ВыборкаСмета.Смета,ДеревоЗначений,ИндексСтрокиДанных,УровеньГруппировки);
					Иначе
						ВывестиСтрокуЛокальнойСметы(ВыборкаСмета.Смета,ДеревоЗначений,ИндексСтрокиДанных,УровеньГруппировки);
					КонецЕсли;
				КонецЦикла;
				
				Если мВыводитьИтоги Тогда
					ВывестиИтогиПоОбъекту(ВыборкаОбъект.ОбъектСтроительства,УровеньГруппировки);
				КонецЕсли;
				
			КонецЦикла;
			
			Если мВыводитьИтоги Тогда
				ВывестиИтогиПоОбъекту(ВыборкаГруппа.ГруппаОбъекта,2);
			КонецЕсли;
			
		КонецЦикла;
		
	// ЛС, ОС или СС	
	Иначе
		
		УровеньГруппировки = 0;		
		Если ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
			ВывестиСтрокуСводнойСметы(Смета,ДеревоЗначений,ИндексСтрокиДанных,УровеньГруппировки);
		ИначеЕсли ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
			ВывестиСтрокуОбъектнойСметы(Смета,ДеревоЗначений,ИндексСтрокиДанных,УровеньГруппировки);
		Иначе
			ВывестиСтрокуЛокальнойСметы(Смета,ДеревоЗначений,ИндексСтрокиДанных,УровеньГруппировки);
		КонецЕсли;
		
	КонецЕсли;
	
	ТабДок.ЗакончитьАвтогруппировкуСтрок();
	ТабДок.НижнийКолонтитул.Выводить 		= Истина;
	ТабДок.НижнийКолонтитул.Шрифт 			= Новый Шрифт(ТабДок.НижнийКолонтитул.Шрифт,,,,Истина);
	ТабДок.НижнийКолонтитул.ТекстВЦентре 	= НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");

	Если ВыводитьТитульныйЛист Тогда
		ТабДок.ПовторятьПриПечатиСтроки = ТабДок.Область(42,,42);
	Иначе
		ТабДок.ПовторятьПриПечатиСтроки = ТабДок.Область(3,,3);
	КонецЕсли;

	ТабДок.АвтоМасштаб 					= Истина;
	ТабДок.СохранятьСвойстваОтображения = Истина;
	ТабДок.ОтображатьСетку 				= Истина;
	ТабДок.ОриентацияСтраницы 			= ОриентацияСтраницы.Ландшафт;

КонецПроцедуры

Процедура ВывестиДеревоВДокумент(СтрокиДерева,НомерПоПорядку,ТаблицаКорректировок = Неопределено, ВсеСтрокиДерева = Неопределено,ИндексСтрокиДанных = Неопределено,ВывелиНовыеРазделы = Ложь,ВывелиНовыеПозиции = Ложь,КорректировкаУровня = 0)
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		Если СтрокаДерева.НаименованиеПозиции <> Неопределено Тогда
			ВывестиПозициюРаздела(СтрокаДерева,НомерПоПорядку,ТаблицаКорректировок,ВсеСтрокиДерева,КорректировкаУровня);
		ИначеЕсли СтрокаДерева.Итог <> Неопределено Тогда
			Если мВыводитьИтоги Тогда
				Если Не ТаблицаКорректировок = Неопределено И Не ВывелиНовыеПозиции Тогда
					МассвиКоррекций = ТаблицаКорректировок.НайтиСтроки(Новый Структура("ПрототипРаздел,Новый,Смета",СтрокаДерева.Раздел,Истина,СтрокаДерева.ЛокальнаяСмета));
					Для Каждого СтрРаздел Из МассвиКоррекций Цикл
						СтрокаДанных = ВсеСтрокиДерева.Найти(СтрРаздел.Коррекция, "Позиция", Истина);
						ВывестиПозициюРаздела(СтрокаДанных,НомерПоПорядку,ТаблицаКорректировок,ВсеСтрокиДерева,КорректировкаУровня);
					КонецЦикла;
				КонецЕсли;
				ВывелиНовыеПозиции = Истина;
				ВывестиИтогРаздела(СтрокаДерева,ТаблицаКорректировок,ВсеСтрокиДерева,КорректировкаУровня);
			Иначе
				Если Не ТаблицаКорректировок = Неопределено И Не ВывелиНовыеПозиции Тогда
					МассвиКоррекций = ТаблицаКорректировок.НайтиСтроки(Новый Структура("ПрототипРаздел,Новый,Смета",СтрокаДерева.Раздел,Истина,СтрокаДерева.ЛокальнаяСмета));
					Для Каждого СтрРаздел Из МассвиКоррекций Цикл
						СтрокаДанных = ВсеСтрокиДерева.Найти(СтрРаздел.Коррекция, "Позиция", Истина);
						ВывестиПозициюРаздела(СтрокаДанных,НомерПоПорядку,ТаблицаКорректировок,ВсеСтрокиДерева,КорректировкаУровня);
					КонецЦикла;
				КонецЕсли;
				ВывелиНовыеПозиции = Истина;
			КонецЕсли;
		ИначеЕсли СтрокаДерева.СметаИтог <> Неопределено Тогда
			Если мВыводитьИтоги Тогда
				Если Не ТаблицаКорректировок = Неопределено И Не ВывелиНовыеРазделы Тогда
					МассвиКоррекций = ТаблицаКорректировок.НайтиСтроки(Новый Структура("НовыйРаздел,Смета",Истина,СтрокаДерева.ЛокальнаяСмета));
					Для Каждого СтрРаздел Из МассвиКоррекций Цикл
						СтрокаДанных = ВсеСтрокиДерева.Найти(СтрРаздел.Коррекция, "Раздел", Истина);
						Если СтрокаДанных.Родитель = Неопределено ИЛИ СтрокаДанных.Родитель.Раздел<> СтрокаДанных.Раздел Тогда
							ВывестиРаздел(СтрокаДанных,ТаблицаКорректировок,ВсеСтрокиДерева,КорректировкаУровня);
						КонецЕсли;
						ВывестиДеревоВДокумент(СтрокаДанных.Строки,НомерПоПорядку,ТаблицаКорректировок,ВсеСтрокиДерева,ИндексСтрокиДанных,,,КорректировкаУровня);
					КонецЦикла;
					ВывелиНовыеРазделы = Истина;
				КонецЕсли;
				ВывестиИтогПоСмете(СтрокаДерева,ИндексСтрокиДанных,ТаблицаКорректировок,ВсеСтрокиДерева,КорректировкаУровня);
			Иначе
				Если Не ТаблицаКорректировок = Неопределено И Не ВывелиНовыеРазделы Тогда
					МассвиКоррекций = ТаблицаКорректировок.НайтиСтроки(Новый Структура("НовыйРаздел,Смета",Истина,СтрокаДерева.ЛокальнаяСмета));
					Для Каждого СтрРаздел Из МассвиКоррекций Цикл
						СтрокаДанных = ВсеСтрокиДерева.Найти(СтрРаздел.Коррекция, "Раздел", Истина);
						Если СтрокаДанных.Родитель = Неопределено ИЛИ СтрокаДанных.Родитель.Раздел<> СтрокаДанных.Раздел Тогда
							ВывестиРаздел(СтрокаДанных,ТаблицаКорректировок,ВсеСтрокиДерева,КорректировкаУровня);
						КонецЕсли;
						ВывестиДеревоВДокумент(СтрокаДанных.Строки,НомерПоПорядку,ТаблицаКорректировок,ВсеСтрокиДерева,ИндексСтрокиДанных,,,КорректировкаУровня);
					КонецЦикла;
					ВывелиНовыеРазделы = Истина;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли СтрокаДерева.Раздел <> Неопределено Тогда
			Если СтрокаДерева.Родитель = Неопределено ИЛИ СтрокаДерева.Родитель.Раздел<> СтрокаДерева.Раздел Тогда
				ВывестиРаздел(СтрокаДерева,ТаблицаКорректировок,ВсеСтрокиДерева,КорректировкаУровня);
			КонецЕсли;
			ВывестиДеревоВДокумент(СтрокаДерева.Строки,НомерПоПорядку,ТаблицаКорректировок,ВсеСтрокиДерева,ИндексСтрокиДанных,ВывелиНовыеРазделы,ВывелиНовыеПозиции,КорректировкаУровня);	
		КонецЕсли;
		
	КонецЦикла;
			
КонецПроцедуры
	
Процедура ВывестиРаздел(СтрокаРаздела,ТаблицаКорректировок = Неопределено, ВсеСтрокиДерева = Неопределено,КорректировкаУровня)
	
	ОбластьРаздел 					= Макет.ПолучитьОбласть("Раздел|Основная");
	ОбластьРаздел.Параметры.Раздел 	= СтрокаРаздела.Раздел;
	Если ТипЗнч(СтрокаРаздела.Раздел) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		ОбластьРаздел.Параметры.НаименованиеДляПечати = СтрокаРаздела.Раздел.Наименование;
	Иначе
		ОбластьРаздел.Параметры.НаименованиеДляПечати 	= СтрокаРаздела.Раздел.НаименованиеДляПечати;
		//ОбластьРаздел.Параметры.ПорНомерРаздела 		= СтрокаРаздела.ПорНомерРаздела;
	КонецЕсли;
		
	ТекУровеньРаздела = СтрокаРаздела.Уровень() + КорректировкаУровня;
	ТабДок.Вывести(ОбластьРаздел,СтрокаРаздела.Уровень() + КорректировкаУровня);
	
	ТаблицаПериодовПозиции = ТаблицаПериодов.Скопировать();
	ВыводитьГод = Ложь;
	ТекущийГод = Неопределено;
	Для Каждого СтрокаПериода Из ТаблицаПериодовПозиции Цикл
		Если ТекущийГод = Неопределено Тогда
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
			ВыводитьГод = Ложь;
		ИначеЕсли ТекущийГод <> НачалоГода(СтрокаПериода.Дата) Тогда
			Если ВыводитьГод Тогда
				Область = Макет.ПолучитьОбласть("Раздел|Год");
				ТабДок.Присоединить(Область);
				ВыводитьГод = Ложь;
			КонецЕсли;
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
		КонецЕсли;
		ВыводитьВОтчет = МассивПериодовНаПечать.Найти(СтрокаПериода.Дата) <> Неопределено;
		Если ВыводитьВОтчет Тогда
			Область = Макет.ПолучитьОбласть("Раздел|Месяц");
			ТабДок.Присоединить(Область);
			ВыводитьГод = Истина;
		КонецЕсли;
	КонецЦикла;
	Область = Макет.ПолучитьОбласть("Раздел|Год");
	ТабДок.Присоединить(Область);
	Если мВыводитьОстатки Тогда
		Область = Макет.ПолучитьОбласть("Раздел|Остатки");
		ТабДок.Присоединить(Область);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиСмету(ТекСмета,ТипСметы,КорректировкаУровня)
	
	ОбластьСметы 									= Макет.ПолучитьОбласть("Смета|Основная");
	ОбластьСметы.Параметры.НаименованиеДляПечати	= ТекСмета.Наименование;
	ОбластьСметы.Параметры.ТипСметы					= ТипСметы;
	ОбластьСметы.Параметры.Смета					= ТекСмета;

	ТабДок.Вывести(ОбластьСметы,КорректировкаУровня);
	
	ТаблицаПериодовСметы 	= ТаблицаПериодов.Скопировать();
	ВыводитьГод 			= Ложь;
	ТекущийГод 				= Неопределено;
	Для Каждого СтрокаПериода Из ТаблицаПериодовСметы Цикл
		Если ТекущийГод = Неопределено Тогда
			ТекущийГод 	= НачалоГода(СтрокаПериода.Дата);
			ВыводитьГод = Ложь;
		ИначеЕсли ТекущийГод <> НачалоГода(СтрокаПериода.Дата) Тогда
			Если ВыводитьГод Тогда
				Область = Макет.ПолучитьОбласть("Смета|Год");
				ТабДок.Присоединить(Область);
				ВыводитьГод = Ложь;
			КонецЕсли;
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
		КонецЕсли;
		ВыводитьВОтчет = МассивПериодовНаПечать.Найти(СтрокаПериода.Дата) <> Неопределено;
		Если ВыводитьВОтчет Тогда
			Область = Макет.ПолучитьОбласть("Смета|Месяц");
			ТабДок.Присоединить(Область);
			ВыводитьГод = Истина;
		КонецЕсли;
	КонецЦикла;
	Область = Макет.ПолучитьОбласть("Смета|Год");
	ТабДок.Присоединить(Область);
	Если мВыводитьОстатки Тогда
		Область = Макет.ПолучитьОбласть("Смета|Остатки");
		ТабДок.Присоединить(Область);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиПозициюРаздела(СтрокаПозиции,НомерПоПорядку,ТаблицаКорректировок = Неопределено, ВсеСтрокиДерева = Неопределено, КорректировкаУровня = 0)
	
	Если Не ТаблицаКорректировок = Неопределено Тогда
		МассвиКоррекций = ТаблицаКорректировок.НайтиСтроки(Новый Структура("Прототип",СтрокаПозиции.Позиция));
	КонецЕсли;
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка|Основная");
	
	Если Не ТаблицаКорректировок = Неопределено И МассвиКоррекций.Количество() > 0 Тогда
		СметнаяСтоимость 	= 0;
		ОбъемРабот 			= 0;
		Для Каждого Кор Из МассвиКоррекций Цикл
			СтрокаДанных = ВсеСтрокиДерева.Найти(Кор.Коррекция, "Позиция", Истина);
			Если Не СтрокаДанных = Неопределено Тогда
				СметнаяСтоимость 	= СметнаяСтоимость + СтрокаДанных.СметнаяСтоимость;
				ОбъемРабот 			= ОбъемРабот + СтрокаДанных.ОбъемРабот;
			КонецЕсли;
		КонецЦикла;
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры,СтрокаПозиции);
		ОбластьСтрока.Параметры.ОбъемРабот 			= СтрокаПозиции.ОбъемРабот + ОбъемРабот;
		ОбластьСтрока.Параметры.СметнаяСтоимость 	= СтрокаПозиции.СметнаяСтоимость + СметнаяСтоимость;
		ОбластьСтрока.Параметры.Цена 				= ?(ОбластьСтрока.Параметры.ОбъемРабот=0,СтрокаПозиции.Цена,ОбластьСтрока.Параметры.СметнаяСтоимость/ОбластьСтрока.Параметры.ОбъемРабот);
	Иначе
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры,СтрокаПозиции);
		ОбластьСтрока.Параметры.НомерПозиции = СтрокаПозиции.ПорНомерПозиции;
	КонецЕсли;
	ОбластьСтрока.Параметры.НомерПоПорядку = НомерПоПорядку;
	НомерПоПорядку = НомерПоПорядку + 1;
	
	ТабДок.Вывести(ОбластьСтрока,СтрокаПозиции.Уровень() + КорректировкаУровня);
	
	ТаблицаПериодовПозиции = ТаблицаПериодов.Скопировать();
	Для Каждого СтрокаПериода Из СтрокаПозиции.Строки Цикл
		СтрокаТаблицыПериодов = ТаблицаПериодовПозиции.Найти(СтрокаПериода.Дата,"Дата");
		Если СтрокаТаблицыПериодов <> Неопределено Тогда
			
			Если Не ТаблицаКорректировок = Неопределено И МассвиКоррекций.Количество()>0 Тогда
				СтрокаТаблицыПериодов.ФактОбъем = СтрокаПериода.ФактОбъем;
				СтрокаТаблицыПериодов.Стоимость = СтрокаПериода.Стоимость;
				
				Для Каждого Кор Из МассвиКоррекций Цикл
					СтрокаДанных = ВсеСтрокиДерева.Найти(Кор.Коррекция, "Позиция", Истина);
					Если Не СтрокаДанных = Неопределено Тогда
						Для Каждого СтрокаДанныхПериода Из СтрокаДанных.Строки Цикл
							СтрокаТаблицыДанныхПериодов = ТаблицаПериодовПозиции.Найти(СтрокаДанныхПериода.Дата,"Дата");
							Если СтрокаТаблицыДанныхПериодов <> Неопределено Тогда
								СтрокаТаблицыДанныхПериодов.ФактОбъем = СтрокаТаблицыДанныхПериодов.ФактОбъем+СтрокаДанныхПериода.ФактОбъем;
								СтрокаТаблицыДанныхПериодов.Стоимость = СтрокаТаблицыДанныхПериодов.Стоимость+СтрокаДанныхПериода.Стоимость;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;

			Иначе
				СтрокаТаблицыПериодов.ФактОбъем = СтрокаПериода.ФактОбъем;
				СтрокаТаблицыПериодов.Стоимость = СтрокаПериода.Стоимость;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	СтоимостьСНачала 	= 0;
	КоличествоСНачала 	= 0;
	ВыводитьГод = Ложь;
	ТекущийГод = Неопределено;
	Для Каждого СтрокаПериода Из ТаблицаПериодовПозиции Цикл
		Если ТекущийГод = Неопределено Тогда
			СтоимостьЗаГод = 0;
			КоличествоЗаГод = 0;
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
			ВыводитьГод = Ложь;
		ИначеЕсли ТекущийГод <> НачалоГода(СтрокаПериода.Дата) Тогда
			Если ВыводитьГод Тогда
				Область = Макет.ПолучитьОбласть("Строка|Год");
				Область.Параметры.КоличествоЗаГод = КоличествоЗаГод;
				Область.Параметры.СтоимостьЗаГод = СтоимостьЗаГод;
				ТабДок.Присоединить(Область);
				ВыводитьГод = Ложь;
			КонецЕсли;
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
			СтоимостьЗаГод = 0;
			КоличествоЗаГод = 0;
		КонецЕсли;
		СтоимостьСНачала = СтоимостьСНачала + СтрокаПериода.Стоимость;
		КоличествоСНачала = КоличествоСНачала + СтрокаПериода.ФактОбъем;
		СтоимостьЗаГод = СтоимостьЗаГод + СтрокаПериода.Стоимость;
		КоличествоЗаГод = КоличествоЗаГод + СтрокаПериода.ФактОбъем;
		ВыводитьВОтчет = МассивПериодовНаПечать.Найти(СтрокаПериода.Дата) <> Неопределено;
		Если ВыводитьВОтчет Тогда
			Область = Макет.ПолучитьОбласть("Строка|Месяц");
			ЗаполнитьЗначенияСвойств(Область.Параметры,СтрокаПериода);
			Область.Параметры.СтоимостьСНачала = СтоимостьСНачала;
			ТабДок.Присоединить(Область);
			ВыводитьГод = Истина;
		КонецЕсли;
	КонецЦикла;
	Область = Макет.ПолучитьОбласть("Строка|Год");
	Область.Параметры.КоличествоЗаГод = КоличествоЗаГод;
	Область.Параметры.СтоимостьЗаГод = СтоимостьЗаГод;
	ТабДок.Присоединить(Область);
	Если мВыводитьОстатки Тогда
		Область = Макет.ПолучитьОбласть("Строка|Остатки");
		
		Если Не ТаблицаКорректировок = Неопределено И МассвиКоррекций.Количество()>0 Тогда
			Область.Параметры.Количество = (СтрокаПозиции.ОбъемРабот+ОбъемРабот) - КоличествоСНачала;
			Область.Параметры.Стоимость = (СтрокаПозиции.СметнаяСтоимость+СметнаяСтоимость) - СтоимостьСНачала;
		Иначе
			Область.Параметры.Количество = СтрокаПозиции.ОбъемРабот - КоличествоСНачала;
			Область.Параметры.Стоимость = ?(ЗначениеЗаполнено(СтрокаПозиции.СметнаяСтоимость),СтрокаПозиции.СметнаяСтоимость,0) - СтоимостьСНачала;
		КонецЕсли;
		
		ТабДок.Присоединить(Область);
	КонецЕсли;
					
КонецПроцедуры

Процедура ВывестиИтогРаздела(СтрокаИтога,ТаблицаКорректировок = Неопределено, ВсеСтрокиДерева = Неопределено, КорректировкаУровня = 0)
	
	ОбластьСтрока = Макет.ПолучитьОбласть("ИтогПоРазделу|Основная");
	
	Если Не ТаблицаКорректировок = Неопределено Тогда
		МассвиКоррекций = ТаблицаКорректировок.НайтиСтроки(Новый Структура("Прототип",СтрокаИтога.Раздел));
	КонецЕсли;
	
	Если Не ТаблицаКорректировок = Неопределено И МассвиКоррекций.Количество()>0 Тогда
		ИтогСтоимость = 0;
		Для Каждого Кор Из МассвиКоррекций Цикл
			СтрокаДанных = ВсеСтрокиДерева.Найти(Кор.Коррекция, "Раздел", Истина);
			Если Не СтрокаДанных = Неопределено Тогда
				СтрокаДанныхИтог = СтрокаДанных.Строки.Найти(СтрокаИтога.Итог,"Итог");
				Если Не СтрокаДанныхИтог = Неопределено Тогда
					ИтогСтоимость = ИтогСтоимость+СтрокаДанныхИтог.ИтогСтоимость;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры,СтрокаИтога);
		ОбластьСтрока.Параметры.ИтогСтоимость = СтрокаИтога.ИтогСтоимость + ИтогСтоимость;
	Иначе
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры,СтрокаИтога);
	КонецЕсли;
	
	// **************************************************
	Если ВыводитьНомераИтогов Тогда
		Если ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ИтогиПоРазделу") Тогда
			ОбластьСтрока.Параметры.НомерИтога = "РД " + СтрокаИтога.Итог.ПорядковыйНомер;	
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Это не итог: " + СтрокаИтога.Итог + "'"));
		КонецЕсли;
	КонецЕсли;
	// **************************************************
	
	ТабДок.Вывести(ОбластьСтрока,СтрокаИтога.Уровень() + КорректировкаУровня);
	
	ТаблицаПериодовПозиции = ТаблицаПериодов.Скопировать();
	Для Каждого СтрокаПериода Из СтрокаИтога.Строки Цикл
		СтрокаТаблицыПериодов = ТаблицаПериодовПозиции.Найти(СтрокаПериода.ИтогДата,"Дата");
		Если СтрокаТаблицыПериодов <> Неопределено Тогда
			Если Не ТаблицаКорректировок = Неопределено И МассвиКоррекций.Количество()>0 Тогда
				СтрокаТаблицыПериодов.Стоимость = СтрокаПериода.ИтогСтоимостьФакт;
				ИтогСтоимостьФакт = 0;
				Для Каждого Кор Из МассвиКоррекций Цикл
					СтрокаДанных = ВсеСтрокиДерева.Найти(Кор.Коррекция, "Раздел", Истина);
					Если Не СтрокаДанных = Неопределено Тогда
						СтрокаДанныхПодИтог = СтрокаДанных.Строки.Найти(СтрокаИтога.Итог,"Итог");
						Если Не СтрокаДанныхПодИтог = Неопределено Тогда
							Для Каждого СтрокаПериодаПодИтог Из СтрокаДанныхПодИтог.Строки Цикл
								СтрокаТаблицыПериодовПодИтог = ТаблицаПериодовПозиции.Найти(СтрокаПериодаПодИтог.ИтогДата,"Дата");
								Если СтрокаТаблицыПериодовПодИтог <> Неопределено Тогда
									СтрокаТаблицыПериодовПодИтог.Стоимость = СтрокаТаблицыПериодовПодИтог.Стоимость+СтрокаПериодаПодИтог.ИтогСтоимостьФакт;
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
				МассвиКоррекцийНов = ТаблицаКорректировок.НайтиСтроки(Новый Структура("НовыйРаздел",Истина));
				Для Каждого Кор Из МассвиКоррекцийНов Цикл
					СтрокаДанных = ВсеСтрокиДерева.Найти(Кор.Коррекция, "Раздел", Истина);
					Если Не СтрокаДанных = Неопределено Тогда
						СтрокаДанныхПодИтог = СтрокаДанных.Строки.Найти(СтрокаИтога.Итог,"Итог");
						Если Не СтрокаДанныхПодИтог = Неопределено Тогда
							Для Каждого СтрокаПериодаПодИтог Из СтрокаДанныхПодИтог.Строки Цикл
								СтрокаТаблицыПериодовПодИтог = ТаблицаПериодовПозиции.Найти(СтрокаПериодаПодИтог.ИтогДата,"Дата");
								Если СтрокаТаблицыПериодовПодИтог <> Неопределено Тогда
									СтрокаТаблицыПериодовПодИтог.Стоимость = СтрокаТаблицыПериодовПодИтог.Стоимость+СтрокаПериодаПодИтог.ИтогСтоимостьФакт;
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;

				СтрокаТаблицыПериодов.Стоимость = СтрокаПериода.ИтогСтоимостьФакт + ИтогСтоимостьФакт;
			Иначе
				СтрокаТаблицыПериодов.Стоимость = СтрокаПериода.ИтогСтоимостьФакт;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	СтоимостьСНачала = 0;
	ВыводитьГод = Ложь;
	ТекущийГод = Неопределено;
	Для Каждого СтрокаПериода Из ТаблицаПериодовПозиции Цикл
		Если ТекущийГод = Неопределено Тогда
			СтоимостьЗаГод = 0;
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
			ВыводитьГод = Ложь;
		ИначеЕсли ТекущийГод <> НачалоГода(СтрокаПериода.Дата) Тогда
			Если ВыводитьГод Тогда
				Область = Макет.ПолучитьОбласть("ИтогПоРазделу|Год");
				Область.Параметры.СтоимостьЗаГод = СтоимостьЗаГод;
				ТабДок.Присоединить(Область);
				ВыводитьГод = Ложь;
			КонецЕсли;
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
			СтоимостьЗаГод = 0;
		КонецЕсли;
		СтоимостьСНачала = СтоимостьСНачала + СтрокаПериода.Стоимость;
		СтоимостьЗаГод = СтоимостьЗаГод + СтрокаПериода.Стоимость;
		ВыводитьВОтчет = МассивПериодовНаПечать.Найти(СтрокаПериода.Дата) <> Неопределено;
		Если ВыводитьВОтчет Тогда
			Область = Макет.ПолучитьОбласть("ИтогПоРазделу|Месяц");
			ЗаполнитьЗначенияСвойств(Область.Параметры,СтрокаПериода);
			ТабДок.Присоединить(Область);
			ВыводитьГод = Истина;
		КонецЕсли;
	КонецЦикла;
	Область = Макет.ПолучитьОбласть("ИтогПоРазделу|Год");
	Область.Параметры.СтоимостьЗаГод = СтоимостьЗаГод;
	ТабДок.Присоединить(Область);
	Если мВыводитьОстатки Тогда
		Область = Макет.ПолучитьОбласть("ИтогПоРазделу|Остатки");
		Если Не ТаблицаКорректировок = Неопределено И МассвиКоррекций.Количество()>0 Тогда
			Область.Параметры.Стоимость = (СтрокаИтога.ИтогСтоимость+ИтогСтоимость)  - СтоимостьСНачала;
		Иначе
			Область.Параметры.Стоимость = СтрокаИтога.ИтогСтоимость - СтоимостьСНачала;
		КонецЕсли;
		ТабДок.Присоединить(Область);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиИтогПоСмете(СтрокаИтога,Индекс,ТаблицаКорректировок,ВсеСтрокиДерева = Неопределено, КорректировкаУровня = 0)
	
	ИндексСтрокиДанных 	= Индекс;
	ОбластьСтрока 		= Макет.ПолучитьОбласть("ИтогПоРазделу|Основная");
	ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры,СтрокаИтога);
	ОбластьСтрока.Параметры.Итог = СтрокаИтога.СметаИтог;

	Если Не ИндексСтрокиДанных = Неопределено Тогда
		СтоимостьПоСмете = 0;
		Сч = ВсеСтрокиДерева.Количество()-1;
		Пока ИндексСтрокиДанных<=Сч Цикл
			Если Не ЗначениеЗаполнено(ВсеСтрокиДерева[ИндексСтрокиДанных].ЛокальнаяСмета) Тогда
				Прервать;
			КонецЕсли;
			Если ТаблицаКорректировок = Неопределено Тогда
				Если Не ВсеСтрокиДерева[ИндексСтрокиДанных].ЛокальнаяСмета = СтрокаИтога.ЛокальнаяСмета Тогда
					Прервать;
				КонецЕсли;
			Иначе
				СтрКор = ТаблицаКорректировок.Найти(ВсеСтрокиДерева[ИндексСтрокиДанных].ЛокальнаяСмета,"СметаКоррекция");
				Если СтрКор = Неопределено ИЛИ Не СтрКор.Смета = СтрокаИтога.ЛокальнаяСмета Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
			СтрокаДанных = ВсеСтрокиДерева[ИндексСтрокиДанных].Строки;
			Если Не СтрокаДанных = Неопределено Тогда
				СтрокаДанныхПодИтог = СтрокаДанных.Найти(СтрокаИтога.СметаИтог,"СметаИтог");
				Если Не СтрокаДанныхПодИтог = Неопределено Тогда
					СтоимостьПоСмете = СтоимостьПоСмете+СтрокаДанныхПодИтог.СтоимостьПоСмете;
				КонецЕсли;
			КонецЕсли;
			ИндексСтрокиДанных = ИндексСтрокиДанных+1;
		КонецЦикла;
		ОбластьСтрока.Параметры.ИтогСтоимость = СтрокаИтога.СтоимостьПоСмете + СтоимостьПоСмете;
	Иначе
		ОбластьСтрока.Параметры.ИтогСтоимость = СтрокаИтога.СтоимостьПоСмете;
	КонецЕсли;
	
	// **************************************************
	Если ВыводитьНомераИтогов Тогда
		Если ТипЗнч(СтрокаИтога.СметаИтог) = Тип("СправочникСсылка.СМ_ИтогиПоСмете") Тогда
			ОбластьСтрока.Параметры.НомерИтога = "СМ " + СтрокаИтога.СметаИтог.ПорядковыйНомер;	
		ИначеЕсли ТипЗнч(СтрокаИтога.СметаИтог) = Тип("СправочникСсылка.СМ_ИтогиСметыПоВидамРабот") Тогда
			ОбластьСтрока.Параметры.НомерИтога = "По ВР";	
		Иначе	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Это не итог: " + СтрокаИтога.СметаИтог + "'"));
		КонецЕсли;
	КонецЕсли;
	// **************************************************
	
	ТабДок.Вывести(ОбластьСтрока,СтрокаИтога.Уровень() + КорректировкаУровня);
	
	// ***********************************************************************
	// Добавление итога по объекту строительства
	Если НЕ ЗначениеЗаполнено(СтрокаИтога.ЛокальнаяСмета.ИдРодителя) Тогда
		Если СтрокаИтога.СметаИтог = Справочники.СМ_ИтогиПоСмете.ВсегоПоСмете Тогда
			СтрокаИтоговОбъекта 					= ТаблицаИтоговОбъекта.Добавить();
			СтрокаИтоговОбъекта.ГруппаОбъекта		= СтрокаИтога.ЛокальнаяСмета.Стройка.Родитель;
			СтрокаИтоговОбъекта.ОбъектСтроительства = СтрокаИтога.ЛокальнаяСмета.Стройка;
			СтрокаИтоговОбъекта.Итог                = СтрокаИтога.ЛокальнаяСмета;
			СтрокаИтоговОбъекта.ПорядковыйНомер		= СтрокаИтога.ЛокальнаяСмета.ПорНомер;
			СтрокаИтоговОбъекта.Стоимость           = ОбластьСтрока.Параметры.ИтогСтоимость;
		КонецЕсли;
	КонецЕсли;
	// ***********************************************************************
	
	ИндексСтрокиДанных = Индекс;
	ТаблицаПериодовПозиции = ТаблицаПериодов.Скопировать();
	Для Каждого СтрокаПериода Из СтрокаИтога.Строки Цикл
		СтрокаТаблицыПериодов = ТаблицаПериодовПозиции.Найти(СтрокаПериода.СметаДата,"Дата");
		Если СтрокаТаблицыПериодов <> Неопределено Тогда
			Если Не ИндексСтрокиДанных = Неопределено Тогда
				СтоимостьПоСметеЗаПериод = 0;
				Сч = ВсеСтрокиДерева.Количество()-1;
				Пока ИндексСтрокиДанных<=Сч Цикл
					Если Не ЗначениеЗаполнено(ВсеСтрокиДерева[ИндексСтрокиДанных].ЛокальнаяСмета) Тогда
						Прервать;
					КонецЕсли;
					Если ТаблицаКорректировок = Неопределено Тогда
						Если Не ВсеСтрокиДерева[ИндексСтрокиДанных].ЛокальнаяСмета = СтрокаИтога.ЛокальнаяСмета Тогда
							Прервать;
						КонецЕсли;
					Иначе
						СтрКор = ТаблицаКорректировок.Найти(ВсеСтрокиДерева[ИндексСтрокиДанных].ЛокальнаяСмета,"СметаКоррекция");
						Если СтрКор = Неопределено
							ИЛИ Не СтрКор.Смета = СтрокаИтога.ЛокальнаяСмета Тогда
							Прервать;
						КонецЕсли;
					КонецЕсли;
					СтрокаДанных = ВсеСтрокиДерева[ИндексСтрокиДанных].Строки;
					Если Не СтрокаДанных = Неопределено Тогда
						СтрокаДанныхПодИтог = СтрокаДанных.Найти(СтрокаПериода.СметаИтог,"СметаИтог");
						Если Не СтрокаДанныхПодИтог = Неопределено Тогда
							СтрокаДанныхИтог = СтрокаДанныхПодИтог.Строки.Найти(СтрокаПериода.СметаДата,"СметаДата");
							Если Не СтрокаДанныхИтог = Неопределено Тогда
								СтоимостьПоСметеЗаПериод = СтоимостьПоСметеЗаПериод+СтрокаДанныхИтог.СтоимостьПоСметеЗаПериод;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					ИндексСтрокиДанных = ИндексСтрокиДанных+1;
				КонецЦикла;
				СтрокаТаблицыПериодов.Стоимость = СтрокаПериода.СтоимостьПоСметеЗаПериод+СтоимостьПоСметеЗаПериод;
			Иначе
				СтрокаТаблицыПериодов.Стоимость = СтрокаПериода.СтоимостьПоСметеЗаПериод;
			КонецЕсли;
			
			// ***********************************************************************
			// Добавление итога по факту по объекту строительства
			Если НЕ ЗначениеЗаполнено(СтрокаИтога.ЛокальнаяСмета.ИдРодителя) Тогда
				Если СтрокаИтога.СметаИтог = Справочники.СМ_ИтогиПоСмете.ВсегоПоСмете Тогда
					СтрокаИтоговОбъекта 					= ТаблицаИтоговОбъектаФакт.Добавить();
					СтрокаИтоговОбъекта.ГруппаОбъекта		= СтрокаИтога.ЛокальнаяСмета.Стройка.Родитель;
					СтрокаИтоговОбъекта.ОбъектСтроительства = СтрокаИтога.ЛокальнаяСмета.Стройка;
					СтрокаИтоговОбъекта.Итог                = СтрокаИтога.ЛокальнаяСмета;
					СтрокаИтоговОбъекта.Период	            = СтрокаПериода.СметаДата;
					СтрокаИтоговОбъекта.Стоимость           = СтрокаТаблицыПериодов.Стоимость;
				КонецЕсли;
			КонецЕсли;
			// ***********************************************************************			
			
		КонецЕсли;	
	КонецЦикла;
	
	СтоимостьСНачала = 0;
	ВыводитьГод = Ложь;
	ТекущийГод = Неопределено;
	Для Каждого СтрокаПериода Из ТаблицаПериодовПозиции Цикл
		Если ТекущийГод = Неопределено Тогда
			СтоимостьЗаГод = 0;
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
			ВыводитьГод = Ложь;
		ИначеЕсли ТекущийГод <> НачалоГода(СтрокаПериода.Дата) Тогда
			Если ВыводитьГод Тогда
				Область = Макет.ПолучитьОбласть("ИтогПоРазделу|Год");
				Область.Параметры.СтоимостьЗаГод = СтоимостьЗаГод;
				ТабДок.Присоединить(Область);
				ВыводитьГод = Ложь;
			КонецЕсли;
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
			СтоимостьЗаГод = 0;
		КонецЕсли;
		СтоимостьСНачала = СтоимостьСНачала + СтрокаПериода.Стоимость;
		СтоимостьЗаГод = СтоимостьЗаГод + СтрокаПериода.Стоимость;
		ВыводитьВОтчет = МассивПериодовНаПечать.Найти(СтрокаПериода.Дата) <> Неопределено;
		Если ВыводитьВОтчет Тогда
			Область = Макет.ПолучитьОбласть("ИтогПоРазделу|Месяц");
			ЗаполнитьЗначенияСвойств(Область.Параметры,СтрокаПериода);
			ТабДок.Присоединить(Область);
			ВыводитьГод = Истина;
		КонецЕсли;
	КонецЦикла;
	Область = Макет.ПолучитьОбласть("ИтогПоРазделу|Год");
	Область.Параметры.СтоимостьЗаГод = СтоимостьЗаГод;
	ТабДок.Присоединить(Область);
	Если мВыводитьОстатки Тогда
		Область = Макет.ПолучитьОбласть("ИтогПоРазделу|Остатки");
		Если ТипЗнч(СтрокаИтога.СметаИтог)=Тип("СправочникСсылка.СМ_ИтогиСметыПоВидамРабот") Тогда
			Область.Параметры.Стоимость = "";
		Иначе
			Если ИндексСтрокиДанных = Неопределено Тогда
				Область.Параметры.Стоимость = СтрокаИтога.СтоимостьПоСмете - СтоимостьСНачала;
			Иначе
				Область.Параметры.Стоимость = (СтрокаИтога.СтоимостьПоСмете+СтоимостьПоСмете) - СтоимостьСНачала;
			КонецЕсли;
		КонецЕсли;
		ТабДок.Присоединить(Область);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиСтрокуЛокальнойСметы(ЛокальнаяСмета,ДеревоЗначений,ИндексСтрокиДанных,УровеньГруппировки)
	
	Инд 		= 0;
	МассивНашли = ДеревоЗначений.Строки.НайтиСтроки(Новый Структура("ЛокальнаяСмета",ЛокальнаяСмета));
	Для Каждого Нашли Из МассивНашли Цикл
		Инд = ДеревоЗначений.Строки.Индекс(Нашли);
		Если Инд < ИндексСтрокиДанных Тогда
			Продолжить;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	НомерПоПорядку = 1;
		
	Если Нашли <> Неопределено Тогда
		ВывестиСмету(Нашли.ЛокальнаяСмета,"Смета",УровеньГруппировки);
	КонецЕсли;
	
	// Если сортировку не делать, то неправильно выводятся разделы
	КоллекцияСтрокДерева = ДеревоЗначений.Строки[Инд].Строки;
	КоллекцияСтрокДерева.Сортировать("Сортировка, ПорНомерРаздела");
	
	ВывестиДеревоВДокумент(ДеревоЗначений.Строки[Инд].Строки,НомерПоПорядку,,ДеревоЗначений.Строки,Инд+1,,,УровеньГруппировки);

КонецПроцедуры

Процедура ВывестиСтрокуСводнойСметы(СводнаяСмета,ДеревоЗначений,ИндексСтрокиДанных,УровеньГруппировки)
	
	ТипСметы = "Сводная смета";
	ВывестиСмету(СводнаяСмета,ТипСметы,УровеньГруппировки);
	ТекУровень = УровеньГруппировки + 1;
	Для Каждого ТекСтрока Из СводнаяСмета.Сметы Цикл
		Если ТипЗнч(ТекСтрока.Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
			ВывестиСтрокуОбъектнойСметы(ТекСтрока.Смета,ДеревоЗначений,ИндексСтрокиДанных,ТекУровень);
		ИначеЕсли ТипЗнч(ТекСтрока.Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			ВывестиСтрокуЛокальнойСметы(ТекСтрока.Смета,ДеревоЗначений,ИндексСтрокиДанных,ТекУровень);
		КонецЕсли;
	КонецЦикла;

	Если мВыводитьИтоги Тогда
		ВывестиИтогиПоСмете(СводнаяСмета,ТекУровень);
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиСтрокуОбъектнойСметы(ОбъектнаяСмета,ДеревоЗначений,ИндексСтрокиДанных,УровеньГруппировки)
	
	МассивЛССметы 		= Новый Массив;
	ТипСметы			= "Объектная смета";
	ВывестиСмету(ОбъектнаяСмета,ТипСметы,УровеньГруппировки);
	ТекУровень = УровеньГруппировки + 1;
	Для Каждого ТекСтрока Из ОбъектнаяСмета.ЛокальныеСметы Цикл
		ВывестиСтрокуЛокальнойСметы(ТекСтрока.ЛокальнаяСмета,ДеревоЗначений,ИндексСтрокиДанных,ТекУровень);
	КонецЦикла;
	
	Если мВыводитьИтоги Тогда
		ВывестиИтогиПоСмете(ОбъектнаяСмета,ТекУровень);
	КонецЕсли;
					
КонецПроцедуры

Процедура ВывестиСтрокуГруппыОбъектаСтроительства(ГруппаОбъекта,УровеньГруппировки)
	
	ОбластьГруппаОбъекта								= Макет.ПолучитьОбласть("ОбъектСтроительства|Основная");
	ОбластьГруппаОбъекта.Параметры.ОбъектСтроительства	= ГруппаОбъекта;
	ТабДок.Вывести(ОбластьГруппаОбъекта,УровеньГруппировки);
	
	ТаблицаПериодовСметы 	= ТаблицаПериодов.Скопировать();
	ВыводитьГод 			= Ложь;
	ТекущийГод 				= Неопределено;
	Для Каждого СтрокаПериода Из ТаблицаПериодовСметы Цикл
		Если ТекущийГод = Неопределено Тогда
			ТекущийГод 	= НачалоГода(СтрокаПериода.Дата);
			ВыводитьГод = Ложь;
		ИначеЕсли ТекущийГод <> НачалоГода(СтрокаПериода.Дата) Тогда
			Если ВыводитьГод Тогда
				Область = Макет.ПолучитьОбласть("ОбъектСтроительства|Год");
				ТабДок.Присоединить(Область);
				ВыводитьГод = Ложь;
			КонецЕсли;
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
		КонецЕсли;
		ВыводитьВОтчет = МассивПериодовНаПечать.Найти(СтрокаПериода.Дата) <> Неопределено;
		Если ВыводитьВОтчет Тогда
			Область = Макет.ПолучитьОбласть("ОбъектСтроительства|Месяц");
			ТабДок.Присоединить(Область);
			ВыводитьГод = Истина;
		КонецЕсли;
	КонецЦикла;
	Область = Макет.ПолучитьОбласть("ОбъектСтроительства|Год");
	ТабДок.Присоединить(Область);
	Если мВыводитьОстатки Тогда
		Область = Макет.ПолучитьОбласть("ОбъектСтроительства|Остатки");
		ТабДок.Присоединить(Область);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиСтрокуОбъектаСтроительства(ОбъектСтроительства,УровеньГруппировки)
	
	ОбластьОбъект									= Макет.ПолучитьОбласть("ОбъектСтроительства|Основная");
	ОбластьОбъект.Параметры.ОбъектСтроительства 	= ОбъектСтроительства;
	ТабДок.Вывести(ОбластьОбъект,УровеньГруппировки);
	
	ТаблицаПериодовСметы 	= ТаблицаПериодов.Скопировать();
	ВыводитьГод 			= Ложь;
	ТекущийГод 				= Неопределено;
	Для Каждого СтрокаПериода Из ТаблицаПериодовСметы Цикл
		Если ТекущийГод = Неопределено Тогда
			ТекущийГод 	= НачалоГода(СтрокаПериода.Дата);
			ВыводитьГод = Ложь;
		ИначеЕсли ТекущийГод <> НачалоГода(СтрокаПериода.Дата) Тогда
			Если ВыводитьГод Тогда
				Область = Макет.ПолучитьОбласть("ОбъектСтроительства|Год");
				ТабДок.Присоединить(Область);
				ВыводитьГод = Ложь;
			КонецЕсли;
			ТекущийГод = НачалоГода(СтрокаПериода.Дата);
		КонецЕсли;
		ВыводитьВОтчет = МассивПериодовНаПечать.Найти(СтрокаПериода.Дата) <> Неопределено;
		Если ВыводитьВОтчет Тогда
			Область = Макет.ПолучитьОбласть("ОбъектСтроительства|Месяц");
			ТабДок.Присоединить(Область);
			ВыводитьГод = Истина;
		КонецЕсли;
	КонецЦикла;
	Область = Макет.ПолучитьОбласть("ОбъектСтроительства|Год");
	ТабДок.Присоединить(Область);
	Если мВыводитьОстатки Тогда
		Область = Макет.ПолучитьОбласть("ОбъектСтроительства|Остатки");
		ТабДок.Присоединить(Область);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиИтогиПоСмете(Смета,УровеньГруппировки)
	
	СтруктураОтбораФакт	= Новый Структура;
	Если ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		СтруктураОтбораФакт.Вставить("СводнаяСмета",Смета);
	ИначеЕсли ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
	  	СтруктураОтбораФакт.Вставить("ОбъектнаяСмета",Смета);
	КонецЕсли;
	
	МассивЛС 			= Новый Массив;
	МассивСтрокТаблицы	= ТаблицаСоответствия.НайтиСтроки(СтруктураОтбораФакт);
	Для Каждого ТекСтрока Из МассивСтрокТаблицы Цикл
		МассивЛС.Добавить(ТекСтрока.ЛокальнаяСмета); 	
	КонецЦикла;
	ТабФактПоСмете = ПолучитьФактПоСметам(МассивЛС);
	ТабФактПоСмете.Свернуть("Итог,МесяцАкта","ИтогСтоимость");
	ТабФактПоСмете.Сортировать("Итог");
	
	СтруктураОтбораИтог	= Новый Структура;
	СтруктураОтбораИтог.Вставить("Смета",Смета);
	СтрокиИтоговПоСмете = ТабИтогиПоСметам.НайтиСтроки(СтруктураОтбораИтог);

	ОбластьСтрока = Макет.ПолучитьОбласть("ИтогПоСмете|Основная");
	Для Каждого ТекСтрока Из СтрокиИтоговПоСмете Цикл
		
		ИтогСтоимость = 0;
		Если Смета.БазисныеЦены Тогда
			ИтогСтоимость = ТекСтрока.ПрямЗатраты;
		Иначе
			ИтогСтоимость = ТекСтрока.ТекПрямЗатраты;
		КонецЕсли;
		ОбластьСтрока.Параметры.Итог 			= ТекСтрока.Итог; 
		ОбластьСтрока.Параметры.ИтогСтоимость   = ИтогСтоимость;
		ТабДок.Вывести(ОбластьСтрока,УровеньГруппировки);
		
		СтрокаИтоговОбъекта 					= ТаблицаИтоговОбъекта.Добавить();
		СтрокаИтоговОбъекта.ГруппаОбъекта		= Смета.Стройка.Родитель;
		СтрокаИтоговОбъекта.ОбъектСтроительства = Смета.Стройка;
		СтрокаИтоговОбъекта.Итог                = ТекСтрока.Итог;
		Если ТипЗнч(ТекСтрока.Итог) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
			СтрокаИтоговОбъекта.ПорядковыйНомер = ТекСтрока.Итог.КИтогу.ПорядковыйНомер;	
		ИначеЕсли ТипЗнч(ТекСтрока.Итог) = Тип("СправочникСсылка.СМ_ИтогиПоГлавам") Тогда
			СтрокаИтоговОбъекта.ПорядковыйНомер	= ТекСтрока.Итог.ПорядковыйНомер;
		Иначе	
			СтрокаИтоговОбъекта.ПорядковыйНомер	= 0;
		КонецЕсли;
		СтрокаИтоговОбъекта.Стоимость           = ИтогСтоимость;
		СтрокаИтоговОбъекта.СортировкаИтогов	= ТекСтрока.СортировкаИтогов;
		
		// Получение итога фактической стоимости по итогу "Объектная смета".
		// Для этого берем итог "итого по смете" по всем актам входящим в состав объектной сметы.
		// Аналогично для итога "Локальная смета", берем итог "Итого по смете" по всем актам входящим в состав "ЛС".
		Если ТипЗнч(ТекСтрока.Итог) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
			МассивЛСпоОС		= Новый Массив;
			СтруктураОтбораФакт	= Новый Структура;
			СтруктураОтбораФакт.Вставить("ОбъектнаяСмета",ТекСтрока.Итог);
			МассивСтрокТаблицы	= ТаблицаСоответствия.НайтиСтроки(СтруктураОтбораФакт);
			Для Каждого СтрокаМассива Из МассивСтрокТаблицы Цикл
				МассивЛСпоОС.Добавить(СтрокаМассива.ЛокальнаяСмета); 	
			КонецЦикла;
			ТабФактПоОбъектнойСмете = ПолучитьФактПоСметам(МассивЛСпоОС);
			ТабФактПоОбъектнойСмете.Свернуть("Итог,МесяцАкта","ИтогСтоимость");
			
			СтруктураОтбораФакта = Новый Структура;
			СтруктураОтбораФакта.Вставить("Итог",ИтогИтогоПоСмете);
			МассивСтрокИтога 	 = ТабФактПоОбъектнойСмете.НайтиСтроки(СтруктураОтбораФакта);
		ИначеЕсли ТипЗнч(ТекСтрока.Итог) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			МассивЛСпоЛС		= Новый Массив;
			МассивЛСпоЛС.Добавить(ТекСтрока.Итог);
			ТабФактПоОбъектнойСмете = ПолучитьФактПоСметам(МассивЛСпоЛС);
			ТабФактПоОбъектнойСмете.Свернуть("Итог,МесяцАкта","ИтогСтоимость");
			
			СтруктураОтбораФакта = Новый Структура;
			СтруктураОтбораФакта.Вставить("Итог",ИтогИтогоПоСмете);
			МассивСтрокИтога 	 = ТабФактПоОбъектнойСмете.НайтиСтроки(СтруктураОтбораФакта);
		Иначе
			СтруктураОтбораФакта = Новый Структура;
			СтруктураОтбораФакта.Вставить("Итог",ТекСтрока.Итог);
			МассивСтрокИтога 	 = ТабФактПоСмете.НайтиСтроки(СтруктураОтбораФакта);
		КонецЕсли;
		
		ТаблицаПериодовПозиции 	= ТаблицаПериодов.Скопировать();
		Для Каждого СтрокаФактаСметы Из МассивСтрокИтога Цикл
			СтрокаТаблицыПериодов = ТаблицаПериодовПозиции.Найти(СтрокаФактаСметы.МесяцАкта,"Дата");
			Если СтрокаТаблицыПериодов <> Неопределено Тогда
				СтрокаТаблицыПериодов.Стоимость = СтрокаФактаСметы.ИтогСтоимость;
				
				СтрокаИтоговОбъекта 					= ТаблицаИтоговОбъектаФакт.Добавить();
				СтрокаИтоговОбъекта.ГруппаОбъекта		= Смета.Стройка.Родитель;
				СтрокаИтоговОбъекта.ОбъектСтроительства = Смета.Стройка;
				СтрокаИтоговОбъекта.Итог                = ТекСтрока.Итог;
				СтрокаИтоговОбъекта.Период	            = СтрокаТаблицыПериодов.Дата;
				СтрокаИтоговОбъекта.Стоимость           = СтрокаФактаСметы.ИтогСтоимость;
				
			КонецЕсли;	
		КонецЦикла;
		
		СтоимостьСНачала 	= 0;
		ВыводитьГод 		= Ложь;
		ТекущийГод 			= Неопределено;
		Для Каждого СтрокаПериода Из ТаблицаПериодовПозиции Цикл
			Если ТекущийГод = Неопределено Тогда
				СтоимостьЗаГод 	= 0;
				ТекущийГод 		= НачалоГода(СтрокаПериода.Дата);
				ВыводитьГод 	= Ложь;
			ИначеЕсли ТекущийГод <> НачалоГода(СтрокаПериода.Дата) Тогда
				Если ВыводитьГод Тогда
					Область = Макет.ПолучитьОбласть("ИтогПоСмете|Год");
					Область.Параметры.СтоимостьЗаГод = СтоимостьЗаГод;
					ТабДок.Присоединить(Область);
					ВыводитьГод = Ложь;
				КонецЕсли;
				ТекущийГод 		= НачалоГода(СтрокаПериода.Дата);
				СтоимостьЗаГод 	= 0;
			КонецЕсли;
			СтоимостьСНачала	= СтоимостьСНачала 	+ СтрокаПериода.Стоимость;
			СтоимостьЗаГод 		= СтоимостьЗаГод + СтрокаПериода.Стоимость;
			ВыводитьВОтчет 		= МассивПериодовНаПечать.Найти(СтрокаПериода.Дата) <> Неопределено;
			Если ВыводитьВОтчет Тогда
				Область 							= Макет.ПолучитьОбласть("ИтогПоСмете|Месяц");
				Область.Параметры.Стоимость 		= СтрокаПериода.Стоимость;
				Область.Параметры.СтоимостьСНачала 	= СтоимостьСНачала;
				ТабДок.Присоединить(Область);
				ВыводитьГод = Истина;
			КонецЕсли;
		КонецЦикла;
		Область 							= Макет.ПолучитьОбласть("ИтогПоСмете|Год");
		Область.Параметры.СтоимостьЗаГод 	= СтоимостьЗаГод;
		ТабДок.Присоединить(Область);
		
		Если мВыводитьОстатки Тогда
			Область 					= Макет.ПолучитьОбласть("ИтогПоСмете|Остатки");
			Область.Параметры.Стоимость = ИтогСтоимость - СтоимостьСНачала;
			ТабДок.Присоединить(Область);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиИтогиПоОбъекту(ТекОбъект,УровеньГруппировки)
	
	ТабИтоговОбъекта 		= ТаблицаИтоговОбъекта.Скопировать();
	ТабИтоговОбъектаФакт 	= ТаблицаИтоговОбъектаФакт.Скопировать();
	
	Если ТекОбъект.ЭтоГруппа Тогда
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ГруппаОбъекта",ТекОбъект);
		ТабИтоговОбъекта.Свернуть("ГруппаОбъекта,Итог,ПорядковыйНомер,СортировкаИтогов","Стоимость");
		ТабИтоговОбъектаФакт.Свернуть("ГруппаОбъекта,Итог,Период","Стоимость");
		ТабИтоговОбъекта.Сортировать("ПорядковыйНомер,СортировкаИтогов");
	Иначе
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ОбъектСтроительства",ТекОбъект);
		ТабИтоговОбъекта.Свернуть("ОбъектСтроительства,Итог,ПорядковыйНомер,СортировкаИтогов","Стоимость");
		ТабИтоговОбъектаФакт.Свернуть("ОбъектСтроительства,Итог,Период","Стоимость");
		ТабИтоговОбъекта.Сортировать("ПорядковыйНомер,СортировкаИтогов");
	КонецЕсли;
	СтрокиИтоговОбъекта = ТабИтоговОбъекта.НайтиСтроки(СтруктураОтбора);
	
	ОбластьСтрока = Макет.ПолучитьОбласть("ИтогПоОбъекту|Основная");
	Для Каждого ТекСтрока Из СтрокиИтоговОбъекта Цикл
		
		ИтогСтоимость = 0;
		
		ОбластьСтрока.Параметры.Итог 			= ТекСтрока.Итог; 
		ОбластьСтрока.Параметры.ИтогСтоимость   = ТекСтрока.Стоимость;
		ИтогСтоимость = ТекСтрока.Стоимость;
		ТабДок.Вывести(ОбластьСтрока,УровеньГруппировки);

		Если ТекОбъект.ЭтоГруппа Тогда
			СтруктураОтбораФакта = Новый Структура;
			СтруктураОтбораФакта.Вставить("Итог",ТекСтрока.Итог);
			СтруктураОтбораФакта.Вставить("ГруппаОбъекта",ТекОбъект);
		Иначе
			СтруктураОтбораФакта = Новый Структура;
			СтруктураОтбораФакта.Вставить("Итог",ТекСтрока.Итог);
			СтруктураОтбораФакта.Вставить("ОбъектСтроительства",ТекОбъект);
		КонецЕсли;
		
		МассивСтрокИтога 		= ТабИтоговОбъектаФакт.НайтиСтроки(СтруктураОтбораФакта);
		ТаблицаПериодовПозиции 	= ТаблицаПериодов.Скопировать();
		Для Каждого СтрокаФактаОбъекта Из МассивСтрокИтога Цикл
			СтрокаТаблицыПериодов = ТаблицаПериодовПозиции.Найти(СтрокаФактаОбъекта.Период,"Дата");
			Если СтрокаТаблицыПериодов <> Неопределено Тогда
				СтрокаТаблицыПериодов.Стоимость = СтрокаФактаОбъекта.Стоимость;
			КонецЕсли;	
		КонецЦикла;
		
		СтоимостьСНачала 	= 0;
		ВыводитьГод 		= Ложь;
		ТекущийГод 			= Неопределено;
		Для Каждого СтрокаПериода Из ТаблицаПериодовПозиции Цикл
			Если ТекущийГод = Неопределено Тогда
				СтоимостьЗаГод 	= 0;
				ТекущийГод 		= НачалоГода(СтрокаПериода.Дата);
				ВыводитьГод 	= Ложь;
			ИначеЕсли ТекущийГод <> НачалоГода(СтрокаПериода.Дата) Тогда
				Если ВыводитьГод Тогда
					Область = Макет.ПолучитьОбласть("ИтогПоОбъекту|Год");
					Область.Параметры.СтоимостьЗаГод = СтоимостьЗаГод;
					ТабДок.Присоединить(Область);
					ВыводитьГод = Ложь;
				КонецЕсли;
				ТекущийГод 		= НачалоГода(СтрокаПериода.Дата);
				СтоимостьЗаГод 	= 0;
			КонецЕсли;
			СтоимостьСНачала	= СтоимостьСНачала + СтрокаПериода.Стоимость;
			СтоимостьЗаГод 		= СтоимостьЗаГод + СтрокаПериода.Стоимость;
			ВыводитьВОтчет 		= МассивПериодовНаПечать.Найти(СтрокаПериода.Дата) <> Неопределено;
			Если ВыводитьВОтчет Тогда
				Область 							= Макет.ПолучитьОбласть("ИтогПоОбъекту|Месяц");
				Область.Параметры.Стоимость 		= СтрокаПериода.Стоимость;
				Область.Параметры.СтоимостьСНачала 	= СтоимостьСНачала;
				ТабДок.Присоединить(Область);
				ВыводитьГод = Истина;
			КонецЕсли;
		КонецЦикла;
		Область 							= Макет.ПолучитьОбласть("ИтогПоОбъекту|Год");
		Область.Параметры.СтоимостьЗаГод 	= СтоимостьЗаГод;
		ТабДок.Присоединить(Область);
		
		Если мВыводитьОстатки Тогда
			Область 					= Макет.ПолучитьОбласть("ИтогПоОбъекту|Остатки");
			Область.Параметры.Стоимость = ИтогСтоимость - СтоимостьСНачала;
			ТабДок.Присоединить(Область);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСтрокуТаблицыСоответствия(ТаблицаСоответствия,ГруппаОС,ОС,СводнаяСмета,ОбъектнаяСмета,ЛокальнаяСмета,НомерПП)
	
	НоваяСтрока 				= ТаблицаСоответствия.Добавить();
	НоваяСтрока.ГруппаОС		= ГруппаОС;	
	НоваяСтрока.ОС				= ОС;
	НоваяСтрока.СводнаяСмета	= СводнаяСмета;
	НоваяСтрока.ОбъектнаяСмета	= ОбъектнаяСмета;
	НоваяСтрока.ЛокальнаяСмета	= ЛокальнаяСмета;
	НоваяСтрока.ДатаЛС			= ЛокальнаяСмета.Дата;
	НоваяСтрока.НомерПП			= НомерПП;
	
КонецПроцедуры

Функция ПолучитьСметыПоОбъекту(СписокОбъектов)
	
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СМ_ЛокальнаяСмета.Ссылка КАК Смета,
	|	СМ_ЛокальнаяСмета.Стройка.Родитель КАК ГруппаОбъекта,
	|	СМ_ЛокальнаяСмета.Стройка КАК ОбъектСтроительства
	|ИЗ
	|	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	|ГДЕ
	|	СМ_ЛокальнаяСмета.Проведен = ИСТИНА И
	|	(СМ_ЛокальнаяСмета.ИДРодителя = ЗНАЧЕНИЕ(Документ.СМ_СводнаяСмета.ПустаяСсылка) ИЛИ
	|	 СМ_ЛокальнаяСмета.ИДРодителя = ЗНАЧЕНИЕ(Документ.СМ_ОбъектнаяСмета.ПустаяСсылка) ИЛИ
	|	 СМ_ЛокальнаяСмета.ИДРодителя = НЕОПРЕДЕЛЕНО) 
	|	И СМ_ЛокальнаяСмета.Стройка В ИЕРАРХИИ(&Стройка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СМ_ОбъектнаяСмета.Ссылка,
	|	СМ_ОбъектнаяСмета.Стройка.Родитель КАК ГруппаОбъекта,
	|	СМ_ОбъектнаяСмета.Стройка КАК ОбъектСтроительства
	|ИЗ
	|	Документ.СМ_ОбъектнаяСмета КАК СМ_ОбъектнаяСмета
	|ГДЕ
	|	СМ_ОбъектнаяСмета.Проведен = ИСТИНА И
	|	(СМ_ОбъектнаяСмета.ИДРодителя = ЗНАЧЕНИЕ(Документ.СМ_СводнаяСмета.ПустаяСсылка) ИЛИ
	|	 СМ_ОбъектнаяСмета.ИДРодителя = НЕОПРЕДЕЛЕНО)
	|	И СМ_ОбъектнаяСмета.Стройка В ИЕРАРХИИ(&Стройка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СМ_СводнаяСмета.Ссылка,
	|	СМ_СводнаяСмета.Стройка.Родитель КАК ГруппаОбъекта,
	|	СМ_СводнаяСмета.Стройка КАК ОбъектСтроительства
	|ИЗ
	|	Документ.СМ_СводнаяСмета КАК СМ_СводнаяСмета
	|ГДЕ
	|	СМ_СводнаяСмета.Проведен = ИСТИНА
	|	И СМ_СводнаяСмета.Стройка В ИЕРАРХИИ(&Стройка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Смета
	|ИТОГИ ПО 
	|	ГруппаОбъекта,
	|	ОбъектСтроительства";
	
	Запрос.УстановитьПараметр("Стройка", СписокОбъектов);
	
	ВыборкаГруппа = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"ГруппаОбъекта");
	Возврат ВыборкаГруппа;
	
КонецФункции

Функция ПолучитьФактПоСметам(МассивЛС)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СМ_ИтогиПоГлавам.Смета КАК Акт,
	|	СМ_ИтогиПоГлавам.Итог,
	|	Сумма(ВЫБОР КОГДА СМ_ИтогиПоГлавам.Смета.ЛокальнаяСмета.БазисныеЦены ТОГДА
	|		СМ_ИтогиПоГлавам.ПрямЗатраты
	|	ИНАЧЕ
	|		СМ_ИтогиПоГлавам.ТекПрямЗатраты
	|	КОНЕЦ) КАК ИтогСтоимость,
	|	СМ_ИтогиПоГлавам.Смета.ЛокальнаяСмета КАК ЛокальнаяСмета,
	|	ЕСТЬNULL(НАЧАЛОПЕРИОДА(СМ_ИтогиПоГлавам.Смета.ПериодОт, МЕСЯЦ), НАЧАЛОПЕРИОДА(СМ_ИтогиПоГлавам.Смета.Дата, МЕСЯЦ)) КАК МесяцАкта
	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоГлавам КАК СМ_ИтогиПоГлавам
	|ГДЕ
	|	СМ_ИтогиПоГлавам.Смета Ссылка Документ.СМ_АктВыполненныхРабот И
	|	СМ_ИтогиПоГлавам.Смета.ЛокальнаяСмета В (&МассивЛС)
	|
	|СГРУППИРОВАТЬ ПО
	|	СМ_ИтогиПоГлавам.Смета,
	|	СМ_ИтогиПоГлавам.Итог,
	|	СМ_ИтогиПоГлавам.Смета.ЛокальнаяСмета,
	|	ЕСТЬNULL(НАЧАЛОПЕРИОДА(СМ_ИтогиПоГлавам.Смета.ПериодОт, МЕСЯЦ), НАЧАЛОПЕРИОДА(СМ_ИтогиПоГлавам.Смета.Дата, МЕСЯЦ))";
		
	Запрос.УстановитьПараметр("МассивЛС",МассивЛС);
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабРезультат;
	
КонецФункции

Функция НайтиНомерПоПорядкуСметы(ТекИтог)
	
	//ТаблицаСоответствия
	НомерПП 		= 0;
	СтруктураОтбора = Новый Структура;
	Если ТипЗнч(ТекИтог) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		СтруктураОтбора.Вставить("ОбъектнаяСмета",ТекИтог);
	ИначеЕсли ТипЗнч(ТекИтог) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		СтруктураОтбора.Вставить("ЛокальнаяСмета",ТекИтог);
	КонецЕсли;	
	
	МассивСтрок = ТаблицаСоответствия.НайтиСтроки(СтруктураОтбора);	
	Если МассивСтрок.Количество() > 0 Тогда
		НомерПП = МассивСтрок[0].НомерПП;
	КонецЕсли;		
	
	Возврат НомерПП;
	
КонецФункции

Функция СобратьИтогиПоСметам(СписокОС,СписокСС)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ИтогиПоГлавамСС.Итог КАК Итог,
	|	ИтогиПоГлавамСС.Смета КАК Смета,
	|	ИтогиПоГлавамСС.Глава КАК Глава,
	|	ИтогиПоГлавамСС.Глава.НомерГлавы КАК НомерГлавы,	
	|	ИтогиПоГлавамСС.Итог.ГлаваССРС КАК ГлаваССРС,
	|	ИтогиПоГлавамСС.Итог.ГлаваССРС.НомерГлавы КАК НомерГлавыССРС,	
	|	ИтогиПоГлавамСС.Итог.ГлаваССРС.ПорядковыйНомер КАК ПорНомерГлавыССРС,	
	|	ВЫБОР КОГДА ИтогиПоГлавамСС.Итог Ссылка Справочник.СМ_ЛимитированныеЗатраты ТОГДА
	|		ИтогиПоГлавамСС.Итог.КИтогу.ПорядковыйНомер
	|	ИНАЧЕ
	|		ИтогиПоГлавамСС.Итог.ПорядковыйНомер  	
	|	КОНЕЦ КАК ПорядковыйНомерИтога,
	|	СУММА(ИтогиПоГлавамСС.ТекПрямЗатраты) КАК ТекПрямЗатраты,
	|	СУММА(ИтогиПоГлавамСС.ПрямЗатраты) КАК ПрямЗатраты
	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоГлавамСС КАК ИтогиПоГлавамСС
	|ГДЕ
	|	ИтогиПоГлавамСС.Смета В (&СписокСС)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИтогиПоГлавамСС.Итог,
	|	ИтогиПоГлавамСС.Смета,
	|	ИтогиПоГлавамСС.Глава,
	|	ИтогиПоГлавамСС.Глава.НомерГлавы,
	|	ИтогиПоГлавамСС.Итог.ГлаваССРС,
	|	ИтогиПоГлавамСС.Итог.ГлаваССРС.НомерГлавы,
	|	ИтогиПоГлавамСС.Итог.ГлаваССРС.ПорядковыйНомер,
	|	ВЫБОР КОГДА ИтогиПоГлавамСС.Итог Ссылка Справочник.СМ_ЛимитированныеЗатраты ТОГДА
	|		ИтогиПоГлавамСС.Итог.КИтогу.ПорядковыйНомер
	|	ИНАЧЕ 
	|		ИтогиПоГлавамСС.Итог.ПорядковыйНомер
 	|	КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИтогиПоГлавамОС.Итог КАК Итог,
	|	ИтогиПоГлавамОС.Смета КАК Смета,
	|	ИтогиПоГлавамОС.Глава КАК Глава,
	|	ИтогиПоГлавамОС.Глава.НомерГлавы КАК НомерГлавы,
	|	ИтогиПоГлавамОС.Итог.ГлаваССРС КАК ГлаваССРС,
	|	ИтогиПоГлавамОС.Итог.ГлаваССРС.НомерГлавы КАК НомерГлавыССРС,
	|	ИтогиПоГлавамОС.Итог.ГлаваССРС.ПорядковыйНомер КАК ПорНомерГлавыССРС,	
	|	ВЫБОР КОГДА ИтогиПоГлавамОС.Итог Ссылка Справочник.СМ_ЛимитированныеЗатраты ТОГДА
	|		ИтогиПоГлавамОС.Итог.КИтогу.ПорядковыйНомер
	|	ИНАЧЕ
	|		ИтогиПоГлавамОС.Итог.ПорядковыйНомер 	
	|	КОНЕЦ КАК ПорядковыйНомерИтога,
	|	СУММА(ИтогиПоГлавамОС.ТекПрямЗатраты) КАК ТекПрямЗатраты,
	|	СУММА(ИтогиПоГлавамОС.ПрямЗатраты) КАК ПрямЗатраты
	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоГлавамОС КАК ИтогиПоГлавамОС
	|ГДЕ
	|	ИтогиПоГлавамОС.Смета В (&СписокОС)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИтогиПоГлавамОС.Итог,
	|	ИтогиПоГлавамОС.Смета,
	|	ИтогиПоГлавамОС.Глава,
	|	ИтогиПоГлавамОС.Глава.НомерГлавы,
	|	ИтогиПоГлавамОС.Итог.ГлаваССРС,
	|	ИтогиПоГлавамОС.Итог.ГлаваССРС.НомерГлавы,
	|	ИтогиПоГлавамОС.Итог.ГлаваССРС.ПорядковыйНомер,
	|	ВЫБОР КОГДА ИтогиПоГлавамОС.Итог Ссылка Справочник.СМ_ЛимитированныеЗатраты ТОГДА
	|		ИтогиПоГлавамОС.Итог.КИтогу.ПорядковыйНомер
	|	ИНАЧЕ 
	|		ИтогиПоГлавамОС.Итог.ПорядковыйНомер
 	|	КОНЕЦ
	|";
	
	Запрос.УстановитьПараметр("СписокОС",СписокОС);
	Запрос.УстановитьПараметр("СписокСС",СписокСС);

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	РезультатЗапроса.Сортировать("Смета,ПорядковыйНомерИтога");
	РезультатЗапроса.Свернуть("Итог,Смета,ПорядковыйНомерИтога","ПрямЗатраты,ТекПрямЗатраты");
	РезультатЗапроса.Колонки.Добавить("СортировкаИтогов",Новый ОписаниеТипов("Число"));
	Для Каждого СтрокаИтога Из РезультатЗапроса Цикл
		Если ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
			СтрокаИтога.СортировкаИтогов = 2000 + СтрокаИтога.Итог.НомерПоПорядку;
		ИначеЕсли ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			СтрокаИтога.СортировкаИтогов = 1001 + НайтиНомерПоПорядкуСметы(СтрокаИтога.Итог);
		ИначеЕсли ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
			СтрокаИтога.СортировкаИтогов = 1002 + НайтиНомерПоПорядкуСметы(СтрокаИтога.Итог);
		Иначе
			СтрокаИтога.СортировкаИтогов = 3000 + СтрокаИтога.Итог.ПорядковыйНомер;
		КонецЕсли;	
	КонецЦикла;	
	
	РезультатЗапроса.Сортировать("Смета,ПорядковыйНомерИтога,СортировкаИтогов");
	
	Возврат РезультатЗапроса;
	
КонецФункции

Процедура ЗаполнитьНомераРазделов(ДеревоЗначений,ТабНумерацииРазделов)
	
	Для Каждого ТекСтрока Из ДеревоЗначений.Строки Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Раздел) Тогда
			Если НЕ ЗначениеЗаполнено(ТекСтрока.ПорНомерРаздела) Тогда
				НайденнаяСтрока = ТабНумерацииРазделов.Найти(ТекСтрока.Раздел,"Документ");
				Если НайденнаяСтрока <> Неопределено Тогда
					ТекСтрока.ПорНомерРаздела = НайденнаяСтрока.НомерВДереве;				
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ЗаполнитьНомераРазделов(ТекСтрока,ТабНумерацииРазделов);	
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНомераРазделов(СписокСмет)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР КОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел <> ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка) ТОГДА 
	|		СМ_НумерацияПозицийЛокальныхСмет.Раздел 
	|	КОНЕЦ КАК Документ,
	|	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве КАК НомерВДереве,
	|	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы КАК НомерВПределахСметы,
	|	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер КАК ПорНомер
	|ИЗ
	|	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	|ГДЕ 
	|	ВЫБОР КОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел <> ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка) ТОГДА 
	|		СМ_НумерацияПозицийЛокальныхСмет.Раздел.ИДСметы
	|	КОНЕЦ В (&СписокСмет) И
	|   СМ_НумерацияПозицийЛокальныхСмет.Позиция = Значение(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)";
	                         	
	Запрос.УстановитьПараметр("СписокСмет",СписокСмет);
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	ТабРезультат.Свернуть("Документ,НомерВДереве,НомерВПределахСметы,ПорНомер");

	Возврат ТабРезультат;
	
КонецФункции

#КонецОбласти

