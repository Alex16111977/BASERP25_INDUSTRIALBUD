
#Область ОбработчикиСобытий

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ГлобальнаяСтрокаДереваСмет = Неопределено И Не ГлобальнаяСтрокаДереваСмет.ПометкаУдаления Тогда
		Смета = ГлобальнаяСтрокаДереваСмет.Ссылка;
	КонецЕсли;

	Период.Вариант = ВариантСтандартногоПериода.ЭтотМесяц;
	ВключатьВОтчет = 1;
	
	Если Не ЗначениеЗаполнено(КлючОбъектСмета) Тогда
		КлючОбъектСмета = "ПоСметам";
		Если Не ГлобальнаяСтрокаДереваСмет = Неопределено И Не ГлобальнаяСтрокаДереваСмет.ПометкаУдаления Тогда
			Смета 				= ГлобальнаяСтрокаДереваСмет.Ссылка;
			ОбъектСтроительства = ГлобальнаяСтрокаДереваСмет.Стройка;
		КонецЕсли;
	КонецЕсли;
	ВидимостьЭлементов();
	Элементы.ПолеВидаСравнения.СписокВыбора.Добавить(ВидСравнения.Равно);
	Элементы.ПолеВидаСравнения.СписокВыбора.Добавить(ВидСравнения.ВСписке);
	ПолеВидаСравнения = ВидСравнения.Равно;

	ВключатьВОтчетПриИзменении();
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СметаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка 			= Ложь;
	ОписаниеОЗакрытииФормыВыбораЛС 	= Новый ОписаниеОповещения("ПриЗакрытииФормыПодбораЛС",ЭтаФорма);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ВключатьОС",Истина);
	СтруктураПараметров.Вставить("ВключатьСС",Истина);
	СтруктураПараметров.Вставить("БезПомеченных",Истина);
	СтруктураПараметров.Вставить("ОтборСтройка",Истина);

	ОткрытьФорму("Обработка.СМ_ДеревоСметПростое.Форма.ФормаУпр",СтруктураПараметров,ЭтаФорма,,,,ОписаниеОЗакрытииФормыВыбораЛС,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВключатьВОтчетПриИзменении()
	
	Если ВключатьВОтчет = 4 Тогда
		Элементы.Период.Видимость = Истина;	
	Иначе
		Элементы.Период.Видимость = Ложь;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КлючОбъектСметаПриИзменении(Элемент)
	
	ВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеВидаСравненияПриИзменении(Элемент)
	
	Если ПолеВидаСравнения = ВидСравнения.ВСписке Тогда
		Стройка 			= ОбъектСтроительства;
		ОбъектСтроительства = Новый СписокЗначений;
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.СМ_ОбъектыСтроительства"));
		
		ДопустимыеТипы = Новый ОписаниеТипов(МассивТипов);

		ОбъектСтроительства.ТипЗначения = ДопустимыеТипы;
		ОбъектСтроительства.Добавить(Стройка);
	Иначе
		СписокСтроек = ОбъектСтроительства;
		ОбъектСтроительства = ?(СписокСтроек.Количество()=0,ПредопределенноеЗначение("Справочник.СМ_ОбъектыСтроительства.ПустаяСсылка"),СписокСтроек[0].Значение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.Период) И ВключатьВОтчет = 4 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не заполнен период отчета!'"));
		Возврат;
	КонецЕсли;
	
	СформироватьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВидимостьЭлементов()
	
	Элементы.ОбъектСтроительства.Видимость	= КлючОбъектСмета = "ПоОбъектам";
	Элементы.ПолеВидаСравнения.Видимость	= КлючОбъектСмета = "ПоОбъектам";
	Элементы.Смета.Видимость				= КлючОбъектСмета <> "ПоОбъектам";
	
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	
	Результат.Очистить();
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	Если КлючОбъектСмета = "ПоОбъектам" Тогда
		ОтчетОбъект.ПолучитьЗаполненныйОтчет(ЭтаФорма.ОбъектСтроительства,Результат,Период.ДатаНачала,НачалоМесяца(Период.ДатаОкончания),ВключатьВОтчет,ВыводитьТитульныйЛист,ВыводитьОстатки,ВыводитьИтоги,УчитыватьКорректировки);
	ИначеЕсли КлючОбъектСмета = "ПоСметам" Тогда
		
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.Смета) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не заполнена смета!'"));
			Возврат;
		КонецЕсли;
		
		Если НЕ ЭтаФорма.Смета.Проведен Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Смета не проведена!'"));
			Возврат;
		КонецЕсли;
	
		Если ЭтаФорма.Смета.ПометкаУдаления Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Смета помечена на удаление!'"));
			Возврат;
		КонецЕсли;
		
		ОтчетОбъект.ПолучитьЗаполненныйОтчет(Смета,Результат,Период.ДатаНачала,НачалоМесяца(Период.ДатаОкончания),ВключатьВОтчет,ВыводитьТитульныйЛист,ВыводитьОстатки,ВыводитьИтоги,УчитыватьКорректировки);		
		
	КонецЕсли;
	
	Результат.АвтоМасштаб 			= Истина;
	Результат.ОриентацияСтраницы 	= ОриентацияСтраницы.Ландшафт;
	Результат.ОтображатьСетку 		= Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыПодбораЛС(ТекЛС,ТекПараметр) Экспорт
	
	Если ТекЛС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Смета = ТекЛС;
	
	Если ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") ИЛИ
		 ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		 Элементы.УчитыватьКорректировки.Доступность = Ложь;
		 ЭтаФорма.УчитыватьКорректировки = Ложь;
	Иначе	 
		 Элементы.УчитыватьКорректировки.Доступность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Отчет.ВыводитьМашины 		= Истина;
	Отчет.ВыводитьМатериалы    	= Истина;
	Отчет.ВыводитьТрудозатраты 	= Истина;
КонецПроцедуры

#КонецОбласти

