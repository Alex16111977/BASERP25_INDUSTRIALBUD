
#Область ОбработчикиСобытий

&НаСервере
Процедура СформироватьНаСервере(ФактическиеРесурсы,ГруппироватьСтатусы = Ложь)
	
	Если Смета.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;

	Результат.Очистить();
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	Если (КлючОбъектСмета = "ПоОбъектам") Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("Пометка", Истина);
		МассивСмет = ТаблицаСмет.Выгрузить(Отбор, "Смета").ВыгрузитьКолонку("Смета");
		Стройка = ОбъектСтроительства;
	Иначе
		МассивСмет = Новый Массив;
		МассивСмет.Добавить(Смета);
		Стройка = Неопределено;
	КонецЕсли;
	ОтчетОбъект.ПолучитьЗаполненныйОтчет(МассивСмет, Стройка, Результат, ФактическиеРесурсы, Ранжировать, ПечатьБланка, НаОстаток,ГруппироватьСтатусы, ?(ИспользованиеСтатусРесурса, СтатусРесурса, Неопределено));
	
	ПечУровень = Результат.КоличествоУровнейГруппировокСтрок(); 
	Результат.ПоказатьУровеньГруппировокСтрок(ПечУровень-2);
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	СформироватьНаСервере(ФактическиеРесурсы,ГруппироватьСтатусы);
	Элементы.ГруппаСтраницыОтчета.ТекущаяСтраница = Элементы.ГруппаСтраницыОтчета.ПодчиненныеЭлементы.ГруппаРезультат;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Не ЗначениеЗаполнено(КлючОбъектСмета) Тогда
		КлючОбъектСмета = "ПоСметам";
		Если Не ГлобальнаяСтрокаДереваСмет = Неопределено И Не ГлобальнаяСтрокаДереваСмет.ПометкаУдаления Тогда
			Смета = ГлобальнаяСтрокаДереваСмет.Ссылка;
			ОбъектСтроительства = ГлобальнаяСтрокаДереваСмет.Стройка;
		КонецЕсли;
	КонецЕсли;
	ВидимостьЭлементов();
	Элементы.ПолеВидаСравнения.СписокВыбора.Добавить(ВидСравнения.Равно);
	Элементы.ПолеВидаСравнения.СписокВыбора.Добавить(ВидСравнения.ВСписке);
	ПолеВидаСравнения = ВидСравнения.Равно;
	// РанжироватьПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СметаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка 			= Ложь;
	ОписаниеОЗакрытииФормыВыбораЛС 	= Новый ОписаниеОповещения("ПриЗакрытииФормыПодбораЛС",ЭтаФорма);
	СтруктураПараметров 			= Новый Структура;
	СтруктураПараметров.Вставить("ВключатьОС",Истина);
	СтруктураПараметров.Вставить("ВключатьСС",Истина);
	СтруктураПараметров.Вставить("БезПомеченных",Истина);
	СтруктураПараметров.Вставить("ОтборСтройка",Истина);
	
	ОткрытьФорму("Обработка.СМ_ДеревоСметПростое.Форма.ФормаУпр",СтруктураПараметров,ЭтаФорма,,,,ОписаниеОЗакрытииФормыВыбораЛС,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыПодбораЛС(ТекЛС,ТекПараметр) Экспорт
	Если ТекЛС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Смета = ТекЛС;
КонецПроцедуры

&НаКлиенте
Процедура КлючТекущегоВариантаПриИзменении(Элемент)
	ВидимостьЭлементов();
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеПроцедурыИФункции

&НаКлиенте
Процедура ВидимостьЭлементов()
	
	Элементы.Объект.Видимость		= КлючОбъектСмета = "ПоОбъектам";
	Элементы.ПолеВидаСравнения.Видимость		= КлючОбъектСмета = "ПоОбъектам";
	Элементы.ТаблицаСмет.Видимость	= Элементы.Объект.Видимость;
	Элементы.Смета.Видимость		= КлючОбъектСмета <> "ПоОбъектам";
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектПриИзменении(Элемент)
	ОбъектПриИзмененииНаСервере();
	Элементы.ГруппаСтраницыОтчета.ТекущаяСтраница = Элементы.ГруппаСтраницыОтчета.ПодчиненныеЭлементы.ГруппаСметы;
КонецПроцедуры

&НаСервере
Процедура ОбъектПриИзмененииНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_ЛокальнаяСмета.Ссылка КАК Смета,
	               |	ИСТИНА КАК Пометка
	               |ИЗ
	               |	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	               |ГДЕ
	               |	СМ_ЛокальнаяСмета.Проведен = ИСТИНА
	               |	И (СМ_ЛокальнаяСмета.ИДРодителя = ЗНАЧЕНИЕ(Документ.СМ_СводнаяСмета.ПустаяСсылка)
	               |			ИЛИ СМ_ЛокальнаяСмета.ИДРодителя = ЗНАЧЕНИЕ(Документ.СМ_ОбъектнаяСмета.ПустаяСсылка)
	               |			ИЛИ СМ_ЛокальнаяСмета.ИДРодителя = НЕОПРЕДЕЛЕНО)
	               |	И СМ_ЛокальнаяСмета.Стройка В ИЕРАРХИИ(&Стройка)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СМ_ОбъектнаяСмета.Ссылка,
	               |	ИСТИНА
	               |ИЗ
	               |	Документ.СМ_ОбъектнаяСмета КАК СМ_ОбъектнаяСмета
	               |ГДЕ
	               |	СМ_ОбъектнаяСмета.Проведен = ИСТИНА
	               |	И (СМ_ОбъектнаяСмета.ИДРодителя = ЗНАЧЕНИЕ(Документ.СМ_СводнаяСмета.ПустаяСсылка)
	               |			ИЛИ СМ_ОбъектнаяСмета.ИДРодителя = НЕОПРЕДЕЛЕНО)
	               |	И СМ_ОбъектнаяСмета.Стройка В ИЕРАРХИИ(&Стройка)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СМ_СводнаяСмета.Ссылка,
	               |	ИСТИНА
	               |ИЗ
	               |	Документ.СМ_СводнаяСмета КАК СМ_СводнаяСмета
	               |ГДЕ
	               |	СМ_СводнаяСмета.Проведен = ИСТИНА
	               |	И СМ_СводнаяСмета.Стройка В ИЕРАРХИИ(&Стройка)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Смета";
	Запрос.УстановитьПараметр("Стройка", ОбъектСтроительства);
	ТаблицаСмет.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ПараметрыЗаполнения") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры.ПараметрыЗаполнения);
		ОбъектПриИзмененииНаСервере();
	КонецЕсли;
	
	// СформироватьПользовательскиеНастройкиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура РанжироватьПриИзменении(Элемент)
	РанжироватьПриИзмененииНаСервере(ГруппироватьСтатусы);
КонецПроцедуры

