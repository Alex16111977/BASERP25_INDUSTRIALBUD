&НаКлиенте
Процедура РезультатОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	// ИдентификаторРасшифровкиКомпоновкиДанных
	// Сообщить(ДанныеРасшифровки[Расшифровка]);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='" + ДанныеРасшифровки[Расшифровка] + "'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеВидаСравненияПриИзменении(Элемент)
	Если ПолеВидаСравнения = ВидСравнения.ВСписке Тогда
		Стройка = ОбъектСтроительства;
		ОбъектСтроительства = Новый СписокЗначений;
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.СМ_ОбъектыСтроительства"));
		
		ДопустимыеТипы = Новый ОписаниеТипов(МассивТипов);

		ОбъектСтроительства.ТипЗначения = ДопустимыеТипы;
		ОбъектСтроительства.Добавить(Стройка);
	Иначе
		СписокСтроек = ОбъектСтроительства;
		ОбъектСтроительства = ?(СписокСтроек.Количество()=0,ПредопределенноеЗначение("Справочник.СМ_ОбъектыСтроительства.ПустаяСсылка"),СписокСтроек[0].Значение);
	КонецЕсли;
	ОбъектПриИзмененииНаСервере();
	Элементы.ГруппаСтраницыОтчета.ТекущаяСтраница = Элементы.ГруппаСтраницыОтчета.ПодчиненныеЭлементы.ГруппаСметы;
КонецПроцедуры

&НаКлиенте
Процедура ГруппироватьСтатусыПриИзменении(Элемент)
	РанжироватьПриИзмененииНаСервере(ГруппироватьСтатусы);
КонецПроцедуры

#КонецОбласти
