;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	УСОERP_ПланыПотребностейВМатериалах.Склад КАК Склад,
	УСОERP_ПланыПотребностейВМатериалах.Работа КАК Работа,
	УСОERP_ПланыПотребностейВМатериалах.Номенклатура КАК Номенклатура,
	УСОERP_ПланыПотребностейВМатериалах.Характеристика КАК Характеристика,
	УСОERP_ПланыПотребностейВМатериалах.ВидПланаПотребности КАК ВидПланаПотребности,
	УСОERP_ПланыПотребностейВМатериалах.ДатаПлана КАК ДатаПлана,
	УСОERP_ПланыПотребностейВМатериалах.Количество КАК Количество,
	УСОERP_ПланыПотребностейВМатериалах.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	ВЫБОР
		КОГДА &amp;Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.День)
			ТОГДА НАЧАЛОПЕРИОДА(УСОERP_ПланыПотребностейВМатериалах.ДатаПлана, ДЕНЬ)
		КОГДА &amp;Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
			ТОГДА НАЧАЛОПЕРИОДА(УСОERP_ПланыПотребностейВМатериалах.ДатаПлана, НЕДЕЛЯ)
		КОГДА &amp;Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
			ТОГДА НАЧАЛОПЕРИОДА(УСОERP_ПланыПотребностейВМатериалах.ДатаПлана, МЕСЯЦ)
		КОГДА &amp;Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
			ТОГДА НАЧАЛОПЕРИОДА(УСОERP_ПланыПотребностейВМатериалах.ДатаПлана, ГОД)
	КОНЕЦ КАК ПериодДанных,
	ВЫБОР
		КОГДА &amp;Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.День)
			ТОГДА КОНЕЦПЕРИОДА(УСОERP_ПланыПотребностейВМатериалах.ДатаПлана, ДЕНЬ)
		КОГДА &amp;Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
			ТОГДА КОНЕЦПЕРИОДА(УСОERP_ПланыПотребностейВМатериалах.ДатаПлана, НЕДЕЛЯ)
		КОГДА &amp;Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
			ТОГДА КОНЕЦПЕРИОДА(УСОERP_ПланыПотребностейВМатериалах.ДатаПлана, МЕСЯЦ)
		КОГДА &amp;Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
			ТОГДА КОНЕЦПЕРИОДА(УСОERP_ПланыПотребностейВМатериалах.ДатаПлана, ГОД)
	КОНЕЦ КАК ПериодДанныхКонец
ПОМЕСТИТЬ ВТ_ПланПотребностей
ИЗ
	РегистрСведений.УСОERP_ПланыПотребностейВМатериалах КАК УСОERP_ПланыПотребностейВМатериалах
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_ПланПотребностей.Склад КАК Склад,
	ВТ_ПланПотребностей.Работа КАК Работа,
	ВТ_ПланПотребностей.Номенклатура КАК Номенклатура,
	ВТ_ПланПотребностей.Характеристика КАК Характеристика,
	ВТ_ПланПотребностей.ВидПланаПотребности КАК ВидПланаПотребности,
	ВТ_ПланПотребностей.ДатаПлана КАК ДатаПлана,
	ВТ_ПланПотребностей.Количество КАК Количество,
	ВТ_ПланПотребностей.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	ВТ_ПланПотребностей.Склад.УСОERP_ОбъектСтроительства КАК СкладУСОERP_ОбъектСтроительства,
	ВТ_ПотребностьВМатериалах.КоличествоНаОбъемРаботы КАК КоличествоНаОбъемРаботы,
	ВТ_ПланОбщий.Количество КАК КоличествоПлан,
	ВТ_ПланПотребностей.ПериодДанных КАК ПериодДанных,
	ВТ_ПланПотребностей.ПериодДанныхКонец КАК ПериодДанныхКонец,
	ВТ_ПланПотребностей.Работа.КодСДР КАК РаботаКодСДР,
	ВТ_ПланПотребностей.Работа.НомерРаботыВУровне
ИЗ
	ВТ_ПланПотребностей КАК ВТ_ПланПотребностей
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПотребностьВМатериалах КАК ВТ_ПотребностьВМатериалах
		ПО (ВТ_ПланПотребностей.Работа = ВТ_ПотребностьВМатериалах.Работа)
			И (ВТ_ПланПотребностей.Номенклатура = ВТ_ПотребностьВМатериалах.Номенклатура)
			И (ВТ_ПланПотребностей.Характеристика = ВТ_ПотребностьВМатериалах.Характеристика)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПланОбщий КАК ВТ_ПланОбщий
		ПО (ВТ_ПланПотребностей.Работа = ВТ_ПланОбщий.Работа)
			И (ВТ_ПланПотребностей.Номенклатура = ВТ_ПланОбщий.Номенклатура)
			И (ВТ_ПланПотребностей.Характеристика = ВТ_ПланОбщий.Характеристика)
			И (ВТ_ПланПотребностей.Склад = ВТ_ПланОбщий.Склад)
ГДЕ
	ВТ_ПланПотребностей.ПериодДанных МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода</query>
