	ТаблицаРабот =  ПакетЗапросов[4].Выгрузить();
	
	ТаблицаНоменклатуры = ПакетЗапросов[6].Выгрузить(); 
	
	ТаблицаРабот.Колонки.Добавить("ОбъемЗаПериод_План",Новый ОписаниеТипов("Число"));
	ТаблицаРабот.Колонки.Добавить("СуммаЗаПериод_План",Новый ОписаниеТипов("Число"));
	
	СтруктураОтбора = Новый Структура("Работа",Справочники.УСОERP_СтроительныеРаботы.ПустаяСсылка()); 	
	
	Для Каждого СтрокаРабот ИЗ ТаблицаРабот Цикл
		
		ТабГрафик = ТабГрафиков.Скопировать(Новый Структура("ГрафикРаботы",СтрокаРабот.ГрафикРаботы));
		
