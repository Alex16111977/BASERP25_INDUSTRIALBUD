		СтрокаРабот.ОбъемЗаПериод_План = 0;
		СтрокаРабот.СуммаЗаПериод_План = 0;		
		
		Если СтрокаРабот.ДатаНачала >=ДатаНачала И СтрокаРабот.ДатаОкончания <= ДатаОкончания Тогда
			
			СтрокаРабот.ОбъемЗаПериод_План = СтрокаРабот.ОбъемРаботы;
			СтрокаРабот.СуммаЗаПериод_План = СтрокаРабот.СуммаПлан;		
			
		Иначе
			
			СтрокаНачала = ТабГрафик.Найти(НачалоДня(СтрокаРабот.ДатаНачала),"ДатаГрафика");
			СтрокаОкончания = ТабГрафик.Найти(НачалоДня(СтрокаРабот.ДатаОкончания),"ДатаГрафика");
			
			Если СтрокаНачала = Неопределено ИЛИ СтрокаОкончания = Неопределено Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Даты работы "+СтрокаРабот.Работа+" ("+СтрокаРабот.Работа.КодСДР+") не совпадают с данными графика, строка пропущена");
				
				Продолжить;
				
			КонецЕсли;  			
			
			Если СтрокаРабот.ДатаНачала = СтрокаНачала.ДатаНачала И СтрокаРабот.ДатаОкончания = СтрокаОкончания.ДатаОкончания Тогда 
				//все ок, делим по дням
				
				КоличествоДней = СтрокаОкончания.Задержка - СтрокаНачала.Задержка+1;
				КоличествоВДень = СтрокаРабот.ОбъемРаботы/КоличествоДней;
				
				ТекДатаНачала = Макс(НачалоДня(СтрокаРабот.ДатаНачала),НачалоДня(ДатаНачала));
				ТекДатаОкончания = Мин(НачалоДня(ДатаОкончания),НачалоДня(СтрокаРабот.ДатаОкончания)); 				
				
				Пока Истина Цикл
					
					Если ТекДатаНачала > ТекДатаОкончания Тогда
						Прервать;
					КонецЕсли;
					
					СтрокаГрафика = ТабГрафик.Найти(ТекДатаНачала,"ДатаГрафика");
					
					Если СтрокаГрафика <> Неопределено Тогда
						
						СтрокаРабот.ОбъемЗаПериод_План = СтрокаРабот.ОбъемЗаПериод_План+КоличествоВДень;
						
					КонецЕсли; 				
					
					ТекДатаНачала = ТекДатаНачала+24*60*60; 					
					
				КонецЦикла;				
				
			Иначе
				
				//все плохо, делим по секундам
				
				СекундВРаботе = 0;
				СекундВПериоде = 0; 				
				
				ТекДатаНачала = НачалоДня(СтрокаРабот.ДатаНачала);
				ТекДатаОкончания = НачалоДня(СтрокаРабот.ДатаОкончания);
				
				Пока Истина Цикл
					
					Если ТекДатаНачала > ТекДатаОкончания Тогда					
						Прервать;
					КонецЕсли;
					
					СтрокаГрафика = ТабГрафик.Найти(ТекДатаНачала,"ДатаГрафика");
					
					Если СтрокаГрафика <> Неопределено Тогда
						
						ТекСекунд =  (МИН(СтрокаРабот.ДатаОкончания,СтрокаГрафика.ДатаОкончания)-Макс(СтрокаРабот.ДатаНачала,СтрокаГрафика.ДатаНачала));
						
						СекундВРаботе = СекундВРаботе+ТекСекунд;
						
						Если СтрокаГрафика.ДатаНачала >= ДатаНачала И СтрокаГрафика.ДатаОкончания <=ДатаОкончания Тогда
							СекундВПериоде = СекундВПериоде+ТекСекунд;	
						КонецЕсли;
						
					КонецЕсли; 					
					
					ТекДатаНачала = ТекДатаНачала+24*60*60;
					
				КонецЦикла;  				
				
				СтрокаРабот.ОбъемЗаПериод_План = СтрокаРабот.ОбъемРаботы*СекундВПериоде/СекундВРаботе;
				
			КонецЕсли;
			
			СтрокаРабот.СуммаЗаПериод_План = СтрокаРабот.ОбъемЗаПериод_План*?(СтрокаРабот.СуммаПлан = null,0,СтрокаРабот.СуммаПлан)/СтрокаРабот.ОбъемРаботы; 
			
		КонецЕсли;		
		
		Строки = ТаблицаРаботКонструктивов.НайтиСтроки(СтруктураОтбора);
		
		Для Каждого НайденнаяСтрока ИЗ Строки Цикл
			
			Коэффициент = 1/СтрокаРабот.КоличествоКонструктивов;
			Коэффициент = ?(СтрокаРабот.ОбъемКонструктивов = 0,0,НайденнаяСтрока.ОбъемКонструктива/СтрокаРабот.ОбъемКонструктивов); 
			
			Если  СтрокаРабот.ОбъемЗаПериод_План*Коэффициент <> 0 +  СтрокаРабот.ОбъемФакт*Коэффициент <> 0 +СтрокаРабот.СуммаЗаПериод_План*Коэффициент <> 0 +СтрокаРабот.СтоимостьФакт*Коэффициент <> 0 Тогда
				
				Нстр = ТаблицаРезультат.Добавить();
				ЗаполнитьЗначенияСвойств(Нстр,НайденнаяСтрока);
				Нстр.ОбъемПлан = СтрокаРабот.ОбъемЗаПериод_План*Коэффициент;
				Нстр.ОбъемФакт = СтрокаРабот.ОбъемФакт*Коэффициент;		
				Нстр.СуммаПлан = СтрокаРабот.СуммаЗаПериод_План*Коэффициент;
				Нстр.СуммаФакт = СтрокаРабот.СтоимостьФакт*Коэффициент; 
				Нстр.ПроцентВыполнения = ?(Нстр.ОбъемПлан = 0,100,Нстр.ОбъемФакт*100/Нстр.ОбъемПлан);
				Нстр.Перевыполнение = Нстр.СуммаФакт-Нстр.СуммаПлан;
				Нстр.ДатаОкончанияПлан = СтрокаРабот.ДатаОкончания;
				Нстр.ДатаОкончанияФакт = СтрокаРабот.ДатаОкончанияФакт;
				
				СтрокиДобавленныеКонструктив = ТаблицаКонструктивов.НайтиСтроки(Новый Структура("Конструктив", Нстр.Конструктив));
				Если СтрокиДобавленныеКонструктив.Количество() Тогда
					СтрокаКонструктив = СтрокиДобавленныеКонструктив[0];
				Иначе
					СтрокаКонструктив = ТаблицаКонструктивов.Добавить();
					СтрокаКонструктив.ОтклонениеВДнях = -1; 
				КонецЕсли;
				СтрокаКонструктив.Конструктив = Нстр.Конструктив;
				СтрокаКонструктив.ИдентификаторКонструктива = Нстр.Конструктив.Наименование;

				Если ЗначениеЗаполнено(Нстр.ДатаОкончанияФакт) Тогда
					
					СтрокаОкончанияПлан = ТабГрафик.Найти(НачалоДня(Нстр.ДатаОкончанияПлан),"ДатаГрафика");
					СтрокаОкончанияФакт = НайтиСтрокуГрафика(Нстр.ДатаОкончанияФакт,ТабГрафик,Нстр.ДатаОкончанияПлан);				
					Если СтрокаОкончанияПлан <> Неопределено И СтрокаОкончанияФакт <> Неопределено Тогда
						Нстр.Отставание = СтрокаОкончанияФакт.Задержка-СтрокаОкончанияПлан.Задержка;
						СтрокаКонструктив.ОтклонениеВДнях = Макс(СтрокаКонструктив.ОтклонениеВДнях, Нстр.Отставание);
					Иначе
						СтрокаКонструктив.ОтклонениеВДнях = -1;
					КонецЕсли;
					
				КонецЕсли; 
				
			КонецЕсли;
			
			СтрокиНоменклатуры = ТаблицаНоменклатуры.НайтиСтроки(Новый Структура("Работа",?(НовыйВариант,НайденнаяСтрока.Работа.РаботаИсточник,НайденнаяСтрока.Работа)));
			
			Для Каждого СтрокаНоменклатуры ИЗ СтрокиНоменклатуры Цикл
				
				Нстр = ТабНоменклатуры.Добавить();
				ЗаполнитьЗначенияСвойств(Нстр,НайденнаяСтрока);
				ЗаполнитьЗначенияСвойств(Нстр,СТрокаНоменклатуры);
				Нстр.Работа = НайденнаяСтрока.Работа;
				Нстр.КоличествоПлан = СтрокаНоменклатуры.КоличествоПлан*Коэффициент;
				Нстр.КоличествоФакт = СтрокаНоменклатуры.КоличествоФакт*Коэффициент;
				Нстр.СуммаПлан = ?(СтрокаНоменклатуры.СуммаПлан = null,0,СтрокаНоменклатуры.СуммаПлан*Коэффициент);
				Нстр.СуммаФакт = ?(СтрокаНоменклатуры.СуммаФакт = null,0,СтрокаНоменклатуры.СуммаФакт*Коэффициент);
				
			КонецЦикла;		
			
		КонецЦикла; 		
		
	КонецЦикла;	
	
КонецПроцедуры

Функция НайтиСтрокуГрафика(Дата,ТабГрафик,ДатаНачалаПлан,Вниз = Истина)
	
	СтрокаВозврата = ТабГрафик.Найти(Дата,"ДатаГрафика");
	
	Если СтрокаВозврата <> Неопределено Тогда
		
		Возврат СтрокаВозврата;
		
	КонецЕсли;
	
	ТекДата = Дата;	
	Пока Истина Цикл
		
		Если ТекДата < ДатаНачалаПлан Тогда
			
			Прервать;	
			
		КонецЕсли;
		
		СтрокаВозврата = ТабГрафик.Найти(ТекДата,"ДатаГрафика");
		
		Если СтрокаВозврата <> Неопределено Тогда
			
			Возврат СтрокаВозврата;
			Прервать;
			
		КонецЕсли;
		
		ТекДата = ТекДата-24*60*60;
		
	КонецЦикла; 
	
	Возврат Неопределено;
	
КонецФункции

ТабНоменклатуры = Новый ТаблицаЗначений;
ТабНоменклатуры.Колонки.Добавить("Конструктив",Новый ОписаниеТипов("СправочникСсылка.УСОERP_Конструктив"));
