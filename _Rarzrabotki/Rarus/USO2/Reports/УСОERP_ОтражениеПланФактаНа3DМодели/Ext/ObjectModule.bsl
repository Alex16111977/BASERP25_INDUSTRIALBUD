

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем ТабГрафиков;
Перем ТабНоменклатуры;

#Область СлужебныйПрограммныйИнтерфейс

// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
//   Форма - УправляемаяФорма - Форма отчета.
//   КлючВарианта - Строка - Имя предопределенного варианта отчета или уникальный идентификатор пользовательского.
//   Настройки - Структура - см. возвращаемое значение ОтчетыКлиентСервер.ПолучитьНастройкиОтчетаПоУмолчанию().
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.Вставить("РазрешеноМенятьВарианты", Ложь);
	Настройки.События.ПриСозданииНаСервере = Истина;
	
КонецПроцедуры

// Вызывается в обработчике одноименного события формы отчета после выполнения кода формы.
//
// Параметры:
//   Форма - УправляемаяФорма - Форма отчета.
//   Отказ - Передается из параметров обработчика "как есть".
//   СтандартнаяОбработка - Передается из параметров обработчика "как есть".
//
// См. также:
//   "УправляемаяФорма.ПриСозданииНаСервере" в синтакс-помощнике.
//
Процедура ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка) Экспорт
	
	//ЭтаФорма.РежимВариантаОтчета = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	ТабНоменклатуры.Очистить();
	
	СтандартнаяОбработка = Ложь;
	
	НастройкиОсновнойСхемы = КомпоновщикНастроек.ПолучитьНастройки();
	
	ВнешниеНаборыДанных = СформироватьВнешниеНаборыДанных(НастройкиОсновнойСхемы);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОсновнойСхемы, ДанныеРасшифровки,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));	
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);
	
	ДеревоЗначений = Новый ДеревоЗначений;
	ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений.УстановитьОбъект(ДеревоЗначений);
	ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений.Вывести(ПроцессорКомпоновкиДанных);
	
	Макет = ПолучитьМакет("Макет");
	
	ОбластьМакета = Макет.ПолучитьОбласть("ОбластьШапка");
	
	ДокументРезультат.Очистить();
	
	Дата		                = НастройкиОсновнойСхемы.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаОкончания")).Значение.Дата;
	ОбъектСтроительства         = НастройкиОсновнойСхемы.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ОбъектСтроительства")).Значение;	
	
	ДокументУтверждения = Документы.УСОERP_УтверждениеКалендарногоПланаГрафика.ПустаяСсылка();
	
	ДатаНачала = Дата('00010101');
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УСОERP_УтверждениеКалендарногоПланаГрафика.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.УСОERP_УтверждениеКалендарногоПланаГрафика КАК УСОERP_УтверждениеКалендарногоПланаГрафика
		|ГДЕ
		|	УСОERP_УтверждениеКалендарногоПланаГрафика.ОбъектСтроительства = &ОбъектСтроительства
		|	И УСОERP_УтверждениеКалендарногоПланаГрафика.Дата <= &Дата
		|
		|УПОРЯДОЧИТЬ ПО
		|	УСОERP_УтверждениеКалендарногоПланаГрафика.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ОбъектСтроительства", ОбъектСтроительства);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДокументУтверждения = Выборка.Ссылка;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УСОERP_СценарииПланированияПроектовСтроительства.НачалоСтроительства КАК НачалоСтроительства
		|ИЗ
		|	Справочник.УСОERP_СценарииПланированияПроектовСтроительства КАК УСОERP_СценарииПланированияПроектовСтроительства
		|ГДЕ
		|	УСОERP_СценарииПланированияПроектовСтроительства.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", ОбъектСтроительства);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДатаНачала = Выборка.НачалоСтроительства;
	КонецЦикла;
	
	
	КопияСценария               = ДокументУтверждения.КопияСценария;
	
	ВыполнениеРабот             = НастройкиОсновнойСхемы.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВыполнениеРабот")).Значение; 	
	ОбеспеченностьСтроительства = НастройкиОсновнойСхемы.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ОбеспеченностьСтроительства")).Значение;
	ВыводитьИтоги               = НастройкиОсновнойСхемы.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВыводитьИтоги")).Значение;
	ПрямыеЗатраты               = НастройкиОсновнойСхемы.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПрямыеЗатраты")).Значение;
	
	СписокКонструктивов         = Новый Массив;
	ОтборПоКонструктивам        = Ложь; 
	СписокРабот                 = Новый Массив; 
	ОтборПоРаботам              = Ложь;
	Для Каждого ЭлОтбора Из НастройкиОсновнойСхемы.Отбор.Элементы Цикл
		Если ЭлОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Конструктив") Тогда
			СписокКонструктивов = ЭлОтбора.ПравоеЗначение;
			ОтборПоКонструктивам = ЭлОтбора.Использование;
		ИначеЕсли ЭлОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Работа") Тогда
			СписокКонструктивов = ЭлОтбора.ПравоеЗначение;
			ОтборПоКонструктивам = ЭлОтбора.Использование;
		КонецЕсли;	
	КонецЦикла;	
	
	ОбластьМакета.Параметры.ОписаниеПериода = БухгалтерскиеОтчетыКлиентСервер.ПолучитьПредставлениеПериода(ДатаНачала,Дата);
	ОбластьМакета.Параметры.Заказчик = ДокументУтверждения.ОбъектСтроительства.Заказчик; 	
	
	ОбластьМакета.Параметры.Договор = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаОкончания", Дата);
	Запрос.УстановитьПараметр("ОбъектСтроительства",ОбъектСтроительства);
	Запрос.УстановитьПараметр("Заказчик",ДокументУтверждения.ОбъектСтроительства.Заказчик);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_ДоговорСЗаказчиком.Ссылка,
	|	УСОERP_ДоговорСЗаказчиком.Договор
	|ИЗ
	|	Документ.УСОERP_ДоговорСЗаказчиком КАК УСОERP_ДоговорСЗаказчиком
	|ГДЕ
	|	УСОERP_ДоговорСЗаказчиком.ОбъектСтроительства = &ОбъектСтроительства
	|	И УСОERP_ДоговорСЗаказчиком.Контрагент = &Заказчик
	|	И УСОERP_ДоговорСЗаказчиком.Проведен
	|	И УСОERP_ДоговорСЗаказчиком.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|	И УСОERP_ДоговорСЗаказчиком.Дата <= &ДатаОкончания
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_ДоговорСЗаказчиком.Дата УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ОбластьМакета.Параметры.Договор = Выборка.Договор;
	КонецЕсли;  	
	
	ОбластьМакета.Параметры.ОбъектСтроительства = ДокументУтверждения.ОбъектСтроительства;
	ОбластьМакета.Параметры.СценарийПланирования = ДокументУтверждения.СценарийПланирования;
	ДокументРезультат.Вывести(ОбластьМакета);
	
	Если ВыполнениеРабот Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("ОбластьЗаголовок");
		ДОкументРезультат.Вывести(ОбластьМакета);
	КонецЕсли;
	
	МассивЯчеекДляОбъединения = Новый Массив;
	
	Сч = 1;
	//СчетчикПервойСтроки = 11;
	
	СчетчикПервойСтроки = 0;
	
	Если ВыполнениеРабот Тогда
		
		КоличествоПодСтрокВсего = 0;
		ПроцентВыполненияВсего = 0;
		СуммаПланВсего = 0;
		СуммаФактВсего = 0; 		
		
		Для Каждого СтрокаДерева ИЗ ДеревоЗначений.Строки Цикл 	
			
			ПроцентВыполненияКонструктив = 0;
			СуммаПланКонструктив = 0;
			СуммаФактКонструктив = 0; 			
			
			Для Каждого ПодСтрока ИЗ СтрокаДерева.Строки Цикл
				
				ОбластьМакета = Макет.ПолучитьОбласть("ОбластьСтрока");
				ОбластьМакета.Параметры.Заполнить(ПодСтрока);
				ОбластьМакета.Параметры.КонструктивНаименование = ПодСтрока.Конструктив.Наименование;
				ОбластьМакета.Параметры.НомерСтроки = Сч;
				
				Если ПодСтрока.ОбъемПлан > ПодСтрока.ОбъемФакт Тогда
					ОбластьМакета.Параметры.ДатаОкончанияФакт = "";
					ОбластьМакета.Параметры.Отставание = 0;
				КонецЕсли;
				
				ПроцентВыполненияВсего = ПроцентВыполненияВсего+ПодСтрока.ПроцентВыполнения;
				СуммаПланВсего = СуммаПланВсего + ПодСтрока.СуммаПлан;
				СуммаФактВсего = СуммаФактВсего + ПодСтрока.СуммаФакт;
				
				ПроцентВыполненияКонструктив = ПроцентВыполненияКонструктив+ПодСтрока.ПроцентВыполнения;
				СуммаПланКонструктив = СуммаПланКонструктив+ПодСтрока.СуммаПлан;
				СуммаФактКонструктив = СуммаФактКонструктив+ПодСтрока.СуммаФакт; 
				
				ДокументРезультат.Вывести(ОбластьМакета);
				
				Если СчетчикПервойСтроки = 0 Тогда
					СчетчикПервойСтроки = ДокументРезультат.ВысотаТаблицы;
				КонецЕсли;
				
				
			КонецЦикла;
			
			КоличествоПодСтрок = СтрокаДерева.Строки.Количество();
			КоличествоПодСтрокВсего = КоличествоПодСтрокВсего+КоличествоПодСтрок;
			
			СчетчикПоследнейСтроки = СчетчикПервойСтроки+КоличествоПодСтрок-1; 			
			
			Если ВыводитьИтоги И КоличествоПодСтрок > 1 Тогда
				
				ОбластьМакета = Макет.ПолучитьОбласть("ОбластьИтого");
				ОбластьМакета.Параметры.ПроцентВыполнения = ПроцентВыполненияКонструктив/КоличествоПодСтрок;
				ОбластьМакета.Параметры.СуммаПлан = СуммаПланКонструктив;
				ОбластьМакета.Параметры.СуммаФакт = СуммаФактКонструктив;
				ОбластьМакета.Параметры.Перевыполнение = СуммаФактКонструктив-СуммаПланКонструктив;
				
				ДокументРезультат.Вывести(ОбластьМакета);			
				
				СчетчикПоследнейСтроки = СчетчикПоследнейСтроки +1;
				
			КонецЕсли;
			
			//СчетчикПоследнейСтроки = СчетчикПервойСтроки+КоличествоПодСтрок-1;
			
			//СчетчикПоследнейСтроки = Макс(СчетчикПервойСтроки,ДокументРезультат.ВысотаТаблицы - 1);
			
			СП = Формат(СчетчикПервойСтроки,"ЧГ=0");
			СПС = Формат(СчетчикПоследнейСтроки,"ЧГ=0");
			
			МассивЯчеекДляОбъединения.Добавить("R"+СП+"C2:R"+СПС+"C2");
			МассивЯчеекДляОбъединения.Добавить("R"+СП+"C3:R"+СПС+"C3");
			МассивЯчеекДляОбъединения.Добавить("R"+СП+"C4:R"+СПС+"C4");			
			
			СчетчикПервойСтроки = СчетчикПервойСтроки+КоличествоПодСтрок;
			СчетчикПервойСтроки = СчетчикПоследнейСтроки+1;
			Сч = Сч+1;
			
		КонецЦикла;
		
		Если ВыводитьИтоги Тогда
			
			ОбластьМакета = Макет.ПолучитьОбласть("ОбластьИтого");
			ОбластьМакета.Параметры.ПроцентВыполнения = ?(КоличествоПодСтрокВсего = 0,0,ПроцентВыполненияВсего/КоличествоПодСтрокВсего);
			ОбластьМакета.Параметры.СуммаПлан = СуммаПланВсего;
			ОбластьМакета.Параметры.СуммаФакт = СуммаФактВсего;
			ОбластьМакета.Параметры.Перевыполнение = СуммаФактВсего-СуммаПланВсего;
			ДокументРезультат.Вывести(ОбластьМакета);
			
			СчетчикПервойСтроки = СчетчикПервойСтроки+1;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	Если ОбеспеченностьСтроительства Тогда 		
		
		ОбластьМакета = Макет.ПолучитьОбласть("ОбластьЗаголовокНоменклатура");
		ДокументРезультат.Вывести(ОбластьМакета);
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТабНоменклатуры",ТабНоменклатуры);
		
		Запрос.УстановитьПараметр("ОтборПоРаботам",ОтборПоРаботам);
		ЗАпрос.УстановитьПараметр("СписокРабот",СписокРабот);
		Запрос.УстановитьПараметр("ОтборПоКонструктивам",ОтборПоКонструктивам);
		ЗАпрос.УстановитьПараметр("СписокКонструктивов",СписокКонструктивов);

		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТабНом.Конструктив КАК Справочник.УСОERP_Конструктив) КАК Конструктив,
		|	ТабНом.Работа КАК Работа,
		|	ВЫРАЗИТЬ(ТабНом.КодСДР КАК СТРОКА(100)) КАК КодСДР,
		|	ВЫРАЗИТЬ(ТабНом.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
		|	ТабНом.Характеристика КАК Характеристика,
		|	ТабНом.КоличествоПлан КАК КоличествоПлан,
		|	ТабНом.КоличествоФакт КАК КоличествоФакт,
		|	ТабНом.СуммаПлан КАК СуммаПлан,
		|	ТабНом.СуммаФакт КАК СуммаФакт
		|ПОМЕСТИТЬ ВрТаб
		|ИЗ
		|	&ТабНоменклатуры КАК ТабНом
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТаб.Конструктив КАК Конструктив,
		|	ВрТаб.Работа КАК Работа,
		|	ВрТаб.КодСДР КАК КодСДР,
		|	ВрТаб.Номенклатура КАК Номенклатура,
		|	ВрТаб.Характеристика КАК Характеристика,
		|	ВрТаб.КоличествоПлан КАК КоличествоПлан,
		|	ВрТаб.КоличествоФакт КАК КоличествоФакт,
		|	ВрТаб.СуммаПлан КАК СуммаПлан,
		|	ВрТаб.СуммаФакт КАК СуммаФакт,
		|	ВрТаб.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
		|ИЗ
		|	ВрТаб КАК ВрТаб
		|ГДЕ
		|	ВЫБОР КОГДА &ОтборПоКонструктивам ТОГДА ВрТаб.Конструктив В(&СписокКонструктивов) ИНАЧЕ ИСТИНА КОНЕЦ И  ВЫБОР КОГДА &ОтборПоРаботам ТОГДА ВрТаб.Работа В(&СписокРабот) ИНАЧЕ ИСТИНА КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВрТаб.Конструктив.Наименование,
		|	КодСДР,
		|	ВрТаб.Номенклатура.Наименование,
		|	Характеристика
		|ИТОГИ
		|	МАКСИМУМ(КодСДР),
		|	МАКСИМУМ(КоличествоПлан),
		|	МАКСИМУМ(КоличествоФакт)
		|ПО
		|	Конструктив,
		|	Работа";  	
		
		СчетчикПервойСтроки = 0;
		
		Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Конструктив");
		
		Сч = 1;
		
		Пока Выборка.Следующий() Цикл
			
			КоличествоНоменклатуры = 0;		
			СуммаПланКонструктив = 0;
			СуммаФактКонструктив = 0; 
			
			ВыборкаРабота = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Работа");
			
			СчетчикРабот = СчетчикПервойСтроки;  
			
			Пока ВыборкаРабота.Следующий() Цикл  				
				
				ВыборкаНоменклатура = ВыборкаРабота.Выбрать();
				
				Пока ВыборкаНоменклатура.Следующий() Цикл
					
					ОбластьМакета = Макет.ПолучитьОбласть("ОбластьСтрокаНоменклатура");
					ОбластьМакета.Параметры.Заполнить(ВыборкаНоменклатура);
					ОбластьМакета.Параметры.НаименованиеКонструктива = ВыборкаНоменклатура.Конструктив.НаименованиеПолное;
					ОбластьМакета.Параметры.КонструктивНаименование = ВыборкаНоменклатура.Конструктив.Наименование;
					ОбластьМакета.Параметры.КодСДР = СокрЛП(ВыборкаНоменклатура.КодСДР);
					ОбластьМакета.Параметры.НомерСтроки = Сч;
					ОбластьМакета.Параметры.КоличествоОтклонение = ВыборкаНоменклатура.КоличествоПлан - ВыборкаНоменклатура.КоличествоФакт;
					ОбластьМакета.Параметры.СуммаОтклонение = ВыборкаНоменклатура.СуммаПлан - ВыборкаНоменклатура.СуммаФакт;
					
					СуммаПланКонструктив = СуммаПланКонструктив+ВыборкаНоменклатура.СуммаПлан;
					СуммаФактКонструктив = СуммаФактКонструктив+ВыборкаНоменклатура.СуммаФакт;
					
					ДокументРезультат.Вывести(ОбластьМакета);
					
					Если СчетчикПервойСтроки = 0 Тогда
						СчетчикПервойСтроки = ДокументРезультат.ВысотаТаблицы;
						СчетчикРабот = СчетчикПервойСтроки; 
					КонецЕсли;					
					
					КоличествоНоменклатуры = КоличествоНоменклатуры+1;
					
					СтрокиДобавленныеКонструктив = ТаблицаКонструктивов.НайтиСтроки(Новый Структура("Конструктив", ВыборкаНоменклатура.Конструктив));
					Если СтрокиДобавленныеКонструктив.Количество() Тогда
						СтрокаКонструктив = СтрокиДобавленныеКонструктив[0];
					Иначе
						СтрокаКонструктив = ТаблицаКонструктивов.Добавить();
						СтрокаКонструктив.ОтклонениеВДнях = -1; 
					КонецЕсли;
					СтрокаКонструктив.Конструктив = ВыборкаНоменклатура.Конструктив;
					СтрокаКонструктив.ИдентификаторКонструктива = ВыборкаНоменклатура.Конструктив.Наименование;
					СтрокаКонструктив.ПерерасходИлиНЗП = СтрокаКонструктив.ПерерасходИлиНЗП + ВыборкаНоменклатура.СуммаПлан - ВыборкаНоменклатура.СуммаФакт;
					
				КонецЦикла;
				
				СчетчикРаботПоследний = СчетчикРабот+ВыборкаНоменклатура.Количество()-1;
						
				СР = Формат(СчетчикРабот,"ЧГ=0");
				СРП = Формат(СчетчикРаботПоследний,"ЧГ=0");
				
 				МассивЯчеекДляОбъединения.Добавить("R"+СР+"C5:R"+СРП+"C5");
				МассивЯчеекДляОбъединения.Добавить("R"+СР+"C6:R"+СРП+"C6"); 				
				СчетчикРабот = СчетчикРаботПоследний+1;					
				
			КонецЦикла;
			
			СчетчикПоследнейСтроки = СчетчикПервойСтроки+КоличествоНоменклатуры-1;
			
			Сч = Сч+1;
			
			Если ВыводитьИтоги И КоличествоНоменклатуры > 1 Тогда
				
				ОбластьМакета = Макет.ПолучитьОбласть("ОбластьИтогоНоменклатура");
				ОбластьМакета.Параметры.СуммаПлан = СуммаПланКонструктив;
				ОбластьМакета.Параметры.СуммаФакт = СуммаФактКонструктив;
				ОбластьМакета.Параметры.СуммаОтклонение = СуммаПланКонструктив-СуммаФактКонструктив;
				
				ДокументРезультат.Вывести(ОбластьМакета);	

				СчетчикПоследнейСтроки = СчетчикПоследнейСтроки+1; 			
				
			КонецЕсли; 
			
			СП = Формат(СчетчикПервойСтроки,"ЧГ=0");
			СПС = Формат(СчетчикПоследнейСтроки,"ЧГ=0");
			МассивЯчеекДляОбъединения.Добавить("R"+СП+"C2:R"+СПС+"C2");
			МассивЯчеекДляОбъединения.Добавить("R"+СП+"C3:R"+СПС+"C3");
			МассивЯчеекДляОбъединения.Добавить("R"+СП+"C4:R"+СПС+"C4");
			
			СчетчикПервойСтроки = СчетчикПоследнейСтроки+1; 
			
		КонецЦикла;
		
		Если ВыводитьИтоги Тогда
			
			ОбластьМакета = Макет.ПолучитьОбласть("ОбластьИтогоНоменклатура");
			ОбластьМакета.Параметры.СуммаПлан = ТабНоменклатуры.Итог("СуммаПлан");
			ОбластьМакета.Параметры.СуммаФакт = ТабНоменклатуры.Итог("СуммаФакт");
			ОбластьМакета.Параметры.СуммаОтклонение = ТабНоменклатуры.Итог("СуммаПлан") - ТабНоменклатуры.Итог("СуммаФакт");
			ДокументРезультат.Вывести(ОбластьМакета);
			
			СчетчикПервойСтроки = СчетчикПервойСтроки+1;
			
		КонецЕсли;
		
	КонецЕсли;	

		
	#Область ПрямыеЗатраты
	
	Если ПрямыеЗатраты Тогда
		
		Сч = 1;
 
		 СчетчикПервойСтроки = 0;		
		
		ОбластьМакета = Макет.ПолучитьОбласть("ОбластьЗаголовокПрямыеЗатраты");
		ДокументРезультат.Вывести(ОбластьМакета);
		
		Запрос = Новый Запрос;  		
		
		Запрос.УстановитьПараметр("ОбъектСтроительства",ОбъектСтроительства);
		Запрос.УстановитьПараметр("ДокументУтверждения",ДокументУтверждения);
		Запрос.УстановитьПараметр("ДатаНачала",ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", Дата);
		Запрос.УстановитьПараметр("КопияСценария",ДокументУтверждения.КопияСценария);
		Запрос.УстановитьПараметр("ОтборПоРаботам",ОтборПоРаботам);
		ЗАпрос.УстановитьПараметр("СписокРабот",СписокРабот);
		Запрос.УстановитьПараметр("ОтборПоКонструктивам",ОтборПоКонструктивам);
		ЗАпрос.УстановитьПараметр("СписокКонструктивов",СписокКонструктивов);
		
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УСОERP_БюджетСтроительства.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.УСОERP_БюджетСтроительства КАК УСОERP_БюджетСтроительства
		|ГДЕ
		|	УСОERP_БюджетСтроительства.ДокументОснование = &ДокументУтверждения
		|	И УСОERP_БюджетСтроительства.Дата <= &ДатаОкончания
		|	И УСОERP_БюджетСтроительства.Проведен
		|	И УСОERP_БюджетСтроительства.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
		|
		|УПОРЯДОЧИТЬ ПО
		|	УСОERP_БюджетСтроительства.Дата УБЫВ";
		
		Выборка = ЗАпрос.Выполнить().Выбрать();
		
		БюджетСтроительства = Документы.УСОERP_БюджетСтроительства.ПустаяСсылка();
		
		Если Выборка.Следующий() Тогда
			БюджетСтроительства = Выборка.Ссылка;
		КонецЕсли;
		
		Запрос.УстановитьПараметр("БюджетСтроительства", БюджетСтроительства);
		Запрос.УстановитьПараметр("ТабНоменклатуры", ТабНоменклатуры);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТабНом.Конструктив КАК Справочник.УСОERP_Конструктив) КАК Конструктив,
		|	ТабНом.Работа КАК Работа,
		|	ВЫРАЗИТЬ(ТабНом.КодСДР КАК СТРОКА(100)) КАК КодСДР,
		|	ВЫРАЗИТЬ(ТабНом.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
		|	ТабНом.Характеристика КАК Характеристика,
		|	ТабНом.КоличествоПлан КАК КоличествоПлан,
		|	ТабНом.КоличествоФакт КАК КоличествоФакт,
		|	ТабНом.СуммаПлан КАК СуммаПлан,
		|	ТабНом.СуммаФакт КАК СуммаФакт
		|ПОМЕСТИТЬ ВрТаб
		|ИЗ
		|	&ТабНоменклатуры КАК ТабНом
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УСОERP_СтроительныеРаботыКонструктивы.Ссылка КАК Работа,
		|	МАКСИМУМ(УСОERP_СтроительныеРаботыКонструктивы.НомерСтроки) КАК КоличествоКонструктивов,
		|	УСОERP_СтроительныеРаботыКонструктивы.Ссылка.РаботаИсточник КАК РаботаИсточник
		|ПОМЕСТИТЬ ВрТабРабот
		|ИЗ
		|	Справочник.УСОERP_СтроительныеРаботы.Конструктивы КАК УСОERP_СтроительныеРаботыКонструктивы
		|ГДЕ
		|	УСОERP_СтроительныеРаботыКонструктивы.Ссылка.Владелец = &КопияСценария
		|
		|СГРУППИРОВАТЬ ПО
		|	УСОERP_СтроительныеРаботыКонструктивы.Ссылка,
		|	УСОERP_СтроительныеРаботыКонструктивы.Ссылка.РаботаИсточник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТабРабот.Работа КАК Работа,
		|	СУММА(УСОERP_СтоимостьПроекта.СуммаСНДС / ВрТабРабот.КоличествоКонструктивов) КАК СтоимостьПрямыхЗатрат_План
		|ПОМЕСТИТЬ Вр_ПрямыеЗатраты
		|ИЗ
		|	РегистрСведений.УСОERP_СтоимостьПроекта КАК УСОERP_СтоимостьПроекта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВрТабРабот КАК ВрТабРабот
		|		ПО УСОERP_СтоимостьПроекта.Работа.РаботаИсточник = ВрТабРабот.РаботаИсточник
		|ГДЕ
		|	УСОERP_СтоимостьПроекта.Регистратор.ДокументОснование = &ДокументУтверждения
		|	И УСОERP_СтоимостьПроекта.Регистратор = &БюджетСтроительства
		|
		|СГРУППИРОВАТЬ ПО
		|	ВрТабРабот.Работа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТабРабот.Работа КАК Работа,
		|	СУММА(ВрТаб.СуммаФакт) КАК Материалы
		|ПОМЕСТИТЬ Вр_Материалы
		|ИЗ
		|	ВрТабРабот КАК ВрТабРабот
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВрТаб КАК ВрТаб
		|		ПО ВрТабРабот.Работа = ВрТаб.Работа
		|
		|СГРУППИРОВАТЬ ПО
		|	ВрТабРабот.Работа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТабРабот.Работа КАК Работа,
		|	СУММА(ВыработкаСотрудниковВидыРабот.Сумма / ВрТабРабот.КоличествоКонструктивов) КАК ЗП
		|ПОМЕСТИТЬ Вр_ЗП
		|ИЗ
		|	Документ.ВыработкаСотрудников.ВидыРабот КАК ВыработкаСотрудниковВидыРабот
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВрТабРабот КАК ВрТабРабот
		|		ПО ВыработкаСотрудниковВидыРабот.УСОERP_Работа.РаботаИсточник = ВрТабРабот.РаботаИсточник
		|ГДЕ
		|	ВыработкаСотрудниковВидыРабот.Ссылка.Проведен
		|	И ВыработкаСотрудниковВидыРабот.Ссылка.УСОERP_БлокУСП
		|	И ВыработкаСотрудниковВидыРабот.УСОERP_Работа.Владелец.Владелец = &ОбъектСтроительства
		|	И ВыработкаСотрудниковВидыРабот.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|
		|СГРУППИРОВАТЬ ПО
		|	ВрТабРабот.Работа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТабРабот.Работа КАК Работа,
		|	СУММА(УСОERP_ТабельИсполнителейРаботОбороты.КоличествоПриход * ВложенныйЗапрос.Цена / ВрТабРабот.КоличествоКонструктивов) КАК АвтотранспортныеРасходы
		|ПОМЕСТИТЬ Вр_Автотранспорт
		|ИЗ
		|	РегистрНакопления.УСОERP_ТабельИсполнителейРабот.Обороты(
		|			,
		|			,
		|			,
		|			ОбъектСтроительства = &ОбъектСтроительства
		|				И ТипРесурса ССЫЛКА Справочник.ТипыТранспортныхСредств
		|				И (Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)) КАК УСОERP_ТабельИсполнителейРаботОбороты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			УСОERP_СтоимостьРесурсовВБюджетеСтроительства.Ресурс КАК Ресурс,
		|			УСОERP_СтоимостьРесурсовВБюджетеСтроительства.ОбъектРасценки КАК ОбъектРасценки,
		|			МАКСИМУМ(УСОERP_СтоимостьРесурсовВБюджетеСтроительства.БазоваяЦена) КАК Цена
		|		ИЗ
		|			РегистрСведений.УСОERP_СтоимостьРесурсовВБюджетеСтроительства КАК УСОERP_СтоимостьРесурсовВБюджетеСтроительства
		|		ГДЕ
		|			УСОERP_СтоимостьРесурсовВБюджетеСтроительства.Регистратор = &БюджетСтроительства
		|		
		|		СГРУППИРОВАТЬ ПО
		|			УСОERP_СтоимостьРесурсовВБюджетеСтроительства.Ресурс,
		|			УСОERP_СтоимостьРесурсовВБюджетеСтроительства.ОбъектРасценки) КАК ВложенныйЗапрос
		|		ПО УСОERP_ТабельИсполнителейРаботОбороты.Ресурс = ВложенныйЗапрос.Ресурс
		|			И УСОERP_ТабельИсполнителейРаботОбороты.ТипРесурса = ВложенныйЗапрос.ОбъектРасценки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВрТабРабот КАК ВрТабРабот
		|		ПО УСОERP_ТабельИсполнителейРаботОбороты.Работа = ВрТабРабот.РаботаИсточник
		|
		|СГРУППИРОВАТЬ ПО
		|	ВрТабРабот.Работа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТабРабот.Работа КАК Работа,
		|	СУММА(УСОERP_ВыполнениеРаботСубподрядчикомОбороты.СуммаСНДСРасход / ВрТабРабот.КоличествоКонструктивов) КАК Субподряд
		|ПОМЕСТИТЬ Вр_Субподряд
		|ИЗ
		|	РегистрНакопления.УСОERP_ВыполнениеРаботСубподрядчиком.Обороты(&ДатаНачала, &ДатаОкончания, , ОбъектСтроительства = &ОбъектСтроительства) КАК УСОERP_ВыполнениеРаботСубподрядчикомОбороты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВрТабРабот КАК ВрТабРабот
		|		ПО УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Работа = ВрТабРабот.РаботаИсточник
		|
		|СГРУППИРОВАТЬ ПО
		|	ВрТабРабот.Работа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Вр_ПрямыеЗатраты.Работа КАК Работа,
		|	Вр_ПрямыеЗатраты.СтоимостьПрямыхЗатрат_План КАК СтоимостьПрямыхЗатрат_План,
		|	0 КАК Материалы,
		|	0 КАК ЗП,
		|	0 КАК АвтотранспортныеРасходы,
		|	0 КАК Субподряд
		|ПОМЕСТИТЬ ВрТабРезультат
		|ИЗ
		|	Вр_ПрямыеЗатраты КАК Вр_ПрямыеЗатраты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Вр_Материалы.Работа,
		|	0,
		|	Вр_Материалы.Материалы,
		|	0,
		|	0,
		|	0
		|ИЗ
		|	Вр_Материалы КАК Вр_Материалы
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Вр_ЗП.Работа,
		|	0,
		|	0,
		|	Вр_ЗП.ЗП,
		|	0,
		|	0
		|ИЗ
		|	Вр_ЗП КАК Вр_ЗП
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Вр_Автотранспорт.Работа,
		|	0,
		|	0,
		|	0,
		|	Вр_Автотранспорт.АвтотранспортныеРасходы,
		|	0
		|ИЗ
		|	Вр_Автотранспорт КАК Вр_Автотранспорт
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Вр_Субподряд.Работа,
		|	0,
		|	0,
		|	0,
		|	0,
		|	Вр_Субподряд.Субподряд
		|ИЗ
		|	Вр_Субподряд КАК Вр_Субподряд
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТабРезультат.Работа КАК Работа,
		|	СУММА(ВрТабРезультат.СтоимостьПрямыхЗатрат_План) КАК СтоимостьПрямыхЗатрат_План,
		|	СУММА(ВрТабРезультат.Материалы) КАК Материалы,
		|	СУММА(ВрТабРезультат.ЗП) КАК ЗП,
		|	СУММА(ВрТабРезультат.АвтотранспортныеРасходы) КАК АвтотранспортныеРасходы,
		|	СУММА(ВрТабРезультат.Субподряд) КАК Субподряд,
		|	УСОERP_СтроительныеРаботыКонструктивы.Конструктив КАК Конструктив,
		|	СУММА(ВрТабРезультат.Материалы + ВрТабРезультат.ЗП + ВрТабРезультат.АвтотранспортныеРасходы + ВрТабРезультат.Субподряд) КАК ВсегоПрямыхЗатрат,
		|	СУММА(ВрТабРезультат.СтоимостьПрямыхЗатрат_План - (ВрТабРезультат.Материалы + ВрТабРезультат.ЗП + ВрТабРезультат.АвтотранспортныеРасходы + ВрТабРезультат.Субподряд)) КАК Экономия
		|ИЗ
		|	ВрТабРезультат КАК ВрТабРезультат
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УСОERP_СтроительныеРаботы.Конструктивы КАК УСОERP_СтроительныеРаботыКонструктивы
		|		ПО ВрТабРезультат.Работа = УСОERP_СтроительныеРаботыКонструктивы.Ссылка
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ОтборПоРаботам
		|				ТОГДА УСОERP_СтроительныеРаботыКонструктивы.Ссылка В (&СписокРабот)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &ОтборПоКонструктивам
		|				ТОГДА УСОERP_СтроительныеРаботыКонструктивы.Конструктив В (&СписокКонструктивов)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВрТабРезультат.Работа,
		|	УСОERP_СтроительныеРаботыКонструктивы.Конструктив
		|
		|УПОРЯДОЧИТЬ ПО
		|	УСОERP_СтроительныеРаботыКонструктивы.Конструктив.Наименование,
		|	УСОERP_СтроительныеРаботыКонструктивы.Конструктив.НаименованиеПолное,
		|	ВрТабРезультат.Работа.ПорядокСортировки,
		|	ВрТабРезультат.Работа.КодСДР
		|ИТОГИ ПО
		|	ОБЩИЕ,
		|	Конструктив";
		
		ВыборкаОбщие = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Общие");
		ВыборкаОбщие.Следующий();
		
		ВыборкаКонструктив = ВыборкаОбщие.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Конструктив");
		
		Сч = 1;
		
		Пока ВыборкаКонструктив.Следующий() Цикл
			
			ВыборкаРабота = ВыборкаКонструктив.Выбрать();
			
			Пока ВыборкаРабота.Следующий() Цикл
				
				ОбластьМакета = Макет.ПолучитьОбласть("ОбластьСтрокаПрямыеЗатраты");
				ОбластьМакета.Параметры.Заполнить(ВыборкаРабота);
				ОбластьМакета.Параметры.КонструктивНаименование = ВыборкаРабота.Конструктив.Наименование;
				ОбластьМакета.Параметры.НаименованиеКонструктива = ВыборкаРабота.Конструктив.НаименованиеПолное;
				ОбластьМакета.Параметры.КодСДР = ВыборкаРабота.Работа.КодСДР;
				ОбластьМакета.Параметры.НомерСтроки = Сч;
				
				ДокументРезультат.Вывести(ОбластьМакета); 
				
				Если СчетчикПервойСтроки = 0 Тогда
					СчетчикПервойСтроки = ДокументРезультат.ВысотаТаблицы;
				КонецЕсли; 
				
				СтрокиДобавленныеКонструктив = ТаблицаКонструктивов.НайтиСтроки(Новый Структура("Конструктив", ВыборкаРабота.Конструктив));
				Если СтрокиДобавленныеКонструктив.Количество() Тогда
					СтрокаКонструктив = СтрокиДобавленныеКонструктив[0];
				Иначе
					СтрокаКонструктив = ТаблицаКонструктивов.Добавить();
					СтрокаКонструктив.ОтклонениеВДнях = -1; 
				КонецЕсли;
				СтрокаКонструктив.Конструктив = ВыборкаРабота.Конструктив;
				СтрокаКонструктив.ИдентификаторКонструктива = ВыборкаРабота.Конструктив.Наименование;
				СтрокаКонструктив.ЭкономияИлиПерерасходПоПрямымЗатратам = СтрокаКонструктив.ЭкономияИлиПерерасходПоПрямымЗатратам + ВыборкаРабота.Экономия;

				
			КонецЦикла;
			
			Сч = Сч+1;
			
			КоличествоПодСтрок = ВыборкаРабота.Количество();
			
			СчетчикПоследнейСтроки = СчетчикПервойСтроки+КоличествоПодСтрок-1; 
			
			СП = Формат(СчетчикПервойСтроки,"ЧГ=0");
			СПС = Формат(СчетчикПоследнейСтроки,"ЧГ=0");
			МассивЯчеекДляОбъединения.Добавить("R"+СП+"C2:R"+СПС+"C2");
			МассивЯчеекДляОбъединения.Добавить("R"+СП+"C3:R"+СПС+"C3");
			МассивЯчеекДляОбъединения.Добавить("R"+СП+"C4:R"+СПС+"C4");
			
			СчетчикПервойСтроки = СчетчикПоследнейСтроки+1; 
			
			Если ВыводитьИтоги И ВыборкаРабота.Количество() > 1 Тогда
				
				ОбластьМакета = Макет.ПолучитьОбласть("ОбластьИтогоПрямыеЗатраты");
				ОбластьМакета.Параметры.Заполнить(ВыборкаКонструктив);
				ДокументРезультат.Вывести(ОбластьМакета);  				
				
				СчетчикПервойСтроки = СчетчикПервойСтроки+1;				
				СчетчикПоследнейСтроки = СчетчикПоследнейСтроки +1;  				
				
			КонецЕсли; 			
			
		КонецЦикла;
		
		Если ВыводитьИтоги Тогда
			
			ОбластьМакета = Макет.ПолучитьОбласть("ОбластьИтогоПрямыеЗатраты");
			ОбластьМакета.Параметры.Заполнить(ВыборкаОбщие);
			ДокументРезультат.Вывести(ОбластьМакета);
			
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти 			
			
	Для Каждого ЭлементМассива ИЗ МассивЯчеекДляОбъединения Цикл
		
		ДокументРезультат.Область(ЭлементМассива).Объединить();
		
	КонецЦикла; 	
	
	МассивТаблицы = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаКонструктивов.Выгрузить());
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ТаблицаКонструктивов", МассивТаблицы);
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ОбъектСтроительства", ОбъектСтроительства);
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ПользовательскиеНастройкиМодифицированы", Истина);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьВнешниеНаборыДанных(НастройкиОсновнойСхемы)
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	
	Дата = НастройкиОсновнойСхемы.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаОкончания")).Значение.Дата;
	
	ДатаНачала = Дата('00010101');
	
	ДокументУтверждения = Документы.УСОERP_УтверждениеКалендарногоПланаГрафика.ПустаяСсылка();
	ОбъектСтроительства = НастройкиОсновнойСхемы.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ОбъектСтроительства")).Значение;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УСОERP_УтверждениеКалендарногоПланаГрафика.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.УСОERP_УтверждениеКалендарногоПланаГрафика КАК УСОERP_УтверждениеКалендарногоПланаГрафика
		|ГДЕ
		|	УСОERP_УтверждениеКалендарногоПланаГрафика.ОбъектСтроительства = &ОбъектСтроительства
		|	И УСОERP_УтверждениеКалендарногоПланаГрафика.Дата <= &Дата
		|
		|УПОРЯДОЧИТЬ ПО
		|	УСОERP_УтверждениеКалендарногоПланаГрафика.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ОбъектСтроительства", ОбъектСтроительства);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДокументУтверждения = Выборка.Ссылка;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УСОERP_СценарииПланированияПроектовСтроительства.НачалоСтроительства КАК НачалоСтроительства
		|ИЗ
		|	Справочник.УСОERP_СценарииПланированияПроектовСтроительства КАК УСОERP_СценарииПланированияПроектовСтроительства
		|ГДЕ
		|	УСОERP_СценарииПланированияПроектовСтроительства.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", ОбъектСтроительства);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДатаНачала = Выборка.НачалоСтроительства;
	КонецЦикла;
	
	ОбеспеченностьСтроительства = НастройкиОсновнойСхемы.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ОбеспеченностьСтроительства")).Значение;
	
	ЗаполнитьТаблицуРезультат(ТаблицаРезультат,ДокументУтверждения,ДатаНачала,Дата,ОбеспеченностьСтроительства);  
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ТаблицаРаспределенияРабот", ТаблицаРезультат);
	
	Возврат ВнешниеНаборыДанных;  	
	
КонецФункции

#КонецОбласти

Процедура ЗаполнитьТаблицуРезультат(ТаблицаРезультат,ДокументУтверждения,ДатаНачала,ДатаОкончания,ОбеспеченностьСтроительства)
	
	ТаблицаРезультат.Колонки.Добавить("Конструктив",Новый ОписаниеТипов("СправочникСсылка.УСОERP_Конструктив"));
	ТаблицаРезультат.Колонки.Добавить("НаименованиеКонструктива",Новый ОписаниеТипов("Строка"));
	ТаблицаРезультат.Колонки.Добавить("Работа",Новый ОписаниеТипов("СправочникСсылка.УСОERP_СтроительныеРаботы"));
	ТаблицаРезультат.Колонки.Добавить("КодСДР",Новый ОписаниеТипов("Строка"));
	ТаблицаРезультат.Колонки.Добавить("ЕдиницаОбъема",Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	
	ТаблицаРезультат.Колонки.Добавить("ОбъемПлан",Новый ОписаниеТипов("Число"));
	ТаблицаРезультат.Колонки.Добавить("ОбъемФакт",Новый ОписаниеТипов("Число"));
	ТаблицаРезультат.Колонки.Добавить("ПроцентВыполнения",Новый ОписаниеТипов("Число"));
	ТаблицаРезультат.Колонки.Добавить("СуммаПлан",Новый ОписаниеТипов("Число"));
	ТаблицаРезультат.Колонки.Добавить("СуммаФакт",Новый ОписаниеТипов("Число"));
	ТаблицаРезультат.Колонки.Добавить("Перевыполнение",Новый ОписаниеТипов("Число"));
	ТаблицаРезультат.Колонки.Добавить("ДатаОкончанияПлан",Новый ОписаниеТипов("Дата"));
	ТаблицаРезультат.Колонки.Добавить("ДатаОкончанияФакт",Новый ОписаниеТипов("Дата"));
	ТаблицаРезультат.Колонки.Добавить("Отставание",Новый ОписаниеТипов("Число")); 
	
	НовыйВариант =  ДокументУтверждения.СценарийПланирования.НовыйВариант;
	
	СценарийПланирования = ?(НовыйВариант,ДокументУтверждения.КопияСценария,ДокументУтверждения.СценарийПланирования);
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("СценарийПланирования",СценарийПланирования);
	Запрос.УстановитьПараметр("НовыйВариант",НовыйВариант);
	Запрос.УстановитьПараметр("ДокументУтверждения",ДокументУтверждения);
	Запрос.УстановитьПараметр("ДатаНачала",ДатаНачала);
	ЗАпрос.УстановитьПараметр("ДатаОкончания",ДатаОкончания);
	Запрос.УстановитьПараметр("ОбъектСтроительства",СценарийПланирования.Владелец);
	Запрос.УстановитьПараметр("ОбеспеченностьСтроительства",ОбеспеченностьСтроительства);
	Запрос.УстановитьПараметр("ВидЦены",Справочники.ВидыЦен.ПустаяСсылка());
	Запрос.УстановитьПараметр("ГоловнойСценарий",СценарийПланирования.ГоловнойСценарий);
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УСОERP_БюджетСтроительства.Ссылка
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	Документ.УСОERP_БюджетСтроительства КАК УСОERP_БюджетСтроительства
	|ГДЕ
	|	УСОERP_БюджетСтроительства.Дата <= &ДатаОкончания
	|	И УСОERP_БюджетСтроительства.ОбъектСтроительства = &ОбъектСтроительства
	|	И УСОERP_БюджетСтроительства.Проведен
	|	И УСОERP_БюджетСтроительства.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_БюджетСтроительства.Дата УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.Ссылка.ТипЦеныМатериалов КАК ТипЦены
	|ИЗ
	|	ВрТаб КАК ВрТаб";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Запрос.УстановитьПараметр("ВидЦены",Выборка.ТипЦены);
	КонецЕсли; 	
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА УСОERP_СтроительныеРаботы.ГрафикРаботы = ЗНАЧЕНИЕ(Справочник.Календари.ПустаяСсылка)
	|			ТОГДА УСОERP_СтроительныеРаботы.Владелец.Владелец.ГрафикРаботы
	|		ИНАЧЕ УСОERP_СтроительныеРаботы.ГрафикРаботы
	|	КОНЕЦ КАК ГрафикРаботы
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	УСОERP_СтроительныеРаботы.Владелец = &СценарийПланирования
	|	И НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
	|	И НЕ УСОERP_СтроительныеРаботы.СуммарнаяРабота
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА УСОERP_СтроительныеРаботы.ГрафикРаботы = ЗНАЧЕНИЕ(Справочник.Календари.ПустаяСсылка)
	|			ТОГДА УСОERP_СтроительныеРаботы.Владелец.Владелец.ГрафикРаботы
	|		ИНАЧЕ УСОERP_СтроительныеРаботы.ГрафикРаботы
	|	КОНЕЦ";
	
	МассивГрафиков = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ГрафикРаботы");
	
	ТабГрафиков = УСОERP_ЗащищенныеФункцииСервер.ПолучитьТаблицуГрафиков(СценарийПланирования,МассивГрафиков);
	
	Запрос.Текст =
