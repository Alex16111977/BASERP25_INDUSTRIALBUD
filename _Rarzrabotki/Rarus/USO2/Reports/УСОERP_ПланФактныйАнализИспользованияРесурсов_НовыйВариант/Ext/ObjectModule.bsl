#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПользовательскиеНастройкиМодифицированы = Ложь;
	Данные = Новый ДеревоЗначений;
	
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	
	СтрокаОбласти = ОпределитьОбластиВывода(НастройкиОтчета);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

	СтруктураОформления = Новый Структура();	
	
	МассивПараметров = Новый Массив;
	Для каждого Элемент Из НастройкиОтчета.ПараметрыДанных.Элементы Цикл
		Если Элемент.Использование 
			И НЕ Элемент.Параметр = Новый ПараметрКомпоновкиДанных("ВыводитьДанныеОРабочих")
			И НЕ Элемент.Параметр = Новый ПараметрКомпоновкиДанных("ВыводитьДанныеОТипахТехники")
			И НЕ Элемент.Параметр = Новый ПараметрКомпоновкиДанных("ВыводитьЦветовуюИдентификациюОтклонений") Тогда
			МассивПараметров.Добавить("" + Элемент.ПредставлениеПользовательскойНастройки + ": " + Элемент.Значение);
			Если  Элемент.Параметр = Новый ПараметрКомпоновкиДанных("ПериодОтчета") Тогда
				СтруктураОформления.Вставить("ДатаНачала", Элемент.Значение.ДатаНачала);	
				СтруктураОформления.Вставить("ДатаОкончания", Элемент.Значение.ДатаОкончания);
			КонецЕсли;	
			Если  Элемент.Параметр = Новый ПараметрКомпоновкиДанных("ОбъектСтроительства") Тогда
				СтруктураОформления.Вставить("ОбъектСтроительства", Элемент.Значение);	
			КонецЕсли;	
		КонецЕсли; 
	КонецЦикла;
	
	МассивОтборов = Новый Массив;
	Для каждого Элемент Из НастройкиОтчета.Отбор.Элементы Цикл
		Если Элемент.Использование Тогда
			МассивОтборов.Добавить("" + Элемент.ЛевоеЗначение + " " + Элемент.ВидСравнения + " """ + Элемент.ПравоеЗначение + """");
		КонецЕсли; 
	КонецЦикла;
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Данные);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	ДанныеТЗ = Новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(ДанныеТЗ);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	ВыводитьЦветовуюИдентификациюОтклонений = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВыводитьЦветовуюИдентификациюОтклонений"));
	
	УсловноеОформление = НастройкиОтчета.УсловноеОформление.Элементы;
	Для каждого Элемент Из УсловноеОформление Цикл
		Если Элемент.Использование И Элемент.Представление = "Цвет фона шапки" Тогда
			СтруктураОформления.Вставить("ЦветФонаШапки", Элемент.Оформление.Элементы.Найти("ЦветФона").Значение);	
		КонецЕсли; 
		Если Элемент.Использование И Элемент.Представление = "Цвет фона этапа работы" Тогда
			СтруктураОформления.Вставить("ЦветФонаЭтапаРабот", Элемент.Оформление.Элементы.Найти("ЦветФона").Значение);	
		КонецЕсли; 
		Если Элемент.Использование И Элемент.Представление = "Цвет фона работы" Тогда
			СтруктураОформления.Вставить("ЦветФонаРаботы", Элемент.Оформление.Элементы.Найти("ЦветФона").Значение);	
		КонецЕсли; 
	КонецЦикла;
	Если ВыводитьЦветовуюИдентификациюОтклонений.Использование И ВыводитьЦветовуюИдентификациюОтклонений.Значение Тогда
		СтруктураОформления.Вставить("ВыводитьЦветовуюИдентификациюОтклонений", Истина);
	Иначе
		СтруктураОформления.Вставить("ВыводитьЦветовуюИдентификациюОтклонений", Ложь);
	КонецЕсли; 
	
	ВыводитьДанныеОРабочих      = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВыводитьДанныеОРабочих"));
	ВыводитьДанныеОТипахТехники = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВыводитьДанныеОТипахТехники"));
	
	СтруктураОформления.Вставить("ВыводитьДанныеОРабочих", ВыводитьДанныеОРабочих.Использование И ВыводитьДанныеОРабочих.Значение);
	СтруктураОформления.Вставить("ВыводитьДанныеОТипахТехники", ВыводитьДанныеОТипахТехники.Использование И ВыводитьДанныеОТипахТехники.Значение);
	
	СтруктураОформления.Вставить("ПараметрыДанных", МассивПараметров);
	СтруктураОформления.Вставить("Отбор",           МассивОтборов);
	ВывестиМакет(ДокументРезультат, Данные, СтрокаОбласти, СтруктураОформления);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВывестиРекурсивноРаботы(ДанныеРабота, ТекущийЛист, СтруктураОбластей, Уровень, СтруктураОформления, Макет, СтрокаОбласти)
	
	РозовыйЦвет = WebЦвета.Розовый;
	ЗеленыйЦвет = WebЦвета.СветлоЗеленый;
	
	ОбластьСтрокаРабота          = СтруктураОбластей.ОбластьСтрокаРабота;
	ОбластьСтрокаРесурс          = СтруктураОбластей.ОбластьСтрокаРесурс;
	ОбластьСтрокаДетальныеЗаписи = СтруктураОбластей.ОбластьСтрокаДетальныеЗаписи;
	ОбластьРаскраскиРабота       = СтруктураОбластей.ОбластьРаскраскиРабота;
	
	ОбластьРаскраскиОтклоненияПроцент                   = СтруктураОбластей.ОбластьРаскраскиОтклоненияПроцент;
	ОбластьРаскраскиТрудоемкостьОтклоненияПроцент       = СтруктураОбластей.ОбластьРаскраскиТрудоемкостьОтклоненияПроцент;
	ОбластьРаскраскиОбщаяМашиноемкостьОтклоненияПроцент = СтруктураОбластей.ОбластьРаскраскиОбщаяМашиноемкостьОтклоненияПроцент;
	ОбластьРаскраскиМашиноемкостьОтклоненияПроцент      = СтруктураОбластей.ОбластьРаскраскиМашиноемкостьОтклоненияПроцент;
	
	ДеревоРесурсов = Новый ДеревоЗначений;
	ДеревоРесурсов.Колонки.Добавить("Ресурс",, "Ресурс");
	ДеревоРесурсов.Колонки.Добавить("ОбщееКоличествоПлан", Новый ОписаниеТипов("Число"), "ОбщееКоличествоПлан");
	ДеревоРесурсов.Колонки.Добавить("ОбщаяТрудоемкостьПлан", Новый ОписаниеТипов("Число"), "ОбщаяТрудоемкостьПлан");
	ДеревоРесурсов.Колонки.Добавить("ОбщаяТрудоемкостьФакт", Новый ОписаниеТипов("Число"), "ОбщаяТрудоемкостьФакт");
	ДеревоРесурсов.Колонки.Добавить("ОбщаяМашиноемкостьПлан",Новый ОписаниеТипов("Число"), "ОбщаяМашиноемкостьПлан");
	ДеревоРесурсов.Колонки.Добавить("ОбщаяМашиноемкостьФакт", Новый ОписаниеТипов("Число"), "ОбщаяМашиноемкостьФакт");
	ДеревоРесурсов.Колонки.Добавить("ОбщаяМашиноемкостьОтклонения", Новый ОписаниеТипов("Число"), "ОбщаяМашиноемкостьОтклонения");
	ДеревоРесурсов.Колонки.Добавить("ОбщаяМашиноемкостьОтклоненияПроцент",Новый ОписаниеТипов("Число"), "ОбщаяМашиноемкостьОтклоненияПроцент");
	ДеревоРесурсов.Колонки.Добавить("ОбщаяТрудоемкостьОтклонения", Новый ОписаниеТипов("Число"), "ОбщаяТрудоемкостьОтклонения");
	ДеревоРесурсов.Колонки.Добавить("ОбщаяТрудоемкостьОтклоненияПроцент",Новый ОписаниеТипов("Число"), "ОбщаяТрудоемкостьОтклоненияПроцент");
	ДеревоРесурсов.Колонки.Добавить("МашиноемкостьОтклонения",Новый ОписаниеТипов("Число"), "МашиноемкостьОтклонения");
	ДеревоРесурсов.Колонки.Добавить("МашиноемкостьОтклоненияПроцент",Новый ОписаниеТипов("Число"), "МашиноемкостьОтклоненияПроцент");
	ДеревоРесурсов.Колонки.Добавить("ТрудоемкостьОтклонения",Новый ОписаниеТипов("Число"), "ТрудоемкостьОтклонения");
	ДеревоРесурсов.Колонки.Добавить("ТрудоемкостьОтклоненияПроцент",Новый ОписаниеТипов("Число"), "ТрудоемкостьОтклоненияПроцент");
	
	ДеревоРесурсов.Колонки.Добавить("КвоМеханизмов",Новый ОписаниеТипов("Число"), "КвоМеханизмов");
	ДеревоРесурсов.Колонки.Добавить("КвоРесурсов",Новый ОписаниеТипов("Число"), "КвоРесурсов");
	ДеревоРесурсов.Колонки.Добавить("Должность",, "Должность");
	ДеревоРесурсов.Колонки.Добавить("ТрудоемкостьПлан",Новый ОписаниеТипов("Число"), "ТрудоемкостьПлан");
	ДеревоРесурсов.Колонки.Добавить("ТрудоемкостьФакт",Новый ОписаниеТипов("Число"), "ТрудоемкостьФакт");
	ДеревоРесурсов.Колонки.Добавить("ТипМеханизма",, "ТипМеханизма");
	ДеревоРесурсов.Колонки.Добавить("МашиноемкостьПлан",Новый ОписаниеТипов("Число"), "МашиноемкостьПлан");
	ДеревоРесурсов.Колонки.Добавить("МашиноемкостьФакт",Новый ОписаниеТипов("Число"), "МашиноемкостьФакт");

	СтруктураРасшифровки = Новый Структура;
	СтруктураРасшифровки.Вставить("Справочник", ДанныеРабота.Работа);
	СтруктураРасшифровки.Вставить("Закладка",   "Ресурсы");
	СтруктураРасшифровки.Вставить("Имя",        "УСОERP_СтроительныеРаботы");
	
	СтруктураРасшифровкиРабота = Новый Структура;
	ГрафикРаботыОбъектаСтроительства = "";
	Попытка
		ГрафикРаботыОбъектаСтроительства = СтруктураОформления.ОбъектСтроительства.ГрафикРаботы;
	Исключение
	КонецПопытки;
	Если ЗначениеЗаполнено(ДанныеРабота.Работа.ГрафикРаботы) Тогда
		ГрафикРаботыОбъектаСтроительства = ДанныеРабота.Работа.ГрафикРаботы;
	КонецЕсли;
	
	ЕдиницыИзмеренияВремениЧас = Перечисления.ЕдиницыИзмеренияВремени.Час;
	
	Для Каждого Строка Из ДанныеРабота.Строки Цикл	
		Если ЗначениеЗаполнено(Строка.Работа)
			И НЕ ЗначениеЗаполнено(Строка.Ресурс)
			И НЕ ЗначениеЗаполнено(Строка.Должность)
			И НЕ ЗначениеЗаполнено(Строка.ТипМеханизма) Тогда
			ОбластьСтрокаРабота  = Макет.ПолучитьОбласть(СокрЛП("Строка" + СтрокаОбласти));
			ОбластьСтрокаРабота.Параметры.Заполнить(Строка);
			
			Если СтруктураОформления.Свойство("ЦветФонаЭтапаРабот")
				И Строка.Работа.СуммарнаяРабота Тогда
				ОбластьСтрокаРабота.Область(ОбластьРаскраскиРабота).ЦветФона = СтруктураОформления.ЦветФонаЭтапаРабот;
			ИначеЕсли СтруктураОформления.Свойство("ЦветФонаРаботы")
				И НЕ Строка.Работа.СуммарнаяРабота Тогда
				ОбластьСтрокаРабота.Область(ОбластьРаскраскиРабота).ЦветФона = СтруктураОформления.ЦветФонаРаботы;
			ИначеЕсли Строка.Работа.СуммарнаяРабота Тогда
				ОбластьСтрокаРабота.Область(ОбластьРаскраскиРабота).ЦветФона = Новый Цвет(248, 242, 216);
			Иначе
				ОбластьСтрокаРабота.Область(ОбластьРаскраскиРабота).ЦветФона = Новый Цвет(251, 249, 236);
			КонецЕсли; 
			
			ТекущийЛист.Вывести(ОбластьСтрокаРабота, Уровень);
			Если НЕ Строка.Работа.СуммарнаяРабота Тогда
				СтруктураРасшифровкиРабота.Вставить("Работа", Строка.Работа);	
				ТекущийЛист.Область(ТекущийЛист.ВысотаТаблицы, 5).Расшифровка = "Работа_" + Строка.Работа.УникальныйИдентификатор();
				ТекущийЛист.Область(ТекущийЛист.ВысотаТаблицы, 5).ПараметрРасшифровки = "Расшифровка работы";
			КонецЕсли;	
			ВывестиРекурсивноРаботы(Строка, ТекущийЛист, СтруктураОбластей, Уровень + 1, СтруктураОформления, Макет, СтрокаОбласти);
			
		ИначеЕсли ЗначениеЗаполнено(Строка.Работа) И ЗначениеЗаполнено(Строка.Ресурс)
			И НЕ ЗначениеЗаполнено(Строка.Должность)
			И НЕ ЗначениеЗаполнено(Строка.ТипМеханизма) Тогда
			НайденныеСтроки = ДеревоРесурсов.Строки.НайтиСтроки(Новый Структура("Ресурс", Строка.Ресурс));
			Если НайденныеСтроки.Количество() = 0 Тогда
				ВеткаРесурса = ДеревоРесурсов.Строки.Добавить();
				ВеткаРесурса.Ресурс = Строка.Ресурс;
				//нужно рассчитать общий план по отчету
				График                      = Строка.ГрафикРаботы;
				ГрафикРаботы                     = Строка.Работа.ГрафикРаботы;
				График = Строка.Работа.ГрафикРаботы;
				
				ДатаНачала = Дата('00010101');
				ДатаОкончания = Дата('00010101');
				Если Строка.НачалоРаботыПлан >= СтруктураОформления.ДатаНачала 
					И Строка.НачалоРаботыПлан <= СтруктураОформления.ДатаОкончания  Тогда
					ДатаНачала = Строка.НачалоРаботыПлан;
				ИначеЕсли Строка.НачалоРаботыПлан <= СтруктураОформления.ДатаНачала 
					И Строка.НачалоРаботыПлан <= СтруктураОформления.ДатаОкончания  Тогда
					ДатаНачала = СтруктураОформления.ДатаНачала;
				КонецЕсли;	
				Если Строка.ОкончаниеРаботыПлан >= СтруктураОформления.ДатаНачала 
					И Строка.ОкончаниеРаботыПлан <= СтруктураОформления.ДатаОкончания  Тогда
					ДатаОкончания = Строка.ОкончаниеРаботыПлан;
				КонецЕсли;	
				Если Строка.ОкончаниеРаботыПлан >= СтруктураОформления.ДатаНачала 
					И Строка.ОкончаниеРаботыПлан >= СтруктураОформления.ДатаОкончания  Тогда
					ДатаОкончания = СтруктураОформления.ДатаОкончания;
				КонецЕсли;
				ОбщаяТрудоемкостьПлан = 0;
				ОбщаяМашиноемкостьПлан = 0;
				Если ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания) Тогда
					Длительность = УСОERP_УправлениеСтроительнымПроизводством.РассчитатьДлительностьПериода(Строка.Работа, 
						ДатаНачала, 
						ДатаОкончания, 
						ЕдиницыИзмеренияВремениЧас,
						?(ЗначениеЗаполнено(График),График, ?(ЗначениеЗаполнено(ГрафикРаботы),ГрафикРаботы, ГрафикРаботыОбъектаСтроительства)));		
						
					ДлительностьПланЧас= ?(Строка.ЕдиницаДлительности = ЕдиницыИзмеренияВремениЧас, Строка.ДлительностьПлан, Длительность);
						
					КоличествоРабочих =  Новый Структура("Рабочие, Механизмы", Строка.Ресурс.Рабочие.Итог("Количество"), Строка.Ресурс.Механизмы.Итог("Количество"));
						
					ОбщаяТрудоемкостьПлан	= Строка.ОбщееКоличествоПлан * Строка.ЗагрузкаПроцент /100 * КоличествоРабочих.Рабочие* ДлительностьПланЧас;
					//+++>> Рарус Горский М.Е. 21.02.2018
					ОбщаяТрудоемкостьПлан = Строка.ОбщаяТрудоемкостьПлан;					
					//<<+++
					
					ОбщаяМашиноемкостьПлан	= Строка.ОбщееКоличествоПлан * Строка.ЗагрузкаПроцент /100 * КоличествоРабочих.Механизмы * ДлительностьПланЧас;
						
				КонецЕсли;	
					
				ВеткаРесурса.ОбщееКоличествоПлан    = Строка.ОбщееКоличествоПлан;
