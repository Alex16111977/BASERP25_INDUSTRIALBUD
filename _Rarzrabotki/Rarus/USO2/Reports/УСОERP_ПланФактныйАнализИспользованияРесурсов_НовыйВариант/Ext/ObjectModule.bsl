					И НЕ СтруктураОформления.ВыводитьДанныеОТипахТехники Тогда
					Если ЗначениеЗаполнено(ДетальнаяСтрока.Должность) Тогда
						СтруктураРМ = Новый Структура();
						СтруктураРМ.Вставить("Ресурс",        "Ресурс_" + СтрокаРесурс.Ресурс.УникальныйИдентификатор());
						СтруктураРМ.Вставить("РаботаРесурса", "Работа_" + Строка.Работа.УникальныйИдентификатор());
						СтруктураРМ.Вставить("ТипМеханизма",  "Должность_" + ДетальнаяСтрока.Должность.УникальныйИдентификатор());
						ТекущийЛист.Область(ТекущийЛист.ВысотаТаблицы, 13).Расшифровка = СтруктураРМ;
					КонецЕсли; 
					
				ИначеЕсли СтруктураОформления.ВыводитьДанныеОРабочих 
					И СтруктураОформления.ВыводитьДанныеОТипахТехники Тогда
					Если ЗначениеЗаполнено(ДетальнаяСтрока.Должность) Тогда
						СтруктураРМ2 = Новый Структура();
						СтруктураРМ2.Вставить("Ресурс",        "Ресурс_" + СтрокаРесурс.Ресурс.УникальныйИдентификатор());
						СтруктураРМ2.Вставить("РаботаРесурса", "Работа_" + Строка.Работа.УникальныйИдентификатор());
						СтруктураРМ2.Вставить("ТипМеханизма",  "Должность_" + ДетальнаяСтрока.Должность.УникальныйИдентификатор());
						ТекущийЛист.Область(ТекущийЛист.ВысотаТаблицы, 13).Расшифровка = СтруктураРМ2;
					КонецЕсли; 
					Если ЗначениеЗаполнено(ДетальнаяСтрока.ТипМеханизма) Тогда
						СтруктураРМ3 = Новый Структура();
						СтруктураРМ3.Вставить("Ресурс",        "Ресурс_" + СтрокаРесурс.Ресурс.УникальныйИдентификатор());
						СтруктураРМ3.Вставить("РаботаРесурса", "Работа_" + Строка.Работа.УникальныйИдентификатор());
						СтруктураРМ3.Вставить("ТипМеханизма",  "Транспорт_" + ДетальнаяСтрока.ТипМеханизма.УникальныйИдентификатор());
						ТекущийЛист.Область(ТекущийЛист.ВысотаТаблицы, 22).Расшифровка = СтруктураРМ3;
					КонецЕсли; 
				ИначеЕсли НЕ СтруктураОформления.ВыводитьДанныеОРабочих 
					И СтруктураОформления.ВыводитьДанныеОТипахТехники Тогда
					Если ЗначениеЗаполнено(ДетальнаяСтрока.ТипМеханизма) Тогда
						СтруктураРМ4 = Новый Структура();
						СтруктураРМ4.Вставить("Ресурс",        "Ресурс_" + СтрокаРесурс.Ресурс.УникальныйИдентификатор());
						СтруктураРМ4.Вставить("РаботаРесурса", "Работа_" + Строка.Работа.УникальныйИдентификатор());
						СтруктураРМ4.Вставить("ТипМеханизма",  "Транспорт_" + ДетальнаяСтрока.ТипМеханизма.УникальныйИдентификатор());
						ТекущийЛист.Область(ТекущийЛист.ВысотаТаблицы, 17).Расшифровка = СтруктураРМ4;
					КонецЕсли; 
				КонецЕсли; 
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;                                     
	ДеревоРесурсов.Строки.Очистить();                          
															   
	
КонецПроцедуры

Процедура ВывестиМакет(ДокументРезультат, Данные, СтрокаОбласти, СтруктураОформления)
	
	ДокументРезультат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ДокументРезультат.АвтоМасштаб = Истина;
	
	ТекущийЛист = Новый ТабличныйДокумент;
	
	//Попытка
	//	Макет = УправлениеПечатью.МакетПечатнойФормы("Отчет.УСОERP_ПланФактныйАнализИспользованияРесурсов.МакетОтчета");
	//Исключение
		Макет = ПолучитьМакет("МакетОтчета");
	//КонецПопытки;
	
	ОбластьШапка         = Макет.ПолучитьОбласть("Шапка");
	ОбластьПараметры     = Макет.ПолучитьОбласть("СекцияПараметры");
	ОбластьЗаголовок     = Макет.ПолучитьОбласть(СокрЛП("Заголовок" + СтрокаОбласти));
	ОбластьСтрокаРабота  = Макет.ПолучитьОбласть(СокрЛП("Строка" + СтрокаОбласти));  
	ОбластьСтрокаРесурс  = Макет.ПолучитьОбласть(СокрЛП("СтрокаРесурс" + СтрокаОбласти));  
	ОбластьСтрокаДетальныеЗаписи        = Макет.ПолучитьОбласть(СокрЛП("СтрокаДетальныеЗаписи" + СтрокаОбласти));
	
	ОбластьРаскраскиЗаголовок = "ОбластьРаскраскиШапки" + СтрокаОбласти;
	ОбластьРаскраскиРабота    = "ОбластьРаскраски" + СтрокаОбласти;
	ОбластьРаскраскиОтклоненияПроцент                   = "ОбластьРаскраскиОтклоненияПроцент" + СтрокаОбласти;
	ОбластьРаскраскиТрудоемкостьОтклоненияПроцент       = "ОбластьРаскраскиТрудоемкостьОтклоненияПроцент" + СтрокаОбласти;
	ОбластьРаскраскиОбщаяМашиноемкостьОтклоненияПроцент = "ОбластьРаскраскиОбщаяМашиноемкостьОтклоненияПроцент" + СтрокаОбласти;
	ОбластьРаскраскиМашиноемкостьОтклоненияПроцент      = "ОбластьРаскраскиМашиноемкостьОтклоненияПроцент" + СтрокаОбласти;
	
	Если СтруктураОформления.Свойство("ЦветФонаШапки") Тогда
		ОбластьЗаголовок.Область(ОбластьРаскраскиЗаголовок).ЦветФона = СтруктураОформления.ЦветФонаШапки;
	КонецЕсли; 
	
	ТекущийЛист.Вывести(ОбластьШапка);
	
	ТекущийЛист.НачатьАвтогруппировкуСтрок();
	ОбластьПараметры.Параметры.ТекстЗаголовка = "Параметры:";
	Для каждого ЭлементМассива Из СтруктураОформления.ПараметрыДанных Цикл
		ОбластьПараметры.Параметры.Параметры = ЭлементМассива;
		ТекущийЛист.Вывести(ОбластьПараметры, 2, "Параметры");
		ОбластьПараметры.Параметры.ТекстЗаголовка = "";
	КонецЦикла;
	ОбластьПараметры.Параметры.ТекстЗаголовка = "Отбор:";
	Для каждого ЭлементМассива Из СтруктураОформления.Отбор Цикл
		ОбластьПараметры.Параметры.Параметры = ЭлементМассива;
		ТекущийЛист.Вывести(ОбластьПараметры, 2);
		ОбластьПараметры.Параметры.ТекстЗаголовка = "";
	КонецЦикла;
	
	ТекущийЛист.ЗакончитьАвтогруппировкуСтрок();
	
	ТекущийЛист.Вывести(ОбластьЗаголовок);
	ТекущийЛист.НачатьАвтогруппировкуСтрок();
	СтруктураОбластей = Новый Структура("ОбластьСтрокаРабота, ОбластьСтрокаРесурс, ОбластьСтрокаДетальныеЗаписи, ОбластьРаскраскиРабота,
							|ОбластьРаскраскиОтклоненияПроцент, ОбластьРаскраскиТрудоемкостьОтклоненияПроцент,
							|ОбластьРаскраскиОбщаяМашиноемкостьОтклоненияПроцент, ОбластьРаскраскиМашиноемкостьОтклоненияПроцент", 
							ОбластьСтрокаРабота, ОбластьСтрокаРесурс, ОбластьСтрокаДетальныеЗаписи, ОбластьРаскраскиРабота, 
							ОбластьРаскраскиОтклоненияПроцент, ОбластьРаскраскиТрудоемкостьОтклоненияПроцент,
							ОбластьРаскраскиОбщаяМашиноемкостьОтклоненияПроцент, ОбластьРаскраскиМашиноемкостьОтклоненияПроцент);
							
	Для Каждого ДанныеРабота Из Данные.Строки Цикл	
		
		ОбластьСтрокаРабота.Параметры.Заполнить(ДанныеРабота);		
		
		Если СтруктураОформления.Свойство("ЦветФонаЭтапаРабот")
			И ДанныеРабота.Работа.СуммарнаяРабота Тогда
			ОбластьСтрокаРабота.Область(ОбластьРаскраскиРабота).ЦветФона = СтруктураОформления.ЦветФонаЭтапаРабот;
		ИначеЕсли СтруктураОформления.Свойство("ЦветФонаРаботы")
			И НЕ ДанныеРабота.Работа.СуммарнаяРабота Тогда
			ОбластьСтрокаРабота.Область(ОбластьРаскраскиРабота).ЦветФона = СтруктураОформления.ЦветФонаРаботы;
		ИначеЕсли ДанныеРабота.Работа.СуммарнаяРабота Тогда
			ОбластьСтрокаРабота.Область(ОбластьРаскраскиРабота).ЦветФона = Новый Цвет(248, 242, 216);
		Иначе
			ОбластьСтрокаРабота.Область(ОбластьРаскраскиРабота).ЦветФона = Новый Цвет(251, 249, 236);
		КонецЕсли; 

		ТекущийЛист.Вывести(ОбластьСтрокаРабота, 0);
		ВывестиРекурсивноРаботы(ДанныеРабота, ТекущийЛист, СтруктураОбластей, 1, СтруктураОформления, Макет, СтрокаОбласти);
	КонецЦикла;
	ТекущийЛист.ЗакончитьАвтогруппировкуСтрок();
	ТекущийЛист.ВывестиГоризонтальныйРазделительСтраниц();				
	
	Если ТекущийЛист.ВысотаТаблицы > 0 Тогда
		ДокументРезультат.Вывести(ТекущийЛист);
	КонецЕсли;
	
КонецПроцедуры	

Функция	ОпределитьОбластиВывода(НастройкиОтчета);
	
	ВыводитьДанныеОРабочих      = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВыводитьДанныеОРабочих"));
	ВыводитьДанныеОТипахТехники = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВыводитьДанныеОТипахТехники"));
	
	СтрокаОбласти = "";
	Если ВыводитьДанныеОРабочих.Использование И ВыводитьДанныеОРабочих.Значение Тогда	
		 СтрокаОбласти = СтрокаОбласти + "Рабочие";
	КонецЕсли;	
	
	Если ВыводитьДанныеОТипахТехники.Использование И ВыводитьДанныеОТипахТехники.Значение Тогда	
		СтрокаОбласти = СтрокаОбласти + "Механизмы";
	КонецЕсли;	

	Возврат СтрокаОбласти;  
	
КонецФункции

#КонецОбласти

#КонецЕсли