		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаказыПоставщикамОстатки.ЗаказПоставщику,
	ЗаказыПоставщикамОстатки.Номенклатура,
	ЗаказыПоставщикамОстатки.Характеристика,
	ЗаказПоставщикуТовары.ДатаПоступления,
	ЗаказыПоставщикамОстатки.ЗаказаноОстаток КАК КоличествоОстаток,
	ЗаказПоставщикуТовары.Количество КАК КоличествоВЗаказеПоставщику
ПОМЕСТИТЬ ЗаказОстаток
ИЗ
	РегистрНакопления.ЗаказыПоставщикам.Остатки(
			,
			ЗаказПоставщику ССЫЛКА Документ.ЗаказПоставщику
				И ЗаказПоставщику.УСОERP_Доставка
				И ЗаказПоставщику.Статус &lt;&gt; ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщикам.Закрыт) {(Номенклатура = &amp;Номенклатура), (ЗаказПоставщику.Организация = &amp;Организация), (ЗаказПоставщику.Контрагент = &amp;Контрагент), (ЗаказПоставщику.Партнер = &amp;Партнер)}) КАК ЗаказыПоставщикамОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		ПО ЗаказыПоставщикамОстатки.ЗаказПоставщику = ЗаказПоставщикуТовары.Ссылка
			И ЗаказыПоставщикамОстатки.Номенклатура = ЗаказПоставщикуТовары.Номенклатура
			И ЗаказыПоставщикамОстатки.КодСтроки = ЗаказПоставщикуТовары.КодСтроки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ДанныеДоставкиОстаткиИОбороты.ЗаказПоставщику,
	ДанныеДоставкиОстаткиИОбороты.Номенклатура,
	ДанныеДоставкиОстаткиИОбороты.Характеристика,
	ДанныеДоставкиОстаткиИОбороты.ЗаказНаДоставку КАК ЗаказНаПеревозку,
	ДанныеДоставкиОстаткиИОбороты.ДатаПоступления,
	ДанныеДоставкиОстаткиИОбороты.КоличествоКонечныйОстаток КАК КоличествоВДоставке,
	ЕСТЬNULL(ЗаказНаПеревозкуКДоставке.Количество, 0) КАК КоличествоВЗаказеНаПеревозку
ПОМЕСТИТЬ Доставка
ИЗ
	РегистрНакопления.УСОERP_ДанныеДоставки.ОстаткиИОбороты(, , , , ЗаказПоставщику.УСОERP_Доставка И ЗаказПоставщику.Статус &lt;&gt; ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщикам.Закрыт) {(ОжидаемаяДатаДоставки &lt;= &amp;Период), (Номенклатура = &amp;Номенклатура), (Организация = &amp;Организация), (Контрагент = &amp;Контрагент), (Партнер = &amp;Партнер)}) КАК ДанныеДоставкиОстаткиИОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УСОERP_ЗаказНаПеревозку.КДоставке КАК ЗаказНаПеревозкуКДоставке
		ПО ДанныеДоставкиОстаткиИОбороты.Номенклатура = ЗаказНаПеревозкуКДоставке.Номенклатура
			И ДанныеДоставкиОстаткиИОбороты.Характеристика = ЗаказНаПеревозкуКДоставке.Характеристика
			И ДанныеДоставкиОстаткиИОбороты.ЗаказНаДоставку = ЗаказНаПеревозкуКДоставке.Ссылка
			И ДанныеДоставкиОстаткиИОбороты.ЗаказПоставщику = ЗаказНаПеревозкуКДоставке.ЗаказПоставщику
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕСТЬNULL(Доставка.ЗаказПоставщику, ЗаказОстаток.ЗаказПоставщику) КАК ЗаказПоставщику,
	ЕСТЬNULL(Доставка.Номенклатура, ЗаказОстаток.Номенклатура) КАК Номенклатура,
	ЕСТЬNULL(Доставка.Характеристика, ЕСТЬNULL(Доставка.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))) КАК Характеристика,
	ЕСТЬNULL(Доставка.ЗаказНаПеревозку, ЗНАЧЕНИЕ(Документ.УСОERP_ЗаказНаПеревозку.ПустаяСсылка)) КАК ЗаказНаПеревозку,
	ЕСТЬNULL(Доставка.ЗаказНаПеревозку.ВидДоставки, ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыДоставки.ПустаяСсылка)) КАК ВидДоставки,
	ЕСТЬNULL(Доставка.КоличествоВДоставке, 0) КАК КоличествоВДоставке,
	ЕСТЬNULL(ЗаказОстаток.КоличествоОстаток, 0) КАК КоличествоОстаток,
	ЕСТЬNULL(Доставка.КоличествоВЗаказеНаПеревозку, 0) КАК КоличествоВЗаказеНаПеревозку,
	ЕСТЬNULL(ЗаказОстаток.КоличествоВЗаказеПоставщику, ЕСТЬNULL(ЗаказОстаток.КоличествоОстаток, 0)) КАК КоличествоВЗаказеПоставщику,
	ЕСТЬNULL(ЗаказОстаток.КоличествоВЗаказеПоставщику, ЕСТЬNULL(ЗаказОстаток.КоличествоОстаток, 0)) - ЕСТЬNULL(Доставка.КоличествоВДоставке, 0) КАК КоличествоБезДоставки
ПОМЕСТИТЬ ИтоговыеДанные
ИЗ
	Доставка КАК Доставка
		ПОЛНОЕ СОЕДИНЕНИЕ ЗаказОстаток КАК ЗаказОстаток
		ПО Доставка.ЗаказПоставщику = ЗаказОстаток.ЗаказПоставщику
			И Доставка.Номенклатура = ЗаказОстаток.Номенклатура
			И Доставка.Характеристика = ЗаказОстаток.Характеристика
			И Доставка.ДатаПоступления = ЗаказОстаток.ДатаПоступления
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	ИтоговыеДанные.ЗаказПоставщику,
	ИтоговыеДанные.Номенклатура,
	ИтоговыеДанные.Характеристика,
	ИтоговыеДанные.ВидДоставки,
	ИтоговыеДанные.ЗаказНаПеревозку,
	ЕСТЬNULL(ЗаданиеНаПеревозкуРаспоряжения.Ссылка, ЗНАЧЕНИЕ(Документ.ЗаданиеНаПеревозку.ПустаяСсылка)) КАК ЗаданиеНаПеревозку,
	Склады.Ссылка КАК Склад,
	Склады.УСОERP_ОбъектСтроительства КАК ОбъектСтроительства,
	СУММА(ИтоговыеДанные.КоличествоОстаток) КАК КоличествоОстаток,
	СУММА(ИтоговыеДанные.КоличествоВДоставке) КАК КоличествоВДоставке,
	СУММА(ИтоговыеДанные.КоличествоБезДоставки) КАК КоличествоБезДоставки,
	СУММА(ВЫБОР
			КОГДА НЕ ЗаданиеНаПеревозкуРаспоряжения.Ссылка ЕСТЬ NULL 
				ТОГДА ИтоговыеДанные.КоличествоВДоставке - ИтоговыеДанные.КоличествоВЗаказеНаПеревозку
			ИНАЧЕ 0
		КОНЕЦ) КАК КоличествоБезПеревозки
ИЗ
	ИтоговыеДанные КАК ИтоговыеДанные
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Склады КАК Склады
		ПО ИтоговыеДанные.ЗаказПоставщику.Склад = Склады.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаПеревозку.Распоряжения КАК ЗаданиеНаПеревозкуРаспоряжения
		ПО ИтоговыеДанные.ЗаказНаПеревозку = ЗаданиеНаПеревозкуРаспоряжения.Распоряжение

СГРУППИРОВАТЬ ПО
	ИтоговыеДанные.ЗаказПоставщику,
	ИтоговыеДанные.Номенклатура,
	ИтоговыеДанные.Характеристика,
	ИтоговыеДанные.ВидДоставки,
	ИтоговыеДанные.ЗаказНаПеревозку,
	Склады.Ссылка,
	Склады.УСОERP_ОбъектСтроительства,
	ЕСТЬNULL(ЗаданиеНаПеревозкуРаспоряжения.Ссылка, ЗНАЧЕНИЕ(Документ.ЗаданиеНаПеревозку.ПустаяСсылка))</query>
	</dataSet>
	<totalField>
		<dataPath>КоличествоБезДоставки</dataPath>
		<expression>Сумма(КоличествоБезДоставки)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоБезПеревозки</dataPath>
		<expression>Сумма(КоличествоБезПеревозки)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоВДоставке</dataPath>
		<expression>Сумма(КоличествоВДоставке)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоОстаток</dataPath>
		<expression>Сумма(КоличествоОстаток)</expression>
	</totalField>
