
#Область СлужебныеПроцедурыИФункции

Процедура УдалитьЯчейки(ИмяПарам,ИмяПарамИтог,ИндЯчейки,ЭлементВывода) 
	Парам = ЭлементВывода.Макеты.Макет4.Параметры.Найти(ИмяПарам);
	Если Парам<>Неопределено Тогда
		ЭлементВывода.Макеты.Макет4.Параметры.Удалить(Парам);
		Инд = ЭлементВывода.Макеты.Макет4.Макет[0].Ячейки.Получить(ИндЯчейки);
		ЭлементВывода.Макеты.Макет4.Макет[0].Ячейки.Удалить(Инд);
	КонецЕсли;
	Парам = ЭлементВывода.Макеты.Макет6.Параметры.Найти(ИмяПарам);
	Если Парам<>Неопределено Тогда
		ЭлементВывода.Макеты.Макет6.Параметры.Удалить(Парам);
		Инд = ЭлементВывода.Макеты.Макет6.Макет[0].Ячейки.Получить(ИндЯчейки);
		ЭлементВывода.Макеты.Макет6.Макет[0].Ячейки.Удалить(Инд);
	КонецЕсли;
	Парам = ЭлементВывода.Макеты.Макет7.Параметры.Найти(ИмяПарам);
	Если Парам<>Неопределено Тогда
		ЭлементВывода.Макеты.Макет7.Параметры.Удалить(Парам);
		Инд = ЭлементВывода.Макеты.Макет7.Макет[0].Ячейки.Получить(ИндЯчейки);
		ЭлементВывода.Макеты.Макет7.Макет[0].Ячейки.Удалить(Инд);
	КонецЕсли;
	Парам = ЭлементВывода.Макеты.Макет5.Параметры.Найти(ИмяПарамИтог);
	Если Парам<>Неопределено Тогда
		ЭлементВывода.Макеты.Макет5.Параметры.Удалить(Парам);
		Инд = ЭлементВывода.Макеты.Макет5.Макет[0].Ячейки.Получить(ИндЯчейки);
		ЭлементВывода.Макеты.Макет5.Макет[0].Ячейки.Удалить(Инд);
	КонецЕсли;
	Парам = ЭлементВывода.Макеты.Макет3.Параметры.Найти(ИмяПарамИтог);
	Если Парам<>Неопределено Тогда
		ЭлементВывода.Макеты.Макет3.Параметры.Удалить(Парам);
		Инд = ЭлементВывода.Макеты.Макет3.Макет[0].Ячейки.Получить(ИндЯчейки);
		ЭлементВывода.Макеты.Макет3.Макет[0].Ячейки.Удалить(Инд);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	СхемаКомпоновкиДанных = ЭтотОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Настройки = ЭтотОбъект.КомпоновщикНастроек.Настройки;//СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	ИД = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период")).ИдентификаторПользовательскойНастройки;
	Период = ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ИД);
	
	СтандартнаяОбработка = Ложь; // отключаем стандартный вывод отчета - будем выводить программно 
	КомпоновщикНастроек.Настройки.ПараметрыВывода.Элементы.Найти("Title").Значение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Реестр смет %1'"), Строка(Период.Значение));
	Настройки = КомпоновщикНастроек.ПолучитьНастройки() ;// Получаем настройки отчета 
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных; // Создаем данные расшифровки 
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных; // Создаем компоновщик макета 
	// Инициализируем макет компоновки используя схему компоновки данных 
	// и созданные ранее настройки и данные расшифровки.
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	
	// Скомпонуем результат
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);
	
	ДокументРезультат.Очистить();
	
	// Выводим результат в табличный документ.
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);	
	
	ПроцессорВывода.НачатьВывод();
	
	Параметры = Новый Структура;
	
	ПередВыводомМакета(ДокументРезультат, МакетКомпоновки, Параметры);
	
	Если Настройки.Выбор.Элементы.Количество()> 0 Тогда
		ЭлементВывода = ПроцессорКомпоновки.Следующий();
		Сч =0;
		Для каждого Эл Из Настройки.Выбор.Элементы Цикл
			Если эл.Использование = Ложь Тогда
				Если Строка(эл.Поле) = "Заказчик" Тогда
					УдалитьЯчейки("П4","П1",3,ЭлементВывода);
					Сч = Сч+1;
				ИначеЕсли Строка(эл.Поле) = "Подрядчик" Тогда
					УдалитьЯчейки("П5","П2",4-Сч,ЭлементВывода);
					Сч = Сч+1;
				ИначеЕсли Строка(эл.Поле) = "ДатаТекущихЦен" Тогда
					УдалитьЯчейки("П6","П3",5-Сч,ЭлементВывода);
					Сч = Сч+1;
				ИначеЕсли Строка(эл.Поле) = "ДатаИндексов" Тогда	
					УдалитьЯчейки("П7","П4",6-Сч,ЭлементВывода);
					Сч = Сч+1;
				ИначеЕсли Строка(эл.Поле) = "Стройка" Тогда
					УдалитьЯчейки("П8","П5",7-Сч,ЭлементВывода);
					Сч = Сч+1;
				ИначеЕсли Строка(эл.Поле) = "Район" Тогда
					УдалитьЯчейки("П9","П6",8-Сч,ЭлементВывода);
					Сч = Сч+1;
				ИначеЕсли Строка(эл.Поле) = "ПЗ" Тогда
					УдалитьЯчейки("П10","П7",9-Сч,ЭлементВывода);
					Сч = Сч+1;
				ИначеЕсли Строка(эл.Поле) = "ОЗ" Тогда
					УдалитьЯчейки("П11","П8",10-Сч,ЭлементВывода);
					Сч = Сч+1;
				ИначеЕсли Строка(эл.Поле) = "ЭМ" Тогда
					УдалитьЯчейки("П12","П9",11-Сч,ЭлементВывода);
					Сч = Сч+1;
				ИначеЕсли Строка(эл.Поле) = "ЗМ" Тогда	
					УдалитьЯчейки("П13","П10",12-Сч,ЭлементВывода);
					Сч = Сч+1;
				ИначеЕсли Строка(эл.Поле) = "МАТ" Тогда
					УдалитьЯчейки("П14","П11",13-Сч,ЭлементВывода);
					Сч = Сч+1;
				ИначеЕсли Строка(эл.Поле) = "Оборуд" Тогда
					УдалитьЯчейки("П15","П12",14-Сч,ЭлементВывода);
					Сч = Сч+1;
				ИначеЕсли Строка(эл.Поле) = "НР" Тогда
					УдалитьЯчейки("П16","П13",15-Сч,ЭлементВывода);
					Сч = Сч+1;
				ИначеЕсли Строка(эл.Поле) = "СП" Тогда
					УдалитьЯчейки("П17","П14",16-Сч,ЭлементВывода);
					Сч = Сч+1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		ПроцессорКомпоновки.Сбросить();
	КонецЕсли;
	
	Пока Истина Цикл
		
		ЭлементВывода = ПроцессорКомпоновки.Следующий();
		Если ЭлементВывода = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Отказ = Ложь;
		
		ПередВыводомЭлементаМакета(ДокументРезультат, МакетКомпоновки, ЭлементВывода, Параметры, Отказ);
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		ПроцессорВывода.ВывестиЭлемент(ЭлементВывода);
		
	КонецЦикла;
	
	ПроцессорВывода.ЗакончитьВывод();	
	
	
	ДокументРезультат.НижнийКолонтитул.Выводить = Истина;
	ДокументРезультат.НижнийКолонтитул.Шрифт = Новый Шрифт(ДокументРезультат.НижнийКолонтитул.Шрифт, , , , Истина);
	ДокументРезультат.НижнийКолонтитул.ТекстВЦентре = НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	ДокументРезультат.ФиксацияСверху = 4;
	ДокументРезультат.ФиксацияСлева = 3;
	ДокументРезультат.ПовторятьПриПечатиСтроки = Параметры.ОбластьШапкиОтчета;
	
КонецПроцедуры

Процедура ПередВыводомМакета(Результат, МакетКомпоновки, Параметры)
	
	НачатьПоискОбластиШапкиОтчета(МакетКомпоновки, Параметры);
	
КонецПроцедуры

Процедура ПередВыводомЭлементаМакета(Результат, МакетКомпоновки, ЭлементВывода, Параметры, Отказ)
	
	НайтиОбластьШапкиОтчета(Результат, ЭлементВывода, Параметры);
	
КонецПроцедуры

// Вызывается в обработчике "ПередВыводомМакета".
//
Процедура НачатьПоискОбластиШапкиОтчета(МакетКомпоновки, ПараметрыОтчета)
	
	ПараметрыОтчета.Вставить("МакетШапки", ПолучитьМакетШапки(МакетКомпоновки.Тело));
	
КонецПроцедуры

// Возвращает имя макета шапки отчета.
//
Функция ПолучитьМакетШапки(ТелоМакетаКомпоновки)
	
	КоличествоЭлементовТела = ТелоМакетаКомпоновки.Количество();
	Для ИндексЭлемента = 0 По КоличествоЭлементовТела - 1 Цикл
		
		ЭлементТела = ТелоМакетаКомпоновки[ИндексЭлемента];
		Если ТипЗнч(ЭлементТела) = Тип("ТаблицаМакетаКомпоновкиДанных")
			И Не ПустаяСтрока(ЭлементТела.МакетШапки) Тогда
			
			Возврат ЭлементТела.МакетШапки;
			
		ИначеЕсли ТипЗнч(ЭлементТела) = Тип("ГруппировкаМакетаКомпоновкиДанных") И ИндексЭлемента > 0
			И ТипЗнч(ТелоМакетаКомпоновки[ИндексЭлемента - 1]) = Тип("МакетОбластиМакетаКомпоновкиДанных") 
			И Не ПустаяСтрока(ТелоМакетаКомпоновки[ИндексЭлемента - 1].Макет) Тогда
			
			Возврат ТелоМакетаКомпоновки[ИндексЭлемента - 1].Макет;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Вызывается в обработчике "ПередВыводомЭлементаМакета".
//
Процедура НайтиОбластьШапкиОтчета(Результат, ЭлементВывода, ПараметрыОтчета)
	
	Если Не ПараметрыОтчета.Свойство("ОбластьШапкиОтчета") Тогда
		Если ПустаяСтрока(ПараметрыОтчета.МакетШапки) Тогда
			ПараметрыОтчета.Вставить("ОбластьШапкиОтчета");
		ИначеЕсли Не ПараметрыОтчета.Свойство("НомерСтрокиШапкиНачало") И ЭлементВывода.Макет = ПараметрыОтчета.МакетШапки Тогда
			ПараметрыОтчета.Вставить("НомерСтрокиШапкиНачало", Результат.ВысотаТаблицы + 1);
		ИначеЕсли ПараметрыОтчета.Свойство("НомерСтрокиШапкиНачало") Тогда
			ПараметрыОтчета.Вставить("НомерСтрокиШапкиКонец", Результат.ВысотаТаблицы);
			ПараметрыОтчета.Вставить("ОбластьШапкиОтчета", Результат.Область(ПараметрыОтчета.НомерСтрокиШапкиНачало, , ПараметрыОтчета.НомерСтрокиШапкиКонец));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти