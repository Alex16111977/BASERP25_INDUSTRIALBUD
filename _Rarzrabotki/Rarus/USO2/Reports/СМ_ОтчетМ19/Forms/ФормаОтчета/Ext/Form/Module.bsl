
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОткрытыеОкна = ПолучитьОкна();
	Для Каждого ТекОкно Из ОткрытыеОкна Цикл
		Если ТекОкно.Основное ИЛИ ТекОкно.НачальнаяСтраница Тогда
			Продолжить;
		КонецЕсли;
		ФормаОкна = ТекОкно.Содержимое[0];
		Если ФормаОкна.ИмяФормы = "Документ.СМ_АктВыполненныхРабот.Форма.ФормаДокументаУпр" Тогда
			АктВыполненныхРабот = ФормаОкна.Объект.Ссылка;
			Если ЗначениеЗаполнено(АктВыполненныхРабот) Тогда
				ЭтаФорма.АктВыполненныхРабот = АктВыполненныхРабот; 
				ЗаполнитьЛимЗатратуНДСАкт(ЭтаФорма.АктВыполненныхРабот);
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ВидимостьНескольких();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	ЛокальнаяСмета.Добавить(ВыбранноеЗначение);
	ПодобратьАктыВыполненныхРаботНаСервере();
	ЗаполнитьЛимЗатратуНДССмета(ВыбранноеЗначение);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.ЛимЗатратаНДС = Справочники.СМ_ЛимитированныеЗатраты.НайтиПоРеквизиту("Идентификатор","ЛЗ64");
	
	//Если РольДоступна(Метаданные.Роли.ПолныеПрава) ИЛИ 
	//  	 РольДоступна(Метаданные.Роли.СМ_АдминистраторСмета) ИЛИ
	//	 РольДоступна(Метаданные.Роли.СМ_РедактированиеНСИ) Тогда
	Элементы.ЛимзатратаНДС.Доступность 		= Истина;
	Элементы.ЛимзатратаНДС.ТолькоПросмотр 	= Ложь;
	//Иначе
	//	Элементы.ЛимзатратаНДС.Доступность 		= Ложь;
	//	Элементы.ЛимзатратаНДС.ТолькоПросмотр 	= Истина;
	//КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЛокальнаяСметаПриИзменении(Элемент)
	
	ПодобратьАктыВыполненныхРаботНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ЛокальнаяСметаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка 	= Ложь;
	СтруктураПараметров 	= Новый Структура;
	СтруктураПараметров.Вставить("БезПомеченных",Истина);
	СтруктураПараметров.Вставить("МножественныйВыбор",Истина);
	СтруктураПараметров.Вставить("ЗакрыватьПриВыборе",Ложь);
	СтруктураПараметров.Вставить("ЕстьАкты",Истина);
	СтруктураПараметров.Вставить("ОтборСтройка",Истина);
	
	ОписаниеОЗакрытииФормыВыбораЛС = Новый ОписаниеОповещения("ПриЗакрытииФормыПодбораЛС",ЭтаФорма);
	ОткрытьФорму("Обработка.СМ_ДеревоСметПростое.Форма.ФормаУпр",СтруктураПараметров,ЭтаФорма,Новый УникальныйИдентификатор(),,,ОписаниеОЗакрытииФормыВыбораЛС,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокальнаяСметаОткрытие(Элемент, СтандартнаяОбработка)
	ОписаниеОп = Новый ОписаниеОповещения("ПриЗакрытииСпискаЛС",ЭтаФорма);
	ЛокальнаяСмета.ПоказатьВыборЭлемента(ОписаниеОп,НСтр("ru='Какую смету убрать?'"));
КонецПроцедуры

&НаКлиенте
Процедура НесколькоАктовПриИзменении(Элемент)
	
	ВидимостьНескольких();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыАктыВыполненныхРабот

&НаКлиенте
Процедура АктыВыполненныхРаботИспользоватьПриИзменении(Элемент)
		
	Если Элементы.АктыВыполненныхРабот.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		ЭлементыДерева = Элементы.АктыВыполненныхРабот.ТекущиеДанные.ПолучитьЭлементы();
		Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
			ЭлементДерева.Использовать = Элементы.АктыВыполненныхРабот.ТекущиеДанные.Использовать;
		КонецЦикла;
	Иначе
		ИзменитьПризнакРодителя = Истина;
		ЭлементыДерева = Элементы.АктыВыполненныхРабот.ТекущиеДанные.ПолучитьРодителя().ПолучитьЭлементы();
		Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
			Если ЭлементДерева.Использовать <> Элементы.АктыВыполненныхРабот.ТекущиеДанные.Использовать Тогда
				ИзменитьПризнакРодителя = Ложь;
			КонецЕсли;
		КонецЦикла;
		Если ИзменитьПризнакРодителя Тогда
			Элементы.АктыВыполненныхРабот.ТекущиеДанные.ПолучитьРодителя().Использовать = Элементы.АктыВыполненныхРабот.ТекущиеДанные.Использовать;	
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	
	// Сформировать отчет.
	СформироватьНаСервере();
	
	// Скрыть информационную надпись.
	Элементы.Результат.ОтображениеСостояния.Видимость	= Ложь;
	Элементы.Результат.ОтображениеСостояния.ДополнительныйРежимОтображения	= ДополнительныйРежимОтображения.НеИспользовать;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьНаСервере()
	
	АктВыполненныхРабот	= ЭтаФорма.АктВыполненныхРабот;
	ОтчетОбъект 		= РеквизитФормыВЗначение("Отчет");
	МассивАктов 		= Новый Массив;
	
	Результат.Очистить();
	Если НесколькоАктов Тогда
		ЭлементыДерева = АктыВыполненныхРабот.ПолучитьЭлементы();
		Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
			ПодчиненныеЭлементыДерева = ЭлементДерева.ПолучитьЭлементы();
			Для Каждого ПодчиненныйЭлементДерева Из ПодчиненныеЭлементыДерева Цикл
				Если ПодчиненныйЭлементДерева.Использовать Тогда
					МассивАктов.Добавить(ПодчиненныйЭлементДерева.АктВыполненныхРабот);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		ОтчетОбъект.ПолучитьЗаполненныйОтчет(МассивАктов,Результат,ЛимзатратаНДС,ИсключатьМатериалы,ВыводитьДоговор,ВыводитьПодрядчика,ДопРеквизитКод,ДопРеквизитНаименование,ВыводитьПодписи);
	Иначе
		МассивАктов.Добавить(АктВыполненныхРабот);
		ОтчетОбъект.ПолучитьЗаполненныйОтчет(МассивАктов,Результат,ЛимзатратаНДС,ИсключатьМатериалы,ВыводитьДоговор,ВыводитьПодрядчика,ДопРеквизитКод,ДопРеквизитНаименование,ВыводитьПодписи);
	КонецЕсли;
	
	Результат.АвтоМасштаб = Истина;	
	
КонецПроцедуры

&НаСервере
Процедура ПодобратьАктыВыполненныхРаботНаСервере()
	
	АктыВыполненныхРабот.ПолучитьЭлементы().Очистить();
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ
	|	СМ_АктВыполненныхРабот.Ссылка КАК АктВыполненныхРабот,
	|	СМ_АктВыполненныхРабот.ЛокальнаяСмета КАК Смета,
	|	ИСТИНА КАК Использовать
	|ИЗ
	|	Документ.СМ_АктВыполненныхРабот КАК СМ_АктВыполненныхРабот
	|ГДЕ
	|	СМ_АктВыполненныхРабот.ЛокальнаяСмета В (&ЛокальнаяСмета)
	|	И НЕ СМ_АктВыполненныхРабот.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Смета";
				   
	Запрос.УстановитьПараметр("ЛокальнаяСмета",ЛокальнаяСмета);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Дерево = АктыВыполненныхРабот.ПолучитьЭлементы();
	Смета = Неопределено;
	Для Каждого СтрокаЗапроса Из РезультатЗапроса Цикл
		Если Смета <> СтрокаЗапроса.Смета Тогда
			Смета = СтрокаЗапроса.Смета;
			НоваяСтрока = Дерево.Добавить();
			НоваяСтрока.Смета = Смета;
			НоваяСтрока.Использовать = Истина;
		КонецЕсли;
		СтрокаПодчинения = НоваяСтрока.ПолучитьЭлементы().Добавить();
		СтрокаПодчинения.АктВыполненныхРабот = СтрокаЗапроса.АктВыполненныхРабот;
		СтрокаПодчинения.Использовать = Истина;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыПодбораЛС(ТекЛС,ТекПараметр) Экспорт
	
	Если ТекЛС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЛокальнаяСмета.Добавить(ТекЛС);
	ПодобратьАктыВыполненныхРаботНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииСпискаЛС(ТекЛС,ТекПараметр) Экспорт
	Если ТекЛС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЛокальнаяСмета.Удалить(ТекЛС);
	ПодобратьАктыВыполненныхРаботНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьНескольких()
	
	Элементы.ГруппаНесколькоАктов.Видимость 						= НесколькоАктов;
	Элементы.КомпоновщикНастроекПользовательскиеНастройки.Видимость = Не НесколькоАктов;
	Элементы.Акт.Видимость											= Не НесколькоАктов;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЛимЗатратуНДСАкт(ТекОбъект)
	
	ЭтаФорма.ЛимзатратаНДС = Справочники.СМ_ЛимитированныеЗатраты.ПустаяСсылка();	
	Для Каждого ТекСтрока Из ТекОбъект.ЛимитированныеЗатраты Цикл
		ТекНаименование = НРЕГ(ТекСтрока.ЛимитированнаяЗатрата.Наименование);
		Позиция1 = СтрНайти(ТекНаименование,"налог на добавленную стоимость");
		Позиция2 = СтрНайти(ТекНаименование,"ндс");
		Если Позиция1 > 0 ИЛИ Позиция2 > 0 Тогда
			ЭтаФорма.ЛимзатратаНДС = ТекСтрока.ЛимитированнаяЗатрата;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.ЛимзатратаНДС) Тогда
		ЭтаФорма.ЛимЗатратаНДС = Справочники.СМ_ЛимитированныеЗатраты.НайтиПоРеквизиту("Идентификатор","ЛЗ64");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЛимЗатратуНДССмета(ТекОбъект)
	
	ЛимЗатратаПоУмолчанию = Справочники.СМ_ЛимитированныеЗатраты.НайтиПоРеквизиту("Идентификатор","ЛЗ64");
	Если ЭтаФорма.ЛимзатратаНДС = Справочники.СМ_ЛимитированныеЗатраты.ПустаяСсылка() ИЛИ
		 ЭтаФорма.ЛимзатратаНДС = ЛимЗатратаПоУмолчанию Тогда
		Для Каждого ТекСтрока Из ТекОбъект.ЛимитированныеЗатраты Цикл
			ТекНаименование = НРЕГ(ТекСтрока.ЛимитированнаяЗатрата.Наименование);
			Позиция1 = СтрНайти(ТекНаименование,"налог на добавленную стоимость");
			Позиция2 = СтрНайти(ТекНаименование,"ндс");
			Если Позиция1 > 0 ИЛИ Позиция2 > 0 Тогда
				ЭтаФорма.ЛимзатратаНДС = ТекСтрока.ЛимитированнаяЗатрата;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.ЛимзатратаНДС) Тогда
		ЭтаФорма.ЛимЗатратаНДС = ЛимЗатратаПоУмолчанию;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АктПриИзменении(Элемент)
	
	ЗаполнитьЛимЗатратуНДСАкт(ЭтаФорма.АктВыполненныхРабот);
	
КонецПроцедуры

&НаКлиенте
Процедура АктНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка 	= Ложь;
	ПараметрыФормы 			= Новый Структура;
	ДатаОтбораАкта 			= ДобавитьМесяц(НачалоМесяца(ТекущаяДата()),-3);
	ПараметрыФормы.Вставить("ДатаОтбора",ДатаОтбораАкта);
	
	// Определяем настройки параметра по объекту строительства для передачи в форму выбора.
	ПараметрСтройка = Новый ПараметрКомпоновкиДанных("ОбъектСтроительства"); 
	Для Каждого ТекЭлементНастройки Из Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ТекЭлементНастройки) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
			Если ТекЭлементНастройки.Параметр = ПараметрСтройка Тогда
				ПараметрыФормы.Вставить("Стройка",ТекЭлементНастройки.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Получаем из предыдущего акта.
	Если ЗначениеЗаполнено(ЭтаФорма.АктВыполненныхРабот) Тогда
		Если ПараметрыФормы.Свойство("Стройка",ПараметрСтройка) Тогда
			Если НЕ ЗначениеЗаполнено(ПараметрСтройка) Тогда
				ПараметрыФормы.Вставить("Акт",ЭтаФорма.АктВыполненныхРабот);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ОповещениеПослеВыбора = Новый ОписаниеОповещения("ВыполнитьПослеВыбораСтройки", ЭтотОбъект);	
	ОткрытьФорму("Документ.СМ_АктВыполненныхРабот.Форма.ФормаВыбора",ПараметрыФормы,ЭтаФорма,,,,ОповещениеПослеВыбора);
	
КонецПроцедуры

Процедура ВыполнитьПослеВыбораСтройки(ВыбранныйАкт,ТекПараметр) Экспорт
	
	Если ЗначениеЗаполнено(ВыбранныйАкт) Тогда
		ЭтаФорма.АктВыполненныхРабот = ВыбранныйАкт;
		ЗаполнитьЛимЗатратуНДСАкт(ВыбранныйАкт);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти