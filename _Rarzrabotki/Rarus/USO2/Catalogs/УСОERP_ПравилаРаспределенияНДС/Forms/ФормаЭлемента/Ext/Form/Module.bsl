				ЕстьОшибка = Истина;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Объект.ФормулаНеНДСДляНеВведенныхОбъектов) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для не введенных в эксплуатацию объектов не указана формула расчета для деятельности, не облагаемой НДС.", Объект.Ссылка, "Объект.ФормулаНеНДСДляНеВведенныхОбъектов");
				ЕстьОшибка = Истина;
			КонецЕсли;
		КонецЕсли;
	//КонецЕсли;

	Отказ = ЕстьОшибка;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВариантДляНеВведенныхОбъектовПриИзменении(Элемент)
	
	Объект.БазаРаспределенияУстанавливаетсяВручнуюДляНеВведенныхОбъектов = (ВариантДляНеВведенныхОбъектов = 1);
	УстановитьВидимостьСтраницВЗависимостиОтвариантаРасчета();
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантДляВведенныхОбъектовПриИзменении(Элемент)
	
	Объект.БазаРаспределенияУстанавливаетсяВручнуюДляВведенныхОбъектов = (ВариантДляВведенныхОбъектов = 1);
	УстановитьВидимостьСтраницВЗависимостиОтвариантаРасчета();

КонецПроцедуры
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИзменитьФормулуНДСДляНеВведенныхОбъектов(Команда)
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("ТекущаяФормула", Объект.ФормулаНДСДляНеВведенныхОбъектов);
	
	ОткрытьФорму("Справочник.УСОERP_ПравилаРаспределенияНДС.Форма.ФормаРедактированияФормулы", СтруктураПараметров, ЭтаФорма,,,,Новый ОписаниеОповещения("ИзменитьФормулуНДСДляНеВведенныхОбъектовЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

