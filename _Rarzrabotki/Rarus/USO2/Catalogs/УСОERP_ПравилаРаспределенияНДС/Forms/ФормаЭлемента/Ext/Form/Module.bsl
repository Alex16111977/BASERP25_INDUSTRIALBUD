
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	ВариантДляВведенныхОбъектов = ?(Объект.БазаРаспределенияУстанавливаетсяВручнуюДляВведенныхОбъектов, 1, 0);
	ВариантДляНеВведенныхОбъектов = ?(Объект.БазаРаспределенияУстанавливаетсяВручнуюДляНеВведенныхОбъектов, 1, 0);
	
	УстановитьВидимостьСтраницВЗависимостиОтвариантаРасчета();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ЕстьОшибка = Ложь;
	//Если Объект.ДляКомплексныхРасходов Тогда
	//	
	//	Если Не ЗначениеЗаполнено(Объект.ФормулаПлан) Тогда
	//		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана формула для расчета доли НДС для строищихся объектов.", Объект.Ссылка, "Объект.ФормулаПлан");
	//		ЕстьОшибка = Истина;
	//	КонецЕсли;
	//	
	//	Если Не ЗначениеЗаполнено(Объект.ФормулаФакт) Тогда
	//		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана формула для расчета доли НДС для завершенных объектов.", Объект.Ссылка, "Объект.ФормулаФакт");
	//		ЕстьОшибка = Истина;
	//	КонецЕсли;     
	//		
	//Иначе
		Если Не Объект.БазаРаспределенияУстанавливаетсяВручнуюДляВведенныхОбъектов Тогда
			Если НЕ ЗначениеЗаполнено(Объект.ФормулаНДСДляВведенныхОбъектов) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для введенных в эксплуатацию объектов не указана формула расчета для деятельности, облагаемой НДС.", Объект.Ссылка, "Объект.ФормулаНДСДляВведенныхОбъектов");
				ЕстьОшибка = Истина;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Объект.ФормулаНеНДСДляВведенныхОбъектов) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для введенных в эксплуатацию объектов не указана формула расчета для деятельности, не облагаемой НДС.", Объект.Ссылка, "Объект.ФормулаНеНДСДляВведенныхОбъектов");
