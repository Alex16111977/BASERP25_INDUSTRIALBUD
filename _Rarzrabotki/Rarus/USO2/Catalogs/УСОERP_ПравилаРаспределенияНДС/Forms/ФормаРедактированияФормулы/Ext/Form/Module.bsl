&НаКлиенте
Процедура СвернутьВсе(Команда)
	
	ЭлементыДерева = ДеревоОператоров.ПолучитьЭлементы();
	Для Каждого СтрДерева Из ЭлементыДерева Цикл
			
		ЭлементыСтроки =  СтрДерева.ПолучитьЭлементы();
		Для Каждого Стр1 Из  ЭлементыСтроки Цикл
			Элементы.ДеревоОператоров.Свернуть( Стр1.ПолучитьИдентификатор());
		КонецЦикла;
		
		Элементы.ДеревоОператоров.Свернуть( СтрДерева.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

