&НаКлиенте
Процедура ОК(Команда)
	
	ПроверкаПройдена = ПроверитьФормулуНаСервере();

	Если  ПроверкаПройдена Тогда
		Закрыть(Формула);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При проверке формулы обнаружена ошибка. Необходимо изменить формулу.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОператоровВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Не ВыбраннаяСтрока = Неопределено Тогда
		ТекущиеДанные = ДеревоОператоров.НайтиПоИдентификатору( ВыбраннаяСтрока);
		Если не ТекущиеДанные = Неопределено Тогда
			Если ЗначениеЗаполнено(ТекущиеДанные.Код) Тогда
				ВставитьТекстВФормулу(СокрЛП(ТекущиеДанные.Код), 1);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

