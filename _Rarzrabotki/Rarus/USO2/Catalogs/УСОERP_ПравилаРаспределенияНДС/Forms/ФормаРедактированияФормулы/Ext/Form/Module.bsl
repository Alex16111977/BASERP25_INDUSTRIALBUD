&НаКлиенте
Процедура ВставитьТекстВФормулу(ТекстВставки, Сдвиг = 0)
	
	ПТД = Элементы.Формула;	
	
	СтрокаНач=0;
	СтрокаКон=0;
	КолонкаНач=0;
	КолонкаКон=0;
	
	ПТД.ПолучитьГраницыВыделения(СтрокаНач,
								КолонкаНач,
								СтрокаКон,
								КолонкаКон);
	
	
	Если ПустаяСтрока(СокрЛП(Формула)) Тогда
		
		ПТД.УстановитьГраницыВыделения(1,1,1,1);
				
	КонецЕсли;
		
	ПТД.ВыделенныйТекст = ТекстВставки;
	
	Если НЕ Сдвиг=0 Тогда
		
		ПТД.ПолучитьГраницыВыделения(СтрокаНач,
									КолонкаНач,
									СтрокаКон,
									КолонкаКон);
		
		ПТД.УстановитьГраницыВыделения(СтрокаНач,КолонкаНач+Сдвиг,СтрокаКон,КолонкаКон+Сдвиг);
		
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
	
КонецПроцедуры 

&НаКлиенте
Процедура ДеревоОператоровНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	ПеретаскиваемаяСтрока = ПараметрыПеретаскивания.Значение;
	ДанныеСтроки = ДеревоОператоров.НайтиПоИдентификатору(ПеретаскиваемаяСтрока);
	Выполнение = ЗначениеЗаполнено(ДанныеСтроки.Код);
	
	Если Выполнение Тогда
		ПараметрыПеретаскивания.Значение = ДанныеСтроки.Код ;
	КонецЕсли;
	 
КонецПроцедуры

