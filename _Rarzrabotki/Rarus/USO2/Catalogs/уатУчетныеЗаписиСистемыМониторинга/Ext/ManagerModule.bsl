#Область ПрограммныйИнтерфейс

// Выполняет заполнение предопределенных элементов справочника
//
Процедура ЗаполнитьПредопределенныеДанные() Экспорт
	
	СпрОбъект = Справочники.уатУчетныеЗаписиСистемыМониторинга.Dynafleet.ПолучитьОбъект();
	СпрОбъект.СистемаМониторинга 				 = Перечисления.уатСистемаGPS.Dynafleet;
	СпрОбъект.АдресСервиса						 = Константы.уатАдресСервисаDynafleet.Получить();
	СпрОбъект.Логин								 = Константы.уатЛогинВСистемеDynafleet.Получить();
	СпрОбъект.Пароль							 = Константы.уатПарольВСистемеDynafleet.Получить();
	СпрОбъект.Записать();
	
	СпрОбъект = Справочники.уатУчетныеЗаписиСистемыМониторинга.Omnicomm.ПолучитьОбъект();
	СпрОбъект.СистемаМониторинга				 = Перечисления.уатСистемаGPS.Omnicomm;
	СпрОбъект.АдресСервиса						 = Константы.уатАдресСервисаOmnicomm.Получить();
	СпрОбъект.ИмяDSN				 = Константы.уатИмяDSNСистемеOmnicomm.Получить();
	СпрОбъект.ИмяPIPE			 = Константы.уатИмяPIPEСистемеOmnicomm.Получить();
	СпрОбъект.ИмяБД				 = Константы.уатИмяБДВСистемеOmnicomm.Получить();
	СпрОбъект.Логин								 = Константы.уатЛогинВСистемеOmnicomm.Получить();
	СпрОбъект.Пароль							 = Константы.уатПарольВСистемеOmnicomm.Получить();
	СпрОбъект.Сервер			 = Константы.уатСерверВСистемеOmnicomm.Получить();
	СпрОбъект.СпособПодключения	 = Константы.уатСпособПодключенияКСистемеOmnicomm.Получить();
	СпрОбъект.СпособРаботы				 = Константы.уатСпособРаботыСOmnicomm.Получить();
	СпрОбъект.Записать();
	
	СпрОбъект = Справочники.уатУчетныеЗаписиСистемыМониторинга.Wialon.ПолучитьОбъект();
	СпрОбъект.СистемаМониторинга				 = Перечисления.уатСистемаGPS.Wialon;
	СпрОбъект.АдресСервиса						 = Константы.уатАдресСервисаWialon.Получить();
	СпрОбъект.ТокенАвторизации					 = Константы.уатТокенВСистемеWialon.Получить();

	ПараметрыWialon = Константы.уатПараметрыРеглЗаданияЗагрузкаДанныхWialon.Получить().Получить();
	Если ПараметрыWialon = Неопределено Тогда 
		ПараметрыWialon = Новый Структура;
	КонецЕсли;
	Если Не ПараметрыWialon.Свойство("Ресурс") Тогда
		ПараметрыWialon.Вставить("Ресурс", "");
	КонецЕсли;
	Если Не ПараметрыWialon.Свойство("ВидСистемы") Тогда
		ПараметрыWialon.Вставить("ВидСистемы", 0);
	КонецЕсли;
	СпрОбъект.Ресурс		 = ПараметрыWialon.Ресурс;
	СпрОбъект.ВидСистемы	 = ПараметрыWialon.ВидСистемы;
	СпрОбъект.Записать();
	
	СпрОбъект = Справочники.уатУчетныеЗаписиСистемыМониторинга.АвтоГРАФ.ПолучитьОбъект();
	СпрОбъект.СистемаМониторинга				 = Перечисления.уатСистемаGPS.АвтоГРАФ;
	СпрОбъект.АдресСервиса						 = Константы.уатАдресСервисаАвтоГРАФ.Получить();
	СпрОбъект.Записать();
	
	СпрОбъект = Справочники.уатУчетныеЗаписиСистемыМониторинга.СКАУТ.ПолучитьОбъект();
	СпрОбъект.СистемаМониторинга				 = Перечисления.уатСистемаGPS.СКАУТ;
	СпрОбъект.АдресСервиса						 = Константы.уатАдресСервисаСКАУТ.Получить();
	СпрОбъект.Логин								 = Константы.уатЛогинВСистемеСКАУТ.Получить();
	СпрОбъект.Пароль							 = Константы.уатПарольВСистемеСКАУТ.Получить();
	СпрОбъект.Записать();
	
	МассивПСМ = Новый Массив();
	уатРаботаСРасширениями.ПСМ_ЗаполнитьМассивПСМ(МассивПСМ);
	Если МассивПСМ.Количество() > 0 Тогда
		уатРаботаСРасширениями.ПСМ_ЗаполнитьУчетнуюЗаписьСистемыМониторинга(МассивПСМ[0]);
	Иначе
		СпрОбъект = Справочники.уатУчетныеЗаписиСистемыМониторинга.ПСМ.ПолучитьОбъект();
		СпрОбъект.СистемаМониторинга = "";
		СпрОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли