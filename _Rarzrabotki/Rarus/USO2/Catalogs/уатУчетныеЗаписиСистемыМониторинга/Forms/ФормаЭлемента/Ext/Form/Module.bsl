&НаКлиенте
Функция ПодключениеКWialonДоступно()
	
	ТекстОшибки = "";
	
	КодВозврата = ПроверитьПодключениеWialonНаСервере(ТекстОшибки);
	
	Если КодВозврата = 0 И ТекстОшибки = "" Тогда 
		Возврат Истина;
		
	ИначеЕсли КодВозврата = 2 Тогда 
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("Описание", ТекстОшибки + Символы.ПС + НСтр("ru='Продолжить?';en='Do you want to continue?'"));
		ПараметрыФормы.Вставить("ПредупреждениеWialon", Истина);
		
		ОткрытьФорму(
			"ОбщаяФорма.уатПредупреждение", 
			ПараметрыФормы, 
			ЭтотОбъект,
			,
			,
			,
			Новый ОписаниеОповещения("ПодтверждениеЗагрузкиИзLocal", ЭтотОбъект),
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
		);
		
		Возврат Ложь;
		
	Иначе 
		ТекстОшибки = СтрШаблон(НСтр("en='At the address <%1> is missing the ability to connect to the API functions WIALON';ru='По указанному адресу <%1> отсутствует возможность подключения к функциям API WIALON'"), Объект.АдресСервиса);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "НаборКонстант.уатАдресСервисаWialon");
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПроверитьПодключениеWialonНаСервере(ТекстОшибки)
	
	ТабДанных = Неопределено;
	
	Возврат уатЗащищенныеФункцииСервер_проф.Wialon_ПолучитьДанныеВсехТС(ТабДанных, ТекстОшибки,,Объект);
	Возврат 1;
	
КонецФункции

&НаКлиенте
Процедура ПодтверждениеЗагрузкиИзLocal(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если РезультатЗакрытия.БольшеНеПоказывать Тогда 
		СохранитьПризнакОтображенияПредупрежденияLocal();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьПризнакОтображенияПредупрежденияLocal()
	
	УстановитьПривилегированныйРежим(Истина);
	
	ХранилищеНастроекДанныхФорм.Сохранить(
		"Обработка.уатЗагрузкаДанныхWialon", 
		"ПредупреждениеLocalБольшеНеПоказывать", 
		Истина
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьТокенWialon()
	
	Если ПустаяСтрока(Объект.АдресСервиса) Тогда 
		ТекстОшибки = НСтр("ru = 'Необходимо заполнить адрес сервиса'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "Объект.АдресСервиса");
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму(
	"ОбщаяФорма.уатФормаАвторизацииWialon",
	Новый Структура("АдресСервиса, ВидСистемы",Объект.АдресСервиса, Объект.ВидСистемы),
	ЭтотОбъект,
	,
	,
	,
	Новый ОписаниеОповещения("ПолучитьТокенWialonЗавершение", ЭтотОбъект),
	РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	);
	
КонецПроцедуры

