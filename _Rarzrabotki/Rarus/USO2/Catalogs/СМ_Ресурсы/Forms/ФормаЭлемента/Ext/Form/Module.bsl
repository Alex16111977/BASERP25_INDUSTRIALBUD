&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Элементы.ТекущиеЦены.Видимость = Истина;
	ОбновитьОтображение();
	Если ОповещатьДляСопоставления Тогда
		Оповестить("ЗаписанРесурс",Объект.Ссылка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображение()
	
	Элементы.ТекущиеЦены.Доступность = НЕ Объект.Ссылка.Пустая();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.Свойство("ВопросЗадан") Тогда
		Отказ = ПараметрыЗаписи.ВопросЗадан;
		Если Не Отказ И ПараметрыЗаписи.Свойство("Закрыть") И ПараметрыЗаписи.Закрыть Тогда
			Закрыть();
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ГруппаРесурсов) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ГруппаРесурсов = ПредопределенноеЗначение("Справочник.СМ_ГруппыРесурсов.КаталогТСН")
		ИЛИ Объект.ГруппаРесурсов = ПредопределенноеЗначение("Справочник.СМ_ГруппыРесурсов.Каталог1984")
		ИЛИ Объект.ГруппаРесурсов = ПредопределенноеЗначение("Справочник.СМ_ГруппыРесурсов.Каталог2001") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='В указанный каталог нельзя добавлять ресурсы вручную.'"));
		Отказ = Истина;
	КонецЕсли;
	
	Если Не Отказ И КонтрольИерархии() Тогда
		НарушенаИерархия = НарушенаИерархия();
		Если НарушенаИерархия Тогда
			ЗакрытьФорму = Ложь;
			Если ПараметрыЗаписи.Свойство("Закрыть") Тогда
				ЗакрытьФорму = ПараметрыЗаписи.Закрыть;
			КонецЕсли;
			ДопПараметры = Новый Структура();
			ДопПараметры.Вставить("Закрыть", ЗакрытьФорму);
			
			Отказ = Истина;
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтаФорма,ДопПараметры);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'В справочнике ресурсов верхний уровень папок должен отражать каталоги ресурсов.
			|Выбранный в ресурсе каталог отличается от группы, в которую поещен ресурс.
			|Переместить в нужный каталог?';"
			+ " en = 'Do you want to continue?'"), Режим, 0);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		ПараметрыЗаписи = Новый Структура();
		ПараметрыЗаписи.Вставить("ВопросЗадан", Истина);
		Записать(ПараметрыЗаписи);
		Возврат;
	КонецЕсли;
	ЗакрытьФорму = Ложь;
	Если ДопПараметры.Свойство("Закрыть") Тогда
		ЗакрытьФорму = ДопПараметры.Закрыть;
	КонецЕсли;
	ПереместитьРесурсВКаталог();
	
	ПараметрыЗаписи = Новый Структура();
	ПараметрыЗаписи.Вставить("ВопросЗадан", Ложь);
	ПараметрыЗаписи.Вставить("Закрыть", ЗакрытьФорму);
	Модифицированность = Ложь;
	Записать(ПараметрыЗаписи);

КонецПроцедуры

&НаСервере
Функция КонтрольИерархии()
    Возврат Не ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","НСИ_НеКонтролироватьИерархиюРесурсов",Ложь);
КонецФункции

&НаСервере
Функция НарушенаИерархия()
	ВерхнийРодитель = Объект.Родитель;
	Пока ЗначениеЗаполнено(ВерхнийРодитель.Родитель) Цикл
		ВерхнийРодитель = ВерхнийРодитель.Родитель;
	КонецЦикла;
	
	Возврат Не ВРег(ВерхнийРодитель.Наименование) = ВРег(Объект.ГруппаРесурсов.Наименование);
КонецФункции

&НаСервере
Процедура ПереместитьРесурсВКаталог()
    ВерхнийРодитель = Справочники.СМ_Ресурсы.НайтиПоНаименованию(Объект.ГруппаРесурсов.Наименование,Истина);
	Если ВерхнийРодитель.Пустая() Тогда
		НовКаталог = Справочники.СМ_Ресурсы.СоздатьГруппу();
		НовКаталог.Наименование = Объект.ГруппаРесурсов.Наименование;
		НовКаталог.Записать();
		ВерхнийРодитель = НовКаталог.Ссылка;
	КонецЕсли;
	Объект.Родитель = ВерхнийРодитель;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьЗакрыть(Команда)
	
	ПараметрыЗаписи = Новый Структура();
	ПараметрыЗаписи.Вставить("Закрыть", Истина);
	
	Если Записать(ПараметрыЗаписи) Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьРесурс(Команда)
	ПараметрыЗаписи = Новый Структура();
	ПараметрыЗаписи.Вставить("Закрыть", Ложь);
	
	Записать(ПараметрыЗаписи);
КонецПроцедуры

&НаКлиенте
Процедура РайонПриИзменении(Элемент)
	
	Цены.Параметры.УстановитьЗначениеПараметра("Район",Район);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Объект.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих И НЕ Объект.ЭтоГруппа И
		(Объект.ГруппаРесурсов = Справочники.СМ_ГруппыРесурсов.Каталог2001 ИЛИ 		
		Объект.ГруппаРесурсов = Справочники.СМ_ГруппыРесурсов.Каталог2017) Тогда 
		ТолькоЦифрыКода = СокрЛП(ТолькоЦифры(Объект.Код));
		Если ЗначениеЗаполнено(ТолькоЦифрыКода) И СтрДлина(ТолькоЦифрыКода) > 1 Тогда
			ТекДрЧасть 				= Прав(ТолькоЦифрыКода,1); 
			ТекСтрока				= Прав(ТолькоЦифрыКода,2);
			ТекРазряд				= Лев(ТекСтрока,1);
			РазрядОбъекта			= Число("" + ТекРазряд + "," + ТекДрЧасть);
			ТекущийОбъект.Разряд 	= РазрядОбъекта;  
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ТолькоЦифры(Строка)
	
	ОбработаннаяСтрока = "";
	Для НомерСимвола = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, НомерСимвола, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			ОбработаннаяСтрока = ОбработаннаяСтрока + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ОбработаннаяСтрока;
	
КонецФункции

&НаКлиенте
Процедура ВидРесурсаПриИзменении(Элемент)
	
