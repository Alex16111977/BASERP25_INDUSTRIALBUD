				<Field>Список.Ref</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	СправочникСМ_Ресурсы.Ссылка,
	СправочникСМ_Ресурсы.ПометкаУдаления,
	СправочникСМ_Ресурсы.Родитель,
	СправочникСМ_Ресурсы.ЭтоГруппа,
	СправочникСМ_Ресурсы.Код,
	СправочникСМ_Ресурсы.Наименование,
	СправочникСМ_Ресурсы.ВидРесурса,
	СправочникСМ_Ресурсы.ГодВыпуска,
	ВЫБОР
		КОГДА СправочникСМ_Ресурсы.ЭтоГруппа
			ТОГДА СправочникСМ_Ресурсы.Наименование
		ИНАЧЕ ВЫРАЗИТЬ(СправочникСМ_Ресурсы.ДлинноеНаименование КАК СТРОКА(500))
	КОНЕЦ КАК ДлинноеНаименование,
	СправочникСМ_Ресурсы.ЕдиницаИзмерения,
	СправочникСМ_Ресурсы.КлассГруза,
	СправочникСМ_Ресурсы.КодОКП,
	СправочникСМ_Ресурсы.МассаБрутто,
	СправочникСМ_Ресурсы.МассаНетто,
	СправочникСМ_Ресурсы.ГруппаРесурсов,
	СправочникСМ_Ресурсы.Предопределенный,
	СправочникСМ_Ресурсы.ИмяПредопределенныхДанных,
	СУММА(ЕСТЬNULL(ВЫБОР
				КОГДА СМ_СметныеЦеныРесурсовСрезПоследних.ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Базисная)
					ТОГДА СМ_СметныеЦеныРесурсовСрезПоследних.СметнаяЦена
				ИНАЧЕ 0
			КОНЕЦ, 0)) КАК БазиснаяЦена,
	СУММА(ЕСТЬNULL(ВЫБОР
				КОГДА СМ_СметныеЦеныРесурсовСрезПоследних.ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Текущая)
					ТОГДА СМ_СметныеЦеныРесурсовСрезПоследних.СметнаяЦена
				ИНАЧЕ 0
			КОНЕЦ, 0)) КАК ТекущаяЦена,
	СУММА(ЕСТЬNULL(ВТ.ЧисловойПараметр1, 0)) КАК Остаток
ИЗ
	Справочник.СМ_Ресурсы КАК СправочникСМ_Ресурсы
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СметныеЦеныРесурсов.СрезПоследних(
				&amp;ДатаЦены,
				СметноНормативнаяБаза = &amp;СНБ
					И Район = &amp;Район
					И &amp;ИспользоватьСНБ = ИСТИНА) КАК СМ_СметныеЦеныРесурсовСрезПоследних
		ПО (СМ_СметныеЦеныРесурсовСрезПоследних.Ресурс = СправочникСМ_Ресурсы.Ссылка)
			И (&amp;ИспользоватьСНБ = ИСТИНА)
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ВТ.Ресурс КАК Ресурс,
			ВТ.ЧисловойПараметр1 КАК ЧисловойПараметр1
		ИЗ
			РегистрСведений.СМ_WS_БуферЗагрузки КАК ВТ
		ГДЕ
			ВТ.ОбъектСтроительства = &amp;Проект
			И ВТ.ТипОбъекта = "balance") КАК ВТ
		ПО СправочникСМ_Ресурсы.Ссылка = ВТ.Ресурс
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_АктВыполненныхРабот.РесурсыПозицийАкта КАК СМ_АктВыполненныхРаботРесурсыПозицийАкта
		ПО (СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ресурс = СправочникСМ_Ресурсы.Ссылка)
			И (СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ссылка = &amp;Акт)

СГРУППИРОВАТЬ ПО
	СправочникСМ_Ресурсы.Ссылка,
	СправочникСМ_Ресурсы.ПометкаУдаления,
	СправочникСМ_Ресурсы.Родитель,
	СправочникСМ_Ресурсы.ЭтоГруппа,
	СправочникСМ_Ресурсы.Код,
	СправочникСМ_Ресурсы.Наименование,
	СправочникСМ_Ресурсы.ВидРесурса,
	СправочникСМ_Ресурсы.ГодВыпуска,
	СправочникСМ_Ресурсы.ЕдиницаИзмерения,
	СправочникСМ_Ресурсы.КлассГруза,
	СправочникСМ_Ресурсы.КодОКП,
	СправочникСМ_Ресурсы.МассаБрутто,
	СправочникСМ_Ресурсы.МассаНетто,
	СправочникСМ_Ресурсы.ГруппаРесурсов,
	СправочникСМ_Ресурсы.Предопределенный,
	СправочникСМ_Ресурсы.ИмяПредопределенныхДанных,
	ВЫБОР
		КОГДА СправочникСМ_Ресурсы.ЭтоГруппа
			ТОГДА СправочникСМ_Ресурсы.Наименование
		ИНАЧЕ ВЫРАЗИТЬ(СправочникСМ_Ресурсы.ДлинноеНаименование КАК СТРОКА(500))
	КОНЕЦ</QueryText>
