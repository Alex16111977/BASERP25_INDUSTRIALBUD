#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	Список.Параметры.УстановитьЗначениеПараметра("ДатаЦены",Параметры.ДатаТекущихЦен);
	Список.Параметры.УстановитьЗначениеПараметра("СНБ",Параметры.РегиональнаяБаза);
	Список.Параметры.УстановитьЗначениеПараметра("Район",Параметры.Район);
	
	Если Параметры.Свойство("Проект") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("Проект",Параметры.Проект);
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("Проект",Справочники.СМ_ОбъектыСтроительства.ПустаяСсылка());
	КонецЕсли;
	
	Если Параметры.Свойство("Акт") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("Акт",Параметры.Акт);
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("Акт",Документы.СМ_АктВыполненныхРабот.ПустаяСсылка());
	КонецЕсли;

	
	Если НЕ ЗначениеЗаполнено(Параметры.ДатаТекущихЦен) 
		ИЛИ НЕ ЗначениеЗаполнено(Параметры.РегиональнаяБаза) 
		ИЛИ НЕ ЗначениеЗаполнено(Параметры.Район) Тогда
		Элементы.БазиснаяЦена.Видимость = Ложь;
		Элементы.ТекущаяЦена.Видимость = Ложь;
		Список.Параметры.УстановитьЗначениеПараметра("ИспользоватьСНБ",Ложь);
		Список.ТекстЗапроса = ТекстЗапросаБезЦен();
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("ИспользоватьСНБ",Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ТекРесурс) Тогда
		Элементы.Список.ТекущаяСтрока = Параметры.ТекРесурс;
	КонецЕсли;
	
	Если Параметры.РежимВыбора Тогда
		Элементы.Список.МножественныйВыбор = Ложь;
	КонецЕсли;

		
КонецПроцедуры

&НаСервере
Функция ТекстЗапросаБезЦен()
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СправочникСМ_Ресурсы.Ссылка,
	               |	СправочникСМ_Ресурсы.ПометкаУдаления,
	               |	СправочникСМ_Ресурсы.Родитель,
	               |	СправочникСМ_Ресурсы.ЭтоГруппа,
	               |	СправочникСМ_Ресурсы.Код,
	               |	СправочникСМ_Ресурсы.Наименование,
	               |	СправочникСМ_Ресурсы.ВидРесурса,
	               |	СправочникСМ_Ресурсы.ГодВыпуска,
	               |	ВЫБОР
	               |		КОГДА СправочникСМ_Ресурсы.ЭтоГруппа
	               |			ТОГДА СправочникСМ_Ресурсы.Наименование
	               |		ИНАЧЕ ВЫРАЗИТЬ(СправочникСМ_Ресурсы.ДлинноеНаименование КАК СТРОКА(500))
	               |	КОНЕЦ КАК ДлинноеНаименование,
	               |	СправочникСМ_Ресурсы.ЕдиницаИзмерения,
	               |	СправочникСМ_Ресурсы.КлассГруза,
	               |	СправочникСМ_Ресурсы.КодОКП,
	               |	СправочникСМ_Ресурсы.МассаБрутто,
	               |	СправочникСМ_Ресурсы.МассаНетто,
	               |	СправочникСМ_Ресурсы.ГруппаРесурсов,
	               |	СправочникСМ_Ресурсы.Предопределенный,
	               |	СправочникСМ_Ресурсы.ИмяПредопределенныхДанных,
	               |	СУММА(0) КАК БазиснаяЦена,
	               |	СУММА(0) КАК ТекущаяЦена
	               |ИЗ
	               |	Справочник.СМ_Ресурсы КАК СправочникСМ_Ресурсы
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СправочникСМ_Ресурсы.Ссылка,
	               |	СправочникСМ_Ресурсы.ПометкаУдаления,
	               |	СправочникСМ_Ресурсы.Родитель,
	               |	СправочникСМ_Ресурсы.ЭтоГруппа,
	               |	СправочникСМ_Ресурсы.Код,
	               |	СправочникСМ_Ресурсы.Наименование,
	               |	СправочникСМ_Ресурсы.ВидРесурса,
	               |	СправочникСМ_Ресурсы.ГодВыпуска,
	               |	СправочникСМ_Ресурсы.ЕдиницаИзмерения,
	               |	СправочникСМ_Ресурсы.КлассГруза,
	               |	СправочникСМ_Ресурсы.КодОКП,
	               |	СправочникСМ_Ресурсы.МассаБрутто,
	               |	СправочникСМ_Ресурсы.МассаНетто,
	               |	СправочникСМ_Ресурсы.ГруппаРесурсов,
	               |	СправочникСМ_Ресурсы.Предопределенный,
	               |	СправочникСМ_Ресурсы.ИмяПредопределенныхДанных,
	               |	ВЫБОР
	               |		КОГДА СправочникСМ_Ресурсы.ЭтоГруппа
	               |			ТОГДА СправочникСМ_Ресурсы.Наименование
	               |		ИНАЧЕ ВЫРАЗИТЬ(СправочникСМ_Ресурсы.ДлинноеНаименование КАК СТРОКА(500))
	               |	КОНЕЦ";
	Возврат ТекстЗапроса;	
КонецФункции
#КонецОбласти
