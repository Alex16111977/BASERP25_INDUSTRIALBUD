#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура Поле1ПриИзменении(Элемент)	
	ИзменитьСНБ();
КонецПроцедуры

&НаСервере
Процедура ИзменитьСНБ()
	Список.Параметры.УстановитьЗначениеПараметра("СНБ", СНБ);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Список.Параметры.УстановитьЗначениеПараметра("СНБ", СНБ);
	Список.Параметры.УстановитьЗначениеПараметра("Район", Район);
	Список.Параметры.УстановитьЗначениеПараметра("Период", ВернутьДатуСеанса());
КонецПроцедуры

&НаКлиенте
Процедура Поле2ПриИзменении(Элемент)
	ИзменитьРайон();
КонецПроцедуры

&НаСервере
Процедура ИзменитьРайон()
	Список.Параметры.УстановитьЗначениеПараметра("Район", Район);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзВНБ(Команда)
	
	Если СметнаяКомпонента = Неопределено Тогда
		ПоказатьПредупреждение(,НСтр("ru='Сметная компонента не подключена'"));
	Иначе
		ОписаниеОповещения2 = Новый ОписаниеОповещения("ОбновитьРесурсы",ЭтаФорма); 
		ПоказатьВопрос(ОписаниеОповещения2, НСтр("ru='Вы точно уверены, что хотите перезаполнить весь справочник?'"),РежимДиалогаВопрос.ДаНет,,,,);
	КонецЕсли;
	

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзВНБНаСервере(ВерсияКомпоненты)
	
	Для Каждого СтрБаза Из ТаблицаСНБ Цикл
		СМ_СметаЗагрузкаВызовСервера.ОбновитьРесурсы(СтрБаза.СНБ, СтрБаза.ДанныеДляОбновления, ВерсияКомпоненты);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПолучитьСписокВсехСНБ()
	
	ТаблицаСНБ.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ 
	|	СметноНормативныеБазы.Код,
	|	СметноНормативныеБазы.Ссылка,
	|	СметноНормативныеБазы.ГодВыпуска
	|ИЗ
	|	Справочник.СМ_СметноНормативныеБазы КАК СметноНормативныеБазы
	|ГДЕ
	|	СметноНормативныеБазы.ЭтоГруппа = ЛОЖЬ";
		   
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр 			= ТаблицаСНБ.Добавить();
		Стр.КодБазы 	= Выборка.Код;
		Стр.СНБ 		= Выборка.Ссылка;
		Стр.ГодВыпуска 	= Строка(СМ_СметаВызовСервера.ПолучитьГодИзПеречисления(Выборка.ГодВыпуска));
	КонецЦикла;  
	
КонецПроцедуры

&НаСервереБезКонтекста 
Функция ВернутьДатуСеанса()
	Возврат ТекущаяДатаСеанса();
КонецФункции

// Процедура, используемая для события ответа на вопрос пользователя из процедуры ЗадатьВопрос.
//
// Параметры:
//     Результат 	- КодВозвратаДиалога	- ответ пользователя.
//     СтруктураПараметров - структура параметров, передаваемая при вызове.
//
&НаКлиенте
Процедура ОбновитьРесурсы(Результат, СтруктураПараметров) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Попытка
			ВерсияКомпоненты = Число(СметнаяКомпонента.Version);
		Исключение
			ВерсияКомпоненты = 1;
		КонецПопытки;

		ПоказатьОповещениеПользователя(НСтр("ru='Обновляются ресурсы всех нормативных баз'"));
		
		ПолучитьСписокВсехСНБ();
		Для Каждого СтрБаза Из ТаблицаСНБ Цикл
			СтрБаза.ДанныеДляОбновления = СметнаяКомпонента.ПровестиОбновлениеРесурсов(СтрБаза.КодБазы,);	
		КонецЦикла;
	
		ЗаполнитьИзВНБНаСервере(ВерсияКомпоненты);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьВБуфер(Команда)
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если Не ТекДанные = Неопределено И Не ТекДанные.ЭтоГруппа Тогда
		СкопироватьВБуферСервер(ТекДанные.Ссылка);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СкопироватьВБуферСервер(СтруктураБуфера)
	Буфер = ПоместитьВоВременноеХранилище(СтруктураБуфера,Новый УникальныйИдентификатор());
	ОбщегоНазначения.СкопироватьВБуферОбмена("РЕСУРС",Буфер);
КонецПроцедуры

