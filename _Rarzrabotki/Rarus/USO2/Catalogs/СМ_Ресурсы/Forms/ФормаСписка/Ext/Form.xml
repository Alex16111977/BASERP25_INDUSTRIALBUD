	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.Description</Field>
				<Field>Список.IsFolder</Field>
				<Field>Список.Ref</Field>
				<Field>Список.ДлинноеНаименование</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	СправочникРесурсы.ПометкаУдаления,
	СправочникРесурсы.Родитель,
	СправочникРесурсы.ЭтоГруппа,
	СправочникРесурсы.Код,
	СправочникРесурсы.Наименование,
	СправочникРесурсы.ДлинноеНаименование,
	СправочникРесурсы.ЕдиницаИзмерения,
	СправочникРесурсы.ГодВыпуска,
	СправочникРесурсы.ВидРесурса,
	СправочникРесурсы.МассаБрутто,
	СправочникРесурсы.МассаНетто,
	СправочникРесурсы.КлассГруза,
	СправочникРесурсы.КодОКП,
	СправочникРесурсы.Предопределенный,
	СправочникРесурсы.ИмяПредопределенныхДанных,
	ЕСТЬNULL(ВЫРАЗИТЬ(СметныеНаименованияРесурсов.Наименование КАК СТРОКА(500)), ВЫБОР
			КОГДА СправочникРесурсы.ЭтоГруппа
				ТОГДА СправочникРесурсы.Наименование
			ИНАЧЕ ВЫРАЗИТЬ(СправочникРесурсы.ДлинноеНаименование КАК СТРОКА(500))
		КОНЕЦ) КАК НаименованиеРегистр,
	ЕСТЬNULL(СметныеНаименованияРесурсов.ЕдиницаИзмерения, СправочникРесурсы.ЕдиницаИзмерения) КАК ЕдиницаИзмеренияРегистр,
	ЕСТЬNULL(СметныеЦеныРесурсовСрезПоследних.СметнаяЦена, 0) КАК СметнаяЦенаРегистр,
	СметныеЦеныРесурсовСрезПоследних.ТипЦен,
	СметныеЦеныРесурсовСрезПоследних.СметноНормативнаяБаза,
	СправочникРесурсы.Ссылка
ИЗ
	Справочник.СМ_Ресурсы КАК СправочникРесурсы
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СметныеНаименованияРесурсов КАК СметныеНаименованияРесурсов
		ПО СправочникРесурсы.Ссылка = СметныеНаименованияРесурсов.Ресурс
			И (ЗНАЧЕНИЕ(Справочник.СМ_СметноНормативныеБазы.ПустаяСсылка) &lt;&gt; &amp;СНБ)
			И (СметныеНаименованияРесурсов.СметноНормативнаяБаза = &amp;СНБ)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СметныеЦеныРесурсов.СрезПоследних(
				&amp;Период,
				ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Базисная)
					И СметноНормативнаяБаза = &amp;СНБ
					И ЗНАЧЕНИЕ(Справочник.СМ_СметноНормативныеБазы.ПустаяСсылка) &lt;&gt; &amp;СНБ
					И Район = &amp;Район
					И ЗНАЧЕНИЕ(Справочник.СМ_ТерриториальныеРайоны.ПустаяСсылка) &lt;&gt; &amp;Район) КАК СметныеЦеныРесурсовСрезПоследних
		ПО СправочникРесурсы.Ссылка = СметныеЦеныРесурсовСрезПоследних.Ресурс</QueryText>
				<MainTable>Catalog.СМ_Ресурсы</MainTable>
				<AutoSaveUserSettings>false</AutoSaveUserSettings>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
				</ListSettings>
			</Settings>
		</Attribute>
