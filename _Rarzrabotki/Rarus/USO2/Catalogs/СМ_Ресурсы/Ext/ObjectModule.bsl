
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если (Не Ссылка.Наименование = Наименование) И (Не ЭтоГруппа) И (Не ЗначениеЗаполнено(ДлинноеНаименование)) Тогда
		ДлинноеНаименование = Наименование;
	КонецЕсли;
	
	Если ЭтоНовый() Тогда
		УстановитьНовыйКод();
	КонецЕсли;

	Отказ = Не СМ_СметаВызовСервера.РесурсУникален(ЭтотОбъект, Родитель);
	
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Ресурс %1 не уникален, он не сохранен в справочнике!!!'"), ЭтотОбъект.Наименование));	
	КонецЕсли;                 	
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Код = "";
КонецПроцедуры

Процедура ПриУстановкеНовогоКода(СтандартнаяОбработка, Префикс)
	СтандартнаяОбработка = Ложь;
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.Код) ИЛИ ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	
	КодРесурса = "";
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	              |	СМ_Ресурсы.Код КАК КодРесурса
	              |ИЗ
	              |	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
	              |ГДЕ
	              |	СМ_Ресурсы.Родитель = &Группа
	              |	И СМ_Ресурсы.ЭтоГруппа = ЛОЖЬ
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	СМ_Ресурсы.Ссылка УБЫВ";
	Запрос.УстановитьПараметр("Группа",ЭтотОбъект.Родитель);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДлинаКода = СтрДлина(СокрЛП(Выборка.КодРесурса));
		сч = ДлинаКода;
		СтрокаКода = СокрЛП(Выборка.КодРесурса);
		ЧисловаяЧасть = "";
		Пока сч>0 Цикл
			ПоследСимвол = Сред(СтрокаКода,сч,1);
			Если Найти("0123456789",ПоследСимвол)>0 Тогда
				ЧисловаяЧасть = Строка(ПоследСимвол)+ЧисловаяЧасть;
			Иначе
				Прервать;
			КонецЕсли;
			сч = сч - 1;
		КонецЦикла;
		Если ЗначениеЗаполнено(ЧисловаяЧасть) Тогда
			ДлинаЧисла = СтрДлина(ЧисловаяЧасть);
			Префикс = Лев(СокрЛП(Выборка.КодРесурса),ДлинаКода-ДлинаЧисла);
			СтрокаЧисла = ЧисловаяЧасть;
			Нулики = "";
			сч=0;
			Пока сч<=ДлинаЧисла Цикл
				Символ = Сред(СтрокаЧисла,сч,1);
				Если Символ = "0" Тогда
					Нулики = Строка(Нулики)+Строка("0");
					СтрокаЧисла = Сред(СтрокаЧисла,2);
				Иначе
					Прервать;
				КонецЕсли;
				сч=сч+1
			КонецЦикла;
			ЧислоСледующее = Формат(Число(СтрокаЧисла)+1,"ЧГ=0");
			КодСлед = Строка(Нулики) + Строка(ЧислоСледующее); 
			Если ДлинаЧисла < СтрДлина(КодСлед) Тогда
				Если ЗначениеЗаполнено(Нулики) Тогда
					Если СтрДлина(Нулики)=1 Тогда
						КодСлед = ЧислоСледующее
					Иначе
						Нулики = Сред(Нулики,2);
						КодСлед = Строка(Нулики) + ЧислоСледующее
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			КодРесурса = Строка(Префикс) + КодСлед;
		КонецЕсли;
	КонецЕсли;
	ЭтотОбъект.Код = КодРесурса;

КонецПроцедуры

#КонецОбласти
