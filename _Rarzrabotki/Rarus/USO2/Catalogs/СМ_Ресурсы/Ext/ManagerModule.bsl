#Область СлужебныеПроцедуры

// Возвращает Группу ресурсов из условий по умолчанию.
//
// Параметры:
// 		Ресурс - СправочникСсылка.СМ_Ресурсы, Структура - может содержать поля:
//			* Код			- Строка - код ресурса.
//			* ВидРесурса 	- ПеречислениеСсылка.СМ_ВидыРесурсов - вид ресурса. 
//			* ГодВыпуска	- ПеречислениеСсылка.СМ_ГодыВыпускаБазы - год выпуска нормативной базы.
//
// Возвращаемое значение:
// 		ТекГруппа - СправочникСсылка.СМ_ГруппыРесурсов - группа ресурсов.
//
Функция КаталогПоУмолчанию(Ресурс) Экспорт
	
	ТекРодитель = Ресурс;
	Пока ЗначениеЗаполнено(ТекРодитель.Родитель) Цикл
		ТекРодитель = ТекРодитель.Родитель;
	КОнецЦикла;
	
	Попытка
		Группа = Справочники.СМ_ГруппыРесурсов[ТекРодитель.КаталогРК];
		Если ЗначениеЗаполнено(Группа) Тогда
			Возврат Группа;
		КонецЕсли;
	Исключение
		
	КонецПопытки;
		
	ЕстьДваТире = Ложь;
	ПозицияТире = Найти(Ресурс.Код, "-");
	Если ПозицияТире > 0 Тогда
		Код = Сред(Ресурс.Код, ПозицияТире + 1);
		Если Найти(Код, "-") > 0 Тогда
			ЕстьДваТире = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ресурс.Код) Тогда
		Возврат Справочники.СМ_ГруппыРесурсов.КаталогТСН;
	Иначе
		
		Если (Найти(Ресурс.Код, ".") > 0) и (СтрЧислоВхождений(Ресурс.Код, ".")=1) Тогда
			Возврат Справочники.СМ_ГруппыРесурсов.КаталогТСН;
		ИначеЕсли Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы И ЕстьДваТире И (Найти(Ресурс.Код, ".") = 0) и (СтрДлина(Ресурс.Код) = 14) Тогда
			Возврат Справочники.СМ_ГруппыРесурсов.КаталогРК;
		ИначеЕсли Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы И ЕстьДваТире И (Найти(Ресурс.Код, ".") = 0) Тогда
			Возврат Справочники.СМ_ГруппыРесурсов.КаталогГазпром;
		ИначеЕсли Ресурс.ГодВыпуска = Перечисления.СМ_ГодыВыпускаБазы.г1984 Тогда
			Возврат Справочники.СМ_ГруппыРесурсов.Каталог1984;
		ИначеЕсли Ресурс.ГодВыпуска = Перечисления.СМ_ГодыВыпускаБазы.г2017 Тогда
			Возврат Справочники.СМ_ГруппыРесурсов.Каталог2017;
		Иначе
			Возврат Справочники.СМ_ГруппыРесурсов.Каталог2001;
		КонецЕсли;
		
	КонецЕсли;
		
КонецФункции

#КонецОбласти

#КонецЕсли
