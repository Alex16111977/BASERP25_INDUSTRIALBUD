#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Не СМ_СметаВызовСервера.КонтрольУникальности("СМ_ИтогиПоГлавам", "ПорядковыйНомер", ПорядковыйНомер, ЭтотОбъект.Ссылка) Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Элемент с таким порядковым номером уже присутствует в базе'"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Код) Тогда
		УстановитьНовыйКод();
	КонецЕсли;
	Если (НЕ ЭтоГруппа) И (НЕ ЗначениеЗаполнено(Идентификатор)) Тогда 
		Идентификатор = "И" + СокрЛП(Строка(Код));
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти