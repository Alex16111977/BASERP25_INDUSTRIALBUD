#Область СлужебныеПроцедурыИФункции

// Возвращает максимальное значение реквизита ПорядковыйНомер в справочнике.
//
// Возвращаемое значение:
// 		Результат - Число - максимальный порядковый номер.
//
Функция ПолучитьМаксимальныйНомерПоПорядку() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЛимитированныеЗатраты.НомерПоПорядку КАК НомерПоПорядку
	|ИЗ
	|	Справочник.СМ_ЛимитированныеЗатраты КАК ЛимитированныеЗатраты
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерПоПорядку УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.НомерПоПорядку;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

#КонецОбласти