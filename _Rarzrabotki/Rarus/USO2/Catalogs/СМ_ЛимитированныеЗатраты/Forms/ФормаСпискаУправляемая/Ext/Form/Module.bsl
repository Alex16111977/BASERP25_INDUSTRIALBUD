#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПолучитьПорядковыйНомер()
	
	ПорядковыйНомер = 0;
	Если Не Элементы.Список.ТекущиеДанные.Свойство("НомерПоПорядку", ПорядковыйНомер) Тогда
		// вызов сервера
		ПорядковыйНомер = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Элементы.Список.ТекущаяСтрока, "НомерПоПорядку");
	КонецЕсли;
	Возврат ПорядковыйНомер;
	
КонецФункции

&НаКлиенте
Процедура Вверх(Команда)
	ПорядковыйНомер = ПолучитьПорядковыйНомер();	
	СМ_СметаКлиент.ВверхВнизСправочник("СМ_ЛимитированныеЗатраты", ПорядковыйНомер, ПорядковыйНомер - 1, "НомерПоПорядку");
	Элементы.Список.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура Вниз(Команда)
	ПорядковыйНомер = ПолучитьПорядковыйНомер();
	СМ_СметаКлиент.ВверхВнизСправочник("СМ_ЛимитированныеЗатраты", ПорядковыйНомер + 1, ПорядковыйНомер, "НомерПоПорядку");
	Элементы.Список.Обновить();
КонецПроцедуры

#КонецОбласти