#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОткудаПриИзменении(Элемент)
	ОбработкаВыбораИсточника();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораИсточника()
	
	Если Объект.Откуда = 1 Тогда
		Элементы.ОтИтога.Видимость = Истина;
		Элементы.ОтЗатраты.Видимость = Ложь;
		Элементы.ОтФормулы.Видимость = Ложь;
	ИначеЕсли Объект.Откуда = 2 Тогда
		Элементы.ОтИтога.Видимость = Ложь;
		Элементы.ОтЗатраты.Видимость = Истина;
		Элементы.ОтФормулы.Видимость = Ложь;
	ИначеЕсли Объект.Откуда = 3 Тогда
		Элементы.ОтФормулы.КнопкаВыбора = Истина;      
		Элементы.ОтИтога.Видимость = Ложь;
		Элементы.ОтЗатраты.Видимость = Ложь;
		Элементы.ОтФормулы.Видимость = Истина;
		ОписаниеФормулы = СМ_СметаКлиент.ПолучитьОписаниеФормулы(Объект.ОтФормулы);

	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Функция ВводФормулы(Элемент)
	
	Формула = Объект.ОтФормулы;
	Формула = РедактироватьФормулу(Формула);
	Элемент.КнопкаВыбора = Истина;
	Если Формула = неопределено Тогда
		Возврат Ложь;	
	КонецЕсли;
	Объект.ОтФормулы = Формула;
	
	Возврат Истина;	

КонецФункции

&НаКлиенте
Процедура ПолучитьФормулу(Результат, Структура) Экспорт
	СтруктураВозврата = Результат; 
	Если Не СтруктураВозврата = Неопределено Тогда
		Объект.ОтФормулы = СтруктураВозврата.Формула;
		ОписаниеФормулы = СтруктураВозврата.ОписаниеФормулы;
	Иначе
		Объект.ОтФормулы = "";
		ОписаниеФормулы = "";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция РедактироватьФормулу(Формула)
	СтруктураВозврата = Новый Структура();
	СтруктураВозврата.Вставить("Формула",Формула);
	СтруктураВозврата.Вставить("ОписаниеФормулы",ОписаниеФормулы);
	Оповещение = Новый ОписаниеОповещения("ПолучитьФормулу", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.СМ_РедакторФормулЛимЗатрат",СтруктураВозврата,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецФункции

&НаКлиенте
Процедура ОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	Объект.Идентификатор = "ЛЗ"+СокрЛП(Строка(Объект.Код));
КонецПроцедуры

&НаКлиенте
Процедура ОтФормулыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если Не ВводФормулы(Элемент) Тогда
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбработкаВыбораИсточника();
	ОбновитьОтображение();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	Если Объект.Ссылка = Справочники.СМ_ЛимитированныеЗатраты.ПустаяСсылка() Тогда
		Объект.Код = 0;
		Объект.Идентификатор = "";
		Объект.НомерПоПорядку = Справочники.СМ_ЛимитированныеЗатраты.ПолучитьМаксимальныйНомерПоПорядку() + 1;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображение()
	
	ИспользованиеИтогов.Параметры.УстановитьЗначениеПараметра("ЛимитированнаяЗатрата", Объект.Ссылка);
	Элементы.ИспользованиеИтогов.Доступность = НЕ Объект.Ссылка.Пустая();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОбновитьОтображение(); 
	
КонецПроцедуры

#КонецОбласти