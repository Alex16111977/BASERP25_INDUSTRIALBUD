
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ГруппаВыбратьИзШаблона.Видимость = Не ЗначениеЗаполнено(Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(ШаблонОбъектовСтроительства) Тогда
		ДеревоОбъектов = ШаблонОбъектовСтроительства.ХранилищеДереваОбъектов.Получить();
		Если Не ДеревоОбъектов = Неопределено Тогда
			Если Не ДеревоОбъектов.Строки.Количество() = 0 Тогда
				СоздатьОбъектыИзШаблона(ДеревоОбъектов.Строки[0], ТекущийОбъект.Ссылка);
			КонецЕсли;
		КонецЕсли;
		Элементы.ГруппаВыбратьИзШаблона.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СоздатьОбъектыИзШаблона(ДеревоОбъектов, Родитель)
	
	Для Каждого ТекСтрока Из ДеревоОбъектов.Строки Цикл
		Если ТекСтрока.Строки.Количество() > 0 Тогда
			НовыйОбъект = Справочники.СМ_ОбъектыСтроительства.СоздатьГруппу();
			НовыйОбъект.Родитель = Родитель;
			НовыйОбъект.Наименование = ТекСтрока.НаименованиеОбъекта;
			НовыйОбъект.Записать();
			СоздатьОбъектыИзШаблона(ТекСтрока, НовыйОбъект.Ссылка);
		Иначе
			НовыйОбъект = Справочники.СМ_ОбъектыСтроительства.СоздатьЭлемент();
			НовыйОбъект.Родитель = Родитель;
			НовыйОбъект.Наименование = ТекСтрока.НаименованиеОбъекта;
			НовыйОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
