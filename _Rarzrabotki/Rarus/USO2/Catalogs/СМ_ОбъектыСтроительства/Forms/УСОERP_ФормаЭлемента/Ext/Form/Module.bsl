#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьИнтервал(Команда)
	
	ОбщегоНазначенияУТКлиент.РедактироватьПериод(Объект, 
		Новый Структура("ДатаНачала, ДатаОкончания", "НачалоСтроительства", "ОкончаниеСтроительства"));
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		СценарииПланированияПроектовСтроительства,
		"Владелец",
		Объект.Ссылка,
		ВидСравненияКомпоновкиДанных.Равно,
		, // Представление - автоматически
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		СценарииПланированияПроектовСтроительства,
		"НомерВерсии",
		0,
		ВидСравненияКомпоновкиДанных.Равно,
		, // Представление - автоматически
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);

		
	// Обновим данные по базовому и рабочему сценарию.
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Справочники.СМ_ОбъектыСтроительства.ПолучитьБазовыйИРабочийСценарийПланирования(Объект));
	
	Если Не ЗначениеЗаполнено(Объект.НоменклатураРаботЗаказчика) Тогда
		Объект.НоменклатураРаботЗаказчика 	= Константы.УСОERP_НоменклатураРаботПриОтгрузкеПриемке.Получить();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.НоменклатураЗаказчика) Тогда
		Объект.НоменклатураЗаказчика 		= Константы.УСОERP_НоменклатураДляОтраженияУслугЗаказчика.Получить();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.НоменклатураГенподрядчика) Тогда
		Объект.НоменклатураГенподрядчика 	= Константы.УСОERP_НоменклатураДляОтраженияУслугГенподрядчика.Получить();
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Ложь); 
	
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтаФорма, ДополнительныеПараметры);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	
	СобытияФорм.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
	Параметры.ИсходныйЭлемент = Параметры.ЗначениеКопирования;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		СценарииПланированияПроектовСтроительства,
		"Владелец",
		Объект.Ссылка,
		ВидСравненияКомпоновкиДанных.Равно,
		, // Представление - автоматически
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
		
	// Обновим данные по базовому и рабочему сценарию.
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Справочники.СМ_ОбъектыСтроительства.ПолучитьБазовыйИРабочийСценарийПланирования(Объект));
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРаботы(Команда)
	
	ТекущийСценарий = Элементы.СценарииПланирования.ТекущаяСтрока;
	
	Если НЕ ЗначениеЗаполнено(ТекущийСценарий) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СценарийПланирования", ТекущийСценарий);
	
	Если Элементы.СценарииПланирования.ТекущиеДанные.НовыйВариант Тогда
		
		ОткрытьФорму("Справочник.УСОERP_СценарииПланированияПроектовСтроительства.Форма.ФормаЭлементаДинамическая",Новый Структура("Ключ",ТекущийСценарий),ЭтотОбъект,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе	
		
		ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаПланаПроекта",ПараметрыФормы, ЭтаФорма, , , , ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли; 			
	
КонецПроцедуры

#КонецОбласти

#Область СметнаяПодсистема

&НаКлиенте
Процедура НастройкаОбъекта(Команда)
	Если Объект.Ссылка.Пустая() Тогда
		Возврат
	КонецЕсли;
	СтруктураПараметров = ПолучитьДанныеНастройки(Объект.Ссылка);
	Если СтруктураПараметров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОткрытьФорму("ОбщаяФорма.СМ_НастройкиСметыПообъектно",СтруктураПараметров,,ЭтаФорма.УникальныйИдентификатор);
КонецПроцедуры
 
&НаСервере
Функция ПолучитьДанныеНастройки(ТекОбъект)
	Если ТекОбъект.ЭтоГруппа Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПараметрыФормы = Новый Структура("ТекОбъект", ТекОбъект);
	Возврат ПараметрыФормы;
КонецФункции

#КонецОбласти

