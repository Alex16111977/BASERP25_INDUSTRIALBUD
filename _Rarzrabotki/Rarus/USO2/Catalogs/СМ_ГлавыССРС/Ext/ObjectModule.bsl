#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Не СМ_СметаВызовСервера.КонтрольУникальности("СМ_ГлавыССРС", "ПорядковыйНомер", ПорядковыйНомер, ЭтотОбъект.Ссылка, Родитель) Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Элемент с таким порядковым номером уже присутствует в базе'"));
	КонецЕсли;
	Если Не СМ_СметаВызовСервера.КонтрольУникальности("СМ_ГлавыССРС", "НомерГлавы", НомерГлавы, ЭтотОбъект.Ссылка, Родитель) Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Элемент с таким номером главы уже присутствует в базе'"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Код) Тогда
		УстановитьНовыйКод();
	КонецЕсли;
	Если НЕ ЭтоГруппа Тогда 
		Если Не ЗначениеЗаполнено(Идентификатор) Тогда
			Идентификатор = "Г" + СокрЛП(Строка(НомерГлавы));
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
