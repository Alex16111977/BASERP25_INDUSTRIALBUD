#Область СлужебныеПроцедурыИФункции

// Возвращает максимальное значение реквизита ПорядковыйНомер в справочнике.
//
// Параметры:
//		Родитель - СправочникСсылка.СМ_ГлавыССРС - если задана папка справочника, 
//												   поиск номера осуществляется в пределах папки.
//
// Возвращаемое значние:
//		Число - максимальный порядковый номер.
//
Функция ПолучитьМаксимальныйНомерПоПорядку(Родитель = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ГлавыССРС.ПорядковыйНомер КАК ПорядковыйНомер
	               |ИЗ
	               |	Справочник.СМ_ГлавыССРС КАК ГлавыССРС
	               |ГДЕ
	               |	ГлавыССРС.Родитель = &Родитель
	               |	И ГлавыССРС.ЭтоГруппа = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПорядковыйНомер УБЫВ";
				   
	Запрос.УстановитьПараметр("Родитель", ?(ЗначениеЗаполнено(Родитель), Родитель, Справочники.СМ_ГлавыССРС.ПустаяСсылка()));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПорядковыйНомер;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции
	
#КонецОбласти