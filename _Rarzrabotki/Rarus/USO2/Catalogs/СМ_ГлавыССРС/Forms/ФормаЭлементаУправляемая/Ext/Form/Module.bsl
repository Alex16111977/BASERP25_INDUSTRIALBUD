#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура НомерГлавыПриИзменении(Элемент)
	Объект.Идентификатор = "Г" + Объект.НомерГлавы;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	Если Объект.Ссылка = Справочники.СМ_ГлавыССРС.ПустаяСсылка() Тогда
		Объект.Код = 0;
 		Объект.ПорядковыйНомер = Справочники.СМ_ГлавыССРС.ПолучитьМаксимальныйНомерПоПорядку(Объект.Родитель) + 1;
		Объект.ТипСтроительства = Объект.Родитель.ТипСтроительства;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти