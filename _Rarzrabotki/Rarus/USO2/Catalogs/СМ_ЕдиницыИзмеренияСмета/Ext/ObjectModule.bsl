#Область СлужебныеСобытия

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Не СМ_СметаВызовСервера.КонтрольУникальности("СМ_ЕдиницыИзмеренияСмета", "СметныйКод", СметныйКод, Ссылка);     
	                                                   
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Единица %1 имеет не уникальный код, она не сохранена в справочнике!!!'"), Наименование));	
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Код) Тогда
		Если ЗначениеЗаполнено(Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоКоду(Формат(СметныйКод, "ЧГ=0"))) Тогда
			УстановитьНовыйКод();
		Иначе
			Код = Формат(СметныйКод, "ЧГ=0");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриУстановкеНовогоКода(СтандартнаяОбработка, Префикс)
	СтандартнаяОбработка = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ЕдиницыИзмеренияСмета.Код КАК Код
	               |ИЗ
	               |	Справочник.СМ_ЕдиницыИзмеренияСмета КАК СМ_ЕдиницыИзмеренияСмета
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Код";
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	НовыйКод = 1;
	НовыКодСтрокой = Формат(НовыйКод, "ЧГ=0");
	Пока РезультатЗапроса.Найти(НовыКодСтрокой) <> Неопределено Цикл
		НовыйКод = НовыйКод + 1;
		НовыКодСтрокой = Формат(НовыйКод, "ЧГ=0");
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
