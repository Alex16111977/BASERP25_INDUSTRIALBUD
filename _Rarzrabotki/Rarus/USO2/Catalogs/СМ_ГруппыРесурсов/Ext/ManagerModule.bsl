#Область СлужебныеПроцедуры

// В зависимости от СметноНормативнойБазы возвращает группу ресурсов.
//
// Параметры:
// 		СНБ - СправочникСсылка.СМ_СметноНормативныеБазы - содержит ссылку на нормативную базу.
//
Функция ЗаполнитьГруппуРесурсовПоУмолчанию(СНБ) Экспорт
	
	Если СНБ.Код = "TS" Тогда
		Возврат Справочники.СМ_ГруппыРесурсов.КаталогТСН;
	ИначеЕсли СНБ.Код = "PG" Тогда
		Возврат Справочники.СМ_ГруппыРесурсов.КаталогГазпром;
	ИначеЕсли СНБ.Код = "RK" Тогда
		Возврат Справочники.СМ_ГруппыРесурсов.КаталогРК;
	ИначеЕсли СНБ.ГодВыпуска = Перечисления.СМ_ГодыВыпускаБазы.г1984 Тогда
		Возврат Справочники.СМ_ГруппыРесурсов.Каталог1984;
	ИначеЕсли СНБ.ГодВыпуска = Перечисления.СМ_ГодыВыпускаБазы.г2017 Тогда
		Возврат Справочники.СМ_ГруппыРесурсов.Каталог2017;
	Иначе 
		Возврат Справочники.СМ_ГруппыРесурсов.Каталог2001;
	КонецЕсли;
	
КонецФункции

#КонецОбласти