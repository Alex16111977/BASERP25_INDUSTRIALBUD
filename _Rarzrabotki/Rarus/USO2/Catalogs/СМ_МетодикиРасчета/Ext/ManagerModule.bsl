
#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеВыбора = Новый СписокЗначений();
		
	Если ПолучитьФункциональнуюОпцию("СМ_МетодикаМДС35") Тогда
		ДанныеВыбора.Добавить(Справочники.СМ_МетодикиРасчета.СМ_МетодикаМДС35);
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("СМ_КЗ_МетодикаРСНБКазахстан") Тогда
		ДанныеВыбора.Добавить(Справочники.СМ_МетодикиРасчета.СМ_КЗ_РСНБ);
	КонецЕсли;

	Если ПолучитьФункциональнуюОпцию("СМ_МетодикаТСНГородаМосква") Тогда
		ДанныеВыбора.Добавить(Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква);
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("СМ_Методика84Года") Тогда
		ДанныеВыбора.Добавить(Справочники.СМ_МетодикиРасчета.СМ_Методика84года);
	КонецЕсли;     	
	
	Если ПолучитьФункциональнуюОпцию("СМ_МетодикаМДС2017") Тогда
		ДанныеВыбора.Добавить(Справочники.СМ_МетодикиРасчета.СМ_МетодикаМДС2017);
	КонецЕсли;  	
	
КонецПроцедуры

#КонецОбласти
