
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ХранилищеДереваРазделов = Объект.Ссылка.ХранилищеДереваРазделов.Получить();
		Если ХранилищеДереваРазделов = Неопределено Тогда
			НоваяСтрока = ДеревоРазделов.ПолучитьЭлементы().Добавить();
			НоваяСтрока.Раздел = "Шаблон";
		КонецЕсли;
		
		Если ХранилищеДереваРазделов.Свойство("ДеревоРазделов")
			И ХранилищеДереваРазделов.ДеревоРазделов <> Неопределено Тогда
			ЗначениеВРеквизитФормы(ХранилищеДереваРазделов.ДеревоРазделов, "ДеревоРазделов");
		КонецЕсли;
		Если ХранилищеДереваРазделов.Свойство("НаборШифров")
			И ХранилищеДереваРазделов.НаборШифров <> Неопределено Тогда
			ЗначениеВРеквизитФормы(ХранилищеДереваРазделов.НаборШифров, "НаборШифров");
		КонецЕсли;
		
	Иначе
		
		НоваяСтрока = ДеревоРазделов.ПолучитьЭлементы().Добавить();
		НоваяСтрока.Раздел = "Шаблон";
		
		Если Параметры.Свойство("ДеревоРазделов") Тогда
			Если Параметры.ДеревоРазделов <> Неопределено Тогда
				ТекДеревоРазделов = Параметры.ДеревоРазделов.Получить();
				ЗначениеВРеквизитФормы(ТекДеревоРазделов, "ДеревоРазделов");
			КонецЕсли;
		КонецЕсли;
		
		Если Параметры.Свойство("Смета") Тогда
			ЗаполнитьЗначенияСвойств(Объект,Параметры.Смета);
		КонецЕсли;	
			
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СМ_СметаКлиент.ОтобразитьУровеньМетодРасчета(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ПроверитьДеревоРазделов(ДеревоРазделов, Отказ);
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='В дереве разделов не может быть пустых строк'"));
		Возврат;
	КонецЕсли;
	
	Структура = Новый Структура;
	Структура.Вставить("ДеревоРазделов", РеквизитФормыВЗначение("ДеревоРазделов"));
	Структура.Вставить("НаборШифров", РеквизитФормыВЗначение("НаборШифров"));
	ТекущийОбъект.ХранилищеДереваРазделов = Новый ХранилищеЗначения(Структура);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура МетодРасчетаПриИзменении(Элемент)
	СМ_СметаКлиент.ОтобразитьУровеньМетодРасчета(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура УровеньПриИзменении(Элемент) 
	СМ_СметаКлиент.ОтобразитьУровеньМетодРасчета(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура СпособРасчетаИндексовПриИзменении(Элемент)
	СМ_СметаКлиент.ОтобразитьУровеньМетодРасчета(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоРазделов

&НаКлиенте
Процедура ДеревоРазделовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = (Элемент.ТекущиеДанные.ПолучитьРодителя() = Неопределено И Копирование);
	Параметр = Тип("СправочникСсылка.СМ_РазделыЛокальнойСметы");
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРазделовПередНачаломИзменения(Элемент, Отказ)
	Отказ = Элемент.ТекущиеДанные.ПолучитьРодителя() = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРазделовПередУдалением(Элемент, Отказ)
	
	Для Каждого ТекИдентификатор Из Элемент.ВыделенныеСтроки Цикл
		ТекСтрока = ДеревоРазделов.НайтиПоИдентификатору(ТекИдентификатор);
		Если ТекСтрока <> Неопределено Тогда
			УдалитьНаборШифров(ТекСтрока.КлючСтроки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРазделовПослеУдаления(Элемент)
	Если ДеревоРазделов.ПолучитьЭлементы().Количество() = 0 Тогда
		НоваяСтрока = ДеревоРазделов.ПолучитьЭлементы().Добавить();
		НоваяСтрока.Раздел = "Шаблон";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРазделовРазделНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораРаздел",ЭтаФорма);
	ОткрытьФорму("Справочник.СМ_РазделыЛокальнойСметы.ФормаВыбора",,ЭтаФорма,,,,ОповещениеОЗакрытии,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьНаборШифров(Команда)
	
	Если Элементы.ДеревоРазделов.ТекущиеДанные = Неопределено Или Элементы.ДеревоРазделов.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КлючСтроки = Элементы.ДеревоРазделов.ТекущиеДанные.КлючСтроки;
	МассивШифров = Новый Массив;
	Если КлючСтроки <> 0 Тогда
		МассивШифров = ПолучитьМассивШифров(КлючСтроки);
	КонецЕсли;
	ПараметрыОткрытия = Новый Структура("МассивШифров", МассивШифров);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриЗакрытииФормыНабораШаблонов", ЭтаФорма);
	ОткрытьФорму("Справочник.СМ_ШаблоныСмет.Форма.ФормаНабораШифров", ПараметрыОткрытия, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

&НаКлиенте
Процедура Пусто(Команда)
	
	// Заглушка для кнопки, отражающей выбранный вариант
	ВыбранВариант = "Пусто";

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПроверитьДеревоРазделов(СтрокаДерева, Отказ)
	
	Для Каждого ТекСтрока Из СтрокаДерева.ПолучитьЭлементы() Цикл
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	
		Отказ = Не ЗначениеЗаполнено(ТекСтрока.Раздел);
		ПроверитьДеревоРазделов(ТекСтрока, Отказ);
	КонецЦикла;
	
КонецПроцедуры

// Осуществляет действия после закрытия формы справочника Раздела.
//
// Параметры:
//		Результат - Массив - содержит элементы справочника, форма которого закрыта.
//		ДополнительныеПараметры - Структура - дополнительные параметры, переданные при формировании вопроса пользователю.
//
&НаКлиенте
Процедура ПриЗакрытииФормыВыбораРаздел(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Раздел Из Результат Цикл
		Элементы.ДеревоРазделов.ТекущиеДанные.Раздел = Раздел;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивШифров(КлючСтроки)
	
	ПараметрыОтбора = Новый Структура("КлючСтроки", КлючСтроки);
	НайденныеСтроки = НаборШифров.Выгрузить().НайтиСтроки(ПараметрыОтбора);
	Массив = Новый Массив;
	Для Каждого ТекСтрока Из НайденныеСтроки Цикл
		Структура = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТекСтрока);
		Массив.Добавить(Структура);
	КонецЦикла;
	Возврат Массив;
	
КонецФункции

&НаКлиенте
Процедура ПриЗакрытииФормыНабораШаблонов(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	КлючСтроки = Элементы.ДеревоРазделов.ТекущиеДанные.КлючСтроки;
	Если КлючСтроки = 0 И Результат.Количество() > 0 Тогда
		КлючСтроки = ПолучитьНовыйКлючСтроки();
		Элементы.ДеревоРазделов.ТекущиеДанные.КлючСтроки = КлючСтроки;
	Иначе
		УдалитьНаборШифров(КлючСтроки);
		Если Результат.Количество() = 0 Тогда
			Элементы.ДеревоРазделов.ТекущиеДанные.КлючСтроки = 0;	
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из Результат Цикл
		НоваяСтрока = НаборШифров.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.КлючСтроки = КлючСтроки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьНовыйКлючСтроки()
	
	КлючСтроки = 1;
	Пока КлючСтроки < 1000 Цикл
		Если НаборШифров.НайтиСтроки(Новый Структура("КлючСтроки", КлючСтроки)).Количество() = 0 Тогда
			Возврат КлючСтроки;
		КонецЕсли;
		КлючСтроки = КлючСтроки + 1;
	КонецЦикла;
	Возврат 0;
	
КонецФункции

&НаКлиенте
Процедура УдалитьНаборШифров(КлючСтроки)
	
	МассивСтрок = НаборШифров.НайтиСтроки(Новый Структура("КлючСтроки", КлючСтроки));
	Пока МассивСтрок.Количество() > 0 Цикл
		НаборШифров.Удалить(МассивСтрок[0]);
		МассивСтрок.Удалить(0);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


