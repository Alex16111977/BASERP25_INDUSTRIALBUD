	ДопПараметры = ПолучитьДопПараметрыПоПеременнымМодуля();
	Результат = УСОERP_ЗащищенныеФункцииСервер.УСОERP_СтроительныеРаботы_ПересчитатьТзПериодыСУчетомГрафиковРаботыРесурсов(ЭтотОбъект, ДопПараметры, СтрокаРаботы,тзПериоды0);
	ЗаполнитьПеременныеМодуляИзДопПараметров(ДопПараметры);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СообщитьЛог(Текст,Статус = Неопределено)
	Если (Не м_ВыводитьСообщения) и  (Статус <> СтатусСообщения.ОченьВажное) Тогда
	    Возврат;
	КонецЕсли; 
	
	//возможно после будем записывать в файл сообщения
	Если Статус = Неопределено Тогда
	    Статус = СтатусСообщения.Обычное;
	КонецЕсли; 
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	
	
КонецПроцедуры

