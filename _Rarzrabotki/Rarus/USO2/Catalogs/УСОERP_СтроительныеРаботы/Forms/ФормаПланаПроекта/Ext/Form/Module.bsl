&НаСервере
Процедура УстановитьДоступностьПолейДереваРабот(Режим)
	
	Если Режим = "ВСписке" Тогда 
		Элементы.Состояние.ТолькоПросмотр = Истина;
		Элементы.ТрудозатратыФактСтр.ТолькоПросмотр = Истина;
		Элементы.ДеревоРаботИзменить.Видимость = Ложь;
		Элементы.ДеревоРаботОткрытьКарточку.Видимость = Истина;
	Иначе
		Элементы.Состояние.ТолькоПросмотр = Ложь;
		Элементы.ТрудозатратыФактСтр.ТолькоПросмотр = Ложь;
		Элементы.ДеревоРаботИзменить.Видимость = Истина;
		Элементы.ДеревоРаботОткрытьКарточку.Видимость = Ложь;
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Функция ПолучитьЧисловуюЧасть(Знач Строка) 
	
	Строка = СокрЛП(Строка);
	Если ПустаяСтрока(Строка) Тогда 
		Возврат "0";
	КонецЕсли;	
	
	ЧисловаяЧасть = "";
	
	ДопустимыеСимволы = "0123456789., ";
	Для Инд = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка,Инд,1);
		Если Найти(ДопустимыеСимволы, Символ) > 0 Тогда 
			ЧисловаяЧасть = ЧисловаяЧасть + Символ;
		Иначе	
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
	
	ЧисловаяЧасть = СтрЗаменить(ЧисловаяЧасть, " ", "");
	
	Возврат ЧисловаяЧасть;
	
КонецФункции	

&НаКлиенте
Процедура ОбновитьДеревоРабот()
	
	СписокРаскрытыхРабот.Очистить();
	УСОERP_УправлениеСтроительнымПроизводствомКлиент.ПолучитьМассивРаскрытыхРабот(Элементы.ДеревоРабот, ДеревоРабот.ПолучитьЭлементы(), СписокРаскрытыхРабот);
		
	ЗаполнитьДеревоРабот();
	
	УСОERP_УправлениеСтроительнымПроизводствомКлиент.УстановитьРазвернутостьЭлементовДерева(Элементы.ДеревоРабот, ДеревоРабот, СписокРаскрытыхРабот);
	УСОERP_УправлениеСтроительнымПроизводствомКлиент.УстановитьТекущуюРаботуВДеревеПоСсылке(Элементы.ДеревоРабот, ДеревоРабот, ТекущаяРабота);
	
	ОбновитьКнопкиСвернутьДоУровня();
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбновитьКнопкиСвернутьДоУровня()
	
	ПолучитьМаксимальнуюГлубинуДерева(); 

	ДобавитьКнопкиСвернутьУровняНаФорму();
	
	ГлубинаДереваРаботСтарая = ГлубинаДереваРабот;
	
КонецПроцедуры	

&НаСервере
Процедура ДобавитьКнопкиСвернутьУровняНаФорму()
	
	Для инд = 1 По ГлубинаДереваРаботСтарая Цикл
		ИмяКоманды = "ДеревоРаботСвернутьДоУровня" + СтрЗаменить(инд, Символы.НПП, "");	
		ЭтаФорма.Элементы.Удалить(ЭтаФорма.Элементы[ИмяКоманды]);
		ЭтаФорма.Команды.Удалить(ЭтаФорма.Команды[ИмяКоманды]);
	КонецЦикла;	
	
	Для инд = 1 По ГлубинаДереваРабот Цикл
		ИмяКоманды = "ДеревоРаботСвернутьДоУровня" + СтрЗаменить(инд, Символы.НПП, "");	
		
		НоваяКомандаФормы = ЭтаФорма.Команды.Добавить(ИмяКоманды);
		НоваяКомандаФормы.Заголовок = "Свернуть до уровня";
		НоваяКомандаФормы.ИзменяетСохраняемыеДанные = Ложь;
		НоваяКомандаФормы.Действие = "СвернутьДоУровня";
		
		НоваяКнопка             = ЭтаФорма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ЭтаФорма.Элементы.ДеревоРаботСвернутьДоУровня);       
		НоваяКнопка.Заголовок  	= СтрЗаменить(инд, Символы.НПП, "");   
		НоваяКнопка.ИмяКоманды  = ИмяКоманды;		
	КонецЦикла;	
	
КонецПроцедуры


&НаКлиенте
Процедура СвернутьДоУровня(Команда)

	СвернутьДоУровня = Число(СтрЗаменить(Команда.Имя, "ДеревоРаботСвернутьДоУровня", ""));	
	СвернутьДрервоДоУровня(0, ДеревоРабот);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьМаксимальнуюГлубинуДерева(Знач Уровень = 0, ДеревоСтроки = Неопределено) 

	Если ДеревоСтроки = Неопределено Тогда 
		ДеревоСтроки = ДеревоРабот.ПолучитьЭлементы();
		ГлубинаДереваРабот = 0;
	КонецЕсли;
	Уровень = Уровень + 1;

	Если ДеревоСтроки.Количество() > 0 И Уровень > ГлубинаДереваРабот Тогда 
		ГлубинаДереваРабот = Уровень;	
	КонецЕсли;
	
	Для Каждого Стр Из ДеревоСтроки Цикл 
		ПолучитьМаксимальнуюГлубинуДерева(Уровень, Стр.ПолучитьЭлементы());		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьДрервоДоУровня(Знач Уровень = 0, ТекущаяСтрока) 

	ДеревоСтроки = ТекущаяСтрока.ПолучитьЭлементы();

	Уровень = Уровень + 1;	
	Для Каждого Стр Из ДеревоСтроки Цикл 
		Если Уровень < СвернутьДоУровня Тогда 
			ИдентификаторСтроки	= Стр.ПолучитьИдентификатор();
			Элементы.ДеревоРабот.Развернуть(ИдентификаторСтроки);
			СвернутьДрервоДоУровня(Уровень, Стр);
		Иначе 	
			ИдентификаторСтроки	= Стр.ПолучитьИдентификатор();
			Элементы.ДеревоРабот.Свернуть(ИдентификаторСтроки);
			СвернутьДрервоДоУровня(Уровень, Стр);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	
	
	МассивРабот = Новый Массив;
	Для Каждого СтрокаДерева Из ПараметрыПеретаскивания.Значение Цикл
		МассивРабот.Добавить(Новый Структура("Работа, ИдентификаторСтроки", СтрокаДерева.Ссылка, СтрокаДерева.ПолучитьИдентификатор()));
		
		Родитель = СтрокаДерева.ПолучитьРодителя();
		Если Не Родитель = Неопределено Тогда
			ПодчиненныеСтроки = Родитель.ПолучитьЭлементы();
			Если ПодчиненныеСтроки.Количество() = 0
				И Родитель.СуммарнаяРабота Тогда
				Родитель.СуммарнаяРабота = Ложь;
				ЗаписатьСтроительнуюРаботуИзСтрокиДерева(Родитель.ПолучитьИдентификатор(), );
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ОбработатьРезультатПеретаскивания(МассивРабот);
	
	ОбновитьДеревоРабот();
	
КонецПроцедуры

