// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ КОМАНД ДЕРЕВА Работ

&НаКлиенте
Процедура ДобавитьПодчиненную(Команда)
	
	ТекущаяСтрока = Элементы.ДеревоРабот.ТекущаяСтрока;
	
	Если ТекущаяСтрока = Неопределено Тогда 
		
		НовыйЭлемент					= ДеревоРабот.ПолучитьЭлементы().Добавить();
		ПериодСценария 					= ПолучитьПериодСценария(СценарийПланирования);
		НовыйЭлемент.НачалоРаботыПлан	= ПериодСценария.НачалоСтроительства;
		
		Элементы.ДеревоРабот.ТекущаяСтрока 	= НовыйЭлемент.ПолучитьИдентификатор();
		Элементы.ДеревоРабот.ТекущийЭлемент = Элементы.ДеревоРаботРабота;
		Элементы.ДеревоРабот.ИзменитьСтроку();
		
		ОбновитьКнопкиСвернутьДоУровня();
		
	Иначе
		
		ЭлементДерева 	= ДеревоРабот.НайтиПоИдентификатору(ТекущаяСтрока);
		
		ПроверкаНаличияМатериалов = Материалы.НайтиСтроки(Новый Структура("Работа", ЭлементДерева.Ссылка));
		ПроверкаНаличияРесурсов = Ресурсы.НайтиСтроки(Новый Структура("Работа", ЭлементДерева.Ссылка));
		
		ПараметрыВопроса = Новый Структура;
		ПараметрыВопроса.Вставить("ЭлементДерева",ЭлементДерева);
		ПараметрыВопроса.Вставить("ПроверкаНаличияМатериалов",ПроверкаНаличияМатериалов);
		ПараметрыВопроса.Вставить("ПроверкаНаличияРесурсов",ПроверкаНаличияРесурсов);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьПодчиненнуюПродолжение",ЭтотОбъект,ПараметрыВопроса);
		
		
		Если ПроверкаНаличияМатериалов.Количество()>0
			ИЛИ ПроверкаНаличияРесурсов.Количество()>0 Тогда
			
			ПоказатьВопрос(ОписаниеОповещения,"Перед добавлением подчиненной материалы и ресурсы будут очищены. Продолжить?",РежимДиалогаВопрос.ДаНет);
			
		Иначе
			
			ДобавитьПодчиненнуюПродолжение(КодВозвратаДиалога.Да,ПараметрыВопроса);
			
		КонецЕсли; 		
		
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПодчиненнуюПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементДерева = ДопПараметры.ЭлементДерева;
	ПроверкаНаличияМатериалов = ДопПараметры.ПроверкаНаличияМатериалов;
	ПроверкаНаличияРесурсов = ДопПараметры.ПроверкаНаличияРесурсов; 	
	
	НовыйЭлемент 	= ЭлементДерева.ПолучитьЭлементы().Добавить();
	НовыйЭлемент.НачалоРаботыПлан	= ЭлементДерева.НачалоРаботыПлан;
	
	ОчиститьПотребностьВМатериалахИРесурсахПоРаботе(ЭлементДерева.Ссылка);
	Для Каждого СтрокаМатериалов Из ПроверкаНаличияМатериалов Цикл
		Материалы.Удалить(СтрокаМатериалов);
	КонецЦикла;
	Для Каждого СтрокаРесурсов Из ПроверкаНаличияРесурсов Цикл
		Ресурсы.Удалить(СтрокаРесурсов);
	КонецЦикла;
	
	ЭлементДерева.ИзмененоВручную = Истина;
	НовыйЭлемент.ИзмененоВручную = Истина;
	
	Элементы.ДеревоРабот.ТекущаяСтрока 	= НовыйЭлемент.ПолучитьИдентификатор();
	Элементы.ДеревоРабот.ТекущийЭлемент = Элементы.ДеревоРаботРабота;
	Элементы.ДеревоРабот.ИзменитьСтроку();
	
	ОбновитьКнопкиСвернутьДоУровня();	
	
КонецПроцедуры  

&НаКлиенте
Процедура ДобавитьПоследующую(Команда)
		
	ТекущаяСтрока = Элементы.ДеревоРабот.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда 
		НовыйЭлемент 					= ДеревоРабот.ПолучитьЭлементы().Добавить();
		ПериодСценария 					= ПолучитьПериодСценария(СценарийПланирования);
		НовыйЭлемент.НачалоРаботыПлан	= ПериодСценария.НачалоСтроительства;
	Иначе
		ЭлементДерева = ДеревоРабот.НайтиПоИдентификатору(ТекущаяСтрока);
		РодительЭлемента = ЭлементДерева.ПолучитьРодителя();
		
		Если РодительЭлемента = Неопределено Тогда 
			НовыйЭлемент = ДеревоРабот.ПолучитьЭлементы().Добавить();
		Иначе
			НовыйЭлемент = РодительЭлемента.ПолучитьЭлементы().Добавить();
		КонецЕсли;	
		
		НовыйЭлемент.НачалоРаботыПлан	= РеквизитыСценарияПланирования.ПлановаяДатаНачала;
		
		Предшественники = НовыйЭлемент.Предшественники;
		
		СтрокаПредшественник = Предшественники.Добавить();
		СтрокаПредшественник.ОбъектСтроительстваПредшественника = ОбъектСтроительства;
		СтрокаПредшественник.РаботаПредшественник 				= ЭлементДерева.Ссылка;
		СтрокаПредшественник.ТипЗависимости 					= ПредопределенноеЗначение("Перечисление.УСОERP_ТипыЗависимостейРабот.ОкончаниеНачало");
		
		НовыйЭлемент.ПодписьПредшественники = ПредставлениеПредшественников(Предшественники, ОбъектСтроительства);
	КонецЕсли;	
	
	Элементы.ДеревоРабот.ТекущаяСтрока 	= НовыйЭлемент.ПолучитьИдентификатор();
	Элементы.ДеревоРабот.ТекущийЭлемент = Элементы.ДеревоРаботРабота;
	Элементы.ДеревоРабот.ИзменитьСтроку();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПериодСценария(Сценарий) 
	Возврат Новый Структура("НачалоСтроительства, ОкончаниеСтроительства", Сценарий.НачалоСтроительства, Сценарий.ОкончаниеСтроительства);
КонецФункции

&НаКлиенте
Процедура НаУровеньНиже(Команда)
	
	ИзмененныеРаботы = Новый Массив;
	ИзмененныеРаботы.Добавить(ТекущаяРабота);
	ОбновитьИзмененныеСтрокиРабот(ИзмененныеРаботы);
	
	Если Элементы.ДеревоРабот.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокРаскрытыхРабот.Очистить();
	УСОERP_УправлениеСтроительнымПроизводствомКлиент.ПолучитьМассивРаскрытыхРабот(Элементы.ДеревоРабот, ДеревоРабот.ПолучитьЭлементы(), СписокРаскрытыхРабот);
	ТекущаяРаботаДоПеремещения = ТекущаяРабота;
	МассивВыделенныхРабот = Новый Массив;
	Для Каждого ВыделеннаяСтрока Из Элементы.ДеревоРабот.ВыделенныеСтроки Цикл
		Ссылка = ДеревоРабот.НайтиПоИдентификатору(ВыделеннаяСтрока).Ссылка;	
		МассивВыделенныхРабот.Добавить(Ссылка);
	КонецЦикла;
	
	НаУровеньНижеСервер(Элементы.ДеревоРабот.ТекущиеДанные.Ссылка, Элементы.ДеревоРабот.ТекущиеДанные.РодительскаяРабота);
		
	УСОERP_УправлениеСтроительнымПроизводствомКлиент.УстановитьРазвернутостьЭлементовДерева(Элементы.ДеревоРабот, ДеревоРабот, СписокРаскрытыхРабот);		
	Элементы.ДеревоРабот.ВыделенныеСтроки.Очистить();
	Для Каждого Ссылка Из МассивВыделенныхРабот Цикл
		УСОERP_УправлениеСтроительнымПроизводствомКлиент.УстановитьВыделеннуюРаботуВДеревеПоСсылке(Элементы.ДеревоРабот, ДеревоРабот, Ссылка);	
	КонецЦикла;
	УСОERP_УправлениеСтроительнымПроизводствомКлиент.УстановитьТекущуюРаботуВДеревеПоСсылке(Элементы.ДеревоРабот, ДеревоРабот, ТекущаяРаботаДоПеремещения);
	УстановитьДоступностьКомандПеремещения(ТекущаяРабота, ДеревоРабот, Элементы);
	
	ОбновитьКнопкиСвернутьДоУровня();

КонецПроцедуры

&НаКлиенте
Процедура НаУровеньВыше(Команда)
	
	ИзмененныеРаботы = Новый Массив;
	ИзмененныеРаботы.Добавить(ТекущаяРабота);
	ОбновитьИзмененныеСтрокиРабот(ИзмененныеРаботы);
	
	Если Элементы.ДеревоРабот.ТекущиеДанные = Неопределено 
		ИЛИ НЕ ЗначениеЗаполнено(Элементы.ДеревоРабот.ТекущиеДанные.РодительскаяРабота) Тогда
		Возврат;
	КонецЕсли;
	
	СписокРаскрытыхРабот.Очистить();
	УСОERP_УправлениеСтроительнымПроизводствомКлиент.ПолучитьМассивРаскрытыхРабот(Элементы.ДеревоРабот, ДеревоРабот.ПолучитьЭлементы(), СписокРаскрытыхРабот);
	ТекущаяРаботаДоПеремещения = ТекущаяРабота;
	МассивВыделенныхРабот = Новый Массив;
	Для Каждого ВыделеннаяСтрока Из Элементы.ДеревоРабот.ВыделенныеСтроки Цикл
		Ссылка = ДеревоРабот.НайтиПоИдентификатору(ВыделеннаяСтрока).Ссылка;	
		МассивВыделенныхРабот.Добавить(Ссылка);
	КонецЦикла;

	НаУровеньВышеСервер(Элементы.ДеревоРабот.ТекущиеДанные.Ссылка, Элементы.ДеревоРабот.ТекущиеДанные.РодительскаяРабота);
		
	УСОERP_УправлениеСтроительнымПроизводствомКлиент.УстановитьРазвернутостьЭлементовДерева(Элементы.ДеревоРабот, ДеревоРабот, СписокРаскрытыхРабот);		
	Элементы.ДеревоРабот.ВыделенныеСтроки.Очистить();
	Для Каждого Ссылка Из МассивВыделенныхРабот Цикл
		УСОERP_УправлениеСтроительнымПроизводствомКлиент.УстановитьВыделеннуюРаботуВДеревеПоСсылке(Элементы.ДеревоРабот, ДеревоРабот, Ссылка);	
	КонецЦикла;
	УСОERP_УправлениеСтроительнымПроизводствомКлиент.УстановитьТекущуюРаботуВДеревеПоСсылке(Элементы.ДеревоРабот, ДеревоРабот, ТекущаяРаботаДоПеремещения);
    УстановитьДоступностьКомандПеремещения(ТекущаяРабота, ДеревоРабот, Элементы);

	ОбновитьКнопкиСвернутьДоУровня();
	
КонецПроцедуры

&НаКлиенте
Процедура Вверх(Команда)
	
	Если Элементы.ДеревоРабот.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяРаботаДоПеремещения = ТекущаяРабота;
	МассивВыделенныхРабот = Новый Массив;
	Для Каждого ВыделеннаяСтрока Из Элементы.ДеревоРабот.ВыделенныеСтроки Цикл
		Ссылка = ДеревоРабот.НайтиПоИдентификатору(ВыделеннаяСтрока).Ссылка;	
		МассивВыделенныхРабот.Добавить(Ссылка);
	КонецЦикла;
	
	ВверхСервер();
		
	Элементы.ДеревоРабот.ВыделенныеСтроки.Очистить();
	Для Каждого Ссылка Из МассивВыделенныхРабот Цикл
		УСОERP_УправлениеСтроительнымПроизводствомКлиент.УстановитьВыделеннуюРаботуВДеревеПоСсылке(Элементы.ДеревоРабот, ДеревоРабот, Ссылка);	
	КонецЦикла;
	
	УСОERP_УправлениеСтроительнымПроизводствомКлиент.УстановитьТекущуюРаботуВДеревеПоСсылке(Элементы.ДеревоРабот, ДеревоРабот, ТекущаяРаботаДоПеремещения);
	
КонецПроцедуры

&НаКлиенте
Процедура Вниз(Команда)
	
	Если Элементы.ДеревоРабот.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяРаботаДоПеремещения = ТекущаяРабота;
	МассивВыделенныхРабот = Новый Массив;
	Для Каждого ВыделеннаяСтрока Из Элементы.ДеревоРабот.ВыделенныеСтроки Цикл
		Ссылка = ДеревоРабот.НайтиПоИдентификатору(ВыделеннаяСтрока).Ссылка;	
		МассивВыделенныхРабот.Добавить(Ссылка);
	КонецЦикла;
	
	ВнизСервер();
		
	Элементы.ДеревоРабот.ВыделенныеСтроки.Очистить();
	Для Каждого Ссылка Из МассивВыделенныхРабот Цикл
		УСОERP_УправлениеСтроительнымПроизводствомКлиент.УстановитьВыделеннуюРаботуВДеревеПоСсылке(Элементы.ДеревоРабот, ДеревоРабот, Ссылка);	
	КонецЦикла;
	
	УСОERP_УправлениеСтроительнымПроизводствомКлиент.УстановитьТекущуюРаботуВДеревеПоСсылке(Элементы.ДеревоРабот, ДеревоРабот, ТекущаяРаботаДоПеремещения);
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	
	ОбновитьДеревоРабот();
		
КонецПроцедуры

&НаКлиенте
Процедура Копировать(Команда)
	
	РаботыКопировать.Очистить();
	ВыделенныеСтроки = Элементы.ДеревоРабот.ВыделенныеСтроки;
	Если ВыделенныеСтроки = Неопределено Или ВыделенныеСтроки.Количество() <= 0 Тогда
		Возврат;
	КонецЕсли;	
	
	КопироватьНаСервере(ВыделенныеСтроки);

КонецПроцедуры

&НаСервере
Процедура КопироватьНаСервере(ВыделенныеСтроки)
	
	Для Каждого СтрокаТаблицы Из ВыделенныеСтроки Цикл
		СтрокаТаблицыРабота = ДеревоРабот.НайтиПоИдентификатору(СтрокаТаблицы);
		Если СтрокаТаблицыРабота = Неопределено Тогда 
			Продолжить;
		КонецЕсли;	
		
		РаботаСсылка = СтрокаТаблицыРабота.Ссылка;
		Если РаботаСсылка.Пустая() Тогда
			Продолжить;
		КонецЕсли;	
			
		РаботыКопировать.Добавить(РаботаСсылка);
	КонецЦикла;	

КонецПроцедуры

&НаКлиенте
Процедура Вставить(Команда)
	
	ТекущаяСтрока = Элементы.ДеревоРабот.ТекущаяСтрока;
	Если Не ТекущаяСтрока = Неопределено И 
		РаботыКопировать.Количество() > 0 Тогда 
	    ВставитьНаСервере(ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВставитьНаСервере(ТекущаяСтрока)
	
	СтрокаТаблицыРабота = ДеревоРабот.НайтиПоИдентификатору(ТекущаяСтрока);
	Если СтрокаТаблицыРабота = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	РаботаТекущаяСсылка = СтрокаТаблицыРабота.Ссылка;
	Если РаботаТекущаяСсылка.Пустая() Тогда
		Возврат;
	КонецЕсли;	
	
	НачатьТранзакцию();
	
	Этап 						= РаботаТекущаяСсылка.Родитель;
	НомерТекущейРаботыВУровне 	= РаботаТекущаяСсылка.НомерРаботыВУровне;
	
	СтруктураДанных = Новый Структура("ВидПланирования, НачалоРаботыПлан, ОкончаниеРаботыПлан, ДлительностьПлан, ЕдиницаДлительности, ОбъемРаботы, ЕдиницаОбъема, АвторИзменения, Утверждена");
	СтруктураДанных.АвторИзменения 	= ТекущийПользователь;
	СтруктураДанных.Утверждена 		= Ложь;
	
	СоответствиеКопируемыхРаботКНовым = Новый Соответствие;
	Для Каждого Работа Из РаботыКопировать Цикл 
		НоваяРабота = Справочники.УСОERP_СтроительныеРаботы.СоздатьЭлемент();		
		ЗаполнитьЗначенияСвойств(НоваяРабота, Работа.Значение,, "Родитель, Код, КодСДР, НомерРаботыВУровне, СуммарнаяРабота");
		НоваяРабота.Родитель 			= Этап;  
		НоваяРабота.Владелец 			= СценарийПланирования;
		// получение кода СДР
		ДанныеКода = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДРИНомерРаботыВУровне(СценарийПланирования, Этап);
		НоваяРабота.КодСДР             	= ДанныеКода.КодСДР;
		НоваяРабота.НомерРаботыВУровне 	= ДанныеКода.НомерРаботыВУровне;
		Попытка
			НоваяРабота.Записать();
		Исключение			
			ОтменитьТранзакцию();	
			Сообщить(ОписаниеОшибки());
			Возврат;			
		КонецПопытки;	

		СоответствиеКопируемыхРаботКНовым.Вставить(Работа.Значение, НоваяРабота.Ссылка);
		
		ДанныеРаботы = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПараметрыВыполненияРаботы(Работа.Значение, ВидПланирования, КонецДня(НаДату));
		ЗаполнитьЗначенияСвойств(СтруктураДанных, ДанныеРаботы ,, "Утверждена");
		УСОERP_УправлениеСтроительнымПроизводством.ЗаписатьПараметрыВыполненияРаботы(НоваяРабота.Ссылка, ВидПланирования, НачалоДня(НаДату), СтруктураДанных);	
	
	КонецЦикла;
		
	МатериалыКопируемыхРабот = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПотребностьВМатериалах(РаботыКопировать, ВидПланирования, КонецДня(НаДату));
	Для Каждого Стр Из МатериалыКопируемыхРабот Цикл 
		МенеджерЗаписи 	= РегистрыСведений.УСОERP_ПотребностьВМатериалах.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Стр);
		МенеджерЗаписи.Работа			= СоответствиеКопируемыхРаботКНовым.Получить(Стр.Работа);
		МенеджерЗаписи.ВидПланирования 	= ВидПланирования;	
		МенеджерЗаписи.Период			= НачалоДня(НаДату);
		МенеджерЗаписи.АвторИзмерения	= ТекущийПользователь;
		МенеджерЗаписи.Записать();		
	КонецЦикла;
	
	РесурсыКопируемыхРабот = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПотребностьВРесурсах(РаботыКопировать, ВидПланирования, КонецДня(НаДату));
	Для Каждого Стр Из РесурсыКопируемыхРабот Цикл 
		МенеджерЗаписи 	= РегистрыСведений.УСОERP_ПотребностьВРесурсах.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Стр);
		МенеджерЗаписи.Работа			= СоответствиеКопируемыхРаботКНовым.Получить(Стр.Работа);
		МенеджерЗаписи.ВидПланирования 	= ВидПланирования;	
		МенеджерЗаписи.Период			= НачалоДня(НаДату);
		МенеджерЗаписи.АвторИзмерения	= ТекущийПользователь;
		МенеджерЗаписи.Записать();		
	КонецЦикла;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СвязиМеждуРаботами.ОбъектСтроительстваПредшественника,
		|	СвязиМеждуРаботами.РаботаПредшественник,
		|	СвязиМеждуРаботами.РаботаПоследователь,
		|	СвязиМеждуРаботами.ТипЗависимости,
		|	СвязиМеждуРаботами.Задержка,
		|	СвязиМеждуРаботами.ЕдиницаЗадержки
		|ИЗ
		|	РегистрСведений.УСОERP_СвязиМеждуРаботами.СрезПоследних(
		|			,
		|			РаботаПоследователь В (&РаботыКопировать)
		|				И РаботаПредшественник В (&РаботыКопировать)) КАК СвязиМеждуРаботами
		|ГДЕ
		|	НЕ СвязиМеждуРаботами.ТипЗависимости = ЗНАЧЕНИЕ(Перечисление.УСОERP_ТипыЗависимостейРабот.пустаяссылка)";
	
	Запрос.УстановитьПараметр("РаботыКопировать", РаботыКопировать);	
	РезультатЗапроса 	= Запрос.Выполнить();	
	Выборка 			= РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи 	= РегистрыСведений.УСОERP_СвязиМеждуРаботами.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
		МенеджерЗаписи.РаботаПредшественник	= СоответствиеКопируемыхРаботКНовым.Получить(Выборка.РаботаПредшественник);
		МенеджерЗаписи.РаботаПоследователь	= СоответствиеКопируемыхРаботКНовым.Получить(Выборка.РаботаПоследователь);		
		МенеджерЗаписи.Период				= НачалоДня(НаДату);
		МенеджерЗаписи.АвторИзмерения		= ТекущийПользователь;
		МенеджерЗаписи.Записать();	
	КонецЦикла;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(СтроительныеРаботы.НомерРаботыВУровне) КАК НомерРаботыВУровнеМаксимум
		|ИЗ
		|	Справочник.УСОERP_СтроительныеРаботы КАК СтроительныеРаботы
		|ГДЕ
		|	СтроительныеРаботы.Родитель = &Родитель
		|	И НЕ СтроительныеРаботы.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Родитель", Этап);	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		НомерРаботыВУровнеМаксимум = Выборка.НомерРаботыВУровнеМаксимум;
		Сдвиг = НомерРаботыВУровнеМаксимум - НомерТекущейРаботыВУровне - СоответствиеКопируемыхРаботКНовым.Количество();
		
		Если Сдвиг > 0 Тогда  
			МассивСсылок = Новый Массив;
			Для Каждого Стр Из СоответствиеКопируемыхРаботКНовым Цикл
				Ссылка = Стр.Значение;
				Индекс = Неопределено;
				Для Каждого Элемент Из МассивСсылок Цикл
					Если Элемент.НомерРаботыВУровне > Ссылка.НомерРаботыВУровне Тогда
						Индекс = МассивСсылок.Найти(Элемент);
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если Индекс = Неопределено Тогда
					МассивСсылок.Добавить(Ссылка);
				Иначе
					МассивСсылок.Вставить(Индекс, Ссылка); 
				КонецЕсли;	
			КонецЦикла;
			
			Пока Сдвиг > 0 Цикл 
				Сдвиг = Сдвиг - 1;
				Для Каждого Ссылка Из МассивСсылок Цикл
					// Получение Работы с номером в уровне, меньшим на 1, чем текущий
					Запрос = Новый Запрос;
					Запрос.Текст =
					"ВЫБРАТЬ
					|	СтроительныеРаботы.Ссылка
					|ИЗ
					|	Справочник.УСОERP_СтроительныеРаботы КАК СтроительныеРаботы
					|ГДЕ
					|	СтроительныеРаботы.Владелец = &Владелец
					|	И СтроительныеРаботы.Родитель = &Родитель
					|	И Не ПометкаУдаления
					|	И СтроительныеРаботы.НомерРаботыВУровне = &НомерРаботыВУровне";
					Запрос.УстановитьПараметр("Владелец", 			СценарийПланирования);
					Запрос.УстановитьПараметр("Родитель", 			Этап);
					Запрос.УстановитьПараметр("НомерРаботыВУровне", Ссылка.НомерРаботыВУровне - 1);
					
					Выборка = Запрос.Выполнить().Выбрать();
					Если Выборка.Следующий() Тогда
												
						// изменение реквизитов объектов
						ТекущаяРаботаОбъект    = Ссылка.ПолучитьОбъект();
						ПредыдущаяРаботаОбъект = Выборка.Ссылка.ПолучитьОбъект();
						
						Буфер                                     = ТекущаяРаботаОбъект.НомерРаботыВУровне;
						ТекущаяРаботаОбъект.НомерРаботыВУровне    = ПредыдущаяРаботаОбъект.НомерРаботыВУровне;
						ПредыдущаяРаботаОбъект.НомерРаботыВУровне = Буфер;
						
						БуферСДР                      = ТекущаяРаботаОбъект.КодСДР;
						ТекущаяРаботаОбъект.КодСДР    = ПредыдущаяРаботаОбъект.КодСДР;
						ПредыдущаяРаботаОбъект.КодСДР = БуферСДР;
												
						Попытка
							ТекущаяРаботаОбъект.Записать();
							ПредыдущаяРаботаОбъект.Записать();
						Исключение			
							ОтменитьТранзакцию();			
							Возврат;			
						КонецПопытки;
						
						ИзмененныеРаботы = Новый Массив;
						ИзмененныеРаботы.Добавить(ТекущаяРаботаОбъект.Ссылка);
						ИзмененныеРаботы.Добавить(ПредыдущаяРаботаОбъект.Ссылка);
						
						// заполнение кодов СДР
						УСОERP_УправлениеСтроительнымПроизводством.ЗаполнитьКодыСДРПодчиненныхРабот(ТекущаяРаботаОбъект.Ссылка, ИзмененныеРаботы);
						УСОERP_УправлениеСтроительнымПроизводством.ЗаполнитьКодыСДРПодчиненныхРабот(ПредыдущаяРаботаОбъект.Ссылка, ИзмененныеРаботы);
						
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;

		КонецЕсли;
	КонецЕсли;
	
	Для Каждого Стр из СоответствиеКопируемыхРаботКНовым Цикл 
		
		УСОERP_УправлениеСтроительнымПроизводством.РассчитатьПланСценарияПланированияПроектовСтроительства(Стр.Значение, ВидПланирования, НаДату);
		
	КонецЦикла;	
	ЗаполнитьДеревоРабот();	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьМатериалы(Команда)
	
	Элементы.ДеревоРаботОтобразитьМатериалы.Пометка = Не Элементы.ДеревоРаботОтобразитьМатериалы.Пометка;
	Элементы.ГруппаМатериалы.Видимость 				= Элементы.ДеревоРаботОтобразитьМатериалы.Пометка;
	ПересчитатьШиринуПодчиненныхЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьРесурсы(Команда)
	
	Элементы.ДеревоРаботОтобразитьРесурсы.Пометка 	= Не Элементы.ДеревоРаботОтобразитьРесурсы.Пометка;
	Элементы.ГруппаРесурсы.Видимость 				= Элементы.ДеревоРаботОтобразитьРесурсы.Пометка;
	ПересчитатьШиринуПодчиненныхЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьШиринуПодчиненныхЭлементов()
	
	Если Элементы.ДеревоРаботОтобразитьМатериалы.Пометка И Элементы.ДеревоРаботОтобразитьРесурсы.Пометка Тогда
		КоличествоТЧ = 2;
	Иначе
		КоличествоТЧ = 1;
	КонецЕсли;
	
	Если Элементы.ДеревоРаботОтобразитьМатериалы.Пометка Тогда
		Для Каждого ТекЭлемент Из Элементы.Материалы.ПодчиненныеЭлементы Цикл
			
			ТекЭлемент.Ширина = Окр(ЭтаФорма.Ширина / (Элементы.Материалы.ПодчиненныеЭлементы.Количество() * КоличествоТЧ) - 1, 0, РежимОкругления.Окр15как10);
			
			Если ТипЗнч(ТекЭлемент) = Тип("ГруппаФормы") Тогда
				Для Каждого ЭлементГруппы Из ТекЭлемент.ПодчиненныеЭлементы Цикл
					ЭлементГруппы.Ширина = Окр(ЭтаФорма.Ширина / (Элементы.Материалы.ПодчиненныеЭлементы.Количество() * КоличествоТЧ) - 2, 0, РежимОкругления.Окр15как10);
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Если Элементы.ДеревоРаботОтобразитьРесурсы.Пометка Тогда
		Для Каждого ТекЭлемент Из Элементы.Ресурсы.ПодчиненныеЭлементы Цикл
			
			ТекЭлемент.Ширина = Окр(ЭтаФорма.Ширина / (Элементы.Ресурсы.ПодчиненныеЭлементы.Количество() * КоличествоТЧ) - 1, 0, РежимОкругления.Окр15как10);
			
			Если ТипЗнч(ТекЭлемент) = Тип("ГруппаФормы") Тогда
				Для Каждого ЭлементГруппы Из ТекЭлемент.ПодчиненныеЭлементы Цикл
					ЭлементГруппы.Ширина = Окр(ЭтаФорма.Ширина / (Элементы.Ресурсы.ПодчиненныеЭлементы.Количество() * КоличествоТЧ) - 2, 0, РежимОкругления.Окр15как10);
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СвязатьВыделенныеНаСервере(ВыделенныеСтроки)
	
	Этап = Неопределено;
	МассивВыделенныхРабот = Новый Массив; 
	Для Каждого СтрокаТаблицы Из ВыделенныеСтроки Цикл
		СтрокаТаблицыРабота = ДеревоРабот.НайтиПоИдентификатору(СтрокаТаблицы);
		Если СтрокаТаблицыРабота = Неопределено Тогда 
			Продолжить;
		КонецЕсли;	
		
		РаботаСсылка = СтрокаТаблицыРабота.Ссылка;
		Если РаботаСсылка.Пустая() Тогда
			Продолжить;
		КонецЕсли;	
		
		Если Не Этап = Неопределено И Не Этап = РаботаСсылка.Родитель Тогда 
			ТекстСообщения = НСтр("ru='Связать выделенные строки невозможно. Не все выделенные работы принадлежат одному этапу!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);			
			Возврат;
		КонецЕсли;	
		МассивВыделенныхРабот.Добавить(РаботаСсылка);
		Этап = РаботаСсылка.Родитель;
	КонецЦикла;	

	КоличествоСвязейДляВыделенныхСтрок 	= МассивВыделенныхРабот.Количество() - 1;
	Если КоличествоСвязейДляВыделенныхСтрок = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	ТипЗависимости	= Перечисления.УСОERP_ТипыЗависимостейРабот.ОкончаниеНачало;	
	Для инд = 1 По КоличествоСвязейДляВыделенныхСтрок Цикл 
		МенеджерЗаписи 	= РегистрыСведений.УСОERP_СвязиМеждуРаботами.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ОбъектСтроительстваПредшественника 	= ОбъектСтроительства;		
		МенеджерЗаписи.РаботаПредшественник 				= МассивВыделенныхРабот[инд-1];	
		МенеджерЗаписи.РаботаПоследователь					= МассивВыделенныхРабот[инд];
		МенеджерЗаписи.ТипЗависимости 						= ТипЗависимости;			
		МенеджерЗаписи.Период								= НачалоДня(НаДату);
		МенеджерЗаписи.АвторИзмерения						= ТекущийПользователь;
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
	УСОERP_УправлениеСтроительнымПроизводством.РассчитатьПланСценарияПланированияПроектовСтроительства(МассивВыделенныхРабот[0], ВидПланирования, НаДату, МассивВыделенныхРабот);
	ОбновитьИзмененныеСтрокиРабот(МассивВыделенныхРабот);
		
КонецПроцедуры

&НаКлиенте
Процедура СвязатьВыделенные(Команда)
	
	ВыделенныеСтроки = Элементы.ДеревоРабот.ВыделенныеСтроки;
	Если ВыделенныеСтроки = Неопределено Или ВыделенныеСтроки.Количество() <= 0 Тогда
		Возврат;
	КонецЕсли;	

	СвязатьВыделенныеНаСервере(ВыделенныеСтроки);
	
	//ДеревоРаботДлительностьПланПриИзменении(Истина);
	ДеревоРаботПриОкончанииРедактирования(Истина, Ложь, Ложь);	
КонецПроцедуры

&НаКлиенте
Процедура НоваяСвязь(Команда)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено И ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда 
		Возврат;
	КонецЕсли;	
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОбъектСтроительстваПредшественника", ОбъектСтроительства);
	ПараметрыФормы.Вставить("РаботаПоследователь", ТекущиеДанные.Ссылка);	
	ОткрытьФорму("РегистрСведений.УСОERP_СвязиМеждуРаботами.ФормаЗаписи", ПараметрыФормы, ЭтаФорма); 
	
КонецПроцедуры

&НаКлиенте
Процедура Свернуть(Команда)
	
	СвернутьНаКлиенте(ДеревоРабот);
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьНаКлиенте(ТекущаяСтрока)
	
	КоллекцияЭлементовДерева	= ТекущаяСтрока.ПолучитьЭлементы();
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл
		ИдентификаторСтроки	= Строка.ПолучитьИдентификатор();
		Элементы.ДеревоРабот.Свернуть(ИдентификаторСтроки);
		СвернутьНаКлиенте(Строка);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Развернуть(Команда)
	
	РазвернутьНаКлиенте(ДеревоРабот);

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьНаКлиенте(ТекущаяСтрока)
	
	КоллекцияЭлементовДерева	= ТекущаяСтрока.ПолучитьЭлементы();
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл
