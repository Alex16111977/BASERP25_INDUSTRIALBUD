	НайденнаяСтрока = Неопределено;
	Для каждого Стр Из м_тзВершиныГрафа Цикл
		Если (Стр.ТипОграничения = Перечисления.УСОERP_ТипыОграничений.КакМожноПозже) и (Стр.КоличествоВходов <> -2)Тогда
			 Если НайденнаяСтрока = Неопределено Тогда
			    НайденнаяСтрока = Стр;
			 Иначе	
			    Если НайденнаяСтрока.ДатаНач < Стр.ДатаНач Тогда
				   НайденнаяСтрока = Стр;
				КонецЕсли; 
			 КонецЕсли; 
		КонецЕСли;	
	КонецЦикла; 	
    Возврат НайденнаяСтрока;
