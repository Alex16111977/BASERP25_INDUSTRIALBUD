	Для Каждого СтрокаРабот Из ТаблицаИзмененныхРабот Цикл
		
	//	МассивСтрок = мДеревоРабот.Строки.НайтиСтроки(Новый Структура("Ссылка", СтрокаРабот.Работа), Истина);
	//	Для Каждого СтрокаДерева Из МассивСтрок Цикл
	//		Если СтрокаДерева.Строки.Количество()>0  
	//			И СтрокаДерева.СуммарнаяРабота = Ложь Тогда
	//			СтрокаДерева.СуммарнаяРабота = Истина;
	//			ЗаписатьСтроительнуюРаботуИзСтрокиДерева(, СтрокаДерева,);
	//		КонецЕсли;
	//	КонецЦикла;
	
	УСОERP_УправлениеСтроительнымПроизводством.ЗаполнитьКодыСДРПодчиненныхРабот(СтрокаРабот.Работа);
	
КонецЦикла;
	
	ЗначениеВРеквизитФормы(мДеревоРабот, "ДеревоРабот"); 	
	
