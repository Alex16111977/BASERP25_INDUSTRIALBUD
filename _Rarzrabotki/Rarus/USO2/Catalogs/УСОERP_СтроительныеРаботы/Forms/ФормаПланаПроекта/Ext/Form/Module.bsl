&НаКлиенте
Процедура МатериалыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ТекущаяСтрокаРабота 	= Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущаяСтрокаРабота = Неопределено Тогда 
		Отказ = Истина;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущаяСтрокаМатериалы	= Элементы.Материалы.ТекущиеДанные;
	ТекущаяСтрокаРабота 	= Элементы.ДеревоРабот.ТекущиеДанные;

	Если НоваяСтрока Тогда 
		ТекущаяСтрокаМатериалы.Работа	= ТекущаяСтрокаРабота.Ссылка;
	КонецЕсли;	

КонецПроцедуры

&НаСервере
Процедура ЗаписатьПотребностьВМатериалах(Работа)
	
	ТаблицаМатериалы	= РеквизитФормыВЗначение("Материалы");
	МатериалыТекущейРаботы	= ТаблицаМатериалы.НайтиСтроки(Новый Структура("Работа",Работа));	
	Если МатериалыТекущейРаботы.Количество()= 0 тогда
		МатериалыТекущейРаботы	= ТаблицаМатериалы.НайтиСтроки(Новый Структура("Работа, НаименованиеРаботы",Справочники.УСОERP_СтроительныеРаботы.ПустаяСсылка(), Работа.Наименование));	
	КонецЕсли;
	
	УСОERP_УправлениеСтроительнымПроизводством.ЗаписатьПотребностьВМатериалах(Работа, ВидПланирования, НаДату, ТаблицаМатериалы.Скопировать(МатериалыТекущейРаботы), ТекущийПользователь);

КонецПроцедуры

&НаКлиенте
Процедура МатериалыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	ТекущиеМатериалы = Элементы.Материалы.ТекущиеДанные;
	Если Не  ТекущиеМатериалы = Неопределено Тогда
		ТекущиеМатериалы.НаименованиеРаботы = ТекущиеДанные.Наименование;
	КонецЕсли;
	  
	ЗаписатьПотребностьВМатериалах(ТекущиеДанные.Ссылка);

	ТекущиеДанные.ИзмененоВручную = Истина;
		
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПослеУдаления(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	ТекущиеДанные.ИзмененоВручную = Истина;
	
	ЗаписатьПотребностьВМатериалах(ТекущиеДанные.Ссылка);

КонецПроцедуры

&НаСервере
Процедура ОчиститьПотребностьВМатериалахИРесурсахПоРаботе(Работа)
	
	ПотребностьВМатериалахПоРаботе = Материалы.НайтиСтроки(Новый Структура("Работа", Работа));
	Для Каждого ТекСтрокаПотребность Из ПотребностьВМатериалахПоРаботе Цикл		
		НаборЗаписейМатериалов = РегистрыСведений.УСОERP_ПотребностьВМатериалах.СоздатьНаборЗаписей();
		НаборЗаписейМатериалов.Отбор.Работа.Установить			(ТекСтрокаПотребность.Работа);
		НаборЗаписейМатериалов.Отбор.Номенклатура.Установить	(ТекСтрокаПотребность.Номенклатура);
		НаборЗаписейМатериалов.Отбор.Характеристика.Установить	(ТекСтрокаПотребность.Характеристика);
		НаборЗаписейМатериалов.Отбор.ВидПланирования.Установить	(ВидПланирования);
		НаборЗаписейМатериалов.Записать();
	КонецЦикла;
	
	ПотребностьВРесурсахПоРаботе = Ресурсы.НайтиСтроки(Новый Структура("Работа", Работа));
	Для Каждого ТекСтрокаПотребность Из ПотребностьВРесурсахПоРаботе Цикл		
		НаборЗаписейРесурсов = РегистрыСведений.УСОERP_ПотребностьВРесурсах.СоздатьНаборЗаписей();
		НаборЗаписейРесурсов.Отбор.Работа.Установить			(ТекСтрокаПотребность.Работа);
		НаборЗаписейРесурсов.Отбор.Ресурс.Установить			(ТекСтрокаПотребность.Ресурс);
		НаборЗаписейРесурсов.Отбор.ВидПланирования.Установить	(ВидПланирования);
		НаборЗаписейРесурсов.Записать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Ресурсы

&НаКлиенте
Процедура РесурсыКоличествоПриИзменении(Элемент)
	
	ТекущаяСтрокаРесурсы	= Элементы.Ресурсы.ТекущиеДанные;
	ТекущаяСтрокаРабота 	= Элементы.ДеревоРабот.ТекущиеДанные;
	ПересчитатьТрудоемкостьМашиноемкостьНаКлиенте(ТекущаяСтрокаРесурсы, ТекущаяСтрокаРабота);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоРесурсов(Ресурс)
	
	Возврат Новый Структура("Рабочие, Механизмы", Ресурс.Рабочие.Итог("Количество"), Ресурс.Механизмы.Итог("Количество"));
	
КонецФункции

&НаКлиенте
Процедура ПересчитатьТрудоемкостьМашиноемкостьНаКлиенте(ТекущаяСтрокаРесурсы, ТекущаяСтрокаРабота)
	
	Если НЕ ТекущаяСтрокаРесурсы = Неопределено И ТекущаяСтрокаРабота = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ДлительностьПланЧас= ?(ТекущаяСтрокаРабота.ЕдиницаДлительности = ЕдиницыИзмеренияВремениЧас, ТекущаяСтрокаРабота.ДлительностьПлан,
							УСОERP_УправлениеСтроительнымПроизводством.РассчитатьДлительностьПериода(ТекущаяСтрокаРабота.Ссылка, 
							ТекущаяСтрокаРабота.НачалоРаботыПлан, 
							ТекущаяСтрокаРабота.ОкончаниеРаботыПлан, 
							ЕдиницыИзмеренияВремениЧас,
							?(ЗначениеЗаполнено(ТекущаяСтрокаРесурсы.ГрафикРаботы),ТекущаяСтрокаРесурсы.ГрафикРаботы, ?(ЗначениеЗаполнено(ТекущаяСтрокаРабота.ГрафикРаботы),ТекущаяСтрокаРабота.ГрафикРаботы, РеквизитыОбъектаСтроительства.ГрафикРаботы))));		
					
			
	КоличествоРабочих =  ПолучитьКоличествоРесурсов(ТекущаяСтрокаРесурсы.Ресурс);
		
	ТекущаяСтрокаРесурсы.Трудоемкость	= ТекущаяСтрокаРесурсы.Количество * ТекущаяСтрокаРесурсы.ЗагрузкаПроцент /100 
		* КоличествоРабочих.Рабочие* ДлительностьПланЧас;
		
	ТекущаяСтрокаРесурсы.Машиноемкость	= ТекущаяСтрокаРесурсы.Количество * ТекущаяСтрокаРесурсы.ЗагрузкаПроцент /100 
		* КоличествоРабочих.Механизмы * ДлительностьПланЧас;
		
КонецПроцедуры

&НаКлиенте
Процедура РесурсыЗагрузкаПроцентПриИзменении(Элемент)
	
	ТекущаяСтрокаРесурсы	= Элементы.Ресурсы.ТекущиеДанные;
	ТекущаяСтрокаРабота 	= Элементы.ДеревоРабот.ТекущиеДанные;
	ПересчитатьТрудоемкостьМашиноемкостьНаКлиенте(ТекущаяСтрокаРесурсы, ТекущаяСтрокаРабота);
	
КонецПроцедуры

&НаКлиенте
Процедура РесурсыРесурсПриИзменении(Элемент)
	
	ТекущаяСтрокаРесурсы	= Элементы.Ресурсы.ТекущиеДанные;
	ТекущаяСтрокаРабота 	= Элементы.ДеревоРабот.ТекущиеДанные;
	ПересчитатьТрудоемкостьМашиноемкостьНаКлиенте(ТекущаяСтрокаРесурсы, ТекущаяСтрокаРабота);
	
	Если  ТекущаяСтрокаРесурсы <> Неопределено И ТекущаяСтрокаРабота <> Неопределено Тогда 
		ТекущаяСтрокаРесурсы.ГрафикРаботы = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ТекущаяСтрокаРабота.Ссылка,"ГрафикРаботы");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РесурсыГрафикРаботыПриИзменении(Элемент)
	
	ТекущаяСтрокаРесурсы	= Элементы.Ресурсы.ТекущиеДанные;
	ТекущаяСтрокаРабота 	= Элементы.ДеревоРабот.ТекущиеДанные;
	ПересчитатьТрудоемкостьМашиноемкостьНаКлиенте(ТекущаяСтрокаРесурсы, ТекущаяСтрокаРабота);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПотребностьВРесурсах(Работа)
	
	ТаблицаРесурсы	= РеквизитФормыВЗначение("Ресурсы");
	РесурсыТекущейРаботы	= ТаблицаРесурсы.НайтиСтроки(Новый Структура("Работа",Работа));
		
	Если РесурсыТекущейРаботы.Количество()= 0 тогда
		РесурсыТекущейРаботы	= ТаблицаРесурсы.НайтиСтроки(Новый Структура("Работа, НаименованиеРаботы",Справочники.УСОERP_СтроительныеРаботы.ПустаяСсылка(), Работа.Наименование));	
	КонецЕсли;
      
	УСОERP_УправлениеСтроительнымПроизводством.ЗаписатьПотребностьВРесурсах(Работа, ВидПланирования, НаДату, ТаблицаРесурсы.Скопировать(РесурсыТекущейРаботы), ТекущийПользователь);

КонецПроцедуры

&НаКлиенте
Процедура РесурсыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	ТекущиеРесурсы = Элементы.Ресурсы.ТекущиеДанные;
	Если Не  ТекущиеРесурсы = Неопределено Тогда
		ТекущиеРесурсы.НаименованиеРаботы = ТекущиеДанные.Наименование;
	КонецЕсли;

	ЗаписатьПотребностьВРесурсах(ТекущиеДанные.Ссылка);
	
	ТекущиеДанные.ИзмененоВручную = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура РесурсыПослеУдаления(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	ТекущиеДанные.ИзмененоВручную = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура РесурсыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущаяСтрокаРесурсы	= Элементы.Ресурсы.ТекущиеДанные;
	ТекущаяСтрокаРабота 	= Элементы.ДеревоРабот.ТекущиеДанные;

	Если НоваяСтрока Тогда 
		ТекущаяСтрокаРесурсы.Работа	= ТекущаяСтрокаРабота.Ссылка;
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура РесурсыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ТекущаяСтрокаРабота 	= Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущаяСтрокаРабота = Неопределено Тогда 
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Предшественники

&НаКлиенте
Процедура ДеревоРаботПодписьПредшественникиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	ПараметрыФормы = Новый Структура;	
//	ПараметрыФормы.Вставить("Отбор", Новый Структура("Владелец, ПометкаУдаления", СценарийПланирования, Ложь));
	ПараметрыФормы.Вставить("СценарийПланирования",СценарийПланирования);
	ПараметрыФормы.Вставить("ПометкаУдаления",Ложь);
	
	Предшественники = ТекущиеДанные.Предшественники;
	Если Предшественники.Количество() = 1 Тогда 
		ПараметрыФормы.Вставить("ТекущаяСтрока", Предшественники[0].РаботаПредшественник);
	КонецЕсли;	
	
	ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботПодписьПредшественникиАвтоПодбор(Элемент, Текст, ДанныеВыбора, Параметры, Ожидание, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Текст) Тогда 
		СтандартнаяОбработка = Ложь;
		ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
		ДанныеВыбора = УСОERP_УправлениеСтроительнымПроизводством.СформироватьДанныеВыбораРаботыСценарияПланирования(Текст, 
			СценарийПланирования, 
			?(ТекущиеДанные = Неопределено, Неопределено, ТекущиеДанные.Ссылка));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботПодписьПредшественникиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Предшественники = ТекущиеДанные.Предшественники;
	Предшественники.Очистить();
	
	НоваяСтрока = Предшественники.Добавить();
	НоваяСтрока.ОбъектСтроительстваПредшественника 	= ОбъектСтроительства;
	НоваяСтрока.РаботаПредшественник 				= ВыбранноеЗначение;
	НоваяСтрока.ТипЗависимости 						= ПредопределенноеЗначение("Перечисление.УСОERP_ТипыЗависимостейРабот.ОкончаниеНачало");
	
	ТекущиеДанные.ПодписьПредшественники = ПредставлениеПредшественников(Предшественники, ОбъектСтроительства);
	ТекущиеДанные.ИзмененоВручную = Истина;
	ЗаписатьСтроительнуюРаботуИзСтрокиДерева(Элементы.ДеревоРабот.ТекущаяСтрока);	
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботПодписьПредшественникиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ПодписьПредшественники) Тогда 
		Предшественники = ТекущиеДанные.Предшественники;
		Предшественники.Очистить();
		ТекущиеДанные.ПодписьПредшественники = "";
		ЗаписатьСтроительнуюРаботуИзСтрокиДерева(Элементы.ДеревоРабот.ТекущаяСтрока);	
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботПодписьПредшественникиОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Текст) Тогда 
		СтандартнаяОбработка = Ложь;
		ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
		ДанныеВыбора = УСОERP_УправлениеСтроительнымПроизводством.СформироватьДанныеВыбораРаботыСценарияПланирования(Текст, 
			СценарийПланирования, 
			?(ТекущиеДанные = Неопределено, Неопределено, ТекущиеДанные.Ссылка));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботПодписьПредшественникиОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка =Ложь;
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда 
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", ТекущиеДанные.Ссылка);
		ПараметрыФормы.Вставить("ТекущаяЗакладкаПредшественники", Истина);
		РазблокироватьСтрокуДляРедактирования(ТекущиеДанные.Ссылка, ЭтаФорма.УникальныйИдентификатор);

		ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьШаблонИзРабот(Команда)
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Если ЗначениеЗаполнено(СценарийПланирования) Тогда
			ФормаСозданияШаблона = ПолучитьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаСозданияШаблонаИзРабот");
			ФормаСозданияШаблона.Источник = Неопределено;
			ФормаСозданияШаблона.Открыть();				
		КонецЕсли; 
	Иначе
		ФормаСозданияШаблона = ПолучитьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаСозданияШаблонаИзРабот");
		МассивИндексовСтрок = Элементы.ДеревоРабот.ВыделенныеСтроки;
		СписокРабот = Новый СписокЗначений;
		Для Каждого ЭлементМассивИндексовСтрок Из МассивИндексовСтрок Цикл
			СтрокаДереваРабот = ДеревоРабот.НайтиПоИдентификатору(ЭлементМассивИндексовСтрок);
			СписокРабот.Добавить(СтрокаДереваРабот.Ссылка);
		КонецЦикла;
		ФормаСозданияШаблона.Источник = СписокРабот;
		ФормаСозданияШаблона.Открыть();		
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРаботыИзШаблона(Команда)
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	
	ПередаваемыеПараметры = Новый Структура;
	
	Если Не ЗначениеЗаполнено(СценарийПланирования) Тогда 
			Сообщить(НСтр("ru='Не заполнен сценарий планирования.'"));
			Возврат;
	КонецЕсли;		
	
	Если ТекущиеДанные = Неопределено Тогда
		ПередаваемыеПараметры.Вставить("Родитель", Неопределено);
		ПередаваемыеПараметры.Вставить("Сценарий", СценарийПланирования);
	Иначе	
		Если Не ЭтоСуммарнаяРабота(ТекущиеДанные.Ссылка) Тогда
			Сообщить(НСтр("ru='Работа не может иметь потомков.'"));
			Возврат;
		КонецЕсли;
		ПередаваемыеПараметры.Вставить("Родитель", ТекущиеДанные.Ссылка);
		ПередаваемыеПараметры.Вставить("Сценарий", СценарийПланирования);
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьФормуПланаПроекта", ЭтаФорма);
	ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаСозданияРаботИзШаблона" ,ПередаваемыеПараметры,,,,,ОписаниеОповещения);
КонецПроцедуры

