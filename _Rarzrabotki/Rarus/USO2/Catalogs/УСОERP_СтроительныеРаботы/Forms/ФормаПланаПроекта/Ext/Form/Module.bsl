&НаСервере
Процедура ВТЗНаСервере() Экспорт
   тДерево = РеквизитФормыВЗначение("ДеревоРабот");
   тТаблица = РеквизитФормыВЗначение("ТаблицаРабот");
   
   ПреобразоватьВТЗРекурсия(тДерево, тТаблица, Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
   тДерево.Строки.Очистить();
   
   ЗначениеВРеквизитФормы(тТаблица, "ТаблицаРабот");
   //ЗначениеВРеквизитФормы(тДерево, "ДеревоРабот");
КонецПроцедуры
 
&НаСервере
Процедура ПреобразоватьВТЗРекурсия(тДерево, тТаблица, ГУИД)
   Для Каждого тСтр Из тДерево.Строки Цикл
      нСтр = тТаблица.Добавить();
      ЗаполнитьЗначенияСвойств(нСтр, тСтр,,"Владелец");
	  //нСтр.Родитель = ГУИД;
	  //нСтр.ГУИД = Новый УникальныйИдентификатор();
 
      Если тСтр.Строки.Количество()>0 Тогда
         ПреобразоватьВТЗРекурсия(тСтр, тТаблица, нСтр.ГУИД);
      КонецЕсли;
   КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПроверитьОбновитьКодыСДР(СтрокаЭлементовДерева = Неопределено)
	
	Если СтрокаЭлементовДерева = Неопределено Тогда
		СтрокаЭлементовДерева = ДеревоРабот;
	КонецЕсли;
	
	ЭлементыКоллекции = СтрокаЭлементовДерева.ПолучитьЭлементы();
	
	НомерПП = 0;	
	Для Каждого СтрокаКоллекции Из ЭлементыКоллекции Цикл
		НомерПП = НомерПП + 1;
		мРодитель = СтрокаКоллекции.ПолучитьРодителя();
		Если мРодитель = Неопределено Тогда
			КодСДР_стр = "";
		Иначе
			КодСДР_стр = мРодитель.КодСДР;
		КонецЕсли;
		
		НомерРаботыВУровне = НомерПП;
		
		КодСДР = КодСДР_стр + ?(ЗначениеЗаполнено(КодСДР_стр), ".", "") + Строка(НомерРаботыВУровне);
		
		СтрокаКоллекции.КодСДР 			 = КодСДР;
		
		ПроверитьОбновитьКодыСДР(СтрокаКоллекции);
		
	КонецЦикла;
	
	
КонецПроцедуры

