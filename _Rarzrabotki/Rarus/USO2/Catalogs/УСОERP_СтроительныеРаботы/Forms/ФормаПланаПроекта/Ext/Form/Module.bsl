&НаСервере
//Процедура ЗаписатьСтроительнуюРаботуИзСтрокиДерева(ИндексСтроки, СтрокаДерева = Неопределено, СоответствиеИзмененныхРабот = Неопределено)
Процедура ЗаписатьСтроительнуюРаботуИзСтрокиДерева(ИндексСтроки, СтрокаДерева = Неопределено, СоответствиеИзмененныхРабот = Неопределено,НовыйЭлемент = Ложь)	
	Если НЕ СтрокаДерева = Неопределено Тогда
		ЭлементДерева = СтрокаДерева;
	Иначе
		ЭлементДерева = ДеревоРабот.НайтиПоИдентификатору(ИндексСтроки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭлементДерева.Ссылка) Тогда 
		СтроительнаяРаботаОбъект = ЭлементДерева.Ссылка.ПолучитьОбъект();
		
		Если ЭлементДерева.ВерсияДанных <> ЭлементДерева.Ссылка.ВерсияДанных Тогда 
			РазблокироватьСтрокуДляРедактирования(СтроительнаяРаботаОбъект.Ссылка, ЭтаФорма.УникальныйИдентификатор);
			
			Предшественники	= УСОERP_УправлениеСтроительнымПроизводством.ПолучитьСвязиМеждуРаботами(СтроительнаяРаботаОбъект.Ссылка, КонецДня(НаДату)); 

			ЗаполнитьСтрокуДереваИзРаботы(ЭлементДерева, СтроительнаяРаботаОбъект.Ссылка, Предшественники);
			
			ТекстСообщения = НСтр("ru = 'Данные были изменены другим пользователем'");
			ВызватьИсключение ТекстСообщения; 
		КонецЕсли;	
	Иначе
		СтроительнаяРаботаОбъект = Справочники.УСОERP_СтроительныеРаботы.СоздатьЭлемент();
		
		ДанныеКода = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДРИНомерРаботыВУровне(ЭлементДерева.Владелец, ЭлементДерева.РодительскаяРабота);
		
		СтроительнаяРаботаОбъект.КодСДР 			= ДанныеКода.КодСДР;
		СтроительнаяРаботаОбъект.НомерРаботыВУровне = ДанныеКода.НомерРаботыВУровне;
		СтроительнаяРаботаОбъект.Родитель 			= ЭлементДерева.РодительскаяРабота;
		НовыйЭлемент = Истина;
	КонецЕсли;	
	
	
	
	Если Не ЗначениеЗаполнено(ЭлементДерева.ЕдиницаДлительности) Тогда 
		ЭлементДерева.ЕдиницаДлительности = Перечисления.ЕдиницыИзмеренияВремени.День;	
	КонецЕсли;
	
	СтроительнаяРаботаОбъект.Наименование 	= ЭлементДерева.Наименование;
	СтроительнаяРаботаОбъект.Владелец 		= ЭлементДерева.Владелец;
	
	Попытка
		//Если НовыйЭлемент ИЛИ СтроительнаяРаботаОбъект.Наименование 	<> ЭлементДерева.Наименование ИЛИ СтроительнаяРаботаОбъект.Владелец <> ЭлементДерева.Владелец 
		//	ИЛИ СтроительнаяРаботаОбъект.Родитель <> ЭлементДерева.РодительскаяРабота   Тогда
		//	СтроительнаяРаботаОбъект.Наименование 	= ЭлементДерева.Наименование;
		//	СтроительнаяРаботаОбъект.Владелец 		= ЭлементДерева.Владелец;
		//	СтроительнаяРаботаОбъект.Родитель       = ЭлементДерева.РодительскаяРабота;
			СтроительнаяРаботаОбъект.Записать();
		Если НЕ СоответствиеИзмененныхРабот = Неопределено Тогда
			СтруктураПоРаботе = НовыЙ Структура("НовыйЭлемент, Записан", ЭлементДерева.НовыйЭлемент, Истина);
			СоответствиеИзмененныхРабот.Вставить(СтроительнаяРаботаОбъект.Ссылка, СтруктураПоРаботе);
		КонецЕсли;
	//	КонецЕсли;
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось записать элемент справочника строительных работ %Ссылка% по причине: %Причина%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Ссылка%", ЭлементДерева.Наименование);
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Предупреждение,
		Метаданные.Справочники.УСОERP_СтроительныеРаботы, ЭлементДерева.Наименование, ТекстСообщения);
	КонецПопытки;
		
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ВидПланирования", 		ВидПланирования);
	СтруктураДанных.Вставить("НачалоРаботыПлан", 		ЭлементДерева.НачалоРаботыПлан);
	СтруктураДанных.Вставить("ОкончаниеРаботыПлан", 	ЭлементДерева.ОкончаниеРаботыПлан);
	СтруктураДанных.Вставить("ДлительностьПлан", 		ЭлементДерева.ДлительностьПлан);
	СтруктураДанных.Вставить("ЕдиницаДлительности", 	ЭлементДерева.ЕдиницаДлительности);
	СтруктураДанных.Вставить("ОбъемРаботы", 		    ЭлементДерева.ОбъемРаботы);
	СтруктураДанных.Вставить("ЕдиницаОбъема", 	        ЭлементДерева.ЕдиницаОбъема);
	СтруктураДанных.Вставить("АвторИзменения",        	ТекущийПользователь);
	СтруктураДанных.Вставить("Утверждена", 				Ложь);	
	
	УСОERP_УправлениеСтроительнымПроизводством.ЗаписатьПараметрыВыполненияРаботы(СтроительнаяРаботаОбъект.Ссылка, ВидПланирования, НачалоДня(НаДату), СтруктураДанных);
	Если ТипЗнч(ЭлементДерева) = Тип("СтрокаДереваЗначений") Тогда
		УСОERP_УправлениеСтроительнымПроизводством.ЗаписатьСвязиМеждуРаботами(СтроительнаяРаботаОбъект.Ссылка, НачалоДня(НаДату), ЭлементДерева.Предшественники.Скопировать(), ТекущийПользователь);
	Иначе
		УСОERP_УправлениеСтроительнымПроизводством.ЗаписатьСвязиМеждуРаботами(СтроительнаяРаботаОбъект.Ссылка, НачалоДня(НаДату), ЭлементДерева.Предшественники.Выгрузить(), ТекущийПользователь);
	КонецЕсли;
	
	ЭлементДерева.Ссылка 		= СтроительнаяРаботаОбъект.Ссылка;
	ЭлементДерева.ВерсияДанных 	= СтроительнаяРаботаОбъект.ВерсияДанных;
	ЭлементДерева.КодСДР 		= СтроительнаяРаботаОбъект.КодСДР;

	РазблокироватьСтрокуДляРедактирования(СтроительнаяРаботаОбъект.Ссылка, ЭтаФорма.УникальныйИдентификатор);
	
	// рассчитать план
	МассивИзмененныхРабот = Новый Массив;
	УСОERP_УправлениеСтроительнымПроизводством.РассчитатьПланСценарияПланированияПроектовСтроительства(СтроительнаяРаботаОбъект.Ссылка, ВидПланирования, НачалоДня(НаДату), МассивИзмененныхРабот);
	ОбновитьИзмененныеСтрокиРабот(МассивИзмененныхРабот);
	
КонецПроцедуры	

&НаКлиенте
Процедура ДеревоРаботПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	//Проверка на изменение данных в строке, для исключения лишней перезаписи 	
	ЕстьИзменения = Ложь;
	
	Для Каждого КлючИЗНачение ИЗ ТекущаяСтрокаДерева Цикл
		
		Если ТекущиеДанные[КлючИЗначение.Ключ] <> КлючИЗначение.Значение Тогда
			
			ЕстьИзменения = Истина;
			Прервать;
			
		КонецЕсли; 
		
	КонецЦикла;
	
	Если НЕ ЕстьИзменения Тогда
		
		Возврат;
		
	КонецЕсли;	
	//	
	
	Если ОтменаРедактирования Тогда 
		РазблокироватьСтрокуДляРедактирования(ТекущиеДанные.Ссылка, ЭтаФорма.УникальныйИдентификатор);
		
		МассивИзмененныхРабот = Новый Массив;
		МассивИзмененныхРабот.Добавить(ТекущиеДанные.Ссылка);
		ОбновитьИзмененныеСтрокиРабот(МассивИзмененныхРабот);
		Возврат;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда 
		НовыйЭлемент = Истина;
	Иначе
		НовыйЭлемент = Ложь;
	КонецЕсли;	
	
	ЗаписатьСтроительнуюРаботуИзСтрокиДерева(Элементы.ДеревоРабот.ТекущаяСтрока);

	Если НовыйЭлемент Тогда 
		ПоказатьОповещениеПользователя(
			"Создание:", 
			ПолучитьНавигационнуюСсылку(ТекущиеДанные.Ссылка),
			Строка(ТекущиеДанные.Ссылка),
			БиблиотекаКартинок.Информация32);
	Иначе
		ПоказатьОповещениеПользователя(
			"Изменение:", 
			ПолучитьНавигационнуюСсылку(ТекущиеДанные.Ссылка),
			Строка(ТекущиеДанные.Ссылка),
			БиблиотекаКартинок.Информация32);
	КонецЕсли;	
	
	ЗаписатьПотребностьВМатериалах(ТекущиеДанные.Ссылка);
	ЗаписатьПотребностьВРесурсах(ТекущиеДанные.Ссылка);
	
	//Добавлено для пересчета сроков
	
	МассивЗависимыхРабот = ПолучитьМассивСтрокДляИзменения(ТекущиеДанные.Ссылка);	
	
	Шаг = ?(МассивЗависимыхРабот.Количество(), 100/МассивЗависимыхРабот.Количество(),0);
	
	 Сч = 1;
	 
	МассивИзмРабот = Новый Массив;
	
	Для Каждого ЭлементМассива ИЗ МассивЗависимыхРабот Цикл
		
		Состояние("Пересчет сроков работ-последователей...",Шаг*Сч);
		
		МассивИзмененныхРабот = Новый Массив;
		
		УСОERP_УправлениеСтроительнымПроизводством.РассчитатьПланСценарияПланированияПроектовСтроительства(ЭлементМассива, ВидПланирования, НачалоДня(НаДату), МассивИзмененныхРабот);
		
		Для Каждого ЭлМассива ИЗ МассивИзмененныхРабот Цикл
			
			Если МассивИзмРабот.Найти(ЭлМассива) = Неопределено Тогда
				
				МассивИзмРабот.Добавить(ЭлМассива);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Сч = Сч+1;
		
	КонецЦикла;
	
	ОбновитьИзмененныеСтрокиРабот(МассивИзмРабот); 
	
КонецПроцедуры

