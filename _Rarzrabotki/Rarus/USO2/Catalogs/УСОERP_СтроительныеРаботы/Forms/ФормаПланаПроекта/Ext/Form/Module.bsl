#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьДопПараметрыПоПеременнымМодуля()
	
	ДопПараметры = Новый Структура;
	
	ДопПараметры.Вставить("м_тзВершиныГрафа", м_тзВершиныГрафа);
	ДопПараметры.Вставить("м_тзРебраГрафа", м_тзРебраГрафа);
	ДопПараметры.Вставить("м_тзТаблицаЗавершенностиРабот", м_тзТаблицаЗавершенностиРабот);
	ДопПараметры.Вставить("м_тзДоступныеРесурсы", м_тзДоступныеРесурсы);
	
	ДопПараметры.Вставить("м_тзГрафики", м_тзГрафики);
	ДопПараметры.Вставить("м_тзРаботы", м_тзРаботы);
	ДопПараметры.Вставить("м_тзРебраГрафаКопия", м_тзРебраГрафаКопия);
	
	ДопПараметры.Вставить("м_ДатаНачалаСценария", м_ДатаНачалаСценария);
	ДопПараметры.Вставить("м_ДатаОкончанияСценария", м_ДатаОкончанияСценария);
	
	//ДопПараметры.Вставить("м_ДатаСтарта", м_ДатаСтарта);
	ДопПараметры.Вставить("м_УчитыватьРесурсы", м_УчитыватьРесурсы);
	ДопПараметры.Вставить("м_ВыводитьСообщения", м_ВыводитьСообщения);
	ДопПараметры.Вставить("м_ФатальнаяОшибка", м_ФатальнаяОшибка);
	
	Возврат ДопПараметры;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПеременныеМодуляИзДопПараметров(ДопПараметры)
	
	м_тзВершиныГрафа = ДопПараметры.м_тзВершиныГрафа;
	м_тзРебраГрафа = ДопПараметры.м_тзРебраГрафа;
	м_тзТаблицаЗавершенностиРабот = ДопПараметры.м_тзТаблицаЗавершенностиРабот;
	м_тзДоступныеРесурсы = ДопПараметры.м_тзДоступныеРесурсы;
	
	м_тзГрафики = ДопПараметры.м_тзГрафики;
	м_тзРаботы = ДопПараметры.м_тзРаботы;
	м_тзРебраГрафаКопия = ДопПараметры.м_тзРебраГрафаКопия;
	
	м_ДатаНачалаСценария = ДопПараметры.м_ДатаНачалаСценария;
	м_ДатаОкончанияСценария = ДопПараметры.м_ДатаОкончанияСценария;
	
	//м_ДатаСтарта = ДопПараметры.м_ДатаСтарта;
	м_УчитыватьРесурсы = ДопПараметры.м_УчитыватьРесурсы;
	м_ВыводитьСообщения = ДопПараметры.м_ВыводитьСообщения;
	м_ФатальнаяОшибка = ДопПараметры.м_ФатальнаяОшибка;
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	ОбъектСтроительства 		= Параметры.ОбъектСтроительства;
	СценарийПланирования 		= Параметры.СценарийПланирования;	
	Организация                 = СценарийПланирования.Организация;
	ВидПланирования         	= Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный;
	ТекущийПользователь 		= Пользователи.ТекущийПользователь();
	ЕдиницыИзмеренияВремениЧас 	= Перечисления.ЕдиницыИзмеренияВремени.Час;
	ГлубинаДереваРаботСтарая    = 0;
	ТекущаяОрганизация			= Организация;
	
	//НаДату = ТекущаяДата();
	
	
	Если НЕ ЗначениеЗаполнено(СценарийПланирования) Тогда 
		Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Владелец") Тогда 
			СценарийПланирования	= Параметры.Отбор.Владелец;	
			Организация				= Параметры.Отбор.Владелец.Организация;
		КонецЕсли;	
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ОбъектСтроительства) И ЗначениеЗаполнено(СценарийПланирования) Тогда 
		ОбъектСтроительства	= СценарийПланирования.Владелец;	
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ОбъектСтроительства) И ЗначениеЗаполнено(СценарийПланирования) Тогда 
		ОбъектСтроительства	= СценарийПланирования.Владелец;	
	КонецЕсли;	
	
	
	ЭтаФорма.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Сценарий планирования ""%2"" объекта строительства ""%1""'"),
		Строка(ОбъектСтроительства), Строка(СценарийПланирования));
			
	РеквизитыОбъектаСтроительства = Новый Структура;
	РеквизитыОбъектаСтроительства.Вставить("Ссылка", 				ОбъектСтроительства);
	РеквизитыОбъектаСтроительства.Вставить("ПлановаяДатаНачала",    ОбъектСтроительства.НачалоСтроительства);
	РеквизитыОбъектаСтроительства.Вставить("ПлановаяДатаОкончания", ОбъектСтроительства.НачалоСтроительства);
	РеквизитыОбъектаСтроительства.Вставить("ГрафикРаботы",          ОбъектСтроительства.ГрафикРаботы);
	
	РеквизитыСценарияПланирования = Новый Структура;
	РеквизитыСценарияПланирования.Вставить("Ссылка", 				СценарийПланирования);
	РеквизитыСценарияПланирования.Вставить("ПлановаяДатаНачала",    СценарийПланирования.НачалоСтроительства);
	РеквизитыСценарияПланирования.Вставить("ПлановаяДатаОкончания", СценарийПланирования.ОкончаниеСтроительства);
	РеквизитыСценарияПланирования.Вставить("ВидСценария",          	СценарийПланирования.ВидСценария);
	
	АдресДанныхДереваРабот = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	НаДату = ПолучитьПоследнююДатуРедактированияСценария(СценарийПланирования);
	
	ЗаполнитьДеревоРабот();
	
	УстановитьУсловноеОформление();
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Для Каждого Строка Из ДеревоРабот.ПолучитьЭлементы() Цикл
		Элементы.ДеревоРабот.Развернуть(Строка.ПолучитьИдентификатор(), Истина);
	КонецЦикла;	
	
	Элементы.ДеревоРаботОтобразитьМатериалы.Пометка = Ложь;
	Элементы.ГруппаМатериалы.Видимость 				= Ложь;	
	Элементы.ДеревоРаботОтобразитьРесурсы.Пометка 	= Ложь;
	Элементы.ГруппаРесурсы.Видимость 				= Ложь;	
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмененаРабота" И Параметр.СценарийПланирования = СценарийПланирования  Тогда 
		
		Индекс = -1;
		УСОERP_УправлениеСтроительнымПроизводствомКлиент.НайтиРаботуВДеревеПоСсылке(ДеревоРабот.ПолучитьЭлементы(), Параметр.Работа, Индекс);
		
		НайденнаяСтрока = ДеревоРабот.НайтиПоИдентификатору(Индекс);
		Если НайденнаяСтрока = Неопределено ИЛИ Параметр.Родитель <> НайденнаяСтрока.РодительскаяРабота Тогда 
			ОбновитьДеревоРабот();
		Иначе	
			ОбновитьИзмененныеСтрокиРабот(Параметр.МассивИзмененныхРабот);
		КонецЕсли;	
		
	КонецЕсли;	
		
	Если ИмяСобытия = "СозданаРабота" И Параметр.СценарийПланирования = СценарийПланирования Тогда  	
		
		Если ЗначениеЗаполнено(Параметр.Родитель) Тогда 
			Индекс = -1;
			УСОERP_УправлениеСтроительнымПроизводствомКлиент.НайтиРаботуВДеревеПоСсылке(ДеревоРабот.ПолучитьЭлементы(), Параметр.Родитель, Индекс);
			
			НоваяСтрока = ДеревоРабот.НайтиПоИдентификатору(Индекс).ПолучитьЭлементы().Добавить();
		Иначе
			НоваяСтрока = ДеревоРабот.ПолучитьЭлементы().Добавить();
		КонецЕсли;	
		НоваяСтрока.Ссылка	= Параметр.Работа;
		Элементы.ДеревоРабот.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		
		МассивИзмененныхРабот = Новый Массив;
		МассивИзмененныхРабот.Добавить(Параметр.Работа);
		
		Для Каждого Строка Из Параметр.МассивИзмененныхРабот Цикл
			МассивИзмененныхРабот.Добавить(Строка);
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Параметр.Родитель) Тогда 
			МассивИзмененныхРабот.Добавить(Параметр.Родитель);	
		КонецЕсли;	
		
		ОбновитьИзмененныеСтрокиРабот(МассивИзмененныхРабот);
		
	КонецЕсли;
		

КонецПроцедуры

&НаКлиенте
Процедура ОбъектСтроительстваПриИзменении(Элемент)
	ОбъектСтроительстваПриИзмененииНаСервере();
	СценарийПланированияПриИзмененииНаСервере();
	
	ОбновитьКнопкиСвернутьДоУровня();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимость()
	
	Элементы.НаДату.Доступность = ВариантДаты = 1;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПоследнююДатуРедактированияСценария(Сценарий)
	
	Если НЕ ЗначениеЗаполнено(Сценарий) Тогда
		Возврат НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;  	
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Сценарий",Сценарий);	
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(УСОERP_ПараметрыВыполненияРаботСрезПоследних.Период) КАК Период,
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа.Владелец
	|ИЗ
	|	РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(
	|			,
	|			Работа.Владелец = &Сценарий
	|				И НЕ Утверждена
	|				И ВидПланирования = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыПланированияСтроительныхРабот.Календарный)) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа.Владелец";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Период;
		
	КонецЕсли;	
	
	Возврат НачалоДня(ТекущаяДатаСеанса());	
	
КонецФункции



&НаКлиенте
Процедура СценарийПланированияПриИзменении(Элемент)
	
	СценарийПланированияПриИзмененииНаСервере();
	
		
	ОбновитьКнопкиСвернутьДоУровня();
	
КонецПроцедуры

#Область ПроцедурыДерева
////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ДЕРЕВО Работ
&НаСервере
Процедура ОбъектСтроительстваПриИзмененииНаСервере()
	
	Если НЕ ОбъектСтроительства = СценарийПланирования.Владелец Или ЗначениеЗаполнено(СценарийПланирования) Тогда 
		СценарийПланирования	= УСОERP_УправлениеСтроительнымПроизводством.ПолучитьРабочийСценарий(ОбъектСтроительства, Организация);
	КонецЕсли;	
	РеквизитыОбъектаСтроительства.Ссылка                = ОбъектСтроительства;
	РеквизитыОбъектаСтроительства.ПлановаяДатаНачала    = ОбъектСтроительства.НачалоСтроительства;
	РеквизитыОбъектаСтроительства.ПлановаяДатаОкончания = ОбъектСтроительства.ОкончаниеСтроительства;
	РеквизитыОбъектаСтроительства.ГрафикРаботы          = ОбъектСтроительства.ГрафикРаботы;
	
	ТекущийСценарийПланирования = СценарийПланирования;
	
КонецПроцедуры

&НаСервере
Процедура СценарийПланированияПриИзмененииНаСервере()
	
	НаДату = ПолучитьПоследнююДатуРедактированияСценария(СценарийПланирования);
	
	ЭтаФорма.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Сценарий планирования ""%2"" объекта строительства ""%1""'"),
		Строка(ОбъектСтроительства), Строка(СценарийПланирования));

	РеквизитыСценарияПланирования.Ссылка                = СценарийПланирования;
	РеквизитыСценарияПланирования.ПлановаяДатаНачала    = СценарийПланирования.НачалоСтроительства;
	РеквизитыСценарияПланирования.ПлановаяДатаОкончания = СценарийПланирования.ОкончаниеСтроительства;
	РеквизитыСценарияПланирования.ВидСценария          	= СценарийПланирования.ВидСценария;
	
	ЗаполнитьДеревоРабот();
	
	Т = ГрафикиРаботы.РасписанияРаботыНаПериод(РеквизитыОбъектаСтроительства.ГрафикРаботы, РеквизитыСценарияПланирования.ПлановаяДатаНачала, РеквизитыСценарияПланирования.ПлановаяДатаОкончания);	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоРабот()
	
	Если НЕ Организация.Пустая()
		И НЕ ОбъектСтроительства.Пустая() 
		И НЕ СценарийПланирования.Пустая() Тогда
		
		УСОERP_ЗащищенныеФункцииСервер.УСОERP_СтроительныеРаботы_ЗаполнитьДеревоРабот(ЭтотОбъект);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуДереваИзРаботы(ЭлементДерева, Работа, ТекущиеПредшественники) Экспорт
	
	Если ТипЗнч(ЭлементДерева) = Тип("Число") Тогда 
		ЭлементДерева = ДеревоРабот.НайтиПоИдентификатору(ЭлементДерева);
	КонецЕсли;	
	
	СписокРеквизитов1 = 
	"Наименование, 
	|Родитель,
	|КодСДР, 
	|ВерсияДанных,	
	|Владелец, 
	|СуммарнаяРабота,	
	|Ссылка,
	|ГрафикРаботы,		
	|ПометкаУдаления";
	
	СписокРеквизитов2 = 
	"ОбъемРаботы,
	|ЕдиницаОбъема,	
	|ПиктограммаИнформацииОбЗанесенииВМесячныеПланыИНедельноСуточныеПланы,	
	|НачалоРаботыПлан, 
	|ОкончаниеРаботыПлан, 
	|ЕдиницаДлительности,	
	|ДлительностьПлан,
	|КритическаяРабота"; 
	
	
	Если ТипЗнч(Работа) = Тип("СправочникСсылка.УСОERP_СтроительныеРаботы") Тогда 
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Работа, СписокРеквизитов1);	
		
		ДанныеРаботы = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПараметрыВыполненияРаботы(Работа, ВидПланирования, КонецДня(НаДату));
		СтруктураРеквизитов2 = Новый Структура(СписокРеквизитов2);
		Для Каждого Строка Из СтруктураРеквизитов2 Цикл
			Если Строка.Ключ = "ПиктограммаИнформацииОбЗанесенииВМесячныеПланыИНедельноСуточныеПланы" Тогда 
				Продолжить;
			КонецЕсли;	
			Реквизиты.Вставить(Строка.Ключ, ДанныеРаботы[Строка.Ключ]);
		КонецЦикла;	
		ДанныеРаботыМ = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПараметрыВыполненияРаботы(Работа, Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Месячный, КонецДня(НаДату));
		ДанныеРаботыН = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПараметрыВыполненияРаботы(Работа, Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.НедельноСуточный, КонецДня(НаДату));
		ПиктограммаИнформацииОбЗанесенииВМесячныеПланыИНедельноСуточныеПланы = "";
		Если ЗначениеЗаполнено(ДанныеРаботыМ.ВидПланирования) Тогда 
			ПиктограммаИнформацииОбЗанесенииВМесячныеПланыИНедельноСуточныеПланы = "" + "М";	
		КонецЕсли;	
		Если ЗначениеЗаполнено(ДанныеРаботыН.ВидПланирования) Тогда 
			ПиктограммаИнформацииОбЗанесенииВМесячныеПланыИНедельноСуточныеПланы = ПиктограммаИнформацииОбЗанесенииВМесячныеПланыИНедельноСуточныеПланы + "Н";	
		КонецЕсли;	
		Реквизиты.Вставить("ПиктограммаИнформацииОбЗанесенииВМесячныеПланыИНедельноСуточныеПланы", ПиктограммаИнформацииОбЗанесенииВМесячныеПланыИНедельноСуточныеПланы);
	Иначе
		Реквизиты = Работа;
	КонецЕсли;	
	
	СписокРеквизитов	= СписокРеквизитов1 + "," + СписокРеквизитов2;
	СписокРеквизитов 	= СтрЗаменить(СписокРеквизитов, "Родитель,", "");
	
	ЗаполнитьЗначенияСвойств(ЭлементДерева, Реквизиты, СписокРеквизитов);
	
	ЭлементДерева.ИндексКартинки 		= ?(ЭлементДерева.ПометкаУдаления, 3, 2);
	ЭлементДерева.РодительскаяРабота 	= Реквизиты.Родитель;
	ЭлементДерева.Наименование		 	= Реквизиты.Наименование; 
	
	//длительность
	ПодписьДлительность = ПолучитьПодписьДлительности(Реквизиты.ДлительностьПлан, Реквизиты.ЕдиницаДлительности);
	ЭлементДерева.ПодписьДлительность = Строка(Реквизиты.ДлительностьПлан) + " " + ПодписьДлительность;
		
	// предшественники
	ЭлементДерева.Предшественники.Очистить();
	Для Каждого СтрокаТаблЧасти Из ТекущиеПредшественники Цикл
		СтрокаТаблицыЗначений	= ЭлементДерева.Предшественники.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыЗначений, СтрокаТаблЧасти);
	КонецЦикла;	
	ЭлементДерева.ПодписьПредшественники = ПредставлениеПредшественников(ЭлементДерева.Предшественники, ОбъектСтроительства);

КонецПроцедуры	

&НаСервере
Процедура ОбновитьИзмененныеСтрокиРабот(МассивИзмененныхРабот)

	ОбновленныеРаботы = Новый Массив;
	
	Для Каждого ИзмененнаяРабота Из МассивИзмененныхРабот Цикл
		
		Если ОбновленныеРаботы.Найти(ИзмененнаяРабота) <> Неопределено Тогда 
			Продолжить;
		КонецЕсли;	
		ОбновленныеРаботы.Добавить(ИзмененнаяРабота);
		
		Предшественники	= УСОERP_УправлениеСтроительнымПроизводством.ПолучитьСвязиМеждуРаботами(ИзмененнаяРабота, КонецДня(НаДату)); 
		
		Индекс = -1;
		УСОERP_УправлениеСтроительнымПроизводством.НайтиРаботуВДеревеПоСсылке(ДеревоРабот.ПолучитьЭлементы(), ИзмененнаяРабота, Индекс);
		Если Индекс > -1 Тогда 
			СтрокаДерева = ДеревоРабот.НайтиПоИдентификатору(Индекс);
			ЗаполнитьСтрокуДереваИзРаботы(СтрокаДерева, ИзмененнаяРабота, Предшественники);
		КонецЕсли;	
		
	КонецЦикла;	
	
	//ЗаполнитьДиаграммуГанта();
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПредставлениеПредшественников(Предшественники, ОбъектСтроительства)
	
	ПодписьПредшественники = "";
	Для Каждого СтрокаТаблЧасти Из Предшественники Цикл
		
		Если СтрокаТаблЧасти.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.ОкончаниеНачало Тогда
			ТипЗависимости = "";
		ИначеЕсли СтрокаТаблЧасти.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.ОкончаниеОкончание Тогда
			ТипЗависимости = НСтр("ru = 'ОО'");
		ИначеЕсли СтрокаТаблЧасти.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.НачалоОкончание Тогда
			ТипЗависимости = НСтр("ru = 'НО'");
		ИначеЕсли СтрокаТаблЧасти.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.НачалоНачало Тогда
			ТипЗависимости = НСтр("ru = 'НН'");
		КонецЕсли;
		
		Задержка = "";
		Если СтрокаТаблЧасти.Задержка > 0 Тогда
			Задержка = " + " + СтрокаТаблЧасти.Задержка + " " + ПолучитьПодписьДлительности(СтрокаТаблЧасти.Задержка, СтрокаТаблЧасти.ЕдиницаЗадержки);
		КонецЕсли;
		
		ПредшественникКодСДР	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТаблЧасти.РаботаПредшественник, "КодСДР");
		ПодписьПредшественники 	= ПодписьПредшественники
			+ ?(СтрокаТаблЧасти.ОбъектСтроительстваПредшественника = ОбъектСтроительства, "", "Е") + ПредшественникКодСДР 
			+ ТипЗависимости + Задержка +", ";
		
	КонецЦикла;	
	
	Если ПодписьПредшественники <> "" Тогда 
		ПодписьПредшественники = Лев(ПодписьПредшественники, СтрДлина(ПодписьПредшественники)-2);
	КонецЕсли;
	
	Возврат ПодписьПредшественники;
	
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПодписьДлительности(Длительность, ЕдиницаДлительности)
	
	ПодписьДлительность = "";
	
	ЦелаяЧастьДлительность = Цел(Длительность);
	Если ЕдиницаДлительности = ПредопределенноеЗначение("Перечисление.УСОERP_ЕдиницыДлительности.Час") Тогда
		ПодписьДлительность = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПодписьЧасов(ЦелаяЧастьДлительность);		
	ИначеЕсли ЕдиницаДлительности = ПредопределенноеЗначение("Перечисление.УСОERP_ЕдиницыДлительности.День") Тогда
		ПодписьДлительность = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПодписьДней(ЦелаяЧастьДлительность);		
	Иначе
		ПодписьДлительность = НРег(Строка(ЕдиницаДлительности));
	КонецЕсли;
	
	Возврат ПодписьДлительность;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьДанныеДоступностиКомандПеремещения(ДеревоРабот, ЭлементыФормы)
	
	ДеревоРаботВверх 			= Истина;
	ДеревоРаботВниз 			= Истина;
	ДеревоРаботНаУровеньВыше 	= Истина;
	ДеревоРаботНаУровеньНиже 	= Истина;
	
	ВыделенныеСтроки = ЭлементыФормы.ДеревоРабот.ВыделенныеСтроки;
	ВыделенныеСтрокиКоличество = ВыделенныеСтроки.Количество();
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		СтрокаТекущая 	= ДеревоРабот.НайтиПоИдентификатору(ВыделеннаяСтрока);
		СтрокаРодитель 	= СтрокаТекущая.ПолучитьРодителя();
		
		ДеревоРаботНаУровеньВыше = ДеревоРаботНаУровеньВыше 
			И (СтрокаРодитель <> Неопределено)
			И ВыделенныеСтрокиКоличество = 1
			И Не СтрокаТекущая.ПометкаУдаления;
			
		Если СтрокаРодитель = Неопределено Тогда
			СтрокаРодитель = ДеревоРабот;
		КонецЕсли;
		
		ДеревоРаботНаУровеньНиже = ДеревоРаботНаУровеньНиже 
			И СтрокаРодитель.ПолучитьЭлементы().Индекс(СтрокаТекущая) > 0
			И ВыделенныеСтрокиКоличество = 1
			И Не СтрокаТекущая.ПометкаУдаления;
		
		ДеревоРаботВверх = ДеревоРаботВверх
			И СтрокаРодитель.ПолучитьЭлементы().Индекс(СтрокаТекущая) > 0
			И Не СтрокаТекущая.ПометкаУдаления;
			
		ДеревоРаботВниз = ДеревоРаботВниз
			И СтрокаРодитель.ПолучитьЭлементы().Индекс(СтрокаТекущая) < 
				СтрокаРодитель.ПолучитьЭлементы().Количество() - 1
			И Не СтрокаТекущая.ПометкаУдаления;
			
	КонецЦикла;
	
	ДанныеВозврата = Новый Структура;
	ДанныеВозврата.Вставить("ДеревоРаботВверх", 		ДеревоРаботВверх);
	ДанныеВозврата.Вставить("ДеревоРаботВниз", 			ДеревоРаботВниз);
	ДанныеВозврата.Вставить("ДеревоРаботНаУровеньВыше", ДеревоРаботНаУровеньВыше);
	ДанныеВозврата.Вставить("ДеревоРаботНаУровеньНиже", ДеревоРаботНаУровеньНиже);
		
	Возврат ДанныеВозврата;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКомандПеремещения(ТекущаяПроектнаяРабота, ДеревоРабот, Элементы)
	
	ДанныеДоступности = ПолучитьДанныеДоступностиКомандПеремещения(ДеревоРабот, Элементы);
	
	Элементы.ДеревоРаботВверх.Доступность 	= ДанныеДоступности.ДеревоРаботВверх;
	Элементы.ДеревоРаботВниз.Доступность 	= ДанныеДоступности.ДеревоРаботВниз;
	
	Элементы.ФормаНаУровеньВыше.Доступность = ДанныеДоступности.ДеревоРаботНаУровеньВыше;
	Элементы.ФормаНаУровеньНиже.Доступность = ДанныеДоступности.ДеревоРаботНаУровеньНиже;
	
КонецПроцедуры

&НаСервере
Процедура НаУровеньНижеСервер(Ссылка, Родитель)
	
	// Вычисляем наличие соседней Работы, в которую помещается текущая Работа
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтроительныеРаботы.Ссылка
		|ИЗ
		|	Справочник.УСОERP_СтроительныеРаботы КАК СтроительныеРаботы
		|ГДЕ
		|	СтроительныеРаботы.Родитель = &Родитель
		|	И СтроительныеРаботы.Владелец = &СценарийПланирования
		|	И НЕ СтроительныеРаботы.ПометкаУдаления
		|	И СтроительныеРаботы.НомерРаботыВУровне = &НомерВУровне - 1";
		
	Запрос.УстановитьПараметр("Родитель", 				Родитель);
	Запрос.УстановитьПараметр("НомерВУровне", 			Ссылка.НомерРаботыВУровне);
	Запрос.УстановитьПараметр("СценарийПланирования", 	Ссылка.Владелец);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		
		ОбъектРабота 	= Ссылка.ПолучитьОбъект();
		РодительРаботы 	= ОбъектРабота.Родитель;
		ЭтоБылПоследний = ОбъектРабота.НомерРаботыВУровне =  УСОERP_УправлениеСтроительнымПроизводством.ПолучитьМаксимальныйНомерРаботыУровня(
			Ссылка.Владелец,РодительРаботы);
			
		ОбъектРабота.Родитель 			= Выборка.Ссылка;
		ОбъектРабота.НомерРаботыВУровне = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьМаксимальныйНомерРаботыУровня(
			Ссылка.Владелец,
			ОбъектРабота.Родитель) + 1;
			
			ОбъектРабота.КодСДР = ОбъектРабота.Родитель.КодСДР+"."+ОбъектРабота.НомерРаботыВУровне;
			
			ОбъектРабота.Записать();
		
		//УСОERP_УправлениеСтроительнымПроизводством.ЗаполнитьКодыСДРРабот(Ссылка.Владелец);
		
		Если НЕ ЭтоБылПоследний Тогда
			Если ЗначениеЗаполнено(РодительРаботы) ТОгда
				УСОERP_УправлениеСтроительнымПроизводством.ЗаполнитьКодыСДРПодчиненныхРабот(РодительРаботы);
			Иначе
				УСОERP_УправлениеСтроительнымПроизводством.ЗаполнитьКодыСДРРабот(Ссылка.Владелец); 				
			КонецЕсли;
		КонецЕсли;
		УСОERP_УправлениеСтроительнымПроизводством.ЗаполнитьКодыСДРПодчиненныхРабот(ОбъектРабота.Родитель);	
		
		ПроверитьОчиститьПредшественниковПоследоватей(ОбъектРабота.Ссылка);
		
		УСОERP_УправлениеСтроительнымПроизводством.РассчитатьСценарияПланированияПроектовСтроительстваПоРаботе(ОбъектРабота.Ссылка,ВидПланирования,НаДату,Истина,Новый Массив);
				
		ЗаполнитьДеревоРабот();
		СписокРаскрытыхРабот.Добавить(ТекущаяРабота.Родитель);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьОчиститьПредшественниковПоследоватей(Работа)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Работа",Работа);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	УСОERP_СтроительныеРаботы.Ссылка = &Работа
	|ИТОГИ ПО
	|	Ссылка ИЕРАРХИЯ";
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	ТЗ.Свернуть("Ссылка");
	МассивРодителей = ТЗ.ВыгрузитьКолонку("Ссылка");
	Запрос.УстановитьПараметр("МассивРодителей",МассивРодителей);
	Запрос.УстановитьПараметр("Дата",НаДату);
	РаботаВМассиве = Новый Массив;
	РаботаВМассиве.Добавить(Работа);
	Запрос.УстановитьПараметр("РаботаВМассиве",РаботаВМассиве);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_СвязиМеждуРаботамиСрезПоследних.РаботаПоследователь,
	|	УСОERP_СвязиМеждуРаботамиСрезПоследних.РаботаПредшественник,
	|	УСОERP_СвязиМеждуРаботамиСрезПоследних.ТипЗависимости
	|ИЗ
	|	РегистрСведений.УСОERP_СвязиМеждуРаботами.СрезПоследних(
	|			&Дата,
	|			РаботаПоследователь В(&РаботаВМассиве)
	|				И РаботаПредшественник В (&МассивРодителей)) КАК УСОERP_СвязиМеждуРаботамиСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МЗ = РегистрыСведений.УСОERP_СвязиМеждуРаботами.СоздатьМенеджерЗаписи();
		МЗ.ОбъектСтроительстваПредшественника = СценарийПланирования.Владелец;
		МЗ.РаботаПоследователь = Работа;
		МЗ.РаботаПредшественник = Выборка.РаботаПредшественник;
		МЗ.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.ПустаяСсылка();
		МЗ.АвторИзмерения = ТекущийПользователь;
		МЗ.Период = НаДату;
		МЗ.Записать(Истина); 		
		
	КонецЦикла;
	
	Запрос.УстановитьПараметр("МассивРодителей",РаботаВМассиве);
	Запрос.УстановитьПараметр("Работа",МассивРодителей);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МЗ = РегистрыСведений.УСОERP_СвязиМеждуРаботами.СоздатьМенеджерЗаписи();
		МЗ.ОбъектСтроительстваПредшественника = СценарийПланирования.Владелец;
		МЗ.РаботаПоследователь = Работа;
		МЗ.РаботаПредшественник = Выборка.РаботаПредшественник;
		МЗ.АвторИзмерения = ТекущийПользователь;
		МЗ.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.ПустаяСсылка();
		МЗ.Период = НаДату;
		МЗ.Записать(Истина); 		
		
	КонецЦикла;	
	
КонецПроцедуры


&НаСервере
Процедура НаУровеньВышеСервер(Ссылка, Родитель)
	
	// Выбор всех Работы одного с родителем уровня и сдвигаем номера на один вниз
	МассивРаботУровняРодителя = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьМассивРаботОдногоУровняСУказанной(Ссылка.Владелец, Родитель);
		
	// Подготовка номера для вставки подчиненной Работы на один уровень вверх
	КоличествоЭлементов = МассивРаботУровняРодителя.Количество(); 
	Для Счетчик = 0 по КоличествоЭлементов - 1 Цикл
		Индекс = КоличествоЭлементов - Счетчик - 1;
		Работа = МассивРаботУровняРодителя[Индекс];
		Если Работа.НомерРаботыВУровне > Родитель.НомерРаботыВУровне Тогда
			РаботаОбъект = Работа.ПолучитьОбъект();
			РаботаОбъект.НомерРаботыВУровне = РаботаОбъект.НомерРаботыВУровне + 1;
		Конецесли;
	КонецЦикла;
		
	РаботаОбъект = Ссылка.ПолучитьОбъект();
	РодительРаботы = РаботаОбъект.Родитель;
	РаботаОбъект.Родитель = Родитель.Родитель;
	РаботаОбъект.НомерРаботыВУровне = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьМаксимальныйНомерРаботыУровня(Ссылка.Владелец,РаботаОбъект.Родитель)+1;
	//РаботаОбъект.НомерРаботыВУровне = Родитель.НомерРаботыВУровне + 1;
	РаботаОбъект.КодСДР = ?(ЗначениеЗаполнено(РаботаОбъект.Родитель),РаботаОбъект.Родитель.КодСДР+"."+РаботаОбъект.НомерРаботыВУровне,""+РаботаОбъект.НомерРаботыВУровне);
	
	РаботаОбъект.Записать();
		
	//УСОERP_УправлениеСтроительнымПроизводством.ЗаполнитьКодыСДРРабот(Ссылка.Владелец);
	УСОERP_УправлениеСтроительнымПроизводством.ЗаполнитьКодыСДРПодчиненныхРабот(РодительРаботы);
	Если ЗначениеЗаполнено(РаботаОбъект.Родитель) Тогда
		УСОERP_УправлениеСтроительнымПроизводством.ЗаполнитьКодыСДРПодчиненныхРабот(РаботаОбъект.Родитель);
	Иначе  		
		УСОERP_УправлениеСтроительнымПроизводством.ЗаполнитьКодыСДРПодчиненныхРабот(РаботаОбъект.Ссылка); 
	КонецЕсли; 	
		
	ЗаполнитьДеревоРабот();
	СписокРаскрытыхРабот.Добавить(ТекущаяРабота.Родитель);
	
КонецПроцедуры

&НаСервере
Процедура ВверхСервер()
	
	МассивСсылок = Новый Массив;
	Для Каждого ВыделеннаяСтрока Из Элементы.ДеревоРабот.ВыделенныеСтроки Цикл
		Ссылка = ДеревоРабот.НайтиПоИдентификатору(ВыделеннаяСтрока).Ссылка;
		Индекс = Неопределено;
		Для Каждого Элемент Из МассивСсылок Цикл
			Если Элемент.НомерРаботыВУровне > Ссылка.НомерРаботыВУровне Тогда
				Индекс = МассивСсылок.Найти(Элемент);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Индекс = Неопределено Тогда
			МассивСсылок.Добавить(Ссылка);
		Иначе
			МассивСсылок.Вставить(Индекс, Ссылка); 
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого Ссылка Из МассивСсылок Цикл
		// Получение Работы с номером в уровне, меньшим на 1, чем текущий
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	СтроительныеРаботы.Ссылка
			|ИЗ
			|	Справочник.УСОERP_СтроительныеРаботы КАК СтроительныеРаботы
			|ГДЕ
			|	СтроительныеРаботы.Владелец = &Владелец
			|	И СтроительныеРаботы.Родитель = &Родитель
			|	И Не ПометкаУдаления
			|	И СтроительныеРаботы.НомерРаботыВУровне = &НомерРаботыВУровне";
		Запрос.УстановитьПараметр("Владелец", 			Ссылка.Владелец);
		Запрос.УстановитьПараметр("Родитель", 			Ссылка.Родитель);
		Запрос.УстановитьПараметр("НомерРаботыВУровне", Ссылка.НомерРаботыВУровне - 1);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			// сдвиг строк в дереве
			Идентификатор = -1;
			УСОERP_УправлениеСтроительнымПроизводством.НайтиРаботуВДеревеПоСсылке(ДеревоРабот.ПолучитьЭлементы(), Ссылка, Идентификатор);
				
			СтрокаТекущейРаботы = ДеревоРабот.НайтиПоИдентификатору(Идентификатор);
			СтрокаРодительскойРаботы = СтрокаТекущейРаботы.ПолучитьРодителя();
			Если СтрокаРодительскойРаботы = Неопределено Тогда
				СтрокаРодительскойРаботы = ДеревоРабот;	
			КонецЕсли;
			
			ИндексТекущейРаботы = СтрокаРодительскойРаботы.ПолучитьЭлементы().Индекс(СтрокаТекущейРаботы);
			СтрокаРодительскойРаботы.ПолучитьЭлементы().Сдвинуть(ИндексТекущейРаботы, -1);
			
			// изменение реквизитов объектов
			ТекущаяРаботаОбъект    = Ссылка.ПолучитьОбъект();
			ПредыдущаяРаботаОбъект = Выборка.Ссылка.ПолучитьОбъект();		
			
			
			Буфер                                     = ТекущаяРаботаОбъект.НомерРаботыВУровне;
			ТекущаяРаботаОбъект.НомерРаботыВУровне    = ПредыдущаяРаботаОбъект.НомерРаботыВУровне;
			ПредыдущаяРаботаОбъект.НомерРаботыВУровне = Буфер;

			БуферСДР                      = ТекущаяРаботаОбъект.КодСДР;
			ТекущаяРаботаОбъект.КодСДР    = ПредыдущаяРаботаОбъект.КодСДР;
			ПредыдущаяРаботаОбъект.КодСДР = БуферСДР;
			
			ТекущаяРаботаОбъект.Записать();
			ПредыдущаяРаботаОбъект.Записать();		
			
			
			ИзмененныеРаботы = Новый Массив;
			ИзмененныеРаботы.Добавить(ТекущаяРаботаОбъект.Ссылка);
			ИзмененныеРаботы.Добавить(ПредыдущаяРаботаОбъект.Ссылка);
			
						
			ИзмененныеРаботы =  ПолучитьМассивПодчиненныхПоИерархии(ИзмененныеРаботы);
			
			
			// заполнение кодов СДР
			Если ЗначениеЗаполнено(ТекущаяРаботаОбъект.Ссылка.Родитель) И ЗначениеЗаполнено(ПредыдущаяРаботаОбъект.Ссылка.Родитель) Тогда
				УСОERP_УправлениеСтроительнымПроизводством.ЗаполнитьКодыСДРПодчиненныхРабот(ТекущаяРаботаОбъект.Ссылка, ИзмененныеРаботы);
				УСОERP_УправлениеСтроительнымПроизводством.ЗаполнитьКодыСДРПодчиненныхРабот(ПредыдущаяРаботаОбъект.Ссылка, ИзмененныеРаботы);
			Иначе
				УСОERP_УправлениеСтроительнымПроизводством.ЗаполнитьКодыСДРРабот(СценарийПланирования);
			КонецЕсли;
			
			УСОERP_УправлениеСтроительнымПроизводством.РассчитатьСценарияПланированияПроектовСтроительстваПоРаботе(ПредыдущаяРаботаОбъект.Ссылка,ВидПланирования,НаДату,Истина,Новый Массив);
			УСОERP_УправлениеСтроительнымПроизводством.РассчитатьСценарияПланированияПроектовСтроительстваПоРаботе(ТекущаяРаботаОбъект.Ссылка,ВидПланирования,НаДату,Истина,Новый Массив);
			// обновление последователей
			ЗаполнитьДанныеОПоследователяхСпискаРабот(ИзмененныеРаботы, ИзмененныеРаботы);
			ОбновитьИзмененныеСтрокиРабот(ИзмененныеРаботы);
			
			СписокРаскрытыхРабот.Добавить(ТекущаяРабота.Родитель);
 		КонецЕсли;
	КонецЦикла;
	УстановитьДоступностьКомандПеремещения(ТекущаяРабота, ДеревоРабот, Элементы);
	//ЗаполнитьДиаграммуГанта();
	 
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивПодчиненныхПоИерархии(МассивРодителей)
	
	ЗапросПоРаботам = Новый Запрос;
	ЗапросПоРаботам.УстановитьПараметр("Родитель",МассивРодителей);
	ЗапросПоРаботам.Текст = 
	
	"ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботы.Ссылка
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	УСОERP_СтроительныеРаботы.Ссылка В ИЕРАРХИИ(&Родитель)
	|	И НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления";
	МассивРаботПоРодителям = ЗапросПоРаботам.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Возврат МассивРаботПоРодителям;  
	
