КонецПроцедуры	

&НаКлиенте
Процедура ДеревоРаботПриАктивизацииСтроки(Элемент)
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница <> Элементы.СтраницаРаботыОбъектаСтроительства Тогда 
		Возврат;
	КонецЕсли;	
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		ТекущаяРабота = ПредопределенноеЗначение("Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка");
		Элементы.ДеревоРаботВверх.Доступность = Ложь;
		Элементы.ДеревоРаботВниз.Доступность= Ложь;
		Элементы.ФормаНаУровеньВыше.Доступность = Ложь;
		Элементы.ФормаНаУровеньНиже.Доступность = Ложь;
		Возврат;
	КонецЕсли;
	
	Если КоличествоВыделенныхРабот <> Элементы.ДеревоРабот.ВыделенныеСтроки.Количество() 
		ИЛИ ТекущаяРабота <> Элемент.ТекущиеДанные.Ссылка Тогда
		КоличествоВыделенныхРабот 	= Элементы.ДеревоРабот.ВыделенныеСтроки.Количество();
		ТекущаяРабота 				= Элемент.ТекущиеДанные.Ссылка;
		УстановитьДоступностьКомандПеремещения(ТекущаяРабота, ДеревоРабот, Элементы);
	КонецЕсли;	

	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	Элементы.ДеревоРаботНачалоРаботы.ТолькоПросмотр 	= ТекущиеДанные.СуммарнаяРабота;
	Элементы.ДеревоРаботОкончаниеРаботы.ТолькоПросмотр 	= ТекущиеДанные.СуммарнаяРабота;
	Элементы.ДеревоРаботДлительностьПлан.ТолькоПросмотр = ТекущиеДанные.СуммарнаяРабота;
	
	ФиксированнаяСтруктураРабота    = Новый ФиксированнаяСтруктура("Работа", ТекущаяРабота);
	Элементы.Материалы.ОтборСтрок 	= ФиксированнаяСтруктураРабота;
	Элементы.Ресурсы.ОтборСтрок 	= ФиксированнаяСтруктураРабота;

	Элементы.Материалы.ТолькоПросмотр = ТекущиеДанные.СуммарнаяРабота;
	Элементы.Ресурсы.ТолькоПросмотр = ТекущиеДанные.СуммарнаяРабота;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	ТекущаяСтрока = Элементы.ДеревоРабот.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда 
		НовыйЭлемент = ДеревоРабот.ПолучитьЭлементы().Добавить();
	Иначе
		ЭлементДерева		= ДеревоРабот.НайтиПоИдентификатору(ТекущаяСтрока);
		РодительЭлемента 	= ЭлементДерева.ПолучитьРодителя();
		
		Если РодительЭлемента = Неопределено Тогда 
			НовыйЭлемент = ДеревоРабот.ПолучитьЭлементы().Добавить();
		Иначе
			НовыйЭлемент = РодительЭлемента.ПолучитьЭлементы().Добавить();
		КонецЕсли;
		
		Если Копирование Тогда 
			НовыйЭлемент.Копирование = Истина;
			
			НовыйЭлемент.РодительскаяРабота = ЭлементДерева.РодительскаяРабота;
			
			НовыйЭлемент.Наименование 			= ЭлементДерева.Наименование;
			НовыйЭлемент.НачалоРаботыПлан 		= ЭлементДерева.НачалоРаботыПлан;
			НовыйЭлемент.ОкончаниеРаботыПлан 	= ЭлементДерева.ОкончаниеРаботыПлан;
			
			НовыйЭлемент.ДлительностьПлан 		= ЭлементДерева.ДлительностьПлан;
			НовыйЭлемент.ЕдиницаДлительности 	= ЭлементДерева.ЕдиницаДлительности;
			
			
			Для Каждого СтрокаПредшественник Из ЭлементДерева.Предшественники Цикл
				НоваяСтрока = НовыйЭлемент.Предшественники.Добавить();
				НоваяСтрока.РаботаПредшественник 				= СтрокаПредшественник.РаботаПредшественник;
				НоваяСтрока.ОбъектСтроительстваПредшественника 	= СтрокаПредшественник.ОбъектСтроительстваПредшественника;
				НоваяСтрока.ТипЗависимости 						= СтрокаПредшественник.ТипЗависимости;
				НоваяСтрока.Задержка 							= СтрокаПредшественник.Задержка;
				НоваяСтрока.ЕдиницаЗадержки 					= СтрокаПредшественник.ЕдиницаЗадержки;
			КонецЦикла;
			
			НовыйЭлемент.ПодписьПредшественники = ЭлементДерева.ПодписьПредшественники;				
		КонецЕсли;	
	КонецЕсли;	
	
	Элементы.ДеревоРабот.ТекущаяСтрока 	= НовыйЭлемент.ПолучитьИдентификатор();
	Элементы.ДеревоРабот.ТекущийЭлемент = Элементы.ДеревоРаботРабота;	
	Элементы.ДеревоРабот.ИзменитьСтроку();

КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботПередНачаломИзменения(Элемент, Отказ)
		
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
		
	ЗаблокироватьСтрокуДляРедактирования(ТекущиеДанные.Ссылка, ЭтаФорма.УникальныйИдентификатор);
	
	Если ТекущиеДанные.Предшественники.Количество() > 1 Тогда 
		Элементы.ДеревоРаботПодписьПредшественники.РедактированиеТекста = Ложь; 
	Иначе	
		Элементы.ДеревоРаботПодписьПредшественники.РедактированиеТекста = Истина; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;		
	мВыделенныеСтроки = Элемент.ВыделенныеСтроки;
	Если мВыделенныеСтроки = Неопределено Или мВыделенныеСтроки.Количество() <= 0 Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;		
	
	МассивСсылок = Новый Массив;
	Для КАждого СтрокаЭлт Из мВыделенныеСтроки Цикл
		Если ЗначениеЗаполнено(ДеревоРабот.НайтиПоИдентификатору(СтрокаЭлт).Ссылка) Тогда
			МассивСсылок.Добавить(СтрокаЭлт);
		КонецЕсли;
	КонецЦикла;
	Если МассивСсылок.Количество() = 0 Тогда
		Отказ = Ложь;
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = МассивСсылок;
	
	Если ПроверитьВозможностьУдалениеРабот(ВыделенныеСтроки, Отказ) Тогда 
		Возврат;
	КонецЕсли;	
	
	Режим = РежимДиалогаВопрос.ДаНет;
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);	
	Если ВыделенныеСтроки.Количество() = 1 Тогда 
		Если НЕ Элементы.ДеревоРабот.ТекущиеДанные.ПометкаУдаления Тогда
			ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Пометить ""%1"" на удаление?'"),
				Строка(Элементы.ДеревоРабот.ТекущиеДанные.Наименование));
			
			ПараметрыОповещения.Вставить("ПометкаУдаления", Истина);
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ДеревоРаботПередУдалениемПродолжение",
				ЭтотОбъект,
				ПараметрыОповещения);	
			
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Режим);
		КонецЕсли;
	ИначеЕсли ВыделенныеСтроки.Количество() > 1 Тогда
		ПометкаУдаления = Истина;
		Для Каждого СтрокаТаблицы Из ВыделенныеСтроки Цикл
			СтрокаТаблицыРабота = ДеревоРабот.НайтиПоИдентификатору(СтрокаТаблицы);
			Если СтрокаТаблицыРабота.ПометкаУдаления = Истина Тогда
				ПометкаУдаления = Ложь;
				Прервать;	
			КонецЕсли;
		КонецЦикла;
		
		Если ПометкаУдаления Тогда
			ПараметрыОповещения.Вставить("ПометкаУдаления", Истина);
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ДеревоРаботПередУдалениемПродолжение",
				ЭтотОбъект,
				ПараметрыОповещения);	
			
			ПоказатьВопрос(ОписаниеОповещения,
				НСтр("ru = 'Пометить выделенные элементы на удаление?'"), Режим);
		КонецЕсли;
	КонецЕсли;		

КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботПослеУдаления(Элемент)
	
	ПроверитьОбновитьКодыСДР();
	ОбновитьКнопкиСвернутьДоУровня();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботПередУдалениемПродолжение(Результат, Параметры) Экспорт  
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;	
	
	НомерТекСтроки = 0;
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.ЗагрузитьЗначения(Параметры.ВыделенныеСтроки);
	СписокЗначений.СортироватьПоЗначению();
	
	НомерТекСтроки = СписокЗначений.Получить(0).Значение;
		
	ТекРабота = Неопределено;
	Если ДеревоРабот.НайтиПоИдентификатору(НомерТекСтроки-1) <> Неопределено Тогда
		ТекРабота =  ДеревоРабот.НайтиПоИдентификатору(НомерТекСтроки-1).Ссылка;
	КонецЕсли; 	
	
	ВыделенныеСтроки 	= Параметры.ВыделенныеСтроки;
	ПометкаУдаления 	= Параметры.ПометкаУдаления;
	СписокРаскрытыхРабот.Очистить();
	УСОERP_УправлениеСтроительнымПроизводствомКлиент.ПолучитьМассивРаскрытыхРабот(Элементы.ДеревоРабот, ДеревоРабот.ПолучитьЭлементы(), СписокРаскрытыхРабот);	
	ПометитьНаУдалениеСтроительныеРаботы(ВыделенныеСтроки, ПометкаУдаления);	
	УСОERP_УправлениеСтроительнымПроизводствомКлиент.УстановитьРазвернутостьЭлементовДерева(Элементы.ДеревоРабот, ДеревоРабот, СписокРаскрытыхРабот);	
	
	Если ТекРабота <> Неопределено Тогда
		
		Попытка
			
			УСОERP_УправлениеСтроительнымПроизводствомКлиент.УстановитьТекущуюРаботуВДеревеПоСсылке(Элементы.ДеревоРабот,ДеревоРабот,ТекРабота);
			
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПометитьНаУдалениеСтроительныеРаботы(ВыделенныеСтроки, ПометкаУдаления)
	
	Для Каждого СтрокаТаблицы Из ВыделенныеСтроки Цикл
		СтрокаТаблицыРабота = ДеревоРабот.НайтиПоИдентификатору(СтрокаТаблицы);
		Если СтрокаТаблицыРабота = Неопределено Тогда 
			Продолжить;
		КонецЕсли;	
		
		РаботаСсылка = СтрокаТаблицыРабота.Ссылка;
		Если РаботаСсылка.Пустая() Тогда
			Продолжить;
		КонецЕсли;	
		
		РаботаОбъект = РаботаСсылка.ПолучитьОбъект();
		РаботаОбъект.УстановитьПометкуУдаления(ПометкаУдаления);
		
		//НаборЗаписей = РегистрыСведений.УСОERP_ПараметрыВыполненияРабот.СоздатьНаборЗаписей();
		//НаборЗаписей.Отбор.Работа.Установить(РаботаСсылка);
		//НаборЗаписей.Записать();
		//
		//НаборЗаписей = РегистрыСведений.УСОERP_СвязиМеждуРаботами.СоздатьНаборЗаписей();
		//НаборЗаписей.Отбор.РаботаПредшественник.Установить(РаботаСсылка);
		//НаборЗаписей.Записать();	
		//НаборЗаписей = РегистрыСведений.УСОERP_СвязиМеждуРаботами.СоздатьНаборЗаписей();
		//НаборЗаписей.Отбор.РаботаПоследователь.Установить(РаботаСсылка);
		//НаборЗаписей.Записать();
		//
		//НаборЗаписей = РегистрыСведений.УСОERP_ПотребностьВМатериалах.СоздатьНаборЗаписей();
		//НаборЗаписей.Отбор.Работа.Установить(РаботаСсылка);
		//НаборЗаписей.Записать();
		//
		//НаборЗаписей = РегистрыСведений.УСОERP_ПотребностьВРесурсах.СоздатьНаборЗаписей();
		//НаборЗаписей.Отбор.Работа.Установить(РаботаСсылка);
		//НаборЗаписей.Записать();
		
		//Добавлена очистка подчиненных элементов, при удалении родительской строки
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Работа",РаботаСсылка);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	УСОERP_СтроительныеРаботы.Ссылка КАК ПодРабота
		|ИЗ
		|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
		|ГДЕ
		|	УСОERP_СтроительныеРаботы.Ссылка В ИЕРАРХИИ(&Работа)";
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
		НаборЗаписей = РегистрыСведений.УСОERP_ПараметрыВыполненияРабот.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Работа.Установить(Выборка.ПодРабота);
		НаборЗаписей.Записать();
		
		НаборЗаписей = РегистрыСведений.УСОERP_СвязиМеждуРаботами.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.РаботаПредшественник.Установить(Выборка.ПодРабота);
		НаборЗаписей.Записать();	
		НаборЗаписей = РегистрыСведений.УСОERP_СвязиМеждуРаботами.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.РаботаПоследователь.Установить(Выборка.ПодРабота);
		НаборЗаписей.Записать();
		
		НаборЗаписей = РегистрыСведений.УСОERP_ПотребностьВМатериалах.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Работа.Установить(Выборка.ПодРабота);
		НаборЗаписей.Записать();
		
		НаборЗаписей = РегистрыСведений.УСОERP_ПотребностьВРесурсах.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Работа.Установить(Выборка.ПодРабота);
		НаборЗаписей.Записать(); 
			
		КонецЦикла;  	 
		
		
		Если ЗначениеЗаполнено(СтрокаТаблицыРабота.Ссылка.Родитель) Тогда
			
			УСОERP_УправлениеСтроительнымПроизводством.ЗаполнитьКодыСДРПодчиненныхРабот(СтрокаТаблицыРабота.Ссылка.Родитель);
			
		Иначе
			
			УСОERP_УправлениеСтроительнымПроизводством.ЗаполнитьКодыСДРРабот(СценарийПланирования);
			
		КонецЕсли;
	 
		
	КонецЦикла;
	
	ЗаполнитьДеревоРабот();
	
КонецФункции

&НаСервере
Функция ПроверитьВозможностьУдалениеРабот(ВыделенныеСтроки, Отказ = Ложь)
	
	СписокРабот = Новый СписокЗначений;
	Для Каждого СтрокаТаблицы из ВыделенныеСтроки Цикл 
		СтрокаТаблицыРабота = ДеревоРабот.НайтиПоИдентификатору(СтрокаТаблицы);
		Если СтрокаТаблицыРабота = Неопределено Тогда 
			Продолжить;
		КонецЕсли;			
		СписокРабот.Добавить(СтрокаТаблицыРабота.Ссылка);	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УСОERP_УчетВыполненныхРаботОбороты.Работа.Наименование КАК РаботаНаименование,
		|	УСОERP_УчетВыполненныхРаботОбороты.Работа.КодСДР КАК РаботаКодСДР,
		|	1 КАК Вид,
		|	УСОERP_УчетВыполненныхРаботОбороты.Работа.НомерРаботыВУровне КАК РаботаНомерРаботыВУровне
		|ИЗ
		|	РегистрНакопления.УСОERP_УчетВыполненныхРабот.Обороты(, , , Работа В ИЕРАРХИИ (&СписокРабот)) КАК УСОERP_УчетВыполненныхРаботОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	УСОERP_УчетВыполненныхРаботОбороты.Работа.КодСДР,
		|	УСОERP_УчетВыполненныхРаботОбороты.Работа.Наименование,
		|	УСОERP_УчетВыполненныхРаботОбороты.Работа.НомерРаботыВУровне
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УСОERP_ВыполнениеРаботЗаказчикаОстаткиИОбороты.Работа.Наименование,
		|	УСОERP_ВыполнениеРаботЗаказчикаОстаткиИОбороты.Работа.КодСДР,
		|	2,
		|	УСОERP_ВыполнениеРаботЗаказчикаОстаткиИОбороты.Работа.НомерРаботыВУровне
		|ИЗ
		|	РегистрНакопления.УСОERP_ВыполнениеРаботЗаказчика.Обороты(, , , Работа В ИЕРАРХИИ (&СписокРабот)) КАК УСОERP_ВыполнениеРаботЗаказчикаОстаткиИОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	УСОERP_ВыполнениеРаботЗаказчикаОстаткиИОбороты.Работа.Наименование,
		|	УСОERP_ВыполнениеРаботЗаказчикаОстаткиИОбороты.Работа.КодСДР,
		|	УСОERP_ВыполнениеРаботЗаказчикаОстаткиИОбороты.Работа.НомерРаботыВУровне
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Работа.Наименование,
		|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Работа.КодСДР,
		|	3,
		|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Работа.НомерРаботыВУровне
		|ИЗ
		|	РегистрНакопления.УСОERP_ВыполнениеРаботСубподрядчиком.Обороты(, , , Работа В ИЕРАРХИИ (&СписокРабот)) КАК УСОERP_ВыполнениеРаботСубподрядчикомОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Работа.Наименование,
		|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Работа.КодСДР,
		|	УСОERP_ВыполнениеРаботСубподрядчикомОбороты.Работа.НомерРаботыВУровне
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа.Наименование,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа.КодСДР,
		|	4,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа.НомерРаботыВУровне
		|ИЗ
		|	РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(
		|			,
		|			Работа В ИЕРАРХИИ (&СписокРабот)
		|				И ВидПланирования = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыПланированияСтроительныхРабот.Месячный)) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа.Наименование,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа.КодСДР,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа.НомерРаботыВУровне
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа.Наименование,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа.КодСДР,
		|	5,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа.НомерРаботыВУровне
		|ИЗ
		|	РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(
		|			,
		|			Работа В ИЕРАРХИИ (&СписокРабот)
		|				И ВидПланирования = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыПланированияСтроительныхРабот.НедельноСуточный)) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа.Наименование,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа.КодСДР,
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа.НомерРаботыВУровне
		|
		|УПОРЯДОЧИТЬ ПО
		|	РаботаНомерРаботыВУровне,
		|	РаботаКодСДР,
		|	Вид";
	
	Запрос.УстановитьПараметр("СписокРабот", СписокРабот);
	
	РезультатЗапроса 	= Запрос.Выполнить();	
	Выборка 			= РезультатЗапроса.Выбрать();
	
	ЕстьСсылкиНаРаботу 	= Ложь;
	Пока Выборка.Следующий() Цикл
		Если Выборка.Вид = 1 Тогда 
			Отказ = Истина;
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='По работе ""%1"" есть  факт выполнения работ'"), Выборка.РаботаНаименование + "(" + Выборка.РаботаКодСДР + ")");
			ИначеЕсли Выборка.Вид = 2 Тогда 
				Отказ = Истина;
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Работа ""%1"" включена в договор с Заказчиком""'"), Выборка.РаботаНаименование + "(" + Выборка.РаботаКодСДР + ")");
			ИначеЕсли Выборка.Вид = 3 Тогда 
				Отказ = Истина;
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Работа ""%1"" включена в договор с Субподрядчиком""'"), Выборка.РаботаНаименование + "(" + Выборка.РаботаКодСДР + ")");
			ИначеЕсли Выборка.Вид = 4 Тогда 
				Отказ = Истина;
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='По работе ""%1"" есть  записи в регистре ""Параметры выполнения работ"" с Видом планирования = ""Месячный""'"), Выборка.РаботаНаименование + "(" + Выборка.РаботаКодСДР + ")");
			ИначеЕсли Выборка.Вид = 5 Тогда 
				Отказ = Истина;
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='По работе ""%1"" есть  записи в регистре ""Параметры выполнения работ"" с Видом планирования = ""Недельно-суточный""'"), Выборка.РаботаНаименование + "(" + Выборка.РаботаКодСДР + ")");
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ЕстьСсылкиНаРаботу 	= Истина;
		Отказ = Истина;
	КонецЦикла;
	
	Возврат ЕстьСсылкиНаРаботу;
	
КонецФункции

&НаКлиенте
Процедура ДеревоРаботПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	    СтруктураСтроки = Новый Структура;
		СтруктураСтроки.Вставить("ОбъемРаботы",ТекущиеДанные.ОбъемРаботы);
		СтруктураСтроки.Вставить("ДлительностьПлан",ТекущиеДанные.ДлительностьПлан);
		СтруктураСтроки.Вставить("ЕдиницаДлительности",ТекущиеДанные.ЕдиницаДлительности);
		СтруктураСтроки.Вставить("ЕдиницаОбъема",ТекущиеДанные.ЕдиницаОбъема);
		СтруктураСтроки.Вставить("КритическаяРабота",ТекущиеДанные.КритическаяРабота);
		СтруктураСтроки.Вставить("Наименование",ТекущиеДанные.Наименование);
		СтруктураСтроки.Вставить("НачалоРаботыПлан",ТекущиеДанные.НачалоРаботыПлан);
		СтруктураСтроки.Вставить("ОкончаниеРаботыПлан",ТекущиеДанные.ОкончаниеРаботыПлан);
		СтруктураСтроки.Вставить("Предшественники",ТекущиеДанные.Предшественники);
		СтруктураСтроки.Вставить("Ссылка",ТекущиеДанные.Ссылка);
		//СтруктураСтроки.Вставить("ДлительностьПлан",ТекущиеДанные.ДлительностьПлан);
		
	
	ТекущаяСтрокаДерева = СтруктураСтроки;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Владелец) Тогда // изменяется новая строка
		ИндексСтроки = Элементы.ДеревоРабот.ТекущаяСтрока;
		
		ТекущиеДанные.Владелец = СценарийПланирования;
				
		Если Не ТекущиеДанные.Копирование Тогда 
		
		РодительЭлемента = ТекущиеДанные.ПолучитьРодителя();
		Если НЕ РодительЭлемента = Неопределено Тогда 
			ТекущиеДанные.РодительскаяРабота = РодительЭлемента.Ссылка;
		КонецЕсли;	
		
		ТекущиеДанные.ЕдиницаДлительности = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.День");
		
		КонецЕсли;
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	Если ОтменаРедактирования Тогда 
		
		ТекущаяСтрока = Элементы.ДеревоРабот.ТекущаяСтрока;
		ЭлементДерева = ДеревоРабот.НайтиПоИдентификатору(ТекущаяСтрока);
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда 
			
			Отказ = Истина;			
			РодительЭлемента = ЭлементДерева.ПолучитьРодителя();
			Если РодительЭлемента = Неопределено Тогда 
				ИндексЭлемента = ДеревоРабот.ПолучитьЭлементы().Индекс(ЭлементДерева);
				ДеревоРабот.ПолучитьЭлементы().Удалить(ИндексЭлемента);
			Иначе
