&НаКлиенте
Процедура ДеревоРаботОбъемПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	СтруктураДействий	= Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "НаОбъемРаботы");

	МатериалыТекущейРаботы = Материалы.НайтиСтроки(Новый Структура("Работа",ТекущиеДанные.Ссылка));
	
	Для Каждого СтрокаТаблицы Из МатериалыТекущейРаботы Цикл 
		СтрокаТаблицы.КоличествоУпаковокНаОбъемРаботы	= Окр(СтрокаТаблицы.КоличествоУпаковокНаЕдиницуОбъема * ТекущиеДанные.ОбъемРаботы, 3);
		ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтрокаТаблицы, СтруктураДействий, КэшированныеЗначения);		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТрудоемкостьМашиноемкостьРесурсовНаКлиенте(ТекущиеДанные)

	РесурсыТекущейРаботы = Ресурсы.НайтиСтроки(Новый Структура("Работа",ТекущиеДанные.Ссылка));
	
	Для Каждого СтрокаТаблицы Из РесурсыТекущейРаботы Цикл 
		ПересчитатьТрудоемкостьМашиноемкостьНаКлиенте(СтрокаТаблицы, ТекущиеДанные);		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботДлительностьПланПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда 
		
		СтроительнаяРаботаСтруктура = Новый Структура;
		СтроительнаяРаботаСтруктура.Вставить("Владелец", 		ТекущиеДанные.Владелец);
		СтроительнаяРаботаСтруктура.Вставить("ГрафикРаботы", 	ТекущиеДанные.ГрафикРаботы);
		СтроительнаяРаботаСтруктура.Вставить("Ссылка", 			ТекущиеДанные.Ссылка);
		
		Если ЗначениеЗаполнено(ТекущиеДанные.НачалоРаботыПлан) Тогда 
			ТекущиеДанные.ОкончаниеРаботыПлан	= УСОERP_УправлениеСтроительнымПроизводством.РассчитатьОкончаниеПериода(СтроительнаяРаботаСтруктура, 
				ТекущиеДанные.НачалоРаботыПлан, 
				ТекущиеДанные.ДлительностьПлан, 
				ТекущиеДанные.ЕдиницаДлительности);
		ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ОкончаниеРаботыПлан) Тогда 		
			ТекущиеДанные.НачалоРаботыПлан    = УСОERP_УправлениеСтроительнымПроизводством.РассчитатьНачалоПериода(СтроительнаяРаботаСтруктура, 
				ТекущиеДанные.ОкончаниеРаботыПлан, 
				ТекущиеДанные.ДлительностьПлан, 
				ТекущиеДанные.ЕдиницаДлительности);
		КонецЕсли;
	КонецЕсли;	

	ПересчитатьТрудоемкостьМашиноемкостьРесурсовНаКлиенте(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботЕдиницаДлительностиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда 
		
		СтроительнаяРаботаСтруктура = Новый Структура;
		СтроительнаяРаботаСтруктура.Вставить("Владелец", 		ТекущиеДанные.Владелец);
		СтроительнаяРаботаСтруктура.Вставить("ГрафикРаботы", 	ТекущиеДанные.ГрафикРаботы);
		СтроительнаяРаботаСтруктура.Вставить("Ссылка", 			ТекущиеДанные.Ссылка);

		Если ЗначениеЗаполнено(ТекущиеДанные.НачалоРаботыПлан) И ТекущиеДанные.НачалоРаботыПлан = НачалоДня(ТекущиеДанные.НачалоРаботыПлан) Тогда
			
			ТекущиеДанные.НачалоРаботыПлан	= УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПервоеРабочееВремяДня(ТекущиеДанные.ГрафикРаботы, ТекущиеДанные.НачалоРаботыПлан);
			
		КонецЕсли;
		
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.НачалоРаботыПлан) Тогда 	
			
			ТекущиеДанные.ДлительностьПлан	= 0;
			
		ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ОкончаниеРаботыПлан) Тогда 
			
			ТекущиеДанные.ДлительностьПлан	= УСОERP_УправлениеСтроительнымПроизводством.РассчитатьДлительностьПериода(СтроительнаяРаботаСтруктура, 
				ТекущиеДанные.НачалоРаботыПлан, 
				ТекущиеДанные.ОкончаниеРаботыПлан, 
				ТекущиеДанные.ЕдиницаДлительности);
			
		ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ДлительностьПлан) Тогда 	
			
			ТекущиеДанные.ОкончаниеРаботыПлан	= УСОERP_УправлениеСтроительнымПроизводством.РассчитатьОкончаниеПериода(СтроительнаяРаботаСтруктура, 
				ТекущиеДанные.НачалоРаботыПлан, 
				ТекущиеДанные.ДлительностьПлан, 
				ТекущиеДанные.ЕдиницаДлительности);
			
			КонецЕсли;
			
		ПересчитатьТрудоемкостьМашиноемкостьРесурсовНаКлиенте(ТекущиеДанные);
			
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботНачалоРаботыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда 	
		Если ЗначениеЗаполнено(ТекущиеДанные.НачалоРаботыПлан) 
			И ТекущиеДанные.НачалоРаботыПлан = НачалоДня(ТекущиеДанные.НачалоРаботыПлан) Тогда
			
			ГрафикРаботы = ?(ЗначениеЗаполнено(ТекущиеДанные.ГрафикРаботы), ТекущиеДанные.ГрафикРаботы, РеквизитыОбъектаСтроительства.ГрафикРаботы);
			
			ТекущиеДанные.НачалоРаботыПлан = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПервоеРабочееВремяДня(ГрафикРаботы, ТекущиеДанные.НачалоРаботыПлан);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.НачалоРаботыПлан) Тогда 	
			ТекущиеДанные.ДлительностьПлан = 0;
			
		ИначеЕсли Не ЗначениеЗаполнено(ТекущиеДанные.ДлительностьПлан) Тогда 
			ТекущиеДанные.ОкончаниеРаботыПлан = ТекущиеДанные.НачалоРаботыПлан;
			
		ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ДлительностьПлан) Тогда 	
			
			СтроительнаяРаботаСтруктура = Новый Структура;
			СтроительнаяРаботаСтруктура.Вставить("Владелец", 		ТекущиеДанные.Владелец);
			СтроительнаяРаботаСтруктура.Вставить("ГрафикРаботы", 	ТекущиеДанные.ГрафикРаботы);
			СтроительнаяРаботаСтруктура.Вставить("Ссылка", 			ТекущиеДанные.Ссылка);
			
			ТекущиеДанные.ОкончаниеРаботыПлан	= УСОERP_УправлениеСтроительнымПроизводством.РассчитатьОкончаниеПериода(СтроительнаяРаботаСтруктура, 
			ТекущиеДанные.НачалоРаботыПлан, 
			ТекущиеДанные.ДлительностьПлан, 
			ТекущиеДанные.ЕдиницаДлительности);
			
		КонецЕсли;
		
		ПересчитатьТрудоемкостьМашиноемкостьРесурсовНаКлиенте(ТекущиеДанные);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботОкончаниеРаботыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если Не ТекущиеДанные = Неопределено Тогда 	
		
		Если НЕ ДоДатыОкончания Тогда
			
			Если ЗначениеЗаполнено(ТекущиеДанные.ОкончаниеРаботыПлан) 
			И ТекущиеДанные.ОкончаниеРаботыПлан = НачалоДня(ТекущиеДанные.ОкончаниеРаботыПлан) Тогда
			
			ГрафикРаботы = ?(ЗначениеЗаполнено(ТекущиеДанные.ГрафикРаботы), ТекущиеДанные.ГрафикРаботы, РеквизитыОбъектаСтроительства.ГрафикРаботы);
			
			ТекущиеДанные.ОкончаниеРаботыПлан = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПоследнееРабочееВремяДня(ГрафикРаботы, ТекущиеДанные.ОкончаниеРаботыПлан);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.ОкончаниеРаботыПлан) Тогда 	
			ТекущиеДанные.ДлительностьПлан = 0;	
			
		ИначеЕсли Не ЗначениеЗаполнено(ТекущиеДанные.ДлительностьПлан) Тогда 
			ТекущиеДанные.НачалоРаботыПлан = ТекущиеДанные.ОкончаниеРаботыПлан;
			
		ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.НачалоРаботыПлан) Тогда 	
			
			СтроительнаяРаботаСтруктура = Новый Структура;
			СтроительнаяРаботаСтруктура.Вставить("Владелец", 		ТекущиеДанные.Владелец);
			СтроительнаяРаботаСтруктура.Вставить("ГрафикРаботы", 	ТекущиеДанные.ГрафикРаботы);
			СтроительнаяРаботаСтруктура.Вставить("Ссылка", 			ТекущиеДанные.Ссылка);
			
			ТекущиеДанные.ДлительностьПлан	= УСОERP_УправлениеСтроительнымПроизводством.РассчитатьДлительностьПериода(СтроительнаяРаботаСтруктура, 
				ТекущиеДанные.НачалоРаботыПлан, 
				ТекущиеДанные.ОкончаниеРаботыПлан, 
				ТекущиеДанные.ЕдиницаДлительности);
			
			КонецЕсли;
			
		ПересчитатьТрудоемкостьМашиноемкостьРесурсовНаКлиенте(ТекущиеДанные);
			
	Иначе	
		
		Если ЗначениеЗаполнено(ТекущиеДанные.ОкончаниеРаботыПлан) 
			И ТекущиеДанные.ОкончаниеРаботыПлан = НачалоДня(ТекущиеДанные.ОкончаниеРаботыПлан) Тогда
			
			ГрафикРаботы = ?(ЗначениеЗаполнено(ТекущиеДанные.ГрафикРаботы), ТекущиеДанные.ГрафикРаботы, РеквизитыОбъектаСтроительства.ГрафикРаботы);
			
			ТекущиеДанные.ОкончаниеРаботыПлан = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПоследнееРабочееВремяДня(ГрафикРаботы, ТекущиеДанные.ОкончаниеРаботыПлан);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.ОкончаниеРаботыПлан) Тогда 	
			ТекущиеДанные.ДлительностьПлан = 0;	
			
		ИначеЕсли Не ЗначениеЗаполнено(ТекущиеДанные.ДлительностьПлан) Тогда 
			ТекущиеДанные.НачалоРаботыПлан = ТекущиеДанные.ОкончаниеРаботыПлан;
			
		ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ОкончаниеРаботыПлан) Тогда 	
			
			СтроительнаяРаботаСтруктура = Новый Структура;
			СтроительнаяРаботаСтруктура.Вставить("Владелец", 		ТекущиеДанные.Владелец);
			СтроительнаяРаботаСтруктура.Вставить("ГрафикРаботы", 	ТекущиеДанные.ГрафикРаботы);
			СтроительнаяРаботаСтруктура.Вставить("Ссылка", 			ТекущиеДанные.Ссылка);
			
			
			ТекущиеДанные.НачалоРаботыПлан	= УСОERP_УправлениеСтроительнымПроизводством.РассчитатьНачалоПериода(СтроительнаяРаботаСтруктура, 
				ТекущиеДанные.ОкончаниеРаботыПлан, 
				ТекущиеДанные.ДлительностьПлан, 
				ТекущиеДанные.ЕдиницаДлительности);
			
			КонецЕсли;
			
		ПересчитатьТрудоемкостьМашиноемкостьРесурсовНаКлиенте(ТекущиеДанные);
		
		КонецЕсли; 
			
	КонецЕсли; 	

КонецПроцедуры

&НаСервере 
//Пересчитывает зависимые по предшественнику строки (серверный вариант)
//Параметры - работа, которую изменили первой.
Процедура ПересчитатьЗависимыеСтроки(Работа)	
	
	МассивИзмРабот = Новый Массив; 
	
	МассивСтрок = ПолучитьМассивСтрокДляИзменения(Работа); 
	
	Для Каждого ЭлементМассива ИЗ МассивСтрок Цикл
		
		МассивИзмененныхРабот = Новый Массив;
		УСОERP_УправлениеСтроительнымПроизводством.РассчитатьПланСценарияПланированияПроектовСтроительства(ЭлементМассива, ВидПланирования, НачалоДня(НаДату), МассивИзмененныхРабот);
		
		Для Каждого ЭлМассива ИЗ МассивИзмененныхРабот Цикл
			
			Если МассивИзмРабот.Найти(ЭлМассива) = Неопределено Тогда
				МассивИзмРабот.Добавить(ЭлМассива);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;   
	
	ОбновитьИзмененныеСтрокиРабот(МассивИзмРабот);	
	
КонецПроцедуры

&НаСервере
//Возвращает всех последователей по предшественнику из дерева
//Параметры - работа
Функция ПолучитьМассивСтрокДляИзменения(Работа) 	 
	
	МассивСтрок = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Работа",Работа);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УСОERP_СтроительныеРаботы.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	               |ГДЕ
	               |	УСОERP_СтроительныеРаботы.Ссылка = &Работа
	               |ИТОГИ ПО
	               |	Ссылка ИЕРАРХИЯ";
				   
				   ТЗ = Запрос.Выполнить().Выгрузить();
				   ТЗ.Свернуть("Ссылка");
				   МассивСтрок = Тз.ВыгрузитьКолонку("Ссылка");
	
	ПолучитьПоследователей(Работа,МассивСтрок);
	
	Возврат МассивСтрок; 	
	
КонецФункции  

&НаСервере 
//Получает  всех зависимых последователей для пересчета сроков (рекурсия)
//параметры - работа, для которой ищем
//массив с результатом
Процедура ПолучитьПоследователей(Работа,МассивРабот)
	
	ТЗ = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьВсехПоследователей(Работа,НаДату,ВидПланирования); 	
	
	Для Каждого СтрокаТЗ ИЗ ТЗ Цикл
		
		Если МассивРабот.Найти(СтрокаТЗ.Работа) = Неопределено Тогда
			
			МассивРабот.Добавить(СтрокаТЗ.Работа);
			
			Таб =  УСОERP_УправлениеСтроительнымПроизводством.ПолучитьВсехПоследователей(СтрокаТЗ.Работа,НаДату,ВидПланирования);
			
			Для Каждого СтрокаТаб ИЗ Таб Цикл
				
				Если МассивРабот.Найти(СтрокаТаб.Работа) = Неопределено Тогда
					
					МассивРабот.Добавить(СтрокаТаб.Работа);
					
					ПолучитьПоследователей(СтрокаТаб.Работа,МассивРабот);
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;		 
		
	КонецЦикла; 	 
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботРаботаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка =Ложь;
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда 
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", ТекущиеДанные.Ссылка);
		ПараметрыФормы.Вставить("НаДату", НаДату);
		РазблокироватьСтрокуДляРедактирования(ТекущиеДанные.Ссылка, ЭтаФорма.УникальныйИдентификатор);

		ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры
