	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.Ссылка</Field>
				<Field>Список.СуммарнаяРабота</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	СтроительныеРаботы.Ссылка КАК Ссылка,
	СтроительныеРаботы.Владелец КАК Владелец,
	СтроительныеРаботы.Код КАК Код,
	СтроительныеРаботы.Наименование КАК Наименование,
	СтроительныеРаботы.КодСДР КАК КодСДР,
	СтроительныеРаботы.СуммарнаяРабота КАК СуммарнаяРабота,
	ЕСТЬNULL(ПараметрыВыполненияРаботСрезПоследних.Утверждена, ЛОЖЬ) КАК Утверждена,
	ВЫБОР
		КОГДА СтроительныеРаботы.СуммарнаяРабота
			ТОГДА 0
		ИНАЧЕ 3
	КОНЕЦ КАК ИндексКартинки,
	ЕСТЬNULL(ПараметрыВыполненияРаботСрезПоследних.НачалоРаботыПлан, СтроительныеРаботы.ДатаНачала) КАК ДатаНачала,
	ЕСТЬNULL(ПараметрыВыполненияРаботСрезПоследних.ОкончаниеРаботыПлан, СтроительныеРаботы.ДатаОкончания) КАК ДатаОкончания,
	ЕСТЬNULL(ПараметрыВыполненияРаботСрезПоследних.ОбъемРаботы, СтроительныеРаботы.ОбъемРаботы) КАК Объем,
	ЕСТЬNULL(ПараметрыВыполненияРаботСрезПоследних.ЕдиницаОбъема, СтроительныеРаботы.ЕдиницаОбъема) КАК ЕдиницаОбъема,
	ЕСТЬNULL(ПараметрыВыполненияРаботСрезПоследних.ДлительностьПлан, СтроительныеРаботы.Длительность) КАК Длительность,
	ЕСТЬNULL(ПараметрыВыполненияРаботСрезПоследних.ЕдиницаДлительности, СтроительныеРаботы.ЕдиницаДлительности) КАК ЕдиницаДлительности,
	&amp;АдресТаблицы КАК АдресТаблицы
ИЗ
	Справочник.УСОERP_СтроительныеРаботы КАК СтроительныеРаботы
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(
				,
				Утверждена
					И ВидПланирования = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыПланированияСтроительныхРабот.Календарный)) КАК ПараметрыВыполненияРаботСрезПоследних
		ПО (ВЫБОР
				КОГДА СтроительныеРаботы.Владелец.НомерВерсии = 0
					ТОГДА СтроительныеРаботы.Ссылка = ПараметрыВыполненияРаботСрезПоследних.Работа
				ИНАЧЕ ЛОЖЬ
			КОНЕЦ)
ГДЕ
	НЕ СтроительныеРаботы.ПометкаУдаления</QueryText>
				<MainTable>Catalog.УСОERP_СтроительныеРаботы</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>Ссылка.НомерРаботыВУровне</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>КодСДР</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
