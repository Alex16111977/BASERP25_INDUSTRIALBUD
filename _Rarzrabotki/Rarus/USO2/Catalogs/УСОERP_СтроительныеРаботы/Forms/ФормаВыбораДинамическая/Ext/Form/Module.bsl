
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВидКодаСДР = 0;
	
	Если Параметры.Свойство("СценарийПланирования") Тогда
		
		ВидКодаСДР = Параметры.СценарийПланирования.ВидКодаСДР;
		
	КонецЕсли;
	
	Список.Параметры.УстановитьЗначениеПараметра("ВидКодаСДР",ВидКодаСДР);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	ВидКодаСДР = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВидКодаСДР")).Значение; 
	
	Если ВидКодаСДР = 0 Тогда
		
		Для Каждого НайденнаяСтрока ИЗ Строки Цикл 
			
			ДанныеСтроки = НайденнаяСтрока.Значение.Данные;
			
			Работа = НайденнаяСтрока.Ключ;	
			
			НайденнаяСтрока.Значение.Данные.КодСДР = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДР(Работа);				
			
		КонецЦикла;  		
		
	КонецЕсли; 
	
КонецПроцедуры
