
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьШаблон(Команда)
	
	СоздатьШаблонНаСервере();
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СоздатьШаблонНаСервере()
	
	Если ПустаяСтрока(Наименование) = "" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указано наименование",,"Наименование");
		Возврат;
	КонецЕсли;
	
	ТаблицаСоответствия = Новый ТаблицаЗначений;
	ТаблицаСоответствия.Колонки.Добавить("Приемник");
	ТаблицаСоответствия.Колонки.Добавить("Источник");
	
	Если НЕ ЗначениеЗаполнено(Источник) Тогда
		
		ШаблонСценария = Справочники.УСОERP_ШаблоныСтроительныхРабот.СоздатьГруппу();  
		ШаблонСценария.Родитель = Группа;
		ШаблонСценария.Наименование = Наименование;
		ШаблонСценария.Записать();
		
		СпрВыборка = Справочники.УСОERP_СтроительныеРаботы.Выбрать(Справочники.УСОERP_СтроительныеРаботы.ПустаяСсылка(),,,"НомерРаботыВУровне");
		
		Пока СпрВыборка.Следующий() Цикл
			
			Элемент = СпрВыборка.Ссылка;
			
			Если ЗначениеЗаполнено(Элемент.Родитель) Тогда
				Продолжить;
			КонецЕсли; 
			
			Если Не Элемент.СуммарнаяРабота Тогда
				
				Шаблон = Справочники.УСОERP_ШаблоныСтроительныхРабот.СоздатьЭлемент();
				Шаблон.Родитель = ШаблонСценария.Ссылка;
				ЗаполнитьОбъектНаОсновании(Шаблон,Элемент);
				Шаблон.Наименование = Элемент.Наименование;
				Шаблон.Записать();
				
				Нстр = ТаблицаСоответствия.Добавить();
				Нстр.Приемник = Шаблон.Ссылка;
				Нстр.Источник = Элемент;
				
			Иначе
				//создаем папку "Шаблонов"
				Шаблон = Справочники.УСОERP_ШаблоныСтроительныхРабот.СоздатьГруппу();   
				Шаблон.Родитель = ШаблонСценария.Ссылка;
				Шаблон.Записать();
				Шаблон.ЗаполнитьШаблонНаОснованииРаботы(Шаблон,Элемент,ТаблицаСоответствия);
				Шаблон.Наименование = Элемент.Наименование;
				Шаблон.Записать();
				
			КонецЕсли;			
			
		КонецЦикла;
		
	Иначе
		
		ШаблонСценария = Справочники.УСОERP_ШаблоныСтроительныхРабот.СоздатьГруппу();  
		ШаблонСценария.Родитель = Группа;
		ШаблонСценария.Наименование = Наименование;
		ШаблонСценария.Записать();
		
		Если ТипЗнч(Источник) = Тип("СписокЗначений") Тогда
			
			ИсточникИерархия = ПолучитьИерархиюВыбранныхСтрок(Источник);	
			
			Для Каждого СтрокаИсточник Из ИсточникИерархия Цикл
				
				РаботаИсточник = СтрокаИсточник.Значение;
				
				Если Не РаботаИсточник.СуммарнаяРабота Тогда
					
					Шаблон = Справочники.УСОERP_ШаблоныСтроительныхРабот.СоздатьЭлемент();
					Шаблон.Родитель = ШаблонСценария.Ссылка;
					ЗаполнитьОбъектНаОсновании(Шаблон,РаботаИсточник);
					Шаблон.Наименование = РаботаИсточник.Наименование;
					Шаблон.Записать();
					
					Нстр = ТаблицаСоответствия.Добавить();
					Нстр.Приемник = Шаблон.Ссылка;
					Нстр.Источник = РаботаИсточник;
					
					
				Иначе
					
					Шаблон = Справочники.УСОERP_ШаблоныСтроительныхРабот.СоздатьГруппу();   
					Шаблон.Родитель = ШаблонСценария.Ссылка;
					Шаблон.Записать();
					Шаблон.ЗаполнитьШаблонНаОснованииРаботы(Шаблон,РаботаИсточник,ТаблицаСоответствия);
					Шаблон.Наименование = РаботаИсточник.Наименование;
					Шаблон.Записать();
					
				КонецЕсли; 
				
			КонецЦикла;	
			
		КонецЕсли;	
		
	КонецЕсли;
	
	ТаблицаСоответствия.Свернуть("Приемник,Источник");
	
	Для Каждого СтрокаСоответствия ИЗ ТаблицаСоответствия Цикл
		
		Если СтрокаСоответствия.Источник.Предшественники.Количество() Тогда
			
			ШаблонОбъект = СтрокаСоответствия.Приемник.ПолучитьОбъект();
			
			Для Каждого СтрокаПредшественник ИЗ  СтрокаСоответствия.Источник.Предшественники Цикл
				
				Строка = ТаблицаСоответствия.Найти(СтрокаПредшественник.СтроительнаяРабота,"Источник");
				Если Строка = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Нстр = ШаблонОбъект.Предшественники.Добавить();
				ЗаполнитьЗначенияСвойств(Нстр,СтрокаПредшественник);
				Нстр.Шаблон = Строка.Приемник;
				
			КонецЦикла; 			
			
			ШаблонОбъект.Записать();
			
		КонецЕсли;  		
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИерархиюВыбранныхСтрок(СписокВыбранныхРабот)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Работа КАК Работа
	|ИЗ
	|	(ВЫБРАТЬ
	|		УСОERP_СтроительныеРаботы.Ссылка КАК Работа
	|	ИЗ
	|		Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|	ГДЕ
	|		УСОERP_СтроительныеРаботы.Ссылка В(&Массив)
	|		И УСОERP_СтроительныеРаботы.ПометкаУдаления = ЛОЖЬ) КАК ВложенныйЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	Работа ИЕРАРХИЯ";
	
	Запрос.УстановитьПараметр("Массив", СписокВыбранныхРабот.ВыгрузитьЗначения());
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	МасиивЛишнихРабот = Новый Массив;
	СписокРабот = Новый СписокЗначений;
	
	Для Каждого СтрокаРабота Из ВыборкаДетальныеЗаписи.Строки Цикл
		
		РаботаРодитель = СтрокаРабота.Работа.Родитель;
		
		Пока ЗначениеЗаполнено(РаботаРодитель) Цикл
			
			Для Каждого СтрокаРаботаПроверка Из ВыборкаДетальныеЗаписи.Строки Цикл
				
				Если СтрокаРаботаПроверка.Работа = РаботаРодитель Тогда 
					
					МасиивЛишнихРабот.Добавить(СтрокаРабота.Работа);
					
				КонецЕсли;	
				
			КонецЦикла;	
			
			РаботаРодитель = РаботаРодитель.Родитель;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого СтрокаРабота Из ВыборкаДетальныеЗаписи.Строки Цикл
		
		Если МасиивЛишнихРабот.Найти(СтрокаРабота.Работа) = Неопределено Тогда
			
			СписокРабот.Добавить(СтрокаРабота.Работа);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокРабот;
	
КонецФункции	

&НаСервере
Процедура ЗаполнитьОбъектНаОсновании(Приемник, Источник) Экспорт
	
	Если НЕ ТипЗнч(Источник) = Тип("Структура") Тогда
		
		ИсточникМетаданные = Источник.Метаданные();
		ПриемникМетаданные = Приемник.Метаданные();
		
		// Переносим реквизиты
		Для Каждого Реквизит Из ПриемникМетаданные.Реквизиты Цикл
			РеквизитИсточник = ИсточникМетаданные.Реквизиты.Найти(Реквизит.Имя);
			Если РеквизитИсточник <> Неопределено Тогда 			
				Приемник[Реквизит.Имя] = Источник[Реквизит.Имя];
			КонецЕсли;
		КонецЦикла;
		
		Если Источник.Владелец.НовыйВариант Тогда
			
			Приемник.ОбъемРаботы 		 = Источник.ОбъемРаботы;
			Приемник.ЕдиницаОбъема       = Источник.ЕдиницаОбъема;
			Приемник.ДлительностьПлан	 = Источник.Длительность;
			Приемник.ЕдиницаДлительности = Источник.ЕдиницаДлительности;
			
			Приемник.Материалы.Загрузить(Источник.Материалы.Выгрузить());
			ТабРесурсы = Источник.Ресурсы.Выгрузить();
			ТабРесурсы.Колонки.ЗагрузкаПроцент.Имя = "Загрузка";
			Приемник.Ресурсы.Загрузить(ТабРесурсы);
			
		Иначе
			
			ПараметрыВыполненияРаботы = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПараметрыВыполненияРаботы(Источник, Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный, ТекущаяДата()); 
			
			Приемник.ОбъемРаботы 		  = ПараметрыВыполненияРаботы.ОбъемРаботы;
			Приемник.ЕдиницаОбъема       = ПараметрыВыполненияРаботы.ЕдиницаОбъема;
			Приемник.ДлительностьПлан	  = ПараметрыВыполненияРаботы.ДлительностьПлан;
			Приемник.ЕдиницаДлительности = ПараметрыВыполненияРаботы.ЕдиницаДлительности;
			
			// Заполняем табличные части 
			ТаблицаМатериалов = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПотребностьВМатериалах(Источник, Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный, ТекущаяДата());
			
			//ТаблицаМатериалов.Колонки.Номенклатура.Имя = "Материал";
			Для Каждого СтрокаМатериал Из ТаблицаМатериалов Цикл
				
				НоваяСтрока = Приемник.Материалы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМатериал);
				
			КонецЦикла;
			
			ТаблицаРесурсов = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПотребностьВРесурсах(Источник, Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный, ТекущаяДата());
			ТаблицаРесурсов.Колонки.ЗагрузкаПроцент.Имя = "Загрузка";
			
			Для Каждого СтрокаРесурс Из ТаблицаРесурсов Цикл
				
				НоваяСтрока = Приемник.Ресурсы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРесурс);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти
