
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  	
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Период", КонецДня(ТекущаяДата()), Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Утверждена", ?(Параметры.Свойство("Утверждена"),Параметры.Свойство("Утверждена"),ЛОЖЬ), Истина);
	
	Если Параметры.Свойство("Организация") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Организация", Параметры.Организация, ВидСравненияКомпоновкиДанных.ВСписке, , Истина);
	КонецЕсли;
	
	Если Параметры.Свойство("ОбъектСтроительства") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ОбъектСтроительства", Параметры.ОбъектСтроительства, ВидСравненияКомпоновкиДанных.ВСписке, , Истина);
	КонецЕсли;
	
	Если Параметры.Свойство("СценарийПланирования") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "СценарийПланирования", Параметры.СценарийПланирования, ВидСравненияКомпоновкиДанных.ВСписке, , Истина);
	КонецЕсли;
	
	Если Параметры.Свойство("Утверждена") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Утверждена", Параметры.Утверждена, ВидСравненияКомпоновкиДанных.Равно, , Истина);
	КонецЕсли;
	
	Если Параметры.Свойство("СуммарнаяРабота") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "СуммарнаяРабота", Параметры.СуммарнаяРабота, ВидСравненияКомпоновкиДанных.Равно, , Истина);
	КонецЕсли;
	
	Если Параметры.Свойство("СписокРабот") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Ссылка", Параметры.СписокРабот, ВидСравненияКомпоновкиДанных.ВСписке, , Истина);
	КонецЕсли;
	
	Если Параметры.Свойство("ДокументУтверждения") Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "СценарийПланирования",?(Параметры.ДокументУтверждения.СценарийПланирования.НовыйВариант = Истина, Параметры.ДокументУтверждения.КопияСценария,Параметры.ДокументУтверждения.СценарийПланирования), ВидСравненияКомпоновкиДанных.Равно, , Истина);
		
	КонецЕсли;  	
	
КонецПроцедуры
