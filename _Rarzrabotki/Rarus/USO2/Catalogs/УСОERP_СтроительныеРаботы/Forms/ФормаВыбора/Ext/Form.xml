				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СтроительныеРаботы.Ссылка,
	СтроительныеРаботы.Владелец КАК СценарийПланирования,
	СтроительныеРаботы.Родитель,
	СтроительныеРаботы.Код,
	СтроительныеРаботы.Наименование,
	СтроительныеРаботы.КодСДР КАК КодСДР,
	СтроительныеРаботы.ВидРабот,
	СтроительныеРаботы.СтатьяСводногоСметногоРасчета,
	СтроительныеРаботы.ГрафикРаботы,
	СтроительныеРаботы.НомерРаботыВУровне,
	СтроительныеРаботы.СуммарнаяРабота,
	СтроительныеРаботы.Предопределенный,
	СтроительныеРаботы.ИмяПредопределенныхДанных,
	ВЫБОР
		КОГДА СтроительныеРаботы.Владелец.НомерВерсии &gt; 0
			ТОГДА СтроительныеРаботы.Длительность
		ИНАЧЕ ЕСТЬNULL(ВложенныйЗапрос.ДлительностьПлан, 0)
	КОНЕЦ КАК ДлительностьПлан,
	ВЫБОР
		КОГДА СтроительныеРаботы.Владелец.НомерВерсии &gt; 0
			ТОГДА СтроительныеРаботы.ДатаНачала
		ИНАЧЕ ЕСТЬNULL(ВложенныйЗапрос.НачалоРаботыПлан, ДАТАВРЕМЯ(1, 1, 1))
	КОНЕЦ КАК НачалоРаботыПлан,
	ВЫБОР
		КОГДА СтроительныеРаботы.Владелец.НомерВерсии &gt; 0
			ТОГДА СтроительныеРаботы.ДатаОкончания
		ИНАЧЕ ЕСТЬNULL(ВложенныйЗапрос.ОкончаниеРаботыПлан, ДАТАВРЕМЯ(1, 1, 1))
	КОНЕЦ КАК ОкончаниеРаботыПлан,
	ВЫБОР
		КОГДА СтроительныеРаботы.Владелец.НомерВерсии &gt; 0
			ТОГДА СтроительныеРаботы.ОбъемРаботы
		ИНАЧЕ ЕСТЬNULL(ВложенныйЗапрос.ОбъемРаботы, 0)
	КОНЕЦ КАК ОбъемРаботы,
	ВЫБОР
		КОГДА СтроительныеРаботы.Владелец.НомерВерсии &gt; 0
			ТОГДА СтроительныеРаботы.ЕдиницаОбъема
		ИНАЧЕ ЕСТЬNULL(ВложенныйЗапрос.ЕдиницаОбъема, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка))
	КОНЕЦ КАК ЕдиницаОбъема,
	ВЫБОР
		КОГДА СтроительныеРаботы.Владелец.НомерВерсии &gt; 0
			ТОГДА СтроительныеРаботы.ЕдиницаДлительности
		ИНАЧЕ ЕСТЬNULL(ВложенныйЗапрос.ЕдиницаДлительности, ЗНАЧЕНИЕ(Перечисление.ЕдиницыИзмеренияВремени.ПустаяСсылка))
	КОНЕЦ КАК ЕдиницаДлительности,
	СтроительныеРаботы.Владелец.Владелец КАК ОбъектСтроительства,
	ВложенныйЗапрос.Утверждена,
	СтроительныеРаботы.Владелец.Организация КАК Организация,
	ВЫБОР
		КОГДА СтроительныеРаботы.СуммарнаяРабота
			ТОГДА 0
		ИНАЧЕ 3
	КОНЕЦ КАК ИндексКартинки
ИЗ
	Справочник.УСОERP_СтроительныеРаботы КАК СтроительныеРаботы
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа КАК Работа,
			МАКСИМУМ(УСОERP_ПараметрыВыполненияРаботСрезПоследних.Утверждена) КАК Утверждена,
			МАКСИМУМ(УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОбъемРаботы) КАК ОбъемРаботы,
			МАКСИМУМ(УСОERP_ПараметрыВыполненияРаботСрезПоследних.ЕдиницаОбъема) КАК ЕдиницаОбъема,
			МАКСИМУМ(УСОERP_ПараметрыВыполненияРаботСрезПоследних.НачалоРаботыПлан) КАК НачалоРаботыПлан,
			МАКСИМУМ(УСОERP_ПараметрыВыполненияРаботСрезПоследних.ОкончаниеРаботыПлан) КАК ОкончаниеРаботыПлан,
			МАКСИМУМ(УСОERP_ПараметрыВыполненияРаботСрезПоследних.ДлительностьПлан) КАК ДлительностьПлан,
			МАКСИМУМ(УСОERP_ПараметрыВыполненияРаботСрезПоследних.ЕдиницаДлительности) КАК ЕдиницаДлительности
		ИЗ
			РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(
					&amp;Период,
					ВЫБОР
						КОГДА &amp;Утверждена = ИСТИНА
							ТОГДА Утверждена = ИСТИНА
						ИНАЧЕ ИСТИНА
					КОНЕЦ) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
		
		СГРУППИРОВАТЬ ПО
			УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа) КАК ВложенныйЗапрос
		ПО СтроительныеРаботы.Ссылка = ВложенныйЗапрос.Работа
ГДЕ
	НЕ СтроительныеРаботы.ПометкаУдаления

СГРУППИРОВАТЬ ПО
	СтроительныеРаботы.Ссылка,
	СтроительныеРаботы.Владелец,
	СтроительныеРаботы.Родитель,
	СтроительныеРаботы.Код,
	СтроительныеРаботы.Наименование,
	СтроительныеРаботы.КодСДР,
	СтроительныеРаботы.ВидРабот,
	СтроительныеРаботы.СтатьяСводногоСметногоРасчета,
	СтроительныеРаботы.ГрафикРаботы,
	СтроительныеРаботы.НомерРаботыВУровне,
	СтроительныеРаботы.СуммарнаяРабота,
	СтроительныеРаботы.Предопределенный,
	СтроительныеРаботы.ИмяПредопределенныхДанных,
	СтроительныеРаботы.Владелец.Организация,
	СтроительныеРаботы.Владелец.Владелец,
	ВЫБОР
		КОГДА СтроительныеРаботы.СуммарнаяРабота
			ТОГДА 0
		ИНАЧЕ 3
	КОНЕЦ,
	ВложенныйЗапрос.Утверждена,
	ВЫБОР
		КОГДА СтроительныеРаботы.Владелец.НомерВерсии &gt; 0
			ТОГДА СтроительныеРаботы.Длительность
		ИНАЧЕ ЕСТЬNULL(ВложенныйЗапрос.ДлительностьПлан, 0)
	КОНЕЦ,
	ВЫБОР
		КОГДА СтроительныеРаботы.Владелец.НомерВерсии &gt; 0
			ТОГДА СтроительныеРаботы.ДатаНачала
		ИНАЧЕ ЕСТЬNULL(ВложенныйЗапрос.НачалоРаботыПлан, ДАТАВРЕМЯ(1, 1, 1))
	КОНЕЦ,
	ВЫБОР
		КОГДА СтроительныеРаботы.Владелец.НомерВерсии &gt; 0
			ТОГДА СтроительныеРаботы.ДатаОкончания
		ИНАЧЕ ЕСТЬNULL(ВложенныйЗапрос.ОкончаниеРаботыПлан, ДАТАВРЕМЯ(1, 1, 1))
	КОНЕЦ,
	ВЫБОР
		КОГДА СтроительныеРаботы.Владелец.НомерВерсии &gt; 0
			ТОГДА СтроительныеРаботы.ОбъемРаботы
		ИНАЧЕ ЕСТЬNULL(ВложенныйЗапрос.ОбъемРаботы, 0)
	КОНЕЦ,
	ВЫБОР
		КОГДА СтроительныеРаботы.Владелец.НомерВерсии &gt; 0
			ТОГДА СтроительныеРаботы.ЕдиницаОбъема
		ИНАЧЕ ЕСТЬNULL(ВложенныйЗапрос.ЕдиницаОбъема, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка))
	КОНЕЦ,
	ВЫБОР
		КОГДА СтроительныеРаботы.Владелец.НомерВерсии &gt; 0
			ТОГДА СтроительныеРаботы.ЕдиницаДлительности
		ИНАЧЕ ЕСТЬNULL(ВложенныйЗапрос.ЕдиницаДлительности, ЗНАЧЕНИЕ(Перечисление.ЕдиницыИзмеренияВремени.ПустаяСсылка))
	КОНЕЦ</QueryText>
