КонецПроцедуры

&НаКлиенте
Процедура ТипОграниченияПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаОграничения) Тогда
		
		Если Объект.ТипОграничения = ПредопределенноеЗначение("Перечисление.УСОERP_ТипыОграничений.НачалоНеРанее")
			ИЛИ  Объект.ТипОграничения = ПредопределенноеЗначение("Перечисление.УСОERP_ТипыОграничений.НачалоНеПозднее")
			ИЛИ  Объект.ТипОграничения = ПредопределенноеЗначение("Перечисление.УСОERP_ТипыОграничений.ФиксированноеНачало")
			
			Тогда Объект.ДатаОграничения = ДатаНачала;
			
		ИначеЕсли
			
			Объект.ТипОграничения = ПредопределенноеЗначение("Перечисление.УСОERP_ТипыОграничений.ОкончаниеНеПозднее")
			ИЛИ  Объект.ТипОграничения = ПредопределенноеЗначение("Перечисление.УСОERP_ТипыОграничений.ОкончаниеНеРанее")
			ИЛИ  Объект.ТипОграничения = ПредопределенноеЗначение("Перечисление.УСОERP_ТипыОграничений.ФиксированноеОкончание")
			Тогда Объект.ДатаОграничения = ДатаОкончания;
			
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.ПометкаУдаления И ВыполненныйОбъем Тогда
		
		ПоказатьПредупреждение(,"По "+?(Объект.СуммарнаяРабота,"этапу ","работе ")+" было выполнение работ, удаление невозможно!");
		Отказ = Истина;
		
	Иначе		
		
		Если ЗначениеЗаполнено(Объект.Ссылка) И Модифицированность Тогда
			ЗаполнитьСтруктуруРаботыНаСервере();
		КонецЕсли;
		
	КонецЕсли;
	
	ПроверитьНаЗаполненностьХарактеристик(Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаЗаполненностьХарактеристик(Отказ)
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры") Тогда
		Возврат;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТабТовары",Объект.Материалы.Выгрузить());
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботыМатериалы.НомерСтроки КАК НомерСтроки,
	|	ВЫРАЗИТЬ(УСОERP_СтроительныеРаботыМатериалы.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	УСОERP_СтроительныеРаботыМатериалы.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	&ТабТовары КАК УСОERP_СтроительныеРаботыМатериалы
	|ГДЕ
	|	УСОERP_СтроительныеРаботыМатериалы.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|ГДЕ
	|	ВрТаб.Номенклатура.ИспользованиеХарактеристик <> ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке № "+Выборка.НомерСтроки+" не заполнена характеристика",,,,Отказ);
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьСтруктуруРаботыНаСервере(ПометкаУдаления = Ложь) 
	
	Работа = Объект.Ссылка;
	
	Структура = Новый Структура;
	Структура.Вставить("Код",Работа.Код);
	Структура.Вставить("Наименование",Работа.Наименование);
	Структура.Вставить("Ссылка",Работа);
	Структура.Вставить("ПометкаУдаления",ПометкаУдаления);
	Структура.Вставить("Родитель",Работа.Родитель);
	
	Для Каждого Реквизит ИЗ Метаданные.Справочники.УСОERP_СтроительныеРаботы.Реквизиты Цикл
		Структура.Вставить(Реквизит.Имя,Работа[Реквизит.Имя]);
	КонецЦикла;
	
	Структура.Вставить("Материалы",Работа.Материалы.Выгрузить());
	Структура.Вставить("Ресурсы",Работа.Ресурсы.Выгрузить());
	Структура.Вставить("Предшественники",Работа.Предшественники.Выгрузить());
	
	СтруктураРаботы = Новый Структура("Ссылка,Структура",Работа,ЗначениеВСтрокуВнутр(Структура));	
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьСтруктуруРаботыПослеНаСервере() 
	
	Работа = Объект.Ссылка;
	
	Структура = Новый Структура;
	Структура.Вставить("Код",Работа.Код);
	Структура.Вставить("Наименование",Работа.Наименование);
	Структура.Вставить("Ссылка",Работа);
	Структура.Вставить("ПометкаУдаления",Работа.ПометкаУдаления);
	Структура.Вставить("Родитель",Работа.Родитель);
	
	Для Каждого Реквизит ИЗ Метаданные.Справочники.УСОERP_СтроительныеРаботы.Реквизиты Цикл
		Структура.Вставить(Реквизит.Имя,Работа[Реквизит.Имя]);
	КонецЦикла;
	
	Структура.Вставить("Материалы",Работа.Материалы.Выгрузить());
	Структура.Вставить("Ресурсы",Работа.Ресурсы.Выгрузить());
	Структура.Вставить("Предшественники",Работа.Предшественники.Выгрузить());
	
	СтруктураРаботыПосле = Новый Структура("Ссылка,Структура",Работа,ЗначениеВСтрокуВнутр(Структура));	
	
КонецПроцедуры  

&НаКлиенте
Процедура РесурсыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ТекСтрока = Элементы.Ресурсы.ТекущиеДанные;
		ТекСтрока.Количество = 1;
		ТекСтрока.ЗагрузкаПроцент = 100;
		ТекСтрока.ГрафикРаботы = Объект.ГрафикРаботы;
		
	КонецЕсли;	

КонецПроцедуры

