&НаСервере
Процедура ЗаполнитьКодСДР()
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Владелец.НомерВерсии ТОгда
		КодСДР = Объект.КодСДР;
		Возврат;
	КонецЕсли;
	
	КодСДР = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДР(Объект.Ссылка);
	 		
КонецПроцедуры

