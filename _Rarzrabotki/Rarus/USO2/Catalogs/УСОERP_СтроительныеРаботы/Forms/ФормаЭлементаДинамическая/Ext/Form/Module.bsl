Перем ТаблицаГрафика;
&НаКлиенте
Перем КэшированныеЗначения;

#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбъектСтроительства = Объект.Владелец.Владелец;
	
		// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда  		
		 		
		Если Параметры.Свойство("Владелец") Тогда
			
			Объект.Владелец = Параметры.Владелец;
			
		КонецЕсли;		
		
		Объект.ЕдиницаДлительности = Объект.Владелец.Владелец.ЕдиницаДлительности;
		Объект.ЕдиницаЗадержки     = Объект.Владелец.Владелец.ЕдиницаДлительности;
		Объект.ГрафикРаботы = Объект.Владелец.Владелец.ГрафикРаботы;
		Объект.Длительность = 1;
		Объект.НомерРаботыВУровне = 0;
		ЭтоНовыйОбъект = Истина;
		
		Если Параметры.Свойство("Родитель") Тогда
			
			Объект.Родитель = Параметры.Родитель;
			Объект.Задержка = Объект.Родитель.Задержка;
			
		КонецЕсли;
		
		Если Параметры.Свойство("Предшественник") И ЗначениеЗаполнено(Параметры.Предшественник) Тогда
			
			Нстр = Объект.Предшественники.Добавить();
			Нстр.СтроительнаяРабота = Параметры.Предшественник;
			Нстр.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.ОкончаниеНачало;
			Нстр.Задержка = 0;
			Нстр.ЕдиницаЗадержки = Перечисления.ЕдиницыИзмеренияВремени.День;
			
		КонецЕсли;
				
		Если Параметры.Свойство("Переносить")  Тогда
			
			Переносить = Истина;		
			
			Если Параметры.Переносить = Истина  Тогда
				
				Объект.Материалы.Загрузить(Объект.Родитель.Материалы.Выгрузить());
				Объект.Ресурсы.Загрузить(Объект.Родитель.Ресурсы.Выгрузить());
				Объект.Предшественники.Загрузить(Объект.Родитель.Предшественники.Выгрузить());
				Объект.Длительность = Объект.Родитель.Длительность;
				Объект.ЕдиницаДлительности = Объект.Родитель.ЕдиницаДлительности;
				Объект.ОбъемРаботы = Объект.Родитель.ОбъемРаботы;
				Объект.ЕдиницаОбъема = Объект.Родитель.ЕдиницаОбъема;
				Объект.НомерРаботыВУровне = 1;
				
				Объект.ГрафикРаботы = ?(ЗначениеЗаполнено(Объект.Родитель.ГрафикРаботы),Объект.Родитель.ГрафикРаботы,Объект.Владелец.Владелец.ГрафикРаботы);
				
			КонецЕсли;
			
		КонецЕсли; 		
		
		Если Параметры.Свойство("НомерРаботыВУровне") Тогда
			
			Объект.НомерРаботыВУровне = Параметры.НомерРаботыВУровне;
			
		КонецЕсли;
		
	КонецЕсли;   
	
	Если Параметры.Свойство("УИДГрафика") Тогда
		
		УИДГрафика = Параметры.УИДГрафика;
		
	КонецЕсли;
	
	ЭтоГруппаРабот = Объект.СуммарнаяРабота;	
	
	Если НЕ Объект.Владелец.НомерВерсии Тогда
		
		ЗаполнитьТаблицуГрафика();
	
	Если НЕ ТабГрафик.Количество() Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен график!");
		Отказ = Истина;
	КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьДаты();
	ЗаполнитьКодСДР();
	РассчитатьТрудоМашиноемкость();
	ВыполненныйОбъем = Справочники.УСОERP_СтроительныеРаботы.ПолучитьВыполненныйОбъем(Объект.Ссылка);
	
	УстановитьУсловноеОформление();
	
	ЗаполнитьРесурсыМатериалыГруппыРабот();
	
	ЭтаФорма.ТолькоПросмотр = Объект.Владелец.НомерВерсии;
	
	НоменклатураСервер.ЗаполнитьПризнакИспользованияХарактеристик(Объект.Материалы); 
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(
	Объект.Материалы,
	Новый Структура("ЗаполнитьПризнакХарактеристикиИспользуются",Новый Структура("Номенклатура", "ХарактеристикиИспользуются")));
		
КонецПроцедуры

