&НаКлиенте
Перем КэшированныеЗначения; 

&НаСервере
Процедура СоздатьРаботыНаСервере()

	Если НЕ ЗначениеЗаполнено(Группа) Тогда
	     Сообщить("Не указана папка шаблонов");
		 Возврат;
	КонецЕсли; 
	
	ЗаполнитьСвязиВЭтойПроцедуре = Ложь;  
	
	ТаблицаСоответствия = Новый ТаблицаЗначений;
	
	ТаблицаСоответствия.Колонки.Добавить("Приемник");
	ТаблицаСоответствия.Колонки.Добавить("Источник");
	
	ВыборкаШаблоновРабот = Справочники.УСОERP_ШаблоныСтроительныхРабот.Выбрать(Группа,,,"НомерРаботыВУровне");
	
	Пока ВыборкаШаблоновРабот.Следующий() Цикл
		
		ШаблонРаботы = ВыборкаШаблоновРабот.Ссылка;
		
		Если ШаблонРаботы.Родитель <> Группа Тогда
		     Продолжить;
		КонецЕсли;
		
		Приемник = Справочники.УСОERP_СтроительныеРаботы.СоздатьЭлемент();
		
		Если ЗначениеЗаполнено(Родитель) Тогда
		    Приемник.Родитель = Родитель;			
		КонецЕсли; 
		
		Приемник.Владелец = Сценарий;
		
		Если Не ШаблонРаботы.ЭтоГруппа Тогда
			
			ДанныеКода = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДРИНомерРаботыВУровне(Приемник.Владелец, Приемник.Родитель);
			Приемник.КодСДР  = ДанныеКода.КодСДР;
			Приемник.НомерРаботыВУровне 	= ДанныеКода.НомерРаботыВУровне;
			
			Приемник.СуммарнаяРабота = Ложь;
			Приемник.Наименование = ШаблонРаботы.Наименование;
			ЗаполнитьОбъектНаОсновании(Приемник, ШаблонРаботы);
			Приемник.Записать();
			ПровестиПоРегистрам(Приемник, ШаблонРаботы);
			Нстр = ТаблицаСоответствия.Добавить();
			Нстр.Приемник  = Приемник.Ссылка;
			Нстр.Источник = ШаблонРаботы;
			
		Иначе 
			Приемник.СуммарнаяРабота = Истина;
			Приемник.Наименование = ШаблонРаботы.Наименование;
			Приемник.Записать();
			Шаблон = ШаблонРаботы.ПолучитьОбъект();
			Шаблон.ЗаполнитьРаботуНаОснованииШаблона(Приемник,Шаблон,ТаблицаСоответствия);
		КонецЕсли;
		Приемник.Записать();
	КонецЦикла; 
	
	ТаблицаСоответствия.Свернуть("Приемник,Источник");
	
	Для Каждого СтрокаСоответствия ИЗ ТаблицаСоответствия Цикл
		
		Если НЕ СтрокаСоответствия.Источник.Предшественники.Количество() Тогда
			Продолжить;
		КонецЕсли;
		
		РаботаОбъект =  СтрокаСоответствия.Приемник.ПолучитьОбъект();
		
		Для Каждого СтрокаПредшественники ИЗ СтрокаСоответствия.Источник.Предшественники Цикл
			
			Строка = ТаблицаСоответствия.Найти(СтрокаПредшественники.Шаблон,"Источник");
			
			Если Строка = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Нстр = РаботаОбъект.Предшественники.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,СтрокаПредшественники);
			Нстр.СтроительнаяРабота = Строка.Приемник;		
						
		КонецЦикла;
		
		РаботаОбъект.Записать(); 		
		
	КонецЦикла; 	

КонецПроцедуры

&НаКлиенте
Процедура СоздатьРаботы(Команда)
	СоздатьРаботыНаСервере();
	ЭтаФорма.Закрыть();
КонецПроцедуры


//В процедуре заполняем Объект-Приемник на основании Объекта-Источника
//реквизиты переносим при совпадении наименований, аналогично с табличными частями
&НаСервере
Процедура ЗаполнитьОбъектНаОсновании(Приемник,Источник) Экспорт
	
	Если НЕ ТипЗнч(Источник) = Тип("Структура") Тогда
		
		ИсточникМетаданные = Источник.Метаданные();
		ПриемникМетаданные = Приемник.Метаданные();
		
		Приемник.Длительность = Источник.ДлительностьПлан;
		
		// Переносим реквизиты
		Для Каждого Реквизит из ПриемникМетаданные.Реквизиты Цикл
			
			Если Реквизит.Имя = "НомерРаботыВУровне" И ЗначениеЗаполнено(Приемник[Реквизит.Имя]) Тогда
				Продолжить;
			КонецЕсли;
			
			РеквизитИсточник = ИсточникМетаданные.Реквизиты.Найти(Реквизит.Имя);
			Если РеквизитИсточник <> Неопределено Тогда 			
				Приемник[Реквизит.Имя] = Источник[Реквизит.Имя];
			КонецЕсли;
			
		КонецЦикла;
		
		Если ТипЗнч(Приемник) = Тип("СправочникОбъект.УСОERP_СтроительныеРаботы") И Приемник.Владелец.НовыйВариант И НЕ Источник.ЭтоГруппа Тогда
			Приемник.Материалы.Загрузить(Источник.Материалы.Выгрузить());
			ТабРесурсов = Источник.Ресурсы.Выгрузить();
			ТабРесурсов.Колонки.Загрузка.Имя = "ЗагрузкаПроцент";
			Приемник.Ресурсы.Загрузить(ТабРесурсов);
		КонецЕсли;
		
	КонецЕсли;		
КонецПроцедуры


&НаСервере
Процедура ПровестиПоРегистрам(Приемник, Источник)
	
	Если Приемник.Владелец.НовыйВариант Тогда
		Возврат;
	КонецЕсли;
	
    КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();

	Для Каждого СтрокаМатериал Из Источник.Материалы Цикл
		МенеджерЗаписи 	= РегистрыСведений.УСОERP_ПотребностьВМатериалах.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Работа			= Приемник.Ссылка;
		МенеджерЗаписи.ВидПланирования 	= Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный;	
		МенеджерЗаписи.Период			= НачалоДня(ТекущаяДата());
		МенеджерЗаписи.АвторИзмерения   = Пользователи.ТекущийПользователь();
		МенеджерЗаписи.КоличествоУпаковокНаОбъемРаботы	= Окр(СтрокаМатериал.КоличествоУпаковокНаЕдиницуОбъема * Источник.ОбъемРаботы, 3);
		МенеджерЗаписи.КоличествоНаОбъемРаботы = СтрокаМатериал.КоличествоУпаковокНаЕдиницуОбъема * ПолучитьКоэффициентУпаковки(СтрокаМатериал.Упаковка, КэшированныеЗначения)* Источник.ОбъемРаботы;

		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтрокаМатериал);
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
		МенеджерЗаписи 	= РегистрыСведений.УСОERP_ПараметрыВыполненияРабот.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Работа				= Приемник.Ссылка;
		МенеджерЗаписи.ВидПланирования	 	= Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный;
		МенеджерЗаписи.Период	        	= НачалоДня(ТекущаяДата());
		МенеджерЗаписи.АвторИзменения 		= Пользователи.ТекущийПользователь();
		МенеджерЗаписи.ОбъемРаботы			= Источник.ОбъемРаботы;
		МенеджерЗаписи.ЕдиницаОбъема		= Источник.ЕдиницаОбъема;
		МенеджерЗаписи.ДлительностьПлан		= Источник.ДлительностьПлан;
		МенеджерЗаписи.ЕдиницаДлительности	= Источник.ЕдиницаДлительности;
		
		
		МенеджерЗаписи.Записать();
	
	
	Для Каждого СтрокаРесурс Из Источник.Ресурсы Цикл
		МенеджерЗаписи 	= РегистрыСведений.УСОERP_ПотребностьВРесурсах.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Работа			= Приемник.Ссылка;
		МенеджерЗаписи.ВидПланирования 	= Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный;	
		МенеджерЗаписи.ЗагрузкаПроцент  = СтрокаРесурс.Загрузка;
		МенеджерЗаписи.Период			= НачалоДня(ТекущаяДата());
		МенеджерЗаписи.АвторИзмерения   = Пользователи.ТекущийПользователь();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтрокаРесурс);
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Родитель") Тогда
		Родитель = Параметры.Родитель;
	КонецЕсли;	
	Если Параметры.Свойство("Сценарий") Тогда
		Сценарий = Параметры.Сценарий;
	КонецЕсли;	
КонецПроцедуры

#Область ПрочиеПроцедуры

Функция ПолучитьКоэффициентУпаковки(ТекУпаковка, КэшированныеЗначения)
	
	Если ЗначениеЗаполнено(ТекУпаковка) Тогда
		
		ТекКоэффициент = КэшированныеЗначения.КоэффициентыУпаковок[ТекУпаковка];
		
		Если ТекКоэффициент = Неопределено Тогда
			
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекУпаковка,"Знаменатель,Числитель,Объем,Вес");
			ТекКоэффициент = ?(ЗначенияРеквизитов.Знаменатель = 0 ИЛИ ЗначенияРеквизитов.Знаменатель = Неопределено,1,ЗначенияРеквизитов.Числитель/ЗначенияРеквизитов.Знаменатель);
			КэшированныеЗначения.КоэффициентыУпаковок.Вставить(ТекУпаковка, ТекКоэффициент);
			КэшированныеЗначения.КоэффициентыУпаковок.Вставить(ТекУпаковка, ЗначенияРеквизитов.Коэффициент);
			КэшированныеЗначения.ОбъемУпаковок.Вставить(ТекУпаковка, ЗначенияРеквизитов.Объем);
			КэшированныеЗначения.ВесУпаковок.Вставить(ТекУпаковка, ЗначенияРеквизитов.Вес);
			
		КонецЕсли;
		
	Иначе
		
		ТекКоэффициент = 1;
		
	КонецЕсли;
	
	Возврат ТекКоэффициент;
	
КонецФункции

#КонецОбласти
