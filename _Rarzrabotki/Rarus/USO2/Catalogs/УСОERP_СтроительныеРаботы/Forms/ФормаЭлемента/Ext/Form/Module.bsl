	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Работа", Объект.Ссылка);
	
	ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаИстория", ПараметрыФормы, ЭтаФорма);
	
