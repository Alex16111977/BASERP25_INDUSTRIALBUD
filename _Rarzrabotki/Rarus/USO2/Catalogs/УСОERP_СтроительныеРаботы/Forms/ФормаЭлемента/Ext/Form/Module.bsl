	ТекущаяСтрока.КоличествоУпаковокНаОбъемРаботы	= Окр(ТекущаяСтрока.КоличествоУпаковокНаЕдиницуОбъема * ОбъемРаботы, 3);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "НаЕдиницуОбъема");
