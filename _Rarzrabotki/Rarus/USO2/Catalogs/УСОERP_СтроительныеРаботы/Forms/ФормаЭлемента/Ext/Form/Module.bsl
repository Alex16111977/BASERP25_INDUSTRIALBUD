&НаКлиенте
Перем КэшированныеЗначения; 

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Объект.Владелец.НовыйВариант Тогда 		
		
		УстановитьУсловноеОформление();
		
		ВидПланирования 	= Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный;
		
		Если Параметры.Свойство("НаДату") Тогда
			ЕстьОтборНаДату = Истина;
			НаДату = Параметры.НаДату;
		Иначе
			НаДату = ПолучитьПоследнююДатуИзменения(Объект.Ссылка);
		КонецЕсли;
		
		ЕстьОтборНаДату = Истина; 
		
		Если Объект.Ссылка.Пустая() Тогда 
			
			Если ЗначениеЗаполнено(Параметры.СценарийПланирования) Тогда 
				Объект.Владелец 	= Параметры.СценарийПланирования;
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(Параметры.Родитель) Тогда 
				Объект.Родитель 	= Параметры.Родитель;
			КонецЕсли;	 
			
			Если ЗначениеЗаполнено(Объект.Владелец) Тогда 		
				РеквизитыСценарияПланирования 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Владелец,
				"Владелец, НачалоСтроительства, ОкончаниеСтроительства");			
				ОбъектСтроительства		= РеквизитыСценарияПланирования.Владелец;
				НачалоРаботыПлан 		= РеквизитыСценарияПланирования.НачалоСтроительства;
				
				Если ЗначениеЗаполнено(ОбъектСтроительства) Тогда 		
					РеквизитыОбъектаСтроительства	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектСтроительства,
					"ГрафикРаботы, ЕдиницаДлительности");
					
					Объект.ГрафикРаботы 	= РеквизитыОбъектаСтроительства.ГрафикРаботы;	
					ЕдиницаДлительности	= РеквизитыОбъектаСтроительства.ЕдиницаДлительности;				
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Объект.Родитель) Тогда 
				РеквизитыРодитель	= УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПараметрыВыполненияРаботы(Объект.Родитель, ВидПланирования, ?(ЕстьОтборНаДату, КонецДня(НаДату),ТекущаяДата()));
				НачалоРаботыПлан    = РеквизитыРодитель.НачалоРаботыПлан;
				Если ЗначениеЗаполнено(РеквизитыРодитель.ЕдиницаДлительности) Тогда 
					ЕдиницаДлительности = РеквизитыРодитель.ЕдиницаДлительности; 
				КонецЕсли;
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(Параметры.Предшественник) Тогда 
				НоваяСтрока = Предшественники.Добавить();
				НоваяСтрока.ОбъектСтроительстваПредшественника	= ОбъектСтроительства;
				НоваяСтрока.РаботаПредшественник 				= Параметры.Предшественник;
				НоваяСтрока.ТипЗависимости 						= Перечисления.УСОERP_ТипыЗависимостейРабот.ОкончаниеНачало;
			КонецЕсли;	
			
			Если Не ЗначениеЗаполнено(ЕдиницаДлительности) Тогда 
				ЕдиницаДлительности	= Перечисления.ЕдиницыИзмеренияВремени.День;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НачалоРаботыПлан) И ЗначениеЗаполнено(ДлительностьПлан) Тогда 
				ОкончаниеРаботыПлан = УСОERP_УправлениеСтроительнымПроизводством.РассчитатьОкончаниеПериода(Объект, НачалоРаботыПлан, ДлительностьПлан, ЕдиницаДлительности);
			КонецЕсли;	
			
		Иначе
			
			ПрочитатьТекущиеДанныеРаботы();
		КонецЕсли;				
		
		ГрафикРаботыОбъектаСтроительства	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектСтроительства, "ГрафикРаботы");
		ТекущийПользователь 				= Пользователи.ТекущийПользователь();
		ЕдиницыИзмеренияВремениЧас 			=  Перечисления.ЕдиницыИзмеренияВремени.Час;
		
		Если Параметры.ТекущаяЗакладкаПредшественники Тогда 
			
			
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПредшественники;		
		КонецЕсли;		
		
		Если Параметры.Свойство("ТекущаяСтраница")
			И ЗначениеЗаполнено(Параметры.ТекущаяСтраница) Тогда
			Если Параметры.ТекущаяСтраница = "Материалы" Тогда
				Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаМатериалы;
			ИначеЕсли Параметры.ТекущаяСтраница = "Ресурсы" Тогда
				Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаРесурсы;
			КонецЕсли;
		КонецЕсли;
		
		РодительСсылка = Объект.Ссылка.Родитель;
		
		// Обработчик подсистемы "ВерсионированиеОбъектов"
		ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
		
		СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
		
		Организация = Объект.Владелец.Организация;
		
	КонецЕсли;
	
	ЭтоНовыйВариант = Объект.Владелец.НовыйВариант;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПоследнююДатуИзменения(Работа)
	
	Если НЕ ЗначениеЗаполнено(Работа) Тогда
		
		Возврат НачалоДня(ТекущаяДата());
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Работа",Работа);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа,
		|	МАКСИМУМ(УСОERP_ПараметрыВыполненияРаботСрезПоследних.Период) КАК Период
		|ИЗ
		|	РегистрСведений.УСОERP_ПараметрыВыполненияРабот.СрезПоследних(
		|			,
		|			Работа = &Работа
		|				И Утверждена = ЛОЖЬ
		|				И ВидПланирования = ЗНАЧЕНИЕ(Перечисление.УСОERP_ВидыПланированияСтроительныхРабот.Календарный)) КАК УСОERP_ПараметрыВыполненияРаботСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	УСОERP_ПараметрыВыполненияРаботСрезПоследних.Работа";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			Возврат Выборка.Период;
			
		КонецЕсли;
		
	КонецЕсли;		
	
	Возврат НачалоДня(ТекущаяДата());
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЭтоНовыйВариант Тогда
		
		Отказ = Истина;
		
		Если ЭтотОбъект.ВладелецФормы <> Неопределено Тогда
			
			ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаЭлементаДинамическая",Новый Структура("Ключ",Объект.Ссылка),ЭтотОбъект.ВладелецФормы,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе
			
			ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаЭлементаДинамическая",Новый Структура("Ключ",Объект.Ссылка));
			
		КонецЕсли;
			
	Иначе
		
		РассчитатьИтоговыеПоказателиРесурсов(ЭтаФорма);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ПараметрыЗаписи.Вставить("ЭтоНовый", Объект.Ссылка.Пустая());
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ВидПланирования", 		ВидПланирования);
	СтруктураДанных.Вставить("НачалоРаботыПлан", 		НачалоРаботыПлан);
	СтруктураДанных.Вставить("ОкончаниеРаботыПлан", 	ОкончаниеРаботыПлан);
	СтруктураДанных.Вставить("ДлительностьПлан", 		ДлительностьПлан);
	СтруктураДанных.Вставить("ЕдиницаДлительности", 	ЕдиницаДлительности);
	СтруктураДанных.Вставить("ОбъемРаботы", 		    ОбъемРаботы);
	СтруктураДанных.Вставить("ЕдиницаОбъема", 	        ЕдиницаОбъема);
	СтруктураДанных.Вставить("АвторИзменения",        	ТекущийПользователь);
	СтруктураДанных.Вставить("Утверждена", 				Ложь);	
	
	УСОERP_УправлениеСтроительнымПроизводством.ЗаписатьПараметрыВыполненияРаботы(ТекущийОбъект.Ссылка, ВидПланирования, ?(ЕстьОтборНаДату, НачалоДня(НаДату),НачалоДня(ТекущаяДата())), СтруктураДанных);
	УСОERP_УправлениеСтроительнымПроизводством.ЗаписатьПотребностьВМатериалах(ТекущийОбъект.Ссылка, ВидПланирования, ?(ЕстьОтборНаДату, НачалоДня(НаДату),НачалоДня(ТекущаяДата())), Материалы.Выгрузить(), ТекущийПользователь);
	УСОERP_УправлениеСтроительнымПроизводством.ЗаписатьСвязиМеждуРаботами(ТекущийОбъект.Ссылка, ?(ЕстьОтборНаДату, НачалоДня(НаДату),НачалоДня(ТекущаяДата())), Предшественники.Выгрузить(), ТекущийПользователь);
	УСОERP_УправлениеСтроительнымПроизводством.ЗаписатьПотребностьВРесурсах(ТекущийОбъект.Ссылка, ВидПланирования, ?(ЕстьОтборНаДату, НачалоДня(НаДату),НачалоДня(ТекущаяДата())), Ресурсы.Выгрузить(), ТекущийПользователь);
	
КонецПроцедуры

&НаКлиенте
Процедура  ПослеЗаписи(ПараметрыЗаписи)
	
	ПараметрОповещения = Новый Структура;
	ПараметрОповещения.Вставить("СценарийПланирования",  Объект.Владелец);
	ПараметрОповещения.Вставить("Родитель",              Объект.Родитель);
	ПараметрОповещения.Вставить("Работа",                Объект.Ссылка);
	ПараметрОповещения.Вставить("МассивИзмененныхРабот", ПараметрыЗаписи.МассивИзмененныхРабот);
	
	Если ПараметрыЗаписи.ЭтоНовый Тогда 
		Оповестить("СозданаРабота",  ПараметрОповещения, ЭтаФорма);
	Иначе	
		Оповестить("ИзмененаРабота", ПараметрОповещения, ЭтаФорма);
	КонецЕсли;	
	
	МодификацияКонфигурацииКлиентПереопределяемый.ПослеЗаписи(ЭтаФорма, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЭтоНовыйОбъект = Не ЗначениеЗаполнено(ТекущийОбъект.Ссылка);
	ПараметрыЗаписи.Вставить("ЭтоНовыйОбъект", ЭтоНовыйОбъект);
	
	Если ЭтоНовыйОбъект ИЛИ НеобходимоПересчитатьКодСДР Тогда
		// получение кода СДР
		ДанныеКода = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДРИНомерРаботыВУровне(ТекущийОбъект.Владелец, ТекущийОбъект.Родитель);
		ТекущийОбъект.КодСДР             = ДанныеКода.КодСДР;
		ТекущийОбъект.НомерРаботыВУровне = ДанныеКода.НомерРаботыВУровне;
	КонецЕсли;
	
	ТекущийРодитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийОбъект.Ссылка, "Родитель");
	ПараметрыЗаписи.Вставить("ТекущийРодитель", ТекущийРодитель);
	
	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	РодительСсылка = Объект.Ссылка.Родитель;
	
	НеобходимоПересчитатьКодСДР	= Ложь;
	
	МассивИзмененныхРабот	= Новый Массив;
	МассивИзмененныхРабот.Добавить(ТекущийОбъект.Ссылка);
	
	Если ЗначениеЗаполнено(ПараметрыЗаписи.ТекущийРодитель) И ПараметрыЗаписи.ТекущийРодитель <> ТекущийОбъект.Родитель Тогда 
		УСОERP_УправлениеСтроительнымПроизводством.РассчитатьПланСценарияПланированияПроектовСтроительства(ПараметрыЗаписи.ТекущийРодитель, ВидПланирования, ?(ЕстьОтборНаДату, КонецДня(НаДату),ТекущаяДата()), МассивИзмененныхРабот);
	КонецЕсли;	
	УСОERP_УправлениеСтроительнымПроизводством.РассчитатьПланСценарияПланированияПроектовСтроительства(ТекущийОбъект.Ссылка, ВидПланирования, ?(ЕстьОтборНаДату, КонецДня(НаДату),ТекущаяДата()), МассивИзмененныхРабот);	
	
	ПараметрыЗаписи.Вставить("МассивИзмененныхРабот", МассивИзмененныхРабот);
	
	ПрочитатьТекущиеДанныеРаботы();
	
	МодификацияКонфигурацииПереопределяемый.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьТекущиеДанныеРаботы()
	
	Результат = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПараметрыВыполненияРаботы(Объект.Ссылка, ВидПланирования, ?(ЕстьОтборНаДату, КонецДня(НаДату),ТекущаяДата()));
	
	ОбъектСтроительства         = Результат.ОбъектСтроительства;
	НачалоРаботыПлан            = Результат.НачалоРаботыПлан;
	ОкончаниеРаботыПлан         = Результат.ОкончаниеРаботыПлан;
	ДлительностьПлан 			= Результат.ДлительностьПлан;
	ЕдиницаДлительности 		= Результат.ЕдиницаДлительности;
	ОбъемРаботы 				= Результат.ОбъемРаботы;
	ЕдиницаОбъема 				= Результат.ЕдиницаОбъема;
	
	Материалы.Загрузить(УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПотребностьВМатериалах(Объект.Ссылка, ВидПланирования, ?(ЕстьОтборНаДату, КонецДня(НаДату),ТекущаяДата())));
	Предшественники.Загрузить(УСОERP_УправлениеСтроительнымПроизводством.ПолучитьСвязиМеждуРаботами(Объект.Ссылка, ?(ЕстьОтборНаДату, КонецДня(НаДату),ТекущаяДата())));
	Ресурсы.Загрузить(УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПотребностьВРесурсах(Объект.Ссылка, ВидПланирования, ?(ЕстьОтборНаДату, КонецДня(НаДату),ТекущаяДата())));
	
	ПредшественникиКоличество 	= Предшественники.Количество();
	МатериалыКоличество			= Материалы.Количество();
	РесурсыКоличество			= Ресурсы.Количество();
	
КонецПроцедуры	

#КонецОбласти 

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ЭтапПриИзменении(Элемент)
	
	НеобходимоПересчитатьКодСДР	= РодительСсылка <> Объект.Родитель;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Объект.Родитель	= ВыбранноеЗначение;
	НеобходимоПересчитатьКодСДР = РодительСсылка <> Объект.Родитель;
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоРаботыПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(НачалоРаботыПлан) И НачалоРаботыПлан = НачалоДня(НачалоРаботыПлан) Тогда
		
		ГрафикРаботы		= ?(ЗначениеЗаполнено(Объект.ГрафикРаботы), Объект.ГрафикРаботы, ГрафикРаботыОбъектаСтроительства);
		
		НачалоРаботыПлан	= УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПервоеРабочееВремяДня(ГрафикРаботы, НачалоРаботыПлан);
		
	КонецЕсли;
	
	
	Если Не ЗначениеЗаполнено(НачалоРаботыПлан) Тогда 	
		
		ДлительностьПлан	= 0;
		
	ИначеЕсли ЗначениеЗаполнено(ОкончаниеРаботыПлан) Тогда 
		
		ДлительностьПлан	= УСОERP_УправлениеСтроительнымПроизводством.РассчитатьДлительностьПериода(Объект, 
		НачалоРаботыПлан, 
		ОкончаниеРаботыПлан, 
		ЕдиницаДлительности);
		
	ИначеЕсли ЗначениеЗаполнено(ДлительностьПлан) Тогда 	
		
		ОкончаниеРаботыПлан	= УСОERP_УправлениеСтроительнымПроизводством.РассчитатьОкончаниеПериода(Объект, 
		НачалоРаботыПлан, 
		ДлительностьПлан, 
		ЕдиницаДлительности);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеРаботыПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ОкончаниеРаботыПлан) И ОкончаниеРаботыПлан = НачалоДня(ОкончаниеРаботыПлан) Тогда
		
		ГрафикРаботы	= ?(ЗначениеЗаполнено(Объект.ГрафикРаботы), Объект.ГрафикРаботы, ГрафикРаботыОбъектаСтроительства);
		
		ОкончаниеРаботыПлан = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПоследнееРабочееВремяДня(ГрафикРаботы, ОкончаниеРаботыПлан);
		
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ОкончаниеРаботыПлан) Тогда 
		
		ДлительностьПлан = 0;	
		
	ИначеЕсли ЗначениеЗаполнено(НачалоРаботыПлан) Тогда 	
		
		ДлительностьПлан = УСОERP_УправлениеСтроительнымПроизводством.РассчитатьДлительностьПериода(Объект, 
		НачалоРаботыПлан, 
		ОкончаниеРаботыПлан, 
		ЕдиницаДлительности);
		
	ИначеЕсли ЗначениеЗаполнено(ДлительностьПлан) Тогда 
		
		НачалоРаботыПлан = УСОERP_УправлениеСтроительнымПроизводством.РассчитатьНачалоПериода(Объект, 
		ОкончаниеРаботыПлан, 
		ДлительностьПлан, 
		ЕдиницаДлительности);	
		
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура ДлительностьПриИзменении(Элемент, ПересчитыватьРесурсы = Истина)
	
	Если ЗначениеЗаполнено(НачалоРаботыПлан) Тогда 
		ОкончаниеРаботыПлан	= УСОERP_УправлениеСтроительнымПроизводством.РассчитатьОкончаниеПериода(Объект, НачалоРаботыПлан, ДлительностьПлан, ЕдиницаДлительности);		
	ИначеЕсли ЗначениеЗаполнено(ОкончаниеРаботыПлан) Тогда 		
		НачалоРаботыПлан    = УСОERP_УправлениеСтроительнымПроизводством.РассчитатьНачалоПериода(Объект, ОкончаниеРаботыПлан, ДлительностьПлан, ЕдиницаДлительности);
	КонецЕсли;
	
	Если ПересчитыватьРесурсы Тогда
		
		Для Каждого СтрокиРесурсы Из Ресурсы Цикл 
			ПересчитатьТрудоемкостьМашиноемкостьНаКлиенте(СтрокиРесурсы);	
		КонецЦикла;
		
	КонецЕсли; 
	
КонецПроцедуры


&НаКлиенте
Процедура ЕдиницаДлительностиПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(НачалоРаботыПлан) Тогда 
		ОкончаниеРаботыПлан	= УСОERP_УправлениеСтроительнымПроизводством.РассчитатьОкончаниеПериода(Объект, НачалоРаботыПлан, ДлительностьПлан, ЕдиницаДлительности);
	ИначеЕсли ЗначениеЗаполнено(ОкончаниеРаботыПлан) Тогда 		
		НачалоРаботыПлан    = УСОERP_УправлениеСтроительнымПроизводством.РассчитатьНачалоПериода(Объект, ОкончаниеРаботыПлан, ДлительностьПлан, ЕдиницаДлительности);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
