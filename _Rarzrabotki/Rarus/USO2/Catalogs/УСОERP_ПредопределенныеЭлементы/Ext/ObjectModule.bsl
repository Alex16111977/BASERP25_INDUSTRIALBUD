#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Список Тогда
		ПроверяемыеРеквизиты.Добавить("СписокЗначений");
	Иначе
		ПроверяемыеРеквизиты.Добавить("Значение");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если Список И СписокЗначений.Количество() = 1 Тогда
		Список = Ложь;
		Значение = СписокЗначений.Получить(0).Значение;
		СписокЗначений.Очистить();
	КонецЕсли;
	
	Если НЕ Список Тогда
		СписокЗначений.Очистить();
	КонецЕсли;
	
	Если СписокЗначений.Количество() Тогда
		Значение = "";
	КонецЕсли;	
	
	СписокЗначенийСтрокой = Строка(Значение);
	
	Для Каждого СтрокаТЧ ИЗ СписокЗначений Цикл
		СписокЗначенийСтрокой = ""+СписокЗначенийСтрокой+""+СокрЛП(СтрокаТЧ.Значение)+";";
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли

