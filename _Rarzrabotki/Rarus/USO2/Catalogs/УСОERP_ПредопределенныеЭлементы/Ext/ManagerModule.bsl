Функция ПолучитьТипПредопределенногоЭлемента(ПредопределенныйЭлемент) Экспорт 
	
	СтруктураВозврата = Новый Структура("Тип,Список",Неопределено,Истина);
	
	Если НЕ ПредопределенныйЭлемент.Предопределенный Тогда
		Возврат СтруктураВозврата;
	КонецЕсли;  
	
	ИмяПредопределенных = ПредопределенныйЭлемент.ИмяПредопределенныхДанных;
	
	Если ИмяПредопределенных = "СчетУчетаЗатратПоВыполнениюСтроительныхРабот" Тогда
		СтруктураВозврата.Тип =  Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный");
		СтруктураВозврата.Список = Ложь;
	КонецЕсли;
	
	Если ИмяПредопределенных = "СчетУчетаОбъектовНедвижимости" Тогда
		СтруктураВозврата.Тип = Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный");
		СтруктураВозврата.Список = Ложь;
	КонецЕсли;
	
	Если ИмяПредопределенных = "СчетУчетаОбъектовНедвижимостиЗабаланс" Тогда
		СтруктураВозврата.Тип = Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный");
	КонецЕсли;
	
	Если ИмяПредопределенных = "СчетУчетаРасчетовПоЦелевомуФинансированию" Тогда
		СтруктураВозврата.Тип = Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный");
	КонецЕсли;
	
	Если ИмяПредопределенных ="СчетаРасчетовСДольщиками" Тогда
		СтруктураВозврата.Тип = Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный");
	КонецЕсли;
	
	Если ИмяПредопределенных ="СчетУчетаЗатратПоВыполнениюФункцийЗаказчикаЗастройщика" Тогда
		СтруктураВозврата.Тип = Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный");
		СтруктураВозврата.Список = Ложь;
	КонецЕсли; 
	
	Если ИмяПредопределенных ="ОтражениеНепредъявленнойВыручки" Тогда
		СтруктураВозврата.Тип = Новый ОписаниеТипов("СправочникСсылка.ГруппыФинансовогоУчетаНоменклатуры");
		СтруктураВозврата.Список = Ложь;
	КонецЕсли; 
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПолучитьМассивЗначенийПредопределенныхЭлементов(МассивЭлементов) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МассивЭлементов",МассивЭлементов);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Значение
	|ИЗ
	|	(ВЫБРАТЬ
	|		УСОERP_ПредопределенныеЭлементы.Значение КАК Значение
	|	ИЗ
	|		Справочник.УСОERP_ПредопределенныеЭлементы КАК УСОERP_ПредопределенныеЭлементы
	|	ГДЕ
	|		УСОERP_ПредопределенныеЭлементы.Ссылка В(&МассивЭлементов)
	|		И НЕ УСОERP_ПредопределенныеЭлементы.Список
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		УСОERP_ПредопределенныеЭлементыСписокЗначений.Значение
	|	ИЗ
	|		Справочник.УСОERP_ПредопределенныеЭлементы.СписокЗначений КАК УСОERP_ПредопределенныеЭлементыСписокЗначений
	|	ГДЕ
	|		УСОERP_ПредопределенныеЭлементыСписокЗначений.Ссылка В(&МассивЭлементов)
	|		И УСОERP_ПредопределенныеЭлементыСписокЗначений.Ссылка.Список) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Значение";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Значение");	
	
КонецФункции

