#Область ОбработчикиКомандФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Отказ = Истина;
	КонецЕсли;
		
	УстановитьВидимость();
	
	СписокДоИзменения = Объект.Список;
	
	СтруктураТипа = Справочники.УСОERP_ПредопределенныеЭлементы.ПолучитьТипПредопределенногоЭлемента(Объект.Ссылка);
	Элементы.Список.Видимость =  СтруктураТипа.Список;
	
	Если СтруктураТипа.Тип <> Неопределено Тогда
		
		Элементы.Значение.ВыбиратьТип = Ложь;
		Элементы.Значение.ДоступныеТипы = СтруктураТипа.Тип;
		Элементы.Значение.ОграничениеТипа = СтруктураТипа.Тип;  	
				
		Элементы.СписокЗначенийЗначение.ВыбиратьТип = Ложь;
		Элементы.СписокЗначенийЗначение.ДоступныеТипы = СтруктураТипа.Тип;
		Элементы.СписокЗначенийЗначение.ОграничениеТипа = СтруктураТипа.Тип;
		Элементы.Значение.КнопкаВыбора = Истина;
		Элементы.СписокЗначенийЗначение.КнопкаВыбора = Истина;
		
		Если СтруктураТипа.Тип = Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный") Тогда
			
			НовыйПараметр = Новый ПараметрВыбора("Отбор.ЗапретитьИспользоватьВПроводках", Ложь);
			НовыйМассив = Новый Массив();
			НовыйМассив.Добавить(НовыйПараметр);
			НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);			
			Элементы.Значение.ПараметрыВыбора = НовыеПараметры;
			Элементы.СписокЗначенийЗначение.ПараметрыВыбора = НовыеПараметры;
			
		КонецЕсли; 
		
	КонецЕсли; 	
		
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()
	Элементы.СписокЗначений.Видимость = Объект.Список;
	Элементы.Значение.Видимость = НЕ Объект.Список;
КонецПроцедуры

&НаКлиенте
Процедура СписокПриИзменении(Элемент)
	
	УстановитьВидимость();
	
			
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораНоменклатурнойГруппыДляЗаполненияЗначения(ВыбранноеЗначение, Параметр2) Экспорт
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Объект.Значение = ВыбранноеЗначение;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
