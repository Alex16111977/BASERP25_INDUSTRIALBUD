&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НЕ ЗавершениеРаботы Тогда
		
		Строки = БазовыеЦены.НайтиСтроки(Новый Структура("Редактировать",Истина));
		
		Если Строки.Количество() Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗакрытиемПродолжение",ЭтотОбъект);
			
			Отказ = Истина;
			ПоказатьВопрос(ОписаниеОповещения,"Цены были изменены, закрыть без сохранения?",РежимДиалогаВопрос.ДаНет); 			
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте 
Процедура ПередЗакрытиемПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Строки = БазовыеЦены.НайтиСтроки(Новый Структура("Редактировать",Истина));
	Для Каждого НайденнаяСтрока ИЗ Строки Цикл
		НайденнаяСтрока.Редактировать = Ложь;
	КонецЦикла;
	
	Закрыть();
	
КонецПроцедуры


