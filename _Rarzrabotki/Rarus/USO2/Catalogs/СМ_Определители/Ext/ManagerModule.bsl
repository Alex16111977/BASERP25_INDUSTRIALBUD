
#Область СлужебныеПроцедурыИФункции

// Пытается найти определитель но типу нормативного сборника.
//
// Параметры:
//		ТипНормативногоСборника - ПеречислениеСсылка.ТипыНормативныхСборников.
//
// Возвращаемое значение:
//		ТекСсылка - СправочникСсылка.СМ_Определители, Неопределено - 
//					ссылка на определитель, Неопределено - если неоднозначно.
//
Функция НайтиПоТипуНормативногоСборника(ТипНормативногоСборника) Экспорт
	
	Если ТипНормативногоСборника = Перечисления.СМ_ТипыНормативныхСборников.ПустаяСсылка() Тогда
		Возврат Неопределено;
	ИначеЕсли ТипНормативногоСборника = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы Тогда
		Возврат Справочники.СМ_Определители.НайтиПоКоду("19");
	ИначеЕсли ТипНормативногоСборника = Перечисления.СМ_ТипыНормативныхСборников.МонтажныеРаботы Тогда
		Возврат Справочники.СМ_Определители.НайтиПоКоду("6");
	ИначеЕсли ТипНормативногоСборника = Перечисления.СМ_ТипыНормативныхСборников.Перебазировка Тогда
		Возврат Справочники.СМ_Определители.НайтиПоКоду("17");
	ИначеЕсли ТипНормативногоСборника = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы Тогда
		Возврат Справочники.СМ_Определители.НайтиПоКоду("1");
	ИначеЕсли ТипНормативногоСборника = Перечисления.СМ_ТипыНормативныхСборников.РемонтноСтроительныеРаботы Тогда
		Возврат Справочники.СМ_Определители.НайтиПоКоду("1");
	ИначеЕсли ТипНормативногоСборника = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин Тогда
		Возврат Справочники.СМ_Определители.НайтиПоКоду("1");
	ИначеЕсли ТипНормативногоСборника = Перечисления.СМ_ТипыНормативныхСборников.Транспортировка Тогда
		Возврат Справочники.СМ_Определители.НайтиПоКоду("17");
	ИначеЕсли ТипНормативногоСборника = Перечисления.СМ_ТипыНормативныхСборников.ЦеныНаМестныеМатериалы Тогда
		Возврат Справочники.СМ_Определители.НайтиПоКоду("11");
	Иначе
		Возврат Справочники.СМ_Определители.НайтиПоКоду("0");
	КонецЕсли;         
	
КонецФункции

#КонецОбласти