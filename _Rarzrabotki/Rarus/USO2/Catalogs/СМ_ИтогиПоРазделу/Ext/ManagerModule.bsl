#Область СлужебныеПроцедурыИФункции

// Функция возвращает максимальное значение реквизита ПорядковыйНомер в справочнике.
//
// Параметры:
//     Нет.
//
// Возвращаемое значение:
//     Число - максимальный порядковый номер.
//
Функция ПолучитьМаксимальныйНомерПоПорядку() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ИтогиПоРазделу.ПорядковыйНомер КАК ПорядковыйНомер
	               |ИЗ
	               |	Справочник.СМ_ИтогиПоРазделу КАК ИтогиПоРазделу
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПорядковыйНомер УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПорядковыйНомер;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

// Процедура присваивает всем элементам справочника порядковые номера согласно кодам (перенумерация всех элементов).
//
// Параметры:
//     Нет.
//
Процедура УстановитьПорНомПоУмолч() Экспорт 
	
	НаборСправ = Справочники.СМ_ИтогиПоРазделу.Выбрать();
	Пока НаборСправ.Следующий() Цикл
		ОбъектСпр = НаборСправ.ПолучитьОбъект();
		ОбъектСпр.ПорядковыйНомер = ОбъектСпр.Код;
		ОбъектСпр.Записать();
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти