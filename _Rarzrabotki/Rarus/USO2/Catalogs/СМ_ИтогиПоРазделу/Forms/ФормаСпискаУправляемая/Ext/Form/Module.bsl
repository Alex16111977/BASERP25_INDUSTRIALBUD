#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПолучитьПорядковыйНомер()
	
	ПорядковыйНомер = 0;
	Если Не Элементы.Список.ТекущиеДанные.Свойство("ПорядковыйНомер", ПорядковыйНомер) Тогда
		// вызов сервера
		ПорядковыйНомер = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Элементы.Список.ТекущаяСтрока, "ПорядковыйНомер");
	КонецЕсли;
	Возврат ПорядковыйНомер;
	
КонецФункции

&НаКлиенте
Процедура Вверх(Команда)
	ПорядковыйНомер = ПолучитьПорядковыйНомер();	
	СМ_СметаКлиент.ВверхВнизСправочник("СМ_ИтогиПоРазделу", ПорядковыйНомер, ПорядковыйНомер - 1, "ПорядковыйНомер", Элементы.Список.ТекущийРодитель);
	Элементы.Список.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура Вниз(Команда)
	ПорядковыйНомер = ПолучитьПорядковыйНомер();
	СМ_СметаКлиент.ВверхВнизСправочник("СМ_ИтогиПоРазделу", ПорядковыйНомер + 1, ПорядковыйНомер, "ПорядковыйНомер", Элементы.Список.ТекущийРодитель);
	Элементы.Список.Обновить();
КонецПроцедуры

#КонецОбласти