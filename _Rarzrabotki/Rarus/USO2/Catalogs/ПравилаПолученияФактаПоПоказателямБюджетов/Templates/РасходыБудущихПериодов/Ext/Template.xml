		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СтатьиРасходов.Ссылка
ПОМЕСТИТЬ СтатьиРасходов
ИЗ
	ПланВидовХарактеристик.СтатьиРасходов КАК СтатьиРасходов
ГДЕ
	СтатьиРасходов.ВариантРаспределенияРасходовУпр = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаРасходыБудущихПериодов)
{ГДЕ
	СтатьиРасходов.Ссылка.* КАК СтатьяРасходов}

ИНДЕКСИРОВАТЬ ПО
	СтатьиРасходов.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
// Независимость от состояния функциональной опции
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.РасходыБудущихПериодов) КАК ИсточникДанных,
	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
	ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка) КАК Подразделение,
	НЕОПРЕДЕЛЕНО КАК НаправлениеДеятельности,
	НЕОПРЕДЕЛЕНО КАК СтатьяРасходов,
	НЕОПРЕДЕЛЕНО КАК АналитикаРасходов,
	0 КАК СуммаУпр
{ВЫБРАТЬ
	ИсточникДанных,
	Организация.*,
	Подразделение.*,
	НаправлениеДеятельности.*,
	СтатьяРасходов.*,
	АналитикаРасходов.*,
	СуммаУпр}
ГДЕ
	ЛОЖЬ

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.РасходыБудущихПериодов) КАК ИсточникДанных,
	РасходыБудущихПериодов.Организация КАК Организация,
	РасходыБудущихПериодов.Подразделение КАК Подразделение,
	РасходыБудущихПериодов.НаправлениеДеятельности КАК НаправлениеДеятельности,
	РасходыБудущихПериодов.СтатьяРасходов КАК СтатьяРасходов,
	РасходыБудущихПериодов.АналитикаРасходов КАК АналитикаРасходов,
	РасходыБудущихПериодов.СуммаОстаток КАК СуммаУпр
ИЗ
	РегистрНакопления.ПрочиеРасходы.Остатки(
			&amp;ПериодГраница,
			&amp;ПривилегированныйРежимИсточника = &amp;ПривилегированныйРежим
				И СтатьяРасходов В
					(ВЫБРАТЬ
						СтатьиРасходов.Ссылка
					ИЗ
						СтатьиРасходов КАК СтатьиРасходов) {("ИдентификаторИсточникаДанных") КАК ИдентификаторИсточникаДанных, (ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.РасходыБудущихПериодов)) КАК ИсточникДанных, (АналитикаРасходов).*, (НаправлениеДеятельности).*, (Организация).*, (Подразделение).*, (СтатьяРасходов).*}) КАК РасходыБудущихПериодов</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
