		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	АналитикаУчетаПоПартнерам.КлючАналитики,
	АналитикаУчетаПоПартнерам.Партнер,
	АналитикаУчетаПоПартнерам.Контрагент,
	АналитикаУчетаПоПартнерам.Организация,
	АналитикаУчетаПоПартнерам.Договор,
	АналитикаУчетаПоПартнерам.НаправлениеДеятельности
ПОМЕСТИТЬ АналитикиУчетаПоПартнерам
ИЗ
	РегистрСведений.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам
ГДЕ
	АналитикаУчетаПоПартнерам.Партнер &lt;&gt; ЗНАЧЕНИЕ(Справочник.Партнеры.НашеПредприятие)
{ГДЕ
	АналитикаУчетаПоПартнерам.Партнер.* КАК Партнер,
	АналитикаУчетаПоПартнерам.Контрагент.* КАК Контрагент,
	АналитикаУчетаПоПартнерам.Организация.* КАК Организация,
	АналитикаУчетаПоПартнерам.Договор.* КАК Договор,
	АналитикаУчетаПоПартнерам.НаправлениеДеятельности.* КАК НаправлениеДеятельности}

ИНДЕКСИРОВАТЬ ПО
	АналитикаУчетаПоПартнерам.КлючАналитики
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.РезервыПоСомнительнымДолгам) КАК ИсточникДанных,
	РезервыПоСомнительнымДолгам.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам,
	РезервыПоСомнительнымДолгам.АналитикаУчетаПоПартнерам.Договор КАК Договор,
	РезервыПоСомнительнымДолгам.АналитикаУчетаПоПартнерам.Контрагент КАК Контрагент,
	РезервыПоСомнительнымДолгам.АналитикаУчетаПоПартнерам.НаправлениеДеятельности КАК НаправлениеДеятельности,
	РезервыПоСомнительнымДолгам.АналитикаУчетаПоПартнерам.Организация КАК Организация,
	РезервыПоСомнительнымДолгам.АналитикаУчетаПоПартнерам.Партнер КАК Партнер,
	РезервыПоСомнительнымДолгам.Валюта КАК Валюта,
	РезервыПоСомнительнымДолгам.ОбъектРасчетов КАК ОбъектРасчетов,
	РезервыПоСомнительнымДолгам.ОбъектРасчетов.Подразделение КАК Подразделение,
	РезервыПоСомнительнымДолгам.РасчетныйДокумент КАК РасчетныйДокумент,
	РезервыПоСомнительнымДолгам.СуммаОстаток КАК СуммаВВалюте,
	РезервыПоСомнительнымДолгам.СуммаУпрОстаток КАК СуммаУпр,
	РезервыПоСомнительнымДолгам.СуммаРеглОстаток КАК СуммаРегл
{ВЫБРАТЬ
	ИсточникДанных,
	АналитикаУчетаПоПартнерам.*,
	Договор.*,
	Контрагент.*,
	НаправлениеДеятельности.*,
	Организация.*,
	Партнер.*,
	Валюта.*,
	ОбъектРасчетов.*,
	Подразделение.*,
	РасчетныйДокумент.*,
	СуммаВВалюте,
	СуммаУпр,
	СуммаРегл}
ИЗ
	РегистрНакопления.РезервыПоСомнительнымДолгам.Остатки(
			&amp;ПериодГраница,
			&amp;ПривилегированныйРежимИсточника = &amp;ПривилегированныйРежим
				И АналитикаУчетаПоПартнерам.Партнер &lt;&gt; ЗНАЧЕНИЕ(Справочник.Партнеры.НашеПредприятие)
			 {("ИдентификаторИсточникаДанных") КАК ИдентификаторИсточникаДанных, (ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.РезервыПоСомнительнымДолгам)) КАК ИсточникДанных, (Валюта).* КАК Валюта, (ОбъектРасчетов).* КАК ОбъектРасчетов, (ОбъектРасчетов.Подразделение).* КАК Подразделение, (АналитикаУчетаПоПартнерам.Партнер).* КАК Партнер, (АналитикаУчетаПоПартнерам.Организация).* КАК Организация, (АналитикаУчетаПоПартнерам.Контрагент).* КАК Контрагент, (АналитикаУчетаПоПартнерам.Договор).* КАК Договор, (АналитикаУчетаПоПартнерам.НаправлениеДеятельности).* КАК НаправлениеДеятельности}
			 			) КАК РезервыПоСомнительнымДолгам
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ АналитикиУчетаПоПартнерам КАК АналитикиУчетаПоПартнерам
		ПО РезервыПоСомнительнымДолгам.АналитикаУчетаПоПартнерам = АналитикиУчетаПоПартнерам.КлючАналитики
</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
