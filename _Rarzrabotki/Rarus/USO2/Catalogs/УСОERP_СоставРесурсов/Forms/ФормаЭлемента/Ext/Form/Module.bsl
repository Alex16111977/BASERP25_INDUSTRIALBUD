#Область ОбработчикиКомандФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	Если Параметры.Ключ.Пустая() И ЗначениеЗаполнено(Объект.Ресурс) Тогда
		ЗаполнитьСоставИзРесурса();
	КонецЕсли;
	
	СобытияФорм.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура РесурсПриИзменении(Элемент)
	ЗаполнитьСоставИзРесурса();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСоставИзРесурса()
	
	Объект.Рабочие.Очистить();
	Объект.Механизмы.Очистить();
	
	РабочиеРесурса = Объект.Ресурс.Рабочие.Выгрузить();
	МеханизмыРесурса = Объект.Ресурс.Механизмы.Выгрузить();
	
	Для Каждого СтрРесурса Из РабочиеРесурса Цикл
		Если НЕ СтрРесурса.Количество = 0 Тогда
			Для к = 1 по СтрРесурса.Количество Цикл
				НоваяСтрока = Объект.Рабочие.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрРесурса);  
			КонецЦикла;
		КонецЕсли;  		
	КонецЦикла;
	
	Для Каждого СтрРесурса Из МеханизмыРесурса Цикл
		Если НЕ СтрРесурса.Количество = 0 Тогда
			Для к = 1 по СтрРесурса.Количество Цикл
				НоваяСтрока = Объект.Механизмы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрРесурса);  
			КонецЦикла;
		КонецЕсли;  		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
