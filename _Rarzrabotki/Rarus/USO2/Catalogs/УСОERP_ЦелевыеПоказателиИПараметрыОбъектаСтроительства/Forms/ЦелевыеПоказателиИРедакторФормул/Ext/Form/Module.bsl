&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	РазделыОператоров = Операторы.ПолучитьЭлементы();
	Если РазделыОператоров.Количество() > 0 Тогда
		Элементы.Операторы.Развернуть(РазделыОператоров[0].ПолучитьИдентификатор());
	КонецЕсли;
	
	Элементы.ФормаЗавершитьРедактирование.Видимость = Ложь;
	Элементы.ГруппаРедактированиеФормулы.Видимость	= Ложь;
	
	Если ЭтоПредопределенныйЭлемент() Тогда
		Элементы.РедактироватьФормулу.Доступность				= Ложь;
		Элементы.ВидПоказателя.Доступность						= Ложь;
		Элементы.СпособРасчетаЦелевыхПоказателей.Доступность	= Ложь;
	Иначе	
		Элементы.РедактироватьФормулу.Доступность				= Истина;
		Элементы.ВидПоказателя.Доступность						= Истина;
		Элементы.СпособРасчетаЦелевыхПоказателей.Доступность	= Истина;
	КонецЕсли;
	
КонецПроцедуры

