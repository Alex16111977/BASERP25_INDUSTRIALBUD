			ПараметрыОткрытия = Новый Структура("ВСоставе", Ссылка);
			ОткрытьФорму("РегистрСведений.уатСоставТС.ФормаЗаписи", ПараметрыОткрытия, ЭтотОбъект,,,, Неопределено, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
