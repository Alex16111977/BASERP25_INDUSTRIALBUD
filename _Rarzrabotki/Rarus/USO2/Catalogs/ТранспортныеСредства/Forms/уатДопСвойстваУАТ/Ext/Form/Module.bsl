&НаКлиенте
Процедура АгрегатыТССоздать(Команда)
	
	Если Не ЗначениеЗаполнено(ОбъектЭксплуатации) Тогда 
		ТекстОшибки = НСтр("ru = 'Перед созданием агрегата необходимо указать объект эксплуатации.';en='NTRS'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "ОбъектЭксплуатации");
		Возврат;
	КонецЕсли;
	
	ЗначенияЗаполнения = Новый Структура("Владелец", ОбъектЭксплуатации);
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	Оповещение = Новый ОписаниеОповещения("Подключаемый_ПослеСозданияАгрегата", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.УзлыОбъектовЭксплуатации.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект,,,, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура АгрегатыТСУстановить(Команда)
	
	ТекущиеДанные = Элементы.АгрегатыТС.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Состояние = ПредопределенноеЗначение("Перечисление.уатСостоянияАгрегатов.УстановленоВРаботе") Тогда 
		ТекстОшибки = НСтр("ru = 'Выбранный агрегат уже установлен в работе.';en='NTRS'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "АгрегатыТС");
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Состояние = ПредопределенноеЗначение("Перечисление.уатСостоянияАгрегатов.УстановленоВЗапас") Тогда 
		ТекстОшибки = НСтр("ru = 'Выбранный агрегат уже установлен в запас.';en='NTRS'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "АгрегатыТС");
		Возврат;
	КонецЕсли;
	
	ЗначенияЗаполнения = Новый Структура();
	ЗначенияЗаполнения.Вставить("Период",                  ТекущаяДата());
	ЗначенияЗаполнения.Вставить("УзелОбъектаЭксплуатации", ТекущиеДанные.УзелОбъектаЭксплуатации);
	ЗначенияЗаполнения.Вставить("ТипАгрегата",             ТекущиеДанные.ТипАгрегата);
	ЗначенияЗаполнения.Вставить("ТранспортноеСредство",    Ссылка);
	ЗначенияЗаполнения.Вставить("СостояниеАгрегата",       ПредопределенноеЗначение("Перечисление.уатСостоянияАгрегатов.УстановленоВРаботе"));
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	Оповещение = Новый ОписаниеОповещения("Подключаемый_ПослеУстановкиАгрегата", ЭтотОбъект);
	
	ОткрытьФорму("РегистрСведений.уатУстановленныеАгрегаты.ФормаЗаписи", ПараметрыФормы, ЭтотОбъект,,,, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура АгрегатыТССнять(Команда)
	
	ТекущиеДанные = Элементы.АгрегатыТС.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если Не (ТекущиеДанные.Состояние = ПредопределенноеЗначение("Перечисление.уатСостоянияАгрегатов.УстановленоВРаботе") 
			Или ТекущиеДанные.Состояние = ПредопределенноеЗначение("Перечисление.уатСостоянияАгрегатов.УстановленоВЗапас")) Тогда 
		ТекстОшибки = НСтр("ru = 'Снятие агрегата невозможно. Агрегат не установлен.';en='NTRS'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "АгрегатыТС");
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура();
	ДопПараметры.Вставить("УзелОбъектаЭксплуатации", ТекущиеДанные.УзелОбъектаЭксплуатации);
	ДопПараметры.Вставить("ТипАгрегата",             ТекущиеДанные.ТипАгрегата);
	ДопПараметры.Вставить("ТранспортноеСредство",    Ссылка);
	
	ТекстВопроса = НСтр("ru = 'Выполнить снятие агрегата?';en='NTRS'");
	Оповещение = Новый ОписаниеОповещения("Подключаемый_СнятиеАгрегатаОтвет", ЭтотОбъект, ДопПараметры);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

