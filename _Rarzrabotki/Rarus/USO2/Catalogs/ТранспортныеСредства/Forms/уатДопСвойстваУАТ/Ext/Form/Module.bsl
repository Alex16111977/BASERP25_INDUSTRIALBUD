&НаКлиенте
Процедура ИспользоватьДанныеCANшиныОдометрПриИзменении(Элемент)
	
	Если НЕ ИспользоватьДанныеCANшиныОдометр Тогда
		Возврат;
	КонецЕсли;
	
	Если ИспользуемаяСистемаGPS = ПредопределенноеЗначение("Перечисление.уатСистемаGPS.Omnicomm") Тогда
		ТекстОшибки = "";
		// Должна быть разница во времени не менее 15 минут
		ДатаЗапроса = ТекущаяДата()-900;
		Одометр = уатЗащищенныеФункцииСервер_проф.Omnicomm_ПолучитьОдометрТС(ДатаЗапроса,, ИДвСистемеНавигации, Подразделение, ТекстОшибки,,УчетнаяЗаписьСистемыМониторинга);
		Если Одометр <> Неопределено И НЕ ЗначениеЗаполнено(ТекстОшибки) Тогда
			Режим   = РежимДиалогаВопрос.ДаНет;
			
			Если Одометр.totalVehicleDistance = 0 ИЛИ Одометр.totalVehicleDistance = Неопределено Тогда
				Одометр = "0";
			Иначе
				Одометр = Одометр.totalVehicleDistance;
			КонецЕсли;
			
			ТекстНСТР = СтрШаблон(НСтр("en = 'Current odometer reading = %1 km?'; ru = 'Текущее значение одометра = %1 км ?'"), Одометр);
			ПоказатьВопрос(Новый ОписаниеОповещения("ИспользоватьДанныеCANшиныОдометрПриИзмененииЗавершение", ЭтотОбъект), ТекстНСТР, Режим);
		Иначе
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
		КонецЕсли;
	Иначе
		НаименованиеДействия = "Справочник.уатТС.Форма.ФормаЭлемента.ИспользоватьДанныеCANшиныОдометрПриИзменении";
		уатРаботаСРасширениямиКлиент.ПСМ_ВыполнитьДействияВФорме(НаименованиеДействия, ИспользуемаяСистемаGPS,, ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

