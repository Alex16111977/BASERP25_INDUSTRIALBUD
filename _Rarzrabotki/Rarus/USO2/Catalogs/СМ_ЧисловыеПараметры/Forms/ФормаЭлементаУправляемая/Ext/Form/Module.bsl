
#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	Если Объект.Ссылка = Справочники.СМ_ЧисловыеПараметры.ПустаяСсылка() Тогда
		Объект.Код = 0;
		Объект.Идентификатор = "";
		Объект.ПорядокРасчета = Справочники.СМ_ЧисловыеПараметры.ПолучитьМаксимальныйПорядокРасчета() + 1;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьОтображение();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображение()
	
	ИспользованиеИтогов.Параметры.УстановитьЗначениеПараметра("ЧисловойПараметр", Объект.Ссылка);
	Элементы.ИспользованиеИтогов.Доступность = НЕ Объект.Ссылка.Пустая();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОбновитьОтображение(); 
	
КонецПроцедуры

#КонецОбласти