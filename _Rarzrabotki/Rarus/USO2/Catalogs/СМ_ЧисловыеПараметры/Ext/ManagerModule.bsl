#Область СлужебныеПроцедурыИФункции

// Функция возвращает максимальное значение реквизита ПорядокРасчета в справочнике.
//
// Параметры:
//     Нет.
//
// Возвращаемое значение:
//     Число - максимальное значение порядка расчета.
//
Функция ПолучитьМаксимальныйПорядокРасчета() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЧисловыеПараметры.ПорядокРасчета КАК ПорядокРасчета
	               |ИЗ
	               |	Справочник.СМ_ЧисловыеПараметры КАК ЧисловыеПараметры
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПорядокРасчета УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПорядокРасчета;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

#КонецОбласти