#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	Если Объект.Ссылка.Пустая() Тогда
		Объект.ТипНормативногоСборника = Объект.Родитель.ТипНормативногоСборника;
		Объект.ВидРаботДляНачисленияНРиСП = Объект.Родитель.ВидРаботДляНачисленияНРиСП;
	КонецЕсли;		
КонецПроцедуры

&НаКлиенте
Процедура НормативыПриИзменении(Элемент)
	ТекДанные = Элементы.Нормативы.ТекущиеДанные;
	НайденныеСтроки = Объект.Нормативы.НайтиСтроки(Новый Структура("ТипРайона",ТекДанные.ТипРайона));
	Если НайденныеСтроки.Количество() > 1 Тогда
		Объект.Нормативы.Удалить(Объект.Нормативы.Индекс(ТекДанные));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Такая строка уже есть в табличной части'"));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти