#Область ПрограммныйИнтерфейс

// СтандартныеПодсистемы.ВерсионированиеОбъектов

// Определяет настройки объекта для подсистемы ВерсионированиеОбъектов.
//
// Параметры:
//  Настройки - Структура - настройки подсистемы.
Процедура ПриОпределенииНастроекВерсионированияОбъектов(Настройки) Экспорт

КонецПроцедуры

// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

// Устанавливает значения подчиненных элементов справочника по родительским элементам.
//
// Параметры:
//  	ПараметрыЗагрузки 	- Структура - содежит данные для отбора элементов справочника.
// 		АдресХранилища 		- Строка - содержит адрес данных во временном хранилище.
//
Процедура УстановитьЗначенияПодчиненных(ПараметрыЗагрузки, АдресХранилища) Экспорт

	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                    |	СМ_НормативныеСборники.Ссылка
	                    |ИЗ
	                    |	Справочник.СМ_НормативныеСборники КАК СМ_НормативныеСборники
	                    |ГДЕ
	                    |	СМ_НормативныеСборники.Ссылка В ИЕРАРХИИ(&Ссылка)
	                    |	И СМ_НормативныеСборники.Ссылка <> &Ссылка");  
	Запрос.УстановитьПараметр("Ссылка",ПараметрыЗагрузки.Ссылка);
	Рез=Запрос.Выполнить().Выбрать();
	Если  ПараметрыЗагрузки.Свойство("ГруппаРесурсов") Тогда
		
		ГР=ПараметрыЗагрузки.ГруппаРесурсов;
		Пока Рез.Следующий() Цикл
			Об=Рез.Ссылка.ПолучитьОбъект();
			Об.ГруппаРесурсов=ГР;
			Об.Записать();
		КонецЦикла;
	Иначе
		СМБ=ПараметрыЗагрузки.СметноНормативнаяБаза;
		Пока Рез.Следующий() Цикл
			
			Об=Рез.Ссылка.ПолучитьОбъект();
			Об.СметноНормативнаяБаза=СМБ;
			Об.Записать();
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли