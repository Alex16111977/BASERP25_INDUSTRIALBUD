#Область ОбработчикиСобытий

Процедура ПриУстановкеНовогоКода(СтандартнаяОбработка, Префикс)
	
	Если НЕ ЭтотОбъект.ЭтоГруппа тогда
		
		//	преобразованное значение кода нормативной расценки
		перемЗИВ_Код	= СМ_СметаВызовСервера.ПреобразоватьКодСправочника(ЭтотОбъект.КодНормативнойРасценки);
		
		//	проверим, смогли ли получить код
		Если Булево(перемЗИВ_Код) тогда
			//	отключим стандартное присвоение кода справочника
			СтандартнаяОбработка	= Ложь;
		 	//	установить новое значение кода
			ЭтотОбъект.Код			= перемЗИВ_Код;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.КодНормативнойРасценки) ИЛИ ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;;
	КодНормативнойРасценки = "";
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	              |	СМ_НормативныеСборники.КодНормативнойРасценки КАК КодНормативнойРасценки
	              |ИЗ
	              |	Справочник.СМ_НормативныеСборники КАК СМ_НормативныеСборники
	              |ГДЕ
	              |	СМ_НормативныеСборники.Родитель = &Группа
	              |	И СМ_НормативныеСборники.ЭтоГруппа = ЛОЖЬ
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	СМ_НормативныеСборники.Ссылка УБЫВ";
	Запрос.УстановитьПараметр("Группа",ЭтотОбъект.Родитель);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДлинаКода = СтрДлина(СокрЛП(Выборка.КодНормативнойРасценки));
		сч = ДлинаКода;
		СтрокаКода = СокрЛП(Выборка.КодНормативнойРасценки);
		ЧисловаяЧасть = "";
		Пока сч>0 Цикл
			ПоследСимвол = Сред(СтрокаКода,сч,1);
			Если Найти("0123456789",ПоследСимвол)>0 Тогда
				ЧисловаяЧасть = Строка(ПоследСимвол)+ЧисловаяЧасть;
			Иначе
				Прервать;
			КонецЕсли;
			сч = сч - 1;
		КонецЦикла;
		Если ЗначениеЗаполнено(ЧисловаяЧасть) Тогда
			ДлинаЧисла = СтрДлина(ЧисловаяЧасть);
			Префикс = Лев(СокрЛП(Выборка.КодНормативнойРасценки),ДлинаКода-ДлинаЧисла);
			СтрокаЧисла = ЧисловаяЧасть;
			Нулики = "";
			сч=0;
			Пока сч<=ДлинаЧисла Цикл
				Символ = Сред(СтрокаЧисла,сч,1);
				Если Символ = "0" Тогда
					Нулики = Строка(Нулики)+Строка("0");
					СтрокаЧисла = Сред(СтрокаЧисла,2);
				Иначе
					Прервать;
				КонецЕсли;
				сч=сч+1
			КонецЦикла;
			ЧислоСледующее = Формат(Число(СтрокаЧисла)+1,"ЧГ=0");
			КодСлед = Строка(Нулики) + Строка(ЧислоСледующее); 
			Если ДлинаЧисла < СтрДлина(КодСлед) Тогда
				Если ЗначениеЗаполнено(Нулики) Тогда
					Если СтрДлина(Нулики)=1 Тогда
						КодСлед = ЧислоСледующее
					Иначе
						Нулики = Сред(Нулики,2);
						КодСлед = Строка(Нулики) + ЧислоСледующее
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			КодНормативнойРасценки = Строка(Префикс) + КодСлед;
		КонецЕсли;
	КонецЕсли;
	ЭтотОбъект.КодНормативнойРасценки = КодНормативнойРасценки;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СметноНормативнаяБаза) Тогда
		
		Если ЗначениеЗаполнено(Родитель) Тогда
			СМБ=Родитель.СметноНормативнаяБаза;
			Если  ЗначениеЗаполнено(СМБ) и СМБ<>СметноНормативнаяБаза Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сметно-нормативная база не соответствует сметно-нормативной базе родительской группы. Данные не будут записаны.");
				Отказ=Истина;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
	Если (Не Ссылка.Наименование = Наименование) И (Не ЗначениеЗаполнено(ДлинноеНаименование)) Тогда
		ДлинноеНаименование = Наименование;
	КонецЕсли;
	
	Если ЭтоГруппа И ЭтоНовый() Тогда
		УстановитьНовыйКод();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	КодНормативнойРасценки 	= "";
	
	Если НЕ ЭтотОбъект.ЭтоГруппа Тогда
		Статус = Перечисления.СМ_СтатусыФормированияНормативов.ВРаботе;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти