
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ВводНаОсновании

Процедура ЗаполнитьШаблонНаОснованииРаботы(Приемник, Источник, тзСоответствия = Неопределено) Экспорт
	 	
	ЗаполнитьСвязиВЭтойПроцедуре = Ложь;
	
	Если тзСоответствия = Неопределено Тогда
		тзСоответствия = Новый ТаблицаЗначений;
		тзСоответствия.Колонки.Добавить("Приемник");
		тзСоответствия.Колонки.Добавить("Источник"); 	    
		ЗаполнитьСвязиВЭтойПроцедуре = Истина;
	КонецЕсли; 
	
	спрРаботы = Справочники.УСОERP_СтроительныеРаботы;
	спрШаблоны = Справочники.УСОERP_ШаблоныСтроительныхРабот;
	
	// Проверяем возможность заполнения - есть ли у источника потомки - если есть, заполнять нельзя
	ВыборкаПотомковПоПриемнику = спрШаблоны.Выбрать(Приемник.Ссылка);
	
	ВыборкаПотомковПоИсточнику = спрРаботы.Выбрать(Источник,,,"НомерРаботыВУровне");
	
	Если ВыборкаПотомковПоПриемнику.Следующий() Тогда
		ТекстСообщения = "У шаблона " + СокрЛП(Приемник.Наименование) + " заданы потомки. Копирование невозможно";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли; 
	
	// переносим реквизиты
	ЗаполнитьОбъектНаОсновании(Приемник,Источник);
	
	// дозаполняем реквизитами, хранящимися в регистрах
	Если Источник.Владелец.НовыйВариант Тогда
		
		Приемник.ОбъемРаботы 		 = Источник.ОбъемРаботы;
		Приемник.ЕдиницаОбъема       = Источник.ЕдиницаОбъема;
		Приемник.ДлительностьПлан	 = Источник.Длительность;
		Приемник.ЕдиницаДлительности = Источник.ЕдиницаДлительности;
		
	Иначе
		
		ПараметрыВыполненияРаботы = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПараметрыВыполненияРаботы(Источник, Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный, ТекущаяДата()); 
		Приемник.ОбъемРаботы 		 = ПараметрыВыполненияРаботы.ОбъемРаботы;
		Приемник.ЕдиницаОбъема       = ПараметрыВыполненияРаботы.ЕдиницаОбъема;
		Приемник.ДлительностьПлан	 = ПараметрыВыполненияРаботы.ДлительностьПлан;
		Приемник.ЕдиницаДлительности = ПараметрыВыполненияРаботы.ЕдиницаДлительности;
		
	КонецЕсли;
	
	Приемник.НомерРаботыВУровне = Источник.НомерРаботыВУровне;
	
	Приемник.Записать();
	// переписываем потомков
	Пока ВыборкаПотомковПоИсточнику.Следующий() Цикл
		
		Если ВыборкаПотомковПоИсточнику.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;	
		
		ИсточникДляПотомка = ВыборкаПотомковПоИсточнику.Ссылка;
		
		Если ИсточникДляПотомка.СуммарнаяРабота Тогда
			НовыйШаблон = Справочники.УСОERP_ШаблоныСтроительныхРабот.СоздатьГруппу();
		Иначе
			НовыйШаблон = Справочники.УСОERP_ШаблоныСтроительныхРабот.СоздатьЭлемент();
		КонецЕсли; 
		           
		НовыйШаблон.Наименование = ИсточникДляПотомка.Наименование;
		НовыйШаблон.Родитель 			 = Приемник.Ссылка;
		НовыйШаблон.НомерРаботыВУровне = ИсточникДляПотомка.НомерРаботыВУровне;
		НовыйШаблон.Записать();
		Нстр = тзСоответствия.Добавить();
		Нстр.Приемник = НовыйШаблон.Ссылка;
		Нстр.Источник = ИсточникДляПотомка.Ссылка;
		ЗаполнитьШаблонНаОснованииРаботы(НовыйШаблон,ИсточникДляПотомка,тзСоответствия);
		
	КонецЦикла; 
	
КонецПроцедуры

//В процедуре заполняем Объект-Приемник на основании Объекта-Источника
//реквизиты переносим при совпадении наименований, аналогично с табличными частями
Процедура ЗаполнитьОбъектНаОсновании(Приемник,Источник) Экспорт
	
	Если НЕ ТипЗнч(Источник) = Тип("Структура") Тогда
		
		ИсточникМетаданные = Источник.Метаданные();
		ПриемникМетаданные = Приемник.Метаданные();
		
		// Переносим реквизиты
		Для Каждого Реквизит Из ПриемникМетаданные.Реквизиты Цикл
			РеквизитИсточник = ИсточникМетаданные.Реквизиты.Найти(Реквизит.Имя);
			Если РеквизитИсточник <> Неопределено Тогда 			
				Приемник[Реквизит.Имя] = Источник[Реквизит.Имя];
			КонецЕсли;
		КонецЦикла;
		
		Если ТипЗнч(Приемник) = Тип("СправочникОбъект.УСОERP_СтроительныеРаботы") Тогда
			Если НЕ Источник.ЭтоГруппа Тогда
				Приемник.Длительность = Источник.ДлительностьПлан;
			КонецЕсли;
			Если Приемник.Владелец.НовыйВариант И НЕ Источник.ЭтоГруппа Тогда
				Приемник.Материалы.Загрузить(Источник.Материалы.Выгрузить());
				ТаблицаРесурсов = Источник.Ресурсы.Выгрузить();
				ТаблицаРесурсов.Колонки.Загрузка.Имя = "ЗагрузкаПроцент";
				Приемник.Ресурсы.Загрузить(ТаблицаРесурсов);
			КонецЕсли;
			
		КонецЕсли;
		

		// Заполняем табличные части. Только для справочника Шаблоны строительных работ
		Если (ТипЗнч(Приемник) = Тип("СправочникОбъект.УСОERP_ШаблоныСтроительныхРабот")) И (Приемник.ЭтоГруппа = Ложь) Тогда
			
			Если Источник.Владелец.НовыйВариант Тогда
				ТаблицаМатериалов = Источник.Материалы.Выгрузить();
			Иначе			
				ТаблицаМатериалов = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПотребностьВМатериалах(Источник, Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный, ТекущаяДата());
			КонецЕсли;
			//ТаблицаМатериалов.Колонки.Номенклатура.Имя = "Материал";
			Для Каждого СтрокаМатериал Из ТаблицаМатериалов Цикл
				НоваяСтрока = Приемник.Материалы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМатериал);
			КонецЦикла;
			
			Если Источник.Владелец.НовыйВариант Тогда
				ТаблицаРесурсов = Источник.Ресурсы.Выгрузить();
			Иначе		
				ТаблицаРесурсов = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьПотребностьВРесурсах(Источник, Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный, ТекущаяДата());
			КонецЕсли;
		
			ТаблицаРесурсов.Колонки.ЗагрузкаПроцент.Имя = "Загрузка";
			Для Каждого СтрокаРесурс Из ТаблицаРесурсов Цикл
				НоваяСтрока = Приемник.Ресурсы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРесурс);
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

//В этой процедуре копируем шаблон и его потомков в Справочник.УСОERP_СтроительныеРаботы
//
Процедура ЗаполнитьРаботуНаОснованииШаблона(Приемник,Источник,ТаблицаСоответствия = Неопределено) Экспорт
	
	спрРаботы = Справочники.УСОERP_СтроительныеРаботы;
	спрШаблоны = Справочники.УСОERP_ШаблоныСтроительныхРабот;
	
	Если ТаблицаСоответствия = Неопределено Тогда
		
		ТаблицаСоответствия = Новый ТаблицаЗначений;
		ТаблицаСоответствия.Колонки.Добавить("Приемник");
		ТаблицаСоответствия.Колонки.Добавить("Источник");
		
	КонецЕсли;  	
	
	// Проверяем возможность заполнения - есть ли у источника потомки - если есть, заполнять нельзя
	ВыборкаПотомковПоПриемнику = спрРаботы.Выбрать(Приемник.Ссылка,,,"НомерРаботыВУровне");
	ВыборкаПотомковПоИсточнику = спрШаблоны.Выбрать(Источник.Ссылка,,,"НомерРаботыВУровне");
	
	Если ВыборкаПотомковПоПриемнику.Следующий() Тогда
		ТекстСообщения = "У работы " + СокрЛП(Приемник.Наименование) + " Заданы потомки. Копирование невозможно";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли; 
	
	// переносим реквизиты и табличные части
	ЗаполнитьОбъектНаОсновании(Приемник,Источник);  		
	
	Если (ТипЗнч(Приемник) = Тип("СправочникОбъект.УСОERP_СтроительныеРаботы")) Тогда
		ДанныеКода = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДРИНомерРаботыВУровне(Приемник.Владелец, Приемник.Родитель);
		Приемник.КодСДР  = ДанныеКода.КодСДР;
		Приемник.НомерРаботыВУровне 	= ДанныеКода.НомерРаботыВУровне;
	КонецЕсли;
	
	Если Приемник.Владелец.НовыйВариант Тогда
		
		Приемник.СуммарнаяРабота = Источник.ЭтоГруппа;
		Приемник.НомерРаботыВУровне = Приемник.НомерРаботыВУровне - 1;
		Приемник.КодСДР = "";
		Если Приемник.СуммарнаяРабота Тогда
			Приемник.ДополнительныеСвойства.Вставить("КопированиеСценария");
		КонецЕсли;	
		
	КонецЕсли;  	
	
	Приемник.Записать();
	ПровестиПоРегистрам(Приемник, Источник);
	Нстр = ТаблицаСоответствия.Добавить();
	Нстр.Приемник = Приемник.Ссылка;
	Нстр.Источник = Источник.Ссылка;
	
	// переписываем потомков
	Пока ВыборкаПотомковПоИсточнику.Следующий() Цикл
		
		Если ВыборкаПотомковПоИсточнику.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;	
		ИсточникДляПотомка = ВыборкаПотомковПоИсточнику.Ссылка;
		НоваяРабота = Справочники.УСОERP_СтроительныеРаботы.СоздатьЭлемент();
		НоваяРабота.Наименование = ИсточникДляПотомка.Наименование;
		НоваяРабота.Владелец = Приемник.Владелец;
		НоваяРабота.Родитель = Приемник.Ссылка;
		НоваяРабота.Записать();
		
		ЗаполнитьРаботуНаОснованииШаблона(НоваяРабота,ИсточникДляПотомка,ТаблицаСоответствия);
		
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСРегистрами

Процедура ПровестиПоРегистрам(Приемник, Источник)
	
	Если Приемник.Владелец.НовыйВариант Тогда
		
		Если Приемник.СуммарнаяРабота Тогда
			Возврат;
		КонецЕсли;
		
		
		Приемник.Материалы.Загрузить(Источник.Материалы.Выгрузить());
		ТабРесурсы = Источник.Ресурсы.Выгрузить();
		ТабРесурсы.Колонки.Загрузка.Имя = "ЗагрузкаПроцент";
		Приемник.Ресурсы.Загрузить(ТабРесурсы);
		
		Приемник.Записать();
		
		Возврат;
		
	КонецЕсли;
	
	
	
	Если Не Источник.ЭтоГруппа Тогда
		Для Каждого СтрокаМатериал Из Источник.Материалы Цикл
			МенеджерЗаписи 	= РегистрыСведений.УСОERP_ПотребностьВМатериалах.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Работа			= Приемник.Ссылка;
			МенеджерЗаписи.ВидПланирования 	= Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный;	
			МенеджерЗаписи.Период			= НачалоДня(ТекущаяДата());
			МенеджерЗаписи.Номенклатура  	= СтрокаМатериал.Номенклатура;
			МенеджерЗаписи.АвторИзмерения   = Пользователи.ТекущийПользователь();
		    МенеджерЗаписи.КоличествоУпаковокНаОбъемРаботы	= Окр(СтрокаМатериал.КоличествоУпаковокНаЕдиницуОбъема * Источник.ОбъемРаботы, 3);
		    МенеджерЗаписи.КоличествоНаОбъемРаботы = СтрокаМатериал.КоличествоУпаковокНаЕдиницуОбъема * ПолучитьКоэффициентУпаковки(СтрокаМатериал.Упаковка)* Источник.ОбъемРаботы;
			  
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтрокаМатериал);
			МенеджерЗаписи.Записать();
		КонецЦикла;
		
		Для Каждого СтрокаРесурс Из Источник.Ресурсы Цикл
			МенеджерЗаписи 	= РегистрыСведений.УСОERP_ПотребностьВРесурсах.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Работа			= Приемник.Ссылка;
			МенеджерЗаписи.ВидПланирования 	= Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный;	
			МенеджерЗаписи.ЗагрузкаПроцент  = СтрокаРесурс.Загрузка;
			МенеджерЗаписи.Период			= НачалоДня(ТекущаяДата());
			МенеджерЗаписи.АвторИзмерения   = Пользователи.ТекущийПользователь();
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтрокаРесурс);
			МенеджерЗаписи.Записать();
		КонецЦикла;
	КонецЕсли;	
	
	МенеджерЗаписи 	= РегистрыСведений.УСОERP_ПараметрыВыполненияРабот.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Работа				= Приемник.Ссылка;
	МенеджерЗаписи.ВидПланирования	 	= Перечисления.УСОERP_ВидыПланированияСтроительныхРабот.Календарный;
	МенеджерЗаписи.Период	        	= НачалоДня(ТекущаяДата());
	МенеджерЗаписи.АвторИзменения   	= Пользователи.ТекущийПользователь();
	МенеджерЗаписи.ОбъемРаботы			= Источник.ОбъемРаботы;
	МенеджерЗаписи.ЕдиницаОбъема		= Источник.ЕдиницаОбъема;
	МенеджерЗаписи.ДлительностьПлан		= Источник.ДлительностьПлан;
	МенеджерЗаписи.ЕдиницаДлительности	= Источник.ЕдиницаДлительности;
	МенеджерЗаписи.Записать();
КонецПроцедуры	

#КонецОбласти

#Область Прочее

Функция ПолучитьКоэффициентУпаковки(ТекУпаковка)
	
	Если ЗначениеЗаполнено(ТекУпаковка) Тогда
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекУпаковка,"Числитель,Знаменатель,Объем,Вес");
		ТекКоэффициент = ?(ЗначенияРеквизитов.Знаменатель = 0 ИЛИ ЗначенияРеквизитов.Знаменатель = Неопределено,1,ЗначенияРеквизитов.Числитель/ЗначенияРеквизитов.Знаменатель);
		
		Если ТекКоэффициент = Неопределено Тогда
			
			ТекКоэффициент = 1;
			
		КонецЕсли;
		
	Иначе
		
		ТекКоэффициент = 1;
		
	КонецЕсли;
	
	Возврат ТекКоэффициент;
	
КонецФункции

#КонецОбласти

#КонецЕсли