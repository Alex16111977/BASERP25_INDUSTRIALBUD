
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	Если СметнаяКомпонента = Неопределено Тогда
		ПоказатьПредупреждение(,НСтр("ru='Сметная компонента не подключена'"));
	Иначе
		Попытка
			СметнаяКомпонента.ОткрытьТехЧасть(КодСНБ(ПараметрКоманды), "0", "");
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция КодСНБ(СНБ)
	Возврат СНБ.Код;
КонецФункции

#КонецОбласти
