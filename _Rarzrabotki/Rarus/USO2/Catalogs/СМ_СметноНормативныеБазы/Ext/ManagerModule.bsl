// функция возвращает СНБ по умолчанию
//
// Параметры:
//   Нет.
//
// Возвращаемое значение: 
//   Сметно-нормативная база (СправочникСсылка.СМ_СметноНормативныеБазы).
//
Функция ПолучитьПоУмолчанию() Экспорт		
	База = Справочники.СМ_СметноНормативныеБазы.Выбрать();
	
	Если База.Следующий() Тогда
		Возврат База.Ссылка;
	Иначе 
		Возврат Справочники.СМ_СметноНормативныеБазы.ПустаяСсылка();
	КонецЕсли;	
	
КонецФункции

// функция возвращает СНБ по району
//
// Параметры:
//   ТерриториальныйРайон - СправочникСсылка.СМ_ТерриториальныеРайоны для отбора.
//
// Возвращаемое значение: 
//   Сметно-нормативная база (СправочникСсылка.СМ_СметноНормативныеБазы).
//
Функция ПолучитьПоРайону(ТерриториальныйРайон) Экспорт	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	СМ_СметноНормативныеБазыРайоны.Ссылка
	|ИЗ
	|	Справочник.СМ_СметноНормативныеБазы.Районы КАК СМ_СметноНормативныеБазыРайоны
	|ГДЕ
	|	СМ_СметноНормативныеБазыРайоны.ТерриториальныйРайон = &ТерриториальныйРайон";
	
	Запрос.УстановитьПараметр("ТерриториальныйРайон", ТерриториальныйРайон.Ссылка);
	
	Результат = Запрос.Выполнить();
	База = Результат.Выбрать();
	
	Если База.Следующий() Тогда
		Возврат База.Ссылка;
	Иначе 
		Возврат ПолучитьПоУмолчанию();
	КонецЕсли;	
	
КонецФункции

Функция ПолучитьБазуПоУмолчанию() Экспорт	
	
	Запрос=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                    |	СМ_СметноНормативныеБазы.Ссылка
	                    |ИЗ
	                    |	Справочник.СМ_СметноНормативныеБазы КАК СМ_СметноНормативныеБазы
	                    |ГДЕ
	                    |	СМ_СметноНормативныеБазы.Ссылка <> ЗНАЧЕНИЕ(Справочник.СМ_СметноНормативныеБазы.ИндивидуальныеРасценки)
	                    |	И НЕ СМ_СметноНормативныеБазы.ПометкаУдаления");
	
	Результат=Запрос.Выполнить();
	Если  Результат.Пустой() Тогда
		Возврат  Справочники.СМ_СметноНормативныеБазы.ИндивидуальныеРасценки;
	КонецЕсли;
	
	Возврат Справочники.СМ_СметноНормативныеБазы.ПустаяСсылка();
	
	
КонецФункции

