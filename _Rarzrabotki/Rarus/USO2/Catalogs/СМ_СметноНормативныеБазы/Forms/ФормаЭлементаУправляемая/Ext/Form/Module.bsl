#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РайоныТерриториальныйРайонПриИзменении(Элемент)
	ТекДанные = Элементы.Районы.ТекущиеДанные;
	НайденныеСтроки = Объект.Районы.НайтиСтроки(Новый Структура("ТерриториальныйРайон",ТекДанные.ТерриториальныйРайон));
	Если НайденныеСтроки.Количество() > 1 Тогда
		Объект.Районы.Удалить(Объект.Районы.Индекс(ТекДанные));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Строка с таким районом уже есть в табличной части'"));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти