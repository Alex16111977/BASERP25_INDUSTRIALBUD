#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	Если Объект.Ссылка = Справочники.СМ_ИтогиЧППоРазделу.ПустаяСсылка() Тогда
		Объект.Код = 0;
		Объект.Идентификатор = "";
		Объект.ПорядковыйНомер = Справочники.СМ_ИтогиЧППоРазделу.ПолучитьМаксимальныйНомерПоПорядку() + 1;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти