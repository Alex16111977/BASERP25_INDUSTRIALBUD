
#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаполнитьИзВНБ(Команда)
	
	Если СметнаяКомпонента = Неопределено Тогда
		ПоказатьПредупреждение(,НСтр("ru='Сметная компонента не подключена'"));
	Иначе
		Если Элементы.Список.ТекущаяСтрока = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Отказ = Ложь;
		ТекДанные = Элементы.Список.ТекущаяСтрока;
		
		ДополнительныеПараметры = Новый Структура("КодБазы, СНБ", Элементы.Список.ТекущиеДанные.СметноНормативнаяБазаКод, Элементы.Список.ТекущиеДанные.СметноНормативнаяБаза);
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Вы точно уверены, что хотите перезаполнить поправки для нормативной базы %1?'"), Элементы.Список.ТекущиеДанные.СметноНормативнаяБаза);
		Оповещение = Новый ОписаниеОповещения("ОбновлениеПоправок", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Да);
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
// Изменяет доступность кнопки "Заполнить из ВНБ" для демо базы и поправок по МДС.
Процедура СписокПриАктивизацииСтроки(Элемент)
	Если Не Элемент.ТекущиеДанные = Неопределено И (Элемент.ТекущиеДанные.СметноНормативнаяБазаКод = "00"
		Или Элемент.ТекущиеДанные.СметноНормативнаяБазаКод = "") Тогда
		Элементы.ЗаполнитьИзВНБ.Доступность = Ложь;
	Иначе
		Элементы.ЗаполнитьИзВНБ.Доступность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
// Осуществляет вызов процедуры обновления поправок.
//
// Параметры:
//		Ответ - КодВозвратаДиалога - ответ пользователя на вопрос (продолжать или нет).
//		ДополнительныеПараметры - Структура - дополнительные параметры, переданные при формировании вопроса.
//
Процедура ОбновлениеПоправок(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
		
	ПоказатьОповещениеПользователя(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Обновляются поправки %1'"), ДополнительныеПараметры.СНБ));
		
	ДанныеДляОбновления = СметнаяКомпонента.ПровестиОбновлениеПоправок(ДополнительныеПараметры.КодБазы);
		
	ЗаполнитьИзВНБНаСервере(ДополнительныеПараметры.СНБ, ДанныеДляОбновления, СМ_ВерсияКомпоненты);
	
	Элементы.Список.Обновить();
			
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзВНБНаСервере(СНБ, ДанныеДляОбновления, СМ_ВерсияКомпоненты)
	
	СМ_СметаЗагрузкаВызовСервера.ОбновитьПоправки(СНБ, ДанныеДляОбновления, СМ_ВерсияКомпоненты);

КонецПроцедуры

#КонецОбласти