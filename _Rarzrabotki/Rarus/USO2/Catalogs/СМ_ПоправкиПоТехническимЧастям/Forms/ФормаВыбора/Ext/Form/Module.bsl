#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	НеОтбирать = Истина;
	Если Параметры.Свойство("НомерСборника") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("НомерСборника",Параметры.НомерСборника); 
		Список.Параметры.УстановитьЗначениеПараметра("ОтборНомера",?(Параметры.НомерСборника=0,Ложь,Истина));
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("НомерСборника",Неопределено);
		Список.Параметры.УстановитьЗначениеПараметра("ОтборНомера",Ложь);
	КонецЕсли;
	Если Параметры.Свойство("ТипНормативногоСборника") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("ТипНормативногоСборника",Параметры.ТипНормативногоСборника); 
		Список.Параметры.УстановитьЗначениеПараметра("ОтборТНС",ЗначениеЗаполнено(Параметры.ТипНормативногоСборника));
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("ТипНормативногоСборника",Неопределено);
		Список.Параметры.УстановитьЗначениеПараметра("ОтборТНС",Ложь);
	КонецЕсли;
	Если Параметры.Свойство("СметноНормативнаяБаза") Тогда
		НеОтбирать = Не ЗначениеЗаполнено(Параметры.СметноНормативнаяБаза);
		Список.Параметры.УстановитьЗначениеПараметра("СметноНормативнаяБаза",Параметры.СметноНормативнаяБаза);
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("СметноНормативнаяБаза",Неопределено);
	КонецЕсли;
	Список.Параметры.УстановитьЗначениеПараметра("НеОтбирать",НеОтбирать);
КонецПроцедуры

#КонецОбласти