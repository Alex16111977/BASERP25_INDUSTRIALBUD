
#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	Если Копирование Тогда
		ОткрытьФорму("Справочник.АУН_ОбъектыНедвижимости.Форма.АУН_ФормаЭлемента", Новый Структура("ЗначениеКопирования", Элементы.Список.ТекущаяСтрока));
	Иначе
		ОткрытьФорму("Справочник.АУН_ОбъектыНедвижимости.Форма.АУН_ФормаЭлемента");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	ОткрытьФорму("Справочник.АУН_ОбъектыНедвижимости.Форма.АУН_ФормаЭлемента", Новый Структура("Ключ", Элементы.Список.ТекущаяСтрока));
	             
КонецПроцедуры

#КонецОбласти
