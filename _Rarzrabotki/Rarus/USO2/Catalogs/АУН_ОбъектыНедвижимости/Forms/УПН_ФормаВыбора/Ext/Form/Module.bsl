
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Отбор.Количество() > 0 Тогда
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;
	КонецЕсли;                                                  	

	Если Параметры.Свойство("Здание") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("Здание", Параметры.Здание);
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("Здание", Справочники.АУН_ОбъектыНедвижимости.ПустаяСсылка());
	КонецЕсли;
	
КонецПроцедуры
