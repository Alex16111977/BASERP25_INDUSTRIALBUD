
#Область ОбщиеПроцедурыИФункции
&НаСервере
Функция ЗаписатьЦеныОбъектаНаСервере(СсылкаНаДокументРегистрацииЦен,ОписаниеОшибки)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаНовыхЦен", 	Цены.Выгрузить());
	Запрос.УстановитьПараметр("ОбъектНедвижимости", Объект.Ссылка);
	Запрос.УстановитьПараметр("ТекущаяДата", 		ТекущаяДата());
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаНовыхЦен.ТипЦены,
	|	ТаблицаНовыхЦен.ЦенаЗаЕдиницуПлощади КАК Цена,
	|	ТаблицаНовыхЦен.Стоимость
	|ПОМЕСТИТЬ ТабицаНовыхЦен_ВТ
	|ИЗ
	|	&ТаблицаНовыхЦен КАК ТаблицаНовыхЦен
	|ГДЕ
	|	ТаблицаНовыхЦен.ЦенаЗаЕдиницуПлощади > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА УПН_ЦеныОбъектовНедвижимостиСрезПоследних.Период = НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ)
	|			ТОГДА УПН_ЦеныОбъектовНедвижимостиСрезПоследних.Регистратор
	|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.УПН_РегистрацияЦенОбъектовНедвижимости.ПустаяСсылка)
	|	КОНЕЦ КАК Регистратор,
	|	ТабицаНовыхЦен_ВТ.ТипЦены КАК ВидЦены,
	|	ТабицаНовыхЦен_ВТ.Цена КАК ЦенаЗаЕдиницуПлощади,
	|	ТабицаНовыхЦен_ВТ.Стоимость,
	|	ЕСТЬNULL(УПН_ЦеныОбъектовНедвижимостиСрезПоследних.ЦенаЗаЕдиницуПлощади, 0) КАК ЦенаЗаЕдиницуПлощадиИзРегистра
	|ПОМЕСТИТЬ НовыеЦеныОбъекта
	|ИЗ
	|	ТабицаНовыхЦен_ВТ КАК ТабицаНовыхЦен_ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УПН_ЦеныОбъектовНедвижимости.СрезПоследних(
	|				&ТекущаяДата,
	|				ТипОперации = ЗНАЧЕНИЕ(Перечисление.УПН_ТипыОперацийСНедвижимостью.Продажа)
	|					И ОбъектНедвижимости = &ОбъектНедвижимости) КАК УПН_ЦеныОбъектовНедвижимостиСрезПоследних
	|		ПО ТабицаНовыхЦен_ВТ.ТипЦены = УПН_ЦеныОбъектовНедвижимостиСрезПоследних.ВидЦены
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НовыеЦеныОбъекта.Регистратор,
	|	НовыеЦеныОбъекта.ВидЦены,
	|	НовыеЦеныОбъекта.ЦенаЗаЕдиницуПлощади,
	|	НовыеЦеныОбъекта.Стоимость
	|ИЗ
	|	НовыеЦеныОбъекта КАК НовыеЦеныОбъекта
	|ГДЕ
	|	НовыеЦеныОбъекта.ЦенаЗаЕдиницуПлощади <> НовыеЦеныОбъекта.ЦенаЗаЕдиницуПлощадиИзРегистра";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Количество()>0 Тогда //есть измененные цены
		
		Отбор = Новый Структура;
		Отбор.Вставить("Доля", Объект.Ссылка);
		АктуальныеЗаписиРС = РегистрыСведений.УСОERP_СоответствиеДоговоровИДолей.СрезПоследних(ТекущаяДата(), Отбор); 
		Если АктуальныеЗаписиРС.Количество() <> 0 Тогда 
			СтрокаРС = АктуальныеЗаписиРС[0];
		Иначе
			СтрокаРС = Неопределено;
		КонецЕсли;
		
		ДокументРегистрацияЦен = Документы.УПН_РегистрацияЦенОбъектовНедвижимости.СоздатьДокумент();
		ДокументРегистрацияЦен.ТипОперации 	= Перечисления.УПН_ТипыОперацийСНедвижимостью.Продажа;
		ДокументРегистрацияЦен.Дата 		= ТекущаяДата();
		Если СтрокаРС <> Неопределено Тогда
			ДокументРегистрацияЦен.Организация 	= СтрокаРС.Договор.Организация;
			ДокументРегистрацияЦен.Здание 		= СтрокаРС.Доля.ОбъектЭксплуатации;
		КонецЕсли;
		ДокументРегистрацияЦен.Здание = Объект.ПринадлежитОбъекту;
		
		ДокументРегистрацияЦен.Заполнить(Неопределено);
		
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.Регистратор) Тогда
				НоваяСтрока = ДокументРегистрацияЦен.ЦеныОбъектовНедвижимости.Добавить();
				НоваяСтрока.ОбъектНедвижимости = Объект.Ссылка;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка); 
			Иначе
				Попытка
					РегистрацияЦенНаИзменение = Выборка.Регистратор.ПолучитьОбъект();
					Отбор = Новый Структура;
					Отбор.Вставить("ОбъектНедвижимости",	Объект.Ссылка);
					Отбор.Вставить("ВидЦены",				Выборка.ВидЦены);
					СтрокиДокумента = РегистрацияЦенНаИзменение.ЦеныОбъектовНедвижимости.НайтиСтроки(Отбор);
					СтрокаДокумента = СтрокиДокумента[0];
					СтрокаДокумента.ЦенаЗаЕдиницуПлощади 	= Выборка.ЦенаЗаЕдиницуПлощади;
					СтрокаДокумента.Стоимость 				= Выборка.Стоимость;
					РегистрацияЦенНаИзменение.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				Исключение 
					Сообщить(ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		ДокументРегистрацияЦен.Записать(РежимЗаписиДокумента.Запись);
		
		Попытка
			ДокументРегистрацияЦен.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ "+ДокументРегистрацияЦен.Ссылка);
		Исключение
			СсылкаНаДокументРегистрацииЦен = ДокументРегистрацияЦен.Ссылка;
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			Пока ИнформацияОбОшибке.Причина <> Неопределено Цикл
				ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
			КонецЦикла;
			ОписаниеОшибки = ИнформацияОбОшибке.Описание;
			Возврат Ложь;
		КонецПопытки;
		Возврат Истина;		  
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаСервере
Процедура ПрочитатьОбщуюИнформациюНаСервере()
	
	ОбновитьДоступностьЭлементовНаСервере();	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Дата), КонецДня(Дата), '00010101'));
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПлощадиОбъектовНедвижимости.ОбщаяПлощадь,
	|	ПлощадиОбъектовНедвижимости.ЖилаяПлощадь,
	|	ПлощадиОбъектовНедвижимости.КоличествоЖилыхКомнат,
	|	NULL КАК Контрагент,
	|	NULL КАК Договор
	|ИЗ
	|	РегистрСведений.УПН_ПлощадиОбъектовНедвижимости.СрезПоследних(&Дата, ОбъектНедвижимости = &Ссылка) КАК ПлощадиОбъектовНедвижимости
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	NULL,
	|	NULL,
	|	NULL,
	|	ВЫБОР
	|		КОГДА УСОERP_СоответствиеДоговоровИДолей.Статус <> ЗНАЧЕНИЕ(Перечисление.УПН_СтатусыДокументовПоСделке.Отменено)
	|			ТОГДА УСОERP_СоответствиеДоговоровИДолей.Контрагент
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА УСОERP_СоответствиеДоговоровИДолей.Статус <> ЗНАЧЕНИЕ(Перечисление.УПН_СтатусыДокументовПоСделке.Отменено)
	|			ТОГДА УСОERP_СоответствиеДоговоровИДолей.Договор
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ
	|ИЗ
	|	РегистрСведений.УСОERP_СоответствиеДоговоровИДолей.СрезПоследних(&Дата, Доля = &Ссылка) КАК УСОERP_СоответствиеДоговоровИДолей";
	
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого КолонкаРеквизит Из Результат.Колонки Цикл
			ИмяРеквизита = КолонкаРеквизит.Имя;
			Если ЗначениеЗаполнено(Выборка[ИмяРеквизита]) Тогда
				ЭтаФорма[ИмяРеквизита] = Выборка[ИмяРеквизита];
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

Запрос = Новый Запрос;

Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Дата), КонецДня(Дата), '00010101'));

Запрос.Текст =
"ВЫБРАТЬ РАЗРЕШЕННЫЕ
|	ПлощадиОбъектовНедвижимости.ОбщаяПлощадь,
|	ПлощадиОбъектовНедвижимости.ЖилаяПлощадь,
|	ПлощадиОбъектовНедвижимости.КоличествоЖилыхКомнат
|ИЗ
|	РегистрСведений.УПН_ПлощадиОбъектовНедвижимости.СрезПоследних(&Дата, ОбъектНедвижимости = &Ссылка) КАК ПлощадиОбъектовНедвижимости";

Результат = Запрос.Выполнить();
Выборка = Результат.Выбрать();

Если НЕ Выборка.Следующий() Тогда //нет данных о регистраци параметров
	
	Если ОбщаяПлощадь+ЖилаяПлощадь+КоличествоЖилыхКомнат>0 Тогда //значения был заполнены при создании элемента
		
		ДокументРегистрацияПараметров = Документы.УПН_РегистрацияПараметровОбъектовНедвижимости.СоздатьДокумент();
		ДокументРегистрацияПараметров.ВидОперации = Перечисления.УПН_ВидыОперацийРегистрацияПараметровОбъектовНедвижимости.ИзменениеПлощадей;
		ДокументРегистрацияПараметров.Дата = Дата;			
		
		НоваяСтрока = ДокументРегистрацияПараметров.ПараметрыОбъектов.Добавить();
		НоваяСтрока.ОбъектНедвижимости = Объект.Ссылка;		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтаФорма);
		
		ДокументРегистрацияПараметров.Заполнить(Неопределено);
		СделатьСообщение = Ложь;
		
		Если НЕ ЗначениеЗаполнено(ДокументРегистрацияПараметров.Организация) Тогда
			
			СообщениеПредупреждения = Новый СообщениеПользователю;
			СообщениеПредупреждения.Текст = "В документе регистрации параметров объектов недвижимости, не указана организация. Пожалуйста, заполните этот реквизит!
			|Нажмите на это сообщение для открытия окна документа.";
			СделатьСообщение = Истина;
			
		КонецЕсли;
		
		ДокументРегистрацияПараметров.Записать(РежимЗаписиДокумента.Запись);
		
		Если НЕ СделатьСообщение Тогда
			
			Попытка
				
				ДокументРегистрацияПараметров.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
				
			Исключение
				
				СообщениеПредупреждения = Новый СообщениеПользователю;
				СообщениеПредупреждения.УстановитьДанные(ДокументРегистрацияПараметров);
				СообщениеПредупреждения.Текст = "Не удалось провести документ регистрации параметров объектов недвижимости по причине:
				|"+ ОписаниеОшибки()+ "
				|Нажмите на это сообщение для открытия окна документа.";
				СообщениеПредупреждения.Сообщить();
				
			КонецПопытки;
			
		Иначе
			
			СообщениеПредупреждения.УстановитьДанные(ДокументРегистрацияПараметров);				
			СообщениеПредупреждения.Сообщить(); 
			
		КонецЕсли;
		
		КонецЕсли;   
		
	КонецЕсли;	
	
	ОбновитьДоступностьЭлементовНаСервере();
	
КонецПроцедуры 

&НаСервере
Процедура СоздатьДокументРегистрацияПараметровНаСервере(ДанныеФормы)
	
	ДокументРегистрацияПараметров = ДанныеФормыВЗначение(ДанныеФормы, Тип("ДокументОбъект.УПН_РегистрацияПараметровОбъектовНедвижимости"));
	ДокументРегистрацияПараметров.ВидОперации = Перечисления.УПН_ВидыОперацийРегистрацияПараметровОбъектовНедвижимости.ИзменениеПлощадей;
	
	НоваяСтрока = ДокументРегистрацияПараметров.ПараметрыОбъектов.Добавить();
	НоваяСтрока.ОбъектНедвижимости = Объект.Ссылка;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбъектНедвижимости", Объект.Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПлощадиОбъектовНедвижимости.ОбщаяПлощадь,
	|	ПлощадиОбъектовНедвижимости.ЖилаяПлощадь,
	|	ПлощадиОбъектовНедвижимости.КоличествоЖилыхКомнат
	|ИЗ
	|	РегистрСведений.УПН_ПлощадиОбъектовНедвижимости.СрезПоследних(, ОбъектНедвижимости = &ОбъектНедвижимости) КАК ПлощадиОбъектовНедвижимости";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	Иначе
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтаФорма);
	КонецЕсли;
	
	ДокументРегистрацияПараметров.Заполнить(Неопределено);
	
	ДокументРегистрацияПараметров.Здание = Объект.Ссылка.ПринадлежитОбъекту;
	
	ЗначениеВДанныеФормы(ДокументРегистрацияПараметров, ДанныеФормы);

КонецПроцедуры

&НаСервере
// Преобразовать строку полей в структуру
Функция ПреобразоватьСтрокуВСтруктуру(СтрокаПолей)
	
	Результат = Новый СписокЗначений;
	ПоследнийЭлемент = Неопределено;
	
	Для Сч = 1 По СтрЧислоСтрок(СтрокаПолей) Цикл
		Стр = СтрПолучитьСтроку(СтрокаПолей, Сч);
		Если Лев(Стр, 1) = Символы.Таб Тогда
			Если ПоследнийЭлемент <> Неопределено Тогда
				ПоследнийЭлемент.Значение = ПоследнийЭлемент.Значение + Символы.ПС + Сред(Стр, 2);
			КонецЕсли;
		Иначе
			Поз = Найти(Стр, "=");
			Если Поз <> 0 Тогда
				ПоследнийЭлемент = Результат.Добавить(Сред(Стр, Поз+1), Лев(Стр, Поз-1));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	СтруктураПолей = Новый Структура;
	Для Каждого Элемент Из Результат Цикл
		СтруктураПолей.Вставить(Элемент.Представление, Элемент.Значение);
	КонецЦикла;
	
	Возврат СтруктураПолей;
	
КонецФункции

&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма, РеквизитФормыВЗначение("Объект"));
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьЦеныОбъектаНаСервере()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыЦен.Ссылка КАК ТипЦены,
	|	ВидыЦен.ВалютаЦены,
	|	УПН_ЦеныОбъектовНедвижимостиСрезПоследних.ЦенаЗаЕдиницуПлощади,
	|	УПН_ЦеныОбъектовНедвижимостиСрезПоследних.Стоимость
	|ИЗ
	|	Справочник.ВидыЦен КАК ВидыЦен
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УПН_ЦеныОбъектовНедвижимости.СрезПоследних(
	|				,
	|				ОбъектНедвижимости = &Ссылка
	|					И ТипОперации = ЗНАЧЕНИЕ(Перечисление.УПН_ТипыОперацийСНедвижимостью.Продажа)) КАК УПН_ЦеныОбъектовНедвижимостиСрезПоследних
	|		ПО ВидыЦен.Ссылка = УПН_ЦеныОбъектовНедвижимостиСрезПоследних.ВидЦены";
	//|ГДЕ
	//|	ВидыЦен.ИспользоватьПриПродаже";
	
	Запрос.Параметры.Вставить("Ссылка",Объект.Ссылка);
	
	Цены.Загрузить(Запрос.Выполнить().Выгрузить());		
	
КонецПроцедуры

#КонецОбласти

