// ПРОЦЕДУРЫ - ДЕЙСТВИЯ КОМАНДНЫХ ПАНЕЛЕЙ ФОРМЫ

&НаКлиенте
Процедура ИзменитьДанные(Команда)
	
	Форма = ПолучитьФорму("Документ.УПН_РегистрацияПараметровОбъектовНедвижимости.Форма.ФормаДокумента",, ЭтаФорма);
	ДанныеФормы = Форма.Объект;
	СоздатьДокументРегистрацияПараметровНаСервере(ДанныеФормы);
	КопироватьДанныеФормы(ДанныеФормы, Форма.Объект);
	Форма.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьЦеныОбъекта(Команда)
	ПрочитатьЦеныОбъектаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЦеныСтоимостьПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Цены.ТекущиеДанные;
	Если ЗначениеЗаполнено(ОбщаяПлощадь) Тогда
		ТекущиеДанные.ЦенаЗаЕдиницуПлощади = ТекущиеДанные.Стоимость/ОбщаяПлощадь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЦенаЗаЕдиницуПлощадиПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Цены.ТекущиеДанные;
	ТекущиеДанные.Стоимость = ТекущиеДанные.ЦенаЗаЕдиницуПлощади*ОбщаяПлощадь;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьЦеныОбъекта(Команда)
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(,"Элемент справочника необходимо сначала записать!");
		Возврат;
	КонецЕсли;
	СсылкаДокументаРегистрацииЦен = Неопределено;
	ИнформацияОбОшибке = "";
	Если НЕ ЗаписатьЦеныОбъектаНаСервере(СсылкаДокументаРегистрацииЦен,ИнформацияОбОшибке) Тогда
		Если ЗначениеЗаполнено(ИнформацияОбОшибке) Тогда
			ПоказатьЗначение(,СсылкаДокументаРегистрацииЦен);
			ПоказатьПредупреждение(,"Ошибка проведения документа:"+Символы.ПС+ИнформацияОбОшибке,,"Регистрация цен объекта");
		Иначе // в этом случае просто цены не поменялись
			ПоказатьПредупреждение(,"Не обнаружено измений цен данного объекта!",,"Регистрация цен объекта");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

