#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ВидСценарияПроверен = Ложь;
	Если ПометкаУдаления Тогда
		Выборка = Справочники.УСОERP_СтроительныеРаботы.ВыбратьИерархически(,Ссылка);
		Пока  Выборка.Следующий() Цикл
			Если НЕ Выборка.ПометкаУдаления Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя пометить на удаление сценарий, имеющий не помеченные на удаление подчиненные работы.",ЭтотОбъект,,,Отказ);  			
				Прервать;
			КонецЕсли;
		КонецЦикла; 			
		Возврат;
	КонецЕсли;
	
	Если НЕ (ДополнительныеСвойства.Свойство("ВидСценарияПроверен", ВидСценарияПроверен)
		И ВидСценарияПроверен = Истина) Тогда
		
		ВидСценарияУникален = Справочники.УСОERP_СценарииПланированияПроектовСтроительства.ВидСценарияУникален(ЭтотОбъект);
		
		Если НЕ ВидСценарияУникален Тогда
			ТекстИсключения = НСтр("ru='Для обекта строительства ""<Владелец>"" уже существует сценарий планирования с видом ""<ВидСценария>""'");
			ТекстИсключения = СтрЗаменить(ТекстИсключения, "<Владелец>", Строка(Владелец));
			ТекстИсключения = СтрЗаменить(ТекстИсключения, "<ВидСценария>", Строка(ВидСценария));
			ВызватьИсключение ТекстИсключения; 
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ЗагруженИзMSProject     = Ложь;
	ДатаЗагрузкиИзMSProject = "";
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) 	

	ИнициализироватьДокумент(ДанныеЗаполнения);
	
КонецПроцедуры 

Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Организация = ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Организация);
	
	Если ДанныеЗаполнения = Неопределено Тогда
		
		НовыйВариант = Истина;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") И ДанныеЗаполнения.Свойство("НовыйВариант") Тогда
		
		НовыйВариант = ДанныеЗаполнения.НовыйВариант;
		
	КонецЕсли;
		
КонецПроцедуры

