
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)		
	
	КнопкаСоздатьСтарая = Элементы.Найти("ФормаСоздать");
	
	Если КнопкаСоздатьСтарая <> Неопределено Тогда  	
		
		Если ПолучитьФункциональнуюОпцию("УСОERP_ИспользоватьСтарыйВариантСценариев") Тогда
			
			НоваяГруппа = Элементы.Вставить("ГруппаСоздать",Тип("ГруппаФормы"),Элементы.ФормаКоманднаяПанель,КнопкаСоздатьСтарая);
			НоваяГруппа.Заголовок = "Создать";
			
			Элементы.Переместить(Элементы.ФормаКомандаСоздать_НовыйВариант,НоваяГруппа);
			Элементы.Переместить(КнопкаСоздатьСтарая,НоваяГруппа);
			
		Иначе
			
			Элементы.Переместить(Элементы.ФормаКомандаСоздать_НовыйВариант,Элементы.ФормаКоманднаяПанель,КнопкаСоздатьСтарая);
			Элементы.ФормаКомандаСоздать_НовыйВариант.Заголовок = "Создать";
			КнопкаСоздатьСтарая.Видимость = Ложь;
			Элементы["ФормаСкопировать"].Видимость = Ложь;
			
		КонецЕсли;
		
	КонецЕсли; 	
	
	Элементы.ФормаКомандаСоздать_НовыйВариант.Видимость = ПравоДоступа("Добавление",Метаданные.Справочники.УСОERP_СценарииПланированияПроектовСтроительства);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "НомерВерсии", 0, ВидСравненияКомпоновкиДанных.Равно,,Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздать_НовыйВариант(Команда)
	ОткрытьФорму("Справочник.УСОERP_СценарииПланированияПроектовСтроительства.Форма.ФормаЭлементаДинамическая",Новый Структура("НовыйВариант",Истина));
КонецПроцедуры
