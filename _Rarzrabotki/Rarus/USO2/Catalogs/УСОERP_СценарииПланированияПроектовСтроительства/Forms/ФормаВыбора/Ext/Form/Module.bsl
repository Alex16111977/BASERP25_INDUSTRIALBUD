
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КнопкаСоздатьСтарая = Элементы.Найти("ФормаСоздать");
	
	Если КнопкаСоздатьСтарая <> Неопределено Тогда  	
		
		Если ПолучитьФункциональнуюОпцию("УСОERP_ИспользоватьСтарыйВариантСценариев") Тогда
			
			НоваяГруппа = Элементы.Вставить("ГруппаСоздать",Тип("ГруппаФормы"),Элементы.ФормаКоманднаяПанель,КнопкаСоздатьСтарая);
			НоваяГруппа.Заголовок = "Создать";
			
			Элементы.Переместить(Элементы.СписокКомандаСоздать_НовыйВариант,НоваяГруппа);
			Элементы.Переместить(КнопкаСоздатьСтарая,НоваяГруппа);
			
		Иначе
			
			Элементы.Переместить(Элементы.СписокКомандаСоздать_НовыйВариант,Элементы.ФормаКоманднаяПанель,КнопкаСоздатьСтарая);
			Элементы.СписокКомандаСоздать_НовыйВариант.Заголовок = "Создать";
			КнопкаСоздатьСтарая.Видимость = Ложь;
			Элементы["ФормаСкопировать"].Видимость = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.СписокКомандаСоздать_НовыйВариант.Видимость = ПравоДоступа("Добавление",Метаданные.Справочники.УСОERP_СценарииПланированияПроектовСтроительства);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "НомерВерсии", 0, ВидСравненияКомпоновкиДанных.Равно,,Истина);
	
	Если Параметры.Свойство("ОбъектСтроительства") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Владелец", Параметры.ОбъектСтроительства, ВидСравненияКомпоновкиДанных.Равно,, Истина);
		ОбъектСтроительства = Параметры.ОбъектСтроительства;
	КонецЕсли;
	
	Если Параметры.Свойство("Организация") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Организация", Параметры.Организация, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	КонецЕсли;
	
	Если Параметры.Свойство("ВидСценария") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ВидСценария", Параметры.ВидСценария, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	КонецЕсли;
	
	Если Параметры.Свойство("ПометкаУдаления") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ПометкаУдаления", Параметры.ПометкаУдаления, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	КонецЕсли;
	
	Если Параметры.Свойство("ОтборВерсийДляОтчета") Тогда
		ОтборВерсийДляОтчета = Параметры.ОтборВерсийДляОтчета;
	КонецЕсли;
	
	Если Параметры.Отбор.Свойство("НовыйВариант") Тогда
		
		НовыйВариант = Параметры.Отбор.НовыйВариант;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "НовыйВариант", Истина);
		
	Иначе
		//ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "НовыйВариант", Ложь);
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "НомерВерсии", 0, ВидСравненияКомпоновкиДанных.Равно,,Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ОтборВерсийДляОтчета = Истина Тогда
		
		ОткрытьФорму("Справочник.УСОERP_СценарииПланированияПроектовСтроительства.Форма.ФормаВыбораВерсий",Новый Структура("ОтборВерсийДляОтчета",Истина),ЭтаФорма.ВладелецФормы);
		Отказ = Истина;
		
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если НовыйВариант Тогда
		Отказ = Истина;
		ОткрытьФорму("Справочник.УСОERP_СценарииПланированияПроектовСтроительства.Форма.ФормаЭлементаДинамическая",Новый Структура("НовыйВариант",Истина));
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздать_НовыйВариант(Команда)
	ОткрытьФорму("Справочник.УСОERP_СценарииПланированияПроектовСтроительства.Форма.ФормаЭлементаДинамическая",Новый Структура("НовыйВариант,Владелец",Истина,ОбъектСтроительства));
КонецПроцедуры
