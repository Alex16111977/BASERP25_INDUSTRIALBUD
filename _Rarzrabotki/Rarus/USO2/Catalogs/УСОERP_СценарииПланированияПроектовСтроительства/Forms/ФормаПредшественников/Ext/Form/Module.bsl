
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Работа.СуммарнаяРабота Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Работа = Параметры.Работа;
	СценарийПланирования = Работа.Владелец;
	АдресТаблицы = Параметры.АдресТаблицы;
	
	Для Каждого СтрокаПредшественник ИЗ Работа.Предшественники Цикл
		Нстр = Предшественники.Добавить();
		ЗаполнитьЗначенияСвойств(Нстр,СтрокаПредшественник);
		Нстр.КодСДР = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДР(Нстр.СтроительнаяРабота);
	КонецЦикла;
	
	ЭтаФорма.Заголовок = "Предшественники ("+Работа+")";
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПеренести(Команда) 	
	
	ОповеститьОВыборе(Предшественники);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредшественникиСтроительнаяРаботаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.Предшественники.ТекущиеДанные;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		
		ВыбЗначение = ВыбранноеЗначение[0];
		
		Если ПроверитьПредшественника(ВыбЗначение) Тогда		 			
			ТекСтрока.СтроительнаяРабота = ВыбранноеЗначение[0];
			ТекСтрока.ТипЗависимости = ПредопределенноеЗначение("Перечисление.УСОERP_ТипыЗависимостейРабот.ОкончаниеНачало");
			ТекСтрока.ЕдиницаЗадержки = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.День");
			ТекСтрока.КодСДР = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДР(ТекСтрока.СтроительнаяРабота);

		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьПредшественника(Работа)
	
	Если Работа.СуммарнаяРабота ИЛИ Работа.ПометкаУдаления ИЛИ Работа.Владелец <> СценарийПланирования Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Возврат Истина;
	
КонецФункции


