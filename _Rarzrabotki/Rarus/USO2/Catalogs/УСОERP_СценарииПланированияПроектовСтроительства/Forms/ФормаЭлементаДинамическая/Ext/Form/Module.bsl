Процедура КомандаВправоПродолжение(Ответ,ДопПараметры)Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена ИЛИ Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;   	
	
	КомандаВправоНаСервере(Ответ = КодВозвратаДиалога.Да);  
	
КонецПроцедуры     

&НаСервере
Процедура КомандаВправоНаСервере(Переносить,НовыйРодитель = Неопределено)
	
	ТекРабота = Элементы.Список.ТекущаяСтрока;
	
	Если ТекРабота = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;	
	
	Если НовыйРодитель = Неопределено Тогда
		
		НовыйРодитель = Справочники.УСОERP_СтроительныеРаботы.НайтиПоРеквизиту("НомерРаботыВУровне",ТекРабота.НомерРаботыВУровне-1,ТекРабота.Родитель,ТекРабота.Владелец);
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НовыйРодитель) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если БылоВыполнениеПоРаботе(НовыйРодитель) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По работе "+НовыйРодитель+" были введены документы факта, использовать ее в качестве этапа невозможно!");
		Возврат;
		
	КонецЕсли;	
	
	ДобавитьРаботуВВарианты(ЗаполнитьСтруктуруРаботыНаСервере(ТекРабота),Истина);
	
	СтарыйРодитель = ТекРабота.Родитель;
	ТекРаботаОбъект = ТекРабота.ПолучитьОбъект();
	
	Сч = 1;
	
	ПересчитатьНомераВУровне(НовыйРодитель,ТекРабота.Владелец,Сч); 	
	
	ТекРаботаОбъект.Родитель = НовыйРодитель;
	
	Если Переносить Тогда
		
		ТекРаботаОбъект.Материалы.Загрузить(НовыйРодитель.Материалы.Выгрузить());
		ТекРаботаОбъект.Ресурсы.Загрузить(НовыйРодитель.Ресурсы.Выгрузить());
		ТекРаботаОбъект.Предшественники.Загрузить(НовыйРодитель.Предшественники.Выгрузить());
		
	КонецЕсли;
	
	Строки = ТекРаботаОбъект.Предшественники.НайтиСтроки(Новый Структура("СтроительнаяРабота",НовыйРодитель));
	Для Каждого НайденнаяСтрока ИЗ Строки Цикл
		ТекРаботаОбъект.Предшественники.Удалить(НайденнаяСтрока);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для работы """+ТекРаботаОбъект.Наименование+"("+УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДР(ТекРабота)+")"""+" был удален предшественник """+НовыйРодитель+"("+УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДР(НовыйРодитель)+")"""); 		
	КонецЦикла;   	
	
	ТекРаботаОбъект.НомерРаботыВУровне = Сч;
	ТекРаботаОбъект.ОбменДанными.Загрузка = Истина;
	ТекРаботаОбъект.Записать();
	ДобавитьРаботуВВарианты(ЗаполнитьСтруктуруРаботыНаСервере(ТекРаботаОбъект.Ссылка));
	
	НовыйРодительОбъект = ТекРаботаОбъект.Родитель.ПолучитьОбъект();
	НовыйРодительОбъект.Записать();	
	
	//Заменяем во всех работах, где новый родитель был предшественником на текущую или пустую
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("СтроительнаяРабота",НовыйРодительОбъект.Ссылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботыПредшественники.Ссылка
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы.Предшественники КАК УСОERP_СтроительныеРаботыПредшественники
	|ГДЕ
	|	УСОERP_СтроительныеРаботыПредшественники.СтроительнаяРабота = &СтроительнаяРабота
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_СтроительныеРаботыПредшественники.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Выб = Выборка.Ссылка.ПолучитьОбъект();
		Строки = Выб.Предшественники.НайтиСтроки(Новый Структура("СтроительнаяРабота",НовыйРодительОбъект.Ссылка));
		
		Для Каждого НайденнаяСтрока ИЗ Строки Цикл
			
			НайденнаяСтрока.СтроительнаяРабота = ТекРаботаОбъект.Ссылка;
			
		КонецЦикла;
		
		Выб.Записать();
		
	КонецЦикла; 	
	
	ПересчитатьНомераВУровне(СтарыйРодитель,ТекРабота.Владелец);
	
	//Тут изменились даты
	Если АвтоРасчет Тогда
		РассчитатьПроект();
	КонецЕсли;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПересчитатьНомераВУровнеПроекта(СценарийПланирования)
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СценарийПланирования",СценарийПланирования);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	УСОERP_СтроительныеРаботы.Владелец = &СценарийПланирования
	|	И НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_СтроительныеРаботы.НомерРаботыВУровне
	|ИТОГИ ПО
	|	Ссылка ИЕРАРХИЯ";
	
	ДеревоЗапроса = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	Сч = 1;
	
	Для Каждого СтрокаЗапроса ИЗ ДеревоЗапроса.Строки Цикл
		
		ПересчитатьНомераВСтрокеДерева(СтрокаЗапроса,Сч);
		
		Сч = Сч+1;
		
	КонецЦикла;      	
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПересчитатьНомераВСтрокеДерева(СтрокаЗапроса,Сч)  	
	
	Выб = СтрокаЗапроса.Ссылка.ПолучитьОбъект();
	Выб.НомерРаботыВУровне = Сч;
	Выб.НомерРаботыВУровнеСтрокой = Формат(Сч,"ЧГ=0");
	Выб.ДополнительныеСвойства.Вставить("КопированиеСценария");
	Выб.Записать();
	
	СчетчикПодЗапроса = 1;
	
	Для Каждого ПодСтрока ИЗ СТрокаЗапроса.Строки Цикл
		
		Если ПодСтрока.Ссылка = СтрокаЗапроса.Ссылка Тогда
			Продолжить;
		КонецЕсли;
		
		ПересчитатьНомераВСтрокеДерева(ПодСтрока,СчетчикПодЗапроса);
		СчетчикПодЗапроса = СчетчикПодЗапроса+1;
		
	КонецЦикла;
	
КонецПроцедуры 

&НаСервереБезКонтекста
Процедура ПересчитатьНомераВУровне(ТекРодитель,ТекВладелец,Сч = 1,ПропускаемаяРабота = Неопределено)
	
	Выборка = Справочники.УСОERP_СтроительныеРаботы.Выбрать(ТекРодитель,ТекВладелец,,"НомерРаботыВУровне");
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		Если Выборка.Ссылка = ПропускаемаяРабота Тогда
			Продолжить;
		КонецЕсли; 		
		
		Если Выборка.НомерРаботыВУровне <> Сч  Тогда
			
			Выб = Выборка.ПолучитьОбъект();
			Выб.НомерРаботыВУровне = Сч;
			Выб.ОбменДанными.Загрузка = Истина;
			Выб.ДополнительныеСвойства.Вставить("КопированиеСценария",Истина);
			Выб.Записать();
			
		КонецЕсли;
		
		Сч = Сч+1;
		
	КонецЦикла;  
	
КонецПроцедуры    

&НаСервереБезКонтекста
Процедура ПереписатьНомераВУровне(Родитель,НомерРаботыВУровне,СсылкаНаСтаруюРаботу,Владелец)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Владелец",Владелец);
	Запрос.УстановитьПараметр("Родитель",Родитель);
	Запрос.УстановитьПараметр("НомерРаботыВУровне",НомерРаботыВУровне);
	Запрос.УстановитьПараметр("СсылкаНаСтаруюРаботу",СсылкаНаСтаруюРаботу);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботы.Ссылка
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	УСОERP_СтроительныеРаботы.Владелец = &Владелец
	|	И УСОERP_СтроительныеРаботы.Родитель = &Родитель
	|	И НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
	|	И (УСОERP_СтроительныеРаботы.НомерРаботыВУровне > &НомерРаботыВУровне
	|			ИЛИ УСОERP_СтроительныеРаботы.НомерРаботыВУровне = &НомерРаботыВУровне
	|				И УСОERP_СтроительныеРаботы.Ссылка = &СсылкаНаСтаруюРаботу)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Сч = НомерРаботыВУровне+2;
	Сч = НомерРаботыВУровне+1;
	
	Пока Выборка.Следующий() Цикл
		
		Выб = Выборка.Ссылка.ПолучитьОбъект();
		Выб.НомерРаботыВУровне = Сч;
		Выб.НомерРаботыВУровнеСтрокой = Формат(Сч,"ЧЦ=6; ЧГ=0");
		Выб.ДополнительныеСвойства.Вставить("КопированиеСценария");
		Выб.Записать();
		
		Сч = Сч+1;
		
	КонецЦикла; 	
	
КонецПроцедуры 

&НаКлиенте
Процедура РежимРедактированияСтрокиПриИзменении(Элемент)
	
	УстановитьВидимость();
	
	СписокПриАктивизацииСтроки(Элемент);	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьДанные(Команда)
	
	РассчитатьПроект();
	Элементы.Список.Обновить();	
	
	Если РежимРедактированияСтроки Тогда
