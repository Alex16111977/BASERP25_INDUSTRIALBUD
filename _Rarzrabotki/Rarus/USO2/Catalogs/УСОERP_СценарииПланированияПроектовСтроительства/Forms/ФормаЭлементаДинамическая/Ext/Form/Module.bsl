&НаСервере
Процедура КомандаВверхНаСервере()
	
	ТекРабота = Элементы.Список.ТекущаяСтрока;
	Родитель = ТекРабота.Родитель;
	
	Запрос  = Новый Запрос;
	
	Запрос.УстановитьПараметр("Родитель",Родитель);
	Запрос.УстановитьПараметр("Владелец",ТекРабота.Владелец);
	ТекНомерРаботыВУровне = ТекРабота.НомерРаботыВУровне;
	Запрос.УстановитьПараметр("НомерРаботыВУровне",ТекНомерРаботыВУровне);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботы.Ссылка
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	УСОERP_СтроительныеРаботы.Родитель = &Родитель
	|	И УСОERP_СтроительныеРаботы.Владелец = &Владелец
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_СтроительныеРаботы.НомерРаботыВУровне
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	УСОERP_СтроительныеРаботы.Ссылка
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	УСОERP_СтроительныеРаботы.Родитель = &Родитель
	|	И УСОERP_СтроительныеРаботы.Владелец = &Владелец
	|	И УСОERP_СтроительныеРаботы.НомерРаботыВУровне < &НомерРаботыВУровне
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_СтроительныеРаботы.НомерРаботыВУровне УБЫВ";
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	ВыборкаСледующая =ПакетЗапросов[1].Выбрать(); 
	
	СледующаяРабота = Неопределено;
	
	Если ВыборкаСледующая.Следующий() Тогда
		
		СледующаяРабота = ВыборкаСледующая.Ссылка;
		
	КонецЕсли;
	
	Если  СледующаяРабота = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ДобавитьРаботуВВарианты(ЗаполнитьСтруктуруРаботыНаСервере(ТекРабота),Истина);
	
	ТекРаботаОбъект = ТекРабота.ПолучитьОбъект();
	ТекРаботаОбъект.НомерРаботыВУровне = СледующаяРабота.НомерРаботыВУровне;
	ТекРаботаОбъект.ОбменДанными.Загрузка = Истина;
	ТекРаботаОбъект.Записать();
	
	ДобавитьРаботуВВарианты(ЗаполнитьСтруктуруРаботыНаСервере(ТекРаботаОбъект.Ссылка));
	
	СледующаяРаботаОбъект = СледующаяРабота.ПолучитьОбъект();
	СледующаяРаботаОбъект.НомерРаботыВУровне =  ТекНомерРаботыВУровне;
	
	СледующаяРаботаОбъект.ОбменДанными.Загрузка = Истина;
	СледующаяРаботаОбъект.Записать();  	
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	Выборка = ПакетЗапросов[0].Выбрать();
	
	Сч = 1;
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Ссылка.НомерРаботыВУровне <> Сч Тогда
			
			Выб = Выборка.Ссылка.ПолучитьОбъект();
			Выб.НомерРаботыВУровне = Сч;
			Выб.НомерРаботыВУровнеСтрокой = Формат(Выб.НомерРаботыВУровне,"ЧГ=0");
			Выб.ОбменДанными.Загрузка = Истина;
			Выб.ДополнительныеСвойства.Вставить("КопированиеСценария");
			Выб.Записать();
			
		КонецЕсли;
		
		Сч = Сч+1;
		
	КонецЦикла;
	
	Элементы.Список.Обновить(); 	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВверх(Команда)
	
	КомандаВверхНаСервере();
	
