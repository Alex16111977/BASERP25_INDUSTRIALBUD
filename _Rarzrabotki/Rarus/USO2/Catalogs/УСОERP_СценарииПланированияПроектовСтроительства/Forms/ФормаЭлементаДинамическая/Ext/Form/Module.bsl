КонецПроцедуры

#Область ОбработкаВариантов
&НаКлиенте
Процедура КомандаШагНазад(Команда)
	
	Если ТекущийВариант = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВосстановитьРаботуИзВарианта(ТекущийВариант-1);
	ТекущийВариант = ТекущийВариант-1;
	
	СписокПриАктивизацииСтроки(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаШагВперед(Команда)
	
	Если ТекущийВариант = ТекущиеВарианты.Количество() Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	ТекущийВариант = Макс(ТекущийВариант,1);
	
	ВосстановитьРаботуИзВарианта(ТекущийВариант+1); 
	ТекущийВариант = ТекущийВариант+1;
	
	СписокПриАктивизацииСтроки(Истина);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьРаботуВВарианты(СтруктураРаботы,Проверять = Ложь)
	
	Если Проверять Тогда
		
		Если  ТекущиеВарианты.НайтиСтроки(Новый Структура("Работа",СтруктураРаботы.Ссылка)).Количество() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли; 		
	
	Нстр = ТекущиеВарианты.Добавить();
	Нстр.НомерВарианта = ТекущиеВарианты.Количество();
	Нстр.ДанныеРаботы = СтруктураРаботы.Структура;
	Нстр.Работа = СтруктураРаботы.Ссылка;
	СтруктураРаботы = Неопределено;
	
	ТекущийВариант = ТекущиеВарианты.Количество();
	
КонецПроцедуры  

&НаСервере
Процедура ВосстановитьРаботуИзВарианта(НомерВарианта,Пересчитывать = Истина)
	
	Попытка
		
		Строка = ТекущиеВарианты.Получить(НомерВарианта-1);
		
	Исключение
		
		Возврат;
		
	КонецПопытки;
	
	НачатьТранзакцию();
	
	СтруктураРаботы = ЗначениеИзСтрокиВнутр(Строка.ДанныеРаботы);
	
	РаботаОбъект = СтруктураРаботы.Ссылка.ПолучитьОбъект();
	
	НадоПересчитатьНомераВУровне = РаботаОбъект.НомерРаботыВУровне <> СтруктураРаботы.НомерРаботыВУровне ИЛИ СтруктураРаботы.ПометкаУдаления ИЛИ РаботаОбъект.ПометкаУдаления;
	
	ИзменилсяРодитель = РаботаОбъект.Родитель <> СтруктураРаботы.Родитель ИЛИ СтруктураРаботы.ПометкаУдаления ИЛИ РаботаОбъект.ПометкаУдаления;
	СтарыйРодитель = РаботаОбъект.Родитель;
	ИзмениласьПометкаУдаления = РаботаОбъект.ПометкаУдаления <> СтруктураРаботы.ПометкаУдаления;
	
	ЗаполнитьЗначенияСвойств(РаботаОбъект,СтруктураРаботы);
	
	РаботаОбъект.Предшественники.Загрузить(СтруктураРаботы.Предшественники);
	РаботаОбъект.Материалы.Загрузить(СтруктураРаботы.Материалы);
	РаботаОбъект.Ресурсы.Загрузить(СтруктураРаботы.Ресурсы);
	
	РаботаОбъект.Наименование = СтруктураРаботы.Наименование;
	РаботаОбъект.Код = СтруктураРаботы.Код;
	РаботаОбъект.ПометкаУдаления = СтруктураРаботы.ПометкаУдаления;
	Если РаботаОбъект.ПометкаУдаления Тогда
		РаботаОбъект.НомерРаботыВУровне = 9999;
	КонецЕсли;
	РаботаОбъект.НомерРаботыВУровнеСтрокой = Формат(РаботаОбъект.НомерРаботыВУровне,"ЧГ=0");
	РаботаОбъект.Родитель = СтруктураРаботы.Родитель;
	
	Если НадоПересчитатьНомераВУровне ИЛИ ИзменилсяРодитель Тогда
		
		Выборка = Справочники.УСОERP_СтроительныеРаботы.Выбрать(СтруктураРаботы.Родитель,СценарийПланирования,,"НомерРаботыВУровне");
		ЭтоСуммарнаяРабота = Ложь;
		Сч = 1;
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			
			ЭтоСуммарнаяРабота = Истина;
			
			Если Сч = СтруктураРаботы.НомерРаботыВуровне Тогда
				Сч = Сч+1;
			КонецЕсли;
			
			Если Выборка.Ссылка = СтруктураРАботы.Ссылка  Тогда
				
				Продолжить;
				
			КонецЕсли;			
			
			Если Выборка.НомерРаботыВУровне <> Сч Тогда  				
				
				Выб = Выборка.ПолучитьОбъект();
				Выб.НомерРаботыВУровне = Сч;
				Выб.НомерРаботыВУровнеСтрокой = Формат(Выб.НомерРаботыВУровне,"ЧГ=0");
				Выб.ДополнительныеСвойства.Вставить("КопированиеСценария");
				Выб.Записать();
				
			КонецЕсли;
			
			Сч = Сч+1;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(СтруктураРаботы.Родитель) И СтруктураРаботы.Родитель.СуммарнаяРабота <> ЭтоСуммарнаяРабота Тогда
			
			РодительОбъект = СтруктураРаботы.Родитель.ПолучитьОбъект();
			РодительОбъект.СуммарнаяРабота = ЭтоСуммарнаяРабота;
			РодительОбъект.ДополнительныеСвойства.Вставить("КопированиеСценария");
			РодительОбъект.Записать();
			
		КонецЕсли;   		
		
	КонецЕсли; 	
	
	РаботаОбъект.ДополнительныеСвойства.Вставить("КопированиеСценария");
	РаботаОбъект.Записать();
	
	Если ИзменилсяРодитель Тогда
		
		Выборка = Справочники.УСОERP_СтроительныеРаботы.Выбрать(СтарыйРодитель,СценарийПланирования,,"НомерРаботыВУровне");  	
		ЭтоСуммарнаяРабота = Ложь;
		Сч = 1;
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.ПометкаУдаления Тогда
				
				Продолжить;
				
			КонецЕсли; 
			
			ЭтоСуммарнаяРабота = Истина;
			
			Если Выборка.НомерРаботыВУровне <> Сч Тогда
				
				Выб = Выборка.ПолучитьОбъект();
				Выб.НомерРаботыВУровне = Сч;
				Выб.НомерРаботыВУровнеСтрокой = Формат(Выб.НомерРаботыВУровне,"ЧГ=0");
				Выб.ДополнительныеСвойства.Вставить("КопированиеСценария");
				Выб.Записать();
				
			КонецЕсли;
			
			Сч = Сч+1; 		
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(СтарыйРодитель) И СтарыйРодитель.СуммарнаяРабота <> ЭтоСуммарнаяРабота Тогда
			
			СтарыйРодительОбъект = СтарыйРодитель.ПолучитьОбъект();
			СтарыйРодительОбъект.СуммарнаяРабота = ЭтоСуммарнаяРабота;
			СтарыйРодительОбъект.ДОполнительныеСвойства.Вставить("КопированиеСценария");
			СтарыйРодительОбъект.Записать();
			
		КонецЕсли; 	
		
	КонецЕсли;
	
	Если ИзмениласьПометкаУдаления И НЕ РаботаОбъект.Ссылка.ПометкаУдаления И РаботаОбъект.СуммарнаяРабота Тогда
		//надо снять пометку у подчиненных элементов
		
		Выборка = Справочники.УСОERP_СтроительныеРаботы.ВыбратьИерархически(РаботаОбъект.Ссылка,СценарийПланирования);
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.ПометкаУдаления Тогда
				
				Выб = Выборка.ПолучитьОбъект();
				Выб.ПометкаУдаления = Ложь;
				Выб.ДополнительныеСвойства.Вставить("КопированиеСценария");
				Выб.Записать();
				
			КонецЕсли; 			
			
		КонецЦикла; 
		
		//Надо пересчитать номера работ в уровне, у помеченных на удаление было 9999
		
		Если Пересчитывать Тогда
			
			ПересчитатьНомераВУровнеПроекта(СценарийПланирования);
			
		КонецЕсли;
		
	КонецЕсли; 	
	
	ЗафиксироватьТранзакцию();  
	
	Если Пересчитывать Тогда
		
		РассчитатьПроект();	
		Элементы.Список.Обновить();
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДомой(Команда)
	
	Если НЕ ТекущиеВарианты.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеВарианты.Количество() > 10 Тогда
		СписокОтветов = Новый СписокЗначений;
		СписокОтветов.Добавить(КодВозвратаДиалога.Да,"ДА");
		СписокОтветов.Добавить(КодВозвратаДиалога.Нет,"НЕТ");
		СписокОтветов.Добавить(КодВозвратаДиалога.Нет,"НЕ ЗНАЮ");
		ПоказатьВопрос(Новый ОписаниеОповещения("КомандаДомойПродолжение",ЭтотОбъект),"С момента открытия формы было сделано "+ТекущиеВарианты.Количество()+" изменений, уверены, что хотите откатить все в исходное состояние?",СписокОтветов);
	Иначе
		КомандаДомойПродолжение(КодВозвратаДиалога.Да,Новый Структура);
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДомойПродолжение(Ответ,ДопПараметры)Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ФормаДО = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтотОбъект,Новый УникальныйИдентификатор());
	ФормаДО.Элементы.ФормаОтмена.Видимость = Ложь;
	
	КомандаДомойНаСервере();
	
	ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДО);
	
	ТекущийВариант = 0; 
	
КонецПроцедуры  

&НаСервере
Процедура КомандаДомойНаСервере()
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТабВариантов",ТекущиеВарианты.Выгрузить());
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТабВариантов.НомерВарианта,
	|	ТабВариантов.Работа
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	&ТабВариантов КАК ТабВариантов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.НомерВарианта КАК НомерВарианта
	|ИЗ
	|	(ВЫБРАТЬ
	|		МИНИМУМ(ВрТаб.НомерВарианта) КАК НомерВарианта,
	|		ВрТаб.Работа КАК Работа
	|	ИЗ
	|		ВрТаб КАК ВрТаб
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВрТаб.Работа) КАК ВложенныйЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерВарианта УБЫВ";
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТЗ ИЗ ТЗ Цикл
		
		ВосстановитьРаботуИЗВарианта(СтрокаТЗ.НомерВарианта,СтрокаТЗ.НомерВарианта = 1);
		
	КонецЦикла; 	
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура КомандаУдалитьРаботу(Команда) 
	
	Если НЕ ЗначениеЗаполнено(Элементы.Список.ТекущаяСтрока) Тогда
		Возврат;
	КонецЕсли;  	
	
	Если БылоВыполнениеПоРаботе(Элементы.Список.ТекущаяСтрока) Тогда
		
		НачалоТекста = ?(Элементы.Список.ТекущиеДанные.СуммарнаяРабота,"По этапу ","По работе ");
		
		ПоказатьПредупреждение(,""+НачалоТекста+" "+Элементы.Список.ТекущаяСтрока+" были введены документы факта, удаление невозможно!");
		Возврат;
		
	КонецЕсли;	 
	
	ОписаниеОповещения = Новый ОписаниеОповещения("УдалитьРаботуПродолжение",ЭтотОбъект);
	
	ПоказатьВопрос(ОписаниеОповещения,"Будут удалены все данные работы, в том числе ссылки на предшественников,продолжить?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьРаботуПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтрока = Элементы.Список.ТекущаяСтрока;	
	
	УдалитьРаботуНаСервере(ТекСтрока);
	
	РассчитатьПроект();
	Элементы.Список.Обновить();	
	
КонецПроцедуры  

&НаСервере
Процедура УдалитьРаботуНаСервере(Работа)
	
	ДобавитьРаботуВВарианты(ЗаполнитьСтруктуруРаботыНаСервере(Работа),Истина);
	
	РаботаОбъект = Работа.ПолучитьОбъект(); 	
	
	РаботаОбъект.УстановитьПометкуУдаления(Истина);
	
	ДобавитьРаботуВВарианты(ЗаполнитьСтруктуруРаботыНаСервере(РаботаОбъект.Ссылка));
	
	//проверим, если у бывшего родителя нет больше подчиненных то его надо сделать не суммарной работой	
	
	Запрос = Новый Запрос; 
	
	Если ЗначениеЗаполнено(РаботаОбъект.Родитель) Тогда
		
		Запрос.УстановитьПараметр("Родитель",РаботаОбъект.Родитель);
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УСОERP_СтроительныеРаботы.Ссылка
		|ИЗ
		|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
		|ГДЕ
		|	НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
		|	И УСОERP_СтроительныеРаботы.Родитель = &Родитель";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если НЕ Выборка.Следующий() Тогда
			
			РодительОбъект = РаботаОбъект.Родитель.ПолучитьОбъект();
			РодительОбъект.СуммарнаяРабота = Ложь;
			РодительОбъект.Длительность = 1;
			РодительОбъект.ЕдиницаДлительности = Перечисления.ЕдиницыИзмеренияВремени.День;
			РодительОбъект.ДополнительныеСвойства.Вставить("КопированиеСценария");
			РодительОбъект.Записать();
			
		КонецЕсли;		
		
	КонецЕсли;   	
	
	Запрос.УстановитьПараметр("Работа",Работа);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботыПредшественники.Ссылка
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы.Предшественники КАК УСОERP_СтроительныеРаботыПредшественники
	|ГДЕ
	|	УСОERP_СтроительныеРаботыПредшественники.СтроительнаяРабота = &Работа
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_СтроительныеРаботыПредшественники.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Выб = Выборка.Ссылка.ПолучитьОбъект();
		Строки = Выб.Предшественники.НайтиСтроки(Новый Структура("СтроительнаяРабота",Работа));
		Для Каждого НайденнаяСтрока ИЗ Строки Цикл
			Выб.Предшественники.Удалить(НайденнаяСтрока);
		КонецЦикла;
		
		Выб.Записать();
		
	КонецЦикла;
	
	Родитель = Работа.Родитель;
	ПересчитатьНомераВУровне(Родитель,Работа.Владелец);
	
КонецПроцедуры 

&НаКлиенте
Процедура КомандаЗаписатьРаботу(Команда)
	
	ТекСтрока = Элементы.Список.ТекущаяСтрока;
	
	Если ТекМатериалы.НайтиСтроки(Новый Структура("КоличествоНаОбъемРаботы",0)).Количество() Тогда
		
		ПоказатьПредупреждение(,"Общее количество материала на объем работы меньше 0. Необходимо изменить норму на ед. объема.");
		Возврат;
		
	КонецЕсли;
	
	Строки = ТекМатериалы.НайтиСтроки(Новый Структура("ХарактеристикиИспользуются,Характеристика",Истина,ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка")));
	
	Если Строки.Количество() Тогда
		
		Для Каждого НайденнаяСтрока ИЗ Строки Цикл
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У номенклатуры "+НайденнаяСтрока.Номенклатура+" не указана характеристика");
			
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;		
	
	ДобавитьМатериалыВРаботуНаСервере(Элементы.Список.ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура  ДобавитьМатериалыВРаботуНаСервере(ТекРабота)
	
	РаботаОбъект = ТекРабота.ПолучитьОбъект();
	
	ДобавитьРаботуВВарианты(ЗаполнитьСтруктуруРаботыНаСервере(РаботаОбъект.Ссылка),Истина);
	РаботаОбъект.Материалы.Очистить();
	
	Для Каждого СтрокаМатериал ИЗ ТекМатериалы Цикл
		
		ЗаполнитьЗначенияСвойств(РаботаОбъект.Материалы.Добавить(),СтрокаМатериал);
		
	КонецЦикла;
	
	РаботаОбъект.Ресурсы.Очистить();
	
	Для Каждого СтрокаРесурс ИЗ ТекРесурсы Цикл
		
		ЗаполнитьЗначенияСвойств(РаботаОбъект.Ресурсы.Добавить(),СтрокаРесурс);
		
	КонецЦикла; 	
	
	РаботаОбъект.ОбменДанными.Загрузка = Истина;
	РаботаОбъект.ДополнительныеСвойства.Вставить("КопированиеСценария");
	РаботаОбъект.Записать(); 
	ДобавитьРаботуВВарианты(ЗаполнитьСтруктуруРаботыНаСервере(РаботаОбъект.Ссылка));
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриИзменении(Элемент)
	
	Если Элемент.ТекущиеДанные <> Неопределено И Элемент.ТекущиеДанные.СуммарнаяРабота <> Истина Тогда
		
		Если АвтоРасчет Тогда
			РассчитатьПроект();
		Иначе
			ЗаполнитьСтрокуПредшественников(Элемент.ТекущиеДанные.Ссылка);
			Элементы.Список.Обновить();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ОшибкаРасчета Тогда
		
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли; 	
	
	ЭтоГруппа           = ТекДанные.СуммарнаяРабота;
	ЕстьПредшественники = ТекДанные.ЕстьПредшественники;		
	
	ИмяПоля = Поле.Имя;
	ИмяКолонки = СтрЗаменить(ИмяПоля,"Список","");
	
	Если РежимРедактированияСтроки > 0  Тогда		
		
		Если ЭтоГруппа Тогда
			
			ОтказОткрытия = Истина;
			
			Если ИмяКолонки = "Наименование" Тогда
				
				ОтказОткрытия = Ложь;
				
			ИначеЕсли ИмяКолонки = "КодСДР" Тогда
				
				ОтказОткрытия = Объект.ВидКодаСДР = 0;	
				
			КонецЕсли;
			
			ТекПараметры = Новый Структура("ИмяКолонки",ИмяКолонки);
			
		Иначе
			
			ОтказОткрытия = Ложь;		
			
			Если ИмяКолонки = "ЕдиницаДлительности" Тогда
				
				СписокЗначений = Новый СписокЗначений;
				СписокЗначений.Добавить(ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.День"));
				СписокЗначений.Добавить(ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Час"));
				
				ТекПараметры = Новый Структура("ИмяКолонки",ИмяКолонки);
				
				ПоказатьВыборИзСписка(Новый ОписаниеОповещения("СписокВыбораВыборДлительности",ЭтотОбъект,ТекПараметры),СписокЗначений,,СписокЗначений.НайтиПоЗначению(ТекДанные.ЕдиницаДлительности));
				
				ОтказОткрытия = Истина;
				
			ИначеЕсли ИмяКолонки = "КодСДР" Тогда
				
				ОтказОткрытия = Объект.ВидКодаСДР = 0;
				
			ИначеЕсли ИмяКолонки = "Наименование" Тогда
				
			ИначеЕсли ИмяКолонки = "Предшественники" Тогда
				
				ОткрытьФорму("Справочник.УСОERP_СценарииПланированияПроектовСтроительства.Форма.ФормаПредшественников",Новый Структура("Работа,АдресТаблицы",ТекДанные.Ссылка,АдресТаблицыПроекта),ЭтаФорма,,,,Новый ОписаниеОповещения("ОбработкаВыбораПредшественников",ЭтотОбъект),РежимОткрытияОкнаФОрмы.БлокироватьОкноВладельца);
				
				ОтказОткрытия = Истина;
				
			Иначе 				
				
				Если ИмяКолонки = "Длительность" Тогда
					
					КЧ = Новый КвалификаторыЧисла(10,2,ДопустимыйЗнак.Неотрицательный);
					Массив = Новый Массив;
					Массив.Добавить(Тип("Число"));
					ТипЗначения = Новый ОписаниеТипов(Массив, , ,КЧ);					
										
				ИначеЕсли ИмяКолонки = "ОбъемРаботы" Тогда
					
					КЧ = Новый КвалификаторыЧисла(15,3,ДопустимыйЗнак.Неотрицательный);
					Массив = Новый Массив;
					Массив.Добавить(Тип("Число"));
					ТипЗначения = Новый ОписаниеТипов(Массив, , ,КЧ); 					
					
				ИначеЕсли ИмяКолонки = "ДатаНачала" Тогда
					
					ОтказОткрытия = ЕстьПредшественники;
					
					ТипЗначения = Новый ОписаниеТипов("Дата");
					
				ИначеЕсли ИмяКолонки = "ДатаОкончания" Тогда
					
					ОтказОткрытия = ЕстьПредшественники;
					
					ТипЗначения = Новый ОписаниеТипов("Дата");
					
				ИначеЕсли ИмяКолонки = "ЕдиницаОбъема" Тогда
					
					ОтказОткрытия = ТекДанные.ПроцентВыполнения > 0;
					Если НЕ ОтказОткрытия Тогда
						
						СтруктураОтбора = Новый Структура("Отбор",Новый Структура("Владелец",ПредопределенноеЗначение("Справочник.НаборыУпаковок.БазовыеЕдиницыИзмерения")));
						ОткрытьФорму("Справочник.УпаковкиЕдиницыИзмерения.Форма.ФормаВыбораЕдиницыИзмерения",СтруктураОтбора,ЭтотОбъект,,,,Новый ОписаниеОповещения("ВыборЕдиницыОбъемаЗавершение",ЭтотОбъект),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
						
					КонецЕсли;
					
					ОтказОткрытия = Истина;
					ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения");
					
				КонецЕсли; 					
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ИмяКолонки = "ПроцентВыполнения" ИЛИ ИмяКолонки = "КритическаяРабота" Тогда
			
			ОтказОткрытия = Истина;
			
		КонецЕсли;  	
		
		Если НЕ ОтказОткрытия Тогда
			
			СинонимКолонки = ИмяКолонки;
			
			Если ИмяКолонки = "ДатаОкончания" Тогда
				СинонимКолонки = "дату окончания";
			ИначеЕсли ИмяКолонки = "ДатаНачала" Тогда
				СинонимКолонки = "дату начала";
			ИначеЕсли ИмяКолонки = "ОбъемРаботы" Тогда
				СинонимКолонки = "объем работы";
			КонецЕсли;
			
			СинонимКолонки = НРЕГ(СинонимКолонки); 			
			
			ПоказатьВводЗначения(Новый ОписаниеОповещения("СписокВыборЗавершение",ЭтотОБъект,ТекПараметры),ТекДанные[ИмяКолонки],"Введите "+СинонимКолонки,ТипЗначения);
			
		КонецЕсли; 
		
	Иначе 
		
		ОписаниеОповещения = Новый ОписаниеОповещения("СписокВыборОкончание",ЭтотОбъект);  		
		
		СтруктураПараметров = Новый Структура("Ключ,УИДГрафика",Элементы.Список.ТекущаяСтрока,АдресТаблицыПроекта);	
		
		ЗаполнитьСтруктуруОткрываемойРаботы(Элементы.Список.ТекущаяСтрока);
		
		ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаЭлементаДинамическая", СтруктураПараметров,ЭтотОбъект,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли; 
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборЕдиницыОбъемаЗавершение(ВыбранноеЗначение,ДопПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокВыборЗавершение(ВыбранноеЗначение,"СписокЕдиницаОбъема");	
	
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьСтруктуруОткрываемойРаботы(Работа)
	
	СтруктураОткрываемойРаботы =  ЗаполнитьСтруктуруРаботыНаСервере(Работа);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаполнитьСтруктуруРаботыНаСервере(Работа) 	
	
	Структура = Новый Структура;
	Структура.Вставить("Код",Работа.Код);
	Структура.Вставить("Наименование",Работа.Наименование);
	Структура.Вставить("Ссылка",Работа);
	Структура.Вставить("ПометкаУдаления",Работа.ПометкаУдаления);
	Структура.Вставить("Родитель",Работа.Родитель);
	
	Для Каждого Реквизит ИЗ Метаданные.Справочники.УСОERP_СтроительныеРаботы.Реквизиты Цикл
		Структура.Вставить(Реквизит.Имя,Работа[Реквизит.Имя]);
	КонецЦикла;
	
	Структура.Вставить("Материалы",Работа.Материалы.Выгрузить());
	Структура.Вставить("Ресурсы",Работа.Ресурсы.Выгрузить());
	Структура.Вставить("Предшественники",Работа.Предшественники.Выгрузить());
	
	СтруктураВозврата = Новый Структура("Ссылка,Структура",Работа,ЗначениеВСтрокуВнутр(Структура));
	
	Возврат СтруктураВозврата;
	
КонецФункции  

&НаКлиенте
Процедура СписокВыборОкончание(ВыбЗначение,Параметр2) Экспорт
	
	Элементы.Список.Обновить();
		
КонецПроцедуры 

&НаКлиенте
Процедура ОбработкаВыбораПредшественников(ВыбЗначение,Параметр) Экспорт
	
	Если ВыбЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьПредшественниковНаСервере(ВыбЗначение);
	
	Если АвтоРасчет Тогда
		
		КомандаОбновитьДанные(Истина);
		
	Иначе
		
		Элементы.Список.Обновить();
			
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура  ЗаписатьПредшественниковНаСервере(ВыбЗначение)	
	
	РаботаОбъект = Элементы.Список.ТекущаяСтрока.ПолучитьОбъект();
	
	ДобавитьРаботуВВарианты(ЗаполнитьСтруктуруРаботыНаСервере(РаботаОбъект.Ссылка),Истина);
	РаботаОбъект.Предшественники.Очистить();
	РаботаОбъект.ОбменДанными.Загрузка = Истина;
	
	Для Каждого СтрокаТЧ ИЗ ВыбЗначение Цикл
		
		ЗаполнитьЗначенияСвойств(РаботаОбъект.Предшественники.Добавить(),СтрокаТЧ);
		
	КонецЦикла;
	
	РаботаОбъект.Записать();
	
	Если НЕ АвтоРасчет Тогда
		
		ЗаполнитьСтрокуПредшественников(РаботаОбъект.Ссылка);
		
	КонецЕсли;
	
	
	ДобавитьРаботуВВарианты(ЗаполнитьСтруктуруРаботыНаСервере(РаботаОбъект.Ссылка));
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуПредшественников(Работа)
	
	ТаблицаРабот = ПолучитьИзВременногоХранилища(АдресТаблицыПроекта);	
		
	СтрокаРаботы = ТаблицаРабот.Найти(Работа,"Работа");
	
	Если СтрокаРаботы = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли; 	
	
	Для Каждого СтрокаТЗ ИЗ Работа.Предшественники Цикл
		
		Задержка = СтрокаТЗ.Задержка;
		ЕдиницаЗадержки = СтрокаТЗ.ЕдиницаЗадержки;
		
		КодСДР = ПолучитьКодСДР(СтрокаТЗ.СтроительнаяРабота);
		Код = СтрокаТЗ.СтроительнаяРабота.Код;
		
		Если СтрокаТЗ.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.НачалоНачало Тогда
			
			СтрокаРаботы.СтрокаПредшественников = СтрокаРаботы.СтрокаПредшественников+""+КодСДР+" НН"+?(Задержка,"+"+Задержка+""+ЕдиницаЗадержки,"")+";";
			СтрокаРаботы.СтрокаПредшественниковКод = СтрокаРаботы.СтрокаПредшественниковКод+""+Код+" НН"+?(Задержка,"+"+Задержка+""+ЕдиницаЗадержки,"")+";";
			
		КонецЕсли;
		
		Если СтрокаТЗ.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.НачалоОкончание Тогда
			
			СтрокаРаботы.СтрокаПредшественников = СтрокаРаботы.СтрокаПредшественников+""+КодСДР+" НО"+?(Задержка,"+"+Задержка+""+ЕдиницаЗадержки,"")+";";
			СтрокаРаботы.СтрокаПредшественниковКод = СтрокаРаботы.СтрокаПредшественниковКод+""+Код+" НО"+?(Задержка,"+"+Задержка+""+ЕдиницаЗадержки,"")+";";
			
		КонецЕсли;
		
		Если СтрокаТЗ.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.ОкончаниеОкончание Тогда
			
			СтрокаРаботы.СтрокаПредшественников = СтрокаРаботы.СтрокаПредшественников+""+КодСДР+" ОО"+?(Задержка,"+"+Задержка+""+ЕдиницаЗадержки,"")+";";
			СтрокаРаботы.СтрокаПредшественниковКод = СтрокаРаботы.СтрокаПредшественниковКод+""+Код+" ОО"+?(Задержка,"+"+Задержка+""+ЕдиницаЗадержки,"")+";";
			
		КонецЕсли;
		
		Если СтрокаТЗ.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.ОкончаниеНачало Тогда
			
			СтрокаРаботы.СтрокаПредшественников    = СтрокаРаботы.СтрокаПредшественников+""+КодСДР+""+?(Задержка,"+"+Задержка+""+ЕдиницаЗадержки,"")+";";
			СтрокаРаботы.СтрокаПредшественниковКод = СтрокаРаботы.СтрокаПредшественниковКод+""+Код+""+?(Задержка,"+"+Задержка+""+ЕдиницаЗадержки,"")+";";
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаРаботы.СтрокаПредшественников    = Лев(СтрокаРаботы.СтрокаПредшественников,СтрДлина(СтрокаРаботы.СтрокаПредшественников)-1);
	СтрокаРаботы.СтрокаПредшественниковКод = Лев(СтрокаРаботы.СтрокаПредшественниковКод,СтрДлина(СтрокаРаботы.СтрокаПредшественниковКод)-1);
	
	Адрес = "";
	АдресТаблицыПроекта = ПоместитьВоВременноеХранилище(ТаблицаРабот,Адрес);   	
		
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗавершение(ВыбЗначение,Параметр) Экспорт
	
	Если ВыбЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимРедактированияСтроки = 1 Тогда 
		
		Параметр = Новый Структура("ИмяКолонки",СтрЗаменить(Элементы.Список.ТекущийЭлемент.Имя,"Список",""));
		
	КонецЕсли; 	
	
	ТекРабота = Элементы.Список.ТекущаяСтрока;
	ТекДанные = Элементы.Список.ТекущиеДанные;	
	
	ЗаполнитьДанныеПоРаботе(ВыбЗначение,Параметр,ТекРабота);
	
	Элементы.Список.Обновить();
	
	Если РежимРедактированияСтроки Тогда
		
		СписокПриАктивизацииСтроки(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте 
Процедура СписокВыбораВыборДлительности(ВыбЗначение,Параметр)Экспорт
	
	Если ВыбЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.Список.ТекущаяСтрока;
	
	ЗаполнитьДанныеПоРаботе(ВыбЗначение.Значение,Параметр,ТекДанные);
	
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьДанныеПоРаботе(ВыбЗначение,Параметр,Работа)
	
	ИмяКолонки = Параметр.ИмяКолонки;
	
	Если ИмяКолонки = "ДатаНачала" ИЛИ ИмяКолонки = "ДатаОкончания"  Тогда
		
		ПересчитатьДлительностьРаботы(ВыбЗначение,Параметр,Работа);
		Если АвтоРасчет Тогда
			РассчитатьПроект();
		КонецЕсли;
		
		Возврат;
	КонецЕсли;	
	
	РаботаОбъект = Работа.ПолучитьОбъект();
	
	Если РаботаОбъект[ИмяКолонки] = ВыбЗначение Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяКолонки = "ОбъемРаботы" Тогда
		
		ВыбЗначение = Макс(ВыбЗначение,Справочники.УСОERP_СтроительныеРаботы.ПолучитьВыполненныйОбъем(Работа));	
		
	КонецЕсли;
	
	ДобавитьРаботуВВарианты(ЗаполнитьСтруктуруРаботыНаСервере(Работа),Истина);
	
	РаботаОбъект[Параметр.ИмяКолонки] = ВыбЗначение;
	РаботаОбъект.ОбменДанными.Загрузка = Истина;
	РаботаОбъект.Записать();
	ДобавитьРаботуВВарианты(ЗаполнитьСтруктуруРаботыНаСервере(РаботаОбъект.Ссылка));
	
	Если Параметр.ИмяКолонки = "Наименование" 
		ИЛИ ИмяКолонки = "КодСДР" 
		ИЛИ ИмяКолонки = "Код"
		Или ИмяКолонки = "ОбъемРаботы" 
		ИЛИ ИмяКолонки = "ЕдиницаОбъема" Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если АвтоРасчет Тогда	
		
		РассчитатьПроект();
		
	КонецЕсли;
	
	Элементы.Список.Обновить(); 
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьДлительностьРаботы(ВыбЗначение,Параметр,Работа)
	
	Задержка = УСОERP_ЗащищенныеФункцииСервер.ПосчитатьЗадержкуРаботыПоПараметру(Работа,Параметр.ИмяКолонки,ВыбЗначение);
	
	РаботаОбъект = Работа.ПолучитьОбъект();
	РаботаОбъект.Задержка = Задержка;
	РаботаОбъект.ДополнительныеСвойства.Вставить("КопированиеСценария");
	РаботаОбъект.Записать();	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаписатьТекущуюРаботу(Команда)
	
	ЗаписатьТекущуюРаботуНаСервере(); 
	Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаСтраницаПроект;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьТекущуюРаботуНаСервере()	
	
КонецПроцедуры 

&НаКлиенте
Процедура КомандаНазадВДеревоПроекта(Команда)
	
	Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаСтраницаПроект;
	
КонецПроцедуры

&НаСервере  
Процедура ЗаполнитьЦвета()
	
	ЦветЗапланированного 		= WebЦвета.Васильковый;
	ЦветНеПросроченного  		= ЦветаСтиля.ОтметкаПоложительногоВыполненияЗадачи;
	ЦветПросроченного    		= ЦветаСтиля.ПоясняющийОшибкуТекст;
	ЦветВыполненного     		= ЦветаСтиля.ЗавершенныйБизнесПроцесс; 
	ЦветНеНазначенного   		= WebЦвета.НейтральноКоричневый;
	ЦветРодителя         		= WebЦвета.Черный;
	ЦветРаботыДругогоВладельца 	= WebЦвета.ЗеленоватоЖелтый;
	ЦветРаботыКритическая		= WebЦвета.Кирпичный;
	ЦветСерииПоУмолчанию		= WebЦвета.СероСиний; 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПоказатьРесурсы(Команда)
	
	Элементы.КомандаПоказатьРесурсыСписок.Пометка = НЕ Элементы.КомандаПоказатьРесурсыСписок.Пометка;
	Элементы.СписокКопияКомандаПоказатьРесурсыСписок.Пометка = НЕ Элементы.СписокКопияКомандаПоказатьРесурсыСписок.Пометка;
	УстановитьВидимость();
	ЗаполнитьТекущуюРаботу();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеПослеИзмененияРаботы(СтруктураРаботы,СтруктураРаботыПосле) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СтруктураРаботы.Ссылка) Тогда
		Возврат;
	КонецЕсли;
		
	ДобавитьРаботуВВарианты(СтруктураРаботы,Истина);
	ДобавитьРаботуВВарианты(СтруктураРаботыПосле);
	
	Если АвтоРасчет Тогда
		
		КомандаОбновитьДанные(Истина);	
		
	Иначе
		
		Элементы.Список.Обновить();	
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТекМатериалыКоличествоУпаковокНаЕдиницуОбъемаПриИзменении(Элемент)
	
	ОбъемРаботы = Элементы.Список.ТекущиеДанные.ОбъемРаботы;
	
	ТекущаяСтрока	= Элементы.ТекМатериалы.ТекущиеДанные;
	ТекущаяСтрока.КоличествоУпаковокНаОбъемРаботы	= ТекущаяСтрока.КоличествоУпаковокНаЕдиницуОбъема * ОбъемРаботы;
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "НаЕдиницуОбъема");
	ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "НаОбъемРаботы");
	ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

&НаКлиенте
Процедура ТекМатериалыКоличествоУпаковокНаОбъемРаботыПриИзменении(Элемент)
	
	ОбъемРаботы = Элементы.Список.ТекущиеДанные.ОбъемРаботы;
	
	ТекущаяСтрока	= Элементы.ТекМатериалы.ТекущиеДанные;
	ТекущаяСтрока.КоличествоУпаковокНаЕдиницуОбъема	= ТекущаяСтрока.КоличествоУпаковокНаОбъемРаботы/ОбъемРаботы;
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "НаЕдиницуОбъема");
	ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "НаОбъемРаботы");
	ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения); 	
	
КонецПроцедуры

&НаКлиенте
Процедура ТекМатериалыНоменклатураПриИзменении(Элемент)
	
	ТекущаяСтрока	= Элементы.ТекМатериалы.ТекущиеДанные;
	
	СтруктураДействий	= Новый Структура;
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу",       ТекущаяСтрока.Характеристика);
	СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу",    ТекущаяСтрока.Упаковка);
	
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
	ЭтаФорма.ИмяФормы, "ТекМатериалы"));
	
	ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

&НаКлиенте
Процедура ТекМатериалыУпаковкаПриИзменении(Элемент)
	
	ТекМатериалыКоличествоУпаковокНаЕдиницуОбъемаПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДобавитьРаботуСледующую(Команда) 	
	
	ТекСтрока = Элементы.Список.ТекущаяСтрока;
	ТекДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекДанные = Неопределено ИЛИ ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВариантПереносаПредшественников = 0 Тогда
		
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да,"Да");
		СписокКнопок.Добавить(КодВозвратаДиалога.Нет,"Нет");
		СписокКнопок.Добавить(КодВозвратаДиалога.ОК,"Да, больше не спрашивать");
		СписокКнопок.Добавить(КодВозвратаДиалога.Повторить,"Нет, больше не спрашивать");
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьРаботуСледующуюПродолжение",ЭтотОбъект);
		
		ПоказатьВопрос(ОписаниеОповещения,"Добавить текущую работу в предшественники?",СписокКнопок,,,"При создании новой работы...");
		
	Иначе
		
		ДобавитьРаботуСледующуюПродолжение(КодВозвратаДиалога.Да,Новый Структура);
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте  
Процедура ДобавитьРаботуСледующуюПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Ответ) Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтрока = Элементы.Список.ТекущаяСтрока;
	ТекДанные = Элементы.Список.ТекущиеДанные; 
	
	Если Ответ = КодВозвратаДиалога.ОК Тогда
		ВариантПереносаПредшественников = 1;
	КонецЕсли;
	
	Если Ответ = КодВозвратаДиалога.Повторить Тогда
		ВариантПереносаПредшественников = 2; 		
	КонецЕсли;
	
	ДобавитьПредшественников =  ВариантПереносаПредшественников = 1 ИЛИ Ответ = КодВозвратаДиалога.Да;
	
	ДопПараметры = Новый Структура;
	Родитель = ПолучитьРодителяРаботы(ТекСтрока);
	ДопПараметры.Вставить("НомерРаботыВУровне",?(ТекДанные.НомерРаботыВУровне = Неопределено,1,ТекДанные.НомерРаботыВУровне+1));
	ДопПараметры.Вставить("Родитель",Родитель);
	ДопПараметры.Вставить("СсылкаНаСтаруюРаботу",ПолучитьСтаруюРаботу(ТекДанные.НомерРаботыВУровне,Родитель,СценарийПланирования));
	
	СтруктураРаботы = Новый Структура("Владелец",СценарийПланирования);
	СтруктураРаботы.Вставить("Родитель",Родитель);	
	СтруктураРаботы.Вставить("Переносить",Ложь);
	СтруктураРаботы.Вставить("НомерРаботыВУровне",?(ТекДанные.НомерРаботыВУровне = Неопределено,1,ТекДанные.НомерРаботыВУровне+1));
	
	Если ДобавитьПредшественников Тогда  	
		
		СтруктураРаботы.Вставить("Предшественник",ПолучитьПредшественника(ТекСтрока,ТекДанные.ДатаОкончания,АдресТаблицыПроекта));
		
	КонецЕсли; 	
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьРаботуЗавершение",ЭтотОбъект,ДопПараметры);
	ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаЭлементаДинамическая",СтруктураРаботы,ЭтотОБъект,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредшественника(Работа,ДатаОкончания,УИД)
	
	Если НЕ Работа.СуммарнаяРабота Тогда
		Возврат Работа;
	КонецЕсли;
	
	ТаблицаРабот = ПолучитьИзВременногоХранилища(УИД);
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТаблицаРабот",ТаблицаРабот);
	Запрос.УстановитьПараметр("Родитель",Работа);
	Запрос.УстановитьПараметр("ДатаОкончания",ДатаОкончания);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТаблицаРабот.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	ТаблицаРабот.ДатаОкончания КАК ДатаОкончания
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	&ТаблицаРабот КАК ТаблицаРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.Работа КАК Работа
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|ГДЕ
	|	ВрТаб.Работа В ИЕРАРХИИ(&Родитель)
	|	И НЕ ВрТаб.Работа.СуммарнаяРабота
	|	И ВрТаб.ДатаОкончания = &ДатаОкончания
	|	И НЕ ВрТаб.Работа.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Работа;
	КонецЕсли;
	
	Возврат Справочники.УСОERP_СтроительныеРаботы.ПустаяСсылка();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРодителяРаботы(Работа)
	
	Возврат Работа.Родитель;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСтаруюРаботу(НомерРаботыВУровне,Родитель,СценарийПланирования)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Владелец",СценарийПланирования);
	Запрос.УстановитьПараметр("Родитель",?(Родитель = Неопределено,Справочники.УСОERP_СтроительныеРаботы.ПустаяСсылка(),Родитель));
	Запрос.УстановитьПараметр("НомерРаботыВУровне",НомерРаботыВУровне);
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УСОERP_СтроительныеРаботы.Ссылка
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
	|	И УСОERP_СтроительныеРаботы.Владелец = &Владелец
	|	И УСОERP_СтроительныеРаботы.Родитель = &Родитель
	|	И УСОERP_СтроительныеРаботы.НомерРаботыВУровне > &НомерРаботыВУровне
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_СтроительныеРаботы.НомерРаботыВУровне";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.УСОERP_СтроительныеРаботы.ПустаяСсылка();	
	
КонецФункции

&НаСервереБезКонтекста
Функция БылоВыполнениеПоРаботе(Работа)
	
	Если НЕ ЗначениеЗаполнено(Работа) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Работа",Работа);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_УчетВыполненныхРабот.Работа
	|ИЗ
	|	РегистрНакопления.УСОERP_УчетВыполненныхРабот КАК УСОERP_УчетВыполненныхРабот
	|ГДЕ  УСОERP_УчетВыполненныхРабот.Работа =&Работа";
	//|	УСОERP_УчетВыполненныхРабот.Работа В ИЕРАРХИИ(&Работа)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Следующий();
	
КонецФункции

&НаКлиенте
Процедура ТекРесурсыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ДлительностьВЧасах = Элементы.Список.ТекущиеДанные.ДлительностьВЧасах;
	
	ИдСтроки = Элементы.ТекРесурсы.ТекущиеДанные.ПолучитьИдентификатор();
	РассчитатьМашиноТрудоЕмкость(ИдСтроки,ДлительностьВЧасах);
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьМашиноТрудоЕмкость(ИдСтроки,ДлительностьВЧасах)	
	
	СтрокаРесурс = ТекРесурсы.НайтиПоИдентификатору(ИдСтроки);
	СтрокаРесурс.Трудоемкость = ДлительностьВЧасах*СтрокаРесурс.Ресурс.Рабочие.Количество()*СтрокаРесурс.Количество*СтрокаРесурс.ЗагрузкаПроцент/100;
	СтрокаРесурс.Машиноемкость = ДлительностьВЧасах*СтрокаРесурс.Ресурс.Механизмы.Количество()*СтрокаРесурс.Количество*СтрокаРесурс.ЗагрузкаПроцент/100;
	
КонецПроцедуры

&НаКлиенте
Процедура ВладелецПриИзменении(Элемент)
	
	ВладелецПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ВладелецПриИзмененииНаСервере()
	
	Объект.НачалоСтроительства = Объект.Владелец.НачалоСтроительства;
	Объект.ОкончаниеСтроительства = Объект.Владелец.ОкончаниеСтроительства;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьКопиюСценария(Команда)
	
	Перем НовыйСценарий;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) ИЛИ ЭтотОбъект.Модифицированность Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо записать сценарий!");
		Возврат;
		
	КонецЕсли;
	
	УСОERP_ЗащищенныеФункцииСервер.СохранитьКопиюСценария(Объект.Ссылка,НовыйСценарий,Ложь);
	ОткрытьФорму("Справочник.УСОERP_СценарииПланированияПроектовСтроительства.Форма.ФормаЭлементаДинамическая",Новый Структура("Ключ",НовыйСценарий));
	
КонецПроцедуры 

&НаКлиенте
Процедура КомандаПересчитатьНомераВУровне(Команда) 
	
	ФормаДО = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтотОбъект,Новый УникальныйИдентификатор());
	ФормаДО.Элементы.ФормаЗакрыть.Видимость = Ложь;
	ФормаДО.Элементы.ДекорацияПоясняющийТекстДлительнойОперации.Заголовок = "Пересчет кодов СДР, пожалуйста, подождите...";
	
	ПересчитатьНомераВУровнеПроекта(СценарийПланирования);
	
	Элементы.Список.Обновить();
	
	ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДО);
	
КонецПроцедуры  

&НаКлиенте
Процедура КомандаСоздатьВерсиюСценария(Команда)
	Перем НовыйСценарий;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) ИЛИ ЭтотОбъект.Модифицированность Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо записать сценарий!");
		Возврат;
		
	КонецЕсли;
	
	УСОERP_ЗащищенныеФункцииСервер.СохранитьКопиюСценария(Объект.Ссылка,НовыйСценарий);
	
	Элементы.СписокВерсии.Обновить();
	
	ОткрытьФорму("Справочник.УСОERP_СценарииПланированияПроектовСтроительства.Форма.ФормаЭлементаДинамическая",Новый Структура("Ключ",НовыйСценарий));
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСценарияПриИзменении(Элемент)
	УправлениеЭлементамиФормы(ЭтаФорма);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеЭлементамиФормы(Форма)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	Элементы.ФормаКомандаСоздатьВерсиюСценария.Видимость = Объект.ВидСценария <> ПредопределенноеЗначение("Перечисление.УСОERP_ВидыСценариевПланирования.Рабочий");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура КомандаЗаполнитьРегистрСоответствияНаСервере(Сценарий)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сценарий",Сценарий);
	Запрос.УстановитьПараметр("НомерВерсии",Сценарий.НомерВерсии);
	Запрос.УстановитьПараметр("ГоловнойСценарий",Сценарий.ГоловнойСценарий);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботы.Ссылка КАК Работа,
	|	УСОERP_СтроительныеРаботы.РаботаИсточник КАК РаботаИсточник
	|ПОМЕСТИТЬ ВрТаб_Работы
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	УСОERP_СтроительныеРаботы.Владелец = &Сценарий
	|	И НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
	|	И НЕ УСОERP_СтроительныеРаботы.СуммарнаяРабота
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	СУММА(УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя.Владелец.НомерВерсии) КАК РаботаВнешняяВладелецНомерВерсии,
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя.Владелец КАК РаботаВнешняяВладелец
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	РегистрСведений.УСОERP_СоответствиеРаботРаботамЗаказчика КАК УСОERP_СоответствиеРаботРаботамЗаказчика
	|ГДЕ
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя.Владелец.НомерВерсии < &НомерВерсии
	|	И ВЫБОР
	|			КОГДА УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя.Владелец.НомерВерсии = 0
	|				ТОГДА УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя.Владелец = &ГоловнойСценарий
	|			ИНАЧЕ УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя.Владелец.ГоловнойСценарий = &ГоловнойСценарий
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя.Владелец
	|
	|УПОРЯДОЧИТЬ ПО
	|	РаботаВнешняяВладелецНомерВерсии УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.Работа КАК Работа,
	|	ВрТаб_Работы.Работа КАК РаботаВнешняя,
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.РаспределениеСтоимостиРабот КАК РаспределениеСтоимостиРабот
	|ИЗ
	|	РегистрСведений.УСОERP_СоответствиеРаботРаботамЗаказчика КАК УСОERP_СоответствиеРаботРаботамЗаказчика
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВрТаб КАК ВрТаб
	|		ПО УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя.Владелец = ВрТаб.РаботаВнешняяВладелец
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВрТаб_Работы КАК ВрТаб_Работы
	|		ПО (ВЫБОР
	|				КОГДА УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя.Владелец.НомерВерсии = 0
	|					ТОГДА УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя = ВрТаб_Работы.РаботаИсточник
	|				ИНАЧЕ УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя.РаботаИсточник = ВрТаб_Работы.РаботаИсточник
	|			КОНЕЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.Работа КАК Работа,
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя КАК РаботаВнешняя,
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.РаспределениеСтоимостиРабот КАК РаспределениеСтоимостиРабот
	|ИЗ
	|	РегистрСведений.УСОERP_СоответствиеРаботРаботамЗаказчика КАК УСОERP_СоответствиеРаботРаботамЗаказчика
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВрТаб_Работы КАК ВрТаб_Работы
	|		ПО УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя = ВрТаб_Работы.Работа";
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	Выборка = ПакетЗапросов[3].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МЗ = РегистрыСведений.УСОERP_СоответствиеРаботРаботамЗаказчика.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ,Выборка);
		МЗ.Удалить();
		
	КонецЦикла; 	
	
	Выборка = ПакетЗапросов[2].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МЗ = РегистрыСведений.УСОERP_СоответствиеРаботРаботамЗаказчика.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ,Выборка);
		МЗ.Записать(Истина);
		
	КонецЦикла;   	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьРегистрСоответствия(Команда)
	
	ТекСтрока = Элементы.СписокВерсии.ТекущаяСтрока;
	ТекДанные = Элементы.СписокВерсии.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура("Сценарий",ТекСтрока);
	
	Если ЕстьЗаписиВРегистреСоответствия(ТекСтрока) Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьРегистрСоответствияПродолжение",ЭтотОбъект,СтруктураПараметров);
		ПоказатьВопрос(ОписаниеОповещения,"В регистре уже есть записи по версии сценария № "+ТекДанные.НомерВерсии+", перезаписать?",РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьРегистрСоответствияПродолжение(КодВозвратаДиалога.Да,СтруктураПараметров);
	КонецЕсли; 	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьЗаписиВРегистреСоответствия(Сценарий)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сценарий",Сценарий);
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя КАК РаботаВнешняя
	|ИЗ
	|	РегистрСведений.УСОERP_СоответствиеРаботРаботамЗаказчика КАК УСОERP_СоответствиеРаботРаботамЗаказчика
	|ГДЕ
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя.Владелец = &Сценарий";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Следующий();	
	
КонецФункции  

&НаКлиенте
Процедура  ЗаполнитьРегистрСоответствияПродолжение(Ответ,СтруктураПараметров) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		
		Возврат;
		
	КонецЕсли;
	
	КомандаЗаполнитьРегистрСоответствияНаСервере(СтруктураПараметров.Сценарий);  	
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	ОшибкаРасчетаПроекта =  Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ОшибкаРасчетаПроекта")).Значение;
	
	Если ОшибкаРасчетаПроекта Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка расчета проекта!");
		
	Иначе    
		
		АдресТаблицы = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("АдресТаблицы")).Значение;
		Если ЗначениеЗаполнено(АдресТаблицы) Тогда
		ТаблицаПроекта = ПолучитьИзВременногоХранилища(АдресТаблицы);
		Сценарий = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("СценарийПланирования")).Значение;
		ВидКодаСДР = Сценарий.ВидКодаСДР;
		Доп = ?(ВидКодаСДР,"Код",""); 	
		
		Для Каждого НайденнаяСтрока ИЗ Строки Цикл 
			
			ДанныеСтроки = НайденнаяСтрока.Значение.Данные;
			
			Работа = НайденнаяСтрока.Ключ;
			
			СтрокаРаботы = ТаблицаПроекта.Найти(Работа,"Работа");
			
			Если СтрокаРаботы = Неопределено Тогда
				Продолжить;
			КонецЕсли; 		
			
			Если ВидКодаСДР = 0 Тогда
				
				НайденнаяСтрока.Значение.Данные.КодСДР = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДР(Работа);			
				
			КонецЕсли; 		
			
			Если ДанныеСтроки.СуммарнаяРабота Тогда
				
				ЗаполнитьЗначенияСвойств(ДанныеСтроки,СтрокаРаботы,"ДатаНачала,ДатаОкончания,ПроцентВыполнения,ОшибкаРасчета,Длительность");
				
			Иначе
				
				ЗаполнитьЗначенияСвойств(ДанныеСтроки,СтрокаРаботы,"ДатаНачала,ДатаОкончания,ПроцентВыполнения,ОшибкаРасчета,ДлительностьВЧасах");
				
			КонецЕсли;
			
			Если ДанныеСтроки.Свойство("Ресурсы") Тогда
				
				Для Каждого СтрокаРесурс ИЗ ДанныеСтроки.Ресурсы Цикл
					
					СтрокаРесурс.Трудоемкость = СтрокаРаботы.ДлительностьВЧасах*СтрокаРесурс.Ресурс.Рабочие.Количество()*СтрокаРесурс.Количество*СтрокаРесурс.ЗагрузкаПроцент/100;
					СтрокаРесурс.Машиноемкость = СтрокаРаботы.ДлительностьВЧасах*СтрокаРесурс.Ресурс.Механизмы.Количество()*СтрокаРесурс.Количество*СтрокаРесурс.ЗагрузкаПроцент/100;
					
				КонецЦикла;	
				
			КонецЕсли;
			
			ДанныеСтроки.Предшественники = СтрокаРаботы["СтрокаПредшественников"+Доп];		
			
		КонецЦикла;
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ТекРесурсыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование) 	
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ТекСтрока = Элементы.ТекРесурсы.ТекущиеДанные;
		ТекСтрока.Количество = 1;
		ТекСтрока.ЗагрузкаПроцент = 100;
