	Элементы.КомандаПоказатьМатериалыСписок.Пометка = НЕ Элементы.КомандаПоказатьМатериалыСписок.Пометка;
	Элементы.СписокКопияКомандаПоказатьМатериалыСписок.Пометка = НЕ Элементы.СписокКопияКомандаПоказатьМатериалыСписок.Пометка;
	
	УстановитьВидимость();	
	ЗаполнитьТекущуюРаботу();
	
