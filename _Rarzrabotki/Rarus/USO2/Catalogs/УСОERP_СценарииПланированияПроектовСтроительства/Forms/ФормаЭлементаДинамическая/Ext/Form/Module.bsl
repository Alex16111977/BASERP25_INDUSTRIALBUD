&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЖирныйШрифт = Новый Шрифт(,,Истина);  	
	
	Элемент = УсловноеОформление.Элементы.Добавить(); 	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Список.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.ИндексКартинки");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 0; 	
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ЖирныйШрифт);
	
	Элемент = УсловноеОформление.Элементы.Добавить();	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокКопия.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СписокКопия.ИндексКартинки");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 0; 	
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ЖирныйШрифт);
	
	Элемент = УсловноеОформление.Элементы.Добавить();	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Список.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.ОшибкаРасчета");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина; 	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный); 
	
	НоменклатураСервер.УстановитьУсловноеОформлениеЕдиницИзмерения(ЭтотОбъект,"ТекМатериалыНоменклатураЕдиницаИзмерения","ТекМатериалы.Упаковка");
	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект,"ТекМатериалыХарактеристика","ТекМатериалы.ХарактеристикиИспользуются");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыСписка()
	
	Список.Отбор.Элементы.Очистить();
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВерсии,"СценарийПланирования",Объект.Ссылка,Истина);
	
	Список.Параметры.УстановитьЗначениеПараметра("СценарийПланирования",СценарийПланирования);	
	Список.Параметры.УстановитьЗначениеПараметра("АдресТаблицы",АдресТаблицыПроекта); 
	Список.Параметры.УстановитьЗначениеПараметра("ОшибкаРасчетаПроекта",ОшибкаРасчета);
		
	ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));	
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ПравоеЗначение = СценарийПланирования;
	
	СписокКопия.Параметры.УстановитьЗначениеПараметра("СценарийПланирования",СценарийПланирования);
	ЭлементОтбора = СписокКопия.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));	
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ПравоеЗначение = СценарийПланирования;
	
КонецПроцедуры  

&НаКлиенте
Процедура ЗаполнитьТекущуюРаботу()
	
	Если РежимРедактированияСтроки = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.Список.ТекущиеДанные = Неопределено Тогда
		
		ТекМатериалы.Очистить();
		ТекРесурсы.Очистить();
		Возврат;
		
	КонецЕсли;
	
	РедактируемаяРабота = Элементы.Список.ТекущаяСтрока;
	ДлительностьВЧасах = Элементы.Список.ТекущиеДанные.ДлительностьВЧасах;
	
	ЗаполнитьТекущуюРаботуНаСервере(ДлительностьВЧасах);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекущуюРаботуНаСервере(ДлительностьВЧасах = 0)
	
	ТекМатериалы.Загрузить(РедактируемаяРабота.Материалы.Выгрузить());
	
	Для Каждого Строка ИЗ ТекМатериалы Цикл
		
		Строка.ХарактеристикиИспользуются = Строка.Номенклатура.ИспользованиеХарактеристик <> Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
		
	КонецЦикла;
	
	ТекРесурсы.Загрузить(РедактируемаяРабота.Ресурсы.Выгрузить());
	
	Для Каждого СтрокаРесурсы ИЗ ТекРесурсы Цикл
		
		СтрокаРесурсы.Трудоемкость =  ДлительностьВЧасах*СтрокаРесурсы.Количество*СтрокаРесурсы.Ресурс.Рабочие.Количество()*СтрокаРесурсы.ЗагрузкаПроцент/100;
		
		СтрокаРесурсы.Машиноемкость = ДлительностьВЧасах*СтрокаРесурсы.Количество*СтрокаРесурсы.Ресурс.Механизмы.Количество()*СтрокаРесурсы.ЗагрузкаПроцент/100;
		
	КонецЦикла; 	
	
	ТекПредшественники.Загрузить(РедактируемаяРабота.Предшественники.Выгрузить()); 		
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьПроект()	
	
	Попытка
		
		ТаблицаПроекта =  УСОERP_ЗащищенныеФункцииСервер.РассчитатьПроект(СценарийПланирования);
		
		Адрес = ""; 	
		АдресТаблицыПроекта = ПоместитьВоВременноеХранилище(ТаблицаПроекта,Адрес);
		Список.Параметры.УстановитьЗначениеПараметра("АдресТаблицы",АдресТаблицыПроекта);
		
		ОшибкаРасчета = Ложь;
		
	Исключение
		
		ОшибкаРасчета = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка расчета проекта!");
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКодСДР(Работа)
	
	Возврат УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДР(Работа); 	
		
КонецФункции 

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ВидСценарияУникален = Справочники.УСОERP_СценарииПланированияПроектовСтроительства.ВидСценарияУникален(ТекущийОбъект);
	
	Если Не ВидСценарияУникален Тогда
		
		ТекстСообщения = НСтр("ru='Для обекта строительства ""<Владелец>"" уже существует сценарий планирования с видом ""<ВидСценария>""'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "<Владелец>", Строка(ТекущийОбъект.Владелец));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "<ВидСценария>", Строка(ТекущийОбъект.ВидСценария));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "ВидСценария", "Объект"); 
		Отказ = Истина;
		
	КонецЕсли;
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ВидСценарияПроверен", Истина);
	
КонецПроцедуры

&НаСервере
Процедура ВывестиПодчиненныеСтроки(СтрокаДерева,СтрокаФайла)
	
	Для Каждого ПодСтрока ИЗ СтрокаФайла.Строки Цикл 		
		
		НовСтр = СтрокаДерева.Строки.Добавить();
		НовСтр.ИндексКартинки =  ?(ПодСтрока.Строки.Количество(),0,3);
		ЗаполнитьЗначенияСвойств(НовСтр,ПодСтрока); 		
		ВывестиПодчиненныеСтроки(НовСтр,ПодСтрока);
		
	КонецЦикла; 	
	
КонецПроцедуры   

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.КомандаПоказатьМатериалыСписок.Пометка            = Ложь;
	Элементы.КомандаПоказатьРесурсыСписок.Пометка              = Ложь;
	
	Элементы.СписокКопияКомандаПоказатьМатериалыСписок.Пометка = Ложь;
	Элементы.СписокКопияКомандаПоказатьРесурсыСписок.Пометка = Ложь;
	
	УстановитьВидимость(); 	
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.СтраницаОсновное;
		
	КонецЕсли;	
	
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьВидимость()		
	
	Элементы.ГруппаСтраницРесурсыМатериалы.Видимость = РежимРедактированияСтроки > 0 ИЛИ  Элементы.КомандаПоказатьМатериалыСписок.Пометка ИЛИ Элементы.КомандаПоказатьРесурсыСписок.Пометка;
	Элементы.ГруппаСтраницаРабота.Видимость = РежимРедактированияСтроки = 1 И (Элементы.КомандаПоказатьМатериалыСписок.Пометка ИЛИ Элементы.КомандаПоказатьРесурсыСписок.Пометка);
	Элементы.ГруппаСтраницаРаботаШапкаЛево.Видимость = РежимРедактированияСтроки = 1 И Элементы.КомандаПоказатьМатериалыСписок.Пометка;
	Элементы.ГруппаСтраницаРаботаШапкаПраво.Видимость = РежимРедактированияСтроки = 1 И Элементы.КомандаПоказатьРесурсыСписок.Пометка;
	Элементы.ГруппаСтраницРесурсыМатериалы.ТекущаяСтраница = ?(РежимРедактированияСтроки = 0,Элементы.ГруппаСтраницаРесурсыМатериалы,Элементы.ГруппаСтраницаРабота);
	Элементы.ГруппаМатериалы.Видимость = Элементы.КомандаПоказатьМатериалыСписок.Пометка;
	Элементы.ГруппаРесурсы.Видимость = Элементы.КомандаПоказатьРесурсыСписок.Пометка;
	Элементы.СписокВерсии.Видимость = Объект.НомерВерсии =0;
	Элементы.ГруппаСтраницаКопияРесурсыМатериалы.Видимость = Элементы.КомандаПоказатьМатериалыСписок.Пометка ИЛИ Элементы.КомандаПоказатьРесурсыСписок.Пометка;
	Элементы.СписокМатериалыКопия.Видимость =  Элементы.КомандаПоказатьМатериалыСписок.Пометка;
	Элементы.СписокРесурсыКопия.Видимость = Элементы.КомандаПоказатьРесурсыСписок.Пометка;
	
	Элементы.СписокВерсииКомандаЗаполнитьРегистрСоответствия.Видимость = Объект.ВидСценария = ПредопределенноеЗначение("Перечисление.УСОERP_ВидыСценариевПланирования.ВнешнийРабочий");
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	РедактируемаяРабота = Элементы.Список.ТекущаяСтрока;
	
	ЗаполнитьТекущуюРаботу();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДобавитьРаботу(Команда)
	
	ТекРодитель = Элементы.Список.ТекущаяСтрока;
	
	Если ТекРодитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если БылоВыполнениеПоРаботе(ТекРодитель) Тогда
		
		ПоказатьПредупреждение(,"По работе "+УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДР(ТекРодитель)+"."+ТекРодитель+" было выполнение!");
		Возврат;
		
	КонецЕсли;  	
	
	Если НужноЗадатьВопросВправо(ТекРодитель) Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ДобавитьРаботуПродолжение",ЭтотОбъект),"Перенести в работу материалы,ресурсы,предшественника из нового родителя?",РежимДиалогаВопрос.ДаНетОтмена);
		
	Иначе
		
		ДобавитьРаботуПродолжение(КодВозвратаДиалога.Нет,Новый Структура);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРаботуЗавершение(РезультатЗакрытия,ДопПараметры) Экспорт
	
	Если НЕ ЗНачениеЗаполнено(РезультатЗакрытия) Тогда
		
		Возврат;
		
	КонецЕсли;
		
	Если ТипЗнч(ДопПараметры) = Тип("Структура") И ДопПараметры.Свойство("НомерРаботыВУровне") Тогда
		
		ПереписатьНомераВУровне(ДопПараметры.Родитель,ДопПараметры.НомерРаботыВУровне,ДопПараметры.СсылкаНаСтаруюРаботу,СценарийПланирования);
		
	КонецЕсли;
	
	КомандаОбновитьДанные(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРаботуПродолжение(Ответ,ДопПараметры)Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена  Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураРаботы = Новый Структура("Владелец",СценарийПланирования);
	
	Если Элементы.Список.ТекущаяСтрока <> Неопределено Тогда
		
		СтруктураРаботы.Вставить("Родитель",Элементы.Список.ТекущаяСтрока);
		
	КонецЕсли;
	
	СтруктураРаботы.Вставить("Переносить",Ответ = КодВозвратаДиалога.Да);  
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьРаботуЗавершение",ЭтотОбъект);
	ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаЭлементаДинамическая",СтруктураРаботы,ЭтотОбъект,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#Область ЗадатьВопрос

&НаСервере
Функция НужноЗадатьВопросВправо(ТекРодитель = Неопределено) 
	
	Если ТекРодитель<> Неопределено Тогда
		Возврат ТекРодитель.Материалы.Количество()+ТекРодитель.Ресурсы.Количество()+ТекРодитель.Предшественники.Количество()+ЭтоПредшественник(ТекРодитель) > 0;
	КонецЕсли;
	
	ТекРабота = Элементы.Список.ТекущаяСтрока; 
	
	ТекРодитель = Справочники.УСОERP_СтроительныеРаботы.НайтиПоРеквизиту("НомерРаботыВУровне",ТекРабота.НомерРаботыВУровне-1,ТекРабота.Родитель,СценарийПланирования);
	
	Возврат ТекРодитель.Материалы.Количество()+ТекРодитель.Ресурсы.Количество()+ТекРодитель.Предшественники.Количество() > 0;
	
КонецФункции  

&НаСервереБезКонтекста
Функция ЭтоПредшественник(Работа)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Работа",Работа);
	
	Запрос.Текст = 
	"ВЫБРАТЬ  ПЕРВЫЕ 1
	|	УСОERP_СтроительныеРаботыПредшественники.Ссылка
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы.Предшественники КАК УСОERP_СтроительныеРаботыПредшественники
	|ГДЕ
	|	УСОERP_СтроительныеРаботыПредшественники.СтроительнаяРабота = &Работа";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Следующий(); 	 
	
КонецФункции   

