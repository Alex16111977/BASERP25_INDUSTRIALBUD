#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  	
	
	СобытияФорм.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
		// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Объект.НовыйВариант = Истина;
		Объект.ВидСценария = Перечисления.УСОERP_ВидыСценариевПланирования.Базовый;
		Если Параметры.Свойство("Владелец") Тогда
			Объект.Владелец = Параметры.Владелец; 
			Объект.НачалоСтроительства = Объект.Владелец.НачалоСтроительства;
			Объект.ОкончаниеСтроительства = Объект.Владелец.ОкончаниеСтроительства;
			Объект.Наименование  = ""+Объект.Владелец+" (базовый)";
		КонецЕсли; 
		
	КонецЕсли; 	
			
	СценарийПланирования  = Объект.Ссылка;
	НомерВерсии = СценарийПланирования.НомерВерсии;
	
	АвтоРасчет = Истина;
	
	УстановитьУсловноеОформление();	
	
	Если НЕ СценарийПланирования.НомерВерсии И ЗначениеЗаполнено(Объект.Ссылка) Тогда  		
		
	  РассчитатьПроект();
			
	КонецЕсли;
	
	УстановитьПараметрыСписка(); 
	
	Элементы.ГруппаСтраницаКопияПроекта.Видимость = СценарийПланирования.НомерВерсии;
	Элементы.ГруппаСтраницаПроект.Видимость = НЕ СценарийПланирования.НомерВерсии;
	
	ЭтотОбъект.ТолькоПросмотр = Объект.НомерВерсии;
	ЭтотОбъект.Заголовок = Объект.Наименование+?(Объект.НомерВерсии," (версия "+Объект.НомерВерсии+" от "+Формат(Объект.ДатаСохранения,"ДФ=dd.MM.yyyy")+")","");
	
	УправлениеЭлементамиФормы(ЭтаФорма);
	ЗаполнитьЦвета(); 	
		
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект,Новый Структура("Источники, КоманднаяПанель, ПрефиксГрупп",Неопределено,Элементы.СписокКопия.КоманднаяПанель,"Копия"));
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	
КонецПроцедуры

