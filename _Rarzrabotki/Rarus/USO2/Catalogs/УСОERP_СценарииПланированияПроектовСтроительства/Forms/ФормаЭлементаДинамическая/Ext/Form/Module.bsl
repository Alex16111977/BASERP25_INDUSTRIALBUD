#КонецОбласти

#Область ДиаграммаГанта  

&НаСервере
Процедура ЗаполнитьДиаграммуГанта() Экспорт	 
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Получаем диаграмму и запрещаем на время заполнения ее обновление.
	// В случае большого объема данных это существенно ускорит выполнение.
	Диаграмма = ДиаграммаГанта;
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	Диаграмма.ИнтервалыФона.Очистить();
	
	Для Каждого Шкала Из Диаграмма.ОбластьПостроения.ШкалаВремени.Элементы Цикл
		Шкала.Метки.Очистить();
	КонецЦикла;	
	
	Диаграмма.ОтображатьЛегенду = Ложь;
	Диаграмма.ОтображатьЗаголовок = Ложь;
	Диаграмма.ОбластьПостроения.Право = 1;
	
	// Создаем таблицу значений, в которую, по мере обхода запроса, будем заносить связи.
	Связи = Новый ТаблицаЗначений;
	Связи.Колонки.Добавить("Конец");
	Связи.Колонки.Добавить("Начало");
	Связи.Колонки.Добавить("ТипЗависимости");
	
	// Серия будет одна.
	Серия = Диаграмма.Серии.Добавить();
	Серия.Цвет	= WebЦвета.СероСиний;
	
	// Заводим переменные для определения максимальной и минимальной дат работ.
	МаксимальнаяДата = NULL;
	МинимальнаяДата = NULL;
	
	Запрос = Новый Запрос; 
	
	Запрос.УстановитьПараметр("СценарийПланирования",СценарийПланирования);
	
	Если НомерВерсии Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УСОERP_СтроительныеРаботы.Ссылка КАК Ссылка,
		|	УСОERP_СтроительныеРаботы.ДатаНачала КАК НачалоРаботыПлан,
		|	УСОERP_СтроительныеРаботы.ДатаОкончания КАК ОкончаниеРаботыПлан,
		|	""("" + ВЫБОР
		|		КОГДА УСОERP_СтроительныеРаботы.Владелец.ВидКодаСДР > 0
		|			ТОГДА УСОERP_СтроительныеРаботы.Код
		|		ИНАЧЕ УСОERP_СтроительныеРаботы.КодСДР
		|	КОНЕЦ + "") "" + УСОERP_СтроительныеРаботы.Наименование КАК Наименование,
		|	УСОERP_СтроительныеРаботы.КритическаяРабота,
		|	ВЫБОР
		|		КОГДА УСОERP_СтроительныеРаботы.Родитель = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ УСОERP_СтроительныеРаботы.Родитель
		|	КОНЕЦ КАК ДляУстановкиТочки,
		|	УСОERP_СтроительныеРаботы.СуммарнаяРабота
		|ИЗ
		|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
		|ГДЕ
		|	УСОERP_СтроительныеРаботы.Владелец = &СценарийПланирования
		|
		|УПОРЯДОЧИТЬ ПО
		|	УСОERP_СтроительныеРаботы.НомерРаботыВУровне
		|ИТОГИ ПО
		|	Ссылка ИЕРАРХИЯ";
		
	Иначе
		
		Если ОшибкаРасчета Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка расчета проекта!");
			Возврат;
			
		КонецЕсли;  		
		
		ТаблицаПроекта = ПолучитьИзВременногоХранилища(АдресТаблицыПроекта);
		Запрос.УстановитьПараметр("ТаблицаПроекта",ТаблицаПроекта);
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаПроекта.Работа КАК Работа,
		|	ТаблицаПроекта.ДатаНачала КАК ДатаНачала,
		|	ТаблицаПроекта.ДатаОкончания КАК ДатаОкончания
		|ПОМЕСТИТЬ ВрТаб
		|ИЗ
		|	&ТаблицаПроекта КАК ТаблицаПроекта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УСОERP_СтроительныеРаботы.Ссылка КАК Ссылка,
		|	МИНИМУМ(ВрТаб.ДатаНачала) КАК НачалоРаботыПлан,
		|	МАКСИМУМ(ВрТаб.ДатаОкончания) КАК ОкончаниеРаботыПлан,
		|	УСОERP_СтроительныеРаботы.Наименование КАК Наименование,
		|	УСОERP_СтроительныеРаботы.КритическаяРабота КАК КритическаяРабота,
		|	ВЫБОР
		|		КОГДА УСОERP_СтроительныеРаботы.Родитель = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ УСОERP_СтроительныеРаботы.Родитель
		|	КОНЕЦ КАК ДляУстановкиТочки,
		|	УСОERP_СтроительныеРаботы.СуммарнаяРабота КАК СуммарнаяРабота
		|ИЗ
		|	ВрТаб КАК ВрТаб
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
		|		ПО ВрТаб.Работа = УСОERP_СтроительныеРаботы.Ссылка
		|ГДЕ
		|	УСОERP_СтроительныеРаботы.Владелец = &СценарийПланирования
		|	И НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
		|
		|СГРУППИРОВАТЬ ПО
		|	УСОERP_СтроительныеРаботы.Ссылка,
		|	ВЫБОР
		|		КОГДА УСОERP_СтроительныеРаботы.Родитель = ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ УСОERP_СтроительныеРаботы.Родитель
		|	КОНЕЦ,
		|	УСОERP_СтроительныеРаботы.КритическаяРабота,
		|	УСОERP_СтроительныеРаботы.СуммарнаяРабота,
		|	УСОERP_СтроительныеРаботы.Наименование
		|
		|УПОРЯДОЧИТЬ ПО
		|	УСОERP_СтроительныеРаботы.НомерРаботыВУровне
		|ИТОГИ
		|	МИНИМУМ(НачалоРаботыПлан),
		|	МАКСИМУМ(ОкончаниеРаботыПлан)
		|ПО
		|	Ссылка ИЕРАРХИЯ";

	КонецЕсли;
	
	ТЗ = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	Для Каждого СтрокаДерева ИЗ ТЗ.Строки Цикл
		
		
		Если НЕ ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ЗаполнитьОднуТочкуДиаграммыГанта(СтрокаДерева, Связи, Серия, МаксимальнаяДата, МинимальнаяДата);
		
	КонецЦикла;  	
	
	Если МинимальнаяДата <> NULL Тогда
		
		День = 3600 * 24;
		Неделя = 3600 * 24 * 7;
		МаксимальнаяДата = МаксимальнаяДата + Неделя * 4;
		
		ГрафикРаботы = СценарийПланирования.Владелец.ГрафикРаботы;
		
		РабочиеДни = Справочники.Календари.ПрочитатьДанныеГрафикаИзРегистра(ГрафикРаботы, Год(МинимальнаяДата));
		Если Год(МаксимальнаяДата) > Год(МинимальнаяДата) Тогда 
			ТекГод = Год(МинимальнаяДата) + 1;
			Пока ТекГод <= Год(МаксимальнаяДата) Цикл
				врРабочиеДни = Справочники.Календари.ПрочитатьДанныеГрафикаИзРегистра(ГрафикРаботы, ТекГод);
				Для Каждого Элемент Из врРабочиеДни Цикл
					РабочиеДни.Вставить(Элемент.Ключ, Элемент.Значение);
				КонецЦикла;	
				ТекГод = ТекГод + 1;
			КонецЦикла;	
		КонецЕсли;	 
		
		ТекДата = МинимальнаяДата;
		Пока ТекДата <= МаксимальнаяДата Цикл;
			
			РабочийДень = (РабочиеДни.Получить(НачалоДня(ТекДата)) <> Неопределено);
			
			Если Не РабочийДень Тогда
				
				Кон = КонецДня(ТекДата);
				Нач = НачалоДня(ТекДата);
				Диаграмма.ИнтервалыФона.Добавить(Нач, Кон);
				
			КонецЕсли;	
			
			ТекДата = ТекДата + День;
			
		КонецЦикла;		
		
	КонецЕсли;
	
	// По заполненной таблице создаем связи.
	СоздатьСвязиНаДиаграммеГанта(Связи, Диаграмма, Серия);
	
	// Находим элемент шкалы времени для непериодических меток.
	ЭлементМеток = ПолучитьЭлементДляМеток(Диаграмма);
	
	// Создаем метку - текущая дата
	Метка = ЭлементМеток.Метки.Добавить(ТекущаяДата());
	Метка.Текст = НСтр("ru = 'Текущая дата'");
	Метка.ЦветТекста = WebЦвета.СинеСерый;
	Метка.ЦветЛинии = Метка.ЦветТекста; 	
	
	// Включаем обновление диаграммы.
	Диаграмма.Обновление = Истина;  	
	
	Диаграмма.ПоддержкаМасштаба = ПоддержкаМасштабаДиаграммыГанта.Авто; 

КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьДиаграммуГанта(Команда)
	
	ЗаполнитьДиаграммуГанта();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолосаРегулированияПриИзменении(Элемент)
	ПолосаРегулированияПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПолосаРегулированияПриИзмененииНаСервере()
	
	ДиаграммаГанта.ПоддержкаМасштаба 					= ПоддержкаМасштабаДиаграммыГанта.Период;
	ДиаграммаГанта.ЕдиницаПериодическогоВарианта 		= ТипЕдиницыШкалыВремени["День"];
	ДиаграммаГанта.КратностьПериодическогоВарианта 		= ?(ПолосаРегулированияДиаграммыГанта < 1, 1, ПолосаРегулированияДиаграммыГанта);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЭлементДляМеток(Диаграмма)
	
	// Ищем элемент шкалы времени с ОтображатьПериодическиеМетки = Ложь
	Для Каждого Элемент Из Диаграмма.ОбластьПостроения.ШкалаВремени.Элементы Цикл
		
		Если Элемент.ОтображатьПериодическиеМетки = Ложь Тогда
			ЭлементМеток = Элемент;
			Возврат ЭлементМеток;
		КонецЕсли;			
		
	КонецЦикла;						
	
	ЭлементМеток = Диаграмма.ОбластьПостроения.ШкалаВремени.Элементы.Добавить();
	ЭлементМеток.Единица = ТипЕдиницыШкалыВремени.День;
	ЭлементМеток.ОтображатьПериодическиеМетки = Ложь;
	
	Возврат ЭлементМеток;
	
КонецФункции // ПолучитьЭлементДляМеток(Диаграмма)

&НаСервере
Процедура СоздатьСвязиНаДиаграммеГанта(Связи, Диаграмма, Серия)
	
	ТекущаяТочка = NULL;
	Для Каждого Связь Из Связи Цикл 
		
		Если ТекущаяТочка = NULL Или ТекущаяТочка.Значение <> Связь.Конец Тогда
			ТекущаяТочка = Диаграмма.УстановитьТочку(Связь.Конец);
		КонецЕсли;			
		
		ТочкаНачала = Диаграмма.УстановитьТочку(Связь.Начало);
		Значение = Диаграмма.ПолучитьЗначение(ТочкаНачала, Серия);
		Для Каждого Интервал Из Значение Цикл
			ИнтервалНачала = Интервал;
			Прервать;
		КонецЦикла;				
		Значение = Диаграмма.ПолучитьЗначение(ТекущаяТочка, Серия);
		Для Каждого Интервал Из Значение Цикл
			ИнтервалКонца = Интервал;
			Прервать;
		КонецЦикла;	
		
		ИнтервалыРавны = Ложь;
		Если ИнтервалНачала <> Неопределено И ИнтервалКонца <> Неопределено Тогда
			Если (ИнтервалНачала.Значение <> Неопределено И ИнтервалКонца.Значение <> Неопределено И 
				ИнтервалНачала.Значение.Текст = ИнтервалКонца.Значение.Текст)
				И ИнтервалНачала.Конец = ИнтервалКонца.Конец 
				И ИнтервалНачала.Начало = ИнтервалКонца.Начало Тогда
				ИнтервалыРавны = Истина;
			КонецЕсли;	
		КонецЕсли;
		
		Если ИнтервалНачала = Неопределено ИЛИ ИнтервалКонца = Неопределено 
			ИЛИ ИнтервалыРавны Тогда
			Продолжить;
		КонецЕсли;
		
		СвязьДобавленная = ИнтервалНачала.Добавить(ИнтервалКонца);
		
		Если Связь.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.НачалоНачало Тогда
			СвязьДобавленная.ТипСвязи = ТипСвязиДиаграммыГанта.НачалоНачало;
		ИначеЕсли Связь.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.НачалоОкончание Тогда
			СвязьДобавленная.ТипСвязи = ТипСвязиДиаграммыГанта.НачалоКонец;
		ИначеЕсли Связь.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.ОкончаниеНачало Тогда
			СвязьДобавленная.ТипСвязи = ТипСвязиДиаграммыГанта.КонецНачало;
		ИначеЕсли Связь.ТипЗависимости = Перечисления.УСОERP_ТипыЗависимостейРабот.ОкончаниеОкончание Тогда
			СвязьДобавленная.ТипСвязи = ТипСвязиДиаграммыГанта.КонецКонец;
		КонецЕсли;	
		
		Если ИнтервалНачала.Конец <= ИнтервалКонца.Начало Тогда
			СвязьДобавленная.Цвет = WebЦвета.Синий;
		Иначе			
			СвязьДобавленная.Цвет = WebЦвета.Красный;
		КонецЕсли;			
		
	КонецЦикла;				
	
КонецПроцедуры // СоздатьСвязи(Связи, Диаграмма, Серия)

&НаСервере
Процедура УстановитьТекстЗначения(Интервал)
	
	Интервал.Значение.Текст = Строка(День(Интервал.Начало)) + "." 
	+ Строка(Месяц(Интервал.Начало)) + "-" 
	+ Строка(День(Интервал.Конец)) + "." 
	+ Строка(Месяц(Интервал.Конец));
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОднуТочкуДиаграммыГанта(СтрокаДерева, Связи, Серия, МаксимальнаяДата, МинимальнаяДата, РаботыДругогоВладельца = Ложь)
	
	КритическиеЗадачи = Истина;
	
	Диаграмма = ДиаграммаГанта;
	
	ДатаНачала 		= СтрокаДерева.НачалоРаботыПлан;
	ДатаОкончания 	= СтрокаДерева.ОкончаниеРаботыПлан; 	
	
	НужноДобавитьСтроку = Истина;
	
	// Если даты не заполнены и нет дочерних Работ - не добавляем точку
	Если Не ЗначениеЗаполнено(ДатаНачала) И Не ЗначениеЗаполнено(ДатаОкончания) И НЕ СтрокаДерева.Ссылка.СуммарнаяРабота Тогда
		
		НужноДобавитьСтроку = Ложь;
		
	КонецЕсли;	
	
	Если НужноДобавитьСтроку Тогда 		
		
		Точка = Диаграмма.УстановитьТочку(СтрокаДерева.Ссылка,СтрокаДерева.ДляУстановкиТочки);												
		
		Точка.Текст = "("+УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДР(СтрокаДерева.Ссылка)+") "+СтрокаДерева.Наименование;
		
		// Инициализируем значение.
		Значение = Диаграмма.ПолучитьЗначение(Точка, Серия);
		
		Если ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания) Тогда	
			
			//Значение.Редактирование = Истина;
			
			// Добавляем интервал. В данном примере у каждой работы единственный интервал.
			Интервал = Значение.Добавить();
			Интервал.Начало = ДатаНачала;
			Интервал.Конец  = ДатаОкончания;
			
			// Формируем подпись.
			УстановитьТекстЗначения(Интервал);
			
			ЭтоРодитель = СтрокаДерева.СуммарнаяРабота;   
			
			Если КритическиеЗадачи и СтрокаДерева.КритическаяРабота И НЕ ЭтоРодитель Тогда
				Значение.Цвет	= ЦветРаботыКритическая;		
			ИначеЕсли РаботыДругогоВладельца Тогда 
				Значение.Цвет = ЦветРаботыДругогоВладельца;
			Иначе				
				Если ЭтоРодитель Тогда
					Значение.Цвет = ЦветРодителя;
				ИначеЕсли ДатаОкончания < ТекущаяДатаСеанса() Тогда
					Значение.Цвет = ЦветПросроченного;
				ИначеЕсли ДатаНачала < ТекущаяДатаСеанса() Тогда 		
					Значение.Цвет = ЦветНеНазначенного;
				Иначе
					Значение.Цвет = ЦветЗапланированного;
				КонецЕсли;
			КонецЕсли;
			
			// Если надо, корректируем максимальную и минимальную даты.
			Если МаксимальнаяДата = NULL Или МаксимальнаяДата < ДатаОкончания Тогда
				МаксимальнаяДата = ДатаОкончания;
			КонецЕсли;				
			
			Если МинимальнаяДата = NULL Или МинимальнаяДата > ДатаНачала Тогда
				МинимальнаяДата = ДатаНачала;
			КонецЕсли;	
			
			// Получаем связи данной работы и заносим в таблицу.
			Если НЕ РаботыДругогоВладельца Тогда				
				
				Для Каждого СтрокаДереваПред Из СтрокаДерева.Ссылка.Предшественники Цикл
					
					Если ЗначениеЗаполнено(СтрокаДереваПред.СтроительнаяРабота) И СтрокаДереваПред.СтроительнаяРабота.ПометкаУдаления Тогда 
						
						Продолжить;
						
					КонецЕсли;
					
					Связь = Связи.Добавить();
					Связь.Начало 		 = СтрокаДереваПред.СтроительнаяРабота;
					Связь.Конец 		 = СтрокаДерева.Ссылка;
					Связь.ТипЗависимости = СтрокаДереваПред.ТипЗависимости;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Для Каждого ПодСтрока ИЗ СтрокаДерева.Строки Цикл
			
			ЗаполнитьОднуТочкуДиаграммыГанта(ПодСтрока, Связи, Серия, МаксимальнаяДата, МинимальнаяДата);
			
		КонецЦикла;		
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура КомандаОбновитьДиаграммуГантаКонструктивНаСервере()
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("СценарийПланирования",СценарийПланирования); 	
	
	Если СценарийПланирования.НомерВерсии Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УСОERP_СтроительныеРаботыКонструктивы.Конструктив КАК Конструктив,
		|	УСОERP_СтроительныеРаботыКонструктивы.Ссылка КАК Работа,
		|	ВЫБОР
		|		КОГДА УСОERP_СтроительныеРаботыКонструктивы.Ссылка.Владелец.ВидКодаСДР > 0
		|			ТОГДА ""("" + УСОERP_СтроительныеРаботыКонструктивы.Ссылка.Код
		|		ИНАЧЕ ""("" + УСОERP_СтроительныеРаботыКонструктивы.Ссылка.КодСДР
		|	КОНЕЦ + "") "" + УСОERP_СтроительныеРаботыКонструктивы.Ссылка.Наименование КАК Наименование,
		|	УСОERP_СтроительныеРаботыКонструктивы.Ссылка.ДатаНачала КАК ДатаНачала,
		|	УСОERP_СтроительныеРаботыКонструктивы.Ссылка.ДатаОкончания КАК ДатаОкончания,
		|	УСОERP_СтроительныеРаботыКонструктивы.Ссылка.КритическаяРабота КАК КритическаяРабота
		|ИЗ
		|	Справочник.УСОERP_СтроительныеРаботы.Конструктивы КАК УСОERP_СтроительныеРаботыКонструктивы
		|ГДЕ
		|	УСОERP_СтроительныеРаботыКонструктивы.Ссылка.Владелец = &СценарийПланирования
		|	И НЕ УСОERP_СтроительныеРаботыКонструктивы.Ссылка.ПометкаУдаления
		|	И НЕ УСОERP_СтроительныеРаботыКонструктивы.Ссылка.СуммарнаяРабота
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаНачала,
		|	УСОERP_СтроительныеРаботыКонструктивы.Конструктив,
		|	УСОERP_СтроительныеРаботыКонструктивы.Ссылка.НомерРаботыВУровне
		|ИТОГИ
		|	МИНИМУМ(ДатаНачала),
		|	МАКСИМУМ(ДатаОкончания)
		|ПО
		|	Конструктив";
		
	Иначе  	
		
		Если ОшибкаРасчета Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка расчета проекта!");
			Возврат;
		КонецЕсли;
		
		ТаблицаРабот = ПолучитьИзВременногоХранилища(АдресТаблицыПроекта);
		
		Запрос.УстановитьПараметр("ТаблицаРабот",ТаблицаРабот);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТаблицаРабот.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
		|	ТаблицаРабот.ДатаНачала КАК ДатаНачала,
		|	ТаблицаРабот.ДатаОкончания КАК ДатаОкончания
		|ПОМЕСТИТЬ ВрТаб
		|ИЗ
		|	&ТаблицаРабот КАК ТаблицаРабот
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТаб.Работа КАК Работа,
		|	ВрТаб.ДатаНачала КАК ДатаНачала,
		|	ВрТаб.ДатаОкончания КАК ДатаОкончания,
		|	ВрТаб.Работа.Наименование КАК Наименование,
		|	УСОERP_СтроительныеРаботыКонструктивы.Конструктив КАК Конструктив,
		|	ВрТаб.Работа.КритическаяРабота КАК КритическаяРабота
		|ИЗ
		|	ВрТаб КАК ВрТаб
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УСОERP_СтроительныеРаботы.Конструктивы КАК УСОERP_СтроительныеРаботыКонструктивы
		|		ПО ВрТаб.Работа = УСОERP_СтроительныеРаботыКонструктивы.Ссылка
		|ГДЕ
		|	ВрТаб.Работа.Владелец = &СценарийПланирования
		|	И НЕ ВрТаб.Работа.СуммарнаяРабота
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаНачала,
		|	Конструктив,
		|	ВрТаб.Работа.НомерРаботыВУровне
		|ИТОГИ
		|	МИНИМУМ(ДатаНачала),
		|	МАКСИМУМ(ДатаОкончания)
		|ПО
		|	Конструктив";
		
	КонецЕсли;
	
	ТЗ = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТаблицаРабот = Запрос.Выполнить().Выгрузить();
	
	ЖирныйШрифт = Новый Шрифт(,,Истина);
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Получаем диаграмму и запрещаем на время заполнения ее обновление.
	// В случае большого объема данных это существенно ускорит выполнение.
	
	ДиаграммаГантаКонструктив.Обновление = Ложь;
	ДиаграммаГантаКонструктив.Очистить();
	ДиаграммаГантаКонструктив.ИнтервалыФона.Очистить();
	
	Для Каждого Шкала Из ДиаграммаГантаКонструктив.ОбластьПостроения.ШкалаВремени.Элементы Цикл
		Шкала.Метки.Очистить();
	КонецЦикла;	
	
	ДиаграммаГантаКонструктив.ОтображатьЛегенду = Ложь;
	ДиаграммаГантаКонструктив.ОтображатьЗаголовок = Ложь;
	ДиаграммаГантаКонструктив.ОбластьПостроения.Право = 1;
	
	// Создаем таблицу значений, в которую, по мере обхода запроса, будем заносить связи.
	Связи = Новый ТаблицаЗначений;
	Связи.Колонки.Добавить("Конец");
	Связи.Колонки.Добавить("Начало");
	Связи.Колонки.Добавить("Конструктив");
	Связи.Колонки.Добавить("ТипЗависимости");	
	
	Серия = ДиаграммаГантаКонструктив.Серии.Добавить();
	Серия.Цвет	= WebЦвета.СероСиний;
	
	МаксимальнаяДата = NULL;
	МинимальнаяДата = NULL;
	
	ТекДатаСеанса = ТекущаяДатаСеанса();
	
	Для Каждого СтрокаКонструктива ИЗ ТЗ.Строки  Цикл
		
		Точка = ДиаграммаГантаКонструктив.УстановитьТочку(СтрокаКонструктива.Конструктив);												
		
		Точка.Текст = ""+СокрЛП(СтрокаКонструктива.Конструктив.НаименованиеПолное)+"("+СтрокаКонструктива.Конструктив.Наименование+")";
		Точка.Шрифт = ЖирныйШрифт;
		
		Значение = ДиаграммаГантаКонструктив.ПолучитьЗначение(Точка, Серия); 		
		
		//Значение.Редактирование = Истина;
		Значение.Цвет = ЦветЗапланированного;
		
		// Добавляем интервал. В данном примере у каждой работы единственный интервал.
		Интервал = Значение.Добавить();
		Интервал.Начало = СтрокаКонструктива.ДатаНачала;
		Интервал.Конец  = СтрокаКонструктива.ДатаОкончания;
		
		СтрокаПлеера = ТаблицаДиаграммыКонструктив.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПлеера, СтрокаКонструктива);
		СтрокаПлеера.Наименование = СтрокаКонструктива.Конструктив.Наименование;
				
		// Формируем подпись.
		УстановитьТекстЗначения(Интервал); 		
		
		Для Каждого СтрокаРаботы ИЗ СтрокаКонструктива.Строки Цикл
			
			Точка = ДиаграммаГантаКонструктив.УстановитьТочку(""+СтрокаРаботы.Конструктив.Код+""+СтрокаРаботы.Работа.Код,СтрокаКонструктива.Конструктив);	
			
			Точка.Текст = "("+УСОERP_УправлениеСтроительнымПроизводством.ПолучитьКодСДР(СтрокаРаботы.Работа)+") "+СтрокаРаботы.Наименование;
			
			Значение = ДиаграммаГантаКонструктив.ПолучитьЗначение(Точка, Серия);	
			//Значение.Редактирование = Истина; 
			
			Интервал = Значение.Добавить();
			Интервал.Начало = СтрокаРаботы.ДатаНачала;
			Интервал.Конец  = СтрокаРаботы.ДатаОкончания;
			
			// Формируем подпись.
			УстановитьТекстЗначения(Интервал); 
			Значение.Цвет = WebЦвета.ЗеленыйЛес;
			
			// Если надо, корректируем максимальную и минимальную даты.
			Если МаксимальнаяДата = NULL Или МаксимальнаяДата < СтрокаРаботы.ДатаОкончания Тогда
				МаксимальнаяДата = СтрокаРаботы.ДатаОкончания;
			КонецЕсли;				
			
			Если МинимальнаяДата = NULL Или МинимальнаяДата > СтрокаРаботы.ДатаНачала Тогда
				МинимальнаяДата = СтрокаРаботы.ДатаНачала;
			КонецЕсли;	
			
			Для Каждого СтрокаДереваПред Из СтрокаРаботы.Работа.Предшественники Цикл
				
				Если ЗначениеЗаполнено(СтрокаДереваПред.СтроительнаяРабота) И СтрокаДереваПред.СтроительнаяРабота.ПометкаУдаления Тогда 
					
					Продолжить;
					
				КонецЕсли;
				
				Если ТаблицаРабот.Найти(СтрокаДереваПред.СтроительнаяРабота) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТаблицаРабот.Найти(СтрокаРаботы.Работа) = Неопределено Тогда
					Продолжить;
				КонецЕсли;  					
				
				Для Каждого СтрокаКонстр ИЗ СтрокаДереваПред.СтроительнаяРабота.Конструктивы Цикл			
					
					Связь = Связи.Добавить();
					Связь.Начало 		 = ""+СтрокаКонстр.Конструктив.Код+""+СтрокаДереваПред.СтроительнаяРабота.Код;
					Связь.Конец 		 = ""+СтрокаРаботы.Конструктив.Код+""+СтрокаРаботы.Работа.Код;					
					Связь.ТипЗависимости = СтрокаДереваПред.ТипЗависимости;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если МинимальнаяДата <> NULL Тогда
		
		День = 3600 * 24;
		Неделя = 3600 * 24 * 7;
		МаксимальнаяДата = МаксимальнаяДата + Неделя * 4;
		
		ГрафикРаботы = СценарийПланирования.Владелец.ГрафикРаботы;
		
		РабочиеДни = Справочники.Календари.ПрочитатьДанныеГрафикаИзРегистра(ГрафикРаботы, Год(МинимальнаяДата));
		
		Если Год(МаксимальнаяДата) > Год(МинимальнаяДата) Тогда 
			
			ТекГод = Год(МинимальнаяДата) + 1;
			
			Пока ТекГод <= Год(МаксимальнаяДата) Цикл
				
				врРабочиеДни = Справочники.Календари.ПрочитатьДанныеГрафикаИзРегистра(ГрафикРаботы, ТекГод);
				
				Для Каждого Элемент Из врРабочиеДни Цикл
					
					РабочиеДни.Вставить(Элемент.Ключ, Элемент.Значение);
					
				КонецЦикла;	
				
				ТекГод = ТекГод + 1;
				
			КонецЦикла;	
			
		КонецЕсли;	 
		
		ТекДата = МинимальнаяДата;
		
		Пока ТекДата <= МаксимальнаяДата Цикл;
			
			РабочийДень = (РабочиеДни.Получить(НачалоДня(ТекДата)) <> Неопределено);
			
			Если Не РабочийДень Тогда
				
				Кон = КонецДня(ТекДата);
				Нач = НачалоДня(ТекДата);
				ДиаграммаГантаКонструктив.ИнтервалыФона.Добавить(Нач, Кон);
				
			КонецЕсли;	
			
			ТекДата = ТекДата + День;
			
		КонецЦикла;		
		
	КонецЕсли;
	
	СоздатьСвязиНаДиаграммеГанта(Связи, ДиаграммаГантаКонструктив, Серия);
	
	// Находим элемент шкалы времени для непериодических меток.
	ЭлементМеток = ПолучитьЭлементДляМеток(ДиаграммаГантаКонструктив);
	
	// Создаем метку - текущая дата
	Метка = ЭлементМеток.Метки.Добавить(ТекущаяДата());
	Метка.Текст = НСтр("ru = 'Текущая дата'");
	Метка.ЦветТекста = WebЦвета.СинеСерый;
	Метка.ЦветЛинии = Метка.ЦветТекста; 	
	
	// Включаем обновление диаграммы.
	ДиаграммаГантаКонструктив.Обновление = Истина;
	
	ДиаграммаГантаКонструктив.ПоддержкаМасштаба = ПоддержкаМасштабаДиаграммыГанта.Авто;
	
	ДатаДиаграммаГанта = Объект.НачалоСтроительства;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьДиаграммуГантаКонструктив(Команда)
	
	КомандаОбновитьДиаграммуГантаКонструктивНаСервере();
	
	МинимальнаяДатаДиаграммы = ДиаграммаГантаКонструктив.НачалоПолногоИнтервала;
	МаксимальнаяДатаДиаграммы = ДиаграммаГантаКонструктив.КонецПолногоИнтервала;
		
КонецПроцедуры

&НаКлиенте
Процедура ПолосаРегулированияКонструктивПриИзменении(Элемент)
	
	ПолосаРегулированияКонструктивПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПолосаРегулированияКонструктивПриИзмененииНаСервере()
	
	ДиаграммаГантаКонструктив.ПоддержкаМасштаба 					= ПоддержкаМасштабаДиаграммыГанта.Период;
	ДиаграммаГантаКонструктив.ЕдиницаПериодическогоВарианта 		= ТипЕдиницыШкалыВремени["День"];
	ДиаграммаГантаКонструктив.КратностьПериодическогоВарианта 		= ?(ПолосаРегулированияДиаграммыГантаКонструктив < 1, 1, ПолосаРегулированияДиаграммыГантаКонструктив);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСохранитьДиаграммуВКартинку(Команда)
	
	ИмяДиаграммы = ?(Элементы.ГруппаСтраниц.ТекущаяСтраница.Имя = "ГруппаСтраницаДиаграммаГантаКонструктив","ДиаграммаГантаКонструктив","ДиаграммаГанта");
	 	
	Режим = РежимДиалогаВыбораФайла.Сохранение;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	Фильтр = НСтр("ru = 'Изображение'; en = 'Изображение'") + "(*.BMP)|*.BMP";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.Заголовок = "Выберите файл";
	
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		
		Картинка = ЭтаФорма[ИмяДиаграммы].ПолучитьКартинку(800,1400);
		Картинка.Записать(ДиалогОткрытияФайла.ПолноеИмяФайла);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРазвернутьТочкиДиаграммыГанта(Команда)
	
	ИмяДиаграммы = ?(Элементы.ГруппаСтраниц.ТекущаяСтраница.Имя = "ГруппаСтраницаДиаграммаГантаКонструктив","ДиаграммаГантаКонструктив","ДиаграммаГанта");
	
	Для Каждого ТочкаДиаграммы ИЗ ЭтаФорма[ИмяДиаграммы].Точки Цикл
		
		ЭтаФорма[ИмяДиаграммы].РазвернутьТочку(ТочкаДиаграммы,Истина);
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСвернутьТочкиДиаграммыГанта(Команда)
	
	ИмяДиаграммы = ?(Элементы.ГруппаСтраниц.ТекущаяСтраница.Имя = "ГруппаСтраницаДиаграммаГантаКонструктив","ДиаграммаГантаКонструктив","ДиаграммаГанта");
	
	Для Каждого ТочкаДиаграммы ИЗ ЭтаФорма[ИмяДиаграммы].Точки Цикл
		
		ЭтаФорма[ИмяДиаграммы].СвернутьТочку(ТочкаДиаграммы,Истина);
		
	КонецЦикла;
	
КонецПроцедуры 


#КонецОбласти

#Область Шаблоны

&НаКлиенте
Процедура КомандаСоздатьРаботыИзШаблона(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	ПередаваемыеПараметры = Новый Структура;
	
	Если Не ЗначениеЗаполнено(СценарийПланирования) Тогда 
		Сообщить(НСтр("ru='Не заполнен сценарий планирования.'"));
		Возврат;
	КонецЕсли;		
	
	Если ТекущиеДанные = Неопределено Тогда
		ПередаваемыеПараметры.Вставить("Родитель", Неопределено);
		ПередаваемыеПараметры.Вставить("Сценарий", СценарийПланирования);
	Иначе	
		Если Не ТекущиеДанные.СуммарнаяРабота Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Работа не может иметь потомков.'"));
			Возврат;
		КонецЕсли;
		ПередаваемыеПараметры.Вставить("Родитель", ТекущиеДанные.Ссылка);
		ПередаваемыеПараметры.Вставить("Сценарий", СценарийПланирования);
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьФормуПланаПроекта", ЭтаФорма);
	ОткрытьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаСозданияРаботИзШаблона" ,ПередаваемыеПараметры,,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьШаблонИзРаботы(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		
		Возврат;
		
		Если ЗначениеЗаполнено(СценарийПланирования) Тогда
			
			ФормаСозданияШаблона = ПолучитьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаСозданияШаблонаИзРабот");
			ФормаСозданияШаблона.Источник = Неопределено;
			ФормаСозданияШаблона.Открыть();				
			
		КонецЕсли; 
		
	Иначе
		
		ФормаСозданияШаблона = ПолучитьФорму("Справочник.УСОERP_СтроительныеРаботы.Форма.ФормаСозданияШаблонаИзРабот");
		СписокРабот = Новый СписокЗначений;
		СписокРабот.Добавить(Элементы.Список.ТекущаяСтрока);
		ФормаСозданияШаблона.Источник = СписокРабот;
		ФормаСозданияШаблона.Открыть();		
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти   

#Область ОбработчикиРенга
&НаКлиенте
Функция ПолучитьКонструктивы()
	
	Конструктив = "";
	СписокЛишниеКонструктивы = "";
	Инд = 0;
	ИндЛишние = 0;
	Для Каждого СтрокаКонструктив Из ТаблицаДиаграммыКонструктив Цикл
		Если СтрокаКонструктив.ДатаОкончания <= ДатаДиаграммаГанта Тогда
			Конструктив = Конструктив + ?(Инд = 0, "", "%") + СтрокаКонструктив.Наименование;
			СтрокаКонструктив.Показан = Истина;
			Инд = Инд + 1;
		ИначеЕсли СтрокаКонструктив.Показан Тогда
			СписокЛишниеКонструктивы = СписокЛишниеКонструктивы + ?(Инд = 0, "", "%") + СтрокаКонструктив.Наименование;
			СтрокаКонструктив.Показан = Ложь;
			
			ИндЛишние = ИндЛишние + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Конструктив;
		
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИмяФайлаПлагинаРенга()
	
	Возврат ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","СМ_ПутьКПлагинуРенга","C:\Program Files\Renga Architecture\Plugins\RengaPlugin1C\");
	
КонецФункции

&НаКлиенте
Процедура ОтображатьРенга()
	
	Если КомпонентаРенга = Неопределено Тогда
		СисИнфо = Новый СистемнаяИнформация;
		ПутьПапкаПлагина = ПолучитьИмяФайлаПлагинаРенга();
		Если ПодключитьВнешнююКомпоненту(ПутьПапкаПлагина + ?(СисИнфо.ТипПлатформы = ТипПлатформы.Windows_x86_64, "ICPlugin64.dll", "ICPlugin.dll"), "МояКомпонента", ТипВнешнейКомпоненты.Native) Тогда
			КомпонентаРенга = Новый("AddIn.МояКомпонента.AddInNativeExtension"); 
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось подключить компоненту.");
		КонецЕсли;
		СписокКонструктивов = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьКонструктивы()
	
	Если КомпонентаРенга <> Неопределено Тогда
		Попытка
			Если СписокКонструктивов = "" Тогда
				КомпонентаРенга.СкрытьВсе();
			КонецЕсли;	
			СписокИД = ПолучитьКонструктивы();
			Если ЗначениеЗаполнено(СписокИД) И СписокИД <> СписокКонструктивов Тогда
				КомпонентаРенга.Скрыть(СписокЛишниеКонструктивы);	
				КомпонентаРенга.Показать(СписокИД);
			ИначеЕсли ЗначениеЗаполнено(СписокЛишниеКонструктивы) Тогда
				КомпонентаРенга.Скрыть(СписокЛишниеКонструктивы);
			КонецЕсли;
			СписокКонструктивов = СписокИД;
			
			ДобавитьМеткуНаДиаграмму();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при отображении. Проверьте, что запущено окно компоненты.");
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьМеткуНаДиаграмму()
	
	ДиаграммаГантаКонструктив.Обновление = Ложь;
	Для Каждого Интервал Из ДиаграммаГантаКонструктив.ИнтервалыФона Цикл
		Если Интервал.Цвет = WebЦвета.ЦветМорскойВолны Тогда
			 ДиаграммаГантаКонструктив.ИнтервалыФона.Удалить(Интервал);
		КонецЕсли;	
	КонецЦикла;	
	Интервал = ДиаграммаГантаКонструктив.ИнтервалыФона.Добавить(ДатаДиаграммаГанта, КонецДня(ДатаДиаграммаГанта));
	Интервал.Цвет = WebЦвета.ЦветМорскойВолны;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОбработчикиРенга()
	
	ОтключитьОбработчикОжидания("ОтображениеРенгаПеремоткаНазад");
	ОтключитьОбработчикОжидания("ОтображениеРенгаПеремоткаВперед");
	
КонецПроцедуры

&НаКлиенте
Процедура Вперед(Команда)
	
	ОтображатьРенга();
	Если КомпонентаРенга <> Неопределено Тогда
		ДатаДиаграммаГанта = КонецДня(ДатаДиаграммаГанта) + 1;
		ОтобразитьКонструктивы();
		ПеремоткаНазад = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Пауза(Команда)
	
	ОтключитьОбработчикиРенга();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеремоткаВперед(Команда)
	
	ОтображатьРенга();
	Если КомпонентаРенга <> Неопределено Тогда
		ОтключитьОбработчикиРенга();
				
		ПодключитьОбработчикОжидания("ОтображениеРенгаПеремоткаВперед", 1.1);
		ПеремоткаНазад = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеремоткаНазад(Команда)
	
	ОтображатьРенга();
	Если КомпонентаРенга <> Неопределено Тогда
		ОтключитьОбработчикиРенга();
		
		ПодключитьОбработчикОжидания("ОтображениеРенгаПеремоткаНазад", 1.1);
		ПеремоткаНазад = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтображениеРенгаПеремоткаВперед()
	
	Если ДатаДиаграммаГанта >= МаксимальнаяДатаДиаграммы Тогда
		ОтключитьОбработчикиРенга();
	Иначе
		ДатаДиаграммаГанта = КонецДня(ДатаДиаграммаГанта) + 1;
		ОтобразитьКонструктивы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображениеРенгаПеремоткаНазад()
	
	Если ДатаДиаграммаГанта <= МинимальнаяДатаДиаграммы Тогда
		ОтключитьОбработчикиРенга();
	Иначе
		ДатаДиаграммаГанта = НачалоДня(ДатаДиаграммаГанта) - 1;
		ОтобразитьКонструктивы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаДиаграммаГантаПриИзменении(Элемент)
	
	ОтображатьРенга();
	Если КомпонентаРенга <> Неопределено Тогда		
		ОтобразитьКонструктивы();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти




