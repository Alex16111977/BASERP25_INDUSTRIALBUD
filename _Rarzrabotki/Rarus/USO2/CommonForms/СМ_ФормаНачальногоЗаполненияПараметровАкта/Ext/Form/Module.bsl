
#Область ОбработчикиСобытий

&НаКлиенте
Процедура ПоОстаткамПриИзменении(Элемент)
	
	Если ПоОстаткам Тогда
		Элементы.Процентовать.Доступность 	= Ложь;
		Элементы.Процент.Доступность 		= Ложь;
	Иначе
		Элементы.Процентовать.Доступность 	= Истина;
		Элементы.Процент.Доступность 		= Истина;
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроцентоватьПриИзменении(Элемент)
	
	Если Процентовать Тогда
		Элементы.ПоОстаткам.Доступность = Ложь;
	Иначе
		Элементы.ПоОстаткам.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("КопироватьЛЗ",ЭтаФорма.КопироватьЛЗ);
	СтруктураПараметров.Вставить("КопироватьПодписи",ЭтаФорма.КопироватьПодписи);
	СтруктураПараметров.Вставить("КопироватьИндексы",ЭтаФорма.КопироватьИндексы);
	СтруктураПараметров.Вставить("Процентовать",ЭтаФорма.Процентовать);
	СтруктураПараметров.Вставить("Процент",ЭтаФорма.Процент);
	СтруктураПараметров.Вставить("ЗаполнитьПоОстаткам",ЭтаФорма.ПоОстаткам);
	СохранитьНастройки(СтруктураПараметров);
	ЭтаФорма.Закрыть(СтруктураПараметров);

КонецПроцедуры

&НаКлиенте
Процедура ПроцентПриИзменении(Элемент)
	
	Если ЭтаФорма.Процент > 100 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Значение поля процент не может быть больше 100'"));
		ЭтаФорма.Процент = 100;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройки(СтруктураПараметров);
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("НастройкиПользователяСмета","СтруктураПараметровНачальногоЗаполненияПараметровАкта",СтруктураПараметров);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	Процентовать = Истина;
	
	СтруктураПараметровНачальногоЗаполненияПараметровАкта = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","СтруктураПараметровНачальногоЗаполненияПараметровАкта");
	Если Не СтруктураПараметровНачальногоЗаполненияПараметровАкта = Неопределено Тогда
		КопироватьЛЗ = СтруктураПараметровНачальногоЗаполненияПараметровАкта.КопироватьЛЗ;
		КопироватьПодписи = СтруктураПараметровНачальногоЗаполненияПараметровАкта.КопироватьПодписи;
		КопироватьИндексы = СтруктураПараметровНачальногоЗаполненияПараметровАкта.КопироватьИндексы;
		Процент = СтруктураПараметровНачальногоЗаполненияПараметровАкта.Процент;
		ПоОстаткам = СтруктураПараметровНачальногоЗаполненияПараметровАкта.ЗаполнитьПоОстаткам;
		Если ПоОстаткам Тогда
			Процентовать = Ложь;
			Элементы.Процентовать.Доступность 	= Ложь;
			Элементы.Процент.Доступность 		= Ложь;
		КонецЕсли;
		Если Процентовать Тогда
			Элементы.ПоОстаткам.Доступность = Ложь;
		КонецЕсли;

	КонецЕсли;
КонецПроцедуры

#КонецОбласти