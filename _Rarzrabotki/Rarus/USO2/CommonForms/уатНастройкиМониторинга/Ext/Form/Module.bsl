&НаСервере
Процедура ЗаписатьУчетныеЗаписи()

	Если НаборКонстант.уатИспользоватьOmnicomm Тогда
		УчетнаяЗапись = Omnicomm_УчетнаяЗапись.ПолучитьОбъект();
		УчетнаяЗапись.СпособРаботы		 = НаборКонстант.уатСпособРаботыСOmnicomm;
		УчетнаяЗапись.СпособПодключения	 = НаборКонстант.уатСпособПодключенияКСистемеOmnicomm;
		УчетнаяЗапись.Логин				 = НаборКонстант.уатЛогинВСистемеOmnicomm;
		УчетнаяЗапись.Пароль			 = НаборКонстант.уатПарольВСистемеOmnicomm;
		УчетнаяЗапись.АдресСервиса		 = НаборКонстант.уатАдресСервисаOmnicomm;
		УчетнаяЗапись.Сервер			 = НаборКонстант.уатСерверВСистемеOmnicomm;
		УчетнаяЗапись.ИмяБД				 = НаборКонстант.уатИмяБДВСистемеOmnicomm;
		УчетнаяЗапись.Драйвер			 = НаборКонстант.уатДрайверВСистемеOmnicomm;
		УчетнаяЗапись.ИмяPIPE			 = НаборКонстант.уатИмяPIPEСистемеOmnicomm;
		УчетнаяЗапись.ИмяDSN			 = НаборКонстант.уатИмяDSNСистемеOmnicomm;
		УчетнаяЗапись.Записать();
	КонецЕСли;
	
	Если НаборКонстант.уатИспользоватьDynafleet Тогда
		УчетнаяЗапись = Dynafleet_УчетнаяЗапись.ПолучитьОбъект();
		УчетнаяЗапись.Логин			 = НаборКонстант.уатЛогинВСистемеDynafleet;
		УчетнаяЗапись.Пароль		 = НаборКонстант.уатПарольВСистемеDynafleet;
		УчетнаяЗапись.АдресСервиса	 = НаборКонстант.уатАдресСервисаDynafleet;
		УчетнаяЗапись.Записать();
	КонецЕСли;

	Если НаборКонстант.уатИспользоватьСКАУТ Тогда
		УчетнаяЗапись = СКАУТ_УчетнаяЗапись.ПолучитьОбъект();
		УчетнаяЗапись.Логин			 = НаборКонстант.уатЛогинВСистемеСКАУТ;
		УчетнаяЗапись.Пароль		 = НаборКонстант.уатПарольВСистемеСКАУТ;
		УчетнаяЗапись.АдресСервиса	 = НаборКонстант.уатАдресСервисаСКАУТ;
		УчетнаяЗапись.Записать();
	КонецЕСли;

	Если НаборКонстант.уатИспользоватьАвтоГРАФ Тогда
		УчетнаяЗапись = АвтоГРАФ_УчетнаяЗапись.ПолучитьОбъект();
		УчетнаяЗапись.АдресСервиса	 = НаборКонстант.уатАдресСервисаАвтоГРАФ;
		УчетнаяЗапись.Записать();
	КонецЕСли;

	Если НаборКонстант.уатИспользоватьWialon Тогда
		УчетнаяЗапись = Wialon_УчетнаяЗапись.ПолучитьОбъект();
		УчетнаяЗапись.ТокенАвторизации	 = НаборКонстант.уатТокенВСистемеWialon;
		УчетнаяЗапись.АдресСервиса		 = НаборКонстант.уатАдресСервисаWialon;
		УчетнаяЗапись.Ресурс			 = Wialon_Ресурс;
		УчетнаяЗапись.ВидСистемы		 = Wialon_ВидСистемы;
		УчетнаяЗапись.Записать();
	КонецЕСли;

КонецПроцедуры

