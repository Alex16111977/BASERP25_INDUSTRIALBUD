&НаСервере
Функция ПроверитьПодключениеWialonНаСервере(ТекстОшибки)
	
	ТабДанных = Неопределено;
	ДанныеПодключения = Новый Структура("АдресСервиса, ТокенАвторизации, Ресурс, ВидСистемы", НаборКонстант.уатАдресСервисаWialon, НаборКонстант.уатТокенВСистемеWialon, Wialon_Ресурс, Wialon_ВидСистемы);
	Возврат уатЗащищенныеФункцииСервер_проф.Wialon_ПолучитьДанныеВсехТС(ТабДанных, ТекстОшибки,,ДанныеПодключения);
	
КонецФункции // ПроверитьПодключениеWialonНаСервере()

&НаКлиенте
Функция ПодключениеКWialonДоступно()
	
	ТекстОшибки = "";
	
	КодВозврата = ПроверитьПодключениеWialonНаСервере(ТекстОшибки);
	
	Если КодВозврата = 0 И ТекстОшибки = "" Тогда 
		Возврат Истина;
		
	ИначеЕсли КодВозврата = 2 Тогда 
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("Описание", ТекстОшибки + Символы.ПС + НСтр("ru = 'Продолжить?'"));
		ПараметрыФормы.Вставить("ПредупреждениеWialon", Истина);
		
		ОткрытьФорму(
			"ОбщаяФорма.уатПредупреждение", 
			ПараметрыФормы, 
			ЭтотОбъект,
			,
			,
			,
			Новый ОписаниеОповещения("ПодтверждениеЗагрузкиИзLocal", ЭтотОбъект),
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
		);
		
		Возврат Ложь;
		
	Иначе 
		ТекстОшибки = СтрШаблон(НСтр("en='At the address <%1> is missing the ability to connect to the API functions WIALON';ru='По указанному адресу <%1> отсутствует возможность подключения к функциям API WIALON'"), НаборКонстант.уатАдресСервисаWialon);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "НаборКонстант.уатАдресСервисаWialon");
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПодтверждениеЗагрузкиИзLocal(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если РезультатЗакрытия.БольшеНеПоказывать Тогда 
		СохранитьПризнакОтображенияПредупрежденияLocal();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьПризнакОтображенияПредупрежденияLocal()
	
	УстановитьПривилегированныйРежим(Истина);
	
	ХранилищеНастроекДанныхФорм.Сохранить(
		"Обработка.уатЗагрузкаДанныхWialon", 
		"ПредупреждениеLocalБольшеНеПоказывать", 
		Истина
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьТокенWialonЗавершение(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	НаборКонстант.уатТокенВСистемеWialon = Результат;
	Wialon_Ресурс = "";
	
КонецПроцедуры

