
#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	Если Параметры.Свойство("Регион") Тогда
		Регион = Параметры.Регион;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Ок(Команда)
	СохранитьРегион(ОписаниеНастройки("НастройкиПользователяСмета","ОсновнойРегион",Регион));
	Закрыть();
	
	// Если РолиДоступныПроверка("СМ_АдминистраторСмета, АдминистраторСистемы, ПолныеПрава") Тогда
	ОткрытьФорму("ОбщаяФорма.СМ_НастройкиСмета");
	// КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ОписаниеНастройки(Объект, Настойка, Значение)
	
	Элемент = Новый Структура;
	Элемент.Вставить("Объект", Объект);
	Элемент.Вставить("Настройка", Настойка);
	Элемент.Вставить("Значение", Значение);
	
	Возврат Элемент;
	
КонецФункции

&НаСервереБезКонтекста
Функция РолиДоступныПроверка(СписокРолей)
	Возврат	Пользователи.РолиДоступны(СписокРолей);
КонецФункции

&НаСервере
Процедура СохранитьРегион(ОписаниеНастройки)
	Если НЕ Регион.Пустая() и РолиДоступныПроверка("СМ_АдминистраторСмета, СМ_Сметчик, АдминистраторСистемы, ПолныеПрава") Тогда
		УстановитьПривилегированныйРежим(Истина);
		МассивСтруктур = Новый Массив;
		МассивСтруктур.Добавить(ОписаниеНастройки);
		ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранитьМассивИОбновитьПовторноИспользуемыеЗначения(МассивСтруктур);
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
