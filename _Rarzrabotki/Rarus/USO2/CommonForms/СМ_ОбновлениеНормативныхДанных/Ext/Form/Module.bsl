	КонецЕсли;	
	
КонецФункции

&НаСервере
Функция ЗапуститьЗадание(ДанныеДляОбновления)
	
	СтрокаОписания = Задания[НомерЗадания];
	Если СтрокаОписания.Действие = "ПРОВЕСТИОБНОВЛЕНИЕЕДИНИЦИЗМЕРЕНИЯ" Тогда
		Возврат СМ_СметаЗагрузкаВызовСервера.ЗапуститьЕдиницыИзмеренияРегламентноеЗадание(СтрокаОписания.Идентификатор, ДанныеДляОбновления);			
	ИначеЕсли СтрокаОписания.Действие = "ПРОВЕСТИОБНОВЛЕНИЕПОПРАВОК" Тогда
		Возврат СМ_СметаЗагрузкаВызовСервера.ЗапуститьПоправкиРегламентноеЗадание(СтрокаОписания.Идентификатор, СтрокаОписания.ОбъектДляЗаписи, ДанныеДляОбновления);		
	ИначеЕсли СтрокаОписания.Действие = "ПРОВЕСТИОБНОВЛЕНИЕРЕСУРСОВ" Тогда
		Возврат  СМ_СметаЗагрузкаВызовСервера.ЗапуститьРесурсыРегламентноеЗадание(СтрокаОписания.Идентификатор, СтрокаОписания.ОбъектДляЗаписи, ДанныеДляОбновления);			
	Иначе
		Возврат Новый Структура("ЗаданиеВыполнено, ИдентификаторЗадания", Истина, "");
	КонецЕсли;	
	
КонецФункции

&НаКлиенте
Функция ПолучитьДанные(СтрокаОписания)
	
	Если СтрокаОписания.Действие = "ПРОВЕСТИОБНОВЛЕНИЕЕДИНИЦИЗМЕРЕНИЯ" Тогда
		Возврат СметнаяКомпонента.ПровестиОбновлениеЕдиницИзмерения();				
	ИначеЕсли СтрокаОписания.Действие = "ПРОВЕСТИОБНОВЛЕНИЕПОПРАВОК" Тогда
		Возврат  СметнаяКомпонента.ПровестиОбновлениеПоправок(СтрокаОписания.КодБазы);		
	ИначеЕсли СтрокаОписания.Действие = "ПРОВЕСТИОБНОВЛЕНИЕРЕСУРСОВ" Тогда
		Возврат  СметнаяКомпонента.ПровестиОбновлениеРесурсов(СтрокаОписания.КодБазы,СтрокаОписания.ГодВыпуска);			
	Иначе
		Возврат "";
	КонецЕсли;	
	
КонецФункции


&НаСервере
Процедура ИнициироватьОбработчик(Действие, ОбъектДляЗаписи)
	
	КодБазы = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ОбъектДляЗаписи,"Код");
	ИмяБазы = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ОбъектДляЗаписи,"Наименование");
	ГодВыпуска = СМ_СметаВызовСервера.ПолучитьГодИзПеречисления(СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ОбъектДляЗаписи,"ГодВыпуска"));
				                      
	СтрокаДанных = Задания.Добавить();
	СтрокаДанных.Идентификатор = Новый УникальныйИдентификатор();
	СтрокаДанных.Статус = "подготовка";
	СтрокаДанных.КодБазы = КодБазы;
	СтрокаДанных.ИмяБазы = ИмяБазы;
	СтрокаДанных.ГодВыпуска = ГодВыпуска;
	СтрокаДанных.Действие = ВРег(Действие);
	СтрокаДанных.ОбъектДляЗаписи = ОбъектДляЗаписи;
	
	ИмяЭлемента = СтрокаДанных.Идентификатор;
	
	Элемент = ЭтаФорма.Элементы.Добавить(СтрЗаменить("Надпись"+ИмяЭлемента, "-", ""), Тип("ДекорацияФормы"), ЭтаФорма);
    Элемент.Вид = ВидДекорацииФормы.Надпись;
	Элемент.Заголовок = СформироватьЗаголовок(СтрокаДанных.Действие, СтрокаДанных.ИмяБазы, СтрокаДанных.Статус);
    Элемент.Видимость = Истина;
    Элемент.Доступность = Истина;
    
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСНБ(СписокСНБ = Неопределено, СметнаяКомпонента = Неопределено, ВерсияКомпоненты = 1)
	
	Заполнять = ?(СписокСНБ=неопределено, Истина, ?(СписокСНБ.Количество()>0, Истина, Ложь));
	
	Если Заполнять Тогда
		
		Если СписокСНБ=неопределено Тогда
			ПоказатьОповещениеПользователя(НСтр("ru='Найдены изменения в нормативных базах... будет произведено обновление!'"));
		КонецЕсли;
		
		ДанныеДляОбновления = СметнаяКомпонента.ПровестиОбновлениеСНБ();

		Если Не ДанныеДляОбновления = Неопределено И Не ДанныеДляОбновления = "" И Не ДанныеДляОбновления = 0 И ДанныеДляОбновления <> "<body></body>" Тогда 
			ИнициироватьОбработчик("ПРОВЕСТИОБНОВЛЕНИЕЕДИНИЦИЗМЕРЕНИЯ", ПредопределенноеЗначение("Справочник.СМ_СметноНормативныеБазы.ПустаяСсылка"));
			
			МассивСНБ = Новый Массив();
			Для Каждого СНБ Из СписокСНБ Цикл
				МассивСНБ.Добавить(СНБ.Значение);
			КонецЦикла;
			
			ОбъектыДляЗаписи = СМ_СметаЗагрузкаВызовСервера.ЗаполнитьСНБ(МассивСНБ,ДанныеДляОбновления,ВерсияКомпоненты); 
			
			Для Каждого ОбъектДляЗаписи Из ОбъектыДляЗаписи Цикл
				
				ИнициироватьОбработчик("ПРОВЕСТИОБНОВЛЕНИЕПОПРАВОК", ОбъектДляЗаписи);
				ИнициироватьОбработчик("ПРОВЕСТИОБНОВЛЕНИЕРЕСУРСОВ", ОбъектДляЗаписи);
				
				
			КонецЦикла;
		КонецЕсли;
		
		Если Задания.Количество() > 0 Тогда
			НомерЗадания = 0;
			ЕстьОшибки = Ложь;
			ПодключитьОбработчикОжидания("Подключаемый_ЗапуститьВыполнениеЗадания", 1, Истина);
		КонецЕсли;
	Иначе
		ЭтаФорма.Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьИсключениеНаСервере(Знач ПредставлениеОшибки)
	
	Событие = НСтр("ru = 'Ошибка в задании'");
	ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ПредставлениеОшибки);
	
КонецПроцедуры

// Ожидания проверки загрузки данных из ВНБ.
//
// Параметры:
//     СписокСНБ 			- массив СНБ для обновления (если не указан, обновляются все).
//     СметнаяКомпонента 	- COM - компонента ВНБ.
//     ВерсияКомпоненты 	- Число - версия внешней нормативной базы.
//
&НаКлиенте
Процедура Подключаемый_ЗапуститьВыполнениеЗадания()
	
	Если СметнаяКомпонента = Неопределено Тогда
		Возврат
	КонецЕсли;
	
	Попытка
		ВерсияКомпоненты = Число(СметнаяКомпонента.Version);
	Исключение
		ВерсияКомпоненты = 1;
	КонецПопытки;
	
	СтрокаОписания = Задания.Получить(НомерЗадания);
		
	ДанныеДляОбновления = ПолучитьДанные(СтрокаОписания);
	Результат = ЗапуститьЗадание(ДанныеДляОбновления);
	
	Если Результат.ЗаданиеВыполнено Тогда
		ОбработатьРезультатВыполненияЗадания("выполнено!");
	Иначе
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
		ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтотОбъект, Результат.ИдентификаторЗадания);
		ИдентификаторЗадания = Результат.ИдентификаторЗадания;
	КонецЕсли;                       
	
КонецПроцедуры

// Ожидания проверки загрузки данных из ВНБ.
//
// Параметры:
//     СписокСНБ 			- массив СНБ для обновления (если не указан, обновляются все).
//     СметнаяКомпонента 	- COM - компонента ВНБ.
//     ВерсияКомпоненты 	- Число - версия внешней нормативной базы.
//
&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	Попытка
		Если ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = ИдентификаторЗадания Тогда
			
			Если ЗаданиеВыполнено(ИдентификаторЗадания) Тогда 
				ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
				ОбработатьРезультатВыполненияЗадания("выполнено!");
			Иначе
				ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
				ПодключитьОбработчикОжидания(
					"Подключаемый_ПроверитьВыполнениеЗадания", 
					ПараметрыОбработчикаОжидания.ТекущийИнтервал, 
					Истина);
				СтрокаОписания = Задания.Получить(НомерЗадания);
				Элементы[СтрЗаменить("Надпись"+СтрокаОписания.Идентификатор, "-", "")].Заголовок = СформироватьЗаголовокКлиент(СтрокаОписания.Действие, СтрокаОписания.ИмяБазы, "выполняется");
			КонецЕсли;
		КонецЕсли;
	Исключение
		ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ЗаписатьИсключениеНаСервере(ПредставлениеОшибки);
		ОбработатьРезультатВыполненияЗадания("ошибка!");
		ЕстьОшибки = Истина;
	КонецПопытки;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатВыполненияЗадания(Статус)
	
	СтрокаОписания = Задания.Получить(НомерЗадания);
	Элементы[СтрЗаменить("Надпись"+СтрокаОписания.Идентификатор, "-", "")].Заголовок = СформироватьЗаголовокКлиент(СтрокаОписания.Действие, СтрокаОписания.ИмяБазы, Статус);
	
	Если Задания.Количество() <= НомерЗадания + 1 Тогда
		// Все исчерпано.
		Если Не ЕстьОшибки Тогда
			Закрыть();
		КонецЕсли;
	Иначе
		// Еще есть задания.
		НомерЗадания = НомерЗадания + 1;
		СтрокаОписания = Задания.Получить(НомерЗадания);
		Элементы[СтрЗаменить("Надпись"+СтрокаОписания.Идентификатор, "-", "")].Заголовок = СформироватьЗаголовокКлиент(СтрокаОписания.Действие, СтрокаОписания.ИмяБазы, "сбор данных");
		ЭтаФорма.ОбновитьОтображениеДанных();
		ПодключитьОбработчикОжидания("Подключаемый_ЗапуститьВыполнениеЗадания", 1, Истина);
	КонецЕсли;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(ИдентификаторЗадания)
	
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	
КонецФункции

#КонецОбласти
