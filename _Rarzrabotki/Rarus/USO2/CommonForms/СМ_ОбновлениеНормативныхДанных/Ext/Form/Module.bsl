	ИначеЕсли Действие = "ПРОВЕСТИОБНОВЛЕНИЕПОПРАВОК" Тогда
		ТекстСообщения = НСтр("ru='Обновление поправок %1% ... %2%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1%", ИмяБазы);
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%2%", Статус);
		Возврат  ТекстСообщения;		
	ИначеЕсли Действие = "ПРОВЕСТИОБНОВЛЕНИЕРЕСУРСОВ" Тогда
		ТекстСообщения = НСтр("ru='Обновление ресурсов %1% ... %2%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1%", ИмяБазы);
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%2%", Статус);
		Возврат  ТекстСообщения;		
	Иначе
