
#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "ЗаменяемыйРесурс, Ресурс, РасходПоНорме, РасходПоФакту,БазисЦена,БазисЗарплМаш,ТекЦена,ТекЗарплМаш");
	Если ТипЗнч(Ресурс) = Тип("СправочникСсылка.СМ_Ресурсы") И
		(Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Или Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Оборудование) Тогда
		ТекЗарплМаш = 0;
	КонецЕсли;	 

	Если Не ЗначениеЗаполнено(ЗаменяемыйРесурс) Тогда
		Элементы.ЗаменяемыйРесурс.Видимость 	= Ложь;	
		Элементы.ЗаменяемыйРесурс.Доступность 	= Ложь;
	КонецЕсли;
	
	Если Параметры.ТолькоНорма Тогда
		Элементы.РасходПоФакту.Видимость 	= Ложь;	
		Элементы.РасходПоФакту.Доступность 	= Ложь;
	КонецЕсли;
	
	Если Не Параметры.РаспределитьПропорциональноОбъемам Тогда
		Элементы.РаспределитьПропорциональноОбъемам.Видимость	= Ложь;	
		Элементы.РаспределитьПропорциональноОбъемам.Доступность = Ложь;
		Элементы.ПодсказкаРаспределения.Видимость 				= Ложь;	
		Элементы.ПодсказкаРаспределения.Доступность 			= Ложь;
	КонецЕсли;
	
	// ДокторСофт
	Если Параметры.Свойство("МестоВызова") Тогда
		Если Параметры.МестоВызова = "ЛСВыборРесурса" Тогда
			Элементы.РасходПоФакту.Видимость 						= Ложь;
			Элементы.РаспределитьПропорциональноОбъемам.Видимость 	= Ложь;
		КонецЕсли;
		МестоВызова = Параметры.МестоВызова;
	КонецЕсли;
	
	Если Параметры.Свойство("ЛокальнаяСмета") Тогда
		ЛокальнаяСмета = Параметры.ЛокальнаяСмета;
	КонецЕсли;
	Индекс = 0; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	РаспределитьПропорциональноОбъемамПриИзменении(Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РаспределитьПропорциональноОбъемамПриИзменении(Элемент)
	
	Если РаспределитьПропорциональноОбъемам Тогда
		ПодсказкаРаспределения = НСтр("ru='Необходимо ввести общий объем расхода ресурсов для всех позиций'");
	Иначе
		ПодсказкаРаспределения = НСтр("ru='Необходимо ввести норму расхода ресурсов, которая будет применена к каждой позиции'");
	КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	Структура = Новый Структура("ЗаменяемыйРесурс, Ресурс, РасходПоНорме, РасходПоФакту, РаспределитьПропорциональноОбъемам,БазисЦена,БазисЗарплМаш,ТекЦена,ТекЗарплМаш,ДополнительныеЗамены");
	ЗаполнитьЗначенияСвойств(Структура,ЭтаФорма);

	// Получаем массив структур для возрата в форму
	МассивЗамен = Новый Массив;
	Для ТекИндекс = 0 По Индекс Цикл
		ТекГруппа = ЭтаФорма.Элементы.Найти("ГруппаРесурса_" + ТекИндекс);
		Если ТекГруппа <> Неопределено Тогда
			СтруктураЗамен = Новый Структура;
			СтруктураЗамен.Вставить("ЗаменяемыйРесурс",ЭтаФорма.ЗаменяемыйРесурс);
			СтруктураЗамен.Вставить("Ресурс",ЭтаФорма["Ресурс_" + ТекИндекс]);
			СтруктураЗамен.Вставить("РасходПоНорме",ЭтаФорма["РасходПоНорме_" + ТекИндекс]); 
			СтруктураЗамен.Вставить("РасходПоФакту",ЭтаФорма["РасходПоФакту_" + ТекИндекс]); 
			СтруктураЗамен.Вставить("РаспределитьПропорциональноОбъемам",Ложь);
			СтруктураЗамен.Вставить("БазисЦена",ЭтаФорма["БазиснаяЦена_" + ТекИндекс]);
			СтруктураЗамен.Вставить("БазисЗарплМаш",ЭтаФорма["БазиснаяЗарплМаш_" + ТекИндекс]);
			СтруктураЗамен.Вставить("ТекЦена",ЭтаФорма["ТекущаяЦена_" + ТекИндекс]);
			СтруктураЗамен.Вставить("ТекЗарплМаш",ЭтаФорма["ТекущаяЗарплМаш_" + ТекИндекс]);
			МассивЗамен.Добавить(СтруктураЗамен);
		КонецЕсли;
	КонецЦикла;
	Структура.ДополнительныеЗамены = МассивЗамен;
	
	Если МестоВызова = "АктВыполненныхРабот" Тогда
		Адрес = ПодготовитьТаблицуЗамен();
		Закрыть(Адрес);
	Иначе	
		Закрыть(Структура);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПодготовитьТаблицуЗамен()
	
	ТабРезультат = Новый ТаблицаЗначений;
	ТабРезультат.Колонки.Добавить("ЗаменяемыйРесурс");
	ТабРезультат.Колонки.Добавить("Ресурс");
	ТабРезультат.Колонки.Добавить("РасходПоНорме");
	ТабРезультат.Колонки.Добавить("РасходПоФакту");
	ТабРезультат.Колонки.Добавить("РаспределитьПропорциональноОбъемам");
	ТабРезультат.Колонки.Добавить("БазисЦена");
	ТабРезультат.Колонки.Добавить("БазисЗарплМаш");
	ТабРезультат.Колонки.Добавить("ТекЦена");
	ТабРезультат.Колонки.Добавить("ТекЗарплМаш");
	
	НоваяСтрока = ТабРезультат.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭтаФорма);	
	
	Для ТекИндекс = 0 По Индекс Цикл
		ТекГруппа = ЭтаФорма.Элементы.Найти("ГруппаРесурса_" + ТекИндекс);
		Если ТекГруппа <> Неопределено Тогда
			НоваяСтрока = ТабРезультат.Добавить();
			НоваяСтрока.ЗаменяемыйРесурс	= ЭтаФорма.ЗаменяемыйРесурс;
			НоваяСтрока.Ресурс				= ЭтаФорма["Ресурс_" + ТекИндекс];
			НоваяСтрока.РасходПоНорме		= ЭтаФорма["РасходПоНорме_" + ТекИндекс]; 
			НоваяСтрока.РасходПоФакту		= ЭтаФорма["РасходПоФакту_" + ТекИндекс]; 
			НоваяСтрока.РаспределитьПропорциональноОбъемам = Ложь;
			НоваяСтрока.БазисЦена			= ЭтаФорма["БазиснаяЦена_" + ТекИндекс];
			НоваяСтрока.БазисЗарплМаш		= ЭтаФорма["БазиснаяЗарплМаш_" + ТекИндекс];
			НоваяСтрока.ТекЦена				= ЭтаФорма["ТекущаяЦена_" + ТекИндекс];
			НоваяСтрока.ТекЗарплМаш			= ЭтаФорма["ТекущаяЗарплМаш_" + ТекИндекс];
		КонецЕсли;
	КонецЦикла;
	
	//Возврат ТабРезультат; 
	
	Адрес = ПоместитьВоВременноеХранилище(ТабРезультат,Новый УникальныйИдентификатор);
	Возврат Адрес;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьРесурс(Команда)
	
	Структура 					= Новый Структура("ЗаменяемыйРесурс, Ресурс, РасходПоНорме, РасходПоФакту,БазисЦена,БазисЗарплМаш,ТекЦена,ТекЗарплМаш");
	Структура.ЗаменяемыйРесурс 	= ЗаменяемыйРесурс;
	Структура.РасходПоНорме 	= РасходПоНорме;
	Структура.РасходПоФакту 	= РасходПоФакту;
	
	Если ЗначениеЗаполнено(ЭтаФорма.ЛокальнаяСмета) Тогда
		СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(ЭтаФорма.ЛокальнаяСмета);

		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("РегиональнаяБаза", СтруктураПараметровРасчетаЛС.РегионДляВыбораЦен);
		ПараметрыПоиска.Вставить("Район",СтруктураПараметровРасчетаЛС.Район);
		ПараметрыПоиска.Вставить("ДатаТекущихЦен",СтруктураПараметровРасчетаЛС.ДатаТекущихЦен);
		ПараметрыПоиска.Вставить("ТекРесурс",ЗаменяемыйРесурс);
	
		Оповещение = Новый ОписаниеОповещения("ПолучитьЗаменуРесурса",ЭтотОбъект,Структура);
		ОткрытьФорму("Справочник.СМ_Ресурсы.Форма.ФормаВыбора",ПараметрыПоиска,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьРесурс(Команда)
	
	ТекГруппа = ЭтаФорма.ТекущийЭлемент.Родитель;
	ТекИндекс = Прав(СокрЛП(ТекГруппа.Имя),1);
	УдалитьРеквизитыРесурса(ТекИндекс);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПолучитьЗаменуРесурса(Результат, Структура) Экспорт
	
	Структура.Ресурс = СМ_СметаКлиент.ПолучитьОдинРесурсИзМассива(Результат);
	Если Не ЗначениеЗаполнено(Структура.Ресурс) Тогда
		Возврат;
	КонецЕсли;
		
	// Получение текущих и базисных цен
	СтруктураЦен = Новый Структура();
	СтруктураЦен.Вставить("БазиснаяЦена");
	СтруктураЦен.Вставить("БазиснаяЗарплатаМашинистов");
	СтруктураЦен.Вставить("ТекущаяЦена");
	СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов");
	
	СтруктураДопПараметров = Новый Структура();
	СтруктураДопПараметров.Вставить("Район");
	СтруктураДопПараметров.Вставить("ДатаТекущихЦен");
	СтруктураДопПараметров.Вставить("ФайлТекущихЦен");
	СтруктураДопПараметров.Вставить("АвтозагрузкаЦен");
	СтруктураДопПараметров.Вставить("КодРегионаФайлаТекущихЦен");

	ПолучитьЦеныНовогоРесурса(Структура.Ресурс,СтруктураЦен,СтруктураДопПараметров);
	Структура.БазисЦена 		= СтруктураЦен.БазиснаяЦена;
	Структура.БазисЗарплМаш 	= СтруктураЦен.БазиснаяЗарплатаМашинистов;
	Структура.ТекЦена 			= СтруктураЦен.ТекущаяЦена;
	Структура.ТекЗарплМаш 		= СтруктураЦен.ТекущаяЗарплатаМашинистов;

	Если Не СметнаяКомпонента = Неопределено Тогда
		Если СтруктураДопПараметров.АвтозагрузкаЦен = Истина И СтруктураДопПараметров.ФайлТекущихЦен <> "" Тогда
			СМ_СметаКлиент.ПолучитьЦеныНовогоРесурса(Структура.Ресурс,СтруктураДопПараметров.Район,СтруктураДопПараметров.ФайлТекущихЦен,СтруктураДопПараметров.КодРегионаФайлаТекущихЦен,СтруктураЦен); 
			Структура.ТекЦена 		= СтруктураЦен.ТекущаяЦена;
			Структура.ТекЗарплМаш 	= СтруктураЦен.ТекущаяЗарплатаМашинистов;
		КонецЕсли;
	КонецЕсли;
	
	СоздатьГруппуРесурса();
	ЗаполнитьПоляДобавленногоРесурса(Структура);
	
	Индекс = Индекс + 1;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьЦеныНовогоРесурса(ТекРесурс,СтруктураЦен,СтруктураДопПараметров) 
	
	//СписокПозиций 				= Новый СписокЗначений(); 
	СтруктураПараметровРасчетаЛС 	= СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(ЭтаФорма.ЛокальнаяСмета);
	Район 							= СтруктураПараметровРасчетаЛС.Район;
	АвтоЗагрузкаЦен 				= СтруктураПараметровРасчетаЛС.АвтозагрузкаЦен;
	ДатаТекущихЦен 					= СтруктураПараметровРасчетаЛС.ДатаТекущихЦен;
	РегиональнаяБаза 				= СтруктураПараметровРасчетаЛС.РегионДляВыбораЦен;
	КодРегионаФайлаТекущихЦен 		= СтруктураПараметровРасчетаЛС.КодРегионаФайлаТекущихЦен;
	ФайлТекущихЦен 					= СтруктураПараметровРасчетаЛС.ФайлСборникаТекущихЦен;
	
	СтруктураДопПараметров.Вставить("АвтоЗагрузкаЦен",АвтоЗагрузкаЦен);
	СтруктураДопПараметров.Вставить("Район",Район);
	СтруктураДопПараметров.Вставить("ДатаТекущихЦен",ДатаТекущихЦен);
	СтруктураДопПараметров.Вставить("ФайлТекущихЦен",ФайлТекущихЦен);
	СтруктураДопПараметров.Вставить("КодРегионаФайлаТекущихЦен",КодРегионаФайлаТекущихЦен);
	
	// получим цены	
	ВыбиратьТекущиеЦены = ?(ФайлТекущихЦен = "", Истина, Ложь);			
	СМ_СметаВызовСервера.ПолучитьЦеныНовогоРесурса(ТекРесурс,Район,РегиональнаяБаза,ДатаТекущихЦен,СтруктураЦен,ВыбиратьТекущиеЦены);

КонецПроцедуры

&НаСервере
Процедура СоздатьГруппуРесурса()
	
	КЧ 	= Новый КвалификаторыЧисла(15,6);
	КЧ2 = Новый КвалификаторыЧисла(15,2);
	
	Массив = Новый Массив;
	Массив.Добавить(Тип("Число"));
	ОписаниеТиповЧ = Новый ОписаниеТипов(Массив,,,КЧ);	
	
	Массив = Новый Массив;
	Массив.Добавить(Тип("Число"));
	ОписаниеТиповЧ2 = Новый ОписаниеТипов(Массив,,,КЧ2);		
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.СМ_Ресурсы"));
	МассивТипов.Добавить(Тип("Строка"));
	ДопустимыеТипы = Новый ОписаниеТипов(МассивТипов);
	
	// Создаем новые реквизиты формы
	РеквизитРесурс				= Новый РеквизитФормы("Ресурс_" + Индекс,ДопустимыеТипы,,"Ресурс");
	РеквизитРасходПоНорме		= Новый РеквизитФормы("РасходПоНорме_" + Индекс,ОписаниеТиповЧ,,"По норме");
	РеквизитРасходПоФакту		= Новый РеквизитФормы("РасходПоФакту_" + Индекс,ОписаниеТиповЧ,,"По факту");
	РеквизитБазиснаяЦена		= Новый РеквизитФормы("БазиснаяЦена_" + Индекс,ОписаниеТиповЧ2,,"Базисная");
	РеквзиитТекущаяЦена			= Новый РеквизитФормы("ТекущаяЦена_" + Индекс,ОписаниеТиповЧ2,,"Текущая");
	РеквизитБазиснаяЗарплМаш 	= Новый РеквизитФормы("БазиснаяЗарплМаш_" + Индекс,ОписаниеТиповЧ2,,"в т.ч. ЗПМ");
	РеквизитТекущаяЗарплМаш  	= Новый РеквизитФормы("ТекущаяЗарплМаш_" + Индекс,ОписаниеТиповЧ2,,"в т.ч. ЗПМ");

	// Добавляем новые реквизиты на форму
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(РеквизитРесурс);
	ДобавляемыеРеквизиты.Добавить(РеквизитРасходПоНорме);
 	ДобавляемыеРеквизиты.Добавить(РеквизитРасходПоФакту);
 	ДобавляемыеРеквизиты.Добавить(РеквизитБазиснаяЦена);
 	ДобавляемыеРеквизиты.Добавить(РеквзиитТекущаяЦена);
 	ДобавляемыеРеквизиты.Добавить(РеквизитБазиснаяЗарплМаш);
 	ДобавляемыеРеквизиты.Добавить(РеквизитТекущаяЗарплМаш);
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);  
	
	// Добавляем группу ресурса
	ГруппаРесурса 						= Элементы.Вставить("ГруппаРесурса_" + Индекс,Тип("ГруппаФормы"),ЭтаФорма, Элементы.ДобавитьРесурс); 
    ГруппаРесурса.Вид 					= ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаРесурса.Заголовок 			= "Группа нового ресурса";
	ГруппаРесурса.Группировка 			= ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаРесурса.Отображение			= ОтображениеОбычнойГруппы.ОбычноеВыделение;
	ГруппаРесурса.ОтображатьЗаголовок 	= Ложь;
	
	ГруппаРесурсКнопка					= Элементы.Добавить("ГруппаРесурсКнопка_" + Индекс,Тип("ГруппаФормы"),ГруппаРесурса); 
    ГруппаРесурсКнопка.Вид 				= ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаРесурсКнопка.Заголовок 		= "Группа ресурс и кнопка";
	ГруппаРесурсКнопка.Группировка 		= ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	ГруппаРесурсКнопка.Отображение		= ОтображениеОбычнойГруппы.ОбычноеВыделение;
	ГруппаРесурсКнопка.ОтображатьЗаголовок = Ложь;
	
	// Добавляем группу расхода ресурса
   	ГруппаРасхода 						= Элементы.Добавить("ГруппаРасхода_" + Индекс,Тип("ГруппаФормы"),ГруппаРесурса);
    ГруппаРасхода.Вид 					= ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаРасхода.Заголовок 			= "Расход ресурса";
	ГруппаРасхода.Группировка 			= ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	                            	
	// Добавляем группу цен ресурса
	ГруппаЦен	 						= Элементы.Добавить("ГруппаЦен_" + Индекс,Тип("ГруппаФормы"),ГруппаРесурса);
    ГруппаЦен.Вид 						= ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаЦен.Заголовок 				= "Цены нового ресурса";
	ГруппаЦен.Группировка 				= ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	
	// Добавляем группу цен ресурсов левую
	ГруппаЦенЛевая						= Элементы.Добавить("ГруппаЦенЛевая_" + Индекс,Тип("ГруппаФормы"),ГруппаЦен);
    ГруппаЦенЛевая.Вид 					= ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаЦенЛевая.Заголовок 			= "Цены нового ресурса левая";
	ГруппаЦенЛевая.Группировка 			= ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаЦенЛевая.ОтображатьЗаголовок	= Ложь;
	
	// Добавляем группу цен ресурсов правую
	ГруппаЦенПравая						= Элементы.Добавить("ГруппаЦенПравая_" + Индекс,Тип("ГруппаФормы"),ГруппаЦен);
    ГруппаЦенПравая.Вид 				= ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаЦенПравая.Заголовок 			= "Цены нового ресурса правая";
	ГруппаЦенПравая.Группировка 		= ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаЦенПравая.ОтображатьЗаголовок	= Ложь;
	
	// Создаем новые элементы формы
    ЭлементРесурс						= Элементы.Добавить("Ресурс_" + Индекс, Тип("ПолеФормы"),ГруппаРесурсКнопка);
	ЭлементРесурс.Вид					= ВидПоляФормы.ПолеНадписи;
	ЭлементРесурс.ПутьКДанным 			= "Ресурс_" + Индекс;
	
    ЭлементКнопка						= Элементы.Добавить("УдалитьРесурс" + Индекс, Тип("КнопкаФормы"),ГруппаРесурсКнопка);
	ЭлементКнопка.Вид 					= ВидКнопкиФормы.ОбычнаяКнопка;
	ЭлементКнопка.Заголовок 			= "Удалить ресурс";
	ЭлементКнопка.ИмяКоманды 			= "УдалитьРесурс";
	
	ЭлементРасходПоНорме				= Элементы.Добавить("РасходПоНорме_" + Индекс, Тип("ПолеФормы"),ГруппаРасхода);
	ЭлементРасходПоНорме.Вид			= ВидПоляФормы.ПолеВвода;
	ЭлементРасходПоНорме.ПутьКДанным 	= "РасходПоНорме_" + Индекс;
	
    ЭлементРасходПоФакту 				= Элементы.Добавить("РасходПоФакту_" + Индекс, Тип("ПолеФормы"),ГруппаРасхода);
	ЭлементРасходПоФакту.Вид			= ВидПоляФормы.ПолеВвода;
	ЭлементРасходПоФакту.ПутьКДанным 	= "РасходПоФакту_" + Индекс;
	
    ЭлементБазиснаяЦена 				= Элементы.Добавить("БазиснаяЦена_" + Индекс, Тип("ПолеФормы"),ГруппаЦенЛевая);
	ЭлементБазиснаяЦена.Вид				= ВидПоляФормы.ПолеВвода;
	ЭлементБазиснаяЦена.ПутьКДанным 	= "БазиснаяЦена_" + Индекс;
	
    ЭлементТекущаяЦена 					= Элементы.Добавить("ТекущаяЦена_" + Индекс, Тип("ПолеФормы"),ГруппаЦенПравая);
	ЭлементТекущаяЦена.Вид				= ВидПоляФормы.ПолеВвода;
	ЭлементТекущаяЦена.ПутьКДанным 		= "ТекущаяЦена_" + Индекс;
	
    ЭлементБазиснаяЗарплМаш				= Элементы.Добавить("БазиснаяЗарплМаш_" + Индекс, Тип("ПолеФормы"),ГруппаЦенЛевая);
	ЭлементБазиснаяЗарплМаш.Вид			= ВидПоляФормы.ПолеВвода;
	ЭлементБазиснаяЗарплМаш.ПутьКДанным = "БазиснаяЗарплМаш_" + Индекс;
	
    ЭлементТекущаяЗарплМа 				= Элементы.Добавить("ТекущаяЗарплМаш_" + Индекс, Тип("ПолеФормы"),ГруппаЦенПравая);
	ЭлементТекущаяЗарплМа.Вид			= ВидПоляФормы.ПолеВвода;
	ЭлементТекущаяЗарплМа.ПутьКДанным 	= "ТекущаяЗарплМаш_" + Индекс;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоляДобавленногоРесурса(Структура)
	
	ЭтаФорма["Ресурс_" + Индекс] 			= Структура.Ресурс;
	ЭтаФорма["РасходПоНорме_" + Индекс] 	= Структура.РасходПоНорме;
	ЭтаФорма["РасходПоФакту_" + Индекс] 	= Структура.РасходПоФакту;
	ЭтаФорма["БазиснаяЦена_" + Индекс] 		= Структура.БазисЦена;
	ЭтаФорма["ТекущаяЦена_" + Индекс] 		= Структура.ТекЦена;
	ЭтаФорма["БазиснаяЗарплМаш_" + Индекс] 	= Структура.БазисЗарплМаш;
	ЭтаФорма["ТекущаяЗарплМаш_" + Индекс] 	= Структура.ТекЗарплМаш;
	
КонецПроцедуры	

&НаСервере
Процедура УдалитьРеквизитыРесурса(ТекИндекс)
	
	// Удаляем реквизиты по ресурсу
	УдаляемыеРеквизиты = Новый Массив;
	УдаляемыеРеквизиты.Добавить("Ресурс_" + ТекИндекс);
	УдаляемыеРеквизиты.Добавить("РасходПоНорме_" + ТекИндекс);
	УдаляемыеРеквизиты.Добавить("РасходПоФакту_" + ТекИндекс);
	УдаляемыеРеквизиты.Добавить("БазиснаяЦена_" + ТекИндекс);
	УдаляемыеРеквизиты.Добавить("ТекущаяЦена_" + ТекИндекс);
	УдаляемыеРеквизиты.Добавить("БазиснаяЗарплМаш_" + ТекИндекс);
	УдаляемыеРеквизиты.Добавить("ТекущаяЗарплМаш_" + ТекИндекс);
	ИзменитьРеквизиты(,УдаляемыеРеквизиты);  		
	
	// Удаляем элементы по ресурсу
	ТекГруппа = ЭтаФорма.Элементы.Найти("ГруппаРесурса_" + ТекИндекс);
	Если ТекГруппа <> Неопределено Тогда
		ЭтаФорма.Элементы.Удалить(ТекГруппа);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
