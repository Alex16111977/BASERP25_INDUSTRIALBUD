
#Область ОбработчикиСобытий

// // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // 
//  Обработчики событий формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//  Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьПроверкуПравДоступа("СохранениеДанныхПользователя", Метаданные);
	
	//  Пользователи
	АвторизованныйПользователь = Пользователи.АвторизованныйПользователь();
	//  Конец Пользователи
	Если ЗначениеЗаполнено(Параметры.ТекОбъект) Тогда
		Элементы.СписокОбъектыСтроительства.ТекущаяСтрока = Параметры.ТекОбъект;
	КонецЕсли;
	
	МетодикаТСН 				 = ПолучитьФункциональнуюОпцию("СМ_МетодикаТСНГородаМосква");
	Элементы.РасчетТСН.Видимость = МетодикаТСН;
	
	Если Пользователи.РолиДоступны("СМ_АдминистраторСмета, АдминистраторСистемы, ПолныеПрава") Тогда
		Элементы.СМ_МетодикаТСН.Доступность = СМ_СметаВызовСервера.РФРегионыПользователей();
	Иначе
		Элементы.СМ_МетодикаТСН.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры 

// // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // 
//  Прочие обработчики

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	ЗаписатьДанные();	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьУИНнастройки(ОбъектНастройки)
	
	УИНнастройки = "";
	Если Не ОбъектНастройки = Неопределено
		И ОбъектНастройки.ЭтоГруппа Тогда
		Возврат УИНнастройки;
	КонецЕсли;
	
	Если Не ОбъектНастройки = Неопределено Тогда
		УИНнастройки = Строка(ОбъектНастройки.УникальныйИдентификатор());
	КонецЕсли;
	
	Возврат УИНнастройки;
	
КонецФункции

&НаКлиенте
Процедура ЗаписатьДанные()
	
	Если Элементы.СписокОбъектыСтроительства.ТекущиеДанные = Неопределено тогда
		Возврат
	КонецЕсли;
	
	УИНнастройки = ПолучитьУИНнастройки(Элементы.СписокОбъектыСтроительства.ТекущиеДанные.Ссылка);
	
	Если УИНнастройки = "" Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтруктур	= Новый Массив;
	СписокНастроек	= СМ_СметаВызовСервера.ПолучитьСписокНастроекПоОбъектам(Элементы.СписокОбъектыСтроительства.ТекущиеДанные.Ссылка);
	
	Для каждого Структура из СписокНастроек Цикл
		
		МассивСтруктур.Добавить(ОписаниеНастройки(
			"НастройкиПользователяСмета",
			Структура.Настройка,
			ЭтаФорма[Структура.ПолеФормы]));

	КонецЦикла;		
		
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранитьМассивИОбновитьПовторноИспользуемыеЗначения(МассивСтруктур);
	
КонецПроцедуры

&НаКлиенте
Функция ОписаниеНастройки(Объект, Настойка, Значение)
	
	Элемент = Новый Структура;
	Элемент.Вставить("Объект", Объект);
	Элемент.Вставить("Настройка", Настойка);
	Элемент.Вставить("Значение", Значение);
	
	Возврат Элемент;
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(Параметры.ТекСтраница) Тогда
		Элементы.Группа.ТекущаяСтраница = Элементы.Группа.ПодчиненныеЭлементы[Параметры.ТекСтраница];
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьНастройки(ОбъектНастройки = Неопределено)
	
	СписокНастроек	= СМ_СметаВызовСервера.ПолучитьСписокНастроекПоОбъектам(ОбъектНастройки);
	
	Для каждого Структура из СписокНастроек Цикл
		
		ЭтаФорма[Структура.ПолеФормы]
			= ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
				"НастройкиПользователяСмета",
				Структура.Настройка,
				Структура.ЗначениеПоУмолчанию);
			
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСтрокиДерева(Строки, КодОтец, тзДерево)
	
	Отбор = Новый Структура();
	Отбор.Вставить("Отец", КодОтец);
	
	Массив = тзДерево.НайтиСтроки(Отбор);
	
	Для Каждого Строка Из Массив Цикл
		СтрокаДЗ = Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДЗ, Строка);
		ЗаполнитьСтрокиДерева(СтрокаДЗ.Строки, Строка.ИД, тзДерево);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИтогиПоГлавам(Результат, Структура) Экспорт
	Если Не Результат = Неопределено
		И Не Результат.Пустая() Тогда
		СМ_ИтогСметыДляДерева = Результат;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СМ_ИтогСметыДляДереваНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Оповещение = Новый ОписаниеОповещения("ПолучитьИтогиПоГлавам", ЭтаФорма);
	ОткрытьФорму("Справочник.СМ_ИтогиПоГлавам.ФормаВыбора",,,,,,Оповещение,РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

&НаКлиенте
Процедура СписокОбъектыСтроительстваПриАктивизацииСтроки(Элемент)
	ПолучитьНастройки(Элемент.ТекущаяСтрока);
КонецПроцедуры

#КонецОбласти