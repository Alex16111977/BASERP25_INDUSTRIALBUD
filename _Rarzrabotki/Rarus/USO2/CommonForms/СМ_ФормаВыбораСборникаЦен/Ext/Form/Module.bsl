#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста 
Функция ВернутьДатуСеанса()
	Возврат ТекущаяДатаСеанса();
КонецФункции

&НаСервере
Процедура ЗагрузитьСписокСборниковСервер(Данные, ВерсияКомпоненты)
	
	ТаблицаСборниковТЗ = РеквизитФормыВЗначение("ТаблицаСборников", Тип("ТаблицаЗначений"));
	СМ_СметаЗагрузкаВызовСервера.ЗаполнитьСборникиДоступныеИзXML(Данные, ТаблицаСборниковТЗ, ВерсияКомпоненты);
	ЗначениеВРеквизитФормы(ТаблицаСборниковТЗ, "ТаблицаСборников");
	
КонецПроцедуры  

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Попытка
		Если Параметры.СборникиРесурсов Тогда
			Данные = СметнаяКомпонента.ПолучитьСписокДоступныхСборниковТекущихЦен();
		Иначе
			Данные = СметнаяКомпонента.ПолучитьСписокДоступныхСборниковКоэффициентов();
		КонецЕсли;
	Исключение
		Событие = НСтр("ru = 'Исключение Выбор сборника'");
		СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
	КонецПопытки;      		
	
	Если ЗначениеЗаполнено(Данные) Тогда
		ЗагрузитьСписокСборниковСервер(Данные, СМ_ВерсияКомпоненты);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	Структура = Новый Структура();
	Структура.Вставить("ИмяФайла",?((Элементы.ТаблицаСборников.ТекущиеДанные<>Неопределено),СокрЛП(Элементы.ТаблицаСборников.ТекущиеДанные.ИмяФайла),""));
	Структура.Вставить("Представление",?((Элементы.ТаблицаСборников.ТекущиеДанные<>Неопределено),СокрЛП(Элементы.ТаблицаСборников.ТекущиеДанные.Представление),""));
	Структура.Вставить("Дата",?((Элементы.ТаблицаСборников.ТекущиеДанные<>Неопределено),СокрЛП(Элементы.ТаблицаСборников.ТекущиеДанные.Дата),ВернутьДатуСеанса()));
	Структура.Вставить("КодНормативнойБазы",?((Элементы.ТаблицаСборников.ТекущиеДанные<>Неопределено),СокрЛП(Элементы.ТаблицаСборников.ТекущиеДанные.КодНормативнойБазы),""));
	Закрыть(Структура);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Структура = Новый Структура();
	Структура.Вставить("ИмяФайла","");
	Структура.Вставить("Представление","");
	Структура.Вставить("Дата",НачалоМесяца(ВернутьДатуСеанса()));
	Структура.Вставить("КодНормативнойБазы","");
	Закрыть(Структура);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСборниковВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОК(ВыбраннаяСтрока);
КонецПроцедуры

#КонецОбласти



