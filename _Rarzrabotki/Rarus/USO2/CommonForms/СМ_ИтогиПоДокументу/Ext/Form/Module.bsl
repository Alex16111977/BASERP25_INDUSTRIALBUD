
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДокСсылка = Параметры.ВыбранныйДокумент;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если не ЗначениеЗаполнено(ДокСсылка) Тогда 
		Возврат;
	КонецЕсли;	
	
	СформироватьЭлементыФормыСервер();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьЭлементыФормыСервер()
	
	Регистры = ПолучитьСписокРегистров();
	ВывестиТаблицыСервер(Регистры);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокРегистров()
	
	ТипДок 					= ТипЗнч(ДокСсылка);
	СтрктРегистрыСведений 	= Новый Структура;
	
	Для Каждого рс из Метаданные.РегистрыСведений Цикл 
		Если Лев(рс.имя, 3) <> "СМ_" ИЛИ рс.имя = "СМ_ВерсииОбъектов" Тогда 
			Продолжить;
		КонецЕсли;	
		Для Каждого изм из рс.Измерения Цикл 
			Если изм.Тип.СодержитТип(ТипДок) Тогда
				ТаблицаРезультат = ПолучитьТаблицу(рс.Имя, изм.Имя, ДокСсылка);
				стрктРегистрыСведений.Вставить(рс.Имя, ТаблицаРезультат);
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;
	
	Возврат стрктРегистрыСведений;
	
КонецФункции

&НаСервере
Процедура ВывестиТаблицыСервер(СписокРегистров)
	
	// Для отладки удалим реквизиты и элементы
	СтраницаСРегистрами = Элементы.Найти("ГруппаСтраницРегистры");
	Если СтраницаСРегистрами <> Неопределено Тогда 
		Элементы.Удалить(СтраницаСРегистрами);
		УдаляемыеРеквизиты = Новый Массив;
		Реквизиты = ПолучитьРеквизиты();
		Для Каждого р из Реквизиты Цикл 
			Если Лев(р.Имя, 3) = "СМ_" Тогда 
				УдаляемыеРеквизиты.Добавить(р.Имя);
			КонецЕсли;
		КонецЦикла;	
		ИзменитьРеквизиты(,УдаляемыеРеквизиты);
	КонецЕсли;	

	ГруппаСтраницы 				= Элементы.Добавить("ГруппаСтраницРегистры", Тип("ГруппаФормы"), ЭтаФорма);
    ГруппаСтраницы.Вид 			= ВидГруппыФормы.Страницы;
    ГруппаСтраницы.Заголовок 	= "Регистры";
	
	МассивДобавляемыхРеквизитов	= Новый Массив;
	ТипТЗ = Новый ОписаниеТипов("ТаблицаЗначений");
	
	Для Каждого Регистр из СписокРегистров Цикл 
		
		ИмяРегистра = Регистр.Ключ;
		ИмяСтраницы = "Страница" + ИмяРегистра;
		
	    ЭлементСтраница 			= Элементы.Добавить(ИмяСтраницы, Тип("ГруппаФормы"), ГруппаСтраницы);
	    ЭлементСтраница.Вид 		= ВидГруппыФормы.Страница;
	    ЭлементСтраница.Заголовок 	= Метаданные.РегистрыСведений[ИмяРегистра].Синоним;
		
	    РеквизитТаблица = Новый РеквизитФормы(ИмяРегистра, ТипТЗ);
	    МассивДобавляемыхРеквизитов.Добавить(РеквизитТаблица);
		
		ТаблицаРасчетов = Регистр.Значение;
		Если ТаблицаРасчетов.Количество() > 0 Тогда
			Для Каждого Колонка из ТаблицаРасчетов.Колонки Цикл 
				РеквизитКолонка = Новый РеквизитФормы(колонка.Имя, колонка.ТипЗначения, РеквизитТаблица.Имя);
				РеквизитКолонка.Заголовок = колонка.Заголовок;
				МассивДобавляемыхРеквизитов.Добавить(РеквизитКолонка);
			КонецЦикла;	
		КонецЕсли;

	КонецЦикла;
	
	ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	Для Каждого Регистр из СписокРегистров Цикл 
		
		ИмяРегистра = Регистр.Ключ;
		ИмяСтраницы = "Страница" + ИмяРегистра;
		Страница 	= Элементы.Найти(ИмяСтраницы);
		
	    ЭлементФормыТаблица = Элементы.Добавить(ИмяРегистра, Тип("ТаблицаФормы"), Страница);
	    ЭлементФормыТаблица.ПутьКДанным = ИмяРегистра;
		ЭлементФормыТаблица.ТолькоПросмотр = Истина;
		ЭлементФормыТаблица.КоманднаяПанель.Видимость = Ложь;
		ЭлементФормыТаблица.КонтекстноеМеню.Видимость = Ложь;
		ЭлементФормыТаблица.КонтекстноеМеню.Доступность = Ложь;
		
		ТаблицаРасчетов = Регистр.Значение;
		Если ТаблицаРасчетов.Количество() > 0 Тогда 
			Для Каждого колонка из ТаблицаРасчетов.Колонки Цикл 
				ИмяКолонки = ИмяРегистра + колонка.Имя;
				Путь = ИмяРегистра + "." + колонка.Имя;
				ЭлементФормыКолонка = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), ЭлементФормыТаблица);
				ЭлементФормыКолонка.Вид = ВидПоляФормы.ПолеВвода;
				ЭлементФормыКолонка.ПутьКДанным = Путь;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Реквизиты = ПолучитьРеквизиты();
	Для Каждого т из СписокРегистров Цикл 
		ЗначениеВРеквизитФормы(СписокРегистров[т.Ключ], т.Ключ);
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьТаблицу(ИмяРегистра, ИмяПараметра, ЗначениеПараметра)

	Запрос = Новый Запрос();
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 10 
							|* 	
							|ИЗ РегистрСведений." + ИмяРегистра + " КАК " + ИмяРегистра + "
							|ГДЕ " + ИмяРегистра + "." + ИмяПараметра + " = &" + ИмяПараметра;
	Запрос.Текст = ТекстЗапроса;	
	Запрос.УстановитьПараметр(ИмяПараметра, ЗначениеПараметра);
	
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Для каждого кол из ТабРезультат.Колонки Цикл 
		ИмяКолонки = кол.Имя;
		РегСведений = Метаданные.РегистрыСведений[ИмяРегистра];
		
		ВРесурсах = РегСведений.Ресурсы.Найти(ИмяКолонки);
		Если ВРесурсах <> Неопределено Тогда 
			кол.Заголовок = ВРесурсах.Синоним;
			Продолжить;
		КонецЕсли;
		
		ВИзмерениях = РегСведений.Измерения.Найти(ИмяКолонки);
		Если ВИзмерениях <> Неопределено Тогда 
			кол.Заголовок = ВИзмерениях.Синоним;
			Продолжить;
		КонецЕсли;
		
		ВРеквизитах = РегСведений.Реквизиты.Найти(ИмяКолонки);
		Если ВРеквизитах <> Неопределено Тогда 
			кол.Заголовок = ВРеквизитах.Синоним;
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат ТабРезультат;						

КонецФункции	

#КонецОбласти




