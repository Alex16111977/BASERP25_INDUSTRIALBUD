#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция КорректностьВводаОператора()
	
	Корректно = истина;	
	
	Если ПустаяСтрока(Формула) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='В формуле нет аргументов'"));
		Корректно = Ложь;	
	КонецЕсли;

	Если НЕ СписокОператоров.НайтиПоЗначению(Прав(Формула,1)) = Неопределено  Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Нет аргумента'"));
		Корректно = Ложь;	
	КонецЕсли;
	
	Возврат Корректно;
	
КонецФункции

&НаКлиенте
Процедура ПолучитьИтогиПоГлавам(Результат, Структура) Экспорт
	ИтогиПоГлавам = Результат;
	Формула = Формула + ПолучитьИдентификатор(ИтогиПоГлавам);
	ОписаниеФормулы = СМ_СметаКлиент.ПолучитьОписаниеФормулы(Формула);
КонецПроцедуры

&НаКлиенте
Процедура КнопкаОткрытьИтогиПоГлавам(Команда)	
	Оповещение = Новый ОписаниеОповещения("ПолучитьИтогиПоГлавам", ЭтотОбъект);
	ОткрытьФорму("Справочник.СМ_ИтогиПоГлавам.ФормаВыбора",,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьЛимитированныеЗатраты(Результат, Структура) Экспорт
	ЛимЗатрата = Результат;
	Формула = Формула + ПолучитьИдентификатор(ЛимЗатрата);
	ОписаниеФормулы = СМ_СметаКлиент.ПолучитьОписаниеФормулы(Формула);
КонецПроцедуры

&НаКлиенте
Процедура КнопкаОткрытьЛимЗатраты(Команда)	
	Оповещение = Новый ОписаниеОповещения("ПолучитьЛимитированныеЗатраты", ЭтотОбъект);
	ОткрытьФорму("Справочник.СМ_ЛимитированныеЗатраты.ФормаВыбора",,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры



&НаКлиенте
Процедура КнопкаПлюсНажатие(Команда)
		
	Если НЕ КорректностьВводаОператора() Тогда 
		Возврат;
	КонецЕсли;
	Формула = Формула + " + ";
	ОписаниеФормулы = СМ_СметаКлиент.ПолучитьОписаниеФормулы(Формула);
КонецПроцедуры

&НаКлиенте
Процедура КнопкаМинусНажатие(Команда)
	
	Если НЕ КорректностьВводаОператора() Тогда 
		Возврат;
	КонецЕсли;
	Формула = Формула + " - ";
	ОписаниеФормулы = ОписаниеФормулы + " - ";
КонецПроцедуры

&НаКлиенте
Процедура КнопкаУдалНажатие(Команда)
	
	КолУдал = ?(Лев(Прав(Формула,2),1) = " ",2,1);
	Формула = Лев(Формула,СтрДлина(Формула) - КолУдал);
	ОписаниеФормулы = СМ_СметаКлиент.ПолучитьОписаниеФормулы(Формула);
	
КонецПроцедуры

&НаКлиенте
Процедура КнопкаВводНажатие(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтаФорма);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Сохранить формулу?';"
	+ " en = 'Do you want to continue?'"), Режим, 0);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
	СтруктураВозврата = Новый Структура();
	СтруктураВозврата.Вставить("Формула",Формула);
	СтруктураВозврата.Вставить("ОписаниеФормулы",ОписаниеФормулы);
	Закрыть(СтруктураВозврата);	
КонецПроцедуры

&НаСервере
Функция ПолучитьИдентификатор(Ссылка)	
	Справочник = Ссылка.ПолучитьОбъект();
	Возврат Справочник.Идентификатор;	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	Формула = Параметры.Формула;
    ОписаниеФормулы = Параметры.ОписаниеФормулы;
КонецПроцедуры

&НаКлиенте
Процедура ПолеВводаФормулаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, Параметры, СтандартнаяОбработка)
	ФормулаЛЗ = Текст;

	ОписаниеФормулы = СМ_СметаКлиент.ПолучитьОписаниеФормулы(ФормулаЛЗ);
	
	Формула = Текст;
КонецПроцедуры


СписокОператоров = Новый СписокЗначений();
СписокОператоров.Добавить("+");
СписокОператоров.Добавить("-");

#КонецОбласти