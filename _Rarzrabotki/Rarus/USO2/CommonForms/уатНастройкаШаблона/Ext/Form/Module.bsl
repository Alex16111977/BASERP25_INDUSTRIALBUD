#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьШаблоны(Команда)
	
	Если Модифицированность Тогда 
		ДанныеШаблоновУзловОбъектовЭксплуатации = Новый Соответствие();
		Для Каждого ТекСтрока Из Справочник_УзлыОбъектовЭксплуатации_ТекстыШаблонов Цикл 
			ДанныеШаблоновУзловОбъектовЭксплуатации.Вставить(ТекСтрока.ТипАгрегата, ТекСтрока.ТекстШаблона);
		КонецЦикла;
		
		НастройкиШаблонов = Новый Структура();
		НастройкиШаблонов.Вставить("Справочник_ТранспортныеСредства",     Справочник_ТранспортныеСредства_ТекстШаблона);
		НастройкиШаблонов.Вставить("Справочник_уатПунктыНазначения",      Справочник_уатПунктыНазначения_ТекстШаблона);
		НастройкиШаблонов.Вставить("Справочник_УзлыОбъектовЭксплуатации", ДанныеШаблоновУзловОбъектовЭксплуатации);
		
		уатНастройкиШаблонов.ЗаписатьТекстыШаблонов(НастройкиШаблонов);
		Модифицированность = Ложь;
	КонецЕсли;
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Справочник_УзлыОбъектовЭксплуатации_СкопироватьИзДругогоТипа(Команда)
	
	СписокВыбораТипов = Новый СписокЗначений();
	Для Каждого ТекСтрока Из Справочник_УзлыОбъектовЭксплуатации_ТекстыШаблонов Цикл 
		Если ТекСтрока.ТипАгрегата = Справочник_УзлыОбъектовЭксплуатации_ТипАгрегата Тогда 
			Продолжить;
		КонецЕсли;
		
		СписокВыбораТипов.Добавить(
			Новый Структура("ТипАгрегата, ТекстШаблона", ТекСтрока.ТипАгрегата, ТекСтрока.ТекстШаблона),
			?(ЗначениеЗаполнено(ТекСтрока.ТипАгрегата), 
				Строка(ТекСтрока.ТипАгрегата), 
				НСтр("ru = '<Все типы агрегатов>'")
			)
		);
	КонецЦикла;
	
	Если СписокВыбораТипов.Количество() Тогда 
		СписокВыбораТипов.ПоказатьВыборЭлемента(
			Новый ОписаниеОповещения("УзлыОбъектовЭксплуатации_ОбработкаВыбораИсточника", ЭтотОбъект)
		);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Справочник_ТранспортныеСредства_ВосстановитьПоУмолчанию(Команда)
	
	Справочник_ТранспортныеСредства_ТекстШаблона = уатНастройкиШаблонов.ПолучитьТекстШаблонаПоУмолчанию("Справочник_ТранспортныеСредства");
	СформироватьПримерыНаименований();
	
КонецПроцедуры

&НаКлиенте
Процедура Справочник_уатПунктыНазначения_ВосстановитьПоУмолчанию(Команда)
	
	Справочник_уатПунктыНазначения_ТекстШаблона = уатНастройкиШаблонов.ПолучитьТекстШаблонаПоУмолчанию("Справочник_уатПунктыНазначения");
	СформироватьПримерыНаименований();
	
КонецПроцедуры

&НаКлиенте
Процедура Справочник_УзлыОбъектовЭксплуатации_ВосстановитьПоУмолчанию(Команда)
	
	ТекстыШаблонов = уатНастройкиШаблонов.ПолучитьТекстШаблонаПоУмолчанию("Справочник_УзлыОбъектовЭксплуатации");
	
	ТекстШаблонаПоТипу = ТекстыШаблонов.Получить(Справочник_УзлыОбъектовЭксплуатации_ТипАгрегата);
	ТекстШаблонаОбщий  = ТекстыШаблонов.Получить(ПредопределенноеЗначение("Справочник.уатТипыАгрегатов.ПустаяСсылка"));
	
	Если ТекстШаблонаПоТипу = Неопределено Тогда 
		Справочник_УзлыОбъектовЭксплуатации_ТекстШаблона = ТекстШаблонаОбщий;
	Иначе 
		Справочник_УзлыОбъектовЭксплуатации_ТекстШаблона = ТекстШаблонаПоТипу;
	КонецЕсли;
	
	УзлыОбъектовЭксплуатации_ЗаписатьТекстШаблонаПоТипу();
	
	СформироватьПримерыНаименований();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВидимость()
	
	Если ОбъектНастройки = "Справочник_ТранспортныеСредства" Или ОбъектНастройки = "" Тогда 
		Элементы.СтраницаСправочник_ТранспортныеСредства.Видимость = Истина;
	Иначе 
		Элементы.СтраницаСправочник_ТранспортныеСредства.Видимость = Ложь;
	КонецЕсли;
	
	Если ОбъектНастройки = "Справочник_уатПунктыНазначения" Или ОбъектНастройки = "" Тогда 
		Элементы.СтраницаСправочник_уатПунктыНазначения.Видимость = Истина;
	Иначе 
		Элементы.СтраницаСправочник_уатПунктыНазначения.Видимость = Ложь;
	КонецЕсли;
	
	Если ОбъектНастройки = "Справочник_УзлыОбъектовЭксплуатации" Или ОбъектНастройки = "" Тогда 
		Элементы.СтраницаСправочник_УзлыОбъектовЭксплуатации.Видимость = Истина;
	Иначе 
		Элементы.СтраницаСправочник_УзлыОбъектовЭксплуатации.Видимость = Ложь;
	КонецЕсли;
	
	Если ОбъектНастройки = "" Тогда 
		Элементы.СтраницыОбъектов.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
	Иначе 
		Элементы.СтраницыОбъектов.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УзлыОбъектовЭксплуатации_ЗаписатьТекстШаблонаПоТипу()
	
	НайдСтроки = Справочник_УзлыОбъектовЭксплуатации_ТекстыШаблонов.НайтиСтроки(
		Новый Структура("ТипАгрегата", Справочник_УзлыОбъектовЭксплуатации_ТипАгрегата)
	);
	
	Если НайдСтроки.Количество() Тогда 
		НайдСтроки[0].ТекстШаблона = Справочник_УзлыОбъектовЭксплуатации_ТекстШаблона;
	Иначе 
		НовСтрока = Справочник_УзлыОбъектовЭксплуатации_ТекстыШаблонов.Добавить();
		НовСтрока.ТипАгрегата  = Справочник_УзлыОбъектовЭксплуатации_ТипАгрегата;
		НовСтрока.ТекстШаблона = Справочник_УзлыОбъектовЭксплуатации_ТекстШаблона;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьШаблонПоТипуУзлаОбъектаЭксплуатации()
	
	НайдСтроки = Справочник_УзлыОбъектовЭксплуатации_ТекстыШаблонов.НайтиСтроки(
		Новый Структура("ТипАгрегата", Справочник_УзлыОбъектовЭксплуатации_ТипАгрегата)
	);
	
	Если НайдСтроки.Количество() Тогда 
		Справочник_УзлыОбъектовЭксплуатации_ТекстШаблона = НайдСтроки[0].ТекстШаблона;
	Иначе 
		Справочник_УзлыОбъектовЭксплуатации_ТекстШаблона = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УзлыОбъектовЭксплуатации_ОбработкаВыбораИсточника(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт 
	
	Если ВыбранныйЭлемент = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если ВыбранныйЭлемент.Значение.ТипАгрегата = ПредопределенноеЗначение("Справочник.уатТипыАгрегатов.Шина") 
			И Не Справочник_УзлыОбъектовЭксплуатации_ТипАгрегата = ПредопределенноеЗначение("Справочник.уатТипыАгрегатов.Шина") Тогда 
		Справочник_УзлыОбъектовЭксплуатации_ТекстШаблона = СтрЗаменить(
			ВыбранныйЭлемент.Значение.ТекстШаблона,
			НСтр("ru = '[СрокСлужбыШины]'"),
			НСтр("ru = '[ГоденДо]'")
		);
		
	ИначеЕсли Не ВыбранныйЭлемент.Значение.ТипАгрегата = ПредопределенноеЗначение("Справочник.уатТипыАгрегатов.Шина")
			И Справочник_УзлыОбъектовЭксплуатации_ТипАгрегата = ПредопределенноеЗначение("Справочник.уатТипыАгрегатов.Шина") Тогда 
		Справочник_УзлыОбъектовЭксплуатации_ТекстШаблона = СтрЗаменить(
			ВыбранныйЭлемент.Значение.ТекстШаблона,
			НСтр("ru = '[ГоденДо]'"),
			НСтр("ru = '[СрокСлужбыШины]'")
		);
		
	Иначе 
		Справочник_УзлыОбъектовЭксплуатации_ТекстШаблона = ВыбранныйЭлемент.Значение.ТекстШаблона;
	КонецЕсли;
	
	УзлыОбъектовЭксплуатации_ЗаписатьТекстШаблонаПоТипу();
	
	Модифицированность = Истина;
	
	СформироватьПримерыНаименований();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьПримерыНаименований()
	
	Справочник_ТранспортныеСредства_Пример = уатНастройкиШаблонов.СформироватьНаименованиеПоШаблону(
		"Справочник_ТранспортныеСредства",
		ПолучитьДемоОбъект_Справочник_ТранспортныеСредства(), 
		Справочник_ТранспортныеСредства_ТекстШаблона
	);
	
	Справочник_уатПунктыНазначения_Пример = уатНастройкиШаблонов.СформироватьНаименованиеПоШаблону(
		"Справочник_уатПунктыНазначения",
		ПолучитьДемоОбъект_Справочник_уатПунктыНазначения(), 
		Справочник_уатПунктыНазначения_ТекстШаблона
	);
	   
	ДанныеШаблоновУзловОбъектовЭксплуатации = Новый Соответствие();
	ДанныеШаблоновУзловОбъектовЭксплуатации.Вставить(
		Справочник_УзлыОбъектовЭксплуатации_ТипАгрегата, 
		Справочник_УзлыОбъектовЭксплуатации_ТекстШаблона
	);
	
