&НаСервере
Функция ПолучитьДемоОбъект_Справочник_УзлыОбъектовЭксплуатации()
	
	ДемоОбъект = Новый Структура();
	
	Если Справочник_УзлыОбъектовЭксплуатации_ТипАгрегата = Справочники.уатТипыАгрегатов.Аптечка Тогда 
		ДемоОбъект.Вставить("Модель",        "Mechanical Brothers Авто АА-01");
		ДемоОбъект.Вставить("СерийныйНомер", "002341");
		ДемоОбъект.Вставить("ТипАгрегата",   Справочник_УзлыОбъектовЭксплуатации_ТипАгрегата);
		ДемоОбъект.Вставить("ГоденДо",       '20190501');
		
	ИначеЕсли Справочник_УзлыОбъектовЭксплуатации_ТипАгрегата = Справочники.уатТипыАгрегатов.Шина Тогда 
		ДемоОбъект.Вставить("Модель",         "Michelin Energy");
		ДемоОбъект.Вставить("СерийныйНомер",  "002341");
		ДемоОбъект.Вставить("ТипАгрегата",    Справочник_УзлыОбъектовЭксплуатации_ТипАгрегата);
		ДемоОбъект.Вставить("СрокСлужбыШины", 60);
		
	Иначе 
		ДемоОбъект.Вставить("Модель",        "BOSCH S3");
		ДемоОбъект.Вставить("СерийныйНомер", "002341");
		ДемоОбъект.Вставить("ТипАгрегата",   Справочник_УзлыОбъектовЭксплуатации_ТипАгрегата);
		ДемоОбъект.Вставить("ГоденДо",       '20200201');
	КонецЕсли;
	
	Возврат ДемоОбъект;
	
КонецФункции // ПолучитьДемоОбъект_Справочник_УзлыОбъектовЭксплуатации()

