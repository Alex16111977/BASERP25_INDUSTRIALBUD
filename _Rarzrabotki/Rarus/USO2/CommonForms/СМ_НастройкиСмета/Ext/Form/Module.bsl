// Процедура осуществляет запись сертификата (на доступ к СНБ) в базу после диалога пользователя.
// ПАРАМЕТРЫ:
// // Результат - ответ пользователя на вопрос (продолжать или нет)
// // СтруктураПараметров - дополнительные параметры переданные при формировании вопроса пользователю.
&НаКлиенте
Процедура ЗаписатьСертификатОтвет(Результат, СтруктураПараметров) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	// Подготовим структуру, чтобы передать ее в функцию выбора файла.
	ПутьКФайлу = "";
	
	// Если ИД найден, то загружаем сертификат.
	Если СМ_ИДКлюча <> "" Тогда
		// Выбираем файл.
		СМ_СметаКлиент.сфВыборФайла(ПутьКФайлу, "ini", "DataSert", Истина, Ложь);
		// Читаем выбранный файл.
		Текст = Новый ТекстовыйДокумент();
		Текст.Прочитать(ПутьКФайлу, КодировкаТекста.ANSI);
		Если Текст.КоличествоСтрок() > 1 Тогда
			ТекстСерт = "";
			ИдСерт = "";
			Прог = "0";
			Если Текст.ПолучитьСтроку(1) ="[SMETA PLUS]" Тогда
				
				Для ном = 1 По (Текст.КоличествоСтрок()) Цикл
					
					Стр = Текст.ПолучитьСтроку(ном);
					
					Если Лев(Стр, 12) = "SERTIFICATE=" Тогда
						// Запоминаем сам сертификат.
						ТекстСерт = СокрЛП(СтрЗаменить(Прав(Стр, СтрДлина(Стр)-12), " ", ""));
					КонецЕсли;     
					Если Лев(Стр, 5) = "HASP=" Тогда
						// Запоминаем ИД в сертификате.
						ИдСерт = Прав(Стр, СтрДлина(Стр)-5);	
					КонецЕсли;
					Если Лев(Стр, 5) = "PROG=" Тогда
						// Запоминаем номер программы в сертификате.
						Прог = СокрЛП(Прав(Стр, СтрДлина(Стр)-5));
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
	// Сохраняем сертификаты в обработке.
	СМ_СметнаяПодсистема_Сертификаты	= СметнаяКомпонента.ДобавитьСертификат(ИдСерт, Прог, ТекстСерт, СМ_СметнаяПодсистема_Сертификаты);
	// Сохраняем сертификаты в сметной компоненте.
    СметнаяКомпонента.Sertificates = СМ_СметнаяПодсистема_Сертификаты;
	
	ЗаписатьДанные();
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Сертификат добавлен'"));

КонецПроцедуры

// Процедура осуществляет удаление сертификатов (на доступ к СНБ) из базы после диалога пользователя.
// ПАРАМЕТРЫ:
// // Результат - ответ пользователя на вопрос (продолжать или нет)
// // СтруктураПараметров - дополнительные параметры переданные при формировании вопроса пользователю.
&НаКлиенте
Процедура УдалитьСертификатОтвет(Результат, СтруктураПараметров) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	// Очищаем сертификат.
	СМ_СметнаяПодсистема_Сертификаты	= "";
    СметнаяКомпонента.Sertificates = "";
	
	ЗаписатьДанные();
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Сертификаты удалены'"));

КонецПроцедуры

