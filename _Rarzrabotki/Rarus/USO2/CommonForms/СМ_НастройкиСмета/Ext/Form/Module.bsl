
#Область ОбработчикиСобытий

&НаКлиенте
Функция ПолучитьПуть(РежимДиалога)
	
	Режим 				= РежимДиалога;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	Если Режим = РежимДиалогаВыбораФайла.ВыборКаталога Тогда
		ДиалогОткрытияФайла.Заголовок= НСтр("ru = 'Выберите каталог'");
	Иначе
		ДиалогОткрытияФайла.Заголовок= НСтр("ru = 'Выберите файл'");
	КонецЕсли;	
	
	// Синхронный вызов
	//Если ДиалогОткрытияФайла.Выбрать() Тогда
	//	Если РежимДиалога = РежимДиалогаВыбораФайла.ВыборКаталога Тогда
	//		Возврат ДиалогОткрытияФайла.Каталог;
	//	Иначе
	//		Возврат ДиалогОткрытияФайла.ПолноеИмяФайла;
	//	КонецЕсли;
	//КонецЕсли;
	
	// Замена на асинхронный вызов
	ВыбранныйПуть = "";
	ОповещениеВыбора = Новый ОписаниеОповещения("ВыполнитьПослеВыбораФайла", ЭтотОбъект, ВыбранныйПуть);
	ДиалогОткрытияФайла.Показать(ОповещениеВыбора);
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПослеВыбораФайла(ВыбранныеФайлы, ВыбранныйПуть) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		Для Каждого ТекЭлемент Из ВыбранныеФайлы Цикл
			ВыбранныйПуть = ТекЭлемент;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // 
//  Обработчики событий формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//  Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьПроверкуПравДоступа("СохранениеДанныхПользователя", Метаданные);
	
	// Пользователи
	АвторизованныйПользователь = Пользователи.АвторизованныйПользователь();
	// Конец Пользователи
	
	МетодикаТСН 				 = ПолучитьФункциональнуюОпцию("СМ_МетодикаТСНГородаМосква");
	Элементы.РасчетТСН.Видимость = МетодикаТСН;

	Если Пользователи.РолиДоступны("СМ_АдминистраторСмета, АдминистраторСистемы, ПолныеПрава") Тогда
		Элементы.СМ_МетодикаТСН.Доступность = СМ_СметаВызовСервера.РФРегионыПользователей();
	Иначе
		Элементы.СМ_МетодикаТСН.Доступность = Ложь;
	КонецЕсли;
	
	// ************************************
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Пользователи.Ссылка КАК Пользователь,
	|	1 КАК Порядок
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи		
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Все пользователи"",
	|	0";	
	
	ВыборкаПользователи = Запрос.Выполнить().Выбрать();
	Элементы.ВыбранныйПользователь.СписокВыбора.Очистить();
	Пока ВыборкаПользователи.Следующий() Цикл
		Элементы.ВыбранныйПользователь.СписокВыбора.Добавить(ВыборкаПользователи.Пользователь);			
	КонецЦикла;
	
	НеПоказыватьЮзеров 		= (Константы.СМ_БазоваяВерсия.Получить() ИЛИ ВыборкаПользователи.Количество()<=2);
	ВыбранныйПользователь 	= Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	ПолучитьНастройки(Пользователи.ТекущийПользователь());
	УстановитьПривилегированныйРежим(Ложь);

	// ************************************

	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ
	|	СметноНормативныеБазы.Код
	|ИЗ
	|	Справочник.СМ_СметноНормативныеБазы КАК СметноНормативныеБазы";  	
	СписокСНБ.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Код"));
	
	Если (РольДоступна(Метаданные.Роли.СМ_АдминистраторСмета) или 
		  РольДоступна(Метаданные.Роли.ПолныеПрава)) И Не НеПоказыватьЮзеров Тогда
		Элементы.ЗаписатьИЗакрыть.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Элементы.Записать.Видимость 				= Ложь;	
	Элементы.ГруппаПользователи.Видимость 		= Ложь;
	Элементы.ВыбранныйПользователь.Видимость 	= Ложь;
	
	СписокНастроек = СМ_СметаВызовСервера.ПолучитьСписокНастроек();
	Для Каждого КлючИЗначение из СписокНастроек Цикл
		ЭтаФорма[КлючИЗначение.Значение.ПолеФормы] = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"НастройкиПользователяСмета",
		КлючИЗначение.Ключ,
		КлючИЗначение.Значение.ЗначениеПоУмолчанию);
	КонецЦикла;
	
КонецПроцедуры 

// // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // 
//  Прочие обработчики

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	ЗаписатьДанные();	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьДанные()
	
	МассивСтруктур	= Новый Массив;
	СписокНастроек	= СМ_СметаВызовСервера.ПолучитьСписокНастроек();
	
	Для каждого КлючИЗначение из СписокНастроек Цикл
		
		МассивСтруктур.Добавить(ОписаниеНастройки(
			"НастройкиПользователяСмета",
			КлючИЗначение.Ключ,
			ЭтаФорма[КлючИЗначение.Значение.ПолеФормы]));

	КонецЦикла;

	Если СметнаяКомпонента <> Неопределено Тогда
		СметнаяКомпонента.TexPartDirectory = СМ_СметнаяПодсистема_ДиректорияТехЧастей;
		СметнаяКомпонента.ConnectionType = СМ_СметнаяПодсистема_ВариантУстановки;
		Если СМ_ВерсияКомпоненты > 1 Тогда
			СметнаяКомпонента.ServiceAddress = "net.tcp://"+СМ_СметнаяПодсистема_АдресСлужбы+":5001/Norms";
		КонецЕсли;
		СметнаяКомпонента.NormDirectory = СМ_СметнаяПодсистема_ДиректорияНорм;
		СметнаяКомпонента.WriteToLog = СМ_СметнаяПодсистема_ЗаписьВЖурнал;
		Попытка
			СметнаяКомпонента.Sertificates = СМ_СметнаяПодсистема_Сертификаты;
		Исключение
			Событие = НСтр("ru = 'Исключение Настройки (смета)'");
			СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
		КонецПопытки;
	КонецЕсли;
		
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранитьМассивИОбновитьПовторноИспользуемыеЗначения(МассивСтруктур);
	
КонецПроцедуры

&НаКлиенте
Функция ОписаниеНастройки(Объект, Настойка, Значение)
	
	Элемент = Новый Структура;
	Элемент.Вставить("Объект", Объект);
	Элемент.Вставить("Настройка", Настойка);
	Элемент.Вставить("Значение", Значение);
	
	Возврат Элемент;
	
КонецФункции

&НаКлиенте
Процедура СведенияОПользователе(Команда)
	
	ПоказатьЗначение(,АвторизованныйПользователь);
	
КонецПроцедуры

&НаКлиенте
Процедура СМ_СметнаяПодсистема_ДиректорияНормНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = ЛОЖЬ;   
	СМ_СметаКлиент.сфВыборКаталога(СМ_СметнаяПодсистема_ДиректорияНорм);
	
КонецПроцедуры

&НаКлиенте
Процедура СМ_СметнаяПодсистема_ДиректорияТехЧастейНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = ЛОЖЬ;   
	СМ_СметаКлиент.сфВыборКаталога(СМ_СметнаяПодсистема_ДиректорияТехЧастей);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЭлементовНастройкиВНБ()
	
	СтараяВерсия = (СМ_ВариантВНБ = 1);
	Элементы.СМ_СметнаяПодсистема_ДиректорияНорм.ТолькоПросмотр = Не СтараяВерсия;
	Элементы.СМ_СметнаяПодсистема_ДиректорияТехЧастей.ТолькоПросмотр = Не СтараяВерсия;
	Элементы.СМ_СметнаяПодсистема_ВариантУстановки.ТолькоПросмотр = Не СтараяВерсия;
	Элементы.СМ_СметнаяПодсистема_ЗаписьВЖурнал.ТолькоПросмотр = Не СтараяВерсия;
	Элементы.СМ_НадписьСведенияОВерсии.Видимость = Не СтараяВерсия;
	Элементы.СМ_СметнаяПодсистема_АдресСлужбы.Видимость = Не СтараяВерсия;
	Элементы.СвойстваВерсия1.Видимость = СтараяВерсия;
	Элементы.СвойстваВерсия2.Видимость = Не СтараяВерсия;
	
	Элементы.ПолучитьИдентификатор.Доступность = Истина;
	Элементы.СтраницаСертификатыВНБ.Доступность = ЗначениеЗаполнено(СМ_ИДКлюча);
	Элементы.ЗаписатьИД.Доступность = ЗначениеЗаполнено(СМ_ИДКлюча);
	Элементы.ЗаписатьСертификат.Доступность = ЗначениеЗаполнено(СМ_ИДКлюча);
	Элементы.ПрочитатьСертификат.Доступность = Истина;
	Элементы.УдалитьСертификат.Доступность = ЗначениеЗаполнено(СМ_ИДКлюча);
	
	Если СтараяВерсия Тогда
		Если ЗначениеЗаполнено(СМ_ИДКлюча) Тогда
			Элементы.ПрочитатьСертификат.Заголовок = НСтр("ru='Прочитать сертификат'");
			Элементы.НадписьСсылка.Заголовок = НСтр("ru='Вы можете перейти к установке нормативной базы'");
		Иначе
			Элементы.ПрочитатьСертификат.Заголовок = НСтр("ru='Показать демо сертификат'");
			Элементы.НадписьСсылка.Заголовок = НСтр("ru='Вы можете провести установку демо базы'");
		КонецЕсли;
	Иначе
		Элементы.НадписьСсылка.Видимость = Ложь;
		Элементы.НадписьСсылка.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если СметнаяКомпонента = Неопределено Тогда
   		Элементы.Группа.ПодчиненныеЭлементы.ВнешняяНормативнаяБаза.Доступность = Ложь;
		Элементы.Группа.ПодчиненныеЭлементы.ВнешняяНормативнаяБаза.Видимость = Ложь;
	КонецЕсли;
	
	Попытка
		СМ_ВариантВНБ = Число(СметнаяКомпонента.Version);
	Исключение
		СМ_ВариантВНБ = 1;
	КонецПопытки;
	
	Если Параметры.ДляВнешнейБазы Тогда
		Элементы.Группа.ТекущаяСтраница = Элементы.Группа.ПодчиненныеЭлементы.ВнешняяНормативнаяБаза;	
	КонецЕсли;
	
	// Если у пользователя есть роль администратора, то покажем ему загруженный сертификат в зашифрованном виде.
	// Получаем идентификатор ключа защиты.
	Попытка
		СМ_ИДКлюча = СметнаяКомпонента.ПолучитьИдентификаторКлюча();
	Исключение
		СМ_ИДКлюча = "";
	КонецПопытки;
	
	УстановитьДоступностьЭлементовНастройкиВНБ();
    УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимость()
	
	Элементы.СМ_ЗапретитьПроведениеАктаПревышениеЛимитаСметы.Видимость = СМ_КонтролироватьОстатокПоАкту;
	Если СМ_ОкруглятьИтоговуюСтоимостьДоРублей = Истина Тогда
		Элементы.СМ_НеОкруглятьНДС.Доступность = Истина;
	Иначе
		СМ_НеОкруглятьНДС = Истина;
		Элементы.СМ_НеОкруглятьНДС.Доступность = Ложь;
	КонецЕсли;	
	
	// Установить видимость / доступность страницы "ВнешняяНормативнаяБаза"
	ОпцияИспользоватьВНБ 		= СМ_СметаВызовСервера.ПроверитьИспользованиеВНБ();
	Если ОпцияИспользоватьВНБ И ЭтаФорма.СМ_ИспользоватьВНБ Тогда
		Элементы.Группа.ПодчиненныеЭлементы.ВнешняяНормативнаяБаза.Доступность 	= Истина;
		Элементы.Группа.ПодчиненныеЭлементы.ВнешняяНормативнаяБаза.Видимость 	= Истина;
	Иначе	
	   	Элементы.Группа.ПодчиненныеЭлементы.ВнешняяНормативнаяБаза.Доступность 	= Ложь;
		Элементы.Группа.ПодчиненныеЭлементы.ВнешняяНормативнаяБаза.Видимость 	= Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СМ_СметнаяПодсистема_ДиректорияНормПриИзменении(Элемент)
	Если СметнаяКомпонента <> Неопределено Тогда
		СметнаяКомпонента.NormDirectory = СМ_СметнаяПодсистема_ДиректорияНорм;
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура СМ_СметнаяПодсистема_ДиректорияТехЧастейПриИзменении(Элемент)
	Если СметнаяКомпонента <> Неопределено Тогда
		СметнаяКомпонента.TexPartDirectory = СМ_СметнаяПодсистема_ДиректорияТехЧастей;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СМ_СметнаяПодсистема_ВариантУстановкиПриИзменении(Элемент)
	Если СметнаяКомпонента <> Неопределено Тогда
		СметнаяКомпонента.ТипПодключения = СМ_СметнаяПодсистема_ВариантУстановки;
	КонецЕсли;
КонецПроцедуры                          

&НаКлиенте
Процедура СМ_СметнаяПодсистема_ЗаписьВЖурналПриИзменении(Элемент)
	Если СметнаяКомпонента <> Неопределено Тогда
		СметнаяКомпонента.WriteToLog = СМ_СметнаяПодсистема_ЗаписьВЖурнал;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СМ_СметнаяПодсистема_АдресСлужбыПриИзменении(Элемент)
	Если СметнаяКомпонента <> Неопределено Тогда
		Если СМ_ВерсияКомпоненты > 1 Тогда
			СметнаяКомпонента.ServiceAddress = "net.tcp://"+СМ_СметнаяПодсистема_АдресСлужбы+?(СтрНайти(СМ_СметнаяПодсистема_АдресСлужбы, ":")>0,"",":5001")+"/Norms";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВыбранныйПользовательПриИзменении(Элемент)
	
	ПолучитьНастройки(ЭтаФорма.ВыбранныйПользователь);

КонецПроцедуры

&НаКлиенте
Процедура СМ_ПутьКПлагинуРенгаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ВыбранныйПуть = ПолучитьПуть(РежимДиалогаВыбораФайла.ВыборКаталога);
	Если Не ПустаяСтрока(ВыбранныйПуть) Тогда 		
		СМ_ПутьКПлагинуРенга = ВыбранныйПуть + ?(Прав(ВыбранныйПуть,1) = "\", "", "\");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СМ_ПутьКПлагинуРенгаПриИзменении(Элемент)
	СМ_ПутьКПлагинуРенга = СМ_ПутьКПлагинуРенга + ?(Прав(СМ_ПутьКПлагинуРенга,1) = "\", "", "\")
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура возращает значение текстового узда XML, следующего за текущим.
&НаСервере
Функция ПолучитьЗначениеТекстаXML(ЧтениеXML)
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			Возврат ЧтениеXML.Значение;
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

//  Получает наименование организации, которым будет заполняться поле заявки для
//  формирования сертификата.
// 
//  Параметры:
//   нет
// 
//  Возвращаемое значение:
//   Строка с именем организации.
// 
&НаСервере
Функция ПолучитьНаименованиеОрганизации()
	
	// Если организация в справочнике одна - возьмем ее имя.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Организации.Наименование
	|ИЗ
	|	Справочник.Организации КАК Организации";
	Результат = "";	
	тзРезультат = Запрос.Выполнить().Выгрузить();
	Если тзРезультат.Количество() = 1 Тогда
		Результат = тзРезультат[0].Наименование;
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПолучитьИдентификатор(Команда)
	Если СметнаяКомпонента <> Неопределено Тогда
		СМ_ИДКлюча = СметнаяКомпонента.ПолучитьИдентификаторКлюча();
		УстановитьДоступностьЭлементовНастройкиВНБ();
	КонецЕсли;
КонецПроцедуры

//  Команда "Записать ИД ключа в файл". Считывает идентификатор ключа 
//  сметной компоненты и сохраняет его в файл вместе с информацией об 
//  организации.
// 
&НаКлиенте
Процедура ЗаписатьИД(Команда)
	
	Если СметнаяКомпонента = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	// Если ИД еще не прочитан, считываем его.
	Если СМ_ИДКлюча = "" Тогда
		СМ_ИДКлюча = СметнаяКомпонента.ПолучитьИдентификаторКлюча();
		УстановитьДоступностьЭлементовНастройкиВНБ();
	КонецЕсли;
	
	// Подготовим структуру, чтобы передать ее в функцию выбора файла.
	ПутьКФайлу = "";	
	// Если ИД найден, то предложим сохранить в файл.
	Если СМ_ИДКлюча <> "" Тогда
		// Выбираем файл, результат будет в поле структуры.
		СМ_СметаКлиент.сфВыборФайла(ПутьКФайлу, "ini", "Key4Sert", Ложь, Истина);
		// Создаем документ и заполняем необходимые поля.
		Текст = Новый ТекстовыйДокумент();
		Текст.ДобавитьСтроку("[SMETA PLUS]");		
		Текст.ДобавитьСтроку("COMPANY="+ПолучитьНаименованиеОрганизации());
		Текст.ДобавитьСтроку("NUMBER=");
		Текст.ДобавитьСтроку("HASP="+СМ_ИДКлюча);
		// Записываем документ.
		// Синхронный вызов
		//Текст.Записать(ПутьКФайлу, КодировкаТекста.ANSI);
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Идентификатор ключа сохранен в файл'"));
		
		// Замена на асинхронный вызов
		ОповещениеЗаписиФайла = Новый ОписаниеОповещения("ВыполнитьПослеЗаписиФайла", ЭтаФорма);
		Текст.НачатьЗапись(ОповещениеЗаписиФайла,ПутьКФайлу,КодировкаТекста.ANSI); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеЗаписиФайла(Результат,ДополнительныеПараметры) Экспорт
	
	Если Результат Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Идентификатор ключа сохранен в файл'"));
	КонецЕсли;
	
КонецПроцедуры

//  Команда "Записать Сертификат". Считывает параметры файла сертификата 
//  и устанавливает новый сертификат в базе и в сметной компоненте.
// 
&НаКлиенте
Процедура ЗаписатьСертификат(Команда)
	
	Если СметнаяКомпонента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Если ИД еще не прочитан, считываем его.
	Если СМ_ИДКлюча = "" Тогда
		СМ_ИДКлючаа = СметнаяКомпонента.ПолучитьИдентификаторКлюча();
		УстановитьДоступностьЭлементовНастройкиВНБ();
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаписатьСертификатОтвет", ЭтаФорма, Новый Структура);
	ПоказатьВопрос(ОписаниеОповещения, НСтр("ru='Данные будут записаны. Продолжить?'"), РежимДиалогаВопрос.ДаНет,0,,"Внимание");
	
КонецПроцедуры
	
//  Команда "Прочитать сертфиикат". Считывает установленный в сметной компоненте 
//  сертификат и выводит его в форме дерева.
// 
&НаКлиенте
Процедура ПрочитатьСертификат(Команда)
	
	Если СметнаяКомпонента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем XML текст с описанием сертификата.
	ТекстХМЛ = СметнаяКомпонента.ПолучитьОписаниеСертификата();
	
	ОбновитьДерево(ТекстХМЛ);
	// Разворачиваем дерево.
	РазвернутьДерево(ДеревоСертификатов.ПолучитьЭлементы(), "ДеревоСертификатов");
	
	// Перейдем на закладку с сертификатами.
	Элементы.ГруппаСтраницыВНБ.ТекущаяСтраница = Элементы.СтраницаСертификатыВНБ;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокиДерева(Строки, КодОтец, тзДерево)
	
	Отбор = Новый Структура();
	Отбор.Вставить("Отец", КодОтец);
	
	Массив = тзДерево.НайтиСтроки(Отбор);
	
	Для Каждого Строка Из Массив Цикл
		СтрокаДЗ = Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДЗ, Строка);
		ЗаполнитьСтрокиДерева(СтрокаДЗ.Строки, Строка.ИД, тзДерево);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДерево(ТекстХМЛ)
	
	Дерево = РеквизитФормыВЗначение("ДеревоСертификатов");
	Дерево.Строки.Очистить();
	
	Если ЗначениеЗаполнено(ТекстХМЛ) Тогда
		
		// Если текст получен - будем считывать его.
		ЧтениеХМЛ = Новый ЧтениеXML();
		ЧтениеХМЛ.УстановитьСтроку(ТекстХМЛ);
		
		// Создаем таблицу под описание.
		// Тег  <descr> содержит атрибуты:
		// Code - двусимвольный код нормативной базы
		// Id - Уникальный идентификатор строки
		// Idfather - Уникальный идентификатор строки-родителя
		// Name - Наименование строки
		// Number - Количество доступных рабочих мест.   
		тзДерево = Новый ТаблицаЗначений();
		тзДерево.Колонки.Добавить("КодБазы");
		тзДерево.Колонки.Добавить("ИД");
		тзДерево.Колонки.Добавить("Отец");
		тзДерево.Колонки.Добавить("Наименование");
		тзДерево.Колонки.Добавить("КоличествоМест");
		тзДерево.Колонки.Добавить("СНБ");
		
		ИД = "-1";
		КоличествоМест = "0";
		
		// Считываем текст.
		Пока ЧтениеХМЛ.Прочитать() Цикл		
			
			Имя = НРег(ЧтениеХМЛ.Имя);
			
			Если (Имя = "certdescrdto") И (ЧтениеХМЛ.ТипУзла = ТипУзлаXML.НачалоЭлемента) Тогда
			ИначеЕсли (Имя = "haspid") И (ЧтениеХМЛ.ТипУзла = ТипУзлаXML.НачалоЭлемента) Тогда
				ИД = ПолучитьЗначениеТекстаXML(ЧтениеХМЛ);
				ИД = ?(ИД = "-1", НСтр("ru='не уст'"), ИД);
			ИначеЕсли (Имя = "loginsaccessible") И (ЧтениеХМЛ.ТипУзла = ТипУзлаXML.НачалоЭлемента) Тогда	
				КоличествоМест = ПолучитьЗначениеТекстаXML(ЧтениеХМЛ);
			ИначеЕсли (Имя = "dbdescription") И (ЧтениеХМЛ.ТипУзла = ТипУзлаXML.НачалоЭлемента) Тогда	
				стрДерево = тзДерево.Добавить();		
			    стрДерево.Наименование = ЧтениеХМЛ.ПолучитьАтрибут("Description");
				стрДерево.Отец = 0;	 		
				стрДерево.ИД = ИД;
				стрДерево.КоличествоМест = КоличествоМест;
			ИначеЕсли (Имя = "region") И (ЧтениеХМЛ.ТипУзла = ТипУзлаXML.НачалоЭлемента) Тогда	
				стрДерево.КодБазы = ПолучитьЗначениеТекстаXML(ЧтениеХМЛ);	
				ЭлБаза = Справочники.СМ_СметноНормативныеБазы.НайтиПоКоду(стрДерево.КодБазы);
				Если ЗначениеЗаполнено(ЭлБаза) Тогда
					стрДерево.СНБ = ЭлБаза;	
				Иначе
					стрДерево.СНБ = стрДерево.КодБазы;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ЗаполнитьСтрокиДерева(Дерево.Строки, 0, тзДерево);
		
		
		// Дерево готово, надо построить его на форме.
		ЗначениеВРеквизитФормы(Дерево, "ДеревоСертификатов");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДерево(Дерево,Имя)
	Для каждого СтрокаДанных Из Дерево Цикл
		ИдентификаторСтроки = СтрокаДанных.ПолучитьИдентификатор();
		Если ИдентификаторСтроки <> Неопределено Тогда 
			Элементы[Имя].Развернуть(ИдентификаторСтроки);
		КонецЕсли;
		РазвернутьДерево(СтрокаДанных.ПолучитьЭлементы(),Имя);		
	КонецЦикла;
КонецПроцедуры

//  Команда "Удалить сертификат". Удаляет сертификат, установленный в 
//  сметной компоненте и в обработке.
