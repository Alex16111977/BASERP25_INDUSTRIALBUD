&НаСервере
Процедура ПолучитьНастройки(ПользовательНастройки)
	
	Если ПользовательНастройки = НСтр("ru='Все пользователи'") Тогда
		ИмяПользователя = ПользовательНастройки;
	Иначе
		СвойстваПользователя = Пользователи.НовоеОписаниеПользователяИБ();	
		Пользователи.ПрочитатьПользователяИБ(ПользовательНастройки.ИдентификаторПользователяИБ, СвойстваПользователя);
		ИмяПользователя = СвойстваПользователя.Имя;
	КонецЕсли;
	
	СписокНастроек	= СМ_СметаВызовСервера.ПолучитьСписокНастроек();
	
	Для каждого КлючИЗначение из СписокНастроек Цикл
		
		ЭтаФорма[КлючИЗначение.Значение.ПолеФормы] = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета",
			КлючИЗначение.Ключ,
			КлючИЗначение.Значение.ЗначениеПоУмолчанию,,ИмяПользователя);
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СметноНормативныеБазы.Код
	               |ИЗ
	               |	Справочник.СМ_СметноНормативныеБазы КАК СметноНормативныеБазы";  	
	СписокСНБ.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Код"));
	
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	
	//ЗаписьНастроек(Элементы.СписокПользователей.ТекущиеДанные.Пользователь); 
	//Если СметнаяКомпонента <> Неопределено И 
	//	(АвторизованныйПользователь = Элементы.СписокПользователей.ТекущиеДанные.Пользователь ИЛИ
	//	Элементы.СписокПользователей.ТекущиеДанные.Пользователь = НСтр("ru='Все пользователи'")) Тогда
	
	ЗаписьНастроек(ЭтаФорма.ВыбранныйПользователь);
	
	Если СметнаяКомпонента <> Неопределено И 
		 (АвторизованныйПользователь = ЭтаФорма.ВыбранныйПользователь ИЛИ 
	     ЭтаФорма.ВыбранныйПользователь = НСтр("ru='Все пользователи'")) Тогда
		 
		СметнаяКомпонента.TexPartDirectory = СМ_СметнаяПодсистема_ДиректорияТехЧастей;
		СметнаяКомпонента.ConnectionType = СМ_СметнаяПодсистема_ВариантУстановки;
		
		Если СМ_ВерсияКомпоненты > 1 Тогда
			СметнаяКомпонента.ServiceAddress = "net.tcp://"+СМ_СметнаяПодсистема_АдресСлужбы+":5001/Norms";
		КонецЕсли;
		
		СметнаяКомпонента.NormDirectory = СМ_СметнаяПодсистема_ДиректорияНорм;
		СметнаяКомпонента.WriteToLog = СМ_СметнаяПодсистема_ЗаписьВЖурнал;
		
		Попытка
			СметнаяКомпонента.Sertificates = СМ_СметнаяПодсистема_Сертификаты;
		Исключение
		КонецПопытки;
		
	КонецЕсли;

 КонецПроцедуры

&НаСервере
Процедура ЗаписьНастроек(ПользовательНастройки)
	
	Если ПользовательНастройки = НСтр("ru='Все пользователи'") Тогда
		ВыборкаПользователи = Справочники.Пользователи.Выбрать();
		Пока ВыборкаПользователи.Следующий() Цикл
			Если ВыборкаПользователи.ЭтоГруппа Тогда
				Продолжить;
			КонецЕсли;
			ЗаписатьНастройки(ВыборкаПользователи.ИдентификаторПользователяИБ);
		КонецЦикла;
	Иначе
		ЗаписатьНастройки(ПользовательНастройки.ИдентификаторПользователяИБ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройки(ИмяПользователя)
	
	УстановитьПривилегированныйРежим(Истина);
	СписокНастроек		= СМ_СметаВызовСервера.ПолучитьСписокНастроек();
	
	СвойстваПользователя = Пользователи.НовоеОписаниеПользователяИБ();	
	Пользователи.ПрочитатьПользователяИБ(ИмяПользователя, СвойстваПользователя);
	
	Для каждого КлючИЗначение из СписокНастроек Цикл
		
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("НастройкиПользователяСмета",
			КлючИЗначение.Ключ,
			ЭтаФорма[КлючИЗначение.Значение.ПолеФормы],,СвойстваПользователя.Имя,Истина);
			
	КонецЦикла;
		
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры

&НаКлиенте
Процедура КнопкаНастройкаДопРеквизитов(Команда)
	Если Не СМ_ВыводитьДополнительныеРеквизитыДерево Тогда
		Возврат;
	КонецЕсли;
	ПараметрыОткрытия	= Новый Структура();
	ПараметрыОткрытия.Вставить("СписокВыбора", ПолучитьСписокРеквизитовНаСервере());
	ПараметрыОткрытия.Вставить("МестоВызова","НАСТРОЙКИ");
	
	ОписаниеОповещения	= Новый ОписаниеОповещения("ОтобраныРеквизитыНаКлиенте", ЭтотОбъект);
	
	ОткрытьФорму("ОбщаяФорма.СМ_ВыборИзСписка", ПараметрыОткрытия, ЭтотОбъект,,,, ОписаниеОповещения);

КонецПроцедуры

&НаСервере
Функция ПолучитьСписокРеквизитовНаСервере()
	
	//
	СписокВыбора	= Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДополнительныеРеквизитыИСведения.Ссылка
	               |ИЗ
	               |	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	               |ГДЕ
	               |	НЕ ДополнительныеРеквизитыИСведения.ЭтоДополнительноеСведение
	               |	И НЕ ДополнительныеРеквизитыИСведения.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Пометка = Истина;
		Если СМ_СписокДопРеквизитовДерева.НайтиПоЗначению(Выборка.Ссылка) = Неопределено Тогда
			Пометка = Ложь;
		КонецЕсли;
		СписокВыбора.Добавить(Выборка.Ссылка,Выборка.Ссылка.Наименование,Пометка);
	КонецЦикла;
	Возврат СписокВыбора;
		
КонецФункции //Функция ПолучитьСписокВыбораНРиСПНаСервере()

&НаКлиенте
Процедура ОтобраныРеквизитыНаКлиенте(МассивВыбора, ДополнительныеПараметры = Неопределено) Экспорт
	
	//
	Если МассивВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СМ_СписокДопРеквизитовДерева.ЗагрузитьЗначения(МассивВыбора);
	
КонецПроцедуры //Процедура ОтобраныОбрабатываемыеЭлементыНаКлиенте(ПараметрыКоманды)

