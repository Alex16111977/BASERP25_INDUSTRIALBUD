&НаКлиенте
Процедура НастройкаХраненияИстории(Команда)
	
	// Создание структуры значений
	СтруктураФормы = Новый Структура;
	СтруктураФормы.Вставить("ТипОбъекта",	"СМЕТА");

	// Почему-то нужно создавать запись через массив (по другому не взлетало)
	МассивКлюча = Новый Массив;
	МассивКлюча.Добавить(СтруктураФормы);
	
	// Создание ключа записи регистра сведений
	КлючЗаписи = Новый ("РегистрСведенийКлючЗаписи.СМ_НастройкиВерсионированияОбъектов", МассивКлюча);
	
	// Структура ключа записи для поиска при открытии
	СтруктураКлюча = Новый Структура;
	СтруктураКлюча.Вставить("Ключ", КлючЗаписи);
	
	// Если запись не будет найдена, вызовем заполнение измерений.
	СтруктураЗаполнения = Новый Структура;
	СтруктураЗаполнения.Вставить("ЗначенияЗаполнения", СтруктураФормы);
	
	Попытка
		// Попытка открытия формы записи
		ОткрытьФорму("РегистрСведений.СМ_НастройкиВерсионированияОбъектов.Форма.НастройкаХранения", СтруктураКлюча, ЭтаФорма);
	Исключение
		// В исключение ушло если запись не найдена.
		ОписаниеОшибки = ОписаниеОшибки();
		Если Найти(ОписаниеОшибки, "Объект не найден") Тогда
			// Запись не найдена. Откроем форму и заполнением по структуре.
			ОткрытьФорму("РегистрСведений.СМ_НастройкиВерсионированияОбъектов.Форма.НастройкаХранения", СтруктураЗаполнения, ЭтаФорма);
		КонецЕсли;
	КонецПопытки;   
КонецПроцедуры

&НаКлиенте
Процедура СМ_РазрешитьРедактированиеЗакрытыхСметПриИзменении(Элемент)
	КонстантаДоИзменения = ПолучитьКонстанту("СМ_РазрешитьРедактированиеЗакрытыхСмет"); 
	Если Не КонстантаДоИзменения Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаЗакрытыхСмет", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Данная опция может привести к расхождению между плановыми и фактическими показателями. Вы точно хотите включить возможность?';"
		+ " en = 'Do you want to continue?'"), Режим, 0);
	Иначе
		УстановитьКонстанту(СМ_РазрешитьРедактированиеЗакрытыхСмет,"СМ_РазрешитьРедактированиеЗакрытыхСмет");
	КонецЕсли;

КонецПроцедуры

