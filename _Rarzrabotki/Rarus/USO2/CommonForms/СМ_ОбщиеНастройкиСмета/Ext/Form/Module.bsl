
#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	//  Общие настройки расчета НР и СП	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_ПоправочныйКоэффициентСПТекущий) Тогда
		НаборКонстант.СМ_ПоправочныйКоэффициентСПТекущий = 0.8;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_ПоправочныйКоэффициентСПБазисный) Тогда
		НаборКонстант.СМ_ПоправочныйКоэффициентСПБазисный= 1;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_ПоправочныйКоэффициентНРТекущий) Тогда
		НаборКонстант.СМ_ПоправочныйКоэффициентНРТекущий = 0.85;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_ПоправочныйКоэффициентНРБазисный) Тогда
		НаборКонстант.СМ_ПоправочныйКоэффициентНРБазисный = 1;
	КонецЕсли;
	
	// Округление НР и СП.
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_ОкруглятьНормативыНРиСП) Тогда
		НаборКонстант.СМ_ОкруглятьНормативыНРиСП = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_ОкруглятьНормативыНРиСПбазис) Тогда
		НаборКонстант.СМ_ОкруглятьНормативыНРиСПбазис = Ложь;
	КонецЕсли;
	
	//  Параметры расчета НР и СП при определении стоимости ремонтных работ 
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_КоэффициентНРбазисныйРемонт) Тогда
		НаборКонстант.СМ_КоэффициентНРбазисныйРемонт = 0.9;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_КоэффициентСПбазисныйРемонт) Тогда
		НаборКонстант.СМ_КоэффициентСПбазисныйРемонт = 0.85; 
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_КоэффициентНРтекущийРемонт) Тогда
		НаборКонстант.СМ_КоэффициентНРтекущийРемонт = 0.9; 
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_КоэффициентСПтекущийРемонт) Тогда
		НаборКонстант.СМ_КоэффициентСПтекущийРемонт = 0.85; 
	КонецЕсли;
	
	//  Параметры расчета НР и СП при упрощенной системе налогообложения 
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_КоэффициентНРбазисныйУСН) Тогда
		НаборКонстант.СМ_КоэффициентНРбазисныйУСН = 0.7;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_КоэффициентСПбазисныйУСН) Тогда
		НаборКонстант.СМ_КоэффициентСПбазисныйУСН = 0.9;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_КоэффициентНРтекущийУСН) Тогда
		НаборКонстант.СМ_КоэффициентНРтекущийУСН = 0.94; 
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_КоэффициентСПтекущийУСН) Тогда
		НаборКонстант.СМ_КоэффициентСПтекущийУСН = 0.9; 
	КонецЕсли;
	
	//  Параметры расчета НР и СП при реконструкции и капитальном ремонте АЭС 
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_КоэффициентНРбазисныйАЭС) Тогда
		НаборКонстант.СМ_КоэффициентНРбазисныйАЭС = 1.2;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_КоэффициентСПбазисныйАЭС) Тогда
		НаборКонстант.СМ_КоэффициентСПбазисныйАЭС = 1;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_КоэффициентНРтекущийАЭС) Тогда
		НаборКонстант.СМ_КоэффициентНРтекущийАЭС = 1.2;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_КоэффициентСПтекущийАЭС) Тогда
		НаборКонстант.СМ_КоэффициентСПтекущийАЭС = 1;
	КонецЕсли;
	
	//  Расчет стоимости вспомогательных материалов для ресурсного метода
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_ПроцентДляТЕРм) Тогда
		НаборКонстант.СМ_ПроцентДляТЕРм = 2; 
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_ПроцентДляТЕРмр) Тогда
		НаборКонстант.СМ_ПроцентДляТЕРмр = 3;
	КонецЕсли;
	
	НайденныйРесурс = Справочники.СМ_Ресурсы.НайтиПоКоду("999-9950");
	Если НаборКонстант.СМ_ВспомогательныеМатериалы = Справочники.СМ_Ресурсы.ПустаяСсылка() Тогда
		НаборКонстант.СМ_ВспомогательныеМатериалы = НайденныйРесурс;
	КонецЕсли;

	//  Расчет затрат на уплату НДС при УСН

	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_УдВесМатерНР) Тогда
		НаборКонстант.СМ_УдВесМатерНР = 0.1712; 
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_УдВесМатерСП) Тогда
		НаборКонстант.СМ_УдВесМатерСП = 0.15; 
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_УдВесМатерНРКС) Тогда
		НаборКонстант.СМ_УдВесМатерНРКС = 0.182; 
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_НДСусн) Тогда
		НаборКонстант.СМ_НДСусн = 18; 
	КонецЕсли;
	
	// СЛК.
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_СерверСистемыЗащиты) Тогда
		НаборКонстант.СМ_СерверСистемыЗащиты = "Localhost"; 
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаборКонстант.СМ_ПортСистемыЗащиты) Тогда
		НаборКонстант.СМ_ПортСистемыЗащиты = 9099; 
	КонецЕсли;
	
	МетодикаМДС35					= ПолучитьФункциональнуюОпцию("СМ_МетодикаМДС35");
	МетодикаТСН 					= ПолучитьФункциональнуюОпцию("СМ_МетодикаТСНГородаМосква");
	Методика1984года 				= ПолучитьФункциональнуюОпцию("СМ_Методика84Года");

	Элементы.МетодикаТСН.Видимость 	= МетодикаТСН;
	Элементы.Группа1984.Видимость 	= Методика1984года;
	Элементы.ГруппаСЛК.Видимость 	= Не ПолучитьФункциональнуюОпцию("СМ_БазоваяВерсия");	 
	
	Если Методика1984года Тогда
		Выборка = РегистрыСведений.СМ_НаборКонстантпоМетодике1984.Получить();
		СтрокаПараметра = Параметры1984.Добавить();
		СтрокаПараметра.НакладныеРасходыРесурсные = Выборка.НакладныерасходыРесурсные; 	
		Если НЕ ЗначениеЗаполнено(СтрокаПараметра.НакладныеРасходыРесурсные) Тогда
			СтрокаПараметра.НакладныеРасходыРесурсные = 11.7;
		КонецЕсли;
		СтрокаПараметра.СметнаяПрибыльБазисноИндексная = Выборка.СметнаяПрибыльБазисноИндексная; 	
		Если НЕ ЗначениеЗаполнено(СтрокаПараметра.СметнаяПрибыльБазисноИндексная) Тогда
			СтрокаПараметра.СметнаяПрибыльБазисноИндексная = 8;
		КонецЕсли;
		СтрокаПараметра.СметнаяПрибыльРесурсная = Выборка.СметнаяПрибыльРесурсная; 	
		Если НЕ ЗначениеЗаполнено(СтрокаПараметра.СметнаяПрибыльРесурсная) Тогда
			СтрокаПараметра.СметнаяПрибыльРесурсная = 12;
		КонецЕсли;
		СтрокаПараметра.КоэффициентТРвНР = Выборка.КоэффициентТРвНР; 	
		Если НЕ ЗначениеЗаполнено(СтрокаПараметра.КоэффициентТРвНР) Тогда
			СтрокаПараметра.КоэффициентТРвНР = 0.092;
		КонецЕсли;
		СтрокаПараметра.КоэффициентОЗвНР = Выборка.КоэффициентОЗвНР; 	
		Если НЕ ЗначениеЗаполнено(СтрокаПараметра.КоэффициентОЗвНР) Тогда
			СтрокаПараметра.КоэффициентОЗвНР = 0.180;
		КонецЕсли;
		СтрокаПараметра.НРБазисныеОтФОТ = Выборка.НРБазисныеОтФОТ; 	
		Если НЕ ЗначениеЗаполнено(СтрокаПараметра.НРБазисныеОтФОТ) Тогда
			СтрокаПараметра.НРБазисныеОтФОТ = 80;
		КонецЕсли;
		СтрокаПараметра.НРТекущиеОтФОТ = Выборка.НРТекущиеОтФОТ; 	
		Если НЕ ЗначениеЗаполнено(СтрокаПараметра.НРТекущиеОтФОТ) Тогда
			СтрокаПараметра.НРТекущиеОтФОТ = 80;
		КонецЕсли;
		СтрокаПараметра.СПБазисныеОтФОТ = Выборка.СПБазисныеОтФОТ; 	
		Если НЕ ЗначениеЗаполнено(СтрокаПараметра.СПБазисныеОтФОТ) Тогда
			СтрокаПараметра.СПБазисныеОтФОТ = 50;
		КонецЕсли;
		СтрокаПараметра.СПТекущиеОтФОТ = Выборка.СПТекущиеОтФОТ; 	
		Если НЕ ЗначениеЗаполнено(СтрокаПараметра.СПТекущиеОтФОТ) Тогда
			СтрокаПараметра.СПТекущиеОтФОТ = 50;
		КонецЕсли;
		СтрокаПараметра.КоэффициентПереходаОтОЗкЗТРмонтажные = Выборка.КоэффициентПереходаОтОЗкЗТРмонтажные; 	
		Если НЕ ЗначениеЗаполнено(СтрокаПараметра.КоэффициентПереходаОтОЗкЗТРмонтажные) Тогда
			СтрокаПараметра.КоэффициентПереходаОтОЗкЗТРмонтажные = 1;
		КонецЕсли;
		СтрокаПараметра.КоэффициентПереходаОтОЗкЗТР = Выборка.КоэффициентПереходаОтОЗкЗТР; 	
		Если НЕ ЗначениеЗаполнено(СтрокаПараметра.КоэффициентПереходаОтОЗкЗТР) Тогда
			СтрокаПараметра.КоэффициентПереходаОтОЗкЗТР = 1;
		КонецЕсли;
		СтрокаПараметра.КоэффициентПереходаОтЗМкЗТМЗемляные = Выборка.КоэффициентПереходаОтЗМкЗТМЗемляные; 	
		Если НЕ ЗначениеЗаполнено(СтрокаПараметра.КоэффициентПереходаОтЗМкЗТМЗемляные) Тогда
			СтрокаПараметра.КоэффициентПереходаОтЗМкЗТМЗемляные = 1.44;
		КонецЕсли;
		СтрокаПараметра.КоэффициентПереходаОтЗМкЗТМ = Выборка.КоэффициентПереходаОтЗМкЗТМ; 	
		Если НЕ ЗначениеЗаполнено(СтрокаПараметра.КоэффициентПереходаОтЗМкЗТМ) Тогда
			СтрокаПараметра.КоэффициентПереходаОтЗМкЗТМ = 1.29;
		КонецЕсли;
	КонецЕсли;
	
	СМ_ИспользоватьСтатусыДокументов 					= Константы.СМ_ИспользоватьСтатусыДокументов.Получить();
	СМ_ИспользоватьЗаявкиСнабжения						= Константы.СМ_ИспользоватьЗаявкиСнабжения.Получить();
	СМ_MSP_ИспользоватьИнтеграциюMSP					= Константы.СМ_MSP_ИспользоватьИнтеграциюMSP.Получить();
	СМ_РазрешитьРедактированиеЗакрытыхСмет 				= Константы.СМ_РазрешитьРедактированиеЗакрытыхСмет.Получить();
	СМ_ИспользоватьЛимитированныеЗатратыПодчиненныхСмет = Константы.СМ_ИспользоватьЛимитированныеЗатратыПодчиненныхСмет.Получить();
	СМ_ИспользоватьРасчетСреднейСтоимости 				= Константы.СМ_ИспользоватьРасчетСреднейСтоимости.Получить();
	СМ_WS_ИспользоватьИнтеграцию						= Константы.СМ_WS_ИспользоватьИнтеграцию.Получить();
	СМ_ЗапртетитьВставкуПозицийРесурсов                 = Константы.СМ_ЗапртетитьВставкуПозицийРесурсов.Получить();
	
	Элементы.ОбработкаСМ_MSP_НастройкаСинхронизацииОткрыть.Доступность 	= СМ_MSP_ИспользоватьИнтеграциюMSP;
	Элементы.ОбработкаСМ_WS_ИнтеграцияВебСервисИнтеграцияБП.Доступность = СМ_WS_ИспользоватьИнтеграцию;

КонецПроцедуры 

#КонецОбласти

