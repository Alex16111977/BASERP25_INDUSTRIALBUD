&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ТекущийОбъект.СМ_ОтправлятьСведенияАРПС
		И ПланыОбмена.СМ_СервисАРПС.НайтиПоКоду("АРПС").Пустая() Тогда
		План = ПланыОбмена.СМ_СервисАРПС.СоздатьУзел();
		План.Код = "АРПС";
		План.Наименование = "АРПС";
		План.Записать();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Методика84года 	= НаборКонстант.СМ_Методика84года;
	МетодикаМДС35	= НаборКонстант.СМ_МетодикаТСНГородаМосква;
	МетодикаТСН		= НаборКонстант.СМ_МетодикаМДС35;

	Если НЕ Методика84года И НЕ МетодикаМДС35 И НЕ МетодикаТСН Тогда
	    Сообщение 		= Новый СообщениеПользователю();
	    Сообщение.Текст = "Не выбрана ни одна методика расчета";
	    Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
	ТЗ 		= РеквизитФормыВЗначение("Параметры1984", Тип("ТаблицаЗначений")); 
	Записи 	= РегистрыСведений.СМ_НаборКонстантпоМетодике1984.СоздатьНаборЗаписей();
	Записи.Очистить();
	Записи.Загрузить(ТЗ);
	Записи.Записать(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СМ_ИспользоватьСтатусыДокументовПриИзменении(Элемент)
	КонстантаДоИзменения = ПолучитьКонстанту("СМ_ИспользоватьСтатусыДокументов"); 
	ЕстьДокументы = ПроверитьДокументы();
	Если КонстантаДоИзменения И ЕстьДокументы Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Выключение параметра приведет к потере статусов у уже созданных документов. Продолжить?';"
		+ " en = 'Do you want to continue?'"), Режим, 0);
	Иначе
		УстановитьКонстанту(СМ_ИспользоватьСтатусыДокументов,"СМ_ИспользоватьСтатусыДокументов");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СМ_ИспользоватьЗаявкиСнабженияПриИзменении(Элемент)
	УстановитьКонстанту(СМ_ИспользоватьЗаявкиСнабжения,"СМ_ИспользоватьЗаявкиСнабжения");
КонецПроцедуры

&НаСервере
Функция ПолучитьКонстанту(ИмяКонстанты)
    Возврат Константы[ИмяКонстанты].Получить();
КонецФункции

&НаСервере
Функция ПроверитьДокументы()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СМ_ЛокальнаяСмета.Ссылка
	               |ИЗ
	               |	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
