
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//	ЗначенияЗаполнения
	СписокВыбора = Параметры.СписокВыбора.Скопировать();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	//
	ОтмеченныеЭлементы	= Новый Массив;
	
	//
	Если Параметры.МестоВызова = "НАСТРОЙКИ" Тогда
		сч = 0;
		Для Каждого ЭлементСпискаВыбора Из СписокВыбора Цикл
			Если ЭлементСпискаВыбора.Пометка Тогда
				ОтмеченныеЭлементы.Добавить(ЭлементСпискаВыбора.Значение);
				сч = сч+1;
			КонецЕсли;
		КонецЦикла;
		Если сч > 3 Тогда
			ПоказатьПредупреждение(,НСтр("ru = 'Нельзя выводить более 3-х реквизитов!'"), 10);
			Возврат;
		КонецЕсли;
	Иначе
		Для Каждого ЭлементСпискаВыбора Из СписокВыбора Цикл
			Если ЭлементСпискаВыбора.Пометка Тогда
				ОтмеченныеЭлементы.Добавить(ЭлементСпискаВыбора.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//
	ЭтаФорма.Закрыть(ОтмеченныеЭлементы);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометки(Команда)
	
	ОбработкаПометок(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Команда)
	
	ОбработкаПометок(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбработкаПометок(ТекПометка)
	
	Для Каждого ТекЭлемент Из ЭтаФорма.СписокВыбора Цикл
		ТекЭлемент.Пометка = ТекПометка;	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
