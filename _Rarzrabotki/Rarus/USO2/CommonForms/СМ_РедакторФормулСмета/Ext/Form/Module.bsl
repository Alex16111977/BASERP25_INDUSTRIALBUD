КонецПроцедуры

&НаКлиенте
Процедура КнопкаСкбЛевНажатие(Команда)
	
	Если СписокОператоров.НайтиПоЗначению(Прав(Формула,1)) = неопределено И НЕ Прав(Формула,1) = "(" И НЕ СтрДлина(Формула) = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Формула = Формула + " (";
	
	КолСкобок = КолСкобок + 1;
	
КонецПроцедуры

&НаКлиенте
Процедура КнопкаСкбПравНажатие(Команда)
	
	Если (НЕ ПродолжениеЧисла() И НЕ Прав(Формула,1) = ")") ИЛИ КолСкобок < 1 Тогда 
		Возврат;
	КонецЕсли;
	
	Формула = Формула + " )";
	КолСкобок = КолСкобок - 1;
	
КонецПроцедуры

&НаКлиенте
Процедура КнопкаПлюсНажатие(Команда)
		
	Если НЕ КорректностьВводаОператора() Тогда 
		Возврат;
	КонецЕсли;
	Формула = Формула + " +";

КонецПроцедуры

