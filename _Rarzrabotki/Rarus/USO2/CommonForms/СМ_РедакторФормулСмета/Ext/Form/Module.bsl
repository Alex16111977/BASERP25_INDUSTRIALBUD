#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВводПробела()	
	Если НЕ ПустаяСтрока(Формула) И НЕ ПродолжениеЧисла() Тогда	
		Формула = Формула + " ";	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Функция ПродолжениеЧисла()
	
	Продолжение = Ложь;
	Если НЕ СписокЧисел.НайтиПоЗначению(Прав(Формула,1)) = неопределено Тогда
		Продолжение = Истина;
	КонецЕсли;
	Возврат Продолжение

КонецФункции

&НаКлиенте
Функция КорректностьВводаОператора()
	
	Корректно = истина;	
	
	Если ПустаяСтрока(Формула) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='В формуле нет аргументов'"));
		Корректно = Ложь;	
	КонецЕсли;

	Если НЕ СписокОператоров.НайтиПоЗначению(Прав(Формула,1)) = Неопределено ИЛИ Прав(Формула,1)="(" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Нет аргумента'"));
		Корректно = Ложь;	
	КонецЕсли;
	
	Возврат Корректно;
	
КонецФункции

&НаКлиенте
Процедура ПолучитьИтогиПоГлавам(Результат, Структура) Экспорт
	ИтогиПоГлавам = Результат;
	Формула = Формула + ПолучитьИдентификатор(ИтогиПоГлавам);
КонецПроцедуры

&НаКлиенте
Процедура КнопкаОткрытьИтогиПоГлавам(Команда)	
	Оповещение = Новый ОписаниеОповещения("ПолучитьИтогиПоГлавам", ЭтотОбъект);
	ОткрытьФорму("Справочник.СМ_ИтогиПоГлавам.ФормаВыбора",,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьЛимитированныеЗатраты(Результат, Структура) Экспорт
	ЛимЗатрата = Результат;
	Формула = Формула + ПолучитьИдентификатор(ЛимЗатрата);
КонецПроцедуры

