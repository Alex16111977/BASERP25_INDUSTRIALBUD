
#Область ПрограммныйИнтерфейс

// Функция возвращает массив узлов плана обмена
//
// Возвращаемое значение:
//     Массив - содержит ссылки на узлы плана обмена.
//
Функция ПолучитьУзлы() Экспорт
	
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ
	|	СМ_WS_Обмен.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.СМ_WS_Обмен КАК СМ_WS_Обмен
	|ГДЕ
	|	СМ_WS_Обмен.Ссылка <> &ТекущийУзел И
	|	СМ_WS_Обмен.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ТекущийУзел", ПланыОбмена.СМ_WS_Обмен.ЭтотУзел());
	
	ТаблицаЗначений = Запрос.Выполнить().Выгрузить();
	МассивУзлов = ТаблицаЗначений.ВыгрузитьКолонку("Ссылка");
	
	Возврат МассивУзлов;
	
КонецФункции // ПолучитьУзлы()

// Делает запрос к веб-сервису и получает данные
//
// Параметры:
//    Данные 		 - Структура - содержит необходимые данные.
//	  АдресХранилища - Строка - адрес во временном хранилище.
//
Процедура ЗапроситьДанныеССервиса(Данные,АдресХранилища) Экспорт
	
	Попытка
		Определения = Новый WSОпределения("http://"+Данные.URL+"/ws/wsbp.1cws?wsdl", Данные.Логин, Данные.Пароль);
	Исключение
		АдресХранилища = ПоместитьВоВременноеХранилище(Новый Структура("Текст","Не удалось подключится к веб-сервису"), АдресХранилища);
		Возврат;
	КонецПопытки;
	Попытка
		Прокси = Новый WSПрокси(Определения, "BP_WS_DataIntegration", "BP_WS_DataIntegration", "BP_WS_DataIntegrationSoap");
		Прокси.Пользователь=Данные.Логин;
		Прокси.Пароль=Данные.Пароль;
	Исключение
		АдресХранилища = ПоместитьВоВременноеХранилище(Новый Структура("Текст","Не удалось подключится к веб-сервису"), АдресХранилища);
		Возврат;
	КонецПопытки;
	
	ПередачаНеЗавершена=Истина;
	
	СтДляПередачи=Новый Структура("ТипОбъекта,Код,НомерСообщения,СтартНм,СтартТип",Данные.ТипОбъекта,Данные.Узел.Код,0,"","");
	
	Пока ПередачаНеЗавершена Цикл
		
		ДляПередачи=Новый ХранилищеЗначения(СтДляПередачи);	
		Хранилище=Прокси.GetDataList(ДляПередачи);
		ДанныеХранилища=Хранилище.Получить();
		
		Если ДанныеХранилища.Таблица.Количество()=0 Тогда
			ПередачаНеЗавершена=Ложь;
			Прервать;
		КонецЕсли;	
		Для Каждого Эл Из ДанныеХранилища.Таблица Цикл
			СтДляПередачи.СтартНм=Эл.GUID;
			СтДляПередачи.СтартТип=Эл.ТипОбъекта;
			
			Запись=РегистрыСведений.СМ_WS_БуферЗагрузки.СоздатьМенеджерЗаписи();
			Запись.ИдентификаторБазы=Данные.ИдентификаторБазы;
			Запись.GUID=Эл.GUID;
			Запись.Пользователь=Данные.ТекущийПользователь;
			Запись.ТипОбъекта=Данные.ТипОбъекта;
			Запись.ПредставлениеОбъекта=Эл.Представление;
			Запись.ПредставлениеОбъекта1=Эл.ПредставлениеКод;
			Запись.ДанныеОбъекта=Эл.ДанныеОбъекта;
			Запись.Записать();
			
		КонецЦикла;
		
	КонецЦикла;
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Новый Структура("Текст","загрузка завершена"), АдресХранилища);	
	
КонецПроцедуры

#КонецОбласти




