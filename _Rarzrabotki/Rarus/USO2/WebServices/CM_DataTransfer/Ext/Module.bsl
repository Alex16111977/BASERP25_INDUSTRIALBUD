	//		ТипЗнч(Данные) = Тип("ДокументОбъект.СМ_ПозицияЛокальнойСметы") или ТипЗнч(Данные) = Тип("ДокументОбъект.СМ_РазделЛокальнойСметы") Тогда
	//        Данные.ОбменДанными.Отправитель = Отправитель;
