			Если не ОбъектОбмена.Подрядчик.Пустая() Тогда
				ЗаписатьXML(ЗаписьХМЛ,ОбъектОбмена.Подрядчик.получитьОбъект());
			КонецЕсли;
			Если не ОбъектОбмена.Стройка.Пустая() Тогда
				ЗаписатьXML(ЗаписьХМЛ,ОбъектОбмена.Стройка.получитьОбъект());
			КонецЕсли;
			Если не ОбъектОбмена.Договор.ВалютаВзаиморасчетов.Пустая() Тогда
				ЗаписатьXML(ЗаписьХМЛ,ОбъектОбмена.Договор.ВалютаВзаиморасчетов.получитьОбъект());
			КонецЕсли;
			Если не ОбъектОбмена.Договор.Пустая() Тогда
				ЗаписатьXML(ЗаписьХМЛ,ОбъектОбмена.Договор.получитьОбъект());
			КонецЕсли;
			Для каждого ЛЗ из ОбъектОбмена.ЛимитированныеЗатраты Цикл
				Если не ЛЗ.ЛимитированнаяЗатрата.Пустая() Тогда
					Если не ЛЗ.ЛимитированнаяЗатрата.ГлаваССРС.Пустая() Тогда
						ЗаписатьXML(ЗаписьХМЛ,ЛЗ.ЛимитированнаяЗатрата.ГлаваССРС.получитьОбъект());
					КонецЕсли;
					ЗаписатьXML(ЗаписьХМЛ,ЛЗ.ЛимитированнаяЗатрата.получитьОбъект());
				КонецЕсли;
			КонецЦикла;
			Для каждого Физ из ОбъектОбмена.Подписи Цикл
				Если не Физ.ФИО.Пустая() Тогда
					ЗаписатьXML(ЗаписьХМЛ,Физ.ФИО.получитьОбъект());
				КонецЕсли;
			КонецЦикла;
			Для каждого СтрССРС из ОбъектОбмена.Сметы Цикл
				Если не СтрССРС.ГлаваССРС.Пустая() Тогда
					ЗаписатьXML(ЗаписьХМЛ,СтрССРС.ГлаваССРС.получитьОбъект());
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если ТипЗнч(ОбъектОбмена) = Тип("ДокументОбъект.СМ_АктВыполненныхРабот") или  ТипЗнч(ОбъектОбмена) = Тип("ДокументОбъект.СМ_ЛокальнаяСмета") Тогда			
			Набор = РегистрыСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СоздатьНаборЗаписей();
			Набор.Отбор.Смета.Значение = ОбъектОбмена.Ссылка;
			Набор.Отбор.Смета.Использование = Истина;
			Набор.Прочитать();
			ЗаписатьXML(ЗаписьХМЛ,Набор);
			
			Набор = РегистрыСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.СоздатьНаборЗаписей();
			Набор.Отбор.Смета.Значение = ОбъектОбмена.Ссылка;
			Набор.Отбор.Смета.Использование = Истина;
			Набор.Прочитать();
			ЗаписатьXML(ЗаписьХМЛ,Набор);
            			
			Набор = РегистрыСведений.СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СоздатьНаборЗаписей();
			Набор.Отбор.Смета.Значение = ОбъектОбмена.Ссылка;
			Набор.Отбор.Смета.Использование = Истина;
			Набор.Прочитать();
			ЗаписатьXML(ЗаписьХМЛ,Набор);

			Набор = РегистрыСведений.СМ_РесурснаяСтоимостьПозиции.СоздатьНаборЗаписей();
			Набор.Отбор.Смета.Значение = ОбъектОбмена.Ссылка;
			Набор.Отбор.Смета.Использование = Истина;
			Набор.Прочитать();
			ЗаписатьXML(ЗаписьХМЛ,Набор);
			
			Набор = РегистрыСведений.СМ_СтоимостьРесурсовПозиции.СоздатьНаборЗаписей();
			Набор.Отбор.Смета.Значение = ОбъектОбмена.Ссылка;
			Набор.Отбор.Смета.Использование = Истина;
			Набор.Прочитать();
			ЗаписатьXML(ЗаписьХМЛ,Набор);
			
			Набор = РегистрыСведений.СМ_НРиСП.СоздатьНаборЗаписей();
			Набор.Отбор.Смета.Значение = ОбъектОбмена.Ссылка;
			Набор.Отбор.Смета.Использование = Истина;
			Набор.Прочитать();
			ЗаписатьXML(ЗаписьХМЛ,Набор);


		КонецЕсли;
		ЗаписатьXML(ЗаписьХМЛ,ОбъектОбмена);       
	КонецЦикла; 
	
	// Регистры
	// Пока ВыборкаИзменений.Следующий() Цикл
	//	ОбъектОбмена = ВыборкаИзменений.Получить();
	// КонецЦикла;

    ЗаписьСообщения.ЗакончитьЗапись();

    Возврат ЗаписьХМЛ.Закрыть(); 
КонецФункции

