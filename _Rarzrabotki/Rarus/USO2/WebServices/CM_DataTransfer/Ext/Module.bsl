Функция Синхронизация(Данные)
	ОтветКлиенту = ЗарегестрироватьВыгрузку(Данные.Получить());
	ОтветКлиенту = Преобразование(ОтветКлиенту)	;
	
	// ВремФайл = ПолучитьИмяВременногоФайла("txt");
	// ТекДок = Новый ТекстовыйДокумент;
	// ТекДок.УстановитьТекст(ОтветКлиенту);
	// ТекДок.Записать(ВремФайл);

    Возврат Новый ХранилищеЗначения(ОтветКлиенту, Новый СжатиеДанных(9));
КонецФункции

Функция ЗарегестрироватьВыгрузку(СтрокаСообщения)
	Соответствие = Десериализовать(СтрокаСообщения);
	КодОтправитель = Соответствие.Получить("Отправитель");
    Отправитель	= ПланыОбмена.СМ_ОбменСметаМобильное.НайтиПоКоду(КодОтправитель);
	НомерПринятого = Соответствие.Получить("НомерПринятого");
	ПланыОбмена.УдалитьРегистрациюИзменений(Отправитель,НомерПринятого);
    СписокСмет = Новый СписокЗначений();
	Для Каждого Дан из Соответствие Цикл
		Если Дан.Ключ = "Позиции" Тогда
			Для каждого Поз из Дан.Значение Цикл
				Позиция = Документы.СМ_ПозицияЛокальнойСметы.ПолучитьСсылку(Поз.УИН);
				Если Не Позиция.Пустая() Тогда
					ПозОб = Позиция.ПолучитьОбъект();
					ПозОб.ОбъемРабот = Поз.Объем;
					ПозОб.Записать();
					Если СписокСмет.НайтиПоЗначению(ПозОб.ИДСметы) = Неопределено Тогда
						СписокСмет.Добавить(ПозОб.ИДСметы);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли Дан.Ключ = "Акты" Тогда
			Для каждого Поз из Дан.Значение Цикл
				Акт = Документы.СМ_АктВыполненныхРабот.ПолучитьСсылку(Поз.УИН);
				Если Не Акт.Пустая() Тогда
					АктОб = Акт.ПолучитьОбъект();
					Для каждого АктПоз из Поз.Позиции Цикл
						Позиция = Документы.СМ_ПозицияЛокальнойСметы.ПолучитьСсылку(АктПоз.УИН);
						Если Не Позиция.Пустая() Тогда
							СтрАктПоз = АктОб.Позиции.Найти(Позиция,"Позиция");
							Если СтрАктПоз <> Неопределено Тогда
								СтрАктПоз.ФактОбъем = АктПоз.ФактОбъем; 
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					АктОб.Записать();
					Документы.СМ_АктВыполненныхРабот.Перерасчет(АктОб, Ложь);
					// Если СписокСмет.НайтиПоЗначению(АктОб.ЛокальнаяСмета) = Неопределено Тогда
					//	СписокСмет.Добавить(ПозОб.ЛокальнаяСмета);
					// КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Для каждого эл из СписокСмет Цикл
		Документы.СМ_ЛокальнаяСмета.Перерасчет(эл.Значение, Ложь);
