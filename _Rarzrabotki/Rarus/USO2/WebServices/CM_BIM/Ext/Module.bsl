
#Область Методы

Функция SetDataList(Data)
	
	Действие=Data.Action;
	
	ОбъектСтроительства = СМ_BIM_ВызовСервера.ПолучитьОбъектСтроительства(Data.BuildingObject);
	                 	
	Если Действие="SetPosition" Тогда
		
		Попытка
			ТаблицаСоответствий=ПреобразоватьПараметрыСоответствияВТаблицуЗначений(ОбъектСтроительства,Data.bimRequestList,Data.BuildingObject);		
			
			Для Каждого СтрокаПараметров Из ТаблицаСоответствий Цикл
				Запись=РегистрыСведений.СМ_BIM_СоответствиеОбъектов.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись,СтрокаПараметров);
				Запись.Записать();
			КонецЦикла;
			return "Ok";
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'СМ_BIM WS'",
			ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка, , , "Ошибка при записи соответствия");
			return "Write/read error";
		КонецПопытки;      		
		
	ИначеЕсли Действие="DelPosition" Тогда
		
		Попытка
			ТаблицаСоответствий=ПреобразоватьПараметрыСоответствияВТаблицуЗначений(ОбъектСтроительства,Data.bimRequestList,Data.BuildingObject);		
			
			Для Каждого СтрокаПараметров Из ТаблицаСоответствий Цикл
				Запись=РегистрыСведений.СМ_BIM_СоответствиеОбъектов.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись,СтрокаПараметров);
				Запись.Прочитать();
				Запись.Удалить();
			КонецЦикла;
			return "Ok";
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'СМ_BIM WS'",
			ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка, , , "Ошибка при записи соответствия");
			return "Write/read error";
		КонецПопытки;
		
	ИначеЕсли Действие="SaveParam" Тогда
		
		Попытка
			ТаблицаХарактеристик= ПреобразоватьХарактеристикиВТаблицуЗначений(ОбъектСтроительства,Data.bimRequestList,Data.BuildingObject);
			Для Каждого СтрокаПараметров Из ТаблицаХарактеристик Цикл
				Запись=РегистрыСведений.СМ_BIM_ХарактеристикиОбъектов.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись,СтрокаПараметров);
				Запись.Записать();
			КонецЦикла;
			return "Ok";
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'СМ_BIM WS'",
			ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка, , , "Ошибка при записи соответствия");
			return "Write/read error";
		КонецПопытки;
		
	КонецЕсли;
	
	return "Action no find";
	
КонецФункции

Функция GetDataList(Data)
	
	Запрос=новый Запрос;	
	Если Data.ParamName="root" Тогда	
		// Не используется.
		Запрос.Текст="ВЫБРАТЬ
		|	СМ_НормативныеСборники.Ссылка КАК Code,
		|	СМ_НормативныеСборники.Наименование КАК Name,
		|	СМ_НормативныеСборники.Родитель КАК StGroup,
		|	ЕСТЬNULL(СМ_НормативныеСборники.ЕдиницаИзмерения.Наименование, """") КАК Metric,
		|	ЕСТЬNULL(СМ_НормативныеСборники.КодНормативнойРасценки, """") КАК Key,
		|	СМ_НормативныеСборники.ТипНормативногоСборника
		|ИЗ
		|	Справочник.СМ_НормативныеСборники КАК СМ_НормативныеСборники
		|ГДЕ
		|	СМ_НормативныеСборники.Родитель.Код ЕСТЬ NULL 
		|	И НЕ СМ_НормативныеСборники.ПометкаУдаления";
		
		Результат=Запрос.Выполнить().Выгрузить();	
		
		ТипСтрока = ФабрикаXDTO.Тип("bimPack","bimStandard");
		ТипТаблица = ФабрикаXDTO.Тип("bimPack","bimStandardList");
		Таблица = ФабрикаXDTO.Создать(ТипТаблица);
		Для Каждого Стр Из результат Цикл
			Строка = ФабрикаXDTO.Создать(ТипСтрока);
			Строка.Name=Стр.Name;
			Строка.Metric=Стр.Metric;
			Строка.Key=Стр.Key;
			Строка.Code=Строка(Стр.Code.УникальныйИдентификатор());
			Строка.StGroup=Строка(Стр.StGroup.УникальныйИдентификатор());
			Строка.TypeLink="";
			Строка.ParamId="";
			Строка.Book=Строка(Стр.ТипНормативногоСборника);
			Таблица.bimStandard.Добавить(Строка);
		КонецЦикла;
		
	ИначеЕсли Data.paramName="uid" Тогда	
		
		// Не используется.
		Запрос.Текст="ВЫБРАТЬ
		|	СМ_НормативныеСборники.Ссылка КАК Code,
		|	СМ_НормативныеСборники.Наименование КАК Name,
		|	СМ_НормативныеСборники.Родитель КАК StGroup,
		|	ЕСТЬNULL(СМ_НормативныеСборники.ЕдиницаИзмерения.Наименование, """") КАК Metric,
		|	ЕСТЬNULL(СМ_НормативныеСборники.КодНормативнойРасценки, """") КАК Key,
		|	СМ_НормативныеСборники.ТипНормативногоСборника
		|ИЗ
		|	Справочник.СМ_НормативныеСборники КАК СМ_НормативныеСборники
		|ГДЕ
		|	СМ_НормативныеСборники.Родитель = &Ссылка
		|	И НЕ СМ_НормативныеСборники.ПометкаУдаления ";
		
		Ссылка = XMLЗначение(ИзXMLТипа(XMLТипЗнч(Справочники.СМ_НормативныеСборники.ПустаяСсылка())), Data.paramValue);	
		Запрос.УстановитьПараметр("Ссылка",Ссылка);
		
		Результат=Запрос.Выполнить().Выгрузить();	
		ТипСтрока = ФабрикаXDTO.Тип("bimPack","bimStandard");
		ТипТаблица = ФабрикаXDTO.Тип("bimPack","bimStandardList");
		Таблица = ФабрикаXDTO.Создать(ТипТаблица);
		
		Для Каждого Стр Из Результат Цикл
			Строка = ФабрикаXDTO.Создать(ТипСтрока);
			Строка.Name=Стр.Name;
			Строка.Metric=Стр.Metric;
			Строка.Key=Стр.Key;
			Строка.Code=Строка(Стр.Code.УникальныйИдентификатор());
			Строка.StGroup=Строка(Стр.StGroup.УникальныйИдентификатор());
			Строка.TypeLink="";
			Строка.ParamId="";
			Строка.Book=Строка(Стр.ТипНормативногоСборника);
			Таблица.bimStandard.Добавить(Строка);
		КонецЦикла;
		
	ИначеЕсли 	Data.paramName="search" Тогда
		
		// Не используется.
		Стр=Data.paramValue;
		СтрМас=СтрЗаменить(Стр," ",Символы.ПС);
		Усл="";
		Для Сч=1 По СтрЧислоСтрок(СтрМас) Цикл
			Слово=СокрЛП(СтрПолучитьстроку(СтрМас,СЧ));
			Если СтрДлина(Слово)=0 Тогда Продолжить; КонецЕсли;
			Усл=Усл+" И (Наименование ПОДОБНО ""%"+Слово+"%"" ИЛИ КодНормативнойРасценки ПОДОБНО ""%"+Слово+"%"")";
		КонецЦикла;
		
		
		СхемаКомпоновкиДанных = ПолучитьМакетДляПоиска(Усл);
		
		Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
		ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);
		Результат = Новый ТаблицаЗначений;
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		ПроцессорВывода.УстановитьОбъект(Результат);
		ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
		
		ТипСтрока = ФабрикаXDTO.Тип("bimPack","bimStandard");
		ТипТаблица = ФабрикаXDTO.Тип("bimPack","bimStandardList");
		Таблица = ФабрикаXDTO.Создать(ТипТаблица);
		
		Для Каждого Стр Из Результат Цикл
			Строка = ФабрикаXDTO.Создать(ТипСтрока);
			Строка.Name=Стр.Name;
			Строка.Metric=Стр.Metric;
			Строка.Key=Стр.Key;
			Строка.Code=Строка(Стр.Code.УникальныйИдентификатор());
			Если ЗначениеЗаполнено(Стр.StGroup) Тогда
				Строка.StGroup=Строка(Стр.StGroup.УникальныйИдентификатор());
			ИначеЕсли ЗначениеЗаполнено(Стр.Code) Тогда
				Строка.StGroup=Строка(Стр.Code.Родитель.УникальныйИдентификатор());
			Иначе 
				Строка.StGroup="";
			КОнецесли;
			Строка.TypeLink="";
			Строка.ParamId="";
			Строка.Book=Строка(Стр.ТипНормативногоСборника);
			Таблица.bimStandard.Добавить(Строка);
		КонецЦикла;
		
	ИначеЕсли Data.paramName="obid" Тогда
		
		Запрос.Текст="ВЫБРАТЬ
		             |	СМ_НормативныеСборники.Ссылка КАК Code,
		             |	СМ_НормативныеСборники.Наименование КАК Name,
		             |	СМ_НормативныеСборники.Родитель КАК StGroup,
		             |	ЕСТЬNULL(СМ_НормативныеСборники.ЕдиницаИзмерения.Наименование, """") КАК Metric,
		             |	ЕСТЬNULL(СМ_НормативныеСборники.КодНормативнойРасценки, """") КАК Key,
		             |	СМ_НормативныеСборники.ТипНормативногоСборника,
		             |	СМ_BIM_СоответствиеОбъектов.ПоказательДляРасчета КАК TypeLink,
		             |	СМ_BIM_СоответствиеОбъектов.ИдентификаторВМодели КАК ParamId,
		             |	СМ_BIM_СоответствиеОбъектов.ИдентификаторРесурса КАК ParamMaterialId,
		             |	СМ_BIM_СоответствиеОбъектов.ШифрРодителя КАК KeyParent,
		             |	СМ_BIM_СоответствиеОбъектов.ТипНормативногоСборникаРодителя КАК BookParent
		             |	
		             |ИЗ
		             |	Справочник.СМ_НормативныеСборники КАК СМ_НормативныеСборники
		             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СМ_BIM_СоответствиеОбъектов КАК СМ_BIM_СоответствиеОбъектов
		             |		ПО СМ_НормативныеСборники.КодНормативнойРасценки = СМ_BIM_СоответствиеОбъектов.Шифр
		             |			И СМ_НормативныеСборники.ТипНормативногоСборника = СМ_BIM_СоответствиеОбъектов.ТипНормативногоСборника
		             |			И (СМ_BIM_СоответствиеОбъектов.ОбъектСтроительства = &ОбъектСтроительства)
		             |			И (СМ_BIM_СоответствиеОбъектов.ИдентификаторПроекта = &ИдентификаторПроекта)
		             |			И (СМ_BIM_СоответствиеОбъектов.ИдентификаторВМодели <> ""File"")
		             |			И (СМ_НормативныеСборники.КодНормативнойРасценки <> """") //%ТЕКСТИД%
		             |ГДЕ
		             |	НЕ СМ_НормативныеСборники.ПометкаУдаления ";
		
		СписокНормативов = Новый СписокЗначений();
		Если ЗначениеЗаполнено(Data.paramid) Тогда
			Массив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Data.paramid, "%", Истина);
			СписокНормативов = Новый СписокЗначений();
			СписокНормативов.ЗагрузитьЗначения(Массив);
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "//%ТЕКСТИД%", " И (СМ_BIM_СоответствиеОбъектов.ИдентификаторВМодели В (&ИдентификаторыВМодели))");
			Запрос.УстановитьПараметр("ИдентификаторыВМодели",СписокНормативов);				
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ОбъектСтроительства", СМ_BIM_ВызовСервера.ПолучитьОбъектСтроительства(Data.paramValue));	
		Запрос.УстановитьПараметр("ИдентификаторПроекта",Data.paramValue);
		Результат=Запрос.Выполнить().Выгрузить();	
		ТипСтрока = ФабрикаXDTO.Тип("bimPack","bimStandard");
		ТипТаблица = ФабрикаXDTO.Тип("bimPack","bimStandardList");
		Таблица = ФабрикаXDTO.Создать(ТипТаблица);
		Для Каждого Стр Из результат Цикл
			Строка = ФабрикаXDTO.Создать(ТипСтрока);
			Строка.Name=Стр.Name;
			Строка.Metric=Стр.Metric;
			Строка.Key=Стр.Key;
			Строка.Code=Строка(Стр.Code.УникальныйИдентификатор());
			Строка.StGroup=Строка(Стр.StGroup.УникальныйИдентификатор());
			Строка.TypeLink=Стр.TypeLink;
			Строка.ParamId=Стр.ParamId;
			Строка.Book=Строка(Стр.ТипНормативногоСборника);
			Строка.KeyParent=Стр.KeyParent;
			Строка.BookParent=Строка(Стр.BookParent);
			Строка.ParamMaterialId=Стр.ParamMaterialId;
			Таблица.bimStandard.Добавить(Строка);
		КонецЦикла;	
		
	ИначеЕсли  Data.paramName="build" Тогда
		
		Запрос.Текст="ВЫБРАТЬ
		|	Вт.Ссылка КАК Code,
		|	Вт.Наименование КАК Name,
		|	Вт.Родитель КАК StGroup
		|ИЗ
		|	Справочник.СМ_ОбъектыСтроительства КАК Вт
		|ГДЕ
		|	НЕ Вт.ПометкаУдаления";
		Результат=Запрос.Выполнить().Выгрузить();	
		ТипСтрока = ФабрикаXDTO.Тип("bimPack","bimStandard");
		ТипТаблица = ФабрикаXDTO.Тип("bimPack","bimStandardList");
		Таблица = ФабрикаXDTO.Создать(ТипТаблица);
		Для Каждого Стр Из результат Цикл
			Строка = ФабрикаXDTO.Создать(ТипСтрока);
			Строка.Name=Стр.Name;
			Строка.Metric="";
			Строка.Key="";
			Строка.Code=Строка(Стр.Code.УникальныйИдентификатор());
			Строка.StGroup=Строка(Стр.StGroup.УникальныйИдентификатор());
			Строка.TypeLink="";
			Строка.ParamId="";
			Строка.Book="";
			Таблица.bimStandard.Добавить(Строка);
		КонецЦикла;
		
	ИначеЕсли (Data.paramName="all_types") Или (Data.paramName="types") Тогда
		
		Запрос.Текст="ВЫБРАТЬ
		             |	СМ_BIM_НормативныеСборникиТипыЭлементовМодели.НормативныйСборник КАК Code,
		             |	СМ_BIM_НормативныеСборникиТипыЭлементовМодели.НормативныйСборник.Наименование КАК Name,
		             |	СМ_BIM_НормативныеСборникиТипыЭлементовМодели.НормативныйСборник.ТипНормативногоСборника КАК Book,
		             |	СМ_BIM_НормативныеСборникиТипыЭлементовМодели.НормативныйСборник.Родитель КАК StGroup,
		             |	ЕСТЬNULL(СМ_BIM_НормативныеСборникиТипыЭлементовМодели.НормативныйСборник.ЕдиницаИзмерения.Наименование, """") КАК Metric,
		             |	ЕСТЬNULL(СМ_BIM_НормативныеСборникиТипыЭлементовМодели.НормативныйСборник.КодНормативнойРасценки, """") КАК Key,
		             |	СМ_BIM_НормативныеСборникиТипыЭлементовМодели.ТипЭлемента.Ссылка КАК ТипЭлемента,
		             |	СМ_BIM_НормативныеСборникиТипыЭлементовМодели.ТипЭлемента.ИдентификаторРенга КАК ParamId,
		             |	СМ_BIM_НормативныеСборникиТипыЭлементовМодели.ТипЭлемента.ИмяКлассаРенга КАК ИмяКлассаРенга
		             |ИЗ
		             |	РегистрСведений.СМ_BIM_НормативныеСборникиТипыЭлементовМодели КАК СМ_BIM_НормативныеСборникиТипыЭлементовМодели";
		
		Если (Data.paramName="types") И ЗначениеЗаполнено(Data.ParamValue) Тогда
			Запрос.Текст=Запрос.Текст+" ГДЕ СМ_BIM_НормативныеСборникиТипыЭлементовМодели.НормативныйСборник = &Ссылка";	
			Запрос.УстановитьПараметр("Ссылка", Data.ParamValue);
		КонецЕсли;
		Результат=Запрос.Выполнить().Выгрузить();	
		ТипСтрока = ФабрикаXDTO.Тип("bimPack","bimStandard");
		ТипТаблица = ФабрикаXDTO.Тип("bimPack","bimStandardList");
		Таблица = ФабрикаXDTO.Создать(ТипТаблица);
		Для Каждого Стр Из результат Цикл
			Строка = ФабрикаXDTO.Создать(ТипСтрока);
			Строка.Name=Стр.Name;
			Строка.Metric=Стр.Metric;
			Строка.Key=Стр.Key;
			Строка.Code=Строка(Стр.Code.УникальныйИдентификатор());
			Строка.StGroup=Строка(Стр.StGroup.УникальныйИдентификатор());
			Строка.TypeLink="";
			Строка.ParamId=Стр.ParamId;
			Строка.Book=Строка(Стр.Book);
			Строка.KeyParent="";
			Строка.BookParent="";
			Строка.ParamMaterialId="";
			Таблица.bimStandard.Добавить(Строка);
		КонецЦикла;
		
	Иначе 
		
		Запрос.Текст="ВЫБРАТЬ
		             |	СМ_НормативныеСборники.Ссылка КАК Code,
		             |	ЕСТЬNULL(СМ_НормативныеСборники.Наименование, """") КАК Name,
		             |	ЕСТЬNULL(СМ_НормативныеСборники.Родитель, """") КАК StGroup,
		             |	ЕСТЬNULL(СМ_НормативныеСборники.ЕдиницаИзмерения.Наименование, """") КАК Metric,
		             |	ЕСТЬNULL(СМ_НормативныеСборники.КодНормативнойРасценки, """") КАК Key,
		             |	СМ_НормативныеСборники.ТипНормативногоСборника КАК ТипНормативногоСборника,
		             |	0 КАК НомерСтроки,
		             |	ВЫБОР
		             |		КОГДА СМ_НормативныеСборники.ЭтоГруппа
		             |			ТОГДА ""GROUP""
		             |		ИНАЧЕ ""NORM""
		             |	КОНЕЦ КАК TypeLink
		             |ИЗ
		             |	Справочник.СМ_НормативныеСборники КАК СМ_НормативныеСборники
		             |ГДЕ
		             |	НЕ СМ_НормативныеСборники.ПометкаУдаления
		             |
		             |ОБЪЕДИНИТЬ ВСЕ
		             |
		             |ВЫБРАТЬ
		             |	СМ_НормативныеСборникиРесурсыНормативныхСборников.Ссылка,
		             |	ВЫБОР
		             |		КОГДА ЕСТЬNULL(СМ_НормативныеСборникиРесурсыНормативныхСборников.НаименованиеРесурса, """") = """"
		             |			ТОГДА СМ_НормативныеСборникиРесурсыНормативныхСборников.Ресурс.Наименование
		             |		ИНАЧЕ ЕСТЬNULL(СМ_НормативныеСборникиРесурсыНормативныхСборников.НаименованиеРесурса, """")
		             |	КОНЕЦ,
		             |	СМ_НормативныеСборникиРесурсыНормативныхСборников.Ссылка,
		             |	ВЫБОР
		             |		КОГДА ЕСТЬNULL(ВЫРАЗИТЬ(СМ_НормативныеСборникиРесурсыНормативныхСборников.ЕдиницаИзмеренияРесурса КАК СТРОКА(50)), """") = """"
		             |			ТОГДА СМ_НормативныеСборникиРесурсыНормативныхСборников.Ресурс.ЕдиницаИзмерения.Наименование
		             |		ИНАЧЕ СМ_НормативныеСборникиРесурсыНормативныхСборников.ЕдиницаИзмеренияРесурса
		             |	КОНЕЦ,
		             |	ВЫБОР
		             |		КОГДА ЕСТЬNULL(СМ_НормативныеСборникиРесурсыНормативныхСборников.КодРесурса, """") = """"
		             |			ТОГДА СМ_НормативныеСборникиРесурсыНормативныхСборников.Ресурс.Код
		             |		ИНАЧЕ СМ_НормативныеСборникиРесурсыНормативныхСборников.КодРесурса
		             |	КОНЕЦ,
		             |	ЗНАЧЕНИЕ(Перечисление.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы),
		             |	СМ_НормативныеСборникиРесурсыНормативныхСборников.НомерСтроки,
		             |	""RESOURCE""
		             |ИЗ
		             |	Справочник.СМ_НормативныеСборники.РесурсыНормативныхСборников КАК СМ_НормативныеСборникиРесурсыНормативныхСборников
		             |ГДЕ
		             |	СМ_НормативныеСборникиРесурсыНормативныхСборников.Ссылка.ПометкаУдаления = ЛОЖЬ
		             |	И СМ_НормативныеСборникиРесурсыНормативныхСборников.ТипРесурса <> ЗНАЧЕНИЕ(Перечисление.СМ_ТипыМатериалов.Учтенный)";
		Результат=Запрос.Выполнить().Выгрузить();	
		ТипСтрока = ФабрикаXDTO.Тип("bimPack","bimStandard");
		ТипТаблица = ФабрикаXDTO.Тип("bimPack","bimStandardList");
		Таблица = ФабрикаXDTO.Создать(ТипТаблица);
		Для Каждого Стр Из Результат Цикл
			Если Стр.Name<>NULL  Тогда
				Строка = ФабрикаXDTO.Создать(ТипСтрока);
				Строка.Name=?(Стр.Name<>NULL,Стр.Name,"");
				Строка.Metric=Стр.Metric;
				Строка.Key=Стр.Key;
				Строка.Code=Строка(Стр.Code.УникальныйИдентификатор())+?(Стр.НомерСтроки>0, "#"+Формат(Стр.НомерСтроки,"ЧГ=0"), "");
				Строка.StGroup=Строка(Стр.StGroup.УникальныйИдентификатор());
				Строка.TypeLink=Стр.TypeLink;
				Строка.ParamId="";
				Строка.Book=Строка(Стр.ТипНормативногоСборника);
				Таблица.bimStandard.Добавить(Строка);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;	
	
	
	Возврат Таблица;
	
	
КонецФункции

Функция GetDataListById(Data)
	
	ОбъектСтроительства = СМ_BIM_ВызовСервера.ПолучитьОбъектСтроительства(Data.BuildingObject);
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	СМ_НормативныеСборники.Ссылка КАК Code,
	|	СМ_НормативныеСборники.Наименование КАК Name,
	|	СМ_НормативныеСборники.Родитель КАК StGroup,
	|	ЕСТЬNULL(СМ_НормативныеСборники.ЕдиницаИзмерения.Наименование, """") КАК Metric,
	|	ЕСТЬNULL(СМ_НормативныеСборники.КодНормативнойРасценки, """") КАК Key,
	|	СМ_НормативныеСборники.ТипНормативногоСборника,
	|	СМ_BIM_СоответствиеОбъектов.ПоказательДляРасчета КАК TypeLink,
	| СМ_BIM_СоответствиеОбъектов.ИдентификаторВМодели КАК ParamId
	|ИЗ
	|	Справочник.СМ_НормативныеСборники КАК СМ_НормативныеСборники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СМ_BIM_СоответствиеОбъектов КАК СМ_BIM_СоответствиеОбъектов
	|		ПО СМ_НормативныеСборники.КодНормативнойРасценки = СМ_BIM_СоответствиеОбъектов.Шифр
	|			И СМ_НормативныеСборники.ТипНормативногоСборника = СМ_BIM_СоответствиеОбъектов.ТипНормативногоСборника
	|			И (&НеЗаполнено
	|				ИЛИ СМ_BIM_СоответствиеОбъектов.ИдентификаторВМодели В (&ИдентификаторВМодели))
	|			И (СМ_BIM_СоответствиеОбъектов.ОбъектСтроительства = &ОбъектСтроительства)
	|			И (СМ_BIM_СоответствиеОбъектов.ИдентификаторПроекта = &ИдентификаторПроекта)
	|ГДЕ
	|	НЕ СМ_НормативныеСборники.ПометкаУдаления";
	
	МассивЭлементов=Новый Массив;
	Для Каждого СтрокаПараметров Из Data.bimRequestIdList Цикл
		МассивЭлементов.Добавить(СтрокаПараметров.ParamId);
	КонецЦикла;	 
	
	
	Запрос.УстановитьПараметр("ИдентификаторВМодели",МассивЭлементов);
	Запрос.УстановитьПараметр("НеЗаполнено",МассивЭлементов.Количество()=0);
	
	
	Запрос.УстановитьПараметр("ОбъектСтроительства", СМ_BIM_ВызовСервера.ПолучитьОбъектСтроительства(Data.BuildingObject));	
	Запрос.УстановитьПараметр("ИдентификаторПроекта",Data.BuildingObject);
	
	Результат=Запрос.Выполнить().Выгрузить();	
	ТипСтрока = ФабрикаXDTO.Тип("bimPack","bimStandard");
	ТипТаблица = ФабрикаXDTO.Тип("bimPack","bimStandardList");
	Таблица = ФабрикаXDTO.Создать(ТипТаблица);
	Для Каждого Стр Из результат Цикл
		Строка = ФабрикаXDTO.Создать(ТипСтрока);
		Строка.Name=Стр.Name;
		Строка.Metric=Стр.Metric;
		Строка.Key=Стр.Key;
		Строка.Code=Строка(Стр.Code.УникальныйИдентификатор());
		Строка.StGroup=Строка(Стр.StGroup.УникальныйИдентификатор());
		Строка.TypeLink=Стр.TypeLink;
		Строка.ParamId=Стр.ParamId;
		Строка.Book=Строка(Стр.ТипНормативногоСборника);
		Таблица.bimStandard.Добавить(Строка);
	КонецЦикла;	
	
	Возврат Таблица;
	
	
КонецФункции

Функция CreateDocs(Data)
	
	// Входной параметр Data структура вида:
	// BuildingObject 	- название проекта.
	// BimRequestList 	- список структур вида.
	// ParamName 		- название параметра.
	// ParamValue 		- значение параметра.
	// ParamId 			- идентификатор.
	// BimRequestList 	- заполняется следующим образом (списком).
	// ParamName 		- тип параметра для расчета (TypeLink).				
	// ParamValue 		- Расчетное значение параметра.				
	// ParamId 			- Ид объекта модели ренги.
	// Заполняются все элементы которые должны быть в смете (сколько смет, столько обращений к функции).
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'СМ_BIM WS'",ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Информация, , , "Формирование сметы");
	                                                               	
	ОбъектСтроительства = СМ_BIM_ВызовСервера.ПолучитьОбъектСтроительства(Data.BuildingObject);
	
	Попытка
		
		ТаблицаХарактеристик= ПреобразоватьХарактеристикиВТаблицуЗначений(ОбъектСтроительства,Data.bimRequestList,Data.BuildingObject);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'СМ_BIM WS'",ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка, , , "Ошибка передачи параметров в сервис: "+ТекстОшибки);
		УстановитьПривилегированныйРежим(Ложь);
		Возврат "bimRequestList invalid";  
		
	КонецПопытки;
	
	Попытка
		
		Для Каждого СтрокаПараметров Из ТаблицаХарактеристик Цикл
			Запись=РегистрыСведений.СМ_BIM_ХарактеристикиОбъектов.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись,СтрокаПараметров);
			Запись.Записать();
		КонецЦикла;
		
	Исключение
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'СМ_BIM WS'",
		ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка, , , "Ошибка при записи характеристик");
		
		УстановитьПривилегированныйРежим(Ложь);
		
		return "Write/read error";
		
	КонецПопытки;
	
	Если ЗначениеЗаполнено(Константы.СМ_BIM_ШаблонСтруктурыСметы.Получить()) Тогда
	
		Результат = СМ_BIM_ВызовСервера.СоздатьСметныйДокументПоКонструктивам(ОбъектСтроительства, Data.BuildingObject, ТаблицаХарактеристик);
		
	Иначе
		
		Результат = СМ_BIM_ВызовСервера.СоздатьСметныйДокументПоТипамКонструктивов(ОбъектСтроительства, Data.BuildingObject, ТаблицаХарактеристик);
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция SetBuildingObject(Data)
		
	Попытка	
		
		МД = XMLТипЗнч(Справочники.СМ_ОбъектыСтроительства.ПустаяСсылка());
		Ссылка = XMLЗначение(ИзXMLТипа(МД), Data.ParamValue);
		
	Исключение
		
		return "Building uid invalid";
		
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ОбъектыСтроительства.Ссылка,
	               |	1 КАК Приоритет
	               |ИЗ
	               |	Справочник.СМ_ОбъектыСтроительства КАК СМ_ОбъектыСтроительства
	               |ГДЕ
	               |	СМ_ОбъектыСтроительства.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СМ_ОбъектыСтроительства.Ссылка,
	               |	2
	               |ИЗ
	               |	Справочник.СМ_ОбъектыСтроительства КАК СМ_ОбъектыСтроительства
	               |ГДЕ
	               |	СМ_ОбъектыСтроительства.Наименование = &Наименование
	               |	И СМ_ОбъектыСтроительства.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Приоритет";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Наименование", Ссылка.Наименование);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		СсылкаВБазе = Выборка.Ссылка;
		
	ИначеЕсли ЗначениеЗаполнено(Ссылка) Тогда

		// Создаем объект в базе.
		СозданНаОснованииОбъект = Справочники.СМ_ОбъектыСтроительства.СоздатьЭлемент();

		СозданНаОснованииОбъект.УстановитьСсылкуНового(Справочники.СМ_ОбъектыСтроительства.ПолучитьСсылку(Ссылка.УникальныйИдентификатор()));
		СозданНаОснованииНезаписаннаяСсылка=СозданНаОснованииОбъект.ПолучитьСсылкуНового();
		
		//ЗаполнитьЗначенияСвойств(СозданНаОснованииОбъект, Ссылка);
		СозданНаОснованииОбъект.Наименование = ?(СозданНаОснованииОбъект.Наименование = "", "По файлу Renga "+Ссылка.УникальныйИдентификатор(), СозданНаОснованииОбъект.Наименование);
		
		СозданНаОснованииОбъект.Записать();
		
		СсылкаВБазе = СозданНаОснованииОбъект.Ссылка;  
		
	Иначе
		
		СсылкаВБазе = Справочники.СМ_ОбъектыСтроительства.ПустаяСсылка();
	
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(СсылкаВБазе) Тогда
		
		Запись=РегистрыСведений.СМ_BIM_СоответствиеОбъектов.СоздатьМенеджерЗаписи();
		Запись.ОбъектСтроительства=СсылкаВБазе;
		Запись.ИдентификаторВМодели = "File";
		Запись.ПоказательДляРасчета=Data.ParamName;
		Запись.ИдентификаторПроекта=Data.ParamValue;
		Запись.Записать();
		
		return "Ok";
		
	КонецЕсли;
	
	return "Building object no find";
	
КонецФункции

