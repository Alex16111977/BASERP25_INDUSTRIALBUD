Функция ПреобразоватьПараметрыСоответствияВТаблицуЗначений(ОбъектСтроительства,bimRequestList,ИдентификаторПроекта)
	
	ТаблицаСоответствий=Новый ТаблицаЗначений;
	ТаблицаСоответствий.Колонки.Добавить("ОбъектСтроительства",Новый ОписаниеТипов("СправочникСсылка.СМ_ОбъектыСтроительства"));
	ТаблицаСоответствий.Колонки.Добавить("Шифр",ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТаблицаСоответствий.Колонки.Добавить("ТипНормативногоСборника",Новый ОписаниеТипов("ПеречислениеСсылка.СМ_ТипыНормативныхСборников"));
	ТаблицаСоответствий.Колонки.Добавить("ШифрРодителя",ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТаблицаСоответствий.Колонки.Добавить("ТипНормативногоСборникаРодителя",Новый ОписаниеТипов("ПеречислениеСсылка.СМ_ТипыНормативныхСборников"));
	ТаблицаСоответствий.Колонки.Добавить("ИдентификаторВМодели",ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаСоответствий.Колонки.Добавить("ИдентификаторРесурса",ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаСоответствий.Колонки.Добавить("ПоказательДляРасчета",ОбщегоНазначения.ОписаниеТипаСтрока(300));
	ТаблицаСоответствий.Колонки.Добавить("ИдентификаторПроекта",ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТаблицаСоответствий.Колонки.Добавить("ЯвляетсяРесурсом",Новый ОписаниеТипов("Булево"));
	
	ТекущийИдентификатор="";
	СтрокаСоответствий=Неопределено;
	Для Каждого СтрокаПараметров Из bimRequestList Цикл
		
		Если ТекущийИдентификатор<>СтрокаПараметров.ParamId Или СтрокаСоответствий=Неопределено Тогда
			НайденныеСтроки=ТаблицаСоответствий.НайтиСтроки(Новый Структура("ИдентификаторВМодели",СтрокаПараметров.ParamId));
			Если НайденныеСтроки.Количество()>0 Тогда
				СтрокаСоответствий=НайденныеСтроки[0];
			Иначе
				СтрокаСоответствий=ТаблицаСоответствий.Добавить();
				СтрокаСоответствий.ОбъектСтроительства=ОбъектСтроительства;
				СтрокаСоответствий.ИдентификаторВМодели=СтрокаПараметров.ParamId;
				СтрокаСоответствий.ИдентификаторПроекта=ИдентификаторПроекта;
				Если СтрокаПараметров.Свойства().Получить("ParamMaterialId") <> Неопределено Тогда
					СтрокаСоответствий.ИдентификаторРесурса=СтрокаПараметров.ParamMaterialId;
					СтрокаСоответствий.ЯвляетсяРесурсом = ЗначениеЗаполнено(СтрокаПараметров.ParamMaterialId);
				КонецЕсли;
			КонецЕсли;
			ТекущийИдентификатор=СтрокаПараметров.ParamId;
		КонецЕсли;
		
		
		
		Если СтрокаПараметров.ParamName="Shifr" Тогда
			СтрокаСоответствий.Шифр=СтрокаПараметров.ParamValue;	
		ИначеЕсли СтрокаПараметров.ParamName="Book" Тогда
			СтрокаСоответствий.ТипНормативногоСборника=НайтиТипСборника(СтрокаПараметров.ParamValue);
		ИначеЕсли СтрокаПараметров.ParamName="ShifrParent" Тогда
			СтрокаСоответствий.ШифрРодителя=СтрокаПараметров.ParamValue;	
		ИначеЕсли СтрокаПараметров.ParamName="BookParent" Тогда
			СтрокаСоответствий.ТипНормативногоСборникаРодителя=НайтиТипСборника(СтрокаПараметров.ParamValue);
		ИначеЕсли СтрокаПараметров.ParamName="CalcParam" Тогда
			СтрокаСоответствий.ПоказательДляРасчета=СтрокаПараметров.ParamValue;	 
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаСоответствий;
	
КонецФункции

Функция ПреобразоватьХарактеристикиВТаблицуЗначений(ОбъектСтроительства,bimRequestList,ИдентификаторПроекта)
	
	ТаблицаХарактеристик=Новый ТаблицаЗначений;
	ТаблицаХарактеристик.Колонки.Добавить("ОбъектСтроительства",Новый ОписаниеТипов("СправочникСсылка.СМ_ОбъектыСтроительства"));
	ТаблицаХарактеристик.Колонки.Добавить("ИдентификаторВМодели",ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаХарактеристик.Колонки.Добавить("ИдентификаторРесурса",ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаХарактеристик.Колонки.Добавить("ПоказательДляРасчета",ОбщегоНазначения.ОписаниеТипаСтрока(300));
	ТаблицаХарактеристик.Колонки.Добавить("Значение",ОбщегоНазначения.ОписаниеТипаСтрока(250));
	ТаблицаХарактеристик.Колонки.Добавить("ЗначениеЧислом",ОбщегоНазначения.ОписаниеТипаЧисло(18,2));
	ТаблицаХарактеристик.Колонки.Добавить("ЗначениеСсылка",Новый ОписаниеТипов("СправочникСсылка.СМ_BIM_ТипыКонструктивов"));
	ТаблицаХарактеристик.Колонки.Добавить("ИдентификаторПроекта",ОбщегоНазначения.ОписаниеТипаСтрока(50));
	
	Для Каждого СтрокаПараметров Из bimRequestList Цикл
		
		СтрокаСоответствий=ТаблицаХарактеристик.Добавить();
		СтрокаСоответствий.ОбъектСтроительства=ОбъектСтроительства;
		СтрокаСоответствий.ИдентификаторВМодели=СтрокаПараметров.ParamId;
		СтрокаСоответствий.ИдентификаторРесурса=СтрокаПараметров.ParamMaterialId;
		СтрокаСоответствий.ПоказательДляРасчета=СтрокаПараметров.ParamName;
		СтрокаСоответствий.ЗначениеСсылка=Справочники.СМ_BIM_ТипыКонструктивов.ПустаяСсылка();
		Если ВРег(СтрокаПараметров.ParamName)="TYPE" Тогда
			СтрокаСоответствий.Значение=СтрокаПараметров.ParamValue;
			СтрокаЗначение = СМ_BIM_ВызовСервера.ПреобразоватьИмяКонструктива(СтрокаПараметров.ParamValue);
			СтрокаСоответствий.ЗначениеСсылка = СМ_BIM_ВызовСервера.НайтиСоздатьТипКонструктива(СтрокаЗначение);
		Иначе
			СтрокаСоответствий.Значение=СтрокаПараметров.ParamValue;
		КонецЕсли;
		СтрокаСоответствий.ЗначениеЧислом=СтрокаПараметров.ParamValue;
		СтрокаСоответствий.ИдентификаторПроекта=ИдентификаторПроекта;
		
	КонецЦикла;
	
	Возврат  ТаблицаХарактеристик;
	
КонецФункции        

#КонецОбласти