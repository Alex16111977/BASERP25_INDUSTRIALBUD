Функция ПолучитьМакетДляПоиска(Условие)
	
	СКД = Новый СхемаКомпоновкиДанных; 
	Источник = СКД.ИсточникиДанных.Добавить();
	Источник.Имя = "ЛокальнаяБаза";
	Источник.СтрокаСоединения = "";
	Источник.ТипИсточникаДанных = "Local"; 
	
	НаборДанных = СКД.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "Поиск";
	НаборДанных.ИсточникДанных = "ЛокальнаяБаза";
	НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;
	
	НаборДанных.Запрос = ("ВЫБРАТЬ
	|	СМ_НормативныеСборники.Ссылка КАК Code,
	|	СМ_НормативныеСборники.Наименование КАК Name,
	|	СМ_НормативныеСборники.Родитель КАК StGroup,
	|	ЕСТЬNULL(СМ_НормативныеСборники.ЕдиницаИзмерения.Наименование, """") КАК Metric,
	|	ЕСТЬNULL(СМ_НормативныеСборники.КодНормативнойРасценки, """") КАК Key,
	|	СМ_НормативныеСборники.ТипНормативногоСборника
	|ИЗ
	|	Справочник.СМ_НормативныеСборники КАК СМ_НормативныеСборники
	|ГДЕ
	|	НЕ СМ_НормативныеСборники.ПометкаУдаления "+Условие);
	
	НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;
	
	НастройкиСКД = СКД.НастройкиПоУмолчанию;
	
	Группировка1     = НастройкиСКД.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Группировка1.Имя = "НС";
	
	ПолеГруппировки                = Группировка1.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));       
	ПолеГруппировки.Поле           = Новый ПолеКомпоновкиДанных("Code");
	ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Иерархия;
	ПолеГруппировки.ТипДополнения  = ТипДополненияПериодаКомпоновкиДанных.БезДополнения;
	
	ПолеГруппировки                = Группировка1.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));       
	ПолеГруппировки.Поле           = Новый ПолеКомпоновкиДанных("Name");
	ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
	ПолеГруппировки.ТипДополнения  = ТипДополненияПериодаКомпоновкиДанных.БезДополнения;
	
	ПолеГруппировки                = Группировка1.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));       
	ПолеГруппировки.Поле           = Новый ПолеКомпоновкиДанных("StGroup");
	ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
	ПолеГруппировки.ТипДополнения  = ТипДополненияПериодаКомпоновкиДанных.БезДополнения;
	
	ПолеГруппировки                = Группировка1.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));       
	ПолеГруппировки.Поле           = Новый ПолеКомпоновкиДанных("Metric");
	ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
	ПолеГруппировки.ТипДополнения  = ТипДополненияПериодаКомпоновкиДанных.БезДополнения;
	
	ПолеГруппировки                = Группировка1.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));       
	ПолеГруппировки.Поле           = Новый ПолеКомпоновкиДанных("Key");
	ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
	ПолеГруппировки.ТипДополнения  = ТипДополненияПериодаКомпоновкиДанных.БезДополнения;
	
	ПолеГруппировки                = Группировка1.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));       
	ПолеГруппировки.Поле           = Новый ПолеКомпоновкиДанных("ТипНормативногоСборника");
	ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
	ПолеГруппировки.ТипДополнения  = ТипДополненияПериодаКомпоновкиДанных.БезДополнения;
	
	ВыбранноеАвтоПоле = Группировка1.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));     
	ВыбранноеАвтоПоле.Использование = Истина;
	
	Возврат СКД;
