	кОткрытьФормуДопСвойств.Подсказка = "Открыть форму дополнительных реквизитов модуля ""Управление автотранспортом"".";
	
	ЭлементКнопкаФормаУАТТС = Форма.Элементы.Добавить("_уатГруппаДопСвойствТСКнопка", Тип("КнопкаФормы"), ЭлементГруппаФормаУАТТС);
	ЭлементКнопкаФормаУАТТС.ИмяКоманды = "_уатФормаДопСвойствТС";
	
	// Определение поведения элемента при копировании.
	Если Форма.Параметры.Свойство("ЗначениеКопирования") И ЗначениеЗаполнено(Форма.Параметры.ЗначениеКопирования) Тогда 
