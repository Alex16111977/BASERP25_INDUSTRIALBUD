	ЭлементКнНастроитьШаблон.ИмяКоманды = "_уатТранспортныеСредстваНастроитьШаблон";
	
	кСформироватьНаименование = Форма.Команды.Добавить("_уатТранспортныеСредстваСформироватьНаименование");
