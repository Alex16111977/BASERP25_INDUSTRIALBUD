// Обновляет дерево значений (составляющие смету позиции и разделы) в документе Локальная смета.
//
// Параметры:
//     ОбъектДанных 		- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на локальную смету.
//     ДеревоЗначений 		- ДеревоЗначений - дерево, которое строится.
//     ОбъектАкт 			- ДокументСсылка.СМ_АктВыполненныхРабот - если формируется дерево акта,
//                            то ссылка на акт передается в данном параметре.
//     НеОбновлятьОбъект 	- Булево - если Ложь - то происходит пересчет факт объемов позиций акта
//                                     или заполнение индексов пересчета разделов и позиций акта.
//     ИзмененныйОбъект     - ДокументСсылка - ссылка на измененый в дереве объект (если не заполнен - обновляем все).
//
Процедура ВывестиОбновитьДерево(ОбъектДанных, ДеревоЗначений, ОбъектАкт = Неопределено, НеОбновлятьОбъект = Истина, ИзмененныйОбъект = Неопределено) Экспорт
	
	ПолучениеЗапросаИОбработкаДанныхДерева(ОбъектДанных,ДеревоЗначений,  "Обновить"+?(НеОбновлятьОбъект,"БезТаблицАкта",""), ОбъектАкт, , ИзмененныйОбъект);
	
КонецПроцедуры

// Обновляет дерево значений (составляющие позиции и разделы) и процентует Акт выполненных работ.
//
// Параметры:
//     ДеревоЗначений 		- ДеревоЗначений - дерево, которое строится.
//     ОбъектСмета 			- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на локальную смету.
//     ОбъектАкт 			- ДокументСсылка.СМ_АктВыполненныхРабот - если формируется дерево акта,
//                            то ссылка на акт передается в данном параметре.
//     СтруктураПараметров  - Структура - содержит дополнительные параметры для процентовки акта
//                            (данные с общей формы СМ_ФормаНачальногоЗаполненияПараметровАкта).
//
Процедура ПроцентоватьОбновитьДеревоАкт(ДеревоЗначений, ОбъектСмета, СтруктураПараметров, ОбъектАкт = Неопределено) Экспорт
	
	ПолучениеЗапросаИОбработкаДанныхДерева(ОбъектСмета,ДеревоЗначений,"Процентовать",ОбъектАкт,СтруктураПараметров);
	
КонецПроцедуры

// Обновляет дерево значений (составляющие позиции и разделы) и заполняет
// акт выполненных работ по остаткам работ (для каждой позиции).
//
// Параметры:
//     ДеревоЗначений 		- ДеревоЗначений - дерево, которое строится.
//     ОбъектСмета 			- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на локальную смету.
//     ОбъектАкт 			- ДокументСсылка.СМ_АктВыполненныхРабот - если формируется дерево акта,
//                            то ссылка на акт передается в данном параметре.
//     СтруктураПараметров  - Структура - содержит дополнительные параметры для процентовки акта
//                            (данные с общей формы СМ_ФормаНачальногоЗаполненияПараметровАкта).
//
Процедура ЗаполнитьПоОстаткамОбновитьДерево(ДеревоЗначений, ОбъектСмета, СтруктураПараметров, ОбъектАкт = Неопределено) Экспорт
	
	ПолучениеЗапросаИОбработкаДанныхДерева( ОбъектСмета,ДеревоЗначений, "ЗаполнитьПоОстаткам", ОбъектАкт,СтруктураПараметров);
	
КонецПроцедуры

// Заполняет новую смету остатками по старой смете.
//
// Параметры:
//     ДеревоЗначений 		- ДеревоЗначений - дерево, которое строится.
//     СтараяСмета 			- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на локальную смету (основание).
//     НоваяСмета 			- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на заполняемую смету.
//
Процедура ЗаполнитьСметуПоОстаткам(ДеревоЗначений, СтараяСмета, НоваяСмета) Экспорт
	
	ЭлементКорня = СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(СтараяСмета); 
	
	Если ДеревоЗначений <> Неопределено Тогда
		Если ДеревоЗначений.Строки.Количество() > 0 Тогда
			ДеревоЗначений.Строки.Очистить();
		КонецЕсли;
	Иначе
		ДеревоЗначений = Новый ДеревоЗначений();
		ДеревоЗначений.Колонки.Добавить("Элемент");
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Текст = ПолучитьТекстЗапросаНаДеревоСмет(, Истина);	
	
	ВыводитьДопРеквизиты = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","СМ_ВыводитьДополнительныеРеквизитыДерево");
	ВыводитьДопРеквизиты = ?(ВыводитьДопРеквизиты = Неопределено,Ложь,ВыводитьДопРеквизиты);
	Если ВыводитьДопРеквизиты Тогда
		СписокРеквизитов = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","СМ_СписокДопРеквизитовДерева");
		
		ЗапросДоп = Новый Запрос;
		ЗапросДоп.Текст = "ВЫБРАТЬ
		|	ДополнительныеРеквизитыИСведения.Ссылка КАК Свойство
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
		|ГДЕ
		|	НЕ ДополнительныеРеквизитыИСведения.ЭтоДополнительноеСведение
		|	И НЕ ДополнительныеРеквизитыИСведения.ПометкаУдаления";
		ТЗ = ЗапросДоп.Выполнить().Выгрузить();
		ТЗ.Колонки.Добавить("ИмяДопРеквизита",Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
		Для Каждого стр Из ТЗ Цикл
			GUID = СМ_ВерсионированиеСервер.ПолучитьGUIDПоУИД(стр.Свойство.УникальныйИдентификатор());
			стр.ИмяДопРеквизита = "ДопРеквизит_"+GUID;
		КонецЦикла;
		
				
		ДопРеквизитСмета = "";
		ДопРеквизитРаздел = "";
		ДопРеквизитПозиция = "";
		ДопУсловиеРаздел = "";
		ДопУсловиеПозиция = "";
		
		сч = 1;
		Для Каждого стр Из ТЗ Цикл
			ДопРеквизитСмета = ДопРеквизитСмета+Символы.ПС +", NULL КАК "+стр.ИмяДопРеквизита;
			ДопРеквизитРаздел = ДопРеквизитРаздел+Символы.ПС +", СМ_РазделЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Значение";
			ДопРеквизитПозиция = ДопРеквизитПозиция+Символы.ПС +", СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Значение";
			
			ДопУсловиеРаздел = ДопУсловиеРаздел+Символы.ПС +" ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_РазделЛокальнойСметы.ДополнительныеРеквизиты КАК СМ_РазделЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+"	ПО (РазделЛокальнойСметыДок.Ссылка = СМ_РазделЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Ссылка
			|				И СМ_РазделЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Свойство = &Свойство"+Строка(сч)+")";
			
			ДопУсловиеПозиция = ДопУсловиеПозиция+Символы.ПС +" ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_ПозицияЛокальнойСметы.ДополнительныеРеквизиты КАК СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+" ПО (ПозицияЛокальнойСметыДок.Ссылка = СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Ссылка
			|				И СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Свойство = &Свойство"+Строка(сч)+")";
			Запрос.УстановитьПараметр("Свойство"+Строка(сч),стр.Свойство);
			сч = сч+1;
		КонецЦикла;
		
		Текст = СтрЗаменить(Текст,"[ДопРеквизитСмета]",ДопРеквизитСмета);
		Текст = СтрЗаменить(Текст,"[ДопРеквизитРаздел]",ДопРеквизитРаздел);
		Текст = СтрЗаменить(Текст,"[ДопРеквизитПозиция]",ДопРеквизитПозиция);
		Текст = СтрЗаменить(Текст,"[ДопУсловиеРаздел]",ДопУсловиеРаздел);
		Текст = СтрЗаменить(Текст,"[ДопУсловиеПозиция]",ДопУсловиеПозиция);

	Иначе
		Текст = СтрЗаменить(Текст,"[ДопРеквизитСмета]","");
		Текст = СтрЗаменить(Текст,"[ДопРеквизитРаздел]","");
		Текст = СтрЗаменить(Текст,"[ДопРеквизитПозиция]","");
		Текст = СтрЗаменить(Текст,"[ДопУсловиеРаздел]","");
		Текст = СтрЗаменить(Текст,"[ДопУсловиеПозиция]","");
	КонецЕсли;
	
	Запрос.Текст = Текст;	
	Запрос.УстановитьПараметр("Ссылка",ЭлементКорня);
	Запрос.УстановитьПараметр("ИтогРаздела",Справочники.СМ_ИтогиПоРазделу.ИтогоПоРазделу);
	
	ИтогПоСмете = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ИтогСметыДляДерева");
	Если Не ИтогПоСмете = Неопределено
		И ИтогПоСмете.Пустая() Тогда
		ИтогПоСмете = Справочники.СМ_ИтогиПоГлавам.НайтиПоРеквизиту("Идентификатор","ИП4");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ИтогСметы",ИтогПоСмете);
	Запрос.УстановитьПараметр("ВидРасценкиОборудование", Перечисления.СМ_ВидыРасценки.Оборудование);
	Запрос.УстановитьПараметр("ВидРасценкиМатериал", Перечисления.СМ_ВидыРасценки.Материал);
	Запрос.УстановитьПараметр("ЭтоАкт", Ложь);
	Запрос.УстановитьПараметр("АктВыполненныхРабот", Документы.СМ_АктВыполненныхРабот.ПустаяСсылка());
	
	//	параметры, для запроса фактического объема
	Если ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","НеДобавлятьВКорректировкуПозицииСНулевымиОбъемами",Ложь) тогда
		Запрос.УстановитьПараметр("ЛС",СтараяСмета);
		Запрос.УстановитьПараметр("БезПозиций", Истина);
		Запрос.УстановитьПараметр("МассивПозиций",Неопределено);
	КонецЕсли;
		
	ТабДерева = Запрос.Выполнить().Выгрузить();
	
	//	избавимся от пустых разделов
	Если ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","НеДобавлятьВКорректировкуПозицииСНулевымиОбъемами",Ложь) тогда
		
		//
		врДерево	= СформироватьДеревоСметаНаОстаткиВременная(ТабДерева);
		
		//
		УдалитьПустыеРазделы(врДерево.Строки, ТабДерева, 0);
		
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("ОтображатьПрефиксы", ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОтображатьПрефиксы",Ложь));
	СтруктураПараметров.Вставить("Вид");
	// Вопрос определения, откуда идет вызов. Так вроде не очень корректно.
	// М.б. параметр в функцию ВывестиОбновитьДерево2.
	Если ДеревоЗначений.Колонки.Найти("НаименованиеЭлемента") <> Неопределено Тогда  
		СтруктураПараметров.Вставить("Вид","ГрупповаяОбработкаПозиций");
	КонецЕсли;
	
	СМ_СметаВызовСервера.СкопироватьОбъектыСметаНаОстаток(ТабДерева,НоваяСмета.Ссылка);
	ДеревоЗначений.Колонки.Добавить("СтараяСсылка");
	ТабВыполнения = ПолучитьВыполнениеСметы(СтараяСмета,Документы.СМ_АктВыполненныхРабот.ПустаяСсылка());
	СтруктураПараметров.Вставить("ВыполнениеСметы",ТабВыполнения);
	Отбор = Новый Структура();
	Отбор.Вставить("ИдСметы", Неопределено);
	
	ВывестиДеревоПоТаблице(ДеревоЗначений,ТабДерева,Отбор,СтараяСмета,НоваяСмета,СтруктураПараметров,"СметаНаОстаток");

	ПеренумероватьДерево(НоваяСмета);
	Документы.СМ_ЛокальнаяСмета.Перерасчет(НоваяСмета,Ложь);

КонецПроцедуры

// Формирует дерево смет на остатки.
//
// Параметры:
//     ТабДерева - результат запроса.
//
// Возвращаемое значение:
//     ДеревоЗначений - сформированное из результата запроса, дерево смет.
//
Функция СформироватьДеревоСметаНаОстаткиВременная(ТабДерева)
	
	врДерево	= Новый ДеревоЗначений;
	врДерево.Колонки.Добавить("ТипСтроки");
	врДерево.Колонки.Добавить("ИДРодителя");
	врДерево.Колонки.Добавить("Ссылка");
	врДерево.Колонки.Добавить("СсылкаНаСтроку");
	
	Для каждого Строка из ТабДерева Цикл
		
		Если Строка.ТипСтроки = 0 тогда //	смета
			врСтрока	= врДерево.Строки.Добавить();	
		ИначеЕсли Строка.ТипСтроки = 1 ИЛИ //	раздел или позиция
			Строка.ТипСтроки = 2 тогда
			
			найдРодители	= врДерево.Строки.НайтиСтроки(Новый Структура("Ссылка", Строка.ИДРодителя), Истина);
			Если найдРодители.Количество() тогда
				врСтрока	= найдРодители[0].Строки.Добавить();	
			Иначе
				врСтрока	= врДерево.Строки.Добавить();	
			КонецЕсли;
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		врСтрока.ТипСтроки		= Строка.ТипСтроки;
		врСтрока.ИДРодителя		= Строка.ИДРодителя;
		врСтрока.Ссылка			= Строка.Ссылка;
		врСтрока.СсылкаНаСтроку	= Строка;
			
	КонецЦикла;
	
	Возврат врДерево;
	
КонецФункции

// Удаляет все пустые разделы.
//
// Параметры:
//     врДеревоСтроки			- сформированное дерево значений из результата запроса.
//     ТабДерева	 			- результат запроса.
//     ТекущийИндексРодителя   	- текущий индекс родительской строки в дереве.
//
// Возвращаемое значение:
//     Число - возращаем ТекущийИндексРодителя-1, если удалили родительскую строку.
//
Функция УдалитьПустыеРазделы(врДеревоСтроки, ТабДерева, ТекущийИндексРодителя)
	
	РодительУдаленнойСтроки	= Неопределено;
	Для ТекИндекс = 0 по врДеревоСтроки.Количество()-1 Цикл
		
		// Прекратим цикл, если где-то ошиблись с установкой индекса
		Если НЕ врДеревоСтроки.Количество() ИЛИ ТекИндекс >= врДеревоСтроки.Количество() тогда
			Возврат ТекущийИндексРодителя;
		КонецЕсли;
		
		Строка						= врДеревоСтроки[ТекИндекс];
		СтрокаРодитель				= Строка.Родитель;
		ТекущийИндекс				= ТекИндекс;
		ЭтоПоследняяСтрокаУровня	= (ТекИндекс = врДеревоСтроки.Количество()-1);
		
		// Последнее вложение, в этой ветке
		Если НЕ Строка.Строки.Количество() тогда
			
			// если это раздел
			Если Строка.ТипСтроки = 1 тогда
				
				// удалить строку в создаваемом документе
				ТабДерева.Удалить(Строка.СсылкаНаСтроку);
				
				// удалить строку в дереве (нужно, что бы потом проверить на "пусто").
				РодительУдаленнойСтроки	= Строка.Родитель;
			    РодительУдаленнойСтроки.Строки.Удалить(Строка);
				
				// удалили строку = уменьшили индекс
				ТекИндекс = ТекИндекс - 1;
				
			КонецЕсли;
			
			//	последний элемент, на этом уровне
			Если ЭтоПоследняяСтрокаУровня тогда
				
				Если НЕ СтрокаРодитель.Строки.Количество() тогда
					
					// удалить строку в создаваемом документе
					ТабДерева.Удалить(СтрокаРодитель.СсылкаНаСтроку);
					
					// удалить родителя в дереве
					СтрокаРодитель.Родитель.Строки.Удалить(СтрокаРодитель);
					
					// удалили родителя = уменьшили индекс
					Возврат ТекущийИндексРодителя-1;
					
				Иначе
					
					Возврат ТекущийИндексРодителя;
					
				КонецЕсли;
				
			КонецЕсли;
		//	рекурсия
		Иначе 
			// Если перебор вложенных элементов заканчивается, возвращается "неопределено".
			ТекИндекс1 = УдалитьПустыеРазделы(Строка.Строки, ТабДерева, ТекущийИндекс);
			Если НЕ ТекИндекс1 = Неопределено тогда
				ТекИндекс = ТекИндекс1;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
		
КонецФункции

// Обновляет дерево и перенумеровывает все позиции в локальной смете.
//
// Параметры:
//     ОбъектДанных			- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на локальную смету.
//     ДеревоЗначений 		- ДеревоЗначений - дерево, которое строится.
//     ИзмененныйОбъект     - ДокументСсылка - ссылка на измененый в дереве объект (если не заполнен - обновляем все).
//     НомерПересчета       - Число - номер, с которого нумеруем.
//                          
Процедура ПеренумероватьОбновитьДерево(ОбъектДанных, ДеревоЗначений, ИзмененныйОбъект = Неопределено, НомерПересчета = 0) Экспорт
	
	ПолучениеЗапросаИОбработкаДанныхДерева(ОбъектДанных,ДеревоЗначений,  "Перенумеровать", , , ИзмененныйОбъект, НомерПересчета);
	
КонецПроцедуры

// Перенумеровывает все позиции в ЛС. но дерево не обновляет.
//
// Параметры:
//     ОбъектДанных			- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на локальную смету.
//     ИзмененныйОбъект     - ДокументСсылка - ссылка на измененый в дереве объект (если не заполнен - обновляем все).
//     НомерПересчета       - Число - номер, с которого нумеруем.
//     
Процедура ПеренумероватьДерево(ОбъектДанных, ИзмененныйОбъект = Неопределено, НомерПересчета = 0) Экспорт
	
	ПолучениеЗапросаИОбработкаДанныхДерева(ОбъектДанных,,  "ПеренумероватьБезОбновления", , , ИзмененныйОбъект, НомерПересчета);
	
КонецПроцедуры

#КонецОбласти 

#Область Перенумерация

// Возвращает максимальный номер в разделе (если параметр раздел заполнен) или смете.
//
// Параметры:
//     Смета  - ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на локальную смету.
//     Раздел - ДокументСсылка.СМ_РазделЛокальнойСметы -  ссылка на раздел
//              (если заполнен, то ищется номер в пределах раздела).
//	   ИДПозицииВладельца - ДокументСсылка.СМ_ПозицияЛокальнойСметы - ссылка на позицию-владельца.
//							Если заполнена, то действует дополнительный отбор по позиции-владельцу.
//
// Возвращаемое значение:
//     Результат - Число - содержит максимальный порядковый номер позиции.
//
Функция ПолучитьМаксимальныйНомерВДереве(Смета, Раздел = Неопределено, ИДПозицииВладельца = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МАКСИМУМ(ПозицияЛокальнойСметы.НомерВДереве) КАК НомерВДереве
				   //|ПОМЕСТИТЬ РазделыИПозиции
	               |ИЗ
	               |	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК ПозицияЛокальнойСметы
	               |ГДЕ
	               |	ПозицияЛокальнойСметы.Смета = &ИДСметы                                                 
	               |	" + 
				   	?(Раздел = Неопределено, ""," И (ПозицияЛокальнойСметы.Раздел = &ИДРодителя ИЛИ ПозицияЛокальнойСметы.Раздел.ИДРодителя = &ИДРодителя) ") + 
					?(ИДПозицииВладельца = Неопределено, ""," И (ПозицияЛокальнойСметы.Позиция.ИДПозицииВладельца = &ИДПозицииВладельца ИЛИ ПозицияЛокальнойСметы.Позиция = &ИДПозицииВладельца) ");

	
	//Запрос.Текст = Запрос.Текст + "ОБЪЕДИНИТЬ ВСЕ
	//|ВЫБРАТЬ
	//|	МАКСИМУМ(РазделЛокальнойСметы.НомерВДереве)
	//|ИЗ
	//|	Документ.СМ_РазделЛокальнойСметы КАК РазделЛокальнойСметы
	//|ГДЕ
	//|	РазделЛокальнойСметы.ИДСметы = &ИДСметы " + ?(Раздел = Неопределено, ""," И РазделЛокальнойСметы.ИДРодителя = &ИДРодителя");
	
	//Запрос.Текст = Запрос.Текст + " 
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	МАКСИМУМ(РазделыИПозиции.НомерВДереве) КАК НомерВДереве
	//|ИЗ
	//|	РазделыИПозиции КАК РазделыИПозиции";
	
	Запрос.УстановитьПараметр("ИДСметы", СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(Смета, "СМ_ЛокальнаяСмета"));
	Если (Раздел <> Неопределено) Тогда
		Запрос.УстановитьПараметр("ИДРодителя", СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(Раздел, "СМ_РазделЛокальнойСметы"));
	КонецЕсли;
	
	Если (ИДПозицииВладельца <> Неопределено) Тогда
		Запрос.УстановитьПараметр("ИДПозицииВладельца", СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(ИДПозицииВладельца, "СМ_ПозицияЛокальнойСметы"));
	КонецЕсли;

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
