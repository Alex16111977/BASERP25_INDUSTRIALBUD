	|			РегистрСведений.СМ_ИтогиПоГлавамОС КАК СМ_ИтогиПоГлавам
	|		ГДЕ
	|			СМ_ИтогиПоГлавам.Итог ССЫЛКА Справочник.СМ_ЛимитированныеЗатраты  
	|			И СМ_ИтогиПоГлавам.Смета ССЫЛКА Документ.СМ_ОбъектнаяСмета 
	|			И СМ_ИтогиПоГлавам.Смета В (&МассивСмет)
	|		СГРУППИРОВАТЬ ПО 
	|			СМ_ИтогиПоГлавам.Смета, 
	|           СМ_ИтогиПоГлавам.Итог) КАК ИтогЛЗпоОС		
	|	ПО СМ_ОбъектнаяСметаЛимитированныеЗатраты.Ссылка = ИтогЛЗпоОС.Смета   
	|     И СМ_ОбъектнаяСметаЛимитированныеЗатраты.ЛимитированнаяЗатрата = ИтогЛЗпоОС.Итог
	|
	|ГДЕ
	|	СМ_ОбъектнаяСметаЛимитированныеЗатраты.Ссылка В (&МассивСмет) 
	|	И СМ_ОбъектнаяСметаЛимитированныеЗатраты.Расчет = ИСТИНА 
	|
	|УПОРЯДОЧИТЬ ПО 
	|	ПорядковыйНомерГлавы,Итог,ТекПозиция,ИДродителя";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТипСтроительства",ТипСтроительства);
	Запрос.УстановитьПараметр("СсылкаСС",СсылкаСС);
	Запрос.УстановитьПараметр("СтроитРаботы",Справочники.СМ_ИтогиСметыПоВидамРабот.СтроитРаб);
	Запрос.УстановитьПараметр("Металлоконстр",Справочники.СМ_ИтогиСметыПоВидамРабот.Металлоконстр);
	Запрос.УстановитьПараметр("СантехнРаб",Справочники.СМ_ИтогиСметыПоВидамРабот.СантехнРаб);
	Запрос.УстановитьПараметр("БуровзрывнРаб",Справочники.СМ_ИтогиСметыПоВидамРабот.БуровзрывнРаб);
	Запрос.УстановитьПараметр("ГорнопрохРаб",Справочники.СМ_ИтогиСметыПоВидамРабот.ГорнопрохРаб);
	Запрос.УстановитьПараметр("МонтажнРаб",Справочники.СМ_ИтогиСметыПоВидамРабот.МонтажнРаб);
	Запрос.УстановитьПараметр("Оборудование",Справочники.СМ_ИтогиСметыПоВидамРабот.Оборуд);
	Запрос.УстановитьПараметр("Прочие",Справочники.СМ_ИтогиСметыПоВидамРабот.ПрочРаб);
	Запрос.УстановитьПараметр("МассивСмет",МассивСмет);
	Запрос.УстановитьПараметр("МассивЛимЗатрат",МассивЛЗ);
	Запрос.УстановитьПараметр("ПустаяГлава",Справочники.СМ_ГлавыССРС.ПустаяСсылка());
	Запрос.УстановитьПараметр("Методика",Методика);


	ИтогПоГлавеОС = Справочники.СМ_ИтогиПоГлавам.НайтиПоРеквизиту("Идентификатор","ИП4");
	ИтогоПоСмете = Справочники.СМ_ИтогиПоГлавам.НайтиПоРеквизиту("Идентификатор","ИП2");
	Запрос.УстановитьПараметр("ИтогПоГлавеОС",			ИтогПоГлавеОС);
	Запрос.УстановитьПараметр("ИтогоПоСмете",			ИтогоПоСмете);
	Запрос.УстановитьПараметр("ВидРаботСтроитРаботы",	Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы); 
	Запрос.УстановитьПараметр("ВидРаботМеталлоконстр",	Перечисления.СМ_ВидыЗатратСмета.МеталломонтажныеРаботы); 
	Запрос.УстановитьПараметр("ВидРаботСантехнРаб",		Перечисления.СМ_ВидыЗатратСмета.СантехническиеРаботы); 
	Запрос.УстановитьПараметр("ВидРаботБуровзрывнРаб",	Перечисления.СМ_ВидыЗатратСмета.БуровзрывныеРаботы); 
	Запрос.УстановитьПараметр("ВидРаботГорнопрохРаб",	Перечисления.СМ_ВидыЗатратСмета.ГорнопроходческиеРаботы);
	Запрос.УстановитьПараметр("ВидРаботМонтажнРаб",		Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы);
	Запрос.УстановитьПараметр("ВидРаботОборудование",	Перечисления.СМ_ВидыЗатратСмета.Оборудование);
	Запрос.УстановитьПараметр("ВидРаботПрочие",			Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы);

	ТабРезультат = Запрос.Выполнить().Выгрузить();
	ТабРезультат.Свернуть("Глава,НомерГлавы,ПорядковыйНомерГлавы,ТипСтроительства, НаименованиеГлавы,Итог,НаименованиеИтога,ПорядковыйНомерИтога,Элемент,ИДродителя,Расчет","СтроительныеРаботы,МонтажныеРаботы,Оборудование,Прочие,ОплатаТруда,ТекПозиция");
	
	Возврат ТабРезультат;
	
КонецФункции

// Функция формирует таблицу с главами ССРС сводной сметы.
//
Функция ПолучитьИтогиПоГлавам(Методика)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ИтогиПоГлавам.Ссылка,
	               |	СМ_ИтогиПоГлавам.ВерсияДанных,
	               |	СМ_ИтогиПоГлавам.ПометкаУдаления,
	               |	СМ_ИтогиПоГлавам.Код,
	               |	СМ_ИтогиПоГлавам.Наименование,
	               |	СМ_ИтогиПоГлавам.Идентификатор,
	               |	СМ_ИтогиПоГлавам.ГлаваССРС,
	               |	СМ_ИтогиПоГлавам.ГлаваРемонт,
	               |	СМ_ИтогиПоГлавам.НаименованиеРемонт,
	               |	СМ_ИтогиПоГлавам.Накопительный,
	               |	СМ_ИтогиПоГлавам.ПорядковыйНомер,
	               |	СМ_ИтогиПоГлавам.ВыводитьНаПечать,
	               |	СМ_ИтогиПоГлавам.Предопределенный,
	               |	СМ_ИтогиПоГлавам.ИмяПредопределенныхДанных,
	               |	СМ_ИтогиПоГлавам.Представление
	               |ИЗ
	               |	Справочник.СМ_ИтогиПоГлавам КАК СМ_ИтогиПоГлавам
	               |ГДЕ
	               |	(СМ_ИтогиПоГлавам.МетодикаРасчета = &Методика
	               |			ИЛИ СМ_ИтогиПоГлавам.МетодикаРасчета = ЗНАЧЕНИЕ(Справочник.СМ_МетодикиРасчета.ПустаяСсылка))";
	Запрос.УстановитьПараметр("Методика", Методика);
	ТабИтогов = Запрос.Выполнить().Выгрузить();
	Возврат ТабИтогов;
	
КонецФункции

#КонецОбласти

#Область РаботаСДеревомОС

// Функция формирует таблицу с итоговыми значениями лим затрат объектной сметы.
//
Функция ПолучитьИтогиПоЛимЗатратам(ТекОС, МассивЛЗ ,ВТекущихЦенах)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СМ_ЛимитированныеЗатраты.Ссылка КАК ЛимитированнаяЗатрата,
	|	ЗапросИтоги.Смета,
	|СУММА(ЕСТЬNULL(ВЫБОР 
	|	КОГДА ЗапросИтоги.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы) 
	|	      ИЛИ ЗапросИтоги.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.МеталломонтажныеРаботы) 
	|		  ИЛИ ЗапросИтоги.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.БуровзрывныеРаботы) 
	|		  ИЛИ ЗапросИтоги.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.СантехническиеРаботы) 
	|		  ИЛИ ЗапросИтоги.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.ГорнопроходческиеРаботы) ТОГДА
	|	ЗапросИтоги." + ?(ВТекущихЦенах,"Тек","") + "ПрямЗатраты ИНАЧЕ 0 КОНЕЦ,0)) КАК СтроительныеРаботы, 	  
	|СУММА(ЕСТЬNULL(ВЫБОР 
	|	КОГДА ЗапросИтоги.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.МонтажныеРаботы) ТОГДА 
	|		ЗапросИтоги." + ?(ВТекущихЦенах,"Тек","") + "ПрямЗатраты 
	|	ИНАЧЕ 0 КОНЕЦ,0)) КАК МонтажныеРаботы, 	  
	|СУММА(ЕСТЬNULL(ВЫБОР 
	|	КОГДА ЗапросИтоги.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.Оборудование) ТОГДА 
	|		ЗапросИтоги." + ?(ВТекущихЦенах,"Тек","") + "Оборуд 
	|	ИНАЧЕ 0 КОНЕЦ,0)) КАК Оборудование,  
	|СУММА(ЕСТЬNULL(ВЫБОР 
	|	КОГДА ЗапросИтоги.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.ПрочиеРаботы) ТОГДА 
	|		ЗапросИтоги." + ?(ВТекущихЦенах,"Тек","") + "ПрямЗатраты 
	|	ИНАЧЕ 0 КОНЕЦ,0)) КАК Прочие, 			
	|СУММА(ЕСТЬNULL(ЗапросИтоги." + ?(ВТекущихЦенах,"Тек","") + "ОснЗарплата,0) + ЕСТЬNULL(ЗапросИтоги." + ?(ВТекущихЦенах,"Тек","") + "ЗарплМашин,0)) КАК ОплатаТруда 				
	|ИЗ
	|	Справочник.СМ_ЛимитированныеЗатраты КАК СМ_ЛимитированныеЗатраты 
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ 
	|
	|	(ВЫБРАТЬ
	|		СМ_ИтогиПоГлавамОС.Смета,
	|		СМ_ИтогиПоГлавамОС.Глава,
	|		СМ_ИтогиПоГлавамОС.Итог,
	|		СМ_ИтогиПоГлавамОС.ВидРабот,
	|		СМ_ИтогиПоГлавамОС.ПрямЗатраты,
	|		СМ_ИтогиПоГлавамОС.ОснЗарплата,
	|		СМ_ИтогиПоГлавамОС.ЭксплМашин,
	|		СМ_ИтогиПоГлавамОС.ЗарплМашин,
	|		СМ_ИтогиПоГлавамОС.СтоимМатер,
	|		СМ_ИтогиПоГлавамОС.Оборуд,
	|		СМ_ИтогиПоГлавамОС.ВозвратМатер,
	|		СМ_ИтогиПоГлавамОС.ЗатратыТрудаРабочих,
	|		СМ_ИтогиПоГлавамОС.ЗатратыТрудаМашин,
	|		СМ_ИтогиПоГлавамОС.ТекПрямЗатраты,
	|		СМ_ИтогиПоГлавамОС.ТекОснЗарплата,
	|		СМ_ИтогиПоГлавамОС.ТекЭксплМашин,
	|		СМ_ИтогиПоГлавамОС.ТекЗарплМашин,
	|		СМ_ИтогиПоГлавамОС.ТекСтоимМатер,
	|		СМ_ИтогиПоГлавамОС.ТекОборуд,
	|		СМ_ИтогиПоГлавамОС.ТекВозвратМатер
	|	ИЗ
	|		РегистрСведений.СМ_ИтогиПоГлавамОС КАК СМ_ИтогиПоГлавамОС
	|	ГДЕ
	|		СМ_ИтогиПоГлавамОС.Смета = &ТекОС) КАК ЗапросИтоги
	|ПО 
	|	СМ_ЛимитированныеЗатраты.Ссылка = ЗапросИтоги.Итог 
	|ГДЕ
	|	СМ_ЛимитированныеЗатраты.Ссылка В (&МассивЛЗ)   
	|СГРУППИРОВАТЬ ПО 
	|	ЗапросИтоги.Смета,
	|	СМ_ЛимитированныеЗатраты.Ссылка";
	
	Запрос.УстановитьПараметр("МассивЛЗ",МассивЛЗ);
	Запрос.УстановитьПараметр("ТекОС",ТекОС);
	
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабРезультат;
	
КонецФункции

#КонецОбласти

#Область ДеревоКорректировок

// Функция формирует дерево корректировок сметы.
//
Функция ПолучитьДеревоКорректировок(Смета,СписокСмет = Неопределено) Экспорт
	
	Если СписокСмет = Неопределено Тогда
		СписокСмет = Новый СписокЗначений;
	КонецЕсли;
	СписокСмет.Добавить(Смета);
	
	Дерево = Новый ДеревоЗначений;	
	Дерево.Колонки.Добавить("Смета");
	Дерево.Колонки.Добавить("Прототип");	
	Дерево.Колонки.Добавить("Элемент");
	Дерево.Колонки.Добавить("Коррекция");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ЛокальнаяСмета.Ссылка
	               |ИЗ
	               |	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	               |ГДЕ
	               |	СМ_ЛокальнаяСмета.КорректируетСмету = &Смета
	               |	И СМ_ЛокальнаяСмета.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СМ_ЛокальнаяСмета.МоментВремени";
    Запрос.УстановитьПараметр("Смета",Смета);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаДерева = Дерево.Строки.Добавить();
		СтрокаДерева.Смета = Смета;
		СтрокаДерева.Коррекция = Выборка.Ссылка;
		СписокСмет.Добавить(Выборка.Ссылка);
		ПолучитьРазделыИПозиции(СтрокаДерева.Коррекция,СтрокаДерева,Дерево);
		ПолучитьКорректировки(Смета,СтрокаДерева.Коррекция,СтрокаДерева,Дерево,СписокСмет);
	КонецЦикла;
	
	Возврат Дерево;
	
КонецФункции

// Функция формирует таблицу корректировок сметы.
//
Функция ПолучитьТаблицуКорректировок(Смета,СписокСмет = Неопределено,Таблица = Неопределено) Экспорт
	
	Если СписокСмет = Неопределено Тогда
		СписокСмет = Новый СписокЗначений;
	КонецЕсли;
	СписокСмет.Добавить(Смета);
	
	Если Таблица = Неопределено Тогда
		Таблица = Новый ТаблицаЗначений;	
		Таблица.Колонки.Добавить("Смета");
		Таблица.Колонки.Добавить("СметаКоррекция");
		Таблица.Колонки.Добавить("Прототип");	
		Таблица.Колонки.Добавить("ПрототипРаздел");
		Таблица.Колонки.Добавить("Новый");
		Таблица.Колонки.Добавить("НовыйРаздел");
		Таблица.Колонки.Добавить("Коррекция");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_ЛокальнаяСмета.Ссылка
	               |ИЗ
	               |	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	               |ГДЕ
	               |	СМ_ЛокальнаяСмета.КорректируетСмету = &Смета
	               |	И СМ_ЛокальнаяСмета.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СМ_ЛокальнаяСмета.МоментВремени";
    Запрос.УстановитьПараметр("Смета",Смета);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		//СтрокаДерева = Дерево.Строки.Добавить();
		//СтрокаДерева.Смета = Смета;
		//СтрокаДерева.Коррекция = Выборка.Ссылка;
		СписокСмет.Добавить(Выборка.Ссылка);
		ПолучитьРазделыИПозицииТаблица(Выборка.Ссылка,Таблица,Смета);
		ПолучитьКорректировкиТаблица(Смета,Выборка.Ссылка,Таблица,СписокСмет);
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Процедура ПолучитьРазделыИПозицииТаблица(Смета,Таблица,ИсходнаяСмета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	РазделЛокальнойСметы.Ссылка,
	               |	РазделЛокальнойСметы.НаименованиеДляПечати,
	               |	РазделЛокальнойСметы.НомерВПределахСметы,
	               |	РазделЛокальнойСметы.НомерВДереве,
	               |	РазделЛокальнойСметы.ИД,
	               |	РазделЛокальнойСметы.ИДРодителя,
	               |	РазделЛокальнойСметы.ИДСметы,
	               |	РазделЛокальнойСметы.Расчет,
	               |	РазделЛокальнойСметы.ПорНомер,
	               |	РазделЛокальнойСметы.Номер
	               |ПОМЕСТИТЬ РазделыЛокальнойСметыВременная
	               |ИЗ
	               |	Документ.СМ_РазделЛокальнойСметы КАК РазделЛокальнойСметы
	               |ГДЕ
	               |	РазделЛокальнойСметы.ИДСметы = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПозицияЛокальнойСметы.Ссылка,
	               |	ПозицияЛокальнойСметы.ИД,
	               |	ПозицияЛокальнойСметы.ИДРодителя,
	               |	ПозицияЛокальнойСметы.ИДСметы,
	               |	ПозицияЛокальнойСметы.ИДПозицииВладельца,
	               |	ПозицияЛокальнойСметы.НомерВПределахСметы,
	               |	ПозицияЛокальнойСметы.НомерВДереве,
	               |	ПозицияЛокальнойСметы.ПорНомер
	               |ПОМЕСТИТЬ ПозицииЛокальнойСметыВременная
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	               |ГДЕ
	               |	ПозицияЛокальнойСметы.ИДСметы = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВЫБОР
	               |		КОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел <> ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка)
	               |			ТОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел
	               |		ИНАЧЕ СМ_НумерацияПозицийЛокальныхСмет.Смета
	               |	КОНЕЦ КАК Документ,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
	               |ПОМЕСТИТЬ НомераРазделовСметы
	               |ИЗ
	               |	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |ГДЕ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Смета = &Ссылка
	               |	И СМ_НумерацияПозицийЛокальныхСмет.Позиция = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Позиция КАК Документ,
	               |	СМ_НумерацияПозицийЛокальныхСмет.Раздел КАК Раздел,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
	               |ПОМЕСТИТЬ НомераПозицийСметы
	               |ИЗ
	               |	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |ГДЕ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Смета = &Ссылка
	               |	И СМ_НумерацияПозицийЛокальныхСмет.Позиция <> ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	НомераРазделовСметы.Документ КАК Ссылка,
	               |	НомераРазделовСметы.НомерВДереве КАК НомерРодителя,
	               |	НомераРазделовСметы.НомерВДереве КАК НомерПозиции,
	               |	ЕСТЬNULL(НомераРазделовСметыРодитель.НомерВДереве, 0) КАК НомерРаздела,
	               |	НомераРазделовСметы.НомерВДереве,
	               |	НомераРазделовСметы.НомерВПределахСметы,
	               |	НомераРазделовСметы.ПорНомер
	               |ПОМЕСТИТЬ ПорядокРазделов
	               |ИЗ
	               |	НомераРазделовСметы КАК НомераРазделовСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ НомераРазделовСметы КАК НомераРазделовСметыРодитель
	               |		ПО НомераРазделовСметы.Документ.ИДРодителя = НомераРазделовСметыРодитель.Документ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	НомераПозицийСметы.Документ КАК Ссылка,
	               |	НомераПозицийСметы.Раздел КАК Раздел,
	               |	ВЫБОР
	               |		КОГДА НомераПозицийСметы.Документ.ИДПозицииВладельца = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	               |			ТОГДА НомераПозицийСметы.НомерВДереве
	               |		ИНАЧЕ НомераПозицийСметыРодитель.НомерВДереве
	               |	КОНЕЦ КАК НомерРодителя,
	               |	НомераПозицийСметы.НомерВДереве КАК НомерПозиции,
	               |	ЕСТЬNULL(НомераРазделовСметыРодитель.НомерВДереве, 0) КАК НомерРаздела,
	               |	НомераПозицийСметы.НомерВДереве,
	               |	НомераПозицийСметы.НомерВПределахСметы,
	               |	НомераПозицийСметы.ПорНомер
	               |ПОМЕСТИТЬ ПорядокПозиций
	               |ИЗ
	               |	НомераПозицийСметы КАК НомераПозицийСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ НомераПозицийСметы КАК НомераПозицийСметыРодитель
	               |		ПО НомераПозицийСметы.Документ.ИДПозицииВладельца = НомераПозицийСметыРодитель.Документ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ НомераРазделовСметы КАК НомераРазделовСметыРодитель
	               |		ПО НомераПозицийСметы.Документ.ИДРодителя = НомераРазделовСметыРодитель.Документ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	РазделЛокальнойСметыДок.Ссылка КАК Ссылка,
	               |	РазделЛокальнойСметыДок.НаименованиеДляПечати КАК Наименование,
	               |	РазделЛокальнойСметыДок.ИДРодителя КАК ИДРодителя,
	               |	РазделЛокальнойСметыДок.ИДСметы КАК ИДСметы,
	               |	ЕСТЬNULL(ПорядокРазделов.ПорНомер, 0) КАК ПорНомер,
	               |	РазделЛокальнойСметыДок.Номер КАК Номер,
	               |	ЕСТЬNULL(ПорядокРазделов.НомерВПределахСметы, 0) КАК НомерВПределахСметы,
	               |	1 КАК ТипСтроки,
	               |	ЕСТЬNULL(ПорядокРазделов.НомерРодителя, 0) КАК НомерРодителя,
	               |	ЕСТЬNULL(ПорядокРазделов.НомерПозиции, 0) КАК НомерПозиции,
	               |	ЕСТЬNULL(ПорядокРазделов.НомерРаздела, 0) КАК НомерРаздела
	               |ИЗ
	               |	РазделыЛокальнойСметыВременная КАК РазделЛокальнойСметыДок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПорядокРазделов КАК ПорядокРазделов
	               |		ПО РазделЛокальнойСметыДок.Ссылка = ПорядокРазделов.Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПозицияЛокальнойСметыДок.Ссылка,
	               |	ПозицияЛокальнойСметыДок.Ссылка.Наименование,
	               |	ПозицияЛокальнойСметыДок.ИДРодителя,
	               |	ПозицияЛокальнойСметыДок.ИДСметы,
	               |	ЕСТЬNULL(ПорядокПозиций.ПорНомер, 0),
	               |	NULL,
	               |	ЕСТЬNULL(ПорядокПозиций.НомерВПределахСметы, 0),
	               |	ВЫБОР
	               |		КОГДА ПозицияЛокальнойСметыДок.ИДПозицииВладельца = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	               |			ТОГДА 2
	               |		ИНАЧЕ 3
	               |	КОНЕЦ,
	               |	ЕСТЬNULL(ПорядокПозиций.НомерРодителя, 0),
	               |	ЕСТЬNULL(ПорядокПозиций.НомерВДереве, 0),
	               |	ЕСТЬNULL(ПорядокПозиций.НомерРодителя, 0)
	               |ИЗ
	               |	ПозицииЛокальнойСметыВременная КАК ПозицияЛокальнойСметыДок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПорядокПозиций КАК ПорядокПозиций
	               |		ПО ПозицияЛокальнойСметыДок.Ссылка = ПорядокПозиций.Ссылка
	               |			И ПозицияЛокальнойСметыДок.ИДРодителя = ПорядокПозиций.Раздел
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерРаздела,
	               |	НомерРодителя,
	               |	ТипСтроки,
	               |	НомерПозиции";
	Запрос.УстановитьПараметр("Ссылка",Смета);
	ТабДерева = Запрос.Выполнить().Выгрузить();
	Отбор = Новый Структура();
	Отбор.Вставить("ИдРодителя", Смета);
	ВывестиДеревоКоррекцииПоТаблицеТаб(Таблица, ТабДерева, Отбор, Смета,ИсходнаяСмета)

КонецПроцедуры

Процедура ПолучитьКорректировкиТаблица(Смета,Коррекция,Таблица,СписокСмет) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_ЛокальнаяСмета.Ссылка
	               |ИЗ
	               |	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	               |ГДЕ
	               |	СМ_ЛокальнаяСмета.КорректируетСмету = &Смета
	               |	И СМ_ЛокальнаяСмета.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СМ_ЛокальнаяСмета.МоментВремени";
    Запрос.УстановитьПараметр("Смета",Коррекция);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		//СтрокаДерева = СтрокаДерева.Строки.Добавить();
		//СтрокаДерева.Смета = Смета;
		//СтрокаДерева.Коррекция = Выборка.Ссылка;
		СписокСмет.Добавить(Выборка.Ссылка);
		ПолучитьРазделыИПозицииТаблица(Выборка.Ссылка,Таблица,Смета);
		ПолучитьКорректировкиТаблица(Смета,Выборка.Ссылка,Таблица,СписокСмет);
	КонецЦикла;
КонецПроцедуры

Процедура ВывестиДеревоКоррекцииПоТаблицеТаб(Таблица, ТабДерева, Отбор, ОбъектСмета,ИсходнаяСмета)
	
	МассивСмет = ТабДерева.НайтиСтроки(Отбор);   	
	
	Для Каждого ТекСтрока Из МассивСмет Цикл
		СтрокаДерева = Таблица.Добавить();
		СтрокаДерева.Смета = ИсходнаяСмета;
		СтрокаДерева.СметаКоррекция = ТекСтрока.Ссылка.ИдСметы;
		СтрокаДерева.Коррекция 				= ТекСтрока.Ссылка;
		Если ТипЗнч(ТекСтрока.Ссылка) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			СтрокаДерева.Прототип 				= ПолучитьИзначальнуюПозицию(ТекСтрока.Ссылка);
			Если ТипЗнч(ТекСтрока.Ссылка.ИДРодителя) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
				СтрокаДерева.ПрототипРаздел 		= ПолучитьИзначальныйРаздел(ТекСтрока.Ссылка.ИДРодителя);
			КонецЕсли;
			СтрокаДерева.НовыйРаздел = Ложь;
		ИначеЕсли ТипЗнч(ТекСтрока.Ссылка) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			СтрокаДерева.Прототип 				= ПолучитьИзначальныйРаздел(ТекСтрока.Ссылка);
			СтрокаДерева.НовыйРаздел = ?(ЗначениеЗаполнено(СтрокаДерева.Прототип),Ложь,Истина);
		КонецЕсли;
		СтрокаДерева.Новый = ?(ЗначениеЗаполнено(СтрокаДерева.Прототип),Ложь,Истина);

		ОтборСтрок = Новый Структура();
		ОтборСтрок.Вставить("ИдРодителя",ТекСтрока.Ссылка);
		ВывестиДеревоКоррекцииПоТаблицеТаб(Таблица, ТабДерева, ОтборСтрок, ОбъектСмета,ИсходнаяСмета);

	КонецЦикла;
	
КонецПроцедуры

Процедура ПолучитьКорректировки(Смета,Коррекция,СтрокаДерева,Дерево,СписокСмет) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_ЛокальнаяСмета.Ссылка
	               |ИЗ
	               |	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	               |ГДЕ
	               |	СМ_ЛокальнаяСмета.КорректируетСмету = &Смета
	               |	И СМ_ЛокальнаяСмета.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СМ_ЛокальнаяСмета.МоментВремени";
    Запрос.УстановитьПараметр("Смета",Коррекция);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаДерева = СтрокаДерева.Строки.Добавить();
		СтрокаДерева.Смета = Смета;
		СтрокаДерева.Коррекция = Выборка.Ссылка;
		СписокСмет.Добавить(Выборка.Ссылка);
		ПолучитьРазделыИПозиции(СтрокаДерева.Коррекция,СтрокаДерева,Дерево);
		ПолучитьКорректировки(Смета,СтрокаДерева.Коррекция,СтрокаДерева,Дерево,СписокСмет);
	КонецЦикла;
КонецПроцедуры

Процедура ПолучитьРазделыИПозиции(Смета,СтрокаДерева,Дерево) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	РазделЛокальнойСметы.Ссылка,
	               |	РазделЛокальнойСметы.НаименованиеДляПечати,
	               |	РазделЛокальнойСметы.НомерВПределахСметы,
	               |	РазделЛокальнойСметы.НомерВДереве,
	               |	РазделЛокальнойСметы.ИД,
	               |	РазделЛокальнойСметы.ИДРодителя,
	               |	РазделЛокальнойСметы.ИДСметы,
	               |	РазделЛокальнойСметы.Расчет,
	               |	РазделЛокальнойСметы.ПорНомер,
	               |	РазделЛокальнойСметы.Номер
	               |ПОМЕСТИТЬ РазделыЛокальнойСметыВременная
	               |ИЗ
	               |	Документ.СМ_РазделЛокальнойСметы КАК РазделЛокальнойСметы
	               |ГДЕ
	               |	РазделЛокальнойСметы.ИДСметы = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПозицияЛокальнойСметы.Ссылка,
	               |	ПозицияЛокальнойСметы.ИД,
	               |	ПозицияЛокальнойСметы.ИДРодителя,
	               |	ПозицияЛокальнойСметы.ИДСметы,
	               |	ПозицияЛокальнойСметы.ИДПозицииВладельца,
	               |	ПозицияЛокальнойСметы.НомерВПределахСметы,
	               |	ПозицияЛокальнойСметы.НомерВДереве,
	               |	ПозицияЛокальнойСметы.ПорНомер
	               |ПОМЕСТИТЬ ПозицииЛокальнойСметыВременная
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	               |ГДЕ
	               |	ПозицияЛокальнойСметы.ИДСметы = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВЫБОР
	               |		КОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел <> ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка)
	               |			ТОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел
	               |		ИНАЧЕ СМ_НумерацияПозицийЛокальныхСмет.Смета
	               |	КОНЕЦ КАК Документ,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
	               |ПОМЕСТИТЬ НомераРазделовСметы
	               |ИЗ
	               |	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |ГДЕ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Смета = &Ссылка
	               |	И СМ_НумерацияПозицийЛокальныхСмет.Позиция = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Позиция КАК Документ,
	               |	СМ_НумерацияПозицийЛокальныхСмет.Раздел КАК Раздел,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
	               |ПОМЕСТИТЬ НомераПозицийСметы
	               |ИЗ
	               |	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |ГДЕ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Смета = &Ссылка
	               |	И СМ_НумерацияПозицийЛокальныхСмет.Позиция <> ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	НомераРазделовСметы.Документ КАК Ссылка,
	               |	НомераРазделовСметы.НомерВДереве КАК НомерРодителя,
	               |	НомераРазделовСметы.НомерВДереве КАК НомерПозиции,
	               |	ЕСТЬNULL(НомераРазделовСметыРодитель.НомерВДереве, 0) КАК НомерРаздела,
	               |	НомераРазделовСметы.НомерВДереве,
	               |	НомераРазделовСметы.НомерВПределахСметы,
	               |	НомераРазделовСметы.ПорНомер
	               |ПОМЕСТИТЬ ПорядокРазделов
	               |ИЗ
	               |	НомераРазделовСметы КАК НомераРазделовСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ НомераРазделовСметы КАК НомераРазделовСметыРодитель
	               |		ПО НомераРазделовСметы.Документ.ИДРодителя = НомераРазделовСметыРодитель.Документ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	НомераПозицийСметы.Документ КАК Ссылка,
	               |	НомераПозицийСметы.Раздел КАК Раздел,
	               |	ВЫБОР
	               |		КОГДА НомераПозицийСметы.Документ.ИДПозицииВладельца = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	               |			ТОГДА НомераПозицийСметы.НомерВДереве
	               |		ИНАЧЕ НомераПозицийСметыРодитель.НомерВДереве
	               |	КОНЕЦ КАК НомерРодителя,
	               |	НомераПозицийСметы.НомерВДереве КАК НомерПозиции,
	               |	ЕСТЬNULL(НомераРазделовСметыРодитель.НомерВДереве, 0) КАК НомерРаздела,
	               |	НомераПозицийСметы.НомерВДереве,
	               |	НомераПозицийСметы.НомерВПределахСметы,
	               |	НомераПозицийСметы.ПорНомер
	               |ПОМЕСТИТЬ ПорядокПозиций
	               |ИЗ
	               |	НомераПозицийСметы КАК НомераПозицийСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ НомераПозицийСметы КАК НомераПозицийСметыРодитель
	               |		ПО НомераПозицийСметы.Документ.ИДПозицииВладельца = НомераПозицийСметыРодитель.Документ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ НомераРазделовСметы КАК НомераРазделовСметыРодитель
	               |		ПО НомераПозицийСметы.Документ.ИДРодителя = НомераРазделовСметыРодитель.Документ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	РазделЛокальнойСметыДок.Ссылка КАК Ссылка,
	               |	РазделЛокальнойСметыДок.НаименованиеДляПечати КАК Наименование,
	               |	РазделЛокальнойСметыДок.ИДРодителя КАК ИДРодителя,
	               |	РазделЛокальнойСметыДок.ИДСметы КАК ИДСметы,
	               |	ЕСТЬNULL(ПорядокРазделов.ПорНомер, 0) КАК ПорНомер,
	               |	РазделЛокальнойСметыДок.Номер КАК Номер,
	               |	ЕСТЬNULL(ПорядокРазделов.НомерВПределахСметы, 0) КАК НомерВПределахСметы,
	               |	1 КАК ТипСтроки,
	               |	ЕСТЬNULL(ПорядокРазделов.НомерРодителя, 0) КАК НомерРодителя,
	               |	ЕСТЬNULL(ПорядокРазделов.НомерПозиции, 0) КАК НомерПозиции,
	               |	ЕСТЬNULL(ПорядокРазделов.НомерРаздела, 0) КАК НомерРаздела
	               |ИЗ
	               |	РазделыЛокальнойСметыВременная КАК РазделЛокальнойСметыДок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПорядокРазделов КАК ПорядокРазделов
	               |		ПО РазделЛокальнойСметыДок.Ссылка = ПорядокРазделов.Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПозицияЛокальнойСметыДок.Ссылка,
	               |	ПозицияЛокальнойСметыДок.Ссылка.Наименование,
	               |	ПозицияЛокальнойСметыДок.ИДРодителя,
	               |	ПозицияЛокальнойСметыДок.ИДСметы,
	               |	ЕСТЬNULL(ПорядокПозиций.ПорНомер, 0),
	               |	NULL,
	               |	ЕСТЬNULL(ПорядокПозиций.НомерВПределахСметы, 0),
	               |	ВЫБОР
	               |		КОГДА ПозицияЛокальнойСметыДок.ИДПозицииВладельца = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	               |			ТОГДА 2
	               |		ИНАЧЕ 3
	               |	КОНЕЦ,
	               |	ЕСТЬNULL(ПорядокПозиций.НомерРодителя, 0),
	               |	ЕСТЬNULL(ПорядокПозиций.НомерПозиции, 0),
	               |	ЕСТЬNULL(ПорядокПозиций.НомерРаздела, 0)
	               |ИЗ
	               |	ПозицииЛокальнойСметыВременная КАК ПозицияЛокальнойСметыДок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПорядокПозиций КАК ПорядокПозиций
	               |		ПО ПозицияЛокальнойСметыДок.Ссылка = ПорядокПозиций.Ссылка
	               |			И ПозицияЛокальнойСметыДок.ИДРодителя = ПорядокПозиций.Раздел
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерРаздела,
	               |	НомерРодителя,
	               |	ТипСтроки,
	               |	НомерПозиции";
	Запрос.УстановитьПараметр("Ссылка",Смета);
	ТабДерева = Запрос.Выполнить().Выгрузить();
	Отбор = Новый Структура();
	Отбор.Вставить("ИдРодителя", Смета);
	ВывестиДеревоКоррекцииПоТаблице(Дерево, ТабДерева, Отбор, Смета,"Коррекция")

КонецПроцедуры

Процедура ВывестиДеревоКоррекцииПоТаблице(ДеревоЗначений, ТабДерева, Отбор, ОбъектСмета,КолонкаПоиска)
	
	МассивСмет = ТабДерева.НайтиСтроки(Отбор);   	
	
	Для Каждого ТекСтрока Из МассивСмет Цикл
		
		НайденнаяСтрока = ДеревоЗначений.Строки.Найти(ТекСтрока.ИДРодителя,КолонкаПоиска,Истина);
		Если НайденнаяСтрока <> Неопределено Тогда
			СтрокаДерева = НайденнаяСтрока.Строки.Добавить();	
		Иначе
			СтрокаДерева = ДеревоЗначений.Строки.Добавить();	
		КонецЕсли;
		СтрокаДерева.Элемент 				= ТекСтрока.Ссылка;
		Если ТипЗнч(ТекСтрока.Ссылка) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			СтрокаДерева.Прототип 				= ПолучитьИзначальнуюПозицию(ТекСтрока.Ссылка);
		КонецЕсли;
		ОтборСтрок = Новый Структура();
		ОтборСтрок.Вставить("ИдРодителя",ТекСтрока.Ссылка);
		ВывестиДеревоКоррекцииПоТаблице(ДеревоЗначений, ТабДерева, ОтборСтрок, ОбъектСмета,"Элемент");

	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИзначальнуюПозицию(Позиция) 
	Прототип = Неопределено;
	
	КорректируетПозицию = Позиция.КорректируетПозицию;
	Пока ЗначениеЗаполнено(КорректируетПозицию) Цикл
		Прототип = КорректируетПозицию;
		КорректируетПозицию = Прототип.КорректируетПозицию;
	КонецЦикла;
	
	Возврат Прототип;
КонецФункции

Функция ПолучитьИзначальныйРаздел(Раздел) 
	Прототип = Неопределено;
	
	КорректируетРаздел = Раздел.КорректируетРаздел;
	Пока ЗначениеЗаполнено(КорректируетРаздел) Цикл
		Прототип = КорректируетРаздел;
		КорректируетРаздел = Прототип.КорректируетРаздел;
	КонецЦикла;
	
	Возврат Прототип;
КонецФункции

Функция ЕстьКорректировкиСметы(Смета) Экспорт
	Если Не ТипЗнч(Смета) = Тип("Массив") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		               |	СМ_ЛокальнаяСмета.Ссылка
		               |ИЗ
		               |	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
		               |ГДЕ
		               |	СМ_ЛокальнаяСмета.КорректируетСмету = &Смета
		               |	И СМ_ЛокальнаяСмета.ПометкаУдаления = ЛОЖЬ";
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		               |	СМ_ЛокальнаяСмета.Ссылка
		               |ИЗ
		               |	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
		               |ГДЕ
		               |	СМ_ЛокальнаяСмета.КорректируетСмету В(&Смета)
		               |	И СМ_ЛокальнаяСмета.ПометкаУдаления = ЛОЖЬ";
	КонецЕсли;
	Запрос.УстановитьПараметр("Смета",Смета);
	Возврат Не Запрос.Выполнить().Пустой()
КонецФункции

// Процедура сохраняет нумерацию в РС.
//
Процедура СохранитьНовуюНумерацию(ТабДерева, Смета)
	
	НаборЗаписей = РегистрыСведений.СМ_НумерацияПозицийЛокальныхСмет.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Смета.Установить(Смета);
	
	Для Каждого Строка Из ТабДерева Цикл
		
		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Строка);
		
		Если Строка.ТипСтроки = 0 Тогда
			
			// смета
			Запись.Смета = Строка.Ссылка;
			Запись.Раздел = Документы.СМ_РазделЛокальнойСметы.ПустаяСсылка();
			Запись.Позиция = Документы.СМ_ПозицияЛокальнойСметы.ПустаяСсылка();			
			
		ИначеЕсли Строка.ТипСтроки = 1 Тогда
			
			// раздел
			Запись.Смета = Строка.ИдСметы;
			Запись.Раздел = Строка.Ссылка;
			Запись.Позиция = Документы.СМ_ПозицияЛокальнойСметы.ПустаяСсылка();
			
		Иначе
			
			// позиция
			Запись.Смета = Строка.ИдСметы;
			Запись.Раздел = Строка.ИдРодителя;
			Запись.Позиция = Строка.Ссылка;			
			
		КонецЕсли;	
		
	КонецЦикла;
	
	НаборЗаписей.Записать(Истина);	
	
КонецПроцедуры

