	|	ЕСТЬNULL(ПорядокПозиций.НомерВПределахСметы, 0),
	|	ПозицияЛокальнойСметыДок.ШифрРасценки,
	|	ПозицияЛокальнойСметыДок.Версия,
	|	ПозицияЛокальнойСметыДок.ОбъемРабот,
	|	ПозицияЛокальнойСметыДок.Измеритель,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметыДок.НеПрименятьИндексы
	|			ТОГДА ВЫБОР
	|					КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|						ТОГДА ЕСТЬNULL(РегРес.ТекСтоимОснЗарплата, 0) + ЕСТЬNULL(РегРес.ТекСтоимЭксплМашин, 0) + ЕСТЬNULL(РегРес.ТекСтоимСтоимМатер, 0) + ЕСТЬNULL(РегРес.ТекСтоимОборуд, 0)
	|					ИНАЧЕ ЕСТЬNULL(Рег.СтоимОснЗарплата, 0) + ЕСТЬNULL(Рег.СтоимЭксплМашин, 0) + ЕСТЬNULL(Рег.СтоимСтоимМатер, 0) + ЕСТЬNULL(Рег.СтоимОборуд, 0)
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПозицияЛокальнойСметыДок.Определитель.ВидРасценки = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыРасценки.Оборудование)
	|					ТОГДА ВЫБОР
	|							КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|								ТОГДА ЕСТЬNULL(РегРес.ТекСтоимОборуд, 0)
	|							ИНАЧЕ ЕСТЬNULL(Рег.СтоимОборуд, 0)
	|						КОНЕЦ
	|				ИНАЧЕ ВЫБОР
	|						КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|							ТОГДА ВЫБОР
	|									КОГДА ПозицияЛокальнойСметыДок.ПрямЗатраты <> 0
	|											И ЕСТЬNULL(РегРес.ТекСтоимОснЗарплата, 0) + ЕСТЬNULL(РегРес.ТекСтоимЭксплМашин, 0) + ЕСТЬNULL(РегРес.ТекСтоимСтоимМатер, 0) = 0
	|										ТОГДА ПозицияЛокальнойСметыДок.ПрямЗатраты
	|									ИНАЧЕ ЕСТЬNULL(РегРес.ТекСтоимОснЗарплата, 0) + ЕСТЬNULL(РегРес.ТекСтоимЭксплМашин, 0) + ЕСТЬNULL(РегРес.ТекСтоимСтоимМатер, 0)
	|								КОНЕЦ
	|						ИНАЧЕ ВЫБОР
	|								КОГДА ПозицияЛокальнойСметыДок.ПрямЗатраты <> 0
	|										И ЕСТЬNULL(Рег.СтоимОснЗарплата, 0) + ЕСТЬNULL(Рег.СтоимЭксплМашин, 0) + ЕСТЬNULL(Рег.СтоимСтоимМатер, 0) = 0
	|									ТОГДА ПозицияЛокальнойСметыДок.ПрямЗатраты
	|								ИНАЧЕ ЕСТЬNULL(Рег.СтоимОснЗарплата, 0) + ЕСТЬNULL(Рег.СтоимЭксплМашин, 0) + ЕСТЬNULL(Рег.СтоимСтоимМатер, 0)
	|							КОНЕЦ
	|					КОНЕЦ
	|			КОНЕЦ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметыДок.НеПрименятьИндексы
	|			ТОГДА 0
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|					ТОГДА ЕСТЬNULL(РегРес.ТекСтоимОснЗарплата, 0)
	|				ИНАЧЕ ЕСТЬNULL(Рег.СтоимОснЗарплата, 0)
	|			КОНЕЦ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметыДок.НеПрименятьИндексы
	|			ТОГДА ВЫБОР
	|					КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|						ТОГДА ЕСТЬNULL(РегРес.ТекСтоимЭксплМашин, 0)
	|					ИНАЧЕ ЕСТЬNULL(Рег.СтоимЭксплМашин, 0)
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|					ТОГДА ЕСТЬNULL(РегРес.ТекСтоимЭксплМашин, 0)
	|				ИНАЧЕ ЕСТЬNULL(Рег.СтоимЭксплМашин, 0)
	|			КОНЕЦ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметыДок.НеПрименятьИндексы
	|			ТОГДА ПозицияЛокальнойСметыДок.ТекущаяЗарплатаМашинистов
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|					ТОГДА ЕСТЬNULL(РегРес.ТекСтоимЗарплМашин, 0)
	|				ИНАЧЕ ЕСТЬNULL(Рег.СтоимЗарплМашин, 0)
	|			КОНЕЦ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметыДок.НеПрименятьИндексы
	|			ТОГДА ВЫБОР
	|					КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|						ТОГДА ЕСТЬNULL(РегРес.ТекСтоимСтоимМатер, 0)
	|					ИНАЧЕ ЕСТЬNULL(Рег.СтоимСтоимМатер, 0)
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|					ТОГДА ЕСТЬNULL(РегРес.ТекСтоимСтоимМатер, 0)
	|				ИНАЧЕ ЕСТЬNULL(Рег.СтоимСтоимМатер, 0)
	|			КОНЕЦ
