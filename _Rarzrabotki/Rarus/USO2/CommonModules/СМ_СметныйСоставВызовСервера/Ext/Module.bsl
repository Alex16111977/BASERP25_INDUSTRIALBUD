	//Если Найти(Действие,"Перенумеровать") > 0 Тогда
	//	СохранитьНовуюНумерацию(ТабДерева);
	//КонецЕсли;	
	
КонецПроцедуры

// Процедура строит дерево по таблице значений с данными о позициях и разделах сметы или акта.
//
Процедура ВывестиДеревоПоТаблице(ДеревоЗначений, ТабДерева, Отбор, ОбъектСмета, ОбъектАкт, СтруктураПараметров, Действие="Обновить", ОбъектПересчета=Неопределено, НомерПересчета = 0) Экспорт
	
	МассивСмет = ТабДерева.НайтиСтроки(Отбор);   
	
	НомерОбрабатываемойСтроки = 0;
	
	ТаблицаУдаление = Новый ТаблицаЗначений();
	ТаблицаУдаление.Колонки.Добавить("ИДРодителя");
	ТаблицаУдаление.Колонки.Добавить("НужноУдалять");
	
	ИДРодителя = Неопределено;
	СтрокаУдаление = Неопределено;
	
	СменилсяРодительВТаблице = Ложь;
		
	Для Каждого ТекСтрока Из МассивСмет Цикл
		
		Если ТекСтрока.ИДРодителя <> ИДРодителя Тогда
			СменилсяРодительВТаблице = Истина;
			НайденнаяСтрока = ДеревоЗначений.Строки.Найти(ТекСтрока.ИДРодителя,"Элемент",Истина);
			ИДРодителя = ТекСтрока.ИДРодителя;
		КонецЕсли;
			
		Если ОбъектПересчета = Неопределено Тогда
			
			Если НайденнаяСтрока <> Неопределено Тогда
				СтрокаДерева = НайденнаяСтрока.Строки.Добавить();	
			Иначе
				СтрокаДерева = ДеревоЗначений.Строки.Добавить();	
			КонецЕсли;
		
		Иначе
			
			Если НайденнаяСтрока = Неопределено Тогда
				НайденнаяСтрока = ДеревоЗначений;
			КонецЕсли;
			
			// проверим количество на удаление.
			Если СменилсяРодительВТаблице Тогда
				ОтборУдаление = Новый Структура("ИДРодителя", ТекСтрока.ИДРодителя);
				МассивУдаление = ТаблицаУдаление.НайтиСтроки(ОтборУдаление);
				Если МассивУдаление.Количество() = 0 Тогда
					СтрокаУдаление = ТаблицаУдаление.Добавить();
					СтрокаУдаление.ИДРодителя = ТекСтрока.ИДРодителя;
					СтрокаУдаление.НужноУдалять = (НайденнаяСтрока.Строки.Количество() > МассивСмет.Количество());
					// СУДАРИКОВ - надо как-то отработать если вдруг в табилце будет 2 разных ИД Родителя,
					// хотя такого не должно быть!
				Иначе
					СтрокаУдаление = МассивУдаление[0];
				КонецЕсли;
			КонецЕсли;			
			
			// ищем есть ли в этой ветке нужное.
			НайденнаяСтрокаПересчета = НайденнаяСтрока.Строки.Найти(ОбъектПересчета,"Элемент",Истина);
			Если (НайденнаяСтрокаПересчета = Неопределено) Тогда
				// может это новая строка.             			
				НайденнаяСтрокаРодителяПересчета = НайденнаяСтрока.Строки.Найти(ОбъектПересчета.ИДРодителя,"Элемент",Истина);
				Если (НайденнаяСтрокаРодителяПересчета = Неопределено) и (ОбъектПересчета.ИДРодителя <> ТекСтрока.ИдРодителя) Тогда   
					
					Если Найти(Действие,"Перенумеровать") = 0 Тогда 
						// если не нумеруем - продолжеаем
						НомерОбрабатываемойСтроки = НомерОбрабатываемойСтроки + 1;
						Продолжить;
					ИначеЕсли (ТипЗнч(ТекСтрока.Ссылка) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")) и (ТекСтрока.НомерВДереве < НомерПересчета) Тогда 
						// если нумеруем - но число меньше чем с которого нумеруем.
						НомерОбрабатываемойСтроки = НомерОбрабатываемойСтроки + 1;
						СтруктураПараметров.СчетчикНомер = СтруктураПараметров.СчетчикНомер + 1;
						СтруктураПараметров.СчетчикПорНомерПозиции = СтруктураПараметров.СчетчикПорНомерПозиции + 1;
						Продолжить; //KS
					КонецЕсли;					
				КонецЕсли;
			КонецЕсли;
			
			СтрокаДерева = НайденнаяСтрока.Строки.Найти(ТекСтрока.Ссылка,"Элемент",Истина); 
			Если СтрокаДерева = Неопределено Тогда                   				
				
				СтрокаДерева = НайденнаяСтрока.Строки.Вставить(НомерОбрабатываемойСтроки);
				
				// может появилось что удалить..
				Если (МассивСмет.Количество() < НайденнаяСтрока.Строки.Количество()) и (СтрокаУдаление<>Неопределено)  Тогда
			
					СтрокаУдаление.НужноУдалять = Истина;							
					
				КонецЕсли;

			Иначе
				// Нашли. А тот ли порядок в дереве?
				ИндексСтроки = НайденнаяСтрока.Строки.Индекс(СтрокаДерева);
				Если ИндексСтроки <> НомерОбрабатываемойСтроки Тогда
					НайденнаяСтрока.Строки.Сдвинуть(СтрокаДерева, НомерОбрабатываемойСтроки-ИндексСтроки) 	
				КонецЕсли;
			КонецЕсли;

		КонецЕсли;
		
		Если СтруктураПараметров.Вид = "ГрупповаяОбработкаПозиций" Тогда   
			// Добавил условие для групповой обработки.
			// Для групповой частичное обновление не поддерживается пока что.
			СтрокаДерева.Пометка	= ложь;
		Иначе	
			Если Найти(Действие,"БезОбновления") = 0 Тогда 
				СтрокаДерева.ИндексПересчет			= 1;
				СтрокаДерева.ИндексПривязана 		= 1;
				СтрокаДерева.ИндексНеИндексировать 	= 1;
				СтрокаДерева.ИндексПоправки			= 1;
				СтрокаДерева.НомерПП	 			= "";
			КонецЕсли;
		КонецЕсли;	
		
		СтрокаДерева.Элемент 				= ТекСтрока.Ссылка;
		
		Если Действие = "СметаНаОстаток" Тогда
			СтрокаДерева.СтараяСсылка 				= ТекСтрока.Ссылка;
			СтрокаДерева.Элемент 				    = ТекСтрока.НоваяСсылка;
		КонецЕсли;
		
		Если СтруктураПараметров = Неопределено Тогда
			СтруктураПараметров = Новый Структура;
		КонецЕсли;
		
		РазрешитьРедактирование = ПолучитьФункциональнуюОпцию("СМ_РазрешитьРедактированиеЗакрытыхСмет");
		
		ЗаполнитьВетку(ТекСтрока,СтрокаДерева,ОбъектСмета,ОбъектАкт,СтруктураПараметров,Действие,РазрешитьРедактирование);
		
		ОтборСтрок = Новый Структура();
		ОтборСтрок.Вставить("ИдРодителя", СМ_СметаВызовСервера.ПолучитьСсылкуСтрокиДереваСмет(СтрокаДерева,?(Действие = "СметаНаОстаток","СтараяСсылка","Элемент")));
		ВывестиДеревоПоТаблице(ДеревоЗначений, ТабДерева, ОтборСтрок, ОбъектСмета, ОбъектАкт, СтруктураПараметров, Действие, ОбъектПересчета,НомерПересчета);
		
		НомерОбрабатываемойСтроки = НомерОбрабатываемойСтроки + 1;
		
	КонецЦикла;
	
	Если ОбъектПересчета <> Неопределено Тогда
		
		ОтборУдаление = Новый Структура("НужноУдалять", Истина);
		МассивУдаление = ТаблицаУдаление.НайтиСтроки(ОтборУдаление);
		СписокУдаленных = Новый СписокЗначений();
		Если МассивУдаление.Количество() > 0 Тогда 
			Для Каждого СтрокаУдаления Из МассивУдаление Цикл
				СписокУдаленных = Новый СписокЗначений();
				НайденнаяСтрока = ДеревоЗначений.Строки.Найти(СтрокаУдаления.ИДРодителя,"Элемент",Истина);
				Для Каждого СтрокаДерева Из НайденнаяСтрока.Строки Цикл
					ОтборСтрока = Новый Структура("Ссылка", СтрокаДерева.Элемент);
					МассивСтрока = ТабДерева.НайтиСтроки(ОтборСтрока);
				    Если МассивСтрока.Количество() = 0 Тогда
						СписокУдаленных.Добавить(СтрокаДерева);
					КонецЕсли;
				КонецЦикла;
				Для Каждого ЭлементСписка Из СписокУдаленных Цикл
					НайденнаяСтрока.Строки.Удалить(ЭлементСписка.Значение);
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли; 
	
КонецПроцедуры

// Функция возвращает индекс картинки для акта или сметы.
//
Функция ПолучитьКартинкуСтрокиАктаСметы(ТекЭлемент)
	
	// 0. Смета.
	// 1. Раздел.
	// 2. Позиция.
	// 3. Привязанная позиция.
	// 4. Лим. затрата (пока в дереве ее нет, но сюда добавил).
	// 5. Удаленная смета.
	// 6. Удаленный раздел.
	// 7. Удаленная позиция.
	// 8. Удаленная привязанная позиция.
	// 9. Удаленная лим. затрата (пока в дереве ее нет, но сюда добавил).

	Если ТипЗнч(ТекЭлемент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		ТекКартинка = ?(ТекЭлемент.ПометкаУдаления,5,0);
		Возврат ТекКартинка;
	ИначеЕсли ТипЗнч(ТекЭлемент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
		ТекКартинка = ?(ТекЭлемент.ПометкаУдаления,6,1);
		Возврат ТекКартинка;
	ИначеЕсли ТипЗнч(ТекЭлемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		// Позиция привязана.
		Если ЗначениеЗаполнено(ТекЭлемент.ИДПозицииВладельца) Тогда
			ТекКартинка = ?(ТекЭлемент.ПометкаУдаления,8,3);
		// Позиция не привязана.	
		Иначе	
			ТекКартинка = ?(ТекЭлемент.ПометкаУдаления,7,2);
		КонецЕсли;
		Возврат ТекКартинка;
	ИначеЕсли ТипЗнч(ТекЭлемент) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
		ТекКартинка = ?(ТекЭлемент.ПометкаУдаления,9,4);
		Возврат ТекКартинка;
	КонецЕсли;	
		
КонецФункции

// Процедура заполняет вертку дерева значений данными.
//
Процедура ЗаполнитьВетку(СтрокаУровня,СтрокаДерева,ОбъектСмета,ОбъектАкт,СтруктураПараметров,Действие="Обновить",РазрешитьРедактирование = Ложь)   
	
	Перенумерация	  	= Ложь;
	ЗаполнитьПоОстаткам	= Ложь;
	ПроцентоватьАкт   	= Ложь;
	КопироватьИндексы 	= Ложь;
	Временное		  	= Ложь;
	ОбновлениеДерева 	= Ложь;     
	НеИзменятьАкт	 	= Ложь;

	Процент 		  	= 0;
	СчетчикНомер      	= 0;
	СчетчикПорНомер   	= 0;
	
	// Опеределение действия с деревом.
	Если Найти(Действие,"Процентовать") > 0 Тогда
		ПроцентоватьАкт = Истина;
	ИначеЕсли Найти(Действие,"ЗаполнитьПоОстаткам") > 0 ИЛИ Найти(Действие,"СметаНаОстаток") > 0 Тогда
		ЗаполнитьПоОстаткам = Истина;	
	ИначеЕсли Найти(Действие,"Перенумеровать") > 0 Тогда
		Перенумерация = Истина;	
	КонецЕсли;
	
	Если Найти(Действие,"БезОбновления") = 0 Тогда
		ОбновлениеДерева = Истина;
	КонецЕсли;	
	
	Если Найти(Действие,"БезТаблицАкта") <> 0 ИЛИ Найти(Действие,"СметаНаОстаток") > 0 Тогда
		НеИзменятьАкт = Истина;
	КонецЕсли;
	
	// Заполнение параметров.
	Если СтруктураПараметров <> Неопределено Тогда
		Если СтруктураПараметров.Свойство("Процент") Тогда
			//	Процент = ?(СтруктураПараметров.Процент=0,1,СтруктураПараметров.Процент);
			Процент = СтруктураПараметров.Процент;
		КонецЕсли;	
		    
		Если СтруктураПараметров.Свойство("КопироватьИндексы") Тогда
			КопироватьИндексы = СтруктураПараметров.КопироватьИндексы;
		КонецЕсли;	
		
		Если СтруктураПараметров.Свойство("Временное") Тогда
			Временное = СтруктураПараметров.Временное;
		КонецЕсли;
	КонецЕсли;
	
	ЭтоГрупповаяОбработкаПозиций = ложь;
	Если СтруктураПараметров.Свойство("Вид") Тогда
		Если СтруктураПараметров.Вид = "ГрупповаяОбработкаПозиций" Тогда
			ЭтоГрупповаяОбработкаПозиций = Истина;
		КонецЕсли;	
	КонецЕсли;
	
	// Заполнение параметров перенумерации.
	Если Перенумерация Тогда
		
		Если Не СтруктураПараметров.Свойство("СчетчикНомер") Тогда
			СтруктураПараметров.Вставить("СчетчикНомер",1);
		КонецЕсли;
		
		СчетчикНомер = СтруктураПараметров.СчетчикНомер;
		Если Не СтруктураПараметров.Свойство("СчетчикПорНомерРазделы") Тогда
			СтруктураПараметров.Вставить("СчетчикПорНомерРазделы",1);
		КонецЕсли;
		
		СчетчикПорНомерРазделы = СтруктураПараметров.СчетчикПорНомерРазделы;
		Если Не СтруктураПараметров.Свойство("СчетчикПорНомерПозиции") Тогда
			СтруктураПараметров.Вставить("СчетчикПорНомерПозиции",1);
		КонецЕсли;
		
		СчетчикПорНомерПозиции = СтруктураПараметров.СчетчикПорНомерПозиции;
				
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаУровня);
	//ЧМА{
	СтрокаДерева.ПроверкаЗаполненияРеквизитов = Истина;
	//ЧМА}
	Если (ТипЗнч(СтрокаДерева.Элемент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") ИЛИ
		ТипЗнч(СтрокаДерева.Элемент) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета")) И ОбновлениеДерева Тогда 
		
		Если ЭтоГрупповаяОбработкаПозиций Тогда
			Возврат;
		КонецЕсли;

		СтрокаДерева.Расчет = Истина; 
		ОбъемРабот 			= 1;
		
		Если ОбъектАкт <> Неопределено Тогда 
			Если КопироватьИндексы И ОбъектСмета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета И (НЕ НеИзменятьАкт) Тогда
				ОбъектАкт.КоэффСМР				= ОбъектСмета.КоэффСМР; 
				ОбъектАкт.КоэффФОТ              = ОбъектСмета.КоэффФОТ;
				ОбъектАкт.КоэффОборуд           = ОбъектСмета.КоэффОборуд;
				ОбъектАкт.КоэффПрочРаб          = ОбъектСмета.КоэффПрочРаб;
				ОбъектАкт.КоэффСтоимЭксплМашин  = ОбъектСмета.КоэффСтоимЭксплМашин;
				ОбъектАкт.КоэффПолнСтоимРабот   = ОбъектСмета.КоэффПолнСтоимРабот;
				ОбъектАкт.КоэффСтоимМатериалов 	= ОбъектСмета.КоэффСтоимМатериалов;			
			КонецЕсли;
		КонецЕсли;
		
		СтрокаДерева.Картинка = ПолучитьКартинкуСтрокиАктаСметы(СтрокаДерева.Элемент);
		
	ИначеЕсли ТипЗнч(СтрокаДерева.Элемент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда 
		
		Если Перенумерация Тогда
			СМ_СметаВызовСервера.ПрисвоитьНомерОбъекту(СтрокаДерева, СтрокаУровня, СчетчикНомер, СчетчикПорНомерРазделы, Ложь); 
			//СМ_СметаВызовСервера.ПолучитьОбъектСтрокиДереваСмет(СтрокаДерева), СчетчикНомер, СчетчикПорНомерРазделы);
			СтруктураПараметров.СчетчикНомер 	= СчетчикНомер;
			СтруктураПараметров.СчетчикПорНомерРазделы = СчетчикПорНомерРазделы;
		КонецЕсли;
		
		Если ЭтоГрупповаяОбработкаПозиций Тогда
			Возврат;
		КонецЕсли;	

		Если ОбновлениеДерева Тогда
		
			СтрокаДерева.Расчет = СтрокаУровня.Расчет;
			ОбъемРабот 			= 1;
			
			Если ОбъектАкт <> Неопределено И Найти(Действие,"СметаНаОстаток") = 0 Тогда
				Если НЕ НеИзменятьАкт Тогда
					ОбновитьТЧРазделыАкта(ОбъектАкт,СтрокаДерева);
				КонецЕсли;
			КонецЕсли;
			СтрокаДерева.Картинка = ПолучитьКартинкуСтрокиАктаСметы(СтрокаДерева.Элемент);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СтрокаДерева.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда 
		
		Если Перенумерация Тогда
			
			//ДокОб = СМ_СметаВызовСервера.ПолучитьОбъектСтрокиДереваСмет(СтрокаДерева);
			СМ_СметаВызовСервера.ПрисвоитьНомерОбъекту(СтрокаДерева, СтрокаУровня, СчетчикНомер, СчетчикПорНомерПозиции, Ложь);
			СтруктураПараметров.СчетчикНомер 			= СчетчикНомер;
			СтруктураПараметров.СчетчикПорНомерПозиции 	= СчетчикПорНомерПозиции;
			
			Если НЕ ЭтоГрупповаяОбработкаПозиций И Найти(Действие,"БезОбновления") = 0 Тогда
				СтрокаДерева.НомерПП = СтрокаУровня.ПорНомер;
			КонецЕсли;
			
		ИначеЕсли ОбновлениеДерева Тогда
			
			Если НЕ ЭтоГрупповаяОбработкаПозиций Тогда
			
				Если СтрокаУровня.ПорНомер = 0 Тогда
					СтрокаДерева.НомерПП = "";
				Иначе	
					СтрокаДерева.НомерПП = СтрокаУровня.ПорНомер;    
				КонецЕсли;
				
			КонецЕсли;	
			
		КонецЕсли;	
		
		Если ОбновлениеДерева Тогда
			
			Если ЭтоГрупповаяОбработкаПозиций Тогда
				СтрокаДерева.Шифр 					= СтрокаУровня.ШифрРасценки;
				СтрокаДерева.Объем 					= СтрокаУровня.ОбъемРабот;
				СтрокаДерева.ИДПозицииВладельца		= СтрокаУровня.ИДПозицииВладельца;
				
				Если ЗначениеЗаполнено(СтрокаУровня.ИДПозицииВладельца) Тогда
					СтрокаДерева.НаименованиеЭлемента = "		"+СтрокаДерева.НаименованиеЭлемента;	
				КонецЕсли;	
			
			КонецЕсли;

			СтрокаДерева.Расчет = СтрокаУровня.Расчет;
			ОбъемРабот  		= СтрокаУровня.ОбъемРабот;	
			
			Если ОбъектАкт <> Неопределено И Найти(Действие,"СметаНаОстаток") = 0 Тогда
				
				// Находим строку позиции в ТЧ позиций акта, если есть.
				СтруктураОтбора = Новый Структура;
				СтруктураОтбора.Вставить("Позиция",СтрокаДерева.Элемент);
				
				МассивСтрок = ОбъектАкт.Позиции.НайтиСтроки(СтруктураОтбора);
				Если МассивСтрок.Количество() > 0 Тогда
					ТекущаяСтрокаПозиции = МассивСтрок[0]; 	
				Иначе	
					ТекущаяСтрокаПозиции = Неопределено;
				КонецЕсли;
				
				Если (ПроцентоватьАкт или ЗаполнитьПоОстаткам) Тогда
					Если СтруктураПараметров.Свойство("ТаблицаСтарыхОбъемов") Тогда
						ОтборСтарыхОбъемов = Новый Структура("Позиция", СтрокаДерева.Элемент);
						Массив = СтруктураПараметров.ТаблицаСтарыхОбъемов.НайтиСтроки(ОтборСтарыхОбъемов);
						Если Массив.Количество() > 0 Тогда
							ФактОбъемПоАкту = Массив[0].ФактОбъем;
						ИначеЕсли ТекущаяСтрокаПозиции <> Неопределено Тогда
							ФактОбъемПоАкту = ТекущаяСтрокаПозиции.ФактОбъем;
						Иначе
							ФактОбъемПоАкту = 0;
						КонецЕсли;
					ИначеЕсли ТекущаяСтрокаПозиции <> Неопределено Тогда
						ФактОбъемПоАкту = ТекущаяСтрокаПозиции.ФактОбъем;
					Иначе
						ФактОбъемПоАкту = 0;
					КонецЕсли;
				ИначеЕсли ТекущаяСтрокаПозиции <> Неопределено Тогда
					ФактОбъемПоАкту = ТекущаяСтрокаПозиции.ФактОбъем;
				Иначе
					ФактОбъемПоАкту = 0;
				КонецЕсли;
				
				Если ЭтоГрупповаяОбработкаПозиций Тогда
					Если ТекущаяСтрокаПозиции = Неопределено Тогда
					
					Иначе
						СтрокаДерева.ОбъемПоАкту = ТекущаяСтрокаПозиции.ФактОбъем;
						Попытка
							СтрокаДерева.ОбъемВсего = СтрокаДерева.ОбъемВсего+СтрокаДерева.ОбъемПоАкту;
						Исключение
						КонецПопытки;
						Попытка
							СтрокаДерева.ОбъемВсегоПроцент = ?(ОбъемРабот=0,100,(СтрокаДерева.ОбъемВсего/ОбъемРабот)*100);
						Исключение
						КонецПопытки;
					КонецЕсли;
				ИначеЕсли ПроцентоватьАкт Тогда
					Если Не СтруктураПараметров.Свойство("МассивПозиций") или  СтруктураПараметров.МассивПозиций=Неопределено 
						или НЕ СтруктураПараметров.МассивПозиций.Найти(СтрокаДерева.Элемент)=Неопределено Тогда	
						Если (Процент = 0) и (ФактОбъемПоАкту <> 0) и СтруктураПараметров.Свойство("ТаблицаСтарыхОбъемов") Тогда
							// Значит было сохранение объема в табилце старых
							СтрокаДерева.ОбъемПоАкту = ФактОбъемПоАкту;
						Иначе
							СтрокаДерева.ОбъемПоАкту = СтрокаУровня.ОбъемРабот * Процент / 100;
						КонецЕсли;
					ИначеЕсли ТекущаяСтрокаПозиции <> Неопределено Тогда
						СтрокаДерева.ОбъемПоАкту = ФактОбъемПоАкту;// ТекущаяСтрокаПозиции.ФактОбъем;
					КонецЕсли;
					СтрокаДерева.ОбъемВсего 		= ?(Не ЗначениеЗаполнено(СтрокаДерева.ОбъемВсего), 0, СтрокаДерева.ОбъемВсего)+?(Не ЗначениеЗаполнено(СтрокаДерева.ОбъемПоАкту), 0, СтрокаДерева.ОбъемПоАкту);
					СтрокаДерева.ОбъемВсегоПроцент 	= ?(ОбъемРабот=0,100,(СтрокаДерева.ОбъемВсего/ОбъемРабот)*100);
				ИначеЕсли ЗаполнитьПоОстаткам Тогда
					Если СтруктураПараметров.ВыполнениеСметы.Количество() = 0 Тогда
						Если ТекущаяСтрокаПозиции = Неопределено Тогда
							СтрокаДерева.ОбъемПоАкту = СтрокаУровня.ОбъемРабот;
							СтрокаДерева.ОбъемВсего = ?(Не ЗначениеЗаполнено(СтрокаДерева.ОбъемВсего), 0, СтрокаДерева.ОбъемВсего)+?(Не ЗначениеЗаполнено(СтрокаДерева.ОбъемПоАкту), 0, СтрокаДерева.ОбъемПоАкту);
							СтрокаДерева.ОбъемВсегоПроцент = ?(ОбъемРабот=0,100,(СтрокаДерева.ОбъемВсего/ОбъемРабот)*100);
						Иначе
							СтрокаДерева.ОбъемПоАкту = ФактОбъемПоАкту;//ТекущаяСтрокаПозиции.ФактОбъем;
							СтрокаДерева.ОбъемВсего = ?(Не ЗначениеЗаполнено(СтрокаДерева.ОбъемВсего), 0, СтрокаДерева.ОбъемВсего)+?(Не ЗначениеЗаполнено(СтрокаДерева.ОбъемПоАкту), 0, СтрокаДерева.ОбъемПоАкту);
							СтрокаДерева.ОбъемВсегоПроцент = ?(ОбъемРабот=0,100,(СтрокаДерева.ОбъемВсего/ОбъемРабот)*100);
						КонецЕсли;
					Иначе
						Если Не СтруктураПараметров.Свойство("МассивПозиций")ИЛИ СтруктураПараметров.МассивПозиций=Неопределено Тогда
							СтрокаДерева.ОбъемПоАкту = 0;
						ИначеЕсли Не ТекущаяСтрокаПозиции = Неопределено Тогда
							СтрокаДерева.ОбъемПоАкту = ФактОбъемПоАкту;//ТекущаяСтрокаПозиции.ФактОбъем;
						КонецЕсли;
						НайденнаяСтрока = СтруктураПараметров.ВыполнениеСметы.Найти(СтрокаДерева.Элемент);
						Если НайденнаяСтрока <> Неопределено Тогда
							СтрокаДерева.ОбъемПоАкту = НайденнаяСтрока.ФактОбъем;	
							// При создании акта на остаток, по позициям с превышением объема, по позиции формируется отрицательный фактОбъем 
							// Если суммарный объем по всем актам по позиции больше, чем объем работ по смете.
							// Остаток может быть только больше 0, в противном случае ФактОбъем по позиции должен быть равен 0.
							Если ((НайденнаяСтрока.ОбъемПриход < 0) и (СтрокаДерева.ОбъемПоАкту>0)) или
								((НайденнаяСтрока.ОбъемПриход > 0) и (СтрокаДерева.ОбъемПоАкту<0)) Тогда
								СтрокаДерева.ОбъемПоАкту = 0;	
							КонецЕсли;
						ИначеЕсли СтрокаДерева.ОбъемПоАкту < 0 Тогда
							СтрокаДерева.ОбъемПоАкту = 0;	
						КонецЕсли;            						
						СтрокаДерева.ОбъемВсего = ?(Не ЗначениеЗаполнено(СтрокаДерева.ОбъемВсего), 0, СтрокаДерева.ОбъемВсего)+?(Не ЗначениеЗаполнено(СтрокаДерева.ОбъемПоАкту), 0, СтрокаДерева.ОбъемПоАкту);
						СтрокаДерева.ОбъемВсегоПроцент = ?(ОбъемРабот=0,100,(СтрокаДерева.ОбъемВсего/ОбъемРабот)*100);    
					КонецЕсли;
				Иначе	
					Если ТекущаяСтрокаПозиции = Неопределено Тогда
						
					Иначе
						СтрокаДерева.ОбъемПоАкту = ФактОбъемПоАкту;//ТекущаяСтрокаПозиции.ФактОбъем;
						СтрокаДерева.ОбъемВсего = ?(Не ЗначениеЗаполнено(СтрокаДерева.ОбъемВсего), 0, СтрокаДерева.ОбъемВсего)+?(Не ЗначениеЗаполнено(СтрокаДерева.ОбъемПоАкту), 0, СтрокаДерева.ОбъемПоАкту);
						СтрокаДерева.ОбъемВсегоПроцент = ?(ОбъемРабот=0,100,(СтрокаДерева.ОбъемВсего/ОбъемРабот)*100);
					КонецЕсли;
				КонецЕсли;
				
				Если Не ЭтоГрупповаяОбработкаПозиций Тогда
				
					Если СтрокаУровня.ОбъемРабот = 0 Тогда
						СтрокаДерева.ОбъемПоАктуПроцент = 0;					
					Иначе
						СтрокаДерева.ОбъемПоАктуПроцент = СтрокаДерева.ОбъемПоАкту * 100 / СтрокаУровня.ОбъемРабот;
					КонецЕсли;
					
					Если (НЕ НеИзменятьАкт) Тогда
					
						// Копируем индексы позиции и заполняем ТЧ позиции в акте.
						ОбновитьТЧПозицииАкта(КопироватьИндексы,ОбъектСмета,ОбъектАкт,СтрокаДерева,ТекущаяСтрокаПозиции);

						// Заполнение табличной части "РесурсыПозицийАкта".
						ОбновитьТЧРесурсыПозицийАкта(ОбъектАкт,СтрокаДерева,ПроцентоватьАкт,?(СтрокаДерева.ОбъемПоАктуПроцент<>0 И Процент=0, СтрокаДерева.ОбъемПоАктуПроцент, Процент),
						?(СтруктураПараметров.Свойство("МассивПозиций"),СтруктураПараметров.МассивПозиций,Неопределено));

					Иначе
						
						// ********************************
						// ++ AVV - Обновление цвета в акте
						Если ТекущаяСтрокаПозиции <> Неопределено Тогда
							ТекПозиция = ТекущаяСтрокаПозиции.Позиция;
							СтруктураОтбора = Новый Структура;
							СтруктураОтбора.Вставить("Позиция",ТекПозиция);
							МассивСтрок = ОбъектАкт.Позиции.НайтиСтроки(СтруктураОтбора);
							Для Каждого ТекСтрока Из МассивСтрок Цикл
								СтрокаДерева.ОтмеченаВДереве = ТекСтрока.ОтмеченаВАкте;	
							КонецЦикла;	
						КонецЕсли;
						// -- AVV 
						// ********************************
	
					КонецЕсли;
					
				КонецЕсли;
				
				Попытка
					Если СтрокаДерева.ОбъемВсего >= ОбъемРабот Тогда
						СтрокаДерева.СтатусРедактирования = 2;
					ИначеЕсли СтрокаДерева.ОбъемВсего = 0 Тогда	
						СтрокаДерева.СтатусРедактирования = 0;
					ИначеЕсли СтрокаДерева.ОбъемВсего < ОбъемРабот Тогда	
						СтрокаДерева.СтатусРедактирования = 1;
					Иначе
						СтрокаДерева.СтатусРедактирования = 0;
					КонецЕсли;
				Исключение
					СтрокаДерева.СтатусРедактирования = СтрокаДерева.СтатусРедактирования;
				КонецПопытки;
				
			ИначеЕсли Найти(Действие,"СметаНаОстаток") > 0 Тогда	
				Если СтруктураПараметров.ВыполнениеСметы.Количество() = 0 Тогда
					ОбъемРабот = СтрокаУровня.ОбъемРабот;
				Иначе
					НайденнаяСтрока = СтруктураПараметров.ВыполнениеСметы.Найти(СтрокаДерева.СтараяСсылка);
					Если НайденнаяСтрока <> Неопределено Тогда
						ОбъемРабот = НайденнаяСтрока.ФактОбъем;	
					КонецЕсли;
				КонецЕсли;
				Если ОбъемРабот <> СтрокаДерева.Элемент.ОбъемРабот Тогда
					ДокОб = СМ_СметаВызовСервера.ПолучитьОбъектСтрокиДереваСмет(СтрокаДерева);
					ДокОб.ОбъемРабот = ОбъемРабот;
					ДокОб.Записать(?(ДокОб.Проведен,РежимЗаписиДокумента.Проведение,РежимЗаписиДокумента.Запись));
				КонецЕсли;
			КонецЕсли;
			
			Если Не ЭтоГрупповаяОбработкаПозиций Тогда
			
				// Позиция привязана.
				Если ЗначениеЗаполнено(СтрокаУровня.ИДПозицииВладельца) Тогда
					СтрокаДерева.ИндексПривязана = 0;
				КонецЕсли;
				
				// Не применять индексы.
				Если СтрокаУровня.НеПрименятьИндексы Тогда
					СтрокаДерева.ИндексНеИндексировать = 0;	
				КонецЕсли;
				
				// Заданы коэффициенты пересчета.
				Если ОбъектАкт = Неопределено ИЛИ Найти(Действие,"СметаНаОстаток") <> 0 Тогда
					Если ОбъектСмета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка И ОбъектСмета.МетодРасчета=Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный Тогда
						Если СтрокаДерева.Элемент.КоэффициентыПересчета.Количество() > 0 Тогда						
							СтрокаДерева.ИндексПересчет = 0;
						КонецЕсли;
					КонецЕсли;
				Иначе
					СтрокаПозиции = ОбъектАкт.Ссылка.Позиции.Найти(СтрокаДерева.Элемент,"Позиция");
					Если СтрокаПозиции<>Неопределено Тогда
						Если (СтрокаПозиции.КоэффОснЗарплаты<>0 И СтрокаПозиции.КоэффОснЗарплаты<>1)
							 ИЛИ (СтрокаПозиции.КоэффСтоимЭксплМашин<>0 И СтрокаПозиции.КоэффСтоимЭксплМашин<>1) 
							 ИЛИ (СтрокаПозиции.КоэффСтоимЗарплатеМашин<>0 И СтрокаПозиции.КоэффСтоимЗарплатеМашин<>1)
							 ИЛИ (СтрокаПозиции.КоэффСтоимМатериалов<>0 И СтрокаПозиции.КоэффСтоимМатериалов<>1)
							 ИЛИ (СтрокаПозиции.КоэффОборуд<>0 И СтрокаПозиции.КоэффОборуд<>1)
							 ИЛИ (СтрокаПозиции.КоэффПолнСтоимРабот<>0 И СтрокаПозиции.КоэффПолнСтоимРабот<>1) Тогда
						Если ОбъектСмета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка И ОбъектСмета.МетодРасчета=Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный  Тогда
							СтрокаДерева.ИндексПересчет = 0;
						КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				// Поправки по тех. частям позиции.
				Если СтрокаДерева.Элемент.ПоправкиПозиции.Количество() > 0 Тогда
					нОтбор = Новый Структура;
					нОтбор.Вставить("Применить",истина);
					нСтроки = СтрокаДерева.Элемент.ПоправкиПозиции.найтиСтроки(нОтбор);
					Если нСтроки.количество() > 0 Тогда
						СтрокаДерева.ИндексПоправки = 0;
					КонецЕсли;
				КонецЕсли;
				
				СтрокаДерева.Картинка = ПолучитьКартинкуСтрокиАктаСметы(СтрокаДерева.Элемент);
				
			КонецЕсли;
		
		КонецЕсли;
		//ЧМА{
		СтрокаДерева.ПроверкаЗаполненияРеквизитов = ЗначениеЗаполнено(СтрокаДерева.Элемент.Определитель) и ЗначениеЗаполнено(СтрокаДерева.Элемент.ЕдиницаИзмерения);
		//ЧМА}
	КонецЕсли;
	
	Попытка
		СтрокаДерева.СтатусРедактирования = ?(Не РазрешитьРедактирование И СтрокаДерева.СтатусРедактирования = 1,2,СтрокаДерева.СтатусРедактирования);
	Исключение
		РазрешитьРедактирование = РазрешитьРедактирование;
	КонецПопытки;
	
	Если ЭтоГрупповаяОбработкаПозиций Тогда
		Возврат;
	КонецЕсли;

	
	Смета = ОбъектСмета.Ссылка;

	Если (Не Временное) И ОбновлениеДерева Тогда  
		
		Если ОбъектАкт = Неопределено Тогда
			Округлять = ОбъектСмета.ОкруглятьДоРублей;
		Иначе	
			Округлять = ОбъектАкт.ОкруглятьДоРублей;
			Если ТипЗнч(СтрокаДерева.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда 
				Если Найти(Действие,"СметаНаОстаток") = 0 Тогда
					ОбъемРабот = СтрокаДерева.ОбъемПоАкту;
				Иначе
					ОбъемРабот = 1;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
			
		СтрокаДерева.Наименование = СтрокаУровня.Наименование;
		
		Если Округлять Тогда
			СтрокаДерева.ОбщВсего 				= Окр(СтрокаУровня.ОбщВсего * ОбъемРабот,0);
			СтрокаДерева.ОбщОснЗП 				= Окр(СтрокаУровня.ОснЗарплата * ОбъемРабот,0);
			СтрокаДерева.ОбщЭксплМашин 			= Окр(СтрокаУровня.ЭксплМашин * ОбъемРабот,0);
			СтрокаДерева.ОбщЭМЗарПлата 			= Окр(СтрокаУровня.ЗарплМашин * ОбъемРабот,0);
			СтрокаДерева.ОбщСтоимостьМатериалов = Окр(СтрокаУровня.СтоимМатер * ОбъемРабот,0);
		Иначе
			СтрокаДерева.ОбщВсего 				= СтрокаУровня.ОбщВсего * ОбъемРабот;
			СтрокаДерева.ОбщОснЗП 				= СтрокаУровня.ОснЗарплата * ОбъемРабот;
			СтрокаДерева.ОбщЭксплМашин 			= СтрокаУровня.ЭксплМашин * ОбъемРабот;
			СтрокаДерева.ОбщЭМЗарПлата 			= СтрокаУровня.ЗарплМашин * ОбъемРабот;
			СтрокаДерева.ОбщСтоимостьМатериалов = СтрокаУровня.СтоимМатер * ОбъемРабот;
		КонецЕсли;
		
		СтрокаДерева.ОбщЗатрТрРаб 			= СтрокаУровня.ЗатратыТрудаРабочих * ОбъемРабот;
		СтрокаДерева.ОбщЗатрТрМех 			= СтрокаУровня.ЗатратыТрудаМашин * ОбъемРабот;
		
		СтрокаДерева.ОбоснСметнойСтоим 		= СформироватьОбоснованиеСметнойСтоимости(СтрокаУровня, СтруктураПараметров.ОтображатьПрефиксы);
		СтрокаДерева.Версия			 		= СтрокаУровня.Версия;
		СтрокаДерева.НаимРаботИЗатрат 		= СтрокаУровня.Наименование;
		СтрокаДерева.Кол 					= СтрокаУровня.ОбъемРабот;
		СтрокаДерева.Измеритель 			= СтрокаУровня.Измеритель;
		
	КонецЕсли;
		
КонецПроцедуры

// Формирует обоснование сметной стоимости
//
Функция СформироватьОбоснованиеСметнойСтоимости(СтрокаУровня, ОтображатьПрефиксы)
	
	Если ТипЗнч(СтрокаУровня.Ссылка) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = СтрокаУровня.ШифрРасценки;
	
	Если ОтображатьПрефиксы Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПрефиксыРасценок.Наименование КАК Префикс
		               |ИЗ
		               |	Справочник.СМ_ПрефиксыРасценок КАК ПрефиксыРасценок
		               |ГДЕ
		               |	ПрефиксыРасценок.ТипНормативногоСборника = &ТипНормативногоСборника
		               |	И ПрефиксыРасценок.РегиональнаяБаза = &РегиональнаяБаза";
		Запрос.УстановитьПараметр("ТипНормативногоСборника",	СтрокаУровня.Ссылка.ТипНормативныхСборников);			   
		Запрос.УстановитьПараметр("РегиональнаяБаза",			СтрокаУровня.Ссылка.РегиональнаяБаза);
		
		Выборка = запрос.Выполнить().Выбрать();
		Если выборка.Следующий() Тогда
			Результат = Сокрлп(Выборка.Префикс) + Результат;
		Иначе
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	ПрефиксыРасценок.Наименование КАК Префикс
			               |ИЗ
			               |	Справочник.СМ_ПрефиксыРасценок КАК ПрефиксыРасценок
			               |ГДЕ
			               |	ПрефиксыРасценок.ТипНормативногоСборника = &ТипНормативногоСборника";
			Запрос.УстановитьПараметр("ТипНормативногоСборника",	СтрокаУровня.Ссылка.ТипНормативныхСборников);			   
			Выборка = запрос.Выполнить().Выбрать();
			Если выборка.Следующий() Тогда
				Результат = Сокрлп(Выборка.Префикс) + Результат;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

// Копирование индексов расздела и обновление ТЧ "Разделы" акта.
//
Процедура ОбновитьТЧРазделыАкта(ОбъектАкт,СтрокаДерева)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Раздел",СтрокаДерева.Элемент);
	
	МассивСтрок = ОбъектАкт.Разделы.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() = 0 Тогда
	
		НоваяСтрока 						= ОбъектАкт.Разделы.Добавить();
		НоваяСтрока.Раздел	 				= СтрокаДерева.Элемент;
		НоваяСтрока.КоэффОснЗарплаты        = СтрокаДерева.Элемент.КоэффОснЗарплаты;
		НоваяСтрока.КоэффСтоимЭксплМашин    = СтрокаДерева.Элемент.КоэффСтоимЭксплМашин;
		НоваяСтрока.КоэффСтоимЗарплатеМашин = СтрокаДерева.Элемент.КоэффСтоимЗарплатеМашин;
		НоваяСтрока.КоэффСтоимМатериалов    = СтрокаДерева.Элемент.КоэффСтоимМатериалов;
		НоваяСтрока.КоэффОборуд             = СтрокаДерева.Элемент.КоэффОборуд;
		НоваяСтрока.КоэффПолнСтоимРабот     = СтрокаДерева.Элемент.КоэффПолнСтоимРабот;
		
	КонецЕсли;

КонецПроцедуры

// Расчет показателей по регистру для ТЧ "Позиции" акта.
//
Процедура РасчитатьТекСтоимостьНаОбъемРегистр(СтрокаПозиции)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СУММА(СМ_РесурснаяСтоимостьПозиции.ТекСтоимЗарплМашин) КАК ТекущаяЗарплМашинистов,
	|	СУММА(СМ_РесурснаяСтоимостьПозиции.ТекСтоимОснЗарплата) КАК ТекущаяОснЗарплата,
	|	СУММА(СМ_РесурснаяСтоимостьПозиции.ТекСтоимПрямЗатраты) КАК ТекущаяПрямЗатраты,
	|	СУММА(СМ_РесурснаяСтоимостьПозиции.ТекСтоимСтоимМатер) КАК ТекущаяСтоимМатериалов,
	|	СУММА(СМ_РесурснаяСтоимостьПозиции.ТекСтоимЭксплМашин) КАК ТекущаяЭксплМашин,
	|	СМ_РесурснаяСтоимостьПозиции.Позиция
	|ИЗ
	|	РегистрСведений.СМ_РесурснаяСтоимостьПозиции КАК СМ_РесурснаяСтоимостьПозиции
	|ГДЕ
	|	СМ_РесурснаяСтоимостьПозиции.Смета = &Смета
	|	И СМ_РесурснаяСтоимостьПозиции.Позиция = &Позиция
	|	И СМ_РесурснаяСтоимостьПозиции.Раздел = &Раздел
	|
	|СГРУППИРОВАТЬ ПО
	|	СМ_РесурснаяСтоимостьПозиции.Позиция";
	Запрос.УстановитьПараметр("Смета",СтрокаПозиции.Позиция.ИДСметы);
	Запрос.УстановитьПараметр("Позиция",СтрокаПозиции.Позиция.Ссылка);
	Запрос.УстановитьПараметр("Раздел",СтрокаПозиции.Позиция.ИДРодителя);
	
	ТекПоказатели =  Запрос.Выполнить().Выгрузить();

	Если ТекПоказатели.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Показатели = ТекПоказатели[0];
	РегТекущаяОснЗарплата = Показатели.ТекущаяОснЗарплата;
	РегТекущаяЭксплМашин = Показатели.ТекущаяЭксплМашин;
	РегТекущаяЗарплМашинистов = Показатели.ТекущаяЗарплМашинистов;
	РегТекущаяСтоимМатериалов = Показатели.ТекущаяСтоимМатериалов;
	РегТекущаяПрямЗатраты = Показатели.ТекущаяПрямЗатраты;
	
	СтрокаПозиции.ТекущаяОснЗарплата = РегТекущаяОснЗарплата;
	СтрокаПозиции.ТекущаяЭксплМашин = РегТекущаяЭксплМашин;
	СтрокаПозиции.ТекущаяЗарплМашинистов = РегТекущаяЗарплМашинистов;
	СтрокаПозиции.ТекущаяСтоимМатериалов = РегТекущаяСтоимМатериалов;
	СтрокаПозиции.ТекущаяПрямЗатраты = РегТекущаяПрямЗатраты;
КонецПроцедуры

// Копирование индексов позиции и обновление ТЧ "Позиции" акта.
//
Процедура ОбновитьТЧПозицииАкта(КопироватьИндексы,ОбъектСмета,ОбъектАкт,СтрокаДерева,ТекущаяСтрокаПозиции,УдалитьПринудительно = Ложь)
	
	Если ТекущаяСтрокаПозиции = Неопределено Тогда
		НоваяСтрока 				= ОбъектАкт.Позиции.Добавить();
		НоваяСтрока.СтатусРесурса   = СтрокаДерева.Элемент.СтатусРесурса;
	Иначе
		НоваяСтрока	= ТекущаяСтрокаПозиции;
		Если УдалитьПринудительно Тогда
			НоваяСтрока.ФактОбъем = 0; // Обновляем независио не от чего.
		КонецЕсли;
	КонецЕсли;
	
	// Заполнение строки ТЧ "Позиции" основными показателями.
	Если (НоваяСтрока.ФактОбъем <> СтрокаДерева.ОбъемПоАкту) ИЛИ (НоваяСтрока.Позиция <> СтрокаДерева.Элемент) Тогда
		НоваяСтрока.ФактОбъем 					= СтрокаДерева.ОбъемПоАкту;
		НоваяСтрока.ФактРасход					= СтрокаДерева.ОбъемПоАкту;
		НоваяСтрока.НормРасход					= СтрокаДерева.ОбъемПоАкту;
		НоваяСтрока.Позиция 					= СтрокаДерева.Элемент;
		НоваяСтрока.ТекущаяЦена					= СтрокаДерева.Элемент.ТекущаяЦена;
		НоваяСтрока.ТекущаяЗарплатаМашинистов	= СтрокаДерева.Элемент.ТекущаяЗарплатаМашинистов;
		
		МассивРесурсов = СтрокаДерева.Элемент.РесурсыПозицииЛокальнойСметы.НайтиСтроки(Новый Структура("Удален",Ложь));
		Если МассивРесурсов.Количество() > 0 И ОбъектАкт.ЛокальнаяСмета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
			РасчитатьТекСтоимостьНаОбъемРегистр(НоваяСтрока);
		Иначе	
			НоваяСтрока.ТекущаяПрямЗатраты		= СтрокаДерева.Элемент.ТекущаяПрямЗатраты;
			НоваяСтрока.ТекущаяОснЗарплата		= СтрокаДерева.Элемент.ТекущаяОснЗарплата;
			НоваяСтрока.ТекущаяЭксплМашин		= СтрокаДерева.Элемент.ТекущаяЭксплМашин;
			НоваяСтрока.ТекущаяЗарплМашинистов	= СтрокаДерева.Элемент.ТекущаяЗарплМашинистов;
			НоваяСтрока.ТекущаяСтоимМатериалов	= СтрокаДерева.Элемент.ТекущаяСтоимМатериалов;
		КонецЕсли;
		НоваяСтрока.ФормулаТекущейЦены	= СтрокаДерева.Элемент.ФормулаТекущейЦены;
		НоваяСтрока.ФормулаТекущейПЗ	= СтрокаДерева.Элемент.ФормулаТекущейПЗ;
		НоваяСтрока.ФормулаТекущейОЗ	= СтрокаДерева.Элемент.ФормулаТекущейОЗ;
		НоваяСтрока.ФормулаТекущейЭМ	= СтрокаДерева.Элемент.ФормулаТекущейЭМ;
		НоваяСтрока.ФормулаТекущейЗМ	= СтрокаДерева.Элемент.ФормулаТекущейЗМ;
		НоваяСтрока.ФормулаТекущейСМ	= СтрокаДерева.Элемент.ФормулаТекущейСМ;
		НоваяСтрока.ОтмеченаВАкте		= СтрокаДерева.ОтмеченаВДереве;
	//	НоваяСтрока.СтатусРесурса       = СтрокаДерева.Элемент.СтатусРесурса;
	КонецЕсли;
	
	// Заполнение строки ТЧ "Позиции" значениями коэффифиентов.
	КоличествоИндексовПересчета = СтрокаДерева.Элемент.КоэффициентыПересчета.Количество(); 
	Если КопироватьИндексы И КоличествоИндексовПересчета > 0
		И ОбъектСмета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка Тогда
		ТекСтрокаТЧ 							= СтрокаДерева.Элемент.КоэффициентыПересчета[0];
		НоваяСтрока.ВидРабот                    = ТекСтрокаТЧ.ВидРабот;
		НоваяСтрока.КоэффОснЗарплаты        	= ТекСтрокаТЧ.КоэффОснЗарплаты;
		НоваяСтрока.КоэффСтоимЭксплМашин    	= ТекСтрокаТЧ.КоэффСтоимЭксплМашин;
		НоваяСтрока.КоэффСтоимЗарплатеМашин 	= ТекСтрокаТЧ.КоэффСтоимЗарплатеМашин;
		НоваяСтрока.КоэффСтоимМатериалов    	= ТекСтрокаТЧ.КоэффСтоимМатериалов;
		НоваяСтрока.КоэффОборуд             	= ТекСтрокаТЧ.КоэффОборуд;
		НоваяСтрока.КоэффПолнСтоимРабот     	= ТекСтрокаТЧ.КоэффПолнСтоимРабот;			
	КонецЕсли;
	
	// Если в локальной смете включен флаг "методика ТСН".
	// происходит заполнение строки ТЧ "Позиции" значениями НР, СП, зимнего удорожания. 
	//Если ОбъектСмета.МетодикаТСН Тогда
	Если ОбъектСмета.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква Тогда
		ТекЭлементДерева 							= СтрокаДерева.Элемент;
		НоваяСтрока.ЗимнееУдорож					= ТекЭлементДерева.ЗимнееУдорож;
		НоваяСтрока.ЗимнееУдорожМатериал            = ТекЭлементДерева.ЗимнееУдорожМатериал;
		НоваяСтрока.ЗимнееУдорожМатериалРемонт      = ТекЭлементДерева.ЗимнееУдорожМатериалРемонт;
		НоваяСтрока.ЗимнееУдорожРемонт              = ТекЭлементДерева.ЗимнееУдорожРемонт;
		НоваяСтрока.НРТСНБазисРемонт                = ТекЭлементДерева.НРТСНБазисРемонт;
		НоваяСтрока.НРТСНТекущиеРемонт              = ТекЭлементДерева.НРТСНТекущиеРемонт;
		НоваяСтрока.СПТСНБазисРемонт                = ТекЭлементДерева.СПТСНБазисРемонт;
		НоваяСтрока.СПТСНТекущиеРемонт              = ТекЭлементДерева.СПТСНТекущиеРемонт;
		НоваяСтрока.НакладныеРасходыБазисные        = ТекЭлементДерева.НакладныеРасходыБазисные;
		НоваяСтрока.НакладныеРасходыТекущие         = ТекЭлементДерева.НакладныеРасходыТекущие;
		НоваяСтрока.СметнаяПрибыльБазисные          = ТекЭлементДерева.СметнаяПрибыльБазисные;
		НоваяСтрока.СметнаяПрибыльТекущие           = ТекЭлементДерева.СметнаяПрибыльТекущие;
	КонецЕсли;
	
КонецПроцедуры

// Обновление табличной части "РесурсыПозицийАкта".
//
Процедура ОбновитьТЧРесурсыПозицийАкта(ОбъектАкт,СтрокаДерева,ПроцентоватьАкт,Процент,МассивПозиций=Неопределено,УдалитьПринудительно = Ложь) Экспорт
	
	РесурсыПронумерованы = (ОбъектАкт.РесурсыПозицийАкта.Итог("НомерСтрокиДокумента")>0);
	
	ОбработанныеКоды = Новый СписокЗначений();
	
	Если УдалитьПринудительно Тогда
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Позиция",СтрокаДерева.Элемент);
		МассивСтрок = ОбъектАкт.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
		Для Каждого Строка ИЗ МассивСтрок Цикл 
			ОбъектАкт.РесурсыПозицийАкта.Удалить(Строка);		
		КонецЦикла;       // Удаляем независио не от чего.
	КонецЕсли;
	
	Для Каждого ТекСтрока Из СтрокаДерева.Элемент.РесурсыПозицииЛокальнойСметы Цикл
		
		Если Не ТекСтрока.ТипМатериала = Перечисления.СМ_ТипыМатериалов.Учтенный Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Позиция",СтрокаДерева.Элемент);
		СтруктураОтбора.Вставить("Ресурс",ТекСтрока.Ресурс);
		СтруктураОтбора.Вставить("СметныйКодРесурса",ТекСтрока.СметныйКодРесурса);
		Если РесурсыПронумерованы или (ОбработанныеКоды.НайтиПоЗначению(ТекСтрока.СметныйКодРесурса) <> Неопределено) Тогда
			СтруктураОтбора.Вставить("НомерСтрокиДокумента",ТекСтрока.НомерСтроки);
		КонецЕсли;
		ОбработанныеКоды.Добавить(ТекСтрока.СметныйКодРесурса);
		
		МассивСтрок = ОбъектАкт.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 Тогда
			НоваяСтрока = МассивСтрок[0];	
		Иначе
			НоваяСтрока 						= ОбъектАкт.РесурсыПозицийАкта.Добавить();
			НоваяСтрока.Позиция 				= СтрокаДерева.Элемент;
			НоваяСтрока.НомерСтрокиДокумента 	= ТекСтрока.НомерСтроки;
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрока);
		КонецЕсли;
		
		НормаРасходаСПоправками = РассчитатьКоличество(ТекСтрока,СтрокаДерева.Элемент);
		Если ПроцентоватьАкт Тогда
			ИзменятьФактОбъем = (НоваяСтрока.ФактРасходаОбъем = НоваяСтрока.НормаРасходаОбъем);
			Если МассивПозиций = Неопределено  или НЕ МассивПозиций.Найти(СтрокаДерева.Элемент)=Неопределено Тогда
				НоваяСтрока.НормаРасходаОбъем = НормаРасходаСПоправками * СтрокаДерева.Элемент.ОбъемРабот * Процент / 100;
			КонецЕсли;
			НоваяСтрока.ФактРасходаОбъем = ?(ИзменятьФактОбъем, НоваяСтрока.НормаРасходаОбъем, НоваяСтрока.ФактРасходаОбъем);
			//	НормаРасходаОбъем = НоваяСтрока.Позиция.НормаРасходаРесурса * НоваяСтрока.Позиция.КоличествоРесурса * НоваяСтрока.ФактРасходаОбъем / НоваяСтрока.Позиция.ОбъемРабот (если последняя 0 - то и значение 0).
		ИначеЕсли (НоваяСтрока.НормаРасходаОбъем <> НормаРасходаСПоправками * СтрокаДерева.ОбъемПоАкту) Тогда
			ИзменятьФактОбъем = (НоваяСтрока.ФактРасходаОбъем = НоваяСтрока.НормаРасходаОбъем);
			НоваяСтрока.НормаРасходаОбъем = НормаРасходаСПоправками * СтрокаДерева.ОбъемПоАкту;
			НоваяСтрока.ФактРасходаОбъем = ?(ИзменятьФактОбъем, НоваяСтрока.НормаРасходаОбъем, НоваяСтрока.ФактРасходаОбъем);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Расчет Нормы расхода с поправками. 
// 
Функция РассчитатьКоличество(ТекСтрока,ЭлПозиция)
	
	Позиция = ЭлПозиция.ПолучитьОбъект();
	Если ТекСтрока.ТипМатериала = Перечисления.СМ_ТипыМатериалов.НеУчтенный ИЛИ ТекСтрока.ТипМатериала = Перечисления.СМ_ТипыМатериалов.ПоПроекту ИЛИ ТекСтрока.Удален Тогда
		Возврат(ТекСтрока.НормаРасхода);
	КонецЕсли;
	
	//Если Позиция.ИдСметы.МетодикаТСН Тогда
	Если Позиция.ИдСметы.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква Тогда
		// Применим ЗУ.
		ПрименитьЗУНормамМат = Позиция.ИдСметы.ПрименитьЗУНормамМат;
		ПрименитьЗУНормамМаш = Позиция.ИдСметы.ПрименитьЗУНормамМаш;
		ПрименитьЗУТрудРабочих =  Позиция.ИдСметы.ПрименитьЗУТрудРабочих;
		ПрименитьЗУТрудМашинистов = Позиция.ИдСметы.ПрименитьЗУТрудМашинистов;
		ТипСтроительстваРемонт = (Позиция.ИдСметы.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт);
	Иначе
		ПрименитьЗУНормамМат = Ложь;
		ПрименитьЗУНормамМаш = Ложь;
		ПрименитьЗУТрудРабочих =  Ложь;
		ПрименитьЗУТрудМашинистов = Ложь;
		ТипСтроительстваРемонт = Ложь;
	КонецЕсли;			

	Количество = ТекСтрока.НормаРасхода * ?(ЗначениеЗаполнено(ТекСтрока.КоэффициентКРасходуРесурсов),ТекСтрока.КоэффициентКРасходуРесурсов,1);
	
	СписокПоз = Новый СписокЗначений();
	СписокПоз.Добавить(Позиция.Ссылка);
	ТаблПоправок = СМ_СметаРасчетСервер.ПолучитьПоправки( СписокПоз,Ложь);
	
	Для каждого СтрокаТаблПоправок Из ТаблПоправок Цикл
		Если ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда	
			Количество = Количество * СтрокаТаблПоправок.КоэффициентКТрудозатратамРабочих;	
		ИначеЕсли ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда	
			Количество = Количество * СтрокаТаблПоправок.КоэффициентКТрудозатратамМашинистов;	
		ИначеЕсли ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда	
			Количество = Количество * СтрокаТаблПоправок.КоэффициентКСтоимостиМатериалов;	
		ИначеЕсли ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда	
			Количество = Количество * СтрокаТаблПоправок.КоэффициентКЭксплуатацииМашин;	
		КонецЕсли;
	КонецЦикла;
	Если ТипСтроительстваРемонт Тогда
		ЗимнееУдорож = ?(Позиция.ЗимнееУдорожРемонт = 0,1,Позиция.ЗимнееУдорожРемонт);
		ЗимнееУдорожМатериал = ?(Позиция.ЗимнееУдорожМатериалРемонт = 0,1,Позиция.ЗимнееУдорожМатериалРемонт);
	Иначе
		ЗимнееУдорож = ?(Позиция.ЗимнееУдорож = 0,1,Позиция.ЗимнееУдорож);
		ЗимнееУдорожМатериал = ?(Позиция.ЗимнееУдорожМатериал = 0,1,Позиция.ЗимнееУдорожМатериал);
	КонецЕсли;
	Если ПрименитьЗУТрудРабочих И ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
		Количество = Количество * ЗимнееУдорож;
	КонецЕсли;
	
	Если ПрименитьЗУТрудМашинистов И ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда
		Количество = Количество * ЗимнееУдорож;
	КонецЕсли;
	
	Если ПрименитьЗУНормамМаш И ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
		Количество = Количество * ЗимнееУдорож;
	КонецЕсли;
	
	Если ПрименитьЗУНормамМат И ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
		Количество = Количество * ЗимнееУдорожМатериал;
	КонецЕсли;
	Возврат(Количество);	
КонецФункции

// Получает выполнение сметы из регистра.
//
Функция ПолучитьВыполнениеСметы(ЛокальнаяСмета, Акт,МассивПозиций=Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ВыполнениеПоСметеОстаткиИОбороты.ЛокальнаяСмета,
	               |	СМ_ВыполнениеПоСметеОстаткиИОбороты.Позиция,
	               |	СУММА(СМ_ВыполнениеПоСметеОстаткиИОбороты.ОбъемПриход - СМ_ВыполнениеПоСметеОстаткиИОбороты.ОбъемРасход) КАК ФактОбъем,
	               |	СУММА(СМ_ВыполнениеПоСметеОстаткиИОбороты.ОбъемПриход) КАК ОбъемПриход,
	               |	СУММА(СМ_ВыполнениеПоСметеОстаткиИОбороты.ОбъемРасход) КАК ОбъемРасход
	               |ИЗ
	               |	РегистрНакопления.СМ_ВыполнениеПоСмете.ОстаткиИОбороты(
	               |			,
	               |			,
	               |			Регистратор,
	               |			,
	               |			ЛокальнаяСмета = &ЛС
	               |				И (&БезПозиций
	               |					ИЛИ Позиция В (&МассивПозиций))) КАК СМ_ВыполнениеПоСметеОстаткиИОбороты
	               |ГДЕ
	               |	СМ_ВыполнениеПоСметеОстаткиИОбороты.Позиция.Расчет
	               |	И СМ_ВыполнениеПоСметеОстаткиИОбороты.Регистратор <> &Акт
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_ВыполнениеПоСметеОстаткиИОбороты.ЛокальнаяСмета,
	               |	СМ_ВыполнениеПоСметеОстаткиИОбороты.Позиция
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СМ_ВыполнениеПоСметеОстаткиИОбороты.Позиция";
	
	Запрос.УстановитьПараметр("ЛС",ЛокальнаяСмета);
	Запрос.УстановитьПараметр("Акт",Акт);
	Запрос.УстановитьПараметр("БезПозиций",МассивПозиций=Неопределено);
	Запрос.УстановитьПараметр("МассивПозиций",МассивПозиций);
	
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	ТабРезультат.Свернуть("ЛокальнаяСмета,Позиция","ФактОбъем,ОбъемПриход,ОбъемРасход");
	
	Возврат ТабРезультат;	
	
КонецФункции

#КонецОбласти 

#Область ЗаполнениеДереваЗначений

// Найти необходимые для акта разделы.
//
Процедура НайтиРазделыКЗагрузке(МассивПоиска, ТекОбъект)
	НовыйМассивПоиска = Новый Массив;
	Для Каждого СтрокаМассива Из МассивПоиска Цикл
		Если Не ТипЗнч(СтрокаМассива.ИДРодителя) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			Если ТекОбъект.Разделы.Найти(СтрокаМассива.ИДРодителя) = Неопределено Тогда
				НоваяСтрока = ТекОбъект.Разделы.Добавить();
				НоваяСтрока.Раздел = СтрокаМассива.ИДРодителя;
				НоваяСтрока.ВидРабот = СтрокаМассива.ИДРодителя.ВидРабот;
				НоваяСтрока.КоэффОснЗарплаты = СтрокаМассива.ИДРодителя.КоэффОснЗарплаты;
				НоваяСтрока.КоэффСтоимЭксплМашин = СтрокаМассива.ИДРодителя.КоэффСтоимЭксплМашин;
				НоваяСтрока.КоэффСтоимЗарплатеМашин = СтрокаМассива.ИДРодителя.КоэффСтоимЗарплатеМашин;
				НоваяСтрока.КоэффСтоимМатериалов = СтрокаМассива.ИДРодителя.КоэффСтоимМатериалов;
				НоваяСтрока.КоэффОборуд = СтрокаМассива.ИДРодителя.КоэффОборуд;
				НоваяСтрока.КоэффПолнСтоимРабот = СтрокаМассива.ИДРодителя.КоэффПолнСтоимРабот;
				НовыйМассивПоиска.Добавить(СтрокаМассива.ИДРодителя);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если НовыйМассивПоиска.Количество()>0 Тогда
		НайтиРазделыКЗагрузке(НовыйМассивПоиска, ТекОбъект);	
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область РаботаСИндексамиПоРазделу

// Заполняет строку таблицы с индексами.
//
Процедура ЗаполнитьСтрокиИндексовТаблицы(МассивСтрок, ТаблицаРазделов, СтрокиДерева)
	
	Для Каждого ЗаписьРаздела Из МассивСтрок Цикл
		
		СтрокаИндексов = СтрокиДерева.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаИндексов, ЗаписьРаздела.Ид);
		СтрокаИндексов.Элемент = ЗаписьРаздела.Ид;
		СтрокаИндексов.НаименованиеРаздела = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Раздел №%1'"), СМ_СметаВызовСервера.ПолучитьТекстИнформацииОРазделе(ЗаписьРаздела.Ид));
		СтрокаИндексов.Обработка = Ложь;			
		
		Отбор = Новый Структура();
		Отбор.Вставить("ИдРодителя", ЗаписьРаздела.Ид);
		
		МассивСтрок = ТаблицаРазделов.НайтиСтроки(Отбор);
		
		ЗаполнитьСтрокиИндексовТаблицы(МассивСтрок, ТаблицаРазделов, СтрокаИндексов.Строки);
	
	КонецЦикла;
	
КонецПроцедуры

// Заполняет индексы в разделе.
//
Процедура ЗаполнитьИндексыРаздела(СтрокиДерева, ТаблицаРазделов, УдалитьСуществующие = Истина)
	
	Для Каждого ЗаписьРаздела Из СтрокиДерева Цикл
		
		Отбор = Новый Структура();
		Отбор.Вставить("Ид", СМ_СметаВызовСервера.ПолучитьСсылкуСтрокиДереваСмет(ЗаписьРаздела));
		
		МассивСтрок = ТаблицаРазделов.НайтиСтроки(Отбор);
		
		Если МассивСтрок.Количество() > 0 Тогда
			
			ДокументСсылка = СМ_СметаВызовСервера.ПолучитьСсылкуСтрокиДереваСмет(МассивСтрок[0], "Ид");
			
			Если (ДокументСсылка.КоэффПолнСтоимРабот <> ЗаписьРаздела.КоэффПолнСтоимРабот)
				ИЛИ (ДокументСсылка.КоэффОснЗарплаты <> ЗаписьРаздела.КоэффОснЗарплаты) 
				ИЛИ (ДокументСсылка.КоэффСтоимЭксплМашин <> ЗаписьРаздела.КоэффСтоимЭксплМашин) 
				ИЛИ (ДокументСсылка.КоэффСтоимЗарплатеМашин <> ЗаписьРаздела.КоэффСтоимЗарплатеМашин) 
				ИЛИ (ДокументСсылка.КоэффСтоимМатериалов <> ЗаписьРаздела.КоэффСтоимМатериалов) 
				ИЛИ (ДокументСсылка.КоэффОборуд <> ЗаписьРаздела.КоэффОборуд) Тогда
				
				ДокументОбъект = СМ_СметаВызовСервера.ПолучитьОбъектСтрокиДереваСмет(МассивСтрок[0], "Ид");
				
				ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗаписьРаздела, "КоэффПолнСтоимРабот, КоэффОснЗарплаты, КоэффСтоимЭксплМашин, КоэффСтоимЗарплатеМашин, КоэффСтоимМатериалов, КоэффОборуд");
				
				ДокументОбъект.Записать();
				
				Документы.СМ_РазделЛокальнойСметы.Перерасчет(ДокументОбъект, Истина, Ложь);	
				
			КонецЕсли;
			
			ЗаполнитьИндексыРаздела(ЗаписьРаздела.Строки, ТаблицаРазделов, УдалитьСуществующие);
			
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСДеревомCC

// Функция формирует таблицу с итогами по главам ССРС сводной сметы.
//
Функция ПолучитьГлавыИтогиПоГлавам(ТипСтроительства,Методика,СсылкаСС,МассивСмет,МассивЛЗ,ВТекущихЦенах) 
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	"""" КАК Глава,
	|	"""" КАК НомерГлавы,
	|	-1 КАК ПорядковыйНомерГлавы,
	|	"""" КАК НаименованиеГлавы,
	|	"""" КАК ТипСтроительства, 
	|	"""" КАК Итог,
	|	"""" КАК НаименованиеИтога,
	|	"""" КАК ПорядковыйНомерИтога,
	|	СМ_СводнаяСмета.Ссылка КАК Элемент,
	|	"""" КАК ИДродителя,
	|	ВложенныйЗапрос.СтроительныеРаботы КАК СтроительныеРаботы,
	|	ВложенныйЗапрос.МонтажныеРаботы КАК МонтажныеРаботы,
	|	ВложенныйЗапрос.Оборудование КАК Оборудование,
	|	ВложенныйЗапрос.Прочие КАК Прочие,
	|	ВложенныйЗапрос.ОплатаТруда КАК ОплатаТруда,
	|	0 КАК ТекПозиция,
	|	ИСТИНА КАК Расчет
	|ИЗ
	|	Документ.СМ_СводнаяСмета КАК СМ_СводнаяСмета
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СМ_ИтогиПоГлавамСС.Смета КАК Смета,
	|			// СтроительныеРаботы
	|			СУММА(ВЫБОР
	|					КОГДА СМ_ИтогиПоГлавамСС.ВидРабот = &ВидРаботСтроитРаботы
	|							ИЛИ СМ_ИтогиПоГлавамСС.ВидРабот = &ВидРаботМеталлоконстр
	|							ИЛИ СМ_ИтогиПоГлавамСС.ВидРабот = &ВидРаботСантехнРаб
	|							ИЛИ СМ_ИтогиПоГлавамСС.ВидРабот = &ВидРаботБуровзрывнРаб
	|							ИЛИ СМ_ИтогиПоГлавамСС.ВидРабот = &ВидРаботГорнопрохРаб
	|						ТОГДА СМ_ИтогиПоГлавамСС." + ?(ВТекущихЦенах,"Тек","")+"ПрямЗатраты
	|					ИНАЧЕ 0
	|				КОНЕЦ) КАК СтроительныеРаботы,
	|			// МонтажныеРаботы
	|			СУММА(ВЫБОР
	|					КОГДА СМ_ИтогиПоГлавамСС.ВидРабот = &ВидРаботМонтажнРаб
	|						ТОГДА СМ_ИтогиПоГлавамСС." + ?(ВТекущихЦенах,"Тек","")+"ПрямЗатраты
	|					ИНАЧЕ 0
	|				КОНЕЦ) КАК МонтажныеРаботы,
	|			// Оборудование
	|			СУММА(ВЫБОР
	|					КОГДА СМ_ИтогиПоГлавамСС.ВидРабот = &ВидРаботОборудование
	|						ТОГДА СМ_ИтогиПоГлавамСС." + ?(ВТекущихЦенах,"Тек","")+"Оборуд
	|					ИНАЧЕ 0
	|				КОНЕЦ) КАК Оборудование,
	|			// Прочие
	|			СУММА(ВЫБОР
	|					КОГДА СМ_ИтогиПоГлавамСС.ВидРабот = &ВидРаботПрочие
	|						ТОГДА СМ_ИтогиПоГлавамСС." + ?(ВТекущихЦенах,"Тек","")+"ПрямЗатраты
	|					ИНАЧЕ 0
	|				КОНЕЦ) КАК Прочие,
	|			// ОплатаТруда 
	|			СУММА(СМ_ИтогиПоГлавамСС." + ?(ВТекущихЦенах,"Тек","")+"ОснЗарплата + СМ_ИтогиПоГлавамСС.ЗатратыТрудаМашин) КАК ОплатаТруда
	|		ИЗ
	|			РегистрСведений.СМ_ИтогиПоГлавамСС КАК СМ_ИтогиПоГлавамСС
	|		ГДЕ
	|			СМ_ИтогиПоГлавамСС.Итог = &ИтогоПоСмете
	|			И СМ_ИтогиПоГлавамСС.Смета = &СсылкаСС
	|		
	|		СГРУППИРОВАТЬ ПО
	|			СМ_ИтогиПоГлавамСС.Смета) КАК ВложенныйЗапрос
	|		ПО СМ_СводнаяСмета.Ссылка = ВложенныйЗапрос.Смета
	|ГДЕ
	|	СМ_СводнаяСмета.Ссылка = &СсылкаСС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СМ_ГлавыССРС.Ссылка КАК Глава,
	|	СМ_ГлавыССРС.НомерГлавы КАК НомерГлавы,
	|	СМ_ГлавыССРС.ПорядковыйНомер КАК ПорядковыйНомерГлавы,
	|	СМ_ГлавыССРС.Наименование КАК НаименованиеГлавы,
	|	СМ_ГлавыССРС.ТипСтроительства КАК ТипСтроительства, 
