	|										И ЕСТЬNULL(Рег.СтоимОснЗарплата, 0) + ЕСТЬNULL(Рег.СтоимЭксплМашин, 0) + ЕСТЬNULL(Рег.СтоимСтоимМатер, 0) = 0
	|									ТОГДА ПозицияЛокальнойСметыДок.ПрямЗатраты
