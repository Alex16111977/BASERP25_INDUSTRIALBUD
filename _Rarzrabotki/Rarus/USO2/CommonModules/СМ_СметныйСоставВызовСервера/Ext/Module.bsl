	ЭлементКорня = СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(ОбъектСмета); 
	
	Если ДеревоЗначений <> Неопределено Тогда
		Если ДеревоЗначений.Строки.Количество() > 0 Тогда
			ДеревоЗначений.Строки.Очистить();
		КонецЕсли;
	Иначе
		ДеревоЗначений = Новый ДеревоЗначений();
		ДеревоЗначений.Колонки.Добавить("Элемент");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Текст = ПолучитьТекстЗапросаНаДеревоСоставаАктаФильтрОбъем();
	
