	               |	СУММА(ИтогиПозиция.БазисныеПЗ) * &Объем КАК БазисныеПЗНаОбъем,
	               |	СУММА(ИтогиПозиция.БазисныеОЗ) * &Объем КАК БазисныеОЗНаОбъем,
	               |	СУММА(ИтогиПозиция.БазисныеЭМ) * &Объем КАК БазисныеЭМНаОбъем,
	               |	СУММА(ИтогиПозиция.БазисныеЗМ) * &Объем КАК БазисныеЗМНаОбъем,
	               |	СУММА(ИтогиПозиция.БазисныеМАТ) * &Объем КАК БазисныеМАТНаОбъем,
	               |	СУММА(ИтогиПозиция.БазисныеОБ) * &Объем КАК БазисныеОБНаОбъем,
	               |	СУММА(ИтогиПозиция.БазисныеВМАТ) * &Объем КАК БазисныеВМАТНаОбъем,
	               |	СУММА(ИтогиПозиция.БазисныеЗТР) * &Объем КАК БазисныеЗТРНаОбъем,
	               |	СУММА(ИтогиПозиция.БазисныеЗТМ) * &Объем КАК БазисныеЗТМНаОбъем,
	               |	СУММА(ИтогиПозиция.ТекущиеОЗ) * &Объем КАК ТекущиеОЗНаОбъем,
	               |	СУММА(ИтогиПозиция.ТекущиеПЗ) * &Объем КАК ТекущиеПЗНаОбъем,
	               |	СУММА(ИтогиПозиция.ТекущиеЭМ) * &Объем КАК ТекущиеЭМНаОбъем,
	               |	СУММА(ИтогиПозиция.ТекущиеЗМ) * &Объем КАК ТекущиеЗМНаОбъем,
	               |	СУММА(ИтогиПозиция.ТекущиеМАТ) * &Объем КАК ТекущиеМАТНаОбъем,
	               |	СУММА(ИтогиПозиция.ТекущиеОБ) * &Объем КАК ТекущиеОБНаОбъем,
	               |	СУММА(ИтогиПозиция.ТекущиеВМАТ) * &Объем КАК ТекущиеВМАТНаОбъем,
	               |	СУММА(ИтогиПозиция.ТекущиеЗТР) * &Объем КАК ТекущиеЗТРНаОбъем,
	               |	СУММА(ИтогиПозиция.ТекущиеЗТМ) * &Объем КАК ТекущиеЗТМНаОбъем,
	               |	СУММА(ИтогиПозиция.БазисныеНРСумма) КАК БазисныеНРСумма,
	               |	СУММА(ИтогиПозиция.БазисныеНРСуммаНаОбъем) КАК БазисныеНРСуммаНаОбъем,
	               |	СУММА(ИтогиПозиция.БазисныеСПСумма) КАК БазисныеСПСумма,
	               |	СУММА(ИтогиПозиция.БазисныеСПСуммаНаОбъем) КАК БазисныеСПСуммаНаОбъем,
	               |	СУММА(ИтогиПозиция.ТекущиеНРСумма) КАК ТекущиеНРСумма,
	               |	СУММА(ИтогиПозиция.ТекущиеНРСуммаНаОбъем) КАК ТекущиеНРСуммаНаОбъем,
	               |	СУММА(ИтогиПозиция.ТекущиеСПСумма) КАК ТекущиеСПСумма,
	               |	СУММА(ИтогиПозиция.ТекущиеСПСуммаНаОбъем) КАК ТекущиеСПСуммаНаОбъем
	               |ИЗ  
	               |	ИтогиПозиция КАК ИтогиПозиция
	               |";
	
	Запрос.УстановитьПараметр("Смета", ?(Не ЗначениеЗаполнено(Акт), Смета, Акт));
	Запрос.УстановитьПараметр("Раздел", Раздел);
	Запрос.УстановитьПараметр("Позиция", Позиция);
	Запрос.УстановитьПараметр("Объем", Объем);
	Запрос.УстановитьПараметр("БазисноИндексныйПоРасценке", ((Смета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный)И(Смета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка)));
	Запрос.УстановитьПараметр("Ресурсный", ((Смета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный) ИЛИ (ОбъектПозиция = Неопределено)));
	
	ПараметрыЧисла = Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(20, 6));
	
	ТаблицаПозиция = Новый ТаблицаЗначений();
	ТаблицаПозиция.Колонки.Добавить("ПрямЗатраты",ПараметрыЧисла);
    ТаблицаПозиция.Колонки.Добавить("ОснЗарплата",ПараметрыЧисла);
    ТаблицаПозиция.Колонки.Добавить("ЭксплМашин",ПараметрыЧисла);
    ТаблицаПозиция.Колонки.Добавить("ЗарплМашинистов",ПараметрыЧисла);
    ТаблицаПозиция.Колонки.Добавить("СтоимМатериалов",ПараметрыЧисла);
    ТаблицаПозиция.Колонки.Добавить("Оборудование",ПараметрыЧисла);
    ТаблицаПозиция.Колонки.Добавить("ВозвратМатер",ПараметрыЧисла);
    ТаблицаПозиция.Колонки.Добавить("ЗатратыТрудаРабочих",ПараметрыЧисла);
    ТаблицаПозиция.Колонки.Добавить("ЗатратыТрудаМашинистов",ПараметрыЧисла);

	Если ОбъектПозиция <> Неопределено Тогда
				
		СтрокаПозиция = ТаблицаПозиция.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаПозиция, ОбъектПозиция); 
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ЗаписьПозиция",ТаблицаПозиция);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
	    Возврат Выборка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;                		
	
КонецФункции

// Возвращает текст с итогами текущей строки дерева состава.
//
// Параметры:
//     ДокументСмета 			- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету.
//	   ВыделенныеСтроки	    	- Массив - выделенные строки на форме состава.
//     СтруктураПараметровЛС 	- Структура - содержит реквизиты Локальной сметы (см. 
//								  СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС).   
//
// Возвращаемое значение:
//     ТекстИтога - Строка - содержит значения итога строк.
//
Функция ВывестиСтрокуИтога(ДокументСмета, ВыделенныеСтроки, СтруктураПараметровЛС = Неопределено) Экспорт
	
	ТекстИтога = "";
	
	Если СтруктураПараметровЛС = Неопределено Тогда
		СтруктураПараметровЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(ДокументСмета);
	КонецЕсли;
	
	Если СтруктураПараметровЛС.ОкруглятьДоРублей Тогда
		СтрокаФорматирования = "ЧДЦ=0";
	Иначе
		СтрокаФорматирования = "ЧДЦ=2";
	КонецЕсли;
	
	МассивСмет = ВыделенныеСтроки.МассивСмет;
	МассивРазделов = ВыделенныеСтроки.МассивРазделов;
	МассивПозиций = ВыделенныеСтроки.МассивПозиций;
	
	// Добавим вышестоящие	
	Если (МассивСмет.Количество() = 0) и (МассивРазделов.Количество() = 0) Тогда
	
		Для Каждого ТекПозиция Из МассивПозиций Цикл
			
			ВышестоящийРаздел = ТекПозиция.ИдСметы;
		
			Если ТипЗнч(ВышестоящийРаздел) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
				ИндексЭлемента = МассивСмет.Найти(ВышестоящийРаздел);
				Если ИндексЭлемента = Неопределено Тогда
					МассивСмет.Добавить(ВышестоящийРаздел);
				КонецЕсли;
			КонецЕсли;

		КонецЦикла;
		
	ИначеЕсли (МассивСмет.Количество() = 0) и (МассивРазделов.Количество() > 0) Тогда
		
		Для Каждого ТекПозиция Из МассивРазделов Цикл
			
			ВышестоящийРаздел = ТекПозиция.ИдСметы;
		
			Если ТипЗнч(ВышестоящийРаздел) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
				ИндексЭлемента = МассивСмет.Найти(ВышестоящийРаздел);
				Если ИндексЭлемента = Неопределено Тогда
					МассивСмет.Добавить(ВышестоящийРаздел);
				КонецЕсли;
			КонецЕсли;

		КонецЦикла;
		
	КонецЕсли;
	
	Если (МассивПозиций.Количество() > 0) Тогда

		Для Каждого ТекПозиция Из МассивПозиций Цикл
				
			ТекРаздел = ТекПозиция.ИдРодителя;
			     
			Пока (ЗначениеЗаполнено(ТекРаздел)) и (ТекРаздел <> ДокументСмета) Цикл 
				
				ВышестоящийРаздел = ТекРаздел;
				ТекРаздел = ТекРаздел.ИдРодителя;
				
			КонецЦикла;
			
			Если ТипЗнч(ВышестоящийРаздел) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
				ИндексЭлемента = МассивСмет.Найти(ВышестоящийРаздел);
				Если ИндексЭлемента = Неопределено Тогда
					МассивСмет.Добавить(ВышестоящийРаздел);
				КонецЕсли;
			ИначеЕсли ТипЗнч(ВышестоящийРаздел) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда 
				ИндексЭлемента = МассивРазделов.Найти(ВышестоящийРаздел);
				Если ИндексЭлемента = Неопределено Тогда
					МассивРазделов.Добавить(ВышестоящийРаздел);
				КонецЕсли;
			КонецЕсли;

		КонецЦикла; 
		
	КонецЕсли;
	
	Если МассивСмет.Количество() > 0 Тогда
		// Выводим итог по смете
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	СМ_ИтогиПоСмете.ТекПрямЗатраты КАК Сумма,
		               |	0 КАК Порядок
		               |ИЗ
		               |	РегистрСведений.СМ_ИтогиПоСмете КАК СМ_ИтогиПоСмете
		               |ГДЕ
		               |	СМ_ИтогиПоСмете.Смета = &Смета
		               |	И СМ_ИтогиПоСмете.Итог = &Итог
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	СМ_ИтогиПоСмете.ТекПрямЗатраты,
		               |	1
		               |ИЗ
		               |	РегистрСведений.СМ_ИтогиПоСмете КАК СМ_ИтогиПоСмете
		               |ГДЕ
		               |	СМ_ИтогиПоСмете.Смета = &Смета
		               |	И СМ_ИтогиПоСмете.Итог = &ИтогПЗ
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	СМ_ИтогиПоСмете.ТекПрямЗатраты,
		               |	2
		               |ИЗ
		               |	РегистрСведений.СМ_ИтогиПоСмете КАК СМ_ИтогиПоСмете
		               |ГДЕ
		               |	СМ_ИтогиПоСмете.Смета = &Смета
		               |	И СМ_ИтогиПоСмете.Итог = &ИтогНР
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	СМ_ИтогиПоСмете.ТекПрямЗатраты,
		               |	3
		               |ИЗ
		               |	РегистрСведений.СМ_ИтогиПоСмете КАК СМ_ИтогиПоСмете
		               |ГДЕ
		               |	СМ_ИтогиПоСмете.Смета = &Смета
		               |	И СМ_ИтогиПоСмете.Итог = &ИтогСП
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Порядок";
		Запрос.УстановитьПараметр("Смета", МассивСмет[0]);
		Запрос.УстановитьПараметр("Итог", Справочники.СМ_ИтогиПоСмете.ВсегоПоСмете);
		Запрос.УстановитьПараметр("ИтогПЗ", Справочники.СМ_ИтогиПоСмете.ИтогоПоСмете);
		Запрос.УстановитьПараметр("ИтогНР", Справочники.СМ_ИтогиПоСмете.НаклРасх);
		Запрос.УстановитьПараметр("ИтогСП", Справочники.СМ_ИтогиПоСмете.СметПрибыль);
		Выборка = Запрос.Выполнить().Выбрать();
		СуммаВсего = 0;
		Пока Выборка.Следующий() Цикл
			Если (Выборка.Сумма <> Null) и (Выборка.Порядок = 0) Тогда
				ТекстИтога = НСтр("ru='Всего:'") + " " + Формат(Выборка.Сумма, СтрокаФорматирования);
				СуммаВсего = Выборка.Сумма;
			КонецЕсли;
			Если (Выборка.Сумма <> Null) и (Выборка.Порядок = 1) и (Выборка.Сумма <> СуммаВсего) Тогда
				ТекстИтога = ТекстИтога + "  " + НСтр("ru=' в т.ч. ПЗ:'") + " " + Формат(Выборка.Сумма, СтрокаФорматирования);
			КонецЕсли;
			Если (Выборка.Сумма <> Null) и (Выборка.Порядок = 2) и (Выборка.Сумма <> 0) Тогда
				ТекстИтога = ТекстИтога + "  " + НСтр("ru='НР:'") + " " + Формат(Выборка.Сумма, СтрокаФорматирования);
			КонецЕсли;
			Если (Выборка.Сумма <> Null) и (Выборка.Порядок = 3) и (Выборка.Сумма <> 0) Тогда
				ТекстИтога = ТекстИтога + "  " + НСтр("ru='СП:'") + " " + Формат(Выборка.Сумма, СтрокаФорматирования);
			КонецЕсли;  			
		КонецЦикла;
	КонецЕсли;
	Если МассивРазделов.Количество() > 0 Тогда
		// Выводим итог по разделам
		//МассивРазделовДляРасчета = Новый Массив;
		//ЗаполнитьМассивРазделамиДляСтрокиИтогов(ДеревоЛС, МассивРазделов, МассивРазделовДляРасчета);
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ИтогиПоРазделу.Итог = &ИтогПЗ
		               |				ТОГДА СМ_ИтогиПоРазделу.ТекПрямЗатраты
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК СуммаПЗ ,
					   |	СУММА(ВЫБОР
		               |			КОГДА СМ_ИтогиПоРазделу.Итог = &ИтогВсего
		               |				ТОГДА СМ_ИтогиПоРазделу.ТекПрямЗатраты
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК СуммаВсего,
					   |	СУММА(ВЫБОР
		               |			КОГДА СМ_ИтогиПоРазделу.Итог = &ИтогНР
		               |				ТОГДА СМ_ИтогиПоРазделу.ТекПрямЗатраты
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК СуммаНР,
					   |	СУММА(ВЫБОР
		               |			КОГДА СМ_ИтогиПоРазделу.Итог = &ИтогСП
		               |				ТОГДА СМ_ИтогиПоРазделу.ТекПрямЗатраты
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК СуммаСП
		               |ИЗ
		               |	РегистрСведений.СМ_ИтогиПоРазделу КАК СМ_ИтогиПоРазделу
		               |ГДЕ
		               |	СМ_ИтогиПоРазделу.Смета = &Смета
		               |	И СМ_ИтогиПоРазделу.Раздел В(&Раздел)
		               |	И (СМ_ИтогиПоРазделу.Итог = &ИтогВсего ИЛИ СМ_ИтогиПоРазделу.Итог = &ИтогПЗ ИЛИ СМ_ИтогиПоРазделу.Итог = &ИтогНР ИЛИ СМ_ИтогиПоРазделу.Итог = &ИтогСП)";
		Запрос.УстановитьПараметр("Смета", СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(ДокументСмета));
		Запрос.УстановитьПараметр("Раздел", МассивРазделов);
		Запрос.УстановитьПараметр("ИтогВсего", Справочники.СМ_ИтогиПоРазделу.ВсегоПоРазделу);
		Запрос.УстановитьПараметр("ИтогПЗ", Справочники.СМ_ИтогиПоРазделу.ИтогоПоРазделу);
		Запрос.УстановитьПараметр("ИтогНР", Справочники.СМ_ИтогиПоРазделу.НаклРасх);
		Запрос.УстановитьПараметр("ИтогСП", Справочники.СМ_ИтогиПоРазделу.СметПрибыль);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если (Выборка.СуммаВсего <> Null) Тогда
				ТекстИтога = ТекстИтога + "   /   " + НСтр("ru='Всего по разделу:'") + " " + Формат(Выборка.СуммаВсего, СтрокаФорматирования);
			КонецЕсли;
			Если (Выборка.СуммаПЗ <> Null) и (Выборка.СуммаПЗ <> Выборка.СуммаВсего) Тогда
				ТекстИтога = ТекстИтога + "  " + НСтр("ru='в т.ч. ПЗ:'") + " " + Формат(Выборка.СуммаПЗ, СтрокаФорматирования);
			КонецЕсли;
			Если (Выборка.СуммаНР <> Null) и (Выборка.СуммаНР <> 0) Тогда
				ТекстИтога = ТекстИтога + "  " + НСтр("ru='НР:'") + " " + Формат(Выборка.СуммаНР, СтрокаФорматирования);
			КонецЕсли;
			Если (Выборка.СуммаСП <> Null) и (Выборка.СуммаСП <> 0) Тогда
				ТекстИтога = ТекстИтога + "  " + НСтр("ru='СП:'") + " " + Формат(Выборка.СуммаСП, СтрокаФорматирования);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если МассивПозиций.Количество() > 0 Тогда 
		// Выводим итог позициям
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ РАЗРЕШЕННЫЕ
		               |	СМ_ПозицияЛокальнойСметы.Ссылка КАК Позиция
		               |ПОМЕСТИТЬ Позиции
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметы.Ссылка В(&МассивПозиций)
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	СМ_ПозицияЛокальнойСметы.Ссылка
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметы.ИДПозицииВладельца В(&МассивПозиций)
		               |;
					   |
		               |////////////////////////////////////////////////////////////////////////////////
					   |";
	   Если СтруктураПараметровЛС.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный 
		   И СтруктураПараметровЛС.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка Тогда
			Запрос.Текст = Запрос.Текст + 	
	          "ВЫБРАТЬ
	          |	СУММА(ВЫБОР
	          |			КОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция.НеПрименятьИндексы
	          |				ТОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция.ТекущаяЦена
	          |			ИНАЧЕ ВЫБОР
	          |					КОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция.Определитель.ВидРасценки = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыРасценки.Оборудование)
	          |						ТОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимОборуд
	          |					ИНАЧЕ СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимПрямЗатраты
	          |				КОНЕЦ
	          |		КОНЕЦ * СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция.ОбъемРабот) КАК Сумма,
	          |	ВЫБОР
	          |		КОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция.ИДПозицииВладельца = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	          |			ТОГДА 0
	          |		ИНАЧЕ 1
	          |	КОНЕЦ КАК Неучтенные
	          |ИЗ
	          |	РегистрСведений.СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета КАК СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета
	          |ГДЕ
	          |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета = &Смета
	          |	И СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция В
	          |			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	          |				Позиции.Позиция
	          |			ИЗ
	          |				Позиции)
	          |
	          |СГРУППИРОВАТЬ ПО
	          |	ВЫБОР
	          |		КОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция.ИДПозицииВладельца = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	          |			ТОГДА 0
	          |		ИНАЧЕ 1
	          |	КОНЕЦ
	          |
	          |УПОРЯДОЧИТЬ ПО
	          |	Неучтенные";
		Иначе
			Запрос.Текст = Запрос.Текст + 
			  "ВЫБРАТЬ
			  |	СУММА(ВЫБОР
			  |			КОГДА СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.НеПрименятьИндексы
			  |				ТОГДА СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.ТекущаяЦена
			  |			ИНАЧЕ ВЫБОР
			  |					КОГДА СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.Определитель.ВидРасценки = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыРасценки.Оборудование)
			  |						ТОГДА СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимОборуд
			  |					ИНАЧЕ СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимПрямЗатраты
			  |				КОНЕЦ
			  |		КОНЕЦ * СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.ОбъемРабот) КАК Сумма,
			  |	ВЫБОР
			  |		КОГДА СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.ИДПозицииВладельца = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
			  |			ТОГДА 0
			  |		ИНАЧЕ 1
			  |	КОНЕЦ КАК Неучтенные
			  |ИЗ
			  |	РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП КАК СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП
			  |ГДЕ
			  |	СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Смета = &Смета
			  |	И СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция В
			  |			(ВЫБРАТЬ РАЗЛИЧНЫЕ
			  |				Позиции.Позиция
			  |			ИЗ
			  |				Позиции)
			  |
			  |СГРУППИРОВАТЬ ПО
			  |	ВЫБОР
			  |		КОГДА СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.ИДПозицииВладельца = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
			  |			ТОГДА 0
			  |		ИНАЧЕ 1
			  |	КОНЕЦ
			  |
			  |УПОРЯДОЧИТЬ ПО
			  |	Неучтенные";
		КонецЕсли;
		Запрос.УстановитьПараметр("Смета", СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(ДокументСмета));
		Запрос.УстановитьПараметр("МассивПозиций", МассивПозиций);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.Неучтенные > 0 Тогда
				ТекстИтога = ТекстИтога + "   /   " + НСтр("ru='Неучтенные:'") + " " + Формат(Выборка.Сумма, СтрокаФорматирования);
			Иначе
				ТекстИтога = ТекстИтога + "   /   " + НСтр("ru='ПЗ по позиции:'") + " " + Формат(Выборка.Сумма, СтрокаФорматирования); 
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТекстИтога;
	
КонецФункции

#КонецОбласти 

#Область ФункцииРасчетаПоказателей

// Возвращает таблицу с итогами сметы.
//
// Параметры:
//     ТекСмета 		- ДокументСсылка.СМ_ПозицияЛокальнойСметы - ссылка на смету.
//
// Возвращаемое значение:
//     ТаблицаЗначений с полями, содержащими данные об итогах сметы (состав полей - см. по тексту функции).
//
Функция ПолучитьПоказателиПоСмете(ТекСмета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИтогиПоСмете.Итог.ПорядковыйНомер КАК ИтогПорядковыйНомер,
	|	СУММА(ИтогиПоСмете.ОснЗарплата + ИтогиПоСмете.ЭксплМашин + ИтогиПоСмете.СтоимМатер + ИтогиПоСмете.Оборуд) КАК ОбщВсего,
	|	СУММА(ИтогиПоСмете.ПрямЗатраты) КАК ПрямЗатраты,
	|	СУММА(ИтогиПоСмете.ОснЗарплата) КАК ОснЗарплата,
	|	СУММА(ИтогиПоСмете.ЭксплМашин) КАК ЭксплМашин,
	|	СУММА(ИтогиПоСмете.ЗарплМашин) КАК ЗарплМашин,
	|	СУММА(ИтогиПоСмете.СтоимМатер) КАК СтоимМатер,
    |	СУММА(ИтогиПоСмете.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
    |	СУММА(ИтогиПоСмете.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
	|	СУММА(ИтогиПоСмете.ТекОснЗарплата + ИтогиПоСмете.ТекЭксплМашин + ИтогиПоСмете.ТекСтоимМатер + ИтогиПоСмете.ТекОборуд) КАК ТекОбщВсего,
	|	СУММА(ИтогиПоСмете.ТекПрямЗатраты) КАК ТекПрямЗатраты,
	|	СУММА(ИтогиПоСмете.ТекОснЗарплата) КАК ТекОснЗарплата,
	|	СУММА(ИтогиПоСмете.ТекЭксплМашин) КАК ТекЭксплМашин,
	|	СУММА(ИтогиПоСмете.ТекЗарплМашин) КАК ТекЗарплМашин,
	|	СУММА(ИтогиПоСмете.ТекСтоимМатер) КАК ТекСтоимМатер
	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоСмете КАК ИтогиПоСмете
	|ГДЕ
	|	ИтогиПоСмете.Смета = &Смета
	|
	|СГРУППИРОВАТЬ ПО
	|	ИтогиПоСмете.Итог.ПорядковыйНомер
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИтогПорядковыйНомер ВОЗР";
	
	Запрос.УстановитьПараметр("Смета",ТекСмета);
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	Возврат ТабРезультат;
	
КонецФункции

// Возвращает таблицу с итогами по разделу.
//
// Параметры:
//     ТекРаздел - ДокументСсылка.СМ_ПозицияЛокальнойСметы - ссылка на раздел.
//
// Возвращаемое значение:
//     ТаблицаЗначений с полями, содержащими данные об итогах раздела (состав полей - см. по тексту функции).
//
Функция ПолучитьПоказателиПоРазделу(ТекРаздел) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИтогиПоРазделу.Итог.ПорядковыйНомер КАК ИтогПорядковыйНомер,
	|	СУММА(ИтогиПоРазделу.ОснЗарплата + ИтогиПоРазделу.ЭксплМашин + ИтогиПоРазделу.СтоимМатер + ИтогиПоРазделу.Оборуд) КАК ОбщВсего,
	|	СУММА(ИтогиПоРазделу.ОснЗарплата) КАК ОснЗарплата,
	|	СУММА(ИтогиПоРазделу.ЭксплМашин) КАК ЭксплМашин,
	|	СУММА(ИтогиПоРазделу.ЗарплМашин) КАК ЗарплМашин,
	|	СУММА(ИтогиПоРазделу.СтоимМатер) КАК СтоимМатер,
    |	СУММА(ИтогиПоРазделу.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
    |	СУММА(ИтогиПоРазделу.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
	|	СУММА(ИтогиПоРазделу.ТекОснЗарплата + ИтогиПоРазделу.ТекЭксплМашин + ИтогиПоРазделу.ТекСтоимМатер + ИтогиПоРазделу.ТекОборуд) КАК ТекОбщВсего,
	|	СУММА(ИтогиПоРазделу.ТекОснЗарплата) КАК ТекОснЗарплата,
	|	СУММА(ИтогиПоРазделу.ТекЭксплМашин) КАК ТекЭксплМашин,
	|	СУММА(ИтогиПоРазделу.ТекЗарплМашин) КАК ТекЗарплМашин,
	|	СУММА(ИтогиПоРазделу.ТекСтоимМатер) КАК ТекСтоимМатер
	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоРазделу КАК ИтогиПоРазделу
	|ГДЕ
	|	ИтогиПоРазделу.Раздел = &Раздел
	|
	|СГРУППИРОВАТЬ ПО
	|	ИтогиПоРазделу.Итог.ПорядковыйНомер
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИтогПорядковыйНомер ВОЗР";
	
	Запрос.УстановитьПараметр("Раздел",  ТекРаздел);
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	Возврат ТабРезультат;
	
КонецФункции

#КонецОбласти

#Область РаботаСИндексамиПоРазделу

// Заполняет таблицу индексами всех разделов сметы.
//
// Параметры:
//     Смета 			- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету.
//     ДеревоИндексов 	- ДеревоЗначений - дерево, которое будет заполняться индесами.
//
Процедура ЗаполнитьТаблицуИндексовРаздела(Смета, ДеревоИндексов) Экспорт
	
	ДеревоИндексов.Строки.Очистить();
	
	ТаблицаРазделов = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(Смета, Истина, Ложь, Ложь, Истина);
	
	Отбор = Новый Структура();
	Отбор.Вставить("ИдРодителя", Смета);
	
	МассивСтрок = ТаблицаРазделов.НайтиСтроки(Отбор);
	
	ЗаполнитьСтрокиИндексовТаблицы(МассивСтрок, ТаблицаРазделов, ДеревоИндексов.Строки);       	
	
КонецПроцедуры

// Заполняет индексами все разделы акта (согласно дерева).
//
// Параметры:
//     Смета - ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету.
//     ДеревоИндексов - дерево - источник для индексов.
//     УдалитьСуществующие - Булево - очищать или нет существующие.
//
Процедура РаспространитьТаблицуИндексовРаздела(Смета, ДеревоИндексов, УдалитьСуществующие = Истина) Экспорт
	
	ТаблицаРазделов = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(Смета, Истина, Ложь, Ложь, Истина);
	
	ЗаполнитьИндексыРаздела(ДеревоИндексов.Строки, ТаблицаРазделов, УдалитьСуществующие);       	
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСДеревомОС

// Формирует таблицу с итогами по видам работ объектной сметы.
//
// Параметры:
//     ТекОС 			- ДокументСсылка.СМ_ОбъектнаяСмета - ссылка на Объектную смету.
//     МассивЛС 		- Массив - содержит ссылки на локальную смету для детального отбора.
//     ВТекущихЦенах 	- Булево - если Истина, то итоги в текущих ценах, иначе в базисных.
//
// Возвращаемое значение:
//     ТабРезультат - ТаблицаЗначений - содержит поля с данными об итогах объектной сметы
//					  				    (состав полей - см. по тексту функции).
//
Функция ПолучитьИтогиПоВидамРабот(ТекОС, МассивЛС, ВТекущихЦенах) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СМ_ЛокальнаяСмета.Ссылка КАК Смета,
	|	// СтроительныеРаботы
	|	СУММА(ЕСТЬNULL(ВЫБОР 
	|		КОГДА СМ_ИтогиПоВидамРабот.Итог = &СтроитРаботы  
	|			  ИЛИ СМ_ИтогиПоВидамРабот.Итог = &Металлоконстр  
	|			  ИЛИ СМ_ИтогиПоВидамРабот.Итог = &СантехнРаб  
	|			  ИЛИ СМ_ИтогиПоВидамРабот.Итог = &БуровзрывнРаб  
	|			  ИЛИ СМ_ИтогиПоВидамРабот.Итог = &ГорнопрохРаб ТОГДА
	|	 	СМ_ИтогиПоВидамРабот." + ?(ВТекущихЦенах,"Тек","")+"ПрямЗатраты ИНАЧЕ 0
	|	КОНЕЦ,0)) КАК СтроительныеРаботы, 
	|	// МонтажныеРаботы
	|	СУММА(ЕСТЬNULL(ВЫБОР 
	|		КОГДА СМ_ИтогиПоВидамРабот.Итог = &МонтажнРаб ТОГДА
	|		СМ_ИтогиПоВидамРабот." + ?(ВТекущихЦенах,"Тек","")+"ПрямЗатраты ИНАЧЕ 0
	|	КОНЕЦ,0))КАК МонтажныеРаботы,
	|	// Оборудование
	|	СУММА(ЕСТЬNULL(ВЫБОР 
	|		КОГДА СМ_ИтогиПоВидамРабот.Итог = &Оборудование ТОГДА
	|		СМ_ИтогиПоВидамРабот." + ?(ВТекущихЦенах,"Тек","")+"Оборуд ИНАЧЕ 0
	|	КОНЕЦ,0)) КАК Оборудование,
	|	// Прочие
	|	СУММА(ЕСТЬNULL(ВЫБОР 
	|		КОГДА СМ_ИтогиПоВидамРабот.Итог = &Прочие ТОГДА
	|		СМ_ИтогиПоВидамРабот." + ?(ВТекущихЦенах,"Тек","")+"ПрямЗатраты ИНАЧЕ 0
	|	КОНЕЦ,0)) КАК Прочие,
	|	// ОплатаТруда 
	|	СУММА(ЕСТЬNULL(СМ_ИтогиПоВидамРабот." + ?(ВТекущихЦенах,"Тек","")+"ОснЗарплата + СМ_ИтогиПоВидамРабот.ЗатратыТрудаМашин,0)) КАК ОплатаТруда
	|ИЗ
	|	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета 
	|	ЛЕВОЕ СОЕДИНЕНИЕ 
	|		РегистрСведений.СМ_ИтогиПоВидамРабот КАК СМ_ИтогиПоВидамРабот
	|	ПО 
	|		СМ_ЛокальнаяСмета.Ссылка = СМ_ИтогиПоВидамРабот.Смета 
	|ГДЕ
	|	(СМ_ЛокальнаяСмета.ИДРодителя = &ТекОС И СМ_ЛокальнаяСмета.ИДРодителя <> &ПустаяСС И СМ_ЛокальнаяСмета.ИДРодителя <> &ПустаяОС) 
	|	ИЛИ СМ_ЛокальнаяСмета.Ссылка В (&МассивЛС)	
	|СГРУППИРОВАТЬ ПО 
	|	СМ_ЛокальнаяСмета.Ссылка
	|УПОРЯДОЧИТЬ ПО	
	|	НомерСметы";	

	Запрос.УстановитьПараметр("МассивЛС",МассивЛС);
	Запрос.УстановитьПараметр("ТекОС",ТекОС);
	Запрос.УстановитьПараметр("СтроитРаботы",Справочники.СМ_ИтогиСметыПоВидамРабот.СтроитРаб);
	Запрос.УстановитьПараметр("Металлоконстр",Справочники.СМ_ИтогиСметыПоВидамРабот.Металлоконстр);
	Запрос.УстановитьПараметр("СантехнРаб",Справочники.СМ_ИтогиСметыПоВидамРабот.СантехнРаб);
	Запрос.УстановитьПараметр("БуровзрывнРаб",Справочники.СМ_ИтогиСметыПоВидамРабот.БуровзрывнРаб);
	Запрос.УстановитьПараметр("ГорнопрохРаб",Справочники.СМ_ИтогиСметыПоВидамРабот.ГорнопрохРаб);
	Запрос.УстановитьПараметр("МонтажнРаб",Справочники.СМ_ИтогиСметыПоВидамРабот.МонтажнРаб);
	Запрос.УстановитьПараметр("Оборудование",Справочники.СМ_ИтогиСметыПоВидамРабот.Оборуд);
	Запрос.УстановитьПараметр("Прочие",Справочники.СМ_ИтогиСметыПоВидамРабот.ПрочРаб);
	Запрос.УстановитьПараметр("ПустаяСС",Документы.СМ_ОбъектнаяСмета.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустаяОС",Документы.СМ_СводнаяСмета.ПустаяСсылка());

	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабРезультат;
	
КонецФункции

// Формирует таблицу с лим. затратами объектной сметы.
//
// Параметры:
//     СписокЛЗ - СправочникСсылка.СМ_ЛимитированныеЗатраты - список с лим. затратами для отбора.
//     Методика - СправочникСсылка.СМ_МетодикиРасчета - текущая используемая методика из документа.
//
// Возвращаемое значение:
//     ТабРезультат - ТаблицаЗначений - содержит поля с данными о лим. затратах объектной сметы
//     (состав полей - см. по тексту функции).
//
Функция ПолучитьЛимЗатратыОС(СписокЛЗ, Методика = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ИспользованиеЛимитированныхЗатрат.ЛимитированнаяЗатрата
	               |ПОМЕСТИТЬ ИспользуемыеЛЗ
	               |ИЗ
	               |	РегистрСведений.СМ_ИспользованиеЛимитированныхЗатрат КАК СМ_ИспользованиеЛимитированныхЗатрат
	               |ГДЕ
	               |	СМ_ИспользованиеЛимитированныхЗатрат.Используется = ИСТИНА
	               |	И СМ_ИспользованиеЛимитированныхЗатрат.Методика = &Методика
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_ИспользованиеЛимитированныхЗатрат.ЛимитированнаяЗатрата
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СМ_ЛимитированныеЗатраты.НомерПоПорядку,
	               |	СМ_ЛимитированныеЗатраты.Ссылка КАК ЛимитированнаяЗатрата,
	               |	СМ_ЛимитированныеЗатраты.ТипЗначенияЗатраты,
	               |	СМ_ЛимитированныеЗатраты.ЗначениеЗатратыПоУмолчанию,
	               |	СМ_ЛимитированныеЗатраты.КоэффициентСметнойЗарплаты,
	               |	СМ_ЛимитированныеЗатраты.КоэффициентТрудоемкости
	               |ИЗ
	               |	ИспользуемыеЛЗ КАК ИспользуемыеЛЗ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СМ_ЛимитированныеЗатраты КАК СМ_ЛимитированныеЗатраты
	               |		ПО ИспользуемыеЛЗ.ЛимитированнаяЗатрата = СМ_ЛимитированныеЗатраты.Ссылка
	               |ГДЕ
	               |	НЕ СМ_ЛимитированныеЗатраты.Ссылка В (&СписокЛЗ)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СМ_ЛимитированныеЗатраты.НомерПоПорядку";
	
	Запрос.УстановитьПараметр("СписокЛЗ",СписокЛЗ);
	Запрос.УстановитьПараметр("Методика",Методика);
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабРезультат;
	
КонецФункции

// Формирует таблицу с итоговыми значениями лим затрат локальной сметы.
Функция ПолучитьИтогиПоЛимЗатратамЛС(ТекЛС,МассивЛЗ, ВТекущихЦенах)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СМ_ЛимитированныеЗатраты.Ссылка КАК ЛимитированнаяЗатрата,
	|	ЗапросИтоги.Смета,
	|СУММА(ЕСТЬNULL(ВЫБОР 
	|	КОГДА ЗапросИтоги.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы) 
	|	      ИЛИ ЗапросИтоги.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.МеталломонтажныеРаботы) 
	|		  ИЛИ ЗапросИтоги.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.БуровзрывныеРаботы) 
	|		  ИЛИ ЗапросИтоги.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.СантехническиеРаботы) 
	|		  ИЛИ ЗапросИтоги.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.ГорнопроходческиеРаботы) ТОГДА
	|	ЗапросИтоги." + ?(ВТекущихЦенах,"Тек","") + "ПрямЗатраты ИНАЧЕ 0 КОНЕЦ,0)) КАК СтроительныеРаботы, 	  
	|СУММА(ЕСТЬNULL(ВЫБОР 
	|	КОГДА ЗапросИтоги.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.МонтажныеРаботы) ТОГДА 
	|		ЗапросИтоги." + ?(ВТекущихЦенах,"Тек","") + "ПрямЗатраты 
	|	ИНАЧЕ 0 КОНЕЦ,0)) КАК МонтажныеРаботы, 	  
	|СУММА(ЕСТЬNULL(ВЫБОР 
	|	КОГДА ЗапросИтоги.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.Оборудование) ТОГДА 
	|		ЗапросИтоги." + ?(ВТекущихЦенах,"Тек","") + "Оборуд 
	|	ИНАЧЕ 0 КОНЕЦ,0)) КАК Оборудование,  
	|СУММА(ЕСТЬNULL(ВЫБОР 
	|	КОГДА ЗапросИтоги.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.ПрочиеРаботы) ТОГДА 
	|		ЗапросИтоги." + ?(ВТекущихЦенах,"Тек","") + "ПрямЗатраты 
	|	ИНАЧЕ 0 КОНЕЦ,0)) КАК Прочие, 			
	|СУММА(ЕСТЬNULL(ЗапросИтоги." + ?(ВТекущихЦенах,"Тек","") + "ОснЗарплата,0) + ЕСТЬNULL(ЗапросИтоги." + ?(ВТекущихЦенах,"Тек","") + "ЗарплМашин,0)) КАК ОплатаТруда 				
	|ИЗ
	|	Справочник.СМ_ЛимитированныеЗатраты КАК СМ_ЛимитированныеЗатраты 
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ 
	|
	|	(ВЫБРАТЬ
	|		СМ_ИтогиПоГлавамОС.Смета,
	|		СМ_ИтогиПоГлавамОС.Глава,
	|		СМ_ИтогиПоГлавамОС.Итог,
	|		СМ_ИтогиПоГлавамОС.ВидРабот,
	|		СМ_ИтогиПоГлавамОС.ПрямЗатраты,
	|		СМ_ИтогиПоГлавамОС.ОснЗарплата,
	|		СМ_ИтогиПоГлавамОС.ЭксплМашин,
	|		СМ_ИтогиПоГлавамОС.ЗарплМашин,
	|		СМ_ИтогиПоГлавамОС.СтоимМатер,
	|		СМ_ИтогиПоГлавамОС.Оборуд,
	|		СМ_ИтогиПоГлавамОС.ВозвратМатер,
	|		СМ_ИтогиПоГлавамОС.ЗатратыТрудаРабочих,
	|		СМ_ИтогиПоГлавамОС.ЗатратыТрудаМашин,
	|		СМ_ИтогиПоГлавамОС.ТекПрямЗатраты,
	|		СМ_ИтогиПоГлавамОС.ТекОснЗарплата,
	|		СМ_ИтогиПоГлавамОС.ТекЭксплМашин,
	|		СМ_ИтогиПоГлавамОС.ТекЗарплМашин,
	|		СМ_ИтогиПоГлавамОС.ТекСтоимМатер,
	|		СМ_ИтогиПоГлавамОС.ТекОборуд,
	|		СМ_ИтогиПоГлавамОС.ТекВозвратМатер
	|	ИЗ
	|		РегистрСведений.СМ_ИтогиПоГлавам КАК СМ_ИтогиПоГлавамОС
	|	ГДЕ
	|		СМ_ИтогиПоГлавамОС.Смета = &ТекЛС) КАК ЗапросИтоги
	|ПО 
	|	СМ_ЛимитированныеЗатраты.Ссылка = ЗапросИтоги.Итог 
	|ГДЕ
	|	СМ_ЛимитированныеЗатраты.Ссылка В (&МассивЛЗ)   
	|СГРУППИРОВАТЬ ПО 
	|	ЗапросИтоги.Смета,
	|	СМ_ЛимитированныеЗатраты.Ссылка";
	
	Запрос.УстановитьПараметр("МассивЛЗ",МассивЛЗ);
	Запрос.УстановитьПараметр("ТекЛС",ТекЛС);
	
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабРезультат;
	
КонецФункции

// Строит дерево по таблице значений для объектной сметы.
//
// Параметры:
//     ДеревоЗначений 	- ДеревоЗначений - дерево, которое строится.
//     ТекОбъект 		- ДокументСсылка.СМ_ОбъектнаяСмета - ссылка на Объектную смету.
//
Процедура ВывестиДеревоОСПоТаблице(ДеревоЗначений, ТекОбъект) Экспорт
	
	КолЗнаков = 2;
	Если ТекОбъект.ПроводитьОкругление = Истина Тогда
		КолЗнаков = ТекОбъект.ФорматОкругления;		
	КонецЕсли;
	
	ВТекущихЦенах = Истина;
	Если ТекОбъект.БазисныеЦены Тогда
		ВТекущихЦенах = Ложь;	
	КонецЕсли;

	ТабЛС 		= ТекОбъект.ЛокальныеСметы.Выгрузить();
	МассивЛС 	= ТабЛС.ВыгрузитьКолонку("ЛокальнаяСмета");
	
	ТабЛЗ 		= ТекОбъект.ЛимитированныеЗатраты.Выгрузить();
	МассивЛЗ 	= ТабЛЗ.ВыгрузитьКолонку("ЛимитированнаяЗатрата");

	ТекСсылкаОС = ТекОбъект.Ссылка;
	
	СтрокаКорня 					= ДеревоЗначений.Строки.Добавить();
	СтрокаКорня.НаимРаботИЗатрат 	= ТекОбъект.Наименование;
	СтрокаКорня.Элемент 			= ТекОбъект.Ссылка;
	
	// Вывод локальных смет.
	ТабРезультат = ПолучитьИтогиПоВидамРабот(ТекСсылкаОС,МассивЛС,ВТекущихЦенах);
	Для Каждого ТекСтрока Из ТабРезультат Цикл
		
		ТекСтрокаДерева = СтрокаКорня.Строки.Добавить();
		
		НомерПП = "";
		НайденнаяСтрока = ТабЛС.Найти(ТекСтрока.Смета,"ЛокальнаяСмета");
		Если НайденнаяСтрока <> Неопределено Тогда
			ТекСтрокаДерева.НомерПП = НайденнаяСтрока.НомерПП;	
			ТекСтрокаДерева.Расчет 	= НайденнаяСтрока.Расчет; 
		КонецЕсли;
		
		ТекСтрокаДерева.НаимРаботИЗатрат 		= ТекСтрока.Смета.Наименование;
		ТекСтрокаДерева.Элемент					= ТекСтрока.Смета;
		ТекСтрокаДерева.НомерСметныхРасчетов 	= ТекСтрока.Смета.НомерСметы;	 
		ТекСтрокаДерева.МонтажныеРаботы 		= Окр(ТекСтрока.МонтажныеРаботы/1000,КолЗнаков);
		ТекСтрокаДерева.Оборудование            = Окр(ТекСтрока.Оборудование/1000,КолЗнаков);
		ТекСтрокаДерева.ОплатаТруда             = Окр(ТекСтрока.ОплатаТруда/1000,КолЗнаков);
		ТекСтрокаДерева.Прочие                  = Окр(ТекСтрока.Прочие/1000,КолЗнаков);
		ТекСтрокаДерева.СтроительныеРаботы		= Окр(ТекСтрока.СтроительныеРаботы/1000,КолЗнаков);
		ТекСтрокаДерева.ВсегоПоСтроке 			= ТекСтрокаДерева.СтроительныеРаботы +ТекСтрокаДерева.МонтажныеРаботы + ТекСтрокаДерева.Оборудование + ТекСтрокаДерева.Прочие;
		ТекСтрокаДерева.СметаРассчитана = ТекСтрока.Смета.СметаРассчитана;
		
		ИспользоватьЛимЗатратыВсегда = СМ_СметаВызовСервера.ЗначениеОпции("СМ_ИспользоватьЛимитированныеЗатратыПодчиненныхСмет");
		Если ИспользоватьЛимЗатратыВсегда И ТекСтрока.Смета.ЛимитированныеЗатраты.Количество( )> 0 Тогда
			ЛСМассивЛЗ 	= ТекСтрока.Смета.ЛимитированныеЗатраты.ВыгрузитьКолонку("ЛимитированнаяЗатрата");
			ТабЛимЗатрат = ПолучитьИтогиПоЛимЗатратамЛС(ТекСтрока.Смета,ЛСМассивЛЗ,ВТекущихЦенах);
			Для Каждого СтрокаЛЗ Из ТабЛимЗатрат Цикл
				ТекСтрокаЛЗ = ТекСтрокаДерева.Строки.Добавить();
				ТекСтрокаЛЗ.Расчет 	= ТекСтрокаДерева.Расчет;
				ТекСтрокаЛЗ.НаимРаботИЗатрат 		= "    "+СтрокаЛЗ.ЛимитированнаяЗатрата.Наименование;
				ТекСтрокаЛЗ.Элемент					= СтрокаЛЗ.ЛимитированнаяЗатрата;
				ТекСтрокаЛЗ.МонтажныеРаботы 		= Окр(СтрокаЛЗ.МонтажныеРаботы/1000,КолЗнаков);
				ТекСтрокаЛЗ.Оборудование            = Окр(СтрокаЛЗ.Оборудование/1000,КолЗнаков);
				ТекСтрокаЛЗ.ОплатаТруда             = Окр(СтрокаЛЗ.ОплатаТруда/1000,КолЗнаков);
				ТекСтрокаЛЗ.Прочие                  = Окр(СтрокаЛЗ.Прочие/1000,КолЗнаков);
				ТекСтрокаЛЗ.СтроительныеРаботы		= Окр(СтрокаЛЗ.СтроительныеРаботы/1000,КолЗнаков);
				ТекСтрокаЛЗ.ВсегоПоСтроке 			= ТекСтрокаЛЗ.СтроительныеРаботы +ТекСтрокаЛЗ.МонтажныеРаботы + ТекСтрокаЛЗ.Оборудование + ТекСтрокаЛЗ.Прочие;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	СтрокаКорня.Строки.Сортировать("НомерПП Возр", Истина);
	СтрокаКорня 					= ДеревоЗначений.Строки.Добавить();
	СтрокаКорня.НаимРаботИЗатрат 	= НСтр("ru='Лимитированные затраты'");
	
	// Вывод лимитированных затрат.
	ТабРезультат = ПолучитьИтогиПоЛимЗатратам(ТекСсылкаОС,МассивЛЗ,ВТекущихЦенах);
	Для Каждого ТекСтрока Из ТабРезультат Цикл
		ТекСтрокаДерева = СтрокаКорня.Строки.Добавить();
		
		НайденнаяСтрока = ТабЛЗ.Найти(ТекСтрока.ЛимитированнаяЗатрата,"ЛимитированнаяЗатрата");
		Если НайденнаяСтрока <> Неопределено Тогда
			ТекСтрокаДерева.Расчет 	= НайденнаяСтрока.Расчет; 
		КонецЕсли;
		
		ТекСтрокаДерева.НаимРаботИЗатрат 		= ТекСтрока.ЛимитированнаяЗатрата.Наименование;
		ТекСтрокаДерева.Элемент					= ТекСтрока.ЛимитированнаяЗатрата;
		ТекСтрокаДерева.МонтажныеРаботы 		= Окр(ТекСтрока.МонтажныеРаботы/1000,КолЗнаков);
		ТекСтрокаДерева.Оборудование            = Окр(ТекСтрока.Оборудование/1000,КолЗнаков);
		ТекСтрокаДерева.ОплатаТруда             = Окр(ТекСтрока.ОплатаТруда/1000,КолЗнаков);
		ТекСтрокаДерева.Прочие                  = Окр(ТекСтрока.Прочие/1000,КолЗнаков);
		ТекСтрокаДерева.СтроительныеРаботы		= Окр(ТекСтрока.СтроительныеРаботы/1000,КолЗнаков);
		ТекСтрокаДерева.ВсегоПоСтроке 			= ТекСтрокаДерева.СтроительныеРаботы +ТекСтрокаДерева.МонтажныеРаботы + ТекСтрокаДерева.Оборудование + ТекСтрокаДерева.Прочие;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСДеревомCC

// Строит дерево по таблице значений для сводной сметы.
//
// Параметры:
//     ДеревоЗначений 	- ДеревоЗначений - дерево, которое строится.
//     Объект 			- ДокументСсылка.СМ_СводнаяСмета - ссылка на Объектную смету.
//     ТипЦен 			- Число - если равен 1, то в базисных ценах, если равен 0, то в текущих ценах.
//
Процедура ВывестиДеревоСС(ДеревоЗначений,Объект, ТипЦен) Экспорт
	
	ВТекущихЦенах = Истина;
	Если ТипЦен = 1 Тогда
		ВТекущихЦенах = Ложь;	
	КонецЕсли;
	
	ИтогиПоГлавам 	= ПолучитьИтогиПоГлавам(Объект.МетодикаРасчета);
	ТабЛС 			= Объект.Сметы.Выгрузить();
	МассивСмет 		= ТабЛС.ВыгрузитьКолонку("Смета");
	ТабЛЗ 			= Объект.ЛимитированныеЗатраты.Выгрузить();
	МассивЛЗ		= ТабЛЗ.ВыгрузитьКолонку("ЛимитированнаяЗатрата");
	ТабРезультат 	= ПолучитьГлавыИтогиПоГлавам(Объект.ТипСтроительства,Объект.МетодикаРасчета,Объект.Ссылка,МассивСмет,МассивЛЗ,ВТекущихЦенах);

	// Простановка правильных глав в дереве по табличной части "сметы".
	Для Каждого ТекСтрока Из ТабЛС Цикл
		НайденнаяСтрока = ТабРезультат.Найти(ТекСтрока.Смета,"Элемент");
		Если НайденнаяСтрока <> Неопределено Тогда
			НайденнаяСтрока.Глава					= ТекСтрока.ГлаваССРС;
			НайденнаяСтрока.НомерГлавы              = ТекСтрока.ГлаваССРС.НомерГлавы;
			НайденнаяСтрока.ПорядковыйНомерГлавы   	= ТекСтрока.ГлаваССРС.ПорядковыйНомер;
 			НайденнаяСтрока.НаименованиеГлавы		= ТекСтрока.ГлаваССРС.Наименование;
			
			// Простановка правильных глав, для ЛС подчиненных объектным сметам.
			Если ТипЗнч(НайденнаяСтрока.Элемент) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
				СтруктураОтбора = Новый Структура;
				СтруктураОтбора.Вставить("ИДродителя",НайденнаяСтрока.Элемент);
				МассивСтрок = ТабРезультат.НайтиСтроки(СтруктураОтбора);
				Для Каждого ТекЭлемент Из МассивСтрок Цикл
					ТекЭлемент.Глава					= ТекСтрока.ГлаваССРС;
					ТекЭлемент.НомерГлавы               = ТекСтрока.ГлаваССРС.НомерГлавы;
					ТекЭлемент.ПорядковыйНомерГлавы   	= ТекСтрока.ГлаваССРС.ПорядковыйНомер;
		 			ТекЭлемент.НаименованиеГлавы		= ТекСтрока.ГлаваССРС.Наименование;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	ТабРезультат.Сортировать("ПорядковыйНомерГлавы,Итог,ТекПозиция,ИДродителя");
	
	// Вывод глав ССРС и Итогов по главам. 
	Для Каждого ТекСтрока Из ТабРезультат Цикл
		
		ТекРасчет = ТекСтрока.Расчет;
		
		// Вывод сводной сметы в корень дерева.
		Если ТипЗнч(ТекСтрока.Элемент) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
			СтрокаКорня 				= ДеревоЗначений.Строки.Добавить();
			СтрокаКорня.НомерСметы      = Объект.Ссылка.НомерСметы;
			СтрокаКорня.Наименование 	= Объект.Ссылка.Наименование; 	
	        ЗаполнитьЗначенияСвойств(СтрокаКорня,ТекСтрока);
			СтрокаКорня.ВсегоПоСтроке = СтрокаКорня.СтроительныеРаботы + СтрокаКорня.МонтажныеРаботы + СтрокаКорня.Оборудование + СтрокаКорня.Прочие;
				
		// Вывод подчиненных объектных смет.
		ИначеЕсли ТипЗнч(ТекСтрока.Элемент) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
			
			// Поиск строки ОС в табличной части "Сметы" документа СС.
			КоличествоОбъектов = 0;
			НайденнаяСтрокаТаб = ТабЛС.Найти(ТекСтрока.Элемент,"Смета");
			Если НайденнаяСтрокаТаб <> Неопределено Тогда
				ТекРасчет 			= НайденнаяСтрокаТаб.Расчет;
				КоличествоОбъектов  = НайденнаяСтрокаТаб.КоличествоОбъектов;
			КонецЕсли;
			
			НайденнаяСтрока = СтрокаКорня.Строки.Найти(ТекСтрока.Глава,"Глава",Истина);
			Если НайденнаяСтрока <> Неопределено Тогда
				СтрокаДерева = НайденнаяСтрока.Строки.Добавить();	
				ЗаполнитьЗначенияСвойств(СтрокаДерева,ТекСтрока);
				СтрокаДерева.ВсегоПоСтроке = СтрокаДерева.СтроительныеРаботы + СтрокаДерева.МонтажныеРаботы + СтрокаДерева.Оборудование + СтрокаДерева.Прочие;
				
				НомерПП = "";
				НайденнаяСтрока = ТабЛС.Найти(ТекСтрока.Элемент,"Смета");
				Если НайденнаяСтрока <> Неопределено Тогда
					СтрокаДерева.НомерПП = НайденнаяСтрока.НомерПП;		
				КонецЕсли;
				СтрокаДерева.Родитель.Строки.Сортировать("НомерПП Возр", Истина);
				СтрокаДерева.Элемент 			= ТекСтрока.Элемент;
				СтрокаДерева.Расчет				= ТекРасчет;
				СтрокаДерева.НомерСметы         = СтрокаДерева.Элемент.НомерСметы;
				СтрокаДерева.Наименование 		= СтрокаДерева.Элемент.Наименование; 
				СтрокаДерева.КоличествоОбъектов = КоличествоОбъектов;
			КонецЕсли;
			
		// Вывод локальных смет.
		ИначеЕсли ТипЗнч(ТекСтрока.Элемент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			
			// Поиск строки ЛС в табличной части "Сметы" документа СС.
			КоличествоОбъектов = 0;
			НайденнаяСтрокаТаб = ТабЛС.Найти(ТекСтрока.Элемент,"Смета");
			Если НайденнаяСтрокаТаб <> Неопределено Тогда
				ТекРасчет = НайденнаяСтрокаТаб.Расчет;
				КоличествоОбъектов  = НайденнаяСтрокаТаб.КоличествоОбъектов;
			КонецЕсли;
			
			// Родитель заполнен	
			Если ЗначениеЗаполнено(ТекСтрока.ИДРодителя) Тогда
				// Локальные сметы подчиненные объектной смете.
				Если ТипЗнч(ТекСтрока.ИДРодителя) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
					НайденнаяСтрока = СтрокаКорня.Строки.Найти(ТекСтрока.ИДРодителя,"Элемент",Истина);
				// Локальные сметы подчиненные сводной смете.
				Иначе	
					НайденнаяСтрока = СтрокаКорня.Строки.Найти(ТекСтрока.Глава,"Глава",Истина);
				КонецЕсли;	
			// Родитель не заполнен.	
			Иначе
				// Локальные сметы подчиненные сводной смете.
				НайденнаяСтрока = СтрокаКорня.Строки.Найти(ТекСтрока.Глава,"Глава",Истина);
			КонецЕсли;
			
			// Вывод строки.
			Если НайденнаяСтрока <> Неопределено Тогда
				СтрокаДерева = НайденнаяСтрока.Строки.Добавить();	
				ЗаполнитьЗначенияСвойств(СтрокаДерева,ТекСтрока);	
				СтрокаДерева.ВсегоПоСтроке = СтрокаДерева.СтроительныеРаботы + СтрокаДерева.МонтажныеРаботы + СтрокаДерева.Оборудование + СтрокаДерева.Прочие;
				
				НайденнаяСтрока2 = ТабЛС.Найти(ТекСтрока.Элемент,"Смета");
				Если НайденнаяСтрока2 <> Неопределено Тогда
					СтрокаДерева.НомерПП = НайденнаяСтрока2.НомерПП;		
				КонецЕсли;
				СтрокаДерева.Родитель.Строки.Сортировать("НомерПП Возр", Истина);
				СтрокаДерева.Элемент 			= ТекСтрока.Элемент;
				СтрокаДерева.Расчет				= ТекРасчет;
				СтрокаДерева.НомерСметы         = СтрокаДерева.Элемент.НомерСметы;
				СтрокаДерева.Наименование 		= СтрокаДерева.Элемент.Наименование; 	
				СтрокаДерева.КоличествоОбъектов = КоличествоОбъектов;
				СтрокаДерева.СметаРассчитана = ТекСтрока.Элемент.СметаРассчитана;
			КонецЕсли;
			
		// Вывод лимитированных затрат.	
		ИначеЕсли ТипЗнч(ТекСтрока.Элемент) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
			
			// Поиск строки ЛЗ в табличной части "Сметы" документа СС.
			НайденнаяСтрокаТаб = ТабЛЗ.Найти(ТекСтрока.Элемент,"ЛимитированнаяЗатрата");
			Если НайденнаяСтрокаТаб <> Неопределено Тогда
				ТекРасчет = НайденнаяСтрокаТаб.Расчет;
			КонецЕсли;
			
			// Родитель заполнен.	
			Если ЗначениеЗаполнено(ТекСтрока.ИДРодителя) Тогда
				// Лимитированные затраты подчиненные объектной смете.
				// Если лим. затрата относится к объектной смете, то ее отображаем в составе объектной сметы.
				Если ТипЗнч(ТекСтрока.ИДРодителя) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
					НайденнаяСтрока = СтрокаКорня.Строки.Найти(ТекСтрока.ИДРодителя,"Элемент",Истина);
				// Лимитированные затраты подчиненные локальной смете.
				ИначеЕсли ТипЗнч(ТекСтрока.ИДРодителя) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
					НайденнаяСтрока = СтрокаКорня.Строки.Найти(ТекСтрока.ИДРодителя,"Элемент",Истина);
				// Если лим. затрата относится к сводной смете, то ее отображаем в составе нужной главы.
				ИначеЕсли ТипЗнч(ТекСтрока.ИДРодителя) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
					Если ЗначениеЗаполнено(ТекСтрока.Глава) Тогда
						
						// Поиск соответствия главы кап. ремонта.
						Если Объект.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
							СтруктураОтбора = Новый Структура;
							СтруктураОтбора.Вставить("ГлаваССРС",ТекСтрока.Глава);
							МассивСтрок = ИтогиПоГлавам.НайтиСтроки(СтруктураОтбора);
							Если МассивСтрок.Количество() > 0 Тогда
								ТекСтрока.Глава = МассивСтрок[0].ГлаваРемонт;			
							КонецЕсли;
						КонецЕсли;
						НайденнаяСтрока = СтрокаКорня.Строки.Найти(ТекСтрока.Глава,"Глава",Истина);
					Иначе
						НайденнаяСтрока = СтрокаКорня.Строки.Найти(ТекСтрока.ИДРодителя,"Элемент",Истина);
					КонецЕсли;
				Иначе	
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не обработан тип родителя ЛЗ: %1'"), ТипЗнч(ТекСтрока.ИДРодителя)));
				КонецЕсли;	
				
			// Родитель не заполнен.	
			Иначе
				// Лимитированный затраты подчиненные сводной смете.
				// Если лим. затрата относится к сводной смете, то ее отображаем в составе нужной главы.
				Если ЗначениеЗаполнено(ТекСтрока.Глава) Тогда
					НайденнаяСтрока = СтрокаКорня.Найти(ТекСтрока.Глава,"Глава",Истина);
				Иначе
					НайденнаяСтрока = СтрокаКорня.Найти(ТекСтрока.ИДРодителя,"Элемент",Истина);
				КонецЕсли;	
				
			КонецЕсли;

			Если НайденнаяСтрока <> Неопределено Тогда
				СтрокаДерева = НайденнаяСтрока.Строки.Добавить();	
				ЗаполнитьЗначенияСвойств(СтрокаДерева,ТекСтрока);	
				СтрокаДерева.ВсегоПоСтроке = СтрокаДерева.СтроительныеРаботы + СтрокаДерева.МонтажныеРаботы + СтрокаДерева.Оборудование + СтрокаДерева.Прочие;
				СтрокаДерева.Элемент 		= ТекСтрока.Элемент;
				СтрокаДерева.Расчет			= ТекРасчет;
				СтрокаДерева.Наименование	= ТекСтрока.Элемент;
			КонецЕсли;
	
		// Вывод итогов и глав.
	Иначе
		// Выводить только те итоги и главы, которые должны выводиться на печать.
		Если ЗначениеЗаполнено(ТекСтрока.Итог) Тогда
			Если ТекСтрока.Итог.ВыводитьНаПечать = Истина Тогда			
				ТекСтрокаДерева 					= СтрокаКорня.Строки.Добавить();
				ТекСтрокаДерева.Итог				= ТекСтрока.Итог;
				ТекСтрокаДерева.ЭлементТип			= ТекСтрока.Элемент;
				ЗаполнитьЗначенияСвойств(ТекСтрокаДерева,ТекСтрока);	
				ТекСтрокаДерева.ВсегоПоСтроке = ТекСтрокаДерева.СтроительныеРаботы + ТекСтрокаДерева.МонтажныеРаботы + ТекСтрокаДерева.Оборудование + ТекСтрокаДерева.Прочие;
				
				ТекСтрокаДерева.Наименование	= ТекСтрока.НаименованиеИтога;
				ТекСтрокаДерева.Элемент 		= ТекСтрока.Итог;
			КонецЕсли;
			// Это глава.	
		Иначе
			ВыводитьНаПечать = Истина;
			СтруктураОтбора = Новый Структура;
			Если Объект.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
				СтруктураОтбора.Вставить("ГлаваРемонт",ТекСтрока.Глава);
			Иначе
				СтруктураОтбора.Вставить("ГлаваССРС",ТекСтрока.Глава);
			КонецЕсли;
			МассивСтрок = ИтогиПоГлавам.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество() > 0 Тогда
				ВыводитьНаПечать = МассивСтрок[0].ВыводитьНаПечать;
			КонецЕсли;
			Если ВыводитьНаПечать = Истина Тогда
				ТекСтрокаДерева 					= СтрокаКорня.Строки.Добавить();
				ТекСтрокаДерева.Итог				= ТекСтрока.Итог;
				ТекСтрокаДерева.ЭлементТип			= ТекСтрока.Элемент;
				ЗаполнитьЗначенияСвойств(ТекСтрокаДерева,ТекСтрока);	
				ТекСтрокаДерева.ВсегоПоСтроке = ТекСтрокаДерева.СтроительныеРаботы + ТекСтрокаДерева.МонтажныеРаботы + ТекСтрокаДерева.Оборудование + ТекСтрокаДерева.Прочие;
				
				ТекСтрокаДерева.Элемент 		= ТекСтрока.Глава;	
				ТекСтрокаДерева.Наименование    = ТекСтрока.НаименованиеГлавы;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецЦикла;
	
КонецПроцедуры

// Возвращает главу по умолчанию для сводной сметы согласно типу строительства.
//
// Параметры:
//     ТипСтроительства - ПеречислениеСсылка.СМ_ТипыСтроительства - тип строительства сметы.
//
// Возвращаемое значение:
//     СправочникСсылка.СМ_ГлавыССРС - Ссылка на главу ССРС по умолчанию.
//
Функция ПолучитьГлавуПоУмолчанию(ТипСтроительства) Экспорт
	
	Если ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
		ТекГлаваССРС = Справочники.СМ_ГлавыССРС.НайтиПоКоду("22");
	Иначе
		ТекГлаваССРС = Справочники.СМ_ГлавыССРС.НайтиПоКоду("4");		
	КонецЕсли;
	
	Возврат ТекГлаваССРС;
	
КонецФункции

// Формирует массив лимзатрат сметы.
//
// Параметры:
//     СводнаяСмета - ДокументСсылка.СМ_СводнаяСмета - ссылка на Объектную смету.
//
// Возвращаемое значение:
//     МассивЛЗ - Массив - содержит ссылки на лимитированные затраты сметы
//						   (СправочникСсылка.СМ_ЛимитированныеЗатраты).
//
Функция ПолучитьЛимЗатратыСводнойСметы(СводнаяСмета) Экспорт
	
	ТабЛЗ 	 = СводнаяСмета.ЛимитированныеЗатраты.Выгрузить();
	МассивЛЗ = ТабЛЗ.ВыгрузитьКолонку("ЛимитированнаяЗатрата");
	МассивЛЗ = Новый Массив;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Расчет",Истина);
	МассивСтрок = ТабЛЗ.НайтиСтроки(СтруктураОтбора);
	Для Каждого ТекСтрока Из МассивСтрок Цикл
		Если ТекСтрока.Расчет Тогда
			МассивЛЗ.Добавить(ТекСтрока.ЛимитированнаяЗатрата);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивЛЗ;
	
КонецФункции

// Формирует массив лимзатрат сметы.
//
// Параметры:
//     ТекОбъект - ДокументСсылка - ссылка на Объектную или Сводную смету.
//
// Возвращаемое значение:
//     ТабРезультат - ТаблицаЗначений - содержит таблицу с актами и всеми подчиненными сметами 
//					  (Локальные, Объектные сметы). Поля таблицы:
//							* Элемент	 - ДокументСсылка - ссылка на сам элемент.
//							* ИдРодителя - ДокументСсылка - ссылка на родителя.
//
Функция ПолучитьДокументыСвязанныеССиОС(ТекОбъект) Экспорт
	
	Если ТипЗнч(ТекОбъект) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		ТабЛС 			= ТекОбъект.ЛокальныеСметы.Выгрузить();
		МассивСмет 		= ТабЛС.ВыгрузитьКолонку("ЛокальнаяСмета");
	Иначе
		ТабЛС 			= ТекОбъект.Сметы.Выгрузить();
		МассивСмет 		= ТабЛС.ВыгрузитьКолонку("Смета");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "
	|// *****************************************
	|// Локальные сметы по входящие в состав СС, ОС 
	|// *****************************************
	|ВЫБРАТЬ
	|	СМ_ЛокальнаяСмета.Ссылка КАК Элемент,
	|	СМ_ЛокальнаяСмета.ИДродителя КАК ИДродителя
	|ИЗ
	|	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета 
	|ГДЕ
	|	СМ_ЛокальнаяСмета.ИДРодителя = &СсылкаСмета  
	|	ИЛИ СМ_ЛокальнаяСмета.ИДРодителя В (&МассивСмет)  
	|	ИЛИ СМ_ЛокальнаяСмета.Ссылка В (&МассивСмет)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// *****************************************
	|// Объектные сметы
	|// *****************************************	
	|ВЫБРАТЬ
	|	СМ_ОбъектнаяСмета.Ссылка КАК Элемент,
	|	СМ_ОбъектнаяСмета.ИДродителя КАК ИДродителя
	|ИЗ
	|	Документ.СМ_ОбъектнаяСмета КАК СМ_ОбъектнаяСмета 
	|ГДЕ
	|	СМ_ОбъектнаяСмета.ИДРодителя = &СсылкаСмета  
	|	ИЛИ СМ_ОбъектнаяСмета.Ссылка В (&МассивСмет) 
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// *****************************************
	|// Акты по локальным сметам 
	|// *****************************************
	|ВЫБРАТЬ
	|	СМ_АктВыполненныхРабот.Ссылка КАК Элемент,
	|	СМ_АктВыполненныхРабот.ЛокальнаяСмета КАК ИДродителя
	|ИЗ
	|	Документ.СМ_АктВыполненныхРабот КАК СМ_АктВыполненныхРабот 
	|ГДЕ
	|	СМ_АктВыполненныхРабот.ЛокальнаяСмета.ИДРодителя = &СсылкаСмета  
	|	ИЛИ СМ_АктВыполненныхРабот.ЛокальнаяСмета.ИДРодителя В (&МассивСмет)  
	|	ИЛИ СМ_АктВыполненныхРабот.ЛокальнаяСмета.Ссылка В (&МассивСмет)
	|
	|УПОРЯДОЧИТЬ ПО 
	|	Элемент,ИДродителя";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("МассивСмет",МассивСмет);
	Запрос.УстановитьПараметр("СсылкаСмета",ТекОбъект.Ссылка);

	ТабРезультат = Запрос.Выполнить().Выгрузить();
	ТабРезультат.Свернуть("Элемент,ИДродителя");
	
	Возврат ТабРезультат;
	
КонецФункции	

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДереваЗначений

// Новая версия универсальных процедур вывода дерева.
//	Основная процедура работы с деревом.
//
Процедура ПолучениеЗапросаИОбработкаДанныхДерева(ОбъектСмета, ДеревоЗначений=Неопределено, Действие="Обновить", ОбъектАкт=Неопределено, СтруктураПараметров=Неопределено, ИзмененныйОбъект=Неопределено, НомерПересчета = 0)
	
	ЭлементКорня = СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(ОбъектСмета); 
	
	Если ИзмененныйОбъект <> Неопределено Тогда
		ОбъектПересчета = СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(ИзмененныйОбъект);
	Иначе
		ОбъектПересчета = Неопределено;
	КонецЕсли;
	
	Если ДеревоЗначений <> Неопределено Тогда
		Если (ДеревоЗначений.Строки.Количество() > 0) и (ОбъектПересчета = Неопределено) Тогда
			ДеревоЗначений.Строки.Очистить();
		ИначеЕсли ДеревоЗначений.Строки.Количество() > 0 Тогда
			СтрокиОбновления = Неопределено;
			Если ТипЗнч(ОбъектПересчета) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				СтрокаПозиции = ДеревоЗначений.Строки.Найти(ОбъектПересчета,,Истина);
				Если Не СтрокаПозиции = Неопределено Тогда
					СтрокиОбновления = ДеревоЗначений.Строки.Найти(СтрокаПозиции.ИДРодителя,,Истина);
				КонецЕсли;
			Иначе
				СтрокиОбновления = ДеревоЗначений.Строки.Найти(ОбъектПересчета,,Истина);
			КонецЕсли;
			
			Если Не СтрокиОбновления = Неопределено Тогда
				СтрокиОбновления.Строки.Очистить();
			КонецЕсли;
		КонецЕсли;
	Иначе
		ДеревоЗначений = Новый ДеревоЗначений();
		ДеревоЗначений.Колонки.Добавить("Элемент");
		ДеревоЗначений.Колонки.Добавить("ПроверкаЗаполненияРеквизитов");
		                                             		
		ДеревоЗначений.Колонки.Добавить("НомерПП"                             );
		ДеревоЗначений.Колонки.Добавить("Расчет"                                );
		ДеревоЗначений.Колонки.Добавить("ОбоснСметнойСтоим"                       );
		ДеревоЗначений.Колонки.Добавить("НаимРаботИЗатрат"                          );
		ДеревоЗначений.Колонки.Добавить("Кол"                                         );
		ДеревоЗначений.Колонки.Добавить("Измеритель"                                    );
		ДеревоЗначений.Колонки.Добавить("СтоимостьЕдиницы"                                );
		ДеревоЗначений.Колонки.Добавить("ЕдВсего"                                           );
		ДеревоЗначений.Колонки.Добавить("ЕдОснЗП"                                             );
		ДеревоЗначений.Колонки.Добавить("ЕдЭксплМашин"                                          );
		ДеревоЗначений.Колонки.Добавить("ЕдЭМЗарПлата"                                            );
		ДеревоЗначений.Колонки.Добавить("ЕдСтоимостьМатериалов"                                     );
		ДеревоЗначений.Колонки.Добавить("ОбщаяСтоимость"                                              );
		ДеревоЗначений.Колонки.Добавить("ОбщВсего"                                                      );
		ДеревоЗначений.Колонки.Добавить("ОбщОснЗП"                                                        );
		ДеревоЗначений.Колонки.Добавить("ОбщЭксплМашин"                                                     );
		ДеревоЗначений.Колонки.Добавить("ОбщЭМЗарПлата"                                                       );
		ДеревоЗначений.Колонки.Добавить("ОбщСтоимостьМатериалов"                                                );
		ДеревоЗначений.Колонки.Добавить("ЕдЗатрТрРаб"                                                               );
		ДеревоЗначений.Колонки.Добавить("ЕдЗатрТрМех"                                                                 );
		ДеревоЗначений.Колонки.Добавить("ОбщЗатрТрРаб"                             );
		ДеревоЗначений.Колонки.Добавить("ОбщЗатрТрМех"                               );
		ДеревоЗначений.Колонки.Добавить("ИДРодителя"                                   );
		ДеревоЗначений.Колонки.Добавить("Наименование"                                   );
		ДеревоЗначений.Колонки.Добавить("Привязана"                                        );
		ДеревоЗначений.Колонки.Добавить("ИндексПересчет"                                     );
		ДеревоЗначений.Колонки.Добавить("ИндексПривязана"                                      );
		ДеревоЗначений.Колонки.Добавить("ИндексНеИндексировать"                                  );
		ДеревоЗначений.Колонки.Добавить("ИндексПоправки"                                           );
		ДеревоЗначений.Колонки.Добавить("Пустышка"                                                   );
		ДеревоЗначений.Колонки.Добавить("ТипСтроки"                                                    );
		ДеревоЗначений.Колонки.Добавить("Картинка"                                                       );
		ДеревоЗначений.Колонки.Добавить("Плюсик"                                                           );
		ДеревоЗначений.Колонки.Добавить("ОтмеченаВДереве"                                                    );
		ДеревоЗначений.Колонки.Добавить("НоваяСтрока"                                                          );
		ДеревоЗначений.Колонки.Добавить("РодительРасценки"                                                       );
		ДеревоЗначений.Колонки.Добавить("Версия"                                                                   );
		ДеревоЗначений.Колонки.Добавить("ОбъемВсего"                                                                 );
		ДеревоЗначений.Колонки.Добавить("Звездочка"                                                                    );
		ДеревоЗначений.Колонки.Добавить("СтатусРесурса"                                                                  );
		ДеревоЗначений.Колонки.Добавить("СтатусРедактирования"                                                             );

	КонецЕсли;
	
	Запрос = Новый Запрос;
	Текст = ПолучитьТекстЗапросаНаДеревоСмет(ОбъектАкт);

	ВыводитьДопРеквизиты = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","СМ_ВыводитьДополнительныеРеквизитыДерево");
	ВыводитьДопРеквизиты = ?(ВыводитьДопРеквизиты = Неопределено,Ложь,ВыводитьДопРеквизиты);
	Если ВыводитьДопРеквизиты Тогда
		СписокРеквизитов = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","СМ_СписокДопРеквизитовДерева");
		
		ЗапросДоп = Новый Запрос;
		ЗапросДоп.Текст = "ВЫБРАТЬ
		|	ДополнительныеРеквизитыИСведения.Ссылка КАК Свойство
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
		|ГДЕ
		|	НЕ ДополнительныеРеквизитыИСведения.ЭтоДополнительноеСведение
		|	И НЕ ДополнительныеРеквизитыИСведения.ПометкаУдаления";
		ТЗ = ЗапросДоп.Выполнить().Выгрузить();
		ТЗ.Колонки.Добавить("ИмяДопРеквизита",Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
		Для Каждого стр Из ТЗ Цикл
			GUID = СМ_ВерсионированиеСервер.ПолучитьGUIDПоУИД(стр.Свойство.УникальныйИдентификатор());
			стр.ИмяДопРеквизита = "ДопРеквизит_"+GUID;
		КонецЦикла;
		
				
		ДопРеквизитСмета = "";
		ДопРеквизитРаздел = "";
		ДопРеквизитПозиция = "";
		ДопУсловиеРаздел = "";
		ДопУсловиеПозиция = "";
		
		сч = 1;
		Для Каждого стр Из ТЗ Цикл
			ДопРеквизитСмета = ДопРеквизитСмета+Символы.ПС +", NULL КАК "+стр.ИмяДопРеквизита;
			ДопРеквизитРаздел = ДопРеквизитРаздел+Символы.ПС +", СМ_РазделЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Значение";
			ДопРеквизитПозиция = ДопРеквизитПозиция+Символы.ПС +", СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Значение";
			
			ДопУсловиеРаздел = ДопУсловиеРаздел+Символы.ПС +" ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_РазделЛокальнойСметы.ДополнительныеРеквизиты КАК СМ_РазделЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+"	ПО (РазделЛокальнойСметыДок.Ссылка = СМ_РазделЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Ссылка
			|				И СМ_РазделЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Свойство = &Свойство"+Строка(сч)+")";
			
			ДопУсловиеПозиция = ДопУсловиеПозиция+Символы.ПС +" ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_ПозицияЛокальнойСметы.ДополнительныеРеквизиты КАК СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+" ПО (ПозицияЛокальнойСметыДок.Ссылка = СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Ссылка
			|				И СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Свойство = &Свойство"+Строка(сч)+")";
			Запрос.УстановитьПараметр("Свойство"+Строка(сч),стр.Свойство);
			сч = сч+1;
		КонецЦикла;
		
		Текст = СтрЗаменить(Текст,"[ДопРеквизитСмета]",ДопРеквизитСмета);
		Текст = СтрЗаменить(Текст,"[ДопРеквизитРаздел]",ДопРеквизитРаздел);
		Текст = СтрЗаменить(Текст,"[ДопРеквизитПозиция]",ДопРеквизитПозиция);
		Текст = СтрЗаменить(Текст,"[ДопУсловиеРаздел]",ДопУсловиеРаздел);
		Текст = СтрЗаменить(Текст,"[ДопУсловиеПозиция]",ДопУсловиеПозиция);

	Иначе
		Текст = СтрЗаменить(Текст,"[ДопРеквизитСмета]","");
		Текст = СтрЗаменить(Текст,"[ДопРеквизитРаздел]","");
		Текст = СтрЗаменить(Текст,"[ДопРеквизитПозиция]","");
		Текст = СтрЗаменить(Текст,"[ДопУсловиеРаздел]","");
		Текст = СтрЗаменить(Текст,"[ДопУсловиеПозиция]","");
	КонецЕсли;
	
	Запрос.Текст = Текст;	
	Запрос.УстановитьПараметр("Ссылка",ЭлементКорня);
	Запрос.УстановитьПараметр("ИтогРаздела",Справочники.СМ_ИтогиПоРазделу.ИтогоПоРазделу);
	
	ИтогПоСмете = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ИтогСметыДляДерева");
	Если Не ИтогПоСмете = Неопределено
		И ИтогПоСмете.Пустая() Тогда
		ИтогПоСмете = Справочники.СМ_ИтогиПоГлавам.НайтиПоРеквизиту("Идентификатор","ИП4");
	КонецЕсли;

	// Запрос.УстановитьПараметр("ИтогСметы",Справочники.СМ_ИтогиПоСмете.ИтогоПоСмете);
	Запрос.УстановитьПараметр("ИтогСметы",ИтогПоСмете);
	Запрос.УстановитьПараметр("ВидРасценкиОборудование", Перечисления.СМ_ВидыРасценки.Оборудование);
	Запрос.УстановитьПараметр("ВидРасценкиМатериал", Перечисления.СМ_ВидыРасценки.Материал);
	Запрос.УстановитьПараметр("ЭтоАкт", ОбъектАкт <> Неопределено);
	Запрос.УстановитьПараметр("АктВыполненныхРабот", СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(ОбъектАкт));
	
	ТабДерева = Запрос.Выполнить().Выгрузить();
	
	Если СтруктураПараметров = Неопределено Тогда
		СтруктураПараметров = Новый Структура;
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ОтображатьПрефиксы", ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОтображатьПрефиксы",Ложь));
	СтруктураПараметров.Вставить("Вид");
	// Вопрос определения, откуда идет вызов. Так вроде не очень корректно.
	// М.б. параметр в функцию ВывестиОбновитьДерево2.
	Если ДеревоЗначений.Колонки.Найти("НаименованиеЭлемента") <> Неопределено Тогда  
		СтруктураПараметров.Вставить("Вид","ГрупповаяОбработкаПозиций");
	КонецЕсли;
	
	Если Действие = "ЗаполнитьПоОстаткам" Тогда
		Если  СтруктураПараметров.Свойство("МассивПозиций") Тогда
			МассивПозиций=СтруктураПараметров.МассивПозиций;
		Иначе
			МассивПозиций=Неопределено;
		КонецЕсли;
		
		ТабВыполнения = ПолучитьВыполнениеСметы(ОбъектСмета.Ссылка,ОбъектАкт.Ссылка,МассивПозиций);
		СтруктураПараметров.Вставить("ВыполнениеСметы",ТабВыполнения);
	КонецЕсли;
	
	// выводим все заново
	ВывестиДеревоПоТаблице(	ДеревоЗначений,
							ТабДерева,
							Новый Структура("ИдСметы", Неопределено),
							ОбъектСмета,
							ОбъектАкт,
							СтруктураПараметров,
							Действие, 
							ОбъектПересчета,
							НомерПересчета); 							
							
	Если Найти(Действие,"Перенумеровать") > 0 Тогда
		СохранитьНовуюНумерацию(ТабДерева, ОбъектСмета.Ссылка);
	КонецЕсли;
						
КонецПроцедуры

// Процедура фильтрует позиции в дереве по цвету.
//
Процедура ФильтрДерева(ОбъектСмета,ДеревоЗначений,ФильтрЦвет,ОбъектАкт = Неопределено) Экспорт
	
	ЭлементКорня = СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(ОбъектСмета); 
	Если ДеревоЗначений <> Неопределено Тогда
		Если ДеревоЗначений.Строки.Количество() > 0 Тогда
			ДеревоЗначений.Строки.Очистить();
		КонецЕсли;
	Иначе
		ДеревоЗначений = Новый ДеревоЗначений();
		ДеревоЗначений.Колонки.Добавить("Элемент");
	КонецЕсли;
	
	Запрос 	= Новый Запрос;
	//Текст = ПолучитьТекстЗапросаНаДеревоСметФильтр(ФильтрЦвет,ОбъектАкт);
	
	// *******************************************
	Если ОбъектАкт <> Неопределено Тогда
		Текст = ПолучитьТекстЗапросаНаДеревоСметФильтрПоАкту(ФильтрЦвет,ОбъектАкт);
	Иначе
		Текст = ПолучитьТекстЗапросаНаДеревоСметФильтр(ФильтрЦвет,ОбъектАкт);
