	|				КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|					ТОГДА ЕСТЬNULL(РегРес.ТекСтоимОснЗарплата, 0)
	|				ИНАЧЕ ЕСТЬNULL(Рег.СтоимОснЗарплата, 0)
	|			КОНЕЦ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметыДок.НеПрименятьИндексы
	|			ТОГДА ВЫБОР
	|					КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|						ТОГДА ЕСТЬNULL(РегРес.ТекСтоимЭксплМашин, 0)
	|					ИНАЧЕ ЕСТЬNULL(Рег.СтоимЭксплМашин, 0)
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|					ТОГДА ЕСТЬNULL(РегРес.ТекСтоимЭксплМашин, 0)
	|				ИНАЧЕ ЕСТЬNULL(Рег.СтоимЭксплМашин, 0)
	|			КОНЕЦ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметыДок.НеПрименятьИндексы
	|			ТОГДА ПозицияЛокальнойСметыДок.ТекущаяЗарплатаМашинистов
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|					ТОГДА ЕСТЬNULL(РегРес.ТекСтоимЗарплМашин, 0)
	|				ИНАЧЕ ЕСТЬNULL(Рег.СтоимЗарплМашин, 0)
	|			КОНЕЦ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметыДок.НеПрименятьИндексы
	|			ТОГДА ВЫБОР
	|					КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|						ТОГДА ЕСТЬNULL(РегРес.ТекСтоимСтоимМатер, 0)
	|					ИНАЧЕ ЕСТЬNULL(Рег.СтоимСтоимМатер, 0)
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|					ТОГДА ЕСТЬNULL(РегРес.ТекСтоимСтоимМатер, 0)
	|				ИНАЧЕ ЕСТЬNULL(Рег.СтоимСтоимМатер, 0)
	|			КОНЕЦ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|			ТОГДА ЕСТЬNULL(РегРес.ЗатратыТрудаРабочих, 0)
	|		ИНАЧЕ ЕСТЬNULL(Рег.ЗатратыТрудаРабочих, 0)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|			ТОГДА ЕСТЬNULL(РегРес.ЗатратыТрудаМашин, 0)
	|		ИНАЧЕ ЕСТЬNULL(Рег.ЗатратыТрудаМашин, 0)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметыДок.ИДПозицииВладельца = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	|			ТОГДА 2
	|		ИНАЧЕ 3
	|	КОНЕЦ,
	|	ЕСТЬNULL(ПорядокПозиций.НомерРодителя, 0),
	|	ЕСТЬNULL(ПорядокПозиций.НомерПозиции, 0),
	|	ЕСТЬNULL(ПорядокПозиций.НомерРаздела, 0),
	|	ПозицияЛокальнойСметыДок.ПрямЗатраты,
	|	ПозицияЛокальнойСметыДок.ОснЗарплата,
	|	ПозицияЛокальнойСметыДок.ЭксплМашин,
	|	ПозицияЛокальнойСметыДок.ЗарплМашинистов,
	|	ПозицияЛокальнойСметыДок.СтоимМатериалов,
	|	ПозицияЛокальнойСметыДок.ЗатратыТрудаРабочих,
	|	ПозицияЛокальнойСметыДок.ЗатратыТрудаМашинистов,
	|	ПозицияЛокальнойСметыДок.ИДПозицииВладельца,
	|	ПозицияЛокальнойСметыДок.НеПрименятьИндексы,
	|	ПозицияЛокальнойСметыДок.ОтмеченаВДереве,
	|	ПозицияЛокальнойСметыДок.ЕстьФайл,
	// ***********************************************************
	// ++ AVV Статусы ресурсов акта.
	|	ВЫБОР КОГДА &ЭтоАкт = ИСТИНА ТОГДА
	|		ПозицииАктов.СтатусРесурса
	|	ИНАЧЕ
	|		ПозицияЛокальнойСметыДок.СтатусРесурса
	|	КОНЕЦ,
	// -- AVV 
	// ***********************************************************		
	|	[ДопРеквизитПозиция]
	|ИЗ
	|	ПозицииЛокальнойСметыВременная КАК ПозицияЛокальнойСметыДок
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета КАК Рег
	|		ПО ПозицияЛокальнойСметыДок.Ссылка = Рег.Позиция
	|			И ПозицияЛокальнойСметыДок.ИДРодителя = Рег.Раздел
	|			И (ПозицияЛокальнойСметыДок.ИДСметы = Рег.Смета
	|					И &ЭтоАкт = ЛОЖЬ
	|				ИЛИ &АктВыполненныхРабот = Рег.Смета
	|					И &ЭтоАкт = ИСТИНА)
	|			И (ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета <> ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП КАК РегРес
	|		ПО ПозицияЛокальнойСметыДок.Ссылка = РегРес.Позиция
	|			И ПозицияЛокальнойСметыДок.ИДРодителя = РегРес.Раздел
	|			И (ПозицияЛокальнойСметыДок.ИДСметы = РегРес.Смета
	|					И &ЭтоАкт = ЛОЖЬ
	|				ИЛИ &АктВыполненныхРабот = РегРес.Смета
	|					И &ЭтоАкт = ИСТИНА)
	|			И (ПозицияЛокальнойСметыДок.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный))
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПорядокПозиций КАК ПорядокПозиций
	|		ПО ПозицияЛокальнойСметыДок.Ссылка = ПорядокПозиций.Ссылка
	|			И ПозицияЛокальнойСметыДок.ИДРодителя = ПорядокПозиций.Раздел
	|		[ДопУсловиеПозиция]
	// ***********************************************************
	// ++ AVV Статусы ресурсов акта.
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПозицииАктов КАК ПозицииАктов
	|		ПО ПозицияЛокальнойСметыДок.Ссылка = ПозицииАктов.Позиция
	// -- AVV 
	// ***********************************************************	
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерРаздела,
	|	НомерРодителя,
	|	ТипСтроки,
	|	НомерПозиции";

	Возврат ТекстЗапроса;				   
	
КонецФункции

// Возвращает запрос на формирование дерева акта с фильтром по объему.
//
// Возвращаемое значение:
//     ТекстЗапроса - Строка - содержит текст запроса на формирование таблицы для дерева разделов и позиций.
//
Функция ПолучитьТекстЗапросаНаДеревоСоставаАктаФильтрОбъем() Экспорт
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ЛокальнаяСмета.Ссылка КАК Ссылка,
	|	ЛокальнаяСмета.Наименование КАК Наименование,
	|	ЛокальнаяСмета.ИД КАК ИД,
	|	ЛокальнаяСмета.ИДРодителя КАК ИДРодителя
	|ПОМЕСТИТЬ ЛокальнаяСметаВременная
	|ИЗ
	|	Документ.СМ_ЛокальнаяСмета КАК ЛокальнаяСмета
	|ГДЕ
	|	ЛокальнаяСмета.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РазделЛокальнойСметы.Ссылка,
	|	РазделЛокальнойСметы.НаименованиеДляПечати,
	|	РазделЛокальнойСметы.НомерВПределахСметы,
	|	РазделЛокальнойСметы.НомерВДереве,
	|	РазделЛокальнойСметы.ИД,
	|	РазделЛокальнойСметы.ИДРодителя,
	|	РазделЛокальнойСметы.ИДСметы,
	|	РазделЛокальнойСметы.Расчет,
	|	РазделЛокальнойСметы.ПорНомер,
	|	РазделЛокальнойСметы.Номер
	|ПОМЕСТИТЬ РазделыЛокальнойСметыВременная
	|ИЗ
	|	Документ.СМ_РазделЛокальнойСметы КАК РазделЛокальнойСметы
	|ГДЕ
	|	РазделЛокальнойСметы.ИДСметы = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_АктВыполненныхРаботПозиции.Позиция,
	|	СУММА(СМ_АктВыполненныхРаботПозиции.ФактОбъем) КАК Всего
	|ПОМЕСТИТЬ ПозицииАкты
	|ИЗ
	|	Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_АктВыполненныхРаботПозиции
	|ГДЕ
	|	СМ_АктВыполненныхРаботПозиции.Ссылка.ЛокальнаяСмета = &Ссылка
	|	И СМ_АктВыполненныхРаботПозиции.Ссылка.Проведен = ИСТИНА И НЕ СМ_АктВыполненныхРаботПозиции.Ссылка = &АктВыполненныхРабот
	|
	|СГРУППИРОВАТЬ ПО
	|	СМ_АктВыполненныхРаботПозиции.Позиция
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_АктВыполненныхРаботПозиции.Позиция,
	|   СМ_АктВыполненныхРаботПозиции.СтатусРесурса КАК СтатусРесурса,  // ++ AVV Статусы ресурсов акта
	|	СУММА(СМ_АктВыполненныхРаботПозиции.ФактОбъем) КАК Всего,
	|	СМ_АктВыполненныхРаботПозиции.СсылкаНаФайл
	|ПОМЕСТИТЬ ПозицииАктов
	|ИЗ
	|	Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_АктВыполненныхРаботПозиции
	|ГДЕ
	|	СМ_АктВыполненныхРаботПозиции.Ссылка.ЛокальнаяСмета = &Ссылка И
	|	СМ_АктВыполненныхРаботПозиции.Ссылка = &АктВыполненныхРабот
	|
	|СГРУППИРОВАТЬ ПО
	|	СМ_АктВыполненныхРаботПозиции.Позиция,
	|   СМ_АктВыполненныхРаботПозиции.СтатусРесурса, // ++ AVV Статусы ресурсов акта
	|	СМ_АктВыполненныхРаботПозиции.СсылкаНаФайл
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел <> ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка)
	|			ТОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел
	|		ИНАЧЕ СМ_НумерацияПозицийЛокальныхСмет.Смета
	|	КОНЕЦ КАК Документ,
	|	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	|	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	|	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
	|ПОМЕСТИТЬ НомераРазделовСметы
	|ИЗ
	|	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	|ГДЕ
	|	СМ_НумерацияПозицийЛокальныхСмет.Смета = &Ссылка
	|	И СМ_НумерацияПозицийЛокальныхСмет.Позиция = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_НумерацияПозицийЛокальныхСмет.Позиция КАК Документ,
	|	СМ_НумерацияПозицийЛокальныхСмет.Раздел КАК Раздел,
	|	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	|	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	|	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
	|ПОМЕСТИТЬ НомераПозицийСметы
	|ИЗ
	|	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	|ГДЕ
	|	СМ_НумерацияПозицийЛокальныхСмет.Смета = &Ссылка
	|	И СМ_НумерацияПозицийЛокальныхСмет.Позиция <> ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НомераРазделовСметы.Документ КАК Ссылка,
	|	НомераРазделовСметы.НомерВДереве КАК НомерРодителя,
	|	НомераРазделовСметы.НомерВДереве КАК НомерПозиции,
	|	ЕСТЬNULL(НомераРазделовСметыРодитель.НомерВДереве, 0) КАК НомерРаздела,
	|	НомераРазделовСметы.НомерВДереве,
	|	НомераРазделовСметы.НомерВПределахСметы,
	|	НомераРазделовСметы.ПорНомер
	|ПОМЕСТИТЬ ПорядокРазделов
	|ИЗ
	|	НомераРазделовСметы КАК НомераРазделовСметы
	|		ЛЕВОЕ СОЕДИНЕНИЕ НомераРазделовСметы КАК НомераРазделовСметыРодитель
	|		ПО НомераРазделовСметы.Документ.ИДРодителя = НомераРазделовСметыРодитель.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НомераПозицийСметы.Документ КАК Ссылка,
	|	НомераПозицийСметы.Раздел КАК Раздел,
	|	ВЫБОР
	|		КОГДА НомераПозицийСметы.Документ.ИДПозицииВладельца = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	|			ТОГДА НомераПозицийСметы.НомерВДереве
	|		ИНАЧЕ НомераПозицийСметыРодитель.НомерВДереве
	|	КОНЕЦ КАК НомерРодителя,
	|	НомераПозицийСметы.НомерВДереве КАК НомерПозиции,
	|	ЕСТЬNULL(НомераРазделовСметыРодитель.НомерВДереве, 0) КАК НомерРаздела,
	|	НомераПозицийСметы.НомерВДереве,
	|	НомераПозицийСметы.НомерВПределахСметы,
	|	НомераПозицийСметы.ПорНомер
	|ПОМЕСТИТЬ ПорядокПозиций
	|ИЗ
	|	НомераПозицийСметы КАК НомераПозицийСметы
	|		ЛЕВОЕ СОЕДИНЕНИЕ НомераПозицийСметы КАК НомераПозицийСметыРодитель
	|		ПО НомераПозицийСметы.Документ.ИДПозицииВладельца = НомераПозицийСметыРодитель.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ НомераРазделовСметы КАК НомераРазделовСметыРодитель
	|		ПО НомераПозицийСметы.Документ.ИДРодителя = НомераРазделовСметыРодитель.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПозицияЛокальнойСметы.Ссылка,
	|	ПозицияЛокальнойСметы.Наименование,
	|	ПозицияЛокальнойСметы.Расчет,
	|	ПозицияЛокальнойСметы.ИД,
	|	ПозицияЛокальнойСметы.ИДРодителя,
	|	ПозицияЛокальнойСметы.ИДСметы,
	|	ПозицияЛокальнойСметы.ИДПозицииВладельца,
	|	ПозицияЛокальнойСметы.Номер,
	|	ПозицияЛокальнойСметы.НомерВПределахСметы,
	|	ПозицияЛокальнойСметы.НомерВДереве,
	|	ПозицияЛокальнойСметы.ПорНомер,
	|	ПозицияЛокальнойСметы.ОбъемРабот,
	|	ПозицияЛокальнойСметы.ШифрРасценки,
	|	ПозицияЛокальнойСметы.Измеритель,
	|	ПозицияЛокальнойСметы.Определитель,
	|	ПозицияЛокальнойСметы.НеПрименятьИндексы,
	|	ПозицияЛокальнойСметы.ТекущаяЦена,
	|	ПозицияЛокальнойСметы.ТекущаяЗарплатаМашинистов,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметы.НеПрименятьИндексы
	|			ТОГДА ПозицияЛокальнойСметы.ТекущаяЦена
	|		ИНАЧЕ ВЫБОР
