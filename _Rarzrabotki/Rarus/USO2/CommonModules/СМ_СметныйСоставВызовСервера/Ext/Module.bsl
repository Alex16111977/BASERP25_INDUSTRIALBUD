////////////////////////////////////////////////////////////////////////////////
// Подсистема "Сметная подсистема".
//
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область ЗаполнениеДереваЗначений

// Возвращает запрос на формирование дерева смет.
//
// Параметры:
//     ТекущийАкт - ДокументСсылка.СМ_АктВыполненныхРабот - если формируется дерево акта,
//                  то ссылка на акт передается в данном параметре.
//	   ЭтоФормированиеСметыНаОстатки - Булево - определяет вариант получения текста запроса. 
//
// Возвращаемое значение:
//     ТекстЗапроса - Строка - содержит текст запроса на формирование таблицы для дерева разделов и позиций.
//
Функция ПолучитьТекстЗапросаНаДеревоСмет(ТекущийАкт = Неопределено, ЭтоФормированиеСметыНаОстатки = Ложь) Экспорт
          				   
	Если ЭтоФормированиеСметыНаОстатки Тогда
		
		Если ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","НеДобавлятьВКорректировкуПозицииСНулевымиОбъемами",Ложь) тогда
			Возврат ПолучитьТекстЗапросаНаДеревоСметЛокальнаяСметаБезНулевыхОбъемов();
		Иначе
			Возврат ПолучитьТекстЗапросаНаДеревоСметЛокальнаяСмета();
		КонецЕсли;

	ИначеЕсли ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ПоказыватьВсегоНачало",Ложь) Тогда
		Возврат ПолучитьТекстЗапросаНаДеревоАкт();
	Иначе
		Возврат ПолучитьТекстЗапросаНаДеревоСметЛокальнаяСмета();
	КонецЕсли;			                				   

КонецФункции

// Возвращает запрос на формирование дерева смет.
//
// Возвращаемое значение:
//     ТекстЗапроса - Строка - содержит текст запроса на формирование таблицы для дерева разделов и позиций.
//
Функция ПолучитьТекстЗапросаНаДеревоАкт() Экспорт		
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ЛокальнаяСмета.Ссылка КАК Ссылка,
	|	ЛокальнаяСмета.Наименование КАК Наименование,
	|	ЛокальнаяСмета.ИД КАК ИД,
	|	ЛокальнаяСмета.ИДРодителя КАК ИДРодителя
	|ПОМЕСТИТЬ ЛокальнаяСметаВременная
	|ИЗ
	|	Документ.СМ_ЛокальнаяСмета КАК ЛокальнаяСмета
	|ГДЕ
	|	ЛокальнаяСмета.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РазделЛокальнойСметы.Ссылка,
	|	РазделЛокальнойСметы.НаименованиеДляПечати,
	|	РазделЛокальнойСметы.НомерВПределахСметы,
	|	РазделЛокальнойСметы.НомерВДереве,
	|	РазделЛокальнойСметы.ИД,
	|	РазделЛокальнойСметы.ИДРодителя,
	|	РазделЛокальнойСметы.ИДСметы,
	|	РазделЛокальнойСметы.Расчет,
	|	РазделЛокальнойСметы.ПорНомер,
	|	РазделЛокальнойСметы.Номер
	|ПОМЕСТИТЬ РазделыЛокальнойСметыВременная
	|ИЗ
	|	Документ.СМ_РазделЛокальнойСметы КАК РазделЛокальнойСметы
	|ГДЕ
	|	РазделЛокальнойСметы.ИДСметы = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_АктВыполненныхРаботПозиции.Позиция,
	|	СУММА(СМ_АктВыполненныхРаботПозиции.ФактОбъем) КАК Всего
	|ПОМЕСТИТЬ ПозицииАктов
	|ИЗ
	|	Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_АктВыполненныхРаботПозиции
	|ГДЕ
	|	СМ_АктВыполненныхРаботПозиции.Ссылка.ЛокальнаяСмета = &Ссылка И
	|	СМ_АктВыполненныхРаботПозиции.Ссылка.Проведен = ИСТИНА И
	|	СМ_АктВыполненныхРаботПозиции.Ссылка <> &АктВыполненныхРабот
	|
	|СГРУППИРОВАТЬ ПО
	|	СМ_АктВыполненныхРаботПозиции.Позиция
	|;
	|
	// *********************************************************************************
	// ++ AVV Статусы ресурсов акта.
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_АктВыполненныхРаботПозиции.Позиция,
	|	СМ_АктВыполненныхРаботПозиции.СтатусРесурса КАК СтатусРесурса 
	|ПОМЕСТИТЬ СтатусыПозицийАктов
	|ИЗ
	|	Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_АктВыполненныхРаботПозиции
	|ГДЕ
	|	СМ_АктВыполненныхРаботПозиции.Ссылка.ЛокальнаяСмета = &Ссылка И
	|	СМ_АктВыполненныхРаботПозиции.Ссылка.Проведен = ИСТИНА И
	|	СМ_АктВыполненныхРаботПозиции.Ссылка = &АктВыполненныхРабот 
	|
	|СГРУППИРОВАТЬ ПО
	|	СМ_АктВыполненныхРаботПозиции.Позиция,
	|	СМ_АктВыполненныхРаботПозиции.СтатусРесурса 
	|;
	|
	// -- AVV Статусы ресурсов акта.
	// *********************************************************************************
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_АктВыполненныхРаботПозиции.Позиция,
	|	СМ_АктВыполненныхРаботПозиции.СсылкаНаФайл
	|ПОМЕСТИТЬ ПозицииАкта
	|ИЗ
	|	Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_АктВыполненныхРаботПозиции
	|ГДЕ
	|	СМ_АктВыполненныхРаботПозиции.Ссылка.ЛокальнаяСмета = &Ссылка И
	|	СМ_АктВыполненныхРаботПозиции.Ссылка.Проведен = ИСТИНА И
	|	СМ_АктВыполненныхРаботПозиции.Ссылка = &АктВыполненныхРабот
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПозицияЛокальнойСметы.Ссылка КАК Ссылка,
	|	ПозицияЛокальнойСметы.Наименование КАК Наименование,
	|	ПозицияЛокальнойСметы.Расчет КАК Расчет,
	|	ПозицияЛокальнойСметы.ИД КАК ИД,
	|	ПозицияЛокальнойСметы.ИДРодителя КАК ИДРодителя,
	|	ПозицияЛокальнойСметы.ИДСметы КАК ИДСметы,
	|	ПозицияЛокальнойСметы.ИДПозицииВладельца КАК ИДПозицииВладельца,
	|	ПозицияЛокальнойСметы.Номер КАК Номер,
	|	ПозицияЛокальнойСметы.НомерВПределахСметы КАК НомерВПределахСметы,
	|	ПозицияЛокальнойСметы.НомерВДереве КАК НомерВДереве,
	|	ПозицияЛокальнойСметы.ПорНомер КАК ПорНомер,
	|	ПозицияЛокальнойСметы.ОбъемРабот КАК ОбъемРабот,
	|	ПозицияЛокальнойСметы.ШифрРасценки КАК ШифрРасценки,
	|	ПозицияЛокальнойСметы.Измеритель КАК Измеритель,
	|	ПозицияЛокальнойСметы.Определитель КАК Определитель,
	|	ПозицияЛокальнойСметы.НеПрименятьИндексы КАК НеПрименятьИндексы,
	|	ПозицияЛокальнойСметы.ТекущаяЦена КАК ТекущаяЦена,
	|	ПозицияЛокальнойСметы.ТекущаяЗарплатаМашинистов КАК ТекущаяЗарплатаМашинистов,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметы.НеПрименятьИндексы
	|			ТОГДА ПозицияЛокальнойСметы.ТекущаяЦена
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПозицияЛокальнойСметы.ИДСметы.ПечататьЕдиничныеСтоимостиЧП
	|					ТОГДА ВЫБОР
	|							КОГДА ПозицияЛокальнойСметы.Определитель.ВидРасценки = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыРасценки.Оборудование)
	|								ТОГДА СтоимостьПозицииЧП.ТекСтоимОборуд
	|							ИНАЧЕ СтоимостьПозицииЧП.ТекСтоимПрямЗатраты
	|						КОНЕЦ
	|				ИНАЧЕ ВЫБОР
	|						КОГДА ПозицияЛокальнойСметы.Определитель.ВидРасценки = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыРасценки.Оборудование)
	|							ТОГДА ВЫБОР
	|									КОГДА ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|										ТОГДА РесурснаяСтоимостьПозиции.ТекСтоимОборуд
	|									ИНАЧЕ ПозицияЛокальнойСметы.Оборудование
	|								КОНЕЦ
	|						ИНАЧЕ ВЫБОР
	|								КОГДА ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|									ТОГДА РесурснаяСтоимостьПозиции.ТекСтоимПрямЗатраты
	|								ИНАЧЕ ПозицияЛокальнойСметы.ПрямЗатраты
	|							КОНЕЦ
	|					КОНЕЦ
	|			КОНЕЦ
	|	КОНЕЦ КАК ПрямЗатраты,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметы.НеПрименятьИндексы
	|			ТОГДА 0
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПозицияЛокальнойСметы.ИДСметы.ПечататьЕдиничныеСтоимостиЧП
	|					ТОГДА СтоимостьПозицииЧП.ТекСтоимОснЗарплата
	|				ИНАЧЕ ВЫБОР
	|						КОГДА ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|							ТОГДА РесурснаяСтоимостьПозиции.ТекСтоимОснЗарплата
	|						ИНАЧЕ ПозицияЛокальнойСметы.ОснЗарплата
	|					КОНЕЦ
	|			КОНЕЦ
	|	КОНЕЦ КАК ОснЗарплата,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметы.НеПрименятьИндексы
	|			ТОГДА ВЫБОР
	|					КОГДА ПозицияЛокальнойСметы.Определитель.ВидРасценки <> ЗНАЧЕНИЕ(Перечисление.СМ_ВидыРасценки.Оборудование)
	|							И ПозицияЛокальнойСметы.Определитель.ВидРасценки <> ЗНАЧЕНИЕ(Перечисление.СМ_ВидыРасценки.Материал)
	|						ТОГДА ПозицияЛокальнойСметы.ТекущаяЦена
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПозицияЛокальнойСметы.ИДСметы.ПечататьЕдиничныеСтоимостиЧП
	|					ТОГДА СтоимостьПозицииЧП.ТекСтоимЭксплМашин
	|				ИНАЧЕ ВЫБОР
	|						КОГДА ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|							ТОГДА РесурснаяСтоимостьПозиции.ТекСтоимЭксплМашин
	|						ИНАЧЕ ПозицияЛокальнойСметы.ЭксплМашин
	|					КОНЕЦ
	|			КОНЕЦ
	|	КОНЕЦ КАК ЭксплМашин,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметы.НеПрименятьИндексы
	|			ТОГДА ПозицияЛокальнойСметы.ТекущаяЗарплатаМашинистов
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПозицияЛокальнойСметы.ИДСметы.ПечататьЕдиничныеСтоимостиЧП
	|					ТОГДА СтоимостьПозицииЧП.ТекСтоимЗарплМашин
	|				ИНАЧЕ ВЫБОР
	|						КОГДА ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|							ТОГДА РесурснаяСтоимостьПозиции.ТекСтоимЗарплМашин
	|						ИНАЧЕ ПозицияЛокальнойСметы.ЗарплМашинистов
	|					КОНЕЦ
	|			КОНЕЦ
	|	КОНЕЦ КАК ЗарплМашинистов,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметы.НеПрименятьИндексы
	|			ТОГДА ВЫБОР
	|					КОГДА ПозицияЛокальнойСметы.Определитель.ВидРасценки = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыРасценки.Материал)
	|						ТОГДА ПозицияЛокальнойСметы.ТекущаяЦена
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПозицияЛокальнойСметы.ИДСметы.ПечататьЕдиничныеСтоимостиЧП
	|					ТОГДА СтоимостьПозицииЧП.ТекСтоимСтоимМатер
	|				ИНАЧЕ ВЫБОР
	|						КОГДА ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|							ТОГДА РесурснаяСтоимостьПозиции.ТекСтоимСтоимМатер
	|						ИНАЧЕ ПозицияЛокальнойСметы.СтоимМатериалов
	|					КОНЕЦ
	|			КОНЕЦ
	|	КОНЕЦ КАК СтоимМатериалов,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметы.ИДСметы.ПечататьЕдиничныеСтоимостиЧП
	|			ТОГДА СтоимостьПозицииЧП.ЗатратыТрудаРабочих
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|					ТОГДА РесурснаяСтоимостьПозиции.ЗатратыТрудаРабочих
	|				ИНАЧЕ ПозицияЛокальнойСметы.ЗатратыТрудаРабочих
	|			КОНЕЦ
	|	КОНЕЦ КАК ЗатратыТрудаРабочих,
	|	ВЫБОР
	|		КОГДА ПозицияЛокальнойСметы.ИДСметы.ПечататьЕдиничныеСтоимостиЧП
	|			ТОГДА СтоимостьПозицииЧП.ЗатратыТрудаМашин
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	|					ТОГДА РесурснаяСтоимостьПозиции.ЗатратыТрудаМашин
	|				ИНАЧЕ ПозицияЛокальнойСметы.ЗатратыТрудаМашинистов
	|			КОНЕЦ
	|	КОНЕЦ КАК ЗатратыТрудаМашинистов,
	|	ПозицияЛокальнойСметы.ОтмеченаВДереве КАК ОтмеченаВДереве,
	|	ПозицияЛокальнойСметы.Версия КАК Версия,
	|	ЕСТЬNULL(ПозицииАктов.Всего, 0) КАК ОбъемВсего,
	|	ВЫБОР
	|		КОГДА ПозицииАкта.СсылкаНаФайл ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьФайл,
	|	ПозицияЛокальнойСметы.СтатусРесурса
	|
	|ПОМЕСТИТЬ ПозицииЛокальнойСметыВременная
	|ИЗ
	|	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_РесурснаяСтоимостьПозиции КАК РесурснаяСтоимостьПозиции
	|		ПО (РесурснаяСтоимостьПозиции.Позиция = ПозицияЛокальнойСметы.Ссылка)
	|			И (РесурснаяСтоимостьПозиции.Смета = ПозицияЛокальнойСметы.ИДСметы
	|					И &ЭтоАкт = ЛОЖЬ
	|				ИЛИ &АктВыполненныхРабот = РесурснаяСтоимостьПозиции.Смета
	|					И &ЭтоАкт = ИСТИНА)
	|			И (РесурснаяСтоимостьПозиции.Раздел = ПозицияЛокальнойСметы.ИДРодителя)
	|			И (ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный))
	|			И (НЕ ПозицияЛокальнойСметы.ИДСметы.ПечататьЕдиничныеСтоимостиЧП)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПозицииАктов КАК ПозицииАктов
	|		ПО ПозицияЛокальнойСметы.Ссылка = ПозицииАктов.Позиция
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПозицииАкта КАК ПозицииАкта
	|		ПО ПозицияЛокальнойСметы.Ссылка = ПозицииАкта.Позиция
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП КАК СтоимостьПозицииЧП
	|		ПО ПозицияЛокальнойСметы.Ссылка = СтоимостьПозицииЧП.Позиция
	|			И ПозицияЛокальнойСметы.ИДРодителя = СтоимостьПозицииЧП.Раздел
	|			И (СтоимостьПозицииЧП.Смета = ПозицияЛокальнойСметы.ИДСметы
	|					И &ЭтоАкт = ЛОЖЬ
	|				ИЛИ &АктВыполненныхРабот = СтоимостьПозицииЧП.Смета
	|					И &ЭтоАкт = ИСТИНА)
	|			И (ПозицияЛокальнойСметы.ИДСметы.ПечататьЕдиничныеСтоимостиЧП)
	|ГДЕ
