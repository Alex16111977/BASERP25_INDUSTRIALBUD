		ДопРеквизитРаздел = "";
		ДопРеквизитПозиция = "";
		ДопУсловиеРаздел = "";
		ДопУсловиеПозиция = "";
		
		сч = 1;
		Для Каждого стр Из ТЗ Цикл
			ДопРеквизитСмета = ДопРеквизитСмета+Символы.ПС +", NULL КАК "+стр.ИмяДопРеквизита;
			ДопРеквизитРаздел = ДопРеквизитРаздел+Символы.ПС +", СМ_РазделЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Значение";
			ДопРеквизитПозиция = ДопРеквизитПозиция+Символы.ПС +", СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Значение";
			
			ДопУсловиеРаздел = ДопУсловиеРаздел+Символы.ПС +" ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_РазделЛокальнойСметы.ДополнительныеРеквизиты КАК СМ_РазделЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+"	ПО (РазделЛокальнойСметыДок.Ссылка = СМ_РазделЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Ссылка
			|				И СМ_РазделЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Свойство = &Свойство"+Строка(сч)+")";
			
			ДопУсловиеПозиция = ДопУсловиеПозиция+Символы.ПС +" ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_ПозицияЛокальнойСметы.ДополнительныеРеквизиты КАК СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+" ПО (ПозицияЛокальнойСметыДок.Ссылка = СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Ссылка
			|				И СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты"+Строка(сч)+".Свойство = &Свойство"+Строка(сч)+")";
			Запрос.УстановитьПараметр("Свойство"+Строка(сч),стр.Свойство);
			сч = сч+1;
		КонецЦикла;
		
		Текст = СтрЗаменить(Текст,"[ДопРеквизитСмета]",ДопРеквизитСмета);
		Текст = СтрЗаменить(Текст,"[ДопРеквизитРаздел]",ДопРеквизитРаздел);
		Текст = СтрЗаменить(Текст,"[ДопРеквизитПозиция]",ДопРеквизитПозиция);
		Текст = СтрЗаменить(Текст,"[ДопУсловиеРаздел]",ДопУсловиеРаздел);
		Текст = СтрЗаменить(Текст,"[ДопУсловиеПозиция]",ДопУсловиеПозиция);
		
	Иначе
		Текст = СтрЗаменить(Текст,"[ДопРеквизитСмета]","");
		Текст = СтрЗаменить(Текст,"[ДопРеквизитРаздел]","");
		Текст = СтрЗаменить(Текст,"[ДопРеквизитПозиция]","");
		Текст = СтрЗаменить(Текст,"[ДопУсловиеРаздел]","");
		Текст = СтрЗаменить(Текст,"[ДопУсловиеПозиция]","");
	КонецЕсли;

	Запрос.Текст = Текст;
	
	Запрос.УстановитьПараметр("Ссылка",ЭлементКорня);
	Запрос.УстановитьПараметр("ИтогРаздела",Справочники.СМ_ИтогиПоРазделу.ИтогоПоРазделу);
	
	ИтогПоСмете = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ИтогСметыДляДерева");
	Если Не ИтогПоСмете = Неопределено
		И ИтогПоСмете.Пустая() Тогда
		ИтогПоСмете = Справочники.СМ_ИтогиПоГлавам.НайтиПоРеквизиту("Идентификатор","ИП4");
	КонецЕсли;
	
	// Запрос.УстановитьПараметр("ИтогСметы",Справочники.СМ_ИтогиПоСмете.ИтогоПоСмете);
	Запрос.УстановитьПараметр("ИтогСметы",ИтогПоСмете);
	Запрос.УстановитьПараметр("ВидРасценкиОборудование", Перечисления.СМ_ВидыРасценки.Оборудование);
	Запрос.УстановитьПараметр("ВидРасценкиМатериал", Перечисления.СМ_ВидыРасценки.Материал);
	Запрос.УстановитьПараметр("ЭтоАкт", ИСТИНА);
	Запрос.УстановитьПараметр("АктВыполненныхРабот", СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(ОбъектАкт));
	Запрос.УстановитьПараметр("ФильтрОбъем", ВариантСостава);
	
	ТабДерева = Запрос.Выполнить().Выгрузить();
	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("ОтображатьПрефиксы", ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОтображатьПрефиксы",Ложь));
	СтруктураПараметров.Вставить("Вид");
	// Вопрос определения, откуда идет вызов. Так вроде не очень корректно.
	// М.б. параметр в функцию ВывестиОбновитьДерево2.
	Если ДеревоЗначений.Колонки.Найти("НаименованиеЭлемента") <> Неопределено Тогда  
