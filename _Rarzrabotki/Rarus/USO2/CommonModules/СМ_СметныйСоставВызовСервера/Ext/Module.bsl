	Если ВыводитьДопРеквизиты Тогда
		СписокРеквизитов = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","СМ_СписокДопРеквизитовДерева");
		
		ЗапросДоп = Новый Запрос;
		ЗапросДоп.Текст = "ВЫБРАТЬ
		|	ДополнительныеРеквизитыИСведения.Ссылка КАК Свойство
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
		|ГДЕ
		|	НЕ ДополнительныеРеквизитыИСведения.ЭтоДополнительноеСведение
		|	И НЕ ДополнительныеРеквизитыИСведения.ПометкаУдаления";
		ТЗ = ЗапросДоп.Выполнить().Выгрузить();
		ТЗ.Колонки.Добавить("ИмяДопРеквизита",Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
		Для Каждого стр Из ТЗ Цикл
			GUID = СМ_ВерсионированиеСервер.ПолучитьGUIDПоУИД(стр.Свойство.УникальныйИдентификатор());
			стр.ИмяДопРеквизита = "ДопРеквизит_"+GUID;
