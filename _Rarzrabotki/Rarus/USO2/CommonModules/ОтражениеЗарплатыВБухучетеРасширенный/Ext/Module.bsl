		БухучетНачисленияКА.Колонки.НачислениеУдержание.Имя = "Начисление";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("БухучетНачисления", БухучетНачисления);
	Запрос.УстановитьПараметр("БухучетНачисленияКА", БухучетНачисленияКА);
	
