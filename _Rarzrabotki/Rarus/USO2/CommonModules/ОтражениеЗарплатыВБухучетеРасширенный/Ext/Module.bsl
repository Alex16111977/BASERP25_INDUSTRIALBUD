	ИменаТаблиц.Добавить("ВТБухучетСдельногоЗаработка");
	
	ШаблонТекстаЗапроса = 
	"ВЫБРАТЬ
	|	БухучетНачислений.ПериодРегистрации КАК ПериодРегистрации,
