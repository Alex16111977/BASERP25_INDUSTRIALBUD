#Область ПрограммныйИнтерфейс

// Проверяет наличие блокировок другими пользователями.
//
// Параметры:
//     Ссылка 				 - ДокументСсылка, СправочникСсылка	- ссылка на объект, блокировка которого проверяется.
//     Отказ 				 - Булево - может быть в процессе установлен Истина, означает отмену операции.
//     глТекущийПользователь - СправочникСсылка.Пользователи - ссылка на текущего пользователя.
//
// Возвращаемое значение:
//     Неопределено - результат проверки.
//
Функция ПроверкаБлокировки(Ссылка, Отказ, глТекущийПользователь) Экспорт
	Блокировка = СМ_СметаБлокировкиВызовСервера.ОбъектЗаблокирован(Ссылка, глТекущийПользователь); 
	Если ТипЗнч(Блокировка) = Тип("Структура") Тогда
		Если НЕ Блокировка.Пользователь = глТекущийПользователь Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Документ заблокирован пользователем %1 из документа %2'"), Строка(Блокировка.Пользователь), Строка(Блокировка.Источник)));
			Отказ = Истина;
		КонецЕсли;	
	КонецЕсли;
КонецФункции

#КонецОбласти

	 
