
////////////////////////////////////////////////////////////////////////////////
// Общий модуль "Защищенные функции (Клиент)".
//  
////////////////////////////////////////////////////////////////////////////////

#Область СлужебныеПроцедурыИФункции

// Выполняется перед интерактивным началом работы пользователя с областью данных или в локальном режиме.
// Соответствует обработчику ПередНачаломРаботыСистемы.
//
// Параметры:
//  Параметры - Структура - структура с ключевыми свойствами.
//
Процедура ПередНачаломРаботыСистемы(Параметры) Экспорт
	
	Если УСОERP_ЗащищенныеФункцииСервер.НеобходимаНастройкаСЛК() Тогда 
		Параметры.ИнтерактивнаяОбработка = Новый ОписаниеОповещения("Подключаемый_ВыполнитьНастройкуСЛК", УСОERP_ЗащищенныеФункцииКлиент);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьФормуЗащищенногоОбъекта(ИмяОбъекта, ИмяФормы="", Параметры=Неопределено, Владелец=Неопределено, Уникальность=Неопределено, Окно=Неопределено, НавигационнаяСсылка=Неопределено, ОписаниеОповещенияОЗакрытии=Неопределено, РежимОткрытияОкна=Неопределено) Экспорт
	
	Попытка
		
		// Получаем имя формы по-умолчанию
		ПолноеИмя = УСОERP_ЗащищенныеФункцииСерверПовтИсп.ИмяЗащищенногоОбъекта(ИмяОбъекта);
		
		Если ПолноеИмя=Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ПолноеИмя = ПолноеИмя + ?(ПустаяСтрока(ИмяФормы), ".Форма", ".Форма." + ИмяФормы);
		
		ОткрытьФорму(ПолноеИмя, Параметры, Владелец, Уникальность, Окно, НавигационнаяСсылка, ОписаниеОповещенияОЗакрытии, РежимОткрытияОкна);
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры // ОткрытьФормуЗащищенногоОбъекта()

Функция ПолучитьФормуЗащищенногоОбъекта(ИмяОбъекта, ИмяФормы="", Параметры=Неопределено, Владелец=Неопределено, Уникальность=Неопределено, Окно=Неопределено, НавигационнаяСсылка=Неопределено) Экспорт
	
	Попытка
		
		// Получаем имя формы по-умолчанию
		ПолноеИмя = УСОERP_ЗащищенныеФункцииСерверПовтИсп.ИмяЗащищенногоОбъекта(ИмяОбъекта);
		
		Если ПолноеИмя=Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ПолноеИмя = ПолноеИмя + ?(ПустаяСтрока(ИмяФормы), ".Форма", ".Форма." + ИмяФормы);
		
		Возврат ПолучитьФорму(ПолноеИмя, Параметры, Владелец, Уникальность, Окно, НавигационнаяСсылка);
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции // ПолучитьФормуЗащищенногоОбъекта()

Процедура Подключаемый_ВыполнитьНастройкуСЛК(Параметры, ДополнительныеПараметры) Экспорт
	
	ТекстСообщения = НСтр("ru = 'Не удалось запустить систему лицензирования.'")
		+ Символы.ПС + НСтр("ru = 'Необходимо убедится в корректности настроек СЛК.'");
	
	КнопокиДиалога = Новый СписокЗначений();
	КнопокиДиалога.Добавить("НастроитьСЛК",    НСтр("ru = 'Открыть настройки'"));
	КнопокиДиалога.Добавить("ЗавершитьРаботу", НСтр("ru = 'Завершить работу'"));
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Заголовок",                НСтр("ru = 'Система лицензирования'"));
	ПараметрыФормы.Вставить("БлокироватьВесьИнтерфейс", Истина);
	ПараметрыФормы.Вставить("Картинка",                 БиблиотекаКартинок.Предупреждение32);
	ПараметрыФормы.Вставить("ТекстСообщения",           ТекстСообщения);
	ПараметрыФормы.Вставить("Кнопки",                   КнопокиДиалога);
	
	ОткрытьФорму(
		"ОбщаяФорма.Вопрос",
		ПараметрыФормы,
		,
		,
		,
		,
		Новый ОписаниеОповещения("Подключаемый_ПоказатьВопросПользователю", УСОERP_ЗащищенныеФункцииКлиент, Параметры),
		РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

Процедура Подключаемый_ПоказатьВопросПользователю(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено И ТипЗнч(Результат) = Тип("Структура")
			И Результат.Свойство("Значение") И Результат.Значение = "НастроитьСЛК" Тогда 
		ОткрытьФорму(
			"Обработка.слкМенеджерЛицензий.Форма",
			,
			Неопределено,
			,
			,
			,
			Новый ОписаниеОповещения("Подключаемый_ПроверитьВозможностьРаботыСЛК", УСОERP_ЗащищенныеФункцииКлиент, ДополнительныеПараметры),
			РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
			
	Иначе 
		Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") И ДополнительныеПараметры.Свойство("Отказ") Тогда 
			ДополнительныеПараметры.Отказ = Истина;
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаПродолжения);
			
		Иначе 
			ЗавершитьРаботуСистемы(Ложь, Ложь);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура Подключаемый_ПроверитьВозможностьРаботыСЛК(Результат, ДополнительныеПараметры) Экспорт
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	Если УСОERP_ЗащищенныеФункцииСервер.НеобходимаНастройкаСЛК() Тогда 
		Подключаемый_ВыполнитьНастройкуСЛК(ДополнительныеПараметры, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
