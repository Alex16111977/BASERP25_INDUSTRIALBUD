КонецПроцедуры

Функция ПолучитьВозвратыССДляШапки(Ссылка,ПараметрыПечати)
	ВозвратнаяСумма = 0;
	Возвраты = Новый ТаблицаЗначений;
	Возвраты.Колонки.Вставить(1,"Наименование");
	Возвраты.Колонки.Вставить(2,"ПрямЗатраты");
	Возвраты.Колонки.Вставить(3,"ТекПрямЗатраты");
	Табл = Ссылка.Сметы.Выгрузить(,"Смета,Расчет");
	Для Каждого ТекСмета Из Табл Цикл
		Если ТекСмета.Расчет = Ложь Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ТекСмета.Смета) =  Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
			ДобавитьЛокСмет(ТекСмета.Смета,Табл);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекСмета Из Табл Цикл
		
		ПолучитьВозврат(ТекСмета.Смета,Возвраты);	
		Если ПараметрыПечати.ВБазисныхЦенах = Истина Тогда
			ВозвратнаяСумма = Возвраты.Итог("ПрямЗатраты");
		Иначе
			ВозвратнаяСумма = Возвраты.Итог("ТекПрямЗатраты");
