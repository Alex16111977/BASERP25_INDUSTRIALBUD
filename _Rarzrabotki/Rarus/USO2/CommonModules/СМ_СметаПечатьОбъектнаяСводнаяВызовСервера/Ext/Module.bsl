	Возврат(ВозвратнаяСумма);
КонецФункции

// Процедура добавления локальных смет, входящих в состав ОС.
Процедура	ДобавитьЛокСмет(ТекСметаСсылка,Табл)
	Табл1 = ТекСметаСсылка.ЛокальныеСметы.Выгрузить(,"ЛокальнаяСмета,Расчет");
	Для Каждого ТекСмета Из Табл1 Цикл
		Если ТекСмета.Расчет = Ложь Тогда
			Продолжить;
		КонецЕсли;
		СтрокаСмет  = Табл.Добавить();
		СтрокаСмет.Смета = ТекСмета.ЛокальнаяСмета;
		СтрокаСмет.Расчет = ТекСмета.Расчет;
	КонецЦикла;	
КонецПроцедуры	

// Запрос для получения стоимости возвратных материалов по смете.
Процедура ПолучитьВозврат(СметаСсылка,Возвраты)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ИтогиПоСмете.Итог,
	|СУММА(ИтогиПоСмете.ТекВозвратМатер) КАК ТекВозвратМатер,
	|СУММА(ИтогиПоСмете.ВозвратМатер) КАК ВозвратМатер
	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоСмете КАК ИтогиПоСмете
	|ГДЕ
	|	ИтогиПоСмете.Смета = &Смета 
	|	И ИтогиПоСмете.Итог = &Итог 
	|СГРУППИРОВАТЬ ПО
	|	ИтогиПоСмете.Итог
	|";
	
	Запрос.УстановитьПараметр("Смета",СметаСсылка);
	Запрос.УстановитьПараметр("Итог",Справочники.СМ_ИтогиПоСмете.ВсегоПоСмете);
	ПрямЗатраты = 0;
	ТекПрямЗатраты = 0;
	Итог = "";	
	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество() <> 0 Тогда
		СтрокаВозвр  = Возвраты.Добавить();
		СтрокаВыборки = Выборка[0];
		СтрокаВозвр.ПрямЗатраты = СтрокаВыборки.ВозвратМатер;
		СтрокаВозвр.ТекПрямЗатраты = СтрокаВыборки.ТекВозвратМатер;
		СтрокаВозвр.Наименование = "По смете " + СметаСсылка.НомерСметы + "  " + СокрЛП(СметаСсылка.Наименование);
	Иначе
		СтрокаВозвр  = Возвраты.Добавить();
		СтрокаВозвр.ПрямЗатраты = 0;
		СтрокаВозвр.ТекПрямЗатраты = 0;
		СтрокаВозвр.Наименование = "";
	КонецЕсли;	

КонецПроцедуры	

// Поиск соответствующего итога для капремонта из справочника ИтогиПоГлавам. 
Функция НайтиНаименованиеИтога(ТекИтог)
	Наименование = ТекИтог.НаименованиеРемонт;
	Возврат(Наименование);
КонецФункции	

// Поиск ненакопительного итога по главе. 
Функция НайтиИтогПоГлаве(Глава,ТипСтроительства) Экспорт
	ВыборкаСправочника = Справочники.СМ_ИтогиПоГлавам.Выбрать();
	ТекИтог = Неопределено;
	Пока ВыборкаСправочника.Следующий() Цикл
		Если ТипСтроительства = Перечисления.СМ_ТипыСтроительства.НовоеСтроительство Тогда 
			Если ВыборкаСправочника.ГлаваССРС = Глава  И ВыборкаСправочника.Накопительный = Ложь  Тогда
				ТекИтог = ВыборкаСправочника.Ссылка;
				Прервать;
			КонецЕсли;
		ИначеЕсли ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда 
			Если ВыборкаСправочника.ГлаваРемонт = Глава  И ВыборкаСправочника.Накопительный = Ложь  Тогда
				ТекИтог = ВыборкаСправочника.Ссылка;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат (ТекИтог);
КонецФункции

#КонецОбласти