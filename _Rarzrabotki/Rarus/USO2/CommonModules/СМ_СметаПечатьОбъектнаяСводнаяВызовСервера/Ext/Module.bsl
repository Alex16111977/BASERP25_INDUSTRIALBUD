// Вывод данных по смете в шапку сводной сметы.	
Процедура ВывестиШапкуСводнойСметы(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,Шапка,ШапкаСС,СтрокаФормата,КолЗнаков);
	
	ИтогДляШапкиСС 		= Справочники.СМ_ИтогиПоГлавам.НайтиПоКоду("22");
	СметнаяСтоимость 	= СметнаяСтоимостьСводнойСметы(ИтогиПоОС,ПараметрыПечати,ИтогДляШапкиСС,КолЗнаков);
	
	// *********************************************************************
	// ++ AVV Вывод валюты в шапку таблицы
	СтруктураВалюты = СМ_СметаПечатьСервер.ПолучитьСтруктуруОбозначенияВалюты(Ссылка);
	ПечВалюта 		= СтруктураВалюты.ПечВалюта;
	// -- AVV 
	// *********************************************************************
	
	Шапка.Параметры.ВсегоПоСмете = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Сводный сметный расчет в сумме %1 тыс. %2'"), СметнаяСтоимость, ПечВалюта);	
	СтоимВозврМатер = ПолучитьВозвратыССДляШапки(Ссылка,ПараметрыПечати);
	СтоимВозврМатер = Окр(СтоимВозврМатер / 1000,Колзнаков);
	Шапка.Параметры.ВозвратныеСуммы = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='В том числе возвратных сумм %1 тыс. %2'"), СтоимВозврМатер, ПечВалюта);
	Шапка.Параметры.ДатаСметы = Формат(Ссылка.Дата,"ДЛФ=D");
	Шапка.Параметры.Заказчик = ?(ПараметрыПечати.СметаСсылка.Заказчик = Неопределено,"",ПараметрыПечати.СметаСсылка.Заказчик);
	Шапка.Параметры.НаименованиеСС			= СокрЛП(Ссылка.наименование);
	ДатаЦенСС = Ссылка.СоставленаВЦенахНа;
	Если ПараметрыПечати.ВБазисныхЦенах = истина Тогда
		ДатаЦенСметы = НСтр("ru='Составлен(а)  в базисных ценах на 01.01.2000 г.'");
	Иначе
		ДатаЦенСметы = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Составлен(а)  в ценах по состоянию на %1'"), Формат(ДатаЦенСС,"ДЛФ=D")); 
	КонецЕсли;
	Шапка.Параметры.ДатаЦенСметы =  ДатаЦенСметы;
	
	// *********************************************************************
	// ++ AVV Вывод валюты в шапку таблицы
	ШапкаСС.Параметры.Заполнить(СМ_СметаПечатьСервер.ПолучитьСтруктуруОбозначенияВалюты(Ссылка));
	// -- AVV 
	// *********************************************************************

	ТабличныйДокумент.Вывести(Шапка);
	ТабличныйДокумент.Вывести(ШапкаСС);
	
КонецПроцедуры

// Вывод данных по смете в шапку сводной сметы.	
Процедура ВывестиШапкуСводнойСметыКЗ(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,Шапка,ШапкаСС,СтрокаФормата,КолЗнаков);
	
	ИтогДляШапкиСС 		= Справочники.СМ_ИтогиПоГлавам.НайтиПоКоду("22");
	СметнаяСтоимость 	= СметнаяСтоимостьСводнойСметы(ИтогиПоОС,ПараметрыПечати,ИтогДляШапкиСС,КолЗнаков);
	
	СтруктураВалюты = СМ_СметаПечатьСервер.ПолучитьСтруктуруОбозначенияВалюты(Ссылка);
	ПечВалюта 		= СтруктураВалюты.ПечВалюта;
	
	Шапка.Параметры.ВсегоПоСмете = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Сводный сметный расчет в сумме %1 тыс. %2'"), СметнаяСтоимость, ПечВалюта);	
	СтоимВозврМатер = ПолучитьВозвратыССДляШапки(Ссылка,ПараметрыПечати);
	СтоимВозврМатер = Окр(СтоимВозврМатер / 1000,Колзнаков);
	Шапка.Параметры.ДатаСметы = Формат(Ссылка.Дата,"ДЛФ=D");
	Шапка.Параметры.Заказчик = ?(ПараметрыПечати.СметаСсылка.Заказчик = Неопределено,"",ПараметрыПечати.СметаСсылка.Заказчик);
	Шапка.Параметры.НаименованиеСС			= СокрЛП(Ссылка.наименование);
	ДатаЦенСС = Ссылка.СоставленаВЦенахНа;
	Шапка.Параметры.Квартал = Формат(КонецКвартала(ДатаЦенСС),"ДФ=" "к");
	Шапка.Параметры.Год = Год(ДатаЦенСС);
	
	ШапкаСС.Параметры.Заполнить(СМ_СметаПечатьСервер.ПолучитьСтруктуруОбозначенияВалюты(Ссылка));

	ТабличныйДокумент.Вывести(Шапка);
	ТабличныйДокумент.Вывести(ШапкаСС);
	
КонецПроцедуры

// Определить сметную стоимость для шапки сводной сметы.
Функция СметнаяСтоимостьСводнойСметы(ИтогиПоОС,ПараметрыПечати,ИтогДляШапкиСС,КолЗнаков);
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Итог",ИтогДляШапкиСС);
	МассивСтрокИтогов = ИтогиПоОС.НайтиСтроки(СтруктураОтбора);
	СметнаяСтоимость = 0;
	Если МассивСтрокИтогов.Количество() > 0 Тогда
		
		Для Каждого СтрокаИтога Из МассивСтрокИтогов Цикл
			Если ПараметрыПечати.ВБазисныхЦенах = истина Тогда
				СметнаяСтоимость = СметнаяСтоимость + Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков);
			Иначе
				СметнаяСтоимость = СметнаяСтоимость + Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков);
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	Возврат(СметнаяСтоимость);
КонецФункции	

// Вывод итоговых стоимостей по видам работ для объектной  сметы.
Процедура ВывестиИтоговыеСтрокиОбъектнойСметы(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,ИтогОС,СтрокаЛС,СтрокаФормата)
	
	ПовторИтога = 0;
	Для Каждого СтрокаИтога Из ИтогиПоОС Цикл
		Если СтрокаИтога.Напечатан = Ложь Тогда
			ВсегоПоСтроке = 0;
			ОплатаТрудаПоСтроке = 0;
			СтроительныеРаботы = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы,ПараметрыПечати);
			МонтажныеРаботы = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы,ПараметрыПечати);
			Прочие = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы,ПараметрыПечати);
			Оборудование = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.Оборудование,ПараметрыПечати);
			ВсегоПоСтроке  = СтроительныеРаботы + МонтажныеРаботы + Оборудование + Прочие;
			Если ВсегоПоСтроке = 0 Тогда
				СтрокаИтога.Напечатан = Истина;
				Продолжить;
			КонецЕсли;
			// Определить ОЗ + ЗМ.
			ОТСтроительныеРаботы = ОпределитьЗарплату(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы,ПараметрыПечати);
			ОТМонтажныеРаботы = ОпределитьЗарплату(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы,ПараметрыПечати);
			ОТПрочие = ОпределитьЗарплату(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы,ПараметрыПечати);
			ОплатаТрудаПоСтроке = ОТСтроительныеРаботы + ОТМонтажныеРаботы + ОТПрочие;
			Если ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
				ТекНомерСтроки 	= ИтогиПоОС.Индекс(СтрокаИтога);
				НомерИтогаКЧему = СтрокаИтога.Итог.КИтогу.ПорядковыйНомер;
				ПечатьИтоговПеред(Ссылка,ТабличныйДокумент,ИтогиПоОС,ИтогОС,НомерИтогаКЧему,параметрыПечати,ПовторИтога,СтрокаФормата);
				ИтогиПоОС.Получить(ТекНомерСтроки);
				Если СтрДлина(СокрЛП(СтрокаИтога.Итог.Обоснование)) <> 0 Тогда
					ИтогОС.Параметры.НаименованиеИтогОС =  СокрЛП(СтрокаИтога.Итог.Обоснование) + "   " + СформироватьНаименованиеЛимЗатраты(Ссылка,СтрокаИтога.Итог);
				Иначе	
					ИтогОС.Параметры.НаименованиеИтогОС =  СформироватьНаименованиеЛимЗатраты(Ссылка,СтрокаИтога.Итог);
				КонецЕсли;

				ИтогОС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботы,СтрокаФормата);
				ИтогОС.Параметры.МонтажныеРаботы = Формат(МонтажныеРаботы,СтрокаФормата);
				ИтогОС.Параметры.Оборудование = Формат(Оборудование,СтрокаФормата);
				ИтогОС.Параметры.Прочие = Формат(Прочие,СтрокаФормата);
				ИтогОс.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтроке,СтрокаФормата);
				ИтогОс.Параметры.ОплатаТруда = Формат(ОплатаТрудаПоСтроке,СтрокаФормата);
				ТабличныйДокумент.Вывести(ИтогОС);
			ИначеЕсли ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
				СтрокаЛС.Параметры.НомерПП =  НайтиНомерПоПорядкуСметы(Ссылка,СтрокаИтога.Итог);
				СтрокаЛС.Параметры.НомерСметыДляПечати =  СтрокаИтога.Итог.НомерСметы;
				СтрокаЛС.Параметры.НаименованиеЛокальнойСметы =  СтрокаИтога.Итог.Наименование;
				СтрокаЛС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботы,СтрокаФормата);
				СтрокаЛС.Параметры.МонтажныеРаботы = Формат(МонтажныеРаботы,СтрокаФормата);
				СтрокаЛС.Параметры.Оборудование = 	Формат(Оборудование,СтрокаФормата);
				СтрокаЛС.Параметры.Прочие = Формат(Прочие,СтрокаФормата);
				СтрокаЛС.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтроке,СтрокаФормата);
				СтрокаЛС.Параметры.ОплатаТруда = Формат(ОплатаТрудаПоСтроке,СтрокаФормата);
				ТабличныйДокумент.Вывести(СтрокаЛС);
				СтрокаИтога.Напечатан = Истина;
			Иначе
				Если ПовторИтога <> ВсегоПоСтроке И СтрокаИтога.Итог.Накопительный Тогда
					Если Ссылка.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
						ИтогОС.Параметры.НаименованиеИтогОС = НайтиНаименованиеИтога(СтрокаИтога.Итог);	
					Иначе
						ИтогОС.Параметры.НаименованиеИтогОС = СтрокаИтога.Итог.Наименование;
					КонецЕсли;

					ИтогОС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботы,СтрокаФормата);
					ИтогОС.Параметры.МонтажныеРаботы = Формат(МонтажныеРаботы,СтрокаФормата);
					ИтогОС.Параметры.Оборудование = Формат(Оборудование,СтрокаФормата);
					ИтогОС.Параметры.Прочие = Формат(Прочие,СтрокаФормата);
					ИтогОс.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтроке,СтрокаФормата);
					ИтогОс.Параметры.ОплатаТруда = Формат(ОплатаТрудаПоСтроке,СтрокаФормата);
					
					ТабличныйДокумент.Вывести(ИтогОС);
					СтрокаИтога.Напечатан = Истина;
					ПовторИтога = ВсегоПоСтроке;
				Иначе
					СтрокаИтога.Напечатан = Истина;
				КонецЕсли;
				
			КонецЕсли;	
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Итог",СтрокаИтога.Итог);
			МассивСтрокВидыРабот = ИтогиПоОС.НайтиСтроки(СтруктураОтбора);
			Для каждого ТекСтрока Из МассивСтрокВидыРабот Цикл
				ТекСтрока.Напечатан = Истина;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

// Вывод итоговых стоимостей по видам работ для объектной  сметы.
Процедура ВывестиИтоговыеСтрокиОбъектнойСметыКЗ(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,ИтогОС,СтрокаЛС,СтрокаФормата)
	
	ИтогВсегоПоСтроке = 0;
	ИтогОплатаТрудаПоСтроке = 0;
	ИтогСтроительныеРаботы = 0;
	ИтогМонтажныеРаботы = 0;
	ИтогОборудование = 0;
	ИтогПрочие = 0;
	ИтогНормТрудоемкость = 0;
	Для Каждого СтрокаИтога Из ИтогиПоОС Цикл
		
		Если СтрокаИтога.Напечатан Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			
			МонтажныеРаботы = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы,ПараметрыПечати);
			СтроительныеРаботы = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы,ПараметрыПечати) + МонтажныеРаботы;
			Прочие = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы,ПараметрыПечати);
			Оборудование = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.Оборудование,ПараметрыПечати);
			
			ВсегоПоСтроке  = СтроительныеРаботы + МонтажныеРаботы + Оборудование + Прочие;
			// Определить ОЗ + ЗМ.
			ОТСтроительныеРаботы = ОпределитьЗарплату(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы,ПараметрыПечати);
			ОТМонтажныеРаботы = ОпределитьЗарплату(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы,ПараметрыПечати);
			ОТПрочие = ОпределитьЗарплату(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы,ПараметрыПечати);
			ОплатаТрудаПоСтроке = ОТСтроительныеРаботы + ОТМонтажныеРаботы + ОТПрочие;
			
			НормТрудоемкость = СтрокаИтога.ЗатратыТрудаМашин + СтрокаИтога.ЗатратыТрудаРабочих;
			
			СтрокаЛС.Параметры.НомерПП =  НайтиНомерПоПорядкуСметы(Ссылка,СтрокаИтога.Итог);
			СтрокаЛС.Параметры.НомерСметы =  СтрокаИтога.Итог.НомерСметы;
			СтрокаЛС.Параметры.НаименованиеЛокальнойСметы =  СтрокаИтога.Итог.Наименование;
			СтрокаЛС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботы,СтрокаФормата);
			СтрокаЛС.Параметры.Оборудование = 	Формат(Оборудование,СтрокаФормата);
			СтрокаЛС.Параметры.Прочие = Формат(Прочие,СтрокаФормата);
			СтрокаЛС.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтроке,СтрокаФормата);
			СтрокаЛС.Параметры.ОплатаТруда = Формат(ОплатаТрудаПоСтроке,СтрокаФормата);
			СтрокаЛС.Параметры.НормТрудоемкость = Формат(НормТрудоемкость,СтрокаФормата);
			ТабличныйДокумент.Вывести(СтрокаЛС);
			
			ИтогСтроительныеРаботы = ИтогСтроительныеРаботы + СтроительныеРаботы;
			ИтогОборудование = 	ИтогОборудование + Оборудование;
			ИтогПрочие = ИтогПрочие + Прочие;
			ИтогВсегоПоСтроке = ИтогВсегоПоСтроке + ВсегоПоСтроке;
			ИтогОплатаТрудаПоСтроке = ИтогОплатаТрудаПоСтроке + ОплатаТрудаПоСтроке;
			ИтогНормТрудоемкость = ИтогНормТрудоемкость + НормТрудоемкость;

			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Итог",СтрокаИтога.Итог);
			МассивСтрокВидыРабот = ИтогиПоОС.НайтиСтроки(СтруктураОтбора);
			Для каждого ТекСтрока Из МассивСтрокВидыРабот Цикл
				ТекСтрока.Напечатан = Истина;
			КонецЦикла;

		КонецЕсли;	
		
	КонецЦикла;	
	
	ИтогОС.Параметры.СтроительныеРаботы = Формат(ИтогСтроительныеРаботы,СтрокаФормата);
	ИтогОС.Параметры.Оборудование = 	Формат(ИтогОборудование,СтрокаФормата);
	ИтогОС.Параметры.Прочие = Формат(ИтогПрочие,СтрокаФормата);
	ИтогОС.Параметры.ВсегоПоСтроке = Формат(ИтогВсегоПоСтроке,СтрокаФормата);
	ИтогОС.Параметры.ОплатаТруда = Формат(ИтогОплатаТрудаПоСтроке,СтрокаФормата);
	ИтогОС.Параметры.НормТрудоемкость = Формат(ИтогНормТрудоемкость,СтрокаФормата);
	ТабличныйДокумент.Вывести(ИтогОС);
КонецПроцедуры

// Процедура вывода стоимости возвратных материалов для ОС.
Процедура ВывестиВозвратыОС(Ссылка,ПараметрыПечати,ТабличныйДокумент,ИтогОС,СтрокаФормата)
	Табл = Ссылка.ЛокальныеСметы.Выгрузить(,"ЛокальнаяСмета,Расчет");
	Для Каждого ТекСмета Из Табл Цикл
		Если ТекСмета.Расчет = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		Возвраты = Новый ТаблицаЗначений;
		Возвраты.Колонки.Вставить(1,"Наименование");
		Возвраты.Колонки.Вставить(2,"ПрямЗатраты");
		Возвраты.Колонки.Вставить(3,"ТекПрямЗатраты");
		ПолучитьВозврат(ТекСмета.ЛокальнаяСмета,Возвраты);	
		Если ПараметрыПечати.ВБазисныхЦенах = Истина Тогда
			ВозвратнаяСумма = Возвраты.Итог("ПрямЗатраты");
		Иначе
			ВозвратнаяСумма = Возвраты.Итог("ТекПрямЗатраты");
		КонецЕсли;	
	КонецЦикла;
	Если ВозвратнаяСумма <> 0 Тогда
		ИтогОС.Параметры.НаименованиеИтогОС =  "Стоимость возвратных материалов";
		ИтогОС.Параметры.СтроительныеРаботы = "";
		ИтогОС.Параметры.МонтажныеРаботы = "";
		ИтогОС.Параметры.Оборудование = "";
		ИтогОС.Параметры.Прочие = "";
		ИтогОс.Параметры.ВсегоПоСтроке = Формат(ВозвратнаяСумма /1000 ,СтрокаФормата);
		ИтогОс.Параметры.ОплатаТруда = "";
		ТабличныйДокумент.Вывести(ИтогОС);
	КонецЕсли;
КонецПроцедуры	

