	|	СУММА(ИтогиПоГлавам.ТекОснЗарплата)/1000 КАК ТекОснЗарплата,
	|	СУММА(ИтогиПоГлавам.ТекЭксплМашин)/1000 КАК ТекЭксплМашин,
	|	СУММА(ИтогиПоГлавам.ТекЗарплМашин)/1000 КАК ТекЗарплМашин,
	|	СУММА(ИтогиПоГлавам.ТекСтоимМатер)/1000 КАК ТекСтоимМатер,
	|	СУММА(ИтогиПоГлавам.ТекОборуд)/1000 КАК ТекОборуд,
	|	СУММА(ИтогиПоГлавам.ТекВозвратМатер)/1000 КАК ТекВозвратМатер,
	|	СУММА(ИтогиПоГлавам.Оборуд)/1000 КАК Оборуд,
	|	СУММА(ИтогиПоГлавам.ОснЗарплата)/1000 КАК ОснЗарплата,
	|	СУММА(ИтогиПоГлавам.ЭксплМашин)/1000 КАК ЭксплМашин,
	|	СУММА(ИтогиПоГлавам.ЗарплМашин)/1000 КАК ЗарплМашин,
	|	СУММА(ИтогиПоГлавам.СтоимМатер)/1000 КАК СтоимМатер,
	|	СУММА(ИтогиПоГлавам.ВозвратМатер)/1000 КАК ВозвратМатер,
	|	СУММА(ИтогиПоГлавам.ПрямЗатраты)/1000 КАК ПрямЗатраты,
	|	СУММА(ИтогиПоГлавам.ЗатратыТрудаМашин)/1000 КАК ЗатратыТрудаМашин,
	|	СУММА(ИтогиПоГлавам.ЗатратыТрудаРабочих)/1000 КАК ЗатратыТрудаРабочих
	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоГлавамСС КАК ИтогиПоГлавам
	|ГДЕ
	|	ИтогиПоГлавам.Смета = &Смета
	|
	|СГРУППИРОВАТЬ ПО
	|	ИтогиПоГлавам.Глава,
	|	ИтогиПоГлавам.Итог,
	|	ИтогиПоГлавам.ВидРабот
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИтогиПоГлавам.Итог.ГлаваССРС.ПорядковыйНомер";
	
	
	Запрос.УстановитьПараметр("Смета",Ссылка);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	РезультатЗапроса.Свернуть("Итог,ВидРабот","ЗатратыТрудаРабочих,ЗатратыТрудаМашин,ПрямЗатраты,ОснЗарплата,ЭксплМашин,ЗарплМашин,СтоимМатер,Оборуд, ТекПрямЗатраты,ТекОснЗарплата,ТекЭксплМашин,ТекЗарплМашин,ТекСтоимМатер,ТекОборуд");
	
	РезультатЗапроса.Колонки.Добавить("СортировкаИтогов",Новый  ОписаниеТипов("Число"));
	РезультатЗапроса.Колонки.Добавить("Напечатан",Новый  ОписаниеТипов("Булево"));
	Для каждого СтрокаИтога Из  РезультатЗапроса Цикл
		Если ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
			СтрокаИтога.СортировкаИтогов = 2000 + СтрокаИтога.Итог.НомерПоПорядку;
			СтрокаИтога.Напечатан = Ложь;
		ИначеЕсли (ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"))
			Или (ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета"))Тогда
			СтрокаИтога.Напечатан = Истина;
		Иначе
			Если СтрНайти(ВРег(СтрокаИтога.Итог),"ИТОГ") > 0 Тогда
				СтрокаИтога.Напечатан = Истина;
			Иначе
				СтрокаИтога.Напечатан = Ложь;
				СтрокаИтога.СортировкаИтогов = 3000 + СтрокаИтога.Итог.ПорядковыйНомер;
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;	
	РезультатЗапроса.Сортировать("СортировкаИтогов");
	Возврат РезультатЗапроса;
	
КонецФункции

// Определение порядкового номера сметы в ТЧ объектной и сводной сметы.
Функция НайтиНомерПоПорядкуСметы(Ссылка,ТекИтог) Экспорт
	
	НомерПП = 0;
	Отбор = Новый Структура;
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		Сметы = Ссылка.ЛокальныеСметы.Выгрузить();
		Отбор.Вставить("ЛокальнаяСмета",ТекИтог);
	Иначе
		Сметы = Ссылка.Сметы.Выгрузить();
		Отбор.Вставить("Смета",ТекИтог);
	КонецЕсли;	
	МассивСтрок = Сметы.НайтиСтроки(Отбор);
	Если МассивСтрок.Количество() > 0 Тогда
		НомерПП = МассивСтрок[0].НомерПП;
	КонецЕсли;
	
	Возврат НомерПП;
	
КонецФункции

// Лим затраты, заданные только в составляющих ЛС необходимо добавить.
Процедура ДобавитьЛЗЛокСмет(ТекСмета,Табл1)
	
	СписокСвойств 	= "ЛимитированнаяЗатрата,Расчет";
	СписокЛокСмет = ТекСмета.ЛокальныеСметы.Выгрузить();
	Для каждого Смета Из СписокЛокСмет Цикл
		Если  Смета.Расчет = Ложь Тогда
			Продолжить;
		КонецЕсли;
		ЛокСмета = Смета.ЛокальнаяСмета;
		ТЧЛимЗатраты = ЛокСмета.ЛимитированныеЗатраты.Выгрузить();
		Если ТЧЛимЗатраты.Количество()<> 0 Тогда
			Для Каждого ЛЗ Из ТЧЛимЗатраты Цикл
				Если ЛЗ.Расчет = Истина Тогда
					Отбор = Новый Структура;
					Отбор.Вставить("ЛимитированнаяЗатрата",ЛЗ.ЛимитированнаяЗатрата);
					СтрокиОтбора = Табл1.НайтиСтроки(Отбор);
					Если СтрокиОтбора.Количество() = 0 Тогда
						НоваяЗатрата = Табл1.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяЗатрата,ЛЗ,СписокСвойств);
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры	

// Формирование наименования лимитированной затраты для объектной и сводной смет.
//	Для сводной сметы расшифровка значений ЛЗ по объектным сметам.
Функция СформироватьНаименованиеЛимЗатраты(Смета,ЛимЗатрата)
	
	Результат = Сокрлп(ЛимЗатрата.Наименование);
	
	нОтбор = Новый Структура;
	нОтбор.Вставить("ЛимитированнаяЗатрата",	ЛимЗатрата);
	нСтроки = Смета.ЛимитированныеЗатраты.НайтиСтроки(нОтбор);
	// Требуется расшифровка ЛЗ для объектных смет
	Если ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		Если нСтроки.количество() > 0 Тогда
			
			нСтрока = нСтроки.Получить(0);
			Если Смета.БазисныеЦены = Истина  Тогда
				Результат = Результат + ", "+Строка(нСтрока.БазисноеЗначениеЛимЗатраты);
			Иначе
				Результат = Результат + ", "+Строка(нСтрока.ЗначениеЛимЗатраты);
			КонецЕсли;
			Если ЛимЗатрата.ТипЗначенияЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Процент Тогда
				Результат = Результат + " %";	
			КонецЕсли;	
			Если Смета.БазисныеЦены = Истина  Тогда
				
				Если СтрДлина(Сокрлп(нСтрока.ФормулаБазисногоЗначениеЛимЗатраты)) <> 0 Тогда
					
					Результат = Результат + ", "+Сокрлп(нСтрока.ФормулаБазисногоЗначениеЛимЗатраты);	
				КонецЕсли;
			Иначе
				Если СтрДлина(Сокрлп(нСтрока.ФормулаЛимЗатраты)) <> 0 Тогда
					Результат = Результат + ", "+Сокрлп(нСтрока.ФормулаЛимЗатраты);	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		Табл = Смета.Сметы.Выгрузить(,"Смета,Расчет");
		Для Каждого ТекСмета Из Табл Цикл
			Если ТекСмета.Расчет = Ложь Тогда
				Продолжить;
			КонецЕсли;
			Табл1 = ТекСмета.Смета.ЛимитированныеЗатраты.Выгрузить();
			Если ТипЗнч(ТекСмета.Смета) =  Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
				ДобавитьЛЗЛокСмет(ТекСмета.Смета,Табл1);
			КонецЕсли;

			Отбор = Новый Структура;
			Отбор.Вставить("ЛимитированнаяЗатрата",	ЛимЗатрата);
			Строки = Табл1.НайтиСтроки(Отбор);
			Если Строки.количество() > 0 Тогда
				СтрокаОтбора = Строки.Получить(0);
				Если СтрокаОтбора.Расчет = Истина Тогда
					Если Смета.БазисныеЦены = Истина  Тогда
						Если СтрокаОтбора.БазисноеЗначениеЛимЗатраты <> 0 Тогда 
							Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1,по объекту № %2 = %3'"), Результат, ТекСмета.Смета.НомерСметы, Строка(СтрокаОтбора.БазисноеЗначениеЛимЗатраты));
						Иначе
							Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1,по объекту № %2  %3'"), Результат, ТекСмета.Смета.НомерСметы, "");
						КонецЕсли;	
					Иначе
						Если СтрокаОтбора.ЗначениеЛимЗатраты <> 0 Тогда 
							Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1,по объекту № %2 = %3'"), Результат, ТекСмета.Смета.НомерСметы, Строка(СтрокаОтбора.ЗначениеЛимЗатраты));
						Иначе
							Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1,по объекту № %2  %3'"), Результат, ТекСмета.Смета.НомерСметы, "");
						КонецЕсли;	
					КонецЕсли;
					Если ЛимЗатрата.ТипЗначенияЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Процент Тогда
						Если СтрНайти(Результат,"=") <> 0 Тогда	
							Результат = Результат + " %";	
						КонецЕсли;	
					КонецЕсли;	
					Если Смета.БазисныеЦены = Истина  Тогда
						Если СтрДлина(Сокрлп(СтрокаОтбора.ФормулаБазисногоЗначениеЛимЗатраты)) <> 0 Тогда
							Результат = Результат + ", "+Сокрлп(СтрокаОтбора.ФормулаБазисногоЗначениеЛимЗатраты);	
						КонецЕсли;
					Иначе
						Если СтрДлина(Сокрлп(СтрокаОтбора.ФормулаЛимЗатраты)) <> 0 Тогда
							Результат = Результат + ", "+Сокрлп(СтрокаОтбора.ФормулаЛимЗатраты);	
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Требуется расшифровка ЛЗ для объектных смет
	
	Если ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		Табл = Смета.ЛокальныеСметы.Выгрузить(,"ЛокальнаяСмета,Расчет");
		Для Каждого ТекСмета Из Табл Цикл
			Если ТекСмета.Расчет = Ложь Тогда
				Продолжить;
			КонецЕсли;
			Табл1 = ТекСмета.ЛокальнаяСмета.ЛимитированныеЗатраты.Выгрузить();
			
			Отбор = Новый Структура;
			Отбор.Вставить("ЛимитированнаяЗатрата",	ЛимЗатрата);
			Строки = Табл1.НайтиСтроки(Отбор);
			Если Строки.количество() > 0 Тогда
				СтрокаОтбора = Строки.Получить(0);
				
				Если СтрокаОтбора.Расчет = Истина Тогда
					
					Если Смета.БазисныеЦены = Истина  Тогда
						Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1,по ЛС № %2 = %3'"), Результат, ТекСмета.ЛокальнаяСмета.НомерСметы, Строка(СтрокаОтбора.БазисноеЗначениеЛимЗатраты));
					Иначе
						Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1,по ЛС № %2 = %3'"), Результат, ТекСмета.ЛокальнаяСмета.НомерСметы, Строка(СтрокаОтбора.ЗначениеЛимЗатраты));
					КонецЕсли;
					Если ЛимЗатрата.ТипЗначенияЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Процент Тогда
						Результат = Результат + " %";	
					КонецЕсли;	
					Если Смета.БазисныеЦены = Истина  Тогда
						Если СтрДлина(Сокрлп(СтрокаОтбора.ФормулаБазисногоЗначениеЛимЗатраты)) <> 0 Тогда
							Результат = Результат + ", "+Сокрлп(СтрокаОтбора.ФормулаБазисногоЗначениеЛимЗатраты);	
						КонецЕсли;
					Иначе
						Если СтрДлина(Сокрлп(СтрокаОтбора.ФормулаЛимЗатраты)) <> 0 Тогда
							Результат = Результат + ", "+Сокрлп(СтрокаОтбора.ФормулаЛимЗатраты);	
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// Требуется расшифровка ЛЗ для объектных смет

	Возврат Результат;
	
КонецФункции

// Процедура вывода подписей в печатные формы объектной и сводной сметы.
Процедура ВывестиПодписи(ТабличныйДокумент,Ссылка,Подписи)
	
	Для Каждого СтрокаПодписи Из Ссылка.Подписи Цикл
		Подписи.параметры.Статус = СтрокаПодписи.Статус;
		Подписи.Параметры.ФИО    = СтрокаПодписи.ФИО;
		ТабличныйДокумент.Вывести(Подписи);
	КонецЦикла;	
	
КонецПроцедуры	

// Формирование и вывод областей табличного документа.
Процедура ПечатьСводнойСметы(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати)
	КолЗнаков = 2;
	Если Ссылка.ПроводитьОкругление = истина Тогда   
		КолЗнаков = Ссылка.ФорматОкругления;		
	КонецЕсли;
	Если КолЗнаков = 1 Тогда
		СтрокаФормата = "ЧДЦ=1";
	ИначеЕсли КолЗнаков = 2 Тогда
		СтрокаФормата = "ЧДЦ=2";
	ИначеЕсли КолЗнаков = 3 Тогда
		СтрокаФормата = "ЧДЦ=3";
	Иначе
		СтрокаФормата = "ЧДЦ=0";
	КонецЕсли;
	Макет 					= Документы.СМ_СводнаяСмета.ПолучитьМакет(имяМакета);
	// Заполняем макет.
	Шапка					= Макет.ПолучитьОбласть("Шапка");
	ШапкаСС					= Макет.ПолучитьОбласть("ШапкаСС");
	НетДанных				= Макет.ПолучитьОбласть("НетДанных");
	ИтогОС					= Макет.ПолучитьОбласть("ИтогОС");
	СтрокаЛС				= Макет.ПолучитьОбласть("СтрокаЛСПечати");
	ГлаваИтогов				= Макет.ПолучитьОбласть("ГлаваИтогов");
	Подписи					= Макет.ПолучитьОбласть("Подписи");
	КолонкиПовтора			= Макет.ПолучитьОбласть("ШапкаСС|КолонкиПовтора");
	Если Ссылка.Сметы.Количество() = 0 Тогда
		ТабличныйДокумент.Вывести(НетДанных);
		Возврат;
	КонецЕсли;	
	
	ИтогиПоОС = СобратьДанныеПоСмете(Ссылка,ПараметрыПечати);
	ВывестиШапкуСводнойСметы(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,Шапка,ШапкаСС,СтрокаФормата,КолЗнаков);
	ВывестиИтоговыеСтроки(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,ИтогОС,СтрокаЛС,СтрокаФормата,ГлаваИтогов);
	ВывестиВозвратыСС(Ссылка,ПараметрыПечати,ТабличныйДокумент,ИтогОС,СтрокаФормата);
	ВывестиПодписи(ТабличныйДокумент,Ссылка,Подписи);
	ТабличныйДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	ТабличныйДокумент.ПовторятьПриПечатиСтроки = ТабличныйДокумент.Области.КолонкиПовтора;

КонецПроцедуры

// Формирование и вывод областей табличного документа.
Процедура ПечатьСводнойСметыКЗ(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати)
	КолЗнаков = 2;
	Если Ссылка.ПроводитьОкругление = истина Тогда   
		КолЗнаков = Ссылка.ФорматОкругления;		
	КонецЕсли;
	Если КолЗнаков = 1 Тогда
		СтрокаФормата = "ЧДЦ=1";
	ИначеЕсли КолЗнаков = 2 Тогда
		СтрокаФормата = "ЧДЦ=2";
	ИначеЕсли КолЗнаков = 3 Тогда
		СтрокаФормата = "ЧДЦ=3";
	Иначе
		СтрокаФормата = "ЧДЦ=0";
	КонецЕсли;
	Макет 					= Документы.СМ_СводнаяСмета.ПолучитьМакет(имяМакета);
	// Заполняем макет.
	Шапка					= Макет.ПолучитьОбласть("Шапка");
	ШапкаСС					= Макет.ПолучитьОбласть("ШапкаСС");
	НетДанных				= Макет.ПолучитьОбласть("НетДанных");
	ИтогОС					= Макет.ПолучитьОбласть("ИтогОС");
	СтрокаЛС				= Макет.ПолучитьОбласть("СтрокаЛСПечати");
	ГлаваИтогов				= Макет.ПолучитьОбласть("ГлаваИтогов");
	Подписи					= Макет.ПолучитьОбласть("Подписи");
	Разбивка				= Макет.ПолучитьОбласть("Разбивка");
	КолонкиПовтора			= Макет.ПолучитьОбласть("ШапкаСС|КолонкиПовтора");
	Если Ссылка.Сметы.Количество() = 0 Тогда
		ТабличныйДокумент.Вывести(НетДанных);
		Возврат;
	КонецЕсли;	
	
	Если ИмяМакета = "ПФ_MXL_СМ_КЗ_МакетСС" Тогда
		ИтогиПоОС = СобратьДанныеПоСметеКЗ(Ссылка,ПараметрыПечати);
		ВывестиШапкуСводнойСметыКЗ(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,Шапка,ШапкаСС,СтрокаФормата,КолЗнаков);
		Если Ссылка.РазбивкаПоГодам.Количество()=0 Тогда
			ВывестиИтоговыеСтрокиКЗ(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,ИтогОС,СтрокаЛС,СтрокаФормата,ГлаваИтогов);
		Иначе
			ВывестиИтоговыеСтрокиКЗРазбивкаГодами(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,ИтогОС,СтрокаЛС,СтрокаФормата,ГлаваИтогов,Разбивка);
		КонецЕсли;
	Иначе
		ИтогиПоОС = СобратьДанныеПоСмете(Ссылка,ПараметрыПечати);
		ВывестиШапкуСводнойСметыКЗ(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,Шапка,ШапкаСС,СтрокаФормата,КолЗнаков);
		//ВывестиИтоговыеСтрокиКЗСводно(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,ИтогОС,СтрокаЛС,СтрокаФормата,ГлаваИтогов);
	КонецЕсли;
	
	ВывестиПодписи(ТабличныйДокумент,Ссылка,Подписи);
	ТабличныйДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	ТабличныйДокумент.ПовторятьПриПечатиСтроки = ТабличныйДокумент.Области.КолонкиПовтора;

КонецПроцедуры

// Формирование и вывод областей табличного документа.
Процедура ПечатьСводнойСметыКЗ_Сводно(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати)
	КолЗнаков = 2;
	Если Ссылка.ПроводитьОкругление = истина Тогда   
		КолЗнаков = Ссылка.ФорматОкругления;		
	КонецЕсли;
	Если КолЗнаков = 1 Тогда
		СтрокаФормата = "ЧДЦ=1";
	ИначеЕсли КолЗнаков = 2 Тогда
		СтрокаФормата = "ЧДЦ=2";
	ИначеЕсли КолЗнаков = 3 Тогда
		СтрокаФормата = "ЧДЦ=3";
	Иначе
		СтрокаФормата = "ЧДЦ=0";
	КонецЕсли;
	Макет 					= Документы.СМ_СводнаяСмета.ПолучитьМакет(имяМакета);
	// Заполняем макет.
	Шапка					= Макет.ПолучитьОбласть("Шапка");
	ШапкаСС					= Макет.ПолучитьОбласть("ШапкаСС");
	НетДанных				= Макет.ПолучитьОбласть("НетДанных");
	ИтогОС					= Макет.ПолучитьОбласть("ИтогОС");
	Подписи					= Макет.ПолучитьОбласть("Подписи");
	ГлаваИтогов				= Макет.ПолучитьОбласть("ГлаваИтогов");
	КолонкиПовтора			= Макет.ПолучитьОбласть("ШапкаСС|КолонкиПовтора");
	Если Ссылка.Сметы.Количество() = 0 Тогда
		ТабличныйДокумент.Вывести(НетДанных);
		Возврат;
	КонецЕсли;	
	
	ИтогиПоОС = СобратьДанныеПоСметеКЗ_Сводно(Ссылка,ПараметрыПечати);
	ВывестиШапкуСводнойСметыКЗ(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,Шапка,ШапкаСС,СтрокаФормата,КолЗнаков);
	ВывестиИтоговыеСтрокиКЗСводно(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,ИтогОС,СтрокаФормата);
	
	ИтогиПоОС = СобратьДанныеПоСметеКЗ(Ссылка,ПараметрыПечати);
	ВывестиИтоговыеСтрокиКЗСводно_Главы(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,СтрокаФормата,ГлаваИтогов,ИтогОС);
	
	ВывестиПодписи(ТабличныйДокумент,Ссылка,Подписи);
	ТабличныйДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	ТабличныйДокумент.ПовторятьПриПечатиСтроки = ТабличныйДокумент.Области.КолонкиПовтора;

КонецПроцедуры

// Печать итогов.
Процедура ПечатьИтоговПеред(Ссылка,ТабличныйДокумент,ИтогиПоОС,ИтогОС,НомерИтогаКЧему,параметрыПечати,ПовторИтога,СтрокаФормата)
	
	Для Каждого СтрИтога Из ИтогиПоОС Цикл
		Если ТипЗнч(СтрИтога.Итог) = Тип("СправочникСсылка.СМ_ИтогиПоГлавам") И СтрИтога.Напечатан = Ложь Тогда
			ВсегоПоСтроке = 0;
			ОплатаТрудаПоСтроке = 0;
			СтроительныеРаботы = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы,ПараметрыПечати);
			МонтажныеРаботы = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы,ПараметрыПечати);
			Прочие = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы,ПараметрыПечати);
			Оборудование = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.Оборудование,ПараметрыПечати);
			
			ВсегоПоСтроке  = СтроительныеРаботы + МонтажныеРаботы + Оборудование + Прочие;
			Если ВсегоПоСтроке = 0 Тогда
				СтрИтога.Напечатан = Истина;
				Продолжить;
			КонецЕсли;
			ГлаваИтога = СтрИтога.Глава;
			Если СтрИтога.Итог.Порядковыйномер < НомерИтогаКЧему Тогда 
				Если ПовторИтога <> ВсегоПоСтроке И СтрИтога.Итог.Накопительный Тогда
					
					Если Ссылка.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
						ИтогОС.Параметры.НаименованиеИтогОС = НайтиНаименованиеИтога(СтрИтога.Итог);	
					Иначе
						ИтогОС.Параметры.НаименованиеИтогОС = СтрИтога.Итог.Наименование;
					КонецЕсли;
					ИтогОС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботы,СтрокаФормата);
					ИтогОС.Параметры.МонтажныеРаботы = Формат(МонтажныеРаботы,СтрокаФормата);
					ИтогОС.Параметры.Оборудование = Формат(Оборудование,СтрокаФормата);
					ИтогОС.Параметры.Прочие = Формат(Прочие,СтрокаФормата);
					ИтогОс.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтроке,СтрокаФормата);
					ТабличныйДокумент.Вывести(ИтогОС);
					СтрИтога.Напечатан = Истина;
					ПовторИтога = ВсегоПоСтроке;
				Иначе
					СтрИтога.Напечатан = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

