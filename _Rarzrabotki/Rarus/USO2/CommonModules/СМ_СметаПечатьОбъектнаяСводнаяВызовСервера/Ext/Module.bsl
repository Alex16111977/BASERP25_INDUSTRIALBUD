// Вывод итоговых стоимостей по видам работ для сводной сметы.
Процедура ВывестиИтоговыеСтроки(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,ИтогОС,СтрокаЛС,СтрокаФормата,ГлаваИтогов)
	
	ПовторИтога 				= 0;
	ПовторГлава 				= "";
	ВсегоПоСтрокеИтоговая 		= 0;
	СтроительныеРаботыИтоговая 	= 0;
	МонтажныеРаботыИтоговая 	= 0;
	ПрочиеИтоговая 				= 0;
	ОборудованиеИтоговая 		= 0;
	
	Если ИтогиПоОС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПовторГлаваНеНакопительногоИтога = ИтогиПоОС[0].Глава;
	Для Каждого СтрокаИтога Из ИтогиПоОС Цикл
		Если Ссылка.ПечатьПромежуточныхИтогов Тогда
			ГлаваИтога = СтрокаИтога.Глава;
			Если (ГлаваИтога <> ПовторГлаваНеНакопительногоИтога) Или (ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ИтогиПоГлавам") И (СтрокаИтога.Итог.Накопительный)) Тогда
				// Найти ненакопительный итог по главе.
				ВсегоПоСтрокеИтоговая 		= 0;
				СтроительныеРаботыИтоговая 	= 0;
				МонтажныеРаботыИтоговая 	= 0;
				ПрочиеИтоговая 				= 0;
				ОборудованиеИтоговая 		= 0;
				ИтогПоГлаве = НайтиИтогПоГлаве(ПовторГлаваНеНакопительногоИтога,Ссылка.ТипСтроительства);
				Если ИтогПоГлаве <> Неопределено Тогда
					Если ИтогПоГлаве.ВыводитьНаПечать И ВсегоПоСтрокеИтоговая <> 0 И ВсегоПоСтрокеИтоговая <> ПовторИтога Тогда
						// Выдать Итоги по главе.
						Если Ссылка.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
							ИтогОС.Параметры.НаименованиеИтогОС = НайтиНаименованиеИтога(ИтогПоГлаве);	
						Иначе
							ИтогОС.Параметры.НаименованиеИтогОС = ИтогПоГлаве.Наименование;
						КонецЕсли;
						ВсегоПоСтрокеИтоговая  = СтроительныеРаботыИтоговая + МонтажныеРаботыИтоговая + ОборудованиеИтоговая + ПрочиеИтоговая;
						
						ИтогОС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботыИтоговая,СтрокаФормата);
						ИтогОС.Параметры.МонтажныеРаботы = Формат(МонтажныеРаботыИтоговая,СтрокаФормата);
						ИтогОС.Параметры.Оборудование = Формат(ОборудованиеИтоговая,СтрокаФормата);
						ИтогОС.Параметры.Прочие = Формат(ПрочиеИтоговая,СтрокаФормата);
						ИтогОС.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтрокеИтоговая,СтрокаФормата);
						ТабличныйДокумент.Вывести(ИтогОС);
						ПовторИтога = ВсегоПоСтрокеИтоговая;
					КонецЕсли;
					ВсегоПоСтрокеИтоговая 		= 0;
					СтроительныеРаботыИтоговая 	= 0;
					МонтажныеРаботыИтоговая 	= 0;
					ПрочиеИтоговая 				= 0;
					ОборудованиеИтоговая 		= 0;
				КонецЕсли;
				ПовторГлаваНеНакопительногоИтога = ГлаваИтога;
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаИтога.Напечатан = Ложь Тогда
			
			ВсегоПоСтроке = 0;
			ОплатаТрудаПоСтроке = 0;
			СтроительныеРаботы = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы,ПараметрыПечати);
			МонтажныеРаботы = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы,ПараметрыПечати);
			Прочие = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы,ПараметрыПечати);
			Оборудование = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.Оборудование,ПараметрыПечати);
			
			ВсегоПоСтроке  = СтроительныеРаботы + МонтажныеРаботы + Оборудование + Прочие;

			Если ВсегоПоСтроке = 0 Тогда
				СтрокаИтога.Напечатан = Истина;
				Продолжить;
			КонецЕсли;
			Если ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
				Если СтрокаИтога.Глава <> ПовторГлава Тогда
					ТекГлава = СтрокаИтога.Глава;
					ВывестиГлавуПеред(ТабличныйДокумент,ТекГлава,ПовторГлава,ГлаваИтогов);
					ПовторГлава = СтрокаИтога.Глава;
				КонецЕсли;
				ТекНомерСтроки 	= ИтогиПоОС.Индекс(СтрокаИтога);
				НомерИтогаКЧему = СтрокаИтога.Итог.КИтогу.ПорядковыйНомер;
				ПечатьИтоговПеред(Ссылка,ТабличныйДокумент,ИтогиПоОС,ИтогОС,НомерИтогаКЧему,параметрыПечати,ПовторИтога,СтрокаФормата);
				ИтогиПоОС.Получить(ТекНомерСтроки);
				
				Если СтрДлина(СокрЛП(СтрокаИтога.Итог.Обоснование)) <> 0 Тогда
					ИтогОС.Параметры.НаименованиеИтогОС =  СокрЛП(СтрокаИтога.Итог.Обоснование) + "   " + СформироватьНаименованиеЛимЗатраты(Ссылка,СтрокаИтога.Итог);
				Иначе	
					ИтогОС.Параметры.НаименованиеИтогОС =  СформироватьНаименованиеЛимЗатраты(Ссылка,СтрокаИтога.Итог);
				КонецЕсли;
				ИтогОС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботы,СтрокаФормата);
				ИтогОС.Параметры.МонтажныеРаботы = Формат(МонтажныеРаботы,СтрокаФормата);
				ИтогОС.Параметры.Оборудование = Формат(Оборудование,СтрокаФормата);
				ИтогОС.Параметры.Прочие = Формат(Прочие,СтрокаФормата);
				ИтогОс.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтроке,СтрокаФормата);
				СтроительныеРаботыИтоговая = СтроительныеРаботыИтоговая + СтроительныеРаботы;
				МонтажныеРаботыИтоговая = МонтажныеРаботыИтоговая + МонтажныеРаботы;
				ПрочиеИтоговая = ПрочиеИтоговая + Прочие;
				ОборудованиеИтоговая = ОборудованиеИтоговая + Оборудование;
				ВсегоПоСтрокеИтоговая  = СтроительныеРаботыИтоговая + МонтажныеРаботыИтоговая + ОборудованиеИтоговая + ПрочиеИтоговая;
	
				ТабличныйДокумент.Вывести(ИтогОС);
				ПовторИтога = 0;
			ИначеЕсли (ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"))
				Или (ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета")) Тогда
				Если СтрокаИтога.Глава <> ПовторГлава Тогда
					ТекГлава = СтрокаИтога.Глава;
					ВывестиГлавуПеред(ТабличныйДокумент,ТекГлава,ПовторГлава,ГлаваИтогов);
					ПовторГлава = СтрокаИтога.Глава;
				КонецЕсли;
				СтрокаЛС.Параметры.НомерПП =  НайтиНомерПоПорядкуСметы(Ссылка,СтрокаИтога.Итог);
				СтрокаЛС.Параметры.НомерСметыДляПечати =  СтрокаИтога.Итог.НомерСметы;
				СтрокаЛС.Параметры.НаименованиеЛокальнойСметы =  СтрокаИтога.Итог.Наименование;
				СтрокаЛС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботы,СтрокаФормата);
				СтрокаЛС.Параметры.МонтажныеРаботы = Формат(МонтажныеРаботы,СтрокаФормата);
				СтрокаЛС.Параметры.Оборудование = 	Формат(Оборудование,СтрокаФормата);
				СтрокаЛС.Параметры.Прочие = Формат(Прочие,СтрокаФормата);
				СтрокаЛС.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтроке,СтрокаФормата);
				ТабличныйДокумент.Вывести(СтрокаЛС);
				СтроительныеРаботыИтоговая = СтроительныеРаботыИтоговая + СтроительныеРаботы;
				МонтажныеРаботыИтоговая = МонтажныеРаботыИтоговая + МонтажныеРаботы;
				ПрочиеИтоговая = ПрочиеИтоговая + Прочие;
				ОборудованиеИтоговая = ОборудованиеИтоговая + Оборудование;
				ВсегоПоСтрокеИтоговая  = СтроительныеРаботыИтоговая + МонтажныеРаботыИтоговая + ОборудованиеИтоговая + ПрочиеИтоговая;
				ПовторИтога = 0;
				СтрокаИтога.Напечатан = Истина;
			Иначе
				Если ПовторИтога <> ВсегоПоСтроке И СтрокаИтога.Итог.Накопительный Тогда
					Если Ссылка.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
						ИтогОС.Параметры.НаименованиеИтогОС = НайтиНаименованиеИтога(СтрокаИтога.Итог);	
					Иначе
						ИтогОС.Параметры.НаименованиеИтогОС = СтрокаИтога.Итог.Наименование;
					КонецЕсли;
					ИтогОС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботы,СтрокаФормата);
					ИтогОС.Параметры.МонтажныеРаботы = Формат(МонтажныеРаботы,СтрокаФормата);
					ИтогОС.Параметры.Оборудование = Формат(Оборудование,СтрокаФормата);
					ИтогОС.Параметры.Прочие = Формат(Прочие,СтрокаФормата);
					ИтогОс.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтроке,СтрокаФормата);
					ТабличныйДокумент.Вывести(ИтогОС);
					СтрокаИтога.Напечатан = Истина;
					ПовторИтога = ВсегоПоСтроке;
					ВсегоПоСтрокеИтоговая = 0;
					СтроительныеРаботыИтоговая = 0;
					МонтажныеРаботыИтоговая = 0;
					ПрочиеИтоговая = 0;
					ОборудованиеИтоговая = 0;
				Иначе
					СтрокаИтога.Напечатан = Истина;
				КонецЕсли;
			КонецЕсли;	
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Итог",СтрокаИтога.Итог);
			МассивСтрокВидыРабот = ИтогиПоОС.НайтиСтроки(СтруктураОтбора);
			Для каждого ТекСтрока Из МассивСтрокВидыРабот Цикл
				ТекСтрока.Напечатан = Истина;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры	

// Вывод итоговых стоимостей по видам работ для сводной сметы казахстан.
Процедура ВывестиИтоговыеСтрокиКЗ(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,ИтогОС,СтрокаЛС,СтрокаФормата,ГлаваИтогов)
	ПовторИтога = 0;
	ПовторГлава = "";
	ВсегоПоСтрокеИтоговая = 0;
	СтроительныеРаботыИтоговая = 0;
	МонтажныеРаботыИтоговая = 0;
	ПрочиеИтоговая = 0;
	ОборудованиеИтоговая = 0;
	Если ИтогиПоОС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ПовторГлаваНеНакопительногоИтога = ИтогиПоОС[0].Глава;
	Для Каждого СтрокаИтога Из ИтогиПоОС Цикл
		Если Ссылка.ПечатьПромежуточныхИтогов Тогда
			ГлаваИтога = СтрокаИтога.Глава;
			Если (ГлаваИтога <> ПовторГлаваНеНакопительногоИтога) Или 
				(ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ИтогиПоГлавам")
				И (СтрокаИтога.Итог.Накопительный)) Тогда
				// Найти ненакопительный итог по главе.
				ВсегоПоСтрокеИтоговая = 0;
				СтроительныеРаботыИтоговая = 0;
				МонтажныеРаботыИтоговая = 0;
				ПрочиеИтоговая = 0;
				ОборудованиеИтоговая = 0;
				ИтогПоГлаве = НайтиИтогПоГлаве(ПовторГлаваНеНакопительногоИтога,Ссылка.ТипСтроительства);
				Если ИтогПоГлаве <> Неопределено Тогда
					Если ИтогПоГлаве.ВыводитьНаПечать И ВсегоПоСтрокеИтоговая <> 0
						И ВсегоПоСтрокеИтоговая <> ПовторИтога Тогда
						// Выдать Итоги по главе.
						Если Ссылка.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
							ИтогОС.Параметры.НаименованиеИтогОС = НайтиНаименованиеИтога(ИтогПоГлаве);	
						Иначе
							ИтогОС.Параметры.НаименованиеИтогОС = ИтогПоГлаве.Наименование;
						КонецЕсли;
						ВсегоПоСтрокеИтоговая  = СтроительныеРаботыИтоговая + МонтажныеРаботыИтоговая + ОборудованиеИтоговая + ПрочиеИтоговая;
						
						ИтогОС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботыИтоговая+МонтажныеРаботыИтоговая,СтрокаФормата);
						ИтогОС.Параметры.Оборудование = Формат(ОборудованиеИтоговая,СтрокаФормата);
						ИтогОС.Параметры.Прочие = Формат(ПрочиеИтоговая,СтрокаФормата);
						ИтогОС.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтрокеИтоговая,СтрокаФормата);
						ТабличныйДокумент.Вывести(ИтогОС);
						ПовторИтога = ВсегоПоСтрокеИтоговая;
					КонецЕсли;
					ВсегоПоСтрокеИтоговая = 0;
					СтроительныеРаботыИтоговая = 0;
					МонтажныеРаботыИтоговая = 0;
					ПрочиеИтоговая = 0;
					ОборудованиеИтоговая = 0;
				КонецЕсли;
				ПовторГлаваНеНакопительногоИтога = ГлаваИтога;
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаИтога.Напечатан = Ложь Тогда
			
			ВсегоПоСтроке = 0;
			ОплатаТрудаПоСтроке = 0;
			СтроительныеРаботы = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы,ПараметрыПечати);
			МонтажныеРаботы = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы,ПараметрыПечати);
			Прочие = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы,ПараметрыПечати);
			Оборудование = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.Оборудование,ПараметрыПечати);
			
			ВсегоПоСтроке  = СтроительныеРаботы + МонтажныеРаботы + Оборудование + Прочие;

			Если ВсегоПоСтроке = 0 Тогда
				СтрокаИтога.Напечатан = Истина;
				Продолжить;
			КонецЕсли;
			Если ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
				Если СтрокаИтога.Глава <> ПовторГлава Тогда
					ТекГлава = СтрокаИтога.Глава;
					ВывестиГлавуПеред(ТабличныйДокумент,ТекГлава,ПовторГлава,ГлаваИтогов);
					ПовторГлава = СтрокаИтога.Глава;
				КонецЕсли;
				ТекНомерСтроки 	= ИтогиПоОС.Индекс(СтрокаИтога);
				НомерИтогаКЧему = СтрокаИтога.Итог.КИтогу.ПорядковыйНомер;
				ПечатьИтоговПередКЗ(Ссылка,ТабличныйДокумент,ИтогиПоОС,ИтогОС,НомерИтогаКЧему,параметрыПечати,ПовторИтога,СтрокаФормата);
				ИтогиПоОС.Получить(ТекНомерСтроки);
				
				Если СтрДлина(СокрЛП(СтрокаИтога.Итог.Обоснование)) <> 0 Тогда
					ИтогОС.Параметры.НаименованиеИтогОС =  СокрЛП(СтрокаИтога.Итог.Обоснование) + "   " + СформироватьНаименованиеЛимЗатраты(Ссылка,СтрокаИтога.Итог);
				Иначе	
					ИтогОС.Параметры.НаименованиеИтогОС =  СформироватьНаименованиеЛимЗатраты(Ссылка,СтрокаИтога.Итог);
				КонецЕсли;
				ИтогОС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботы+МонтажныеРаботы,СтрокаФормата);
				ИтогОС.Параметры.Оборудование = Формат(Оборудование,СтрокаФормата);
				ИтогОС.Параметры.Прочие = Формат(Прочие,СтрокаФормата);
				ИтогОс.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтроке,СтрокаФормата);
				СтроительныеРаботыИтоговая = СтроительныеРаботыИтоговая + СтроительныеРаботы;
				МонтажныеРаботыИтоговая = МонтажныеРаботыИтоговая + МонтажныеРаботы;
				ПрочиеИтоговая = ПрочиеИтоговая + Прочие;
				ОборудованиеИтоговая = ОборудованиеИтоговая + Оборудование;
				ВсегоПоСтрокеИтоговая  = СтроительныеРаботыИтоговая + МонтажныеРаботыИтоговая + ОборудованиеИтоговая + ПрочиеИтоговая;
	
				ТабличныйДокумент.Вывести(ИтогОС);
				ПовторИтога = 0;
			ИначеЕсли (ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"))
				Или (ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета")) Тогда
				Если СтрокаИтога.Глава <> ПовторГлава Тогда
					ТекГлава = СтрокаИтога.Глава;
					ВывестиГлавуПеред(ТабличныйДокумент,ТекГлава,ПовторГлава,ГлаваИтогов);
					ПовторГлава = СтрокаИтога.Глава;
				КонецЕсли;
				СтрокаЛС.Параметры.НомерПП =  НайтиНомерПоПорядкуСметы(Ссылка,СтрокаИтога.Итог);
				СтрокаЛС.Параметры.НомерСметыДляПечати =  СтрокаИтога.Итог.НомерСметы;
				СтрокаЛС.Параметры.НаименованиеЛокальнойСметы =  СтрокаИтога.Итог.Наименование;
				СтрокаЛС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботы + МонтажныеРаботы,СтрокаФормата);
				СтрокаЛС.Параметры.Оборудование = 	Формат(Оборудование,СтрокаФормата);
				СтрокаЛС.Параметры.Прочие = Формат(Прочие,СтрокаФормата);
				СтрокаЛС.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтроке,СтрокаФормата);
				ТабличныйДокумент.Вывести(СтрокаЛС);
				СтроительныеРаботыИтоговая = СтроительныеРаботыИтоговая + СтроительныеРаботы;
				МонтажныеРаботыИтоговая = МонтажныеРаботыИтоговая + МонтажныеРаботы;
				ПрочиеИтоговая = ПрочиеИтоговая + Прочие;
				ОборудованиеИтоговая = ОборудованиеИтоговая + Оборудование;
				ВсегоПоСтрокеИтоговая  = СтроительныеРаботыИтоговая + МонтажныеРаботыИтоговая + ОборудованиеИтоговая + ПрочиеИтоговая;
				ПовторИтога = 0;
				СтрокаИтога.Напечатан = Истина;
			Иначе
				Если ПовторИтога <> ВсегоПоСтроке И СтрокаИтога.Итог.Накопительный Тогда
					Если Ссылка.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
						ИтогОС.Параметры.НаименованиеИтогОС = НайтиНаименованиеИтога(СтрокаИтога.Итог);	
					Иначе
						ИтогОС.Параметры.НаименованиеИтогОС = СтрокаИтога.Итог.Наименование;
					КонецЕсли;
					ИтогОС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботы+МонтажныеРаботы,СтрокаФормата);
					ИтогОС.Параметры.Оборудование = Формат(Оборудование,СтрокаФормата);
					ИтогОС.Параметры.Прочие = Формат(Прочие,СтрокаФормата);
					ИтогОс.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтроке,СтрокаФормата);
					ТабличныйДокумент.Вывести(ИтогОС);
					СтрокаИтога.Напечатан = Истина;
					ПовторИтога = ВсегоПоСтроке;
					ВсегоПоСтрокеИтоговая = 0;
					СтроительныеРаботыИтоговая = 0;
					МонтажныеРаботыИтоговая = 0;
					ПрочиеИтоговая = 0;
					ОборудованиеИтоговая = 0;
				Иначе
					СтрокаИтога.Напечатан = Истина;
				КонецЕсли;
			КонецЕсли;	
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Итог",СтрокаИтога.Итог);
			МассивСтрокВидыРабот = ИтогиПоОС.НайтиСтроки(СтруктураОтбора);
			Для каждого ТекСтрока Из МассивСтрокВидыРабот Цикл
				ТекСтрока.Напечатан = Истина;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры	

// Вывод итоговых стоимостей по видам работ для сводной сметы с разбивкой по годам.
Процедура ВывестиИтоговыеСтрокиКЗРазбивкаГодами(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,ИтогОС,СтрокаЛС,СтрокаФормата,ГлаваИтогов,Разбивка)
	ПовторИтога = 0;
	ПовторГлава = "";
	ВсегоПоСтрокеИтоговая = 0;
	СтроительныеРаботыИтоговая = 0;
	МонтажныеРаботыИтоговая = 0;
	ПрочиеИтоговая = 0;
	ОборудованиеИтоговая = 0;
	Если ИтогиПоОС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ТЗГода = Ссылка.РазбивкаПоГодам.Выгрузить();
	ТЗГода.Сортировать("Год Возр");
	ПовторГлаваНеНакопительногоИтога = ИтогиПоОС[0].Глава;
	Для Каждого СтрокаИтога Из ИтогиПоОС Цикл
		Если Ссылка.ПечатьПромежуточныхИтогов Тогда
			ГлаваИтога = СтрокаИтога.Глава;
			Если (ГлаваИтога <> ПовторГлаваНеНакопительногоИтога) Или 
				(ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ИтогиПоГлавам")
				И (СтрокаИтога.Итог.Накопительный)) Тогда
				// Найти ненакопительный итог по главе.
				ВсегоПоСтрокеИтоговая = 0;
				СтроительныеРаботыИтоговая = 0;
				МонтажныеРаботыИтоговая = 0;
				ПрочиеИтоговая = 0;
				ОборудованиеИтоговая = 0;
				ИтогПоГлаве = НайтиИтогПоГлаве(ПовторГлаваНеНакопительногоИтога,Ссылка.ТипСтроительства);
				Если ИтогПоГлаве <> Неопределено Тогда
					Если ИтогПоГлаве.ВыводитьНаПечать И ВсегоПоСтрокеИтоговая <> 0
						И ВсегоПоСтрокеИтоговая <> ПовторИтога Тогда
						// Выдать Итоги по главе.
						Если Ссылка.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
							ИтогОС.Параметры.НаименованиеИтогОС = НайтиНаименованиеИтога(ИтогПоГлаве);	
						Иначе
							ИтогОС.Параметры.НаименованиеИтогОС = ИтогПоГлаве.Наименование;
						КонецЕсли;
						ВсегоПоСтрокеИтоговая  = СтроительныеРаботыИтоговая + МонтажныеРаботыИтоговая + ОборудованиеИтоговая + ПрочиеИтоговая;
						
						ИтогОС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботыИтоговая+МонтажныеРаботыИтоговая,СтрокаФормата);
						ИтогОС.Параметры.Оборудование = Формат(ОборудованиеИтоговая,СтрокаФормата);
						ИтогОС.Параметры.Прочие = Формат(ПрочиеИтоговая,СтрокаФормата);
						ИтогОС.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтрокеИтоговая,СтрокаФормата);
						ТабличныйДокумент.Вывести(ИтогОС);
						ПовторИтога = ВсегоПоСтрокеИтоговая;
						
						ТабличныйДокумент.Вывести(Разбивка);
						Для Каждого СтрГод Из ТЗГода Цикл
							ИтогОС.Параметры.НаименованиеИтогОС = Формат(СтрГод.Год,"ЧГ=0") + " - " + СтрГод.Процент + "%";
							ИтогОС.Параметры.СтроительныеРаботы = Формат((СтроительныеРаботыИтоговая+МонтажныеРаботыИтоговая)*СтрГод.Процент/100,СтрокаФормата);
							ИтогОС.Параметры.Оборудование = Формат(ОборудованиеИтоговая*СтрГод.Процент/100,СтрокаФормата);
							ИтогОС.Параметры.Прочие = Формат(ПрочиеИтоговая*СтрГод.Процент/100,СтрокаФормата);
							ИтогОс.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтрокеИтоговая*СтрГод.Процент/100,СтрокаФормата);
							ТабличныйДокумент.Вывести(ИтогОС);
						КонецЦикла;

					КонецЕсли;
					ВсегоПоСтрокеИтоговая = 0;
					СтроительныеРаботыИтоговая = 0;
					МонтажныеРаботыИтоговая = 0;
					ПрочиеИтоговая = 0;
					ОборудованиеИтоговая = 0;
				КонецЕсли;
				ПовторГлаваНеНакопительногоИтога = ГлаваИтога;
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаИтога.Напечатан = Ложь Тогда
			
			ВсегоПоСтроке = 0;
			ОплатаТрудаПоСтроке = 0;
			СтроительныеРаботы = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы,ПараметрыПечати);
			МонтажныеРаботы = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы,ПараметрыПечати);
			Прочие = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы,ПараметрыПечати);
			Оборудование = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.Оборудование,ПараметрыПечати);
			
			ВсегоПоСтроке  = СтроительныеРаботы + МонтажныеРаботы + Оборудование + Прочие;

			Если ВсегоПоСтроке = 0 Тогда
				СтрокаИтога.Напечатан = Истина;
				Продолжить;
			КонецЕсли;
			Если ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
				Если СтрокаИтога.Глава <> ПовторГлава Тогда
					ТекГлава = СтрокаИтога.Глава;
					ВывестиГлавуПеред(ТабличныйДокумент,ТекГлава,ПовторГлава,ГлаваИтогов);
					ПовторГлава = СтрокаИтога.Глава;
				КонецЕсли;
				ТекНомерСтроки 	= ИтогиПоОС.Индекс(СтрокаИтога);
				НомерИтогаКЧему = СтрокаИтога.Итог.КИтогу.ПорядковыйНомер;
				ПечатьИтоговПередКЗ(Ссылка,ТабличныйДокумент,ИтогиПоОС,ИтогОС,НомерИтогаКЧему,параметрыПечати,ПовторИтога,СтрокаФормата);
				ИтогиПоОС.Получить(ТекНомерСтроки);
				
				Если СтрДлина(СокрЛП(СтрокаИтога.Итог.Обоснование)) <> 0 Тогда
					ИтогОС.Параметры.НаименованиеИтогОС =  СокрЛП(СтрокаИтога.Итог.Обоснование) + "   " + СформироватьНаименованиеЛимЗатраты(Ссылка,СтрокаИтога.Итог);
				Иначе	
					ИтогОС.Параметры.НаименованиеИтогОС =  СформироватьНаименованиеЛимЗатраты(Ссылка,СтрокаИтога.Итог);
				КонецЕсли;
				ИтогОС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботы+МонтажныеРаботы,СтрокаФормата);
				ИтогОС.Параметры.Оборудование = Формат(Оборудование,СтрокаФормата);
				ИтогОС.Параметры.Прочие = Формат(Прочие,СтрокаФормата);
				ИтогОс.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтроке,СтрокаФормата);
				СтроительныеРаботыИтоговая = СтроительныеРаботыИтоговая + СтроительныеРаботы;
				МонтажныеРаботыИтоговая = МонтажныеРаботыИтоговая + МонтажныеРаботы;
				ПрочиеИтоговая = ПрочиеИтоговая + Прочие;
				ОборудованиеИтоговая = ОборудованиеИтоговая + Оборудование;
				ВсегоПоСтрокеИтоговая  = СтроительныеРаботыИтоговая + МонтажныеРаботыИтоговая + ОборудованиеИтоговая + ПрочиеИтоговая;
	
				ТабличныйДокумент.Вывести(ИтогОС);
				ПовторИтога = 0;
			ИначеЕсли (ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"))
				Или (ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета")) Тогда
				Если СтрокаИтога.Глава <> ПовторГлава Тогда
					ТекГлава = СтрокаИтога.Глава;
					ВывестиГлавуПеред(ТабличныйДокумент,ТекГлава,ПовторГлава,ГлаваИтогов);
					ПовторГлава = СтрокаИтога.Глава;
				КонецЕсли;
				СтрокаЛС.Параметры.НомерПП =  НайтиНомерПоПорядкуСметы(Ссылка,СтрокаИтога.Итог);
				СтрокаЛС.Параметры.НомерСметыДляПечати =  СтрокаИтога.Итог.НомерСметы;
				СтрокаЛС.Параметры.НаименованиеЛокальнойСметы =  СтрокаИтога.Итог.Наименование;
				СтрокаЛС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботы + МонтажныеРаботы,СтрокаФормата);
				СтрокаЛС.Параметры.Оборудование = 	Формат(Оборудование,СтрокаФормата);
				СтрокаЛС.Параметры.Прочие = Формат(Прочие,СтрокаФормата);
				СтрокаЛС.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтроке,СтрокаФормата);
				ТабличныйДокумент.Вывести(СтрокаЛС);
				СтроительныеРаботыИтоговая = СтроительныеРаботыИтоговая + СтроительныеРаботы;
				МонтажныеРаботыИтоговая = МонтажныеРаботыИтоговая + МонтажныеРаботы;
				ПрочиеИтоговая = ПрочиеИтоговая + Прочие;
				ОборудованиеИтоговая = ОборудованиеИтоговая + Оборудование;
				ВсегоПоСтрокеИтоговая  = СтроительныеРаботыИтоговая + МонтажныеРаботыИтоговая + ОборудованиеИтоговая + ПрочиеИтоговая;
				ПовторИтога = 0;
				СтрокаИтога.Напечатан = Истина;
			Иначе
				Если ПовторИтога <> ВсегоПоСтроке И СтрокаИтога.Итог.Накопительный Тогда
					Если Ссылка.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
						ИтогОС.Параметры.НаименованиеИтогОС = НайтиНаименованиеИтога(СтрокаИтога.Итог);	
					Иначе
						ИтогОС.Параметры.НаименованиеИтогОС = СтрокаИтога.Итог.Наименование;
					КонецЕсли;
					ИтогОС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботы+МонтажныеРаботы,СтрокаФормата);
					ИтогОС.Параметры.Оборудование = Формат(Оборудование,СтрокаФормата);
					ИтогОС.Параметры.Прочие = Формат(Прочие,СтрокаФормата);
					ИтогОс.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтроке,СтрокаФормата);
					ТабличныйДокумент.Вывести(ИтогОС);
					СтрокаИтога.Напечатан = Истина;
					ПовторИтога = ВсегоПоСтроке;
					ВсегоПоСтрокеИтоговая = 0;
					СтроительныеРаботыИтоговая = 0;
					МонтажныеРаботыИтоговая = 0;
					ПрочиеИтоговая = 0;
					ОборудованиеИтоговая = 0;
					
					ТабличныйДокумент.Вывести(Разбивка);
					Для Каждого СтрГод Из ТЗГода Цикл
						ИтогОС.Параметры.НаименованиеИтогОС = Формат(СтрГод.Год,"ЧГ=0") + " - " + СтрГод.Процент + "%";
						ИтогОС.Параметры.СтроительныеРаботы = Формат((СтроительныеРаботы+МонтажныеРаботы)*СтрГод.Процент/100,СтрокаФормата);
						ИтогОС.Параметры.Оборудование = Формат(Оборудование*СтрГод.Процент/100,СтрокаФормата);
						ИтогОС.Параметры.Прочие = Формат(Прочие*СтрГод.Процент/100,СтрокаФормата);
						ИтогОс.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтроке*СтрГод.Процент/100,СтрокаФормата);
						ТабличныйДокумент.Вывести(ИтогОС);
					КонецЦикла;
					
				Иначе
					СтрокаИтога.Напечатан = Истина;
				КонецЕсли;
			КонецЕсли;	
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Итог",СтрокаИтога.Итог);
			МассивСтрокВидыРабот = ИтогиПоОС.НайтиСтроки(СтруктураОтбора);
			Для каждого ТекСтрока Из МассивСтрокВидыРабот Цикл
				ТекСтрока.Напечатан = Истина;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры	

// Вывод итоговых стоимостей по видам работ для сводной сметы казахстан.
Процедура ВывестиИтоговыеСтрокиКЗСводно(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,ИтогОС,СтрокаФормата)
	
	Если ИтогиПоОС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаИтога Из ИтогиПоОС Цикл
		
		Если СтрокаИтога.Напечатан = Ложь Тогда
			
			ВсегоПоСтроке = 0;
			СтроительныеРаботы = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы,ПараметрыПечати);
			МонтажныеРаботы = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы,ПараметрыПечати);
			Прочие = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы,ПараметрыПечати);
			Оборудование = ОпределитьСтоимостьВидаРабот(ИтогиПоОС,СтрокаИтога.Итог,Перечисления.СМ_ВидыЗатратСмета.Оборудование,ПараметрыПечати);
			
			ВсегоПоСтроке  = СтроительныеРаботы + МонтажныеРаботы + Оборудование + Прочие;
			ИтогОС.Параметры.НаименованиеИтогОС = СтрокаИтога.Итог.Наименование;
			ИтогОС.Параметры.СтроительныеРаботы = Формат(СтроительныеРаботы+МонтажныеРаботы,СтрокаФормата);
			ИтогОС.Параметры.Оборудование = Формат(Оборудование,СтрокаФормата);
			ИтогОС.Параметры.Прочие = Формат(Прочие,СтрокаФормата);
			ИтогОс.Параметры.ВсегоПоСтроке = Формат(ВсегоПоСтроке,СтрокаФормата);
			ТабличныйДокумент.Вывести(ИтогОС);
			СтрокаИтога.Напечатан = Истина;
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Итог",СтрокаИтога.Итог);
			МассивСтрокВидыРабот = ИтогиПоОС.НайтиСтроки(СтруктураОтбора);
			Для каждого ТекСтрока Из МассивСтрокВидыРабот Цикл
				ТекСтрока.Напечатан = Истина;
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры	

