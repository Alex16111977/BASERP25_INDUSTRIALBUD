#Область ПрограммныйИнтерфейс

// Печать ОБЪЕКТНОЙ сметы.
//	Формирование параметров печати и табличного документа.
//
// Параметры:
//     МассивОбъектов 	- Массив - содержит документы СМ_ОбъектнаяСмета к печати.
//     ОбъектыПечати 	- Массив - список объектов печати (для стандартной подсистемы).
//     ИмяМакета 		- Строка - имя макета.
//
// Возвращаемое значение:
//     ТабличныйДокумент - ТабличныйДокумент - содержит печатную форму объектной сметы.
//
Функция ПечатьОС(МассивОбъектов, ОбъектыПечати, ИмяМакета) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ПервыйДокумент = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ОС";
	                  
	Для Каждого Ссылка Из МассивОбъектов Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПараметрыПечати = Новый Структура;
		ПараметрыПечати.Вставить("ФорматОкругления",			Ссылка.ФорматОкругления);
		ПараметрыПечати.Вставить("ПроводитьОкругление",         ССылка.ПроводитьОкругление);
		ПараметрыПечати.Вставить("ВБазисныхЦенах",				Ссылка.БазисныеЦены);
		ПараметрыПечати.Вставить("ЭтоОбС",				   		?(ИмяМакета = "МакетОС",истина,ложь));
		ПараметрыПечати.Вставить("СметаСсылка",			 		Ссылка);
		
		Если ИмяМакета = "ПФ_MXL_СМ_КЗ_МакетОС" Тогда
			ПечатьОбъектнойСметыКЗ(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати);
		Иначе
			ПечатьОбъектнойСметы(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати);
		КонецЕсли;
		
		ПервыйДокумент 		= Ложь;
		НомерСтрокиНачало 	= ТабличныйДокумент.ВысотаТаблицы + 1;
		
	КонецЦикла;	    
	
	Возврат ТабличныйДокумент; 
	
КонецФункции

// Печать СВОДНОЙ сметы.
//	Формирование параметров печати и табличного документа.
//
// Параметры:
//     МассивОбъектов 	- Массив - содержит документы СМ_СводнаяСмета к печати.
//     ОбъектыПечати 	- Массив - список объектов печати (для стандартной подсистемы).
//     ИмяМакета 		- Строка - имя макета.
//
// Возвращаемое значение:
//     ТабличныйДокумент - ТабличныйДокумент - содержит печатную форму сводной сметы.
//
Функция ПечатьСС(МассивОбъектов, ОбъектыПечати, ИмяМакета) Экспорт 
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ПервыйДокумент = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_СС"; 
	
	Для Каждого Ссылка Из МассивОбъектов Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПараметрыПечати = Новый Структура;
		ПараметрыПечати.Вставить("ФорматОкругления",			Ссылка.ФорматОкругления);
		ПараметрыПечати.Вставить("ПроводитьОкругление",         ССылка.ПроводитьОкругление);
		ПараметрыПечати.Вставить("ВБазисныхЦенах",				Ссылка.БазисныеЦены);
		ПараметрыПечати.Вставить("ЭтоСС",				   		?(ИмяМакета = "МакетСС",истина,ложь));
		ПараметрыПечати.Вставить("СметаСсылка",			 		Ссылка);
		
		Если ИмяМакета = "ПФ_MXL_СМ_КЗ_МакетСС" Тогда
			ПечатьСводнойСметыКЗ(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати);
		ИначеЕсли ИмяМакета = "ПФ_MXL_СМ_КЗ_МакетСС_Сводный" Тогда
			ПечатьСводнойСметыКЗ_Сводно(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати);
		Иначе
			ПечатьСводнойСметы(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати);
		КонецЕсли;
		
		ПервыйДокумент 		= Ложь;
		НомерСтрокиНачало 	= ТабличныйДокумент.ВысотаТаблицы + 1;
		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент; 
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции                                                  

// Формирование и вывод областей табличного документа.
Процедура ПечатьОбъектнойСметы(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати)
	
	КолЗнаков = 2;
	Если Ссылка.ПроводитьОкругление = истина Тогда   
		КолЗнаков = Ссылка.ФорматОкругления;		
	КонецЕсли;
	Если КолЗнаков = 1 Тогда
		СтрокаФормата = "ЧДЦ=1";
	ИначеЕсли КолЗнаков = 2 Тогда
		СтрокаФормата = "ЧДЦ=2";
	ИначеЕсли КолЗнаков = 3 Тогда
		СтрокаФормата = "ЧДЦ=3";
	Иначе
		СтрокаФормата = "ЧДЦ=0";
	КонецЕсли;
	// Заполняем макет.
	Макет 					= Документы.СМ_ОбъектнаяСмета.ПолучитьМакет(имяМакета);
	Шапка					= Макет.ПолучитьОбласть("Шапка");
	Утвержд1				= Макет.ПолучитьОбласть("Утвержд1");
	Утвержд2				= Макет.ПолучитьОбласть("Утвержд2");
	Утвержд3				= Макет.ПолучитьОбласть("Утвержд3");
	Колонка1               	= Макет.ПолучитьОбласть("Колонка1");
	ШапкаЛС					= Макет.ПолучитьОбласть("ШапкаЛС");
	НетДанных				= Макет.ПолучитьОбласть("НетДанных");
	ИтогОС					= Макет.ПолучитьОбласть("ИтогОС");
	СтрокаЛС				= Макет.ПолучитьОбласть("СтрокаЛСПечати");
	Подписи					= Макет.ПолучитьОбласть("Подписи");
	КолонкиПовтора			= Макет.ПолучитьОбласть("ШапкаЛС|КолонкиПовтора");
	ШапкаЛС.Области.Колонка1.Текст = НСтр("ru='№ п/п'");
	Шапка.Параметры.НомерОС					= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ОбъектнаяСмета № %1'"), СокрЛП(Ссылка.НомерСметы));
	Шапка.Параметры.НаименованиеОС			= сокрЛП(Ссылка.наименование);
	Если Ссылка.ЛокальныеСметы.Количество() = 0 Тогда
		ТабличныйДокумент.Вывести(НетДанных);
		Возврат;
	КонецЕсли;	
	// Всего с НДС.
	ИтогиПоОС = СобратьДанныеПоСмете(Ссылка,ПараметрыПечати);
	СФормироватьИтоговыеСтоимостиШапки(ИтогиПоОС,Шапка,ПараметрыПечати,СтрокаФормата);
	Шапка.Параметры.Утвержд1 = "";
	Шапка.Параметры.Утвержд2 = "";
	Шапка.Параметры.Утвержд3 = "";
	Для каждого ТекПодписи Из Ссылка.Подписи Цикл
		Если ТекПодписи.ВыводитьВШапку = Истина Тогда
			
			Шапка.Параметры.Утвержд1 = Шапка.Параметры.ВсегоПоСмете;
			Шапка.Параметры.Утвержд2 = НСтр("ru='УТВЕРЖДЕНА:'");
			Шапка.Параметры.Утвержд3 = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ЗАКАЗЧИК: %1'"), СокрЛП(Ссылка.Заказчик.Наименование));
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	// *********************************************************************
	// ++ AVV Вывод валюты в шапку таблицы
	ШапкаЛС.Параметры.Заполнить(СМ_СметаПечатьСервер.ПолучитьСтруктуруОбозначенияВалюты(Ссылка));
	// -- AVV 
	// *********************************************************************

	ТабличныйДокумент.Вывести(Шапка);
	ТабличныйДокумент.Вывести(ШапкаЛС);
	ВывестиИтоговыеСтрокиОбъектнойСметы(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,ИтогОС,СтрокаЛС,СтрокаФормата);
	ВывестиВозвратыОС(Ссылка,ПараметрыПечати,ТабличныйДокумент,ИтогОС,СтрокаФормата);
	ВывестиПодписи(ТабличныйДокумент,Ссылка,Подписи);
	ТабличныйДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	ТабличныйДокумент.ПовторятьПриПечатиСтроки = ТабличныйДокумент.Области.КолонкиПовтора;

КонецПроцедуры	

// Формирование и вывод областей табличного документа.
Процедура ПечатьОбъектнойСметыКЗ(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати)
	
	КолЗнаков = 2;
	Если Ссылка.ПроводитьОкругление = истина Тогда   
		КолЗнаков = Ссылка.ФорматОкругления;		
	КонецЕсли;
	Если КолЗнаков = 1 Тогда
		СтрокаФормата = "ЧДЦ=1";
	ИначеЕсли КолЗнаков = 2 Тогда
		СтрокаФормата = "ЧДЦ=2";
	ИначеЕсли КолЗнаков = 3 Тогда
		СтрокаФормата = "ЧДЦ=3";
	Иначе
		СтрокаФормата = "ЧДЦ=0";
	КонецЕсли;
	// Заполняем макет.
	Макет 					= Документы.СМ_ОбъектнаяСмета.ПолучитьМакет(имяМакета);
	Шапка					= Макет.ПолучитьОбласть("Шапка");
	ШапкаЛС					= Макет.ПолучитьОбласть("ШапкаЛС");
	НетДанных				= Макет.ПолучитьОбласть("НетДанных");
	ИтогОС					= Макет.ПолучитьОбласть("ИтогОС");
	СтрокаЛС				= Макет.ПолучитьОбласть("СтрокаЛС");
	Подписи					= Макет.ПолучитьОбласть("Подписи");
	КолонкиПовтора			= Макет.ПолучитьОбласть("ШапкаЛС|КолонкиПовтора");
	Шапка.Параметры.НомерОС					= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ОбъектнаяСмета № %1'"), СокрЛП(Ссылка.НомерСметы));
	Шапка.Параметры.НаименованиеОС			= сокрЛП(Ссылка.наименование);
	Если Ссылка.ЛокальныеСметы.Количество() = 0 Тогда
		ТабличныйДокумент.Вывести(НетДанных);
		Возврат;
	КонецЕсли;	
	// Всего с НДС.
	ИтогиПоОС = СобратьДанныеПоСмете(Ссылка,ПараметрыПечати);
	СФормироватьИтоговыеСтоимостиШапкиКЗ(ИтогиПоОС,Шапка,ПараметрыПечати,СтрокаФормата);
	
	// *********************************************************************
	// ++ AVV Вывод валюты в шапку таблицы
	ШапкаЛС.Параметры.Заполнить(СМ_СметаПечатьСервер.ПолучитьСтруктуруОбозначенияВалюты(Ссылка));
	// -- AVV 
	// *********************************************************************

	ТабличныйДокумент.Вывести(Шапка);
	ТабличныйДокумент.Вывести(ШапкаЛС);
	ВывестиИтоговыеСтрокиОбъектнойСметыКЗ(Ссылка,ИтогиПоОС,ПараметрыПечати,ТабличныйДокумент,ИтогОС,СтрокаЛС,СтрокаФормата);
	ВывестиПодписи(ТабличныйДокумент,Ссылка,Подписи);
	ТабличныйДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	ТабличныйДокумент.ПовторятьПриПечатиСтроки = ТабличныйДокумент.Области.КолонкиПовтора;

КонецПроцедуры	

// Определение итоговых стоимостей для шапки объектной сметы.
Процедура СФормироватьИтоговыеСтоимостиШапки(ИтогиПоОС, Шапка, ПараметрыПечати,СтрокаФормата)
	КолЗнаков = 2;
	Если ПараметрыПечати.ПроводитьОкругление = истина Тогда
		КолЗнаков = ПараметрыПечати.ФорматОкругления;		
	КонецЕсли;
	ИтогДляШапкиОС = Справочники.СМ_ИтогиПоГлавам.НайтиПоКоду("22");
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Итог",ИтогДляШапкиОС);
	МассивСтрокИтогов = ИтогиПоОС.НайтиСтроки(СтруктураОтбора);
	ВсегоПоСмете = 0;
	ОплатаТрудаПоСмете = 0;
	Если МассивСтрокИтогов.Количество() <> 0 Тогда	
		Для Каждого СтрокаИтога Из МассивСтрокИтогов Цикл
			Если ПараметрыПечати.ВБазисныхЦенах = истина Тогда
				ПЗ 	= ?(ЗначениеЗаполнено(СтрокаИтога.ПрямЗатраты),Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков),0);
				ОЗ 	= ?(ЗначениеЗаполнено(СтрокаИтога.ОснЗарплата),СтрокаИтога.ОснЗарплата,0);
				ЗМ 	= ?(ЗначениеЗаполнено(СтрокаИтога.ЗарплМашин),СтрокаИтога.ЗарплМашин,0);

				ВсегоПоСмете = ВсегоПоСмете + ПЗ;
				ОплатаТрудаПоСмете = ОплатаТрудаПоСмете + Окр((ЗМ + ОЗ) ,КолЗнаков);
			Иначе
				ПЗ 	= ?(ЗначениеЗаполнено(СтрокаИтога.ТекПрямЗатраты),Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков),0);
				ОЗ 	= ?(ЗначениеЗаполнено(СтрокаИтога.ТекОснЗарплата),СтрокаИтога.ТекОснЗарплата,0);
				ЗМ 	= ?(ЗначениеЗаполнено(СтрокаИтога.ТекЗарплМашин),СтрокаИтога.ТекЗарплМашин,0);
				ВсегоПоСмете = ВсегоПоСмете + ПЗ;
				ОплатаТрудаПоСмете = ОплатаТрудаПоСмете + Окр((ОЗ + ЗМ) ,КолЗнаков);
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
	// *********************************************************************
	// ++ AVV Вывод валюты в шапку таблицы
	СтруктураВалюты = СМ_СметаПечатьСервер.ПолучитьСтруктуруОбозначенияВалюты(ПараметрыПечати.СметаСсылка);
	ПечВалюта 		= СтруктураВалюты.ПечВалюта;
	// -- AVV 
	// *********************************************************************

	Шапка.Параметры.ВсегоПоСмете = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Сметная стоимость  %1 тыс. %2'"), Формат(ВсегоПоСмете,СтрокаФормата),ПечВалюта);
	Шапка.Параметры.ОплатаТрудаПоСмете = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Средства на оплату труда  %1 тыс. %2'"), Формат(ОплатаТрудаПоСмете,СтрокаФормата),ПечВалюта);
	ДатаОбс = ПараметрыПечати.СметаСсылка.СоставленаВЦенахНа;
	Если ПараметрыПечати.ВБазисныхЦенах = истина Тогда
		ДатаЦенСметы = НСтр("ru='Составлен(а)  в базисных ценах на 01.01.2000 г.'");
	Иначе
		ДатаЦенСметы = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Составлен(а)  в ценах по состоянию на %1'"), Формат(ДатаОбс,"ДЛФ=D")); 
	КонецЕсли;
	Шапка.Параметры.ДатаЦенСметы = ДатаЦенСметы;
	Заказчик = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Заказчик: %1'"), ?(ПараметрыПечати.СметаСсылка.Заказчик = Неопределено,"",ПараметрыПечати.СметаСсылка.Заказчик));
	Подрядчик = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Подрядчик: %1'"), ?(ПараметрыПечати.СметаСсылка.Подрядчик = Неопределено,"",ПараметрыПечати.СметаСсылка.Подрядчик));
	Договор = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Договор: %1'"), ?(ПараметрыПечати.СметаСсылка.Договор = Неопределено,"",ПараметрыПечати.СметаСсылка.Договор));
	Шапка.Параметры.Заказчик = Заказчик;
	Шапка.Параметры.Подрядчик = Подрядчик;
	Шапка.Параметры.Договор = Договор;
	
КонецПроцедуры

// Определение итоговых стоимостей для шапки объектной сметы.
Процедура СФормироватьИтоговыеСтоимостиШапкиКЗ(ИтогиПоОС, Шапка, ПараметрыПечати,СтрокаФормата)
	КолЗнаков = 2;
	Если ПараметрыПечати.ПроводитьОкругление = истина Тогда
		КолЗнаков = ПараметрыПечати.ФорматОкругления;		
	КонецЕсли;
	ИтогДляШапкиОС = Справочники.СМ_ИтогиПоГлавам.НайтиПоКоду("22");
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Итог",ИтогДляШапкиОС);
	МассивСтрокИтогов = ИтогиПоОС.НайтиСтроки(СтруктураОтбора);
	ВсегоПоСмете = 0;
	ОплатаТрудаПоСмете = 0;
	НормТрудоемкость = 0;
	Если МассивСтрокИтогов.Количество() <> 0 Тогда	
		Для Каждого СтрокаИтога Из МассивСтрокИтогов Цикл
			Если ПараметрыПечати.ВБазисныхЦенах = истина Тогда
				ПЗ 	= ?(ЗначениеЗаполнено(СтрокаИтога.ПрямЗатраты),Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков),0);
				ОЗ 	= ?(ЗначениеЗаполнено(СтрокаИтога.ОснЗарплата),СтрокаИтога.ОснЗарплата,0);
				ЗМ 	= ?(ЗначениеЗаполнено(СтрокаИтога.ЗарплМашин),СтрокаИтога.ЗарплМашин,0);

				ВсегоПоСмете = ВсегоПоСмете + ПЗ;
				ОплатаТрудаПоСмете = ОплатаТрудаПоСмете + Окр((ЗМ + ОЗ) ,КолЗнаков);
			Иначе
				ПЗ 	= ?(ЗначениеЗаполнено(СтрокаИтога.ТекПрямЗатраты),Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков),0);
				ОЗ 	= ?(ЗначениеЗаполнено(СтрокаИтога.ТекОснЗарплата),СтрокаИтога.ТекОснЗарплата,0);
				ЗМ 	= ?(ЗначениеЗаполнено(СтрокаИтога.ТекЗарплМашин),СтрокаИтога.ТекЗарплМашин,0);
				ВсегоПоСмете = ВсегоПоСмете + ПЗ;
				ОплатаТрудаПоСмете = ОплатаТрудаПоСмете + Окр((ОЗ + ЗМ) ,КолЗнаков);
			КонецЕсли;
			НормТрудоемкость = НормТрудоемкость + Окр(?(ЗначениеЗаполнено(СтрокаИтога.ЗатратыТрудаРабочих),СтрокаИтога.ЗатратыТрудаРабочих,0) + ?(ЗначениеЗаполнено(СтрокаИтога.ЗатратыТрудаМашин),СтрокаИтога.ЗатратыТрудаМашин,0),КолЗнаков);
		КонецЦикла;	
	КонецЕсли;
	// *********************************************************************
	// ++ AVV Вывод валюты в шапку таблицы
	СтруктураВалюты = СМ_СметаПечатьСервер.ПолучитьСтруктуруОбозначенияВалюты(ПараметрыПечати.СметаСсылка);
	ПечВалюта 		= СтруктураВалюты.ПечВалюта;
	// -- AVV 
	// *********************************************************************

	Шапка.Параметры.ВсегоПоСмете = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Сметная стоимость  %1 тыс. %2'"), Формат(ВсегоПоСмете,СтрокаФормата),ПечВалюта);
	Шапка.Параметры.НормТрудоемкость = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Норм. трудоемкость  %1 тыс. %2'"), Формат(НормТрудоемкость,СтрокаФормата),ПечВалюта);
	Шапка.Параметры.ОплатаТрудаПоСмете = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Сметная зар. плата  %1 тыс. %2'"), Формат(ОплатаТрудаПоСмете,СтрокаФормата),ПечВалюта);
	
	ДатаОбс = ПараметрыПечати.СметаСсылка.СоставленаВЦенахНа;
	Шапка.Параметры.Квартал = Формат(КонецКвартала(ДатаОбс),"ДФ=" "к");
	Шапка.Параметры.Год = Год(ДатаОбс);
	Шапка.Параметры.Стройка = ПараметрыПечати.СметаСсылка.Стройка;
	
КонецПроцедуры

// Определение стоимостей по виду работ для итога Функция общая для объектной и сводной сметы.
Функция ОпределитьСтоимостьВидаРабот(ИтогиПоОС,Итог,ВидРабот,ПараметрыПечати)
	Если ПараметрыПечати.ПроводитьОкругление = истина Тогда
		КолЗнаков = ПараметрыПечати.ФорматОкругления;
	Иначе
		КолЗнаков = 2;
	КонецЕсли;
	Результат = 0;
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Итог",Итог);
	СтруктураОтбора.Вставить("ВидРабот",ВидРабот);
	МассивСтрокВидыРабот = ИтогиПоОС.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрокВидыРабот.Количество() > 0 Тогда
		ПрямЗатраты = ?(МассивСтрокВидыРабот[0].ПрямЗатраты = Неопределено,0, МассивСтрокВидыРабот[0].ПрямЗатраты);
		ТекПрямЗатраты = ?(МассивСтрокВидыРабот[0].ТекПрямЗатраты = Неопределено,0, МассивСтрокВидыРабот[0].ТекПрямЗатраты);
		Если ПараметрыПечати.ВБазисныхЦенах = истина Тогда
			Результат = Окр(ПрямЗатраты,КолЗнаков);
		Иначе
			Результат = Окр(ТекПрямЗатраты,КолЗнаков);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Определение оплаты труда для объектной сметы для итога вида работ.
Функция ОпределитьЗарплату(ИтогиПоОС,Итог,ВидРабот,ПараметрыПечати)
	КолЗнаков = 2;
	Если ПараметрыПечати.ПроводитьОкругление = истина Тогда
		КолЗнаков = ПараметрыПечати.ФорматОкругления;		
	КонецЕсли;
	Результат = 0;
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Итог",Итог);
	СтруктураОтбора.Вставить("ВидРабот",ВидРабот);
	МассивСтрокВидыРабот = ИтогиПоОС.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрокВидыРабот.Количество() > 0 Тогда
		ОснЗарплата = ?(МассивСтрокВидыРабот[0].ОснЗарплата = Неопределено,0, МассивСтрокВидыРабот[0].ОснЗарплата);
		ТекОснЗарплата = ?(МассивСтрокВидыРабот[0].ТекОснЗарплата = Неопределено,0, МассивСтрокВидыРабот[0].ТекОснЗарплата);
		ЗарплМашин = ?(МассивСтрокВидыРабот[0].ЗарплМашин = Неопределено,0, МассивСтрокВидыРабот[0].ЗарплМашин);
		ТекЗарплМашин = ?(МассивСтрокВидыРабот[0].ТекЗарплМашин = Неопределено,0, МассивСтрокВидыРабот[0].ТекЗарплМашин);
		
		Если ПараметрыПечати.ВБазисныхЦенах = истина Тогда
			Результат = Окр(МассивСтрокВидыРабот[0].ОснЗарплата + МассивСтрокВидыРабот[0].ЗарплМашин,КолЗнаков);
		Иначе
			Результат = Окр(МассивСтрокВидыРабот[0].ТекОснЗарплата + МассивСтрокВидыРабот[0].ТекЗарплМашин,КолЗнаков);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Функция выбора данных из регистров СМ_ИтогиПоГлавамОС и СМ_ИтогиПоГлавамСС.
Функция СобратьДанныеПоСмете(Ссылка,ПараметрыПечати)
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		ТекРегистр = "СМ_ИтогиПоГлавамОС";
	Иначе
		ТекРегистр = "СМ_ИтогиПоГлавамСС";
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ИтогиПоГлавам.Итог КАК Итог,
	|	ИтогиПоГлавам.ВидРабот КАК ВидРабот,
	|	ИтогиПоГлавам.Глава КАК Глава,
	|	СУММА(ИтогиПоГлавам.ТекПрямЗатраты)/1000 КАК ТекПрямЗатраты,
	|	СУММА(ИтогиПоГлавам.ТекОснЗарплата)/1000 КАК ТекОснЗарплата,
	|	СУММА(ИтогиПоГлавам.ТекЭксплМашин)/1000 КАК ТекЭксплМашин,
	|	СУММА(ИтогиПоГлавам.ТекЗарплМашин)/1000 КАК ТекЗарплМашин,
	|	СУММА(ИтогиПоГлавам.ТекСтоимМатер)/1000 КАК ТекСтоимМатер,
	|	СУММА(ИтогиПоГлавам.ТекОборуд)/1000 КАК ТекОборуд,
	|	СУММА(ИтогиПоГлавам.ТекВозвратМатер)/1000 КАК ТекВозвратМатер,
	|	СУММА(ИтогиПоГлавам.Оборуд)/1000 КАК Оборуд,
	|	СУММА(ИтогиПоГлавам.ОснЗарплата)/1000 КАК ОснЗарплата,
	|	СУММА(ИтогиПоГлавам.ЭксплМашин)/1000 КАК ЭксплМашин,
	|	СУММА(ИтогиПоГлавам.ЗарплМашин)/1000 КАК ЗарплМашин,
	|	СУММА(ИтогиПоГлавам.СтоимМатер)/1000 КАК СтоимМатер,
	|	СУММА(ИтогиПоГлавам.ВозвратМатер)/1000 КАК ВозвратМатер,
	|	СУММА(ИтогиПоГлавам.ПрямЗатраты)/1000 КАК ПрямЗатраты,
	|	СУММА(ИтогиПоГлавам.ЗатратыТрудаМашин)/1000 КАК ЗатратыТрудаМашин,
	|	СУММА(ИтогиПоГлавам.ЗатратыТрудаРабочих)/1000 КАК ЗатратыТрудаРабочих
	|ИЗ
	|	РегистрСведений." + ТекРегистр + " КАК ИтогиПоГлавам
	|ГДЕ
	|	ИтогиПоГлавам.Смета = &Смета
	|
	|СГРУППИРОВАТЬ ПО
	|	ИтогиПоГлавам.Глава,
	|	ИтогиПоГлавам.Итог,
	|	ИтогиПоГлавам.ВидРабот
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИтогиПоГлавам.Итог.ГлаваССРС.ПорядковыйНомер";
	
	Запрос.УстановитьПараметр("Смета",Ссылка);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	РезультатЗапроса.Свернуть("Глава,Итог,ВидРабот","ЗатратыТрудаРабочих,ЗатратыТрудаМашин,ПрямЗатраты,ОснЗарплата,ЭксплМашин,ЗарплМашин,СтоимМатер,Оборуд, ТекПрямЗатраты,ТекОснЗарплата,ТекЭксплМашин,ТекЗарплМашин,ТекСтоимМатер,ТекОборуд");
	РезультатЗапроса.Колонки.Добавить("СортировкаИтогов",Новый  ОписаниеТипов("Число"));
	РезультатЗапроса.Колонки.Добавить("Напечатан",Новый  ОписаниеТипов("Булево"));
	Для Каждого СтрокаИтога Из РезультатЗапроса Цикл
		Если ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
			СтрокаИтога.СортировкаИтогов = СтрокаИтога.Глава.ПорядковыйНомер * 10000 + 2000 + СтрокаИтога.Итог.НомерПоПорядку;
		ИначеЕсли (ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета")) Или (ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета")) Тогда
			СтрокаИтога.СортировкаИтогов = СтрокаИтога.Глава.ПорядковыйНомер * 10000 + 1000 + НайтиНомерПоПорядкуСметы(Ссылка,СтрокаИтога.Итог);
		Иначе
			СтрокаИтога.СортировкаИтогов = СтрокаИтога.Глава.ПорядковыйНомер * 10000 + 3000 + СтрокаИтога.Итог.ПорядковыйНомер;
		КонецЕсли;	
		СтрокаИтога.Напечатан = Ложь;
	КонецЦикла;	
	РезультатЗапроса.Сортировать("СортировкаИтогов");
	Возврат РезультатЗапроса;
	
КонецФункции

// Функция выбора данных из регистров СМ_ИтогиПоГлавамОС и СМ_ИтогиПоГлавамСС с разбивкой по годам.
