		ИначеЕсли (ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"))
			Или (ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета"))Тогда
			СтрокаИтога.СортировкаИтогов = СтрокаИтога.Глава.ПорядковыйНомер * 10000 + 1000 + НайтиНомерПоПорядкуСметы(Ссылка,СтрокаИтога.Итог);
		Иначе
			СтрокаИтога.СортировкаИтогов = СтрокаИтога.Глава.ПорядковыйНомер * 10000 + 3000 + СтрокаИтога.Итог.ПорядковыйНомер;
		КонецЕсли;	
		СтрокаИтога.Напечатан = Ложь;
	КонецЦикла;	
	РезультатЗапроса.Сортировать("СортировкаИтогов");
	Возврат РезультатЗапроса;
	
КонецФункции

