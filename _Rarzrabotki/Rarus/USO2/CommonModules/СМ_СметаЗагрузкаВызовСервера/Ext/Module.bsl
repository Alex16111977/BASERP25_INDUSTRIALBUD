// Заполняет реквизит ОКЕИ в справочника единиц измерений.
//
// Параметры:
//     Нет. 
//
Процедура ОбработатьСтрокуДереваКлассификатора(СтрокаДерева, ТаблицаЕИ)
	
	Отбор = Новый Структура();
	
	Если ЗначениеЗаполнено(СтрокаДерева.Наименование) Тогда
		
		Отбор.Вставить("Наименование", ВРег(СтрокаДерева.Наименование));
		Массив = ТаблицаЕИ.НайтиСтроки(Отбор);
		
		Для Каждого ЕИ Из Массив Цикл
			Об = ЕИ.Ссылка.ПолучитьОбъект();
			Об.ОбменДанными.Загрузка = Истина;
			Об.КодОКЕИ = СтрокаДерева.КодЧисловой;
			Об.Записать();
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДерева.КодовоеБуквенноеОбозначениеНациональное) Тогда
		
		Отбор = Новый Структура();
		Отбор.Вставить("Наименование", ВРег(СтрокаДерева.КодовоеБуквенноеОбозначениеНациональное));
		Массив = ТаблицаЕИ.НайтиСтроки(Отбор);
		
		Для Каждого ЕИ Из Массив Цикл
			Об = ЕИ.Ссылка.ПолучитьОбъект();
			Об.ОбменДанными.Загрузка = Истина;
			Об.КодОКЕИ = СтрокаДерева.КодЧисловой;
			Об.Записать();
		КонецЦикла;
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДерева.КодовоеБуквенноеОбозначениеМеждународное) Тогда
		         
		Отбор = Новый Структура();
		Отбор.Вставить("Наименование", ВРег(СтрокаДерева.КодовоеБуквенноеОбозначениеМеждународное));
		Массив = ТаблицаЕИ.НайтиСтроки(Отбор);
		
		Для Каждого ЕИ Из Массив Цикл
			Об = ЕИ.Ссылка.ПолучитьОбъект();
			Об.ОбменДанными.Загрузка = Истина;
			Об.КодОКЕИ = СтрокаДерева.КодЧисловой;
			Об.Записать();
		КонецЦикла;
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДерева.УсловноеОбозначениеНациональное) Тогда
		               
		Отбор = Новый Структура();
		Отбор.Вставить("Наименование", ВРег(СтрокаДерева.УсловноеОбозначениеНациональное));
		Массив = ТаблицаЕИ.НайтиСтроки(Отбор);
		
		Для Каждого ЕИ Из Массив Цикл
			Об = ЕИ.Ссылка.ПолучитьОбъект();
			Об.ОбменДанными.Загрузка = Истина;
			Об.КодОКЕИ = СтрокаДерева.КодЧисловой;
			Об.Записать();
		КонецЦикла;
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДерева.УсловноеОбозначениеМеждународное) Тогда
		
		Отбор = Новый Структура();
		Отбор.Вставить("Наименование", ВРег(СтрокаДерева.УсловноеОбозначениеМеждународное));
		Массив = ТаблицаЕИ.НайтиСтроки(Отбор);
		
		Для Каждого ЕИ Из Массив Цикл
			Об = ЕИ.Ссылка.ПолучитьОбъект();
			Об.ОбменДанными.Загрузка = Истина;
			Об.КодОКЕИ = СтрокаДерева.КодЧисловой;
			Об.Записать();
		КонецЦикла;
		
	КонецЕсли;          
	
	Для Каждого СтрокаДереваВ Из СтрокаДерева.Строки Цикл
		
		ОбработатьСтрокуДереваКлассификатора(СтрокаДереваВ, ТаблицаЕИ);
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет данные ОКЕИ во все записи справочника единиц измерений.
//
Процедура ЗаполнитьДанныеОКЕИ() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ЕдиницыИзмеренияСмета.Наименование,
	               |	СМ_ЕдиницыИзмеренияСмета.Ссылка,
	               |	СМ_ЕдиницыИзмеренияСмета.КодОКЕИ
	               |ИЗ
	               |	Справочник.СМ_ЕдиницыИзмеренияСмета КАК СМ_ЕдиницыИзмеренияСмета";
	
	ТаблицаЕИ = Запрос.Выполнить().Выгрузить();	
	
	Для Каждого СтрЕИ ИЗ ТаблицаЕИ Цикл
		СтрЕИ.Наименование = ВРег(СтрЕИ.Наименование);
	КонецЦикла;
	
	Дерево = Справочники.СМ_ЕдиницыИзмеренияСмета.ПолучитьДанныеКлассификатора();
	
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		
		ОбработатьСтрокуДереваКлассификатора(СтрокаДерева, ТаблицаЕИ);
		
	КонецЦикла;
			
КонецПроцедуры

#КонецОбласти

#Область ТекущиеЦены

// Готовит информацию о ресурсов для выборки текущих цен в разрезе СписокШифров, Район,
// Нормативная база, сборник.
// ВАЖНО: Позиции уже должны быть в базе!
//
// Параметры:
//     МассивПозиций 				- Массив - содержит ссылки на позиции.
//     СтруктураПараметровРасчетаЛС - Структура - содержит данные о смете (полученнае методом
//                                    ПолучитьСтруктуруПараметровРасчетаЛС()).
//     СтруктураНовыхДанных 		- Структура - для обновления текущих цен по другой базе с полями:
//										* КодРайона	- Строка - код района текущих цен.
//										* СборникТекущихЦен	- Строка - Ид другого сборника.
//										* КодРегиональнойБазы - Строка - код базы для обновления текущих цен.
//     АктВыполненныхРабот - ДокументСсылка.СМ_АктВыполненныхРабот - ссылка на акт, если идет обновление по акту.
//
// Возвращаемое значение:
//     Массив - Массив - содержит структуры с полями:
//			* ШифрыРасценки			- Строка - Шифры расценок через запятую в рамках остальных группировок.
//			* КодРайона             - Строка - Код района для обращения в ВНБ.
//			* КодРегиональнойБазы   - Строка - Код СНБ для обращения в ВНБ.
//			* СборникТекущихЦен  	- Строка - Имя базы сборника текущих цен.
//	
Функция ПолучитьТаблицуРесурсовДляТекущихЦен(МассивПозиций, СтруктураПараметровРасчетаЛС = Неопределено, СтруктураНовыхДанных = Неопределено, АктВыполненныхРабот = Неопределено) Экспорт
	
	Массив = Новый Массив;
	
	Если СтруктураНовыхДанных = Неопределено Тогда
		СтруктураНовыхДанных = Новый Структура();
	КонецЕсли;
	
	Если МассивПозиций.Количество() = 0 Тогда
		Структура = Новый Структура("ШифрыРасценки, КодРайона, КодРегиональнойБазы, СборникТекущихЦен");
		Массив.Добавить(Структура);
		Возврат Массив;
	КонецЕсли;
	
	Если (СтруктураПараметровРасчетаЛС = Неопределено) Тогда
		СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(,МассивПозиций[0]);
	КонецЕсли;
	
	Список = Новый СписокЗначений();
	Список.ЗагрузитьЗначения(МассивПозиций);
	Если АктВыполненныхРабот = Неопределено Тогда
		ТаблицаСведенийРес = СМ_СметаРасчетСервер.ПолучитьТаблицуСтоимостиРесурсовСметы(Список, Истина, Истина, Истина);
	Иначе
		ТаблицаСведенийРес = СМ_СметаРасчетСервер.ПолучитьТаблицуСтоимостиРесурсовАкта(АктВыполненныхРабот, Истина, Список, Истина, Истина);
	КонецЕсли;
	ТаблицаСведенийРес.Свернуть("КодРесурса, Позиция");
	
	ТаблицаСведений = Новый ТаблицаЗначений();
	ТаблицаСведений.Колонки.Добавить("ШифрыРасценки");
	ТаблицаСведений.Колонки.Добавить("КодРайона");
	ТаблицаСведений.Колонки.Добавить("КодРегиональнойБазы");
	ТаблицаСведений.Колонки.Добавить("СборникТекущихЦен");
	
	Для Каждого Позиция Из МассивПозиций Цикл
		
		КодРегиональнойБазы = "";
		Если Не СтруктураНовыхДанных.Свойство("КодРегиональнойБазы", КодРегиональнойБазы) Тогда
			КодРегиональнойБазы = Позиция.РегиональнаяБаза.Код;
		КонецЕсли;
		Если КодРегиональнойБазы = "" Тогда
			КодРегиональнойБазы = Справочники.СМ_СметноНормативныеБазы.ПолучитьПоУмолчанию().Код;
		КонецЕсли;
		КодРайона = "";
		Если Не СтруктураНовыхДанных.Свойство("КодРайона", КодРайона) Тогда
			КодРайона = СтруктураПараметровРасчетаЛС.КодРайона;
		КонецЕсли;
		СборникТекущихЦен = "";
		Если Не СтруктураНовыхДанных.Свойство("СборникТекущихЦен", СборникТекущихЦен) Тогда
			СборникТекущихЦен = СтруктураПараметровРасчетаЛС.ФайлСборникаТекущихЦен;
		КонецЕсли;
		
		Отбор = Новый Структура("КодРайона, СборникТекущихЦен, КодРегиональнойБазы", КодРайона, СборникТекущихЦен, КодРегиональнойБазы);
		
		ОтборТаб = Новый Структура();
		ОтборТаб.Вставить("Позиция",Позиция);
		
		МассивРесурсовПозиции = ТаблицаСведенийРес.НайтиСтроки(ОтборТаб);
		
		Если МассивРесурсовПозиции.Количество() > 0 Тогда
			
			Для Каждого СтрРесПозиция Из МассивРесурсовПозиции Цикл 
		
				ШифрыРасценки = СтрРесПозиция.КодРесурса;
		
				МассивСтрокТаблицы = ТаблицаСведений.НайтиСтроки(Отбор);
		
				Если МассивСтрокТаблицы.Количество() = 0 Тогда
					Стр = ТаблицаСведений.Добавить();
					Стр.ШифрыРасценки = ШифрыРасценки;
				Иначе
					Стр = МассивСтрокТаблицы[0];
					Стр.ШифрыРасценки = Стр.ШифрыРасценки + ";" + ШифрыРасценки;
				КонецЕсли;	
				
				ЗаполнитьЗначенияСвойств(Стр, Отбор);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрПозиция Из ТаблицаСведений Цикл
	
		Структура = Новый Структура("ШифрыРасценки, КодРайона, КодРегиональнойБазы, СборникТекущихЦен");
		ЗаполнитьЗначенияСвойств(Структура, СтрПозиция);
		Массив.Добавить(Структура);     		
		
	КонецЦикла;
	
	Возврат Массив;
		
КонецФункции

// Готовит информацию о ресурсов для выборки текущих цен в разрезе СписокШифров, Район,
// Нормативная база, сборник.
// ВАЖНО: Позиции уже должны быть в базе!
//
// Параметры:
//     Объект 				- ОбъектСсылка - ссылка на объект с ресурсами.
//     СтруктураПараметров  - Структура - содержит данные о смете (полученная методом
//							  ПолучитьСтруктуруПараметровРасчетаЛС()).
//     Смета 				- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету, если идет обновление по акту.
//
// Возвращаемое значение:
//     Массив - Массив - содержит структуры с полями:
//	   		* ШифрыРасценки			- Строка - Шифры расценок через запятую в рамках остальных группировок.
//			* КодРайона             - Строка - Код района для обращения в ВНБ.
//			* КодРегиональнойБазы   - Строка - Код СНБ для обращения в ВНБ.
//			* СборникТекущихЦен  	- Строка - Имя базы сборника текущих цен.
//	
Функция ПолучитьТаблицуРесурсовДляТекущихЦенПоОбъекту(Объект,СтруктураПараметров, Смета) Экспорт
	
	Массив = Новый Массив;
	
	Если ТипЗнч(Объект) = Тип("СправочникСсылка.СМ_НормативныеСборники") Тогда
		ТабРесурсов = Объект.РесурсыНормативныхСборников;
	Иначе
		Структура = Новый Структура("ШифрыРасценки, КодРайона, КодРегиональнойБазы, СборникТекущихЦен");
		Массив.Добавить(Структура);
		Возврат Массив;
	КонецЕсли;
	
	Если ТабРесурсов.Количество() = 0 Тогда
		Структура = Новый Структура("ШифрыРасценки, КодРайона, КодРегиональнойБазы, СборникТекущихЦен");
		Массив.Добавить(Структура);
		Возврат Массив;
	КонецЕсли;
	
	СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(Смета);
	КодРайона = СтруктураПараметровРасчетаЛС.КодРайона;
	КодРегиональнойБазы = СтруктураПараметров.КодРегиональнойБазы;
    СборникТекущихЦен = СтруктураПараметров.СборникТекущихЦен;
	
	ТаблицаСведений = Новый ТаблицаЗначений();
	ТаблицаСведений.Колонки.Добавить("ШифрыРасценки");
	ТаблицаСведений.Колонки.Добавить("КодРайона");
	ТаблицаСведений.Колонки.Добавить("КодРегиональнойБазы");
	ТаблицаСведений.Колонки.Добавить("СборникТекущихЦен");
	
	Для Каждого Рес Из ТабРесурсов Цикл
		Стр = ТаблицаСведений.Добавить();
		Стр.ШифрыРасценки = Рес.Ресурс.Код;
		Стр.КодРайона = КодРайона;
		Стр.КодРегиональнойБазы = КодРегиональнойБазы;
		Стр.СборникТекущихЦен = СборникТекущихЦен;
	КонецЦикла;
	
	Для Каждого СтрПозиция Из ТаблицаСведений Цикл
	
		Структура = Новый Структура("ШифрыРасценки, КодРайона, КодРегиональнойБазы, СборникТекущихЦен");
		ЗаполнитьЗначенияСвойств(Структура, СтрПозиция);
		Массив.Добавить(Структура);     		
		
	КонецЦикла;
	
	Возврат Массив;
		
КонецФункции

// Заполняет сборники доступных цен из XML.
// TO DO - перенести на сервер.
//
// Параметры:
//     Данные 			- Строка - содержит данные из ВНБ в формате XML.
//     ТаблСборников 	- ТаблицаЗначений - таблица, в которую загружаем данные о сборниках.
//     ВерсияПротокола 	- Число	- версия внешней нормативной базы.
//
Процедура ЗаполнитьСборникиДоступныеИзXML(Данные, ТаблСборников, ВерсияПротокола = 1) Экспорт
	
	ТаблСборников.Очистить();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Данные);
	Если ВерсияПротокола = 1 Тогда
		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				Если ЧтениеXML.Имя = "collection" Тогда
					СтрокаТаблСборников = ТаблСборников.Добавить();
					Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
						Если ЧтениеXML.Значение = " " ИЛИ ЧтениеXML.Значение = "" Тогда
							Продолжить;
						КонецЕсли;
						Если ЧтениеXML.Имя = "name" Тогда
							СтрокаТаблСборников.Представление = Строка(ЧтениеXML.Значение);	
						ИначеЕсли ЧтениеXML.Имя = "date" Тогда
							СтрокаТаблСборников.Дата = Строка(ЧтениеXML.Значение);	
						ИначеЕсли ЧтениеXML.Имя = "file_name" Тогда
							СтрокаТаблСборников.ИмяФайла = Строка(ЧтениеXML.Значение);	
						ИначеЕсли ЧтениеXML.Имя = "code_base" Тогда
							СтрокаТаблСборников.НормативнаяБаза = Справочники.СМ_СметноНормативныеБазы.НайтиПоКоду(Строка(ЧтениеXML.Значение));	
							СтрокаТаблСборников.КодНормативнойБазы = Строка(ЧтениеXML.Значение);
							Если Не ЗначениеЗаполнено(СтрокаТаблСборников.НормативнаяБаза) Тогда
								// Нет нормативной базы.
								Спр = Справочники.СМ_СметноНормативныеБазы.СоздатьЭлемент();
								Спр.Код = СтрокаТаблСборников.КодНормативнойБазы;
								Спр.Наименование = СтрокаТаблСборников.Представление;
								Спр.Записать();
								СтрокаТаблСборников.НормативнаяБаза = Спр.Ссылка;								
							КонецЕсли;
						ИначеЕсли ЧтениеXML.Имя = "sert" Тогда
							СтрокаТаблСборников.Сертификат = Булево(Число(ЧтениеXML.Значение));	
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли; 
		КонецЦикла;
	Иначе
		// Вторая версия.
		Пока ЧтениеXML.Прочитать() Цикл
			Если (ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента)ИЛИ(ЧтениеXML.ТипУзла = ТипУзлаXML.Текст) Тогда
				Имя = НРег(ЧтениеXML.Имя);
				Если Имя = "base" Тогда
					СтрокаТаблСборников = ТаблСборников.Добавить();
					Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
						Если ЧтениеXML.Значение = " " ИЛИ ЧтениеXML.Значение = "" Тогда
							Продолжить;
						КонецЕсли;
						Если НРег(ЧтениеXML.Имя) = "description" Тогда
							СтрокаТаблСборников.Представление = Строка(ЧтениеXML.Значение);
						КонецЕсли;
					КонецЦикла;
				ИначеЕсли Имя = "region" Тогда
					ЧтениеXML.Прочитать();
					СтрокаТаблСборников.НормативнаяБаза = Справочники.СМ_СметноНормативныеБазы.НайтиПоКоду(Строка(ЧтениеXML.Значение));
					СтрокаТаблСборников.КодНормативнойБазы = Строка(ЧтениеXML.Значение);
					Если Не ЗначениеЗаполнено(СтрокаТаблСборников.НормативнаяБаза) Тогда
						// Нет нормативной базы.
						Спр = Справочники.СМ_СметноНормативныеБазы.СоздатьЭлемент();
						Спр.Код = СтрокаТаблСборников.КодНормативнойБазы;
						Спр.Наименование = СтрокаТаблСборников.Представление;
						Спр.Записать();
						СтрокаТаблСборников.НормативнаяБаза = Спр.Ссылка;								
					КонецЕсли;
				ИначеЕсли Имя = "period" Тогда
					ЧтениеXML.Прочитать();
					СтрокаЧисло = Строка(ЧтениеXML.Значение);
					СтрокаДата = "";
					Для ном = 1 По СтрДлина(СтрокаЧисло) Цикл
						Симв = Сред(СтрокаЧисло, ном, 1);
						Если Найти("1234567890", Симв) > 0 Тогда
							СтрокаДата = СтрокаДата + Симв;
						КонецЕсли;
					КонецЦикла;
					СтрокаТаблСборников.Дата = Дата(СтрокаДата);
				ИначеЕсли Имя = "dbid" Тогда
					ЧтениеXML.Прочитать();
					СтрокаТаблСборников.ИмяФайла = Строка(ЧтениеXML.Значение);	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;		
	КонецЕсли;
	
КонецПроцедуры

// Готовит таблицу текущих цен ресурсов по данным из ВНБ.
// TO DO - перенести на сервер.
//
// Параметры:
//     Данные - Строка - содержит XML данные из ВНБ о текущих ценах ресурсов.
//
// Возвращаемое значение:
//     Таблица - ТаблицаЗначений - содержит информацию о текущих ценах ресурсов.
//
Функция ЗагрузитьТекущиеЦеныВТаблицу(Данные) Экспорт
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("ШифрРасценки");
	Таблица.Колонки.Добавить("Наименование");
	Таблица.Колонки.Добавить("Определитель");
	Таблица.Колонки.Добавить("ЕдиницаИзмерения");
	Таблица.Колонки.Добавить("Измеритель");
	Таблица.Колонки.Добавить("ТекущаяЦена");
	Таблица.Колонки.Добавить("ТекущаяЗарплатаМашинистов");
	Таблица.Колонки.Добавить("ОбъемРабот");
		
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Данные);
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если (ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента) Тогда
			Имя = НРег(ЧтениеXML.Имя);
			Если Имя = "norm" Тогда
				СтрокаТаб = Таблица.Добавить();
				СтрокаТаб.ТекущаяЦена = 0;
				СтрокаТаб.ТекущаяЗарплатаМашинистов = 0;
				Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
					Если ЧтениеXML.Значение = " " ИЛИ ЧтениеXML.Значение = "" Тогда
						Продолжить;
					КонецЕсли;
					ТегИмя = НРег(ЧтениеXML.Имя);
					Если ТегИмя = "code" Тогда
						СтрокаТаб.ШифрРасценки = ЧтениеXML.Значение;	
					ИначеЕсли ТегИмя = "name" Тогда
						СтрокаТаб.Наименование = ""+ЧтениеXML.Значение;
				    ИначеЕсли ТегИмя = "opr" Тогда
						Определитель = Число(ЧтениеXML.Значение);
						Если Определитель>0 Тогда
							СтрокаТаб.Определитель = Справочники.СМ_Определители.НайтиПоКоду(Определитель);
						Иначе
							СтрокаТаб.Определитель = Справочники.СМ_Определители.НайтиПоКоду(1);
						КонецЕсли;
					ИначеЕсли ТегИмя = "izm" Тогда
						СтрокаТаб.Измеритель = ""+ЧтениеXML.Значение;
					ИначеЕсли ТегИмя = "unit" Тогда
						СтрокаТаб.ЕдиницаИзмерения = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоКоду(Число(ЧтениеXML.Значение));
					КонецЕсли;
				КонецЦикла;
			ИначеЕсли Имя = "pz" Тогда
				ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML,СтрокаТаб,"ТекущаяЦена");
			ИначеЕсли (Имя = "zpm")ИЛИ(Имя = "zpr")ИЛИ(Имя = "zpmm") Тогда
				ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML,СтрокаТаб,"ТекущаяЗарплатаМашинистов");
			ИначеЕсли Имя = "volume" Тогда
				ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML,СтрокаТаб,"ОбъемРабот");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Таблица.Свернуть("ШифрРасценки, Наименование, Определитель, ЕдиницаИзмерения, Измеритель, ТекущаяЦена, ТекущаяЗарплатаМашинистов, ОбъемРабот");
	
	Возврат Таблица;
			
КонецФункции

// Заполняет структуру данными о текущих ценах из ВНБ.
//
// Параметры:
//     Данные 		- Строка	- данные в формате XML из Внешней нормативной базы.
//     СтруктураЦен - Структура - содержит поля:
//							* БазиснаяЦена 					- Число	- базисная цена ресурса.
//							* БазиснаяЗарплатаМашинистов    - Число	- базисная заработная плата машинистов.
//							* ТекущаяЦена                   - Число	- текущая цена ресурса.
//							* ТекущаяЗарплатаМашинистов	    - Число	- текущая заработная плата машинистов.
//
Процедура ПолучитьЦенуРесурса(Данные, СтруктураЦен) Экспорт
	ТекЦена = 0;
	ТекЦенаЗПМ = 0;
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Данные);
	Пока ЧтениеXML.Прочитать() Цикл
		Если (ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента)ИЛИ(ЧтениеXML.ТипУзла = ТипУзлаXML.Текст) Тогда
			Имя = НРег(ЧтениеXML.Имя);
			Если Имя = "pz" Тогда
				ЧтениеXML.Прочитать();
				ТекЦена = Число(ЧтениеXML.Значение);
			ИначеЕсли Имя = "zpr" Тогда
				ЧтениеXML.Прочитать();
				ТекЦенаЗПМ = Число(ЧтениеXML.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	СтруктураЦен.ТекущаяЦена = ТекЦена;
	СтруктураЦен.ТекущаяЗарплатаМашинистов = ТекЦенаЗПМ ;

КонецПроцедуры

