// Функция загружает итоги по разделу из XML.
//	Тег - типа ЧтениеXML.
//
Функция ЗагрузитьИтогиПоРазделуИзXML(Тег) Экспорт
	
	ОбъектДляЗаписи = Справочники.СМ_ИтогиПоРазделу.ПустаяСсылка();
	
	Код = "";
	
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Имя = "code" Тогда
			Код = Число(Тег.Значение);
		ИначеЕсли Тег.Имя = "name" Тогда
			ОбъектДляЗаписи.Наименование = Тег.Значение; 	
