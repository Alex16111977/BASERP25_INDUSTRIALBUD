// Процедкра  загружает соответствия определителя и расчета накладных расходов для методики 1984 года.
// В таблицу  из XML.
//	Тег - типа ЧтениеXML.
//  Табл - таблица значений.
Процедура ЗагрузитьСоответствия(Тег,Табл) Экспорт
	СтрокаТабл =  Табл.Добавить();
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Имя = "code" Тогда
			КодОпределителя = Число(Тег.Значение);
			СтрокаТабл.Определитель = Справочники.СМ_Определители.НайтиПоКоду(КодОпределителя);
		ИначеЕсли Тег.Имя = "rulenr" Тогда
			ПравилоНР = Тег.Значение; 
			СтрокаТабл.ПравилоНачисленияНР = Перечисления.СМ_ПравилаРасчетаНРпоМетодике1984[Тег.Значение];
		ИначеЕсли Тег.Имя = "rulesp" Тогда
			ПравилоСП = Тег.Значение;
			СтрокаТабл.ПравилоНачисленияСП = ПравилоСП;
		ИначеЕсли Тег.Имя = "val" Тогда
			СтрокаТабл.ЗначениеНРБазисноИндексное = Число(Тег.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеСправочниковИзВНБ

// Функция возвращает массив СНБ для обновления.
//
Функция ПолучитьМассивСНБ(МассивВнешнихСНБ)
	
	// ОТЛАЖЕНО.
	// Отвечает за список СНБ, по которым нужно обновить данные из ВНБ.
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СметноНормативныеБазы.Ссылка,
	                      |	СметноНормативныеБазы.Код,
	                      |	СметноНормативныеБазы.Версия
	                      |ИЗ
	                      |	Справочник.СМ_СметноНормативныеБазы КАК СметноНормативныеБазы");
	Результат = Запрос.Выполнить().Выгрузить();
	
	МассивСНБ = Новый Массив;
	СНБЗаполнена = Результат.Количество() > 0;
	
	СообщенияДляЖурнала= Новый СписокЗначений();
	
	Для Каждого СтрокаСписка Из МассивВнешнихСНБ Цикл
		НайденнаяСтрока = Результат.Найти(СтрокаСписка.Код,"Код");
		Если НайденнаяСтрока = Неопределено Тогда
			Если ЗначениеЗаполнено(СтрокаСписка.Наименование) Тогда
				НовыйСНБ = Справочники.СМ_СметноНормативныеБазы.СоздатьЭлемент();
				ЗаполнитьЗначенияСвойств(НовыйСНБ, СтрокаСписка);
				
				НовыйСНБ.УровеньБазы = ОпределитьУровеньСНБ(СтрокаСписка.Наименование, СтрокаСписка.Код);
				НовыйСНБ.ОсновнойТипКоэффициентов = Перечисления.СМ_ВидыИндексов.ПоРасценкам;
				Если ЗначениеЗаполнено(СтрокаСписка.ГодВыпуска) Тогда
					НовыйСНБ.ГодВыпуска = Перечисления.СМ_ГодыВыпускаБазы["г"+СтрокаСписка.ГодВыпуска];
				Иначе
					НовыйСНБ.ГодВыпуска = Перечисления.СМ_ГодыВыпускаБазы.г2001;
				КонецЕсли;
				НовыйСНБ.Записать();
				МассивСНБ.Добавить(НовыйСНБ.Код);
				
				СтруктураСообщения = Новый Структура("ИмяСобытия, ПредставлениеУровня, Комментарий, ДатаСобытия", 
							НСтр("ru='Обновление нормативных баз'"), 
							НСтр("ru='Информация'"), 
							СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Найдена новая нормативная база (отсутствует в справочнике) %1'"), НовыйСНБ.Наименование), 
							ТекущаяДатаСеанса());  		
				СообщенияДляЖурнала.Добавить(СтруктураСообщения);
				
			КонецЕсли;
		Иначе
			СсылкаОбъект = НайденнаяСтрока.Ссылка.ПолучитьОбъект();
			Если ?(СтрокаСписка.Версия=Неопределено, "", СтрокаСписка.Версия) <> НайденнаяСтрока.Версия Тогда
				МассивСНБ.Добавить(СсылкаОбъект.Код);
				
				СтруктураСообщения = Новый Структура("ИмяСобытия, ПредставлениеУровня, Комментарий, ДатаСобытия", 
							НСтр("ru='Обновление нормативных баз'"), 
							НСтр("ru='Информация'"), 
							СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Обновлена нормативная база %1'"), СсылкаОбъект.Наименование)+Символы.ПС+СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Версия в справочнике: %1'"), СсылкаОбъект.Версия)+Символы.ПС+СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Версия во внешней базе: %1'"), СтрокаСписка.Версия),ТекущаяДатаСеанса());  		
				СообщенияДляЖурнала.Добавить(СтруктураСообщения);
				
				// Если версия не равна, исправим это положение.
				СсылкаОбъект.Версия = СтрокаСписка.Версия;
			КонецЕсли;
			// Перезаполним реквизиты.
			Если НЕ ЗначениеЗаполнено(СсылкаОбъект.УровеньБазы) Тогда
				СсылкаОбъект.УровеньБазы = ОпределитьУровеньСНБ(СсылкаОбъект.Наименование, СсылкаОбъект.Код);
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СсылкаОбъект.ОсновнойТипКоэффициентов) Тогда
				СсылкаОбъект.ОсновнойТипКоэффициентов = Перечисления.СМ_ВидыИндексов.ПоРасценкам;
			КонецЕсли;
			СсылкаОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
	
	ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
	
	Возврат Новый Структура("МассивСНБ,СНБЗаполнена", МассивСНБ, СНБЗаполнена);
	
КонецФункции

// Получить значение перечисления.
//
Функция ПолучитьВидРесурсаПоНомеру(ЧислоВид)
	
	Если Не ЗначениеЗаполнено(ЧислоВид) Тогда
		Возврат Неопределено;
	Иначе
		Если ЧислоВид = 4 Тогда
			Возврат	Перечисления.СМ_ВидыРесурсов.Материалы;
		ИначеЕсли ЧислоВид = 3 Тогда
		    Возврат	Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы;
		ИначеЕсли ЧислоВид = 1 Тогда
		    Возврат	Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих;
		ИначеЕсли ЧислоВид = 2 Тогда
			Возврат Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов;
		Иначе
			Возврат Неопределено;	
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

// Получить значение перечисления.
//
Функция ПолучитьВидРесурса(СтрокаОписывающаяВид)
	
	Попытка
		Значение = Перечисления.СМ_ВидыРесурсов[СтрокаОписывающаяВид];
		Возврат Значение;
	Исключение	
		Англ = НРег(СтрокаОписывающаяВид);
		Если Англ = "materials" Тогда
			Возврат	Перечисления.СМ_ВидыРесурсов.Материалы;
		ИначеЕсли Англ = "machinery" Тогда
		    Возврат	Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы;
		ИначеЕсли Англ = "work" Тогда
		    Возврат	Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих;
		ИначеЕсли Англ = "machinists" Тогда
			Возврат	Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов;
		Иначе
			Возврат Перечисления.СМ_ВидыРесурсов.Материалы;
		КонецЕсли;
	КонецПопытки;
	
КонецФункции

// Функция чтения реквизитов Ресурса из XML.
//
Функция ПрочитатьРеквизитыРесурсаИзXML(Тег, ВставкаВПозицию = Истина, ВерсияФормата = 1, СНБ = Неопределено)
	
	// Эрикос.
	// ДАННАЯ ПРОЦЕДУРА только для загрузки элемента справочника РЕСУРСЫ.
	// МЕНЯТЬ ЕЕ НЕЛЬЗЯ!!!! Только когда добавили реквизит в справочник Ресурсы (а не в ТЧ позиции). 
	// Если нужно грузить ресурсы в позицию - использовать ЗаполнитьРеcурсыПозицииЛСИзXML().
	// Там идет разбор типа материала, нормы и т.п.
	// В справочнике реквизита "Тип материалов" нет.
	//	Параметр ВставкаВПозицию - если Истина, то считываются только ключевые реквизиты для обнаружения ресурса.
	
	ЗначенияРеквизитов = Новый Структура("Код,СметныйКодРесурса,НаименованиеРесурса,Наименование,ДлинноеНаименование,ЕдиницаИзмеренияРесурса,ЕдиницаИзмерения,КодОКП,МассаНетто,МассаБрутто,ВидРесурса,ТипРесурса,Родитель,ГруппаРесурсов,ГодВыпуска");
	Пока Тег.ПрочитатьАтрибут() Цикл
		ТегИмя = НРег(Тег.Имя);
		Если ТегИмя = "code" Тогда
			ЗначенияРеквизитов.Код = Тег.Значение;
			ЗначенияРеквизитов.СметныйКодРесурса = Тег.Значение;
		ИначеЕсли ТегИмя = "name" Тогда
			ЗначенияРеквизитов.Наименование = Тег.Значение;	
			ЗначенияРеквизитов.ДлинноеНаименование = Тег.Значение;
			ЗначенияРеквизитов.НаименованиеРесурса = Тег.Значение;
		ИначеЕсли ТегИмя = "ej" ИЛИ Тег.Имя = "unit" Тогда
			ЗначенияРеквизитов.ЕдиницаИзмерения = НайтиЕдиницуИзмеренияСметномуКоду(Тег.Значение);
			ЗначенияРеквизитов.ЕдиницаИзмеренияРесурса = Тег.Значение;
		ИначеЕсли ТегИмя = "codeokp" Тогда
			ЗначенияРеквизитов.КодОКП = Тег.Значение;	
		ИначеЕсли ТегИмя = "netto" Тогда
			ЗначенияРеквизитов.МассаНетто = Тег.Значение;
		ИначеЕсли ТегИмя = "brutto" Тогда
			ЗначенияРеквизитов.МассаБрутто = Тег.Значение;
		ИначеЕсли (ТегИмя = "group_int") И (ВерсияФормата = 1) Тогда
			ВидРесурса = ПолучитьВидРесурсаПоНомеру(Тег.Значение);
			Если ЗначениеЗаполнено(ВидРесурса) Тогда
				ЗначенияРеквизитов.ВидРесурса = ВидРесурса;
			КонецЕсли;
		ИначеЕсли ТегИмя = "group" Тогда
			ЗначенияРеквизитов.ВидРесурса = ПолучитьВидРесурса(СтрЗаменить(Тег.Значение," ",""));
		ИначеЕсли (ТегИмя = "type") И Не ВставкаВПозицию Тогда 
			ЗначенияРеквизитов.ВидРесурса = ПолучитьВидРесурса(СтрЗаменить(Тег.Значение," ",""));
		ИначеЕсли ТегИмя = "rescatalog" Тогда
			НаименованиеКаталога = Тег.Значение;
			Если ЗначениеЗаполнено(НаименованиеКаталога) Тогда
				ГруппаРесурсов = Справочники.СМ_ГруппыРесурсов.НайтиПоНаименованию(НаименованиеКаталога);
				Если ГруппаРесурсов <> Неопределено Тогда
					ЗначенияРеквизитов.ГруппаРесурсов = ГруппаРесурсов;
				КонецЕсли;
			КонецЕсли;
		// Иначе ТУТ иначе быть не должно.
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(ЗначенияРеквизитов.ГруппаРесурсов) Тогда
		Если ЗначениеЗаполнено(СНБ) Тогда 
			ЗначенияРеквизитов.ГруппаРесурсов = СНБ.ГруппаРесурсов;
		Иначе
			ЗначенияРеквизитов.ГруппаРесурсов = Справочники.СМ_Ресурсы.КаталогПоУмолчанию(ЗначенияРеквизитов);
		КонецЕсли;
	КонецЕсли;
	
	Каталог = ПредопределенноеЗначение("Справочник.СМ_Ресурсы."+ЗначенияРеквизитов.ГруппаРесурсов.ИмяПредопределенныхДанных);
	
	ЗначенияРеквизитов.Родитель = СоздатьПолучитьПапкуРесурсов(""+ЗначенияРеквизитов.ВидРесурса, Каталог);
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

// Функция создания элемента справочника Ресурсы из XML 
// "Вставка в позицию" - определяет вставляется ли ресурс в позицию или идет загрузка списка ресурсов.
//
Функция ЗагрузитьРесурсИзXML(Тег, Год = Неопределено, СНБ = Неопределено, ВставкаВПозицию = Истина, ВерсияФормата = 1)
	
	НаименованиеСправочника = "СМ_Ресурсы";
	КодРесурса = "";
	КодРесурса = Тег.ПолучитьАтрибут(?(ВерсияФормата=1,"code","Code")); 
	Если Не ЗначениеЗаполнено(КодРесурса) Тогда
		КодРесурса = Тег.ПолучитьАтрибут("code");
	КонецЕсли;
	
	НовоеНаименование = "";
	НоваяЕдиницаИзмерения = Справочники.СМ_ЕдиницыИзмеренияСмета.ПустаяСсылка();
	
	ЗначенияРеквизитов = ПрочитатьРеквизитыРесурсаИзXML(Тег, ВставкаВПозицию, ВерсияФормата, СНБ);
	ЗначенияРеквизитов.Вставить("ГодВыпуска", Год);
	
	ОбъектДляЗаписи = СМ_СметаВызовСервера.НайтиРесурсПоКоду(ЗначенияРеквизитов, , НаименованиеСправочника); 
	
	Если ОбъектДляЗаписи = Справочники[НаименованиеСправочника].ПустаяСсылка() ИЛИ ОбъектДляЗаписи = неопределено Тогда
		ОбъектДляЗаписи = Справочники[НаименованиеСправочника].СоздатьЭлемент();		
	Иначе 
		ОбъектДляЗаписи = ОбъектДляЗаписи.ПолучитьОбъект();
	КонецЕсли;
	
	// Для регистра наименований.	
	Если Не ЗначениеЗаполнено(ОбъектДляЗаписи.Ссылка) Тогда
		ЗаполнитьЗначенияСвойств(ОбъектДляЗаписи,ЗначенияРеквизитов);
	Иначе
		Если Не ЗначениеЗаполнено(ОбъектДляЗаписи.ЕдиницаИзмерения) И ЗначениеЗаполнено(ЗначенияРеквизитов.ЕдиницаИзмерения) Тогда
			ОбъектДляЗаписи.ЕдиницаИзмерения = ЗначенияРеквизитов.ЕдиницаИзмерения;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ОбъектДляЗаписи.ВидРесурса) И ЗначениеЗаполнено(ЗначенияРеквизитов.ВидРесурса) Тогда
			ОбъектДляЗаписи.ВидРесурса = ЗначенияРеквизитов.ВидРесурса;
			ОбъектДляЗаписи.Родитель = ЗначенияРеквизитов.Родитель;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ОбъектДляЗаписи.ГодВыпуска) И ЗначениеЗаполнено(ЗначенияРеквизитов.ГодВыпуска) Тогда
			ОбъектДляЗаписи.ГодВыпуска = ЗначенияРеквизитов.ГодВыпуска;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ОбъектДляЗаписи.Наименование) И ЗначениеЗаполнено(ЗначенияРеквизитов.Наименование) Тогда
			ОбъектДляЗаписи.Наименование = ЗначенияРеквизитов.Наименование;
			ОбъектДляЗаписи.ДлинноеНаименование = ЗначенияРеквизитов.Наименование;
		КонецЕсли;
	КонецЕсли;
	
	Если (ЗначенияРеквизитов.Наименование <> ОбъектДляЗаписи.Наименование) И (ЗначениеЗаполнено(ЗначенияРеквизитов.Наименование)) Тогда
		НовоеНаименование = ЗначенияРеквизитов.Наименование;
	Иначе
		НовоеНаименование = "";
		ОбъектДляЗаписи.Наименование = ЗначенияРеквизитов.Наименование;	
		ОбъектДляЗаписи.ДлинноеНаименование = ЗначенияРеквизитов.Наименование;
	КонецЕсли;
		
	Если (ЗначенияРеквизитов.ЕдиницаИзмерения <> ОбъектДляЗаписи.ЕдиницаИзмерения) И (ЗначениеЗаполнено(ЗначенияРеквизитов.ЕдиницаИзмерения)) Тогда
		НоваяЕдиницаИзмерения = ЗначенияРеквизитов.ЕдиницаИзмерения;
	Иначе
		НоваяЕдиницаИзмерения = Справочники.СМ_ЕдиницыИзмеренияСмета.ПустаяСсылка();
		ОбъектДляЗаписи.ЕдиницаИзмерения = ЗначенияРеквизитов.ЕдиницаИзмерения;
	КонецЕсли; 			
        
	ОбъектДляЗаписи.Записать();
	
	Если Не ВставкаВПозицию Тогда

		Если ЗначениеЗаполнено(НоваяЕдиницаИзмерения) ИЛИ ЗначениеЗаполнено(НовоеНаименование) Тогда
			СтруктураРеквизитов = Новый Структура("Ресурс,СметноНормативнаяБаза,Наименование,ЕдиницаИзмерения,ВидРесурса", ОбъектДляЗаписи.Ссылка, СНБ, ЗначенияРеквизитов.Наименование, ЗначенияРеквизитов.ЕдиницаИзмерения, ЗначенияРеквизитов.ВидРесурса);
			СтруктураРеквизитов.СметноНормативнаяБаза = СНБ;
			СтруктураРеквизитов[?(НаименованиеСправочника = "Номенклатура","Номенклатура","Ресурс")] = ОбъектДляЗаписи.ссылка;
			СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведений("СМ_СметныеНаименованияРесурсов",Новый Структура(?(НаименованиеСправочника = "Номенклатура","Номенклатура","Ресурс"),ОбъектДляЗаписи.Ссылка), СтруктураРеквизитов);
		КонецЕсли;
		
	КонецЕсли;

	Возврат ОбъектДляЗаписи.Ссылка;
	
КонецФункции

// Функция загружает цены в регистр ЗаписатьРеквизитыРегистраСведений из XML.
// Параметры: Тег - Объект ЧтениеXML.
// Ресурс - элемент справочника ресурс.
// СНБ - сментно-нормативная база.
//
Функция ЗагрузитьЦенуРесурсаИзXML(Тег, Ресурс , СНБ)
	
	СтруктураРеквизитов = Новый Структура("СметнаяЦена,ОптоваяЦена,Транспортные,ТранспортныеПроц,ЗаготСкладские,ЗаготСкладскиеПроц,ЗарплМашинистов,Амортизация,Ремонт,ЗаменаЗапЧастей,ЗатратыТрудаМаш,Бензин,БензинКол,БензинЕдИзм,ДизельТопливо,ДизельТопливоКол,ДизельТопливоЕдИзм,СжатыйВоздух,СжатыйВоздухКол,СжатыйВоздухЕдИзм,СмазочныеМатериал,ГидрЖидкость,ГидрЖидкостьКол,ГидрЖидкостьЕдИзм,Перебазировка,СметПрибыль,Тариф,Коэффициент,Электроэнергия,ЭлектроэнергияКол,ЭлектроэнергияЕдИзм,НаклРасх");	
	Район = Справочники.СМ_ТерриториальныеРайоны.ПустаяСсылка();
	Пока Тег.ПрочитатьАтрибут() Цикл
		ТегИмя = НРег(Тег.Имя);
		Если (ТегИмя = "code") ИЛИ (ТегИмя = "zonecode") Тогда
			Район = Справочники.СМ_ТерриториальныеРайоны.НайтиПоКоду(Тег.Значение);
		ИначеЕсли ТегИмя = "price" ИЛИ ТегИмя = "bazis" ИЛИ ТегИмя = "outlays" Тогда
			СтруктураРеквизитов.СметнаяЦена = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "zpm" ИЛИ ТегИмя = "zpmm" ИЛИ ТегИмя = "operators" Тогда
			СтруктураРеквизитов.ЗарплМашинистов = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "ammo" Тогда
			СтруктураРеквизитов.Амортизация = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "repair" Тогда
			СтруктураРеквизитов.Ремонт = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "parts" Тогда
			СтруктураРеквизитов.ЗаменаЗапЧастей = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "ztm" Тогда
			СтруктураРеквизитов.ЗатратыТрудаМаш = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "fueld" Тогда
			СтруктураРеквизитов.Бензин = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "vfueldl" Тогда
			СтруктураРеквизитов.БензинКол = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "ejfueld" Тогда
			СтруктураРеквизитов.БензинЕдИзм = НайтиЕдиницуИзмеренияСметномуКоду(Тег.Значение);
		ИначеЕсли ТегИмя = "oil" Тогда
			СтруктураРеквизитов.ДизельТопливо = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "voil" Тогда
			СтруктураРеквизитов.ДизельТопливоКол = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "ejoil" Тогда
			СтруктураРеквизитов.ДизельТопливоЕдИзм = НайтиЕдиницуИзмеренияСметномуКоду(Тег.Значение);
		ИначеЕсли ТегИмя = "energy" Тогда
			СтруктураРеквизитов.Электроэнергия = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "venergy" Тогда
			СтруктураРеквизитов.ЭлектроэнергияКол = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "ejenergy" Тогда
			СтруктураРеквизитов.ЭлектроэнергияЕдИзм = НайтиЕдиницуИзмеренияСметномуКоду(Тег.Значение);
		ИначеЕсли ТегИмя = "air" Тогда
			СтруктураРеквизитов.СжатыйВоздух = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "vair" Тогда
			СтруктураРеквизитов.СжатыйВоздухКол = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "ejair" Тогда
			СтруктураРеквизитов.СжатыйВоздухЕдИзм = НайтиЕдиницуИзмеренияСметномуКоду(Тег.Значение);
		ИначеЕсли ТегИмя = "smaz" Тогда
			СтруктураРеквизитов.СмазочныеМатериал = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "water" Тогда
			СтруктураРеквизитов.ГидрЖидкость = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "vwater" Тогда
			СтруктураРеквизитов.ГидрЖидкостьКол = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "ejwater" Тогда
			СтруктураРеквизитов.ГидрЖидкостьЕдИзм = НайтиЕдиницуИзмеренияСметномуКоду(Тег.Значение);
		ИначеЕсли ТегИмя = "pb" Тогда
			СтруктураРеквизитов.Перебазировка = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "nr" Тогда
			СтруктураРеквизитов.НаклРасх = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "sp" Тогда
			СтруктураРеквизитов.СметПрибыль = Число(Тег.Значение);
		ИначеЕсли (ТегИмя = "opt") ИЛИ (ТегИмя = "optc") Тогда
			Если Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
				СтруктураРеквизитов.ЗарплМашинистов = Число(Тег.Значение);
			Иначе
				СтруктураРеквизитов.ОптоваяЦена = Число(Тег.Значение);
			КонецЕсли;
		ИначеЕсли ТегИмя = "tr" Тогда
			СтруктураРеквизитов.Транспортные = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "trper" Тогда
			СтруктураРеквизитов.ТранспортныеПроц = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "sklad" Тогда
			СтруктураРеквизитов.ЗаготСкладские = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "skladper" Тогда
			СтруктураРеквизитов.ЗаготСкладскиеПроц = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "tariff" Тогда
			СтруктураРеквизитов.Тариф = Число(Тег.Значение);
		ИначеЕсли ТегИмя = "coeff" Тогда
			СтруктураРеквизитов.Коэффициент = Число(Тег.Значение);
		КонецЕсли;
	КонецЦикла;
	
	СтруктураРеквизитов.Вставить("Период", ДатаБазисныхЦен(Ресурс.ГодВыпуска));
	Если ЗначениеЗаполнено(Район) Тогда	
		СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведений("СМ_СметныеЦеныРесурсов",Новый Структура("Ресурс,СметноНормативнаяБаза,Район,ТипЦен",Ресурс.Ссылка,СНБ,Район,Перечисления.СМ_ТипыЦен.Базисная), СтруктураРеквизитов);
	Иначе
		Для Каждого СтрРайон Из СНБ.Районы Цикл
			СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведений("СМ_СметныеЦеныРесурсов",Новый Структура("Ресурс,СметноНормативнаяБаза,Район,ТипЦен",Ресурс.Ссылка,СНБ,СтрРайон.ТерриториальныйРайон,Перечисления.СМ_ТипыЦен.Базисная), СтруктураРеквизитов);
		КонецЦикла;
	КонецЕсли;
		
	Возврат Неопределено;
	
КонецФункции

// Разбирает строку с данными о коэффициентом из Техчастей.
//
Процедура ЗаполнитьКоэффициентПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений, ИмяПоляРус, ИмяПоляАнгл, ИмяПоля)
	
	Если (ИмяПоляРус <> "") Тогда	
		Строка1 = НайтиПодстрокуМежду(СтрокаЗначений, ИмяПоляРус, "~");
		Если (Строка1 <> "") Тогда
			ОбъектДляЗаписи[ИмяПоля] = Число(Строка1);
		ИначеЕсли (ИмяПоляАнгл <> "") Тогда
			Строка2 = НайтиПодстрокуМежду(СтрокаЗначений, ИмяПоляАнгл, "~");
			Если (Строка2 <> "") Тогда
				ОбъектДляЗаписи[ИмяПоля] = Число(Строка2);
			Иначе
		        ОбъектДляЗаписи[ИмяПоля] = 0;
			КонецЕсли;
		Иначе
			ОбъектДляЗаписи[ИмяПоля] = 0;
		КонецЕсли;
	Иначе
		ОбъектДляЗаписи[ИмяПоля] = 0;
	КонецЕсли;
	
КонецПроцедуры

// Разбирает строку с данными о коэффициентах из Техчастей.
//
Процедура ЗаполнитьКоэффициентыПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений)
	
	ЗаполнитьКоэффициентПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений, "K2=", "К2=", "КоэффициентКОсновнойЗарплате");
	ЗаполнитьКоэффициентПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений, "K3=", "К3=", "КоэффициентКЭксплуатацииМашин");
	ЗаполнитьКоэффициентПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений, "K4=", "К4=", "КоэффициентКЗарплатеМашинистов");
	ЗаполнитьКоэффициентПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений, "K5=", "К5=", "КоэффициентКСтоимостиМатериалов");
	ЗаполнитьКоэффициентПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений, "K6=", "К6=", "КоэффициентКВозврату");
	ЗаполнитьКоэффициентПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений, "K7=", "К7=", "КоэффициентКТрудозатратамРабочих");
	ЗаполнитьКоэффициентПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений, "K8=", "К8=", "КоэффициентКТрудозатратамМашинистов");
	
	ЗаполнитьКоэффициентПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений, "П1=", "", "ДобавитьКПрямымЗатратам");
	ЗаполнитьКоэффициентПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений, "П2=", "", "ДобавитьКОсновнойЗарплате");
	ЗаполнитьКоэффициентПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений, "П3=", "", "ДобавитьКЭксплуатацииМашин");
	ЗаполнитьКоэффициентПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений, "П4=", "", "ДобавитьКЗарплатеМашинистов");
	ЗаполнитьКоэффициентПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений, "П5=", "", "ДобавитьКСтоимостиМатериалов");
	ЗаполнитьКоэффициентПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений, "П6=", "", "ДобавитьКВозврату");
	ЗаполнитьКоэффициентПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений, "П7=", "", "ДобавитьКТрудозатратамРабочих");
	ЗаполнитьКоэффициентПоТехЧастям(ОбъектДляЗаписи, СтрокаЗначений, "П8=", "", "ДобавитьКТрудозатратам");
	
КонецПроцедуры

// Загружает поправки из XML.
// Параметры:
//		Тег - XML.
//      СНБ - Нормативная база.
//		ТаблицаОбработанных - таблица значений с уже обработанными элементами и колонками Код и Ссылка.
//
Функция ЗагрузитьПоправкиИзXML(Тег, ТаблицаОбработанных, ВерсияФормата = 1, БазаМТСН = Ложь)
	
	// ОТЛАЖЕНО.
	// Отвечает за загрузку значений коэффциентов по Поаравкам из ВНБ.
	
	ОбъектДляЗаписи = Справочники.СМ_ПоправкиПоТехническимЧастям.ПустаяСсылка();
	
	Если ВерсияФормата = 1 Тогда
		ОбработкаГруппы = Булево(Число(Тег.ПолучитьАтрибут("group"))); 
	Иначе
		ОбработкаГруппы = Булево(Тег.ПолучитьАтрибут("IsGroup"));
	КонецЕсли;
	
	Если БазаМТСН Тогда
		
		Пока Тег.ПрочитатьАтрибут() Цикл
			
			ТегИмя = НРег(Тег.Имя);
			Если ТегИмя = "id"  И НЕ ОбработкаГруппы Тогда
				КодЭлемента = Число(Тег.Значение);
			ИначеЕсли ТегИмя = "list" И НЕ ОбработкаГруппы  Тогда
				СписокРасценок = Тег.Значение;
				Глава = НайтиГлавуВШифре(Тег.Значение, Истина);
				ТипСборника =  Тег.Значение;
				ТипНормативногоСборника = ОпределитьТипНормСборникаПоШифру(ТипСборника,Истина);
				НомерСборника = СМ_СметаВызовСервера.ОпределитьНомерСборника(ТипНормативногоСборника,Тег.Значение,Истина);
				Родитель = Справочники.СМ_ПоправкиПоТехническимЧастям.ПустаяСсылка();
				Отбор = Новый Структура();
				Отбор.Вставить("Глава",Глава);
				Если НомерСборника <> 0  Тогда
					Отбор.Вставить("НомерСборника",НомерСборника);
				КонецЕсли;
				МассивОтработанных = ТаблицаОбработанных.НайтиСтроки(Отбор);
				Если МассивОтработанных.Количество() <> 0 Тогда
					Родитель = МассивОтработанных[0].Ссылка;
				КонецЕсли;
			ИначеЕсли ТегИмя = "name" Тогда
				Наименование = Тег.Значение; 	
			ИначеЕсли ТегИмя = "description" И НЕ ОбработкаГруппы Тогда
				Обоснование = Тег.Значение; 	
			ИначеЕсли ((ТегИмя = "condition") ИЛИ (ТегИмя = "usl")) И НЕ ОбработкаГруппы Тогда
				УсловияПрименения = Тег.Значение; 	
			ИначеЕсли (ТегИмя = "obosn") И НЕ ОбработкаГруппы Тогда
				Обоснование = Тег.Значение;
			ИначеЕсли ТегИмя = "popr" И НЕ ОбработкаГруппы Тогда
				Коэффициенты = ВРег(""+Тег.Значение);
			ИначеЕсли ТегИмя = "poprm" И НЕ ОбработкаГруппы Тогда
				Справка = Тег.Значение;
			КонецЕсли;	
		КонецЦикла;
		Если  Родитель <> Справочники.СМ_ПоправкиПоТехническимЧастям.ПустаяСсылка() Тогда
			ОбъектДляЗаписи = ?(ОбработкаГруппы,Справочники.СМ_ПоправкиПоТехническимЧастям.СоздатьГруппу(),Справочники.СМ_ПоправкиПоТехническимЧастям.СоздатьЭлемент());
			ОбъектДляЗаписи.Наименование = Наименование; 	
			ОбъектДляЗаписи.НомерСборника = НомерСборника;
			ОбъектДляЗаписи.ТипНормативногоСборника = ТипНормативногоСборника;
			ОбъектДляЗаписи.СписокРасценок = СписокРасценок; 	
			
			ОбъектДляЗаписи.Справка = Справка;
			ОбъектДляЗаписи.Обоснование = Обоснование;
			ОбъектДляЗаписи.УсловияПрименения = УсловияПрименения; 	
			ЗаполнитьКоэффициентыПоТехЧастям(ОбъектДляЗаписи, Коэффициенты);		
			ОбъектДляЗаписи.УстановитьНовыйКод();
			ОбъектДляЗаписи.Родитель = Родитель;
		КонецЕсли;
	Иначе
		
		Пока Тег.ПрочитатьАтрибут() Цикл
			
			ТегИмя = НРег(Тег.Имя);
			
			Если ((ТегИмя = "code")и(Не БазаМТСН)) ИЛИ (ТегИмя = "id") Тогда
				
				Отбор = Новый Структура();
				Отбор.Вставить("Код",Число(Тег.Значение));
				МассивОтработанных = ТаблицаОбработанных.НайтиСтроки(Отбор);
				
				Если МассивОтработанных.Количество()=0 Тогда
					ОбъектДляЗаписи = ?(ОбработкаГруппы,Справочники.СМ_ПоправкиПоТехническимЧастям.СоздатьГруппу(),Справочники.СМ_ПоправкиПоТехническимЧастям.СоздатьЭлемент());
				Иначе 
					ОбъектДляЗаписи = МассивОтработанных[0].Ссылка.ПолучитьОбъект();
				КонецЕсли;
				
				ОбъектДляЗаписи.Код = Тег.Значение;
				
			ИначеЕсли ТегИмя = "name" Тогда
				ОбъектДляЗаписи.Наименование = Тег.Значение; 	
			ИначеЕсли ТегИмя = "description" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.Обоснование = Тег.Значение; 	
				ОбъектДляЗаписи.Наименование = Тег.Значение; 	
			ИначеЕсли (ТегИмя = "father")ИЛИ(ТегИмя = "parentid") Тогда
				
				Отбор = Новый Структура();
				Отбор.Вставить("Код",?(ЗначениеЗаполнено(Тег.Значение),Число(Тег.Значение),0));
				МассивОтработанных = ТаблицаОбработанных.НайтиСтроки(Отбор);
				
				Если МассивОтработанных.Количество()>0 Тогда
					ОбъектДляЗаписи.Родитель = МассивОтработанных[0].Ссылка;	
				ИначеЕсли ТаблицаОбработанных.Количество()>0 Тогда
					ОбъектДляЗаписи.Родитель = ТаблицаОбработанных[0].Ссылка;
				Иначе
					ОбъектДляЗаписи.Родитель = Справочники.СМ_ПоправкиПоТехническимЧастям.ПустаяСсылка();
				КонецЕсли;
				
			ИначеЕсли (ТегИмя = "type") ИЛИ (ТегИмя = "normtypecode") ИЛИ (ТегИмя = "normtype") Тогда
				ОбъектДляЗаписи.ТипНормативногоСборника = ОпределитьТипНормСборникаПоКоду(Тег.Значение); 	
			ИначеЕсли (ТегИмя = "number") ИЛИ (ТегИмя = "normpartpart") Тогда
				ОбъектДляЗаписи.НомерСборника = Тег.Значение; 	
			ИначеЕсли ((ТегИмя = "condition")ИЛИ(ТегИмя = "usl")) И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.УсловияПрименения = Тег.Значение; 	
			ИначеЕсли (ТегИмя = "obosn") И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.Обоснование = Тег.Значение;
			ИначеЕсли ТегИмя = "list" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.СписокРасценок = Тег.Значение; 	
			ИначеЕсли ТегИмя = "popr" И НЕ ОбработкаГруппы Тогда
				ЗаполнитьКоэффициентыПоТехЧастям(ОбъектДляЗаписи, ВРег(""+Тег.Значение));		
			ИначеЕсли ТегИмя = "poprm" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.Справка = Тег.Значение;
			ИначеЕсли ТегИмя = "kzp" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.КоэффициентКОсновнойЗарплате = Число(Тег.Значение); 	
			ИначеЕсли ТегИмя = "kem" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.КоэффициентКЭксплуатацииМашин =  Число(Тег.Значение); 	
			ИначеЕсли ТегИмя = "kzpm" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.КоэффициентКЗарплатеМашинистов = Число(Тег.Значение); 	
			ИначеЕсли ТегИмя = "kmat" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.КоэффициентКСтоимостиМатериалов = Число(Тег.Значение); 	
			ИначеЕсли ТегИмя = "kvmat" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.КоэффициентКВозврату = Число(Тег.Значение); 	
			ИначеЕсли ТегИмя = "kztr" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.КоэффициентКТрудозатратамРабочих = Число(Тег.Значение); 	
			ИначеЕсли ТегИмя = "kztm" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.КоэффициентКТрудозатратамМашинистов = Число(Тег.Значение); 	
			ИначеЕсли ТегИмя = "pz" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.ДобавитьКПрямымЗатратам = Число(Тег.Значение); 	
			ИначеЕсли ТегИмя = "zp" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.ДобавитьКОсновнойЗарплате = Число(Тег.Значение); 	
			ИначеЕсли ТегИмя = "em" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.ДобавитьКЭксплуатацииМашин = Число(Тег.Значение); 	
			ИначеЕсли ТегИмя = "zpm" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.ДобавитьКЗарплатеМашинистов = Число(Тег.Значение); 	
			ИначеЕсли ТегИмя = "mat" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.ДобавитьКСтоимостиМатериалов = Число(Тег.Значение); 	
			ИначеЕсли ТегИмя = "vmat" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.ДобавитьКВозврату = Число(Тег.Значение); 	
			ИначеЕсли ТегИмя = "ztr" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.ДобавитьКТрудозатратамРабочих = Число(Тег.Значение); 	
			ИначеЕсли ТегИмя = "ztm" И НЕ ОбработкаГруппы Тогда
				ОбъектДляЗаписи.ДобавитьКТрудозатратам = Число(Тег.Значение); 	
			ИначеЕсли ТегИмя = "dop" И НЕ ОбработкаГруппы Тогда
				// БЫЛО: ОбъектДляЗаписи.ДополнительныеСвойства = Тег.Значение; 	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ОбъектДляЗаписи;
	
КонецФункции 

// Функция загружает единицы.
//
Функция ЗагрузитьЕдиницыИзмеренияИзXML(Тег)
	
	ОбъектДляЗаписи = Новый Структура("СметныйКод,Наименование,КоэффициентПеревода,БазоваяЕдиница,КодОКЕИ");
	
	Пока Тег.ПрочитатьАтрибут() Цикл
		ТегИмя = НРег(Тег.Имя);
		Если (ТегИмя = "code") ИЛИ (ТегИмя = "id") Тогда
			ОбъектДляЗаписи.СметныйКод = СокрЛП(Тег.Значение);
		ИначеЕсли (ТегИмя = "name") Тогда
			ОбъектДляЗаписи.Наименование = Тег.Значение;	
		ИначеЕсли (ТегИмя = "k") ИЛИ (ТегИмя = "coeff") Тогда
			ОбъектДляЗаписи.КоэффициентПеревода = Тег.Значение;	
		ИначеЕсли (ТегИмя = "codebase") ИЛИ (ТегИмя = "baseunitid") Тогда
			ОбъектДляЗаписи.БазоваяЕдиница = Тег.Значение;	
		ИначеЕсли (ТегИмя = "codeokp") ИЛИ (ТегИмя = "okei") Тогда
			ОбъектДляЗаписи.КодОКЕИ = Тег.Значение;	
		КонецЕсли;
	КонецЦикла;
	
	СсылкаДляЗаписи = Справочники.СМ_ЕдиницыИзмеренияСмета.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ОбъектДляЗаписи.СметныйКод) Тогда
		Если (ЗначениеЗаполнено(ОбъектДляЗаписи.БазоваяЕдиница)) И (ОбъектДляЗаписи.СметныйКод <> ОбъектДляЗаписи.БазоваяЕдиница) Тогда
			ОбъектДляЗаписи.БазоваяЕдиница = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСметномуКоду(ОбъектДляЗаписи.БазоваяЕдиница);
		КонецЕсли;
		СсылкаДляЗаписи = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСметномуКоду(ОбъектДляЗаписи.СметныйКод);
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(СсылкаДляЗаписи) Тогда
		СсылкаДляЗаписи = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСтроке(ОбъектДляЗаписи.Наименование);
	КОнецЕсли;	
	
	Если Не ЗначениеЗаполнено(СсылкаДляЗаписи) Тогда
		СсылкаДляЗаписи = СМ_СметаВызовСервера.СоздатьНайтиЭлементСправочника("СМ_ЕдиницыИзмеренияСмета",ОбъектДляЗаписи.СметныйКод,Ложь,ОбъектДляЗаписи);
	КОнецЕсли;
	
	Возврат СсылкаДляЗаписи;
	
КонецФункции

// Функция читает снб из данных СНБ.
//
Функция ПрочитатьСНБ(Тег, ОбъектДляЗаписи)
	
	Пока Тег.ПрочитатьАтрибут() Цикл
		ИмяТега = НРег(Тег.Имя);
		Если ИмяТега = "code" Тогда
			ОбъектДляЗаписи.Код = Тег.Значение;
		ИначеЕсли (ИмяТега = "name") ИЛИ (ИмяТега = "description") Тогда
			ОбъектДляЗаписи.Наименование = Тег.Значение;; 	
		ИначеЕсли ИмяТега = "pravo" Тогда
			ОбъектДляЗаписи.Правообладатель = Тег.Значение; 	
		ИначеЕсли ИмяТега = "year" Тогда
			ОбъектДляЗаписи.ГодВыпуска = Тег.Значение; 	
		ИначеЕсли ИмяТега = "version" Тогда
			ОбъектДляЗаписи.Версия = Тег.Значение; 
		КонецЕсли;
	КонецЦикла;
	
	
	Возврат ОбъектДляЗаписи;
КонецФункции

// Функция загружает район из данных XML.
Функция ЗагрузитьРайонИзXML(Тег)
	
	Пока Тег.ПрочитатьАтрибут() Цикл
		Имя = НРег(Тег.Имя);
		Если Имя = "code" Тогда
			ОбъектДляЗаписи = Новый Структура("Код,Наименование,Описание");
			ОбъектДляЗаписи.Код = Тег.Значение;
		ИначеЕсли Имя = "name" Тогда
			ОбъектДляЗаписи.Наименование = Тег.Значение;	
		ИначеЕсли (Имя = "description") ИЛИ (Имя = "descr") Тогда
			ОбъектДляЗаписи.Описание = Тег.Значение;	
			ОбъектДляЗаписи = СМ_СметаВызовСервера.СоздатьНайтиЭлементСправочника("СМ_ТерриториальныеРайоны", ОбъектДляЗаписи.Код,Истина,ОбъектДляЗаписи);
		ИначеЕсли Имя = "father" Тогда
			// Не понятно для чего данный атрибут...	 возможно: "- Люк, я твой отец...", "- Неееет....". 			
		КонецЕсли;
	КонецЦикла;
	
	Возврат ОбъектДляЗаписи;
	
КонецФункции

