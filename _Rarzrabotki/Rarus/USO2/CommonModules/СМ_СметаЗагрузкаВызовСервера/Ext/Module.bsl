#Область ПрограммныйИнтерфейс

#Область ЗагрузкаПриПервомСтарте

// Загружает СНБ из общего макета НачЗаполнениеСметы.
//
// Параметры:
//     Принудительно - Булево	- если Истина - обновлять всегда, иначе - только при смене версии макета.
//
Процедура ЗагрузкаПриПервомСтарте(Принудительно = Ложь) Экспорт
	
	// ОТЛАЖЕНО.
	// Отвечает за закгрузку условно постоянной информации из макетов XML.
	// Без необходимости не править (используется совместно с макетами).
	// При правках вставлять комментарии.
	//
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ПолучитьОбщийМакет("СМ_НачЗаполнениеСметы").ПолучитьТекст() );
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если ЧтениеXML.Имя = "body" Тогда
				Если ПроверитьВерсиюНачЗаполнения(ЧтениеXML) И НЕ Принудительно Тогда
					// Ничего не делаем.
				КонецЕсли;	
			ИначеЕсли ЧтениеXML.Имя = "section" Тогда
				ОбъектДляЗаписи = ЗагрузитьРазделИзXML(ЧтениеXML);
			ИначеЕсли ЧтениеXML.Имя = "determinant" Тогда
				ОбъектДляЗаписи = ЗагрузитьОпределительИзXML(ЧтениеXML);
			ИначеЕсли ЧтениеXML.Имя = "chapters" Тогда
				ОбъектДляЗаписи = ЗагрузитьГлавыГруппыИзXML(ЧтениеXML);
			ИначеЕсли ЧтениеXML.Имя = "chapter" Тогда
				ОбъектДляЗаписиВнутр = ЗагрузитьГлавыИзXML(ЧтениеXML, ОбъектДляЗаписи);
			ИначеЕсли ЧтениеXML.Имя = "signs" Тогда
				ОбъектДляЗаписи = ЗагрузитьНормативыНРиСПГруппыИзXML(ЧтениеXML);
			ИначеЕсли ЧтениеXML.Имя = "sign" Тогда
				ОбъектДляЗаписиВнутр = ЗагрузитьНормативыНРиСПИзXML(ЧтениеXML, ОбъектДляЗаписи);
			ИначеЕсли ЧтениеXML.Имя = "area" Тогда
				ЗагрузитьТЧНормативыНРиСПИзXML(ЧтениеXML, ОбъектДляЗаписиВнутр);
			ИначеЕсли ЧтениеXML.Имя = "ItParam" Тогда
				ОбъектДляЗаписи = ЗагрузитьИтогиЧППоРазделуИзXML(ЧтениеXML);
			ИначеЕсли ЧтениеXML.Имя = "ItSection" Тогда
				ОбъектДляЗаписи = ЗагрузитьИтогиПоРазделуИзXML(ЧтениеXML);
			ИначеЕсли ЧтениеXML.Имя = "ItSmet" Тогда
				ОбъектДляЗаписи = ЗагрузитьИтогиПоСметеИзXML(ЧтениеXML);
			ИначеЕсли ЧтениеXML.Имя = "ItWork" Тогда
				ОбъектДляЗаписи = ЗагрузитьИтогиСметыПоВидамРаботИзXML(ЧтениеXML);
			ИначеЕсли ЧтениеXML.Имя = "Itchapter" Тогда
				ОбъектДляЗаписи = ЗагрузитьИтогиПоГлавамИзXML(ЧтениеXML);
			ИначеЕсли ЧтениеXML.Имя = "limit" Тогда
				ОбъектДляЗаписи = ЗагрузитьЛимитированныеЗатратыИзXML(ЧтениеXML);
			ИначеЕсли ЧтениеXML.Имя = "fixedmaps" Тогда
				// Для методики 1984.
				Табл = Новый ТаблицаЗначений();
				Табл.Колонки.Добавить("Определитель");
				Табл.Колонки.Добавить("ПравилоНачисленияНР");
				Табл.Колонки.Добавить("ЗначениеНРБазисноИндексное");
				Табл.Колонки.Добавить("ПравилоНачисленияСП");
			ИначеЕсли ЧтениеXML.Имя = "fixedmap" Тогда
				// Для методики 1984.
				ЗагрузитьСоответствия(ЧтениеXML,Табл);
			ИначеЕсли ЧтениеXML.Имя = "parameter" Тогда
				ОбъектДляЗаписи = ЗагрузитьЧисловыеПараметрыИзXML(ЧтениеXML);
			ИначеЕсли ЧтениеXML.Имя = "conditions" Тогда
				ОбъектДляЗаписи.УсловияПрименения.Очистить();
			ИначеЕсли ЧтениеXML.Имя = "condition" Тогда
				ЗагрузитьЧисловыеПараметрыУсловияПримененияИзXML(ЧтениеXML, ОбъектДляЗаписи);
			ИначеЕсли ЧтениеXML.Имя = "sources" Тогда
				ОбъектДляЗаписи.Источник.Очистить();
			ИначеЕсли ЧтениеXML.Имя = "source" Тогда
				ЗагрузитьЧисловыеПараметрыИсточникИзXML(ЧтениеXML, ОбъектДляЗаписи);
			ИначеЕсли ЧтениеXML.Имя = "receivers" Тогда
				ОбъектДляЗаписи.Приемник.Очистить();
			ИначеЕсли ЧтениеXML.Имя = "receiver" Тогда
				ЗагрузитьЧисловыеПараметрыПриемникИзXML(ЧтениеXML, ОбъектДляЗаписи);
			КонецЕсли;
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если ЧтениеXML.Имя = "section" Тогда
				ОбъектДляЗаписи.Записать();
			ИначеЕсли ЧтениеXML.Имя = "determinant" Тогда
				ОбъектДляЗаписи.Записать();
			ИначеЕсли ЧтениеXML.Имя = "chapters" Тогда
				ОбъектДляЗаписи.Записать();
			ИначеЕсли ЧтениеXML.Имя = "chapter" Тогда
				ОбъектДляЗаписиВнутр.Записать();
			ИначеЕсли ЧтениеXML.Имя = "signs" Тогда
				ОбъектДляЗаписи.Записать();
			ИначеЕсли ЧтениеXML.Имя = "sign" Тогда
				ОбъектДляЗаписиВнутр.Записать();
			ИначеЕсли ЧтениеXML.Имя = "area" Тогда
				// Ничего не делаем.
			ИначеЕсли ЧтениеXML.Имя = "ItParam" Тогда
				ОбъектДляЗаписи.Записать();
			ИначеЕсли ЧтениеXML.Имя = "ItSection" Тогда
				ОбъектДляЗаписи.Записать();
			ИначеЕсли ЧтениеXML.Имя = "ItSmet" Тогда
				ОбъектДляЗаписи.Записать();
			ИначеЕсли ЧтениеXML.Имя = "ItWork" Тогда
				ОбъектДляЗаписи.Записать();
			ИначеЕсли ЧтениеXML.Имя = "Itchapter" Тогда
				ОбъектДляЗаписи.Записать();
			ИначеЕсли ЧтениеXML.Имя = "limit" Тогда
				ОбъектДляЗаписи.Записать();
			ИначеЕсли ЧтениеXML.Имя = "fixedmaps" Тогда
				ЗаписатьРегистр(Табл);
			ИначеЕсли ЧтениеXML.Имя = "parameter" Тогда
				ОбъектДляЗаписи.Записать();
			ИначеЕсли ЧтениеXML.Имя = "condition" Тогда
				// Ничего не делаем.
			ИначеЕсли ЧтениеXML.Имя = "source" Тогда
				// Ничего не делаем.
			ИначеЕсли ЧтениеXML.Имя = "receiver" Тогда
				// Ничего не делаем.
			КонецЕсли;
			
		КонецЕсли; 
	КонецЦикла;    	

КонецПроцедуры

// Загружает СНБ Казахстана.
//
// Параметры:
//     Принудительно - Булево	- если Истина - обновлять всегда, иначе - только при смене версии макета.
//
Процедура КЗ_ЗагрузкаПриПервомСтарте(Принудительно = Ложь) Экспорт
	МассивЗон = Новый Массив;
	СНБ = Неопределено;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ПолучитьОбщийМакет("СМ_КЗ_Районы").ПолучитьТекст());
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			Если ВРег(ЧтениеXML.Имя) = "РЕГИОН" Тогда
				
				ОбъектДляЗаписи = Новый Структура("Код,Наименование");
				
				Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
					
					Имя = ЧтениеXML.Имя;
					Значение = ЧтениеXML.Значение;
					Если Имя = "КОД_РЕГИОНА" Тогда
						ОбъектДляЗаписи.Код = Значение;
					ИначеЕсли Имя = "НАИМЕНОВАНИЕ" Тогда
						ОбъектДляЗаписи.Наименование = Значение;
					КонецЕсли;
					
				КонецЦикла;
				
				СНБ = СМ_СметаВызовСервера.СоздатьНайтиЭлементСправочника("СМ_СметноНормативныеБазы", ОбъектДляЗаписи.Код, Истина, ОбъектДляЗаписи);
				
			ИначеЕсли ВРег(ЧтениеXML.Имя) = "РАЙОН" Тогда
				ОбъектДляЗаписи = Новый Структура("Код,Наименование");
				
				Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
					
					Имя = ЧтениеXML.Имя;
					Значение = ЧтениеXML.Значение;
					Если Имя = "КОД_РАЙОНА" Тогда
						ОбъектДляЗаписи.Код = Значение;
					ИначеЕсли Имя = "НАИМЕНОВАНИЕ" Тогда
						ОбъектДляЗаписи.Наименование = Значение;
					КонецЕсли;
					
				КонецЦикла;
				
				Район = СМ_СметаВызовСервера.СоздатьНайтиЭлементСправочника("СМ_ТерриториальныеРайоны", ОбъектДляЗаписи.Код, Истина, ОбъектДляЗаписи);
				МассивЗон.Добавить(Район);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивЗон.Количество()>0 И Не СНБ = Неопределено Тогда
		ДобавитьРайоныВСНБ(СНБ, МассивЗон);
	КонецЕсли;

КонецПроцедуры

// Установка реквизита Тип у справочника ВидыКонтактнойИнформации при первом запуске.
Процедура ЗаполнитьТипВидыКонтактнойИнформацииПервомСтарте() Экспорт
	Выборка = Справочники.ВидыКонтактнойИнформации.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЭтоГруппа ИЛИ Не Выборка.Предопределенный Тогда
			Продолжить;
		КонецЕсли;
		ВидКонтакта =  Выборка.Ссылка.ПолучитьОбъект();
		Если  Найти(ВРег(Выборка.ИмяПредопределенныхДанных),ВРег("Адрес"))>0 Тогда
			ВидКонтакта.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
		ИначеЕсли  Найти(ВРег(Выборка.ИмяПредопределенныхДанных),ВРег("Телефон"))>0 Тогда
			ВидКонтакта.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
		ИначеЕсли  Найти(ВРег(Выборка.ИмяПредопределенныхДанных),ВРег("Факс"))>0 Тогда
			ВидКонтакта.Тип = Перечисления.ТипыКонтактнойИнформации.Факс;
		ИначеЕсли  Найти(ВРег(Выборка.ИмяПредопределенныхДанных),ВРег("Email"))>0 Тогда
			ВидКонтакта.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		Иначе
			ВидКонтакта.Тип = Перечисления.ТипыКонтактнойИнформации.Другое;
		КонецЕсли;
		ВидКонтакта.Записать();
	КонецЦикла;
КонецПроцедуры

// Записывает в регистр сведений Соответствие определителя и расчета.
// НР для методики1984 из таблицы.
//
// Параметры:
//     Табл - ТаблицаЗначений - таблица с данными для записи в регистр. 
//
Процедура ЗаписатьРегистр(Табл)Экспорт
	
	НаборЗаписей = РегистрыСведений.СМ_СоответствияОпределителяиНРдляМетодики1984.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	
	ТаблЗагрузки = НаборЗаписей.Выгрузить();
	НаборЗаписей.Очистить();
	Для каждого СтрокаТабл Из Табл Цикл
		НаборЗаписей.Отбор.Определитель.Значение = СтрокаТабл.Определитель.Ссылка;
		Запись = НаборЗаписей.Добавить();
		Запись.Определитель = СтрокаТабл.Определитель.Ссылка;
		СписокПолей = "ПравилоНачисленияНР,ПравилоНачисленияСП,ЗначениеНРБазисноИндексное";
		ЗаполнитьЗначенияСвойств(Запись, СтрокаТабл, СписокПолей);
	КонецЦикла;
	НаборЗаписей.Записать(Истина);

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеСправочниковИзВНБ

// Обновляет поправки в справочнике.
//
// Параметры:
//     СНБ 					-  СправочникСсылка.СМ_СметноНормативныеБазы - сметно-нормативная база.
//     ДанныеДляОбновления 	-  Строка - содержит данные из ВНБ в формате XML.
//     ФорматДанных 		-  Число - версия внешней нормативной базы.
//
Процедура ОбновитьПоправки(СНБ, ДанныеДляОбновления, ФорматДанных = 1) Экспорт
	
	// Отвечает за загрузку справочника Поправок из ВНБ.

	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	
	// Очищаем.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоправкиПоТехническимЧастям.Ссылка
	               |ИЗ
	               |	Справочник.СМ_ПоправкиПоТехническимЧастям КАК ПоправкиПоТехническимЧастям
	               |ГДЕ
	               |	ПоправкиПоТехническимЧастям.СметноНормативнаяБаза = &СметноНормативнаяБаза
	               |	И ПоправкиПоТехническимЧастям.ЭтоГруппа = ЛОЖЬ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПоправкиПоТехническимЧастям.Ссылка";
	
	Запрос.УстановитьПараметр("СметноНормативнаяБаза", СНБ.Ссылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		ВыборкаОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ВыборкаОбъект.Удалить();    		
	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоправкиПоТехническимЧастям.Ссылка
	               |ИЗ
	               |	Справочник.СМ_ПоправкиПоТехническимЧастям КАК ПоправкиПоТехническимЧастям
	               |ГДЕ
	               |	ПоправкиПоТехническимЧастям.СметноНормативнаяБаза = &СметноНормативнаяБаза
	               |	И ПоправкиПоТехническимЧастям.ЭтоГруппа = ИСТИНА
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПоправкиПоТехническимЧастям.Ссылка";
	
	Запрос.УстановитьПараметр("СметноНормативнаяБаза", СНБ.Ссылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		ВыборкаОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Попытка
			ВыборкаОбъект.Удалить(); 
		Исключение
			Событие = НСтр("ru = 'Исключение Смета обработчики загрузки (вызов сервера)'");
			СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
		КонецПопытки;
	
	КонецЦикла;
	
	УровеньБазы = ОпределитьУровеньСНБ(СНБ.Наименование,СНБ.Код);
	БазаМТСН = ?(УровеньБазы = Перечисления.СМ_УровниБазы.ТерриториальныйМосква, Истина, Ложь);
	
	ТаблицаГрупп = Новый ТаблицаЗначений();
	ТаблицаГрупп.Колонки.Добавить("Ссылка");
	ТаблицаГрупп.Колонки.Добавить("Код");
	ТаблицаГрупп.Колонки.Добавить("Глава");
	ТаблицаГрупп.Колонки.Добавить("НомерСборника");
	
	ТаблицаДанных = Новый ТаблицаЗначений();
	ТаблицаДанных.Колонки.Добавить("Ссылка");
	ТаблицаДанных.Колонки.Добавить("Код");
	ТаблицаДанных.Колонки.Добавить("Глава");
	ТаблицаДанных.Колонки.Добавить("НомерСборника");
	ТаблицаДанных.Колонки.Добавить("ТипНормативногоСборника");
	ТаблицаДанных.Колонки.Добавить("Родитель");
	ТаблицаДанных.Колонки.Добавить("Наименование");
	Если БазаМТСН = Ложь Тогда
		ВыборкаОбъект = Справочники.СМ_ПоправкиПоТехническимЧастям.СоздатьГруппу();
		ВыборкаОбъект.Наименование = СНБ.Наименование;
		ВыборкаОбъект.СметноНормативнаяБаза = СНБ;
		ВыборкаОбъект.УстановитьНовыйКод();
		ВыборкаОбъект.Записать();	
		
		СтрокаГрупп = ТаблицаГрупп.Добавить();
		СтрокаГрупп.Ссылка = ВыборкаОбъект.Ссылка;
		СтрокаГрупп.Код = ВыборкаОбъект.Код;
	КонецЕсли;
	Если БазаМТСН Тогда
		// Создание оглавления Базы.
		ЧтениеXML = Новый ЧтениеXML;
		МакетЗаполнения = Справочники.СМ_СметноНормативныеБазы.ПолучитьМакет("СтруктураТСН");
		ЧтениеXML.УстановитьСтроку(МакетЗаполнения.ПолучитьТекст() );
		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				Если ЧтениеXML.Имя = "base" Или ЧтениеXML.Имя = "bases"Тогда
					Если ТаблицаДанных.Количество() <> 0 Тогда
						ВыборкаОбъект = Справочники.СМ_ПоправкиПоТехническимЧастям.СоздатьГруппу();
						СтрокаДанных = ТаблицаДанных[0];
						ВыборкаОбъект.Наименование = СтрокаДанных.Наименование;
						ВыборкаОбъект.СметноНормативнаяБаза = СНБ;
						ВыборкаОбъект.НомерСборника = СтрокаДанных.НомерСборника;
						ВыборкаОбъект.ТипНормативногоСборника = СтрокаДанных.ТипНормативногоСборника;
						ВыборкаОбъект.УстановитьНовыйКод();
						ВыборкаОбъект.Родитель = СтрокаДанных.Родитель;
						ВыборкаОбъект.Записать();	
						СтрокаГрупп = ТаблицаГрупп.Добавить();
						СтрокаГрупп.Ссылка = ВыборкаОбъект.Ссылка; 
						СтрокаГрупп.Код = СтрокаДанных.Код; 
						СтрокаГрупп.Глава = СтрокаДанных.Глава; 
						СтрокаГрупп.НомерСборника = СтрокаДанных.НомерСборника; 
						ТаблицаДанных.Очистить();
					КонецЕсли;	
					
					ЗаполнитьДанныеГруппыТСН(ЧтениеXML,ТаблицаДанных,ТаблицаГрупп);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
	Иначе
		СтрокаГрупп = ТаблицаГрупп.Добавить();
		СтрокаГрупп.Ссылка = ВыборкаОбъект.Ссылка;
		СтрокаГрупп.Код = ВыборкаОбъект.Код;
	КонецЕсли;	
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ДанныеДляОбновления);
	
	КоличествоОбработано = 0;
	
	Пока ЧтениеXML.Прочитать() Цикл
		Имя = НРег(ЧтениеXML.Имя);
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			Если (Имя = "ajustment")ИЛИ(Имя = "poprav") Тогда
				ОбъектДляЗаписи = ЗагрузитьПоправкиИзXML(ЧтениеXML, ТаблицаГрупп, ФорматДанных,БазаМТСН);

				КоличествоОбработано = КоличествоОбработано +1;	
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если (Имя = "ajustment")ИЛИ(Имя = "poprav") Тогда
				Если ОбъектДляЗаписи.Родитель.ССылка.Пустая() = Ложь Тогда
					ОбъектДляЗаписи.СметноНормативнаяБаза 	= СНБ.Ссылка;
					ОбъектДляЗаписи.Записать();
					Если Не БазаМТСН Тогда
						СтрокаГрупп = ТаблицаГрупп.Добавить();
						СтрокаГрупп.Ссылка = ОбъектДляЗаписи.Ссылка;
						СтрокаГрупп.Код = ОбъектДляЗаписи.Код;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли; 
	КонецЦикла;
	//
	ЗафиксироватьТранзакцию();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Заполняет данные для групп базы ТСН.
//
// Параметры:
//     Тег  - Строка с данными из макета "СтруктураТСН"	СправочникСсылка.СМ_СметноНормативныеБазы в формате XML.
//     ТаблицаДанных - 	таблица с данными для формирования таблицы групп.
//     ТаблицаГрупп - таблица сформированных групп.
//
Процедура ЗаполнитьДанныеГруппыТСН(Тег,ТаблицаДанных,ТаблицаГрупп)
	Пока Тег.ПрочитатьАтрибут() Цикл
		
		ТегИмя = НРег(Тег.Имя);
		Если ТегИмя = "id" Тогда
			Код =  Тег.Значение;
		ИначеЕсли ТегИмя = "father" Тогда
			ИДОтца = Тег.Значение;
		ИначеЕсли ТегИмя = "name" Тогда
			Наименование = Тег.Значение;
		ИначеЕсли ТегИмя = "code" Тогда
			ШифрСборника = Тег.Значение;
		КонецЕсли;
	КонецЦикла;	
	Глава = "";
	ТипНормативногоСборника = Неопределено;
	Если ШифрСборника = "" Тогда
		ПозицияГлавы = Найти(Наименование,"ТСН-2001.");
		Если ПозицияГлавы <> 0 Тогда
			СтрокаГлавы = Сред(Наименование,ПозицияГлавы + СтрДлина("ТСН-2001.") );
			ПозСкобки = Найти(СтрокаГлавы,")");
			Если ПозСкобки <> 0 Тогда
				Глава = Сред(СтрокаГлавы,1,(ПозСкобки - 1)) + ".";
				ШифрСборника =  Глава;

			КонецЕсли;	
		КонецЕсли;	
	Иначе 
		Глава = НайтиГлавуВШифре(ШифрСборника, Истина);
		
	КонецЕсли;
	Если ШифрСборника <> ""  Тогда
		НомерСборника = ШифрСборника;
		ТипНормативногоСборника = ОпределитьТипНормСборникаПоШифру(НомерСборника,Истина);
		НомерСборника = ШифрСборника;
		НомерСборника = СМ_СметаВызовСервера.ОпределитьНомерСборника(ТипНормативногоСборника,НомерСборника,Истина);
	Иначе
		НомерСборника = 0;
	КонецЕсли;
	Родитель = Неопределено;
	Отбор = Новый Структура();
	Отбор.Вставить("Код",ИДОтца);
	РодительГруппа = ТаблицаГрупп.НайтиСтроки(Отбор);
	Если РодительГруппа.Количество() <> 0 Тогда
		Родитель = РодительГруппа[0].Ссылка;
	КонецЕсли;
	
	СтрокаДанных = ТаблицаДанных.Добавить();
	СтрокаДанных.Родитель  = Родитель;
	СтрокаДанных.Код = Код;
	СтрокаДанных.Наименование  = Наименование;
	СтрокаДанных.ТипНормативногоСборника = ТипНормативногоСборника;
	СтрокаДанных.НомерСборника = НомерСборника;
	СтрокаДанных.Глава = Глава;
	
КонецПроцедуры

// Обновляет ресурсы в справочнике.
