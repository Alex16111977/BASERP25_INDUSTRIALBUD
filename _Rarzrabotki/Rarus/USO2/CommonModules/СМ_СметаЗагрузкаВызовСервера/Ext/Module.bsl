// Процедура проверяет версию СНБ при начальном заполнеии.
//
Функция ПроверитьВерсиюНачЗаполнения(ЧтениеXML)
	
	// ОТЛАЖЕНО.
	// Отвечает за проыерку версии СНБ на соовтетсвтие ВНБ.

	Версия = ЧтениеXML.ПолучитьАтрибут("Ver");
	Если Версия = Константы.СМ_ВерсияНачЗаполнения.Получить() Тогда
		Возврат Истина;
	Иначе
		Константы.СМ_ВерсияНачЗаполнения.Установить(Версия);
		Возврат Ложь;
	КонецЕсли;
КонецФункции

