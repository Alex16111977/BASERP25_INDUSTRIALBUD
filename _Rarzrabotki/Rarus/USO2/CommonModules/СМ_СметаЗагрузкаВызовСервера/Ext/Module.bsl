				ОбъектДляЗаписи = Справочники.СМ_ИтогиПоРазделу.СоздатьЭлемент();
			Иначе 
				ОбъектДляЗаписи = ОбъектДляЗаписи.ПолучитьОбъект();
				ОбъектДляЗаписи.ИмяПредопределенныхДанных = Тег.Значение;
			КонецЕсли;  
			ОбъектДляЗаписи.Идентификатор = Тег.Значение; 	
			ОбъектДляЗаписи.Код = Код;
		ИначеЕсли Тег.Имя = "flagr" Тогда
			ОбъектДляЗаписи.Расшифровка = Булево(Тег.Значение); 	
		ИначеЕсли Тег.Имя = "flagn" Тогда
			ОбъектДляЗаписи.Накопительный = Булево(Тег.Значение); 	
		ИначеЕсли Тег.Имя = "number" Тогда
			ОбъектДляЗаписи.ПорядковыйНомер = Число(Тег.Значение); 	
		КонецЕсли;
	КонецЦикла;
	
	Возврат ОбъектДляЗаписи;
	
