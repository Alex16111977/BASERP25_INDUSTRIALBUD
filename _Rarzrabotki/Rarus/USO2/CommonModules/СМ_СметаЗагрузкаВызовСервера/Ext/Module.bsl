#Область ПодборПозицийИзВНБ 

// Загружает данные в позицию ЛС из ВНБ.
//
// Параметры:
//     Данные 			- Строка - содержит данные из ВНБ в формате XML.
//     ПозицияЛС 		- ДокументСсылка.СМ_ПозицияЛокальнойСметы -	документ, в который загружаем данные.
//     ПараметрыСметы 	- Структура - содержит данные о смете.
//     ВерсияКомпоненты - Число	- версия внешней нормативной базы.
//
Процедура ЗагрузитьДанныеВПозициюЛС(Данные, ПозицияЛС, ПараметрыСметы, ВерсияКомпоненты = 1) Экспорт 
		
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Данные);
	
	ТипРасценки = "БазисныеЦены";
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если (ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента)ИЛИ(ЧтениеXML.ТипУзла = ТипУзлаXML.Текст) Тогда
			Имя = НРег(ЧтениеXML.Имя);
			Если Имя = "collection" Тогда
				ЗаполнитьНСПозицииЛСИзXML(ЧтениеXML,ПозицияЛС);
			ИначеЕсли Имя = "norm" Тогда
				ЗаполнитьРасценкиПозицииЛСИзXML(ЧтениеXML,ПозицияЛС, ТипРасценки, ПараметрыСметы.МетодикаТСН);
			ИначеЕсли (Имя = "price") Тогда
				ЗаполнитьСтоимостиПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,ВерсияКомпоненты);
			ИначеЕсли Имя = "resource" Тогда
				ЗаполнитьРеcурсыПозицииЛСИзXML(ЧтениеXML,ПозицияЛС, ПараметрыСметы, ВерсияКомпоненты);
			ИначеЕсли Имя = "work" Тогда
				ЗаполнитьРаботыПозицииЛСИзXML(ЧтениеXML,ПозицияЛС);
			ИначеЕсли Имя = "volume" Тогда
				ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"ОбъемРабот");
			ИначеЕсли Имя = "formula" Тогда
				ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"ФормулаОбъема");
			ИначеЕсли Имя = "pz" Тогда
				Если ТипРасценки = "БазисныеЦены" Тогда
					ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"ПрямЗатраты");
				Иначе
					ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"ТекущаяЦена");
				КонецЕсли;
			ИначеЕсли Имя = "zpr" Тогда
				Если ТипРасценки = "БазисныеЦены" Тогда
					ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"ОснЗарплата");
				ИначеЕсли ПозицияЛС.ТипНормативныхСборников <> Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы Тогда
					ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"ТекущаяЗарплатаМашинистов");
				Иначе
					ПозицияЛС.ТекущаяЗарплатаМашинистов = 0;
				КонецЕсли;
			ИначеЕсли Имя = "mm" Тогда
				Если ТипРасценки = "БазисныеЦены" Тогда
					ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"ЭксплМашин");
				ИначеЕсли ПозицияЛС.ТипНормативныхСборников <> Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы Тогда
					ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"ТекущаяЦена");
				КонецЕсли;
			ИначеЕсли Имя = "zpmm" Тогда
				Если ТипРасценки = "БазисныеЦены" Тогда
					ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"ЗарплМашинистов");
				ИначеЕсли ПозицияЛС.ТипНормативныхСборников <> Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы Тогда
					ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"ТекущаяЗарплатаМашинистов");
				Иначе
					ПозицияЛС.ТекущаяЗарплатаМашинистов = 0;
				КонецЕсли;
			ИначеЕсли Имя = "smat" Тогда
				Если ТипРасценки = "БазисныеЦены" Тогда
					ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"СтоимМатериалов");
				Иначе
					ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"ТекущаяЦена");
				КонецЕсли;
			ИначеЕсли Имя = "vmat" Тогда
				ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"ВозвратМатер");
			КонецЕсли;
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
		
		КонецЕсли; 
	КонецЦикла;
		
КонецПроцедуры

// Определяет выбраны ли данные из ВНБ.
//
// Параметры:
//     Данные - Строка - содержит данные из ВНБ в формате XML.
//
// Возвращаемое значение:
//     Результат - Булево - есть или нет данные.
//
Функция ЕстьДанные(Данные) Экспорт
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Данные);
	Результат = Ложь;	
	Пока ЧтениеXML.Прочитать() Цикл
		Если (ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента)ИЛИ(ЧтениеXML.ТипУзла = ТипУзлаXML.Текст) Тогда
			Имя = НРег(ЧтениеXML.Имя);
			Если Имя = "norm" Тогда
				Результат = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат(Результат);
КонецФункции	

#КонецОбласти

#Область ВспомогательныеПроцедурыИФункции

// Устанавливает наименование методики.
//
// Параметры:
//     Итог 			- СправочникСсылка.СМ_ИтогиПоСмете - ссылка на итог.
//     СведенияОбИтоге 	- Структура - содержит данные для заполнения регистра использования итогов.
//
Процедура ЗаполнитьДанныеПоМетодике(Итог, СведенияОбИтоге) Экспорт
	
	Менеджер = РегистрыСведений.СМ_ИспользованиеИтоговПоСмете.СоздатьМенеджерЗаписи();
	
	Менеджер.Используется = СведенияОбИтоге.Используется;
	Менеджер.Методика = СведенияОбИтоге.Методика;
	Менеджер.Итог = Итог;
	Менеджер.Представление = СведенияОбИтоге.Наименование; // TO DO: Обойтись без этого поля.
	Менеджер.Накопительный = СведенияОбИтоге.Накопительный; // TO DO: Обойтись без этого поля.
	
