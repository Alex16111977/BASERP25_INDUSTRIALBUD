	ОбъектДляЗаписи = Справочники.СМ_ГлавыССРС.ПустаяСсылка();
	
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Имя = "code" Тогда
			ОбъектДляЗаписи = Справочники.СМ_ГлавыССРС.НайтиПоКоду(Тег.Значение);
			Если ОбъектДляЗаписи = Справочники.СМ_ГлавыССРС.ПустаяСсылка() Тогда
				ОбъектДляЗаписи = Справочники.СМ_ГлавыССРС.СоздатьЭлемент();
			Иначе 
				Если ОбъектДляЗаписи.ЭтоГруппа Тогда
