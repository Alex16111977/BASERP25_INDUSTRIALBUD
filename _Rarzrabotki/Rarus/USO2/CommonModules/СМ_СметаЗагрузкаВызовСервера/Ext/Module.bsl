// Функция загружает числовые параметры из XML.
//	Тег - типа ЧтениеXML.
//
Функция ЗагрузитьЧисловыеПараметрыИзXML(Тег) Экспорт
	
	ОбъектДляЗаписи = Справочники.СМ_ЧисловыеПараметры.ПустаяСсылка();
	НовыйЭлемент = Ложь;
	
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
			Продолжить;
		КонецЕсли;
		Если Тег.Имя = "code" Тогда
			ОбъектДляЗаписи = Справочники.СМ_ЧисловыеПараметры.НайтиПоКоду(Тег.Значение);
			Если ОбъектДляЗаписи = Справочники.СМ_ЧисловыеПараметры.ПустаяСсылка() Тогда
				ОбъектДляЗаписи = Справочники.СМ_ЧисловыеПараметры.СоздатьЭлемент();
				НовыйЭлемент = Истина;
			Иначе 
				ОбъектДляЗаписи = ОбъектДляЗаписи.ПолучитьОбъект();
			КонецЕсли;
			ОбъектДляЗаписи.Код = Число(Тег.Значение);
			// Для методики 1984.
			ОбъектДляЗаписи.Методика1984 = Ложь;
		ИначеЕсли Тег.Имя = "name" Тогда
			ОбъектДляЗаписи.Наименование = Тег.Значение; 	
		ИначеЕсли Тег.Имя = "ID" Тогда
			ОбъектДляЗаписи.Идентификатор = Тег.Значение; 	
		ИначеЕсли Тег.Имя = "Value" Тогда
			ОбъектДляЗаписи.ЗначениеПоУмолчанию = Число(Тег.Значение); 	
		ИначеЕсли Тег.Имя = "Standard" Тогда
			ОбъектДляЗаписи.СтандартноеЗначение = Число(Тег.Значение); 	
		ИначеЕсли Тег.Имя = "Type_value" Тогда
			ОбъектДляЗаписи.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров[Тег.Значение]; 	
		ИначеЕсли Тег.Имя = "Order" Тогда
			ОбъектДляЗаписи.ПорядокРасчета = Число(Тег.Значение); 
		ИначеЕсли Тег.Имя = "Priznak84" Тогда
			ОбъектДляЗаписи.Методика1984 = Тег.Значение; 
		ИначеЕсли Тег.Имя = "method" Тогда
			МассивМетодик = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Тег.Значение,",");
			Если НовыйЭлемент Тогда
				ОбъектДляЗаписи.Записать();
			КонецЕсли;
			НаборЗаписей = РегистрыСведений.СМ_ИспользованиеЧисловыхПараметров.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ЧисловойПараметр.Установить(ОбъектДляЗаписи.Ссылка);
			Если Не НовыйЭлемент Тогда
				НаборЗаписей.Прочитать();
				ТаблицаЗначений = НаборЗаписей.Выгрузить();
				Для Каждого ЭлМассива Из МассивМетодик Цикл
					Отбор = Новый Структура();
					Отбор.Вставить("Методика", Справочники.СМ_МетодикиРасчета[ЭлМассива]);
					МассивСтрок = ТаблицаЗначений.НайтиСтроки(Отбор);
					Если МассивСтрок.Количество() = 0 Тогда
						Запись = ТаблицаЗначений.Добавить();
					Иначе
						Запись = МассивСтрок[0];
					КонецЕсли;
					Запись.Методика = Справочники.СМ_МетодикиРасчета[ЭлМассива];
					Запись.ЧисловойПараметр = ОбъектДляЗаписи.Ссылка;
					Запись.Используется = Истина;
				КонецЦикла; 
				НаборЗаписей.Загрузить(ТаблицаЗначений);
				НаборЗаписей.Записать(Истина);
			Иначе
				Для Каждого ЭлМассива Из МассивМетодик Цикл
					Запись = НаборЗаписей.Добавить();
					Запись.Методика = Справочники.СМ_МетодикиРасчета[ЭлМассива];
					Запись.ЧисловойПараметр = ОбъектДляЗаписи.Ссылка;
					Запись.Используется = Истина;
				КонецЦикла;			
				НаборЗаписей.Записать(Истина);
			КонецЕсли;		
		КонецЕсли;
	КонецЦикла;
	
	Возврат ОбъектДляЗаписи;
	
КонецФункции

// Функция загружает числовые параметры условия применения из XML.
//	Тег - типа ЧтениеXML.
//
Функция ЗагрузитьЧисловыеПараметрыУсловияПримененияИзXML(Тег, Объект)
	
	НоваяСтрокаТЧ = Объект.УсловияПрименения.Добавить();
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
			Продолжить;
		КонецЕсли;
		Если Тег.Имя = "type_rate" Тогда
			НоваяСтрокаТЧ.ВидРасценки = Перечисления.СМ_ВидыРасценки[Тег.Значение];
		ИначеЕсли Тег.Имя = "type_work" Тогда
			НоваяСтрокаТЧ.ВидРабот = Перечисления.СМ_ВидыЗатратСмета[Тег.Значение]; 	
		ИначеЕсли Тег.Имя = "typens" Тогда
			НоваяСтрокаТЧ.ТипНормативногоСборника = Перечисления.СМ_ТипыНормативныхСборников[Тег.Значение]; 	
		ИначеЕсли Тег.Имя = "Number" Тогда
			НоваяСтрокаТЧ.НомерНормативногоСборника = Число(Тег.Значение); 	
		ИначеЕсли Тег.Имя = "Without" Тогда
			НоваяСтрокаТЧ.КромеНомераНормативногоСборника = Число(Тег.Значение); 	
		КонецЕсли;
	КонецЦикла;
	
КонецФункции 

