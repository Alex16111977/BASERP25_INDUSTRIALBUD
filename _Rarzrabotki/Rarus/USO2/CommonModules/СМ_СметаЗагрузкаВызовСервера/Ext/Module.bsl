// Функция загружает итоги по смете из XML.
//	Тег - типа ЧтениеXML.
//
Функция ЗагрузитьИтогиПоСметеИзXML(Тег) Экспорт
	
	ОбъектДляЗаписи = Новый Структура();
	ОбъектДляЗаписи.Вставить("Код",0);
	ОбъектДляЗаписи.Вставить("Наименование","");
	ОбъектДляЗаписи.Вставить("Идентификатор","");
	ОбъектДляЗаписи.Вставить("Накопительный",Ложь);
	ОбъектДляЗаписи.Вставить("ПорядковыйНомер",0);
	ОбъектДляЗаписи.Вставить("Используется",Ложь);
	ОбъектДляЗаписи.Вставить("Методика",Справочники.СМ_МетодикиРасчета.СМ_МетодикаМДС35);

	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Имя = "code" Тогда
			ОбъектДляЗаписи.Код = Число(Тег.Значение);
		ИначеЕсли Тег.Имя = "name" Тогда
			ОбъектДляЗаписи.Наименование = Тег.Значение; 	
		ИначеЕсли Тег.Имя = "ID" Тогда
			ОбъектДляЗаписи.Идентификатор = Тег.Значение; 	
		ИначеЕсли Тег.Имя = "flagn" Тогда
			ОбъектДляЗаписи.Накопительный = Булево(Тег.Значение); 	
		ИначеЕсли Тег.Имя = "number" Тогда
			ОбъектДляЗаписи.ПорядковыйНомер = Число(Тег.Значение); 	
		ИначеЕсли Тег.Имя = "flaguse" Тогда
			ОбъектДляЗаписи.Используется = Булево(Тег.Значение);
		ИначеЕсли Тег.Имя = "method" Тогда
			ОбъектДляЗаписи.Методика = Справочники.СМ_МетодикиРасчета[Тег.Значение];
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ОбъектДляЗаписи.Код) Тогда
		Возврат Справочники.СМ_ИтогиПоСмете.ПустаяСсылка();
	КонецЕсли;
	
	ОбъектСсылка = Справочники.СМ_ИтогиПоСмете[ОбъектДляЗаписи.Идентификатор];
	
	Если Не ЗначениеЗаполнено(ОбъектСсылка) Тогда
		ОбъектСправочника = Справочники.СМ_ИтогиПоСмете.СоздатьЭлемент();
		ОбъектСправочника.ИмяПредопределенныхДанных = ОбъектДляЗаписи.Идентификатор;
	Иначе 
		ОбъектСправочника = ОбъектСсылка.ПолучитьОбъект()
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОбъектСправочника, ОбъектДляЗаписи, , "Наименование");
	
	Если ЗначениеЗаполнено(ОбъектДляЗаписи.Наименование) Тогда
		ОбъектСправочника.Наименование = ОбъектДляЗаписи.Наименование;
	КонецЕсли;
	
	ОбъектСправочника.Записать();
	
	ЗаполнитьДанныеПоМетодике(ОбъектСправочника.Ссылка, ОбъектДляЗаписи);     
	
	Возврат ОбъектСправочника;
	
КонецФункции

