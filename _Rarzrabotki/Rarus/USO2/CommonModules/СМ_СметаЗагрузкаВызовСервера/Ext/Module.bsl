	Иначе 
		ОбъектДляЗаписи = ОбъектДляЗаписи.ПолучитьОбъект();
	КонецЕсли;
	ОбъектДляЗаписи.Код = Число(Тег.ПолучитьАтрибут("code"));
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Имя = "code" Тогда
		ИначеЕсли Тег.Имя = "name" Тогда
			ОбъектДляЗаписи.Наименование = Тег.Значение; 	
		ИначеЕсли Тег.Имя = "type" Тогда
			ОбъектДляЗаписи.ТипСтроительства = Перечисления.СМ_ТипыСтроительства[Тег.Значение]; 	
