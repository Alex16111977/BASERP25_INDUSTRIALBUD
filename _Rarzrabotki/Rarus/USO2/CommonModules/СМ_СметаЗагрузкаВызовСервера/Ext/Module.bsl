	//
КонецПроцедуры

// Обновляет единицы измерения из ВНБ
//
// Параметры:
//     ДанныеДляОбновления - Строка - содержит данные из ВНБ в формате XML.
//
Процедура ОбновитьЕдиницыИзмерения(ДанныеДляОбновления) Экспорт
	
	Если ДанныеДляОбновления = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ДанныеДляОбновления);
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Имя = НРег(ЧтениеXML.Имя);
			Если (Имя = "ej") ИЛИ (Имя = "unit") Тогда
