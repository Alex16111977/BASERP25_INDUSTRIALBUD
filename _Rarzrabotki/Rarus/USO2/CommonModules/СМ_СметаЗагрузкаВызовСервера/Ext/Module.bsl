// Готовит информацию о позициях для выборки индексов в разрезе ТипСборника, списокШифров,
// Район, Нормативная база.
// ВАЖНО: Позиция уже должна быть в базе.
//
// Параметры:
//     МассивПозиций 				- Массив - содержит ссылки на позиции.
//     СтруктураПараметровРасчетаЛС - Структура - содержит данные о смете (полученна методом 
//                                    ПолучитьСтруктуруПараметровРасчетаЛС()).
//     СтруктураНовыхДанных 		- Структура - с данными обновления индексов по другой базе, содержит поля: 
//										* КодРайона	- Строка - код района индексов.
//										* СборникКоэффициентов - Строка	- ид другого сборника.
//										* КодРегиональнойБазы - Строка - код базы для обновления индексов. 
//
// Возвращаемое значение:
//     Массив - Массив - содержит структуры с полями:
//			* ШифрыРасценки				- Строка - Шифры расценок через запятую в рамках остальных группировок.
//			* КодРайона             	- Строка - Код района для обращения в ВНБ.
//			* КодРегиональнойБазы   	- Строка - Код СНБ для обращения в ВНБ.
//			* СборникКоэффициентов  	- Строка - Имя базы сборника коэффицентов.
//			* ТипНормативногоСборника 	- Строка - Тип нормативного сборника для обращения к ВНБ.
//
Функция ПолучитьТаблицуПозицийДляИндексовПересчета(МассивПозиций, СтруктураПараметровРасчетаЛС = Неопределено, СтруктураНовыхДанных = Неопределено) Экспорт
	
	Массив = Новый Массив;
	
	Если СтруктураНовыхДанных = Неопределено Тогда
		СтруктураНовыхДанных = Новый Структура();
	КонецЕсли;
	
	Если МассивПозиций.Количество() = 0 Тогда
		Структура = Новый Структура("ШифрыРасценки, КодРайона, КодРегиональнойБазы, СборникКоэффициентов, ТипНормативногоСборника");
		Массив.Добавить(Структура);
		Возврат Массив;
	КонецЕсли;
	
	Если (СтруктураПараметровРасчетаЛС = Неопределено) Тогда
		СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(,МассивПозиций[0]);
	КонецЕсли;
	
	ТаблицаСведений = Новый ТаблицаЗначений();
	ТаблицаСведений.Колонки.Добавить("ШифрыРасценки");
	ТаблицаСведений.Колонки.Добавить("КодРайона");
	ТаблицаСведений.Колонки.Добавить("КодРегиональнойБазы");
	ТаблицаСведений.Колонки.Добавить("СборникКоэффициентов");
	ТаблицаСведений.Колонки.Добавить("ТипНормативногоСборника");
	
	Для Каждого Позиция Из МассивПозиций Цикл
		// ДокторСофт.
		Если НЕ СтруктураПараметровРасчетаЛС.ПрименятьИндексыКоВсемБазам Тогда
			Если Позиция.РегиональнаяБаза.Код <> СтруктураПараметровРасчетаЛС.КодРегионаФайлаИндексовПересчета Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;	
		// ДокторСофт.
		
		ТипНормативногоСборника = ОпределитьКодТипаСборника(Позиция.ТипНормативныхСборников);
		Если (ТипНормативногоСборника = Неопределено) Тогда
			ТипНормативногоСборника = "CN";
		КонецЕсли;

		КодРегиональнойБазы = "";
		Если Не СтруктураНовыхДанных.Свойство("КодРегиональнойБазы", КодРегиональнойБазы) Тогда
			КодРегиональнойБазы = Позиция.РегиональнаяБаза.Код;
		КонецЕсли;
		Если КодРегиональнойБазы = "" Тогда
			КодРегиональнойБазы = Справочники.СМ_СметноНормативныеБазы.ПолучитьПоУмолчанию().Код;
		КонецЕсли;
		КодРайона = "";
		Если Не СтруктураНовыхДанных.Свойство("КодРайона", КодРайона) Тогда
			КодРайона = СтруктураПараметровРасчетаЛС.КодРайона;
		КонецЕсли;
		СборникКоэффициентов = "";
		Если Не СтруктураНовыхДанных.Свойство("СборникКоэффициентов", СборникКоэффициентов) Тогда
			СборникКоэффициентов = СтруктураПараметровРасчетаЛС.ФайлСборникаКоэффициентов;
		КонецЕсли;
		ШифрыРасценки = Позиция.ШифрРасценки;
		
		Отбор = Новый Структура("КодРайона, СборникКоэффициентов, КодРегиональнойБазы, ТипНормативногоСборника", КодРайона, СборникКоэффициентов, КодРегиональнойБазы, ТипНормативногоСборника);
		
		МассивСтрокТаблицы = ТаблицаСведений.НайтиСтроки(Отбор);
		
		Если МассивСтрокТаблицы.Количество() = 0 Тогда
			Стр = ТаблицаСведений.Добавить();
			Стр.ШифрыРасценки = ШифрыРасценки;
		Иначе
			Стр = МассивСтрокТаблицы[0];
			Стр.ШифрыРасценки = Стр.ШифрыРасценки + ";" + ШифрыРасценки;
		КонецЕсли;	   		
		
		ЗаполнитьЗначенияСвойств(Стр, Отбор);
		
	КонецЦикла;
	
	Для Каждого СтрПозиция Из ТаблицаСведений Цикл
	
		Структура = Новый Структура("ШифрыРасценки, КодРайона, КодРегиональнойБазы, СборникКоэффициентов, ТипНормативногоСборника");
		ЗаполнитьЗначенияСвойств(Структура, СтрПозиция);
		Массив.Добавить(Структура);     		
		
	КонецЦикла;
	
	Возврат Массив;
		
КонецФункции

// Готовит таблицу индексов по данным из ВНБ.
// TO DO - перенести на сервер.
//
// Параметры:
//     Данные - Строка - содержит XML данные из ВНБ об индексах.
//
// Возвращаемое значение:
//     Таблица - ТаблицаЗначений - таблица с информацией об индексах.
//
Функция ЗагрузитьИндексыВТаблицу(Данные) Экспорт
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("ШифрРасценки");
	Таблица.Колонки.Добавить("ТипНормативногоСборника");
	Таблица.Колонки.Добавить("КоэффОснЗарплаты");
	Таблица.Колонки.Добавить("КоэффСтоимЭксплМашин");
	Таблица.Колонки.Добавить("КоэффСтоимЗарплатеМашин");
	Таблица.Колонки.Добавить("КоэффСтоимМатериалов");
	Таблица.Колонки.Добавить("КоэффОборуд");
	Таблица.Колонки.Добавить("КоэффПолнСтоимРабот");
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Данные);
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если (ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента) Тогда
			Имя = НРег(ЧтениеXML.Имя);
			Если Имя = "index" Тогда
				СтрокаТаб = Таблица.Добавить();
				Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
					Если ЧтениеXML.Значение = " " ИЛИ ЧтениеXML.Значение = "" Тогда
						Продолжить;
					КонецЕсли;
					ТегИмя = НРег(ЧтениеXML.Имя);
					Если ТегИмя = "code" Тогда
						СтрокаТаб.ШифрРасценки = ЧтениеXML.Значение;	
					ИначеЕсли ТегИмя = "normtypecode" Тогда
						СтрокаТаб.ТипНормативногоСборника = ОпределитьТипНормСборникаПоКоду(ЧтениеXML.Значение);
				    ИначеЕсли ТегИмя = "kpz" Тогда
						СтрокаТаб.КоэффПолнСтоимРабот = Число(ЧтениеXML.Значение);
						СтрокаТаб.КоэффОборуд = Число(ЧтениеXML.Значение);
					ИначеЕсли ТегИмя = "kzpr" Тогда
						СтрокаТаб.КоэффОснЗарплаты = Число(ЧтениеXML.Значение);
					ИначеЕсли ТегИмя = "kmm" Тогда
						СтрокаТаб.КоэффСтоимЭксплМашин = Число(ЧтениеXML.Значение);
					ИначеЕсли ТегИмя = "kzpmm" Тогда
						СтрокаТаб.КоэффСтоимЗарплатеМашин = Число(ЧтениеXML.Значение);
					ИначеЕсли ТегИмя = "ksmat" Тогда
						СтрокаТаб.КоэффСтоимМатериалов = Число(ЧтениеXML.Значение);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Таблица;
			
КонецФункции

#КонецОбласти

