		ИначеЕсли Лев(ШифрРасценки, 3) = "16." Тогда
			НС = Перечисления.СМ_ТипыНормативныхСборников.УкрупненныеСметныеНормы;
		ИначеЕсли Лев(ШифрРасценки, 2) = "7." Тогда
			НС = Перечисления.СМ_ТипыНормативныхСборников.РеставрационноВосстановительныеРаботы;
		ИначеЕсли Лев(ШифрРасценки, 3) = "14." Тогда
			НС = Перечисления.СМ_ТипыНормативныхСборников.ТехническоеОбслуживание;
		ИначеЕсли Лев(ШифрРасценки, 3) = "17." Тогда
			НС = Перечисления.СМ_ТипыНормативныхСборников.СодержаниеОбъектовГородскойСреды;
		ИначеЕсли Лев(ШифрРасценки, 2) = "1." Тогда
			НС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;
		ИначеЕсли Лев(ШифрРасценки, 2) = "9." Тогда
			НС = Перечисления.СМ_ТипыНормативныхСборников.ДополнительныеЗатратыВЗимнееВремя;
		ИначеЕсли Лев(ШифрРасценки, 2) = "2." Тогда
			Если Лев(ШифрРасценки, 3) = "2.2" Или Лев(ШифрРасценки, 3) = "2.3" Тогда
				НС =  Перечисления.СМ_ТипыНормативныхСборников.Перебазировка;
			Иначе	
				НС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин;
			КонецЕсли;
		Иначе	
			НС = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы;
		КонецЕсли;
	Иначе
		Если (СтрДлина(ШифрРасценки) = 6) И (Найти(ШифрРасценки, "-") = 0) Тогда
			НС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин;
		ИначеЕсли (СтрДлина(ШифрРасценки) > 4) И (Найти(ШифрРасценки, "-") = 4)  И (СтрЧислоВхождений(ШифрРасценки, "-") < 3) Тогда
			НС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;
		ИначеЕсли (Найти(ШифрРасценки, "-") = 3) и (Найти(ШифрРасценки, "-") = 6) и (Лев(ШифрРасценки, 1) = "0") Тогда
			НС = Перечисления.СМ_ТипыНормативныхСборников.Транспортировка;
		Иначе
		    НС = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НС;
	
КонецФункции

