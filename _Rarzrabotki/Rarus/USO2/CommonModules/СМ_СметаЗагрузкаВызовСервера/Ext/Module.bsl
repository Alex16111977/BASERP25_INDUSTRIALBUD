	Возврат ОбъектДляЗаписи;
	
КонецФункции 

// Функция загружает нормативы НР и СП из XML.
//	Тег - типа ЧтениеXML.
//
Функция ЗагрузитьНормативыНРиСПИзXML(Тег, Родитель = Неопределено)
	
	ОбъектДляЗаписи = Справочники.СМ_НормативыНРиСП.СоздатьЭлемент();
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Имя = "type_work" Тогда
			ОбъектДляЗаписи.ВидРаботДляНачисленияНРиСП = Тег.Значение;
			ОбъектДляЗаписи.Наименование = Тег.Значение;
		ИначеЕсли Тег.Имя = "spisokns" Тогда
			ОбъектДляЗаписи.СписокНомеровСборников = Тег.Значение; 	
		ИначеЕсли Тег.Имя = "spisokr" Тогда
			ОбъектДляЗаписи.СписокРасценок = Тег.Значение; 	
		ИначеЕсли Тег.Имя = "flagnr" Тогда
			ОбъектДляЗаписи.УточнитьНормативыНРиСППоСправке = Булево(Тег.Значение); 	
		ИначеЕсли Тег.Имя = "flagrem" Тогда
			ОбъектДляЗаписи.ПрименитьКоэффициентНР = Булево(Тег.Значение); 	
		ИначеЕсли Тег.Имя = "flagremsp" Тогда
			ОбъектДляЗаписи.ПрименитьКоэффициентСП = Булево(Тег.Значение); 	
		ИначеЕсли Тег.Имя = "poprnr" Тогда
			ОбъектДляЗаписи.ПрименятьПоправочныйКоэффициентКНР = Булево(Тег.Значение); 	
		ИначеЕсли Тег.Имя = "poprsp" Тогда
			ОбъектДляЗаписи.ПрименятьПоправочныйКоэффициентКСП = Булево(Тег.Значение); 	
		КонецЕсли;
	КонецЦикла;
	
	ОбъектДляЗаписи.Методика				= Справочники.СМ_МетодикиРасчета.СМ_МетодикаМДС35; // TO DO: Заполнение для других методик
	ОбъектДляЗаписи.ТипНормативногоСборника = ОбъектДляЗаписи.ТипНормативногоСборника;
	ОбъектДляЗаписи.Родитель 				= Родитель.Ссылка;
	ОбъектДляЗаписи.ТипНормативногоСборника = Родитель.ТипНормативногоСборника;
	ОбъектДляЗаписи.УстановитьНовыйКод("S");
	
	Возврат ОбъектДляЗаписи;
	
КонецФункции 

