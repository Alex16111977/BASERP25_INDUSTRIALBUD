	ЗаполнитьДанныеОКЕИ();
	
КонецПроцедуры

// Получает список доступных СНБ из ВНБ.
//
// Параметры:
//     ДанныеДляОбновления 	- Строка - содержит данные из ВНБ в формате XML.
//     ВерсияПротокола 		- Число	- версия внешней нормативной базы.
//
// Возвращаемое значение:
//     МассивСНБ - Структура - содержит поля:
//			* МассивСНБ     - Массив - данные по СНБ из ВНБ. Массив содержит ссылки на СМ_СметноНормативныеБазы.
//			* СНБЗаполнена 	- Булево - присутствуют ли СНБ в справочнике.
//
Функция ПолучитьСписокСНБДляОбновления(ДанныеДляОбновления, ВерсияПротокола = 1) Экспорт
	
	ТипТекущейБазы = "norms";
	
	МассивВнешнихСНБ = Новый Массив;
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ДанныеДляОбновления);
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если НРег(ЧтениеXML.Имя) = "base" Тогда
				СНБСтруктура = Новый Структура("Код,Наименование,Правообладатель,ГодВыпуска,Версия");
				ПрочитатьСНБ(ЧтениеXML, СНБСтруктура);
			ИначеЕсли (ВерсияПротокола > 1) Тогда
				Если НРег(ЧтениеXML.Имя) = "region" Тогда
				    СНБСтруктура.Код = ПолучитьЗначениеТекстаXML(ЧтениеXML);
				ИначеЕсли НРег(ЧтениеXML.Имя) = "year" Тогда
					СНБСтруктура.ГодВыпуска = ПолучитьЗначениеТекстаXML(ЧтениеXML);
				ИначеЕсли НРег(ЧтениеXML.Имя) = "version" Тогда
					СНБСтруктура.Версия = ПолучитьЗначениеТекстаXML(ЧтениеXML);
				ИначеЕсли НРег(ЧтениеXML.Имя) = "dbtype" Тогда
					ТипТекущейБазы = НРег(ПолучитьЗначениеТекстаXML(ЧтениеXML));
				ИначеЕсли НРег(ЧтениеXML.Имя) = "pravo" Тогда
					СНБСтруктура.Правообладатель = ПолучитьЗначениеТекстаXML(ЧтениеXML);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли (ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента) И (НРег(ЧтениеXML.Имя) = "base") И (ТипТекущейБазы = "norms") Тогда
			// Демо базу не добавляем и не обновляем.
			МассивВнешнихСНБ.Добавить(СНБСтруктура);	
		КонецЕсли; 
	КонецЦикла;
	
	МассивСНБ = ПолучитьМассивСНБ(МассивВнешнихСНБ);
	
	Возврат МассивСНБ;
	
КонецФункции

// Загружает СНБ из XML (формат 2)
//
// Параметры:
//     ЧтениеXML	- ЧтениеXML - спозиционнированное на текущем узле с СНБ.
//     НачатьЗапись - Булево - нужно ли начинать запись (устанавливается в процессе).
//     СписокСНБ 	- Массив - список СНБ для обновления (если имеется).
//
// Возвращаемое значение:
//     ОбъектДляЗаписи - СправочникСсылка.СМ_СметноНормативныеБазы - 
//						 ссылка на созданный и записанный элемент справочника СМ_СметноНормативныеБазы.
//
Функция ЗагрузитьСНБИзXMLвер2(ЧтениеXML, НачатьЗапись, СписокСНБ) Экспорт
	
	ОбъектДляЗаписи = Новый Структура("Код,Наименование,Правообладатель,ГодВыпуска,Версия,ГруппаРесурсов");
	
	Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
		Если (НРег(ЧтениеXML.Имя) = "description") Тогда
			ОбъектДляЗаписи.Наименование = ЧтениеXML.Значение; 
		КонецЕсли;
	КонецЦикла;
	
	МассивЗон = Новый Массив();
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда	
			Если НРег(ЧтениеXML.Имя) = "region" Тогда
			    ОбъектДляЗаписи.Код = ПолучитьЗначениеТекстаXML(ЧтениеXML);
			ИначеЕсли НРег(ЧтениеXML.Имя) = "year" Тогда
				Год = ПолучитьЗначениеТекстаXML(ЧтениеXML);
				Если (ЗначениеЗаполнено(Год)) И (Год<>"0") Тогда
					ОбъектДляЗаписи.ГодВыпуска = ПредопределенноеЗначение("Перечисление.СМ_ГодыВыпускаБазы.г"+Год);
				Иначе
					ОбъектДляЗаписи.ГодВыпуска = ПредопределенноеЗначение("Перечисление.СМ_ГодыВыпускаБазы.г2001");
				КонецЕсли;
			ИначеЕсли НРег(ЧтениеXML.Имя) = "version" Тогда
				ОбъектДляЗаписи.Версия = ПолучитьЗначениеТекстаXML(ЧтениеXML);
			ИначеЕсли НРег(ЧтениеXML.Имя) = "rescatalog" Тогда
				НаименованиеКаталога = ПолучитьЗначениеТекстаXML(ЧтениеXML);
				Если ЗначениеЗаполнено(НаименованиеКаталога) Тогда
					ГруппаРесурсов = Справочники.СМ_ГруппыРесурсов.НайтиПоНаименованию(НаименованиеКаталога);
					Если ГруппаРесурсов <> Неопределено Тогда
						ОбъектДляЗаписи.ГруппаРесурсов = ГруппаРесурсов;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли НРег(ЧтениеXML.Имя) = "pravo" Тогда
				ОбъектДляЗаписи.Правообладатель = ПолучитьЗначениеТекстаXML(ЧтениеXML);
			ИначеЕсли НРег(ЧтениеXML.Имя) = "zone" Тогда
				МассивЗон.Добавить(ЗагрузитьРайонИзXML(ЧтениеXML));
			КонецЕсли;
		ИначеЕсли НРег(ЧтениеXML.Имя) = "zones" Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(ОбъектДляЗаписи.Код) Тогда
		НачатьЗапись = ?(СписокСНБ=неопределено, Истина, ?(СписокСНБ.Найти(ОбъектДляЗаписи.Код) = Неопределено, Ложь, Истина));
	Иначе
		НачатьЗапись = Ложь;
	КонецЕсли;

	Если НачатьЗапись Тогда
		Если Не ЗначениеЗаполнено(ОбъектДляЗаписи.ГруппаРесурсов) Тогда
			ОбъектДляЗаписи.ГруппаРесурсов = Справочники.СМ_ГруппыРесурсов.ЗаполнитьГруппуРесурсовПоУмолчанию(ОбъектДляЗаписи);
		КонецЕсли;
		ОбъектДляЗаписи = СМ_СметаВызовСервера.СоздатьНайтиЭлементСправочника("СМ_СметноНормативныеБазы", ОбъектДляЗаписи.Код, Истина, ОбъектДляЗаписи);
		Если МассивЗон.Количество() Тогда
			ДобавитьРайоныВСНБ(ОбъектДляЗаписи, МассивЗон);
		КонецЕсли;	
	КонецЕсли;
	
	Возврат ОбъектДляЗаписи;
	
КонецФункции

// Загружает СНБ из XML.
//
// Параметры:
//     Тег 			- ЧтениеXML - спозиционнированное на текущем узле с СНБ.
//     НачатьЗапись - Булево	- нужно ли начинать запись (устанавливается в процессе).
//     СписокСНБ 	- Массив	- список СНБ для обновления (если имеется).
//
// Возвращаемое значение:
//     ОбъектДляЗаписи - СправочникСсылка.СМ_СметноНормативныеБазы - 
//					     ссылка на созданный и записанный элемент справочника СМ_СметноНормативныеБазы.
//
Функция ЗагрузитьСНБИзXML(Тег, НачатьЗапись, СписокСНБ) Экспорт
	
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Имя = "code" Тогда
			ОбъектДляЗаписи = Новый Структура("Код,Наименование,Правообладатель,ГодВыпуска,Версия");
			Если ЗначениеЗаполнено(Тег.Значение) Тогда
				НачатьЗапись = ?(СписокСНБ=неопределено, Истина, ?(СписокСНБ.Найти(Тег.Значение) = Неопределено, Ложь, Истина));
				ОбъектДляЗаписи.Код = Тег.Значение;
			Иначе
				НачатьЗапись = Ложь;
			КонецЕсли;
		ИначеЕсли (Тег.Имя = "name") И НачатьЗапись Тогда
			ОбъектДляЗаписи.Наименование = Тег.Значение; 	
		ИначеЕсли (Тег.Имя = "pravo") И НачатьЗапись Тогда
			ОбъектДляЗаписи.Правообладатель = Тег.Значение; 	
		ИначеЕсли (Тег.Имя = "year") И НачатьЗапись Тогда
			ОбъектДляЗаписи.ГодВыпуска = ПредопределенноеЗначение("Перечисление.СМ_ГодыВыпускаБазы.г"+Тег.Значение); 	
		ИначеЕсли (Тег.Имя = "version") И НачатьЗапись Тогда
			ОбъектДляЗаписи.Версия = Тег.Значение; 	
			ОбъектДляЗаписи = СМ_СметаВызовСервера.СоздатьНайтиЭлементСправочника("СМ_СметноНормативныеБазы", ОбъектДляЗаписи.Код,Истина,ОбъектДляЗаписи)
		КонецЕсли;
	КонецЦикла;  	
	
	Возврат ОбъектДляЗаписи;
	
КонецФункции

// Заполняет СНБ данными из ВНБ.
//
// Параметры:
//     СписокСНБ 			- Массив - список СНБ для обновления (если имеется).
//     ДанныеДляОбновления 	- Строка - содержит данные из ВНБ в формате XML.
//     ВерсияПротокола 		- Число	- версия внешней нормативной базы.
//
// Возвращаемое значение:
//     ОбъектыДляЗаписи - СправочникСсылка.СМ_СметноНормативныеБазы	- 
//						  ссылка на обновленный и записанный элемент справочника СМ_СметноНормативныеБазы.
//
Функция ЗаполнитьСНБ(СписокСНБ,ДанныеДляОбновления,ВерсияПротокола = 1) Экспорт
	
	ЗаписьНормативнойБазы = Ложь;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ДанныеДляОбновления);
	
	ОбъектыДляЗаписи = Новый Массив();
	
	Пока ЧтениеXML.Прочитать() Цикл
		Имя = НРег(ЧтениеXML.Имя);
		Если (ЧтениеXML.ТипУзла = ПредопределенноеЗначение("ТипУзлаXML.НачалоЭлемента")) Тогда
			Если Имя = "base" Тогда
				Если ВерсияПротокола = 1 Тогда
					ОбъектДляЗаписи = ЗагрузитьСНБИзXML(ЧтениеXML, ЗаписьНормативнойБазы, СписокСНБ);
				Иначе
					ОбъектДляЗаписи = ЗагрузитьСНБИзXMLвер2(ЧтениеXML, ЗаписьНормативнойБазы, СписокСНБ);				
				КонецЕсли;	                       
			ИначеЕсли (Имя = "zone") И ЗаписьНормативнойБазы Тогда
				ОбъектДляЗаписиВнутр = ЗагрузитьРайонИзXML(ЧтениеXML);
			КонецЕсли;
		ИначеЕсли (ЧтениеXML.ТипУзла = ПредопределенноеЗначение("ТипУзлаXML.КонецЭлемента")) И ЗаписьНормативнойБазы Тогда
			Если Имя = "base" Тогда
				
				ОбъектыДляЗаписи.Добавить(ОбъектДляЗаписи);  				
				
			ИначеЕсли Имя = "zone" И ЗаписьНормативнойБазы Тогда
				ДобавитьРайонВСНБ(ОбъектДляЗаписи, ОбъектДляЗаписиВнутр);
			КонецЕсли;
			
		КонецЕсли; 
	КонецЦикла;
	
	Возврат ОбъектыДляЗаписи;
	
КонецФункции

#КонецОбласти

