// Создает запись в журнал регистрации.
//
// Параметры:
//     	Событие 	- Строка - содержит информацию о событии.
//     	Ошибка 		- Булево - определяет уровень важности события.
//					  Истина - событие типа ошибка, Ложь - событие типа информация.
//		Комментарий - Строка - комментарий к записи журнала регистрации.
//
Процедура ЗаписатьВЖурналаРегистрации(Событие,Ошибка = Истина,Комментарий = Неопределено) Экспорт
	
	Если Ошибка Тогда
		УровеньЖурнала = УровеньЖурналаРегистрации.Ошибка;
	Иначе
        УровеньЖурнала = УровеньЖурналаРегистрации.Информация;
	КонецЕсли;
	
	Если Комментарий = Неопределено Тогда
		Комментарий = Событие;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(Событие,УровеньЖурнала,,,Комментарий);
	
КонецПроцедуры

