// Обновляет поправки в справочнике регламентным заданием.
//
// Параметры:
//     СтруктураПараметровЗадания - Структура - содержит поля:
//			* ХранилищеСНБ		    		- СправочникСсылка.СМ_СметноНормативныеБазы	- сметно-нормативная база.
//     		* ХранилищеДанныеДляОбновления 	- Строка - содержит данные из ВНБ в формате XML.
//	   АдресХранилища - Строка - адрес хранилища формы.
//
Процедура ОбновитьПоправкиРегламентноеЗадание(СтруктураПараметровЗадания, АдресХранилища) Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания();
	
	СНБ = СтруктураПараметровЗадания.ХранилищеСНБ;
	ДанныеДляОбновления = СтруктураПараметровЗадания.ХранилищеДанныеДляОбновления;
	ЗаписьЖурналаРегистрации(НСтр("ru = 'СНБ'"), УровеньЖурналаРегистрации.Предупреждение, , ,СНБ);
	
	Если ЗначениеЗаполнено(ДанныеДляОбновления) И ЗначениеЗаполнено(СНБ) Тогда
	
		ОбновитьПоправки(СНБ, ДанныеДляОбновления, 2);
		
	КонецЕсли;
	
КонецПроцедуры

// Запускает обновление поправок.
//
// Параметры:
//     УникальныйИдентификатор 	- Строка - содержит УИД регламентного задания.
//     СНБ 						- СправочникСсылка.СМ_СметноНормативныеБазы	- сметно-нормативная база.
//     ДанныеДляОбновления 		- Строка - содержит данные из ВНБ в формате XML.
//  
// Возвращаемое значение:
//     Результат - Структура - содержит данные о выполнении задания.
//
Функция ЗапуститьПоправкиРегламентноеЗадание(УникальныйИдентификатор, СНБ, ДанныеДляОбновления) Экспорт
	
	ПараметрыЗадания = Новый Структура();
	ПараметрыЗадания.Вставить("ХранилищеСНБ", СНБ);
	ПараметрыЗадания.Вставить("ХранилищеДанныеДляОбновления", ДанныеДляОбновления);
	
	Попытка
		Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
			УникальныйИдентификатор,
			"СМ_СметаЗагрузкаВызовСервера.ОбновитьПоправкиРегламентноеЗадание",
			ПараметрыЗадания, 
			НСтр("ru = 'Обновление поправок по техническим частям'")+" "+СНБ.Наименование);
		
	Исключение
		ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Событие = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обновление поправок по %1'"), СНБ.Наименование);
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ПредставлениеОшибки);
		ВызватьИсключение;
	КонецПопытки;

	Возврат Результат;
	
КонецФункции

