// Процедура заполняет ресурсы позиции локальной сметы из XML.
//
Процедура ЗаполнитьРеcурсыПозицииЛСИзXML(Тег,Объект, ПараметрыСметы, ВерсияКомпоненты = 1)
	
	НоваяСтрокаТЧ = Объект.РесурсыПозицииЛокальнойСметы.Добавить();
	
	Ресурс = ЗагрузитьРесурсИзXML(Тег,Объект.РегиональнаяБаза.ГодВыпуска,Объект.РегиональнаяБаза,,ВерсияКомпоненты);
	
	// 1. Из XML получает ключевые поля для идентификации элемента спр Ресурсы (код ресурса + Не группа).
	// 2. Находит ссылку на Ресурс по этим полям (если не найдена, то ошибку + ЗагрузитьРесурсИзXML()).
	// 3. Заполняет остальный реквизиты ТЧ. 
	//			из XML - тип ресурса (По проекту, учтен), норма.
	//			из справочника Ресурсы - остальное.
	
	Тег.ПервыйАтрибут();
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
			Продолжить;
		КонецЕсли;
		ТегИмя = НРег(Тег.Имя);
		Если ТегИмя = "type" Тогда
			НоваяСтрокаТЧ.ТипМатериала = Перечисления.СМ_ТипыМатериалов[СтрЗаменить(СтрЗаменить(Тег.Значение, " ", ""),"ё","е")]; 	
		ИначеЕсли ТегИмя = "code" Тогда
		
		ИначеЕсли ТегИмя = "rate" Тогда
			// Значение нормы может быть экспонента.
			ПозицияЕ =  Найти(Тег.Значение,"E");
			Если ПозицияЕ = 0 Тогда
				НоваяСтрокаТЧ.НормаРасхода = Число(Тег.Значение); 
			Иначе
				НоваяСтрокаТЧ.НормаРасхода = ПолучитьНорму(Тег.Значение);
			КонецЕсли;
		ИначеЕсли ТегИмя = "basis" Тогда
			НоваяСтрокаТЧ.БазиснаяЦена = Число(Тег.Значение); 	
		ИначеЕсли ТегИмя = "basis_zpm" Тогда
			НоваяСтрокаТЧ.БазиснаяЗарплатаМашинистов = Число(Тег.Значение); 	
		КонецЕсли;
	КонецЦикла;
	
	Если ТипЗнч(Ресурс.Ссылка) = Тип("СправочникСсылка.СМ_Ресурсы") Тогда
		НоваяСтрокаТЧ.СметныйКодРесурса = Ресурс.Код;
		НоваяСтрокаТЧ.Ресурс = Ресурс.Ссылка;
		НоваяСтрокаТЧ.ВидРесурса = Ресурс.ВидРесурса;
		НоваяСтрокаТЧ.НаименованиеРесурса = Ресурс.Ссылка.ДлинноеНаименование;
		НоваяСтрокаТЧ.ЕдиницаИзмеренияРесурса = Ресурс.Ссылка.ЕдиницаИзмерения;

	КонецЕсли;
	
	Если ВерсияКомпоненты > 1 Тогда
		// Продолжим поиск цен.
		Пока Тег.Прочитать() Цикл
			Если (Тег.ТипУзла = ТипУзлаXML.НачалоЭлемента) Тогда	
				Имя = НРег(Тег.Имя);
				Если Имя = "resourcebaseprice" Тогда   				
					// Загрузим цены.
					Пока Тег.ПрочитатьАтрибут() Цикл
						Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
							Продолжить;
						КонецЕсли;
						ТегИмя = НРег(Тег.Имя);
						Если ТегИмя = "price" Тогда
							НоваяСтрокаТЧ.БазиснаяЦена = Число(Тег.Значение); 	
						ИначеЕсли (ТегИмя = "opt") И (НоваяСтрокаТЧ.Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы) Тогда
							НоваяСтрокаТЧ.БазиснаяЗарплатаМашинистов = Число(Тег.Значение); 	
						КонецЕсли;
					КонецЦикла;              					
				КонецЕсли;				
			ИначеЕсли (НРег(Тег.Имя) = "resource")И(Тег.ТипУзла = ТипУзлаXML.КонецЭлемента) Тогда	
				Прервать;			
			КонецЕсли
		КонецЦикла;
	КонецЕсли;
	
	ЗагрузитьТекущиеЦеныРесурсовИзXML(НоваяСтрокаТЧ, Объект, ПараметрыСметы);
	
КонецПроцедуры

Функция ПолучитьНорму(СтрокаТег)
	// Получить число из экспон.
	Поз = Найти(СтрокаТег,"E");
	ПерваяЧасть = СтрЗаменить(Сред(СтрокаТег,1,Поз-1),",", ".");
	Рез = ПерваяЧасть;
	Знак = Сред(СтрокаТег,Поз+1,1);
	ВтораяЧасть = Число(Сред(СтрокаТег,Поз+2));
	Коэфф = "1";
	Для сч = 1 По ВтораяЧасть Цикл
		Коэфф = Коэфф + "0";
	КонецЦикла;
	Коэфф = Число(Коэфф);
	Если Коэфф <> 0 Тогда
		Если Знак = "-" Тогда
			Рез = ПерваяЧасть / Коэфф;
		Иначе
			Рез = ПерваяЧасть * Коэфф;
		КонецЕсли;
	КонецЕсли;	
	Возврат (Рез);		
	
КонецФункции

// Процедура заполняет работы позиции локальной сметы из XML.
//
Процедура ЗаполнитьРаботыПозицииЛСИзXML(Тег,Объект)
	
	НоваяСтрокаТЧ = Объект.СоставРабот.Добавить();
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
			Продолжить;
		КонецЕсли;
		ТегИмя = НРег(Тег.Имя);
		Если ТегИмя = "number" ИЛИ ТегИмя = "code" Тогда
			НоваяСтрокаТЧ.Номер = Число(Тег.Значение); 	
		ИначеЕсли ТегИмя = "work" ИЛИ ТегИмя = "description" Тогда
			НоваяСтрокаТЧ.НаименованиеРаботы = Тег.Значение; 	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Процедура заполняет НС позиции локальной сметы из XML.
//
Процедура ЗаполнитьНСПозицииЛСИзXML(Тег,Объект)
	
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
			Продолжить;
		КонецЕсли;
		Если Тег.Имя = "code" Тогда
			Объект.РегиональнаяБаза = Справочники.СМ_СметноНормативныеБазы.НайтиПоКоду(Тег.Значение);	
		ИначеЕсли Тег.Имя = "worktype" Тогда
			Объект.ТипНормативныхСборников = ОпределитьТипНормСборникаПоКоду(Тег.Значение);
		ИначеЕсли Тег.Имя = "texpart" Тогда
			// Объект.	
		ИначеЕсли Тег.Имя = "version" Тогда
			Объект.Версия = Тег.Значение; 
			Если НЕ Объект.Версия = Тег.Значение Тогда
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Процедура заполняет расценки позиции локальной сметы из XML.
//
Процедура ЗаполнитьРасценкиПозицииЛСИзXML(Тег, Объект, ТипРасценки, ЭтоТСН)
	
	ТипРасценки = "БазисныеЦены";
	
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
			Продолжить;
		КонецЕсли;
		ТегИмя = НРег(Тег.Имя);
		Если ТегИмя = "code" Тогда
			Объект.ШифрРасценки = Тег.Значение;
		ИначеЕсли ТегИмя = "name" Тогда
			Объект.Наименование = Тег.Значение;
		ИначеЕсли ТегИмя = "izm" Тогда
			Объект.Измеритель = Тег.Значение;	
		ИначеЕсли ТегИмя = "unit" Тогда
			Объект.ЕдиницаИзмерения = НайтиЕдиницуИзмеренияСметномуКоду(Тег.Значение, Объект.Измеритель);
			Если Не ЗначениеЗаполнено(Объект.Измеритель) Тогда
				Объект.Измеритель = Объект.ЕдиницаИзмерения;
			КонецЕсли;
		ИначеЕсли ТегИмя = "unitOKEI" Тогда
				
		ИначеЕсли (ТегИмя = "mass1")ИЛИ(ТегИмя = "mas1") Тогда
			Объект.МассаБрутто = Тег.Значение;	
		ИначеЕсли (ТегИмя = "mass2")ИЛИ(ТегИмя = "mas2") Тогда
			Объект.МассаНетто = Тег.Значение;	
		ИначеЕсли ТегИмя = "grunt1" Тогда
				
		ИначеЕсли ТегИмя = "grunt2" Тогда
				
		ИначеЕсли ТегИмя = "garb1" Тогда
				
		ИначеЕсли ТегИмя = "garb2" Тогда
				
		ИначеЕсли ТегИмя = "opr" Тогда
			Если (Число(Тег.Значение) = 0) И (ТипРасценки = "ТекущиеЦены") Тогда
				Объект.Определитель = Справочники.СМ_Определители.НайтиПоТипуНормативногоСборника(Объект.ТипНормативныхСборников);
			ИначеЕсли Объект.ИДСметы.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_КЗ_РСНБ Тогда
				//Если Лев(Объект.ШифрРасценки, 1) <> "1" Тогда
				//	Объект.Определитель = Справочники.СМ_Определители.НайтиПоКоду("19");
				//Иначе
					Объект.Определитель = Справочники.СМ_Определители.НайтиПоКоду(Число(Тег.Значение));	
				//КонецЕсли;
			Иначе
				Объект.Определитель = Справочники.СМ_Определители.НайтиПоКоду(Число(Тег.Значение));	
			КонецЕсли;
		ИначеЕсли ТегИмя = "v" Тогда
			Объект.ОбъемРабот = Число(Тег.Значение);	
		ИначеЕсли ТегИмя = "formula" Тогда
			Объект.ФормулаОбъема = Тег.Значение;
		ИначеЕсли ТегИмя = "normtypecode" Тогда
			Если (ТипРасценки = "ТекущиеЦены") И ((Врег(Тег.Значение) = "ER")ИЛИ(Врег(Тег.Значение) = "")) Тогда
				// Пытаемся определить по шифру.
				Объект.ТипНормативныхСборников = ОпределитьТипНормСборникаПоШифру(Объект.ШифрРасценки, ЭтоТСН);
			Иначе
				Объект.ТипНормативныхСборников = ОпределитьТипНормСборникаПоКоду(Врег(Тег.Значение), Объект.ШифрРасценки);
			КонецЕсли;
		ИначеЕсли ТегИмя = "regioncode" Тогда
			Объект.РегиональнаяБаза = Справочники.СМ_СметноНормативныеБазы.НайтиПоКоду(Тег.Значение);
			Объект.Версия = Объект.РегиональнаяБаза.Версия;
		ИначеЕсли ТегИмя = "ztr" Тогда
			Объект.ЗатратыТрудаРабочих = Тег.Значение;
		ИначеЕсли ТегИмя = "ztm" Тогда
			Объект.ЗатратыТрудаМашинистов = Тег.Значение;
		ИначеЕсли ТегИмя = "dbtype" И НРег(Тег.Значение) = "prices" Тогда
			ТипРасценки = "ТекущиеЦены";
			Объект.НеПрименятьИндексы = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Процедура заполняет стоимость поизции локальной сметы из XML.
//
Процедура ЗаполнитьСтоимостиПозицииЛСИзXML(Тег,Объект,ВерсияКомпоненты = 1)
	
	Если ОпределитьУровеньСНБ(Объект.РегиональнаяБаза.Наименование, Объект.РегиональнаяБаза.Код) = Перечисления.СМ_УровниБазы.ТерриториальныйМосква ИЛИ
		Объект.ИДСметы.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква Тогда
		//Объект.ИДСметы.МетодикаТСН Тогда
		МетодикаТСН = Истина;
	Иначе
		МетодикаТСН = Ложь;
	КонецЕсли;	

	Если ВерсияКомпоненты = 1 И Не МетодикаТСН Тогда
		Пока Тег.ПрочитатьАтрибут() Цикл
			Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
				Продолжить;
			КонецЕсли;
			ТегИмя = НРег(Тег.Имя);
			
			Если ТегИмя = "codezone" Тогда
				
			ИначеЕсли ТегИмя = "outlays" Тогда
				Объект.ПрямЗатраты = Число(Тег.Значение);
			ИначеЕсли ТегИмя = "workers" Тогда
				Объект.ОснЗарплата = Число(Тег.Значение);	
			ИначеЕсли ТегИмя = "machines" Тогда
				Объект.ЭксплМашин = Число(Тег.Значение);	
			ИначеЕсли ТегИмя = "operators" Тогда
				Объект.ЗарплМашинистов = Число(Тег.Значение);	
			ИначеЕсли ТегИмя = "materials" Тогда
				Объект.СтоимМатериалов = Число(Тег.Значение);	
			ИначеЕсли ТегИмя = "vmaterials" Тогда
				Объект.ВозвратМатер = Число(Тег.Значение);	
			ИначеЕсли ТегИмя = "ztr" Тогда
				Объект.ЗатратыТрудаРабочих = Число(Тег.Значение);	
			ИначеЕсли ТегИмя = "ztm" Тогда
				Объект.ЗатратыТрудаМашинистов = Число(Тег.Значение);	
			ИначеЕсли ТегИмя = "nr" Тогда
				
			ИначеЕсли ТегИмя = "sp" Тогда
				
			ИначеЕсли ТегИмя = "zu" Тогда
				
			ИначеЕсли ТегИмя = "dopnr" Тогда
				
			ИначеЕсли ТегИмя = "dopsp" Тогда
				
			ИначеЕсли ТегИмя = "dopzu" Тогда
				
			КонецЕсли;
			
		КонецЦикла;
	ИначеЕсли МетодикаТСН Тогда
		Если Объект.Ссылка.Пустая() Тогда
			Обновление = Ложь;
			Если Объект.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы
				И Объект.ИДСметы.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
				СтроительныеРаботы = Истина;
			Иначе
				СтроительныеРаботы = Ложь;
			КонецЕсли;	
		Иначе
			Обновление = Истина;
			Если Объект.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы
				И Объект.Ссылка.ИДСметы.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
				СтроительныеРаботы = Истина;
			Иначе
				СтроительныеРаботы = Ложь;
			КонецЕсли;	
		КонецЕсли;
		НР = 0;
		СП = 0;
		ЗУ = 0;
		ЗУМАТ = 0;
		
		ДопНР = 0;
		ДопСП = 0;
		ДопЗУ = 0;
		ДопЗУМАТ = 0;

		Пока Тег.ПрочитатьАтрибут() Цикл
			Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
				Продолжить;
			КонецЕсли;
			ТегИмя = НРег(Тег.Имя);
			
			Если ТегИмя = "nr" Тогда
				НР = Число(Тег.Значение);
			ИначеЕсли ТегИмя = "sp" Тогда
				СП = Число(Тег.Значение);
			ИначеЕсли ТегИмя = "zu" Тогда
				ЗУ = Число(Тег.Значение);
			ИначеЕсли ТегИмя = "zumat" Тогда
				ЗУМАТ = Число(Тег.Значение);
			ИначеЕсли ТегИмя = "dopnr" Тогда
				ДопНР = Число(Тег.Значение);
			ИначеЕсли ТегИмя = "dopsp" Тогда
				ДопСП = Число(Тег.Значение);
			ИначеЕсли ТегИмя = "dopzu" Тогда
				ДопЗУ = Число(Тег.Значение);
			ИначеЕсли ТегИмя = "dopzumat" Тогда	
				ДопЗУМАТ = Число(Тег.Значение);
			КонецЕсли;
		КонецЦикла;
		
		Если Не Обновление Тогда
			Объект.НакладныеРасходыБазисные = ?(СтроительныеРаботы,НР,НР);
			Объект.СметнаяПрибыльБазисные = ?(СтроительныеРаботы,СП,СП);
			Объект.НРТСНБазисРемонт = ?(СтроительныеРаботы,ДопНР,НР);
			Объект.СПТСНБазисРемонт = ?(СтроительныеРаботы,ДопСП,СП);
		КонецЕсли;
		
		Объект.НакладныеРасходыТекущие = ?(СтроительныеРаботы,НР,НР);
		Объект.СметнаяПрибыльТекущие = ?(СтроительныеРаботы,СП,СП);
		Объект.НРТСНТекущиеРемонт = ?(СтроительныеРаботы,ДопНР,НР);
		Объект.СПТСНТекущиеРемонт = ?(СтроительныеРаботы,ДопСП,СП);
		
		Объект.ЗимнееУдорож = ЗУ;
		Объект.ЗимнееУдорожМатериал = ЗУМАТ;
		Объект.ЗимнееУдорожРемонт = ДопЗУ;
		Объект.ЗимнееУдорожМатериалРемонт = ДопЗУМАТ;

	КонецЕсли;
КонецПроцедуры

// Заполняет реквизит позиции данными.
//
Процедура ЗаполнитьРеквизитПозицииЛСИзXML(ЧтениеXML, Объект, ИмяРеквизита = "ОбъемРабот")
	
	ЧтениеXML.Прочитать();
	Объект[ИмяРеквизита] = ЧтениеXML.Значение;
	
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеПроцедурыИФункции

// Процедура очищает нормативы НР и СП для группы.
//
Процедура ОчиститьНормативыНРиСПДляГруппы(Родитель)
	
	Если Родитель = неопределено ИЛИ Родитель = Справочники.СМ_НормативыНРиСП.ПустаяСсылка() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаЭлементов = Справочники.СМ_НормативыНРиСП.Выбрать(Родитель);
	Пока ВыборкаЭлементов.Следующий() Цикл
		ВыборкаЭлементов.ПолучитьОбъект().Удалить();
	КонецЦикла;
	
КонецПроцедуры

// Поиск главы ССРС.         
//
Функция НайтиГлавыССРСПоКоду(Код)

	ГлаваССР = Справочники.СМ_ГлавыССРС.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГлавыССРС.Ссылка
		|ИЗ
		|	Справочник.СМ_ГлавыССРС КАК ГлавыССРС
		|ГДЕ
		|	ГлавыССРС.ТипСтроительства = &ТипСтроительства
		|	И ГлавыССРС.Идентификатор = &Код";

	Запрос.УстановитьПараметр("Код", Код);
	Запрос.УстановитьПараметр("ТипСтроительства", Перечисления.СМ_ТипыСтроительства.НовоеСтроительство);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ГлаваССР = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;

	Возврат (ГлаваССР);
КонецФункции

// Поиск единицы измерения.
//
Функция НайтиЕдиницуИзмеренияСметномуКоду(Код, Наименование = "")
	
	ЕдиницаИзмерения = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСметномуКоду(Код);
	Если (Не ЗначениеЗаполнено(ЕдиницаИзмерения)) и ЗначениеЗаполнено(Наименование) Тогда
		ЕдиницаИзмерения = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСтроке(Наименование);
	КОнецЕсли;
	Возврат(ЕдиницаИзмерения);  
	
КонецФункции

// Получить дату базисных цен.
// Параметры:
//  Год - год ресурса (ПеречислениеСсылка.СМ_ГодыВыпускаБазы).
// Возвращаемое значение:
//  Дата базисных цен.
//
Функция ДатаБазисныхЦен(Год)
	
	Если Год = Перечисления.СМ_ГодыВыпускаБазы.г1984 Тогда
		Возврат Дата(1984,01,01,0,0,0);
	ИначеЕсли Год = Перечисления.СМ_ГодыВыпускаБазы.г1991 Тогда
		Возврат Дата(1991,01,01,0,0,0);
	ИначеЕсли Год = Перечисления.СМ_ГодыВыпускаБазы.г2001 Тогда
		Возврат Дата(2001,01,01,0,0,0);
	ИначеЕсли Год = Перечисления.СМ_ГодыВыпускаБазы.г2009 Тогда
		Возврат Дата(2000,01,01,0,0,0);
	Иначе
		Возврат Дата(2000,01,01,0,0,0);
	КонецЕсли;
		
КонецФункции

// Функция определяет уровень снб по наименованию.
//
Функция ОпределитьУровеньСНБ(Наименование, Код) Экспорт
	
	// ОТЛАЖЕНО.
	// Отвечает за определение уровня СНБ.

	Если (Найти(Наименование, "ФСНБ") > 0) ИЛИ (Найти(Наименование, "ФЕР") > 0) Тогда
		УровеньБазы = Перечисления.СМ_УровниБазы.Федеральный;
	ИначеЕсли (Найти(Наименование, "ГЭСН") > 0) Тогда
		УровеньБазы = Перечисления.СМ_УровниБазы.Государственный;
	ИначеЕсли Найти(Наименование, "ОЕР") > 0 Тогда
		УровеньБазы = Перечисления.СМ_УровниБазы.Отраслевой;
	ИначеЕсли (Код = "TS") ИЛИ (Код = "SN") ИЛИ (Код = "99") Тогда
		// ТСНы.
		УровеньБазы = Перечисления.СМ_УровниБазы.ТерриториальныйМосква;
	ИначеЕсли (Код = "00") Тогда
		// Демо.
		УровеньБазы = Перечисления.СМ_УровниБазы.Демонстрационный;
	Иначе
		УровеньБазы = Перечисления.СМ_УровниБазы.Территориальный;
	КонецЕсли;
	
	Возврат УровеньБазы;
КонецФункции

// Процедура возращает значение текстового узда XML, следующего за текущим.
//
Функция ПолучитьЗначениеТекстаXML(ЧтениеXML)
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла = ПредопределенноеЗначение("ТипУзлаXML.Текст") Тогда
			Возврат ЧтениеXML.Значение;
		ИначеЕсли ЧтениеXML.ТипУзла = ПредопределенноеЗначение("ТипУзлаXML.КонецЭлемента") Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции   

// Найти значение в строке между подстроками.
//
Функция НайтиПодстрокуМежду(Строка, ПодстрокаНачало, ПодстрокаКонец)
	
	Поз = Найти(Строка, ПодстрокаНачало);
	Если (Поз > 0) Тогда
		СтрокаОст = Сред(Строка, Поз + СтрДлина(ПодстрокаНачало));
		Поз = Найти(СтрокаОст, ПодстрокаКонец);
		Если (Поз > 1) Тогда
			Возврат Сред(СтрокаОст, 1, Поз-1);
		ИначеЕсли (Поз = 0) Тогда
			Возврат СтрокаОст;
		Иначе
			Возврат "";
		КонецЕсли;
	Иначе
		Возврат "";
	КонецЕсли;			
	
КонецФункции

#КонецОбласти

#Область ТекущиеЦены

// Процедура загружает текущие цены ресурсов из XML.
//
Процедура ЗагрузитьТекущиеЦеныРесурсовИзXML(СтрокаТЧ, Объект, ПараметрыСметы)
	
	Если НЕ ПараметрыСметы.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаДанныхИзФайла

Функция ОпределитьОбработку(Расширение, АдресВременногоХранилища) Экспорт
	ИмяВременногоФайла=ПолучитьИмяВременногоФайла(Расширение);
	ДвоичныеДанные = ПолучитьИЗВременногоХранилища(АдресВременногоХранилища);
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	ПрограммаИсточник = "";
	
	Чтение = Новый ЧтениеXML; 
	Чтение.ОткрытьФайл(ИмяВременногоФайла); 
	Если Чтение.Прочитать() Тогда 
		
		ИмяУзла = Чтение.Имя; 
		
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			
			Если ИмяУзла = "Document" Тогда
				
				Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
					
					
					ТипУзла 		= Чтение.ТипУзла; 
					ИмяПараметра 	= Чтение.Имя; 
					Значение 		= Чтение.Значение;
					
					Если ИмяПараметра = "Generator" Тогда
						ПрограммаИсточник	= "ГРАНД";	
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
			ИначеЕсли ИмяУзла = "Данные" Тогда
				ПрограммаИсточник	= "СМЕТА3";	
			ИначеЕсли ИмяУзла = "estml" Тогда    
				ПрограммаИсточник	= "ESTML";	
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

	Возврат ПрограммаИсточник;
КонецФункции

#КонецОбласти

#КонецОбласти

