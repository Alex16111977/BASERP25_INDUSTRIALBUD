// Параметры:
//     НаименованиеПапки 	- Строка - наименование папки, которую ищем.
//     Каталог 				- СправочникСсылка.СМ_ГруппыРесурсов - каталог ресурсов.
//
// Возвращаемое значение:
//     Спр - СправочникСсылка.СМ_Ресурсы - ссыла на группу справочника ресурсы.
//
Функция СоздатьПолучитьПапкуРесурсов(НаименованиеПапки, Каталог) Экспорт
	МассивРодителей = Новый СписокЗначений;
	ПолучитьВсехРодителей(Каталог,МассивРодителей);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Ресурсы.Ссылка
	|ИЗ
	|	Справочник.СМ_Ресурсы КАК Ресурсы
	|ГДЕ
	|	Ресурсы.Родитель В (&Каталог)
	|	И Ресурсы.Наименование = &Наименование
	|	И Ресурсы.ЭтоГруппа = ИСТИНА";
	
	Запрос.УстановитьПараметр("Наименование", НаименованиеПапки);
	Запрос.УстановитьПараметр("Каталог", МассивРодителей);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		
		СпрОб = Справочники.СМ_Ресурсы.СоздатьГруппу();
		СпрОб.Наименование = НаименованиеПапки;
		СпрОб.Родитель = Каталог;
		СпрОб.УстановитьНовыйКод("ГР");
		СпрОб.Записать();
		Спр = СпрОб.Ссылка;
		
	Иначе
		
		Спр = Выборка.Ссылка;
		
	КонецЕсли;
	
	Возврат Спр;
	
КонецФункции

// Получает все группы указанной группы.
//
// Параметры:
//     ИсходныйЭлемент - СправочникСсылка.СМ_Ресурсы - группа для которой ищем входящие.
//     МассивРодителей - СписокЗначений - список всех групп.
//
Процедура ПолучитьВсехРодителей(ИсходныйЭлемент,МассивРодителей) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_Ресурсы.Ссылка
	               |ИЗ
	               |	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
	               |ГДЕ
	               |	СМ_Ресурсы.Родитель = &Ссылка
	               |	И СМ_Ресурсы.ЭтоГруппа = ИСТИНА";
	Запрос.УстановитьПараметр("Ссылка",ИсходныйЭлемент);
	Выборка = Запрос.Выполнить().Выбрать();
	
	МассивРодителей.Добавить(ИсходныйЭлемент);
	Пока Выборка.Следующий() Цикл
		ТекРодитель = Выборка.Ссылка;
		ПолучитьВсехРодителей(ТекРодитель,МассивРодителей)
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

