// Определяет тип нормативного сборника по коду.
//
// Параметры:
//     Код 			- Строка - двухсимвольный код вида работ из ВНБ.
//     ШифрРасценки - Строка - шифр позиции, для определения в случае сборника текущих цен.
//
// Возвращаемое значение:
//     НС - Перечисления.СМ_ТипыНормативныхСборников - Тип нормативного сборника.
//
Функция ОпределитьТипНормСборникаПоКоду(Код, ШифрРасценки = "") Экспорт
	
	// Ну это просто АХТУНГ....
	// Да, внешняя база она такая.
	
	НС = Перечисления.СМ_ТипыНормативныхСборников.ПустаяСсылка();
	Если Код = "ER" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы;
	ИначеЕсли Код = "VR" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.РемонтноСтроительныеРаботы;
	ИначеЕсли Код = "MO" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.МонтажныеРаботы;
	ИначеЕсли Код = "PU" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.ПусконаладочныеРаботы;
	ИначеЕсли Код = "US" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.УкрупненныеСметныеНормы;
	ИначеЕсли Код = "RS" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.РеставрационноВосстановительныеРаботы;
	ИначеЕсли Код = "CT" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.Транспортировка;
	ИначеЕсли Код = "GH" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.ТехническоеОбслуживание;
	ИначеЕсли Код = "CN" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;
	ИначеЕсли Код = "EM" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин;
	ИначеЕсли Код = "KA" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.КаталогШтучныхКонструкций;
	ИначеЕсли Код = "ZB" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.Прейскурант0608НаСборныйЖелезобетон;
	ИначеЕсли Код = "RT" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.ПрейскурантыНаРемонтТехнологическогоОборудования;
	ИначеЕсли Код = "PR" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.ПрейскурантОптовыхЦенНаМатериалыИОборудование;
	ИначеЕсли Код = "VZ" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.ВременныеЗданияИСооружения;
	ИначеЕсли Код = "CL" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.Калькуляция;
	ИначеЕсли Код = "MM" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.ЦеныНаМестныеМатериалы;
	ИначеЕсли Код = "PB" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.Перебазировка;
	ИначеЕсли Код = "ZV" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.ДополнительныеЗатратыВЗимнееВремя;
	ИначеЕсли Код = "GS" Тогда
		НС = Перечисления.СМ_ТипыНормативныхСборников.СодержаниеОбъектовГородскойСреды;
	ИначеЕсли Код = "TC" Тогда
		Если СтрДлина(ШифрРасценки)<6 Тогда
			НС = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы;	
		ИначеЕсли Найти(ШифрРасценки, "-") = 0 Тогда
			НС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин;
		ИначеЕсли Найти(ШифрРасценки, "-") = 4 Тогда
			НС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;
		ИначеЕсли (Найти(ШифрРасценки, "-") = 3) и (Найти(ШифрРасценки, "-") = 6) и (Лев(ШифрРасценки, 1) = "0") Тогда
			НС = Перечисления.СМ_ТипыНормативныхСборников.Транспортировка;
		Иначе
			НС = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы;	
		КонецЕсли;		
	Иначе	
		НС = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы;
	КонецЕсли;
	
	Возврат НС;
	
КонецФункции

