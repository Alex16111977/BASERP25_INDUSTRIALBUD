//
// Параметры:
//     ШифрРасценки - Строка - шифр позиции, для определения в случае сборника текущих цен.
//     МетодикаТСН 	- Булево - применяется методика ТСН или нет. 
//
// Возвращаемое значение:
//     Глава - Строка - глава базы ТСН.
//
Функция НайтиГлавуВШифре(ШифрРасценки = "", МетодикаТСН = Ложь) Экспорт
	Глава = "";
	Если МетодикаТСН Тогда
		Поз = Найти(ШифрРасценки,".");
		Если Поз <> 0 Тогда
			Глава = Сред(ШифрРасценки, 1, Поз);	
		КонецЕсли;	
	КонецЕсли;	
	Возврат(Глава);
КонецФункции

