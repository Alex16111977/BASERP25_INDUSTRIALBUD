// См. УправлениеДоступомПереопределяемый.ПриЗаполненииИспользованияВидаДоступа.
Процедура ПриЗаполненииИспользованияВидаДоступа(ВидДоступа, Использование) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ВидДоступа = "ГруппыНоменклатуры" Тогда
		
		Использование = Константы.ИспользоватьГруппыДоступаНоменклатуры.Получить();
		
	ИначеЕсли ВидДоступа = "ГруппыПартнеров" Тогда
		
		Использование = Константы.ИспользоватьГруппыДоступаПартнеров.Получить();
		
	ИначеЕсли ВидДоступа = "ГруппыФизическихЛиц" Тогда
		
		Использование = Ложь;
		
	//++ НЕ УТ
	ИначеЕсли ВидДоступа = "ГруппыДоступаВидовБюджетов" Тогда
		
		Использование = Константы.ИспользоватьГруппыДоступаВидовСтатейИПоказателейБюджетов.Получить();
		
	ИначеЕсли ВидДоступа = "ГруппыДоступаСтатейИПоказателейБюджетов" Тогда
		
		Использование = Константы.ИспользоватьГруппыДоступаВидовСтатейИПоказателейБюджетов.Получить();
		
	//-- НЕ УТ
	ИначеЕсли ВидДоступа = "ХозяйственныеОперации"
	 ИЛИ ВидДоступа = "СоглашенияСКлиентамиЧтение"
	  ИЛИ ВидДоступа = "СоглашенияСКлиентамиИзменение" Тогда
		
		Использование = Истина;
		
	КонецЕсли;
	
	УправлениеДоступомЛокализация.ЗаполнитьИспользованиеВидаДоступа(ВидДоступа, Использование);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииОграниченияДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Список, Ограничение) Экспорт
	
	Если Список = Метаданные.Справочники.НаборыДополнительныхРеквизитовИСведений Тогда
		
		Ограничение.Текст =
		"ПрисоединитьДополнительныеТаблицы
		|ЭтотСписок КАК ЭтотСписок
		|
		|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатурыНаборовСвойств 
		|ПО ВидыНоменклатурыНаборовСвойств.НаборСвойств = ЭтотСписок.Ссылка
		|
		|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатурыНаборовСвойствХарактеристик
		|ПО ВидыНоменклатурыНаборовСвойствХарактеристик.НаборСвойствХарактеристик = ЭтотСписок.Ссылка
		|;
		|РазрешитьЧтение
		|ГДЕ ИСТИНА
		|;
		|РазрешитьИзменениеЕслиРазрешеноЧтение
		|ГДЕ
		|	ЭтоГруппа
		|	ИЛИ ЗначениеРазрешено(ВидыНоменклатурыНаборовСвойств.Ссылка)
		|	ИЛИ ЗначениеРазрешено(ВидыНоменклатурыНаборовСвойствХарактеристик.Ссылка)";
		
