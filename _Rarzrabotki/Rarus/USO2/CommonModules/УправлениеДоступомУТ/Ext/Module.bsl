// Проверяет допустимость изменения реквизитов существующего элемента справочника перед записью.
//
// Параметры:
//		Объект - СправочникОбъект - объект любого справочника
//		НепроверяемыеРеквизиты - Строка - перечень реквизитов, изменение которых не надо контролировать
//		Отказ - Булево - признак отказа от записи.
//
Функция ПроверитьДопустимостьИзмененияРеквизитовСправочника(Объект, НепроверяемыеРеквизиты = "", Отказ = Ложь) Экспорт
	
	Если Объект.ЭтоНовый() Тогда
		Возврат Истина; // для новых элементов нет необходимости проверять
	КонецЕсли;
	
	ЭтоГруппа = (Объект.Метаданные().Иерархический И Объект.ЭтоГруппа);
	НедоступныеРеквизиты = ЗначениеНастроекПовтИсп.НедоступныеДляРедактированияРеквизитыСправочника(Объект.Метаданные().Имя, ЭтоГруппа, НепроверяемыеРеквизиты);
	
	Если ПустаяСтрока(НедоступныеРеквизиты) Тогда
		Возврат Истина; // нет недоступных для редактирования реквизитов
	КонецЕсли;
	
	ОшибочноИзмененныеРеквизиты = "";
	
	РеквизитыОбъекта = Новый Структура(НедоступныеРеквизиты);
	ЗаполнитьЗначенияСвойств(РеквизитыОбъекта, Объект);
	
	РеквизитыСсылки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Ссылка, НедоступныеРеквизиты);
	
	Для Каждого КлючИЗначение Из РеквизитыОбъекта Цикл
		Если КлючИЗначение.Значение <> РеквизитыСсылки[КлючИЗначение.Ключ] Тогда
			ОшибочноИзмененныеРеквизиты =
				ОшибочноИзмененныеРеквизиты + ?(ПустаяСтрока(ОшибочноИзмененныеРеквизиты), "", ", ") + """" + КлючИЗначение.Ключ + """";
		КонецЕсли;
	КонецЦикла;
	
	Если ПустаяСтрока(ОшибочноИзмененныеРеквизиты) Тогда
		Возврат Истина; // на все измененные реквизиты есть права
	КонецЕсли;
	
	СообщениеОбОшибке = НСтр("ru = 'Недостаточно прав на изменение реквизит%1 %2';
							|en = 'Insufficient rights to change attribute%1 %2 '");
	СообщениеОбОшибке =
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			СообщениеОбОшибке,
			?(Найти(ОшибочноИзмененныеРеквизиты, ",") > 0, "ов:", "а"),
			ОшибочноИзмененныеРеквизиты);
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке,,,, Отказ);
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#КонецОбласти

