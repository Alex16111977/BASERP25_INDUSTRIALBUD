// Возвращает сводную строку с данными об индексах к позициям
//
// Параметры:
//     МассивПозицийИлиПозицияИлиДокумент - ДокументСсылка.СМ_ПозицияЛокальнойСметы, ДокументСсылка.СМ_ЛокальнаяСмета, 
//											ДокументСсылка.СМ_АктВыполненныхРабот, Массив - ссылка на позицию или 
//											массив ссылок для выборки индексов. 
//											Можно передать смету, тогда все позиции сметы.
//                             		   		Можно передать акт, тогда все позиции акта.
//     СтруктураПараметровРасчетаЛС 	  - Структура - содержит данные о смете (полученная методом
// 		                                    ПолучитьСтруктуруПараметровРасчетаЛС()).
//     СтруктураНовыхДанных 			  - Структура - содержит данные для обновления индексов по другой базе с полями:
//												* КодРайона	- Строка - код района индексов.
//												* СборникКоэффициентов - Строка	- Ид другого сборника.
//												* КодРегиональнойБазы - Строка - Код базы для обновления индексов.
//
// Возвращаемое значение:
//     Данные - Строка - содержит XML с индексами из ВНБ.
//
Функция ПолучитьДанныеОбИндексахПересчета(МассивПозицийИлиПозицияИлиДокумент, СтруктураПараметровРасчетаЛС = Неопределено, СтруктураНовыхДанных = Неопределено) Экспорт
	
	Если СметнаяКомпонента = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) <> Тип("Массив") Тогда
		Если ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
			МассивПозиций = СМ_СметаВызовСервера.ПолучитьМассивВсехПозиций(,МассивПозицийИлиПозицияИлиДокумент);	
		ИначеЕсли ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			МассивПозиций = СМ_СметаВызовСервера.ПолучитьМассивВсехПозиций(МассивПозицийИлиПозицияИлиДокумент);	
		Иначе
			МассивПозиций = СМ_СметаКлиент.ПодготовитьМассивОбъектов(МассивПозицийИлиПозицияИлиДокумент);
		КонецЕсли;
	Иначе
		МассивПозиций = МассивПозицийИлиПозицияИлиДокумент;
	КонецЕсли;
	
	Если МассивПозиций.Количество() = 0 Тогда
		
		Возврат "";
		
	Иначе
		
		МассивДляИндексов = СМ_СметаЗагрузкаВызовСервера.ПолучитьТаблицуПозицийДляИндексовПересчета(МассивПозиций, СтруктураПараметровРасчетаЛС, СтруктураНовыхДанных);
		
		Данные = "<body>";
		Для Каждого ЗаписьОбновления Из МассивДляИндексов Цикл
			Данные = Данные + СметнаяКомпонента.ПолучитьКоэффициенты(ЗаписьОбновления.ШифрыРасценки, ЗаписьОбновления.КодРайона, ЗаписьОбновления.КодРегиональнойБазы, ЗаписьОбновления.СборникКоэффициентов, ЗаписьОбновления.ТипНормативногоСборника);
		КонецЦикла;
		Данные = Данные+"</body>";
		
	КонецЕсли;
	
	Возврат Данные;
		
КонецФункции

// Возвращает сводную строку с данными о текущих ценах к ресурсам позиции (или самой позиции).
//
// Параметры:
//     МассивПозицийИлиПозицияИлиДокумент - ДокументСсылка.СМ_ПозицияЛокальнойСметы, ДокументСсылка.СМ_ЛокальнаяСмета, 
//											ДокументСсылка.СМ_АктВыполненныхРабот, Массив - ссылка на позицию или 
//											массив ссылок для выборки индексов. 
//											Можно передать смету, тогда все позиции сметы.
//                             		   		Можно передать акт, тогда все позиции акта.
//     СтруктураПараметровРасчетаЛС 	  - Структура - содержит данные о смете (полученная методом
// 		                                    ПолучитьСтруктуруПараметровРасчетаЛС()).
//     СтруктураНовыхДанных 			  - Структура - содержит данные для обновления индексов по другой базе с полями:
//												* КодРайона	- Строка - код района индексов.
//												* СборникКоэффициентов - Строка	- Ид другого сборника.
//												* КодРегиональнойБазы - Строка - Код базы для обновления индексов.
//
// Возвращаемое значение:
//     Данные - Строка - содержит XML с индексами из ВНБ.
//
Функция ПолучитьДанныеОТекущихЦенах(МассивПозицийИлиПозицияИлиДокумент, СтруктураПараметровРасчетаЛС = Неопределено, СтруктураНовыхДанных = Неопределено) Экспорт
	
	Если СметнаяКомпонента = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) <> Тип("Массив") Тогда
		Если ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
			МассивПозиций = СМ_СметаВызовСервера.ПолучитьМассивВсехПозиций(,МассивПозицийИлиПозицияИлиДокумент);	
		ИначеЕсли ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			МассивПозиций = СМ_СметаВызовСервера.ПолучитьМассивВсехПозиций(МассивПозицийИлиПозицияИлиДокумент);	
		Иначе
			МассивПозиций = СМ_СметаКлиент.ПодготовитьМассивОбъектов(МассивПозицийИлиПозицияИлиДокумент);
		КонецЕсли;
	Иначе
		МассивПозиций = МассивПозицийИлиПозицияИлиДокумент;
	КонецЕсли;
	
	Если МассивПозиций.Количество() = 0 Тогда
		
		Возврат "";
		
	Иначе
		
		МассивДляИндексов = СМ_СметаЗагрузкаВызовСервера.ПолучитьТаблицуРесурсовДляТекущихЦен(МассивПозиций, СтруктураПараметровРасчетаЛС, СтруктураНовыхДанных);
		
		Данные = "<body>";
		Для Каждого ЗаписьОбновления Из МассивДляИндексов Цикл
			Данные = Данные + СметнаяКомпонента.GetPrices(ЗаписьОбновления.ШифрыРасценки, ЗаписьОбновления.КодРайона, ЗаписьОбновления.КодРегиональнойБазы, ЗаписьОбновления.СборникТекущихЦен);
		КонецЦикла;
		Данные = Данные+"</body>";
		
	КонецЕсли;
	
	Возврат Данные;
		
КонецФункции

// Возвращает сводную строку с данными о текущих ценах к ресурсам.
//
// Параметры:
//     Объект 						- СправочникСсылка - ссылка на объект для выборки индексов.
//     СтруктураПараметровРасчетаЛС - Структура - содержит данные о смете (полученная методом
//                                    ПолучитьСтруктуруПараметровРасчетаЛС()).
//     Смета 						- ДокументСсылка.СМ_ЛокальнаяСмета - Локальная смета.
//
// Возвращаемое значение:
//     Данные - Строка - содержит XML с текущими ценами из ВНБ.
//
Функция ПолучитьДанныеОТекущихЦенахРесурсов(Объект, СтруктураПараметровРасчетаЛС, Смета) Экспорт
	
	Если СметнаяКомпонента = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	МассивДляИндексов = СМ_СметаЗагрузкаВызовСервера.ПолучитьТаблицуРесурсовДляТекущихЦенПоОбъекту(Объект, СтруктураПараметровРасчетаЛС, Смета);
	
	Данные = "<body>";
	Для Каждого ЗаписьОбновления Из МассивДляИндексов Цикл
		Данные = Данные + СметнаяКомпонента.GetPrices(ЗаписьОбновления.ШифрыРасценки, ЗаписьОбновления.КодРайона, ЗаписьОбновления.КодРегиональнойБазы, ЗаписьОбновления.СборникТекущихЦен);
	КонецЦикла;
	Данные = Данные+"</body>";
	
	Возврат Данные;
		
КонецФункции

#КонецОбласти

#Область ЗагрузкаДанныхИзВНБ

// Обработка заполнения внутренних справочников из ВНБ.
//
// Параметры:
//     СписокСНБ 			- Массив - содержит элементы СНБ для обновления (если не указан, обновляются все).
//     СметнаяКомпонента 	- COM - компонента ВНБ.
//     ВерсияКомпоненты 	- Число - версия внешней нормативной базы.
//
Процедура ОбновитьСНБ(СписокСНБ = Неопределено, СметнаяКомпонента = Неопределено, ВерсияКомпоненты = 1) Экспорт
	
	Заполнять = ?(СписокСНБ=неопределено, Истина, ?(СписокСНБ.Количество()>0, Истина, Ложь));
	
	Если Заполнять Тогда
		
		СписокБаз = Новый СписокЗначений();
		Если Не СписокСНБ = Неопределено Тогда
			СписокБаз.ЗагрузитьЗначения(СписокСНБ);
		КонецЕсли;
		ПараметрыДляФормыВыбора = Новый Структура("СписокСНБ, ВерсияКомпоненты", СписокБаз, ВерсияКомпоненты);
		ОткрытьФорму("ОбщаяФорма.СМ_ОбновлениеНормативныхДанных",ПараметрыДляФормыВыбора,,,,,,РежимОткрытияОкнаФормы.Независимый);
		
	КонецЕсли;
	
КонецПроцедуры

// Обновляет единицы измерения из ВНБ.
//
// Параметры:
//    СметнаяКомпонента 	- COM - компонента ВНБ.
//
Процедура ОбновитьЕдиницыИзмерения(СметнаяКомпонента) Экспорт
	
	ДанныеДляОбновления = СметнаяКомпонента.ПровестиОбновлениеЕдиницИзмерения();	
	Если ДанныеДляОбновления = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	СМ_СметаЗагрузкаВызовСервера.ОбновитьЕдиницыИзмерения(ДанныеДляОбновления);
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Единицы измерения обновлены'"));	
	
КонецПроцедуры

#КонецОбласти

