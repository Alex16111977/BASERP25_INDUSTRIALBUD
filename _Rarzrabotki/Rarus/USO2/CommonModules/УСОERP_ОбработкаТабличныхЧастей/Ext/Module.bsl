
#Область ЗаполнениеТаблицыИзДереваЗначений

// Функция предназначена для заполнения табличной части объекта документа
// из дерева значений формы
// Дерево - ДеревоЗначений
// ТабличнаяЧасть - Табличная часть документа, Таблица значентий
//
Функция ЗаполнитьТаблицуИзДереваЗначений(Дерево, ТабличнаяЧасть) Экспорт
    Для Каждого СтрокаДерева Из Дерево.Строки Цикл
        ЗаполнитьЗначенияСвойств(ТабличнаяЧасть.Добавить(), СтрокаДерева);
        ЗаполнитьТаблицуИзДереваЗначений(СтрокаДерева, ТабличнаяЧасть);
    КонецЦикла;
    Возврат ТабличнаяЧасть;
КонецФункции

#КонецОбласти

#Область Прочее

// <Описание функции>
//
// Параметры:
//  ДокументОснование      – ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств,
//                           ДокументСсылка.ПосткплениеДенежныхДокументов,
//                           ДокументСсылка.ПриходныйКассовыйОрдер – ссылка на платежный документ;
//  ДокументРаспределения  – ДокументСсылка.УПН_РаспределениеОплатИРасчетовПоОбъектамНедвижимости – ссылка на документ распределения.
//                 <продолжение описания параметра>.
//
// Возвращаемое значение:
//               – Число – сумма документа основания подлежащая распределению.
//
Функция ПолучитьСуммуОснованияДляРаспределенияОплатПоОбъектамНедвижимости(ДокументОснование, ДокументРаспределения) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	РаспределениеОплат.ДокументОснование.СуммаДокумента КАК СуммаДокументаОснования
	|ПОМЕСТИТЬ ДанныеПоСуммеДокументаОснования
	|ИЗ
	|	Документ.УПН_РаспределениеОплатИРасчетовПоОбъектамНедвижимости КАК РаспределениеОплат
	|ГДЕ
	|	РаспределениеОплат.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	-ТаблицаРасшифровкаПлатежа.Сумма
	|ИЗ
	|	Документ.УПН_РаспределениеОплатИРасчетовПоОбъектамНедвижимости.РасшифровкаПлатежа КАК ТаблицаРасшифровкаПлатежа
	|ГДЕ
	|	ТаблицаРасшифровкаПлатежа.Ссылка <> &Ссылка
	|	//УСЛОВИЕ_ДАТЫ
	|	И ТаблицаРасшифровкаПлатежа.Ссылка.ДокументОснование = &ДокументОснование
	|	И ТаблицаРасшифровкаПлатежа.Ссылка.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ДанныеПоСуммеДокументаОснования.СуммаДокументаОснования) КАК СуммаДокументаОснования
	|ИЗ
	|	ДанныеПоСуммеДокументаОснования КАК ДанныеПоСуммеДокументаОснования");
	
	Запрос.УстановитьПараметр("Ссылка", ДокументРаспределения);
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	ТекстУсловияДаты = ?(ЗначениеЗаполнено(ДокументРаспределения)
	                     , "И ТаблицаРасшифровкаПлатежа.Ссылка.МоментВремени < &МоментВремени"
						 , "И ТаблицаРасшифровкаПлатежа.Ссылка.Дата <= &МоментВремени");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УСЛОВИЕ_ДАТЫ", ТекстУсловияДаты);
	Запрос.УстановитьПараметр("МоментВремени", ?(ЗначениеЗаполнено(ДокументРаспределения), ДокументРаспределения.МоментВремени(), ТекущаяДата()));
	
	//Запрос.УстановитьПараметр("Валюта", Валюта);
	//
	//ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	//Коэффициенты = РаботаСКурсамивалютУТ.ПолучитьКоэффициентыПересчетаВалюты(
	//	Валюта, 
	//	,
	//	ДокументОснование.Дата);
	//
	//Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета",         ВалютаРегламентированногоУчета);
	//Запрос.УстановитьПараметр("КоэффициентПересчетаВВалютуРегл",        Коэффициенты.КоэффициентПересчетаВВалютуРегл);
	
	СуммаДокументаОснования = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.СуммаДокументаОснования) Тогда
		СуммаДокументаОснования = Выборка.СуммаДокументаОснования;
	КонецЕсли;
	
	Возврат СуммаДокументаОснования;

КонецФункции // ПолучитьСуммуОснованияДляРаспределенияОплатПоОбъектамНедвижимости()

#КонецОбласти


#Область СортировкаДеревьев


//Функция Формирует Дерево работ с сортировкой по полям КодСДР и НомерРаботыВУровне
Функция УСОERP_СформироватьДеревоУниверсальная(ДанныеДляДерева, 
									ВыражениеИсточник = "Работа", 
									ВыражениеПриемник = "РаботаРодитель", 
									НачальныйУровеньДерева, 
									ФорматВозврата = "ДеревоЗначений") Экспорт
									
	Если ФорматВозврата = "ДеревоЗначений" Тогда
		ВозвратРезультат = Новый ДеревоЗначений;
	Иначе
		ВозвратРезультат = Новый ТаблицаЗначений;	
	КонецЕсли;
	
	//0.Удаление не весть откуда взявшихся пустых строчек
	//при выгрузке в дерево падает  документ "Условия по договору с заказчиком, подрядчиком"
	Если ФорматВозврата = "ДеревоЗначений" И ТипЗнч(ДанныеДляДерева) = Тип("ТаблицаЗначений") И ДанныеДляДерева.Колонки.Найти("Работа")<> Неопределено
		И ВыражениеИсточник = "Работа" И ВыражениеПриемник = "РаботаРодитель" Тогда
		Строки = ДанныеДляДерева.НайтиСтроки(Новый Структура("Работа",Справочники.УСОERP_СтроительныеРаботы.ПустаяСсылка()));
		Для Каждого НайденнаяСтрока ИЗ Строки Цикл
			ДанныеДляДерева.Удалить(НайденнаяСтрока);
		КонецЦикла;
		//Горский
		СтрокаСвертки = "";
		Для Каждого Колонка ИЗ ДанныеДляДерева.Колонки Цикл
			
			СтрокаСвертки = СтрокаСвертки+Колонка.Имя+",";
			
		КонецЦикла;
		СтрокаСвертки = Лев(СтрокаСвертки,СтрДлина(СтрокаСвертки)-1);
		ДанныеДляДерева.Свернуть(СтрокаСвертки);
		
	КонецЕсли; 									
	
	// 1. - создание схемы
	СхемаКомпоновкиДанных = Новый СхемаКомпоновкиДанных;
	
	ИсточникДанных = СхемаКомпоновкиДанных.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";	
	
	//
	НаборДанных = СхемаКомпоновкиДанных.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя			= "ДеревоРаботы";
	НаборДанных.ИмяОбъекта	= "ДанныеДляДерева";
	НаборДанных.ИсточникДанных= "ИсточникДанных1";
	
	Для каждого ПолеТаблицы Из ДанныеДляДерева.Колонки Цикл
		НовоеПоле                = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		НовоеПоле.Поле      	 = ПолеТаблицы.Имя;
		НовоеПоле.ПутьКДанным    = ПолеТаблицы.Имя;
		НовоеПоле.Заголовок      = ПолеТаблицы.Заголовок;			
		НовоеПоле.ТипЗначения    = ПолеТаблицы.ТипЗначения;
	КонецЦикла; 		
	
	//
	Связь = СхемаКомпоновкиДанных.СвязиНаборовДанных.Добавить();
	Связь.НаборДанныхИсточник = "ДеревоРаботы";
	Связь.НаборДанныхПриемник = "ДеревоРаботы";
	Связь.ВыражениеИсточник   = ВыражениеИсточник ;
	Связь.ВыражениеПриемник   = ВыражениеПриемник;
	Связь.НачальноеВыражение  = "&НачальныйУровеньДерева"; 
	Связь.Обязательная        = Истина;
	//Связь.РазрешенСписокПараметров = Истина;
	
	//
	Параметр = СхемаКомпоновкиДанных.Параметры.Добавить();
	Параметр.Имя = "НачальныйУровеньДерева";
	Параметр.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
	Параметр.ТипЗначения = ДанныеДляДерева.Колонки[ВыражениеИсточник].ТипЗначения;
	//Параметр.ДоступенСписокЗначений = Истина;
	
	// 2. Созданиие компоновщика макета
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
  	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	// Добавление в структуру группировки детальных записей с её выбранными полями
	ДетальныеЗаписи = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ДетальныеЗаписи.Использование = Истина;
	
	АвтоВыбранноеПоле = ДетальныеЗаписи.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	АвтоВыбранноеПоле.Использование = Истина;
	
	АвтоЭлементПорядка = ДетальныеЗаписи.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	АвтоЭлементПорядка.Использование = Истина;
	
	// Выбранные поля группировки ДЕТАЛЬНЫХ ЗАПИСЕЙ
	ПолеСКДКодСДР             = Неопределено;
	ПолеСКДКодСДРЧисло        = Неопределено;
	ПолеСКДНомерРаботыВУровне = Неопределено;
	Для каждого ПолеТаблицы Из ДанныеДляДерева.Колонки Цикл
		ПолеВыбора               = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ПолеВыбора.Поле          = Новый ПолеКомпоновкиДанных(ПолеТаблицы.Имя);
		ПолеВыбора.Заголовок     = ПолеТаблицы.Имя;
		ПолеВыбора.Использование = Истина;
		Если ПолеТаблицы.Имя = "КодСДРЧисло" Тогда
			ПолеСКДКодСДРЧисло =  ПолеВыбора.Поле;
		КонецЕсли; 
		Если ПолеТаблицы.Имя = "КодСДР" Тогда
			ПолеСКДКодСДР =  ПолеВыбора.Поле;
		КонецЕсли; 
		Если ПолеТаблицы.Имя = "НомерРаботыВУровне" Тогда
			ПолеСКДНомерРаботыВУровне =  ПолеВыбора.Поле;
		КонецЕсли; 
	КонецЦикла;

	//	
	//Если НЕ ПолеСКДКодСДРЧисло = Неопределено Тогда
	//	ПолеСортировкиКодСДР                   = Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	//	ПолеСортировкиКодСДР.Поле              = ПолеСКДКодСДРЧисло;
	//	ПолеСортировкиКодСДР.Использование     = Истина;
	//	ПолеСортировкиКодСДР.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
	//КонецЕсли; 
	Если НЕ ПолеСКДНомерРаботыВУровне = Неопределено Тогда
		ПолеСортировкиНомерРаботыВУровне                   = Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
		ПолеСортировкиНомерРаботыВУровне.Поле              = ПолеСКДНомерРаботыВУровне;
		ПолеСортировкиНомерРаботыВУровне.Использование     = Истина;
		ПолеСортировкиНомерРаботыВУровне.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
	КонецЕсли; 
	//Если НЕ ПолеСКДКодСДР = Неопределено Тогда
	//	ПолеСортировкиКодСДР                   = Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	//	ПолеСортировкиКодСДР.Поле              = ПолеСКДКодСДР;
	//	ПолеСортировкиКодСДР.Использование     = Истина;
	//	ПолеСортировкиКодСДР.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
	//КонецЕсли; 
	//
	//СписокРодителей = Новый СписокЗначений;
	//СписокРодителей.ЗагрузитьЗначения(НачальныйУровеньДерева);
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(Настройки, "НачальныйУровеньДерева", НачальныйУровеньДерева);
	
	// 3. - фрмирование макета компоновки
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	//инициализация процессора СКД
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,	Новый Структура("ДанныеДляДерева", ДанныеДляДерева));
		
	//инициализация процессора вывода
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ВозвратРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат ВозвратРезультат;

КонецФункции // УСОERP_СформироватьДеревоУниверсальная()


// Функция Преобразует КодСДР в число 
//    Параметр - КодСДР
//    Возврат в формате: Первый уровень = целая часть, остальное дробная
//    Пример 1.1.2 ==> 1,12  
// 	
Функция КодСДРвЧисло(КодСДР) Экспорт
	
	//На случай, если нельзя преобразовать в число.
	Если НЕ ПустаяСтрока(КодСДР) Тогда
		Попытка
			ОНО = Число(СтрЗаменить(КодСДР,".",""));
		Исключение
			Возврат КодСДР;
		КонецПопытки;
	КонецЕсли;

	Разрядность = 4;
	Если НЕ КодСДР = неопределено Тогда
		пКодСДР = ?(СОКРЛП(КодСДР)="", "0", СтрЗаменить(СтрЗаменить(КодСДР, ",", ".")," ",""));
		ЦелаяЧастьСформирована = Ложь;
		ЦелаяЧасть   = "";
		ДробнаяЧасть = "";
		Инд   = 1;
		Уровень = 0;
		Если СтрЧислоВхождений(пКодСДР,".") >=1 Тогда
			пКодСДР = пКодСДР+".";
			Пока Инд <= СтрДлина(пКодСДР)  Цикл
				Симв = Сред(пКодСДР,Инд,1);
				Если НЕ ЦелаяЧастьСформирована Тогда
					Если Симв <> "."  Тогда
						ЦелаяЧасть = ЦелаяЧасть + Симв;
					Иначе	
					    ЦелаяЧастьСформирована = Истина;
						КодСДРЧисло = Число(ЦелаяЧасть);
						Уровень = 1;
					КонецЕсли; 
				Иначе
					Если Симв <> "." Тогда
						ДробнаяЧасть = ДробнаяЧасть +  Симв;
					Иначе	
						КодСДРЧисло = КодСДРЧисло + Число(ДробнаяЧасть)/(Pow(10, Уровень*Разрядность));
						Уровень= Уровень+1;
						ДробнаяЧасть = "";
					КонецЕсли; 
				КонецЕсли; 
				Инд = Инд+1;
			КонецЦикла;			
		Иначе
			КодСДРЧисло = Число(пКодСДР);
		КонецЕсли;
	КонецЕсли;
			
	Возврат КодСДРЧисло;

КонецФункции // КодСДРвЧисло()

// определение начальный уровней дерева
//
// Параметры:
//  <ДанныеДляДерева>  - <ТаблицаЗначений> - Исходные данные для дерева
//  <ИмяПоля>  - <Строка> - Наименование поля, родтелей строк которых выбираем
//
// Возвращаемое значение:
//   <Массив>   - <описание возвращаемого значения>
//
Функция ОпределениеНачальныхУровней(ДанныеДляДерева, ИмяПоля, Справочник)
	
	СтрокаРодительСтар =  Справочник.ПустаяСсылка();
	НачальныеУровниДерева = Новый Массив;
	Для каждого Строка Из ДанныеДляДерева Цикл
		СтрокаРаботаРодитель = Строка[ИмяПоля].Родитель;
		Если СтрокаРаботаРодитель = Справочник.ПустаяСсылка() Тогда
			НачальныеУровниДерева.Очистить();
			НачальныеУровниДерева.Добавить(СтрокаРаботаРодитель);
			Возврат НачальныеУровниДерева;
		КонецЕсли; 	
		
		Если НЕ СтрокаРаботаРодитель = СтрокаРодительСтар Тогда
		    НачальныеУровниДерева.Добавить(СтрокаРаботаРодитель);
			СтрокаРодительСтар =  СтрокаРаботаРодитель;
		КонецЕсли; 	
	КонецЦикла; 

	Если НачальныеУровниДерева.Количество()=2
		Тогда
	    НачальныеУровниДерева.Удалить(0);
	КонецЕсли; 
	
	
	Возврат НачальныеУровниДерева;


КонецФункции // ОпределениеНачальногоУровня()

// определение начальный уровней дерева
//
// Параметры:
//  <ДанныеДляДерева>  - <ТаблицаЗначений> - Исходные данные для дерева
//  <ИмяПоля>  - <Строка> - Наименование поля, родтелей строк которых выбираем
//
// Возвращаемое значение:
//   <Массив>   - <описание возвращаемого значения>
//
Функция ВосстановитьДерево(ДанныеДляДерева, ИмяПоля,ИмяПоляРодитель, ИмяПоляНаименование="", Справочник)
	
	Для каждого Строка Из ДанныеДляДерева Цикл
		
		Если ТипЗНЧ(Строка[ИмяПоля])= Тип("СправочникСсылка.УСОERP_СтроительныеРаботы")  Тогда
			
			Корень = Строка[ИмяПоля].Родитель;
			
			Если Корень  <> Справочник.ПустаяСсылка() И ДанныеДляДерева.Найти(Корень,ИмяПоля)=Неопределено Тогда
				
				Для каждого СтрокаПоиска Из ДанныеДляДерева Цикл
					
					Если СтрокаПоиска[ИмяПоля].Родитель <> Корень  Тогда
						//Если Корень  <> Справочник.ПустаяСсылка() И ДанныеДляДерева.Найти(Корень,ИмяПоля)=Неопределено Тогда
						НовыйРодитель                 = ДанныеДляДерева.Добавить();
						НовыйРодитель[ИмяПоля]        = Корень;
						Если  ЗначениеЗаполнено(ИмяПоляНаименование) Тогда
							НовыйРодитель[ИмяПоляНаименование]        = Корень;
						КонецЕсли; 
						НовыйРодитель[ИмяПоляРодитель]= Корень.Родитель;
						НовыйРодитель.КодСДР          = Корень.КодСДР;
						НовыйРодитель.КодСДРЧисло     = КодСДРвЧисло(Корень.КодСДР);
						Корень = НовыйРодитель[ИмяПоля].Родитель;
						//КонецЕсли; 
						
					КонецЕсли;
					
				КонецЦикла; 
				
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЦикла;	
	
	Возврат ДанныеДляДерева;   
	
КонецФункции // ОпределениеНачальногоУровня()

//
Функция ДобавитьСтрокиРодителей(ДанныеДляДерева,НачальныеУровниДерева,НачальныйУровеньДерева,ИмяПоля,Справочник)

	Если НачальныеУровниДерева.Количество()=1 И НачальныеУровниДерева[0] = Справочник.ПустаяСсылка() Тогда
		Возврат ДанныеДляДерева; 
	КонецЕсли; 
	Для каждого Узел Из НачальныеУровниДерева Цикл
		//Проверим общего родителя для узлов, если таковой существует
		ПолеРодителя = Узел.Родитель;
		Если НЕ НачальныеУровниДерева.Найти(ПолеРодителя) = Неопределено 
			 И НачальныеУровниДерева.Найти(ПолеРодителя) >0  
			 //И НЕ ЗначениеЗаполнено(ПолеРодителя) 
			 Тогда
			НоваяСтрока = ДанныеДляДерева.Добавить();
			НоваяСтрока.Работа = Узел;
			Если ТипЗнч(Узел) = Тип("СправочникСсылка.УСОERP_СтроительныеРаботы") Тогда  
				НоваяСтрока.КодСДР =Узел.КодСДР;
				НоваяСтрока.КодСДРЧисло =КодСДРвЧисло(Узел.КодСДР);
				НоваяСтрока.НомерРаботыВУровне =Узел.НомерРаботыВУровне;
			КонецЕсли;	
			НоваяСтрока.РаботаРодитель =Узел.Родитель;
		ИначеЕсли  ДанныеДляДерева.Найти(Узел,ИмяПоля) = Неопределено  
			 И НЕ ЗначениеЗаполнено(ПолеРодителя) 
			 И НЕ Узел.Пустая()
			 Тогда
			НоваяСтрока = ДанныеДляДерева.Добавить();
			НоваяСтрока.Работа = Узел;
			Если ТипЗнч(Узел) = Тип("СправочникСсылка.УСОERP_СтроительныеРаботы") Тогда  
				НоваяСтрока.КодСДР =Узел.КодСДР;
				НоваяСтрока.КодСДРЧисло =КодСДРвЧисло(Узел.КодСДР);
				НоваяСтрока.НомерРаботыВУровне =Узел.НомерРаботыВУровне;
			КонецЕсли;	
			НоваяСтрока.РаботаРодитель =НачальныйУровеньДерева;
		КонецЕсли; 
	КонецЦикла; 
	
	Возврат ДанныеДляДерева; 

КонецФункции // ДобавитьСтрокиРодителей()

Функция ДополнитьНедостающиеПоляСортировки(ДанныеДляДерева,Справочник)

	Если ДанныеДляДерева.Колонки.Найти("Работа") <> Неопределено Тогда
		Если ДанныеДляДерева.Колонки.Найти("КодСДР") = Неопределено Тогда
	    	ДанныеДляДерева.Колонки.Добавить("КодСДР",Новый ОписаниеТипов("Строка"),"КодСДР");
		КонецЕсли;
		Если ДанныеДляДерева.Колонки.Найти("КодСДРЧисло") = Неопределено Тогда
	    	ДанныеДляДерева.Колонки.Добавить("КодСДРЧисло",Новый ОписаниеТипов("Число"),"КодСДРЧисло");
		КонецЕсли;
		Если ДанныеДляДерева.Колонки.Найти("НомерРаботыВУровне") = Неопределено Тогда
			ДанныеДляДерева.Колонки.Добавить("НомерРаботыВУровне",Новый ОписаниеТипов("Число"),"НомерРаботыВУровне");
		КонецЕсли;
		Если ДанныеДляДерева.Колонки.Найти("РаботаРодитель") = Неопределено Тогда
			ДанныеДляДерева.Колонки.Добавить("РаботаРодитель",Новый ОписаниеТипов("СправочникСсылка.УСОERP_СтроительныеРаботы"),"РаботаРодитель");
		КонецЕсли;
	КонецЕсли; 
	
	
	Для Каждого СтрокаТЗ Из ДанныеДляДерева Цикл
		Если ДанныеДляДерева.Колонки.Найти("Работа") <> Неопределено Тогда 
			Если  НЕ ЗначениеЗаполнено(СтрокаТЗ.РаботаРодитель) 
				//И (НЕ СтрокаТЗ.РаботаРодитель = Справочник.ПустаяСсылка() ) 
				Тогда 
				СтрокаТЗ.РаботаРодитель = СтрокаТЗ.Работа.Родитель;					
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаТЗ.КодСДР) Тогда 
				Если ТипЗнч(СтрокаТЗ.Работа) = Тип("СправочникСсылка.УСОERP_СтроительныеРаботы") Тогда
					СтрокаТЗ.КодСДР      = СтрокаТЗ.Работа.КодСДР;
					СтрокаТЗ.КодСДРЧисло = КодСДРвЧисло(СтрокаТЗ.КодСДР);
				Иначе
					СтрокаТЗ.КодСДР = Неопределено
				КонецЕсли; 
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СтрокаТЗ.НомерРаботыВУровне) Тогда
				Если  ТипЗнч(СтрокаТЗ.Работа) = Тип("СправочникСсылка.УСОERP_СтроительныеРаботы") Тогда  
					СтрокаТЗ.НомерРаботыВУровне = ?(СтрокаТЗ.КодСДР = "",0,СтрокаТЗ.Работа.НомерРаботыВУровне);		
				Иначе
					СтрокаТЗ.НомерРаботыВУровне = Неопределено
				КонецЕсли; 
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаТЗ.КодСДР) Тогда 
				СтрокаТЗ.КодСДРЧисло = КодСДРвЧисло(СтрокаТЗ.КодСДР);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	//ДанныеДляДерева.Сортировать("КодСДРЧисло");

	Возврат ДанныеДляДерева;

КонецФункции // Дополнить недостающиеПоля()
 
// Подготавливает данные для строительства дерева и строит дерево
//
// Параметры:
//  <ТаблицаРабот>  - <Тип.ТаблицаЗначений> - Данные для дерева
//  <Справочник>  - <Тип.Справочник> - <описание параметра>
//                 <продолжение описания параметра>
//
Функция УСОERP_ПодготовитьДанныеИСформироватьДерево(ДанныеДляДерева,ВыражениеИсточник,ВыражениеПриемник,Справочник)  Экспорт

	НачальныйУровеньДерева = Справочник.ПустаяСсылка();
	НачальныеУровниДерева  = ОпределениеНачальныхУровней(ДанныеДляДерева, ВыражениеИсточник, Справочник);
	ДанныеДляДерева = ДополнитьНедостающиеПоляСортировки(ДанныеДляДерева,Справочник);
	ДанныеДляДерева = ДобавитьСтрокиРодителей(ДанныеДляДерева,НачальныеУровниДерева,НачальныйУровеньДерева,ВыражениеИсточник,Справочник);
	
	//
	ДеревоРезультат = УСОERP_СформироватьДеревоУниверсальная(ДанныеДляДерева,ВыражениеИсточник,ВыражениеПриемник,НачальныйУровеньДерева);

	Возврат ДеревоРезультат;
	
КонецФункции // ПодготовитьДанныеДляСортировки()

// Подготавливает данные для строительства дерева и строит дерево
//
// Параметры:
//  <ТаблицаРабот>  - <Тип.ТаблицаЗначений> - Данные для дерева
//  <Справочник>  - <Тип.Справочник> - <описание параметра>
//                 <продолжение описания параметра>
//
Функция УСОERP_ПодготовитьДанныеИСформироватьДеревоСВосстановлениемСтруктуры(ДанныеДляДерева,ВыражениеИсточник,ВыражениеПриемник,ИмяПоляНаименование,Справочник)  Экспорт

	НачальныйУровеньДерева = Справочник.ПустаяСсылка();
	ДанныеДляДерева = ДополнитьНедостающиеПоляСортировки(ДанныеДляДерева,Справочник);
	ДанныеДляДерева = ВосстановитьДерево(ДанныеДляДерева, ВыражениеИсточник,ВыражениеПриемник, ИмяПоляНаименование, Справочник);
	
	ДеревоРезультат = УСОERP_СформироватьДеревоУниверсальная(ДанныеДляДерева,ВыражениеИсточник,ВыражениеПриемник,НачальныйУровеньДерева);

	Возврат ДеревоРезультат;
	
КонецФункции // ПодготовитьДанныеДляСортировки()

Процедура УСОERP_ЗаполнитьРоднуюСтруктуруДереваИзВнешнего(СтрокиДеревоРодное, СтрокиДеревоВнешнее)  Экспорт

	 Для каждого СтрокаДереваВнешнее Из СтрокиДеревоВнешнее Цикл
		 
		НоваяСтрокаДерева = СтрокиДеревоРодное.Добавить();
	 	ЗаполнитьЗначенияСвойств(НоваяСтрокаДерева, СтрокаДереваВнешнее);
		
		УСОERP_ЗаполнитьРоднуюСтруктуруДереваИзВнешнего(НоваяСтрокаДерева.Строки, СтрокаДереваВнешнее.Строки);
	 КонецЦикла;

КонецПроцедуры // ЗаполнитьДеревоРекурсивно()

Процедура СортироватьТаблицу(ВходнаяТаблица) Экспорт
	
	ТаблицаРабот = ВходнаяТаблица.Выгрузить();
	ТаблицаРабот.Колонки.Добавить("КодСДРЧисло", Новый ОписаниеТИпов("Число"));
	Для Каждого СтрокаТЗ Из ТаблицаРабот Цикл
		КодСДР = СтрокаТЗ.Работа.КодСДР;
		СтрокаТЗ.КодСДРЧисло = КодСДРвЧисло(КодСДР);
	КонецЦикла;
	ТаблицаРабот.Сортировать("КодСДРЧисло");
	
	ВходнаяТаблица.Очистить();
	ВходнаяТаблица.Загрузить(ТаблицаРабот);
	
КонецПроцедуры

Процедура ОбработатьСтрокиДереваЗначений(Строки, НаименованиеСтрокиИерархии = "Работа") Экспорт
	
	МассивУдаляемыхСтрок = Новый Массив;
	
	Для Каждого ТекСтрока Из Строки Цикл
				
		Если ЗначениеЗаполнено(ТекСтрока.Родитель) 
			И ТекСтрока.Родитель.Работа = ТекСтрока.Работа Тогда
			
			ЗаполнитьЗначенияСвойств(ТекСтрока.Родитель, ТекСтрока);
			
			Для Каждого ПодчиненнаяСтрока Из ТекСтрока.Строки Цикл
				НоваяСтрока = ТекСтрока.Родитель.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ПодчиненнаяСтрока);
			КонецЦикла;
			МассивУдаляемыхСтрок.Добавить(ТекСтрока);
			
		ИначеЕсли ТекСтрока.Строки.Количество() <> 0
			И ЗначениеЗаполнено(ТекСтрока.Работа) Тогда
			
			ОбработатьСтрокиДереваЗначений(ТекСтрока.Строки, НаименованиеСтрокиИерархии);
			
		ИначеЕсли Не ЗначениеЗаполнено(ТекСтрока.Работа)
			И ТекСтрока.Строки.Количество() <> 0 Тогда
			
			Для Каждого СтрокаРаботыВерхнегоУровня Из ТекСтрока.Строки Цикл
				НоваяСтрока = Строки.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаботыВерхнегоУровня);
			КонецЦикла;
			
			МассивУдаляемыхСтрок.Добавить(ТекСтрока);
			
		КонецЕсли;
				
	КонецЦикла;	
	
	Для Каждого ТекУдаляемаяСтрока Из МассивУдаляемыхСтрок Цикл
		Строки.Удалить(ТекУдаляемаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти



