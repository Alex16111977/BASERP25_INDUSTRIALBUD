#Область ПрограммныйИнтерфейс

// Функция предназначена для формирования наименования по заданному шаблону.
//
// Параметры:
//  ВидОбъекта    - вид заполняемого объекта.
//  ДанныеОбъекта - данные для подстановки.
// 
// Возвращаемое значение:
//   - результат подстановки.
//
Функция СформироватьНаименованиеПоШаблону(Знач ВидОбъекта, ДанныеОбъекта, ПользовательскийШаблон=Неопределено) Экспорт
	
	ХранилищеШаблонов = Константы.уатНастройкиШаблонов.Получить();
	Если ХранилищеШаблонов = Неопределено Тогда 
		НастройкиШаблонов = Неопределено;
	Иначе 
		НастройкиШаблонов = ХранилищеШаблонов.Получить();
	КонецЕсли;
	
	Если НастройкиШаблонов = Неопределено Тогда 
		НастройкиШаблонов = Новый Структура();
	КонецЕсли;
	
	Если Не ПользовательскийШаблон = Неопределено Тогда 
		ТекстШаблона = ПользовательскийШаблон;
		
	ИначеЕсли НастройкиШаблонов.Свойство(ВидОбъекта) Тогда 
		ТекстШаблона = НастройкиШаблонов[ВидОбъекта];
		
	Иначе 
		ТекстШаблона = ПолучитьТекстШаблонаПоУмолчанию(ВидОбъекта);
	КонецЕсли;
	
	Если ВидОбъекта = "Справочник_ТранспортныеСредства" Тогда 
		Возврат ПодставитьПараметрыВШаблон_Справочник_ТранспортныеСредства(ТекстШаблона, ДанныеОбъекта);
		
	ИначеЕсли ВидОбъекта = "Справочник_уатПунктыНазначения" Тогда
		Возврат ПодставитьПараметрыВШаблон_Справочник_уатПунктыНазначения(ТекстШаблона, ДанныеОбъекта);
		
	ИначеЕсли ВидОбъекта = "Справочник_УзлыОбъектовЭксплуатации" Тогда
		Возврат ПодставитьПараметрыВШаблон_Справочник_УзлыОбъектовЭксплуатации(ТекстШаблона, ДанныеОбъекта);
		
	Иначе 
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Процедура заполняет реквизит формы "ДоступныеПараметры".
//
// Параметры:
//  Форма - управляемая форма.
//
Процедура ФормаНастройкиШаблонов_ЗаполнитьДоступныеПараметры(Форма) Экспорт
	
	ЗаполнитьДоступныеПараметры_Справочник_ТранспортныеСредства(Форма);
	ЗаполнитьДоступныеПараметры_Справочник_уатПунктыНазначения(Форма);
	ЗаполнитьДоступныеПараметры_Справочник_УзлыОбъектовЭксплуатации(Форма);
	
КонецПроцедуры

// Процедура заполняет реквизит формы "ТекстШаблона".
//
// Параметры:
//  Форма - управляемая форма.
//
Процедура ФормаНастройкиШаблонов_ЗаполнитьТекстШаблонов(Форма) Экспорт
	
	ХранилищеШаблонов = Константы.уатНастройкиШаблонов.Получить();
	Если ХранилищеШаблонов = Неопределено Тогда 
		НастройкиШаблонов = Неопределено;
	Иначе 
		НастройкиШаблонов = ХранилищеШаблонов.Получить();
	КонецЕсли;
	
	Если НастройкиШаблонов = Неопределено Тогда 
		НастройкиШаблонов = Новый Структура();
	КонецЕсли;
	
	Если НастройкиШаблонов.Свойство("Справочник_ТранспортныеСредства") Тогда 
		Форма.Справочник_ТранспортныеСредства_ТекстШаблона = НастройкиШаблонов.Справочник_ТранспортныеСредства;
	Иначе 
		Форма.Справочник_ТранспортныеСредства_ТекстШаблона = ПолучитьТекстШаблонаПоУмолчанию("Справочник_ТранспортныеСредства");
	КонецЕсли;
	
	Если НастройкиШаблонов.Свойство("Справочник_уатПунктыНазначения") Тогда 
		Форма.Справочник_уатПунктыНазначения_ТекстШаблона = НастройкиШаблонов.Справочник_уатПунктыНазначения;
	Иначе 
		Форма.Справочник_уатПунктыНазначения_ТекстШаблона = ПолучитьТекстШаблонаПоУмолчанию("Справочник_уатПунктыНазначения");
	КонецЕсли;
	
	Если НастройкиШаблонов.Свойство("Справочник_УзлыОбъектовЭксплуатации") Тогда 
		ДанныеШаблоновУзловОбъектовЭксплуатации = НастройкиШаблонов.Справочник_УзлыОбъектовЭксплуатации;
	Иначе 
		ДанныеШаблоновУзловОбъектовЭксплуатации = ПолучитьТекстШаблонаПоУмолчанию("Справочник_УзлыОбъектовЭксплуатации");
	КонецЕсли;
	
	Для Каждого ТекШаблон Из ДанныеШаблоновУзловОбъектовЭксплуатации Цикл 
		НовСтрока = Форма.Справочник_УзлыОбъектовЭксплуатации_ТекстыШаблонов.Добавить();
		НовСтрока.ТипАгрегата  = ТекШаблон.Ключ;
		НовСтрока.ТекстШаблона = ТекШаблон.Значение;
	КонецЦикла;
	
КонецПроцедуры

// Функция предназначена для получения текста шаблона указанного вида объекта.
//
// Параметры:
//  ВидОбъекта - вид заполняемого объекта.
// 
// Возвращаемое значение:
//   - текст шаблона.
//
Функция ПолучитьТекстШаблона(Знач ВидОбъекта) Экспорт
	
	ХранилищеШаблонов = Константы.уатНастройкиШаблонов.Получить();
	Если ХранилищеШаблонов = Неопределено Тогда 
		НастройкиШаблонов = Неопределено;
	Иначе 
		НастройкиШаблонов = ХранилищеШаблонов.Получить();
	КонецЕсли;
	
	Если НастройкиШаблонов = Неопределено Тогда 
		НастройкиШаблонов = Новый Структура();
	КонецЕсли;
	
	Если НастройкиШаблонов.Свойство(ВидОбъекта) Тогда 
		Возврат НастройкиШаблонов[ВидОбъекта];
		
	Иначе 
		Возврат ПолучитьТекстШаблонаПоУмолчанию(ВидОбъекта);
	КонецЕсли;
	
КонецФункции // ПолучитьТекстШаблона()

// Процедура записывает тексты шаблонов в константу.
//
// Параметры:
//  НастройкиШаблонов - структура - тексты шаблонов.
//
Процедура ЗаписатьТекстыШаблонов(НастройкиШаблонов) Экспорт
	
	Если Не ПравоДоступа("Изменение", Метаданные.Константы.уатНастройкиШаблонов) Тогда 
		Возврат;
	КонецЕсли;
	
	Константы.уатНастройкиШаблонов.Установить(Новый ХранилищеЗначения(НастройкиШаблонов, Новый СжатиеДанных(9)));
	
КонецПроцедуры

// Функция предназначена для получения текста шаблона по умолчанию для указанного вида объекта.
//
// Параметры:
//  ВидОбъекта - вид заполняемого объекта.
// 
// Возвращаемое значение:
//   - текст шаблона.
//
Функция ПолучитьТекстШаблонаПоУмолчанию(ВидОбъекта) Экспорт
	
	Если ВидОбъекта = "Справочник_ТранспортныеСредства" Тогда 
		Возврат "" + НСтр("ru = '[ГосНомер]'") + " " + НСтр("ru = '[Модель]'");
		
	ИначеЕсли ВидОбъекта = "Справочник_уатПунктыНазначения" Тогда 
		Возврат "" + НСтр("ru = '[Город]'") + " " + НСтр("ru = '[Улица]'") + " " + НСтр("ru = '[ДомСтроение]'");
		
	ИначеЕсли ВидОбъекта = "Справочник_УзлыОбъектовЭксплуатации" Тогда 
		ДанныеШаблоновУзловОбъектовЭксплуатации = Новый Соответствие();
		ДанныеШаблоновУзловОбъектовЭксплуатации.Вставить(Справочники.уатТипыАгрегатов.ПустаяСсылка(), "" + НСтр("ru = '[Модель]'") + " " + НСтр("ru = '[СерийныйНомер]'"));
		Возврат ДанныеШаблоновУзловОбъектовЭксплуатации;
		
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьДоступныеПараметры_Справочник_ТранспортныеСредства(Форма)
	
	Форма.Справочник_ТранспортныеСредства_ДоступныеПараметры.Очистить();
	
	НовПараметр = Форма.Справочник_ТранспортныеСредства_ДоступныеПараметры.Добавить();
	НовПараметр.КлючПараметра = НСтр("ru = '[ГосНомер]'");   
	НовПараметр.Представление = НСтр("ru = 'Гос.номер'");
	
	НовПараметр = Форма.Справочник_ТранспортныеСредства_ДоступныеПараметры.Добавить();
	НовПараметр.КлючПараметра = НСтр("ru = '[ГарНомер]'");
	НовПараметр.Представление = НСтр("ru = 'Гар.номер'");
	
	НовПараметр = Форма.Справочник_ТранспортныеСредства_ДоступныеПараметры.Добавить();
	НовПараметр.КлючПараметра = НСтр("ru = '[Модель]'");
	НовПараметр.Представление = НСтр("ru = 'Модель'");
	
	НовПараметр = Форма.Справочник_ТранспортныеСредства_ДоступныеПараметры.Добавить();
	НовПараметр.КлючПараметра = НСтр("ru = '[ТипТС]'");
	НовПараметр.Представление = НСтр("ru = 'Тип ТС'");
	
	НовПараметр = Форма.Справочник_ТранспортныеСредства_ДоступныеПараметры.Добавить();
	НовПараметр.КлючПараметра = НСтр("ru = '[Гараж]'");
	НовПараметр.Представление = НСтр("ru = 'Гараж'");
	
	НовПараметр = Форма.Справочник_ТранспортныеСредства_ДоступныеПараметры.Добавить();
	НовПараметр.КлючПараметра = НСтр("ru = '[Организация]'");
	НовПараметр.Представление = НСтр("ru = 'Организация'");
	
	НовПараметр = Форма.Справочник_ТранспортныеСредства_ДоступныеПараметры.Добавить();
	НовПараметр.КлючПараметра = НСтр("ru = '[Подразделение]'");
	НовПараметр.Представление = НСтр("ru = 'Подразделение'");
	
	НовПараметр = Форма.Справочник_ТранспортныеСредства_ДоступныеПараметры.Добавить();
	НовПараметр.КлючПараметра = НСтр("ru = '[Колонна]'");
	НовПараметр.Представление = НСтр("ru = 'Колонна'");
	
КонецПроцедуры

Функция ПодставитьПараметрыВШаблон_Справочник_ТранспортныеСредства(Знач ТекстШаблона, ДанныеОбъекта)
	
	Результат = ТекстШаблона;
	
	Результат = СтрЗаменить(Результат, НСтр("ru = '[ГосНомер]'"), СокрЛП(Строка(ДанныеОбъекта.Код)));
	Результат = СтрЗаменить(Результат, НСтр("ru = '[ГарНомер]'"), СокрЛП(Строка(ДанныеОбъекта.уатГаражныйНомер)));
	Результат = СтрЗаменить(Результат, НСтр("ru = '[Модель]'"), СокрЛП(Строка(ДанныеОбъекта.уатМодель)));
	Результат = СтрЗаменить(Результат, НСтр("ru = '[ТипТС]'"), СокрЛП(Строка(ДанныеОбъекта.Тип)));
	Результат = СтрЗаменить(Результат, НСтр("ru = '[Гараж]'"), СокрЛП(Строка(ДанныеОбъекта.уатГараж)));
	Результат = СтрЗаменить(Результат, НСтр("ru = '[Организация]'"), СокрЛП(Строка(ДанныеОбъекта.уатОрганизация)));
	Результат = СтрЗаменить(Результат, НСтр("ru = '[Подразделение]'"), СокрЛП(Строка(ДанныеОбъекта.уатПодразделение)));
	Результат = СтрЗаменить(Результат, НСтр("ru = '[Колонна]'"), СокрЛП(Строка(ДанныеОбъекта.уатКолонна)));
	
	Возврат Результат;
	
КонецФункции

