Функция СтрокаОбъектаАдресации(Код, Наименование, Тип = 0)
	
	СтруктураОбъектаАдресации = Новый Структура;
	СтруктураОбъектаАдресации.Вставить("Код",          Код);
	СтруктураОбъектаАдресации.Вставить("Наименование", Наименование);
	СтруктураОбъектаАдресации.Вставить("Тип",          Тип);
	СтруктураОбъектаАдресации.Вставить("Сокращение",   НРег(Наименование));
	
	Возврат СтруктураОбъектаАдресации;
	
КонецФункции

Процедура ЗаполнитьДоступныеПараметры_Справочник_УзлыОбъектовЭксплуатации(Форма)
	
	Форма.Справочник_УзлыОбъектовЭксплуатации_ДоступныеПараметры.Очистить();
	
	НовПараметр = Форма.Справочник_УзлыОбъектовЭксплуатации_ДоступныеПараметры.Добавить();
	НовПараметр.КлючПараметра = НСтр("ru = '[Модель]'");   
	НовПараметр.Представление = НСтр("ru = 'Модель'");
	
	НовПараметр = Форма.Справочник_УзлыОбъектовЭксплуатации_ДоступныеПараметры.Добавить();
	НовПараметр.КлючПараметра = НСтр("ru = '[СерийныйНомер]'");   
	НовПараметр.Представление = НСтр("ru = 'Серийный номер'");
	
	НовПараметр = Форма.Справочник_УзлыОбъектовЭксплуатации_ДоступныеПараметры.Добавить();
	НовПараметр.КлючПараметра = НСтр("ru = '[ТипАгрегата]'");   
	НовПараметр.Представление = НСтр("ru = 'Тип агрегата'");
	
	Если Форма.Справочник_УзлыОбъектовЭксплуатации_ТипАгрегата = Справочники.уатТипыАгрегатов.Шина Тогда 
		НовПараметр = Форма.Справочник_УзлыОбъектовЭксплуатации_ДоступныеПараметры.Добавить();
		НовПараметр.КлючПараметра = НСтр("ru = '[СрокСлужбыШины]'");   
		НовПараметр.Представление = НСтр("ru = 'Срок службы шины'");
		
	Иначе 
		НовПараметр = Форма.Справочник_УзлыОбъектовЭксплуатации_ДоступныеПараметры.Добавить();
		НовПараметр.КлючПараметра = НСтр("ru = '[ГоденДо]'");   
		НовПараметр.Представление = НСтр("ru = 'Годен до'");
	КонецЕсли;
	
КонецПроцедуры

Функция ПодставитьПараметрыВШаблон_Справочник_УзлыОбъектовЭксплуатации(Знач ТекстыШаблонов, ОбъектИсточник)
	
	Если ТипЗнч(ОбъектИсточник) = Тип("Структура") Тогда 
		ДанныеОбъекта = ОбъектИсточник;
	Иначе 
		ДанныеОбъекта = ПолучитьДанныеОбъектаУзлаОбъектаЭксплуатации(ОбъектИсточник);
	КонецЕсли;
	
	ТекстШаблонаПоТипу = ТекстыШаблонов.Получить(ДанныеОбъекта.ТипАгрегата);
	ТекстШаблонаОбщий  = ТекстыШаблонов.Получить(Справочники.уатТипыАгрегатов.ПустаяСсылка());
	
	Если ТекстШаблонаПоТипу = Неопределено Тогда 
		Результат = ТекстШаблонаОбщий;
	Иначе 
		Результат = ТекстШаблонаПоТипу;
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, НСтр("ru = '[Модель]'"), СокрЛП(Строка(ДанныеОбъекта.Модель)));
	Результат = СтрЗаменить(Результат, НСтр("ru = '[СерийныйНомер]'"), СокрЛП(Строка(ДанныеОбъекта.СерийныйНомер)));
	Результат = СтрЗаменить(Результат, НСтр("ru = '[ТипАгрегата]'"), СокрЛП(Строка(ДанныеОбъекта.ТипАгрегата)));
	
	Если ДанныеОбъекта.ТипАгрегата = Справочники.уатТипыАгрегатов.Шина Тогда 
		Результат = СтрЗаменить(Результат, НСтр("ru = '[СрокСлужбыШины]'"), Формат(ДанныеОбъекта.СрокСлужбыШины, "ЧЦ=2; ЧВН="));
		Результат = СтрЗаменить(Результат, НСтр("ru = '[ГоденДо]'"), "");
	Иначе 
		Результат = СтрЗаменить(Результат, НСтр("ru = '[СрокСлужбыШины]'"), "");
		Результат = СтрЗаменить(Результат, НСтр("ru = '[ГоденДо]'"), Формат(ДанныеОбъекта.ГоденДо, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеОбъектаУзлаОбъектаЭксплуатации(ОбъектИсточник)
	
	ДанныеОбъекта = Новый Структура();
	ДанныеОбъекта.Вставить("Модель",         "");
	ДанныеОбъекта.Вставить("СерийныйНомер",  "");
	ДанныеОбъекта.Вставить("ТипАгрегата",    Справочники.уатТипыАгрегатов.ПустаяСсылка());
	ДанныеОбъекта.Вставить("СрокСлужбыШины", 0);
	ДанныеОбъекта.Вставить("ГоденДо",        '00010101');
	
	Запрос = Новый Запрос();
	
	Если ТипЗнч(ОбъектИсточник) = Тип("СправочникОбъект.УзлыОбъектовЭксплуатации") Тогда 
		Запрос.УстановитьПараметр("Ссылка", ОбъектИсточник.Ссылка);
	Иначе 
		Запрос.УстановитьПараметр("Ссылка", ОбъектИсточник);
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УзлыОбъектовЭксплуатации.Модель КАК Модель,
	|	УзлыОбъектовЭксплуатации.СерийныйНомер КАК СерийныйНомер,
	|	ЕСТЬNULL(уатАгрегатыТС.ТипАгрегата, ЗНАЧЕНИЕ(Справочник.уатТипыАгрегатов.ПустаяСсылка)) КАК ТипАгрегата,
	|	ЕСТЬNULL(уатАгрегатыТС.СрокСлужбыШины, 0) КАК СрокСлужбыШины,
	|	ЕСТЬNULL(уатАгрегатыТС.ГоденДо, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ГоденДо
	|ИЗ
	|	Справочник.УзлыОбъектовЭксплуатации КАК УзлыОбъектовЭксплуатации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.уатАгрегатыТС КАК уатАгрегатыТС
	|		ПО (уатАгрегатыТС.УзелОбъектаЭксплуатации = УзлыОбъектовЭксплуатации.Ссылка)
	|ГДЕ
	|	УзлыОбъектовЭксплуатации.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		ЗаполнитьЗначенияСвойств(ДанныеОбъекта, Выборка);
	КонецЕсли;
	
	Если ТипЗнч(ОбъектИсточник) = Тип("СправочникОбъект.УзлыОбъектовЭксплуатации") Тогда 
		ДанныеОбъекта.Модель        = ОбъектИсточник.Модель;
		ДанныеОбъекта.СерийныйНомер = ОбъектИсточник.СерийныйНомер;
	КонецЕсли;
	
	Возврат ДанныеОбъекта;
	
КонецФункции // ПолучитьДанныеОбъектаУзлаОбъектаЭксплуатации()

#КонецОбласти
