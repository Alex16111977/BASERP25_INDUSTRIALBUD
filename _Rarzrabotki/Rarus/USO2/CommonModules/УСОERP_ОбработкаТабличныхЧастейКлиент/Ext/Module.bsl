#Область ОбработкиДереваЗначений

// Процедура обходит переданное ей дерево рекурсивно
// ЭлементДереваЗначений - ДанныеФормыДерево
// Колонка - строка
// Сумма   - число
Процедура ОбойтиДеревоЗначенийРекурсивно(ЭлементДереваЗначений, Колонка, Сумма)
	ПодчиненныеЭлементы =  ЭлементДереваЗначений.ПолучитьЭлементы();
	Для Каждого Элемент Из ПодчиненныеЭлементы Цикл
		ОбойтиДеревоЗначенийРекурсивно(Элемент, Колонка, Сумма);
		Сумма = Сумма + Элемент[Колонка];
	КонецЦикла;
КонецПроцедуры

// Процедура вызывается из формы, для пересчёта итоговых значений в дереве
// ЭлементДереваЗначений - ДанныеФормыДерево
// Колонка - строка
// Сумма   - число
Функция РассчитатьИтоговыеПоказателиДереваЗначенийФормы(ЭлементДереваЗначений, Колонка)Экспорт
	Сумма = 0;
	ОбойтиДеревоЗначенийРекурсивно(ЭлементДереваЗначений, Колонка, Сумма);
	Возврат Сумма;
КонецФункции

#КонецОбласти