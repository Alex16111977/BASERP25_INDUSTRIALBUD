#Область ЗаполнениеГруппыРесурсов

// Процедура заполняет реквизит ГруппаРесурсов для справочников СМ_СметноНормативныеБазы и СМ_Ресурсы.
// согласно условиям по умолчанию. 
// Также раскладывает ресурсы по папкам согласно их ГруппеРесурсов.
Процедура ЗаполнитьГруппыРесурсов() Экспорт
	
	// Заполним группу ресурсов для Справочника СМ_СметноНормативныеБазы
	Выборка = Справочники.СМ_СметноНормативныеБазы.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЭтоГруппа Или ЗначениеЗаполнено(Выборка.ГруппаРесурсов) Тогда
			Продолжить;
		КонецЕсли;
		
		СНБОбъект = Выборка.ПолучитьОбъект();
		СНБОбъект.ГруппаРесурсов = Справочники.СМ_ГруппыРесурсов.ЗаполнитьГруппуРесурсовПоУмолчанию(Выборка.Ссылка);
		СНБОбъект.Записать();
	КонецЦикла;
	
	// Заполним группу ресурсов для Справочника СМ_Ресурсы
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СМ_Ресурсы.Ссылка,
		|	СМ_Ресурсы.ВидРесурса
		|ИЗ
		|	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
		|ГДЕ
		|	СМ_Ресурсы.ЭтоГруппа = ЛОЖЬ
		|	И СМ_Ресурсы.ГруппаРесурсов = ЗНАЧЕНИЕ(Справочник.СМ_ГруппыРесурсов.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		РесурсОбъект = Выборка.Ссылка.ПолучитьОбъект();
		РесурсОбъект.ГруппаРесурсов = Справочники.СМ_Ресурсы.КаталогПоУмолчанию(Выборка.Ссылка);
		РесурсОбъект.Записать();
		
	КонецЦикла;
	
	// Перенесем все папки в Каталог2001 (Ресурсы ФЕР/ТЕР 2001 года) для ускорения дальнейшего распределения по папкам.
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СМ_Ресурсы.Ссылка
	|ИЗ
	|	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
	|ГДЕ
	|	СМ_Ресурсы.ЭтоГруппа = ИСТИНА И
	|	СМ_Ресурсы.Родитель = ЗНАЧЕНИЕ(Справочник.СМ_Ресурсы.ПустаяСсылка) И
	|	СМ_Ресурсы.Предопределенный = ЛОЖЬ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Выборка.Ссылка.ПолучитьОбъект();
		Элемент.Родитель = Справочники.СМ_Ресурсы.Каталог2001;
		Элемент.Записать();
	КонецЦикла;
	
	// Перенесем ресурсы в папки согласно их группе ресурсов
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СМ_Ресурсы.Ссылка,
		|	СМ_Ресурсы.ВидРесурса КАК ВидРесурса,
		|	СМ_Ресурсы.ГруппаРесурсов КАК ГруппаРесурсов,
		|	СМ_Ресурсы.Родитель
		|ИЗ
		|	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
		|ГДЕ
		|	СМ_Ресурсы.ЭтоГруппа = ЛОЖЬ
		|ИТОГИ ПО
		|	ГруппаРесурсов,
		|	ВидРесурса";
	
	ВыборкаГрупп = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ГруппаРесурсов");
	Пока ВыборкаГрупп.Следующий() Цикл
		Каталог = Справочники.СМ_Ресурсы[ВыборкаГрупп.ГруппаРесурсов.ИмяПредопределенныхДанных]; 
	    ВыборкаВидаРесурса = ВыборкаГрупп.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ВидРесурса");
		Пока ВыборкаВидаРесурса.Следующий() Цикл
			Родитель = СМ_СметаЗагрузкаВызовСервера.СоздатьПолучитьПапкуРесурсов(""+ВыборкаВидаРесурса.ВидРесурса, Каталог);	
			Выборка = ВыборкаВидаРесурса.Выбрать();
			Пока Выборка.Следующий() Цикл
				Если Выборка.Родитель = Родитель Тогда
					Продолжить;
				КонецЕсли;
				Элемент = Выборка.Ссылка.ПолучитьОбъект();
				Элемент.Родитель = Родитель;
				Элемент.Записать();
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Процедура обрабатывает ресурс с кодом 2, который мог быть загружен неверно в справочник СМ_Ресурсы.
Процедура ОбработатьЗарплатуМашинистов() Экспорт
	
	// Найдем зарплату машинистов.
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СМ_Ресурсы.Ссылка,
		|	СМ_Ресурсы.ВидРесурса
		|ИЗ
		|	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
		|ГДЕ
		|	СМ_Ресурсы.ЭтоГруппа = ЛОЖЬ
		|	И СМ_Ресурсы.Код = ""2""";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаВидаРесурса = РезультатЗапроса.Выбрать();
	
	// Найдем папку
	Пока ВыборкаВидаРесурса.Следующий() Цикл
		ВыборкаВидаОбъект = ВыборкаВидаРесурса.Ссылка.ПолучитьОбъект();
		ВыборкаВидаОбъект.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов;
		Каталог = Справочники.СМ_Ресурсы[ВыборкаВидаОбъект.ГруппаРесурсов.ИмяПредопределенныхДанных]; 
	    ВыборкаВидаОбъект.Родитель = СМ_СметаЗагрузкаВызовСервера.СоздатьПолучитьПапкуРесурсов(""+ВыборкаВидаРесурса.ВидРесурса, Каталог);
		ВыборкаВидаОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОпределениеМестоположения

// Определяет текущий регион.
//
// Возвращаемое значение:
//     Место - Строка - содержит регион пользователя.
//
Функция ОпределитьРегион() Экспорт
	
	Место = "";
	
	Попытка
		
		ОписаниеСервиса = Новый  WSОпределения("http://develplatform.ru/SynIP.asmx?wsdl");
		// Создаем прокси для дальнейшей работы с веб-сервисом.
		Прокси = Новый WSПрокси(ОписаниеСервиса,"http://www.develplatform.com/","SynIP","SynIPSoap");
		// Получаем XDTO-объект описание метода "GetClientIP". 
		Тип = Прокси.ФабрикаXDTO.Пакеты.Получить("http://www.develplatform.com/").Получить("GetClientIP");
		// Создаем XDTO-объект метода веб-сервиса.
		ФабрикаВебСервис = Прокси.ФабрикаXDTO.Создать(Тип);
		// Выполням метод "GetClientIP" веб-сервиса. 
		// И помещаем результат в элемент формы.
		IP = Прокси.GetClientIP(ФабрикаВебСервис).GetClientIPResult; 
		
		Сервер = "uniq-ip.com";                   // Надо узнать ip.
		ЗапросСервера = "/ip/?ip="+Строка(IP);
	
		Соединение = Новый HTTPСоединение(Сервер);
		
		ИмяФайлаОтвета = ПолучитьИмяВременногоФайла("xml");
		
		Соединение.Получить(ЗапросСервера, ИмяФайлаОтвета);
		
		ФайлОтвета = Новый Файл(ИмяФайлаОтвета);
		Если ФайлОтвета.Существует() Тогда
			XML = Новый ЧтениеXML;
			XML.ОткрытьФайл(ИмяФайлаОтвета);
			Регион = Ложь;
			Пока XML.Прочитать() Цикл
				Если XML.ТипУзла = ТипУзлаXML.НачалоЭлемента И СокрЛП(XML.Имя) = "region_ru" Тогда
					Регион = Истина;
				ИначеЕсли XML.ТипУзла = ТипУзлаXML.Текст И Регион = Истина Тогда
					Место = СокрЛП(XML.Значение);
					Прервать;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;

	Исключение
		Попытка
			Если Место = "" Тогда
				// Создаем HTTP-подключение.
				ЗапросHTTP = Новый HTTPСоединение("ipgeobase.ru");
				// Создаем временный файл для записи HTML-текста веб-страницы.
				ВременныйФайл = ПолучитьИмяВременногоФайла();
				// Выполняем запрос и записываем текст страницы во временный файл.
				ЗапросHTTP.Получить("/", ВременныйФайл);
				// Считываем содержимое временного файла.
				ТекДок = Новый ТекстовыйДокумент;
				ТекДок.Прочитать(ВременныйФайл);
				// Находим строку с IP-адресом.
				Для Сч=1 По ТекДок.КоличествоСтрок() Цикл
					Стр=ТекДок.ПолучитьСтроку(Сч);
					Если Найти(Стр,НСтр("ru='<td>Ваш регион:</td><td>'"))>0 Тогда
						// Ищем значение IP-адреса в тексте.
						СтрПодготовленная = СокрЛП(Стр);
						СимволНачало = Найти(СтрПодготовленная, НСтр("ru='<td>Ваш регион:</td><td>'"));
						СтрокаБуффер = Сред(СтрПодготовленная,СимволНачало+24,СтрДлина(СтрПодготовленная)); 
						СимволКонец = Найти(СтрокаБуффер, "</");
						СтрокаIP = Сред(СтрокаБуффер, 0, СимволКонец-1);
						// Выводим результат.
						Место =  СтрокаIP;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		Исключение
			Возврат "";
		КонецПопытки;
		
	КонецПопытки;
	
	Возврат Место;
	
КонецФункции

// Проверяет заполненность региона.
//
// Возвращаемое значение:
//     Результат - Структура, Булево - структура с полем "Регион" (СправочникСсылка.СМ_Регионы) 
//									   или Булево (Ложь, если не найдено).
//
Функция ПроверяемРегионОбработка() Экспорт
	Если Не Пользователи.РолиДоступны("СМ_АдминистраторСмета, СМ_Сметчик, АдминистраторСистемы, ПолныеПрава", , Ложь) Тогда
		Возврат Истина;
	КонецЕсли;	
	СМ_ОсновнойРегион = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнойРегион");
	Если СМ_ОсновнойРегион = Неопределено ИЛИ Не ЗначениеЗаполнено(СМ_ОсновнойРегион) Тогда
		Регион = ОпределитьРегион();
		Если  Регион = "" Тогда
			Возврат Ложь;
		Иначе
			Регион = Справочники.СМ_Регионы.НайтиПоНаименованию(Регион,Истина);
			Если  Регион.Пустая() Тогда
				Возврат Ложь;
			Иначе
				Возврат Новый Структура("Регион",Регион);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Истина;
КонецФункции

