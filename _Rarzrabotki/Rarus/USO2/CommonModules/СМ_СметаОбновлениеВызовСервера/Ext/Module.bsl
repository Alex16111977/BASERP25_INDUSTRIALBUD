// Заполняет методику в документах.
Процедура ЗаполнитьМетодикуДокументов() Экспорт
	
	Выборка = Документы.СМ_ОбъектнаяСмета.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		Об = Выборка.ПолучитьОбъект();
		Об.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаМДС35;
		Об.ОбменДанными.Загрузка = Истина;
		Об.Записать();
	
	КонецЦикла;
	
	Выборка = Документы.СМ_СводнаяСмета.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		Об = Выборка.ПолучитьОбъект();
		Об.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаМДС35;
		Об.ОбменДанными.Загрузка = Истина;
		Об.Записать();
	
	КонецЦикла;
	
	Выборка = Документы.СМ_ЛокальнаяСмета.Выбрать();
	Пока Выборка.Следующий() Цикл
	
		Если НЕ ЗначениеЗаполнено(Выборка.МетодикаРасчета) Тогда
			
			СметаОбъект = Выборка.ПолучитьОбъект();
			
			ФО_Методика1984 			= ПолучитьФункциональнуюОпцию("СМ_Методика84Года");
			ФО_МетодикаМДС35 			= ПолучитьФункциональнуюОпцию("СМ_МетодикаМДС35");
			ФО_МетодикаТСНГородаМосква 	= ПолучитьФункциональнуюОпцию("СМ_МетодикаТСНГородаМосква");
			
			Если ФО_Методика1984 И СметаОбъект.Методика1984 Тогда
				СметаОбъект.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_Методика84года;	
			ИначеЕсли ФО_МетодикаТСНГородаМосква И СметаОбъект.МетодикаТСН Тогда	
				СметаОбъект.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква;	
			ИначеЕсли ФО_МетодикаМДС35 Тогда
				СметаОбъект.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаМДС35;	
			Иначе
				Константы.СМ_МетодикаМДС35.Установить(Истина);
				СметаОбъект.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаМДС35;	
			КонецЕсли;
			
			СметаОбъект.ОбменДанными.Загрузка = Истина;
			СметаОбъект.Записать();
		
		КонецЕсли;
		
	КонецЦикла;
	
