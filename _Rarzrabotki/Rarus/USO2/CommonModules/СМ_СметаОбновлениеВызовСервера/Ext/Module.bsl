// Переносим все реквизиты нумерации в РС Нумерации
Процедура ОбработатьНомераОбъектов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СМ_ПозицияЛокальнойСметы.Ссылка,
	|	СМ_ПозицияЛокальнойСметы.НомерВДереве,
	|	СМ_ПозицияЛокальнойСметы.НомерВПределахСметы,
	|	СМ_ПозицияЛокальнойСметы.ПорНомер
	|ИЗ
	|	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			СМ_СметаВызовСервера.УстановитьНомерДокумента(Выборка.Ссылка, Выборка.ПорНомер, Выборка.НомерВПределахСметы, Выборка.НомерВДереве, , "СМ_ПозицияЛокальнойСметы");
		Исключение
		КОнецПопытки;
	            	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ПозицияЛокальнойСметы.Ссылка,
	               |	СМ_ПозицияЛокальнойСметы.НомерВДереве,
	               |	СМ_ПозицияЛокальнойСметы.НомерВПределахСметы,
	               |	СМ_ПозицияЛокальнойСметы.ПорНомер
	               |ИЗ
	               |	Документ.СМ_РазделЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			СМ_СметаВызовСервера.УстановитьНомерДокумента(Выборка.Ссылка, Выборка.ПорНомер, Выборка.НомерВПределахСметы, Выборка.НомерВДереве, , "СМ_РазделЛокальнойСметы");
	    Исключение
		КОнецПопытки;
	            	
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ПозицияЛокальнойСметы.Ссылка,
	               |	СМ_ПозицияЛокальнойСметы.НомерВДереве,
	               |	СМ_ПозицияЛокальнойСметы.НомерВПределахСметы,
	               |	СМ_ПозицияЛокальнойСметы.ПорНомер
	               |ИЗ
	               |	Документ.СМ_ЛокальнаяСмета КАК СМ_ПозицияЛокальнойСметы";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			СМ_СметаВызовСервера.УстановитьНомерДокумента(Выборка.Ссылка, Выборка.ПорНомер, Выборка.НомерВПределахСметы, Выборка.НомерВДереве, , "СМ_ЛокальнаяСмета");
	    Исключение
		КОнецПопытки;
	            	
	КонецЦикла; 	
	
КонецПроцедуры

