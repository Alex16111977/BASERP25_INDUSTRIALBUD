// Заполняет методику расчета в локальных сметах, где она не заполнена.
Процедура ОбновитьМетодикуРасчета() Экспорт
	
	// Заполнение методики расчета по умолчанию, если не заполнена
	МетодикаМДС35 	= Константы.СМ_МетодикаМДС35.Получить();	
	Методика84года 	= Константы.СМ_Методика84года.Получить();
	МетодикаТСН 	= Константы.СМ_МетодикаТСНГородаМосква.Получить();
	Если НЕ МетодикаМДС35 И НЕ Методика84года И НЕ МетодикаТСН Тогда
		Константы.СМ_МетодикаМДС35.Установить(Истина);
	КонецЕсли;
	
	// Заполнение методики расчета в локальных сметах
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ
	|	СМ_ЛокальнаяСмета.Ссылка,
	|	СМ_ЛокальнаяСмета.Методика1984,
	|	СМ_ЛокальнаяСмета.МетодикаТСН
	|ИЗ
	|	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	|ГДЕ
	|	СМ_ЛокальнаяСмета.МетодикаРасчета = &ПустаяМетодика";	
	
	Запрос.УстановитьПараметр("ПустаяМетодика",Справочники.СМ_МетодикиРасчета.ПустаяСсылка());
	ТабСметы = Запрос.Выполнить().Выгрузить();
	Для Каждого ТекСтрока Из ТабСметы Цикл
		
		ТекСметаОбъект = ТекСтрока.Ссылка.ПолучитьОбъект();
		Если ТекСтрока.Методика1984 Тогда
			ТекСметаОбъект.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_Методика84года; 
		ИначеЕсли ТекСтрока.МетодикаТСН Тогда
			ТекСметаОбъект.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква; 
		Иначе
			ТекСметаОбъект.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаМДС35;
		КонецЕсли;
		
		Попытка 
			ТекСметаОбъект.Записать();	
		Исключение
		КонецПопытки;
		
	КонецЦикла;
			
КонецПроцедуры

#КонецОбласти

#Область обн3_0_2_24

