// Очистка настроек формы локальной сметы для корректного отображения значков.
Процедура ОчиститьНастройкиНаСервере() Экспорт
	
	СписокНастроек = Новый СписокЗначений;
	СписокНастроек.Добавить("Документ.СМ_ЛокальнаяСмета.Форма.ФормаДокументаУпр");
	СписокНастроек.Добавить("Документ.СМ_АктВыполненныхРабот.Форма.ФормаДокументаУпр");
	
	ИнтерфейсТакси = (ТекущийВариантИнтерфейсаКлиентскогоПриложения() = ВариантИнтерфейсаКлиентскогоПриложения.Такси);
	
	МассивНастроекФорм = Новый Массив;
	МассивНастроекФорм.Добавить("/НастройкиФормы");
	
	МассивПользователей = ПользователиИнформационнойБазы.ПолучитьПользователей();
	Если МассивПользователей.Количество() = 0 Тогда
		МассивПользователей.Добавить(Новый Структура("Имя", ""));
	КонецЕсли;
	
	Для Каждого Пользователь Из МассивПользователей Цикл
		
		Для Каждого Настройка Из СписокНастроек Цикл
				
			Для Каждого ЭлементФорм Из МассивНастроекФорм Цикл
				ХранилищеСистемныхНастроек.Удалить(Настройка.Значение + ЭлементФорм, Настройка.Представление, Пользователь.Имя);
			КонецЦикла;
					
		КонецЦикла;
		
	КонецЦикла;
		
КонецПроцедуры

// Очищает настройки интерфейса для автообновления.
Процедура УдалитьНастройкиИнтерфейса() Экспорт
	ХранилищеСистемныхНастроек.Удалить("Общее/НастройкиИнтерфейсаКлиентскогоПриложения",Неопределено,Неопределено);
КонецПроцедуры	

// Заполнение регистра Соответствие определителя и расчета НР для методики1984.
// Добавление итогов в Справочник Итоги по разделу.
// Добавление итога в Справочник Итоги числовых параметров по разделу.
// Добавление ЧП  в Справочник Числовые параметры.
Процедура ПеренумероватьИтоги() Экспорт
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ПолучитьОбщийМакет("СМ_НачЗаполнениеСметы").ПолучитьТекст() );
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если ЧтениеXML.Имя = "body" Тогда
			ИначеЕсли ЧтениеXML.Имя = "ItSection" Тогда
				// Добавление итогов в Справочник Итоги по разделу.
				ОбъектДляЗаписи = СМ_СметаЗагрузкаВызовСервера.ЗагрузитьИтогиПоРазделуИзXML(ЧтениеXML);
			ИначеЕсли ЧтениеXML.Имя = "fixedmaps" Тогда
				// Заполнение регистра Соответствие определителя и расчета НР для методики1984. 
				// 
				Табл = Новый ТаблицаЗначений();
				Табл.Колонки.Добавить("Определитель");
				Табл.Колонки.Добавить("ПравилоНачисленияНР");
				Табл.Колонки.Добавить("ЗначениеНРБазисноИндексное");
				Табл.Колонки.Добавить("ПравилоНачисленияСП");
			ИначеЕсли ЧтениеXML.Имя = "fixedmap" Тогда
				// Для методики 1984.
				СМ_СметаЗагрузкаВызовСервера.ЗагрузитьСоответствия(ЧтениеXML,Табл);
			КонецЕсли;	
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если ЧтениеXML.Имя = "ItSection" Тогда
				ОбъектДляЗаписи.Записать();
			ИначеЕсли ЧтениеXML.Имя = "fixedmaps" Тогда
				СМ_СметаЗагрузкаВызовСервера.ЗаписатьРегистр(Табл);
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;	
	// Добавление итога косвенные расходы для ЧП  Н15 Уосвенные расходы
	СпрИтогиЧП = Справочники.СМ_ИтогиЧППоРазделу.НайтиПоРеквизиту("Идентификатор","КосвРасходы");
	Если СпрИтогиЧП = Справочники.СМ_ИтогиЧППоРазделу.ПустаяСсылка() Тогда
		
		Табл = Новый ТаблицаЗначений;
		Табл.Колонки.Добавить("Код");
		Табл.Колонки.Добавить("НовыйНомер");
		Табл.Колонки.Добавить("СтарыйНомер");
		СпрИтогиЧП = Справочники.СМ_ИтогиЧППоРазделу.НайтиПоРеквизиту("Идентификатор","Полярный");
		НомерПослеКоторогоВставлять =  СпрИтогиЧП.ПолучитьОбъект().ПорядковыйНомер;
		СпрИтогиЧП = Справочники.СМ_ИтогиЧППоРазделу.Выбрать();
		Пока СпрИтогиЧП.Следующий() Цикл
			СтрТабл = Табл.Добавить();
			СтрТабл.Код = СпрИтогиЧП.Код;
			СтрТабл.СтарыйНомер = СпрИтогиЧП.ПорядковыйНомер;
			Если СпрИтогиЧП.ПорядковыйНомер > НомерПослеКоторогоВставлять Тогда
				СтрТабл.НовыйНомер = СпрИтогиЧП.ПорядковыйНомер + 1;
			Иначе
				СтрТабл.НовыйНомер = СпрИтогиЧП.ПорядковыйНомер;
			КонецЕсли;
		КонецЦикла;	
		Табл.Сортировать("СтарыйНомер Убыв");
		Для каждого СтрТабл Из Табл Цикл
			СпрИтогиЧП = Справочники.СМ_ИтогиЧППоРазделу.Выбрать();
			Пока СпрИтогиЧП.Следующий() Цикл
				ТекОбъект = СпрИтогиЧП.ПолучитьОбъект();
				Если ТекОбъект.Код = СтрТабл.Код Тогда
					Если ТекОбъект.ПорядковыйНомер > НомерПослеКоторогоВставлять Тогда
						ТекОбъект.ПорядковыйНомер = СтрТабл.НовыйНомер;
						ТекОбъект.Записать();
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;	
		КонецЦикла;	
		
		НовыйОбъект 		= Справочники.СМ_ИтогиЧППоРазделу.СоздатьЭлемент();
		НовыйОбъект.УстановитьНовыйКод();
		НовыйОбъект.Наименование 	= НСтр("ru = 'Процент косвенных расходов на отклонения по ЗП машинистов'");
		НовыйОбъект.Идентификатор	= "КосвРасходы";
		НовыйОбъект.Накопительный	= Ложь;
		НовыйОбъект.ПорядковыйНомер = НомерПослеКоторогоВставлять + 1;
		НовыйОбъект.Расшифровка		= Истина;
		НовыйОбъект.ВыводитьНаПечать	= Истина;
		НовыйОбъект.Записать();
	КонецЕсли;	
	
	// Добавление числового параметра
	СпрЧП = Справочники.СМ_ЧисловыеПараметры.НайтиПоРеквизиту("Идентификатор","Н15");
	Если СпрЧП = Справочники.СМ_ЧисловыеПараметры.ПустаяСсылка() Тогда
		НовыйОбъект 						= Справочники.СМ_ЧисловыеПараметры.СоздатьЭлемент();
		НовыйОбъект.Код 					= 41;
		НовыйОбъект.Наименование 			= НСтр("ru = 'Процент косвенных расходов'");
		НовыйОбъект.Идентификатор 			= "Н15";
		НовыйОбъект.ЗначениеПоУмолчанию 	= 0;
		НовыйОбъект.Методика1984 			= Истина;
		НовыйОбъект.ПорядокРасчета			= 27;
		НовыйОбъект.СтандартноеЗначение 	= 0;
		НовыйОбъект.ТипЗначения 			= Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент;
		
		НоваяСтрокаТЧ 							= НовыйОбъект.УсловияПрименения.Добавить();
		НоваяСтрокаТЧ.ВидРасценки 				= Перечисления.СМ_ВидыРасценки.Работа;
		НоваяСтрокаТЧ.ВидРабот 					= Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы; 
		НоваяСтрокаТЧ.ТипНормативногоСборника 	= Перечисления.СМ_ТипыНормативныхСборников.МонтажныеРаботы; 	
		
		НоваяСтрокаТЧ = НовыйОбъект.Источник.Добавить();
		НоваяСтрокаТЧ.ОтЧего = Справочники.СМ_ИтогиЧППоРазделу.НайтиПоРеквизиту("Идентификатор","ПоправНаЗарплату");
		НоваяСтрокаТЧ.ПрямЗатраты = Ложь; 	
		НоваяСтрокаТЧ.ОснЗарплата = Ложь; 	
		НоваяСтрокаТЧ.ЭксплМашин = Ложь; 	
		НоваяСтрокаТЧ.ЗарплМашинистов = Истина; 	
		НоваяСтрокаТЧ.СтоимМатериалов = Ложь; 	
		НоваяСтрокаТЧ.Оборудование = Ложь; 	
		НоваяСтрокаТЧ.ЗатратыТрудаРабочих = Ложь; 	
		НоваяСтрокаТЧ.ЗатратыТрудаМашинистов = Ложь; 	
