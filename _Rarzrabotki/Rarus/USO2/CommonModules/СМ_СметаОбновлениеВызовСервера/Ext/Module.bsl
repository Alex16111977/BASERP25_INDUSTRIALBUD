// Заполняет справочник "Единицы измерения смета" и регистр сведений "СМ_АльтернативныеНазванияЕдиницИзмеренияСмета".
Процедура ЗаполнитьЕдиницыИзмерения() Экспорт
	
	// Загружаем общий макет единиц измерения в таблицу значений
	МакетЕдИзм 					= ПолучитьОбщийМакет("СМ_ЕдиницыИзмерения");
	Построитель 				= Новый ПостроительЗапроса;
    Построитель.ИсточникДанных 	= Новый ОписаниеИсточникаДанных(МакетЕдИзм.Область(1,1,1638,5));
    Построитель.Выполнить();
   	ТабЕдиницыИсточник = Построитель.Результат.Выгрузить();
	
	// Определяем количество элементов в справочнике "Единицы измерения" 
	ТабЕдиницы = СМ_СметаВызовСервера.ПолучитьЕдиницыИзмерения();
	Если ТабЕдиницы.Количество() > 0 Тогда
		
		ТабЕдиницы.Сортировать("КодЧислом Убыв");
		ПоследнийКод = ТабЕдиницы[0].КодЧислом;
		Для Каждого ТекСтрока Из ТабЕдиницыИсточник Цикл
			// Поиск базовой едницы измерения в справочнике
			Если ТекСтрока.СметныйКод <> ТекСтрока.СметныйКодБазовойЕдиницы Тогда 
				БазоваяЕдиницаИзмерения = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСметномуКоду(ТекСтрока.СметныйКодБазовойЕдиницы);
			Иначе
				БазоваяЕдиницаИзмерения = Справочники.СМ_ЕдиницыИзмеренияСмета.ПустаяСсылка();
			КонецЕсли;	
			// Создание / изменение единицы измерения в справочнике
			СсылкаЕдиницаИзмерения = СМ_СметаВызовСервера.СоздатьИзменитьЕдиницуИзмерения(ТекСтрока, БазоваяЕдиницаИзмерения,ПоследнийКод);	
		КонецЦикла;
	КонецЕсли;	
	
	// Загружаем макет альтернативных единиц измерения в таблицу значений
	МакетАльтернативныеЕдИзм 	= РегистрыСведений.СМ_АльтернативныеНазванияЕдиницИзмеренияСмета.ПолучитьМакет("АльтернативныеЕдиницыИзмерения");
	Построитель 				= Новый ПостроительЗапроса;
    Построитель.ИсточникДанных 	= Новый ОписаниеИсточникаДанных(МакетАльтернативныеЕдИзм.Область(1,1,1478,2));
    Построитель.Выполнить();
	ТабАльтернативныеЕдиницы = Построитель.Результат.Выгрузить();
	
	// Заполняем колону числым кодом в виде числа
	КЧ = Новый КвалификаторыЧисла(5,0);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Число"));
	ОписаниеТиповЧ = Новый ОписаниеТипов(Массив,,,КЧ);
	ТабАльтернативныеЕдиницы.Колонки.Добавить("СметныйКодЧисло",ОписаниеТиповЧ);
	Для Каждого ТекСтрока Из ТабАльтернативныеЕдиницы Цикл
		Попытка 
		    СметныйКодЧисло				= Число(СокрЛП(ТекСтрока.СметныйКод));
			ТекСтрока.СметныйКодЧисло 	= СметныйКодЧисло;	
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	// Заполнение регистра сведений альтернативных единиц измерения
	Для Каждого ТекСтрока Из ТабЕдиницы Цикл
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("СметныйКодЧисло",ТекСтрока.СметныйКод);
		МассивСтрок = ТабАльтернативныеЕдиницы.НайтиСтроки(СтруктураОтбора);
		Для Каждого ТекЭлемент Из МассивСтрок Цикл
			МенеджерЗаписи 					= РегистрыСведений.СМ_АльтернативныеНазванияЕдиницИзмеренияСмета.СоздатьМенеджерЗаписи();	
			МенеджерЗаписи.Название 		= СокрЛП(ТекЭлемент.Наименование);
			МенеджерЗаписи.ЕдиницаИзмерения = ТекСтрока.Ссылка;
			МенеджерЗаписи.Записать();				
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры
	
#КонецОбласти


#Область ЗаполнитьВидыСтроительства

// Заполняет справочник "Виды строительства" новыми элементами из макета заполнения.
Процедура ЗаполнитьВидыСтроительства() Экспорт
	
	ТабДок		= Справочники.СМ_ВидыСтроительства.ПолучитьМакет("СМ_КЗ_ЗаполнениеСправочника");
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабДок.Область(1,1,ТабДок.ВысотаТаблицы,9));
	Построитель.Выполнить();
	
	ТЗ = Построитель.Результат.Выгрузить();	
	Для Каждого ТекСтрока Из ТЗ Цикл
		Вид = Справочники.СМ_ВидыСтроительства.НайтиПоКоду(Число(ТекСтрока.Код),,Справочники.СМ_ВидыСтроительства.НормативыКазахстан);
		Если Вид.Пустая() Тогда
			НовВид = Справочники.СМ_ВидыСтроительства.СоздатьЭлемент();
			НовВид.Родитель = Справочники.СМ_ВидыСтроительства.НормативыКазахстан;
			НовВид.Наименование = ТекСтрока.Наименование;
			НовВид.Код = Число(ТекСтрока.Код);
			НовВид.НР1_ВС = ТекСтрока.НР1_ВС;
			НовВид.НР2_ВС = ТекСтрока.НР2_ВС;
			НовВид.ОбластьПрименения = ТекСтрока.ОбластьПрименения;
			НовВид.СП_ВС = ТекСтрока.СП_ВС;
			НовВид.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	
	
