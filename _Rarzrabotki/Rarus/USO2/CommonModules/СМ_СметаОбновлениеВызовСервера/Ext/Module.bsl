// Заполняет группу ресурсов в справочнике "Ресурсы".
Процедура ЗаполнитьГруппуРесурсов() Экспорт
	
	// ***************************************************************
	// 1. Получаем список всех предопределенных элементов справочника "ГруппыРесурсов"
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ
	|	СМ_ГруппыРесурсов.Ссылка,
	|	СМ_ГруппыРесурсов.Наименование,
	|	СМ_ГруппыРесурсов.Предопределенный,
	|	СМ_ГруппыРесурсов.ПометкаУдаления
	|ИЗ
	|	Справочник.СМ_ГруппыРесурсов КАК СМ_ГруппыРесурсов
	|ГДЕ
	|	СМ_ГруппыРесурсов.ПометкаУдаления = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО 
	|	СМ_ГруппыРесурсов.Предопределенный УБЫВ";	
	
	ТабГруппыРесурсов = Запрос.Выполнить().Выгрузить();
	
	// ***************************************************************
	// 2. Находим список всех предопределенных групп справочника "Ресурсы
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ
	|	СМ_Ресурсы.Ссылка,
	|	СМ_Ресурсы.Наименование,
	|	СМ_Ресурсы.Предопределенный,
	|	СМ_Ресурсы.ПометкаУдаления
	|ИЗ
	|	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
	|ГДЕ
	|	СМ_Ресурсы.Предопределенный = ИСТИНА И
	|	СМ_Ресурсы.ПометкаУдаления = ЛОЖЬ И 
	|	СМ_Ресурсы.ЭтоГруппа = ИСТИНА 
	|УПОРЯДОЧИТЬ ПО 
	|	СМ_Ресурсы.Предопределенный";	
	
	ПредопределенныеГруппыРесурсов 	= Запрос.Выполнить().Выгрузить();
	МассивПредопределенныхГрупп 	= ПредопределенныеГруппыРесурсов.ВыгрузитьКолонку("Ссылка");
	
	// ************************************************************
	Для Каждого ТекГруппаРесурса Из ТабГруппыРесурсов Цикл
		
		// Находим группу в справочнике ресурсы и устанавливаем всем подчиненным элементам группу ресурсов.
		НайденнаяГруппа = Справочники.СМ_Ресурсы.НайтиПоНаименованию(ТекГруппаРесурса.Наименование);
		Если НайденнаяГруппа <> Справочники.СМ_Ресурсы.ПустаяСсылка() Тогда
			
			Если НайденнаяГруппа.ГруппаРесурсов = Справочники.СМ_ГруппыРесурсов.ПустаяСсылка() Тогда
				ТекОбъект 					= НайденнаяГруппа.Ссылка.ПолучитьОбъект();
				ТекОбъект.ГруппаРесурсов 	= ТекГруппаРесурса.Ссылка;
				ТекОбъект.Записать();
			КонецЕсли;
			
			Если НайденнаяГруппа.Предопределенный Тогда
				ВыборкаЭлементов = Справочники.СМ_Ресурсы.ВыбратьИерархически(НайденнаяГруппа);
				Пока ВыборкаЭлементов.Следующий() Цикл
					Если ВыборкаЭлементов.ГруппаРесурсов <> ТекГруппаРесурса.Ссылка Тогда
						ТекОбъект 					= ВыборкаЭлементов.Ссылка.ПолучитьОбъект();
						ТекОбъект.ГруппаРесурсов 	= ТекГруппаРесурса.Ссылка;
						ТекОбъект.Записать();
					КонецЕсли;
				КонецЦикла;
			Иначе
				
				// Если группа находится внутри предопределенной, то ее не обрабатываем.
				Если МассивПредопределенныхГрупп.Найти(НайденнаяГруппа) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				МассивПропускаемых = Новый Массив;
				
				ВыборкаЭлементов = Справочники.СМ_Ресурсы.ВыбратьИерархически(НайденнаяГруппа);
				Пока ВыборкаЭлементов.Следующий() Цикл
					
					// Если внутри группы встречается предопределенная группа, то не обрабатываем.
					Если ВыборкаЭлементов.Предопределенный Тогда
						МассивПропускаемых.Добавить(ВыборкаЭлементов.Ссылка);
						Продолжить;
					КонецЕсли;
					
					// Если внутри группы встречается группа или элемент, подчиненные предопределенной, их пропускаем.
					Если МассивПропускаемых.Найти(ВыборкаЭлементов.Родитель) <> Неопределено Тогда
						Если ВыборкаЭлементов.ЭтоГруппа Тогда
							МассивПропускаемых.Добавить(ВыборкаЭлементов.Ссылка);
							Продолжить;
						КонецЕсли;
					КонецЕсли;	
					
					Если ВыборкаЭлементов.ГруппаРесурсов <> ТекГруппаРесурса.Ссылка Тогда
						ТекОбъект 					= ВыборкаЭлементов.Ссылка.ПолучитьОбъект();
						ТекОбъект.ГруппаРесурсов 	= ТекГруппаРесурса.Ссылка;
						ТекОбъект.Записать();
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
    		
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

