// Заполняет сметный код в единицах.
//
Процедура ПроставитьСметныйКодЕдиницам() Экспорт
	
	Выборка = Справочники.СМ_ЕдиницыИзмеренияСмета.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.СметныйКод) Тогда
			Единица = Выборка.Ссылка.ПолучитьОбъект();
			Единица.СметныйКод = Единица.Код;
			Если Единица.СметныйКод>100000 Тогда
				Единица.СметныйКод=100000;
			КонецЕсли;
			Попытка
				Единица.Записать();
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область обн1_0_0_15

// Заполняет идентификацию АРПС сторонних сметных программ в конфигурации.
//
// Параметры:
//     СправочникОбъект - СправочникОбъект.СМ_СметныеПрограммы - программа.
//     СтрокаИндентификации - Строка - идентификатор АРПС.
//
Процедура ЗаполнитьИдентификаторАРПС(СправочникОбъект, СтрокаИндентификации) Экспорт
	
	Стр = СправочникОбъект.ИндентификацияАРПС.Добавиить();
	Стр.СтрокаИндентификации = СтрокаИндентификации;
	
КонецПроцедуры

// Проводит обновление до версии 1.0.0.15.
Процедура ЗагрузкаПриПервомСтарте() Экспорт
	
	// Эрикос.sudav
	// заполняем идентификацию для формата АРПС.
	Об = Справочники.СМ_СметныеПрограммы.СметаПлюс.ПолучитьОбъект();
	Если Об.ИндентификацияАРПС.Количество() = 0 Тогда
		Об.ИндентификацияАРПС.Очистить();
		ЗаполнитьИдентификаторАРПС(Об, НСтр("ru='Смета плюс'"));
	КонецЕсли;
	
	Об = Справочники.СМ_СметныеПрограммы.Смета30.ПолучитьОбъект();
	Если Об.ИндентификацияАРПС.Количество() = 0 Тогда
		Об.ИндентификацияАРПС.Очистить();
		ЗаполнитьИдентификаторАРПС(Об, НСтр("ru='1С:Смета 3'"));
	КонецЕсли;
	
	Об = Справочники.СМ_СметныеПрограммы.Смета23.ПолучитьОбъект();
	Если Об.ИндентификацияАРПС.Количество() = 0 Тогда
		Об.ИндентификацияАРПС.Очистить();
		ЗаполнитьИдентификаторАРПС(Об, НСтр("ru='1С: Смета'"));
	КонецЕсли;
	
	Об = Справочники.СМ_СметныеПрограммы.А0.ПолучитьОбъект();
	Если Об.ИндентификацияАРПС.Количество() = 0 Тогда
		Об.ИндентификацияАРПС.Очистить();
		ЗаполнитьИдентификаторАРПС(Об, НСтр("ru='A0WIN INFOSTROY'"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область обн3_0_1_43

// Заполняет код нормативных сборников.
Процедура ИзменитьКодСправочникаНормативныеСборники() Экспорт
	
	//
	перемЗИВ_Запрос	= Новый Запрос("ВЫБРАТЬ
	               	               |	СМ_НормативныеСборники.Ссылка,
	               	               |	СМ_НормативныеСборники.КодНормативнойРасценки
	               	               |ИЗ
	               	               |	Справочник.СМ_НормативныеСборники КАК СМ_НормативныеСборники
	               	               |ГДЕ
	               	               |	СМ_НормативныеСборники.ЭтоГруппа = ЛОЖЬ");
	
	перемЗИВ_Выборка	= перемЗИВ_Запрос.Выполнить().Выбрать();
	
	Пока перемЗИВ_Выборка.Следующий() Цикл
		
		перемЗИВ_Код	= СМ_СметаВызовСервера.ПреобразоватьКодСправочника(перемЗИВ_Выборка.КодНормативнойРасценки);
		
		Если Булево(перемЗИВ_Код) тогда
			Попытка
				перемЗИВ_Объект	= перемЗИВ_Выборка.Ссылка.ПолучитьОбъект();
				перемЗИВ_Объект.Код	= перемЗИВ_Код;
				перемЗИВ_Объект.Записать();
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

