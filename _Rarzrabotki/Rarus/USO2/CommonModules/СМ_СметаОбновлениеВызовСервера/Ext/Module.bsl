// Обновляем историю авторов цен на ресурсы
Процедура ОбновитьИсториюАвторов() Экспорт
	
	Выборка = Справочники.СМ_СметноНормативныеБазы.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		НаборЗаписей = РегистрыСведений.СМ_СметныеЦеныРесурсов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.СметноНормативнаяБаза.Установить(Выборка.Ссылка);
		НаборЗаписей.Прочитать();
		Для Каждого Запись Из НаборЗаписей Цикл
			Если ЗначениеЗаполнено(Запись.Автор) Тогда
				Запись.ИсторияИзмененияАвтора = "" + Запись.Автор + " / " + Формат(Запись.ДатаИзменения, "ДЛФ=DT"); 
			КонецЕсли;
		КонецЦикла;
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область обн3_0_1_87

// Обновляем историю авторов цен на ресурсы
Процедура ПеренестиНастройки() Экспорт
	
	ВыборкаПользователи = Справочники.Пользователи.Выбрать();
	
	Пока ВыборкаПользователи.Следующий() Цикл
		
		Если ВыборкаПользователи.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		
		СписокИсходныхНастроек	= СМ_СметаВызовСервера.ПолучитьСписокНастроек();
		
		УстановитьПривилегированныйРежим(Истина);
			
		СвойстваПользователя = Пользователи.НовоеОписаниеПользователяИБ();	
		
		Пользователи.ПрочитатьПользователяИБ(ВыборкаПользователи.ИдентификаторПользователяИБ, СвойстваПользователя); 
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Для каждого КлючИЗначение из СписокИсходныхНастроек Цикл
		
			СписокИсходныхНастроек[КлючИЗначение.Ключ] = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета",
				КлючИЗначение.Ключ,
				КлючИЗначение.Значение.ЗначениеПоУмолчанию,,ВыборкаПользователи.Наименование);
			
			ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("НастройкиПользователяСмета",
				КлючИЗначение.Ключ,
				СписокИсходныхНастроек[КлючИЗначение.Ключ],,СвойстваПользователя.Имя,Истина);
			
		КонецЦикла;

	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

