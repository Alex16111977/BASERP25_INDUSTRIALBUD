// Заполнение значений предопределенных элементов справочника СМ_ПоправкиПоТехническимЧастям.
Процедура ЗаполнитьЗначенияПоправокМДС() Экспорт
	
	// Получение данных из макета "Поправки МДС" и заполнение данных в справочнике поправок.
	ТабДок		= Справочники.СМ_ПоправкиПоТехническимЧастям.ПолучитьМакет("ПоправкиМДС");
	Построитель = Новый ПостроительЗапроса;
    Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабДок.Область(1,1,ТабДок.ВысотаТаблицы,9));
    Построитель.Выполнить();
	
	ТЗ = Построитель.Результат.Выгрузить();	
	Для Каждого ТекСтрока Из ТЗ Цикл
		ТекОбъект = Справочники.СМ_ПоправкиПоТехническимЧастям[ТекСтрока.НазваниеПредопределенного].ПолучитьОбъект();	
		Если НЕ ТекОбъект.ЭтоГруппа Тогда
			ТекОбъект.КоэффициентКОсновнойЗарплате 			= ТекСтрока.Коз;	
			ТекОбъект.КоэффициентКЭксплуатацииМашин 		= ТекСтрока.Кэм;
			ТекОбъект.КоэффициентКЗарплатеМашинистов 		= ТекСтрока.Кзм;
			ТекОбъект.КоэффициентКСтоимостиМатериалов 		= ТекСтрока.Ксм;
			ТекОбъект.КоэффициентКТрудозатратамРабочих 		= ТекСтрока.Кзтр;
			ТекОбъект.КоэффициентКТрудозатратамМашинистов 	= ТекСтрока.Кзтм;
			ТекОбъект.Обоснование 							= НСтр("ru='"+ТекСтрока.Обоснование+"'");
			ТекОбъект.УсловияПрименения 					= НСтр("ru='"+ТекСтрока.УсловияПрименения+"'");
			ТекОбъект.ТипПоправки							= Перечисления.СМ_ТипыПоправок.УсловияПроизводстваРаботМДС;
			ТекОбъект.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Заполнение значений предопределенных элементов справочника СМ_ПрефиксыРасценок.
Процедура ЗаполнитьПрефиксыРасценок() Экспорт
	
	ТабДок		= Справочники.СМ_ПрефиксыРасценок.ПолучитьМакет("ПрефиксыРасценок");
	Построитель = Новый ПостроительЗапроса;
    Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабДок.Область(1,1,ТабДок.ВысотаТаблицы,4));
    Построитель.Выполнить();
	
	ТЗ = Построитель.Результат.Выгрузить();	
	ТекРодитель = Справочники.СМ_ПрефиксыРасценок.ПустаяСсылка();
	Для Каждого ТекСтрока Из ТЗ Цикл
		Если Не ЗначениеЗаполнено(ТекСтрока.РегиональнаяБаза) Тогда
			ТекРодитель = Справочники.СМ_ПрефиксыРасценок.НайтиПоКоду(ТекСтрока.Код);
			Если ТекРодитель.Пустая() Тогда
				ТекОбъект = Справочники.СМ_ПрефиксыРасценок.СоздатьГруппу();
				ТекОбъект.Наименование = ТекСтрока.Наименование;
				ТекОбъект.Код = ТекСтрока.Код;
				Попытка
					ТекОбъект.ТипНормативногоСборника = Перечисления.СМ_ТипыНормативныхСборников[ТекСтрока.ТипНормативногоСборника];
				Исключение
					Событие = НСтр("ru = 'Не найден тип нормативного сборника.'");
					СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
				КонецПопытки;
				ТекОбъект.ОбменДанными.Загрузка = Истина;
				ТекОбъект.Записать();
				ТекРодитель = ТекОбъект.Ссылка;
			КонецЕсли;
		Иначе
			ТекЭлемент = Справочники.СМ_ПрефиксыРасценок.НайтиПоКоду(ТекСтрока.Код);
			Если ТекЭлемент.Пустая() Тогда
				ТекОбъект = Справочники.СМ_ПрефиксыРасценок.СоздатьЭлемент();
				ТекОбъект.Родитель = ТекРодитель;
				ТекОбъект.Наименование = ТекСтрока.Наименование;
				ТекОбъект.Код = ТекСтрока.Код;
				ТекОбъект.РегиональнаяБаза = Справочники.СМ_СметноНормативныеБазы.НайтиПоКоду(ТекСтрока.РегиональнаяБаза);
				Попытка
					ТекОбъект.Записать();
				Исключение
					ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					Событие = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Создание префикса расценок %1'"), ТекСтрока.Наименование);
					ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Информация, , , ПредставлениеОшибки);
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Заполнение значений реквизитов табличной части РесурсыПозицииЛокальнойСметы документа СМ_ПозицияЛокальнойСметы.
Процедура ЗаполнитьДанныеРесурсовПозиции() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	                |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ссылка
	                |ИЗ
	                |	Документ.СМ_ПозицияЛокальнойСметы.РесурсыПозицииЛокальнойСметы КАК СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы
	                |ГДЕ
	                |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.НаименованиеРесурса = &ПустаяСтрока
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ссылка";
	Запрос.УстановитьПараметр("ПустаяСтрока","");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Позиция = Выборка.Ссылка.ПолучитьОбъект();
		Для каждого СтрокаРесурс Из Позиция.РесурсыПозицииЛокальнойСметы Цикл
			СтрокаРесурс.НаименованиеРесурса = СтрокаРесурс.Ресурс.ДлинноеНаименование;
			СтрокаРесурс.ЕдиницаИзмеренияРесурса = СтрокаРесурс.Ресурс.ЕдиницаИзмерения;
		КонецЦикла;
		Если Позиция.Проведен Тогда
			Попытка
				Позиция.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Позиция.Записать();
			КонецПопытки;
		Иначе
			Позиция.Записать();
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	                |	СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ссылка
	                |ИЗ
	                |	Документ.СМ_АктВыполненныхРабот.РесурсыПозицийАкта КАК СМ_АктВыполненныхРаботРесурсыПозицийАкта
	                |ГДЕ
	                |	СМ_АктВыполненныхРаботРесурсыПозицийАкта.НаименованиеРесурса = &ПустаяСтрока
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ссылка";
	Запрос.УстановитьПараметр("ПустаяСтрока","");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Акт = Выборка.Ссылка.ПолучитьОбъект();
		Для каждого СтрокаРесурс Из Акт.РесурсыПозицийАкта Цикл
			СтрокаРесурс.НаименованиеРесурса = СтрокаРесурс.Ресурс.ДлинноеНаименование;
			СтрокаРесурс.ЕдиницаИзмеренияРесурса = СтрокаРесурс.Ресурс.ЕдиницаИзмерения;
		КонецЦикла;
		Если Акт.Проведен Тогда
			Попытка
				Акт.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Акт.Записать();
			КонецПопытки;
		Иначе
			Акт.Записать();
		КонецЕсли;
	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

// Очищает ИДРодителя локальных смет неверно заполненное при копировании.
Процедура ОчиститьНеверныеИДРодителя() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета КАК Смета
	               |ПОМЕСТИТЬ СметыТЧ
	               |ИЗ
	               |	Документ.СМ_ОбъектнаяСмета.ЛокальныеСметы КАК СМ_ОбъектнаяСметаЛокальныеСметы
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СМ_СводнаяСметаСметы.Смета
	               |ИЗ
	               |	Документ.СМ_СводнаяСмета.Сметы КАК СМ_СводнаяСметаСметы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_ЛокальнаяСмета.Ссылка
	               |ИЗ
	               |	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	               |ГДЕ
	               |	(СМ_ЛокальнаяСмета.ИДРодителя ССЫЛКА Документ.СМ_СводнаяСмета
	               |				И НЕ СМ_ЛокальнаяСмета.ИДРодителя = ЗНАЧЕНИЕ(Документ.СМ_СводнаяСмета.ПустаяСсылка)
	               |			ИЛИ СМ_ЛокальнаяСмета.ИДРодителя ССЫЛКА Документ.СМ_ОбъектнаяСмета
	               |				И НЕ СМ_ЛокальнаяСмета.ИДРодителя = ЗНАЧЕНИЕ(Документ.СМ_ОбъектнаяСмета.ПустаяСсылка))
	               |	И НЕ СМ_ЛокальнаяСмета.Ссылка В
	               |				(ВЫБРАТЬ
	               |					СметыТЧ.Смета
	               |				ИЗ
	               |					СметыТЧ КАК СметыТЧ)";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Смета = Выборка.Ссылка.ПолучитьОбъект();
		Смета.ОбменДанными.Загрузка = Истина;
		Смета.ИДРодителя = Неопределено;
		Смета.Записать();
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

// Заполнение типов предопределенных элементов справочника СМ_ПоправкиПоТехническимЧастям.
Процедура УстановитьТипыПоправокПоТехЧастям() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СМ_ПоправкиПоТехническимЧастям.Ссылка,
	|	СМ_ПоправкиПоТехническимЧастям.Предопределенный,
	|	СМ_ПоправкиПоТехническимЧастям.ЭтоГруппа,
	|	СМ_ПоправкиПоТехническимЧастям.ТипПоправки
	|ИЗ
	|	Справочник.СМ_ПоправкиПоТехническимЧастям КАК СМ_ПоправкиПоТехническимЧастям
	|ГДЕ
	|	СМ_ПоправкиПоТехническимЧастям.ЭтоГруппа = ЛОЖЬ";
	
	ТекВыборка = Запрос.Выполнить().Выбрать();
	Пока ТекВыборка.Следующий() Цикл 
		
		Если ЗначениеЗаполнено(ТекВыборка.ТипПоправки) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекВыборка.Предопределенный Тогда
			ТекТип = Перечисления.СМ_ТипыПоправок.ДемонтажМДС;	
		Иначе
			ТекТип = Перечисления.СМ_ТипыПоправок.ТехчастиСборников;
		КонецЕсли;
		
		ТекОбъект 				= ТекВыборка.Ссылка.ПолучитьОбъект();
		ТекОбъект.ТипПоправки 	= ТекТип;
		ТекОбъект.Записать();
		
	КонецЦикла
	
КонецПроцедуры

