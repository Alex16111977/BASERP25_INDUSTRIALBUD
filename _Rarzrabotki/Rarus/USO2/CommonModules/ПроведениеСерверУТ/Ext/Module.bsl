			ТекстСообщения = СтрЗаменить(ТекстСообщения,  "%ЕдиницаИзмерения%", ЕдиницаИзмерения);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Объект, ,, Отказ);
			
