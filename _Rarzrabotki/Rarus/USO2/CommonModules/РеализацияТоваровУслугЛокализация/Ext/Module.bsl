	//ТекстыОтражения.Добавить(ТекстСебестоимостьОтгруженногоТовара());
	ТекстыОтражения.Добавить(УСОERP_ТекстВыручкаОтРеализацииСобственногоТовара_Типовая());
	ТекстыОтражения.Добавить(УСОERP_ТекстСебестоимостьОтгруженногоТовара_Типовая());
