#Область ПрограммныйИнтерфейс

// Запуск системы защиты СЛК.
Процедура Запуск() Экспорт
	
	//Возврат;
	НеобходимаяВерсия = "3.0.13.6968";
	// Проверка версии компоненты.
	Если НЕ СМ_НепоставляемыйВызовСервера.ПроверитьВерсию(НеобходимаяВерсия) Тогда
		Сообщение = НСтр("ru='Устаревшая версия СЛК, для работы конфигурации необходима СЛК %Параметр% или выше'"); 
		Сообщение = СтрЗаменить(Сообщение, "%Параметр%", НеобходимаяВерсия); 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение); 			
	КонецЕсли;
	
	 Попытка
		 СМ_НепоставляемыйВызовСервера.Запуск();
	 Исключение
		 Сообщение = НСтр("ru='Ошибка запуска СЛК:'")+" "+ОписаниеОшибки(); 
		 ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение); 
		 ОткрытьФорму("Обработка.слкМенеджерЛицензий.Форма");
		 // ЗавершитьРаботуСистемы();                   
	 КонецПопытки;
	 
КонецПроцедуры

// Запуск системы защиты СЛК.
//
// Возвращаемое значение:  
//     Истина - закрывать, иначе - ложь.
//        
Функция ЗапускОбъекта() Экспорт
	
	//Возврат Ложь;
	НеобходимаяВерсия = "3.0.13.6968";
	// Проверка версии компоненты.
	Если НЕ СМ_НепоставляемыйВызовСервера.ПроверитьВерсию(НеобходимаяВерсия) Тогда
		Сообщение = НСтр("ru='Устаревшая версия СЛК, для работы конфигурации необходима СЛК %Параметр% или выше'"); 
		Сообщение = СтрЗаменить(Сообщение, "%Параметр%", НеобходимаяВерсия); 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение); 			
	КонецЕсли;
	
	 Попытка
		 СМ_НепоставляемыйВызовСервера.Запуск();
		 Возврат Ложь;
	 Исключение
		 Сообщение = НСтр("ru='Ошибка запуска СЛК:'")+" "+ОписаниеОшибки(); 		 
		 ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение); 
		 Возврат Истина;
	 КонецПопытки;
	
КонецФункции

// Остановка системы защиты СЛК.
//
// Параметры:  
//     нет
//      
Процедура Стоп() Экспорт
	
	СМ_НепоставляемыйВызовСервера.Стоп();

КонецПроцедуры 

#КонецОбласти
