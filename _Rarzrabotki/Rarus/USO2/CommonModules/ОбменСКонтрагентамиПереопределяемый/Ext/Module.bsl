	//++ НЕ ГОСИС
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, 
			"ДатаПолученияГруза", 
			ТекущаяДатаСеанса());
	//-- НЕ ГОСИС
	
КонецПроцедуры

// Подготавливает данные титула заказчика для электронного документа типа Акт выполненных работ формата 5.01.
