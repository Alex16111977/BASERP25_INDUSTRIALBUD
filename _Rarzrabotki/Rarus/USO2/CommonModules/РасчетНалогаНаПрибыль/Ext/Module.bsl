	                     |
	                     |ВЫБРАТЬ
	                     |	ХозрасчетныйОборотыДтКт.СчетКт,";
						 
						 
						 Если КоличествоОбъектовАналитики > 0 Тогда
							 ТекстЗапросаШаблон = ТекстЗапросаШаблон + "
							 |	ХозрасчетныйОборотыДтКт.СубконтоКт1,";
						 КонецЕсли;
						 Если КоличествоОбъектовАналитики > 1 Тогда
