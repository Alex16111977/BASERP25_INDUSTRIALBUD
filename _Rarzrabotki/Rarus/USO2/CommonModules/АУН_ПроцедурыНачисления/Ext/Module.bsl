
#Область ОбработкаКлиентскихВызовов

// Процедура обрабатывает команду, переданную из клиентского модуля
Процедура ОбработатьКомандуРассчитатьНачислениеАренды(ДанныеФормы, ДополнительныеПараметры) Экспорт
	
	ИмяДокумента = ДанныеФормы.Ссылка.Метаданные().Имя;
	ДокументОбъект = ДанныеФормыВЗначение(ДанныеФормы, Тип("ДокументОбъект." + ИмяДокумента));
	
	Если ДополнительныеПараметры.ЭтоПостояннаяЧасть Тогда
		РассчитатьПостояннуюЧастьОплаты(ДокументОбъект);
	Иначе
		РассчитатьПеременнуюЧастьОплаты(ДокументОбъект);
	КонецЕсли;
	УстановитьПризнакВключенияНДСВСтоимость(ДокументОбъект, "Товары", Истина);
	
	ЗначениеВДанныеФормы(ДокументОбъект, ДанныеФормы);
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСНачислениемАренды

// Процедура предназначена для автоматического заполнения заказа клиента и реализации
// в случае заполнения не по счетам услугами
// постоянной части оплаты
// Параметры:
//		Объект - документ-объект.
Процедура РассчитатьПостояннуюЧастьОплаты(ДокументОбъект) Экспорт
	
	ДанныеОбъекта = АУН_ОбщиеПроцедуры.ПрочитатьДанныеОбъекта(ДокументОбъект, Истина);
	КоллекцияРеквизитов = АУН_ОбщиеПроцедурыКлиентСервер.ПолучитьКоллекциюРеквизитов(ДокументОбъект);
	
	ДанныеУчета = ПолучитьДанныеПостояннойЧастиОплаты(ДанныеОбъекта);
	
	Для Каждого Колонка Из ДанныеУчета.Колонки Цикл
		Если КоллекцияРеквизитов.Свойство(Колонка.Имя) Тогда
			Колонка.Имя = КоллекцияРеквизитов[Колонка.Имя];
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из ДанныеУчета Цикл
		Если НЕ СтрокаДанных.Цена = 0 Тогда
			СтрокаТовары = ДокументОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТовары, СтрокаДанных);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДанныеПостояннойЧастиОплаты(ДанныеОбъекта) Экспорт
	
	ДанныеУчета = Новый ТаблицаЗначений;
	ДанныеУчета.Колонки.Добавить("Номенклатура");
	ДанныеУчета.Колонки.Добавить("ОбъектАренды");
	ДанныеУчета.Колонки.Добавить("ПериодАренды");
	ДанныеУчета.Колонки.Добавить("СпособНачисления");
	ДанныеУчета.Колонки.Добавить("СтавкаСпособаНачисления");
	ДанныеУчета.Колонки.Добавить("КоличествоДней");
	ДанныеУчета.Колонки.Добавить("ПериодНачало");
	ДанныеУчета.Колонки.Добавить("ПериодКонец");
	ДанныеУчета.Колонки.Добавить("ДатаНачалаАренды");
	ДанныеУчета.Колонки.Добавить("ДатаОкончанияАренды");
	ДанныеУчета.Колонки.Добавить("Цена");
	ДанныеУчета.Колонки.Добавить("Количество");
	ДанныеУчета.Колонки.Добавить("СтавкаНДС");
	ДанныеУчета.Колонки.Добавить("Сумма");
	ДанныеУчета.Колонки.Добавить("Валюта");
	ДанныеУчета.Колонки.Добавить("Курс");
	ДанныеУчета.Колонки.Добавить("Кратность");
	ДанныеУчета.Колонки.Добавить("ВариантОбеспечения");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("НачалоПериода", ДанныеОбъекта.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", ДанныеОбъекта.ОкончаниеПериода);
	Запрос.УстановитьПараметр("Договор", ДанныеОбъекта.Договор);
	Запрос.УстановитьПараметр("ДатаСреза", КонецДня(ДанныеОбъекта.Дата));
	Запрос.УстановитьПараметр("ВАренде", Перечисления.АУН_СтатусыОбъектовАренды.ВАренде);
	
	Запрос.Текст = ПолучитьТекстЗапросаПоНачислениюПостояннойЧасти();
				
	ВыборкаУслуг = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаУслуг.Следующий() Цикл
		// Обход по услугам
		ВыборкаОбъектов = ВыборкаУслуг.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаОбъектов.Следующий() Цикл
			// Обход по объектам аренды
			ВыборкаДанных = ВыборкаОбъектов.Выбрать();
			
			КоличествоПериодов = ВыборкаДанных.Количество();
			КоличествоОбработанныхПериодов = 0;
			
			Пока ВыборкаДанных.Следующий() Цикл
				// Обход по периодам изменения параметров начисления арендной платы
				
				Если ВыборкаДанных.ПериодКонец <= ВыборкаДанных.ДатаНачалаАренды Тогда // Объект сдан не с начала периода
					КоличествоПериодов = КоличествоПериодов - 1;
					Продолжить;
				КонецЕсли;
				
				Если КоличествоОбработанныхПериодов = 0
					И Не ЗначениеЗаполнено(ВыборкаДанных.СпособНачисления) Тогда
					ТекстСообщения = "Для объекта аренды """ + ВыборкаДанных.АУН_ОбъектАренды + """ по услуге """ + ВыборкаДанных.Номенклатура 
					+ """ на дату " + Формат(ВыборкаДанных.ПериодНачало, "ДФ=dd.MM.yyyy") + " не задана ставка!";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				КонецЕсли;
				
				Если КоличествоОбработанныхПериодов>0 Тогда
					ДанныеУчета[ДанныеУчета.Количество()-1].ПериодКонец = НачалоДня(ВыборкаДанных.ПериодНачало-1);	
				КонецЕсли;
				
				Стр = ДанныеУчета.Добавить();
				ЗаполнитьЗначенияСвойств(Стр,ВыборкаДанных);
				Если Не ЗначениеЗаполнено(ВыборкаДанных.СтавкаНДС) Тогда
					Стр.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
				КонецЕсли;
				
				Если (ТипЗнч(Стр.Количество) = Тип("NULL")) или (Стр.Количество=0) тогда
					Стр.Количество=1;	
				конецЕсли;
				
				КоличествоОбработанныхПериодов = КоличествоОбработанныхПериодов+1;
				Если КоличествоОбработанныхПериодов = КоличествоПериодов Тогда
					Стр.ПериодКонец = Мин(ВыборкаДанных.ДатаОкончанияАренды, ДанныеОбъекта.ОкончаниеПериода);
				КонецЕсли;
				
			КонецЦикла;	
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Необходимо разбить все периоды по периодам договора или периодам способа начисления.
	НомерСтроки = 0;
	Пока НомерСтроки < ДанныеУчета.Количество() Цикл
		СтрокаТаб = ДанныеУчета[НомерСтроки];
		Периодичность = Перечисления.Периодичность.Месяц;
		СтрокаТаб.ПериодАренды = НачалоПериода(СтрокаТаб.ПериодНачало, Периодичность);
		
		// Если периодичность больше месяца, то разобъем по месяцам
		// кроме случа Периодичность = Год и период начисления - календарный год или несколько.
		Если Периодичность = Перечисления.Периодичность.Год
			И ДанныеОбъекта.НачалоПериода = НачалоГода(ДанныеОбъекта.НачалоПериода)
			И КонецДня(ДанныеОбъекта.ОкончаниеПериода) = КонецГода(ДанныеОбъекта.ОкончаниеПериода) Тогда
		ИначеЕсли Не (Периодичность = Перечисления.Периодичность.День ИЛИ Периодичность = Перечисления.Периодичность.Неделя) Тогда
			Периодичность = Перечисления.Периодичность.Месяц;
		КонецЕсли;
		
		Если НачалоПериода(СтрокаТаб.ПериодНачало, Периодичность) < НачалоПериода(СтрокаТаб.ПериодКонец, Периодичность) Тогда
			НоваяСтрокаТаб = ДанныеУчета.Вставить(НомерСтроки + 1);
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТаб, СтрокаТаб);
			СтрокаТаб.ПериодКонец = КонецПериода(СтрокаТаб.ПериодНачало, Периодичность);
			НоваяСтрокаТаб.ПериодНачало = КонецПериода(СтрокаТаб.ПериодНачало, Периодичность) + 1;
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	РассчитатьСуммуНачисления(ДанныеУчета);
	
	РассчитатьСуммуЦену(ДанныеОбъекта, ДанныеУчета, Истина);
	
	ДанныеУчета.Свернуть("Номенклатура,ОбъектАренды,Цена,СтавкаСпособаНачисления,СпособНачисления,Количество,СтавкаНДС,ВариантОбеспечения","Сумма,КоличествоДней");
	
	Возврат ДанныеУчета;
	
КонецФункции

// Процедура предназначена для автоматического заполнения заказа клиента и реализации
// в случае заполнения не по счетам услугами
// переменной части оплаты
// Параметры:
//		Объект - документ-объект
//		ИмяТабличнойЧасти - имя табличной части, которая будет заполнена данными из выборки.
Процедура РассчитатьПеременнуюЧастьОплаты(ДокументОбъект) Экспорт
	
	ДанныеОбъекта = АУН_ОбщиеПроцедуры.ПрочитатьДанныеОбъекта(ДокументОбъект, Истина);
	КоллекцияРеквизитов = АУН_ОбщиеПроцедурыКлиентСервер.ПолучитьКоллекциюРеквизитов(ДокументОбъект);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("НачалоПериода", ДанныеОбъекта.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", ДанныеОбъекта.ОкончаниеПериода);
	Запрос.УстановитьПараметр("Договор", ДанныеОбъекта.Договор);
	Запрос.УстановитьПараметр("ДатаСреза", КонецДня(ДанныеОбъекта.Дата));
	Запрос.УстановитьПараметр("ВАренде", Перечисления.АУН_СтатусыОбъектовАренды.ВАренде);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АУН_НачисленияПоТарифицируемымУслугамОбороты.УслугаАренды КАК Номенклатура,
	|	АУН_НачисленияПоТарифицируемымУслугамОбороты.ОбъектАренды КАК ОбъектАренды,
	|	АУН_НачисленияПоТарифицируемымУслугамОбороты.Ставка КАК СтавкаСпособаНачисления,
	|	АУН_НачисленияПоТарифицируемымУслугамОбороты.Ставка КАК Цена,
	|	АУН_НачисленияПоТарифицируемымУслугамОбороты.КоличествоОборот КАК Количество,
	|	АУН_НачисленияПоТарифицируемымУслугамОбороты.СуммаОборот КАК Сумма,
	|	ЕСТЬNULL(АУН_СтавкиСрезПоследних.СтавкаНДС, АУН_НачисленияПоТарифицируемымУслугамОбороты.УслугаАренды.СтавкаНДС) КАК СтавкаНДС,
	|	ЕСТЬNULL(АУН_СтавкиСрезПоследних.СпособНачисления, ЗНАЧЕНИЕ(Справочник.АУН_СпособыНачисленияАренднойПлаты.ПустаяСсылка)) КАК СпособНачисления,
	|	ЕСТЬNULL(АУН_СтавкиСрезПоследних.СпособНачисления.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК Валюта,
	|	АУН_НачисленияПоТарифицируемымУслугамОбороты.Договор КАК Договор,
	|	ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.НеТребуется) КАК ВариантОбеспечения
	|ИЗ
	|	РегистрНакопления.АУН_НачисленияПоТарифицируемымУслугам.Обороты(
	|			,
	|			,
	|			,
	|			Договор = &Договор
	|				И (ПериодАренды МЕЖДУ &НачалоПериода И &КонецПериода)) КАК АУН_НачисленияПоТарифицируемымУслугамОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АУН_Ставки.СрезПоследних(&КонецПериода, Договор = &Договор) КАК АУН_СтавкиСрезПоследних
	|		ПО АУН_НачисленияПоТарифицируемымУслугамОбороты.УслугаАренды = АУН_СтавкиСрезПоследних.Услуга
	|			И АУН_НачисленияПоТарифицируемымУслугамОбороты.ОбъектАренды = АУН_СтавкиСрезПоследних.ОбъектАренды";
	
	ДанныеУчета = Запрос.Выполнить().Выгрузить();
	
	ДанныеУчета.Колонки.Добавить("ПериодАренды");

	Для Каждого СтрокаТаб Из ДанныеУчета Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаб.Цена) Тогда
			ТекстСообщения = "Для объекта аренды """ + СтрокаТаб.ОбъектАренды + """ по услуге """ + СтрокаТаб.Номенклатура + """ на дату " + Формат(ДанныеОбъекта.ОкончаниеПериода, "ДФ=dd.MM.yyyy") + " не задана ставка!";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	
	РассчитатьСуммуЦену(ДанныеОбъекта, ДанныеУчета);
	
	Для Каждого Колонка Из ДанныеУчета.Колонки Цикл
		Если КоллекцияРеквизитов.Свойство(Колонка.Имя) Тогда
			Колонка.Имя = КоллекцияРеквизитов[Колонка.Имя];
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из ДанныеУчета Цикл
		СтрокаТовары = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТовары, СтрокаДанных);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТекстЗапросаПоНачислениюПостояннойЧасти()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(АУН_СтавкиСрезПоследних.Период, ДЕНЬ) КАК ДатаЗаписи,
	|	АУН_СтавкиСрезПоследних.Услуга,
	|	АУН_СтавкиСрезПоследних.ОбъектАренды,
	|	АУН_СтавкиСрезПоследних.Ставка,
	|	АУН_СтавкиСрезПоследних.СтавкаНДС,
	|	АУН_СтавкиСрезПоследних.СпособНачисления,
	|	АУН_СтавкиСрезПоследних.Площадь
	|ПОМЕСТИТЬ ВТСтавки
	|ИЗ
	|	РегистрСведений.АУН_Ставки.СрезПоследних(КОНЕЦПЕРИОДА(&НачалоПериода, ДЕНЬ), Договор = &Договор) КАК АУН_СтавкиСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(АУН_Ставки.Период, ДЕНЬ),
	|	АУН_Ставки.Услуга,
	|	АУН_Ставки.ОбъектАренды,
	|	АУН_Ставки.Ставка,
	|	АУН_Ставки.СтавкаНДС,
	|	АУН_Ставки.СпособНачисления,
	|	АУН_Ставки.Площадь
	|ИЗ
	|	РегистрСведений.АУН_Ставки КАК АУН_Ставки
	|ГДЕ
	|	НАЧАЛОПЕРИОДА(АУН_Ставки.Период, ДЕНЬ) > &НачалоПериода
	|	И НАЧАЛОПЕРИОДА(АУН_Ставки.Период, ДЕНЬ) <= &КонецПериода
	|	И АУН_Ставки.Договор = &Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСтавки.ДатаЗаписи,
	|	ВТСтавки.ДатаЗаписи КАК ДатаНачала,
	|	ВТСтавки.Ставка КАК Ставка,
	|	ВТСтавки.СтавкаНДС,
	|	ВТСтавки.Услуга,
	|	ВТСтавки.ОбъектАренды,
	|	ВТСтавки.СпособНачисления КАК СпособНачисления,
	|	ВТСтавки.Площадь
	|ПОМЕСТИТЬ ВТСтавкиДатыНачалаБезПересечения
	|ИЗ
	|	ВТСтавки КАК ВТСтавки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТСтавкиДатыНачалаБезПересечения.ДатаЗаписи,
	|	ВТСтавкиДатыНачалаБезПересечения.Услуга,
	|	ВТСтавкиДатыНачалаБезПересечения.ОбъектАренды,
	|	МИНИМУМ(ЕСТЬNULL(ВТСтавкиДатыНачалаБезПересеченияОгр.ДатаЗаписи, ДОБАВИТЬКДАТЕ(&КонецПериода, ДЕНЬ, 1))) КАК ДатаОкончанияГрафика
	|ПОМЕСТИТЬ ПериодыГрафиков
	|ИЗ
	|	ВТСтавкиДатыНачалаБезПересечения КАК ВТСтавкиДатыНачалаБезПересечения
