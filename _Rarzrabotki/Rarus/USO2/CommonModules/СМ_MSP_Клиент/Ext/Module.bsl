
#Область ПрограммныйИнтерфейс

// Функция заполняет сводную таблицу с колонками:
// 	 * MSP_НаименованиеОбъекта
//   * MSP_НаименованиеЗадачи
//   * MSP_НаименованиеРесурса
//   * MSP_ЕдиницаИзмеренияРесурса
// Также могут заполняться колонки дополнительных свойств из файла MS PROJECT.
// Ссылка на файл указана в реквизитах объекта строительства.
//
// Параметры:
//   ОбъектСтроительства 		- СправочникСсылка.СМ_ОбъектыСтроительства - ссылка на объект.
//	 СтруктураПолей				- Структура - структура заполнения полей.	
//	 МассивЗначений				- Массив - массив значений заполнения.
// 	 ИспользоватьДопРеквизиты	- Булево - признак использования дополнительных реквизитов.
//	 НаименованиеПроекта		- Строка - наименование проекта, если заполнено.
//	 ФормаИндикатора			- Строка - отображение формы индикатора.
//
// Возвращаемое значение:
//   Булево - Истина - запись успешна, Ложь - запись не успешна.
//
Функция ПрочитатьФайлОбъекта(ОбъектСтроительства,СтруктураПолей,МассивЗначений, ИспользоватьДопРеквизиты=Ложь,НаименованиеПроекта="",ФормаИндикатора="") Экспорт
	
	АдресФайла = СМ_MSP_ВызовСервера.ПолучитьПутьПроектMSP(ОбъектСтроительства);
	
	Если Не ЗначениеЗаполнено(АдресФайла) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнен путь к файлу MS PROJECT в объекте строительства'"));
		
		Возврат Ложь;
		
	КонецЕсли; 
	
	MSProject = Неопределено;
	
	Попытка
		
		MSProject = Новый COMОбъект("MSProject.Application"); 
		MSProject.DisplayAlerts = False;
		MSProject.Visible=False;
		Попытка
			ВерсияMSP = Лев(MSProject.Version,2);
			
			ВерсияMSProject = Число(ВерсияMSP);
		Исключение
			ВерсияMSProject = 0;
		КонецПопытки;
		
	Исключение
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Ошибка инициализации MS Project: '")+ОписаниеОшибки());
		
		Возврат Ложь;
		
	КонецПопытки;
	
	Попытка
		
		MSProject.FileOpenEx(АдресФайла, Истина);
		Проект = MSProject.ActiveProject;
		
	Исключение
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Ошибка открытия файла MS Project, возможно файл открыт в другой программе: '")+ОписаниеОшибки());
		
		Возврат Ложь;
		
	КонецПопытки;
	
	
	Номер=1;
	СтрокаПроекта=НоваяСтруктураДляЗаполнения(СтруктураПолей);
	СтрокаПроекта.MSP_НаименованиеОбъекта = Проект.Name;
	НаименованиеПроекта=СтрокаПроекта.MSP_НаименованиеОбъекта;
	СтрокаПроекта.MSP_ВидОбъекта ="Проект";
	СтрокаПроекта.НомерДляСопоставления=Номер;
	СтрокаПроекта.ЕстьВложенныеЗадачи=Истина;
	СтрокаПроекта.НомерРодителя=0;
	МассивЗначений.Добавить(СтрокаПроекта);
	Номер=Номер+1;
	Счетчик=0;
	Если ФормаИндикатора<>"" Тогда
		если  ФормаИндикатора.открыта() Тогда
			ФормаИндикатора.Элементы.Прогресс.МаксимальноеЗначение=Проект.Tasks.Count;
		Конецесли;
	КонецЕсли;
	
	Для Каждого Задача Из Проект.Tasks Цикл
		Счетчик=Счетчик+1;		
		
		Если Задача.Outlinelevel=1 Тогда
			СтрокаТЗ =НоваяСтруктураДляЗаполнения(СтруктураПолей);	
			СтрокаТЗ.MSP_НаименованиеОбъекта = Задача.Name;
			СтрокаТЗ.MSP_GUID = Задача.GUID;
			СтрокаТЗ.MSP_ВидОбъекта = "Задача";
			СтрокаТЗ.НомерДляСопоставления=Номер;
			СтрокаТЗ.НомерРодителя=1;
			Номер=Номер+1;
			Если   ИспользоватьДопРеквизиты Тогда
				УстановитьЗначениеДопРеквизитовВСтроке(Задача,СтрокаТЗ,СтруктураПолей, MSProject);
			КонецЕсли;
			МассивЗначений.Добавить(СтрокаТЗ);
			
			ДобавитьСтрокиПодзадач(МассивЗначений,СтрокаТЗ, MSProject,Проект,Задача,ИспользоватьДопРеквизиты,СтруктураПолей,Номер,СтрокаТЗ.НомерДляСопоставления);
			
			ДобавитьРесурсыЗадачи(Задача,МассивЗначений,СтрокаТЗ,MSProject,СтруктураПолей,ИспользоватьДопРеквизиты,Номер,СтрокаТЗ.НомерДляСопоставления);
			Если ФормаИндикатора<>"" Тогда
				если  ФормаИндикатора.открыта() Тогда	
					ФормаИндикатора.Прогресс=Счетчик;
					ФормаИндикатора.ОбновитьОтображениеДанных();
				Конецесли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 
	MSProject.Quit();
	Возврат Истина;
	
КонецФункции

// Записывает файл объекта строительства
//
// Параметры:
//   ОбъектСтроительства 	- СправочникСсылка.СМ_ОбъектыСтроительства - ссылка на объект.
//	 Таблица				- ТаблицаЗначений - таблица с данными заполнения.	
// 
// Возвращаемое значение:
//   Булево - Истина - запись успешна, Ложь - запись не успешна.
//
Функция ЗаписатьФайлОбъекта(ОбъектСтроительства,Таблица) Экспорт
	
	АдресФайла 		= СМ_MSP_ВызовСервера.ПолучитьПутьПроектMSP(ОбъектСтроительства);
	ИмяФайла		= СтрЗаменить(АдресФайла,"\",Символы.ПС);
	ИмяФайла 		= СтрПолучитьСтроку(ИмяФайла,СтрЧислоСтрок(ИмяФайла));
	АдресПротокола 	= СтрЗаменить(АдресФайла,ИмяФайла,"")+"MSPПротоколВыгрузки.txt";
	Док 			= Новый ТекстовыйДокумент;
	
	Попытка
		Если Не ЗначениеЗаполнено(АдресФайла) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнен путь к файлу MS PROJECT в объекте строительства'"));
			Возврат Ложь;
		КонецЕсли; 
		
		MSProject = Неопределено;
		MSProject = Новый COMОбъект("MSProject.Application"); 
		MSProject.DisplayAlerts = False;
		MSProject.Visible=False;
		Попытка
			ВерсияMSP = Лев(MSProject.Version,2);
			ВерсияMSProject = Число(ВерсияMSP);
		Исключение
			ВерсияMSProject = 0;
		КонецПопытки;
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Ошибка инициализации MS Project: '")+ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		MSProject.FileOpenEx(АдресФайла, Ложь);
		Проект = MSProject.ActiveProject;
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Ошибка открытия файла MS Project: '")+ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	Для Каждого Задача Из Проект.Tasks Цикл
		Для каждого Asgn Из Задача.Assignments Цикл
			Для Каждого Эл Из  Таблица Цикл
				Если Эл.GUID=Asgn.GUID Тогда
					Док.ДобавитьСтроку(Задача.Name+" "+Asgn.ResourceName+" Старый объем:"+Asgn.Work+" Новый объем:"+Эл.Объем);	
					Asgn.Work= СтрЗаменить(Эл.Объем,Символы.НПП,"");
					//Asgn.Resource.MaterialLabel=Эл.Единица;
					Эл.Выгружено=Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла; 
	
	Попытка
		MSProject.Application.FileSave();
		MSProject.Application.Quit();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Ошибка сохранения файла MS Project, возможно файл открыт в другой программе: '")+ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	// Синхронный вызов
	// Док.Записать(АдресПротокола);
	
	// Замена на асинхронный вызов
	ОповещениеЗаписи = Новый ОписаниеОповещения("ВыполнитьПослеЗаписиФайла", ЭтотОбъект, АдресПротокола);
	Док.НачатьЗапись(ОповещениеЗаписи,АдресПротокола); 
	
	Возврат Истина;
	
КонецФункции

// Выполняет действия после записи файла
//
// Параметры:
//   Результат 		- Булево, Неопределено - результат записи файла.
//	 АдресПротокола	- Строка - полный путь файла.	
//
Процедура ВыполнитьПослеЗаписиФайла(Результат, АдресПротокола) Экспорт
	
    Сообщение 		= Новый СообщениеПользователю();
    Сообщение.Текст = "Записан файл " + АдресПротокола;
    Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьСтрокиПодзадач(МассивЗначений,УзелРодитель,Приложение,Проект,Задача,ИспользоватьДопРеквизиты,СтруктураПолей,Номер,НомерРодителя)
	
	Для каждого Подзадача Из Задача.OutlineChildren Цикл
		СтрокаТЗ =НоваяСтруктураДляЗаполнения(СтруктураПолей);
		
		СтрокаТЗ.MSP_НаименованиеОбъекта = Подзадача.Name;
		СтрокаТЗ.MSP_ВидОбъекта = "Задача";
		СтрокаТЗ.MSP_GUID = Подзадача.GUID;
		СтрокаТЗ.НомерДляСопоставления=Номер;
		УзелРодитель.ЕстьВложенныеЗадачи=Истина;
		СтрокаТЗ.НомерРодителя=НомерРодителя;
		
		Номер=Номер+1;
		
		Если   ИспользоватьДопРеквизиты Тогда
			УстановитьЗначениеДопРеквизитовВСтроке(Подзадача,СтрокаТЗ,СтруктураПолей, Приложение);
		КонецЕсли;
		МассивЗначений.Добавить(СтрокаТЗ);
		
		ДобавитьСтрокиПодзадач(МассивЗначений,СтрокаТЗ,Приложение,Проект,Подзадача,ИспользоватьДопРеквизиты,СтруктураПолей,Номер,СтрокаТЗ.НомерДляСопоставления);
		ДобавитьРесурсыЗадачи(Подзадача,МассивЗначений,СтрокаТЗ,Приложение,СтруктураПолей,ИспользоватьДопРеквизиты,Номер,СтрокаТЗ.НомерДляСопоставления);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьРесурсыЗадачи(Задача,МассивЗначений,УзелРодитель,Приложение,СтруктураПолей,ИспользоватьДопРеквизиты,Номер,НомерРодителя)
	Для каждого Asgn Из Задача.Assignments Цикл
		СтрокаТЗ =НоваяСтруктураДляЗаполнения(СтруктураПолей);
		ЗаполнитьЗначенияСвойств(СтрокаТЗ,УзелРодитель);
		СтрокаТЗ.MSP_НаименованиеОбъекта = Asgn.ResourceName;
		СтрокаТЗ.MSP_ЕдиницаИзмеренияРесурса = Asgn.Resource.MaterialLabel;
		СтрокаТЗ.MSP_Объем=Asgn.Work;
		СтрокаТЗ.MSP_ВидОбъекта = "Ресурс";
		СтрокаТЗ.MSP_GUID = Asgn.GUID;
		СтрокаТЗ.НомерДляСопоставления=Номер;
		СтрокаТЗ.НомерРодителя=НомерРодителя;
		Номер=Номер+1;
		МассивЗначений.Добавить(СтрокаТЗ);
	КонецЦикла;
КонецПроцедуры

Процедура УстановитьЗначениеДопРеквизитовВСтроке(Задача,СтрокаТЗ,КолонкиТаблицы, Приложение)
	Для Каждого Рекв Из КолонкиТаблицы Цикл
		Если СтрДлина(Рекв.Значение)>0 Тогда
			Попытка
				СтрокаТЗ[Рекв.Ключ]=Задача.GetField(Приложение.FieldNameToFieldConstant(Рекв.Значение));
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция НоваяСтруктураДляЗаполнения(Образец)
	СтруктураНовая=Новый Структура;
	Для Каждого Стр Из Образец Цикл
		СтруктураНовая.Вставить(Стр.Ключ,"");
	КонецЦикла;
	Возврат СтруктураНовая;
КонецФункции

#КонецОбласти


