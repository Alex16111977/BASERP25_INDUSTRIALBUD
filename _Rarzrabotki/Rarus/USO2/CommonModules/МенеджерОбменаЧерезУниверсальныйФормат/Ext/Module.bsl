		СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
		
		// Заполнение данных НМА.
		ДанныеНМА = Новый Структура();
		ДанныеНМА.Вставить("Код", Строка.КодВПрограмме);
		ДанныеНМА.Вставить("Наименование");
