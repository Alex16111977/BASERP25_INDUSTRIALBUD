Процедура ПКО_Документ_ОстаткиОсновныхСредств_Поиск_С_Подр_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.ТипОперации = Перечисления.ТипыОперацийВводаОстатков.ОстаткиОС;
	ПолученныеДанные.Проведен = Истина;
	МассивСтрокТЧ = Новый Массив;
	МассивСтрокНаработкиОС = Новый Массив;
	Для Каждого Строка Из ДанныеXDTO.ОсновныеСредства Цикл
	
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("МОЛ", "МОЛ");
		ПравилаЗаполнения.Вставить("ИнвентарныйНомер", "ИнвентарныйНомер");
	
		// Стоимость. 
		ПравилаЗаполнения.Вставить("ПервоначальнаяСтоимостьБУ", "ПервоначальнаяСтоимостьБУ");
		ПравилаЗаполнения.Вставить("ПервоначальнаяСтоимостьНУ", "ПервоначальнаяСтоимостьНУ");
		ПравилаЗаполнения.Вставить("ТекущаяСтоимостьБУ", "ТекущаяСтоимостьБУ");
		ПравилаЗаполнения.Вставить("ТекущаяСтоимостьНУ", "ТекущаяСтоимостьНУ");
		ПравилаЗаполнения.Вставить("ТекущаяСтоимостьПР", "ТекущаяСтоимостьПР");
		
		// Принятие к учету.
		// Осталось: КодПоОКОФ, ШифрПоЕНАОФ.
		ПравилаЗаполнения.Вставить("ДатаПринятияКУчету", "ДатаПринятияКУчету");
		ПравилаЗаполнения.Вставить("КодПоОКОФ", "КодПоОКОФ");
		ПравилаЗаполнения.Вставить("ШифрПоЕНАОФ", "ШифрПоЕНАОФ");
		ПравилаЗаполнения.Вставить("НомерДокументаПринятияКУчету", "НомерДокументаПринятияКУчету");
		ПравилаЗаполнения.Вставить("НазваниеДокументаПринятияКУчету", "НазваниеДокументаПринятияКУчету");
		ПравилаЗаполнения.Вставить("СобытиеПринятияКУчету", "СобытиеПринятияКУчету");
		ПравилаЗаполнения.Вставить("СпособПоступления", "СпособПоступления");
		ПравилаЗаполнения.Вставить("АмортизационнаяГруппа", "АмортизационнаяГруппа");
		ПравилаЗаполнения.Вставить("ГруппаОС", "ГруппаОС");
		ПравилаЗаполнения.Вставить("ПорядокПогашенияСтоимостиБУ", "ПорядокУчетаБУ");
		ПравилаЗаполнения.Вставить("ПорядокПогашенияСтоимостиНУ", "ПорядокУчетаНУ");
	
		// Амортизация.
		ПравилаЗаполнения.Вставить("НачислятьАмортизациюБУ", "НачислятьАмортизациюБУ");
		ПравилаЗаполнения.Вставить("СпособНачисленияАмортизацииБУ", "МетодНачисленияАмортизацииБУ");
		ПравилаЗаполнения.Вставить("СрокПолезногоИспользованияБУ", "СрокИспользованияБУ");
		ПравилаЗаполнения.Вставить("КоэффициентАмортизацииБУ", "КоэффициентАмортизацииБУ");
		ПравилаЗаполнения.Вставить("КоэффициентУскоренияБУ", "КоэффициентУскоренияБУ");
		ПравилаЗаполнения.Вставить("ОбъемНаработкиБУ", "ОбъемНаработкиБУ");
		ПравилаЗаполнения.Вставить("ПоказательНаработки", "ПоказательНаработки");
		ПравилаЗаполнения.Вставить("ГрафикАмортизацииБУ", "ГрафикАмортизацииБУ");
		ПравилаЗаполнения.Вставить("НачислятьАмортизациюНУ", "НачислятьАмортизациюНУ");
		ПравилаЗаполнения.Вставить("СпециальныйКоэффициентНУ", "СпециальныйКоэффициентНУ");
		ПравилаЗаполнения.Вставить("СрокПолезногоИспользованияНУ", "СрокИспользованияНУ");
		ПравилаЗаполнения.Вставить("НакопленнаяАмортизацияБУ", "НакопленнаяАмортизацияБУ");
		ПравилаЗаполнения.Вставить("НакопленнаяАмортизацияНУ", "НакопленнаяАмортизацияНУ");
		ПравилаЗаполнения.Вставить("НакопленнаяАмортизацияПР", "НакопленнаяАмортизацияПР");
	
		// Модернизация.
		ПравилаЗаполнения.Вставить("ДатаПоследнейМодернизации", "ДатаМодернизации");
		ПравилаЗаполнения.Вставить("НазваниеДокументаМодернизации", "НазваниеДокументаМодернизации");
		ПравилаЗаполнения.Вставить("НомерДокументаМодернизации", "НомерДокументаМодернизации");
		ПравилаЗаполнения.Вставить("СобытиеМодернизации", "СобытиеМодернизации");
	
		
		// Использование до 2009г.
		ПравилаЗаполнения.Вставить("АмортизацияДо2009", "НакопленнаяАмортизацияНУДо2009");
		ПравилаЗаполнения.Вставить("СрокИспользованияНУДо2009", "СрокИспользованияНУДо2009");
	
		СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
		
		// Заполнение данных ОС.
		ДанныеОС = Новый Структура();
		ДанныеОС.Вставить("Код", Строка.КодВПрограмме);
		ДанныеОС.Вставить("ДатаСведений", ПолученныеДанные.Дата);
		ДанныеОС.Вставить("Наименование");
		ДанныеОС.Вставить("НаименованиеПолное");
		ДанныеОС.Вставить("Изготовитель");
		ДанныеОС.Вставить("ЗаводскойНомер");
		ДанныеОС.Вставить("НомерПаспорта");
		ДанныеОС.Вставить("ДатаВыпуска");
		ДанныеОС.Вставить("Комментарий");
		ЗаполнитьЗначенияСвойств(ДанныеОС, Строка);
		СтруктураДанныхСтроки.Вставить("ОсновноеСредство", ДанныеОС);
		
		// Заполнение счетов учета и амортизации.
		СчетУчета = БухгалтерскийСчетПоКоду(Строка.СчетУчетаБУ, ПланыСчетов.Хозрасчетный.ОСвОрганизации);
		СтруктураДанныхСтроки.Вставить("СчетУчета", СчетУчета);
		СчетАмортизации = БухгалтерскийСчетПоКоду(Строка.СчетАмортизацииБУ, ПланыСчетов.Хозрасчетный.АмортизацияОС_01);
		СтруктураДанныхСтроки.Вставить("СчетАмортизации", СчетАмортизации);
		
		МассивСтрокТЧ.Добавить(СтруктураДанныхСтроки);
		
		// Регистрация накопленной наработки.
		Если Строка.НакопленнаяВыработка <> 0 И ЗначениеЗаполнено(Строка.ПоказательНаработки) Тогда
			СтруктураДанныхНаработки = Новый Структура("ИндексСтрокиОС, НакопленнаяВыработка", 
				МассивСтрокТЧ.Количество()-1, 
				Строка.НакопленнаяВыработка);
			МассивСтрокНаработкиОС.Добавить(СтруктураДанныхНаработки);
		КонецЕсли;
		
	КонецЦикла;
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ОС", МассивСтрокТЧ);
	ПолученныеДанные.ДополнительныеСвойства.Вставить("НаработкиОС", МассивСтрокНаработкиОС);
КонецПроцедуры

Процедура ПКО_Документ_ОстаткиОсновныхСредств_Поиск_С_Подр_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	// Регистрация накопленной наработки.
	МассивСтрокНаработкиОС = ПолученныеДанные.ДополнительныеСвойства.НаработкиОС;
	Если МассивСтрокНаработкиОС.Количество() > 0 Тогда
		СозданНовыйДокумент = Ложь;
		ВыборкаНаработкаОС = Документы.НаработкаОбъектовЭксплуатации.Выбрать(НачалоДня(ПолученныеДанные.Дата), КонецДня(ПолученныеДанные.Дата));
		Пока ВыборкаНаработкаОС.Следующий() Цикл
			Если ВыборкаНаработкаОС.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			ДокументНаработкаОС = ВыборкаНаработкаОС.ПолучитьОбъект();
		КонецЦикла;
		// Создание документа НаработкаОбъектовЭксплуатации при необходимости.
		Если ДокументНаработкаОС = Неопределено Тогда
			ДокументНаработкаОС = Документы.НаработкаОбъектовЭксплуатации.СоздатьДокумент();
			ДокументНаработкаОС.Дата = ПолученныеДанные.Дата;
			СозданНовыйДокумент = Истина;
		КонецЕсли;
		Для Каждого Строка Из МассивСтрокНаработкиОС Цикл
			НакопленнаяВыработка = Строка.НакопленнаяВыработка;
			СтрокаОС = ПолученныеДанные.ОС[Строка.ИндексСтрокиОС];
			ОсновноеСредство = СтрокаОС.ОсновноеСредство;
			ПоказательНаработки = СтрокаОС.ПоказательНаработки;
			
			Если НЕ СозданНовыйДокумент Тогда
				// Возможно в документе уже есть строка с данным ОС с момента предыдущей загрузки.
				СтруктураОтбора = Новый Структура("ОбъектЭксплуатации, ПоказательНаработки", ОсновноеСредство, ПоказательНаработки);
				МассивСтрокНаработка = ДокументНаработкаОС.Наработки.НайтиСтроки(СтруктураОтбора);
				Если МассивСтрокНаработка.Количество() > 0 Тогда
					МассивСтрокНаработка[0].Значение = НакопленнаяВыработка;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			// Добавление строки с накопленной выработкой.
			СтрокаНаработка = ДокументНаработкаОС.Наработки.Добавить();
			СтрокаНаработка.ОбъектЭксплуатации = ОсновноеСредство;
			СтрокаНаработка.ПоказательНаработки = ПоказательНаработки;
			СтрокаНаработка.Значение = НакопленнаяВыработка;
		КонецЦикла;
		ДокументНаработкаОС.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
КонецПроцедуры
