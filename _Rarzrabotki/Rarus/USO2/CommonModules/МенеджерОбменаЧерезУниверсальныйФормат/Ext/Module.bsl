Процедура ПКО_Документ_ВыработкаСотрудников_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	
	Если ДанныеXDTO.Свойство("ВыполненныеРаботы")
		И ЗначениеЗаполнено(ДанныеXDTO.ВыполненныеРаботы) Тогда
		
		ТаблицаВидыРабот = ДанныеXDTO.ВыполненныеРаботы.Скопировать();
		ТаблицаВидыРабот.Колонки.ФизическоеЛицо.Имя = "Работник";
		
		ИспользоватьУправлениеПроизводством21 = ПолучитьФункциональнуюОпцию("ИспользоватьУправлениеПроизводством");
		Если ИспользоватьУправлениеПроизводством21 Тогда
		    ПолученныеДанные.ВидНаряда = Перечисления.ВидыБригадныхНарядов.БригадныйБезЗаказа21;
					
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ВидыРабот", ТаблицаВидыРабот);
		Иначе
			ПолученныеДанные.ВидНаряда = Перечисления.ВидыБригадныхНарядов.Бригадный;
			
			ТаблицаСотрудники = ТаблицаВидыРабот.Скопировать();
			
			ТаблицаВидыРабот.Свернуть("ВидРабот, Расценка, Работник", "Количество, Сумма");
			ТаблицаСотрудники.Свернуть("Работник", "Сумма");
					
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ВидыРабот", ТаблицаВидыРабот);
			ПолученныеДанные.ДополнительныеСвойства.Вставить("Работники", ТаблицаСотрудники);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПКО_Документ_ВыработкаСотрудников_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
