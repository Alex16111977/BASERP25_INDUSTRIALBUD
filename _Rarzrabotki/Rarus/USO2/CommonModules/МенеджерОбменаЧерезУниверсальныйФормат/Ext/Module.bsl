	ДобавитьПКС(СвойстваТЧ, "МагнитныйКод",              "МагнитныйКод", 1);
	ДобавитьПКС(СвойстваТЧ, "Код",                       "СерийныйНомер", 1);
	ДобавитьПКС(СвойстваТЧ, "СуммаВВалютеСертификата",   "Сумма", 1);
	ДобавитьПКС(СвойстваТЧ, "Штрихкод",                  "Штрихкод", 1);

