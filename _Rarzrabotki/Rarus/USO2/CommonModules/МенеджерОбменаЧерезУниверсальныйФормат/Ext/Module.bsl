Процедура ПОД_Справочник_НМА_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.6")
		ИЛИ НЕ ЗначениеЗаполнено(ДанныеИБ.АмортизационнаяГруппа) Тогда
		ИспользованиеПКО.Очистить();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	НМА = Новый Массив;
	НМА.Добавить(ДанныеИБ.Ссылка);
	Запрос.УстановитьПараметр("НМА", НМА);
	
	ДопСведения = Новый Структура("ДатаПринятияКУчету, ДатаПриобретения, СпособПоступления, СчетУчетаБУ,
		|ПервоначальнаяСтоимостьБУ, ПервоначальнаяСтоимостьНУ, ТекущаяСтоимостьБУ, ТекущаяСтоимостьНУ,
		|ТекущаяСтоимостьПР, ТекущаяСтоимостьВР, НачислятьАмортизациюБУ, СпособНачисленияАмортизацииБУ,
		|СрокПолезногоИспользованияБУ, КоэффициентБУ, ОбъемПродукцииРаботДляВычисленияАмортизации, 
		|НачислятьАмортизациюНУ, СпособНачисленияАмортизацииНУ, СпециальныйКоэффициентНУ, 
		|СрокПолезногоИспользованияНУ, НакопленнаяАмортизацияБУ, НакопленнаяАмортизацияНУ,
		|НакопленнаяАмортизацияПР, НакопленнаяАмортизацияВР, СчетАмортизацииБУ");
	
	ИспользоватьУчет2_4 = ПолучитьФункциональнуюОпцию("ИспользоватьВнеоборотныеАктивы2_4")
								И ТекущаяДатаСеанса() >= Константы.ДатаНачалаУчетаВнеоборотныхАктивов2_4.Получить();
								
	Если ИспользоватьУчет2_4 Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПорядокУчетаНМА.НематериальныйАктив КАК НематериальныйАктив,
		|	ПорядокУчетаНМА.Организация КАК Организация,
		|	ПорядокУчетаНМА.ОбъемНаработки КАК ОбъемНаработки,
		|	ЕСТЬNULL(ПорядокУчетаНМА.ГруппаФинансовогоУчета.СчетУчета.Код, """") КАК СчетУчета,
		|	ЕСТЬNULL(ПорядокУчетаНМА.ГруппаФинансовогоУчета.СчетУчетаАмортизации.Код, """") КАК СчетУчетаАмортизации
		|ПОМЕСТИТЬ втПорядокУчетаНМА
		|ИЗ
		|	РегистрСведений.ПорядокУчетаНМА.СрезПоследних(, НематериальныйАктив В (&НМА)) КАК ПорядокУчетаНМА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ХозрасчетныйОстатки.Организация КАК Организация,
		|	ХозрасчетныйОстатки.Субконто1 КАК НематериальныйАктив,
		|	СУММА(ХозрасчетныйОстатки.СуммаОстаток) КАК ТекущаяСтоимостьБУ,
		|	СУММА(ХозрасчетныйОстатки.СуммаНУОстаток) КАК ТекущаяСтоимостьНУ,
		|	СУММА(ХозрасчетныйОстатки.СуммаПРОстаток) КАК ТекущаяСтоимостьПР,
		|	ХозрасчетныйОстатки.СуммаВРОстаток КАК ТекущаяСтоимостьВР,
		|	СУММА(0) КАК НакопленнаяАмортизацияБУ,
		|	СУММА(0) КАК НакопленнаяАмортизацияНУ,
		|	СУММА(0) КАК НакопленнаяАмортизацияПР,
		|	0 КАК НакопленнаяАмортизацияВР
		|ПОМЕСТИТЬ втХозрасчетныйОстатки
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			,
		|			Счет В
		|				(ВЫБРАТЬ
		|					втПорядокУчетаНМА.СчетУчета
		|				ИЗ
		|					втПорядокУчетаНМА),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.НематериальныеАктивы),
		|			) КАК ХозрасчетныйОстатки
		|ГДЕ
		|	ХозрасчетныйОстатки.Субконто1 В(&НМА)
		|
		|СГРУППИРОВАТЬ ПО
		|	ХозрасчетныйОстатки.Организация,
		|	ХозрасчетныйОстатки.Субконто1,
		|	ХозрасчетныйОстатки.СуммаВРОстаток
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ХозрасчетныйОстатки.Организация,
		|	ХозрасчетныйОстатки.Субконто1,
		|	СУММА(0),
		|	СУММА(0),
		|	СУММА(0),
		|	0,
		|	СУММА(ХозрасчетныйОстатки.СуммаОстаток),
		|	СУММА(ХозрасчетныйОстатки.СуммаНУОстаток),
		|	СУММА(ХозрасчетныйОстатки.СуммаПРОстаток),
		|	ХозрасчетныйОстатки.СуммаВРОстаток
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			,
		|			Счет В
		|				(ВЫБРАТЬ
		|					втПорядокУчетаНМА.СчетУчетаАмортизации
		|				ИЗ
		|					втПорядокУчетаНМА),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.НематериальныеАктивы),
		|			) КАК ХозрасчетныйОстатки
		|ГДЕ
		|	ХозрасчетныйОстатки.Субконто1 В(&НМА)
		|
		|СГРУППИРОВАТЬ ПО
		|	ХозрасчетныйОстатки.Субконто1,
		|	ХозрасчетныйОстатки.Организация,
		|	ХозрасчетныйОстатки.СуммаВРОстаток
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПервоначальныеСведенияНМА.НематериальныйАктив КАК НематериальныйАктив,
		|	ПервоначальныеСведенияНМА.Организация КАК Организация,
		|	ПервоначальныеСведенияНМА.ДатаПринятияКУчетуБУ КАК ДатаПринятияКУчету,
		|	ПервоначальныеСведенияНМА.ДатаПриобретения КАК ДатаПриобретения,
		|	ПервоначальныеСведенияНМА.СпособПоступления КАК СпособПоступления,
		|	втПорядокУчетаНМА.СчетУчета КАК СчетУчетаБУ,
		|	ПервоначальныеСведенияНМА.ПервоначальнаяСтоимостьБУ КАК ПервоначальнаяСтоимостьБУ,
		|	ПервоначальныеСведенияНМА.ПервоначальнаяСтоимостьНУ КАК ПервоначальнаяСтоимостьНУ,
		|	втХозрасчетныйОстатки.ТекущаяСтоимостьБУ КАК ТекущаяСтоимостьБУ,
		|	втХозрасчетныйОстатки.ТекущаяСтоимостьНУ КАК ТекущаяСтоимостьНУ,
		|	втХозрасчетныйОстатки.ТекущаяСтоимостьПР КАК ТекущаяСтоимостьПР,
		|	втХозрасчетныйОстатки.ТекущаяСтоимостьВР КАК ТекущаяСтоимостьВР,
		|	ЕСТЬNULL(ПорядокУчетаНМАБУ.НачислятьАмортизациюБУ, ЛОЖЬ) КАК НачислятьАмортизациюБУ,
		|	ПервоначальныеСведенияНМА.МетодНачисленияАмортизацииБУ КАК СпособНачисленияАмортизацииБУ,
		|	ПараметрыАмортизацииНМАБУ.СрокПолезногоИспользованияБУ КАК СрокПолезногоИспользованияБУ,
		|	ПараметрыАмортизацииНМАБУ.КоэффициентБУ КАК КоэффициентБУ,
		|	втПорядокУчетаНМА.ОбъемНаработки КАК ОбъемПродукцииРаботДляВычисленияАмортизации,
		|	ЕСТЬNULL(ПорядокУчетаНМАБУ.НачислятьАмортизациюНУ, ЛОЖЬ) КАК НачислятьАмортизациюНУ,
		|	ПервоначальныеСведенияНМА.МетодНачисленияАмортизацииНУ КАК СпособНачисленияАмортизацииНУ,
		|	НачислениеАмортизацииНМАСпециальныйКоэффициентНалоговыйУчет.СпециальныйКоэффициент КАК СпециальныйКоэффициентНУ,
		|	ПараметрыАмортизацииНМАБУ.СрокПолезногоИспользованияНУ КАК СрокПолезногоИспользованияНУ,
		|	втХозрасчетныйОстатки.НакопленнаяАмортизацияБУ КАК НакопленнаяАмортизацияБУ,
		|	втХозрасчетныйОстатки.НакопленнаяАмортизацияНУ КАК НакопленнаяАмортизацияНУ,
		|	втХозрасчетныйОстатки.НакопленнаяАмортизацияПР КАК НакопленнаяАмортизацияПР,
		|	втХозрасчетныйОстатки.НакопленнаяАмортизацияВР КАК НакопленнаяАмортизацияВР,
		|	втПорядокУчетаНМА.СчетУчетаАмортизации КАК СчетУчетаАмортизацииБУ
		|ИЗ
		|	РегистрСведений.ПервоначальныеСведенияНМА.СрезПоследних(, НематериальныйАктив В (&НМА)) КАК ПервоначальныеСведенияНМА
		|		ЛЕВОЕ СОЕДИНЕНИЕ втПорядокУчетаНМА КАК втПорядокУчетаНМА
		|		ПО ПервоначальныеСведенияНМА.НематериальныйАктив = втПорядокУчетаНМА.НематериальныйАктив
		|			И ПервоначальныеСведенияНМА.Организация = втПорядокУчетаНМА.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ втХозрасчетныйОстатки КАК втХозрасчетныйОстатки
		|		ПО ПервоначальныеСведенияНМА.НематериальныйАктив = втХозрасчетныйОстатки.НематериальныйАктив
		|			И ПервоначальныеСведенияНМА.Организация = втХозрасчетныйОстатки.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокУчетаНМАБУ.СрезПоследних(, НематериальныйАктив В (&НМА)) КАК ПорядокУчетаНМАБУ
		|		ПО ПервоначальныеСведенияНМА.НематериальныйАктив = ПорядокУчетаНМАБУ.НематериальныйАктив
		|			И ПервоначальныеСведенияНМА.Организация = ПорядокУчетаНМАБУ.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыАмортизацииНМАБУ.СрезПоследних(, НематериальныйАктив В (&НМА)) КАК ПараметрыАмортизацииНМАБУ
		|		ПО ПервоначальныеСведенияНМА.НематериальныйАктив = ПараметрыАмортизацииНМАБУ.НематериальныйАктив
		|			И ПервоначальныеСведенияНМА.Организация = ПараметрыАмортизацииНМАБУ.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НачислениеАмортизацииНМАСпециальныйКоэффициентНалоговыйУчет.СрезПоследних(, НематериальныйАктив В (&НМА)) КАК НачислениеАмортизацииНМАСпециальныйКоэффициентНалоговыйУчет
		|		ПО ПервоначальныеСведенияНМА.НематериальныйАктив = НачислениеАмортизацииНМАСпециальныйКоэффициентНалоговыйУчет.НематериальныйАктив
		|			И ПервоначальныеСведенияНМА.Организация = НачислениеАмортизацииНМАСпециальныйКоэффициентНалоговыйУчет.Организация";
	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетаБухгалтерскогоУчетаНМА.НематериальныйАктив КАК НематериальныйАктив,
		|	СчетаБухгалтерскогоУчетаНМА.Организация КАК Организация,
		|	ЕСТЬNULL(СчетаБухгалтерскогоУчетаНМА.СчетУчета.Код, """") КАК СчетУчета,
		|	ЕСТЬNULL(СчетаБухгалтерскогоУчетаНМА.СчетНачисленияАмортизации.Код, """") КАК СчетУчетаАмортизации
		|ПОМЕСТИТЬ втСчетаУчета
		|ИЗ
		|	РегистрСведений.СчетаБухгалтерскогоУчетаНМА.СрезПоследних(, НематериальныйАктив В (&НМА)) КАК СчетаБухгалтерскогоУчетаНМА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ХозрасчетныйОстатки.Организация КАК Организация,
		|	ХозрасчетныйОстатки.Субконто1 КАК НематериальныйАктив,
		|	СУММА(ХозрасчетныйОстатки.СуммаОстаток) КАК ТекущаяСтоимостьБУ,
		|	СУММА(ХозрасчетныйОстатки.СуммаНУОстаток) КАК ТекущаяСтоимостьНУ,
		|	СУММА(ХозрасчетныйОстатки.СуммаПРОстаток) КАК ТекущаяСтоимостьПР,
		|	ХозрасчетныйОстатки.СуммаВРОстаток КАК ТекущаяСтоимостьВР,
		|	СУММА(0) КАК НакопленнаяАмортизацияБУ,
		|	СУММА(0) КАК НакопленнаяАмортизацияНУ,
		|	СУММА(0) КАК НакопленнаяАмортизацияПР,
		|	0 КАК НакопленнаяАмортизацияВР
		|ПОМЕСТИТЬ втХозрасчетныйОстатки
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			,
		|			Счет В
		|				(ВЫБРАТЬ
		|					втСчетаУчета.СчетУчета
		|				ИЗ
		|					втСчетаУчета),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.НематериальныеАктивы),
		|			) КАК ХозрасчетныйОстатки
		|ГДЕ
		|	ХозрасчетныйОстатки.Субконто1 В(&НМА)
		|
		|СГРУППИРОВАТЬ ПО
		|	ХозрасчетныйОстатки.Организация,
		|	ХозрасчетныйОстатки.Субконто1,
		|	ХозрасчетныйОстатки.СуммаВРОстаток
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ХозрасчетныйОстатки.Организация,
		|	ХозрасчетныйОстатки.Субконто1,
		|	СУММА(0),
		|	СУММА(0),
		|	СУММА(0),
		|	0,
		|	СУММА(ХозрасчетныйОстатки.СуммаОстаток),
		|	СУММА(ХозрасчетныйОстатки.СуммаНУОстаток),
		|	СУММА(ХозрасчетныйОстатки.СуммаПРОстаток),
		|	ХозрасчетныйОстатки.СуммаВРОстаток
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			,
		|			Счет В
		|				(ВЫБРАТЬ
		|					втСчетаУчета.СчетУчетаАмортизации
		|				ИЗ
		|					втСчетаУчета),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.НематериальныеАктивы),
		|			) КАК ХозрасчетныйОстатки
		|ГДЕ
		|	ХозрасчетныйОстатки.Субконто1 В(&НМА)
		|
		|СГРУППИРОВАТЬ ПО
		|	ХозрасчетныйОстатки.Субконто1,
		|	ХозрасчетныйОстатки.Организация,
		|	ХозрасчетныйОстатки.СуммаВРОстаток
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПервоначальныеСведенияНМАБухгалтерскийУчет.НематериальныйАктив КАК НематериальныйАктив,
