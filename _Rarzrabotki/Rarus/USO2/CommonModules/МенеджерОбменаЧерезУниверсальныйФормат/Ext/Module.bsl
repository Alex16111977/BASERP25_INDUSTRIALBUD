Процедура ПКО_Документ_ПроизводствоБезЗаказа_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	НомерДок = Лев(ДанныеИБ.Номер, 5) + "БЗ" + Сред(ДанныеИБ.Номер, 8);
	ДанныеXDTO.КлючевыеСвойства.Вставить("Номер", НомерДок);
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ВыгрузитьПодразделение(ДанныеИБ, ДанныеXDTO);
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
	
	ТаблицаПродукция          = ДанныеИБ.ДополнительныеСвойства.ТаблицаПродукция;
	ТаблицаВозвратныеОтходы   = ДанныеИБ.ДополнительныеСвойства.ТаблицаВозвратныеОтходы;
	ТаблицаМатериалы          = ДанныеИБ.ДополнительныеСвойства.ТаблицаМатериалы;
	
	Если ТаблицаПродукция.Количество() > 0 Тогда	
		ДанныеXDTO.Вставить("Продукция", ТаблицаПродукция);
	КонецЕсли;
	
	Если ТаблицаВозвратныеОтходы.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("ВозвратныеОтходы", ТаблицаВозвратныеОтходы);
	КонецЕсли;
	
	Если ТаблицаМатериалы.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("Материалы", ТаблицаМатериалы);
	КонецЕсли;
	
	ДанныеXDTO.Вставить("Склад", ДанныеИБ.ДополнительныеСвойства.СкладДляВыгрузки);
	ДанныеXDTO.Вставить("ВидОперации", ДанныеИБ.ДополнительныеСвойства.НаправлениеВыпуска);
КонецПроцедуры
