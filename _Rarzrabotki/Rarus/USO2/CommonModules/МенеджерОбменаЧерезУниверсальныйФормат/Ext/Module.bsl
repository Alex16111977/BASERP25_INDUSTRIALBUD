	ПравилоКонвертации.ОбъектФормата     = "Справочник.ХарактеристикиНоменклатуры";
	ПравилоКонвертации.ПриОтправкеДанных = "ПКО_Справочник_ХарактеристикиНоменклатуры_ИзСтруктуры_ПриОтправкеДанных";
	
