	|	ЕСТЬNULL(ВводОстатковВнеоборотныхАктивовОС.СчетАмортизации.Код, """") КАК СчетАмортизацииБУ,
	|	ЕСТЬNULL(ВводОстатковВнеоборотныхАктивовОС.ОсновноеСредство.НаименованиеПолное, """") КАК НаименованиеПолное,
	|	ЕСТЬNULL(ВводОстатковВнеоборотныхАктивовОС.ОсновноеСредство.Комментарий, """") КАК Комментарий,
	|	ЕСТЬNULL(ВводОстатковВнеоборотныхАктивовОС.ОсновноеСредство.Изготовитель, """") КАК Изготовитель,
	|	ЕСТЬNULL(ВводОстатковВнеоборотныхАктивовОС.ОсновноеСредство.ЗаводскойНомер, """") КАК ЗаводскойНомер,
	|	ЕСТЬNULL(ВводОстатковВнеоборотныхАктивовОС.ОсновноеСредство.НомерПаспорта, """") КАК НомерПаспорта,
	|	ЕСТЬNULL(ВводОстатковВнеоборотныхАктивовОС.ОсновноеСредство.ДатаВыпуска, """") КАК ДатаВыпуска,
	|	ВводОстатковВнеоборотныхАктивовОС.НакопленнаяАмортизацияНУДо2009 КАК АмортизацияДо2009,
	|	ВводОстатковВнеоборотныхАктивовОС.СрокИспользованияНУДо2009 КАК СрокИспользованияНУДо2009
	|
	|ИЗ
	|	Документ.ВводОстатковВнеоборотныхАктивов.ОС КАК ВводОстатковВнеоборотныхАктивовОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаработкиОбъектовЭксплуатации.СрезПоследних(&Период, ) КАК НаработкиОбъектовЭксплуатации
	|		ПО НаработкиОбъектовЭксплуатации.ОбъектЭксплуатации = ВводОстатковВнеоборотныхАктивовОС.ОсновноеСредство
	|			И НаработкиОбъектовЭксплуатации.ПоказательНаработки = ВводОстатковВнеоборотныхАктивовОС.ПоказательНаработки
	|ГДЕ
	|	ВводОстатковВнеоборотныхАктивовОС.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Запрос.УстановитьПараметр("Период", ДанныеИБ.Дата);
	
	ТаблицаОстаткиОС = Запрос.Выполнить().Выгрузить();
	ТаблицаОстаткиОС.Колонки.Добавить("СобытиеПринятияКУчету");
	ТаблицаОстаткиОС.Колонки.Добавить("СобытиеМодернизации");
	ТаблицаОстаткиОС.Колонки.Добавить("ГрафикАмортизацииБУ");
	ТаблицаОстаткиОС.Колонки.Добавить("ПоказательНаработки");
	
	Для Каждого СтрокаОстаткиОС Из ТаблицаОстаткиОС Цикл
		
		СтрокаОстаткиОС.СобытиеПринятияКУчету = Новый Структура;
		СтрокаОстаткиОС.СобытиеПринятияКУчету.Вставить("Наименование", СтрокаОстаткиОС.СобытиеПринятияКУчетуНаименование);
		СтрокаОстаткиОС.СобытиеПринятияКУчету.Вставить("ВидСобытияОС", СтрокаОстаткиОС.СобытиеПринятияКУчетуВидСобытияОС);
		
		СтрокаОстаткиОС.СобытиеМодернизации = Новый Структура;
		СтрокаОстаткиОС.СобытиеМодернизации.Вставить("Наименование", СтрокаОстаткиОС.СобытиеМодернизацииНаименование);
		СтрокаОстаткиОС.СобытиеМодернизации.Вставить("ВидСобытияОС", СтрокаОстаткиОС.СобытиеМодернизацииВидСобытияОС);
		
		СтрокаОстаткиОС.ГрафикАмортизацииБУ = Новый Структура;
		СтрокаОстаткиОС.ГрафикАмортизацииБУ.Вставить("Наименование",  СтрокаОстаткиОС.ГрафикАмортизацииБУНаименование);
		СтрокаОстаткиОС.ГрафикАмортизацииБУ.Вставить("Коэффициент1",  СтрокаОстаткиОС.ГрафикАмортизацииБУКоэффициент1);
		СтрокаОстаткиОС.ГрафикАмортизацииБУ.Вставить("Коэффициент2",  СтрокаОстаткиОС.ГрафикАмортизацииБУКоэффициент2);
		СтрокаОстаткиОС.ГрафикАмортизацииБУ.Вставить("Коэффициент3",  СтрокаОстаткиОС.ГрафикАмортизацииБУКоэффициент3);
		СтрокаОстаткиОС.ГрафикАмортизацииБУ.Вставить("Коэффициент4",  СтрокаОстаткиОС.ГрафикАмортизацииБУКоэффициент4);
		СтрокаОстаткиОС.ГрафикАмортизацииБУ.Вставить("Коэффициент5",  СтрокаОстаткиОС.ГрафикАмортизацииБУКоэффициент5);
		СтрокаОстаткиОС.ГрафикАмортизацииБУ.Вставить("Коэффициент6",  СтрокаОстаткиОС.ГрафикАмортизацииБУКоэффициент6);
		СтрокаОстаткиОС.ГрафикАмортизацииБУ.Вставить("Коэффициент7",  СтрокаОстаткиОС.ГрафикАмортизацииБУКоэффициент7);
		СтрокаОстаткиОС.ГрафикАмортизацииБУ.Вставить("Коэффициент8",  СтрокаОстаткиОС.ГрафикАмортизацииБУКоэффициент8);
		СтрокаОстаткиОС.ГрафикАмортизацииБУ.Вставить("Коэффициент9",  СтрокаОстаткиОС.ГрафикАмортизацииБУКоэффициент9);
		СтрокаОстаткиОС.ГрафикАмортизацииБУ.Вставить("Коэффициент10", СтрокаОстаткиОС.ГрафикАмортизацииБУКоэффициент10);
		СтрокаОстаткиОС.ГрафикАмортизацииБУ.Вставить("Коэффициент11", СтрокаОстаткиОС.ГрафикАмортизацииБУКоэффициент11);
		СтрокаОстаткиОС.ГрафикАмортизацииБУ.Вставить("Коэффициент12", СтрокаОстаткиОС.ГрафикАмортизацииБУКоэффициент12);
		
		СтрокаОстаткиОС.ПоказательНаработки = Новый Структура;
		СтрокаОстаткиОС.ПоказательНаработки.Вставить("Наименование", СтрокаОстаткиОС.ПоказательНаработкиНаименование);
		Если ЗначениеЗаполнено(СтрокаОстаткиОС.ПоказательНаработкиЕдиницаИзмерения) Тогда
			СтрокаОстаткиОС.ПоказательНаработки.Вставить("ЕдиницаИзмерения",
				Новый Структура("ИмяПКО, Значение", "Справочник_Упаковки", СтрокаОстаткиОС.ПоказательНаработкиЕдиницаИзмерения));
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеXDTO.Вставить("ОсновныеСредства", ТаблицаОстаткиОС);
КонецПроцедуры
