	ДобавитьПКС(СвойстваШапки, "Проведен",    "", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "ПодарочныеСертификаты", "");
	ДобавитьПКС(СвойстваТЧ, "ПодарочныйСертификат",    "", 1);
	ДобавитьПКС(СвойстваТЧ, "СуммаВВалютеСертификата", "", 1);

