	ДобавитьПКС(СвойстваТЧ, "", "НомерСтрокиДокумента", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Сумма", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Характеристика", 1, "Справочник_ХарактеристикиНоменклатуры");
	ДобавитьПКС(СвойстваТЧ, "", "Цена", 1);

КонецПроцедуры

Процедура ПКО_Документ_ВыпускПродукции_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	СкладДляВыгрузки = СкладДляВыгрузки(ДанныеИБ.Склад, КомпонентыОбмена.ПараметрыКонвертации);
	ДанныеXDTO.Вставить("Склад", СкладДляВыгрузки);
	
	ВыгрузитьПодразделение(ДанныеИБ, ДанныеXDTO);
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
	
	ИспользоватьПлановуюСтоимость = Ложь;
	ПараметрыПолитики = РегистрыСведений.УчетнаяПолитикаОрганизаций.ПараметрыУчетнойПолитики(ДанныеИБ.Организация, ДанныеИБ.Дата);
	
	Если ПараметрыПолитики <> Неопределено Тогда
		ИспользоватьПлановуюСтоимость = ПараметрыПолитики.УчетГотовойПродукцииПоПлановойСтоимости;
	КонецЕсли;
	
	Если ДанныеИБ.НаправлениеВыпуска = Перечисления.ХозяйственныеОперации.ВыпускПродукцииВПодразделение Тогда
		ДанныеXDTO.Вставить("ПодразделениеЗатрат", ДанныеИБ.Товары[0].Подразделение);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	
	Если ИспользоватьПлановуюСтоимость Тогда
		
		// Цены должны быть указаны в документе.
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	Товары.НомерСтроки КАК НомерСтрокиДокумента,
			|	Товары.Номенклатура КАК Номенклатура,
			|	&ТекстЗапросаХарактеристика,
			|	&ТекстЗапросаУпаковка,
			|	&ТекстЗапросаСерия,
			|	Товары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	Товары.Количество КАК Количество,
			|	Товары.Цена КАК Цена,
			|	Товары.Сумма / Товары.КоличествоУпаковок КАК ЦенаЗаУпаковку,
			|	Товары.Сумма КАК Сумма
			|ИЗ
			|	Документ.ВыпускПродукции.Товары КАК Товары
			|ГДЕ
			|	Товары.Ссылка = &Ссылка
			|	И НЕ Товары.Номенклатура.ТипНоменклатуры В (ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга), ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа))
			|
			|УПОРЯДОЧИТЬ ПО
			|	Товары.НомерСтроки";
		
	Иначе
		
		Запрос.УстановитьПараметр("Дата", ДанныеИБ.Дата); 
		Запрос.УстановитьПараметр("ВидЦеныПлановойСебестоимости",
			?(ЗначениеЗаполнено(ДанныеИБ.ВидЦены), ДанныеИБ.ВидЦены, ПроизводствоСерверПовтИсп.ВидЦеныПлановойСтоимости()));
		
		// Цены извлекаются по типу цен, указанному в документе.
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	ВыпускПродукцииТовары.НомерСтроки КАК НомерСтроки,
			|	ВыпускПродукцииТовары.Номенклатура КАК Номенклатура,
			|	ВыпускПродукцииТовары.Характеристика КАК Характеристика,
			|	ВыпускПродукцииТовары.Серия КАК Серия,
			|	ВыпускПродукцииТовары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ВыпускПродукцииТовары.Количество КАК Количество,
			|	ВыпускПродукцииТовары.Ссылка.Валюта КАК ВалютаДокумента,
			|	ЕСТЬNULL(ВыпускПродукцииТовары.Ссылка.ВидЦены.ВалютаЦены, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК ВалютаЦены,
			|	ВЫБОР
			|		КОГДА ВыпускПродукцииТовары.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.КомиссионныйТовар)
			|			ТОГДА ВЫРАЗИТЬ(""КомиссионныеТовары"" КАК СТРОКА(18))
			|		ИНАЧЕ ВЫРАЗИТЬ(""СобственныеТовары"" КАК СТРОКА(18))
			|	КОНЕЦ КАК ТипЗапасов,
			|	ВыпускПродукцииТовары.Упаковка КАК Упаковка,
			|	ВыпускПродукцииТовары.КоличествоУпаковок КАК КоличествоУпаковок
			|ПОМЕСТИТЬ втПродукция
			|ИЗ
			|	Документ.ВыпускПродукции.Товары КАК ВыпускПродукцииТовары
			|ГДЕ
			|	ВыпускПродукцииТовары.Ссылка = &Ссылка
			|	И НЕ ВыпускПродукцииТовары.Номенклатура.ТипНоменклатуры В (ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга), ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа))
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Номенклатура,
			|	Характеристика
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВложенныйЗапрос.НомерСтроки КАК НомерСтрокиДокумента,
			|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
			|	ВложенныйЗапрос.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ВложенныйЗапрос.Характеристика КАК Характеристика,
			|	ВложенныйЗапрос.Серия КАК Серия,
			|	ВложенныйЗапрос.Количество КАК Количество,
			|	ВложенныйЗапрос.ТипЗапасов КАК ТипЗапасов,
			|	ВЫРАЗИТЬ(ВложенныйЗапрос.Цена / ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки, 1) КАК ЧИСЛО(15, 2)) КАК Цена,
			|	(ВЫРАЗИТЬ(ВложенныйЗапрос.Цена / ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки, 1) КАК ЧИСЛО(15, 2))) * ВложенныйЗапрос.Количество КАК Сумма,
			|	ВложенныйЗапрос.Упаковка КАК Упаковка,
			|	ВложенныйЗапрос.КоличествоУпаковок КАК КоличествоУпаковок
			|ПОМЕСТИТЬ втПродукцияСоСтоимостью
			|ИЗ
			|	(ВЫБРАТЬ
			|		втТовары.НомерСтроки КАК НомерСтроки,
			|		втТовары.Номенклатура КАК Номенклатура,
			|		втТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|		втТовары.Характеристика КАК Характеристика,
			|		втТовары.Серия КАК Серия,
			|		втТовары.Количество КАК Количество,
			|		втТовары.ТипЗапасов КАК ТипЗапасов,
			|		ЦеныНоменклатурыСрезПоследних.Упаковка КАК УпаковкаЦены,
			|		ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) * ВЫБОР
			|			КОГДА втТовары.ВалютаДокумента = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			|					ИЛИ втТовары.ВалютаЦены = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			|				ТОГДА 0
			|			КОГДА втТовары.ВалютаДокумента = втТовары.ВалютаЦены
			|				ТОГДА 1
			|			ИНАЧЕ КурсыВалютыЦены.Курс * КурсыВалютыДокумента.Кратность / (КурсыВалютыДокумента.Курс * КурсыВалютыЦены.Кратность)
			|		КОНЕЦ КАК Цена,
			|		втТовары.Упаковка КАК Упаковка,
			|		втТовары.КоличествоУпаковок КАК КоличествоУпаковок
			|	ИЗ
			|		втПродукция КАК втТовары
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, ВидЦены = &ВидЦеныПлановойСебестоимости) КАК ЦеныНоменклатурыСрезПоследних
			|			ПО втТовары.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
			|				И втТовары.Характеристика = ЦеныНоменклатурыСрезПоследних.Характеристика
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&Дата, ) КАК КурсыВалютыДокумента
			|			ПО втТовары.ВалютаДокумента = КурсыВалютыДокумента.Валюта
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&Дата, ) КАК КурсыВалютыЦены
			|			ПО втТовары.ВалютаЦены = КурсыВалютыЦены.Валюта) КАК ВложенныйЗапрос
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Товары.НомерСтрокиДокумента КАК НомерСтрокиДокумента,
			|	Товары.Номенклатура КАК Номенклатура,
			|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	&ТекстЗапросаХарактеристика,
			|	&ТекстЗапросаСерия,
			|	&ТекстЗапросаУпаковка,
			|	Товары.Количество КАК Количество,
			|	Товары.Цена КАК Цена,
			|	Товары.Сумма КАК Сумма,
			|	Товары.Сумма / Товары.КоличествоУпаковок КАК ЦенаЗаУпаковку
			|ИЗ
			|	втПродукцияСоСтоимостью КАК Товары";
			
	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
					"&ТекстЗапросаКоэффициентУпаковки",
					Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
					"ВложенныйЗапрос.УпаковкаЦены",
					"ВложенныйЗапрос.Номенклатура"));
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаХарактеристика",
		ПолучитьТекстЗапросаХарактеристики(КомпонентыОбмена, "Товары"));
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаУпаковка",
		ПолучитьТекстЗапросаУпаковки(КомпонентыОбмена, "Товары"));
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаСерия",
		ПолучитьТекстЗапросаСерии(КомпонентыОбмена, "Товары"));
	
	Запрос.Текст =ТекстЗапроса;
	
	Товары = Запрос.Выполнить().Выгрузить();
	ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, Товары);
	
	ДанныеXDTO.Вставить("Продукция", Товары);
КонецПроцедуры
#КонецОбласти
#Область Документ_ВыработкаСотрудников_Отправка
Процедура ДобавитьПКО_Документ_ВыработкаСотрудников_Отправка(ПравилаКонвертации)

	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО            = "Документ_ВыработкаСотрудников_Отправка";
	ПравилоКонвертации.ОбъектДанных      = Метаданные.Документы.ВыработкаСотрудников;
	ПравилоКонвертации.ОбъектФормата     = "Документ.ВыработкаСотрудников";
	ПравилоКонвертации.ПриОтправкеДанных = "ПКО_Документ_ВыработкаСотрудников_Отправка_ПриОтправкеДанных";
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Дата",          "Дата");
	ДобавитьПКС(СвойстваШапки, "Комментарий",   "Комментарий");
	ДобавитьПКС(СвойстваШапки, "Номер",         "Номер");
	ДобавитьПКС(СвойстваШапки, "Организация",   "Организация", , "Справочник_Организации_Отправка");
	ДобавитьПКС(СвойстваШапки, "Ответственный", "Ответственный", , "Справочник_Пользователи");
	ДобавитьПКС(СвойстваШапки, "Подразделение", "Подразделение", , "Справочник_Подразделения_Отправка");
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "", "ВыполненныеРаботы");
	ДобавитьПКС(СвойстваТЧ, "", "ВидРабот", 1, "Справочник_ВидыРаботСотрудников");
	ДобавитьПКС(СвойстваТЧ, "", "Количество", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Расценка", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Сумма", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ФизическоеЛицо", 1, "Справочник_ФизическиеЛица_Отправка");

КонецПроцедуры

Процедура ПКО_Документ_ВыработкаСотрудников_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	#Область ВыполненныеРаботы
	Устаревшие = Новый Массив;
	Устаревшие.Добавить(Перечисления.ВидыБригадныхНарядов.Ремонт);
	Устаревшие.Добавить(Перечисления.ВидыБригадныхНарядов.ПрочиеРаботы);
	Устаревшие.Добавить(Перечисления.ВидыБригадныхНарядов.БригадныйБезЗаказа21);
	
	Если ДанныеИБ.ВидНаряда = Перечисления.ВидыБригадныхНарядов.Персональный
		Или Не ДанныеИБ.Автораспределение И Устаревшие.Найти(ДанныеИБ.ВидНаряда) <> Неопределено Тогда
		//Берем готовую таблицу "ВидыРабот", распределенную вручную
		ЗапросВидовРабот = Новый Запрос;
		ЗапросВидовРабот.Текст = 
		"ВЫБРАТЬ
		|	ВидыРабот.Работник КАК ФизическоеЛицо,
		|	ВидыРабот.ВидРабот КАК ВидРабот,
		|	СУММА(ВидыРабот.Количество) КАК Количество,
		|	СУММА(ВидыРабот.Сумма) КАК Сумма,
		|	ВидыРабот.Расценка КАК Расценка
		|ИЗ
		|	Документ.ВыработкаСотрудников.ВидыРабот КАК ВидыРабот
		|ГДЕ
		|	ВидыРабот.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ВидыРабот.ВидРабот,
		|	ВидыРабот.Расценка,
		|	ВидыРабот.Работник";
		
		ЗапросВидовРабот.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
		
		ТаблицаВидовРаботСотрудников = ЗапросВидовРабот.Выполнить().Выгрузить();
		
	Иначе
		//Распределим
		ТаблицаВидовРаботСотрудников = Новый ТаблицаЗначений;
		ТаблицаВидовРаботСотрудников.Колонки.Добавить("ФизическоеЛицо",	Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
		ТаблицаВидовРаботСотрудников.Колонки.Добавить("ВидРабот",		Новый ОписаниеТипов("СправочникСсылка.ВидыРаботСотрудников"));
		ТаблицаВидовРаботСотрудников.Колонки.Добавить("Количество",		Новый ОписаниеТипов("Число"));
		ТаблицаВидовРаботСотрудников.Колонки.Добавить("Расценка",		Новый ОписаниеТипов("Число"));
		ТаблицаВидовРаботСотрудников.Колонки.Добавить("Сумма",			Новый ОписаниеТипов("Число"));
		
		ЗапросВидовРабот = Новый Запрос;
		ЗапросВидовРабот.Текст = 
		"ВЫБРАТЬ
		|	ВидыРабот.ВидРабот КАК ВидРабот,
		|	СУММА(ВидыРабот.Количество) КАК Количество,
		|	СУММА(ВидыРабот.Сумма) КАК Сумма,
		|	ВидыРабот.Расценка КАК Расценка
		|ИЗ
		|	Документ.ВыработкаСотрудников.ВидыРабот КАК ВидыРабот
		|ГДЕ
		|	ВидыРабот.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ВидыРабот.ВидРабот,
		|	ВидыРабот.Расценка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Работники.Работник КАК Работник,
		|	Работники.Сумма КАК Сумма
		|ИЗ
		|	Документ.ВыработкаСотрудников.Работники КАК Работники
		|ГДЕ
		|	Работники.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Работники.Сумма";
		
		ЗапросВидовРабот.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
		
		Результаты = ЗапросВидовРабот.ВыполнитьПакет();
	
		ВидыРабот = Результаты[0].Выбрать();
		Работники = Результаты[1].Выгрузить();
		
		Коэффициенты = Работники.ВыгрузитьКолонку("Сумма");
		
		Пока ВидыРабот.Следующий() Цикл
			
			Количества = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(ВидыРабот.Количество, Коэффициенты);
			Суммы = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(ВидыРабот.Сумма, Коэффициенты);
			
			Индекс = 0;
			Для Каждого Строка Из Работники Цикл
				
				НоваяСтрока = ТаблицаВидовРаботСотрудников.Добавить();
				
				//ЗаполнитьЗначенияСвойств(НоваяСтрока, ВидыРабот);
				НоваяСтрока.ВидРабот = ВидыРабот.ВидРабот;
				НоваяСтрока.ФизическоеЛицо = Строка.Работник;
				НоваяСтрока.Количество = Количества[Индекс];
				НоваяСтрока.Расценка = ВидыРабот.Расценка;
				НоваяСтрока.Сумма = Суммы[Индекс];
				
				Индекс = Индекс + 1;
				
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("ВыполненныеРаботы", ТаблицаВидовРаботСотрудников);
	
	#КонецОбласти
КонецПроцедуры
