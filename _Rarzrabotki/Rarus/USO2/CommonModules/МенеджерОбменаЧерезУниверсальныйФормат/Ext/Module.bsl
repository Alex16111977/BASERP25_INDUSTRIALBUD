Процедура ПКО_Документ_ДвижениеПродИМат_ВозврМатИзПр_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
		                            ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
	
	ЗаполнитьСкладПоУмолчанию(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена, "Получатель");
	
	Если НЕ ДанныеИБ = Неопределено Тогда
		// Отправителя переносим из ДанныхИБ.
		ПолученныеДанные.Отправитель = ДанныеИБ.Отправитель;
		
