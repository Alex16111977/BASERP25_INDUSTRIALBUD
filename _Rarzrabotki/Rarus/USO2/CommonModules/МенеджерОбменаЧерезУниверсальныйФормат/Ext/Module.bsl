Процедура ПКО_Документ_ПроизводствоБезЗаказа_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO);
	
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Номенклатура", "Номенклатура");
	ПравилаЗаполнения.Вставить("Количество",   "Количество");
	ПравилаЗаполнения.Вставить("Сумма",        "ДоляСтоимости");
	Если ЗначениеФО("ИспользоватьХарактеристикиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Характеристика",     "Характеристика");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьУпаковкиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Упаковка",           "Упаковка");
		ПравилаЗаполнения.Вставить("КоличествоУпаковок", "КоличествоУпаковок");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьСерииНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Серия",              "Серия");
	КонецЕсли;
	
	// При выпуске в подразделение получателем будет кладовая цеха.
	Получатель = Неопределено;
	Если ДанныеXDTO.ВидОперации.Значение = "ВыпускПродукцииВПодразделение" Тогда
	
		Если ДанныеXDTO.Свойство("ПодразделениеЗатрат") И ЗначениеЗаполнено(ДанныеXDTO.ПодразделениеЗатрат) Тогда
			ПодразделениеЗатрат = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
				КомпонентыОбмена,
				ДанныеXDTO.ПодразделениеЗатрат,
				ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Подразделения_Получение"), 
				"ПолучитьСсылку").Ссылка;
		Иначе
			ПодразделениеЗатрат = ЭлементПоУмолчанию(КомпонентыОбмена, "Подразделение");
		КонецЕсли;
		
		// Проверим реквизиты подразделения.
		ЗначенияРеквизитов = Новый Структура("ПроизводственноеПодразделение, ПроизводствоБезЗаказов", Истина, Истина);
		ПроверитьОбновитьРеквизитыОбъекта(ПодразделениеЗатрат, ЗначенияРеквизитов, КомпонентыОбмена);
		
		// Получим кладовую по умолчанию.
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Подразделение", ПодразделениеЗатрат);
		Получатель = ЭлементПоУмолчанию(КомпонентыОбмена, "КладоваяЦеха", ДопПараметры);
		
	ИначеЕсли ДанныеXDTO.Свойство("Склад") И ЗначениеЗаполнено(ДанныеXDTO.Склад) Тогда
		Получатель = ДанныеXDTO.Склад;		
	КонецЕсли;
	
	
	#Область ВыходныеИзделия
	
	Если ДанныеXDTO.Свойство("Продукция") И ЗначениеЗаполнено(ДанныеXDTO.Продукция) Тогда
		
		МассивСтрокВыходныеИзделия = Новый Массив;
		Для Каждого Строка Из ДанныеXDTO.Продукция Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			Если ЗначениеЗаполнено(Получатель) Тогда
				СтруктураДанныхСтроки.Вставить("Получатель", Получатель);
			КонецЕсли;
			
			СтруктураДанныхСтроки.Вставить("НаправлениеВыпуска", Перечисления.ХозяйственныеОперации.ВыпускПродукцииНаСклад);
			
			Если НЕ СтруктураДанныхСтроки.Свойство("КоличествоУпаковок") Тогда
			 	СтруктураДанныхСтроки.Вставить("КоличествоУпаковок", СтруктураДанныхСтроки.Количество);
			КонецЕсли; 
	
			МассивСтрокВыходныеИзделия.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
		
		Если МассивСтрокВыходныеИзделия.Количество() > 0 Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ВыходныеИзделия", МассивСтрокВыходныеИзделия);
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти
	
	
	#Область ВозвратныеОтходы
	
	Если ДанныеXDTO.Свойство("ВозвратныеОтходы") И ЗначениеЗаполнено(ДанныеXDTO.ВозвратныеОтходы) Тогда
		
		МассивСтрокВозвратныеОтходы = Новый Массив;
			
		Для Каждого Строка Из ДанныеXDTO.ВозвратныеОтходы Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			Если ЗначениеЗаполнено(Получатель) Тогда
				СтруктураДанныхСтроки.Вставить("Получатель", Получатель);
			КонецЕсли;
			
			СтруктураДанныхСтроки.Вставить("НаправлениеВыпуска", Перечисления.ХозяйственныеОперации.ВыпускПродукцииНаСклад);
			
			Если НЕ СтруктураДанныхСтроки.Свойство("КоличествоУпаковок") Тогда
			 	СтруктураДанныхСтроки.Вставить("КоличествоУпаковок", СтруктураДанныхСтроки.Количество);
			КонецЕсли;
	
			МассивСтрокВозвратныеОтходы.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
		
		Если МассивСтрокВозвратныеОтходы.Количество() > 0 Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ПобочныеИзделия", МассивСтрокВозвратныеОтходы);
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти
	
	
	#Область Материалы
	
	Если ДанныеXDTO.Свойство("Материалы") И ЗначениеЗаполнено(ДанныеXDTO.Материалы) Тогда
		
		ПравилаЗаполнения.Вставить("Подразделение", "ПодразделениеЗатрат");
	
		МассивСтрокМатериалы = Новый Массив;
			
		Для Каждого Строка Из ДанныеXDTO.Материалы Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			Если ДанныеXDTO.Свойство("Склад") Тогда
				СтруктураДанныхСтроки.Вставить("Склад", ДанныеXDTO.Склад);
			КонецЕсли;
			
			Если НЕ СтруктураДанныхСтроки.Свойство("КоличествоУпаковок") Тогда
			 	СтруктураДанныхСтроки.Вставить("КоличествоУпаковок", СтруктураДанныхСтроки.Количество);
			КонецЕсли;
	
			МассивСтрокМатериалы.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
		
		Если МассивСтрокМатериалы.Количество() > 0 Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("МатериалыИРаботы", МассивСтрокМатериалы);
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти
	
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
КонецПроцедуры

Процедура ПКО_Документ_ПроизводствоБезЗаказа_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
		                            ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
		                            
	ЗаполнитьПодразделениеПоУмолчанию(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена);
	
	Если НЕ ДанныеИБ = Неопределено Тогда
		// Переносим те свойства, которые указаны в ПКС
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
		МассивКлючевыхПолей = Новый Массив;
		МассивКлючевыхПолей.Добавить("Номенклатура");
		МассивКлючевыхПолей.Добавить("Характеристика");
		МассивКлючевыхПолей.Добавить("Серия");
		МассивКлючевыхПолей.Добавить("Получатель");
		МассивКлючевыхПолей.Добавить("НаправлениеВыпуска");
		
		ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
			ПолученныеДанные.ВыходныеИзделия,
			ДанныеИБ.ВыходныеИзделия,
			МассивКлючевыхПолей,
			Неопределено,
			"Количество, Упаковка, КоличествоУпаковок");  
		ДанныеИБ.ВыходныеИзделия.Загрузить(ПолученныеДанные.ВыходныеИзделия.Выгрузить());
		
		ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
			ПолученныеДанные.ПобочныеИзделия,
			ДанныеИБ.ПобочныеИзделия,
			МассивКлючевыхПолей,
			Неопределено,
			"Количество, Упаковка, КоличествоУпаковок");  
		ДанныеИБ.ПобочныеИзделия.Загрузить(ПолученныеДанные.ПобочныеИзделия.Выгрузить());
		
		МассивКлючевыхПолей = Новый Массив;
		МассивКлючевыхПолей.Добавить("Номенклатура");
		МассивКлючевыхПолей.Добавить("Характеристика");
		МассивКлючевыхПолей.Добавить("Серия");
		МассивКлючевыхПолей.Добавить("Склад");
		
		ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
			ПолученныеДанные.МатериалыиРаботы,
			ДанныеИБ.МатериалыиРаботы,
			МассивКлючевыхПолей,
			Неопределено,
			"Количество, Упаковка, КоличествоУпаковок");  
		ДанныеИБ.МатериалыиРаботы.Загрузить(ПолученныеДанные.МатериалыиРаботы.Выгрузить());
		
		// Перенесем работы из ДанныхИБ, т.к. объект формата не поддерживает их передачу.
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	*
			|ИЗ
			|	Документ.ПроизводствоБезЗаказа.МатериалыИРаботы КАК ПроизводствоБезЗаказаМатериалыИРаботы
			|ГДЕ
			|	ПроизводствоБезЗаказаМатериалыИРаботы.Ссылка = &Ссылка
			|	И ПроизводствоБезЗаказаМатериалыИРаботы.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)";
	
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаТЧ = ДанныеИБ.МатериалыиРаботы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, Выборка);
		КонецЦикла;	
		
		ПолученныеДанные = Неопределено;
	КонецЕсли;
	
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	Если НЕ ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.ГруппировкаЗатрат) Тогда
		Если ДанныеДляЗаписиВИБ.МатериалыИРаботы.Количество() = 0
			И ДанныеДляЗаписиВИБ.ПобочныеИзделия.Количество() = 0
			И ДанныеДляЗаписиВИБ.Трудозатраты.Количество() = 0 Тогда
			ДанныеДляЗаписиВИБ.ГруппировкаЗатрат = Перечисления.ГруппировкиЗатратВПроизводствеБезЗаказа.ЗатратыНеУказываются;
		Иначе
			ДанныеДляЗаписиВИБ.ГруппировкаЗатрат = Перечисления.ГруппировкиЗатратВПроизводствеБезЗаказа.ПоДокументу;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.СпособРаспределенияЗатратНаВыходныеИзделия) Тогда
		// В файле обмена переданы суммовые оценки продукции, будем их использовать в качество доли.
		Если ДанныеДляЗаписиВИБ.ВыходныеИзделия.Итог("ДоляСтоимости") > 0 Тогда
		    ДанныеДляЗаписиВИБ.СпособРаспределенияЗатратНаВыходныеИзделия = Перечисления.СпособыРаспределенияЗатратНаВыходныеИзделия.ПоДолямСтоимости;
		Иначе
			ДанныеДляЗаписиВИБ.СпособРаспределенияЗатратНаВыходныеИзделия = Перечисления.СпособыРаспределенияЗатратНаВыходныеИзделия.ПоПлановойСтоимости;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
