Процедура ПКО_Справочник_ШтрихкодыНоменклатуры_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.Вставить("ШтрихкодОтбор",         ДанныеИБ.Отбор.Штрихкод.Значение);
	
	ТаблицаЗаписи = ДанныеИБ.Выгрузить();
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.6") Тогда
		ТаблицаЗаписи.ЗаполнитьЗначения(Неопределено, "Характеристика, Упаковка");
		ТаблицаЗаписи.Колонки.Добавить("ХарактеристикаСсылка");
		ТаблицаЗаписи.Колонки.Добавить("УпаковкаСсылка");
	Иначе
		ТаблицаЗаписи.Колонки.Характеристика.Имя = "ХарактеристикаСсылка";
		ТаблицаЗаписи.Колонки.Добавить("Характеристика");
		ТаблицаЗаписи.Колонки.Упаковка.Имя = "УпаковкаСсылка";
		ТаблицаЗаписи.Колонки.Добавить("Упаковка");
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗаписи Цикл
				
		// Заполним характеристику.
		Если ЗначениеЗаполнено(СтрокаТаблицы.ХарактеристикаСсылка) И ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			Характеристика = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
					СтрокаТаблицы.ХарактеристикаСсылка, "Владелец, Наименование, НаименованиеПолное");
			
			Если Характеристика.Владелец = СтрокаТаблицы.Номенклатура Тогда
				СтрокаТаблицы.Характеристика = СтрокаТаблицы.ХарактеристикаСсылка;
			Иначе
				Характеристика.Вставить("Владелец", СтрокаТаблицы.Номенклатура);
				СтрокаТаблицы.Характеристика = Новый Структура("Значение, ИмяПКО",
					Характеристика, "Справочник_ХарактеристикиНоменклатуры_ИзСтруктуры");
					
				ПравилоОбработки = КомпонентыОбмена.ПравилаОбработкиДанных.Найти("Справочник_ХарактеристикиНоменклатуры_Отправка", "Имя");
				Если Не ПравилоОбработки = Неопределено Тогда
					ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, Характеристика, ПравилоОбработки);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Заполним упаковку.
		Если ЗначениеЗаполнено(СтрокаТаблицы.УпаковкаСсылка) И ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			Упаковка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
					СтрокаТаблицы.УпаковкаСсылка, "Владелец, Наименование, ЕдиницаИзмерения, Высота,
						|Глубина, Объем, Ширина, Знаменатель, Числитель");
			
			Если Упаковка.Владелец = СтрокаТаблицы.Номенклатура Тогда
				СтрокаТаблицы.Упаковка = СтрокаТаблицы.УпаковкаСсылка;
			Иначе
				Упаковка.Вставить("Владелец", СтрокаТаблицы.Номенклатура);
				СтрокаТаблицы.Упаковка = Новый Структура("Значение, ИмяПКО",
					Упаковка, "Справочник_Упаковки_ИзСтруктуры");
					
				ПравилоОбработки = КомпонентыОбмена.ПравилаОбработкиДанных.Найти("Справочник_УпаковкиЕдиницыИзмерения_Отправка", "Имя");
				Если Не ПравилоОбработки = Неопределено Тогда
					ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, Упаковка, ПравилоОбработки);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;
	ДанныеXDTO.Вставить("Записи", ТаблицаЗаписи);
КонецПроцедуры
