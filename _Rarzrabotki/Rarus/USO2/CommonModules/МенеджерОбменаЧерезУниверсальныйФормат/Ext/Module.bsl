Процедура ПКО_Документ_ВедомостьНаВыплатуЗарплатыПереч_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;
	ПолученныеДанные.СпособВыплаты = Справочники.СпособыВыплатыЗарплаты.Зарплата;
	ПолученныеДанные.Округление = Справочники.СпособыОкругленияПриРасчетеЗарплаты.ПоУмолчанию();
	ПолученныеДанные.ПроцентВыплаты = 100;
	
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("ФизическоеЛицо",                "ФизическоеЛицо");
	ПравилаЗаполнения.Вставить("НомерЛицевогоСчета",            "НомерЛицевогоСчета");
	ПравилаЗаполнения.Вставить("ПериодВзаиморасчетов",          "ПериодВзаиморасчетов");
	ПравилаЗаполнения.Вставить("Сумма",                         "КВыплате");
	ПравилаЗаполнения.Вставить("КомпенсацияЗаЗадержкуЗарплаты", "КомпенсацияЗаЗадержкуЗарплаты");
	
	МассивСтрокЗарплата = Новый Массив;
	Для Каждого Строка Из ДанныеXDTO.Зарплата Цикл
		
		СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
		
		Если СтруктураДанныхСтроки.Свойство("НомерЛицевогоСчета") И СтруктураДанныхСтроки.Свойство("ФизическоеЛицо") Тогда
			СтруктураБанковскийСчет = Новый Структура("Владелец, НомерСчета");
			СтруктураБанковскийСчет.Владелец = СтруктураДанныхСтроки.ФизическоеЛицо;
			СтруктураБанковскийСчет.НомерСчета = СтруктураДанныхСтроки.НомерЛицевогоСчета;
			
			СтруктураДанныхСтроки.Вставить("БанковскийСчет", Новый Структура("Значение, ИмяПКО",
				СтруктураБанковскийСчет, "Справочник_БанковскиеСчетаКонтрагентов_ИзСтруктуры"));    
		КонецЕсли;
		
		МассивСтрокЗарплата.Добавить(СтруктураДанныхСтроки);
		
	КонецЦикла;
	
	ПолученныеДанные.ДополнительныеСвойства.Вставить("Зарплата", МассивСтрокЗарплата);
КонецПроцедуры

