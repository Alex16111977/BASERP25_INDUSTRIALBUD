Процедура ОтложеннаяОбработка_ВозвратТоваровОтПокупателя(Объект, КомпонентыОбмена, ОбъектМодифицирован)
	ЗаполнениеПартнераВШапкеДокумента(Объект);
	ЗаполнениеСоглашенияСКлиентомВШапкеДокумента(Объект);
	ЗаполнитьТипНалогообложенияПоУмолчанию(Объект);
	
	Если Не ЗначениеЗаполнено(Объект.ПорядокОплаты) Тогда
		Если ЗначениеЗаполнено(Объект.Соглашение)
			И (ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами")) Тогда
			
			УсловияПродаж = ПродажиСервер.ПолучитьУсловияПродаж(Объект.Соглашение);
			
			Если Не ЗначениеЗаполнено(УсловияПродаж.ИспользуютсяДоговорыКонтрагентов) 
				Или Не УсловияПродаж.ИспользуютсяДоговорыКонтрагентов Тогда
				Объект.ПорядокОплаты = УсловияПродаж.ПорядокОплаты;
			Иначе
				Объект.ПорядокОплаты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ПорядокОплаты");
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(Объект.Договор)
			И (ПолучитьФункциональнуюОпцию("ИспользоватьДоговорыСКлиентами")) Тогда
			Объект.ПорядокОплаты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ПорядокОплаты");
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ПорядокОплаты) Тогда
		Объект.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.ПолучитьПорядокОплатыПоУмолчанию(Объект.Валюта, , Объект.Валюта);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ЗаявкаНаВозвратТоваровОтКлиента) И НЕ ЗначениеЗаполнено(Объект.ВариантПриемкиТоваров) Тогда
		Объект.ВариантПриемкиТоваров = Константы.ВариантПриемкиТоваров.Получить();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ПорядокРасчетов) Тогда
		Объект.ПорядокРасчетов = ВзаиморасчетыСервер.ПорядокРасчетовПоУмолчанию(Объект);
	КонецЕсли;
	
	ЗаполнитьСтатусыУказанияСерий(Объект, КомпонентыОбмена);
КонецПроцедуры
Процедура ОтложеннаяОбработка_ВозвратТоваровПоставщику(Объект, ОбъектМодифицирован, КомпонентыОбмена)
	ЗаполнениеПартнераВШапкеДокумента(Объект);
	ЗаполнениеСоглашенияСПоставщикомВШапкеДокумента(Объект, КомпонентыОбмена.ПараметрыКонвертации);
	ЗаполнитьПараметрыДоставки(Объект);
	ЗаполнитьТипНалогообложенияПоУмолчанию(Объект);
	
	Если Не ЗначениеЗаполнено(Объект.ПорядокОплаты) Тогда
		Если ЗначениеЗаполнено(Объект.Соглашение)
			И (ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами")) Тогда
			
			УсловияЗакупок = ЗакупкиСервер.ПолучитьУсловияЗакупок(Объект.Соглашение);
			
			Если Не ЗначениеЗаполнено(УсловияЗакупок.ИспользуютсяДоговорыКонтрагентов) 
				Или Не УсловияЗакупок.ИспользуютсяДоговорыКонтрагентов Тогда
				Объект.ПорядокОплаты = УсловияЗакупок.ПорядокОплаты;
			Иначе
				Объект.ПорядокОплаты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ПорядокОплаты");
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(Объект.Договор)
			И (ПолучитьФункциональнуюОпцию("ИспользоватьДоговорыСКлиентами")) Тогда
			Объект.ПорядокОплаты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ПорядокОплаты");
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ПорядокОплаты) Тогда
		ВалютаОплаты         = ДенежныеСредстваСервер.ПолучитьВалютуОплаты(, Объект.БанковскийСчетОрганизации);
		Объект.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.ПолучитьПорядокОплатыПоУмолчанию(Объект.Валюта,
			Объект.НалогообложениеНДС,
			ВалютаОплаты);
	КонецЕсли;
	
	ЗаполнитьСтатусыУказанияСерий(Объект, КомпонентыОбмена);
КонецПроцедуры
//++НЕ УТ
Процедура ОтложеннаяОбработка_ВыбытиеДенежныхДокументов(Объект, КомпонентыОбмена)
	Для Каждого Стр Из Объект.ДенежныеДокументы Цикл
		Если НЕ ЗначениеЗаполнено(Стр.Валюта) Тогда
			Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.ДенежныйДокумент, "Валюта");
			Стр.Валюта = Валюта;
		КонецЕсли;
	КонецЦикла;
	
	Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратДенежныхДокументовПоставщику Тогда
		ЗаполнениеПартнераВШапкеДокумента(Объект);
		ЗаполнениеСоглашенияСПоставщикомВШапкеДокумента(Объект, КомпонентыОбмена.ПараметрыКонвертации);
		
		Если НЕ ЗначениеЗаполнено(Объект.ПорядокОплаты) Тогда 
			Если ЗначениеЗаполнено(Объект.Договор) Тогда
				Объект.ПорядокОплаты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор,"ПорядокОплаты");
			Иначе
				Объект.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.ПолучитьПорядокОплатыПоУмолчанию(Объект.Валюта);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ПорядокРасчетов) Тогда
		Объект.ПорядокРасчетов = ВзаиморасчетыСервер.ПорядокРасчетовПоУмолчанию(Объект);
	КонецЕсли;
	
	//Заполним "МОЛОтправитель" и "Подразделение" по остаткам
	ЗаполненМОЛ = ЗначениеЗаполнено(Объект.МОЛОтправитель);
	ЗаполненоПодразделение = ЗначениеЗаполнено(Объект.Подразделение);
	Если НЕ ЗаполненМОЛ или НЕ ЗаполненоПодразделение Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Период", Объект.Дата);
		Запрос.УстановитьПараметр("ДенежныеДокументы", Объект.ДенежныеДокументы.ВыгрузитьКолонку("ДенежныйДокумент"));
		Запрос.УстановитьПараметр("МОЛ", Объект.МОЛОтправитель);
		Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 2
		               |	ДенежныеДокументыОстатки.МОЛ КАК МОЛ,
		               |	ДенежныеДокументыОстатки.Подразделение КАК Подразделение
		               |ИЗ
		               |	РегистрНакопления.ДенежныеДокументы.Остатки(
		               |			&Период,
		               |			ДенежныйДокумент В (&ДенежныеДокументы)
		               |				И ВЫБОР
		               |					КОГДА &МОЛ = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
		               |						ТОГДА ИСТИНА
		               |					ИНАЧЕ МОЛ = &МОЛ
		               |				КОНЕЦ
		               |				И ВЫБОР
		               |					КОГДА &Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
		               |						ТОГДА ИСТИНА
		               |					ИНАЧЕ Подразделение = &Подразделение
		               |				КОНЕЦ) КАК ДенежныеДокументыОстатки
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ДенежныеДокументыОстатки.МОЛ,
		               |	ДенежныеДокументыОстатки.Подразделение";
			
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Количество() = 1 Тогда
			Выборка.Следующий();
			ЗаполнитьЗначенияСвойств(Объект, Выборка);
		ИначеЕсли НЕ ЗаполненМОЛ Тогда
			Объект.МОЛОтправитель = ЭлементПоУмолчанию(КомпонентыОбмена, "ФизическоеЛицо");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
Процедура ОтложеннаяОбработка_ВыпускПродукции(Объект, КомпонентыОбмена)
	ЗаполнитьВидДеятельностиПоУмолчанию(Объект, "ВыпускПодДеятельность");
	
	Если НЕ ЗначениеЗаполнено(Объект.ВариантПриемкиТоваров) Тогда
		Объект.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным;
	КонецЕсли;
	  
	Если ЗначениеЗаполнено(Объект.Склад) Тогда
		Для Каждого Строка Из Объект.Товары Цикл
			Если НЕ ЗначениеЗаполнено(Строка.Склад) Тогда
				Строка.Склад = Объект.Склад; 
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Объект.НаправлениеВыпуска = Перечисления.ХозяйственныеОперации.ВыпускПродукцииВПодразделение Тогда
		Для Каждого СтрокаТЧ Из Объект.Товары Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Подразделение) Тогда
				СтрокаТЧ.Подразделение = ЭлементПоУмолчанию(КомпонентыОбмена, "Подразделение");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Проверим реквизиты подразделения.
	ЗначенияРеквизитов = Новый Структура("ПроизводственноеПодразделение, ПроизводствоБезЗаказов", Истина, Истина);
	ПроверитьОбновитьРеквизитыОбъекта(Объект.Подразделение, ЗначенияРеквизитов, КомпонентыОбмена);
	
	ЗаполнитьСтатусыУказанияСерий(Объект, КомпонентыОбмена);
КонецПроцедуры
