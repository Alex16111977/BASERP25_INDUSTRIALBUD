Процедура ПОД_Документ_ВыбытиеДенежныхДокументов_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	ИспользованиеПКО.Очистить();
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.5") Тогда 
		Возврат;
	КонецЕсли;
	
	//Проверим не используется ли в документе несколько валют
	Валюта = ДанныеИБ.ДенежныеДокументы[0].Валюта;
	НайденныеСтроки = ДанныеИБ.ДенежныеДокументы.НайтиСтроки(Новый Структура("Валюта", Валюта));
	
	Если Не НайденныеСтроки.Количество() = ДанныеИБ.ДенежныеДокументы.Количество() Тогда
		//Формат обмена 1.5 не поддерживает выгрузку мультивалютных списаний денежных документов
		ШаблонПредупреждения = НСтр("ru = 'Документ %1 не может быть выгружен,
		|т.к. формат обмена не поддерживает выгрузку мультивалютных выбытий денежных документов.';
		|en = 'Document %1 cannot be exported
		|as the exchange format does not support export of multicurrency outflow of financial documents.'");
		
		ТекстПредупреждения = СтрШаблон(ШаблонПредупреждения, ДанныеИБ.Ссылка);
		ПредупреждениеПриСинхронизации(КомпонентыОбмена, ДанныеИБ.Ссылка, ТекстПредупреждения);
		
		Возврат;
		
	КонецЕсли;
	
	ДанныеИБ.ДополнительныеСвойства.Вставить("Валюта", Валюта);
	
	Если ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеДенежныхДокументов Тогда
		ИспользованиеПКО.Вставить("Документ_СписаниеДД_Отправка", Истина);
	ИначеЕсли ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеДенежныхДокументов Тогда
		ИспользованиеПКО.Вставить("Документ_ПеремещениеДД_Отправка", Истина);	
	ИначеЕсли ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыдачаДенежныхДокументовПодотчетнику Тогда
		ИспользованиеПКО.Вставить("Документ_ВыдачаДДПодотчет_Отправка", Истина);
	ИначеЕсли ДанныеИБ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратДенежныхДокументовПоставщику Тогда
		ИспользованиеПКО.Вставить("Документ_ВозвратДДПоставщику_Отправка", Истина);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Запрос.Текст = "ВЫБРАТЬ
		|	ВыбытиеДенежныхДокументовДенежныеДокументы.ДенежныйДокумент КАК ДенежныйДокумент,
		|	ВыбытиеДенежныхДокументовДенежныеДокументы.Количество КАК Количество,
		|	ВЫБОР
		|		КОГДА ВыбытиеДенежныхДокументовДенежныеДокументы.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратДенежныхДокументовПоставщику)
		|			ТОГДА ВыбытиеДенежныхДокументовДенежныеДокументы.СуммаВозврата
		|		ИНАЧЕ ВыбытиеДенежныхДокументовДенежныеДокументы.Сумма
		|	КОНЕЦ КАК Сумма,
		|	ВыбытиеДенежныхДокументовДенежныеДокументы.Сумма КАК Стоимость
		|ИЗ
		|	Документ.ВыбытиеДенежныхДокументов.ДенежныеДокументы КАК ВыбытиеДенежныхДокументовДенежныеДокументы
		|ГДЕ
		|	ВыбытиеДенежныхДокументовДенежныеДокументы.Ссылка = &Ссылка";
	
	ТЧДенежныеДокументы = Запрос.Выполнить().Выгрузить();
	ДанныеИБ.ДополнительныеСвойства.Вставить("ТЧДенежныеДокументы", ТЧДенежныеДокументы);
КонецПроцедуры
