Процедура ПКО_Документ_ПБДСВозвратЗарплатыПоЗарпПроекту_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("Подразделение",
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.БанковскийСчет, "Подразделение"));
	
	Если ЭтоУТ() Тогда
		ТабРасшифровка = Новый ТаблицаЗначений();
		ТабРасшифровка.Колонки.Добавить("НомерВедомости");
		ТабРасшифровка.Колонки.Добавить("ДатаВедомости");
	//++ НЕ УТ
	Иначе
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПодтверждениеЗачисленияЗарплатыСотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
			|	ПодтверждениеЗачисленияЗарплатыСотрудники.Сумма КАК Сумма
			|ИЗ
			|	Документ.ПоступлениеБезналичныхДенежныхСредств КАК ПоступлениеБезналичныхДенежныхСредств
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПодтверждениеЗачисленияЗарплаты.Сотрудники КАК ПодтверждениеЗачисленияЗарплатыСотрудники
			|		ПО ПоступлениеБезналичныхДенежныхСредств.ПодтверждениеЗачисленияЗарплаты = ПодтверждениеЗачисленияЗарплатыСотрудники.Ссылка
			|ГДЕ
			|	ПоступлениеБезналичныхДенежныхСредств.Ссылка = &Ссылка
			|	И НЕ ПодтверждениеЗачисленияЗарплатыСотрудники.РезультатЗачисленияЗарплаты = ЗНАЧЕНИЕ(Перечисление.РезультатыЗачисленияЗарплаты.Зачислено)";
	
		ТабРасшифровка = Запрос.Выполнить().Выгрузить();
		ТабРасшифровка.Колонки.Добавить("НомерВедомости");
		ТабРасшифровка.Колонки.Добавить("ДатаВедомости");
		ТабРасшифровка.Колонки.Добавить("Ведомость");
	
		ПервичныйДокумент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.ПодтверждениеЗачисленияЗарплаты, "ПервичныйДокумент");
		Если ТипЗнч(ПервичныйДокумент) = Тип("ДокументСсылка.ВедомостьНаВыплатуЗарплатыВБанк") Тогда
			// Подтверждение введено на основании ведомости.
			НомерДатаВедомости = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПервичныйДокумент, "Номер, Дата");
			
			ТабРасшифровка.ЗаполнитьЗначения(НомерДатаВедомости.Номер, "НомерВедомости");
			ТабРасшифровка.ЗаполнитьЗначения(НомерДатаВедомости.Дата, "ДатаВедомости");
			ТабРасшифровка.ЗаполнитьЗначения(ПервичныйДокумент, "Ведомость");
			
		Иначе
			// Ведомость или ее данные возьмем из документа списания.
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.ДокументВыдачи);
			Запрос.Текст =
				"ВЫБРАТЬ
				|	СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ведомость КАК Ведомость,
				|	СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ведомость.Дата КАК ДатаВедомости,
				|	СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ведомость.Номер КАК НомерВедомости,
				|	СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.НомерВедомостиНаВыплатуЗарплаты КАК НомерВедомостиНаВыплатуЗарплаты,
				|	СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.ДатаВедомостиНаВыплатуЗарплаты КАК ДатаВедомостиНаВыплатуЗарплаты
				|ИЗ
				|	Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа
				|ГДЕ
				|	СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка = &Ссылка
				|	И ЕСТЬNULL(СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.НомерСтроки, 1) = 1";
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Если ЗначениеЗаполнено(Выборка.Ведомость) Тогда
					ТабРасшифровка.ЗаполнитьЗначения(Выборка.НомерВедомости, "НомерВедомости");
					ТабРасшифровка.ЗаполнитьЗначения(Выборка.ДатаВедомости, "ДатаВедомости");
					ТабРасшифровка.ЗаполнитьЗначения(Выборка.Ведомость, "Ведомость");
				Иначе
					ТабРасшифровка.ЗаполнитьЗначения(Выборка.НомерВедомостиНаВыплатуЗарплаты, "НомерВедомости");
					ТабРасшифровка.ЗаполнитьЗначения(Выборка.ДатаВедомостиНаВыплатуЗарплаты, "ДатаВедомости");
				КонецЕсли;
					
			КонецЕсли;
			
		КонецЕсли;
	//-- НЕ УТ
	КонецЕсли;
	
	ДанныеXDTO.Вставить("РасшифровкаНеВыплаченнойЗарплаты", ТабРасшифровка);
	
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, Истина);
КонецПроцедуры
