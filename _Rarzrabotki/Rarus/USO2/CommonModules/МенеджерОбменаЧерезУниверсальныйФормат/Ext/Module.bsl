		СтруктураДанныхСтроки.Вставить("НематериальныйАктив", ДанныеНМА);
		
		// Заполнение счетов учета и амортизации.
		СчетУчета = БухгалтерскийСчетПоКоду(Строка.СчетУчетаБУ, ПланыСчетов.Хозрасчетный.НематериальныеАктивыОрганизации);
		СтруктураДанныхСтроки.Вставить("СчетУчетаБУ", СчетУчета);
		СчетАмортизации = БухгалтерскийСчетПоКоду(Строка.СчетАмортизацииБУ, ПланыСчетов.Хозрасчетный.АмортизацияНематериальныхАктивов);
		СтруктураДанныхСтроки.Вставить("СчетНачисленияАмортизацииБУ", СчетАмортизации);
		СтруктураДанныхСтроки.Вставить("ПорядокСписанияНИОКРНаРасходыНУ", Перечисления.ПорядокСписанияНИОКРНУ.Равномерно);
	
		МассивСтрокТЧ.Добавить(СтруктураДанныхСтроки);
		
	КонецЦикла;
	
	ПолученныеДанные.ДополнительныеСвойства.Вставить("НМА", МассивСтрокТЧ);
