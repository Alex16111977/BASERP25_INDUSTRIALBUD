Процедура ПКО_Справочник_СтатьиРасходов_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	НаименованиеДляВыгрузки = ДанныеИБ.Наименование;
	ДанныеXDTO.КлючевыеСвойства.Вставить("Наименование", НаименованиеДляВыгрузки);
	
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, Истина);
	
	//++ НЕ УТ
	ДанныеXDTO.Вставить("ВидДеятельностиДляНалоговогоУчетаЗатрат", Неопределено);
	ДанныеXDTO.Вставить("ВидРасходовПоНеосновнойДеятельности",     Неопределено);
	ДанныеXDTO.Вставить("ВидРасходовПоОсновнойДеятельности",       Неопределено);
	
	Если ЗначениеЗаполнено(ДанныеИБ.ВидДеятельностиДляНалоговогоУчетаЗатрат) Тогда
		ДанныеXDTO.Вставить("ВидДеятельностиДляНалоговогоУчетаЗатрат", ОбщегоНазначения.ИмяЗначенияПеречисления(ДанныеИБ.ВидДеятельностиДляНалоговогоУчетаЗатрат));
	Иначе
		ДанныеXDTO.Вставить("ВидДеятельностиДляНалоговогоУчетаЗатрат", ОбщегоНазначения.ИмяЗначенияПеречисления(Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИБ.ВидПрочихРасходов) Тогда
		ДанныеXDTO.Вставить("ВидРасходовПоНеосновнойДеятельности", ОбщегоНазначения.ИмяЗначенияПеречисления(ДанныеИБ.ВидПрочихРасходов));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИБ.ВидРасходов) Тогда
		ДанныеXDTO.Вставить("ВидРасходовПоОсновнойДеятельности",   ОбщегоНазначения.ИмяЗначенияПеречисления(ДанныеИБ.ВидРасходов));
	КонецЕсли;
	//-- НЕ УТ
КонецПроцедуры

Процедура ПКО_Справочник_СтатьиРасходов_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена, Истина);
	
	//++ НЕ УТ
	ЗаполнитьРеквизитПеречислимогоТипаИзСвойства(ПолученныеДанные,
		ДанныеXDTO,
		"ВидДеятельностиДляНалоговогоУчетаЗатрат",
		"ВидДеятельностиДляНалоговогоУчетаЗатрат",
		"ВидыДеятельностиДляНалоговогоУчетаЗатрат");
	
	ЗаполнитьРеквизитПеречислимогоТипаИзСвойства(ПолученныеДанные,
		ДанныеXDTO,
		"ВидПрочихРасходов",
		"ВидРасходовПоНеосновнойДеятельности",
		"ВидыПрочихДоходовИРасходов");
	
	ЗаполнитьРеквизитПеречислимогоТипаИзСвойства(ПолученныеДанные,
		ДанныеXDTO,
		"ВидРасходов",
		"ВидРасходовПоОсновнойДеятельности",
		"ВидыРасходовНУ");
	//-- НЕ УТ
КонецПроцедуры

Процедура ПКО_Справочник_СтатьиРасходов_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
