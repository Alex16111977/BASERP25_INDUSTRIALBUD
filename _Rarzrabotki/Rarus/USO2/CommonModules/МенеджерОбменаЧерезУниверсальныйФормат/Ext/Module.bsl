Функция ВедомостьНаВыплатуЗаработнойПлаты(КомпонентыОбмена, ВидВедомости, ПараметрыВедомости, ВыплатаЗаработнойПлаты = Неопределено)
	ВедомостьСсылка = Неопределено;
		
	Источник = "Документ." + ВидВедомости;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ведомость.Ссылка КАК Ссылка
	|ИЗ
	|	&Источник КАК Ведомость
	|ГДЕ
	|	Ведомость.Номер = &Номер
	|	И Ведомость.Дата = &Дата
	|	И Ведомость.Организация = &Организация");
	Запрос.УстановитьПараметр("Номер",       ПараметрыВедомости.Номер); 
	Запрос.УстановитьПараметр("Дата",        ПараметрыВедомости.Дата);
	Запрос.УстановитьПараметр("Организация", ПараметрыВедомости.Организация);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Источник", Источник);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВедомостьСсылка = Выборка.Ссылка;
	Иначе
		Ведомость = Документы[ВидВедомости].СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(Ведомость, ПараметрыВедомости);
		
		Ведомость.ПроцентВыплаты    = 100;
		Ведомость.Округление        = Справочники.СпособыОкругленияПриРасчетеЗарплаты.ПоУмолчанию();
		Ведомость.СпособВыплаты     = Справочники.СпособыВыплатыЗарплаты.Зарплата;
		Ведомость.ПериодРегистрации = НачалоМесяца(Ведомость.Дата);
		
		Если Не ВыплатаЗаработнойПлаты = Неопределено Тогда
			Запрос = Новый Запрос( 
			"ВЫБРАТЬ
			|	Сотрудники.Ссылка КАК Сотрудник,
			|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо
			|ИЗ
			|	Справочник.Сотрудники КАК Сотрудники
			|ГДЕ
			|	Сотрудники.ГоловнаяОрганизация = &Организация
			|	И НЕ Сотрудники.ВАрхиве");
			Запрос.УстановитьПараметр("Организация", ПараметрыВедомости.Организация);
			
			СотрудникиОрганизаций = Запрос.Выполнить().Выгрузить();
			СотрудникиОрганизаций.Индексы.Добавить("ФизическоеЛицо");
			
			Для Каждого Строка Из ВыплатаЗаработнойПлаты Цикл
				
				СтрокаФизическиеЛица = Ведомость.ФизическиеЛица.Добавить();
				СтрокаФизическиеЛица.ФизическоеЛицо = Строка.ФизическоеЛицо;
				
				СтрокаЗарплата = Ведомость.Зарплата.Добавить();
				СтрокаЗарплата.ФизическоеЛицо = Строка.ФизическоеЛицо;
				СтрокаЗарплата.КВыплате = Строка.Сумма;
				
				Сотрудник = СотрудникиОрганизаций.Найти(Строка.ФизическоеЛицо, "ФизическоеЛицо");
				Если Не Сотрудник = Неопределено Тогда
					СтрокаЗарплата.Сотрудник = Сотрудник.Сотрудник;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
		Ведомость.ОбменДанными.Загрузка = Истина;
		Ведомость.Записать();
		
		СтрокаТаблицы = КомпонентыОбмена.ДокументыДляОтложенногоПроведения.Добавить();
		СтрокаТаблицы.ДокументСсылка = Ведомость.Ссылка;
		СтрокаТаблицы.ДатаДокумента  = Ведомость.Дата;
		
		ВедомостьСсылка = Ведомость.Ссылка;
		
	КонецЕсли;
	
	Возврат ВедомостьСсылка;
КонецФункции
Процедура ВедомостьНаВыплатуЗарплаты_ВыгрузитьТЧ(ДанныеИБ, ДанныеXDTO)
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Зарплата.КВыплате КАК Сумма,
		|	Зарплата.ФизическоеЛицо КАК ФизическоеЛицо,
		|	&НомерЛицевогоСчета КАК НомерЛицевогоСчета,
		|	Зарплата.ПериодВзаиморасчетов КАК ПериодВзаиморасчетов,
		|	Зарплата.СтатьяФинансирования.Наименование КАК НаименованиеСтатьиФинансирования,
		|	Зарплата.КомпенсацияЗаЗадержкуЗарплаты КАК КомпенсацияЗаЗадержкуЗарплаты
		|ИЗ
		|	&ИсточникЗарплата КАК Зарплата
		|ГДЕ
		|	Зарплата.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НДФЛ.Сумма КАК Сумма,
		|	НДФЛ.ФизическоеЛицо КАК ФизическоеЛицо,
		|	НДФЛ.КодДохода.Код КАК КодДохода,
		|	НДФЛ.МесяцНалоговогоПериода КАК МесяцНалоговогоПериода
		|ИЗ
		|	&ИсточникНДФЛ КАК НДФЛ
		|ГДЕ
		|	НДФЛ.Ссылка = &Ссылка";
	
	ПолноеИмяОбъекта  = ДанныеИБ.Метаданные().ПолноеИмя();
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИсточникЗарплата", ПолноеИмяОбъекта + ".Зарплата");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИсточникНДФЛ", ПолноеИмяОбъекта + ".НДФЛ");
	ТекстНомерЛицевогоСчета = "Неопределено";
	Если ТипЗнч(ДанныеИБ) = Тип("ДокументОбъект.ВедомостьНаВыплатуЗарплатыПеречислением") Тогда
		ТекстНомерЛицевогоСчета = "Зарплата.БанковскийСчет.НомерСчета";
	ИначеЕсли ТипЗнч(ДанныеИБ) = Тип("ДокументОбъект.ВедомостьНаВыплатуЗарплатыВБанк") Тогда
		ТекстНомерЛицевогоСчета = "Зарплата.НомерЛицевогоСчета";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НомерЛицевогоСчета", ТекстНомерЛицевогоСчета);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Запрос.Текст = ТекстЗапроса;
	
	РезультатПакета = Запрос.ВыполнитьПакет();
	ДанныеXDTO.Вставить("Зарплата", РезультатПакета[0].Выгрузить());
	ДанныеXDTO.Вставить("НДФЛ", РезультатПакета[1].Выгрузить());
КонецПроцедуры
Процедура ВедомостьНаВыплатуЗарплаты_ПередЗаписью(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена, КонвертацияСвойств)
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	
	Если ТипЗнч(ДанныеДляЗаписиВИБ) = Тип("ДокументОбъект.ВедомостьНаВыплатуЗарплатыПеречислением") Тогда
		ПоляСоответствия = "ФизическоеЛицо,БанковскийСчет";
	ИначеЕсли ТипЗнч(ДанныеДляЗаписиВИБ) = Тип("ДокументОбъект.ВедомостьНаВыплатуЗарплатыВБанк") Тогда
		ПоляСоответствия = "ФизическоеЛицо,НомерЛицевогоСчета";
	Иначе
		ПоляСоответствия = "ФизическоеЛицо";
	КонецЕсли;
	
	Если ДанныеИБ <> Неопределено Тогда
		// Переносим те свойства, которые указаны в ПКС
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
		
		// Зарплата
		КлючевыеПоля = ПоляСоответствия + ",ПериодВзаиморасчетов";
		
		ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
			ПолученныеДанные.Зарплата,
			ДанныеИБ.Зарплата,
			КлючевыеПоля,
			Неопределено,
			"КВыплате, КомпенсацияЗаЗадержкуЗарплаты");
			
		ДанныеИБ.Зарплата.Загрузить(ПолученныеДанные.Зарплата.Выгрузить());
		
		// НДФЛ
		МассивКлючевыхПолей = Новый Массив;
		МассивКлючевыхПолей.Добавить("ФизическоеЛицо");
		МассивКлючевыхПолей.Добавить("КодДохода");
		МассивКлючевыхПолей.Добавить("СтавкаНалогообложенияРезидента");
		МассивКлючевыхПолей.Добавить("МесяцНалоговогоПериода");
		
		ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
			ПолученныеДанные.НДФЛ,
			ДанныеИБ.НДФЛ,
			МассивКлючевыхПолей,
			Неопределено,
			"Сумма");
			
		ДанныеИБ.НДФЛ.Загрузить(ПолученныеДанные.НДФЛ.Выгрузить());
		
		ПолученныеДанные = Неопределено;
	КонецЕсли;
	
	Состав = ДанныеДляЗаписиВИБ.Зарплата.Выгрузить();
	Состав.Свернуть(ПоляСоответствия);
	
	СтруктураПоиска = Новый Структура(ПоляСоответствия);
	Состав.Колонки.Добавить("ИдентификаторСтроки");
	Для Каждого Строка Из Состав Цикл
		Строка.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, Строка);
		СтрокиЗарплата = ДанныеДляЗаписиВИБ.Зарплата.НайтиСтроки(СтруктураПоиска);
		Для Каждого СтрокаЗарплата Из СтрокиЗарплата Цикл
			СтрокаЗарплата.ИдентификаторСтроки = Строка.ИдентификаторСтроки;
		КонецЦикла;
	КонецЦикла;
	ДанныеДляЗаписиВИБ.Состав.Загрузить(Состав);
	
	
	ФизическиеЛица = ДанныеДляЗаписиВИБ.Зарплата.Выгрузить();
	ФизическиеЛица.Свернуть("ФизическоеЛицо");
	ДанныеДляЗаписиВИБ.ФизическиеЛица.Загрузить(ФизическиеЛица);
	
	Если Состав.Количество() = ФизическиеЛица.Количество() Тогда
		Для Каждого Строка Из ДанныеДляЗаписиВИБ.НДФЛ Цикл
			Если НЕ ЗначениеЗаполнено(Строка.ИдентификаторСтроки) Тогда
				СтрокаСостав = Состав.Найти(Строка.ФизическоеЛицо, "ФизическоеЛицо");
				Если НЕ СтрокаСостав = Неопределено Тогда
					Строка.ИдентификаторСтроки = СтрокаСостав.ИдентификаторСтроки;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
	Иначе
		ДанныеДляЗаписиВИБ.НДФЛ.Очистить();
	КонецЕсли;
КонецПроцедуры
