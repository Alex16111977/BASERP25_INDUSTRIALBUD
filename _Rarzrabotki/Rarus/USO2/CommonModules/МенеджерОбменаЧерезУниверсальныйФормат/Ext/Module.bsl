Процедура ОтложеннаяОбработка_ВедомостьНаВыплатуЗП(Объект)
	// Проверим и заполним сотрудников в табличной части "Зарплата".
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЗарплатаКВыплате.ФизическоеЛицо КАК ФизическоеЛицо
		|ИЗ
		|	&ИсточникДанных КАК ЗарплатаКВыплате
		|ГДЕ
		|	ЗарплатаКВыплате.Ссылка = &Ссылка
		|	И ЗарплатаКВыплате.Сотрудник = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
		|	И НЕ ЗарплатаКВыплате.ФизическоеЛицо = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)";
	
	ИмяДокумента = ОбщегоНазначения.ИмяТаблицыПоСсылке(Объект.Ссылка);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИсточникДанных", ИмяДокумента + ".Зарплата");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	СписокФизическихЛиц = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ФизическоеЛицо");
	Если СписокФизическихЛиц.Количество() > 0 Тогда
		// Получим таблицу основных сотрудников физических лиц.
		ОсновныеСотрудникиФизическихЛиц = КадровыйУчет.ОсновныеСотрудникиФизическихЛиц(СписокФизическихЛиц, Ложь, Объект.Организация, Объект.Дата);
		
		Для Каждого СтрокаТаблицы Из Объект.Зарплата Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицы.ФизическоеЛицо) И НЕ ЗначениеЗаполнено(СтрокаТаблицы.Сотрудник) Тогда
				СтрокаОсновнойСотрудник = ОсновныеСотрудникиФизическихЛиц.Найти(СтрокаТаблицы.ФизическоеЛицо, "ФизическоеЛицо");
				Если НЕ СтрокаОсновнойСотрудник = Неопределено Тогда
					СтрокаТаблицы.Сотрудник = СтрокаОсновнойСотрудник.Сотрудник;	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.ВедомостьНаВыплатуЗарплатыПеречислением")
		И НЕ Объект.Зарплата.Найти(Справочники.БанковскиеСчетаКонтрагентов.ПустаяСсылка(), "БанковскийСчет") = Неопределено Тогда
		
		// Заполним банковские счета.
		Для Каждого Строка Из Объект.Зарплата Цикл
			Если НЕ ЗначениеЗаполнено(Строка.БанковскийСчет) Тогда
				БанковскийСчет = Справочники.БанковскиеСчетаКонтрагентов.ПолучитьБанковскийСчетПоУмолчанию(Строка.ФизическоеЛицо);
				Если НЕ БанковскийСчет = Неопределено Тогда
					Строка.БанковскийСчет = БанковскийСчет;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
		
		Состав = Объект.Зарплата.Выгрузить();
		Состав.Свернуть("ИдентификаторСтроки, ФизическоеЛицо, БанковскийСчет");
		Объект.Состав.Загрузить(Состав);
	КонецЕсли;
КонецПроцедуры
