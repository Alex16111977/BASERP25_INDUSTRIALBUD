Процедура ПКО_Справочник_НМА_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ДанныеXDTO.Свойство("КлючевыеСвойства") Тогда
		ХранилищеСведений = ДанныеXDTO.КлючевыеСвойства;
	Иначе
		ХранилищеСведений = ДанныеXDTO;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(ПолученныеДанные, ХранилищеСведений,,"ВидОбъектаУчета, АмортизационнаяГруппа");
	// Эти свойства конвертируем явно, т.к. они не входят в свойства поиска и не будут сконвертированы автоматически.
	Если ХранилищеСведений.Свойство("ВидОбъектаУчета") И ЗначениеЗаполнено(ХранилищеСведений.ВидОбъектаУчета) Тогда
		ПКС_ВидОбъектаУчета = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.Найти("ВидыОбъектовУчетаНМА", "ИмяПКПД");
		ВидОбъектаУчета = ПКС_ВидОбъектаУчета.КонвертацииЗначенийПриПолучении.Получить(ХранилищеСведений.ВидОбъектаУчета.Значение);
		ПолученныеДанные.ВидОбъектаУчета = ВидОбъектаУчета;
	КонецЕсли;
	Если ХранилищеСведений.Свойство("АмортизационнаяГруппа") И ЗначениеЗаполнено(ХранилищеСведений.АмортизационнаяГруппа) Тогда
		ПКС_АмортизационнаяГруппа = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.Найти("АмортизационныеГруппы", "ИмяПКПД");
		АмортизационнаяГруппа = ПКС_АмортизационнаяГруппа.КонвертацииЗначенийПриПолучении.Получить(ХранилищеСведений.АмортизационнаяГруппа.Значение);
		ПолученныеДанные.АмортизационнаяГруппа = АмортизационнаяГруппа;
	КонецЕсли;
КонецПроцедуры
