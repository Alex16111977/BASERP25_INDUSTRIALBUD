Процедура ОтложеннаяОбработка_ОтчетПереработчика(Объект, КомпонентыОбмена)
	ЗаполнениеПартнераВШапкеДокумента(Объект);
	
	Если Не ЗначениеЗаполнено(Объект.ПорядокОплаты) Тогда
		ВалютаОплаты  = ДенежныеСредстваСервер.ПолучитьВалютуОплаты(Объект.ФормаОплаты, Объект.БанковскийСчетОрганизации);
		Объект.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.ПолучитьПорядокОплатыПоУмолчанию(Объект.ВалютаВзаиморасчетов,,ВалютаОплаты);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ПорядокРасчетов) Тогда
		Объект.ПорядокРасчетов = ВзаиморасчетыСервер.ПорядокРасчетовПоУмолчанию(Объект);
	КонецЕсли;
	
	Если Объект.СпособРаспределенияЗатратНаВыходныеИзделия = Перечисления.СпособыРаспределенияЗатратНаВыходныеИзделия.ПоПлановойСтоимости Тогда
		// Пересчитаем доли по плановой стоимости.
		ПараметрыРаспределенияЗатратСтруктура = Документы.ОтчетПереработчика.ПараметрыРаспределенияЗатрат(Объект);
		ПараметрыРаспределенияЗатрат = Новый ФиксированнаяСтруктура(ПараметрыРаспределенияЗатратСтруктура);
		
		ПроизводствоСервер.РассчитатьДолюСтоимости(Объект, ПараметрыРаспределенияЗатрат);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы из Объект.Материалы Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СтатьяКалькуляции) Тогда
			СтрокаТаблицы.СтатьяКалькуляции = ЭлементПоУмолчанию(КомпонентыОбмена, "СтатьяКалькуляцииМатериальныеЗатраты");
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы из Объект.Услуги Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СтатьяКалькуляции) Тогда
			СтрокаТаблицы.СтатьяКалькуляции = ЭлементПоУмолчанию(КомпонентыОбмена, "СтатьяКалькуляцииПрочее");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
//--НЕ УТ
Процедура ОтложеннаяОбработка_ПБДСВозвратЗарплатыПоЗарпПроек(Объект, КомпонентыОбмена)
	СоответствиеПБДСВозвратЗарплатыРасшифровка = КомпонентыОбмена.ПараметрыКонвертации.СоответствиеПБДСВозвратЗарплатыРасшифровка;
	
	//++ НЕ УТ
	ТабРасшифровки = СоответствиеПБДСВозвратЗарплатыРасшифровка.Получить(Объект.Ссылка);
	Если НЕ ТабРасшифровки = Неопределено Тогда
		ТабСумм = ТабРасшифровки.Скопировать();
		ТабСумм.Свернуть("ФизическоеЛицо", "Сумма");
		Если ЗначениеЗаполнено(Объект.ПодтверждениеЗачисленияЗарплаты) Тогда	
			// Проверим соответствие подтверждения с суммой возврата.
			ТабПодтверждение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ПодтверждениеЗачисленияЗарплаты, "Сотрудники").Выгрузить();
			ЕстьРасхождения = Ложь;
			Для Каждого Строка Из ТабПодтверждение Цикл
				СтрокаТабСумм = ТабСумм.Найти(Строка.ФизическоеЛицо, "ФизическоеЛицо");
				Если НЕ СтрокаТабСумм = Неопределено Тогда
					Если НЕ Строка.РезультатЗачисленияЗарплаты = Перечисления.РезультатыЗачисленияЗарплаты.Зачислено
						И Строка.Сумма = СтрокаТабСумм.Сумма Тогда
						Продолжить;
					Иначе
						Строка.Сумма = СтрокаТабСумм.Сумма;
						Строка.РезультатЗачисленияЗарплаты = Перечисления.РезультатыЗачисленияЗарплаты.НеЗачислено;
						
						ЕстьРасхождения = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			Если ЕстьРасхождения Тогда
				ОбъектПодтверждениеЗачисленияЗарплаты = Объект.ПодтверждениеЗачисленияЗарплаты.ПолучитьОбъект();
				ОбъектПодтверждениеЗачисленияЗарплаты.Сотрудники.Загрузить(ТабПодтверждение);
				
				ОбъектПодтверждениеЗачисленияЗарплаты.ОбменДанными.Загрузка = Истина;
				ОбъектПодтверждениеЗачисленияЗарплаты.Записать();
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(ТабРасшифровки[0].Ведомость) Тогда
			// Сформируем подтверждение.
			ОбъектПодтверждениеЗачисленияЗарплаты = Документы.ПодтверждениеЗачисленияЗарплаты.СоздатьДокумент();
			ЗаполнитьЗначенияСвойств(ОбъектПодтверждениеЗачисленияЗарплаты, Объект, "Дата, Организация");
			ОбъектПодтверждениеЗачисленияЗарплаты.ПервичныйДокумент = ТабРасшифровки[0].Ведомость;
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Ведомость", ТабРасшифровки[0].Ведомость);
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ВедомостьНаВыплатуЗарплатыВБанкЗарплата.ФизическоеЛицо КАК ФизическоеЛицо,
				|	СУММА(ВедомостьНаВыплатуЗарплатыВБанкЗарплата.КВыплате) КАК Сумма
				|ИЗ
				|	Документ.ВедомостьНаВыплатуЗарплатыВБанк.Зарплата КАК ВедомостьНаВыплатуЗарплатыВБанкЗарплата
				|ГДЕ
				|	ВедомостьНаВыплатуЗарплатыВБанкЗарплата.Ссылка = &Ведомость
				|
				|СГРУППИРОВАТЬ ПО
				|	ВедомостьНаВыплатуЗарплатыВБанкЗарплата.ФизическоеЛицо";
			
			Выборка = Запрос.Выполнить().Выбрать();
			ЕстьРасхождения = Ложь;
			Пока Выборка.Следующий() Цикл
				Строка = ОбъектПодтверждениеЗачисленияЗарплаты.Сотрудники.Добавить();
				ЗаполнитьЗначенияСвойств(Строка, Выборка);
				
				СтрокаТабСумм = ТабСумм.Найти(Выборка.ФизическоеЛицо, "ФизическоеЛицо");
				Если НЕ СтрокаТабСумм = Неопределено Тогда
					Если Строка.Сумма = СтрокаТабСумм.Сумма Тогда
						Строка.РезультатЗачисленияЗарплаты = Перечисления.РезультатыЗачисленияЗарплаты.НеЗачислено;
					Иначе
						ЕстьРасхождения = Истина;
					КонецЕсли;
				Иначе
					Строка.РезультатЗачисленияЗарплаты = Перечисления.РезультатыЗачисленияЗарплаты.Зачислено;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ ЕстьРасхождения Тогда
				ОбъектПодтверждениеЗачисленияЗарплаты.ОбменДанными.Загрузка = Истина;
				ОбъектПодтверждениеЗачисленияЗарплаты.Записать();
				
				Объект.ПодтверждениеЗачисленияЗарплаты = ОбъектПодтверждениеЗачисленияЗарплаты.Ссылка;
			КонецЕсли;
			
		Конецесли;
		
		// Заполним документ выдачи.
		Если НЕ ЗначениеЗаполнено(Объект.ДокументВыдачи) Тогда
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Организация", Объект.Организация);
			Запрос.УстановитьПараметр("Ведомость", ?(ЗначениеЗаполнено(ТабРасшифровки[0].Ведомость),
				ТабРасшифровки[0].Ведомость, Документы.ВедомостьНаВыплатуЗарплатыВБанк.ПустаяСсылка()));
			Запрос.УстановитьПараметр("ДатаВедомости", ТабРасшифровки[0].ДатаВедомости);
			Запрос.УстановитьПараметр("НомерВедомости", ТабРасшифровки[0].НомерВедомости);
			Запрос.Текст =
				"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 2
				|	ВложенныйЗапрос.Ссылка КАК Ссылка
				|ИЗ
				|	(ВЫБРАТЬ
				|		СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка КАК Ссылка
				|	ИЗ
				|		Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа
				|	ГДЕ
				|		СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.Организация = &Организация
				|		И СписаниеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ведомость = &Ведомость
				|	
				|	ОБЪЕДИНИТЬ ВСЕ
				|	
				|	ВЫБРАТЬ
				|		СписаниеБезналичныхДенежныхСредств.Ссылка
				|	ИЗ
				|		Документ.СписаниеБезналичныхДенежныхСредств КАК СписаниеБезналичныхДенежныхСредств
				|	ГДЕ
				|		СписаниеБезналичныхДенежныхСредств.Организация = &Организация
				|		И СписаниеБезналичныхДенежныхСредств.НомерВедомостиНаВыплатуЗарплаты = &НомерВедомости
				|		И СписаниеБезналичныхДенежныхСредств.ДатаВедомостиНаВыплатуЗарплаты = &ДатаВедомости) КАК ВложенныйЗапрос";
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Количество() = 1 Тогда
				Выборка.Следующий();
				Объект.ДокументВыдачи = Выборка.Ссылка;
			КонецЕсли;
		
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.ДокументВыдачи)
			И НЕ (ЗначениеЗаполнено(Объект.БанковскийСчетКонтрагента) И ЗначениеЗаполнено(Объект.Контрагент)) Тогда
			
			РеквизитыДокументыВыдачи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ДокументВыдачи, "БанковскийСчетКонтрагента, Контрагент");
			Если НЕ ЗначениеЗаполнено(Объект.БанковскийСчетКонтрагента) Тогда
				 Объект.БанковскийСчетКонтрагента = РеквизитыДокументыВыдачи.БанковскийСчетКонтрагента;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
				Объект.Контрагент = РеквизитыДокументыВыдачи.Контрагент;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//-- НЕ УТ
КонецПроцедуры
Процедура ОтложеннаяОбработка_ПервичныйДокумент(Объект, ОбъектМодифицирован, КомпонентыОбмена)
	Партнер = ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(Объект.Контрагент);
	Если Не ЗначениеЗаполнено(Партнер) Тогда
		Партнер = Справочники.Партнеры.НеизвестныйПартнер;
	КонецЕсли;
	
	Объект.Партнер = Партнер;
	
	ВалютаРеглУчета = ВалютаРегламентированногоУчета(КомпонентыОбмена);
	Если Объект.Валюта = ВалютаРеглУчета или НЕ ЗначениеЗаполнено(Объект.Валюта) Тогда
		Объект.Валюта = ВалютаРеглУчета;
		Объект.СуммаРегл = Объект.СуммаДокумента;
	Иначе
		КоэффициентПересчета = РаботаСКурсамиВалютУТ.ПолучитьКоэффициентПересчетаИзВалютыВВалюту(Объект.Валюта, ВалютаРеглУчета, Объект.Дата);
		Объект.СуммаРегл = Окр(Объект.СуммаДокумента * КоэффициентПересчета, 2, 1);
	КонецЕсли;
КонецПроцедуры
