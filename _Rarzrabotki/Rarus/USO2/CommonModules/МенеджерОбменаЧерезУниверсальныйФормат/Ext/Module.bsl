Процедура ОтложеннаяОбработка_ДвижениеПродукцииИМатериалов(Объект, КомпонентыОбмена)
	ЗаполнитьВидДеятельностиПоУмолчанию(Объект, "НалогообложениеНДС");
	ЗаполнитьСтатусыУказанияСерий(Объект, КомпонентыОбмена);
	
	#Область ЗаполнениеКладовой
	
	КладоваяЦеха = Неопределено;
	ПодразделениеКладовой = Неопределено;
	ИмяРеквизитаКладовая = "";
	Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаМатериаловВКладовую Тогда
		ИмяРеквизитаКладовая = "Получатель";
	ИначеЕсли Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратМатериаловИзКладовой
		ИЛИ Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаПродукцииИзКладовой Тогда
		ИмяРеквизитаКладовая = "Отправитель";
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ИмяРеквизитаКладовая) Тогда	
		Если ЗначениеЗаполнено(Объект[ИмяРеквизитаКладовая])
			И ОбщегоНазначения.СсылкаСуществует(Объект[ИмяРеквизитаКладовая]) Тогда
			
			Если ТипЗнч(Объект[ИмяРеквизитаКладовая]) = Тип("СправочникСсылка.Склады")
				И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект[ИмяРеквизитаКладовая], "ЦеховаяКладовая") Тогда
			
				КладоваяЦеха = Объект[ИмяРеквизитаКладовая]
			ИначеЕсли ТипЗнч(Объект[ИмяРеквизитаКладовая]) = Тип("СправочникСсылка.СтруктураПредприятия") Тогда
				ПодразделениеКладовой = Объект[ИмяРеквизитаКладовая];
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(КладоваяЦеха) Тогда
			Если НЕ ЗначениеЗаполнено(ПодразделениеКладовой) Тогда
				ПодразделениеКладовой = ЭлементПоУмолчанию(КомпонентыОбмена, "Подразделение");
			КонецЕсли;
			
			// Проверим реквизиты подразделения.
			ЗначенияРеквизитов = Новый Структура("ПроизводственноеПодразделение, ПроизводствоПоЗаказам", Истина, Истина);
			ПроверитьОбновитьРеквизитыОбъекта(ПодразделениеКладовой, ЗначенияРеквизитов, КомпонентыОбмена);
			
			// Получим кладовую по умолчанию.
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("Подразделение", ПодразделениеКладовой);
			КладоваяЦеха = ЭлементПоУмолчанию(КомпонентыОбмена, "КладоваяЦеха", ДопПараметры);
			
			Объект[ИмяРеквизитаКладовая] = КладоваяЦеха;
		КонецЕсли;
	КонецЕсли;
		
	#КонецОбласти
КонецПроцедуры
