Процедура ПКО_Документ_ПередачаДавальцу_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	СкладДляВыгрузки = СкладДляВыгрузки(ДанныеИБ.Склад, КомпонентыОбмена.ПараметрыКонвертации);
	ДанныеXDTO.Вставить("Склад", СкладДляВыгрузки);
	ВыгрузитьПодразделениеИзРеквизитаДокумента(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, "Склад");
	ВыгрузитьНалогообложениеНДС(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, Ложь, Ложь);
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
	
	// Дополнительные свойства для договора
	Если НЕ ЗначениеЗаполнено(ДанныеИБ.Договор) Тогда
		ДоговорЗаполнен = Ложь;
		ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчета.Получить();
		Если ЗначениеЗаполнено(ДанныеИБ.ЗаказДавальца) Тогда
			ДанныеЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеИБ.ЗаказДавальца,"Валюта, Договор");
			Если ЗначениеЗаполнено(ДанныеЗаказа.Договор) Тогда
				ДанныеXDTO.Вставить("Договор", ДанныеЗаказа.Договор);
				ДоговорЗаполнен = Истина;
			КонецЕсли;
			Если ЗначениеЗаполнено(ДанныеЗаказа.Валюта) Тогда
				ВалютаВзаиморасчетов = ДанныеЗаказа.Валюта;
			КонецЕсли;
		КонецЕсли;
		Если НЕ ДоговорЗаполнен Тогда
			ПараметрыПоУмолчанию = Новый Структура(ДоговорФиксированнаяСтруктураКлючей());
			ЗаполнитьЗначенияСвойств(ПараметрыПоУмолчанию, ДанныеИБ, "Контрагент, Организация");
			ПараметрыПоУмолчанию.РасчетыВУсловныхЕдиницах = Ложь;
			ПараметрыПоУмолчанию.ВалютаВзаиморасчетов = ВалютаВзаиморасчетов;
			ПараметрыПоУмолчанию.ВидДоговора = "СПокупателем";
			ДанныеXDTO.Вставить("Договор", ДоговорИнструкцияКонвертацииПоДаннымВзаиморасчетов(ПараметрыПоУмолчанию, КомпонентыОбмена));
		КонецЕсли;
	Иначе
		ДанныеXDTO.Вставить("Договор", ДанныеИБ.Договор);
	КонецЕсли;
	ДанныеДокумента =
		"ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	&ТекстЗапросаХарактеристика,
		|	&ТекстЗапросаСерия,
		|	&ТекстЗапросаУпаковка,
		|	Товары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Товары.Количество КАК Количество,
		|	ВЫРАЗИТЬ(""СобственныеТовары"" КАК СТРОКА(18)) КАК ТипЗапасов
		|ИЗ
		|	Документ.ПередачаДавальцу.Товары КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &Ссылка";
	
	ДанныеДокумента = СтрЗаменить(ДанныеДокумента, "&ТекстЗапросаХарактеристика",
		ПолучитьТекстЗапросаХарактеристики(КомпонентыОбмена, "Товары"));
		
	ДанныеДокумента = СтрЗаменить(ДанныеДокумента, "&ТекстЗапросаУпаковка",
		ПолучитьТекстЗапросаУпаковки(КомпонентыОбмена, "Товары"));
		
	ДанныеДокумента = СтрЗаменить(ДанныеДокумента, "&ТекстЗапросаСерия",
		ПолучитьТекстЗапросаСерии(КомпонентыОбмена, "Товары"));
	
	Запрос = Новый Запрос(ДанныеДокумента);
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Товары = Запрос.Выполнить().Выгрузить();
	
	ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, Товары);
	
	ДанныеXDTO.Вставить("Товары", Товары);
КонецПроцедуры
