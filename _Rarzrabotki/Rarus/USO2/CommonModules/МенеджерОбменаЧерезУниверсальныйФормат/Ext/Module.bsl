	ДанныеXDTO.Вставить("ГлавныйБухгалтер",        ДанныеИБ.ДополнительныеСвойства.ГлавныйБухгалтер);
	
	
	ДанныеXDTO.Вставить("Товары", ДанныеИБ.ДополнительныеСвойства.Товары);
