			И ДанныеИБ.ЭтоГруппа Тогда	
			ИспользованиеПКО.Справочник_Банки = Ложь;	
		КонецЕсли;
		ПроверкаЗаполненияРеквизитовОбъектаИБ(ДанныеИБ, КомпонентыОбмена, ИспользованиеПКО);
	КонецЕсли;
