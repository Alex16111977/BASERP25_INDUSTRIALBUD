				СрезПоСтатьям = ТаблицаРаспределения.Скопировать(Новый Структура("СчетУчета, НаправлениеДеятельности, ДокументПоступленияРасходов", СтрокаДереваСчет.СчетУчета, СтрДок.НаправлениеДеятельности, СтрДок.ДокументПоступленияРасходов));
				Для Каждого СтрСтатья Из СрезПоСтатьям Цикл
					СтрокаДерева2 = СтрокаДерева1.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаДерева2, СтрСтатья);
					СтрокаДерева2.СоставнаяКолонкаДанных = СтрокаДерева2.СтатьяРасходов;
					СтрокаДерева2.ЭтоСтатья = Истина;
				КонецЦикла;
				
				СтрокаДерева1.СуммаНДС = СтрДок.СуммаНДС;
				СтрокаДерева1.СуммаОблагаемаяНДС = СтрДок.СуммаОблагаемаяНДС;
				СтрокаДерева1.СуммаНеоблагаемаяНДС = СтрДок.СуммаНеоблагаемаяНДС;
				СтрокаДерева1.СуммаОблагаемаяНДС_ДанныеРегистра 	= СтрДок.СуммаОблагаемаяНДС_ДанныеРегистра;
				СтрокаДерева1.СуммаНеоблагаемаяНДС_ДанныеРегистра 	= СтрДок.СуммаНеоблагаемаяНДС_ДанныеРегистра;
				
				СтрокаДерева1.СуммаНДСУпр = СтрДок.СуммаНДСУпр;
				СтрокаДерева1.СуммаОблагаемаяНДСУпр = СтрДок.СуммаОблагаемаяНДСУпр;
				СтрокаДерева1.СуммаНеоблагаемаяНДСУпр = СтрДок.СуммаНеоблагаемаяНДСУпр;
				СтрокаДерева1.СуммаОблагаемаяНДСУпр_ДанныеРегистра 	= СтрДок.СуммаОблагаемаяНДСУпр_ДанныеРегистра;
				СтрокаДерева1.СуммаНеоблагаемаяНДСУпр_ДанныеРегистра 	= СтрДок.СуммаНеоблагаемаяНДСУпр_ДанныеРегистра;
				
			КонецЦикла;
			
			СтрокаДерева0.СуммаНДС = Стр0.СуммаНДС;
			СтрокаДерева0.СуммаОблагаемаяНДС = Стр0.СуммаОблагаемаяНДС;
			СтрокаДерева0.СуммаНеоблагаемаяНДС = Стр0.СуммаНеоблагаемаяНДС;
			СтрокаДерева0.СуммаОблагаемаяНДС_ДанныеРегистра 	= Стр0.СуммаОблагаемаяНДС_ДанныеРегистра;
			СтрокаДерева0.СуммаНеоблагаемаяНДС_ДанныеРегистра 	= Стр0.СуммаНеоблагаемаяНДС_ДанныеРегистра;
			
			СтрокаДерева0.СуммаНДСУпр = Стр0.СуммаНДСУпр;
			СтрокаДерева0.СуммаОблагаемаяНДСУпр = Стр0.СуммаОблагаемаяНДСУпр;
			СтрокаДерева0.СуммаНеоблагаемаяНДСУпр = Стр0.СуммаНеоблагаемаяНДСУпр;
			СтрокаДерева0.СуммаОблагаемаяНДСУпр_ДанныеРегистра 	= Стр0.СуммаОблагаемаяНДСУпр_ДанныеРегистра;
			СтрокаДерева0.СуммаНеоблагаемаяНДСУпр_ДанныеРегистра 	= Стр0.СуммаНеоблагаемаяНДСУпр_ДанныеРегистра;
			
		КонецЦикла;
		
		СтрокаДереваСчет.СуммаНДС 				= СтрокаДереваСчет.Строки.Итог("СуммаНДС");
		СтрокаДереваСчет.СуммаОблагаемаяНДС 	= СтрокаДереваСчет.Строки.Итог("СуммаОблагаемаяНДС");
		СтрокаДереваСчет.СуммаНеоблагаемаяНДС 	= СтрокаДереваСчет.Строки.Итог("СуммаНеоблагаемаяНДС");
		СтрокаДереваСчет.СуммаОблагаемаяНДС_ДанныеРегистра 		= СтрокаДереваСчет.Строки.Итог("СуммаОблагаемаяНДС_ДанныеРегистра");
		СтрокаДереваСчет.СуммаНеоблагаемаяНДС_ДанныеРегистра 	= СтрокаДереваСчет.Строки.Итог("СуммаНеоблагаемаяНДС_ДанныеРегистра");
		
