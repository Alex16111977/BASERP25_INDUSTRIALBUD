КонецПроцедуры

#КонецОбласти


#Область Документ_ПрочиеДоходыИРасходы

Процедура УСОERP_ПрочиеДоходыРасходы_УправлениеФормойДокумента(Форма) Экспорт
	
	Если Форма.ИмяФормы = "Документ.ПрочиеДоходыРасходы.Форма.ФормаДокумента" Тогда
		
		Элементы = Форма.Элементы;
		Объект = Форма.Объект;
		ГруппаСтраниц = Элементы.Найти("УСОERP__ГруппаДопРеквизитовШапки");
		Если ГруппаСтраниц = Неопределено Тогда
			ГруппаСтраниц = Элементы.Добавить("УСОERP__ГруппаДопРеквизитовШапки", Тип("ГруппаФормы"), Элементы.ГруппаШапка);
			ГруппаСтраниц.Вид = ВидГруппыФормы.Страницы;
			ГруппаСтраниц.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		Иначе
			ГруппаСтраниц.Видимость = Истина;
		КонецЕсли;
		
		Префикс = "";
		Страница = Элементы.Найти("УСОERP_Страница" + Префикс);
		Если Страница = Неопределено Тогда
			Страница = Элементы.Добавить("УСОERP_Страница" + Префикс, Тип("ГруппаФормы"), ГруппаСтраниц);
			Страница.Вид = ВидГруппыФормы.Страница;
			Страница.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		КонецЕсли;
		
		Элемент = Элементы.Найти("УСОERP_СчетЗатрат" + Префикс);
		Если  Элемент = Неопределено Тогда
			Элемент = Элементы.Добавить("УСОERP_СчетЗатрат" + Префикс, Тип("ПолеФормы"), Страница);
			Элемент.Вид = ВидПоляФормы.ПолеВвода;
			Элемент.ПутьКДанным = "Объект.УСОERP_СчетЗатрат";
			//Элемент.АвтоОтметкаНезаполненного = Истина;
		КонецЕсли;
		
		Элемент = Элементы.Найти("УСОERP_НаправлениеДеятельности" + Префикс);
		Если  Элемент = Неопределено Тогда
			Элемент = Элементы.Добавить("УСОERP_НаправлениеДеятельности" + Префикс, Тип("ПолеФормы"), Страница);
			Элемент.Вид = ВидПоляФормы.ПолеВвода;
			Элемент.ПутьКДанным = "Объект.УСОERP_НаправлениеДеятельности";
			//Элемент.АвтоОтметкаНезаполненного = Истина;
			
			Элемент.УстановитьДействие("ПриИзменении", "УСОERP_НаправлениеДеятельностиПриИзменении");
			Элемент.УстановитьДействие("НачалоВыбора", "УСОERP_НаправлениеДеятельностиНачалоВыбора");
		КонецЕсли;  
		
		Группа = Элементы.Найти("УСОERP_ГруппаНЗП");
		Если Группа = Неопределено Тогда
			Группа = Элементы.Добавить("УСОERP_ГруппаНЗП", Тип("ГруппаФормы"), Страница);
			Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
			Группа.ОтображатьЗаголовок = Ложь;
		КонецЕсли;
		
		Элемент = Элементы.Найти("УСОERP_ПроцентНЗП");
		Если  Элемент = Неопределено Тогда
			Элемент = Элементы.Добавить("УСОERP_ПроцентНЗП", Тип("ПолеФормы"), Группа);
			Элемент.Вид = ВидПоляФормы.ПолеВвода;
			Элемент.ПутьКДанным = "Объект.УСОERP_ПроцентНЗП";
			Элемент.РастягиватьПоГоризонтали = Ложь;
			Элемент.Ширина = 8;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СозданиеНаОсновании

//В документах ПБДС,ПКО в обработке заполнения данныезаполнения
//1С преобразует в структуру, поэтому наша подписка не срабатывает.
//процедура возвращает данныезаполнения

Процедура ВосстановитьДанныеЗаполнения(ДанныеЗаполнения,ДокОснование) Экспорт
	
	    Если ТипЗнч(ДокОснование) = Тип("ДокументСсылка.УПН_ДоговорПоНедвижимости")
		ИЛИ  ТипЗнч(ДокОснование) = Тип("ДокументСсылка.УСОERP_РеализацияСтроительныхРабот") Тогда
		
		ДанныеЗаполнения = ДокОснование;
		
	КонецЕсли;
	
КонецПроцедуры

//Подписка на событие "Обработка заполнения" - для заполнения типовых документов ERP без изменения модуля
//
Процедура УСОERP_ОбработкаЗаполненияДокументовОбработкаЗаполнения(Источник, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УСОERP_АктПриемкиРабот") Тогда
		
		Если ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаявкаНаРасходованиеДенежныхСредств") Тогда
			ЗаполнитьЗаявкуНаОснованииАкта(Источник,ДанныеЗаполнения);
		КонецЕсли;
		
		Если ТипЗнч(Источник) = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") Тогда
			ЗаполнитьСБДСНаОснованииАкта(Источник, ДанныеЗаполнения);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УСОERP_ЗаказНаПеревозку") Тогда
		
		Если ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаданиеНаПеревозку") Тогда
			ЗаполнитьЗаданиеНаПеревозкуНаОснованииЗаказаНаПеревозку(Источник, ДанныеЗаполнения);
		КонецЕсли;
		
		Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПриобретениеУслугПрочихАктивов") Тогда
			ЗаполнитьПриобретениеУслугНаПеревозкуНаОснованииЗаказаНаПеревозку(Источник, ДанныеЗаполнения);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УСОERP_ИнвестиционныйНДС") Тогда
		
		Если ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаписьКнигиПокупок") Тогда
			//ЗаполнитьЗаписьКПНаОснованииИнвестиционныйНДС(Источник,ДанныеЗаполнения);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УСОERP_РасходМатериаловВСтроительстве") Тогда
		
		Если ТипЗнч(Источник) = Тип("ДокументОбъект.ВнутреннееПотреблениеТоваров") Тогда
			//ЗаполнитьВнутреннееПотреблениеНаОснованииРасходМатериалов(Источник,ДанныеЗаполнения);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УСОERP_РеализацияСтроительныхРабот") Тогда
		
		Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств") Тогда
			ЗаполнитьПБДСНаОснованииРеализииСтроительныхРабот(Источник,ДанныеЗаполнения);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УПН_ДоговорПоНедвижимости") Тогда
		
		Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств") Тогда
			
			ЗаполнитьПБДСНаОснованииДоговораПоНедвижимости(Источник,ДанныеЗаполнения);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если  ТипЗнч(Источник) = Тип("ДокументОбъект.ВзаимозачетЗадолженности") Тогда
		Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УСОERP_АктПриемкиРабот") Тогда
			ЗаполнитьВзаимозачетЗадолженностиНаОснованииАктаПриемки(Источник, ДанныеЗаполнения);
		ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УСОERP_РеализацияСтроительныхРабот") Тогда
			ЗаполнитьВзаимозачетЗадолженностиНаОснованииРеализацииСтроительныхРабот(Источник, ДанныеЗаполнения);
		КонецЕсли;
	КонецЕсли;
	
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} {
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УСОERP_РеализацияСтроительныхРаботВнутренняя") Тогда
		Если ТипЗнч(Источник) = Тип("ДокументОбъект.ВыпускПродукции") Тогда
			ЗаполнитьВыпускПродукцииНаОснованииРеализацииСтроительныхРаботВнутренняя(Источник, ДанныеЗаполнения);
		КонецЕсли;
	КонецЕсли;
	// {УСО 2.4}:{Управление строительной организацией}{Григорьев А.Ю.} }
	
КонецПроцедуры    

//Заполняет заявку на расходование денежных средств на основании акта о выполненных работах
//
Процедура ЗаполнитьЗаявкуНаОснованииАкта(Объект,Документ)Экспорт
	
	Объект.Организация = Документ.Организация;
	Объект.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	Объект.ФормаОплатыБезналичная = Истина;
	Объект.ФормаОплатыЗаявки = Перечисления.ФормыОплаты.Безналичная;
	Объект.Подразделение = Документ.Подразделение;
	Объект.ЖелательнаяДатаПлатежа = ТекущаяДата();
	Объект.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПоставщику;
	Объект.НаправлениеДеятельности = Документ.НаправлениеДеятельности;	
	Объект.БанковскийСчет = Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(Объект.Организация,Объект.Валюта);
	Объект.Контрагент = Документ.Контрагент;
	Объект.ДокументОснование = Документ;
	Объект.СуммаДокумента = Документ.СуммаДокумента;
	Объект.БанковскийСчетКонтрагента = Справочники.БанковскиеСчетаКонтрагентов.ПолучитьБанковскийСчетПоУмолчанию(
				Объект.Контрагент,
				Объект.Валюта);
		
	СтрокаПлатежа = ?(Объект.РасшифровкаПлатежа.Количество(),Объект.РасшифровкаПлатежа.Получить(0),Объект.РасшифровкаПлатежа.Добавить());
	
	СтрокаПлатежа.Партнер = Документ.Субподрядчик;
	СтрокаПлатежа.Заказ = Документ.Договор;
	СтрокаПлатежа.Организация = Документ.Организация;
	СтрокаПлатежа.Сумма = Документ.СуммаДокумента;
	СтрокаПлатежа.СуммаВзаиморасчетов = СтрокаПлатежа.Сумма;
	СтрокаПлатежа.СуммаНДС = Документ.СуммаНДС;
	СтрокаПлатежа.СтавкаНДС = ?(СтрокаПлатежа.СуммаНДС = 0,Перечисления.СтавкиНДС.БезНДС,?(ЗначениеЗаполнено(Документ.Договор.СтавкаНДС),Документ.Договор.СтавкаНДС,Перечисления.СтавкиНДС.НДС18));
	СтрокаПлатежа.ВалютаВзаиморасчетов = Объект.Валюта;
	СтрокаПлатежа.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПоставщику;
	СтрокаПлатежа.УСОERP_ОбъектСтроительства = Документ.ОбъектСтроительства;
	СтрокаПлатежа.НаправлениеДеятельности = Документ.НаправлениеДеятельности;

КонецПроцедуры

