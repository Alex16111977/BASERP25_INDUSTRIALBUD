	Дт.Партнер = Основание.Контрагент.Партнер;
	Дт.Заказ = ?(Основание.Договор.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов, Основание.Договор, Основание);
	Дт.Сумма = ?(Основание.ВыполненоВсего.Количество(), Основание.ВыполненоВсего[0].СуммаГУ, 0);
	Дт.СуммаВзаиморасчетов = ?(Основание.ВыполненоВсего.Количество(), Основание.ВыполненоВсего[0].СуммаГУ, 0);
	Дт.ВалютаВзаиморасчетов = Основание.ВалютаВзаиморасчетов;
	Дт.Организация = Основание.Организация;
