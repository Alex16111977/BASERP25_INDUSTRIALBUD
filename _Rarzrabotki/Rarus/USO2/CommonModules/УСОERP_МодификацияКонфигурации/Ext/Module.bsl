	Элементы.Переместить(Элементы.УСОERP_ДеревоВосстановленияНДССуммаОблагаемаяНДС_ДанныеРегистра,ГруппаСуммаНДС,);
	Элементы.Переместить(Элементы.УСОERP_ДеревоВосстановленияНДССуммаОблагаемаяНДС,ГруппаСуммаНДС,);
	Элементы.Переместить(Элементы.УСОERP_ДеревоВосстановленияНДССуммаНеОблагаемаяНДС_ДанныеРегистра,ГруппаСуммаНДС,);
