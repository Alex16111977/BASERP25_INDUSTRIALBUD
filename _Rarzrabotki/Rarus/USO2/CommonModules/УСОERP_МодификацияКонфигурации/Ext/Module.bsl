КонецПроцедуры

#КонецОбласти  

#Область Документ_РаспределениеНДС

Процедура РаспределениеНДС_ПриСозданииНаСервере(Форма, Отказ = Ложь, СтандартнаяОбработка = Истина) Экспорт
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	СтраницаСчет2001 = Элементы.Найти("СтраницаУСОERP_РаспределениеНДС");
	Если СтраницаСчет2001 = Неопределено Тогда
		СтраницаСчет2001 = Элементы.Добавить("СтраницаУСОERP_РаспределениеНДС", Тип("ГруппаФормы"), Элементы.ГруппаСтраницы);
		СтраницаСчет2001.Вид = ВидГруппыФормы.Страница;
		СтраницаСчет2001.Заголовок = "Распределение НДС по счетам (УСО)";
		СтраницаСчет2001.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КонецЕсли;
	
	СтраницаВосстановлениеНДС = Элементы.Найти("СтраницаУСОERP_ВосстановлениеНДС");
	Если СтраницаВосстановлениеНДС = Неопределено Тогда
		СтраницаВосстановлениеНДС = Элементы.Добавить("СтраницаУСОERP_ВосстановлениеНДС", Тип("ГруппаФормы"), Элементы.ГруппаСтраницы);
		СтраницаВосстановлениеНДС.Вид = ВидГруппыФормы.Страница;
		СтраницаВосстановлениеНДС.Заголовок = "Восстановление НДС (УСО)";
		СтраницаВосстановлениеНДС.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КонецЕсли; 
	
	//построение и заполнение дерева распределения НДС
	РаспределениеНДС_ДополнитьФормуРаспределениемНДС(Форма, Элементы, Объект, СтраницаСчет2001);
	
	//построение и заполнение дерева восстановления НДС
	РаспределениеНДС_ДополнитьФормуВосстановлениемНДС(Форма, Элементы, Объект, СтраницаВосстановлениеНДС);
	
	РаспределениеНДС_ВидимостьДопЭлементов(Форма);
	
КонецПроцедуры

Процедура РаспределениеНДС_ВидимостьДопЭлементов(Форма) Экспорт 
	
	ВидимостьЭлемента = УСОERP_ЗащищенныеФункцииСервер.ПолучитьУчетнуюПолитикуПоФЗ214(Форма.Объект.Организация,Форма.Объект.Дата).ИспользоватьФЗ214;
	
	Элемент = Форма.Элементы.Найти("СтраницаУСОERP_ВосстановлениеНДС");
	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элемент.Видимость = ВидимостьЭлемента;	
	
	Элемент = Форма.Элементы.Найти("СтраницаУСОERP_РаспределениеНДС");
	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элемент.Видимость = ВидимостьЭлемента;	
	
КонецПроцедуры

Процедура РаспределениеНДС_ПередЗаписьюНаСервере(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	////заполнение табличной части распределения НДС
	УСОERP_РаспределениеНДС = ТекущийОбъект.УСОERP_РаспределениеНДС;
	УСОERP_РаспределениеНДС.Очистить();
	
	ДеревоЗначений = Форма.реквизитФормыВЗначение("УСОERP_ДеревоРаспределенияСчета2001");
	Для Каждого СтрСчет Из ДеревоЗначений.Строки Цикл
		Для Каждого СтрНаправление Из СтрСчет.Строки Цикл
			Для Каждого СтрБаза Из СтрНаправление.Строки Цикл
				Если  СтрБаза.Строки.Количество() = 0 Тогда
					НоваяСтрока = УСОERP_РаспределениеНДС.добавить();
					ЗаполнитьЗначенияСвойств( НоваяСтрока, СтрБаза);
				Иначе
					Для Каждого СтрНДС Из СтрБаза.Строки Цикл
						НоваяСтрока = УСОERP_РаспределениеНДС.добавить();
						ЗаполнитьЗначенияСвойств( НоваяСтрока, СтрНДС);
					КонецЦикла;
				Конецесли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	////заполнение табличной части восстановления НДС
	УСОERP_ВосстановлениеНДС = ТекущийОбъект.УСОERP_ВосстановлениеНДС;
	УСОERP_ВосстановлениеНДС.Очистить();
	
	ДеревоЗначений = Форма.реквизитФормыВЗначение("УСОERP_ДеревоВосстановленияНДС");
	Для Каждого Стр0 Из ДеревоЗначений.Строки Цикл
		Для Каждого СтрДок Из Стр0.Строки Цикл
			Для Каждого СтрНДС Из СтрДок.Строки Цикл
				Для Каждого СтрСтатья Из СтрНДС.Строки Цикл
					НоваяСтрока = УСОERP_ВосстановлениеНДС.добавить();
					ЗаполнитьЗначенияСвойств( НоваяСтрока, СтрСтатья);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;		
	КонецЦикла; 
	
КонецПроцедуры

Процедура РаспределениеНДС_ДополнитьФормуРаспределениемНДС(Форма, Элементы, Объект, СтраницаСчет2001)
	
	ДеревоЗначений = Новый ДеревоЗначений;
	
	ДеревоЗначений.Колонки.Добавить("СчетУчета", Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"), "Счет учета");  	
	ДеревоЗначений.Колонки.Добавить("ЭтоСчетУчета", Новый ОписаниеТипов("Булево"), );  	
	
	МассивТиповДокРаспределения = Метаданные.Документы.РаспределениеНДС.ТабличныеЧасти.УСОERP_РаспределениеНДС.Реквизиты.ДокументПоступленияРасходов.Тип.Типы();
	ДеревоЗначений.Колонки.Добавить("ДокументПоступленияРасходов", Новый ОписаниеТипов(МассивТиповДокРаспределения), "Док-т пост-я расходов");  	
	ДеревоЗначений.Колонки.Добавить("АналитикаУчетаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиУчетаНоменклатуры"), "Аналитика учета номенклатуры");
	
	ДеревоЗначений.Колонки.Добавить("НаправлениеДеятельности", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"), "Направление деятельности");
	ДеревоЗначений.Колонки.Добавить("БазаРаспределения", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"), "База распр-я");
	ДеревоЗначений.Колонки.Добавить("СтатьяРасходов", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.СтатьиРасходов"), "Статья расходов");
	ДеревоЗначений.Колонки.Добавить("ЭтоСтатья", Новый ОписаниеТипов("Булево"), );
	
	МассивТипов = Новый Массив;               
	МассивТипов.Добавить(Тип("СправочникСсылка.НаправленияДеятельности")); 
	МассивТипов.Добавить(Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов")); 
	ДеревоЗначений.Колонки.Добавить("СоставнаяКолонкаДанных", Новый ОписаниеТипов(МассивТипов), "Напр-е деят-ти/ База распр-я/ Статья расходов");
	
	ДеревоЗначений.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "Сумма НДС");
	
	ДеревоЗначений.Колонки.Добавить("ПараметрРаспределения", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,3)), "Парам-р распр-я");
	ДеревоЗначений.Колонки.Добавить("ПроцентРаспределения", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(6,2)), "%");
	ДеревоЗначений.Колонки.Добавить("ПараметрОблагаемыйНДС", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "Пар-р, облагаемый НДС");
	ДеревоЗначений.Колонки.Добавить("ПараметрНеОблагаемыйНДС", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "Пар-р, не облагаемый НДС");
	ДеревоЗначений.Колонки.Добавить("СуммаОблагаемаяНДС", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "НДС(облагаемая деят-ть)");
	ДеревоЗначений.Колонки.Добавить("СуммаНеоблагаемаяНДС", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "НДС (не облагаемая деят-ть)");
	
	ДеревоЗначений.Колонки.Добавить("СуммаНДСУпр", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "Сумма НДС (УУ)");
	ДеревоЗначений.Колонки.Добавить("СуммаОблагаемаяНДСУпр", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "НДС(облагаемая деят-ть) (УУ)");
	ДеревоЗначений.Колонки.Добавить("СуммаНеоблагаемаяНДСУпр", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "НДС (не облагаемая деят-ть) (УУ)");
	
	ДеревоЗначений.Колонки.Добавить("ЭтоБаза", Новый ОписаниеТипов("Булево"));
	ДеревоЗначений.Колонки.Добавить("ТрехлетнийНДС", Новый ОписаниеТипов("Булево"));
	
	УдаляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты = Новый Массив;
	
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("УСОERP_ДеревоРаспределенияСчета2001", Новый ОписаниеТипов("ДеревоЗначений"), , "УСОERP_ДеревоРаспределенияСчета2001", Истина));
	Для Каждого Колонка Из ДеревоЗначений.Колонки Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "УСОERP_ДеревоРаспределенияСчета2001" , Колонка.Заголовок, Истина));
	КонецЦикла;
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты,); 
	
	Таблица = Элементы.Найти("УСОERP_ДеревоРаспределенияСчета2001");
	Если Таблица = Неопределено Тогда
		
		Таблица = Элементы.Добавить("УСОERP_ДеревоРаспределенияСчета2001", Тип("ТаблицаФормы"), СтраницаСчет2001);
		Таблица.ПутьКДанным = "УСОERP_ДеревоРаспределенияСчета2001";
		Таблица.Отображение = ОтображениеТаблицы.Дерево;
		Таблица.ИзменятьСоставСтрок = Ложь;
		
	КонецЕсли;
	
	Для Каждого Колонка Из ДеревоЗначений.Колонки Цикл
		
		Если Колонка.Имя = "ЭтоБаза"
			ИЛИ Колонка.Имя = "ЭтоСчетУчета"
			ИЛИ Колонка.Имя = "НаправлениеДеятельности"
			ИЛИ Колонка.Имя = "БазаРаспределения" 
			ИЛИ Колонка.Имя = "ЭтоСтатья"
			ИЛИ Колонка.Имя = "СтатьяРасходов" 
			ИЛИ Колонка.Имя = "ТрехлетнийНДС"
			ИЛИ Колонка.Имя = "АналитикаУчетаНоменклатуры"  Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		НовоеПоле = Элементы.Добавить("УСОERP_ДеревоРаспределенияСчета2001" + Колонка.Имя, Тип("ПолеФормы"), Таблица);
		НовоеПоле.Вид = ВидПоляФормы.ПолеВвода;
		НовоеПоле.ПутьКДанным = "УСОERP_ДеревоРаспределенияСчета2001." + Колонка.Имя; 
		
		Если Колонка.Имя = "СчетУчета"
			ИЛИ Колонка.Имя = "ДокументПоступленияРасходов" 
			ИЛИ Колонка.Имя = "СоставнаяКолонкаДанных" Тогда
			НовоеПоле.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
			НовоеПоле.РастягиватьПоГоризонтали = Ложь;
			
		КонецЕсли;
		
		Если Колонка.Имя = "СчетУчета" Тогда
			НовоеПоле.Ширина = 11;
		КонецЕсли;
		
	КонецЦикла;
	
	//Команды
	//
	КомандаЗаполнить = Форма.Команды.Добавить("УСОERP_РаспределениеНДС_Заполнить2001");
	КомандаЗаполнить.Заголовок = "Заполнить";
	КомандаЗаполнить.Действие = "Подключаемый_ВыполнитьПереопределяемуюКоманду";
	КомандаЗаполнить.ИзменяетСохраняемыеДанные = истина;  	
	КнопкаЗаполнить = Элементы.Добавить("УСОERP_Заполнить2001", Тип("КнопкаФормы"), Таблица.КоманднаяПанель);
	КнопкаЗаполнить.ИмяКоманды = "УСОERP_РаспределениеНДС_Заполнить2001";  		
	
	//УсловноеОформление
	УсловноеОформление = Форма.УсловноеОформление;	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.УСОERP_ДеревоРаспределенияСчета2001ПроцентРаспределения.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("УСОERP_ДеревоРаспределенияСчета2001.ЭтоБаза");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;  	
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "-");
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.УСОERP_ДеревоРаспределенияСчета2001.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("УСОERP_ДеревоРаспределенияСчета2001.ЭтоСчетУчета");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;  
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.УСОERP_ДеревоРаспределенияСчета2001СчетУчета.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("УСОERP_ДеревоРаспределенияСчета2001.ЭтоСчетУчета");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;  
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);  
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.УСОERP_ДеревоРаспределенияСчета2001.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("УСОERP_ДеревоРаспределенияСчета2001.ЭтоСтатья");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина; 
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.СерыйЦветТекста1);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.УСОERP_ДеревоРаспределенияСчета2001.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("УСОERP_ДеревоРаспределенияСчета2001.ЭтоСчетУчета");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина; 
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаГруппировкиОтчета1);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.УСОERP_ДеревоРаспределенияСчета2001.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("УСОERP_ДеревоРаспределенияСчета2001.ТрехлетнийНДС");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина; 
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный); 	
	
	//прочитать данные и заполнить дерево
	Если Не ЗначениеЗаполнено(Форма.Объект.Ссылка) тогда
		Возврат;
	КонецЕсли;
	
	ДеревоЗначений = Форма.РеквизитФормыВЗначение("УСОERP_ДеревоРаспределенияСчета2001");
	ДеревоЗначений.Строки.Очистить();
	
	ТаблицаРаспределения = Форма.Объект.УСОERP_РаспределениеНДС.Выгрузить();
	
	ТаблицаСчетов = ТаблицаРаспределения.Скопировать();
	ТаблицаСчетов.Свернуть("СчетУчета");
	
	ТЗ_ВерхнийУровень = ТаблицаРаспределения.Скопировать(); 	
	ТЗ_ВерхнийУровень.Свернуть("СчетУчета, НаправлениеДеятельности, ДокументПоступленияРасходов");
	
	МассивСчетовТрехлетнегоНДС = Новый Массив;
	МассивСчетовТрехлетнегоНДС.Добавить(Справочники.УСОERP_ПредопределенныеЭлементы.СчетУчетаОбъектовНедвижимости.Значение);	
	
	Для Каждого СтрСчет Из ТаблицаСчетов Цикл
		СтрокаДереваСчет = ДеревоЗначений.Строки.Добавить();
		ЗаполнитьЗначенияСвойств( СтрокаДереваСчет, СтрСчет);
		
		СтрокаДереваСчет.ЭтоСчетУчета = Истина;
		
		ТабВерхнийУровень = ТЗ_ВерхнийУровень.Скопировать(Новый Структура("СчетУчета", СтрСчет.СчетУчета));
		
		Для Каждого Стр0 Из ТабВерхнийУровень Цикл
			СтрокаДерева0 = СтрокаДереваСчет.Строки.Добавить();
			ЗаполнитьЗначенияСвойств( СтрокаДерева0, Стр0);
			СтрокаДерева0.СоставнаяКолонкаДанных = СтрокаДерева0.НаправлениеДеятельности;
			Если УСОERP_ЗащищенныеФункцииСервер.СчетФактураБольшеТрехЛет(Объект.Дата, Стр0.ДокументПоступленияРасходов.Дата)
				И НЕ МассивСчетовТрехлетнегоНДС.Найти(Стр0.СчетУчета) = Неопределено Тогда
				СтрокаДерева0.ТрехлетнийНДС = Истина;
			КонецЕсли;
			
			ТабПодчиненных = ТаблицаРаспределения.Скопировать(Новый Структура("СчетУчета, НаправлениеДеятельности, ДокументПоступленияРасходов", СтрокаДереваСчет.СчетУчета, Стр0.НаправлениеДеятельности, Стр0.ДокументПоступленияРасходов));
			
			Таб_СрезНаправлений = ТабПодчиненных.Скопировать();
			Таб_СрезНаправлений.Свернуть("НаправлениеДеятельности, БазаРаспределения");
			
			Для Каждого СтрСрез Из  Таб_СрезНаправлений Цикл
				
				Если ЗначениеЗаполнено(СтрСрез.БазаРаспределения) Тогда
					СтрокаДереваБаза = СтрокаДерева0.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаДереваБаза, СтрСрез);
					СтрокаДереваБаза.СоставнаяКолонкаДанных = СтрокаДереваБаза.БазаРаспределения;
					СтрокаДереваБаза.ЭтоБаза = Истина;
				Иначе
					СтрокаДереваБаза = СтрокаДерева0;
				КонецЕсли;
				
				МассивПодчиненных = ТаблицаРаспределения.НайтиСтроки(Новый Структура("СчетУчета, НаправлениеДеятельности, ДокументПоступленияРасходов, БазаРаспределения", СтрокаДереваСчет.СчетУчета, Стр0.НаправлениеДеятельности, Стр0.ДокументПоступленияРасходов, СтрСрез.БазаРаспределения));
				
				Для Каждого СрезСтатьи Из МассивПодчиненных Цикл
					
					СтрокаСтатья = СтрокаДереваБаза.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаСтатья, СрезСтатьи);
					СтрокаСтатья.ЭтоСтатья = Истина;
					СтрокаСтатья.СоставнаяКолонкаДанных = СрезСтатьи.СтатьяРасходов; 					
					
					СтрокаДереваБаза.СуммаНДС 				= СтрокаДереваБаза.СуммаНДС + СрезСтатьи.СуммаНДС;
					СтрокаДереваБаза.СуммаОблагаемаяНДС 	= СтрокаДереваБаза.СуммаОблагаемаяНДС + СрезСтатьи.СуммаОблагаемаяНДС;
					СтрокаДереваБаза.СуммаНеоблагаемаяНДС 	= СтрокаДереваБаза.СуммаНеоблагаемаяНДС + СрезСтатьи.СуммаНеоблагаемаяНДС;
					
					СтрокаДереваБаза.СуммаНДСУпр 				= СтрокаДереваБаза.СуммаНДСУпр + СрезСтатьи.СуммаНДСУпр;
					СтрокаДереваБаза.СуммаОблагаемаяНДСУпр 	    = СтрокаДереваБаза.СуммаОблагаемаяНДСУпр + СрезСтатьи.СуммаОблагаемаяНДСУпр;
					СтрокаДереваБаза.СуммаНеоблагаемаяНДСУпр 	= СтрокаДереваБаза.СуммаНеоблагаемаяНДСУпр + СрезСтатьи.СуммаНеоблагаемаяНДСУпр;
					
					СтрокаДереваБаза.ПараметрОблагаемыйНДС 		= СтрокаСтатья.ПараметрОблагаемыйНДС;
					СтрокаДереваБаза.ПараметрНеОблагаемыйНДС 	= СтрокаСтатья.ПараметрНеОблагаемыйНДС; 
					
					Если СтрокаДереваБаза.ЭтоБаза Тогда
						СтрокаДереваБаза.ПараметрРаспределения 		= СтрокаСтатья.ПараметрРаспределения;
						СтрокаДереваБаза.ПроцентРаспределения 		= СтрокаСтатья.ПроцентРаспределения;
						
						СтрокаДереваБаза.Родитель.ПроцентРаспределения 	= СтрокаДереваБаза.Родитель.ПроцентРаспределения + СрезСтатьи.ПроцентРаспределения;
						СтрокаДереваБаза.Родитель.СуммаНДС 				= СтрокаДереваБаза.Родитель.СуммаНДС + СрезСтатьи.СуммаНДС;
						СтрокаДереваБаза.Родитель.СуммаОблагаемаяНДС 	= СтрокаДереваБаза.Родитель.СуммаОблагаемаяНДС + СрезСтатьи.СуммаОблагаемаяНДС;
						СтрокаДереваБаза.Родитель.СуммаНеоблагаемаяНДС 	= СтрокаДереваБаза.Родитель.СуммаНеоблагаемаяНДС + СрезСтатьи.СуммаНеоблагаемаяНДС;
						
						СтрокаДереваБаза.Родитель.СуммаНДСУпр 				= СтрокаДереваБаза.Родитель.СуммаНДСУпр + СрезСтатьи.СуммаНДСУпр;
						СтрокаДереваБаза.Родитель.СуммаОблагаемаяНДСУпр 	= СтрокаДереваБаза.Родитель.СуммаОблагаемаяНДСУпр + СрезСтатьи.СуммаОблагаемаяНДСУпр;
						СтрокаДереваБаза.Родитель.СуммаНеоблагаемаяНДСУпр 	= СтрокаДереваБаза.Родитель.СуммаНеоблагаемаяНДСУпр + СрезСтатьи.СуммаНеоблагаемаяНДСУпр;
						
					КонецЕсли;					
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
		СтрокаДереваСчет.СуммаНДС 				= СтрокаДереваСчет.Строки.Итог("СуммаНДС");
		СтрокаДереваСчет.СуммаОблагаемаяНДС 	= СтрокаДереваСчет.Строки.Итог("СуммаОблагаемаяНДС");
		СтрокаДереваСчет.СуммаНеоблагаемаяНДС 	= СтрокаДереваСчет.Строки.Итог("СуммаНеоблагаемаяНДС");
		
		СтрокаДереваСчет.СуммаНДСУпр 				= СтрокаДереваСчет.Строки.Итог("СуммаНДСУпр");
		СтрокаДереваСчет.СуммаОблагаемаяНДСУпр 	    = СтрокаДереваСчет.Строки.Итог("СуммаОблагаемаяНДСУпр");
		СтрокаДереваСчет.СуммаНеоблагаемаяНДСУпр 	= СтрокаДереваСчет.Строки.Итог("СуммаНеоблагаемаяНДСУпр");
		
	КонецЦикла; 
	
	Форма.ЗначениеВреквизитФормы(ДеревоЗначений, "УСОERP_ДеревоРаспределенияСчета2001");
	
КонецПроцедуры

Процедура РаспределениеНДС_ДополнитьФормуВосстановлениемНДС(Форма, Элементы, Объект, СтраницаВосстановлениеНДС)
	
	ДеревоЗначений = Новый ДеревоЗначений;
	
	ДеревоЗначений.Колонки.Добавить("СчетУчета", 	Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"), "Счет учета");  	
	ДеревоЗначений.Колонки.Добавить("ЭтоСчетУчета", Новый ОписаниеТипов("Булево"), );  	
	
	МассивТиповДокРаспределения = Метаданные.Документы.РаспределениеНДС.ТабличныеЧасти.УСОERP_РаспределениеНДС.Реквизиты.ДокументПоступленияРасходов.Тип.Типы();
	МассивТиповСК = Метаданные.Документы.РаспределениеНДС.ТабличныеЧасти.УСОERP_РаспределениеНДС.Реквизиты.ДокументПоступленияРасходов.Тип.Типы();	
	МассивТиповСК.Добавить(Тип("СправочникСсылка.НаправленияДеятельности")); 	
	МассивТиповСК.Добавить(Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов")); 	
	
	ДеревоЗначений.Колонки.Добавить("СоставнаяКолонкаДанных", Новый ОписаниеТипов(МассивТиповСК), "Направление деят-ти/Док-т постп-я расходов/ Статья расходов");
	
	ДеревоЗначений.Колонки.Добавить("НаправлениеДеятельности", 	Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"), "Направление деятельности");
	ДеревоЗначений.Колонки.Добавить("БазаРаспределения", 		Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"), "База распределения");
	
	ДеревоЗначений.Колонки.Добавить("ЭтоНД", Новый ОписаниеТипов("Булево")); 
	ДеревоЗначений.Колонки.Добавить("РаспределяемоеНаправление", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"), "НРаспределяемое направление");
	ДеревоЗначений.Колонки.Добавить("ДокументПоступленияРасходов", Новый ОписаниеТипов(МассивТиповДокРаспределения), "Док-т пост-я расходов"); 	
	
	ДеревоЗначений.Колонки.Добавить("СтатьяРасходов", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.СтатьиРасходов"));
	ДеревоЗначений.Колонки.Добавить("ЭтоСтатья", Новый ОписаниеТипов("Булево")); 
	
	ДеревоЗначений.Колонки.Добавить("ОбъектЭксплуатации", Новый ОписаниеТипов("СправочникСсылка.ОбъектыЭксплуатации"));
	
	ДеревоЗначений.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "Сумма НДС");
	
	ДеревоЗначений.Колонки.Добавить("ПараметрОблагаемыйНДС", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "облагаемый НДС");
	ДеревоЗначений.Колонки.Добавить("ПараметрНеОблагаемыйНДС", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "не облагаемый НДС");
	
	ДеревоЗначений.Колонки.Добавить("СуммаОблагаемаяНДС_ДанныеРегистра", 	Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "данным регистра (обл. деят.)");	
	ДеревоЗначений.Колонки.Добавить("СуммаНеоблагаемаяНДС_ДанныеРегистра", 	Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "данным регистра (необл. деят.)");
	
	ДеревоЗначений.Колонки.Добавить("СуммаОблагаемаяНДС",	Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "облагаемой деят-ти");
	ДеревоЗначений.Колонки.Добавить("СуммаНеоблагаемаяНДС",	Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "необлагаемой деят-ти");
	
	ДеревоЗначений.Колонки.Добавить("СуммаНДСУпр", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "Сумма НДС (УУ)");
		
	ДеревоЗначений.Колонки.Добавить("СуммаОблагаемаяНДСУпр_ДанныеРегистра", 	Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "данным регистра (обл. деят.) (УУ)");	
	ДеревоЗначений.Колонки.Добавить("СуммаНеоблагаемаяНДСУпр_ДанныеРегистра", 	Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "данным регистра (необл. деят.) (УУ)");
	
	ДеревоЗначений.Колонки.Добавить("СуммаОблагаемаяНДСУпр",	Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "облагаемой деят-ти (УУ)");
	ДеревоЗначений.Колонки.Добавить("СуммаНеоблагаемаяНДСУпр",	Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)), "необлагаемой деят-ти (УУ)");
	
	
	УдаляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты = Новый Массив;
	
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("УСОERP_ДеревоВосстановленияНДС", Новый ОписаниеТипов("ДеревоЗначений"), , "УСОERP_ДеревоВосстановленияНДС", Истина));
	Для Каждого Колонка Из ДеревоЗначений.Колонки Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "УСОERP_ДеревоВосстановленияНДС" , Колонка.Заголовок, Истина));
	КонецЦикла;
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты,);
	
	//
	Таблица = Элементы.Найти("УСОERP_ДеревоВосстановленияНДС");
	Если Таблица = Неопределено Тогда
		Таблица = Элементы.Добавить("УСОERP_ДеревоВосстановленияНДС", Тип("ТаблицаФормы"), СтраницаВосстановлениеНДС);
		Таблица.ПутьКДанным = "УСОERP_ДеревоВосстановленияНДС";
		Таблица.Отображение = ОтображениеТаблицы.Дерево;
		Таблица.ИзменятьСоставСтрок = Ложь;
	КонецЕсли;
	//
	
	Для Каждого Колонка Из ДеревоЗначений.Колонки Цикл
		Если Колонка.Имя = "ЭтоНД"
			ИЛИ Колонка.Имя = "ЭтоСчетУчета"
			ИЛИ Колонка.Имя = "НаправлениеДеятельности"
			ИЛИ Колонка.Имя = "ДокументПоступленияРасходов" 
			ИЛИ Колонка.Имя = "СтатьяРасходов"
			ИЛИ Колонка.Имя = "ЭтоСтатья" 
			ИЛИ Колонка.Имя = "РаспределяемоеНаправление" 
			ИЛИ Колонка.Имя = "ОбъектЭксплуатации" Тогда
			Продолжить;
		КонецЕсли;
		
		НовоеПоле = Элементы.Добавить("УСОERP_ДеревоВосстановленияНДС" + Колонка.Имя, Тип("ПолеФормы"), Таблица);
		НовоеПоле.Вид = ВидПоляФормы.ПолеВвода;
		НовоеПоле.ПутьКДанным = "УСОERP_ДеревоВосстановленияНДС." + Колонка.Имя; 
		Если Колонка.Имя = "СоставнаяКолонкаДанных"
			ИЛИ Колонка.Имя = "СчетУчета" Тогда
			НовоеПоле.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
			//НовоеПоле.РастягиватьПоГоризонтали = Ложь;
		КонецЕсли;
		
		Если Колонка.Имя = "СчетУчета" Тогда
			НовоеПоле.Ширина = 11;
		КонецЕсли;
		
	КонецЦикла;
	
	ГруппаПараметрНДС = Элементы.Добавить("УСОERP_ДеревоВосстановленияНДСГруппаПараметр", Тип("ГруппаФормы"), Таблица);
	ГруппаПараметрНДС.Вид = ВидГруппыФормы.ГруппаКолонок;
	ГруппаПараметрНДС.Группировка = ГруппировкаКолонок.Горизонтальная;
	ГруппаПараметрНДС.ОтображатьВШапке = Истина;
