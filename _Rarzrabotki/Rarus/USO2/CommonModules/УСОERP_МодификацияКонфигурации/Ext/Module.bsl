#Область ПрограммныйИнтерфейс

#Область ЗаполнениеОбработчиковФормы

// Переопределяемая процедура, вызываемая из одноименного обработчика события формы.
//
// Параметры:
// 	Форма - форма, из обработчика события которой происходит вызов процедуры.
//	см. справочную информацию по событиям управляемой формы.
//
//Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
//	//Процедура находится в УСОERP_ЗащищенныеФункцииСервер
//КонецПроцедуры

// Обработчик события возникающего на сервере при создании формы.
//
// Параметры:
//  Форма                - УправляемаяФорма - Форма, в которой возникло событие.
//  Отказ                - Булево           - Признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	УСОERP_ОбработкаПереопределяемыхПроцедурФункцийКлиентСервер.СоздатьКнопкуФормы(Форма);
	
	Если Форма.ИмяФормы = "Документ.ПриобретениеТоваровУслуг.Форма.ФормаДокумента" Тогда
		УСОERP_УправлениеСтроительнымПроизводством.ПоступлениеТоваровУслугФормаДокументаПриСозданииНаСервере(Форма);
	ИначеЕсли Форма.ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента" Тогда
		УСОERP_УправлениеСтроительнымПроизводством.РеализацияТоваровУслугФормаДокументаПриСозданииНаСервере(Форма);
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Документ.АвансовыйОтчет.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.АктВыполненныхРабот.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ВзаимозачетЗадолженности.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ВозвратТоваровОтКлиента.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ЗаказКлиента.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ЗаказПоставщику.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ЗаявкаНаРасходованиеДенежныхСредств.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ОтчетДавальцу.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ОтчетПереработчика.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ПоступлениеБезналичныхДенежныхСредств.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ПриходныйКассовыйОрдер.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.РасходныйКассовыйОрдер.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.РеализацияУслугПрочихАктивов.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.СписаниеБезналичныхДенежныхСредств.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.СписаниеЗадолженности.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ПриобретениеТоваровУслуг.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.УСОERP_АктПриемкиРабот.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.УСОERP_РеализацияСтроительныхРабот.Форма.ФормаДокумента" Тогда
		
		НоваяГруппаФормы						= Форма.Элементы.Добавить("ГруппаРаспределениеГрафикаДоговоров", Тип("ГруппаФормы"));
		НоваяГруппаФормы.Вид 					= ВидГруппыФормы.ОбычнаяГруппа;
		НоваяГруппаФормы.Группировка			= ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		НоваяГруппаФормы.Отображение			= ОтображениеОбычнойГруппы.Нет;
		НоваяГруппаФормы.Заголовок 				= "Группа распределение графика договоров";
		НоваяГруппаФормы.ОтображатьЗаголовок 	= Ложь;
		
		МассивРеквизитов 	= Новый Массив;
		
		МассивОписанияТипов = Новый Массив;
		МассивОписанияТипов.Добавить(Тип("ДокументСсылка.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров"));
		ОписаниеТиповСсылка = Новый ОписаниеТипов(МассивОписанияТипов);
		
		МассивРеквизитов.Добавить(Новый РеквизитФормы("ДокументРаспределение", ОписаниеТиповСсылка));
		
		МассивОписанияТипов.Очистить();
		МассивОписанияТипов.Добавить(Тип("Строка"));
		ОписаниеТиповСтрока = Новый ОписаниеТипов(МассивОписанияТипов);
		
		МассивРеквизитов.Добавить(Новый РеквизитФормы("ТекстРаспределениеПоАналитикеГрафикаДоговоров", ОписаниеТиповСтрока));
		
		Форма.ИзменитьРеквизиты(МассивРеквизитов);
		
		НовыйЭлементСсылка						= Форма.Элементы.Добавить("ДокументРаспределение", Тип("ПолеФормы"), НоваяГруппаФормы);
		НовыйЭлементСсылка.Вид					= ВидПоляФормы.ПолеВвода;
		НовыйЭлементСсылка.Видимость			= Ложь;
		НовыйЭлементСсылка.ПутьКДанным			= "ДокументРаспределение";
		
		НовыйЭлементНадпись						= Форма.Элементы.Добавить("РаспределениеПоАналитикеГрафикаДоговоров", Тип("ДекорацияФормы"), НоваяГруппаФормы);
		НовыйЭлементНадпись.Вид					= ВидДекорацииФормы.Надпись;
		НовыйЭлементНадпись.Гиперссылка			= Истина;
		НовыйЭлементНадпись.УстановитьДействие("Нажатие","Подключаемый_ВыполнитьПереопределяемуюКоманду"); 	
		
		Форма.ДокументРаспределение = Документы.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.НайтиПоРеквизиту("ДокументОснование", Форма.Объект.Ссылка);
		
		Если ЗначениеЗаполнено(Форма.ДокументРаспределение) Тогда
			
			Форма.ТекстРаспределениеПоАналитикеГрафикаДоговоров = Строка(Форма.ДокументРаспределение);
			
		Иначе
			
			Если Форма.ИмяФормы = "Документ.ВзаимозачетЗадолженности.Форма.ФормаДокумента"
				ИЛИ Форма.ИмяФормы = "Документ.ЗаказКлиента.Форма.ФормаДокумента" 
				ИЛИ Форма.ИмяФормы = "Документ.ЗаказПоставщику.Форма.ФормаДокумента" 
				ИЛИ Форма.ИмяФормы = "Документ.ЗаявкаНаРасходованиеДенежныхСредств.Форма.ФормаДокумента" 
				ИЛИ Форма.ИмяФормы = "Документ.ОтчетДавальцу.Форма.ФормаДокумента" 
				ИЛИ Форма.ИмяФормы = "Документ.ОтчетПереработчика.Форма.ФормаДокумента" 
				Тогда
				НовыйЭлементНадпись.Видимость = Ложь;
			КонецЕсли;
			
			Форма.ТекстРаспределениеПоАналитикеГрафикаДоговоров = "Ввести документ-распределение графика договоров";
			
		КонецЕсли;
		
		НовыйЭлементНадпись.Заголовок =  Форма.ТекстРаспределениеПоАналитикеГрафикаДоговоров;
		
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Документ.ВыработкаСотрудников.Форма.ФормаДокумента" Тогда
		
		НовыйЭлемент 				= Форма.Элементы.Вставить("ВидыРаботРабота", Тип("ПолеФормы"), Форма.Элементы.ВидыРабот, Форма.Элементы.ВидыРаботВидРабот);
		НовыйЭлемент.Вид 			= ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным 	= "Объект.ВидыРабот.УСОERP_Работа";
		
		НовыйЭлемент 				= Форма.Элементы.Вставить("БлокУСП", Тип("ПолеФормы"), Форма.Элементы.ГруппаШапкаЛево, Неопределено);
		НовыйЭлемент.Вид 			= ВидПоляФормы.ПолеФлажка;
		НовыйЭлемент.ПутьКДанным 	= "Объект.УСОERP_БлокУСП";
		НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ВыполнитьПереопределяемуюКоманду");
		
		НовыйЭлемент 				= Форма.Элементы.Вставить("ВидыРаботРесурс", Тип("ПолеФормы"), Форма.Элементы.ВидыРабот, Форма.Элементы.ВидыРаботВидРабот);
		НовыйЭлемент.Вид 			= ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным 	= "Объект.ВидыРабот.УСОERP_Ресурс";
		
		НовыйЭлемент 				= Форма.Элементы.Вставить("СотрудникиДолжность", Тип("ПолеФормы"), Форма.Элементы.Работники, Форма.Элементы.СотрудникиКТУ);
		НовыйЭлемент.Вид 			= ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным 	= "Объект.Работники.УСОERP_ТипРесурса";
		
		Форма.Элементы.Бригада.Видимость 		= НЕ Форма.Объект.УСОERP_БлокУСП;
		Форма.Элементы.Бригада.Доступность	    = НЕ Форма.Объект.УСОERP_БлокУСП; 
		
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Документ.ЗаказПоставщику.Форма.ФормаДокумента" Тогда
		УСОERP_МатериальноТехническоеОбеспечение.ЗаказПоставщикуФормаДокументаПриСозданииНаСервере(Форма);
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Справочник.ОбъектыЭксплуатации.Форма.ФормаЭлемента" Тогда
		
		НоваяГруппаФормы						= Форма.Элементы.Добавить("ГруппаУСОERP_ОбъектСтроительства", Тип("ГруппаФормы"), Форма.Элементы.ГруппаОсновныеРеквизиты);
		НоваяГруппаФормы.Вид 					= ВидГруппыФормы.ОбычнаяГруппа;
		НоваяГруппаФормы.Группировка			= ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		НоваяГруппаФормы.Отображение			= ОтображениеОбычнойГруппы.Нет;
		НоваяГруппаФормы.Заголовок 				= "Объект строительства";
		НоваяГруппаФормы.ОтображатьЗаголовок 	= Ложь;
		
		НовыйЭлемент 				= Форма.Элементы.Вставить("УСОERP_ПризнакОбъектаСтроительства", Тип("ПолеФормы"), НоваяГруппаФормы);
		НовыйЭлемент.Вид 			= ВидПоляФормы.ПолеФлажка;
		НовыйЭлемент.ПутьКДанным 	= "Объект.УСОERP_ПризнакОбъектаСтроительства";
		
		НовыйЭлемент 				= Форма.Элементы.Вставить("УСОERP_ДолевоеСтроительство", Тип("ПолеФормы"), НоваяГруппаФормы);
		НовыйЭлемент.Вид 			= ВидПоляФормы.ПолеФлажка;
		НовыйЭлемент.ПутьКДанным 	= "Объект.УСОERP_ДолевоеСтроительство";
		
		НовыйЭлемент 				= Форма.Элементы.Вставить("УСОERP_СпособСтроительства", Тип("ПолеФормы"), НоваяГруппаФормы);
		НовыйЭлемент.Вид 			= ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным 	= "Объект.УСОERP_СпособСтроительства";
		
		НовыйКоманда = Форма.Команды.Добавить("УСОERP_ОбъектЭксплуатации_УстановитьСтатусПредподготовка");
		НовыйКоманда.Действие = "Подключаемый_ВыполнитьПереопределяемуюКоманду";
		
		НовыйЭлемент                 = Форма.Элементы.Добавить("УСОERP_ОбъектЭксплуатации_УстановитьСтатусПредподготовка",Тип("КнопкаФормы"),Форма.Элементы.ПодменюУстановитьСтатус);
		НовыйЭлемент.ИмяКоманды = НовыйКоманда.Имя;
		НовыйЭлемент.Заголовок = "Предподготовка (УСО)";
		
		НовыйЭлемент = Форма.Элементы.Добавить("УСОERP_ГруппаФинансовогоУчета", Тип("ПолеФормы"), Форма.Элементы.ГруппаОсновныеРеквизиты);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Объект.УСОERP_ГруппаФинансовогоУчета";
		НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
		НовыйЭлемент.Ширина = 23;
		
	КонецЕсли;
		
	Если Форма.ИмяФормы = "Справочник.ДоговорыКонтрагентов.Форма.ФормаЭлемента" Тогда
		
		Если НЕ ПолучитьФункциональнуюОпцию("УСОERP_ИспользоватьУправлениеСтроительнымПроизводством") Тогда
			Возврат;
		КонецЕсли;
		
		НоваяСтраница = Форма.Элементы.Добавить("СтраницаУСО",Тип("ГруппаФормы"),Форма.Элементы.ГруппаСтраницы);
		НоваяСтраница.Вид = ВидГруппыФормы.Страница;
		НоваяСтраница.Заголовок = "Дополнительные параметры по договору(УСО)";  		
		
		// ******   Группа формы "ГруппаДолевоеCтроительство"    ***********
		НовыйЭлемент = Форма.Элементы.Вставить("ГруппаДолевоеCтроительство",Тип("ГруппаФормы"),НоваяСтраница);
		
		НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		НовыйЭлемент.Заголовок = "Долевое строительство";
		НовыйЭлемент.Подсказка = "Долевое строительство";
		НовыйЭлемент.ОтображатьЗаголовок = Истина;
		НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
		НовыйЭлемент.ШрифтЗаголовка = Новый Шрифт(НовыйЭлемент.ШрифтЗаголовка,,,Истина);
		НовыйЭлемент.Группировка  = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		// ******   Группа формы "ГруппаДолевоеCтроительствоПереключатели"    ***********
		НовыйЭлемент = Форма.Элементы.Вставить("ГруппаДолевоеCтроительствоПереключатели",Тип("ГруппаФормы"),Форма.Элементы.ГруппаДолевоеCтроительство,Неопределено);
		НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		НовыйЭлемент.ОтображатьЗаголовок = Ложь;
		НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
		НовыйЭлемент.Группировка  = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		// ******   Группа формы "ГруппаДолевоеCтроительствоЭлементы"    ***********
		НовыйЭлемент = Форма.Элементы.Вставить("ГруппаДолевоеCтроительствоЭлементы",Тип("ГруппаФормы"),Форма.Элементы.ГруппаДолевоеCтроительство,Неопределено);
		НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		НовыйЭлемент.ОтображатьЗаголовок = Ложь;
		НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
		НовыйЭлемент.Группировка  = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		// ******   Поле формы "ДоговорДолевогоСтроительства"    ***********
		НовыйЭлемент = Форма.Элементы.Вставить("ДоговорДолевогоСтроительства",Тип("ПолеФормы"),Форма.Элементы.ГруппаДолевоеCтроительствоПереключатели,Неопределено);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
		НовыйЭлемент.ПутьКДанным = "Объект.УСОERP_ДоговорДолевогоСтроительства";
		//НовыйЭлемент.УстановитьДействие("ПриИзменении","УСОERP_ДоговорДолевогоСтроительстваПриИзменении");
		НовыйЭлемент.УстановитьДействие("ПриИзменении","Подключаемый_ВыполнитьПереопределяемуюКоманду");
		// ******   Поле формы "АгентскийДоговор"    ***********
		НовыйЭлемент = Форма.Элементы.Вставить("АгентскийДоговор",Тип("ПолеФормы"),Форма.Элементы.ГруппаДолевоеCтроительствоПереключатели,Неопределено);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
		НовыйЭлемент.ПутьКДанным = "Объект.УСОERP_АгентскийДоговор";
		//НовыйЭлемент.УстановитьДействие("ПриИзменении","УСОERP_АгентскийДоговорПриИзменении");
		НовыйЭлемент.УстановитьДействие("ПриИзменении","Подключаемый_ВыполнитьПереопределяемуюКоманду");
		// ******   Поле формы "ТипЦены"    ***********
