	#КонецОбласти 	
	
	Если Форма.ИмяФормы = "Документ.ДвижениеПродукцииИМатериалов.Форма.ФормаДокумента" Тогда
		
		ПередачаМатериаловВПроизводствоПоРасходуВСтроительстве = ПолучитьФункциональнуюОпцию("УСОERP_ПередачаМатериаловВПроизводствоПоРасходуВСтроительстве");
		
		// Формируемый по расходу материалов в строительстве документ: "Передача материалов в кладовую"
		Если ЗначениеЗаполнено(ПередачаМатериаловВПроизводствоПоРасходуВСтроительстве) 
			И ПередачаМатериаловВПроизводствоПоРасходуВСтроительстве = 2 Тогда
			
			НовоеПоле = Форма.Элементы.Вставить("УСОERP_ТоварыНазначениеОтправителя", Тип("ПолеФормы"), Форма.Элементы.Товары, Форма.Элементы.ТоварыКоличествоУпаковок);
			НовоеПоле.Вид = ВидПоляФормы.ПолеВвода;
			НовоеПоле.ПутьКДанным = "Объект.Товары.НазначениеОтправителя";			
									
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ПриСозданииНаСервере()

Процедура ПередЗаписьюНаСервере(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи) Экспорт
	
	Если Форма.ИмяФормы = "Документ.РаспределениеНДС.Форма.ФормаДокумента" Тогда
		РаспределениеНДС_ПередЗаписьюНаСервере(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи);		
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Справочник.ДоговорыКонтрагентов.Форма.ФормаЭлемента" Тогда
		ДоговорыКонтрагентов_ПроверитьЗаполнениеСправочника(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Документ.ПриобретениеТоваровУслуг.Форма.ФормаДокумента" Тогда
		
		ПоступлениеТоваровУслуг_ПроверитьЗаполнениеРаспределенияРабот(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
		
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Документ.ПриходныйОрдерНаТовары.Форма.ФормаДокумента" Тогда
		
		ПриходныйОрдерНаТовары_ПроверитьЗаполнениеРаспределенияРабот(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
		
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Документ.ЗаказПоставщику.Форма.ФормаДокумента" Тогда
		
		ЗаказПоставщику_ПроверитьЗаполнениеРаспределенияРабот(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи);	
		
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Документ.ЗаказМатериаловВПроизводство.Форма.ФормаДокумента" Тогда
		
		ЗаказМатериаловВПроизводство_ПроверитьЗаполнениеРаспределенияРабот(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи);	
		
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Справочник.ДоговорыКонтрагентов.Форма.ФормаЭлемента" Тогда
		
		Если  ПолучитьФункциональнуюОпцию("УСОERP_ИспользоватьУправлениеСтроительнымПроизводством") Тогда
			
			Если НЕ ЗначениеЗаполнено(Форма.Объект.УСОERP_ОсновнойПроект) И ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
				
				Запрос = Новый Запрос;
				
				Запрос.УстановитьПараметр("Договор",Форма.Объект.Ссылка);
				
				Запрос.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	УСОERP_ДополнительныеПараметрыПоДоговору.Ссылка КАК Ссылка
				|ИЗ
				|	Документ.УСОERP_ДополнительныеПараметрыПоДоговору КАК УСОERP_ДополнительныеПараметрыПоДоговору
				|ГДЕ
				|	УСОERP_ДополнительныеПараметрыПоДоговору.Проведен
				|	И УСОERP_ДополнительныеПараметрыПоДоговору.Договор = &Договор
				|	И УСОERP_ДополнительныеПараметрыПоДоговору.ОбъектСтроительства <> ЗНАЧЕНИЕ(Справочник.СМ_ОбъектыСтроительства.ПустаяСсылка)
				|	И УСОERP_ДополнительныеПараметрыПоДоговору.Статус = ЗНАЧЕНИЕ(Перечисление.РезультатыСогласования.Согласовано)
				|
				|УПОРЯДОЧИТЬ ПО
				|	УСОERP_ДополнительныеПараметрыПоДоговору.Дата УБЫВ";
				
				Выборка = Запрос.Выполнить().Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					ТекущийОбъект.УСОERP_ОсновнойПроект = Выборка.Ссылка.ОбъектСтроительства;
					
				КонецЦикла; 				
				
			КонецЕсли;  	
			
		КонецЕсли;
		
	КонецЕсли;
			
КонецПроцедуры

// Переопределяемая процедура, вызываемая из одноименного обработчика события формы.
//
// Параметры:
// 	Форма - форма, из обработчика события которой происходит вызов процедуры.
//	см. справочную информацию по событиям управляемой формы.
//
Процедура ПриЧтенииНаСервере(Форма, ТекущийОбъект) Экспорт
	
	Если ТипЗнч(ТекущийОбъект) = Тип("ДокументОбъект.ЗаказНаВнутреннееПотребление") тогда
		
		УСОERP_МатериальноТехническоеОбеспечение.ЗаказНаВнутреннееПотреблениеПриЧтенииНаСервере(Форма, ТекущийОбъект);
		
	КонецЕсли;  	
	
	Если ТипЗнч(ТекущийОбъект) = Тип("СправочникОбъект.ДоговорыКонтрагентов") Тогда 
		
		Если Форма.Элементы.Найти("СтраницаУСО") <> Неопределено  Тогда
			
			//Переносим наши доп.реквизиты на новую страницу
			ГруппаДополнительныеРеквизиты = Форма.Элементы.Найти("ГруппаДополнительныеРеквизиты");
			ТолькоПросмотрРеквизитов	  = ?(ГруппаДополнительныеРеквизиты = Неопределено, Ложь, ГруппаДополнительныеРеквизиты.ТолькоПросмотр);
			
			СтруктураСвойствФлажка = Новый Структура;
			СтруктураСвойствФлажка.Вставить("ПоложениеЗаголовка" , ПоложениеЗаголовкаЭлементаФормы.Право);
			СтруктураСвойствФлажка.Вставить("ТолькоПросмотр"	 , ТолькоПросмотрРеквизитов);
			
			СтруктураСвойствПоля = Новый Структура;
			СтруктураСвойствПоля.Вставить("РастягиватьПоГоризонтали" , Ложь);
			СтруктураСвойствПоля.Вставить("Ширина"					 , 65);
			СтруктураСвойствПоля.Вставить("ТолькоПросмотр"	 		 , ТолькоПросмотрРеквизитов);
			
			СоответствиеСвойств = Новый Соответствие;
			СоответствиеСвойств.Вставить(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.УСОERP_НазначениеЦелевыхСредств, СтруктураСвойствПоля);
			СоответствиеСвойств.Вставить(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.УСОERP_ДвижениеЦелевыхСредств, СтруктураСвойствПоля);
			
			Если ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеРеквизитыИСведения")  Тогда
				
				Для Каждого ЭлементСоответствия Из СоответствиеСвойств Цикл
					
					СтруктураОтбора = Новый Структура;
					СтруктураОтбора.Вставить("Свойство", ЭлементСоответствия.Ключ);
					
					НайденноеСвойство = Форма.Свойства_ОписаниеДополнительныхРеквизитов.НайтиСтроки(СтруктураОтбора);
					Если Не НайденноеСвойство.Количество() = 1 Тогда
						Продолжить; // должно быть только одно такое свойство.
					КонецЕсли;
					
					СтрокаТаблицы	= НайденноеСвойство[0];
					ЭлементСвойства	= Форма.Элементы[СтрокаТаблицы.ИмяРеквизитаЗначение];
					
					Форма.Элементы.Переместить(ЭлементСвойства, Форма.Элементы.СтраницаУСО,Форма.Элементы.УСО_Список);
					ЗаполнитьЗначенияСвойств(ЭлементСвойства, ЭлементСоответствия.Значение);
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;   	
	
КонецПроцедуры 

// Переопределяемая процедура, вызываемая из одноименного обработчика события формы.
//
// Параметры:
// 	Форма - форма, из обработчика события которой происходит вызов процедуры.
//	см. справочную информацию по событиям управляемой формы.
//
Процедура ПослеЗаписиНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи)Экспорт
	
	Если Форма.ИмяФормы = "Справочник.ДоговорыКонтрагентов.Форма.ФормаЭлемента" Тогда
		
		Если НЕ ПолучитьФункциональнуюОпцию("УСОERP_ИспользоватьУправлениеСтроительнымПроизводством") Тогда
			Возврат;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.УСО_Список, "Договор", Форма.Объект.Ссылка, ВидСравненияКомпоновкиДанных.Равно, , Истина);
		
	КонецЕсли;	
	
КонецПроцедуры 

Функция ПолучитьИдентификаторТекущейСтроки(ТекущийОбъект,ИдСтроки) Экспорт
	
	ДокОбъект = ДанныеФормыВЗначение(ТекущийОбъект,Тип("ДокументОбъект."+ТекущийОбъект.Ссылка.Метаданные().Имя));
	Строка = ДокОбъект.РасшифровкаПлатежа.Получить(ТекущийОбъект.РасшифровкаПлатежа.НайтиПоИдентификатору(ИдСтроки).НомерСтроки-1);
	
	ИдентификаторСтроки = Строка.ИдентификаторСтроки;
		
	Возврат ИдентификаторСтроки;	
	
КонецФункции 

Функция ПолучитьСтруктуруДоговораДопПараметров(Договор,ОбъектСтроительства) Экспорт 
	
	СтруктураВозврата = Новый Структура("ПоРаботам,ПоВидамРабот,НеНайден,СтатьяДвиженияДенежныхСредств,СтатьяБюджета,СтатьяБюджетаАвансовогоПлатежа,СтатьяБюджетаОсновногоПлатежа",Ложь,Ложь,Истина,Неопределено,Неопределено,Неопределено,Неопределено);
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Договор",Договор);
	Запрос.УстановитьПараметр("ОбъектСтроительства",ОбъектСтроительства);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.ПоРаботам КАК ПоРаботам,
	|	УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.ПоВидамРабот КАК ПоВидамРабот,
	|	УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБДДСАвансовогоПлатежа КАК СтатьяДвиженияДенежныхСредств,
	|	УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБюджетаБДР КАК СтатьяБюджета,
	|	УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.НомерСтроки = 0 КАК НеНайден,
	|	УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБДДСАвансовогоПлатежа КАК СтатьяБюджетаАвансовогоПлатежа,
	|	УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБДДСОсновногоПлатежа КАК СтатьяБюджетаОсновногоПлатежа
	|ИЗ
	|	РегистрСведений.УСОERP_ДополнительныеПараметрыПоДоговору.СрезПоследних(
	|			,
	|			Договор = &Договор
	|				И ОбъектСтроительства = &ОбъектСтроительства
	|				И Регистратор ССЫЛКА Документ.УСОERP_ДополнительныеПараметрыПоДоговору) КАК УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних";
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураВозврата,Выборка);
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции  

#КонецОбласти

#Область РаспределениеМатериаловПоРаботам

Процедура ЗаказПоставщику_ПроверитьЗаполнениеРаспределенияРабот(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи)	
	
	ТабТовары = ТекущийОбъект.Товары.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТабТовары",ТабТовары);
	
	Запрос.Текст = 	
	"ВЫБРАТЬ
	|	ТаблицаТовары.Номенклатура,
	|	ТаблицаТовары.Характеристика,
	|	ТаблицаТовары.Количество,
	|	ТаблицаТовары.СуммаСНДС,
	|	ТаблицаТовары.Отменено,
	|	ТаблицаТовары.ДатаПоступления,
	|	ВЫРАЗИТЬ(ТаблицаТовары.Склад КАК Справочник.Склады) КАК Склад,
	|	ВЫРАЗИТЬ(ТаблицаТовары.Назначение КАК Справочник.Назначения) КАК Назначение
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	&ТабТовары КАК ТаблицаТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.Номенклатура,
	|	ВрТаб.Характеристика,
	|	СУММА(ВрТаб.Количество) КАК Количество,
	|	СУММА(ВрТаб.СуммаСНДС) КАК Стоимость,
	|	ВрТаб.Склад.УСОERP_ОбъектСтроительства КАК ОбъектСтроительства,
	|	ВрТаб.ДатаПоступления
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|ГДЕ
	|	ЕСТЬNULL(ВрТаб.Склад.УСОERP_ОбъектСтроительства.УСОERP_ВестиРаспределениеМатериаловПоРаботам, ЛОЖЬ) = ИСТИНА
	|	И (ВрТаб.Назначение.Заказ ССЫЛКА Документ.ЗаказМатериаловВПроизводство
	|			ИЛИ ВрТаб.Назначение.Заказ ССЫЛКА Документ.ЗаказНаВнутреннееПотребление)
	|	И ВрТаб.Отменено = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВрТаб.Номенклатура,
	|	ВрТаб.Характеристика,
	|	ВрТаб.Склад.УСОERP_ОбъектСтроительства,
	|	ВрТаб.ДатаПоступления";	
	
	ТабТовары = Запрос.Выполнить().Выгрузить();	 	
	
	СтруктураОтбора = Новый Структура("ОбъектСтроительства,Номенклатура,Характеристика");	
	
	Если ТекущийОбъект.ПоступлениеОднойДатой Тогда
		
		Для Каждого СтрокаТЗ ИЗ ТекущийОбъект.УСОERP_РаспределениеМатериаловПоРаботам Цикл
			
			ЗаполнитьЗначенияСвойств(СтруктураОтбора,СтрокаТЗ);
			
			СтрокаТЗ.ДатаПоступления = ТекущийОбъект.ДатаПоступления;
			
			ТабОтбора = ТабТовары.Скопировать(СтруктураОтбора); 		
			
			СтрокаТЗ.Стоимость = ?(ТабОтбора.Итог("Количество") = 0,0,СтрокаТЗ.Количество*ТабОтбора.Итог("Стоимость")/ТабОтбора.Итог("Количество"));
			
		КонецЦикла;
		
		
		Возврат;
		
	КонецЕсли;	
	
	СтруктураОтбора.Вставить("ДатаПоступления",Дата(1,1,1));
	
	ТабРаботы = ТекущийОбъект.УСОERP_РаспределениеМатериаловПоРаботам.Выгрузить();
	ТабРаботы.Свернуть("ОбъектСтроительства,Номенклатура,Характеристика,ДатаПоступления","Количество");
	
	Для Каждого СтрокаРаботы ИЗ ТабРаботы Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураОтбора,СтрокаРаботы); 	
		
		ТабОтбора = ТабТовары.Скопировать(СтруктураОтбора);
		Если ТабОтбора.Количество() = 0 ИЛИ ТабОтбора.Получить(0).Количество < СтрокаРаботы.Количество Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неверно распределены работы!",,,,Отказ);
			Прервать;
		КонецЕсли;
		
		Строки =  ТекущийОбъект.УСОERP_РаспределениеМатериаловПоРаботам.НайтиСтроки(СтруктураОтбора);
		
		Для Каждого НайденнаяСтрока ИЗ Строки Цикл
			
			НайденнаяСтрока.Стоимость =  ?(ТабОтбора.Итог("Количество") = 0,0,НайденнаяСтрока.Количество*ТабОтбора.Итог("Стоимость")/ТабОтбора.Итог("Количество"));
			
		КонецЦикла;
		
	КонецЦикла; 	
	
КонецПроцедуры

Процедура ЗаказМатериаловВПроизводство_ПроверитьЗаполнениеРаспределенияРабот(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	  Если ТекущийОбъект.НеОтгружатьЧастями Тогда
		
		Для Каждого СтрокаТЗ ИЗ ТекущийОбъект.УСОERP_РаспределениеМатериаловПоРаботам Цикл
			
			СтрокаТЗ.ДатаПоступления = ТекущийОбъект.ДатаОтгрузки;
			
		КонецЦикла;
		
		//ТекущийОбъект.УСОERP_РаспределениеМатериаловПоРаботам.ЗаполнитьЗначения(ТекущийОбъект.ДатаПоступления,"ДатаПоступления");
		Возврат;
		
	КонецЕсли;	
	
	ТабТовары = ТекущийОбъект.Товары.Выгрузить();
	ТабТовары.Свернуть("Номенклатура,Характеристика,НачалоОтгрузки","Количество");
	
