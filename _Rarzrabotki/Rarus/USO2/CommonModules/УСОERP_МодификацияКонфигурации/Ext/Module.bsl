Процедура ДобавитьРаспределениеДоговораНаФормуПлатежногоДокумента(Форма)
	
	НовыйРеквизит = Новый РеквизитФормы("УСО_СуммаРаспределения",Новый ОписаниеТипов("Число"));
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить(НовыйРеквизит); 	
	Форма.ИзменитьРеквизиты(МассивРеквизитов);
	
	Форма.Элементы.РасшифровкаПлатежа.УстановитьДействие("ПриАктивизацииСтроки","Подключаемый_ВыполнитьПереопределяемуюКоманду");
	
	Если Форма.ИмяФормы = "Документ.ПриходныйКассовыйОрдер.Форма.ФормаДокумента"  Тогда
		
		Форма.Элементы.РасшифровкаПлатежаЗаказ.УстановитьДействие("ПриИзменении","Подключаемый_ВыполнитьПереопределяемуюКоманду");
		Форма.Элементы.РасшифровкаБезРазбиенияЗаказ.УстановитьДействие("ПриИзменении","Подключаемый_ВыполнитьПереопределяемуюКоманду");
		
	КонецЕсли; 	
		
	Если Форма.ИмяФормы = "Документ.ПоступлениеБезналичныхДенежныхСредств.Форма.ФормаДокумента"  Тогда
		Форма.Элементы.РасшифровкаПлатежаЗаказ.УстановитьДействие("ПриИзменении","Подключаемый_ВыполнитьПереопределяемуюКоманду");
		Форма.Элементы.РасшифровкаБезРазбиенияЗаказ.УстановитьДействие("ПриИзменении","Подключаемый_ВыполнитьПереопределяемуюКоманду");
	КонецЕсли; 		
		
	НовыйЭлемент = Форма.Элементы.Вставить("УСОERP_ДокументУтверждения",Тип("ПолеФормы"),Форма.Элементы.РасшифровкаПлатежа);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.РасшифровкаПлатежа.УСОERP_ДокументУтверждения";
	НовыйЭлемент.УстановитьДействие("ПриИзменении","Подключаемый_ВыполнитьПереопределяемуюКоманду");
	
	НовыйЭлемент = Форма.Элементы.Вставить("УСОERP_ДокументУтверждения1",Тип("ПолеФормы"),Форма.Элементы.РасшифровкаБезРазбиения);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.РасшифровкаПлатежа.УСОERP_ДокументУтверждения"; 	
	НовыйЭлемент.УстановитьДействие("ПриИзменении","Подключаемый_ВыполнитьПереопределяемуюКоманду");
	 
	Если Форма.Элементы.Найти("СтраницаПечать") <> Неопределено Тогда
		
		НоваяСтраница = Форма.Элементы.Вставить("СтраницаУСОERP_Распределение", Тип("ГруппаФормы"), Форма.Элементы.ГруппаСтраницы,Форма.Элементы.СтраницаПечать);
		
	Иначе
		
		НоваяСтраница = Форма.Элементы.Добавить("СтраницаУСОERP_Распределение", Тип("ГруппаФормы"), Форма.Элементы.ГруппаСтраницы);
		
	КонецЕсли;
	
	НоваяСтраница.Вид = ВидГруппыФормы.Страница;
	НоваяСтраница.Заголовок = "Распределение по аналитике";
	НоваяСтраница.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная; 	
	
	НовыйЭлемент = Форма.Элементы.Добавить("УСО_Распределение",Тип("ТаблицаФормы"),НоваяСтраница);
	НовыйЭлемент.ПутьКДанным = "Объект.УСОERP_РаспределениеПоАналитикеДоговора";
	НовыйЭлемент.Отображение = ОтображениеТаблицы.Список; 		
	НовыйЭлемент.УстановитьДействие("ПриНачалеРедактирования","Подключаемый_ВыполнитьПереопределяемуюКоманду");
	НовыйЭлемент.УстановитьДействие("ПередНачаломДобавления","Подключаемый_ВыполнитьПереопределяемуюКоманду");
	НовыйЭлемент.УстановитьДействие("ПриОкончанииРедактирования","Подключаемый_ВыполнитьПереопределяемуюКоманду");
	НовыйЭлемент.Подвал = Истина;
	
	НовыйЭлементКолонка = Форма.Элементы.Добавить("УСО_РаспределениеВидРабот",Тип("ПолеФормы"),НовыйЭлемент);
	НовыйЭлементКолонка.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлементКолонка.ПутьКДанным = "Объект.УСОERP_РаспределениеПоАналитикеДоговора.ВидРабот";
	
	НовыйЭлементКолонка = Форма.Элементы.Добавить("УСО_РаспределениеРабота",Тип("ПолеФормы"),НовыйЭлемент);
	НовыйЭлементКолонка.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлементКолонка.ПутьКДанным = "Объект.УСОERP_РаспределениеПоАналитикеДоговора.Работа";
	НовыйЭлементКолонка.УстановитьДействие("ПриИзменении","Подключаемый_ВыполнитьПереопределяемуюКоманду");
	НовыйЭлементКолонка.РедактированиеТекста = Ложь;
	
	НовыйЭлементКолонка = Форма.Элементы.Добавить("УСО_РаспределениеПорядокРасчетов",Тип("ПолеФормы"),НовыйЭлемент);
	НовыйЭлементКолонка.Вид = ВидПоляФормы.ПолеВвода; 
	НовыйЭлементКолонка.ПутьКДанным = "Объект.УСОERP_РаспределениеПоАналитикеДоговора.ПорядокРасчетов";
	
	НовыйЭлементКолонка = Форма.Элементы.Добавить("УСО_РаспределениеСумма",Тип("ПолеФормы"),НовыйЭлемент);
	НовыйЭлементКолонка.Вид = ВидПоляФормы.ПолеВвода; 
	НовыйЭлементКолонка.ПутьКДанным = "Объект.УСОERP_РаспределениеПоАналитикеДоговора.Сумма";
	НовыйЭлементКолонка.ПутьКДаннымПодвала = "УСО_СуммаРаспределения";
	НовыйЭлементКолонка.Формат = "ЧДЦ=2";
	НовыйЭлементКолонка.ШрифтПодвала = Новый Шрифт(,,Истина);
	
	НовыйЭлементКолонка = Форма.Элементы.Добавить("УСО_РаспределениеСтатьяДвиженияДенежныхСредств",Тип("ПолеФормы"),НовыйЭлемент);
	НовыйЭлементКолонка.Вид = ВидПоляФормы.ПолеВвода; 
	НовыйЭлементКолонка.ПутьКДанным = "Объект.УСОERP_РаспределениеПоАналитикеДоговора.СтатьяДвиженияДенежныхСредств";
	
	НовыйЭлементКолонка = Форма.Элементы.Добавить("УСО_РаспределениеСтатьяБюджета",Тип("ПолеФормы"),НовыйЭлемент);
	НовыйЭлементКолонка.Вид = ВидПоляФормы.ПолеВвода; 
