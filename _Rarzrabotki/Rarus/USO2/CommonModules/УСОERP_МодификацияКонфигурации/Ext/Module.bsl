	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияУслугПрочихАктивов") Тогда 		
				
		ДанныеОбъекта.Партнер = ДокументОснование.Партнер;
		ДанныеОбъекта.Соглашение = ДокументОснование.Соглашение;
		ДанныеОбъекта.Контрагент = ДокументОснование.Контрагент;
		ДанныеОбъекта.Договор = ДокументОснование.Договор;		
		ДанныеОбъекта.ОбъектСтроительства = ПолучитьОбъектСтроительстваПоДоговору(ДанныеОбъекта.Договор);
		ДанныеОбъекта.ДокументУтверждения = ПолучитьПоследнийДокументУтверждения(ДанныеОбъекта.ОбъектСтроительства);
		ДанныеОбъекта.НаправлениеДеятельности = ДокументОснование.НаправлениеДеятельности;

		ДанныеОбъекта.РаспределениеПоАналитикеДоговора.Очистить();
		Нстр = ДанныеОбъекта.РаспределениеПоАналитикеДоговора.Добавить();
		Нстр.Сумма = ДокументОснование.СуммаДокумента;
		Нстр.ПорядокДоходовРасходов = Перечисления.УСОERP_ПорядокДоходовРасходов.Реализация; 
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств") Тогда
		
		РП = ДокументОснование.РасшифровкаПлатежа.Выгрузить();
		РП_ДляСвертки = РП.Скопировать();
		РП_ДляСвертки.Свернуть("УСОERP_ОбъектСтроительства");
		
		Если РП_ДляСвертки.Количество() = 1 И ЗначениеЗаполнено(РП_ДляСвертки.Получить(0).УСОERP_ОбъектСтроительства) Тогда
			ПерваяСтрока = РП.Получить(0);
			ДанныеОбъекта.ОбъектСтроительства =  ПерваяСтрока.УСОERP_ОбъектСтроительства;
		Иначе
			ТекстОшибки = "Не указан объект строительства!";
			Возврат;
		КонецЕсли;
		
		ДанныеОбъекта.Партнер = ПерваяСтрока.Партнер;
		ДанныеОбъекта.НаправлениеДеятельности = ПерваяСтрока.НаправлениеДеятельности;
		
		ПартнерыИКонтрагенты.ЗаполнитьКонтрагентаПартнераПоУмолчанию(ДанныеОбъекта.Партнер, ДанныеОбъекта.Контрагент);
		ДанныеОбъекта.Договор = ПерваяСтрока.Заказ;
		
		ДанныеОбъекта.Договор = ПолучитьДоговорСДопПараметрами(ДанныеОбъекта.Контрагент,ДанныеОбъекта.Организация,ДанныеОбъекта.ОбъектСтроительства,ДанныеОбъекта.Договор);
		ДанныеОбъекта.Соглашение = ПолучитьСоглашение(ДанныеОбъекта.Партнер,ДанныеОбъекта.Организация,Истина);
		ДанныеОбъекта.ДокументУтверждения = ПолучитьПоследнийДокументУтверждения(ДанныеОбъекта.ОбъектСтроительства);
		
		//Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.Договор) Тогда
		//	ТекстОшибки = "Нет договора с дополнительными параметрами!";
		//	Возврат;
		//КонецЕсли;
		
		ДанныеОбъекта.РаспределениеПоАналитикеДоговора.Загрузить(РП);

		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СписаниеЗадолженности") Тогда
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
		
		Если ТипЗнч(ДокументОснование.Склад) = Тип("СправочникСсылка.Склады") Тогда
			ДанныеОбъекта.ОбъектСтроительства = ДокументОснование.Склад.УСОERP_ОбъектСтроительства;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.ОбъектСтроительства) Тогда
			ТекстОшибки = "Не указан объект строительства!";
			Возврат;
        КонецЕсли;
		
		ДанныеОбъекта.Партнер = ДокументОснование.Партнер;
		ДанныеОбъекта.Соглашение = ДокументОснование.Соглашение;
		ДанныеОбъекта.Контрагент = ДокументОснование.Контрагент;
		ДанныеОбъекта.Договор = ДокументОснование.Договор;
		ДанныеОбъекта.Договор = ПолучитьДоговорСДопПараметрами(ДанныеОбъекта.Контрагент,ДанныеОбъекта.Организация,ДанныеОбъекта.ОбъектСтроительства,ДанныеОбъекта.Договор);
		ДанныеОбъекта.ДокументУтверждения = ПолучитьПоследнийДокументУтверждения(ДанныеОбъекта.ОбъектСтроительства);
		ДанныеОбъекта.НаправлениеДеятельности = ДокументОснование.НаправлениеДеятельности;

		Нстр = ДанныеОбъекта.РаспределениеПоАналитикеДоговора.Добавить();
		Нстр.Сумма = ДокументОснование.СуммаДокумента;
		Нстр.ПорядокДоходовРасходов = Перечисления.УСОERP_ПорядокДоходовРасходов.ПоступлениеЗатрат;
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.УСОERP_АктПриемкиРабот") Тогда
		
		ДанныеОбъекта.ОбъектСтроительства = ДокументОснование.ОбъектСтроительства;
		ДанныеОбъекта.Партнер = ДокументОснование.Субподрядчик;
		ДанныеОбъекта.Соглашение = ДокументОснование.Соглашение;
		ДанныеОбъекта.Контрагент = ДокументОснование.Контрагент;
		ДанныеОбъекта.Договор = ДокументОснование.Договор;
		ДанныеОбъекта.ДокументУтверждения = ДокументОснование.ДокументУтверждения;
		ДанныеОбъекта.НаправлениеДеятельности = ДокументОснование.НаправлениеДеятельности;
		
		СтруктураЗаполнения = Новый Структура("ДокументОснование,Договор,ОбъектСтроительства,Дата,ДанныеРаспределения",ДанныеОбъекта.ДокументОснование,ДанныеОбъекта.Договор,ДанныеОбъекта.ОбъектСтроительства,ТекущаяДата(),ДанныеОбъекта.РаспределениеПоАналитикеДоговора.Выгрузить());
		Документы.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ЗаполнитьНаОснованииАктаПриемкиРабот(СтруктураЗаполнения);
		ДанныеОбъекта.РаспределениеПоАналитикеДоговора.Загрузить(СтруктураЗаполнения.ДанныеРаспределения);
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.УСОERP_РеализацияСтроительныхРабот") Тогда 
		
		ДанныеОбъекта.ОбъектСтроительства = ДокументОснование.ОбъектСтроительства;
		ДанныеОбъекта.Партнер = ДокументОснование.Партнер;
		ДанныеОбъекта.Соглашение = ДокументОснование.Соглашение;
		ДанныеОбъекта.Контрагент = ДокументОснование.Контрагент;
		ДанныеОбъекта.Договор = ДокументОснование.Договор;
		ДанныеОбъекта.ДокументУтверждения = ДокументОснование.ДокументУтверждения;
		ДанныеОбъекта.НаправлениеДеятельности = ДокументОснование.НаправлениеДеятельности;
		
		СтруктураЗаполнения = Новый Структура("ДокументОснование,Договор,ОбъектСтроительства,Дата,ДанныеРаспределения",ДанныеОбъекта.ДокументОснование,ДанныеОбъекта.Договор,ДанныеОбъекта.ОбъектСтроительства,ТекущаяДата(),ДанныеОбъекта.РаспределениеПоАналитикеДоговора.Выгрузить());
		Документы.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.ЗаполнитьНаОснованииРеализацииСтроительныхРабот(СтруктураЗаполнения);
		ДанныеОбъекта.РаспределениеПоАналитикеДоговора.Загрузить(СтруктураЗаполнения.ДанныеРаспределения);
		
	КонецЕсли; 	
	
КонецПроцедуры

Процедура ЗаполнитьВыпускПродукцииНаОснованииРеализацииСтроительныхРаботВнутренняя(Источник, ДанныеЗаполнения)
	
	Источник.Организация             = ДанныеЗаполнения.Организация;
	Источник.Подразделение           = ДанныеЗаполнения.Подразделение;
	Источник.НаправлениеВыпуска      = Перечисления.ХозяйственныеОперации.ВыпускПродукцииВПодразделение;
	Источник.Валюта                  = ДанныеЗаполнения.Валюта;
	Источник.НаправлениеДеятельности = ДанныеЗаполнения.НаправлениеДеятельности;
	Источник.ДокументОснование       = ДанныеЗаполнения;
	
	Для Каждого ТекущаяСтрока Из ДанныеЗаполнения.ВыполненоВсего Цикл 
		НоваяСтрока = Источник.Товары.Добавить();
		НоваяСтрока.Номенклатура       = ТекущаяСтрока.Номенклатура;
		НоваяСтрока.Характеристика     = ТекущаяСтрока.Характеристика;
		НоваяСтрока.Упаковка           = ТекущаяСтрока.Упаковка;
		НоваяСтрока.КоличествоУпаковок = ТекущаяСтрока.КоличествоУпаковок;
		НоваяСтрока.Количество         = ТекущаяСтрока.КоличествоУпаковок;
		НоваяСтрока.ТипСтоимости       = Перечисления.ТипыСтоимостиВыходныхИзделий.Рассчитывается;
		НоваяСтрока.СтатьяРасходов     = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ПустаяСсылка();
		НоваяСтрока.Подразделение      = ДанныеЗаполнения.Подразделение;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Справочник_ДоговорыКонтрагентов

Процедура ДоговорыКонтрагентов_ПроверитьЗаполнениеСправочника(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи)	
	
	Если Форма.Объект.УСОERP_АгентскийДоговор Тогда
		
		Если НЕ ЗначениеЗаполнено(Форма.Объект.УСОERP_УсловияАгентскогоДоговора) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен реквизит ""Условия агентского договора""",,,,Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Форма.Объект.УСОERP_РазмерВознаграждения) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен реквизит ""Размер вознаграждения""",,,,Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Форма.Объект.УСОERP_АгентскийДоговор ИЛИ Форма.Объект.УСОERP_ДоговорДолевогоСтроительства Тогда
		
		Если НЕ ЗначениеЗаполнено(Форма.Объект.УСОERP_ТипЦены) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен реквизит ""Тип цены""",,,,Отказ);
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры 

Функция ПолучитьДоговорСДопПараметрами(Контрагент,Организация,ОбъектСтроительства,Договор)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("ОбъектСтроительства",ОбъектСтроительства);
	Запрос.УстановитьПараметр("Договор",Договор);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Ссылка КАК Ссылка,
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Договор КАК Договор
	|ИЗ
	|	Документ.УСОERP_ДополнительныеПараметрыПоДоговору КАК УСОERP_ДополнительныеПараметрыПоДоговору
	|ГДЕ
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Проведен
	|	И ВЫБОР
	|			КОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ УСОERP_ДополнительныеПараметрыПоДоговору.Договор = &Договор
	|		КОНЕЦ
	|	И ВЫБОР КОГДА &ОбъектСтроительства = ЗНАЧЕНИЕ(Справочник.СМ_ОбъектыСтроительства.ПустаяСсылка) ТОГДА ИСТИНА ИНАЧЕ УСОERP_ДополнительныеПараметрыПоДоговору.ОбъектСтроительства = &ОбъектСтроительства КОНЕЦ
	|	И УСОERP_ДополнительныеПараметрыПоДоговору.Договор.Контрагент = &Контрагент
	|	И УСОERP_ДополнительныеПараметрыПоДоговору.Организация = &Организация";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Договор;
	КонецЕсли;
	
	Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка(); 
	
КонецФункции

Функция ПолучитьДополнительныеПараметрыПоДоговору(Договор,ОбъектСтроительства,Дата,Согласован = Истина,ДокументУтверждения = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Договор",Договор);
	Запрос.УстановитьПараметр("ОбъектСтроительства",ОбъектСтроительства);
	Запрос.УстановитьПараметр("Дата",Дата);
	Запрос.УстановитьПараметр("Согласован",Согласован);
	Запрос.УстановитьПараметр("ДокументУтверждения",?(ДокументУтверждения = Неопределено,Документы.УСОERP_УтверждениеКалендарногоПланаГрафика.ПустаяСсылка(),ДокументУтверждения));
		
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УСОERP_ДополнительныеПараметрыПоДоговору КАК УСОERP_ДополнительныеПараметрыПоДоговору
	|ГДЕ
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Проведен
	|	И УСОERP_ДополнительныеПараметрыПоДоговору.Договор = &Договор
	|	И УСОERP_ДополнительныеПараметрыПоДоговору.ОбъектСтроительства = &ОбъектСтроительства
	|	И ВЫБОР
	|			КОГДА &Согласован
	|				ТОГДА УСОERP_ДополнительныеПараметрыПоДоговору.Статус = ЗНАЧЕНИЕ(Перечисление.РезультатыСогласования.Согласовано)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА УСОERP_ДополнительныеПараметрыПоДоговору.ДокументУтверждения = ЗНАЧЕНИЕ(Документ.УСОERP_УтверждениеКалендарногоПланаГрафика.ПустаяСсылка)
	|				ТОГДА УСОERP_ДополнительныеПараметрыПоДоговору.Дата <= &Дата
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ДокументУтверждения = ЗНАЧЕНИЕ(Документ.УСОERP_УтверждениеКалендарногоПланаГрафика.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ УСОERP_ДополнительныеПараметрыПоДоговору.ДокументУтверждения = &ДокументУтверждения
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Дата УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.УСОERP_ДополнительныеПараметрыПоДоговору.ПустаяСсылка();
	
КонецФункции 

Функция ПолучитьОбъектСтроительстваПоДоговору(Договор)
	
	Если ЗначениеЗаполнено(Договор.УСОERP_ОсновнойПроект) Тогда
		Возврат Договор.УСОERP_ОсновнойПроект;
	КонецЕсли;
	
	Возврат Документы.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.НайтиПоРеквизиту("Договор",Договор).ОбъектСтроительства;
		
КонецФункции


Функция ПолучитьСоглашение(Партнер,Организация,СПоставщиком = Ложь)
	
	ИмяСправочника = "СоглашенияСКлиентами";
	
	Если СПоставщиком Тогда
		ИмяСправочника = "СоглашенияСПоставщиками";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("Партнер",Партнер);	
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоглашенияСКлиентами.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник."+ИмяСправочника+" КАК СоглашенияСКлиентами
	//СоглашенияСКлиентами КАК СоглашенияСКлиентами
	|ГДЕ
	|	СоглашенияСКлиентами.Партнер = &Партнер
	|	И СоглашенияСКлиентами.Организация = &Организация
	|	И (СоглашенияСКлиентами.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСоглашенийСПоставщиками.Действует)
	|			ИЛИ СоглашенияСКлиентами.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСоглашенийСКлиентами.Действует))";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники[ИмяСправочника].ПустаяСсылка();
	
КонецФункции

Функция ПолучитьПоследнийДокументУтверждения(ОбъектСтроительства) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ОбъектСтроительства",ОбъектСтроительства);
	//Запрос.УстановитьПараметр("Организация",Организация);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УСОERP_УтверждениеКалендарногоПланаГрафика КАК УСОERP_УтверждениеКалендарногоПланаГрафика
	|ГДЕ
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.Проведен
	|	И УСОERP_УтверждениеКалендарногоПланаГрафика.ОбъектСтроительства = &ОбъектСтроительства
	|	И ВЫБОР
	|			КОГДА УСОERP_УтверждениеКалендарногоПланаГрафика.СценарийПланирования.НовыйВариант
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ УСОERP_УтверждениеКалендарногоПланаГрафика.Актуальный
	|		КОНЕЦ
	//|	И УСОERP_УтверждениеКалендарногоПланаГрафика.Организация = &Организация
	//|	И УСОERP_УтверждениеКалендарногоПланаГрафика.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_УтверждениеКалендарногоПланаГрафика.Дата УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.УСОERP_УтверждениеКалендарногоПланаГрафика.ПустаяСсылка();	
	
КонецФункции  

