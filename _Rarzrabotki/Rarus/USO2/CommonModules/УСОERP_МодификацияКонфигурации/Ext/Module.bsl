			Для Каждого СтрДок Из ТаблицаПодчиненных Цикл
				
				СтрокаДерева1 = СтрокаДерева0.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДерева1, СтрДок);
