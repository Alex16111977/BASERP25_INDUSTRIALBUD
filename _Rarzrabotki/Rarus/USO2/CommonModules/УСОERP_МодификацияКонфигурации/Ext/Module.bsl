	СтрокаПлатежа.УСОERP_ОбъектСтроительства = Документ.ОбъектСтроительства;
	СтрокаПлатежа.НаправлениеДеятельности = Документ.НаправлениеДеятельности;
		
КонецПроцедуры

Процедура ЗаполнитьЗаданиеНаПеревозкуНаОснованииЗаказаНаПеревозку(Объект, Документ) Экспорт
	
	МассивВидовОпераций = Новый массив;
	МассивВидовОпераций.Добавить(Перечисления.УСОERP_ИсполнителиДоставки.СобственнымиСилами);
	
	МассивДопустимыхСтатусов = Новый массив;
	МассивДопустимыхСтатусов.Добавить(Перечисления.УСОERP_СтатусыЗаказаНаПеревозку.Подготовлен);
	МассивДопустимыхСтатусов.Добавить(Перечисления.УСОERP_СтатусыЗаказаНаПеревозку.ВРаботе);
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ЗаказНаПеревозку.Ссылка КАК ЗаказНаПеревозку,
	|	УСОERP_ЗаказНаПеревозку.ВерсияДанных,
	|	УСОERP_ЗаказНаПеревозку.ПометкаУдаления,
	|	УСОERP_ЗаказНаПеревозку.Номер,
	|	УСОERP_ЗаказНаПеревозку.Дата,
	|	УСОERP_ЗаказНаПеревозку.Проведен,
	|	УСОERP_ЗаказНаПеревозку.Организация,
	|	УСОERP_ЗаказНаПеревозку.Статус,
	|	УСОERP_ЗаказНаПеревозку.ВидОперации,
	|	УСОERP_ЗаказНаПеревозку.СрокДоставки,
	|	УСОERP_ЗаказНаПеревозку.Партнер,
	|	УСОERP_ЗаказНаПеревозку.Контрагент,
	|	УСОERP_ЗаказНаПеревозку.АдресОтправления,
	|	УСОERP_ЗаказНаПеревозку.АдресДоставки,
	|	УСОERP_ЗаказНаПеревозку.Склад,
	|	УСОERP_ЗаказНаПеревозку.Договор,
	|	УСОERP_ЗаказНаПеревозку.ВидДоставки,
	|	УСОERP_ЗаказНаПеревозку.Валюта,
	|	УСОERP_ЗаказНаПеревозку.ЦенаВключаетНДС,
	|	УСОERP_ЗаказНаПеревозку.ВалютаВзаиморасчетов,
	|	УСОERP_ЗаказНаПеревозку.НалогообложениеНДС,
	|	УСОERP_ЗаказНаПеревозку.Соглашение,
	|	ВЫБОР
	|		КОГДА УСОERP_ЗаказНаПеревозку.Проведен
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьОшибкиПроведен,
	|	ВЫБОР
	|		КОГДА УСОERP_ЗаказНаПеревозку.ВидОперации В (&МассивДопустимыхВидовОпераций)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьОшибкиВидОперации,
	|	ВЫБОР
	|		КОГДА УСОERP_ЗаказНаПеревозку.Статус В (&МассивДопустимыхСтатусов)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьОшибкиСтатус
	|ИЗ
	|	Документ.УСОERP_ЗаказНаПеревозку КАК УСОERP_ЗаказНаПеревозку
	|ГДЕ
	|	УСОERP_ЗаказНаПеревозку.Ссылка = &ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(УСОERP_ЗаказНаПеревозкуКДоставке.Количество) КАК Количество,
	|	СУММА(УСОERP_ЗаказНаПеревозкуКДоставке.Вес) КАК Вес,
	|	СУММА(ВЫРАЗИТЬ(ЕСТЬNULL(УСОERP_ЗаказНаПеревозкуКДоставке.Количество, 0) * ЕСТЬNULL(УСОERP_ЗаказНаПеревозкуКДоставке.Номенклатура.ОбъемЗнаменатель, 0) КАК ЧИСЛО(15, 3))) КАК Объем,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка КАК УСОERP_ДокументОснование,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.АдресДоставки.ПолныйАдрес КАК Адрес
	|ИЗ
	|	Документ.УСОERP_ЗаказНаПеревозку.КДоставке КАК УСОERP_ЗаказНаПеревозкуКДоставке
	|ГДЕ
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка = &ДокументОснование
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка.АдресДоставки.ПолныйАдрес";
	
	Запрос.УстановитьПараметр("ДокументОснование", Документ);
	Запрос.УстановитьПараметр("МассивДопустимыхВидовОпераций", МассивВидовОпераций);
	Запрос.УстановитьПараметр("МассивДопустимыхСтатусов", МассивДопустимыхСтатусов);

	
	Результат = Запрос.ВыполнитьПакет();
	
	РеквизитыЗаказа = Результат[0].Выбрать();
	
	Если Не РеквизитыЗаказа.Следующий() Тогда
		Возврат;
	Конецесли;
	
	
	ПроверитьВозможностьВводаНаОснованииЗаданиеНаПеревозку(
			РеквизитыЗаказа.ЗаказНаПеревозку,
			РеквизитыЗаказа.ВидОперации,
			РеквизитыЗаказа.Статус,
			РеквизитыЗаказа.ЕстьОшибкиПроведен,
			РеквизитыЗаказа.ЕстьОшибкиВидОперации,
			РеквизитыЗаказа.ЕстьОшибкиСтатус,
			МассивВидовОпераций,
			МассивДопустимыхСтатусов);

			
	// Заполнение шапки.
	ЗаполнитьЗначенияСвойств(Объект, РеквизитыЗаказа);
	Объект.ДатаВремяРейсаПланС    	= НачалоДня(РеквизитыЗаказа.СрокДоставки);
	Объект.ДатаВремяРейсаПланПо 	= КонецДня(РеквизитыЗаказа.СрокДоставки);
	Объект.Склад 					= РеквизитыЗаказа.Склад;
	Объект.Вес 					    = Документ.КДоставке.Итог("Вес");
	Объект.Статус 					= Перечисления.СтатусыЗаданийНаПеревозку.Формируется;
	Объект.Приоритет 				= Справочники.Приоритеты.ПолучитьВысшийПриоритет();
	
	// Заполнение табличной части "Маршрут" 	
	РеквизитыТабЧасти = Результат[1].Выгрузить();
	Объект.Маршрут.Загрузить(РеквизитыТабЧасти);
		

	//ВызватьИсключение("БУМ");
	
КонецПроцедуры

Процедура ПроверитьВозможностьВводаНаОснованииЗаданиеНаПеревозку(мДокумент, ВидОперации = Неопределено, Статус = Неопределено, ЕстьОшибкиПроведен = Ложь, ЕстьОшибкиВидОперации = Ложь, ЕстьОшибкиСтатус = Ложь,МассивДопустимыхВидовОпераций = Неопределено, МассивДопустимыхСтатусов = Неопределено)
	
	Если ЕстьОшибкиПроведен Тогда
		
		ТекстОшибки = НСтр("ru='Документ %Документ% не проведен. Ввод на основании непроведенного документа запрещен.'");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", мДокумент);
	
		ВызватьИсключение ТекстОшибки;
		
	ИначеЕсли ЕстьОшибкиВидОперации Тогда
		
		Если МассивДопустимыхВидовОпераций = Неопределено Тогда
			ТекстОшибки = НСтр("ru='Документ %Документ% с видом операции ""%ВидОперации%"". Ввод на основании запрещен.'");
		ИначеЕсли ТипЗнч(МассивДопустимыхВидовОпераций) = Тип("Массив") Тогда
			
			ТекстОшибки = НСтр("ru='Документ %Документ% с видом операции ""%ВидОперации%"". Ввод на основании разрешен для вида операции %СтрокаДопустимыхВидовОпераций%.'");
			СтрокаДопустимыхВидовОпераций = "";
			
			Для Каждого ДопустимыйВидОперации Из МассивДопустимыхВидовОпераций Цикл
				СтрокаДопустимыхВидовОпераций = СтрокаДопустимыхВидовОпераций + """"+ ДопустимыйВидОперации + """, ";
			КонецЦикла;
			
			СтрокаДопустимыхВидовОпераций = Лев(СтрокаДопустимыхВидовОпераций, СтрДлина(СтрокаДопустимыхВидовОпераций)-2);
			
			Если МассивДопустимыхВидовОпераций.Количество() = 0 Тогда
				ТекстОшибки = НСтр("ru='Документ %Документ% с видом операции ""%ВидОперации%"". Ввод на основании запрещен.'");
			ИначеЕсли МассивДопустимыхВидовОпераций.Количество() = 1 Тогда
				ТекстОшибки = НСтр("ru='Документ %Документ% с видом операции ""%ВидОперации%"". Ввод на основании разрешен только для вида операции %СтрокаДопустимыхВидовОпераций%.'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%СтрокаДопустимыхВидовОпераций%", СтрокаДопустимыхВидовОпераций);
			Иначе
				ТекстОшибки = НСтр("ru='Документ %Документ% с видом операции ""%ВидОперации%"". Ввод на основании разрешен только для видов операций %СтрокаДопустимыхВидовОпераций%.'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%СтрокаДопустимыхВидовОпераций%", СтрокаДопустимыхВидовОпераций);
			КонецЕсли;
			
		КонецЕсли;
		
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", мДокумент);
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ВидОперации%",   ВидОперации);
	
		ВызватьИсключение ТекстОшибки;
		
	ИначеЕсли ЕстьОшибкиСтатус Тогда
		
		Если МассивДопустимыхВидовОпераций = Неопределено Тогда
			ТекстОшибки = НСтр("ru='Документ %Документ% в статусе ""%Статус%"". Ввод на основании запрещен.'");
		ИначеЕсли ТипЗнч(МассивДопустимыхВидовОпераций) = Тип("Массив") Тогда
			
			ТекстОшибки = НСтр("ru='Документ %Документ% в статусе ""%Статус%"". Ввод на основании разрешен для статусов %СтрокаДопустимыхСтатусов%.'");
			СтрокаДопустимыхСтатусов= "";
			
			Для Каждого ДопустимыйСтатус Из МассивДопустимыхСтатусов Цикл
				СтрокаДопустимыхСтатусов = СтрокаДопустимыхСтатусов + """"+ ДопустимыйСтатус + """, ";
			КонецЦикла;
			
			СтрокаДопустимыхСтатусов = Лев(СтрокаДопустимыхСтатусов, СтрДлина(СтрокаДопустимыхСтатусов)-2);
			
			Если МассивДопустимыхСтатусов.Количество() = 0 Тогда
				ТекстОшибки = НСтр("ru='Документ %Документ% в статусе ""%Статус%"". Ввод на основании запрещен.'");
			ИначеЕсли МассивДопустимыхСтатусов.Количество() = 1 Тогда
				ТекстОшибки = НСтр("ru='Документ %Документ% в статусе ""%Статус%"". Ввод на основании разрешен только для статуса %СтрокаДопустимыхСатусов%.'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%СтрокаДопустимыхВидовОпераций%", СтрокаДопустимыхСтатусов);
			Иначе
				ТекстОшибки = НСтр("ru='Документ %Документ% в статусе ""%Статус%"". Ввод на основании разрешен только для статусов %СтрокаДопустимыхСтатусов%.'");
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%СтрокаДопустимыхСтатусов%", СтрокаДопустимыхСтатусов);
			КонецЕсли;
			
		КонецЕсли;
		
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", мДокумент);
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Статус%",   Статус);
	
		ВызватьИсключение ТекстОшибки;
	
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьПриобретениеУслугНаПеревозкуНаОснованииЗаказаНаПеревозку(Объект, Документ) Экспорт
	
	Запрос = Новый Запрос;
	ЗАпрос.УстановитьПараметр("СсылкаНаДокумент",Документ);
	Запрос.УстановитьПараметр("Менеджер",Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("ДатаПлатежа",ТекущаяДата());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ЗаказНаПеревозку.Организация КАК Организация,
	|	УСОERP_ЗаказНаПеревозку.Соглашение КАК Соглашение,
	|	УСОERP_ЗаказНаПеревозку.Партнер КАК Партнер,
	|	УСОERP_ЗаказНаПеревозку.Контрагент КАК Контрагент,
	|	УСОERP_ЗаказНаПеревозку.Валюта КАК Валюта,
	|	&Менеджер КАК Менеджер,
	|	УСОERP_ЗаказНаПеревозку.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	УСОERP_ЗаказНаПеревозку.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
	|	&ДатаПлатежа КАК ДатаПлатежа,
	|	УСОERP_ЗаказНаПеревозку.НалогообложениеНДС КАК НалогообложениеНДС,
	|	УСОERP_ЗаказНаПеревозку.СуммаДокумента КАК СуммаДокумента,
	|	УСОERP_ЗаказНаПеревозку.СуммаДокумента КАК СуммаВзаиморасчетов,
	|	УСОERP_ЗаказНаПеревозку.Договор КАК Договор,
	|	1 КАК Курс,
	|	1 КАК Кратность
	|ИЗ
	|	Документ.УСОERP_ЗаказНаПеревозку КАК УСОERP_ЗаказНаПеревозку
	|ГДЕ
	|	УСОERP_ЗаказНаПеревозку.Ссылка = &СсылкаНаДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_ЗаказНаПеревозкуЗатраты.Содержание КАК Содержание,
	|	УСОERP_ЗаказНаПеревозкуЗатраты.Количество КАК Количество,
	|	УСОERP_ЗаказНаПеревозкуЗатраты.Цена КАК Цена,
	|	УСОERP_ЗаказНаПеревозкуЗатраты.Сумма КАК Сумма,
	|	УСОERP_ЗаказНаПеревозкуЗатраты.СтавкаНДС КАК СтавкаНДС,
	|	УСОERP_ЗаказНаПеревозкуЗатраты.СуммаНДС КАК СуммаНДС,
	|	УСОERP_ЗаказНаПеревозкуЗатраты.СуммаСНДС КАК СуммаСНДС,
	|	УСОERP_ЗаказНаПеревозкуЗатраты.СтатьяРасходов КАК СтатьяРасходов,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.ЗаказПоставщику.Подразделение КАК Подразделение,
	|	УСОERP_ЗаказНаПеревозкуКДоставке.ЗаказПоставщику.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	УСОERP_ЗаказНаПеревозкуЗатраты.СтатьяРасходов.СчетУчета КАК СчетУчета
	|ИЗ
	|	Документ.УСОERP_ЗаказНаПеревозку.Затраты КАК УСОERP_ЗаказНаПеревозкуЗатраты,
	|	Документ.УСОERP_ЗаказНаПеревозку.КДоставке КАК УСОERP_ЗаказНаПеревозкуКДоставке
	|ГДЕ
	|	УСОERP_ЗаказНаПеревозкуЗатраты.Ссылка = &СсылкаНаДокумент
	|	И УСОERP_ЗаказНаПеревозкуКДоставке.Ссылка = &СсылкаНаДокумент
	|	И УСОERP_ЗаказНаПеревозкуКДоставке.НомерСтроки = 1";
	
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	ВыборкаРеквизитов  = ПакетЗапросов[0].Выбрать();
	
	ВыборкаРеквизитов.Следующий();		
	ЗаполнитьЗначенияСвойств(Объект,ВыборкаРеквизитов);
	Объект.БанковскийСчетОрганизации = Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(
	Объект.Организация,Объект.Валюта);
	Объект.БанковскийСчетКонтрагента = Справочники.БанковскиеСчетаКонтрагентов.ПолучитьБанковскийСчетПоУмолчанию(
	Объект.Контрагент,Объект.Валюта);
	
	Объект.Расходы.Загрузить(ПакетЗапросов[1].Выгрузить()); 	
	
КонецПроцедуры

Процедура ЗаполнитьПБДСНаОснованииРеализииСтроительныхРабот(Объект, Документ) Экспорт
	
		
	Объект.Организация = Документ.Организация;
	Объект.Подразделение = Документ.Подразделение;
	Объект.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();	
	Объект.БанковскийСчет = Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(Объект.Организация,Объект.Валюта);
	Объект.Контрагент = Документ.Контрагент;
	Объект.ДокументОснование = Документ;
	Объект.СуммаДокумента = Документ.СуммаДокумента;
	Объект.НаправлениеДеятельности = Документ.НаправлениеДеятельности;
	Объект.БанковскийСчетКонтрагента = Справочники.БанковскиеСчетаКонтрагентов.ПолучитьБанковскийСчетПоУмолчанию(
				Объект.Контрагент,
				Объект.Валюта);
		
	СтрокаПлатежа = ?(Объект.РасшифровкаПлатежа.Количество(),Объект.РасшифровкаПлатежа.Получить(0),Объект.РасшифровкаПлатежа.Добавить());
	
	СтрокаПлатежа.Партнер = Документ.Партнер;
	СтрокаПлатежа.Заказ = Документ.Договор;
	СтрокаПлатежа.Организация = Документ.Организация;
	СтрокаПлатежа.Сумма = Документ.СуммаДокумента;
	СтрокаПлатежа.СуммаВзаиморасчетов = СтрокаПлатежа.Сумма;
	СтрокаПлатежа.СуммаНДС = Документ.Работы.Итог("СуммаНДС");
	СтрокаПлатежа.СтавкаНДС = ?(СтрокаПлатежа.СуммаНДС = 0,Перечисления.СтавкиНДС.БезНДС,?(ЗначениеЗаполнено(Документ.Договор.СтавкаНДС),Документ.Договор.СтавкаНДС,Перечисления.СтавкиНДС.НДС18));
	СтрокаПлатежа.ВалютаВзаиморасчетов = Объект.Валюта;
	СтрокаПлатежа.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.ПоступлениеОплатыОтКлиента;
	СтрокаПлатежа.УСОERP_ОбъектСтроительства = Документ.ОбъектСтроительства;
	СтрокаПлатежа.НаправлениеДеятельности = Документ.НаправлениеДеятельности;

КонецПроцедуры

Процедура ЗаполнитьПБДСНаОснованииДоговораПоНедвижимости(Объект,Документ)
	
	Объект.Организация = Документ.Организация;	
	Объект.Валюта = Документ.Валюта;	
	Объект.БанковскийСчет = Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(Объект.Организация,Объект.Валюта);
	Объект.Контрагент = Документ.Контрагент;
	Объект.ДокументОснование = Документ;
	Объект.СуммаДокумента = Документ.ОбъектыНедвижимости.Итог("Сумма");
	Объект.НаправлениеДеятельности = Документ.НаправлениеДеятельности;
	Объект.НомерВходящегоДокумента = "1";
	Объект.ДатаВходящегоДокумента = ТекущаяДата();
	Объект.БанковскийСчетКонтрагента = Справочники.БанковскиеСчетаКонтрагентов.ПолучитьБанковскийСчетПоУмолчанию(Объект.Контрагент,Объект.Валюта);				
	
	СтрокаПлатежа = ?(Объект.РасшифровкаПлатежа.Количество(),Объект.РасшифровкаПлатежа.Получить(0),Объект.РасшифровкаПлатежа.Добавить());
	
	СтрокаПлатежа.Партнер = Документ.Партнер;	
	СтрокаПлатежа.ОснованиеПлатежа = Документ.Договор;
	Если Документ.Договор.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов Тогда
		СтрокаПлатежа.Заказ = Документ.Договор;
	КонецЕсли;	
	СтрокаПлатежа.Организация = Документ.Организация;
	СтрокаПлатежа.Сумма = Документ.ОбъектыНедвижимости.Итог("Сумма");
	СтрокаПлатежа.СуммаВзаиморасчетов = СтрокаПлатежа.Сумма;
	СтрокаПлатежа.СуммаНДС = Документ.ОбъектыНедвижимости.Итог("СуммаНДС");
	СтрокаПлатежа.СтавкаНДС = ?(СтрокаПлатежа.СуммаНДС = 0,Перечисления.СтавкиНДС.БезНДС,?(ЗначениеЗаполнено(Документ.Договор.СтавкаНДС),Документ.Договор.СтавкаНДС,Перечисления.СтавкиНДС.НДС18));
	СтрокаПлатежа.ВалютаВзаиморасчетов = Объект.Валюта;
	СтрокаПлатежа.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.ПоступлениеОплатыОтКлиента;
	
	Если Документ.ОбъектыНедвижимости.Количество() Тогда
		
		СтрокаПлатежа.УСОERP_ОбъектСтроительства = Справочники.СМ_ОбъектыСтроительства.НайтиПоРеквизиту("ОбъектСтроительства",Документ.ОбъектыНедвижимости.Получить(0).ОбъектНедвижимости.ОбъектЭксплуатации);
		
	КонецЕсли;
	
	СтрокаПлатежа.НаправлениеДеятельности = Документ.НаправлениеДеятельности;
	
КонецПроцедуры

Процедура ЗаполнитьВзаимозачетЗадолженностиНаОснованииАктаПриемки(Источник, ДанныеЗаполнения)
	
	Основание = ДанныеЗаполнения;
	Источник.Организация = Основание.Организация;
	Источник.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.Поставщика;
	Источник.КонтрагентДебитор = Основание.Контрагент;
	Источник.КонтрагентКредитор = Основание.Контрагент;
	Источник.ТипДебитора = Перечисления.ТипыУчастниковВзаимозачета.Поставщик;
	Источник.ТипКредитора = Перечисления.ТипыУчастниковВзаимозачета.Поставщик;
	Источник.ДокументОснование = Основание;
	
	ДоговорГУ = УСОERP_УправлениеСтроительнымПроизводством.НайтиДоговорГарантийногоУдержания(Основание.ОбъектСтроительства, Основание.Договор, Основание.Дата);
	Дт = Источник.ДебиторскаяЗадолженность.Добавить();
	Дт.ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком;
	Дт.Партнер = Основание.Контрагент.Партнер;
	Дт.Заказ = ?(Основание.Договор.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов, Основание.Договор, Основание);
	Дт.Сумма = ?(Основание.ВыполненоВсего.Количество(), Основание.ВыполненоВсего[0].СуммаГУ, 0);
	Дт.СуммаВзаиморасчетов = ?(Основание.ВыполненоВсего.Количество(), Основание.ВыполненоВсего[0].СуммаГУ, 0);
	Дт.ВалютаВзаиморасчетов = Основание.ВалютаВзаиморасчетов;
	Дт.Организация = Основание.Организация;
	Дт.Сумма = ?(Основание.ВыполненоВсего.Количество(), Основание.ВыполненоВсего[0].СуммаГУ, 0);
	Дт.СуммаРегл = РаботаСКурсамиВалют.ПересчитатьВВалюту(Дт.СуммаВзаиморасчетов, Дт.ВалютаВзаиморасчетов, Константы.ВалютаРегламентированногоУчета.Получить(), Основание.Дата);	
