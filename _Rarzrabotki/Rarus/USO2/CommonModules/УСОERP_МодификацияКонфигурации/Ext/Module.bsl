	СтрокаПлатежа = ?(Объект.РасшифровкаПлатежа.Количество(),Объект.РасшифровкаПлатежа.Получить(0),Объект.РасшифровкаПлатежа.Добавить());
	
	СтрокаПлатежа.Партнер = Документ.Субподрядчик;
