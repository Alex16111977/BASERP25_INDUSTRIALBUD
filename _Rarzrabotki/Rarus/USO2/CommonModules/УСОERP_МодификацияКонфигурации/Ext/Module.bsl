	Дт.СуммаРегл = РаботаСКурсамиВалют.ПересчитатьВВалюту(Дт.СуммаВзаиморасчетов, Дт.ВалютаВзаиморасчетов, Константы.ВалютаРегламентированногоУчета.Получить(), Основание.Дата);	
	Дт.СуммаУпр = РаботаСКурсамиВалют.ПересчитатьВВалюту(Дт.СуммаВзаиморасчетов, Дт.ВалютаВзаиморасчетов, Константы.ВалютаУправленческогоУчета.Получить(), Основание.Дата);
	
	Кт = Источник.КредиторскаяЗадолженность.Добавить();
	ЗаполнитьЗначенияСвойств(Кт, Дт);
	Кт.Заказ = ДоговорГУ;
	
