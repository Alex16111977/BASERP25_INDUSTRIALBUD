	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.УСОERP_РеестрДоговоров",       			               "Дата", "УправлениеСтроительнойОрганизацией", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.УСОERP_СдачаОбъектаНедвижимости",    	               "Дата", "УправлениеСтроительнойОрганизацией", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.УСОERP_УстановкаБазыРаспределенияНакладныхРасходов",    "Дата", "УправлениеСтроительнойОрганизацией", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.УСОERP_УстановкаПараметровУчетаПоСтроительству",        "Дата", "УправлениеСтроительнойОрганизацией", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.УСОERP_УстановкаСтоимостиРесурсов",                     "Дата", "УправлениеСтроительнойОрганизацией", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.УСОERP_УтверждениеКалендарногоПланаГрафика",       	   "Дата", "УправлениеСтроительнойОрганизацией", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.УСОERP_УчетВыполненныхРабот",                           "Дата", "УправлениеСтроительнойОрганизацией", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.УСОERP_УчетРаботыСотрудниковТехники",       			   "Дата", "УправлениеСтроительнойОрганизацией", "Организация");
	
КонецПроцедуры

