Процедура ПередДобавлениемКомандОтчетов(КомандыОтчетов, Параметры, СтандартнаяОбработка) Экспорт
	 	
	Если Параметры.ИмяФормы = "Справочник.ДоговорыКонтрагентов.Форма.ФормаЭлемента" 
		ИЛИ  Параметры.ИмяФормы = "Справочник.ДоговорыКонтрагентов.Форма.ФормаСписка" Тогда
		
		Если ПравоДоступа("Просмотр", Метаданные.Отчеты.ВыручкаИСебестоимостьПродаж) Тогда
		
		КомандаОтчет = КомандыОтчетов.Добавить();
		
		КомандаОтчет.Менеджер = Метаданные.Отчеты.УСОERP_ОтчетПоГрафикуДвиженийПоДоговору.ПолноеИмя();
		КомандаОтчет.Представление = НСтр("ru = 'График движения по договору'");
		КомандаОтчет.ФункциональныеОпции = "УСОERP_ИспользоватьУправлениеСтроительнымПроизводством";		
		КомандаОтчет.Важность = "Обычное";
		КомандаОтчет.МножественныйВыбор = Ложь;
		
		КомандаОтчет.ДополнительныеПараметры.Вставить("ИмяКоманды", "ПоДоговору");
		
		КомандаОтчет.КлючВарианта = "Основной";
		
		КомандаОтчет = КомандыОтчетов.Добавить();
		
		КомандаОтчет.Менеджер = Метаданные.Отчеты.УСОERP_ОтчетПоГрафикуДвиженийПоДоговору_НовыйВариант.ПолноеИмя();
		КомандаОтчет.Представление = НСтр("ru = 'График движения по договору (новый вариант)'");
		КомандаОтчет.ФункциональныеОпции = "УСОERP_ИспользоватьУправлениеСтроительнымПроизводством";		
		КомандаОтчет.Важность = "Обычное";
		КомандаОтчет.МножественныйВыбор = Ложь;
		
		КомандаОтчет.ДополнительныеПараметры.Вставить("ИмяКоманды", "ПоДоговору");
		
		КомандаОтчет.КлючВарианта = "Основной";
		
		КонецЕсли;		
				
	КонецЕсли;
	
КонецПроцедуры

Процедура НастроитьВариантыОтчетов(Настройки) Экспорт
	
	ОписаниеОтчета = ВариантыОтчетов.ОписаниеОтчета(Настройки, Метаданные.Отчеты.УСОERP_ОтчетПоГрафикуДвиженийПоДоговору);
	ОписаниеОтчета.ОпределитьНастройкиФормы = Истина;
	
	ОписаниеОтчета = ВариантыОтчетов.ОписаниеОтчета(Настройки, Метаданные.Отчеты.УСОERP_ОтчетПоГрафикуДвиженийПоДоговору_НовыйВариант);
	ОписаниеОтчета.ОпределитьНастройкиФормы = Истина;
	
	ОписаниеОтчета = ВариантыОтчетов.ОписаниеОтчета(Настройки, Метаданные.Отчеты.УСОERP_ОбъемноКалендарныйПланГрафик_НовыйВариант);
	ОписаниеОтчета.ОпределитьНастройкиФормы = Истина;
	
	ОписаниеОтчета = ВариантыОтчетов.ОписаниеОтчета(Настройки, Метаданные.Отчеты.УСОERP_АктированиеОбъектаСтроительства);
	ОписаниеОтчета.ОпределитьНастройкиФормы = Истина;
	
	ОписаниеОтчета = ВариантыОтчетов.ОписаниеОтчета(Настройки, Метаданные.Отчеты.УСОERP_ФинансированиеОбъектаСтроительства);
	ОписаниеОтчета.ОпределитьНастройкиФормы = Истина;
	
	ОписаниеОтчета = ВариантыОтчетов.ОписаниеОтчета(Настройки, Метаданные.Отчеты.АУН_ПродажиПоАренде);
	ОписаниеОтчета.ОпределитьНастройкиФормы = Истина;
	
	ВариантыОтчетов.НастроитьОтчетВМодулеМенеджера(Настройки, Метаданные.Отчеты.УСОERP_ОтчетПоБюджетуОбъектаСтроительства);

	
КонецПроцедуры

