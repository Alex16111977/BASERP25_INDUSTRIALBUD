#Область ОбновлениеИБ

#Область ДопПараметрыПоДоговору
Процедура ЗаполнениеДопПараметровПоДоговору() Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Договор КАК Договор,
	|	МАКСИМУМ(УСОERP_ДополнительныеПараметрыПоДоговору.Дата) КАК Дата
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	Документ.УСОERP_ДополнительныеПараметрыПоДоговору КАК УСОERP_ДополнительныеПараметрыПоДоговору
	|ГДЕ
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Проведен
	|	И УСОERP_ДополнительныеПараметрыПоДоговору.Статус = ЗНАЧЕНИЕ(Перечисление.РезультатыСогласования.Согласовано)
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.Договор КАК Договор,
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВрТабДопПараметры
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_ДополнительныеПараметрыПоДоговору КАК УСОERP_ДополнительныеПараметрыПоДоговору
	|		ПО ВрТаб.Дата = УСОERP_ДополнительныеПараметрыПоДоговору.Дата
	|			И ВрТаб.Договор = УСОERP_ДополнительныеПараметрыПоДоговору.Договор
	|ГДЕ
	|	УСОERP_ДополнительныеПараметрыПоДоговору.Проведен
	|	И УСОERP_ДополнительныеПараметрыПоДоговору.Статус = ЗНАЧЕНИЕ(Перечисление.РезультатыСогласования.Согласовано)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТабДопПараметры.Ссылка КАК Ссылка,
	|	УСОERP_ДоговорСЗаказчиком.ДокументУтверждения КАК ДокументУтверждения
	|ИЗ
	|	ВрТабДопПараметры КАК ВрТабДопПараметры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_ДоговорСЗаказчиком КАК УСОERP_ДоговорСЗаказчиком
	|		ПО ВрТабДопПараметры.Договор = УСОERP_ДоговорСЗаказчиком.Договор
	|ГДЕ
	|	УСОERP_ДоговорСЗаказчиком.Проведен
	|	И УСОERP_ДоговорСЗаказчиком.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|	И УСОERP_ДоговорСЗаказчиком.ДокументУтверждения <> ЗНАЧЕНИЕ(Документ.УСОERP_УтверждениеКалендарногоПланаГрафика.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВрТабДопПараметры.Ссылка,
	|	УСОERP_ДоговорССубподрядчиком.ДокументУтверждения
	|ИЗ
	|	ВрТабДопПараметры КАК ВрТабДопПараметры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_ДоговорССубподрядчиком КАК УСОERP_ДоговорССубподрядчиком
	|		ПО ВрТабДопПараметры.Договор = УСОERP_ДоговорССубподрядчиком.Договор
	|ГДЕ
	|	УСОERP_ДоговорССубподрядчиком.Проведен
	|	И УСОERP_ДоговорССубподрядчиком.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
	|	И УСОERP_ДоговорССубподрядчиком.ДокументУтверждения <> ЗНАЧЕНИЕ(Документ.УСОERP_УтверждениеКалендарногоПланаГрафика.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.Ссылка.ДокументУтверждения) Тогда
			Продолжить;
		КонецЕсли;
		
		Выб = Выборка.Ссылка.ПолучитьОбъект();
		
		Если Выб.ПоРаботам Тогда
			Выб.Детализация = 1;
		КонецЕсли;
		
		Если Выб.ПоВидамРабот Тогда
			Выб.Детализация = 2;
		КонецЕсли;
		
		Выб.ПредусмотреныГарантийныеУдержанияПоДоговору = Истина;
		
		Выб.ДокументУтверждения = Выборка.ДокументУтверждения;  	
		
		Если НЕ ЗначениеЗаполнено(Выб.ДокументУтверждения) Тогда
			
			Выб.ДокументУтверждения = УСОERP_ЗащищенныеФункцииСервер.ПолучитьПоследнийДокументУтверждения(Выб.ОбъектСтроительства,Выб.Организация); 
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выб.ДокументУтверждения) Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден документ утверждения для документа "+Выб.Ссылка);
			Продолжить;
			
		КонецЕсли;
		
		КопияСценария = Выб.ДокументУтверждения.КопияСценария;	
		
		Если НЕ ЗначениеЗаполнено(КопияСценария) Тогда //старый вариант
			Продолжить;
		КонецЕсли;    		
		
		СтруктураОплаты = ПолучитьСтруктуруОплаты(Выб.Договор,Выб.ДокументУтверждения);
		
		Если Выб.ПредусмотреныГарантийныеУдержанияПоДоговору Тогда
			
			ПредыдущийПроцент = Выб.ПроцентГарантийныхУдержаний;
			ПредыдущийСрок = Выб.СрокГарантийныхУдержаний;
			
		Иначе
			
			ПредыдущийПроцент = СтруктураОплаты.ПроцентГарантийныхУдержаний;
			ПредыдущийСрок = СтруктураОплаты.СрокГарантийныхУдержаний;
			
			ПредыдущийПроцент = 0;
			ПредыдущийСрок = 0;

		КонецЕсли;  			
		
		ЗаполнитьЗначенияСвойств(Выб,СтруктураОплаты);
		
	Выб.ПроцентГарантийныхУдержаний = ПредыдущийПроцент;
	Выб.СрокГарантийныхУдержаний =  ПредыдущийСрок;
	
	Разница = 100 - Выб.ПроцентГарантийныхУдержаний-Выб.ПроцентАванса-Выб.ПроцентКредита;
	
	Выб.ПроцентКредита = Макс(0,Выб.ПроцентКредита+Разница);
	
	Разница = 100 - Выб.ПроцентГарантийныхУдержаний-Выб.ПроцентАванса-Выб.ПроцентКредита;
	
	Выб.ПроцентАванса = Макс(0,Выб.ПроцентАванса + Разница);
	
		
		Для Каждого  СтрокаТЧ ИЗ Выб.ПроцентГарантийныхУдержанийПоРаботам Цикл 
			
			НоваяРабота = Справочники.УСОERP_СтроительныеРаботы.ПустаяСсылка();
			
			Если СтрокаТЧ.Работа.Владелец.НомерВерсии = 0  Тогда
				
				НоваяРабота = Справочники.УСОERP_СтроительныеРаботы.НайтиПоРеквизиту("РаботаИсточник",СтрокаТЧ.Работа,,КопияСценария);
				
			Иначе
				
				НоваяРабота = Справочники.УСОERP_СтроительныеРаботы.НайтиПоРеквизиту("РаботаИсточник",СтрокаТЧ.Работа.РаботаИсточник,,КопияСценария);
				
			КонецЕсли;  			
			
			Если ЗначениеЗаполнено(НоваяРабота) Тогда
				
				СтрокаТЧ.Работа = НоваяРабота;
				
			КонецЕсли;
			
			СуммаВсего = 0;
			
			СтрокаТЧ.ПроцентАванса = Выб.ПроцентАванса;
			СтрокаТЧ.СрокАванса = Выб.СрокАванса;
			СтрокаТЧ.ПроцентКредита = Выб.ПроцентКредита;
			СтрокаТч.СрокКредита = Выб.СрокКредита;
			
			СуммаВсего = СтрокаТЧ.ПроцентАванса+СтрокаТЧ.ПроцентКредита+СтрокаТЧ.ЗначениеПроцентаГарантийногоУдержания;
			
			Разница = СуммаВсего-100;
			
			Если Разница < 0 Тогда
				
				СтрокаТЧ.ПроцентКредита = СтрокаТЧ.ПроцентКредита-Разница;
				
			Иначе
				
				МаксКредит = Мин(СтрокаТч.ПроцентКредита,Разница);
				
				СтрокаТЧ.ПроцентКредита = СтрокаТЧ.ПроцентКредита-МаксКредит;
				
				СтрокаТЧ.ПроцентАванса = СтрокаТЧ.ПроцентАванса - (Разница-МаксКредит);
				
			КонецЕсли;
			
		КонецЦикла;   		
		
		Для Каждого  СтрокаТЧ ИЗ Выб.ПроцентГарантийныхУдержанийПоВидамРабот Цикл 					
			
			СуммаВсего = 0;
			
			СтрокаТЧ.ПроцентАванса = Выб.ПроцентАванса;
			СтрокаТЧ.СрокАванса = Выб.СрокАванса;
			СтрокаТЧ.ПроцентКредита = Выб.ПроцентКредита;
			СтрокаТч.СрокКредита = Выб.СрокКредита;
			
			СуммаВсего = СтрокаТЧ.ПроцентАванса+СтрокаТЧ.ПроцентКредита+СтрокаТЧ.ЗначениеПроцентаГарантийногоУдержания;
			
			Разница = СуммаВсего-100;
			
			Если Разница < 0 Тогда
				
				СтрокаТЧ.ПроцентКредита = СтрокаТЧ.ПроцентКредита-Разница;
				
			Иначе
				
				МаксКредит = Мин(СтрокаТч.ПроцентКредита,Разница);
				
				СтрокаТЧ.ПроцентКредита = СтрокаТЧ.ПроцентКредита-МаксКредит;
				
				СтрокаТЧ.ПроцентАванса = СтрокаТЧ.ПроцентАванса - (Разница-МаксКредит);
				
			КонецЕсли;
			
		КонецЦикла; 
		
		Попытка
			Выб.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			Продолжить;
		КонецПопытки;
		
	КонецЦикла;  	
	
КонецПроцедуры

Функция ПолучитьСтруктуруОплаты(Договор, ДокументУтверждения)
	
	СтруктураОплаты = Новый Структура("ПроцентАванса,СрокАванса,ПроцентГарантийныхУдержаний,СрокГарантийныхУдержаний,ПроцентКредита,СрокКредита",0,0,0,0,0,0);
	
	ТаблицаГрафикаОплат = Документы.УСОERP_ДополнительныеПараметрыПоДоговору.ПолучитьПараметрыГрафикаОплатПоДоговору(Договор,ДокументУтверждения);
	
	Для Каждого СтрокаГрафика ИЗ ТаблицаГрафикаОплат Цикл
		
		Если СтрокаГрафика.ВариантОплаты = "Аванс" Тогда
			
			СтруктураОплаты.ПроцентАванса = СтрокаГрафика.ПроцентПлатежа;
			СтруктураОплаты.СрокАванса = СтрокаГрафика.Сдвиг;
			
		КонецЕсли;
		
		Если СтрокаГрафика.ВариантОплаты = "Кредит" Тогда
			
			СтруктураОплаты.ПроцентКредита = СтрокаГрафика.ПроцентПлатежа;
			СтруктураОплаты.СрокКредита = СтрокаГрафика.Сдвиг;
			
		КонецЕсли;
		
		Если СтрокаГрафика.ВариантОплаты = "ГУ" Тогда
			
			СтруктураОплаты.ПроцентГарантийныхУдержаний = СтрокаГрафика.ПроцентПлатежа;
			СтруктураОплаты.СрокГарантийныхУдержаний = СтрокаГрафика.Сдвиг;
			
		КонецЕсли; 		
		
	КонецЦикла;  	
	
	Возврат СтруктураОплаты;
	
КонецФункции

#КонецОбласти    

Процедура ЗаполнитьНаборыДополнительныхРеквизитов() Экспорт
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеРеквизитыИСведения") Тогда
		
		СправочникОбъект = Справочники.НаборыДополнительныхРеквизитовИСведений.Документ_УСОERP_ДоговорСЗаказчиком.ПолучитьОбъект();
		
		Если НЕ СправочникОбъект.Используется Тогда
			
			СправочникОбъект.Используется = Истина;
			СправочникОбъект.Записать();
			
		КонецЕсли;
		
	КонецЕсли;
		
	
КонецПроцедуры

Процедура ЗаполнитьСоглашенияВРегистреГрафикДвиженияПоДоговору() Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
	"ВЫБРАТЬ
	|	УСОERP_ГрафикДвиженийПоДоговору.Регистратор КАК Регистратор,
	|	УСОERP_ГрафикДвиженийПоДоговору.Регистратор.Соглашение КАК Соглашение
	|ИЗ
	|	РегистрНакопления.УСОERP_ГрафикДвиженийПоДоговору КАК УСОERP_ГрафикДвиженийПоДоговору
	|ГДЕ
	|	УСОERP_ГрафикДвиженийПоДоговору.Регистратор ССЫЛКА Документ.УСОERP_ДоговорСЗаказчиком
	|	И (УСОERP_ГрафикДвиженийПоДоговору.Соглашение = ЗНАЧЕНИЕ(Справочник.СоглашенияСКлиентами.ПустаяСсылка)
	|			ИЛИ УСОERP_ГрафикДвиженийПоДоговору.Соглашение = НЕОПРЕДЕЛЕНО)
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ГрафикДвиженийПоДоговору.Регистратор,
	|	УСОERP_ГрафикДвиженийПоДоговору.Регистратор.Соглашение
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УСОERP_ГрафикДвиженийПоДоговору.Регистратор,
	|	УСОERP_ГрафикДвиженийПоДоговору.Регистратор.Соглашение
	|ИЗ
	|	РегистрНакопления.УСОERP_ГрафикДвиженийПоДоговору КАК УСОERP_ГрафикДвиженийПоДоговору
	|ГДЕ
	|	УСОERP_ГрафикДвиженийПоДоговору.Регистратор ССЫЛКА Документ.УСОERP_ДоговорССубподрядчиком
	|	И (УСОERP_ГрафикДвиженийПоДоговору.Соглашение = ЗНАЧЕНИЕ(Справочник.СоглашенияСПоставщиками.ПустаяСсылка)
	|			ИЛИ УСОERP_ГрафикДвиженийПоДоговору.Соглашение = НЕОПРЕДЕЛЕНО)
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ГрафикДвиженийПоДоговору.Регистратор,
	|	УСОERP_ГрафикДвиженийПоДоговору.Регистратор.Соглашение";
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий()  Цикл
		
		НЗ = РегистрыНакопления.УСОERP_ГрафикДвиженийПоДоговору.СоздатьНаборЗаписей();
		НЗ.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НЗ.Прочитать();
		
		Для Каждого СтрокаНЗ ИЗ НЗ Цикл
			
			СтрокаНЗ.Соглашение = Выборка.Соглашение;
			
		КонецЦикла;
		
		НЗ.Записать(Истина);  	
		
	КонецЦикла;  
	
КонецПроцедуры


#КонецОбласти

#Область ДополнительныеОтчетыИОбработки

Процедура ОпределитьРазделыСДополнительнымиОбработками(Разделы) Экспорт
	
	ОбщегоНазначенияУТ.ДобавитьПодсистемуВКоллекцию(Разделы, "УСОERP_АРМБухгалтераОперациониста");
	ОбщегоНазначенияУТ.ДобавитьПодсистемуВКоллекцию(Разделы, "УСОERP_АРМПрораба");
	ОбщегоНазначенияУТ.ДобавитьПодсистемуВКоллекцию(Разделы, "УСОERP_ЗаказчикСтроительства");
	ОбщегоНазначенияУТ.ДобавитьПодсистемуВКоллекцию(Разделы, "УСОERP_ИнвесторСтроительства");
	ОбщегоНазначенияУТ.ДобавитьПодсистемуВКоллекцию(Разделы, "УСОERP_КонтрольСтроительства");
	ОбщегоНазначенияУТ.ДобавитьПодсистемуВКоллекцию(Разделы, "УСОERP_МатериальноТехничнескоеОбеспечение");
	ОбщегоНазначенияУТ.ДобавитьПодсистемуВКоллекцию(Разделы, "УСОERP_ПодрядчикСтроительства");
	ОбщегоНазначенияУТ.ДобавитьПодсистемуВКоллекцию(Разделы, "УСОERP_УправлениеИнвестиционнойДеятельностью"); 	
	ОбщегоНазначенияУТ.ДобавитьПодсистемуВКоллекцию(Разделы, "УСОERP_УправлениеСтроительнымПроизводством"); 
	
КонецПроцедуры

#КонецОбласти

Процедура ЗаполнитьПлатежныйДокументРаботами(ДанныеФормы) Экспорт
	
	ДанныеФормы.УСОERP_РаспределениеПоАналитикеДоговора.Очистить();
	
	Для Каждого СтрокаТЧ ИЗ ДанныеФормы.РасшифровкаПлатежа Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.УСОERP_ДокументУтверждения) Тогда
			Продолжить;
		КонецЕсли;
		
		Договор = СтрокаТЧ.Заказ;
		
		СтруктураДоговора = УСОERP_МодификацияКонфигурации.ПолучитьСтруктуруДоговораДопПараметров(Договор,СтрокаТЧ.УСОERP_ДокументУтверждения.ОбъектСтроительства); 
		
		Если СтруктураДоговора.НеНайден Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтруктураДоговора.ПоРаботам+СтруктураДоговора.ПоВидамРабот = 0 Тогда
			Продолжить;
		КонецЕсли; 		
		
		Сумма = СтрокаТЧ.Сумма;
		
		КопияСценария = СтрокаТЧ.УСОERP_ДокументУтверждения.КопияСценария;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Договор",Договор);
		
		Запрос.УстановитьПараметр("ПоВидамРабот",СтруктураДоговора.ПоВидамРабот);
		Запрос.УстановитьПараметр("ПоРаботам",СтруктураДоговора.ПоРаботам);
		Запрос.УстановитьПараметр("КопияСценария",КопияСценария);
		Дата = ?(ЗначениеЗаполнено(ДанныеФормы.Дата),ДанныеФормы.Дата,ТекущаяДата());
		Запрос.УстановитьПараметр("Дата",Новый Граница(Дата,ВидГраницы.Включая)); 
		
		ПорядокОплаты = Новый Массив;
		
		Если Договор.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем Тогда
			ПорядокОплаты.Добавить(Перечисления.ВариантыОплатыКлиентом.АвансДоОбеспечения);
			ПорядокОплаты.Добавить(Перечисления.ВариантыОплатыКлиентом.КредитПослеОтгрузки);
		Иначе
			ПорядокОплаты.Добавить(Перечисления.ВариантыОплатыПоставщику.АвансДоПодтверждения);
			ПорядокОплаты.Добавить(Перечисления.ВариантыОплатыПоставщику.КредитПослеПоступления);
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ПорядокОплаты",ПорядокОплаты);
				
		Запрос.Текст =
		"ВЫБРАТЬ
		|	УСОERP_ГрафикДвиженийПоДоговоруОстатки.ВидРабот КАК ВидРабот,
		|	УСОERP_ГрафикДвиженийПоДоговоруОстатки.Работа КАК Работа,
		|	УСОERP_ГрафикДвиженийПоДоговоруОстатки.ПорядокОплаты КАК ПорядокОплаты,
		//|	УСОERP_ГрафикДвиженийПоДоговоруОстатки.ДатаСобытияПоДоговору КАК ДатаСобытияПоДоговору,
		|	СУММА(УСОERP_ГрафикДвиженийПоДоговоруОстатки.ФинансированиеПланОстаток) КАК ФинансированиеПланОстаток,
		|	СУММА(УСОERP_ГрафикДвиженийПоДоговоруОстатки.ФинансированиеФактОстаток) КАК ФинансированиеФактОстаток
		|ПОМЕСТИТЬ ВрТаб
		|ИЗ
		|	РегистрНакопления.УСОERP_ГрафикДвиженийПоДоговору.Остатки(
		|			&Дата,
		|			Договор = &Договор
		|				И ПорядокОплаты В (&ПорядокОплаты)
		|				И ВЫБОР
		|					КОГДА &ПоВидамРабот
		|						ТОГДА ВидРабот <> ЗНАЧЕНИЕ(Справочник.УСОERP_ВидыРабот.ПустаяСсылка)
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ
		|				И ВЫБОР
		|					КОГДА &ПоРаботам
		|						ТОГДА Работа <> ЗНАЧЕНИЕ(Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка)
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ) КАК УСОERP_ГрафикДвиженийПоДоговоруОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	УСОERP_ГрафикДвиженийПоДоговоруОстатки.ВидРабот,
		|	УСОERP_ГрафикДвиженийПоДоговоруОстатки.Работа,
		|	УСОERP_ГрафикДвиженийПоДоговоруОстатки.ПорядокОплаты
		//|	,УСОERP_ГрафикДвиженийПоДоговоруОстатки.ДатаСобытияПоДоговору
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТаб.ВидРабот КАК ВидРабот,
		|	ВрТаб.ПорядокОплаты КАК ПорядокРасчетов,
		//|	ВрТаб.ДатаСобытияПоДоговору КАК ДатаСобытияПоДоговору,
		|	СУММА(ВрТаб.ФинансированиеПланОстаток + ВрТаб.ФинансированиеФактОстаток) КАК Остаток,
		|	УСОERP_СтроительныеРаботы.Ссылка КАК Работа,
		|	ЕСТЬNULL(УСОERP_СтроительныеРаботы.ПорядокСортировки, """") КАК ПорядокСортировки
		|ИЗ
		|	ВрТаб КАК ВрТаб
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
		|		ПО ВрТаб.Работа = УСОERP_СтроительныеРаботы.РаботаИсточник
		|ГДЕ
		|	УСОERP_СтроительныеРаботы.Владелец = &КопияСценария
		|
		|СГРУППИРОВАТЬ ПО
		|	ВрТаб.ВидРабот,
		|	ВрТаб.ПорядокОплаты,
		//|	ВрТаб.ДатаСобытияПоДоговору,
		|	УСОERP_СтроительныеРаботы.Ссылка,
		|	ЕСТЬNULL(УСОERP_СтроительныеРаботы.ПорядокСортировки, """")
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВрТаб.ФинансированиеПланОстаток + ВрТаб.ФинансированиеФактОстаток) > 0
		|
		|УПОРЯДОЧИТЬ ПО
	//	|	ДатаСобытияПоДоговору,
		|	ПорядокРасчетов УБЫВ,
		|	ПорядокСортировки,
		|	ВидРабот";
		
		ТЗ = Запрос.Выполнить().Выгрузить();
		
		Для Каждого СтрокаТЗ ИЗ ТЗ Цикл
			
			Если Сумма = 0 Тогда
				Прервать;
			КонецЕсли;  		
			
			Нстр = ДанныеФормы.УСОERP_РаспределениеПоАналитикеДоговора.Добавить();
			Нстр.Работа = СтрокаТЗ.Работа;
			Нстр.ВидРабот = СтрокаТЗ.ВидРабот;
			Нстр.ПорядокРасчетов = СтрокаТЗ.ПорядокРасчетов;
			Нстр.ПорядокДоходовРасходов = "";
			Нстр.Сумма = Мин(Сумма,СтрокаТЗ.Остаток);
			Сумма = Сумма - Нстр.Сумма;
			Нстр.СтатьяДвиженияДенежныхСредств = ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.ПоступлениеОплатыОтКлиента");
			Нстр.СтатьяБюджета = СтруктураДоговора.СтатьяБюджетаОсновногоПлатежа;
			Нстр.Заказ = СтрокаТЧ.Заказ;
			Нстр.ОснованиеПлатежа = "";
			Нстр.ИдентификаторСтроки = СтрокаТЧ.УСО_ERP_ИдентификаторСтроки;
			Нстр.ДокументУтверждения = СтрокаТЧ.УСОERP_ДокументУтверждения;			
			
		КонецЦикла;  		
		
	КонецЦикла;   	
	
КонецПроцедуры


// Преобразует входящий параметр, например:
//  Объект.Склад -> Объект.Склад
//  Объект.Товары.Номенклатура -> Элементы.Товары.ТекущиеДанные.Номенклатура
// Параметры:
//  ВыражениеОбъекта - Строка - 
// 
// Возвращаемое значение:
//   - Строка
//
Функция СформироватьПутьКДанным(ВыражениеОбъекта, ПутьКТабЧасти)
	
	ЭтоОбращениеКТабличнойЧасти = ?(ПутьКТабЧасти = "", 0, СтрНайти(ВыражениеОбъекта, ПутьКТабЧасти));
	ВыражениеОбъектаБезОбращенияКИБ = СтрРазбитьПоТочкеОбращенияКИБ(ВыражениеОбъекта, ЭтоОбращениеКТабличнойЧасти).ПутьКДанным;
	
	Если ЭтоОбращениеКТабличнойЧасти Тогда
		
		ПутьКДанным = СтрЗаменить(ВыражениеОбъектаБезОбращенияКИБ, "Объект.", "Элементы.");
		
		НачалоВторогоСлова = СтрНайти(ПутьКДанным, ".") + 1;
		СимволовВторогоСлова = СтрНайти(Сред(ПутьКДанным, НачалоВторогоСлова), ".") - 1;
		ВтороеСлово = Сред(ПутьКДанным, НачалоВторогоСлова, СимволовВторогоСлова);
		
		ПутьКДанным = СтрЗаменить(ПутьКДанным, ВтороеСлово, ВтороеСлово + ".ТекущиеДанные");
		
	Иначе
		
		ПутьКДанным = ВыражениеОбъектаБезОбращенияКИБ;
		
	КонецЕсли;
	
	Возврат ПутьКДанным;
	
КонецФункции

Функция СтрРазбитьПоТочкеОбращенияКИБ(ПутьКДанным, ЭтоОбращениеКТабличнойЧасти)
	
	РезультатРазбиения = Новый Структура("ПутьКДанным, ОбращениеКИБ", "", "");
	
	// Путь к данным нужно обрезать, чтобы в него не попали обращения через точку от данных к ИБ.
	НомерТочкиОбращенияКИБ = ?(ЭтоОбращениеКТабличнойЧасти, 3, 2);
	НомерСимволаТочкиОбращенияКИБ = СтрНайти(ПутьКДанным, ".", , , НомерТочкиОбращенияКИБ);
	
	Если НомерСимволаТочкиОбращенияКИБ > 0 Тогда
		
		РезультатРазбиения.ПутьКДанным  = Лев(ПутьКДанным, НомерСимволаТочкиОбращенияКИБ - 1);
		РезультатРазбиения.ОбращениеКИБ = Прав(ПутьКДанным, СтрДлина(ПутьКДанным) - НомерСимволаТочкиОбращенияКИБ);
		
	Иначе
		
		РезультатРазбиения.ПутьКДанным = ПутьКДанным;
		
	КонецЕсли;
	
	Возврат РезультатРазбиения;
	
КонецФункции

Процедура ВидТипДокумента(ТипДокумента, ВидДвижения,Вид,Тип) Экспорт
	
	Если ТипДокумента = Тип("ДокументСсылка.УСОERP_РеализацияСтроительныхРабот") Тогда
		Вид="2"; Тип="99";
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.УСОERP_АктПриемкиРабот") Тогда
		Вид = "2";Тип = "99";
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.УСОERP_ДоговорССубподрядчиком") Тогда
		Вид = "2";Тип = "99";
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.УСОERP_ГрафикДвиженийПоДоговору") Тогда
		Вид = "2";Тип = "99"; 	
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.УСОERP_ПокупкаДоли") Тогда
		Вид = "2";Тип = "99"; 
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.УСОERP_РасторжениеПокупкиДоли") Тогда
		Вид = "2";Тип = "99";
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.УСОERP_ДоговорСЗаказчиком") Тогда
		Вид = "2";Тип = "99";
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.УСОERP_ПланПотребностейВМатериалах") Тогда
		Вид = "1";Тип = "99";
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.УСОERP_СдачаОбъектаНедвижимости") Тогда
		Вид = "2";Тип = "99";
	КонецЕсли; 	
	
КонецПроцедуры

Процедура ОбработатьТаблицуПоставок(ТаблицаПланОтгрузокПоставок)Экспорт
	
	 Строки = ТаблицаПланОтгрузокПоставок.НайтиСтроки(Новый Структура("Период",Дата(1,1,1)));
	 
	 Для Каждого НайденнаяСтрока ИЗ Строки Цикл
		 НайденнаяСтрока.Период = НайденнаяСтрока.ДокументРегистратор.Дата;
	 КонецЦикла; 	 

КонецПроцедуры

Процедура СписокТиповРегистраторовПланов(СписокТиповРегистраторовПланов) Экспорт
	
	СписокТиповРегистраторовПланов.Добавить(Тип("ДокументСсылка.УСОERP_РеализацияСтроительныхРабот"));
	СписокТиповРегистраторовПланов.Добавить(Тип("ДокументСсылка.УСОERP_ДоговорСЗаказчиком"));
	СписокТиповРегистраторовПланов.Добавить(Тип("ДокументСсылка.УСОERP_ПокупкаДоли"));
	СписокТиповРегистраторовПланов.Добавить(Тип("ДокументСсылка.УСОERP_РасторжениеПокупкиДоли"));
	СписокТиповРегистраторовПланов.Добавить(Тип("ДокументСсылка.УСОERP_СдачаОбъектаНедвижимости")); 
	СписокТиповРегистраторовПланов.Добавить(Тип("ДокументСсылка.УСОERP_ДоговорССубподрядчиком"));
	
	
КонецПроцедуры
