	ТабРаспределение =  ТекущийОбъект.УСОERP_РаспределениеМатериаловПоРаботам.Выгрузить();
	
	Если НЕ ЗначениеЗаполнено(ТекущийОбъект.Склад.УСОERP_ОбъектСтроительства) ИЛИ 
			
		   ТекущийОбъект.Склад.УСОERP_ОбъектСтроительства.УСОERP_ВестиРаспределениеМатериаловПоРаботам = Ложь
		   ИЛИ  (ТекущийОбъект.Склад.ДатаНачалаОрдернойСхемыПриПоступлении < ТекущийОбъект.Дата И ТекущийОбъект.Склад.ИспользоватьОрдернуюСхемуПриПоступлении)
		   Тогда
		   ТабРаспределение.Очистить();
		   
	   КонецЕсли;
	   
	   Если ТабРаспределение.Количество() Тогда
		   
		   ТабТовары = ТекущийОбъект.Товары.Выгрузить();
		 
		 Запрос = Новый Запрос;
		 Запрос.УстановитьПараметр("ТабТовары",ТабТовары);
		 Запрос.УстановитьПараметр("ТабРаспределение",ТабРаспределение);
		 Запрос.Текст =
		 "ВЫБРАТЬ
		 |	ТаблицаТовары.Номенклатура,
		 |	ТаблицаТовары.Характеристика,
		 |	ВЫРАЗИТЬ(ТаблицаТовары.Назначение КАК Справочник.Назначения) КАК Назначение,
		 |	ТаблицаТовары.Количество
		 |ПОМЕСТИТЬ ВрТабТовары
		 |ИЗ
		 |	&ТабТовары КАК ТаблицаТовары
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |ВЫБРАТЬ
		 |	ТаблицаРаспределение.Номенклатура,
		 |	ТаблицаРаспределение.Характеристика,
		 |	ТаблицаРаспределение.Количество
		 |ПОМЕСТИТЬ ВрТабРаспределено
		 |ИЗ
		 |	&ТабРаспределение КАК ТаблицаРаспределение
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |ВЫБРАТЬ
		 |	ВложенныйЗапрос.Номенклатура,
		 |	ВложенныйЗапрос.Характеристика,
		 |	СУММА(ВложенныйЗапрос.Количество) КАК Количество,
		 |	СУММА(ВложенныйЗапрос.КоличествоРаспределено) КАК КоличествоРаспределено
		 |ИЗ
		 |	(ВЫБРАТЬ
		 |		ВрТабТовары.Номенклатура КАК Номенклатура,
		 |		ВрТабТовары.Характеристика КАК Характеристика,
		 |		ВрТабТовары.Количество КАК Количество,
		 |		0 КАК КоличествоРаспределено
		 |	ИЗ
		 |		ВрТабТовары КАК ВрТабТовары
		 |	ГДЕ
		 |		ВрТабТовары.Назначение.Заказ.ДокументОснование ССЫЛКА Документ.УСОERP_ПланПотребностейВМатериалах
		 |		И ВрТабТовары.Назначение.Заказ.ДокументОснование <> ЗНАЧЕНИЕ(Документ.УСОERP_ПланПотребностейВМатериалах.ПустаяСсылка)
		 |	
		 |	ОБЪЕДИНИТЬ ВСЕ
		 |	
		 |	ВЫБРАТЬ
		 |		ВрТабРаспределено.Номенклатура,
		 |		ВрТабРаспределено.Характеристика,
		 |		0,
		 |		ВрТабРаспределено.Количество
		 |	ИЗ
		 |		ВрТабРаспределено КАК ВрТабРаспределено) КАК ВложенныйЗапрос
		 |
		 |СГРУППИРОВАТЬ ПО
		 |	ВложенныйЗапрос.Номенклатура,
		 |	ВложенныйЗапрос.Характеристика
		 |
		 |ИМЕЮЩИЕ
		 |	СУММА(ВложенныйЗапрос.Количество) <> СУММА(ВложенныйЗапрос.КоличествоРаспределено)";
				 
		 Выборка = Запрос.Выполнить().Выбрать();
		 
		 Если Выборка.Следующий() Тогда
			 ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неверное распределение по работам!",,,,Отказ);
		 КонецЕсли;     
		
		
	КонецЕсли;    
		
	ТабРаспределение.ЗаполнитьЗначения(ТекущийОбъект.Дата,"ДатаПоступления");
	
	
	ТекущийОбъект.УСОERP_РаспределениеМатериаловПоРаботам.Загрузить(ТабРаспределение);	
	
КонецПроцедуры 

