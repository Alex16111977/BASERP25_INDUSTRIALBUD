	Обработчик.Версия              = "1.0.14.1";
	Обработчик.Процедура           = "РегистрыСведений.РасчетНалогаНаИмущество.ПеренестиЛьготыИзРесурсовВИзмерения";
	Обработчик.НачальноеЗаполнение = Ложь;

	Обработчик = Обработчики.Добавить();
	Обработчик.Версия              = "1.0.14.2";
	Обработчик.Процедура           = "Справочники.КлассификаторПродукцииПоВидамДеятельности.ЗаполнитьПредопределенныеДанные";
	Обработчик.НачальноеЗаполнение = Истина;

	Обработчик = Обработчики.Добавить();
	Обработчик.Версия              = "1.0.14.3";
	Обработчик.Процедура           = "Справочники.ОбщероссийскийКлассификаторОсновныхФондов.ОбновитьОКОФ_94";
	Обработчик.НачальноеЗаполнение = Ложь;
	Обработчик.ОбщиеДанные         = Истина;

	Обработчик = Обработчики.Добавить();
	Обработчик.Версия              = "1.0.14.18";
	Обработчик.Процедура           = "РегистрыСведений.РасчетНалогаНаИмущество.ДобавитьЛидирующиеНулиКодВидаИмущества";
	Обработчик.НачальноеЗаполнение = Ложь;

	Обработчик = Обработчики.Добавить();
	Обработчик.Версия              = "1.0.16.4";
	Обработчик.Процедура           = "РегистрыСведений.РасчетТранспортногоНалога.ЗаполнитьДатуРегистрации";
	Обработчик.НачальноеЗаполнение = Ложь;
	Обработчик.Комментарий 		   = НСтр("ru = 'Обновление регистра сведений ""Расчет транспортного налога""';
											|en = 'Update the ""Vehicle tax calculation"" information register'");
	Обработчик.РежимВыполнения 	   = "Отложенно";
