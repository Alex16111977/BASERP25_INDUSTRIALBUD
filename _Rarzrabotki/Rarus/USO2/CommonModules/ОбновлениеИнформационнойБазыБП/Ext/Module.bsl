	Обработчик.Процедура           = "РегистрыСведений.РасчетЗемельногоНалога.ПеренестиКадастровуюСтоимостьИзРесурсовВИзмерения";
	Обработчик.НачальноеЗаполнение = Ложь;
	Обработчик.Комментарий 		   = НСтр("ru = 'Обновление регистра сведений ""Расчет земельного налога""';
