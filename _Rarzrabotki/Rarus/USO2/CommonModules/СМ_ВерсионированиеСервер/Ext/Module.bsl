	//	Смета.УстановитьПометкуУдаления(Истина);
	//	См_СметаВызовСервера.УдалитьДвижения(Ссылка);
	//	УдалениеСметы(Ссылка);
	//КонецЕсли;

	Возврат Ссылка;
	
КонецФункции

Процедура УдалениеСметы(ОбъектУдаления) Экспорт
	
    УстановитьПривилегированныйРежим(Истина);
	
    МассивКУдалению = Новый Массив;
	
	НайтиПоСсылкамРекурсия(ОбъектУдаления,МассивКУдалению);
	
	УдалитьОбъекты(МассивКУдалению,Ложь);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура НайтиПоСсылкамРекурсия(Ссылка,МассивКУдалению)
	МассивСсылок = Новый Массив;
	МассивСсылок.Добавить(Ссылка);
	ТабСсылок = НайтиПоСсылкам(МассивСсылок);
	
	Для Каждого СтрСсылка из ТабСсылок Цикл
		Если ТипЗнч(СтрСсылка.Данные) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета")
			ИЛИ ТипЗнч(СтрСсылка.Данные) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
			Возврат;
		ИначеЕсли ТипЗнч(СтрСсылка.Данные) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета")
			И СтрСсылка.Данные <> СтрСсылка.Ссылка Тогда
			Если ЗначениеЗаполнено(СтрСсылка.Данные.КорректируетСмету) Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Если МассивКУдалению.Найти(Ссылка) = Неопределено Тогда
		МассивКУдалению.Добавить(Ссылка);
	КонецЕсли;
	
	Для Каждого СтрСсылка из ТабСсылок Цикл
		Если Лев(СтрСсылка.Метаданные.ПолноеИмя(),15) = "РегистрСведений"
			ИЛИ Лев(СтрСсылка.Метаданные.ПолноеИмя(),10) = "ПланОбмена" Тогда
			Продолжить;
		КонецЕсли;
		Если СтрСсылка.Данные = СтрСсылка.Ссылка Тогда
			Продолжить;
		КонецЕсли;
		Если Не МассивКУдалению.Найти(СтрСсылка.Данные) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Об = СтрСсылка.Данные.ПолучитьОбъект();
		Об.УстановитьПометкуУдаления(Истина);
		МассивКУдалению.Добавить(СтрСсылка.Данные);
		НайтиПоСсылкамРекурсия(СтрСсылка.Данные,МассивКУдалению);
	КонецЦикла;
КонецПроцедуры

// Возвращает номер последней записанной версии объекта.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка - ссылка на объект информационной базы.
//
// Возвращаемое значение:
//  Число - номер версии объекта.
//
Функция НомерПоследнейВерсии(Ссылка) Экспорт
	
	Если Ссылка.Пустая() Тогда
		Возврат 0;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ВерсииОбъектов.НомерВерсии), 0) КАК НомерВерсии
	|ИЗ
	|	РегистрСведений.СМ_ВерсииОбъектов КАК ВерсииОбъектов
	|ГДЕ
	|	ВерсииОбъектов.Объект = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.НомерВерсии;
	
КонецФункции

// Возвращает структуру, содержащую версию объекта и дополнительную информацию.
//
// Параметры:
//  Ссылка      - Ссылка - ссылка версионируемый объект;
//  НомерВерсии - Число  - номер версии объекта.
//
// Возвращаемое значение - Структура:
//                          ВерсияОбъекта - ДвоичныеДанные - сохраненная версия объекта информационной базы;
//                          АвторВерсии   - Справочник.Пользователи, Справочник.ВнешниеПользователи - 
//                                          пользователь, записавший версию объекта.
//                          ДатаВерсии    - Дата - дата записи версии объекта.
// 
// Примечание:
//  Функция может вызвать исключение, если запись не содержит данных.
//  Функцию требуется вызвать в привилегированном режиме.
//
Функция СведенияОВерсииОбъекта(Ссылка, НомерВерсии, КонтрольнаяСумма,Имя_базы = "") Экспорт
	СообщениеНеУдалосьПолучитьВерсию = НСтр("ru = 'Не удалось получить выбранную версию объекта.'");
	
	// Если Число(НомерВерсии) = НомерПоследнейВерсии(Ссылка) Тогда
	//	ВызватьИсключение НСтр("ru = 'Выбранная версия является текущей.'");
	// КонецЕсли;

	Если ПустаяСтрока(Имя_базы) Тогда
		Имя_базы = СтрокаСоединенияИнформационнойБазы();
	КонецЕсли;
	
	Настройки = РегистрыСведений.СМ_НастройкиВерсионированияОбъектов.Выбрать();
	Настройки.Следующий();

	Если Настройки.ХранитьВоВнешнейБазе <> Неопределено И Настройки.ХранитьВоВнешнейБазе Тогда
//	Если Настройки.ХранитьВоВнешнейБазе Тогда
		
		ServerName=СокрЛП(Настройки.СерверSQL);   // имя или IP-адрес сервера
		
		DSN=СокрЛП(Настройки.ИмяБазы);       // имя базы данных
		
		UID=СокрЛП(Настройки.ЛогинSQL);   // логин пользователя
		
		PWD=СокрЛП(Настройки.ПарольSQL);               // пароль
		
		ConnectString="Provider=SQLOLEDB;Data Source="+ServerName+";DatabaseName="+DSN+";Initial Catalog="+DSN+";UID="+UID+";PWD="+PWD;
		Соединение=Новый COMОбъект("ADODB.Connection");
		Соединение.ConnectionTimeOut=600;
		Попытка              
			Соединение.Open(ConnectString); 
		Исключение
			ВызватьИсключение НСтр("ru = 'Не удалось соединиться с базой данных!'");
		КонецПопытки;
		
		Cmd=Новый COMОбъект("ADODB.Command");
		Rs=Новый COMОбъект("ADODB.RecordSet");
		Cmd.ActiveConnection=Соединение;
		Cmd.CommandTimeOut=600;
		Cmd.CommandType=1;   //запрос на языке SQL
		
		ТекстЗапроса = "SELECT [Smeta]
		|,[Numvers]
		|,[Version]
		|,[Date]
		|,[Summ]
		|,[Name_db]
		|FROM [dbo].[LocalSmets]
		|WHERE ((([dbo].[LocalSmets].Smeta = #смета#) AND ([dbo].[LocalSmets].Numvers = #номер#) AND ([dbo].[LocalSmets].Summ = '#контроль#') AND ([dbo].[LocalSmets].Name_db = '#имя_базы#')))";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#смета#",ПолучитьGUIDПоУИД(Ссылка.УникальныйИдентификатор()));
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#номер#",НомерВерсии);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#контроль#",КонтрольнаяСумма);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#имя_базы#",Имя_базы);
		
		Cmd.Commandtext=СокрЛП(ТекстЗапроса);
		
		Попытка
			Rs.ActiveConnection=Соединение;
			Rs=Cmd.Execute();
		Исключение
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ВызватьИсключение ПредставлениеОшибки;
		КонецПопытки;
		
		Если Rs.EOF() Тогда
			ВызватьИсключение СообщениеНеУдалосьПолучитьВерсию;
		КонецЕсли;
		
		мСтруктура = Новый Структура;
		мПоля = Rs.Fields.Count - 1;
		Rs.MoveFirst();
		
		Для сч = 0 По мПоля Цикл
			мСтруктура.Вставить(Rs.Fields(сч).Name, Rs.Fields(сч).Value);
		КонецЦикла; 
		
		Результат = Новый Структура("ВерсияОбъекта, АвторВерсии, ДатаВерсии, Комментарий");
		Результат.ВерсияОбъекта = Base64Значение(мСтруктура.Version);
		Результат.ДатаВерсии = мСтруктура.Date;
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВерсииОбъектов.АвторВерсии КАК АвторВерсии,
		|	ВерсииОбъектов.ДатаВерсии КАК ДатаВерсии,
		|	ВерсииОбъектов.Комментарий КАК Комментарий,
		|	ВерсииОбъектов.ВерсияОбъекта,
		|	ВерсииОбъектов.КонтрольнаяСумма
		|ИЗ
		|	РегистрСведений.СМ_ВерсииОбъектов КАК ВерсииОбъектов
		|ГДЕ
		|	ВерсииОбъектов.Объект = &Ссылка
		|	И ВерсииОбъектов.НомерВерсии = &НомерВерсии
		|	И ВерсииОбъектов.КонтрольнаяСумма = &КонтрольнаяСумма";
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.УстановитьПараметр("НомерВерсии", Число(НомерВерсии));
		Запрос.УстановитьПараметр("КонтрольнаяСумма", КонтрольнаяСумма);
		
		Результат = Новый Структура("ВерсияОбъекта, АвторВерсии, ДатаВерсии, Комментарий");
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(Результат, Выборка);
			Результат.ВерсияОбъекта = Результат.ВерсияОбъекта.Получить();
		КонецЕсли;
	КонецЕсли;
	
	Если Результат.ВерсияОбъекта = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Выбранная версия объекта отсутствует в программе.'");
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

// Возвращает двоичные данные.
//
// Параметры:
//  СсылкаНаОбъект - ЛюбаяСсылка - ссылка на объект информационной базы.
//
// Возвращаемое значение:
//  Результат - двоичные данные.
//
Функция ДанныеДляХранения(СсылкаНаОбъект) Экспорт
	Результат = "";
	Обработка = Обработки.СМ_ОбменДаннымиСмета3_0.Создать();
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ТаблицаВыгрузки = Новый ТаблицаЗначений;
	ТаблицаВыгрузки.Колонки.Добавить("Документ");
	ТаблицаВыгрузки.Колонки.Добавить("Сортировка");
	ТаблицаВыгрузки.Колонки.Добавить("ИдРодителя");
	ТаблицаВыгрузки.Колонки.Добавить("НаименованиеАрхива");
	ТаблицаВыгрузки.Колонки.Добавить("ДокументАрхива");
	Обработка.ВыгрузитьДокументы(СсылкаНаОбъект, ТаблицаВыгрузки, Неопределено, Неопределено, Неопределено,Результат,ИмяВременногоФайла,Истина);
	Возврат Результат;
	
КонецФункции

Функция РазмерДанных(Данные) Экспорт
	Возврат Base64Значение(СериализаторXDTO.XMLСтрока(Данные)).Размер();
КонецФункции

// Контрольная сумма по алгоритму MD5.
Функция КонтрольнаяСумма(Данные) Экспорт
	ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.MD5);
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		ХешированиеДанных.Добавить(Данные.Объект);
		Если Данные.Свойство("ДополнительныеРеквизиты") Тогда
			ХешированиеДанных.Добавить(ОбщегоНазначения.ЗначениеВСтрокуXML(Данные.ДополнительныеРеквизиты));
		КонецЕсли;
	Иначе
		ХешированиеДанных.Добавить(Данные);
	КонецЕсли;
	
	Возврат СтрЗаменить(ХешированиеДанных.ХешСумма, " ", "");
КонецФункции

// Преобразует строку УИДа в строку GUID'а
//
Функция ПолучитьGUIDПоУИД(Знач УИД) Экспорт
    
    УИД_0 = СтрЗаменить(УИД, "-", "");
    GUID  = "0x" + ВРег(Сред(УИД_0, 17, 4) + Прав(УИД_0, 12) + Сред(УИД_0, 13, 4) + Сред(УИД_0, 9, 4) + Лев(УИД_0, 8));
        
    Возврат GUID; 
    
КонецФункции

// Преобразует строку GUID'а в строку УИДа
//
Функция ПолучитьУИДПоGUID(Знач GUID) Экспорт
    
    GUID = Прав(GUID, СтрДлина(GUID) - 2);
    УИД = НРег(Строка(Прав(GUID, 8) + "-" + Сред(GUID, 21, 4) + "-" + Сред(GUID, 17, 4) + "-" + Лев(GUID, 4)  + "-" + Сред(GUID, 5, 12)));
    
    Возврат УИД;
    
КонецФункции 

Функция РазборВерсии(Ссылка, НомерВерсии,Записывать = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВерсииОбъектов.АвторВерсии КАК АвторВерсии,
	|	ВерсииОбъектов.ДатаВерсии КАК ДатаВерсии,
	|	ВерсииОбъектов.Комментарий КАК Комментарий,
	|	ВерсииОбъектов.ВерсияОбъекта,
	|	ВерсииОбъектов.КонтрольнаяСумма,
	|	ВерсииОбъектов.ИмяБазы
	|ИЗ
	|	РегистрСведений.СМ_ВерсииОбъектов КАК ВерсииОбъектов
	|ГДЕ
	|	ВерсииОбъектов.Объект = &Ссылка
	|	И ВерсииОбъектов.НомерВерсии = &НомерВерсии";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("НомерВерсии", Число(НомерВерсии));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СведенияОВерсии = СведенияОВерсииОбъекта(Ссылка, НомерВерсии, Выборка.КонтрольнаяСумма,Выборка.ИмяБазы);
	Иначе
		ВызватьИсключение НСтр("ru = 'Выбранная версия объекта отсутствует в программе.'");
	КонецЕсли;

	Результат = ПолучитьПредставлениеОбъектаXML(Ссылка,СведенияОВерсии.ВерсияОбъекта,Записывать);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПредставлениеОбъектаXML(Ссылка,ДанныеВерсии,Записывать) Экспорт
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ДанныеВерсии.Записать(ИмяВременногоФайла);
	Обработка = Обработки.СМ_ОбменДаннымиСмета3_0.Создать();
	
	ТаблицаДанных = Обработка.ЗагрузитьОбразыДокументов(ИмяВременногоФайла,Записывать);

	Возврат ТаблицаДанных;
КонецФункции

#КонецОбласти


