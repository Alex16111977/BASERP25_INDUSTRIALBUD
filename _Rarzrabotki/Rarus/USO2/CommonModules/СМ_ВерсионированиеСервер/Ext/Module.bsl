		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#номер#",НомерПоследнейВерсии(Ссылка)+1);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#версия#",СтрокаДанных);
