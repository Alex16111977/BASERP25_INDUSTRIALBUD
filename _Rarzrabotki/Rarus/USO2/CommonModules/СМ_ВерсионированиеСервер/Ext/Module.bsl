#Область СлужебныеПроцедурыИФункции

Процедура СМ_СохранятьСостояние() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	СМ_ЛокальнаяСмета.Ссылка
	                |ИЗ
	                |	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	                |ГДЕ
	                |	НЕ СМ_ЛокальнаяСмета.ПометкаУдаления
	                |УПОРЯДОЧИТЬ ПО
	                |	СМ_ЛокальнаяСмета.МоментВремени";
	Выборка = Запрос.Выполнить().Выбрать();
		
	Настройки = РегистрыСведений.СМ_НастройкиВерсионированияОбъектов.Выбрать();
	Настройки.Следующий();

	Если Настройки.ХранитьВоВнешнейБазе Тогда
		ЗаписатьВерсииОбъектов(Выборка,Настройки);
	Иначе
		Пока Выборка.Следующий() Цикл
			ЗаписатьВерсиюОбъекта(Выборка.Ссылка,Настройки);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура СМ_ОчисткаИсторииСостояния() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	ГраницыУдаленияОбъектов = ГраницыУдаленияОбъектов();
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВерсииОбъектов.Объект,
	|	ВерсииОбъектов.НомерВерсии,
	|	ВерсииОбъектов.ИмяБазы
	|ИЗ
	|	РегистрСведений.СМ_ВерсииОбъектов КАК ВерсииОбъектов
	|ГДЕ
	|	&ДополнительныеУсловия";
	
	ДополнительныеУсловия = "
	|	ВерсииОбъектов.ДатаВерсии < &ГраницаУдаления";
	Запрос.УстановитьПараметр("ГраницаУдаления", ГраницыУдаленияОбъектов[0].ГраницаУдаления);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДополнительныеУсловия", ДополнительныеУсловия);
	
	Запрос.Текст = ТекстЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.СМ_ВерсииОбъектов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Объект = Выборка.Объект;
		МенеджерЗаписи.НомерВерсии = Выборка.НомерВерсии;
		МенеджерЗаписи.ИмяБазы = Выборка.ИмяБазы;
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.Удалить();
	КонецЦикла;
КонецПроцедуры

Функция ГраницыУдаленияОбъектов()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ГраницаУдаления", Новый ОписаниеТипов("Дата"));
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	НастройкиВерсионированияОбъектов.СрокХраненияВерсий КАК СрокХраненияВерсий
	|ИЗ
	|	РегистрСведений.СМ_НастройкиВерсионированияОбъектов КАК НастройкиВерсионированияОбъектов
	|
	|УПОРЯДОЧИТЬ ПО
	|	СрокХраненияВерсий";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	ВыборкаОбъектов = Запрос.Выполнить().Выбрать();
	Если ВыборкаОбъектов.Следующий() Тогда
		СоответствиеГраницыТипамОбъектов = Результат.Добавить();
		СоответствиеГраницыТипамОбъектов.ГраницаУдаления = ГраницаУдаления(ВыборкаОбъектов.СрокХраненияВерсий);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ГраницаУдаления(СрокХраненияВерсий)
	Если СрокХраненияВерсий = Перечисления.СрокиХраненияВерсий.ЗаПоследнийГод Тогда
		Возврат ДобавитьМесяц(ТекущаяДатаСеанса(), -12);
	ИначеЕсли СрокХраненияВерсий = Перечисления.СрокиХраненияВерсий.ЗаПоследниеШестьМесяцев Тогда
		Возврат ДобавитьМесяц(ТекущаяДатаСеанса(), -6);
	ИначеЕсли СрокХраненияВерсий = Перечисления.СрокиХраненияВерсий.ЗаПоследниеТриМесяца Тогда
		Возврат ДобавитьМесяц(ТекущаяДатаСеанса(), -3);
	ИначеЕсли СрокХраненияВерсий = Перечисления.СрокиХраненияВерсий.ЗаПоследнийМесяц Тогда
		Возврат ДобавитьМесяц(ТекущаяДатаСеанса(), -1);
	ИначеЕсли СрокХраненияВерсий = Перечисления.СрокиХраненияВерсий.ЗаПоследнююНеделю Тогда
		Возврат ТекущаяДатаСеанса() - 7*24*60*60;
	Иначе // СрокХраненияВерсий = Перечисления.СрокиХраненияВерсий.Бессрочно
		Возврат '000101010000';
	КонецЕсли;
КонецФункции

Процедура ОбработатьОбъект(Объект,РежимЗаписи) Экспорт
	Если ПолучитьФункциональнуюОпцию("СМ_ХранитьИсториюИзмененияСмет")
		И Объект.ПометкаУдаления = Объект.Ссылка.ПометкаУдаления Тогда
		
		Настройки = РегистрыСведений.СМ_НастройкиВерсионированияОбъектов.Выбрать();
		Если Не Настройки.Следующий() Тогда
			Возврат;
		КонецЕсли;
		
		Если РежимЗаписи = РежимЗаписиДокумента.Запись
			И Настройки.СохранятьПриЗаписи Тогда
			Объект.ДополнительныеСвойства.Вставить("СохранятьПриЗаписи",Истина);
		ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.Проведение
			И Настройки.СохранятьПриУтверждении Тогда
			Объект.ДополнительныеСвойства.Вставить("СохранятьПриУтверждении",Истина);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

Функция СохранятьПриЗаписиПодчиненного() Экспорт
	Если ПолучитьФункциональнуюОпцию("СМ_ХранитьИсториюИзмененияСмет") Тогда
		
		Настройки = РегистрыСведений.СМ_НастройкиВерсионированияОбъектов.Выбрать();
		Если Не Настройки.Следующий() Тогда
			Возврат Ложь;
		Иначе
			Возврат Настройки.СохранятьПриИзмененииПодчиненных;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

Функция СохранятьПриПересчете() Экспорт
	Если ПолучитьФункциональнуюОпцию("СМ_ХранитьИсториюИзмененияСмет") Тогда
		
		Настройки = РегистрыСведений.СМ_НастройкиВерсионированияОбъектов.Выбрать();
		Если Не Настройки.Следующий() Тогда
			Возврат Ложь;
		Иначе
			Возврат Настройки.СохранятьПриПересчете;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

Процедура СМ_ЗаписатьВерсиюСметыПриЗаписи(Источник, Отказ) Экспорт
	Если Не Отказ И Источник.ДополнительныеСвойства.Свойство("СохранятьПриЗаписи") Тогда
		ЗаписатьВерсиюОбъекта(Источник.Ссылка);
	КонецЕсли;
КонецПроцедуры

Процедура СМ_ЗаписатьВерсиюСметыПроведениеОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	Если Не Отказ И Источник.ДополнительныеСвойства.Свойство("СохранятьПриУтверждении") Тогда
		ЗаписатьВерсиюОбъекта(Источник.Ссылка);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьВерсииОбъектов(Выборка,Настройки) Экспорт
	Имя_базы = СтрокаСоединенияИнформационнойБазы();
	
	ServerName=СокрЛП(Настройки.СерверSQL);   // имя или IP-адрес сервера
	
	DSN=СокрЛП(Настройки.ИмяБазы);       // имя базы данных
	
	UID=СокрЛП(Настройки.ЛогинSQL);   // логин пользователя
	
	PWD=СокрЛП(Настройки.ПарольSQL);               // пароль
	
	ConnectString="Provider=SQLOLEDB;Data Source="+ServerName+";DatabaseName="+DSN+";Initial Catalog="+DSN+";UID="+UID+";PWD="+PWD;
	Соединение=Новый COMОбъект("ADODB.Connection");
	Соединение.ConnectionTimeOut=600;
	Попытка              
		Соединение.Open(ConnectString); 
	Исключение
		Событие = НСтр("ru = 'Запись версии смета в SQL'");
		ЗаписьЖурналаРегистрации(Событие,УровеньЖурналаРегистрации.Ошибка,,,НСтр("ru = 'Не удалось соединиться с базой данных!'"));
		Возврат;
	КонецПопытки;
	
	Cmd=Новый COMОбъект("ADODB.Command");
	Rs=Новый COMОбъект("ADODB.RecordSet");
	Cmd.ActiveConnection=Соединение;
	Cmd.CommandTimeOut=600;
	Cmd.CommandType=1;   //запрос на языке SQL
	Rs.ActiveConnection=Соединение;
	
	Пока Выборка.Следующий() Цикл
		Ссылка = Выборка.Ссылка;
		ДанныеВерсии = ДанныеДляХранения(Ссылка);
		СтрокаДанных = Base64Строка(ДанныеВерсии);
		КонтрольнаяСумма = КонтрольнаяСумма(ДанныеВерсии);
		НомерВерсии = НомерПоследнейВерсии(Ссылка)+1;
		ТекстЗапроса = "INSERT INTO [dbo].[LocalSmets]
		|([Smeta]
		|,[Numvers]
		|,[Version]
		|,[Date]
		|,[Summ]
		|,[Name_db])
		|VALUES (#смета#, #номер#, '#версия#', '#дата#', '#контроль#', '#имя_базы#')";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#смета#",ПолучитьGUIDПоУИД(Ссылка.УникальныйИдентификатор()));
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#номер#",НомерВерсии);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#версия#",СтрокаДанных);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#дата#",ТекущаяДатаСеанса());
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#контроль#",КонтрольнаяСумма);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#имя_базы#",Имя_базы);
		
		Cmd.Commandtext=СокрЛП(ТекстЗапроса);
		
		Попытка
			Rs=Cmd.Execute();
		Исключение
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Событие = НСтр("ru = 'Запись версии смета в SQL'");
			ЗаписьЖурналаРегистрации(Событие,УровеньЖурналаРегистрации.Ошибка,,,ПредставлениеОшибки);
			Возврат;
		КонецПопытки;
		МенеджерЗаписи = РегистрыСведений.СМ_ВерсииОбъектов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Объект = Ссылка;
		МенеджерЗаписи.ИмяБазы = Имя_базы;
		МенеджерЗаписи.НомерВерсии = НомерВерсии;
		МенеджерЗаписи.АвторВерсии = Пользователи.ТекущийПользователь();
		МенеджерЗаписи.ДатаВерсии = ТекущаяДатаСеанса();
		МенеджерЗаписи.КонтрольнаяСумма = КонтрольнаяСумма;
		МенеджерЗаписи.Записать(Ложь);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьВерсиюОбъекта(Ссылка,Настройки = Неопределено,Комментарий = "") Экспорт
	
	Если Настройки = Неопределено Тогда
		Настройки = РегистрыСведений.СМ_НастройкиВерсионированияОбъектов.Выбрать();
		Настройки.Следующий();
	КонецЕсли;	
	
	Имя_базы = СтрокаСоединенияИнформационнойБазы();
	Если Настройки.ХранитьВоВнешнейБазе <> Неопределено И Настройки.ХранитьВоВнешнейБазе Тогда
