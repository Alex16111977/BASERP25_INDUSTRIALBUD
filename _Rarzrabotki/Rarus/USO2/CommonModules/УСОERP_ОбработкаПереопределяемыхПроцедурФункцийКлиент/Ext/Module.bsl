
#Область ПрограммныйИнтерфейс

// Открывает форму обработки заполнения табличной части.
//
// Параметры:
// 	Форма - форма, из обработчика события которой происходит вызов процедуры.
//  Команда	- КомандаФормы - команда формы
//  ДополнительныеПараметры	- Структура - дополнительные параметры
//
Процедура ОткрытьФормуОбработкиУСОERP_ОтражениеУслугГенподрядчикаЗаказчика (Форма, Команда, ДополнительныеПараметры) Экспорт
	Если Команда.Имя= "ЗаполнитьУслугиГенподрядчика" Или Команда.Имя= "ЗаполнитьУслугиЗаказчика" Тогда
		
		ДокументОбъект = Форма.Объект;
		ПередаваемыеПараметры = Новый Структура;
		ПередаваемыеПараметры.Вставить("ДокументОбъект", ДокументОбъект);
		ПередаваемыеПараметры.Вставить("Команда", Команда.Имя);
		ПередаваемыеПараметры.Вставить("Дата", ДокументОбъект.Дата);
		ПередаваемыеПараметры.Вставить("Договор", ДокументОбъект.Договор);
		ПередаваемыеПараметры.Вставить("Организация", ДокументОбъект.Организация);
		ПередаваемыеПараметры.Вставить("Контрагент", ДокументОбъект.Контрагент);
		ПередаваемыеПараметры.Вставить("Соглашение", ДокументОбъект.Соглашение);
		Если Не РеквизитыЗаполнены(ДокументОбъект) Тогда
			Возврат;
		КонецЕсли;
		
		// очищать табличную часть
		Если Форма.Объект.Товары.Количество()> 0 Тогда
			ТекстВопроса = НСтр("ru='Очистить табличную часть «Товары»?'");
			ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗаполнениемОчистить", ЭтотОбъект, ПередаваемыеПараметры);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Иначе
			ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуПодбора", ЭтотОбъект, ДокументОбъект);
			// {УСО 2.1}:{Управление строительной организацией}{Мокшанов А.О.} {{
			ОткрытьФорму("Обработка.УСОERP_ОтражениеУслугГенподрядчикаЗаказчика.Форма.Форма",ПередаваемыеПараметры,,,,,ОписаниеОповещения);
			//УСОERP_ЗащищенныеФункцииКлиент.ОткрытьФормуЗащищенногоОбъекта("УСОERP_ДанныеСЛК.УСОERP_ОтражениеУслугГенподрядчикаЗаказчика",,ПередаваемыеПараметры,,,,,ОписаниеОповещения);
			// {УСО 2.1}:{Управление строительной организацией}{Мокшанов А.О.} }}
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

// Обработка оповещения от диалга вопроса об очистке табличной части.
//
// Параметры:
//  ОтветНаВопрос  – результат выбора пользователя;
//  Параметры      – дополнительные параметры.
//
Процедура ПередЗаполнениемОчистить(ОтветНаВопрос, Параметры) Экспорт
	Если ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	ДокументОбъект = Параметры.ДокументОбъект;
	ДокументОбъект.Товары.Очистить();
	ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуПодбора", ЭтотОбъект, Параметры.ДокументОбъект);
	// {УСО 2.1}:{Управление строительной организацией}{Мокшанов А.О.} {{
	ОткрытьФорму("Обработка.УСОERP_ОтражениеУслугГенподрядчикаЗаказчика.Форма.Форма", Параметры,,,,,ОписаниеОповещения);
	//УСОERP_ЗащищенныеФункцииКлиент.ОткрытьФормуЗащищенногоОбъекта("УСОERP_ДанныеСЛК.УСОERP_ОтражениеУслугГенподрядчикаЗаказчика",,Параметры,,,,,ОписаниеОповещения);
	// {УСО 2.1}:{Управление строительной организацией}{Мокшанов А.О.} }}
КонецПроцедуры

// Проверяет заполнение свойств основного реквизита формы.
//
// Параметры:
//  ОбъектФормы  – основной рекфизит формы.
//
// Возвращаемое значение:
//               – Булево – заполнение корректно - Истина, не корректно - Ложь.
//                 <продолжение описания значения>;
//
Функция РеквизитыЗаполнены(ОбъектФормы) Экспорт
	флагОткрытьФорму = Истина;
	Если Не ЗначениеЗаполнено(ОбъектФормы.Организация) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Не заполнено поле «Организация». Табличная часть не может быть заполнена.'"));
		флагОткрытьФорму = Ложь;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ОбъектФормы.Партнер) Тогда	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Не заполнено поле «Партнер». Табличная часть не может быть заполнена.'"));
		флагОткрытьФорму = Ложь;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ОбъектФормы.Контрагент) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Не заполнено поле «Контрагент». Табличная часть не может быть заполнена.'"));
		флагОткрытьФорму = Ложь;
	КонецЕсли;	
	
	Возврат флагОткрытьФорму;
КонецФункции	

// Обработчик оповещения от формы обработки УСОERP_ОтражениеУслугГенподрядчикаЗаказчика.
//
// Параметры:
//  Результат       – результат выбораю
//  ДокументОбъект  – объект из формы которого вызван подбор
//
Процедура ОткрытьФормуПодбора(Результат, ДокументОбъект) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда 
		
		СтрокаТовары = ДокументОбъект.Товары.Добавить();
		СтрокаТовары.Номенклатура	= Результат.Номенклатура;
		СтрокаТовары.Сумма  		= Результат.СуммаСНДС;
		СтрокаТовары.СуммаНДС		= Результат.СуммаНДС;
		СтрокаТовары.СтавкаНДС		= Результат.СтавкаНДС;
		СтрокаТовары.КоличествоУпаковок  = 1;
		СтрокаТовары.Количество     = 1;		
		
		Если ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			
			СтруктураПересчетаЦены  = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруПересчетаЦеныСкидкиВПродажахВТЧ(ДокументОбъект);
			//СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект);
			СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект);
			
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ПересчитатьЦенуСкидкуПоСуммеВПродажах", СтруктураПересчетаЦены);
			СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
			СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
			СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
			СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
			
			ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтрокаТовары, СтруктураДействий, Неопределено);
			
		ИначеЕсли	ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
			
			//СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект);
			СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект);
			
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ПересчитатьЦенуСкидкуПоСуммеВЗакупках",  ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруПересчетаЦеныСкидкиВЗакупкахВТЧ(ДокументОбъект, ДокументОбъект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПриемНаКомиссию")));
			СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
			СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
			СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
			СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
			
			ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтрокаТовары, СтруктураДействий, Неопределено);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЗависимыеРеквизиты()
	
	Возврат Новый Структура(
	"БезВозвратнойТары",
	"Сумма,СуммаНДС,СуммаСНДС,СуммаАвтоматическойСкидки,СуммаРучнойСкидки");
	
КонецФункции

#КонецОбласти

Процедура РаспределениеМатериаловПоСтроительнымРаботам(ТаблицаПоРаботам,ДопПараметры) Экспорт
	
	Если ТаблицаПоРаботам = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры.Форма.Модифицированность = Истина;
	ДопПараметры.Форма.Объект.УСОERP_РаспределениеМатериаловПоРаботам.Очистить();
	
	Для Каждого СтрокаПоРаботам ИЗ ТаблицаПоРаботам Цикл
		
		Нстр = ДопПараметры.Форма.Объект.УСОERP_РаспределениеМатериаловПоРаботам.Добавить();
		
		ЗаполнитьЗначенияСвойств(Нстр,СтрокаПоРаботам);
		Нстр.Количество = СтрокаПоРаботам.КоличествоРаспределено;
		
	КонецЦикла;
	
	
	
	
	
КонецПроцедуры

