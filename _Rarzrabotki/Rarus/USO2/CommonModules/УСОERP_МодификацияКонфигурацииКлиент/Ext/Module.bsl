#Область ПрограммныйИнтерфейс

// Процедура предназначена для обработки добавленных команд форм в рамках подсистемы АрендаНедвижимости.
Процедура ВыполнитьПереопределяемуюКоманду(Форма, Команда, ДополнительныеПараметры) Экспорт
	
	Если Форма.ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ПриобретениеТоваровУслуг.Форма.ФормаДокумента" Тогда 		
	
		УСОERP_ОбработкаПереопределяемыхПроцедурФункцийКлиент.ОткрытьФормуОбработкиУСОERP_ОтражениеУслугГенподрядчикаЗаказчика(Форма, Команда, ДополнительныеПараметры);
		
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Документ.ЗаказНаВнутреннееПотребление.Форма.ФормаСписка"
		ИЛИ Форма.ИмяФормы = "Документ.ЗаказНаВнутреннееПотребление.Форма.УСОERP_ФормаСписка" тогда
		
		Если Команда.Имя = "УСОERP_ПоказатьВсеЗаказыВключаяПоУСО" + СокрЛП(Форма.УникальныйИдентификатор)
			ИЛИ	Команда.Имя = "УСОERP_ПоказатьВсеЗаказыВключаяПоУСО" Тогда    
			УСОERP_МатериальноТехническоеОбеспечениеКлиент.Подключаемый_УСОERP_ПоказатьВсеЗаказыВключаяПоУСО(Форма, Команда, ДополнительныеПараметры);
		КонецЕсли;
		
	ИначеЕсли  Форма.ИмяФормы = "Документ.ПриобретениеУслугПрочихАктивов.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ПриобретениеУслугПрочихАктивов.Форма.УСОERP_ФормаДокумента" тогда
		
		Если Команда.Имя = "УСОERP_ЗатратыНаДоставку" + СокрЛП(Форма.УникальныйИдентификатор)
			ИЛИ	Команда.Имя = "УСОERP_ЗатратыНаДоставку" Тогда    
			УСОERP_МатериальноТехническоеОбеспечениеКлиент.Подключаемый_УСОERP_ЗатратыНаДоставку(Форма, Команда, ДополнительныеПараметры);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Справочник.ДоговорыКонтрагентов.Форма.ФормаЭлемента" Тогда
		
		ИмяКоманды = Команда.Имя;
		
		ДанныеОбъекта = Форма.Объект;
		
		Если ИмяКоманды =  "ДоговорДолевогоСтроительства" Тогда	
			
			Если ДанныеОбъекта.УСОERP_ДоговорДолевогоСтроительства Тогда 
				
				ДанныеОбъекта.УСОERP_АгентскийДоговор = Ложь;
				
			КонецЕсли;	
			
		КонецЕсли;
		
		Если ИмяКоманды = "АгентскийДоговор" Тогда
			
			Если ДанныеОбъекта.УСОERP_АгентскийДоговор Тогда 
				
				ДанныеОбъекта.УСОERP_ДоговорДолевогоСтроительства = Ложь;
				
			КонецЕсли;
			
		КонецЕсли;
		
		КопироватьДанныеФормы(ДанныеОбъекта,Форма.Объект);
		
		Форма.Модифицированность = Истина;
		
		Форма.Элементы.УсловияАгентскогоДоговора.Видимость = ДанныеОбъекта.УСОERP_АгентскийДоговор;
		Форма.Элементы.РазмерВознаграждения.Видимость = ДанныеОбъекта.УСОERP_АгентскийДоговор;
		Форма.Элементы.ТипЦены.Видимость =  (ДанныеОбъекта.УСОERP_АгентскийДоговор ИЛИ  ДанныеОбъекта.УСОERP_ДоговорДолевогоСтроительства);
		
	КонецЕсли; 	
	
	#Область ПрочиеДоходыРасходы
	
	Если Команда.Имя = "УСОERP_ПрочиеДоходыРасходы_ЗаполнитьНЗП" Тогда
		
		ДанныеОбъекта = Форма.Объект;
		УСОERP_ЗащищенныеФункцииСервер.УСОERP_ПрочиеДоходыРасходы_ЗаполнитьНЗП(ДанныеОбъекта);
		КопироватьДанныеФормы(ДанныеОбъекта,Форма.Объект);
		Форма.Модифицированность = Истина;
		
	КонецЕсли;
	
	Если Команда.Имя = "УСОERP_ПрочиеДоходыРасходы_ЗаполнитьРаспределяемыеРасходы" Тогда
		
		ДанныеОбъекта = Форма.Объект;
		УСОERP_ЗащищенныеФункцииСервер.УСОERP_ПрочиеДоходыРасходы_ЗаполнитьРаспределяемыеРасходы(ДанныеОбъекта);
		КопироватьДанныеФормы(ДанныеОбъекта,Форма.Объект);
		Форма.Модифицированность = Истина;
		
	КонецЕсли;
	
	#КонецОбласти 	
	
	#Область РаспределениеНДС 	
	
	Если Команда.Имя = "УСОERP_РаспределениеНДС_Заполнить2001" Тогда
		
		ДанныеОбъекта = Форма.Объект;
		ДанныеДерева = Форма.УСОERP_ДеревоРаспределенияСчета2001;
		
		УСОERP_ЗащищенныеФункцииСервер.УСОERP_РаспределениеНДС_Заполнить2001(ДанныеОбъекта,ДанныеДерева);
		КопироватьДанныеФормы(ДанныеОбъекта,Форма.Объект);
		КопироватьДанныеФормы(ДанныеДерева,Форма.УСОERP_ДеревоРаспределенияСчета2001);
		Форма.Модифицированность = Истина; 		
		
	КонецЕсли;
	
	Если Команда.Имя = "УСОERP_РаспределениеНДС_ЗаполнитьВосстановлениеНДС" Тогда
		
		ДанныеОбъекта = Форма.Объект;
		ДанныеДерева = Форма.УСОERP_ДеревоВосстановленияНДС;
		
		УСОERP_ЗащищенныеФункцииСервер.УСОERP_РаспределениеНДС_ЗаполнитьВосстановлениеНДС(ДанныеОбъекта,ДанныеДерева);
		КопироватьДанныеФормы(ДанныеОбъекта,Форма.Объект);
		КопироватьДанныеФормы(ДанныеДерева,Форма.УСОERP_ДеревоВосстановленияНДС);
		Форма.Модифицированность = Истина;

	КонецЕсли;
	
	Если Команда.Имя = "УСОERP_РаспределениеИнвестиционногоНДС_ПечатьРеестрСчетФактурПолученных" Тогда
		
		Если Форма.Модифицированность ИЛИ НЕ Форма.Объект.Проведен Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Перед печатью необходимо провести документ.'"));			
			Возврат;	
		КонецЕсли;
		
		ТекДанные = Форма.Элементы.ДЗСдачаИнвестору.ТекущиеДанные;
		
		Если ТекДанные = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Необходимо выбрать строку табличной части ""Передача инвестору"".'"));
			Возврат;
		ИначеЕсли Не ЗначениеЗаполнено(ТекДанные.ДокументПоступления) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Счет-фактура не может быть сформирована по группе'"));
			Возврат;
		КонецЕсли;
		
		МассивОбъектов = Форма.Объект.Ссылка;
		ПараметрыПечати = Новый Структура("Контрагент,Договор",ТекДанные.Контрагент,ТекДанные.Договор);
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Документ.УСОERP_РаспределениеИнвестиционногоНДС", "РеестрСчетФактурПолученных", МассивОбъектов, Форма, ПараметрыПечати);
		
	КонецЕсли;
	
	Если Команда.Имя = "УСОERP_ОбъектЭксплуатации_УстановитьСтатусПредподготовка" Тогда
		
		ДанныеОбъекта = Форма.Объект;
	
		УСОERP_ЗащищенныеФункцииСервер.УСОERP_ОбъектЭксплуатации_УстановитьСтатусПредподготовка(ДанныеОбъекта);
		КопироватьДанныеФормы(ДанныеОбъекта,Форма.Объект);
		
		Попытка
			Форма.Записать();
		Исключение
	
		КонецПопытки;
			
	КонецЕсли; 	
	
#КонецОбласти

Если Команда.Имя = "УСОERP_РаспределениеМатериаловПоСтроительнымРаботам" Тогда 
	
	ДанныеОбъекта = Форма.Объект;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("РаспределениеМатериаловПоСтроительнымРаботам",УСОERP_ОбработкаПереопределяемыхПроцедурФункцийКлиент,Новый Структура("Форма",Форма));
	
	ФормаОбработки =  ОткрытьФорму("Обработка.УСОERP_РаспределениеМатериаловПоСтроительнымРаботам.Форма.Форма",Новый Структура("ДанныеОбъекта",ДанныеОбъекта),Форма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецЕсли; 

Если Команда.Имя = "РаспределениеПоАналитикеГрафикаДоговоров" Тогда
	
	РаспределениеПоАналитикеГрафикаДоговоровНажатие(Форма); 	
	
КонецЕсли;

Если Форма.ИмяФормы = "Документ.ВыработкаСотрудников.Форма.ФормаДокумента" Тогда
	
	Если Команда.Имя = "БлокУСП" Тогда
		
		Форма.Элементы.Бригада.Видимость 		= НЕ Форма.Объект.УСОERP_БлокУСП;
		Форма.Элементы.Бригада.Доступность	= НЕ Форма.Объект.УСОERP_БлокУСП;
		
	КонецЕсли;  	
	
КонецЕсли;

#Область ПлатежныеДокументы_РаспределениеПоАналитике

Если     Форма.ИмяФормы  = "Документ.ПриходныйКассовыйОрдер.Форма.ФормаДокумента"
	ИЛИ  Форма.ИмяФормы  = "Документ.РасходныйКассовыйОрдер.Форма.ФормаДокумента"
	ИЛИ  Форма.ИмяФормы  = "Документ.ПоступлениеБезналичныхДенежныхСредств.Форма.ФормаДокумента"
	ИЛИ  Форма.ИмяФормы  = "Документ.СписаниеБезналичныхДенежныхСредств.Форма.ФормаДокумента" 
	//И 2=1 
	Тогда
	
	ПД_УстановитьВидимость(Форма,Команда.Имя);
	Возврат;
	
	//МассивОпераций = Новый Массив;
	//МассивОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента"));
	//МассивОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ВозвратДенежныхСредствОтПоставщика"));
	//МассивОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ОплатаПоставщику"));
	//МассивОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ВозвратОплатыКлиенту")); 	
	
	//Если ЗначениеЗаполнено(Форма.ДокументРаспределение) ИЛИ МассивОпераций.Найти(Форма.Объект.ХозяйственнаяОперация) = Неопределено Тогда
	//	
	//	Форма.Элементы.СтраницаУСОERP_Распределение.Видимость = Ложь;
	//	
	//	Если Форма.Объект.УСОERP_РаспределениеПоАналитикеДоговора.Количество() Тогда
	//		Форма.Объект.УСОERP_РаспределениеПоАналитикеДоговора.Очистить();
	//	КонецЕсли;
	//	
	//	Возврат;
	//	
	//КонецЕсли;
	//
	//Если НЕ ЗначениеЗаполнено(Форма.ДокументРаспределение) Тогда 
	//	
	//	Форма.Элементы.РаспределениеПоАналитикеГрафикаДоговоров.Видимость = Ложь;
	//	
	//КонецЕсли;  
	
	ДанныеОбъекта = Форма.Объект;
	ИмяКоманды = Команда.Имя;
	ТекДанные = Форма.Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		
		Форма.Элементы.СтраницаУСОERP_Распределение.Видимость = Ложь;
		Возврат;
		
	Иначе 
		
		Если ПустаяСтрока(ТекДанные.УСО_ERP_ИдентификаторСтроки) Тогда
			ТекДанные.УСО_ERP_ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
		КонецЕсли;
		
		ТекИд = ТекДанные.УСО_ERP_ИдентификаторСтроки;
		
		Строки = Форма.Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("УСО_ERP_ИдентификаторСтроки",ТекИд));
		
		Если Строки.Количество() > 1 Тогда
			ТекДанные.УСО_ERP_ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
			ТекИд = ТекДанные.УСО_ERP_ИдентификаторСтроки;
		КонецЕсли;			
		
	КонецЕсли;
	
	ТекДоговор = ТекДанные.Заказ;
	//
	//Если ЗначениеЗаполнено(ДанныеОбъекта.Договор) Тогда
	//	ТекДоговор = ДанныеОбъекта.Договор;
	//КонецЕсли; 	
	//
	СтруктураДоговора = УСОERP_МодификацияКонфигурации.ПолучитьСтруктуруДоговораДопПараметров(ТекДоговор,ТекДанные.УСОERP_ОбъектСтроительства); 
	
	Строки = Форма.Объект.УСОERP_РаспределениеПоАналитикеДоговора.НайтиСтроки(Новый Структура("ИдентификаторСтроки",ТекИд));
	
	Для Каждого НайденнаяСтрока ИЗ Строки Цикл
		
		Если НайденнаяСтрока.ОснованиеПлатежа <> ТекДоговор Тогда
			
			НайденнаяСтрока.ОснованиеПлатежа = ТекДоговор;
			
		КонецЕсли; 		
		
		Если НЕ СтруктураДоговора.ПоВидамРабот И ЗначениеЗаполнено(НайденнаяСтрока.ВидРабот) Тогда
			
			НайденнаяСтрока.ВидРабот = "";
			
		КонецЕсли;
		
		Если НЕ СтруктураДоговора.ПоРаботам И ЗначениеЗаполнено(НайденнаяСтрока.Работа) Тогда
			
			НайденнаяСтрока.Работа = "";
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекДанные.УСОERP_ОбъектСтроительства) Тогда
			
			Форма.Объект.УСОERP_РаспределениеПоАналитикеДоговора.Удалить(НайденнаяСтрока);
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Форма.Элементы.СтраницаУСОERP_Распределение.Видимость = НЕ СтруктураДОговора.НеНайден;
	
	Если СтруктураДоговора.НеНайден Тогда
		Возврат;
	КонецЕсли;  
	
	Форма.Элементы.УСО_РаспределениеРабота.Видимость = СтруктураДоговора.ПоРаботам;
	Форма.Элементы.УСО_РаспределениеВидРабот.Видимость = СтруктураДоговора.ПоВидамРабот; 	
	
	//Если ИмяКоманды = "ХозяйственнаяОперация" Тогда
	//	
	//	Форма.Объект.УСОERP_РаспределениеПоАналитикеДоговора.Очистить();	
	//	
	//КонецЕсли;
	
	Форма.Элементы.УСО_Распределение.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ИдентификаторСтроки",ТекИд));
	
	ТекСтрока = Форма.Элементы.УСО_Распределение.ТекущиеДанные;
	
	Если ИмяКоманды = "УСО_Распределение" Тогда
		
		Если ТекДанные = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекДанные.УСОERP_ОбъектСтроительства) ИЛИ НЕ ЗначениеЗаполнено(ТекДанные.УСОERP_ДокументУтверждения)Тогда
			ВызватьИсключение("Не выбран документ утверждения!");
		КонецЕсли;
		
		
		Если НЕ ЗначениеЗаполнено(ТекДоговор)Тогда
			
			ВызватьИсключение("Не выбрано основание платежа!");
			
		КонецЕсли;		
		
		Если ТекСтрока <> Неопределено Тогда
			
			Если ПустаяСтрока(ТекСтрока.ИдентификаторСтроки) Тогда
				
				ТекСтрока.ИдентификаторСтроки = ТекИд;
				ТекСтрока.СтатьяБюджета = СтруктураДоговора.СтатьяБюджетаОсновногоПлатежа;				
				
				ТекСтрока.СтатьяДвиженияДенежныхСредств = ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.ПоступлениеОплатыОтКлиента");
				ТекСтрока.ПорядокРасчетов = ПредопределенноеЗначение("Перечисление.ВариантыОплатыКлиентом.КредитПослеОтгрузки");
				ТекСтрока.ОснованиеПлатежа = ТекДоговор;
				ТекСтрока.Заказ = ТекДоговор;
				ТекСтрока.ИдентификаторСтроки = ТекИд;
				ТекСтрока.ДокументУтверждения = ТекДанные.УСОERP_ДокументУтверждения;			
				
			КонецЕсли; 	
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Если ИмяКоманды = "УСО_РаспределениеРабота" Тогда
		
		Если УСОERP_УправлениеСтроительнымПроизводством.ЭтоЭтапРаботы(ТекСтрока.Работа) Тогда
			ТекСтрока.Работа = ПредопределенноеЗначение("Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка");
			ВызватьИсключение("Нельзя выбирать этап работы!");
		КонецЕсли;
		
	КонецЕсли;
	
	Строки = Форма.Объект.УСОERP_РаспределениеПоАналитикеДоговора.НайтиСтроки(Новый Структура("ИдентификаторСтроки",""));
	
	Для Каждого НайденнаяСтрока ИЗ Строки Цикл 		
		
		Форма.Объект.УСОERP_РаспределениеПоАналитикеДоговора.Удалить(НайденнаяСтрока);			
		
	КонецЦикла;    	
	
	МассивСтрокДляУдаления = Новый Массив;
	
	Попытка 	
		
		Для Каждого Строка ИЗ Форма.Объект.УСОERP_РаспределениеПоАналитикеДоговора Цикл
			
			Если Форма.Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки",Строка.ИдентификаторСтроки)).Количество() = 0 Тогда 
				
				МассивСтрокДляУдаления.Добавить(Строка);
				
			КонецЕсли; 
			
		КонецЦикла;
		
	Исключение
		
	КонецПопытки;
	
	Для Каждого НайденнаяСтрока ИЗ МассивСтрокДляУдаления Цикл 		
		
		Форма.Объект.УСОERP_РаспределениеПоАналитикеДоговора.Удалить(НайденнаяСтрока);
		
	КонецЦикла;
	
КонецЕсли; 
	
#КонецОбласти
	
КонецПроцедуры

Процедура РаспределениеПоАналитикеГрафикаДоговоровНажатие(Форма) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Для ввода распределения необходимо записать текущий документ!";
		Сообщение.Сообщить();
		Возврат;
	ИначеЕсли ЗначениеЗаполнено(Форма.ДокументРаспределение) Тогда
		ПараметрыОткрытияРаспределения = Новый Структура;
		ПараметрыОткрытияРаспределения.Вставить("Ключ", Форма.ДокументРаспределение);
		
        ПараметрыФормы = Новый Структура("Форма,УИД",Форма,Форма.УникальныйИдентификатор);
		ОткрытьФорму("Документ.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Форма.ФормаДокумента", ПараметрыОткрытияРаспределения,,,,, Новый ОписаниеОповещения("РаспределениеПоАналитикеГрафикаДоговоровНажатиеЗавершение", УСОERP_МодификацияКонфигурацииКлиент,ПараметрыФормы), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	Иначе
		
		//ПараметрыОткрытияРаспределения = Новый Структура;
		//ПараметрыОткрытияРаспределения.Вставить("ДокументОснование", Форма.Объект.Ссылка);
		//
		//ПараметрыФормы = Новый Структура("Форма,УИД",Форма,Форма.УникальныйИдентификатор);
		//ОткрытьФорму("Документ.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Форма.ФормаДокумента", ПараметрыОткрытияРаспределения,,,,, Новый ОписаниеОповещения("РаспределениеПоАналитикеГрафикаДоговоровНажатиеЗавершение", УСОERP_МодификацияКонфигурацииКлиент,ПараметрыФормы), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
		ФормаОбъекта = ПолучитьФорму("Документ.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.Форма.ФормаДокумента",,Форма);
		//ДанныеОбъекта = ДанныеФормыВЗначение(Форма.Объект,Тип("ДокументОбъект.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров"));
		ДанныеФормы = ФормаОбъекта.Объект;
		
		ТекстОшибки = "";
		
		//УСОERP_УправлениеСтроительнымПроизводством.
		
		УСОERP_МодификацияКонфигурации.ЗаполнитьРаспределениеГрафикаДоговоров(ДанныеФормы,Форма.Объект.Ссылка,ТекстОшибки);
		
		Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
			ПоказатьПредупреждение(,ТекстОшибки);
			Возврат;
		КонецЕсли;
		
		//Заполнить()
		
		КопироватьДанныеФормы(ДанныеФормы,ФормаОбъекта.Объект);		
		
		ФормаОбъекта.Открыть();		
		
	КонецЕсли;

	  
КонецПроцедуры

Процедура РаспределениеПоАналитикеГрафикаДоговоровНажатиеЗавершение(Результат, ДополнительныеПараметры)Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	//Форма.ДокументРаспределение = Документы.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров.НайтиПоРеквизиту("ДокументОснование", Форма.Объект.Ссылка);
	Форма.ДокументРаспределение = УСОERP_МодификацияКонфигурации.ПолучитьДокументРаспределенияПоОснованию(Форма.Объект.Ссылка);
	
	Если ЗначениеЗаполнено(Форма.ДокументРаспределение) Тогда
		Форма.ТекстРаспределениеПоАналитикеГрафикаДоговоров = Строка(Форма.ДокументРаспределение);
	Иначе
		Форма.ТекстРаспределениеПоАналитикеГрафикаДоговоров = "Ввести документ-распределение графика договоров";
	КонецЕсли;
	
	Форма.Элементы.РаспределениеПоАналитикеГрафикаДоговоров.Заголовок =  Форма.ТекстРаспределениеПоАналитикеГрафикаДоговоров;
	
