#Область ПрограммныйИнтерфейс

// Сохраняет значение из текущей строки дерева для дальнейшего использования.
//
// Параметры:
//     СтруктураСлепкаДерева 	- Структура - переменная, в которую будет сохранена выходная структура текущего
//                                оформления дерева (поля ТекущийЭлемент и ОткрытыеЭлементы).
//     ТекущиеДанные 			- ДанныеФормыСтруктура - данные текущей строки дерева сметы.
//     ТаблицаФормыДерево 		- ТаблицаФормы - таблица формы с деревом.
//     ДеревоФормы 				- ДеревоЗначений - коллекция, отображающая дерево на форме.
//     ИмяПоля 					- Строка - содержит имя ключевого поля дерева.
//
Процедура СохранитьТекущийЭлемент(СтруктураСлепкаДерева, ТекущиеДанные, ТаблицаФормыДерево, ДеревоФормы, ИмяПоля = "Элемент") Экспорт
	
	СтруктураСлепкаДерева = Новый Структура("ТекущийЭлемент, ОткрытыеЭлементы");
	
	СтруктураСлепкаДерева.ОткрытыеЭлементы = СохранитьРазвернутыеУзлы(ТаблицаФормыДерево, ДеревоФормы, ИмяПоля);
		
	Если ТекущиеДанные <> Неопределено Тогда
		СтруктураСлепкаДерева.ТекущийЭлемент = ТекущиеДанные[ИмяПоля];
	КонецЕсли;
			   
КонецПроцедуры

// Сохраняет значение из текущей строки дерева для дальнейшего использования.
//
// Параметры:
//     ТаблицаФормыДерево 		- ТаблицаФормы - таблица формы с деревом.
//     ДеревоФормы 				- ДеревоЗначений - коллекция, отображающая дерево на форме.
//     ДеревоЛС 				- ДеревоЗначений - переменная, содержащая дерево сметы (ДеревоЗначений).
//     СтруктураСлепкаДерева 	- Структура - сохраненная ранее структура с данными по оформлению дерева
//                                (поля ТекущийЭлемент и ОткрытыеЭлементы).
//     ИмяПоля 					- Строка - содержит имя ключевого поля дерева.
//
Процедура ВосстановитьТекущийЭлемент(ТаблицаФормыДерево, ДеревоФормы, ДеревоЛС, СтруктураСлепкаДерева = Неопределено, ИмяПоля = "Элемент") Экспорт
	
	Если СтруктураСлепкаДерева <> Неопределено Тогда
	
		Индекс 			= ПроверитьСтрокуДерева(ДеревоФормы,СтруктураСлепкаДерева.ТекущийЭлемент,"Идентификатор", ИмяПоля);
		ИндексРодителя	= ПроверитьСтрокуДерева(ДеревоФормы,СтруктураСлепкаДерева.ТекущийЭлемент,"РодительИдентификатор", ИмяПоля);
		
		Если ИндексРодителя = Неопределено Тогда
			Возврат;
		КонецЕсли;	
		
		ВосстановитьРазвернутыеУзлы(ТаблицаФормыДерево, ДеревоФормы, ИмяПоля, СтруктураСлепкаДерева.ОткрытыеЭлементы);
				
		ТаблицаФормыДерево.ТекущаяСтрока = Индекс;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;	

КонецПроцедуры

// Ищет строку в дереве по объекту и возвращает требуемый идентификатор.
//
// Параметры:
//     СтрокаДерева 	- СтрокаДереваЗначений - текущая строка дерева значений.
//     НовыйОбъект 		- ДокументОбъект - объект поиск которого производится в дереве.
//     Вид 				- Строка - имя индетификатора (например, "Идентификатор"), 
//          			  "РодительИдентификатор" - идентификация по идентификатору родителя, 
//     					  "РодительСтрока" - идентификатор по родителю.
//     ИмяПоля 			- Строка - имя поля по которому происходит сравнение с объектом.
//
// Возвращаемое значение:
//     Инд - Число, Неопределено - идентификатор найденной строки, Неопределено если не найдено.
//
Функция ПроверитьСтрокуДерева(СтрокаДерева,НовыйОбъект,Вид, ИмяПоля = "Элемент") Экспорт
	
	Для Каждого ЭлементДерева Из СтрокаДерева Цикл
		Если ЭлементДерева[ИмяПоля] = НовыйОбъект Тогда
			Если Вид = "Идентификатор" Тогда
				Индекс = ЭлементДерева.ПолучитьИдентификатор();
			ИначеЕсли (Вид = "РодительИдентификатор") ИЛИ (Вид = "РодительСтрока") Тогда
				Индекс = 0;
			Иначе
				Индекс = СтрокаДерева.индекс(ЭлементДерева);
			КонецЕсли;
			
			Возврат Индекс;
		КонецЕсли;
		
		Инд = ПроверитьСтрокуДерева(ЭлементДерева.ПолучитьЭлементы(),НовыйОбъект,Вид, ИмяПоля);
		Если Инд <> Неопределено Тогда
			Если (Вид = "РодительИдентификатор") И (Инд = 0) Тогда
				Возврат ЭлементДерева.ПолучитьИдентификатор();
			ИначеЕсли (Вид = "РодительСтрока") И (Инд = 0) Тогда
				Возврат ЭлементДерева;
			Иначе
				Возврат Инд;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Неопределено;
	
КонецФункции	

// Производит поиск строки на которую надо спозиционироваться, если текущая строка была удалена.
//
// Параметры:
//     ДеревоЛС 			- ДеревоЗначений - дерево, в котором производим поиск.
//     УдаляемаяСтрока 		- СтрокаДереваЗначений - текущая строка (кооторая удаляется).
//	   ИмяПоля				- Строка - название колонки дерева по которой производиься поиск.
//
// Возвращаемое значение:
//     Элемент - ДокументСсылка - (значение поля) новой строки.
//
Функция ТекущаяСтрокаПослеУдаленияВДереве(ДеревоЛС, УдаляемаяСтрока, ИмяПоля = "Элемент") Экспорт
	
	Родитель = ПроверитьСтрокуДерева(ДеревоЛС.ПолучитьЭлементы(),УдаляемаяСтрока.Элемент,"РодительСтрока",ИмяПоля); 
	
	Если ТипЗнч(Родитель) = ТипЗнч(0) Тогда
		// Значит пытаются удалить корень дерева - так нельзя.
		Возврат Неопределено;
	КонецЕсли;

	ТекущаяСтрока 	= Родитель;
	Строки 			= Родитель.ПолучитьЭлементы();
	Если Строки.Количество() > 1 Тогда
		// Минимум две строки.
		Для Каждого Строка Из Строки Цикл
			Если Строка = УдаляемаяСтрока Тогда
				Прервать;
			Иначе
				ТекущаяСтрока = Строка;	
			КонецЕсли;
		КонецЦикла;
		Если ТекущаяСтрока = Родитель Тогда
			// Это была первая строка.
			ТекущаяСтрока = Строки[1];
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекущаяСтрока.Элемент;	
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция возвращает структуру с инфомрацией о развернутом узле дерева значений.
//
// Параметры:
//     ДЗ 			- Дерево значений.
//     Строки		- Коллекция строк дерева, на уровне которой ищем развернутый узел.
//     КолонкаСсылки 	- Строка с именем колонки по которой идентифицируем строку.
//     СтруктураДерева 	- Структура для заоплнения информации (для рекурсии).
//
// Возвращаемое значение:
//     Структура с полями "СписокРазвернутых,ТекущаяСтрока", содержащая информацию о развернутых строках.
//
Функция СохранитьРазвернутыеУзлы(ДЗ, Строки, КолонкаСсылки, СтруктураДерева = Неопределено) 
	
	Если СтруктураДерева = Неопределено Тогда
		СтруктураДерева = Новый Структура();
		СтруктураДерева.Вставить("СписокРазвернутых"	, Новый СписокЗначений);
		СтруктураДерева.Вставить("СписокОтмеченных"		, Новый СписокЗначений);
	КонецЕсли;
	
	Для каждого Строка Из Строки Цикл
		
		Если ДЗ.Развернут(Строка.ПолучитьИдентификатор()) Тогда
			СтруктураДерева.СписокРазвернутых.Добавить(Строка[КолонкаСсылки]);
		КонецЕсли;
		
		//	Сохраняем, что бы могли отмечать строки, после обновления дерева значений.
		Если Строка.Свойство("Пометка")
			И Строка.Пометка Тогда
			СтруктураДерева.СписокОтмеченных.Добавить(Строка[КолонкаСсылки], Строка.Пометка);	
		КонецЕсли;
		
		Если Строка.ПолучитьЭлементы().Количество() > 0 Тогда
			СтруктураДерева = СохранитьРазвернутыеУзлы(ДЗ, Строка.ПолучитьЭлементы(), КолонкаСсылки, СтруктураДерева);
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат СтруктураДерева;
	
КонецФункции

// Процедура восстанавливает состояние дерева значений
//
// Параметры:
//     ДЗ 			- Дерево значений.
//     Строки		- Коллекция строк дерева, на уровне которой ищем развернутый узел.
//     КолонкаСсылки 	- Строка с именем колонки по которой идентифицируем строку.
//     СтруктураДерева 	- Структура для заоплнения информации (для рекурсии).
//	   ПервыйПроход - первый вызов в рамках рекурсии или нет.
//
Процедура ВосстановитьРазвернутыеУзлы(ДЗ, Строки, КолонкаСсылки, СтруктураДерева, ПервыйПроход = Истина) 
	
	Если НЕ ТипЗнч(СтруктураДерева.СписокРазвернутых) = Тип("СписокЗначений") Тогда
		Возврат;
	КонецЕсли;	
	Для каждого Строка Из Строки Цикл
		Если НЕ СтруктураДерева.СписокРазвернутых.НайтиПоЗначению(Строка[КолонкаСсылки]) = Неопределено Тогда
			ДЗ.Развернуть(Строка.ПолучитьИдентификатор());
		КонецЕсли;
		Если НЕ Строки.Количество() = 0 Тогда
			ВосстановитьРазвернутыеУзлы(ДЗ, Строка.ПолучитьЭлементы(), КолонкаСсылки, СтруктураДерева, Ложь);
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти