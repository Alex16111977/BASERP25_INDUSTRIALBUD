#Область СлужебныеПроцедурыИФункции

// См. комментарий к одноименной процедуре в модуле УправлениеДоступомПереопределяемый.
Процедура ПриЗаполненииВидовДоступа(ВидыДоступа) Экспорт
	
	ВидДоступа = ВидыДоступа.Добавить();
	ВидДоступа.Имя = "СМ_ОбъектыСтроительства";
	ВидДоступа.Представление = НСтр("ru = 'Объекты строительства'");
	ВидДоступа.ТипЗначений   = Тип("СправочникСсылка.СМ_ОбъектыСтроительства");
	
	ВидДоступа = ВидыДоступа.Добавить();
	ВидДоступа.Имя = "ГруппыРесурсов";
	ВидДоступа.Представление = НСтр("ru = 'Группа ресурсов и НС'");
	ВидДоступа.ТипЗначений   = Тип("СправочникСсылка.СМ_ГруппыРесурсов");


КонецПроцедуры

// См. комментарий к одноименной процедуре в модуле УправлениеДоступомПереопределяемый.
Процедура ПриЗаполненииИспользованияВидаДоступа(ИмяВидаДоступа, Использование) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ИмяВидаДоступа = "СМ_ОбъектыСтроительства" Тогда
		Использование = Константы.ОграничиватьДоступНаУровнеЗаписей.Получить();
	ИначеЕсли ИмяВидаДоступа = "Пользователи" Тогда
		Использование = Константы.ОграничиватьДоступНаУровнеЗаписей.Получить();
	ИначеЕсли ИмяВидаДоступа = "НормативныеСборники" Тогда
		Использование = Константы.ОграничиватьДоступНаУровнеЗаписей.Получить();
	ИначеЕсли ИмяВидаДоступа = "ГруппыРесурсов" Тогда
		Использование = Константы.ОграничиватьДоступНаУровнеЗаписей.Получить();
	ИначеЕсли ИмяВидаДоступа = "Ресурсы" Тогда
		Использование = Константы.ОграничиватьДоступНаУровнеЗаписей.Получить();
	КонецЕсли;
	
КонецПроцедуры

// См. комментарий к одноименной процедуре в модуле УправлениеДоступомПереопределяемый.
Процедура ПриЗаполненииВидовОграниченийПравОбъектовМетаданных(Описание) Экспорт
	
	Описание = Описание + "
	|Документ.СМ_ЛокальнаяСмета.Чтение.СМ_ОбъектыСтроительства
	|Документ.СМ_АктВыполненныхРабот.Чтение.СМ_ОбъектыСтроительства
	|Документ.СМ_ОбъектнаяСмета.Чтение.СМ_ОбъектыСтроительства
	|Документ.СМ_СводнаяСмета.Чтение.СМ_ОбъектыСтроительства
	|Документ.СМ_ЛокальнаяСмета.Чтение.Пользователи
	|Документ.СМ_АктВыполненныхРабот.Чтение.Пользователи
	|Документ.СМ_ОбъектнаяСмета.Чтение.Пользователи
	|Документ.СМ_СводнаяСмета.Чтение.Пользователи
	|Справочник.СМ_НормативныеСборники.Чтение.ГруппыРесурсов
	|Справочник.СМ_Ресурсы.Чтение.ГруппыРесурсов
	|";
	
КонецПроцедуры

#КонецОбласти
