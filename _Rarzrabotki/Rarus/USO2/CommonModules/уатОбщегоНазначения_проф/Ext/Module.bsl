// Процедура выполняет регламентное задание ЗагрузкаДанныхDynafleet.
//
Процедура ЗагрузкаДанныхDynafleet() Экспорт
	
	ИмяСобытияВЖурналеРегистрации = НСтр("en='Download Dynafleet data';ru='Загрузка данных Dynafleet'");
	
	ТекстНСТР = НСтр("en='Start the download session';ru='Начало сеанса загрузки'");
	ЗаписьЖурналаРегистрации(ИмяСобытияВЖурналеРегистрации, УровеньЖурналаРегистрации.Информация,,, ТекстНСТР);
	
	ВсеОК = Истина;
	
	СтруктураДопПараметры = Константы.уатПараметрыРеглЗаданияЗагрузкаДанныхDynafleet.Получить().Получить();
	Если Не ТипЗнч(СтруктураДопПараметры) = Тип("Структура") Тогда
		СтруктураДопПараметры = Новый Структура();
	КонецЕсли;
	Если Не СтруктураДопПараметры.Свойство("ЗагрузитьПробегРасход") Тогда
		СтруктураДопПараметры.Вставить("ЗагрузитьПробегРасход", Ложь);
	КонецЕсли;
	Если Не СтруктураДопПараметры.Свойство("ЗагрузитьКоординаты") Тогда
		СтруктураДопПараметры.Вставить("ЗагрузитьКоординаты", Ложь);
	КонецЕсли;
	Если Не СтруктураДопПараметры.Свойство("МассивТС") Тогда
		СтруктураДопПараметры.Вставить("МассивТС", Новый Массив);
	КонецЕсли;
	Если Не СтруктураДопПараметры.Свойство("ИнтервалЗагрузки") Тогда
		СтруктураДопПараметры.Вставить("ИнтервалЗагрузки", "День");
	КонецЕсли;
	
	Если СтруктураДопПараметры.МассивТС.Количество() = 0 Тогда
		ТекстНСТР = НСтр("en='Not selected any vehicle';ru='Не выбрано ни одно ТС'");
		ЗаписьЖурналаРегистрации(ИмяСобытияВЖурналеРегистрации, УровеньЖурналаРегистрации.Ошибка,,, ТекстНСТР);
		ВызватьИсключение ТекстНСТР;
		ВсеОК = Ложь;
	КонецЕсли;
	
	Если Не СтруктураДопПараметры.ЗагрузитьПробегРасход И Не СтруктураДопПараметры.ЗагрузитьКоординаты Тогда
		ТекстНСТР = НСтр("ru = 'Не указаны параметры: ""Загрузить пробег и расход ГСМ"", ""Загрузить координаты""'");
		ЗаписьЖурналаРегистрации(ИмяСобытияВЖурналеРегистрации, УровеньЖурналаРегистрации.Ошибка,,, ТекстНСТР);
		ВызватьИсключение ТекстНСТР;
		ВсеОК = Ложь;
