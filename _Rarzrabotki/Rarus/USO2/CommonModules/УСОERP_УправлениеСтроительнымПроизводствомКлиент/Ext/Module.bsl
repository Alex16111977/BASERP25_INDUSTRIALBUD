#Область ПрограммныйИнтерфейс

#Область СтроительныеРаботы

//Устанавливает в дереве выделенную строку
//
//Параметры:
//	ДеревоЭлемент 	- элемент формы, отображающий дерево работ
//	ДеревоРеквизит 	- реквизит формы типа ДеревоЗначений, содержащий дерево работ
//	ТекущаяРабота 	- работа, которую необходимо выделить в дереве 
//
Процедура УстановитьВыделеннуюРаботуВДеревеПоСсылке(ДеревоЭлемент, ДеревоРеквизит, ТекущаяРабота) Экспорт
	
	Если ТекущаяРабота <> Неопределено И
		НЕ ТекущаяРабота.Пустая() Тогда
		Индекс = -1;
		НайтиРаботуВДеревеПоСсылке(ДеревоРеквизит.ПолучитьЭлементы(), ТекущаяРабота, Индекс);
		Если Индекс > -1 Тогда
			ДеревоЭлемент.ВыделенныеСтроки.Добавить(Индекс);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура НайтиРаботуВДеревеПоСсылке(КоллекцияРаботОдногоУровня, ИскомаяРабота, Индекс) Экспорт
	
	Если ТипЗнч(Индекс) = Тип("Число") И Индекс > -1 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Работа Из КоллекцияРаботОдногоУровня Цикл
		Если Работа.Ссылка = ИскомаяРабота Тогда
			Индекс = Работа.ПолучитьИдентификатор();
		Иначе
			НайтиРаботуВДеревеПоСсылке(Работа.ПолучитьЭлементы(), ИскомаяРабота, Индекс);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

//Устанавливает в дереве текущую строку
//
//Параметры:
//	ДеревоЭлемент 	- элемент формы, отображающий дерево работ
//	ДеревоРеквизит 	- реквизит формы типа ДеревоЗначений, содержащий дерево работ
//	ТекущаяРабота 	- работа, которую необходимо выделить в дереве 
//
Процедура УстановитьТекущуюРаботуВДеревеПоСсылке(ДеревоЭлемент, ДеревоРеквизит, ТекущаяРабота) Экспорт
	
	Если ТекущаяРабота <> Неопределено И
		НЕ ТекущаяРабота.Пустая() Тогда
		Индекс = -1;
		НайтиРаботуВДеревеПоСсылке(ДеревоРеквизит.ПолучитьЭлементы(), ТекущаяРабота, Индекс);
		Если Индекс > -1 Тогда
			ДеревоЭлемент.ТекущаяСтрока = Индекс;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//Формирует список раскрытых элементов дерева Работ
//
//Параметры:
//	ДеревоЭлемент 			- элемент формы, отображающий дерево Работ
//	МассивСтрокОдногоУровня - массив Работ одного уровня
//	СписокРаскрытыхРабот 	- список, который содержит раскрытые элементы дерева Работ
//
Процедура ПолучитьМассивРаскрытыхРабот(ДеревоЭлемент, МассивСтрокОдногоУровня, СписокРаскрытыхРабот) Экспорт
	
	Для Каждого СтрокаОдногоУровня Из МассивСтрокОдногоУровня Цикл
		ИдРаботы = СтрокаОдногоУровня.ПолучитьИдентификатор();
		Если ДеревоЭлемент.Развернут(ИдРаботы) <> Неопределено 
			И ДеревоЭлемент.Развернут(ИдРаботы) Тогда
			СписокРаскрытыхРабот.Добавить(СтрокаОдногоУровня.Ссылка);
		КонецЕсли;
		ПолучитьМассивРаскрытыхРабот(ДеревоЭлемент, СтрокаОдногоУровня.ПолучитьЭлементы(), СписокРаскрытыхРабот);
	КонецЦикла;
	
КонецПроцедуры

//Раскрывает указанные элементы дерева
//
//Параметры:
//	ДеревоЭлемент 				- элемент формы, отображающий дерево Работ
//	ДеревоРеквизит 				- реквизит формы типа ДеревоЗначений, содержащий дерево Работ
//	СписокРаботДляРазвертывания - список Работ, которые необходимо развернуть в дереве
//
Процедура УстановитьРазвернутостьЭлементовДерева(ДеревоЭлемент, ДеревоРеквизит, СписокРаботДляРазвертывания) Экспорт
	
	Если СписокРаботДляРазвертывания <> Неопределено Тогда
		Для Каждого ЭлементСписка Из СписокРаботДляРазвертывания Цикл
			Индекс = -1;
			НайтиРаботуВДеревеПоСсылке(ДеревоРеквизит.ПолучитьЭлементы(), ЭлементСписка.Значение, Индекс);
			Если Индекс > -1 Тогда
				Если ДеревоРеквизит.НайтиПоИдентификатору(Индекс).ПолучитьЭлементы().Количество() > 0 Тогда
					ДеревоЭлемент.Развернуть(ДеревоРеквизит.НайтиПоИдентификатору(Индекс).ПолучитьИдентификатор(), Ложь);
				Иначе
					Если ДеревоРеквизит.НайтиПоИдентификатору(Индекс).ПолучитьРодителя() <> Неопределено Тогда
						ДеревоЭлемент.Развернуть(ДеревоРеквизит.НайтиПоИдентификатору(Индекс).ПолучитьРодителя().ПолучитьИдентификатор(), Ложь);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

