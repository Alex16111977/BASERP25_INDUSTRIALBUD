#Область ПрограммныйИнтерфейс

// Получает параметры контроля лимитов.
//
// Параметры:
//     Стройка - СправочникСсылка.СМ_ОбъектыСтроительства - ссылка на объект, для которого получаем параметры.
//
// Возвращаемое значение:
// 	   Структура - содержит поля
//        * КонтролироватьОстатокПоАкту - Булево - Истина, если включен контроль остатков, иначе Ложь.
//		  * ЗапретитьПроведениеАктаПревышениеЛимитаСметы - Булево - Истина, если отменять проведение, иначе Ложь.
//
Функция ПараметрыКонтроляЛимитов(Стройка = Неопределено) Экспорт
	
	УИНнастройки = "";
	
	Если ЗначениеЗаполнено(Стройка) Тогда
		УИНнастройки = Строка(Стройка.УникальныйИдентификатор());
	КонецЕсли;
	
	Структура = Новый Структура("КонтролироватьОстатокПоАкту, ЗапретитьПроведениеАктаПревышениеЛимитаСметы", Ложь, Ложь);

	Структура.КонтролироватьОстатокПоАкту = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
	"НастройкиПользователяСмета","КонтролироватьОстатокПоАкту"+УИНнастройки,
	ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","КонтролироватьОстатокПоАкту",Ложь));
	
	Структура.ЗапретитьПроведениеАктаПревышениеЛимитаСметы = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
	"НастройкиПользователяСмета","ЗапретитьПроведениеАктаПревышениеЛимитаСметы"+УИНнастройки,
	ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ЗапретитьПроведениеАктаПревышениеЛимитаСметы",Ложь));
	
	Возврат Структура;

КонецФункции

#КонецОбласти