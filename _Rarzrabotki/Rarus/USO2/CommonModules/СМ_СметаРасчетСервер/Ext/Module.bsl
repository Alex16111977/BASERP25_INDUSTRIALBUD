////////////////////////////////////////////////////////////////////////////////
// Подсистема "Сметная подсистема".
//
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область РасчетПозиции

// Выполняет расчет поправок позиции локальной сметы и запись в регистр сведений
// СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.
// Параметры:
//     Объект 						- ДокументОбъект.СМ_ПозицияЛокальнойСметы - объект позиции.
//     СтруктураДанныхРасчета 		- Структура - содержит таблицы данных для расчета (см. менеджер СМ_ПозицияЛокальнойСметы).
//     ЛС 							- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на локальную смету.  
//     Акт 							- ДокументСсылка.СМ_АктыВыполненныхРабот - ссылка на акт выполненных работ.
//     СтруктураПараметровОтбораРС 	- Структура - содержит дополнительный отбор результирующего регистра сведений.
//     ИспользоватьРС 				- Булево - если Ложь, то все считается без чтения и записи из РС.
//
Процедура РасчитатьПоправки(Объект, СтруктураДанныхРасчета, ЛС, Акт, СтруктураПараметровОтбораРС = Неопределено, ИспользоватьРС = Истина) Экспорт
	
	Если СтруктураПараметровОтбораРС = Неопределено Тогда
		СтруктураПараметровОтбораРС = СМ_СметаВызовСервера.ПолучитьСтруктуруДанныхДляОтборовРегистра(Объект, Акт, "СМ_ПозицияЛокальнойСметы");
	КонецЕсли;
	
	// Определяем вариант расчета ЭММ.
	// В дальнейшем вариант расчета ЭММ будем брать из настроек пользователя.
	ВариантРасчетаЭММ = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ВариантРасчетаЭксплуатацииМашин");	
	УчитыватьДопЗМ = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","УчитыватьДопЗМ",Ложь);	
	ТекущийРаздел = СтруктураПараметровОтбораРС.СсылкаНаРаздел;
	
	Параметры = Новый Структура();
	Параметры.Вставить("Позиция",СтруктураПараметровОтбораРС.СсылкаНаПозицию);
	Параметры.Вставить("Раздел",ТекущийРаздел);
	Параметры.Вставить("Смета",СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
	Параметры.Вставить("СтоимПрямЗатраты",0);
	Параметры.Вставить("СтоимОснЗарплата",0);
	Параметры.Вставить("СтоимЭксплМашин",0);
	Параметры.Вставить("СтоимЗарплМашин",0);
	Параметры.Вставить("СтоимСтоимМатер",0);
	Параметры.Вставить("СтоимОборуд",0);
	Параметры.Вставить("СтоимВозвратМатер",0);
	Параметры.Вставить("ДопЗМ",0);
	Параметры.Вставить("ТекСтоимПрямЗатраты",0);
	Параметры.Вставить("ТекСтоимОснЗарплата",0);
	Параметры.Вставить("ТекСтоимЭксплМашин",0);
	Параметры.Вставить("ТекСтоимЗарплМашин",0);
	Параметры.Вставить("ТекСтоимСтоимМатер",0);
	Параметры.Вставить("ТекСтоимОборуд",0);
	Параметры.Вставить("ТекСтоимВозвратМатер",0);
	Параметры.Вставить("ДопЗМТек",0);
	Параметры.Вставить("ЗатратыТрудаРабочих",0);
	Параметры.Вставить("ЗатратыТрудаМашин",0);
	
	// Базисно-индексный метод.
	Если ЛС.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный Тогда
		
		Параметры.СтоимПрямЗатраты		= Объект.ПрямЗатраты;
		Параметры.СтоимОснЗарплата		= Объект.ОснЗарплата;
		Параметры.СтоимЭксплМашин		= Объект.ЭксплМашин;
		Параметры.СтоимЗарплМашин		= Объект.ЗарплМашинистов;
		Параметры.СтоимСтоимМатер		= Объект.СтоимМатериалов;
		Параметры.СтоимОборуд			= Объект.Оборудование;
		Параметры.СтоимВозвратМатер		= Объект.ВозвратМатер;
		Параметры.ЗатратыТрудаРабочих	= Объект.ЗатратыТрудаРабочих;
		Параметры.ЗатратыТрудаМашин		= Объект.ЗатратыТрудаМашинистов;
		
		Параметры.ТекСтоимПрямЗатраты  	= Объект.ПрямЗатраты;
		Параметры.ТекСтоимОснЗарплата  	= Объект.ОснЗарплата;
		Параметры.ТекСтоимЭксплМашин  	= Объект.ЭксплМашин;
		Параметры.ТекСтоимЗарплМашин  	= Объект.ЗарплМашинистов;
		Параметры.ТекСтоимСтоимМатер  	= Объект.СтоимМатериалов;
		Параметры.ТекСтоимОборуд   		= Объект.Оборудование;
		Параметры.ТекСтоимВозвратМатер  = Объект.ВозвратМатер;
		
		Если ЛС.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел
			ИЛИ ЛС.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка Тогда
			
			Если Объект.НеПрименятьИндексы = Истина Тогда
				
				Если ТипЗнч(СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета) <> Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
					
					СтруктураЦен = Новый Структура();
					СтруктураЦен.Вставить("ТекущаяЦена",0);
					СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов",0);		
					
					ПолучитьТекущуюЦенуПоПозицииАкта(СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета,Объект,СтруктураЦен);
					
					Если Объект.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование Тогда
						Параметры.ТекСтоимОборуд   		= СтруктураЦен.ТекущаяЦена;
					ИначеЕсли Объект.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал Тогда
						Параметры.ТекСтоимСтоимМатер  = СтруктураЦен.ТекущаяЦена;
						Параметры.ТекСтоимПрямЗатраты = СтруктураЦен.ТекущаяЦена;
					Иначе	
						Параметры.ТекСтоимЭксплМашин = СтруктураЦен.ТекущаяЦена;
						Параметры.ТекСтоимЗарплМашин = СтруктураЦен.ТекущаяЗарплатаМашинистов;
						Параметры.ТекСтоимПрямЗатраты = СтруктураЦен.ТекущаяЦена;
					КонецЕсли;	
					
				Иначе	
					Если Объект.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование Тогда
						Параметры.ТекСтоимОборуд   		= Объект.ТекущаяЦена;
					ИначеЕсли Объект.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал Тогда
						Параметры.ТекСтоимСтоимМатер  = Объект.ТекущаяЦена;
						Параметры.ТекСтоимПрямЗатраты = Объект.ТекущаяЦена;
					Иначе	
						Параметры.ТекСтоимЭксплМашин = Объект.ТекущаяЦена;
						Параметры.ТекСтоимЗарплМашин = Объект.ТекущаяЗарплатаМашинистов;
						Параметры.ТекСтоимПрямЗатраты = Объект.ТекущаяЦена;
					КонецЕсли;	
				КонецЕсли;	
				
			КонецЕсли;	
			
		КонецЕсли;	

	// Ресурсный метод.
	ИначеЕсли ЛС.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
		
		Если ИспользоватьРС Тогда
			
			НаборЗаписей = РегистрыСведений.СМ_РесурснаяСтоимостьПозиции.СоздатьНаборЗаписей();
			
			НаборЗаписей.Отбор.Позиция.Установить(СтруктураПараметровОтбораРС.СсылкаНаПозицию);
			НаборЗаписей.Отбор.Смета.Установить(СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
			НаборЗаписей.Прочитать();
			
			СтруктураДанныхРасчета.СМ_РесурснаяСтоимостьПозиции = НаборЗаписей.Выгрузить();
			
		КонецЕсли;
		
		Если СтруктураДанныхРасчета.СМ_РесурснаяСтоимостьПозиции.Количество() > 0 Тогда
			
			ТекСтрока = СтруктураДанныхРасчета.СМ_РесурснаяСтоимостьПозиции[0];
			
			Параметры.СтоимПрямЗатраты		= ТекСтрока.СтоимПрямЗатраты;
			Параметры.СтоимОснЗарплата		= ТекСтрока.СтоимОснЗарплата;
			Параметры.СтоимЭксплМашин		= ТекСтрока.СтоимЭксплМашин;
			Параметры.СтоимЗарплМашин		= ТекСтрока.СтоимЗарплМашин;
			Параметры.СтоимСтоимМатер		= ТекСтрока.СтоимСтоимМатер;
			Параметры.СтоимОборуд			= ТекСтрока.СтоимОборуд;
			Параметры.СтоимВозвратМатер		= ТекСтрока.СтоимВозвратМатер;
			
			Параметры.ТекСтоимПрямЗатраты	= ТекСтрока.ТекСтоимПрямЗатраты;
			Параметры.ТекСтоимОснЗарплата	= ТекСтрока.ТекСтоимОснЗарплата;
			Параметры.ТекСтоимЭксплМашин	= ТекСтрока.ТекСтоимЭксплМашин;
			Параметры.ТекСтоимЗарплМашин	= ТекСтрока.ТекСтоимЗарплМашин;
			Параметры.ТекСтоимСтоимМатер	= ТекСтрока.ТекСтоимСтоимМатер;
			Параметры.ТекСтоимОборуд		= ТекСтрока.ТекСтоимОборуд;
			Параметры.ТекСтоимВозвратМатер	= ТекСтрока.ТекСтоимВозвратМатер;			
			
			Параметры.ЗатратыТрудаРабочих	= ТекСтрока.ЗатратыТрудаРабочих;
			Параметры.ЗатратыТрудаМашин		= ТекСтрока.ЗатратыТрудаМашин;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// ***********************************************
	// ++ AVV Ошибки учета ресурсов акта.
	// Для акта по ресурсному методу расчет поправок не делаем. 
	// Норма расхода по смете для акта и количество ресурсов по акту уже учитывает поправки.
	Если Акт <> Неопределено И ЛС.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
		Если ИспользоватьРС Тогда
			Отбор = Новый Структура();
			Отбор.Вставить("Позиция",СтруктураПараметровОтбораРС.СсылкаНаПозицию);
			Отбор.Вставить("Раздел",ТекущийРаздел);
			Отбор.Вставить("Смета",СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
			СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНабор("СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками",Отбор,Параметры);
		Иначе
			СтрокаСтоимость = СтруктураДанныхРасчета.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСтоимость,Параметры);
		КонецЕсли;
		Возврат;
	КонецЕсли;	
	// -- AVV
	// ***********************************************

	// Получаем таблицу поправок.
	ПоДокументу 		= Истина;
	ТаблПоправок		= ПолучитьПоправки(Объект, ПоДокументу);
	ДопЗМ 				= 0;
	ДопЗМТек 			= 0;
	ЗарплМашинистов 	= Параметры.СтоимЗарплМашин;
	ТекЗарплМашинистов 	= Параметры.ТекСтоимЗарплМашин;
	СтоимЗПМБезКоэфф 	= Параметры.СтоимЗарплМашин;

	Для Каждого СтрокаТаблПоправок Из ТаблПоправок Цикл
		
		ВариантРасчетаЭММ = ?(Не ЗначениеЗаполнено(СтрокаТаблПоправок.ВариантРасчета),ВариантРасчетаЭММ,СтрокаТаблПоправок.ВариантРасчета);
		Если Не ЗначениеЗаполнено(ВариантРасчетаЭММ)  Тогда
			ВариантРасчетаЭММ = Перечисления.СМ_ВариантыРасчетаЭММ.Одинаковые;
		КонецЕсли;
			
		КоэффПЗ 	= ?(СтрокаТаблПоправок.КоэффициентКПрямымЗатратам = 0,1,СтрокаТаблПоправок.КоэффициентКПрямымЗатратам);
		КоэффОЗ 	= ?(СтрокаТаблПоправок.КоэффициентКОсновнойЗарплате = 0,1,СтрокаТаблПоправок.КоэффициентКОсновнойЗарплате);
		КоэффЭМ 	= ?(СтрокаТаблПоправок.КоэффициентКЭксплуатацииМашин = 0,1,СтрокаТаблПоправок.КоэффициентКЭксплуатацииМашин);
		КоэффЗМ 	= ?(СтрокаТаблПоправок.КоэффициентКЗарплатеМашинистов = 0,1,СтрокаТаблПоправок.КоэффициентКЗарплатеМашинистов);
		КоэффСМ 	= ?(СтрокаТаблПоправок.КоэффициентКСтоимостиМатериалов = 0,1,СтрокаТаблПоправок.КоэффициентКСтоимостиМатериалов);
		КоэффЗТР 	= ?(СтрокаТаблПоправок.КоэффициентКТрудозатратамРабочих = 0,1,СтрокаТаблПоправок.КоэффициентКТрудозатратамРабочих);
		КоэффЗТМ 	= ?(СтрокаТаблПоправок.КоэффициентКТрудозатратамМашинистов = 0,1,СтрокаТаблПоправок.КоэффициентКТрудозатратамМашинистов);
		// Добавки к составляющим.
		ДобавПЗ = СтрокаТаблПоправок.ДобавитьКПрямымЗатратам;
		ДобавОЗ = СтрокаТаблПоправок.ДобавитьКОсновнойЗарплате;
		ДобавЭМ = СтрокаТаблПоправок.ДобавитьКЭксплуатацииМашин;
		ДобавЗМ = СтрокаТаблПоправок.ДобавитьКЗарплатеМашинистов;
		ДобавСМ = СтрокаТаблПоправок.ДобавитьКСтоимостиМатериалов;
		ДобавТР = СтрокаТаблПоправок.ДобавитьКТрудозатратамРабочих;
		ДобавТМ = СтрокаТаблПоправок.ДобавитьКТрудозатратам;
		
		// Если заданы добавки, они добавляются к составляющим и прямым затратам.
		Если ДобавПЗ <> 0 Тогда
			Параметры.Вставить("СтоимПрямЗатраты",(Параметры.СтоимПрямЗатраты + ДобавПЗ));
			Параметры.Вставить("ТекСтоимПрямЗатраты",(Параметры.ТекСтоимПрямЗатраты+ДобавПЗ));
		КонецЕсли;
		Если ДобавОЗ <> 0 Тогда
			Параметры.Вставить("СтоимОснЗарплата",Параметры.СтоимОснЗарплата + ДобавОЗ);
			Параметры.Вставить("ТекСтоимОснЗарплата",Параметры.ТекСтоимОснЗарплата+ДобавОЗ);
		КонецЕсли;
		Если ДобавЭМ <> 0 Тогда
			Параметры.Вставить("СтоимЭксплМашин",Параметры.СтоимЭксплМашин + ДобавЭМ);
			Параметры.Вставить("ТекСтоимЭксплМашин",Параметры.ТекСтоимЭксплМашин+ДобавЭМ);
		КонецЕсли;
		Если ДобавЗМ <> 0 Тогда
			Параметры.Вставить("СтоимЗарплМашин",Параметры.СтоимЗарплМашин + ДобавЗМ);
			Параметры.Вставить("ТекСтоимЗарплМашин",Параметры.ТекСтоимЗарплМашин+ДобавЗМ);
		КонецЕсли;
		Если ДобавСМ <> 0 Тогда
			Параметры.Вставить("СтоимСтоимМатер",Параметры.СтоимСтоимМатер + ДобавСМ);
			Параметры.Вставить("ТекСтоимСтоимМатер",Параметры.ТекСтоимСтоимМатер+ДобавСМ);
		КонецЕсли;
		Если ДобавТР <> 0 Тогда
			Параметры.Вставить("ЗатратыТрудаРабочих",Параметры.ЗатратыТрудаРабочих + ДобавТР);
		КонецЕсли;
		Если ДобавТМ <> 0 Тогда
			Параметры.Вставить("ЗатратыТрудаМашин",Параметры.ЗатратыТрудаМашин + ДобавТМ);
		КонецЕсли;
		
		// Обработка коэффициентов.
		Если КоэффПЗ <> 1 Тогда
			//  Если Задан коэффициент к ПЗ, то он применяется к каждой из составляющих.
			КоэффОЗ 	= КоэффПЗ * КоэффОЗ;
			КоэффЭМ 	= КоэффПЗ * КоэффЭМ;
			КоэффЗМ 	= КоэффПЗ * КоэффЗМ;
			КоэффСМ 	= КоэффПЗ * КоэффСМ;
			КоэффЗТР 	= КоэффПЗ * КоэффЗТР;
			КоэффЗТМ 	= КоэффПЗ * КоэффЗТМ;
			//
		КонецЕсли;	
		
		// Умножаем на коэффициенты.
		Параметры.Вставить("СтоимОснЗарплата",Параметры.СтоимОснЗарплата*КоэффОЗ);
		Параметры.Вставить("ТекСтоимОснЗарплата",Параметры.ТекСтоимОснЗарплата*КоэффОЗ);
		// Получаем измененную ЗМ.
		ЗарплМашинистов = Параметры.СтоимЗарплМашин;
		ТекЗарплМашинистов = Параметры.ТекСтоимЗарплМашин;
		
		Если ВариантРасчетаЭММ = Перечисления.СМ_ВариантыРасчетаЭММ.Одинаковые Тогда
			
			Параметры.Вставить("СтоимЭксплМашин",Параметры.СтоимЭксплМашин*КоэффЭМ);
			Параметры.Вставить("СтоимЗарплМашин",ЗарплМашинистов*КоэффЭМ);
			Параметры.Вставить("ТекСтоимЭксплМашин",Параметры.ТекСтоимЭксплМашин*КоэффЭМ);
			Параметры.Вставить("ТекСтоимЗарплМашин",ТекЗарплМашинистов *КоэффЭМ);
			
		ИначеЕсли ВариантРасчетаЭММ = Перечисления.СМ_ВариантыРасчетаЭММ.Разные Тогда
			Параметры.Вставить("СтоимЭксплМашин",Параметры.СтоимЭксплМашин*КоэффЭМ);
			Параметры.Вставить("ТекСтоимЭксплМашин",Параметры.ТекСтоимЭксплМашин*КоэффЭМ);
			Параметры.Вставить("ТекСтоимЗарплМашин",ТекЗарплМашинистов*КоэффЗМ);
			Параметры.Вставить("СтоимЗарплМашин",ЗарплМашинистов*КоэффЗМ);
			Если УчитыватьДопЗМ Тогда
				ДопЗМ = ДопЗМ + ЗарплМашинистов *(КоэффЗМ - КоэффЭМ); 
				ДопЗМТек = ДопЗМТек + ТекЗарплМашинистов *(КоэффЗМ - КоэффЭМ); 
			КонецЕсли;
			Параметры.Вставить("СтоимЭксплМашин",Параметры.СтоимЭксплМашин + ДопЗМ);
			Параметры.Вставить("ТекСтоимЭксплМашин",Параметры.ТекСтоимЭксплМашин + ДопЗМТек);
			
		ИначеЕсли ВариантРасчетаЭММ = Перечисления.СМ_ВариантыРасчетаЭММ.РазныеКРазности Тогда
			// Получаем измененную ЗМ.
			СтоимЗПМБезКоэфф = ЗарплМашинистов;
			СтоимЗПМ = ЗарплМашинистов*КоэффЗМ;
			Параметры.Вставить("СтоимЗарплМашин",СтоимЗПМ );
			СтоимостьЭМРазница = (Параметры.СтоимЭксплМашин - СтоимЗПМБезКоэфф)*КоэффЭМ;
			Параметры.Вставить("СтоимЭксплМашин",СтоимостьЭМРазница + СтоимЗПМ);
			
			ТекСтоимЗПМБезКоэфф = ТекЗарплМашинистов;
			ТекСтоимЗПМ = ТекЗарплМашинистов*КоэффЗМ;
			СтоимостьЭМРазница = (Параметры.ТекСтоимЭксплМашин - ТекСтоимЗПМБезКоэфф)*КоэффЭМ;
			
			Параметры.Вставить("ТекСтоимЭксплМашин",СтоимостьЭМРазница + ТекСтоимЗПМ);
			Параметры.Вставить("ТекСтоимЗарплМашин",ТекСтоимЗПМ);
			Если УчитыватьДопЗМ Тогда
				Если (КоэффЗМ - КоэффЭМ) <> 0 Тогда	
					ДопЗМ = ДопЗМ + ЗарплМашинистов *(КоэффЗМ - КоэффЭМ); 
					ДопЗМТек = ДопЗМТек + ТекЗарплМашинистов  *(КоэффЗМ - КоэффЭМ);
				Иначе
					ДопЗМ = ДопЗМ * КоэффЗМ; 
					ДопЗМТек = ДопЗМТек * КоэффЗМ;
				КонецЕсли;
			КонецЕсли;

		КонецЕсли;
		  	
		Параметры.Вставить("ДопЗМ",ДопЗМ);
		Параметры.Вставить("ДопЗМТек",ДопЗМТек);

		Параметры.Вставить("СтоимСтоимМатер",Параметры.СтоимСтоимМатер*КоэффСМ);
		Параметры.Вставить("ТекСтоимСтоимМатер",Параметры.ТекСтоимСтоимМатер*КоэффСМ);
		// Коэффициент ПЗ применяется к Оборудованию.
		Параметры.Вставить("СтоимОборуд",Параметры.СтоимОборуд*КоэффПЗ);
		Параметры.Вставить("ТекСтоимОборуд",Параметры.ТекСтоимОборуд*КоэффПЗ);
		
		Параметры.Вставить("СтоимВозвратМатер",Параметры.СтоимВозвратМатер);
		Параметры.Вставить("ТекСтоимВозвратМатер",Параметры.ТекСтоимВозвратМатер);
		
		Параметры.Вставить("ЗатратыТрудаРабочих",Параметры.ЗатратыТрудаРабочих*КоэффЗТР);
		Параметры.Вставить("ЗатратыТрудаМашин",Параметры.ЗатратыТрудаМашин*КоэффЗТМ);
		// Проверяем равны ли ПЗ  сумме составляющих, или ПЗ не состоит из составляющих.
		Если (Параметры.СтоимЭксплМашин + Параметры.СтоимОснЗарплата + Параметры.СтоимСтоимМатер) <> 0 Тогда
			СтоимПЗ = Параметры.СтоимЭксплМашин + Параметры.СтоимОснЗарплата + Параметры.СтоимСтоимМатер;
		Иначе 
			СтоимПЗ = Параметры.СтоимПрямЗатраты * КоэффПЗ;
		КонецЕсли;	
		Параметры.Вставить("СтоимПрямЗатраты",СтоимПЗ);
		Если (Параметры.ТекСтоимЭксплМашин + Параметры.ТекСтоимОснЗарплата + Параметры.ТекСтоимСтоимМатер) <> 0 Тогда
			ТекСтоимПЗ = Параметры.ТекСтоимЭксплМашин + Параметры.ТекСтоимОснЗарплата + Параметры.ТекСтоимСтоимМатер;
		Иначе 
			ТекСтоимПЗ = Параметры.ТекСтоимПрямЗатраты * КоэффПЗ;
		КонецЕсли;	
		Параметры.Вставить("ТекСтоимПрямЗатраты",ТекСтоимПЗ);
		
	КонецЦикла;
	
	Если ИспользоватьРС Тогда
	
		Отбор = Новый Структура();
		Отбор.Вставить("Позиция",СтруктураПараметровОтбораРС.СсылкаНаПозицию);
		Отбор.Вставить("Раздел",ТекущийРаздел);
		Отбор.Вставить("Смета",СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
		СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНабор("СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками",Отбор,Параметры);
		
	Иначе
		
		СтрокаСтоимость = СтруктураДанныхРасчета.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСтоимость,Параметры);
		
	КонецЕсли;

КонецПроцедуры

// Получает текущую цену позиции акта.
Процедура ПолучитьТекущуюЦенуПоПозицииАкта(АктСсылка,ПозицияСсылка,СтруктураЦен)
	Если  АктСсылка <> Неопределено Тогда
		ТекСтрока = АктСсылка.Позиции.Найти(ПозицияСсылка.Ссылка);
		Если ТекСтрока <> Неопределено Тогда
			СтруктураЦен.ТекущаяЦена = ТекСтрока.ТекущаяЦена;
			СтруктураЦен.ТекущаяЗарплатаМашинистов = ТекСтрока.ТекущаяЗарплатаМашинистов;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Выполняет расчет числовых параметров позиции локальной сметы и запись в регистр сведений
// СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.
//
// Параметры:
//     Позиция 						- ДокументОбъект.СМ_ПозицияЛокальнойСметы - объект позиции.
//     СтруктураДанныхРасчета 		- Структура - содержит таблицу данных для расчета (см. менеджер СМ_ПозицияЛокальнойСметы).
//     ЛС 							- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на локальную смету.
//     ОбъемРабот 					- Число - текущий объем работ.
//     РесурсныйРасчет 				- Булево - ресурсный метод счета, то Истина, иначе - Ложь.
//     ТаблСПоправками 				- ТаблицаЗначений - таблица с поправками позиции.
//     ПромОкр 						- Булево - выполнять или нет промежуточное округление.
//     Акт 							- ДокументСсылка.СМ_АктыВыполненныхРабот - если задан акт, передается ссылка на него.
//     СтруктураПараметровОтбораРС 	- Структура - содержит дополнительный отбор результирующего регистра сведений.
//     ИспользоватьРС 				- Булево - если Ложь, то все считается без чтения и записи из РС.
//
Процедура РасчитатьЧП(Позиция, СтруктураДанныхРасчета, ЛС, ОбъемРабот, РесурсныйРасчет = Ложь, ТаблСПоправками = Неопределено, ПромОкр = Ложь, Акт = Неопределено, СтруктураПараметровОтбораРС = Неопределено, ИспользоватьРС = Истина) Экспорт 
	
	Если СтруктураПараметровОтбораРС = Неопределено Тогда
		СтруктураПараметровОтбораРС = СМ_СметаВызовСервера.ПолучитьСтруктуруДанныхДляОтборовРегистра(Позиция, Акт, "СМ_ПозицияЛокальнойСметы");
	КонецЕсли;
	
	Если ИспользоватьРС Тогда
		
		// 1. Выборка по ПозицииЛС из регистра "Базисная единичная стоимость позиции с поправками".
		НаборЗаписей = РегистрыСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.Позиция.Установить(СтруктураПараметровОтбораРС.СсылкаНаПозицию);
		НаборЗаписей.Отбор.Смета.Установить(СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
		
	
		НаборЗаписей.Прочитать();
    	ТаблСПоправками = НаборЗаписей.Выгрузить();
		
	Иначе
		
		ТаблСПоправками = СтруктураДанныхРасчета.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.Скопировать();
		
	КонецЕсли;   
	
	ТекущийРаздел = СтруктураПараметровОтбораРС.СсылкаНаРаздел;
	
	//Если ЛС.МетодикаТСН Тогда
	Если ЛС.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква Тогда
		ПрименитьТрудРаб	= ЛС.ПрименитьЗУТрудРабочих;
		ПрименитьТрудМаш	= ЛС.ПрименитьЗУТрудМашинистов;
		ПризнакКапРемонт = ?(ЛС.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт,Истина,Ложь);

		Если Акт <> Неопределено Тогда
			СтрокаПозиции = СМ_СметаВызовСервера.СтрокаПозицииАкта(Акт, Позиция);
			Если Не СтрокаПозиции = Неопределено Тогда
				Если ПризнакКапРемонт Тогда
					КоэффЗУ = ?(СтрокаПозиции.ЗимнееУдорожРемонт = 0,1,СтрокаПозиции.ЗимнееУдорожРемонт);
					КоэффЗУМат = ?(СтрокаПозиции.ЗимнееУдорожМатериалРемонт = 0,1,СтрокаПозиции.ЗимнееУдорожМатериалРемонт);
				Иначе	
					КоэффЗУ = ?(СтрокаПозиции.ЗимнееУдорож = 0,1,СтрокаПозиции.ЗимнееУдорож);
					КоэффЗУМат = ?(СтрокаПозиции.ЗимнееУдорожМатериал = 0,1,СтрокаПозиции.ЗимнееУдорожМатериал);
				КонецЕсли;
				
			Иначе 
				КоэффЗУ = 1;
				КоэффЗУМат = 1;
			КонецЕсли;

		Иначе	
			Если ПризнакКапРемонт Тогда
				КоэффЗУ = ?(Позиция.ЗимнееУдорожРемонт = 0,1,Позиция.ЗимнееУдорожРемонт);
				КоэффЗУМат = ?(Позиция.ЗимнееУдорожМатериалРемонт = 0,1,Позиция.ЗимнееУдорожМатериалРемонт);
			Иначе	
				КоэффЗУ = ?(Позиция.ЗимнееУдорож = 0,1,Позиция.ЗимнееУдорож);
				КоэффЗУМат = ?(Позиция.ЗимнееУдорожМатериал = 0,1,Позиция.ЗимнееУдорожМатериал);
			КонецЕсли;
		КонецЕсли;		
		РасчетЗимнегоУдорожания(ТаблСПоправками,ПрименитьТрудРаб,ПрименитьТрудМаш,КоэффЗУ,КоэффЗУМат);
	КонецЕсли;	
	
	ТаблСПоправками.Колонки.Добавить("МассаБрутто", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,5,ДопустимыйЗнак.Неотрицательный)));
	
	Для Каждого СтрЗнач Из ТаблСПоправками Цикл
		СтрЗнач.МассаБрутто = Позиция.МассаБрутто;
		СтрЗнач.Смета       = СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета;
		СтрЗнач.Раздел 		= ТекущийРаздел;
	КонецЦикла;
	
	Если ИспользоватьРС Тогда
		
		// 2. Создание пустой таблицы аналога регистра «Базисная единичная стоимость позиции с начислениями».
		НаборЗаписей = РегистрыСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Позиция.Установить(СтруктураПараметровОтбораРС.СсылкаНаПозицию);
		НаборЗаписей.Отбор.Раздел.Установить(ТекущийРаздел);
		НаборЗаписей.Отбор.Смета.Установить(СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);	
		НаборЗаписей.Прочитать();
		
		ТаблРасчета = НаборЗаписей.Выгрузить();
		
	Иначе
		
		ТаблРасчета = СтруктураДанныхРасчета.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Скопировать();
		
	КонецЕсли;
	
	ТаблРасчета.Колонки.Добавить("Итог");
	ТаблРасчета.Колонки.Добавить("МассаБрутто", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,5,ДопустимыйЗнак.Неотрицательный)));

	ТаблРасчета.Очистить();
	
	// 3. Переход к расчету числовых параметров.
	//	Задание параметров округления.
	ОкрИтог =  ЛС.ОкруглятьДоРублей;
	ОбрабПогр = ЛС.ОбрабатыватьПогрешность;
	СтруктураДанныхРасчета.СМ_ИтогиЧППоРазделу = РасчетЧП(Позиция, СтруктураДанныхРасчета, ЛС, ТаблСПоправками, ТаблРасчета, РесурсныйРасчет, ПромОкр, ОкрИтог, ОбрабПогр, Акт, СтруктураПараметровОтбораРС, ИспользоватьРС);
	
	// 3.1 Удаление повторов и нулевых значений для простоты печати.
	Врем = Новый ТаблицаЗначений;
	Врем = СтруктураДанныхРасчета.СМ_ИтогиЧППоРазделу.Скопировать();
	Врем.Колонки.Добавить("Номер", Новый ОписаниеТипов("Число", , Новый КвалификаторыЧисла(3,0)));
	Врем.Колонки.Добавить("Накоп", Новый ОписаниеТипов("Булево"));
	
	СтруктураДанныхРасчета.СМ_ИтогиЧППоРазделу.Очистить();
	
	Для каждого СтрРасчета Из Врем Цикл
		СтрРасчета.Номер = СтрРасчета.Итог.ПорядковыйНомер;
		СтрРасчета.Накоп = СтрРасчета.Итог.Накопительный;
	КонецЦикла;
	
	Врем.Сортировать("Номер,Накоп");
	ИтогПЗ = 0;
	ИтогОб =  0 ;
	ИтогПЗБазис = 0; 
	ИтогоОББазис = 0;
	Начало = Истина;
	
	Для каждого СтрРасчета Из Врем Цикл
		Если  Позиция.Определитель.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
			Если Начало = Истина Тогда
				НоваяСтрока = СтруктураДанныхРасчета.СМ_ИтогиЧППоРазделу.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрРасчета);
				Если СтрРасчета.Накоп = Истина Тогда
					ИтогОБ =  СтрРасчета.ТекСтоимОборуд;
					ИтогОББазис = СтрРасчета.СтоимОборуд;
				КонецЕсли;
				Начало = Ложь;
				Продолжить;
			ИначеЕсли СтрРасчета.ТекСтоимОборуд = ИтогОб
				И СтрРасчета.СтоимОборуд = ИтогоОББазис
				И СтрРасчета.Накоп = Истина И Начало <> Истина Тогда
				Продолжить;
			ИначеЕсли СтрРасчета.ТекСтоимОборуд = 0
				И СтрРасчета.СтоимОборуд  = 0
				И СтрРасчета.Накоп = Ложь Тогда 	Продолжить;	
			Иначе
				НоваяСтрока = СтруктураДанныхРасчета.СМ_ИтогиЧППоРазделу.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрРасчета);
				Если СтрРасчета.Накоп = Истина Тогда
					ИтогОБ =  СтрРасчета.ТекСтоимОборуд;
					ИтогОББазис = СтрРасчета.СтоимОборуд;
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если Начало = Истина Тогда
				НоваяСтрока = СтруктураДанныхРасчета.СМ_ИтогиЧППоРазделу.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрРасчета);
				Если СтрРасчета.Накоп = Истина Тогда
					ИтогПЗ = СтрРасчета.ТекСтоимПрямЗатраты;
					ИтогПЗБазис = СтрРасчета.СтоимПрямЗатраты;
				КонецЕсли;
				Начало = Ложь;
				Продолжить;
			ИначеЕсли СтрРасчета.ТекСтоимПрямЗатраты = ИтогПЗ
				И СтрРасчета.СтоимПрямЗатраты = ИтогПЗБазис
				И СтрРасчета.Накоп = Истина И Начало <> Истина Тогда
				Продолжить;
			ИначеЕсли СтрРасчета.ТекСтоимПрямЗатраты = 0
				И СтрРасчета.СтоимПрямЗатраты = 0
				И СтрРасчета.Накоп = Ложь Тогда 	Продолжить;	
			Иначе
				НоваяСтрока = СтруктураДанныхРасчета.СМ_ИтогиЧППоРазделу.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрРасчета);
				Если СтрРасчета.Накоп = Истина Тогда
					ИтогПЗ = СтрРасчета.ТекСтоимПрямЗатраты;
					ИтогПЗБазис = СтрРасчета.СтоимПрямЗатраты;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;	
	
	// 4. Записть таблицы расчета в итоги по разлелу.
	Если ИспользоватьРС Тогда
		НаборЗаписей = РегистрыСведений.СМ_ИтогиЧППоРазделу.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Позиция.Установить(СтруктураПараметровОтбораРС.СсылкаНаПозицию);
		НаборЗаписей.Отбор.Раздел.Установить(ТекущийРаздел);
		НаборЗаписей.Отбор.Смета.Установить(СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		НаборЗаписей.Загрузить(СтруктураДанныхРасчета.СМ_ИтогиЧППоРазделу);
		НаборЗаписей.Записать();
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ПолучениеТаблицДляРасчетовИГрупповойОбработки

// Возвращает таблицу со сведениями о ресурсах Сметы (сводную или нет).
// ВАЖНО! Нельзя одновременно не учитывать цену при группировке и группировать по позициям, Если цена не учитывается -
// то группировка по позициям теряется.
//
// Параметры:
//     СписокПозиций 				- СписокЗначений - содержит элементы позициями или таблица с колонкой Позиция.
//     СвернутьТаблицу 				- Булево - сводная таблица или нет.
//     УчитыватьЦеныПриГруппировке 	- Булево - если Ложь, то ресурсы группируются без учета цен, так же добавляется
//                                             колонка с проверкой отклонения.
//     ГруппироватьПоПозициям 		- Булево - если Истина, то в итоговой колонке будет Позиция, иначе будет
//                                             сводная таблица.
//	   ТолькоФактическиеРесурсы     - Булево - если Истина то будут исключены ресурсы из позиций с объемом работ меньше 0. 
//	   БезНомераСтроки              - Булево - включать или нет номер строки в наименование ресурса.
//	   ГруппироватьПоСмете          - Булево - если Истина то будет добавлена колонка "смета" с группировкой по ней. 
//	   ГруппироватьСтатусы          - Булево - группировать или нет данные по статусам ресурсов сметы и акта. 
//
// Возвращаемое значение:
//     ТаблСтоимРес - ТаблицаЗначений - содержит ресурсы сметы, согласно переданным параметрам.
//
Функция ПолучитьТаблицуСтоимостиРесурсовСметы(СписокПозиций, СвернутьТаблицу = Ложь, УчитыватьЦеныПриГруппировке = Истина, ГруппироватьПоПозициям = Ложь, ТолькоФактическиеРесурсы = Ложь,БезНомераСтроки = Ложь,ГруппироватьПоСмете = Ложь,ГруппироватьСтатусы = Ложь) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Таблица = (ТипЗнч(СписокПозиций) <> Тип("СписокЗначений"));
	
	СтрокаТип = Новый ОписаниеТипов("Строка");
	ПараметрыЧисла = Новый КвалификаторыЧисла(15, 6);
	Число15_6 = Новый ОписаниеТипов("Число", , ПараметрыЧисла);
	ПараметрыЧисла = Новый КвалификаторыЧисла(20,6);
	Число15_2 = Новый ОписаниеТипов("Число", , ПараметрыЧисла);
	ПараметрыЧисла = Новый КвалификаторыЧисла(1,0);
	Число1_0 = Новый ОписаниеТипов("Число",,ПараметрыЧисла);
	
	ТаблСтоимРес = Новый ТаблицаЗначений();
	ТаблСтоимРес.Колонки.Добавить("КодРесурса", СтрокаТип);
	ТаблСтоимРес.Колонки.Добавить("Ресурс", Новый ОписаниеТипов("СправочникСсылка.СМ_Ресурсы"));
	ТаблСтоимРес.Колонки.Добавить("ВидРесурса", Новый ОписаниеТипов("ПеречислениеСсылка.СМ_ВидыРесурсов"));
	ТаблСтоимРес.Колонки.Добавить("НаименованиеРесурса", СтрокаТип);
	ТаблСтоимРес.Колонки.Добавить("ЕдиницаИзмеренияРесурса", Новый ОписаниеТипов("СправочникСсылка.СМ_ЕдиницыИзмеренияСмета"));
	ТаблСтоимРес.Колонки.Добавить("НормаРасхода", Число15_6);
	ТаблСтоимРес.Колонки.Добавить("Количество", Число15_6);
	ТаблСтоимРес.Колонки.Добавить("РасходПоНорме", Число15_6);
	ТаблСтоимРес.Колонки.Добавить("РасходПоФакту", Число15_6);
	ТаблСтоимРес.Колонки.Добавить("ЦенаБазисная", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("ЦенаЗМБазисная", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("СтоимостьБазисная", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("СтоимостьЗМБазисная", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("ЦенаТекущая", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("ЦенаТекущаяЗМ", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("СтоимостьТекущая", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("СтоимостьТекущаяЗМ", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("ЭтоУчтенный", Новый ОписаниеТипов("Булево"));
	ТаблСтоимРес.Колонки.Добавить("ЭтоНеучтенный", Новый ОписаниеТипов("Булево"));
	ТаблСтоимРес.Колонки.Добавить("ЭтоОборудование", Новый ОписаниеТипов("Булево"));
	ТаблСтоимРес.Колонки.Добавить("Картинка", Число1_0);
	ТаблСтоимРес.Колонки.Добавить("Сортировка1", Новый ОписаниеТипов("Число"));
	ТаблСтоимРес.Колонки.Добавить("СтатусРесурса", Новый ОписаниеТипов("ПеречислениеСсылка.СМ_ОбеспечениеРесурса"));
	ТаблСтоимРес.Колонки.Добавить("НеИзменятьЦены", Новый ОписаниеТипов("Булево"));
	ТаблСтоимРес.Колонки.Добавить("НомерСтрокиДокумента", Число15_2);
			
	Если ГруппироватьПоПозициям Тогда
		ТаблСтоимРес.Колонки.Добавить("Позиция", Новый ОписаниеТипов("ДокументСсылка.СМ_ПозицияЛокальнойСметы"));	
	КонецЕсли;
	
	Если ГруппироватьПоСмете Тогда
		ТаблСтоимРес.Колонки.Добавить("Смета", Новый ОписаниеТипов("ДокументСсылка.СМ_ЛокальнаяСмета"));	
	КонецЕсли;

	СписокПозицийОтбор = Новый СписокЗначений();
	Если Таблица Тогда
		СписокПозицийОтбор.ЗагрузитьЗначения(СписокПозиций.Выгрузить().ВыгрузитьКолонку("Позиция"));	 
	Иначе
		СписокПозицийОтбор = СписокПозиций;
	КонецЕсли;
	
	ТаблПоправок = ПолучитьПоправки(СписокПозицийОтбор,Ложь);
	
	Если ТолькоФактическиеРесурсы Тогда
		// Получим отминусованные.
		ТабМинусовых = ПолучитьМинусовые(СписокПозицийОтбор);
	КонецЕсли;
	
	Для каждого ПозицияЭл Из СписокПозицийОтбор Цикл  		
		
		Позиция = ПозицияЭл.Значение;
		
		Если (ТипЗнч(Позиция) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если Позиция.ОбъемРабот < 0 И ТолькоФактическиеРесурсы И Позиция.Определитель.ВидРасценки <> Перечисления.СМ_ВидыРасценки.Работа Тогда
			Продолжить;
		КонецЕсли;
		
		//Если Позиция.ИдСметы.МетодикаТСН Тогда
		Если Позиция.ИдСметы.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква Тогда
			// Применим ЗУ.
			ПрименитьЗУНормамМат = Позиция.ИдСметы.ПрименитьЗУНормамМат;
			ПрименитьЗУНормамМаш = Позиция.ИдСметы.ПрименитьЗУНормамМаш;
			ПрименитьЗУТрудРабочих =  Позиция.ИдСметы.ПрименитьЗУТрудРабочих;
			ПрименитьЗУТрудМашинистов = Позиция.ИдСметы.ПрименитьЗУТрудМашинистов;
			ТипСтроительстваРемонт = (Позиция.ИдСметы.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт);
		Иначе
			ПрименитьЗУНормамМат = Ложь;
			ПрименитьЗУНормамМаш = Ложь;
			ПрименитьЗУТрудРабочих =  Ложь;
			ПрименитьЗУТрудМашинистов = Ложь;
			ТипСтроительстваРемонт = Ложь;
		КонецЕсли;			
		
		Для каждого СтрокаРесурса Из Позиция.РесурсыПозицииЛокальнойСметы Цикл
			
			Если СтрокаРесурса.ТипМатериала = Перечисления.СМ_ТипыМатериалов.НеУчтенный ИЛИ СтрокаРесурса.ТипМатериала = Перечисления.СМ_ТипыМатериалов.ПоПроекту ИЛИ СтрокаРесурса.Удален Тогда
				Продолжить;	
			КонецЕсли;
			
			Количество = СтрокаРесурса.НормаРасхода * ?(ЗначениеЗаполнено(СтрокаРесурса.КоэффициентКРасходуРесурсов),СтрокаРесурса.КоэффициентКРасходуРесурсов,1);
			
			ОтборПоправок = Новый Структура();
			ОтборПоправок.Вставить("Позиция", Позиция); 
			МассивПоправок = ТаблПоправок.НайтиСтроки(ОтборПоправок);
			
			Для каждого СтрокаТаблПоправок Из МассивПоправок Цикл
				Если СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда	
					Количество = Количество * СтрокаТаблПоправок.КоэффициентКТрудозатратамРабочих;	
				ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда	
					Количество = Количество * СтрокаТаблПоправок.КоэффициентКТрудозатратамМашинистов;	
				ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда	
					Количество = Количество * СтрокаТаблПоправок.КоэффициентКСтоимостиМатериалов;	
				ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда	
					Количество = Количество * СтрокаТаблПоправок.КоэффициентКЭксплуатацииМашин;	
				КонецЕсли;
			КонецЦикла;
			
			// Умножать если не 0. 
			Если ТипСтроительстваРемонт Тогда
				ЗимнееУдорож = ?(Позиция.ЗимнееУдорожРемонт = 0,1,Позиция.ЗимнееУдорожРемонт);
				ЗимнееУдорожМатериал = ?(Позиция.ЗимнееУдорожМатериалРемонт = 0,1,Позиция.ЗимнееУдорожМатериалРемонт);
			Иначе
				ЗимнееУдорож = ?(Позиция.ЗимнееУдорож = 0,1,Позиция.ЗимнееУдорож);
				ЗимнееУдорожМатериал = ?(Позиция.ЗимнееУдорожМатериал = 0,1,Позиция.ЗимнееУдорожМатериал);
			КонецЕсли;
			
			Если ПрименитьЗУТрудРабочих И СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
				Количество = Количество * ЗимнееУдорож;
			КонецЕсли;
			
			Если ПрименитьЗУТрудМашинистов И СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда
				Количество = Количество * ЗимнееУдорож;
			КонецЕсли;
			
			Если ПрименитьЗУНормамМаш И СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
				Количество = Количество * ЗимнееУдорож;
			КонецЕсли;
			
			Если ПрименитьЗУНормамМат И СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
				Количество = Количество * ЗимнееУдорожМатериал;
			КонецЕсли;
			
			Если ТолькоФактическиеРесурсы Тогда
				// Отсеим отминусованные.
				Пропускаем = Ложь;
				Если ТабМинусовых.Количество() > 0 Тогда
					Отбор = Новый Структура();
					Отбор.Вставить("ИДВладельца", Позиция);
					Отбор.Вставить("ШифрРасценки", СтрокаРесурса.СметныйКодРесурса);
					МассивМинусовых = ТабМинусовых.НайтиСтроки(Отбор);
					Для Каждого СтрМинус Из МассивМинусовых Цикл
						Если -1*СтрМинус.ОбъемРабот = Количество * Позиция.ОбъемРабот Тогда
							Пропускаем = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если Пропускаем Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			СтрокаТаблСтоимРес 				= ТаблСтоимРес.Добавить();
			СтрокаТаблСтоимРес.Ресурс 		= СтрокаРесурса.Ресурс;
			СтрокаТаблСтоимРес.КодРесурса 	= ?(ЗначениеЗаполнено(СтрокаРесурса.Ресурс),СтрокаРесурса.Ресурс.Код,СтрокаРесурса.СметныйКодРесурса);
			СтрокаТаблСтоимРес.ВидРесурса 	= СтрокаРесурса.ВидРесурса;
			СтрокаТаблСтоимРес.НаименованиеРесурса = ?(БезНомераСтроки,СтрокаРесурса.НаименованиеРесурса,Строка(СтрокаРесурса.НомерСтроки)+" "+СтрокаРесурса.НаименованиеРесурса);
			СтрокаТаблСтоимРес.ЕдиницаИзмеренияРесурса = СтрокаРесурса.Ресурс.ЕдиницаИзмерения;
			СтрокаТаблСтоимРес.НомерСтрокиДокумента = ?(БезНомераСтроки,0,СтрокаРесурса.НомерСтроки);
			СтрокаТаблСтоимРес.НормаРасхода = СтрокаРесурса.НормаРасхода;
			СтрокаТаблСтоимРес.Количество = Количество;
			СтрокаТаблСтоимРес.РасходПоНорме = Количество * Позиция.ОбъемРабот;
			СтрокаТаблСтоимРес.РасходПоФакту = Количество * Позиция.ОбъемРабот;
			СтрокаТаблСтоимРес.ЦенаБазисная = СтрокаРесурса.БазиснаяЦена;
			СтрокаТаблСтоимРес.ЦенаЗМБазисная = СтрокаРесурса.БазиснаяЗарплатаМашинистов;
			СтрокаТаблСтоимРес.СтоимостьБазисная = Количество * СтрокаРесурса.БазиснаяЦена;
			СтрокаТаблСтоимРес.СтоимостьЗМБазисная = Количество * СтрокаРесурса.БазиснаяЗарплатаМашинистов;
			СтрокаТаблСтоимРес.ЦенаТекущая = СтрокаРесурса.ТекущаяЦена;
			СтрокаТаблСтоимРес.ЦенаТекущаяЗМ = СтрокаРесурса.ТекущаяЗарплатаМашинистов;
			СтрокаТаблСтоимРес.СтоимостьТекущая = Количество * СтрокаРесурса.ТекущаяЦена;
			Если Константы.СМ_РасчетСтоимостиВспомогательныхМатериаловОЗМонтажников.Получить() = Истина Тогда
				Если СтрокаРесурса.СметныйКодРесурса = Константы.СМ_ВспомогательныеМатериалы.Получить().Код Тогда
					СтрокаТаблСтоимРес.СтоимостьТекущая = СМ_СметаРасчетРесурсныйСервер.РассчитатьСтоимостьВспомогательных(Позиция.Ссылка, Позиция.РесурсыПозицииЛокальнойСметы);  
				КонецЕсли;
			КонецЕсли;
			СтрокаТаблСтоимРес.СтоимостьТекущаяЗМ = Количество * СтрокаРесурса.ТекущаяЗарплатаМашинистов;
			СтрокаТаблСтоимРес.ЭтоУчтенный = Истина;
			СтрокаТаблСтоимРес.ЭтоНеучтенный = Ложь;
			СтрокаТаблСтоимРес.ЭтоОборудование = Ложь;
			СтрокаТаблСтоимРес.Картинка = СМ_СметаКлиентСервер.ПолучитьКартинкуРесурса(СтрокаРесурса.ТипМатериала, СтрокаРесурса.ВидРесурса);
			СтрокаТаблСтоимРес.СтатусРесурса  = СтрокаРесурса.СтатусРесурса;
			СтрокаТаблСтоимРес.НеИзменятьЦены  = СтрокаРесурса.НеИзменятьЦены;
			Если ГруппироватьПоПозициям Тогда
				СтрокаТаблСтоимРес.Позиция = Позиция;
			КонецЕсли;
			
			Если ГруппироватьПоСмете Тогда
				СтрокаТаблСтоимРес.Смета = Позиция.ИдСметы;
			КонецЕсли;
			
			// Сортировка (обязательно по убыванию, таким образом все ресурсы, 
			// которые не обрабатываются будут попадать вниз, т.к. значение = "0").
			Если СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
				СтрокаТаблСтоимРес.Сортировка1	= 3;	
			ИначеЕсли СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
				СтрокаТаблСтоимРес.Сортировка1	= 2;	
			ИначеЕсли СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
				СтрокаТаблСтоимРес.Сортировка1	= 1;	
			КонецЕсли;
			
		КонецЦикла;
		
		Если Позиция.РесурсыПозицииЛокальнойСметы.Количество() = 0
			И (Позиция.Определитель.ВидРасценки =  Перечисления.СМ_ВидыРасценки.Материал
			ИЛИ Позиция.Определитель.ВидРасценки =  Перечисления.СМ_ВидыРасценки.Оборудование) Тогда
			
			СтрокаТаблСтоимРес = ТаблСтоимРес.Добавить();
			СтрокаТаблСтоимРес.СтатусРесурса  = Позиция.СтатусРесурса;	
			СтрокаТаблСтоимРес.НеИзменятьЦены  = Позиция.НеИзменятьЦены;
			СтрокаТаблСтоимРес.КодРесурса = Позиция.ШифрРасценки;
			СтрокаТаблСтоимРес.НаименованиеРесурса = Позиция.Наименование;
			СтрокаТаблСтоимРес.ЕдиницаИзмеренияРесурса = Позиция.ЕдиницаИзмерения;
			СтрокаТаблСтоимРес.Ресурс = Справочники.СМ_Ресурсы.ПустаяСсылка();
			
			СтрокаТаблСтоимРес.НормаРасхода = 1;

			ЭтоМатериал =  (Позиция.Определитель.ВидРасценки =  Перечисления.СМ_ВидыРасценки.Материал);
			СтрокаТаблСтоимРес.ВидРесурса = ?(ЭтоМатериал, ?(Позиция.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин, Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы, Перечисления.СМ_ВидыРесурсов.Материалы), Перечисления.СМ_ВидыРесурсов.Оборудование);
			
			ВремКоличество = СтрокаТаблСтоимРес.НормаРасхода;
			
			Для каждого СтрокаПоправки Из Позиция.ПоправкиПозиции Цикл
				Если СтрокаПоправки.КоэффСМ <> 0 И ЭтоМатериал Тогда
					ВремКоличество = ВремКоличество * СтрокаПоправки.КоэффСМ; 
				КонецЕсли;
				Если СтрокаПоправки.КоэффПЗ <> 0 Тогда
					ВремКоличество = ВремКоличество * СтрокаПоправки.КоэффПЗ; 
				КонецЕсли;
			КонецЦикла;	
			
			Если ПрименитьЗУТрудРабочих И СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
				ВремКоличество = ВремКоличество * ?(ТипСтроительстваРемонт, Позиция.ЗимнееУдорожРемонт, Позиция.ЗимнееУдорож);
			КонецЕсли;
			
			Если ПрименитьЗУТрудМашинистов И СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда
				ВремКоличество = ВремКоличество * ?(ТипСтроительстваРемонт, Позиция.ЗимнееУдорожРемонт, Позиция.ЗимнееУдорож);
			КонецЕсли;
			
			Если ПрименитьЗУНормамМаш И СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
				ВремКоличество = ВремКоличество * ?(ТипСтроительстваРемонт, Позиция.ЗимнееУдорожРемонт, Позиция.ЗимнееУдорож);
			КонецЕсли;
			
			Если ПрименитьЗУНормамМат И СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
				ВремКоличество = ВремКоличество * ?(ТипСтроительстваРемонт, Позиция.ЗимнееУдорожМатериалРемонт, Позиция.ЗимнееУдорожМатериал);
			КонецЕсли;

			СтрокаТаблСтоимРес.Количество = ВремКоличество;
			
			СтрокаТаблСтоимРес.РасходПоНорме = ВремКоличество * Позиция.ОбъемРабот;
						
			СтрокаТаблСтоимРес.РасходПоФакту = ВремКоличество * Позиция.ОбъемРабот;
			
			Если ЭтоМатериал Тогда
				СтрокаТаблСтоимРес.ЦенаБазисная = Позиция.СтоимМатериалов;
				СтрокаТаблСтоимРес.ЦенаЗМБазисная = 0; 
				СтрокаТаблСтоимРес.СтоимостьБазисная = ВремКоличество * Позиция.ПрямЗатраты;
				СтрокаТаблСтоимРес.СтоимостьЗМБазисная = 0;
			Иначе
				СтрокаТаблСтоимРес.ЦенаБазисная = Позиция.Оборудование;
				СтрокаТаблСтоимРес.ЦенаЗМБазисная = 0; 
				СтрокаТаблСтоимРес.СтоимостьБазисная = ВремКоличество * Позиция.Оборудование;
				СтрокаТаблСтоимРес.СтоимостьЗМБазисная = 0;
			КонецЕсли;
			
			СтрокаТаблСтоимРес.ЦенаТекущая = Позиция.ТекущаяЦена;
			СтрокаТаблСтоимРес.ЦенаТекущаяЗМ = 0;

			СтрокаТаблСтоимРес.СтоимостьТекущая = ВремКоличество * Позиция.ТекущаяЦена;
			СтрокаТаблСтоимРес.СтоимостьТекущаяЗМ = 0;
			
			СтрокаТаблСтоимРес.ЭтоУчтенный = Ложь;
			СтрокаТаблСтоимРес.ЭтоНеучтенный = (Позиция.Определитель.ВидРасценки <> Перечисления.СМ_ВидыРасценки.Оборудование);
			СтрокаТаблСтоимРес.ЭтоОборудование = (Позиция.Определитель.ВидРасценки =  Перечисления.СМ_ВидыРасценки.Оборудование);
			// Тут только неучтенные и оборудование.
			СтрокаТаблСтоимРес.Картинка = СМ_СметаКлиентСервер.ПолучитьКартинкуРесурса(?(СтрокаТаблСтоимРес.ЭтоНеучтенный, Перечисления.СМ_ТипыМатериалов.НеУчтенный, Перечисления.СМ_ТипыМатериалов.Учтенный), СтрокаТаблСтоимРес.ВидРесурса);

			Если ГруппироватьПоПозициям Тогда
				СтрокаТаблСтоимРес.Позиция = Позиция;
			КонецЕсли;
			
			Если ГруппироватьПоСмете Тогда
				СтрокаТаблСтоимРес.Смета = Позиция.ИдСметы;
			КонецЕсли;
			
			СтрокаТаблСтоимРес.НомерСтрокиДокумента = ?(БезНомераСтроки,0,СМ_СметаВызовСервера.ПолучитьНомерДокумента(Позиция,"СМ_ПозицияЛокальнойСметы"));
						
			// Сортировка (обязательно по убыванию, таким образом все ресурсы, 
			// которые не обрабатываются будут попадать вниз, т.к. значение = "0").
			Если СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
				СтрокаТаблСтоимРес.Сортировка1	= 3;	
			ИначеЕсли СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
				СтрокаТаблСтоимРес.Сортировка1	= 2;	
			ИначеЕсли СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
				СтрокаТаблСтоимРес.Сортировка1	= 1;	
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Если СвернутьТаблицу Тогда
		ТаблСтоимРес.Свернуть("Ресурс, КодРесурса, ВидРесурса, НаименованиеРесурса, ЕдиницаИзмеренияРесурса, ЭтоУчтенный, ЭтоНеучтенный, ЭтоОборудование, ЦенаБазисная, ЦенаЗМБазисная, ЦенаТекущая, ЦенаТекущаяЗМ, Картинка,НеИзменятьЦены " + ?(ГруппироватьПоПозициям, ", Позиция", "")+?(ГруппироватьПоСмете, ", Смета", "")+?(ГруппироватьСтатусы, ", СтатусРесурса", ""), "Количество, РасходПоНорме, РасходПоФакту, СтоимостьБазисная, СтоимостьЗМБазисная, СтоимостьТекущая, СтоимостьТекущаяЗМ");   
		Если (Не УчитыватьЦеныПриГруппировке) Тогда
			ТаблСтоимРес = ?(ГруппироватьСтатусы,ПолучитьТаблицуБезГруппировкиПоЦенамСтатусы(ТаблСтоимРес),ПолучитьТаблицуБезГруппировкиПоЦенам(ТаблСтоимРес));		
		КонецЕсли;
		ТаблСтоимРес.Сортировать("ЭтоНеучтенный, ЭтоОборудование, ВидРесурса, КодРесурса");	
	КонецЕсли; 
	
	Для каждого стр Из ТаблСтоимРес Цикл
		стр.КодРесурса 			= СокрЛП(стр.КодРесурса);
		стр.НаименованиеРесурса = СокрЛП(стр.НаименованиеРесурса);
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ТаблСтоимРес;
	
КонецФункции

// Возвращает таблицу со сведениями о ресурсах Акта (сводную или нет).
// ВАЖНО! Нельзя одновременно не учитывать цену при группировке и группировать по позициям, Если цена не учитывается -
// то группировка по позициям теряется.
//
// Параметры:
//     Акт 							- ДокументСсылка.СМ_АктыВыполненныхРабот - Акт для которого формируется список ресурсов.
//     СвернутьТаблицу 				- Булево - сводная таблица или нет.
//     ОтборПозицийСписок 			- СписокЗначений - содержит элементы для отбора позиций в акте.
//     УчитыватьЦеныПриГруппировке 	- Булево - если Ложь, то ресурсы группируются без учета цен, так же добавляется
//                                             колонка с проверкой отклонения.
//     ГруппироватьПоПозициям 		- Булево - если Истина, то в итоговой колонке будет Позиция, иначе будет
//                                             сводная таблица.
//     БезНомераСтроки				- Булево - включать или нет номер строки в наименование ресурса.
//     ГруппироватьПоСмете          - Булево - если Истина то будет добавлена колонка "смета" с группировкой по ней. 
//	   ГруппироватьСтатусы          - Булево - группировать или нет данные по статусам ресурсов сметы и акта.
//	   ГруппироватьНеИзменятьЦены   - Булево - изменять или нет цены при группировке.
//	   ДетализацияОтклонения        - Булево - группировать или нет данные по варианту отклонения.
//	   ЗаменыРесурсов				- Булево - если Истина, то в итоговой таблице будут включены все замены ресурсов по позициям.
//
// Возвращаемое значение:
//     ТаблСтоимРес - ТаблицаЗначений - содержит ресурсы акта, согласно переданным параметрам.
//
Функция ПолучитьТаблицуСтоимостиРесурсовАкта(Акт, СвернутьТаблицу = Ложь, ОтборПозицийСписок = Неопределено, УчитыватьЦеныПриГруппировке = Истина, ГруппироватьПоПозициям = Ложь,БезНомераСтроки = Ложь,ГруппироватьПоСмете = Ложь,ГруппироватьСтатусы = Ложь,ГруппироватьНеИзменятьЦены = Ложь, ДетализацияОтклонения = Ложь, ЗаменыРесурсов = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	СписокПозиций = Новый СписокЗначений();
	Если ОтборПозицийСписок = Неопределено Тогда
		СписокПозиций.ЗагрузитьЗначения(Акт.Позиции.Выгрузить(,"Позиция").ВыгрузитьКолонку("Позиция"));
	Иначе
		СписокПозиций = ОтборПозицийСписок;
	КонецЕсли;
	
	ТаблицаБазисныхЦен = СМ_СметаВызовСервера.ПолучитьСписокВсехРесурсовПозиций(СписокПозиций, , ИСТИНА);	
	
	Таблица = (ТипЗнч(СписокПозиций) <> Тип("СписокЗначений"));
	
	СтрокаТип = Новый ОписаниеТипов("Строка");
	ПараметрыЧисла = Новый КвалификаторыЧисла(15, 6);
	Число15_6 = Новый ОписаниеТипов("Число", , ПараметрыЧисла);
	ПараметрыЧисла = Новый КвалификаторыЧисла(15, 2);
	Число15_2 = Новый ОписаниеТипов("Число", , ПараметрыЧисла);
	ПараметрыЧисла = Новый КвалификаторыЧисла(1,0);
	Число1_0 = Новый ОписаниеТипов("Число",,ПараметрыЧисла);
	
	ТаблСтоимРес = Новый ТаблицаЗначений();
	ТаблСтоимРес.Колонки.Добавить("КодРесурса", СтрокаТип);
	ТаблСтоимРес.Колонки.Добавить("Ресурс", Новый ОписаниеТипов("СправочникСсылка.СМ_Ресурсы"));
	ТаблСтоимРес.Колонки.Добавить("ВидРесурса", Новый ОписаниеТипов("ПеречислениеСсылка.СМ_ВидыРесурсов"));
	ТаблСтоимРес.Колонки.Добавить("НаименованиеРесурса", СтрокаТип);
	ТаблСтоимРес.Колонки.Добавить("ЕдиницаИзмеренияРесурса", Новый ОписаниеТипов("СправочникСсылка.СМ_ЕдиницыИзмеренияСмета"));
	ТаблСтоимРес.Колонки.Добавить("НормаРасхода", Число15_6);
	ТаблСтоимРес.Колонки.Добавить("Количество", Число15_6);
	ТаблСтоимРес.Колонки.Добавить("РасходПоНорме", Число15_6);
	ТаблСтоимРес.Колонки.Добавить("РасходПоФакту", Число15_6);
	ТаблСтоимРес.Колонки.Добавить("ЦенаБазисная", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("ЦенаЗМБазисная", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("СтоимостьБазисная", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("СтоимостьЗМБазисная", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("ЦенаТекущая", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("ЦенаТекущаяЗМ", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("СтоимостьТекущая", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("СтоимостьТекущаяЗМ", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("ЭтоУчтенный", Новый ОписаниеТипов("Булево"));
	ТаблСтоимРес.Колонки.Добавить("ЭтоНеучтенный", Новый ОписаниеТипов("Булево"));
	ТаблСтоимРес.Колонки.Добавить("ЭтоОборудование", Новый ОписаниеТипов("Булево"));
	ТаблСтоимРес.Колонки.Добавить("Картинка", Число1_0);
	ТаблСтоимРес.Колонки.Добавить("Сортировка1", Новый ОписаниеТипов("Число"));
	Если ГруппироватьПоПозициям Тогда
		ТаблСтоимРес.Колонки.Добавить("Позиция", Новый ОписаниеТипов("ДокументСсылка.СМ_ПозицияЛокальнойСметы"));	
		ТаблСтоимРес.Колонки.Добавить("ФактОбъем", Число15_2);	
	КонецЕсли;
	Если ГруппироватьПоСмете Тогда
		ТаблСтоимРес.Колонки.Добавить("Смета", Новый ОписаниеТипов("ДокументСсылка.СМ_ЛокальнаяСмета"));	
	КонецЕсли;
	ТаблСтоимРес.Колонки.Добавить("СтатусРесурса", Новый ОписаниеТипов("ПеречислениеСсылка.СМ_ОбеспечениеРесурса"));
	ТаблСтоимРес.Колонки.Добавить("ИзмененФактРасход", Новый ОписаниеТипов("Булево"));
	ТаблСтоимРес.Колонки.Добавить("НеИзменятьЦены", Новый ОписаниеТипов("Булево"));
	ТаблСтоимРес.Колонки.Добавить("ВариантОтклонения", Новый ОписаниеТипов("ПеречислениеСсылка.СМ_ВариантыОтклоненияНормы"));
	ТаблСтоимРес.Колонки.Добавить("ВариантПревышения", Новый ОписаниеТипов("ПеречислениеСсылка.СМ_ВариантыСписанияПревышения"));
	ТаблСтоимРес.Колонки.Добавить("КомментарийКФайлу", СтрокаТип);	
	ТаблСтоимРес.Колонки.Добавить("НомерСтрокиДокумента", Число15_2);
	ТаблСтоимРес.Колонки.Добавить("Заменен", Новый ОписаниеТипов("Булево"));
	ТаблСтоимРес.Колонки.Добавить("ЭтоЗамена", Новый ОписаниеТипов("Булево"));
	ТаблСтоимРес.Колонки.Добавить("СортировкаЗамен", Число1_0);
	
	Если ЗаменыРесурсов Тогда
		СписокАктов = Новый СписокЗначений();
		СписокАктов.Добавить(Акт.Ссылка);
		ТаблицаПредыдущихЗамен 		= СМ_СметаВызовСервера.ПолучитьЗамененныеРесурсыАктов(СписокАктов); 
		СписокЗамененныхРесурсов 	= Новый Соответствие;
	КонецЕсли;

	ТаблПоправок = ПолучитьПоправки(СписокПозиций,Ложь); 
	
	//Если Акт.ЛокальнаяСмета.МетодикаТСН Тогда
	Если Акт.ЛокальнаяСмета.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква Тогда
		// Применим ЗУ.
		ПрименитьЗУНормамМат 		= Акт.ЛокальнаяСмета.ПрименитьЗУНормамМат;
		ПрименитьЗУНормамМаш 		= Акт.ЛокальнаяСмета.ПрименитьЗУНормамМаш;
		ПрименитьЗУТрудРабочих 		= Акт.ЛокальнаяСмета.ПрименитьЗУТрудРабочих;
		ПрименитьЗУТрудМашинистов 	= Акт.ЛокальнаяСмета.ПрименитьЗУТрудМашинистов;
		ТипСтроительстваРемонт 		= (Акт.ЛокальнаяСмета.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт);
	Иначе
		ПрименитьЗУНормамМат 		= Ложь;
		ПрименитьЗУНормамМаш 		= Ложь;
		ПрименитьЗУТрудРабочих 		= Ложь;
		ПрименитьЗУТрудМашинистов 	= Ложь;
		ТипСтроительстваРемонт 		= Ложь;
	КонецЕсли;
	
	СортировкаЗамен = 1;
	
	Для Каждого СтрокаПозицииАкта Из Акт.Позиции Цикл
		
		Позиция = СтрокаПозицииАкта.Позиция;
		
		Если (СписокПозиций.НайтиПоЗначению(Позиция) = Неопределено) Тогда
			Продолжить;	
		КонецЕсли;
		
		МассивНужныхСтрок 		= СМ_СметаВызовСервера.МассивСтрокРесурсовПозицииАкта(Акт, Позиция);
		СчЗамен 				= 0;
		
		Для Каждого СтрокаРесурса Из МассивНужныхСтрок Цикл
		
			Если СтрокаРесурса.ТипМатериала = Перечисления.СМ_ТипыМатериалов.НеУчтенный ИЛИ СтрокаРесурса.ТипМатериала = Перечисления.СМ_ТипыМатериалов.ПоПроекту ИЛИ СтрокаРесурса.Удален Тогда
				Продолжить;	
			КонецЕсли;
			
			Отбор = Новый Структура();
			Отбор.Вставить("Позиция", СтрокаРесурса.Позиция);
			Отбор.Вставить("Ресурс", СтрокаРесурса.Ресурс);
			
			МассивБЦ = ТаблицаБазисныхЦен.НайтиСтроки(Отбор);
			
			БазиснаяЦена = СтрокаРесурса.БазиснаяЦена;	
			БазиснаяЗарплатаМашинистов = СтрокаРесурса.БазиснаяЗарплатаМашинистов;
			
			РасчетКоличества = Истина;
			Если МассивБЦ.Количество() Тогда
				НормаРасхода = МассивБЦ[0].НормаРасхода;
				КоэффРасхода = ?(ЗначениеЗаполнено(МассивБЦ[0].КоэффициентКРасходуРесурсов),МассивБЦ[0].КоэффициентКРасходуРесурсов,1);
			Иначе
				// Это новый ресурс, которым заменяем.
				// Есть введенная пользователем норма расхода на объем.
				НормаРасходаНаОбъем = СтрокаРесурса.НормаРасходаОбъем;
				РасчетКоличества 	= Ложь;
				
				Если СтрокаПозицииАкта.ФактОбъем <> 0 Тогда
					Количество 		= НормаРасходаНаОбъем  / СтрокаПозицииАкта.ФактОбъем;
					НормаРасхода 	= Количество  / СтрокаПозицииАкта.ФактОбъем;
				Иначе
					НормаРасхода 	= 0;
					Количество 		= 0;
				КонецЕсли;
				КоэффРасхода = 1;
			КонецЕсли;
			
			Если (СтрокаПозицииАкта<>Неопределено) Тогда 
				// ФактОбъем может быть равен 0.
				ФактОбъем = СтрокаПозицииАкта.ФактОбъем;
			Иначе
				ФактОбъем = 0;
			КонецЕсли;
			
			Если РасчетКоличества Тогда
				ОтборПоправок = Новый Структура();
				ОтборПоправок.Вставить("Позиция", СтрокаРесурса.Позиция); 
				МассивПоправок = ТаблПоправок.НайтиСтроки(ОтборПоправок);
				
				Количество = НормаРасхода * КоэффРасхода;
				
				Для каждого СтрокаТаблПоправок Из МассивПоправок Цикл
					Если СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда	
						Количество = Количество * СтрокаТаблПоправок.КоэффициентКТрудозатратамРабочих;	
					ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда	
						Количество = Количество * СтрокаТаблПоправок.КоэффициентКТрудозатратамМашинистов;	
					ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда	
						Количество = Количество * СтрокаТаблПоправок.КоэффициентКСтоимостиМатериалов;	
					ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда	
						Количество = Количество * СтрокаТаблПоправок.КоэффициентКЭксплуатацииМашин;	
					КонецЕсли;
				КонецЦикла;
			
				Если ПрименитьЗУТрудРабочих И СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
					Количество = Количество * ?(ТипСтроительстваРемонт, СтрокаПозицииАкта.ЗимнееУдорожРемонт, СтрокаПозицииАкта.ЗимнееУдорож);
				КонецЕсли;
				
				Если ПрименитьЗУТрудМашинистов И СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда
					Количество = Количество * ?(ТипСтроительстваРемонт, СтрокаПозицииАкта.ЗимнееУдорожРемонт, СтрокаПозицииАкта.ЗимнееУдорож);
				КонецЕсли;
				
				Если ПрименитьЗУНормамМаш И СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
					Количество = Количество * ?(ТипСтроительстваРемонт, СтрокаПозицииАкта.ЗимнееУдорожРемонт, СтрокаПозицииАкта.ЗимнееУдорож);
				КонецЕсли;
				
				Если ПрименитьЗУНормамМат И СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
					Количество = Количество * ?(ТипСтроительстваРемонт, СтрокаПозицииАкта.ЗимнееУдорожМатериалРемонт, СтрокаПозицииАкта.ЗимнееУдорожМатериал);
				КонецЕсли;
			КонецЕсли;
			
			СтрокаТаблСтоимРес 			= ТаблСтоимРес.Добавить();
			СтрокаТаблСтоимРес.Ресурс 	= СтрокаРесурса.Ресурс;
			
			Попытка
				СтрокаТаблСтоимРес.КодРесурса 				= ?(ЗначениеЗаполнено(СтрокаРесурса.Ресурс),СтрокаРесурса.Ресурс.Код,СтрокаРесурса.СметныйКодРесурса);
				СтрокаТаблСтоимРес.ЕдиницаИзмеренияРесурса 	= СтрокаРесурса.Ресурс.ЕдиницаИзмерения;
			Исключение
				СтрокаТаблСтоимРес.КодРесурса = СтрокаРесурса.СметныйКодРесурса;
			КонецПопытки;
						
			СтрокаТаблСтоимРес.ВидРесурса 			= СтрокаРесурса.ВидРесурса;
			СтрокаТаблСтоимРес.НаименованиеРесурса 	= ?(БезНомераСтроки,СтрокаРесурса.НаименованиеРесурса,Строка(СтрокаРесурса.НомерСтроки)+" "+СтрокаРесурса.НаименованиеРесурса);
			СтрокаТаблСтоимРес.НомерСтрокиДокумента = ?(БезНомераСтроки,0,СтрокаРесурса.НомерСтрокиДокумента);
			СтрокаТаблСтоимРес.НормаРасхода 		= НормаРасхода;
			СтрокаТаблСтоимРес.Количество 			= Количество;
			СтрокаТаблСтоимРес.РасходПоФакту 		= СтрокаРесурса.ФактРасходаОбъем;
			СтрокаТаблСтоимРес.РасходПоНорме		= СтрокаРесурса.НормаРасходаОбъем;
			СтрокаТаблСтоимРес.ЦенаБазисная 		= БазиснаяЦена;
			СтрокаТаблСтоимРес.ЦенаЗМБазисная 		= БазиснаяЗарплатаМашинистов;
			СтрокаТаблСтоимРес.СтоимостьБазисная 	= СтрокаРесурса.ФактРасходаОбъем * БазиснаяЦена;
			СтрокаТаблСтоимРес.СтоимостьЗМБазисная 	= СтрокаРесурса.ФактРасходаОбъем * БазиснаяЗарплатаМашинистов;
			СтрокаТаблСтоимРес.ЦенаТекущая 			= СтрокаРесурса.ТекущаяЦена;
			СтрокаТаблСтоимРес.ЦенаТекущаяЗМ 		= СтрокаРесурса.ТекущаяЗарплатаМашинистов;
			СтрокаТаблСтоимРес.СтоимостьТекущая 	= СтрокаРесурса.ФактРасходаОбъем * СтрокаРесурса.ТекущаяЦена;
			СтрокаТаблСтоимРес.СтоимостьТекущаяЗМ 	= СтрокаРесурса.ФактРасходаОбъем * СтрокаРесурса.ТекущаяЗарплатаМашинистов;
			СтрокаТаблСтоимРес.ЭтоУчтенный 			= Истина;
			СтрокаТаблСтоимРес.ЭтоНеучтенный 		= Ложь;
			СтрокаТаблСтоимРес.ЭтоОборудование 		= Ложь;
			СтрокаТаблСтоимРес.Картинка 			= СМ_СметаКлиентСервер.ПолучитьКартинкуРесурса(СтрокаРесурса.ТипМатериала, СтрокаРесурса.ВидРесурса);
			СтрокаТаблСтоимРес.СтатусРесурса  		= СтрокаРесурса.СтатусРесурса;
			СтрокаТаблСтоимРес.НеИзменятьЦены  		= СтрокаРесурса.НеИзменятьЦены;
			СтрокаТаблСтоимРес.ВариантОтклонения  	= СтрокаРесурса.ВариантОтклонения;
			СтрокаТаблСтоимРес.ВариантПревышения  	= СтрокаРесурса.ВариантСписанияПревышения;
			СтрокаТаблСтоимРес.КомментарийКФайлу  	= СтрокаРесурса.КомментарийКФайлу;
						
			Если ГруппироватьПоПозициям Тогда
				СтрокаТаблСтоимРес.Позиция = СтрокаРесурса.Позиция;
				СтрокаТаблСтоимРес.ФактОбъем = ФактОбъем;
			КонецЕсли;
			
			Если ГруппироватьПоСмете Тогда
				СтрокаТаблСтоимРес.Смета = СтрокаРесурса.Позиция.ИдСметы;	
			КонецЕсли;
			
			// Сортировка (обязательно по убыванию, таким образом все ресурсы, 
			// которые не обрабатываются будут попадать вниз, т.к. значение = "0").
			Если СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
				СтрокаТаблСтоимРес.Сортировка1	= 3;	
			ИначеЕсли СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
				СтрокаТаблСтоимРес.Сортировка1	= 2;	
			ИначеЕсли СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
				СтрокаТаблСтоимРес.Сортировка1	= 1;	
			КонецЕсли;
			
			// ***********************************************************
			// ++ AVV Запрет изменения факт расхода.
			СтрокаТаблСтоимРес.ИзмененФактРасход = СтрокаРесурса.ИзмененФактРасход;
			// -- AVV 
			// ***********************************************************

			// ***********************************************************
			// ++ AVV Добавление в таблицу замененных ресурсов.
			Если ЗаменыРесурсов Тогда

				СтрокаТаблСтоимРес.ЭтоЗамена		= Ложь;
				СтрокаТаблСтоимРес.Заменен 			= Ложь;
				СтрокаТаблСтоимРес.СортировкаЗамен	= 0;
				
				// Предполагается что в таблице только незамененные ресурсы.
				// Замены ищем и добавляем в таблицу.
				СтруктураОтбора = Новый Структура;
				СтруктураОтбора.Вставить("Смета",Акт.Ссылка);
				СтруктураОтбора.Вставить("Позиция",Позиция);
				СтруктураОтбора.Вставить("НовыйРесурс",СтрокаРесурса.Ресурс);
				
				// Нашли строку замены, нужно добавить в таблицу ресурсов и все посчитать
				МассивСтрок = ТаблицаПредыдущихЗамен.НайтиСтроки(СтруктураОтбора);
				Если МассивСтрок.Количество() > 0 Тогда
					
					СтрокаСтарогоРесурса = МассивСтрок[0];
					
					НайденнаяСортировка = СписокЗамененныхРесурсов.Получить(СтрокаСтарогоРесурса.ЗамененныйРесурс); 
					Если НайденнаяСортировка = Неопределено Тогда
						СортировкаЗамен			= СортировкаЗамен + 2;
						СортировкаПодчиненных 	= СортировкаЗамен + 1;
						СписокЗамененныхРесурсов.Вставить(СтрокаСтарогоРесурса.ЗамененныйРесурс,СортировкаЗамен);
					Иначе
						СортировкаЗамен 		= НайденнаяСортировка;
						СортировкаПодчиненных 	= СортировкаЗамен + 1;
					КонецЕсли;
					
					СтрокаТаблСтоимРес2 						= ТаблСтоимРес.Добавить();
					СтрокаТаблСтоимРес2.Ресурс 					= СтрокаСтарогоРесурса.ЗамененныйРесурс;
					СтрокаТаблСтоимРес2.КодРесурса				= СтрокаСтарогоРесурса.ЗамененныйРесурс.Код;
					СтрокаТаблСтоимРес2.ВидРесурса				= СтрокаРесурса.ВидРесурса;
					СтрокаТаблСтоимРес2.НаименованиеРесурса 	= СтрокаСтарогоРесурса.ЗамененныйРесурс.Наименование;
					СтрокаТаблСтоимРес2.ЕдиницаИзмеренияРесурса	= СтрокаСтарогоРесурса.ЗамененныйРесурс.ЕдиницаИзмерения;
					СтрокаТаблСтоимРес2.НормаРасхода			= СтрокаСтарогоРесурса.НормаРасходаСтарогоМатериала;
					СтрокаТаблСтоимРес2.Количество				= Количество;
					СтрокаТаблСтоимРес2.РасходПоНорме			= Количество * ФактОбъем;
					СтрокаТаблСтоимРес2.ЦенаБазисная			= СтрокаСтарогоРесурса.БазиснаяЦенаСтарогоМатериала;
					СтрокаТаблСтоимРес2.ЦенаЗМБазисная			= СтрокаСтарогоРесурса.БазисЗарплМашСтарРесурс;
					СтрокаТаблСтоимРес2.ЦенаТекущая				= СтрокаСтарогоРесурса.ТекущаяЦенаСтарогоМатериала;
					СтрокаТаблСтоимРес2.ЦенаТекущаяЗМ			= СтрокаСтарогоРесурса.ТекЗарплМашСтарРесурс;
					СтрокаТаблСтоимРес2.ЭтоУчтенный				= Истина;
					СтрокаТаблСтоимРес2.ЭтоНеучтенный			= Ложь;
					СтрокаТаблСтоимРес2.ЭтоОборудование			= Ложь;
					СтрокаТаблСтоимРес2.Картинка 				= СМ_СметаКлиентСервер.ПолучитьКартинкуРесурса(СтрокаРесурса.ТипМатериала, СтрокаРесурса.ВидРесурса);
					СтрокаТаблСтоимРес2.СтатусРесурса  			= СтрокаРесурса.СтатусРесурса;
					СтрокаТаблСтоимРес2.НеИзменятьЦены  		= СтрокаРесурса.НеИзменятьЦены;
					СтрокаТаблСтоимРес2.ВариантОтклонения  		= СтрокаРесурса.ВариантОтклонения;
					СтрокаТаблСтоимРес2.ВариантПревышения  		= СтрокаРесурса.ВариантСписанияПревышения;
					СтрокаТаблСтоимРес2.КомментарийКФайлу  	    = СтрокаРесурса.КомментарийКФайлу;
					СтрокаТаблСтоимРес2.Заменен 				= Истина;
					СтрокаТаблСтоимРес2.ЭтоЗамена 				= Ложь;
					СтрокаТаблСтоимРес2.СортировкаЗамен 		= СортировкаЗамен;
				
					Если ГруппироватьПоПозициям Тогда
						СтрокаТаблСтоимРес2.Позиция = Позиция;
						СтрокаТаблСтоимРес2.ФактОбъем = ФактОбъем;
					КонецЕсли;
					
					Если ГруппироватьПоСмете Тогда
						СтрокаТаблСтоимРес2.Смета = Позиция.ИдСметы;	
					КонецЕсли;

					// Сортировка (обязательно по убыванию, таким образом все ресурсы, 
					// которые не обрабатываются будут попадать вниз, т.к. значение = "0").
					Если СтрокаТаблСтоимРес2.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
						СтрокаТаблСтоимРес2.Сортировка1	= 3;	
					ИначеЕсли СтрокаТаблСтоимРес2.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
						СтрокаТаблСтоимРес2.Сортировка1	= 2;	
					ИначеЕсли СтрокаТаблСтоимРес2.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
						СтрокаТаблСтоимРес2.Сортировка1	= 1;	
					КонецЕсли;
					
					// Заполнение значений в исходной строке замененные ресурса
					СтрокаТаблСтоимРес.СортировкаЗамен 	= СортировкаПодчиненных;
					СтрокаТаблСтоимРес.ЭтоЗамена 		= Истина;
					
				КонецЕсли;
			КонецЕсли;
			// -- AVV
			// **********************************************************************

		КонецЦикла;
		
		// Позиции - ресурсы
		Если Позиция.Расчет И Позиция.РесурсыПозицииЛокальнойСметы.Количество() = 0 И
			(Позиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал ИЛИ
			 Позиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование) Тогда
			
			СтрокаТаблСтоимРес 							= ТаблСтоимРес.Добавить();
			СтрокаТаблСтоимРес.КодРесурса 				= Позиция.ШифрРасценки;
			СтрокаТаблСтоимРес.НаименованиеРесурса 		= Позиция.Наименование;
			СтрокаТаблСтоимРес.ЕдиницаИзмеренияРесурса 	= Позиция.ЕдиницаИзмерения;
			СтрокаТаблСтоимРес.Ресурс 					= Справочники.СМ_Ресурсы.ПустаяСсылка();
			
			// ***********************************************************
			// ++ AVV Статусы ресурсов акта
			//СтрокаТаблСтоимРес.СтатусРесурса  		= ?(Позиция.СтатусРесурса.Пустая(),Перечисления.СМ_ОбеспечениеРесурса.Собственный,Позиция.СтатусРесурса);
			СтрокаТаблСтоимРес.СтатусРесурса			= ?(СтрокаПозицииАкта.СтатусРесурса.Пустая(), Перечисления.СМ_ОбеспечениеРесурса.Собственный,СтрокаПозицииАкта.СтатусРесурса); 
			// СтрокаТаблСтоимРес.СтатусРесурсаАкт 		= ?(Позиция.СтатусРесурсаАкт.Пустая(),Перечисления.СМ_ОбеспечениеРесурса.Собственный,Позиция.СтатусРесурсаАкт);
			// -- AVV 
			// ***********************************************************

			СтрокаТаблСтоимРес.НеИзменятьЦены  			= Позиция.НеИзменятьЦены;
			СтрокаТаблСтоимРес.НормаРасхода 			= 1;

			ЭтоМатериал = (Позиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал);
			СтрокаТаблСтоимРес.ВидРесурса = ?(ЭтоМатериал, ?(Позиция.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин, Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы, Перечисления.СМ_ВидыРесурсов.Материалы), Перечисления.СМ_ВидыРесурсов.Оборудование);
			
			ВремКоличество = СтрокаТаблСтоимРес.НормаРасхода;
			
			Для каждого СтрокаПоправки Из Позиция.ПоправкиПозиции Цикл
				Если СтрокаПоправки.КоэффСМ <> 0 И ЭтоМатериал Тогда
					ВремКоличество = ВремКоличество * СтрокаПоправки.КоэффСМ; 
				КонецЕсли;
				Если СтрокаПоправки.КоэффПЗ <> 0 Тогда
					ВремКоличество = ВремКоличество * СтрокаПоправки.КоэффПЗ; 
				КонецЕсли;
			КонецЦикла;	
			
			Если ПрименитьЗУТрудРабочих И СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
				ВремКоличество = ВремКоличество * ?(ТипСтроительстваРемонт, Позиция.ЗимнееУдорожРемонт, Позиция.ЗимнееУдорож);
			КонецЕсли;
			
			Если ПрименитьЗУТрудМашинистов И СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда
				ВремКоличество = ВремКоличество * ?(ТипСтроительстваРемонт, Позиция.ЗимнееУдорожРемонт, Позиция.ЗимнееУдорож);
			КонецЕсли;
			
			Если ПрименитьЗУНормамМаш И СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
				ВремКоличество = ВремКоличество * ?(ТипСтроительстваРемонт, Позиция.ЗимнееУдорожРемонт, Позиция.ЗимнееУдорож);
			КонецЕсли;
			
			Если ПрименитьЗУНормамМат И СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
				ВремКоличество = ВремКоличество * ?(ТипСтроительстваРемонт, Позиция.ЗимнееУдорожМатериалРемонт, Позиция.ЗимнееУдорожМатериал);
			КонецЕсли;

			СтрокаТаблСтоимРес.Количество 		= ВремКоличество;
			СтрокаТаблСтоимРес.РасходПоНорме 	= СтрокаПозицииАкта.НормРасход; //ВремКоличество * СтрокаПозицииАкта.ФактОбъем;
			СтрокаТаблСтоимРес.РасходПоФакту 	= ВремКоличество * СтрокаПозицииАкта.ФактОбъем;
	
			Если ЭтоМатериал Тогда
				СтрокаТаблСтоимРес.ЦенаБазисная 		= Позиция.СтоимМатериалов;
				СтрокаТаблСтоимРес.ЦенаЗМБазисная 		= 0; 
				СтрокаТаблСтоимРес.СтоимостьБазисная 	= СтрокаПозицииАкта.ФактОбъем * Позиция.ПрямЗатраты;
				СтрокаТаблСтоимРес.СтоимостьЗМБазисная 	= 0;
			Иначе
				СтрокаТаблСтоимРес.ЦенаБазисная 		= Позиция.Оборудование;
				СтрокаТаблСтоимРес.ЦенаЗМБазисная 		= 0; 
				СтрокаТаблСтоимРес.СтоимостьБазисная 	= СтрокаПозицииАкта.ФактОбъем * Позиция.Оборудование;
				СтрокаТаблСтоимРес.СтоимостьЗМБазисная 	= 0;
			КонецЕсли;
			
			СтрокаТаблСтоимРес.ЦенаТекущая 			= СтрокаПозицииАкта.ТекущаяЦена;
			СтрокаТаблСтоимРес.ЦенаТекущаяЗМ 		= СтрокаПозицииАкта.ТекущаяЗарплатаМашинистов;

			СтрокаТаблСтоимРес.СтоимостьТекущая 	= СтрокаПозицииАкта.ФактОбъем * СтрокаПозицииАкта.ТекущаяЦена;
			СтрокаТаблСтоимРес.СтоимостьТекущаяЗМ 	= СтрокаПозицииАкта.ФактОбъем * СтрокаПозицииАкта.ТекущаяЗарплатаМашинистов;

			СтрокаТаблСтоимРес.ЭтоУчтенный 		= Ложь;
			СтрокаТаблСтоимРес.ЭтоНеучтенный 	= (Позиция.Определитель.ВидРасценки <> Перечисления.СМ_ВидыРасценки.Оборудование);
			СтрокаТаблСтоимРес.ЭтоОборудование 	= (Позиция.Определитель.ВидРасценки =  Перечисления.СМ_ВидыРасценки.Оборудование);
			
			// Тут только неучтенные и оборудование.
			СтрокаТаблСтоимРес.Картинка = СМ_СметаКлиентСервер.ПолучитьКартинкуРесурса(?(СтрокаТаблСтоимРес.ЭтоНеучтенный, Перечисления.СМ_ТипыМатериалов.НеУчтенный, Перечисления.СМ_ТипыМатериалов.Учтенный), СтрокаТаблСтоимРес.ВидРесурса);
			
			Если ГруппироватьПоПозициям Тогда
				СтрокаТаблСтоимРес.Позиция 		= Позиция;
				СтрокаТаблСтоимРес.ФактОбъем 	= СтрокаПозицииАкта.ФактОбъем;
			КонецЕсли;
			
			Если ГруппироватьПоСмете Тогда
				СтрокаТаблСтоимРес.Смета = Позиция.ИдСметы;	
			КонецЕсли;
			
			// Сортировка (обязательно по убыванию, таким образом все ресурсы, 
			// которые не обрабатываются будут попадать вниз, т.к. значение = "0").
			Если СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
				СтрокаТаблСтоимРес.Сортировка1	= 3;	
			ИначеЕсли СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
				СтрокаТаблСтоимРес.Сортировка1	= 2;	
			ИначеЕсли СтрокаТаблСтоимРес.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
				СтрокаТаблСтоимРес.Сортировка1	= 1;	
			КонецЕсли;
			
			СтрокаТаблСтоимРес.НомерСтрокиДокумента = ?(БезНомераСтроки,0,СтрокаПозицииАкта.НомерСтроки);
			
			// ***********************************************************
			// ++ AVV
			
			// 2. В сводной таблице ресурсов акта колонка "Расход по норме (НормаРасхода)":
			// Позиция.НормаРасходаРесурса * Позиция.КоличествоРесурса * ФактРасход (т.ч. позиции) / Позиция.ОбъемРабот
	        // СтрокаТаблСтоимРес.РасходПоНорме = Позиция.НормаРасходаРесурса * Позиция.КоличествоРесурса * СтрокаТаблСтоимРес.РасходПоФакту / Позиция.ОбъемРабот; 
			// СтрокаТаблСтоимРес.РасходПоНорме = Позиция.НормаРасходаРесурса * Позиция.КоличествоРесурса * СтрокаПозицииАкта.ФактРасход / Позиция.ОбъемРабот; 
			
			// Если Позиция.ОбъемРабот = 0 Тогда
			//	 СтрокаТаблСтоимРес.РасходПоНорме = 0; 
			// Иначе
			//	 СтрокаТаблСтоимРес.РасходПоНорме = Позиция.НормаРасходаРесурса * Позиция.КоличествоРесурса * СтрокаПозицииАкта.ФактОбъем / Позиция.ОбъемРабот; 
			// КонецЕсли;
			
			//-- AVV
			// ***********************************************************
			
		КонецЕсли;	
	КонецЦикла;
	
	Если СвернутьТаблицу Тогда
		
		// ТаблСтоимРес.Свернуть("Ресурс, КодРесурса, ВидРесурса, НаименованиеРесурса, ЕдиницаИзмеренияРесурса, ЭтоУчтенный, ЭтоНеучтенный, ЭтоОборудование, ЦенаБазисная, ЦенаЗМБазисная, ЦенаТекущая, ЦенаТекущаяЗМ, Картинка,НеИзменятьЦены"+?(ГруппироватьПоПозициям, ", Позиция, ФактОбъем", "")+?(ГруппироватьПоСмете, ", Смета", "")+?(ГруппироватьСтатусы, ", СтатусРесурса,СтатусРесурсаАкт ", "")+?(ДетализацияОтклонения, ", ВариантОтклонения, ВариантПревышения, КомментарийКФайлу", "")+",Заменен,ЭтоЗамена,СортировкаЗамен", "Количество, РасходПоНорме, РасходПоФакту, СтоимостьБазисная, СтоимостьЗМБазисная, СтоимостьТекущая, СтоимостьТекущаяЗМ");   
		// ТаблСтоимРес.Свернуть("Ресурс, КодРесурса, ВидРесурса, НаименованиеРесурса, ЕдиницаИзмеренияРесурса, ЭтоУчтенный, ЭтоНеучтенный, ЭтоОборудование, ЦенаБазисная, ЦенаЗМБазисная, ЦенаТекущая, ЦенаТекущаяЗМ, Картинка,НеИзменятьЦены"+?(ГруппироватьПоПозициям, ", Позиция, ФактОбъем", "")+?(ГруппироватьПоСмете, ", Смета", "")+?(ГруппироватьСтатусы, ",СтатусРесурса","")+?(ДетализацияОтклонения, ", ВариантОтклонения, ВариантПревышения, КомментарийКФайлу", "")+",Заменен,ЭтоЗамена,СортировкаЗамен", "Количество, РасходПоНорме, РасходПоФакту, СтоимостьБазисная, СтоимостьЗМБазисная, СтоимостьТекущая, СтоимостьТекущаяЗМ");  
		
		// ***********************************************************
		// ++ AVV Запрет изменения факт расхода
		ТаблСтоимРес.Свернуть("Ресурс, КодРесурса, ВидРесурса, НаименованиеРесурса, ЕдиницаИзмеренияРесурса, ЭтоУчтенный, ЭтоНеучтенный, ЭтоОборудование, ЦенаБазисная, ЦенаЗМБазисная, ЦенаТекущая, ЦенаТекущаяЗМ, Картинка,НеИзменятьЦены"+?(ГруппироватьПоПозициям, ", Позиция, ФактОбъем", "")+?(ГруппироватьПоСмете, ", Смета", "")+?(ГруппироватьСтатусы, ",СтатусРесурса","")+?(ДетализацияОтклонения, ", ВариантОтклонения, ВариантПревышения, КомментарийКФайлу", "")+",Заменен,ЭтоЗамена,СортировкаЗамен,ИзмененФактРасход", "Количество, РасходПоНорме, РасходПоФакту, СтоимостьБазисная, СтоимостьЗМБазисная, СтоимостьТекущая, СтоимостьТекущаяЗМ"); 
		// -- AVV 
		// ***********************************************************
		
		Если Не УчитыватьЦеныПриГруппировке Тогда
			ТаблСтоимРес = ТаблицаБезГруппировкиПоЦенам(ТаблСтоимРес,ГруппироватьСтатусы,ДетализацияОтклонения);
		КонецЕсли;
		
		// ***********************************************************
		// ++ AVV
		// ТаблСтоимРес.Сортировать("ЭтоНеучтенный, ЭтоОборудование, ВидРесурса, КодРесурса");
		ТаблСтоимРес.Сортировать("ЭтоНеучтенный, ЭтоОборудование, ВидРесурса, СортировкаЗамен, КодРесурса, ЭтоЗамена");
		// -- AVV
		// ***********************************************************
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТаблСтоимРес;
	
КонецФункции

// Возвращает таблицу со сведениями о начислениях Сметы (сводную или нет).
//
// Параметры:
//     СписокПозиций 	- СписокЗначений - содержит позиции или таблицу с колонкой Позиция.
//     СвернутьТаблицу 	- Булево - сводная таблица или нет.
//
// Возвращаемое значение:
//     ТабРезультат - ТаблицаЗначений - содержит числовые параметры сметы, согласно переданным параметрам.
//
Функция ПолучитьТаблицуНачисленийСметы(СписокПозиций, СвернутьТаблицу = Ложь) Экспорт
	
	Таблица = (ТипЗнч(СписокПозиций) <> Тип("СписокЗначений"));
	
	Запрос = Новый Запрос;
	Если Не СвернутьТаблицу Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр,
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.Значение,
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.Формула,
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр.СтандартноеЗначение,
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр.ТипЗначения,
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр.ПорядокРасчета,
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.Значение КАК ЗначениеПроверка,
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.Ссылка КАК Позиция
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы.НачисленияПозиции КАК СМ_ПозицияЛокальнойСметыНачисленияПозиции
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.Ссылка В(&Ссылка)";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр,
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.Формула КАК Формула,
		               |	СРЕДНЕЕ(1) КАК Количество
		               |ПОМЕСТИТЬ Формулы
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы.НачисленияПозиции КАК СМ_ПозицияЛокальнойСметыНачисленияПозиции
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.Ссылка В(&Ссылка)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр,
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.Формула
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	СМ_Формулы.ЧисловойПараметр,
		               |	СУММА(СМ_Формулы.Количество) КАК ЕстьОтклонение
		               |ПОМЕСТИТЬ ФормулыЕстьОтклонения
		               |ИЗ
		               |	Формулы КАК СМ_Формулы
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	СМ_Формулы.ЧисловойПараметр
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыНачисленияПозиции.Значение) КАК Значение
		               |ПОМЕСТИТЬ СредниеПоСмете
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы.НачисленияПозиции КАК СМ_ПозицияЛокальнойСметыНачисленияПозиции
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.Ссылка В(&Ссылка)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыНачисленияПозиции.Значение) КАК Значение,
		               |	ВЫБОР
		               |		КОГДА ФормулыЕстьОтклонения.ЕстьОтклонение > 1
		               |			ТОГДА """"
		               |		ИНАЧЕ СМ_ПозицияЛокальнойСметыНачисленияПозиции.Формула
		               |	КОНЕЦ КАК Формула,
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр.ТипЗначения,
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр.СтандартноеЗначение,
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр.ПорядокРасчета,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыНачисленияПозиции.Значение <> СредниеПоСмете.Значение
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК ЕстьОтклонение,
		               |	СУММА(ФормулыЕстьОтклонения.ЕстьОтклонение - 1) КАК ФормулаЕстьОтклонение
		               |ПОМЕСТИТЬ ЧисловыеПараметрыСметы
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы.НачисленияПозиции КАК СМ_ПозицияЛокальнойСметыНачисленияПозиции
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СредниеПоСмете КАК СредниеПоСмете
		               |		ПО СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр = СредниеПоСмете.ЧисловойПараметр
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ФормулыЕстьОтклонения КАК ФормулыЕстьОтклонения
		               |		ПО СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр = ФормулыЕстьОтклонения.ЧисловойПараметр
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.Ссылка В(&Ссылка)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр,
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр.ТипЗначения,
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр.СтандартноеЗначение,
		               |	СМ_ПозицияЛокальнойСметыНачисленияПозиции.ЧисловойПараметр.ПорядокРасчета,
		               |	ВЫБОР
		               |		КОГДА ФормулыЕстьОтклонения.ЕстьОтклонение > 1
		               |			ТОГДА """"
		               |		ИНАЧЕ СМ_ПозицияЛокальнойСметыНачисленияПозиции.Формула
		               |	КОНЕЦ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ЧисловыеПараметрыСметы.ЧисловойПараметр,
		               |	ВЫБОР
		               |		КОГДА ЧисловыеПараметрыСметы.ЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ЧисловыеПараметрыСметы.Значение
		               |	КОНЕЦ КАК Значение,
		               |	ЧисловыеПараметрыСметы.ЧисловойПараметрТипЗначения,
		               |	ЧисловыеПараметрыСметы.ЧисловойПараметрСтандартноеЗначение,
		               |	ЧисловыеПараметрыСметы.ЧисловойПараметрПорядокРасчета КАК ЧисловойПараметрПорядокРасчета,
		               |	ЧисловыеПараметрыСметы.ЕстьОтклонение КАК ЗначениеЕстьОтклонение,
		               |	ЧисловыеПараметрыСметы.ФормулаЕстьОтклонение,
		               |	ЧисловыеПараметрыСметы.Формула
		               |ИЗ
		               |	ЧисловыеПараметрыСметы КАК ЧисловыеПараметрыСметы
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ЧисловойПараметрПорядокРасчета";	
	КонецЕсли;					   
	
	СписокПозицийОтбор = Новый СписокЗначений();
	Если Таблица Тогда
		СписокПозицийОтбор.ЗагрузитьЗначения(Таблица.Выгрузить().ВыгрузитьКолонку("Позиция"));	
	Иначе
		СписокПозицийОтбор = СписокПозиций;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", СписокПозицийОтбор);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает таблицу со сведениями о поправках Сметы (сводную или нет).
//
// Параметры:
//     СписокПозиций 	- СписокЗначений - содержит позиции или таблицу с колонкой Позиция.
//     СвернутьТаблицу 	- Булево - сводная таблица или нет.
//
// Возвращаемое значение:
//     ТабРезультат - ТаблицаЗначений - содержит поправки сметы, согласно переданным параметрам.
//
Функция ПолучитьТаблицуПоправокСметы(СписокПозиций, СвернутьТаблицу = Ложь) Экспорт
	
	Таблица = (ТипЗнч(СписокПозиций) <> Тип("СписокЗначений"));
	
	Запрос = Новый Запрос;
	
	Если Не СвернутьТаблицу Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.Применить,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.УсловияПрименения,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.Обоснование,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффПЗ,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффОЗ,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффЭМ,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффЗМ,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.ВариантРасчета,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффСМ,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффТР,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффТМ,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавПЗ,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавОЗ,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавЭМ,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавЗМ,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавСМ,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавТР,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.Справка,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавТ,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.Ссылка КАК Позиция
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы.ПоправкиПозиции КАК СМ_ПозицияЛокальнойСметыПоправкиПозиции
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.Ссылка В(&Ссылка)";
	Иначе                  
					   
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.УсловияПрименения КАК СТРОКА(200)) КАК УсловияПрименения,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.Обоснование,
		               |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.Справка КАК СТРОКА(200)) КАК Справка,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.ВариантРасчета,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффПЗ) КАК КоэффПЗ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффОЗ) КАК КоэффОЗ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффЭМ) КАК КоэффЭМ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффЗМ) КАК КоэффЗМ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффСМ) КАК КоэффСМ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффТР) КАК КоэффТР,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффТМ) КАК КоэффТМ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавПЗ) КАК ДобавПЗ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавОЗ) КАК ДобавОЗ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавЭМ) КАК ДобавЭМ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавЗМ) КАК ДобавЗМ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавСМ) КАК ДобавСМ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавТР) КАК ДобавТР,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавТ) КАК ДобавТ,
		               |	СРЕДНЕЕ(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.Применить
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК Применить
		               |ПОМЕСТИТЬ СредниеПоСмете
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы.ПоправкиПозиции КАК СМ_ПозицияЛокальнойСметыПоправкиПозиции
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.Ссылка В(&Ссылка)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.УсловияПрименения КАК СТРОКА(200)),
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.Обоснование,
		               |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.Справка КАК СТРОКА(200)),
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.ВариантРасчета
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.УсловияПрименения КАК СТРОКА(200)) КАК УсловияПрименения,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.Обоснование,
		               |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.Справка КАК СТРОКА(200)) КАК Справка,
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.ВариантРасчета,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффПЗ) КАК КоэффПЗ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффОЗ) КАК КоэффОЗ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффЭМ) КАК КоэффЭМ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффЗМ) КАК КоэффЗМ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффСМ) КАК КоэффСМ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффТР) КАК КоэффТР,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффТМ) КАК КоэффТМ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавПЗ) КАК ДобавПЗ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавОЗ) КАК ДобавОЗ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавЭМ) КАК ДобавЭМ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавЗМ) КАК ДобавЗМ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавСМ) КАК ДобавСМ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавТР) КАК ДобавТР,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавТ) КАК ДобавТ,
		               |	СРЕДНЕЕ(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.Применить
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК Применить,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффПЗ <> СредниеПоСмете.КоэффПЗ
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффПЗЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффОЗ <> СредниеПоСмете.КоэффОЗ
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффОЗЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффЭМ <> СредниеПоСмете.КоэффЭМ
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффЭМЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффЗМ <> СредниеПоСмете.КоэффЗМ
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффЗМЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффСМ <> СредниеПоСмете.КоэффСМ
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффСМЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффТР <> СредниеПоСмете.КоэффТР
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффТРЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.КоэффТМ <> СредниеПоСмете.КоэффТМ
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффТМЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавПЗ <> СредниеПоСмете.ДобавПЗ
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК ДобавПЗЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавОЗ <> СредниеПоСмете.ДобавОЗ
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК ДобавОЗЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавЭМ <> СредниеПоСмете.ДобавЭМ
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК ДобавЭМЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавЗМ <> СредниеПоСмете.ДобавЗМ
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК ДобавЗМЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавСМ <> СредниеПоСмете.ДобавСМ
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК ДобавСМЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавТР <> СредниеПоСмете.ДобавТР
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК ДобавТРЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.ДобавТ <> СредниеПоСмете.ДобавТ
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК ДобавТЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыПоправкиПозиции.Применить
		               |				ТОГДА 1 - СредниеПоСмете.Применить
		               |			ИНАЧЕ СредниеПоСмете.Применить
		               |		КОНЕЦ) КАК ПрименитьЕстьОтклонение
		               |ПОМЕСТИТЬ ПоправкиСметы
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы.ПоправкиПозиции КАК СМ_ПозицияЛокальнойСметыПоправкиПозиции
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СредниеПоСмете КАК СредниеПоСмете
		               |		ПО ((ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.УсловияПрименения КАК СТРОКА(200))) = СредниеПоСмете.УсловияПрименения)
		               |			И ((ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.Справка КАК СТРОКА(200))) = СредниеПоСмете.Справка)
		               |			И СМ_ПозицияЛокальнойСметыПоправкиПозиции.Обоснование = СредниеПоСмете.Обоснование
		               |			И СМ_ПозицияЛокальнойСметыПоправкиПозиции.ВариантРасчета = СредниеПоСмете.ВариантРасчета
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.Ссылка В(&Ссылка)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.УсловияПрименения КАК СТРОКА(200)),
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.Обоснование,
		               |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыПоправкиПозиции.Справка КАК СТРОКА(200)),
		               |	СМ_ПозицияЛокальнойСметыПоправкиПозиции.ВариантРасчета
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ПоправкиСметы.УсловияПрименения,
		               |	ПоправкиСметы.Обоснование,
		               |	ПоправкиСметы.Справка,
		               |	ПоправкиСметы.ВариантРасчета,
		               |	ВЫБОР
		               |		КОГДА ПоправкиСметы.ПрименитьЕстьОтклонение > 0
		               |			ТОГДА ЛОЖЬ
		               |		ИНАЧЕ ВЫБОР
		               |				КОГДА ПоправкиСметы.Применить = 1
		               |					ТОГДА ИСТИНА
		               |				ИНАЧЕ ЛОЖЬ
		               |			КОНЕЦ
		               |	КОНЕЦ КАК Применить,
		               |	ПоправкиСметы.ПрименитьЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ПоправкиСметы.КоэффПЗЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ПоправкиСметы.КоэффПЗ
		               |	КОНЕЦ КАК КоэффПЗ,
		               |	ПоправкиСметы.КоэффПЗЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ПоправкиСметы.КоэффОЗЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ПоправкиСметы.КоэффОЗ
		               |	КОНЕЦ КАК КоэффОЗ,
		               |	ПоправкиСметы.КоэффОЗЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ПоправкиСметы.КоэффЭМЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ПоправкиСметы.КоэффЭМ
		               |	КОНЕЦ КАК КоэффЭМ,
		               |	ПоправкиСметы.КоэффЭМЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ПоправкиСметы.КоэффЗМЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ПоправкиСметы.КоэффЗМ
		               |	КОНЕЦ КАК КоэффЗМ,
		               |	ПоправкиСметы.КоэффЗМЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ПоправкиСметы.КоэффСМЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ПоправкиСметы.КоэффСМ
		               |	КОНЕЦ КАК КоэффСМ,
		               |	ПоправкиСметы.КоэффСМЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ПоправкиСметы.КоэффТРЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ПоправкиСметы.КоэффТР
		               |	КОНЕЦ КАК КоэффТР,
		               |	ПоправкиСметы.КоэффТРЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ПоправкиСметы.КоэффТМЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ПоправкиСметы.КоэффТМ
		               |	КОНЕЦ КАК КоэффТМ,
		               |	ПоправкиСметы.КоэффТМЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ПоправкиСметы.ДобавПЗЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ПоправкиСметы.ДобавПЗ
		               |	КОНЕЦ КАК ДобавПЗ,
		               |	ПоправкиСметы.ДобавПЗЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ПоправкиСметы.ДобавОЗЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ПоправкиСметы.ДобавОЗ
		               |	КОНЕЦ КАК ДобавОЗ,
		               |	ПоправкиСметы.ДобавОЗЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ПоправкиСметы.ДобавЭМЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ПоправкиСметы.ДобавЭМ
		               |	КОНЕЦ КАК ДобавЭМ,
		               |	ПоправкиСметы.ДобавЭМЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ПоправкиСметы.ДобавЗМЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ПоправкиСметы.ДобавЗМ
		               |	КОНЕЦ КАК ДобавЗМ,
		               |	ПоправкиСметы.ДобавЗМЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ПоправкиСметы.ДобавСМЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ПоправкиСметы.ДобавСМ
		               |	КОНЕЦ КАК ДобавСМ,
		               |	ПоправкиСметы.ДобавСМЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ПоправкиСметы.ДобавТРЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ПоправкиСметы.ДобавТР
		               |	КОНЕЦ КАК ДобавТР,
		               |	ПоправкиСметы.ДобавТРЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ПоправкиСметы.ДобавТЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ПоправкиСметы.ДобавТ
		               |	КОНЕЦ КАК ДобавТМ,
		               |	ПоправкиСметы.ДобавТЕстьОтклонение КАК ДобавТМЕстьОтклонение
		               |ИЗ
		               |	ПоправкиСметы КАК ПоправкиСметы";	
    КонецЕсли;
   
    СписокПозицийОтбор = Новый СписокЗначений();
	Если Таблица Тогда
		СписокПозицийОтбор.ЗагрузитьЗначения(Таблица.Выгрузить().ВыгрузитьКолонку("Позиция"));	
	Иначе
		СписокПозицийОтбор = СписокПозиций;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", СписокПозицийОтбор);
	
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабРезультат;
		
КонецФункции

// Возвращает таблицу со сведениями об индексах Сметы (сводную или нет).
//
// Параметры:
//     СписокПозиций 	- СписокЗначений - содержит позиции или таблицу с колонкой Позиция.
//     СвернутьТаблицу 	- Булево - сводная таблица или нет.
//
// Возвращаемое значение:
//     ТабРезультат - ТаблицаЗначений - содержит индексы сметы, согласно переданным параметрам.
//
Функция ПолучитьТаблицуИндексовСметы(СписокПозиций, СвернутьТаблицу = Ложь) Экспорт
	
	Таблица = (ТипЗнч(СписокПозиций) <> Тип("СписокЗначений"));
	
	Запрос = Новый Запрос;
	Если Не СвернутьТаблицу Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВидРабот,
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффОснЗарплаты,
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимЭксплМашин,
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВариантПересчетаЭММ,
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимЗарплатеМашин,
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимМатериалов,
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффОборуд,
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффПолнСтоимРабот,
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.Ссылка КАК Позиция
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы.КоэффициентыПересчета КАК СМ_ПозицияЛокальнойСметыКоэффициентыПересчета
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.Ссылка В(&Ссылка)";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВидРабот КАК СТРОКА(200)) КАК ВидРабот,
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВариантПересчетаЭММ КАК ВариантПересчетаЭММ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффОснЗарплаты) КАК КоэффОснЗарплаты,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимЭксплМашин) КАК КоэффСтоимЭксплМашин,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимЗарплатеМашин) КАК КоэффСтоимЗарплатеМашин,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимМатериалов) КАК КоэффСтоимМатериалов,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффОборуд) КАК КоэффОборуд,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффПолнСтоимРабот) КАК КоэффПолнСтоимРабот
		               |ПОМЕСТИТЬ СредниеПоСмете
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы.КоэффициентыПересчета КАК СМ_ПозицияЛокальнойСметыКоэффициентыПересчета
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.Ссылка В(&Ссылка)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВидРабот КАК СТРОКА(200)),
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВариантПересчетаЭММ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВидРабот КАК СТРОКА(200)) КАК ВидРабот,
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВариантПересчетаЭММ КАК ВариантПересчетаЭММ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффОснЗарплаты) КАК КоэффОснЗарплаты,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимЭксплМашин) КАК КоэффСтоимЭксплМашин,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимЗарплатеМашин) КАК КоэффСтоимЗарплатеМашин,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимМатериалов) КАК КоэффСтоимМатериалов,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффОборуд) КАК КоэффОборуд,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффПолнСтоимРабот) КАК КоэффПолнСтоимРабот,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффОснЗарплаты <> СредниеПоСмете.КоэффОснЗарплаты
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффОснЗарплатыЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимЭксплМашин <> СредниеПоСмете.КоэффСтоимЭксплМашин
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффСтоимЭксплМашинЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимЗарплатеМашин <> СредниеПоСмете.КоэффСтоимЗарплатеМашин
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффСтоимЗарплатеМашинЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимМатериалов <> СредниеПоСмете.КоэффСтоимМатериалов
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффСтоимМатериаловЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффОборуд <> СредниеПоСмете.КоэффОборуд
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффОборудЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффПолнСтоимРабот <> СредниеПоСмете.КоэффПолнСтоимРабот
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффПолнСтоимРаботЕстьОтклонение
		               |ПОМЕСТИТЬ ИндексыСметы
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы.КоэффициентыПересчета КАК СМ_ПозицияЛокальнойСметыКоэффициентыПересчета
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СредниеПоСмете КАК СредниеПоСмете
		               |		ПО ((ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВидРабот КАК СТРОКА(200))) = СредниеПоСмете.ВидРабот)
		               |			И СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВариантПересчетаЭММ = СредниеПоСмете.ВариантПересчетаЭММ
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.Ссылка В(&Ссылка)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВидРабот КАК СТРОКА(200)),
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВариантПересчетаЭММ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ИндексыСметы.ВидРабот,
		               |	ИндексыСметы.ВариантПересчетаЭММ,
		               |	ВЫБОР
		               |		КОГДА ИндексыСметы.КоэффОснЗарплатыЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ИндексыСметы.КоэффОснЗарплаты
		               |	КОНЕЦ КАК КоэффОснЗарплаты,
		               |	ИндексыСметы.КоэффОснЗарплатыЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ИндексыСметы.КоэффСтоимЭксплМашинЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ИндексыСметы.КоэффСтоимЭксплМашин
		               |	КОНЕЦ КАК КоэффСтоимЭксплМашин,
		               |	ИндексыСметы.КоэффСтоимЭксплМашинЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ИндексыСметы.КоэффСтоимЗарплатеМашинЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ИндексыСметы.КоэффСтоимЗарплатеМашин
		               |	КОНЕЦ КАК КоэффСтоимЗарплатеМашин,
		               |	ИндексыСметы.КоэффСтоимЗарплатеМашинЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ИндексыСметы.КоэффСтоимМатериаловЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ИндексыСметы.КоэффСтоимМатериалов
		               |	КОНЕЦ КАК КоэффСтоимМатериалов,
		               |	ИндексыСметы.КоэффСтоимМатериаловЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ИндексыСметы.КоэффОборудЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ИндексыСметы.КоэффОборуд
		               |	КОНЕЦ КАК КоэффОборуд,
		               |	ИндексыСметы.КоэффОборудЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ИндексыСметы.КоэффПолнСтоимРаботЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ИндексыСметы.КоэффПолнСтоимРабот
		               |	КОНЕЦ КАК КоэффПолнСтоимРабот,
		               |	ИндексыСметы.КоэффПолнСтоимРаботЕстьОтклонение
		               |ИЗ
		               |	ИндексыСметы КАК ИндексыСметы";	
	КонецЕсли;		
		
	СписокПозицийОтбор = Новый СписокЗначений();
	Если Таблица Тогда
		СписокПозицийОтбор.ЗагрузитьЗначения(Таблица.Выгрузить().ВыгрузитьКолонку("Позиция"));	
	Иначе
		СписокПозицийОтбор = СписокПозиций;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", СписокПозицийОтбор);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает таблицу со сведениями об индексах Акта (сводную или нет).
//
// Параметры:
//     Акт 					- ДокументСсылка.СМ_АктВыполненныхРабот - акт для которого формируется список ресурсов.
//     СвернутьТаблицу 		- Булево - сводная таблицв или нет.
//     ОтборПозицийСписок 	- СписокЗначений - список позиций для дополнительного отбора по позициям.
//
// Возвращаемое значение:
//     ТабРезультат - ТаблицаЗначений - содержит индексы акта, согласно переданным параметрам.
//
Функция ПолучитьТаблицуИндексовАкта(Акт, СвернутьТаблицу = Ложь, ОтборПозицийСписок = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	
	Если Не СвернутьТаблицу Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВЫРАЗИТЬ(СМ_АктВыполненныхРаботПозиции.ВидРабот КАК СТРОКА(200)) КАК ВидРабот,
		               |	СМ_АктВыполненныхРаботПозиции.ВариантПересчетаЭММ,
		               |	СРЕДНЕЕ(СМ_АктВыполненныхРаботПозиции.КоэффОснЗарплаты) КАК КоэффОснЗарплаты,
		               |	СРЕДНЕЕ(СМ_АктВыполненныхРаботПозиции.КоэффСтоимЭксплМашин) КАК КоэффСтоимЭксплМашин,
		               |	СРЕДНЕЕ(СМ_АктВыполненныхРаботПозиции.КоэффСтоимЗарплатеМашин) КАК КоэффСтоимЗарплатеМашин,
		               |	СРЕДНЕЕ(СМ_АктВыполненныхРаботПозиции.КоэффСтоимМатериалов) КАК КоэффСтоимМатериалов,
		               |	СРЕДНЕЕ(СМ_АктВыполненныхРаботПозиции.КоэффОборуд) КАК КоэффОборуд,
		               |	СРЕДНЕЕ(СМ_АктВыполненныхРаботПозиции.КоэффПолнСтоимРабот) КАК КоэффПолнСтоимРабот,
		               |	СМ_АктВыполненныхРаботПозиции.Позиция
		               |ИЗ
		               |	Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_АктВыполненныхРаботПозиции
		               |ГДЕ
		               |	СМ_АктВыполненныхРаботПозиции.Позиция В(&СписокПозиций)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВЫРАЗИТЬ(СМ_АктВыполненныхРаботПозиции.ВидРабот КАК СТРОКА(200)),
		               |	СМ_АктВыполненныхРаботПозиции.ВариантПересчетаЭММ,
		               |	СМ_АктВыполненныхРаботПозиции.Позиция";
				   
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВидРабот КАК СТРОКА(200)) КАК ВидРабот,
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВариантПересчетаЭММ КАК ВариантПересчетаЭММ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффОснЗарплаты) КАК КоэффОснЗарплаты,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимЭксплМашин) КАК КоэффСтоимЭксплМашин,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимЗарплатеМашин) КАК КоэффСтоимЗарплатеМашин,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимМатериалов) КАК КоэффСтоимМатериалов,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффОборуд) КАК КоэффОборуд,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффПолнСтоимРабот) КАК КоэффПолнСтоимРабот
		               |ПОМЕСТИТЬ СредниеПоСмете
		               |ИЗ
		               |	Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_ПозицияЛокальнойСметыКоэффициентыПересчета
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.Позиция В(&СписокПозиций)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВидРабот КАК СТРОКА(200)),
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВариантПересчетаЭММ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВидРабот КАК СТРОКА(200)) КАК ВидРабот,
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВариантПересчетаЭММ КАК ВариантПересчетаЭММ,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффОснЗарплаты) КАК КоэффОснЗарплаты,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимЭксплМашин) КАК КоэффСтоимЭксплМашин,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимЗарплатеМашин) КАК КоэффСтоимЗарплатеМашин,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимМатериалов) КАК КоэффСтоимМатериалов,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффОборуд) КАК КоэффОборуд,
		               |	СРЕДНЕЕ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффПолнСтоимРабот) КАК КоэффПолнСтоимРабот,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффОснЗарплаты <> СредниеПоСмете.КоэффОснЗарплаты
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффОснЗарплатыЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимЭксплМашин <> СредниеПоСмете.КоэффСтоимЭксплМашин
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффСтоимЭксплМашинЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимЗарплатеМашин <> СредниеПоСмете.КоэффСтоимЗарплатеМашин
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффСтоимЗарплатеМашинЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимМатериалов <> СредниеПоСмете.КоэффСтоимМатериалов
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффСтоимМатериаловЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффОборуд <> СредниеПоСмете.КоэффОборуд
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффОборудЕстьОтклонение,
		               |	СУММА(ВЫБОР
		               |			КОГДА СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффПолнСтоимРабот <> СредниеПоСмете.КоэффПолнСтоимРабот
		               |				ТОГДА 1
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК КоэффПолнСтоимРаботЕстьОтклонение
		               |ПОМЕСТИТЬ ИндексыСметы
		               |ИЗ
		               |	Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_ПозицияЛокальнойСметыКоэффициентыПересчета
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СредниеПоСмете КАК СредниеПоСмете
		               |		ПО ((ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВидРабот КАК СТРОКА(200))) = СредниеПоСмете.ВидРабот)
		               |			И СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВариантПересчетаЭММ = СредниеПоСмете.ВариантПересчетаЭММ
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.Позиция В(&СписокПозиций)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВидРабот КАК СТРОКА(200)),
		               |	СМ_ПозицияЛокальнойСметыКоэффициентыПересчета.ВариантПересчетаЭММ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ИндексыСметы.ВидРабот,
		               |	ИндексыСметы.ВариантПересчетаЭММ,
		               |	ВЫБОР
		               |		КОГДА ИндексыСметы.КоэффОснЗарплатыЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ИндексыСметы.КоэффОснЗарплаты
		               |	КОНЕЦ КАК КоэффОснЗарплаты,
		               |	ИндексыСметы.КоэффОснЗарплатыЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ИндексыСметы.КоэффСтоимЭксплМашинЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ИндексыСметы.КоэффСтоимЭксплМашин
		               |	КОНЕЦ КАК КоэффСтоимЭксплМашин,
		               |	ИндексыСметы.КоэффСтоимЭксплМашинЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ИндексыСметы.КоэффСтоимЗарплатеМашинЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ИндексыСметы.КоэффСтоимЗарплатеМашин
		               |	КОНЕЦ КАК КоэффСтоимЗарплатеМашин,
		               |	ИндексыСметы.КоэффСтоимЗарплатеМашинЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ИндексыСметы.КоэффСтоимМатериаловЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ИндексыСметы.КоэффСтоимМатериалов
		               |	КОНЕЦ КАК КоэффСтоимМатериалов,
		               |	ИндексыСметы.КоэффСтоимМатериаловЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ИндексыСметы.КоэффОборудЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ИндексыСметы.КоэффОборуд
		               |	КОНЕЦ КАК КоэффОборуд,
		               |	ИндексыСметы.КоэффОборудЕстьОтклонение,
		               |	ВЫБОР
		               |		КОГДА ИндексыСметы.КоэффПолнСтоимРаботЕстьОтклонение > 0
		               |			ТОГДА 0
		               |		ИНАЧЕ ИндексыСметы.КоэффПолнСтоимРабот
		               |	КОНЕЦ КАК КоэффПолнСтоимРабот,
		               |	ИндексыСметы.КоэффПолнСтоимРаботЕстьОтклонение
		               |ИЗ
		               |	ИндексыСметы КАК ИндексыСметы";
	КонецЕсли;   			   
				  
	СписокПозиций = Новый СписокЗначений();
	Если ОтборПозицийСписок = Неопределено Тогда
		СписокПозиций.ЗагрузитьЗначения(Акт.Позиции.Выгрузить(,"Позиция").ВыгрузитьКолонку("Позиция"));
	Иначе
		СписокПозиций = ОтборПозицийСписок;
	КонецЕсли;
	Запрос.УстановитьПараметр("СписокПозиций",СписокПозиций);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает поправки из позиции локальной сметы в виде таблицы.
//
// Параметры:
//     Объект 		- Массив - список позиций для дополнительного отбора по позициям.
//     ПоДокументу 	- Булево - отбор по документу или в целом.
//
// Возвращаемое значение:
//     ТаблПоправок - ТаблицаЗначений - содержащая поправки, согласно переданным параметрам.
//
Функция ПолучитьПоправки(Объект,ПоДокументу = ложь) Экспорт
	
	Запрос = Новый Запрос;
	
	Если ПоДокументу Тогда
		Запрос.Текст = 	"ВЫБРАТЬ
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.КоэффОЗ КАК КоэффициентКОсновнойЗарплате,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.КоэффЭМ КАК КоэффициентКЭксплуатацииМашин,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.КоэффЗМ КАК КоэффициентКЗарплатеМашинистов,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.КоэффСМ КАК КоэффициентКСтоимостиМатериалов,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.КоэффТР КАК КоэффициентКТрудозатратамРабочих,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.КоэффТМ КАК КоэффициентКТрудозатратамМашинистов,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.ДобавПЗ КАК ДобавитьКПрямымЗатратам,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.ДобавОЗ КАК ДобавитьКОсновнойЗарплате,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.ДобавЭМ КАК ДобавитьКЭксплуатацииМашин,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.ДобавЗМ КАК ДобавитьКЗарплатеМашинистов,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.ДобавСМ КАК ДобавитьКСтоимостиМатериалов,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.ДобавТР КАК ДобавитьКТрудозатратамРабочих,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.ДобавТ КАК ДобавитьКТрудозатратам,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.КоэффПЗ КАК КоэффициентКПрямымЗатратам,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.ВариантРасчета
		               	|ИЗ
		               	|	Документ.СМ_ПозицияЛокальнойСметы.ПоправкиПозиции КАК ПозицияЛокальнойСметыПоправкиПозиции
		               	|ГДЕ
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.Ссылка = &Ссылка
		               	|	И ПозицияЛокальнойСметыПоправкиПозиции.Применить = ИСТИНА";
		Запрос.УстановитьПараметр("Ссылка",СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(Объект,"СМ_ПозицияЛокальнойСметы"));
		
	Иначе
		
		Запрос.Текст = 	"ВЫБРАТЬ
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.КоэффОЗ КАК КоэффициентКОсновнойЗарплате,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.КоэффЭМ КАК КоэффициентКЭксплуатацииМашин,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.КоэффЗМ КАК КоэффициентКЗарплатеМашинистов,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.КоэффСМ КАК КоэффициентКСтоимостиМатериалов,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.КоэффТР КАК КоэффициентКТрудозатратамРабочих,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.КоэффТМ КАК КоэффициентКТрудозатратамМашинистов,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.ДобавПЗ КАК ДобавитьКПрямымЗатратам,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.ДобавОЗ КАК ДобавитьКОсновнойЗарплате,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.ДобавЭМ КАК ДобавитьКЭксплуатацииМашин,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.ДобавЗМ КАК ДобавитьКЗарплатеМашинистов,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.ДобавСМ КАК ДобавитьКСтоимостиМатериалов,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.ДобавТР КАК ДобавитьКТрудозатратамРабочих,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.ДобавТ КАК ДобавитьКТрудозатратам,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.КоэффПЗ КАК КоэффициентКПрямымЗатратам,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.ВариантРасчета,
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.Ссылка КАК Позиция
		               	|ИЗ
		               	|	Документ.СМ_ПозицияЛокальнойСметы.ПоправкиПозиции КАК ПозицияЛокальнойСметыПоправкиПозиции
		               	|ГДЕ
		               	|	ПозицияЛокальнойСметыПоправкиПозиции.Ссылка В (&СписокДокументов)
		               	|	И ПозицияЛокальнойСметыПоправкиПозиции.Применить = ИСТИНА";
						
		Для Каждого Позиция Из Объект Цикл
			Если ТипЗнч(Позиция.Значение) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				Позиция.Значение = СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(Позиция.Значение,"СМ_ПозицияЛокальнойСметы");	
			КонецЕсли;
		КонецЦикла;				
		Запрос.УстановитьПараметр("СписокДокументов",Объект);
 
	КонецЕсли;
	
	ТаблПоправок = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаТаблПоправок Из ТаблПоправок Цикл
		Для Каждого колонка Из ТаблПоправок.Колонки Цикл
			Если ТипЗнч(СтрокаТаблПоправок[Колонка.Имя]) = Тип("Число") И СтрокаТаблПоправок[Колонка.Имя] = 0 И НЕ Лев(Колонка.Имя,8) = "Добавить" Тогда
				СтрокаТаблПоправок[Колонка.Имя] = 1;	
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат ТаблПоправок;
	
КонецФункции

// Возвращает отминусованные ресурсы из позиции локальной сметы в виде таблицы.
//
// Параметры:
//     СписокПозиций - Массив - список позиций для отбора по позициям.
//
// Возвращаемое значение:
//     ТабРезультат - ТаблицаЗначений - содержит позиции с минусом, согласно переданным параметрам.
//
Функция ПолучитьМинусовые(СписокПозиций) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ
	               	|	СМ_ПозицияЛокальнойСметы.Ссылка КАК Позиция,
	               	|	СМ_ПозицияЛокальнойСметы.ОбъемРабот,
	               	|	СМ_ПозицияЛокальнойСметы.ИДПозицииВладельца КАК ИДВладельца,
	               	|	СМ_ПозицияЛокальнойСметы.ШифрРасценки
	               	|ИЗ
	               	|	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
	               	|ГДЕ
	               	|	СМ_ПозицияЛокальнойСметы.ИДПозицииВладельца В(&СписокДокументов)
	               	|	И СМ_ПозицияЛокальнойСметы.ОбъемРабот < 0";
	Запрос.УстановитьПараметр("СписокДокументов",СписокПозиций);
	Возврат Запрос.Выполнить().Выгрузить();;
КонецФункции   

// Пересчет привязанных позиций при изменении объема основной позиции. 
//
// Параметры:
//     ПозицияВладелец - ДокументСсылка - ссылка на документ СМ_ПозицияЛокальнойСметы.
//     НовыйОбъем      - Число - новый объем работ по позиции.
//     СтарыйОбъем     - Число - объем работ по позиции до изменения.
//
Процедура ВыполнитьПересчетПривязанныхПозиций(ПозицияВладелец,НовыйОбъем,СтарыйОбъем) Экспорт
	
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СМ_ПозицияЛокальнойСметы.Ссылка
	|ИЗ
	|	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
	|ГДЕ
	|	СМ_ПозицияЛокальнойСметы.ИДПозицииВладельца = &ИДПозицииВладельца
	|	И СМ_ПозицияЛокальнойСметы.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	СМ_ПозицияЛокальнойСметы.Дата";
