		ИтогоСУчетомНаклРасх.Итог		 	= Справочники.СМ_ИтогиПоРазделу.ИтогоСУчетомНаклРасх;
	КонецЕсли;
	// Суммирование с итогом по подчиненным разделам.
	
	// Базисное значение.
	Если (МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный) И МетодикаРСНБ Тогда
		ИтогоСУчетомНаклРасхСумма 		 = ИтогоСУчетомНаклРасх.ПрямЗатраты + НаклРасхРаздела + ПрямЗатраты;
		ИтогоСУчетомНаклРасх.ПрямЗатраты = ИтогоСУчетомНаклРасхСумма;
