			ТекСтрока.ПрямЗатраты 		= ?(ПромОкр,Окр(ТекСтрока.ПрямЗатраты*К_НР_СП,КолЗнаков),ТекСтрока.ПрямЗатраты*К_НР_СП);
			// Временно. Для итогов в форме...
			//ТекСтрока.ОснЗарплата       = ?(ПромОкр,Окр(ТекСтрока.ОснЗарплата*К_НР_СП,КолЗнаков),ТекСтрока.ОснЗарплата*К_НР_СП);
			//ТекСтрока.ЭксплМашин        = ?(ПромОкр,Окр(ТекСтрока.ЭксплМашин*К_НР_СП,КолЗнаков),ТекСтрока.ЭксплМашин*К_НР_СП);
			//ТекСтрока.ЗарплМашин        = ?(ПромОкр,Окр(ТекСтрока.ЗарплМашин*К_НР_СП,КолЗнаков),ТекСтрока.ЗарплМашин*К_НР_СП);
			//ТекСтрока.СтоимМатер        = ?(ПромОкр,Окр(ТекСтрока.СтоимМатер*К_НР_СП,КолЗнаков),ТекСтрока.СтоимМатер*К_НР_СП);
			ТекСтрока.Оборуд            = ?(ПромОкр,Окр(ТекСтрока.Оборуд*К_НР_СП,КолЗнаков),ТекСтрока.Оборуд*К_НР_СП);
			//ТекСтрока.ВозвратМатер      = ?(ПромОкр,Окр(ТекСтрока.ВозвратМатер*К_НР_СП,КолЗнаков),ТекСтрока.ВозвратМатер*К_НР_СП);
			//ТекСтрока.ДопЗМ			    = ?(ПромОкр,Окр(ТекСтрока.ДопЗМ*К_НР_СП,КолЗнаков),ТекСтрока.ДопЗМ*К_НР_СП);
				
			ТекСтрока.ТекПрямЗатраты    = ?(ПромОкр,Окр(ТекСтрока.ТекПрямЗатраты*К_НР_СП,КолЗнаков),ТекСтрока.ТекПрямЗатраты*К_НР_СП);
			// Временно. Для итогов в форме...
			//ТекСтрока.ТекОснЗарплата    = ?(ПромОкр,Окр(ТекСтрока.ТекОснЗарплата*К_НР_СП,КолЗнаков),ТекСтрока.ТекОснЗарплата*К_НР_СП);
			//ТекСтрока.ТекЭксплМашин     = ?(ПромОкр,Окр(ТекСтрока.ТекЭксплМашин*К_НР_СП,КолЗнаков),ТекСтрока.ТекЭксплМашин*К_НР_СП);
			//ТекСтрока.ТекЗарплМашин     = ?(ПромОкр,Окр(ТекСтрока.ТекЗарплМашин*К_НР_СП,КолЗнаков),ТекСтрока.ТекЗарплМашин*К_НР_СП);
			//ТекСтрока.ТекСтоимМатер     = ?(ПромОкр,Окр(ТекСтрока.ТекСтоимМатер*К_НР_СП,КолЗнаков),ТекСтрока.ТекСтоимМатер*К_НР_СП);
			//ТекСтрока.ТекВозвратМатер   = ?(ПромОкр,Окр(ТекСтрока.ТекВозвратМатер*К_НР_СП,КолЗнаков),ТекСтрока.ТекВозвратМатер*К_НР_СП);
			//ТекСтрока.ТекДопЗМ		    = ?(ПромОкр,Окр(ТекСтрока.ТекДопЗМ*К_НР_СП,КолЗнаков),ТекСтрока.ТекДопЗМ*К_НР_СП);
			ТекСтрока.ТекОборуд         = ?(ПромОкр,Окр(ТекСтрока.ТекОборуд*К_НР_СП,КолЗнаков),ТекСтрока.ТекОборуд*К_НР_СП);
				
		ИначеЕсли МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
			И Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета Тогда
			
			Если СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат Тогда
				
				
				ТекСтрока.ТекОснЗарплата    = ТекСтрока.ТекОснЗарплата * ?(НаборКоэф.КоэффФОТ = 0,1,НаборКоэф.КоэффФОТ);
				ТекСтрока.ТекЭксплМашин     = ТекСтрока.ТекЭксплМашин * ?(НаборКоэф.КоэффСтоимЭксплМашин = 0,1,НаборКоэф.КоэффСтоимЭксплМашин);
				ТекСтрока.ТекЗарплМашин     = ТекСтрока.ТекЗарплМашин * ?(НаборКоэф.КоэффФОТ = 0,1,НаборКоэф.КоэффФОТ);
				ТекСтрока.ТекСтоимМатер     = ТекСтрока.ТекСтоимМатер * ?(НаборКоэф.КоэффСтоимМатериалов = 0,1,НаборКоэф.КоэффСтоимМатериалов);
				ТекСтрока.ТекОборуд         = ТекСтрока.ТекОборуд * ?(НаборКоэф.КоэффОборуд = 0,1,НаборКоэф.КоэффОборуд);
				ТекСтрока.ТекВозвратМатер   = ТекСтрока.ТекВозвратМатер * ?(НаборКоэф.КоэффСтоимМатериалов = 0,1,НаборКоэф.КоэффСтоимМатериалов);
				
				ТекСтрока.СуммаСПТекущая    = ТекСтрока.СуммаСПТекущая * ?(НаборКоэф.КоэффФОТ = 0,1,НаборКоэф.КоэффФОТ);
				ТекСтрока.СуммаНРТекущая    = ТекСтрока.СуммаНРТекущая * ?(НаборКоэф.КоэффФОТ = 0,1,НаборКоэф.КоэффФОТ);
				Если (ТекСтрока.ТекОснЗарплата + ТекСтрока.ТекЭксплМашин + ТекСтрока.ТекСтоимМатер) <> 0 Тогда
					ТекСтрока.ТекПрямЗатраты    = ТекСтрока.ТекОснЗарплата + ТекСтрока.ТекЭксплМашин + ТекСтрока.ТекСтоимМатер + ТекСтрока.СуммаСПТекущая + ТекСтрока.СуммаНРТекущая;
				Иначе
					ТекСтрока.ТекПрямЗатраты    = ТекСтрока.ТекПрямЗатраты;
				КонецЕсли;
			
			ИначеЕсли СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости Тогда
				
				Если ТекСтрока.Итог = Справочники.СМ_ИтогиСметыПоВидамРабот.ПрочРаб Тогда
					ТекКоэффициент	= НаборКоэф.КоэффПрочРаб;	
				ИначеЕсли ТекСтрока.Итог = Справочники.СМ_ИтогиСметыПоВидамРабот.Оборуд Тогда
					ТекКоэффициент	= НаборКоэф.КоэффОборуд;	
				Иначе
					ТекКоэффициент	= НаборКоэф.КоэффСМР;	
				КонецЕсли;
				
				Если ТекКоэффициент = 0 Тогда
					ТекКоэффициент = 1;
				КонецЕсли;				
				
				ТекСтрока.ТекОснЗарплата    = ТекСтрока.ТекОснЗарплата * ТекКоэффициент;
				ТекСтрока.ТекЭксплМашин     = ТекСтрока.ТекЭксплМашин * ТекКоэффициент;
				ТекСтрока.ТекЗарплМашин     = ТекСтрока.ТекЗарплМашин * ТекКоэффициент;
				ТекСтрока.ТекСтоимМатер     = ТекСтрока.ТекСтоимМатер * ТекКоэффициент;
				ТекСтрока.ТекОборуд         = ТекСтрока.ТекОборуд * ТекКоэффициент;
				ТекСтрока.ТекВозвратМатер   = ТекСтрока.ТекВозвратМатер * ТекКоэффициент;
				Если (ТекСтрока.ТекОснЗарплата + ТекСтрока.ТекЭксплМашин + ТекСтрока.ТекСтоимМатер) <> 0 Тогда
					ТекСтрока.ТекПрямЗатраты    = ТекСтрока.ТекОснЗарплата + ТекСтрока.ТекЭксплМашин + ТекСтрока.ТекСтоимМатер;
				Иначе
					ТекСтрока.ТекПрямЗатраты = ТекСтрока.ТекПрямЗатраты * ТекКоэффициент;
				КонецЕсли;
		
				СуммаСПТекущая    = СуммаСПТекущая * ТекКоэффициент; 
				СуммаНРТекущая    = СуммаНРТекущая * ТекКоэффициент; 
				
				ТекСтрока.ТекПрямЗатраты    = ТекСтрока.ТекПрямЗатраты + СуммаСПТекущая + СуммаНРТекущая;
				
			КонецЕсли;
			
		ИначеЕсли МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
			И Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда	
			Если ФлагАкт  Тогда
				Отбор1 = Новый Структура();
				Отбор1.Вставить("Раздел", ТекСтрока.Раздел);
				МассивНаборКоэф = Ссылка.Разделы.НайтиСтроки(Отбор1);
				Если МассивНаборКоэф.Количество() = 1 Тогда
					НаборКоэф = МассивНаборКоэф[0];
				Иначе
					// Временно?
					НаборКоэф = ТекСтрока.Раздел;
				КонецЕсли;	
			Иначе
				НаборКоэф = ТекСтрока.Раздел;
			КонецЕсли;
			НеПрименятьИндексы = ТекСтрока.Позиция.НеПрименятьИндексы;
			Если НеПрименятьИндексы = Ложь Тогда
				Если СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат И
					НаборКоэф.КоэффПолнСтоимРабот = 0 Тогда
					УчитыватьДопЗМ = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","УчитыватьДопЗМ",Ложь);	
					ИндексироватьДопЗМФот = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ИндексироватьДопЗМФот",Ложь);	
					КоэффЗМ = ?(ИндексироватьДопЗМФот, ?(НаборКоэф.КоэффОснЗарплаты = 0,1,НаборКоэф.КоэффОснЗарплаты), ?(НаборКоэф.КоэффСтоимЭксплМашин = 0,1,НаборКоэф.КоэффСтоимЭксплМашин));	
					// К расценке применяются индексы.
					Если ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Разные Тогда
						ТекСтрока.ТекЗарплМашин = Окр(ТекСтрока.ТекЗарплМашин * ?(НаборКоэф.КоэффОснЗарплаты = 0,1,НаборКоэф.КоэффОснЗарплаты),2);
						ТекСтрока.ТекЭксплМашин = Окр(ТекСтрока.ТекЭксплМашин * ?(НаборКоэф.КоэффСтоимЭксплМашин = 0,1,НаборКоэф.КоэффСтоимЭксплМашин),2);
						Если УчитыватьДопЗМ Тогда 
							ТекСтрока.ТекЭксплМашин     = (ТекСтрока.ТекЭксплМашин - Окр(ДопЗМ,2)*?(НаборКоэф.КоэффСтоимЭксплМашин = 0,1,НаборКоэф.КоэффСтоимЭксплМашин)) + Окр(ДопЗМ,2) * КоэффЗМ;
						КонецЕсли;
					ИначеЕсли ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Одинаковые Тогда
						ТекСтрока.ТекЗарплМашин = Окр(ТекСтрока.ТекЗарплМашин * ?(НаборКоэф.КоэффСтоимЭксплМашин = 0,1,НаборКоэф.КоэффСтоимЭксплМашин),2);
						ТекСтрока.ТекЭксплМашин = Окр(ТекСтрока.ТекЭксплМашин * ?(НаборКоэф.КоэффСтоимЭксплМашин = 0,1,НаборКоэф.КоэффСтоимЭксплМашин),2);
					ИначеЕсли ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.РазныеКРазности Тогда
						ТекСтрока.ТекЭксплМашин = Окр((ТекСтрока.ТекЭксплМашин - ТекСтрока.ТекЗарплМашин) * ?(НаборКоэф.КоэффСтоимЭксплМашин = 0,1,НаборКоэф.КоэффСтоимЭксплМашин),2);
						ТекСтрока.ТекЗарплМашин = Окр(ТекСтрока.ТекЗарплМашин * ?(НаборКоэф.КоэффОснЗарплаты = 0,1,НаборКоэф.КоэффОснЗарплаты),2);
						ТекСтрока.ТекЭксплМашин = ТекСтрока.ТекЭксплМашин + ТекСтрока.ТекЗарплМашин;
					КонецЕсли;	
					ТекСтрока.ТекОснЗарплата    = Окр(ТекСтрока.ТекОснЗарплата,2) * ?(НаборКоэф.КоэффОснЗарплаты = 0,1,НаборКоэф.КоэффОснЗарплаты);
					ТекСтрока.ТекСтоимМатер     = Окр(ТекСтрока.ТекСтоимМатер,2) * ?(НаборКоэф.КоэффСтоимМатериалов = 0,1,НаборКоэф.КоэффСтоимМатериалов);
					ТекСтрока.ТекОборуд         = Окр(ТекСтрока.ТекОборуд,2) * ?(НаборКоэф.КоэффОборуд = 0,1,НаборКоэф.КоэффОборуд);
					ТекСтрока.ТекВозвратМатер   = Окр(ТекСтрока.ТекВозвратМатер,2) * ?(НаборКоэф.КоэффСтоимМатериалов = 0,1,НаборКоэф.КоэффСтоимМатериалов);
					
					СуммаСПТекущая    = СуммаСПТекущая * ?(НаборКоэф.КоэффОснЗарплаты = 0,1,НаборКоэф.КоэффОснЗарплаты);
					СуммаСПТекущая    = ?(ОкрИтог,Окр(СуммаСПТекущая,0),Окр(СуммаСПТекущая,2));
					СуммаНРТекущая    = СуммаНРТекущая * ?(НаборКоэф.КоэффОснЗарплаты = 0,1,НаборКоэф.КоэффОснЗарплаты);
					СуммаНРТекущая    = ?(ОкрИтог,Окр(СуммаНРТекущая,0),Окр(СуммаНРТекущая,2));
					
					Если ТекСтрока.ТекОснЗарплата + ТекСтрока.ТекЭксплМашин + ТекСтрока.ТекСтоимМатер <> 0 Тогда
						ТекСтрока.ТекПрямЗатраты    = ТекСтрока.ТекОснЗарплата + ТекСтрока.ТекЭксплМашин + ТекСтрока.ТекСтоимМатер  + СуммаСПТекущая + СуммаНРТекущая;
					иначе
						 ТекСтрока.ТекПрямЗатраты    = ТекСтрока.ТекПрямЗатраты;
					КонецЕсли;	
					
				ИначеЕсли СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости ИЛИ
					(СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат И НаборКоэф.КоэффПолнСтоимРабот <> 0) Тогда
					
					ТекКоэффициент = НаборКоэф.КоэффПолнСтоимРабот;
					Если НаборКоэф.КоэффПолнСтоимРабот = 0 Тогда
						ТекКоэффициент = 1;	
					КонецЕсли;
					ТекСтрока.ТекОснЗарплата    = ТекСтрока.ТекОснЗарплата * ТекКоэффициент;
					ТекСтрока.ТекЭксплМашин     = ТекСтрока.ТекЭксплМашин * ТекКоэффициент;
					ТекСтрока.ТекЗарплМашин     = ТекСтрока.ТекЗарплМашин * ТекКоэффициент;
					ТекСтрока.ТекСтоимМатер     = ТекСтрока.ТекСтоимМатер * ТекКоэффициент;
					ТекСтрока.ТекОборуд         = ТекСтрока.ТекОборуд * ТекКоэффициент;
					ТекСтрока.ТекВозвратМатер   = ТекСтрока.ТекВозвратМатер * ТекКоэффициент;  					
					
					СуммаСПТекущая    = СуммаСПТекущая * ТекКоэффициент; 
					СуммаНРТекущая    = СуммаНРТекущая * ТекКоэффициент; 
					Если ТекСтрока.ТекОснЗарплата + ТекСтрока.ТекЭксплМашин + ТекСтрока.ТекСтоимМатер <> 0 Тогда
						ТекСтрока.ТекПрямЗатраты    = ТекСтрока.ТекОснЗарплата + ТекСтрока.ТекЭксплМашин + ТекСтрока.ТекСтоимМатер; 
					Иначе
						ТекСтрока.ТекПрямЗатраты    = ТекСтрока.ТекПрямЗатраты * ТекКоэффициент;
					КонецЕсли;
					ТекСтрока.ТекПрямЗатраты = ТекСтрока.ТекПрямЗатраты + СуммаСПТекущая + СуммаНРТекущая ;
					
				КонецЕсли;
			КонецЕсли;
			Если ОкрИтог Тогда
				ТекСтрока.ОснЗарплата 	= Окр(ТекСтрока.ОснЗарплата,0);		
				ТекСтрока.ЭксплМашин 	= Окр(ТекСтрока.ЭксплМашин,0);		
				ТекСтрока.ЗарплМашин 	= Окр(ТекСтрока.ЗарплМашин,0);		
				ТекСтрока.СтоимМатер 	= Окр(ТекСтрока.СтоимМатер,0);		
				ТекСтрока.Оборуд 		= Окр(ТекСтрока.Оборуд,0);		
				ТекСтрока.ПрямЗатраты 	= Окр(ТекСтрока.ПрямЗатраты,0);
				
				ТекСтрока.ТекОснЗарплата 	= Окр(ТекСтрока.ТекОснЗарплата,0);		
				ТекСтрока.ТекЭксплМашин 	= Окр(ТекСтрока.ТекЭксплМашин,0);		
				ТекСтрока.ТекЗарплМашин 	= Окр(ТекСтрока.ТекЗарплМашин,0);		
				ТекСтрока.ТекСтоимМатер 	= Окр(ТекСтрока.ТекСтоимМатер,0);		
				ТекСтрока.ТекОборуд 		= Окр(ТекСтрока.ТекОборуд,0);		
				ТекСтрока.ТекПрямЗатраты 	= Окр(ТекСтрока.ТекПрямЗатраты,0);
			КонецЕсли;
			
		КонецЕсли;
		
		// Округление. 		
		Если ТекСтрока.ТекОборуд <> 0 Тогда
			ТекСтрока.ТекПрямЗатраты = ТекСтрока.ТекПрямЗатраты + ТекСтрока.ТекОборуд;
		КонецЕсли;
		
		Если ТекСтрока.Оборуд <> 0 Тогда
			ТекСтрока.ПрямЗатраты = ТекСтрока.ПрямЗатраты + ТекСтрока.Оборуд;
		КонецЕсли;      		
		
	КонецЦикла;
	
	ТаблПозиции.Свернуть("Смета,Раздел,Итог","ПрямЗатраты,ОснЗарплата,ЭксплМашин,ЗарплМашин,СтоимМатер,Оборуд,ВозвратМатер,ЗатратыТрудаРабочих,ЗатратыТрудаМашин,СуммаСПБазисная,СуммаНРБазисная,ТекПрямЗатраты,ТекОснЗарплата,ТекЭксплМашин,ТекЗарплМашин,ТекСтоимМатер,ТекОборуд,ТекВозвратМатер,СуммаСПТекущая,СуммаНРТекущая");
	Отбор = Новый Структура("Смета",Ссылка);
	СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНаборТаблицей("СМ_ИтогиПоВидамРабот",Отбор,ТаблПозиции);
	
КонецПроцедуры

#КонецОбласти

#Область РасчетЛимЗатрат

// Общая процедура вызова расчета лимитированных затрат из модулей менеджеров документов.
//
// Параметры:
//     Ссылка - ДокументСсылка - ссылка на смету любого уровня или акт выполненных работ.
//
Процедура РассчитатьЛимитированныеЗатраты(Ссылка) Экспорт
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") ИЛИ ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		ОкрИтог = Ссылка.ПроводитьОкругление;
		Если ОкрИтог Тогда
			КолЗнаков = Ссылка.ФорматОкругления;
		Иначе
			КолЗнаков = 2;
		КонецЕсли;
	Иначе
		Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
			ЛокСмета = Ссылка.ЛокальнаяСмета;
		Иначе
			ЛокСмета = Ссылка;
		КонецЕсли;
		ОкрИтог = ЛокСмета.ОкруглятьДоРублей;
		Если ОкрИтог Тогда
			КолЗнаков = 0;
		Иначе
			КолЗнаков = 2;
		КонецЕсли;
	КонецЕсли;

	// 1. Создаем  таблицу значений, по набору записей регистра "СМ_ИтогиПоВидамРабот".
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда                 
		ИтогиПоВР = СобратьИтогиПоВидамРаботСС(Ссылка);
	Иначе	
		ИтогиПоВР = СобратьИтогиПоВидамРабот(Ссылка);
	КонецЕсли;
	
	// 2. Создаем пустую таблицу значений, по набору записей регистра "СМ_ИтогиПоГлавам".
	ИтогиПоГлавам = СобратьИтогиПоГлавам(Ссылка);

	// 3. Создаем список видов затрат.
	СписокВидыЗатрат = Новый Массив;
	СписокВидыЗатрат.Добавить(Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы);
	СписокВидыЗатрат.Добавить(Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы);
	СписокВидыЗатрат.Добавить(Перечисления.СМ_ВидыЗатратСмета.Оборудование);
	СписокВидыЗатрат.Добавить(Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы);
	УкрупнениеИтоговПоВидамРабот(ИтогиПоВР,Ссылка);
	
	// Заполнение таблицы итогов по главам парами значений ИтогПоГлавам / ВидЗатрат.
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		ФормированиеТаблицыИтогиПоГлавамОС(ИтогиПоГлавам, ИтогиПоВР,Ссылка,СписокВидыЗатрат);
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		ФормированиеТаблицыИтогиПоГлавамСС(ИтогиПоГлавам, ИтогиПоВР,Ссылка,СписокВидыЗатрат);
	Иначе
		ФормированиеТаблицыИтогиПоГлавам(ИтогиПоГлавам, ИтогиПоВР,Ссылка,СписокВидыЗатрат);
	КонецЕсли;
	
	РасчетЛимЗатраты(ИтогиПоГлавам, ИтогиПоВР,Ссылка,КолЗнаков);
	
	// Удаление пустых строк.
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ПрямЗатраты",0);
	СтруктураОтбора.Вставить("ОснЗарплата",0);
	СтруктураОтбора.Вставить("ЭксплМашин",0);
	СтруктураОтбора.Вставить("ЗарплМашин",0);
	СтруктураОтбора.Вставить("СтоимМатер",0);
	СтруктураОтбора.Вставить("Оборуд",0);
	СтруктураОтбора.Вставить("ВозвратМатер",0);
	СтруктураОтбора.Вставить("ТекПрямЗатраты",0);
	СтруктураОтбора.Вставить("ТекОснЗарплата",0);
	СтруктураОтбора.Вставить("ТекЭксплМашин",0);
	СтруктураОтбора.Вставить("ТекЗарплМашин",0);
	СтруктураОтбора.Вставить("ТекСтоимМатер",0);
	СтруктураОтбора.Вставить("ТекОборуд",0);
	СтруктураОтбора.Вставить("ТекВозвратМатер",0);
	СтруктураОтбора.Вставить("ЗатратыТрудаРабочих",0);
	СтруктураОтбора.Вставить("ЗатратыТрудаМашин",0);
		
	МассивСтрок = ИтогиПоГлавам.НайтиСтроки(СтруктураОтбора);
	Для Каждого ТекСтр Из МассивСтрок Цикл
		ИтогиПоГлавам.Удалить(ТекСтр);
	КонецЦикла;	
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		Если Ссылка.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
			Для Каждого ТекСтр Из ИтогиПоГлавам Цикл
				ГлаваКапРемонта = НайтиСоответствиеГлавыСметы(ТекСтр.Глава);
				Если Не ГлаваКапРемонта = Неопределено Тогда
					ТекСтр.Глава = ГлаваКапРемонта;
				Иначе
					ИтогиПоГлавам.Удалить(ТекСтр);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	// Запись итоговых значений в регистр сведений "Итоги по главам".
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда 
		Отбор = Новый Структура("Смета",Ссылка);
		СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНаборТаблицей("СМ_ИтогиПоГлавамОС",Отбор,ИтогиПоГлавам);
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		Отбор = Новый Структура("Смета",Ссылка);
		СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНаборТаблицей("СМ_ИтогиПоГлавамСС",Отбор,ИтогиПоГлавам);
	Иначе
		Отбор = Новый Структура("Смета",Ссылка);
		СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНаборТаблицей("СМ_ИтогиПоГлавам",Отбор,ИтогиПоГлавам);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область РасчетСреднихСтоимостейУСП

// Общая процедура заполнения регистров для целей блока УСП.
//
// Параметры:
//     Объект 						- ДокументОбъект.СМ_ПозицияЛокальнойСметы - объект позиции.
//     СтруктураДанныхРасчета 		- Структура - содержит таблицы данных для расчета (см. менеджер СМ_ПозицияЛокальнойСметы).
//     Смета 						- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на локальную смету.  
//     Акт 							- ДокументСсылка.СМ_АктыВыполненныхРабот - ссылка на акт выполненных работ.
//     СтруктураПараметровОтбораРС 	- Структура - содержит поля с дополнительным отбором результирующего регистра сведений.
//     ИспользоватьРС 				- Булево - если Ложь, то все считается без чтения и записи из РС.
//
Процедура ОтразитьСтоимостьПозицииВРегистреУСП(Объект, СтруктураДанныхРасчета, Смета, Акт = Неопределено, СтруктураПараметровОтбораРС = Неопределено, ИспользоватьРС = Истина) Экспорт
	
	РасчетАкта = Акт <> Неопределено;
	
	Если СтруктураПараметровОтбораРС = Неопределено Тогда
		СтруктураПараметровОтбораРС = СМ_СметаВызовСервера.ПолучитьСтруктуруДанныхДляОтборовРегистра(Объект, , "СМ_ПозицияЛокальнойСметы");
	КонецЕсли;
	// Параметры округления.
	КолЗнаков = 2;
	Если  СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	//
	ЗапросСтоимости = Новый Запрос;
	ЗапросСтоимости.УстановитьПараметр("Смета", СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
	ЗапросСтоимости.УстановитьПараметр("Раздел", СтруктураПараметровОтбораРС.СсылкаНаРаздел);
	ЗапросСтоимости.УстановитьПараметр("Позиция", СтруктураПараметровОтбораРС.СсылкаНаПозицию);
	
	Индексы = Новый Структура();
	Индексы.Вставить("ОЗ", 1);
	Индексы.Вставить("ЭМ", 1);
	Индексы.Вставить("ЗМ", 1);
	Индексы.Вставить("СМ", 1);
	Индексы.Вставить("ОБ", 1);
	Индексы.Вставить("ПЗ", 1);
	
	Если Смета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		|	СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.Смета,
		|	СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.Раздел,
		|	СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.Позиция,
		|	ВЫБОР
		|		КОГДА СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.ТекСтоимПрямЗатраты = 0
		|				И СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.ТекСтоимОборуд <> 0
		|			ТОГДА ЕстьNULL(СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.ТекСтоимОборуд,0)
		|		ИНАЧЕ ЕстьNULL(СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.ТекСтоимПрямЗатраты,0)
		|	КОНЕЦ КАК ПрямыеЗатраты,
		|	ЕстьNULL(СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.ТекСтоимОснЗарплата,0) КАК ОсновнаяЗарплата,
		|	ЕстьNULL(СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.ТекСтоимЭксплМашин,0) КАК ЭксплуатацияМашин,
		|	ЕстьNULL(СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.ТекСтоимЗарплМашин,0) КАК ЗарплатаМашинистов,
		|	ЕстьNULL(СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.ТекСтоимСтоимМатер,0) КАК СтоимостьМатериалов,
		|	ЕстьNULL(СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.ТекСтоимВозвратМатер,0) КАК ВозвратМатериалов
		|ИЗ
		|	РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП КАК СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками
		|ГДЕ
		|	СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.Смета = &Смета
		|	И СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.Раздел = &Раздел
		|	И СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками.Позиция = &Позиция";
		
	ИначеЕсли Смета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный Тогда
		Если Смета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка Тогда
			ТекстЗапроса = "ВЫБРАТЬ
			|	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета,
			|	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Раздел,
			|	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция,
			|	ВЫБОР
			|		КОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимПрямЗатраты = 0
			|				И СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимОборуд <> 0
			|			ТОГДА ЕстьNULL(СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимОборуд,0)
			|		ИНАЧЕ ЕстьNULL(СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимПрямЗатраты,0)
			|	КОНЕЦ КАК ПрямыеЗатраты,
			|	ЕстьNULL(СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимОснЗарплата,0) КАК ОсновнаяЗарплата,
			|	ЕстьNULL(СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимЭксплМашин,0) КАК ЭксплуатацияМашин,
			|	ЕстьNULL(СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимЗарплМашин,0) КАК ЗарплатаМашинистов,
			|	ЕстьNULL(СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимСтоимМатер,0) КАК СтоимостьМатериалов,
			|	ЕстьNULL(СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимВозвратМатер,0) КАК ВозвратМатериалов
			|ИЗ
			|	РегистрСведений.СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета КАК СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета
			|ГДЕ
			|	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета = &Смета
			|	И СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Раздел = &Раздел
			|	И СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция = &Позиция";
			// Сохраним индексы на всякий случай.
			Для Каждого ЗаписьИндексы Из Объект.КоэффициентыПересчета Цикл
				Индексы.ОЗ = Индексы.ОЗ*ЗаписьИндексы.КоэффОснЗарплаты; 
				Индексы.ЭМ = Индексы.ЭМ*ЗаписьИндексы.КоэффСтоимЭксплМашин;
				Индексы.ЗМ = Индексы.ЗМ*ЗаписьИндексы.КоэффСтоимЗарплатеМашин;
				Индексы.СМ = Индексы.СМ*ЗаписьИндексы.КоэффСтоимМатериалов;
				Индексы.ПЗ = Индексы.ПЗ*ЗаписьИндексы.КоэффПолнСтоимРабот;
				Индексы.ОБ = Индексы.ОБ*ЗаписьИндексы.КоэффОборуд;
			КонецЦикла;
		ИначеЕсли Смета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда
			// БИ метод расчета, уровень раздел по элементам затрат.
			ПоЭлементам = (Смета.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат);
			
			КоэффРаздела = Новый ТаблицаЗначений;
			ОписаниеЧисла = Новый ОписаниеТипов("Число");
			КоэффРаздела.Колонки.Добавить("КоэффОснЗарплаты",ОписаниеЧисла);
			КоэффРаздела.Колонки.Добавить("КоэффПЗ",ОписаниеЧисла);
			КоэффРаздела.Колонки.Добавить("КоэффСтоимЗарплатеМашин",ОписаниеЧисла);
			КоэффРаздела.Колонки.Добавить("КоэффСтоимМатериалов",ОписаниеЧисла);
			КоэффРаздела.Колонки.Добавить("КоэффСтоимЭксплМашин",ОписаниеЧисла);
			КоэффРаздела.Колонки.Добавить("КоэффОборуд",ОписаниеЧисла);
			КоэффРаздела.Колонки.Добавить("КоэффПолнСтоимРабот",ОписаниеЧисла);
			КоэффРаздела.Колонки.Добавить("Смета", Новый ОписаниеТипов(?(РасчетАкта,"ДокументСсылка.СМ_АктВыполненныхРабот","ДокументСсылка.СМ_ЛокальнаяСмета")));
			КоэффРаздела.Колонки.Добавить("Раздел", Новый ОписаниеТипов("ДокументСсылка.СМ_РазделЛокальнойСметы"));
			КоэффРаздела.Колонки.Добавить("Позиция", Новый ОписаниеТипов("ДокументСсылка.СМ_ПозицияЛокальнойСметы"));
			СтрокаКоэффРаздела = КоэффРаздела.Добавить();
			КоэффРаздела.ЗаполнитьЗначения(1);
			СтрокаКоэффРаздела.Смета = СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета;    
			СтрокаКоэффРаздела.Раздел = СтруктураПараметровОтбораРС.СсылкаНаРаздел;
			СтрокаКоэффРаздела.Позиция = СтруктураПараметровОтбораРС.СсылкаНаПозицию;
			Раздел = СтруктураПараметровОтбораРС.СсылкаНаРаздел;
			Пока ЗначениеЗаполнено(Раздел) И Раздел <> Смета Цикл
				Если РасчетАкта Тогда
					СтрокаРаздела = СМ_СметаВызовСервера.СтрокаРазделаАкта(СтруктураПараметровОтбораРС.СсылкаНаАкт, СтруктураПараметровОтбораРС.СсылкаНаРаздел);
					СтрокаКоэффРаздела.КоэффОснЗарплаты =			СтрокаКоэффРаздела.КоэффОснЗарплаты * ?(СтрокаРаздела.КоэффОснЗарплаты=0,1,СтрокаРаздела.КоэффОснЗарплаты);
					СтрокаКоэффРаздела.КоэффПолнСтоимРабот = 		СтрокаКоэффРаздела.КоэффПолнСтоимРабот * ?(СтрокаРаздела.КоэффПолнСтоимРабот=0,1,СтрокаРаздела.КоэффПолнСтоимРабот);		
					СтрокаКоэффРаздела.КоэффСтоимЗарплатеМашин = 	СтрокаКоэффРаздела.КоэффСтоимЗарплатеМашин * ?(СтрокаРаздела.КоэффСтоимЗарплатеМашин=0,1,СтрокаРаздела.КоэффСтоимЗарплатеМашин);	
					СтрокаКоэффРаздела.КоэффСтоимМатериалов = 		СтрокаКоэффРаздела.КоэффСтоимМатериалов * ?(СтрокаРаздела.КоэффСтоимМатериалов=0,1,СтрокаРаздела.КоэффСтоимМатериалов);		
					СтрокаКоэффРаздела.КоэффСтоимЭксплМашин = 		СтрокаКоэффРаздела.КоэффСтоимЭксплМашин * ?(СтрокаРаздела.КоэффСтоимЭксплМашин=0,1,СтрокаРаздела.КоэффСтоимЭксплМашин);		
					СтрокаКоэффРаздела.КоэффОборуд = 				СтрокаКоэффРаздела.КоэффОборуд * ?(СтрокаРаздела.КоэффОборуд=0,1,СтрокаРаздела.КоэффОборуд);				
				Иначе					
					СтрокаКоэффРаздела.КоэффОснЗарплаты = 			?(ПоЭлементам, СтрокаКоэффРаздела.КоэффОснЗарплаты * ?(Раздел.КоэффОснЗарплаты=0,1,Раздел.КоэффОснЗарплаты), 						
																	СтрокаКоэффРаздела.КоэффОснЗарплаты * ?(Раздел.КоэффПолнСтоимРабот=0,1,Раздел.КоэффПолнСтоимРабот));
					СтрокаКоэффРаздела.КоэффПолнСтоимРабот = 		?(ПоЭлементам, СтрокаКоэффРаздела.КоэффПолнСтоимРабот * ?(Раздел.КоэффПолнСтоимРабот=0,1,Раздел.КоэффПолнСтоимРабот),
																	СтрокаКоэффРаздела.КоэффПолнСтоимРабот * ?(Раздел.КоэффПолнСтоимРабот=0,1,Раздел.КоэффПолнСтоимРабот));
					СтрокаКоэффРаздела.КоэффСтоимЗарплатеМашин = 	?(ПоЭлементам, СтрокаКоэффРаздела.КоэффСтоимЗарплатеМашин * ?(Раздел.КоэффСтоимЗарплатеМашин=0,1,Раздел.КоэффСтоимЗарплатеМашин),
																	СтрокаКоэффРаздела.КоэффСтоимЗарплатеМашин * ?(Раздел.КоэффПолнСтоимРабот=0,1,Раздел.КоэффПолнСтоимРабот));
					СтрокаКоэффРаздела.КоэффСтоимМатериалов = 		?(ПоЭлементам, СтрокаКоэффРаздела.КоэффСтоимМатериалов * ?(Раздел.КоэффСтоимМатериалов=0,1,Раздел.КоэффСтоимМатериалов),
																	СтрокаКоэффРаздела.КоэффСтоимМатериалов * ?(Раздел.КоэффПолнСтоимРабот=0,1,Раздел.КоэффПолнСтоимРабот));
					СтрокаКоэффРаздела.КоэффСтоимЭксплМашин = 		?(ПоЭлементам, СтрокаКоэффРаздела.КоэффСтоимЭксплМашин * ?(Раздел.КоэффСтоимЭксплМашин=0,1,Раздел.КоэффСтоимЭксплМашин),
																	СтрокаКоэффРаздела.КоэффСтоимЭксплМашин * ?(Раздел.КоэффПолнСтоимРабот=0,1,Раздел.КоэффПолнСтоимРабот));
					СтрокаКоэффРаздела.КоэффОборуд = 				?(ПоЭлементам, СтрокаКоэффРаздела.КоэффОборуд * ?(Раздел.КоэффОборуд=0,1,Раздел.КоэффОборуд),
																	СтрокаКоэффРаздела.КоэффОборуд * ?(Раздел.КоэффПолнСтоимРабот=0,1,Раздел.КоэффПолнСтоимРабот));
				КонецЕсли;
				Раздел = Раздел.ИДРодителя;
			КонецЦикла;
			Если КоэффРаздела.Количество() > 0 Тогда
				// Сохраним индексы на всякий случай.
				СтрокаКоэффРаздела = КоэффРаздела[0];
			    Индексы.ОЗ = СтрокаКоэффРаздела.КоэффОснЗарплаты; 
				Индексы.ЭМ = СтрокаКоэффРаздела.КоэффСтоимЭксплМашин;
				Индексы.ЗМ = СтрокаКоэффРаздела.КоэффСтоимЗарплатеМашин;
				Индексы.СМ = СтрокаКоэффРаздела.КоэффСтоимМатериалов;
				Индексы.ПЗ = СтрокаКоэффРаздела.КоэффПолнСтоимРабот;
				Индексы.ОБ = СтрокаКоэффРаздела.КоэффОборуд;
			КонецЕсли;

			
			ЗапросСтоимости.УстановитьПараметр("КоэффРаздела",КоэффРаздела);
			ТекстЗапроса = "ВЫБРАТЬ
			|	КоэффРаздела.КоэффОснЗарплаты,
			|	КоэффРаздела.КоэффПолнСтоимРабот,
			|	КоэффРаздела.КоэффСтоимЗарплатеМашин,
			|	КоэффРаздела.КоэффСтоимМатериалов,
			|	КоэффРаздела.КоэффСтоимЭксплМашин,
			|	КоэффРаздела.КоэффОборуд,
			|	КоэффРаздела.Смета,
			|	КоэффРаздела.Позиция,
			|	КоэффРаздела.Раздел
			|ПОМЕСТИТЬ Коэфф
			|ИЗ
			|	&КоэффРаздела КАК КоэффРаздела
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимОснЗарплата * Коэфф.КоэффОснЗарплаты КАК ОсновнаяЗарплата,
			|	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимЭксплМашин * Коэфф.КоэффСтоимЭксплМашин КАК ЭксплуатацияМашин,
			|	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимЗарплМашин * Коэфф.КоэффСтоимЗарплатеМашин КАК ЗарплатаМашинистов,
			|	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимСтоимМатер * Коэфф.КоэффСтоимМатериалов КАК СтоимостьМатериалов,
			|	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимВозвратМатер КАК ВозвратМатериалов,
			|	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета,
			|	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Раздел,
			|	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция,
			|	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимОснЗарплата * Коэфф.КоэффОснЗарплаты + СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимЭксплМашин * Коэфф.КоэффСтоимЭксплМашин + СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимСтоимМатер * Коэфф.КоэффСтоимМатериалов КАК ПрямыеЗатраты,
			|	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимОборуд * Коэфф.КоэффОборуд КАК СтоимостьОборудования
			|ПОМЕСТИТЬ СуммыСКоэфф
			|ИЗ
			|	РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП КАК СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Коэфф КАК Коэфф
			|		ПО СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета = Коэфф.Смета
			|			И СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция = Коэфф.Позиция
			|			И СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Раздел = Коэфф.Раздел
			|ГДЕ
			|	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета = &Смета
			|	И СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция = &Позиция
			|	И СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Раздел = &Раздел
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СуммыСКоэфф.Смета,
			|	СуммыСКоэфф.Раздел,
			|	СуммыСКоэфф.Позиция,
			|	ВЫБОР
			|		КОГДА СуммыСКоэфф.ПрямыеЗатраты = 0
			|				И СуммыСКоэфф.СтоимостьОборудования <> 0
			|			ТОГДА СуммыСКоэфф.СтоимостьОборудования
			|		ИНАЧЕ СуммыСКоэфф.ПрямыеЗатраты
			|	КОНЕЦ КАК ПрямыеЗатраты,
			|	СуммыСКоэфф.ОсновнаяЗарплата,
			|	СуммыСКоэфф.ЭксплуатацияМашин,
			|	СуммыСКоэфф.ЗарплатаМашинистов,
			|	СуммыСКоэфф.СтоимостьМатериалов,
			|	СуммыСКоэфф.ВозвратМатериалов
			|ИЗ
			|	СуммыСКоэфф КАК СуммыСКоэфф";
				
		ИначеЕсли Смета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета Тогда
			// БИ метод расчета, уровень смета по элементам затрат.
			Если Смета.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат Тогда
				ТекстЗапроса  = "ВЫБРАТЬ
                |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимОснЗарплата * ВЫБОР
                |		КОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффФОТ = 0
                |			ТОГДА 1
                |		ИНАЧЕ СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффФОТ
                |	КОНЕЦ КАК ОсновнаяЗарплата,
                |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимЭксплМашин * ВЫБОР
                |		КОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффСтоимЭксплМашин = 0
                |			ТОГДА 1
                |		ИНАЧЕ СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффСтоимЭксплМашин
                |	КОНЕЦ КАК ЭксплуатацияМашин,
                |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимЗарплМашин * ВЫБОР
                |		КОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффФОТ = 0
                |			ТОГДА 1
                |		ИНАЧЕ СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффФОТ
                |	КОНЕЦ КАК ЗарплатаМашинистов,
                |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимСтоимМатер * ВЫБОР
                |		КОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффСтоимМатериалов = 0
                |			ТОГДА 1
                |		ИНАЧЕ СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффСтоимМатериалов
                |	КОНЕЦ КАК СтоимостьМатериалов,
                |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимВозвратМатер КАК ВозвратМатериалов,
                |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета,
                |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Раздел,
                |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция,
                |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимОборуд * ВЫБОР
                |		КОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффОборуд = 0
                |			ТОГДА 1
                |		ИНАЧЕ СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффОборуд
                |	КОНЕЦ КАК СтоимостьОборудования
                |ПОМЕСТИТЬ СуммыСКоэфф
                |ИЗ
                |	РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП КАК СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета
                |ГДЕ
                |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета = &Смета
                |	И СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция = &Позиция
                |	И СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Раздел = &Раздел
                |;
                |
                |////////////////////////////////////////////////////////////////////////////////
                |ВЫБРАТЬ
                |	СуммыСКоэфф.Смета,
                |	СуммыСКоэфф.Раздел,
                |	СуммыСКоэфф.Позиция,
                |	СуммыСКоэфф.ОсновнаяЗарплата,
                |	СуммыСКоэфф.ЭксплуатацияМашин,
                |	СуммыСКоэфф.ЗарплатаМашинистов,
                |	СуммыСКоэфф.СтоимостьМатериалов,
                |	СуммыСКоэфф.ВозвратМатериалов,
                |	ВЫБОР
                |		КОГДА СуммыСКоэфф.ОсновнаяЗарплата + СуммыСКоэфф.ЭксплуатацияМашин + СуммыСКоэфф.СтоимостьМатериалов = 0
                |			ТОГДА СуммыСКоэфф.СтоимостьОборудования
                |		ИНАЧЕ СуммыСКоэфф.ОсновнаяЗарплата + СуммыСКоэфф.ЭксплуатацияМашин + СуммыСКоэфф.СтоимостьМатериалов
                |	КОНЕЦ КАК ПрямыеЗатраты
                |ИЗ
                |	СуммыСКоэфф КАК СуммыСКоэфф";
				
				// Сохраним индексы на всякий случай.
				Если РасчетАкта Тогда
					Индексы.ОЗ = Акт.КоэффФОТ; 
					Индексы.ЭМ = Акт.КоэффСтоимЭксплМашин;
					Индексы.ЗМ = Акт.КоэффФОТ;
					Индексы.СМ = Акт.КоэффСтоимМатериалов;
					Индексы.ПЗ = Акт.КоэффПолнСтоимРабот;
					Индексы.ОБ = Акт.КоэффОборуд;
				Иначе
					Индексы.ОЗ = Смета.КоэффФОТ; 
					Индексы.ЭМ = Смета.КоэффСтоимЭксплМашин;
					Индексы.ЗМ = Смета.КоэффФОТ;
					Индексы.СМ = Смета.КоэффСтоимМатериалов;
					Индексы.ПЗ = Смета.КоэффПолнСтоимРабот;
					Индексы.ОБ = Смета.КоэффОборуд;
			    КонецЕсли;

			// БИ метод расчета, уровень смета к полной стоимости.
			Иначе
				ТекстЗапроса  = "ВЫБРАТЬ
	            |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимОснЗарплата * ВЫБОР
	            |		КОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффПолнСтоимРабот = 0
	            |			ТОГДА 1
	            |		ИНАЧЕ СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффПолнСтоимРабот
	            |	КОНЕЦ КАК ОсновнаяЗарплата,
	            |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимЭксплМашин * ВЫБОР
	            |		КОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффПолнСтоимРабот = 0
	            |			ТОГДА 1
	            |		ИНАЧЕ СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффПолнСтоимРабот
	            |	КОНЕЦ КАК ЭксплуатацияМашин,
	            |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимЗарплМашин * ВЫБОР
	            |		КОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффПолнСтоимРабот = 0
	            |			ТОГДА 1
	            |		ИНАЧЕ СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффПолнСтоимРабот
	            |	КОНЕЦ КАК ЗарплатаМашинистов,
	            |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимСтоимМатер * ВЫБОР
	            |		КОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффПолнСтоимРабот = 0
	            |			ТОГДА 1
	            |		ИНАЧЕ СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффПолнСтоимРабот
	            |	КОНЕЦ КАК СтоимостьМатериалов,
	            |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимВозвратМатер КАК ВозвратМатериалов,
	            |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета,
	            |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Раздел,
	            |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция,
	            |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимОборуд * ВЫБОР
	            |		КОГДА СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффПолнСтоимРабот = 0
	            |			ТОГДА 1
	            |		ИНАЧЕ СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета.КоэффПолнСтоимРабот
	            |	КОНЕЦ КАК СтоимостьОборудования
	            |ПОМЕСТИТЬ СуммыСКоэфф
	            |ИЗ
	            |	РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП КАК СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета
	            |ГДЕ
	            |	СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета = &Смета
	            |	И СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция = &Позиция
	            |	И СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Раздел = &Раздел
	            |;
	            |
	            |////////////////////////////////////////////////////////////////////////////////
	            |ВЫБРАТЬ
	            |	СуммыСКоэфф.Смета,
	            |	СуммыСКоэфф.Раздел,
	            |	СуммыСКоэфф.Позиция,
	            |	СуммыСКоэфф.ОсновнаяЗарплата,
	            |	СуммыСКоэфф.ЭксплуатацияМашин,
	            |	СуммыСКоэфф.ЗарплатаМашинистов,
	            |	СуммыСКоэфф.СтоимостьМатериалов,
	            |	СуммыСКоэфф.ВозвратМатериалов,
	            |	ВЫБОР
	            |		КОГДА СуммыСКоэфф.ОсновнаяЗарплата + СуммыСКоэфф.ЭксплуатацияМашин + СуммыСКоэфф.СтоимостьМатериалов = 0
	            |			ТОГДА СуммыСКоэфф.СтоимостьОборудования
	            |		ИНАЧЕ СуммыСКоэфф.ОсновнаяЗарплата + СуммыСКоэфф.ЭксплуатацияМашин + СуммыСКоэфф.СтоимостьМатериалов
	            |	КОНЕЦ КАК ПрямыеЗатраты
	            |ИЗ
	            |	СуммыСКоэфф КАК СуммыСКоэфф";
				
				// Сохраним индексы на всякий случай.
				Если РасчетАкта Тогда
					Индексы.ОЗ = Акт.КоэффПолнСтоимРабот; 
					Индексы.ЭМ = Акт.КоэффПолнСтоимРабот;
					Индексы.ЗМ = Акт.КоэффПолнСтоимРабот;
					Индексы.СМ = Акт.КоэффПолнСтоимРабот;
					Индексы.ПЗ = Акт.КоэффПолнСтоимРабот;
					Индексы.ОБ = Акт.КоэффПолнСтоимРабот;
				Иначе
					Индексы.ОЗ = Смета.КоэффПолнСтоимРабот; 
					Индексы.ЭМ = Смета.КоэффПолнСтоимРабот;
					Индексы.ЗМ = Смета.КоэффПолнСтоимРабот;
					Индексы.СМ = Смета.КоэффПолнСтоимРабот;
					Индексы.ПЗ = Смета.КоэффПолнСтоимРабот;
					Индексы.ОБ = Смета.КоэффПолнСтоимРабот;
			    КонецЕсли;

			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ТекстЗапроса = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Невозможно записать среднюю стоимость позиции'"));
		Возврат;
	КонецЕсли;
	
	ЗапросСтоимости.Текст = ТекстЗапроса;
	Выборка = ЗапросСтоимости.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		СтрокаНабора = Новый Структура();
		СтрокаНабора.Вставить("Позиция",СтруктураПараметровОтбораРС.СсылкаНаПозицию);
		СтрокаНабора.Вставить("Раздел",СтруктураПараметровОтбораРС.СсылкаНаРаздел);
		СтрокаНабора.Вставить("Смета",СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
		СтрокаНабора.Вставить("ОбъемРабот",Объект.ОбъемРабот);
		СтрокаНабора.Вставить("ПрямыеЗатраты",		Окр(Объект.ОбъемРабот*	Выборка.ПрямыеЗатраты,КолЗнаков));
		СтрокаНабора.Вставить("ОсновнаяЗарплата",	Окр(Объект.ОбъемРабот*	Выборка.ОсновнаяЗарплата,КолЗнаков));
		СтрокаНабора.Вставить("ЭксплуатацияМашин",	Окр(Объект.ОбъемРабот*	Выборка.ЭксплуатацияМашин,КолЗнаков));
		СтрокаНабора.Вставить("ЗарплатаМашинистов",	Окр(Объект.ОбъемРабот*	Выборка.ЗарплатаМашинистов,КолЗнаков));
		СтрокаНабора.Вставить("СтоимостьМатериалов",Окр(Объект.ОбъемРабот*	Выборка.СтоимостьМатериалов,КолЗнаков));
		СтрокаНабора.Вставить("ВозвратМатериалов",	Окр(Объект.ОбъемРабот*	Выборка.ВозвратМатериалов,КолЗнаков));
		СтрокаНабора.Вставить("НакладныеРасходы",0);
		СтрокаНабора.Вставить("СметнаяПрибыль",0);
		СтрокаНабора.Вставить("Стоимость",0);
		СтрокаНабора.Вставить("ЕдиницаИзмерения",0);

		ЗапросНРиСП = Новый Запрос;
		ЗапросНРиСП.Текст = "ВЫБРАТЬ
							|	ВЫБОР
							|		КОГДА СМ_НРиСП.ТекСуммаНРНаОбъем + СМ_НРиСП.ТекСуммаСПНаОбъем = 0
							|			ТОГДА СМ_НРиСП.СуммаНРНаОбъем
							|		ИНАЧЕ СМ_НРиСП.ТекСуммаНРНаОбъем
							|	КОНЕЦ КАК НакладныеРасходы,
							|	ВЫБОР
							|		КОГДА СМ_НРиСП.ТекСуммаНРНаОбъем + СМ_НРиСП.ТекСуммаСПНаОбъем = 0
							|			ТОГДА СМ_НРиСП.СуммаСПНаОбъем
							|		ИНАЧЕ СМ_НРиСП.ТекСуммаСПНаОбъем
							|	КОНЕЦ КАК СметнаяПрибыль
							|ИЗ
							|	РегистрСведений.СМ_НРиСП КАК СМ_НРиСП
							|ГДЕ
							|	СМ_НРиСП.Смета = &Смета
							|	И СМ_НРиСП.Раздел = &Раздел
							|	И СМ_НРиСП.Позиция = &Позиция";
		ЗапросНРиСП.УстановитьПараметр("Смета", СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
		ЗапросНРиСП.УстановитьПараметр("Раздел", СтруктураПараметровОтбораРС.СсылкаНаРаздел);
		ЗапросНРиСП.УстановитьПараметр("Позиция", СтруктураПараметровОтбораРС.СсылкаНаПозицию);
		ВыборкаНРиСП = ЗапросНРиСП.Выполнить().Выбрать();
		Если ВыборкаНРиСП.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(СтрокаНабора, ВыборкаНРиСП);
		КонецЕсли;
		
		СтрокаНабора.ЕдиницаИзмерения = Объект.ЕдиницаИзмерения;
		СтрокаНабора.Стоимость = СтрокаНабора.НакладныеРасходы + СтрокаНабора.СметнаяПрибыль + СтрокаНабора.ПрямыеЗатраты;
		
		Отбор = Новый Структура();
		Отбор.Вставить("Позиция",СтруктураПараметровОтбораРС.СсылкаНаПозицию);
		Отбор.Вставить("Раздел",СтруктураПараметровОтбораРС.СсылкаНаРаздел);
		Отбор.Вставить("Смета",СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
		СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНабор("СМ_СредняяТекущаяСтоимостьПозиции",Отбор,СтрокаНабора);

	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Невозможно записать среднюю стоимость позиции'"));
		
	КонецЕсли;
	
	// Разберемся со стоимостью ресурсов.
	Если Не РасчетАкта Тогда
		ЗапросРесурсы 		= Новый Запрос;
		ЗапросРесурсы.Текст = "
		|ВЫБРАТЬ
		|	РесурсыПозицииЛокальнойСметы.Ресурс,
		|	РесурсыПозицииЛокальнойСметы.БазиснаяЦена,
		|	РесурсыПозицииЛокальнойСметы.БазиснаяЗарплатаМашинистов,
		|	РесурсыПозицииЛокальнойСметы.ТекущаяЦена,
		|	РесурсыПозицииЛокальнойСметы.ТекущаяЗарплатаМашинистов,
		|	РесурсыПозицииЛокальнойСметы.НаименованиеРесурса
		|ПОМЕСТИТЬ РесурсыПозиции
		|ИЗ
		|	&РесурсыПозицииЛокальнойСметы КАК РесурсыПозицииЛокальнойСметы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СМ_СтоимостьРесурсовПозиции.Смета,
		|	СМ_СтоимостьРесурсовПозиции.Раздел,
		|	СМ_СтоимостьРесурсовПозиции.Позиция,
		|	СМ_СтоимостьРесурсовПозиции.Ресурс,
		|	СМ_СтоимостьРесурсовПозиции.Количество,
		|	РесурсыПозиции.БазиснаяЦена КАК БазиснаяЦена,
		|	РесурсыПозиции.БазиснаяЗарплатаМашинистов КАК БазиснаяЗарплатаМашинистов,
		|	РесурсыПозиции.ТекущаяЦена КАК ТекущаяЦена,
		|	РесурсыПозиции.ТекущаяЗарплатаМашинистов КАК ЗарплатаМашинистов,
		|	СМ_СтоимостьРесурсовПозиции.Ресурс.ВидРесурса КАК ВидРесурса,
		|	СМ_СтоимостьРесурсовПозиции.Ресурс.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	СМ_СтоимостьРесурсовПозиции.НаименованиеРесурса
		|ИЗ
		|	РегистрСведений.СМ_СтоимостьРесурсовПозиции КАК СМ_СтоимостьРесурсовПозиции
		// ************************************
		// ++ AV 
		//	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РесурсыПозиции КАК РесурсыПозиции
		//	|	ПО СМ_СтоимостьРесурсовПозиции.Ресурс = РесурсыПозиции.Ресурс
		//	|	 И СМ_СтоимостьРесурсовПозиции.НаименованиеРесурса = РесурсыПозиции.НаименованиеРесурса
		|	ЛЕВОЕ СОЕДИНЕНИЕ РесурсыПозиции КАК РесурсыПозиции
		|	ПО СМ_СтоимостьРесурсовПозиции.Ресурс = РесурсыПозиции.Ресурс И
		|	   СМ_СтоимостьРесурсовПозиции.Ресурс.Наименование = РесурсыПозиции.НаименованиеРесурса
		// -- AV 
		// ************************************
		|ГДЕ
		|	СМ_СтоимостьРесурсовПозиции.Смета = &Смета
		|	И СМ_СтоимостьРесурсовПозиции.Раздел = &Раздел
		|	И СМ_СтоимостьРесурсовПозиции.Позиция = &Позиция";
		
		ТаблицаРесурсов = Объект.РесурсыПозицииЛокальнойСметы.Выгрузить(,"НаименованиеРесурса,Ресурс,ВидРесурса,ЕдиницаИзмеренияРесурса,БазиснаяЦена,БазиснаяЗарплатаМашинистов,ТекущаяЦена,ТекущаяЗарплатаМашинистов");
		
		ЗапросРесурсы.УстановитьПараметр("Смета", СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
		ЗапросРесурсы.УстановитьПараметр("Раздел", СтруктураПараметровОтбораРС.СсылкаНаРаздел);
		ЗапросРесурсы.УстановитьПараметр("Позиция", СтруктураПараметровОтбораРС.СсылкаНаПозицию);
		ЗапросРесурсы.УстановитьПараметр("РесурсыПозицииЛокальнойСметы", ТаблицаРесурсов);
		ТаблицаРесурсовПозиции = ЗапросРесурсы.Выполнить().Выгрузить();
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Ресурс",Справочники.СМ_Ресурсы.ПустаяСсылка());
		ТаблицаПустыхРесурсов = ТаблицаРесурсов.Скопировать(СтруктураОтбора);
		
		Для Каждого СведенияОРесурсе Из ТаблицаРесурсовПозиции Цикл
			
			Если СведенияОРесурсе.Ресурс = Справочники.СМ_Ресурсы.ПустаяСсылка() Тогда
				Для Каждого ТекСтрокаРесурса Из ТаблицаПустыхРесурсов Цикл
					Если СтрЧислоВхождений(СведенияОРесурсе.НаименованиеРесурса,ТекСтрокаРесурса.НаименованиеРесурса) > 0 Тогда
						СведенияОРесурсе.БазиснаяЦена    			= ТекСтрокаРесурса.БазиснаяЦена;
						СведенияОРесурсе.БазиснаяЗарплатаМашинистов = ТекСтрокаРесурса.БазиснаяЗарплатаМашинистов;
						СведенияОРесурсе.ТекущаяЦена                = ТекСтрокаРесурса.ТекущаяЦена;
						СведенияОРесурсе.ЗарплатаМашинистов  		= ТекСтрокаРесурса.ТекущаяЗарплатаМашинистов;
						
						Если НЕ ЗначениеЗаполнено(СведенияОРесурсе.ВидРесурса) Тогда
							СведенияОРесурсе.ВидРесурса = ТекСтрокаРесурса.ВидРесурса;		
						КонецЕсли;
							
						Если НЕ ЗначениеЗаполнено(СведенияОРесурсе.ЕдиницаИзмерения) Тогда
							СведенияОРесурсе.ЕдиницаИзмерения = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСтроке(ТекСтрокаРесурса.ЕдиницаИзмеренияРесурса);
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если СведенияОРесурсе.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
				Индекс = Индексы.ЭМ;
			ИначеЕсли СведенияОРесурсе.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
				Индекс = Индексы.ОЗ;
			ИначеЕсли СведенияОРесурсе.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда
				Индекс = Индексы.ЗМ;
			Иначе
				Индекс = Индексы.СМ;
			КонецЕсли;
			
			Если ((СведенияОРесурсе.ТекущаяЦена=0)и(СведенияОРесурсе.БазиснаяЦена<>0)) Тогда
				СведенияОРесурсе.ТекущаяЦена = СведенияОРесурсе.БазиснаяЦена * ?(Индекс=0,1,Индекс);
			КонецЕсли;
			
			Если СведенияОРесурсе.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
				Если ((СведенияОРесурсе.ЗарплатаМашинистов=0)и(СведенияОРесурсе.БазиснаяЗарплатаМашинистов<>0)) Тогда
					СведенияОРесурсе.ЗарплатаМашинистов = СведенияОРесурсе.БазиснаяЗарплатаМашинистов * ?(Индексы.ЗМ=0,1,Индексы.ЗМ);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;	
		
		ТаблицаРесурсовПозиции.Колонки.Удалить("ВидРесурса");
		ТаблицаРесурсовПозиции.Колонки.Удалить("БазиснаяЦена");
		ТаблицаРесурсовПозиции.Колонки.Удалить("БазиснаяЗарплатаМашинистов");
		
	Иначе
		
		МассивСтрокРесурсовПозицииАкта = СМ_СметаВызовСервера.МассивСтрокРесурсовПозицииАкта(СтруктураПараметровОтбораРС.СсылкаНаАкт, Объект);
		ТаблицаРесурсовПозиции = Новый ТаблицаЗначений;
		ТаблицаРесурсовПозиции.Колонки.Добавить("Смета");
		ТаблицаРесурсовПозиции.Колонки.Добавить("Раздел");
		ТаблицаРесурсовПозиции.Колонки.Добавить("Позиция");
		ТаблицаРесурсовПозиции.Колонки.Добавить("Ресурс");
		ТаблицаРесурсовПозиции.Колонки.Добавить("НаименованиеРесурса");
		ТаблицаРесурсовПозиции.Колонки.Добавить("Количество");
		ТаблицаРесурсовПозиции.Колонки.Добавить("ТекущаяЦена");
		ТаблицаРесурсовПозиции.Колонки.Добавить("ЗарплатаМашинистов");
		ТаблицаРесурсовПозиции.Колонки.Добавить("ЕдиницаИзмерения");
		Для Каждого СтрокаРесурса Из МассивСтрокРесурсовПозицииАкта Цикл
			НоваяСтрока = ТаблицаРесурсовПозиции.Добавить();
			НоваяСтрока.Смета = СтруктураПараметровОтбораРС.СсылкаНаАкт;
			НоваяСтрока.Раздел = СтруктураПараметровОтбораРС.СсылкаНаРаздел;
			НоваяСтрока.Позиция = СтруктураПараметровОтбораРС.СсылкаНаПозицию;
			НоваяСтрока.Ресурс = СтрокаРесурса.Ресурс;
			НоваяСтрока.НаименованиеРесурса = Строка(СтрокаРесурса.НомерСтроки)+" "+СтрокаРесурса.НаименованиеРесурса;
			НоваяСтрока.Количество = СтрокаРесурса.ФактРасходаОбъем;
			НоваяСтрока.ТекущаяЦена = СтрокаРесурса.ТекущаяЦена;
			НоваяСтрока.ЗарплатаМашинистов = СтрокаРесурса.ТекущаяЗарплатаМашинистов;
			НоваяСтрока.ЕдиницаИзмерения = СтрокаРесурса.Ресурс.ЕдиницаИзмерения
		КонецЦикла;
		
	КонецЕсли;
	
	Отбор = Новый Структура();
	Отбор.Вставить("Позиция",СтруктураПараметровОтбораРС.СсылкаНаПозицию);
	Отбор.Вставить("Раздел",СтруктураПараметровОтбораРС.СсылкаНаРаздел);
	Отбор.Вставить("Смета",СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
	СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНаборТаблицей("СМ_СредняяТекущаяСтоимостьРесурсовПозиции",Отбор,ТаблицаРесурсовПозиции);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область РасчетПозиции

// Процедура выполняет непосредственный расчет числовых параметров позиции локальной сметы и запись в регистр сведений.
//
Функция РасчетЧП(Позиция, СтруктураДанныхРасчета, ЛС, ТаблСПоправками, ТаблРасчета, РесурсныйРасчет, ПромОкр = Ложь, ОкрИтог = Ложь, ОбрабПогр = Неопределено, Акт = Неопределено, СтруктураПараметровОтбораРС = Неопределено, ИспользоватьРС = Ложь)
	
	УчитыватьДопЗМ = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета", "УчитыватьДопЗМ", Ложь); // Значение по умолчанию (есди настройки не сохранялись).	
	
	Если СтруктураПараметровОтбораРС = Неопределено Тогда
		СтруктураПараметровОтбораРС = СМ_СметаВызовСервера.ПолучитьСтруктуруДанныхДляОтборовРегистра(Позиция, Акт, "СМ_ПозицияЛокальнойСметы");
	КонецЕсли;
	
	// 1. Итоги по разделу.
	НаборЗаписей = Справочники.СМ_ИтогиЧППоРазделу.Выбрать();
	Пока НаборЗаписей.Следующий() Цикл
		Если НЕ Позиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование 
			И (НаборЗаписей.Ссылка.Идентификатор = "Оборуд"
			ИЛИ НаборЗаписей.Ссылка.Идентификатор = "СЗапЧастями"
		ИЛИ НаборЗаписей.Ссылка.Идентификатор = "ТранспРасхНаТонну"
			ИЛИ НаборЗаписей.Ссылка.Идентификатор = "ТараУпаковка"
			ИЛИ НаборЗаписей.Ссылка.Идентификатор = "СТаройУпаковкой"
			ИЛИ НаборЗаписей.Ссылка.Идентификатор = "ВсегоПоРазделуОборуд") Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРасчета 		= ТаблРасчета.Добавить();
		СтрокаРасчета.Итог 	= НаборЗаписей.Ссылка;
		Если НаборЗаписей.Накопительный Тогда
			ЗаполнитьЗначенияСвойств(СтрокаРасчета,ТаблСПоправками[0]);	
		КонецЕсли;
	КонецЦикла;
	
	// Добавка к зарплате машинистов с поправками и ЗУ.
	НачальноеДопЗМ = ТаблСПоправками[0].ДопЗМ; 
	НачальноеДопЗМТек = ТаблСПоправками[0].ДопЗМТек; 
	
	// 2. Числовые параметры. 
	// Применяются для значений параметров отличных от значений по умолчанию.
	// Сортировка по порядку расчета.
	ЧислПарамДляРасчета = Позиция.НачисленияПозиции.Выгрузить();
	ЧислПарамДляРасчета.Очистить();
	ЧислПарамДляРасчета.Колонки.Добавить("Порядок");
	Для Каждого СтрокаНачисления Из Позиция.НачисленияПозиции Цикл
		Если НЕ СтрокаНачисления.Значение = СтрокаНачисления.ЧисловойПараметр.СтандартноеЗначение Тогда
			СтрокаПарам = ЧислПарамДляРасчета.Добавить();	
			ЗаполнитьЗначенияСвойств(СтрокаПарам,СтрокаНачисления);
			СтрокаПарам.Порядок = СтрокаНачисления.ЧисловойПараметр.ПорядокРасчета;
		КонецЕсли
	КонецЦикла;
	ЧислПарамДляРасчета.Сортировать("Порядок");
	
	// 3. Расчет числовых параметров.
	// Соответсвие поля числового параметра "Источник.ОтЧего" с элементом справочника "СМ_ИтогиЧППоРазделу".
	Для Каждого СтрокаЧислПарам Из ЧислПарамДляРасчета Цикл
	  	
		ОтИтога 		= ТаблРасчета.Найти(СтрокаЧислПарам.ЧисловойПараметр.Источник[0].ОтЧего);
		ФлагИсточника 	= СтрокаЧислПарам.ЧисловойПараметр.Источник[0];
		
		// Для базисно-индексного метода.
		ДобПарамПЗ 	= 0;
		ДобПарамОЗ 	= 0;
		ДобПарамЭМ 	= 0;
		ДобПарамЗМ 	= 0;
		ДобПарамСМ 	= 0;
		ДобПарамОБ	= 0;
		ДобПарамТР 	= 0;
		ДобПарамТМ 	= 0;
		ДобПарамБР 	= 0;
		ДобДопЗМ	= 0;
		ТекДобДопЗМ	= 0;
		
		// Для ресурсного метода.
		// Поправки должны считаться для ресурсного метода от составляющих прямых затрат в текущих ценах.
		ТекДобПарамПЗ 	= 0;
		ТекДобПарамОЗ 	= 0;
		ТекДобПарамЭМ 	= 0;
		ТекДобПарамЗМ 	= 0;
		ТекДобПарамСМ 	= 0;
		ТекДобПарамОБ	= 0;
		ТекДобПарамБР 	= 0;
		
		// Если в числовом параметре в источнике стоит флаг напротив одноименного элемента затрат,
		// то параметры суммируются.
		Если СтрокаЧислПарам.ЧисловойПараметр.Источник[0].ПрямЗатраты Тогда
			ДобПарамПЗ 		= ДобПарамПЗ + ОтИтога.СтоимПрямЗатраты;	
			ТекДобПарамПЗ 	= ТекДобПарамПЗ + ОтИтога.ТекСтоимПрямЗатраты;	
		КонецЕсли;
		
		Если СтрокаЧислПарам.ЧисловойПараметр.Источник[0].ОснЗарплата Тогда
			ДобПарамОЗ 		= ДобПарамОЗ + ОтИтога.СтоимОснЗарплата;	
			ТекДобПарамОЗ 	= ТекДобПарамОЗ + ОтИтога.ТекСтоимОснЗарплата;	
		КонецЕсли;
		
		Если СтрокаЧислПарам.ЧисловойПараметр.Источник[0].ЭксплМашин Тогда
			ДобПарамЭМ 		= ДобПарамЭМ + ОтИтога.СтоимЭксплМашин;	
			ТекДобПарамЭМ 	= ТекДобПарамЭМ + ОтИтога.ТекСтоимЭксплМашин;	
		КонецЕсли;
		
		Если СтрокаЧислПарам.ЧисловойПараметр.Источник[0].ЗарплМашинистов Тогда
			ДобПарамЗМ 		= ДобПарамЗМ + ОтИтога.СтоимЗарплМашин;	
			ТекДобПарамЗМ 	= ТекДобПарамЗМ + ОтИтога.ТекСтоимЗарплМашин;	
		КонецЕсли;
		
		// Если расчет ЧП только от ЗПМ, (источник ЭМ не задан), расчет ДопЗМ.
		Если УчитыватьДопЗМ Тогда
			Если СтрокаЧислПарам.ЧисловойПараметр.Источник[0].ЗарплМашинистов
				И Не СтрокаЧислПарам.ЧисловойПараметр.Источник[0].ЭксплМашин Тогда
				ДобДопЗМ 		= ДобДопЗМ + ОтИтога.СтоимЗарплМашин;	
				ТекДобДопЗМ 	= ТекДобДопЗМ + ОтИтога.ТекСтоимЗарплМашин;	
			КонецЕсли;	
		КонецЕсли;
		 
		Если СтрокаЧислПарам.ЧисловойПараметр.Источник[0].СтоимМатериалов Тогда
			ДобПарамСМ 		= ДобПарамСМ + ОтИтога.СтоимСтоимМатер;	
			ТекДобПарамСМ 	= ТекДобПарамСМ + ОтИтога.ТекСтоимСтоимМатер;	
		КонецЕсли;
		
		Если СтрокаЧислПарам.ЧисловойПараметр.Источник[0].Оборудование Тогда
			ДобПарамОБ 		= ДобПарамОБ + ОтИтога.СтоимОборуд;	
			ТекДобПарамОБ 	= ТекДобПарамОБ + ОтИтога.ТекСтоимОборуд;	
		КонецЕсли;
		
		Если СтрокаЧислПарам.ЧисловойПараметр.Источник[0].ЗатратыТрудаРабочих Тогда
			ДобПарамТР 	= ДобПарамТР + ОтИтога.ЗатратыТрудаРабочих;	
		КонецЕсли;
		
		Если СтрокаЧислПарам.ЧисловойПараметр.Источник[0].ЗатратыТрудаМашинистов Тогда
			ДобПарамТМ 	= ДобПарамТМ + ОтИтога.ЗатратыТрудаМашин;	
		КонецЕсли;
		
		Если СтрокаЧислПарам.ЧисловойПараметр.Источник[0].МассаБрутто Тогда
			ДобПарамБР 	= ДобПарамБР + ОтИтога.МассаБрутто;	
		КонецЕсли;
		
		Если СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Сумма Тогда
			ДобПарамОБ 	= ДобПарамОБ * СтрокаЧислПарам.Значение;	
			ДобПарамТР 	= ДобПарамТР * СтрокаЧислПарам.Значение;	
			ДобПарамТМ 	= ДобПарамТМ * СтрокаЧислПарам.Значение;	
			ДобПарамПЗ 	= ДобПарамПЗ * СтрокаЧислПарам.Значение;	
			ДобПарамОЗ 	= ДобПарамОЗ * СтрокаЧислПарам.Значение;	
			ДобПарамЭМ 	= ДобПарамЭМ * СтрокаЧислПарам.Значение;	
			ДобПарамЗМ 	= ДобПарамЗМ * СтрокаЧислПарам.Значение;	
			ДобПарамСМ 	= ДобПарамСМ * СтрокаЧислПарам.Значение;	
			ДобПарамБР 	= ДобПарамБР * СтрокаЧислПарам.Значение;	
			
			ТекДобПарамОБ 	= ТекДобПарамОБ * СтрокаЧислПарам.Значение;	
			ТекДобПарамПЗ 	= ТекДобПарамПЗ * СтрокаЧислПарам.Значение;	
			ТекДобПарамОЗ 	= ТекДобПарамОЗ * СтрокаЧислПарам.Значение;	
			ТекДобПарамЭМ 	= ТекДобПарамЭМ * СтрокаЧислПарам.Значение;	
			ТекДобПарамЗМ 	= ТекДобПарамЗМ * СтрокаЧислПарам.Значение;	
			ТекДобПарамСМ 	= ТекДобПарамСМ * СтрокаЧислПарам.Значение;	
			ТекДобПарамБР 	= ТекДобПарамБР * СтрокаЧислПарам.Значение;	
			
		Иначе	
			
			ДобПарамОБ 	= ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ДобПарамОБ * СтрокаЧислПарам.Значение/100,ДобПарамОБ * (СтрокаЧислПарам.Значение-1));	
			ДобПарамТР 	= ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ДобПарамТР * СтрокаЧислПарам.Значение/100,ДобПарамТР * (СтрокаЧислПарам.Значение-1));	
			ДобПарамТМ 	= ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ДобПарамТМ * СтрокаЧислПарам.Значение/100,ДобПарамТМ * (СтрокаЧислПарам.Значение-1));	
			ДобПарамПЗ 	= ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ДобПарамПЗ * СтрокаЧислПарам.Значение/100,ДобПарамПЗ * (СтрокаЧислПарам.Значение-1));	
			ДобПарамОЗ 	= ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ДобПарамОЗ * СтрокаЧислПарам.Значение/100,ДобПарамОЗ * (СтрокаЧислПарам.Значение-1));	
			ДобПарамЭМ 	= ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ДобПарамЭМ * СтрокаЧислПарам.Значение/100,ДобПарамЭМ * (СтрокаЧислПарам.Значение-1));	
			ДобПарамЗМ 	= ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ДобПарамЗМ * СтрокаЧислПарам.Значение/100,ДобПарамЗМ * (СтрокаЧислПарам.Значение-1));	
			ДобПарамСМ 	= ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ДобПарамСМ * СтрокаЧислПарам.Значение/100,ДобПарамСМ * (СтрокаЧислПарам.Значение-1));	
			ДобПарамБР 	= ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ДобПарамСМ * СтрокаЧислПарам.Значение/100,ДобПарамСМ * (СтрокаЧислПарам.Значение-1));	
			
			ТекДобПарамОБ 	= ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ТекДобПарамОБ * СтрокаЧислПарам.Значение/100,ТекДобПарамОБ * (СтрокаЧислПарам.Значение-1));	
			ТекДобПарамПЗ 	= ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ТекДобПарамПЗ * СтрокаЧислПарам.Значение/100,ТекДобПарамПЗ * (СтрокаЧислПарам.Значение-1));	
			ТекДобПарамОЗ 	= ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ТекДобПарамОЗ * СтрокаЧислПарам.Значение/100,ТекДобПарамОЗ * (СтрокаЧислПарам.Значение-1));	
			ТекДобПарамЭМ 	= ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ТекДобПарамЭМ * СтрокаЧислПарам.Значение/100,ТекДобПарамЭМ * (СтрокаЧислПарам.Значение-1));	
			ТекДобПарамЗМ 	= ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ТекДобПарамЗМ * СтрокаЧислПарам.Значение/100,ТекДобПарамЗМ * (СтрокаЧислПарам.Значение-1));	
			ТекДобПарамСМ 	= ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ТекДобПарамСМ * СтрокаЧислПарам.Значение/100,ТекДобПарамСМ * (СтрокаЧислПарам.Значение-1));	
			ТекДобПарамБР 	= ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ТекДобПарамСМ * СтрокаЧислПарам.Значение/100,ТекДобПарамСМ * (СтрокаЧислПарам.Значение-1));	
			                      
			// Добавки за счет ЗПМ.			
			ДобДопЗМ = ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ДобДопЗМ * СтрокаЧислПарам.Значение/100,ДобДопЗМ * (СтрокаЧислПарам.Значение-1));	
			ТекДобДопЗМ = ?(СтрокаЧислПарам.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент,ТекДобДопЗМ * СтрокаЧислПарам.Значение/100,ТекДобДопЗМ * (СтрокаЧислПарам.Значение-1));	
			
		КонецЕсли;

		Если ПромОкр Тогда
			ДобПарамОБ 	= Окр(ДобПарамОБ,2);
			ДобПарамТР 	= Окр(ДобПарамТР,2);
			ДобПарамТМ 	= Окр(ДобПарамТМ,2);
			ДобПарамПЗ 	= Окр(ДобПарамПЗ,2);
			ДобПарамОЗ 	= Окр(ДобПарамОЗ,2);
			ДобПарамЭМ 	= Окр(ДобПарамЭМ,2);
			ДобПарамЗМ 	= Окр(ДобПарамЗМ,2);
			ДобПарамСМ 	= Окр(ДобПарамСМ,2);
			ДобПарамБР 	= Окр(ДобПарамБР,2);
			ДобДопЗМ	= Окр(ДобДопЗМ,2);
			ТекДобПарамОБ 	= Окр(ТекДобПарамОБ,2);
			ТекДобПарамПЗ 	= Окр(ТекДобПарамПЗ,2);
			ТекДобПарамОЗ 	= Окр(ТекДобПарамОЗ,2);
			ТекДобПарамЭМ 	= Окр(ТекДобПарамЭМ,2);
			ТекДобПарамЗМ 	= Окр(ТекДобПарамЗМ,2);
			ТекДобПарамСМ 	= Окр(ТекДобПарамСМ,2);
			ТекДобПарамБР 	= Окр(ТекДобПарамБР,2);
	     	ТекДобДопЗМ		= Окр(ТекДобДопЗМ,2);

		КонецЕсли;
		
		// Суммирование стоимости добавки по элементам табличной части "Приемник", значение"К чему" числового параметра,
		// в соответствующие колонки таблицы разчета.
		Для Каждого СтрокаКИтогу Из СтрокаЧислПарам.ЧисловойПараметр.Приемник Цикл
			
			ПрямоеНачисление 	= ОпределитьСоотвИстПрием(СтрокаЧислПарам.ЧисловойПараметр.Источник[0],СтрокаКИтогу);
			КИтогу 				= ТаблРасчета.Найти(СтрокаКИтогу.КЧему);
			ДобавПЗ = 0;
			ТекДобавПЗ = 0;
			Если ПрямоеНачисление  Тогда
				// Прямое начисление это соответствие флагов у составляющих прямых затрат источника и приемника. 				
				Если СтрокаКИтогу.ПрямЗатраты Тогда
					КИтогу.СтоимПрямЗатраты 	= КИтогу.СтоимПрямЗатраты + ДобПарамОЗ + ДобПарамЭМ + ДобПарамСМ; 	
					КИтогу.ТекСтоимПрямЗатраты 	= КИтогу.ТекСтоимПрямЗатраты + ТекДобПарамОЗ + ТекДобПарамЭМ + ТекДобПарамСМ;
				КонецЕсли;
				
				Если СтрокаКИтогу.ОснЗарплата Тогда
					КИтогу.СтоимОснЗарплата 	= КИтогу.СтоимОснЗарплата + ДобПарамОЗ;
					КИтогу.ТекСтоимОснЗарплата 	= КИтогу.ТекСтоимОснЗарплата + ТекДобПарамОЗ;
				КонецЕсли;
				
				Если СтрокаКИтогу.ЭксплМашин Тогда
					КИтогу.СтоимЭксплМашин 		= КИтогу.СтоимЭксплМашин + ДобПарамЭМ; 	
					КИтогу.ТекСтоимЭксплМашин 	= КИтогу.ТекСтоимЭксплМашин + ТекДобПарамЭМ; 
				КонецЕсли;
				Если СтрокаКИтогу.ЗарплМашинистов Тогда
					КИтогу.СтоимЗарплМашин 		= КИтогу.СтоимЗарплМашин + ДобПарамЗМ; 	
					КИтогу.ТекСтоимЗарплМашин 	= КИтогу.ТекСтоимЗарплМашин + ТекДобПарамЗМ; 
				КонецЕсли;
				// Расчет ДопЗм.
				Если УчитыватьДопЗМ Тогда
					Если СтрокаКИтогу.ЗарплМашинистов Тогда
						КИтогу.СтоимЗарплМашин 		= КИтогу.СтоимЗарплМашин + (ДобДопЗМ - НачальноеДопЗМ ); 	
						КИтогу.ТекСтоимЗарплМашин 	= КИтогу.ТекСтоимЗарплМашин + (ТекДобДопЗМ -НачальноеДопЗМТек); 
					КонецЕсли;
					
					Если СтрокаКИтогу.ЭксплМашин Тогда
						КИтогу.СтоимЭксплМашин 		= КИтогу.СтоимЭксплМашин + (ДобДопЗМ - НачальноеДопЗМ ); 	
						КИтогу.ТекСтоимЭксплМашин 	= КИтогу.ТекСтоимЭксплМашин + (ТекДобДопЗМ - НачальноеДопЗМТек); 
					КонецЕсли;
					КИтогу.ДопЗМ = КИтогу.ДопЗМ + ДобДопЗМ;
					КИтогу.ДопЗМТек = КИтогу.ДопЗМТек + ТекДобДопЗМ;
				КонецЕсли;
				
				Если ФлагИсточника.ЗарплМашинистов Тогда
					Если (Не СтрокаКИтогу.ЭксплМашин) И (СтрокаКИтогу.ПрямЗатраты) Тогда
						ДобавПЗ = ДобавПЗ + ДобПарамЗМ;	
						ТекДобавПЗ = ТекДобавПЗ + ТекДобПарамЗМ;	
					КонецЕсли;	
					Если СтрокаКИтогу.ПрямЗатраты Тогда
						КИтогу.СтоимПрямЗатраты = КИтогу.СтоимПрямЗатраты + ДобавПЗ; 	
						КИтогу.ТекСтоимПрямЗатраты 	= КИтогу.ТекСтоимПрямЗатраты + ТекДобавПЗ;
					КонецЕсли;	
				КонецЕсли;	
				Если СтрокаКИтогу.СтоимМатериалов Тогда
					КИтогу.СтоимСтоимМатер 		= КИтогу.СтоимСтоимМатер + ДобПарамСМ; 	
					КИтогу.ТекСтоимСтоимМатер 	= КИтогу.ТекСтоимСтоимМатер + ТекДобПарамСМ; 
				КонецЕсли;
			Иначе
				// При не соответствии флагов составляющих прямых затрат
				// источника и приемника может быть несколько вариантов:
				// 1. от одной составляющей прямых затрат источника к другой 
				// (или нескольким) приемника.
				// 2. от нескольких составляющих прямых затрат источника 
				// к другой (или нескольким) составляющим прямых затрат приемника.
				// Вариант 2 (при условии от нескольких к нескольким)не однозначен
				// и таких числовых поправок в настоящее время в справочнике нет.
				ОбщДобав = 0;
				ТекОбщДобав = 0;
				Если ФлагИсточника.СтоимМатериалов Тогда
					ОбщДобав 	= ОбщДобав + ДобПарамСМ;
					ТекОбщДобав = ТекОбщДобав + ТекДобПарамСМ;
				КонецЕсли;
				Если ФлагИсточника.ЗарплМашинистов Тогда
					ОбщДобав 	= ОбщДобав + ДобПарамЗМ;
					ТекОбщДобав = ТекОбщДобав + ТекДобПарамЗМ;               
					КИтогу.ДопЗМ = КИтогу.ДопЗМ + ДобДопЗМ;
					КИтогу.ДопЗМТек = КИтогу.ДопЗМТек + ТекДобДопЗМ;
				КонецЕсли;
				Если ФлагИсточника.ЭксплМашин Тогда
					ОбщДобав 	= ОбщДобав + ДобПарамЭМ;
					ТекОбщДобав = ТекОбщДобав + ТекДобПарамЭМ;
				КонецЕсли;
				Если ФлагИсточника.ОснЗарплата Тогда
					ОбщДобав 	= ОбщДобав + ДобПарамОЗ;
					ТекОбщДобав = ТекОбщДобав + ТекДобПарамОЗ;
				КонецЕсли;
				
				Если СтрокаКИтогу.ПрямЗатраты Тогда
					КИтогу.СтоимПрямЗатраты 	= КИтогу.СтоимПрямЗатраты + ОбщДобав; 	
					КИтогу.ТекСтоимПрямЗатраты 	= КИтогу.ТекСтоимПрямЗатраты + ТекОбщДобав;
				КонецЕсли;
				Если СтрокаКИтогу.ОснЗарплата Тогда
					КИтогу.СтоимОснЗарплата 	= КИтогу.СтоимОснЗарплата + ОбщДобав; 	
					КИтогу.ТекСтоимОснЗарплата 	= КИтогу.ТекСтоимОснЗарплата + ТекОбщДобав; 	
				КонецЕсли;
				Если СтрокаКИтогу.ЭксплМашин Тогда
					КИтогу.СтоимЭксплМашин 		= КИтогу.СтоимЭксплМашин + ОбщДобав; 	
					КИтогу.ТекСтоимЭксплМашин 	= КИтогу.ТекСтоимЭксплМашин + ТекОбщДобав; 	
				КонецЕсли;
				Если СтрокаКИтогу.ЗарплМашинистов Тогда
					КИтогу.СтоимЗарплМашин 		= КИтогу.СтоимЗарплМашин + ОбщДобав; 	
					КИтогу.ТекСтоимЗарплМашин 	= КИтогу.ТекСтоимЗарплМашин + ТекОбщДобав; 	
				КонецЕсли;
				Если СтрокаКИтогу.СтоимМатериалов Тогда
					КИтогу.СтоимСтоимМатер 		= КИтогу.СтоимСтоимМатер + ОбщДобав; 	
					КИтогу.ТекСтоимСтоимМатер 	= КИтогу.ТекСтоимСтоимМатер + ТекОбщДобав; 	
				КонецЕсли;
				
			КонецЕсли;	
			// Оборудование и трудозатраты не являются составляющим прямых затрат. 
			// Эти составляющие расценки обрабатываются по своим правилам.
			Если СтрокаКИтогу.Оборудование Тогда
				КИтогу.СтоимОборуд 		= КИтогу.СтоимОборуд + ДобПарамОБ; 
				КИтогу.ТекСтоимОборуд 	= КИтогу.ТекСтоимОборуд + ТекДобПарамОБ; 
			КонецЕсли;
			
			Если СтрокаКИтогу.ЗатратыТрудаРабочих Тогда
				КИтогу.ЗатратыТрудаРабочих 	= КИтогу.ЗатратыТрудаРабочих + ДобПарамТР; 
			КонецЕсли;
			
			Если СтрокаКИтогу.ЗатратыТрудаМашинистов Тогда
				КИтогу.ЗатратыТрудаМашин 	= КИтогу.ЗатратыТрудаМашин + ДобПарамТМ;
			КонецЕсли;
			// Масса брутто может быть задана для расценок оборудование.  
			// В настоящий момент поправка за массу брутто применяется только к оборудованию.
			Если ФлагИсточника.МассаБрутто Тогда
				Если СтрокаКИтогу.Оборудование Тогда
					КИтогу.СтоимОборуд = КИтогу.СтоимОборуд + ДобПарамБР;
					КИтогу.ТекСтоимОборуд = КИтогу.ТекСтоимОборуд + ТекДобПарамБР;
				КонецЕсли;
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЦикла;
	
	// 5. Запись результатов расчета в соответствующие регистры.
	
	Отбор = Новый Структура();
	Отбор.Вставить("Позиция",СтруктураПараметровОтбораРС.СсылкаНаПозицию);
	Отбор.Вставить("Смета",СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
	Отбор.Вставить("Раздел",СтруктураПараметровОтбораРС.СсылкаНаРаздел);
	
	Если ТипЗнч(ЛС) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		Если Позиция.НачисленияПозиции.Количество() = 0 ИЛИ ЧислПарамДляРасчета.Количество() = 0 Тогда
			Если ИспользоватьРС Тогда
		
				СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНаборТаблицей("СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП", Отбор, ТаблСПоправками);
				
			Иначе
				
				СтруктураДанныхРасчета.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП = ТаблСПоправками.Скопировать();
				
			КонецЕсли;
		Иначе
			
			Параметры = Новый Структура();
			Параметры.Вставить("Позиция",СтруктураПараметровОтбораРС.СсылкаНаПозицию);
			Параметры.Вставить("Смета",СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
			Параметры.Вставить("Раздел",СтруктураПараметровОтбораРС.СсылкаНаРаздел);        
		
			Параметры.Вставить("СтоимПрямЗатраты",КИтогу.СтоимПрямЗатраты);
			Параметры.Вставить("СтоимОснЗарплата",КИтогу.СтоимОснЗарплата);
			Параметры.Вставить("СтоимЭксплМашин",КИтогу.СтоимЭксплМашин);
			Параметры.Вставить("СтоимЗарплМашин",КИтогу.СтоимЗарплМашин);
			Параметры.Вставить("СтоимСтоимМатер",КИтогу.СтоимСтоимМатер);
			Параметры.Вставить("СтоимОборуд",КИтогу.СтоимОборуд);
			Параметры.Вставить("СтоимВозвратМатер",ТаблСПоправками[0].СтоимВозвратМатер);
			Параметры.Вставить("ЗатратыТрудаРабочих",КИтогу.ЗатратыТрудаРабочих);
			Параметры.Вставить("ЗатратыТрудаМашин",КИтогу.ЗатратыТрудаМашин);
			
			Параметры.Вставить("ТекСтоимПрямЗатраты",КИтогу.ТекСтоимПрямЗатраты);
			Параметры.Вставить("ТекСтоимОснЗарплата",КИтогу.ТекСтоимОснЗарплата);
			Параметры.Вставить("ТекСтоимЭксплМашин",КИтогу.ТекСтоимЭксплМашин);
			Параметры.Вставить("ТекСтоимЗарплМашин",КИтогу.ТекСтоимЗарплМашин);
			Параметры.Вставить("ТекСтоимВозвратМатер",ТаблСПоправками[0].ТекСтоимВозвратМатер);
			Параметры.Вставить("ТекСтоимСтоимМатер",КИтогу.ТекСтоимСтоимМатер);
			Параметры.Вставить("ТекСтоимОборуд",КИтогу.ТекСтоимОборуд);
			Параметры.Вставить("ДопЗМ",КИтогу.ДопЗМ);
			Параметры.Вставить("ДопЗМТек",КИтогу.ДопЗМТек);
				
			Если ИспользоватьРС Тогда
		
				СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНабор("СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП", Отбор, Параметры);
	
			Иначе
				
				НоваяСтрока = СтруктураДанныхРасчета.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметры);
				
			КонецЕсли;
		КонецЕсли;
				
	КонецЕсли;
	
	// 6. Подготовка таблицы расчета для записи в регистр "Итоги по разлелу".
	Если Акт <> Неопределено Тогда
		СтрокаВАкте = СМ_СметаВызовСервера.СтрокаПозицииАкта(Акт, Позиция);
		Если Не СтрокаВАкте = Неопределено Тогда
			ТекущийОбъем = СтрокаВАкте.ФактОбъем;
		Иначе 
			ТекущийОбъем = 0;
		КонецЕсли;	
	
	Иначе
		ТекущийОбъем = Позиция.ОбъемРабот;
	КонецЕсли;	
	
	Для Каждого СтрокаРасчета Из ТаблРасчета Цикл
		
		СтрокаРасчета.СтоимПрямЗатраты 		= ?(ПромОкр,Окр(СтрокаРасчета.СтоимПрямЗатраты * ТекущийОбъем,2),СтрокаРасчета.СтоимПрямЗатраты * ТекущийОбъем);		
		СтрокаРасчета.СтоимОснЗарплата 		= ?(ПромОкр,Окр(СтрокаРасчета.СтоимОснЗарплата * ТекущийОбъем,2),СтрокаРасчета.СтоимОснЗарплата * ТекущийОбъем);		
		СтрокаРасчета.СтоимЭксплМашин 		= ?(ПромОкр,Окр(СтрокаРасчета.СтоимЭксплМашин * ТекущийОбъем,2),СтрокаРасчета.СтоимЭксплМашин * ТекущийОбъем);		
		СтрокаРасчета.СтоимЗарплМашин 		= ?(ПромОкр,Окр(СтрокаРасчета.СтоимЗарплМашин * ТекущийОбъем,2),СтрокаРасчета.СтоимЗарплМашин * ТекущийОбъем);		
		СтрокаРасчета.СтоимСтоимМатер 		= ?(ПромОкр,Окр(СтрокаРасчета.СтоимСтоимМатер * ТекущийОбъем,2),СтрокаРасчета.СтоимСтоимМатер * ТекущийОбъем);		
		СтрокаРасчета.СтоимОборуд 			= ?(ПромОкр,Окр(СтрокаРасчета.СтоимОборуд * ТекущийОбъем,2),СтрокаРасчета.СтоимОборуд * ТекущийОбъем);		
		СтрокаРасчета.СтоимВозвратМатер 	= ?(ПромОкр,Окр(СтрокаРасчета.СтоимВозвратМатер * ТекущийОбъем,2),СтрокаРасчета.СтоимВозвратМатер * ТекущийОбъем);		
		СтрокаРасчета.ЗатратыТрудаРабочих 	= ?(ПромОкр,Окр(СтрокаРасчета.ЗатратыТрудаРабочих * ТекущийОбъем,2),СтрокаРасчета.ЗатратыТрудаРабочих * ТекущийОбъем);		
		СтрокаРасчета.ЗатратыТрудаМашин 	= ?(ПромОкр,Окр(СтрокаРасчета.ЗатратыТрудаМашин * ТекущийОбъем,2),СтрокаРасчета.ЗатратыТрудаМашин * ТекущийОбъем);		
		СтрокаРасчета.ТекСтоимПрямЗатраты 	= ?(ПромОкр,Окр(СтрокаРасчета.ТекСтоимПрямЗатраты * ТекущийОбъем,2),СтрокаРасчета.ТекСтоимПрямЗатраты * ТекущийОбъем);		
		СтрокаРасчета.ТекСтоимОснЗарплата 	= ?(ПромОкр,Окр(СтрокаРасчета.ТекСтоимОснЗарплата * ТекущийОбъем,2),СтрокаРасчета.ТекСтоимОснЗарплата * ТекущийОбъем);		
		СтрокаРасчета.ТекСтоимЭксплМашин 	= ?(ПромОкр,Окр(СтрокаРасчета.ТекСтоимЭксплМашин * ТекущийОбъем,2),СтрокаРасчета.ТекСтоимЭксплМашин * ТекущийОбъем);		
		СтрокаРасчета.ТекСтоимЗарплМашин 	= ?(ПромОкр,Окр(СтрокаРасчета.ТекСтоимЗарплМашин * ТекущийОбъем,2),СтрокаРасчета.ТекСтоимЗарплМашин * ТекущийОбъем);		
		СтрокаРасчета.ТекСтоимСтоимМатер 	= ?(ПромОкр,Окр(СтрокаРасчета.ТекСтоимСтоимМатер * ТекущийОбъем,2),СтрокаРасчета.ТекСтоимСтоимМатер * ТекущийОбъем);		
		СтрокаРасчета.ТекСтоимОборуд 		= ?(ПромОкр,Окр(СтрокаРасчета.ТекСтоимОборуд * ТекущийОбъем,2),СтрокаРасчета.ТекСтоимОборуд * ТекущийОбъем);		
		СтрокаРасчета.ТекСтоимВозвратМатер 	= ?(ПромОкр,Окр(СтрокаРасчета.ТекСтоимВозвратМатер * ТекущийОбъем,2),СтрокаРасчета.ТекСтоимВозвратМатер * ТекущийОбъем);		

		Если ОкрИтог Тогда
			СтрокаРасчета.СтоимОснЗарплата 	= Окр(СтрокаРасчета.СтоимОснЗарплата,0);		
			СтрокаРасчета.СтоимЭксплМашин 	= Окр(СтрокаРасчета.СтоимЭксплМашин,0);		
			СтрокаРасчета.СтоимЗарплМашин 	= Окр(СтрокаРасчета.СтоимЗарплМашин,0);		
			СтрокаРасчета.СтоимСтоимМатер 	= Окр(СтрокаРасчета.СтоимСтоимМатер,0);		
			СтрокаРасчета.СтоимОборуд 		= Окр(СтрокаРасчета.СтоимОборуд,0);		
			СтрокаРасчета.СтоимПрямЗатраты 	= Окр(СтрокаРасчета.СтоимПрямЗатраты,0);
			СтрокаРасчета.ТекСтоимОснЗарплата 	= Окр(СтрокаРасчета.ТекСтоимОснЗарплата,0);		
			СтрокаРасчета.ТекСтоимЭксплМашин 	= Окр(СтрокаРасчета.ТекСтоимЭксплМашин,0);		
			СтрокаРасчета.ТекСтоимЗарплМашин 	= Окр(СтрокаРасчета.ТекСтоимЗарплМашин,0);		
			СтрокаРасчета.ТекСтоимСтоимМатер 	= Окр(СтрокаРасчета.ТекСтоимСтоимМатер,0);		
			СтрокаРасчета.ТекСтоимОборуд 		= Окр(СтрокаРасчета.ТекСтоимОборуд,0);		
			СтрокаРасчета.ТекСтоимПрямЗатраты 	= Окр(СтрокаРасчета.ТекСтоимПрямЗатраты,0);
			Если  СтрокаРасчета.ТекСтоимПрямЗатраты <> 0 Тогда
				Если  СтрокаРасчета.ТекСтоимОснЗарплата + СтрокаРасчета.ТекСтоимЭксплМашин + СтрокаРасчета.ТекСтоимСтоимМатер <> 0 Тогда
					СтрокаРасчета.ТекСтоимПрямЗатраты = СтрокаРасчета.ТекСтоимОснЗарплата + СтрокаРасчета.ТекСтоимЭксплМашин + СтрокаРасчета.ТекСтоимСтоимМатер;	
				КонецЕсли;
			КонецЕсли;
			Если ОбрабПогр = Перечисления.СМ_ОбработкаПогрешностиОкругления.ПЗЧерезСумму Тогда
				СтрокаРасчета.СтоимПрямЗатраты = СтрокаРасчета.СтоимОснЗарплата + СтрокаРасчета.СтоимЭксплМашин + СтрокаРасчета.СтоимСтоимМатер;	
				СтрокаРасчета.ТекСтоимПрямЗатраты = СтрокаРасчета.ТекСтоимОснЗарплата + СтрокаРасчета.ТекСтоимЭксплМашин + СтрокаРасчета.ТекСтоимСтоимМатер;	
			ИначеЕсли ОбрабПогр = Перечисления.СМ_ОбработкаПогрешностиОкругления.РазницуНаНаибольшую Тогда
				Разница = СтрокаРасчета.СтоимОснЗарплата + СтрокаРасчета.СтоимЭксплМашин + СтрокаРасчета.СтоимСтоимМатер - СтрокаРасчета.СтоимПрямЗатраты;
				Если СтрокаРасчета.СтоимОснЗарплата > СтрокаРасчета.СтоимЭксплМашин И СтрокаРасчета.СтоимОснЗарплата > СтрокаРасчета.СтоимСтоимМатер Тогда
					СтрокаРасчета.СтоимОснЗарплата = СтрокаРасчета.СтоимОснЗарплата - Разница;	
				ИначеЕсли СтрокаРасчета.СтоимЭксплМашин > СтрокаРасчета.СтоимСтоимМатер Тогда
					СтрокаРасчета.СтоимЭксплМашин = СтрокаРасчета.СтоимЭксплМашин - Разница;	
				Иначе
					СтрокаРасчета.СтоимСтоимМатер = СтрокаРасчета.СтоимСтоимМатер - Разница;	
				КонецЕсли;
				Разница = СтрокаРасчета.ТекСтоимОснЗарплата + СтрокаРасчета.ТекСтоимЭксплМашин + СтрокаРасчета.ТекСтоимСтоимМатер - СтрокаРасчета.ТекСтоимПрямЗатраты;
				Если СтрокаРасчета.ТекСтоимОснЗарплата > СтрокаРасчета.ТекСтоимЭксплМашин И СтрокаРасчета.ТекСтоимОснЗарплата > СтрокаРасчета.ТекСтоимСтоимМатер Тогда
					СтрокаРасчета.ТекСтоимОснЗарплата = СтрокаРасчета.ТекСтоимОснЗарплата - Разница;	
				ИначеЕсли СтрокаРасчета.ТекСтоимЭксплМашин > СтрокаРасчета.ТекСтоимСтоимМатер Тогда
					СтрокаРасчета.ТекСтоимЭксплМашин = СтрокаРасчета.ТекСтоимЭксплМашин - Разница;	
				Иначе
					СтрокаРасчета.ТекСтоимСтоимМатер = СтрокаРасчета.ТекСтоимСтоимМатер - Разница;	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблРасчета.ЗаполнитьЗначения(СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета,"Смета");
  	ТаблРасчета.ЗаполнитьЗначения(СтруктураПараметровОтбораРС.СсылкаНаРаздел,"Раздел");
	ТаблРасчета.ЗаполнитьЗначения(СтруктураПараметровОтбораРС.СсылкаНаПозицию,"Позиция");
	
	Возврат ТаблРасчета;
	
КонецФункции

// Расчет зимнего удорожания для методики ТСН.
//
Процедура РасчетЗимнегоУдорожания(ТаблСПоправками,ПрименитьТрудРаб,ПрименитьТрудМаш,КоэффЗУ,КоэффЗУМат)
	
	УчитыватьДопЗМ = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","УчитыватьДопЗМ",Ложь);	
	Для Каждого СтрЗнач Из  ТаблСПоправками Цикл
		СтрЗнач.СтоимСтоимМатер = СтрЗнач.СтоимСтоимМатер * КоэффЗУМат;
		СтрЗнач.ТекСтоимСтоимМатер = СтрЗнач.ТекСтоимСтоимМатер * КоэффЗУМат;
		СтрЗнач.СтоимОснЗарплата = СтрЗнач.СтоимОснЗарплата * КоэффЗУ;
		СтрЗнач.ТекСтоимОснЗарплата = СтрЗнач.ТекСтоимОснЗарплата * КоэффЗУ;
		СтрЗнач.СтоимЭксплМашин = СтрЗнач.СтоимЭксплМашин * КоэффЗУ;
		СтрЗнач.ТекСтоимЭксплМашин = СтрЗнач.ТекСтоимЭксплМашин * КоэффЗУ;
		СтрЗнач.СтоимЗарплМашин = СтрЗнач.СтоимЗарплМашин * КоэффЗУ;
		СтрЗнач.ТекСтоимЗарплМашин = СтрЗнач.ТекСтоимЗарплМашин * КоэффЗУ;
		Если УчитыватьДопЗМ Тогда
			СтрЗнач.ДопЗМ = СтрЗнач.ДопЗМ * КоэффЗУ;
			СтрЗнач.ДопЗМТек = СтрЗнач.ДопЗМТек * КоэффЗУ;
		КонецЕсли;
		ПЗ = СтрЗнач.СтоимСтоимМатер + СтрЗнач.СтоимЭксплМашин + СтрЗнач.СтоимОснЗарплата;
		ТекПЗ = СтрЗнач.ТекСтоимЭксплМашин + СтрЗнач.ТекСтоимОснЗарплата + СтрЗнач.ТекСтоимСтоимМатер;
		Если ПЗ <> 0 Тогда
			СтрЗнач.СтоимПрямЗатраты = ПЗ;
		КонецЕсли;	
		Если ТекПЗ <> 0 Тогда
			СтрЗнач.ТекСтоимПрямЗатраты = ТекПЗ;
		КонецЕсли;	          				

		Если ПрименитьТрудРаб Тогда
			СтрЗнач.ЗатратыТрудаРабочих = СтрЗнач.ЗатратыТрудаРабочих * КоэффЗУ;
		КонецЕсли;
		Если ПрименитьТрудМаш Тогда
			СтрЗнач.ЗатратыТрудаМашин = СтрЗнач.ЗатратыТрудаМашин * КоэффЗУ;
		КонецЕсли;

	КонецЦикла;
КонецПроцедуры	

#КонецОбласти

#Область ПолучениеТаблицДляРасчетовИГрупповойОбработки

Функция ТаблицаБезГруппировкиПоЦенам(ТаблСтоимРес,ГруппироватьСтатусы,ДетализацияОтклонения)
	Если ГруппироватьСтатусы Тогда
		Возврат ПолучитьТаблицуБезГруппировкиПоЦенамСтатусы(ТаблСтоимРес);
	ИначеЕсли ДетализацияОтклонения Тогда
		Возврат ПолучитьТаблицуБезГруппировкиПоЦенамОтклонение(ТаблСтоимРес);
	Иначе
		Возврат ПолучитьТаблицуБезГруппировкиПоЦенам(ТаблСтоимРес);
	КонецЕсли;
КонецФункции

// Вспомогательная для функция получения сводных таблиц ресурсов.
//
Функция ПолучитьТаблицуБезГруппировкиПоЦенам(ТаблСтоимРес)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтоимостьРесурсов.Ресурс,
	|	ВЫРАЗИТЬ(СтоимостьРесурсов.КодРесурса КАК СТРОКА(20)) КАК КодРесурса,
	|	СтоимостьРесурсов.ВидРесурса,
	|	ВЫРАЗИТЬ(СтоимостьРесурсов.НаименованиеРесурса КАК СТРОКА(500)) КАК НаименованиеРесурса,
	|	СтоимостьРесурсов.ЕдиницаИзмеренияРесурса,
	|	СтоимостьРесурсов.ЭтоУчтенный,
	|	СтоимостьРесурсов.ЭтоНеучтенный,
	|	СтоимостьРесурсов.ЭтоОборудование,
	|	СтоимостьРесурсов.ЦенаБазисная КАК ЦенаБазисная,
	|	СтоимостьРесурсов.ЦенаЗМБазисная КАК ЦенаЗМБазисная,
	|	СтоимостьРесурсов.ЦенаТекущая КАК ЦенаТекущая,
	|	СтоимостьРесурсов.ЦенаТекущаяЗМ КАК ЦенаТекущаяЗМ,
	|	СтоимостьРесурсов.Количество КАК Количество,
	|	СтоимостьРесурсов.РасходПоНорме КАК РасходПоНорме,
	|	СтоимостьРесурсов.РасходПоФакту КАК РасходПоФакту,
	|	СтоимостьРесурсов.СтоимостьБазисная КАК СтоимостьБазисная,
	|	СтоимостьРесурсов.СтоимостьЗМБазисная КАК СтоимостьЗМБазисная,
	|	СтоимостьРесурсов.СтоимостьТекущая КАК СтоимостьТекущая,
	|	СтоимостьРесурсов.СтоимостьТекущаяЗМ КАК СтоимостьТекущаяЗМ,
	|	СтоимостьРесурсов.Картинка КАК Картинка,
	|	СтоимостьРесурсов.НеИзменятьЦены
	|ПОМЕСТИТЬ РесурсыВрем
	|ИЗ
	|	&ТаблСтоимРес КАК СтоимостьРесурсов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьРесурсов.Ресурс,
	|	ВЫРАЗИТЬ(СтоимостьРесурсов.КодРесурса КАК СТРОКА(20)) КАК КодРесурса,
	|	СтоимостьРесурсов.ВидРесурса,
	|	ВЫРАЗИТЬ(СтоимостьРесурсов.НаименованиеРесурса КАК СТРОКА(500)) КАК НаименованиеРесурса,
	|	СтоимостьРесурсов.ЕдиницаИзмеренияРесурса,
	|	СтоимостьРесурсов.ЭтоУчтенный,
	|	СтоимостьРесурсов.ЭтоНеучтенный,
	|	СтоимостьРесурсов.ЭтоОборудование,
	|	СРЕДНЕЕ(СтоимостьРесурсов.ЦенаБазисная) КАК ЦенаБазисная,
	|	СРЕДНЕЕ(СтоимостьРесурсов.ЦенаЗМБазисная) КАК ЦенаЗМБазисная,
	|	СРЕДНЕЕ(СтоимостьРесурсов.ЦенаТекущая) КАК ЦенаТекущая,
	|	СРЕДНЕЕ(СтоимостьРесурсов.ЦенаТекущаяЗМ) КАК ЦенаТекущаяЗМ,
	|	СтоимостьРесурсов.НеИзменятьЦены
	|ПОМЕСТИТЬ СредниеПоРесурсам
	|ИЗ
	|	РесурсыВрем КАК СтоимостьРесурсов
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(СтоимостьРесурсов.КодРесурса КАК СТРОКА(20)),
	|	СтоимостьРесурсов.ВидРесурса,
	|	СтоимостьРесурсов.Ресурс,
	|	ВЫРАЗИТЬ(СтоимостьРесурсов.НаименованиеРесурса КАК СТРОКА(500)),
	|	СтоимостьРесурсов.ЕдиницаИзмеренияРесурса,
	|	СтоимостьРесурсов.ЭтоУчтенный,
	|	СтоимостьРесурсов.ЭтоНеучтенный,
	|	СтоимостьРесурсов.ЭтоОборудование,
	|	СтоимостьРесурсов.НеИзменятьЦены
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьРесурсов.Ресурс,
	|	ВЫРАЗИТЬ(СтоимостьРесурсов.КодРесурса КАК СТРОКА(20)) КАК КодРесурса,
	|	СтоимостьРесурсов.ВидРесурса,
	|	ВЫРАЗИТЬ(СтоимостьРесурсов.НаименованиеРесурса КАК СТРОКА(500)) КАК НаименованиеРесурса,
	|	СтоимостьРесурсов.ЕдиницаИзмеренияРесурса,
	|	СтоимостьРесурсов.ЭтоУчтенный,
	|	СтоимостьРесурсов.ЭтоНеучтенный,
	|	СтоимостьРесурсов.ЭтоОборудование,
	|	СРЕДНЕЕ(СтоимостьРесурсов.ЦенаБазисная) КАК ЦенаБазисная,
	|	СРЕДНЕЕ(СтоимостьРесурсов.ЦенаЗМБазисная) КАК ЦенаЗМБазисная,
	|	СРЕДНЕЕ(СтоимостьРесурсов.ЦенаТекущая) КАК ЦенаТекущая,
	|	СРЕДНЕЕ(СтоимостьРесурсов.ЦенаТекущаяЗМ) КАК ЦенаТекущаяЗМ,
	|	СРЕДНЕЕ(СредниеПоРесурсам.ЦенаБазисная) КАК ЦенаБазиснаяПроверка,
	|	СРЕДНЕЕ(СредниеПоРесурсам.ЦенаЗМБазисная) КАК ЦенаЗМБазиснаяПроверка,
	|	СРЕДНЕЕ(СредниеПоРесурсам.ЦенаТекущая) КАК ЦенаТекущаяПроверка,
	|	СРЕДНЕЕ(СредниеПоРесурсам.ЦенаТекущаяЗМ) КАК ЦенаТекущаяЗМПроверка,
	|	СУММА(ВЫБОР
	|			КОГДА СтоимостьРесурсов.ЦенаБазисная <> СредниеПоРесурсам.ЦенаБазисная
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ЦенаБазиснаяЕстьОтклонение,
	|	СУММА(ВЫБОР
	|			КОГДА СтоимостьРесурсов.ЦенаЗМБазисная <> СредниеПоРесурсам.ЦенаЗМБазисная
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ЦенаЗМБазиснаяЕстьОтклонение,
	|	СУММА(ВЫБОР
	|			КОГДА СтоимостьРесурсов.ЦенаТекущая <> СредниеПоРесурсам.ЦенаТекущая
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ЦенаТекущаяЕстьОтклонение,
	|	СУММА(ВЫБОР
	|			КОГДА СтоимостьРесурсов.ЦенаТекущаяЗМ <> СредниеПоРесурсам.ЦенаТекущаяЗМ
	|				ТОГДА 1
