						НоваяСтрока.ПрямЗатраты = НоваяСтрока.ПрямЗатраты + НоваяСтрока.ЗарплМашин + ?(Действие = "-",-НайденнаяСтрока.ЗарплМашин,НайденнаяСтрока.ЗарплМашин); 
