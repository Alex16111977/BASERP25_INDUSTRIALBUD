			МассивВидовРабот = Новый Массив;
			МассивВидовРабот.Добавить(Справочники.СМ_ИтогиСметыПоВидамРабот.СтроитРаб);
			МассивВидовРабот.Добавить(Справочники.СМ_ИтогиСметыПоВидамРабот.МонтажнРаб);
			МассивВидовРабот.Добавить(Справочники.СМ_ИтогиСметыПоВидамРабот.Металлоконстр);
			МассивВидовРабот.Добавить(Справочники.СМ_ИтогиСметыПоВидамРабот.СантехнРаб);
