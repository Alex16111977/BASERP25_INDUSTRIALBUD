			СметПрибыль.ПрямЗатраты 	= 0;
			СметПрибыль.ТекПрямЗатраты = 0;
		КонецЕсли;
	ИначеЕсли (МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный) и методикаРСНБ Тогда
		СметПрибыль = ТаблРасчета.Добавить();
		СметПрибыль.Итог = Справочники.СМ_ИтогиПоСмете.СметПрибыль;
		СметПрибыль.ПрямЗатраты 	= Окр(ИтогоСУчетомНаклРасх2.ПрямЗатраты*ЛокСмета.СП_ВС/100,КолЗнаков);
		СметПрибыль.ТекПрямЗатраты 	= Окр(ИтогоСУчетомНаклРасх2.ТекПрямЗатраты*ЛокСмета.СП_ВС/100,КолЗнаков);
	Иначе	
		СметПрибыль = ТаблРасчета.Добавить();
		СметПрибыль.Итог = Справочники.СМ_ИтогиПоСмете.СметПрибыль;
		СтрокаИтога = ТаблицаИтогов.Найти(Справочники.СМ_ИтогиПоРазделу.СметПрибыль);
		Если НЕ СтрокаИтога = Неопределено Тогда
