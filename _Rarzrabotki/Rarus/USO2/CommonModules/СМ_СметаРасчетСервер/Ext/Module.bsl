				НоваяСтрока.ПрямЗатраты = НоваяСтрока.ПрямЗатраты + ?(Действие = "-",-НайденнаяСтрока.Прямзатраты,НайденнаяСтрока.Прямзатраты); 
			КонецЕсли;
			НоваяСтрока.ОснЗарплата = НоваяСтрока.ОснЗарплата + ?(Действие = "-",-НайденнаяСтрока.ОснЗарплата,НайденнаяСтрока.ОснЗарплата);  
