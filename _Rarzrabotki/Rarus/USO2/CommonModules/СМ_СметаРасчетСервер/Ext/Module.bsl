		Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
			СметПрибыльПоРазделу    = Окр(?(ИтоговаяСтрокаБЕ.СуммаСПБазисная = NULL,0,ИтоговаяСтрокаБЕ.СуммаСПБазисная),КолЗнаков) ;
		Иначе
			СметПрибыльПоРазделу    = Окр(?(ИтоговаяСтрокаБИ.СуммаСПБазисная = NULL,0,ИтоговаяСтрокаБИ.СуммаСПБазисная),КолЗнаков);
		КонецЕсли;
		СметПрибыль.ПрямЗатраты = СметПрибыль.ПрямЗатраты + СметПрибыльПоРазделу;
		// Текущее значение.
		Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
			ТекущаяСметПрибыльПоРазделу =  Окр(?(ИтоговаяСтрокаБЕ.СуммаСПТекущая = NULL,0,ИтоговаяСтрокаБЕ.СуммаСПТекущая),КолЗнаков); // + СуммаСПТекПодразд;
		Иначе	
			ТекущаяСметПрибыльПоРазделу = ?(ИтоговаяСтрокаБИ.СуммаСПТекущая = NULL,0,ИтоговаяСтрокаБИ.СуммаСПТекущая); // + СуммаСПТекПодразд;
		КонецЕсли;	
		// Сметная прибыль с коэффициентами к разделу.
		Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный И Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда
			Если НаборКоэф <> Неопределено Тогда
				Если СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости 	
					Или (СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат 
					И НаборКоэф.КоэффПолнСтоимРабот <> 0) Тогда
					ТекущаяСметПрибыльПоРазделу = Окр(ТекущаяСметПрибыльПоРазделу  * ?(НаборКоэф.КоэффПолнСтоимРабот = 0,1,НаборКоэф.КоэффПолнСтоимРабот),КолЗнаков);
				ИначеЕсли СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат
					И НаборКоэф.КоэффПолнСтоимРабот = 0 Тогда	
					ТекущаяСметПрибыльПоРазделу = Окр(ТекущаяСметПрибыльПоРазделу * ?(НаборКоэф.КоэффОснЗарплаты = 0,1,НаборКоэф.КоэффОснЗарплаты),КолЗнаков);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ТекущаяСметПрибыльПоРазделу = Окр(ТекущаяСметПрибыльПоРазделу,КолЗнаков);
		КонецЕсли;
		ТекущаяСметПрибыльПоРазделу = ТекущаяСметПрибыльПоРазделу  ;
		СметПрибыль.ТекПрямЗатраты 	= СметПрибыль.ТекПрямЗатраты + ТекущаяСметПрибыльПоРазделу;
	КонецЕсли;
	
	// Всего по разделу.
	ВсегоПоРазделу  = ТаблРасчета.Найти(Справочники.СМ_ИтогиПоРазделу.ВсегоПоРазделу,"Итог");
