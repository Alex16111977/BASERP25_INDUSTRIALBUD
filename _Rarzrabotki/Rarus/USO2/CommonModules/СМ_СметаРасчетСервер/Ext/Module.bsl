		|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_АктВыполненныхРабот.Позиции КАК АктВыполненныхРаботПозиции
		|	ПО БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция = АктВыполненныхРаботПозиции.Позиция 
		|   И БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Смета = АктВыполненныхРаботПозиции.Ссылка
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_НРиСП КАК НРиСП
		|	ПО БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Смета = НРиСП.Смета  
		|	   И БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Раздел = НРиСП.Раздел 
		|	   И БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция = НРиСП.Позиция
		|ГДЕ
		|	БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Раздел = &Раздел 
		|	И БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Смета = &Смета 
		|	И БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.Расчет = ИСТИНА
		|ИТОГИ
		|	СУММА(СтоимПрямЗатраты),
		|	СУММА(СтоимОснЗарплата),
		|	СУММА(СтоимЭксплМашин),
		|	СУММА(СтоимЗарплМашин),
		|	СУММА(СтоимСтоимМатер),
		|	СУММА(СтоимОборуд),
		|	СУММА(СтоимВозвратМатер),
		|	СУММА(ЗатратыТрудаРабочих),
		|	СУММА(ЗатратыТрудаМашин),
		|	СУММА(ТекСтоимПрямЗатраты),
		|	СУММА(ТекСтоимОснЗарплата),
		|	СУММА(ТекСтоимЭксплМашин),
		|	СУММА(ТекСтоимЗарплМашин),
		|	СУММА(ТекСтоимСтоимМатер),
		|	СУММА(ТекСтоимОборуд),
		|	СУММА(ТекСтоимВозвратМатер),
		|	СУММА(СуммаНРБазисная),
		|	СУММА(СуммаСПБазисная),
		|	СУММА(СуммаНРТекущая),
		|	СУММА(СуммаСПТекущая),
		|	СУММА(СуммаДобавкаТР),
		|	СУММА(СуммаДобавкаОЗ)
		|ПО
		|	ОБЩИЕ";
	Иначе
		ЗапросБЕ.Текст = "ВЫБРАТЬ
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.ОбъемРабот,0) КАК Объем,
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимПрямЗатраты,0) КАК СтоимПрямЗатраты,
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимОснЗарплата,0) КАК СтоимОснЗарплата,
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимЭксплМашин,0)  КАК СтоимЭксплМашин,
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимЗарплМашин,0)  КАК СтоимЗарплМашин,
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимСтоимМатер,0)  КАК СтоимСтоимМатер,
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимОборуд,0)  КАК СтоимОборуд,
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимВозвратМатер,0)  КАК СтоимВозвратМатер,
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ЗатратыТрудаРабочих * ПозицияЛокальнойСметы.ОбъемРабот,0) КАК ЗатратыТрудаРабочих,
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ЗатратыТрудаМашин * ПозицияЛокальнойСметы.ОбъемРабот,0) КАК ЗатратыТрудаМашин,
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимПрямЗатраты,0)  КАК ТекСтоимПрямЗатраты,
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимОснЗарплата,0) КАК ТекСтоимОснЗарплата,
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимЭксплМашин,0) КАК ТекСтоимЭксплМашин,
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимЗарплМашин,0) КАК ТекСтоимЗарплМашин,
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимСтоимМатер,0)  КАК ТекСтоимСтоимМатер,
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимОборуд,0)  КАК ТекСтоимОборуд,
		|	ЕСТЬNULL(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимВозвратМатер,0) КАК ТекСтоимВозвратМатер,
		|	НРиСП.СуммаНРНаОбъем + НРиСП.СуммаНРМашинистовНаОбъем КАК СуммаНРБазисная,
		|	НРиСП.СуммаСПНаОбъем + НРиСП.СуммаСПМашинистовНаОбъем КАК СуммаСПБазисная,
		|	НРиСП.ТекСуммаНРНаОбъем + НРиСП.ТекСуммаНРМашинистовНаОбъем КАК СуммаНРТекущая,
		|	НРиСП.ТекСуммаСПНаОбъем + НРиСП.ТекСуммаСПМашинистовНаОбъем КАК СуммаСПТекущая,
		|	НРиСП.ДобавкаТР КАК СуммаДобавкаТР,
		|	НРиСП.ДобавкаОЗ КАК СуммаДобавкаОЗ
		|ИЗ
		|	РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП КАК БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
		|		ПО БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция = ПозицияЛокальнойСметы.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_НРиСП КАК НРиСП
		|		ПО БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Смета = НРиСП.Смета
		|			И БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Раздел = НРиСП.Раздел
		|			И БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция = НРиСП.Позиция
		|ГДЕ
		|	БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Раздел = &Раздел
		|	И БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Смета = &Смета
		|	И БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.Расчет = ИСТИНА
		|ИТОГИ
		|	СУММА(СтоимПрямЗатраты),
		|	СУММА(СтоимОснЗарплата),
		|	СУММА(СтоимЭксплМашин),
		|	СУММА(СтоимЗарплМашин),
		|	СУММА(СтоимСтоимМатер),
		|	СУММА(СтоимОборуд),
		|	СУММА(СтоимВозвратМатер),
		|	СУММА(ЗатратыТрудаРабочих),
		|	СУММА(ЗатратыТрудаМашин),
		|	СУММА(ТекСтоимПрямЗатраты),
		|	СУММА(ТекСтоимОснЗарплата),
		|	СУММА(ТекСтоимЭксплМашин),
		|	СУММА(ТекСтоимЗарплМашин),
		|	СУММА(ТекСтоимСтоимМатер),
		|	СУММА(ТекСтоимОборуд),
		|	СУММА(ТекСтоимВозвратМатер),
		|	СУММА(СуммаНРБазисная),
		|	СУММА(СуммаСПБазисная),
		|	СУММА(СуммаНРТекущая),
		|	СУММА(СуммаСПТекущая),
		|	СУММА(СуммаДобавкаТР),
		|	СУММА(СуммаДобавкаОЗ)
		|ПО
		|	ОБЩИЕ";
	КонецЕсли;	
	ЗапросБЕ.УстановитьПараметр("Раздел",СтруктураПараметровОтбораРС.СсылкаНаРаздел);
	ЗапросБЕ.УстановитьПараметр("Смета",СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
	
	// Строка в таблице СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.
	ТаблПозицииБИ = ЗапросБИ.Выполнить().Выгрузить();
	Если ТаблПозицииБИ.Количество()=0 Тогда
		СтрокаТаблПозиции = ТаблПозицииБИ.Добавить();
		Для Сч = 0 По ТаблПозицииБИ.Колонки.Количество()-1 Цикл
			СтрокаТаблПозиции[Сч] = 0;	
		КонецЦикла;
	КонецЕсли;
	ИтоговаяСтрокаБИ = ТаблПозицииБИ[0];
	
	// Округление составляющих.
	СтоимОснЗарплата = 0;
	СтоимЭксплМашин = 0;
	СтоимЗарплМашин = 0;
	СтоимСтоимМатер = 0;
	СтоимПрямЗатраты = 0;
	СтоимОборуд = 0;
	СтоимВозвратМатер = 0;
	ДопЗМ = 0;
	
	Для Сч = 1 По  ТаблПозицииБИ.Количество()-1 Цикл
		СтрокаБИ = ТаблПозицииБИ.Получить(Сч);
		ТекОЗ = Окр(СтрокаБИ.СтоимОснЗарплата,КолЗнаков);
		ТекЭМ = Окр(СтрокаБИ.СтоимЭксплМашин,КолЗнаков);
		ТекСМ = Окр(СтрокаБИ.СтоимСтоимМатер,КолЗнаков);
		ТекПЗ = Окр(СтрокаБИ.СтоимПрямЗатраты,КолЗнаков);
		Если  ТекПЗ <> 0 Тогда
			Если  ТекОЗ +  ТекЭМ + ТекСМ <> 0 Тогда
				ТекПЗ =  ТекОЗ +  ТекЭМ + ТекСМ;
			КонецЕсли;	
		ИначеЕсли  Окр(СтрокаБИ.СтоимОборуд,КолЗнаков) <> 0 Тогда	
			ТекПЗ = 0;
		КонецЕсли;	
		
		СтоимОснЗарплата = СтоимОснЗарплата + ТекОЗ;
		СтоимЭксплМашин = СтоимЭксплМашин + ТекЭМ;
		СтоимЗарплМашин = СтоимЗарплМашин + Окр(СтрокаБИ.СтоимЗарплМашин,КолЗнаков);
		СтоимСтоимМатер = СтоимСтоимМатер + ТекСМ;
		СтоимПрямЗатраты = СтоимПрямЗатраты + ТекПЗ;
		СтоимОборуд = СтоимОборуд + Окр(СтрокаБИ.СтоимОборуд,КолЗнаков);
		СтоимВозвратМатер = СтоимВозвратМатер  + Окр(СтрокаБИ.СтоимВозвратМатер,КолЗнаков);
		ДопЗМ = ДопЗМ  + Окр(СтрокаБИ.ДопЗМ,КолЗнаков);
		
	КонецЦикла;
	
	// Строка в таблице СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.
	ТаблПозицииБЕ = ЗапросБЕ.Выполнить().Выгрузить();
	Если ТаблПозицииБЕ.Количество()=0 Тогда
		СтрокаТаблПозиции = ТаблПозицииБЕ.Добавить();
		Для Сч = 0 По ТаблПозицииБЕ.Колонки.Количество()-1 Цикл
			СтрокаТаблПозиции[Сч] = 0;	
		КонецЦикла;
	КонецЕсли;
	ИтоговаяСтрокаБЕ = ТаблПозицииБЕ[0];
	// Округление составляющих.
	ТекСтоимОснЗарплата = 0;
	ТекСтоимЭксплМашин = 0;
	ТекСтоимЗарплМашин = 0;
	ТекСтоимСтоимМатер = 0;
	ТекСтоимПрямЗатраты = 0;
	ТекСтоимОборуд = 0;
	ТекСтоимВозвратМатер = 0;
	ПЗ 	= 0;
	ОЗ 	= 0;
	ЭМ 	= 0;
	ЗМ 	= 0;
	СМ 	= 0;
	ОБ 	= 0;
	ВМ 	= 0;
	
	Для Сч = 1 По  ТаблПозицииБЕ.Количество()-1 Цикл
	
		СтрокаБЕ = ТаблПозицииБЕ.Получить(Сч);
		// СУДАРИКОВ - убрал округление, ранее стояли РУБЛИ
		// ТекОЗ = Окр((СтрокаБЕ.ТекСтоимОснЗарплата) * СтрокаБЕ.Объем,КолЗнаков);
		ТекОЗ = ((СтрокаБЕ.ТекСтоимОснЗарплата) * СтрокаБЕ.Объем);
		ТекЭМ = ((СтрокаБЕ.ТекСтоимЭксплМашин)  * СтрокаБЕ.Объем);
		ТекСМ = ((СтрокаБЕ.ТекСтоимСтоимМатер)  * СтрокаБЕ.Объем);
		ТекПЗ = ((СтрокаБЕ.ТекСтоимПрямЗатраты) * СтрокаБЕ.Объем);
		Если  ТекПЗ <> 0 Тогда
			Если  ТекОЗ +  ТекЭМ + ТекСМ <> 0 Тогда
				ТекПЗ =  ТекОЗ +  ТекЭМ + ТекСМ;
			КонецЕсли;
		ИначеЕсли  Окр((СтрокаБЕ.ТекСтоимОборуд) * СтрокаБЕ.Объем,КолЗнаков) <> 0 Тогда
			ТекПЗ = 0;
		КонецЕсли;	
		
		ТекСтоимОснЗарплата = ТекСтоимОснЗарплата + ТекОЗ;
		ТекСтоимЭксплМашин  = ТекСтоимЭксплМашин  + ТекЭМ;
		ТекСтоимЗарплМашин  = ТекСтоимЗарплМашин  + Окр((СтрокаБЕ.ТекСтоимЗарплМашин) * СтрокаБЕ.Объем,КолЗнаков);
		ТекСтоимСтоимМатер  = ТекСтоимСтоимМатер  + ТекСМ;
		ТекСтоимПрямЗатраты = ТекСтоимПрямЗатраты + ТекПЗ;
		ТекСтоимОборуд = ТекСтоимОборуд + Окр((СтрокаБЕ.ТекСтоимОборуд) *  СтрокаБЕ.Объем ,КолЗнаков);
		ТекСтоимВозвратМатер = ТекСтоимВозвратМатер  + Окр((СтрокаБЕ.ТекСтоимВозвратМатер) *  СтрокаБЕ.Объем ,КолЗнаков);
		
		// Базисные.
		// ТекОЗ1 = Окр((СтрокаБЕ.СтоимОснЗарплата) * СтрокаБЕ.Объем,КолЗнаков);
		ТекОЗ1 = ((СтрокаБЕ.СтоимОснЗарплата) * СтрокаБЕ.Объем);
		ТекЭМ1 = ((СтрокаБЕ.СтоимЭксплМашин) * СтрокаБЕ.Объем);
		ТекСМ1 = ((СтрокаБЕ.СтоимСтоимМатер) * СтрокаБЕ.Объем);
		ТекПЗ1 = ((СтрокаБЕ.СтоимПрямЗатраты) * СтрокаБЕ.Объем);
		Если  ТекПЗ1 <> 0 Тогда
			Если  ТекОЗ1+  ТекЭМ1 + ТекСМ1 <> 0 Тогда
				ТекПЗ1 =  ТекОЗ1 +  ТекЭМ1 + ТекСМ1;
			КонецЕсли;	
		ИначеЕсли Окр((СтрокаБЕ.СтоимОборуд) * СтрокаБЕ.Объем,КолЗнаков) <> 0 Тогда
			ТекПЗ1 = 0;
		КонецЕсли;	
		ОЗ = ОЗ + ТекОЗ1;
		ЭМ = ЭМ + ТекЭМ1;
		ЗМ = ЗМ + ((СтрокаБЕ.СтоимЗарплМашин) * СтрокаБЕ.Объем);
		СМ = СМ + ТекСМ1;
		ПЗ = ПЗ + ТекПЗ1;
		ОБ = ОБ + ((СтрокаБЕ.СтоимОборуд) * СтрокаБЕ.Объем);
		ВМ = ВМ + ((СтрокаБЕ.СтоимВозвратМатер) * СтрокаБЕ.Объем);
		
	КонецЦикла;
	
	// Итог = Итого По разделу.
	ИтогоПоРазделу = ТаблРасчета.Найти(Справочники.СМ_ИтогиПоРазделу.ИтогоПоРазделу,"Итог");
	Если  ИтогоПоРазделу = Неопределено Тогда
		ИтогоПоРазделу 						= ТаблРасчета.Добавить();
		ИтогоПоРазделу.Итог 				= Справочники.СМ_ИтогиПоРазделу.ИтогоПоРазделу;
	КонецЕсли;
	// Определение составляющих прямых затрат по позициям раздела.
	// Базисные.
	ЗТР = ?(ЗначениеЗаполнено(ИтоговаяСтрокаБЕ.ЗатратыТрудаРабочих),Окр(ИтоговаяСтрокаБЕ.ЗатратыТрудаРабочих,2),0);
	ЗТМ = ?(ЗначениеЗаполнено(ИтоговаяСтрокаБЕ.ЗатратыТрудаМашин),Окр(ИтоговаяСтрокаБЕ.ЗатратыТрудаМашин,2),0);
	ТекПЗБезСоставл = 0;
	
	// Текущие.
	Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный Тогда
		ТекПЗ = СтоимПрямЗатраты;
		ТекОЗ = СтоимОснЗарплата;
		ТекЭМ = СтоимЭксплМашин;
		ТекЗМ = СтоимЗарплМашин;
		ТекСМ = СтоимСтоимМатер;
		ТекОБ = СтоимОборуд;
		ТекВМ = СтоимВозвратМатер;	
		ДопЗМ = ДопЗМ;
		ТекПЗБезСоставл = ТекПЗ - ТекОЗ - ТекЭМ - ТекСМ; 
	Иначе
		// Метод счета ресурсный.
		ТекПЗ = ТекСтоимПрямЗатраты;
		ТекОЗ = ТекСтоимОснЗарплата;
		ТекЭМ = ТекСтоимЭксплМашин;
		ТекЗМ = ТекСтоимЗарплМашин;
		ТекСМ = ТекСтоимСтоимМатер;
		ТекОБ = ТекСтоимОборуд;
		ТекВМ = ТекСтоимВозвратМатер;
	КонецЕсли;
	
	// Нормативная трудоемкость, базисная = текущей.
	НормативТрудоемкостиПоРазделу = ?(ЗначениеЗаполнено(ИтоговаяСтрокаБЕ.ЗатратыТрудаРабочих),ИтоговаяСтрокаБЕ.ЗатратыТрудаРабочих,0) + ?(ЗначениеЗаполнено(ИтоговаяСтрокаБЕ.ЗатратыТрудаМашин),ИтоговаяСтрокаБЕ.ЗатратыТрудаМашин,0);
	
	// Суммирование для итога Итого по разделу с данными, собранныим с подчиненных разделов.	
	Если (МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный) и МетодикаРСНБ Тогда
		ПрямЗатраты 			= Окр(ИтогоПоРазделу.ПрямЗатраты+ИтогоПоРазделу.Оборуд,КолЗнаков) + ПЗ + ОБ;
		ИтогоПоРазделу.ПрямЗатраты 			= ПрямЗатраты;
		ИтогоПоРазделу.ОснЗарплата 			= Окр(ИтогоПоРазделу.ОснЗарплата,КолЗнаков) + ОЗ;
		ИтогоПоРазделу.ЭксплМашин 			= Окр(ИтогоПоРазделу.ЭксплМашин,КолЗнаков) + ЭМ;
		ИтогоПоРазделу.ЗарплМашин 			= Окр(ИтогоПоРазделу.ЗарплМашин,КолЗнаков) + ЗМ;
		ИтогоПоРазделу.СтоимМатер 			= Окр(ИтогоПоРазделу.СтоимМатер,КолЗнаков) + СМ;
		ИтогоПоРазделу.Оборуд 				= Окр(ИтогоПоРазделу.Оборуд,КолЗнаков) + ОБ;
		ИтогоПоРазделу.ВозвратМатер 		= Окр(ИтогоПоРазделу.ВозвратМатер,КолЗнаков) + ВМ;
		ИтогоПоРазделу.ЗатратыТрудаРабочих 	= Окр(ИтогоПоРазделу.ЗатратыТрудаРабочих,2) + ЗТР;
		ИтогоПоРазделу.ЗатратыТрудаМашин 	= Окр(ИтогоПоРазделу.ЗатратыТрудаМашин,2) + ЗТМ;
		
		ИтогоПоРазделу.ТекПрямЗатраты 		= Окр(ИтогоПоРазделу.ТекПрямЗатраты,КолЗнаков)+ ТекПЗ + МатериалыВТекЦенах + ПрямыеЗатратыВТекЦенах ;
		ИтогоПоРазделу.ТекОснЗарплата 		= Окр(ИтогоПоРазделу.ТекОснЗарплата,КолЗнаков) + ТекОЗ;
		ИтогоПоРазделу.ТекЭксплМашин 		= Окр(ИтогоПоРазделу.ТекЭксплМашин,КолЗнаков) + ТекЭМ;
		ИтогоПоРазделу.ТекЗарплМашин 		= Окр(ИтогоПоРазделу.ТекЗарплМашин,КолЗнаков)  + ТекЗМ;
		ИтогоПоРазделу.ТекСтоимМатер 		= Окр(ИтогоПоРазделу.ТекСтоимМатер,КолЗнаков) + ТекСМ + МатериалыВТекЦенах;
		ИтогоПоРазделу.ТекОборуд 			= Окр(ИтогоПоРазделу.ТекОборуд,КолЗнаков) + ТекОБ + ОборудованиеВТекЦенах;
		ИтогоПоРазделу.ТекВозвратМатер 		= Окр(ИтогоПоРазделу.ТекВозвратМатер,КолЗнаков) + ТекВМ;
		
		// Формирование Итога Итого оборудование.
		ИтогоОборуд  = ТаблРасчета.Найти(Справочники.СМ_ИтогиПоРазделу.ИтогоОборуд,"Итог");
		Если  ИтогоОборуд = Неопределено Тогда
			ИтогоОборуд 					= ТаблРасчета.Добавить();
			ИтогоОборуд.Итог 				= Справочники.СМ_ИтогиПоРазделу.ИтогоОборуд;
		КонецЕсли;
		// Оборудование по позициям раздела.
		// Базисное значение.
		ОборудованиеПоРазделу = ОБ; 
		// Суммирование с подчиненными разделами.
		ИтогоОборуд.ПрямЗатраты = ИтогоОборуд.ПрямЗатраты + ОборудованиеПоРазделу ;
		// Текущее значение.
		ИтогоОборуд.ТекПрямЗатраты = ИтогоОборуд.ТекПрямЗатраты + ТекОБ + ОборудованиеВТекЦенах;
		ИтогоОборуд.ТекОборуд = ИтогоОборуд.ТекОборуд + ИтогоОборуд.ТекПрямЗатраты;

	Иначе	
		ПрямЗатраты 						= Окр(ИтогоПоРазделу.ПрямЗатраты,КолЗнаков) + ПЗ;
		ИтогоПоРазделу.ПрямЗатраты 			= ПрямЗатраты;
		ИтогоПоРазделу.ОснЗарплата 			= Окр(ИтогоПоРазделу.ОснЗарплата,КолЗнаков) + ОЗ;
		ИтогоПоРазделу.ЭксплМашин 			= Окр(ИтогоПоРазделу.ЭксплМашин,КолЗнаков) + ЭМ;
		ИтогоПоРазделу.ЗарплМашин 			= Окр(ИтогоПоРазделу.ЗарплМашин,КолЗнаков) + ЗМ;
		ИтогоПоРазделу.СтоимМатер 			= Окр(ИтогоПоРазделу.СтоимМатер,КолЗнаков) + СМ;
		ИтогоПоРазделу.Оборуд 				= Окр(ИтогоПоРазделу.Оборуд,КолЗнаков) + ОБ;
		ИтогоПоРазделу.ВозвратМатер 		= Окр(ИтогоПоРазделу.ВозвратМатер,КолЗнаков) + ВМ;
		ИтогоПоРазделу.ЗатратыТрудаРабочих 	= Окр(ИтогоПоРазделу.ЗатратыТрудаРабочих,2) + ЗТР;
		ИтогоПоРазделу.ЗатратыТрудаМашин 	= Окр(ИтогоПоРазделу.ЗатратыТрудаМашин,2) + ЗТМ;
		
		ИтогоПоРазделу.ТекПрямЗатраты 		= Окр(ИтогоПоРазделу.ТекПрямЗатраты,КолЗнаков)+ ТекПЗ + МатериалыВТекЦенах + ПрямыеЗатратыВТекЦенах ;
		ИтогоПоРазделу.ТекОснЗарплата 		= Окр(ИтогоПоРазделу.ТекОснЗарплата,КолЗнаков) + ТекОЗ;
		ИтогоПоРазделу.ТекЭксплМашин 		= Окр(ИтогоПоРазделу.ТекЭксплМашин,КолЗнаков) + ТекЭМ;
		ИтогоПоРазделу.ТекЗарплМашин 		= Окр(ИтогоПоРазделу.ТекЗарплМашин,КолЗнаков)  + ТекЗМ;
		ИтогоПоРазделу.ТекСтоимМатер 		= Окр(ИтогоПоРазделу.ТекСтоимМатер,КолЗнаков) + ТекСМ + МатериалыВТекЦенах;
		ИтогоПоРазделу.ТекОборуд 			= Окр(ИтогоПоРазделу.ТекОборуд,КолЗнаков) + ТекОБ + ОборудованиеВТекЦенах;
		ИтогоПоРазделу.ТекВозвратМатер 		= Окр(ИтогоПоРазделу.ТекВозвратМатер,КолЗнаков) + ТекВМ;
	
		// Формирование Итога Итого оборудование.
		ИтогоОборуд  = ТаблРасчета.Найти(Справочники.СМ_ИтогиПоРазделу.ИтогоОборуд,"Итог");
		Если  ИтогоОборуд = Неопределено Тогда
			ИтогоОборуд 					= ТаблРасчета.Добавить();
			ИтогоОборуд.Итог 				= Справочники.СМ_ИтогиПоРазделу.ИтогоОборуд;
		КонецЕсли;
		// Оборудование по позициям раздела.
		// Базисное значение.
		ОборудованиеПоРазделу = ОБ; 
		// Суммирование с подчиненными разделами.
		ИтогоОборуд.ПрямЗатраты = ?(ЗначениеЗаполнено(ИтогоОборуд.ПрямЗатраты),(ИтогоОборуд.ПрямЗатраты),0) + ОборудованиеПоРазделу ;
		// Текущее значение.
		Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
			ТекущееОборудованиеПоРазделу = ТекСтоимОборуд ;	
		Иначе
			ТекущееОборудованиеПоРазделу =  СтоимОборуд;
		КонецЕсли;
		ИтогоОборуд.ТекПрямЗатраты = ?(ЗначениеЗаполнено(ИтогоОборуд.ТекПрямЗатраты),Окр(ИтогоОборуд.ТекПрямЗатраты,КолЗнаков),0) + ТекущееОборудованиеПоРазделу;
		ИтогоОборуд.ТекОборуд = ИтогоОборуд.ТекПрямЗатраты;
	
	КонецЕсли;
	
	// Для уровня задания индексов =  раздел дополнительно считаются итоги:
	// Итого с индексами к элементам затрат.
	Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный  Тогда
		
		Если Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда
			
			ИтогоСИндексКЭлемЗатрат  = ТаблРасчета.Найти(Справочники.СМ_ИтогиПоРазделу.ИтогоСИндексКЭлемЗатрат,"Итог");
			Если  ИтогоСИндексКЭлемЗатрат = Неопределено Тогда
				ИтогоСИндексКЭлемЗатрат 		= ТаблРасчета.Добавить();
				ИтогоСИндексКЭлемЗатрат.Итог 	= Справочники.СМ_ИтогиПоРазделу.ИтогоСИндексКЭлемЗатрат;
			КонецЕсли;
			ИтогоСИндексКЭлемЗатрат.ПрямЗатраты = Окр(ИтогоСИндексКЭлемЗатрат.ПрямЗатраты,КолЗнаков) + ПЗ;
			ИтогоСИндексКЭлемЗатрат.ОснЗарплата = Окр(ИтогоСИндексКЭлемЗатрат.ОснЗарплата,КолЗнаков) + ОЗ;
			ИтогоСИндексКЭлемЗатрат.ЭксплМашин 	= Окр(ИтогоСИндексКЭлемЗатрат.ЭксплМашин,КолЗнаков) + ЭМ;
			ИтогоСИндексКЭлемЗатрат.ЗарплМашин 	= Окр(ИтогоСИндексКЭлемЗатрат.ЗарплМашин,КолЗнаков) + ЗМ;
			ИтогоСИндексКЭлемЗатрат.СтоимМатер 	= Окр(ИтогоСИндексКЭлемЗатрат.СтоимМатер,КолЗнаков) + СМ;
			ИтогоСИндексКЭлемЗатрат.ВозвратМатер = Окр(ИтогоСИндексКЭлемЗатрат.ВозвратМатер,КолЗнаков) + ВМ;
			Если НаборКоэф <>Неопределено Тогда
				
				Если СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости 	
					Или (СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат 
					И НаборКоэф.КоэффПолнСтоимРабот <> 0) Тогда
					СИндексамиОЗ = Окр(ТекОЗ * ?(НаборКоэф.КоэффПолнСтоимРабот = 0,1,НаборКоэф.КоэффПолнСтоимРабот),КолЗнаков);
					СИндексамиЭМ = Окр(ТекЭМ * ?(НаборКоэф.КоэффПолнСтоимРабот = 0,1,НаборКоэф.КоэффПолнСтоимРабот),КолЗнаков);
					СИндексамиЗМ = Окр(ТекЗМ * ?(НаборКоэф.КоэффПолнСтоимРабот = 0,1,НаборКоэф.КоэффПолнСтоимРабот),КолЗнаков);
					СИндексамиСМ = Окр(ТекСМ * ?(НаборКоэф.КоэффПолнСтоимРабот = 0,1,НаборКоэф.КоэффПолнСтоимРабот),КолЗнаков) + МатериалыВТекЦенах;
					СИндексамиПЗ = Окр(ТекПЗ * ?(НаборКоэф.КоэффПолнСтоимРабот = 0,1,НаборКоэф.КоэффПолнСтоимРабот),КолЗнаков) + МатериалыВТекЦенах + ПрямыеЗатратыВТекЦенах;
					СИндексамиВМ = Окр(ТекВМ * ?(НаборКоэф.КоэффПолнСтоимРабот = 0,1,НаборКоэф.КоэффПолнСтоимРабот),КолЗнаков) ;
					ИтогоСИндексКЭлемЗатрат.ТекПрямЗатраты 	= Окр(ИтогоСИндексКЭлемЗатрат.ТекПрямЗатраты,КолЗнаков) + СИндексамиПЗ  ;
					ИтогоСИндексКЭлемЗатрат.ТекОснЗарплата 	= Окр(ИтогоСИндексКЭлемЗатрат.ТекОснЗарплата,КолЗнаков) + СИндексамиОЗ;
					ИтогоСИндексКЭлемЗатрат.ТекЭксплМашин 	= Окр(ИтогоСИндексКЭлемЗатрат.ТекЭксплМашин,КолЗнаков) + СИндексамиЭМ;
					ИтогоСИндексКЭлемЗатрат.ТекЗарплМашин 	= Окр(ИтогоСИндексКЭлемЗатрат.ТекЗарплМашин,КолЗнаков) + СИндексамиЗМ;
					ИтогоСИндексКЭлемЗатрат.ТекСтоимМатер 	= Окр(ИтогоСИндексКЭлемЗатрат.ТекСтоимМатер,КолЗнаков) + СИндексамиСМ ;
					ИтогоСИндексКЭлемЗатрат.ТекВозвратМатер = Окр(ИтогоСИндексКЭлемЗатрат.ТекВозвратМатер,КолЗнаков) + СИндексамиВМ ;
					
				ИначеЕсли СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат	
					И НаборКоэф.КоэффПолнСтоимРабот = 0  Тогда
					СИндексамиОЗ = Окр(ТекОЗ * ?(НаборКоэф.КоэффОснЗарплаты = 0,1,НаборКоэф.КоэффОснЗарплаты),КолЗнаков);
					СИндексамиСМ = Окр(ТекСМ * ?(НаборКоэф.КоэффСтоимМатериалов = 0,1,НаборКоэф.КоэффСтоимМатериалов),КолЗнаков) + МатериалыВТекЦенах;
					СИндексамиВМ = Окр(ТекВМ * ?(НаборКоэф.КоэффСтоимМатериалов = 0,1,НаборКоэф.КоэффСтоимМатериалов),КолЗнаков);
					ИтогоСИндексКЭлемЗатрат.ТекОснЗарплата 	= Окр(ИтогоСИндексКЭлемЗатрат.ТекОснЗарплата,КолЗнаков) + СИндексамиОЗ ;
					ИтогоСИндексКЭлемЗатрат.ТекСтоимМатер 	= Окр(ИтогоСИндексКЭлемЗатрат.ТекСтоимМатер,КолЗнаков) + СИндексамиСМ ;
					ИтогоСИндексКЭлемЗатрат.ТекВозвратМатер 	= Окр(ИтогоСИндексКЭлемЗатрат.ТекВозвратМатер,КолЗнаков) + СИндексамиВМ ;
					НачДобавЗМ = ДопЗМ;
					ТекЗМ = ТекЗМ;
					ТекЭМ = ТекЭМ - НачДобавЗМ;
					ИндексироватьДопЗМФот = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ИндексироватьДопЗМФот",Ложь);	
					КоэффЗМ = ?(ИндексироватьДопЗМФот, НаборКоэф.КоэффОснЗарплаты, НаборКоэф.КоэффСтоимЭксплМашин);					// к расценке применяются индексы
					Если ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Разные Тогда
						СИндексамиЗМ = Окр(ТекЗМ  * ?(НаборКоэф.КоэффОснЗарплаты = 0,1,НаборКоэф.КоэффОснЗарплаты),КолЗнаков);
						СИндексамиЭМ = Окр((ТекЭМ) * ?(НаборКоэф.КоэффСтоимЭксплМашин = 0,1,НаборКоэф.КоэффСтоимЭксплМашин),КолЗнаков);
						ИтогоСИндексКЭлемЗатрат.ТекЭксплМашин = Окр(ИтогоСИндексКЭлемЗатрат.ТекЭксплМашин,КолЗнаков) + СИндексамиЭМ + Окр(НачДобавЗМ * КоэффЗМ,2);
						ИтогоСИндексКЭлемЗатрат.ТекЗарплМашин = Окр(ИтогоСИндексКЭлемЗатрат.ТекЗарплМашин,КолЗнаков) + СИндексамиЗМ;
						СИндексамиЭМ = СИндексамиЭМ + Окр(НачДобавЗМ * КоэффЗМ,КолЗнаков);
					ИначеЕсли ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Одинаковые Тогда
						СИндексамиЗМ = Окр(ТекЗМ * ?(НаборКоэф.КоэффСтоимЭксплМашин = 0,1,НаборКоэф.КоэффСтоимЭксплМашин),КолЗнаков);
						СИндексамиЭМ = Окр(ТекЭМ * ?(НаборКоэф.КоэффСтоимЭксплМашин = 0,1,НаборКоэф.КоэффСтоимЭксплМашин),КолЗнаков);
						КоэффЗМ = ?(НаборКоэф.КоэффСтоимЭксплМашин = 0,1,НаборКоэф.КоэффСтоимЭксплМашин);
						ИтогоСИндексКЭлемЗатрат.ТекЭксплМашин = Окр(ИтогоСИндексКЭлемЗатрат.ТекЭксплМашин,КолЗнаков) + СИндексамиЭМ + Окр(НачДобавЗМ * КоэффЗМ,2);
						ИтогоСИндексКЭлемЗатрат.ТекЗарплМашин = Окр(ИтогоСИндексКЭлемЗатрат.ТекЗарплМашин,КолЗнаков) + СИндексамиЗМ;
						СИндексамиЭМ = СИндексамиЭМ + Окр(НачДобавЗМ * КоэффЗМ,КолЗнаков);
					ИначеЕсли ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.РазныеКРазности Тогда
						КоэффЗМ = ?(НаборКоэф.КоэффСтоимЭксплМашин = 0,1,НаборКоэф.КоэффСтоимЭксплМашин);
						СИндексамиЗМ = Окр(ТекЗМ * ?(НаборКоэф.КоэффОснЗарплаты = 0,1,НаборКоэф.КоэффОснЗарплаты),КолЗнаков);
						СИндексамиЭМ = Окр((ТекЭМ - ТекЗМ)* КоэффЗМ,КолЗнаков);
						СИндексамиЭМ = СИндексамиЭМ + СИндексамиЗМ + Окр(НачДобавЗМ * КоэффЗМ,2);
						ИтогоСИндексКЭлемЗатрат.ТекЭксплМашин = Окр(ИтогоСИндексКЭлемЗатрат.ТекЭксплМашин,КолЗнаков) + СИндексамиЭМ ;
						ИтогоСИндексКЭлемЗатрат.ТекЗарплМашин = Окр(ИтогоСИндексКЭлемЗатрат.ТекЗарплМашин,КолЗнаков) + СИндексамиЗМ;
					КонецЕсли;	
					СИндексамиЗМ = СИндексамиЗМ;
					СИндексамиПЗ = СИндексамиОЗ + СИндексамиЭМ + СИндексамиСМ + ПрямыеЗатратыВТекЦенах + ТекПЗБезСоставл ;
