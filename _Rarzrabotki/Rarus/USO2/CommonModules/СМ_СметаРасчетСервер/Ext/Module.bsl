			МассивВидовРабот.Добавить(Справочники.СМ_ИтогиСметыПоВидамРабот.ГорнопрохРаб);
			Для Каждого СтрокаМассива Из МассивВидовРабот Цикл
				СтрокаИтога = ТаблицаИтоговПоВидамРабот.Найти(СтрокаМассива);
				Если НЕ СтрокаИтога = неопределено Тогда
					ВсегоСИндСМР.ПрямЗатраты 	= Окр(ВсегоСИндСМР.ПрямЗатраты,КолЗнаков) + Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков);	
					ВсегоСИндСМР.ОснЗарплата 	= Окр(ВсегоСИндСМР.ОснЗарплата,КолЗнаков) + Окр(СтрокаИтога.ОснЗарплата,КолЗнаков);	
					ВсегоСИндСМР.ЭксплМашин 	= Окр(ВсегоСИндСМР.ЭксплМашин,КолЗнаков) + Окр(СтрокаИтога.ЭксплМашин,КолЗнаков);	
					ВсегоСИндСМР.ЗарплМашин 	= Окр(ВсегоСИндСМР.ЗарплМашин,КолЗнаков) + Окр(СтрокаИтога.ЗарплМашин,КолЗнаков);	
					ВсегоСИндСМР.СтоимМатер 	= Окр(ВсегоСИндСМР.СтоимМатер,КолЗнаков) + Окр(СтрокаИтога.СтоимМатер,КолЗнаков);	
					ВсегоСИндСМР.ВозвратМатер 	= Окр(ВсегоСИндСМР.ВозвратМатер,КолЗнаков) + Окр(СтрокаИтога.ВозвратМатер,КолЗнаков);	
					
					ВсегоСИндСМР.ТекПрямЗатраты = Окр(ВсегоСИндСМР.ТекПрямЗатраты,КолЗнаков) + Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков);	
					ВсегоСИндСМР.ТекОснЗарплата = Окр(ВсегоСИндСМР.ТекОснЗарплата,КолЗнаков) + Окр(СтрокаИтога.ТекОснЗарплата,КолЗнаков);	
					ВсегоСИндСМР.ТекЭксплМашин 	= Окр(ВсегоСИндСМР.ТекЭксплМашин,КолЗнаков) + Окр(СтрокаИтога.ТекЭксплМашин,КолЗнаков);	
					ВсегоСИндСМР.ТекЗарплМашин 	= Окр(ВсегоСИндСМР.ТекЗарплМашин,КолЗнаков) + Окр(СтрокаИтога.ТекЗарплМашин,КолЗнаков);	
					ВсегоСИндСМР.ТекСтоимМатер 	= Окр(ВсегоСИндСМР.ТекСтоимМатер,КолЗнаков) + Окр(СтрокаИтога.ТекСтоимМатер,КолЗнаков);	
					ВсегоСИндСМР.ТекВозвратМатер 	= Окр(ВсегоСИндСМР.ТекВозвратМатер,КолЗнаков) + Окр(СтрокаИтога.ТекВозвратМатер,КолЗнаков);	
