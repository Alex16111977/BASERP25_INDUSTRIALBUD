		ВсегоПоРазделу.Итог 			= Справочники.СМ_ИтогиПоРазделу.ВсегоПоРазделу;
	КонецЕсли;
	ВсегоПоРазделу.Раздел			= ТекСсылка;
	// Базисные значения.
	Если (МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный) и МетодикаРСНБ Тогда
		ВсегоПоРазделу.ПрямЗатраты = ИтогоСУчетомНаклРасхСумма;
	Иначе
		ВсегоПоРазделу.ПрямЗатраты = Окр(ИтогоПоРазделу.ПрямЗатраты,КолЗнаков) + СметПрибыль.ПрямЗатраты + НаклРасх.ПрямЗатраты + ИтогоОборуд.ПрямЗатраты ;
	КонецЕсли;
	ВсегоПоРазделу.ОснЗарплата 	= Окр(ИтогоПоРазделу.ОснЗарплата,КолЗнаков);
	ВсегоПоРазделу.СтоимМатер 	= Окр(ИтогоПоРазделу.СтоимМатер,КолЗнаков); 
	ВсегоПоРазделу.ЭксплМашин 	= Окр(ИтогоПоРазделу.ЭксплМашин,КолЗнаков);
	ВсегоПоРазделу.ЗарплМашин 	= Окр(ИтогоПоРазделу.ЗарплМашин,КолЗнаков);
	ВсегоПоРазделу.ВозвратМатер = Окр(ИтогоПоРазделу.ВозвратМатер,КолЗнаков); 
	
	ВсегоПоРазделу.ЗатратыТрудаРабочих = Окр(ВсегоПоРазделу.ЗатратыТрудаРабочих,2) + ЗТР;
	ВсегоПоРазделу.ЗатратыТрудаМашин =  Окр(ВсегоПоРазделу.ЗатратыТрудаМашин,2) + ЗТМ;
	
	// Текущие значения.
	Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный И Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда
		ВсегоПоРазделу.ТекПрямЗатраты = Окр(ИтогоСИндексКЭлемЗатрат.ТекПрямЗатраты,КолЗнаков) + НаклРасх.ТекПрямЗатраты +  СметПрибыль.ТекПрямЗатраты + ИтогоСИндексКОборуд.ТекПрямЗатраты;
		ВсегоПоРазделу.ТекОснЗарплата = СИндексамиОЗ;
		// ***************************************************************
		// ++ AVV  Итоги по разделу (базисно-индексный метод по разделу)
		//ВсегоПоРазделу.ТекСтоимМатер = СИндексамиСМ + МатериалыВТекЦенах;  // было
		ВсегоПоРазделу.ТекСтоимМатер = СИндексамиСМ;                     	 // добавил
		// -- AVV 
		// ***************************************************************
		ВсегоПоРазделу.ТекЭксплМашин 	= СИндексамиЭМ;
		ВсегоПоРазделу.ТекЗарплМашин 	= СИндексамиЗМ;
		ВсегоПоРазделу.ТекВозвратМатер 	= СИндексамиВМ;
	Иначе
		ВсегоПоРазделу.ТекОснЗарплата 	= Окр(ИтогоПоРазделу.ТекОснЗарплата,КолЗнаков);
		ВсегоПоРазделу.ТекСтоимМатер 	= Окр(ИтогоПоРазделу.ТекСтоимМатер,КолЗнаков) ; 
		ВсегоПоРазделу.ТекЭксплМашин 	= Окр(ИтогоПоРазделу.ТекЭксплМашин,КолЗнаков);
		ВсегоПоРазделу.ТекЗарплМашин 	= Окр(ИтогоПоРазделу.ТекЗарплМашин,КолЗнаков);
		ВсегоПоРазделу.ТекПрямЗатраты 	= Окр(ИтогоПоРазделу.ТекПрямЗатраты,КолЗнаков) + НаклРасх.ТекПрямЗатраты +  ?(СметПрибыль = Неопределено,0,СметПрибыль.ТекПрямЗатраты) + ?(ИтогоОборуд = Неопределено,0,ИтогоОборуд.ТекПрямЗатраты);
		ВсегоПоРазделу.ТекВозвратМатер 	= Окр(ИтогоПоРазделу.ТекВозвратМатер,КолЗнаков) ; 
	КонецЕсли;
	
	// Нормативная трудоемкость.
	НормативТрудоемк  = ТаблРасчета.Найти(Справочники.СМ_ИтогиПоРазделу.НормативТрудоемк,"Итог");
	Если  НормативТрудоемк = Неопределено Тогда
		НормативТрудоемк 			 	= ТаблРасчета.Добавить();
		НормативТрудоемк.Итог 		 	= Справочники.СМ_ИтогиПоРазделу.НормативТрудоемк;
	КонецЕсли;
	
	НормативТрудоемк.ПрямЗатраты 	= Окр(НормативТрудоемк.ПрямЗатраты,КолЗнаков) + НормативТрудоемкостиПоРазделу;
	НормативТрудоемк.ТекПрямЗатраты = Окр(НормативТрудоемк.ТекПрямЗатраты,КолЗнаков) + НормативТрудоемкостиПоРазделу;
	
	// Сметная зарплата.
	СметнЗарплата  = ТаблРасчета.Найти(Справочники.СМ_ИтогиПоРазделу.СметнЗарплата,"Итог");
	Если  СметнЗарплата = Неопределено Тогда
		СметнЗарплата 					= ТаблРасчета.Добавить();
		СметнЗарплата.Итог 				= Справочники.СМ_ИтогиПоРазделу.СметнЗарплата;
	КонецЕсли;
	// Базисное значение СЗ.
	ИтогоОЗ = ВсегоПоРазделу.ОснЗарплата + ВсегоПоРазделу.ЗарплМашин;
	СметнЗарплата.ПрямЗатраты 		= Окр(ИтогоОЗ,КолЗнаков);
	// Текущее значение СЗ.
	ИтогоОЗ = ВсегоПоРазделу.ТекОснЗарплата + ВсегоПоРазделу.ТекЗарплМашин;
	СметнЗарплата.ТекПрямЗатраты 	= ИтогоОЗ;
	
	Отбор = Новый Структура();
	Отбор.Вставить("Раздел",СтруктураПараметровОтбораРС.СсылкаНаРаздел);
	
	ТаблРасчета.ЗаполнитьЗначения(СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета,"Смета");
	Отбор.Вставить("Смета",СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
	
	ТаблРасчета.ЗаполнитьЗначения(СтруктураПараметровОтбораРС.СсылкаНаРаздел,"Раздел");
	СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНаборТаблицей("СМ_ИтогиПоРазделу",Отбор,ТаблРасчета);
	
КонецПроцедуры

// Формирование итогов по видам работ, рассчитывает итоги по видам работ для всех 
//	методов счета базисно-индексный(уровень задания индексов расценка, раздел, смета.
//	Способ задания индексов по эелементам затрат, к полной стоимости.
//
// Параметры:
//     Ссылка 			- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на локальную смету.
//
Процедура СформироватьИтогиПоВидамРабот(Ссылка) Экспорт 
	
	// Ссылка Акт или смета.
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		ФлагАкт = Истина;
		МетодРасчета = Ссылка.ЛокальнаяСмета.МетодРасчета;
		Уровень = ССылка.ЛокальнаяСмета.Уровень;
		СпособРасчетаИндексов = Ссылка.ЛокальнаяСмета.СпособРасчетаИндексов;
		ВариантПересчетаЭММ =Ссылка.ЛокальнаяСмета.ВариантПересчетаЭММ;
	Иначе
		ФлагАкт = Ложь;
		МетодРасчета = Ссылка.МетодРасчета;
		Уровень = ССылка.Уровень;
		СпособРасчетаИндексов = Ссылка.СпособРасчетаИндексов;
		ВариантПересчетаЭММ =Ссылка.ВариантПересчетаЭММ;
	КонецЕсли;
	ПромОкр = Ссылка.ПромежуточноеОкругление;
	ОкрИтог = Ссылка.ОкруглятьДоРублей;
	КолЗнаков = ?(ПромОкр,2,6);
	Если ОкрИтог Тогда
		КолЗнаков = 0;
	КонецЕсли;	
	ОбрабПогр = Ссылка.ОбрабатыватьПогрешность;

	Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный Тогда 
		Если Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета Тогда
			НаборКоэф = Ссылка;
		КонецЕсли;
	КонецЕсли;

	// Судариков - избавляемся от чтения РС
    ОписаниеТипаЧисло = Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,6));

	ТаблРасчета = Новый ТаблицаЗначений();
	ТаблРасчета.Колонки.Добавить("Смета");
	ТаблРасчета.Колонки.Добавить("Раздел");
	ТаблРасчета.Колонки.Добавить("Итог");
	ТаблРасчета.Колонки.Добавить("ВозвратМатер",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ЗарплМашин",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ЗатратыТрудаМашин",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ЗатратыТрудаРабочих",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("Оборуд",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ОснЗарплата",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ПрямЗатраты",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("СтоимМатер",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекВозвратМатер",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекЗарплМашин",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекОборуд",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекОснЗарплата",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекПрямЗатраты",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекСтоимМатер",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекЭксплМашин",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ЭксплМашин",ОписаниеТипаЧисло);

	
	// Базисно-индексный метод.
	Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный Тогда
			
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Раздел КАК Раздел,
		|	БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Смета КАК Смета,
		|	БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция КАК Позиция,
		|	ВЫБОР
		|		КОГДА БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.МонтажныеРаботы)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.МонтажнРаб)
		|		КОГДА БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.СтроитРаб)
		|		КОГДА БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.МеталломонтажныеРаботы)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.Металлоконстр)
		|		КОГДА БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.СантехническиеРаботы)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.СантехнРаб)
		|		КОГДА БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.БуровзрывныеРаботы)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.БуровзрывнРаб)
		|		КОГДА БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.ГорнопроходческиеРаботы)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.ГорнопрохРаб)
		|		КОГДА БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.ПрочиеРаботы)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.ПрочРаб)
		|		КОГДА БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.Оборудование)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.Оборуд)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.ПустаяСсылка)
		|	КОНЕЦ КАК Итог,
		|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимПрямЗатраты) КАК ПрямЗатраты,
		|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимОснЗарплата) КАК ОснЗарплата,
		|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимЭксплМашин) КАК ЭксплМашин,
		|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимЗарплМашин) КАК ЗарплМашин,
		|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимСтоимМатер) КАК СтоимМатер,
		|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимОборуд) КАК Оборуд,
		|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимВозвратМатер) КАК ВозвратМатер,
		|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
		|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ЗатратыТрудаМашин ) КАК ЗатратыТрудаМашин,
		|	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ДопЗМ ) КАК ДопЗМ,
		|	СУММА(НРиСП.СуммаНРНаОбъем + НРиСП.СуммаНРМашинистовНаОбъем) КАК СуммаНРБазисная,
		|	СУММА(НРиСП.СуммаСПНаОбъем + НРиСП.СуммаСПМашинистовНаОбъем) КАК СуммаСПБазисная,
		|	0 КАК ТекПрямЗатраты,
		|	0 КАК ТекОснЗарплата,
		|	0 КАК ТекЭксплМашин,
		|	0 КАК ТекЗарплМашин,
		|	0 КАК ТекСтоимМатер,
		|	0 КАК ТекОборуд,
		|	0 КАК ТекВозвратМатер,
		|	0 КАК ТекЗатратыТрудаРабочих,
		|	0 КАК ТекЗатратыТрудаМашин,
		|	0 КАК ТекДопЗМ, 
		|	0 КАК СуммаНРТекущая,
		|	0 КАК СуммаСПТекущая  
		|ИЗ 
		|	РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП КАК БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП ";
	//Если ФлагАкт = Истина Тогда
	//		ТекстЗапроса = ТекстЗапроса + "
	//	|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_АктВыполненныхРабот.Позиции КАК АктВыполненныхРаботПозиции
	//	|	ПО БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция = АктВыполненныхРаботПозиции.Позиция 
	//	|	 И БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Смета = АктВыполненныхРаботПозиции.Ссылка";
	//КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + "
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_НРиСП КАК НРиСП
		|	ПО БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Смета = НРиСП.Смета  
		|	   И БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Раздел = НРиСП.Раздел 
		|	   И БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция = НРиСП.Позиция
		|ГДЕ
		|	БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Смета = &Смета 
		|   И БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.Расчет = ИСТИНА
		|СГРУППИРОВАТЬ ПО
		|	БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Смета, 
		|	БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Раздел,
		|	БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция,
		|	БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция.Определитель.ВидРабот
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Раздел КАК Раздел,
		|	БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета КАК Смета,
		|	БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция КАК Позиция,
		|	ВЫБОР
		|		КОГДА БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.МонтажныеРаботы)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.МонтажнРаб)
		|		КОГДА БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы)
