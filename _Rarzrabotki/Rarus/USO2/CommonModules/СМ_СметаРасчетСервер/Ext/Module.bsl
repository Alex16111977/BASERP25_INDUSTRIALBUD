		Позиция.ОбъемРабот			= Позиция.НормаРасходаРесурса * Позиция.КоличествоРесурса;

		//Если ЗначениеЗаполнено(Позиция.ФормулаОбъема) Тогда
		//	ВычОбъем 		= 0;
		//	Формула 		= "ВычОбъем = Значение";
		//	ФормулаОбъема 	= СтрЗаменить(Позиция.ФормулаОбъема,",",".");
		//	Формула 		= СтрЗаменить(Формула,"Значение",ФормулаОбъема);
		//	Попытка
		//		Выполнить(Формула);
		//		ТекОбъем 	= (ВычОбъем/СтарыйОбъем)*НовыйОбъем;
		//		Норма 		= ВычОбъем/СтарыйОбъем;
		//	Исключение
		//		Если СтарыйОбъем = 0 Тогда
		//			ТекОбъем 	= НовыйОбъем;
		//		Иначе
		//			ТекОбъем 	= (Позиция.ОбъемРабот/СтарыйОбъем)*НовыйОбъем;
		//			Норма 		= Позиция.ОбъемРабот/СтарыйОбъем;
		//		КонецЕсли;
		//	КонецПопытки;
		//Иначе
		//	ТекОбъем 	= (Позиция.ОбъемРабот/СтарыйОбъем)*НовыйОбъем;
		//	Норма 		= Позиция.ОбъемРабот/СтарыйОбъем;
		//КонецЕсли;
		//
		//Если СтарыйОбъем = 0 Тогда
		//	Позиция.ФормулаОбъема = "1" + "*" + СокрЛП(Строка(Формат(ТекОбъем,"ЧГ=0")));
		//Иначе
		//	Позиция.ФормулаОбъема = СокрЛП(Строка(Формат(НовыйОбъем,"ЧГ=0"))) + "*" + СокрЛП(Строка(Формат(Норма,"ЧГ=0")));
		//КонецЕсли;
		//Позиция.ОбъемРабот = ТекОбъем;
		
		// -- AVV
		// ******************************************************

		Позиция.Записать();
		Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(Позиция);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область РасчетИтогов

// Формирвание итогов по Смете, рассчитывает итоги для всех 
//	методов счета базисно-индексный(уровень задания индексов расценка, раздел, смета.
//	Способ задания индексов по эелементам затрат, к полной стоимости.
//
// Параметры:
//     Ссылка - ДокументСсылка - ссылка на документ СМ_ЛокальнаяСмета, Акт.
//
Процедура СформироватьИтогиПоСмете(Ссылка) Экспорт
	
	ОписаниеТипаЧисло = Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,6));

	ТаблРасчета = Новый ТаблицаЗначений();
	ТаблРасчета.Колонки.Добавить("Смета");
	ТаблРасчета.Колонки.Добавить("Итог");
	ТаблРасчета.Колонки.Добавить("ВозвратМатер",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ЗарплМашин",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ЗатратыТрудаМашин",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ЗатратыТрудаРабочих",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("Оборуд",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ОснЗарплата",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ПрямЗатраты",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("СтоимМатер",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекВозвратМатер",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекЗарплМашин",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекОборуд",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекОснЗарплата",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекПрямЗатраты",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекСтоимМатер",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекЭксплМашин",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ЭксплМашин",ОписаниеТипаЧисло);   
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Смета", Ссылка);
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		НаборКоэф = Ссылка;
		Акт = Истина;
		ЛокСмета = Ссылка.ЛокальнаяСмета;
		Запрос.УстановитьПараметр("Раздел",Ссылка.ЛокальнаяСмета);
		МетодикаРСНБ = (Ссылка.ЛокальнаяСмета.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_КЗ_РСНБ);
	Иначе
		Акт = Ложь;
		ЛокСмета = Ссылка;
		НаборКоэф = ЛокСмета;
		Запрос.УстановитьПараметр("Раздел",Ссылка);
		МетодикаРСНБ = (Ссылка.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_КЗ_РСНБ);
	КонецЕсли;
	Уровень = ЛокСмета.Уровень;
	МетодРасчета = ЛокСмета.МетодРасчета; 
	СпособРасчетаИндексов = ЛокСмета.СпособРасчетаИндексов;
	ОкрИтог = Ссылка.ОкруглятьДоРублей;
	ОкрПромежуточно = Ссылка.ПромежуточноеОкругление;
	Если ОкрИтог Тогда
		КолЗнаков = 0;
	ИначеЕсли ОкрПромежуточно Тогда
		КолЗнаков = 2;
	Иначе
		КолЗнаков = 6;
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ИтогиПоРазделу.Итог,
	|	СУММА(ИтогиПоРазделу.ПрямЗатраты) КАК ПрямЗатраты,
	|	СУММА(ИтогиПоРазделу.ОснЗарплата) КАК ОснЗарплата,
	|	СУММА(ИтогиПоРазделу.ЭксплМашин) КАК ЭксплМашин,
	|	СУММА(ИтогиПоРазделу.ЗарплМашин) КАК ЗарплМашин,
	|	СУММА(ИтогиПоРазделу.СтоимМатер) КАК СтоимМатер,
	|	СУММА(ИтогиПоРазделу.Оборуд) КАК Оборуд,
	|	СУММА(ИтогиПоРазделу.ВозвратМатер) КАК ВозвратМатер,
	|	СУММА(ИтогиПоРазделу.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
	|	СУММА(ИтогиПоРазделу.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
	|	СУММА(ИтогиПоРазделу.ТекПрямЗатраты) КАК ТекПрямЗатраты,
	|	СУММА(ИтогиПоРазделу.ТекОснЗарплата) КАК ТекОснЗарплата,
	|	СУММА(ИтогиПоРазделу.ТекЭксплМашин) КАК ТекЭксплМашин,
	|	СУММА(ИтогиПоРазделу.ТекЗарплМашин) КАК ТекЗарплМашин,
	|	СУММА(ИтогиПоРазделу.ТекСтоимМатер) КАК ТекСтоимМатер,
	|	СУММА(ИтогиПоРазделу.ТекОборуд) КАК ТекОборуд,
	|	СУММА(ИтогиПоРазделу.ТекВозвратМатер) КАК ТекВозвратМатер
	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоРазделу КАК ИтогиПоРазделу
	|ГДЕ
	|	ИтогиПоРазделу.Смета = &Смета
	|	И ИтогиПоРазделу.Раздел.ИДРодителя = &Раздел
	|
	|СГРУППИРОВАТЬ ПО
	|	ИтогиПоРазделу.Итог";
	
	
	ТаблицаИтогов = Запрос.Выполнить().Выгрузить();
	Если ТаблицаИтогов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ИтогиПоВидамРабот.Итог,
	|	СУММА(ИтогиПоВидамРабот.ПрямЗатраты) КАК ПрямЗатраты,
	|	СУММА(ИтогиПоВидамРабот.ОснЗарплата) КАК ОснЗарплата,
	|	СУММА(ИтогиПоВидамРабот.ЭксплМашин) КАК ЭксплМашин,
	|	СУММА(ИтогиПоВидамРабот.ЗарплМашин) КАК ЗарплМашин,
	|	СУММА(ИтогиПоВидамРабот.СтоимМатер) КАК СтоимМатер,
	|	СУММА(ИтогиПоВидамРабот.Оборуд) КАК Оборуд,
	|	СУММА(ИтогиПоВидамРабот.ВозвратМатер) КАК ВозвратМатер,
	|	СУММА(ИтогиПоВидамРабот.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
	|	СУММА(ИтогиПоВидамРабот.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
	|	СУММА(ИтогиПоВидамРабот.ТекПрямЗатраты) КАК ТекПрямЗатраты,
	|	СУММА(ИтогиПоВидамРабот.ТекОснЗарплата) КАК ТекОснЗарплата,
	|	СУММА(ИтогиПоВидамРабот.ТекЭксплМашин) КАК ТекЭксплМашин,
	|	СУММА(ИтогиПоВидамРабот.ТекЗарплМашин) КАК ТекЗарплМашин,
	|	СУММА(ИтогиПоВидамРабот.ТекСтоимМатер) КАК ТекСтоимМатер,
	|	СУММА(ИтогиПоВидамРабот.ТекОборуд) КАК ТекОборуд,
	|	СУММА(ИтогиПоВидамРабот.ТекВозвратМатер) КАК ТекВозвратМатер

	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоВидамРабот КАК ИтогиПоВидамРабот
	|ГДЕ
	|	ИтогиПоВидамРабот.Смета = &Смета
	|
	|СГРУППИРОВАТЬ ПО
	|	ИтогиПоВидамРабот.Итог";
	
	ТаблицаИтоговПоВидамРабот = Запрос.Выполнить().Выгрузить();
	
	НормТрудоемкость = ТаблицаИтогов.Найти(Справочники.СМ_ИтогиПоРазделу.НормативТрудоемк).ПрямЗатраты; 
	ИтогоПоСмете 		= ТаблРасчета.Добавить();
	ИтогоПоСмете.Итог 	= Справочники.СМ_ИтогиПоСмете.ИтогоПоСмете;
	
	Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
		И Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда
		ТекОборуд = Окр(ТаблицаИтогов.Найти(Справочники.СМ_ИтогиПоРазделу.ИтогоСИндексКОборуд).ТекПрямЗатраты,КолЗнаков);
		Оборуд = Окр(ТаблицаИтогов.Найти(Справочники.СМ_ИтогиПоРазделу.ИтогоОборуд).ПрямЗатраты,КолЗнаков);
		СтрокаИтога = ТаблицаИтогов.Найти(Справочники.СМ_ИтогиПоРазделу.ИтогоСИндексКЭлемЗатрат);
	Иначе
		СтрокаОборуд = ТаблицаИтогов.Найти(Справочники.СМ_ИтогиПоРазделу.ИтогоОборуд);
		ТекОборуд = Окр(?(СтрокаОборуд = Неопределено,0,СтрокаОборуд.ТекПрямЗатраты),КолЗнаков);
		Оборуд = Окр(?(СтрокаОборуд = Неопределено,0,СтрокаОборуд.ПрямЗатраты),КолЗнаков);
		СтрокаИтога = ТаблицаИтогов.Найти(Справочники.СМ_ИтогиПоРазделу.ИтогоПоРазделу);
	КонецЕсли;	
	
	Если НЕ СтрокаИтога = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ИтогоПоСмете, СтрокаИтога, , "Итог");
		ИтогоПоСмете.ТекПрямЗатраты = Окр(ИтогоПоСмете.ТекПрямЗатраты,КолЗнаков) + ТекОборуд;
