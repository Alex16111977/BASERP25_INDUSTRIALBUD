			Если ИтогоПоСмете.ТекОборуд = 0 Тогда
				ДобавПЗБезСоставл = ИтогоПоСмете.ПрямЗатраты - ИтогоПоСмете.ОснЗарплата - ИтогоПоСмете.ЭксплМашин - ИтогоПоСмете.СтоимМатер;
			Иначе
				ДобавПЗБезСоставл = ИтогоПоСмете.ПрямЗатраты - ИтогоПоСмете.ОснЗарплата - ИтогоПоСмете.ЭксплМашин - ИтогоПоСмете.СтоимМатер - ИтогоПоСмете.Оборуд ;
			КонецЕсли;
			ИндексыПоСметеКЭлементам.ТекОснЗарплата = Окр(ИтогоПоСмете.ТекОснЗарплата * ?(НаборКоэф.КоэффФОТ = 0,1,НаборКоэф.КоэффФОТ),КолЗнаков);
			ИндексыПоСметеКЭлементам.ТекСтоимМатер = Окр(ИтогоПоСмете.ТекСтоимМатер * ?(НаборКоэф.КоэффСтоимМатериалов = 0,1,НаборКоэф.КоэффСтоимМатериалов),КолЗнаков);
			ИндексыПоСметеКЭлементам.ТекВозвратМатер = Окр(ИтогоПоСмете.ТекВозвратМатер * ?(НаборКоэф.КоэффСтоимМатериалов = 0,1,НаборКоэф.КоэффСтоимМатериалов),КолЗнаков);
			Если Ссылка.ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Разные Тогда
				ИндексыПоСметеКЭлементам.ТекЭксплМашин = Окр(ИтогоПоСмете.ТекЭксплМашин * ?(НаборКоэф.КоэффСтоимЭксплМашин = 0,1,НаборКоэф.КоэффСтоимЭксплМашин),КолЗнаков);
				ИндексыПоСметеКЭлементам.ТекЗарплМашин = Окр(ИтогоПоСмете.ТекЗарплМашин * ?(НаборКоэф.КоэффФОТ = 0,1,НаборКоэф.КоэффФОТ),КолЗнаков);
			ИначеЕсли Ссылка.ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Одинаковые Тогда
				ИндексыПоСметеКЭлементам.ТекЭксплМашин = Окр(ИтогоПоСмете.ТекЭксплМашин * ?(НаборКоэф.КоэффСтоимЭксплМашин = 0,1,НаборКоэф.КоэффСтоимЭксплМашин),КолЗнаков);
				ИндексыПоСметеКЭлементам.ТекЗарплМашин = Окр(ИтогоПоСмете.ТекЗарплМашин * ?(НаборКоэф.КоэффСтоимЭксплМашин = 0,1,НаборКоэф.КоэффСтоимЭксплМашин),КолЗнаков);
			ИначеЕсли Ссылка.ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.РазныеКРазности Тогда
				ИндексыПоСметеКЭлементам.ТекЗарплМашин = Окр(ИтогоПоСмете.ТекЗарплМашин * ?(НаборКоэф.КоэффФОТ = 0,1,НаборКоэф.КоэффФОТ),КолЗнаков);
				ИндексыПоСметеКЭлементам.ТекЭксплМашин = Окр((ИтогоПоСмете.ТекЭксплМашин - ИтогоПоСмете.ЗарплМашин)* ?(НаборКоэф.КоэффСтоимЭксплМашин = 0,1,НаборКоэф.КоэффСтоимЭксплМашин),КолЗнаков);
				ИндексыПоСметеКЭлементам.ТекЭксплМашин = ИндексыПоСметеКЭлементам.ТекЭксплМашин + ИндексыПоСметеКЭлементам.ТекЗарплМашин;
			КонецЕсли;	
			
			ИндексыПоСметеКЭлементам.ПрямЗатраты = Окр(ИндексыПоСметеКЭлементам.ОснЗарплата,КолЗнаков) + ИндексыПоСметеКЭлементам.СтоимМатер + ИндексыПоСметеКЭлементам.ЭксплМашин;
			ИндексыПоСметеКЭлементам.ТекПрямЗатраты = Окр(ИндексыПоСметеКЭлементам.ТекОснЗарплата,КолЗнаков) + ИндексыПоСметеКЭлементам.ТекСтоимМатер + ИндексыПоСметеКЭлементам.ТекЭксплМашин + ДобавПЗБезСоставл;
		КонецЕсли;
	КонецЕсли;
	
	Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
		И Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета Тогда
		Если СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости Тогда	
			ВсегоСИндСМР = ТаблРасчета.Добавить();
