	// Методика 1984 года
	Если Методика1984 И РасчетНРиСПотПЗ  Тогда
		// Добавка к ОЗ 
		ИтогДобавкаНРвОЗ  = ТаблРасчета.Найти(Справочники.СМ_ИтогиПоРазделу.ОЗвНаклРасходах,"Итог");
		Если  ИтогДобавкаНРвОЗ = Неопределено Тогда
