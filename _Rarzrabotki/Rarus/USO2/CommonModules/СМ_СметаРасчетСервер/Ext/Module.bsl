	ИтогоСУчетомНаклРасх.ПрямЗатраты = Окр(ИтогоПоСмете.ПрямЗатраты,КолЗнаков) + Окр(НаклРасх.ПрямЗатраты,КолЗнаков);
	ИтогоСУчетомНаклРасх.ТекПрямЗатраты = Окр(ИтогоПоСмете.ТекПрямЗатраты,КолЗнаков) + Окр(НаклРасх.ТекПрямЗатраты,КолЗнаков);

	Если (МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный) и методикаРСНБ Тогда
		НаклРасх2 = ТаблРасчета.Добавить();
		НаклРасх2.Итог = Справочники.СМ_ИтогиПоСмете.НаклРасх2;
		НаклРасх2.ПрямЗатраты = Окр(ИтогоСУчетомНаклРасх.ПрямЗатраты*ЛокСмета.НР2_ВС/100,КолЗнаков);
		НаклРасх2.ТекПрямЗатраты = Окр(ИтогоСУчетомНаклРасх.ТекПрямЗатраты*ЛокСмета.НР2_ВС/100,КолЗнаков);
		
		ИтогоСУчетомНаклРасх2 = ТаблРасчета.Добавить();
