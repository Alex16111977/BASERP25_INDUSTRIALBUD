			СметПрибыль.ПрямЗатраты 	= Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков);
			СметПрибыль.ТекПрямЗатраты = Окр(СтрокаИтога.ТекПрямЗатраты ,КолЗнаков);
