					Если ЛимитЗатрата.ИсточникМонтажРаботСМ Тогда
						НоваяСтрока.ТекПрямЗатраты = НоваяСтрока.ТекПрямЗатраты + НоваяСтрока.ТекСтоимМатер + ?(Действие = "-",-НайденнаяСтрока.ТекСтоимМатер,НайденнаяСтрока.ТекСтоимМатер); 
						НоваяСтрока.ПрямЗатраты = НоваяСтрока.ПрямЗатраты + НоваяСтрока.СтоимМатер + ?(Действие = "-",-НайденнаяСтрока.СтоимМатер,НайденнаяСтрока.СтоимМатер); 
					КонецЕсли;
				КонецЕсли;
				Если ВидРаботИсточник = Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы  Тогда
					Если ЛимитЗатрата.ИсточникПрочихРаботПЗ Тогда
						НоваяСтрока.ТекПрямЗатраты = НоваяСтрока.ТекПрямЗатраты + ?(Действие = "-",-НайденнаяСтрока.ТекПрямзатраты,НайденнаяСтрока.ТекПрямзатраты); 
						НоваяСтрока.ПрямЗатраты = НоваяСтрока.ПрямЗатраты + ?(Действие = "-",-НайденнаяСтрока.Прямзатраты,НайденнаяСтрока.Прямзатраты); 
