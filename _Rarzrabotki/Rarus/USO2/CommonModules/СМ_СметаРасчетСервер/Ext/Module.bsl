			НоваяСтрока.ЗатратыТрудаМашин      = НоваяСтрока.ЗатратыТрудаМашин + ?(Действие = "-",-НайденнаяСтрока.ЗатратыТрудаМашин,НайденнаяСтрока.ЗатратыТрудаМашин);  
		КонецЕсли;		
		
	КонецЦикла;
	Возврат Табл;
	
	
КонецФункции

// Блок процедур расчета лимитированных затрат, заданных в документах
// СМ_ОбъектнаяСмета, СМ_ЛокальнаяСмета и АктВыполненных работ.
// Параметр Ссылка на докмент.
//
Функция СобратьИтогиПоВидамРаботСС(Ссылка)
	// Отдельно собрать итоги по видам работ ОС как сумму локальных. 
	ТипСоставляющей = Новый  ОписаниеТипов("Число");
	КолонкиСумм 	= "ПрямЗатраты,ОснЗарплата,ЭксплМашин,ЗарплМашин,СтоимМатер,Оборуд,ВозвратМатер,ЗатратыТрудаРабочих,ЗатратыТрудаМашин,ТекПрямЗатраты,ТекОснЗарплата,ТекЭксплМашин,ТекЗарплМашин,ТекСтоимМатер,ТекОборуд,ТекВозвратМатер";
	
	ИтогиПоВР = Новый ТаблицаЗначений;
	ИтогиПоВР.Колонки.Добавить("Итог");
	ИтогиПоВР.Колонки.Добавить("ВидРабот");
	ИтогиПоВР.Колонки.Добавить("ЛокальнаяСмета");
	ИтогиПоВР.Колонки.Добавить("ПрямЗатраты",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ОснЗарплата",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ЭксплМашин",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ЗарплМашин",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("СтоимМатер",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("Оборуд",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ВозвратМатер",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ЗатратыТрудаРабочих",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ЗатратыТрудаМашин",ТипСоставляющей);
	
	ИтогиПоВР.Колонки.Добавить("ТекПрямЗатраты",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ТекОснЗарплата",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ТекЭксплМашин",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ТекЗарплМашин",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ТекСтоимМатер",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ТекОборуд",ТипСоставляющей);
	ИтогиПоВР.Колонки.Добавить("ТекВозвратМатер",ТипСоставляющей);
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ИтогиПоВидамРабот.Итог,
	|	ИтогиПоВидамРабот.Смета КАК ЛокальнаяСмета,
	|	СУММА(ИтогиПоВидамРабот.ПрямЗатраты) КАК ПрямЗатраты,
	|	СУММА(ИтогиПоВидамРабот.ОснЗарплата) КАК ОснЗарплата,
	|	СУММА(ИтогиПоВидамРабот.ЭксплМашин) КАК ЭксплМашин,
	|	СУММА(ИтогиПоВидамРабот.ЗарплМашин) КАК ЗарплМашин,
	|	СУММА(ИтогиПоВидамРабот.СтоимМатер) КАК СтоимМатер,
	|	СУММА(ИтогиПоВидамРабот.Оборуд) КАК Оборуд,
	|	СУММА(ИтогиПоВидамРабот.ВозвратМатер) КАК ВозвратМатер,
	|	СУММА(ИтогиПоВидамРабот.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
	|	СУММА(ИтогиПоВидамРабот.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
	|	СУММА(ИтогиПоВидамРабот.ТекПрямЗатраты) КАК ТекПрямЗатраты,
	|	СУММА(ИтогиПоВидамРабот.ТекОснЗарплата) КАК ТекОснЗарплата,
	|	СУММА(ИтогиПоВидамРабот.ТекЭксплМашин) КАК ТекЭксплМашин,
	|	СУММА(ИтогиПоВидамРабот.ТекЗарплМашин) КАК ТекЗарплМашин,
	|	СУММА(ИтогиПоВидамРабот.ТекСтоимМатер) КАК ТекСтоимМатер,
	|	СУММА(ИтогиПоВидамРабот.ТекОборуд) КАК ТекОборуд,
	|	СУММА(ИтогиПоВидамРабот.ТекВозвратМатер) КАК ТекВозвратМатер
	
	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоВидамРабот КАК ИтогиПоВидамРабот
	|ГДЕ
	|	ИтогиПоВидамРабот.Смета В (&Смета)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИтогиПоВидамРабот.Итог,
	|	ИтогиПоВидамРабот.Смета";
	
	ТаблСмет = Ссылка.Сметы.Выгрузить(,"Смета,Расчет");
	ТаблОбъектов = Ссылка.Сметы.Выгрузить(,"Смета,КоличествоОбъектов,Расчет");
	Для Каждого ТекСмета Из ТаблСмет Цикл
		Если  НЕ ТекСмета.Расчет Тогда
			Продолжить;
		КонецЕсли;	
		Если ТипЗнч(ТекСмета.Смета)= Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
			// Для ОС суммарное значение.
			ТаблСмет1 = ТекСмета.Смета.ЛокальныеСметы.Выгрузить(,"ЛокальнаяСмета");
			Запрос.УстановитьПараметр("Смета", ТаблСмет1);
		Иначе
			Запрос.УстановитьПараметр("Смета", ТекСмета.Смета);
		КонецЕсли;
		ИтогиПоВРОС = Запрос.Выполнить().Выгрузить();
		ИтогиПоВРОС.Свернуть("Итог",КолонкиСумм);
		
		Отбор1 = Новый Структура;
		Отбор1.Вставить("Смета",ТекСмета.Смета);
		СтрокиОтбора = ТаблОбъектов.НайтиСтроки(Отбор1);
		КоличествоОбъектов = 1;
		Если СтрокиОтбора.Количество()<> 0 Тогда
			ТекущаяСтрока = СтрокиОтбора[0];
			КоличествоОбъектов = ?(ТекущаяСтрока.КоличествоОбъектов = 0,1,ТекущаяСтрока.КоличествоОбъектов);
		КонецЕсли;	
		Для каждого ИтогОС Из ИтогиПоВРОС Цикл
			НоваяСтрока = ИтогиПоВР.Добавить();
			НоваяСтрока.ЛокальнаяСмета = ТекСмета.Смета.Ссылка; 
			НоваяСтрока.Итог = ИтогОС.Итог; 
			НоваяСтрока.ПрямЗатраты = НоваяСтрока.ПрямЗатраты + ИтогОС.ПрямЗатраты * КоличествоОбъектов;
			НоваяСтрока.ОснЗарплата = НоваяСтрока.ОснЗарплата + ИтогОС.ОснЗарплата * КоличествоОбъектов;
			НоваяСтрока.ЭксплМашин = НоваяСтрока.ЭксплМашин + ИтогОС.ЭксплМашин * КоличествоОбъектов;
			НоваяСтрока.ЗарплМашин = НоваяСтрока.ЗарплМашин + ИтогОС.ЗарплМашин * КоличествоОбъектов;
			НоваяСтрока.СтоимМатер = НоваяСтрока.СтоимМатер + ИтогОС.СтоимМатер * КоличествоОбъектов;
			НоваяСтрока.Оборуд = НоваяСтрока.Оборуд + ИтогОС.Оборуд * КоличествоОбъектов;
			НоваяСтрока.ВозвратМатер = НоваяСтрока.ВозвратМатер + ИтогОС.ВозвратМатер * КоличествоОбъектов;
			НоваяСтрока.ЗатратыТрудаРабочих = НоваяСтрока.ЗатратыТрудаРабочих + ИтогОС.ЗатратыТрудаРабочих * КоличествоОбъектов;
			НоваяСтрока.ЗатратыТрудаМашин = НоваяСтрока.ЗатратыТрудаМашин + ИтогОС.ЗатратыТрудаМашин * КоличествоОбъектов;
			НоваяСтрока.ТекПрямЗатраты = НоваяСтрока.ТекПрямЗатраты + ИтогОС.ТекПрямЗатраты * КоличествоОбъектов;
			НоваяСтрока.ТекОснЗарплата = НоваяСтрока.ТекОснЗарплата + ИтогОС.ТекОснЗарплата * КоличествоОбъектов;
			НоваяСтрока.ТекЭксплМашин = НоваяСтрока.ТекЭксплМашин + ИтогОС.ТекЭксплМашин * КоличествоОбъектов;
			НоваяСтрока.ТекЗарплМашин = НоваяСтрока.ТекЗарплМашин + ИтогОС.ТекЗарплМашин * КоличествоОбъектов;
			НоваяСтрока.ТекСтоимМатер = НоваяСтрока.ТекСтоимМатер + ИтогОС.ТекСтоимМатер * КоличествоОбъектов;
			НоваяСтрока.ТекОборуд = НоваяСтрока.ТекОборуд + ИтогОС.ТекОборуд * КоличествоОбъектов;
			НоваяСтрока.ТекВозвратМатер = НоваяСтрока.ТекВозвратМатер + ИтогОС.ТекВозвратМатер * КоличествоОбъектов;
		КонецЦикла;
	КонецЦикла;
	
	ИтогиПоВР.Колонки.Добавить("Смета");
	ЗначенияКолонки = Новый Массив;
	ЗначенияКолонки.Добавить(Ссылка);
	ИтогиПоВР.ЗагрузитьКолонку(ЗначенияКолонки,"Смета");
	Возврат(ИтогиПоВР);
КонецФункции	

// Собирает итоги по видам работ для документа.
// параметр Ссылка.
//
Функция СобратьИтогиПоВидамРабот(Ссылка)
	
	КолонкиСумм 	= "ПрямЗатраты,ОснЗарплата,ЭксплМашин,ЗарплМашин,СтоимМатер,Оборуд,ВозвратМатер,ЗатратыТрудаРабочих,ЗатратыТрудаМашин,ТекПрямЗатраты,ТекОснЗарплата,ТекЭксплМашин,ТекЗарплМашин,ТекСтоимМатер,ТекОборуд,ТекВозвратМатер";
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета")  Тогда
			ТаблСмет = Ссылка.ЛокальныеСметы.Выгрузить(,"ЛокальнаяСмета");
		
		// Отдельно собрать итоги по видам работ ОС как сумму локальных. 
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ИтогиПоВидамРабот.Итог,
		|	ИтогиПоВидамРабот.Смета КАК ЛокальнаяСмета,
		|	СУММА(ИтогиПоВидамРабот.ПрямЗатраты) КАК ПрямЗатраты,
		|	СУММА(ИтогиПоВидамРабот.ОснЗарплата) КАК ОснЗарплата,
