		ВсегоПоСмете.ТекЭксплМашин 	= ИтогоПоСмете.ТекЭксплМашин;
		ВсегоПоСмете.ТекЗарплМашин 	= ИтогоПоСмете.ТекЗарплМашин ;
		ВсегоПоСмете.ТекСтоимМатер 	= ИтогоПоСмете.ТекСтоимМатер;
		ВсегоПоСмете.ТекОборуд		= ИтогоПоСмете.ТекОборуд;
		ВсегоПоСмете.ТекВозвратМатер 	= ИтогоПоСмете.ТекВозвратМатер;
	КонецЕсли;
	
	ТаблРасчета.ЗаполнитьЗначения(Ссылка,"Смета");
	Отбор = Новый Структура("Смета",Ссылка);
	СМ_СметаВызовСервера.ЗаписатьРеквизитыРегистраСведенийНаборТаблицей("СМ_ИтогиПоСмете",Отбор,ТаблРасчета);
	
КонецПроцедуры

// Обработка расчета итогов по разделу, рассчитывает итоги для всех 
//	методов счета базисно-индексный(уровень задания индексов расценка, раздел, смета.
//	Способ задания индексов по эелементам затрат, к полной стоимости.
//
// Параметры:
//     ТекСсылка 	- ДокументСсылка.СМ_РазделЛокальнойСметы - ссылка на раздел.
//     ЛС 			- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на локальную смету.  
//     Акт 			- ДокументСсылка.СМ_АктыВыполненныхРабот - ссылка на акт выполненных работ.
//     СтруктураПараметровОтбораРС - Структура - содержит дополнительный отбор результирующего регистра сведений.
//
Процедура СформироватьИтогиПоРазделу(ТекСсылка, ЛС, Акт = неопределено, СтруктураПараметровОтбораРС = Неопределено) Экспорт
	
	Если СтруктураПараметровОтбораРС = Неопределено Тогда
		СтруктураПараметровОтбораРС = СМ_СметаВызовСервера.ПолучитьСтруктуруДанныхДляОтборовРегистра(ТекСсылка, Акт, "СМ_РазделЛокальнойСметы");
	КонецЕсли;
	
	//Методика1984 = ЛС.Методика1984;
	Методика1984 = Ложь;
	МетодикаРСНБ = Ложь;
	Если ЛС.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_Методика84года Тогда
		Методика1984 = Истина;	
	ИначеЕсли ЛС.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_КЗ_РСНБ Тогда
		МетодикаРСНБ = Истина;
	КонецЕсли;
	РасчетНРиСПотПЗ = ЛС.РасчетНРиСПотПЗ;
	
	Если Акт = Неопределено Тогда
		Округлять 	= ЛС.ОкруглятьДоРублей;	
		ОкруглятьПромежуточное 	= ЛС.ПромежуточноеОкругление;	
		НаборКоэф 	= ТекСсылка;	
		ФлагАкт 	= Ложь;
	Иначе                                              
		НаборКоэф  	= Акт.Разделы.Найти(СтруктураПараметровОтбораРС.СсылкаНаРаздел);
		ФлагАкт 	= Истина;
		Округлять 	= Акт.ОкруглятьДоРублей;
		ОкруглятьПромежуточное 	= ЛС.ПромежуточноеОкругление;	
	КонецЕсли;
	
	Если Округлять Тогда
		КолЗнаков = 0;
		КолЗнаковРубли = 2;
	ИначеЕсли ОкруглятьПромежуточное Тогда
		КолЗнаков = 2;
		КолЗнаковРубли = 2;
	Иначе
		КолЗнаков = 6;
		КолЗнаковРубли = 6;
	КонецЕсли;
	
	ОписаниеТипаЧисло = Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(20,6));

	ТаблРасчета = Новый ТаблицаЗначений();
	ТаблРасчета.Колонки.Добавить("Смета");
	ТаблРасчета.Колонки.Добавить("Раздел");
	ТаблРасчета.Колонки.Добавить("Итог");
	ТаблРасчета.Колонки.Добавить("ВозвратМатер",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ЗарплМашин",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ЗатратыТрудаМашин",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ЗатратыТрудаРабочих",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("Оборуд",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ОснЗарплата",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ПрямЗатраты",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("СтоимМатер",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекВозвратМатер",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекЗарплМашин",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекОборуд",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекОснЗарплата",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекПрямЗатраты",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекСтоимМатер",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ТекЭксплМашин",ОписаниеТипаЧисло);
	ТаблРасчета.Колонки.Добавить("ЭксплМашин",ОписаниеТипаЧисло);	   
	
	ТабРезультат = СМ_СметаВызовСервера.ПолучитьТаблицуПодчиненных(СтруктураПараметровОтбораРС.СсылкаНаРаздел, Истина, Ложь, Ложь, Ложь);
	
	СписокПодчиненныхРазделов = Новый СписокЗначений();
	СписокПодчиненныхРазделов.ЗагрузитьЗначения(ТабРезультат.ВыгрузитьКолонку("Ид"));	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СМ_ИтогиПоРазделу.Смета,
	|	СМ_ИтогиПоРазделу.Раздел,
	|	СМ_ИтогиПоРазделу.Итог,
	|	СМ_ИтогиПоРазделу.ВозвратМатер,
	|	СМ_ИтогиПоРазделу.ЗарплМашин,
	|	СМ_ИтогиПоРазделу.ЗатратыТрудаМашин,
	|	СМ_ИтогиПоРазделу.ЗатратыТрудаРабочих,
	|	СМ_ИтогиПоРазделу.Оборуд,
	|	СМ_ИтогиПоРазделу.ОснЗарплата,
	|	СМ_ИтогиПоРазделу.ПрямЗатраты,
	|	СМ_ИтогиПоРазделу.СтоимМатер,
	|	СМ_ИтогиПоРазделу.ТекВозвратМатер,
	|	СМ_ИтогиПоРазделу.ТекЗарплМашин,
	|	СМ_ИтогиПоРазделу.ТекОборуд,
	|	СМ_ИтогиПоРазделу.ТекОснЗарплата,
	|	СМ_ИтогиПоРазделу.ТекПрямЗатраты,
	|	СМ_ИтогиПоРазделу.ТекСтоимМатер,
	|	СМ_ИтогиПоРазделу.ТекЭксплМашин,
	|	СМ_ИтогиПоРазделу.ЭксплМашин
	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоРазделу КАК СМ_ИтогиПоРазделу
	|ГДЕ
	|	СМ_ИтогиПоРазделу.Смета = &Смета
	|	И СМ_ИтогиПоРазделу.Раздел В(&Раздел)";
	
	Запрос.УстановитьПараметр("Смета", СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
	Запрос.УстановитьПараметр("Раздел", СписокПодчиненныхРазделов);

	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаНабора Из ТабРезультат Цикл
		// Собираются итоги по подчиненным разделам нижнего уровня.
		
		СтрокаТаблицыРасчета = ТаблРасчета.Найти(СтрокаНабора.Итог,"Итог");
		Если СтрокаТаблицыРасчета = Неопределено Тогда
			СтрокаТаблицыРасчета = ТаблРасчета.Добавить();
			СтрокаТаблицыРасчета.Итог = СтрокаНабора.Итог;
		КонецЕсли;
		
		СтрокаТаблицыРасчета.ПрямЗатраты            = Окр(СтрокаТаблицыРасчета.ПрямЗатраты,КолЗнаков) + Окр(СтрокаНабора.ПрямЗатраты,КолЗнаков); 
		СтрокаТаблицыРасчета.ОснЗарплата 			= Окр(СтрокаТаблицыРасчета.ОснЗарплата,КолЗнаков) + Окр(СтрокаНабора.ОснЗарплата,КолЗнаков);
		СтрокаТаблицыРасчета.ЭксплМашин 			= Окр(СтрокаТаблицыРасчета.ЭксплМашин,КолЗнаков)  + Окр(СтрокаНабора.ЭксплМашин,КолЗнаков);
		СтрокаТаблицыРасчета.ЗарплМашин 			= Окр(СтрокаТаблицыРасчета.ЗарплМашин,КолЗнаков) + Окр(СтрокаНабора.ЗарплМашин,КолЗнаков);
		СтрокаТаблицыРасчета.СтоимМатер 			= Окр(СтрокаТаблицыРасчета.СтоимМатер,КолЗнаков) + Окр(СтрокаНабора.СтоимМатер,КолЗнаков);
		СтрокаТаблицыРасчета.Оборуд 				= Окр(СтрокаТаблицыРасчета.Оборуд,КолЗнаков) + Окр(СтрокаНабора.Оборуд,КолЗнаков);
		СтрокаТаблицыРасчета.ВозвратМатер 		    = Окр(СтрокаТаблицыРасчета.ВозвратМатер,КолЗнаков) + Окр(СтрокаНабора.ВозвратМатер,КолЗнаков);
		СтрокаТаблицыРасчета.ЗатратыТрудаРабочих 	= Окр(СтрокаТаблицыРасчета.ЗатратыТрудаРабочих + СтрокаНабора.ЗатратыТрудаРабочих,2);
		СтрокаТаблицыРасчета.ЗатратыТрудаМашин   	= Окр(СтрокаТаблицыРасчета.ЗатратыТрудаМашин + СтрокаНабора.ЗатратыТрудаМашин,2);
		
		СтрокаТаблицыРасчета.ТекПрямЗатраты 	= Окр(СтрокаТаблицыРасчета.ТекПрямЗатраты,КолЗнаков) + Окр(СтрокаНабора.ТекПрямЗатраты,КолЗнаков);
		СтрокаТаблицыРасчета.ТекОснЗарплата 	= Окр(СтрокаТаблицыРасчета.ТекОснЗарплата,КолЗнаков) + Окр(СтрокаНабора.ТекОснЗарплата,КолЗнаков);
		СтрокаТаблицыРасчета.ТекЭксплМашин 		= Окр(СтрокаТаблицыРасчета.ТекЭксплМашин,КолЗнаков) + Окр(СтрокаНабора.ТекЭксплМашин,КолЗнаков);
		СтрокаТаблицыРасчета.ТекЗарплМашин 		= Окр(СтрокаТаблицыРасчета.ТекЗарплМашин,КолЗнаков)  + Окр(СтрокаНабора.ТекЗарплМашин,КолЗнаков);
		СтрокаТаблицыРасчета.ТекСтоимМатер 		= Окр(СтрокаТаблицыРасчета.ТекСтоимМатер,КолЗнаков) + Окр(СтрокаНабора.ТекСтоимМатер,КолЗнаков);
		СтрокаТаблицыРасчета.ТекОборуд 			= Окр(СтрокаТаблицыРасчета.ТекОборуд,КолЗнаков) + Окр(СтрокаНабора.ТекОборуд,КолЗнаков);
		СтрокаТаблицыРасчета.ТекВозвратМатер 	= Окр(СтрокаТаблицыРасчета.ТекВозвратМатер,КолЗнаков) + Окр(СтрокаНабора.ТекВозвратМатер,КолЗнаков);
		
	КонецЦикла;
	
	МетодРасчета = ЛС.МетодРасчета;
	СпособРасчетаИндексов = ЛС.СпособРасчетаИндексов;
	ВариантПересчетаЭММ   = ЛС.ВариантПересчетаЭММ;
	Уровень   = ЛС.Уровень;
	
	МатериалыВТекЦенах = 0;
	ОборудованиеВТекЦенах = 0;
	ПрямыеЗатратыВТекЦенах = 0;
	Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный Тогда
		Если Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда
			ЗапросНеИнд = Новый Запрос;
			Если ФлагАкт Тогда
				ЗапросНеИнд.Текст = "ВЫБРАТЬ
				|	ПозицияЛокальнойСметы.Ссылка,
				|	ПозицияЛокальнойСметы.Ссылка.ТекущаяЦена КАК ТекущаяЦена,
				|	ВЫБОР
				|		КОГДА ПозицияЛокальнойСметы.Ссылка.Определитель.ВидРасценки = &ВидРасценкиОборудование
				|			ТОГДА ПозицияЛокальнойСметы.Ссылка.ТекущаяЦена * АктВыполненныхРаботПозиции.ФактОбъем
				|		ИНАЧЕ 0
				|	КОНЕЦ КАК ТекСтоимОборудование,
				|	ВЫБОР
				|		КОГДА ПозицияЛокальнойСметы.Ссылка.Определитель.ВидРасценки = &ВидРасценкиМатериал
				|			ТОГДА ПозицияЛокальнойСметы.Ссылка.ТекущаяЦена * АктВыполненныхРаботПозиции.ФактОбъем
				|		ИНАЧЕ 0
				|	КОНЕЦ КАК ТекСтоимМатериалов,
				|	ВЫБОР
				|		КОГДА ПозицияЛокальнойСметы.Ссылка.Определитель.ВидРасценки <> &ВидРасценкиМатериал И
				|		 ПозицияЛокальнойСметы.Ссылка.Определитель.ВидРасценки <> &ВидРасценкиОборудование
				|			ТОГДА ПозицияЛокальнойСметы.Ссылка.ТекущаяЦена * АктВыполненныхРаботПозиции.ФактОбъем
				|		ИНАЧЕ 0
				|	КОНЕЦ КАК ТекСтоимПрямыхЗатрат
				|ИЗ
				|	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_АктВыполненныхРабот.Позиции КАК АктВыполненныхРаботПозиции
				|		ПО ПозицияЛокальнойСметы.Ссылка = АктВыполненныхРаботПозиции.Позиция
				|ГДЕ
				|	ПозицияЛокальнойСметы.Ссылка.ИДРодителя = &Раздел
				|	И АктВыполненныхРаботПозиции.Ссылка = &Смета
				|	И ПозицияЛокальнойСметы.Ссылка.Расчет = ИСТИНА
				|	И ПозицияЛокальнойСметы.Ссылка.НеПрименятьИндексы = ИСТИНА
				|ИТОГИ
				|	СУММА(ТекущаяЦена),
				|	СУММА(ТекСтоимОборудование),
				|	СУММА(ТекСтоимМатериалов),
				|	СУММА(ТекСтоимПрямыхЗатрат)
				|ПО
				|	ОБЩИЕ";
			Иначе
				ЗапросНеИнд.Текст = "ВЫБРАТЬ
				|	ПозицияЛокальнойСметы.Ссылка,
				|	ПозицияЛокальнойСметы.Ссылка.ТекущаяЦена КАК ТекущаяЦена,
				|	ВЫБОР
				|		КОГДА ПозицияЛокальнойСметы.Ссылка.Определитель.ВидРасценки = &ВидРасценкиОборудование
				|			ТОГДА ПозицияЛокальнойСметы.Ссылка.ТекущаяЦена * ПозицияЛокальнойСметы.ОбъемРабот
				|		ИНАЧЕ 0
				|	КОНЕЦ КАК ТекСтоимОборудование,
				|	ВЫБОР
				|		КОГДА ПозицияЛокальнойСметы.Ссылка.Определитель.ВидРасценки = &ВидРасценкиМатериал
				|			ТОГДА ПозицияЛокальнойСметы.Ссылка.ТекущаяЦена * ПозицияЛокальнойСметы.ОбъемРабот
				|		ИНАЧЕ 0
				|	КОНЕЦ КАК ТекСтоимМатериалов,
				|	ВЫБОР
				|		КОГДА ПозицияЛокальнойСметы.Ссылка.Определитель.ВидРасценки <> &ВидРасценкиМатериал И
				|		 ПозицияЛокальнойСметы.Ссылка.Определитель.ВидРасценки <> &ВидРасценкиОборудование
				|			ТОГДА ПозицияЛокальнойСметы.Ссылка.ТекущаяЦена * ПозицияЛокальнойСметы.ОбъемРабот
				|		ИНАЧЕ 0
				|	КОНЕЦ КАК ТекСтоимПрямыхЗатрат
				|ИЗ
				|	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
				|ГДЕ
				|	ПозицияЛокальнойСметы.Ссылка.ИДРодителя = &Раздел
				|	И ПозицияЛокальнойСметы.Ссылка.ИДСметы = &Смета
				|	И ПозицияЛокальнойСметы.Ссылка.Расчет = ИСТИНА
				|	И ПозицияЛокальнойСметы.Ссылка.НеПрименятьИндексы = ИСТИНА
				|ИТОГИ
				|	СУММА(ТекущаяЦена),
				|	СУММА(ТекСтоимОборудование),
				|	СУММА(ТекСтоимМатериалов),
				|	СУММА(ТекСтоимПрямыхЗатрат)
				|ПО
				|	ОБЩИЕ";
				
			КонецЕсли;
			
			ЗапросНеИнд.УстановитьПараметр("Раздел",СтруктураПараметровОтбораРС.СсылкаНаРаздел);
			ЗапросНеИнд.УстановитьПараметр("Смета",СтруктураПараметровОтбораРС.СсылкаДляОтбораСмета);
			ЗапросНеИнд.УстановитьПараметр("ФлагАкт",ФлагАкт);
			ЗапросНеИнд.УстановитьПараметр("ВидРасценкиОборудование", Перечисления.СМ_ВидыРасценки.Оборудование);
