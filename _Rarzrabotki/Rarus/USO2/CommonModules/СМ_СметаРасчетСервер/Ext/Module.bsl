		|ИЗ
		|	РегистрСведений." + ИсточникЗапроса+" КАК ИтогиПоГлавам
		|ГДЕ
		|	ИтогиПоГлавам.Смета = &Смета 
		|   И ИтогиПоГлавам.Итог = &ЛимЗатрата
		|
		|СГРУППИРОВАТЬ ПО
		|	ИтогиПоГлавам.Итог,
		|	ИтогиПоГлавам.ВидРабот
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИтогиПоГлавам.Итог.ГлаваССРС.ПорядковыйНомер";
		
		Запрос.УстановитьПараметр("Смета", Смета);
		Запрос.УстановитьПараметр("ЛимЗатрата", ЛимЗатрата);
		
		ИтогиПоЛимЗатрате = Запрос.Выполнить().Выгрузить();
		Для каждого ИтогПоЛимЗатрате Из ИтогиПоЛимЗатрате Цикл
			Итог = ИтогПоЛимЗатрате.Итог;
			ГлаваССРС = Итог.ГлаваССРС;
			ВидРабот = ИтогПоЛимЗатрате.ВидРабот;
			Отбор = Новый Структура;
			Отбор.Вставить("Накопительный",Ложь);
			Отбор.Вставить("ВидРабот",ВидРабот);
			Отбор.Вставить("Итог",Итог);
			МассивСтрок = ИтогиПоГлавам.НайтиСтроки(Отбор);
			Если МассивСтрок.Количество() <> 0 Тогда
				СтрокаМассива = МассивСтрок[0];
				СуммированиеСоставляющих(СтрокаМассива,ИтогПоЛимЗатрате);
			Иначе
				НоваяСтрока 				= ИтогиПоГлавам.Добавить();	
				НоваяСтрока.Смета       	= Ссылка;
				НоваяСтрока.Глава      	 	= ГлаваССРС;
				НоваяСтрока.Итог        	= Итог;
				НоваяСтрока.ВидРабот    	= ВидРабот;
				НоваяСтрока.Накопительный 	= Ложь;
				ИтогСоответствиеИтогаГлаве = НайтиИтогСоответствиеИтогаГлаве(ГлаваССРС);
				Если Не ИтогСоответствиеИтогаГлаве = Неопределено Тогда
					НоваяСтрока.ПорНомерИтога 	= ИтогСоответствиеИтогаГлаве.ПорядковыйНомер;
				КонецЕсли;
				НоваяСтрока.КодГлавы		= Итог.ГлаваССРС.Код;
				ЗаполнитьЗначенияСвойств(НоваяСтрока,ИтогПоЛимЗатрате,СписокСвойств);
				СтрокаМассива = НоваяСтрока;
			КонецЕсли;	
			// Добавить В Итоги  Накопительные.
			ИтогНакоп = ЛимЗатрата.КИтогу;
			ТабНакопительныхИтогов = ПолучитьИтогиПоГлавамДляДобавленияЛЗ(ИтогНакоп);
			Для каждого НакопительныйИтог Из  ТабНакопительныхИтогов Цикл
				Отбор3 = Новый Структура;
				Отбор3.Вставить("Накопительный",Истина);
				Отбор3.Вставить("ВидРабот",ВидРабот);
				Отбор3.Вставить("Итог",НакопительныйИтог.Итог);
				МассивСтрок3 = ИтогиПоГлавам.НайтиСтроки(Отбор3);
				Если МассивСтрок3.Количество() <> 0 Тогда
					Строки3 = МассивСтрок3[0];
					Если Лимзатрата.ТипЗначенияЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Индекс Тогда
						ОтборФлага = Новый Структура;
						ОтборФлага.Вставить("ВидРабот",ВидРабот);
						ОтборФлага.Вставить("Итог",НакопительныйИтог.Итог);
						ЕстьФлаг = ФлагИндекса.НайтиСтроки(ОтборФлага);
						Флаг = ?(ЕстьФлаг.Количество() = 0,Ложь,Истина);
						Если Флаг = Ложь Тогда
							ПеренесениеИндексаВПряЗатраты(Строки3,СтрокаМассива);	
						Иначе
							СуммированиеСоставляющих(Строки3,СтрокаМассива);
						КонецЕсли;	
						Если Флаг = Ложь Тогда
							СтрокаФлага = ФлагИндекса.Добавить();
							СтрокаФлага.ВидРабот = ВидРабот;
							СтрокаФлага.Итог = Итог;
						КонецЕсли;	
					Иначе	
						СуммированиеСоставляющих(Строки3,ИтогПоЛимЗатрате);
					КонецЕсли;
				Иначе
					// Надо создать итог для этого вида работ.
					НоваяСтрока 				= ИтогиПоГлавам.Добавить();	
					НоваяСтрока.Смета       	= Ссылка;
					НоваяСтрока.Глава      	 	= НакопительныйИтог.Итог.ГлаваССРС;
					НоваяСтрока.Итог        	= НакопительныйИтог.Итог;
					НоваяСтрока.ВидРабот    	= ВидРабот;
					НоваяСтрока.Накопительный 	= Истина;
					НоваяСтрока.ПорНомерИтога 	= НакопительныйИтог.Итог.ПорядковыйНомер;
					НоваяСтрока.КодГлавы		= НакопительныйИтог.Итог.ГлаваССРС.Код;
					ЗаполнитьЗначенияСвойств(НоваяСтрока,ИтогПоЛимЗатрате,СписокСвойств);
				КонецЕсли;
			КонецЦикла;	
	
		КонецЦикла;	
		
	КонецЦикла;	
		
КонецПроцедуры

// Процедура обнуления составляющих Прямых затрат.
//
Процедура ОбнулениеСоставляющих(СтрокаПриемник)
	СтрокаПриемник.ПрямЗатраты  	 = 0 ;
	СтрокаПриемник.ОснЗарплата  	 = 0 ;
	СтрокаПриемник.ЭксплМашин 	     = 0 ;
	СтрокаПриемник.ЗарплМашин  	     = 0 ;
	СтрокаПриемник.СтоимМатер        = 0 ;
	СтрокаПриемник.Оборуд		     = 0;
	СтрокаПриемник.ТекПрямЗатраты    = 0;
	СтрокаПриемник.ТекОснЗарплата    = 0;
	СтрокаПриемник.ТекЭксплМашин     = 0;
	СтрокаПриемник.ТекЗарплМашин     = 0;
	СтрокаПриемник.ТекСтоимМатер  	 = 0 ;
	СтрокаПриемник.ТекОборуд         = 0;
	СтрокаПриемник.ВозвратМатер      = 0 ;
	СтрокаПриемник.ЗатратыТрудаРабочих  = 0;
	СтрокаПриемник.ЗатратыТрудаМашин    = 0;
КонецПроцедуры

// Процедура суммирования составляющих Прямых затрат.
//
Процедура СуммированиеСоставляющих(СтрокаПриемник,СтрокаИсточник)
	
	СтрокаПриемник.ПрямЗатраты     = СтрокаПриемник.ПрямЗатраты    + СтрокаИсточник.ПрямЗатраты;
	СтрокаПриемник.ОснЗарплата     = СтрокаПриемник.ОснЗарплата    + СтрокаИсточник.ОснЗарплата;
	СтрокаПриемник.ЭксплМашин      = СтрокаПриемник.ЭксплМашин     + СтрокаИсточник.ЭксплМашин;
	СтрокаПриемник.ЗарплМашин      = СтрокаПриемник.ЗарплМашин     + СтрокаИсточник.ЗарплМашин;
	СтрокаПриемник.СтоимМатер      = СтрокаПриемник.СтоимМатер     + СтрокаИсточник.СтоимМатер;
	СтрокаПриемник.Оборуд		   = СтрокаПриемник.Оборуд         + СтрокаИсточник.Оборуд;
	СтрокаПриемник.ТекПрямЗатраты  = СтрокаПриемник.ТекПрямЗатраты + СтрокаИсточник.ТекПрямЗатраты;
	СтрокаПриемник.ТекОснЗарплата  = СтрокаПриемник.ТекОснЗарплата + СтрокаИсточник.ТекОснЗарплата;
	СтрокаПриемник.ТекЭксплМашин   = СтрокаПриемник.ТекЭксплМашин  + СтрокаИсточник.ТекЭксплМашин;
	СтрокаПриемник.ТекЗарплМашин   = СтрокаПриемник.ТекЗарплМашин  + СтрокаИсточник.ТекЗарплМашин;
	СтрокаПриемник.ТекСтоимМатер   = СтрокаПриемник.ТекСтоимМатер  + СтрокаИсточник.ТекСтоимМатер;
	СтрокаПриемник.ТекОборуд       = СтрокаПриемник.ТекОборуд      + СтрокаИсточник.ТекОборуд;
	СтрокаПриемник.ВозвратМатер    = СтрокаПриемник.ВозвратМатер   + СтрокаИсточник.ВозвратМатер;
	СтрокаПриемник.ЗатратыТрудаРабочих  = СтрокаПриемник.ЗатратыТрудаРабочих + СтрокаИсточник.ЗатратыТрудаРабочих;
	СтрокаПриемник.ЗатратыТрудаМашин    = СтрокаПриемник.ЗатратыТрудаМашин   + СтрокаИсточник.ЗатратыТрудаМашин;
	
КонецПроцедуры

// Процедура перенесения итогв по ЛЗ Индекс в Прямые затраты.
//
Процедура ПеренесениеИндексаВПряЗатраты(СтрокаПриемник,СтрокаИсточник)
	
	СтрокаПриемник.ПрямЗатраты     = СтрокаИсточник.ПрямЗатраты;
	СтрокаПриемник.ОснЗарплата     = СтрокаИсточник.ОснЗарплата;
	СтрокаПриемник.ЭксплМашин      = СтрокаИсточник.ЭксплМашин;
	СтрокаПриемник.ЗарплМашин      = СтрокаИсточник.ЗарплМашин;
	СтрокаПриемник.СтоимМатер      = СтрокаИсточник.СтоимМатер;
	СтрокаПриемник.Оборуд		   = СтрокаИсточник.Оборуд;
	СтрокаПриемник.ТекПрямЗатраты  = СтрокаИсточник.ТекПрямЗатраты;
	СтрокаПриемник.ТекОснЗарплата  = СтрокаИсточник.ТекОснЗарплата;
	СтрокаПриемник.ТекЭксплМашин   = СтрокаИсточник.ТекЭксплМашин;
	СтрокаПриемник.ТекЗарплМашин   = СтрокаИсточник.ТекЗарплМашин;
	СтрокаПриемник.ТекСтоимМатер   = СтрокаИсточник.ТекСтоимМатер;
	СтрокаПриемник.ТекОборуд       = СтрокаИсточник.ТекОборуд;
	СтрокаПриемник.ВозвратМатер    = СтрокаИсточник.ВозвратМатер;
	СтрокаПриемник.ЗатратыТрудаРабочих  = СтрокаИсточник.ЗатратыТрудаРабочих;
	СтрокаПриемник.ЗатратыТрудаМашин    = СтрокаИсточник.ЗатратыТрудаМашин;
	
КонецПроцедуры

// Функция для определения итога по главе. 
// Параметр 1 - Глава.
//
Функция НайтиИтогСоответствиеИтогаГлаве(ТекГлава)
	
	Итог = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИтогиПоГлавам.Ссылка КАК Итог
	               |ИЗ
	               |	Справочник.СМ_ИтогиПоГлавам КАК ИтогиПоГлавам
	               |ГДЕ
	               |	ИтогиПоГлавам.ПометкаУдаления = ЛОЖЬ
	               |	И ИтогиПоГлавам.ГлаваССРС = &Глава";	
	
	Запрос.УстановитьПараметр("Глава", ТекГлава);

	ВыборкаГлав = Запрос.Выполнить().Выгрузить();
	Если  ВыборкаГлав.Количество() <> 0 Тогда
		Итог = ВыборкаГлав[0].Итог;  
	КонецЕсли;	
	Возврат(Итог);
КонецФункции

// Формирование таблицы для расчета лимитированных затрат Локальных смет и актов.
//
Процедура ФормированиеТаблицыИтогиПоГлавам(ИтогиПоГлавам, ИтогиПоВР,Ссылка,СписокВидыЗатрат)
	
	ТекВыборка = Справочники.СМ_ИтогиПоГлавам.Выбрать();
			
	Пока ТекВыборка.Следующий() Цикл
		
		Если ТекВыборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ТекВидЗатрат Из СписокВидыЗатрат Цикл
			НоваяСтрока 				= ИтогиПоГлавам.Добавить();	
			НоваяСтрока.Смета       	= Ссылка;
			НоваяСтрока.Глава      	 	= ТекВыборка.ГлаваССРС;
			НоваяСтрока.Итог        	= ТекВыборка.Ссылка;
			НоваяСтрока.ВидРабот    	= ТекВидЗатрат;
			НоваяСтрока.Накопительный 	= ТекВыборка.Накопительный;
			НоваяСтрока.ПорНомерИтога 	= ТекВыборка.ПорядковыйНомер;
			НоваяСтрока.КодГлавы		= ТекВыборка.ГлаваССРС.Код;
			ПрямЗатраты             	= 0;
			ОснЗарплата             	= 0;
			ЭксплМашин             		= 0;
			ЗарплМашин              	= 0;
			СтоимМатер              	= 0;
			Оборуд                 	 	= 0;
			ТекПрямЗатраты             	= 0;
			ТекОснЗарплата             	= 0;
			ТекЭксплМашин             	= 0;
			ТекЗарплМашин              	= 0;
			ТекСтоимМатер              	= 0;
			ТекОборуд                 	= 0;
			ВозвратМатер           		= 0;
			ЗатратыТрудаРабочих     	= 0;
			ЗатратыТрудаМашин      		= 0;
		КонецЦикла;                 
	КонецЦикла;
	
	Итог0 			= Справочники.СМ_ИтогиПоГлавам.НайтиПоРеквизиту("Идентификатор","И0");
	СписокСвойств 	= "ПрямЗатраты,ОснЗарплата,ЭксплМашин,ЗарплМашин,СтоимМатер,Оборуд,ВозвратМатер,ЗатратыТрудаРабочих,ЗатратыТрудаМашин,ТекПрямЗатраты,ТекОснЗарплата,ТекЭксплМашин,ТекЗарплМашин,ТекСтоимМатер,ТекОборуд,ТекВозвратМатер";
	
				
		Для Каждого ТекСтрока Из ИтогиПоВР Цикл
			
			// Заполнение нулевого итога.
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Итог",Итог0);
			СтруктураОтбора.Вставить("ВидРабот",ТекСтрока.ВидРабот);
			
			МассивСтрок = ИтогиПоГлавам.НайтиСтроки(СтруктураОтбора);
			Для Каждого НайденнаяСтрока Из МассивСтрок Цикл
				ЗаполнитьЗначенияСвойств(НайденнаяСтрока,ТекСтрока,СписокСвойств);
			КонецЦикла;
			
			// Заполнение накопительных итогов.
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Накопительный",Истина);
			СтруктураОтбора.Вставить("ВидРабот",ТекСтрока.ВидРабот);
			
			МассивСтрок = ИтогиПоГлавам.НайтиСтроки(СтруктураОтбора);
			Для Каждого НайденнаяСтрока Из МассивСтрок Цикл
				ЗаполнитьЗначенияСвойств(НайденнаяСтрока,ТекСтрока,СписокСвойств);
			КонецЦикла;
			
		КонецЦикла;
	
  ИтогиПоГлавам.Сортировать("ПорНомерИтога Возр");  
  
КонецПроцедуры	

// Процедура добавления лимитированной затраты (сумма) в накопительные итоги.
//
Процедура ДобавлениеЗатратыВНакопительныеИтоги(ИтогиПоГлавам,ТабНакопительныхИтогов,ТекВидРабот,ЛимитЗатрата,БазисЗначениеЗатраты,ЗначениеЗатраты)
	
	Для Каждого ТекущийИтог Из ТабНакопительныхИтогов Цикл
		СтруктураОтбора3 = Новый Структура;
		СтруктураОтбора3.Вставить("Глава",ТекущийИтог.Итог.ГлаваССРС);
		СтруктураОтбора3.Вставить("Итог",ТекущийИтог.Итог);
		СтруктураОтбора3.Вставить("ВидРабот",ТекВидРабот);
		Если ТекВидРабот = Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы Тогда
			ПриемникПЗ = ЛимитЗатрата.ПриемникСтроитРаботПЗ;
			ПриемникОЗ = ЛимитЗатрата.ПриемникСтроитРаботОЗ;
			ПриемникЭМ = ЛимитЗатрата.ПриемникСтроитРаботЭМ;
			ПриемникЗМ = ЛимитЗатрата.ПриемникСтроитРаботЗМ;
			ПриемникСМ = ЛимитЗатрата.ПриемникСтроитРаботСМ;
		ИначеЕсли ТекВидРабот = Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы	Тогда
			ПриемникПЗ = ЛимитЗатрата.ПриемникМонтажРаботПЗ;
			ПриемникОЗ = ЛимитЗатрата.ПриемникМонтажРаботОЗ;
			ПриемникЭМ = ЛимитЗатрата.ПриемникМонтажРаботЭМ;
			ПриемникЗМ = ЛимитЗатрата.ПриемникМонтажРаботЗМ;
			ПриемникСМ = ЛимитЗатрата.ПриемникМонтажРаботСМ;
			
		ИначеЕсли ТекВидРабот = Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы	Тогда
			ПриемникПЗ = ЛимитЗатрата.ПриемникПрочихРаботПЗ;
			ПриемникОЗ = ЛимитЗатрата.ПриемникПрочихРаботОЗ;
			ПриемникЭМ = ЛимитЗатрата.ПриемникПрочихРаботЭМ;
			ПриемникЗМ = ЛимитЗатрата.ПриемникПрочихРаботЗМ;
			ПриемникСМ = ЛимитЗатрата.ПриемникПрочихРаботСМ;

		ИначеЕсли ТекВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование	Тогда
			ПриемникОборуд = ЛимитЗатрата.ПриемникОборуд;
			МассивСтрок3 = ИтогиПоГлавам.НайтиСтроки(СтруктураОтбора3);
			Если МассивСтрок3.Количество() > 0 Тогда
				ТекущаяСтрока3 = МассивСтрок3[0];
				ТекущаяСтрока3.Оборуд = ТекущаяСтрока3.Оборуд + ?(ПриемникОборуд,БазисЗначениеЗатраты,0);
				ТекущаяСтрока3.ТекОборуд 	= ТекущаяСтрока3.ТекОборуд + ?(ПриемникОборуд,ЗначениеЗатраты,0);
				ТекущаяСтрока3.ПрямЗатраты	= ТекущаяСтрока3.Оборуд + ?(ПриемникОборуд,БазисЗначениеЗатраты,0);
				ТекущаяСтрока3.ТекПрямЗатраты = ТекущаяСтрока3.ТекОборуд + ?(ПриемникОборуд,ЗначениеЗатраты,0);
			КонецЕсли;
			Возврат;
		КонецЕсли;	

		МассивСтрок3 = ИтогиПоГлавам.НайтиСтроки(СтруктураОтбора3);
		Если МассивСтрок3.Количество() > 0 Тогда
			ТекущаяСтрока3 = МассивСтрок3[0];
			
			ТекущаяСтрока3.ПрямЗатраты		= ТекущаяСтрока3.ПрямЗатраты + ?(ПриемникПЗ,БазисЗначениеЗатраты,0);
			ТекущаяСтрока3.ОснЗарплата     	= ТекущаяСтрока3.ОснЗарплата + ?(ПриемникОЗ,БазисЗначениеЗатраты,0);
			ТекущаяСтрока3.ЭксплМашин      	= ТекущаяСтрока3.ЭксплМашин + ?(ПриемникЭМ,БазисЗначениеЗатраты,0);
			ТекущаяСтрока3.ЗарплМашин      	= ТекущаяСтрока3.ЗарплМашин + ?(ПриемникЗМ,БазисЗначениеЗатраты,0);
			ТекущаяСтрока3.СтоимМатер      	= ТекущаяСтрока3.СтоимМатер + ?(ПриемникСМ,БазисЗначениеЗатраты,0);
			
			ТекущаяСтрока3.ТекПрямЗатраты  	= ТекущаяСтрока3.ТекПрямЗатраты + ?(ПриемникПЗ,ЗначениеЗатраты,0);
			ТекущаяСтрока3.ТекОснЗарплата  	= ТекущаяСтрока3.ТекОснЗарплата + ?(ПриемникОЗ,ЗначениеЗатраты,0);
			ТекущаяСтрока3.ТекЭксплМашин   	= ТекущаяСтрока3.ТекЭксплМашин + ?(ПриемникЭМ,ЗначениеЗатраты,0);
			ТекущаяСтрока3.ТекЗарплМашин   	= ТекущаяСтрока3.ТекЗарплМашин + ?(ПриемникЗМ,ЗначениеЗатраты,0);
			ТекущаяСтрока3.ТекСтоимМатер   	= ТекущаяСтрока3.ТекСтоимМатер + ?(ПриемникСМ,ЗначениеЗатраты,0);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	

// Функция определяет соответствие источник-приемник для лимитированных затрат.
//
Функция ОпределитьСоотвИстПриемЛимЗатрат(ЛимЗатр)
	
	ПрямоеНачисление = Ложь;
	Если ЛимЗатр.ИсточникМонтажРабот = ЛимЗатр.ПриемникМонтажРабот
		И ЛимЗатр.ИсточникСтроитРабот = ЛимЗатр.ПриемникСтроитРабот
		И ЛимЗатр.ИсточникОборуд = ЛимЗатр.ПриемникОборуд
		И ЛимЗатр.ИсточникПрочихРабот = ЛимЗатр.ПриемникПрочихРабот Тогда
		ПрямоеНачисление = Истина;	
	КонецЕсли;
	
	Возврат ПрямоеНачисление;
	
КонецФункции

// функция определяет итоги, следующие за итогом с порядковым номером.
//
Функция ПолучитьИтогиПоГлавамПоПорядковомуНомеру(ПорНомер)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИтогиПоГлавам.Ссылка КАК Итог,
	               |	ИтогиПоГлавам.Наименование,
	               |	ИтогиПоГлавам.ГлаваССРС,
	               |	ИтогиПоГлавам.Накопительный,
	               |	ИтогиПоГлавам.ПорядковыйНомер
	               |ИЗ
	               |	Справочник.СМ_ИтогиПоГлавам КАК ИтогиПоГлавам
	               |ГДЕ
	               |	ИтогиПоГлавам.ПорядковыйНомер > &ПорядковыйНомер
	               |	И ИтогиПоГлавам.Накопительный = ИСТИНА";
	
	Запрос.УстановитьПараметр("ПорядковыйНомер",ПорНомер);
	ТабИтогов = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабИтогов;
	
КонецФункции

// Функция определяет итог и итоги, следующие за тем, к которому прибавляется затрата.
//
Функция ПолучитьИтогиПоГлавамДляДобавленияЛЗ(Итог)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИтогиПоГлавам.Ссылка КАК Итог,
	               |	ИтогиПоГлавам.Наименование,
	               |	ИтогиПоГлавам.ГлаваССРС,
	               |	ИтогиПоГлавам.Накопительный,
	               |	ИтогиПоГлавам.ПорядковыйНомер
	               |ИЗ
	               |	Справочник.СМ_ИтогиПоГлавам КАК ИтогиПоГлавам
	               |ГДЕ
	               |	ИтогиПоГлавам.ПорядковыйНомер >= &ПорядковыйНомер
	               |	И ИтогиПоГлавам.Накопительный = ИСТИНА";
	
	Запрос.УстановитьПараметр("ПорядковыйНомер",Итог.ПорядковыйНомер);
	ТабИтогов = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабИтогов;
	
КонецФункции

#КонецОбласти

#Область РасчетЛимЗатрат

// Функция для поиска лимитированной затраты в таблице расчета ИтогиПоГлавам для конкретного вида работ.
//
Функция НайтиЛимЗатрату(ИтогиПоГлавам,СсылкаЛЗ,Ссылка,ТекВидРабот)
	СтруктураОтбораЛЗ = Новый Структура;
	СтруктураОтбораЛЗ.Вставить("ВидРабот",ТекВидРабот);
	СтруктураОтбораЛЗ.Вставить("Итог",СсылкаЛЗ);
	СтруктураОтбораЛЗ.Вставить("Смета",Ссылка);
	МассивСтрокЛЗ = ИтогиПоГлавам.НайтиСтроки(СтруктураОтбораЛЗ);
	Если МассивСтрокЛЗ.Количество() > 0 Тогда 
		НоваяСтрока 			= МассивСтрокЛЗ[0];
	Иначе
		НоваяСтрока 			= ИтогиПоГлавам.Добавить(); 
		НоваяСтрока.Смета       = Ссылка;
		НоваяСтрока.Глава      	= СсылкаЛЗ.ГлаваССРС;
		НоваяСтрока.Итог        = СсылкаЛЗ;
		НоваяСтрока.ВидРабот    = ТекВидРабот;
		
	КонецЕсли;
	Возврат(НоваяСтрока);	
КонецФункции

// Процедура расчета лимитированных затрат, заданных в документе.
//
Процедура РасчетЛимЗатраты(ИтогиПоГлавам, ИтогиПоВР,Ссылка,КолЗнаковРасчета)
	// Значения реквизита "Откуда":
	// 1 - от итога. 
	// 2 - от затраты.
	// 3 - по формуле.
	// Нужно лим затраты сортировать по реквизиту НомерПоПорядку, справочника лимитированные затраты.
	ТаблицаЗатрат = Ссылка.ЛимитированныеЗатраты.Выгрузить();
	ТаблицаЗатрат.Колонки.Добавить("НомерПоПорядку");
	Для каждого ЛЗ Из ТаблицаЗатрат Цикл
		ЛЗ.НомерПоПорядку = ЛЗ.ЛимитированнаяЗатрата.НомерПоПорядку;
	КонецЦикла;	
	ТаблицаЗатрат.Сортировать("НомерПоПорядку Возр", );
	
	Для Каждого ТекСтрока Из ТаблицаЗатрат Цикл
		
		ЛимитЗатрата 	= ТекСтрока.ЛимитированнаяЗатрата;
		КолЗнаков = КолЗнаковРасчета;
		Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Или ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
			Если Ссылка.НеОкруглятьНДС Тогда
				Если  ЛимитЗатрата.Идентификатор = "ЛЗ64" Тогда
					КолЗнаков = 2;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	

		Расчет =  ТекСтрока.Расчет;
		
		Если  Расчет = Ложь Тогда  Продолжить; 	КонецЕсли;	
		
		ТипЗатраты		= ЛимитЗатрата.ТипЗначенияЗатраты;
		ЗначениеЗатраты	= ТекСтрока.ЗначениеЛимЗатраты;
		БазисЗначениеЗатраты	= ТекСтрока.БазисноеЗначениеЛимЗатраты;
		
		КоэффициентТрудоемкости = ТекСтрока.КоэффициентТрудоемкости;
		КоэффициентСметнойЗарплаты = ТекСтрока.КоэффициентСметнойЗарплаты;

		ТекИтог  		= ТекСтрока.ЛимитированнаяЗатрата.ОтИтога;
		ТекГлава		= ТекИтог.ГлаваССРС;
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Глава",ТекГлава);
		СтруктураОтбора.Вставить("Итог",ТекИтог);
		
		СтруктураОтбора2 = Новый Структура;
		СтруктураОтбора2.Вставить("Смета",Ссылка);
		
		// Базисный уровень цен.
		ИсточникСтроитРаботПЗ = 0;
		ИсточникСтроитРаботОЗ = 0;
		ИсточникСтроитРаботЭМ = 0;
		ИсточникСтроитРаботЗМ = 0;
		ИсточникСтроитРаботСМ = 0;

		ИсточникМонтажРаботПЗ = 0;
		ИсточникМонтажРаботОЗ = 0;
		ИсточникМонтажРаботЭМ = 0;
		ИсточникМонтажРаботЗМ = 0;
		ИсточникМонтажРаботСМ = 0;

		ИсточникОборуд = 0;
		
		ИсточникПрочихРаботПЗ = 0;
		ИсточникПрочихРаботОЗ = 0;
		ИсточникПрочихРаботЭМ = 0;
		ИсточникПрочихРаботЗМ = 0;
		ИсточникПрочихРаботСМ = 0;
		
		// Текущий уровень цен.
		ТекИсточникСтроитРаботПЗ = 0;
		ТекИсточникСтроитРаботОЗ = 0;
		ТекИсточникСтроитРаботЭМ = 0;
		ТекИсточникСтроитРаботЗМ = 0;
		ТекИсточникСтроитРаботСМ = 0;

		ТекИсточникМонтажРаботПЗ = 0;
		ТекИсточникМонтажРаботОЗ = 0;
		ТекИсточникМонтажРаботЭМ = 0;
		ТекИсточникМонтажРаботЗМ = 0;
		ТекИсточникМонтажРаботСМ = 0;

		ТекИсточникОборуд = 0;
		
		ТекИсточникПрочихРаботПЗ = 0;
		ТекИсточникПрочихРаботОЗ = 0;
		ТекИсточникПрочихРаботЭМ = 0;
		ТекИсточникПрочихРаботЗМ = 0;
		ТекИсточникПрочихРаботСМ = 0;
		
		// Трудозатраты. 
		ЗатратыТрудаРабочих	= 0;
		ЗатратыТрудаМашин	= 0;
		
		// Добавка к Трудозатратам за счет Коэфф. к НормТрудоемкости. 
		ДобавкаКЗатратамТруда = 0;
		
		// Сметная зарплата.
		БазисСЗП = 0;
		СЗП      = 0;
		БазисСЗПМашин = 0;
		СЗПМашин      = 0;
		
		// Добавка к сметной зарплате.
		ДобавкаКСметнойЗарплате = 0;
		ДобавкаКСметнойЗарплатеМашин = 0;
		БазисДобавкаКСметнойЗарплате  = 0;
		БазисДобавкаКСметнойЗарплатеМашин  = 0;
		РасчетнаяЗатрата = 0;
		БазисРасчетнаяЗатрата = 0;
		
		ОбщаяДобавкаИсточникПЗ = 0;
		ОбщаяДобавкаИсточникОЗ = 0;
		ОбщаяДобавкаИсточникЭМ = 0;
		ОбщаяДобавкаИсточникЗМ = 0;
		ОбщаяДобавкаИсточникСМ = 0;
		ОбщаяДобавкаИсточникОборуд = 0;
		// Базисные.
		БазисОбщаяДобавкаИсточникПЗ = 0;
		БазисОбщаяДобавкаИсточникОЗ = 0;
		БазисОбщаяДобавкаИсточникЭМ = 0;
		БазисОбщаяДобавкаИсточникЗМ = 0;
		БазисОбщаяДобавкаИсточникСМ = 0;
		БазисОбщаяДобавкаИсточникОборуд = 0;
		// Добавки для ЛимЗатраты индекс.
		ИндексДобавкаИсточникПЗСР = 0;
		ИндексДобавкаИсточникОЗСР = 0;
		ИндексДобавкаИсточникЭМСР = 0;
		ИндексДобавкаИсточникЗМСР = 0;
		ИндексДобавкаИсточникСМСР = 0;
		ИндексДобавкаИсточникПЗМР = 0;
		ИндексДобавкаИсточникОЗМР = 0;
		ИндексДобавкаИсточникЭММР = 0;
		ИндексДобавкаИсточникЗММР = 0;
		ИндексДобавкаИсточникСММР = 0;
		ИндексДобавкаИсточникПЗПР = 0;
		ИндексДобавкаИсточникОЗПР = 0;
		ИндексДобавкаИсточникЭМПР = 0;
		ИндексДобавкаИсточникЗМПР = 0;
		ИндексДобавкаИсточникСМПР = 0;
		ИндексДобавкаИсточникОборуд = 0;
		// Базисные.
		ИндексБазисДобавкаИсточникПЗСР = 0;
		ИндексБазисДобавкаИсточникОЗСР = 0;
		ИндексБазисДобавкаИсточникЭМСР = 0;
		ИндексБазисДобавкаИсточникЗМСР = 0;
		ИндексБазисДобавкаИсточникСМСР = 0;
		ИндексБазисДобавкаИсточникПЗМР = 0;
		ИндексБазисДобавкаИсточникОЗМР = 0;
		ИндексБазисДобавкаИсточникЭММР = 0;
		ИндексБазисДобавкаИсточникЗММР = 0;
		ИндексБазисДобавкаИсточникСММР = 0;
		ИндексБазисДобавкаИсточникПЗПР = 0;
		ИндексБазисДобавкаИсточникОЗПР = 0;
		ИндексБазисДобавкаИсточникЭМПР = 0;
		ИндексБазисДобавкаИсточникЗМПР = 0;
		ИндексБазисДобавкаИсточникСМПР = 0;
		ИндексБазисДобавкаИсточникОборуд = 0;

		СуммироватьДобавки = НЕ ОпределитьСоотвИстПриемЛимЗатрат(ТекСтрока.ЛимитированнаяЗатрата);
		
		Если ТекСтрока.ЛимитированнаяЗатрата.ИсточникСтроитРабот Тогда
			ВидРаботИсточник = Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы;	
			МассивСтрок = СобратьСтрокуРасчета(Ссылка,ВидРаботИсточник,ТекСтрока,ИтогиПоГлавам, ИтогиПоВР);	
			
			Если МассивСтрок.Количество() > 0 Тогда 
				НайденнаяСтрока = МассивСтрок[0];
				ЗатратыТрудаРабочих	= ЗатратыТрудаРабочих + НайденнаяСтрока.ЗатратыТрудаРабочих;
				ЗатратыТрудаМашин	= ЗатратыТрудаМашин + НайденнаяСтрока.ЗатратыТрудаМашин;
				БазисСЗП = БазисСЗП + НайденнаяСтрока.ОснЗарплата ;
				БазисСЗПМашин = БазисСЗПМашин + НайденнаяСтрока.ЗарплМашин;
				СЗП 	 = СЗП + НайденнаяСтрока.ТекОснЗарплата ;
				СЗПМашин 	 = СЗПМашин +  НайденнаяСтрока.ТекЗарплМашин;
				Если ТипЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Индекс Тогда
					Если БазисЗначениеЗатраты <> 0 Тогда
						ИндексБазисДобавкаИсточникПЗСР = Окр(НайденнаяСтрока.ПрямЗатраты * (БазисЗначениеЗатраты),КолЗнаков);
						ИндексБазисДобавкаИсточникОЗСР = Окр(НайденнаяСтрока.ОснЗарплата * (БазисЗначениеЗатраты),КолЗнаков);
						ИндексБазисДобавкаИсточникЭМСР = Окр(НайденнаяСтрока.ЭксплМашин * (БазисЗначениеЗатраты),КолЗнаков);
						ИндексБазисДобавкаИсточникЗМСР = Окр(НайденнаяСтрока.ЗарплМашин * (БазисЗначениеЗатраты),КолЗнаков);
						ИндексБазисДобавкаИсточникСМСР = Окр(НайденнаяСтрока.СтоимМатер * (БазисЗначениеЗатраты),КолЗнаков);
						
						ИсточникСтроитРаботПЗ 	= Окр(НайденнаяСтрока.ПрямЗатраты * (БазисЗначениеЗатраты-1),КолЗнаков);
						ИсточникСтроитРаботОЗ 	= Окр(НайденнаяСтрока.ОснЗарплата * (БазисЗначениеЗатраты-1),КолЗнаков);
						ИсточникСтроитРаботЭМ 	= Окр(НайденнаяСтрока.ЭксплМашин * (БазисЗначениеЗатраты-1),КолЗнаков);
						ИсточникСтроитРаботЗМ 	= Окр(НайденнаяСтрока.ЗарплМашин * (БазисЗначениеЗатраты-1),КолЗнаков);
						ИсточникСтроитРаботСМ 	= Окр(НайденнаяСтрока.СтоимМатер * (БазисЗначениеЗатраты-1),КолЗнаков);
					КонецЕсли;
					Если ЗначениеЗатраты <> 0 Тогда
						ИндексДобавкаИсточникПЗСР = Окр(НайденнаяСтрока.ТекПрямЗатраты * (ЗначениеЗатраты),КолЗнаков);
						ИндексДобавкаИсточникОЗСР = Окр(НайденнаяСтрока.ТекОснЗарплата * (ЗначениеЗатраты),КолЗнаков);;
						ИндексДобавкаИсточникЭМСР = Окр(НайденнаяСтрока.ТекЭксплМашин * (ЗначениеЗатраты),КолЗнаков);
						ИндексДобавкаИсточникЗМСР = Окр(НайденнаяСтрока.ТекЗарплМашин * (ЗначениеЗатраты),КолЗнаков);
						ИндексДобавкаИсточникСМСР = Окр(НайденнаяСтрока.ТекСтоимМатер * (ЗначениеЗатраты),КолЗнаков);
	
						ТекИсточникСтроитРаботПЗ = Окр(НайденнаяСтрока.ТекПрямЗатраты * (ЗначениеЗатраты-1),КолЗнаков);
						ТекИсточникСтроитРаботОЗ = Окр(НайденнаяСтрока.ТекОснЗарплата * (ЗначениеЗатраты-1),КолЗнаков);
						ТекИсточникСтроитРаботЭМ = Окр(НайденнаяСтрока.ТекЭксплМашин * (ЗначениеЗатраты-1),КолЗнаков);
						ТекИсточникСтроитРаботЗМ = Окр(НайденнаяСтрока.ТекЗарплМашин * (ЗначениеЗатраты-1),КолЗнаков);
						ТекИсточникСтроитРаботСМ = Окр(НайденнаяСтрока.ТекСтоимМатер * (ЗначениеЗатраты-1),КолЗнаков);
					КонецЕсли;
					
