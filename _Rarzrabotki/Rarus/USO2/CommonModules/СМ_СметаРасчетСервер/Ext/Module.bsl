	КонецЕсли;
	
	//  Округление.
	СметПрибыль.ПрямЗатраты 	= Окр(СметПрибыль.ПрямЗатраты,КолЗнаков);
	СметПрибыль.ТекПрямЗатраты 	= Окр(СметПрибыль.ТекПрямЗатраты,КолЗнаков);
	            	
	Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
		И Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета Тогда
		Если СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат Тогда	
			ДобавПЗБезСоставл = 0;
			ИндексыПоСметеКЭлементам = ТаблРасчета.Добавить();
			ИндексыПоСметеКЭлементам.Итог = Справочники.СМ_ИтогиПоСмете.ИндексыПоСметеКЭлементам;
			ИндексыПоСметеКЭлементам.ПрямЗатраты 	= Окр(ИтогоПоСмете.ПрямЗатраты,КолЗнаков);
			ИндексыПоСметеКЭлементам.ОснЗарплата 	= Окр(ИтогоПоСмете.ОснЗарплата,КолЗнаков);
			ИндексыПоСметеКЭлементам.ЭксплМашин 	= Окр(ИтогоПоСмете.ЭксплМашин,КолЗнаков);
