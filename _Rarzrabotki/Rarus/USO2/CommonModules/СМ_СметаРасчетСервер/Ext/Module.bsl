							ТекИсточникПрочихРаботПЗ = Окр(НайденнаяСтрока.ТекПрямЗатраты  * ЗначениеЗатраты, КолЗнаков);
							РасчетнаяЗатрата = РасчетнаяЗатрата + ТекИсточникПрочихРаботПЗ;
						КонецЕсли;
					КонецЕсли;	
				ИначеЕсли ТипЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Процент Тогда
					Если БазисЗначениеЗатраты <> 0 Тогда
						Если ПустаяСтрока(ТекСтрока.ЛимитированнаяЗатрата.ОтФормулы) = Истина Тогда	
							Если ТекСтрока.ЛимитированнаяЗатрата.ИсточникПрочихРаботПЗ Тогда	
								ИсточникПрочихРаботПЗ = Окр(НайденнаяСтрока.ПрямЗатраты * БазисЗначениеЗатраты / 100,КолЗнаков);
								РасчетнаяЗатрата = РасчетнаяЗатрата + ИсточникПрочихРаботПЗ;
							КонецЕсли;
							Если ТекСтрока.ЛимитированнаяЗатрата.ИсточникПрочихРаботОЗ Тогда	
								ИсточникПрочихРаботОЗ = Окр(НайденнаяСтрока.ОснЗарплата * БазисЗначениеЗатраты / 100,КолЗнаков);
								РасчетнаяЗатрата = РасчетнаяЗатрата + ИсточникПрочихРаботОЗ;
							КонецЕсли;
							Если ТекСтрока.ЛимитированнаяЗатрата.ИсточникПрочихРаботЭМ Тогда	
								ИсточникПрочихРаботЭМ = Окр(НайденнаяСтрока.ЭксплМашин * БазисЗначениеЗатраты / 100,КолЗнаков);
								РасчетнаяЗатрата = РасчетнаяЗатрата + ИсточникПрочихРаботЭМ;
							КонецЕсли;
							Если ТекСтрока.ЛимитированнаяЗатрата.ИсточникПрочихРаботЗМ Тогда	
								ИсточникПрочихРаботЗМ = Окр(НайденнаяСтрока.ЗарплМашин * БазисЗначениеЗатраты / 100,КолЗнаков);
								РасчетнаяЗатрата = РасчетнаяЗатрата + ИсточникПрочихРаботЗМ;
							КонецЕсли;
							Если ТекСтрока.ЛимитированнаяЗатрата.ИсточникПрочихРаботСМ Тогда	
								ИсточникПрочихРаботСМ = Окр(НайденнаяСтрока.СтоимМатер * БазисЗначениеЗатраты / 100,КолЗнаков);						
								РасчетнаяЗатрата = РасчетнаяЗатрата + ИсточникПрочихРаботСМ;
							КонецЕсли;
						Иначе	
							ИсточникПрочихРаботПЗ = Окр(НайденнаяСтрока.ПрямЗатраты * БазисЗначениеЗатраты / 100, КолЗнаков);
							РасчетнаяЗатрата = РасчетнаяЗатрата + ИсточникПрочихРаботПЗ;
						КонецЕсли;
					КонецЕсли;	
					Если ЗначениеЗатраты <> 0 Тогда
						Если ПустаяСтрока(ТекСтрока.ЛимитированнаяЗатрата.ОтФормулы) = Истина Тогда	
							Если ТекСтрока.ЛимитированнаяЗатрата.ИсточникПрочихРаботПЗ Тогда	
								ТекИсточникПрочихРаботПЗ = Окр(НайденнаяСтрока.ТекПрямЗатраты * ЗначениеЗатраты / 100,КолЗнаков);
								РасчетнаяЗатрата = РасчетнаяЗатрата + ТекИсточникПрочихРаботПЗ;
							КонецЕсли;
							Если ТекСтрока.ЛимитированнаяЗатрата.ИсточникПрочихРаботОЗ Тогда	
								ТекИсточникПрочихРаботОЗ = Окр(НайденнаяСтрока.ТекОснЗарплата * ЗначениеЗатраты / 100,КолЗнаков);
								РасчетнаяЗатрата = РасчетнаяЗатрата + ТекИсточникПрочихРаботОЗ;
							КонецЕсли;
							Если ТекСтрока.ЛимитированнаяЗатрата.ИсточникПрочихРаботЭМ Тогда	
								ТекИсточникПрочихРаботЭМ = Окр(НайденнаяСтрока.ТекЭксплМашин * ЗначениеЗатраты / 100,КолЗнаков);
								РасчетнаяЗатрата = РасчетнаяЗатрата + ТекИсточникПрочихРаботЭМ;
							КонецЕсли;
							Если ТекСтрока.ЛимитированнаяЗатрата.ИсточникПрочихРаботЗМ Тогда	
								ТекИсточникПрочихРаботЗМ = Окр(НайденнаяСтрока.ТекЗарплМашин * ЗначениеЗатраты / 100,КолЗнаков);
								РасчетнаяЗатрата = РасчетнаяЗатрата + ТекИсточникПрочихРаботЗМ;
							КонецЕсли;
							Если ТекСтрока.ЛимитированнаяЗатрата.ИсточникПрочихРаботСМ Тогда	
								ТекИсточникПрочихРаботСМ = Окр(НайденнаяСтрока.ТекСтоимМатер * ЗначениеЗатраты / 100,КолЗнаков);						
								РасчетнаяЗатрата = РасчетнаяЗатрата + ТекИсточникПрочихРаботСМ;
							КонецЕсли;
						Иначе	
							ТекИсточникПрочихРаботПЗ = Окр(НайденнаяСтрока.ТекПрямЗатраты * ЗначениеЗатраты / 100, КолЗнаков);
							РасчетнаяЗатрата = РасчетнаяЗатрата + ТекИсточникПрочихРаботПЗ;
						КонецЕсли;
						
					КонецЕсли;	
				КонецЕсли;
				Если СуммироватьДобавки Тогда
					ОбщаяДобавкаИсточникПЗ = ОбщаяДобавкаИсточникПЗ + ТекИсточникПрочихРаботПЗ;
					ОбщаяДобавкаИсточникОЗ = ОбщаяДобавкаИсточникОЗ + ТекИсточникПрочихРаботОЗ;
					ОбщаяДобавкаИсточникЭМ = ОбщаяДобавкаИсточникЭМ + ТекИсточникПрочихРаботЭМ;
					ОбщаяДобавкаИсточникСМ = ОбщаяДобавкаИсточникСМ + ТекИсточникПрочихРаботСМ;
					ОбщаяДобавкаИсточникЗМ = ОбщаяДобавкаИсточникЗМ + ТекИсточникПрочихРаботЗМ;
					БазисОбщаяДобавкаИсточникПЗ = БазисОбщаяДобавкаИсточникПЗ + ИсточникПрочихРаботПЗ;
					БазисОбщаяДобавкаИсточникОЗ = БазисОбщаяДобавкаИсточникОЗ + ИсточникПрочихРаботОЗ;
					БазисОбщаяДобавкаИсточникЭМ = БазисОбщаяДобавкаИсточникЭМ + ИсточникПрочихРаботЭМ;
					БазисОбщаяДобавкаИсточникСМ = БазисОбщаяДобавкаИсточникСМ + ИсточникПрочихРаботСМ;
					БазисОбщаяДобавкаИсточникЗМ = БазисОбщаяДобавкаИсточникЗМ + ИсточникПрочихРаботЗМ;
				КонецЕсли;

			КонецЕсли;
			
		КонецЕсли;	
		
		// Обработка коэфф. трудоемкости.
		НормТрудоемкость    = ЗатратыТрудаРабочих +  ЗатратыТрудаМашин;
		Если ЛимитЗатрата.РезервНаНепредвиденные Тогда
			ДобавкаКЗатратамТруда = Окр(НормТрудоемкость * КоэффициентТрудоемкости,2);
		Иначе	
			Если КоэффициентТрудоемкости <> 0 Тогда
				ДобавкаКЗатратамТруда = Окр((ТекИсточникСтроитРаботПЗ + ТекИсточникПрочихРаботПЗ + ТекИсточникМонтажРаботПЗ) * КоэффициентТрудоемкости,2);
			КонецЕсли;	 
		КонецЕсли;
		
		//  Обработка коэффициента к сметной зарплате.
		Если ТипЗатраты <> Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Сумма Тогда
			Если ЛимитЗатрата.РезервНаНепредвиденные Тогда	
				ДобавкаКСметнойЗарплате = Окр(СЗП * КоэффициентСметнойЗарплаты,КолЗнаков);
				БазисДобавкаКСметнойЗарплате = Окр(БазисСЗП * КоэффициентСметнойЗарплаты,КолЗнаков);
				ДобавкаКСметнойЗарплатеМашин = Окр(СЗПМашин * КоэффициентСметнойЗарплаты,КолЗнаков);
				БазисДобавкаКСметнойЗарплатеМашин = Окр(БазисСЗПМашин * КоэффициентСметнойЗарплаты,КолЗнаков);
			Иначе
				ДобавкаКСметнойЗарплате = Окр((ТекИсточникСтроитРаботПЗ + ТекИсточникПрочихРаботПЗ + ТекИсточникМонтажРаботПЗ) * КоэффициентСметнойЗарплаты,КолЗнаков);
				БазисДобавкаКСметнойЗарплате = Окр((ИсточникСтроитРаботПЗ + ИсточникПрочихРаботПЗ + ИсточникМонтажРаботПЗ) * КоэффициентСметнойЗарплаты,КолЗнаков);
				БазисДобавкаКСметнойЗарплатеМашин = 0;
				ДобавкаКСметнойЗарплатеМашин = 0;
			КонецЕсли;
		КонецЕсли;	
		
		// Добавление рассчитанной затраты к итогам и затратам.
		ТекИтог  		= ТекСтрока.ЛимитированнаяЗатрата.КИтогу;
		ТекГлава		= ТекИтог.ГлаваССРС;
	
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Глава",ТекГлава);
		СтруктураОтбора.Вставить("Итог",ТекИтог);
		Если ТекСтрока.ЛимитированнаяЗатрата.ПриемникСтроитРабот Тогда
			ТекВидРабот 			= Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы;	
			ТабНакопительныхИтогов 	= ПолучитьИтогиПоГлавамПоПорядковомуНомеру(ТекИтог.ПорядковыйНомер);
			
			СтруктураОтбора.Вставить("ВидРабот",ТекВидРабот);
			МассивСтрок = ИтогиПоГлавам.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество() > 0 Тогда 
				
				НайденнаяСтрока 		= МассивСтрок[0];
				НоваяСтрока = НайтиЛимЗатрату(ИтогиПоГлавам,ЛимитЗатрата.Ссылка,Ссылка,ТекВидРабот);
				Если ТипЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Сумма Тогда
					
					// Базисные значения.
					НайденнаяСтрока.ПрямЗатраты = ?(ЛимитЗатрата.ПриемникСтроитРаботПЗ,НайденнаяСтрока.ПрямЗатраты + БазисЗначениеЗатраты,НайденнаяСтрока.ПрямЗатраты);
					НайденнаяСтрока.ОснЗарплата = ?(ЛимитЗатрата.ПриемникСтроитРаботОЗ,НайденнаяСтрока.ОснЗарплата + БазисЗначениеЗатраты,НайденнаяСтрока.ОснЗарплата);
					НайденнаяСтрока.ЭксплМашин 	= ?(ЛимитЗатрата.ПриемникСтроитРаботЭМ,НайденнаяСтрока.ЭксплМашин + БазисЗначениеЗатраты,НайденнаяСтрока.ЭксплМашин);
					НайденнаяСтрока.ЗарплМашин 	= ?(ЛимитЗатрата.ПриемникСтроитРаботЗМ,НайденнаяСтрока.ЗарплМашин + БазисЗначениеЗатраты,НайденнаяСтрока.ЗарплМашин);
					НайденнаяСтрока.СтоимМатер 	= ?(ЛимитЗатрата.ПриемникСтроитРаботСМ,НайденнаяСтрока.СтоимМатер + БазисЗначениеЗатраты,НайденнаяСтрока.СтоимМатер);
					
					НоваяСтрока.ПрямЗатраты = НоваяСтрока.ПрямЗатраты + ?(ЛимитЗатрата.ПриемникСтроитРаботПЗ,БазисЗначениеЗатраты,0);
					НоваяСтрока.ОснЗарплата = НоваяСтрока.ПрямЗатраты + ?(ЛимитЗатрата.ПриемникСтроитРаботОЗ,БазисЗначениеЗатраты,0);
					НоваяСтрока.ЭксплМашин 	= НоваяСтрока.ЭксплМашин + ?(ЛимитЗатрата.ПриемникСтроитРаботЭМ,БазисЗначениеЗатраты,0);
					НоваяСтрока.ЗарплМашин 	= НоваяСтрока.ЗарплМашин + ?(ЛимитЗатрата.ПриемникСтроитРаботЗМ,БазисЗначениеЗатраты,0);
					НоваяСтрока.СтоимМатер 	= НоваяСтрока.СтоимМатер + ?(ЛимитЗатрата.ПриемникСтроитРаботСМ,БазисЗначениеЗатраты,0);
					
					// Текущие значения.
					НайденнаяСтрока.ТекПрямЗатраты = ?(ЛимитЗатрата.ПриемникСтроитРаботПЗ,НайденнаяСтрока.ТекПрямЗатраты + ЗначениеЗатраты,НайденнаяСтрока.ТекПрямЗатраты);
					НайденнаяСтрока.ТекОснЗарплата = ?(ЛимитЗатрата.ПриемникСтроитРаботОЗ,НайденнаяСтрока.ТекОснЗарплата + ЗначениеЗатраты,НайденнаяСтрока.ТекОснЗарплата);
					НайденнаяСтрока.ТекЭксплМашин 	= ?(ЛимитЗатрата.ПриемникСтроитРаботЭМ,НайденнаяСтрока.ТекЭксплМашин + ЗначениеЗатраты,НайденнаяСтрока.ТекЭксплМашин);
					НайденнаяСтрока.ТекЗарплМашин 	= ?(ЛимитЗатрата.ПриемникСтроитРаботЗМ,НайденнаяСтрока.ТекЗарплМашин + ЗначениеЗатраты,НайденнаяСтрока.ТекЗарплМашин);
					НайденнаяСтрока.ТекСтоимМатер 	= ?(ЛимитЗатрата.ПриемникСтроитРаботСМ,НайденнаяСтрока.ТекСтоимМатер + ЗначениеЗатраты,НайденнаяСтрока.ТекСтоимМатер);
					
					НоваяСтрока.ТекПрямЗатраты  = НоваяСтрока.ТекПрямЗатраты + ?(ЛимитЗатрата.ПриемникСтроитРаботПЗ,ЗначениеЗатраты,0);
					НоваяСтрока.ТекОснЗарплата  = НоваяСтрока.ТекОснЗарплата + ?(ЛимитЗатрата.ПриемникСтроитРаботОЗ,ЗначениеЗатраты,0);
					НоваяСтрока.ТекЭксплМашин 	= НоваяСтрока.ТекЭксплМашин + ?(ЛимитЗатрата.ПриемникСтроитРаботЭМ,ЗначениеЗатраты,0);
					НоваяСтрока.ТекЗарплМашин 	= НоваяСтрока.ТекЗарплМашин + ?(ЛимитЗатрата.ПриемникСтроитРаботЗМ,ЗначениеЗатраты,0);
					НоваяСтрока.ТекСтоимМатер 	= НоваяСтрока.ТекСтоимМатер + ?(ЛимитЗатрата.ПриемникСтроитРаботСМ,ЗначениеЗатраты,0);
					
					// Добавление рассчитанной лимитированной затраты к накопительным итогам (следующим после текущего итога).
					ТекВидРабот 			= Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы;	
					ДобавлениеЗатратыВНакопительныеИтоги(ИтогиПоГлавам,ТабНакопительныхИтогов,ТекВидРабот,ЛимитЗатрата,БазисЗначениеЗатраты,ЗначениеЗатраты);
					
				Иначе
					Если СуммироватьДобавки Тогда
						ТекИсточникСтроитРаботПЗ = ОбщаяДобавкаИсточникПЗ; 
						ТекИсточникСтроитРаботОЗ = ОбщаяДобавкаИсточникОЗ; 
						ТекИсточникСтроитРаботЭМ = ОбщаяДобавкаИсточникЭМ; 
						ТекИсточникСтроитРаботЗМ = ОбщаяДобавкаИсточникЗМ; 
						ТекИсточникСтроитРаботСМ = ОбщаяДобавкаИсточникСМ; 
						ИсточникСтроитРаботПЗ = БазисОбщаяДобавкаИсточникПЗ; 
						ИсточникСтроитРаботОЗ = БазисОбщаяДобавкаИсточникОЗ; 
						ИсточникСтроитРаботЭМ = БазисОбщаяДобавкаИсточникЭМ; 
						ИсточникСтроитРаботЗМ = БазисОбщаяДобавкаИсточникЗМ; 
						ИсточникСтроитРаботСМ = БазисОбщаяДобавкаИсточникСМ; 
					КонецЕсли;
					// Базисные значения.
					Если ПустаяСтрока(ТекСтрока.ЛимитированнаяЗатрата.ОтФормулы) = Ложь Тогда	
						НайденнаяСтрока.ПрямЗатраты = НайденнаяСтрока.ПрямЗатраты + ИсточникСтроитРаботПЗ;
					Иначе	
						Если ТекСтрока.ЛимитированнаяЗатрата.ИсточникСтроитРаботПЗ Тогда	
							НайденнаяСтрока.ПрямЗатраты = ?(ЛимитЗатрата.ПриемникСтроитРаботПЗ,НайденнаяСтрока.ПрямЗатраты + ИсточникСтроитРаботПЗ,НайденнаяСтрока.ПрямЗатраты);
						Иначе
							Если ТекСтрока.ЛимитированнаяЗатрата.ИсточникСтроитРаботОЗ Тогда
								НайденнаяСтрока.ПрямЗатраты = ?(ЛимитЗатрата.ПриемникСтроитРаботПЗ,НайденнаяСтрока.ПрямЗатраты + ИсточникСтроитРаботОЗ,НайденнаяСтрока.ПрямЗатраты);
							КонецЕсли;
							Если ТекСтрока.ЛимитированнаяЗатрата.ИсточникСтроитРаботЭМ Тогда
								НайденнаяСтрока.ПрямЗатраты = ?(ЛимитЗатрата.ПриемникСтроитРаботПЗ,НайденнаяСтрока.ПрямЗатраты + ИсточникСтроитРаботЭМ,НайденнаяСтрока.ПрямЗатраты);
							КонецЕсли;
							Если ТекСтрока.ЛимитированнаяЗатрата.ИсточникСтроитРаботЗМ Тогда
								НайденнаяСтрока.ПрямЗатраты = ?(ЛимитЗатрата.ПриемникСтроитРаботПЗ,НайденнаяСтрока.ПрямЗатраты + ИсточникСтроитРаботЗМ,НайденнаяСтрока.ПрямЗатраты);
							КонецЕсли;
							Если ТекСтрока.ЛимитированнаяЗатрата.ИсточникСтроитРаботСМ Тогда
								НайденнаяСтрока.ПрямЗатраты = ?(ЛимитЗатрата.ПриемникСтроитРаботПЗ,НайденнаяСтрока.ПрямЗатраты + ИсточникСтроитРаботСМ,НайденнаяСтрока.ПрямЗатраты);
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					НайденнаяСтрока.ОснЗарплата = ?(ЛимитЗатрата.ПриемникСтроитРаботОЗ,НайденнаяСтрока.ОснЗарплата + ИсточникСтроитРаботОЗ,НайденнаяСтрока.ОснЗарплата);
					НайденнаяСтрока.ЭксплМашин 	= ?(ЛимитЗатрата.ПриемникСтроитРаботЭМ,НайденнаяСтрока.ЭксплМашин + ИсточникСтроитРаботЭМ,НайденнаяСтрока.ЭксплМашин);
					НайденнаяСтрока.ЗарплМашин 	= ?(ЛимитЗатрата.ПриемникСтроитРаботЗМ,НайденнаяСтрока.ЗарплМашин + ИсточникСтроитРаботЗМ,НайденнаяСтрока.ЗарплМашин);
					НайденнаяСтрока.СтоимМатер 	= ?(ЛимитЗатрата.ПриемникСтроитРаботСМ,НайденнаяСтрока.СтоимМатер + ИсточникСтроитРаботСМ,НайденнаяСтрока.СтоимМатер);
					
