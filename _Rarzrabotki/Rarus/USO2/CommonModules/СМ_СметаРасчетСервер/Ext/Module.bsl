			ДобавкаНРвОЗ.Итог 			= Справочники.СМ_ИтогиПоРазделу.ОЗвНаклРасходах;
		КонецЕсли;
		Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
			ДобавкакОЗ = Окр(?(ИтоговаяСтрокаБЕ.СуммаДобавкаОЗ = NULL, 0, ИтоговаяСтрокаБЕ.СуммаДобавкаОЗ),КолЗнаков) ;
		Иначе	
			ДобавкакОЗ = ?(ИтоговаяСтрокаБИ.СуммаДобавкаОЗ =  NULL, 0,ИтоговаяСтрокаБИ.СуммаДобавкаОЗ) ;
		КонецЕсли;
		ДобавкаНРвОЗ.ПрямЗатраты	= Окр(ДобавкаНРвОЗ.ПрямЗатраты,КолЗнаков) + ДобавкакОЗ;
		Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
			И Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда
			Если НаборКоэф <> Неопределено Тогда
				Если СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости 	
					Или (СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат 
					И НаборКоэф.КоэффПолнСтоимРабот <> 0) Тогда
					ДобавкакОЗ = Окр(ДобавкакОЗ * ?(НаборКоэф.КоэффПолнСтоимРабот = 0,1,НаборКоэф.КоэффПолнСтоимРабот),КолЗнаков);
				ИначеЕсли СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат 
