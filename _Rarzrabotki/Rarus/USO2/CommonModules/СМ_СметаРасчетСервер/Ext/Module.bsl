	КонецЕсли;
	
	// Текущее значение.
	ИтогоСУчетомНаклРасх.ТекПрямЗатраты = ИтогоСУчетомНаклРасх.ТекПрямЗатраты + НаклРасхРазделаТекущая + ?(ЗначениеЗаполнено(СИндексамиПЗ),СИндексамиПЗ,ТекПЗ);
	
	// ***************************************************************
	// ++ AVV  Итоги по разделу (базисно-индексный метод по разделу)

	// Для подсчета обнуленной стоимости материала, в печатной форме.
	//ИтогоСУчетомНаклРасх.ТекСтоимМатер = ИтогоПоРазделу.ТекСтоимМатер; // Было
	
	// -- AVV 
	// ***************************************************************

	Если Не МетодикаРСНБ Тогда
		// Сметная прибыль.
		СметПрибыль  = ТаблРасчета.Найти(Справочники.СМ_ИтогиПоРазделу.СметПрибыль,"Итог");
