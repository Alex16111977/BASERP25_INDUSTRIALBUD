// Процедура укрупнения видов работ на общестроительные, монтажные, оборудование, прочие.
//
Процедура УкрупнениеИтоговПоВидамРабот(ИтогиПоВР,Ссылка)	
	Для Каждого СтрокаИтогиПоВР Из ИтогиПоВР Цикл
		ТекВид = СтрокаИтогиПоВР.Итог;
		Если ТекВид = Справочники.СМ_ИтогиСметыПоВидамРабот.СтроитРаб
			ИЛИ ТекВид = Справочники.СМ_ИтогиСметыПоВидамРабот.Металлоконстр
			ИЛИ ТекВид = Справочники.СМ_ИтогиСметыПоВидамРабот.СантехнРаб
			ИЛИ ТекВид = Справочники.СМ_ИтогиСметыПоВидамРабот.БуровзрывнРаб
			ИЛИ ТекВид = Справочники.СМ_ИтогиСметыПоВидамРабот.ГорнопрохРаб Тогда
			СтрокаИтогиПоВР.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы;
		ИначеЕсли ТекВид = Справочники.СМ_ИтогиСметыПоВидамРабот.МонтажнРаб Тогда
			СтрокаИтогиПоВР.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы;
	 	ИначеЕсли ТекВид = Справочники.СМ_ИтогиСметыПоВидамРабот.Оборуд Тогда
			СтрокаИтогиПоВР.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование;	
		ИначеЕсли ТекВид = Справочники.СМ_ИтогиСметыПоВидамРабот.ПрочРаб Тогда
			СтрокаИтогиПоВР.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.ПрочиеРаботы;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Неизвестный итог по видам работ'"));
		КонецЕсли;
	КонецЦикла;
	
	СписокКолонок = "ПрямЗатраты,ОснЗарплата,ЭксплМашин,ЗарплМашин,СтоимМатер,Оборуд,ВозвратМатер,ЗатратыТрудаРабочих,ЗатратыТрудаМашин,ТекПрямЗатраты,ТекОснЗарплата,ТекЭксплМашин,ТекЗарплМашин,ТекСтоимМатер,ТекОборуд,ТекВозвратМатер";
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") ИЛИ ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		ИтогиПоВР.Свернуть("Смета,ЛокальнаяСмета,ВидРабот",СписокКолонок);
	Иначе
		ИтогиПоВР.Свернуть("Смета,ВидРабот",СписокКолонок);
	КонецЕсли;
КонецПроцедуры

// Формирование таблицы для расчета лимитированных затрат Объектных смет.
//
Процедура ФормированиеТаблицыИтогиПоГлавамОС(ИтогиПоГлавам, ИтогиПоВР,Ссылка,СписокВидыЗатрат)
	СписокСвойств 	= "ПрямЗатраты,ОснЗарплата,ЭксплМашин,ЗарплМашин,СтоимМатер,Оборуд,ВозвратМатер,ЗатратыТрудаРабочих,ЗатратыТрудаМашин,ТекПрямЗатраты,ТекОснЗарплата,ТекЭксплМашин,ТекЗарплМашин,ТекСтоимМатер,ТекОборуд,ТекВозвратМатер";
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ИтогиПоГлавам.Ссылка КАК Итог,
	|	ИтогиПоГлавам.Наименование,
	|	ИтогиПоГлавам.ГлаваССРС,
	|	ИтогиПоГлавам.Накопительный,
	|	ИтогиПоГлавам.ПорядковыйНомер
	|ИЗ
	|	Справочник.СМ_ИтогиПоГлавам КАК ИтогиПоГлавам
	|ГДЕ
	|	ИтогиПоГлавам.ПометкаУдаления = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО
	|	ИтогиПоГлавам.ГлаваССРС.НомерГлавы";	
	
	ВыборкаГлав = Запрос.Выполнить().Выгрузить();
	ТипСоставляющей = Новый  ОписаниеТипов("Число");
	СоставляющиеПЗ = Новый ТаблицаЗначений;
	СоставляющиеПЗ.Колонки.Добавить("ВидЗатрат");
	СоставляющиеПЗ.Колонки.Добавить("ПрямЗатраты",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ОснЗарплата",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ЭксплМашин",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ЗарплМашин",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("СтоимМатер",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("Оборуд",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ЗатратыТрудаРабочих",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ЗатратыТрудаМашин",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ВозвратМатер",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ТекПрямЗатраты",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ТекОснЗарплата",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ТекЭксплМашин",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ТекЗарплМашин",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ТекСтоимМатер",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ТекОборуд",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ТекВозвратМатер",ТипСоставляющей);
	
	
	НомерГлавыЛС = 2;	
	СписокСмет = Ссылка.ЛокальныеСметы.Выгрузить();
	Для Каждого  ТекВыборка Из ВыборкаГлав Цикл
		
		Для Каждого ТекВидЗатрат Из СписокВидыЗатрат Цикл
			НоваяСтрока 				= ИтогиПоГлавам.Добавить();	
			НоваяСтрока.Смета       	= Ссылка;
			НоваяСтрока.Глава      	 	= ТекВыборка.ГлаваССРС;
			НоваяСтрока.Итог        	= ТекВыборка.Итог;
			НоваяСтрока.ВидРабот    	= ТекВидЗатрат;
			НоваяСтрока.Накопительный 	= ТекВыборка.Накопительный;
			НоваяСтрока.ПорНомерИтога 	= ТекВыборка.ПорядковыйНомер;
			НоваяСтрока.КодГлавы		= ТекВыборка.ГлаваССРС.Код;
			ОбнулениеСоставляющих(НоваяСтрока);
			ИтогПоиска = ТекВыборка.Итог;
			Если ТекВыборка.ГлаваССРС.НомерГлавы = НомерГлавыЛС Тогда
				Если ТекВыборка.Накопительный = Ложь Тогда
					Для каждого СметаИзСписка Из СписокСмет Цикл
						Если СметаИзСписка.Расчет = Ложь Тогда
							Продолжить;
						КонецЕсли;
						НоваяСтрока 				= ИтогиПоГлавам.Добавить();	
						НоваяСтрока.Итог  			= СметаИзСписка.ЛокальнаяСмета.Ссылка;
						НоваяСтрока.Смета       	= Ссылка;
						НоваяСтрока.Глава      	 	= ТекВыборка.ГлаваССРС;
						НоваяСтрока.ВидРабот    	= ТекВидЗатрат;
						НоваяСтрока.Накопительный 	= ТекВыборка.Накопительный;
						НоваяСтрока.ПорНомерИтога 	= ТекВыборка.ПорядковыйНомер;
						НоваяСтрока.КодГлавы		= ТекВыборка.ГлаваССРС.Код;
						СтруктураОтбора = Новый Структура;
						СтруктураОтбора.Вставить("ВидРабот",ТекВидЗатрат);
						СтруктураОтбора.Вставить("ЛокальнаяСмета",СметаИзСписка.ЛокальнаяСмета);
						
						МассивСтрок = ИтогиПоВР.НайтиСтроки(СтруктураОтбора);
						Для Каждого НайденнаяСтрока Из МассивСтрок Цикл
							
							СуммированиеСоставляющих(НоваяСтрока,НайденнаяСтрока);
							// Просуммировать по главе 2.
							Отбор1 = Новый Структура;
							Отбор1.Вставить("ВидЗатрат",ТекВидЗатрат);
							СтрокиОтбора = СоставляющиеПЗ.НайтиСтроки(Отбор1);
							Если СтрокиОтбора.Количество() = 0 Тогда
								ТекущаяСтрока = СоставляющиеПЗ.Добавить();
								ТекущаяСтрока.ВидЗатрат = ТекВидЗатрат;
							Иначе
								ТекущаяСтрока = СтрокиОтбора[0];
							КонецЕсли;	
							СуммированиеСоставляющих(ТекущаяСтрока,НайденнаяСтрока);
							
						КонецЦикла;
					КонецЦикла;	
				КонецЕсли;
			Иначе
				// Перенести в накопительные.
				Если ТекВыборка.Накопительный = Истина Тогда
					Отбор1 = Новый Структура;
					Отбор1.Вставить("ВидЗатрат",ТекВидЗатрат);
					СтрокиОтбора = СоставляющиеПЗ.НайтиСтроки(Отбор1);
					Если СтрокиОтбора.Количество() <> 0 Тогда
						ТекущаяСтрока = СтрокиОтбора[0];
						ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекущаяСтрока,СписокСвойств);
					КонецЕсли;	
					
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;
	// Добавление ЛЗ локальных смет
	СписокЛЗ = Новый ТаблицаЗначений;
	СписокЛЗ.Колонки.Добавить("ЛимЗатрата");
	СписокЛЗ.Колонки.Добавить("ЛокСмета");
	СписокЛЗ.Колонки.Добавить("Номер");
	СписокСмет = Ссылка.ЛокальныеСметы.Выгрузить();
	Для каждого Смета Из СписокСмет Цикл
		Если  Смета.Расчет = Ложь Тогда
			Продолжить;
		КонецЕсли;
		ТекСмета = Смета.ЛокальнаяСмета;
		ТЧЛимЗатраты = ТекСмета.ЛимитированныеЗатраты.Выгрузить();
		Если ТЧЛимЗатраты.Количество()<> 0 Тогда
			Для Каждого ЛЗ Из ТЧЛимЗатраты Цикл
				Если ЛЗ.Расчет = Истина Тогда
					НоваяЗатрата = СписокЛЗ.Добавить();
					НоваяЗатрата.ЛимЗатрата = ЛЗ.ЛимитированнаяЗатрата;
					НоваяЗатрата.Номер = ЛЗ.ЛимитированнаяЗатрата.НомерПоПорядку;
					НоваяЗатрата.ЛокСмета = ТекСмета.Ссылка;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
	КонецЦикла;	
	Если СписокЛЗ.Количество() <> 0 Тогда
		СписокЛЗ.Сортировать("Номер");
		ДобавитьЛимЗатратыЛокальныхСмет(ИтогиПоГлавам, СписокЛЗ,Ссылка);
	КонецЕсли;
	// Добавление ЛЗ локальных смет
	
	ИтогиПоГлавам.Сортировать("ПорНомерИтога Возр");
КонецПроцедуры	

// Формирование таблицы для расчета лимитированных затрат Сводных смет.
//
Процедура ФормированиеТаблицыИтогиПоГлавамСС(ИтогиПоГлавам, ИтогиПоВР,Ссылка,СписокВидыЗатрат)
	СписокСвойств 	= "ПрямЗатраты,ОснЗарплата,ЭксплМашин,ЗарплМашин,СтоимМатер,Оборуд,ВозвратМатер,ЗатратыТрудаРабочих,ЗатратыТрудаМашин,ТекПрямЗатраты,ТекОснЗарплата,ТекЭксплМашин,ТекЗарплМашин,ТекСтоимМатер,ТекОборуд,ТекВозвратМатер";
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ИтогиПоГлавам.Ссылка КАК Итог,
	|	ИтогиПоГлавам.Наименование,
	|	ИтогиПоГлавам.ГлаваССРС,
	|	ИтогиПоГлавам.Накопительный,
	|	ИтогиПоГлавам.ПорядковыйНомер
	|ИЗ
	|	Справочник.СМ_ИтогиПоГлавам КАК ИтогиПоГлавам
	|ГДЕ
	|	ИтогиПоГлавам.ПометкаУдаления = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО
	|	ИтогиПоГлавам.ГлаваССРС.НомерГлавы";	
	
	ВыборкаГлав = Запрос.Выполнить().Выгрузить();
	ТипСоставляющей = Новый  ОписаниеТипов("Число");
	СоставляющиеПЗ = Новый ТаблицаЗначений;
	СоставляющиеПЗ.Колонки.Добавить("ВидЗатрат");
	СоставляющиеПЗ.Колонки.Добавить("ПрямЗатраты",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ОснЗарплата",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ЭксплМашин",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ЗарплМашин",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("СтоимМатер",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("Оборуд",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ЗатратыТрудаРабочих",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ЗатратыТрудаМашин",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ВозвратМатер",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ТекПрямЗатраты",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ТекОснЗарплата",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ТекЭксплМашин",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ТекЗарплМашин",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ТекСтоимМатер",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ТекОборуд",ТипСоставляющей);
	СоставляющиеПЗ.Колонки.Добавить("ТекВозвратМатер",ТипСоставляющей);
	
	СписокСмет = Ссылка.Сметы.Выгрузить();
	Для Каждого  ТекВыборка Из ВыборкаГлав Цикл
		Для Каждого ТекВидЗатрат Из СписокВидыЗатрат Цикл
			// Есть Глава, видРабот.
			Если Не ТекВыборка.Накопительный Тогда
				// Сметы вставляются в ненакопительные Итоги.
				СтруктураОтбора = Новый Структура;
				Если Ссылка.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
					ГлаваКапРемонта = НайтиСоответствиеГлавыСметы(ТекВыборка.ГлаваССРС);
					СтруктураОтбора.Вставить("ГлаваССРС",ГлаваКапРемонта);
				Иначе	
					СтруктураОтбора.Вставить("ГлаваССРС",ТекВыборка.ГлаваССРС);
				КонецЕсли;
				СметыИзСписка = СписокСмет.НайтиСтроки(СтруктураОтбора);
				Для Каждого ТекСтрокаСметы Из СметыИзСписка Цикл
					Если ТекСтрокаСметы.Расчет = Ложь Тогда
						Продолжить;
					КонецЕсли;
					
					СтруктураОтбора = Новый Структура;
					СтруктураОтбора.Вставить("ВидРабот",ТекВидЗатрат);
					СтруктураОтбора.Вставить("ЛокальнаяСмета",ТекСтрокаСметы.Смета);
					
					МассивСтрок = ИтогиПоВР.НайтиСтроки(СтруктураОтбора);
					Если МассивСтрок.Количество() <> 0 Тогда
						
						НоваяСтрока 				= ИтогиПоГлавам.Добавить();	
						НоваяСтрока.Итог  			= ТекСтрокаСметы.Смета.Ссылка;
						НоваяСтрока.Смета       	= Ссылка;
						НоваяСтрока.Глава      	 	= ТекВыборка.ГлаваССРС;
						НоваяСтрока.ВидРабот    	= ТекВидЗатрат;
						НоваяСтрока.Накопительный 	= ТекВыборка.Накопительный;
						НоваяСтрока.ПорНомерИтога 	= ТекВыборка.ПорядковыйНомер;
						НоваяСтрока.КодГлавы		= ТекВыборка.ГлаваССРС.Код;
						Для каждого НайденнаяСтрока Из МассивСтрок Цикл
							СуммированиеСоставляющих(НоваяСтрока,НайденнаяСтрока);
						КонецЦикла;
						
						// Просуммировать по главе 2.
						Отбор1 = Новый Структура;
						Отбор1.Вставить("ВидЗатрат",ТекВидЗатрат);
						СтрокиОтбора = СоставляющиеПЗ.НайтиСтроки(Отбор1);
						Если СтрокиОтбора.Количество() = 0 Тогда
							ТекущаяСтрока = СоставляющиеПЗ.Добавить();
							ТекущаяСтрока.ВидЗатрат = ТекВидЗатрат;
						Иначе
							ТекущаяСтрока = СтрокиОтбора[0];
						КонецЕсли;	
						СуммированиеСоставляющих(ТекущаяСтрока,НоваяСтрока);
					КонецЕсли; // Для Сметы и вида затрат.
				КонецЦикла;	 // Цикл по сметам.
				
				// Итог по Главе для вида работ, должны быть добавлены итоги
				// по сметам для этого вида работ, если они Были. 
				НоваяСтрока 				= ИтогиПоГлавам.Добавить();	
				НоваяСтрока.Смета       	= Ссылка;
				НоваяСтрока.Глава      	 	= ТекВыборка.ГлаваССРС;
				НоваяСтрока.Итог        	= ТекВыборка.Итог;
				НоваяСтрока.ВидРабот    	= ТекВидЗатрат;
				НоваяСтрока.Накопительный 	= ТекВыборка.Накопительный;
				НоваяСтрока.ПорНомерИтога 	= ТекВыборка.ПорядковыйНомер;
				НоваяСтрока.КодГлавы		= ТекВыборка.ГлаваССРС.Код;
				
				// Вставить Сумму итога по виду затрат для этого итога.
				ОбнулениеСоставляющих(НоваяСтрока);
			
			Иначе // Итог накопительный.
				
				НоваяСтрока 				= ИтогиПоГлавам.Добавить();	
				НоваяСтрока.Смета       	= Ссылка;
				НоваяСтрока.Глава      	 	= ТекВыборка.ГлаваССРС;
				НоваяСтрока.Итог        	= ТекВыборка.Итог;
				НоваяСтрока.ВидРабот    	= ТекВидЗатрат;
				НоваяСтрока.Накопительный 	= ТекВыборка.Накопительный;
				НоваяСтрока.ПорНомерИтога 	= ТекВыборка.ПорядковыйНомер;
				НоваяСтрока.КодГлавы		= ТекВыборка.ГлаваССРС.Код;
				// Перенести в накопительные.
				Отбор1 = Новый Структура;
				Отбор1.Вставить("ВидЗатрат",ТекВидЗатрат);
				СтрокиОтбора = СоставляющиеПЗ.НайтиСтроки(Отбор1);
				Если СтрокиОтбора.Количество() <> 0 Тогда
					НайденнаяСтрока = СтрокиОтбора[0];
					СуммированиеСоставляющих(НоваяСтрока,НайденнаяСтрока);
				Иначе
					ОбнулениеСоставляющих(НоваяСтрока);
				КонецЕсли;	
				
			КонецЕсли;// Сметы вставляются в ненакопительные Итоги.
			
			
		КонецЦикла;  //Виды Затрат.
		
	КонецЦикла;  // По главам.
	СписокЛЗ = Новый ТаблицаЗначений;
	СписокЛЗ.Колонки.Добавить("ЛимЗатрата");
	СписокЛЗ.Колонки.Добавить("ОбСмета");
	СписокЛЗ.Колонки.Добавить("Номер");
	СписокСмет = Ссылка.Сметы.Выгрузить();
	Для каждого Смета Из СписокСмет Цикл
		Если  Смета.Расчет = Ложь Тогда
			Продолжить;
		КонецЕсли;
		ТекСмета = Смета.Смета;
		ТЧЛимЗатраты = ТекСмета.ЛимитированныеЗатраты.Выгрузить();
		Если ТЧЛимЗатраты.Количество()<> 0 Тогда
			Для Каждого ЛЗ Из ТЧЛимЗатраты Цикл
				Если ЛЗ.Расчет = Истина Тогда
					НоваяЗатрата = СписокЛЗ.Добавить();
					НоваяЗатрата.ЛимЗатрата = ЛЗ.ЛимитированнаяЗатрата;
					НоваяЗатрата.Номер = ЛЗ.ЛимитированнаяЗатрата.НомерПоПорядку;
					НоваяЗатрата.ОбСмета = ТекСмета.Ссылка;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
		Если ТипЗнч(ТекСмета) =  Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
			ДобавитьЛИмЗатратыПодчиненныхЛокСмет(ТекСмета,СписокЛЗ);	
		КонецЕсли;
		
	КонецЦикла;	

	Если СписокЛЗ.Количество() <> 0 Тогда
		СписокЛЗ.Сортировать("Номер");
		ДобавитьЛимЗатратыОбъектныхСмет(ИтогиПоГлавам, СписокЛЗ,Ссылка);
	КонецЕсли;
	ИтогиПоГлавам.Сортировать("ПорНомерИтога Возр");

КонецПроцедуры

