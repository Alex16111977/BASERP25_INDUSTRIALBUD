		Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный И Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда
			Если НаборКоэф <> Неопределено Тогда
				Если СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости 	
					Или (СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат 
					И НаборКоэф.КоэффПолнСтоимРабот <> 0) Тогда
					ДобавкакТР = Окр(ДобавкакТР * ?(НаборКоэф.КоэффПолнСтоимРабот = 0,1,НаборКоэф.КоэффПолнСтоимРабот),КолЗнаков);
				ИначеЕсли СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат 
					И НаборКоэф.КоэффПолнСтоимРабот = 0 Тогда	
					ДобавкакТР = Окр(ДобавкакТР * ?(НаборКоэф.КоэффОснЗарплаты = 0,1,НаборКоэф.КоэффОснЗарплаты),КолЗнаков);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ДобавкаНРвТР.ТекПрямЗатраты	= Окр(ДобавкаНРвТР.ТекПрямЗатраты,КолЗнаков) + ДобавкакТР;
		
	КонецЕсли;
	//
	// Методика 1984 года
	
	// Итого с учетом накладных расходов.
	ИтогоСУчетомНаклРасх  = ТаблРасчета.Найти(Справочники.СМ_ИтогиПоРазделу.ИтогоСУчетомНаклРасх,"Итог");
	Если ИтогоСУчетомНаклРасх = Неопределено Тогда
