	КонецЕсли;                                      	

	Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
		И Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета
		И СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости Тогда	
