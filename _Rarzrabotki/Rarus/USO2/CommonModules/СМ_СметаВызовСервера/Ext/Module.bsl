	ИДРодителя              = ?(СтруктураПараметров.Свойство("ИДРодителя"),СтруктураПараметров.ИДРодителя,Неопределено);
	ВАрхив                  = ?(СтруктураПараметров.Свойство("ВАрхив"),СтруктураПараметров.ВАрхив,Ложь);
	Перерасчет              = ?(СтруктураПараметров.Свойство("Перерасчет"),СтруктураПараметров.Перерасчет,Истина);
	СписокАктовДляПересчета = ?(СтруктураПараметров.Свойство("СписокАктовДляПересчета"),СтруктураПараметров.СписокАктовДляПересчета,Неопределено);
	
	СкопироватьОбъектнуюСмету(СтараяСмета,Транзакция,НоваяСмета,ИДРодителя,ВАрхив,Перерасчет,СписокАктовДляПересчета);
	
