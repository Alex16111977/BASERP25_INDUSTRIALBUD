Процедура ЗаполнитьУсловияВидимостиКоманды(КомандаПечати) Экспорт
	
	// Заполнение условий видимости команды. 
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Идентификатор",КомандаПечати.Идентификатор);
	
	// Если задано несколько условий видимости для одной команды, 
	// то соединение условий осуществляется по логическому "И".
	ТаблицаНастроек = НастройкиДоступностиКомандПечати();
	НайденныеСтроки = ТаблицаНастроек.НайтиСтроки(СтруктураОтбора);
	Для Каждого ТекСтрока Из НайденныеСтроки Цикл
		ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(КомандаПечати,ТекСтрока.Реквизит,ТекСтрока.Значение,ТекСтрока.ВидСравнения);
	КонецЦикла;

