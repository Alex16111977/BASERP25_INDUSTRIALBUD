			ИЛИ ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
			ИЛИ ТипЗнч(СсылкаНаДокумент) = Тип("ДокументОбъект.СМ_РазделЛокальнойСметы") Тогда
			Возврат ПолучитьСсылкуНаДокумент(СсылкаНаДокумент.ИдСметы);
