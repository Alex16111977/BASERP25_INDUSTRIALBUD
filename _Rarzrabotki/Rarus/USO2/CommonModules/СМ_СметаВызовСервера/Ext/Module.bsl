// Заполняет неучтенный ресурс (ДокументОбъект.СМ_ПозицияЛокальнойСметы) 
// данными из справочника Ресурсы или соответствующей структуры.
//
// Параметры:
//     ПозицияРесурс 			- ДокументОбъект.СМ_ПозицияЛокальнойСметы - документ, который заполняется.
//     ПозицияВладелец 			- ДокументОбъект.СМ_ПозицияЛокальнойСметы - документ, которому подчинен неучтенный ресурс.
//     СтруктураОписанияРесурса - Структура - содержит поля, описывающие ресурс
//                                (см. методы ИнициироватьСтруктуруОписанияРесурса() и ПолучитьОписаниеРесурса()).
//     Объем 					- Число	- объем расхода ресурса.
//     ФормулаОбъема 			- Строка - формула расчета объема.
//     СтруктураПараметровЛС 	- Структура - содержит значения реквизитов локальной сметы.
//
Процедура ЗаполнитьДанныеНеучтенногоРесурсаПоСправочнику(ПозицияРесурс, ПозицияВладелец, СтруктураОписанияРесурса, Объем = 1, ФормулаОбъема = "", СтруктураПараметровЛС = Неопределено) Экспорт
	
	ПозицияРесурс.ФормулаОбъема = ФормулаОбъема;
	ПозицияРесурс.Наименование = ?(ЗначениеЗаполнено(СтруктураОписанияРесурса.Ресурс),СтруктураОписанияРесурса.Ресурс.Наименование,СтруктураОписанияРесурса.НаименованиеРесурса);
	Если ЗначениеЗаполнено(СтруктураОписанияРесурса.Код) Тогда
		ПозицияРесурс.ШифрРасценки = СтруктураОписанияРесурса.Код; 
	Иначе
		ПозицияРесурс.ШифрРасценки = СтруктураОписанияРесурса.Ресурс.Код;
	КонецЕсли;
	ПозицияРесурс.Дата = СтруктураОписанияРесурса.Раздел.Дата;
	ПозицияРесурс.ЕдиницаИзмерения = ?(ЗначениеЗаполнено(СтруктураОписанияРесурса.ЕдИзм),СтруктураОписанияРесурса.ЕдИзм,СтруктураОписанияРесурса.ЕдиницаИзмеренияРесурса);
	ПозицияРесурс.Измеритель = ?(ЗначениеЗаполнено(СтруктураОписанияРесурса.ЕдИзм),ПозицияРесурс.ЕдиницаИзмерения.Наименование,СтруктураОписанияРесурса.ЕдиницаИзмеренияРесурса);
	ПозицияРесурс.РегиональнаяБаза = СтруктураОписанияРесурса.РегиональнаяБаза;
	ПозицияРесурс.НеПрименятьИндексы = СтруктураОписанияРесурса.НеИндексировать;
	Если СтруктураОписанияРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
		ПозицияРесурс.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;
		ПозицияРесурс.Определитель = Справочники.СМ_Определители.НайтиПоКоду("19");
		ПозицияРесурс.СтоимМатериалов = СтруктураОписанияРесурса.БазиснаяЦена;
		ПозицияРесурс.ТекущаяЦена = СтруктураОписанияРесурса.ТекущаяЦена;
	ИначеЕсли СтруктураОписанияРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
		ПозицияРесурс.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин;
		ПозицияРесурс.Определитель = Справочники.СМ_Определители.НайтиПоКоду("1");
		ПозицияРесурс.ЗарплМашинистов = СтруктураОписанияРесурса.БазиснаяЗарплМаш;
		ПозицияРесурс.ЭксплМашин = СтруктураОписанияРесурса.БазиснаяЦена;
		ПозицияРесурс.ТекущаяЗарплатаМашинистов = СтруктураОписанияРесурса.ТекущаяЗарплМаш;
		ПозицияРесурс.ТекущаяЦена = СтруктураОписанияРесурса.ТекущаяЦена;
	КонецЕсли;
	ПозицияРесурс.ПрямЗатраты 	= СтруктураОписанияРесурса.БазиснаяЦена;
	ПозицияРесурс.Расчет 		= Истина;
	ПозицияРесурс.ОбъемРабот 	= Объем;
	
	// ++ AVV Заполнение нормы расхода ресурса
	Если СтруктураОписанияРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы ИЛИ 
		 СтруктураОписанияРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Оборудование Тогда
		ПозицияРесурс.КоличествоРесурса 	= 0;
		ПозицияРесурс.НормаРасходаРесурса 	= СтруктураОписанияРесурса.Норма;
		Если ПозицияРесурс.НормаРасходаРесурса > 0 Тогда
			ПозицияРесурс.КоличествоРесурса = ПозицияРесурс.ОбъемРабот / ПозицияРесурс.НормаРасходаРесурса;
		ИначеЕсли ПозицияРесурс.НормаРасходаРесурса < 0 Тогда	
			ПозицияРесурс.КоличествоРесурса = - ПозицияРесурс.ОбъемРабот / ПозицияРесурс.НормаРасходаРесурса;
		КонецЕсли;
	КонецЕсли;
	// -- AVV
	
	Если СтруктураПараметровЛС = Неопределено Тогда
		СтруктураПараметровЛС = ПолучитьСтруктуруПараметровРасчетаЛС(,ПозицияРесурс);
	КонецЕсли;
	
	ПолучитьПоправкиПоТехЧастям(ПозицияРесурс.РегиональнаяБаза, ПозицияРесурс.ТипНормативныхСборников, ПозицияРесурс.ШифрРасценки, ПозицияРесурс.ПоправкиПозиции,СтруктураПараметровЛС);
	
	Документы.СМ_ПозицияЛокальнойСметы.ОбновитьНРиСП(ПозицияРесурс, СтруктураПараметровЛС);
	
	Документы.СМ_ПозицияЛокальнойСметы.ЗаполнитьНачисленияПозицииПоУмолчанию(ПозицияРесурс);
	ПозицияРесурс.Записать();
	
	Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(ПозицияРесурс, Ложь);
		
	ПозицияРесурс.Записать();

КонецПроцедуры

// Создает неучтенный ресурс за позицией.
//
// Параметры:
//     ПозицияВладелец 			- ДокументОбъект.СМ_ПозицияЛокальнойСметы - документ, которому подчинен неучтенный ресурс.
//     СтруктураОписанияРесурса - Структура - содержит поля, описывающие ресурс
//                                (см. методы ИнициироватьСтруктуруОписанияРесурса() и ПолучитьОписаниеРесурса()).
//     СтруктураПараметровЛС 	- Структура - содержит значения реквизитов локальной сметы.
//
// Возвращаемое значение:
//     СтатусВозврата - Неопределено - если возникла ошибка.
//
Функция СоздатьПозициюНеучтенныйРесурс(ПозицияВладелец, СтруктураОписанияРесурса, СтруктураПараметровЛС = Неопределено) Экспорт
	
	Попытка
		ОбъемРабот = Число(ПозицияВладелец.ОбъемРабот);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	ПозицияЛС 					= СоздатьНовуюПозицию();  // Ресурсы 
	ПозицияЛС.СпособСоздания	= Перечисления.СМ_ИсточникиДобавленияПозиций.Ресурсы;
	ПозицияЛС.ИсточникСоздания	= СтруктураОписанияРесурса.Код;
	ЗаполнитьДанныеДокументаВСтруктуреСмет(ПозицияЛС, ПозицияВладелец.Ссылка, Истина);
	Норма = ?(СтруктураОписанияРесурса.Норма = Неопределено,1,СтруктураОписанияРесурса.Норма);
	Объем = ОбъемРабот * Норма;
	ФормулаОбъема = СокрЛП(Строка(Формат(ОбъемРабот,"ЧГ=0"))) + "*" + СокрЛП(Строка(Формат(Норма,"ЧГ=0")));
	ЗаполнитьДанныеНеучтенногоРесурсаПоСправочнику(ПозицияЛС, ПозицияВладелец, СтруктураОписанияРесурса, Объем, ФормулаОбъема, СтруктураПараметровЛС);
		
КонецФункции

// Инициирует структуру данных для описания неучтенного ресурса и возвращает ее.
//
// Параметры:
//     Позиция - ДокументОбъект.СМ_ПозицияЛокальнойСметы - позиция, которой подчинен ресурс.
//
// Возвращаемое значение:
//     Структура - содержит поля:
//			* Ресурс 			- СправочникСсылка.СМ_Ресурсы - ссылка на ресурс.
//			* РегиональнаяБаза  - СправочникСсылка.СМ_СметноНормативныеБазы - ссылка на региональную базу.
//			* Район             - СправочникСсылка.СМ_ТерриториальныеРайоны - ссылка на район строительства.
//			* ДатаТекущихЦен    - Дата - дата текущих цен.
//			* БазиснаяЦена      - Число - Базисная цена ресурса.
//			* ТекущаяЦена       - Число - Текущая цена ресурса.
//			* БазиснаяЗарплМаш  - Число - Базисная зарплата машинистов.
//			* ТекущаяЗарплМаш   - Число - Базисная зарплата машинистов.
//			* Код               - Строка - Сметный код ресурса.
//			* ВидРесурса        - ПеречислениеСсылка.СМ_ВидыРесурсов - вид ресурса.
//			* ТипМатериала      - ПеречислениеСсылка.СМ_ТипыМатериалов - тип ресурса.
//			* ЕдИзм             - СправочникСсылка.СМ_ЕдиницыИзмерения - ссылка на единицу измерения.
//			* Норма             - Число - норма расхода.
//			* Раздел            - ДокументСсылка.СМ_РазделЛокальнойСметы - ссылка на раздел.
//			* Владелец          - ДокументСсылка.СМ_ПозицияЛокальнойСметы - ссылка на владельца.
//			* ЗагружатьТекущиеЦены - Булево - загружать или нет текущие цены.    
//
Функция ИнициироватьСтруктуруОписанияРесурса(Позиция = Неопределено) Экспорт
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("Ресурс");
	ПараметрыПоиска.Вставить("РегиональнаяБаза", ?(Позиция = Неопределено, Неопределено, Позиция.РегиональнаяБаза));
	ПараметрыПоиска.Вставить("Район");
	ПараметрыПоиска.Вставить("ДатаТекущихЦен");
	ПараметрыПоиска.Вставить("БазиснаяЦена", 0);
	ПараметрыПоиска.Вставить("ТекущаяЦена", 0);
	ПараметрыПоиска.Вставить("БазиснаяЗарплМаш", 0);
	ПараметрыПоиска.Вставить("ТекущаяЗарплМаш", 0);
	ПараметрыПоиска.Вставить("Код", "");
	ПараметрыПоиска.Вставить("ВидРесурса");
	ПараметрыПоиска.Вставить("ТипМатериала");
	ПараметрыПоиска.Вставить("ЕдИзм");
	ПараметрыПоиска.Вставить("Норма");
	ПараметрыПоиска.Вставить("Раздел",?(Позиция = Неопределено, Неопределено, Позиция.ИДРодителя)); 
	ПараметрыПоиска.Вставить("Владелец",?(Позиция = Неопределено, Неопределено, Позиция));
	ПараметрыПоиска.Вставить("ЗагружатьТекущиеЦены", Истина);
	
	Возврат ПараметрыПоиска;
	
КонецФункции

// Возвращает таблицу всех ресурсов для переданных позиций локальной сметы.
//	ВАЖНО. Если нужно получить список всех ресурсов ЛС, то надо сначала обратиться к ПолучитьТаблицуПодчиненных(...).
//	TO DO - перенести в серверный модуль.
//
// Параметры:
//     СписокПозций 	- СписокЗначений - список ссылок на позиции.
//     РесурсОтбор 		- СправочникСсылка.СМ_Ресурсы - ссылка не ресурс (если нужно вытягивать не все).
//     ТолькоУчтенные 	- Булево - если ЛОЖЬ, то будут включены еще и неучтенные ресурсы.
//
// Возвращаемое значение:
//     ТаблицаЗначений - содержит список всей информации о ресурсах позиции.
//
Функция ПолучитьСписокВсехРесурсовПозиций(СписокПозций, РесурсОтбор = Неопределено, ТолькоУчтенные = Истина) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ссылка КАК Позиция,
	               |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.СметныйКодРесурса,
	               |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ресурс,
	               |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.ВидРесурса,
	               |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.ТипМатериала,
	               |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.НормаРасхода,
				   |	(СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.НормаРасхода)*(СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ссылка.ОбъемРабот) КАК РасходПоНорме,
	               |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.КоэффициентКРасходуРесурсов,
	               |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.БазиснаяЦена,
	               |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.БазиснаяЗарплатаМашинистов,
	               |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.ТекущаяЦена,
	               |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.ТекущаяЗарплатаМашинистов,
	               |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Заменен,
	               |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Удален,
	               |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Добавлен,
	               |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.НомерСтроки
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы.РесурсыПозицииЛокальнойСметы КАК СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы
	               |ГДЕ
	               |	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ссылка В(&Ссылка)
	               |	"+?(ТолькоУчтенные, "И СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.ТипМатериала = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыМатериалов.Учтенный)", "")+"
				   |	"+?(РесурсОтбор = Неопределено, "", "И СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ресурс = &Ресурс");
	
	Запрос.УстановитьПараметр("Ссылка", СписокПозций);
	Если РесурсОтбор <> Неопределено Тогда
		Запрос.УстановитьПараметр("Ресурс", РесурсОтбор.Ссылка);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	    	
КонецФункции  

// Заполняет параметры выбранного ресурса для замен,вставок ресурсов в ТЧ РесурсыПозиции.
// Структура может быть инициирована вызовом ИнициироватьСтруктуруОписанияРесурса().
//
// Параметры:
//     СтруктураОписания - Структура - заполняемая структура.
//
Процедура ПолучитьОписаниеРесурса(СтруктураОписания) Экспорт
	
	ТекРесурс = СтруктураОписания.Ресурс;
	Если Не ТекРесурс = Неопределено Тогда
		
		Если ТипЗнч(ТекРесурс) = Тип("СправочникСсылка.СМ_Ресурсы") Тогда
			СтруктураОписания.НаименованиеРесурса = ТекРесурс.ДлинноеНаименование;
			СтруктураОписания.ЕдиницаИзмеренияРесурса = ТекРесурс.ЕдиницаИзмерения;
		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаРесурсов.Ссылка КАК Ресурс,
		|	ТаблицаРесурсов.Код КАК Код,
		|	ТаблицаРесурсов.ЕдиницаИзмерения КАК ЕдИзм,
		|	ТаблицаРесурсов.ВидРесурса КАК ВидРесурса,
		|	ЕСТЬNULL(СметныеЦеныРесурсовСрезПоследних.СметнаяЦена, 0) КАК БазиснаяЦена,
		|	ЕСТЬNULL(ТекЦеныРесурсовСрезПоследних.СметнаяЦена, 0) КАК ТекущаяЦена,
		|	ЕСТЬNULL(СметныеЦеныРесурсовСрезПоследних.ЗарплМашинистов, 0) КАК ЗарплатаМашинистов,
		|	ЕСТЬNULL(ТекЦеныРесурсовСрезПоследних.ЗарплМашинистов, 0) КАК ТекущаяЗарплатаМашинистов
		|ИЗ
		|	Справочник.СМ_Ресурсы КАК ТаблицаРесурсов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СметныеЦеныРесурсов.СрезПоследних(, Ресурс = &РесурсИзДокумента) КАК СметныеЦеныРесурсовСрезПоследних
		|		ПО ТаблицаРесурсов.Ссылка = СметныеЦеныРесурсовСрезПоследних.Ресурс
		|			И (СметныеЦеныРесурсовСрезПоследних.СметноНормативнаяБаза = &СНБ)
		|			И (СметныеЦеныРесурсовСрезПоследних.Район = &Район)
		|			И (СметныеЦеныРесурсовСрезПоследних.ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Базисная))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СметныеЦеныРесурсов.СрезПоследних(&ДатаТекЦен, Ресурс = &РесурсИзДокумента) КАК ТекЦеныРесурсовСрезПоследних
		|		ПО ТаблицаРесурсов.Ссылка = ТекЦеныРесурсовСрезПоследних.Ресурс
		|			И (ТекЦеныРесурсовСрезПоследних.СметноНормативнаяБаза = &СНБ)
		|			И (ТекЦеныРесурсовСрезПоследних.Район = &Район)
		|			И (ТекЦеныРесурсовСрезПоследних.ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Текущая))
		|			И (&ЗагружатьТекущиеЦены = ИСТИНА)
		|ГДЕ
		|	ТаблицаРесурсов.Ссылка = &РесурсИзДокумента
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаРесурсов.Ссылка,
		|	ТаблицаРесурсов.Код,
		|	ТаблицаРесурсов.ЕдиницаИзмерения,
		|	ТаблицаРесурсов.ВидРесурса,
		|	СметныеЦеныРесурсовСрезПоследних.СметнаяЦена,
		|	ТекЦеныРесурсовСрезПоследних.СметнаяЦена,
		|	СметныеЦеныРесурсовСрезПоследних.ЗарплМашинистов,
		|	ТекЦеныРесурсовСрезПоследних.ЗарплМашинистов";
		
		
		Запрос.УстановитьПараметр("РесурсИзДокумента", ТекРесурс);
		Запрос.УстановитьПараметр("СНБ", СтруктураОписания.РегиональнаяБаза);
		Запрос.УстановитьПараметр("Район", СтруктураОписания.Район);
		Запрос.УстановитьПараметр("ДатаТекЦен", СтруктураОписания.ДатаТекущихЦен);
		Запрос.УстановитьПараметр("ЗагружатьТекущиеЦены", СтруктураОписания.ЗагружатьТекущиеЦены);
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();  		
		
		Для каждого СтрокаЗапроса Из РезультатЗапроса Цикл
			СтруктураОписания.Код = СтрокаЗапроса.Код;
			СтруктураОписания.ВидРесурса = СтрокаЗапроса.ВидРесурса;
			СтруктураОписания.БазиснаяЦена = СтрокаЗапроса.БазиснаяЦена;
			СтруктураОписания.БазиснаяЗарплМаш = СтрокаЗапроса.ЗарплатаМашинистов;
			Если СтруктураОписания.ТекущаяЦена = 0 Тогда
				СтруктураОписания.ТекущаяЦена = СтрокаЗапроса.ТекущаяЦена;
			КонецЕсли;
			Если СтруктураОписания.ТекущаяЗарплМаш = 0 Тогда
				СтруктураОписания.ТекущаяЗарплМаш = СтрокаЗапроса.ТекущаяЗарплатаМашинистов;
			КонецЕсли;
			// Ставим по умолчанию наиболее используемый тип.
			СтруктураОписания.ТипМатериала = Перечисления.СМ_ТипыМатериалов.Учтенный;
			СтруктураОписания.ЕдИзм = СтрокаЗапроса.ЕдИзм;
		КонецЦикла;	
	КонецЕсли;

КонецПроцедуры

// Вытаскивает ценовые показатели ресурсов из внутренних справочников.
//
// Параметры:
//     ТекРесурс 			- СправочникСсылка.СМ_Ресурсы 				- ссылка на ресурс.
//     Район 				- СправочникСсылка.СМ_ТерриториальныеРайоны - ссылка на район.
//     РегиональнаяБаза 	- СправочникСсылка.СМ_ТерриториальныеРайоны - ссылка на региональную базу.
//	   ДатаТекущихЦен		- Дата - дата на которую запрашиваются цены из регистра СМ_СметныеЦеныРесурсов.
//     СтруктураЦен 		- Структура - содержит поля:
//								* БазиснаяЦена 					- Базисная цена ресурса.
//								* БазиснаяЗарплатаМашинистов    - Базисная зарплата машинистов.
//								* ТекущаяЦена                   - Текущая цена ресурса.
//								* ТекущаяЗарплатаМашинистов     - Текущая зарплата машинистов.
//     ВыбиратьТекущиеЦены 	- Булево - если Истина, то происходит выбор текущих цен из внутренних справочников.
//
Процедура ПолучитьЦеныНовогоРесурса(ТекРесурс,Район,РегиональнаяБаза,ДатаТекущихЦен,СтруктураЦен,ВыбиратьТекущиеЦены=Ложь) Экспорт
	
	Если ТипЗнч(СтруктураЦен) <> Тип("Структура") Тогда
		СтруктураЦен = Новый Структура();
		СтруктураЦен.Вставить("БазиснаяЦена",0);
		СтруктураЦен.Вставить("БазиснаяЗарплатаМашинистов",0);
		СтруктураЦен.Вставить("ТекущаяЦена",0);
		СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов",0);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаРесурсов.Ссылка КАК Ресурс,
	|	ЕСТЬNULL(СметныеЦеныРесурсовСрезПоследних.СметнаяЦена, 0) КАК БазиснаяЦена,
	|	ЕСТЬNULL(СметныеЦеныРесурсовСрезПоследних.ЗарплМашинистов, 0) КАК ЗарплатаМашинистов";
	
	Если ВыбиратьТекущиеЦены Тогда
		Запрос.Текст = Запрос.Текст + ",	
		|	ЕСТЬNULL(ТекЦеныРесурсовСрезПоследних.СметнаяЦена, 0) КАК ТекущаяЦена,
		|	ЕСТЬNULL(ТекЦеныРесурсовСрезПоследних.ЗарплМашинистов, 0) КАК ТекущаяЗарплатаМашинистов";
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "	
	|ИЗ
	|	Справочник.СМ_Ресурсы КАК ТаблицаРесурсов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СметныеЦеныРесурсов.СрезПоследних(&ДатаТекЦен, Ресурс = &Ресурс) КАК СметныеЦеныРесурсовСрезПоследних
	|		ПО ТаблицаРесурсов.Ссылка = СметныеЦеныРесурсовСрезПоследних.Ресурс
	|			И (СметныеЦеныРесурсовСрезПоследних.Район = &Район)
	|			И (СметныеЦеныРесурсовСрезПоследних.ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Базисная))";
	
	Если ВыбиратьТекущиеЦены Тогда
		Запрос.Текст = Запрос.Текст + "
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СметныеЦеныРесурсов.СрезПоследних(&ДатаТекЦен, Ресурс = &Ресурс) КАК ТекЦеныРесурсовСрезПоследних
		|		ПО ТаблицаРесурсов.Ссылка = ТекЦеныРесурсовСрезПоследних.Ресурс
		|			И (ТекЦеныРесурсовСрезПоследних.СметноНормативнаяБаза = &СНБ)
		|			И (ТекЦеныРесурсовСрезПоследних.Район = &Район)
		|			И (ТекЦеныРесурсовСрезПоследних.ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Текущая))
		|";
	КонецЕсли;
		Запрос.Текст = Запрос.Текст + "
		| ГДЕ  ТаблицаРесурсов.Ссылка = &Ресурс
		|	СГРУППИРОВАТЬ ПО
		|	ТаблицаРесурсов.Ссылка,
		|	ТаблицаРесурсов.Код,
		| 	ТаблицаРесурсов.ЕдиницаИзмерения,
		|	ТаблицаРесурсов.ВидРесурса,
		|	СметныеЦеныРесурсовСрезПоследних.СметнаяЦена,
		|	СметныеЦеныРесурсовСрезПоследних.ЗарплМашинистов
		|	";
		
	Если ВыбиратьТекущиеЦены Тогда
		Запрос.Текст = Запрос.Текст + ",
		|	ТекЦеныРесурсовСрезПоследних.СметнаяЦена,
		|	ТекЦеныРесурсовСрезПоследних.ЗарплМашинистов";
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("Ресурс", ТекРесурс);
	Запрос.УстановитьПараметр("Район", Район);
	Запрос.УстановитьПараметр("ДатаТекЦен", ДатаТекущихЦен);
	Если ВыбиратьТекущиеЦены Тогда
		Запрос.УстановитьПараметр("СНБ", РегиональнаяБаза);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();  		
	Если РезультатЗапроса.Количество() <> 0 Тогда
		СтрЗапроса = РезультатЗапроса[0];
		СтруктураЦен.БазиснаяЦена = СтрЗапроса.БазиснаяЦена;
		СтруктураЦен.БазиснаяЗарплатаМашинистов = СтрЗапроса.ЗарплатаМашинистов;
		Если ВыбиратьТекущиеЦены Тогда
			СтруктураЦен.ТекущаяЦена = СтрЗапроса.ТекущаяЦена;
			СтруктураЦен.ТекущаяЗарплатаМашинистов = СтрЗапроса.ТекущаяЗарплатаМашинистов;
		Иначе
			СтруктураЦен.ТекущаяЦена = 0;
			СтруктураЦен.ТекущаяЗарплатаМашинистов = 0; 			
		КонецЕсли;
	КонецЕсли;	          	

КонецПроцедуры

// Возвращает таблицу с ресурсами и их ценами по данным внутренних справочников.
//	TO DO - перенести в серверный модуль.
//
// Параметры:
//     ТаблицаРесурсов 			- Массив - массив строк таблицы с колонками "Позиция" и "Ресурс".
//     ИспользоватьТекущиеЦены 	- Булево - выводить в результирующую таблицу сведения о текущих ценах ресурсов.
//     ДатаТекущихЦен 			- Дата - дата для отбора текущих цен ресурсов.
//     Район 					- СправочникСсыка.СМ_ТерриториальныеРайоны	- ссылка на территориальный район для текущих цен.
//     ОтборРесурс 				- СправочникСсыка.СМ_Ресурсы - ссылка на ресурс для отбора (если необходимо).
//	   СНБ						- СправочникСсылка.СМ_СметноНормативныеБазы	- ссылка на элемент справочника.
//
// Возвращаемое значение:
//     ТаблицаЗначений - содержит цены ресурсов.
//
Функция ПолучитьТаблицуЦенРесурсов(ТаблицаРесурсов, ИспользоватьТекущиеЦены, ДатаТекущихЦен, Район, ОтборРесурс = Неопределено,СНБ = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РесурсыПозицииЛС.Ресурс КАК Ресурс,
	|	РесурсыПозицииЛС.Позиция КАК Позиция
	|ПОМЕСТИТЬ РесурсыПозицииЛокальнойСметы1
	|ИЗ
	|	&РесурсыПозицииЛС КАК РесурсыПозицииЛС
	|";
	Если ОтборРесурс <> Неопределено Тогда 
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|	РесурсыПозицииЛС.Ресурс = &Ресурс      ";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + "
	|ИНДЕКСИРОВАТЬ ПО
	|	Ресурс,
	|	Позиция
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РесурсыПозицииЛокальнойСметыВр.Ресурс,
	|	РесурсыПозицииЛокальнойСметыВр.Позиция,
	|	ПозицияЛокальнойСметыДок.РегиональнаяБаза
	|ПОМЕСТИТЬ РесурсыПозицииБаза
	|ИЗ
	|	РесурсыПозицииЛокальнойСметы1 КАК РесурсыПозицииЛокальнойСметыВр
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметыДок
	|		ПО РесурсыПозицииЛокальнойСметыВр.Позиция = ПозицияЛокальнойСметыДок.Ссылка
	|ИНДЕКСИРОВАТЬ ПО
	|	Ресурс,
	|	Позиция,
	|	РегиональнаяБаза
	|;            
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РесурсыПозицииБаза.Ресурс,
	|	РесурсыПозицииБаза.РегиональнаяБаза
	|ПОМЕСТИТЬ РесурсыПозицииБазаГр
	|ИЗ
	|	РесурсыПозицииБаза КАК РесурсыПозицииБаза
	|
	|СГРУППИРОВАТЬ ПО
	|	Ресурс,
	|	РегиональнаяБаза
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ресурс,
	|	РегиональнаяБаза
	|;            
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_СметныеЦеныРесурсовСрезПоследних.Ресурс КАК РесурсРег,
	|	СМ_СметныеЦеныРесурсовСрезПоследних.СметноНормативнаяБаза КАК СметноНормативнаяБаза,
	|	СМ_СметныеЦеныРесурсовСрезПоследних.СметнаяЦена КАК СметнаяЦена,
	|	СМ_СметныеЦеныРесурсовСрезПоследних.ЗарплМашинистов КАК ЗарплМашинистов,
	|	0 КАК ТекСметнаяЦена,
	|	0 КАК ТекЗарплМашинистов
	|ПОМЕСТИТЬ ЦеныРесурсовНеГр
	|ИЗ
	|	РегистрСведений.СМ_СметныеЦеныРесурсов.СрезПоследних(
	|			,
	|			Район = &Район
	|				И ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Базисная)) КАК СМ_СметныеЦеныРесурсовСрезПоследних
	|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РесурсыПозицииБазаГр КАК РесурсыПозицииЛС
	|						ПО (РесурсыПозицииЛС.Ресурс = СМ_СметныеЦеныРесурсовСрезПоследних.Ресурс)
	|					    И  (РесурсыПозицииЛС.РегиональнаяБаза = СМ_СметныеЦеныРесурсовСрезПоследних.СметноНормативнаяБаза)
	|    ";	
	Если ИспользоватьТекущиеЦены Тогда
		Запрос.Текст = Запрос.Текст + "
		|ОБЪЕДИНИТЬ ВСЕ
		|   
		|ВЫБРАТЬ
		|	СМ_СметныеЦеныРесурсовСрезПоследних1.Ресурс КАК РесурсРег,
		|	СМ_СметныеЦеныРесурсовСрезПоследних1.СметноНормативнаяБаза КАК СметноНормативнаяБаза,
		|	0 КАК СметнаяЦена,
		|	0 КАК ЗарплМашинистов,
		|	СМ_СметныеЦеныРесурсовСрезПоследних1.СметнаяЦена КАК ТекСметнаяЦена,
		|	СМ_СметныеЦеныРесурсовСрезПоследних1.ЗарплМашинистов КАК ТекЗарплМашинистов
		|ИЗ
		|	РегистрСведений.СМ_СметныеЦеныРесурсов.СрезПоследних(
		|			&ДатаТекЦен,
		|           
		|			Район = &Район"+?(СНБ = Неопределено,""," И СметноНормативнаяБаза = &СНБ ")+ "
		|				И ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Текущая)) КАК СМ_СметныеЦеныРесурсовСрезПоследних1
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РесурсыПозицииБазаГр КАК РесурсыПозицииЛС
		|						ПО (РесурсыПозицииЛС.Ресурс = СМ_СметныеЦеныРесурсовСрезПоследних1.Ресурс)
		|					    И  (РесурсыПозицииЛС.РегиональнаяБаза = СМ_СметныеЦеныРесурсовСрезПоследних1.СметноНормативнаяБаза)
		|
		|";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + " 
	|ИНДЕКСИРОВАТЬ ПО
	|	РесурсРег,
	|	СметноНормативнаяБаза
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЦеныРесурсовНеГр.РесурсРег КАК РесурсРег,
	|	ЦеныРесурсовНеГр.СметноНормативнаяБаза КАК СметноНормативнаяБаза,
	|	СУММА(ЦеныРесурсовНеГр.СметнаяЦена) КАК СметнаяЦена,
	|	СУММА(ЦеныРесурсовНеГр.ЗарплМашинистов) КАК ЗарплМашинистов,
	|	СУММА(ЦеныРесурсовНеГр.ТекСметнаяЦена) КАК ТекСметнаяЦена,
	|	СУММА(ЦеныРесурсовНеГр.ТекЗарплМашинистов) КАК ТекЗарплМашинистов
	|ПОМЕСТИТЬ ЦеныРесурсов
	|ИЗ
	|	ЦеныРесурсовНеГр КАК ЦеныРесурсовНеГр
	|
	|СГРУППИРОВАТЬ ПО
	|	РесурсРег,
	|	СметноНормативнаяБаза
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	РесурсРег,
	|	СметноНормативнаяБаза
	|;      
	|	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РесурсыПозицииЛокальнойСметы.Ресурс КАК Ресурс,
	|	РесурсыПозицииЛокальнойСметы.Позиция КАК Позиция,
	|	ЕСТЬNULL(СметныеЦеныРесурсовСрезПоследних.СметнаяЦена, 0) КАК БазиснаяЦена,
	|	ЕСТЬNULL(СметныеЦеныРесурсовСрезПоследних.ТекСметнаяЦена, 0) КАК ТекущаяЦена,
	|	ЕСТЬNULL(СметныеЦеныРесурсовСрезПоследних.ЗарплМашинистов, 0) КАК БазиснаяЗарплатаМашинистов,
	|	ЕСТЬNULL(СметныеЦеныРесурсовСрезПоследних.ТекЗарплМашинистов, 0) КАК ТекущаяЗарплатаМашинистов
	|ИЗ
	|	РесурсыПозицииБаза КАК РесурсыПозицииЛокальнойСметы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЦеныРесурсов КАК СметныеЦеныРесурсовСрезПоследних
	|		ПО (РесурсыПозицииЛокальнойСметы.Ресурс = СметныеЦеныРесурсовСрезПоследних.РесурсРег)
	|			И (СметныеЦеныРесурсовСрезПоследних.СметноНормативнаяБаза = РесурсыПозицииЛокальнойСметы.РегиональнаяБаза)   ";
	Если ИспользоватьТекущиеЦены Тогда
		Запрос.УстановитьПараметр("ДатаТекЦен", ДатаТекущихЦен);
		Запрос.УстановитьПараметр("СНБ", СНБ);
	КонецЕсли;
	
	Если ОтборРесурс <> Неопределено Тогда
		Запрос.УстановитьПараметр("Ресурс", ОтборРесурс);	
	КонецЕсли;
	Запрос.УстановитьПараметр("Район", Район);
	ТаблицаРесурсовПараметр = ТаблицаРесурсов.Скопировать();
	ТаблицаРесурсовПараметр.Свернуть("Ресурс, Позиция");
	Запрос.УстановитьПараметр("РесурсыПозицииЛС", ТаблицаРесурсовПараметр);
	
	Возврат Запрос.Выполнить().Выгрузить();  		
	
КонецФункции

// Обновляет цены ресурсов позиции.
//
// Параметры:
//	   Позиция 			- Позиция - ДокументОбъект.СМ_ПозицияЛокальнойСметы - позиция, которой подчинен ресурс.
//	   Район            - СправочникСсыка.СМ_ТерриториальныеРайоны	- ссылка на территориальный район для текущих цен.
//	   СНБ				- СправочникСсылка.СМ_СметноНормативныеБазы	- ссылка на элемент справочника.
//	   ОбновлятьТекущие - Булево - признак обновления текущих цен и текущей ЗПМ.
//
Процедура ОбновитьЦены(Позиция,Район,СНБ = Неопределено,ОбновлятьТекущие = Ложь) Экспорт 
	ТаблицаРесурсовПозиций = ПолучитьСписокВсехРесурсовПозиций(Позиция,,Истина); 
	ТаблицаЦен = ПолучитьТаблицуЦенРесурсов(ТаблицаРесурсовПозиций,ОбновлятьТекущие,ТекущаяДатаСеанса(),Район,,?(ЗначениеЗаполнено(СНБ),СНБ,Неопределено));
	ПозицияОб = Позиция.ПолучитьОбъект();
	
	Для Каждого Рес Из ПозицияОб.РесурсыПозицииЛокальнойСметы Цикл
		ОтборЦен = Новый Структура();
		ОтборЦен.Вставить("Ресурс", Рес.Ресурс);
		МассивЦен = ТаблицаЦен.НайтиСтроки(ОтборЦен);
		Если МассивЦен.Количество() > 0 Тогда
			Рес.БазиснаяЦена      = ?(МассивЦен[0].БазиснаяЦена = 0,Рес.БазиснаяЦена,МассивЦен[0].БазиснаяЦена);
			Рес.БазиснаяЗарплатаМашинистов = ?(МассивЦен[0].БазиснаяЗарплатаМашинистов = 0,Рес.БазиснаяЗарплатаМашинистов,МассивЦен[0].БазиснаяЗарплатаМашинистов);
			Если ОбновлятьТекущие Тогда
				Рес.ТекущаяЦена      = ?(МассивЦен[0].ТекущаяЦена = 0,Рес.ТекущаяЦена,МассивЦен[0].ТекущаяЦена);
				Рес.ТекущаяЗарплатаМашинистов = ?(МассивЦен[0].ТекущаяЗарплатаМашинистов = 0,Рес.ТекущаяЗарплатаМашинистов,МассивЦен[0].ТекущаяЗарплатаМашинистов);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ПозицияОб.Записать();
КонецПроцедуры

// Обновляет цены позиции.
//
// Параметры:
//	   Позиция 			- Позиция - ДокументОбъект.СМ_ПозицияЛокальнойСметы - позиция для которой обновляются цены.
//	   Район            - СправочникСсыка.СМ_ТерриториальныеРайоны	- ссылка на территориальный район для текущих цен.
//     ДатаЦен 			- Дата - дата для отбора цен ресурсов.
//
Процедура ЗагрузитьБазисныеЦеныВПозицию(Позиция,Район,ДатаЦен = Неопределено) Экспорт
	
	ТекРесурс = НайтиРесурсПоКоду(ЗаполнитьСтруктуруПоискаРесурсаПоПозиции(Позиция));
	Если ТекРесурс <> Неопределено Тогда
		Если ДатаЦен = Неопределено Тогда
			ДатаЦен = ТекущаяДатаСеанса();
		КонецЕсли;
		СтруктураЦен = Неопределено;
		ПолучитьЦеныНовогоРесурса(ТекРесурс,Район,Неопределено,ДатаЦен,СтруктураЦен);
		ЗагрузитьЦеныВПозицию(Позиция,СтруктураЦен);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьЦеныВПозицию(Позиция,СтруктураЦен)
	ПозицияОб = Позиция.ПолучитьОбъект();
	Обработали = Ложь;
	// Можно в дальнейшем анализировать базу для базисных цен и базу объекта.
	Если ПозицияОб.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы Тогда
		Если  ПозицияОб.СтоимМатериалов = 0 Тогда
			Обработали = Истина;
			ПозицияОб.СтоимМатериалов = СтруктураЦен.БазиснаяЦена;
			ПозицияОб.ПрямЗатраты = СтруктураЦен.БазиснаяЦена;
		КонецЕсли;
	ИначеЕсли ПозицияОб.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин Тогда
		Если ПозицияОб.ЭксплМашин = 0 Тогда
			Обработали = Истина;
			ПозицияОб.ПрямЗатраты = СтруктураЦен.БазиснаяЦена;
			ПозицияОб.ЭксплМашин = СтруктураЦен.БазиснаяЦена;
			ПозицияОб.ЗарплМашинистов = СтруктураЦен.БазиснаяЗарплатаМашинистов
		КонецЕсли;
	КонецЕсли;
	// ПозицияОб.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
	// ПозицияОб.ТекущаяЗарплатаМашинистов = СтруктураЦен.ТекущаяЗарплатаМашинистов;
	Если Обработали Тогда
		ПозицияОб.Записать();
		Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(ПозицияОб, Ложь);
	КонецЕсли;

КонецПроцедуры

// Возвращает таблицу с ценами ресурса для всех регионов, используемых в смете.
//	TO DO - перенести в серверный модуль.
//
// Параметры:
//     Ресурс	 				- СправочникСсыка.СМ_Ресурсы - ссылка на ресурс для отбора.
//     СписокПозиций 			- СписокЗначений - список позиций для отбора региональных баз.
//     ИспользоватьТекущиеЦены 	- Булево - выводить в результирующую таблицу сведения о текущих ценах ресурсов.
//     ДатаТекущихЦен 			- Дата - дата для отбора текущиъ цен ресурсов.
//     Район					- СправочникСсыка.СМ_ТерриториальныеРайоны - ссылка на территориальный район для текущих цен.
//
// Возвращаемое значение:
//     ТаблицаЗначений - содержит цены ресурсов по заданным регионам.
//
Функция ПолучитьТаблицуВсехЦенРесурса(Ресурс, СписокПозиций, ИспользоватьТекущиеЦены, ДатаТекущихЦен, Район) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
					|	СМ_ПозицияЛокальнойСметы.РегиональнаяБаза,
					|	&Ресурс КАК Ресурс
					|ПОМЕСТИТЬ РесурсыПозицииБаза
					|ИЗ
					|	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
					|ГДЕ
					|	СМ_ПозицияЛокальнойСметы.Ссылка В(&Ссылка)
					|
					|СГРУППИРОВАТЬ ПО
					|	СМ_ПозицияЛокальнойСметы.РегиональнаяБаза
					|;
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	СМ_СметныеЦеныРесурсовСрезПоследних.Ресурс КАК РесурсРег,
					|	СМ_СметныеЦеныРесурсовСрезПоследних.СметноНормативнаяБаза КАК СметноНормативнаяБаза,
					|	СМ_СметныеЦеныРесурсовСрезПоследних.СметнаяЦена КАК СметнаяЦена,
					|	СМ_СметныеЦеныРесурсовСрезПоследних.ЗарплМашинистов КАК ЗарплМашинистов,
					|	0 КАК ТекСметнаяЦена,
					|	0 КАК ТекЗарплМашинистов
					|ПОМЕСТИТЬ ЦеныРесурсовНеГр
					|ИЗ
					|	РегистрСведений.СМ_СметныеЦеныРесурсов.СрезПоследних(
					|			,
					|			Район = &Район
					|				И ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Базисная)) КАК СМ_СметныеЦеныРесурсовСрезПоследних
					|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РесурсыПозицииБаза КАК РесурсыПозицииЛС
					|						ПО (РесурсыПозицииЛС.Ресурс = СМ_СметныеЦеныРесурсовСрезПоследних.Ресурс)
					|					    И  (РесурсыПозицииЛС.РегиональнаяБаза = СМ_СметныеЦеныРесурсовСрезПоследних.СметноНормативнаяБаза)
					|    ";	
					Если ИспользоватьТекущиеЦены Тогда
						Запрос.Текст = Запрос.Текст + "
						|ОБЪЕДИНИТЬ ВСЕ
						|   
						|ВЫБРАТЬ
						|	СМ_СметныеЦеныРесурсовСрезПоследних1.Ресурс КАК РесурсРег,
						|	СМ_СметныеЦеныРесурсовСрезПоследних1.СметноНормативнаяБаза КАК СметноНормативнаяБаза,
						|	0 КАК СметнаяЦена,
						|	0 КАК ЗарплМашинистов,
						|	СМ_СметныеЦеныРесурсовСрезПоследних1.СметнаяЦена КАК ТекСметнаяЦена,
						|	СМ_СметныеЦеныРесурсовСрезПоследних1.ЗарплМашинистов КАК ТекЗарплМашинистов
						|ИЗ
						|	РегистрСведений.СМ_СметныеЦеныРесурсов.СрезПоследних(
						|			&ДатаТекЦен,
						|			Район = &Район
						|				И ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Текущая)) КАК СМ_СметныеЦеныРесурсовСрезПоследних1
						|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РесурсыПозицииБаза КАК РесурсыПозицииЛС
						|						ПО (РесурсыПозицииЛС.Ресурс = СМ_СметныеЦеныРесурсовСрезПоследних1.Ресурс)
						|					    И  (РесурсыПозицииЛС.РегиональнаяБаза = СМ_СметныеЦеныРесурсовСрезПоследних1.СметноНормативнаяБаза)
						|
						|";
						Запрос.УстановитьПараметр("ДатаТекЦен", ДатаТекущихЦен);
					КонецЕсли;
					Запрос.Текст = Запрос.Текст + " 
					|ИНДЕКСИРОВАТЬ ПО
					|	РесурсРег,
					|	СметноНормативнаяБаза
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ЦеныРесурсовНеГр.РесурсРег КАК РесурсРег,
					|	ЦеныРесурсовНеГр.СметноНормативнаяБаза КАК СметноНормативнаяБаза,
					|	СУММА(ЦеныРесурсовНеГр.СметнаяЦена) КАК СметнаяЦена,
					|	СУММА(ЦеныРесурсовНеГр.ЗарплМашинистов) КАК ЗарплМашинистов,
					|	СУММА(ЦеныРесурсовНеГр.ТекСметнаяЦена) КАК ТекСметнаяЦена,
					|	СУММА(ЦеныРесурсовНеГр.ТекЗарплМашинистов) КАК ТекЗарплМашинистов
					|ПОМЕСТИТЬ ЦеныРесурсов
					|ИЗ
					|	ЦеныРесурсовНеГр КАК ЦеныРесурсовНеГр
					|
					|СГРУППИРОВАТЬ ПО
					|	РесурсРег,
					|	СметноНормативнаяБаза
					|
					|ИНДЕКСИРОВАТЬ ПО
					|	РесурсРег,
					|	СметноНормативнаяБаза
					|;      
					|	
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	РесурсыПозицииЛокальнойСметы.Ресурс КАК Ресурс,
					|	РесурсыПозицииЛокальнойСметы.РегиональнаяБаза КАК РегиональнаяБаза,
					|	ЕСТЬNULL(СметныеЦеныРесурсовСрезПоследних.СметнаяЦена, 0) КАК БазиснаяЦена,
					|	ЕСТЬNULL(СметныеЦеныРесурсовСрезПоследних.ТекСметнаяЦена, 0) КАК ТекущаяЦена,
					|	ЕСТЬNULL(СметныеЦеныРесурсовСрезПоследних.ЗарплМашинистов, 0) КАК БазиснаяЗарплатаМашинистов,
					|	ЕСТЬNULL(СметныеЦеныРесурсовСрезПоследних.ТекЗарплМашинистов, 0) КАК ТекущаяЗарплатаМашинистов
					|ИЗ
					|	РесурсыПозицииБаза КАК РесурсыПозицииЛокальнойСметы
					|		ЛЕВОЕ СОЕДИНЕНИЕ ЦеныРесурсов КАК СметныеЦеныРесурсовСрезПоследних
					|		ПО (РесурсыПозицииЛокальнойСметы.Ресурс = СметныеЦеныРесурсовСрезПоследних.РесурсРег)
					|			И (СметныеЦеныРесурсовСрезПоследних.СметноНормативнаяБаза = РесурсыПозицииЛокальнойСметы.РегиональнаяБаза)   ";
		
	Запрос.УстановитьПараметр("Ссылка", СписокПозиций);
	Запрос.УстановитьПараметр("Ресурс", Ресурс);
	Запрос.УстановитьПараметр("Район", Район);
	
	Возврат Запрос.Выполнить().Выгрузить();  		
	
КонецФункции

// Возвращает таблицу с ценами ресурсов для всех районов, используемых в смете.
//
// Параметры:
//     СписокРесурсов	 		- Массив - содержит ссылки на ресурсы для отбора.
//	   СписокСНБ			    - Массив - содержит ссылка на сметно-нормативные базы для отбора.
//     ИспользоватьТекущиеЦены 	- Булево - выводить в результирующую таблицу сведения о текущих ценах ресурсов.
//     ДатаТекущихЦен 			- Дата - дата для отбора текущиъ цен ресурсов.
//     Район					- СправочникСсыка.СМ_ТерриториальныеРайоны - ссылка на территориальный район для текущих цен.
//
// Возвращаемое значение:
//     ТаблицаЗначений - содержит цены ресурсов по заданным районам.
//
Функция ПолучитьТаблицуВсехЦенРесурсов(СписокРесурсов, СписокСНБ, ИспользоватьТекущиеЦены, ДатаТекущихЦен, Район) Экспорт

	Запрос = Новый Запрос;
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	БазисныеЦеныРесурсов.Ресурс КАК РесурсРег,
	|	БазисныеЦеныРесурсов.СметноНормативнаяБаза КАК СметноНормативнаяБаза,
	|	БазисныеЦеныРесурсов.СметнаяЦена КАК СметнаяЦена,
	|	БазисныеЦеныРесурсов.ЗарплМашинистов КАК ЗарплМашинистов,
	|	0 КАК ТекСметнаяЦена,
	|	0 КАК ТекЗарплМашинистов
	|ПОМЕСТИТЬ ЦеныРесурсовНеГр
	|ИЗ
	|	РегистрСведений.СМ_СметныеЦеныРесурсов.СрезПоследних(,
	|		Ресурс В (&СписокРесурсов) И 
	|		СметноНормативнаяБаза В (&СписокСНБ) И 
	|		Район = &Район И 
	|		ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Базисная)) КАК БазисныеЦеныРесурсов";
	
	Если ИспользоватьТекущиеЦены Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	
		|ОБЪЕДИНИТЬ ВСЕ
		|   
		|ВЫБРАТЬ
		|	ТекушиеЦеныРесурсов.Ресурс КАК РесурсРег,
		|	ТекушиеЦеныРесурсов.СметноНормативнаяБаза КАК СметноНормативнаяБаза,
		|	0 КАК СметнаяЦена,
		|	0 КАК ЗарплМашинистов,
		|	ТекушиеЦеныРесурсов.СметнаяЦена КАК ТекСметнаяЦена,
		|	ТекушиеЦеныРесурсов.ЗарплМашинистов КАК ТекЗарплМашинистов
		|ИЗ
		|	РегистрСведений.СМ_СметныеЦеныРесурсов.СрезПоследних(
		|		&ДатаТекЦен,
		|		Ресурс В (&СписокРесурсов) И 
		|		СметноНормативнаяБаза В (&СписокСНБ) И
		|		Район = &Район И
		|		ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Текущая)) КАК ТекушиеЦеныРесурсов";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	РесурсРег,
	|	СметноНормативнаяБаза
	|;
	|	
	|//////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЦеныРесурсовНеГр.РесурсРег КАК Ресурс,
	|	ЦеныРесурсовНеГр.СметноНормативнаяБаза КАК РегиональнаяБаза,
	|	СУММА(ЦеныРесурсовНеГр.СметнаяЦена) КАК БазиснаяЦена,
	|	СУММА(ЦеныРесурсовНеГр.ЗарплМашинистов) КАК БазиснаяЗарплатаМашинистов,
	|	СУММА(ЦеныРесурсовНеГр.ТекСметнаяЦена) КАК ТекущаяЦена,
	|	СУММА(ЦеныРесурсовНеГр.ТекЗарплМашинистов) КАК ТекущаяЗарплатаМашинистов
	|ИЗ
	|	ЦеныРесурсовНеГр КАК ЦеныРесурсовНеГр
	|	
	|СГРУППИРОВАТЬ ПО
	|	ЦеныРесурсовНеГр.РесурсРег,
	|	ЦеныРесурсовНеГр.СметноНормативнаяБаза
	|";      
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаТекЦен", ДатаТекущихЦен);
	Запрос.УстановитьПараметр("СписокРесурсов", СписокРесурсов);
	Запрос.УстановитьПараметр("СписокСНБ", СписокСНБ);
	Запрос.УстановитьПараметр("Район", Район);
	
	ТабРезультат = Запрос.Выполнить().Выгрузить(); 
	
	Возврат ТабРезультат; 
	
КонецФункции	

// Заменяет ресурсы у всех позиций сметы.
// ВАЖНО, если передан Отбор по позициям - то обрабатываются только переданные позиции.
// (без контроля принадлежности смете).
//
// Параметры:
//     Структура - Структура - содержит поля:
//			* ЗаменяемыйРесурс 	- СправочникСсыка.СМ_Ресурсы - заменяемый ресурс.
//			* Ресурс			- СправочникСсыка.СМ_Ресурсы - новый ресурс.
//			* РасходПоНорме 	- Число	- норма расхода.    
//     Смета 				- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету.  
//     ОтборПоПозициям 		- Массив - массив позиций (если нужно проводить замену не по всем позициям).
//     РайонЦен 			- СправочникСсыка.СМ_ТерриториальныеРайоны	- берется данный район, если смета не передана.
//
// Возвращаемое значение:
//     Модифицировано - Булево - произошла ли замена.
//
Функция ЗаменитьРесурсВТЧРесурсыСметы(Структура, Смета = Неопределено, ОтборПоПозициям = Неопределено, РайонЦен = Неопределено) Экспорт
	
	ОтборПоПозициямСЗ = Новый СписокЗначений();
	Если ОтборПоПозициям = Неопределено Тогда
		// Целиком по смете.
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ПолучитьТаблицуПодчиненных(Смета, Ложь, Истина, Ложь, Истина).ВыгрузитьКолонку("Ид")); 	
	Иначе
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ОтборПоПозициям);
	КонецЕсли;
	
	// Не учтенные - не меняем.
	ТаблицаРесурсовПозиций = ПолучитьСписокВсехРесурсовПозиций(ОтборПоПозициямСЗ, Структура.ЗаменяемыйРесурс, Истина); 
	
	РасходПоНормеНовый = Структура.РасходПоНорме;
	РасходПоНормеСтарый = Структура.РасходПоНормеСтарый;
	Если РасходПоНормеСтарый <> 0 Тогда
		КоэффициентКНорме = Структура.РасходПоНорме/РасходПоНормеСтарый;
	Иначе
		КоэффициентКНорме = 1;
	КонецЕсли;			
	
	Модифицировано = Ложь;
	
	Если ТаблицаРесурсовПозиций.Количество() > 0 Тогда
		
		// Получим цены.		
		ТаблицаЦен = ПолучитьТаблицуЦенРесурсов(ТаблицаРесурсовПозиций, 
			?(Смета = Неопределено, ЛОЖЬ, Смета.АвтозагрузкаЦен),  
			?(Смета = Неопределено, ТекущаяДатаСеанса(), Смета.ДатаТекущихЦен), 
			?(Смета = Неопределено, РайонЦен, Смета.Район), 
			Структура.ЗаменяемыйРесурс);
			
		// Получим таблицу (вдруг были замены ранее).
		СписокРесурсов 	= Новый СписокЗначений();
		СписокРесурсов.ЗагрузитьЗначения(ТаблицаРесурсовПозиций.ВыгрузитьКолонку("Ресурс"));

		ТаблицаПредыдущихЗамен = ПолучитьЗамененныеРесурсы(СписокРесурсов, , ОтборПоПозициямСЗ); 
		
		Для Каждого ТекСтрока Из ТаблицаРесурсовПозиций Цикл
			
			Если ТипЗнч(ТекСтрока.Позиция) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				Продолжить;
			КонецЕсли;
			
			ПозицияОбъект = ТекСтрока.Позиция.ПолучитьОбъект();
			
			СметаСсылка = ?(Смета = Неопределено, ТекСтрока.Позиция.ИдСметы, ПолучитьСсылкуНаДокумент(Смета));
			
			ОтборЦен = Новый Структура();
			ОтборЦен.Вставить("Ресурс", Структура.ЗаменяемыйРесурс);
			МассивЦен = ТаблицаЦен.НайтиСтроки(ОтборЦен);
			
			ОтборТЧ = Новый Структура();
			ОтборТЧ.Вставить("Ресурс", Структура.ЗаменяемыйРесурс);
			
			ОтборПредыдущихЗамен = Новый Структура();
			ОтборПредыдущихЗамен.Вставить("НовыйРесурс", Структура.ЗаменяемыйРесурс);
			ОтборПредыдущихЗамен.Вставить("Позиция", ТекСтрока.Позиция);
			ОтборПредыдущихЗамен.Вставить("Смета", СметаСсылка);
			
			МассивЗамен = ТаблицаПредыдущихЗамен.НайтиСтроки(ОтборПредыдущихЗамен);
				
			Если МассивЗамен.Количество() > 0 Тогда
				
				ОтборПредыдущихЗамен = Новый Структура();
				ОтборПредыдущихЗамен.Вставить("ЗамененныйРесурс", МассивЗамен[0].ЗамененныйРесурс);
				ОтборПредыдущихЗамен.Вставить("Позиция", ТекСтрока.Позиция);
				ОтборПредыдущихЗамен.Вставить("Смета", СметаСсылка);
			
				ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ЗаменаМатериаловПозиции", ОтборПредыдущихЗамен, Новый ТаблицаЗначений);
				
			КонецЕсли;
			
			ТекСтрокиОбъекта = ПозицияОбъект.РесурсыПозицииЛокальнойСметы.НайтиСтроки(ОтборТЧ);
			
			Для Каждого СтрокаОбъекта Из ТекСтрокиОбъекта Цикл
			
				СтрокаОбъекта.Ресурс 			= Структура.Ресурс;		
				СтрокаОбъекта.СметныйКодРесурса = ?(ТипЗнч(Структура.Ресурс) = Тип("Строка"),Структура.КодРесурса,Структура.Ресурс.Код);
				СтрокаОбъекта.ВидРесурса        = ?(ТипЗнч(Структура.Ресурс) = Тип("Строка"),СтрокаОбъекта.ВидРесурса,Структура.Ресурс.ВидРесурса);
				СтрокаОбъекта.БазиснаяЦена      = Структура.БазисЦена;
				СтрокаОбъекта.БазиснаяЗарплатаМашинистов = Структура.БазисЗарплМаш;
				СтрокаОбъекта.ТекущаяЦена      = Структура.ТекЦена;
				СтрокаОбъекта.ТекущаяЗарплатаМашинистов = Структура.ТекЗарплМаш;
				СтрокаОбъекта.НаименованиеРесурса = ?(ТипЗнч(Структура.Ресурс) = Тип("Строка"),Структура.Ресурс,Структура.Ресурс.ДлинноеНаименование);
				СтрокаОбъекта.ЕдиницаИзмеренияРесурса = ?(ТипЗнч(Структура.Ресурс) = Тип("Строка"),Структура.ЕдиницаИзмеренияРесурса,Структура.Ресурс.ЕдиницаИзмерения);
				
				СтрокаОбъекта.Заменен			= Истина;
				
			
				// Формирование структуры замены ресурсов.
				СтруктураЗамены = Новый Структура;
				СтруктураЗамены.Вставить("НовыйРесурс",Структура.Ресурс);
				СтруктураЗамены.Вставить("СтарыйРесурс",Структура.ЗаменяемыйРесурс);
				СтруктураЗамены.Вставить("НормаРасходаСтарогоМатериала",СтрокаОбъекта.НормаРасхода);
		 		Если МассивЦен.Количество() Тогда
					СтруктураЗамены.Вставить("БазиснаяЦенаСтарогоМатериала",МассивЦен[0].БазиснаяЦена);
					СтруктураЗамены.Вставить("ТекущаяЦенаСтарогоМатериала",МассивЦен[0].ТекущаяЦена);
					СтруктураЗамены.Вставить("БазисЗарплМашСтарРесурс",МассивЦен[0].БазиснаяЗарплатаМашинистов);
					СтруктураЗамены.Вставить("ТекЗарплМашСтарРесурс",МассивЦен[0].ТекущаяЗарплатаМашинистов);
				Иначе
					СтруктураЗамены.Вставить("БазиснаяЦенаСтарогоМатериала",0);
					СтруктураЗамены.Вставить("ТекущаяЦенаСтарогоМатериала",0);
					СтруктураЗамены.Вставить("БазисЗарплМашСтарРесурс",0);
					СтруктураЗамены.Вставить("ТекЗарплМашСтарРесурс",0);
				КонецЕсли;
				Если КоэффициентКНорме <> 0 Тогда
					СтрокаОбъекта.НормаРасхода	= ТекСтрока.НормаРасхода * КоэффициентКНорме;
				Иначе
					СтрокаОбъекта.НормаРасхода	= ТекСтрока.НормаРасхода;
				КонецЕсли;
				Документы.СМ_ПозицияЛокальнойСметы.ДобавитьДвиженияВРегЗамен(СтруктураЗамены,ТекСтрока.Позиция,СметаСсылка);
				
			КонецЦикла;
			
			ПозицияОбъект.Записать();
			
		КонецЦикла;
		Модифицировано = Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;    
	
	Возврат Модифицировано;
	
КонецФункции

// Удаляет ресурс у всех позиций сметы.
// ВАЖНО, если передан Отбор по позициям - то обрабатываются только переданные позиции
// (без контроля принадлежности смете).
//
// Параметры:
//     Структура 		- Структура - содержит поле Ресурс.    
//     Смета 			- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету.  
//     ОтборПоПозициям 	- Массив - массив позиций (если нужно проводить замену не по всем позициям).
//
// Возвращаемое значение:
//     Модифицировано - Булево - произошло ли удаление.
//
Функция УдалитьРесурсВТЧРесурсыСметы(Структура, Смета = Неопределено, ОтборПоПозициям = Неопределено) Экспорт
	
	ОтборПоПозициямСЗ = Новый СписокЗначений();
	Если ОтборПоПозициям = Неопределено Тогда
		// Целиком по смете.
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ПолучитьТаблицуПодчиненных(Смета, Ложь, Истина, Ложь, Истина).ВыгрузитьКолонку("Ид")); 	
	Иначе
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ОтборПоПозициям);
	КонецЕсли;
	
	ТаблицаРесурсовПозиций = ПолучитьСписокВсехРесурсовПозиций(ОтборПоПозициямСЗ, Структура.Ресурс, Истина); //не учтенные - не меняем
	
	Модифицировано = Ложь;
	
	Если ТаблицаРесурсовПозиций.Количество() > 0 Тогда
				
		Для Каждого ТекСтрока Из ТаблицаРесурсовПозиций Цикл
			
			Если ТипЗнч(ТекСтрока.Позиция) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				Продолжить;
			КонецЕсли;
			
			ПозицияОбъект = ТекСтрока.Позиция.ПолучитьОбъект();
			
			СметаСсылка = ?(Смета = Неопределено, ТекСтрока.Позиция.ИдСметы, ПолучитьСсылкуНаДокумент(Смета));
			
			ОтборТЧ = Новый Структура();
			ОтборТЧ.Вставить("Ресурс", Структура.Ресурс);
			
			ТекСтрокиОбъекта = ПозицияОбъект.РесурсыПозицииЛокальнойСметы.НайтиСтроки(ОтборТЧ);
			
			Для Каждого СтрокаОбъекта Из ТекСтрокиОбъекта Цикл
			
				СтрокаОбъекта.Удален	= Истина;	
				
			КонецЦикла;
			
			ПозицияОбъект.Записать();
			
		КонецЦикла;
		Модифицировано = Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;           
	
	Возврат Модифицировано;
	
КонецФункции

// Обновляет базисные и текущие цены у всех ресурсов сметы.
// ВАЖНО, если передан Отбор по позициям - то обрабатываются только переданные позиции
// (без контроля принадлежности смете).
//
// Параметры:
//     ТаблицаСводная 		- ТаблицаЗначений - сводная таблица с ресурсами и новыми значениями цен.    
//     Смета 				- ДокументСсылка.СМ_ЛокальнаяСмета	- ссылка на смету.  
//     ОтборПоПозициям 		- Массив - массив позиций (если нужно проводить замену не по всем позициям).
//     Обнулять 			- Булево - если истина, то нулевые значения вставляются в ресурсы,
//                            иначе - обновляются только ненулевые.
//
// Возвращаемое значение:
//     Модифицировано - Булево - произошло ли обновление.
//
Функция ОбновитьЦеныРесурсыСметы(ТаблицаСводная, Смета = Неопределено, ОтборПоПозициям = Неопределено, Обнулять = Ложь) Экспорт
	
	ОтборПоПозициямСЗ = Новый СписокЗначений();
	Если ОтборПоПозициям = Неопределено Тогда
		// Целиком по смете.
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ПолучитьТаблицуПодчиненных(Смета, Ложь, Истина, Ложь, Истина).ВыгрузитьКолонку("Ид")); 	
	Иначе
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ОтборПоПозициям);
	КонецЕсли;
	
	Модифицировано = Ложь;
	
	Для Каждого ЭлементПозиция Из ОтборПоПозициямСЗ Цикл
		
		Позиция = ЭлементПозиция.Значение;
		
		Если ТипЗнч(Позиция) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Продолжить;
		КонецЕсли;
				
		Если Позиция.РесурсыПозицииЛокальнойСметы.Количество() = 0
			И (Позиция.Определитель.ВидРасценки =  Перечисления.СМ_ВидыРасценки.Материал
			ИЛИ Позиция.Определитель.ВидРасценки =  Перечисления.СМ_ВидыРасценки.Оборудование) Тогда
			
			Отбор = Новый Структура("ЭтоНеучтенный, КодРесурса, НаименованиеРесурса, ЕдиницаИзмеренияРесурса", Истина, Позиция.ШифрРасценки, Позиция.Наименование, Позиция.ЕдиницаИзмерения);
			МассивРесурсов = ТаблицаСводная.НайтиСтроки(Отбор);
			ЭтоМатериал =  (Позиция.Определитель.ВидРасценки =  Перечисления.СМ_ВидыРасценки.Материал);
						
			// Неучтенная.
			Если МассивРесурсов.Количество() = 0 Тогда
				// Нет таких ресурсов.
				Продолжить;
			Иначе 
				ПозицияОбъект = Позиция.ПолучитьОбъект();
				// Обрабатываем первый, больше быть не должно, таблица же сводная.
				Если (МассивРесурсов[0].ЦенаБазисная > 0) ИЛИ Обнулять Тогда
					Если ЭтоМатериал Тогда
						ПозицияОбъект.СтоимМатериалов = МассивРесурсов[0].ЦенаБазисная;	
					Иначе
						ПозицияОбъект.Оборудование = МассивРесурсов[0].ЦенаБазисная;
					КонецЕсли;
				КонецЕсли;
			    Если (МассивРесурсов[0].ЦенаТекущая > 0) ИЛИ Обнулять Тогда
					ПозицияОбъект.ТекущаяЦена = МассивРесурсов[0].ЦенаТекущая;	
				КонецЕсли;     
				ПозицияОбъект.Записать();
				Модифицировано = Истина;
			КонецЕсли;
			
		Иначе
			
			ПозицияОбъект = Позиция.ПолучитьОбъект();
			
			Записать = Ложь;
			
			// Позиция с ресурсами.
			Для Каждого СтрокаТЧ Из ПозицияОбъект.РесурсыПОзицииЛокальнойСметы Цикл
				Отбор = Новый Структура("ЭтоНеучтенный, Ресурс", Ложь, СтрокаТЧ.Ресурс);
				МассивРесурсов = ТаблицаСводная.НайтиСтроки(Отбор);
				
				// Неучтенная.
				Если МассивРесурсов.Количество() = 0 Тогда
					// Нет таких ресурсов.
					Продолжить;
				Иначе 
					//	Обрабатываем первый, больше быть не должно, таблица же сводная.
					Если (МассивРесурсов[0].ЦенаБазисная > 0) ИЛИ Обнулять Тогда
						СтрокаТЧ.БазиснаяЦена = МассивРесурсов[0].ЦенаБазисная;
					КонецЕсли;
				    Если (МассивРесурсов[0].ЦенаТекущая > 0) ИЛИ Обнулять Тогда
						СтрокаТЧ.ТекущаяЦена = МассивРесурсов[0].ЦенаТекущая;	
					КонецЕсли;    
					Если (МассивРесурсов[0].ЦенаЗМБазисная > 0) ИЛИ Обнулять Тогда
						СтрокаТЧ.БазиснаяЗарплатаМашинистов = МассивРесурсов[0].ЦенаЗМБазисная;
					КонецЕсли;
				    Если (МассивРесурсов[0].ЦенаТекущаяЗМ > 0) ИЛИ Обнулять Тогда
						СтрокаТЧ.ТекущаяЗарплатаМашинистов = МассивРесурсов[0].ЦенаТекущаяЗМ;	
					КонецЕсли;
					Записать = Истина;
					Модифицировано = Истина;
				КонецЕсли;				
			
			КонецЦикла;
			
			Если Записать Тогда
				ПозицияОбъект.Записать();
			КонецЕсли;   		
			
		КонецЕсли;

		Модифицировано = Истина;
		
	КонецЦикла;
	
	Возврат Модифицировано;
	
КонецФункции

// Обновляет значения у всех поправок сметы.
// ВАЖНО, если передан Отбор по позициям - то обрабатываются только переданные позиции 
// (без контроля принадлежности смете).
//
// Параметры:
//     ТаблицаСводная 		- ТаблицаЗначений - сводная таблица с поправками и новыми значениями коэффициентов поправок.    
//     Смета 				- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету.  
//     ОтборПоПозициям 		- Массив - массив позиций (если нужно проводить замену не по всем позициям). 
//     Обнулять 			- Булево - если истина, то нулевые значения вставляются в поправки, иначе - нет.
//
// Возвращаемое значение:
//     Модифицировано - Булево - произошло ли обновление.
//
Функция ОбновитьПоправкиСметы(ТаблицаСводная, Смета = Неопределено, ОтборПоПозициям = Неопределено, Обнулять = Ложь) Экспорт
	
	ОтборПоПозициямСЗ = Новый СписокЗначений();
	Если ОтборПоПозициям = Неопределено Тогда
		// Целиком по смете.
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ПолучитьТаблицуПодчиненных(Смета, Ложь, Истина, Ложь, Истина).ВыгрузитьКолонку("Ид")); 	
	Иначе
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ОтборПоПозициям);
	КонецЕсли;
	
	Модифицировано = Ложь;
	
	Для Каждого ЭлементПозиция Из ОтборПоПозициямСЗ Цикл
		
		Позиция = ЭлементПозиция.Значение;
		
		Записывать = Ложь;
		
		Если ТипЗнч(Позиция) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Продолжить;
		КонецЕсли;
		
		ПозицияОбъект = Позиция.ПолучитьОбъект();
		
		Для Каждого СтрокаТЧ Из ПозицияОбъект.ПоправкиПозиции Цикл
			
			// Вариант расчета теперь изменяемое поле
			// Отбор = Новый Структура("УсловияПрименения, Обоснование, ВариантРасчета", СтрокаТЧ.УсловияПрименения, СтрокаТЧ.Обоснование,  СтрокаТЧ.ВариантРасчета);
			Отбор = Новый Структура("УсловияПрименения, Обоснование", СтрокаТЧ.УсловияПрименения, СтрокаТЧ.Обоснование);
			МассивРесурсов = ТаблицаСводная.НайтиСтроки(Отбор);
						
			Если МассивРесурсов.Количество() = 0 Тогда
				// Нет таких поправок.
				Продолжить;
			Иначе 
				// Обрабатываем первый, больше быть не должно, таблица же сводная.
				Если (МассивРесурсов[0].ПрименитьЧисло <> 0) Тогда
					СтрокаТЧ.Применить = МассивРесурсов[0].Применить;	
				КонецЕсли;
			    Если (МассивРесурсов[0].КоэффПЗ > 0) ИЛИ (Обнулять) Тогда
					СтрокаТЧ.КоэффПЗ = МассивРесурсов[0].КоэффПЗ;	
				КонецЕсли;    
				Если (МассивРесурсов[0].КоэффЗМ > 0) ИЛИ (Обнулять) Тогда
					СтрокаТЧ.КоэффЗМ = МассивРесурсов[0].КоэффЗМ;	
				КонецЕсли;
				Если (МассивРесурсов[0].КоэффЭМ > 0) ИЛИ (Обнулять) Тогда
					СтрокаТЧ.КоэффЭМ = МассивРесурсов[0].КоэффЭМ;	
				КонецЕсли;
				Если (МассивРесурсов[0].КоэффОЗ > 0) ИЛИ (Обнулять) Тогда
					СтрокаТЧ.КоэффОЗ = МассивРесурсов[0].КоэффОЗ;	
				КонецЕсли;
				Если (МассивРесурсов[0].КоэффСМ > 0) ИЛИ (Обнулять) Тогда
					СтрокаТЧ.КоэффСМ = МассивРесурсов[0].КоэффСМ;	
				КонецЕсли;
				Если (МассивРесурсов[0].КоэффТР > 0) ИЛИ (Обнулять) Тогда
					СтрокаТЧ.КоэффТР = МассивРесурсов[0].КоэффТР;	
				КонецЕсли;
				Если (МассивРесурсов[0].КоэффТМ > 0) ИЛИ (Обнулять) Тогда
					СтрокаТЧ.КоэффТМ = МассивРесурсов[0].КоэффТМ;	
				КонецЕсли;                               				
				Если (МассивРесурсов[0].ДобавПЗ > 0) ИЛИ (Обнулять) Тогда
					СтрокаТЧ.ДобавПЗ = МассивРесурсов[0].ДобавПЗ;	
				КонецЕсли;    
				Если (МассивРесурсов[0].ДобавОЗ > 0) ИЛИ (Обнулять) Тогда
					СтрокаТЧ.ДобавОЗ = МассивРесурсов[0].ДобавОЗ;	
				КонецЕсли;
				Если (МассивРесурсов[0].ДобавЭМ > 0) ИЛИ (Обнулять) Тогда
					СтрокаТЧ.ДобавЭМ = МассивРесурсов[0].ДобавЭМ;	
				КонецЕсли;
				Если (МассивРесурсов[0].ДобавЗМ > 0) ИЛИ (Обнулять) Тогда
					СтрокаТЧ.ДобавЗМ = МассивРесурсов[0].ДобавЗМ;	
				КонецЕсли;
				Если (МассивРесурсов[0].ДобавСМ > 0) ИЛИ (Обнулять) Тогда
					СтрокаТЧ.ДобавСМ = МассивРесурсов[0].ДобавСМ;	
				КонецЕсли;
				Если (МассивРесурсов[0].ДобавТР > 0) ИЛИ (Обнулять) Тогда
					СтрокаТЧ.ДобавТР = МассивРесурсов[0].ДобавТР;	
				КонецЕсли;
				
				//Если (МассивРесурсов[0].ДобавТМ > 0) ИЛИ (Обнулять) Тогда
				//	СтрокаТЧ.ДобавТ = МассивРесурсов[0].ДобавТМ;	
				//КонецЕсли;
				
				Если (МассивРесурсов[0].ДобавТ > 0) ИЛИ (Обнулять) Тогда
					СтрокаТЧ.ДобавТ = МассивРесурсов[0].ДобавТ;	
				КонецЕсли;
				
				Если ЗначениеЗаполнено(МассивРесурсов[0].ВариантРасчета) Тогда
					СтрокаТЧ.ВариантРасчета = МассивРесурсов[0].ВариантРасчета;	
				КонецЕсли;				
				
				Модифицировано 	= Истина;
				Записывать 		= Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если Записывать Тогда
			ПозицияОбъект.Записать();
		КонецЕсли;   		

	КонецЦикла;
	
	Возврат Модифицировано;
	
КонецФункции

// Добавляет новые поправки у всех переданных позиций сметы.
// ВАЖНО, если передан Отбор по позициям - то обрабатываются только переданные позиции
// (без контроля принадлежности смете).
//
// Параметры:
//     ТаблицаСводная 		- ТаблицаЗначений - сводная таблица с поправками и новыми значениями коэффициентов поправок.   
//     Смета 				- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету.  
//     ОтборПоПозициям 		- Массив - массив позиций (если нужно проводить замену не по всем позициям). 
//
// Возвращаемое значение:
//     Модифицировано - Булево - произошло ли обновление.
//
Функция ДобавитьПоправкиСметы(ТаблицаСводная, Смета = Неопределено, ОтборПоПозициям = Неопределено) Экспорт
	
	ОтборПоПозициямСЗ = Новый СписокЗначений();
	Если ОтборПоПозициям = Неопределено Тогда
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ПолучитьТаблицуПодчиненных(Смета, Ложь, Истина, Ложь, Истина).ВыгрузитьКолонку("Ид")); 	
	Иначе
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ОтборПоПозициям);
	КонецЕсли;
	
	Модифицировано = Ложь;
	
	Для Каждого ЭлементПозиция Из ОтборПоПозициямСЗ Цикл
		
		Позиция 	= ЭлементПозиция.Значение;
		Записывать 	= Ложь;
		
		Если ТипЗнч(Позиция) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Продолжить;
		КонецЕсли;
		
		ПозицияОбъект 	= Позиция.ПолучитьОбъект();
		ТекТаблица 		= ПозицияОбъект.ПоправкиПозиции.Выгрузить();
		МассивКолонок 	= ТекТаблица.Колонки;
		
		Для Каждого ТекСтрока Из ТаблицаСводная Цикл
			НоваяСтрока = ПозицияОбъект.ПоправкиПозиции.Добавить();
			Для Каждого ТекКолонка Из МассивКолонок Цикл
				Если ТекКолонка.Имя = "НомерСтроки" Тогда
					Продолжить;	
				ИначеЕсли ТекКолонка.Имя = "Справка" Тогда
					Продолжить;	
				ИначеЕсли ТекКолонка.Имя = "ДобавТ" Тогда
					//НоваяСтрока[ТекКолонка.Имя] = ТекСтрока["ДобавТМ"];	
					НоваяСтрока[ТекКолонка.Имя] = ТекСтрока["ДобавТ"];	
				Иначе
					НоваяСтрока[ТекКолонка.Имя] = ТекСтрока[ТекКолонка.Имя];	
				КонецЕсли;
			КонецЦикла;
			Модифицировано 	= Истина;
			Записывать 		= Истина;

		КонецЦикла;
		
		Если Записывать Тогда
			ПозицияОбъект.Записать();
		КонецЕсли;   		

	КонецЦикла;
	
	Возврат Модифицировано;
	
КонецФункции

// Удаление поправок из табличной части документа ПозицияЛокальнойСметы.
//
// Параметры:
//     ТаблицаСводная 	- ТаблицаЗначений - сводная таблица с поправками.   
//     Смета 			- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету.  
//     ОтборПоПозициям 	- Массив - массив позиций (если нужно проводить замену не по всем позициям). 
//
// Возвращаемое значение:
//     Модифицировано - Булево - произошло ли удаление.
//
Функция УдалитьПоправкиСметы(ТаблицаСводная, Смета = Неопределено, ОтборПоПозициям = Неопределено) Экспорт
	
	ОтборПоПозициямСЗ = Новый СписокЗначений();
	Если ОтборПоПозициям = Неопределено Тогда
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ПолучитьТаблицуПодчиненных(Смета, Ложь, Истина, Ложь, Истина).ВыгрузитьКолонку("Ид")); 	
	Иначе
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ОтборПоПозициям);
	КонецЕсли;
	
	Модифицировано = Ложь;
	
	Для Каждого ЭлементПозиция Из ОтборПоПозициямСЗ Цикл
		
		Позиция 	= ЭлементПозиция.Значение;
		Записывать 	= Ложь;
		
		Если ТипЗнч(Позиция) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Продолжить;
		КонецЕсли;
		
		ПозицияОбъект 	= Позиция.ПолучитьОбъект();
		ТекТаблица 		= ПозицияОбъект.ПоправкиПозиции.Выгрузить();
		МассивКолонок 	= ТекТаблица.Колонки;
		Если ТекТаблица.Количество() = 0  Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ТекСтрока Из ТаблицаСводная Цикл
			Для Каждого СтрокаПоправки Из ТекТаблица Цикл
				Если Сред(СтрокаПоправки.УсловияПрименения,1,200) = Сред(ТекСтрока.УсловияПрименения,1,200)
					И СтрокаПоправки.Обоснование = ТекСтрока.Обоснование
					И СтрокаПоправки.КоэффПЗ = ТекСтрока.КоэффПЗ
					И СтрокаПоправки.КоэффОЗ = ТекСтрока.КоэффОЗ
					И СтрокаПоправки.КоэффЭМ = ТекСтрока.КоэффЭМ
					И СтрокаПоправки.КоэффЗМ = ТекСтрока.КоэффЗМ
					И СтрокаПоправки.КоэффСМ = ТекСтрока.КоэффСМ
					И СтрокаПоправки.КоэффТР = ТекСтрока.КоэффТР
					И СтрокаПоправки.КоэффТМ = ТекСтрока.КоэффТМ
					И СтрокаПоправки.ДобавПЗ = ТекСтрока.ДобавПЗ
					И СтрокаПоправки.ДобавОЗ = ТекСтрока.ДобавОЗ
					И СтрокаПоправки.ДобавЭМ = ТекСтрока.ДобавЭМ
					И СтрокаПоправки.ДобавЗМ = ТекСтрока.ДобавЗМ
					И СтрокаПоправки.ДобавСМ = ТекСтрока.ДобавСМ
					И СтрокаПоправки.ДобавТР = ТекСтрока.ДобавТР
					//И СтрокаПоправки.ДобавТ = ТекСтрока.ДобавТМ 
					И СтрокаПоправки.ДобавТ = ТекСтрока.ДобавТ Тогда

					ТекТаблица.Удалить(СтрокаПоправки);
					
					Модифицировано 	= Истина;
					Записывать 		= Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Если Записывать Тогда
			ПозицияОбъект.ПоправкиПозиции.Очистить();
			ПозицияОбъект.ПоправкиПозиции.Загрузить(ТекТаблица);	
			ПозицияОбъект.Записать();
		КонецЕсли;   		

	КонецЦикла;
	
	Возврат Модифицировано;
	
КонецФункции

// Обновляет значения у всех поправок сметы.
// ВАЖНО, если передан Отбор по позициям - то обрабатываются только переданные позиции
// (без контроля принадлежности смете).
//
// Параметры:
//     ТаблицаСводная 	- ТаблицаЗначений - сводная таблица с поправками и новыми значениями коэффициентов поправок.    
//     Смета 			- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету.  
//     ОтборПоПозициям	- Массив - массив позиций (если нужно проводить замену не по всем позициям). 
//	   Обнулять			- Булево - если истина, то происходит заполнение значениями по умолчанию из числовых параметров. 
//
// Возвращаемое значение:
//     Модифицировано - Булево - произошло ли обновление.
//
Функция ОбновитьНачисленияСметы(ТаблицаСводная, Смета = Неопределено, ОтборПоПозициям = Неопределено, Обнулять = Ложь) Экспорт
	
	ОтборПоПозициямСЗ = Новый СписокЗначений();
	Если ОтборПоПозициям = Неопределено Тогда
		// Целиком по смете.
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ПолучитьТаблицуПодчиненных(Смета, Ложь, Истина, Ложь, Истина).ВыгрузитьКолонку("Ид")); 	
	Иначе
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ОтборПоПозициям);
	КонецЕсли;
	
	Модифицировано = Ложь;
	
	Для Каждого ЭлементПозиция Из ОтборПоПозициямСЗ Цикл
		
		Позиция = ЭлементПозиция.Значение;
		
		Записывать = Ложь;
		
		Если ТипЗнч(Позиция) <> Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Продолжить;
		КонецЕсли;
		
		ПозицияОбъект = Позиция.ПолучитьОбъект();
		
		Для Каждого СтрокаТЧ Из ПозицияОбъект.НачисленияПозиции Цикл
			
			Отбор = Новый Структура("ЧисловойПараметр", СтрокаТЧ.ЧисловойПараметр);
			МассивНачислений = ТаблицаСводная.НайтиСтроки(Отбор);
						
			Если МассивНачислений.Количество() = 0 Тогда
				// Нет таких поправок.
				Продолжить;
			Иначе 
				// Обрабатываем первый, больше быть не должно, таблица же сводная.
				Если МассивНачислений[0].Пометка = Истина Тогда
					
					Если Не Обнулять Тогда
						Если (МассивНачислений[0].Значение <> 0) Тогда
							СтрокаТЧ.Значение = МассивНачислений[0].Значение;
						КонецЕсли;
					ИначеЕсли Обнулять Тогда
						СтрокаТЧ.Значение = МассивНачислений[0].ЧисловойПараметр.ЗначениеПоУмолчанию;
					КонецЕсли;    
					Если (МассивНачислений[0].Формула <> "") ИЛИ (Обнулять) Тогда
						СтрокаФормула = ?(МассивНачислений[0].Формула = "0","",МассивНачислений[0].Формула); 
						СтрокаТЧ.Формула = СтрокаФормула;	
					КонецЕсли;
					
					Модифицировано = Истина;
					Записывать = Истина;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Записывать Тогда
			ПозицияОбъект.Записать();
		КонецЕсли;   		

	КонецЦикла;
	
	Возврат Модифицировано;
	
КонецФункции

// Обновляет индексы у позиций сметы.
// ВАЖНО, если передан Отбор по позициям - то обрабатываются только переданные позиции
// (без контроля принадлежности смете).
//
// Параметры:
//     ТаблицаСводная 			- ТаблицаЗначений - сводная таблица с индексами.    
//     Смета 					- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету.  
//     ОтборПоПозициям			- Массив - массив позиций (если нужно проводить замену не по всем позициям). 
//     Обнулять 				- Булево - если истина, то нулевые значения вставляются в ресурсы,
//                                         иначе - обновляются только ненулевые.
//     УдалятьИндексы			- Булево - есть истина, то строка индексов удаляется.
//
// Возвращаемое значение:
//     Модифицировано - Булево - произошло ли обновление.
//
Функция ОбновитьИндексыСметы(ТаблицаСводная, Смета = Неопределено, ОтборПоПозициям = Неопределено, Обнулять = Ложь, УдалятьИндексы = Ложь) Экспорт
	
	ОтборПоПозициямСЗ = Новый СписокЗначений();
	Если ОтборПоПозициям = Неопределено Тогда
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ПолучитьТаблицуПодчиненных(Смета, Ложь, Истина, Ложь, Истина).ВыгрузитьКолонку("Ид")); 	
	Иначе
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ОтборПоПозициям);
	КонецЕсли;
	
	Модифицировано = Ложь;
	
	Для Каждого ЭлементПозиция Из ОтборПоПозициямСЗ Цикл
		
		Позиция = ЭлементПозиция.Значение;
		
		СтрокаИндексов 	= ТаблицаСводная[0];

		Если ТипЗнч(Позиция) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		
			ПозицияОбъект = Позиция.ПолучитьОбъект();
			
			Если УдалятьИндексы Тогда
				
				Если ПозицияОбъект.КоэффициентыПересчета.Количество() > 0 Тогда
					ПозицияОбъект.КоэффициентыПересчета.Очистить();		
				КонецЕсли;	
				
			Иначе	
				
				// Нужно добавить строку.
				Если ПозицияОбъект.КоэффициентыПересчета.Количество() = 0 Тогда
					СтрокаТЧ 							= ПозицияОбъект.КоэффициентыПересчета.Добавить();		
					СтрокаТЧ.ВидРабот                   = СтрокаИндексов.ВидРабот;
					СтрокаТЧ.ВариантПересчетаЭММ        = СтрокаИндексов.ВариантПересчетаЭММ;
					СтрокаТЧ.КоэффОснЗарплаты           = СтрокаИндексов.КоэффОснЗарплатыСтарая;
					СтрокаТЧ.КоэффСтоимЭксплМашин       = СтрокаИндексов.КоэффСтоимЭксплМашинСтарая;
					СтрокаТЧ.КоэффСтоимЗарплатеМашин    = СтрокаИндексов.КоэффСтоимЗарплатеМашинСтарая;
					СтрокаТЧ.КоэффСтоимМатериалов       = СтрокаИндексов.КоэффСтоимМатериаловСтарая;
					СтрокаТЧ.КоэффОборуд                = СтрокаИндексов.КоэффОборудСтарая;
					СтрокаТЧ.КоэффПолнСтоимРабот        = СтрокаИндексов.КоэффПолнСтоимРаботСтарая;
				Иначе
					СтрокаТЧ = ПозицияОбъект.КоэффициентыПересчета[0];
				КонецЕсли;
			
				// Обновление коэффициентов пересчета.
				ЗаполнитьИндексыВСтроке(СтрокаТЧ,СтрокаИндексов,Обнулять);
			
			КонецЕсли;
			
			Модифицировано 	= Истина;
		    ПозицияОбъект.Записать();

		ИначеЕсли ТипЗнч(Позиция) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
			И Смета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда
					
			РазделОбъект = Позиция.ПолучитьОбъект();
			ЗаполнитьИндексыВСтроке(РазделОбъект,СтрокаИндексов,Обнулять);
			РазделОбъект.Записать();
		КонецЕсли;
		
	КонецЦикла;

	Возврат Модифицировано;
	
КонецФункции

// Функция обновляет индексы у позиций акта.
//	ВАЖНО, если передан Отбор по позициям - то обрабатываются только переданные позиции
//  (без контроля принадлежности смете).
//
// Параметры:
//     ТаблицаСводная 	- ТаблицаЗначений - сводная таблица с индексами.    
//     Смета 			- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету.  
//     ОтборПоПозициям	- Массив - массив позиций (если нужно проводить замену не по всем позициям). 
//     Обнулять 		- Булево - если истина, то нулевые значения вставляются в ресурсы,
//                                 иначе - обновляются только ненулевые.
//	   Очистить			- Булево - не используется в функции, видимо нужно удалить. 
//
// Возвращаемое значение:
//     Модифицировано - Булево - произошло ли обновление.
//  
Функция ОбновитьИндексыАкта(ТаблицаСводная, Смета = Неопределено, ОтборПоПозициям = Неопределено, Обнулять = Ложь, Очистить = Ложь) Экспорт
	
	ОтборПоПозициямСЗ = Новый СписокЗначений();
	// Целиком по смете.
	Если ОтборПоПозициям = Неопределено Тогда
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ПолучитьТаблицуПодчиненных(Смета, Ложь, Истина, Ложь, Истина).ВыгрузитьКолонку("Ид")); 	
	Иначе
		ОтборПоПозициямСЗ.ЗагрузитьЗначения(ОтборПоПозициям);
	КонецЕсли;
	
	АктОбъект 		= Смета.ПолучитьОбъект();
	СтрокаТаблицы 	= ТаблицаСводная[0];

	Модифицировано 	= Ложь;
	Записывать 		= Ложь;
	
	Для Каждого ЭлементПозиция Из ОтборПоПозициямСЗ Цикл
		
		Позиция = ЭлементПозиция.Значение;
				
		Если Смета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка Тогда
			Если ТипЗнч(Позиция) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Позиция",ЭлементПозиция.Значение);
				МассивСтрокАкта	= АктОбъект.Позиции.НайтиСтроки(СтруктураПараметров);
				Если МассивСтрокАкта.Количество() > 0 Тогда
					Для Каждого СтрокаТЧ Из МассивСтрокАкта Цикл
						ЗаполнитьИндексыВСтроке(СтрокаТЧ,СтрокаТаблицы,Обнулять);
					КонецЦикла;
					Модифицировано 	= Истина;
					Записывать 		= Истина;
					
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Обновлены индексы по позиции %1 в ТЧ Акта'"), ЭлементПозиция.Значение);
					Сообщение.Сообщить();						
					
				КонецЕсли;	
			КонецЕсли;
			
		ИначеЕсли Смета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда
			
			Если ТипЗнч(Позиция) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Раздел",ЭлементПозиция.Значение);
				МассивСтрокАкта	= АктОбъект.Разделы.НайтиСтроки(СтруктураПараметров);
				Если МассивСтрокАкта.Количество() > 0 Тогда
					Для Каждого СтрокаТЧ Из МассивСтрокАкта Цикл
						ЗаполнитьИндексыВСтроке(СтрокаТЧ,СтрокаТаблицы,Обнулять);
					КонецЦикла;
					Модифицировано 	= Истина;
					Записывать 		= Истина;
					
			   		Сообщение = Новый СообщениеПользователю();
				    Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Обновлены индексы по разделу %1 в ТЧ Акта'"), ЭлементПозиция.Значение);
				    Сообщение.Сообщить();						
					
				КонецЕсли;
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Записывать Тогда
		АктОбъект.Записать();
	КонецЕсли;   		
	
	Возврат Модифицировано;
	
КонецФункции

// Создает позиции по неучтенним ресурсам и по проекту.
//
// Параметры:
//     ВходныеПараметры 	- Структура - содержит ссылку на таблицу (результат функции ПолучитьСтруктуруНеучтенныхРесурсов)
//                            во внутреннем хранилище.    
//     Параметры 			- Произвольный - дополнительные параметры обработки.  
//     СметаПоУмолчанию 	- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету
//                                                               (для заполнения, если не задана в таблице). 
//
// Возвращаемое значение:
//     Массив - содержит ссылки на сметы, в которые добавлены позиции (для обновления смет).
//
Функция СоздатьПозицииПоНеучтеннымРесурсамИПоПроекту(ВходныеПараметры, Параметры = неопределено, СметаПоУмолчанию = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ВходныеПараметры) Тогда
		Возврат Новый Массив();
	КонецЕсли;
	
	Ресурсы = ПолучитьИзВременногоХранилища(ВходныеПараметры.Ресурсы);
	
	МассивСмет = Новый Массив();
	
	Смета = СметаПоУмолчанию;
	
	Для Каждого СтрокаНеУчтенные Из Ресурсы Цикл
		
		ПозицияЛС = СтрокаНеУчтенные.Позиция;
		Если ТипЗнч(СтрокаНеУчтенные.Ресурс) = Тип("СправочникСсылка.СМ_Ресурсы") Тогда
			// Не к чему, можно просто обратиться к реквизитам напрямую, модуль серверный.
		Иначе
			Продолжить;
		КонецЕсли;
		
		ВидРесурса = СтрокаНеУчтенные.ВидРесурса;
		
		// Создадим новую позицию, привязанную к текущей.
		НоваяПозиция = СоздатьНовуюПозицию(); // Ресурсы 
		ЗаполнитьДанныеДокументаВСтруктуреСмет(НоваяПозиция, ПозицияЛС, Истина);
		НоваяПозиция.Расчет 			= Истина;
		НоваяПозиция.ШифрРасценки 		= ?(Не СтрокаНеУчтенные.Ресурс.Пустая(),СтрокаНеУчтенные.Ресурс.Код,СтрокаНеУчтенные.СметныйКодРесурса);
		НоваяПозиция.Измеритель 		= ?(Не СтрокаНеУчтенные.Ресурс.Пустая(),СтрокаНеУчтенные.Ресурс.ЕдиницаИзмерения,СтрокаНеУчтенные.ЕдиницаИзмерения);
		НоваяПозиция.ПрямЗатраты 		= СтрокаНеУчтенные.БазиснаяЦена;
		НоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Ресурсы;
		НоваяПозиция.ИсточникСоздания	= НоваяПозиция.ШифрРасценки; 		
		Если СтрокаНеУчтенные.ФлПрайс = Истина Тогда
			НоваяПозиция.ТипНормативныхСборников = СтрокаНеУчтенные.НормСборник;
			НоваяПозиция.Определитель = СтрокаНеУчтенные.Определитель;
			Если СтрокаНеУчтенные.ФлагОборудование Тогда
				НоваяПозиция.Оборудование = СтрокаНеУчтенные.БазиснаяЦена;
				НоваяПозиция.ПрямЗатраты = 0;
			Иначе
				НоваяПозиция.СтоимМатериалов = СтрокаНеУчтенные.БазиснаяЦена;
				НоваяПозиция.ПрямЗатраты = СтрокаНеУчтенные.БазиснаяЦена;
			КонецЕсли;	
		Иначе
			Если Не ЗначениеЗаполнено(ВидРесурса) Тогда
				ТипНормативныхСборников = СМ_СметаЗагрузкаВызовСервера.ОпределитьТипНормСборникаПоШифру(?(Не СтрокаНеУчтенные.Ресурс.Пустая(),СтрокаНеУчтенные.Ресурс.Код,СтрокаНеУчтенные.СметныйКодРесурса));
				ВидРесурса = СМ_СметаЗагрузкаВызовСервера.ОпределитьВидРесурсаПоШифру(?(Не СтрокаНеУчтенные.Ресурс.Пустая(),СтрокаНеУчтенные.Ресурс.Код,СтрокаНеУчтенные.СметныйКодРесурса));
			КонецЕсли;
			НоваяПозиция.ТипНормативныхСборников = ТипНормативныхСборников;
			НоваяПозиция.Измеритель = ?(Не СтрокаНеУчтенные.Ресурс.Пустая(),СтрокаНеУчтенные.Ресурс.ЕдиницаИзмерения,СтрокаНеУчтенные.ЕдиницаИзмерения);
			НоваяПозиция.РегиональнаяБаза = ПозицияЛС.РегиональнаяБаза;
			НоваяПозиция.Определитель = СтрокаНеУчтенные.Позиция.Определитель;

			Если ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
				НоваяПозиция.ТипНормативныхСборников 	= Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;
				Если СтрокаНеУчтенные.ФлагОборудование Тогда	
					НоваяПозиция.Определитель = Справочники.СМ_Определители.НайтиПоКоду("14");
					НоваяПозиция.Оборудование = СтрокаНеУчтенные.БазиснаяЦена;
				Иначе
					НоваяПозиция.Определитель = Справочники.СМ_Определители.НайтиПоКоду("19");
					НоваяПозиция.СтоимМатериалов = СтрокаНеУчтенные.БазиснаяЦена;
				КонецЕсли;	
			ИначеЕсли ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
				НоваяПозиция.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин;
				НоваяПозиция.ЗарплМашинистов = СтрокаНеУчтенные.БазиснаяЗарплатаМашинистов;
				НоваяПозиция.ЭксплМашин = СтрокаНеУчтенные.БазиснаяЦена;
				НоваяПозиция.ТекущаяЦена = СтрокаНеУчтенные.ТекущаяЦена;
				НоваяПозиция.ТекущаяЗарплатаМашинистов = СтрокаНеУчтенные.ТекущаяЗарплатаМашинистов;
				НоваяПозиция.Определитель = Справочники.СМ_Определители.НайтиПоКоду("1");
			ИначеЕсли ВидРесурса = Перечисления.СМ_ВидыРесурсов.Оборудование Тогда
				НоваяПозиция.ПрямЗатраты 			= 0;
				НоваяПозиция.Оборудование 			= СтрокаНеУчтенные.БазиснаяЦена;
				НоваяПозиция.Определитель 			= Справочники.СМ_Определители.НайтиПоКоду("14");
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаНеУчтенные.Определитель) Тогда
				НоваяПозиция.Определитель = СтрокаНеУчтенные.Определитель;
			КонецЕсли;
			
		КонецЕсли;
		ОбъемРаботПозицииВладельца = СтрЗаменить(СокрЛП(Строка(Формат(СтрокаНеУчтенные.Позиция.ОбъемРабот,"ЧН=0; ЧГ=0"))),",",".");
		ФормулаОбъема = "" + СтрЗаменить(Строка(Формат(СтрокаНеУчтенные.НормаРасхода,"ЧН=0; ЧГ=0")),",",".") + " * " + ?(СтрокаНеУчтенные.Позиция.ФормулаОбъема= "",ОбъемРаботПозицииВладельца,СтрокаНеУчтенные.Позиция.ФормулаОбъема);
		ОбъемРабот = 0;
		Формула = "ОбъемРабот = Значение";
		Формула = СтрЗаменить(Формула,"Значение", ФормулаОбъема);
		Попытка
			Выполнить(Формула);
		Исключение
			Событие = НСтр("ru = 'Исключение Обработчики сметы (вызов сервера)'");
			СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
		КонецПопытки;
		НоваяПозиция.ОбъемРабот = ОбъемРабот;
		НоваяПозиция.ФормулаОбъема = ФормулаОбъема;
		НоваяПозиция.НеПрименятьИндексы = СтрокаНеУчтенные.НеИндексировать;
		НоваяПозиция.ТекущаяЦена = СтрокаНеУчтенные.ТекущаяЦена;
		НоваяПозиция.Наименование = ?(Не СтрокаНеУчтенные.Ресурс.Пустая(),СтрокаНеУчтенные.Ресурс.Наименование,СтрокаНеУчтенные.НовыйРесурс);
		НоваяПозиция.Дата = ПозицияЛС.Дата;
		Если СтрокаНеУчтенные.ФлПрайс = Истина Тогда
			НоваяПозиция.ЕдиницаИзмерения = СтрокаНеУчтенные.ЕдиницаИзмерения;
			НоваяПозиция.Измеритель = СтрокаНеУчтенные.Измеритель;         		
		Иначе
			НоваяПозиция.ЕдиницаИзмерения = ?(Не СтрокаНеУчтенные.Ресурс.Пустая(),СтрокаНеУчтенные.Ресурс.ЕдиницаИзмерения,СтрокаНеУчтенные.ЕдиницаИзмерения);
			НоваяПозиция.Измеритель = ?(Не СтрокаНеУчтенные.Ресурс.Пустая(),СтрокаНеУчтенные.Ресурс.ЕдиницаИзмерения,СтрокаНеУчтенные.ЕдиницаИзмерения);         		
		КонецЕсли;
		
		// ++ AVV Заполнение нормы расхода ресурса
		Если ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы ИЛИ ВидРесурса = Перечисления.СМ_ВидыРесурсов.Оборудование Тогда
			НоваяПозиция.НормаРасходаРесурса = СтрокаНеУчтенные.НормаРасхода;
			Если НоваяПозиция.НормаРасходаРесурса > 0 Тогда
				НоваяПозиция.КоличествоРесурса = НоваяПозиция.ОбъемРабот/НоваяПозиция.НормаРасходаРесурса;
			Иначе
				НоваяПозиция.КоличествоРесурса = 0;
			КонецЕсли;
		КонецЕсли;
		// -- AVV
		
		НоваяПозиция.ТекущаяЦена = СтрокаНеУчтенные.ТекущаяЦена;
		НоваяПозиция.ТекущаяЗарплатаМашинистов = СтрокаНеУчтенные.ТекущаяЗарплатаМашинистов;
		НоваяПозиция.Записать();
		
		УстановитьНомерДокумента(НоваяПозиция.Ссылка, , , СМ_СметныйСоставВызовСервера.ПолучитьМаксимальныйНомерВДереве(НоваяПозиция.ИДСметы, НоваяПозиция.ИДРодителя) + 0.01, , "СМ_ПозицияЛокальнойСметы"); 
		
		Если СтрокаНеУчтенные.ФлПрайс = Истина Тогда
			Если Не СтрокаНеУчтенные.Прайс = Неопределено Тогда
				Если СтрокаНеУчтенные.ПереноситьЧП = Истина Тогда
					ПереноситьЧП(СтрокаНеУчтенные.Прайс,НоваяПозиция);
				КонецЕсли;
			Иначе
				Документы.СМ_ПозицияЛокальнойСметы.ЗаполнитьНачисленияПозицииПоУмолчанию(НоваяПозиция);
			КонецЕсли;
		Иначе	
			Документы.СМ_ПозицияЛокальнойСметы.ЗаполнитьНачисленияПозицииПоУмолчанию(НоваяПозиция);
		КонецЕсли;
		Если СтрокаНеУчтенные.ФлПрайс = Истина Тогда
			Если Не СтрокаНеУчтенные.Прайс = Неопределено Тогда
				Если СтрокаНеУчтенные.ПереноситьПоправки = Истина Тогда
					ПереноситьПоправки(СтрокаНеУчтенные.Прайс,НоваяПозиция);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если СтрокаНеУчтенные.ФлПрайс = Истина Тогда
			Если Не СтрокаНеУчтенные.Прайс = Неопределено Тогда
				Если СтрокаНеУчтенные.ПереноситьПримечания = Истина Тогда
					ПереноситьПримечание(СтрокаНеУчтенные.Прайс,НоваяПозиция);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		НоваяПозиция.Записать();
		ЛС = НайтиЛС(НоваяПозиция.Ссылка);
		
		Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(НоваяПозиция, Ложь);		

		НоваяПозиция.Записать();
		
		// Запомним смету, чтобы отдать на обновление.
		Смета = НоваяПозиция.ИдСметы;
		
	КонецЦикла;	
	
	УдалитьИзВременногоХранилища(ВходныеПараметры.Ресурсы);
	
	// Пока что редактируем позиции только в пределах одной сметы.
	МассивСмет.Добавить(Смета);
	
	Возврат МассивСмет;
		
КонецФункции

// Определяет номер сборника из шифра по коду сборника.
//
// Параметры:
//     КодСборника 		 - Строка, ПеречислениеСсылка.СМ_ТипыНормативныхСборников - двухсимвольное представление 
//						   типа сборника (для внешней базы) или ссылка на перечисление ТипыНормативныхСборников.
//     ШифрРасценки 	 - Строка - содержит шифр расценки.
//     МетодикаТСН 		 - Булево - если Истина - то номер сборника возвращается без главы.
//     МетодикаКазахстан - Булево - если Истина - то получаем номер сборника для Казани.
//
// Возвращаемое значение:
//     НомерСборника - Число - содержит номер сборника.
//
Функция ОпределитьНомерСборника(КодСборника, ШифрРасценки, МетодикаТСН = Ложь, МетодикаКазахстан = Ложь) Экспорт
	
	// Если данная функция изменяется
	// Программист!
	// Уведоми разработчика ВНБ об изменениях
	// Иначе работать не будет!
	
	Если ТипЗнч(КодСборника) = Тип("ПеречислениеСсылка.СМ_ТипыНормативныхСборников") Тогда
		КодСборникаТек = СМ_СметаЗагрузкаВызовСервера.ОпределитьКодТипаСборника(КодСборника);
	Иначе
		КодСборникаТек = КодСборника;	
	КонецЕсли;
	
	Если МетодикаТСН = Ложь Тогда
		
		Если КодСборникаТек = "CL" Тогда
			Возврат 0;
		КонецЕсли;
		
		Если КодСборникаТек = "CT" Тогда
			Возврат 0;
		КонецЕсли;  
		
		ПервыйТип = Новый Массив;
		ПервыйТип.Добавить("ER");
		ПервыйТип.Добавить("VR");
		ПервыйТип.Добавить("MO");
		ПервыйТип.Добавить("PU");
		ПервыйТип.Добавить("US");
		ПервыйТип.Добавить("RS");
		ПервыйТип.Добавить("GH");
		
		Если СтрДлина(ШифрРасценки)=0 Тогда
			Возврат 0;
		ИначеЕсли (СтрДлина(ШифрРасценки)<3) и (МетодикаКазахстан) Тогда
			Возврат 0;
		Иначе
			Если Найти("1234567890", Лев(ШифрРасценки, 1))=0 Тогда
				Возврат 0; // Начинается не с цифры.
			ИначеЕсли Не МетодикаКазахстан Тогда
				Если Не ПервыйТип.Найти(КодСборникаТек) = Неопределено Тогда // Найдено в списке.
					Поз = Найти(ШифрРасценки, "-");
					Если Поз>0 Тогда
						НомерСборника = Число(Лев(ШифрРасценки,Поз-1));
					Иначе
						НомерСборника = 0;
					КонецЕсли;
				ИначеЕсли (КодСборникаТек = "CN") Тогда
					НомерСборника = Число(Лев(ШифрРасценки,1));
				Иначе
					НомерСборника = 0;
				КонецЕсли;
			ИначеЕсли МетодикаКазахстан Тогда
				// Если Не ПервыйТип.Найти(КодСборникаТек) = Неопределено Тогда // Найдено в списке.
				//	НомерСборника = Число(Сред(ШифрРасценки,3,2));
				// Иначе
				//	НомерСборника = 0;
				// КонецЕсли;
				СтрокаШифра = СтрЗаменить(ШифрРасценки,"-","");
				Попытка
					НомерСборника = Число(?(СтрДлина(СтрокаШифра)<4,0,Сред(СтрокаШифра,3,2)));
				Исключение
					НомерСборника = 0;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		Если Прав(ШифрРасценки,1) = "." Тогда
			НомерСборника = 0;
		Иначе
			Поз = Найти(ШифрРасценки,".");
			Если Поз <> 0 Тогда
				НомерСборника  = Сред(ШифрРасценки,Поз + 1);
			Иначе	
				НомерСборника = 0;
			КонецЕсли;	
			Поз = Найти(НомерСборника,"-");
			Если Поз <> 0 Тогда
				НомерСборника = Сред(НомерСборника,1,Поз - 1);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Число(НомерСборника);
	
КонецФункции

// Загружает индексы в позиции локальной сметы.
//
// Параметры:
//     МассивПозицийИлиПозицияИлиДокумент - ДокументСсылка	- один из типов:
//												* ссылка на позицию ИЛИ массив ссылок для выборки индексов.
//												* можно передать смету - тогда все позиции сметы.
//												* можно передать акт - тогда все позиции акта.
//     ДанныеОбИндексах 					- Строка	- данные в виде строки в формате XML (из ВНБ).
//     ВариантПересчетаЭММ 				- ПеречислениеСсылка.СМ_ВариантыПересчетаЭММ	- вариант пересчета ЭММ.
//     Обнулять 						- Булево	- обнулять ИЛИ нет значения, если не найдены.
//     Пересчитать 						- Булево	- пересчитывать позиции ИЛИ нет.
//     АктВыполненныхРабот 				- ДокументСсылка.СМ_АктВыполненныхРабот	- ссылка на акт, если идет расчет акта.
//
Процедура ЗагрузитьИндексыВПозиции(МассивПозицийИлиПозицияИлиДокумент, ДанныеОбИндексах, ВариантПересчетаЭММ, Обнулять = Истина, Пересчитать = Ложь, АктВыполненныхРабот = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ДанныеОбИндексах) Тогда
		Возврат;
	КонецЕсли;
		
	Если ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) <> Тип("Массив") Тогда
		Если (ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот"))
			ИЛИ (ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) = Тип("ДокументОбъект.СМ_АктВыполненныхРабот")) Тогда
			МассивПозиций = ПолучитьМассивВсехПозиций(,МассивПозицийИлиПозицияИлиДокумент);	
		ИначеЕсли (ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"))
			ИЛИ (ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) = Тип("ДокументОбъект.СМ_ЛокальнаяСмета"))  Тогда
			МассивПозиций = ПолучитьМассивВсехПозиций(МассивПозицийИлиПозицияИлиДокумент);	
		Иначе
			МассивПозиций = ПодготовитьМассивОбъектов(МассивПозицийИлиПозицияИлиДокумент);
		КонецЕсли;
	Иначе
		МассивПозиций = МассивПозицийИлиПозицияИлиДокумент;
	КонецЕсли;
	
	Если МассивПозиций.Количество() = 0 Тогда
		
		Возврат;
		
	Иначе	  
		
		ТаблицаИндексов = СМ_СметаЗагрузкаВызовСервера.ЗагрузитьИндексыВТаблицу(ДанныеОбИндексах);
		
		Для Каждого Позиция Из МассивПозиций Цикл
			
			Если Позиция.НеПрименятьИндексы Тогда
				Продолжить;
			КонецЕсли;
			
			Отбор = Новый Структура();
			Отбор.Вставить("ШифрРасценки", Позиция.ШифрРасценки);
			Отбор.Вставить("ТипНормативногоСборника", Позиция.ТипНормативныхСборников);
			
			МассивИндексов = ТаблицаИндексов.НайтиСтроки(Отбор);
			
			Если АктВыполненныхРабот <> Неопределено Тогда
				Если ТипЗнч(АктВыполненныхРабот) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
					АктВыполненныхРаботОб = АктВыполненныхРабот.ПолучитьОбъект();
				Иначе
					АктВыполненныхРаботОб = АктВыполненныхРабот;
				КонецЕсли;
				СтрокаПозицииАкта = СтрокаПозицииАкта(АктВыполненныхРаботОб, Позиция, Ложь);	
				
				Если МассивИндексов.Количество() > 0 Тогда
					ЗаполнитьЗначенияСвойств(СтрокаПозицииАкта, МассивИндексов[0]);
					СтрокаПозицииАкта.ВариантПересчетаЭММ = ВариантПересчетаЭММ;
				ИначеЕсли Обнулять Тогда
					СтрокаПозицииАкта.КоэффОснЗарплаты = 0;
					СтрокаПозицииАкта.КоэффСтоимЭксплМашин = 0;
					СтрокаПозицииАкта.КоэффСтоимЗарплатеМашин = 0;
					СтрокаПозицииАкта.КоэффСтоимМатериалов = 0;
					СтрокаПозицииАкта.КоэффОборуд = 0;
					СтрокаПозицииАкта.КоэффПолнСтоимРабот = 0;
				КонецЕсли;
				
				Если ТипЗнч(АктВыполненныхРаботОб) = Тип("ДокументОбъект.СМ_АктВыполненныхРабот") Тогда
					АктВыполненныхРаботОб.Записать();
				КонецЕсли;
				
				Если Пересчитать Тогда
					Документы.СМ_АктВыполненныхРабот.Перерасчет(ПолучитьСсылкуНаДокумент(АктВыполненныхРабот, "СМ_АктВыполненныхРабот"), Ложь);
				КонецЕсли;
				
			Иначе
			
				Если МассивИндексов.Количество() > 0 Тогда
					ПозицияОб = Позиция.ПолучитьОбъект();
					ПозицияОб.КоэффициентыПересчета.Очистить();
					СтрТЧ = ПозицияОб.КоэффициентыПересчета.Добавить();
					ЗаполнитьЗначенияСвойств(СтрТЧ, МассивИндексов[0]);
					СтрТЧ.ВариантПересчетаЭММ = ВариантПересчетаЭММ;
					ПозицияОб.Записать();
					Если Пересчитать Тогда
						Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(Позиция, Ложь);
					КонецЕсли;
				ИначеЕсли Обнулять Тогда
					ПозицияОб = Позиция.ПолучитьОбъект();
					ПозицияОб.КоэффициентыПересчета.Очистить();
					ПозицияОб.Записать();
					Если Пересчитать Тогда
						Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(Позиция, Ложь);
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
		    
		КонецЦикла;		
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает таблицу значений с ценами аналогов ресурсов.
//
// Параметры:
//     Шифр 	 			- Строка - содержит шифр расценки.
//     СтруктураОписания 	- Структура - структура с параметрами отбора данных.
//
// Возвращаемое значение:
//      ТаблицаЗначений - результат запроса по ценам аналогов.
//
Функция ПолучитьЦенуАналогов(Шифр,СтруктураОписания) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЕСТЬNULL(ТекЦеныРесурсовСрезПоследних.СметнаяЦена, 0) КАК ТекущаяЦена,
	              |	ЕСТЬNULL(ТекЦеныРесурсовСрезПоследних.ЗарплМашинистов, 0) КАК ТекущаяЗарплатаМашинистов,
	              |	ТекЦеныРесурсовСрезПоследних.Ресурс
	              |ИЗ
	              |	РегистрСведений.СМ_СметныеЦеныРесурсов.СрезПоследних(
	              |			&ДатаТекЦен,
	              |			СметноНормативнаяБаза = &СНБ
	              |				И Район = &Район
	              |				И ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Текущая)
	              |				И Ресурс.Код В
	              |					(ВЫБРАТЬ
	              |						СМ_АналогиОбъектов.ШифрАналога
	              |					ИЗ
	              |						РегистрСведений.СМ_АналогиОбъектов КАК СМ_АналогиОбъектов
	              |					ГДЕ
	              |						СМ_АналогиОбъектов.ШифрОбъекта = &Шифр)) КАК ТекЦеныРесурсовСрезПоследних";
	Запрос.УстановитьПараметр("СНБ", СтруктураОписания.РегионДляВыбораЦен);
	Запрос.УстановитьПараметр("Район", СтруктураОписания.Район);
	Запрос.УстановитьПараметр("ДатаТекЦен", СтруктураОписания.ДатаТекущихЦен);
	Запрос.УстановитьПараметр("Шифр", Шифр);

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Загружает текущие цены на ресурсы в позиции локальной сметы ИЛИ акта.
//
// Параметры:
//     МассивПозицийИлиПозицияИлиДокумент 	- ДокументСсылка - один из типов:
//												* ссылка на позицию ИЛИ массив ссылок для выборки ресурсов.
//												* можно передать смету - тогда все позиции сметы.
//												* можно передать акт - тогда все позиции акта.
//     ДанныеОбИндексах 					- Строка - данные в виде строки в формате XML (из ВНБ).
//     Обнулять 							- Булево - обнулять ИЛИ нет значения, если не найдены.
//     Пересчитать 							- Булево - пересчитывать позиции ИЛИ нет.
//     АктВыполненныхРабот 					- ДокументСсылка.СМ_АктВыполненныхРабот	- ссылка на акт, если идет расчет акта.
//	   ОбновитьВерсию						- Булево - обновлять или нет версии позиций.
//	   ОбновитьБазисныеЦены                 - Булево - обновлять или нет базисные цены.
//	   БратьЦеныАналогов					- Булево - брать или нет цены аналогов. 
//
Процедура ЗагрузитьТекущиеЦеныВПозиции(МассивПозицийИлиПозицияИлиДокумент, ДанныеОбИндексах, Обнулять = Истина, Пересчитать = Ложь, АктВыполненныхРабот = Неопределено, ОбновитьВерсию = Ложь, ОбновитьБазисныеЦены = Ложь, БратьЦеныАналогов = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ДанныеОбИндексах) Тогда
		Возврат;
	КонецЕсли;
		
	Если ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) <> Тип("Массив") Тогда
		Если (ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот"))
			ИЛИ (ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) = Тип("ДокументОбъект.СМ_АктВыполненныхРабот")) Тогда
			МассивПозиций = ПолучитьМассивВсехПозиций(,МассивПозицийИлиПозицияИлиДокумент);	
		ИначеЕсли (ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"))
			ИЛИ (ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) = Тип("ДокументОбъект.СМ_ЛокальнаяСмета"))  Тогда
			МассивПозиций = ПолучитьМассивВсехПозиций(МассивПозицийИлиПозицияИлиДокумент);	
		Иначе
			МассивПозиций = ПодготовитьМассивОбъектов(МассивПозицийИлиПозицияИлиДокумент);
		КонецЕсли;
	Иначе
		МассивПозиций = МассивПозицийИлиПозицияИлиДокумент;
	КонецЕсли;
	
	Если МассивПозиций.Количество() = 0 Тогда
		
		Возврат;
		
	Иначе	  
		
		ТаблицаТЦ = СМ_СметаЗагрузкаВызовСервера.ЗагрузитьТекущиеЦеныВТаблицу(ДанныеОбИндексах);
		
		
		Если (ТаблицаТЦ.Количество() = 0) И (Не(Обнулять)) Тогда
			Возврат;
		КонецЕсли;
		
		
		ТаблицаЗакрытыхОбъемов = Неопределено;
		Если АктВыполненныхРабот = Неопределено Тогда
			РазделятьПозиции = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","РазделятьПозицииЗакрытыеАктами");
			РазделятьПозиции = ?(РазделятьПозиции = Неопределено,Ложь,РазделятьПозиции);
			РазрешитьРедактированиеЗакрытыхСмет = ЗначениеОпции("СМ_РазрешитьРедактированиеЗакрытыхСмет");
			ПроверкаОбъемВсего = (РазделятьПозиции И РазрешитьРедактированиеЗакрытыхСмет);
			
			Если ПроверкаОбъемВсего Тогда
				ТаблицаЗакрытыхОбъемов = ПолучитьЗакрытыеОбъемыПоМассивуПозиций(МассивПозиций);
			КонецЕсли;
		КонецЕсли;
		
		СтруктураПараметровЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(МассивПозиций[0].ИДСметы);
		
		Для Каждого Позиция Из МассивПозиций Цикл
			
			Если Не ТаблицаЗакрытыхОбъемов = Неопределено Тогда
				СтрокаОбъема = ТаблицаЗакрытыхОбъемов.Найти(Позиция);
				Если Не СтрокаОбъема = Неопределено Тогда
					
					Если Не СтрокаОбъема.ОбъемВсего = 0
						И СтрокаОбъема.ОбъемВсего<Позиция.ОбъемРабот Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Необходимо создать версию сметы: %1'"), ПолучитьТекстИнформацииОПозиции(Позиция)));
						Продолжить;
					ИначеЕсли Не СтрокаОбъема.ОбъемВсего = 0
						И СтрокаОбъема.ОбъемВсего>=Позиция.ОбъемРабот Тогда
					    Продолжить;
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
			Если Позиция.РесурсыПозицииЛокальнойСметы.Количество() = 0
				И (Позиция.Определитель.ВидРасценки =  Перечисления.СМ_ВидыРасценки.Материал
				ИЛИ Позиция.Определитель.ВидРасценки =  Перечисления.СМ_ВидыРасценки.Оборудование) Тогда
				// Позиция-ресурс.
				
				Если Позиция.НеИзменятьЦены Тогда
					Продолжить;
				КонецЕсли;

				Отбор = Новый Структура();
				Отбор.Вставить("ШифрРасценки", Позиция.ШифрРасценки);
				
				МассивИндексов = ТаблицаТЦ.НайтиСтроки(Отбор);
				
				Если МассивИндексов.Количество() = 0 И БратьЦеныАналогов Тогда
					ЦеныАналогов = ПолучитьЦенуАналогов(Позиция.ШифрРасценки,СтруктураПараметровЛС);
					Если ЦеныАналогов.Количество()>0 Тогда
						МассивИндексов = Новый Массив;
						МассивИндексов.Добавить(ЦеныАналогов[0]);
					КонецЕсли;
				КонецЕсли;
				
				Если АктВыполненныхРабот <> Неопределено Тогда
					Если ТипЗнч(АктВыполненныхРабот) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
						АктВыполненныхРаботОб = АктВыполненныхРабот.ПолучитьОбъект();
					Иначе
						АктВыполненныхРаботОб = АктВыполненныхРабот;
					КонецЕсли;
					
					СтрокаПозицииАкта = СтрокаПозицииАкта(АктВыполненныхРаботОб, Позиция, Ложь);	
					
					Если МассивИндексов.Количество() > 0 Тогда
						СтрокаПозицииАкта.ТекущаяЦена = МассивИндексов[0].ТекущаяЦена;
						Если (Позиция.ТипНормативныхСборников <> Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы) Тогда
							СтрокаПозицииАкта.ТекущаяЗарплатаМашинистов = МассивИндексов[0].ТекущаяЗарплатаМашинистов;
						Иначе
							СтрокаПозицииАкта.ТекущаяЗарплатаМашинистов = 0;
						КонецЕсли;
					ИначеЕсли Обнулять Тогда
						СтрокаПозицииАкта.ТекущаяЦена = 0;
						СтрокаПозицииАкта.ТекущаяЗарплатаМашинистов = 0;
					КонецЕсли;
					
					Если ТипЗнч(АктВыполненныхРаботОб) = Тип("ДокументОбъект.СМ_АктВыполненныхРабот") Тогда
						АктВыполненныхРаботОб.Записать();
					КонецЕсли;
					
					Если Пересчитать Тогда
						Документы.СМ_АктВыполненныхРабот.Перерасчет(ПолучитьСсылкуНаДокумент(АктВыполненныхРабот, "СМ_АктВыполненныхРабот"), Ложь);
					КонецЕсли;
					
				Иначе
			
					Если МассивИндексов.Количество() > 0 Тогда
						ПозицияОб = Позиция.ПолучитьОбъект();
						Если ОбновитьВерсию Тогда
							СМ_СметаВызовСервера.ЗаполнитьВерсиюПозиции(ПозицияОб);
						КонецЕсли;
						ПозицияОб.ТекущаяЦена = МассивИндексов[0].ТекущаяЦена;
						Если (ПозицияОб.ТипНормативныхСборников <> Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы) Тогда
							ПозицияОб.ТекущаяЗарплатаМашинистов = МассивИндексов[0].ТекущаяЗарплатаМашинистов;
						Иначе
							ПозицияОб.ТекущаяЗарплатаМашинистов = 0;
						КонецЕсли;
						ПозицияОб.Записать();
						Если Пересчитать Тогда
							Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(Позиция, Ложь);
						КонецЕсли;
					ИначеЕсли Обнулять Тогда
						ПозицияОб = Позиция.ПолучитьОбъект();
						ПозицияОб.ТекущаяЦена = 0;
						ПозицияОб.ТекущаяЗарплатаМашинистов = 0;
						ПозицияОб.Записать();
						Если Пересчитать Тогда
							Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(Позиция, Ложь);
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе                 			
				
				// Позиция - работа.
				
				Если АктВыполненныхРабот <> Неопределено Тогда
					Если ТипЗнч(АктВыполненныхРабот) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
						АктВыполненныхРаботОб = АктВыполненныхРабот.ПолучитьОбъект();
					Иначе
						АктВыполненныхРаботОб = АктВыполненныхРабот;
					КонецЕсли;
					
					МассивРесурсов = МассивСтрокРесурсовПозицииАкта(АктВыполненныхРаботОб, Позиция);	
					
					Если МассивРесурсов.Количество() > 0 Тогда
						Для Каждого СтрокаПозицииАкта Из МассивРесурсов Цикл
							Если СтрокаПозицииАкта.НеИзменятьЦены Тогда
								Продолжить;
							КонецЕсли;

							Отбор = Новый Структура();
							Отбор.Вставить("ШифрРасценки", СтрокаПозицииАкта.СметныйКодРесурса);
				
							МассивИндексов = ТаблицаТЦ.НайтиСтроки(Отбор);
							
							Если МассивИндексов.Количество() = 0 И БратьЦеныАналогов Тогда
								ЦеныАналогов = ПолучитьЦенуАналогов(СтрокаПозицииАкта.СметныйКодРесурса,СтруктураПараметровЛС);
								Если ЦеныАналогов.Количество()>0 Тогда
									МассивИндексов = Новый Массив;
									МассивИндексов.Добавить(ЦеныАналогов[0]);
								КонецЕсли;
							КонецЕсли;

							Если МассивИндексов.Количество() > 0 Тогда
								СтрокаПозицииАкта.ТекущаяЦена = МассивИндексов[0].ТекущаяЦена;
								Если СтрокаПозицииАкта.Ресурс.ВидРесурса <> Перечисления.СМ_ВидыРесурсов.Материалы Тогда
									СтрокаПозицииАкта.ТекущаяЗарплатаМашинистов = МассивИндексов[0].ТекущаяЗарплатаМашинистов;
								Иначе
									СтрокаПозицииАкта.ТекущаяЗарплатаМашинистов = 0;
								КонецЕсли;
							ИначеЕсли Обнулять Тогда
								СтрокаПозицииАкта.ТекущаяЦена = 0;
								СтрокаПозицииАкта.ТекущаяЗарплатаМашинистов = 0;
							КонецЕсли;
							
						КонецЦикла;
					КонецЕсли;
					
					Если ТипЗнч(АктВыполненныхРаботОб) = Тип("ДокументОбъект.СМ_АктВыполненныхРабот") Тогда
						АктВыполненныхРаботОб.Записать();
					КонецЕсли;
					
					Если Пересчитать Тогда
						Документы.СМ_АктВыполненныхРабот.Перерасчет(ПолучитьСсылкуНаДокумент(АктВыполненныхРабот, "СМ_АктВыполненныхРабот"), Ложь);
					КонецЕсли;
					
				Иначе
					ПозицияОб = Позиция.ПолучитьОбъект();
					Для Каждого СтрокаПозиции Из ПозицияОб.РесурсыПозицииЛокальнойСметы Цикл
						
						Если СтрокаПозиции.НеИзменятьЦены Тогда
							Продолжить;
						КонецЕсли;
						
						Отбор = Новый Структура();
						Отбор.Вставить("ШифрРасценки", СтрокаПозиции.СметныйКодРесурса);
			
						МассивИндексов = ТаблицаТЦ.НайтиСтроки(Отбор);
						
						Если МассивИндексов.Количество() = 0 И БратьЦеныАналогов Тогда
							ЦеныАналогов = ПолучитьЦенуАналогов(СтрокаПозиции.СметныйКодРесурса,СтруктураПараметровЛС);
							Если ЦеныАналогов.Количество()>0 Тогда
								МассивИндексов = Новый Массив;
								МассивИндексов.Добавить(ЦеныАналогов[0]);
							КонецЕсли;
						КонецЕсли;
							
						Если МассивИндексов.Количество() > 0 Тогда
							СтрокаПозиции.ТекущаяЦена = МассивИндексов[0].ТекущаяЦена;
							Если СтрокаПозиции.Ресурс.ВидРесурса <> Перечисления.СМ_ВидыРесурсов.Материалы Тогда
								СтрокаПозиции.ТекущаяЗарплатаМашинистов = МассивИндексов[0].ТекущаяЗарплатаМашинистов;
							Иначе
								СтрокаПозиции.ТекущаяЗарплатаМашинистов = 0;
							КонецЕсли;
						ИначеЕсли Обнулять Тогда
							СтрокаПозиции.ТекущаяЦена = 0;
							СтрокаПозиции.ТекущаяЗарплатаМашинистов = 0;
						КонецЕсли;
						
					КонецЦикла;
					
					Если ОбновитьБазисныеЦены Тогда
						ТаблицаРесурсовПозиций = ПолучитьСписокВсехРесурсовПозиций(Позиция,,Истина); 
						ТаблицаЦен = ПолучитьТаблицуЦенРесурсов(ТаблицаРесурсовПозиций,Ложь,ТекущаяДатаСеанса(),Позиция.ИдСметы.Район,,Неопределено);
						Для Каждого Рес Из ПозицияОб.РесурсыПозицииЛокальнойСметы Цикл
							Если СтрокаПозиции.НеИзменятьЦены Тогда
								Продолжить;
							КонецЕсли;
							ОтборЦен = Новый Структура();
							ОтборЦен.Вставить("Ресурс", Рес.Ресурс);
							МассивЦен = ТаблицаЦен.НайтиСтроки(ОтборЦен);
							Если МассивЦен.Количество() > 0 Тогда
								Рес.БазиснаяЦена      = ?(МассивЦен[0].БазиснаяЦена = 0,Рес.БазиснаяЦена,МассивЦен[0].БазиснаяЦена);
								Рес.БазиснаяЗарплатаМашинистов = ?(МассивЦен[0].БазиснаяЗарплатаМашинистов = 0,Рес.БазиснаяЗарплатаМашинистов,МассивЦен[0].БазиснаяЗарплатаМашинистов);
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
					
					ПозицияОб.Записать();
					Если Пересчитать Тогда
						Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(Позиция, Ложь);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
		    
		КонецЦикла;		
		
	КонецЕсли;
	
КонецПроцедуры

// Загружает текущие цены на ресурсы в позиции локальной сметы ИЛИ акта из регистра.
//
// Параметры:
//     МассивПозицийИлиПозицияИлиДокумент 	- ДокументСсылка - один из типов:
//												* ссылка на позицию ИЛИ массив ссылок для выборки ресурсов.
//												* можно передать смету - тогда все позиции сметы.
//												* можно передать акт - тогда все позиции акта.
//     Обнулять 							- Булево - обнулять ИЛИ нет значения, если не найдены.
//     Пересчитать 							- Булево - пересчитывать позиции ИЛИ нет.
//     АктВыполненныхРабот 					- ДокументСсылка.СМ_АктВыполненныхРабот	- ссылка на акт, если идет расчет акта.
//	   ОбновитьВерсию						- Булево - обновлять или нет версии позиций.
//	   БратьЦеныАналогов					- Булево - брать или нет цены аналогов. 
//
Процедура ЗагрузитьТекущиеЦеныВПозицииИзРегистра(МассивПозицийИлиПозицияИлиДокумент, Обнулять = Истина, Пересчитать = Ложь, АктВыполненныхРабот = Неопределено, ОбновитьВерсию = Ложь, БратьЦеныАналогов = Ложь) Экспорт
	
	
	Если ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) <> Тип("Массив") Тогда
		Если (ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот"))
			ИЛИ (ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) = Тип("ДокументОбъект.СМ_АктВыполненныхРабот")) Тогда
			МассивПозиций = ПолучитьМассивВсехПозиций(,МассивПозицийИлиПозицияИлиДокумент);	
		ИначеЕсли (ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"))
			ИЛИ (ТипЗнч(МассивПозицийИлиПозицияИлиДокумент) = Тип("ДокументОбъект.СМ_ЛокальнаяСмета"))  Тогда
			МассивПозиций = ПолучитьМассивВсехПозиций(МассивПозицийИлиПозицияИлиДокумент);	
		Иначе
			МассивПозиций = ПодготовитьМассивОбъектов(МассивПозицийИлиПозицияИлиДокумент);
		КонецЕсли;
	Иначе
		МассивПозиций = МассивПозицийИлиПозицияИлиДокумент;
	КонецЕсли;
	
	Если МассивПозиций.Количество() = 0 Тогда
		
		Возврат;
		
	Иначе	  
		
		ТаблицаЗакрытыхОбъемов = Неопределено;
		Если АктВыполненныхРабот = Неопределено Тогда
			РазделятьПозиции = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","РазделятьПозицииЗакрытыеАктами");
			РазделятьПозиции = ?(РазделятьПозиции = Неопределено,Ложь,РазделятьПозиции);
			РазрешитьРедактированиеЗакрытыхСмет = ЗначениеОпции("СМ_РазрешитьРедактированиеЗакрытыхСмет");
			ПроверкаОбъемВсего = (РазделятьПозиции И РазрешитьРедактированиеЗакрытыхСмет);
			
			Если ПроверкаОбъемВсего Тогда
				ТаблицаЗакрытыхОбъемов = ПолучитьЗакрытыеОбъемыПоМассивуПозиций(МассивПозиций);
			КонецЕсли;
		КонецЕсли;

		
		Для Каждого Позиция Из МассивПозиций Цикл
			СтруктураПараметровЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(Позиция.ИДСметы);
			ДатаТекущихЦен = СтруктураПараметровЛС.ДатаТекущихЦен;
			СтруктураЦен = Новый Структура();
			СтруктураЦен.Вставить("БазиснаяЦена",0);
			СтруктураЦен.Вставить("БазиснаяЗарплатаМашинистов",0);
			СтруктураЦен.Вставить("ТекущаяЦена",0);
			СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов",0);
			
			ТекРесурс = НайтиРесурсПоКоду(ЗаполнитьСтруктуруПоискаРесурсаПоПозиции(Позиция));
			Если ЗначениеЗаполнено(ТекРесурс) Тогда
				ПолучитьЦеныНовогоРесурса(ТекРесурс,Позиция.ИДСметы.Район,Позиция.ИДСметы.РегионДляВыбораЦен,ДатаТекущихЦен,СтруктураЦен,Истина);
			КонецЕсли;
			
			Если БратьЦеныАналогов 
				И СтруктураЦен.ТекущаяЦена = 0 
				И СтруктураЦен.ТекущаяЗарплатаМашинистов = 0 Тогда
				ЦеныАналогов = ПолучитьЦенуАналогов(Позиция.ШифрРасценки,СтруктураПараметровЛС);
				Если ЦеныАналогов.Количество()>0 Тогда
					СтруктураЦен.ТекущаяЦена = ЦеныАналогов[0].ТекущаяЦена;
					СтруктураЦен.ТекущаяЗарплатаМашинистов = ЦеныАналогов[0].ТекущаяЗарплатаМашинистов;
				КонецЕсли;
			КонецЕсли;

			Если Не ТаблицаЗакрытыхОбъемов = Неопределено Тогда
				СтрокаОбъема = ТаблицаЗакрытыхОбъемов.Найти(Позиция);
				Если Не СтрокаОбъема = Неопределено Тогда
					
					Если Не СтрокаОбъема.ОбъемВсего = 0
						И СтрокаОбъема.ОбъемВсего<Позиция.ОбъемРабот Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Необходимо создать версию сметы: %1'"), ПолучитьТекстИнформацииОПозиции(Позиция)));
						Продолжить;
					ИначеЕсли Не СтрокаОбъема.ОбъемВсего = 0
						И СтрокаОбъема.ОбъемВсего>=Позиция.ОбъемРабот Тогда
						Продолжить;
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;

			Если Позиция.РесурсыПозицииЛокальнойСметы.Количество() = 0
				И (Позиция.Определитель.ВидРасценки =  Перечисления.СМ_ВидыРасценки.Материал
				ИЛИ Позиция.Определитель.ВидРасценки =  Перечисления.СМ_ВидыРасценки.Оборудование) Тогда
				// Позиция-ресурс.
				
				Если Позиция.НеИзменятьЦены Тогда
					Продолжить;
				КонецЕсли;
					
				Если АктВыполненныхРабот <> Неопределено Тогда
					Если ТипЗнч(АктВыполненныхРабот) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
						АктВыполненныхРаботОб = АктВыполненныхРабот.ПолучитьОбъект();
					Иначе
						АктВыполненныхРаботОб = АктВыполненныхРабот;
					КонецЕсли;
					
					СтрокаПозицииАкта = СтрокаПозицииАкта(АктВыполненныхРаботОб, Позиция, Ложь);	
					
					СтрокаПозицииАкта.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
					Если (Позиция.ТипНормативныхСборников <> Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы) Тогда
						СтрокаПозицииАкта.ТекущаяЗарплатаМашинистов = СтруктураЦен.ТекущаяЗарплатаМашинистов;
					Иначе
						СтрокаПозицииАкта.ТекущаяЗарплатаМашинистов = 0;
					КонецЕсли;
					
					Если ТипЗнч(АктВыполненныхРаботОб) = Тип("ДокументОбъект.СМ_АктВыполненныхРабот") Тогда
						АктВыполненныхРаботОб.Записать();
					КонецЕсли;
					
					Если Пересчитать Тогда
						Документы.СМ_АктВыполненныхРабот.Перерасчет(ПолучитьСсылкуНаДокумент(АктВыполненныхРабот, "СМ_АктВыполненныхРабот"), Ложь);
					КонецЕсли;
					
				Иначе
					
					ПозицияОб = Позиция.ПолучитьОбъект();
					Если ОбновитьВерсию Тогда
						СМ_СметаВызовСервера.ЗаполнитьВерсиюПозиции(ПозицияОб);
					КонецЕсли;
					ПозицияОб.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
					Если (ПозицияОб.ТипНормативныхСборников <> Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы) Тогда
						ПозицияОб.ТекущаяЗарплатаМашинистов = СтруктураЦен.ТекущаяЗарплатаМашинистов;
					Иначе
						ПозицияОб.ТекущаяЗарплатаМашинистов = 0;
					КонецЕсли;
					ПозицияОб.Записать();
					Если Пересчитать Тогда
						Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(Позиция, Ложь);
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе                 			
				
				// Позиция - работа.
				
				Если АктВыполненныхРабот <> Неопределено Тогда
					Если ТипЗнч(АктВыполненныхРабот) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
						АктВыполненныхРаботОб = АктВыполненныхРабот.ПолучитьОбъект();
					Иначе
						АктВыполненныхРаботОб = АктВыполненныхРабот;
					КонецЕсли;
					
					МассивРесурсов = МассивСтрокРесурсовПозицииАкта(АктВыполненныхРаботОб, Позиция);	
					
					Если МассивРесурсов.Количество() > 0 Тогда
						Для Каждого СтрокаПозицииАкта Из МассивРесурсов Цикл
							Если СтрокаПозицииАкта.НеИзменятьЦены Тогда
								Продолжить;
							КонецЕсли;
							
							ТекРесурс = ?(ЗначениеЗаполнено(СтрокаПозицииАкта.СметныйКодРесурса),НайтиРесурсПоКоду(СтрокаПозицииАкта), СтрокаПозицииАкта.Ресурс);
							ПолучитьЦеныНовогоРесурса(ТекРесурс,Позиция.ИДСметы.Район,Позиция.ИДСметы.РегионДляВыбораЦен,ДатаТекущихЦен,СтруктураЦен,Истина);
							
							Если БратьЦеныАналогов 
								И СтруктураЦен.ТекущаяЦена = 0 
								И СтруктураЦен.ТекущаяЗарплатаМашинистов = 0 Тогда
								ЦеныАналогов = ПолучитьЦенуАналогов(?(ЗначениеЗаполнено(СтрокаПозицииАкта.СметныйКодРесурса),СтрокаПозицииАкта.СметныйКодРесурса, СтрокаПозицииАкта.Ресурс.Код),СтруктураПараметровЛС);
								Если ЦеныАналогов.Количество()>0 Тогда
									СтруктураЦен.ТекущаяЦена = ЦеныАналогов[0].ТекущаяЦена;
									СтруктураЦен.ТекущаяЗарплатаМашинистов = ЦеныАналогов[0].ТекущаяЗарплатаМашинистов;
								КонецЕсли;
							КонецЕсли;

							СтрокаПозицииАкта.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
							Если СтрокаПозицииАкта.Ресурс.ВидРесурса <> Перечисления.СМ_ВидыРесурсов.Материалы Тогда
								СтрокаПозицииАкта.ТекущаяЗарплатаМашинистов = СтруктураЦен.ТекущаяЗарплатаМашинистов;
							Иначе
								СтрокаПозицииАкта.ТекущаяЗарплатаМашинистов = 0;
							КонецЕсли;
							
						КонецЦикла;
					КонецЕсли;
					
					Если ТипЗнч(АктВыполненныхРаботОб) = Тип("ДокументОбъект.СМ_АктВыполненныхРабот") Тогда
						АктВыполненныхРаботОб.Записать();
					КонецЕсли;
					
					Если Пересчитать Тогда
						Документы.СМ_АктВыполненныхРабот.Перерасчет(ПолучитьСсылкуНаДокумент(АктВыполненныхРабот, "СМ_АктВыполненныхРабот"), Ложь);
					КонецЕсли;
					
				Иначе
					ПозицияОб = Позиция.ПолучитьОбъект();
					Для Каждого СтрокаПозиции Из ПозицияОб.РесурсыПозицииЛокальнойСметы Цикл
						Если СтрокаПозиции.НеИзменятьЦены Тогда
							Продолжить;
						КонецЕсли;

						ТекРесурс = ?(ЗначениеЗаполнено(СтрокаПозиции.СметныйКодРесурса),НайтиРесурсПоКоду(СтрокаПозиции), СтрокаПозиции.Ресурс);
						ПолучитьЦеныНовогоРесурса(ТекРесурс,Позиция.ИДСметы.Район,Позиция.ИДСметы.РегионДляВыбораЦен,ДатаТекущихЦен,СтруктураЦен,Истина);						
						
						Если БратьЦеныАналогов 
							И СтруктураЦен.ТекущаяЦена = 0 
							И СтруктураЦен.ТекущаяЗарплатаМашинистов = 0 Тогда
							ЦеныАналогов = ПолучитьЦенуАналогов(?(ЗначениеЗаполнено(СтрокаПозиции.СметныйКодРесурса),СтрокаПозиции.СметныйКодРесурса, СтрокаПозиции.Ресурс.Код),СтруктураПараметровЛС);
							Если ЦеныАналогов.Количество()>0 Тогда
								СтруктураЦен.ТекущаяЦена = ЦеныАналогов[0].ТекущаяЦена;
								СтруктураЦен.ТекущаяЗарплатаМашинистов = ЦеныАналогов[0].ТекущаяЗарплатаМашинистов;
							КонецЕсли;
						КонецЕсли;
						
						СтрокаПозиции.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
						Если СтрокаПозиции.Ресурс.ВидРесурса <> Перечисления.СМ_ВидыРесурсов.Материалы Тогда
							СтрокаПозиции.ТекущаяЗарплатаМашинистов = СтруктураЦен.ТекущаяЗарплатаМашинистов;
						Иначе
							СтрокаПозиции.ТекущаяЗарплатаМашинистов = 0;
						КонецЕсли;
						
					КонецЦикла;
					
					ПозицияОб.Записать();
					Если Пересчитать Тогда
						Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(Позиция, Ложь);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
		    
		КонецЦикла;		
		
	КонецЕсли;
	
КонецПроцедуры

// Поиск в справочнике ресурсов для ТСН.
//
Функция НайтиРесурсПоКодуОКП(КодОКП, НаименованиеРесурса, ЕдиницаИзмеренияРесурса, НаименованиеСправочника = "СМ_Ресурсы", Родитель = Неопределено)
	
	Ресурс = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		               |	СправочникСмета.Ссылка КАК Ресурс
	    	           |ИЗ
	        	       |	Справочник."+НаименованиеСправочника+" КАК СправочникСмета
	            	   |ГДЕ
		               |	СправочникСмета.КодОКП = &СметныйКод И СправочникСмета.Наименование = &Наименование 
					   |	И СправочникСмета.ЕдиницаИзмерения.Наименование = &ЕдИзм И СправочникСмета.ЭтоГруппа = ЛОЖЬ";
				   
	       
	Запрос.УстановитьПараметр("СметныйКод",КодОКП);
	Запрос.УстановитьПараметр("Наименование",НаименованиеРесурса);
	Запрос.УстановитьПараметр("ЕдИзм",ЕдиницаИзмеренияРесурса);
	Если Родитель <> Неопределено Тогда
		Запрос.УстановитьПараметр("Родитель",Родитель);
		Запрос.Текст = Запрос.Текст + " И СправочникСмета.Родитель = &Родитель";
	КонецЕсли;
	
	РесурсыДанные = Запрос.Выполнить().Выбрать();
	Если РесурсыДанные.Следующий() Тогда
		Ресурс = РесурсыДанные.Ресурс;
	КонецЕсли; 
	Если РесурсыДанные.Количество() > 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Нарушен регистр сметных реквизитов ТСН справочника %1!!!'"), НаименованиеСправочника));	
	КонецЕсли;
	
	Возврат(Ресурс);
	
КонецФункции

// Получает ссылку на ресурс в справочнике.
//
// Параметры:
//     ЗначенияРеквизитов - Структура - содержит поля: 
//								* СметныйКодРесурса - Строка - код ресурса.
//								* КодОКП - Строка - код ресурса по общероссийскому классификатору продукции.
//								* НаименованиеРесурса - Строка - название ресурса.
//								* ЕдиницаИзмеренияРесурса - СправочникСсылка.СМ_ЕдиницыИзмеренияСмета - единица измерения ресурса.
//     Родитель - СправочникСсылка - родитель элемента 
//				  (задается, если искать в пределах иерархии).
//	   НаименованиеСправочника - Строка - название справочника в котором идет поиск.  
//                        
// Возвращаемое значение:
//     ТекРесурс - СправочникСсылка - Найденный элемент, если не найден, то неопределено.
//
Функция НайтиРесурсПоКоду(ЗначенияРеквизитов, Родитель = Неопределено, НаименованиеСправочника = "СМ_Ресурсы") Экспорт
	
	// В справочнике Ресурсы определяется ресурс по шифру расценки.
	ТекРесурс = Неопределено;
	Если ЗначениеЗаполнено(ЗначенияРеквизитов.СметныйКодРесурса) Тогда
		КодРесурса = СокрЛП(ЗначенияРеквизитов.СметныйКодРесурса);
		// Используем прямой поиск по коду вместо НайтиРесурсПоСметномуКоду(..).
		ТекРесурс = Справочники[НаименованиеСправочника].НайтиПоКоду(КодРесурса);
	Иначе
		ТекРесурс = НайтиРесурсПоКодуОКП(ЗначенияРеквизитов.КодОКП, ЗначенияРеквизитов.НаименованиеРесурса, ЗначенияРеквизитов.ЕдиницаИзмеренияРесурса, НаименованиеСправочника, Родитель);
    КонецЕсли;
		
	Возврат(ТекРесурс);	
	
КонецФункции

// Получает структуру для поиска ресурса по позиции.
//
// Параметры:
//     Позиция - ДокументСсылка.СМ_ПозицияЛокальнойСметы - ссылка на позицию локальной сметы.
//                        
// Возвращаемое значение:
//     Структура - содержит значения реквизитов ресурса для использования в НайтиРесурсПоКоду().
//
Функция ЗаполнитьСтруктуруПоискаРесурсаПоПозиции(Позиция) Экспорт
	
	// В справочнике Ресурсы определяется ресурс по шифру расценки.
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("СметныйКодРесурса", Позиция.ШифрРасценки);	
	СтруктураПоиска.Вставить("КодОКП", Позиция.ШифрРасценки);
	СтруктураПоиска.Вставить("НаименованиеРесурса", Позиция.Наименование);
	СтруктураПоиска.Вставить("ЕдиницаИзмеренияРесурса", Позиция.ЕдиницаИзмерения.Наименование);
	
	Возврат(СтруктураПоиска);	
	
КонецФункции

// Проверка уникальности ресурса в справочнике.
//
// Параметры:
//     Ресурс	- СправочникСсылка, СправочникОбъект - элемент справочника Ресурсы.
//     Родитель - СправочникСсылка - родитель элемента (задается, если искать в пределах иерархии).
//                        
// Возвращаемое значение:
//     Булево - Истина - проверка пройдена (элемент имеет уникальное значение реквизита), иначе - Ложь.
//
Функция РесурсУникален(Ресурс, Родитель = Неопределено) Экспорт
	
	ШифрРесурса = Ресурс.Код;
	Если ЗначениеЗаполнено(ШифрРесурса) Тогда
		// Не общий ресурс.
		Возврат КонтрольУникальности("СМ_Ресурсы", "Код", ШифрРесурса, Ресурс.Ссылка, Родитель);
	Иначе
		// Общий ресурс. Контроль по коду ОКП + Наименованию + Единице измерения.
		ШифрРесурса = Ресурс.КодОКП;	
		НаименованиеРесурса = Ресурс.Наименование;
		ЕдиницаИзмеренияРесурса = Ресурс.ЕдиницаИзмерения;
		
		ЭлементВБазе = НайтиРесурсПоКодуОКП(ШифрРесурса, НаименованиеРесурса, ЕдиницаИзмеренияРесурса, "СМ_Ресурсы", Родитель);
		Возврат ((ЭлементВБазе = Справочники.СМ_Ресурсы.ПустаяСсылка()) ИЛИ (ЭлементВБазе = Ресурс.Ссылка) ИЛИ (ЭлементВБазе = Неопределено)); 	
		
	КонецЕсли;
	
КонецФункции

// Ищет ресурс по началу наименования.
//
// Параметры:
//      Наименование - Строка - наименование ресурса для поиска.
//
// Возвращаемое значение:
// 		Массив - содержит ссылки на ресурсы.
//
Функция ПолучитьСписокРесурсовПоСтроке(Наименование) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_Ресурсы.Ссылка
	               |ИЗ
	               |	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
	               |ГДЕ
	               |	СМ_Ресурсы.ЭтоГруппа = ЛОЖЬ
	               |	И СМ_Ресурсы.ПометкаУдаления = ЛОЖЬ
	               |	И СМ_Ресурсы.Наименование ПОДОБНО &Наименование
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СМ_Ресурсы.Наименование";
	Запрос.УстановитьПараметр("Наименование",Наименование+"%");
    Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

// Устанавливает выбранный цвет позиции.
//
// Параметры:
//     ИмяКоманды 		- Строка - имя команды для идентификации цвета.
//     Позиция    		- ДокументСсылка.СМ_ПозицияЛокальнойСметы - обрабатываемая позиция.
//	   ОтмеченаВДереве 	- Число - отвечает за обозначение цвета выделенной строки.
//
Процедура РаскраситьПозициюСервер(ИмяКоманды,Позиция,ОтмеченаВДереве) Экспорт
	
	Если СтрНайти(Врег(ИмяКоманды),ВРег("Черный")) > 0 Тогда
		ОтмеченаВДереве = 0;
	ИначеЕсли СтрНайти(Врег(ИмяКоманды),ВРег("Белый")) > 0 Тогда
		ОтмеченаВДереве = 1;	
	ИначеЕсли СтрНайти(Врег(ИмяКоманды),ВРег("Синий")) > 0 Тогда
		ОтмеченаВДереве = 2;	
	ИначеЕсли СтрНайти(Врег(ИмяКоманды),ВРег("Желтый")) > 0 Тогда
		ОтмеченаВДереве = 3;	
	ИначеЕсли СтрНайти(Врег(ИмяКоманды),ВРег("Зеленый")) > 0 Тогда
		ОтмеченаВДереве = 4;	
	ИначеЕсли СтрНайти(Врег(ИмяКоманды),ВРег("Красный")) > 0 Тогда
		ОтмеченаВДереве = 5;	
	ИначеЕсли СтрНайти(Врег(ИмяКоманды),ВРег("Фиолетовый")) > 0 Тогда
		ОтмеченаВДереве = 6;	
	КонецЕсли;

	ПозицияОб 						= Позиция.ПолучитьОбъект();
	ПозицияОб.ОтмеченаВДереве 		= ОтмеченаВДереве;
	ПозицияОб.ОбменДанными.Загрузка = Истина;
	ПозицияОб.Записать();
	
КонецПроцедуры

// Устанавливает выбранный цвет позиции в акте.
//
// Параметры:
//	   ТабПозиций		- ТаблицаЗначений - содержит позиции акта.
//     ИмяКоманды 		- Строка - имя команды для идентификации цвета.
//     Позиция    		- ДокументСсылка.СМ_ПозицияЛокальнойСметы - обрабатываемая позиция.
//	   ОтмеченаВДереве 	- Число - отвечает за обозначение цвета выделенной строки.
//
Процедура РаскраситьПозициюАкта(ТабПозиций,ИмяКоманды,Позиция,ОтмеченаВДереве) Экспорт
	
	ОтмеченаВДереве = 0;
	Если СтрНайти(Врег(ИмяКоманды),ВРег("Черный")) > 0 Тогда
		ОтмеченаВДереве = 0;
	ИначеЕсли СтрНайти(Врег(ИмяКоманды),ВРег("Белый")) > 0 Тогда
		ОтмеченаВДереве = 1;	
	ИначеЕсли СтрНайти(Врег(ИмяКоманды),ВРег("Синий")) > 0 Тогда
		ОтмеченаВДереве = 2;	
	ИначеЕсли СтрНайти(Врег(ИмяКоманды),ВРег("Желтый")) > 0 Тогда
		ОтмеченаВДереве = 3;	
	ИначеЕсли СтрНайти(Врег(ИмяКоманды),ВРег("Зеленый")) > 0 Тогда
		ОтмеченаВДереве = 4;	
	ИначеЕсли СтрНайти(Врег(ИмяКоманды),ВРег("Красный")) > 0 Тогда
		ОтмеченаВДереве = 5;	
	ИначеЕсли СтрНайти(Врег(ИмяКоманды),ВРег("Фиолетовый")) > 0 Тогда
		ОтмеченаВДереве = 6;	
	КонецЕсли;

	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Позиция",Позиция);
	МассивСтрок = ТабПозиций.НайтиСтроки(СтруктураОтбора);
	Для Каждого ТекСтрока Из МассивСтрок Цикл
		ТекСтрока.ОтмеченаВАкте = ОтмеченаВДереве;	
	КонецЦикла;
	
КонецПроцедуры

// Проверяет есть ли привязанные позиции.
//
// Параметры:
//     Владелец - ДокументСсылка.СМ_ПозицияЛокальнойСметы - позиция-владелец для поиска.
//
// Возвращаемое значение:
// 		Булево - Истина - есть привязанные позиции, Ложь - нет привязанных позиций.
//
Функция ЕстьПривязанныеПозиции(Владелец) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ПозицияЛокальнойСметы.Ссылка
	|ИЗ
	|	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	|ГДЕ
	|	ПозицияЛокальнойСметы.ИДПозицииВладельца = &ИДПозицииВладельца";
	
	Запрос.УстановитьПараметр("ИДПозицииВладельца",Владелец);
	Результат = Запрос.Выполнить();
	
	Возврат Не Результат.Пустой();
	
КонецФункции

// Возвращает привязанные позиции.
//
// Параметры:
//     Владелец - ДокументСсылка.СМ_ПозицияЛокальнойСметы - позиция-владелец для поиска.
//
// Возвращаемое значение:
// 		Результат - ТаблицаЗначений - таблица содержащая данные привязанных позиций.
//
Функция ПолучитьПривязанныеПозиции(Владелец) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер,
	               |	СМ_НумерацияПозицийЛокальныхСмет.Позиция
	               |ПОМЕСТИТЬ ВТНомера
	               |ИЗ
	               |	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |ГДЕ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Смета = &Смета
	               |	И СМ_НумерацияПозицийЛокальныхСмет.Позиция.ИДПозицииВладельца = &ИДПозицииВладельца
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПозицияЛокальнойСметы.Ссылка,
	               |	ЕСТЬNULL(ВТНомера.ПорНомер, 0) КАК Номер
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТНомера КАК ВТНомера
	               |		ПО ПозицияЛокальнойСметы.Ссылка = ВТНомера.Позиция
	               |ГДЕ
	               |	ПозицияЛокальнойСметы.ИДПозицииВладельца = &ИДПозицииВладельца
	               |	И НЕ ПозицияЛокальнойСметы.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номер";
	
	Запрос.УстановитьПараметр("ИДПозицииВладельца",Владелец);
	Запрос.УстановитьПараметр("Смета",Владелец.ИДСметы);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

// Устанавливает статус "Согласовано" документам.
//
// Параметры:
//    МассивДокументов - Массив - массив документов.
//
Процедура УстановитьСтатусСогласовано(МассивДокументов = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	СМ_ЛокальнаяСмета.Ссылка
	               |ИЗ
	               |	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СМ_СводнаяСмета.Ссылка
	               |ИЗ
	               |	Документ.СМ_СводнаяСмета КАК СМ_СводнаяСмета
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СМ_ОбъектнаяСмета.Ссылка
	               |ИЗ
	               |	Документ.СМ_ОбъектнаяСмета КАК СМ_ОбъектнаяСмета
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СМ_АктВыполненныхРабот.Ссылка
	               |ИЗ
	               |	Документ.СМ_АктВыполненныхРабот КАК СМ_АктВыполненныхРабот";
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Истина);
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокОбъект.Статус = Перечисления.СМ_СтатусыСметныхДокументов.Проект;
		ДокОбъект.ОбменДанными.Загрузка = Истина;
		ДокОбъект.Записать();
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеЭкспортныеПроцедурыИФункции

// Получает значение функциональной опции.
//
// Параметры:
//   Опция - Строка - наименование опции.
//
// Возвращаемое значение: 
//   Произвольный - настройки, загруженные из хранилища.
//
Функция ЗначениеОпции(Опция) Экспорт
	Возврат ПолучитьФункциональнуюОпцию(Опция);
КонецФункции

// Получает настройку из хранилища настроек, если по объекту настройки нет, то берется общая.
//
// Параметры:
//   ОбъектНастройки  		- СправочникСсылка.СМ_ОбъектыСтроительства - объект для получения настройки.
//   Настройка 				- Строка - ключ сохраняемых настроек, необязательный.
//   ЗначениеПоУмолчанию 	- Произвольный - необязательный.
//   						  Значение, которое необходимо подставить если настройки не были загружены.
//
// Возвращаемое значение: 
//   Произвольный - настройки, загруженные из хранилища. 
//	 Неопределено - если настройки не найдены и параметр "ЗначениеПоУмолчанию" не указан.
//
Функция ПолучитьНастройкуПользователяПообъектно(ОбъектНастройки,Настройка,ЗначениеПоУмолчанию = Неопределено) Экспорт
	УИНнастройки = "";
	
	Если ЗначениеЗаполнено(ОбъектНастройки) Тогда
		УИНнастройки = Строка(ОбъектНастройки.УникальныйИдентификатор());
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
	"НастройкиПользователяСмета",Настройка+УИНнастройки,
	 ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
	"НастройкиПользователяСмета",Настройка,ЗначениеПоУмолчанию));
КонецФункции

// Получает настройку для подбора неучтенных ресурсов.
//
// Параметры:
//   Настройка - Строка - Необязательный. Ключ сохраняемых настроек.
//
// Возвращаемое значение: 
//   Произвольный - Настройки, загруженные из хранилища.
//   Ложь - Если настройки не найдены.
//
Функция ПолучитьНастройкуНеучтенных(Настройка) Экспорт
