#КонецОбласти

#Область РаботаСоСписком

// Процедура, опускающая ИЛИ поднимающая элементы списка справочника.
// Если неопределено - то элемента до/после нет.
//
// Параметры:
//     ТипСправочника - 			Строка 			- имя метаданных справочника.
//     ЭлементУменьшаемыйНомер - 	Произвольный 	- значение реквизита, у которого уменьшается номер.
//     ЭлементУвеличиваемыйНомер - 	Произвольный 	- значение реквизита, у которого увеличивается номер.
//     РеквизитСортировки - 		Строка 			- имя метаданных реквизита, по которому происходит движение.
//     Родитель - 					Произвольный 	- Группа справочника, в пределах которой происходит движение.
//
Процедура ВверхВнизСправочник(ТипСправочника, ЭлементУменьшаемыйНомер, ЭлементУвеличиваемыйНомер, РеквизитСортировки, Родитель = Неопределено) Экспорт
	
	ОбъектСсылкаВниз = Справочники[ТипСправочника].НайтиПоРеквизиту(РеквизитСортировки, ЭлементУменьшаемыйНомер, Родитель);
	ОбъектСсылкаВверх = Справочники[ТипСправочника].НайтиПоРеквизиту(РеквизитСортировки, ЭлементУвеличиваемыйНомер, Родитель);
	
	Если (Не ЗначениеЗаполнено(ОбъектСсылкаВниз)) ИЛИ (Не ЗначениеЗаполнено(ОбъектСсылкаВверх)) Тогда
		Возврат;
	Иначе
		
		// Обход контроля уникальности порядкового номера.
		
		ОбъектВниз = ОбъектСсылкаВниз.ПолучитьОбъект();
		ОбъектВниз[РеквизитСортировки] = -1;
		ОбъектВниз.Записать();
		
		ОбъектВверх = ОбъектСсылкаВверх.ПолучитьОбъект();
		ОбъектВверх[РеквизитСортировки] = ЭлементУвеличиваемыйНомер + 1;
		ОбъектВверх.Записать();
		
		ОбъектВниз[РеквизитСортировки] = ЭлементУменьшаемыйНомер - 1;
		ОбъектВниз.Записать();
		
	КонецЕсли;	      
	
КонецПроцедуры

#КонецОбласти

#Область ОбщиеПроцедурыИФункции

// Доопределяет обработчики служебных событий, объявленных через процедуру ПриДобавленииСлужебныхСобытий.
// Для упрощения поддержки, рекомендуется делать вызов такой же процедуры в общем модуле библиотеки.
//
// Параметры:
// 		КлиентскиеОбработчики – Соответствие - содержит поля:
//      	* Ключ  	– Строка - полное имя события.
//      	* Значение 	– Массив - содержит список имен клиентских общих модулей обработчиков.
// 		СерверныеОбработчики  – Соответствие - содержит поля:
//      	* Ключ  	– Строка - полное имя события.
//			* Значение 	– Массив - содержит список имен серверных общих модулей обработчиков.
//
Процедура ПриДобавленииОбработчиковСлужебныхСобытий(КлиентскиеОбработчики, СерверныеОбработчики) Экспорт
	
	СерверныеОбработчики["СтандартныеПодсистемы.БазоваяФункциональность\ПриДобавленииПараметровРаботыКлиентаПриЗапуске"].Добавить("СМ_СметаВызовСервера");
	
КонецПроцедуры // ПриДобавленииОбработчиковСлужебныхСобытий()

// Заполняет параметр состояния системы защиты.
//
// Параметры:
//   Параметры - Структура - имена и значения параметров работы клиента при запуске, которые необходимо задать.
//                           Для установки параметров работы клиента при запуске:
//                           Параметры.Вставить(<ИмяПараметра>, <код получения значения параметра>);
//
Процедура ПриДобавленииПараметровРаботыКлиентаПриЗапуске(Параметры) Экспорт
	
	ОписаниеОшибки = "";
	
	Результат = слкМенеджерЗащиты.ПроверитьЛицензиюСеанса(Метаданные.Подсистемы.СМ_СметнаяПодсистема.Подсистемы.слкСистемаЛицензирования_СМ.Комментарий, ОписаниеОшибки);
	Параметры.Вставить("СостояниеСистемыЗащиты", Новый Структура("РезультатЗапуска, ОписаниеОшибки", Результат, ОписаниеОшибки));
	
КонецПроцедуры // ПриДобавленииПараметровРаботыКлиентаПриЗапуске()

// Функция получает структуру для установки отборов в регистрах сведений
// (документы для измерений могут быть не записаны).
//
// Параметры:
//     СсылкаИлиОбъектИлиСтруктураДанныхФормы 	 - ДокументОбъект, ДокументСсылка, 
//												   СтруктураДанныхФормы - представление объекта.
//     СсылкаИлиОбъектИлиСтруктураДанныхФормыАкт - ДокументОбъект, ДокументСсылка, 
//							   					   СтруктураДанныхФормы - представление объекта акта.
//     ИмяОбъектаМетаданных - Строка - имя объекта, как задано в метаданных (СМ_ПозицияЛокальнойСметы).
//
// Возвращаемое значение:
//     Структура - содержит поля:
//			* СсылкаНаСмету 		- ДокументСсылка.СМ_ЛокальнаяСмета 			- Ссылка на смету. 		
//			* СсылкаНаРаздел 		- ДокументСсылка.СМ_РазделЛокальнойСметы 	- Ссылка на раздел.
//			* СсылкаНаПозицию 		- ДокументСсылка.СМ_ПозицияЛокальнойСметы	- Ссылка на позицию.
//			* СсылкаНаАкт 			- ДокументСсылка.СМ_АктВыполненныхРабот		- Ссылка на смету.
//			* СсылкаДляОтбораСмета 	- ДокументСсылка.СМ_АктВыполненныхРабот, ДокументСсылка.СМ_ЛокальнаяСмета - Ссылка на документ для отбора по измерению "Смета" в регистрах.
//
Функция ПолучитьСтруктуруДанныхДляОтборовРегистра(СсылкаИлиОбъектИлиСтруктураДанныхФормы, СсылкаИлиОбъектИлиСтруктураДанныхФормыАкт = Неопределено, ИмяОбъектаМетаданных = Неопределено) Экспорт
	
	Стркутура = Новый Структура("СсылкаНаСмету, СсылкаНаРаздел, СсылкаНаПозицию, СсылкаНаАкт, СсылкаДляОтбораСмета");
	
	// Получаем необходимые ссылки
	Если ИмяОбъектаМетаданных = "СМ_ПозицияЛокальнойСметы" Тогда
		Стркутура.СсылкаНаСмету = ПолучитьСсылкуНаДокумент(НайтиЛС(СсылкаИлиОбъектИлиСтруктураДанныхФормы.ИдРодителя));
		Стркутура.СсылкаНаРаздел = ПолучитьСсылкуНаДокумент(СсылкаИлиОбъектИлиСтруктураДанныхФормы.ИдРодителя, "СМ_РазделЛокальнойСметы");
		Стркутура.СсылкаНаПозицию = ПолучитьСсылкуНаДокумент(СсылкаИлиОбъектИлиСтруктураДанныхФормы, "СМ_ПозицияЛокальнойСметы");
		Стркутура.СсылкаНаАкт = ?(СсылкаИлиОбъектИлиСтруктураДанныхФормыАкт = Неопределено, Неопределено, ПолучитьСсылкуНаДокумент(СсылкаИлиОбъектИлиСтруктураДанныхФормыАкт, "СМ_АктВыполненныхРабот"));
		Стркутура.СсылкаДляОтбораСмета = ?(СсылкаИлиОбъектИлиСтруктураДанныхФормыАкт=Неопределено,Стркутура.СсылкаНаСмету,Стркутура.СсылкаНаАкт);
	ИначеЕсли ИмяОбъектаМетаданных = "СМ_РазделЛокальнойСметы" Тогда
		Стркутура.СсылкаНаСмету = ПолучитьСсылкуНаДокумент(НайтиЛС(СсылкаИлиОбъектИлиСтруктураДанныхФормы.ИдРодителя));
		Стркутура.СсылкаНаРаздел = ПолучитьСсылкуНаДокумент(СсылкаИлиОбъектИлиСтруктураДанныхФормы, "СМ_РазделЛокальнойСметы");
		Стркутура.СсылкаНаПозицию = Неопределено;
		Стркутура.СсылкаНаАкт = ?(СсылкаИлиОбъектИлиСтруктураДанныхФормыАкт = Неопределено, Неопределено, ПолучитьСсылкуНаДокумент(СсылкаИлиОбъектИлиСтруктураДанныхФормыАкт, "СМ_АктВыполненныхРабот"));
		Стркутура.СсылкаДляОтбораСмета = ?(СсылкаИлиОбъектИлиСтруктураДанныхФормыАкт=Неопределено,Стркутура.СсылкаНаСмету,Стркутура.СсылкаНаАкт);
	Иначе
		// Локальной сметы
		Стркутура.СсылкаНаСмету = ПолучитьСсылкуНаДокумент(СсылкаИлиОбъектИлиСтруктураДанныхФормы, "СМ_ЛокальнаяСмета");
		Стркутура.СсылкаНаРаздел = Неопределено;
		Стркутура.СсылкаНаПозицию = Неопределено;
		Стркутура.СсылкаНаАкт = ?(СсылкаИлиОбъектИлиСтруктураДанныхФормыАкт = Неопределено, Неопределено, ПолучитьСсылкуНаДокумент(СсылкаИлиОбъектИлиСтруктураДанныхФормыАкт, "СМ_АктВыполненныхРабот"));
		Стркутура.СсылкаДляОтбораСмета = ?(СсылкаИлиОбъектИлиСтруктураДанныхФормыАкт=Неопределено,Стркутура.СсылкаНаСмету,Стркутура.СсылкаНаАкт);
	КонецЕсли;	
	
	Возврат Стркутура;
	
КонецФункции

// Получает ссылку на документ по переданному объекту.
// Документ может быть новый и не записан, являться типом ДокументСсылка ИЛИ ДокументОбъект.
//
// Параметры:
//     СсылкаИлиОбъектИлиСтруктураДанныхФормы -	ДокументОбъект, ДокументСсылка, СтруктураДанныхФормы - Представление объекта.
//     ИмяОбъектаМетаданных - Строка - имя объекта, как оно задано в метаданных.
//
// Возвращаемое значение:
//     ДокументСсылка - ссылка на документ.
//
Функция ПолучитьСсылкуНаДокумент(СсылкаИлиОбъектИлиСтруктураДанныхФормы, ИмяОбъектаМетаданных = Неопределено) Экспорт
	
	Если СсылкаИлиОбъектИлиСтруктураДанныхФормы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(СсылкаИлиОбъектИлиСтруктураДанныхФормы) <> Тип("ДанныеФормыСтруктура") Тогда
		Если ИмяОбъектаМетаданных = Неопределено Тогда
			ИмяОбъектаМетаданных = СсылкаИлиОбъектИлиСтруктураДанныхФормы.Метаданные().Имя;
		КонецЕсли;
	Иначе
		Возврат СсылкаИлиОбъектИлиСтруктураДанныхФормы.Ссылка;
	КонецЕсли;
	
	Если (ТипЗнч(СсылкаИлиОбъектИлиСтруктураДанныхФормы) = Тип("ДокументОбъект."+ИмяОбъектаМетаданных)) Тогда
		Если СсылкаИлиОбъектИлиСтруктураДанныхФормы.Ссылка = Документы[ИмяОбъектаМетаданных].ПустаяСсылка() Тогда
			Ссылка = СсылкаИлиОбъектИлиСтруктураДанныхФормы.ПолучитьСсылкуНового();
		Иначе
			Ссылка = СсылкаИлиОбъектИлиСтруктураДанныхФормы.Ссылка;
		КонецЕсли;			
	ИначеЕсли (ТипЗнч(СсылкаИлиОбъектИлиСтруктураДанныхФормы) = Тип("ДокументСсылка."+ИмяОбъектаМетаданных)) Тогда
		Ссылка = СсылкаИлиОбъектИлиСтруктураДанныхФормы;
	Иначе // например выборка
		Ссылка = СсылкаИлиОбъектИлиСтруктураДанныхФормы.Ссылка;
	КонецЕсли;         
	
	Возврат Ссылка;
	
КонецФункции

// Получает объект по строке дерева смет.
// Возвращает ДокументОбъект или Неопределено (если объекта нет).
//
// Параметры:
//     СтрокаДерева - СтрокаДереваЗначений - строка дерева смет.
//	   ИмяРеквизита - Строка - название реквизита для получения объекта.
//
// Возвращаемое значение:
//     ДокументОбъект - объект строки дерева.
//	   В случае, когда строка не найдена - возвращается Неопределено.	
//
Функция ПолучитьОбъектСтрокиДереваСмет(СтрокаДерева, ИмяРеквизита = "Элемент") Экспорт
	
	об = СтрокаДерева[ИмяРеквизита].ПолучитьОбъект();
	Возврат об;
	
КонецФункции

// Получает ссылку на элемент по строке дерева смет.
// Возвращает ДокументСсылка или Неопределено (если объекта нет).
//
// Параметры:
//     СтрокаДерева - СтрокаДереваЗначений - строка дерева смет.
//	   ИмяРеквизита - Строка - название реквизита для получения ссылки.
//
// Возвращаемое значение:
//     ДокументСсылка - ссылка на объект строки дерева.
//	   В случае, когда строка не найдена - возвращается Неопределено.	
//
Функция ПолучитьСсылкуСтрокиДереваСмет(СтрокаДерева, ИмяРеквизита = "Элемент") Экспорт
	
	об = СтрокаДерева[ИмяРеквизита];
	Возврат об;
	
КонецФункции

// Возвращает строку с информацией о позиции.
//
// Параметры:
//     Позиция - ДокументСсылка.СМ_ПозицияЛокальнойСметы, ДокументОбъект.СМ_ПозицияЛокальнойСметы - Текущий 
//				 документ позиция локальной сметы.
//
// Возвращаемое значение:
//     Строка - описывает позицию (номер, наименование и т.п.).
//
Функция ПолучитьТекстИнформацииОПозиции(Позиция) Экспорт
	
	Номер = ПолучитьНомерДокумента(Позиция, "СМ_ПозицияЛокальнойСметы");
	
	СтрокаИнформации = ""+ СокрЛП(Номер.ПорНомер) + ". " + СокрЛП(Позиция.ШифрРасценки) + "   " + СокрЛП(Позиция.Наименование);
	
	Возврат СтрокаИнформации;
	
КонецФункции

// Возвращает строку с информацией о разделе.
//
// Параметры:
//     Раздел - ДокументСсылка.СМ_РазделЛокальнойСметы, ДокументОбъект.СМ_РазделЛокальнойСметы - 
//				Текущий документ раздел локальной сметы.
//
// Возвращаемое значение:
//     Строка - описывает раздел (номер, наименование и т.п.).
//
Функция ПолучитьТекстИнформацииОРазделе(Раздел) Экспорт
	
	Номер = ПолучитьНомерДокумента(Раздел, "СМ_РазделЛокальнойСметы");
	
	СтрокаИнформации = ""+ СокрЛП(Раздел.ПорНомер) + ".  " + СокрЛП(Раздел.НаименованиеДляПечати);
	
	Возврат СтрокаИнформации;
	
КонецФункции

// Возвращает строку с информацией о локальной смете.
//
// Параметры:
//     Документ 	- ДокументСсылка.СМ_ЛокальнаяСмета, ДокументОбъект.СМ_ЛокальнаяСмета - Текущий документ локальная смета.
//     ПараметрыЛС 	- Структура - содержит параметры локальной сметы.
//     Префикс 		- Строка - будет добавляться перед описанием.
//     Смета 		- ДокументСсылка.СМ_ЛокальнаяСмета, Неопределено - если известна смета, то можно передать ее.
//
// Возвращаемое значение:
//     Строка - описывает Смету (номер, наименование и т.п.).
//
Функция ПолучитьТекстИнформацииОСмете(Документ, ПараметрыЛС = Неопределено, Префикс = "Смета", Смета = Неопределено) Экспорт
	
	Если ПараметрыЛС = Неопределено Тогда
		ПараметрыЛС = ПолучитьСтруктуруПараметровРасчетаЛС(Смета, Документ);	
	КонецЕсли;
	
	СтрокаИнформации = Префикс;
	
	Если ПараметрыЛС.ЭтоРесурсныйМетод Тогда
		СтрокаИнформации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1 №%2 %3 (ресурсный метод)'"), СтрокаИнформации, ПараметрыЛС.НомерСметы, ПараметрыЛС.Наименование);
	ИначеЕсли ПараметрыЛС.ЭтоБазисноИндексныйУровеньРасценка Тогда
		СтрокаИнформации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1 №%2 %3 (базисно-индексный метод, индексы по позиции)'"), СтрокаИнформации, ПараметрыЛС.НомерСметы, ПараметрыЛС.Наименование);
	ИначеЕсли ПараметрыЛС.ЭтоБазисноИндексныйУровеньРаздел Тогда
		СтрокаИнформации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1 №%2 %3 (базисно-индексный метод, индексы по разделам)'"), СтрокаИнформации, ПараметрыЛС.НомерСметы, ПараметрыЛС.Наименование);
	ИначеЕсли ПараметрыЛС.ЭтоБазисноИндексныйУровеньСмета Тогда
		СтрокаИнформации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1 №%2 %3 (базисно-индексный метод, индексы по смете)'"), СтрокаИнформации, ПараметрыЛС.НомерСметы, ПараметрыЛС.Наименование);
	КонецЕсли; 
	
	Возврат СтрокаИнформации;
	
КонецФункции

// Возвращает строку с информацией о сводной смете.
//
// Параметры:
//     Документ - ДокументСсылка.СМ_СводнаяСмета, ДокументОбъект.СМ_СводнаяСмета - Текущий документ сводная смета.
//
// Возвращаемое значение:
//     СтрокаИнформации - Строка - описывает смету (номер, наименование и т.п.).
//
Функция ПолучитьТекстИнформацииОСводнойСмете(Документ) Экспорт
	
	СтрокаИнформации = "";
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		Если ЗначениеЗаполнено(Документ.ИдРодителя) Тогда
			СтрокаИнформации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1Подчинена сводной смете № %2 %3 от %4'"), СтрокаИнформации, Документ.ИдРодителя.НомерСметы, Документ.ИдРодителя.Наименование, Формат(Документ.ИдРодителя.Дата,"ДФ=dd.MM.yyyy"));
		КонецЕсли;
	Иначе
		СтрокаИнформации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1Подчинена сводной смете № %2 %3 от %4'"), СтрокаИнформации, Документ.НомерСметы, Документ.Наименование, Формат(Документ.Дата,"ДФ=dd.MM.yyyy"));
	КонецЕсли;

	Возврат СтрокаИнформации;
	
КонецФункции

// Возвращает строку с инофрмацией об акте выполненных работ.
//
// Параметры:
//     Документ 	- ДокументСсылка.СМ_АктВыполненныхРабот, ДокументОбъект.СМ_АктВыполненныхРабот - Текущий документ акт выполненных работ.
//     ПараметрыЛС 	- Структура, Неопределено - содержит значения текущей строки дерева смет.
//     Префикс 		- Строка - то, что будет добавляться перед описанием.
//     Смета 		- ДокументСсылка.СМ_ЛокальнаяСмета - если известна смета, то можно передать ее.
//
// Возвращаемое значение:
//     СтрокаИнформации - Строка - описывает акт (номер, наименование и т.п.).
//
Функция ПолучитьТекстИнформацииОбАкте(Документ, ПараметрыЛС = Неопределено, Префикс = "Смета", Смета = Неопределено) Экспорт
	
	Если ПараметрыЛС = Неопределено Тогда
		Если ЗначениеЗаполнено(Смета) Тогда
			ПараметрыЛС = ПолучитьСтруктуруПараметровРасчетаЛС(Смета);
		Иначе
			ПараметрыЛС = ПолучитьСтруктуруПараметровРасчетаЛС(Документ.ЛокальнаяСмета);
		КонецЕсли;
	КонецЕсли;
				
	СтрокаИнформации = Префикс;
	
	Если ПараметрыЛС.ЭтоРесурсныйМетод Тогда
		СтрокаИнформации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1 №%2 %3 (ресурсный метод)'"), СтрокаИнформации, Документ.НомерАкта, ПараметрыЛС.Наименование);
	ИначеЕсли ПараметрыЛС.ЭтоБазисноИндексныйУровеньРасценка Тогда
		СтрокаИнформации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1 №%2 %3 (базисно-индексный метод, индексы по позиции)'"), СтрокаИнформации, Документ.НомерАкта, ПараметрыЛС.Наименование);
	ИначеЕсли ПараметрыЛС.ЭтоБазисноИндексныйУровеньРаздел Тогда
		СтрокаИнформации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1 №%2 %3 (базисно-индексный метод, индексы по разделам)'"), СтрокаИнформации, Документ.НомерАкта, ПараметрыЛС.Наименование);
	ИначеЕсли ПараметрыЛС.ЭтоБазисноИндексныйУровеньСмета Тогда
		СтрокаИнформации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1 №%2 %3 (базисно-индексный метод, индексы по смете)'"), СтрокаИнформации, Документ.НомерАкта, ПараметрыЛС.Наименование);
	КонецЕсли;
	
	Возврат СтрокаИнформации;
	
КонецФункции

// Возвращает код элемента справочника
//
// Параметры:
//	   ТекЭлемСправ - СправочникСсылка.СМ_Ресурсы, СправочникСсылка.СМ_ТерриториальныеРайоны - ссылка 
//					  на элемент справочника для которого определяется код.
//
// Возвращаемое значение:
//     Код - Строка - код найденного элемента справочника.
//
Функция НайтиКод(ТекЭлемСправ) Экспорт
	
	Код = "";
	Если ТипЗнч(ТекЭлемСправ) = Тип("СправочникСсылка.СМ_Ресурсы")
		Или ТипЗнч(ТекЭлемСправ) = Тип("СправочникСсылка.СМ_ТерриториальныеРайоны") Тогда
		Код = ТекЭлемСправ.код;
	КонецЕсли;
	
	Возврат Код;
	
КонецФункции

// Возвращает признак того, что есть пользователи РФ
//
// Возвращаемое значение:
//     ЭтоРФ - Булево - если Истина, значит есть пользователи РФ.
//                      
Функция РФРегионыПользователей() Экспорт
	
	ЭтоРФ = Ложь;
	ВыборкаПользователи = Справочники.Пользователи.Выбрать();
	Пока ВыборкаПользователи.Следующий() Цикл
		Если ВыборкаПользователи.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Истина);
		СвойстваПользователя = Пользователи.НовоеОписаниеПользователяИБ();	
		Пользователи.ПрочитатьПользователяИБ(ВыборкаПользователи.ИдентификаторПользователяИБ, СвойстваПользователя);     	
		УстановитьПривилегированныйРежим(Ложь);
		
		СМ_ОсновнойРегион = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"НастройкиПользователяСмета","ОсновнойРегион",Неопределено,,СвойстваПользователя.Имя);
		
		Если Не ЗначениеЗаполнено(СМ_ОсновнойРегион) Тогда
			ЭтоРФ = Истина;
			Прервать;
		КонецЕсли;
		
		Если СМ_ОсновнойРегион.ПринадлежитЭлементу(Справочники.СМ_Регионы.РоссийскаяФедерация) Тогда
			ЭтоРФ = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

    Возврат ЭтоРФ;
	
КонецФункции

#КонецОбласти

#Область ФункцииНумерации

// Устанавливает порядковый номер документа в смете.
//
// Параметры:
//     Документ 			- ДокументСсылка - ссылка на документ, номер которого устанавливается.
//	   ПорНомер            	- Число - порядковый номер документа, который устанавливается.
//     НомерВПределахСметы 	- Число - номер в пределах сметы, который устанавливается.
//     НомерВДереве 		- Число - номер в дереве, который устанавливается.
//     СсылкаИлиОбъектИлиСтруктураДанныхФормыАкт - ДокументОбъект, ДокументСсылка, ДанныеФормы - представление объекта акта.
//     ИмяОбъектаМетаданных - Строка - имя объекта, как оно задано в метаданных.
//
Процедура УстановитьНомерДокумента(Документ, ПорНомер = -1, НомерВПределахСметы = -1, НомерВДереве = -1, СсылкаИлиОбъектИлиСтруктураДанныхФормыАкт = Неопределено, ИмяОбъектаМетаданных = Неопределено) Экспорт
	
	Менеджер = РегистрыСведений.СМ_НумерацияПозицийЛокальныхСмет.СоздатьМенеджерЗаписи();
	
	Если ПорНомер >= 0 Тогда
		Менеджер.ПорНомер = ПорНомер;
	КонецЕсли;
	
	Если НомерВПределахСметы >= 0 Тогда
		Менеджер.НомерВПределахСметы = НомерВПределахСметы;
	КонецЕсли;
	
	Если НомерВДереве >= 0 Тогда
		Менеджер.НомерВДереве = НомерВДереве;  
	КонецЕсли;
	
	Если (ПорНомер >= 0) или (НомерВПределахСметы >= 0) или (НомерВДереве >= 0) Тогда
		
		Если ИмяОбъектаМетаданных = Неопределено Тогда
			Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				ИмяОбъектаМетаданных = "СМ_ПозицияЛокальнойСметы";
			ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
				ИмяОбъектаМетаданных = "СМ_РазделЛокальнойСметы";
			Иначе
			    ИмяОбъектаМетаданных = Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		Структура = ПолучитьСтруктуруДанныхДляОтборовРегистра(Документ, СсылкаИлиОбъектИлиСтруктураДанныхФормыАкт, ИмяОбъектаМетаданных);
	
		Менеджер.Смета = Структура.СсылкаНаСмету;
		Менеджер.Раздел = Структура.СсылкаНаРаздел;
		Менеджер.Позиция = Структура.СсылкаНаПозицию;

		Менеджер.Записать(Истина);
		
	КонецЕсли;
		
КонецПроцедуры

// Возвращает порядковый номер документа в смете.
//
// Параметры:
//     Документ 			- ДокументСсылка - ссылка на документ, номер которого устанавливается.
//     ИмяОбъектаМетаданных - Строка - имя объекта, как оно задано в метаданных (например, СМ_ПозицияЛокальнойСметы).
//
// Возвращаемое значение:
//     Структура - содержит поля с данными о номере документа.
//
Функция ПолучитьНомерДокумента(Документ, ИмяОбъектаМетаданных = Неопределено) Экспорт
	
	Если ИмяОбъектаМетаданных = Неопределено Тогда
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			ИмяОбъектаМетаданных = "СМ_ПозицияЛокальнойСметы";
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			ИмяОбъектаМетаданных = "СМ_РазделЛокальнойСметы";
		Иначе
		    ИмяОбъектаМетаданных = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Структура = ПолучитьСтруктуруДанныхДляОтборовРегистра(Документ, , ИмяОбъектаМетаданных);
	
	Отбор = Новый Структура();
	Отбор.Вставить("Смета", ?(ЗначениеЗаполнено(Структура.СсылкаНаСмету), Структура.СсылкаНаСмету, Документы.СМ_ЛокальнаяСмета.ПустаяСсылка()));
	Отбор.Вставить("Раздел", ?(ЗначениеЗаполнено(Структура.СсылкаНаРаздел), Структура.СсылкаНаРаздел, Документы.СМ_РазделЛокальнойСметы.ПустаяСсылка()));
	Отбор.Вставить("Позиция", ?(ЗначениеЗаполнено(Структура.СсылкаНаПозицию), Структура.СсылкаНаПозицию, Документы.СМ_ПозицияЛокальнойСметы.ПустаяСсылка()));
	
	Возврат РегистрыСведений.СМ_НумерацияПозицийЛокальныхСмет.Получить(Отбор);
	
КонецФункции

// Присваивает порядковый номер объекту текущей строки.
//
// Параметры:
//     Выборка 				- Структура - содержит данные объекта.
//	   СтруктураНомера 		- Структура - содержит текущие номера объекта.
//     СчетчикНомер 		- Число - счетчик глобального номера.
//     СчетчикПорНомер 		- Число - счетчик номера по порядку в пределах подчинения.
//     ЗаписыватьВРегистр 	- Булево - определяет записывать или нет данные в регистр сведений.
//
Процедура ПрисвоитьНомерОбъекту(Выборка, СтруктураНомера, СчетчикНомер, СчетчикПорНомер, ЗаписыватьВРегистр = Истина) Экспорт

	Если (ТипЗнч(Выборка.Элемент) <> тип("ДокументСсылка.СМ_ЛокальнаяСмета")) И (Выборка.Элемент<>Неопределено) Тогда
		ПрисваиваемыйПорНомер = ?(Выборка.Элемент.Расчет И Не Выборка.Элемент.ПометкаУдаления,счетчикПорНомер,0);
		ПрисваиваемыйНомер = счетчикНомер;
		Если (СтруктураНомера.ПорНомер <> ПрисваиваемыйПорНомер) ИЛИ (СтруктураНомера.НомерВПределахСметы <> ПрисваиваемыйНомер) ИЛИ (СтруктураНомера.НомерВДереве <> ПрисваиваемыйНомер) Тогда
			СтруктураНомера.НомерВПределахСметы = ПрисваиваемыйНомер;
			СтруктураНомера.ПорНомер = ПрисваиваемыйПорНомер;
			СтруктураНомера.НомерВДереве = ПрисваиваемыйНомер;
			Если ЗаписыватьВРегистр Тогда 
				Если ТипЗнч(Выборка.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
					ТипМетеданных = "СМ_ПозицияЛокальнойСметы";
				ИначеЕсли ТипЗнч(Выборка.Элемент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
					ТипМетеданных = "СМ_РазделЛокальнойСметы";
				Иначе
				    ТипМетеданных = Неопределено;
				КонецЕсли;
				УстановитьНомерДокумента(Выборка.Элемент, ПрисваиваемыйПорНомер, ПрисваиваемыйНомер, ПрисваиваемыйНомер, , ТипМетеданных);						
			КонецЕсли;
		КонецЕсли;
		счетчикНомер = счетчикНомер + 1; 
		Если Выборка.Элемент.Расчет И Не Выборка.Элемент.ПометкаУдаления Тогда 
			счетчикПорНомер = счетчикПорНомер + 1;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область РаботаСДокументами

// Заполняет номер и наименование сметы из нумератора заполненного в стройке.
//
// Параметры:
// 	   Объект 		- ДокументОбъект.СМ_ЛокальнаяСмета, 
//					  ДокументОбъект.ОбъектнаяСмета, 
//					  ДокументОбъект.СводнаяСмета - объект, который надо заполнить.
//	   ПолеВыбора 	- ЭлементФормы - для выбора в наименование.
//     ТипСметы 	- Строка - описывает уровень сметы для нумерации.
//
Процедура ЗаполнитьНаименованиеНомерИзШаблона(Объект, ПолеВыбора = Неопределено, ТипСметы = "НумераторСмет") Экспорт
	
	Если Не ЗначениеЗаполнено(Объект.Стройка[ТипСметы]) Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонНомера = Объект.Стройка[ТипСметы].ШаблонНомера;
	ШаблонНаименования = Объект.Стройка[ТипСметы].ШаблонНаименования;
	
	Если ЗначениеЗаполнено(ШаблонНаименования) или ЗначениеЗаполнено(ШаблонНомера) Тогда
		
		Если (СтрНайти(ШаблонНаименования, "{ПорядковыйНомерВОбъектеСтроительства}") > 0) или
			(СтрНайти(ШаблонНомера, "{ПорядковыйНомерВОбъектеСтроительства}") > 0) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	СМ_ЛокальнаяСмета.Ссылка КАК КоличествоСмет
			               |ИЗ
			               |	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
			               |ГДЕ
			               |	СМ_ЛокальнаяСмета.Стройка = &Стройка
			               |
			               |ОБЪЕДИНИТЬ ВСЕ
			               |
			               |ВЫБРАТЬ
			               |	СМ_ОбъектнаяСмета.Ссылка
			               |ИЗ
			               |	Документ.СМ_ОбъектнаяСмета КАК СМ_ОбъектнаяСмета
			               |ГДЕ
			               |	СМ_ОбъектнаяСмета.Стройка = &Стройка
			               |
			               |ОБЪЕДИНИТЬ ВСЕ
			               |
			               |ВЫБРАТЬ
			               |	СМ_СводнаяСмета.Ссылка
			               |ИЗ
			               |	Документ.СМ_СводнаяСмета КАК СМ_СводнаяСмета
			               |ГДЕ
			               |	СМ_СводнаяСмета.Стройка = &Стройка
			               |ИТОГИ
			               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоСмет)
			               |ПО
			               |	ОБЩИЕ";
			Запрос.УстановитьПараметр("Стройка", Объект.Стройка);
			Выборка = Запрос.Выполнить().Выбрать();
			КоличествоСмет = 0;
			Если Выборка.Следующий() Тогда
				КоличествоСмет = Выборка.КоличествоСмет;
			КонецЕсли;
			ШаблонНомера = СтрЗаменить(ШаблонНомера, "{ПорядковыйНомерВОбъектеСтроительства}", Строка(КоличествоСмет+1));
			ШаблонНаименования = СтрЗаменить(ШаблонНаименования, "{ПорядковыйНомерВОбъектеСтроительства}", Строка(КоличествоСмет+1));
		КонецЕсли;
			
		ШаблонНомера = СтрЗаменить(ШаблонНомера, "{КодОбъектаСтроительства}", Объект.Стройка.Код);
		ШаблонНомера = СтрЗаменить(ШаблонНомера, "{НаименованиеОбъектаСтроительства}", Объект.Стройка.Наименование);
		ШаблонНаименования = СтрЗаменить(ШаблонНаименования, "{КодОбъектаСтроительства}", Объект.Стройка.Код);
		ШаблонНаименования = СтрЗаменить(ШаблонНаименования, "{НаименованиеОбъектаСтроительства}", Объект.Стройка.Наименование);
		Объект.НомерСметы = ШаблонНомера;
		Объект.Наименование = ШаблонНаименования;
		
	КонецЕсли;
	
	Если Объект.Стройка[ТипСметы].ВыбиратьСписком и ПолеВыбора<>Неопределено Тогда
		
		ПолеВыбора.СписокВыбора.Очистить();
		ПолеВыбора.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
		
		Для Каждого СтрокаЗначения Из Объект.Стройка[ТипСметы].СписокЗначенийВыбора Цикл
			ПолеВыбора.СписокВыбора.Добавить(СтрокаЗначения.НомерСтроки-1, ""+СокрЛП(СтрокаЗначения.Номер)+" "+СокрЛП(СтрокаЗначения.Наименование));
		КонецЦикла;	
		
	ИначеЕсли ПолеВыбора<>Неопределено Тогда
		
		ПолеВыбора.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.Авто;
		
	КонецЕсли;
		
	
КонецПроцедуры

// Заполняет номер по выбранному из списка наименвоанию.
//
// Параметры:
// 	   Объект 			 	- ДокументОбъект.СМ_ЛокальнаяСмета,  
//							  ДокументОбъект.ОбъектнаяСмета, 
//							  ДокументОбъект.СводнаяСмета - объект, который надо заполнить.
//	   ВыбранноеЗначение 	- Число - с выбранным значением по порядку от 0.
//     СтандартнаяОбработка - Булево - определяет выключать или нет стандартную обработку.
//     ТипСметы 			- Строка - описывает уровень сметы для нумерации.
//
Процедура ЗаполнитьНомерПоСпискуВыбораШаблона(Объект, ВыбранноеЗначение, СтандартнаяОбработка, ТипСметы = "НумераторСмет") Экспорт
	
	Если Не ЗначениеЗаполнено(Объект.Стройка[ТипСметы]) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Стройка[ТипСметы].ВыбиратьСписком и (ВыбранноеЗначение>-1) Тогда
		
		Попытка
			Объект.НомерСметы = Объект.Стройка[ТипСметы].СписокЗначенийВыбора[ВыбранноеЗначение].Номер;
			Объект.Наименование = Объект.Стройка[ТипСметы].СписокЗначенийВыбора[ВыбранноеЗначение].Наименование;
			СтандартнаяОбработка = Ложь;
		Исключение
			
		КонецПопытки;
		
	КонецЕсли;
		
	
КонецПроцедуры

// Удаляет документ из системы.
// ВАЖНО! Документ не записывается (т.к. вызов данной процедуры подразумевается из обработчиков записи).
//
// Параметры:
//     СметаАктОбъект - 					ДокументСсылка 	- удаляемый объект. 
//     СнятиеПометки - 						Булево			- Пометка на удаление снимается.
//     УдалятьПодчиненныеДокументы - 		Булево			- Удаляются подчиненные разделы, позиции, акты.
//
Процедура УстановитьСнятьПометкуУдаления(СметаАктОбъект,СнятиеПометки = Ложь,УдалятьПодчиненныеДокументы=Истина) Экспорт 
	
	Если НЕ СнятиеПометки Тогда
		// Удаление движений сметы / акта по регистрам.
		УдалитьДвижения(СметаАктОбъект.Ссылка);
	КонецЕсли;
	
	Если УдалятьПодчиненныеДокументы Тогда

		// Получение дерева сметы.
		Запрос = Новый Запрос;
		Текст = СМ_СметныйСоставВызовСервера.ПолучитьТекстЗапросаНаДеревоСмет();
		Текст = СтрЗаменить(Текст,"[ДопРеквизитСмета]","");
		Текст = СтрЗаменить(Текст,"[ДопРеквизитРаздел]","");
		Текст = СтрЗаменить(Текст,"[ДопРеквизитПозиция]","");
		Текст = СтрЗаменить(Текст,"[ДопУсловиеРаздел]","");
		Текст = СтрЗаменить(Текст,"[ДопУсловиеПозиция]","");
		Запрос.Текст = Текст;
		
		Запрос.УстановитьПараметр("Ссылка",СметаАктОбъект.Ссылка);
		Запрос.УстановитьПараметр("ИтогРаздела",Справочники.СМ_ИтогиПоРазделу.ИтогоПоРазделу);
		Запрос.УстановитьПараметр("ИтогСметы",Справочники.СМ_ИтогиПоСмете.ИтогоПоСмете);
		Запрос.УстановитьПараметр("ВидРасценкиОборудование", Перечисления.СМ_ВидыРасценки.Оборудование);
		Запрос.УстановитьПараметр("ЭтоАкт", (ТипЗнч(СметаАктОбъект.Ссылка) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот")));
		Запрос.УстановитьПараметр("АктВыполненныхРабот",СметаАктОбъект.Ссылка);
		ТабДерева = Запрос.Выполнить().Выгрузить();

		// Цикл по связанным со сметой документам.
		Для Каждого ТекСтрока Из ТабДерева Цикл
			Если ТипЗнч(ТекСтрока.Ссылка) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета")
				ИЛИ ТипЗнч(ТекСтрока.Ссылка) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
				Продолжить;
			Иначе
				
				ТекОбъект = ТекСтрока.Ссылка.ПолучитьОбъект();
				
				Если СнятиеПометки Тогда
					// Пометка на удаление.
					ТекОбъект.ПометкаУдаления = Ложь;
					ТекОбъект.Записать();
				Иначе	
					// Отмена проведения.
					Если ТекОбъект.Проведен Тогда
						 ТекОбъект.Проведен = Ложь;
					КонецЕсли;
					
					// Пометка на удаление.
					ТекОбъект.ПометкаУдаления = Истина;
					ТекОбъект.Записать();
					
					// Удаление движений по регистрам.
					УдалитьДвижения(ТекСтрока.Ссылка);
				
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		// Удаление связанных со сметой актов.
		СписокАктов = ПолучитьАктыСметы(СметаАктОбъект.Ссылка);
		Для Каждого ТекСтрока Из СписокАктов Цикл
			
			ТекОбъект = ТекСтрока.Ссылка.ПолучитьОбъект();
				
			Если СнятиеПометки Тогда
				// Пометка на удаление.
				ТекОбъект.ПометкаУдаления = Ложь;
				ТекОбъект.Записать();
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Снята пометка с акта №%1'"), ТекСтрока.Номер));
				
			Иначе	
			
				// Отмена проведения.
				Если ТекОбъект.Проведен Тогда
					 ТекОбъект.Проведен = Ложь;
				КонецЕсли;
				
				// Пометка на удаление.
				ТекОбъект.ПометкаУдаления = Истина;
				ТекОбъект.Записать();
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Удален акт №%1'"), ТекСтрока.Номер));
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры

// Копирует разделы, позиции локальной сметы в раздел любой сметы.
//
// Параметры:
//     Объекты 		 		- Массив - ссылки на объекты, который нужно скопировать, 
//							  могут быть позиции локальной сметы и разделы локальной сметы.
//     НовыйРодитель 		- ДокуметСсылка.СМ_РазделЛокальнойСметы - раздел локальной сметы, куда копируем.
//	   ЭлементКопирования 	- ДокументСсылка.СМ_РазделЛокальнойСметы, 
//	   						  ДокументСсылка.СМ_ПозицияЛокальнойСметы -ссылка на объект копирования.
//
Процедура СкопироватьОбъекты(Объекты, НовыйРодитель, ЭлементКопирования = Неопределено) Экспорт
	
	НачатьТранзакцию();    	
	
	ТЗ = Новый  ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ОбъектБыл");
	ТЗ.Колонки.Добавить("ОбъектСтал");
	Для сч = 1 По Объекты.количество() Цикл
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.ОбъектБыл = Объекты.получить(сч-1);
	КонецЦикла;	
	
	НомерПоПорядкуРаздел = СМ_СметныйСоставВызовСервера.ПолучитьМаксимальныйНомерВДереве(?(ТипЗнч(НовыйРодитель) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"),НовыйРодитель,НовыйРодитель.ИДСметы));
	НомерПоПорядку       = СМ_СметныйСоставВызовСервера.ПолучитьМаксимальныйНомерВДереве(?(ТипЗнч(НовыйРодитель) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"),НовыйРодитель,НовыйРодитель.ИДСметы));
	
	Для каждого СтрокаТз Из ТЗ Цикл		
		Если ТипЗнч(СтрокаТз.объектБыл) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			Если Объекты.Найти(СтрокаТз.ОбъектБыл.ИДРодителя) = Неопределено Тогда
				// Значит, это верхний раздел.
				НовыйРаздел = СоздатьНовыйРаздел();
				СкопироватьРаздел(НовыйРаздел, СтрокаТз.ОбъектБыл);
				ЗаменитьРодителя(НовыйРодитель, НовыйРаздел);
				НовыйРаздел.Записать();
				УстановитьНомерДокумента(НовыйРаздел.Ссылка, НомерПоПорядкуРаздел, , НомерПоПорядкуРаздел, ,"СМ_РазделЛокальнойСметы");
				НомерПоПорядкуРаздел = НомерПоПорядкуРаздел + 1;
				СтрокаТз.ОбъектСтал = ПолучитьСсылкуНаДокумент(НовыйРаздел,"СМ_РазделЛокальнойСметы"); 				
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	Если Не ЭлементКопирования = Неопределено Тогда
		Объекты.Вставить(0,ЭлементКопирования);
		НоваяСтрока = ТЗ.Вставить(0);
		НоваяСтрока.ОбъектБыл = ЭлементКопирования;
		НоваяСтрока.ОбъектСтал = НовыйРодитель;
	КонецЕсли;

	// Прошли верхний уровень, разделы, непосредственно подчиненные новому разделу. 	
	Для каждого СтрокаТз Из ТЗ Цикл
		Если ТипЗнч(СтрокаТз.объектБыл) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") И (СтрокаТз.ОбъектСтал = Неопределено) Тогда
			// Это раздел, который копируется в составе главного для себя раздела.
			// Необходимо создать новый раздел, и подчинить его копии главного раздела.
			НовыйРаздел = СоздатьНовыйРаздел();
			СкопироватьРаздел(НовыйРаздел, СтрокаТз.ОбъектБыл);
			//НовыйРаздел.ПорНомер = НомерПоПорядкуРаздел; 			
			
			нОтбор = Новый Структура;
			нОтбор.Вставить("ОбъектБыл",СтрокаТз.ОбъектБыл.ИдРодителя);
			
			нСтроки = ТЗ.НайтиСтроки(нОтбор);
			Если нСтроки.Количество() > 0 Тогда
				нСтрока = нСтроки.Получить(0);
				Если нСтрока.ОбъектСтал <> Неопределено Тогда
					ЗаменитьРодителя(нСтрока.ОбъектСтал, НовыйРаздел);
					НовыйРаздел.Записать();
					УстановитьНомерДокумента(НовыйРаздел.Ссылка, НомерПоПорядкуРаздел, , НомерПоПорядкуРаздел, ,"СМ_РазделЛокальнойСметы");
					СтрокаТз.ОбъектСтал = ПолучитьСсылкуНаДокумент(НовыйРаздел,"СМ_РазделЛокальнойСметы");
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден родитель для раздела %1'"), ПолучитьТекстИнформацииОРазделе(НовыйРаздел)));
				КонецЕсли;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден родитель для раздела %1'"), ПолучитьТекстИнформацииОРазделе(НовыйРаздел)));
			КонецЕсли;	
			
			НомерПоПорядкуРаздел = НомерПоПорядкуРаздел + 1;
			
		КонецЕсли;	
	КонецЦикла;	   
	
	// Обработали возможные починенные разделы.	
	Для Каждого  СтрокаТз Из ТЗ Цикл
		Если (ТипЗнч(СтрокаТз.ОбъектБыл) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"))
			И (Не ЗначениеЗаполнено(СтрокаТз.ОбъектБыл.ИдПозицииВладельца)) Тогда
			
			НоваяПозиция = СоздатьНовуюПозицию();  // Скопирована
			СкопироватьПозицию(НоваяПозиция, СтрокаТз.ОбъектБыл);
			НоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Скопирована;
			НоваяПозиция.ИсточникСоздания	= СтрокаТз.ОбъектБыл.Номер;
		
			Если Объекты.Найти(НоваяПозиция.ИДРодителя) <> Неопределено Тогда
				// Значит, эта позиция копируется в составе раздела.
				// Необходимо указать родителя - копию раздела.
			    нОтбор = Новый Структура;
				нОтбор.Вставить("ОбъектБыл",СтрокаТз.объектБыл.ИдРодителя);
				нСтроки = ТЗ.НайтиСтроки(нОтбор);
				Если нСтроки.Количество() > 0 Тогда
					нСтрока = нСтроки.Получить(0);
					Если нСтрока.ОбъектСтал <> Неопределено Тогда
						ЗаменитьРодителя(нСтрока.ОбъектСтал, НоваяПозиция);
						НоваяПозиция.Записать();
						УстановитьНомерДокумента(НоваяПозиция.Ссылка, НомерПоПорядку, , НомерПоПорядку, ,"СМ_ПозицияЛокальнойСметы");    					
						СтрокаТз.объектСтал = ПолучитьСсылкуНаДокумент(НоваяПозиция, "СМ_ПозицияЛокальнойСметы");
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден родитель для позиции %1. Позиция не скопирована.'"), ПолучитьТекстИнформацииОПозиции(НоваяПозиция)));
					КонецЕсли;	
				КонецЕсли;	
			Иначе
				ЗаменитьРодителя(НовыйРодитель, НоваяПозиция);
				НоваяПозиция.Записать();
				УстановитьНомерДокумента(НоваяПозиция.Ссылка, НомерПоПорядку, , НомерПоПорядку, ,"СМ_ПозицияЛокальнойСметы");   					
				СтрокаТз.объектСтал = ПолучитьСсылкуНаДокумент(НоваяПозиция, "СМ_ПозицияЛокальнойСметы");
			КонецЕсли;
			
			НомерПоПорядку = НомерПоПорядку + 1;
			
		КонецЕсли;	
	КонецЦикла;	   
	
	// Обработали просты позиции, осталось обработать привязанные. 	
	Для Каждого  СтрокаТз Из ТЗ Цикл
		Если (ТипЗнч(СтрокаТз.ОбъектБыл) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"))
			И (ЗначениеЗаполнено(СтрокаТз.ОбъектБыл.ИдПозицииВладельца)) Тогда
			
			НоваяПозиция = СоздатьНовуюПозицию(); // Скопирована
			СкопироватьПозицию(НоваяПозиция, СтрокаТз.ОбъектБыл);
			НоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Скопирована;
			НоваяПозиция.ИсточникСоздания	= СтрокаТз.ОбъектБыл.Номер;
			
			Если Объекты.Найти(СтрокаТз.ОбъектБыл.ИДПозицииВладельца) <> Неопределено Тогда
				// Значит, эта позиция копируется в составе раздела.
				// Необходимо указать родителя - копию раздела.
			    нОтбор = Новый Структура;
				нОтбор.Вставить("ОбъектБыл",СтрокаТз.объектБыл.ИДПозицииВладельца);
				нСтроки = ТЗ.НайтиСтроки(нОтбор);
				Если нСтроки.Количество() > 0 Тогда
					нСтрока = нСтроки.Получить(0);
					Если нСтрока.ОбъектСтал <> Неопределено Тогда
						НоваяПозиция.ИДПозицииВладельца = нСтрока.ОбъектСтал;
						ЗаменитьРодителя(нСтрока.ОбъектСтал, НоваяПозиция);
						НоваяПозиция.Записать();
						УстановитьНомерДокумента(НоваяПозиция.Ссылка, НомерПоПорядку, , НомерПоПорядку, ,"СМ_ПозицияЛокальнойСметы");
						СтрокаТз.ОбъектСтал = ПолучитьСсылкуНаДокумент(НоваяПозиция, "СМ_ПозицияЛокальнойСметы");						
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден родитель для позиции %1. Позиция не скопирована.'"), ПолучитьТекстИнформацииОПозиции(НоваяПозиция)));
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
			
			НомерПоПорядку = НомерПоПорядку + 1;
			
		КонецЕсли;	
	КонецЦикла;	   
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры	

// Копирует разделы, позиции локальной сметы в раздел любой сметы.
//
// Параметры:
//     Объекты 					- Массив - ссылки на объекты, который нужно скопировать, 
//								  могут быть позиции локальной сметы и разделы локальной сметы.
//     НовыйРодитель 			- ДокуметСсылка.СМ_РазделЛокальнойСметы	- раздел локальной сметы, куда копируем.
//     Корректировка 			- Булево - признак раздела который корректирует другой раздел.
//	   СтараяСмета 				- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету из которой копируем.
//	   РазделятьПозиции         - Булево - отвечает за разделение позиций.
//	   ТаблицаЗакрытыхОбъемов   - ТаблицаЗначений - содержит данные по закрытым объемам в позициях. 
//	   Перенумеруем             - Булево - признак необходимости перенумерации позиций. 
//	   Перерасчет               - Булево - признак необходимости перерасчета актов.
//	   СписокАктовДляПересчета  - Список - содержит акты для перерасчета.
//
Процедура СкопироватьОбъектыНоваяСмета(Объекты, НовыйРодитель,Корректировка,СтараяСмета = Неопределено,РазделятьПозиции = Ложь,ТаблицаЗакрытыхОбъемов = Неопределено,Перенумеруем = Ложь,Перерасчет = Истина, СписокАктовДляПересчета = Неопределено) Экспорт
	
	ТипРаздел = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы");
	ТипПозиция = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы");
	
	ТЗ = Новый  ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ОбъектБыл");
	ТЗ.Колонки.Добавить("ОбъектСтал");
	ТЗ.Колонки.Добавить("ОбъектОстатка");
	ТЗ.Колонки.Добавить("ОбъектБылТип");
	ТЗ.Колонки.Добавить("ОбъектБылИДРодителя");
	ТЗ.Колонки.Добавить("ОбъектБылИдПозицииВладельца");
	ТЗ.Колонки.Добавить("ОбъектБылИдПозицииВладельцаЗаполнено");
	ТЗ.Колонки.Добавить("Верхний");
	
	Для сч = 1 По Объекты.количество() Цикл
		НоваяСтрока = ТЗ.Добавить();
		Об = Объекты.получить(сч-1);
		НоваяСтрока.ОбъектБыл = Об;
		НоваяСтрока.ОбъектБылИДРодителя = Об.ИДРодителя;
		НоваяСтрока.ОбъектБылТип = ТипЗнч(Об); 
		Если НоваяСтрока.ОбъектБылТип = ТипПозиция Тогда
			НоваяСтрока.ОбъектБылИдПозицииВладельца = Об.ИдПозицииВладельца;
			НоваяСтрока.ОбъектБылИдПозицииВладельцаЗаполнено = ЗначениеЗаполнено(Об.ИдПозицииВладельца);   
		Иначе
			НоваяСтрока.ОбъектБылИдПозицииВладельца = Неопределено;
			НоваяСтрока.ОбъектБылИдПозицииВладельцаЗаполнено = Ложь;
		КонецЕсли;
		Если (НоваяСтрока.объектБылТип = ТипРаздел) И (Объекты.Найти(НоваяСтрока.ОбъектБылИДРодителя) = Неопределено) Тогда
			НоваяСтрока.Верхний=Истина;
		Иначе
			НоваяСтрока.Верхний=Ложь;
		КонецЕсли;
	КонецЦикла;		
	
	ОтборВерхние = Новый Структура();
	ОтборВерхние.Вставить("Верхний",Истина);
	
	МассивВерхних = Тз.НайтиСтроки(ОтборВерхние);

	Для каждого СтрокаТз Из МассивВерхних Цикл
		
		НовыйРаздел = СоздатьНовыйРаздел();
		СкопироватьРаздел(НовыйРаздел, СтрокаТз.ОбъектБыл);
		НомерБыл = ПолучитьНомерДокумента(СтрокаТз.объектБыл, "СМ_РазделЛокальнойСметы");   
		ЗаменитьРодителя(НовыйРодитель, НовыйРаздел);
		Если Корректировка Тогда
			НовыйРаздел.КорректируетРаздел = СтрокаТз.ОбъектБыл; 
		КонецЕсли;
		НовыйРаздел.Записать();
		
		УстановитьНомерДокумента(НовыйРаздел.Ссылка, НомерБыл.ПорНомер,НомерБыл.НомерВПределахСметы, НомерБыл.НомерВДереве, ,"СМ_РазделЛокальнойСметы"); 						
		СтрокаТз.ОбъектСтал = СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(НовыйРаздел,"СМ_РазделЛокальнойСметы");
		
	КонецЦикла;	
	
	// Прошли верхний уровень, разделы, непосредственно подчиненные новому разделу. 	
	ОтборВерхние = Новый Структура();
	ОтборВерхние.Вставить("объектБылТип",ТипРаздел);
	ОтборВерхние.Вставить("ОбъектСтал",Неопределено);

	МассивВерхних = Тз.НайтиСтроки(ОтборВерхние);
	
	Для каждого СтрокаТз Из МассивВерхних Цикл
		НовыйРодительРаздел = Неопределено;
		
		нОтбор = Новый Структура;
		нОтбор.Вставить("ОбъектБыл",СтрокаТз.ОбъектБылИдРодителя);
		нСтроки = ТЗ.НайтиСтроки(нОтбор);
		Если нСтроки.Количество() > 0 Тогда
			нСтрока = нСтроки.Получить(0);
			Если нСтрока.ОбъектСтал = Неопределено Тогда
				ОбработатьВрехнийУровень(нСтрока,ТЗ,Корректировка);
			КонецЕсли;
			НовыйРодительРаздел =  нСтрока.ОбъектСтал;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТз.ОбъектСтал) Тогда
			Продолжить;	
		КонецЕсли;
		
		// Это раздел, который копируется в составе главного для себя раздела.
		// Необходимо создать новый раздел, и подчинить его копии главного раздела.
		НовыйРаздел = СоздатьНовыйРаздел();
		СкопироватьРаздел(НовыйРаздел, СтрокаТз.ОбъектБыл);
		НомерБыл = ПолучитьНомерДокумента(СтрокаТз.объектБыл, "СМ_РазделЛокальнойСметы");
		
		Если Не НовыйРодительРаздел = Неопределено Тогда
			ЗаменитьРодителя(НовыйРодительРаздел, НовыйРаздел);
			Если Корректировка Тогда
				НовыйРаздел.КорректируетРаздел = СтрокаТз.ОбъектБыл; 
			КонецЕсли;
			НовыйРаздел.Записать();
			УстановитьНомерДокумента(НовыйРаздел.Ссылка, НомерБыл.ПорНомер,НомерБыл.НомерВПределахСметы, НомерБыл.НомерВДереве, ,"СМ_РазделЛокальнойСметы"); 					
			СтрокаТз.ОбъектСтал = ПолучитьСсылкуНаДокумент(НовыйРаздел,"СМ_РазделЛокальнойСметы");
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден родитель для раздела %1'"), СМ_СметаВызовСервера.ПолучитьТекстИнформацииОРазделе(НовыйРаздел)));
		КонецЕсли;
	КонецЦикла;	  	   
	
	// Обработали возможные починенные разделы.	
	ОтборВерхние = Новый Структура();
	ОтборВерхние.Вставить("объектБылТип",ТипПозиция);
	ОтборВерхние.Вставить("ОбъектБылИдПозицииВладельцаЗаполнено",Ложь);

	МассивВерхних = Тз.НайтиСтроки(ОтборВерхние);
	
	Для Каждого СтрокаТз Из МассивВерхних Цикл
			
		НоваяПозиция = СоздатьНовуюПозицию();  // Скопирована
		СкопироватьПозицию(НоваяПозиция, СтрокаТз.ОбъектБыл);
		НомерБыл 						= ПолучитьНомерДокумента(СтрокаТз.объектБыл, "СМ_ПозицияЛокальнойСметы");   
		Разделяем 						= Ложь;	
		НоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Скопирована;
		НоваяПозиция.ИсточникСоздания	= СтрокаТз.ОбъектБыл.Номер;
	
		Если РазделятьПозиции Тогда
			СтрокаОбъема = ТаблицаЗакрытыхОбъемов.Найти(СтрокаТз.ОбъектБыл);
			Если Не СтрокаОбъема = Неопределено Тогда
				Если СтрокаОбъема.ОбъемВсего > 0 И СтрокаОбъема.ОбъемВсего < СтрокаТз.объектБыл.ОбъемРабот Тогда
					НоваяПозиция.ОбъемРабот 	= СтрокаОбъема.ОбъемВсего;
					НоваяПозиция.СпособСоздания	= Перечисления.СМ_ИсточникиДобавленияПозиций.Разделением;
					Остаток 	= СтрокаТз.объектБыл.ОбъемРабот - СтрокаОбъема.ОбъемВсего;
					Разделяем 	= Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
			
		Если Объекты.Найти(НоваяПозиция.ИДРодителя) <> Неопределено Тогда
			// Значит, эта позиция копируется в составе раздела.
			// Необходимо указать родителя - копию раздела.
			нОтбор = Новый Структура;
			нОтбор.Вставить("ОбъектБыл",СтрокаТз.объектБылИдРодителя);
			нСтроки = ТЗ.НайтиСтроки(нОтбор);
			Если нСтроки.Количество() > 0 Тогда
				нСтрока = нСтроки.Получить(0);
				Если нСтрока.ОбъектСтал <> Неопределено Тогда
					ЗаменитьРодителя(нСтрока.ОбъектСтал, НоваяПозиция);
					Если Корректировка Тогда
						НоваяПозиция.КорректируетПозицию = СтрокаТз.ОбъектБыл; 
					КонецЕсли;
					НоваяПозиция.ОбменДанными.Загрузка = Истина;
					НоваяПозиция.Записать();
					УстановитьНомерДокумента(НоваяПозиция.Ссылка, НомерБыл.ПорНомер,НомерБыл.НомерВПределахСметы, НомерБыл.НомерВДереве, ,"СМ_ПозицияЛокальнойСметы"); 					
					
					СтрокаТз.объектСтал = ПолучитьСсылкуНаДокумент(НоваяПозиция, "СМ_ПозицияЛокальнойСметы");
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден родитель для позиции %1. Позиция не скопирована.'"), СМ_СметаВызовСервера.ПолучитьТекстИнформацииОПозиции(НоваяПозиция)));
				КонецЕсли;	
			КонецЕсли;	
		Иначе
			ЗаменитьРодителя(НовыйРодитель, НоваяПозиция);
			Если Корректировка Тогда
				НоваяПозиция.КорректируетПозицию = СтрокаТз.ОбъектБыл; 
			КонецЕсли;
			НоваяПозиция.ОбменДанными.Загрузка = Истина;
			НоваяПозиция.Записать();
			УстановитьНомерДокумента(НоваяПозиция.Ссылка, НомерБыл.ПорНомер,НомерБыл.НомерВПределахСметы, НомерБыл.НомерВДереве, ,"СМ_ПозицияЛокальнойСметы"); 					
			
			СтрокаТз.объектСтал = ПолучитьСсылкуНаДокумент(НоваяПозиция, "СМ_ПозицияЛокальнойСметы");
		КонецЕсли;

			
		Если Разделяем Тогда
			Перенумеруем 			= Истина;
			РазделяемНоваяПозиция 	= СоздатьНовуюПозицию(); // Разделением 
			СкопироватьПозицию(РазделяемНоваяПозиция,НоваяПозиция);
			РазделяемНоваяПозиция.ОбъемРабот 		= Остаток;
			РазделяемНоваяПозиция.СпособСоздания	= Перечисления.СМ_ИсточникиДобавленияПозиций.Разделением;
			РазделяемНоваяПозиция.ИсточникСоздания	= НоваяПозиция.Номер;
			РазделяемНоваяПозиция.Записать();
			СтрокаТз.ОбъектОстатка 	= РазделяемНоваяПозиция.Ссылка;
			НомерБыл 				= ПолучитьНомерДокумента(НоваяПозиция, "СМ_ПозицияЛокальнойСметы");
			НомерВДереве 			= НомерБыл.НомерВДереве+0.01;
			УстановитьНомерДокумента(СтрокаТз.ОбъектОстатка,,, НомерВДереве, ,"СМ_ПозицияЛокальнойСметы"); 
			
			// надо прикрепить подчиненные расценки
			ПривязанныеПозиции = ПолучитьПривязанныеПозиции(СтрокаТз.ОбъектБыл);
			Для Каждого СтрПривязка Из ПривязанныеПозиции Цикл
				
				нОтбор = Новый Структура;
				нОтбор.Вставить("ОбъектБыл",СтрПривязка.Ссылка);
				нСтроки = ТЗ.НайтиСтроки(нОтбор);
				нСтрока = нСтроки.Получить(0);
				СтрокаОбъема = ТаблицаЗакрытыхОбъемов.Найти(СтрПривязка.Ссылка);
				Если Не СтрокаОбъема = Неопределено Тогда
					Если СтрокаОбъема.ОбъемВсего > 0 И СтрокаОбъема.ОбъемВсего < СтрПривязка.Ссылка.ОбъемРабот Тогда
						
						НомерВДереве = НомерВДереве+0.01;
						НоваяПозиция = СоздатьНовуюПозицию(); // Разделением 
						СкопироватьПозицию(НоваяПозиция, СтрПривязка.Ссылка);
						НоваяПозиция.ИДПозицииВладельца = СтрокаТз.ОбъектОстатка;
						ЗаменитьРодителя(СтрокаТз.ОбъектОстатка, НоваяПозиция);
						Остаток 						= СтрПривязка.Ссылка.ОбъемРабот - СтрокаОбъема.ОбъемВсего;
						НоваяПозиция.ОбъемРабот 		= Остаток;
						НоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Разделением;
						НоваяПозиция.ИсточникСоздания	= СтрПривязка.Ссылка.Номер;

						НовыйОбъем 	= Остаток;
						СтарыйОбъем = СтрПривязка.Ссылка.ОбъемРабот;
						Если ЗначениеЗаполнено(НоваяПозиция.ФормулаОбъема) Тогда
							ВычОбъем = 0;
							Формула = "ВычОбъем = Значение";
							ФормулаОбъема = СтрЗаменить(НоваяПозиция.ФормулаОбъема,",",".");
							Формула = СтрЗаменить(Формула,"Значение",ФормулаОбъема);
							Попытка
								Выполнить(Формула);
								ТекОбъем = (ВычОбъем/СтарыйОбъем)*НовыйОбъем;
								Норма = ВычОбъем/СтарыйОбъем;
							Исключение
								Если СтарыйОбъем = 0 Тогда
									ТекОбъем = НовыйОбъем;
								Иначе
									ТекОбъем = (НоваяПозиция.ОбъемРабот/СтарыйОбъем)*НовыйОбъем;
									Норма = НоваяПозиция.ОбъемРабот/СтарыйОбъем;
								КонецЕсли;
							КонецПопытки;
						Иначе
							ТекОбъем = (НоваяПозиция.ОбъемРабот/СтарыйОбъем)*НовыйОбъем;
							Норма = НоваяПозиция.ОбъемРабот/СтарыйОбъем;
						КонецЕсли;
						Если СтарыйОбъем = 0 Тогда
							НоваяПозиция.ФормулаОбъема = "1" + "*" + СокрЛП(Строка(Формат(ТекОбъем,"ЧГ=0")));
						Иначе
							НоваяПозиция.ФормулаОбъема = СокрЛП(Строка(Формат(НовыйОбъем,"ЧГ=0"))) + "*" + СокрЛП(Строка(Формат(Норма,"ЧГ=0")));
						КонецЕсли;
						
						НоваяПозиция.Записать();
						УстановитьНомерДокумента(НоваяПозиция.Ссылка,,,НомерВДереве, ,"СМ_ПозицияЛокальнойСметы"); 
						нСтрока.ОбъектОстатка = НоваяПозиция.Ссылка;

					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;	   
	
	// Обработали просты позиции, осталось обработать привязанные. 	
	ОтборВерхние = Новый Структура();
	ОтборВерхние.Вставить("объектБылТип",ТипПозиция);
	ОтборВерхние.Вставить("ОбъектБылИдПозицииВладельцаЗаполнено",Истина);

	МассивВерхних = Тз.НайтиСтроки(ОтборВерхние);
	
	Для Каждого СтрокаТз Из МассивВерхних Цикл
			
		НоваяПозиция = СоздатьНовуюПозицию(); // Скопирована
		СкопироватьПозицию(НоваяПозиция, СтрокаТз.ОбъектБыл);
		НоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Скопирована;
		НоваяПозиция.ИсточникСоздания	= СтрокаТз.ОбъектБыл.Номер;
		НомерБыл 	= ПолучитьНомерДокумента(СтрокаТз.объектБыл, "СМ_ПозицияЛокальнойСметы");   
		Разделяем 	= Ложь;
		Если РазделятьПозиции Тогда
			СтрокаОбъема = ТаблицаЗакрытыхОбъемов.Найти(СтрокаТз.ОбъектБыл);
			Если Не СтрокаОбъема = Неопределено Тогда
				Если СтрокаОбъема.ОбъемВсего > 0 И СтрокаОбъема.ОбъемВсего < СтрокаТз.объектБыл.ОбъемРабот Тогда
					НоваяПозиция.ОбъемРабот 	= СтрокаОбъема.ОбъемВсего;
					НоваяПозиция.СпособСоздания	= Перечисления.СМ_ИсточникиДобавленияПозиций.Разделением;
					Остаток 	= СтрокаТз.объектБыл.ОбъемРабот - СтрокаОбъема.ОбъемВсего;
					Разделяем 	= Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		Если Объекты.Найти(СтрокаТз.ОбъектБылИДПозицииВладельца) <> Неопределено Тогда
			// Значит, эта позиция копируется в составе раздела.
			// Необходимо указать родителя - копию раздела.
		    нОтбор = Новый Структура;
			нОтбор.Вставить("ОбъектБыл",СтрокаТз.объектБылИДПозицииВладельца);
			нСтроки = ТЗ.НайтиСтроки(нОтбор);
			Если нСтроки.Количество() > 0 Тогда
				нСтрока = нСтроки.Получить(0);
				Если нСтрока.ОбъектСтал <> Неопределено Тогда
					НоваяПозиция.ИДПозицииВладельца = нСтрока.ОбъектСтал;
					ЗаменитьРодителя(нСтрока.ОбъектСтал, НоваяПозиция);
					Если Корректировка Тогда
						НоваяПозиция.КорректируетПозицию = СтрокаТз.ОбъектБыл; 
					КонецЕсли;
					
					Если Разделяем Тогда
						НовыйОбъем =  нСтрока.ОбъектСтал.ОбъемРабот;
						СтарыйОбъем = СтрокаТз.объектБылИДПозицииВладельца.ОбъемРабот;
						Если ЗначениеЗаполнено(НоваяПозиция.ФормулаОбъема) Тогда
							ВычОбъем = 0;
							Формула = "ВычОбъем = Значение";
							ФормулаОбъема = СтрЗаменить(НоваяПозиция.ФормулаОбъема,",",".");
							Формула = СтрЗаменить(Формула,"Значение",ФормулаОбъема);
							Попытка
								Выполнить(Формула);
								ТекОбъем = (ВычОбъем/СтарыйОбъем)*НовыйОбъем;
								Норма = ВычОбъем/СтарыйОбъем;
							Исключение
								Если СтарыйОбъем = 0 Тогда
									ТекОбъем = НовыйОбъем;
								Иначе
									ТекОбъем = (НоваяПозиция.ОбъемРабот/СтарыйОбъем)*НовыйОбъем;
									Норма = НоваяПозиция.ОбъемРабот/СтарыйОбъем;
								КонецЕсли;
							КонецПопытки;
						Иначе
							ТекОбъем = (НоваяПозиция.ОбъемРабот/СтарыйОбъем)*НовыйОбъем;
							Норма = НоваяПозиция.ОбъемРабот/СтарыйОбъем;
						КонецЕсли;
						Если СтарыйОбъем = 0 Тогда
							НоваяПозиция.ФормулаОбъема = "1" + "*" + СокрЛП(Строка(Формат(ТекОбъем,"ЧГ=0")));
						Иначе
							НоваяПозиция.ФормулаОбъема = СокрЛП(Строка(Формат(НовыйОбъем,"ЧГ=0"))) + "*" + СокрЛП(Строка(Формат(Норма,"ЧГ=0")));
						КонецЕсли;
					КонецЕсли;
					
					НоваяПозиция.Записать();
					УстановитьНомерДокумента(НоваяПозиция.Ссылка, НомерБыл.ПорНомер,НомерБыл.НомерВПределахСметы, НомерБыл.НомерВДереве, ,"СМ_ПозицияЛокальнойСметы"); 					
				
					СтрокаТз.ОбъектСтал = ПолучитьСсылкуНаДокумент(НоваяПозиция, "СМ_ПозицияЛокальнойСметы");						
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден родитель для позиции %1. Позиция не скопирована.'"), ПолучитьТекстИнформацииОПозиции(НоваяПозиция)));
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
			
		Если Разделяем Тогда
			Перенумеруем = Истина;
			нОтбор = Новый Структура;
			нОтбор.Вставить("ОбъектБыл",СтрокаТз.объектБылИДПозицииВладельца);
			нСтроки = ТЗ.НайтиСтроки(нОтбор);
			Если нСтроки.Количество() > 0 Тогда
				нСтрока = нСтроки.Получить(0);
				Если Не ЗначениеЗаполнено(нСтрока.ОбъектОстатка) Тогда
					НоваяИДПозицииВладельца = СоздатьНовуюПозицию();  // Разделением 
					СкопироватьПозицию(НоваяИДПозицииВладельца,нСтрока.ОбъектСтал);
					НоваяИДПозицииВладельца.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Разделением;
					НоваяИДПозицииВладельца.ИсточникСоздания	= НомерБыл;
					НоваяИДПозицииВладельца.ОбъемРабот 			= нСтрока.ОбъектСтал.Номер;
					НоваяИДПозицииВладельца.Записать();
					нСтрока.ОбъектОстатка 	= НоваяИДПозицииВладельца.Ссылка;
					НомерБыл 				= ПолучитьНомерДокумента(нСтрока.ОбъектСтал, "СМ_ПозицияЛокальнойСметы"); 
					НомерВДереве 			= НомерБыл.НомерВДереве+0.01;
					УстановитьНомерДокумента(нСтрока.ОбъектОстатка,,, НомерВДереве, ,"СМ_ПозицияЛокальнойСметы"); 
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(СтрокаТз.ОбъектОстатка) Тогда	
					РазделяемНоваяПозиция = СоздатьНовуюПозицию();  // Разделением 
					СкопироватьПозицию(РазделяемНоваяПозиция,НоваяПозиция);
					РазделяемНоваяПозиция.ИДПозицииВладельца 	= нСтрока.ОбъектОстатка;
					РазделяемНоваяПозиция.ОбъемРабот 			= Остаток;
					РазделяемНоваяПозиция.ФормулаОбъема 		= "";
					РазделяемНоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Разделением;
					РазделяемНоваяПозиция.ИсточникСоздания		= НоваяПозиция.Номер;
					РазделяемНоваяПозиция.Записать();
					СтрокаТз.ОбъектОстатка = РазделяемНоваяПозиция.Ссылка;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;

	КонецЦикла;	   
	
	КопироватьАкты = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","КопироватьАкты");
	КопироватьАкты = ?(КопироватьАкты = Неопределено,РазделятьПозиции,КопироватьАкты);

	Если КопироватьАкты Тогда
		ТаблицаАктов = ПолучитьАктыСметы(СтараяСмета);
		Для Каждого Стр Из ТаблицаАктов Цикл
			Если стр.Ссылка.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			НовыйАкт = СоздатьНовыйАкт();
			НовыйАкт.ЛокальнаяСмета = НовыйРодитель;
			СкопироватьАкт(НовыйАкт,стр.Ссылка,ТЗ);
			НовыйАкт.Записать();
			Если Перерасчет Тогда
				Документы.СМ_АктВыполненныхРабот.Перерасчет(НовыйАкт);
			ИначеЕсли СписокАктовДляПересчета <> Неопределено Тогда
				СписокАктовДляПересчета.Добавить(НовыйАкт.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры	

Процедура ОбработатьВрехнийУровень(СтрокаУровня,ТаблицаОбъектов,Корректировка)
	Если ЗначениеЗаполнено(СтрокаУровня.ОбъектБылИДРодителя) Тогда
		нОтбор = Новый Структура;
		нОтбор.Вставить("ОбъектБыл",СтрокаУровня.ОбъектБылИдРодителя);
		
		нСтроки = ТаблицаОбъектов.НайтиСтроки(нОтбор);
		Если нСтроки.Количество() > 0 Тогда
			нСтрока = нСтроки.Получить(0);
			Если нСтрока.ОбъектСтал = Неопределено Тогда
				ОбработатьВрехнийУровень(нСтрока,ТаблицаОбъектов,Корректировка);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	нОтбор = Новый Структура;
	нОтбор.Вставить("ОбъектБыл",СтрокаУровня.ОбъектБылИдРодителя);
	
	нСтроки = ТаблицаОбъектов.НайтиСтроки(нОтбор);
	нСтрока = нСтроки.Получить(0);
	НовыйРодитель =	нСтрока.ОбъектСтал;
	
	НовыйРаздел = СоздатьНовыйРаздел();
	СкопироватьРаздел(НовыйРаздел, СтрокаУровня.ОбъектБыл);
	НомерБыл = ПолучитьНомерДокумента(СтрокаУровня.объектБыл, "СМ_РазделЛокальнойСметы");
	
	ЗаменитьРодителя(НовыйРодитель, НовыйРаздел);
	Если Корректировка Тогда
		НовыйРаздел.КорректируетРаздел = СтрокаУровня.ОбъектБыл; 
	КонецЕсли;
	НовыйРаздел.Записать();
	УстановитьНомерДокумента(НовыйРаздел.Ссылка, НомерБыл.ПорНомер,НомерБыл.НомерВПределахСметы, НомерБыл.НомерВДереве, ,"СМ_РазделЛокальнойСметы"); 					
	СтрокаУровня.ОбъектСтал = ПолучитьСсылкуНаДокумент(НовыйРаздел,"СМ_РазделЛокальнойСметы");

КонецПроцедуры

// Копирует разделы, позиции локальной сметы в раздел любой сметы.
//
// Параметры:
//     Объекты 		 - Массив - ссылки на объекты, который нужно скопировать, 
//					   могут быть позиции локальной сметы и разделы локальной сметы.
//     НовыйРодитель - ДокуметСсылка.СМ_РазделЛокальнойСметы - раздел локальной сметы, куда копируем.
//
Процедура СкопироватьОбъектыСметаНаОстаток(Объекты, НовыйРодитель) Экспорт
	
	НачатьТранзакцию();
	
	Объекты.Колонки.Добавить("НоваяСсылка");
	
	ТЗ = Новый  ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ОбъектБыл");
	ТЗ.Колонки.Добавить("ОбъектСтал");
	Для сч = 1 По Объекты.количество() Цикл
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.ОбъектБыл = Объекты.получить(сч-1).Ссылка;
	КонецЦикла;	
	
	Если ТЗ.Количество()>0 Тогда
	СтрокаТз = ТЗ[0];
	СтрокаТз.ОбъектСтал = НовыйРодитель;
	КонецЕсли;
	
	
	Для каждого СтрокаТз Из ТЗ Цикл		
		Если ТипЗнч(СтрокаТз.объектБыл) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			СтрНашли = Объекты.Найти(СтрокаТз.ОбъектБыл.ИДРодителя,"Ссылка");
			Если СтрНашли = Неопределено ИЛИ ТипЗнч(СтрНашли.Ссылка) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
				// Значит, это верхний раздел.
				НовыйРаздел = СоздатьНовыйРаздел();
				СкопироватьРаздел(НовыйРаздел, СтрокаТз.ОбъектБыл);
				НомерБыл = ПолучитьНомерДокумента(СтрокаТз.объектБыл, "СМ_РазделЛокальнойСметы");   
				//НовыйРаздел.ПорНомер = НомерБыл.ПорНомер; 
				НовыйРаздел.КорректируетРаздел = СтрокаТз.ОбъектБыл;
				ЗаменитьРодителя(НовыйРодитель, НовыйРаздел);
				НовыйРаздел.Записать();
				УстановитьНомерДокумента(НовыйРаздел.Ссылка, НомерБыл.ПорНомер, , НомерБыл.ПорНомер, ,"СМ_РазделЛокальнойСметы");
				СтрокаТз.ОбъектСтал = ПолучитьСсылкуНаДокумент(НовыйРаздел,"СМ_РазделЛокальнойСметы"); 	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	// Прошли верхний уровень, разделы, непосредственно подчиненные новому разделу. 	
	Для каждого СтрокаТз Из ТЗ Цикл
		Если ТипЗнч(СтрокаТз.объектБыл) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") И (СтрокаТз.ОбъектСтал = Неопределено) Тогда
			// Это раздел, который копируется в составе главного для себя раздела.
			// Необходимо создать новый раздел, и подчинить его копии главного раздела.
			НовыйРаздел = СоздатьНовыйРаздел();
			СкопироватьРаздел(НовыйРаздел, СтрокаТз.ОбъектБыл);
			НомерБыл = ПолучитьНомерДокумента(СтрокаТз.объектБыл, "СМ_РазделЛокальнойСметы");   
				
			//НовыйРаздел.ПорНомер = НомерБыл.ПорНомер; 
			НовыйРаздел.КорректируетРаздел = СтрокаТз.ОбъектБыл;
			
			нОтбор = Новый Структура;
			нОтбор.Вставить("ОбъектБыл",СтрокаТз.ОбъектБыл.ИдРодителя);
			
			нСтроки = ТЗ.НайтиСтроки(нОтбор);
			Если нСтроки.Количество() > 0 Тогда
				нСтрока = нСтроки.Получить(0);
				Если нСтрока.ОбъектСтал <> Неопределено Тогда
					ЗаменитьРодителя(нСтрока.ОбъектСтал, НовыйРаздел);
					НовыйРаздел.Записать();
					УстановитьНомерДокумента(НовыйРаздел.Ссылка, НомерБыл.ПорНомер, , НомерБыл.ПорНомер, ,"СМ_РазделЛокальнойСметы");
					СтрокаТз.ОбъектСтал = ПолучитьСсылкуНаДокумент(НовыйРаздел,"СМ_РазделЛокальнойСметы");
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден родитель для раздела %1'"), ПолучитьТекстИнформацииОРазделе(НовыйРаздел)));
				КонецЕсли;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден родитель для раздела %1'"), ПолучитьТекстИнформацииОРазделе(НовыйРаздел)));
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	   
	
	// Обработали возможные починенные разделы.	
	Для Каждого  СтрокаТз Из ТЗ Цикл
		Если (ТипЗнч(СтрокаТз.ОбъектБыл) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"))
			И (Не ЗначениеЗаполнено(СтрокаТз.ОбъектБыл.ИдПозицииВладельца)) Тогда
			
			НоваяПозиция = СоздатьНовуюПозицию();  //  Скопирована
			СкопироватьПозицию(НоваяПозиция, СтрокаТз.ОбъектБыл);
			НоваяПозиция.КорректируетПозицию 	= СтрокаТз.ОбъектБыл;
			НоваяПозиция.СпособСоздания			= Перечисления.СМ_ИсточникиДобавленияПозиций.Скопирована;
			НоваяПозиция.ИсточникСоздания		= СтрокаТз.ОбъектБыл.Номер;
			НомерБыл = ПолучитьНомерДокумента(СтрокаТз.объектБыл, "СМ_ПозицияЛокальнойСметы");   
			СтрНашли = Объекты.Найти(НоваяПозиция.ИДРодителя,"Ссылка");
			Если СтрНашли <> Неопределено И Не ТипЗнч(СтрНашли.Ссылка) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
				// Значит, эта позиция копируется в составе раздела.
				// Необходимо указать родителя - копию раздела.
			    нОтбор = Новый Структура;
				нОтбор.Вставить("ОбъектБыл",СтрокаТз.объектБыл.ИдРодителя);
				нСтроки = ТЗ.НайтиСтроки(нОтбор);
				Если нСтроки.Количество() > 0 Тогда
					нСтрока = нСтроки.Получить(0);
					Если нСтрока.ОбъектСтал <> Неопределено Тогда
						ЗаменитьРодителя(нСтрока.ОбъектСтал, НоваяПозиция);
						НоваяПозиция.Записать();
						УстановитьНомерДокумента(НоваяПозиция.Ссылка, НомерБыл.ПорНомер, , НомерБыл.НомерВДереве, ,"СМ_ПозицияЛокальнойСметы");
						СтрокаТз.объектСтал = ПолучитьСсылкуНаДокумент(НоваяПозиция, "СМ_ПозицияЛокальнойСметы");
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден родитель для позиции %1. Позиция не скопирована.'"), ПолучитьТекстИнформацииОПозиции(НоваяПозиция)));
					КонецЕсли;	
				КонецЕсли;	
			Иначе
				ЗаменитьРодителя(НовыйРодитель, НоваяПозиция);
				НоваяПозиция.Записать();
				УстановитьНомерДокумента(НоваяПозиция.Ссылка, НомерБыл.ПорНомер, , НомерБыл.НомерВДереве, ,"СМ_ПозицияЛокальнойСметы");
				СтрокаТз.объектСтал = ПолучитьСсылкуНаДокумент(НоваяПозиция, "СМ_ПозицияЛокальнойСметы");
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	   
	
	// Обработали просты позиции, осталось обработать привязанные. 	
	Для Каждого  СтрокаТз Из ТЗ Цикл
		Если (ТипЗнч(СтрокаТз.ОбъектБыл) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"))
			И (ЗначениеЗаполнено(СтрокаТз.ОбъектБыл.ИдПозицииВладельца)) Тогда
			
			НоваяПозиция = СоздатьНовуюПозицию(); //  Скопирована
			СкопироватьПозицию(НоваяПозиция, СтрокаТз.ОбъектБыл);
			НомерБыл = ПолучитьНомерДокумента(СтрокаТз.объектБыл, "СМ_ПозицияЛокальнойСметы");   
			НоваяПозиция.КорректируетПозицию 	= СтрокаТз.ОбъектБыл;
			НоваяПозиция.СпособСоздания			= Перечисления.СМ_ИсточникиДобавленияПозиций.Скопирована;
			НоваяПозиция.ИсточникСоздания		= СтрокаТз.ОбъектБыл.Номер;

			Если Объекты.Найти(СтрокаТз.ОбъектБыл.ИДПозицииВладельца,"Ссылка") <> Неопределено Тогда
				// Значит, эта позиция копируется в составе раздела.
				// Необходимо указать родителя - копию раздела.
			    нОтбор = Новый Структура;
				нОтбор.Вставить("ОбъектБыл",СтрокаТз.объектБыл.ИДПозицииВладельца);
				нСтроки = ТЗ.НайтиСтроки(нОтбор);
				Если нСтроки.Количество() > 0 Тогда
					нСтрока = нСтроки.Получить(0);
					Если нСтрока.ОбъектСтал <> Неопределено Тогда
						НоваяПозиция.ИДПозицииВладельца = нСтрока.ОбъектСтал;
						ЗаменитьРодителя(нСтрока.ОбъектСтал, НоваяПозиция);
						НоваяПозиция.Записать();
						УстановитьНомерДокумента(НоваяПозиция.Ссылка, НомерБыл.ПорНомер, , НомерБыл.НомерВДереве, ,"СМ_ПозицияЛокальнойСметы");
						СтрокаТз.ОбъектСтал = ПолучитьСсылкуНаДокумент(НоваяПозиция, "СМ_ПозицияЛокальнойСметы");						
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден родитель для позиции %1. Позиция не скопирована.'"), ПолучитьТекстИнформацииОПозиции(НоваяПозиция)));
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	   
	
	ЗафиксироватьТранзакцию();
	Для каждого СтрокаТз Из ТЗ Цикл
		Стр = Объекты.Найти(СтрокаТз.ОбъектБыл,"Ссылка");
		Стр.НоваяСсылка = СтрокаТз.ОбъектСтал;
	КонецЦикла;	
КонецПроцедуры	

// Копирует разделы, позиции локальной сметы в раздел любой сметы по.
//
// Параметры:
//	Объекты 				- Массив - ссылки на объекты, который нужно скопировать, 
//							  могут быть позиции локальной сметы и разделы локальной сметы.
//  НовыйРодитель 			- ДокуметСсылка.СМ_РазделЛокальнойСметы	- раздел локальной сметы, куда копируем.
//  Корректировка 			- Булево - признак раздела, который корректирует другой раздел.
// 	ТабОбъекты              - ТаблицаЗначений - содержит данные о корректировках разделов.
//	СтараяСмета             - ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету из которой копируем.
//	РазделятьПозиции        - Булево - признак необходимости разделения позиций.
//	ТаблицаЗакрытыхОбъемов  - ТаблицаЗначений - содержит данные по закрытым объемам в позициях. 
//	Перенумеруем            - Булево - признак необходимости перенумерации позиций.
//
Процедура СкопироватьОбъектыНоваяСметаСтройка(Объекты, НовыйРодитель,Корректировка,ТабОбъекты,СтараяСмета = Неопределено,РазделятьПозиции = Ложь,ТаблицаЗакрытыхОбъемов = Неопределено,Перенумеруем = Ложь) Экспорт
	
	// НачатьТранзакцию();
	
	Объекты.Колонки.Добавить("НоваяСсылка");
	
	ТЗ = Новый  ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ОбъектБыл");
	ТЗ.Колонки.Добавить("ОбъектСтал");
	ТЗ.Колонки.Добавить("ОбъектОстатка");
	Для сч = 1 По Объекты.количество() Цикл
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.ОбъектБыл = Объекты.получить(сч-1).Ид;
	КонецЦикла;	
	
	
	Для каждого СтрокаТз Из ТЗ Цикл		
		Если ТипЗнч(СтрокаТз.объектБыл) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			Если Объекты.Найти(СтрокаТз.ОбъектБыл.ИДРодителя,"Ид") = Неопределено Тогда
				// Значит, это верхний раздел.
				НовыйРаздел = СоздатьНовыйРаздел();
				СкопироватьРаздел(НовыйРаздел, СтрокаТз.ОбъектБыл);
				НомерБыл = ПолучитьНомерДокумента(СтрокаТз.объектБыл, "СМ_РазделЛокальнойСметы");   
				ЗаменитьРодителя(НовыйРодитель, НовыйРаздел);
				Если Корректировка И Не СтрокаТз.ОбъектБыл.КорректируетРаздел.Пустая() Тогда
					НовыйРаздел.КорректируетРаздел = ТабОбъекты.Найти(СтрокаТз.ОбъектБыл.КорректируетРаздел,"Ид").НоваяСсылка; 
				КонецЕсли;
				НовыйРаздел.Записать();
				УстановитьНомерДокумента(НовыйРаздел.Ссылка, НомерБыл.ПорНомер, , НомерБыл.ПорНомер, ,"СМ_РазделЛокальнойСметы");
				СтрокаТз.ОбъектСтал = ПолучитьСсылкуНаДокумент(НовыйРаздел,"СМ_РазделЛокальнойСметы"); 				
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	// Прошли верхний уровень, разделы, непосредственно подчиненные новому разделу. 	
	Для каждого СтрокаТз Из ТЗ Цикл
		Если ТипЗнч(СтрокаТз.объектБыл) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") И (СтрокаТз.ОбъектСтал = Неопределено) Тогда
			// Это раздел, который копируется в составе главного для себя раздела.
			// Необходимо создать новый раздел, и подчинить его копии главного раздела.
			НовыйРаздел = СоздатьНовыйРаздел();
			СкопироватьРаздел(НовыйРаздел, СтрокаТз.ОбъектБыл);
			НомерБыл = ПолучитьНомерДокумента(СтрокаТз.объектБыл, "СМ_РазделЛокальнойСметы");   
				
			нОтбор = Новый Структура;
			нОтбор.Вставить("ОбъектБыл",СтрокаТз.ОбъектБыл.ИдРодителя);
			
			нСтроки = ТЗ.НайтиСтроки(нОтбор);
			Если нСтроки.Количество() > 0 Тогда
				нСтрока = нСтроки.Получить(0);
				Если нСтрока.ОбъектСтал <> Неопределено Тогда
					ЗаменитьРодителя(нСтрока.ОбъектСтал, НовыйРаздел);
					Если Корректировка И Не СтрокаТз.ОбъектБыл.КорректируетРаздел.Пустая() Тогда
						НовыйРаздел.КорректируетРаздел = ТабОбъекты.Найти(СтрокаТз.ОбъектБыл.КорректируетРаздел,"Ид").НоваяСсылка; 
					КонецЕсли;
					НовыйРаздел.Записать();
					УстановитьНомерДокумента(НовыйРаздел.Ссылка, НомерБыл.ПорНомер, , НомерБыл.ПорНомер, ,"СМ_РазделЛокальнойСметы");
					СтрокаТз.ОбъектСтал = ПолучитьСсылкуНаДокумент(НовыйРаздел,"СМ_РазделЛокальнойСметы");
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден родитель для раздела %1'"), ПолучитьТекстИнформацииОРазделе(НовыйРаздел)));
				КонецЕсли;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден родитель для раздела %1'"), ПолучитьТекстИнформацииОРазделе(НовыйРаздел)));
			КонецЕсли;	
			
		КонецЕсли;	
	КонецЦикла;	   
	
	// Обработали возможные починенные разделы.	
	Для Каждого  СтрокаТз Из ТЗ Цикл
		Если (ТипЗнч(СтрокаТз.ОбъектБыл) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"))
			И (Не ЗначениеЗаполнено(СтрокаТз.ОбъектБыл.ИдПозицииВладельца)) Тогда
			
			НоваяПозиция = СоздатьНовуюПозицию();  //  Скопирована
			СкопироватьПозицию(НоваяПозиция, СтрокаТз.ОбъектБыл);
			НоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Скопирована;
			НоваяПозиция.ИсточникСоздания	= СтрокаТз.ОбъектБыл.Номер;	
			НомерБыл 	= ПолучитьНомерДокумента(СтрокаТз.объектБыл, "СМ_ПозицияЛокальнойСметы");   
			Разделяем 	= Ложь;
			Если РазделятьПозиции Тогда
				СтрокаОбъема = ТаблицаЗакрытыхОбъемов.Найти(СтрокаТз.ОбъектБыл);
				Если Не СтрокаОбъема = Неопределено Тогда
					Если СтрокаОбъема.ОбъемВсего > 0 И СтрокаОбъема.ОбъемВсего < СтрокаТз.объектБыл.ОбъемРабот Тогда
						НоваяПозиция.ОбъемРабот 		= СтрокаОбъема.ОбъемВсего;
						НоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Разделением;
						Остаток = СтрокаТз.объектБыл.ОбъемРабот - СтрокаОбъема.ОбъемВсего;
						Разделяем = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

			Если Объекты.Найти(НоваяПозиция.ИДРодителя,"Ид") <> Неопределено Тогда
				// Значит, эта позиция копируется в составе раздела.
				// Необходимо указать родителя - копию раздела.
			    нОтбор = Новый Структура;
				нОтбор.Вставить("ОбъектБыл",СтрокаТз.объектБыл.ИдРодителя);
				нСтроки = ТЗ.НайтиСтроки(нОтбор);
				Если нСтроки.Количество() > 0 Тогда
					нСтрока = нСтроки.Получить(0);
					Если нСтрока.ОбъектСтал <> Неопределено Тогда
						ЗаменитьРодителя(нСтрока.ОбъектСтал, НоваяПозиция);
						Если Корректировка И Не СтрокаТз.ОбъектБыл.КорректируетПозицию.Пустая() Тогда
							НоваяПозиция.КорректируетПозицию = ТабОбъекты.Найти(СтрокаТз.ОбъектБыл.КорректируетПозицию,"Ид").НоваяСсылка; 
						КонецЕсли;
						
						НоваяПозиция.Записать();
						УстановитьНомерДокумента(НоваяПозиция.Ссылка, НомерБыл.ПорНомер, , НомерБыл.НомерВДереве, ,"СМ_ПозицияЛокальнойСметы");
						
						СтрокаТз.объектСтал = ПолучитьСсылкуНаДокумент(НоваяПозиция, "СМ_ПозицияЛокальнойСметы");
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден родитель для позиции %1. Позиция не скопирована.'"), ПолучитьТекстИнформацииОПозиции(НоваяПозиция)));
					КонецЕсли;	
				КонецЕсли;	
			Иначе
				ЗаменитьРодителя(НовыйРодитель, НоваяПозиция);
				Если Корректировка И Не СтрокаТз.ОбъектБыл.КорректируетПозицию.Пустая() Тогда
					НоваяПозиция.КорректируетПозицию = ТабОбъекты.Найти(СтрокаТз.ОбъектБыл.КорректируетПозицию,"Ид").НоваяСсылка; 
				КонецЕсли;
				НоваяПозиция.Записать();
				УстановитьНомерДокумента(НоваяПозиция.Ссылка, НомерБыл.ПорНомер, , НомерБыл.НомерВДереве, ,"СМ_ПозицияЛокальнойСметы");
						
				СтрокаТз.объектСтал = ПолучитьСсылкуНаДокумент(НоваяПозиция, "СМ_ПозицияЛокальнойСметы");
			КонецЕсли;
			
			Если Разделяем Тогда
				Перенумеруем 			= Истина;
				РазделяемНоваяПозиция 	= СоздатьНовуюПозицию(); //Разделением 
				СкопироватьПозицию(РазделяемНоваяПозиция,НоваяПозиция);
				РазделяемНоваяПозиция.ОбъемРабот 		= Остаток;
				РазделяемНоваяПозиция.СпособСоздания	= Перечисления.СМ_ИсточникиДобавленияПозиций.Разделением;
				РазделяемНоваяПозиция.ИсточникСоздания	= НоваяПозиция.Номер;	
				РазделяемНоваяПозиция.Записать();
				СтрокаТз.ОбъектОстатка = РазделяемНоваяПозиция.Ссылка;
				НомерБыл 		= ПолучитьНомерДокумента(НоваяПозиция, "СМ_ПозицияЛокальнойСметы"); 
				НомерВДереве	= НомерБыл.НомерВДереве+0.01;
				УстановитьНомерДокумента(СтрокаТз.ОбъектОстатка,,, НомерВДереве, ,"СМ_ПозицияЛокальнойСметы"); 
				
				// надо прикрепить подчиненные расценки
				ПривязанныеПозиции = ПолучитьПривязанныеПозиции(СтрокаТз.ОбъектБыл);
				Для Каждого СтрПривязка Из ПривязанныеПозиции Цикл
					
					нОтбор = Новый Структура;
					нОтбор.Вставить("ОбъектБыл",СтрПривязка.Ссылка);
					нСтроки = ТЗ.НайтиСтроки(нОтбор);
					нСтрока = нСтроки.Получить(0);
					СтрокаОбъема = ТаблицаЗакрытыхОбъемов.Найти(СтрПривязка.Ссылка);
					Если Не СтрокаОбъема = Неопределено Тогда
						Если СтрокаОбъема.ОбъемВсего > 0 И СтрокаОбъема.ОбъемВсего < СтрПривязка.Ссылка.ОбъемРабот Тогда
							
							НомерВДереве = НомерВДереве+0.01;
							НоваяПозиция = СоздатьНовуюПозицию(); // Разделением
							СкопироватьПозицию(НоваяПозиция, СтрПривязка.Ссылка);
							НоваяПозиция.ИДПозицииВладельца = СтрокаТз.ОбъектОстатка;
							НоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Разделением;
							НоваяПозиция.ИсточникСоздания	= СтрПривязка.Ссылка.Номер;								
							ЗаменитьРодителя(СтрокаТз.ОбъектОстатка, НоваяПозиция);
							
							Остаток = СтрПривязка.Ссылка.ОбъемРабот - СтрокаОбъема.ОбъемВсего;
							НоваяПозиция.ОбъемРабот = Остаток;
							
							НовыйОбъем =  Остаток;
							СтарыйОбъем = СтрПривязка.Ссылка.ОбъемРабот;
							Если ЗначениеЗаполнено(НоваяПозиция.ФормулаОбъема) Тогда
								ВычОбъем = 0;
								Формула = "ВычОбъем = Значение";
								ФормулаОбъема = СтрЗаменить(НоваяПозиция.ФормулаОбъема,",",".");
								Формула = СтрЗаменить(Формула,"Значение",ФормулаОбъема);
								Попытка
									Выполнить(Формула);
									ТекОбъем = (ВычОбъем/СтарыйОбъем)*НовыйОбъем;
									Норма = ВычОбъем/СтарыйОбъем;
								Исключение
									Если СтарыйОбъем = 0 Тогда
										ТекОбъем = НовыйОбъем;
									Иначе
										ТекОбъем = (НоваяПозиция.ОбъемРабот/СтарыйОбъем)*НовыйОбъем;
										Норма = НоваяПозиция.ОбъемРабот/СтарыйОбъем;
									КонецЕсли;
								КонецПопытки;
							Иначе
								ТекОбъем = (НоваяПозиция.ОбъемРабот/СтарыйОбъем)*НовыйОбъем;
								Норма = НоваяПозиция.ОбъемРабот/СтарыйОбъем;
							КонецЕсли;
							Если СтарыйОбъем = 0 Тогда
								НоваяПозиция.ФормулаОбъема = "1" + "*" + СокрЛП(Строка(Формат(ТекОбъем,"ЧГ=0")));
							Иначе
								НоваяПозиция.ФормулаОбъема = СокрЛП(Строка(Формат(НовыйОбъем,"ЧГ=0"))) + "*" + СокрЛП(Строка(Формат(Норма,"ЧГ=0")));
							КонецЕсли;
							
							НоваяПозиция.Записать();
							УстановитьНомерДокумента(НоваяПозиция.Ссылка,,,НомерВДереве, ,"СМ_ПозицияЛокальнойСметы"); 
							нСтрока.ОбъектОстатка = НоваяПозиция.Ссылка;

						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;

		КонецЕсли;	
	КонецЦикла;	   
	
	// Обработали просты позиции, осталось обработать привязанные. 	
	Для Каждого  СтрокаТз Из ТЗ Цикл
		Если (ТипЗнч(СтрокаТз.ОбъектБыл) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"))
			И (ЗначениеЗаполнено(СтрокаТз.ОбъектБыл.ИдПозицииВладельца)) Тогда
			
			НоваяПозиция = СоздатьНовуюПозицию(); //  Скопирована
			СкопироватьПозицию(НоваяПозиция, СтрокаТз.ОбъектБыл);
			НоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Скопирована;
			НоваяПозиция.ИсточникСоздания	= СтрокаТз.ОбъектБыл.Номер;					
			НомерБыл 	= ПолучитьНомерДокумента(СтрокаТз.объектБыл, "СМ_ПозицияЛокальнойСметы");   
			Разделяем 	= Ложь;
			Если РазделятьПозиции Тогда
				СтрокаОбъема = ТаблицаЗакрытыхОбъемов.Найти(СтрокаТз.ОбъектБыл);
				Если Не СтрокаОбъема = Неопределено Тогда
					Если СтрокаОбъема.ОбъемВсего > 0 И СтрокаОбъема.ОбъемВсего < СтрокаТз.объектБыл.ОбъемРабот Тогда
						НоваяПозиция.ОбъемРабот = СтрокаОбъема.ОбъемВсего;
						Остаток = СтрокаТз.объектБыл.ОбъемРабот - СтрокаОбъема.ОбъемВсего;
						Разделяем = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;


			Если Объекты.Найти(СтрокаТз.ОбъектБыл.ИДПозицииВладельца,"Ид") <> Неопределено Тогда
				// Значит, эта позиция копируется в составе раздела.
				// Необходимо указать родителя - копию раздела.
			    нОтбор = Новый Структура;
				нОтбор.Вставить("ОбъектБыл",СтрокаТз.объектБыл.ИДПозицииВладельца);
				нСтроки = ТЗ.НайтиСтроки(нОтбор);
				Если нСтроки.Количество() > 0 Тогда
					нСтрока = нСтроки.Получить(0);
					Если нСтрока.ОбъектСтал <> Неопределено Тогда
						НоваяПозиция.ИДПозицииВладельца = нСтрока.ОбъектСтал;
						ЗаменитьРодителя(нСтрока.ОбъектСтал, НоваяПозиция);
						Если Корректировка И Не СтрокаТз.ОбъектБыл.КорректируетПозицию.Пустая() Тогда
							НоваяПозиция.КорректируетПозицию = ТабОбъекты.Найти(СтрокаТз.ОбъектБыл.КорректируетПозицию,"Ид").НоваяСсылка; 
						КонецЕсли;
						
						Если Разделяем Тогда
							НовыйОбъем =  нСтрока.ОбъектСтал.ОбъемРабот;
							СтарыйОбъем = СтрокаТз.объектБыл.ИДПозицииВладельца.ОбъемРабот;
							Если ЗначениеЗаполнено(НоваяПозиция.ФормулаОбъема) Тогда
								ВычОбъем = 0;
								Формула = "ВычОбъем = Значение";
								ФормулаОбъема = СтрЗаменить(НоваяПозиция.ФормулаОбъема,",",".");
								Формула = СтрЗаменить(Формула,"Значение",ФормулаОбъема);
								Попытка
									Выполнить(Формула);
									ТекОбъем = (ВычОбъем/СтарыйОбъем)*НовыйОбъем;
									Норма = ВычОбъем/СтарыйОбъем;
								Исключение
									Если СтарыйОбъем = 0 Тогда
										ТекОбъем = НовыйОбъем;
									Иначе
										ТекОбъем = (НоваяПозиция.ОбъемРабот/СтарыйОбъем)*НовыйОбъем;
										Норма = НоваяПозиция.ОбъемРабот/СтарыйОбъем;
									КонецЕсли;
								КонецПопытки;
							Иначе
								ТекОбъем = (НоваяПозиция.ОбъемРабот/СтарыйОбъем)*НовыйОбъем;
								Норма = НоваяПозиция.ОбъемРабот/СтарыйОбъем;
							КонецЕсли;
							Если СтарыйОбъем = 0 Тогда
								НоваяПозиция.ФормулаОбъема = "1" + "*" + СокрЛП(Строка(Формат(ТекОбъем,"ЧГ=0")));
							Иначе
								НоваяПозиция.ФормулаОбъема = СокрЛП(Строка(Формат(НовыйОбъем,"ЧГ=0"))) + "*" + СокрЛП(Строка(Формат(Норма,"ЧГ=0")));
							КонецЕсли;
						КонецЕсли;

						НоваяПозиция.Записать();
						УстановитьНомерДокумента(НоваяПозиция.Ссылка, НомерБыл.ПорНомер, , НомерБыл.НомерВДереве, ,"СМ_ПозицияЛокальнойСметы");
						СтрокаТз.ОбъектСтал = ПолучитьСсылкуНаДокумент(НоваяПозиция, "СМ_ПозицияЛокальнойСметы");						
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден родитель для позиции %1. Позиция не скопирована.'"), ПолучитьТекстИнформацииОПозиции(НоваяПозиция)));
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
			
			Если Разделяем Тогда
				Перенумеруем = Истина;
				нОтбор = Новый Структура;
				нОтбор.Вставить("ОбъектБыл",СтрокаТз.объектБыл.ИДПозицииВладельца);
				нСтроки = ТЗ.НайтиСтроки(нОтбор);
				Если нСтроки.Количество() > 0 Тогда
					нСтрока = нСтроки.Получить(0);
					Если Не ЗначениеЗаполнено(нСтрока.ОбъектОстатка) Тогда
						НоваяИДПозицииВладельца = СоздатьНовуюПозицию(); // Разделением
						СкопироватьПозицию(НоваяИДПозицииВладельца,нСтрока.ОбъектСтал);
						НоваяИДПозицииВладельца.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Разделением;
						НоваяИДПозицииВладельца.ИсточникСоздания	= нСтрока.ОбъектСтал.Номер;								
						НоваяИДПозицииВладельца.ОбъемРабот 			= 0;
						НоваяИДПозицииВладельца.Записать();
						нСтрока.ОбъектОстатка = НоваяИДПозицииВладельца.Ссылка;
						НомерБыл 		= ПолучитьНомерДокумента(нСтрока.ОбъектСтал, "СМ_ПозицияЛокальнойСметы"); 
						НомерВДереве 	= НомерБыл.НомерВДереве+0.01;
						УстановитьНомерДокумента(нСтрока.ОбъектОстатка,,, НомерВДереве, ,"СМ_ПозицияЛокальнойСметы"); 
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(СтрокаТз.ОбъектОстатка) Тогда	
						РазделяемНоваяПозиция = СоздатьНовуюПозицию(); // Разделением
						СкопироватьПозицию(РазделяемНоваяПозиция,НоваяПозиция);
						РазделяемНоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Разделением;
						РазделяемНоваяПозиция.ИсточникСоздания		= НоваяПозиция.Номер;							
						РазделяемНоваяПозиция.ИДПозицииВладельца 	= нСтрока.ОбъектОстатка;
						РазделяемНоваяПозиция.ОбъемРабот 			= Остаток;
						РазделяемНоваяПозиция.ФормулаОбъема 		= "";
						РазделяемНоваяПозиция.Записать();
						СтрокаТз.ОбъектОстатка = РазделяемНоваяПозиция.Ссылка;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;

		КонецЕсли;	
	КонецЦикла;	   
	
	КопироватьАкты = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","КопироватьАкты");
	КопироватьАкты = ?(КопироватьАкты = Неопределено,РазделятьПозиции,КопироватьАкты);
	
	Если КопироватьАкты Тогда
		ТаблицаАктов = ПолучитьАктыСметы(СтараяСмета);
		Для Каждого Стр Из ТаблицаАктов Цикл
			Если стр.Ссылка.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			НовыйАкт = СоздатьНовыйАкт();
			НовыйАкт.ЛокальнаяСмета = НовыйРодитель;
			СкопироватьАкт(НовыйАкт,стр.Ссылка,ТЗ);
			НовыйАкт.Стройка = НовыйРодитель.Стройка;
			НовыйАкт.Записать();
			Документы.СМ_АктВыполненныхРабот.Перерасчет(НовыйАкт);
		КонецЦикла;
	КонецЕсли;

	Для каждого СтрокаТз Из ТЗ Цикл
		Стр = Объекты.Найти(СтрокаТз.ОбъектБыл,"Ид");
		Стр.НоваяСсылка = СтрокаТз.ОбъектСтал;
	КонецЦикла;	

КонецПроцедуры	

// Копирует привязанные позиции.
//
// Параметры:
//     Объекты		 - Массив - ссылки на позиции, который нужно скопировать.
//     НовыйРодитель - ДокуметСсылка.СМ_ПозицияЛокальнойСметы - ссылка на новый документ-родитель.
//
Процедура СкопироватьПривязанныеПозиции(Объекты, НовыйРодитель) Экспорт
	
	НачатьТранзакцию();
	
	НомерПоПорядку = СМ_СметныйСоставВызовСервера.ПолучитьМаксимальныйНомерВДереве(?(ТипЗнч(НовыйРодитель) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"),НовыйРодитель,НовыйРодитель.ИДСметы));
	
	Для Каждого Позиция Из Объекты Цикл
		НоваяПозиция = СоздатьНовуюПозицию();  //  Скопирована
		СкопироватьПозицию(НоваяПозиция, Позиция);
		НоваяПозиция.ИДПозицииВладельца = НовыйРодитель;
		НоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Скопирована;
		НоваяПозиция.ИсточникСоздания	= Позиция.Номер;			
		ЗаменитьРодителя(НовыйРодитель, НоваяПозиция);
		НоваяПозиция.ДополнительныеСвойства.Вставить("Смета3");
		НоваяПозиция.Записать();
		УстановитьНомерДокумента(НоваяПозиция.Ссылка, НомерПоПорядку, , НомерПоПорядку, ,"СМ_ПозицияЛокальнойСметы");
		НомерПоПорядку = НомерПоПорядку + 1;
	КонецЦикла;	   
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры	

// Получает год выпуска (год базисных цен) в виде строки (для передачи во внешнюю базу).
//
// Параметры:
//     ГодВыпуска - Перечисления.СМ_ГодыВыпускаБазы - Год выпуска.
//
// Возвращаемое значение:
//     ГодВыпуска - Строка - содержит год нормативной базы.
//
Функция ПолучитьГодИзПеречисления(ГодВыпуска) Экспорт
	
	Год = "";
	Если ГодВыпуска = Перечисления.СМ_ГодыВыпускаБазы.г2009 Тогда
		Год = "2008";
	ИначеЕсли ГодВыпуска = Перечисления.СМ_ГодыВыпускаБазы.г2001 Тогда
		Год = "2001";
	ИначеЕсли ГодВыпуска = Перечисления.СМ_ГодыВыпускаБазы.г1984 Тогда
		Год = "1984";
	ИначеЕсли ГодВыпуска = Перечисления.СМ_ГодыВыпускаБазы.г1991 Тогда
		Год = "1991";
	Иначе
		Год = "2008";
	КонецЕсли;
	
	Возврат Год;
	
КонецФункции

// Заполняет версию сметно-нормативной базы для позиции локальной сметы.
//
// Параметры:
//     Позиция - ДокуметСсылка.СМ_ПозицияЛокальнойСметы - позиция в которой заполняется версия.
//
Процедура ЗаполнитьВерсиюПозиции(Позиция) Экспорт
	
	Если Не ЗначениеЗаполнено(Позиция.ИДСметы.ДатаТекущихЦен) Тогда
		Возврат;
	КонецЕсли;
	
	ДатаТекЦен = Формат(Позиция.ИДСметы.ДатаТекущихЦен,"ДФ=dd.MM.yyyy");
	Если ТипЗнч(Позиция) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		ПозицияЛС = Позиция.ПолучитьОбъект();
		ПозицияЛС.Версия = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Каталог текущих цен на %1.'"), ДатаТекЦен);
		ПозицияЛС.Записать();
	Иначе
		Позиция.Версия = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Каталог текущих цен на %1.'"), ДатаТекЦен);
	КонецЕсли;
	
КонецПроцедуры

// Загружает данные в позицию локальной сметы. 
// ВАЖНО! Позиция уже должна быть подготовлена, то есть функцию следует вызывать для новых позиций. 
// Для обновления уже существующих позиций - См. функцию ОбновитьДанныеВПозицииЛС().
// Возвращает структуру если есть неучтенные ресурсы ИЛИ ресурсы по проекту.
//
// Параметры:
//     Данные 				- Строка - данные в виде строки в формате XML.
//     Позиция 				- ДокуметСсылка.СМ_РазделЛокальнойСметы - раздел, в который добавляется позиция.
//     Интерактивно 		- Булево - опеределяет выполняются ли действия интерактивно.
//     СтруктураПараметров 	- Структура - содержит неучтенные ресурсы (чтобы показать их пользователю после вставки).
//     ПараметрыЛС 			- Структура - содержит реквизиты Локальной сметы.
//     ВерсияКомпоненты 	- Число - версия библиотеки ВНБ.
//     РезультатПозиция 	- ДокуметСсылка.СМ_ПозицияЛокальнойСметы - в переменную возвращается записанная позиция.
//	   НомерВДереве 		- Число - номер в дереве, который устанавливается.
//	   ЗаполнитьВерсию 		- Булево - признак определяющий необходимость заполнения версии сметно-нормативной базы.
//	   ПозицияВладелец		- ДокументСсылка.СМ_ПозицияЛокальнойСметы - ссылка на позицию-владелец для текущей позиции.
//
// Возвращаемое значение:
//     Структура, Неопределено - содержит неучтенные ресурсы (результат функции ПолучитьСтруктуруНеучтенныхРесурсов) 
//								 для данной позиции. Если неучтенных ресурсов нет, то результатом будет Неопределено.
//
Функция ЗагрузитьДанныеВПозициюЛС(Данные, Позиция = Неопределено, Интерактивно = Ложь, СтруктураПараметров = Неопределено, ПараметрыЛС = Неопределено, ВерсияКомпоненты = 1, РезультатПозиция = Неопределено, НомерВДереве = Неопределено, ЗаполнитьВерсию = Ложь, ПозицияВладелец = Неопределено) Экспорт 
		
	Если Данные = "" ИЛИ Данные = Неопределено ИЛИ ВерсияКомпоненты = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НРег(Данные) = "<collection />" ИЛИ НРег(Данные) = "<collection></collection>" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// 1. создаем позицию.
	Если (ТипЗнч(Позиция) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")) ИЛИ (ТипЗнч(Позиция) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета")) Тогда
		ПозицияЛС = СоздатьНовуюПозицию(); // ВнешняяНормативнаяБаза
		ЗаполнитьДанныеДокументаВСтруктуреСмет(ПозицияЛС, Позиция);
		Если Не ПозицияВладелец = Неопределено Тогда
			ПозицияЛС.ИДПозицииВладельца = ПозицияВладелец;
		КонецЕсли;
		ПозицияЛС.СпособСоздания	= Перечисления.СМ_ИсточникиДобавленияПозиций.ВнешняяНормативнаяБаза;
		ПозицияЛС.Расчет 			= Истина;
		ПозицияЛС.Дата 				= ТекущаяДатаСеанса();
		Обновление 					= Ложь;	
	ИначеЕсли (ТипЗнч(Позиция) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")) ИЛИ (ТипЗнч(Позиция) = Тип("ДокументОбъект.СМ_ПозицияЛокальнойСметы")) Тогда
		// Плохая ситуация - программист не прочел замечание (использовать ОбновитьДанныеВПозицииЛС()), но отработать надо.
		// Будет обновляться по живому.
		ПозицияЛС = Позиция.ПолучитьОбъект();
		ПозицияЛС.РесурсыПозицииЛокальнойСметы.Очистить();
		ПозицияЛС.СоставРабот.Очистить();
		Обновление = Истина;
	Иначе
		// Вообще не понятно что.
		Возврат Неопределено;
	КонецЕсли;
	
	// Так как при вставке позиции саму ЛС мы не меняем, не понятно зачем тащить объект.
	//	От предыдущей строки хорошо бы отказаться в пользу строки ниже.
	Если ПараметрыЛС = Неопределено Тогда
		ПараметрыЛС = ПолучитьСтруктуруПараметровРасчетаЛС(,ПозицияЛС);
	КонецЕсли;
	
	НачатьТранзакцию();
	
	// 2. Заполняем позицию данными.
	
	СМ_СметаЗагрузкаВызовСервера.ЗагрузитьДанныеВПозициюЛС(Данные, ПозицияЛС, ПараметрыЛС, ВерсияКомпоненты);
	
	// Ввод в базовых единицах.
	ВводОбъемовВБазовыхЕдИзм = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ВводОбъемовВБазовыхЕдИзм", Ложь);
	Если ВводОбъемовВБазовыхЕдИзм Тогда
		ПозицияЛС.ОбъемРабот = ПересчитатьВбазовыхЕдиницахИзмерения(ПозицияЛС,ПозицияЛС.ОбъемРабот);
		Если ЗначениеЗаполнено(ПозицияЛС.ФормулаОбъема) Тогда
			ПозицияЛС.ФормулаОбъема = ПересчитатьФормулаВбазовыхЕдиницахИзмерения(ПозицияЛС,ПозицияЛС.ФормулаОбъема);	
		КонецЕсли;
	КонецЕсли;
	
	// 3. Заполняем остальные параметры.
	
	// Подгружаем поправки.
	ПозицияЛС.ПоправкиПозиции.Очистить();
	ПолучитьПоправкиПоТехЧастям(ПозицияЛС.РегиональнаяБаза, ПозицияЛС.ТипНормативныхСборников, ПозицияЛС.ШифрРасценки, ПозицияЛС.ПоправкиПозиции, ПараметрыЛС);
	// Подгружаем ЧП.
	Документы.СМ_ПозицияЛокальнойСметы.ЗаполнитьНачисленияПозицииПоУмолчанию(ПозицияЛС);
	// Подгружаем НР и СП.
	Если (ПараметрыЛС.Методика1984) Тогда
		Документы.СМ_ПозицияЛокальнойСметы.ОбновитьНРиСП1984(ПозицияЛС, ПараметрыЛС);
	Иначе
		Документы.СМ_ПозицияЛокальнойСметы.ОбновитьНРиСП(ПозицияЛС, ПараметрыЛС);
	КонецЕсли;

	// Подгружаем Индексы.                            	
	// За этим придется сходить на клиент, пока что так.
	
	Если Обновление Тогда
		УдалитьПодчиненныеПозицииЛС(ПозицияЛС, Интерактивно);
	Иначе
		ПозицияЛС.ИсточникСоздания	= ПозицияЛС.ШифрРасценки;	
	КонецЕсли;
	
	Если ЗаполнитьВерсию Тогда
		ЗаполнитьВерсиюПозиции(ПозицияЛС);
	КонецЕсли;
	
	ПозицияЛС.Записать();
	
	Если Не НомерВДереве = Неопределено Тогда
		УстановитьНомерДокумента(ПозицияЛС.Ссылка, , , НомерВДереве, , "СМ_ПозицияЛокальнойСметы");
	КонецЕсли;
	
	// Расчет нормы расходов и сметной прибыли.
	
	// 4. Производим расчет позиции.
	
	Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(ПозицияЛС, Ложь);
	
	// TO DO - хорошо бы избавиться от второй записи - переделать расчет, чтобы не требовал записанного документа.
	ПозицияЛС.Записать();
	
	// Возвращаем созданную позицию для работы с индексами.
	РезультатПозиция = ПолучитьСсылкуНаДокумент(ПозицияЛС, "СМ_ПозицияЛокальнойСметы");
	
	ЗафиксироватьТранзакцию();
	
	Если Интерактивно Тогда
		Возврат ПолучитьСтруктуруНеучтенныхРесурсов(СтруктураПараметров, РезультатПозиция);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции

// Обновляет данные в уже существующей позиции лальной сметы. 
//	ВАЖНО! Позиция должна уже существовать и записана.
//	Для осоздания новых позиций - См. функцию ЗагрузитьДанныеВПозициюЛС().
//	Возвращает структуру если есть неучтенные ресурсы ИЛИ ресурсы по проекту.
//
// Параметры:
//     Данные 				- Строка - данные в виде строки в формате XML.
//     Позиция 				- ДокуметСсылка.СМ_ПозицияЛокальнойСметы - обновляемая позиция.
//     Интерактивно 		- Булево - определяет выполняются ли действия интерактивно.
//     СтруктураПараметров 	- Структура - содержит неучтенные ресурсы (чтобы показать их пользователю после вставки).
//     ПараметрыЛС 			- Структура - содержит реквизиты Локальной сметы.
//	   ВерсияКомпоненты 	- Число - версия библиотеки ВНБ.
//     Подмена 				- Булево - Истина, для подмены базы, по умолчанию = Ложь. 
//
// Возвращаемое значение:
//     Структура, Неопределено - содержит неучтенные ресурсы (результат функции ПолучитьСтруктуруНеучтенныхРесурсов) 
//								 для данной позиции. Если неучтенных ресурсов нет, то результатом будет Неопределено.
//
Функция ОбновитьДанныеВПозицииЛС(Данные, Позиция = Неопределено, Интерактивно = Ложь, СтруктураПараметров = Неопределено, ПараметрыЛС = Неопределено, ВерсияКомпоненты = 1,Подмена = Ложь) Экспорт
	
	Если Данные = "" ИЛИ Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Позиция) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		Позиция = Позиция.ПолучитьОбъект();
	КонецЕсли;	
	
	// 1. Сохраняем значения реквизитов, которые должны сохраниться.
	
	ШифрПозиции = Позиция.ШифрРасценки;
	
	СтруктураСоханяемыхПараметров = ПолучитьСтруктуруНеобновляемыхПолейПозиции(Позиция);
	
	НачатьТранзакцию();
	
	// 2. Очищаем позицию. 
	
	ОчиститьПозициюЛС(Позиция, Интерактивно, Подмена);
	
	// 3. Загружаем по новой из ВНБ.
	
	СМ_СметаЗагрузкаВызовСервера.ЗагрузитьДанныеВПозициюЛС(Данные, Позиция, ПараметрыЛС, ВерсияКомпоненты);
	
	Если (Не ЗначениеЗаполнено(Позиция.ШифрРасценки)) Тогда
		// Считаем что обновление не прошло.
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Нет данных в нормативной базе по позиции %1. Позиция не обновлена.'"), ШифрПозиции));
		ОтменитьТранзакцию();
		Возврат Неопределено;
	КонецЕсли;
	
	// 4. Восстанавливаем значения сохраненных параметров ИЛИ заполняем по умолчанию.   
	
	ЗаполнитьЗначенияСвойств(Позиция, СтруктураСоханяемыхПараметров);
	// Подгружаем поправки.
	// Позиция.ПоправкиПозиции.Загрузить(СтруктураСоханяемыхПараметров.ПоправкиПозиции);
	// Подгружаем ЧП.
	// Позиция.НачисленияПозиции.Загрузить(СтруктураСоханяемыхПараметров.НачисленияПозиции);
	ПолучитьПоправкиПоТехЧастям(Позиция.РегиональнаяБаза, Позиция.ТипНормативныхСборников, Позиция.ШифрРасценки, Позиция.ПоправкиПозиции,ПараметрыЛС);
	// Подгружаем ЧП.
	Документы.СМ_ПозицияЛокальнойСметы.ЗаполнитьНачисленияПозицииПоУмолчанию(Позиция);

	// Подгружаем НР и СП.
	Документы.СМ_ПозицияЛокальнойСметы.ОбновитьНРиСП(Позиция, ПараметрыЛС);
	// Подгружаем Индексы.
	// Это только на клиенте.
	
	Позиция.Записать();
	
	// 5. Производим расчет позиции.
	
	Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(Позиция, Ложь);  
	
	// TO DO - Хорошо бы избавиться от второй записи - переделать расчет, чтобы не требовал записанного документа.
	Позиция.Записать();
	
	ЗафиксироватьТранзакцию();
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Обновлена позиция %1'"), ШифрПозиции));
	
	Если Интерактивно Тогда
		Возврат ПолучитьСтруктуруНеучтенныхРесурсов(СтруктураПараметров, ПолучитьСсылкуНаДокумент(Позиция, "СМ_ПозицияЛокальнойСметы"));
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Удаляет подчиненные позиции (неучтенные ресурсы) позиции локальной сметы с видом материал.
//	Сама позиция не удаляется.
//	Удаляются только позиции с заполненным владельцем, для других случаев - см. функцию УдалитьПозициюЛС().
//	Возвращает ложь ИЛИ истина, удалось удалить ИЛИ нет.
//
// Параметры:
//     Позиция - 		ДокуметСсылка.СМ_ПозицияЛокальнойСметы	- позиция, у который удаляются подчиненные.
//
// Возвращаемое значение:
//     Булево - удаление выполнено успешно ИЛИ нет.
//
Функция УдалитьПодчиненныеПозицииЛСМатериалы(Позиция) Экспорт
	
	Если Не ЗначениеЗаполнено(Позиция.Ссылка) Тогда
		Возврат Ложь; 
		// Значит позиция не записана.
	КонецЕсли;
	
	НачатьТранзакцию();
	
	// Запускаем для подчиненных процедуру удаления УдалитьПозициюЛС(..).
	
	СписокПодчиненныхДокументов = ПолучитьТаблицуПодчиненных(Позиция, Ложь, Ложь, Истина); 
	
	Для Каждого ПодчиненныйДокументЭлемент Из СписокПодчиненныхДокументов Цикл
		Если ПодчиненныйДокументЭлемент.Ид.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал Тогда
			УдалитьПозициюЛС(ПодчиненныйДокументЭлемент.Ид, Ложь);	
		КонецЕсли;
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	Возврат Истина;
	
КонецФункции

// Удаляет подчиненные позиции (неучтенные ресурсы) позиции локальной сметы.
//	Сама позиция не удаляется.
//	Удаляются только позиции с заполненным владельцем, для других случаев - см. функцию УдалитьПозициюЛС().
//	Возвращает ложь ИЛИ истина, удалось удалить ИЛИ нет.
//
// Параметры:
//     Позиция - 		ДокуметСсылка.СМ_ПозицияЛокальнойСметы	- позиция, у который удаляются подчиненные.
//     Интерактивно - 	Булево		- выполняются ли действия интерактивно.
//
// Возвращаемое значение:
//     Булево - удаление выполнено успешно ИЛИ нет.
//
Функция УдалитьПодчиненныеПозицииЛС(Позиция, Интерактивно = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(Позиция.Ссылка) Тогда
		Возврат Ложь; 
		// Значит позиция не записана.
	КонецЕсли;
	
	НачатьТранзакцию();
	
	// Запускаем для подчиненных процедуру удаления УдалитьПозициюЛС(..).
	
	СписокПодчиненныхДокументов = ПолучитьТаблицуПодчиненных(Позиция, Ложь, Ложь, Истина); 
	
	Для Каждого ПодчиненныйДокументЭлемент Из СписокПодчиненныхДокументов Цикл
		
		УдалитьПозициюЛС(ПодчиненныйДокументЭлемент.Ид, Интерактивно);	
		
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	Возврат Истина;
	
КонецФункции

// Удаляет уже существующую позицию ИЛИ раздел локальной сметы.
//	Сама позиция ИЛИ раздел так же удаляется.
//	Если удалять сам объект не надо - см. функцию УдалитьПодчиненныеПозицииЛС().
//	Возвращает ложь ИЛИ истина, удалось удалить ИЛИ нет.
//
// Параметры:
//     Позиция - 		ДокуметСсылка	- позиция ИЛИ раздел, который удаляются.
//     Интерактивно - 	Булево			- выполняются ли действия интерактивно.
//
// Возвращаемое значение:
//     Булево - удаление выполнено успешно ИЛИ нет.
//
Функция УдалитьПозициюЛС(Позиция, Интерактивно = Ложь) Экспорт
	
	Удаление = Не Позиция.ПометкаУдаления;
	
	НачатьТранзакцию();
	
	// 1. Запускаем для подчиненных эту же процедуру удаления УдалитьПозициюЛС(..).
	
	СписокПодчиненныхДокументов = ПолучитьТаблицуПодчиненных(Позиция); 
	
	Для Каждого ПодчиненныйДокументЭлемент Из СписокПодчиненныхДокументов Цикл
		
		УдалитьПозициюЛС(ПодчиненныйДокументЭлемент.Ид, Интерактивно);	
		
	КонецЦикла;
	
	// 2. Удялаем текущий.
	Если Удаление Тогда
		УдалитьДвижения(Позиция);
	КонецЕсли;
	
	Если Позиция = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Смета = Позиция.ИДСметы;
	
	ДокОбъект = Позиция.ПолучитьОбъект();
	
	Попытка
		ДокОбъект.УстановитьПометкуУдаления(Удаление);
	Исключение
		Событие = НСтр("ru = 'Исключение Обработчики сметы (вызов сервера)'");
		СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
	КонецПопытки;
	
	Если Удаление И Пользователи.ЭтоПолноправныйПользователь(, , Ложь) Тогда
		Попытка
			ДокОбъект.Удалить();
		Исключение
			Событие = НСтр("ru = 'Исключение Обработчики сметы (вызов сервера)'");
			СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
		КонецПопытки;
	КонецЕсли;
	ЗафиксироватьТранзакцию();
	
	Возврат Истина;
	
КонецФункции

// Создает позицию на основании справочника нормативных сборников.
//
// Параметры:
//     ЛокальнаяСмета 				- ДокументСсылка.СМ_ЛокальнаяСмета - Смета, в которую добавляется позиция.
//     ЭлементСправочникаНормативныеСборники - СправочникСсылка.СМ_НормативныеСборники - Элемент справочника, 
//											   по которому происходит заполнение.
//     Родитель 					- ДокументСсылка.СМ_РазделЛокальнойСметы - Ссылка на раздел локальной сметы, 
//									  куда добавляется позиция.
//	   НомерВДереве 				- Число - номер в дереве, который устанавливается.
//     СтруктураНеучтенныхРесурсов 	- Структура - содержит неучтенные ресурсы (чтобы показать их пользователю после вставки).
//     РезультатПозиция 			- ДокументСсылка.СМ_ПозицияЛокальнойСметы - в переменную возвращается записанная позиция.
//	   Объем						- Число - объем работ позиции.
//	   ДанныеЦен                    - ТаблицаЗначений - содержит данные о ценах. 
//	   ТаблицаКонструктивов 		- ТаблицаЗначений - содержит данные для заполнения табличной части констурктивов.
//
// Возвращаемое значение:
//     Структура - содержит неучтенные ресурсы (результат функции ПолучитьСтруктуруНеучтенныхРесурсов) 
//				   для данной позиции. Если неучтенных ресурсов нет, то результатом будет неопределено.
//
Функция СоздатьПозициюЛокальнойСметыПутемПодбораИзНормативногоСборника(ЛокальнаяСмета, ЭлементСправочникаНормативныеСборники, Родитель, НомерВДереве, СтруктураНеучтенныхРесурсов = Неопределено, РезультатПозиция = Неопределено, Объем = 0, ДанныеЦен = Неопределено, ТаблицаКонструктивов = Неопределено) Экспорт
	
	НовыйДокументПЛС 					= СоздатьНовуюПозицию();  // НормативныеСборники 
	НовыйДокументПЛС.Дата 				= ЛокальнаяСмета.Дата;
	НовыйДокументПЛС.Расчет 			= Истина;
	НовыйДокументПЛС.ОбъемРабот 		= Объем;
	НовыйДокументПЛС.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.НормативныеСборники;
	НовыйДокументПЛС.ИсточникСоздания	= ЭлементСправочникаНормативныеСборники.КодНормативнойРасценки;	
	
	ЗаполнениеРеквизитовПЛС(НовыйДокументПЛС, ЭлементСправочникаНормативныеСборники, ЛокальнаяСмета,ДанныеЦен);
	ЗаполнитьДанныеДокументаВСтруктуреСмет(НовыйДокументПЛС, Родитель);
	
	// ++ AVV Заполнение нормы расхода ресурса
	Если НовыйДокументПЛС.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал ИЛИ 
		 НовыйДокументПЛС.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование Тогда
		НовыйДокументПЛС.НормаРасходаРесурса = 1;
		НовыйДокументПЛС.КоличествоРесурса 	= НовыйДокументПЛС.ОбъемРабот / НовыйДокументПЛС.НормаРасходаРесурса;
	КонецЕсли;
	// -- AVV
	
	Если ТаблицаКонструктивов <> Неопределено Тогда
		НовыйДокументПЛС.Конструктивы.Загрузить(ТаблицаКонструктивов);	
	КонецЕсли;
	
	НовыйДокументПЛС.Записать();
	
	УстановитьНомерДокумента(НовыйДокументПЛС.Ссылка, , , НомерВДереве, , "СМ_ПозицияЛокальнойСметы");
	
	Документы.СМ_ПозицияЛокальнойСметы.ЗаполнитьНачисленияПозицииПоУмолчанию(НовыйДокументПЛС);
	Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(НовыйДокументПЛС, Ложь);
	
	НовыйДокументПЛС.Записать();
	
	РезультатПозиция = ПолучитьСсылкуНаДокумент(НовыйДокументПЛС);
	
	Возврат ПолучитьСтруктуруНеучтенныхРесурсов(СтруктураНеучтенныхРесурсов, РезультатПозиция);
	
КонецФункции

// Создает позицию на основании справочника ресурсов.
//
// Параметры:
//     ЛокальнаяСмета 				- ДокументСсылка.СМ_ЛокальнаяСмета - смета, в которую добавляется позиция.
//     ЭлементСправочникаРесурсов 	- СправочникСсылка.СМ_Ресурсы - элемент справочника "ресурсы", по которому происходит заполнение.
//     Родитель 					- ДокументСсылка.СМ_РазделЛокальнойСметы - ссылка на раздел локальной сметы, куда добавляется позиция.
//     СтруктураОписанияРесурса 	- Структура - содержит поля описывающие ресурс.
//	   НомерВДереве 				- Число - номер в дереве, который устанавливается.
//     СтруктураНеучтенныхРесурсов 	- Структура - содержит неучтенные ресурсы (чтобы показать их пользователю после вставки).
//     РезультатПозиция 			- ДокументСсылка.СМ_ПозицияЛокальнойСметы - в переменную возвращается записанная позиция.
//	   Объем                        - Число - объем работ позиции.
//	   ПозицияВладелец				- ДокументСсылка.СМ_ПозицияЛокальнойСметы - ссылка на позицию-владелец для текущей позиции.
//
// Возвращаемое значение:
//     Структура - содержит неучтенные ресурсы (результат функции ПолучитьСтруктуруНеучтенныхРесурсов) для данной позиции.
//	   Если неучтенных ресурсов нет, то результатом будет неопределено.
//
Функция СоздатьПозициюЛокальнойСметыПутемПодбораИзСправочникаРесурсы(ЛокальнаяСмета, ЭлементСправочникаРесурсов, Родитель,СтруктураОписанияРесурса, НомерВДереве, СтруктураНеучтенныхРесурсов = Неопределено, РезультатПозиция = Неопределено, Объем = 0, ПозицияВладелец = Неопределено) Экспорт
	
	ПолучитьОписаниеРесурса(СтруктураОписанияРесурса);
	
	ПозицияРесурс 				= СоздатьНовуюПозицию(); // Ресурсы
	ПозицияРесурс.Дата 			= ЛокальнаяСмета.Дата;
	ПозицияРесурс.Расчет 		= Истина;
	ПозицияРесурс.ОбъемРабот 	= Объем;
	ПозицияРесурс.Наименование 	= ?(ЗначениеЗаполнено(СтруктураОписанияРесурса.Ресурс),СтруктураОписанияРесурса.Ресурс.ДлинноеНаименование,СтруктураОписанияРесурса.НаименованиеРесурса);
	Если ЗначениеЗаполнено(СтруктураОписанияРесурса.Код) Тогда
		ПозицияРесурс.ШифрРасценки = СтруктураОписанияРесурса.Код; 
	Иначе
		ПозицияРесурс.ШифрРасценки = СтруктураОписанияРесурса.Ресурс.Код;
	КонецЕсли;
	ПозицияРесурс.ЕдиницаИзмерения 		= ?(ЗначениеЗаполнено(СтруктураОписанияРесурса.ЕдИзм),СтруктураОписанияРесурса.ЕдИзм,СтруктураОписанияРесурса.ЕдиницаИзмеренияРесурса);
	ПозицияРесурс.Измеритель 			= ?(ЗначениеЗаполнено(СтруктураОписанияРесурса.ЕдИзм),ПозицияРесурс.ЕдиницаИзмерения.Наименование,СтруктураОписанияРесурса.ЕдиницаИзмеренияРесурса);
	ПозицияРесурс.РегиональнаяБаза 		= СтруктураОписанияРесурса.РегиональнаяБаза;
	ПозицияРесурс.НеПрименятьИндексы 	= СтруктураОписанияРесурса.НеИндексировать;
	ПозицияРесурс.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Ресурсы;
	ПозицияРесурс.ИсточникСоздания		= ПозицияРесурс.ШифрРасценки;	
	
	СтруктураПараметровЛС 	= ПолучитьСтруктуруПараметровРасчетаЛС(ЛокальнаяСмета);
	Район 					= СтруктураПараметровЛС.Район;
	ДатаТекущихЦен 			= СтруктураПараметровЛС.ДатаТекущихЦен;
	РегиональнаяБаза 		= СтруктураПараметровЛС.РегионДляВыбораЦен;
	
	Если ЛокальнаяСмета.АвтозагрузкаЦен
		И Не ЗначениеЗаполнено(ЛокальнаяСмета.ФайлСборникаТекущихЦен) Тогда
		СтруктураЦен = Неопределено;
		ПолучитьЦеныНовогоРесурса(ЭлементСправочникаРесурсов,Район,РегиональнаяБаза,ДатаТекущихЦен,СтруктураЦен,Истина);
		
		Если Не ЗначениеЗаполнено(СтруктураОписанияРесурса.ТекущаяЦена) Тогда
			СтруктураОписанияРесурса.ТекущаяЦена = СтруктураЦен.ТекущаяЦена;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтруктураОписанияРесурса.ТекущаяЗарплМаш) Тогда
			СтруктураОписанияРесурса.ТекущаяЗарплМаш = СтруктураЦен.ТекущаяЗарплатаМашинистов;
		КонецЕсли;

		СтруктураОписанияРесурса.БазиснаяЦена = СтруктураЦен.БазиснаяЦена;
		СтруктураОписанияРесурса.БазиснаяЗарплМаш = СтруктураЦен.БазиснаяЗарплатаМашинистов;
	Иначе
		СтруктураЦен = Неопределено;
		ПолучитьЦеныНовогоРесурса(ЭлементСправочникаРесурсов,Район,РегиональнаяБаза,ДатаТекущихЦен,СтруктураЦен);
		СтруктураОписанияРесурса.БазиснаяЦена = СтруктураЦен.БазиснаяЦена;
		СтруктураОписанияРесурса.БазиснаяЗарплМаш = СтруктураЦен.БазиснаяЗарплатаМашинистов;
	КонецЕсли;
	
	Если СтруктураОписанияРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
		ПозицияРесурс.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;
		ПозицияРесурс.Определитель = Справочники.СМ_Определители.НайтиПоКоду("19");
		ПозицияРесурс.СтоимМатериалов = СтруктураОписанияРесурса.БазиснаяЦена;
		ПозицияРесурс.ТекущаяЦена = СтруктураОписанияРесурса.ТекущаяЦена;
	ИначеЕсли СтруктураОписанияРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
		ПозицияРесурс.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин;
		ПозицияРесурс.Определитель = Справочники.СМ_Определители.НайтиПоКоду("1");
		ПозицияРесурс.ЗарплМашинистов = СтруктураОписанияРесурса.БазиснаяЗарплМаш;
		ПозицияРесурс.ЭксплМашин = СтруктураОписанияРесурса.БазиснаяЦена;
		ПозицияРесурс.ТекущаяЗарплатаМашинистов = СтруктураОписанияРесурса.ТекущаяЗарплМаш;
		ПозицияРесурс.ТекущаяЦена = СтруктураОписанияРесурса.ТекущаяЦена;
	КонецЕсли;
	ПозицияРесурс.ПрямЗатраты = СтруктураОписанияРесурса.БазиснаяЦена;
	
	// ++ AVV Заполнение нормы расхода ресурса
	Если СтруктураОписанияРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы ИЛИ 
		 СтруктураОписанияРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Оборудование Тогда
		ПозицияРесурс.НормаРасходаРесурса = 1;
		ПозицияРесурс.КоличествоРесурса = ПозицияРесурс.ОбъемРабот / ПозицияРесурс.НормаРасходаРесурса;
	КонецЕсли;
	// -- AVV

	ЗаполнитьДанныеДокументаВСтруктуреСмет(ПозицияРесурс, Родитель);
	Если Не ПозицияВладелец = Неопределено Тогда
		ПозицияРесурс.ИДПозицииВладельца = ПозицияВладелец;
	КонецЕсли;

	ПозицияРесурс.Записать();
	
	УстановитьНомерДокумента(ПозицияРесурс.Ссылка, , , НомерВДереве, , "СМ_ПозицияЛокальнойСметы");
	
	Документы.СМ_ПозицияЛокальнойСметы.ЗаполнитьНачисленияПозицииПоУмолчанию(ПозицияРесурс);
	
	Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(ПозицияРесурс, Ложь);
	
	ПозицияРесурс.Записать();
	
	РезультатПозиция = ПолучитьСсылкуНаДокумент(ПозицияРесурс);
	
	Возврат Неопределено;
	
КонецФункции

// Обновление позиции на основании справочника нормативных сборников.
//
// Параметры:
//	   Позиция						- ДокументСсылка.СМ_ПозицияЛокальнойСметы - позиция, которая обновляется.	
//     ЛокальнаяСмета 				- ДокументСсылка.СМ_ЛокальнаяСмета - смета, в которую добавляется позиция.
//     Родитель 					- ДокументСсылка.СМ_РазделЛокальнойСметы - ссылка на раздел локальной сметы, куда добавляется позиция.
//     НормативныйСборник			- СправочникСсылка.СМ_НормативныеСборники - ссылка на справочник "нормативные сборники", по которому происходит заполнение.
//	   ДанныеЦен                    - ТаблицаЗначений - содержит данные о ценах. 
//
// Возвращаемое значение:
//     Позиция - содержит ссылку на обновленную позицию.
//
Функция ОбновитьПозициюПоНормативномуСборнику(Позиция,ЛокальнаяСмета,Родитель,НормативныйСборник,ДанныеЦен = Неопределено) Экспорт
	
	СМ_СметаВызовСервера.ЗаполнениеРеквизитовПЛС(Позиция, НормативныйСборник, ЛокальнаяСмета,ДанныеЦен);
	СМ_СметаВызовСервера.ЗаполнитьДанныеДокументаВСтруктуреСмет(Позиция, Родитель);
	
	Если Позиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал ИЛИ 
		Позиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование Тогда
		Позиция.НормаРасходаРесурса = 1;
		Позиция.КоличествоРесурса 	= Позиция.ОбъемРабот / Позиция.НормаРасходаРесурса;
	КонецЕсли;

	Документы.СМ_ПозицияЛокальнойСметы.ЗаполнитьНачисленияПозицииПоУмолчанию(Позиция);
	Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(Позиция,Ложь);
	Позиция.Записать();
	
	Возврат Позиция;
	
КонецФункции

// Создает список позиций на основании справочника Фрагменты.
//
// Параметры:
//     ЛокальнаяСмета 			- ДокументСсылка.СМ_ЛокальнаяСмета - смета, в которую добавляется позиция.
//     СНБ 						- СправочникСсылка.СМ_СметноНормативныеБазы - текущая сметно-нормативная база. 
//     Фрагмент 				- СправочникСсылка.СМ_Фрагменты	- элемент справочника "Фрагменты", по которому происходит заполнение.
//     ФормулаОбъемаФрагмента 	- Строка, Число - формула объема вводимого фрагмента.
//     Родитель 				- ДокументСсылка.СМ_РазделЛокальнойСметы - ссылка на раздел локальной сметы, куда добавляются позиция.
// 	   СозданныеПозиции 		- СписокЗначений - содержит созданные позиции.
//	   НомерВДереве 			- Число - номер в дереве, который устанавливается.
//
Процедура СоздатьПозициюЛокальнойСметыПутемПодбораИзФрагментов(ЛокальнаяСмета, СНБ, Фрагмент, ФормулаОбъемаФрагмента, Родитель, СозданныеПозиции, НомерВДереве) Экспорт
	
	ПозицияВладелец = Неопределено;
	СписокПозиций = Фрагмент.РасценкиФрагмента;
	СчПоз = 1;
	Для каждого СтрокаПозиции  Из СписокПозиций Цикл 
		НовыйДокументПозиция = СоздатьНовуюПозицию(); // ВнешняяНормативнаяБаза 
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Обрабатывается расценка %1'")+" ", СокрЛП(Строка(СчПоз)));
		Сообщение.Сообщить();						
		СчПоз = СчПоз +1;
		Если СтрокаПозиции.Привязка = Истина Тогда 
			Если  ПозицияВладелец <> Неопределено Тогда
				ЗаполнитьДанныеДокументаВСтруктуреСмет(НовыйДокументПозиция, ПозицияВладелец, Истина);
			Иначе
				ЗаполнитьДанныеДокументаВСтруктуреСмет(НовыйДокументПозиция, Родитель,Ложь);
			КонецЕсли;	
		Иначе
			ЗаполнитьДанныеДокументаВСтруктуреСмет(НовыйДокументПозиция, Родитель,Ложь);
		КонецЕсли;
		НовыйДокументПозиция.Дата 						= ЛокальнаяСмета.Дата;
		НовыйДокументПозиция.Расчет 					= Истина;
		НовыйДокументПозиция.ТипНормативныхСборников 	= СтрокаПозиции.ТипНормативныхСборников;
		НовыйДокументПозиция.ШифрРасценки 				= СтрокаПозиции.ШифрРасценки;
		НовыйДокументПозиция.Наименование 				= СтрокаПозиции.НаименованиеРасценки;
		НовыйДокументПозиция.ЕдиницаИзмерения 			= СтрокаПозиции.ЕдиницаИзмерения;
		НовыйДокументПозиция.Измеритель 				= СтрокаПозиции.Измеритель;
		НовыйДокументПозиция.Определитель 				= СтрокаПозиции.Определитель;
		НовыйДокументПозиция.СпособСоздания				= Перечисления.СМ_ИсточникиДобавленияПозиций.ВнешняяНормативнаяБаза;
		НовыйДокументПозиция.ИсточникСоздания			= СтрокаПозиции.ШифрРасценки;
		НоваяФормула 	= ОтредактироватьФормулу(СокрЛП(СтрокаПозиции.ФормулаОбъема));
		ЭтоЧисло 		= ПроверитьФормулуФрагмента(СокрЛП(ФормулаОбъемаФрагмента));
	
		Если СокрЛП(ФормулаОбъемаФрагмента) = "1" Или СокрЛП(ФормулаОбъемаФрагмента = "") Тогда
			ФормулаОбъема = НоваяФормула;
		Иначе
			Если НоваяФормула = "" Тогда
				Если ЭтоЧисло Тогда
					ФормулаОбъема =  "0*" + ФормулаОбъемаФрагмента;
				Иначе
					ФормулаОбъема =  "0*(" + ФормулаОбъемаФрагмента + ")";
				КонецЕсли;
			Иначе	
				Если ЭтоЧисло Тогда
					ФормулаОбъема = "(" + НоваяФормула + ")*" + ФормулаОбъемаФрагмента ;
				Иначе
					ФормулаОбъема = "(" + НоваяФормула + ")" + "*(" + ФормулаОбъемаФрагмента + ")";
				КонецЕсли;
			КонецЕсли;
			ФормулаОбъема = СтрЗаменить(ФормулаОбъема,",",".");
		КонецЕсли;
		ОбъемРабот = 0;
		Формула = "ОбъемРабот = Значение";
		Формула = СтрЗаменить(Формула,"Значение", ФормулаОбъема);
		Попытка
			Выполнить(Формула);
		Исключение
			Событие = НСтр("ru = 'Исключение Обработчики сметы (вызов сервера)'");
			СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
		КонецПопытки;
		НовыйДокументПозиция.ОбъемРабот = ОбъемРабот;
		НовыйДокументПозиция.ФормулаОбъема = ФормулаОбъема;
		
		Документы.СМ_ПозицияЛокальнойСметы.ЗаполнитьНачисленияПозицииПоУмолчанию(НовыйДокументПозиция);
		
		НовыйДокументПозиция.Записать();
		
		РезультатПозиция = ПолучитьСсылкуНаДокумент(НовыйДокументПозиция);
		
		УстановитьНомерДокумента(РезультатПозиция, , , НомерВДереве, , "СМ_ПозицияЛокальнойСметы");
	
		Если СтрокаПозиции.Привязка = Ложь Тогда
			ПозицияВладелец = РезультатПозиция;	
		КонецЕсли;	
		Если СтрокаПозиции.ОбрабатыватьПоПроекту = Истина Тогда
			Представл = "Истина";
			
		Иначе
			Представл = "Ложь";
		КонецЕсли;	
		СозданныеПозиции.Добавить(РезультатПозиция,Представл);
		НомерВДереве = НомерВДереве+0.01;
	КонецЦикла;	
	
КонецПроцедуры

Функция ОтредактироватьФормулу(ТекФормула)
	ТекФормула = СтрЗаменить(ТекФормула,",",".");
	НоваяФормула = "";
	СтрокаСимв = "1234567890+-*/().";	
	Для сч = 1 По СтрДлина(ТекФормула) Цикл
		ТекСимв = Сред(ТекФормула,Сч,1);
		Если Найти(СтрокаСимв,ТекСимв) <> 0 Тогда
			НоваяФормула = НоваяФормула + ТекСимв;
		КонецЕсли;
	КонецЦикла;	
	Возврат(НоваяФормула);
КонецФункции	

Функция ПроверитьФормулуФрагмента(ФормулаОбъемаФрагмента)
	ЭтоЧисло = Истина;
	ТекФормула = СтрЗаменить(ФормулаОбъемаФрагмента,",",".");
	СтрокаДействий = "+-*/()";	
	Для сч = 1 По СтрДлина(ТекФормула) Цикл
		ТекСимв = Сред(ТекФормула,Сч,1);
		Если Найти(СтрокаДействий,ТекСимв) <> 0 Тогда
			ЭтоЧисло = Ложь;
		КонецЕсли;	
	КонецЦикла;	
	Возврат(ЭтоЧисло);
КонецФункции	

// Процедура заполнения ТЧ Начисления позиции из позиции-источник.
Процедура ПереноситьЧП(ПозицияИсточник,НоваяПозиция)
	ПозицияОбъект = ПозицияИсточник.ПолучитьОбъект();
	ТЧНачисления = ПозицияОбъект.НачисленияПозиции;
	Для каждого СтрокаИсточник Из ТЧНачисления Цикл
		СтрокаПриемник = НоваяПозиция.НачисленияПозиции.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПриемник,СтрокаИсточник);
	КонецЦикла;	
	
КонецПроцедуры	

// Процедура заполнения ТЧ Поправки позиции из позиции-источник.
Процедура ПереноситьПоправки(ПозицияИсточник,НоваяПозиция)
	ПозицияОбъект = ПозицияИсточник.ПолучитьОбъект();
	ТЧПоправки = ПозицияОбъект.ПоправкиПозиции;
	Для каждого СтрокаИсточник Из ТЧПоправки Цикл
		СтрокаПриемник = НоваяПозиция.ПоправкиПозиции.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПриемник,СтрокаИсточник);
	КонецЦикла;	
	
КонецПроцедуры	

// Процедура перенесения примечания в позицию из позиции-источник.
Процедура ПереноситьПримечание(ПозицияИсточник,НоваяПозиция)
	ПозицияОбъект = ПозицияИсточник.ПолучитьОбъект();
	НоваяПозиция.Примечание = ПозицияОбъект.Примечание;
	
КонецПроцедуры	
	                                
// Заполняет поля с идентификаторами в документах так, чтобы структура их в дереве смет была правильной.
//
// Параметры:
//     ТекущийДокумент 	- ДокументСсылка - создаваемый, обновляемый, перемещаемый документ.
//     ДокументРодитель - ДокументСсылка - документ, которому подчинен текущий.
//	   НеучтенныйРесурс - Булево - признак неучтенного ресурса.
//
Процедура ЗаполнитьДанныеДокументаВСтруктуреСмет(ТекущийДокумент, ДокументРодитель, НеучтенныйРесурс = Ложь) Экспорт
	
	ТекущийДокумент.ИДРодителя = ПолучитьСсылкуНаДокумент(?(НеучтенныйРесурс, ДокументРодитель.ИДРодителя, ДокументРодитель));
	ТекущийДокумент.ИДСметы = НайтиЛС(ДокументРодитель);
	Если ПолучитьСсылкуНаДокумент(ТекущийДокумент).Метаданные().Имя = "СМ_ПозицияЛокальнойСметы" Тогда
		ТекущийДокумент.ИДПозицииВладельца = ?(НеучтенныйРесурс, ПолучитьСсылкуНаДокумент(ДокументРодитель), Документы.СМ_ПозицияЛокальнойСметы.ПустаяСсылка());  	
	КонецЕсли;	
	
КонецПроцедуры

// Создает новый документ позиции и возвращает ДокументОбъект.СМ_ПозицияЛокальнойСметы.
//
// Возвращаемое значение:
