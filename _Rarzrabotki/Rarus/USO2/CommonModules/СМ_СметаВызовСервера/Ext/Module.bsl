// Возвращает нормативы НР и СП, подходящие под условия отбора (Тип, Район, Шифр).
//
// Параметры:
//     ТипНормСборн 		- ПеречислениеСсылка.СМ_ТипНормативногоСборника	- ссылка на тип нормативного сборника.
//     ТипРайона 			- ПеречислениеСсылка.СМ_ТипыРайонов - ссылка на тип района.
//     ШифрРасценки 		- Строка - сметный шифр позиции.
//	   МетодикаРасчета		- СправочникСсылка.СМ_МетодикиРасчета - ссылка на методику расчета.	
//	   МетодикаКазахстана   - Булево - признак, определяющий применение данной методики. 
//                        
// Возвращаемое значение:
//     Норматив - СправочникСсылка.СМ_НормативыНРиСП - ссылка на нормативы или Неопределено (если не найдено).
//
Функция ПолучитьНормативыНРиСП(ТипНормСборн, ТипРайона, ШифрРасценки, МетодикаРасчета, МетодикаКазахстана = Ложь) Экспорт
	
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ
	|	НормативыНРиСПНормативы.Ссылка
	|ИЗ
	|	Справочник.СМ_НормативыНРиСП.Нормативы КАК НормативыНРиСПНормативы
	|ГДЕ
	|	НормативыНРиСПНормативы.ТипРайона = &ТипРайона И
	|	НормативыНРиСПНормативы.Ссылка.Родитель.ТипНормативногоСборника = &ТипНормативногоСборника И
	|	(НормативыНРиСПНормативы.Ссылка.Методика = &Методика ИЛИ НормативыНРиСПНормативы.Ссылка.Методика = &ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Методика",МетодикаРасчета);
	Запрос.УстановитьПараметр("ПустаяСсылка",Справочники.СМ_МетодикиРасчета.ПустаяСсылка());
	Запрос.УстановитьПараметр("ТипРайона",ТипРайона);
	Запрос.УстановитьПараметр("ТипНормативногоСборника",ТипНормСборн);
	
	ВыборкаСборника = Запрос.Выполнить().Выбрать();
	ВключитьНРиСП 	= Ложь;
	
	Пока ВыборкаСборника.Следующий()  Цикл
		
		НомерСборника 		= Строка(ОпределитьНомерСборника(ТипНормСборн, ШифрРасценки,,МетодикаКазахстана)); 
		СписокСборников_ 	= ВернутьСписокРасценок(ВыборкаСборника.Ссылка.СписокНомеровСборников, Истина);
		
		Если Входит(НомерСборника, СписокСборников_) Тогда
			ПозицияПоследнегоДефиса = 0;
			Для х1 = 1 По СтрДлина(ШифрРасценки) Цикл
				ТекущийСимвол = Сред(ШифрРасценки, х1, 1);
				Если ТекущийСимвол = "-" Тогда
					ПозицияПоследнегоДефиса = х1;
				КонецЕсли;	
			КонецЦикла;
			
			СписокСборников_ = ВернутьСписокРасценок(ВыборкаСборника.Ссылка.СписокРасценок);
			Если  СписокСборников_.Количество() = 0 Тогда
				Возврат ВыборкаСборника.Ссылка;	
			КонецЕсли;	
			
			Для Сч = 0 По СписокСборников_.Количество()-1 Цикл
				Диапазон = СписокСборников_.Получить(Сч).Представление;
				ЕстьТильда = ?(Найти(Диапазон,"~") = 0, Ложь, Истина); 
				ЕстьРасценка = ?(Найти(Диапазон,"-")= 0,Ложь, Истина);
				НовыйСписок = Новый СписокЗначений();
				НовыйСписок.Добавить(СписокСборников_.Получить(Сч).Значение,Диапазон);
				Если ЕстьРасценка = Ложь И ЕстьТильда = Ложь Тогда
					// Берется только отдел шифра, ни диапазона, ни таблицы нет.
					ПозицияПервогоДефиса  	= Найти(ШифрРасценки,"-");
					ПромШифр 				= Сред(ШифрРасценки, ПозицияПервогоДефиса + 1);
					ПозицияВторогоДефиса  	= Найти(ПромШифр,"-");
					ПромШифр 				= Лев(ПромШифр, ПозицияВторогоДефиса-1);
					ВключитьНРиСП 			= ?(НовыйСписок = "", Истина, Входит(ПромШифр, НовыйСписок));
				Иначе
					ПромШифр 		= Лев(ШифрРасценки,ПозицияПоследнегоДефиса-1);
					ВключитьНРиСП 	= ?(НовыйСписок = "", Истина, Входит(Прав(ПромШифр,СтрДлина(ПромШифр)-3), НовыйСписок));
				КонецЕсли;
				
				Если ВключитьНРиСП Тогда
					Прервать;
				КонецЕсли;	
			КонецЦикла;	

			Если ВключитьНРиСП Тогда
				Возврат ВыборкаСборника.Ссылка;	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

#КонецОбласти

#Область РаботаСДеревьямиСмет

// Устанавливает значения расчета у всех подчиненных элементов.
//
// Параметры:
//     Ссылка - ДокументСсылка	- ссылка на текущий элемент. 
//     Расчет - Булево	- устанавливаемое значение поля Расчет.
//
Процедура УстановитьРасчетУПодчиненных(Ссылка, Расчет) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПозицияЛокальнойСметы.Ссылка
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	               |ГДЕ
	               |	ПозицияЛокальнойСметы.ИДРодителя = &Родитель
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	РазделЛокальнойСметы.Ссылка
	               |ИЗ
	               |	Документ.СМ_РазделЛокальнойСметы КАК РазделЛокальнойСметы
	               |ГДЕ
	               |	РазделЛокальнойСметы.ИДРодителя = &Родитель
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЛокальнаяСмета.Ссылка
	               |ИЗ
	               |	Документ.СМ_ЛокальнаяСмета КАК ЛокальнаяСмета
	               |ГДЕ
	               |	ЛокальнаяСмета.ИДРодителя = &Родитель";
	Запрос.УстановитьПараметр("Родитель", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.Расчет = Расчет;
		Объект.Записать(?(Объект.Проведен,РежимЗаписиДокумента.Проведение,РежимЗаписиДокумента.Запись));
		УстановитьРасчетУПодчиненных(Выборка.Ссылка, Расчет);
	КонецЦикла;
	
КонецПроцедуры

// Изменяет пометку удаления у Сводной и объектной смет.
//
// Параметры:
//     СметаСсылка 	- ДокументСсылка	- ссылка на удаляемую смету. 
//     СнятиеПометки 	- Булево			- Истина, если происходит снятие пометки удаления.
//
Процедура УстановитьСнятьПометкуУдаленияССиОС(СметаСсылка, СнятиеПометки = Ложь) Экспорт 

	ТабДокументы = СМ_СметныйСоставВызовСервера.ПолучитьДокументыСвязанныеССиОС(СметаСсылка);
	Для Каждого ТекСтрока Из ТабДокументы Цикл
		УстановитьСнятьПометкуУдаленияОбъекта(ТекСтрока.Элемент,СнятиеПометки); 
	КонецЦикла;
	
	// Удаление движений по регистрам.
	Если НЕ СнятиеПометки Тогда
		УдалитьДвижения(СметаСсылка);
	КонецЕсли;
		
КонецПроцедуры	

// Изменяет пометку удаления у элемента дерева смет.
//
// Параметры:
//     ОбъектСсылка 	- ДокументСсылка - ссылка на удаляемую смету. 
//     СнятиеПометки 	- Булево - Истина, если происходит снятие пометки удаления.
//
Процедура УстановитьСнятьПометкуУдаленияОбъекта(ОбъектСсылка,СнятиеПометки) Экспорт  
	
	ТекОбъект = ОбъектСсылка.ПолучитьОбъект();
	
	Попытка
		// Снятие пометки на удаление.
		Если СнятиеПометки Тогда
			ТекОбъект.ПометкаУдаления = Ложь;
			ТекОбъект.Записать();
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Документ: %1 снята пометка на удаление'"), ОбъектСсылка);
			Сообщение.Сообщить();				
			
		// Установка пометка на удаление.	
		Иначе	
			// Отмена проведения.
			Если ТекОбъект.Проведен Тогда
				 ТекОбъект.Проведен = Ложь;
			КонецЕсли;
			// Пометка на удаление.
			ТекОбъект.ПометкаУдаления = Истина;
			ТекОбъект.Записать();
			
			// Удаление движений по регистрам.
			УдалитьДвижения(ОбъектСсылка);
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = (СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Документ: %1 помечен на удаление'"), ОбъектСсылка));
			Сообщение.Сообщить();	
			
		КонецЕсли;
		
	Исключение
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = (СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось изменить пометку удаления для документа %1'"), ОбъектСсылка));
		Сообщение.Сообщить();			
	КонецПопытки;
		
КонецПроцедуры

// Изменяет пометку удаления у смет из ТЧ Сводной ИЛИ объектной сметы.
//
// Параметры:
//     ТекСмета 		- ДокументСсылка	- ссылка на текущую смету (у которой удаляются смет из ТЧ). 
//     СнятиеПометки 	- Булево			- Истина, если происходит снятие пометки удаления.
//
Процедура УстановитьСнятьПометкуУдаленияПоТЧСметы(ТекСмета, СнятиеПометки) Экспорт
	
	Если ТипЗнч(ТекСмета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		УстановитьСнятьПометкуУдаленияОбъекта(ТекСмета.Сметы,СнятиеПометки);
		Для Каждого ТекСтрока Из ТекСмета.Сметы Цикл
			УстановитьСнятьПометкуУдаленияПоТЧСметы(ТекСтрока.Смета,СнятиеПометки);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ТекСмета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		УстановитьСнятьПометкуУдаленияОбъекта(ТекСмета,СнятиеПометки);
		Для Каждого ТекСтрока Из ТекСмета.ЛокальныеСметы Цикл
			УстановитьСнятьПометкуУдаленияПоТЧСметы(ТекСтрока.ЛокальнаяСмета,СнятиеПометки);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ТекСмета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		УстановитьСнятьПометкуУдаленияОбъекта(ТекСмета,СнятиеПометки);
	КонецЕсли;
		
КонецПроцедуры

// Отвязывает все сметы из ТЧ Сводной ИЛИ объектной сметы от текущей сметы.
//
// Параметры:
//     ТекСмета 		- ДокументСсылка	- ссылка на текущую смету (от которой отвязываются сметы из ТЧ).
//
Процедура ОчиститьИдРодителяПоТЧСметы(ТекСмета) Экспорт
	
	Если ТипЗнч(ТекСмета.Ссылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда 
		МассивЭлементов = ТекСмета.ЛокальныеСметы.ВыгрузитьКолонку("ЛокальнаяСмета");
	ИначеЕсли ТипЗнч(ТекСмета.Ссылка) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		МассивЭлементов = ТекСмета.Сметы.ВыгрузитьКолонку("Смета");
	Иначе
		Возврат;	
	КонецЕсли; 
	 
	ПустаяСсылкаСС 	= Документы.СМ_СводнаяСмета.ПустаяСсылка();
	Для Каждого ТекЭлемент Из МассивЭлементов Цикл
		Если ТипЗнч(ТекЭлемент.Ссылка) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") 
		 ИЛИ ТипЗнч(ТекЭлемент.Ссылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") 
		 ИЛИ ТипЗнч(ТекЭлемент.Ссылка) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
			Если ЗначениеЗаполнено(ТекЭлемент.ИдРодителя) Тогда
				Попытка 
					ТекОбъект 				= ТекЭлемент.Ссылка.ПолучитьОбъект();
					ТекОбъект.ИдРодителя 	= ПустаяСсылкаСС;
					ТекОбъект.Записать();
				Исключение
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Ошибка изменения объекта %1'"), ТекЭлемент.Ссылка));
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСАктом

// Получает последний номер акта в смете.
//
// Параметры:
//     СсылкаСмета - ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету.
//                        
// Возвращаемое значение:
//     ТекНомер - Число - содержит последний номер акта сметы.
//
Функция ПолучитьНомерАктаВСмете(СсылкаСмета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	АктВыполненныхРабот.Ссылка,
	|	АктВыполненныхРабот.Номер,
	|	АктВыполненныхРабот.НомерАкта КАК НомерАкта
	|ИЗ
	|	Документ.СМ_АктВыполненныхРабот КАК АктВыполненныхРабот
	|ГДЕ
	|	АктВыполненныхРабот.ЛокальнаяСмета = &ЛокальнаяСмета
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерАкта";
	
	Запрос.УстановитьПараметр("ЛокальнаяСмета",СсылкаСмета);
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	КоличествоСтрок = ТабРезультат.Количество();
	ТабРезультат.Колонки.Добавить("НомерАктаЧислом");
	Для Каждого стр Из ТабРезультат Цикл
		Попытка
			стр.НомерАктаЧислом = Число(стр.НомерАкта);
		Исключение
			стр.НомерАктаЧислом = 0
		КонецПопытки;
	КонецЦикла;
	ТабРезультат.Сортировать("НомерАктаЧислом Убыв");
	Если КоличествоСтрок > 0 Тогда
		Попытка
			ТекНомер = Число(ТабРезультат[0].НомерАктаЧислом);
		Исключение
			ТекНомер = 0;
		КонецПопытки;
	Иначе
		ТекНомер = 0;	
	КонецЕсли;
	
	Возврат ТекНомер;
	
КонецФункции

// Получает строку ТЧ Позиции Акта выполненных работ, отвечающую за текущую позицию.
//
// Параметры:
//     АктВыполненныхРабот 		- ДокументОбъект, ДокументСсылка - акт выполненнх работ.
//     Позиция 					- ДокументОбъект, ДокументСсылка - ссылка на позицию.  
//     СоздатьЕслиОтсутствует 	- Булево - создавать ИЛИ нет, если строка в ТЧ отсутствует.
//
// Возвращаемое значение:
//     Строка - СтрокаТабличнойЧасти - строка ТЧ "ПозицииАкта", содержащая сведения о текущей позиции.
//
Функция СтрокаПозицииАкта(АктВыполненныхРабот, Позиция, СоздатьЕслиОтсутствует = Ложь) Экспорт
	
	Отбор = Новый Структура();
	СсылкаНаПозицию = ПолучитьСсылкуНаДокумент(Позиция, "СМ_ПозицияЛокальнойСметы");
	Отбор.Вставить("Позиция", СсылкаНаПозицию);
	Массив = АктВыполненныхРабот.Позиции.НайтиСтроки(Отбор);
	Если Массив.Количество() = 1 Тогда
		Возврат Массив[0];
	ИначеЕсли Массив.Количество() = 0 Тогда
		Если СоздатьЕслиОтсутствует Тогда
			Строка = АктВыполненныхРабот.Позиции.Добавить();
			Строка.Позиция = СсылкаНаПозицию;
			Возврат Строка;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Нарушена структура акта, найдено несколько ссылок на позицию %1 в Акте'"), Позиция.ШифрРасценки));
		Возврат Массив[0];
	КонецЕсли;
	
КонецФункции

// Удаляет строку ТЧ Позиции Акта выполненных работ, отвечающую за текущую позицию.
// В случае нескольких строк - удаляет все.
// Возращает Ложь в случае неоднозначной ситуации (например, строки и не было, ИЛИ несколько строк).
//
// Параметры:
//     АктВыполненныхРабот 	- ДокументОбъект, ДокументСсылка - акт выполненнх работ.
//     Позиция 				- ДокументОбъект, ДокументСсылка - ссылка на позицию.  
//
// Возвращаемое значение:
//     Булево - удаление успешно или нет.
//
Функция УдалитьСтрокуПозицииАкта(АктВыполненныхРабот, Позиция) Экспорт
	
	Отбор = Новый Структура();
	СсылкаНаПозицию = ПолучитьСсылкуНаДокумент(Позиция, "СМ_ПозицияЛокальнойСметы");
	Отбор.Вставить("Позиция", СсылкаНаПозицию);
	Массив = АктВыполненныхРабот.Позиции.НайтиСтроки(Отбор);
	Если Массив.Количество() = 0 Тогда
		Возврат Ложь;
	Иначе
		Для Каждого СтрокаИзМассива Из Массив Цикл
			АктВыполненныхРабот.Позиции.Удалить(СтрокаИзМассива);
		КонецЦикла;
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

// Получает строку ТЧ Позиции Акта выполненных работ, отвечающую за текущую позицию.
//
// Параметры:
//     АктВыполненныхРабот 		- ДокументОбъект, ДокументСсылка - акт выполненнх работ.
//     Раздел 					- ДокументОбъект, ДокументСсылка - ссылка на раздел.
//
// Возвращаемое значение:
//     Строка - СтрокаТабличнойЧасти - строка ТЧ "РазделыАкта", содержащая сведения о текущем разделе.
//
Функция СтрокаРазделаАкта(АктВыполненныхРабот, Раздел) Экспорт
	
	Отбор = Новый Структура();
	СсылкаНаПозицию = ПолучитьСсылкуНаДокумент(Раздел, "СМ_РазделЛокальнойСметы");
	Отбор.Вставить("Раздел", СсылкаНаПозицию);
	Массив = АктВыполненныхРабот.Разделы.НайтиСтроки(Отбор);
	Если Массив.Количество() = 1 Тогда
		Возврат Массив[0];
	ИначеЕсли Массив.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Нарушена структура акта, не найден раздел %1 в Акте'"), СсылкаНаПозицию.НаименованиеДляПечати));
		Возврат Неопределено;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Нарушена структура акта, найдено несколько ссылок на раздел %1 в Акте'"), СсылкаНаПозицию.НаименованиеДляПечати));
		Возврат Массив[0];
	КонецЕсли;
	
КонецФункции

// Получает массив строк ТЧ РесурсыПозицийАкта Акта выполненных работ, отвечающие за ресурсы текущей позиции.
//
// Параметры:
//     АктВыполненныхРабот 	- ДокументОбъект, ДокументСсылка - акт выполненнх работ.
//     Позиция 				- ДокументОбъект, ДокументСсылка - ссылка на позицию.  
//
// Возвращаемое значение:
//     Массив - Массив - содержит строки ТЧ "РесурсыПозицийАкта" со сведения о ресурсах текущей позиции.
//
Функция МассивСтрокРесурсовПозицииАкта(АктВыполненныхРабот, Позиция) Экспорт
	
	Отбор = Новый Структура();
	Отбор.Вставить("Позиция", ПолучитьСсылкуНаДокумент(Позиция, "СМ_ПозицияЛокальнойСметы"));
	Массив = АктВыполненныхРабот.РесурсыПозицийАкта.НайтиСтроки(Отбор);
	Возврат Массив;
	
КонецФункции

// Заполняет ТЧ Ресурсы Акта данными из таблицы.
// ВАЖНО, если передан Акт как Объект (а не ссылка), то он не записывается.
// TO DO - вынести в серверный модуль.
//
// Параметры:
//     АктВыполненныхРабот 	- ДокументОбъект, ДокументСсылка - акт выполненнх работ.
//     Позиция 				- ДокументОбъект, ДокументСсылка - ссылка на позицию.  
//     ТаблицаРесурсов 		- ТаблицаЗначений - с ресурсами позиции (колонки идентичные составу ТЧ).
//
Процедура ЗаполнитьТЧРесурсыАктаПоТаблице(АктВыполненныхРабот, Позиция, ТаблицаРесурсов) Экспорт
	
	СсылкаНаПозицию = ПолучитьСсылкуНаДокумент(Позиция, "СМ_ПозицияЛокальнойСметы");
	
	Если ТипЗнч(АктВыполненныхРабот) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		АктВыполненныхРаботОб = АктВыполненныхРабот.ПолучитьОбъект();
	Иначе
		АктВыполненныхРаботОб = АктВыполненныхРабот;
	КонецЕсли;
	
	Отбор = Новый Структура();
	Отбор.Вставить("Позиция", СсылкаНаПозицию);
	Массив = АктВыполненныхРаботОб.РесурсыПозицийАкта.НайтиСтроки(Отбор);
	
	Для Каждого ЭлементМассива Из Массив Цикл
		АктВыполненныхРаботОб.РесурсыПозицийАкта.Удалить(ЭлементМассива);
	КонецЦикла;
	
	Для Каждого СтрокаРесурса Из ТаблицаРесурсов Цикл
		СтрокаТабЧасти 						= АктВыполненныхРаботОб.РесурсыПозицийАкта.Добавить();	
		СтрокаТабЧасти.Позиция 				= СсылкаНаПозицию;
		ЗаполнитьЗначенияСвойств(СтрокаТабЧасти, СтрокаРесурса);
	КонецЦикла;
	
	Если ТипЗнч(АктВыполненныхРабот) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		АктВыполненныхРаботОб.Записать();
	КонецЕсли;		
	
КонецПроцедуры

// Возвращает таблицу всех ресурсов, которые были заменены.
// TO DO - вынести в серверный модуль.
//
// Параметры:
//     НовыйРесурс 	- СписокЗначений - Список ссылок на новые ресурсы.
//     Смета 		- СписокЗначений - Список ссылок на смету (если известно).  
//     Позиция 		- СписокЗначений - Список ссылок на позициию (если известно).
//
// Возвращаемое значение:
//     Таблица - ТаблицаЗначений - содержит сведения о замененных ресурсах.
//
Функция ПолучитьЗамененныеРесурсы(НовыйРесурс, Смета = Неопределено, Позиция = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЗаменаМатериаловПозиции.ЗамененныйРесурс КАК ЗамененныйРесурс,
	|	ЗаменаМатериаловПозиции.НовыйРесурс КАК НовыйРесурс,
	|	ЗаменаМатериаловПозиции.Позиция КАК Позиция,
	|	ЗаменаМатериаловПозиции.Смета КАК Смета,
	|	ЗаменаМатериаловПозиции.БазисЗарплМашСтарРесурс КАК БазиснаяЗМ,
	|	ЗаменаМатериаловПозиции.БазиснаяЦенаСтарогоМатериала КАК БазиснаяЦена,
	|	ЗаменаМатериаловПозиции.НормаРасходаСтарогоМатериала КАК НормаРасхода,
	|	ЗаменаМатериаловПозиции.ТекЗарплМашСтарРесурс КАК ТекущаяЗМ,
	|	ЗаменаМатериаловПозиции.ТекущаяЦенаСтарогоМатериала КАК ТекущаяЦена
	|ИЗ
	|	РегистрСведений.СМ_ЗаменаМатериаловПозиции КАК ЗаменаМатериаловПозиции
	|ГДЕ
	|	ЗаменаМатериаловПозиции.НовыйРесурс В(&НовыйРесурс)
	|	"+?(Позиция = Неопределено, "", "И ЗаменаМатериаловПозиции.Позиция В(&Позиция)")+"
	|	"+?(Смета = Неопределено, "", "И ЗаменаМатериаловПозиции.Смета В(&Смета)");

	Запрос.УстановитьПараметр("НовыйРесурс", НовыйРесурс);
	Если Позиция <> Неопределено Тогда
		Запрос.УстановитьПараметр("Позиция", Позиция);
	КонецЕсли;
	
	Если Смета <> Неопределено Тогда
		Запрос.УстановитьПараметр("Смета", Смета);
	КонецЕсли;

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает таблицу всех ресурсов, которые были заменены в актах.
//
// Параметры:
//     СписокАктов - СписокЗначений	- Список ссылок на акты.  
//
// Возвращаемое значение:
//     Таблица - ТаблицаЗначений - содержит сведения о замененных ресурсах.
//
Функция ПолучитьЗамененныеРесурсыАктов(СписокАктов) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЗаменаМатериаловПозиции.ЗамененныйРесурс КАК ЗамененныйРесурс,
	|	ЗаменаМатериаловПозиции.НовыйРесурс КАК НовыйРесурс,
	|	ЗаменаМатериаловПозиции.Позиция КАК Позиция,
	|	ЗаменаМатериаловПозиции.Смета КАК Смета,
	|	ЗаменаМатериаловПозиции.БазисЗарплМашСтарРесурс,
	|	ЗаменаМатериаловПозиции.БазиснаяЦенаСтарогоМатериала,
	|	ЗаменаМатериаловПозиции.НормаРасходаСтарогоМатериала,
	|	ЗаменаМатериаловПозиции.ТекЗарплМашСтарРесурс,
	|	ЗаменаМатериаловПозиции.ТекущаяЦенаСтарогоМатериала
	|ИЗ
	|	РегистрСведений.СМ_ЗаменаМатериаловПозиции КАК ЗаменаМатериаловПозиции
	|ГДЕ
	|	ЗаменаМатериаловПозиции.Смета В(&СписокАктов)";
	
	Запрос.УстановитьПараметр("СписокАктов", СписокАктов);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Заполняет ТЧ Ресурсы Акта данными из сводной таблицы ресурсов (с заменой ИЛИ без).
// ВАЖНО, если передан Акт как Объект (а не ссылка), то он не записывается.
// Возвращает Истина, если изменена хотя бы одна строка ТЧ.
//
// Параметры:
//     АктВыполненныхРабот 	- ДокументОбъект, ДокументСсылка - акт выполненнх работ.
//     Структура		 	- Структура - содержит поля:
//								* ЗаменяемыйРесурс - СправочникСсылка.СМ_Ресурсы - заменяемый ресурс.
//								* Ресурс - СправочникСсылка.СМ_Ресурсы - новый ресурс.
//								* РасходПоНорме - Число - новый расход по норме.
//								* РасходПоФакту - Число - новый расход по факту.    
//     ОтборПоПозициям 		- Массив - содержит позиции (если нужно проводить замену не по всем позициям).
//	   ДобавитьНовыйРесурс  - Булево - когда Истина создается новая строка ресурса в ТЧ "РесурсыПозицийАкта".
//
// Возвращаемое значение:
//     Модифицировано - Булево - выполнена ли замена.
//
Функция ЗаменитьРесурсВТЧРесурсыАкта(АктВыполненныхРабот, Структура, ОтборПоПозициям = Неопределено, ДобавитьНовыйРесурс = Ложь) Экспорт
	
	Если ТипЗнч(АктВыполненныхРабот) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		АктВыполненныхРаботОб = АктВыполненныхРабот.ПолучитьОбъект();
	Иначе
		АктВыполненныхРаботОб = АктВыполненныхРабот;
	КонецЕсли;
	
	СсылкаНаАкт = ПолучитьСсылкуНаДокумент(АктВыполненныхРаботОб,"СМ_АктВыполненныхРабот");
			
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Ресурс",Структура.ЗаменяемыйРесурс);
	
	МассивСтрок = АктВыполненныхРаботОб.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() = 0 Тогда 
		Возврат Ложь;
	Иначе
		ПоНормеИтого = 0;
		ПоФактуИтого = 0;
		Для Каждого ТекСтрока Из МассивСтрок Цикл
			Если ОтборПоПозициям <> Неопределено Тогда
				Если ОтборПоПозициям.Найти(ТекСтрока.Позиция) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			ПоНормеИтого = ПоНормеИтого + ТекСтрока.НормаРасходаОбъем;
			ПоФактуИтого = ПоФактуИтого + ТекСтрока.ФактРасходаОбъем;	
		КонецЦикла;      	
	КонецЕсли;
	
	Модифицировано 	= Ложь;
	ТабРесурсовАкта = АктВыполненныхРаботОб.РесурсыПозицийАкта.Выгрузить();
	ТабПозицийАкта 	= ТабРесурсовАкта.Скопировать();
	ТабПозицийАкта.Свернуть("Позиция");
	СписокПозиций	= ТабПозицийАкта.ВыгрузитьКолонку("Позиция");
	
	// Формируем список ресурсов
	СписокРесурсов = Новый Массив;
	СписокРесурсов.Добавить(Структура.Ресурс);
	
	// Получаем список региональных баз позиций акта
	СписокРегиональныхБаз = Новый Массив;
	Для Каждого ТекПозиция Из СписокПозиций Цикл
		Если СписокРегиональныхБаз.Найти(ТекПозиция.РегиональнаяБаза) = Неопределено Тогда 
			СписокРегиональныхБаз.Добавить(ТекПозиция.РегиональнаяБаза);	
		КонецЕсли;
	КонецЦикла;
	
	// Получаем цены по всем региональным базам
	ТаблицаЦенПоРегионам	= ПолучитьТаблицуВсехЦенРесурсов(СписокРесурсов, СписокРегиональныхБаз, АктВыполненныхРабот.АвтозагрузкаЦен, АктВыполненныхРабот.ДатаТекущихЦен, АктВыполненныхРабот.ЛокальнаяСмета.Район);
	//ТаблицаЦенПоРегионам 	= ПолучитьТаблицуВсехЦенРесурса(Структура.Ресурс, СписокПозиций, АктВыполненныхРабот.АвтозагрузкаЦен,  АктВыполненныхРабот.ДатаТекущихЦен, АктВыполненныхРабот.ЛокальнаяСмета.Район);
			
	Если МассивСтрок.Количество() > 0 Тогда   	
		
		// Получим цены (Таблица цен далее в функции нигде не используется)
		// ТаблицаЦен = ПолучитьТаблицуЦенРесурсов(АктВыполненныхРаботОб.РесурсыПозицийАкта.Выгрузить(), АктВыполненныхРабот.АвтозагрузкаЦен, АктВыполненныхРабот.ДатаТекущихЦен, АктВыполненныхРабот.ЛокальнаяСмета.Район);
		
		// Получим таблицу (вдруг были замены ранее).
		СписокРесурсов 	= Новый СписокЗначений();
		СписокРесурсов.ЗагрузитьЗначения(АктВыполненныхРаботОб.РесурсыПозицийАкта.Выгрузить().ВыгрузитьКолонку("Ресурс"));
		СписокСмет 		= Новый СписокЗначений();
		СписокСмет.Добавить(СсылкаНаАкт);
		ТаблицаПредыдущихЗамен = ПолучитьЗамененныеРесурсы(СписокРесурсов, СписокСмет, СписокПозиций); 
		
		Для Каждого ТекСтрока Из МассивСтрок Цикл
			
			Если ОтборПоПозициям <> Неопределено Тогда
				Если ОтборПоПозициям.Найти(ТекСтрока.Позиция) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если ДобавитьНовыйРесурс Тогда
				НоваяСтрока = АктВыполненныхРаботОб.РесурсыПозицийАкта.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрока); 
				НоваяСтрока.Ресурс 				= Структура.Ресурс;		
				НоваяСтрока.СметныйКодРесурса 	= Структура.Ресурс.Код;
				НоваяСтрока.ВидРесурса        	= Структура.Ресурс.ВидРесурса;
				НоваяСтрока.НаименованиеРесурса = Структура.Ресурс.ДлинноеНаименование;
				НоваяСтрока.Заменен				= Истина;
				НоваяСтрока.НормаРасходаОбъем	= ?(ПоНормеИтого <> 0, Структура.РасходПоНорме * ТекСтрока.НормаРасходаОбъем / ПоНормеИтого, 0);
				НоваяСтрока.ФактРасходаОбъем	= ?(ПоФактуИтого <> 0, Структура.РасходПоФакту * ТекСтрока.ФактРасходаОбъем / ПоФактуИтого, 0);
			Иначе
				ТекСтрока.Ресурс 				= Структура.Ресурс;		
				ТекСтрока.СметныйКодРесурса 	= Структура.Ресурс.Код;
				ТекСтрока.ВидРесурса        	= Структура.Ресурс.ВидРесурса;
				ТекСтрока.НаименованиеРесурса 	= Структура.Ресурс.ДлинноеНаименование;
				ТекСтрока.Заменен				= Истина;
				ТекСтрока.НормаРасходаОбъем		= ?(ПоНормеИтого<>0, Структура.РасходПоНорме * ТекСтрока.НормаРасходаОбъем / ПоНормеИтого, 0);
				ТекСтрока.ФактРасходаОбъем		= ?(ПоФактуИтого<>0, Структура.РасходПоФакту * ТекСтрока.ФактРасходаОбъем / ПоФактуИтого, 0);
			КонецЕсли;	
		
			// 	Отбор цен далее в функции нигде не используется
			//	ОтборЦен = Новый Структура();
			//	ОтборЦен.Вставить("Ресурс", Структура.ЗаменяемыйРесурс);
			//	ОтборЦен.Вставить("Позиция", ТекСтрока.Позиция);
			
			ОтборПредыдущихЗамен = Новый Структура();
			ОтборПредыдущихЗамен.Вставить("НовыйРесурс", Структура.ЗаменяемыйРесурс);
			ОтборПредыдущихЗамен.Вставить("Позиция", ТекСтрока.Позиция);
			ОтборПредыдущихЗамен.Вставить("Смета", СсылкаНаАкт);
			
			МассивЗамен = ТаблицаПредыдущихЗамен.НайтиСтроки(ОтборПредыдущихЗамен);
			Если МассивЗамен.Количество() > 0 Тогда
				ОтборПредыдущихЗамен = Новый Структура();
				ОтборПредыдущихЗамен.Вставить("ЗамененныйРесурс", МассивЗамен[0].ЗамененныйРесурс);
				ОтборПредыдущихЗамен.Вставить("Позиция", ТекСтрока.Позиция);
				ОтборПредыдущихЗамен.Вставить("Смета", СсылкаНаАкт);
				ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ЗаменаМатериаловПозиции", ОтборПредыдущихЗамен, Новый ТаблицаЗначений);
			КонецЕсли;
			
			// Формирование структуры замены ресурсов.
			СтруктураЗамены = Новый Структура;
			СтруктураЗамены.Вставить("НовыйРесурс",Структура.Ресурс);
			СтруктураЗамены.Вставить("СтарыйРесурс",Структура.ЗаменяемыйРесурс);
			СтруктураЗамены.Вставить("НормаРасходаСтарогоМатериала",ТекСтрока.НормаРасходаОбъем);
			СтруктураЗамены.Вставить("БазиснаяЦенаСтарогоМатериала",ТекСтрока.БазиснаяЦена);
			СтруктураЗамены.Вставить("ТекущаяЦенаСтарогоМатериала",ТекСтрока.ТекущаяЦена);
			СтруктураЗамены.Вставить("БазисЗарплМашСтарРесурс",ТекСтрока.БазиснаяЗарплатаМашинистов);
			СтруктураЗамены.Вставить("ТекЗарплМашСтарРесурс",ТекСтрока.ТекущаяЗарплатаМашинистов);
			
			ОтборРегион 		= Новый Структура("РегиональнаяБаза, Ресурс", ТекСтрока.Позиция.РегиональнаяБаза, Структура.Ресурс);
			МассивЦеныРегиона 	= ТаблицаЦенПоРегионам.НайтиСтроки(ОтборРегион);
			
			Если ДобавитьНовыйРесурс Тогда
				РедактируемаяСтрока = НоваяСтрока;
			Иначе	
				РедактируемаяСтрока = ТекСтрока;
			КонецЕсли;

			Если МассивЦеныРегиона.Количество() Тогда
				РедактируемаяСтрока.БазиснаяЦена 					= МассивЦеныРегиона[0].БазиснаяЦена;
				РедактируемаяСтрока.БазиснаяЗарплатаМашинистов 		= МассивЦеныРегиона[0].БазиснаяЗарплатаМашинистов;
				РедактируемаяСтрока.ТекущаяЦена 					= МассивЦеныРегиона[0].ТекущаяЦена;
				РедактируемаяСтрока.ТекущаяЗарплатаМашинистов 		= МассивЦеныРегиона[0].ТекущаяЗарплатаМашинистов;
			Иначе
				РедактируемаяСтрока.БазиснаяЦена 					= 0;
				РедактируемаяСтрока.БазиснаяЗарплатаМашинистов 		= 0;
				РедактируемаяСтрока.ТекущаяЦена 					= 0;
				РедактируемаяСтрока.ТекущаяЗарплатаМашинистов 		= 0;
			КонецЕсли;
			
			Если Структура.ТекЦена <> 0 Тогда
				Если РедактируемаяСтрока.ТекущаяЦена = 0 Тогда
					РедактируемаяСтрока.ТекущаяЦена = Структура.ТекЦена;
				КонецЕсли;
			КонецЕсли;
			
			Если Структура.ТекЗарплМаш <> 0 Тогда
				Если РедактируемаяСтрока.ТекущаяЗарплатаМашинистов = 0  Тогда
					РедактируемаяСтрока.ТекущаяЗарплатаМашинистов = Структура.ТекЗарплМаш;
				КонецЕсли;
			КонецЕсли;
			
			Документы.СМ_ПозицияЛокальнойСметы.ДобавитьДвиженияВРегЗамен(СтруктураЗамены,ТекСтрока.Позиция,СсылкаНаАкт);

		КонецЦикла;
		
		Модифицировано = Истина;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(АктВыполненныхРабот) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		АктВыполненныхРаботОб.Записать();
	КонецЕсли;	
	
	Возврат Модифицировано;
	
КонецФункции

// Удаляет запсии из ТЧ Ресурсы Акта по указанному ресурсу.
// ВАЖНО, если передан Акт как Объект (а не ссылка), то он не записывается.
// Возвращает Истина, если изменена хотя бы одна строка ТЧ.
//
// Параметры:
//     АктВыполненныхРабот 	- ДокументОбъект, ДокументСсылка - акт выполненнх работ.
//     Структура			- Структура - содержит поля:
//								* Ресурс - СправочникСсылка.СМ_Ресурсы - удаляемый ресурс.
//     ОтборПоПозициям 		- Массив - содержит позиции (если нужно проводить замену не по всем позициям).
//
// Возвращаемое значение:
//     Модифицировано - Булево - выполнено ли удаление.
//
Функция УдалитьРесурсВТЧРесурсыАкта(АктВыполненныхРабот, Структура, ОтборПоПозициям = Неопределено) Экспорт
	
	Если ТипЗнч(АктВыполненныхРабот) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		АктВыполненныхРаботОб = АктВыполненныхРабот.ПолучитьОбъект();
	Иначе
		АктВыполненныхРаботОб = АктВыполненныхРабот;
	КонецЕсли;
	
	СсылкаНаАкт = ПолучитьСсылкуНаДокумент(АктВыполненныхРаботОб,"СМ_АктВыполненныхРабот");
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Ресурс",Структура.Ресурс);
	
	МассивСтрок = АктВыполненныхРаботОб.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
		
	Модифицировано = Ложь;
	
	Если МассивСтрок.Количество() > 0 Тогда		 
		
		Для Каждого ТекСтрока Из МассивСтрок Цикл
			
			Если ОтборПоПозициям <> Неопределено Тогда
				Если ОтборПоПозициям.Найти(ТекСтрока.Позиция) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
						
			ТекСтрока.Удален	= Истина;
		
		КонецЦикла;
		Модифицировано = Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(АктВыполненныхРабот) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		АктВыполненныхРаботОб.Записать();
	КонецЕсли;	
	
	Возврат Модифицировано;
	
КонецФункции

// Изменяет факт объем и пересчитывает расходы ресурсов.
//
// Параметры:
//     АктВыполненныхРабот 	- ДокументОбъект, ДокументСсылка - акт выполненнх работ.
//     Позиция 				- ДокументОбъект, ДокументСсылка - ссылка на позицию. 
//     НовыйОбъем 			- Число	- новое значение факт объема.
//     ПрерватьЕслиФактИНормаНеРавны - Булево - если Истина, то функция вернет Ложь, когда ФактРасход ресурсов
//                                              отличен от расхода по норме и ничего делать не будет.
//     МенятьФактРасходРесурсов - Булево - если Ложь, то функция меняет только расход по норме.
//	   НеПроверятьБазисЕдиницы 	- Булево - признак проверки базисных единиц.
//
// Возвращаемое значение:
//     НовыйФактОбъем - Число - содержит новый факт объем.
//
Функция ИзменитьФактОбъемПозицииАкта(АктВыполненныхРабот, Позиция, НовыйОбъем = 1, ПрерватьЕслиФактИНормаНеРавны = Ложь, МенятьФактРасходРесурсов = Истина,НеПроверятьБазисЕдиницы = Ложь) Экспорт
	
	СтрокаПозиции = СтрокаПозицииАкта(АктВыполненныхРабот, Позиция, Ложь);	
	МассивРесурсов = МассивСтрокРесурсовПозицииАкта(АктВыполненныхРабот, Позиция);	
	
	Если ПрерватьЕслиФактИНормаНеРавны Тогда
		Факт = 0;
		Норма = 0;
		Для Каждого Элемент Из МассивРесурсов Цикл
			Факт = Факт + Элемент.ФактРасходаОбъем;
	        Норма = Норма + Элемент.НормаРасходаОбъем;
		КонецЦикла;
		Если Факт<>Норма Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Если  СтрокаПозиции <> Неопределено Тогда
		СтрокаПозиции.ФактОбъем = НовыйОбъем;
		СтрокаПозиции.ФормулаОбъема = "";
	КонецЕсли;	
	// Расчет в базовых единицах.
	ВводОбъемовВБазовыхЕдИзм = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ВводОбъемовВБазовыхЕдИзм");
	Если НеПроверятьБазисЕдиницы = Ложь Тогда
		Если ВводОбъемовВБазовыхЕдИзм Тогда
			Если СтрокаПозиции <> Неопределено Тогда
				СтрокаПозиции.ФактОбъем = ПересчитатьВбазовыхЕдиницахИзмерения(Позиция,СтрокаПозиции.ФактОбъем);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого Элемент Из МассивРесурсов Цикл
		
		Отбор = Новый Структура("Ресурс",Элемент.Ресурс);
		Если  СтрокаПозиции <> Неопределено Тогда
		МассивСтрокРесурсовТЧ = СтрокаПозиции.Позиция.РесурсыПозицииЛокальнойСметы.НайтиСтроки(Отбор);
		Если МассивСтрокРесурсовТЧ.Количество() = 0 Тогда
			Продолжить;
		Иначе
			Элемент.НормаРасходаОбъем = НовыйОбъем * МассивСтрокРесурсовТЧ[0].НормаРасхода;
			Если МенятьФактРасходРесурсов Тогда
				Элемент.ФактРасходаОбъем = НовыйОбъем * МассивСтрокРесурсовТЧ[0].НормаРасхода;
			КонецЕсли;
		КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если  СтрокаПозиции <> Неопределено Тогда
		
		Возврат СтрокаПозиции.ФактОбъем;
	Иначе
		Возврат(0);
	КонецЕсли;
	
КонецФункции

// Изменяет текущие цены ресурсов акта.
//
// Параметры:
//     АктВыполненныхРабот 			- ДокументОбъект.СМ_АктВыполненныхРабот - акт выполненнх работ.
//     СтруктураРесурс 				- Структура - содержит поля для заполнения цен.  
//     ТекущаяЦена 					- Число	- новое значение текущей цены.
//     ТекущаяЗарплатаМашинистов 	- Число	- новое значение текущей зпм.
//     НеучтенныйРесурс 			- Булево - является ли ресурс неучтенным.
//
// Возвращаемое значение:
//     Модифицированность - Булево - выполнено ли обновление цен.
//
Функция ОбновитьПоказателиРесурсовВТЧРесурсыАкта(АктВыполненныхРабот, СтруктураРесурс, ТекущаяЦена, ТекущаяЗарплатаМашинистов, НеучтенныйРесурс = Ложь) Экспорт
	
	Модифицированность = Ложь;
	
	// 1. Обновление текущих цен ресурса в табличной части ресурсов акта.
	Если Не НеучтенныйРесурс Тогда
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Ресурс",СтруктураРесурс.Ресурс);
		СтруктураОтбора.Вставить("БазиснаяЦена",СтруктураРесурс.БазиснаяЦена);
		СтруктураОтбора.Вставить("БазиснаяЗарплатаМашинистов",СтруктураРесурс.БазиснаяЗарплатаМашинистов);
		МассивСтрок = АктВыполненныхРабот.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 Тогда
			Для Каждого ТекСтрока Из МассивСтрок Цикл
				ТекСтрока.ТекущаяЦена = ТекущаяЦена;	
				ТекСтрока.ТекущаяЗарплатаМашинистов = ТекущаяЗарплатаМашинистов;
			КонецЦикла;
			Модифицированность = Истина;
		КонецЕсли;
	Иначе
		// Означает, что ресурс не учтен.
		ТабПозиции= Новый СписокЗначений();
		ТабПозиции.ЗагрузитьЗначения(АктВыполненныхРабот.Позиции.Выгрузить().ВыгрузитьКолонку("Позиция"));   		
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПозицияЛокальнойСметы.Ссылка
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
		               |ГДЕ
		               |	ПозицияЛокальнойСметы.ШифрРасценки = &ШифрРасценки
		               |	И ПозицияЛокальнойСметы.Наименование ПОДОБНО &Наименование
		               |	И ПозицияЛокальнойСметы.Определитель.ВидРасценки = &ВидРасценки
		               |	И ПозицияЛокальнойСметы.ЕдиницаИзмерения = &ЕдиницаИзмерения
		               |	И ПозицияЛокальнойСметы.Ссылка В(&Позиции)
		               |	И ВЫБОР
		               |			КОГДА &ВидРасценки = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыРасценки.Оборудование)
		               |				ТОГДА ПозицияЛокальнойСметы.Оборудование
		               |			ИНАЧЕ ПозицияЛокальнойСметы.СтоимМатериалов
		               |		КОНЕЦ = &БазиснаяЦена";
		
		Запрос.УстановитьПараметр("Позиции",ТабПозиции);
		Запрос.УстановитьПараметр("ЕдиницаИзмерения",СтруктураРесурс.ЕдиницаИзмерения);
		Запрос.УстановитьПараметр("ШифрРасценки",СокрЛП(СтруктураРесурс.Код));
		Запрос.УстановитьПараметр("ВидРасценки",?(СтруктураРесурс.Вид = Перечисления.СМ_ВидыРесурсов.Оборудование, Перечисления.СМ_ВидыРасценки.Оборудование, Перечисления.СМ_ВидыРасценки.Материал));
		Запрос.УстановитьПараметр("Наименование",СокрЛП(СтруктураРесурс.Наименование));
		Запрос.УстановитьПараметр("БазиснаяЦена",СтруктураРесурс.БазиснаяЦена);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Позиция",Выборка.Ссылка);
			
			МассивСтрок = АктВыполненныхРабот.Позиции.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество() > 0 Тогда
				Для Каждого ТекСтрока Из МассивСтрок Цикл
					ТекСтрока.ТекущаяЦена = ТекущаяЦена;	
					ТекСтрока.ТекущаяЗарплатаМашинистов = ТекущаяЗарплатаМашинистов;
				КонецЦикла;
				Модифицированность = Истина;
			КонецЕсли;   			
		
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Модифицированность;
	
КонецФункции

// Обновляет базисные и текущие цены у всех ресурсов акта.
// ВАЖНО, если передан Акт как Объект (а не ссылка), то он не записывается.
// Возвращает Истина, если изменена хотя бы одна строка ТЧ.
// ВАЖНО, если передан Отбор по позициям - то обрабатываются только переданные позиции
// (без контроля принадлежности смете).
//
// Параметры:
//     АктВыполненныхРабот 	- ДокументОбъект, ДокументСсылка - акт выполненнх работ.
//     ТаблицаСводная 		- ТаблицаЗначений - сводная таблица с ресурсами и новыми значениями цен (поля как в ТЧ ресурсов акта).    
//     ОтборПоПозициям 		- Массив - содержит позиции (если нужно проводить замену не по всем позициям).
//     Обнулять 			- Булево - если Истина, то нулевые значения вставляются в ресурсы, 
//                                     иначе обновляются только ненулевые.
//
// Возвращаемое значение:
//     Модифицировано - Булево - выполнено ли обновление цен.
//
Функция ОбновитьЦеныРесурсовАкта(АктВыполненныхРабот, ТаблицаСводная, ОтборПоПозициям = Неопределено, Обнулять = Ложь) Экспорт
	
	Если ТипЗнч(АктВыполненныхРабот) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		АктВыполненныхРаботОб = АктВыполненныхРабот.ПолучитьОбъект();
	Иначе
		АктВыполненныхРаботОб = АктВыполненныхРабот;
	КонецЕсли;
	
	СсылкаНаАкт = ПолучитьСсылкуНаДокумент(АктВыполненныхРаботОб,"СМ_АктВыполненныхРабот");
	
	Модифицировано = Ложь;
	
	СтруктураНеучтенные = Новый Структура;
	СтруктураНеучтенные.Вставить("ЭтоНеучтенный",Ложь);
	
	МассивРесурсов = ТаблицаСводная.НайтиСтроки(СтруктураНеучтенные);
	
	Для Каждого СтрокаОбновленияЦен Из МассивРесурсов Цикл
	
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Ресурс",СтрокаОбновленияЦен.Ресурс);
		
		МассивСтрок = АктВыполненныхРаботОб.РесурсыПозицийАкта.НайтиСтроки(СтруктураОтбора);
			
		Для Каждого ТекСтрока Из МассивСтрок Цикл
				
			Если ОтборПоПозициям <> Неопределено Тогда
				Если ОтборПоПозициям.Найти(ТекСтрока.Позиция) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			// Базисные по акту обновляться не могут - только текущие.
			Если (СтрокаОбновленияЦен.ЦенаТекущая > 0) ИЛИ Обнулять Тогда
				ТекСтрока.ТекущаяЦена = СтрокаОбновленияЦен.ЦенаТекущая;
			КонецЕсли;
		    Если (СтрокаОбновленияЦен.ЦенаТекущаяЗМ > 0) ИЛИ Обнулять Тогда
				ТекСтрока.ТекущаяЗарплатаМашинистов = СтрокаОбновленияЦен.ЦенаТекущаяЗМ;	
			КонецЕсли;
								
			Модифицировано = Истина;
			
		КонецЦикла;
		
	КонецЦикла;
	
	СтруктураНеучтенные = Новый Структура;
	СтруктураНеучтенные.Вставить("ЭтоНеучтенный",Истина);
	МассивРесурсов = ТаблицаСводная.НайтиСтроки(СтруктураНеучтенные);
	
	Для Каждого СтрокаОбновленияЦен Из МассивРесурсов Цикл
		
		// Это позиции с материалами и оборудованием, зададим текущие цены для них.
		Для Каждого ТекСтрока Из АктВыполненныхРаботОб.Позиции Цикл
				
			Если ОтборПоПозициям <> Неопределено Тогда
				Если ОтборПоПозициям.Найти(ТекСтрока.Позиция) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если ТекСтрока.Позиция.РесурсыПозицииЛокальнойСметы.Количество() = 0
				И (ТекСтрока.Позиция.Определитель.ВидРасценки =  Перечисления.СМ_ВидыРасценки.Материал
				ИЛИ ТекСтрока.Позиция.Определитель.ВидРасценки =  Перечисления.СМ_ВидыРасценки.Оборудование) Тогда
			
				// Базисные по акту обновляться не могут - только текущие.
				Если (СтрокаОбновленияЦен.ЦенаТекущая > 0) ИЛИ Обнулять Тогда
					ТекСтрока.ТекущаяЦена = СтрокаОбновленияЦен.ЦенаТекущая;
				КонецЕсли;
			    									
				Модифицировано = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
		
	Если ТипЗнч(АктВыполненныхРабот) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		АктВыполненныхРаботОб.Записать();
	КонецЕсли;	
	
	Возврат Модифицировано;
	
КонецФункции

// Получает связанные с локальной сметой документы Акт выполненных работ.
// TO DO - перенести в серверный модуль.
//
// Параметры:
//     СсылкаСмета - ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету.
//
// Возвращаемое значение:
//     ТабРезультат - ТаблицаЗначений - содержит информацию обо всех актах сметы.
//
Функция ПолучитьАктыСметы(СсылкаСмета) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АктВыполненныхРабот.НомерАкта КАК Номер,
	               |	АктВыполненныхРабот.Дата,
	               |	АктВыполненныхРабот.ПериодОт,
	               |	АктВыполненныхРабот.ПериодДо,
	               |	АктВыполненныхРабот.Ссылка
	               |ИЗ
	               |	Документ.СМ_АктВыполненныхРабот КАК АктВыполненныхРабот
	               |ГДЕ
	               |	АктВыполненныхРабот.ЛокальнаяСмета = &ЛокальнаяСмета";
    
	Запрос.УстановитьПараметр("ЛокальнаяСмета",СсылкаСмета);
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабРезультат;

КонецФункции

// Заполняет реквизиты акта по переданной смете и параметрам.
//
// Параметры:
//     ПараметрыФормы 	- Структура - содержит параметры формы объекта акта выполненных работ.
//     ТекОбъект 		- ДокументОбъект.СМ_АктВыполненныхРабот - заполняемый акт.
//
Процедура ЗаполнитьАктПоСмете(ПараметрыФормы, ТекОбъект) Экспорт
	
	ТекЛокальнаяСмета 			= ПараметрыФормы.ЛокальнаяСмета;
	ТекОбъект.ЛокальнаяСмета 	= ТекЛокальнаяСмета.Ссылка;

	Если ЗначениеЗаполнено(ПараметрыФормы.ЛокальнаяСмета)
		И ТипЗнч(ТекЛокальнаяСмета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		
		ЗаполнитьЗначенияСвойств(ТекОбъект,ТекЛокальнаяСмета,,"Номер");
		
		НомерАкта = ПолучитьНомерАктаВСмете(ТекЛокальнаяСмета);
		ТекОбъект.НомерАкта = Строка(Число(НомерАкта) + 1);
		
		КопироватьЛЗ = Ложь;
		Если ПараметрыФормы.Свойство("КопироватьЛЗ") Тогда
			КопироватьЛЗ = ПараметрыФормы.КопироватьЛЗ;	
		КонецЕсли;
		
		КопироватьПодписи = Ложь;
		Если ПараметрыФормы.Свойство("КопироватьПодписи") Тогда
			КопироватьПодписи = ПараметрыФормы.КопироватьПодписи;	
		КонецЕсли;

		// Табличная часть "Лимитированные затраты".
		Если КопироватьЛЗ Тогда	
			
			// Заполнение ЛЗ из локальной сметы.
			ДобавитьЛЗизДокумета(ТекОбъект, ТекЛокальнаяСмета);
			
			Если ЗначениеЗаполнено(ТекЛокальнаяСмета.ИДРодителя) Тогда
				ТекРодитель = ТекЛокальнаяСмета.ИДРодителя;
				
				// Заполнение ЛЗ по родителю локальной сметы (Сводная ИЛИ объектная смета).
				ДобавитьЛЗизДокумета(ТекОбъект,ТекРодитель);

				// Заполнение ЛЗ из сводной сметы, которой подчинена объектная смета.
				Если ТипЗнч(ТекЛокальнаяСмета.ИДРодителя) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
					Если ЗначениеЗаполнено(ТекРодитель.ИДРодителя) Тогда
						ДобавитьЛЗизДокумета(ТекОбъект,ТекРодитель.ИДРодителя);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			ТекОбъект.ЛимитированныеЗатраты.Свернуть("ЛимитированнаяЗатрата,ФормулаЛимЗатраты,ФормулаБазисногоЗначениеЛимЗатраты,Примечание,Расчет","ЗначениеЛимЗатраты,БазисноеЗначениеЛимЗатраты,КоэффициентСметнойЗарплаты,КоэффициентТрудоемкости");
			
		КонецЕсли;
		
		// Табличная часть "Подписи".
		Если КопироватьПодписи Тогда
			Для Каждого ТекСтрокаПодписи Из ТекЛокальнаяСмета.Подписи Цикл
				НоваяСтрока = ТекОбъект.Подписи.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрокаПодписи);
			КонецЦикла;
		КонецЕсли;
		
		// Табличная часть "Параметры"
		Для Каждого ТекСтрокаПараметр Из ТекЛокальнаяСмета.Параметры Цикл
			НоваяСтрока = ТекОбъект.Параметры.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрокаПараметр);
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

// Заполняет структуру параметров вывода дерева акта, по параметрам формы.
//
// Параметры:
//     ПараметрыФормы - Структура - содержит параметры формы объекта акта выполненных работ.
//
// Возвращаемое значение:
//     СтруктураПараметров - Структура - содержит поля:
//			* КопироватьИндексы 	- Булево - признак копирования индексов.
//			* Процентовать			- Булево - признак процентования.
//			* Процент				- Число - значение процента.
//			* ЗаполнитьПоОстаткам 	- Булево - признак заполнение по остаткам.				
//
Функция ЗаполнитьСтруктуруПараметровСозданияАкта(ПараметрыФормы) Экспорт
	
	// Копировать индексы.
	КопироватьИндексы = Ложь;
	Если ПараметрыФормы.Свойство("КопироватьИндексы") Тогда
		КопироватьИндексы = ПараметрыФормы.КопироватьИндексы;
	КонецЕсли;
	
	// Процентовать.
	Процентовать = Ложь;
	Если ПараметрыФормы.Свойство("Процентовать") Тогда
		Процентовать = ПараметрыФормы.Процентовать;
	КонецЕсли;

	// Процент.
	Процент = 100;
	Если ПараметрыФормы.Свойство("Процент") Тогда
		Процент = ПараметрыФормы.Процент;
	КонецЕсли;
	
	// ПоОстаткам.
	ЗаполнитьПоОстаткам = Ложь;
	Если ПараметрыФормы.Свойство("ЗаполнитьПоОстаткам") Тогда
		ЗаполнитьПоОстаткам = ПараметрыФормы.ЗаполнитьПоОстаткам;
	КонецЕсли;

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("КопироватьИндексы",КопироватьИндексы);
	СтруктураПараметров.Вставить("Процентовать",Процентовать);
	СтруктураПараметров.Вставить("Процент",Процент);
	СтруктураПараметров.Вставить("ЗаполнитьПоОстаткам",ЗаполнитьПоОстаткам);
	
	Возврат СтруктураПараметров;
	
КонецФункции

#КонецОбласти

#Область ГрупповаяОбработкаПозиций

// Возвращает структуру с данными для обновления нормативных данных.
//
// Параметры:
//     ОбъектПозиции 					- ДокументОбъект, ДокументСсылка - позиция локальной сметы.
//     СтруктураПараметровРасчетаЛС 	- Структура - содержит данные о смете, полученная вызовом
//                                        ПолучитьСтруктуруПараметровРасчетаЛС().
//
// Возвращаемое значение:
//     ПараметрыДляОбновления - Структура - содержит поля:
//			* КодБазы		- Строка - двухсимвольный код базы.
//			* КодЗоны       - Строка - код территориального района.
//			* ТипСборника   - Строка - двухсимвольный код типа сборника.
//			* НомерСборника - Число  - номер сборника.
//			* ШифрРасценки  - Строка - шифр расценки.
//
Функция ПолучитьПараметрыДляОбновления(ОбъектПозиции, СтруктураПараметровРасчетаЛС) Экспорт
	
	Если СМ_СметаЗагрузкаВызовСервера.ОпределитьУровеньСНБ(ОбъектПозиции.РегиональнаяБаза.Наименование, ОбъектПозиции.РегиональнаяБаза.Код)= Перечисления.СМ_УровниБазы.ТерриториальныйМосква ИЛИ
		ОбъектПозиции.ИДСметы.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква Тогда
		//ОбъектПозиции.ИДСметы.МетодикаТСН Тогда
		МетодикаТСН = Истина;
	Иначе
		МетодикаТСН = Ложь;
	КонецЕсли;	
	
	Если Не СтруктураПараметровРасчетаЛС = Неопределено Тогда
		Если СтруктураПараметровРасчетаЛС.Свойство("МетодикаКазахстана") Тогда
			МетодикаКазахстана = СтруктураПараметровРасчетаЛС.МетодикаКазахстана;
		КонецЕсли;
	КонецЕсли;

	ПараметрыДляОбновления = Новый Структура();
	ПараметрыДляОбновления.Вставить("КодБазы", ОбъектПозиции.РегиональнаяБаза.Код);
	ПараметрыДляОбновления.Вставить("КодЗоны", СтруктураПараметровРасчетаЛС.КодРайона);
	ПараметрыДляОбновления.Вставить("ТипСборника", СМ_СметаЗагрузкаВызовСервера.ОпределитьКодТипаСборника(ОбъектПозиции.ТипНормативныхСборников));
	ПараметрыДляОбновления.Вставить("НомерСборника", ОпределитьНомерСборника(ПараметрыДляОбновления.ТипСборника, ОбъектПозиции.ШифрРасценки,МетодикаТСН,МетодикаКазахстана));
	ПараметрыДляОбновления.Вставить("ШифрРасценки",Строка(ОбъектПозиции.ШифрРасценки));
	
	Возврат ПараметрыДляОбновления;
	
КонецФункции 

// Возвращает массив для дальнейших отборов.
// Если передан один объект, то просто добавляет его в массив.
//
// Параметры:
//     МассивОбъектов - Массив, ДокументСсылка, ДокументОбъект - ссылка на документ или массив ссылок.
//
// Возвращаемое значение:
//     НовыйМассив - Массив - содержит нужные ссылки на элементы.
//
Функция ПодготовитьМассивОбъектов(МассивОбъектов) Экспорт
	
	НовыйМассив = Новый Массив;     
	
	Если ТипЗнч(МассивОбъектов) = тип("Массив") Тогда
		
		НовыйМассив = МассивОбъектов;
		
	ИначеЕсли типЗнч(МассивОбъектов) = тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		
		НовыйМассив.Добавить(МассивОбъектов);
			
	ИначеЕсли ТипЗнч(МассивОбъектов) = тип("ДокументОбъект.СМ_ПозицияЛокальнойСметы") Тогда
		
		НовыйМассив.Добавить(МассивОбъектов.Ссылка);
		
	Иначе
		Возврат неопределено; 
	КонецЕсли;

	Возврат НовыйМассив;
	
КонецФункции	

// Производит расчет базисных показателей позиции для групповой обработки.
//
// Параметры:
//     ПоБазису - Булево - если Истина, то по базисным показателям.
//     Позиция 	- ДокументСсылка.СМ_ПозицияЛокальнойСметы - ссылка на позицию.
//
Процедура РасчетСтоимостиРасценок(ПоБазису,Позиция) Экспорт
	
	ПозицияОбъект = Позиция.ПолучитьОбъект();
	
	СтруктураПараметровРасчетаЛС = ПолучитьСтруктуруПараметровРасчетаЛС(,Позиция);	
	
	ВариантРасчетаЗМ = СтруктураПараметровРасчетаЛС.ВариантРасчетаЗМ;
	Если ВариантРасчетаЗМ.пустая() Тогда
		ВариантРасчетаЗМ = Перечисления.СМ_ВариантыРасчетаЗМ.Расчетный;
	КонецЕсли;	
	КЧ = Новый КвалификаторыЧисла(20,6);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Число"));
	ОписаниеТиповЧ = Новый ОписаниеТипов(Массив, , ,КЧ);
	
	ТаблЕдСтоим = Новый ТаблицаЗначений;
	ТаблЕдСтоим.Колонки.Добавить("ПрямЗатраты",		ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("ОснЗарплата",		ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("ЭксплМашин",		ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("ЗарплМашинистов",		ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("СтоимМатериалов",		ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("ЗатратыТрудаРабочих",		ОписаниеТиповЧ);
	
	// По базисным (текущим) ценам рассчитываем единичные составляющие прямых затрат.
	СМ_СметаРасчетБазисноИндексныйСервер.РасчетЕдиничныхЗначенийСоставляющих(ПозицияОбъект,ВариантРасчетаЗМ,ТаблЕдСтоим,ПоБазису);
	Для Каждого Значения Из ТаблЕдСтоим Цикл
		ПозицияОбъект.ПрямЗатраты = Значения.ПрямЗатраты;
		ПозицияОбъект.СтоимМатериалов = Значения.СтоимМатериалов;
		ПозицияОбъект.ЭксплМашин = Значения.ЭксплМашин;
		ПозицияОбъект.ЗарплМашинистов = Значения.ЗарплМашинистов;
		ПозицияОбъект.ОснЗарплата = Значения.ОснЗарплата;
		ПозицияОбъект.ЗатратыТрудаРабочих = Значения.ЗатратыТрудаРабочих;
		ПозицияОбъект.ЗатратыТрудаМашинистов = Позиция.ЗатратыТрудаМашинистов;
	КонецЦикла;
	
	ПозицияОбъект.записать();
	
КонецПроцедуры	

#КонецОбласти

#Область НастройкиИнтерфейсаКлиентскогоПриложения

// Выполняет настройку интерфейса приложения "по умолчанию".
Процедура ВыполнитьНастройкуПанелей() Экспорт
	
	// Получаем настройки текущие.
	НастройкиИнтерфейса = ХранилищеСистемныхНастроек.Загрузить("Общее/НастройкиИнтерфейсаКлиентскогоПриложения");
	Если (НастройкиИнтерфейса<>Неопределено) Тогда
		НастройкиСостава = НастройкиИнтерфейса.ПолучитьСостав();
		Если (НастройкиСостава.Верх.Количество() > 0)
			ИЛИ (НастройкиСостава.Лево.Количество() > 0)
			ИЛИ (НастройкиСостава.Низ.Количество() > 0)
			ИЛИ (НастройкиСостава.Право.Количество() > 0) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// Для примера будем менять настройки пользователя "не глядя" на то, что он себе настроил.
	// Создать пустой объект настроек.
	НастройкиИнтерфейса = Новый НастройкиИнтерфейсаКлиентскогоПриложения;
	
	// С помощью пустого объекта настроек получить настройки состава, установленные в конфигураторе.
	НастройкиСостава = НастройкиИнтерфейса.ПолучитьСостав();
	
	// Очистить настройки состава.
	НастройкиСостава.Верх.Очистить();
	НастройкиСостава.Лево.Очистить();
	НастройкиСостава.Низ.Очистить();
	НастройкиСостава.Право.Очистить();
	
	// Заполнить своими панелями.
	// Для примера самый простой вариант: слева - панель инструментов.
	ПанельРазделов = Новый ЭлементНастройкиСоставаИнтерфейсаКлиентскогоПриложения("ПанельРазделов");
	ГруппаНастройки = Новый ГруппаНастройкиСоставаИнтерфейсаКлиентскогоПриложения();
	ПанельФункции  = Новый ЭлементНастройкиСоставаИнтерфейсаКлиентскогоПриложения("ПанельФункцийТекущегоРаздела");
	ПанельИнструментов = Новый ЭлементНастройкиСоставаИнтерфейсаКлиентскогоПриложения("ПанельИнструментов");
	НастройкиСостава.Верх.Добавить(ПанельРазделов);
	ГруппаНастройки.Добавить(ПанельФункции);
	ГруппаНастройки.Добавить(ПанельИнструментов);
	НастройкиСостава.Верх.Добавить(ГруппаНастройки);
	
	// Загрузить настройки состава в пустой объект настроек.
	НастройкиИнтерфейса.УстановитьСостав(НастройкиСостава);
	
	// Положить объект настроек текущему пользователю в хранилище.
	ХранилищеСистемныхНастроек.Сохранить("Общее/НастройкиИнтерфейсаКлиентскогоПриложения", , НастройкиИнтерфейса);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

