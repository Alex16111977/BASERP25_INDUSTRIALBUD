// Заполняет реквизиты объекта данными из настроек пользователя (значениями по умолчанию).
//
// Параметры:
//     ТекОбъект - Объект - реквизиты которого заполняются.
//
Процедура ЗаполнитьНастройкиПользователяПоУмолчанию(ТекОбъект) Экспорт
	
	МетаданныеОбъекта = ТекОбъект.Ссылка.Метаданные();
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Стройка",МетаданныеОбъекта)
		И НЕ ЗначениеЗаполнено(ТекОбъект.Стройка) Тогда
		ТекОбъект.Стройка = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнаяСтройка");	
	КонецЕсли;
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Стройка",МетаданныеОбъекта) Тогда
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация",МетаданныеОбъекта) Тогда
			ТекОбъект.Организация = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОсновнаяОрганизация");
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Заказчик",МетаданныеОбъекта) Тогда
			ТекОбъект.Заказчик = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОсновнойЗаказчик");
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Подрядчик",МетаданныеОбъекта) Тогда
			ТекОбъект.Подрядчик = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОсновнойПодрядчик");
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Инвестор",МетаданныеОбъекта) Тогда
			ТекОбъект.Инвестор = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОсновнойИнвестор");
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Район",МетаданныеОбъекта) Тогда
			ТекОбъект.Район = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОсновнойРайон");
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ТипРайона",МетаданныеОбъекта) Тогда
			ТекОбъект.ТипРайона = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ТипРайона");
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ТипСтроительства",МетаданныеОбъекта) Тогда
			ТекОбъект.ТипСтроительства = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОсновнойТипСтроительства");
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ПрименятьКоэффициентыНРСП",МетаданныеОбъекта) Тогда
			ТекОбъект.ПрименятьКоэффициентыНРСП = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"НРИСПДляСметыНаРемонт");
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("МетодРасчета",МетаданныеОбъекта) Тогда
			ТекОбъект.МетодРасчета = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОсновнойМетодСчета");
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Уровень",МетаданныеОбъекта) Тогда
			ТекОбъект.Уровень = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"УровеньПримененияИндексов");
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ВариантПересчетаЭММ",МетаданныеОбъекта) Тогда
			ТекОбъект.ВариантПересчетаЭММ = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ВариантПересчетаЭММ");
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ВариантРасчетаЗМ",МетаданныеОбъекта) Тогда
			ТекОбъект.ВариантРасчетаЗМ = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ВариантРасчетаЗМ");
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СпособРасчетаИндексов",МетаданныеОбъекта) Тогда
			ТекОбъект.СпособРасчетаИндексов = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"СпособРасчетаИндексов");
		КонецЕсли;	
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ОкруглятьДоРублей",МетаданныеОбъекта) Тогда
			ТекОбъект.ОкруглятьДоРублей = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОкруглятьИтоговуюСтоимостьДоРублей");
		КонецЕсли;	
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ОбрабатыватьПогрешность",МетаданныеОбъекта) Тогда
			ТекОбъект.ОбрабатыватьПогрешность = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОбрабатыватьПогрешность");
		КонецЕсли;		

		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("НеОкруглятьНДС",МетаданныеОбъекта) Тогда
			ТекОбъект.НеОкруглятьНДС = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"НеОкруглятьНДС");
		КонецЕсли;	
		
	Иначе
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация",МетаданныеОбъекта) Тогда
			ТекОбъект.Организация = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнаяОрганизация");	
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Заказчик",МетаданныеОбъекта) Тогда
			ТекОбъект.Заказчик = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнойЗаказчик");	
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Подрядчик",МетаданныеОбъекта) Тогда
			ТекОбъект.Подрядчик = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнойПодрядчик");	
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Инвестор",МетаданныеОбъекта) Тогда
			ТекОбъект.Инвестор = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнойИнвестор");	
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Район",МетаданныеОбъекта) Тогда
			ТекОбъект.Район = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнойРайон");	
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ТипРайона",МетаданныеОбъекта) Тогда
			ТекОбъект.ТипРайона = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ТипРайона");	
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ТипСтроительства",МетаданныеОбъекта) Тогда
			ТекОбъект.ТипСтроительства = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнойТипСтроительства");	
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ПрименятьКоэффициентыНРСП",МетаданныеОбъекта) Тогда
			ТекОбъект.ПрименятьКоэффициентыНРСП = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","СМ_НРИСПДляСметыНаРемонт");	
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("МетодРасчета",МетаданныеОбъекта) Тогда
			ТекОбъект.МетодРасчета = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнойМетодСчета");	
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Уровень",МетаданныеОбъекта) Тогда
			ТекОбъект.Уровень = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","УровеньПримененияИндексов");	
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ВариантПересчетаЭММ",МетаданныеОбъекта) Тогда
			ТекОбъект.ВариантПересчетаЭММ = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ВариантПересчетаЭММ");	
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ВариантРасчетаЗМ",МетаданныеОбъекта) Тогда
			ТекОбъект.ВариантРасчетаЗМ = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ВариантРасчетаЗМ");	
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СпособРасчетаИндексов",МетаданныеОбъекта) Тогда
			ТекОбъект.СпособРасчетаИндексов = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","СпособРасчетаИндексов");	
		КонецЕсли;	
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ОкруглятьДоРублей",МетаданныеОбъекта) Тогда
			ТекОбъект.ОкруглятьДоРублей = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОкруглятьИтоговуюСтоимостьДоРублей");	
		КонецЕсли;	
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ОбрабатыватьПогрешность",МетаданныеОбъекта) Тогда
			ТекОбъект.ОбрабатыватьПогрешность = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОбрабатыватьПогрешность");	
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("НеОкруглятьНДС",МетаданныеОбъекта) Тогда
			ТекОбъект.НеОкруглятьНДС = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","НеОкруглятьНДС");
		КонецЕсли;	

	КонецЕсли;
	
	Если ТипЗнч(ТекОбъект.Ссылка) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		// Заполнение параметров печати.
		ТекОбъект.ПечататьКоэффициентыТЧ 	= Истина;
		ТекОбъект.ПечататьЗаголовкиРазделов = Истина;
		ТекОбъект.ПечататьИтогиПоРазделам 	= Перечисления.СМ_ПечатьИтоговРаздела.ПечататьПервые;
		ТекОбъект.ПечататьИтогиПоВидамРабот = Истина;
		ТекОбъект.ПечататьПрефикс 			= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОтображатьПрефиксы", Ложь);
		// Заполнение реквизитов методики ТСН.
		ТекОбъект.МетодикаТСН 				= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"МетодикаТСН");
		ТекОбъект.ПрименитьЗУНормамМат 		= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ПрименитьЗУНормамМат");
		ТекОбъект.ПрименитьЗУНормамМаш 		= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ПрименитьЗУНормамМаш");
		ТекОбъект.ПрименитьЗУТрудРабочих 	= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ПрименитьЗУТрудРабочих");
		ТекОбъект.ПрименитьЗУТрудМашинистов = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ПрименитьЗУТрудМашинистов");
		ТекОбъект.РегионДляВыбораЦен 		= Справочники.СМ_СметноНормативныеБазы.ПолучитьПоРайону(ТекОбъект.Район);
		// Заполнение методики расчета по объекту
		ТекОбъект.МетодикаРасчета			= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОсновнаяМетодикаРасчета");
	ИначеЕсли ТипЗнч(ТекОбъект.Ссылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета")
		ИЛИ ТипЗнч(ТекОбъект.Ссылка) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		ТекОбъект.МетодикаРасчета			= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОсновнаяМетодикаРасчета");
	КонецЕсли;
	
КонецПроцедуры

// Заполняет реквизиты НСИ данными из настроек пользователя (значениями по умолчанию).
//
// Параметры:
//     ТекОбъект - Объект - реквизиты которого заполняются.
//
Процедура ЗаполнитьНСИПользователяПоУмолчанию(ТекОбъект) Экспорт
	Если ТипЗнч(ТекОбъект.Ссылка) = Тип("СправочникСсылка.СМ_НормативныеСборники") Тогда
		Если Не ТекОбъект.ЭтоГруппа Тогда
			ТекОбъект.Определитель = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","НСИ_Определитель");
		КонецЕсли;
		ТекОбъект.ТипНормативногоСборника = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","НСИ_ТипНормативногоСборника");
		ТекОбъект.УровеньЦен = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","НСИ_УровеньЦен");
	ИначеЕсли ТипЗнч(ТекОбъект.Ссылка) = Тип("СправочникСсылка.СМ_Ресурсы") Тогда
		Если Не ТекОбъект.ЭтоГруппа Тогда
			ТекОбъект.КлассГруза = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","НСИ_КлассГруза");
			ТекОбъект.ГруппаРесурсов = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","НСИ_ГруппаРесурсов");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбщиеПроцедурыРаботыСОбъектамиСметы

// Возвращает структуру с ключевыми параметрами сметы.
//
// Параметры:
//     Смета 				- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на смету.  
//     ПозицияИлиРаздел 	- ДокументСсылка - ссылка на позиция или раздел. 
//     Ид 					- УникальныйИдентификатор - позиция или раздел (в случае незаписанных значений).
//
// Возвращаемое значение:
//     Структура - содержит реквизиты сметы (перечень полей - см. в теле функции).
//
Функция ПолучитьСтруктуруПараметровРасчетаЛС(Смета = Неопределено, ПозицияИлиРаздел = Неопределено, Ид = "") Экспорт

	Если Не ЗначениеЗаполнено(Смета) Тогда
		Если ПозицияИлиРаздел = Неопределено Тогда 
			// Тут могут быть и немутабельные значения (например, незаписанные объекты).
			Элемент = НайтиПоИД(Ид);
		Иначе
			Элемент = ПозицияИлиРаздел;
		КонецЕсли;  
		Смета = НайтиЛС(Элемент);
	КонецЕсли;	
	
	// ПОЛЯ СТРУКТУРЫ НЕ УДАЛЯТЬ.
	// ТОЛЬКО ДОБАВЛЯТЬ!.
	
	Структура = Новый Структура();
	Структура.Вставить("НомерСметы", Смета.НомерСметы);
	Структура.Вставить("Наименование", Смета.Наименование);
	Структура.Вставить("МетодРасчета", Смета.МетодРасчета);
	Структура.Вставить("Уровень", Смета.Уровень);
	Структура.Вставить("ТипРайона", Смета.ТипРайона);
	Структура.Вставить("КодРайона", Смета.Район.Код);
	Структура.Вставить("Район", Смета.Район);
	Структура.Вставить("ВариантРасчетаЗМ", Смета.ВариантРасчетаЗМ);
	Структура.Вставить("ТипСтроительства", Смета.ТипСтроительства);
	Структура.Вставить("ПрименятьКоэффициентыНРСП", Смета.ПрименятьКоэффициентыНРСП);
	Структура.Вставить("УпрощеннаяСН", Смета.УпрощеннаяСН);
	Структура.Вставить("РеконструкцияАЭС", Смета.РеконструкцияАЭС);
	Структура.Вставить("СметаНаРемонт", Смета.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт);
	Структура.Вставить("ВариантРасчетаЗМ", Смета.ВариантРасчетаЗМ);
	Структура.Вставить("ВариантПересчетаЭММ", Смета.ВариантПересчетаЭММ);
	Структура.Вставить("ОкруглятьДоРублей", Смета.ОкруглятьДоРублей);

	Структура.Вставить("ЭтоБазисноИндексныйУровеньРасценка", (Смета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный И Смета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка));
	Структура.Вставить("ЭтоБазисноИндексныйУровеньРаздел", (Смета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный И Смета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел));
	Структура.Вставить("ЭтоБазисноИндексныйУровеньСмета", (Смета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный И Смета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета));
	Структура.Вставить("ЭтоРесурсныйМетод", (Смета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный));
	
	Структура.Вставить("ЭтоИндексыПоЭлементам", (Смета.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат));
	
	Структура.Вставить("АвтозагрузкаИндексов", Смета.АвтозагрузкаИндексов);
	Структура.Вставить("АвтозагрузкаЦен", Смета.АвтозагрузкаЦен);
	Структура.Вставить("ДатаТекущихЦен", Смета.ДатаТекущихЦен);
	Структура.Вставить("ДатаВыпускаИндексов", Смета.ДатаВыпускаИндексов);
	Структура.Вставить("ФайлСборникаКоэффициентов", Смета.ФайлСборникаКоэффициентов);
	Структура.Вставить("ФайлСборникаТекущихЦен", Смета.ФайлСборникаТекущихЦен);
	Структура.Вставить("РегионДляВыбораЦен", Смета.РегионДляВыбораЦен);
	Структура.Вставить("КодРегионаФайлаТекущихЦен", Смета.КодРегионаФайлаТекущихЦен);
	Структура.Вставить("ПрименятьИндексыКоВсемБазам", Смета.ПрименятьИндексыКоВсемБазам);
	Структура.Вставить("КодРегионаФайлаИндексовПересчета", Смета.КодРегионаФайлаИндексовПересчета);
	Структура.Вставить("МетодикаТСН", Ложь);
	Структура.Вставить("Методика1984", Ложь);
	Структура.Вставить("РасчетНРиСПотПЗ", Ложь);
	Структура.Вставить("БезПримененияКоэффициентов", 0);
	Структура.Вставить("РегионДляВыбораЦен", Смета.РегионДляВыбораЦен);
	Структура.Вставить("МетодикаКазахстана", ПолучитьФункциональнуюОпцию("СМ_КЗ_МетодикаРСНБКазахстан") и (Смета.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_КЗ_РСНБ));
	Структура.Вставить("МетодикаРасчета", Смета.МетодикаРасчета);
	
	Если Смета.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква Тогда
		Структура.МетодикаТСН = Истина;
	КонецЕсли;
		
	Метод1984 = ПолучитьФункциональнуюОпцию("СМ_Методика84Года");
	Если Метод1984 Тогда
		Если Смета.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_Методика84года Тогда
			Структура.Методика1984 = Истина;
		КонецЕсли;
		//Структура.Вставить("Методика1984", Смета.Методика1984);
		Структура.Вставить("РасчетНРиСПотПЗ", Смета.РасчетНРиСПотПЗ);
		Структура.Вставить("БезПримененияКоэффициентов", Смета.БезПримененияКоэффициентов);
	КонецЕсли;	
	
	Возврат Структура;
	
КонецФункции

// Возвращает элемент, найденный по ссылке.
//
// Параметры:
//     Ид - ДокументСсылка - ссылка на элемент информационной базы, который ищем.
//
// Возвращаемое значение:
//     Элемент - ДокументСсылка - ссылка на найденный элемент ИЛИ Неопределено.
//
Функция НайтиПоИД(Ид) Экспорт 
	
	Элемент = Неопределено;
		
	Если ЗначениеЗаполнено(Ид) Тогда
		Элемент = Ид;	
	КонецЕсли;
	
	Возврат Элемент;
	
КонецФункции

// Получает список подчиненных документов текущей строке сметного дерева.
// ВАЖНО: Если параметр ВсеПодчиненные = ИСТИНА, то в качестве Ид можно передавать только Смету.
// TO DO: Перенести в серверный модуль.
//
// Параметры:
//     Ид 				- ДокументСсылка	- ссылка на текущий элемент информационной базы.
//     ВключатьРазделы 	- Булево			- включаем ИЛИ нет подчиненные разделы.
//     ВключатьПозиции 	- Булево			- включаем ИЛИ нет подчиненные позиции.
//     ВключатьНеучтенныеРесурсы - Булево	- включаем ИЛИ нет подчиненные неучтенные ресурсы.
//     ВсеПодчиненные 	- Булево			- включаем вообще все нижестоящее дерево ИЛИ только следующий уровень.
//
// Возвращаемое значение:
//     Таблица - ТаблицаЗначений - содержит найденные нижестоящие элементы.
//
Функция ПолучитьТаблицуПодчиненных(Ид, ВключатьРазделы = Истина, ВключатьПозиции = Истина, ВключатьНеучтенныеРесурсы = Истина, ВсеПодчиненные = Ложь) Экспорт
	
	Таблица = Новый ТаблицаЗначений();
	Если (Ид = Неопределено) Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "";
	
	Если ВключатьРазделы Тогда
		Запрос.Текст = Запрос.Текст +  "ВЫБРАТЬ
		|	РазделЛокальнойСметы.Ссылка КАК Ид,
		|	РазделЛокальнойСметы.ИДРодителя КАК ИдРодителя,
		|	РазделЛокальнойСметы.ИДСметы КАК ИДСметы,
		|	ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка) КАК ИДПозицииВладельца
		|ИЗ
		|	Документ.СМ_РазделЛокальнойСметы КАК РазделЛокальнойСметы              
		|ГДЕ
		|	"+?(Не ВсеПодчиненные,"РазделЛокальнойСметы.ИДРодителя = &ИДРодителя","РазделЛокальнойСметы.ИДСметы = &ИДРодителя")+" 
		|   ";
		Если ВключатьПозиции ИЛИ ВключатьНеучтенныеРесурсы Тогда
			Запрос.Текст = Запрос.Текст + " ОБЪЕДИНИТЬ  
				| ";
		КонецЕсли;
	КонецЕсли;
	
	Если ВключатьПозиции Тогда
		Если ВсеПодчиненные Тогда
			Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
			|	ПозицияЛокальнойСметы.Ссылка КАК Ид,
			|	ПозицияЛокальнойСметы.ИДРодителя КАК ИдРодителя,
			|	ПозицияЛокальнойСметы.ИДСметы КАК ИДСметы,
			|	ПозицияЛокальнойСметы.ИДПозицииВладельца КАК ИДПозицииВладельца
			|ИЗ
			|	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
			|ГДЕ
			|	ПозицияЛокальнойСметы.ИДСметы = &ИДРодителя";
			Если Не ВключатьНеучтенныеРесурсы Тогда
				Запрос.Текст = Запрос.Текст +" И НЕ ПозицияЛокальнойСметы.ИДПозицииВладельца = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)";
			КонецЕсли;	
		Иначе
			Если  ВключатьНеучтенныеРесурсы Тогда
				///
				Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
				|	ПозицияЛокальнойСметы.Ссылка КАК Ид,
				|	ПозицияЛокальнойСметы.ИДРодителя КАК ИдРодителя,
				|	ПозицияЛокальнойСметы.ИДСметы КАК ИДСметы,
				|	ПозицияЛокальнойСметы.ИДПозицииВладельца КАК ИДПозицииВладельца
				|ИЗ
				|	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
				|ГДЕ
				|	ПозицияЛокальнойСметы.ИДРодителя = &ИДРодителя
				|
				|ОБЪЕДИНИТЬ
				|
				|ВЫБРАТЬ
				|	ПозицияЛокальнойСметы.Ссылка,
				|	ПозицияЛокальнойСметы.ИДРодителя,
				|	ПозицияЛокальнойСметы.ИДСметы,
				|	ПозицияЛокальнойСметы.ИДПозицииВладельца
				|ИЗ
				|	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
				|ГДЕ
				|	ПозицияЛокальнойСметы.ИДПозицииВладельца = &ИДРодителя";
			Иначе
				Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
				|	ПозицияЛокальнойСметы.Ссылка КАК Ид,
				|	ПозицияЛокальнойСметы.ИДРодителя КАК ИдРодителя,
				|	ПозицияЛокальнойСметы.ИДСметы КАК ИДСметы,
				|	ПозицияЛокальнойСметы.ИДПозицииВладельца КАК ИДПозицииВладельца
				|ИЗ
				|	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
				|ГДЕ
				|	ПозицияЛокальнойСметы.ИДРодителя = &ИДРодителя";
				
			КонецЕсли;
			
			
		Конецесли;
		
	ИначеЕсли  ВключатьНеучтенныеРесурсы И Не ВсеПодчиненные Тогда
		Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
		                              |	ПозицияЛокальнойСметы.Ссылка КАК Ид,
		                              |	ПозицияЛокальнойСметы.ИДРодителя КАК ИдРодителя,
		                              |	ПозицияЛокальнойСметы.ИДСметы КАК ИДСметы,
		                              |	ПозицияЛокальнойСметы.ИДПозицииВладельца КАК ИДПозицииВладельца
		                              |ИЗ
		                              |	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
		                              |ГДЕ
		                              |	ПозицияЛокальнойСметы.ИДПозицииВладельца = &ИДРодителя";

	КонецЕсли;	
	
	Запрос.УстановитьПараметр("ИДРодителя", ПолучитьСсылкуНаДокумент(Ид));
	
	Возврат Запрос.Выполнить().Выгрузить();
	                          	
КонецФункции

// Находит локальную смету для текущей позиции ИЛИ раздела.
//
// Параметры:
//     ДокументСсылка - ДокументСсылка - ссылка на текущий объект.
//
