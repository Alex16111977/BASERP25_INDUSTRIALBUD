	ЭлементБлокировки.УстановитьЗначение("Смета", Смета);
	
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками");   
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Смета", Смета);    
	
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП");   
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Смета", Смета);    
	
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета");   
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Смета", Смета);    
	
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_ИтогиЧППоРазделу");   
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Смета", Смета);   
	
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_НРиСП");   
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Смета", Смета);    
	
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_СредняяТекущаяСтоимостьРесурсовПозиции");   
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Смета", Смета);    
	
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_ИтогиПоРазделу");   
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Смета", Смета);  
	
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_ИтогиПоВидамРабот");   
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Смета", Смета);    
	
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_ИтогиПоСмете");   
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Смета", Смета);    
	
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_ИтогиПоГлавам");   
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Смета", Смета);    

	
	ТЗОбъектов = ПолучитьТаблицуПодчиненных(Смета,Истина,Истина,Истина,Истина);
	Объекты = ТЗОбъектов.ВыгрузитьКолонку("Ид");
	
	ТаблицаЗакрытыхОбъемов = Неопределено;
	ТаблицаЗакрытыхОбъемов = ПолучитьЗакрытыеОбъемыПозиций(Смета);
	
	Перенумеруем = Ложь;
	
	Если ТаблицаЗакрытыхОбъемов.Количество()>0 Тогда
		РазделитьПозиции(Объекты,Смета,ТаблицаЗакрытыхОбъемов,Перенумеруем);
	КонецЕсли;
	
	Если Перенумеруем Тогда
		СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(Смета);
	КонецЕсли;
	
	Если Пересчитать Тогда
		Документы.СМ_ЛокальнаяСмета.Перерасчет(Смета,Ложь);
	КонецЕсли;
	
	Если Не Транзакция Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
КонецПроцедуры

Процедура РазделитьПозиции(Объекты, Смета = Неопределено,ТаблицаЗакрытыхОбъемов = Неопределено,Перенумеруем = Ложь) Экспорт
	
	ТЗ = Новый  ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ОбъектБыл");
	ТЗ.Колонки.Добавить("ОбъектСтал");
	ТЗ.Колонки.Добавить("ОбъектОстатка");
	Для сч = 1 По Объекты.количество() Цикл
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.ОбъектБыл = Объекты.получить(сч-1);
	КонецЦикла;	
	
	
	Для Каждого  СтрокаТз Из ТЗ Цикл
		Если (ТипЗнч(СтрокаТз.ОбъектБыл) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"))
			И (Не ЗначениеЗаполнено(СтрокаТз.ОбъектБыл.ИдПозицииВладельца)) Тогда
			
			НоваяПозиция = СтрокаТз.ОбъектБыл.ПолучитьОбъект();
			Разделяем = Ложь;	
			СтрокаОбъема = ТаблицаЗакрытыхОбъемов.Найти(СтрокаТз.ОбъектБыл);
			Если Не СтрокаОбъема = Неопределено Тогда
				Если СтрокаОбъема.ОбъемВсего > 0 И СтрокаОбъема.ОбъемВсего < СтрокаТз.объектБыл.ОбъемРабот Тогда
					НоваяПозиция.ОбъемРабот = СтрокаОбъема.ОбъемВсего;
					Остаток = СтрокаТз.объектБыл.ОбъемРабот - СтрокаОбъема.ОбъемВсего;
					Разделяем = Истина;
					НоваяПозиция.Записать();
				КонецЕсли;
			КонецЕсли;
			
			СтрокаТз.объектСтал = СтрокаТз.ОбъектБыл;
			
			Если Разделяем Тогда
				Перенумеруем = Истина;
				РазделяемНоваяПозиция = СоздатьНовуюПозицию();  // Разделением
				СкопироватьПозицию(РазделяемНоваяПозиция,НоваяПозиция);
				РазделяемНоваяПозиция.ОбъемРабот 		= Остаток;
				РазделяемНоваяПозиция.СпособСоздания	= Перечисления.СМ_ИсточникиДобавленияПозиций.Разделением;
				РазделяемНоваяПозиция.ИсточникСоздания	= НоваяПозиция.Номер;				
				РазделяемНоваяПозиция.Записать();
				СтрокаТз.ОбъектОстатка = РазделяемНоваяПозиция.Ссылка;
				НомерБыл = ПолучитьНомерДокумента(НоваяПозиция, "СМ_ПозицияЛокальнойСметы"); 
				НомерВДереве = НомерБыл.НомерВДереве+0.01;
				УстановитьНомерДокумента(СтрокаТз.ОбъектОстатка,,, НомерВДереве, ,"СМ_ПозицияЛокальнойСметы"); 
				
				// надо прикрепить подчиненные расценки
				ПривязанныеПозиции = ПолучитьПривязанныеПозиции(СтрокаТз.ОбъектБыл);
				Для Каждого СтрПривязка Из ПривязанныеПозиции Цикл
					
					нОтбор = Новый Структура;
					нОтбор.Вставить("ОбъектБыл",СтрПривязка.Ссылка);
					нСтроки = ТЗ.НайтиСтроки(нОтбор);
					нСтрока = нСтроки.Получить(0);
					СтрокаОбъема = ТаблицаЗакрытыхОбъемов.Найти(СтрПривязка.Ссылка);
					Если Не СтрокаОбъема = Неопределено Тогда
						Если СтрокаОбъема.ОбъемВсего > 0 И СтрокаОбъема.ОбъемВсего < СтрПривязка.Ссылка.ОбъемРабот Тогда
							
							НомерВДереве = НомерВДереве+0.01;
							НоваяПозиция = СоздатьНовуюПозицию();  // Разделением
							СкопироватьПозицию(НоваяПозиция, СтрПривязка.Ссылка);
							НоваяПозиция.ИДПозицииВладельца = СтрокаТз.ОбъектОстатка;
							НоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Разделением;
							НоваяПозиция.ИсточникСоздания	= СтрПривязка.Ссылка.Номер;									
							ЗаменитьРодителя(СтрокаТз.ОбъектОстатка, НоваяПозиция);
							
							Остаток = СтрПривязка.Ссылка.ОбъемРабот - СтрокаОбъема.ОбъемВсего;
							НоваяПозиция.ОбъемРабот = Остаток;
							
							НовыйОбъем =  Остаток;
							СтарыйОбъем = СтрПривязка.Ссылка.ОбъемРабот;
							Если ЗначениеЗаполнено(НоваяПозиция.ФормулаОбъема) Тогда
								ВычОбъем = 0;
								Формула = "ВычОбъем = Значение";
								ФормулаОбъема = СтрЗаменить(НоваяПозиция.ФормулаОбъема,",",".");
								Формула = СтрЗаменить(Формула,"Значение",ФормулаОбъема);
								Попытка
									Выполнить(Формула);
									ТекОбъем = (ВычОбъем/СтарыйОбъем)*НовыйОбъем;
									Норма = ВычОбъем/СтарыйОбъем;
								Исключение
									Если СтарыйОбъем = 0 Тогда
										ТекОбъем = НовыйОбъем;
									Иначе
										ТекОбъем = (НоваяПозиция.ОбъемРабот/СтарыйОбъем)*НовыйОбъем;
										Норма = НоваяПозиция.ОбъемРабот/СтарыйОбъем;
									КонецЕсли;
								КонецПопытки;
							Иначе
								ТекОбъем = (НоваяПозиция.ОбъемРабот/СтарыйОбъем)*НовыйОбъем;
								Норма = НоваяПозиция.ОбъемРабот/СтарыйОбъем;
							КонецЕсли;
							Если СтарыйОбъем = 0 Тогда
								НоваяПозиция.ФормулаОбъема = "1" + "*" + СокрЛП(Строка(Формат(ТекОбъем,"ЧГ=0")));
							Иначе
								НоваяПозиция.ФормулаОбъема = СокрЛП(Строка(Формат(НовыйОбъем,"ЧГ=0"))) + "*" + СокрЛП(Строка(Формат(Норма,"ЧГ=0")));
							КонецЕсли;
							
							НоваяПозиция.Записать();
							УстановитьНомерДокумента(НоваяПозиция.Ссылка,,,НомерВДереве, ,"СМ_ПозицияЛокальнойСметы"); 
							нСтрока.ОбъектОстатка = НоваяПозиция.Ссылка;

						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	   
	
	// Обработали просты позиции, осталось обработать привязанные. 	
	Для Каждого  СтрокаТз Из ТЗ Цикл
		Если (ТипЗнч(СтрокаТз.ОбъектБыл) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"))
			И (ЗначениеЗаполнено(СтрокаТз.ОбъектБыл.ИдПозицииВладельца)) Тогда
			
			НоваяПозиция = СтрокаТз.ОбъектБыл.ПолучитьОбъект();
			
			Разделяем = Ложь;
			СтрокаОбъема = ТаблицаЗакрытыхОбъемов.Найти(СтрокаТз.ОбъектБыл);
			Если Не СтрокаОбъема = Неопределено Тогда
				Если СтрокаОбъема.ОбъемВсего > 0 И СтрокаОбъема.ОбъемВсего < СтрокаТз.объектБыл.ОбъемРабот Тогда
					НоваяПозиция.ОбъемРабот = СтрокаОбъема.ОбъемВсего;
					Остаток = СтрокаТз.объектБыл.ОбъемРабот - СтрокаОбъема.ОбъемВсего;
					Разделяем = Истина;
				КонецЕсли;
			КонецЕсли;

			
			Если Объекты.Найти(СтрокаТз.ОбъектБыл.ИДПозицииВладельца) <> Неопределено Тогда
				// Значит, эта позиция копируется в составе раздела.
				// Необходимо указать родителя - копию раздела.
			    нОтбор = Новый Структура;
				нОтбор.Вставить("ОбъектБыл",СтрокаТз.объектБыл.ИДПозицииВладельца);
				нСтроки = ТЗ.НайтиСтроки(нОтбор);
				Если нСтроки.Количество() > 0 Тогда
					нСтрока = нСтроки.Получить(0);
					Если нСтрока.ОбъектСтал <> Неопределено Тогда
						Если Разделяем Тогда
							НовыйОбъем =  нСтрока.ОбъектСтал.ОбъемРабот;
							СтарыйОбъем = СтрокаТз.объектБыл.ИДПозицииВладельца.ОбъемРабот;
							Если ЗначениеЗаполнено(НоваяПозиция.ФормулаОбъема) Тогда
								ВычОбъем = 0;
								Формула = "ВычОбъем = Значение";
								ФормулаОбъема = СтрЗаменить(НоваяПозиция.ФормулаОбъема,",",".");
								Формула = СтрЗаменить(Формула,"Значение",ФормулаОбъема);
								Попытка
									Выполнить(Формула);
									ТекОбъем = (ВычОбъем/СтарыйОбъем)*НовыйОбъем;
									Норма = ВычОбъем/СтарыйОбъем;
								Исключение
									Если СтарыйОбъем = 0 Тогда
										ТекОбъем = НовыйОбъем;
									Иначе
										ТекОбъем = (НоваяПозиция.ОбъемРабот/СтарыйОбъем)*НовыйОбъем;
										Норма = НоваяПозиция.ОбъемРабот/СтарыйОбъем;
									КонецЕсли;
								КонецПопытки;
							Иначе
								ТекОбъем = (НоваяПозиция.ОбъемРабот/СтарыйОбъем)*НовыйОбъем;
								Норма = НоваяПозиция.ОбъемРабот/СтарыйОбъем;
							КонецЕсли;
							Если СтарыйОбъем = 0 Тогда
								НоваяПозиция.ФормулаОбъема = "1" + "*" + СокрЛП(Строка(Формат(ТекОбъем,"ЧГ=0")));
							Иначе
								НоваяПозиция.ФормулаОбъема = СокрЛП(Строка(Формат(НовыйОбъем,"ЧГ=0"))) + "*" + СокрЛП(Строка(Формат(Норма,"ЧГ=0")));
							КонецЕсли;
						КонецЕсли;
						
						НоваяПозиция.Записать();
						СтрокаТз.ОбъектСтал = СтрокаТз.ОбъектБыл;						
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден родитель для позиции %1. Позиция не скопирована.'"), ПолучитьТекстИнформацииОПозиции(НоваяПозиция)));
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
			
			Если Разделяем Тогда
				Перенумеруем = Истина;
				нОтбор = Новый Структура;
				нОтбор.Вставить("ОбъектБыл",СтрокаТз.объектБыл.ИДПозицииВладельца);
				нСтроки = ТЗ.НайтиСтроки(нОтбор);
				Если нСтроки.Количество() > 0 Тогда
					нСтрока = нСтроки.Получить(0);
					Если Не ЗначениеЗаполнено(нСтрока.ОбъектОстатка) Тогда
						НоваяИДПозицииВладельца = СоздатьНовуюПозицию();  // Разделением
						СкопироватьПозицию(НоваяИДПозицииВладельца,нСтрока.ОбъектСтал);
						НоваяИДПозицииВладельца.ОбъемРабот 			= 0;
						НоваяИДПозицииВладельца.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Разделением;
						НоваяИДПозицииВладельца.ИсточникСоздания	= нСтрока.ОбъектСтал.Номер;							
						НоваяИДПозицииВладельца.Записать();
						нСтрока.ОбъектОстатка = НоваяИДПозицииВладельца.Ссылка;
						НомерБыл = ПолучитьНомерДокумента(нСтрока.ОбъектСтал, "СМ_ПозицияЛокальнойСметы"); 
						НомерВДереве = НомерБыл.НомерВДереве+0.01;
						УстановитьНомерДокумента(нСтрока.ОбъектОстатка,,, НомерВДереве, ,"СМ_ПозицияЛокальнойСметы"); 
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(СтрокаТз.ОбъектОстатка) Тогда	
						РазделяемНоваяПозиция = СоздатьНовуюПозицию();  // Разделением
						СкопироватьПозицию(РазделяемНоваяПозиция,НоваяПозиция);
						РазделяемНоваяПозиция.ИДПозицииВладельца 	= нСтрока.ОбъектОстатка;
						РазделяемНоваяПозиция.ОбъемРабот 			= Остаток;
						РазделяемНоваяПозиция.ФормулаОбъема 		= "";
						РазделяемНоваяПозиция.СпособСоздания		= Перечисления.СМ_ИсточникиДобавленияПозиций.Разделением;
						РазделяемНоваяПозиция.ИсточникСоздания		= НоваяПозиция.Номер;								
						РазделяемНоваяПозиция.Записать();
						СтрокаТз.ОбъектОстатка = РазделяемНоваяПозиция.Ссылка;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;

		КонецЕсли;	
	КонецЦикла;	   
	
КонецПроцедуры	

Функция ПолучитьЗакрытыеОбъемыПозиций(Смета) Экспорт
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_АктВыполненныхРаботПозиции.Позиция,
	               |	СУММА(СМ_АктВыполненныхРаботПозиции.ФактОбъем) КАК Всего
	               |ПОМЕСТИТЬ ПозицииАктов
	               |ИЗ
	               |	Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_АктВыполненныхРаботПозиции
	               |ГДЕ
	               |	СМ_АктВыполненныхРаботПозиции.Ссылка.ЛокальнаяСмета = &Ссылка
	               |	И СМ_АктВыполненныхРаботПозиции.Ссылка.Проведен = ИСТИНА
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_АктВыполненныхРаботПозиции.Позиция
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПозицияЛокальнойСметы.Ссылка,
	               |	ЕСТЬNULL(ПозицииАктов.Всего, 0) КАК ОбъемВсего
	               |ПОМЕСТИТЬ ПозицииЛокальнойСметыВременная
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПозицииАктов КАК ПозицииАктов
	               |		ПО ПозицияЛокальнойСметы.Ссылка = ПозицииАктов.Позиция
	               |ГДЕ
	               |	ПозицияЛокальнойСметы.ИДСметы = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПозицияЛокальнойСметыДок.Ссылка КАК Позиция,
	               |	ПозицияЛокальнойСметыДок.ОбъемВсего КАК ОбъемВсего
	               |ИЗ
	               |	ПозицииЛокальнойСметыВременная КАК ПозицияЛокальнойСметыДок";
    Запрос.УстановитьПараметр("Ссылка",Смета);
				   
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьЗакрытыеОбъемыПоМассивуПозиций(МассивПозиций) Экспорт
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_АктВыполненныхРаботПозиции.Позиция,
	               |	СУММА(СМ_АктВыполненныхРаботПозиции.ФактОбъем) КАК Всего
	               |ПОМЕСТИТЬ ПозицииАктов
	               |ИЗ
	               |	Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_АктВыполненныхРаботПозиции
	               |ГДЕ
	               |	СМ_АктВыполненныхРаботПозиции.Позиция.Ссылка В(&Список)
	               |	И СМ_АктВыполненныхРаботПозиции.Ссылка.Проведен = ИСТИНА
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_АктВыполненныхРаботПозиции.Позиция
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПозицияЛокальнойСметы.Ссылка,
	               |	ЕСТЬNULL(ПозицииАктов.Всего, 0) КАК ОбъемВсего
	               |ПОМЕСТИТЬ ПозицииЛокальнойСметыВременная
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПозицииАктов КАК ПозицииАктов
	               |		ПО ПозицияЛокальнойСметы.Ссылка = ПозицииАктов.Позиция
	               |ГДЕ
	               |	ПозицияЛокальнойСметы.Ссылка В(&Список)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПозицияЛокальнойСметыДок.Ссылка КАК Позиция,
	               |	ПозицияЛокальнойСметыДок.ОбъемВсего КАК ОбъемВсего
	               |ИЗ
	               |	ПозицииЛокальнойСметыВременная КАК ПозицияЛокальнойСметыДок";
    Запрос.УстановитьПараметр("Список",МассивПозиций);
				   
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Функция копирования объектной сметы.
Процедура СкопироватьОбъектнуюСмету(СтараяСмета,Транзакция = Ложь,НоваяСмета = Неопределено,ИДРодителя = Неопределено,ВАрхив = Ложь,Перерасчет = Истина, СписокАктовДляПересчета = Неопределено) Экспорт
	
	Если Не Транзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	
	Если Перерасчет и СписокАктовДляПересчета = Неопределено Тогда
		СписокАктовДляПересчета = Новый СписокЗначений();
	КонецЕсли;       	
	 
	СсылкаНового = Документы.СМ_ОбъектнаяСмета.ПолучитьСсылку();
	НоваяСмета = Документы.СМ_ОбъектнаяСмета.СоздатьДокумент();
	НоваяСмета.УстановитьСсылкуНового(СсылкаНового);
	
	ЗаполнитьЗначенияСвойств(НоваяСмета, СтараяСмета,,"ИДРодителя");
	
	Если ВАрхив Тогда
		НоваяСмета.Статус = Перечисления.СМ_СтатусыСметныхДокументов.Архив;
	КонецЕсли;

	Если Не ИДРодителя = Неопределено Тогда
		НоваяСмета.ИДРодителя = ИДРодителя;
	КонецЕсли;

	НоваяСмета.ЛимитированныеЗатраты.Загрузить(СтараяСмета.ЛимитированныеЗатраты.Выгрузить());
	НоваяСмета.Подписи.Загрузить(СтараяСмета.Подписи.Выгрузить());
	НоваяСмета.УстановитьНовыйНомер();
	НоваяСмета.Дата = ТекущаяДатаСеанса(); 
	НоваяСмета.Записать();
	
	НоваяСмета.ЛокальныеСметы.Загрузить(СтараяСмета.ЛокальныеСметы.Выгрузить());
	Для Каждого ЛС Из НоваяСмета.ЛокальныеСметы Цикл
		Смета = Неопределено;
		Если ЛС.ЛокальнаяСмета.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		СкопироватьЛокальнуюСмету(ЛС.ЛокальнаяСмета,,Не Транзакция,Смета,СсылкаНового,ВАрхив,Ложь,СписокАктовДляПересчета);
		ЛС.ЛокальнаяСмета = Смета.Ссылка;
	КонецЦикла;
	НоваяСмета.Записать();
	
	ИзменитьСтройку(НоваяСмета.Ссылка, НоваяСмета.Стройка);
	
	Если Перерасчет Тогда
		Документы.СМ_ОбъектнаяСмета.ПерерасчетПодчиненныхСмет(НоваяСмета.Ссылка);
		Документы.СМ_ОбъектнаяСмета.Перерасчет(НоваяСмета.Ссылка,Истина);
		Для Каждого Стр Из СписокАктовДляПересчета Цикл
		
			Акт = Стр.Значение;
			Документы.СМ_АктВыполненныхРабот.Перерасчет(Акт);
			
		КонецЦикла;
	КонецЕсли;
	
	Если Не Транзакция Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры

// Функция копирования сводной сметы.
Процедура СкопироватьСводнуюСмету(СтараяСмета,ВАрхив = Ложь, Пересчет = Истина) Экспорт
	
	СсылкаНового = Документы.СМ_СводнаяСмета.ПолучитьСсылку();
	НоваяСмета = Документы.СМ_СводнаяСмета.СоздатьДокумент();
	НоваяСмета.УстановитьСсылкуНового(СсылкаНового);
	
	СписокАктовСводнойСметы = Новый СписокЗначений();
	
	ЗаполнитьЗначенияСвойств(НоваяСмета, СтараяСмета);

	Если ВАрхив Тогда
		НоваяСмета.Статус = Перечисления.СМ_СтатусыСметныхДокументов.Архив;
	КонецЕсли;
	
	НоваяСмета.ЛимитированныеЗатраты.Загрузить(СтараяСмета.ЛимитированныеЗатраты.Выгрузить());
	НоваяСмета.Подписи.Загрузить(СтараяСмета.Подписи.Выгрузить());
	НоваяСмета.УстановитьНовыйНомер();
	НоваяСмета.Дата = ТекущаяДатаСеанса(); 
	НоваяСмета.Записать();

	НоваяСмета.Сметы.Загрузить(СтараяСмета.Сметы.Выгрузить());
	Для Каждого СтрСмет Из НоваяСмета.Сметы Цикл
		Смета = Неопределено;
		Если СтрСмет.Смета.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(СтрСмет.Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			СкопироватьЛокальнуюСмету(СтрСмет.Смета,,Ложь,Смета,СсылкаНового,ВАрхив,Ложь,СписокАктовСводнойСметы);
		Иначе
			СкопироватьОбъектнуюСмету(СтрСмет.Смета,Истина,Смета,СсылкаНового,ВАрхив,Ложь,СписокАктовСводнойСметы);
		КонецЕсли;
		СтрСмет.Смета = Смета.Ссылка;
	КонецЦикла;
	НоваяСмета.Записать();
	
	ИзменитьСтройку(НоваяСмета.Ссылка, НоваяСмета.Стройка);

	Если Пересчет Тогда
		
		Документы.СМ_СводнаяСмета.ПерерасчетПодчиненныхСмет(НоваяСмета.Ссылка);//СУДАРИКОВ
		
		Документы.СМ_СводнаяСмета.Перерасчет(НоваяСмета.Ссылка,Истина);

		Для Каждого Стр Из СписокАктовСводнойСметы Цикл
		
			Акт = Стр.Значение;
			Документы.СМ_АктВыполненныхРабот.Перерасчет(Акт);
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

// Функция копирования раздела.
Процедура СкопироватьРаздел(НовыйРаздел, СтарыйРаздел) Экспорт
	
	ЗаполнитьЗначенияСвойств(НовыйРаздел, СтарыйРаздел,,"КорректируетРаздел");
	НовыйРаздел.УстановитьНовыйНомер();
	НовыйРаздел.Дата = ТекущаяДатаСеанса(); 
	НовыйРаздел.КорректируетРаздел = Документы.СМ_РазделЛокальнойСметы.ПустаяСсылка();
	ЗаполнитьДанныеДокументаВСтруктуреСмет(НовыйРаздел, СтарыйРаздел, ЛОЖЬ);
	
КонецПроцедуры

// Функция копирования позиции.
Процедура СкопироватьПозицию(НоваяПозиция, СтараяПозиция,БезИДПозицииВладельца = Ложь) Экспорт
	Если БезИДПозицииВладельца Тогда
		ЗаполнитьЗначенияСвойств(НоваяПозиция, СтараяПозиция,,"КорректируетПозицию,ИДПозицииВладельца");
	Иначе
		ЗаполнитьЗначенияСвойств(НоваяПозиция, СтараяПозиция,,"КорректируетПозицию");
	КонецЕсли;
	НоваяПозиция.УстановитьНовыйНомер();
	НоваяПозиция.Дата = ТекущаяДатаСеанса();
	НоваяПозиция.КорректируетПозицию = Документы.СМ_ПозицияЛокальнойСметы.ПустаяСсылка();
	
	Для каждого тчПозиции Из Метаданные.Документы.СМ_ПозицияЛокальнойСметы.ТабличныеЧасти Цикл
		Для каждого СтрокаТЧОбъектаБыл Из СтараяПозиция[тчПозиции.имя] Цикл
			СтрокаТЧ = НоваяПозиция[тчПозиции.Имя].добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТЧОбъектаБыл);	
		КонецЦикла;	
	КонецЦикла;	// Скопировали табличные части.
	
	ЗаполнитьДанныеДокументаВСтруктуреСмет(НоваяПозиция, ?(ЗначениеЗаполнено(СтараяПозиция.ИдПозицииВладельца) И Не БезИДПозицииВладельца, СтараяПозиция.ИдПозицииВладельца, СтараяПозиция.ИдРодителя), ЗначениеЗаполнено(СтараяПозиция.ИдПозицииВладельца) И Не БезИДПозицииВладельца);
	
КонецПроцедуры	

// Функция копирования акта.
Процедура СкопироватьАкт(НовыйАкт, СтарыйАкт, ТаблицаДокументов) Экспорт
	
	ЗаполнитьЗначенияСвойств(НовыйАкт, СтарыйАкт,,"ЛокальнаяСмета");
	
	НовыйАкт.УстановитьНовыйНомер();
	НовыйАкт.Дата = ТекущаяДатаСеанса();
	
	Если НовыйАкт.ЛокальнаяСмета.Статус = Перечисления.СМ_СтатусыСметныхДокументов.Архив Тогда
		НовыйАкт.Статус = Перечисления.СМ_СтатусыСметныхДокументов.Архив;
	КонецЕсли;
	
	Для каждого тчАкта Из Метаданные.Документы.СМ_АктВыполненныхРабот.ТабличныеЧасти Цикл
		Для каждого СтрокаТЧОбъектаБыл Из СтарыйАкт[тчАкта.имя] Цикл
			СтрокаТЧ =  НовыйАкт[тчАкта.Имя].добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТЧОбъектаБыл);	
			Если тчАкта = Метаданные.Документы.СМ_АктВыполненныхРабот.ТабличныеЧасти.Позиции Тогда
				нОтбор = Новый Структура;
				нОтбор.Вставить("ОбъектБыл",СтрокаТЧ.Позиция);
				нСтроки = ТаблицаДокументов.НайтиСтроки(нОтбор);
				Если нСтроки.Количество() > 0 Тогда
					нСтрока = нСтроки.Получить(0);
					СтрокаТЧ.Позиция = нСтрока.ОбъектСтал;
				Иначе
					Продолжить;
				КонецЕсли;
			ИначеЕсли тчАкта = Метаданные.Документы.СМ_АктВыполненныхРабот.ТабличныеЧасти.Разделы Тогда
				нОтбор = Новый Структура;
				нОтбор.Вставить("ОбъектБыл",СтрокаТЧ.Раздел);
				нСтроки = ТаблицаДокументов.НайтиСтроки(нОтбор);
				Если нСтроки.Количество() > 0 Тогда
					нСтрока = нСтроки.Получить(0);
					СтрокаТЧ.Раздел = нСтрока.ОбъектСтал;
				Иначе
					Продолжить;
				КонецЕсли;
			ИначеЕсли тчАкта = Метаданные.Документы.СМ_АктВыполненныхРабот.ТабличныеЧасти.РесурсыПозицийАкта Тогда	
				нОтбор = Новый Структура;
				нОтбор.Вставить("ОбъектБыл",СтрокаТЧ.Позиция);
				нСтроки = ТаблицаДокументов.НайтиСтроки(нОтбор);
				Если нСтроки.Количество() > 0 Тогда
					нСтрока = нСтроки.Получить(0);
					СтрокаТЧ.Позиция = нСтрока.ОбъектСтал;
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;	// Скопировали табличные части.
	
КонецПроцедуры	

// Функция изменения стройки в сметах верхнего уровня
Процедура ИзменитьСтройку(Документ, Стройка) Экспорт
	
	Если ЗначениеЗаполнено(Стройка) Тогда
	
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
			Для Каждого СтрСмета Из Документ.ЛокальныеСметы Цикл
				Если СтрСмета.ЛокальнаяСмета.Стройка <> Стройка Тогда
					Объект = СтрСмета.ЛокальнаяСмета.ПолучитьОбъект();
					Объект.Стройка = Стройка;
					Объект.Записать();
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
			Для Каждого СтрСмета Из Документ.Сметы Цикл
				Если СтрСмета.Смета.Стройка <> Стройка Тогда
					Объект = СтрСмета.Смета.ПолучитьОбъект();
					Объект.Стройка = Стройка;
					Объект.Записать();
					ИзменитьСтройку(СтрСмета.Смета, Стройка);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры	

// Функция заполнения индексов.
Процедура ЗаполнитьИндексыВСтроке(ТекЭлемент,СтрокаТаблицы,Обнулять)
	
	Если СтрокаТаблицы.КоэффОснЗарплаты <> 0 ИЛИ Обнулять Тогда
		ТекЭлемент.КоэффОснЗарплаты = СтрокаТаблицы.КоэффОснЗарплаты;	
	КонецЕсли;
	
    Если СтрокаТаблицы.КоэффСтоимЭксплМашин > 0 ИЛИ Обнулять Тогда
		ТекЭлемент.КоэффСтоимЭксплМашин = СтрокаТаблицы.КоэффСтоимЭксплМашин;	
	КонецЕсли;    
	
	Если СтрокаТаблицы.КоэффСтоимЗарплатеМашин > 0 ИЛИ Обнулять Тогда
		ТекЭлемент.КоэффСтоимЗарплатеМашин = СтрокаТаблицы.КоэффСтоимЗарплатеМашин;	
	КонецЕсли;
	
	Если СтрокаТаблицы.КоэффСтоимМатериалов > 0 ИЛИ Обнулять Тогда
		ТекЭлемент.КоэффСтоимМатериалов = СтрокаТаблицы.КоэффСтоимМатериалов;	
	КонецЕсли;
	
	Если СтрокаТаблицы.КоэффОборуд > 0 ИЛИ Обнулять Тогда
		ТекЭлемент.КоэффОборуд = СтрокаТаблицы.КоэффОборуд;	
	КонецЕсли;
	
	Если СтрокаТаблицы.КоэффПолнСтоимРабот > 0 ИЛИ Обнулять Тогда
		ТекЭлемент.КоэффПолнСтоимРабот = СтрокаТаблицы.КоэффПолнСтоимРабот;	
	КонецЕсли;
	
КонецПроцедуры

// Процедура добавляет в таблицу новую колонку "Позиция", и заполняет ее.
Процедура ДобавитьВТаблицуПозицию(Таблица, Позиция)
	
	Таблица.Колонки.Добавить("Позиция");
	Таблица.ЗаполнитьЗначения(Позиция, "Позиция");
	
КонецПроцедуры

// Функция дополняет таблицу 2 значениями из первой таблицы.
Функция ДополнитьТаблицуЗначениями(Таблица1, Таблица2)
	
	Для Каждого СтрокаТЧ Из Таблица1 Цикл
				
		НоваяСтрока = Таблица2.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		
	КонецЦикла;
	
	Возврат Таблица2;
	
КонецФункции

// Функция возвращает таблицу из исходной по заданному отбору.
Функция СоздатьТаблицуПоОтбору(ИсходнаяТаблица, ИмяКолонки, Значение)
	
	МассивУдаляемыхСтрок = Новый Массив;
	
	Для Каждого СтрокаТЧ Из ИсходнаяТаблица Цикл 
		Если СтрокаТЧ[ИмяКолонки] = Значение Тогда
			Продолжить;
		КонецЕсли;
		МассивУдаляемыхСтрок.Добавить(СтрокаТЧ);
	КонецЦикла;
	Для Каждого СтрокаТЧ Из МассивУдаляемыхСтрок Цикл
		ИсходнаяТаблица.Удалить(СтрокаТЧ);
	КонецЦикла;
	
	Возврат ИсходнаяТаблица;
	
КонецФункции

// Функции разбора шаблонов кодов расценок.
Функция ВернутьСписокРасценок(ИсхСтр, АнализТире = ложь)
	СписокПервогоУровня = Новый СписокЗначений;
	ИсхСтрока = СокрЛП(ИсхСтр);
	ТекущийЭлемент = "";
	Для х1 = 1 По СтрДлина(ИсхСтрока) Цикл 

		ТекущийСимвол = Сред(ИсхСтрока, х1, 1);
		Если ТекущийСимвол = "(" Тогда
			НайденаЗакрывающаяСкобка = Ложь;
			Пока Не НайденаЗакрывающаяСкобка Цикл
				ТекущийСимволВнутриСкобок = Сред(ИсхСтрока, х1, 1);
				Если ТекущийСимволВнутриСкобок = ")" Тогда
					НайденаЗакрывающаяСкобка = Истина;
					ТекущийЭлемент = ТекущийЭлемент + ТекущийСимволВнутриСкобок;
					СписокПервогоУровня.Добавить(ТекущийЭлемент);
					ТекущийЭлемент = "";
				Иначе	
					ТекущийЭлемент = ТекущийЭлемент + ТекущийСимволВнутриСкобок;
				КонецЕсли;	
				х1 = х1 + 1;
			КонецЦикла;	
			Продолжить;
		Иначе
			Если ТекущийСимвол = "," Тогда
				СписокПервогоУровня.Добавить(ТекущийЭлемент);
				ТекущийЭлемент = "";
			Иначе
				ТекущийЭлемент = ТекущийЭлемент + ТекущийСимвол;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	// Преобразовываем в список деревьтев.
	Если Не Прав(ТекущийЭлемент,1)=")" И СтрДлина(ТекущийЭлемент) > 0 Тогда
		СписокПервогоУровня.Добавить(ТекущийЭлемент);
	КонецЕсли;
	СписокСтруктур = Новый СписокЗначений;
	Для каждого Эл Из СписокПервогоУровня Цикл
		СписокСтруктур.Добавить(ВернутьСтруктуру(Эл.Значение, АнализТире), Эл.Значение, );
	КонецЦикла;
	
	Возврат СписокСтруктур;
	
КонецФункции

// Функции разбора шаблонов кодов расценок.
Функция ВернутьСтруктуру(Стр, АнализТире)
	СтруктураЭлемента = Новый Структура;
	СтруктураЭлемента.Вставить("Интервал");
	СтруктураЭлемента.Вставить("Таблицы", Неопределено);
	ПозицияОткрывающейСкобки = Найти(Стр, "(");
	ПозицияЗакрывающейСкобки = Найти(Стр, ")");
	Если ПозицияОткрывающейСкобки > 0 И ПозицияЗакрывающейСкобки > 0 Тогда
		// Тильда только в скобках может быть значит.
		СтрокаНачалоИнтервала 		= Лев(Стр, ПозицияОткрывающейСкобки - 1);
		СтрокаОкончаниеИнтервала 	= Лев(Стр, ПозицияОткрывающейСкобки - 1);
		СтрокаВСкобках				= Сред(Стр,ПозицияОткрывающейСкобки + 1, СтрДлина(Стр) - ПозицияОткрывающейСкобки - 1);
		СтруктураЭлемента.Вставить("Интервал", Новый Структура("НачалоИнтервала, ОкончаниеИнтервала", ВернутьЧисло(СтрокаНачалоИнтервала), ВернутьЧисло(СтрокаОкончаниеИнтервала)));
		СтруктураЭлемента.Вставить("Таблицы", ВернутьСписокТаблиц(СтрокаВСкобках, АнализТире)); 
	Иначе
		// Тильда может быть, но не будет таблиц.
		ПозицияТильды = Найти(Стр, "~");
		Если АнализТире Тогда
			ПозицияТире = Найти(Стр, "-");
			ПозицияТильды = ?(ПозицияТире = 0, ПозицияТильды, Мин(ПозицияТире,ПозицияТильды));
		КонецЕсли;
		Если ПозицияТильды > 0  Тогда
			СтрокаНачалоИнтервала 		= Лев(Стр, ПозицияТильды - 1);
			СтрокаОкончаниеИнтервала 	= Прав(Стр, СтрДлина(Стр) - ПозицияТильды);
		Иначе
			СтрокаНачалоИнтервала 		= Стр;
			СтрокаОкончаниеИнтервала 	= Стр;
		КонецЕсли;
		СтруктураЭлемента.Вставить("Интервал", Новый Структура("НачалоИнтервала, ОкончаниеИнтервала", ВернутьЧисло(СтрокаНачалоИнтервала), ВернутьЧисло(СтрокаОкончаниеИнтервала)));
	КонецЕсли;	
	Возврат СтруктураЭлемента;
КонецФункции

// Функции разбора шаблонов кодов таблиц.
Функция ВернутьСписокТаблиц(Стр, АнализТире)
	// Список расценок, к которым должна быть применена поправка.
	СписокИнтервалов 	= Новый СписокЗначений;
	Список 				= Новый СписокЗначений;
	ТекИнтервал = "";
	Для Сч = 1 По СтрДлина(Стр) Цикл
		ТекСимвол = Сред(Стр,Сч,1);
		Если ТекСимвол = ","  Тогда
			СписокИнтервалов.Добавить(ТекИнтервал);
			ТекИнтервал = "";
		Иначе
			ТекИнтервал = ТекИнтервал + ТекСимвол;
		КонецЕсли;	
	КонецЦикла;
	Если  ТекИнтервал <> "" Тогда
		СписокИнтервалов.Добавить(ТекИнтервал); //zbikt
	КонецЕсли;
	Для каждого Эл Из СписокИнтервалов Цикл
		ПозицияТильды = Найти(Эл.Значение, "~");
		ПозицияТире = Найти(Эл.Значение, "-");
		ПозицияТильды = ?(ПозицияТильды = 0, ПозицияТире, ПозицияТильды);
		Если ПозицияТильды > 0 Тогда
			Список.Добавить(Новый Структура("НачалоИнтервала, ОкончаниеИнтервала", ВернутьЧисло(Лев(Эл.Значение, ПозицияТильды - 1)), ВернутьЧисло(Сред(Эл.Значение, ПозицияТильды + 1))));  //zbikt
		Иначе
			Список.Добавить(Новый Структура("НачалоИнтервала, ОкончаниеИнтервала", ВернутьЧисло(Эл.Значение), ВернутьЧисло(Эл.Значение)));
		КонецЕсли;	
	КонецЦикла;	
	Возврат Список;
КонецФункции	

// Функции преобразует строку в число.
Функция ВернутьЧисло(Стр)
	Если НЕ ЗначениеЗаполнено(Стр) Тогда
		Возврат 0;
	Иначе	
		Возврат Число(СтрЗаменить(Стр, "-", "."));
	КонецЕсли;	
КонецФункции	

// Функции добавляет нужные символы к ШИфру по шаблону.
Функция ВернутьНужныйШифр(Шифр)
	ЧислоВхожденийДефиса = СтрЧислоВхождений(Шифр,"-");
	Если ЧислоВхожденийДефиса > 2 Тогда               		
		Возврат Прав(Шифр,СтрДлина(Шифр) - Найти(Шифр,"-"));
	ИначеЕсли ЧислоВхожденийДефиса = 0 Тогда
		Возврат Шифр+"-000-00";
	ИначеЕсли ЧислоВхожденийДефиса = 1 Тогда
		Возврат Шифр+"-00";
	Иначе
		Возврат Шифр;
	КонецЕсли;	
КонецФункции	

// Входит ли шифр в список.
Функция Входит(Шифр, Список)
	НужныйШифр = ВернутьНужныйШифр(Шифр);
	ПопадалсяДефис = Ложь;
	ПозицияВторогоДефиса = 0;
	Для Сч = 1 По СтрДлина(НужныйШифр) Цикл
		ТекущийСимвол = Сред(НужныйШифр, Сч, 1);
		Если ТекущийСимвол = "-" Тогда
			Если НЕ ПопадалсяДефис Тогда 
				ПопадалсяДефис = Истина;
			ИначеЕсли ПопадалсяДефис Тогда
				ПозицияВторогоДефиса = Сч;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	СтрокаЧислоИнтервала = СтрЗаменить(Лев(НужныйШифр, ПозицияВторогоДефиса - 1),"-",".");
	ЧислоИнтервала  = Число(СтрокаЧислоИнтервала);
	Расценки = Прав(НужныйШифр,СтрДлина(НужныйШифр)-ПозицияВторогоДефиса);
	ЧислоТаблицы	= Число(Прав(НужныйШифр,СтрДлина(НужныйШифр)-ПозицияВторогоДефиса));
	// Сама проверка.
	Для Каждого СтруктураЭлемента Из Список Цикл
		Интервал 	= СтруктураЭлемента.Значение.Интервал;
		Таблицы 	= СтруктураЭлемента.Значение.Таблицы;
		Если Интервал.НачалоИнтервала = Интервал.ОкончаниеИнтервала Тогда
			ЧислоИнтервалаСравн = ЧислоИнтервала;
		Иначе
			ЧислоИнтервалаСравн = ЧислоИнтервала;
		КонецЕсли;
		Если ЧислоИнтервалаСравн >= Интервал.НачалоИнтервала И ЧислоИнтервалаСравн <= Интервал.ОкончаниеИнтервала Тогда
			Если Таблицы = Неопределено Тогда
				Возврат Истина;
			Иначе
				Для каждого СтруктураТаблицы Из Таблицы Цикл
					Если ЧислоТаблицы >= СтруктураТаблицы.Значение.НачалоИнтервала И ЧислоТаблицы <= СтруктураТаблицы.Значение.ОкончаниеИнтервала Тогда
						Возврат Истина;
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;	

		КонецЕсли;	
	КонецЦикла;	
	Возврат Ложь;
КонецФункции	

// Входит ли шифр в список КАЗНИИ.
Функция ВходитКАЗНИИ(Шифр, Список)
	Входит = Ложь;
	
	НужныйШифр = Число(Прав(Шифр,4));
	НачалоШифра = СтрЗаменить(Шифр,Прав(Шифр,4),"");
	
	МассивПоправок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Список, ")", Истина, Истина);
	
	Для Каждого Поправка Из МассивПоправок Цикл
		
		Если Входит Тогда
			Прервать;
		КонецЕсли;
		
		Скобка = СтрНайти(Поправка,"(");
		СтрокаПоправки = Сред(Поправка,Скобка+1);
		
		
		Начало = Лев(Поправка,Скобка-1);
		
		Если Не НачалоШифра = Начало Тогда
			Продолжить;
		КонецЕсли;
		
		
		МассивДиапазонов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаПоправки, ",", Истина, Истина);
		
		Для Каждого Диап Из МассивДиапазонов Цикл
			
			МассивЗначений = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Диап, "~", Истина, Истина);
			Если МассивЗначений.Количество() = 2 Тогда
				НижнееЗначение = Число(МассивЗначений[0]);
				ВерхнееЗначение = Число(МассивЗначений[1]);
				Если НужныйШифр>=НижнееЗначение И НужныйШифр<=ВерхнееЗначение Тогда
					Входит = Истина;
					Прервать;
				КонецЕсли;
			ИначеЕсли МассивЗначений.Количество() = 1 Тогда
				Если НужныйШифр=Число(МассивЗначений[0]) Тогда
					Входит = Истина;
					Прервать;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Входит;
	
КонецФункции	

// Поиск расценки по номеру.
Функция НайтиРасценку(НомерРасценки,Расценки)
	
	ВключитьПоправку = Ложь;
	Тильда = Найти(Расценки,"~");
	Зпт = Найти(Расценки,",");
	Если Зпт > 0 ИЛИ Тильда > 0 Тогда
		Если (Зпт > 0 И Зпт < Тильда) ИЛИ Тильда = 0 Тогда
			Если Число(Лев(Расценки,Зпт-1)) = НомерРасценки Тогда
				ВключитьПоправку = Истина;
			Иначе
				ВключитьПоправку = НайтиРасценку(НомерРасценки,Прав(Расценки,СтрДлина(Расценки)-Зпт));
			КонецЕсли;
		Иначе
			МинРасценка = Число(Лев(Расценки,Тильда-1));
			МаксРасценка = Прав(Расценки,СтрДлина(Расценки)-Тильда);
			МаксРасценка = Число(?(Зпт > 0, Лев(МаксРасценка,Найти(МаксРасценка,",")-1),МаксРасценка)); 
			Если НомерРасценки < МаксРасценка И НомерРасценки > МинРасценка Тогда
				ВключитьПоправку = Истина;
			Иначе
				ВключитьПоправку = НайтиРасценку(НомерРасценки,Прав(Расценки,СтрДлина(Расценки)-?(Зпт>0,Зпт,Тильда)));
			КонецЕсли;
				
		КонецЕсли;
	КонецЕсли;
	Возврат ВключитьПоправку;
	
КонецФункции

// Поиск таблицы по номеру.
Функция НайтиТаблицу(НомерТаблицы,Таблицы)
	ВключитьПоправку = Ложь;
	ЛСкоб = Найти(Таблицы,"(");
	ПСкоб = Найти(Таблицы,")");
	Тильда = Найти(Таблицы,"~");
	Если Тильда > 0 Тогда
		Если (Тильда < ЛСкоб И Тильда < ПСкоб) ИЛИ ПСкоб = 0 Тогда
			НачТабл = Прав(Лев(Таблицы,Тильда-1),6);
			КонТабл = Лев(Прав(Таблицы,СтрДлина(Таблицы)-Тильда),6);
			Если НачТабл < НомерТаблицы И НомерТаблицы < КонТабл Тогда
				ВключитьПоправку = Истина;
			Иначе 
				ВключитьПоправку = НайтиТаблицу(НомерТаблицы,Прав(Таблицы,СтрДлина(Таблицы)-Тильда-6));	
			КонецЕсли;
		Иначе
			ВключитьПоправку = НайтиТаблицу(НомерТаблицы,Прав(Таблицы,СтрДлина(Таблицы)-ПСкоб));	
		КонецЕсли;
	КонецЕсли;	
	Возврат ВключитьПоправку;
КонецФункции

// Добавляет лимзатраты из другого документа.
Процедура ДобавитьЛЗизДокумета(ТекОбъект, ТекДокумент)
	
	Для Каждого ТекСтрокаЛимитированныеЗатраты Из ТекДокумент.ЛимитированныеЗатраты Цикл
		Если Не ТекСтрокаЛимитированныеЗатраты.Расчет Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТекОбъект.ЛимитированныеЗатраты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрокаЛимитированныеЗатраты);
	КонецЦикла;
	
КонецПроцедуры

// Процедура получает цены ресурса.
Процедура ПолучитьЦены(РесурсВыб,ПозицияРесурса,СтруктураЦен,СтруктураДопПараметров) Экспорт
	ИДСметы = ПозицияРесурса.ИДСметы;
	СтруктураПараметровЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(ИДСметы);
	Район = СтруктураПараметровЛС.Район;
	АвтоЗагрузкаЦен = СтруктураПараметровЛС.АвтозагрузкаЦен;
	ДатаТекущихЦен = СтруктураПараметровЛС.ДатаТекущихЦен;
	РегиональнаяБаза = СтруктураПараметровЛС.РегионДляВыбораЦен;
	КодРегионаФайлаТекущихЦен = СтруктураПараметровЛС.КодРегионаФайлаТекущихЦен;
	ФайлТекущихЦен = СтруктураПараметровЛС.ФайлСборникаТекущихЦен;
	СтруктураДопПараметров.Вставить("Район",Район);
	СтруктураДопПараметров.Вставить("АвтоЗагрузкаЦен",АвтоЗагрузкаЦен);
	СтруктураДопПараметров.Вставить("ДатаТекущихЦен",ДатаТекущихЦен);
	СтруктураДопПараметров.Вставить("КодРегионаФайлаТекущихЦен",КодРегионаФайлаТекущихЦен);
	СтруктураДопПараметров.Вставить("ФайлТекущихЦен",ФайлТекущихЦен);
	ВыбиратьТекущиеЦены = Истина;
	Если ФайлТекущихЦен = ""  Тогда
		ВыбиратьТекущиеЦены = Ложь;
	КонецЕсли;
	ПолучитьЦеныНовогоРесурса(РесурсВыб,Район,РегиональнаяБаза,ДатаТекущихЦен,СтруктураЦен,ВыбиратьТекущиеЦены);
КонецПроцедуры

// Процедура получает цены ресурса из данных ВНБ.
Процедура ПолучитьЦеныВНБ(ДанныеЦен,ТекЦена,ТекЗарплМаш) Экспорт
	
	ТаблицаТЦ = СМ_СметаЗагрузкаВызовСервера.ЗагрузитьТекущиеЦеныВТаблицу(ДанныеЦен);
	Если ТаблицаТЦ.Количество()>0 Тогда
		ТекЦена = ТаблицаТЦ[0].ТекущаяЦена;
		ТекЗарплМаш = ТаблицаТЦ[0].ТекущаяЗарплатаМашинистов;
	КонецЕсли;
	
КонецПроцедуры

// Поиск в справочнике ресурсов.
//
Функция НайтиРесурсПоШифру(Шифр)
	Ресурс = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		               |	СправочникСмета.Ссылка КАК Ресурс
	    	           |ИЗ
	        	       |	Справочник.СМ_Ресурсы КАК СправочникСмета
	            	   |ГДЕ
		               |	СправочникСмета.Код = &Шифр";
	Запрос.УстановитьПараметр("Шифр",Шифр);
	РесурсыДанные = Запрос.Выполнить().Выбрать();
	Если РесурсыДанные.Следующий() Тогда
		Ресурс = РесурсыДанные.Ресурс;
	КонецЕсли; 
	Возврат Ресурс;
КонецФункции

// Процедура заполняет структуру данными для замены ресурса.
Процедура ЗаполнитьДанныеРесурса(Данные,Структура) Экспорт
	
	Если ТипЗнч(Данные) = Тип("СправочникСсылка.СМ_НормативныеСборники") Тогда
		СтрРесурс = Данные;
		Структура.Вставить("ШифрРасценки",СтрРесурс.КодНормативнойРасценки);
		Структура.Вставить("Наименование",СтрРесурс.КодНормативнойРасценки+" "+СтрРесурс.Наименование+" "+СтрРесурс.Измеритель);
		Структура.Вставить("Значение",СтрРесурс.КодНормативнойРасценки+" "+СтрРесурс.Наименование+" "+СтрРесурс.Измеритель);
		Структура.Вставить("Ресурс",СтрРесурс.Наименование);
		Структура.Вставить("ТекЦена",0);
		Структура.Вставить("ТекЗарплМаш",0);
		Структура.Вставить("Определитель",СтрРесурс.Определитель);
		Структура.Вставить("ЕдиницаИзмерения",СтрРесурс.ЕдиницаИзмерения);
		Структура.Вставить("Измеритель",СтрРесурс.Измеритель);
		Структура.Вставить("БазисЗарплМаш",0);
		Структура.Вставить("БазисЦена",0);
		
		СтрокиТЧ = СтрРесурс.ЦеныНормативныхСборников.НайтиСтроки(Новый Структура("Район", ?(ТипЗнч(Структура.ПозицияРесурса) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"),Структура.ПозицияРесурса.Район,Структура.ПозицияРесурса.ИДСметы.Район)));
		Если СтрокиТЧ.Количество() > 0 Тогда
			СтрокаНС = СтрокиТЧ[0];
			Структура.ТекЦена				= СтрокаНС.ПрямыеЗатраты;
			Структура.ТекЗарплМаш			= СтрокаНС.ВТомЧислеЗарплатаМашинистов;
		КонецЕсли;	
	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникСсылка.СМ_Ресурсы") Тогда
		Структура.Вставить("Наименование",Структура.Ресурс.Код+" "+Структура.Ресурс.Наименование+" "+Структура.Ресурс.ЕдиницаИзмерения);
		Структура.Вставить("ВидРесурса",Структура.Ресурс.ВидРесурса);
	Иначе
		ТаблицаРесурса = СМ_СметаЗагрузкаВызовСервера.ЗагрузитьТекущиеЦеныВТаблицу(Данные);
		Если ТаблицаРесурса.Количество()>0 Тогда
			СтрРесурс = ТаблицаРесурса[0];
			Ресурс = НайтиРесурсПоШифру(СтрРесурс.ШифрРасценки);
			ВидРесурса = ?(Ресурс = Неопределено,СМ_СметаЗагрузкаВызовСервера.ОпределитьВидРесурсаПоШифру(СтрРесурс.ШифрРасценки),Ресурс.ВидРесурса);
			Если Ресурс = Неопределено Тогда
				Структура.Вставить("ШифрРасценки",СтрРесурс.ШифрРасценки);
				Структура.Вставить("Наименование",СтрРесурс.ШифрРасценки+" "+СтрРесурс.Наименование+" "+СтрРесурс.Измеритель);
				Структура.Вставить("Значение",СтрРесурс.ШифрРасценки+" "+СтрРесурс.Наименование+" "+СтрРесурс.Измеритель);
				Структура.Вставить("Ресурс",СтрРесурс.Наименование);
				Структура.Вставить("ТекЦена",СтрРесурс.ТекущаяЦена);
				Структура.Вставить("ТекЗарплМаш",?(ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы,СтрРесурс.ТекущаяЗарплатаМашинистов,0));
				Структура.Вставить("НормаРасхода",СтрРесурс.ОбъемРабот);
				Структура.Вставить("Определитель",СтрРесурс.Определитель);
				Структура.Вставить("ЕдиницаИзмерения",СтрРесурс.ЕдиницаИзмерения);
				Структура.Вставить("Измеритель",СтрРесурс.Измеритель);
				Структура.Вставить("БазисЗарплМаш",0);
				Структура.Вставить("БазисЦена",0);
				Структура.Вставить("ВидРесурса",ВидРесурса);
			Иначе
				Структура.Вставить("Ресурс",Ресурс);
				Структура.Вставить("Наименование",СтрРесурс.ШифрРасценки+" "+Ресурс.Наименование+" "+СтрРесурс.Измеритель);
				Структура.Вставить("Значение",Ресурс);
				Структура.Вставить("ТекЦена",СтрРесурс.ТекущаяЦена);
				Структура.Вставить("ТекЗарплМаш",?(ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы,СтрРесурс.ТекущаяЗарплатаМашинистов,0));
				Структура.Вставить("НормаРасхода",СтрРесурс.ОбъемРабот);
				Структура.Вставить("ВидРесурса",ВидРесурса);
				// базисных цен
				СтруктураЦен = Новый Структура();
				СтруктураЦен.Вставить("БазиснаяЦена");
				СтруктураЦен.Вставить("БазиснаяЗарплатаМашинистов");
				СтруктураЦен.Вставить("ТекущаяЦена");
				СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов");
				СтруктураДопПараметров = Новый Структура();
				СтруктураДопПараметров.Вставить("Район");
				СтруктураДопПараметров.Вставить("ДатаТекущихЦен");
				СтруктураДопПараметров.Вставить("ФайлТекущихЦен");
				СтруктураДопПараметров.Вставить("АвтозагрузкаЦен");
				СтруктураДопПараметров.Вставить("КодРегионаФайлаТекущихЦен");
				ПолучитьЦены(Структура.Ресурс, Структура.ПозицияРесурса, СтруктураЦен,СтруктураДопПараметров);
				Структура.БазисЦена = СтруктураЦен.БазиснаяЦена;
				Структура.БазисЗарплМаш = ?(ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы,СтруктураЦен.БазиснаяЗарплатаМашинистов,0);
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Процедура обертка копирования локальной сметы через длительные операции
Процедура СкопироватьЛокальнуюСметуДлительнаяОперация(СтруктураПараметров, АдресХранилища) Экспорт
	
	СтараяСмета 			= СтруктураПараметров.СтараяСмета;
	Корректировка           = ?(СтруктураПараметров.Свойство("Корректировка"),СтруктураПараметров.Корректировка,Ложь);
	Транзакция              = ?(СтруктураПараметров.Свойство("Транзакция"),СтруктураПараметров.Транзакция,Ложь);
	НоваяСмета              = ?(СтруктураПараметров.Свойство("НоваяСмета"),СтруктураПараметров.НоваяСмета,Неопределено);
	ИДРодителя              = ?(СтруктураПараметров.Свойство("ИДРодителя"),СтруктураПараметров.ИДРодителя,Неопределено);
	ВАрхив                  = ?(СтруктураПараметров.Свойство("ВАрхив"),СтруктураПараметров.ВАрхив,Ложь);
	Перерасчет              = ?(СтруктураПараметров.Свойство("Перерасчет"),СтруктураПараметров.Перерасчет,Истина);
	СписокАктовДляПересчета = ?(СтруктураПараметров.Свойство("СписокАктовДляПересчета"),СтруктураПараметров.СписокАктовДляПересчета,Неопределено);
	 
	СкопироватьЛокальнуюСмету(СтараяСмета,Корректировка,Транзакция,НоваяСмета,ИДРодителя,ВАрхив,Перерасчет,СписокАктовДляПересчета);
	
КонецПроцедуры

// Процедура обертка копирования объектной сметы через длительные операции
Процедура СкопироватьОбъектнуюСметуДлительнаяОперация(СтруктураПараметров, АдресХранилища) Экспорт

	СтараяСмета 			= СтруктураПараметров.СтараяСмета;
