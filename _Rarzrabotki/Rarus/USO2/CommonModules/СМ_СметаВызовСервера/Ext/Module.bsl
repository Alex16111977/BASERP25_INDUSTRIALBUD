#Область СметнаяКомпонента

// Возвращает структуру параметров для заполнения свойств COM объекта для работы с Внешними нормативами.
//
// Возвращаемое значение:
// 		Структура - содержит поля:
//			* ДиректорияНорм		- Строка - Директория нормативной базы.
//			* ЗаписьВЖурнал			- Булево - Вести запись в журнал.
//			* ТипПодключения        - Число  - Вариант подключения к нормативной базе.
//			* ВариантУстановки      - Число  - Аналог ТипПодключения.
//			* Сертификаты           - Строка - Строка сертификатов.
//			* ДиректорияТехЧастей   - Строка - Каталог с файлами техчастей.
//
Функция ПараметрыСвойствСметнойКомпоненты() Экспорт
	
	Параметры = Новый Структура();
	
	Параметры.Вставить("ДиректорияНорм", ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"НастройкиПользователяСмета",
		"СметнаяПодсистема_ДиректорияНорм",
		""));
	Параметры.Вставить("ЗаписьВЖурнал", ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"НастройкиПользователяСмета",
		"СметнаяПодсистема_ЗаписьВЖурнал",
		Ложь));
	Параметры.Вставить("ТипПодключения", ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"НастройкиПользователяСмета",
		"СметнаяПодсистема_ВариантУстановки",
		0));
	Параметры.Вставить("ВариантУстановки", Параметры.ТипПодключения);
	Параметры.Вставить("Сертификаты", ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"НастройкиПользователяСмета",
		"СметнаяПодсистема_Сертификаты",
		""));
	Параметры.Вставить("ДиректорияТехЧастей", ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"НастройкиПользователяСмета",
		"СметнаяПодсистема_ДиректорияТехЧастей",
		""));
		
	Возврат Параметры;
	
КонецФункции

// Возвращает имеются ли права на обновление НСИ по сметной информации.
//
// Возвращаемое значение:
//     Булево - если Истина значит есть права на обновление, иначе нет прав.
//
Функция ПраваНаОбновление() Экспорт

	Возврат Пользователи.РолиДоступны("СМ_РедактированиеНСИ, СМ_АдминистраторСмета");	
	
