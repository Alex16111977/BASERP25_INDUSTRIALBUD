#Область НастройкиПользователя

// Возвращает список настроек пользователя.
//
// Возвращаемое значение:
//     СписокНастроек - Структура - содержит имена настроек и значения по умолчанию.
//
Функция ПолучитьСписокНастроек() Экспорт
	
	НастройкиКонтроляЛимитов = СМ_КонтрольЛимитовСервер.ПараметрыКонтроляЛимитов();
	
	Список = Новый СписокЗначений;
	Массив = Новый Массив;
	Массив.Добавить(Тип("ПланОбменаСсылка.СМ_ОбменСметаМобильное"));
	ОписаниеТиповС 		= Новый ОписаниеТипов(Массив);
	Список.ТипЗначения 	= ОписаниеТиповС;
	СписокНастроек		= Новый Структура();
		
	//  ******************* Сметные документы **************
	
	СписокНастроек.Вставить("КонтролироватьОстатокПоАкту",
		Новый Структура("ПолеФормы, ЗначениеПоУмолчанию", "СМ_КонтролироватьОстатокПоАкту", НастройкиКонтроляЛимитов.КонтролироватьОстатокПоАкту));
	
	СписокНастроек.Вставить("ЗапретитьПроведениеАктаПревышениеЛимитаСметы",
		Новый Структура("ПолеФормы, ЗначениеПоУмолчанию", "СМ_ЗапретитьПроведениеАктаПревышениеЛимитаСметы", НастройкиКонтроляЛимитов.ЗапретитьПроведениеАктаПревышениеЛимитаСметы));
	
	СписокНастроек.Вставить("ПоказыватьВсегоНачало",
		Новый Структура("ПолеФормы, ЗначениеПоУмолчанию", "СМ_ПоказыватьВсегоНачало", Ложь));

	СписокНастроек.Вставить("НеПоказыватьНеучтенные",
		Новый Структура("ПолеФормы, ЗначениеПоУмолчанию", "СМ_НеПоказыватьНеучтенные", Ложь));
	
	СписокНастроек.Вставить("ВставлятьНеучтенныеАвтоматически",
		Новый Структура("ПолеФормы, ЗначениеПоУмолчанию", "СМ_ВставлятьНеучтенныеАвтоматически", Ложь));
	
	СписокНастроек.Вставить("ИтогСметыДляДерева",
		Новый Структура("ПолеФормы, ЗначениеПоУмолчанию", "СМ_ИтогСметыДляДерева", ПредопределенноеЗначение("Справочник.СМ_ИтогиПоГлавам.ПустаяСсылка")));

	СписокНастроек.Вставить("ОсновнойРегион",
