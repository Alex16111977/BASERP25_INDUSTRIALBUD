		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументОбъект.СМ_РазделЛокальнойСметы") Тогда
		Возврат ПолучитьСсылкуНаДокумент(ДокументСсылка.ИдСметы);
	Иначе
		СсылкаНаДокумент = ПолучитьСсылкуНаДокумент(ДокументСсылка);
