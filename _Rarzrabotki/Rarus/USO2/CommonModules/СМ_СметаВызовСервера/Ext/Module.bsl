// Получает массив всех позиций сметы ИЛИ акта.
//
// Параметры:
//     ИдСметы	- ДокументСсылка.СМ_ЛокальнаяСмета		- ссылка на текущую смету, если задана выбираются позиции сметы.
//     ИдАкта 	- ДокументСсылка.СМ_АктВыполненныхРабот	- если задано, то выбираются позиции акта.
//                                                        Если не задано, то выбираются позиции сметы.
//
// Возвращаемое значение:
//     МассивПозиций - Массив - содержит позиции.
//
Функция ПолучитьМассивВсехПозиций(ИдСметы = Неопределено, ИдАкта = Неопределено) Экспорт
	
	Если (ИдСметы = Неопределено)И(ИдАкта = Неопределено) Тогда
		Возврат Новый Массив();
	КонецЕсли;
	
	Если ИдАкта <> Неопределено Тогда
		Возврат ИдАкта.Позиции.ВыгрузитьКолонку("Позиция");	
	Иначе
		Табл = ПолучитьТаблицуПодчиненных(ИдСметы, Ложь, Истина, Истина, Истина);
		Возврат Табл.ВыгрузитьКолонку("Ид");
	КонецЕсли;	
	
