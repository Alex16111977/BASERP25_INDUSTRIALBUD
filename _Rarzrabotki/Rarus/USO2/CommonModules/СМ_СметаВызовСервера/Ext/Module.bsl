// Получить реквизит дублирует функционал модуля ОбщегоНазначения, но можно вызывать с клиента.
//
// Параметры:
//     Элемент 		- Объект - объект информационной базы.
//     ИмяРеквизита - Строка - содержит имя реквизита.
//
// Возвращаемое значение:
//     Произвольный - значение реквизита.
//
Функция ПолучитьЗначениеРеквизита(Элемент, ИмяРеквизита) Экспорт
	
	Возврат Элемент[ИмяРеквизита];
	
КонецФункции

// Возвращает ссылку на элемент справочника.
//
// Параметры:
//     ИмяСправочника 	- Строка	- наименование справочника как оно есть в конфигурации.
//     Код 				- Строка	- код для поиска элемента.
//     Поиск 			- Булево	- флаг для определения, нужно искать элемент ИЛИ создать новый.
//     ДанныеЗаполнения - Произвольный	- данные для заполнения элемента в виде структуры.
//
// Возвращаемое значение:
//     СправочникСсылка 	- ссылка на созданный элемент справочника.
//
Функция СоздатьНайтиЭлементСправочника(ИмяСправочника, Код = "", Поиск = Ложь, ДанныеЗаполнения = Неопределено) Экспорт
	
	Элемент = Неопределено;
	
	Если Поиск Тогда
		Элемент = Справочники[ИмяСправочника].НайтиПоКоду(Код);
	КонецЕсли;
	
	Если Элемент = Справочники[ИмяСправочника].ПустаяСсылка() ИЛИ Элемент = Неопределено Тогда
		Элемент = Справочники[ИмяСправочника].СоздатьЭлемент();
	КонецЕсли;
	
	Если НЕ Элемент.Ссылка.Пустая() Тогда
		Элемент = Элемент.ПолучитьОбъект();
	КонецЕсли;
	
	Если ДанныеЗаполнения <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Элемент,ДанныеЗаполнения);		
		Элемент.Записать();
	КонецЕсли;
	
	Возврат Элемент.Ссылка;
	
КонецФункции

// Производит замену родителя у объекта (позиции, раздела).
//
// Параметры:
//     НовыйРодитель - ДокументСсылка - на новый документ-родитель.
//     Ссылка 		 - ДокументСсылка - ссылка ИЛИ объект, роитель которого меняется.
//
// Возвращаемое значение:
//     Неопределено - видимо функция используется как процедура.
//
Функция ЗаменитьРодителя(НовыйРодитель, Ссылка) Экспорт
	
	Если найти(НРег(ТипЗнч(Ссылка)),"объект") <> 0 Тогда
		Объект = Ссылка;
	Иначе	
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	// Тут могут передаваться не только позиции.
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.СМ_ПозицияЛокальнойСметы") Тогда
		ПозицияПривязана = ЗначениеЗаполнено(Объект.ИдПозицииВладельца);
	Иначе
		ПозицияПривязана = ЛОЖЬ;
	КонецЕсли;
	
	ИмяОбъектаМетаданных = Неопределено;
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.СМ_ПозицияЛокальнойСметы") Тогда
		Объект.КорректируетПозицию = Документы.СМ_ПозицияЛокальнойСметы.ПустаяСсылка();
		ИмяОбъектаМетаданных = "СМ_ПозицияЛокальнойСметы";
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.СМ_РазделЛокальнойСметы") Тогда
		Объект.КорректируетРаздел = Документы.СМ_РазделЛокальнойСметы.ПустаяСсылка();
		ИмяОбъектаМетаданных = "СМ_РазделЛокальнойСметы";
	КонецЕсли;
	ЗаполнитьДанныеДокументаВСтруктуреСмет(Объект, НовыйРодитель,ПозицияПривязана);
	Объект.ПорНомер = 0;
	// Объект.Записать(РежимЗаписиДокумента.Запись);
	УстановитьНомерДокумента(Объект, 0, 0, 0, ,ИмяОбъектаМетаданных);
			
КонецФункции

// Производит утановку значения реквизита у объекта (документа позиции ИЛИ раздела).
//
// Параметры:
//     Ссылка 		- ДокументСсылка	- Ссылка на новый документ.
//     Имя 			- Строка			- Строка с именем реквизита.
//     Значение 	- Произвольный		- Устанавливаемое значение.
//     Перерасчет 	- Булево			- Пересчитать докмент после замены реквизита ИЛИ нет.
//
Процедура УстановитьРеквизитДокумента(Ссылка, Имя, Значение, Перерасчет = Ложь) Экспорт
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		Возврат;
	КонецЕсли;
	
	Объект = Ссылка.ПолучитьОбъект();
	Объект[Имя] = Значение;
	Если Перерасчет Тогда
		Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(Объект);	
		ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда	
			Документы.СМ_РазделЛокальнойСметы.Перерасчет(Объект);	
		КонецЕсли;		
	КонецЕсли;
	
	Объект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

// Возвращает предстваление итога по Идентификатору.
//
// Параметры:
//     НаимСправ 	- Строка - содержит наименование справочника (как оно задано в метаданных).
//     ТекИтог 		- Строка - идентификатор итога.
//
// Возвращаемое значение:
//     НаименованиеИтога - Строка - представление итога (наименование лимзатраты ИЛИ итога).
//
Функция ПолучитьНаименованиеПоИдентификатору(НаимСправ,ТекИтог) Экспорт
	
	 НаименованиеИтога = "";
	 Если НаимСправ = "СМ_ИтогиПоГлавам" Тогда 
		 НаименованиеИтога = Справочники.СМ_ИтогиПоГлавам.НайтиПоРеквизиту("Идентификатор",ТекИтог).Наименование;
	 ИначеЕсли НаимСправ = "СМ_ЛимитированныеЗатраты" Тогда 
		 НаименованиеИтога = Справочники.СМ_ЛимитированныеЗатраты.НайтиПоРеквизиту("Идентификатор",ТекИтог).Наименование;
	 КонецЕсли;
		
	 Возврат (НаименованиеИтога);
	
КонецФункции

// Возвращает структуру показателей.
//
// Параметры:
//     ШифрПозиции - Строка - содержит шифр.
//
// Возвращаемое значение:
//     Структура - содержит поля с показателями ШифрПозиции, ТНС, РегиональнаяБаза.
//
Функция ПолучитьШифр(ШифрПозиции) Экспорт
	ПрефиксыПрограммы = ПолучитьПрефиксы();
	Структура = Новый Структура("ШифрПозиции,ТНС,РегиональнаяБаза");
	Если ПрефиксыПрограммы.Количество()>0 Тогда
		НужнаяСтрока = Неопределено;
		Для Каждого Преф Из ПрефиксыПрограммы Цикл
			ПозицияПрефикса = Найти(Врег(ШифрПозиции),Врег(Преф.Префикс));
			Если ПозицияПрефикса>0 Тогда
				НужнаяСтрока = Преф;
				Прервать
			КонецЕсли;
		КонецЦикла;
		Если НЕ НужнаяСтрока = Неопределено Тогда
			Структура.ШифрПозиции = Сред(ШифрПозиции,СтрДлина(НужнаяСтрока.Префикс)+1);
			Структура.ТНС = ?(ЗначениеЗаполнено(НужнаяСтрока.ТНС),СМ_СметаЗагрузкаВызовСервера.ОпределитьКодТипаСборника(НужнаяСтрока.ТНС),""); 
			Структура.РегиональнаяБаза = ?(ЗначениеЗаполнено(НужнаяСтрока.РегиональнаяБаза),СокрЛП(НужнаяСтрока.РегиональнаяБаза.Код),""); 
		КонецЕсли;
	КонецЕсли;
	Возврат Структура;
КонецФункции

// Возвращает префиксы расценок.
//
// Параметры:
//
// Возвращаемое значение:
//     Таблица с префиксами.
//
Функция ПолучитьПрефиксы()
    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СМ_ПрефиксыРасценок.ТипНормативногоСборника КАК ТНС,
	               |	СМ_ПрефиксыРасценок.РегиональнаяБаза,
	               |	СМ_ПрефиксыРасценок.Наименование КАК Префикс
	               |ИЗ
	               |	Справочник.СМ_ПрефиксыРасценок КАК СМ_ПрефиксыРасценок";
    ПрефиксыПрограммы = Запрос.Выполнить().Выгрузить();
	ПрефиксыПрограммы.Колонки.Добавить("ДлинаСтроки");
	Для Каждого стр Из ПрефиксыПрограммы Цикл
		стр.ДлинаСтроки = СтрДлина(стр.Префикс);
	КонецЦикла;
	ПрефиксыПрограммы.Сортировать("ДлинаСтроки Убыв");
	Возврат ПрефиксыПрограммы;
КонецФункции	

// Возвращает список баз.
//
// Возвращаемое значение:
//     СписокБаз - СписокЗначений - содержит коды СНБ.
//
Функция ПолучитьВсеБазы() Экспорт
	СписокБаз = Новый СписокЗначений;
    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СМ_СметноНормативныеБазы.Код
	               |ИЗ
	               |	Справочник.СМ_СметноНормативныеБазы КАК СМ_СметноНормативныеБазы";
    Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокБаз.Добавить(СокрЛП(Выборка.Код));
	КонецЦикла;
	Возврат СписокБаз;
КонецФункции

// Возвращает единицу измерения.
//
// Параметры:
//     ЕдиницаИзмеренияСтрока - Строка - наименование единицы измерения.
//
// Возвращаемое значение:
//     ЕдиницаИзмерения - СправочникСсылка.СМ_ЕдиницыИзмеренияСмета - ссылка на единицу измерения.
//
Функция НайтиЕдиницуИзмеренияПоСтроке(ЕдиницаИзмеренияСтрока) Экспорт
	
	Если Не ЗначениеЗаполнено(ЕдиницаИзмеренияСтрока) Тогда
		Возврат Справочники.СМ_ЕдиницыИзмеренияСмета.ПустаяСсылка();
	КонецЕсли;
	
	ЕдиницаИзмерения 	= Справочники.СМ_ЕдиницыИзмеренияСмета.ПустаяСсылка();
	ОбрЕдИзм 			= СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ЕдиницаИзмеренияСтрока, " ", Истина, Истина);
	
	// Попытка заполнить единицу
	ном = (ОбрЕдИзм.Количество()-2);
	Пока ном > 0 И (Не ЗначениеЗаполнено(ЕдиницаИзмерения)) Цикл
		ПоискЕдИзм = "";
		Для номП = 0 По ном Цикл
			ПоискЕдИзм = ПоискЕдИзм + " " + ОбрЕдИзм[номП];
		КонецЦикла;
		ЕдиницаИзмерения = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоНаименованию(СокрЛП(ПоискЕдИзм), Истина);
		ном = ном - 1;
	КонецЦикла;
	
	Попытка
		Если Не ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
			ЧислоСимволов = СтрДлина(ОбрЕдИзм[0]);
			Слова = "";
			Числа = "";
			Для сч=1 По ЧислоСимволов Цикл
				Символ = Сред(ОбрЕдИзм[0],сч,1);
				Если Найти("-.+",Символ)>0 Тогда
					Слова = Сред(ОбрЕдИзм[0],сч);
					Прервать;
				Иначе
					Попытка
						ЧислоЕд = Число(Символ);
						Числа = Строка(Числа)+?(ЧислоЕд=0,"0",Формат(ЧислоЕд,"ЧГ=0"));
					Исключение
						Слова = Сред(ОбрЕдИзм[0],сч);
						Прервать;
					КонецПопытки;
				КонецЕсли;
			КонецЦикла; 
			
			НаимЕд = ?(Числа = "1","",Числа+" ")+НРег(Слова);
			НаимЕд = СокрЛП(НаимЕд);
			Если ОбрЕдИзм.Количество()>1 Тогда
				ном = (ОбрЕдИзм.Количество()-1);
				Для номП = 1 По ном Цикл
					НаимЕд = НаимЕд + " " + НРег(ОбрЕдИзм[номП]);
				КонецЦикла;
			КонецЕсли;
			НаимЕд = СокрЛП(НаимЕд);
			ЕдиницаИзмерения = ПоискЕдиницыИзмерения(НаимЕд);
			
			Если Не ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
				МассивСлов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаимЕд, " ", Истина, Истина);
				сч = МассивСлов.Количество()-1;
				Пока сч>0 И Не ЗначениеЗаполнено(ЕдиницаИзмерения) Цикл
					НаимЕд = ОтброситьПоследнееСлово(МассивСлов,сч);
					Если НаимЕд = Неопределено Тогда
						Прервать;
					КонецЕсли;
					ЕдиницаИзмерения = ПоискЕдиницыИзмерения(НаимЕд);
					сч = сч-1;
				КонецЦикла;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
				ИскомыйСимвол = Найти(ЕдиницаИзмеренияСтрока,":");
				Если ИскомыйСимвол>0 Тогда
					СтрокаЕдиницаИзмерения = СокрЛП(Сред(ЕдиницаИзмеренияСтрока,ИскомыйСимвол+1));
					ЕдиницаИзмерения = НайтиЕдиницуИзмеренияПоСтроке(СтрокаЕдиницаИзмерения);
				КонецЕсли;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ЕдиницаИзмерения) и СтрДлина(ЕдиницаИзмеренияСтрока)>2 Тогда
				Если Найти(ЕдиницаИзмеренияСтрока,".")=СтрДлина(ЕдиницаИзмеренияСтрока) Тогда
					СтрокаЕдиницаИзмерения = СокрЛП(Сред(ЕдиницаИзмеренияСтрока,1,СтрДлина(ЕдиницаИзмеренияСтрока)-1));
					ЕдиницаИзмерения = ПоискЕдиницыИзмерения(СтрокаЕдиницаИзмерения);
				КонецЕсли;
			КонецЕсли;

		КонецЕсли;
	Исключение
		Событие = НСтр("ru = 'Исключение обработки единиц'");
		СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
	КонецПопытки;
	
	Возврат ЕдиницаИзмерения;
	
КонецФункции

// Возвращает единицу измерения по сметному коду.
//
// Параметры:
//     ЕдиницаИзмеренияКод - Строка, Число - сметный код единицы измерения.
//
// Возвращаемое значение:
//     ЕдиницаИзмерения - СправочникСсылка.СМ_ЕдиницыИзмеренияСмета - ссылка на единицу измерения.
//
Функция НайтиЕдиницуИзмеренияПоСметномуКоду(ЕдиницаИзмеренияКод) Экспорт
	
	Если Не ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
		Возврат Справочники.СМ_ЕдиницыИзмеренияСмета.ПустаяСсылка();
	КонецЕсли;
	
	ЕдиницаИзмерения = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоРеквизиту("СметныйКод", Число(ЕдиницаИзмеренияКод));
	
	Возврат ЕдиницаИзмерения;
	
КонецФункции

// Возвращает наименование без последнего слова.
//
// Параметры:
//     МассивСлов - массив со словами строки.
//     НомерСлова - номер отбрасываемого слова с конца.
// Возвращаемое значение:
//     строка.
//
Функция ОтброситьПоследнееСлово(МассивСлов,НомерСлова) 
	Наименование = "";
	сч = 0;
	Пока сч<НомерСлова Цикл
		Наименование = Наименование+" "+МассивСлов[сч];
		сч = сч+1;
	КонецЦикла;
	ЭтоЧисло = Ложь;
	Попытка 
		НаименованиеЧислом = Число(Наименование);
		ЭтоЧисло = Истина;
	Исключение
		ЭтоЧисло = Ложь;
	КонецПопытки;
	Возврат ?(ЭтоЧисло,Неопределено,СокрЛП(Наименование));
КонецФункции

// Возвращает единицу измерения.
//
// Параметры:
//     НаименованиеЕдиницы - строка с наименованием единицы.
// Возвращаемое значение:
//     ЕдиницаИзмерения.
//
Функция ПоискЕдиницыИзмерения(НаименованиеЕдиницы) 
	
	ЕдиницаИзмерения = Справочники.СМ_ЕдиницыИзмеренияСмета.ПустаяСсылка();
	ЕдиницаИзмерения = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоНаименованию(НаименованиеЕдиницы, Истина);
	Если Не ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	СМ_ЕдиницыИзмеренияСмета.Ссылка
		|ИЗ
		|	Справочник.СМ_ЕдиницыИзмеренияСмета КАК СМ_ЕдиницыИзмеренияСмета
		|ГДЕ
		|	СМ_ЕдиницыИзмеренияСмета.Наименование = &Наименование";
		Запрос.УстановитьПараметр("Наименование",НаименованиеЕдиницы);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЕдиницаИзмерения = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	// Поиск единицы измерения по альтернативному названию в РС
	Если Не ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
		ЕдиницаИзмерения = ПоискЕдиницыИзмеренияПоАльтернативномуНазванию(НаименованиеЕдиницы);
	КонецЕсли;	
	
	Возврат ЕдиницаИзмерения;
	
КонецФункции

// Возвращает список всех типов сборников.
//
// Возвращаемое значение:
//     СписокСборников - СписокЗначений - содержит ссылки на типы нормативных сборников.
//
Функция ПолучитьВсеСборники() Экспорт
	СписокСборников = Новый СписокЗначений;
    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СМ_ТипыНормативныхСборников.Ссылка
	               |ИЗ
	               |	Перечисление.СМ_ТипыНормативныхСборников КАК СМ_ТипыНормативныхСборников";
    Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТипСборника = СМ_СметаЗагрузкаВызовСервера.ОпределитьКодТипаСборника(Выборка.Ссылка);
		Если ТипСборника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СписокСборников.Добавить(ТипСборника);
	КонецЦикла;
	Возврат СписокСборников;
КонецФункции

// Возвращает вариант пересчета ЭММ по умолчанию.
//
// Возвращаемое значение:
//     ВариантПересчетаЭММ - ПеречислениеСсылка.ВариантПересчетаЭММ - вариант пересчета ЭММ. 
//
Функция ПолучитьВариантПересчетаЭММПоУмолчанию() Экспорт
	Возврат ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ВариантПересчетаЭММ");	
КонецФункции

// Возвращает единицу измерения.
//
// Параметры:
//     НаименованиеЕдиницы - строка с наименованием единицы.
// Возвращаемое значение:
//     ЕдиницаИзмерения.
//
Функция ПоискЕдиницыИзмеренияПоАльтернативномуНазванию(НаименованиеЕдиницы)
	
	ЕдиницаИзмерения = Справочники.СМ_ЕдиницыИзмеренияСмета.ПустаяСсылка();
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	АльтернативныеЕдиницыИзмерения.ЕдиницаИзмерения КАК Ссылка
	|ИЗ
	|	РегистрСведений.СМ_АльтернативныеНазванияЕдиницИзмеренияСмета КАК АльтернативныеЕдиницыИзмерения
	|ГДЕ
	|	АльтернативныеЕдиницыИзмерения.Название = &Наименование";
	Запрос.УстановитьПараметр("Наименование",НаименованиеЕдиницы);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЕдиницаИзмерения = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат ЕдиницаИзмерения;
	
КонецФункции	

// Создает / перезаполняет найденную единицу измерения
//
// Параметры:
//     ТекСтрока 				- Строка - строка с параметрами едницы измерения.
//	   БазоваяЕдиницаИзмерения 	- СправочникСсылка.СМ_ЕдиницыИзмеренияСмета - ссылка на базовую единицу измерения.
//     ПоследнийКод				- Строка - содерджит код последнего элемента справочника.
//
// Возвращаемое значение:
//     СправочникСсылка.СМ_ЕдиницыИзмеренияСмета - ссылка на единицу измерения.
//
Функция СоздатьИзменитьЕдиницуИзмерения(ТекСтрока, БазоваяЕдиницаИзмерения, ПоследнийКод) Экспорт
	
	НайденнаяСсылка = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСметномуКоду(ТекСтрока.СметныйКод);
	Если НайденнаяСсылка = Справочники.СМ_ЕдиницыИзмеренияСмета.ПустаяСсылка() Тогда
		НайденнаяСсылкаПоНаменованию = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСтроке(ТекСтрока.Наименование);
		Если НайденнаяСсылкаПоНаменованию = Справочники.СМ_ЕдиницыИзмеренияСмета.ПустаяСсылка() Тогда
			НовыйКод 		= Строка(ПоследнийКод + 1);
			ПоследнийКод 	= ПоследнийКод + 1;
			ТекОбъект 		= Справочники.СМ_ЕдиницыИзмеренияСмета.СоздатьЭлемент();
			ТекОбъект.Код	= НовыйКод;
		Иначе
			ТекОбъект = НайденнаяСсылкаПоНаменованию.ПолучитьОбъект();	
		КонецЕсли;
	Иначе
		ТекОбъект = НайденнаяСсылка.ПолучитьОбъект();		
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекСтрока.Коэффициент) Тогда
		Попытка 
			КоэффициентПеревода = Число(ТекСтрока.Коэффициент);
		Исключение
			КоэффициентПеревода = 1;	
		КонецПопытки;
	Иначе
		КоэффициентПеревода = 0;	
	КонецЕсли;
	
	ТекОбъект.Наименование			= ТекСтрока.Наименование;
	ТекОбъект.КодОКЕИ               = ТекСтрока.КодОКЕИ;
	ТекОбъект.СметныйКод			= ТекСтрока.СметныйКод;
	ТекОбъект.КоэффициентПеревода   = КоэффициентПеревода;
	ТекОбъект.БазоваяЕдиница 		= БазоваяЕдиницаИзмерения;
	
	Попытка 
		ТекОбъект.Записать();
	Исключение
		Событие = НСтр("ru = 'Ошибка записи единицы измерения'");
		СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие,Истина,ОписаниеОшибки());
	КонецПопытки;

	Возврат ТекОбъект.Ссылка;
	
КонецФункции

// Возвращает содержание справочника "Единицы измерения смета".
// В результирующую таблицу добавлена колонка с числовым кодом, для определения последнего кода справочника.
//
// Возвращаемое значение:
//     ТаблицаЗначений - таблица содержащая единицы измерения.
//
Функция ПолучитьЕдиницыИзмерения() Экспорт
	
	// Определяем количество элементов в справочнике "Единицы измерения" 
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СМ_ЕдиницыИзмеренияСмета.Ссылка КАК Ссылка,
	|	СМ_ЕдиницыИзмеренияСмета.Код КАК Код,
	|	СМ_ЕдиницыИзмеренияСмета.Наименование КАК Наименование,
	|	СМ_ЕдиницыИзмеренияСмета.БазоваяЕдиница КАК БазоваяЕдиница,
	|	СМ_ЕдиницыИзмеренияСмета.КодОКЕИ КАК КодОКЕИ,
	|	СМ_ЕдиницыИзмеренияСмета.КоэффициентПеревода КАК КоэффициентПеревода,
	|	СМ_ЕдиницыИзмеренияСмета.СметныйКод КАК СметныйКод
	|ИЗ
	|	Справочник.СМ_ЕдиницыИзмеренияСмета КАК СМ_ЕдиницыИзмеренияСмета
	|ГДЕ 
	|	СМ_ЕдиницыИзмеренияСмета.ПометкаУдаления = ЛОЖЬ";
	ТабЕдиницы = Запрос.Выполнить().Выгрузить();
	
	// Заполняем колону числым кодом в виде числа
	КЧ		= Новый КвалификаторыЧисла(5,0);
	Массив 	= Новый Массив;
	Массив.Добавить(Тип("Число"));
	ОписаниеТиповЧ = Новый ОписаниеТипов(Массив,,,КЧ);
	ТабЕдиницы.Колонки.Добавить("КодЧислом",ОписаниеТиповЧ);
	Для Каждого ТекСтрока Из ТабЕдиницы Цикл
		Попытка
			ТекСтрока.КодЧислом = Число(СокрЛП(ТекСтрока.Код));
		Исключение
			ТекСтрока.КодЧислом = 0;	
		КонецПопытки
	КонецЦикла;

	Возврат ТабЕдиницы;
	
КонецФункции

#КонецОбласти

#Область ФункцииРаботыСОбъемами

// Производит пересчет значение объема из базовой единицы измерения в текущую.
//
// Параметры:
//     ТекДокумент 	- ДокументСсылка.СМ_ПозицияЛокальнойСметы - текущий документ позиции.
//     ТекОбъем 	- Число	- пересчитываемый объем.
//
// Возвращаемое значение:
//     НовыйОбъем - Число - содержит пересчитанный объем. 
//
Функция ПересчитатьВбазовыхЕдиницахИзмерения(ТекДокумент,ТекОбъем) Экспорт
	
	КоэффициентПеревода = ТекДокумент.ЕдиницаИзмерения.КоэффициентПеревода;
	НовыйОбъем = ТекОбъем / ?(КоэффициентПеревода = 0, 1, КоэффициентПеревода);
	
	Возврат НовыйОбъем;
	
КонецФункции

// Производит изменение формулы расчета объема исходя из коэффициентов пересчета из базовых единиц в текущую.
//
// Параметры:
//     ТекДокумент 		- ДокументСсылка.СМ_ПозицияЛокальнойСметы - документ позиции.
//     ФормулаОбъема 	- Строка - Формула расчета объема.
//
// Возвращаемое значение:
//     ФормулаОбъемаНовая - Строка - содержит новую формулу.
//
Функция ПересчитатьФормулаВбазовыхЕдиницахИзмерения(ТекДокумент, ФормулаОбъема) Экспорт
	
	КоэффициентПеревода = ТекДокумент.ЕдиницаИзмерения.КоэффициентПеревода;
	Если (КоэффициентПеревода > 0)И(КоэффициентПеревода<>1) Тогда
		Префикс = "(";
		Постфикс = ")/"+Формат(КоэффициентПеревода,"ЧГ=0");
		Если (Найти(ФормулаОбъема, Префикс) = 1) И (Найти(ФормулаОбъема, Постфикс) = СтрДлина(ФормулаОбъема) - СтрДлина(Постфикс) + 1) Тогда
			// Менять нечего.
			ФормулаОбъемаНовая = ФормулаОбъема;
		Иначе
			ФормулаОбъемаНовая = Префикс + ФормулаОбъема + Постфикс;
		КонецЕсли;		
	Иначе
		ФормулаОбъемаНовая = ФормулаОбъема;
	КонецЕсли;
		
	Возврат ФормулаОбъемаНовая;
	
КонецФункции

// Производит изменение формулы расчета объема исходя из того, что коэффициент пересчета удаляется.
//
// Параметры:
//     ЕдиницаИзмерения - СправочникСсылка.СМ_ЕдиницыИзмерения - текущая Единица измерения.
//     ФормулаОбъема 	- Строка - формула расчета объема.
//
// Возвращаемое значение:
//     ФормулаОбъемаНовая - Строка - содержит новую формулу.
//
Функция УдалитьФормулуБазовыхЕслиЕсть(ЕдиницаИзмерения, ФормулаОбъема) Экспорт
	
	КоэффициентПеревода = ЕдиницаИзмерения.КоэффициентПеревода;
	Если (КоэффициентПеревода > 0)И(КоэффициентПеревода<>1) Тогда
		Префикс = "(";
		Постфикс = ")/"+Формат(КоэффициентПеревода,"ЧГ=0");
		Если (Найти(ФормулаОбъема, Префикс) = 1) И (Найти(ФормулаОбъема, Постфикс) = СтрДлина(ФормулаОбъема) - СтрДлина(Постфикс) + 1) Тогда
			// Менять нечего.
			Если СтрДлина(ФормулаОбъема) - СтрДлина(Постфикс) > 1 Тогда
				ФормулаОбъемаНовая = Сред(ФормулаОбъема, СтрДлина(Префикс) + 1, СтрДлина(ФормулаОбъема) - СтрДлина(Постфикс) - СтрДлина(Префикс));
			Иначе
				ФормулаОбъемаНовая = "";
			КонецЕсли;
		Иначе
			ФормулаОбъемаНовая = ФормулаОбъема;
		КонецЕсли;		
	Иначе
		ФормулаОбъемаНовая = ФормулаОбъема;
	КонецЕсли;	
	
	Возврат ФормулаОбъемаНовая;
	
КонецФункции

#КонецОбласти

#Область РаботаСНаборамиРегистровСведений

// Заполняет регистр сведений данными согласно отбора.
// ВАЖНО: в отличие от ЗаписатьРеквизитыРегистраСведенийНабор все существующие данные,
//        не присутствующие в ДанныеДляЗаписи будут сохранены.
//
// Параметры:
//     НаименованиеРегистра - Строка - наименование регистра сведений.
//     Отбор 				- Структура - содержит записи для отбора по измерениям регистра сведений.
//     ДанныеДляЗаписи 		- Структура - содержит данные для заполнения ресурсов регистра.
//
Процедура ЗаписатьРеквизитыРегистраСведений(НаименованиеРегистра, Отбор, ДанныеДляЗаписи) Экспорт

	Если Строка(Метаданные.РегистрыСведений[НаименованиеРегистра].ПериодичностьРегистраСведений) = "Непериодический" Тогда
		ВыборкаРегистра = РегистрыСведений[НаименованиеРегистра].Выбрать(Отбор);
	Иначе
		ВыборкаРегистра = РегистрыСведений[НаименованиеРегистра].СоздатьНаборЗаписей();
		Для Каждого Элемент Из Отбор Цикл
			Если НЕ ЗначениеЗаполнено(Элемент.Значение) Тогда
				Продолжить;
			КонецЕсли;
			ВыборкаРегистра.Отбор[Элемент.Ключ].Установить(Элемент.Значение);
		КонецЦикла;
		ВыборкаРегистра.Прочитать();
	КонецЕсли;
	
	Если ТипЗнч(ВыборкаРегистра) = Тип("РегистрСведенийНаборЗаписей."+НаименованиеРегистра) Тогда
		Если ВыборкаРегистра.Количество() > 0 Тогда
			Для Каждого СтрокаТЧ Из ВыборкаРегистра Цикл
				ЗаполнитьРегистрЗначениями(СтрокаТЧ, Отбор);
				ЗаполнитьРегистрЗначениями(СтрокаТЧ, ДанныеДляЗаписи);
			КонецЦикла;
		Иначе
			НоваяСтрока = ВыборкаРегистра.Добавить();
			ЗаполнитьРегистрЗначениями(НоваяСтрока, Отбор);
			ЗаполнитьРегистрЗначениями(НоваяСтрока, ДанныеДляЗаписи);
		КонецЕсли;
		ВыборкаРегистра.Записать();
	Иначе
		Если ВыборкаРегистра.Следующий() Тогда
			МенеджерЗаписи = ВыборкаРегистра.ПолучитьМенеджерЗаписи();	
			ЗаполнитьРегистрЗначениями(МенеджерЗаписи, Отбор);
			ЗаполнитьРегистрЗначениями(МенеджерЗаписи, ДанныеДляЗаписи);
			МенеджерЗаписи.Записать();
		Иначе	
			МенеджерЗаписи = РегистрыСведений[НаименованиеРегистра].СоздатьМенеджерЗаписи();
			ЗаполнитьРегистрЗначениями(МенеджерЗаписи, Отбор);
			ЗаполнитьРегистрЗначениями(МенеджерЗаписи, ДанныеДляЗаписи);		
			МенеджерЗаписи.Записать();
		КонецЕсли; 
	КонецЕсли;

КонецПроцедуры

// Заполняет регистр сведений данными согласно отбора.
// ВАЖНО: в отличие от ЗаписатьРеквизитыРегистраСведений все существующие данные,
//        не присутствующие в ДанныеДляЗаписи будут очищены.
//
// Параметры:
//     НаименованиеРегистра 	- Строка - наименование регистра сведений.
//     Отбор 					- Структура - содержит записи для отбора по измерениям регистра сведений.
//     ДанныеДляЗаписи 			- Структура - содержит данные для заполнения ресурсов регистра.
//
Процедура ЗаписатьРеквизитыРегистраСведенийНабор(НаименованиеРегистра, Отбор, ДанныеДляЗаписи) Экспорт
	
	//БлокировкаДанных = Новый БлокировкаДанных;
	//ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений."+НаименованиеРегистра);
	//ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
	
	НаборЗаписей = РегистрыСведений[НаименованиеРегистра].СоздатьНаборЗаписей();
	
	Для каждого СтрокаОтбор Из Отбор Цикл 
		НаборЗаписей.Отбор[СтрокаОтбор.Ключ].Установить(СтрокаОтбор.Значение);
		//ЭлементБлокировки.УстановитьЗначение(СтрокаОтбор.Ключ, СтрокаОтбор.Значение);
	КонецЦикла; 	
	
	//БлокировкаДанных.Заблокировать();
	
	Если ЗначениеЗаполнено(ДанныеДляЗаписи) Тогда
	    Запись = НаборЗаписей.Добавить();
		ЗаполнитьРегистрЗначениями(Запись, ДанныеДляЗаписи);
	КонецЕсли;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Заполняет регистр сведений данными согласно отбора.
// ВАЖНО: в отличие от ЗаписатьРеквизитыРегистраСведений все существующие данные,
//        не присутствующие в ДанныеДляЗаписи не будут очищены.
//
// Параметры:
//     НаименованиеРегистра - Строка - наименование регистра сведений.
//     Отбор 				- Структура - содержит записи для отбора по измерениям регистра сведений.
//     ДанныеДляЗаписи 		- Структура - содержит данные для заполнения ресурсов регистра.
//
Процедура ДополнитьРеквизитыРегистраСведенийНабор(НаименованиеРегистра, Отбор, ДанныеДляЗаписи) Экспорт
	
	//БлокировкаДанных = Новый БлокировкаДанных;
	//ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений."+НаименованиеРегистра);
	//ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
	
	НаборЗаписей = РегистрыСведений[НаименованиеРегистра].СоздатьНаборЗаписей();
	
	Для каждого СтрокаОтбор Из Отбор Цикл 
		НаборЗаписей.Отбор[СтрокаОтбор.Ключ].Установить(СтрокаОтбор.Значение);
		//ЭлементБлокировки.УстановитьЗначение(СтрокаОтбор.Ключ, СтрокаОтбор.Значение);
	КонецЦикла;
	
	//БлокировкаДанных.Заблокировать();
	
	НаборЗаписей.Прочитать();
	
	Если ЗначениеЗаполнено(ДанныеДляЗаписи) Тогда
		Если НаборЗаписей.Количество()>0 Тогда
			Запись = НаборЗаписей[0];
		Иначе
			Запись = НаборЗаписей.Добавить();
		КонецЕсли;
		ЗаполнитьРегистрЗначениями(Запись, ДанныеДляЗаписи);
	КонецЕсли;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Заполняет регистр сведений данными согласно отбора данными из таблицы значений.
// ВАЖНО: в отличие от ЗаписатьРеквизитыРегистраСведений все существующие данные,
//        не присутствующие в ДанныеДляЗаписи будут очищены.
//
// Параметры:
//     НаименованиеРегистра - Строка - наименование регистра сведений.
//     Отбор 				- Структура - содержит записи для отбора по измерениям регистра сведений.
//     ДанныеДляЗаписи 		- ТаблицаЗначений - таблица с данными для заполнения ресурсов регистра.
//
Процедура ЗаписатьРеквизитыРегистраСведенийНаборТаблицей(НаименованиеРегистра, Отбор, ДанныеДляЗаписи) Экспорт
	         	
	//БлокировкаДанных = Новый БлокировкаДанных;
	//ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений."+НаименованиеРегистра);
	//ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
	
	НаборЗаписей = РегистрыСведений[НаименованиеРегистра].СоздатьНаборЗаписей();
	
	Для каждого СтрокаОтбор Из Отбор Цикл 
		НаборЗаписей.Отбор[СтрокаОтбор.Ключ].Установить(СтрокаОтбор.Значение);
		//ЭлементБлокировки.УстановитьЗначение(СтрокаОтбор.Ключ, СтрокаОтбор.Значение);
	КонецЦикла;
	
	//БлокировкаДанных.Заблокировать();
	
	НаборЗаписей.Загрузить(ДанныеДляЗаписи);
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Удаляет все движения объектов в системе.
// ВАЖНО! Если позиция еще не записана, следует сделать так, чтобы на нее уже имелась ссылка 
//        (УстановитьСсылкуНового()).
//
// Параметры:
//    СсылкаИлиОбъект 	  - ДокументСсылка, ДокументОбъект - ссылка на объект ИЛИ сам объект, у которого удаляются движения.
//    АктВыполненныхРабот - ДокументСсылка, ДокументОбъект - ссылка на Акт ИЛИ объект акта, если движения удаляются у акта.
//
Процедура УдалитьДвижения(СсылкаИлиОбъект, АктВыполненныхРабот = Неопределено) Экспорт 
	
	Если (ТипЗнч(СсылкаИлиОбъект) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"))
		ИЛИ (ТипЗнч(СсылкаИлиОбъект) = Тип("ДокументОбъект.СМ_ПозицияЛокальнойСметы")) Тогда
		
		Ссылка = ПолучитьСсылкуНаДокумент(СсылкаИлиОбъект, "СМ_ПозицияЛокальнойСметы"); 
		
		Отбор = Новый Структура();
		Отбор.Вставить("Позиция", Ссылка);
		Отбор.Вставить("Смета", ?(АктВыполненныхРабот = Неопределено, Ссылка.ИдСметы, ПолучитьСсылкуНаДокумент(АктВыполненныхРабот, "СМ_АктВыполненныхРабот")));
		
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_РесурснаяСтоимостьПозиции", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиЧППоРазделу", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_СтоимостьРесурсовПозиции", Отбор, Новый ТаблицаЗначений);
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_НРиСП", Отбор, Новый ТаблицаЗначений);
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_СредняяТекущаяСтоимостьПозиции", Отбор, Новый ТаблицаЗначений);
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_СредняяТекущаяСтоимостьРесурсовПозиции", Отбор, Новый ТаблицаЗначений);

		Отбор = Новый Структура("ЗаблокированныйОбъект",Ссылка);
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_БлокировкиСметныхДокументов", Отбор, Новый ТаблицаЗначений);	
		
	ИначеЕсли (ТипЗнч(СсылкаИлиОбъект) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы"))
		ИЛИ (ТипЗнч(СсылкаИлиОбъект) = Тип("ДокументОбъект.СМ_РазделЛокальнойСметы")) Тогда
		
		Ссылка = ПолучитьСсылкуНаДокумент(СсылкаИлиОбъект, "СМ_РазделЛокальнойСметы");
		
		Отбор = Новый Структура();
		Отбор.Вставить("Раздел", Ссылка);
		Отбор.Вставить("Смета", ?(АктВыполненныхРабот = Неопределено, Ссылка.ИдСметы, ПолучитьСсылкуНаДокумент(АктВыполненныхРабот, "СМ_АктВыполненныхРабот")));
		
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоРазделу", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоВидамРабот", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиЧППоРазделу", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_НРиСП", Отбор, Новый ТаблицаЗначений);
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_СредняяТекущаяСтоимостьПозиции", Отбор, Новый ТаблицаЗначений);
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_СредняяТекущаяСтоимостьРесурсовПозиции", Отбор, Новый ТаблицаЗначений);
		
		Отбор = Новый Структура("ЗаблокированныйОбъект",Ссылка);
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_БлокировкиСметныхДокументов", Отбор, Новый ТаблицаЗначений);	
		
	ИначеЕсли (ТипЗнч(СсылкаИлиОбъект) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"))
		ИЛИ (ТипЗнч(СсылкаИлиОбъект) = Тип("ДокументОбъект.СМ_ЛокальнаяСмета")) Тогда
		
		Ссылка = ПолучитьСсылкуНаДокумент(СсылкаИлиОбъект, "СМ_ЛокальнаяСмета");
		
		Отбор = Новый Структура("Смета",Ссылка);
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоСмете", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоВидамРабот", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиЧППоРазделу", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоРазделу", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоГлавам", Отбор, Новый ТаблицаЗначений);
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_НРиСП", Отбор, Новый ТаблицаЗначений);
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_РесурснаяСтоимостьПозиции", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_СтоимостьРесурсовПозиции", Отбор, Новый ТаблицаЗначений);
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ЗаменаМатериаловПозиции", Отбор, Новый ТаблицаЗначений);
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_СредняяТекущаяСтоимостьПозиции", Отбор, Новый ТаблицаЗначений);
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_СредняяТекущаяСтоимостьРесурсовПозиции", Отбор, Новый ТаблицаЗначений);

		Отбор = Новый Структура("ЗаблокированныйОбъект",Ссылка);
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_БлокировкиСметныхДокументов", Отбор, Новый ТаблицаЗначений);	
		
	ИначеЕсли (ТипЗнч(СсылкаИлиОбъект) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот"))
		ИЛИ	(ТипЗнч(СсылкаИлиОбъект) = Тип("ДокументОбъект.СМ_АктВыполненныхРабот")) Тогда
		
		Ссылка = ПолучитьСсылкуНаДокумент(СсылкаИлиОбъект, "СМ_АктВыполненныхРабот");
		
		Отбор = Новый Структура("Смета",Ссылка);               		
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоСмете", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоВидамРабот", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиЧППоРазделу", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоРазделу", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_ИтогиПоГлавам", Отбор, Новый ТаблицаЗначений);
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_НРиСП", Отбор, Новый ТаблицаЗначений);    		
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП", Отбор, Новый ТаблицаЗначений);	
		ЗаписатьРеквизитыРегистраСведенийНабор("СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета", Отбор, Новый ТаблицаЗначений);	
