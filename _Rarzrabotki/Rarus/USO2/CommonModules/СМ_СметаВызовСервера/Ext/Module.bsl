// Функция копирования локальных смет по объекту строительства.
Процедура СкопироватьЛокальныеСметыОбъектаСтроительства(РезультатЗапроса,Стройка) Экспорт
	НачатьТранзакцию();
	ТаблицаСмет = Новый ТаблицаЗначений;
	ТаблицаСмет.Колонки.Добавить("ОбъектБыл");
	ТаблицаСмет.Колонки.Добавить("ОбъектСтал");
	
	ТабОбъекты = Новый ТаблицаЗначений;
	ТабОбъекты.Колонки.Добавить("Ид");
	ТабОбъекты.Колонки.Добавить("НоваяСсылка");
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтараяСмета = Выборка.Ссылка;
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировки = БлокировкаДанных.Добавить("Документ.СМ_ЛокальнаяСмета");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", СтараяСмета);
		
		СсылкаНового = Документы.СМ_ЛокальнаяСмета.ПолучитьСсылку();
		НоваяСмета = Документы.СМ_ЛокальнаяСмета.СоздатьДокумент();
		НоваяСмета.УстановитьСсылкуНового(СсылкаНового);
			
		ЗаполнитьЗначенияСвойств(НоваяСмета, СтараяСмета,,"ИДРодителя");
		
		Если ЗначениеЗаполнено(СтараяСмета.КорректируетСмету) Тогда
			НоваяСмета.КорректируетСмету = ТаблицаСмет.Найти(СтараяСмета.КорректируетСмету,"ОбъектБыл").ОбъектСтал;
		КонецЕсли;
		
		НоваяСмета.ЛимитированныеЗатраты.Загрузить(СтараяСмета.ЛимитированныеЗатраты.Выгрузить());
		НоваяСмета.Подписи.Загрузить(СтараяСмета.Подписи.Выгрузить());
		НоваяСмета.УстановитьНовыйНомер();
		НоваяСмета.Дата = ТекущаяДатаСеанса(); 
		НоваяСмета.Стройка = Стройка;
		НоваяСмета.Записать();
		
		СтрСмет = ТаблицаСмет.Добавить();
		СтрСмет.ОбъектБыл = СтараяСмета;
		СтрСмет.ОбъектСтал = СсылкаНового;
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("Документ.СМ_ЛокальнаяСмета");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", СсылкаНового);
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_СтоимостьРесурсовПозиции");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);    
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);    
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);    
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_ИтогиЧППоРазделу");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);   
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_НРиСП");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);    
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_СредняяТекущаяСтоимостьРесурсовПозиции");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);    
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_ИтогиПоРазделу");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);  
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_ИтогиПоВидамРабот");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);    
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_ИтогиПоСмете");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);    
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_ИтогиПоГлавам");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);    
		
		
		Объекты = ПолучитьТаблицуПодчиненных(СтараяСмета,Истина,Истина,Истина,Истина);
		Объекты.Свернуть("Ид");
		
		ТаблицаЗакрытыхОбъемов = Неопределено;
		РазделятьПозиции = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","РазделятьПозицииЗакрытыеАктами");
		РазделятьПозиции = ?(РазделятьПозиции = Неопределено,Ложь,РазделятьПозиции);
		
		Если РазделятьПозиции Тогда
			ТаблицаЗакрытыхОбъемов = ПолучитьЗакрытыеОбъемыПозиций(СтараяСмета);
		КонецЕсли;

		Перенумеруем = Ложь;
		СкопироватьОбъектыНоваяСметаСтройка(Объекты, СсылкаНового,ЗначениеЗаполнено(СтараяСмета.КорректируетСмету),ТабОбъекты,СтараяСмета,РазделятьПозиции,ТаблицаЗакрытыхОбъемов,Перенумеруем);
		
		Для Каждого СтрОб Из Объекты Цикл
			НовСтр = ТабОбъекты.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,СтрОб);
		КонецЦикла;
		
		Если Перенумеруем Тогда
			СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(СсылкаНового);
		КонецЕсли;

		Документы.СМ_ЛокальнаяСмета.Перерасчет(НоваяСмета,Ложь);
	КонецЦикла;
	ЗафиксироватьТранзакцию();
КонецПроцедуры

// Функция создания локальной сметы на остаток.
Функция СоздатьЛокальнуюСметуНаОстаток(СтараяСмета) Экспорт
	СсылкаНового = Документы.СМ_ЛокальнаяСмета.ПолучитьСсылку();
	НоваяСмета = Документы.СМ_ЛокальнаяСмета.СоздатьДокумент();
	НоваяСмета.УстановитьСсылкуНового(СсылкаНового);
   
	ЗаполнитьЗначенияСвойств(НоваяСмета, СтараяСмета,,"ИДРодителя");
	
	НоваяСмета.КорректируетСмету = СтараяСмета;
	НоваяСмета.НаОстаток = Истина;
	НоваяСмета.Наименование = "На остаток: "+НоваяСмета.Наименование;
	
	НоваяСмета.ЛимитированныеЗатраты.Загрузить(СтараяСмета.ЛимитированныеЗатраты.Выгрузить());
	НоваяСмета.Подписи.Загрузить(СтараяСмета.Подписи.Выгрузить());
	НоваяСмета.УстановитьНовыйНомер();
	НоваяСмета.Дата = ТекущаяДатаСеанса(); 
	НоваяСмета.Записать();
    Возврат СсылкаНового; 	
КонецФункции

// Функция копирования локальной сметы.
Процедура СкопироватьЛокальнуюСмету(СтараяСмета,Корректировка = Ложь,Транзакция = Ложь,НоваяСмета = Неопределено,ИДРодителя = Неопределено,ВАрхив = Ложь,Перерасчет = Истина, СписокАктовДляПересчета = Неопределено) Экспорт
	
	Если Не Транзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	
	Если Перерасчет и СписокАктовДляПересчета = Неопределено Тогда
		СписокАктовДляПересчета = Новый СписокЗначений();
	КонецЕсли; 
	
	СсылкаНового = Документы.СМ_ЛокальнаяСмета.ПолучитьСсылку();
	НоваяСмета = Документы.СМ_ЛокальнаяСмета.СоздатьДокумент();
	НоваяСмета.УстановитьСсылкуНового(СсылкаНового);         	
	
	ЗаполнитьЗначенияСвойств(НоваяСмета, СтараяСмета,,"ИДРодителя");
	
	Если ВАрхив Тогда
		НоваяСмета.Статус = Перечисления.СМ_СтатусыСметныхДокументов.Архив;
	КонецЕсли;

	Если Корректировка Тогда
		НоваяСмета.КорректируетСмету = СтараяСмета;
		НоваяСмета.Наименование = "Корректировка: "+НоваяСмета.Наименование;
	Иначе
		НоваяСмета.КорректируетСмету = Документы.СМ_ЛокальнаяСмета.ПустаяСсылка();
	КонецЕсли;
	
	Если Не ИДРодителя = Неопределено Тогда
		НоваяСмета.ИДРодителя = ИДРодителя;
	КонецЕсли;
	
	НоваяСмета.ЛимитированныеЗатраты.Загрузить(СтараяСмета.ЛимитированныеЗатраты.Выгрузить());
	НоваяСмета.Подписи.Загрузить(СтараяСмета.Подписи.Выгрузить());
	НоваяСмета.УстановитьНовыйНомер();
	НоваяСмета.Дата = ТекущаяДатаСеанса(); 
	НоваяСмета.Записать();
	
	Если Не Транзакция Тогда
		БлокировкаДанных = Новый БлокировкаДанных;
	
		ЭлементБлокировки = БлокировкаДанных.Добавить("Документ.СМ_ЛокальнаяСмета");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", СсылкаНового);

		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_СтоимостьРесурсовПозиции");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);

		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);    

		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);    

		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);    

		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_ИтогиЧППоРазделу");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);   
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_НРиСП");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);    

		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_СредняяТекущаяСтоимостьРесурсовПозиции");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);    
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_ИтогиПоРазделу");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);  
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_ИтогиПоВидамРабот");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);    
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_ИтогиПоСмете");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);    
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СМ_ИтогиПоГлавам");   
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Смета", СсылкаНового);    
		
		БлокировкаДанных.Заблокировать();

	КонецЕсли;
	
	ТЗОбъектов = ПолучитьТаблицуПодчиненных(СтараяСмета,Истина,Истина,Истина,Истина);
	Объекты = ТЗОбъектов.ВыгрузитьКолонку("Ид");
	
	//Если Не СтруктураKPI = Неопределено Тогда
	//	ЗагрузитьТекущиеЦеныВПозицииИзРегистра(СтараяСмета, Истина, Ложь,,Истина);
	//	Документы.СМ_ЛокальнаяСмета.Перерасчет(СтараяСмета,Ложь);
	//КонецЕсли;

	ТаблицаЗакрытыхОбъемов = Неопределено;
	РазделятьПозиции = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","РазделятьПозицииЗакрытыеАктами");
	РазделятьПозиции = ?(РазделятьПозиции = Неопределено,Ложь,РазделятьПозиции);
	//РазделятьПозиции = ?(СтруктураKPI = Неопределено,РазделятьПозиции,Истина);
	
	Если РазделятьПозиции Тогда
		ТаблицаЗакрытыхОбъемов = ПолучитьЗакрытыеОбъемыПозиций(СтараяСмета);
	КонецЕсли;
	
	Перенумеруем = Ложь;
	СкопироватьОбъектыНоваяСмета(Объекты, СсылкаНового,Корректировка,СтараяСмета,РазделятьПозиции,ТаблицаЗакрытыхОбъемов,Перенумеруем, Ложь, СписокАктовДляПересчета);
	
	Если Перенумеруем Тогда
		СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(СсылкаНового);
	КонецЕсли;
	
	Если Перерасчет Тогда
		
		Документы.СМ_ЛокальнаяСмета.Перерасчет(НоваяСмета,Ложь);
		
		Для Каждого Стр Из СписокАктовДляПересчета Цикл
		
			Акт = Стр.Значение;
			Документы.СМ_АктВыполненныхРабот.Перерасчет(Акт);
			
		КонецЦикла;

	КонецЕсли;
	
	Если Не Транзакция Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры

Процедура РазделитьПозицииЛокальнойСметы(Смета,Транзакция = Ложь,Пересчитать=Истина) Экспорт
	Если Не Транзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("Документ.СМ_ЛокальнаяСмета");
