// Возвращает спсиок настроек пользователя для уточнения по объектам строительства.
//
// Параметры:
//     ОбъектНастройки - СправочникСсылка.СМ_ОбъектыСтроительства - объект настройки.
//
// Возвращаемое значение:
//     СписокНастроек - Структура - содержит имена настроек и значения по умолчанию.
//
Функция ПолучитьСписокНастроекПоОбъектам(ОбъектНастройки = Неопределено) Экспорт
	
	Если ОбъектНастройки = Неопределено тогда
		Возврат Новый Массив();
	КонецЕсли;
	
	Список = Новый СписокЗначений;
	Массив = Новый Массив;
	Массив.Добавить(Тип("ПланОбменаСсылка.СМ_ОбменСметаМобильное"));
	ОписаниеТиповС		= Новый ОписаниеТипов(Массив);
	Список.ТипЗначения	= ОписаниеТиповС;
	
	НастройкиКонтроляЛимитов	= СМ_КонтрольЛимитовСервер.ПараметрыКонтроляЛимитов(ОбъектНастройки);
	УИНнастройки				= Строка(ОбъектНастройки.УникальныйИдентификатор());
	СписокНастроек				= Новый Массив();	
	
	//  ******************* Сметные документы ************** 
	
	СписокНастроек.Добавить(Новый Структура("Настройка, ПолеФормы, ЗначениеПоУмолчанию",
								"КонтролироватьОстатокПоАкту",
								"СМ_КонтролироватьОстатокПоАкту",
								НастройкиКонтроляЛимитов.КонтролироватьОстатокПоАкту));
	
	СписокНастроек.Добавить(Новый Структура("Настройка, ПолеФормы, ЗначениеПоУмолчанию",
								"ЗапретитьПроведениеАктаПревышениеЛимитаСметы",
								"СМ_ЗапретитьПроведениеАктаПревышениеЛимитаСметы",
								НастройкиКонтроляЛимитов.ЗапретитьПроведениеАктаПревышениеЛимитаСметы));
	
	СписокНастроек.Добавить(Новый Структура("Настройка, ПолеФормы, ЗначениеПоУмолчанию",
								"ИтогСметыДляДерева" + УИНнастройки,
								"СМ_ИтогСметыДляДерева",
								ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
									"НастройкиПользователяСмета",
									"ИтогСметыДляДерева",
									Справочники.СМ_ИтогиПоГлавам.ПустаяСсылка()
								)));
		
	СписокНастроек.Добавить(Новый Структура("Настройка, ПолеФормы, ЗначениеПоУмолчанию",
								"ОсновнойРегион" + УИНнастройки,
								"СМ_ОсновнойРегион", 
								ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
									"НастройкиПользователяСмета",
									"ОсновнойРегион",
									Список
								)));
	
	СписокНастроек.Добавить(Новый Структура("Настройка, ПолеФормы, ЗначениеПоУмолчанию",
								"ОсновнойУзелМП" + УИНнастройки,
								"СМ_ОсновнойУзелМобильного", 
								ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
									"НастройкиПользователяСмета",
									"ОсновнойУзелМП",
									Список
								)));

	СписокНастроек.Добавить(Новый Структура("Настройка, ПолеФормы, ЗначениеПоУмолчанию",
								"ОсновнаяСтройка" + УИНнастройки,
								"СМ_ОсновнаяСтройка", 
								ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
									"НастройкиПользователяСмета",
									"ОсновнаяСтройка",
									Справочники.СМ_ОбъектыСтроительства.ПустаяСсылка()
								)));
	
	СписокНастроек.Добавить(Новый Структура("Настройка, ПолеФормы, ЗначениеПоУмолчанию",
								"ОсновнаяОрганизация" + УИНнастройки,
								"СМ_ОсновнаяОрганизация", 
								ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
									"НастройкиПользователяСмета",
									"ОсновнаяОрганизация",
