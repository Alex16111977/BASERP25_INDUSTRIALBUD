// Заполняет локальную смету согласно выбранному шаблону.
//
// Параметры:
//	Объект - ДокументОбъект.ЛокальнаяСмета
//
Процедура ЗаполнитьСметуПоШаблону(Объект) Экспорт
	
	ШаблонСметы = Объект.ШаблонСметы;
	Если Не ЗначениеЗаполнено(ШаблонСметы) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШаблонСметы.ВариантПересчетаЭММ) Тогда
		Объект.ВариантПересчетаЭММ = ШаблонСметы.ВариантПересчетаЭММ;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШаблонСметы.ВариантРасчетаЗМ) Тогда
		Объект.ВариантРасчетаЗМ = ШаблонСметы.ВариантРасчетаЗМ;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШаблонСметы.Методика1984) Тогда
		Объект.Методика1984 	= ШаблонСметы.Методика1984;
		Объект.МетодикаРасчета 	= Справочники.СМ_МетодикиРасчета.СМ_Методика84года;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШаблонСметы.МетодикаТСН) Тогда
		Объект.МетодикаТСН	 	= ШаблонСметы.МетодикаТСН;
		Объект.МетодикаРасчета 	= Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШаблонСметы.МетодикаРасчета) Тогда
		Объект.МетодикаРасчета = ШаблонСметы.МетодикаРасчета;	
	КонецЕсли;
	Если ЗначениеЗаполнено(ШаблонСметы.МетодРасчета) Тогда
		Объект.МетодРасчета = ШаблонСметы.МетодРасчета;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШаблонСметы.РеконструкцияАЭС) Тогда
		Объект.РеконструкцияАЭС = ШаблонСметы.РеконструкцияАЭС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШаблонСметы.СпособРасчетаИндексов) Тогда
		Объект.СпособРасчетаИндексов = ШаблонСметы.СпособРасчетаИндексов;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШаблонСметы.ТипРайона) Тогда
		Объект.ТипРайона = ШаблонСметы.ТипРайона;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШаблонСметы.ТипСтроительства) Тогда
		Объект.ТипСтроительства = ШаблонСметы.ТипСтроительства;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШаблонСметы.УпрощеннаяСН) Тогда
		Объект.УпрощеннаяСН = ШаблонСметы.УпрощеннаяСН;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШаблонСметы.Уровень) Тогда
		Объект.Уровень = ШаблонСметы.Уровень;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ШаблонСметы.ШаблонЛимЗатрат) Тогда
		Объект.ЛимитированныеЗатраты.Очистить();
		Для Каждого ТекСтрока Из Объект.ШаблонСметы.ШаблонЛимЗатрат.ЛимитированныеЗатраты Цикл
			НоваяСтрока = Объект.ЛимитированныеЗатраты.Добавить();
			НоваяСтрока.ЛимитированнаяЗатрата = ТекСтрока.ЛимЗатрата;
			НоваяСтрока.ЗначениеЛимЗатраты = ТекСтрока.Значение;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик подписки на событие ПередЗаписью для заполнения автора документа.
//
// Параметры:
//  Источник   - ДокументОбъект - объект документов ЛС, ОС, СС, Акт.
//  Отказ      - Булево - параметр, передаваемый в подписку на событие ПередЗаписью.
//
Процедура ЗаполнитьАвтораПередЗаписью(Источник, Отказ) Экспорт

	Если Источник.Ссылка.Пустая() Тогда
		Если ТипЗнч(Источник) = ТИп("ДокументОбъект.СМ_АктВыполненныхРабот") И Не ЗначениеЗаполнено(Источник.Ответственный) Тогда 
			Источник.Ответственный = Пользователи.ТекущийПользователь();
		ИначеЕсли Не ТипЗнч(Источник) = ТИп("ДокументОбъект.СМ_АктВыполненныхРабот") И Не ЗначениеЗаполнено(Источник.Автор) Тогда
			Источник.Автор = Пользователи.ТекущийПользователь();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Возвращает структуру полей, которые не обновляются по нормативным сборникам.
Функция ПолучитьСтруктуруНеобновляемыхПолейПозиции(Позиция)
	
	Структура = Новый Структура();
	
	Если Позиция = Неопределено Тогда
		Возврат Структура;
	КонецЕсли;
	
	Структура.Вставить("ОбъемРабот",Позиция.ОбъемРабот);
	Структура.Вставить("Расчет",Позиция.Расчет);
	Структура.Вставить("ФормулаОбъема",Позиция.ФормулаОбъема);
	Структура.Вставить("ПоправкиПозиции",Позиция.ПоправкиПозиции.Выгрузить());
	Структура.Вставить("НачисленияПозиции",Позиция.НачисленияПозиции.Выгрузить());
	Структура.Вставить("ИД",Позиция.ИД);
	Структура.Вставить("ИДПозицииВладельца",Позиция.ИДПозицииВладельца);
	Структура.Вставить("ИДРодителя",Позиция.ИДРодителя);
	Структура.Вставить("ИДСметы",Позиция.ИДСметы);
	// Структура.Вставить("ПорНомер",Позиция.ПорНомер);
	// Структура.Вставить("НомерВПределахСметы",Позиция.НомерВПределахСметы);
	// Структура.Вставить("НомерВДереве",Позиция.НомерВДереве);
	
	Возврат Структура;
	
КонецФункции

// Готовит структуру неучтенных ресурсов.
Функция ПолучитьСтруктуруНеучтенныхРесурсов(СтруктураПараметров, ПозицияЛС) Экспорт

	АдресРесурсов = Новый УникальныйИдентификатор();
	Если СтруктураПараметров <> Неопределено И СтруктураПараметров.Свойство("Ресурсы") Тогда
		АдресРесурсов = СтруктураПараметров.Ресурсы;
	КонецЕсли;
	
	ТаблицаНеучтенных = СоздатьТаблицуПоОтбору(ПозицияЛС.РесурсыПозицииЛокальнойСметы.Выгрузить(), "ТипМатериала",Перечисления.СМ_ТипыМатериалов.НеУчтенный);
	ДобавитьВТаблицуПозицию(ТаблицаНеучтенных, ПозицияЛС);
	ТаблицаПоПроекту = СоздатьТаблицуПоОтбору(ПозицияЛС.РесурсыПозицииЛокальнойСметы.Выгрузить(), "ТипМатериала",Перечисления.СМ_ТипыМатериалов.ПоПроекту); 
	ДобавитьВТаблицуПозицию(ТаблицаПоПроекту, ПозицияЛС);		
	
	ТаблицаРесурсов = ДополнитьТаблицуЗначениями(ТаблицаПоПроекту, ТаблицаНеучтенных);
	
	Если СтруктураПараметров <> Неопределено И СтруктураПараметров.Свойство("Пометить") Тогда
		Пометить = СтруктураПараметров.Пометить;
	Иначе
		Пометить = Неопределено;
	КонецЕсли;
	
	//Если ТаблицаРесурсов.Колонки.Найти("Пометить") = Неопределено Тогда
		ТаблицаРесурсов.Колонки.Добавить("Пометить");
	//КонецЕсли;
	ТаблицаРесурсов.ЗаполнитьЗначения(Пометить,"Пометить");

	Если СтруктураПараметров <> Неопределено И СтруктураПараметров.Свойство("Ресурсы")  Тогда
		
		ТаблицаРесурсовКДополнению = ПолучитьИзВременногоХранилища(АдресРесурсов);			
		ДополнитьТаблицуЗначениями(ТаблицаРесурсов, ТаблицаРесурсовКДополнению);			
		ТаблицаРесурсов = ТаблицаРесурсовКДополнению;
		
	КонецЕсли;
	
	
	Если ТаблицаРесурсов.Количество() > 0 Тогда
		АдресРесурсовВХранилище = ПоместитьВоВременноеХранилище(ТаблицаРесурсов, АдресРесурсов);
		Возврат Новый Структура("Ресурсы",АдресРесурсовВХранилище);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции
	
// Функция удаляет уже существующую позиции локальной сметы.
//	Возвращает ложь ИЛИ истина, удалось удалить ИЛИ нет.
//
// Параметры:
//   Позиция - позиция ИЛИ раздел, который удаляются.
//   Интерактивно - выполняются ли действия интерактивно.
//
// Возвращаемое значение:
//   Булево - успешно ли удаление.
//
Функция ОчиститьПозициюЛС(Позиция, Интерактивно = Ложь, Подмена = Ложь) 
	
	НачатьТранзакцию();  
	
	// 1. Удаляем подчиненные.
	// Если Подмена = Истина подчиненные не трогаем.
	Если Подмена = Ложь Тогда
		СписокПодчиненныхДокументов = ПолучитьТаблицуПодчиненных(Позиция); 
		
		Для Каждого ПодчиненныйДокументЭлемент Из СписокПодчиненныхДокументов Цикл
			
			УдалитьПозициюЛС(ПодчиненныйДокументЭлемент.Ид, Интерактивно);	
			
		КонецЦикла;
	КонецЕсли;
	// 2. Для всех реквизитов (кроме даты и номера) - очищаем их.
	
	Для Каждого Реквизит Из Позиция.Метаданные().Реквизиты Цикл
		
		Позиция[Реквизит.Имя] = Неопределено;
		
	КонецЦикла;
	
	// 3. Очищаем все табличные части.
	
	Для Каждого ТабличнаяЧасть Из Позиция.Метаданные().ТабличныеЧасти Цикл
		
		Позиция[ТабличнаяЧасть.Имя].Очистить();
		
	КонецЦикла;
	
	// 4. Удаляем движения.
	
	УдалитьДвижения(Позиция);
	
	ЗафиксироватьТранзакцию();
	
	Возврат Истина;
	
КонецФункции	

// Заполнение реквизитов позиции локальной сметы.
Функция ЗаполнениеРеквизитовПЛС(НовыйДокументПЛС, ЭлементСправочникаНормативныеСборники, СсылкаИсточник, ДанныеЦен) Экспорт	
	
	//НовыйДокументПЛС.ТипНормативныхСборников 	= ЭлементСправочникаНормативныеСборники.ТипНормативногоСборника;
	НовыйДокументПЛС.Определитель 				= ЭлементСправочникаНормативныеСборники.Определитель;
	НовыйДокументПЛС.ЕдиницаИзмерения 			= ЭлементСправочникаНормативныеСборники.ЕдиницаИзмерения;
	НовыйДокументПЛС.Измеритель 				= ЭлементСправочникаНормативныеСборники.Измеритель;
	НовыйДокументПЛС.МассаБрутто 				= ЭлементСправочникаНормативныеСборники.МассаБруттоТ;
	НовыйДокументПЛС.МассаНетто 				= ЭлементСправочникаНормативныеСборники.МассаНеттоТ;
	НовыйДокументПЛС.Наименование 				= ЭлементСправочникаНормативныеСборники.ДлинноеНаименование;
	НовыйДокументПЛС.ШифрРасценки 				= ЭлементСправочникаНормативныеСборники.КодНормативнойРасценки;
	
	БазаДляЦены = СсылкаИсточник.РегионДляВыбораЦен;
	
	СтрокиТЧ = ЭлементСправочникаНормативныеСборники.ЦеныНормативныхСборников.НайтиСтроки(Новый Структура("Район", СсылкаИсточник.Район));
	Если СтрокиТЧ.Количество() > 0 Тогда
		СтрокаНС 									= СтрокиТЧ[0];
		НовыйДокументПЛС.ПрямЗатраты				= СтрокаНС.ПрямыеЗатраты;
		НовыйДокументПЛС.ОснЗарплата				= СтрокаНС.ОсновнаяЗарплата;
		НовыйДокументПЛС.ЭксплМашин					= СтрокаНС.ЭксплуатацияМашинИМеханизмов;
		НовыйДокументПЛС.ЗарплМашинистов			= СтрокаНС.ВТомЧислеЗарплатаМашинистов;
		НовыйДокументПЛС.СтоимМатериалов			= СтрокаНС.СтоимостьМатериалов;
		НовыйДокументПЛС.ВозвратМатер				= СтрокаНС.ВозвратМатериалов;
		НовыйДокументПЛС.Оборудование				= СтрокаНС.СтоимостьОборудования;
		НовыйДокументПЛС.СуммаНРБазисная			= СтрокаНС.НакладныеРасходыСумма;
		НовыйДокументПЛС.СуммаСПБазисная			= СтрокаНС.СметнаяПрибыльСумма;
		НовыйДокументПЛС.ЗатратыТрудаРабочих		= СтрокаНС.ЗатратыТрудаРабочих;
		НовыйДокументПЛС.НакладныеРасходыБазисные	= СтрокаНС.ПроцентНР;
		НовыйДокументПЛС.СметнаяПрибыльБазисные		= СтрокаНС.ПроцентСП;
		НовыйДокументПЛС.НакладныеРасходыТекущие	= СтрокаНС.ПроцентНР;
		НовыйДокументПЛС.СметнаяПрибыльТекущие		= СтрокаНС.ПроцентСП;
	КонецЕсли;	
	
	// Заполнение ТЧ Состав работ.
	ТаблицаСоставаРабот = ЭлементСправочникаНормативныеСборники.СоставРабот.Выгрузить();
	Если ТаблицаСоставаРабот.Количество() > 0 Тогда
		Для Каждого Работа Из ТаблицаСоставаРабот Цикл
			НоваяРабота = НовыйДокументПЛС.СоставРабот.Добавить();
			НоваяРабота.Номер 				= Работа.Номер;
			НоваяРабота.НаименованиеРаботы	= Работа.НаименованиеРаботы;
		КонецЦикла;
	КонецЕсли;	
	
	// Заполнение ТЧ Ресурсы позиции локальной сметы.
	ТаблицаРесурсов = ЭлементСправочникаНормативныеСборники.РесурсыНормативныхСборников.Выгрузить();
	Если ТаблицаРесурсов.Количество() > 0 Тогда
		
		ЗатратыТрудаМашинистов = 0;
		
		Для Каждого стр Из ТаблицаРесурсов Цикл
			Если стр.Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда
				ЗатратыТрудаМашинистов = ЗатратыТрудаМашинистов + стр.НормаРасхода;
			КонецЕсли;
		КонецЦикла;
		
		НовыйДокументПЛС.ЗатратыТрудаМашинистов = ЗатратыТрудаМашинистов;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	РесурсыИзДокумента.Ресурс КАК Ресурс,
		|	РесурсыИзДокумента.НормаРасхода,
		|	РесурсыИзДокумента.ТипРесурса,
		|	РесурсыИзДокумента.ЕдиницаИзмеренияРесурса,
		|	РесурсыИзДокумента.НаименованиеРесурса,
		|	РесурсыИзДокумента.КодРесурса
		|ПОМЕСТИТЬ ВременнаяТаблицаРесурсов
		|ИЗ
		|	&ТаблицаРесурсовИзДокумента КАК РесурсыИзДокумента
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ресурс
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СметныеЦеныРесурсовСрезПоследних.Ресурс,
		|	СметныеЦеныРесурсовСрезПоследних.ТипЦен,
		|	СметныеЦеныРесурсовСрезПоследних.СметнаяЦена,
		|	СметныеЦеныРесурсовСрезПоследних.ЗарплМашинистов,
		|	0 КАК ТекущаяЦена,
		|	0 КАК ТекущаяЗарплатаМашинистов
		|ПОМЕСТИТЬ ЦеныРесурсов
		|ИЗ
		|	РегистрСведений.СМ_СметныеЦеныРесурсов.СрезПоследних(
		|			,
		|			Район = &Район
		|				И Ресурс В (&СписокРесурсовИзДокумента)
		|				И ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Базисная)) КАК СметныеЦеныРесурсовСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СметныеЦеныРесурсовСрезПоследних.Ресурс,
		|	СметныеЦеныРесурсовСрезПоследних.ТипЦен,
		|	0,
		|	0,
		|	СметныеЦеныРесурсовСрезПоследних.СметнаяЦена,
		|	СметныеЦеныРесурсовСрезПоследних.ЗарплМашинистов
		|ИЗ
		|	РегистрСведений.СМ_СметныеЦеныРесурсов.СрезПоследних(
		|			&ДатаТекЦен,
		|			СметноНормативнаяБаза = &СНБ
		|				И Район = &Район
		|				И Ресурс В (&СписокРесурсовИзДокумента)
		|				И ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Текущая)) КАК СметныеЦеныРесурсовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВременнаяТаблицаРесурсов.Ресурс,
		|	ВременнаяТаблицаРесурсов.НормаРасхода,
		|	ЕСТЬNULL(ЦеныРесурсов.СметнаяЦена, 0) КАК СметнаяЦена,
		|	ЕСТЬNULL(ЦеныРесурсов.ТекущаяЦена, 0) КАК ТекущаяЦена,
		|	ВременнаяТаблицаРесурсов.НормаРасхода * ЕСТЬNULL(ЦеныРесурсов.СметнаяЦена, 0) КАК СтоимостьРесурса,
		|	ЦеныРесурсов.Ресурс.ВидРесурса КАК ВидРесурса,
		|	ВременнаяТаблицаРесурсов.ТипРесурса,
		|	ЕСТЬNULL(ЦеныРесурсов.ЗарплМашинистов, 0) КАК ЗарплатаМашинистов,
		|	ЕСТЬNULL(ЦеныРесурсов.ТекущаяЗарплатаМашинистов, 0) КАК ТекущаяЗарплатаМашинистов,
		|	ВременнаяТаблицаРесурсов.ЕдиницаИзмеренияРесурса,
		|	ВременнаяТаблицаРесурсов.НаименованиеРесурса,
		|	ВременнаяТаблицаРесурсов.КодРесурса
		|ИЗ
		|	ВременнаяТаблицаРесурсов КАК ВременнаяТаблицаРесурсов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЦеныРесурсов КАК ЦеныРесурсов
		|		ПО ВременнаяТаблицаРесурсов.Ресурс = ЦеныРесурсов.Ресурс
		|
		|СГРУППИРОВАТЬ ПО
		|	ВременнаяТаблицаРесурсов.Ресурс,
		|	ВременнаяТаблицаРесурсов.НормаРасхода,
		|	ЦеныРесурсов.СметнаяЦена,
		|	ЦеныРесурсов.Ресурс.ВидРесурса,
		|	ВременнаяТаблицаРесурсов.ТипРесурса,
		|	ЦеныРесурсов.ЗарплМашинистов,
		|	ВременнаяТаблицаРесурсов.ЕдиницаИзмеренияРесурса,
		|	ВременнаяТаблицаРесурсов.НаименованиеРесурса,
		|	ВременнаяТаблицаРесурсов.КодРесурса,
		|	ЕСТЬNULL(ЦеныРесурсов.ТекущаяЦена, 0),
		|	ЕСТЬNULL(ЦеныРесурсов.ТекущаяЗарплатаМашинистов, 0)";
		
		СписокРесурсов = Новый СписокЗначений();
		СписокРесурсов.ЗагрузитьЗначения(ТаблицаРесурсов.ВыгрузитьКолонку("Ресурс"));
		
		Запрос.УстановитьПараметр("ТаблицаРесурсовИзДокумента", ТаблицаРесурсов);
		Запрос.УстановитьПараметр("СписокРесурсовИзДокумента", СписокРесурсов);
		Запрос.УстановитьПараметр("СНБ", БазаДляЦены);
		Запрос.УстановитьПараметр("Район", СсылкаИсточник.Район);
		// Пока дата текущих цен не доступна для ввода, посему пока на дату сметы.
		Запрос.УстановитьПараметр("ДатаТекЦен", НачалоМесяца(СсылкаИсточник.ДатаТекущихЦен));
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();  		
		
		Для каждого ТЧ Из РезультатЗапроса Цикл
			НоваяСтрокаТЧ = НовыйДокументПЛС.РесурсыПозицииЛокальнойСметы.Добавить();
			 
			НоваяСтрокаТЧ.Ресурс   			= ТЧ.Ресурс;
			НоваяСтрокаТЧ.ТипМатериала		= ТЧ.ТипРесурса;
			НоваяСтрокаТЧ.НормаРасхода		= ТЧ.НормаРасхода;
			НоваяСтрокаТЧ.ВидРесурса		= ТЧ.Ресурс.ВидРесурса;
			НоваяСтрокаТЧ.БазиснаяЦена		= ТЧ.СметнаяЦена;
			НоваяСтрокаТЧ.БазиснаяЗарплатаМашинистов	= ТЧ.ЗарплатаМашинистов;
			
			Если СсылкаИсточник.АвтозагрузкаЦен
				И Не ЗначениеЗаполнено(СсылкаИсточник.ФайлСборникаТекущихЦен) Тогда
				НоваяСтрокаТЧ.ТекущаяЦена		= ТЧ.ТекущаяЦена;
				НоваяСтрокаТЧ.ТекущаяЗарплатаМашинистов	= ТЧ.ТекущаяЗарплатаМашинистов;
			КонецЕсли;
			
			Если ТЧ.Ресурс.Пустая() Тогда
				НоваяСтрокаТЧ.НаименованиеРесурса = ТЧ.НаименованиеРесурса;
				НоваяСтрокаТЧ.ЕдиницаИзмеренияРесурса = ТЧ.ЕдиницаИзмеренияРесурса;
				НоваяСтрокаТЧ.СметныйКодРесурса = ТЧ.КодРесурса;
			Иначе
				НоваяСтрокаТЧ.НаименованиеРесурса = ТЧ.Ресурс.ДлинноеНаименование;
				НоваяСтрокаТЧ.ЕдиницаИзмеренияРесурса = ТЧ.Ресурс.ЕдиницаИзмерения;
				НоваяСтрокаТЧ.СметныйКодРесурса = ТЧ.Ресурс.Код;
			КонецЕсли;
		КонецЦикла;	
		
		Если Не ДанныеЦен = Неопределено Тогда
			ТаблицаТЦ = СМ_СметаЗагрузкаВызовСервера.ЗагрузитьТекущиеЦеныВТаблицу(ДанныеЦен);
			Если ТаблицаТЦ.Количество() > 0 Тогда
				Для Каждого СтрокаПозиции Из НовыйДокументПЛС.РесурсыПозицииЛокальнойСметы Цикл
					Отбор = Новый Структура();
					Отбор.Вставить("ШифрРасценки", СтрокаПозиции.СметныйКодРесурса);
					МассивИндексов = ТаблицаТЦ.НайтиСтроки(Отбор);
					Если МассивИндексов.Количество() > 0 Тогда
						СтрокаПозиции.ТекущаяЦена = МассивИндексов[0].ТекущаяЦена;
						Если СтрокаПозиции.Ресурс.ВидРесурса <> Перечисления.СМ_ВидыРесурсов.Материалы Тогда
							СтрокаПозиции.ТекущаяЗарплатаМашинистов = МассивИндексов[0].ТекущаяЗарплатаМашинистов;
						Иначе
							СтрокаПозиции.ТекущаяЗарплатаМашинистов = 0;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

// Функция преобразует ТаблицуЗначений в Массив из структур.
Функция ПреобразоватьТаблицуЗначенийВМассив(тзДанные) Экспорт
    
    мсДанные = Новый Массив;
        
    // Запишем в массив
    Для Каждого СтрокаТЗ Из тзДанные Цикл
        
        стСтрокаТаблицы = Новый Структура;
        Для Каждого ИмяКолонки Из тзДанные.Колонки Цикл
            стСтрокаТаблицы.Вставить(ИмяКолонки.Имя, СтрокаТЗ[ИмяКолонки.Имя]);
        КонецЦикла;
        
        мсДанные.Добавить(стСтрокаТаблицы);
        
    КонецЦикла;
    
    Возврат мсДанные;
    
КонецФункции // ПреобразоватьТаблицуЗначенийВМассив()

// Функция преобразует Массив из структур в ТаблицуЗначений.
Функция ПреобразоватьМассивВТаблицуЗначений(мсДанные) Экспорт
    
    тзДанные = Новый ТаблицаЗначений;
    
    Для Каждого ЭлементМассива Из мсДанные Цикл
        // Рисуем колонки для таблицы
        Если тзДанные.Колонки.Количество() = 0 Тогда
            Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
                тзДанные.Колонки.Добавить(ЗначениеСтруктуры.Ключ);
            КонецЦикла;
        КонецЕсли;
        
        // Добавляем данные в таблицу
        НоваяСтрока = тзДанные.Добавить();
        Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
            НоваяСтрока[ЗначениеСтруктуры.Ключ] = ЗначениеСтруктуры.Значение;
        КонецЦикла;
    КонецЦикла;
    
    Возврат тзДанные;
    
КонецФункции // ПреобразоватьМассивВТаблицуЗначений()

// Функция создаёт и возвращает новую Локальную смету с признаком СметаРассчитана.
Функция СоздатьНовуюЛокальнуюСметуРассчитанную(Наименование,ИДРодителя,Номер = Неопределено) Экспорт
    УИД = Новый УникальныйИдентификатор();
	ДокументСсылка = Документы.СМ_ЛокальнаяСмета.ПолучитьСсылку(УИД);
	ДокументОбъект = Документы.СМ_ЛокальнаяСмета.СоздатьДокумент();
	ДокументОбъект.УстановитьСсылкуНового(ДокументСсылка);
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.ИДРодителя = ИДРодителя;
	ДокументОбъект.УстановитьНовыйНомер();
    ДокументОбъект.Наименование = Наименование;
	Если Не Номер = Неопределено Тогда
		ДокументОбъект.НомерСметы = Номер;
	КонецЕсли;
	ДокументОбъект.СметаРассчитана = Истина;
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.Записать();
 	Возврат ДокументСсылка;
КонецФункции

// Функция удаляет уже существующую смету.
//
// Параметры:
//     Смета - 		ДокуметСсылка	- локальная смета.
//
Процедура УдалитьЛС(Смета) Экспорт
	
	НачатьТранзакцию();
	
	ДокОбъект = Смета.ПолучитьОбъект();
	
	Попытка
		ДокОбъект.УстановитьПометкуУдаления(Истина);
	Исключение
		Событие = НСтр("ru = 'Исключение Обработчики сметы (вызов сервера)'");
		СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
	КонецПопытки;
	
	Попытка
		ДокОбъект.Удалить();
	Исключение
		Событие = НСтр("ru = 'Исключение Обработчики сметы (вызов сервера)'");
		СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
	КонецПопытки;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

// Установка статуса ресурса по умолчанию.
Процедура СМ_ЗаполнитьСтатусРесурсаПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Если Не ЗначениеЗаполнено(Источник.СтатусРесурса)
		И (Источник.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал
		ИЛИ Источник.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование) Тогда
		Источник.СтатусРесурса = Перечисления.СМ_ОбеспечениеРесурса.Собственный;
	КонецЕсли;
	Для Каждого Рес Из Источник.РесурсыПозицииЛокальнойСметы Цикл
		Если ЗначениеЗаполнено(Рес.СтатусРесурса) Тогда
			Продолжить;
		КонецЕсли;
		Рес.СтатусРесурса = Перечисления.СМ_ОбеспечениеРесурса.Собственный;
	КонецЦикла;
КонецПроцедуры

// Возвращает шифр по заданному шаблону.
// Параметры:
//     СНБ - 			СМ_СметноНормативныеБазы 			- имя метаданных справочника.
//     ИмяОбъекта - 	строка 	- имя метаданных, вида СМ_АктВыполненныхРабот.
//     Шифр - 	строка 	- изначальное значение шифра.
Функция ПолучитьШифрПоШаблону(СНБ,ИмяОбъекта,Шифр) Экспорт
	ШифрПоШаблону = "";
	Шифр = СтрЗаменить(Шифр,",","");
	Шифр = СтрЗаменить(Шифр,"-","");
	Шифр = СтрЗаменить(Шифр," ","");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_СтруктураШифра.Шаблон
	               |ИЗ
	               |	РегистрСведений.СМ_СтруктураШифра КАК СМ_СтруктураШифра
	               |ГДЕ
	               |	СМ_СтруктураШифра.СНБ = &СНБ
	               |	И СМ_СтруктураШифра.ИмяОбъекта = &ИмяОбъекта";
	Запрос.УстановитьПараметр("СНБ",СНБ);			   
	Запрос.УстановитьПараметр("ИмяОбъекта",ИмяОбъекта);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Шаблон = Выборка.Шаблон;
	Иначе
		Возврат Шифр;
	КонецЕсли;
	
	КолШаблон = СтрДлина(Шаблон);
	КолШифр = СтрДлина(Шифр);
	
	сч = 1;
	счШ = 1;
	Пока сч <= КолШаблон Цикл
		Символ = Сред(Шаблон,сч,1);
		
		Если СтрНайти(",- ",Символ) > 0 Тогда
			ШифрПоШаблону = ШифрПоШаблону+Символ;
		Иначе
			СимволШ = Сред(Шифр,счШ,1);
			ШифрПоШаблону = ШифрПоШаблону+Строка(СимволШ);
			счШ = счШ + 1;
		КонецЕсли;
		
		Если счШ > КолШифр Тогда
			Прервать;
		КонецЕсли;
		
		сч = сч + 1;
	КонецЦикла;
	
	Пока счШ <= КолШифр Цикл
		Символ = Сред(Шифр,счШ,1);
		ШифрПоШаблону = ШифрПоШаблону+Строка(Символ);
		счШ = счШ + 1;
	КонецЦикла;
	
	Возврат ШифрПоШаблону;
КонецФункции

