// Функция получает массив лим.затрат с отбором по методике
Функция ПолучитьМассивЛимЗатратПоМетодике(МетодикаРасчета) Экспорт

	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ
	|	СМ_ИспользованиеЛимитированныхЗатрат.Методика,
	|	СМ_ИспользованиеЛимитированныхЗатрат.ЛимитированнаяЗатрата КАК ЛимЗатрата
	|ИЗ
	|	РегистрСведений.СМ_ИспользованиеЛимитированныхЗатрат КАК СМ_ИспользованиеЛимитированныхЗатрат
	|ГДЕ
	|	СМ_ИспользованиеЛимитированныхЗатрат.Методика = &Методика И
	|	СМ_ИспользованиеЛимитированныхЗатрат.Используется = ИСТИНА";

	Запрос.УстановитьПараметр("Методика",МетодикаРасчета);
	ТабРезультат 	= Запрос.Выполнить().Выгрузить();
	МассивЛимЗатрат = ТабРезультат.ВыгрузитьКолонку("ЛимЗатрата");
	
	Возврат МассивЛимЗатрат;
	
КонецФункции

// Осуществляет поиск нормативного сборника по типу сборника, коду расценки и СНБ
Функция НайтиНормативныйСборник(ТипСборника,КодНормативнойРасценки,СметноНормативнаяБаза = "") Экспорт
	
	Запрос 			= Новый Запрос;
	ТекстЗапроса 	= "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	СМ_НормативныеСборники.Ссылка КАК НормативныйСборник,
	|	СМ_НормативныеСборники.ТипНормативногоСборника КАК ТипНормативногоСборника,
	|	СМ_НормативныеСборники.КодНормативнойРасценки КАК КодНормативнойРасценки,
	|	СМ_НормативныеСборники.СметноНормативнаяБаза КАК СметноНормативнаяБаза
	|ИЗ
	|	Справочник.СМ_НормативныеСборники КАК СМ_НормативныеСборники
	|ГДЕ
	|	СМ_НормативныеСборники.КодНормативнойРасценки = &КодНормативнойРасценки И
	|	СМ_НормативныеСборники.ТипНормативногоСборника = &ТипНормативногоСборника";
	
	Если ЗначениеЗаполнено(СметноНормативнаяБаза) Тогда
		ТекстЗапроса = ТекстЗапроса + " И СМ_НормативныеСборники.СметноНормативнаяБаза = &СметноНормативнаяБаза";
	КонецЕсли;	
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("КодНормативнойРасценки",КодНормативнойРасценки);
	Запрос.УстановитьПараметр("ТипНормативногоСборника",ТипСборника);
	Запрос.УстановитьПараметр("СметноНормативнаяБаза",СметноНормативнаяБаза);
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	Если ВыборкаЗапроса.Следующий() Тогда
		Возврат ВыборкаЗапроса.НормативныйСборник;
	Иначе
		Возврат Справочники.СМ_НормативныеСборники.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции


