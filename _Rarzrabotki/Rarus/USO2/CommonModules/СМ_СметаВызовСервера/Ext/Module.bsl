// Проверка уникальности элемента справочника по реквизиту.
//
// Параметры:
//     ИмяСправочника 		- Строка	- строка с именем справочника.
//     ИмяРеквизита 		- Строка	- строка с именем реквизита.
//     ЗначениеРеквизита 	- Произвольный	- значение реквихита.
//     ОбъектСсылка 		- СправочникСсылка	- нссылка на текущий элемент.
//     Родитель 			- СправочникСсылка	- родитель элемента (задается, если искать в пределах иерархии).
//                        
// Возвращаемое значение:
//     Булево	- Истина - проверка пройдена (элемент имеет уникальное значение реквизита), иначе - Ложь.
//
Функция КонтрольУникальности(ИмяСправочника, ИмяРеквизита, ЗначениеРеквизита, ОбъектСсылка = Неопределено, Родитель = Неопределено) Экспорт
	
	Если ИмяРеквизита = "Код" Тогда
		ЭлементВБазе = Справочники[ИмяСправочника].НайтиПоКоду(ЗначениеРеквизита, Ложь, Родитель);
	ИначеЕсли ИмяРеквизита = "Наименование" Тогда
		ЭлементВБазе = Справочники[ИмяСправочника].НайтиПоНаименованию(ЗначениеРеквизита, Истина, Родитель);
	Иначе
		ЭлементВБазе = Справочники[ИмяСправочника].НайтиПоРеквизиту(ИмяРеквизита, ЗначениеРеквизита, Родитель);
	КонецЕсли;
	Возврат ((ЭлементВБазе = Справочники[ИмяСправочника].ПустаяСсылка()) ИЛИ (ЭлементВБазе = ОбъектСсылка) ИЛИ (ЭлементВБазе = Неопределено)); 	
	
КонецФункции

// Преобразование кода нормативной расценки, к числу, по определенным правилам.
//
// Параметры:
//     парамЗИВ_КодСправочника 		- Строка	- код справочника (код нормативной расценки).
//                        
// Возвращаемое значение:
//     Число	- 0 - код не преобразован (значение по умолчанию).
//
Функция ПреобразоватьКодСправочника(парамЗИВ_КодСправочника) Экспорт
	
	//	возвращаемое значение
	перемЗИВ_Код				= 0;
	
	Если НЕ ЗначениеЗаполнено(парамЗИВ_КодСправочника) Тогда
		Возврат перемЗИВ_Код;
	КонецЕсли;
	
	перемЗИВ_ЧастиКода			= СтрРазделить(СокрЛП(парамЗИВ_КодСправочника), "-", Ложь);
	перемЗИВ_ЧисловыеЧасти		= Новый Массив;
	перемЗИВ_ВсеЧислаМеньше1000	= Истина;
	
	//	оставить только числа
	Для каждого циклСтрока из перемЗИВ_ЧастиКода Цикл
		
		перемЗИВ_ДлинаСтроки	= СтрДлина(циклСтрока);
		перемЗИВ_ЧисловаяЧасть	= "";
		
		Для перемЗИВ_Н=1 по перемЗИВ_ДлинаСтроки Цикл
			
			перемЗИВ_Символ	= Сред(циклСтрока, перемЗИВ_Н, 1);
			
			Попытка
				перемЗИВ_Число			= Число(перемЗИВ_Символ);
				перемЗИВ_ЧисловаяЧасть	= перемЗИВ_ЧисловаяЧасть + Строка(перемЗИВ_Символ);
			Исключение
			КонецПопытки;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(перемЗИВ_ЧисловаяЧасть) тогда
			
			перемЗИВ_ЧисловыеЧасти.Добавить(перемЗИВ_ЧисловаяЧасть);
			
			Если Число(перемЗИВ_ЧисловаяЧасть) > 1000 тогда
				перемЗИВ_ВсеЧислаМеньше1000	= Ложь;	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	//	случай, при котором меняем значение кода
	Если перемЗИВ_ЧисловыеЧасти.Количество() <= 4 И
		перемЗИВ_ВсеЧислаМеньше1000 тогда
		
		Для перемЗИВ_Н=0 по перемЗИВ_ЧисловыеЧасти.Количество()-1 Цикл
			
			перемЗИВ_Число	= 0;
			
			//	первое число пропускаем и записываем, как оно есть
			Если перемЗИВ_Н=перемЗИВ_ЧисловыеЧасти.Количество()-1 тогда
				перемЗИВ_Число	= Число(перемЗИВ_ЧисловыеЧасти[перемЗИВ_Н]);
			Иначе
				перемЗИВ_Число	= Число(перемЗИВ_ЧисловыеЧасти[перемЗИВ_Н]) * Pow(1000, перемЗИВ_ЧисловыеЧасти.Количество()-(перемЗИВ_Н+1));
			КонецЕсли;
			
			//	результатирующий вариант
			перемЗИВ_Код	= перемЗИВ_Код + перемЗИВ_Число;
		
		КонецЦикла;
			
	КонецЕсли;
	
	//
	Возврат перемЗИВ_Код;
	
КонецФункции

#КонецОбласти

#Область РаботаСНормами

// Заполняет таблицу сведениями о поправках подходящими под условаия отбора (СНБ, Тип, Шифр).
// TO DO - вынести в серверный модуль.
//
// Параметры:
//     СНБ 					- СправочникСсылка.СМ_СметноНормативныеБазы	- ссылка на элемент справочника.
//     ТипНормСборн 		- ПеречислениеСсылка.СМ_ТипНормативногоСборника	- ссылка на тип нормативного сборника.
//     ШифрРасценки			- Строка - сметный шифр позиции.
//     ТЧ 					- ТаблицаЗначений - заполняемая таблица.
//	   СтруктураПараметров 	- Структура - содержит свойство "МетодикаКазахстана", 
//							  по которому определяется применять данную методику или нет.
//
Процедура ПолучитьПоправкиПоТехЧастям(СНБ, ТипНормСборн, ШифрРасценки, ТЧ, СтруктураПараметров = Неопределено) Экспорт
	Если СМ_СметаЗагрузкаВызовСервера.ОпределитьУровеньСНБ(СНБ.Наименование, СНБ.Код)= Перечисления.СМ_УровниБазы.ТерриториальныйМосква Тогда
		ТипБазыТСН = Истина;
	Иначе
		ТипБазыТСН = Ложь;
	КонецЕсли;	
	МетодикаКазахстана = Ложь;
	
	Если Не СтруктураПараметров = Неопределено Тогда
		Если СтруктураПараметров.Свойство("МетодикаКазахстана") Тогда
			МетодикаКазахстана = СтруктураПараметров.МетодикаКазахстана;
		КонецЕсли;
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
