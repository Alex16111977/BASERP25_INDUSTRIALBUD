#Область ПрограммныйИнтерфейс

// Выполняет обмен с сервисом АРПС.
Процедура ОбменАРПССервис() Экспорт
	
	Если Не Константы.СМ_ОтправлятьСведенияАРПС.Получить() Тогда
		Возврат;
	КонецЕсли;
	Адрес = Константы.СМ_АдресПодключенияАРПС.Получить(); // "localhost/ARPS"
	Если Не ЗначениеЗаполнено(Адрес) Тогда
		ПредставлениеОшибки = НСтр("ru = 'Не указан адрес для обмена.'");
		ЗаписатьИсключениеНаСервере(ПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	Пользователь = ""; 
	Пароль = "";
	ДанныеХранилищу = ЗарегестрироватьВыгрузку();
	Если ДанныеХранилищу = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Данные = Новый ХранилищеЗначения(ДанныеХранилищу, Новый СжатиеДанных(9));
	Попытка
		ВСОпределение = Новый WSОпределения("http://"+Адрес+"/ws/ARPS_Servise.1cws?wsdl",Пользователь,Пароль,,60);
	Исключение
		ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьИсключениеНаСервере(ПредставлениеОшибки);
		Возврат;
	КонецПопытки;
	
	ВСервис       = ВСОпределение.Сервисы.Получить("ARPS_Servise","ARPS_Servise");
	ВТочкаВхода   = ВСервис.ТочкиПодключения.Получить("ARPS_ServiseSoap");
	ВОперация     = ВТочкаВхода.Интерфейс.Операции.Получить("Синхронизация");    
	СтрокаДанных  = ВСОпределение.ФабрикаXDTO.Создать(ВОперация.Параметры.Получить("Данные").Тип,Данные); 
	Попытка
		Соединение = Новый WSПрокси(ВСОпределение,ВСервис.URIПространстваИмен,ВСервис.Имя,"ARPS_ServiseSoap",,60);
	Исключение
		ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьИсключениеНаСервере(ПредставлениеОшибки);
		Возврат;
	КонецПопытки;
	
	Соединение.Пользователь = Пользователь;
	Соединение.Пароль = Пароль;
	Попытка
		Успех = Соединение.Синхронизация(СтрокаДанных);
		Отправитель	= ПланыОбмена.СМ_СервисАРПС.НайтиПоКоду("АРПС");
		ПланыОбмена.УдалитьРегистрациюИзменений(Отправитель);
	Исключение
		ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьИсключениеНаСервере(ПредставлениеОшибки);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция регистрации выгрузки объектов сервиса АРПС.
Функция ЗарегестрироватьВыгрузку()
	
	Соответствие = Новый Соответствие;
	АРПС_Итоги = Новый ТаблицаЗначений;
	АРПС_Итоги.Колонки.Добавить("НаименованиеЛимзатратыАРПС");
	
	АРПС_ПрефиксыОбъектов = Новый ТаблицаЗначений;
	АРПС_ПрефиксыОбъектов.Колонки.Добавить("СтрокаПрефикса");
	АРПС_ПрефиксыОбъектов.Колонки.Добавить("ТипНормативногоСборника");
	АРПС_ПрефиксыОбъектов.Колонки.Добавить("ВидРесурса");

	АРПС_СоответствияШифров = Новый ТаблицаЗначений;
	АРПС_СоответствияШифров.Колонки.Добавить("ШифрАРПС");
	АРПС_СоответствияШифров.Колонки.Добавить("ВидРесурса");
	
	АРПС_СоответствияЛимЗатрат = Новый ТаблицаЗначений;
	АРПС_СоответствияЛимЗатрат.Колонки.Добавить("НаименованиеЛимзатратыАРПС");
	АРПС_СоответствияЛимЗатрат.Колонки.Добавить("ИдентификаторЛимЗатраты");
	АРПС_СоответствияЛимЗатрат.Колонки.Добавить("НаименованиеЛимзатраты");

	
	
    Отправитель	= ПланыОбмена.СМ_СервисАРПС.НайтиПоКоду("АРПС");
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(Отправитель,0);
	Пока ВыборкаИзменений.Следующий() Цикл
		ОбъектОбмена = ВыборкаИзменений.Получить();
		Если ТипЗнч(ОбъектОбмена) = Тип("РегистрСведенийНаборЗаписей.СМ_АРПС_Итоги")  Тогда
			Для Каждого Запись Из ОбъектОбмена Цикл
				Если Не Запись.РедактироваласьПользователем Тогда
					Продолжить;
				КонецЕсли;
				стр = АРПС_Итоги.Добавить();
				ЗаполнитьЗначенияСвойств(стр,Запись);
			КонецЦикла;
		ИначеЕсли ТипЗнч(ОбъектОбмена) = Тип("РегистрСведенийНаборЗаписей.СМ_АРПС_ПрефиксыОбъектов")  Тогда
			Для Каждого Запись Из ОбъектОбмена Цикл
				Если Не Запись.РедактироваласьПользователем Тогда
					Продолжить;
				КонецЕсли;
				стр = АРПС_ПрефиксыОбъектов.Добавить();
				ЗаполнитьЗначенияСвойств(стр,Запись);
			КонецЦикла;
		ИначеЕсли ТипЗнч(ОбъектОбмена) = Тип("РегистрСведенийНаборЗаписей.СМ_АРПС_СоответствияЛимЗатрат")  Тогда
			Для Каждого Запись Из ОбъектОбмена Цикл
				Если Не Запись.РедактироваласьПользователем Тогда
					Продолжить;
				КонецЕсли;
				стр = АРПС_СоответствияЛимЗатрат.Добавить();
				ЗаполнитьЗначенияСвойств(стр,Запись);
			КонецЦикла;
		ИначеЕсли ТипЗнч(ОбъектОбмена) = Тип("РегистрСведенийНаборЗаписей.СМ_АРПС_СоответствияШифров")  Тогда
			Для Каждого Запись Из ОбъектОбмена Цикл
				Если Не Запись.РедактироваласьПользователем Тогда
					Продолжить;
				КонецЕсли;
				стр = АРПС_СоответствияШифров.Добавить();
				ЗаполнитьЗначенияСвойств(стр,Запись);
			КонецЦикла;
		КонецЕсли
	КонецЦикла;

	Соответствие.Вставить("АРПС_Итоги",АРПС_Итоги);
	Соответствие.Вставить("АРПС_ПрефиксыОбъектов",АРПС_ПрефиксыОбъектов);
	Соответствие.Вставить("АРПС_СоответствияШифров",АРПС_СоответствияШифров);
	Соответствие.Вставить("АРПС_СоответствияЛимЗатрат",АРПС_СоответствияЛимЗатрат);
	Если АРПС_Итоги.Количество() = 0
		И АРПС_ПрефиксыОбъектов.Количество() = 0
		И АРПС_СоответствияШифров.Количество() = 0
		И АРПС_СоответствияЛимЗатрат.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат Сериализовать(Соответствие);
	КонецЕсли;
КонецФункции

// Функция сериализации объектов сервиса АРПС.
Функция Сериализовать(ОбъектСериализации)
    ДеревоВОбъектеXDTO = СериализаторXDTO.ЗаписатьXDTO(ОбъектСериализации);
	МойXML = Новый ЗаписьXML;
	МойXML.УстановитьСтроку();
    ФабрикаXDTO.ЗаписатьXML(МойXML, ДеревоВОбъектеXDTO);
    Возврат МойXML.Закрыть();
КонецФункции

// Записать исключение в журнал регистрации.
Процедура ЗаписатьИсключениеНаСервере(Знач ПредставлениеОшибки)
	
	Событие = НСтр("ru = 'Ошибка в получении данных АРПС'");
	ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ПредставлениеОшибки);
	
КонецПроцедуры

#КонецОбласти


