	СтруктураПоиска.Вставить("НомерДоговора",ДанныеПоОбмену.Номер);					
	СтруктураПоиска.Вставить("ДатаДоговора",ДанныеПоОбмену.Дата);
	СтруктураПоиска.Вставить("Владелец",ПолучитьСоответствиеПоGUID(Узел,ДанныеПоОбмену.КонтрагентGUID));
	СтруктураПоиска.Вставить("Организация",ПолучитьСоответствиеПоGUID(Узел,ДанныеПоОбмену.ОрганизацияGUID));
	
	Если ОбъектВыгрузки=Неопределено Тогда
		ОбъектВыгрузки=СоздатьНайтиДоговор(СтруктураПоиска);
	Иначе
		ОбъектВыгрузки=ОбъектВыгрузки.ПолучитьОбъект();
	КонецЕсли;                                             
	ОбъектВыгрузки.Номер=ДанныеПоОбмену.Номер;
	ОбъектВыгрузки.Дата=ДанныеПоОбмену.Дата;
	ОбъектВыгрузки.Организация=СтруктураПоиска.Организация;
	ОбъектВыгрузки.Контрагент=СтруктураПоиска.Владелец;
	ОбъектВыгрузки.Наименование=ДанныеПоОбмену.Наименование;
	ОбъектВыгрузки.ДатаНачалаДействия=ДанныеПоОбмену.ДатаНачалаДействия;
	ОбъектВыгрузки.ДатаОкончанияДействия=ДанныеПоОбмену.ДатаОкончанияДействия;
	ОбъектВыгрузки.ВалютаВзаиморасчетов=Справочники.Валюты.НайтиПоКоду(ДанныеПоОбмену.Валюта);
	ОбъектВыгрузки.ТипДоговора=Метаданные.Перечисления.ТипыДоговоров.ЗначенияПеречисления.Найти(ДанныеПоОбмену.ТипДоговора);
	Если Не ЗначениеЗаполнено(ОбъектВыгрузки.ТипДоговора) Тогда
		ОбъектВыгрузки.ТипДоговора=Перечисления.ТипыДоговоров.СПоставщиком;
	КонецЕсли;
	ОбъектВыгрузки.ПорядокРасчетов=Метаданные.Перечисления.ПорядокРасчетов.ЗначенияПеречисления.Найти(ДанныеПоОбмену.ПорядокРасчетов);
	Если Не ЗначениеЗаполнено(ОбъектВыгрузки.ПорядокРасчетов) Тогда
		ОбъектВыгрузки.ПорядокРасчетов=Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
	КонецЕсли;
	ОбъектВыгрузки.Статус=Метаданные.Перечисления.СтатусыДоговоровКонтрагентов.ЗначенияПеречисления.Найти(ДанныеПоОбмену.Статус);
	Если Не ЗначениеЗаполнено(ОбъектВыгрузки.Статус) Тогда
		ОбъектВыгрузки.Статус=Перечисления.СтатусыДоговоровКонтрагентов.Действует;
	КонецЕсли;
	
	ОбъектВыгрузки.ПорядокОплаты=Метаданные.Перечисления.ПорядокОплатыПоСоглашениям.ЗначенияПеречисления.Найти(ДанныеПоОбмену.ПорядокОплаты);
	Если Не ЗначениеЗаполнено(ОбъектВыгрузки.ПорядокОплаты) Тогда
		ОбъектВыгрузки.ПорядокОплаты=Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВРубляхОплатаВРублях;
	КонецЕсли;
	
	
	
	Возврат   ОбъектВыгрузки;
КонецФункции

Функция ЗаполнитьПроект(Узел,GUID,СтрокаХМЛ) 	
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СтрокаХМЛ);
	Схема=ПолучитьСхемуОбъектаСтроительства();
	ЧтениеСхемыXML = Новый ЧтениеXML;
	ЧтениеСхемыXML.УстановитьСтроку(Схема);
	ПостроительDOM = Новый ПостроительDOM;
	ДокументДом = ПостроительDOM.Прочитать(ЧтениеСхемыXML);
	ПостроительСхем=новый ПостроительСхемXML;
	Схема=ПостроительСхем.СоздатьСхемуXML(ДокументДом);
	НаборСхем=Новый наборСхемXMl;
	НаборСхем.Добавить(Схема);
	
	
	Фабрика=Новый ФабрикаXDTO(НаборСхем);
	Юри="ericos";
	ТипОбъекта = Фабрика.Тип(Юри,"ОбъектСтроительства");	
	ДанныеПоОбмену=Фабрика.ПрочитатьXML(ЧтениеXML,ТипОбъекта);
	
	ОбъектВыгрузки=ПолучитьСоответствиеПоGUID(Узел,GUID);
	Если ОбъектВыгрузки=Неопределено Тогда
		ОбъектВыгрузки=СоздатьНайтиПроект(ДанныеПоОбмену);
	Иначе
		ОбъектВыгрузки=ОбъектВыгрузки.ПолучитьОбъект();
	КонецЕсли;
	ОбъектВыгрузки.Наименование=ДанныеПоОбмену.Наименование;
	
	Возврат ОбъектВыгрузки;
КонецФункции

Функция ЗаполнитьЦеныАкта(Узел,ОбАкт,СтрокаХМЛ,Ответ)
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СтрокаХМЛ);
	Схема=ПолучитьСхемуДвиженияАкта();
	ЧтениеСхемыXML = Новый ЧтениеXML;
	ЧтениеСхемыXML.УстановитьСтроку(Схема);
	ПостроительDOM = Новый ПостроительDOM;
	ДокументДом = ПостроительDOM.Прочитать(ЧтениеСхемыXML);
	ПостроительСхем=новый ПостроительСхемXML;
	Схема=ПостроительСхем.СоздатьСхемуXML(ДокументДом);
	НаборСхем=Новый наборСхемXMl;
	НаборСхем.Добавить(Схема);
	
	
	Фабрика=Новый ФабрикаXDTO(НаборСхем);
	Юри="ericos";
	ТипОбъекта = Фабрика.Тип(Юри,"Движения");	
	ДанныеПоОбмену=Фабрика.ПрочитатьXML(ЧтениеXML,ТипОбъекта);
	

	РесТаб=ОбАкт.РесурсыПозицийАкта;
	Проводить=Ложь;
	
	Для Каждого Эл Из ДанныеПоОбмену.ТаблицаДвижения Цикл
		Ресурс=ПолучитьСоответствиеПоGUID(Узел,эл.GUID);
		Если Ресурс=Неопределено Тогда
			Ответ.Добавить("Не найдены ресурсы, по которым производилось списание. Обратитесь в администратору.");
			Продолжить;
		КонецЕсли;	
		
		СтрМас=РесТаб.НайтиСтроки(Новый Структура("Ресурс",Ресурс));
		Для Каждого СтрЦен ИЗ Стрмас Цикл
			Если  СтрЦен.БазиснаяЦена=0 Тогда
				СтрЦен.БазиснаяЦена=СтрЦен.ТекущаяЦена;
			Конецесли;
			СтрЦен.ТекущаяЦена=Эл.Цена;
			СтрЦен.НеИзменятьЦены=Ложь;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Истина;
КонецФункции


