Функция СоздатьНайтиДоговор(СтруктураПоиска)
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Номер = &НомерДоговора
	|	И ДоговорыКонтрагентов.Дата = &ДатаДоговора
	|	И ДоговорыКонтрагентов.Контрагент= &Владелец
	|	И ДоговорыКонтрагентов.Организация = &Организация");
	Запрос.УстановитьПараметр("НомерДоговора",СтруктураПоиска.НомерДоговора);					
	Запрос.УстановитьПараметр("ДатаДоговора",СтруктураПоиска.ДатаДоговора);
	Запрос.УстановитьПараметр("Владелец",СтруктураПоиска.Владелец);
	Запрос.УстановитьПараметр("Организация",СтруктураПоиска.Организация);
	Рез=Запрос.Выполнить().Выбрать();
	Эл=Неопределено;
	Если Рез.Следующий() Тогда
		Эл=Рез.Ссылка.ПолучитьОБъект();
	Иначе
		Эл=Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		Эл.УстановитьНовыйКод();
	КонецЕсли;	
	Возврат Эл;
	
КонецФункции

