	КонецЕсли;
	Если ЗначениеЗаполнено(Источник.Статус) Тогда
		Об.Статус =Источник.Статус.Метаданные().Имя;
	КонецЕсли;
	Если ЗначениеЗаполнено(Источник.ПорядокРасчетов) Тогда
		Об.ПорядокРасчетов =Источник.ПорядокРасчетов.Метаданные().Имя;
	КонецЕсли;
	Если ЗначениеЗаполнено(Источник.ТипДоговора) Тогда
		Об.ТипДоговора =Источник.ТипДоговора.Метаданные().Имя;
	КонецЕсли;
	
