Функция ПолучитьСхемуОбъектаСтроительства()
	
	Схема="<?xml version=""1.0"" encoding=""utf-8""?>
	|<xs:schema xmlns=""ericos"" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" targetNamespace=""ericos"" elementFormDefault=""qualified"" attributeFormDefault=""unqualified"">
	|	<xs:element name=""ОбъектСтроительства"" type=""ОбъектСтроительства"">
