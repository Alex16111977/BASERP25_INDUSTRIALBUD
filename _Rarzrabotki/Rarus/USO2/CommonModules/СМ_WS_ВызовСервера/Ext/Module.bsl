
#Область ПрограммныйИнтерфейс

// Процедура регистрирует изменения по плану обмена СМ_WS_Обмен
//
// Параметры:
//   Источник 		- СправочникСсылка, ДокументСсылка - ссылка на источник изменений.
//	 Отказ			-  Булево - статус отказа.	
//
Процедура СМ_WS_ОбменПриЗаписи(Источник, Отказ) Экспорт
	
	ИспользуетсяОбменПоWebСервису = ПолучитьФункциональнуюОпцию("СМ_WS_ИспользоватьИнтеграцию");
	Если ИспользуетсяОбменПоWebСервису Тогда
		
		Если Источник.ОбменДанными.Загрузка Тогда 
			Возврат;
		КонецЕсли;	
		
		Если ТипЗнч(Источник)=Тип("ДокументОбъект.СМ_АктВыполненныхРабот") Тогда
			Если Не Источник.Ссылка.Пустая() Тогда
				Если Документы.СМ_АктВыполненныхРабот.НетОстатковПоАкту(Источник.Ссылка) Тогда
					Документы.СМ_АктВыполненныхРабот.ЗаполнитьОстаткиПоАкту(Источник.Ссылка,Источник.Стройка);
				КонецЕсли;
			КонецЕсли;
	    КонецЕсли;
		
		Узлы = ПланыОбмена.СМ_WS_Обмен.ПолучитьУзлы();
		Для Каждого Узел Из Узлы Цикл 
			РегистрироватьИзменение=Ложь;
			Если ТипЗнч(Источник)=Тип("СправочникОбъект.СМ_Ресурсы") И Узел.ВыгружатьНоменклатуру Тогда
				Если Узел.ВидыРесурсов.Количество()=0 или  Узел.ВидыРесурсов.НайтиСтроки(Новый Структура("ВидРесурса",Источник.Ссылка.ВидРесурса)).Количество()>0 Тогда
					РегистрироватьИзменение=Истина;
				КонецЕсли;
			ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.Организации") И Узел.ВыгружатьОрганизации Тогда
				РегистрироватьИзменение=Истина;
			ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.Контрагенты")   И Узел.ВыгружатьКонтрагентовИДоговоры Тогда
				Если Не Источник.ЭтоГруппа Тогда
					РегистрироватьИзменение=Истина;
				Конецесли;
			ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.ДоговорыКонтрагентов")  И Узел.ВыгружатьКонтрагентовИДоговоры Тогда
				РегистрироватьИзменение=Истина;
				ПланыОбмена.ЗарегистрироватьИзменения(Узел, Источник.Ссылка.Контрагент);
				ПланыОбмена.ЗарегистрироватьИзменения(Узел, Источник.Ссылка.Организация);
			ИначеЕсли ТипЗнч(Источник)=Тип("СправочникОбъект.СМ_ОбъектыСтроительства") И Узел.ВыгружатьОбъектыСтроительства Тогда
				Если Не Источник.ЭтоГруппа Тогда
					РегистрироватьИзменение=Истина;
				Конецесли;
			ИначеЕсли ТипЗнч(Источник)=Тип("ДокументОбъект.СМ_АктВыполненныхРабот") И Узел.ВыгружатьАкты Тогда
				Если Узел.ДатаНачалаВыгрузкиДокументов<=Источник.Дата Тогда
					РегистрироватьИзменение=Истина;
				КонецЕсли;
			КонецЕсли;
			Если РегистрироватьИзменение Тогда
				ПланыОбмена.ЗарегистрироватьИзменения(Узел, Источник.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Процедура регистрирует изменения по плану обмена СМ_WS_Обмен
//
// Параметры:
//   Источник 		- СправочникСсылка, ДокументСсылка - ссылка на источник изменений.
//	 Отказ			- Булево - статус отказа.	
//	 РежимЗаписи	- РежимЗаписиРегистра - Определяет режим добавления записей в регистр. 
//
Процедура СМ_WS_ОбменНаборЗаписейПриЗаписи(Источник, Отказ, РежимЗаписи) Экспорт 
	ИспользуетсяОбменПоWebСервису = ПолучитьФункциональнуюОпцию("СМ_WS_ИспользоватьИнтеграцию");
	Если ИспользуетсяОбменПоWebСервису Тогда
		Если Источник.ОбменДанными.Загрузка Тогда 
			Возврат;
		КонецЕсли;	
		Если Источник.Количество()=0 Тогда
			Возврат;
		Конецесли;
		Узлы = ПланыОбмена.СМ_WS_Обмен.ПолучитьУзлы();
		Для Каждого Узел Из Узлы Цикл 
			Если ((Узел.ВидыРесурсов.Количество() = 0 или Узел.ВидыРесурсов.НайтиСтроки(Новый Структура("ВидРесурса",Источник[0].Ресурс.ВидРесурса)).Количество()>0) И Источник[0].ТипЦен=Перечисления.СМ_ТипыЦен.Текущая) Тогда
				ПланыОбмена.ЗарегистрироватьИзменения(Узел, Источник);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Процедура выгружает АктВыполненныхРабот в хранилище значениц
//
// Параметры:
//   Акт 		- ДокументСсылка.СМ_АктВыполненныхРабот - ссылка на акт выполненных работ.
//	 Ответ		- Массив - массив содержащий сообщения по выгрузке.	
//
Процедура ВыгрузитьАкт(Акт,Ответ) Экспорт
	
	Ответ=Новый Массив;
	 
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	СМ_WS_Обмен.Ссылка КАК Узел,
	                    |	СМ_WS_Обмен.Код,
	                    |	КОЛИЧЕСТВО(ЕСТЬNULL(СМ_WS_ОбменВидыРесурсов.ВидРесурса, 0)) КАК КоличествоВидов
	                    |ПОМЕСТИТЬ Узлы
	                    |ИЗ
	                    |	ПланОбмена.СМ_WS_Обмен КАК СМ_WS_Обмен
	                    |		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.СМ_WS_Обмен.ВидыРесурсов КАК СМ_WS_ОбменВидыРесурсов
	                    |		ПО (СМ_WS_ОбменВидыРесурсов.Ссылка = СМ_WS_Обмен.Ссылка)
	                    |ГДЕ
	                    |	СМ_WS_Обмен.Ссылка <> &ТекущийУзел
	                    |	И СМ_WS_Обмен.ПометкаУдаления = ЛОЖЬ
	                    |
	                    |СГРУППИРОВАТЬ ПО
	                    |	СМ_WS_Обмен.Ссылка,
	                    |	СМ_WS_Обмен.Код
	                    |;
	                    |
	                    |////////////////////////////////////////////////////////////////////////////////
	                    |ВЫБРАТЬ
	                    |	ВТ.Ссылка КАК Акт,
	                    |	ВТ.Организация,
	                    |	ВТ.Стройка КАК Проект,
	                    |	ВТ.Номер,
	                    |	ВТ.Дата,
	                    |	ВТ.Проведен,
	                    |	ВТ.ПометкаУдаления
	                    |ПОМЕСТИТЬ СсылкаНаАкт
	                    |ИЗ
	                    |	Документ.СМ_АктВыполненныхРабот КАК ВТ
	                    |ГДЕ
	                    |	ВТ.Ссылка = &Акт
	                    |;
	                    |
	                    |////////////////////////////////////////////////////////////////////////////////
	                    |ВЫБРАТЬ
	                    |	Узлы.Узел,
	                    |	Узлы.Код,
	                    |	СсылкаНаАкт.Акт,
	                    |	СсылкаНаАкт.Организация,
	                    |	СсылкаНаАкт.Проект,
	                    |	СсылкаНаАкт.Номер,
	                    |	СсылкаНаАкт.Дата,
	                    |	СсылкаНаАкт.Проведен,
	                    |	СсылкаНаАкт.ПометкаУдаления,
	                    |	Узлы.КоличествоВидов
	                    |ПОМЕСТИТЬ АктыПоУзлам
	                    |ИЗ
	                    |	Узлы КАК Узлы,
	                    |	СсылкаНаАкт КАК СсылкаНаАкт
	                    |;
	                    |
	                    |////////////////////////////////////////////////////////////////////////////////
	                    |ВЫБРАТЬ
	                    |	АктыПоУзлам.Узел КАК Узел,
	                    |	АктыПоУзлам.Код,
	                    |	АктыПоУзлам.Акт,
	                    |	АктыПоУзлам.Организация,
	                    |	АктыПоУзлам.Проект,
	                    |	АктыПоУзлам.Номер,
	                    |	АктыПоУзлам.Дата,
	                    |	АктыПоУзлам.Проведен,
	                    |	АктыПоУзлам.ПометкаУдаления,
	                    |	МАКСИМУМ(ЕСТЬNULL(СМ_WS_СоответствиеОбъектов.GUID, """")) КАК GUID,
	                    |	МАКСИМУМ(ЕСТЬNULL(СМ_WS_СоответствиеОбъектовОрг.GUID, """")) КАК GUIDОрганизации,
	                    |	МАКСИМУМ(ЕСТЬNULL(СМ_WS_СоответствиеОбъектовПроект.GUID, """")) КАК GUIDПроекта
	                    |ИЗ
	                    |	АктыПоУзлам КАК АктыПоУзлам
	                    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_WS_СоответствиеОбъектов КАК СМ_WS_СоответствиеОбъектов
	                    |		ПО АктыПоУзлам.Акт = СМ_WS_СоответствиеОбъектов.Объект
	                    |			И АктыПоУзлам.Код = СМ_WS_СоответствиеОбъектов.ИдентификаторБазы
	                    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_WS_СоответствиеОбъектов КАК СМ_WS_СоответствиеОбъектовОрг
	                    |		ПО АктыПоУзлам.Организация = СМ_WS_СоответствиеОбъектовОрг.Объект
	                    |			И АктыПоУзлам.Код = СМ_WS_СоответствиеОбъектовОрг.ИдентификаторБазы
	                    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_WS_СоответствиеОбъектов КАК СМ_WS_СоответствиеОбъектовПроект
	                    |		ПО АктыПоУзлам.Проект = СМ_WS_СоответствиеОбъектовПроект.Объект
	                    |			И АктыПоУзлам.Код = СМ_WS_СоответствиеОбъектовПроект.ИдентификаторБазы
	                    |
	                    |СГРУППИРОВАТЬ ПО
	                    |	АктыПоУзлам.Узел,
	                    |	АктыПоУзлам.Код,
	                    |	АктыПоУзлам.Акт,
	                    |	АктыПоУзлам.Организация,
	                    |	АктыПоУзлам.Проект,
	                    |	АктыПоУзлам.Номер,
	                    |	АктыПоУзлам.Дата,
	                    |	АктыПоУзлам.Проведен,
	                    |	АктыПоУзлам.ПометкаУдаления
	                    |
	                    |УПОРЯДОЧИТЬ ПО
	                    |	Узел
	                    |;
	                    |
	                    |////////////////////////////////////////////////////////////////////////////////
	                    |ВЫБРАТЬ
	                    |	СМ_WS_ОбменВидыРесурсов.Ссылка,
	                    |	СМ_WS_ОбменВидыРесурсов.ВидРесурса
	                    |ПОМЕСТИТЬ ВидыРесурсов
	                    |ИЗ
	                    |	ПланОбмена.СМ_WS_Обмен.ВидыРесурсов КАК СМ_WS_ОбменВидыРесурсов
	                    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Узлы КАК Узлы
	                    |		ПО СМ_WS_ОбменВидыРесурсов.Ссылка = Узлы.Узел
	                    |;
	                    |
	                    |////////////////////////////////////////////////////////////////////////////////
	                    |ВЫБРАТЬ
	                    |	АктыПоУзлам.Узел,
	                    |	АктыПоУзлам.Код,
	                    |	АктыПоУзлам.Акт,
	                    |	СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ресурс,
	                    |	СМ_АктВыполненныхРаботРесурсыПозицийАкта.ВидРесурса,
	                    |	СМ_АктВыполненныхРаботРесурсыПозицийАкта.ФактРасходаОбъем,
	                    |	СМ_АктВыполненныхРаботРесурсыПозицийАкта.ЕдиницаИзмеренияРесурса,
	                    |	АктыПоУзлам.КоличествоВидов
	                    |ПОМЕСТИТЬ РесурсыАкта
	                    |ИЗ
	                    |	АктыПоУзлам КАК АктыПоУзлам
	                    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СМ_АктВыполненныхРабот.РесурсыПозицийАкта КАК СМ_АктВыполненныхРаботРесурсыПозицийАкта
	                    |		ПО АктыПоУзлам.Акт = СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ссылка
	                    |ГДЕ
	                    |	НЕ СМ_АктВыполненныхРаботРесурсыПозицийАкта.Удален
	                    |	И СМ_АктВыполненныхРаботРесурсыПозицийАкта.ФактРасходаОбъем > 0
	                    |;
	                    |
	                    |////////////////////////////////////////////////////////////////////////////////
	                    |ВЫБРАТЬ
	                    |	РесурсыАкта.Узел КАК Узел,
	                    |	РесурсыАкта.Код,
	                    |	РесурсыАкта.Акт,
	                    |	РесурсыАкта.Ресурс КАК Ресурс,
	                    |	РесурсыАкта.ФактРасходаОбъем КАК Количество,
	                    |	РесурсыАкта.ЕдиницаИзмеренияРесурса КАК ЕдиницаИзмерения,
	                    |	ВидыРесурсов.ВидРесурса КАК ВидРесурсаУзла,
	                    |	МАКСИМУМ(ЕСТЬNULL(СМ_WS_СоответствиеОбъектов.GUID, """")) КАК GUID,
	                    |	РесурсыАкта.Ресурс.Код КАК КодРесурса
	                    |ИЗ
	                    |	РесурсыАкта КАК РесурсыАкта
	                    |		ЛЕВОЕ СОЕДИНЕНИЕ ВидыРесурсов КАК ВидыРесурсов
	                    |		ПО РесурсыАкта.Узел = ВидыРесурсов.Ссылка
	                    |			И РесурсыАкта.ВидРесурса = ВидыРесурсов.ВидРесурса
	                    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_WS_СоответствиеОбъектов КАК СМ_WS_СоответствиеОбъектов
	                    |		ПО РесурсыАкта.Ресурс = СМ_WS_СоответствиеОбъектов.Объект
	                    |			И РесурсыАкта.Код = СМ_WS_СоответствиеОбъектов.ИдентификаторБазы
	                    |ГДЕ
	                    |	(НЕ ВидыРесурсов.ВидРесурса ЕСТЬ NULL 
	                    |			ИЛИ РесурсыАкта.КоличествоВидов = 0)
	                    |
	                    |СГРУППИРОВАТЬ ПО
	                    |	РесурсыАкта.Узел,
	                    |	РесурсыАкта.Код,
	                    |	РесурсыАкта.Акт,
	                    |	РесурсыАкта.Ресурс,
	                    |	РесурсыАкта.ФактРасходаОбъем,
	                    |	РесурсыАкта.ЕдиницаИзмеренияРесурса,
	                    |	ВидыРесурсов.ВидРесурса,
	                    |	РесурсыАкта.Ресурс.Код
	                    |
	                    |УПОРЯДОЧИТЬ ПО
	                    |	Узел,
	                    |	Ресурс");
						
						
	Запрос.УстановитьПараметр("Акт",Акт);
	Запрос.УстановитьПараметр("ТекущийУзел", ПланыОбмена.СМ_WS_Обмен.ЭтотУзел());
	Пакет=Запрос.ВыполнитьПакет();
	ДанныеАкта=Пакет[3].Выгрузить();
	РесурсыАкта=Пакет[6].Выгрузить();
	
	Если ДанныеАкта.Количество()=0 Тогда
			Ответ.Добавить(" Обмен не настроен, обратитесь к администратору. ");
		Возврат; 
	Конецесли;
	
	Для Каждого Эл Из ДанныеАкта Цикл
		Прокси=ПодключитьУзел(Эл.Узел);
		Если Прокси=Неопределено Тогда 
			Ответ.Добавить(" Нет подключения к сервису "+Эл.Код+", обратитесь к администратору" );
			Возврат; 
		КонецЕсли;

		Если Эл.GUIDОрганизации=""  Тогда
			Ответ.Добавить("Акт не выгружен. Не  сопоставлена организация "+Строка(Эл.Организация)+" на узле "+Эл.Код+", обратитесь к администратору" );
			Возврат; 
		КонецЕсли;	
		
		Если Эл.GUIDПроекта=""  Тогда
			Ответ.Добавить("Акт не выгружен. Не  сопоставлен проект "+Строка(Эл.Проект)+" на узле "+Эл.Код+", обратитесь к администратору" );
			Возврат; 
		КонецЕсли;	
		
		РесурсыУзла=РесурсыАкта.НайтиСтроки(Новый Структура("Узел",Эл.Узел));
		
		Если РесурсыУзла.Количество()=0 Тогда
			Ответ.Добавить("Акт не выгружен. Нет ресурсов для выгрузки  на узле "+Эл.Код);
			Возврат; 
		КонецЕсли;
		
		НеСопоставленные=РесурсыАкта.НайтиСтроки(Новый Структура("Узел,GUID",Эл.Узел,""));
		Для Каждого НеСп Из  НеСопоставленные Цикл
			// Получить гуид по коду с сервиса.
			Ст = Новый Структура;
			Ст.Вставить("КодРесурса",НеСп.КодРесурса);
			Ст.Вставить("Код",Эл.Код);
			Ст.Вставить("ТипОбъекта","GetAssetsGuid");
			ДляПередачи		= Новый ХранилищеЗначения(СТ);
			Хранилище		= Прокси.GetDataList(ДляПередачи);
			ДанныеХранилища	= Хранилище.Получить();
			Если ДанныеХранилища.Свойство("GUID") Тогда
				ЗаписатьСоответсвие(НеСп.Ресурс,Эл.Код,ДанныеХранилища.GUID, "СправочникСсылка.СМ_Ресурсы");
				НеСп.GUID = ДанныеХранилища.GUID;
			Иначе
				Ответ.Добавить("Акт не выгружен. Не сопоставлен ресурс с кодом "+НеСп.КодРесурса+" на узле "+Эл.Код+". Обратитесь к администратору.");
				Возврат;  
			КонецЕсли;
		КонецЦикла;

		СтАкт=ОбъектАкта();
		ЗаполнитьЗначенияСвойств(СтАкт.Объект,Эл);
		
		Для Каждого Рес Из РесурсыУзла Цикл
			Стр = СтАкт.Фабрика.Создать(СтАкт.ТипСтроки);
			Стр.GUID=Рес.GUID;
			Стр.Количество=Рес.Количество;
			Стр.ЕдиницаИзмерения=Рес.ЕдиницаИзмерения;
			СтАкт.Объект.Ресурсы.Добавить(Стр);
		КонецЦикла;
		
		СТ=Новый Структура;
		СТ.Вставить("GUID",Эл.GUID);	
		СТ.Вставить("Код",Эл.Код);
		СТ.Вставить("ДанныеОбъекта",ОбъектЦенАктаВСтроку(СтАкт));
		СТ.Вставить("ТипОбъекта","Act");

		ДляПередачи=Новый ХранилищеЗначения(СТ);
		Хранилище=Прокси.SetDataList(ДляПередачи);
		ДанныеХранилища=Хранилище.Получить();

		Если ДанныеХранилища.Свойство("Ошибка") Тогда
			Если Ответ=Неопределено Тогда
				Ответ=Новый Массив;
			КонецЕсли;
			Ответ.Добавить(ДанныеХранилища.Ошибка);
		КонецЕсли;
		
		Если ДанныеХранилища.GUID<>"" Тогда
		    ЗаписатьСоответсвие(Акт,Эл.Код,ДанныеХранилища.GUID, "ДокументСсылка.СМ_АктВыполненныхРабот");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Процедура загружает цены в АктВыполненныхРабот
//
// Параметры:
//   ОбъектАкта	- ДокументОбъект.СМ_АктВыполненныхРабот - акт выполненных работ.
//	 Ответ		- Массив - массив содержащий информационные сообщения.	
//
Процедура ЗагрузитьЦены(ОбъектАкта, Ответ) Экспорт
	
	Ответ=Новый Массив;
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	СМ_WS_Обмен.Ссылка КАК Узел,
	                    |	СМ_WS_Обмен.Код
	                    |ПОМЕСТИТЬ Узлы
	                    |ИЗ
	                    |	ПланОбмена.СМ_WS_Обмен КАК СМ_WS_Обмен
	                    |ГДЕ
	                    |	СМ_WS_Обмен.Ссылка <> &ТекущийУзел
	                    |	И СМ_WS_Обмен.ПометкаУдаления = ЛОЖЬ
	                    |;
	                    |
	                    |////////////////////////////////////////////////////////////////////////////////
	                    |ВЫБРАТЬ
	                    |	ВТ.Ссылка КАК Акт
	                    |ПОМЕСТИТЬ СсылкаНаАкт
	                    |ИЗ
	                    |	Документ.СМ_АктВыполненныхРабот КАК ВТ
	                    |ГДЕ
	                    |	ВТ.Ссылка = &Акт
	                    |;
	                    |
	                    |////////////////////////////////////////////////////////////////////////////////
	                    |ВЫБРАТЬ
	                    |	Узлы.Узел,
	                    |	Узлы.Код,
	                    |	СсылкаНаАкт.Акт
	                    |ПОМЕСТИТЬ АктыПоУзлам
	                    |ИЗ
	                    |	Узлы КАК Узлы,
	                    |	СсылкаНаАкт КАК СсылкаНаАкт
	                    |;
	                    |
	                    |////////////////////////////////////////////////////////////////////////////////
	                    |ВЫБРАТЬ
	                    |	АктыПоУзлам.Узел КАК Узел,
	                    |	АктыПоУзлам.Код,
	                    |	АктыПоУзлам.Акт,
	                    |	МАКСИМУМ(ЕСТЬNULL(СМ_WS_СоответствиеОбъектов.GUID, """")) КАК GUID
	                    |ИЗ
	                    |	АктыПоУзлам КАК АктыПоУзлам
	                    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_WS_СоответствиеОбъектов КАК СМ_WS_СоответствиеОбъектов
	                    |		ПО АктыПоУзлам.Акт = СМ_WS_СоответствиеОбъектов.Объект
	                    |			И АктыПоУзлам.Код = СМ_WS_СоответствиеОбъектов.ИдентификаторБазы
	                    |
	                    |СГРУППИРОВАТЬ ПО
	                    |	АктыПоУзлам.Узел,
	                    |	АктыПоУзлам.Код,
	                    |	АктыПоУзлам.Акт
	                    |
	                    |УПОРЯДОЧИТЬ ПО
	                    |	Узел");		
	
    Запрос.УстановитьПараметр("Акт",ОбъектАкта.Ссылка);
	Запрос.УстановитьПараметр("ТекущийУзел", ПланыОбмена.СМ_WS_Обмен.ЭтотУзел());
	Пакет=Запрос.Выполнить();
	ДанныеАкта=Пакет.Выгрузить();
	
	Если ДанныеАкта.Количество()=0 Тогда
			Ответ.Добавить(" Обмен не настроен, обратитесь к администратору. ");
		Возврат; 
	Конецесли;
	
	Для Каждого Эл Из ДанныеАкта Цикл
		
		Прокси=ПодключитьУзел(Эл.Узел);
		Если Прокси=Неопределено Тогда 
			Ответ.Добавить(" Нет подключения к сервису "+Эл.Код+", обратитесь к администратору" );
			Возврат; 
		КонецЕсли;

		Если Эл.GUID=""  Тогда
			Ответ.Добавить("Акт не выгружен на узле "+Эл.Код+", перед загрузкой цен, необходимо выгрузить акт." );
			Возврат; 
		КонецЕсли;	
		
		 Ст=Новый Структура;
		 Ст.Вставить("GUID",Эл.GUID);
		 Ст.Вставить("Код",Эл.Код);
		 Ст.Вставить("ТипОбъекта","ActionForAct");
		 ДляПередачи=Новый ХранилищеЗначения(СТ);
		 Хранилище=Прокси.GetDataList(ДляПередачи);
		 ДопДанныеХранилища=Хранилище.Получить();
		 Если ДопДанныеХранилища.Таблица.Количество()=0 Тогда
			 Ответ.Добавить("Нет данных по ценам на узле "+Эл.Код+"." );
			 Возврат;
		 КонецЕсли;
				
		 ЗаполнитьЦеныАкта(Эл.Узел,ОбъектАкта,ДопДанныеХранилища.Таблица[0].ДанныеОбъекта,Ответ);

	КонецЦикла;

КонецПроцедуры

// Процедура выполняет обмен данными
//
// Параметры:
//   Акты	- Массив - содержит сслыки на акта выполненных работ.
//	 Ответ	- Массив - массив содержащий информационные сообщения.	
//
Процедура СМ_WS_ВыполнитьОбмен(Акты=Неопределено,Ответ=Неопределено) Экспорт
	
	ИспользуетсяОбменПоWebСервису = ПолучитьФункциональнуюОпцию("СМ_WS_ИспользоватьИнтеграцию");
	Если Не ИспользуетсяОбменПоWebСервису Тогда
		Возврат;
	КонецЕсли;
	
	Узлы = ПланыОбмена.СМ_WS_Обмен.ПолучитьУзлы();
	Для Каждого Узел Из Узлы Цикл 
		Прокси=ПодключитьУзел(Узел);
		Если Прокси=Неопределено Тогда 
			Если Ответ=Неопределено Тогда
				Ответ=Новый Массив;
			КонецЕсли;
			Ответ.Добавить(" Нет подключения к сервису");
			Продолжить; 
		КонецЕсли;
		Если Акты=Неопределено Тогда
			Если Узел.ВыгружатьОрганизации Тогда
				ВыгрузитьСправочник(Узел,Прокси,"Организации");
			КонецЕсли;
			Если Узел.ВыгружатьКонтрагентовИДоговоры Тогда
				ВыгрузитьСправочник(Узел,Прокси,"Контрагенты"," НЕ ВТ.Ссылка.ЭтоГруппа");
				ВыгрузитьСправочник(Узел,Прокси,"ДоговорыКонтрагентов");
			КонецЕсли;
			Если Узел.ВыгружатьОбъектыСтроительства Тогда
				ВыгрузитьСправочник(Узел,Прокси,"СМ_ОбъектыСтроительства");
			КонецЕсли;
			Если Узел.ВыгружатьНоменклатуру Тогда
				ВыгрузитьСправочник(Узел,Прокси,"СМ_Ресурсы"," НЕ ВТ.Ссылка.ЭтоГруппа");
			КонецЕсли;	
			Если Узел.ВыгружатьЦеныРесурсов Тогда
				ВыгрузитьЦены(Узел, Прокси);
			КонецЕсли;
			Если Узел.ВыгружатьАкты Тогда
				ВыгрузитьАкты(Узел, Прокси);
			КонецЕсли;
			
			ЗагрузитьСправочники(Узел,Прокси);
			
			ЗагрузитьОстатки(Узел,Прокси);
		Иначе
			ВыгрузитьАкты(Узел, Прокси,Акты, Ответ);
		Конецесли;	
	КонецЦикла;
	
КонецПроцедуры

// Процедура выполняет выгрузку ресурса
//
// Параметры:
//   Ресурс	- СправочникСсылка.СМ_Ресурсы - ресурс.
//	 Ответ	- Массив - массив содержащий информационные сообщения.	
//
Процедура СМ_WS_ВыгрузитьНовыйРесурс(Ресурс,Ответ=Неопределено) Экспорт
	
	ИспользуетсяОбменПоWebСервису = ПолучитьФункциональнуюОпцию("СМ_WS_ИспользоватьИнтеграцию");
	Если Не ИспользуетсяОбменПоWebСервису Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектРесурсаСтрока = ОбъектРесурсаВСтроку(Ресурс);
	
	Узлы = ПланыОбмена.СМ_WS_Обмен.ПолучитьУзлы();
	Для Каждого Узел Из Узлы Цикл 
		Прокси=ПодключитьУзел(Узел);
		Если Прокси=Неопределено Тогда 
			Если Ответ=Неопределено Тогда
				Ответ=Новый Массив;
			КонецЕсли;
			Ответ.Добавить("Нет подключения к сервису");
			Продолжить; 
		КонецЕсли;
		Прокси.SetNewResource(ОбъектРесурсаСтрока);
	КонецЦикла;
КонецПроцедуры

// Функция выполняет загрузку справочников
//
// Параметры:
//   Узел	- ПланОбменаСсылка.СМ_WS_Обмен - ссылка на узел плана обмена.
//	 Прокси	- WSПрокси - прокси для обращения к внешнему Web-сервису.	
//
// Возвращаемое значение:
// 	 Число - статус выполнения.
//
Функция ЗагрузитьСправочники(Узел,Прокси) Экспорт
	
	Хранилище=Прокси.GetDataList(Новый ХранилищеЗначения(Новый Структура("ТипОбъекта,Код","Code",Узел.Код)));
	ДанныеХранилища=Хранилище.Получить();
	НомерСообщения=ДанныеХранилища.НомерПринятого;
	Если НомерСообщения=-1 Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Обмен по web сервисам.Загрузка'"), УровеньЖурналаРегистрации.Ошибка, , ,НСтр("ru = 'Не найден узел в базе обмена'"));	
		Возврат 0;
	КонецЕсли;	
	
	ПередачаНеЗавершена=Истина;
	СтДляПередачи=Новый Структура("ТипОбъекта,Код,НомерСообщения,СтартНм,СтартТип","Download",Узел.Код,НомерСообщения,"","");
	Пока ПередачаНеЗавершена Цикл
		ДляПередачи=Новый ХранилищеЗначения(СтДляПередачи);	
		Хранилище=Прокси.GetDataList(ДляПередачи);
		ДанныеХранилища=Хранилище.Получить();
		
		Если ДанныеХранилища.Таблица.Количество()=0 Тогда
			ПередачаНеЗавершена=Ложь;
			Прервать;
		КонецЕсли;	
		Для Каждого Эл Из ДанныеХранилища.Таблица Цикл
			СтДляПередачи.СтартНм=Эл.GUID;
			СтДляПередачи.СтартТип=Эл.ТипОбъекта;
			Если Эл.ТипОбъекта="СправочникСсылка.СМ_Ресурсы" Тогда
				
				ОбъектВыгрузки=ЗаполнитьНоменклатуру(Узел,Эл.GUID,Эл.ДанныеОбъекта);
				Попытка
					ОбъектВыгрузки.ОбменДанными.Загрузка=Истина;
					ОбъектВыгрузки.Записать();
				Исключение
					
				КонецПопытки;
				
			ИначеЕсли Эл.ТипОбъекта="СправочникСсылка.Организации" Тогда
				ОбъектВыгрузки=ЗаполнитьОрганизацию(Узел,Эл.GUID,Эл.ДанныеОбъекта);
				Попытка
					ОбъектВыгрузки.ОбменДанными.Загрузка=Истина;
					ОбъектВыгрузки.Записать();
				Исключение
					
				КонецПопытки;
			ИначеЕсли Эл.ТипОбъекта="СправочникСсылка.Контрагенты" Тогда
				
				ОбъектВыгрузки=ЗаполнитьКонтрагента(Узел,Эл.GUID,Эл.ДанныеОбъекта);
				Попытка
					ОбъектВыгрузки.ОбменДанными.Загрузка=Истина;
					ОбъектВыгрузки.Записать();
				Исключение
					
				КонецПопытки;
			ИначеЕсли Эл.ТипОбъекта="СправочникСсылка.ДоговорыКонтрагентов" Тогда
				
				ОбъектВыгрузки=ЗаполнитьДоговор(Узел,Эл.GUID,Эл.ДанныеОбъекта);
				Попытка
					ОбъектВыгрузки.ОбменДанными.Загрузка=Истина;
					ОбъектВыгрузки.Записать();
				Исключение
					
				КонецПопытки;
			ИначеЕсли Эл.ТипОбъекта="СправочникСсылка.СМ_ОбъектыСтроительства" Тогда
				
				ОбъектВыгрузки=ЗаполнитьПроект(Узел,Эл.GUID,Эл.ДанныеОбъекта);
				Попытка
					ОбъектВыгрузки.ОбменДанными.Загрузка=Истина;
					ОбъектВыгрузки.Записать();
				Исключение
					
				КонецПопытки;		
			КонецЕсли;	
			
		КонецЦикла;
			
	КонецЦикла;
	
	Возврат 1;
	
КонецФункции

// Функция выполняет загрузку остатков
//
// Параметры:
//   Узел	- ПланОбменаСсылка.СМ_WS_Обмен - ссылка на узел плана обмена.
//	 Прокси	- WSПрокси - прокси для обращения к внешнему Web-сервису.	
//
// Возвращаемое значение:
// 	 Число - статус выполнения.
//
Функция ЗагрузитьОстатки(Узел,Прокси) Экспорт
	
	Хранилище=Прокси.GetDataList(Новый ХранилищеЗначения(Новый Структура("ТипОбъекта,Код","AssetsForAct",Узел.Код)));
	ДанныеХранилища=Хранилище.Получить();
	
	Код=Узел.Код;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ДанныеХранилища.Таблица[0].ДанныеОбъекта);
	Схема=ПолучитьСхемуОстатки();
	ЧтениеСхемыXML = Новый ЧтениеXML;
	ЧтениеСхемыXML.УстановитьСтроку(Схема);
	ПостроительDOM = Новый ПостроительDOM;
	ДокументДом = ПостроительDOM.Прочитать(ЧтениеСхемыXML);
	ПостроительСхем=новый ПостроительСхемXML;
	Схема=ПостроительСхем.СоздатьСхемуXML(ДокументДом);
	НаборСхем=Новый наборСхемXMl;
	НаборСхем.Добавить(Схема);
	
	
	Фабрика=Новый ФабрикаXDTO(НаборСхем);
	Юри="ericos";
	ТипОбъекта = Фабрика.Тип(Юри,"Остатки");	
	ДанныеПоОбмену=Фабрика.ПрочитатьXML(ЧтениеXML,ТипОбъекта);
	
	Набор=РегистрыСведений.СМ_WS_БуферЗагрузки.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторБазы.Установить(Код); 
	Набор.Отбор.ТипОбъекта.Установить("balance");
	Набор.Записать();
	
	Для Каждого Эл Из ДанныеПоОбмену.ТаблицаОстатки Цикл
		Запись=РегистрыСведений.СМ_WS_БуферЗагрузки.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторБазы=Код;
		Запись.Ресурс=ПолучитьСоответствиеПоGUID(Узел,Эл.GUID);
		Запись.GUID=Эл.GUID;
		Запись.ТипОбъекта="balance";
		Запись.GUIDПроекта=Эл.GUIDПроекта;
		
		Запись.ОбъектСтроительства=ПолучитьСоответствиеПоGUID(Узел,Эл.GUIDПроекта);
		Запись.ПредставлениеОбъекта1=Эл.Код;
		Запись.ПредставлениеОбъекта=Эл.Наименование;
		Запись.ЧисловойПараметр1=Эл.Количество;
		запись.Записать();
	КонецЦикла;
	
	Возврат 1;
	
КонецФункции

// Функция выполняет загрузку остатков
//
// Параметры:
//   Узел		- ПланОбменаСсылка.СМ_WS_Обмен - ссылка на узел плана обмена.
//	 GUID		- УникальныйИдентификатор - уникальный идентификатор элемента справочника.
//	 ТипОбъекта - Строка - вид загружаемого справочника.
//
// Возвращаемое значение:
// 	 Число - статус выполнения.
//
Функция СоздатьЭлементСправочника(Узел,GUID,ТипОбъекта) Экспорт
	
	Запись						= РегистрыСведений.СМ_WS_БуферЗагрузки.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторБазы 	= Узел.Код;
	Запись.GUID					= GUID;
	//Запись.Пользователь		= ПараметрыСеанса.ТекущийПользователь;
	Запись.Пользователь			= ПользователиКлиентСервер.ТекущийПользователь();	
	Запись.ТипОбъекта			= ТипОбъекта;
	Запись.Прочитать();
	
	Если ТипОбъекта="AssetsList" Тогда
		
		ОбъектВыгрузки=ЗаполнитьНоменклатуру(Узел,GUID,Запись.ДанныеОбъекта);
		Попытка
			ОбъектВыгрузки.ОбменДанными.Загрузка=Истина;
			ОбъектВыгрузки.Записать();
		Исключение
			
		КонецПопытки;
		
	ИначеЕсли ТипОбъекта="OrgList" Тогда
		ОбъектВыгрузки=ЗаполнитьОрганизацию(Узел,GUID,Запись.ДанныеОбъекта);
		Попытка
			ОбъектВыгрузки.ОбменДанными.Загрузка=Истина;
			ОбъектВыгрузки.Записать();
		Исключение
			
		КонецПопытки;
	ИначеЕсли ТипОбъекта="PartnerList" Тогда
		
		ОбъектВыгрузки=ЗаполнитьКонтрагента(Узел,GUID,Запись.ДанныеОбъекта);
		Попытка
			ОбъектВыгрузки.ОбменДанными.Загрузка=Истина;
			ОбъектВыгрузки.Записать();
		Исключение
			
		КонецПопытки;
	ИначеЕсли ТипОбъекта="ContractList" Тогда
		
		ОбъектВыгрузки=ЗаполнитьДоговор(Узел,GUID,Запись.ДанныеОбъекта);
		Попытка
			ОбъектВыгрузки.ОбменДанными.Загрузка=Истина;
			ОбъектВыгрузки.Записать();
		Исключение
			
		КонецПопытки;
	ИначеЕсли ТипОбъекта="BuildList" Тогда
		
		ОбъектВыгрузки=ЗаполнитьПроект(Узел,GUID,Запись.ДанныеОбъекта);
		Попытка
			ОбъектВыгрузки.ОбменДанными.Загрузка=Истина;
			ОбъектВыгрузки.Записать();
		Исключение
			
		КонецПопытки;		
	КонецЕсли;	
	
	Возврат 0;	
	
КонецФункции

// Функция выполняет подключение узла плана обмена
//
// Параметры:
//   Узел	- ПланОбменаСсылка.СМ_WS_Обмен - ссылка на узел плана обмена.
//
// Возвращаемое значение:
// 	 WSПрокси - прокси для обращения к внешнему Web-сервису.
//
Функция ПодключитьУзел(Узел) Экспорт
	
	Попытка
		Определения = Новый WSОпределения("http://"+Узел.URL+"/ws/wsbp.1cws?wsdl", Узел.Пользователь, Узел.Пароль);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Обмен по web сервисам.Выгрузка'"), УровеньЖурналаРегистрации.Ошибка, , ,СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось подключится к узлу %1'"), ОписаниеОшибки()));
		Возврат Неопределено;
	КонецПопытки;
	Попытка
		Прокси = Новый WSПрокси(Определения, "BP_WS_DataIntegration", "BP_WS_DataIntegration", "BP_WS_DataIntegrationSoap");
		Прокси.Пользователь=Узел.Пользователь;
		Прокси.Пароль=Узел.Пароль;
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Обмен по web сервисам.Выгрузка'"), УровеньЖурналаРегистрации.Ошибка, , ,СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось подключится к узлу %1'"), ОписаниеОшибки()));
		
		Возврат Неопределено;
		
	КонецПопытки;
	
	Возврат Прокси;
	
КонецФункции

// Функция выполняет выгрузку справочника
//
// Параметры:
//   Узел			- ПланОбменаСсылка.СМ_WS_Обмен - ссылка на узел плана обмена.
//	 Прокси			- WSПрокси - прокси для обращения к внешнему Web-сервису.
//	 ТипСправочника - Строка - вид справочника.
//	 ДопУсловие		- Строка - содержание дополнительного условия. 
//
// Возвращаемое значение:
// 	 Неопределено - не возвращает значения.
//
Функция ВыгрузитьСправочник(Узел,Прокси,ТипСправочника,ДопУсловие="Истина") Экспорт
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	|	ВТ.Ссылка,
	|	МАКСИМУМ(ЕСТЬNULL(СМ_WS_СоответствиеОбъектов.GUID, """")) КАК GUID
	|ИЗ
	|	Справочник.СМ_Ресурсы.Изменения КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_WS_СоответствиеОбъектов КАК СМ_WS_СоответствиеОбъектов
	|		ПО ВТ.Ссылка = СМ_WS_СоответствиеОбъектов.Объект
	|			И ВТ.Узел.Код = СМ_WS_СоответствиеОбъектов.ИдентификаторБазы
	|ГДЕ
	|	ВТ.Узел = &Узел
	|	И &ДопУсловие 
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Ссылка");
	
	Запрос.Текст=СТрЗаменить(Запрос.Текст,"СМ_Ресурсы",ТипСправочника);	
	Запрос.Текст=СТрЗаменить(Запрос.Текст,"&ДопУсловие",ДопУсловие);
	Запрос.УстановитьПараметр("Узел",Узел);
	Рез=Запрос.Выполнить().Выбрать();
	Пока Рез.Следующий() Цикл
		СТ=Новый Структура;
		СТ.Вставить("GUID",Рез.GUID);	
		СТ.Вставить("ДанныеОбъекта",ОбъектВСтроку(Рез.Ссылка,Ст,Узел));
		
		ДляПередачи=Новый ХранилищеЗначения(СТ);
		Хранилище=Прокси.SetDataList(ДляПередачи);
		ДанныеХранилища=Хранилище.Получить();
		Если ДанныеХранилища.Таблица.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;	
		
		Для Каждого Эл Из  ДанныеХранилища.Таблица Цикл
			Если СТ.GUID="" Тогда
				ЗаписатьСоответсвие(Эл.Ссылка,Узел.Код,Эл.GUID, Ст.ТипОбъекта);
			КонецЕсли;
			ПланыОбмена.УдалитьРегистрациюИзменений(Узел, Рез.Ссылка);
		КонецЦикла;
		
	КонецЦикла;
	
КонецФункции

// Функция выполняет выгрузку цен
//
// Параметры:
//   Узел			- ПланОбменаСсылка.СМ_WS_Обмен - ссылка на узел плана обмена.
//	 Прокси			- WSПрокси - прокси для обращения к внешнему Web-сервису.
//
// Возвращаемое значение:
// 	 Неопределено - не возвращает значения.
//
Функция ВыгрузитьЦены(Узел, Прокси) Экспорт
	
	Запрос=Новый Запрос( "ВЫБРАТЬ
	|	СМ_СметныеЦеныРесурсовИзменения.Узел,
	|	СМ_СметныеЦеныРесурсовИзменения.НомерСообщения,
	|	СМ_СметныеЦеныРесурсовИзменения.Период КАК Период,
	|	СМ_СметныеЦеныРесурсовИзменения.Ресурс,
	|	СМ_СметныеЦеныРесурсовИзменения.СметноНормативнаяБаза,
	|	СМ_СметныеЦеныРесурсовИзменения.Район,
	|	СМ_СметныеЦеныРесурсовИзменения.ТипЦен,
	|	СМ_СметныеЦеныРесурсов.СметнаяЦена,
	|	МАКСИМУМ(ЕСТЬNULL(СМ_WS_СоответствиеОбъектов.GUID,"""")) КАК GUID
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрСведений.СМ_СметныеЦеныРесурсов.Изменения КАК СМ_СметныеЦеныРесурсовИзменения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СметныеЦеныРесурсов КАК СМ_СметныеЦеныРесурсов
	|		ПО СМ_СметныеЦеныРесурсовИзменения.Период = СМ_СметныеЦеныРесурсов.Период
	|			И СМ_СметныеЦеныРесурсовИзменения.Ресурс = СМ_СметныеЦеныРесурсов.Ресурс
	|			И СМ_СметныеЦеныРесурсовИзменения.СметноНормативнаяБаза = СМ_СметныеЦеныРесурсов.СметноНормативнаяБаза
	|			И СМ_СметныеЦеныРесурсовИзменения.Район = СМ_СметныеЦеныРесурсов.Район
	|			И СМ_СметныеЦеныРесурсовИзменения.ТипЦен = СМ_СметныеЦеныРесурсов.ТипЦен
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_WS_СоответствиеОбъектов КАК СМ_WS_СоответствиеОбъектов
	|		ПО СМ_СметныеЦеныРесурсовИзменения.Ресурс = СМ_WS_СоответствиеОбъектов.Объект
	|			И СМ_СметныеЦеныРесурсовИзменения.Узел.Код = СМ_WS_СоответствиеОбъектов.ИдентификаторБазы
	|ГДЕ
	|	СМ_СметныеЦеныРесурсовИзменения.Узел = &Узел
	|
	|СГРУППИРОВАТЬ ПО
	|	СМ_СметныеЦеныРесурсовИзменения.Узел,
	|	СМ_СметныеЦеныРесурсовИзменения.НомерСообщения,
	|	СМ_СметныеЦеныРесурсовИзменения.Период,
	|	СМ_СметныеЦеныРесурсовИзменения.Ресурс,
	|	СМ_СметныеЦеныРесурсовИзменения.СметноНормативнаяБаза,
	|	СМ_СметныеЦеныРесурсовИзменения.Район,
	|	СМ_СметныеЦеныРесурсовИзменения.ТипЦен,
	|	СМ_СметныеЦеныРесурсов.СметнаяЦена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Ресурс,
	|	ВТ.СметнаяЦена,
	|	ВТ.GUID,
	|	ВТ.Период КАК Период,
	|	ВТ.ТипЦен,
	|	ВТ.Район,
	|	ВТ.СметноНормативнаяБаза
	|ИЗ
	|	ВТ КАК ВТ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Период,
	|	ВТ.Ресурс,
	|	ВТ.СметнаяЦена,
	|	ВТ.GUID,
	|	ВТ.ТипЦен,
	|	ВТ.Район,
	|	ВТ.СметноНормативнаяБаза
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период
	|ИТОГИ ПО
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Ресурс
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	ВТ.GUID ЕСТЬ NULL 
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Ресурс");
	Запрос.УстановитьПараметр("Узел",Узел);
	Пакет=Запрос.ВыполнитьПакет();
	Ресурсы=Пакет[2].Выбрать();
	Цены=Пакет[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Ресурсы.Следующий() Цикл
		СТ=Новый Структура;
		СТ.Вставить("GUID","");	
		СТ.Вставить("ДанныеОбъекта",ОбъектВСтроку(Ресурсы.Ресурс,Ст,Узел));
		
		ДляПередачи=Новый ХранилищеЗначения(СТ);
		Хранилище=Прокси.SetDataList(ДляПередачи);
		ДанныеХранилища=Хранилище.Получить();
		Если ДанныеХранилища.Таблица.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;	
		
		Для Каждого Эл Из  ДанныеХранилища.Таблица Цикл
			Если СТ.GUID="" Тогда
				ЗаписатьСоответсвие(Ресурсы.Ресурс,Узел.Код,Эл.GUID, Ст.ТипОбъекта);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	
	ТекПериод=Неопределено;
	СтЦен=ОбъектЦен();
	
	Пока Цены.Следующий() Цикл
		ЦеныПоПериоду = Цены.Выбрать();
		Пока ЦеныПоПериоду.Следующий() Цикл
			 		
			Стр = СтЦен.Фабрика.Создать(СтЦен.ТипЦены);
			Стр.Период=Цены.Период;
			Стр.GUID=?(ЦеныПоПериоду.GUID="",ПолучитьСоответствие(Узел,ЦеныПоПериоду.Ресурс),ЦеныПоПериоду.GUID);
			Стр.Цена=ЦеныПоПериоду.СметнаяЦена;
			СтЦен.Объект.Цены.Добавить(Стр);
				
		КонецЦикла;
		СТ=Новый Структура;
		СТ.Вставить("GUID","");	
		СТ.Вставить("Код",Узел.Код);
		СТ.Вставить("ДанныеОбъекта",ОбъектЦенАктаВСтроку(СтЦен));
		СТ.Вставить("ТипОбъекта","ДокументСсылка.УстановкаЦенНоменклатуры");
		СтЦен.Объект.Цены.Очистить();	  
		
		ДляПередачи=Новый ХранилищеЗначения(СТ);
		Хранилище=Прокси.SetDataList(ДляПередачи);
		ДанныеХранилища=Хранилище.Получить();
		Если ДанныеХранилища.Таблица.Количество()=0 Тогда
			//Набор.Очистить();
			Продолжить;
		КонецЕсли;
		ЦеныПоПериоду.Сбросить();
		Пока ЦеныПоПериоду.Следующий() Цикл
			Набор=РегистрыСведений.СМ_СметныеЦеныРесурсов.СоздатьНаборЗаписей();
			Набор.Отбор.Ресурс.Установить(ЦеныПоПериоду.Ресурс);
			Набор.Отбор.СметноНормативнаяБаза.Установить(ЦеныПоПериоду.СметноНормативнаяБаза);
			Набор.Отбор.Район.Установить(ЦеныПоПериоду.Район);
			Набор.Отбор.ТипЦен.Установить(ЦеныПоПериоду.ТипЦен);
			Набор.Отбор.Период.Установить(ЦеныПоПериоду.Период);
			Набор.Прочитать();
			
			ПланыОбмена.УдалитьРегистрациюИзменений(Узел,Набор);
		КонецЦикла;
	КонецЦикла;
	
КонецФункции

// Функция выполняет выгрузку актов выполненных работ
//
// Параметры:
//   Узел			- ПланОбменаСсылка.СМ_WS_Обмен - ссылка на узел плана обмена.
//	 Прокси			- WSПрокси - прокси для обращения к внешнему Web-сервису.
//	 АктыКВыгрузке	- Неопределено, ДокументСсылка.СМ_АктВыполненныхРабот - ссылка на выгружаемый акт
//	 Ответ			- Неопределено, Массив - массив содержащий информационные сообщения.	
//
// Возвращаемое значение:
// 	 Неопределено - не возвращает значения.
//
Функция ВыгрузитьАкты(Узел, Прокси, АктыКВыгрузке=Неопределено, Ответ=Неопределено) Экспорт
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	|	ВТ.Ссылка,
	|	МАКСИМУМ(ЕСТЬNULL(СМ_WS_СоответствиеОбъектов.GUID, """")) КАК GUID,
	|	&Узел
	|ПОМЕСТИТЬ ВтАкты
	|ИЗ
	|	Документ.СМ_АктВыполненныхРабот.Изменения КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_WS_СоответствиеОбъектов КАК СМ_WS_СоответствиеОбъектов
	|		ПО ВТ.Ссылка = СМ_WS_СоответствиеОбъектов.Объект
	|			И (&КодУзла = СМ_WS_СоответствиеОбъектов.ИдентификаторБазы)
	|ГДЕ
	|	ВТ.Узел = &Узел
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ресурс,
	|	СМ_АктВыполненныхРаботРесурсыПозицийАкта.ФактРасходаОбъем,
	|	СМ_АктВыполненныхРаботРесурсыПозицийАкта.ЕдиницаИзмеренияРесурса,
	|	МАКСИМУМ(ЕСТЬNULL(СМ_WS_СоответствиеОбъектов.GUID, """")) КАК GUID,
	|	ВтАкты.Ссылка,
	|	СМ_WS_ОбменВидыРесурсов.ВидРесурса
	|ПОМЕСТИТЬ Ресурсы
	|ИЗ
	|	Документ.СМ_АктВыполненныхРабот.РесурсыПозицийАкта КАК СМ_АктВыполненныхРаботРесурсыПозицийАкта
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтАкты КАК ВтАкты
	|		ПО СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ссылка = ВтАкты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_WS_СоответствиеОбъектов КАК СМ_WS_СоответствиеОбъектов
	|		ПО СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ресурс = СМ_WS_СоответствиеОбъектов.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.СМ_WS_Обмен.ВидыРесурсов КАК СМ_WS_ОбменВидыРесурсов
	|		ПО СМ_АктВыполненныхРаботРесурсыПозицийАкта.ВидРесурса = СМ_WS_ОбменВидыРесурсов.ВидРесурса
	|ГДЕ
	|	НЕ СМ_АктВыполненныхРаботРесурсыПозицийАкта.Удален
	|	И (&ОграничениеПоВиду
	|			ИЛИ НЕ СМ_WS_ОбменВидыРесурсов.ВидРесурса ЕСТЬ NULL )
	|   И  СМ_АктВыполненныхРаботРесурсыПозицийАкта.ФактРасходаОбъем>0
	|СГРУППИРОВАТЬ ПО
	|	СМ_АктВыполненныхРаботРесурсыПозицийАкта.Ресурс,
	|	СМ_АктВыполненныхРаботРесурсыПозицийАкта.ФактРасходаОбъем,
	|	СМ_АктВыполненныхРаботРесурсыПозицийАкта.ЕдиницаИзмеренияРесурса,
	|	ВтАкты.Ссылка,
	|	СМ_WS_ОбменВидыРесурсов.ВидРесурса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ресурсы.Ссылка
	|ПОМЕСТИТЬ АктыНеВыгружаются
	|ИЗ
	|	Ресурсы КАК Ресурсы
	|ГДЕ
	|	Ресурсы.GUID = """"
	|
	|СГРУППИРОВАТЬ ПО
	|	Ресурсы.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_АктВыполненныхРабот.Ссылка,
	|	СМ_АктВыполненныхРабот.Номер,
	|	СМ_АктВыполненныхРабот.Дата,
	|	СМ_АктВыполненныхРабот.Проведен,
	|	СМ_АктВыполненныхРабот.Организация,
	|	МАКСИМУМ(ЕСТЬNULL(СМ_WS_СоответствиеОбъектовОрг.GUID, """")) КАК GUIDОрганизации,
	|	МАКСИМУМ(ЕСТЬNULL(СМ_WS_СоответствиеОбъектов.GUID, """")) КАК GUID,
	|	СМ_АктВыполненныхРабот.ПометкаУдаления,
	|	СМ_АктВыполненныхРабот.Стройка КАК Проект,
	|	МАКСИМУМ(ЕСТЬNULL(СМ_WS_СоответствиеОбъектовПроект.GUID, """")) КАК GUIDПроекта
	|ИЗ
	|	ВтАкты КАК ВтАкты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СМ_АктВыполненныхРабот КАК СМ_АктВыполненныхРабот
	|		ПО ВтАкты.Ссылка = СМ_АктВыполненныхРабот.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_WS_СоответствиеОбъектов КАК СМ_WS_СоответствиеОбъектов
	|		ПО (СМ_АктВыполненныхРабот.Ссылка = СМ_WS_СоответствиеОбъектов.Объект)
	|			И (&КодУзла = СМ_WS_СоответствиеОбъектов.ИдентификаторБазы)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_WS_СоответствиеОбъектов КАК СМ_WS_СоответствиеОбъектовОрг
	|		ПО (СМ_АктВыполненныхРабот.Организация = СМ_WS_СоответствиеОбъектовОрг.Объект)
	|			И (&КодУзла = СМ_WS_СоответствиеОбъектов.ИдентификаторБазы)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_WS_СоответствиеОбъектов КАК СМ_WS_СоответствиеОбъектовПроект
	|		ПО (СМ_АктВыполненныхРабот.Стройка = СМ_WS_СоответствиеОбъектовПроект.Объект)
	|			И (&КодУзла = СМ_WS_СоответствиеОбъектов.ИдентификаторБазы)
	|ГДЕ
	|	НЕ ВтАкты.Ссылка В
	|				(ВЫБРАТЬ
	|					АктыНеВыгружаются.Ссылка
	|				ИЗ
	|					АктыНеВыгружаются)
	|
	|СГРУППИРОВАТЬ ПО
	|	СМ_АктВыполненныхРабот.Ссылка,
	|	СМ_АктВыполненныхРабот.Номер,
	|	СМ_АктВыполненныхРабот.Дата,
	|	СМ_АктВыполненныхРабот.Проведен,
	|	СМ_АктВыполненныхРабот.Организация,
	|	СМ_АктВыполненныхРабот.ПометкаУдаления,
	|	СМ_АктВыполненныхРабот.Стройка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ресурсы.Ресурс,
	|	Ресурсы.ФактРасходаОбъем КАК Количество,
	|	Ресурсы.ЕдиницаИзмеренияРесурса КАК ЕдиницаИзмерения,
	|	Ресурсы.GUID,
	|	Ресурсы.Ссылка
	|ИЗ
	|	Ресурсы КАК Ресурсы
	|ГДЕ
	|	НЕ Ресурсы.Ссылка В
	|				(ВЫБРАТЬ
	|					АктыНеВыгружаются.Ссылка
	|				ИЗ
	|					АктыНеВыгружаются)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ресурсы.Ресурс,
	|	Ресурсы.ФактРасходаОбъем КАК Количество,
	|	Ресурсы.Ссылка,
	|	Ресурсы.Ресурс.Наименование КАК Наименование
	|ИЗ
	|	Ресурсы КАК Ресурсы
	|ГДЕ
	|	Ресурсы.GUID = """"");
	
	
	Если АктыКВыгрузке<>Неопределено Тогда
		Запрос.Текст=СтрЗаменить(СтрЗаменить(Запрос.Текст,"ВТ.Узел = &Узел","ВТ.Ссылка = &Ссылка"),".Изменения","");
		Запрос.УстановитьПараметр("Ссылка",АктыКВыгрузке);
	КонецЕсли;
	
	
	
	Запрос.УстановитьПараметр("Узел",Узел);
	Запрос.УстановитьПараметр("КодУзла",Узел.Код);
	Запрос.УстановитьПараметр("ОграничениеПоВиду",Узел.ВидыРесурсов.Количество()=0);
	
	Пакет=Запрос.ВыполнитьПакет();
	Акты=Пакет[3].Выбрать();
	
	Если Акты.Количество()=0 Тогда
		Если Ответ=Неопределено Тогда
			Ответ=Новый Массив;
		КонецЕсли;
		Рез=Пакет[5].Выгрузить();
		Если Рез.Количество()=0 Тогда
			Ответ.Добавить(" Акт не выгружен. Не ресурсов для выгрузки");
		Иначе
			Для Каждого Рес Из Рез Цикл
				Ответ.Добавить(" Акт не выгружен. Не сопоставлен ресурс "+Рес.Наименование);
			КонецЦикла;
		Конецесли;
		Возврат Ложь;
	КонецЕсли;
	
	
	Ресурсы=Пакет[4].Выгрузить();
	
	СтАкт=ОбъектАкта();
	
	Пока  Акты.Следующий() Цикл
		

		ЗаполнитьЗначенияСвойств(СтАкт.Объект,Акты);
		
		РесурсыАкта=Ресурсы.НайтиСтроки(Новый Структура("Ссылка",Акты.Ссылка));
		
		Для Каждого Эл Из РесурсыАкта Цикл		   
			
			Стр = СтАкт.Фабрика.Создать(СтАкт.ТипСтроки);
			Стр.GUID=Эл.GUID;
			Стр.Количество=Эл.Количество;
			Стр.ЕдиницаИзмерения=Эл.ЕдиницаИзмерения;
			СтАкт.Объект.Ресурсы.Добавить(Стр);
		КонецЦикла;
		
		
		
		СТ=Новый Структура;
		СТ.Вставить("GUID",Акты.GUID);	
		СТ.Вставить("Код",Узел.Код);
		СТ.Вставить("ДанныеОбъекта",ОбъектЦенАктаВСтроку(СтАкт));
		СТ.Вставить("ТипОбъекта","ДокументСсылка.СписаниеТоваров");
		СтАкт.Объект.Ресурсы.Очистить();	  
		
		ДляПередачи=Новый ХранилищеЗначения(СТ);
		Хранилище=Прокси.SetDataList(ДляПередачи);
		ДанныеХранилища=Хранилище.Получить();
		
		Если ДанныеХранилища.Свойство("Ошибка") Тогда
			Если Ответ=Неопределено Тогда
				Ответ=Новый Массив;
			КонецЕсли;
			Ответ.Добавить(ДанныеХранилища.Ошибка);
		КонецЕсли;
		
		Если ДанныеХранилища.Таблица.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДопСтр=новый Структура;
		ДопСтр.Вставить("GUID","");
		ДопСтр.Вставить("ТипОбъекта","ActionForAct");
		ДопСтр.Вставить("Код",Узел.Код);
		
		Для Каждого Эл Из  ДанныеХранилища.Таблица Цикл
			Если СТ.GUID="" Тогда
				ЗаписатьСоответсвие(Акты.Ссылка,Узел.Код,Эл.GUID, Ст.ТипОбъекта);
			КонецЕсли;

			
			Если АктыКВыгрузке=Неопределено Тогда
				ПланыОбмена.УдалитьРегистрациюИзменений(Узел, Акты.Ссылка);
				
				ДопСтр.GUID=Эл.GUID;
				ДопХранилище=Прокси.GetDataList(Новый ХранилищеЗначения(ДопСтр));
				ДопДанныеХранилища=ДопХранилище.Получить();
				Если ДопДанныеХранилища.Таблица.Количество()=0 Тогда
					Продолжить;
				КонецЕсли;
				
				ЗаполнитьЦеныАкта(Узел,Акты.Ссылка,ДопДанныеХранилища.Таблица[0].ДанныеОбъекта,Ответ);
			КонецЕсли;
		КонецЦикла;    	  
		
	КонецЦикла;		
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбъектВСтроку(Источник,Ст,Узел)
	
	Схема="";	
	Если ТипЗнч(Источник)=Тип("СправочникСсылка.СМ_Ресурсы") Тогда
		СТ.Вставить("ТипОбъекта","СправочникСсылка.СМ_Ресурсы");
		Схема=ПолучитьСхемуРесурса();
		ТипСхемы="Ресурс";
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникСсылка.Организации") Тогда
		СТ.Вставить("ТипОбъекта","СправочникСсылка.Организации");
		Схема=ПолучитьСхемуОрганизации();
		ТипСхемы="Организация";
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникСсылка.Контрагенты") Тогда
		СТ.Вставить("ТипОбъекта","СправочникСсылка.Контрагенты");
		Схема=ПолучитьСхемуКонтрагента();
		ТипСхемы="Контрагент";
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		СТ.Вставить("ТипОбъекта","СправочникСсылка.ДоговорыКонтрагентов");
		Схема=ПолучитьСхемуДоговора();
		ТипСхемы="Договор";
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникСсылка.СМ_ОбъектыСтроительства") Тогда
		СТ.Вставить("ТипОбъекта","СправочникСсылка.СМ_ОбъектыСтроительства");
		Схема=ПолучитьСхемуОбъектаСтроительства();
		ТипСхемы="ОбъектСтроительства";
	КонецЕсли;
	
	
	ЧтениеСхемыXML = Новый ЧтениеXML;
	ЧтениеСхемыXML.УстановитьСтроку(Схема);
	ПостроительDOM = Новый ПостроительDOM;
	ДокументДом = ПостроительDOM.Прочитать(ЧтениеСхемыXML);
	ПостроительСхем=новый ПостроительСхемXML;
	Схема=ПостроительСхем.СоздатьСхемуXML(ДокументДом);
	НаборСхем=Новый НаборСхемXMl;
	НаборСхем.Добавить(Схема);
	Фабрика=Новый ФабрикаXDTO(НаборСхем);
	Юри="ericos";
	ТипОбъекта = Фабрика.Тип(Юри,ТипСхемы);	
	
	
	Об = Фабрика.Создать(ТипОбъекта);
	Если ТипЗнч(Источник)=Тип("СправочникСсылка.СМ_Ресурсы") Тогда
		ДополнитьДанныеРесурса(Об,Источник.Ссылка,Юри,Фабрика);
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникСсылка.Организации") Тогда
		ДополнитьДанныеОрганизации(Об,Источник.Ссылка,Юри,Фабрика);
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникСсылка.Контрагенты") Тогда
		ДополнитьДанныеКонтрагента(Об,Источник.Ссылка,Юри,Фабрика);	
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда		
		ДополнитьДанныеДоговора(Об,Источник,Юри,Фабрика,Узел);
	ИначеЕсли ТипЗнч(Источник)=Тип("СправочникСсылка.СМ_ОбъектыСтроительства") Тогда		
		ДополнитьДанныеОбъектаСтроительства(Об,Источник,Юри,Фабрика,Узел);
		
	КонецЕсли;
	
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку(); 
	Фабрика.ЗаписатьXML(Запись, Об);
	ДанныеXML = Запись.Закрыть();
	Возврат ДанныеXML;
	
	
КонецФункции

