Функция СоздатьНайтиЕдиницуИзмерения(Единица)
	Эл=Неопределено;
	Если Единица.КодОКЕИ<>"" Тогда
		Эл=Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоРеквизиту("КодОКЕИ",Единица.КодОКЕИ);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Эл) Тогда
		Эл=Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоНаименованию(Единица.Наименование);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Эл) Тогда
		Эл=Справочники.СМ_ЕдиницыИзмеренияСмета.СоздатьЭлемент();
		Эл.Наименование=Единица.Наименование;
		Эл.КодОКЕИ=Единица.КодОКЕИ;
		Эл.УстановитьНовыйКод();
		Эл.Записать();
	КонецЕсли;
	Возврат Эл.Ссылка;
КонецФункции

