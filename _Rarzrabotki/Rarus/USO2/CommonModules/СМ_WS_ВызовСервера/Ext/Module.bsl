#Область ПолучениеСоответствий

Функция ПолучитьСоответствие(Узел,Источник)
	Запрос=новый Запрос( "ВЫБРАТЬ
	|	СМ_WS_СоответствиеОбъектов.GUID
	|ИЗ
	|	РегистрСведений.СМ_WS_СоответствиеОбъектов КАК СМ_WS_СоответствиеОбъектов
	|ГДЕ
	|	СМ_WS_СоответствиеОбъектов.Объект = &Объект
	|	И СМ_WS_СоответствиеОбъектов.ИдентификаторБазы = &ИдентификаторБазы");
	Запрос.УстановитьПараметр("Объект",Источник);						 
	Запрос.УстановитьПараметр("ИдентификаторБазы",Узел.Код);
	рез=Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() тогда
		Возврат Рез.GUID;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ПолучитьСоответствиеПоGUID(Узел,GUID)
	Запрос=новый Запрос( "ВЫБРАТЬ
	|	СМ_WS_СоответствиеОбъектов.Объект
	|ИЗ
	|	РегистрСведений.СМ_WS_СоответствиеОбъектов КАК СМ_WS_СоответствиеОбъектов
	|ГДЕ
	|	СМ_WS_СоответствиеОбъектов.GUID = &GUID
	|	И СМ_WS_СоответствиеОбъектов.ИдентификаторБазы = &ИдентификаторБазы");
	Запрос.УстановитьПараметр("GUID",Лев(GUID,50));						 
	Запрос.УстановитьПараметр("ИдентификаторБазы",Узел.Код);
	рез=Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() тогда
		Возврат Рез.Объект;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ЗаписатьСоответсвие(СсылкаНаОбъект,КодУзла,GUID, ТипОбъекта)
	Запись=РегистрыСведений.СМ_WS_СоответствиеОбъектов.СоздатьМенеджерЗаписи();
	Запись.Объект=СсылкаНаОбъект;
	Запись.ИдентификаторБазы=КодУзла;
	Запись.GUID=GUID;
	Запись.GUIDОбъектаТекущейбазы=СсылкаНаОбъект.УникальныйИдентификатор();
	Запись.ТипОбъекта=ТипОбъекта;
	Запись.Дата=ТекущаяДата();
	Запись.Записать();
КОнецПроцедуры

