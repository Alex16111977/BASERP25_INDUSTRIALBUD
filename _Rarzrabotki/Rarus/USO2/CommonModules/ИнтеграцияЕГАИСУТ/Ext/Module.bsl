#КонецОбласти

#Область РасчетСтатусаОформления

Функция СтруктураРеквизитыРасчетаСтатусаОформления()
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Проведен");
	Реквизиты.Вставить("Дата");
	Реквизиты.Вставить("Номер");
	Реквизиты.Вставить("Ответственный");
	Реквизиты.Вставить("ТорговыйОбъект");
	Реквизиты.Вставить("Контрагент");
	
	Возврат Реквизиты;
	
КонецФункции

// Функция возвращает текст запроса статуса оформления по шаблону
//
// Параметры:
//  ИменаДокументов              - Массив,Строка - имена документов которые могут быть введены по документу-основанию
//  ИмяДокументаОснования        - Строка - имя документа-основания
//  ТабличнаяЧасть               - Строка - табличная часть документа-основания (источник товаров), из списка:
//   * ТоварыСерии (по умолчанию)
//   * Товары
//   * Шапка
//  ДополнительноеУсловие        - Строка - дополнительное условие отбора по документу-основанию
//  ПересчитыватьНемаркированную - Булево - необходимость пересчета с единиц ЕГАИС (для входящей ТТН)
// Возвращаемое значение:
//  Строка - текст запроса статуса оформления
//
Функция ТекстЗапросаСтатусаОформления(ИменаДокументов, ИмяДокументаОснования, ТабличнаяЧасть = "ТоварыСерии", ДополнительноеУсловие = "", ПересчитыватьНемаркированную = Ложь)
	
	Если ТипЗнч(ИменаДокументов) = Тип("Строка")Тогда
		ИменаДокументов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИменаДокументов);
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	
	//Оформленные документы
	Шаблон = ШаблонОформленныеДокументы(Ложь);
	Для Каждого ИмяДокумента Из ИменаДокументов Цикл
		МассивСтрок.Добавить(СтрШаблон(Шаблон,ИмяДокумента));
	КонецЦикла;
	
	//ТЧ прикладного документа
	Шаблон = ШаблонТоварыПрикладногоДокумента(ТабличнаяЧасть);
	МассивСтрок.Добавить(СтрШаблон(Шаблон,ИмяДокументаОснования,ДополнительноеУсловие));
	
	//ТЧ оформленных документов
	Шаблон = ШаблонОформленныеТовары(ПересчитыватьНемаркированную);
	Для Каждого ИмяДокумента Из ИменаДокументов Цикл
		МассивСтрок.Добавить(СтрШаблон(Шаблон,ИмяДокумента));
	КонецЦикла;
	
	//Сумма и итоговый статус
	Шаблон = ШаблонИтогоТовары();
	МассивСтрок.Добавить(Шаблон);
	Шаблон = ШаблонСтатус();
	МассивСтрок.Добавить(Шаблон);
	
	Возврат СтрСоединить(МассивСтрок);
	
КонецФункции

// Функция возвращает текст запроса статуса оформления (документы Регистра 2, без прикладной номенклатуры) по шаблону
//
// Параметры:
//  ИмяДокумента                 - Строка - имя документа ЕГАИС по регистру2
//  ИмяДокументаОснования        - Строка - имя документа-основания
//  ПересчитыватьНемаркированную - Булево - необходимость пересчета с единиц ЕГАИС (для входящей ТТН)
// Возвращаемое значение:
//  Строка - текст запроса статуса оформления
//
Функция ТекстЗапросаСтатусаОформленияДляРегистра2(ИмяДокумента, ИмяДокументаОснования, ПересчитыватьНемаркированную = Ложь)
	
	МассивСтрок = Новый Массив;
	
	//Оформленные документы
	Шаблон = ШаблонОформленныеДокументы(Ложь);
	МассивСтрок.Добавить(СтрШаблон(Шаблон,ИмяДокумента));
	
	//Алкогольная продукция
	Шаблон = ШаблонИтогоАлкогольнойПродукции(ПересчитыватьНемаркированную);
	МассивСтрок.Добавить(СтрШаблон(Шаблон,ИмяДокументаОснования,ИмяДокумента));
	
	//Итоговый статус
	Шаблон = ШаблонСтатус();
	МассивСтрок.Добавить(Шаблон);
	
	Возврат СтрСоединить(МассивСтрок);
	
КонецФункции

#Область ТТНВходящаяЕГАИС

Функция ЗапросСтатусаОформленияПередачаВРегистр2ЕГАИСНаОснованииТТНВходящаяЕГАИС()
	
	ТекстЗапроса = ТекстЗапросаСтатусаОформленияДляРегистра2("ПередачаВРегистр2ЕГАИС", "ТТНВходящаяЕГАИС", Истина);
	//Модификация поля Количество входящей ТТН
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"	Товары.Количество",
		"	ВЫБОР
		|		КОГДА Товары.Ссылка.ЕстьРасхождения
		|			ТОГДА Товары.КоличествоФакт
		|		ИНАЧЕ Товары.Количество
		|	КОНЕЦ");
	Возврат Новый Запрос(ТекстЗапроса);
	
