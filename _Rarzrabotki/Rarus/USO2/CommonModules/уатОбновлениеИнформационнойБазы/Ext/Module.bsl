// Процедура выполняет обновление настройки "ЗапретПроведенияПЛприНаличииИстекшихДокументов"
// в связи с расширением функционала.
//
Процедура ОбновитьНастройкиЗапретаПроведенияПЛ_2_0_9_2() Экспорт 
	
	// Обновление настройки "ЗапретПроведенияПЛприНаличииИстекшихДокументов".
	НовыйЭлемент = ПланыВидовХарактеристик.уатПраваИНастройки.ЗапретПроведенияПЛприНаличииИстекшихДокументов;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Код",          НовыйЭлемент.Код);
	Запрос.УстановитьПараметр("Наименование", Лев(НовыйЭлемент.Наименование, 60) + "%");
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	уатПраваИНастройки.Объект КАК Объект,
	|	уатПраваИНастройки.ПравоНастройка КАК ПравоНастройка,
	|	уатПраваИНастройки.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.уатПраваИНастройки КАК уатПраваИНастройки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.уатПраваИНастройки КАК ПВХ_ПраваИНастройки
	|		ПО уатПраваИНастройки.ПравоНастройка = ПВХ_ПраваИНастройки.Ссылка
	|			И (ПВХ_ПраваИНастройки.Код = &Код)
	|			И (НЕ ПВХ_ПраваИНастройки.Предопределенный)
	|			И (ТИПЗНАЧЕНИЯ(уатПраваИНастройки.Значение) = ТИП(БУЛЕВО))
	|			И (ПВХ_ПраваИНастройки.Наименование ПОДОБНО &Наименование)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		НаборЗаписей = РегистрыСведений.уатПраваИНастройки.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Установить(Выборка.Объект);
		НаборЗаписей.Отбор.ПравоНастройка.Установить(НовыйЭлемент);
		
		Если Выборка.Значение Тогда 
			НовЗначение = Перечисления.уатВидыКонтроля.Запрещать;
		Иначе 
			НовЗначение = Перечисления.уатВидыКонтроля.Разрешать;
		КонецЕсли;
		
		Запись = НаборЗаписей.Добавить();
		Запись.Объект         = Выборка.Объект;
		Запись.ПравоНастройка = НовыйЭлемент;
		Запись.Значение       = НовЗначение;
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей, Истина);
		
		НаборЗаписей = РегистрыСведений.уатПраваИНастройки.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Установить(Выборка.Объект);
		НаборЗаписей.Отбор.ПравоНастройка.Установить(Выборка.ПравоНастройка);
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей, Истина);
	КонецЦикла;
	
КонецПроцедуры

// Процедура выполняет актуализацию настроек периодичности загрузки Wialon.
//
Процедура ОбновитьПериодичностьХраненияДанныхWialon_2_0_9_3() Экспорт 
	
	Если Не Константы.уатИспользоватьWialon.Получить() Тогда 
		Возврат;
	КонецЕсли;
	
	ПараметрыWialon = Константы.уатПараметрыРеглЗаданияЗагрузкаДанныхWialon.Получить().Получить();
	Если ПараметрыWialon = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если Не ПараметрыWialon.Свойство("ИнтервалЗагрузки") Тогда 
		ПараметрыWialon.Вставить("ИнтервалЗагрузки", "Сутки");
	КонецЕсли;
	Если Не ПараметрыWialon.Свойство("ПериодичностьХранения") Тогда
		ПараметрыWialon.Вставить("ПериодичностьХранения", 60);
	КонецЕсли;
	
	НастройкиИзменены = Ложь;
	
	Если Не (ПараметрыWialon.ИнтервалЗагрузки = "Неделя"
			Или ПараметрыWialon.ИнтервалЗагрузки = "Сутки" 
			Или ПараметрыWialon.ИнтервалЗагрузки = "12часов" 
			Или ПараметрыWialon.ИнтервалЗагрузки = "Час") Тогда 
		НастройкиИзменены = Истина;
		ПараметрыWialon.ИнтервалЗагрузки = "Сутки";
	КонецЕсли;
	
	Если ПараметрыWialon.ПериодичностьХранения < 60 Тогда 
		НастройкиИзменены = Истина;
		ПараметрыWialon.ПериодичностьХранения = 60;
	КонецЕсли;
	
	Если НастройкиИзменены Тогда 
		Константы.уатПараметрыРеглЗаданияЗагрузкаДанныхWialon.Установить(Новый ХранилищеЗначения(ПараметрыWialon, Новый СжатиеДанных(9)));
	КонецЕсли;
	
КонецПроцедуры

