// Процедура выполняет перенос настроек формирования наименований агрегатов из константы
// "УдалитьУатНастройкаФормированияНаименованийАгрегатов" в константу "уатНастройкиШаблонов".
//
Процедура ПеренестиХранениеНастройкиФормированияНаименованийАгрегатов_2_0_9_5() Экспорт 
	
	ТаблицаНастроек = Константы.УдалитьУатНастройкаФормированияНаименованийАгрегатов.Получить().Получить();
	Если ТаблицаНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаНастроек.Сортировать("ТипАгрегата, Номер");
	
	ТабПодготовка = Новый ТаблицаЗначений();
	ТабПодготовка.Колонки.Добавить("ТипАгрегата",  Новый ОписаниеТипов("СправочникСсылка.уатТипыАгрегатов"));
	ТабПодготовка.Колонки.Добавить("ТекстШаблона", Новый ОписаниеТипов("Строка"));
	
	Для Каждого ТекСтрока Из ТаблицаНастроек Цикл 
		СтрокаШаблона = ТабПодготовка.Найти(ТекСтрока.ТипАгрегата, "ТипАгрегата");
		Если СтрокаШаблона = Неопределено Тогда 
			СтрокаШаблона = ТабПодготовка.Добавить();
			СтрокаШаблона.ТипАгрегата = ТекСтрока.ТипАгрегата;
		КонецЕсли;
		
		СтрокаШаблона.ТекстШаблона = СтрокаШаблона.ТекстШаблона + ТекСтрока.Поле;
	КонецЦикла;
	
	ДанныеШаблоновУзловОбъектовЭксплуатации = Новый Соответствие();
	Для Каждого ТекСтрока Из ТабПодготовка Цикл 
		ДанныеШаблоновУзловОбъектовЭксплуатации.Вставить(ТекСтрока.ТипАгрегата, ТекСтрока.ТекстШаблона);
	КонецЦикла;
	
	ХранилищеШаблонов = Константы.уатНастройкиШаблонов.Получить();
	Если ХранилищеШаблонов = Неопределено Тогда 
		НастройкиШаблонов = Неопределено;
	Иначе 
		НастройкиШаблонов = ХранилищеШаблонов.Получить();
	КонецЕсли;
	
	Если НастройкиШаблонов = Неопределено Тогда 
		НастройкиШаблонов = Новый Структура();
	КонецЕсли;
	
	НастройкиШаблонов.Вставить("Справочник_УзлыОбъектовЭксплуатации", ДанныеШаблоновУзловОбъектовЭксплуатации);
	
	Константы.уатНастройкиШаблонов.Установить(Новый ХранилищеЗначения(НастройкиШаблонов, Новый СжатиеДанных(9)))
	
КонецПроцедуры

