// Процедура выполняет перенос данных из помеченного на удаление регистра
// "УдалитьУатМестоположениеПоGPS" в "уатПробегРасходПоМониторингу".
//
Процедура ПеренестиМестоположениеПоGPS_2_0_10_4() Экспорт 
	
	Запрос = Новый Запрос();
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УдалитьУатМестоположениеПоGPS.Период КАК Период,
	|	УдалитьУатМестоположениеПоGPS.ТС КАК ТС,
	|	УдалитьУатМестоположениеПоGPS.ЗначениеОдометра КАК ЗначениеОдометра,
	|	УдалитьУатМестоположениеПоGPS.ЗначениеСчетчикаМоточасов КАК ЗначениеСчетчикаМоточасов,
	|	УдалитьУатМестоположениеПоGPS.ПотребленноеТопливо КАК ПотребленноеТопливо,
	|	УдалитьУатМестоположениеПоGPS.УровеньТоплива КАК УровеньТоплива
	|ИЗ
	|	РегистрСведений.УдалитьУатМестоположениеПоGPS КАК УдалитьУатМестоположениеПоGPS
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период
	|ИТОГИ ПО
	|	ТС";
	
	НаборЗаписей = РегистрыСведений.уатПробегРасходПоМониторингу.СоздатьНаборЗаписей();
	
	ВыборкаТС = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаТС.Следующий() Цикл 
		ПредОдометр             = 0;
		ПредСчетчикМоточасов    = 0;
		ПредПотребленноеТопливо = 0;
		
		Выборка = ВыборкаТС.Выбрать();
		Пока Выборка.Следующий() Цикл 
			Запись = НаборЗаписей.Добавить();
			Запись.Период = Выборка.Период;
			Запись.ТС = Выборка.ТС;
			
			Запись.Пробег = Выборка.ЗначениеОдометра - ПредОдометр;
			Запись.ВремяРаботыДвигателя = Выборка.ЗначениеСчетчикаМоточасов - ПредСчетчикМоточасов;
			Запись.РасходТоплива = Выборка.ПотребленноеТопливо - ПредПотребленноеТопливо;
			Запись.УровеньТоплива = Выборка.УровеньТоплива;
			
			ПредОдометр             = Выборка.ЗначениеОдометра;
			ПредСчетчикМоточасов    = Выборка.ЗначениеСчетчикаМоточасов;
			ПредПотребленноеТопливо = Выборка.ПотребленноеТопливо;
		КонецЦикла;
	КонецЦикла;
	
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей, Истина);
	
	НаборУдаления = РегистрыСведений.УдалитьУатМестоположениеПоGPS.СоздатьНаборЗаписей();
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборУдаления, Истина);
	
КонецПроцедуры

