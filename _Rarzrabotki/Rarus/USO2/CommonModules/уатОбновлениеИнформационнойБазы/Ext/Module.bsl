// Процедура заполняет измерения Организация и Подразделение регистра накопления Остатки ГСМ на ТС по данным регистраторов
//
Процедура ОбновитьРегистрыОстаткиГСМТЖнаТС_2_0_9_8() Экспорт
	ТекДата = ТекущаяДата();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	уатОстаткиГСМнаТСОбороты.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.уатОстаткиГСМнаТС.Обороты(, , Регистратор, ) КАК уатОстаткиГСМнаТСОбороты
	|ГДЕ
	|	НЕ уатОстаткиГСМнаТСОбороты.Регистратор ССЫЛКА Документ.КорректировкаРегистров");
	мсвРегистраторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
	
	НЗ = РегистрыНакопления.уатОстаткиГСМнаТС.СоздатьНаборЗаписей();
	Для Каждого ТекРегистратор Из мсвРегистраторы Цикл
		НЗ.Отбор.Регистратор.Установить(ТекРегистратор);
		НЗ.Прочитать();
		флЗаписать = Ложь;
		
		Для Каждого ТекЗапись Из НЗ Цикл
			Если НЕ ЗначениеЗаполнено(ТекЗапись.Организация) Тогда //заполняем только когда не заполнена Организация
				Если ТекЗапись.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
					ТекЗапись.Организация = ТекРегистратор.Организация;
					Если ТипЗнч(ТекРегистратор) = Тип("ДокументСсылка.уатЗаправкаГСМ") Тогда
						ТекЗапись.Подразделение = ТекРегистратор.ПодразделениеОрганизации;
					ИначеЕсли ТипЗнч(ТекРегистратор) = Тип("ДокументСсылка.уатСливГСМ") Тогда
						ТекЗапись.Подразделение = ТекРегистратор.ПутевойЛистПриемник.Подразделение;
					Иначе
						ТекЗапись.Подразделение = ТекРегистратор.Подразделение;
					КонецЕсли;
				Иначе
					Если ЗначениеЗаполнено(ТекЗапись.Партия) Тогда //заполняем из партии
						ТекЗапись.Организация = ТекЗапись.Партия.Организация;
						Если ТипЗнч(ТекЗапись.Партия) = Тип("ДокументСсылка.уатЗаправкаГСМ") Тогда
							ТекЗапись.Подразделение = ТекЗапись.Партия.ПодразделениеОрганизации;
						ИначеЕсли ТипЗнч(ТекЗапись.Партия) = Тип("ДокументСсылка.уатСливГСМ") Тогда
							ТекЗапись.Подразделение = ТекЗапись.Партия.ПутевойЛистПриемник.Подразделение;
						Иначе
							ТекЗапись.Подразделение = ТекЗапись.Партия.Подразделение;
						КонецЕсли;
					Иначе //заполняем из текущего местонахождения
						МестонахождениеТС = уатОбщегоНазначения.МестонахождениеТС(ТекЗапись.ТС, ТекДата, Ложь);
						ТекЗапись.Организация = МестонахождениеТС.Организация;
						ТекЗапись.Подразделение = МестонахождениеТС.Подразделение;
					КонецЕсли;
				КонецЕсли;
								
				флЗаписать = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если флЗаписать Тогда
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НЗ);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	уатОстаткиТЖнаТСОбороты.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.уатОстаткиТЖнаТС.Обороты(, , Регистратор, ) КАК уатОстаткиТЖнаТСОбороты
	|ГДЕ
	|	НЕ уатОстаткиТЖнаТСОбороты.Регистратор ССЫЛКА Документ.КорректировкаРегистров");
	мсвРегистраторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
	
	НЗ = РегистрыНакопления.уатОстаткиТЖнаТС.СоздатьНаборЗаписей();
	Для Каждого ТекРегистратор Из мсвРегистраторы Цикл
		НЗ.Отбор.Регистратор.Установить(ТекРегистратор);
		НЗ.Прочитать();
		флЗаписать = Ложь;
		
		Для Каждого ТекЗапись Из НЗ Цикл
			Если НЕ ЗначениеЗаполнено(ТекЗапись.Организация) Тогда //заполняем только когда не заполнена Организация
				Если ЗначениеЗаполнено(ТекЗапись.Партия) Тогда //заполняем из партии
					Если ТекЗапись.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
						ТекЗапись.Организация = ТекРегистратор.Организация;
						Если ТипЗнч(ТекРегистратор) = Тип("ДокументСсылка.уатЗаправкаГСМ") Тогда
							ТекЗапись.Подразделение = ТекРегистратор.ПодразделениеОрганизации;
						Иначе
							ТекЗапись.Подразделение = ТекРегистратор.Подразделение;
						КонецЕсли;
						
					Иначе
						ТекЗапись.Организация = ТекЗапись.Партия.Организация;
						Если ТипЗнч(ТекЗапись.Партия) = Тип("ДокументСсылка.уатЗаправкаГСМ") Тогда
							ТекЗапись.Подразделение = ТекЗапись.Партия.ПодразделениеОрганизации;
						Иначе
							ТекЗапись.Подразделение = ТекЗапись.Партия.Подразделение;
						КонецЕсли;
						
					КонецЕсли;
					
				Иначе //заполняем из текущего местонахождения
					МестонахождениеТС = уатОбщегоНазначения.МестонахождениеТС(ТекЗапись.ТС, ТекДата, Ложь);
					ТекЗапись.Организация = МестонахождениеТС.Организация;
					ТекЗапись.Подразделение = МестонахождениеТС.Подразделение;
					
				КонецЕсли;
				
				флЗаписать = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если флЗаписать Тогда
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НЗ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

