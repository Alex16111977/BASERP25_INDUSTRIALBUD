
#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОбщуюПлощадьПоОбъектуНедвижимости(ОбъектНедвижимости, Период = '00010101') Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", ?(ЗначениеЗаполнено(Период), КонецДня(Период), Период));
	Запрос.УстановитьПараметр("ОбъектНедвижимости", ОбъектНедвижимости);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПлощадиОбъектовНедвижимости.ОбщаяПлощадь
	|ИЗ
	|	РегистрСведений.УПН_ПлощадиОбъектовНедвижимости.СрезПоследних(&Период, ОбъектНедвижимости = &ОбъектНедвижимости) КАК ПлощадиОбъектовНедвижимости";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ОбщаяПлощадь;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьЦенуПоОбъектуНедвижимости(ОбъектНедвижимости,ВидЦены,ТипОперации,Валюта, Период = '00010101') Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", ?(ЗначениеЗаполнено(Период), КонецДня(Период), Период));
	Запрос.УстановитьПараметр("ОбъектНедвижимости", ОбъектНедвижимости);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Запрос.УстановитьПараметр("ТипОперации", ТипОперации);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПН_ЦеныОбъектовНедвижимостиСрезПоследних.ЦенаЗаЕдиницуПлощади КАК ЦенаЗаЕдиницуПлощади
	|ИЗ
	|	РегистрСведений.УПН_ЦеныОбъектовНедвижимости.СрезПоследних(
	|			&Период,
	|			ОбъектНедвижимости = &ОбъектНедвижимости
	|				И ТипОперации = &ТипОперации
	|				И ВидЦены = &ВидЦены
	|				И Валюта = &Валюта) КАК УПН_ЦеныОбъектовНедвижимостиСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЦенаЗаЕдиницуПлощади;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

Процедура УПН_ОбщиеПроцедуры(Источник, ДанныеЗаполнения, СтандартнаяОбработка) Экспорт

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УПН_РасторжениеСделкиПоНедвижимости")
		И ТипЗнч(Источник) = Тип("ДокументОбъект.СписаниеЗадолженности") Тогда
		
		Источник.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СписаниеКредиторскойЗадолженности;
		Источник.Организация		= ДанныеЗаполнения.Организация;
		Источник.Контрагент = ДанныеЗаполнения.Контрагент;
		
		Для Каждого ТекСтрока Из ДанныеЗаполнения.ОбъектыНедвижимости Цикл
			
			Если НЕ ТекСтрока.Санкции Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Источник.Задолженность.Добавить();
			НоваяСтрока.ТипРасчетов 			= Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом;
			НоваяСтрока.Партнер					= ДанныеЗаполнения.Партнер;
			НоваяСтрока.Заказ 					= ДанныеЗаполнения.Договор;
			НоваяСтрока.Сумма 					= ТекСтрока.Санкции;
			НоваяСтрока.ВалютаВзаиморасчетов 	= ДанныеЗаполнения.Договор.ВалютаВзаиморасчетов;
			
		КонецЦикла;
		
	КонецЕсли;			
	
КонецПроцедуры

#КонецОбласти