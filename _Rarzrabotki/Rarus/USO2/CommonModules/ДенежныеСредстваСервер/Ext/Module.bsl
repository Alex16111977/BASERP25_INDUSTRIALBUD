	Запрос.УстановитьПараметр("Ссылка", ДанныеДокумента.Ссылка);
	Запрос.УстановитьПараметр("Валюта", ДанныеДокумента.Валюта);
	Запрос.УстановитьПараметр("СуммаПредоплатыКорректировка",
