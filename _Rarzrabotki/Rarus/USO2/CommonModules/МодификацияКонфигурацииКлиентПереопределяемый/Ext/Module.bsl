// Вызывается в формах при выборе команды, которая добавлена программно
//
// Параметры:
//  Форма					 - УправляемаяФорма - форма в которой расположена команда
//  Команда					 - КомандаФормы - выбранная команда
//  ДополнительныеПараметры	 - Структура - дополнительные параметры.
//
Процедура ВыполнитьПереопределяемуюКоманду(Форма, Команда, ДополнительныеПараметры) Экспорт
	
	//<{УСО 2.2}:{Управление строительным предприятием}{Горский М.Е.} 
	УСОERP_МодификацияКонфигурацииКлиент.ВыполнитьПереопределяемуюКоманду(Форма, Команда, ДополнительныеПараметры);
	//<{/УСО 2.2}:{Управление строительным предприятием}{Горский М.Е.}

	//{АУН}
	АУН_МодификацияКонфигурацииКлиент.ВыполнитьПереопределяемуюКоманду(Форма, Команда, ДополнительныеПараметры);
	//{/АУН}
	//{УАТ}
	уатИнтеграцияКлиент.ВыполнитьПереопределяемуюКоманду(Форма, Команда, ДополнительныеПараметры);
	//{/УАТ}
	
КонецПроцедуры

