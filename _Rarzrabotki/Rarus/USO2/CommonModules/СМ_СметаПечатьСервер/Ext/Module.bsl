		КонецЕсли;
		// Сметная Прибыль от ЗТМ (МетодикаТСН).	
		Если ПозицияСметы.Определитель.ВидРасценки <> Перечисления.СМ_ВидыРасценки.Материал
			И ПозицияСметы.Определитель.ВидРасценки <> Перечисления.СМ_ВидыРасценки.Оборудование Тогда
			
			Если ПараметрыПечати.ЭтоМетодикаТСН11а Или ПараметрыПечати.ЭтоМетодикаТСН11б Тогда
				НормативНРБазиснаяМашин = Константы.СМ_НРТСНБазис.Получить();
				НормативНРТекущаяМашин 	= Константы.СМ_НРТСНТекущие.Получить();
				НормативСПБазиснаяМашин	= Константы.СМ_СПТСНБазис.Получить();
				НормативСПТекущаяМашин 	= Константы.СМ_СПТСНТекущие.Получить();	
