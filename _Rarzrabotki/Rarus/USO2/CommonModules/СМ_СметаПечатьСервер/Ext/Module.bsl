			КонецЕсли;
			ПоследняяОбласть = ТабличныйДокумент.Вывести(СтрокаПозицияДоп);
			
			Если ПоследняяОбласть <> Неопределено И ПараметрыПечати.ПечататьСетку Тогда
				Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
				ПоследняяОбласть.Обвести(Линия, , Линия, Линия);
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры	

// Процедура выводит в ТабличныйДокумент строку позиции локальной сметы для формы 12 граф Мособлэкспертизы.
//
Процедура ВывестиСтрокуПозиции12Граф(ПозицияСметы,ТабличныйДокумент,СтрокаПозиция,ПараметрыПечати,СтрокаПозицияДоп,ИтогоПоРасценке,СтрокаПозицияДопФОТ,Смета)
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	СтрокаФормата = ?(КолЗнаков = 0, "ЧДЦ=0","ЧДЦ=2");
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	Номера = СМ_СметаВызовСервера.ПолучитьНомерДокумента(ПозицияСметы.Ссылка, "СМ_ПозицияЛокальнойСметы");
		
