					ИтогРаздела.Параметры.ОбщБазис				= Формат(Окр(Выборка.ПрямЗатраты,	КолЗнаков),СтрокаФормата);
					ИтогРаздела.Параметры.ЕдТек					= "";
					ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(Выборка.ТекПрямЗатраты,	КолЗнаков),СтрокаФормата);
				Иначе
					Если ПараметрыПечати.ВБазисномУровне Тогда
						ИтогРаздела.Параметры.ЕдТек					= "";
						ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(Выборка.ПрямЗатраты,	КолЗнаков),СтрокаФормата);
					Иначе	
						ИтогРаздела.Параметры.ЕдТек					= "";
						ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(Выборка.ТекПрямЗатраты,	КолЗнаков),СтрокаФормата);
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
			ТабличныйДокумент.вывести(ИтогРаздела);
		КонецЕсли;
		
	КонецЦикла;
	
	// Печать Возвратных материалов по ресурсному акту.	
	Если ПечатьАкта Тогда
		Если ВозвратныеМатериалы <> 0 Тогда
			ИтогРаздела.Параметры.НаименованиеИтога =  "Стоимость возвратных материалов";
			Если ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
				ИтогРаздела.Параметры.ИтогБазис			= "";
				ИтогРаздела.Параметры.Итог				= Формат(Окр(ВозвратныеМатериалы,КолЗнаков),СтрокаФормата);
				
			ИначеЕсли ПараметрыПечати.ЭтоКС2Рес Тогда
				ИтогРаздела.Параметры.Итог 				= Формат(Окр(ВозвратныеМатериалы, КолЗнаков),СтрокаФормата);
				ИтогРаздела.Параметры.ЗаработнаяПлата	= "";
			Иначе
				ИтогРаздела.Параметры.ПрямыеЗатраты			= Формат(Окр(ВозвратныеМатериалы,КолЗнаков),СтрокаФормата);
				ИтогРаздела.Параметры.ЗаработнаяПлата		= "";
				ИтогРаздела.Параметры.МашиныИМеханизмы		= "";
				ИтогРаздела.Параметры.ЗарплатаМашинистов	= "";
				ИтогРаздела.Параметры.Материалы				= "";
				ИтогРаздела.Параметры.ЗТР			 		= "";
				ИтогРаздела.Параметры.ЗТМ					= "";
			КонецЕсли;
			ТабличныйДокумент.Вывести(ИтогРаздела);
		КонецЕсли;
	Иначе
		// Печать Возвратных материалов по ресурсной смете
		Если  ВозвратныеМатериалы <> 0 И ТекВозвратныеМатериалы <> 0 Тогда
			ИтогРаздела.Параметры.НаименованиеИтога 	=  "Стоимость возвратных материалов";
			Если ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
				ИтогРаздела.Параметры.ИтогБазис			= Формат(Окр(ВозвратныеМатериалы,	КолЗнаков),СтрокаФормата);
				ИтогРаздела.Параметры.Итог				= Формат(Окр(ТекВозвратныеМатериалы,КолЗнаков),СтрокаФормата);
			ИначеЕсли ПараметрыПечати.ЭтоРесурсная12Граф Тогда
				Если ПараметрыПечати.ВБазисномУровне Тогда
					ИтогРаздела.Параметры.ПрямыеЗатраты		= Формат(Окр(ВозвратныеМатериалы,КолЗнаков),СтрокаФормата);
				Иначе	
					ИтогРаздела.Параметры.ПрямыеЗатраты		= Формат(Окр(ТекВозвратныеМатериалы,КолЗнаков),СтрокаФормата);
				КонецЕсли;
				ИтогРаздела.Параметры.ЗаработнаяПлата	= "";
				ИтогРаздела.Параметры.МашиныИМех		= "";
				ИтогРаздела.Параметры.ЗрплМаш			= "";
				ИтогРаздела.Параметры.Метериалы			= "";
				ИтогРаздела.Параметры.ЗТР			 	= "";
				ИтогРаздела.Параметры.Обслмех			= "";
			Иначе	
				Если НЕ ПараметрыПечати.ЭтоРесурсная7Граф Тогда
					ИтогРаздела.Параметры.ЕдБазис				= "";
					ИтогРаздела.Параметры.ОбщБазис				= Формат(Окр(ВозвратныеМатериалы,	КолЗнаков),СтрокаФормата);
					ИтогРаздела.Параметры.ЕдТек					= "";
					ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(ТекВозвратныеМатериалы,	КолЗнаков),СтрокаФормата);
				Иначе
					Если ПараметрыПечати.ВБазисномУровне Тогда
						ИтогРаздела.Параметры.ЕдТек					= "";
						ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(ВозвратныеМатериалы,	КолЗнаков),СтрокаФормата);
					Иначе	
						ИтогРаздела.Параметры.ЕдТек					= "";
						ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(ТекВозвратныеМатериалы,	КолЗнаков),СтрокаФормата);
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
			ТабличныйДокумент.Вывести(ИтогРаздела);
			
		КонецЕсли;	
	КонецЕсли;	
	
	
КонецПроцедуры	

// Выводим итоги по смете.
//
Процедура ВывестиИтогиПоСмете(ТабличныйДокумент,Ссылка,ИтогСмета,ПараметрыПечати)
	
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = Истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	СтрокаФормата = ?(КолЗнаков = 0, "ЧДЦ=0","ЧДЦ=2");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ИтогиПоСмете.ТекПрямЗатраты,
	|	ИтогиПоСмете.ТекОснЗарплата,
	|	ИтогиПоСмете.ТекЭксплМашин,
	|	ИтогиПоСмете.ТекЗарплМашин,
	|	ИтогиПоСмете.ТекСтоимМатер,
	|	ИтогиПоСмете.ТекОборуд,
	|	ИтогиПоСмете.ТекВозвратМатер,
	|	ИтогиПоСмете.Итог,
	|	ИтогиПоСмете.ЗатратыТрудаРабочих,
	|	ИтогиПоСмете.ЗатратыТрудаМашин,
	|	ИтогиПоСмете.Оборуд,
	|	ИтогиПоСмете.ПрямЗатраты,
	|	ИтогиПоСмете.ОснЗарплата,
	|	ИтогиПоСмете.ЭксплМашин,
	|	ИтогиПоСмете.ЗарплМашин,
	|	ИтогиПоСмете.СтоимМатер,
	|	ИтогиПоСмете.ВозвратМатер
	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоСмете КАК ИтогиПоСмете
	|ГДЕ
	|	ИтогиПоСмете.Смета = &Смета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИтогиПоСмете.Итог.ПорядковыйНомер";
	
	Если ПечатьАкта Тогда
		Запрос.УстановитьПараметр("Смета",ПараметрыПечати.АктСсылка);
		Методика = ПараметрыПечати.АктСсылка.ЛокальнаяСмета.МетодикаРасчета;
	Иначе
		Запрос.УстановитьПараметр("Смета",ПараметрыПечати.СметаСсылка);
		Методика = ПараметрыПечати.СметаСсылка.МетодикаРасчета;
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если выборка.ТекПрямЗатраты = 0 И Выборка.ТекОснЗарплата = 0 И  Выборка.ТекЭксплМашин = 0 И Выборка.ТекСтоимМатер = 0  И Выборка.ТекЗарплМашин = 0 И Выборка.ЗатратыТрудаРабочих = 0   И Выборка.ЗатратыТрудаМашин = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПараметрыПечати.УровеньЗаданияИндексов = Перечисления.СМ_УровеньЗаданияИндексов.Расценка
			И (Выборка.Итог = Справочники.СМ_ИтогиПоСмете.ИндексыПоСметеКЭлементам ИЛИ выборка.Итог = Справочники.СМ_ИтогиПоСмете.НаклСИндексом
			ИЛИ выборка.итог = Справочники.СМ_ИтогиПоСмете.СметПрибыльСИндексом ИЛИ выборка.итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндКОборуд
			ИЛИ выборка.итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндКСметСтоим ИЛИ выборка.итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндНаПрочРаботы 
			ИЛИ выборка.итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндСМР) Тогда
			Продолжить;
		КонецЕсли; 
		Если ПараметрыПечати.УровеньЗаданияИндексов = Перечисления.СМ_УровеньЗаданияИндексов.Смета
			И ПараметрыПечати.ВБазисномУровне Тогда
			Если (Выборка.Итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндКОборуд 
				ИЛИ выборка.Итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндНаПрочРаботы 
				ИЛИ выборка.итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндКСметСтоим 
				ИЛИ выборка.итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндСМР
				Или выборка.итог = Справочники.СМ_ИтогиПоСмете.НаклСИндексом 
				Или выборка.итог = Справочники.СМ_ИтогиПоСмете.СметПрибыльСИндексом) Тогда
				Продолжить;
			КонецЕсли; 
		КонецЕсли; 
		
		Если ПараметрыПечати.УровеньЗаданияИндексов = Перечисления.СМ_УровеньЗаданияИндексов.Раздел И Выборка.Итог = Справочники.СМ_ИтогиПоСмете.ИндексыПоСметеКЭлементам Тогда
			Продолжить;
		КонецЕсли;	
		
		ИтогСмета.Параметры.НаименованиеИтога = ПолучитьНаименованиеИтога(Методика,Выборка.Итог);
		
		// Печать акта выполненных работ.
		Если ПечатьАкта Тогда
			
			Если ПараметрыПечати.ЭтоРесурсная Тогда
				
				Если ПараметрыПечати.ЭтоМетодикаТСН9в ИЛИ ПараметрыПечати.ЭтоМетодикаТСН11а ИЛИ ПараметрыПечати.ЭтоМетодикаТСН11б Тогда
					Если ПараметрыПечати.ЭтоМетодикаТСН11а Тогда
						ИтогСмета.Параметры.Итог		= Формат(Окр(Выборка.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
					Иначе	
						ИтогСмета.Параметры.Итог		= Формат(Окр(Выборка.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
						ИтогСмета.Параметры.ИтогБазис	= Формат(Окр(Выборка.ПрямЗатраты,КолЗнаков),СтрокаФормата);
					КонецЕсли;
				ИначеЕсли ПараметрыПечати.ЭтоКС2Рес Тогда
					ИтогСмета.Параметры.Итог			= Формат(Окр(Выборка.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
					ИтогСмета.Параметры.ЗаработнаяПлата	= Формат(Окр(Выборка.ТекОснЗарплата,КолЗнаков),СтрокаФормата);
				Иначе	
					ИтогСмета.Параметры.ПрямыеЗатраты			= Формат(Окр(Выборка.ТекПрямЗатраты,	КолЗнаков),СтрокаФормата);
					ИтогСмета.Параметры.ЗаработнаяПлата			= Формат(Окр(Выборка.ТекОснЗарплата,	КолЗнаков),СтрокаФормата);
					ИтогСмета.Параметры.МашиныИМеханизмы		= Формат(Окр(Выборка.ТекЭксплМашин,		КолЗнаков),СтрокаФормата);
					ИтогСмета.Параметры.ЗарплатаМашинистов		= Формат(Окр(Выборка.ТекЗарплМашин,		КолЗнаков),СтрокаФормата);
					ИтогСмета.Параметры.Материалы				= Формат(Окр(Выборка.ТекСтоимМатер,		КолЗнаков),СтрокаФормата);
					ИтогСмета.Параметры.ЗТР				 		= Окр(Выборка.ЗатратыТрудаРабочих,	2);
					ИтогСмета.Параметры.ЗТМ						= Окр(Выборка.ЗатратыТрудаМашин,	2);
				КонецЕсли;	
			Иначе	
				
				ИтогСмета.Параметры.НаименованиеИтога 	= ИтогСмета.Параметры.НаименованиеИтога + " "+ПолучитьРасшифровкуИтогаСметы(Выборка.Итог,Ссылка);
				ИтогСмета.Параметры.Итог 				= Формат(Окр(Выборка.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
				Если ПараметрыПечати.ЭтоМетодикаТСН9в  Или ПараметрыПечати.ЭтоМетодикаТСН11б Тогда
					ИтогСмета.Параметры.ИтогБазис	= Формат(Окр(Выборка.ПрямЗатраты,КолЗнаков),СтрокаФормата);
				КонецЕсли;
				Если НЕ ПараметрыПечати.Это12Граф И НЕ ПараметрыПечати.ЭтоКС2  И  НЕ ПараметрыПечати.ЭтоМетодикаТСН11а
					И НЕ ПараметрыПечати.ЭтоМетодикаТСН11б И НЕ  ПараметрыПечати.ЭтоМетодикаТСН9в	Тогда
					ИтогСмета.Параметры.ИтогОЗ				= Формат(Окр(Выборка.ТекОснЗарплата,КолЗнаков),СтрокаФормата);
					ИтогСмета.Параметры.ИтогЭМ				= Формат(Окр(Выборка.ТекЭксплМашин,КолЗнаков),СтрокаФормата);
					ИтогСмета.Параметры.ИтогЗМ				= Формат(Окр(Выборка.ТекЗарплМашин,КолЗнаков),СтрокаФормата);
					ИтогСмета.Параметры.ИтогЗатрТрРаб		= Окр(Выборка.ЗатратыТрудаРабочих,2);
					ИтогСмета.Параметры.ИтогЗатрТрМех		= Окр(Выборка.ЗатратыТрудаМашин,2);
				КонецЕсли;	
				
				Если ПараметрыПечати.Это14Граф ИЛИ ПараметрыПечати.ЭтоАктСНРиСП Тогда
					ИтогСмета.Параметры.ИтогМат = Формат(Окр(Выборка.ТекСтоимМатер,КолЗнаков),СтрокаФормата);
				КонецЕсли;
				
			КонецЕсли;
			
			// Печать локальной сметы.
		Иначе
			
			Если ПараметрыПечати.ЭтоРесурсная Тогда
				
				Если ПараметрыПечати.ЭтоМетодикаТСН9в ИЛИ ПараметрыПечати.ЭтоМетодикаТСН11а ИЛИ ПараметрыПечати.ЭтоМетодикаТСН11б Тогда
					Если ПараметрыПечати.ЭтоМетодикаТСН11а Тогда
						ИтогСмета.Параметры.Итог		= Формат(Окр(Выборка.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
					Иначе	
						ИтогСмета.Параметры.Итог		= Формат(Окр(Выборка.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
						ИтогСмета.Параметры.ИтогБазис	= Формат(Окр(Выборка.ПрямЗатраты,КолЗнаков),СтрокаФормата);
					КонецЕсли;
				ИначеЕсли ПараметрыПечати.ЭтоРесурсная12Граф Тогда
					Если ПараметрыПечати.ВБазисномУровне Тогда
						ИтогСмета.Параметры.ПрямыеЗатраты		= Формат(Окр(Выборка.ПрямЗатраты,КолЗнаков),СтрокаФормата);
						ИтогСмета.Параметры.ЗаработнаяПлата		= Формат(Окр(Выборка.ОснЗарплата,КолЗнаков),СтрокаФормата);
						ИтогСмета.Параметры.МашиныИМех			= Формат(Окр(Выборка.ЭксплМашин,	КолЗнаков),СтрокаФормата);
						ИтогСмета.Параметры.ЗрплМаш				= Формат(Окр(Выборка.ЗарплМашин,	КолЗнаков),СтрокаФормата);
						ИтогСмета.Параметры.Метериалы			= Формат(Окр(Выборка.СтоимМатер,	КолЗнаков),СтрокаФормата);
					Иначе	
						ИтогСмета.Параметры.ПрямыеЗатраты		= Формат(Окр(Выборка.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
						ИтогСмета.Параметры.ЗаработнаяПлата		= Формат(Окр(Выборка.ТекОснЗарплата,КолЗнаков),СтрокаФормата);
						ИтогСмета.Параметры.МашиныИМех			= Формат(Окр(Выборка.ТекЭксплМашин,	КолЗнаков),СтрокаФормата);
						ИтогСмета.Параметры.ЗрплМаш				= Формат(Окр(Выборка.ТекЗарплМашин,	КолЗнаков),СтрокаФормата);
						ИтогСмета.Параметры.Метериалы			= Формат(Окр(Выборка.ТекСтоимМатер,	КолЗнаков),СтрокаФормата);
					КонецЕсли;
					ИтогСмета.Параметры.ЗТР				 	= Окр(Выборка.ЗатратыТрудаРабочих,	2);
					ИтогСмета.Параметры.Обслмех				= Окр(Выборка.ЗатратыТрудаМашин,	2);
				Иначе
					Если НЕ ПараметрыПечати.ЭтоРесурсная7Граф Тогда
						ИтогСмета.Параметры.ОбщБазис = Формат(Окр(Выборка.ПрямЗатраты,КолЗнаков),СтрокаФормата);
						ИтогСмета.Параметры.ОбщТек = Формат(Окр(Выборка.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
