			Стоимости.Вставить("СтоимОснЗарплата", 		Окр(Выборка.СтоимОснЗарплата	* ЧУ,	КолЗнаков));
			Стоимости.Вставить("СтоимОборуд", 			Окр(Выборка.СтоимОборуд			* ЧУ,	КолЗнаков));
			Стоимости.Вставить("СтоимЭксплМашин", 		Окр(Выборка.СтоимЭксплМашин		* ЧУ,	КолЗнаков));
