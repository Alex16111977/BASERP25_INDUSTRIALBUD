						СтрокаПозиция.Параметры.ОбщВсего	= Стоимости.ОбщПЗ;
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
		
		Если ПараметрыПечати.ИмяМакета = "ПФ_MXL_ЛС_11"	Тогда
			СтрокаПозиция.Параметры.РасшифровкаПозиции = ПозицияСметы;	
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(СтрокаПозиция);
		
		Если (ПараметрыПечати.Это13ГрафСНРиСП ИЛИ  ПараметрыПечати.Это11ГрафСНРиСП) И ПозицияСметы.Определитель.ВидРасценки= Перечисления.СМ_ВидыРасценки.Работа Тогда
			Если ПараметрыПечати.МетодикаТСН Тогда
				Если ПараметрыПечати.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
					Наименование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Накладные расходы от ЗТР: %1%'"), Строка(ПозицияСметы.НРТСНТекущиеРемонт));
				Иначе
					Наименование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Накладные расходы от ЗТР: %1%'"), Строка(ПозицияСметы.накладныеРасходыТекущие));
