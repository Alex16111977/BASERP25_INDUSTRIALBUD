// Формирует форму КС3.
//
Функция СформироватьПечатнуюФормуОтчетКС3(МассивОбъектов, ОбъектыПечати, КомплектыПечати)
	
	ЭтотОбъект = МассивОбъектов[0];
	
	Если (ТипЗнч(ЭтотОбъект) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"))
		ИЛИ (ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект.СМ_ЛокальнаяСмета")) Тогда	
		
		// Это смета.
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	СМ_АктВыполненныхРабот.ПериодОт,
		|	СМ_АктВыполненныхРабот.ПериодДо
		|ИЗ
		|	Документ.СМ_АктВыполненныхРабот КАК СМ_АктВыполненныхРабот
		|ГДЕ
		|	СМ_АктВыполненныхРабот.ЛокальнаяСмета = &ЛокальнаяСмета
		|
		|УПОРЯДОЧИТЬ ПО
		|	СМ_АктВыполненныхРабот.Дата УБЫВ";
		Запрос.УстановитьПараметр("ЛокальнаяСмета",ЭтотОбъект.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Период = Новый СтандартныйПериод;
			Период.ДатаНачала = Выборка.ПериодОт;
			Период.ДатаОкончания = Выборка.ПериодДо;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='По данной смете не найдено актов'"));
			Возврат Новый ТабличныйДокумент;
		КонецЕсли;
		
		ЭтоЛокальнаяСмета = Истина;
		
	Иначе
		
		// Это акт.
		Период = Новый СтандартныйПериод;
		Период.ДатаНачала = ЭтотОбъект.ПериодОт;
		Период.ДатаОкончания = ЭтотОбъект.ПериодДо;
		
		ЭтоЛокальнаяСмета = Ложь;
		
	КонецЕсли;
	
	ЛимЗатратаНДС = Справочники.СМ_ЛимитированныеЗатраты.НайтиПоРеквизиту("Идентификатор","ЛЗ64");
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СМ_АктВыполненныхРаботЛимитированныеЗатраты.ЛимитированнаяЗатрата,
	|	СМ_АктВыполненныхРаботЛимитированныеЗатраты.ЛимитированнаяЗатрата.НомерПоПорядку КАК ЛимитированнаяЗатратаНомерПоПорядку
	|ИЗ
	|	Документ.СМ_АктВыполненныхРабот.ЛимитированныеЗатраты КАК СМ_АктВыполненныхРаботЛимитированныеЗатраты
	|ГДЕ
	|	СМ_АктВыполненныхРаботЛимитированныеЗатраты.Ссылка"+?(ЭтоЛокальнаяСмета,".ЛокальнаяСмета","")+" = &СметныйДокумент
	|	И СМ_АктВыполненныхРаботЛимитированныеЗатраты.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И СМ_АктВыполненныхРаботЛимитированныеЗатраты.ЛимитированнаяЗатрата.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛимитированнаяЗатратаНомерПоПорядку";
	Запрос.УстановитьПараметр("СметныйДокумент",ЭтотОбъект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	ЛимитированныеЗатраты = РезультатЗапроса.ВыгрузитьКолонку("ЛимитированнаяЗатрата");
	
	// ТабДок не был задан и пропущен параметр, и обращение к процедуре, как к функции.
	ТабДок = Новый ТабличныйДокумент;
	Если ЭтоЛокальнаяСмета Тогда
		ЛокальнаяСмета = ЭтотОбъект.Ссылка;
	Иначе
		ЛокальнаяСмета = ЭтотОбъект.ЛокальнаяСмета.Ссылка;
	КонецЕсли;
	Отчеты.СМ_СправкаОСтоимостиВыполненныхРаботИЗатрат.Создать().ПолучитьЗаполненныйОтчет(Период,ТабДок,ЛокальнаяСмета,ЛимЗатратаНДС,ЛимитированныеЗатраты);
	Возврат ТабДок;
	
КонецФункции

