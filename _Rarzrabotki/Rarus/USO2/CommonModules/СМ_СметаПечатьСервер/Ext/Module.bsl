							ИтогСмета.Параметры.ИтогЭМвтч 			= Формат(Окр(Выборка.ТекЗарплМашин,КолЗнаков),СтрокаФормата);
							ИтогСмета.Параметры.ИтогЗатрТрРаб		= Окр(Выборка.ЗатратыТрудаРабочих,2);
							ИтогСмета.Параметры.ИтогЗатрТрМех		= Окр(Выборка.ЗатратыТрудаМашин,2);
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;	
				
			КонецЕсли;	
			
			ПоследняяОбласть = ТабличныйДокумент.вывести(ИтогСмета);
			
		КонецЦикла;	
		
	КонецЕсли;
	
	Если ПоследняяОбласть <> Неопределено И ПараметрыПечати.ПечататьСетку Тогда
		Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
		ПоследняяОбласть.Обвести(Линия, , Линия, Линия);
	КонецЕсли;
	
КонецПроцедуры	

// Процедура выводит итоги по главам печатаемого документа в ТабличныйДокумент.
//	Ссылка может принимать значение как документ "Акт выполненных работ", так и документ "Локальная смета".
//
Процедура ВывестиИтогиПоГлавам(ТабличныйДокумент,Ссылка,ИтогГлава,ПараметрыПечати)
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	СтрокаФормата = ?(КолЗнаков = 0, "ЧДЦ=0","ЧДЦ=2");
	
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ИтогиПоГлавам.Итог,
	|	СУММА(ИтогиПоГлавам.ТекПрямЗатраты) КАК ТекПрямЗатраты,
	|	СУММА(ИтогиПоГлавам.ТекОснЗарплата) КАК ТекОснЗарплата,
	|	СУММА(ИтогиПоГлавам.ТекЭксплМашин) КАК ТекЭксплМашин,
	|	СУММА(ИтогиПоГлавам.ТекЗарплМашин) КАК ТекЗарплМашин,
	|	СУММА(ИтогиПоГлавам.ТекСтоимМатер) КАК ТекСтоимМатер,
	|	СУММА(ИтогиПоГлавам.ТекОборуд) КАК ТекОборуд,
	|	СУММА(ИтогиПоГлавам.ТекВозвратМатер) КАК ТекВозвратМатер,
	|	СУММА(ИтогиПоГлавам.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
	|	СУММА(ИтогиПоГлавам.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
	|	СУММА(ИтогиПоГлавам.Оборуд) КАК Оборуд,
	|	СУММА(ИтогиПоГлавам.ПрямЗатраты) КАК ПрямЗатраты,
	|	СУММА(ИтогиПоГлавам.ОснЗарплата) КАК ОснЗарплата,
	|	СУММА(ИтогиПоГлавам.ЭксплМашин) КАК ЭксплМашин,
	|	СУММА(ИтогиПоГлавам.ЗарплМашин) КАК ЗарплМашин,
	|	СУММА(ИтогиПоГлавам.СтоимМатер) КАК СтоимМатер,
	|	СУММА(ИтогиПоГлавам.ВозвратМатер) КАК ВозвратМатер
	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоГлавам КАК ИтогиПоГлавам
	|ГДЕ
	|	ИтогиПоГлавам.Смета = &Смета
	|	И ВЫБОР
	|		КОГДА &ЕстьЛимЗатраты ТОГДА ИСТИНА
	|		ИНАЧЕ ИтогиПоГлавам.Итог = &ИтогПоСмете
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ИтогиПоГлавам.Итог
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИтогиПоГлавам.Итог.ГлаваССРС.ПорядковыйНомер";
	
	Если ПечатьАкта Тогда
		Запрос.УстановитьПараметр("Смета",ПараметрыПечати.АктСсылка);
	Иначе
		Запрос.УстановитьПараметр("Смета",Ссылка);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ИтогПоСмете",Справочники.СМ_ИтогиПоГлавам.НайтиПоКоду("21"));
	Запрос.УстановитьПараметр("ЕстьЛимЗатраты",?(Ссылка.ЛимитированныеЗатраты.Количество() > 0, Истина, Ложь));
	
	ТаблВыборка = Новый ТаблицаЗначений ;
	ТаблВыборка = Запрос.Выполнить().Выгрузить();
	ТаблВыборка.Колонки.Добавить("Напечатан",Новый  ОписаниеТипов("Булево"));
	ТаблВыборка.Колонки.Добавить("СортировкаИтогов",Новый  ОписаниеТипов("Число"));
	Для каждого СтрокаИтога Из  ТаблВыборка Цикл
		Если ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
			СтрокаИтога.СортировкаИтогов = 1000 + СтрокаИтога.Итог.НомерПоПорядку;
		Иначе
			СтрокаИтога.СортировкаИтогов = 2000 + СтрокаИтога.Итог.ПорядковыйНомер;
		КонецЕсли;	
		СтрокаИтога.Напечатан = Ложь;
	КонецЦикла;	
	ТаблВыборка.Сортировать("СортировкаИтогов");
	
	ПеременныеДляПовтора = ИнициализироватьПеременныеДляПовтораИтогов();
	
	Для Каждого СтрокаИтога Из  ТаблВыборка Цикл
		
		Если СтрокаИтога.ТекПрямЗатраты = 0 И СтрокаИтога.ТекОснЗарплата = 0 И  СтрокаИтога.ТекЭксплМашин = 0 И СтрокаИтога.ТекСтоимМатер = 0  И СтрокаИтога.ТекЗарплМашин = 0 И СтрокаИтога.ЗатратыТрудаРабочих = 0   И СтрокаИтога.ЗатратыТрудаМашин = 0 Тогда
			Продолжить;
		КонецЕсли;	
		Если ТипЗнч(СтрокаИтога.Итог) <> Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
			Если СтрокаИтога.Итог.ВыводитьНаПечать = Ложь Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;	
		
		Если ПропуститьСтрокуИзЗаПовтораИтога(ПеременныеДляПовтора,СтрокаИтога,ПараметрыПечати) = Истина Тогда
			Продолжить;
		КонецЕсли;	
		
		// Печать акта выполненных работ.
		Если ПечатьАкта Тогда
			
			// Вытолкнуть Все Итоги "От" т.е. все перед ЛимЗатратой до итогов "К".
			Если ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
				ГлаваЛимЗатраты = СтрокаИтога.Итог.ГлаваССРС;
				ГлаваИтогаОТ 	= СтрокаИтога.Итог.ОтИтога.ГлаваССРС;
				ГлаваИтогаКЧему = СтрокаИтога.Итог.КИтогу.ГлаваССРС;
				НомерИтогаКЧему = СтрокаИтога.Итог.КИтогу.ПорядковыйНомер;
				ТекНомерСтроки 	= ТаблВыборка.Индекс(СтрокаИтога);
				ПечатьИтоговПеред(ИтогГлава,ТабличныйДокумент,ТаблВыборка,ГлаваЛимЗатраты,ГлаваИтогаОТ,ГлаваИтогаКЧему,параметрыПечати,НомерИтогаКЧему);
				ТаблВыборка.Получить(ТекНомерСтроки);
				Если ПараметрыПечати.АктСсылка.НеОкруглятьНДС Тогда
					Если СтрокаИтога.Итог.Идентификатор = "ЛЗ64" Тогда
						КолЗнаков = 2;
						СтрокаФормата = "ЧДЦ=2";
					КонецЕсли;
				КонецЕсли;
				ИтогГлава.Параметры.НаименованиеИтога 	= СокрЛП(СтрокаИтога.Итог.Обоснование) + "   " + СформироватьНаименованиеРаботПоЛимЗатрате(Ссылка,СтрокаИтога.Итог,ПараметрыПечати);
				ИтогГлава.Параметры.НаименованиеРабот   = "";
			Иначе	
				Если СтрокаИтога.Напечатан <> Истина  Тогда
					ИтогГлава.Параметры.НаименованиеИтога 	= СокрЛП(СтрокаИтога.Итог.Наименование);
					ИтогГлава.Параметры.НаименованиеРабот   = "";
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если ПараметрыПечати.ЭтоРесурсная = Истина Тогда
				Если ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
					ИтогГлава.Параметры.Итог		= Формат(Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
					ИтогГлава.Параметры.ИтогБазис	= Формат(Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков),СтрокаФормата);
					ПеременныеДляПовтора.ПредИтог	= Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков);
					
				ИначеЕсли ПараметрыПечати.ЭтоКС2Рес Тогда
					
					ИтогГлава.Параметры.Итог			= Формат(Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
					ИтогГлава.Параметры.ЗаработнаяПлата	= Формат(Окр(СтрокаИтога.ТекОснЗарплата,КолЗнаков),СтрокаФормата);
					
					ПеременныеДляПовтора.ПредИтог				 = Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков);
					ПеременныеДляПовтора.ПредИтогЗаработнаяПлата = Окр(СтрокаИтога.ТекОснЗарплата,КолЗнаков);
					
				Иначе	
					
					ИтогГлава.Параметры.ПрямыеЗатраты			= Формат(Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
					ИтогГлава.Параметры.ЗаработнаяПлата			= Формат(Окр(СтрокаИтога.ТекОснЗарплата,КолЗнаков),СтрокаФормата);
					ИтогГлава.Параметры.МашиныИМеханизмы		= Формат(Окр(СтрокаИтога.ТекЭксплМашин,	КолЗнаков),СтрокаФормата);
					ИтогГлава.Параметры.ЗарплатаМашинистов		= Формат(Окр(СтрокаИтога.ТекЗарплМашин,	КолЗнаков),СтрокаФормата);
					ИтогГлава.Параметры.Материалы				= Формат(Окр(СтрокаИтога.ТекСтоимМатер,	КолЗнаков),СтрокаФормата);
					ИтогГлава.Параметры.ЗТР				 		= Окр(СтрокаИтога.ЗатратыТрудаРабочих,	2);
					ИтогГлава.Параметры.ЗТМ						= Окр(СтрокаИтога.ЗатратыТрудаМашин,	2);
					
					ПеременныеДляПовтора.ПредИтогПрямЗатраты		= Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков);
					ПеременныеДляПовтора.ПредИтогЗаработнаяПлата	= Окр(СтрокаИтога.ТекОснЗарплата,КолЗнаков);
					ПеременныеДляПовтора.ПредИтогМашиныИМех			= Окр(СтрокаИтога.ТекЭксплМашин,КолЗнаков);
					ПеременныеДляПовтора.ПредИтогЗрплМаш			= Окр(СтрокаИтога.ТекЗарплМашин,	КолЗнаков);
					ПеременныеДляПовтора.ПредИтогМетериалы			= Окр(СтрокаИтога.ТекСтоимМатер,	КолЗнаков);
					ПеременныеДляПовтора.ПредИтогЗТР				= ИтогГлава.Параметры.ЗТР;
					ПеременныеДляПовтора.ПредИтогОбслмех			= ИтогГлава.Параметры.ЗТМ;
					
				КонецЕсли;
			Иначе	
				
				ИтогГлава.Параметры.Итог  		= Формат(Окр(СтрокаИтога.ТекПрямЗатраты, КолЗнаков),СтрокаФормата);
				ПеременныеДляПовтора.ПредИтог	= Окр(СтрокаИтога.ТекПрямЗатраты, КолЗнаков);
				Если ПараметрыПечати.ЭтоМетодикаТСН11б Или ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
					ИтогГлава.Параметры.ИтогБазис			= Формат(Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков),СтрокаФормата);
				КонецЕсли;
				
				Если НЕ ПараметрыПечати.Это12Граф И НЕ ПараметрыПечати.ЭтоКС2  И  НЕ ПараметрыПечати.ЭтоМетодикаТСН11а
					И НЕ ПараметрыПечати.ЭтоМетодикаТСН11б И НЕ  ПараметрыПечати.ЭтоМетодикаТСН9в	 Тогда
					
					ИтогГлава.Параметры.ИтогОЗ				= Формат(Окр(СтрокаИтога.ТекОснЗарплата,КолЗнаков),СтрокаФормата);
					ИтогГлава.Параметры.ИтогЭМ				= Формат(Окр(СтрокаИтога.ТекЭксплМашин,	КолЗнаков),СтрокаФормата);
					ИтогГлава.Параметры.ИтогЗМ				= Формат(Окр(СтрокаИтога.ТекЗарплМашин,	КолЗнаков),СтрокаФормата);
					ИтогГлава.Параметры.ИтогЗатрТрРаб		= Окр(СтрокаИтога.ЗатратыТрудаРабочих,	2);
					ИтогГлава.Параметры.ИтогЗатрТрМех		= Окр(СтрокаИтога.ЗатратыТрудаМашин,	2);
					
					ПеременныеДляПовтора.ПредИтогОЗ			= Окр(СтрокаИтога.ТекОснЗарплата,КолЗнаков);  	
					ПеременныеДляПовтора.ПредИтогЭМ			= Окр(СтрокаИтога.ТекЭксплМашин,	КолЗнаков);
					ПеременныеДляПовтора.ПредИтогЭМвтч		= Окр(СтрокаИтога.ТекЗарплМашин,	КолЗнаков); 
					ПеременныеДляПовтора.ПредИтогЗатрТрРаб	= ИтогГлава.Параметры.ИтогЗатрТрРаб;
					ПеременныеДляПовтора.ПредИтогЗатрТрМех	= ИтогГлава.Параметры.ИтогЗатрТрМех;
				КонецЕсли;
				
				Если ПараметрыПечати.Это14Граф ИЛИ ПараметрыПечати.ЭтоАктСНРиСП Тогда
					ИтогГлава.Параметры.ИтогМат 		= Формат(Окр(СтрокаИтога.ТекСтоимМатер,КолЗнаков),СтрокаФормата);
					ПеременныеДляПовтора.ПредИтогМат 	= Окр(СтрокаИтога.ТекСтоимМатер,КолЗнаков);
				КонецЕсли;
				
			КонецЕсли;
			
			// Печать локальной сметы.	
		Иначе	
			
			// Вытолкнуть Все Итоги "От" т.е. все перед ЛимЗатратой до итогов "К".
			Если ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
				ГлаваЛимЗатраты = СтрокаИтога.Итог.ГлаваССРС;
				ГлаваИтогаОТ 	= СтрокаИтога.Итог.ОтИтога.ГлаваССРС;
				ГлаваИтогаКЧему = СтрокаИтога.Итог.КИтогу.ГлаваССРС;
				НомерИтогаКЧему = СтрокаИтога.Итог.КИтогу.ПорядковыйНомер;
				ТекНомерСтроки 	= ТаблВыборка.Индекс(СтрокаИтога);
				ПечатьИтоговПеред(ИтогГлава,ТабличныйДокумент,ТаблВыборка,ГлаваЛимЗатраты,ГлаваИтогаОТ,ГлаваИтогаКЧему,параметрыПечати,НомерИтогаКЧему);
				ТаблВыборка.Получить(ТекНомерСтроки);
				Если Ссылка.НеОкруглятьНДС Тогда
					Если СтрокаИтога.Итог.Идентификатор = "ЛЗ64" Тогда
						КолЗнаков = 2;
						СтрокаФормата = "ЧДЦ=2";
					КонецЕсли;
				КонецЕсли;
				
				Обоснование = СокрЛП(СтрокаИтога.Итог.Обоснование);
				Если СтрДлина(Обоснование) = 0 Тогда
					ИтогГлава.Параметры.НаименованиеИтога 	= СформироватьНаименованиеРаботПоЛимЗатрате(Ссылка,СтрокаИтога.Итог,ПараметрыПечати);
				Иначе
					ИтогГлава.Параметры.НаименованиеИтога 	= СокрЛП(СтрокаИтога.Итог.Обоснование) + "   " + СформироватьНаименованиеРаботПоЛимЗатрате(Ссылка,СтрокаИтога.Итог,ПараметрыПечати);
				КонецЕсли;
				ИтогГлава.Параметры.НаименованиеРабот   = "";
			Иначе	
				Если СтрокаИтога.Напечатан <> Истина  Тогда
					ИтогГлава.Параметры.НаименованиеИтога 	= СокрЛП(СтрокаИтога.Итог.Наименование);
					ИтогГлава.Параметры.НаименованиеРабот   = "";
					СтрокаИтога.Напечатан = Истина;
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если ПараметрыПечати.ЭтоРесурсная = истина Тогда
				
				Если ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
					ИтогГлава.Параметры.Итог		= Формат(Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
					ИтогГлава.Параметры.ИтогБазис	= Формат(Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков),СтрокаФормата);
					ПеременныеДляПовтора.ПредОбщТек		= Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков);
					ПеременныеДляПовтора.ПредИтог		= Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков);
					
				ИначеЕсли ПараметрыПечати.ЭтоРесурсная12Граф Тогда
					Если ПараметрыПечати.ВБазисномУровне Тогда
						ИтогГлава.Параметры.ПрямыеЗатраты		= Формат(Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков),СтрокаФормата);
						ИтогГлава.Параметры.ЗаработнаяПлата		= Формат(Окр(СтрокаИтога.ОснЗарплата,КолЗнаков),СтрокаФормата);
						ИтогГлава.Параметры.МашиныИМех			= Формат(Окр(СтрокаИтога.ЭксплМашин,	КолЗнаков),СтрокаФормата);
						ИтогГлава.Параметры.ЗрплМаш				= Формат(Окр(СтрокаИтога.ЗарплМашин,	КолЗнаков),СтрокаФормата);
						ИтогГлава.Параметры.Метериалы			= Формат(Окр(СтрокаИтога.СтоимМатер,	КолЗнаков),СтрокаФормата);
						ИтогГлава.Параметры.ЗТР				 	= Окр(СтрокаИтога.ЗатратыТрудаРабочих,	2);
						ИтогГлава.Параметры.Обслмех				= Окр(СтрокаИтога.ЗатратыТрудаМашин,	2);
						
						ПеременныеДляПовтора.ПредИтог			= Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков);
					Иначе
						ИтогГлава.Параметры.ПрямыеЗатраты		= Формат(Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
						ИтогГлава.Параметры.ЗаработнаяПлата		= Формат(Окр(СтрокаИтога.ТекОснЗарплата,КолЗнаков),СтрокаФормата);
						ИтогГлава.Параметры.МашиныИМех			= Формат(Окр(СтрокаИтога.ТекЭксплМашин,	КолЗнаков),СтрокаФормата);
						ИтогГлава.Параметры.ЗрплМаш				= Формат(Окр(СтрокаИтога.ТекЗарплМашин,	КолЗнаков),СтрокаФормата);
						ИтогГлава.Параметры.Метериалы			= Формат(Окр(СтрокаИтога.ТекСтоимМатер,	КолЗнаков),СтрокаФормата);
						ИтогГлава.Параметры.ЗТР				 	= Окр(СтрокаИтога.ЗатратыТрудаРабочих,	2);
						ИтогГлава.Параметры.Обслмех				= Окр(СтрокаИтога.ЗатратыТрудаМашин,	2);
						ПеременныеДляПовтора.ПредИтог			= Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков);
					КонецЕсли;
				Иначе
					
					Если НЕ ПараметрыПечати.ЭтоРесурсная7Граф Тогда
						ИтогГлава.Параметры.ОбщБазис		= Формат(Окр(СтрокаИтога.ПрямЗатраты + СтрокаИтога.Оборуд,КолЗнаков),СтрокаФормата);
						ПеременныеДляПовтора.ПредОбщБазис	= Окр(СтрокаИтога.ПрямЗатраты + СтрокаИтога.Оборуд,КолЗнаков);
						ИтогГлава.Параметры.ОбщТек			= Формат(Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
						ПеременныеДляПовтора.ПредОбщТек		= Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков);
					Иначе
						Если ПараметрыПечати.ВБазисномУровне Тогда
							ИтогГлава.Параметры.ОбщТек			= Формат(Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков),СтрокаФормата);
							ПеременныеДляПовтора.ПредОбщТек		= Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков);
						Иначе
							ИтогГлава.Параметры.ОбщТек			= Формат(Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
							ПеременныеДляПовтора.ПредОбщТек		= Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			Иначе	
				// Базисно-индексная Смета.
				Если ПараметрыПечати.ВБазисномУровне Тогда
					ИтогГлава.Параметры.Итог				= Формат(Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков),СтрокаФормата);
				Иначе
					ИтогГлава.Параметры.Итог				= Формат(Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
				КонецЕсли;	 
				Если ПараметрыПечати.ЭтоМетодикаТСН11б Или ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
					ИтогГлава.Параметры.ИтогБазис			= Формат(Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков),СтрокаФормата);
					ИтогГлава.Параметры.Итог				= Формат(Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
					ПеременныеДляПовтора.ПредИтог		= Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков);
				КонецЕсли;
				Если НЕ ПараметрыПечати.Это12Граф И НЕ ПараметрыПечати.ЭтоМетодикаТСН11а
					И НЕ ПараметрыПечати.ЭтоМетодикаТСН11б И НЕ ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
					Если ПараметрыПечати.ВБазисномУровне Тогда
						ИтогГлава.Параметры.ИтогОЗ				= Формат(Окр(СтрокаИтога.ОснЗарплата,КолЗнаков),СтрокаФормата);
						ИтогГлава.Параметры.ИтогЭМ				= Формат(Окр(СтрокаИтога.ЭксплМашин,	КолЗнаков),СтрокаФормата);
						ИтогГлава.Параметры.ИтогЭМвтч 			= Формат(Окр(СтрокаИтога.ЗарплМашин,	КолЗнаков),СтрокаФормата);
						ИтогГлава.Параметры.ИтогЗатрТрРаб		= Окр(СтрокаИтога.ЗатратыТрудаРабочих,	2);
						ИтогГлава.Параметры.ИтогЗатрТрМех		= Окр(СтрокаИтога.ЗатратыТрудаМашин,	2);
						ПеременныеДляПовтора.ПредИтог			= Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков);
					Иначе
						ИтогГлава.Параметры.ИтогОЗ				= Формат(Окр(СтрокаИтога.ТекОснЗарплата,КолЗнаков),СтрокаФормата);
						ИтогГлава.Параметры.ИтогЭМ				= Формат(Окр(СтрокаИтога.ТекЭксплМашин,	КолЗнаков),СтрокаФормата);
						ИтогГлава.Параметры.ИтогЭМвтч 			= Формат(Окр(СтрокаИтога.ТекЗарплМашин,	КолЗнаков),СтрокаФормата);
						ИтогГлава.Параметры.ИтогЗатрТрРаб		= Окр(СтрокаИтога.ЗатратыТрудаРабочих,	2);
						ИтогГлава.Параметры.ИтогЗатрТрМех		= Окр(СтрокаИтога.ЗатратыТрудаМашин,	2);
						ПеременныеДляПовтора.ПредИтог			= Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков);
					КонецЕсли;
				КонецЕсли;
				Если НЕ ПараметрыПечати.Это11Граф И НЕ ПараметрыПечати.Это11ГрафСНРиСП
					И НЕ ПараметрыПечати.Это12Граф И НЕ ПараметрыПечати.ЭтоМетодикаТСН11а
					И НЕ ПараметрыПечати.ЭтоМетодикаТСН11б И НЕ ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
					Если ПараметрыПечати.ВБазисномУровне Тогда
						ИтогГлава.Параметры.ИтогМат				= Формат(Окр(СтрокаИтога.СтоимМатер,	КолЗнаков),СтрокаФормата);
						ПеременныеДляПовтора.ПредИтог			= Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков);
					Иначе
						ИтогГлава.Параметры.ИтогМат				= Формат(Окр(СтрокаИтога.ТекСтоимМатер,	КолЗнаков),СтрокаФормата);
						ПеременныеДляПовтора.ПредИтог			= Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков);
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
			
		КонецЕсли;
		
		ПоследняяОбласть = ТабличныйДокумент.Вывести(ИтогГлава);
		
	КонецЦикла;	
	
	Если ПоследняяОбласть <> Неопределено И ПараметрыПечати.ПечататьСетку Тогда
		Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
		ПоследняяОбласть.Обвести(Линия, , Линия, Линия);
	КонецЕсли;
	
КонецПроцедуры	

// Процедура выводит область "Согласовано/Утверждаю" из переданного документа (Ссылка) в ТабличныйДокумент.
//	Ссылка может принимать значение как документ "Акт выполненных работ", так И документ "Локальная смета".
//
Процедура ВывестиСогласованоУтверждаю(ТабличныйДокумент, Ссылка, ОбластьСогласованоУтверждаю, Стоимости);
	
	ОбластьСогласованоУтверждаю.Параметры.СуммаСметы = Формат(Стоимости.СметнаяСтоимость,"ЧДЦ=2");
	ОбластьСогласованоУтверждаю.Параметры.СогласованоПодпись = "                                         "; 
	ОбластьСогласованоУтверждаю.Параметры.УтверждаюПодпись = "                                  ";
	
	// ***************************************
	// -- AVV Вывод валюты в области "Согласовано/Утверждаю"  
	ОбластьСогласованоУтверждаю.Параметры.Заполнить(ПолучитьСтруктуруОбозначенияВалюты(Ссылка));
	// -- AVV Вывод валюты в области "Согласовано/Утверждаю" 
	// ***************************************
	
	Для Каждого СтрокаПодписи Из Ссылка.Подписи Цикл 
		Если Найти(ВРег(СтрокаПодписи.Статус), "СОГЛАСОВ")>0 Тогда
			ОбластьСогласованоУтверждаю.Параметры.СогласованоПодпись = СокрЛП(СтрокаПодписи.ФИО);
		ИначеЕсли Найти(ВРег(СтрокаПодписи.Статус), "УТВЕР")>0 Тогда
			ОбластьСогласованоУтверждаю.Параметры.УтверждаюПодпись = СокрЛП(СтрокаПодписи.ФИО);
		КонецЕсли;
	КонецЦикла;
	ТабличныйДокумент.Вывести(ОбластьСогласованоУтверждаю);
	
КонецПроцедуры

// Процедура выводит возвратные материалы из переданного документа (Ссылка) в ТабличныйДокумент.
//	Ссылка может принимать значение как документ "Акт выполненных работ", так И документ "Локальная смета".
//
Процедура ВывестиВозвраты(ТабличныйДокумент,Ссылка,ПараметрыПечати,ИтогСмета)
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = Истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	СтрокаФормата = ?(КолЗнаков = 0, "ЧДЦ=0","ЧДЦ=2");
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ИтогиПоСмете.Итог,
	|СУММА(ИтогиПоСмете.ТекВозвратМатер) КАК ТекВозвратМатер,
	|СУММА(ИтогиПоСмете.ВозвратМатер) КАК ВозвратМатер
	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоСмете КАК ИтогиПоСмете
	|ГДЕ
	|	ИтогиПоСмете.Смета = &Смета 
	|	И ИтогиПоСмете.Итог = &Итог 
	|СГРУППИРОВАТЬ ПО
	|	ИтогиПоСмете.Итог
	| ";
	
	Если ПечатьАкта Тогда
		Запрос.УстановитьПараметр("Смета",ПараметрыПечати.АктСсылка);
		Методика = ПараметрыПечати.АктСсылка.ЛокальнаяСмета.МетодикаРасчета;
	Иначе
		Запрос.УстановитьПараметр("Смета",ПараметрыПечати.СметаСсылка);
		Методика = ПараметрыПечати.СметаСсылка.МетодикаРасчета;
	КонецЕсли;
	Запрос.УстановитьПараметр("Итог",Справочники.СМ_ИтогиПоСмете.ВсегоПоСмете);
	ПрямЗатраты = 0;
	ТекПрямЗатраты = 0;
	Итог = "";	
	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество() <> 0 Тогда
		СтрокаВыборки = Выборка[0];
		ПрямЗатраты = СтрокаВыборки.ВозвратМатер;
		ТекПрямЗатраты = СтрокаВыборки.ТекВозвратМатер;
		Итог =   "Стоимость возвратных материалов";
	КонецЕсли;
	Если ПрямЗатраты = 0 И ТекПрямЗатраты = 0 Тогда Возврат;
	КонецЕсли;	
	Если ПечатьАкта Тогда
		ИтогСмета.Параметры.НаименованиеИтога = ПолучитьНаименованиеИтога(Методика,Выборка.Итог);
		Если ПараметрыПечати.ЭтоРесурсная Тогда
			
			Если ПараметрыПечати.ЭтоКС2Рес Тогда
				ИтогСмета.Параметры.Итог			= Формат(Окр(ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
			Иначе
				ИтогСмета.Параметры.ПрямыеЗатраты   = Формат(Окр(ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
			КонецЕсли;
		Иначе
			ИтогСмета.Параметры.Итог			= Формат(Окр(ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
			
		КонецЕсли;
	Иначе
		ИтогСмета.Параметры.НаименованиеИтога = ПолучитьНаименованиеИтога(Методика,Выборка.Итог);
		Если ПараметрыПечати.ЭтоРесурсная Тогда
			Если ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
				ИтогСмета.Параметры.Итог		= Формат(Окр(ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
				ИтогСмета.Параметры.ИтогБазис	= Формат(Окр(ПрямЗатраты,КолЗнаков),СтрокаФормата);
				
			ИначеЕсли ПараметрыПечати.ЭтоРесурсная12Граф Тогда
				Если ПараметрыПечати.ВБазисномУровне Тогда
					ИтогСмета.Параметры.ПрямыеЗатраты		= Формат(Окр(ПрямЗатраты,КолЗнаков),СтрокаФормата);
				Иначе	
					ИтогСмета.Параметры.ПрямыеЗатраты		= Формат(Окр(ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
				КонецЕсли;
			Иначе	
				Если НЕ ПараметрыПечати.ЭтоРесурсная7Граф Тогда
					ИтогСмета.Параметры.ОбщБазис = Формат(Окр(ПрямЗатраты,КолЗнаков),СтрокаФормата);
					ИтогСмета.Параметры.ОбщТек = Формат(Окр(ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
				Иначе
					Если ПараметрыПечати.ВБазисномУровне Тогда
						ИтогСмета.Параметры.ОбщТек = Формат(Окр(ПрямЗатраты,КолЗнаков),СтрокаФормата);
					Иначе	
						ИтогСмета.Параметры.ОбщТек = Формат(Окр(ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
			
		Иначе
			Если ПараметрыПечати.ВБазисномУровне Тогда
				ИтогСмета.Параметры.Итог = Формат(Окр(ПрямЗатраты,КолЗнаков),СтрокаФормата);
			Иначе
				ИтогСмета.Параметры.Итог = Формат(Окр(ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
			КонецЕсли;
			Если ПараметрыПечати.ЭтоМетодикаТСН11б Или ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
				ИтогСмета.Параметры.ИтогБазис = Формат(Окр(ПрямЗатраты,КолЗнаков),СтрокаФормата);
				ИтогСмета.Параметры.Итог = Формат(Окр(ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	ТабличныйДокумент.Вывести(ИтогСмета);

КонецПроцедуры

// Процедура выводит подписи из переданного документа (Ссылка) в ТабличныйДокумент.
//	Ссылка может принимать значение как документ "Акт выполненных работ", так И документ "Локальная смета".
//
Процедура ВывестиПодписи(ТабличныйДокумент,Ссылка,Подписи,ВыводитьВШапку)
	
	Для Каждого СтрокаПодписи Из Ссылка.Подписи Цикл
		Если ВыводитьВШапку И Ссылка.ПечататьСогласованоУтверждаю Тогда
			Если Найти(ВРег(СтрокаПодписи.Статус), "СОГЛАСОВ")>0 Или Найти(ВРег(СтрокаПодписи.Статус), "УТВЕР")>0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если СтрокаПодписи.ВыводитьВШапку = ВыводитьВШапку Тогда
			ПараметрыЗаполнения = Новый Структура;
			ПараметрыЗаполнения.Вставить("Статус", СтрокаПодписи.Статус);
			ПараметрыЗаполнения.Вставить("ФИО", СтрокаПодписи.ФИО);
			ПараметрыЗаполнения.Вставить("Должность", СтрокаПодписи.Должность);
			Подписи.Параметры.Заполнить(ПараметрыЗаполнения);
			ТабличныйДокумент.Вывести(Подписи);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры	

