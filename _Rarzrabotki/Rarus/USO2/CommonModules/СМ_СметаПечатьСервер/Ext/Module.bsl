				Если ПозицияСметы.ПоправочныйКоэффициентКНРБазисный <> 0 Тогда
					КоэффициентыНаПечатьБазис = КоэффициентыНаПечатьБазис + "*" + Строка(ПозицияСметы.ПоправочныйКоэффициентКНРБазисный);
				КонецЕсли;	
				
				Если ПозицияСметы.КоэффициентКНРАЭСБазисный <> 0 Тогда
					КоэффициентыНаПечатьБазис = КоэффициентыНаПечатьБазис + "*" + Строка(ПозицияСметы.КоэффициентКНРАЭСБазисный);
				КонецЕсли;	
				
				Если ПозицияСметы.КоэффициентКНРНаРемонтБазисный <> 0 Тогда
					КоэффициентыНаПечатьБазис = КоэффициентыНаПечатьБазис + "*" + Строка(ПозицияСметы.КоэффициентКНРНаРемонтБазисный);
