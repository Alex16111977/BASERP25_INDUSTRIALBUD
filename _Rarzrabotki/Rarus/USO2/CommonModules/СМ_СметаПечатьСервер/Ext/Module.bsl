// Функция определяет есть ли в акте итоги по разделу.
//  Раздел - текущий раздел, для которого определяется наличие итогов.
//	РодительРаздел - родитель текущего раздела.
//  АктСсылка - текущий акт.
Функция ЕстьИтогиПоРазделу(Раздел,РодительРаздел,АктСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИтогиПоРазделу.Итог КАК Итог,
	|	СУММА(ИтогиПоРазделу.ТекПрямЗатраты) КАК ТекПрямЗатраты,
	|	СУММА(ИтогиПоРазделу.ПрямЗатраты) КАК ПрямЗатраты
	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоРазделу КАК ИтогиПоРазделу
	|ГДЕ
	|	ИтогиПоРазделу.Раздел = &Раздел
	|	И ИтогиПоРазделу.Раздел.ИДРодителя = &РодительРаздел
	|	И ИтогиПоРазделу.Смета = &Смета
	|
	|СГРУППИРОВАТЬ ПО
	|	ИтогиПоРазделу.Итог
	|
	|УПОРЯДОЧИТЬ ПО 
	|	ИтогиПоРазделу.Итог.ПорядковыйНомер";
	//
	
	Запрос.УстановитьПараметр("Смета",АктСсылка);
	Запрос.УстановитьПараметр("Раздел",Раздел);	
	Запрос.УстановитьПараметр("РодительРаздел",РодительРаздел);	
	Выборка = Запрос.Выполнить().Выбрать();
	Рез = Ложь;
	КоличествоИтогов = Выборка.Количество();
	Если КоличествоИтогов <> 0 Тогда
		Пока Выборка.Следующий() Цикл
			Если Выборка.Итог = Справочники.СМ_ИтогиПоРазделу.ВсегоПоРазделу Тогда
				Всего = Выборка.ТекПрямЗатраты + Выборка.ПрямЗатраты;
				Рез = ?(Всего = 0,Ложь,Истина);
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
	
	Возврат(Рез);
КонецФункции						

// Функция возвращает строку расшифровки начислений по итогу для раздела.
//  Параметы - Итог числовых параметров по разделу.
//  Раздел - текущий раздел, для которого формируется строка расшифровки.
//	ТекСсылка может принимать значение как документ "Акт выполненных работ", так и документ "Локальная смета".
//
Функция ПолучитьРасшифровкуЧП(Итог,Раздел,ТекСсылка)
	СтрокаРасшифровки = "";
	ЧП = неопределено;
	БылаРасшифровка = ложь;
	ЗапросСпр = Новый Запрос;
	ЗапросСпр.текст = "ВЫБРАТЬ
	|	ЧисловыеПараметрыПриемник.Ссылка
	|ИЗ
	|	Справочник.СМ_ЧисловыеПараметры.Приемник КАК ЧисловыеПараметрыПриемник
	|ГДЕ
	|	ЧисловыеПараметрыПриемник.КЧему = &КЧему";
	ЗапросСпр.УстановитьПараметр("КЧему",Итог);				 
	ВыборкаЧП = Запросспр.Выполнить().Выбрать();
	Пока ВыборкаЧП.Следующий() Цикл
		ЧП = ВыборкаЧП.Ссылка;	
		
		Если ЧП <> Неопределено Тогда
			
			ЗапросСпр = Новый Запрос;
			ЗапросСпр.Текст = "
			|ВЫБРАТЬ
			|	ИтогиЧППоРазделу.Позиция
			|ИЗ
			|	РегистрСведений.СМ_ИтогиЧППоРазделу КАК ИтогиЧППоРазделу
			|ГДЕ
			|	ИтогиЧППоРазделу.Раздел = &Раздел
			|	И ИтогиЧППоРазделу.Итог = &Итог 
			|   И ИтогиЧППоРазделу.Смета = &Смета
			|
			|УПОРЯДОЧИТЬ ПО
			|	ИтогиЧППоРазделу.Итог.ПорядковыйНомер";
			
			ЗапросСпр.УстановитьПараметр("Смета",ТекСсылка);
			
			ЗапросСпр.УстановитьПараметр("Раздел",	Раздел);
			ЗапросСпр.УстановитьПараметр("Итог",	Итог);	
			
			ВыборкаСпр = ЗапросСпр.Выполнить().Выбрать();
			
			тзЧП = Новый ТаблицаЗначений;
			тзЧП.Колонки.Добавить("ЧП");
			тзЧП.Колонки.Добавить("Значение");
			тзЧП.Колонки.Добавить("ПорНомер");
			
			Пока ВыборкаСпр.Следующий() Цикл
				нОтбор = Новый Структура;
				нОтбор.Вставить("ЧисловойПараметр",ЧП);
				нСтроки = ВыборкаСпр.Позиция.НачисленияПозиции.НайтиСтроки(нОтбор);
				Для каждого нСтрока Из нСтроки Цикл
					
					Если нстрока.значение = ЧП.СтандартноеЗначение Тогда
						Продолжить;
					КонецЕсли;	
					
					Номера = СМ_СметаВызовСервера.ПолучитьНомерДокумента(ВыборкаСпр.Позиция, "СМ_ПозицияЛокальнойСметы");
					
					нов = тзЧП.Добавить();
					нов.ЧП = ЧП;
					нов.Значение = нстрока.Значение;
					нов.ПорНомер = Номера.ПорНомер;
					
				КонецЦикла;
			КонецЦикла;	
			
			тзЧП.Сортировать("ЧП,Значение,ПорНомер");
			Если Не БылаРасшифровка Тогда
				СтрокаРасшифровки = Сокрлп(Итог.Наименование)+" [";
			КонецЕсли;
			ПредЧП = "";
			ПредЗначение = "";
			
			Для каждого стрЧП Из тзЧП Цикл
				Если ПредЧП <> стрчп.ЧП ИЛИ ПредЗначение <> стрЧп.Значение Тогда
					СтрокаРасшифровки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1%2=%3 по поз. %4,'")+" ", СтрокаРасшифровки, СокрЛП(стрчп.Чп.Идентификатор), Строка(стрчп.Значение), строка(стрчп.ПорНомер));
					ПредЧП = стрЧП.ЧП;
					ПредЗначение = стрЧп.Значение;
				Иначе
					СтрокаРасшифровки = СтрокаРасшифровки + строка(стрчп.ПорНомер)+", ";
				КонецЕсли;
				БылаРасшифровка = истина;
			КонецЦикла;	
		КонецЕсли;
	КонецЦикла;
	
	Если БылаРасшифровка Тогда
		СтрокаРасшифровки = Лев(СтрокаРасшифровки,стрДлина(СтрокаРасшифровки)-2)+"]";
	Иначе
		СтрокаРасшифровки = Лев(СтрокаРасшифровки,стрДлина(СтрокаРасшифровки)-2);
	КонецЕсли;	

	Возврат СтрокаРасшифровки ;
КонецФункции						

// Функция получает затраты труда рабочих для печати.
// 	Формы 12 граф ресурсной сметы.
Функция ПолучитьЗТР(Ссылка,ИсточникЗапроса,ПараметрыПечати)
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("ЗатратыТрудаРабочих",		 0);
	СтруктураОтвета.Вставить("ЗатратыТрудаМашинистов",	 0);
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СУММА(ЗапросЗТР.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
	|	СУММА(ЗапросЗТР.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих
	|ИЗ
	|	РегистрСведений." + ИсточникЗапроса+" КАК ЗапросЗТР
	|ГДЕ
	|	ЗапросЗТР.Позиция = &Позиция
	|	И ЗапросЗТР.Смета = &Смета";
	
	Запрос.УстановитьПараметр("Позиция",Ссылка);
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	Если ПечатьАкта Тогда
		Запрос.УстановитьПараметр("Смета",ПараметрыПечати.АктСсылка);
	Иначе
		Запрос.УстановитьПараметр("Смета",ПараметрыПечати.СметаСсылка);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() <> 0  Тогда
		Пока Выборка.Следующий() Цикл
			СтруктураОтвета.Вставить("ЗатратыТрудаРабочих",?(Выборка.ЗатратыТрудаРабочих = Null,0,Выборка.ЗатратыТрудаРабочих));
			СтруктураОтвета.Вставить("ЗатратыТрудаМашинистов",?(Выборка.ЗатратыТрудаМашин = Null,0,Выборка.ЗатратыТрудаМашин));
		КонецЦикла;	
	КонецЕсли;	
	
	Возврат СтруктураОтвета;
	
КонецФункции	

// Функция получает из регистра "Стоимость ресурсов позиции" количество И стоимости ресурса по позиции ЛС.
//
Функция ПолучитьКоличествоИСтоимостьРесурсаВПозиции(ПозицияСметы,Ресурс,ПараметрыПечати)
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СтоимостьРесурсовПозиции.Количество КАК КолРесурса,
	               |	СтоимостьРесурсовПозиции.СтоимостьБазисная,
	               |	СтоимостьРесурсовПозиции.СтоимостьТекущая,
	               |	СтоимостьРесурсовПозиции.НормаРасхода,
	               |	СтоимостьРесурсовПозиции.СтоимостьТекущаяЗМ,
	               |	СтоимостьРесурсовПозиции.СтоимостьЗМБазисная
	               |ИЗ
	               |	РегистрСведений.СМ_СтоимостьРесурсовПозиции КАК СтоимостьРесурсовПозиции
	               |ГДЕ
	               |	СтоимостьРесурсовПозиции.Ресурс = &Ресурс
	               |	И СтоимостьРесурсовПозиции.Смета = &Смета
	               |	И СтоимостьРесурсовПозиции.Позиция = &Позиция";
	
	Запрос.УстановитьПараметр("Ресурс",	 Ресурс);				
	Запрос.УстановитьПараметр("Позиция", ПозицияСметы);
	Если ПечатьАкта Тогда
		Запрос.УстановитьПараметр("Смета",ПараметрыПечати.АктСсылка);
	Иначе
		Запрос.УстановитьПараметр("Смета",ПараметрыПечати.СметаСсылка);
	КонецЕсли;
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("Количество",			0);
	СтруктураОтвета.Вставить("СтоимостьБазисная",	0);
	СтруктураОтвета.Вставить("СтоимостьТекущая",	0);
	СтруктураОтвета.Вставить("НормаРасхода",		0);
	СтруктураОтвета.Вставить("СтоимостьТекущаяЗМ",	0);
	СтруктураОтвета.Вставить("СтоимостьБазиснаяЗМ",	0);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтруктураОтвета.Вставить("Количество",			выборка.КолРесурса);
		СтруктураОтвета.Вставить("СтоимостьБазисная",	выборка.СтоимостьБазисная);
		СтруктураОтвета.Вставить("СтоимостьТекущая",	выборка.СтоимостьТекущая);
		СтруктураОтвета.Вставить("НормаРасхода",		выборка.НормаРасхода);
		СтруктураОтвета.Вставить("СтоимостьТекущаяЗМ",	выборка.СтоимостьТекущаяЗМ);
		СтруктураОтвета.Вставить("СтоимостьБазиснаяЗМ",	выборка.СтоимостьЗМБазисная);
	КонецЕсли;	
	
	Возврат СтруктураОтвета;
	
КонецФункции

// Формируем и возвращаем строку коэффициентов по задонной Табличной части.
//
Функция ПосчитатьКоэффициенты(ИмяТЧ,ИмяРеквизита,ПозицияСметы)
	
	Результат = 0;
	
	Для каждого СтрокаК Из ПозицияСметы[ИмяТЧ] Цикл
		Если ИмяТЧ = "ПоправкиПозиции" Тогда
			Если СтрокаК.Применить = Истина Тогда
				Если СтрокаК[ИмяРеквизита] <> 0 Тогда
					Если Результат = 0 Тогда
						Результат = СтрокаК[ИмяРеквизита];
					Иначе
						Результат = Результат * СтрокаК[ИмяРеквизита];
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
		Иначе
			Если СтрокаК[ИмяРеквизита] <> 0 Тогда
				Если Результат = 0 Тогда
					Результат = СтрокаК[ИмяРеквизита];
				Иначе
					Результат = Результат * СтрокаК[ИмяРеквизита];
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЦикла;	
	// Обработка поправки к ПЗ.
	Если ИмяТЧ = "ПоправкиПозиции" Тогда
		Для каждого СтрокаК Из ПозицияСметы[ИмяТЧ] Цикл
			Если СтрокаК.Применить = Истина Тогда
				Если СтрокаК.КоэффПЗ <> 0 Тогда
					Если Результат = 0 Тогда
						Результат = СтрокаК.КоэффПЗ;
					Иначе
						Результат = Результат * СтрокаК.КоэффПЗ;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Результат = 0 Тогда
		Возврат "";
	Иначе
		Возврат Окр(Результат,3);
	КонецЕсли;	      	
	
КонецФункции	

// Получаем единичные стоимости позиции для целей печати.
//
Функция ПолучитьЕдиничныеСтоимостиПозиции(Ссылка,ПараметрыПечати,УмножатьНаОбъем,ОбъемАкт = 0)
	
	ОкруглятьДоРублей = ПараметрыПечати.ОкруглятьДоРублей;
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	Стоимости = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимПрямЗатраты) КАК СтоимПрямЗатраты,
	               |	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимОснЗарплата) КАК СтоимОснЗарплата,
	               |	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимОборуд) КАК СтоимОборуд,
	               |	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимЭксплМашин) КАК СтоимЭксплМашин,
	               |	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимЗарплМашин) КАК СтоимЗарплМашин,
	               |	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.СтоимСтоимМатер) КАК СтоимСтоимМатер,
	               |	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
	               |	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
	               |	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимОборуд) КАК ТекСтоимОборуд,
	               |	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимПрямЗатраты) КАК ТекСтоимПрямЗатраты,
	               |	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимОснЗарплата) КАК ТекСтоимОснЗарплата,
	               |	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимЭксплМашин) КАК ТекСтоимЭксплМашин,
	               |	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимСтоимМатер) КАК ТекСтоимСтоимМатер,
	               |	СУММА(БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимЗарплМашин) КАК ТекСтоимЗарплМашин
	               |ИЗ
	               |	РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП КАК БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП
	               |ГДЕ
	               |	БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция = &Позиция
	               |	И БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Смета = &Смета";
	
	Запрос.УстановитьПараметр("Позиция",Ссылка);
	Если ПечатьАкта Тогда
		Запрос.УстановитьПараметр("Смета",ПараметрыПечати.АктСсылка);
	Иначе
