// Получаем стоимости позциии ЛС из нужных регистров, исходя из источникЗапроса.
//
Функция ПолучитьСтоимостиПозиции(Ссылка,ПараметрыПечати,УмножатьНаОбъем,ИсточникЗапроса = Неопределено,ОбъемАкт = 0)
	
	ОкруглятьДоРублей = ПараметрыПечати.ОкруглятьДоРублей;
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	Если ИсточникЗапроса = Неопределено Тогда
		ИсточникЗапроса = "СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета";
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СУММА(ЗапросСтоимостей.СтоимОснЗарплата) КАК СтоимОснЗарплата,
	|	СУММА(ЗапросСтоимостей.СтоимЭксплМашин) КАК СтоимЭксплМашин,
	|	СУММА(ЗапросСтоимостей.СтоимЗарплМашин) КАК СтоимЗарплМашин,
	|	СУММА(ЗапросСтоимостей.СтоимСтоимМатер) КАК СтоимСтоимМатер,
	|	СУММА(ЗапросСтоимостей.СтоимОборуд) КАК СтоимОборуд,
	|	СУММА(ЗапросСтоимостей.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
	|	СУММА(ЗапросСтоимостей.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
	|	СУММА(ЗапросСтоимостей.СтоимПрямЗатраты) КАК СтоимПрямЗатраты";
	
	Если ИсточникЗапроса = "СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками" Тогда
		Запрос.Текст = Запрос.Текст + "	   
		|,	СУММА(ЗапросСтоимостей.ТекСтоимПрямЗатраты) КАК ТекСтоимПрямЗатраты
		|,	СУММА(ЗапросСтоимостей.ТекСтоимОснЗарплата) КАК ТекСтоимОснЗарплата
		|,	СУММА(ЗапросСтоимостей.ТекСтоимЭксплМашин) КАК ТекСтоимЭксплМашин
		|,	СУММА(ЗапросСтоимостей.ТекСтоимСтоимМатер) КАК ТекСтоимСтоимМатер
		|,	СУММА(ЗапросСтоимостей.ТекСтоимЗарплМашин) КАК ТекСтоимЗарплМашин
		|,	СУММА(ЗапросСтоимостей.ТекСтоимОборуд) КАК ТекСтоимОборуд";
	КонецЕсли;
	
	Если ИсточникЗапроса = "СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП" Тогда
		Запрос.Текст = Запрос.Текст + "	   
		|,	СУММА(ЗапросСтоимостей.ТекСтоимПрямЗатраты) КАК ТекСтоимПрямЗатраты
		|,	СУММА(ЗапросСтоимостей.ТекСтоимОснЗарплата) КАК ТекСтоимОснЗарплата
		|,	СУММА(ЗапросСтоимостей.ТекСтоимЭксплМашин) КАК ТекСтоимЭксплМашин
		|,	СУММА(ЗапросСтоимостей.ТекСтоимСтоимМатер) КАК ТекСтоимСтоимМатер
		|,	СУММА(ЗапросСтоимостей.ТекСтоимЗарплМашин) КАК ТекСтоимЗарплМашин
		|,	СУММА(ЗапросСтоимостей.ТекСтоимОборуд) КАК ТекСтоимОборуд";
		
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
	|ИЗ
	|	РегистрСведений." + ИсточникЗапроса+" КАК ЗапросСтоимостей
	|ГДЕ
	|	ЗапросСтоимостей.Позиция = &Позиция 
	|	И ЗапросСтоимостей.Смета = &Смета";
	
	Запрос.УстановитьПараметр("Позиция",Ссылка);
	Если ПечатьАкта Тогда
		Запрос.УстановитьПараметр("Смета",ПараметрыПечати.АктСсылка);
	Иначе
		Запрос.УстановитьПараметр("Смета",ПараметрыПечати.СметаСсылка);
	КонецЕсли;
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("ОбщОЗ",				0);
	СтруктураОтвета.Вставить("ОбщПЗ",				0);
