					КонецЕсли;
					
					Если ПозицияСметы.КоэффициентКСПУСНБазисный <> 0 Тогда
						Наименование = Наименование + "*" + Строка(ПозицияСметы.КоэффициентКСПУСНБазисный);
					КонецЕсли;
				Иначе
					Если ПозицияСметы.ПоправочныйКоэффициентКСПБазисный <> 0 Тогда
						Наименование = Наименование + "*" + Строка(ПозицияСметы.ПоправочныйКоэффициентКСПТекущий);
					КонецЕсли;	
					
					Если ПозицияСметы.КоэффициентКСПАЭСТекущий <> 0 Тогда
						Наименование = Наименование + "*" + Строка(ПозицияСметы.КоэффициентКСПАЭСТекущий);
					КонецЕсли;	
					
					Если ПозицияСметы.КоэффициентКСПНаРемонтТекущий <> 0 Тогда
