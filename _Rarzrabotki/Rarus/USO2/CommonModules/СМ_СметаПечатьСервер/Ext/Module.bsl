// Получить факт объем позиции по акту.
//
Функция ПолучитьОбъемПоПозицииАкта(АктСсылка,ПозицияСсылка)
	
	ТекСтрока = АктСсылка.Позиции.Найти(ПозицияСсылка);
	Если ТекСтрока = Неопределено Тогда
		Возврат 0;
	Иначе
		Возврат ТекСтрока.ФактОбъем;
	КонецЕсли;
	
КонецФункции

// Получить текущую цену позиции по акту.
//
Процедура ПолучитьТекущуюЦенуПоПозицииАкта(АктСсылка,ПозицияСсылка,СтруктураЦен)
	
	ТекСтрока = АктСсылка.Позиции.Найти(ПозицияСсылка);
	Если ТекСтрока <> Неопределено Тогда
		СтруктураЦен.ТекущаяЦена = ТекСтрока.ТекущаяЦена;
		СтруктураЦен.ТекущаяЗарплатаМашинистов = ТекСтрока.ТекущаяЗарплатаМашинистов;
	КонецЕсли;
	
КонецПроцедуры

// Получить норму расхода ресурса.
//
Функция ПолучитьНорму(ПозицияСсылка,РесурсСсылка)
	Норма = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.НормаРасхода
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы.РесурсыПозицииЛокальнойСметы КАК ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы
	               |ГДЕ
	               |	ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ссылка = &Ссылка
	               |	И ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ресурс = &РесурсСсылка";
	Запрос.УстановитьПараметр("Ссылка",ПозицияСсылка);
	Запрос.УстановитьПараметр("РесурсСсылка",РесурсСсылка);
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() <> 0 Тогда
		Норма = Результат[0].НормаРасхода;
		Если Норма = Null Тогда Норма = 0; КонецЕсли;
	КонецЕсли;			
	Возврат(Норма);
КонецФункции

// Получить текст символьного представления валюты 
//Функция ПолучитьТекстОбозначенияВалюты(ТекСсылка) Экспорт
Функция ПолучитьСтруктуруОбозначенияВалюты(ТекСсылка) Экспорт

	СтруктураВалюты = Новый Структура;
	Если ПолучитьФункциональнуюОпцию("СМ_КЗ_МетодикаРСНБКазахстан") Тогда
		СтруктураВалюты.Вставить("ПечВалюта","тенге");
	Иначе
		СтруктураВалюты.Вставить("ПечВалюта","руб.");
	КонецЕсли;
	
	Если ТипЗнч(ТекСсылка) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		Если ЗначениеЗаполнено(ТекСсылка.ЛокальнаяСмета) Тогда
			Если ЗначениеЗаполнено(ТекСсылка.ЛокальнаяСмета.Валюта) Тогда
				СтруктураВалюты.ПечВалюта = ТекСсылка.ЛокальнаяСмета.Валюта.НаименованиеПолное;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ТекСсылка) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") ИЛИ 
			  ТипЗнч(ТекСсылка) = Тип("ДокументСсылка.СМ_СводнаяСмета") ИЛИ 
			  ТипЗнч(ТекСсылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		Если ЗначениеЗаполнено(ТекСсылка.Валюта) Тогда
			СтруктураВалюты.ПечВалюта = ТекСсылка.Валюта.НаименованиеПолное;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураВалюты;
	
КонецФункции

#КонецОбласти

#Область ПодготовкаПечатныхФормАкта

// Формирует форму М29.
//
Функция СформироватьОтчетМ29(МассивОбъектов, ОбъектыПечати, КомплектыПечати, ТолькоМатериалыФакт = Ложь)
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("АктВыполненныхРабот");
	ТЗ.Колонки.Добавить("Использовать");
	Для каждого эл Из МассивОбъектов Цикл
		стр = ТЗ.Добавить();
		стр.АктВыполненныхРабот = эл;
		стр.Использовать = Истина;
	КонецЦикла;
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Использовать",Истина);
	МассивАктов = ТЗ.НайтиСтроки(ПараметрыОтбора);
	
	Разделять 	= Истина;
	ТабДок 		= Новый ТабличныйДокумент;
	Отчеты.СМ_ОтчетОРасходеРесурсов.Создать().ПолучитьЗаполненныйОтчет(Разделять, МассивАктов, ТабДок, , ТолькоМатериалыФакт, ТолькоМатериалыФакт);
	
	Возврат ТабДок;
	
КонецФункции

