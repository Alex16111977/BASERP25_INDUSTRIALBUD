					СтрокаПозицияДопФОТ.Параметры.СтоимБазис          	= Формат(Окр((СуммыНРиСП.СуммаСПБазиснаяЗТМ + СуммыНРиСП.СуммаНРБазиснаяЗТМ),2),СтрокаФормата);
					СтрокаПозицияДопФОТ.Параметры.ЕдСтоим	          		= "";
				КонецЕсли;
				ТабличныйДокумент.вывести(СтрокаПозицияДопФОТ);
				
				
			КонецЕсли;
