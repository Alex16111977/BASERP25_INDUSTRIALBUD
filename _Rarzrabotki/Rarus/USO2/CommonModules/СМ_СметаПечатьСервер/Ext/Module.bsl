								ПеременныеДляПовтора.ПредОбщБазис	= Окр(СтрТабл.ПрямЗатраты,   КолЗнаков);
								ПеременныеДляПовтора.ПредОбщТек		= Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков);
							КонецЕсли;	
							
							Если НЕ ПараметрыПечати.ЭтоРесурсная12Граф  И НЕ ПараметрыПечати.ЭтоРесурсная7Граф И НЕ ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
								ИтогГлава.Параметры.ОбщБазис = Формат(Окр(СтрТабл.ПрямЗатраты,   КолЗнаков),СтрокаФормата);	
								ИтогГлава.Параметры.ОбщТек	 = Формат(Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
								
								ПеременныеДляПовтора.ПредОбщБазис	= Окр(СтрТабл.ПрямЗатраты,   КолЗнаков);
								ПеременныеДляПовтора.ПредОбщТек		= Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков);
							ИначеЕсли ПараметрыПечати.ЭтоРесурсная12Граф  Тогда
								Если ПараметрыПечати.ВБазисномУровне Тогда
									ИтогГлава.Параметры.ПрямыеЗатраты				= Формат(Окр(СтрТабл.ПрямЗатраты,КолЗнаков),СтрокаФормата);
									ИтогГлава.Параметры.ЗаработнаяПлата				= Формат(Окр(СтрТабл.ОснЗарплата,КолЗнаков),СтрокаФормата);
									ИтогГлава.Параметры.МашиныИМех					= Формат(Окр(СтрТабл.ЭксплМашин,	КолЗнаков),СтрокаФормата);
									ИтогГлава.Параметры.ЗрплМаш 					= Формат(Окр(СтрТабл.ЗарплМашин,	КолЗнаков),СтрокаФормата);
									ИтогГлава.Параметры.Метериалы					= Формат(Окр(СтрТабл.СтоимМатер,	КолЗнаков),СтрокаФормата);
