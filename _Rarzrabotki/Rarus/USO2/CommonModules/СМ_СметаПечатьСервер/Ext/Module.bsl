// Получаем стоимость ресурсов позиции локальной сметы.
//
Функция ПолучитьСтоимостиРесурсовПозиции(Ссылка,ОкруглятьДоРублей,УмножатьНаОбъем)
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СУММА(СтоимостьРесурсовПозиции.СтоимостьТекущая) КАК СтоимостьТекущая
	|ИЗ
	|	РегистрСведений.СМ_СтоимостьРесурсовПозиции КАК СтоимостьРесурсовПозиции
	|ГДЕ
	|	СтоимостьРесурсовПозиции.Позиция = &Позиция
	|	И ВЫБОР
	|			КОГДА СтоимостьРесурсовПозиции.Ресурс <> ЗНАЧЕНИЕ(Справочник.СМ_Ресурсы.ПустаяСсылка)
	|				ТОГДА СтоимостьРесурсовПозиции.Ресурс.ВидРесурса <> &ВидРесурса
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	Запрос.УстановитьПараметр("Позиция",Ссылка);
	Запрос.УстановитьПараметр("ВидРесурса",	Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов);
	Выборка = запрос.Выполнить().Выбрать();
	Стоимости = Новый Структура;
	Стоимости.Вставить("СтоимостьТекущая", 		0);
	
	Если Выборка.Следующий() Тогда
		
		Если НЕ Выборка.СтоимостьТекущая = null Тогда
			
			ЧУ = 1;
			Если УмножатьНаОбъем = истина Тогда
				ЧУ = Ссылка.ОбъемРабот;
			КонецЕсли;	
			
			КолЗнаков = 2;
			Если ОкруглятьДоРублей = истина Тогда
				КолЗнаков = 0;		
			КонецЕсли;
			
			Стоимости.Вставить("СтоимостьТекущая", 		Окр(выборка.СтоимостьТекущая	* ЧУ,	КолЗнаков));
			
		КонецЕсли;
	КонецЕсли;	
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Стоимости;	
	
КонецФункции	

// Формируем наименование позиции локальной сметы для целей печати.
//
Функция СформироватьНаименованиеПозиции(Ссылка, ПараметрыПечати)
	
	Результат = СокрЛП(Ссылка.Наименование);
	
	Если ПараметрыПечати.ПечататьФормулыОбъема = истина И ЗначениеЗаполнено(Ссылка.ФормулаОбъема) Тогда
		
		Результат = Результат + "
		|V="+Сокрлп(Ссылка.ФормулаОбъема);
		
	КонецЕсли;	
	Если ПараметрыПечати.МетодикаТСН Тогда
		// Расшифровка ЗУ.
		Если НЕ ПараметрыПечати.ЭтоМетодикаТСН11а И  НЕ ПараметрыПечати.ЭтоМетодикаТСН11б  Тогда
			
			Результат = РасшифифровкаЗУПоПозиции(Результат,Ссылка, ПараметрыПечати);
		КонецЕсли;	
	КонецЕсли;	   		
	
	Если ПараметрыПечати.ПечататьФормулыЦен = истина И НЕ ПараметрыПечати.Это12Граф И НЕ ПараметрыПечати.ЭтоРесурсная Тогда
		
		Если ЗначениеЗаполнено(ссылка.ФормулаПЗ) Тогда
			Результат = Результат + "
			|ПЗ="+Сокрлп(Ссылка.ФормулаПЗ);
		КонецЕсли;
		Если ЗначениеЗаполнено(ссылка.ФормулаОЗ) Тогда
			Результат = Результат + "
			|ОЗ="+Сокрлп(Ссылка.ФормулаОЗ);
		КонецЕсли;
		Если ЗначениеЗаполнено(ссылка.ФормулаЭМ) Тогда
			Результат = Результат + "
			|ЭМ="+Сокрлп(Ссылка.ФормулаЭМ);
		КонецЕсли;
		Если ЗначениеЗаполнено(ссылка.ФормулаЗМ) Тогда
			Результат = Результат + "
			|ЗМ="+Сокрлп(Ссылка.ФормулаЗМ);
		КонецЕсли;
		Если ЗначениеЗаполнено(ссылка.ФормулаСМ) Тогда
			Результат = Результат + "
			|СМ="+Сокрлп(Ссылка.ФормулаСМ);
		КонецЕсли;
		Если ЗначениеЗаполнено(ссылка.ФормулаОБ) Тогда
			Результат = Результат + "
			|ОБ="+Сокрлп(Ссылка.ФормулаОБ);
		КонецЕсли;
		Если ПараметрыПечати.ВБазисномУровне = Ложь Тогда
			Если  Ссылка.НеПрименятьИндексы = Истина Тогда
				Если ЗначениеЗаполнено(ссылка.ФормулаТекущейЦены) Тогда
					РасшифровкаФормулы = "(" + Сокрлп(Ссылка.ФормулаТекущейЦены)+ ")";
					Результат = Результат +"
					|"+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Тек.цена=%1 %2'"), Ссылка.ТекущаяЦена,РасшифровкаФормулы);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если ПараметрыПечати.ПечататьФормулыЦен = истина И ПараметрыПечати.ЭтоРесурсная Тогда
		Если ЗначениеЗаполнено(ссылка.ФормулаТекущейЦены) Тогда
			РасшифровкаФормулы = "(" + Сокрлп(Ссылка.ФормулаТекущейЦены)+ ")";
			Результат = Результат +"
			|"+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Тек.цена=%1 %2'"), Ссылка.ТекущаяЦена,РасшифровкаФормулы);
		КонецЕсли;
	КонецЕсли;	
	
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	Если НЕ  ПечатьАкта Тогда
		Если НЕ ПараметрыПечати.МетодикаТСН Тогда
			Если НЕ ПараметрыПечати.Это13ГрафСНРиСП И НЕ ПараметрыПечати.Это11ГрафСНРиСП Тогда
				Если ПараметрыПечати.ПечатьНРиСППозиции = Истина Тогда
					Если ПараметрыПечати.ВБазисномУровне Тогда
						НР = Ссылка.НакладныеРасходыБазисные;
					Иначе	
						НР = Ссылка.НакладныеРасходыТекущие;
					КонецЕсли;	
					Если НР <> 0 Тогда
						Если ПараметрыПечати.ВБазисномУровне Тогда
							К1 = ?(Ссылка.ПоправочныйКоэффициентКНРБазисный = 0,1,Ссылка.ПоправочныйКоэффициентКНРБазисный);
							К2 = ?(Ссылка.КоэффициентКНРАЭСБазисный = 0,1,Ссылка.КоэффициентКНРАЭСБазисный);
							К3 = ?(Ссылка.КоэффициентКНРНаРемонтБазисный = 0,1,Ссылка.КоэффициентКНРНаРемонтБазисный);
							К4 = ?(Ссылка.КоэффициентКНРУСНБазисный = 0,1,Ссылка.КоэффициентКНРУСНБазисный);
						Иначе	
							К1 = ?(Ссылка.ПоправочныйКоэффициентКНРТекущий = 0,1,Ссылка.ПоправочныйКоэффициентКНРТекущий);
							К2 = ?(Ссылка.КоэффициентКНРАЭСТекущий = 0,1,Ссылка.КоэффициентКНРАЭСТекущий);
							К3 = ?(Ссылка.КоэффициентКНРНаРемонтТекущий = 0,1,Ссылка.КоэффициентКНРНаРемонтТекущий);
							К4 = ?(Ссылка.КоэффициентКНРУСНТекущий = 0,1,Ссылка.КоэффициентКНРУСНТекущий);
						КонецЕсли;
						НР = НР*К1*К2*К3*К4;
						
						Если ПараметрыПечати.ВБазисномУровне Тогда
							Если Константы.СМ_ОкруглятьНормативыНРиСПбазис.Получить() = Истина Тогда
								НР  = Окр(НР,0,РежимОкругления.Окр15как20);
							КонецЕсли;	
						Иначе
							Если Константы.СМ_ОкруглятьНормативыНРиСП.Получить() = Истина Тогда
								НР  = Окр(НР,0,РежимОкругления.Окр15как20);
							КонецЕсли;	
						КонецЕсли;
						ФормулаНР = "";
						Если к1 <> 1 Тогда
							ФормулаНР = ФормулаНР + "*" + СокрЛП(Строка(К1));
						КонецЕсли;	
						Если к2 <> 1 Тогда
							ФормулаНР = ФормулаНР + "*" + СокрЛП(Строка(К2));
						КонецЕсли;	
						Если к3 <> 1 Тогда
							ФормулаНР = ФормулаНР + "*" + СокрЛП(Строка(К3));
						КонецЕсли;	
						Если к4 <> 1 Тогда
							ФормулаНР = ФормулаНР + "*" + СокрЛП(Строка(К4));
						КонецЕсли;	
						Если ПараметрыПечати.ВБазисномУровне Тогда
							ФормулаНР = СокрЛП(Строка(Ссылка.НакладныеРасходыБазисные))+ "%" + ФормулаНР;
						Иначе
							ФормулаНР = СокрЛП(Строка(Ссылка.НакладныеРасходыТекущие))+ "%" + ФормулаНР;
						КонецЕсли;
						РасшифровкаНР = СокрЛП(Строка(НР)) + "% (" + ФормулаНР +")";
						Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1 
						|НР = %2'"), Результат, РасшифровкаНР);
					КонецЕсли;
					
					Если ПараметрыПечати.ВБазисномУровне Тогда
						СП = Ссылка.СметнаяПрибыльБазисные;
					Иначе
						СП = Ссылка.СметнаяПрибыльТекущие;
					КонецЕсли;
					Если СП <> 0 Тогда
						Если ПараметрыПечати.ВБазисномУровне Тогда
							К1 = ?(Ссылка.ПоправочныйКоэффициентКСПБазисный = 0,1,Ссылка.ПоправочныйКоэффициентКСПБазисный);
							К2 = ?(Ссылка.КоэффициентКСПАЭСБазисный = 0,1,Ссылка.КоэффициентКСПАЭСБазисный);
							К3 = ?(Ссылка.КоэффициентКСПНаРемонтБазисный = 0,1,Ссылка.КоэффициентКСПНаРемонтБазисный);
							К4 = ?(Ссылка.КоэффициентКСПУСНБазисный = 0,1,Ссылка.КоэффициентКСПУСНБазисный);
						Иначе	
							К1 = ?(Ссылка.ПоправочныйКоэффициентКСПТекущий = 0,1,Ссылка.ПоправочныйКоэффициентКСПТекущий);
							К2 = ?(Ссылка.КоэффициентКСПАЭСТекущий = 0,1,Ссылка.КоэффициентКСПАЭСТекущий);
							К3 = ?(Ссылка.КоэффициентКСПНаРемонтТекущий = 0,1,Ссылка.КоэффициентКСПНаРемонтТекущий);
							К4 = ?(Ссылка.КоэффициентКСПУСНТекущий = 0,1,Ссылка.КоэффициентКСПУСНТекущий);
						КонецЕсли;
						СП = СП*К1*К2*К3*К4;
						Если ПараметрыПечати.ВБазисномУровне Тогда
							Если Константы.СМ_ОкруглятьНормативыНРиСПбазис.Получить() = Истина Тогда
								СП  = Окр(СП,0,РежимОкругления.Окр15как20);
							КонецЕсли;	
						Иначе
							Если Константы.СМ_ОкруглятьНормативыНРиСП.Получить() = Истина Тогда
								СП  = Окр(СП,0,РежимОкругления.Окр15как20);
							КонецЕсли;	
						КонецЕсли;	
						ФормулаСП = "";
						Если к1 <> 1 Тогда
							ФормулаСП = ФормулаСП + "*" + СокрЛП(Строка(К1));
						КонецЕсли;	
						Если к2 <> 1 Тогда
							ФормулаСП = ФормулаСП + "*" + СокрЛП(Строка(К2));
						КонецЕсли;	
						Если к3 <> 1 Тогда
							ФормулаСП = ФормулаСП + "*" + СокрЛП(Строка(К3));
						КонецЕсли;	
						Если к4 <> 1 Тогда
							ФормулаСП = ФормулаСП + "*" + СокрЛП(Строка(К4));
						КонецЕсли;	
						Если ПараметрыПечати.ВБазисномУровне Тогда
							ФормулаСП = СокрЛП(Строка(Ссылка.СметнаяПрибыльБазисные))+ "%" + ФормулаСП;
						Иначе
							ФормулаСП = СокрЛП(Строка(Ссылка.СметнаяПрибыльТекущие))+ "%" + ФормулаСП;
						КонецЕсли;
						РасшифровкаСП = СокрЛП(Строка(СП)) + "% (" + ФормулаСП +")";
						Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1 
						|СП = %2'"), Результат, РасшифровкаСП);
					КонецЕсли;
					
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	Если ПараметрыПечати.ВБазисномУровне = Ложь Тогда
		Если ПараметрыПечати.БезПримененияКоэффициентов = Ложь Тогда
			
			Если  Ссылка.НеПрименятьИндексы = Ложь Тогда
				Если ПараметрыПечати.ПечататьИндексы = истина И НЕ ПараметрыПечати.Это12Граф И НЕ ПараметрыПечати.ЭтоРесурсная Тогда
					
					СтруктураКоэффициентов = Новый Структура;
					СтруктураКоэффициентов.Вставить("КоэффОснЗарплаты",			0);
					СтруктураКоэффициентов.Вставить("КоэффСтоимЭксплМашин",		0);
					СтруктураКоэффициентов.Вставить("КоэффСтоимЗарплатеМашин",	0);
					СтруктураКоэффициентов.Вставить("КоэффСтоимМатериалов",		0);
					СтруктураКоэффициентов.Вставить("КоэффОборуд",				0);
					СтруктураКоэффициентов.Вставить("КоэффПолнСтоимРабот",		0);
					
					Для каждого СтрокаК Из Ссылка.КоэффициентыПересчета Цикл
						Если ПечатьАкта = Ложь Тогда
							Для каждого ИмяКолонки Из Метаданные.Документы.СМ_ПозицияЛокальнойСметы.Табличныечасти.КоэффициентыПересчета.Реквизиты Цикл
								
								Если ИмяКолонки.Имя = "ВидРабот" ИЛИ ИмяКолонки.имя = "ВариантПересчетаЭММ" Тогда
									Продолжить;
								КонецЕсли;	
								
								Если СтрокаК[ИмяКолонки.имя] <> 0 Тогда
									Если СтруктураКоэффициентов[ИмяКолонки.Имя] = 0 Тогда
										СтруктураКоэффициентов[ИмяКолонки.Имя] = СтрокаК[ИмяКолонки.Имя];
									Иначе
										СтруктураКоэффициентов[ИмяКолонки.Имя] = СтрокаК[ИмяКолонки.Имя]*СтруктураКоэффициентов[ИмяКолонки.Имя];
									КонецЕсли;	
								КонецЕсли;	
							КонецЦикла;	
						Иначе
							ТекСтрока = ПараметрыПечати.АктСсылка.Позиции.Найти(Ссылка);
							Если ТекСтрока <> Неопределено Тогда
								СтруктураКоэффициентов.КоэффОснЗарплаты = ТекСтрока.КоэффОснЗарплаты;
								СтруктураКоэффициентов.КоэффСтоимЭксплМашин = ТекСтрока.КоэффСтоимЭксплМашин;
								СтруктураКоэффициентов.КоэффСтоимЗарплатеМашин = ТекСтрока.КоэффСтоимЗарплатеМашин;
								СтруктураКоэффициентов.КоэффСтоимМатериалов = ТекСтрока.КоэффСтоимМатериалов;
								СтруктураКоэффициентов.КоэффОборуд = ТекСтрока.КоэффОборуд;
								СтруктураКоэффициентов.КоэффПолнСтоимРабот = ТекСтрока.КоэффПолнСтоимРабот;
							КонецЕсли;	
						КонецЕсли;
					КонецЦикла;	
					
					Если ПараметрыПечати.СпособРасчета =  Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат Тогда
						
						Если СтруктураКоэффициентов.КоэффОснЗарплаты <> 0 Тогда
							Результат = Результат + ", Коз="+Сокрлп(СтруктураКоэффициентов.КоэффОснЗарплаты);
						КонецЕсли;
						Если СтруктураКоэффициентов.КоэффСтоимЭксплМашин <> 0 Тогда
							Результат = Результат + ", Кэмм="+Сокрлп(СтруктураКоэффициентов.КоэффСтоимЭксплМашин);
						КонецЕсли;
						Если СтруктураКоэффициентов.КоэффСтоимЗарплатеМашин <> 0 Тогда
							Результат = Результат + ", Кзм="+Сокрлп(СтруктураКоэффициентов.КоэффСтоимЗарплатеМашин);
						КонецЕсли;
						Если СтруктураКоэффициентов.КоэффСтоимМатериалов <> 0 Тогда
							Результат = Результат + ", Ксм="+Сокрлп(СтруктураКоэффициентов.КоэффСтоимМатериалов);
						КонецЕсли;
						Если СтруктураКоэффициентов.КоэффОборуд <> 0 Тогда
							Результат = Результат + ", Коб="+Сокрлп(СтруктураКоэффициентов.КоэффОборуд);
						КонецЕсли;
						Если СтруктураКоэффициентов.КоэффПолнСтоимРабот <> 0 Тогда
							Результат = Результат + ", Кпз="+Сокрлп(СтруктураКоэффициентов.КоэффПолнСтоимРабот);
						КонецЕсли;
						
					ИначеЕсли ПараметрыПечати.СпособРасчета =  Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости Тогда
						
						Если Ссылка.Определитель.ВидРабот =  перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
							Если СтруктураКоэффициентов.КоэффОборуд <> 0 Тогда
								Результат = Результат + ", Коб="+Сокрлп(СтруктураКоэффициентов.КоэффОборуд);
							КонецЕсли;	
						Иначе
							Если СтруктураКоэффициентов.КоэффПолнСтоимРабот <> 0 Тогда
								Результат = Результат + ", Кпз="+Сокрлп(СтруктураКоэффициентов.КоэффПолнСтоимРабот);
							КонецЕсли;
						КонецЕсли;
						
					КонецЕсли;	
					
				КонецЕсли;		
			КонецЕсли;		
		КонецЕсли;		
	КонецЕсли;		
	
	Если ПараметрыПечати.ПечататьКоэффициентыТЧ = истина ИЛИ ПараметрыПечати.Это12Граф Тогда
		
		БылаТЧ = ложь; 		
		
		СтруктураКоэффициентов = Новый Структура;
		СтруктураКоэффициентов.Вставить("КоэффПЗ",	"");
		СтруктураКоэффициентов.Вставить("КоэффОЗ",	"");
		СтруктураКоэффициентов.Вставить("КоэффЭМ",	"");
		СтруктураКоэффициентов.Вставить("КоэффЗМ",	"");
		СтруктураКоэффициентов.Вставить("КоэффСМ",	"");
		СтруктураКоэффициентов.Вставить("КоэффТР",	"");
		СтруктураКоэффициентов.Вставить("КоэффТМ",	"");
		
		Для каждого СтрокаК Из Ссылка.ПоправкиПозиции Цикл
			
			Если НЕ СтрокаК.Применить Тогда
				Продолжить;
			КонецЕсли;	
			
			Для каждого ИмяКолонки Из Метаданные.Документы.СМ_ПозицияЛокальнойСметы.Табличныечасти.ПоправкиПозиции.Реквизиты Цикл
				
				Если Лев(ИмяКолонки.Имя,5) <> "Коэфф" Тогда
					Продолжить;
				КонецЕсли;	
				
				Если СтрокаК[ИмяКолонки.имя] <> 0 Тогда
					Если СтруктураКоэффициентов[ИмяКолонки.имя] = "" Тогда
						СтруктураКоэффициентов[ИмяКолонки.имя] = Строка(СтрокаК[ИмяКолонки.имя]);
					Иначе
						СтруктураКоэффициентов[ИмяКолонки.имя] = Строка(СтрокаК[ИмяКолонки.имя]) +"*"+Строка(СтруктураКоэффициентов[ИмяКолонки.имя]);
					КонецЕсли;	
				КонецЕсли;	
			КонецЦикла;	
		КонецЦикла;	
		
		СтруктураКоэффициентов.коэффПЗ = СтрЗаменить(СтруктураКоэффициентов.КоэффПЗ,",",".");
		СтруктураКоэффициентов.КоэффОЗ = СтрЗаменить(СтруктураКоэффициентов.КоэффОЗ,",",".");
		СтруктураКоэффициентов.КоэффЭМ = СтрЗаменить(СтруктураКоэффициентов.КоэффЭМ,",",".");
		СтруктураКоэффициентов.КоэффЗМ = СтрЗаменить(СтруктураКоэффициентов.КоэффЗМ,",",".");
		СтруктураКоэффициентов.КоэффСМ = СтрЗаменить(СтруктураКоэффициентов.КоэффСМ,",",".");
		СтруктураКоэффициентов.КоэффТР = СтрЗаменить(СтруктураКоэффициентов.КоэффТР,",",".");
		СтруктураКоэффициентов.КоэффТМ = СтрЗаменить(СтруктураКоэффициентов.КоэффТМ,",",".");
		
		РезультатТЧ = "";
		
		Если СтруктураКоэффициентов.КоэффПЗ <> "" Тогда
			РезультатТЧ = РезультатТЧ + "К1="+Сокрлп(СтруктураКоэффициентов.КоэффПЗ)+", ";БылаТЧ = истина;
		КонецЕсли;
		Если СтруктураКоэффициентов.КоэффОЗ <> "" Тогда
			РезультатТЧ = РезультатТЧ + "К2="+Сокрлп(СтруктураКоэффициентов.КоэффОЗ)+", ";БылаТЧ = истина;
		КонецЕсли;
		Если СтруктураКоэффициентов.КоэффЭМ <> "" Тогда
			РезультатТЧ = РезультатТЧ + "К3="+Сокрлп(СтруктураКоэффициентов.КоэффЭМ)+", ";БылаТЧ = истина;
		КонецЕсли;
		Если СтруктураКоэффициентов.КоэффЗМ <> "" Тогда
			РезультатТЧ = РезультатТЧ + "К4="+Сокрлп(СтруктураКоэффициентов.КоэффЗМ)+", ";БылаТЧ = истина;
		КонецЕсли;
		Если СтруктураКоэффициентов.КоэффСМ <> "" Тогда
			РезультатТЧ = РезультатТЧ + "К5="+Сокрлп(СтруктураКоэффициентов.КоэффСМ)+", ";БылаТЧ = истина;
		КонецЕсли;
		Если СтруктураКоэффициентов.КоэффТР <> "" Тогда
			РезультатТЧ = РезультатТЧ + "К6="+Сокрлп(СтруктураКоэффициентов.КоэффТР)+", ";БылаТЧ = истина;
		КонецЕсли;
		Если СтруктураКоэффициентов.КоэффТМ <> "" Тогда
			РезультатТЧ = РезультатТЧ + "К7="+Сокрлп(СтруктураКоэффициентов.КоэффТМ)+", ";БылаТЧ = истина;
		КонецЕсли;
		
		Если БылаТЧ = истина Тогда
			
			Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1 
			|По тех. частям: %2'"), Результат, РезультатТЧ);
			Результат = Лев(Результат,СтрДлина(Результат)-2)+".";
			
		КонецЕсли;	
		
	КонецЕсли;	
	
	Если НЕ ПараметрыПечати.ПечататьРасшифровку  Или ПараметрыПечати.Это12Граф Тогда
		Для каждого СтрокаНачисления Из Ссылка.Начисленияпозиции Цикл
			Если  СтрокаНачисления.ЧисловойПараметр.СтандартноеЗначение <> СтрокаНачисления.Значение Тогда
				Если ЗначениеЗаполнено(СтрокаНачисления.формула) Тогда
					Результат = Результат + ", "+СокрЛП(СтрокаНачисления.ЧисловойПараметр.Идентификатор) +"="+ Строка(СтрокаНачисления.Значение)+"*"+Сокрлп(СтрокаНачисления.Формула);
				Иначе
					Результат = Результат +", "+СокрЛП(СтрокаНачисления.ЧисловойПараметр.Идентификатор) +"="+ Строка(СтрокаНачисления.Значение);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;	
	
	Если ПараметрыПечати.РасшифроватьСостав Тогда
		Если Ссылка.СоставРабот.Количество() > 0 Тогда
			Результат = Результат + Символы.ПС + Символы.ПС +"  Состав работ:";
			Для каждого СтрокаТаб Из Ссылка.СоставРабот Цикл
			    Результат = Результат + Символы.ПС + Строка(СтрокаТаб.Номер) + ". " + Строка(СтрокаТаб.НаименованиеРаботы); 
			КонецЦикла; 
		КонецЕсли; 
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

// Процедура расшифровки ЗУ по позиции.
//
Функция РасшифифровкаЗУПоПозиции(Результат,Ссылка, ПараметрыПечати)
	Если ПараметрыПечати.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
		Если ЗначениеЗаполнено(ссылка.ЗимнееУдорожРемонт) Тогда
			Результат = Результат + "
			|ЗУ="+Сокрлп(Ссылка.ЗимнееУдорожРемонт);
		КонецЕсли;	
		Если ЗначениеЗаполнено(ссылка.ЗимнееУдорожМатериалРемонт) Тогда
			Результат = Результат + "
			|ЗУмат="+Сокрлп(Ссылка.ЗимнееУдорожМатериалРемонт);
		КонецЕсли;	
	Иначе	
		Если ЗначениеЗаполнено(ссылка.ЗимнееУдорож) Тогда
			Результат = Результат + "
			|ЗУ="+Сокрлп(Ссылка.ЗимнееУдорож);
		КонецЕсли;	
		Если ЗначениеЗаполнено(ссылка.ЗимнееУдорожМатериал) Тогда
			Результат = Результат + "
			|ЗУмат="+Сокрлп(Ссылка.ЗимнееУдорожМатериал);
		КонецЕсли;	
	КонецЕсли;	
	Возврат(Результат);
КонецФункции

// Формируем и возвращаем поле Обоснование для позиции локальной сметы.
//
Функция СформироватьПолеОбоснование(Ссылка,ПараметрыПечати)
	
	Результат = СокрЛП(ссылка.ШифрРасценки);
	
	Если Ссылка.Применительно = истина Тогда
		
		Результат = Результат + "
		|применительно";
		
	КонецЕсли;	
	
	Если ПараметрыПечати.ПечататьРедакцию = истина Тогда
		
		Результат = Результат + "
		|"+Сокрлп(Ссылка.Версия);
		
	КонецЕсли;	
	
	Если ПараметрыПечати.ПечататьПрефикс = истина Тогда
		Если Не Ссылка.РегиональнаяБаза.Пустая() Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ПрефиксыРасценок.Наименование КАК Префикс
			|ИЗ
			|	Справочник.СМ_ПрефиксыРасценок КАК ПрефиксыРасценок
			|ГДЕ
			|	ПрефиксыРасценок.ТипНормативногоСборника = &ТипНормативногоСборника
			|	И ПрефиксыРасценок.РегиональнаяБаза = &РегиональнаяБаза";
			Запрос.УстановитьПараметр("ТипНормативногоСборника",	Ссылка.ТипНормативныхСборников);			   
			Запрос.УстановитьПараметр("РегиональнаяБаза",			Ссылка.РегиональнаяБаза);
			
			Выборка = запрос.Выполнить().Выбрать();
			Если выборка.Следующий() Тогда
				Результат = Сокрлп(Выборка.Префикс) + Результат;
			Иначе
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				               |	ПрефиксыРасценок.Наименование КАК Префикс
				               |ИЗ
				               |	Справочник.СМ_ПрефиксыРасценок КАК ПрефиксыРасценок
				               |ГДЕ
				               |	ПрефиксыРасценок.ТипНормативногоСборника = &ТипНормативногоСборника
				               |	И ПрефиксыРасценок.ЭтоГруппа = ИСТИНА";
				Запрос.УстановитьПараметр("ТипНормативногоСборника",	Ссылка.ТипНормативныхСборников);			   
				Выборка = запрос.Выполнить().Выбрать();
				Если выборка.Следующий() Тогда
					Результат = Сокрлп(Выборка.Префикс) + Результат;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	Если ПараметрыПечати.ПечататьКоэффициентыТЧ ИЛИ  ПараметрыПечати.Это12Граф Тогда
		
		ТекстОбоснования = "";
		Для каждого СтрокаПоправки Из Ссылка.ПоправкиПозиции Цикл
			
			Если НЕ СтрокаПоправки.применить Тогда
				Продолжить;
			КонецЕсли;	
			
			ТекстОбоснования = ТекстОбоснования + СокрЛП(СтрокаПоправки.Обоснование)+", ";
		КонецЦикла;
		ТекстОбоснования = Лев(ТекстОбоснования,стрДлина(ТекстОбоснования)-2);
		
		Результат = Результат + "
		|"+ ТекстОбоснования;
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции	

// Функция формирует наименование лимитированных затрат для вывода на печать по заданным параметрам печати.
//
Функция СформироватьНаименованиеРаботПоЛимЗатрате(Смета,ЛимЗатрата,ПараметрыПечати)
	
	Результат = Сокрлп(ЛимЗатрата.Наименование);
	
	нОтбор = Новый Структура;
	нОтбор.Вставить("ЛимитированнаяЗатрата",	ЛимЗатрата);
	нСтроки = Смета.ЛимитированныеЗатраты.НайтиСтроки(нОтбор);
	Если нСтроки.количество() > 0 Тогда
		
		нСтрока = нСтроки.Получить(0);  	
		Если ПараметрыПечати.ВБазисномУровне Тогда
			Результат = Результат + ", "+Строка(нСтрока.БазисноеЗначениеЛимЗатраты);
		Иначе
			Результат = Результат + ", "+Строка(нСтрока.ЗначениеЛимЗатраты);
		КонецЕсли;
		Если ЛимЗатрата.ТипЗначенияЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Процент Тогда
			Результат = Результат + " %";	
		КонецЕсли;	
		
		Если Смета.ПечататьФормулыЛЗ = истина Тогда
			Если ПараметрыПечати.ВБазисномУровне Тогда
				Результат = Результат + ", "+Сокрлп(нСтрока.ФормулаБазисногоЗначениеЛимЗатраты);	
			Иначе	
				Результат = Результат + ", "+Сокрлп(нСтрока.ФормулаЛимЗатраты);	
			КонецЕсли;
		КонецЕсли;	
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

// Формируем и возвращаем строку расшифровки итога сметы.
//
Функция ПолучитьРасшифровкуИтогаСметы(Итог,Ссылка)
	
	Если Ссылка.МетодРасчета <> Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный И Ссылка.Уровень <> Перечисления.СМ_УровеньЗаданияИндексов.Смета Тогда
		Возврат "";
	КонецЕсли;	
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		Если Ссылка.БазисныеЦены = Истина Тогда
			Возврат "";
		КонецЕсли;	
	КонецЕсли;	
	СтрокаРасшифровки = "";  	
	
	Если итог = Справочники.СМ_ИтогиПоСмете.ИндексыПоСметеКЭлементам Тогда    		
		
		СтрокаРасшифровки = "[ФОТ="+Строка(Ссылка.КоэффФОТ)+", ЭМ="+Строка(Ссылка.КоэффСтоимЭксплМашин)+", СМ="+Строка(ссылка.КоэффСтоимМатериалов)+"]";
		
	ИначеЕсли	итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндСМР Тогда
		
		СтрокаРасшифровки = "[СМР="+Строка(Ссылка.КоэффСМР)+"]";      
		
	ИначеЕсли 	итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндКОборуд Тогда
		
		СтрокаРасшифровки = "[Обор="+Строка(Ссылка.КоэффОборуд)+"]";
		
	ИначеЕсли 	итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндНаПрочРаботы Тогда
		
		СтрокаРасшифровки = "[Проч="+Строка(Ссылка.КоэффПрочРаб)+"]";
		
	КонецЕсли;
	
	Возврат СтрокаРасшифровки;
	
	
КонецФункции	

// Формируем и возвращаем строку расшифровки по итогу раздела.
//
Функция ВернутьСтрокуРасшифровки(Итог,Раздел,ПараметрыПечати)
	
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	Если ПечатьАкта = Истина Тогда
		Акт =  ПараметрыПечати.АктСсылка;
		НаборКоэф  = Акт.Разделы.Найти(Раздел);
	Иначе
		НаборКоэф  = Раздел;
	КонецЕсли;
	
	Если Итог.Расшифровка = ложь  Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокаРасшифровки = "";
	
	Если Итог = Справочники.СМ_ИтогиПоРазделу.НаклРасх ИЛИ Итог = Справочники.СМ_ИтогиПоРазделу.СметПрибыль Тогда
		
		Запрос = Новый запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СМ_НумерацияПозицийЛокальныхСмет.Раздел,
		               |	СМ_НумерацияПозицийЛокальныхСмет.Позиция,
		               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
		               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
		               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
		               |ПОМЕСТИТЬ Номера
		               |ИЗ
		               |	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
		               |ГДЕ
		               |	СМ_НумерацияПозицийЛокальныхСмет.Раздел = &ИДРодителя
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ПозицияЛокальнойСметы.НакладныеРасходыТекущие,
		               |	ПозицияЛокальнойСметы.ПоправочныйКоэффициентКНРТекущий,
		               |	ПозицияЛокальнойСметы.КоэффициентКНРНаРемонтТекущий,
		               |	Номера.ПорНомер,
		               |	ПозицияЛокальнойСметы.СметнаяПрибыльТекущие,
		               |	ПозицияЛокальнойСметы.ПоправочныйКоэффициентКСПТекущий,
		               |	ПозицияЛокальнойСметы.КоэффициентКСПНаРемонтТекущий,
		               |	ПозицияЛокальнойСметы.КоэффициентКНРАЭСТекущий,
		               |	ПозицияЛокальнойСметы.КоэффициентКНРУСНТекущий,
		               |	ПозицияЛокальнойСметы.КоэффициентКСПАЭСТекущий,
		               |	ПозицияЛокальнойСметы.КоэффициентКСПУСНТекущий,
		               |	ПозицияЛокальнойСметы.НРТСНТекущиеРемонт,
		               |	ПозицияЛокальнойСметы.СПТСНТекущиеРемонт,
		               |	ПозицияЛокальнойСметы.НакладныеРасходыБазисные,
		               |	ПозицияЛокальнойСметы.ПоправочныйКоэффициентКНРБазисный,
		               |	ПозицияЛокальнойСметы.КоэффициентКНРНаРемонтБазисный,
		               |	ПозицияЛокальнойСметы.СметнаяПрибыльБазисные,
		               |	ПозицияЛокальнойСметы.ПоправочныйКоэффициентКСПБазисный,
		               |	ПозицияЛокальнойСметы.КоэффициентКСПНаРемонтБазисный,
		               |	ПозицияЛокальнойСметы.КоэффициентКНРАЭСБазисный,
		               |	ПозицияЛокальнойСметы.КоэффициентКНРУСНБазисный,
		               |	ПозицияЛокальнойСметы.КоэффициентКСПАЭСБазисный,
		               |	ПозицияЛокальнойСметы.КоэффициентКСПУСНБазисный
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Номера КАК Номера
		               |		ПО (Номера.Позиция = ПозицияЛокальнойСметы.Ссылка)
		               |			И (Номера.Раздел = ПозицияЛокальнойСметы.ИДРодителя)
		               |ГДЕ
		               |	ПозицияЛокальнойСметы.ИДРодителя = &ИДРодителя
		               |	И ПозицияЛокальнойСметы.Расчет = ИСТИНА";
		Запрос.УстановитьПараметр("ИДРодителя",раздел);			
		Выборка = запрос.Выполнить().Выгрузить();
		Выборка.Колонки.Добавить("Расшифровка");
		Для каждого Стр Из Выборка Цикл
			
			Если Итог = Справочники.СМ_ИтогиПоРазделу.НаклРасх Тогда
				Если ПараметрыПечати.МетодикаТСН Тогда
					Если ПараметрыПечати.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
						НакладныеРасходыТекущие = стр.НРТСНТекущиеРемонт;
					Иначе
						НакладныеРасходыТекущие = стр.НакладныеРасходыТекущие;
					КонецЕсли;
				Иначе
					Если ПараметрыПечати.ВБазисномУровне  Тогда
						НакладныеРасходыТекущие = стр.НакладныеРасходыБазисные;
					Иначе
						НакладныеРасходыТекущие = стр.НакладныеРасходыТекущие;
					КонецЕсли;
				КонецЕсли;
				
				Если НакладныеРасходыТекущие <> 0 Тогда
					
					Стр.Расшифровка = Строка(НакладныеРасходыТекущие)+"%";
					Если ПараметрыПечати.МетодикаТСН  = Ложь Тогда
						Если ПараметрыПечати.ВБазисномУровне  Тогда
							ПоправочныйКоэффициентКНРТекущий = стр.ПоправочныйКоэффициентКНРБазисный;
							КоэффициентКНРНаРемонтТекущий = стр.КоэффициентКНРНаРемонтБазисный;
							КоэффициентКНРАЭСТекущий = стр.КоэффициентКНРАЭСБазисный;
							КоэффициентКНРУСНТекущий = стр.КоэффициентКНРУСНБазисный;
						Иначе
							ПоправочныйКоэффициентКНРТекущий = стр.ПоправочныйКоэффициентКНРТекущий;
							КоэффициентКНРНаРемонтТекущий = стр.КоэффициентКНРНаРемонтТекущий;
							КоэффициентКНРАЭСТекущий = стр.КоэффициентКНРАЭСТекущий;
							КоэффициентКНРУСНТекущий = стр.КоэффициентКНРУСНТекущий;
						КонецЕсли;
						Если  ПоправочныйКоэффициентКНРТекущий <> 0 Тогда
							стр.Расшифровка = стр.Расшифровка + "*"+строка(ПоправочныйКоэффициентКНРТекущий);
						КонецЕсли;
						
						Если  КоэффициентКНРНаРемонтТекущий <> 0 Тогда
							стр.Расшифровка = стр.Расшифровка + "*"+строка(КоэффициентКНРНаРемонтТекущий);
						КонецЕсли;
						
						Если  КоэффициентКНРАЭСТекущий <> 0 Тогда
							стр.Расшифровка = стр.Расшифровка + "*"+строка(КоэффициентКНРАЭСТекущий);
						КонецЕсли;
						
						Если  КоэффициентКНРУСНТекущий <> 0 Тогда
							стр.Расшифровка = стр.Расшифровка + "*"+строка(КоэффициентКНРУСНТекущий);
						КонецЕсли;
					Иначе
						// Могут быть свои коэффициеты.
					КонецЕсли;
					
				Иначе
					Стр.Расшифровка = "";
				КонецЕсли;	  				
				
			ИначеЕсли Итог = Справочники.СМ_ИтогиПоРазделу.СметПрибыль Тогда  				
				
				Если ПараметрыПечати.МетодикаТСН Тогда
					Если ПараметрыПечати.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
						СметнаяПрибыльТекущие = стр.СПТСНТекущиеРемонт;
					Иначе
						СметнаяПрибыльТекущие = стр.СметнаяПрибыльТекущие;
					КонецЕсли;
				Иначе
					Если ПараметрыПечати.ВБазисномУровне  Тогда
						СметнаяПрибыльТекущие = стр.СметнаяПрибыльБазисные;
					Иначе
						СметнаяПрибыльТекущие = стр.СметнаяПрибыльТекущие;
					КонецЕсли;
				КонецЕсли;
				Если СметнаяПрибыльТекущие <> 0 Тогда
					
					Стр.Расшифровка = Строка(СметнаяПрибыльТекущие)+"%";
					Если ПараметрыПечати.МетодикаТСН  = Ложь Тогда
						Если ПараметрыПечати.ВБазисномУровне  Тогда
							ПоправочныйКоэффициентКСПТекущий = стр.ПоправочныйКоэффициентКСПБазисный;
							КоэффициентКСПНаРемонтТекущий = стр.КоэффициентКСПНаРемонтБазисный;
							КоэффициентКСПАЭСТекущий = стр.КоэффициентКСПАЭСБазисный;
							КоэффициентКСПУСНТекущий = стр.КоэффициентКСПУСНБазисный;
						Иначе
							ПоправочныйКоэффициентКСПТекущий = стр.ПоправочныйКоэффициентКСПТекущий;
							КоэффициентКСПНаРемонтТекущий = стр.КоэффициентКСПНаРемонтТекущий;
							КоэффициентКСПАЭСТекущий = стр.КоэффициентКСПАЭСТекущий;
							КоэффициентКСПУСНТекущий = стр.КоэффициентКСПУСНТекущий;
						КонецЕсли;
						
						Если  ПоправочныйКоэффициентКСПТекущий <> 0 Тогда
							стр.Расшифровка = стр.Расшифровка + "*"+строка(ПоправочныйКоэффициентКСПТекущий);
						КонецЕсли;
						
						Если  КоэффициентКСПНаРемонтТекущий <> 0 Тогда
							стр.Расшифровка = стр.Расшифровка + "*"+строка(КоэффициентКСПНаРемонтТекущий);
						КонецЕсли;
						
						Если  КоэффициентКСПАЭСТекущий <> 0 Тогда
							стр.Расшифровка = стр.Расшифровка + "*"+строка(КоэффициентКСПАЭСТекущий);
						КонецЕсли;
						
						Если  КоэффициентКСПУСНТекущий <> 0 Тогда
							стр.Расшифровка = стр.Расшифровка + "*"+строка(КоэффициентКСПУСНТекущий);
						КонецЕсли;
					Иначе
						// Могут быть свои коэффициеты.
					КонецЕсли;
				Иначе
					Стр.Расшифровка = "";
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;	
		
		Выборка.сортировать("Расшифровка,ПорНомер");
		ПредРасшифровка = "";
		СтрокаРасшифровки =" ["; 
		
		Для каждого стр Из Выборка Цикл
			
			Если стр.расшифровка = "" Тогда
				Продолжить;
			КонецЕсли;	
			
			Если стр.Расшифровка <> ПредРасшифровка Тогда
				ПредРасшифровка = стр.Расшифровка;
				СтрокаРасшифровки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1%2 по поз. %3,'")+" ", СтрокаРасшифровки, стр.Расшифровка, строка(стр.ПорНомер));
			Иначе
				СтрокаРасшифровки = СтрокаРасшифровки + строка(стр.ПорНомер)+", ";
			КонецЕсли;	
		КонецЦикла;	
		
		Если СтрокаРасшифровки = " [" Тогда
			СтрокаРасшифровки ="";
		Иначе	
			СтрокаРасшифровки = Лев(строкаРасшифровки,Стрдлина(строкаРасшифровки)-2)+"]";
		КонецЕсли;             		
		
	ИначеЕсли итог = Справочники.СМ_ИтогиПоРазделу.ИтогоСИндексКЭлемЗатрат Тогда
		Если ПараметрыПечати.ВБазисномУровне = Ложь Тогда
			
			Если ПараметрыПечати.СпособРасчета = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат Тогда
				
				Если НаборКоэф.КоэффПолнСтоимРабот <> 0 Тогда
					СтрокаРасшифровки = " ["+ НаборКоэф.ВидРабот + " ПЗ="+Строка(НаборКоэф.КоэффПолнСтоимРабот)+"]";
				Иначе
					СтрокаРасшифровки = " ["+ НаборКоэф.ВидРабот +" ОЗ="+Строка(НаборКоэф.КоэффОснЗарплаты)+", ЭММ="+Строка(НаборКоэф.КоэффСтоимЭксплМашин)+", ЗМ="+Строка(НаборКоэф.КоэффСтоимЗарплатеМашин)+", СМ="+Строка(НаборКоэф.КоэффСтоимМатериалов)+"]";
				КонецЕсли;
			Иначе
				СтрокаРасшифровки = " ["+НаборКоэф.ВидРабот+" ПЗ="+Строка(НаборКоэф.КоэффПолнСтоимРабот)+"]";
			КонецЕсли;	  		
			
			
			
		КонецЕсли;
	ИначеЕсли итог = Справочники.СМ_ИтогиПоРазделу.ИтогоСИндексКОборуд Тогда
		Если ПараметрыПечати.ВБазисномУровне = Ложь Тогда
			Если ПараметрыПечати.СпособРасчета = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат Тогда
				Если НаборКоэф.КоэффПолнСтоимРабот <> 0 Тогда
					СтрокаРасшифровки = " [ПЗ="+Строка(НаборКоэф.КоэффПолнСтоимРабот)+"]";
				Иначе
					СтрокаРасшифровки = " [ОБ="+Строка(НаборКоэф.КоэффОборуд)+"]";
				КонецЕсли;
			Иначе
				СтрокаРасшифровки = " [ПЗ="+Строка(НаборКоэф.КоэффОборуд)+"]";
			КонецЕсли;
			
		КонецЕсли;	 	
	КонецЕсли;	 	
	
	ЧП = неопределено;
	
	ЗапросСпр = Новый Запрос;
	ЗапросСпр.текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЧисловыеПараметрыПриемник.Ссылка
	|ИЗ
	|	Справочник.СМ_ЧисловыеПараметры.Приемник КАК ЧисловыеПараметрыПриемник
	|ГДЕ
	|	ЧисловыеПараметрыПриемник.КЧему = &КЧему";
	ЗапросСпр.УстановитьПараметр("КЧему",Итог);				 
	ВыборкаСпр = запросспр.Выполнить().Выбрать();
	Если выборкаСпр.Следующий() Тогда
		ЧП = выборкаСпр.Ссылка;	
	КонецЕсли;	
	
	Если ЧП <> Неопределено Тогда
		
		ЗапросСпр = Новый Запрос;
		ЗапросСпр.текст = "ВЫБРАТЬ
		|	ИтогиЧППоРазделу.Позиция
		|ИЗ
		|	РегистрСведений.СМ_ИтогиЧППоРазделу КАК ИтогиЧППоРазделу
		|ГДЕ
		|	ИтогиЧППоРазделу.Раздел = &Раздел
		|	И ИтогиЧППоРазделу.Итог = &Итог
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИтогиЧППоРазделу.Итог.ПорядковыйНомер";
		ЗапросСпр.УстановитьПараметр("Раздел",	Раздел);
		ЗапросСпр.УстановитьПараметр("Итог",	Итог);	
		ВыборкаСпр = запросспр.Выполнить().Выбрать();
		
		тзЧП = Новый ТаблицаЗначений;
		тзЧП.Колонки.Добавить("ЧП");
		тзЧП.Колонки.Добавить("Значение");
		тзЧП.Колонки.Добавить("ПорНомер");
		
		Пока ВыборкаСпр.Следующий() Цикл
			Номера = СМ_СметаВызовСервера.ПолучитьНомерДокумента(ВыборкаСпр.Позиция, "СМ_ПозицияЛокальнойСметы");
			нОтбор = Новый Структура;
			нОтбор.Вставить("ЧисловойПараметр",ЧП);
			нСтроки = ВыборкаСпр.Позиция.НачисленияПозиции.НайтиСтроки(нОтбор);
			Для каждого нСтрока Из нСтроки Цикл
				нов = тзЧП.Добавить();
				нов.ЧП = ЧП;
				нов.Значение = нстрока.Значение;
				нов.ПорНомер = Номера.ПорНомер;
			КонецЦикла;
		КонецЦикла;	
		
		тзЧП.Сортировать("ЧП,Значение,ПорНомер");
		СтрокаРасшифровки = " [";
		ПредЧП = "";
		ПредЗначение = "";
		Для каждого стрЧП Из тзЧП Цикл
			Если ПредЧП <> стрчп.ЧП ИЛИ ПредЗначение <> стрЧп.Значение Тогда
				СтрокаРасшифровки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1%2=%3 по поз. %4,'")+" ", СтрокаРасшифровки, СокрЛП(стрчп.Чп), Строка(стрчп.Значение), строка(стрчп.ПорНомер));
			Иначе
				СтрокаРасшифровки = СтрокаРасшифровки + строка(стрчп.ПорНомер)+", ";
			КонецЕсли;
		КонецЦикла;	
		СтрокаРасшифровки = Лев(СтрокаРасшифровки,стрДлина(СтрокаРасшифровки)-2);
	КонецЕсли;	
	
	Возврат СтрокаРасшифровки;
	
КонецФункции

// Расшифровка ТСН.
//
Функция ВернутьСтрокуРасшифровкиМТСН(Итог,Раздел,ПараметрыПечати)
	
	Если Итог.Расшифровка = ложь  Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокаРасшифровки = "";
	
	Если Итог = Справочники.СМ_ИтогиПоРазделу.НаклРасх ИЛИ Итог = Справочники.СМ_ИтогиПоРазделу.СметПрибыль Тогда
		
		Запрос = Новый запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СМ_НумерацияПозицийЛокальныхСмет.Раздел,
		               |	СМ_НумерацияПозицийЛокальныхСмет.Позиция,
		               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
		               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
		               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
		               |ПОМЕСТИТЬ Номера
		               |ИЗ
		               |	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
		               |ГДЕ
		               |	СМ_НумерацияПозицийЛокальныхСмет.Позиция = &Ссылка
		               |	И СМ_НумерацияПозицийЛокальныхСмет.Раздел = &Раздел
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ПозицияЛокальнойСметы.Позиция КАК Позиция,
		               |	Номера.ПорНомер КАК ПорНомер,
		               |	ПозицияЛокальнойСметы.НакладныеРасходыТекущие,
		               |	ПозицияЛокальнойСметы.НРТСНТекущиеРемонт,
		               |	ПозицияЛокальнойСметы.СПТСНТекущиеРемонт,
		               |	ПозицияЛокальнойСметы.СметнаяПрибыльТекущие
		               |ИЗ
		               |	Документ.СМ_АктВыполненныхРабот.Позиции КАК ПозицияЛокальнойСметы
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Номера КАК Номера
		               |		ПО ПозицияЛокальнойСметы.Позиция = Номера.Позиция
		               |			И ПозицияЛокальнойСметы.Позиция.ИДРодителя = Номера.Раздел
		               |ГДЕ
		               |	ПозицияЛокальнойСметы.Ссылка = &Ссылка
		               |	И ПозицияЛокальнойСметы.Позиция.ИДРодителя = &Раздел
		               |	И ПозицияЛокальнойСметы.ФактОбъем <> 0";
		Запрос.УстановитьПараметр("Ссылка",ПараметрыПечати.АктСсылка);			
		Запрос.УстановитьПараметр("Раздел",Раздел);			
		Выборка = запрос.Выполнить().Выгрузить();
		
		Выборка.Колонки.Добавить("Расшифровка");
		Для каждого Стр Из Выборка Цикл
			
			Если Итог = Справочники.СМ_ИтогиПоРазделу.НаклРасх Тогда
				Если ПараметрыПечати.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
					НакладныеРасходыТекущие = стр.НРТСНТекущиеРемонт;
				Иначе
					НакладныеРасходыТекущие = стр.НакладныеРасходыТекущие;
				КонецЕсли;
				
				Если НакладныеРасходыТекущие <> 0 Тогда
					
					Стр.Расшифровка = Строка(НакладныеРасходыТекущие)+"%";
					// Могут быть свои коэффициеты.
				Иначе
					Стр.Расшифровка = "";
				КонецЕсли;	
				
				
			ИначеЕсли Итог = Справочники.СМ_ИтогиПоРазделу.СметПрибыль Тогда
				
				Если ПараметрыПечати.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
					СметнаяПрибыльТекущие = стр.СПТСНТекущиеРемонт;
				Иначе
					СметнаяПрибыльТекущие = стр.СметнаяПрибыльТекущие;
				КонецЕсли;
				
				
				Если СметнаяПрибыльТекущие <> 0 Тогда					
					Стр.Расшифровка = Строка(СметнаяПрибыльТекущие)+"%";
				Иначе
					Стр.Расшифровка = "";
				КонецЕсли;	
				
			КонецЕсли;	
			
		КонецЦикла;	
		
		Выборка.сортировать("Расшифровка,ПорНомер");
		ПредРасшифровка = "";
		СтрокаРасшифровки =" ["; 
		
		Для каждого стр Из Выборка Цикл
			
			Если стр.расшифровка = "" Тогда
				Продолжить;
			КонецЕсли;	
			
			Если стр.Расшифровка <> ПредРасшифровка Тогда
				ПредРасшифровка = стр.Расшифровка;
				СтрокаРасшифровки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1%2 по поз. %3,'")+" ", СтрокаРасшифровки, стр.Расшифровка, строка(стр.ПорНомер));
			Иначе
				СтрокаРасшифровки = СтрокаРасшифровки + строка(стр.ПорНомер)+", ";
			КонецЕсли;	
			
		КонецЦикла;	
		
		Если СтрокаРасшифровки = " [" Тогда
			СтрокаРасшифровки ="";
		Иначе	
			СтрокаРасшифровки = Лев(строкаРасшифровки,Стрдлина(строкаРасшифровки)-2)+"]";
		КонецЕсли;
	КонецЕсли;
	Возврат СтрокаРасшифровки;
	
КонецФункции

// Получаем стоимости для целей печати.
//
Функция ПолучитьСметныеСтоимости(Ссылка,ПараметрыПечати)
	
	нОтбор = Новый Структура;
	нОтбор.Вставить("Расчет", истина);
	нСтроки = ссылка.ЛимитированныеЗатраты.найтистроки(нОтбор);
	
	структураОтвета = Новый Структура;
	ВБазисномУровне = Ложь;
	
	ТекущиеЦеныВШапкуРес9граф = Ложь;
	
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		Если Ссылка.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
			Если Не ПараметрыПечати.ЭтоРесурсная12Граф И Не ПараметрыПечати.ЭтоРесурсная7Граф Тогда
				ТекущиеЦеныВШапкуРес9граф = Истина;
			КонецЕсли;	
		КонецЕсли;	
		ВБазисномУровне = Ссылка.БазисныеЦены;
	КонецЕсли;	
	
	
	НормТрудоемкость = неопределено;
	СметнЗарплата	 = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Смета",Ссылка);
	
	Если нСтроки.Количество() > 0 Тогда
		
		Запрос.Текст = "ВЫБРАТЬ
		|	СУММА(ЕСТЬNULL(ИтогиПоГлавам.ТекПрямЗатраты, 0)) КАК ПрямЗатраты,
		|	СУММА(ЕСТЬNULL(ИтогиПоГлавам.ПрямЗатраты, 0)) КАК ПрямЗатратыБазис,
		|	СУММА(ЕСТЬNULL(ИтогиПоГлавам.ЗатратыТрудаРабочих, 0)) КАК ЗатратыТрудаРабочих,
		|	СУММА(ЕСТЬNULL(ИтогиПоГлавам.ЗатратыТрудаМашин, 0)) КАК ЗатратыТрудаМашин,
		|	СУММА(ЕСТЬNULL(ИтогиПоГлавам.ТекОснЗарплата, 0)) КАК ТекОснЗарплата,
		|	СУММА(ЕСТЬNULL(ИтогиПоГлавам.ОснЗарплата, 0)) КАК ОснЗарплата,
		|	СУММА(ЕСТЬNULL(ИтогиПоГлавам.ТекЗарплМашин, 0)) КАК ТекЗарплМашин,
		|	СУММА(ЕСТЬNULL(ИтогиПоГлавам.ЗарплМашин, 0)) КАК ЗарплМашин
		|ИЗ
		|	РегистрСведений.СМ_ИтогиПоГлавам КАК ИтогиПоГлавам
		|ГДЕ
		|	ИтогиПоГлавам.Смета = &Смета
		|	И ИтогиПоГлавам.Итог = &Итог";
		Запрос.УстановитьПараметр("Итог", Справочники.СМ_ИтогиПоГлавам.НайтиПоРеквизиту("Идентификатор","ИП4"));
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		|	ЕСТЬNULL(ИтогиПоСмете.ТекПрямЗатраты, 0) КАК прямЗатраты,
		|	ЕСТЬNULL(ИтогиПоСмете.ПрямЗатраты, 0) КАК прямЗатратыБазис,
		|	ЕСТЬNULL(ИтогиПоСмете.ЗатратыТрудаРабочих, 0) КАК ЗатратыТрудаРабочих,
		|	ЕСТЬNULL(ИтогиПоСмете.ЗатратыТрудаМашин, 0) КАК ЗатратыТрудаМашин,
		|	ЕСТЬNULL(ИтогиПоСмете.ОснЗарплата, 0) КАК ОснЗарплата,
		|	ЕСТЬNULL(ИтогиПоСмете.ТекОснЗарплата, 0) КАК ТекОснЗарплата,
		|	ЕСТЬNULL(ИтогиПоСмете.ЗарплМашин, 0 )КАК ЗарплМашин,
		|	ЕСТЬNULL(ИтогиПоСмете.ТекЗарплМашин, 0 )КАК ТекЗарплМашин
		|ИЗ
		|	РегистрСведений.СМ_ИтогиПоСмете КАК ИтогиПоСмете
		|ГДЕ
		|	ИтогиПоСмете.Смета = &Смета
		|	И ИтогиПоСмете.Итог = &Итог";
		Запрос.УстановитьПараметр("Итог", Справочники.СМ_ИтогиПоСмете.ВсегоПоСмете);
		
		
		// Запрос по нормативной трудоемкости , сметной зарплате делаем по отдельным итогам.
		ЗапросНорм = Новый Запрос;
		ЗапросНорм.Текст = "ВЫБРАТЬ
		|	СУММА(ЕСТЬNULL(ИтогиПоСмете.ТекПрямЗатраты, 0)) КАК ТекПрямЗатраты,
		|	СУММА(ЕСТЬNULL(ИтогиПоСмете.ПрямЗатраты, 0)) КАК ПрямЗатраты,
		|	ИтогиПоСмете.Итог
		|ИЗ
		|	РегистрСведений.СМ_ИтогиПоСмете КАК ИтогиПоСмете
		|ГДЕ
		|	ИтогиПоСмете.Смета = &Смета
		|	И (ИтогиПоСмете.Итог = &ИтогНТ
		|			ИЛИ ИтогиПоСмете.Итог = &ИтогЗП)
		|
		|СГРУППИРОВАТЬ ПО
		|	ИтогиПоСмете.Итог";
		ЗапросНорм.УстановитьПараметр("ИтогНТ", 	Справочники.СМ_ИтогиПоСмете.НормативТрудоемк);
		ЗапросНорм.УстановитьПараметр("ИтогЗП", 	Справочники.СМ_ИтогиПоСмете.СметнЗарплата);
		ЗапросНорм.УстановитьПараметр("Смета",	Ссылка);
		
		ВыборкаНорм = ЗапросНорм.Выполнить().Выбрать();
		НормТрудоемкость = 0;
		СметнЗарплата	 = 0;
		СметнЗарплатаБазис	 = 0;
		
		Пока ВыборкаНорм.Следующий() Цикл
			
			Если выборканорм.итог = Справочники.СМ_ИтогиПоСмете.НормативТрудоемк Тогда
				Если ВБазисномУровне = Истина Тогда
					НормТрудоемкость = ВыборкаНорм.ПрямЗатраты;
				Иначе	
					НормТрудоемкость = ВыборкаНорм.ТекПрямЗатраты;
				КонецЕсли;
			ИначеЕсли выборканорм.итог = Справочники.СМ_ИтогиПоСмете.СметнЗарплата Тогда
				СметнЗарплатаБазис = ВыборкаНорм.ПрямЗатраты;
				СметнЗарплата = ВыборкаНорм.ТекПрямЗатраты;
			КонецЕсли;	
			
		КонецЦикла;        	
		
	КонецЕсли;	
	
	КолЗнаков = 2;
	Если Ссылка.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;             
	
	выборка = запрос.Выполнить().Выбрать();
	Если выборка.Следующий() Тогда
		
		Если НормТрудоемкость = неопределено Тогда
			НормТрудоемкость = ?(выборка.ЗатратыТрудаРабочих=Null,0,выборка.ЗатратыТрудаРабочих) + ?(выборка.ЗатратыТрудаМашин=Null,0,выборка.ЗатратыТрудаМашин);
		КонецЕсли;	
		Если СметнЗарплата = неопределено Тогда
			СметнЗарплатаБазис = ?(выборка.ОснЗарплата=Null,0,выборка.ОснЗарплата) + ?(выборка.ЗарплМашин=Null,0,выборка.ЗарплМашин);
			СметнЗарплата = ?(выборка.ТекОснЗарплата=Null,0,выборка.ТекОснЗарплата) + ?(выборка.ТекЗарплМашин=Null,0,выборка.ТекЗарплМашин);
		КонецЕсли;
		
		структураОтвета.Вставить("СметнаяСтоимостьБазис",	Окр(?(выборка.ПрямЗатратыБазис=Null,0,выборка.ПрямЗатратыБазис),КолЗнаков));
		Если ПараметрыПечати.ЭтоМетодикаТСН9в Или ТекущиеЦеныВШапкуРес9граф Тогда
			структураОтвета.Вставить("СметнаяСтоимость",		Окр(?(выборка.ПрямЗатраты=Null,0,выборка.ПрямЗатраты),КолЗнаков));
			структураОтвета.Вставить("СметнаяЗарплата",			Окр(СметнЗарплата,КолЗнаков));
			структураОтвета.Вставить("НормативнаяТрудоемкость",	Окр(НормТрудоемкость,КолЗнаков));
		Иначе	
			Если ВБазисномУровне = Истина Тогда
				структураОтвета.Вставить("СметнаяСтоимость",		Окр(?(выборка.ПрямЗатратыБазис=Null,0,выборка.ПрямЗатратыБазис),КолЗнаков));
				структураОтвета.Вставить("СметнаяЗарплата",			Окр(СметнЗарплатаБазис,КолЗнаков));
			Иначе
				структураОтвета.Вставить("СметнаяСтоимость",		Окр(?(выборка.ПрямЗатраты=Null,0,выборка.ПрямЗатраты),КолЗнаков));
				структураОтвета.Вставить("СметнаяЗарплата",			Окр(СметнЗарплата,КолЗнаков));
			КонецЕсли;
			структураОтвета.Вставить("НормативнаяТрудоемкость",	Окр(НормТрудоемкость,КолЗнаков));
		КонецЕсли;
	Иначе
		структураОтвета.Вставить("СметнаяСтоимость",		0);
		структураОтвета.Вставить("СметнаяСтоимостьБазис",	0);
		структураОтвета.Вставить("НормативнаяТрудоемкость",	0);
		структураОтвета.Вставить("СметнаяЗарплата",			0);
	КонецЕсли;	
	
	Возврат структураОтвета;
	
КонецФункции	

// Функция инициализирует и возвращает структуру переменных для определения повторяющихся итогов.
//
Функция ИнициализироватьПеременныеДляПовтораЧП(Вид = Неопределено)
	
	СтруктураОтвета = Новый Структура;
	
	
	СтруктураОтвета.Вставить("ТекСтоимОснЗарплата",		0);
	СтруктураОтвета.Вставить("ТекСтоимЭксплМашин",		0);
	СтруктураОтвета.Вставить("ТекСтоимЗарплМашин",		0);
	СтруктураОтвета.Вставить("ТекСтоимСтоимМатер",		0);
	СтруктураОтвета.Вставить("ТекСтоимОборуд",	 		0);
	СтруктураОтвета.Вставить("ЗатратыТрудаРабочих",		0);
	СтруктураОтвета.Вставить("ЗатратыТрудаМашин",		0);
	СтруктураОтвета.Вставить("ТекСтоимПрямЗатраты",		0);
	Возврат СтруктураОтвета;
	
КонецФункции	

Функция ИнициализироватьПеременныеДляПовтораИтогов()
	СтруктураОтвета = Новый Структура;
	
	СтруктураОтвета.Вставить("ПредОбщБазис",			0);
	СтруктураОтвета.Вставить("ПредИтогОЗ",				0);
	СтруктураОтвета.Вставить("ПредИтогЭМвтч",			0);
	СтруктураОтвета.Вставить("ПредОбщТек",				0);
	СтруктураОтвета.Вставить("ПредИтогЭМ",				0);
	СтруктураОтвета.Вставить("ПредИтогЗатрТрРаб",		0);
	СтруктураОтвета.Вставить("ПредИтог",				0);
	СтруктураОтвета.Вставить("ПредИтогМат",				0);
	СтруктураОтвета.Вставить("ПредИтогЗатрТрМех",		0);
	СтруктураОтвета.Вставить("ПредИтогПрямЗатраты",		0);
	СтруктураОтвета.Вставить("ПредИтогЗаработнаяПлата",	0);
	СтруктураОтвета.Вставить("ПредИтогМашиныИМех",		0);
	СтруктураОтвета.Вставить("ПредИтогМетериалы",		0);
	СтруктураОтвета.Вставить("ПредИтогЗТР",				0);
	СтруктураОтвета.Вставить("ПредИтогОбслмех",			0);
	СтруктураОтвета.Вставить("ПредИтогЗрплМаш",			0);
	
	
	Возврат СтруктураОтвета;
	
КонецФункции	

// Функция, определяющая, пропускаем ли при печати очередную строку итогов по причине повторяющихся
// значений итогов, возвращает Истина, Если надо пропустить строку.
//
Функция ПропуститьСтрокуИзЗаПовтораИтога(ПеременныеДляПовтора,СтрокаИтога,Параметрыпечати,вид = неопределено) 
	
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	
	Если Вид = "СМ_ИтогиЧППоРазделу" Тогда
		
		Если СтрокаИтога.Итог.Накопительный Тогда
			Если СтрокаИтога.ТекСтоимОборуд <> 0 И Параметрыпечати.ВБазисномУровне = Ложь Тогда
				Если СтрокаИтога.ТекСтоимОборуд = ПеременныеДляПовтора.ТекСтоимОборуд Тогда
					Возврат истина;
				КонецЕсли;
			ИначеЕсли СтрокаИтога.СтоимОборуд <> 0 И Параметрыпечати.ВБазисномУровне = Истина Тогда	
				Если СтрокаИтога.СтоимОборуд = ПеременныеДляПовтора.ТекСтоимОборуд Тогда
					Возврат истина;
				КонецЕсли;	
			Иначе
				Если СтрокаИтога.ТекСтоимОснЗарплата = ПеременныеДляПовтора.ТекСтоимОснЗарплата И СтрокаИтога.ТекСтоимЭксплМашин = ПеременныеДляПовтора.ТекСтоимЭксплМашин
					И СтрокаИтога.ТекСтоимЗарплМашин = ПеременныеДляПовтора.ТекСтоимЗарплМашин И СтрокаИтога.ТекСтоимСтоимМатер = ПеременныеДляПовтора.ТекСтоимСтоимМатер
					И СтрокаИтога.ЗатратыТрудаРабочих = ПеременныеДляПовтора.ЗатратыТрудаРабочих И СтрокаИтога.ЗатратыТрудаМашин = ПеременныеДляПовтора.ЗатратыТрудаМашин
					И СтрокаИтога.ТекСтоимПрямЗатраты = ПеременныеДляПовтора.ТекСтоимПрямЗатраты Тогда
					Возврат истина;
				КонецЕсли;	
			КонецЕсли;	
		Иначе
			Возврат ложь;
		КонецЕсли;	
		
	КонецЕсли;
	Если  Вид <> "СМ_ИтогиЧППоРазделу" Тогда
		
		Если Параметрыпечати.ПечататьПовтор = ложь Тогда
			Если ТипЗнч(СтрокаИтога.Итог) <> тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
				
				// Итоги одинаковые НЕ печатаются, а лим затраты печатаются всегда.
				Если ПараметрыПечати.ЭтоРесурсная Тогда
					
					// Печать по акту выполненных работ.
					Если ПечатьАкта Тогда
						Если ПараметрыПечати.ЭтоКС2Рес Или ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
							Если Окр(ПеременныеДляПовтора.ПредИтог,КолЗнаков)	= Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков)	Тогда	
								Возврат истина;
							КонецЕсли;
						Иначе
							
							Если Окр(ПеременныеДляПовтора.ПредИтогПрямЗатраты,КолЗнаков)	= Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков)
								И Окр(ПеременныеДляПовтора.ПредИтогЗаработнаяПлата,КолЗнаков)	= Окр(СтрокаИтога.ТекОснЗарплата,КолЗнаков)
								И Окр(ПеременныеДляПовтора.ПредИтогМашиныИМех,КолЗнаков)		= Окр(СтрокаИтога.ТекЭксплМашин,КолЗнаков)
								И Окр(ПеременныеДляПовтора.ПредИтогЗрплМаш,КолЗнаков)			= Окр(СтрокаИтога.ТекЗарплМашин,КолЗнаков)
								И Окр(ПеременныеДляПовтора.ПредИтогМетериалы,КолЗнаков)		= Окр(СтрокаИтога.ТекСтоимМатер,КолЗнаков)	Тогда
								Возврат истина;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;	
					// Печать по локальной смете ресурсной.
					Если Не ПечатьАкта Тогда	
						
						Если ПараметрыПечати.ЭтоРесурсная12Граф Тогда
							Если ПараметрыПечати.ВБазисномУровне Тогда
								Если Окр(ПеременныеДляПовтора.ПредИтог,КолЗнаков)	= Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков) Тогда
									Возврат истина;
								КонецЕсли;	
							Иначе	
								Если Окр(ПеременныеДляПовтора.ПредИтог,КолЗнаков)	= Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков)	Тогда
									Возврат истина;
								КонецЕсли;	
							КонецЕсли;	
						Иначе	
							Если НЕ ПараметрыПечати.ЭтоРесурсная7Граф Тогда
								Если Окр(ПеременныеДляПовтора.ПредОбщТек,КолЗнаков) = Окр(СтрокаИтога.ТекПрямЗатраты,Колзнаков) Тогда
									Возврат Истина;
								КонецЕсли;	
							Иначе
								Если ПараметрыПечати.ВБазисномУровне Тогда
									Если Окр(ПеременныеДляПовтора.ПредОбщТек,КолЗнаков) = Окр(СтрокаИтога.ПрямЗатраты,Колзнаков) Тогда
										Возврат Истина;
									КонецЕсли;
									
								Иначе
									Если Окр(ПеременныеДляПовтора.ПредОбщТек,КолЗнаков) = Окр(СтрокаИтога.ТекПрямЗатраты,Колзнаков) Тогда
										Возврат Истина;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				Если ПараметрыПечати.ЭтоРесурсная = Ложь  Тогда
					// Базисно-индексная печать
					// Печать по акту выполненных работ.
					Если ПечатьАкта Тогда
						
						Если  НЕ ПараметрыПечати.ЭтоКС2 Тогда
							Если ПеременныеДляПовтора.ПредИтог 		= Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков)Тогда	
								Возврат Истина;
							КонецЕсли;
						Иначе
							Если ПеременныеДляПовтора.ПредИтог 	= Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков)Тогда
								Возврат Истина;
							КонецЕсли;
						КонецЕсли;
						
						// Печать по локальной смете.
					Иначе	
						Если ПараметрыПечати.ВБазисномУровне И Не ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
							Если Окр(ПеременныеДляПовтора.ПредИтог,КолЗнаков) = Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков) Тогда
								Возврат Истина;
							КонецЕсли;
						Иначе	
							Если Окр(ПеременныеДляПовтора.ПредИтог,КолЗнаков) = Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков) Тогда
								Возврат Истина;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ложь;
	
КонецФункции	

// Функция получает суммы НР и СП по позиции из регистра СМ_НРиСП.
//
Функция получитьСуммыНРиСППоПозиции(Позиция,Смета)
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("СуммаНРБазисная",	0);
	СтруктураОтвета.Вставить("СуммаНРТекущая",	0);
	СтруктураОтвета.Вставить("СуммаСПБазисная", 0);
	СтруктураОтвета.Вставить("СуммаСПТекущая",	0);
	СтруктураОтвета.Вставить("СуммаНРБазиснаяЗТР",	0);
	СтруктураОтвета.Вставить("СуммаНРТекущаяЗТР",	0);
	СтруктураОтвета.Вставить("СуммаСПБазиснаяЗТР", 	0);
	СтруктураОтвета.Вставить("СуммаСПТекущаяЗТР",	0);
	
	СтруктураОтвета.Вставить("СуммаНРБазиснаяЗТМ",	0);
	СтруктураОтвета.Вставить("СуммаНРТекущаяЗТМ",	0);
	СтруктураОтвета.Вставить("СуммаСПБазиснаяЗТМ",	0);
	СтруктураОтвета.Вставить("СуммаСПТекущаяЗТМ",	0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(СМ_НРиСП.СуммаНРНаОбъем) КАК СуммаНРНаОбъем,
	               |	СУММА(СМ_НРиСП.СуммаНРМашинистовНаОбъем) КАК СуммаНРНаОбъемЗТМ,
	               |	СУММА(СМ_НРиСП.СуммаСПНаОбъем) КАК СуммаСПНаОбъем,
	               |	СУММА(СМ_НРиСП.СуммаСПМашинистовНаОбъем) КАК СуммаСПНаОбъемЗТМ,
	               |	СУММА(СМ_НРиСП.ТекСуммаНРНаОбъем) КАК ТекСуммаНРНаОбъем,
	               |	СУММА(СМ_НРиСП.ТекСуммаНРМашинистовНаОбъем) КАК ТекСуммаНРНаОбъемЗТМ,
	               |	СУММА(СМ_НРиСП.ТекСуммаСПНаОбъем) КАК ТекСуммаСПНаОбъем,
	               |	СУММА(СМ_НРиСП.ТекСуммаСПМашинистовНаОбъем) КАК ТекСуммаСПНаОбъемЗТМ
	               |ИЗ
	               |	РегистрСведений.СМ_НРиСП КАК СМ_НРиСП
	               |ГДЕ
	               |	СМ_НРиСП.Позиция = &Позиция
	               |	И СМ_НРиСП.Смета = &Смета";
	
	Запрос.УстановитьПараметр("Позиция",Позиция);
	Запрос.УстановитьПараметр("Смета",Смета);
	
	Выборка = запрос.Выполнить().Выбрать();
	Если выборка.Следующий() Тогда
		СуммаНРНаОбъем = ?(выборка.СуммаНРНаОбъем = null, 0, выборка.СуммаНРНаОбъем);
		СуммаНРНаОбъемЗТМ = ?(выборка.СуммаНРНаОбъемЗТМ = null, 0, выборка.СуммаНРНаОбъемЗТМ);
		ТекСуммаНРНаОбъем = ?(выборка.ТекСуммаНРНаОбъем = null, 0, выборка.ТекСуммаНРНаОбъем);
		ТекСуммаНРНаОбъемЗТМ = ?(выборка.ТекСуммаНРНаОбъемЗТМ = null, 0, выборка.ТекСуммаНРНаОбъемЗТМ);
		
		СуммаСПНаОбъем = ?(выборка.СуммаСПНаОбъем = null, 0, выборка.СуммаСПНаОбъем);
		СуммаСПНаОбъемЗТМ = ?(выборка.СуммаСПНаОбъемЗТМ = null, 0, выборка.СуммаСПНаОбъемЗТМ);
		ТекСуммаСПНаОбъем = ?(выборка.ТекСуммаСПНаОбъем = null, 0, выборка.ТекСуммаСПНаОбъем);
		ТекСуммаСПНаОбъемЗТМ = ?(выборка.ТекСуммаСПНаОбъемЗТМ = null, 0, выборка.ТекСуммаСПНаОбъемЗТМ);
		Если СуммаНРНаОбъем + СуммаНРНаОбъемЗТМ <> 0 Тогда
			структураОтвета.Вставить("СуммаНРБазисная",	СуммаНРНаОбъем + СуммаНРНаОбъемЗТМ);
			СтруктураОтвета.Вставить("СуммаНРБазиснаяЗТР",	СуммаНРНаОбъем);
			СтруктураОтвета.Вставить("СуммаНРБазиснаяЗТМ",	СуммаНРНаОбъемЗТМ);
		КонецЕсли;
		Если ТекСуммаНРНаОбъем + ТекСуммаНРНаОбъемЗТМ <> 0 Тогда
			структураОтвета.Вставить("СуммаНРТекущая",	ТекСуммаНРНаОбъем + ТекСуммаНРНаОбъемЗТМ);
			СтруктураОтвета.Вставить("СуммаНРТекущаяЗТР",	ТекСуммаНРНаОбъем);
			СтруктураОтвета.Вставить("СуммаНРТекущаяЗТМ",	ТекСуммаНРНаОбъемЗТМ);
		КонецЕсли;
		Если СуммаСПНаОбъем  + СуммаСПНаОбъемЗТМ <> 0 Тогда
			структураОтвета.Вставить("СуммаСПБазисная",	СуммаСПНаОбъем + СуммаСПНаОбъемЗТМ);
			СтруктураОтвета.Вставить("СуммаСПБазиснаяЗТР", 	СуммаСПНаОбъем);
			СтруктураОтвета.Вставить("СуммаСПБазиснаяЗТМ",	СуммаСПНаОбъемЗТМ);
		КонецЕсли;
		Если ТекСуммаСПНаОбъем + ТекСуммаСПНаОбъемЗТМ <> 0 Тогда
			структураОтвета.Вставить("СуммаСПТекущая",	ТекСуммаСПНаОбъем + ТекСуммаСПНаОбъемЗТМ);
			СтруктураОтвета.Вставить("СуммаСПТекущаяЗТР",	ТекСуммаСПНаОбъем);
			СтруктураОтвета.Вставить("СуммаСПТекущаяЗТМ",	ТекСуммаСПНаОбъемЗТМ);
		КонецЕсли;
	КонецЕсли;	
	
	Возврат структураОтвета;
	
КонецФункции	

