			КонецЕсли;
			Если ПараметрыПечати.МетодикаТСН = Ложь Тогда		
				Если ПозицияСметы.ПоправочныйКоэффициентКНРТекущий <> 0 Тогда
					КоэффициентыНаПечать = КоэффициентыНаПечать + "*"+строка(ПозицияСметы.ПоправочныйКоэффициентКНРТекущий);
				КонецЕсли;	
				
				Если ПозицияСметы.КоэффициентКНРАЭСТекущий <> 0 Тогда
					КоэффициентыНаПечать = КоэффициентыНаПечать + "*"+строка(ПозицияСметы.КоэффициентКНРАЭСТекущий);
				КонецЕсли;	
				
				Если ПозицияСметы.КоэффициентКНРНаРемонтТекущий <> 0 Тогда
					КоэффициентыНаПечать = КоэффициентыНаПечать + "*"+строка(ПозицияСметы.КоэффициентКНРНаРемонтТекущий);
				КонецЕсли;
				
				Если ПозицияСметы.КоэффициентКНРУСНТекущий <> 0 Тогда
					КоэффициентыНаПечать = КоэффициентыНаПечать + "*"+строка(ПозицияСметы.КоэффициентКНРУСНТекущий);
				КонецЕсли;
			Иначе
				// Могут быть свои коэффициенты.
			КонецЕсли;
			
			Если СокрЛП(КоэффициентыНаПечать) = "0" Тогда
				КоэффициентыНаПечать = "";
			КонецЕсли;		
			
			Если  ПараметрыПечати.ЭтоМетодикаТСН11а Или ПараметрыПечати.ЭтоМетодикаТСН11б  Тогда
				ТекСтрока = ПараметрыПечати.АктСсылка.Позиции.Найти(ПозицияСметы);
				Если ПараметрыПечати.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
					КоэффициентыНаПечатьБазис = Строка(ТекСтрока.НРТСНБазисРемонт);
