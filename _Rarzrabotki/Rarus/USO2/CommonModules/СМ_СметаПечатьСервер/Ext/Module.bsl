				СтрокаПозицияДопФОТ.Параметры.Коэфпересчета 		= КоэффициентыНаПечать;
			КонецЕсли;
			СтрокаПозицияДопФОТ.Параметры.СтоимТек          	= Окр(СуммыНРиСП.СуммаСПТекущаяЗТР,2);
