						ИтогРаздела.Параметры.ИтогМат		= Формат(Окр(Выборка.СтоимСтоимМатер,КолЗнаков),СтрокаФормата);
					КонецЕсли;	
					ИтогРаздела.Параметры.ИтогЭМвтч 		= Формат(Окр(Выборка.СтоимЗарплМашин,КолЗнаков),СтрокаФормата);
					ИтогРаздела.Параметры.ИтогЗатрТрРаб		= Окр(Выборка.ЗатратыТрудаРабочих,2);
					ИтогРаздела.Параметры.ИтогЗатрТрМех 	= Окр(Выборка.ЗатратыТрудаМашин,2);
					ИтогРаздела.Параметры.НаименованиеИтога = ИтогРаздела.Параметры.НаименованиеИтога + " "+ ВернутьСтрокуРасшифровки(Выборка.Итог,Раздел,ПараметрыПечати);
				КонецЕсли;
				
			Иначе	
				ИтогРаздела.Параметры.Итог				= Формат(Окр(Выборка.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
				Если ПараметрыПечати.ЭтоМетодикаТСН11б Или  ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
					ИтогРаздела.Параметры.ИтогБазис				= Формат(Окр(Выборка.ПрямЗатраты,КолЗнаков),СтрокаФормата);
				КонецЕсли;
				
				Если ПараметрыПечати.Это12Граф = ложь И ПараметрыПечати.ЭтоМетодикаТСН11а = ложь
					И ПараметрыПечати.ЭтоМетодикаТСН11б = ложь И ПараметрыПечати.ЭтоМетодикаТСН9в = ложь Тогда
					ИтогРаздела.Параметры.ИтогОЗ			= Формат(Окр(Выборка.ТекСтоимОснЗарплата,КолЗнаков),СтрокаФормата);
					ИтогРаздела.Параметры.ИтогЭМ			= Формат(Окр(Выборка.ТекСтоимЭксплМашин,КолЗнаков),СтрокаФормата);
					Если НЕ ПараметрыПечати.Это11Граф И НЕ ПараметрыПечати.Это11ГрафСНРиСП Тогда
						ИтогРаздела.Параметры.ИтогМат		= Формат(Окр(Выборка.ТекСтоимСтоимМатер,КолЗнаков),СтрокаФормата);
					КонецЕсли;	
					ИтогРаздела.Параметры.ИтогЭМвтч 		= Формат(Окр(Выборка.ТекСтоимЗарплМашин,КолЗнаков),СтрокаФормата);
					ИтогРаздела.Параметры.ИтогЗатрТрРаб		= Окр(Выборка.ЗатратыТрудаРабочих,2);
					ИтогРаздела.Параметры.ИтогЗатрТрМех 	= Окр(Выборка.ЗатратыТрудаМашин,2);
					ИтогРаздела.Параметры.НаименованиеИтога = ИтогРаздела.Параметры.НаименованиеИтога + " "+ ВернутьСтрокуРасшифровки(Выборка.Итог,Раздел,ПараметрыПечати);
				КонецЕсли;
			КонецЕсли;
			Если ПараметрыПечати.Методика1984 И ПараметрыПечати.РасчетНРиСПотПЗ	Тогда
				Если Выборка.Итог = Справочники.СМ_ИтогиПоРазделу.НаклРасх Тогда
					Табл = ПолучитьНРПоВидамРабот(Раздел, РодительРаздел,ПараметрыПечати);
					Для Каждого СтрокаТабл Из  Табл Цикл
						ИтогРаздела.Параметры.НаименованиеИтога = "Накладные расходы, в "+Сред(СокрЛП(СтрокаТабл.Итог.Наименование),2);
						ИтогРаздела.Параметры.Итог				= Формат(Окр(СтрокаТабл.ТекСуммаНРНаОбъем,КолЗнаков),СтрокаФормата);
						ПоследняяОбласть 						= ТабличныйДокумент.Вывести(ИтогРаздела);
					КонецЦикла;
					
					ИтогРаздела.Параметры.НаименованиеИтога = СокрЛП(Выборка.Итог.Наименование);
					ИтогРаздела.Параметры.Итог				= Формат(Окр(Выборка.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
					Если ПараметрыПечати.ЭтоМетодикаТСН11б Или ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
						ИтогРаздела.Параметры.ИтогБазис	= Формат(Окр(Выборка.ПрямЗатраты,КолЗнаков),СтрокаФормата);
					КонецЕсли;
					
					Если ПараметрыПечати.Это12Граф = ложь И ПараметрыПечати.ЭтоМетодикаТСН11а = ложь
						И ПараметрыПечати.ЭтоМетодикаТСН11б = ложь И ПараметрыПечати.ЭтоМетодикаТСН9в = ложь Тогда
						ИтогРаздела.Параметры.ИтогОЗ			= Формат(Окр(Выборка.ТекСтоимОснЗарплата,КолЗнаков),СтрокаФормата);
						ИтогРаздела.Параметры.ИтогЭМ			= Формат(Окр(Выборка.ТекСтоимЭксплМашин,КолЗнаков),СтрокаФормата);
						Если НЕ ПараметрыПечати.Это11Граф И НЕ ПараметрыПечати.Это11ГрафСНРиСП Тогда
							ИтогРаздела.Параметры.ИтогМат		= Формат(Окр(Выборка.ТекСтоимСтоимМатер,КолЗнаков),СтрокаФормата);
						КонецЕсли;	
						ИтогРаздела.Параметры.ИтогЭМвтч 		= Формат(Окр(Выборка.ТекСтоимЗарплМашин,КолЗнаков),СтрокаФормата);
						ИтогРаздела.Параметры.ИтогЗатрТрРаб		= Окр(Выборка.ЗатратыТрудаРабочих,2);
						ИтогРаздела.Параметры.ИтогЗатрТрМех 	= Окр(Выборка.ЗатратыТрудаМашин,2);
						ИтогРаздела.Параметры.НаименованиеИтога = ИтогРаздела.Параметры.НаименованиеИтога + " "+ ВернутьСтрокуРасшифровки(Выборка.Итог,Раздел,ПараметрыПечати);
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			ПоследняяОбласть = ТабличныйДокумент.Вывести(ИтогРаздела);
			
		КонецЕсли;
		
		
	КонецЦикла;
	
		// Итог возвратных материалов  раздела БИ метода.
	Если ПечатьАкта Тогда
		Если ВозвратныеМатериалы <> 0 Тогда
			ИтогРаздела.Параметры.НаименованиеИтога =  "Стоимость возвратных материалов";
			ИтогРаздела.Параметры.Итог = Формат(Окр(ВозвратныеМатериалы,КолЗнаков),СтрокаФормата);
			Если ПараметрыПечати.ЭтоМетодикаТСН11б Или  ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
				ИтогРаздела.Параметры.ИтогБазис				= "";
			КонецЕсли;
			Если НЕ ПараметрыПечати.Это12Граф И НЕ ПараметрыПечати.ЭтоКС2 И  НЕ ПараметрыПечати.ЭтоМетодикаТСН11а
				И НЕ ПараметрыПечати.ЭтоМетодикаТСН11б И НЕ  ПараметрыПечати.ЭтоМетодикаТСН9в	Тогда
				ИтогРаздела.Параметры.ИтогОЗ 		= "";
				ИтогРаздела.Параметры.ИтогЭМ 		= "";
				ИтогРаздела.Параметры.ИтогЗМ 		= "";
				ИтогРаздела.Параметры.ИтогЗатрТрРаб	= "";
				ИтогРаздела.Параметры.ИтогЗатрТрМех = "";
			КонецЕсли;
			
			Если ПараметрыПечати.Это14Граф Или ПараметрыПечати.ЭтоАктСНРиСП Тогда
				ИтогРаздела.Параметры.ИтогМат = "";
			КонецЕсли;
			ПоследняяОбласть = ТабличныйДокумент.Вывести(ИтогРаздела);
		КонецЕсли;
	Иначе
		// Смета.		
		Если ВозвратныеМатериалы <> 0 Тогда
			ИтогРаздела.Параметры.НаименованиеИтога =  "Стоимость возвратных материалов";
			ИтогРаздела.Параметры.Итог = Формат(Окр(ВозвратныеМатериалы,КолЗнаков),СтрокаФормата);
			Если ПараметрыПечати.ЭтоМетодикаТСН11б Или  ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
				ИтогРаздела.Параметры.ИтогБазис	= "";
			КонецЕсли;
			
			Если ПараметрыПечати.Это12Граф = ложь И ПараметрыПечати.ЭтоМетодикаТСН11а = ложь
				И ПараметрыПечати.ЭтоМетодикаТСН11б = ложь И ПараметрыПечати.ЭтоМетодикаТСН9в = ложь Тогда
				ИтогРаздела.Параметры.ИтогОЗ			= "";
				ИтогРаздела.Параметры.ИтогЭМ			= "";
				Если НЕ ПараметрыПечати.Это11Граф И НЕ ПараметрыПечати.Это11ГрафСНРиСП Тогда
					ИтогРаздела.Параметры.ИтогМат		= "";
				КонецЕсли;	
				ИтогРаздела.Параметры.ИтогЭМвтч 		= "";
				ИтогРаздела.Параметры.ИтогЗатрТрРаб		= "";
				ИтогРаздела.Параметры.ИтогЗатрТрМех 	= "";
			КонецЕсли;
			ПоследняяОбласть = ТабличныйДокумент.Вывести(ИтогРаздела);
		КонецЕсли;
		
		
	КонецЕсли;	

	Если ПоследняяОбласть <> Неопределено И ПараметрыПечати.ПечататьСетку Тогда
		Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
		ПоследняяОбласть.Обвести(Линия, , Линия, Линия);
	КонецЕсли;
	
КонецПроцедуры	

// Выводим итоги раздела по ресурсному методу счета.
//
Процедура ВывестиИтогиРазделаПоРесурсномуМетоду(ТабличныйДокумент,Раздел,ИтогРаздела,ПараметрыПечати,РодительРаздел)
	
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	СтрокаФормата = ?(КолЗнаков = 0, "ЧДЦ=0","ЧДЦ=2");
	ПеременныеДляПовтора = ИнициализироватьПеременныеДляПовтораЧП();	
	Если ПараметрыПечати.ПечататьРасшифровку И НЕ ПараметрыПечати.Это12Граф Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ИтогиПоРазделу.Итог,
		               |	СУММА(ИтогиПоРазделу.ТекСтоимПрямЗатраты) КАК ТекСтоимПрямЗатраты,
		               |	СУММА(ИтогиПоРазделу.СтоимПрямЗатраты) КАК СтоимПрямЗатраты,
		               |	СУММА(ИтогиПоРазделу.СтоимОборуд) КАК СтоимОборуд,
		               |	СУММА(ИтогиПоРазделу.СтоимОснЗарплата) КАК СтоимОснЗарплата,
		               |	СУММА(ИтогиПоРазделу.СтоимЭксплМашин) КАК СтоимЭксплМашин,
		               |	СУММА(ИтогиПоРазделу.СтоимЗарплМашин) КАК СтоимЗарплМашин,
		               |	СУММА(ИтогиПоРазделу.СтоимСтоимМатер) КАК СтоимСтоимМатер,
		               |	СУММА(ИтогиПоРазделу.ТекСтоимОснЗарплата) КАК ТекСтоимОснЗарплата,
		               |	СУММА(ИтогиПоРазделу.ТекСтоимЭксплМашин) КАК ТекСтоимЭксплМашин,
		               |	СУММА(ИтогиПоРазделу.ТекСтоимЗарплМашин) КАК ТекСтоимЗарплМашин,
		               |	СУММА(ИтогиПоРазделу.ТекСтоимСтоимМатер) КАК ТекСтоимСтоимМатер,
		               |	СУММА(ИтогиПоРазделу.ТекСтоимОборуд) КАК ТекСтоимОборуд,
		               |	СУММА(ИтогиПоРазделу.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
		               |	СУММА(ИтогиПоРазделу.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин
		               |ИЗ
		               |	РегистрСведений.СМ_ИтогиЧППоРазделу КАК ИтогиПоРазделу
		               |ГДЕ
		               |	ИтогиПоРазделу.Раздел = &Раздел
		               |	И ИтогиПоРазделу.Раздел.ИДРодителя = &РодительРаздел
		               |	И ИтогиПоРазделу.Смета = &Смета
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ИтогиПоРазделу.Итог
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ИтогиПоРазделу.Итог.ПорядковыйНомер";
		
		Запрос.УстановитьПараметр("Раздел",Раздел);	
		Запрос.УстановитьПараметр("РодительРаздел",РодительРаздел);	
		
		Если ПечатьАкта Тогда
			Запрос.УстановитьПараметр("Смета",ПараметрыПечати.АктСсылка);
		Иначе
			Запрос.УстановитьПараметр("Смета",ПараметрыПечати.СметаСсылка);
		КонецЕсли;
		
		// Печать по акту выполненных работ.
		Если ПечатьАкта Тогда
			
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Если Выборка.ТекСтоимПрямЗатраты = 0 И Выборка.ТекСтоимОборуд = 0 И Выборка.ТекСтоимОснЗарплата = 0 И Выборка.ТекСтоимЭксплМашин = 0 И Выборка.ТекСтоимСтоимМатер = 0  И Выборка.ТекСтоимЗарплМашин = 0 И Выборка.ЗатратыТрудаРабочих = 0 И Выборка.ЗатратыТрудаМашин = 0 Тогда
					Продолжить;
				КонецЕсли;	
					
				Если ПропуститьСтрокуИзЗаПовтораИтога(ПеременныеДляПовтора,выборка,Параметрыпечати,"СМ_ИтогиЧППоРазделу") = истина Тогда
					Продолжить;
				КонецЕсли;	
				
				ИтогРаздела.Параметры.НаименованиеИтога	 = СокрЛП(Выборка.Итог.Наименование);
				
				Если ПараметрыПечати.ЭтоКС2Рес Тогда
					ИтогРаздела.Параметры.Итог 				= Формат(Окр(Выборка.ТекСтоимПрямЗатраты + Выборка.ТекСтоимОборуд, КолЗнаков),СтрокаФормата);
					ИтогРаздела.Параметры.ЗаработнаяПлата	= Формат(Окр(Выборка.ТекСтоимОснЗарплата, КолЗнаков),СтрокаФормата);
				Иначе	
					ИтогРаздела.Параметры.ПрямыеЗатраты			= Формат(Окр(Выборка.ТекСтоимПрямЗатраты + Выборка.ТекСтоимОборуд,	КолЗнаков),СтрокаФормата);
					ИтогРаздела.Параметры.ЗаработнаяПлата		= Формат(Окр(Выборка.ТекСтоимОснЗарплата,	КолЗнаков),СтрокаФормата);
					ИтогРаздела.Параметры.МашиныИМеханизмы		= Формат(Окр(Выборка.ТекСтоимЭксплМашин,	КолЗнаков),СтрокаФормата);
					ИтогРаздела.Параметры.ЗарплатаМашинистов	= Формат(Окр(Выборка.ТекСтоимЗарплМашин,	КолЗнаков),СтрокаФормата);
					ИтогРаздела.Параметры.Материалы				= Формат(Окр(Выборка.ТекСтоимСтоимМатер,	КолЗнаков),СтрокаФормата);
					ИтогРаздела.Параметры.ЗТР			 		= Окр(Выборка.ЗатратыТрудаРабочих,	2);
					ИтогРаздела.Параметры.ЗТМ					= Окр(Выборка.ЗатратыТрудаМашин,	2);
				КонецЕсли;	
				
				Если Выборка.Итог.Накопительный Тогда
					Если ПараметрыПечати.ЭтоКС2Рес Тогда
						ПеременныеДляПовтора.ТекСтоимПрямЗатраты = ИтогРаздела.Параметры.Итог;
						ПеременныеДляПовтора.ТекСтоимОборуд = Окр(Выборка.ТекСтоимОборуд, КолЗнаков);
						ПеременныеДляПовтора.ТекСтоимОснЗарплата = ИтогРаздела.Параметры.ЗаработнаяПлата;
					Иначе
						ПеременныеДляПовтора.ТекСтоимОснЗарплата	= ИтогРаздела.Параметры.ЗаработнаяПлата;	
						ПеременныеДляПовтора.ТекСтоимОборуд  		= Окр(Выборка.ТекСтоимОборуд,	КолЗнаков);	
						ПеременныеДляПовтора.ТекСтоимЭксплМашин     = ИтогРаздела.Параметры.МашиныИМеханизмы;
						ПеременныеДляПовтора.ТекСтоимЗарплМашин 	= ИтогРаздела.Параметры.ЗарплатаМашинистов; 
						ПеременныеДляПовтора.ЗатратыТрудаРабочих 	= ИтогРаздела.Параметры.ЗТР;	
						ПеременныеДляПовтора.ЗатратыТрудаМашин 		= ИтогРаздела.Параметры.ЗТМ;
