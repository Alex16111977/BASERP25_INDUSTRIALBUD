Процедура ВывестиИтогиВозвратРаздела_КЗ(ТабличныйДокумент,Раздел,ИтогРаздела,ПараметрыПечати,РодительРаздел,НомерРаздела)
	
	ПечатьАкта = Ложь;
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	СтрокаФормата = ?(КолЗнаков = 0, "ЧДЦ=0","ЧДЦ=2");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИтогиПоРазделу.Итог КАК Итог,
	               |	СУММА(ИтогиПоРазделу.ТекПрямЗатраты) КАК ТекПрямЗатраты,
	               |	СУММА(ИтогиПоРазделу.ПрямЗатраты) КАК ПрямЗатраты,
	               |	СУММА(ИтогиПоРазделу.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
	               |	СУММА(ИтогиПоРазделу.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
	               |	СУММА(ИтогиПоРазделу.ТекОснЗарплата) КАК ТекОснЗарплата,
	               |	СУММА(ИтогиПоРазделу.ТекЭксплМашин) КАК ТекЭксплМашин,
	               |	СУММА(ИтогиПоРазделу.ТекЗарплМашин) КАК ТекЗарплМашин,
	               |	СУММА(ИтогиПоРазделу.ТекСтоимМатер) КАК ТекСтоимМатер,
	               |	СУММА(ИтогиПоРазделу.ТекОборуд) КАК ТекОборуд,
	               |	СУММА(ИтогиПоРазделу.ТекВозвратМатер) КАК ТекВозвратМатер,
	               |	СУММА(ИтогиПоРазделу.ОснЗарплата) КАК ОснЗарплата,
	               |	СУММА(ИтогиПоРазделу.ЭксплМашин) КАК ЭксплМашин,
	               |	СУММА(ИтогиПоРазделу.ЗарплМашин) КАК ЗарплМашин,
	               |	СУММА(ИтогиПоРазделу.СтоимМатер) КАК СтоимМатер,
	               |	СУММА(ИтогиПоРазделу.Оборуд) КАК Оборуд,
	               |	СУММА(ИтогиПоРазделу.ВозвратМатер) КАК ВозвратМатер
	               |ИЗ
	               |	РегистрСведений.СМ_ИтогиПоРазделу КАК ИтогиПоРазделу
	               |ГДЕ
	               |	ИтогиПоРазделу.Раздел = &Раздел
	               |	И ИтогиПоРазделу.Смета = &Смета
	               |	И ИтогиПоРазделу.Итог = &Итог
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИтогиПоРазделу.Итог
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИтогиПоРазделу.Итог.ПорядковыйНомер";
	Запрос.УстановитьПараметр("Раздел",Раздел);	
	Запрос.УстановитьПараметр("Смета",ПараметрыПечати.СметаСсылка);
	Запрос.УстановитьПараметр("Итог",Справочники.СМ_ИтогиПоРазделу.ВсегоПоРазделу); 
	
	ТекВозвратныеМатериалы = 0; 
	ВозвратныеМатериалы = 0; 
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ВозвратныеМатериалы = Выборка.ВозвратМатер;
		ТекВозвратныеМатериалы = Выборка.ТекВозвратМатер;
		
	КонецЕсли;
	
	// Печать Возвратных материалов по ресурсной смете
	Если  ВозвратныеМатериалы <> 0 И ТекВозвратныеМатериалы <> 0 Тогда
		ИтогРаздела.Параметры.НаименованиеИтога 	=  "Стоимость возвратных материалов";
		ИтогРаздела.Параметры.Измеритель = ПолучитьСтруктуруОбозначенияВалюты(ПараметрыПечати.СметаСсылка).ПечВалюта;

		Если ПараметрыПечати.ВБазисномУровне Тогда
			ИтогРаздела.Параметры.ЕдТек					= "";
			ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(ВозвратныеМатериалы,	КолЗнаков),СтрокаФормата);
		Иначе	
			ИтогРаздела.Параметры.ЕдТек					= "";
			ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(ТекВозвратныеМатериалы,	КолЗнаков),СтрокаФормата);
		КонецЕсли;	
		ТабличныйДокумент.Вывести(ИтогРаздела);
		
	КонецЕсли;	
	
КонецПроцедуры	

// Функция получает суммы НР  по позиции из регистра СМ_НРиСП и суммирует их по видам работ.
// Только для методики 1984, при расчете НР от прямых затрат. 
Функция ПолучитьНРПоВидамРабот_КЗ(Раздел, РодительРаздел, ПараметрыПечати, ВидРабот = Неопределено)
	
	МетодРасчета =  ПараметрыПечати.МетодРасчета;
	Уровень  = ПараметрыПечати.УровеньЗаданияИндексов;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_НРиСП.Смета КАК Смета,
	               |	СМ_НРиСП.Раздел КАК Раздел,
	               |	СМ_НРиСП.Позиция КАК Позиция,
	               |	ВЫБОР
	               |		КОГДА СМ_НРиСП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.МонтажныеРаботы)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.МонтажнРаб)
	               |		КОГДА СМ_НРиСП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.СтроитРаб)
	               |		КОГДА СМ_НРиСП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.МеталломонтажныеРаботы)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.Металлоконстр)
	               |		КОГДА СМ_НРиСП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.СантехническиеРаботы)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.СантехнРаб)
	               |		КОГДА СМ_НРиСП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.БуровзрывныеРаботы)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.БуровзрывнРаб)
	               |		КОГДА СМ_НРиСП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.ГорнопроходческиеРаботы)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.ГорнопрохРаб)
	               |		КОГДА СМ_НРиСП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.ПрочиеРаботы)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.ПрочРаб)
	               |		КОГДА СМ_НРиСП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.Оборудование)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.Оборуд)
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.ПустаяСсылка)
	               |	КОНЕЦ КАК Итог,
	               |	СУММА(СМ_НРиСП.СуммаНРНаОбъем) КАК СуммаНРНаОбъем,
	               |	СУММА(СМ_НРиСП.СуммаНР2НаОбъем) КАК СуммаНР2НаОбъем,
	               |	СУММА(СМ_НРиСП.СуммаСПНаОбъем) КАК СуммаСПНаОбъем,
	               |	СУММА(СМ_НРиСП.ТекСуммаНРНаОбъем) КАК ТекСуммаНРНаОбъем,
	               |	СУММА(СМ_НРиСП.ТекСуммаНР2НаОбъем) КАК ТекСуммаНР2НаОбъем,
	               |	СУММА(СМ_НРиСП.ТекСуммаСПНаОбъем) КАК ТекСуммаСПНаОбъем,
	               |	СУММА(СМ_НРиСП.ТекСуммаСП2НаОбъем) КАК ТекСуммаСП2НаОбъем,
	               |	СУММА(СМ_НРиСП.СуммаСП2НаОбъем) КАК СуммаСП2НаОбъем
	               |ИЗ
	               |	РегистрСведений.СМ_НРиСП КАК СМ_НРиСП
	               |ГДЕ
	               |	СМ_НРиСП.Раздел = &Раздел
	               |	И СМ_НРиСП.Смета = &Смета
	               |	И (СМ_НРиСП.Позиция.Определитель.ВидРабот = &ВидРабот ИЛИ &ВидРабот = НЕОПРЕДЕЛЕНО) // Для вывода всех НР2 и СП по разделу.
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_НРиСП.Смета,
	               |	СМ_НРиСП.Раздел,
	               |	СМ_НРиСП.Позиция,
	               |	ВЫБОР
	               |		КОГДА СМ_НРиСП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.МонтажныеРаботы)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.МонтажнРаб)
	               |		КОГДА СМ_НРиСП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.СтроитРаб)
	               |		КОГДА СМ_НРиСП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.МеталломонтажныеРаботы)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.Металлоконстр)
	               |		КОГДА СМ_НРиСП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.СантехническиеРаботы)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.СантехнРаб)
	               |		КОГДА СМ_НРиСП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.БуровзрывныеРаботы)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.БуровзрывнРаб)
	               |		КОГДА СМ_НРиСП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.ГорнопроходческиеРаботы)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.ГорнопрохРаб)
	               |		КОГДА СМ_НРиСП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.ПрочиеРаботы)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.ПрочРаб)
	               |		КОГДА СМ_НРиСП.Позиция.Определитель.ВидРабот = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыЗатратСмета.Оборудование)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.Оборуд)
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.ПустаяСсылка)
	               |	КОНЕЦ";
	
	Запрос.УстановитьПараметр("Раздел",Раздел);
	Запрос.УстановитьПараметр("Смета",ПараметрыПечати.СметаСсылка);
	Запрос.УстановитьПараметр("ВидРабот",ВидРабот);
	
	НаборКоэфф  = Раздел;
	
	Выборка = Запрос.Выполнить().Выгрузить();
	Выборка.Свернуть("Смета,Раздел,Итог","СуммаНРНаОбъем,ТекСуммаНРНаОбъем,СуммаСПНаОбъем,ТекСуммаСПНаОбъем,СуммаНР2НаОбъем,ТекСуммаНР2НаОбъем,СуммаСП2НаОбъем,ТекСуммаСП2НаОбъем");
	Если МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
		И Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда
		КоэффОЗ = ?(НаборКоэфф.КоэффОснЗарплаты = 0, 1, НаборКоэфф.КоэффОснЗарплаты);
		Для Каждого СтрокаВыборки Из Выборка Цикл
			СтрокаВыборки.ТекСуммаНРНаОбъем = СтрокаВыборки.ТекСуммаНРНаОбъем * КоэффОЗ; 	
			СтрокаВыборки.ТекСуммаСПНаОбъем = СтрокаВыборки.ТекСуммаСПНаОбъем * КоэффОЗ;
			СтрокаВыборки.ТекСуммаНР2НаОбъем = СтрокаВыборки.ТекСуммаНР2НаОбъем * КоэффОЗ; 	
			СтрокаВыборки.ТекСуммаСП2НаОбъем = СтрокаВыборки.ТекСуммаСП2НаОбъем * КоэффОЗ; 	
		КонецЦикла;	
	КонецЕсли;
	
	Возврат Выборка;
	
	
КонецФункции	

Функция ПолучитьНРиСППоПозиции_КЗ(Позиция,Смета)
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("НР1",	0);
	СтруктураОтвета.Вставить("НР2",	0);
	СтруктураОтвета.Вставить("СП2", 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(ЕСТЬNULL(СМ_НРиСП.ТекСуммаНРНаОбъем, 0)) КАК НР1,
	               |	СУММА(ЕСТЬNULL(СМ_НРиСП.ТекСуммаСП2НаОбъем, 0)) КАК СП2,
	               |	СУММА(ЕСТЬNULL(СМ_НРиСП.ТекСуммаНР2НаОбъем, 0)) КАК НР2
	               |ИЗ
	               |	РегистрСведений.СМ_НРиСП КАК СМ_НРиСП
	               |ГДЕ
	               |	СМ_НРиСП.Позиция = &Позиция
	               |	И СМ_НРиСП.Смета = &Смета";
	
	Запрос.УстановитьПараметр("Позиция",Позиция);
	Запрос.УстановитьПараметр("Смета",Смета);
	
	Выборка = запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтруктураОтвета.Вставить("НР1",	?(Выборка.НР1=null,0,Выборка.НР1));
		СтруктураОтвета.Вставить("НР2",	?(Выборка.НР2=null,0,Выборка.НР2));
		СтруктураОтвета.Вставить("СП2", ?(Выборка.СП2=null,0,Выборка.СП2));
	КонецЕсли;	
	
	Возврат СтруктураОтвета;
	
КонецФункции	

Процедура ВывестиПозиции_КЗ(ТабличныйДокумент,ИдРодителя,СтрокаПозиция,СтрокаРесурс,ИтогВидРесурса,ПараметрыПечати,ИтогНРиСП)
	
	Текст = "ВЫБРАТЬ
	        |	СМ_НумерацияПозицийЛокальныхСмет.Позиция КАК Позиция,
	        |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	        |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	        |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
	        |ПОМЕСТИТЬ НомераРазделовСметы
	        |ИЗ
	        |	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	        |ГДЕ
	        |	СМ_НумерацияПозицийЛокальныхСмет.Смета = &ИДРодителя
	        |	И НЕ СМ_НумерацияПозицийЛокальныхСмет.Позиция = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ПозицияЛокальнойСметы.Ссылка КАК Ссылка,
	        |	НомераРазделовСметы.НомерВДереве КАК ПорНомер,
	        |	СУММА(ЕСТЬNULL(СМ_СредняяТекущаяСтоимостьПозиции.Стоимость, 0)) КАК Стоимость
	        |ПОМЕСТИТЬ ИтоговаяТаблица
	        |ИЗ
	        |	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СредняяТекущаяСтоимостьПозиции КАК СМ_СредняяТекущаяСтоимостьПозиции
	        |		ПО (СМ_СредняяТекущаяСтоимостьПозиции.Позиция = ПозицияЛокальнойСметы.Ссылка)
	        |		ЛЕВОЕ СОЕДИНЕНИЕ НомераРазделовСметы КАК НомераРазделовСметы
	        |		ПО ПозицияЛокальнойСметы.Ссылка = НомераРазделовСметы.Позиция
	        |ГДЕ
	        |	ПозицияЛокальнойСметы.ИДСметы = &ИДРодителя
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ПозицияЛокальнойСметы.Ссылка,
	        |	НомераРазделовСметы.НомерВДереве
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ИтоговаяТаблица.Ссылка,
	        |	ИтоговаяТаблица.ПорНомер КАК ПорНомер,
	        |	ИтоговаяТаблица.Стоимость
	        |ИЗ
	        |	ИтоговаяТаблица КАК ИтоговаяТаблица
	        |
	        |УПОРЯДОЧИТЬ ПО
	        |	ПорНомер";
	
	Запрос = Новый Запрос;
	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("ИДРодителя",ИдРодителя);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Ссылка.ПометкаУдаления = Истина ИЛИ Выборка.Ссылка.Расчет = Ложь Тогда
			Продолжить;
		КонецЕсли;
		ВывестиСтрокуПозицииРесурснойСметы_КЗ(Выборка.Ссылка, ТабличныйДокумент,СтрокаПозиция,СтрокаРесурс,ПараметрыПечати,ИтогНРиСП,ИтогВидРесурса,Выборка.Ссылка.ИДСметы);
	КонецЦикла;	
	
КонецПроцедуры

// Процедура выводит строку - позицию Локальной сметы с ресурсным методом счета в ТабличныйДокумент.
//
Процедура ВывестиСтрокуПозицииРесурснойСметы_КЗ(ПозицияСметы,ТабличныйДокумент,СтрокаПозиция,СтрокаРесурс,ПараметрыПечати,ИтогНРиСП,ИтогВидРесурса = Неопределено,Смета = Неопределено)
	
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	СтрокаФормата = ?(КолЗнаков = 0, "ЧДЦ=0","ЧДЦ=2");
	
	Номера = СМ_СметаВызовСервера.ПолучитьНомерДокумента(ПозицияСметы.Ссылка, "СМ_ПозицияЛокальнойСметы");
	
	// Печать по акту выполненных работ.
	Если ПечатьАкта Тогда
		ФактОбъем = ПолучитьОбъемПоПозицииАкта(ПараметрыПечати.АктСсылка,ПозицияСметы);
		Если ФактОбъем = 0 Тогда
			Возврат;
		КонецЕсли;
		ПараметрыПечати.НомерПоПорядкуАкт = ПараметрыПечати.НомерПоПорядкуАкт + 1;	
		
		СтрокаПозиция.Параметры.ПорНомер			= Номера.ПорНомер;
		СтрокаПозиция.Параметры.ШифрРасценки		= СформироватьПолеОбоснование(ПозицияСметы,ПараметрыПечати);
		СтрокаПозиция.Параметры.НаименованиеПозиции = СформироватьНаименованиеПозиции(ПозицияСметы,ПараметрыПечати);
		СтрокаПозиция.Параметры.Измеритель          = Сокрлп(ПозицияСметы.Измеритель);						
		
		Если ПараметрыПечати.ПечататьРасшифровку = Истина Тогда
			Стоимости = ПолучитьСтоимостиПозиции(ПозицияСметы,ПараметрыПечати,Ложь,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками",ФактОбъем);
		Иначе
			Стоимости = ПолучитьСтоимостиПозиции(ПозицияСметы,ПараметрыПечати,Ложь,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП",ФактОбъем);
		КонецЕсли;
		
		Если ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП Тогда
			ЕдиничныеСтоимости = ПолучитьЕдиничныеСтоимостиПозиции(ПозицияСметы,ПараметрыПечати,Ложь,ФактОбъем);
		Иначе
			ЕдиничныеСтоимости = ПолучитьЕдиничныеСтоимостиПозицииРесМет(ПозицияСметы,ПараметрыПечати,Ложь,ФактОбъем);
		КонецЕсли;	
		
		Если ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП Или ПараметрыПечати.ПечататьРасшифровку = Ложь Тогда
			ЗТР = ПолучитьЗТР(ПозицияСметы,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП",ПараметрыПечати);
		Иначе	
			ЗТР = ПолучитьЗТР(ПозицияСметы,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками",ПараметрыПечати);
		КонецЕсли;	                          
		
		СуммыНРиСП = ПолучитьСуммыНРиСППоПозиции(ПозицияСметы.Ссылка,ПараметрыПечати.АктСсылка);
		
		СтрокаПозиция.Параметры.Количество 	= ФактОбъем;	
		
		СтрокаПозиция.Параметры.ЕдЗП			= Формат(Окр(?(Стоимости.ТекСтоимОснЗарплата=0,Стоимости.ТекСтоимПрямЗатраты,Стоимости.ТекСтоимОснЗарплата),	КолЗнаков),СтрокаФормата);
		СтрокаПозиция.Параметры.ЕдМашиныИМех	= Формат(Окр(Стоимости.ТекСтоимЭксплМашин,	КолЗнаков),СтрокаФормата);
		СтрокаПозиция.Параметры.ЕдЗрплМаш		= Формат(Окр(Стоимости.ТекСтоимЗарплМашин,	КолЗнаков),СтрокаФормата);
		СтрокаПозиция.Параметры.ЕдЗТР		    = Окр(ЗТР.ЗатратыТрудаРабочих,	2);
		
		СтрокаПозиция.Параметры.ЗП			= Формат(Окр(?(Стоимости.ТекСтоимОснЗарплата=0,Стоимости.ТекСтоимПрямЗатраты,Стоимости.ТекСтоимОснЗарплата)	* ФактОбъем,	КолЗнаков),СтрокаФормата);
		СтрокаПозиция.Параметры.МашиныИМех	= Формат(Окр(Стоимости.ТекСтоимЭксплМашин	* ФактОбъем,	КолЗнаков),СтрокаФормата);
		СтрокаПозиция.Параметры.ЗрплМаш		= Формат(Окр(Стоимости.ТекСтоимЗарплМашин	* ФактОбъем,	КолЗнаков),СтрокаФормата);
		СтрокаПозиция.Параметры.ЗТР		    = Окр(ЗТР.ЗатратыТрудаРабочих	 * ФактОбъем,	2);
		
		
		СтрокаПозиция.Параметры.НР_процент  = ПозицияСметы.НакладныеРасходыТекущие;
		СтрокаПозиция.Параметры.НР          = Формат(Окр(СуммыНРиСП.СуммаНРТекущая,	КолЗнаков),СтрокаФормата);
		
		Если ПозицияСметы.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал Тогда
			СтрокаПозиция.Параметры.ЕдЗП			= Формат(Окр(Стоимости.ТекСтоимСтоимМатер,	КолЗнаков),СтрокаФормата);
			СтрокаПозиция.Параметры.ЗП			= Формат(Окр(Стоимости.ТекСтоимСтоимМатер	* ФактОбъем,	КолЗнаков),СтрокаФормата);
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(СтрокаПозиция);
		
		// Печать по локальной смете.
	Иначе
		СтрокаПозиция.Параметры.ПорНомер			= Номера.ПорНомер;
		СтрокаПозиция.Параметры.ШифрРасценки		= СформироватьПолеОбоснование(ПозицияСметы,ПараметрыПечати);
		
		Если ПараметрыПечати.РасшифроватьСостав Тогда
			СоставРабот = СформироватьСоставРабот(ПозицияСметы);
		КонецЕсли;
		
		Если ПараметрыПечати.ИмяМакета = "ПФ_MXL_СМ_КЗ_ЛС_2_Рес" Тогда
			НаименованиеПозиции = СформироватьНаименованиеПозиции(ПозицияСметы,ПараметрыПечати);
			
			//Если ПараметрыПечати.РасшифроватьСостав Тогда
			//	НаименованиеПозиции = НаименованиеПозиции + ?(ПустаяСтрока(СоставРабот),"",Символы.ПС + СоставРабот);
			//КонецЕсли;
			
			СтрокаПозиция.Параметры.НаименованиеПозиции = НаименованиеПозиции;
		Иначе
			
			СтрокаПозиция.Параметры.НаименованиеПозиции = СформироватьНаименованиеПозиции(ПозицияСметы,ПараметрыПечати);
			//Если ПараметрыПечати.РасшифроватьСостав Тогда
			//	 СтрокаПозиция.Параметры.СоставРабот = СоставРабот;
			//КонецЕсли;
			
		КонецЕсли;
		
		СтрокаПозиция.Параметры.Измеритель          = Сокрлп(ПозицияСметы.Измеритель);						
		СтрокаПозиция.Параметры.Количество          = Сокрлп(ПозицияСметы.ОбъемРабот);			
		СтрокаПозиция.Параметры.НР                  = ПозицияСметы.НакладныеРасходыТекущие;
		
		Если ПараметрыПечати.ПечататьРасшифровку = Истина Тогда
			Стоимости = ПолучитьСтоимостиПозиции(ПозицияСметы,ПараметрыПечати,ложь,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками");
		Иначе
			Стоимости = ПолучитьСтоимостиПозиции(ПозицияСметы,ПараметрыПечати,ложь,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП");
		КонецЕсли;
		
		Если ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП Тогда
			ЕдиничныеСтоимости = ПолучитьЕдиничныеСтоимостиПозиции(ПозицияСметы,параметрыПечати,Ложь);
		Иначе
			ЕдиничныеСтоимости = ПолучитьЕдиничныеСтоимостиПозицииРесМет(ПозицияСметы,ПараметрыПечати,Ложь);
		КонецЕсли;	
		
		Если ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП
			Или ПараметрыПечати.ПечататьРасшифровку = Ложь Тогда
			ЗТР = ПолучитьЗТР(ПозицияСметы,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП",ПараметрыПечати);
		Иначе	
			ЗТР = ПолучитьЗТР(ПозицияСметы,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками",ПараметрыПечати);
		КонецЕсли;	
		
		СуммыНРиСП 	= ПолучитьСуммыНРиСППоПозиции(ПозицияСметы,ПараметрыПечати.СметаСсылка);

		Если ПараметрыПечати.ИмяМакета = "ПФ_MXL_СМ_КЗ_ЛС_2_Рес" Тогда
			
			СтрокаПозиция.Параметры.ЕдПЗ            = Формат(Окр(Стоимости.ТекСтоимПрямЗатраты,	КолЗнаков),СтрокаФормата);
			СтрокаПозиция.Параметры.ЕдЗП			= Формат(Окр(Стоимости.ТекСтоимОснЗарплата,	КолЗнаков),СтрокаФормата);
			СтрокаПозиция.Параметры.ЕдМашиныИМех	= Формат(Окр(Стоимости.ТекСтоимЭксплМашин,	КолЗнаков),СтрокаФормата);
			СтрокаПозиция.Параметры.ЕдЗрплМаш		= Формат(Окр(Стоимости.ТекСтоимЗарплМашин,	КолЗнаков),СтрокаФормата);
			СтрокаПозиция.Параметры.ЕдЗТР		    = Окр(ЗТР.ЗатратыТрудаРабочих,	2);
			СтрокаПозиция.Параметры.ЕдЗТМ		    = Окр(ЗТР.ЗатратыТрудаМашинистов,	2);
			
			СтрокаПозиция.Параметры.ПЗ			= Формат(Окр(Стоимости.ТекСтоимПрямЗатраты	* ПозицияСметы.ОбъемРабот,	КолЗнаков),СтрокаФормата);
			СтрокаПозиция.Параметры.ЗП			= Формат(Окр(Стоимости.ТекСтоимОснЗарплата	* ПозицияСметы.ОбъемРабот,	КолЗнаков),СтрокаФормата);
			СтрокаПозиция.Параметры.МашиныИМех	= Формат(Окр(Стоимости.ТекСтоимЭксплМашин	* ПозицияСметы.ОбъемРабот,	КолЗнаков),СтрокаФормата);
			СтрокаПозиция.Параметры.ЗрплМаш		= Формат(Окр(Стоимости.ТекСтоимЗарплМашин	* ПозицияСметы.ОбъемРабот,	КолЗнаков),СтрокаФормата);
			СтрокаПозиция.Параметры.ЗТР		    = Окр(ЗТР.ЗатратыТрудаРабочих	 * ПозицияСметы.ОбъемРабот,	2);
			СтрокаПозиция.Параметры.ЗТМ		    = Окр(ЗТР.ЗатратыТрудаМашинистов	 * ПозицияСметы.ОбъемРабот,	2);
			
			Если ПозицияСметы.Определитель.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
				СтрокаПозиция.Параметры.ЕдПЗ            = Формат(Окр(Стоимости.ТекСтоимОборуд,	КолЗнаков),СтрокаФормата);
				СтрокаПозиция.Параметры.ПЗ			= Формат(Окр(Стоимости.ТекСтоимОборуд	* ПозицияСметы.ОбъемРабот,	КолЗнаков),СтрокаФормата);
			КонецЕсли;
			
			Если СуммыНРиСП.Свойство("СуммаНРТекущаяЗТР") Тогда
				СтрокаПозиция.Параметры.НР1          = Формат(Окр(СуммыНРиСП.СуммаНРТекущаяЗТР,	КолЗнаков),СтрокаФормата);
			Иначе
				СтрокаПозиция.Параметры.НР1          = 0;
			КонецЕсли;
			
			
		Иначе
			Если ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП Тогда
				Если ПозицияСметы.Определитель.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
					
					СтрокаПозиция.Параметры.ЕдТек	            = Окр(ЕдиничныеСтоимости.ТекСтоимОборуд	,2);
					СтрокаПозиция.Параметры.ОбщТек	            = Формат(Окр(Стоимости.ТекСтоимОборуд	,КолЗнаков),СтрокаФормата);
				Иначе
					СтрокаПозиция.Параметры.ЕдТек	            = Окр(ЕдиничныеСтоимости.ТекСтоимПрямЗатраты	,2);
					СтрокаПозиция.Параметры.ОбщТек	            = Формат(Окр(Стоимости.ТекСтоимПрямЗатраты * ПозицияСметы.ОбъемРабот, КолЗнаков),СтрокаФормата);
				КонецЕсли;
			Иначе	
				
				СтоимостиРесурсов = ПолучитьСтоимостиРесурсовПозиции(ПозицияСметы,ПараметрыПечати.ОкруглятьДоРублей,истина);
				
				Если ПозицияСметы.Определитель.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
					СтрокаПозиция.Параметры.ЕдТек = Окр(ЕдиничныеСтоимости.ТекСтоимОборуд,2);
					СтрокаПозиция.Параметры.ОбщТек = Формат(Окр(Стоимости.ТекСтоимОборуд * ПозицияСметы.ОбъемРабот,КолЗнаков),СтрокаФормата);
				Иначе
					СтрокаПозиция.Параметры.ЕдТек = Окр(ЕдиничныеСтоимости.ТекСтоимПрямЗатраты	,2);
					СтрокаПозиция.Параметры.ОбщТек = Формат(Окр(Стоимости.ТекСтоимПрямЗатраты	* ПозицияСметы.ОбъемРабот,КолЗнаков),СтрокаФормата);
				КонецЕсли;
			КонецЕсли;
			
			Если СуммыНРиСП.Свойство("СуммаНРТекущаяЗТР") Тогда
				СтрокаПозиция.Параметры.НР1          = Формат(Окр(СуммыНРиСП.СуммаНРТекущаяЗТР,	КолЗнаков),СтрокаФормата);
			Иначе
				СтрокаПозиция.Параметры.НР1          = 0;
			КонецЕсли;

		КонецЕсли;
		ТабличныйДокумент.Вывести(СтрокаПозиция);
		
		Если ПараметрыПечати.РазвернутыйОтчет Тогда
			ВывестиРесурсыПозиции_КЗ(ПозицияСметы,ТабличныйДокумент,СтрокаПозиция,СтрокаРесурс,ИтогВидРесурса,ПараметрыПечати,Стоимости,ИтогНРиСП);
		КонецЕсли;
		
	КонецЕсли;

	
КонецПроцедуры	

// Процедура выводит итоги по главам печатаемого документа в ТабличныйДокумент.
//	Ссылка может принимать значение как документ "Акт выполненных работ", так и документ "Локальная смета".
//
Процедура ВывестиИтогиПоГлавам_КЗ(ТабличныйДокумент,Ссылка,ИтогГлава,ПараметрыПечати)
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	СтрокаФормата = ?(КолЗнаков = 0, "ЧДЦ=0","ЧДЦ=2");
	
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ИтогиПоГлавам.Итог,
	|	СУММА(ИтогиПоГлавам.ТекПрямЗатраты) КАК ТекПрямЗатраты,
	|	СУММА(ИтогиПоГлавам.ТекОснЗарплата) КАК ТекОснЗарплата,
	|	СУММА(ИтогиПоГлавам.ТекЭксплМашин) КАК ТекЭксплМашин,
	|	СУММА(ИтогиПоГлавам.ТекЗарплМашин) КАК ТекЗарплМашин,
	|	СУММА(ИтогиПоГлавам.ТекСтоимМатер) КАК ТекСтоимМатер,
	|	СУММА(ИтогиПоГлавам.ТекОборуд) КАК ТекОборуд,
	|	СУММА(ИтогиПоГлавам.ТекВозвратМатер) КАК ТекВозвратМатер,
	|	СУММА(ИтогиПоГлавам.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
	|	СУММА(ИтогиПоГлавам.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
	|	СУММА(ИтогиПоГлавам.Оборуд) КАК Оборуд,
	|	СУММА(ИтогиПоГлавам.ПрямЗатраты) КАК ПрямЗатраты,
	|	СУММА(ИтогиПоГлавам.ОснЗарплата) КАК ОснЗарплата,
	|	СУММА(ИтогиПоГлавам.ЭксплМашин) КАК ЭксплМашин,
	|	СУММА(ИтогиПоГлавам.ЗарплМашин) КАК ЗарплМашин,
	|	СУММА(ИтогиПоГлавам.СтоимМатер) КАК СтоимМатер,
	|	СУММА(ИтогиПоГлавам.ВозвратМатер) КАК ВозвратМатер
	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоГлавам КАК ИтогиПоГлавам
	|ГДЕ
	|	ИтогиПоГлавам.Смета = &Смета
	|	И ВЫБОР
	|		КОГДА &ЕстьЛимЗатраты ТОГДА ИСТИНА
	|		ИНАЧЕ ИтогиПоГлавам.Итог = &ИтогПоСмете
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ИтогиПоГлавам.Итог
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИтогиПоГлавам.Итог.ГлаваССРС.ПорядковыйНомер";
	
	Если ПечатьАкта Тогда
		Запрос.УстановитьПараметр("Смета",ПараметрыПечати.АктСсылка);
	Иначе
		Запрос.УстановитьПараметр("Смета",Ссылка);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ИтогПоСмете",Справочники.СМ_ИтогиПоГлавам.НайтиПоКоду("21"));
	Запрос.УстановитьПараметр("ЕстьЛимЗатраты",?(Ссылка.ЛимитированныеЗатраты.Количество() > 0, Истина, Ложь));
	
	ТаблВыборка = Новый ТаблицаЗначений ;
	ТаблВыборка = Запрос.Выполнить().Выгрузить();
	ТаблВыборка.Колонки.Добавить("Напечатан",Новый  ОписаниеТипов("Булево"));
	ТаблВыборка.Колонки.Добавить("СортировкаИтогов",Новый  ОписаниеТипов("Число"));
	Для каждого СтрокаИтога Из  ТаблВыборка Цикл
		
		Если ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
			СтрокаИтога.СортировкаИтогов = 1000 + СтрокаИтога.Итог.НомерПоПорядку;
		Иначе
			СтрокаИтога.СортировкаИтогов = 2000 + СтрокаИтога.Итог.ПорядковыйНомер;
		КонецЕсли;	
		СтрокаИтога.Напечатан = Ложь;
		
	КонецЦикла;	
	ТаблВыборка.Сортировать("СортировкаИтогов");
	
	ПеременныеДляПовтора = ИнициализироватьПеременныеДляПовтораИтогов();
	
	Для Каждого СтрокаИтога Из  ТаблВыборка Цикл
		
		Если СтрокаИтога.ТекПрямЗатраты = 0 И СтрокаИтога.ТекОснЗарплата = 0 И  СтрокаИтога.ТекЭксплМашин = 0 И СтрокаИтога.ТекСтоимМатер = 0  И СтрокаИтога.ТекЗарплМашин = 0 И СтрокаИтога.ЗатратыТрудаРабочих = 0   И СтрокаИтога.ЗатратыТрудаМашин = 0 Тогда
			Продолжить;
		КонецЕсли;	
		Если ТипЗнч(СтрокаИтога.Итог) <> Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
			Если СтрокаИтога.Итог.ВыводитьНаПечать = Ложь Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;	
		
		Если ПропуститьСтрокуИзЗаПовтораИтога(ПеременныеДляПовтора,СтрокаИтога,ПараметрыПечати) = Истина Тогда
			Продолжить;
		КонецЕсли;	
		
		
		
		// Вытолкнуть Все Итоги "От" т.е. все перед ЛимЗатратой до итогов "К".
		Если ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
			ГлаваЛимЗатраты = СтрокаИтога.Итог.ГлаваССРС;
			ГлаваИтогаОТ 	= СтрокаИтога.Итог.ОтИтога.ГлаваССРС;
			ГлаваИтогаКЧему = СтрокаИтога.Итог.КИтогу.ГлаваССРС;
			НомерИтогаКЧему = СтрокаИтога.Итог.КИтогу.ПорядковыйНомер;
			ТекНомерСтроки 	= ТаблВыборка.Индекс(СтрокаИтога);
			ПечатьИтоговПеред_КЗ(ИтогГлава,ТабличныйДокумент,ТаблВыборка,ГлаваЛимЗатраты,ГлаваИтогаОТ,ГлаваИтогаКЧему,параметрыПечати,НомерИтогаКЧему);
			ТаблВыборка.Получить(ТекНомерСтроки);
			Если Ссылка.НеОкруглятьНДС Тогда
				Если СтрокаИтога.Итог.Идентификатор = "ЛЗ64" Тогда
					КолЗнаков = 2;
					СтрокаФормата = "ЧДЦ=2";
				КонецЕсли;
			КонецЕсли;
			
			Обоснование = СокрЛП(СтрокаИтога.Итог.Обоснование);
			Если СтрДлина(Обоснование) = 0 Тогда
				ИтогГлава.Параметры.НаименованиеИтога 	= СформироватьНаименованиеРаботПоЛимЗатрате(Ссылка,СтрокаИтога.Итог,ПараметрыПечати);
			Иначе
				ИтогГлава.Параметры.НаименованиеИтога 	= СокрЛП(СтрокаИтога.Итог.Обоснование) + "   " + СформироватьНаименованиеРаботПоЛимЗатрате(Ссылка,СтрокаИтога.Итог,ПараметрыПечати);
			КонецЕсли;
			ИтогГлава.Параметры.НаименованиеРабот   = "";
		Иначе	
			Если СтрокаИтога.Напечатан <> Истина  Тогда
				ИтогГлава.Параметры.НаименованиеИтога 	= СокрЛП(СтрокаИтога.Итог.Наименование);
				ИтогГлава.Параметры.НаименованиеРабот   = "";
				СтрокаИтога.Напечатан = Истина;
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		
		Если ПараметрыПечати.ВБазисномУровне Тогда
			ИтогГлава.Параметры.ОбщТек			= Формат(Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков),СтрокаФормата);
			ПеременныеДляПовтора.ПредОбщТек		= Окр(СтрокаИтога.ПрямЗатраты,КолЗнаков);
		Иначе
			ИтогГлава.Параметры.ОбщТек			= Формат(Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
			ПеременныеДляПовтора.ПредОбщТек		= Окр(СтрокаИтога.ТекПрямЗатраты,КолЗнаков);
		КонецЕсли;
			
		
		
		ПоследняяОбласть = ТабличныйДокумент.Вывести(ИтогГлава);
		
	КонецЦикла;	
	
	Если ПоследняяОбласть <> Неопределено И ПараметрыПечати.ПечататьСетку Тогда
		Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
		ПоследняяОбласть.Обвести(Линия, , Линия, Линия);
	КонецЕсли;
	
КонецПроцедуры	

// Процедура выводит итоги, предшествующие Лиммтированной затрате.
//
Процедура ПечатьИтоговПеред_КЗ(ИтогГлава,ТабличныйДокумент,ТаблВыборка,ГлаваЛимЗатраты,ГлаваИтогаОт,ГлаваИтогаКЧему,ПараметрыПечати,НомерИтогаКЧему)
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	СтрокаФормата = ?(КолЗнаков = 0, "ЧДЦ=0","ЧДЦ=2");
	
	ПеременныеДляПовтора = ИнициализироватьПеременныеДляПовтораИтогов();
	
	Для Каждого СтрТабл Из ТаблВыборка Цикл
		
		Если ПропуститьСтрокуИзЗаПовтораИтога(ПеременныеДляПовтора,СтрТабл,Параметрыпечати) = истина Тогда
			СтрТабл.Напечатан = Истина;
			Продолжить;
		КонецЕсли;	
		
		
		Если ТипЗнч(СтрТабл.Итог) <> тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
			Напечатать = Ложь;
			Если СтрТабл.Итог.ГлаваССРС.ПорядковыйНомер < ГлаваЛимЗатраты.ПорядковыйНомер Тогда
				Напечатать = Истина;
			ИначеЕсли СтрТабл.Итог.ГлаваССРС.ПорядковыйНомер = ГлаваЛимЗатраты.ПорядковыйНомер Тогда
				Если (СтрТабл.Итог.ГлаваССРС.ПорядковыйНомер < ГлаваИтогаОт.ПорядковыйНомер)
					И (СтрТабл.Итог.ГлаваССРС.ПорядковыйНомер < ГлаваИтогаКЧему.ПорядковыйНомер) Тогда
					Напечатать = Истина;
				КонецЕсли;
				Если СтрТабл.Итог.ПорядковыйНомер < НомерИтогаКЧему Тогда
					Напечатать = Истина;
				КонецЕсли;
			КонецЕсли;
			Если СтрТабл.Итог.ВыводитьНаПечать = Ложь Тогда
				СтрТабл.Напечатан = Истина;
				Продолжить;
			КонецЕсли;	
			
			
			Если Напечатать Тогда
				Если СтрТабл.Напечатан <> Истина Тогда
					
					ИтогГлава.Параметры.НаименованиеИтога 	= СокрЛП(СтрТабл.Итог.Наименование);
					ИтогГлава.Параметры.НаименованиеРабот   = "";
					СтрТабл.Напечатан 						= Истина;
					
					Если ПараметрыПечати.ВБазисномУровне Тогда
						ИтогГлава.Параметры.ОбщТек	 	= Формат(Окр(СтрТабл.ПрямЗатраты,КолЗнаков),СтрокаФормата);
						ПеременныеДляПовтора.ПредОбщТек	= Окр(СтрТабл.ПрямЗатраты,КолЗнаков);
					Иначе
						ИтогГлава.Параметры.ОбщТек	 	= Формат(Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
						ПеременныеДляПовтора.ПредОбщТек	= Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков);
					КонецЕсли;	
					
					ТабличныйДокумент.Вывести(ИтогГлава);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры	

Функция СформироватьСоставРабот(Позиция)
	СоставРабот = "";
	Если Позиция.СоставРабот.Количество() = 0 Тогда
		Возврат СоставРабот;
	КонецЕсли;
	
	СоставРабот = "  Состав работ:";
	
	Для Каждого стр Из Позиция.СоставРабот Цикл
		
		 СоставРабот = СоставРабот + Символы.ПС + стр.Номер + ". " + СокрЛП(стр.НаименованиеРаботы);
		
	КонецЦикла;
	
	
	Возврат СоставРабот;
КонецФункции

// Процедура выводит в ТабличныйДокумент ресурсы из позиции локальной сметы при печати ЛС с ресурсным методом счета.
//
Процедура ВывестиРесурсыПозиции_КЗ(ПозицияСметы,ТабличныйДокумент,СтрокаПозиция,СтрокаРесурс,ИтогВидРесурса,ПараметрыПечати,Стоимости,ИтогНРиСП)
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	
	КолЗнаков = 2;
	
	ТЗ = ПозицияСметы.РесурсыПозицииЛокальнойСметы.Выгрузить();
	
	// ++ AVV вывод замен ресурсов
	МассивЗамененных = Новый Массив;
	ТЗ.Колонки.Добавить("ЭтоЗамена");
	ТЗ.ЗаполнитьЗначения(Ложь,"ЭтоЗамена"); 
	// -- AVV
	
	СтарВидРесурса = "";
	ТекНаименование = "";
	Для Каждого СтрокаРесурса Из ТЗ Цикл
		Если СтрокаРесурса.ресурс.Пустая() = Истина Тогда
			Если СтрокаРесурса.ВидРесурса.Пустая() = Истина Тогда
				Если СтрокаРесурса.ТекущаяЗарплатаМашинистов + СтрокаРесурса.БазиснаяЗарплатаМашинистов  = 0 Тогда
					СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы;
				Иначе 
					СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
		
		// ++ AVV вывод замен ресурсов
		Если СтрокаРесурса.Заменен Тогда
			МассивЗамененных.Добавить(СтрокаРесурса.Ресурс);				
		КонецЕсли;
		// -- AVV
	КонецЦикла;	
	
	// ++ AVV вывод замен ресурсов
	МассивПозиций = Новый Массив;
	МассивПозиций.Добавить(ПозицияСметы);
	ТабЗамененныхРесурсов = СМ_СметаВызовСервера.ПолучитьЗамененныеРесурсы(МассивЗамененных,,МассивПозиций);
	Для Каждого ТекСтрокаЗамены Из ТабЗамененныхРесурсов Цикл
		НайденнаяСтрока = ТЗ.Найти(ТекСтрокаЗамены.НовыйРесурс,"Ресурс"); 		
		Если НайденнаяСтрока <> Неопределено Тогда
			ИндексСтроки 			= ТЗ.Индекс(НайденнаяСтрока);
			НоваяСтрокаТЗ 			= ТЗ.Вставить(ИндексСтроки); 	
			НоваяСтрокаТЗ.Ресурс 	= ТекСтрокаЗамены.ЗамененныйРесурс;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТЗ,ТекСтрокаЗамены);
			НоваяСтрокаТЗ.БазиснаяЗарплатаМашинистов	= ТекСтрокаЗамены.БазиснаяЗМ;
			НоваяСтрокаТЗ.ТекущаяЗарплатаМашинистов     = ТекСтрокаЗамены.ТекущаяЗМ;
			НоваяСтрокаТЗ.ВидРесурса					= ТекСтрокаЗамены.ЗамененныйРесурс.ВидРесурса;
			НоваяСтрокаТЗ.ЕдиницаИзмеренияРесурса		= ТекСтрокаЗамены.ЗамененныйРесурс.ЕдиницаИзмерения;
			НоваяСтрокаТЗ.НаименованиеРесурса			= "зам. " + ТекСтрокаЗамены.ЗамененныйРесурс.Наименование;
			НоваяСтрокаТЗ.СметныйКодРесурса				= ТекСтрокаЗамены.ЗамененныйРесурс.Код;
			НоваяСтрокаТЗ.СтатусРесурса					= НайденнаяСтрока.СтатусРесурса;
			НоваяСтрокаТЗ.ТипМатериала					= НайденнаяСтрока.ТипМатериала;
			НоваяСтрокаТЗ.ЭтоЗамена						= Истина;
		КонецЕсли;
	КонецЦикла;
	// -- AVV
	
	ТЗВидов = ПозицияСметы.РесурсыПозицииЛокальнойСметы.Выгрузить(,"ВидРесурса");
	ТЗВидов.Свернуть("ВидРесурса");
	Для Каждого СтрокаРесурса Из ТЗВидов Цикл
		Если СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда
			СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих;
		КонецЕсли;
	КонецЦикла;
	ТЗВидов.Свернуть("ВидРесурса");
	ТЗВидов.Колонки.Добавить("Порядок");
	
	Для Каждого Вид Из ТЗВидов Цикл
		Если Вид.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
			Вид.Порядок = 1;
		ИначеЕсли Вид.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
			Вид.Порядок = 2;
		ИначеЕсли Вид.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
			Вид.Порядок = 3;
		Иначе
			Вид.Порядок = 4;
		КонецЕсли;
	КонецЦикла;
	
	ТЗВидов.Сортировать("Порядок");
	
	ТЗ.Сортировать("СметныйКодРесурса,ВидРесурса");
	
	Для Каждого Вид Из ТЗВидов Цикл
		МассивРес = ТЗ.НайтиСтроки(Новый Структура("ВидРесурса",Вид.ВидРесурса));
		ИтогоОбщТек = 0;
		ИтогоЕдТек = 0;
		
		Если Вид.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
			МассивДоп = ТЗ.НайтиСтроки(Новый Структура("ВидРесурса",Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов));
			
			Для Каждого эл Из МассивДоп Цикл
				МассивРес.Добавить(эл);
			КонецЦикла;
			
		КонецЕсли;
		
		Для Каждого СтрокаРесурса Из МассивРес Цикл
			
			Если СтрокаРесурса.Удален = Истина Тогда
				Продолжить;
			КонецЕсли;	
			
			Если СтрокаРесурса.ТипМатериала <> Перечисления.СМ_ТипыМатериалов.Учтенный Тогда
				Продолжить;
			КонецЕсли;
			СтрокаРесурс.Параметры.ТекстМашин = "";
			СтрокаРесурс.Параметры.ЗМ	= "";
			СтрокаРесурс.Параметры.ОбщЗМ	= "";
			СтрокаРесурс.Параметры.ИзмерительМашин	= "";
			СтрокаРесурс.Параметры.МашТек	= "";
			СтрокаРесурс.Параметры.МашОбщ	= "";
			
			СтрокаРесурс.Параметры.КодРесурса		= СокрЛП(СтрокаРесурса.СметныйКодРесурса);
			Если СтрокаРесурса.ресурс.Пустая() = Истина Тогда
				ИмяРесурса = Сокрлп(СтрокаРесурса.НаименованиеРесурса);
				Измеритель = Сокрлп(СтрокаРесурса.ЕдиницаИзмеренияРесурса); 
				СтрокаРесурс.Параметры.Измеритель  = Измеритель;						
				КоличествоИСтоимостиРесурсаВПозиции = Новый Структура;
				КоличествоИСтоимостиРесурсаВПозиции.Вставить("Количество",			0);
				КоличествоИСтоимостиРесурсаВПозиции.Вставить("СтоимостьБазисная",	0);
				КоличествоИСтоимостиРесурсаВПозиции.Вставить("СтоимостьТекущая",	0);
				КоличествоИСтоимостиРесурсаВПозиции.Вставить("НормаРасхода",		0);
				КоличествоИСтоимостиРесурсаВПозиции.Вставить("СтоимостьТекущаяЗМ",	0);
				КоличествоИСтоимостиРесурсаВПозиции.Вставить("СтоимостьБазиснаяЗМ",	0);
				
				КоличествоИСтоимостиРесурсаВПозиции.НормаРасхода = СтрокаРесурса.НормаРасхода;
				КоличествоИСтоимостиРесурсаВПозиции.Количество = СтрокаРесурса.НормаРасхода * ?(СтрокаРесурса.КоэффициентКРасходуРесурсов = 0,1,СтрокаРесурса.КоэффициентКРасходуРесурсов);
				// Учет поправок.
				Количество = СтрокаРесурса.НормаРасхода * ?(СтрокаРесурса.КоэффициентКРасходуРесурсов = 0,1,СтрокаРесурса.КоэффициентКРасходуРесурсов);
				ТаблПоправок = ПозицияСметы.ПоправкиПозиции.Выгрузить();
				Для каждого СтрокаТаблПоправок Из ТаблПоправок Цикл
					Если СтрокаТаблПоправок.Применить Тогда
						Если СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда	
							Количество = Количество * ?(СтрокаТаблПоправок.КоэффТР = 0,1,СтрокаТаблПоправок.КоэффТР);	
						ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда	
							Количество = Количество * ?(СтрокаТаблПоправок.КоэффТМ = 0,1,СтрокаТаблПоправок.КоэффТМ);	
						ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда	
							Количество = Количество * ?(СтрокаТаблПоправок.КоэффСМ = 0,1,СтрокаТаблПоправок.КоэффСМ);	
						ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда	
							Количество = Количество * ?(СтрокаТаблПоправок.КоэффЭМ = 0,1,СтрокаТаблПоправок.КоэффЭМ);	
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				КоличествоИСтоимостиРесурсаВПозиции.Количество = Количество;
				КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазисная = СтрокаРесурса.БазиснаяЦена * КоличествоИСтоимостиРесурсаВПозиции.Количество ;
				КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущая = СтрокаРесурса.ТекущаяЦена * КоличествоИСтоимостиРесурсаВПозиции.Количество;
				
				КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазисная = СтрокаРесурса.БазиснаяЦена * КоличествоИСтоимостиРесурсаВПозиции.Количество ;
				КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущая = СтрокаРесурса.ТекущаяЦена * КоличествоИСтоимостиРесурсаВПозиции.Количество;
				КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущаяЗМ = СтрокаРесурса.ТекущаяЗарплатаМашинистов * КоличествоИСтоимостиРесурсаВПозиции.Количество;
				КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазиснаяЗМ = СтрокаРесурса.БазиснаяЗарплатаМашинистов * КоличествоИСтоимостиРесурсаВПозиции.Количество;
			Иначе	
				ИмяРесурса = Сокрлп(СтрокаРесурса.НаименованиеРесурса);
				КоличествоИСтоимостиРесурсаВПозиции = ПолучитьКоличествоИСтоимостьРесурсаВПозиции(ПозицияСметы,СтрокаРесурса.Ресурс,ПараметрыПечати);
				СтрокаРесурс.Параметры.Измеритель  = сокрлп(СтрокаРесурса.ЕдиницаИзмеренияРесурса);						
			КонецЕсли;
			
			СтрокаРесурс.Параметры.НаименованиеРесурса = ИмяРесурса;
			СтрокаРесурс.Параметры.КоличествоТек          = КоличествоИСтоимостиРесурсаВПозиции.Количество;	
			СтрокаРесурс.Параметры.КоличествоОбщ          = Окр(КоличествоИСтоимостиРесурсаВПозиции.Количество * ПозицияСметы.ОбъемРабот,6);	
			ОбщТек = Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущая * ПозицияСметы.ОбъемРабот,КолЗнаков);
			ЕдТек	= СтрокаРесурса.ТекущаяЦена;
			СтрокаРесурс.Параметры.ЕдТек	= ЕдТек;
			СтрокаРесурс.Параметры.ОбщТек	= ОбщТек;
			
			Если СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы И ПараметрыПечати.ИмяМакета = "ПФ_MXL_СМ_КЗ_ЛС_1_Рес" Тогда
				СтрокаРесурс.Параметры.ЗМ	= СтрокаРесурса.ТекущаяЗарплатаМашинистов;
				СтрокаРесурс.Параметры.ОбщЗМ	= Окр(СтрокаРесурса.ТекущаяЗарплатаМашинистов * СтрокаРесурса.НормаРасхода * ПозицияСметы.ОбъемРабот,КолЗнаков);
				
				Экипаж = ПолучитьЭкипаж(СтрокаРесурса.Ресурс);
				
				СтрокаРесурс.Параметры.ТекстМашин = "в т. ч. затраты труда машинистов, экипаж "+Экипаж+" чел.";
				СтрокаРесурс.Параметры.ИзмерительМашин	= "чел-ч";
				СтрокаРесурс.Параметры.МашТек	= Экипаж * СтрокаРесурса.НормаРасхода;
				СтрокаРесурс.Параметры.МашОбщ	= Экипаж * СтрокаРесурса.НормаРасхода * ПозицияСметы.ОбъемРабот;

			ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов И ПараметрыПечати.ИмяМакета = "ПФ_MXL_СМ_КЗ_ЛС_1_Рес" Тогда
				ЕдЗрплМаш		= Окр(Стоимости.ТекСтоимЗарплМашин/КоличествоИСтоимостиРесурсаВПозиции.Количество,	КолЗнаков);
				ЗрплМаш		= Окр(Стоимости.ТекСтоимЗарплМашин	* ПозицияСметы.ОбъемРабот,	КолЗнаков);
				СтрокаРесурс.Параметры.ЕдТек	= ЕдЗрплМаш;
				СтрокаРесурс.Параметры.ОбщТек	= ЗрплМаш;
				ЕдТек	= Окр(ЕдЗрплМаш,КолЗнаков);
				ОбщТек = Окр(ЗрплМаш,КолЗнаков);
			КонецЕсли;
			
			//Если ИмяРесурса = "Затраты труда машинистов" Тогда
			//	ЕдТек	= Окр(ОбщТек/(КоличествоИСтоимостиРесурсаВПозиции.Количество * ПозицияСметы.ОбъемРабот),КолЗнаков);
			//КонецЕсли;
			
			ИтогоОбщТек = ИтогоОбщТек + ОбщТек;
			ИтогоЕдТек = ИтогоЕдТек + ЕдТек;
			
			// ++ AVV вывод замен ресурсов
			ТекОбласть = СтрокаРесурс.Области[0];
			Если СтрокаРесурса.ЭтоЗамена Тогда
				ШрифтОбласти = Новый Шрифт(ТекОбласть.Шрифт,,,,Истина); 
			Иначе
				ШрифтОбласти = Новый Шрифт(ТекОбласть.Шрифт,,,,Ложь); 
			КонецЕсли;
			СтрокаРесурс.Области[0].Шрифт = ШрифтОбласти;
			// -- AVV
			
			ТабличныйДокумент.вывести(СтрокаРесурс);
		КонецЦикла;	
		
		Если Вид.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
			НаименованиеИтогаВид = "оплата труда";
		Иначе
			НаименованиеИтогаВид = НРег(Вид.ВидРесурса);
		КонецЕсли;
		
		ИтогВидРесурса.Параметры.НаименованиеИтога = "Итого " + НаименованиеИтогаВид;
		
		// Если Вид.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда
		//	ИтогВидРесурса.Параметры.ОбщТек = ПозицияСметы.ТекущаяЗарплМашинистов;
		// Иначе
		//	ИтогВидРесурса.Параметры.ОбщТек = ИтогоОбщТек;
		// КонецЕсли;
		
		Если Вид.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
			
			ИтогоОбщТек = Окр((Стоимости.ТекСтоимЗарплМашин+Стоимости.ТекСтоимОснЗарплата) * ПозицияСметы.ОбъемРабот,	КолЗнаков);
			ИтогоЕдТек = Окр(Стоимости.ТекСтоимЗарплМашин+Стоимости.ТекСтоимОснЗарплата,	КолЗнаков);
			
		ИначеЕсли Вид.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
			
			ИтогоОбщТек = Окр(Стоимости.ТекСтоимЭксплМашин * ПозицияСметы.ОбъемРабот,	КолЗнаков);
			ИтогоЕдТек = Окр(Стоимости.ТекСтоимЭксплМашин,	КолЗнаков);
			
		ИначеЕсли Вид.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
			
			ИтогоОбщТек = Окр(Стоимости.ТекСтоимСтоимМатер * ПозицияСметы.ОбъемРабот,	КолЗнаков);
			ИтогоЕдТек = Окр(Стоимости.ТекСтоимСтоимМатер,	КолЗнаков);
			
		КонецЕсли;
		
		ИтогВидРесурса.Параметры.ОбщТек = ИтогоОбщТек;
		ИтогВидРесурса.Параметры.ЕдТек = ИтогоЕдТек;
		ТабличныйДокумент.вывести(ИтогВидРесурса);
	КонецЦикла;
	
	// блок "Итого прямые затраты:" 
	
    ДанныеНРиСП = ПолучитьНРиСППоПозиции_КЗ(ПозицияСметы,ПозицияСметы.ИДСметы);
	БЕСПсПиЧП = ПолучитьСтоимостиПозиции(ПозицияСметы,ПараметрыПечати,Ложь,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП");
	
	ПЗ = Окр((БЕСПсПиЧП.ТекСтоимПрямЗатраты+БЕСПсПиЧП.ТекСтоимОборуд)*ПозицияСметы.ОбъемРабот,	КолЗнаков);
	НР1 = Окр(ДанныеНРиСП.НР1,КолЗнаков);
	НР2 = Окр(ДанныеНРиСП.НР2,КолЗнаков);//Окр(((БЕСПсПиЧП.ТекСтоимПрямЗатраты*ПозицияСметы.ОбъемРабот) + ДанныеНРиСП.НР1)*ПозицияСметы.ИДСметы.НР2_ВС/100,КолЗнаков);//Окр(ДанныеНРиСП.НР2,КолЗнаков);
	СП2 = Окр(ДанныеНРиСП.СП2,КолЗнаков);
	НР = НР1 + НР2;
	//СП = Окр((ПЗ+НР)*СП2/100,КолЗнаков);
	СП = СП2;
	
	ИтогНРиСП.Параметры.ПЗ = ПЗ;
	ИтогНРиСП.Параметры.НР1 = НР1;
	ИтогНРиСП.Параметры.НР2 = НР2;
	ИтогНРиСП.Параметры.НР = НР;
	ИтогНРиСП.Параметры.СП2 = СП;
	ИтогНРиСП.Параметры.ВсегоПЗ = ПЗ+НР+СП;
	
	ТабличныйДокумент.вывести(ИтогНРиСП);
	
	// блок "Итого прямые затраты:"
	
КонецПроцедуры	

Функция ПолучитьЭкипаж(Ресурс) 
	
	Экипаж = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_СметныеЦеныРесурсовСрезПоследних.ЗатратыТрудаМаш КАК Экипаж
	               |ИЗ
	               |	РегистрСведений.СМ_СметныеЦеныРесурсов.СрезПоследних(
	               |			,
	               |			Ресурс = &Ресурс
	               |				И ТипЦен = Значение(Перечисление.СМ_ТипыЦен.Текущая)) КАК СМ_СметныеЦеныРесурсовСрезПоследних";

	Запрос.УстановитьПараметр("Ресурс",Ресурс);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Экипаж = Окр(Выборка.Экипаж);
	КонецЕсли;
	
	Возврат Экипаж;
КонецФункции

// Выводим итоги по смете.
//
Процедура ВывестиИтогиПоСмете_КЗ(ТабличныйДокумент,Ссылка,ИтогСмета,ИтогоПрямыеЗатраты,ПараметрыПечати)
	
	ПоследняяОбласть = Неопределено;
	
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = Истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	СтрокаФормата = ?(КолЗнаков = 0, "ЧДЦ=0","ЧДЦ=2");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ИтогиПоСмете.ТекПрямЗатраты,
	|	ИтогиПоСмете.ТекОснЗарплата,
	|	ИтогиПоСмете.ТекЭксплМашин,
	|	ИтогиПоСмете.ТекЗарплМашин,
	|	ИтогиПоСмете.ТекСтоимМатер,
	|	ИтогиПоСмете.ТекОборуд,
	|	ИтогиПоСмете.ТекВозвратМатер,
	|	ИтогиПоСмете.Итог,
	|	ИтогиПоСмете.ЗатратыТрудаРабочих,
	|	ИтогиПоСмете.ЗатратыТрудаМашин,
	|	ИтогиПоСмете.Оборуд,
	|	ИтогиПоСмете.ПрямЗатраты,
	|	ИтогиПоСмете.ОснЗарплата,
	|	ИтогиПоСмете.ЭксплМашин,
	|	ИтогиПоСмете.ЗарплМашин,
	|	ИтогиПоСмете.СтоимМатер,
	|	ИтогиПоСмете.ВозвратМатер
	|ИЗ
	|	РегистрСведений.СМ_ИтогиПоСмете КАК ИтогиПоСмете
	|ГДЕ
	|	ИтогиПоСмете.Смета = &Смета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИтогиПоСмете.Итог.ПорядковыйНомер";
	
	Если ПечатьАкта Тогда
		Запрос.УстановитьПараметр("Смета",ПараметрыПечати.АктСсылка);
		Методика = ПараметрыПечати.АктСсылка.ЛокальнаяСмета.МетодикаРасчета;
	Иначе
		Запрос.УстановитьПараметр("Смета",ПараметрыПечати.СметаСсылка);
		Методика = ПараметрыПечати.СметаСсылка.МетодикаРасчета;
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если выборка.итог = Справочники.СМ_ИтогиПоСмете.ВсегоПоСмете Тогда
			Продолжить;
		КонецЕсли;
		
		Если выборка.ТекПрямЗатраты = 0
			И Выборка.ТекОснЗарплата = 0
			И Выборка.ТекЭксплМашин = 0
			И Выборка.ТекСтоимМатер = 0
			И Выборка.ТекЗарплМашин = 0
			И Выборка.ЗатратыТрудаРабочих = 0
			И Выборка.ЗатратыТрудаМашин = 0
			И Выборка.ТекОборуд = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПараметрыПечати.УровеньЗаданияИндексов = Перечисления.СМ_УровеньЗаданияИндексов.Расценка
			И (Выборка.Итог = Справочники.СМ_ИтогиПоСмете.ИндексыПоСметеКЭлементам ИЛИ выборка.Итог = Справочники.СМ_ИтогиПоСмете.НаклСИндексом
			ИЛИ выборка.итог = Справочники.СМ_ИтогиПоСмете.СметПрибыльСИндексом // ИЛИ выборка.итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндКОборуд
			ИЛИ выборка.итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндКСметСтоим ИЛИ выборка.итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндНаПрочРаботы 
			ИЛИ выборка.итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндСМР) Тогда
			Продолжить;
		КонецЕсли; 
		
		Если ПараметрыПечати.УровеньЗаданияИндексов = Перечисления.СМ_УровеньЗаданияИндексов.Смета
			И ПараметрыПечати.ВБазисномУровне Тогда
			Если (выборка.Итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндНаПрочРаботы  
				// ИЛИ Выборка.Итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндКОборуд
				ИЛИ выборка.итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндКСметСтоим 
				ИЛИ выборка.итог = Справочники.СМ_ИтогиПоСмете.ВсегоСИндСМР
				Или выборка.итог = Справочники.СМ_ИтогиПоСмете.НаклСИндексом 
				Или выборка.итог = Справочники.СМ_ИтогиПоСмете.СметПрибыльСИндексом
				Или выборка.итог = Справочники.СМ_ИтогиПоСмете.ВсегоПоСмете) Тогда
				Продолжить;
			КонецЕсли; 
		КонецЕсли; 
		
		Если ПараметрыПечати.УровеньЗаданияИндексов = Перечисления.СМ_УровеньЗаданияИндексов.Раздел И Выборка.Итог = Справочники.СМ_ИтогиПоСмете.ИндексыПоСметеКЭлементам Тогда
			Продолжить;
		КонецЕсли;	
		
		
		Если выборка.итог = Справочники.СМ_ИтогиПоСмете.НормативТрудоемк
			ИЛИ выборка.итог = Справочники.СМ_ИтогиПоСмете.СметнЗарплата Тогда
			Продолжить;
		КонецЕсли;
		
		Если Выборка.Итог = Справочники.СМ_ИтогиПоСмете.ИтогоПоСмете Тогда
			//ИтогоПрямыеЗатраты.Параметры.Значение		= Формат(Окр(Выборка.ТекПрямЗатраты+Выборка.ТекОборуд,КолЗнаков),СтрокаФормата);
			ИтогоПрямыеЗатраты.Параметры.Значение		= Формат(Окр(Выборка.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
			Если ПечатьАкта Тогда
				ИтогоПрямыеЗатраты.Параметры.ЗначениеЗТР    = Формат(Окр(Выборка.ЗатратыТрудаРабочих,КолЗнаков),СтрокаФормата);
			КонецЕсли;
			ТабличныйДокумент.вывести(ИтогоПрямыеЗатраты);
			
			ИтогСмета.Параметры.НаименованиеИтога = НСтр("ru='в том числе'");
			ИтогСмета.Параметры.Значение		= "";
			ТабличныйДокумент.вывести(ИтогСмета);

			ИтогСмета.Параметры.НаименованиеИтога = НСтр("ru='- зарплата рабочих-строителей'");
			ИтогСмета.Параметры.Значение		= Формат(Окр(Выборка.ТекОснЗарплата,КолЗнаков),СтрокаФормата);
			ТабличныйДокумент.вывести(ИтогСмета);
			
			ИтогСмета.Параметры.НаименованиеИтога = НСтр("ru='- затраты на эксплуатацию машин'");
			ИтогСмета.Параметры.Значение		= Формат(Окр(Выборка.ТекЭксплМашин,КолЗнаков),СтрокаФормата);
			ТабличныйДокумент.вывести(ИтогСмета);
			
			ИтогСмета.Параметры.НаименованиеИтога = НСтр("ru='- в т.ч. зарплата машинистов'");
			ИтогСмета.Параметры.Значение		= Формат(Окр(Выборка.ТекЗарплМашин,КолЗнаков),СтрокаФормата);
			ТабличныйДокумент.вывести(ИтогСмета);
			
			ИтогСмета.Параметры.НаименованиеИтога = НСтр("ru='- материалы, изделия и конструкции'");
			ИтогСмета.Параметры.Значение		= Формат(Окр(Выборка.ТекСтоимМатер,КолЗнаков),СтрокаФормата);
			ТабличныйДокумент.вывести(ИтогСмета);
			
			ИтогСмета.Параметры.НаименованиеИтога = НСтр("ru='- перевозка грузов'");
			ИтогСмета.Параметры.Значение		= Формат(Окр(0,КолЗнаков),СтрокаФормата);
			ТабличныйДокумент.вывести(ИтогСмета);

			ИтогСмета.Параметры.НаименованиеИтога = НСтр("ru='- инженерное оборудование поставки подрядчика'");
			ИтогСмета.Параметры.Значение		= Формат(Окр(Выборка.ТекОборуд,КолЗнаков),СтрокаФормата);
			ТабличныйДокумент.вывести(ИтогСмета);

			Продолжить;
		КонецЕсли;
		
		ИтогСмета.Параметры.НаименованиеИтога = ПолучитьНаименованиеИтога(Методика,Выборка.Итог);
		ИтогСмета.Параметры.Значение		= Формат(Окр(Выборка.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
		ПоследняяОбласть = ТабличныйДокумент.вывести(ИтогСмета);
	КонецЦикла;	
	
	Если ПоследняяОбласть <> Неопределено И ПараметрыПечати.ПечататьСетку Тогда
		Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
		ПоследняяОбласть.Обвести(Линия, , Линия, Линия);
	КонецЕсли;

КонецПроцедуры	

Функция ПолучитьНаименованиеИтога(Методика,Итог) Экспорт
	НаименованиеИтога = СокрЛП(Итог.Наименование);
	НаборЗаписей = РегистрыСведений.СМ_ИспользованиеИтоговПоСмете.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Методика.Установить(Методика);
	НаборЗаписей.Отбор.Итог.Установить(Итог);
	НаборЗаписей.Прочитать();
	
	ТЗ = НаборЗаписей.Выгрузить();
	Для Каждого стр Из ТЗ Цикл
		Если стр.Используется Тогда
			НаименованиеИтога = СокрЛП(стр.Представление);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НаименованиеИтога;
КонецФункции

// Процедура выводит в ТабличныйДокумент разделы документа "Локальная смета".
//
Процедура ВывестиРазделыПриложения(СметаАктСсылка, ТабличныйДокумент,ИдРодителя,СтрокаРаздела,СтрокаИтогРаздела,СтрокаПозиция,ПараметрыПечати, Сумма, НПП)
	
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	Текст = "ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА СМ_НумерацияПозицийЛокальныхСмет.Позиция <> ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	|			ТОГДА СМ_НумерацияПозицийЛокальныхСмет.Позиция
	|		ИНАЧЕ ВЫБОР
	|				КОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел <> ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка)
	|					ТОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел
	|				ИНАЧЕ СМ_НумерацияПозицийЛокальныхСмет.Смета
	|			КОНЕЦ
	|	КОНЕЦ КАК Документ,
	|	ВЫБОР
	|		КОГДА СМ_НумерацияПозицийЛокальныхСмет.Позиция <> ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	|			ТОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел
	|		ИНАЧЕ ВЫБОР
	|				КОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел <> ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка)
	|					ТОГДА СМ_НумерацияПозицийЛокальныхСмет.Смета
	|				ИНАЧЕ НЕОПРЕДЕЛЕНО
	|			КОНЕЦ
	|	КОНЕЦ КАК Родитель,
	|	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	|	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	|	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
	|ПОМЕСТИТЬ НомераРазделовСметы
	|ИЗ
	|	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	|ГДЕ
	|	#условие#
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РазделЛокальнойСметы.Ссылка КАК Ссылка,
	|	НомераРазделовСметы.НомерВДереве КАК ПорНомер,
	|	СУММА(ЕСТЬNULL(СМ_СредняяТекущаяСтоимостьПозиции.Стоимость, 0)) КАК Стоимость
	|ПОМЕСТИТЬ ИтоговаяТаблица
	|ИЗ
	|	Документ.СМ_РазделЛокальнойСметы КАК РазделЛокальнойСметы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СредняяТекущаяСтоимостьПозиции КАК СМ_СредняяТекущаяСтоимостьПозиции
	|		ПО (СМ_СредняяТекущаяСтоимостьПозиции.Раздел = РазделЛокальнойСметы.Ссылка)
	|			И (СМ_СредняяТекущаяСтоимостьПозиции.Смета = &Смета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ НомераРазделовСметы КАК НомераРазделовСметы
	|		ПО (НомераРазделовСметы.Документ = РазделЛокальнойСметы.Ссылка)
	|ГДЕ
	|	РазделЛокальнойСметы.ИДРодителя = &ИДРодителя
	|
	|СГРУППИРОВАТЬ ПО
	|	НомераРазделовСметы.НомерВДереве,
	|	РазделЛокальнойСметы.Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ПозицияЛокальнойСметы.Ссылка,
	|	НомераРазделовСметы.НомерВДереве,
	|	СУММА(ЕСТЬNULL(СМ_СредняяТекущаяСтоимостьПозиции.Стоимость, 0))
	|ИЗ
	|	НомераРазделовСметы КАК НомераРазделовСметы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СредняяТекущаяСтоимостьПозиции КАК СМ_СредняяТекущаяСтоимостьПозиции
	|			ПО (СМ_СредняяТекущаяСтоимостьПозиции.Позиция = ПозицияЛокальнойСметы.Ссылка)
	|				И (СМ_СредняяТекущаяСтоимостьПозиции.Смета = &Смета)
	|		ПО НомераРазделовСметы.Документ = ПозицияЛокальнойСметы.Ссылка
	|			И НомераРазделовСметы.Родитель = ПозицияЛокальнойСметы.ИДРодителя
	|ГДЕ
	|	ПозицияЛокальнойСметы.ИДРодителя = &ИДРодителя
	|
	|СГРУППИРОВАТЬ ПО
	|	ПозицияЛокальнойСметы.Ссылка,
	|	НомераРазделовСметы.НомерВДереве
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИтоговаяТаблица.Ссылка,
	|	ИтоговаяТаблица.ПорНомер КАК ПорНомер,
	|	ИтоговаяТаблица.Стоимость
	|ИЗ
	|	ИтоговаяТаблица КАК ИтоговаяТаблица
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорНомер";
	
	Если ТипЗнч(ИдРодителя) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		Текст = СтрЗаменить(Текст,"#условие#","СМ_НумерацияПозицийЛокальныхСмет.Смета = &ИДРодителя И СМ_НумерацияПозицийЛокальныхСмет.Позиция = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)");	
	ИначеЕсли ТипЗнч(СметаАктСсылка) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		Текст = СтрЗаменить(Текст,"#условие#","СМ_НумерацияПозицийЛокальныхСмет.Смета = &Смета ИЛИ СМ_НумерацияПозицийЛокальныхСмет.Смета = &СметаАкта");	
		// Текст = СтрЗаменить(Текст,"#условие#","(СМ_НумерацияПозицийЛокальныхСмет.Смета = &Смета ИЛИ СМ_НумерацияПозицийЛокальныхСмет.Смета = &СметаАкта) И СМ_НумерацияПозицийЛокальныхСмет.Раздел = &ИДРодителя");	
	Иначе
		Текст = СтрЗаменить(Текст,"#условие#","СМ_НумерацияПозицийЛокальныхСмет.Смета = &Смета");	
		// Текст = СтрЗаменить(Текст,"#условие#","СМ_НумерацияПозицийЛокальныхСмет.Смета = &Смета И СМ_НумерацияПозицийЛокальныхСмет.Раздел = &ИДРодителя");	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("ИДРодителя",ИдРодителя);
	Запрос.УстановитьПараметр("Смета",СметаАктСсылка);
	
	Если ТипЗнч(СметаАктСсылка) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		Запрос.УстановитьПараметр("СметаАкта",СметаАктСсылка.ЛокальнаяСмета);
	КонецЕсли;	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Ссылка.ПометкаУдаления = Истина ИЛИ Выборка.Ссылка.Расчет = Ложь Тогда
			Продолжить;
		КонецЕсли;	
		
		Если ТипЗнч(Выборка.Ссылка) = тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			
			Если ПараметрыПечати.ПечататьЗаголовкиРазделов Тогда
				
				СтрокаРаздела.Параметры.Раздел = Выборка.Ссылка;
				СтрокаРаздела.Параметры.НаименованиеРаздела = СокрЛП(выборка.ссылка.НаименованиеДляПечати);
				ТабличныйДокумент.Вывести(СтрокаРаздела);
				
			КонецЕсли;
			СуммаРаздела = 0;
			ВывестиРазделыПриложения(СметаАктСсылка, ТабличныйДокумент,Выборка.Ссылка,СтрокаРаздела,СтрокаИтогРаздела,СтрокаПозиция,ПараметрыПечати, СуммаРаздела, НПП);
			Сумма = Сумма + СуммаРаздела;
			
			Если ПараметрыПечати.ПечататьЗаголовкиРазделов И ПараметрыПечати.ПечататьИтогиПоРазделам <> Перечисления.СМ_ПечатьИтоговРаздела.НеПечатать Тогда
				СтрокаИтогРаздела.Параметры.Стоимость = СуммаРаздела;
				СтрокаИтогРаздела.Параметры.НаименованиеРаздела = СокрЛП(выборка.ссылка.НаименованиеДляПечати);
				ТабличныйДокумент.Вывести(СтрокаИтогРаздела);
			КонецЕсли;
			
		Иначе
			
			СтрокаПозиция.Параметры.Позиция = Выборка.Ссылка;
			Номера = СМ_СметаВызовСервера.ПолучитьНомерДокумента(Выборка.Ссылка, "СМ_ПозицияЛокальнойСметы");
			СтрокаПозиция.Параметры.ПорНомер = СокрЛП(Номера.ПорНомер);
			СтрокаПозиция.Параметры.НаименованиеПозиции = СокрЛП(Выборка.Ссылка.Наименование);
			СтрокаПозиция.Параметры.ЕдиницаИзмерения = СокрЛП(Выборка.Ссылка.ЕдиницаИзмерения);
			Если ПечатьАкта Тогда
				ОбъемРабот = ПолучитьОбъемПоПозицииАкта(ПараметрыПечати.АктСсылка, Выборка.Ссылка);
			Иначе
				ОбъемРабот = Выборка.Ссылка.ОбъемРабот;
			КонецЕсли;
			СтрокаПозиция.Параметры.ОбъемРабот = ОбъемРабот;
			СтрокаПозиция.Параметры.Цена = ?(ОбъемРабот = 0, 0, Выборка.Стоимость / ОбъемРабот);
			СтрокаПозиция.Параметры.Стоимость = Выборка.Стоимость;
			ТабличныйДокумент.Вывести(СтрокаПозиция);
			Сумма = Сумма + Выборка.Стоимость;	
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры	

// Выводим строку позиции для сметы с базино - индексным методом счета.
//
Процедура ВывестиСтрокуПозиции(ПозицияСметы,ТабличныйДокумент,СтрокаПозиция,ПараметрыПечати,СтрокаПозицияДоп,СтрокаПозицияДопФОТ,Смета)
	
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	
	Номера = СМ_СметаВызовСервера.ПолучитьНомерДокумента(ПозицияСметы.Ссылка, "СМ_ПозицияЛокальнойСметы");
	
	// Печать по акту.
	Если ПечатьАкта Тогда
		
		ФактОбъем 	= ПолучитьОбъемПоПозицииАкта(ПараметрыПечати.АктСсылка,ПозицияСметы);
		Если ФактОбъем = 0 Тогда
			Возврат;
		КонецЕсли;	
		ПараметрыПечати.НомерПоПорядкуАкт = ПараметрыПечати.НомерПоПорядкуАкт + 1;	
		
		СуммыНРиСП 	= ПолучитьСуммыНРиСППоПозиции(ПозицияСметы,ПараметрыПечати.АктСсылка);
		Если ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП Тогда
			Стоимости 	= ПолучитьСтоимостиПозиции(ПозицияСметы,ПараметрыПечати,Истина,,ФактОбъем);
		ИначеЕсли ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП = Ложь
			И ПараметрыПечати.ПечататьРасшифровку = Ложь  Тогда
			Стоимости 	= ПолучитьСтоимостиПозиции(ПозицияСметы,ПараметрыПечати,истина,,ФактОбъем);
		ИначеЕсли ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП = Ложь
			И ПараметрыПечати.ПечататьРасшифровку = Истина    Тогда
			Стоимости 	= ПолучитьСтоимостиПозиции(ПозицияСметы,ПараметрыПечати,истина,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками",ФактОбъем);
		КонецЕсли;	
		
		СтрокаПозиция.Параметры.ПорНомерАкт         = ПараметрыПечати.НомерПоПорядкуАкт;			
		СтрокаПозиция.Параметры.ПорНомер			= Номера.ПорНомер;
		СтрокаПозиция.Параметры.ШифрРасценки		= СформироватьПолеОбоснование(ПозицияСметы,ПараметрыПечати);
		СтрокаПозиция.Параметры.НаименованиеПозиции = СформироватьНаименованиеПозиции(ПозицияСметы,ПараметрыПечати);
		СтрокаПозиция.Параметры.Измеритель          = Сокрлп(ПозицияСметы.Измеритель);						
		СтрокаПозиция.Параметры.ОбъемРабот			= ФактОбъем;
		
		Если ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП Тогда
			
			ЕдиничныеСтоимости = ПолучитьЕдиничныеСтоимостиПозиции(ПозицияСметы,ПараметрыПечати,Ложь);
			Если ПозицияСметы.НеПрименятьИндексы = Ложь Тогда 
				Если ПозицияСметы.Определитель.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
					СтрокаПозиция.Параметры.ЕдВсего = ЕдиничныеСтоимости.СтоимОборуд;
				Иначе	
					СтрокаПозиция.Параметры.ЕдВсего = ЕдиничныеСтоимости.СтоимПрямЗатраты;
				КонецЕсли;
				
				Если НЕ ПараметрыПечати.ЭтоКС2 Тогда
					СтрокаПозиция.Параметры.ЕдОЗ            = ЕдиничныеСтоимости.СтоимОснЗарплата;
					СтрокаПозиция.Параметры.ЕдЭМ            = ЕдиничныеСтоимости.СтоимЭксплМашин;
					СтрокаПозиция.Параметры.ЕдЗМ            = ЕдиничныеСтоимости.СтоимЗарплМашин;
					СтрокаПозиция.Параметры.ЕдЗатрТрРаб		= ЕдиничныеСтоимости.ЗатратыТрудаРабочих;
					СтрокаПозиция.Параметры.ЕдЗатрТрМех		= ЕдиничныеСтоимости.ЗатратыТрудаМашин;
				КонецЕсли;
				
				Если ПараметрыПечати.Это14Граф ИЛИ ПараметрыПечати.ЭтоАктСНРиСП Тогда
					СтрокаПозиция.Параметры.ЕдМат = ЕдиничныеСтоимости.СтоимСтоимМатер;
				КонецЕсли;
			Иначе
				// Если Позиция не индексировать.
				
				Если ПозицияСметы.Определитель.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
					СтрокаПозиция.Параметры.ЕдВсего = ЕдиничныеСтоимости.ТекСтоимОборуд;
				Иначе	
					СтрокаПозиция.Параметры.ЕдВсего = ЕдиничныеСтоимости.ТекСтоимПрямЗатраты;
				КонецЕсли;
				
				Если НЕ ПараметрыПечати.ЭтоКС2 Тогда
					СтрокаПозиция.Параметры.ЕдОЗ            = ЕдиничныеСтоимости.ТекСтоимОснЗарплата;
					СтрокаПозиция.Параметры.ЕдЭМ            = ЕдиничныеСтоимости.ТекСтоимЭксплМашин;
					СтрокаПозиция.Параметры.ЕдЗМ            = ЕдиничныеСтоимости.ТекСтоимЗарплМашин;
					СтрокаПозиция.Параметры.ЕдЗатрТрРаб		= ЕдиничныеСтоимости.ЗатратыТрудаРабочих;
					СтрокаПозиция.Параметры.ЕдЗатрТрМех		= ЕдиничныеСтоимости.ЗатратыТрудаМашин;
				КонецЕсли;
				
				Если ПараметрыПечати.Это14Граф ИЛИ ПараметрыПечати.ЭтоАктСНРиСП Тогда
					СтрокаПозиция.Параметры.ЕдМат = ЕдиничныеСтоимости.ТекСтоимСтоимМатер;
				КонецЕсли;
				
			КонецЕсли;
		Иначе	                                        		
			// Печать текущей цены.
			Если ПозицияСметы.НеПрименятьИндексы = Истина Тогда
				СтруктураЦен = Новый Структура();
				СтруктураЦен.Вставить("ТекущаяЦена",0);
				СтруктураЦен.Вставить("ТекущаяЗарплатаМашинистов",0);		
				ПолучитьТекущуюЦенуПоПозицииАкта(ПараметрыПечати.АктСсылка,ПозицияСметы,СтруктураЦен);	
				
