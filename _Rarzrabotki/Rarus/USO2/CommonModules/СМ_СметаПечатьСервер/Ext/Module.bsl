						ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(СтрокаТабл.ТекСуммаНРНаОбъем+СтрокаТабл.ТекСуммаНР2НаОбъем,КолЗнаков),СтрокаФормата);
