						ИтогРаздела.Параметры.ОбщТек		= Формат(Окр(ВыборкаВид.ТекОснЗарплата,	КолЗнаков),СтрокаФормата);
					КонецЕсли;
					ТабличныйДокумент.Вывести(ИтогРаздела);	
					
				КонецЕсли;
				
				Если (ПараметрыПечати.ВБазисномУровне И (ВыборкаВид.ЭксплМашин<>0)) Или
					(Не ПараметрыПечати.ВБазисномУровне И (ВыборкаВид.ТекЭксплМашин<>0)) Тогда
				
					ИтогРаздела.Параметры.НаименованиеИтога = НСтр("ru='         зксплуатация машин и механизмов'");
					Если ПараметрыПечати.ВБазисномУровне Тогда
						ИтогРаздела.Параметры.ЕдТек					= "";
						ИтогРаздела.Параметры.ОбщТек		= Формат(Окр(ВыборкаВид.ЭксплМашин,	КолЗнаков),СтрокаФормата);
					Иначе
						ИтогРаздела.Параметры.ЕдТек					= "";
						ИтогРаздела.Параметры.ОбщТек		= Формат(Окр(ВыборкаВид.ТекЭксплМашин,	КолЗнаков),СтрокаФормата);
					КонецЕсли;
					ТабличныйДокумент.Вывести(ИтогРаздела);
					
				КонецЕсли;
				
				Если (ПараметрыПечати.ВБазисномУровне И (ВыборкаВид.ЗарплМашин<>0)) Или
					(Не ПараметрыПечати.ВБазисномУровне И (ВыборкаВид.ТекЗарплМашин<>0)) Тогда
				
					ИтогРаздела.Параметры.НаименованиеИтога = НСтр("ru='              в т.ч. зарплата машинистов'");
					Если ПараметрыПечати.ВБазисномУровне Тогда
						ИтогРаздела.Параметры.ЕдТек					= "";
						ИтогРаздела.Параметры.ОбщТек		= Формат(Окр(ВыборкаВид.ЗарплМашин,	КолЗнаков),СтрокаФормата);
					Иначе
						ИтогРаздела.Параметры.ЕдТек					= "";
						ИтогРаздела.Параметры.ОбщТек		= Формат(Окр(ВыборкаВид.ТекЗарплМашин,	КолЗнаков),СтрокаФормата);
					КонецЕсли;
					ТабличныйДокумент.Вывести(ИтогРаздела);
					
				КонецЕсли;
				
				Если Табл.Количество() > 0 Тогда
					
					СтрокаТабл = Табл[0];
					
					Если (ПараметрыПечати.ВБазисномУровне И (СтрокаТабл.СуммаНРНаОбъем+СтрокаТабл.СуммаНР2НаОбъем<>0)) Или
