				Иначе
					ИтогРаздела.Параметры.Измеритель = "чел-ч";
				КонецЕсли;
				
				
				Если ПараметрыПечати.ВБазисномУровне Тогда
					ИтогРаздела.Параметры.ЕдТек					= "";
					ИтогРаздела.Параметры.ОбщТек		= Формат(Окр(ВыборкаВид.ПрямЗатраты,	КолЗнаков),СтрокаФормата);
				Иначе
					ИтогРаздела.Параметры.ЕдТек					= "";
					ИтогРаздела.Параметры.ОбщТек		= Формат(Окр(ВыборкаВид.ТекПрямЗатраты,	КолЗнаков),СтрокаФормата);
				КонецЕсли;
				ТабличныйДокумент.Вывести(ИтогРаздела);
				
				Если (ПараметрыПечати.ВБазисномУровне И (ВыборкаВид.СтоимМатер<>0)) Или
					(Не ПараметрыПечати.ВБазисномУровне И (ВыборкаВид.ТекСтоимМатер<>0)) Тогда
				
					ИтогРаздела.Параметры.НаименованиеИтога = НСтр("ru='         материалы'");
					Если ПараметрыПечати.ВБазисномУровне Тогда
						ИтогРаздела.Параметры.ЕдТек					= "";
						ИтогРаздела.Параметры.ОбщТек		= Формат(Окр(ВыборкаВид.СтоимМатер,	КолЗнаков),СтрокаФормата);
					Иначе
						ИтогРаздела.Параметры.ЕдТек					= "";
						ИтогРаздела.Параметры.ОбщТек		= Формат(Окр(ВыборкаВид.ТекСтоимМатер,	КолЗнаков),СтрокаФормата);
					КонецЕсли;
					ТабличныйДокумент.Вывести(ИтогРаздела);
				
				КонецЕсли;
				
				Если (ПараметрыПечати.ВБазисномУровне И (ВыборкаВид.ОснЗарплата<>0)) Или
					(Не ПараметрыПечати.ВБазисномУровне И (ВыборкаВид.ТекОснЗарплата<>0)) Тогда
				
					ИтогРаздела.Параметры.НаименованиеИтога = НСтр("ru='         заработная плата'");
					Если ПараметрыПечати.ВБазисномУровне Тогда
