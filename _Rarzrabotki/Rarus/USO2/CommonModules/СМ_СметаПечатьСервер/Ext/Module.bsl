						КонецЕсли;
					ИначеЕсли СтарВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
						ТекНаименование = НСтр("ru='Машины и механизмы'");
						Подгруппа.Параметры.НаименованиеГруппы = ТекНаименование; 
						ТабличныйДокумент.Вывести(ПодГруппа);
					ИначеЕсли СтарВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
						ТекНаименование = НСтр("ru='Материалы'");
						Подгруппа.Параметры.НаименованиеГруппы = ТекНаименование; 
						ТабличныйДокумент.Вывести(ПодГруппа);
					КонецЕсли;	 
				КонецЕсли;
			КонецЕсли;
			
			СтрокаПозиция.Параметры.ПорНомер			= "";
			СтрокаПозиция.Параметры.ШифрРасценки		= СокрЛП(СтрокаРесурса.СметныйКодРесурса);
			Если СтрокаРесурса.ресурс.Пустая() = Истина Тогда
				ИмяРесурса = Сокрлп(СтрокаРесурса.НаименованиеРесурса);
				Измеритель = Сокрлп(СтрокаРесурса.ЕдиницаИзмеренияРесурса); 
				СтрокаПозиция.Параметры.Измеритель  = Измеритель;						
				КоличествоИСтоимостиРесурсаВПозиции = Новый Структура;
				КоличествоИСтоимостиРесурсаВПозиции.Вставить("Количество",			0);
				КоличествоИСтоимостиРесурсаВПозиции.Вставить("СтоимостьБазисная",	0);
				КоличествоИСтоимостиРесурсаВПозиции.Вставить("СтоимостьТекущая",	0);
				КоличествоИСтоимостиРесурсаВПозиции.Вставить("НормаРасхода",		0);
				КоличествоИСтоимостиРесурсаВПозиции.Вставить("СтоимостьТекущаяЗМ",	0);
				КоличествоИСтоимостиРесурсаВПозиции.Вставить("СтоимостьБазиснаяЗМ",	0);
				КоличествоИСтоимостиРесурсаВПозиции.НормаРасхода = СтрокаРесурса.НормаРасхода;
				КоличествоИСтоимостиРесурсаВПозиции.Количество = СтрокаРесурса.НормаРасхода * ?(СтрокаРесурса.КоэффициентКРасходуРесурсов = 0,1,СтрокаРесурса.КоэффициентКРасходуРесурсов);
				// Учет поправок.
				Количество = СтрокаРесурса.НормаРасхода * ?(СтрокаРесурса.КоэффициентКРасходуРесурсов = 0,1,СтрокаРесурса.КоэффициентКРасходуРесурсов);
				ТаблПоправок = ПозицияСметы.ПоправкиПозиции.Выгрузить();
				Для каждого СтрокаТаблПоправок Из ТаблПоправок Цикл
					Если СтрокаТаблПоправок.Применить Тогда
						Если СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда	
							Количество = Количество * ?(СтрокаТаблПоправок.КоэффТР = 0,1,СтрокаТаблПоправок.КоэффТР);	
						ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда	
							Количество = Количество * ?(СтрокаТаблПоправок.КоэффТМ = 0,1,СтрокаТаблПоправок.КоэффТМ);	
						ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда	
							Количество = Количество * ?(СтрокаТаблПоправок.КоэффСМ = 0,1,СтрокаТаблПоправок.КоэффСМ);	
						ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда	
							Количество = Количество * ?(СтрокаТаблПоправок.КоэффЭМ = 0,1,СтрокаТаблПоправок.КоэффЭМ);	
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				КоличествоИСтоимостиРесурсаВПозиции.Количество = Количество;
				КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазисная = СтрокаРесурса.БазиснаяЦена * КоличествоИСтоимостиРесурсаВПозиции.Количество ;
				КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущая = СтрокаРесурса.ТекущаяЦена * КоличествоИСтоимостиРесурсаВПозиции.Количество;
	
				КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазисная = СтрокаРесурса.БазиснаяЦена * КоличествоИСтоимостиРесурсаВПозиции.Количество ;
				КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущая = СтрокаРесурса.ТекущаяЦена * КоличествоИСтоимостиРесурсаВПозиции.Количество;
				КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущаяЗМ = СтрокаРесурса.ТекущаяЗарплатаМашинистов * КоличествоИСтоимостиРесурсаВПозиции.Количество;
				КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазиснаяЗМ = СтрокаРесурса.БазиснаяЗарплатаМашинистов * КоличествоИСтоимостиРесурсаВПозиции.Количество;
			Иначе	
				ИмяРесурса = Сокрлп(СтрокаРесурса.НаименованиеРесурса);
				КоличествоИСтоимостиРесурсаВПозиции = ПолучитьКоличествоИСтоимостьРесурсаВПозиции(ПозицияСметы,СтрокаРесурса.Ресурс,ПараметрыПечати);
				СтрокаПозиция.Параметры.Измеритель  = сокрлп(СтрокаРесурса.ЕдиницаИзмеренияРесурса);						
			КонецЕсли;
			
			Если СтрокаРесурса.НормаРасхода <> 0 И НЕ ПараметрыПечати.ЭтоРесурсная12Граф Тогда
				ИмяРесурса = ИмяРесурса + " (расх. на ед.="+Строка(СтрокаРесурса.НормаРасхода)+")";
			КонецЕсли;	
			
			Если СтрокаРесурса.КоэффициентКРасходуРесурсов <> 0 Тогда
				ИмяРесурса = ИмяРесурса + " [К="+Строка(СтрокаРесурса.КоэффициентКРасходуРесурсов)+"]";
			КонецЕсли;	

			СтрокаПозиция.Параметры.НаименованиеПозиции = ИмяРесурса;
			СтрокаПозиция.Параметры.Количество          = Окр(КоличествоИСтоимостиРесурсаВПозиции.Количество * ПозицияСметы.ОбъемРабот,6);	
			
			Если ПараметрыПечати.ЭтоРесурсная12Граф Тогда
				СтрокаПозиция.Параметры.Норма           = КоличествоИСтоимостиРесурсаВПозиции.НормаРасхода;
				Если ПараметрыПечати.ВБазисномУровне Тогда
					СтрокаПозиция.Параметры.Цена	        = СтрокаРесурса.БазиснаяЦена;
					СтрокаПозиция.Параметры.ЦенаМаш	        = СтрокаРесурса.БазиснаяЗарплатаМашинистов;
				Иначе
					СтрокаПозиция.Параметры.Цена	        = СтрокаРесурса.ТекущаяЦена;
					СтрокаПозиция.Параметры.ЦенаМаш	        = СтрокаРесурса.ТекущаяЗарплатаМашинистов;
				КонецЕсли;
				СтрокаПозиция.Параметры.ПрямыеЗатраты   = "";
				СтрокаПозиция.Параметры.ЗП				= "";
				СтрокаПозиция.Параметры.МашиныИМех		= "";
				СтрокаПозиция.Параметры.ЗрплМаш			= 0;
				СтрокаПозиция.Параметры.Метериалы		= 0;
				СтрокаПозиция.Параметры.ЗТР				= "";
				СтрокаПозиция.Параметры.Обслмех			= "";
				Если ПараметрыПечати.ВБазисномУровне Тогда
					Если СтрокаРесурса.ресурс.Пустая() = Истина Тогда
						Если СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
							СтрокаПозиция.Параметры.МашиныИМех	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазисная	* ПозицияСметы.ОбъемРабот,КолЗнаков);
							СтрокаПозиция.Параметры.ЗрплМаш	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазиснаяЗМ	* ПозицияСметы.ОбъемРабот,КолЗнаков);
						ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
							СтрокаПозиция.Параметры.ЗрплМаш = 0;
							СтрокаПозиция.Параметры.Метериалы	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазисная	* ПозицияСметы.ОбъемРабот,КолЗнаков);
						КонецЕсли;	
					Иначе	
						Если СтрокаРесурса.Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
							СтрокаПозиция.Параметры.ЗП	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазисная * ПозицияСметы.ОбъемРабот,КолЗнаков);
						ИначеЕсли СтрокаРесурса.Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
							СтрокаПозиция.Параметры.МашиныИМех	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазисная		* ПозицияСметы.ОбъемРабот,КолЗнаков);
							НеУчитывать40 = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","Группа40");	
							
							Если НеУчитывать40 = Истина И Лев(СтрокаРесурса.Ресурс.Код,2) = "40" Тогда
								СтрокаПозиция.Параметры.ЗрплМаш = 0;
							Иначе 
								СтрокаПозиция.Параметры.ЗрплМаш	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазиснаяЗМ	* ПозицияСметы.ОбъемРабот,КолЗнаков);
							КонецЕсли;
						ИначеЕсли СтрокаРесурса.Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
							СтрокаПозиция.Параметры.ЗрплМаш = 0;
							СтрокаПозиция.Параметры.Метериалы	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазисная		* ПозицияСметы.ОбъемРабот,КолЗнаков);
						КонецЕсли;	
					КонецЕсли;	
				Иначе
					Если СтрокаРесурса.ресурс.Пустая() = Истина Тогда
						Если СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда		
							СтрокаПозиция.Параметры.МашиныИМех	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущая * ПозицияСметы.ОбъемРабот,КолЗнаков);
							СтрокаПозиция.Параметры.ЗрплМаш	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущаяЗМ * ПозицияСметы.ОбъемРабот,КолЗнаков);
						ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
							СтрокаПозиция.Параметры.ЗрплМаш = 0;
							СтрокаПозиция.Параметры.Метериалы	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущая	* ПозицияСметы.ОбъемРабот,КолЗнаков);
						КонецЕсли;
					Иначе	
						Если СтрокаРесурса.Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
							СтрокаПозиция.Параметры.ЗП	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущая * ПозицияСметы.ОбъемРабот,КолЗнаков);
						ИначеЕсли СтрокаРесурса.Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
							СтрокаПозиция.Параметры.МашиныИМех	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущая		* ПозицияСметы.ОбъемРабот,КолЗнаков);
							НеУчитывать40 = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","Группа40");	
							Если СтрокаРесурса.ресурс <> Неопределено Тогда
								Если НеУчитывать40 = Истина И Лев(СтрокаРесурса.Ресурс.Код,2) = "40" Тогда
									СтрокаПозиция.Параметры.ЗрплМаш = 0;
								Иначе 
									СтрокаПозиция.Параметры.ЗрплМаш	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущаяЗМ	* ПозицияСметы.ОбъемРабот,КолЗнаков);
								КонецЕсли;
							Иначе
								СтрокаПозиция.Параметры.ЗрплМаш	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущаяЗМ	* ПозицияСметы.ОбъемРабот,КолЗнаков);
							КонецЕсли;	
						ИначеЕсли СтрокаРесурса.Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
							СтрокаПозиция.Параметры.ЗрплМаш = 0;
							СтрокаПозиция.Параметры.Метериалы	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущая		* ПозицияСметы.ОбъемРабот,КолЗнаков);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			Иначе	
				
				Если НЕ ПараметрыПечати.ЭтоРесурсная7Граф Тогда
					СтрокаПозиция.Параметры.ЕдБазис 	= СтрокаРесурса.БазиснаяЦена;
					СтрокаПозиция.Параметры.ЕдБазЗПМ 	= СтрокаРесурса.БазиснаяЗарплатаМашинистов;
					СтрокаПозиция.Параметры.ОбщБазис	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазисная	* ПозицияСметы.ОбъемРабот,КолЗнаков);
					СтрокаПозиция.Параметры.ОбщБазЗПМ	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазиснаяЗМ	* ПозицияСметы.ОбъемРабот,КолЗнаков);
				КонецЕсли;	
				
				Если НЕ ПараметрыПечати.ЭтоРесурсная7Граф Или ПараметрыПечати.ВБазисномУровне = Ложь Тогда
					СтрокаПозиция.Параметры.ЕдТек	= СтрокаРесурса.ТекущаяЦена;
					СтрокаПозиция.Параметры.ЕдЗПМ	= СтрокаРесурса.ТекущаяЗарплатаМашинистов;
					СтрокаПозиция.Параметры.ОбщТек	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущая * ПозицияСметы.ОбъемРабот,КолЗнаков);
					СтрокаПозиция.Параметры.ОбщЗПМ	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьТекущаяЗМ * ПозицияСметы.ОбъемРабот,КолЗнаков);
				Иначе
					СтрокаПозиция.Параметры.ЕдТек	= СтрокаРесурса.БазиснаяЦена;
					СтрокаПозиция.Параметры.ЕдЗПМ	= СтрокаРесурса.БазиснаяЗарплатаМашинистов;
					СтрокаПозиция.Параметры.ОбщТек	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазисная * ПозицияСметы.ОбъемРабот,КолЗнаков);
					СтрокаПозиция.Параметры.ОбщЗПМ	= Окр(КоличествоИСтоимостиРесурсаВПозиции.СтоимостьБазиснаяЗМ * ПозицияСметы.ОбъемРабот,КолЗнаков);
				КонецЕсли;
			КонецЕсли;
			
			// ++ AVV вывод замен ресурсов
			ТекОбласть = СтрокаПозиция.Области[0];
			Если СтрокаРесурса.ЭтоЗамена Тогда
				ШрифтОбласти = Новый Шрифт(ТекОбласть.Шрифт,,,,Истина); 
			Иначе
				ШрифтОбласти = Новый Шрифт(ТекОбласть.Шрифт,,,,Ложь); 
			КонецЕсли;
			СтрокаПозиция.Области[0].Шрифт = ШрифтОбласти;
			// -- AVV
			
			ТабличныйДокумент.Вывести(СтрокаПозиция);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры	

// Процедура выводит в ТабличныйДокумент разделы документа "Локальная смета".
//
Процедура ВывестиРазделы(ТабличныйДокумент,ИдРодителя,СтрокаРаздела,ИтогРаздела,СтрокаПозиция,ИтогПозиция,ПараметрыПечати,СтрокаПозицияДоп,ИтогоПоРасценке,СтрокаПозицияДопФОТ,ПодГруппа,НомерРаздела)
	
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	Текст = "
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА СМ_НумерацияПозицийЛокальныхСмет.Позиция <> ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	|			ТОГДА СМ_НумерацияПозицийЛокальныхСмет.Позиция
	|		ИНАЧЕ ВЫБОР
	|				КОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел <> ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка)
	|					ТОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел
	|				ИНАЧЕ СМ_НумерацияПозицийЛокальныхСмет.Смета
	|			КОНЕЦ
	|	КОНЕЦ КАК Документ,
	|	ВЫБОР
	|		КОГДА СМ_НумерацияПозицийЛокальныхСмет.Позиция <> ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	|			ТОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел
	|		ИНАЧЕ ВЫБОР
	|				КОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел <> ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка)
	|					ТОГДА СМ_НумерацияПозицийЛокальныхСмет.Смета
	|				ИНАЧЕ НЕОПРЕДЕЛЕНО
	|			КОНЕЦ
	|	КОНЕЦ КАК Родитель,
	|	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	|	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	|	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
	|ПОМЕСТИТЬ НомераРазделовСметы
	|ИЗ
	|	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	|ГДЕ
	|	#условие#
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РазделЛокальнойСметы.Ссылка КАК Ссылка,
	|	НомераРазделовСметы.НомерВДереве КАК ПорНомер,
	|	СУММА(ЕСТЬNULL(СМ_СредняяТекущаяСтоимостьПозиции.Стоимость, 0)) КАК Стоимость
	|ПОМЕСТИТЬ ИтоговаяТаблица
	|ИЗ
	|	Документ.СМ_РазделЛокальнойСметы КАК РазделЛокальнойСметы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СредняяТекущаяСтоимостьПозиции КАК СМ_СредняяТекущаяСтоимостьПозиции
	|		ПО (СМ_СредняяТекущаяСтоимостьПозиции.Раздел = РазделЛокальнойСметы.Ссылка)
	// |			И (СМ_СредняяТекущаяСтоимостьПозиции.Смета = &Смета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ НомераРазделовСметы КАК НомераРазделовСметы
	|		ПО (НомераРазделовСметы.Документ = РазделЛокальнойСметы.Ссылка)
	|ГДЕ
	|	РазделЛокальнойСметы.ИДРодителя = &ИДРодителя
	|
	|СГРУППИРОВАТЬ ПО
	|	НомераРазделовСметы.НомерВДереве,
	|	РазделЛокальнойСметы.Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ПозицияЛокальнойСметы.Ссылка,
	|	НомераРазделовСметы.НомерВДереве,
	|	СУММА(ЕСТЬNULL(СМ_СредняяТекущаяСтоимостьПозиции.Стоимость, 0))
	|ИЗ
	|	НомераРазделовСметы КАК НомераРазделовСметы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СредняяТекущаяСтоимостьПозиции КАК СМ_СредняяТекущаяСтоимостьПозиции
	|			ПО (СМ_СредняяТекущаяСтоимостьПозиции.Позиция = ПозицияЛокальнойСметы.Ссылка)
	//  |				И (СМ_СредняяТекущаяСтоимостьПозиции.Смета = &Смета)
	|		ПО НомераРазделовСметы.Документ = ПозицияЛокальнойСметы.Ссылка
	|			И НомераРазделовСметы.Родитель = ПозицияЛокальнойСметы.ИДРодителя
	|ГДЕ
	|	ПозицияЛокальнойСметы.ИДРодителя = &ИДРодителя
	|
	|СГРУППИРОВАТЬ ПО
	|	ПозицияЛокальнойСметы.Ссылка,
	|	НомераРазделовСметы.НомерВДереве
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИтоговаяТаблица.Ссылка,
	|	ИтоговаяТаблица.ПорНомер КАК ПорНомер,
	|	ИтоговаяТаблица.Стоимость
	|ИЗ
	|	ИтоговаяТаблица КАК ИтоговаяТаблица
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорНомер";
	
	Запрос = Новый Запрос;
	Если ТипЗнч(ИдРодителя) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		Текст = СтрЗаменить(Текст,"#условие#","СМ_НумерацияПозицийЛокальныхСмет.Смета = &ИДРодителя И СМ_НумерацияПозицийЛокальныхСмет.Позиция = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)");	
	Иначе
		// Текст = СтрЗаменить(Текст,"#условие#","СМ_НумерацияПозицийЛокальныхСмет.Раздел = &ИДРодителя");	
		Текст = СтрЗаменить(Текст,"#условие#","СМ_НумерацияПозицийЛокальныхСмет.Смета = &Смета");	
		Запрос.УстановитьПараметр("Смета",ИдРодителя.ИдСметы);
	КонецЕсли;

	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("ИДРодителя",ИдРодителя);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Ссылка.ПометкаУдаления = Истина ИЛИ Выборка.Ссылка.Расчет = Ложь Тогда
			Продолжить;
		КонецЕсли;	
		
		Если ТипЗнч(Выборка.Ссылка) = тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			
			Если ПараметрыПечати.ПечататьЗаголовкиРазделов Тогда
				ТекстПорНомера	= "";
				ТекРаздел = Выборка.Ссылка;
				Если ТипЗнч(ТекРаздел) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
					Если ТекРаздел.ИДРодителя = ТекРаздел.ИДСметы Тогда
						НомерРаздела = НомерРаздела + 1;
						ТекстПорНомера 	= Строка(НомерРаздела)+".";
						СтрокаРаздела.Параметры.НаименованиеРаздела = "Раздел "+ТекстПорНомера +" "+СокрЛП(выборка.ссылка.НаименованиеДляПечати);
					Иначе
						СтрокаРаздела.Параметры.НаименованиеРаздела = "Подраздел  " + СокрЛП(выборка.ссылка.НаименованиеДляПечати);
					КонецЕсли;
					Если ПечатьАкта Тогда
						Если ЕстьИтогиПоРазделу(ТекРаздел,ИдРодителя,ПараметрыПечати.АктСсылка) Тогда
							ТабличныйДокумент.Вывести(СтрокаРаздела);
						КонецЕсли;	
					Иначе	
						ТабличныйДокумент.Вывести(СтрокаРаздела);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			ВывестиРазделы(ТабличныйДокумент,Выборка.Ссылка,СтрокаРаздела,итогРаздела,СтрокаПозиция,ИтогПозиция,ПараметрыПечати,СтрокаПозицияДоп,ИтогоПоРасценке,СтрокаПозицияДопФОТ,ПодГруппа,НомерРаздела);
			
			Если ПараметрыПечати.ПечататьЗаголовкиРазделов И ПараметрыПечати.ПечататьИтогиПоРазделам <> Перечисления.СМ_ПечатьИтоговРаздела.НеПечатать Тогда
				Если ПараметрыПечати.ПечататьИтогиПоРазделам = Перечисления.СМ_ПечатьИтоговРаздела.ПечататьПервые И ТипЗнч(ИдРодителя) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
					Если ПечатьАкта Тогда
						Если ЕстьИтогиПоРазделу(Выборка.Ссылка,ИдРодителя,ПараметрыПечати.АктСсылка) Тогда
							ВывестиИтогиРаздела(ТабличныйДокумент,Выборка.Ссылка,ИтогРаздела,ПараметрыПечати, ИдРодителя);
						КонецЕсли;
					Иначе
						ВывестиИтогиРаздела(ТабличныйДокумент,Выборка.Ссылка,ИтогРаздела,ПараметрыПечати, ИдРодителя);
					КонецЕсли;
				ИначеЕсли ПараметрыПечати.ПечататьИтогиПоРазделам = Перечисления.СМ_ПечатьИтоговРаздела.ПечататьВсе Тогда
					Если ПечатьАкта Тогда
						Если ЕстьИтогиПоРазделу(Выборка.Ссылка,ИдРодителя,ПараметрыПечати.АктСсылка) Тогда
							ВывестиИтогиРаздела(ТабличныйДокумент,Выборка.Ссылка,ИтогРаздела,ПараметрыПечати,ИдРодителя);
						КонецЕсли;
					Иначе
						ВывестиИтогиРаздела(ТабличныйДокумент,Выборка.Ссылка,ИтогРаздела,ПараметрыПечати,ИдРодителя);
					КонецЕсли;
				КонецЕсли;		
			КонецЕсли;
			
		Иначе
			
			Если ПараметрыПечати.ЭтоМетодикаТСН9в Тогда

				// Вывод строки с в 2-х уровнях цен.
				ВывестиСтрокуПозиции2УровняЦен(Выборка.Ссылка,ТабличныйДокумент,СтрокаПозиция,ПараметрыПечати, Выборка.Ссылка.ИДСметы);
				
			Иначе	
				
				Если ПараметрыПечати.Это12Граф ИЛИ ПараметрыПечати.ЭтоМетодикаТСН11а ИЛИ ПараметрыПечати.ЭтоМетодикаТСН11б Тогда
					ВывестиСтрокуПозиции12Граф(Выборка.Ссылка,ТабличныйДокумент,СтрокаПозиция,ПараметрыПечати,СтрокаПозицияДоп,ИтогоПоРасценке,СтрокаПозицияДопФОТ, Выборка.Ссылка.ИДСметы);
				ИначеЕсли ПараметрыПечати.ЭтоРесурсная Тогда
					ВывестиСтрокуПозицииРесурснойСметы(Выборка.Ссылка, ТабличныйДокумент,СтрокаПозиция,ПараметрыПечати, Выборка.Ссылка.ИДСметы,ПодГруппа);
				Иначе	
					ВывестиСтрокуПозиции(Выборка.Ссылка,ТабличныйДокумент,СтрокаПозиция,ПараметрыПечати,СтрокаПозицияДоп,СтрокаПозицияДопФОТ, Выборка.Ссылка.ИДСметы);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры	

// Процедура выводит итоги, предшествующие Лиммтированной затрате.
//
Процедура ПечатьИтоговПеред(ИтогГлава,ТабличныйДокумент,ТаблВыборка,ГлаваЛимЗатраты,ГлаваИтогаОт,ГлаваИтогаКЧему,ПараметрыПечати,НомерИтогаКЧему)
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	СтрокаФормата = ?(КолЗнаков = 0, "ЧДЦ=0","ЧДЦ=2");
	
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	ПеременныеДляПовтора = ИнициализироватьПеременныеДляПовтораИтогов();
	
	Для Каждого СтрТабл Из ТаблВыборка Цикл
		
		Если ПропуститьСтрокуИзЗаПовтораИтога(ПеременныеДляПовтора,СтрТабл,Параметрыпечати) = истина Тогда
			СтрТабл.Напечатан = Истина;
			Продолжить;
		КонецЕсли;	
		
		
		Если ТипЗнч(СтрТабл.Итог) <> тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
			Напечатать = Ложь;
			Если СтрТабл.Итог.ГлаваССРС.ПорядковыйНомер < ГлаваЛимЗатраты.ПорядковыйНомер Тогда
				Напечатать = Истина;
			ИначеЕсли СтрТабл.Итог.ГлаваССРС.ПорядковыйНомер = ГлаваЛимЗатраты.ПорядковыйНомер Тогда
				Если (СтрТабл.Итог.ГлаваССРС.ПорядковыйНомер < ГлаваИтогаОт.ПорядковыйНомер)
					И (СтрТабл.Итог.ГлаваССРС.ПорядковыйНомер < ГлаваИтогаКЧему.ПорядковыйНомер) Тогда
					Напечатать = Истина;
				КонецЕсли;
				Если СтрТабл.Итог.ПорядковыйНомер < НомерИтогаКЧему Тогда
					Напечатать = Истина;
				КонецЕсли;
			КонецЕсли;
			Если СтрТабл.Итог.ВыводитьНаПечать = Ложь Тогда
				СтрТабл.Напечатан = Истина;
				Продолжить;
			КонецЕсли;	
			
			
			Если Напечатать Тогда
				Если СтрТабл.Напечатан <> Истина Тогда
					
					ИтогГлава.Параметры.НаименованиеИтога 	= СокрЛП(СтрТабл.Итог.Наименование);
					ИтогГлава.Параметры.НаименованиеРабот   = "";
					СтрТабл.Напечатан 						= Истина;
					
					// Вывод в акт выполненных работ.
					Если ПечатьАкта Тогда
						
						Если ПараметрыПечати.ЭтоРесурсная = истина Тогда
							Если ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
								
								ИтогГлава.Параметры.ИтогБазис = Формат(Окр(СтрТабл.ПрямЗатраты,   КолЗнаков),СтрокаФормата);	
								ИтогГлава.Параметры.Итог	 = Формат(Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
								ПеременныеДляПовтора.ПредИтог		= Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков);
								
								
							ИначеЕсли ПараметрыПечати.ЭтоКС2Рес Тогда
								ИтогГлава.Параметры.Итог			= Формат(Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
								ИтогГлава.Параметры.ЗаработнаяПлата	= Формат(Окр(СтрТабл.ТекОснЗарплата,КолЗнаков),СтрокаФормата);
								
								ПеременныеДляПовтора.ПредИтог				 = Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков);
								ПеременныеДляПовтора.ПредИтогЗаработнаяПлата = Окр(СтрТабл.ТекОснЗарплата,КолЗнаков);
							Иначе
								
								ИтогГлава.Параметры.ПрямыеЗатраты				= Формат(Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
								ИтогГлава.Параметры.ЗаработнаяПлата				= Формат(Окр(СтрТабл.ТекОснЗарплата,КолЗнаков),СтрокаФормата);
								ИтогГлава.Параметры.МашиныИМеханизмы			= Формат(Окр(СтрТабл.ТекЭксплМашин,	КолЗнаков),СтрокаФормата);
								ИтогГлава.Параметры.ЗарплатаМашинистов 			= Формат(Окр(СтрТабл.ТекЗарплМашин,	КолЗнаков),СтрокаФормата);
								ИтогГлава.Параметры.Материалы					= Формат(Окр(СтрТабл.ТекСтоимМатер,	КолЗнаков),СтрокаФормата);
								ИтогГлава.Параметры.ЗТР							= Окр(СтрТабл.ЗатратыТрудаРабочих,	2);
								ИтогГлава.Параметры.ЗТМ							= Окр(СтрТабл.ЗатратыТрудаМашин,	2);
								
								ПеременныеДляПовтора.ПредИтогПрямЗатраты		= Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков);
								ПеременныеДляПовтора.ПредИтогЗаработнаяПлата	= Окр(СтрТабл.ТекОснЗарплата,КолЗнаков);  	
								ПеременныеДляПовтора.ПредИтогМашиныИМех			= Окр(СтрТабл.ТекЭксплМашин,КолЗнаков);
								ПеременныеДляПовтора.ПредИтогЗрплМаш			= Окр(СтрТабл.ТекЗарплМашин,КолЗнаков); 
								ПеременныеДляПовтора.ПредИтогМетериалы			= Окр(СтрТабл.ТекСтоимМатер,КолЗнаков);
								ПеременныеДляПовтора.ПредИтогЗТР				= ИтогГлава.Параметры.ЗТР;
								ПеременныеДляПовтора.ПредИтогОбслмех			= ИтогГлава.Параметры.ЗТМ;
								
							КонецЕсли;	
						Иначе	
							
							ИтогГлава.Параметры.Итог 		= Формат(Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
							ПеременныеДляПовтора.ПредИтог 	= Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков);
							Если  ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
								ИтогГлава.Параметры.ИтогБазис= Формат(Окр(СтрТабл.ПрямЗатраты,КолЗнаков),СтрокаФормата);
							КонецЕсли;	
							Если  НЕ ПараметрыПечати.ЭтоКС2 И НЕ ПараметрыПечати.Это12Граф
								И НЕ ПараметрыПечати.ЭтоМетодикаТСН11а И НЕ ПараметрыПечати.ЭтоМетодикаТСН11б 
								И НЕ ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
								ИтогГлава.Параметры.ИтогОЗ				= Формат(Окр(СтрТабл.ТекОснЗарплата,КолЗнаков),СтрокаФормата);
								ИтогГлава.Параметры.ИтогЭМ				= Формат(Окр(СтрТабл.ТекЭксплМашин,	КолЗнаков),СтрокаФормата);
								ИтогГлава.Параметры.ИтогЭМ 				= Формат(Окр(СтрТабл.ТекЗарплМашин,	КолЗнаков),СтрокаФормата);
								ИтогГлава.Параметры.ИтогЗатрТрРаб		= Окр(СтрТабл.ЗатратыТрудаРабочих,	2);
								ИтогГлава.Параметры.ИтогЗатрТрМех		= Окр(СтрТабл.ЗатратыТрудаМашин,	2);
								
								ПеременныеДляПовтора.ПредИтогОЗ			= Окр(СтрТабл.ТекОснЗарплата,КолЗнаков);  	
