	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ
	|	СУММА(ЕСТЬNULL(РесурснаяСтоимостьПозиции.СтоимПрямЗатраты,0)) КАК СтоимПрямЗатраты,
