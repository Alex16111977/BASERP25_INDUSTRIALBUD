				КонецЕсли;
				
			Иначе
				
				КоэффициентыНаПечатьБазис = Строка(ПозицияСметы.СметнаяПрибыльБазисные);
			КонецЕсли;
			Если ПараметрыПечати.МетодикаТСН = Ложь Тогда		
				Если ПозицияСметы.ПоправочныйКоэффициентКСПБазисный <> 0 Тогда
					КоэффициентыНаПечатьБазис = КоэффициентыНаПечатьБазис + "*"+строка(ПозицияСметы.ПоправочныйКоэффициентКСПБазисный);
				КонецЕсли;	
				
				Если ПозицияСметы.КоэффициентКСПАЭСБазисный <> 0 Тогда
					КоэффициентыНаПечатьБазис = КоэффициентыНаПечатьБазис + "*"+строка(ПозицияСметы.КоэффициентКСПАЭСБазисный);
				КонецЕсли;	
				
				Если ПозицияСметы.КоэффициентКСПНаРемонтБазисный <> 0 Тогда
					КоэффициентыНаПечатьБазис = КоэффициентыНаПечатьБазис + "*"+строка(ПозицияСметы.КоэффициентКСПНаРемонтБазисный);
				КонецЕсли;
				
				Если ПозицияСметы.КоэффициентКСПУСНБазисный <> 0 Тогда
