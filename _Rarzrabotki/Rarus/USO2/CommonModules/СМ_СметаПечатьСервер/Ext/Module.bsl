									ИтогГлава.Параметры.ЗаработнаяПлата				= Формат(Окр(СтрТабл.ТекОснЗарплата,КолЗнаков),СтрокаФормата);
									ИтогГлава.Параметры.МашиныИМех					= Формат(Окр(СтрТабл.ТекЭксплМашин,	КолЗнаков),СтрокаФормата);
									ИтогГлава.Параметры.ЗрплМаш 					= Формат(Окр(СтрТабл.ТекЗарплМашин,	КолЗнаков),СтрокаФормата);
									ИтогГлава.Параметры.Метериалы					= Формат(Окр(СтрТабл.ТекСтоимМатер,	КолЗнаков),СтрокаФормата);
									ИтогГлава.Параметры.ЗТР							= Окр(СтрТабл.ЗатратыТрудаРабочих,	2);
									ИтогГлава.Параметры.ОбслМех						= Окр(СтрТабл.ЗатратыТрудаМашин,	2);
									
									ПеременныеДляПовтора.ПредИтог		= Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков);
								КонецЕсли;
							ИначеЕсли ПараметрыПечати.ЭтоРесурсная7Граф Тогда
								Если ПараметрыПечати.ВБазисномУровне Тогда
									ИтогГлава.Параметры.ОбщТек	 	= Формат(Окр(СтрТабл.ПрямЗатраты,КолЗнаков),СтрокаФормата);
									ПеременныеДляПовтора.ПредОбщТек	= Окр(СтрТабл.ПрямЗатраты,КолЗнаков);
								Иначе
									ИтогГлава.Параметры.ОбщТек	 	= Формат(Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
									ПеременныеДляПовтора.ПредОбщТек	= Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков);
								КонецЕсли;	
							КонецЕсли;	
							
						Иначе	
							Если ПараметрыПечати.ВБазисномУровне  Тогда
								ИтогГлава.Параметры.Итог				= Формат(Окр(СтрТабл.ПрямЗатраты,КолЗнаков),СтрокаФормата);
							Иначе
								ИтогГлава.Параметры.Итог				= Формат(Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
							КонецЕсли;
							Если ПараметрыПечати.ЭтоМетодикаТСН9в  Тогда
								ИтогГлава.Параметры.ИтогБазис = Формат(Окр(СтрТабл.ПрямЗатраты,   КолЗнаков),СтрокаФормата);	
								ИтогГлава.Параметры.Итог	 = Формат(Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков),СтрокаФормата);
								ПеременныеДляПовтора.ПредОбщБазис	= Окр(СтрТабл.ПрямЗатраты,   КолЗнаков);
								ПеременныеДляПовтора.ПредОбщТек		= Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков);
								ПеременныеДляПовтора.ПредИтог		= Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков);
							КонецЕсли;
							Если НЕ ПараметрыПечати.Это12Граф И НЕ ПараметрыПечати.ЭтоМетодикаТСН9в И НЕ ПараметрыПечати.ЭтоМетодикаТСН11а
								И НЕ ПараметрыПечати.ЭтоМетодикаТСН11б Тогда
								
								Если ПараметрыПечати.ВБазисномУровне Тогда
									ИтогГлава.Параметры.ИтогОЗ				= Формат(Окр(СтрТабл.ОснЗарплата,КолЗнаков),СтрокаФормата);
									ИтогГлава.Параметры.ИтогЭМ				= Формат(Окр(СтрТабл.ЭксплМашин,	КолЗнаков),СтрокаФормата);
									ИтогГлава.Параметры.ИтогЭМвтч 			= Формат(Окр(СтрТабл.ЗарплМашин,	КолЗнаков),СтрокаФормата);
									ИтогГлава.Параметры.ИтогЗатрТрРаб		= Окр(СтрТабл.ЗатратыТрудаРабочих,	2);
									ИтогГлава.Параметры.ИтогЗатрТрМех		= Окр(СтрТабл.ЗатратыТрудаМашин,	2);
									ПеременныеДляПовтора.ПредИтог			= Окр(СтрТабл.ПрямЗатраты,КолЗнаков);  	
								Иначе
									ИтогГлава.Параметры.ИтогОЗ				= Формат(Окр(СтрТабл.ТекОснЗарплата,КолЗнаков),СтрокаФормата);
									ИтогГлава.Параметры.ИтогЭМ				= Формат(Окр(СтрТабл.ТекЭксплМашин,	КолЗнаков),СтрокаФормата);
									ИтогГлава.Параметры.ИтогЭМвтч 			= Формат(Окр(СтрТабл.ТекЗарплМашин,	КолЗнаков),СтрокаФормата);
									ИтогГлава.Параметры.ИтогЗатрТрРаб		= Окр(СтрТабл.ЗатратыТрудаРабочих,	2);
									ИтогГлава.Параметры.ИтогЗатрТрМех		= Окр(СтрТабл.ЗатратыТрудаМашин,	2);
									ПеременныеДляПовтора.ПредИтог			= Окр(СтрТабл.ТекПрямЗатраты,КолЗнаков);  	
								КонецЕсли;	
							КонецЕсли;	
							Если НЕ ПараметрыПечати.Это11Граф И НЕ ПараметрыПечати.Это11ГрафСНРиСП
								И НЕ ПараметрыПечати.Это12Граф И НЕ ПараметрыПечати.ЭтоМетодикаТСН9в И НЕ ПараметрыПечати.ЭтоМетодикаТСН11а
								И НЕ ПараметрыПечати.ЭтоМетодикаТСН11б  Тогда
								Если ПараметрыПечати.ВБазисномУровне Тогда
									ИтогГлава.Параметры.ИтогМат			= Формат(Окр(СтрТабл.СтоимМатер,	КолЗнаков),СтрокаФормата);
								Иначе
									ИтогГлава.Параметры.ИтогМат			= Формат(Окр(СтрТабл.ТекСтоимМатер,	КолЗнаков),СтрокаФормата);
								КонецЕсли;	
							КонецЕсли;	
						КонецЕсли;
					КонецЕсли;	
					
					ТабличныйДокумент.Вывести(ИтогГлава);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры	

// Выводим итоги разделов.
//
Процедура ВывестиИтогиРаздела(ТабличныйДокумент,Раздел,ИтогРаздела,ПараметрыПечати,РодительРаздел)
	
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	Если ПараметрыПечати.ЭтоРесурсная = истина Тогда
		ВывестиИтогиРазделаПоРесурсномуМетоду(ТабличныйДокумент,Раздел,ИтогРаздела,ПараметрыПечати,РодительРаздел);
		Возврат;
	КонецЕсли;	
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	СтрокаФормата = ?(КолЗнаков = 0, "ЧДЦ=0","ЧДЦ=2");
	
	// Получение итогов ЧП по разделу.
	Если ПараметрыПечати.ПечататьРасшифровку И НЕ ПараметрыПечати.Это12Граф
		И НЕ ПараметрыПечати.ЭтоМетодикаТСН11а И НЕ ПараметрыПечати.ЭтоМетодикаТСН11б 
		И НЕ ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
		
		ПеременныеДляПовтора = ИнициализироватьПеременныеДляПовтораЧП("СМ_ИтогиЧППоРазделу");
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ИтогиПоРазделу.Итог,
		               |	СУММА(ИтогиПоРазделу.ТекСтоимОснЗарплата) КАК ТекСтоимОснЗарплата,
		               |	СУММА(ИтогиПоРазделу.ТекСтоимЭксплМашин) КАК ТекСтоимЭксплМашин,
		               |	СУММА(ИтогиПоРазделу.ТекСтоимЗарплМашин) КАК ТекСтоимЗарплМашин,
		               |	СУММА(ИтогиПоРазделу.ТекСтоимСтоимМатер) КАК ТекСтоимСтоимМатер,
		               |	СУММА(ИтогиПоРазделу.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
		               |	СУММА(ИтогиПоРазделу.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
		               |	СУММА(ИтогиПоРазделу.ТекСтоимОборуд) КАК ТекСтоимОборуд,
		               |	СУММА(ИтогиПоРазделу.ТекСтоимПрямЗатраты) КАК ТекСтоимПрямЗатраты,
		               |	СУММА(ИтогиПоРазделу.СтоимОснЗарплата) КАК СтоимОснЗарплата,
		               |	СУММА(ИтогиПоРазделу.СтоимЭксплМашин) КАК СтоимЭксплМашин,
		               |	СУММА(ИтогиПоРазделу.СтоимЗарплМашин) КАК СтоимЗарплМашин,
		               |	СУММА(ИтогиПоРазделу.СтоимСтоимМатер) КАК СтоимСтоимМатер,
		               |	СУММА(ИтогиПоРазделу.СтоимОборуд) КАК СтоимОборуд,
		               |	СУММА(ИтогиПоРазделу.СтоимПрямЗатраты) КАК СтоимПрямЗатраты
		               |ИЗ
		               |	РегистрСведений.СМ_ИтогиЧППоРазделу КАК ИтогиПоРазделу
		               |ГДЕ
		               |	ИтогиПоРазделу.Раздел = &Раздел
		               |	И ИтогиПоРазделу.Раздел.ИДРодителя = &РодительРаздел
		               |	И ИтогиПоРазделу.Смета = &Смета
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ИтогиПоРазделу.Итог
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ИтогиПоРазделу.Итог.ПорядковыйНомер";
		
		
		Если ПечатьАкта Тогда
			Запрос.УстановитьПараметр("Смета",ПараметрыПечати.АктСсылка);
		Иначе
			Запрос.УстановитьПараметр("Смета",ПараметрыПечати.СметаСсылка);
		КонецЕсли;
		Запрос.УстановитьПараметр("РодительРаздел",РодительРаздел);
		Запрос.УстановитьПараметр("Раздел",Раздел);	
		Выборка = Запрос.Выполнить().Выбрать();
		
		// Печать акта выполненных работ. 
		Если ПечатьАкта Тогда
			
			Пока Выборка.Следующий() Цикл
				
				Если Выборка.ТекСтоимПрямЗатраты = 0 И Выборка.ТекСтоимОборуд = 0 И Выборка.ТекСтоимОснЗарплата = 0 И Выборка.ТекСтоимЭксплМашин = 0 И Выборка.ТекСтоимСтоимМатер = 0  И Выборка.ТекСтоимЗарплМашин = 0 И Выборка.ЗатратыТрудаРабочих = 0 И Выборка.ЗатратыТрудаМашин = 0 Тогда
					Продолжить;
				КонецЕсли;	
				
				Если ПропуститьСтрокуИзЗаПовтораИтога(ПеременныеДляПовтора,выборка,Параметрыпечати,"СМ_ИтогиЧППоРазделу") = истина Тогда
					Продолжить;
				КонецЕсли;	
				
				ИтогРаздела.Параметры.НаименованиеИтога = СокрЛП(Выборка.Итог.Наименование);
				ИтогРаздела.Параметры.Итог				= Окр(Выборка.ТекСтоимПрямЗатраты + Выборка.ТекСтоимОборуд,КолЗнаков);
				
				Если НЕ ПараметрыПечати.ЭтоКС2 Тогда
					ИтогРаздела.Параметры.ИтогОЗ			= Окр(Выборка.ТекСтоимОснЗарплата,КолЗнаков);
					ИтогРаздела.Параметры.ИтогЭМ			= Окр(Выборка.ТекСтоимЭксплМашин,КолЗнаков);
					ИтогРаздела.Параметры.ИтогЗатрТрРаб		= Окр(Выборка.ЗатратыТрудаРабочих,2);
					ИтогРаздела.Параметры.ИтогЗатрТрМех 	= Окр(Выборка.ЗатратыТрудаМашин,2);
				КонецЕсли;	
				
				Если ПараметрыПечати.Это14Граф ИЛИ ПараметрыПечати.ЭтоАктСНРиСП Тогда
					ИтогРаздела.Параметры.ИтогМат = Окр(Выборка.ТекСтоимСтоимМатер,КолЗнаков);
				КонецЕсли;
				
				Если Выборка.Итог.Накопительный Тогда
					
					ПеременныеДляПовтора.ТекСтоимПрямЗатраты = ИтогРаздела.Параметры.Итог;
					
					Если НЕ ПараметрыПечати.ЭтоКС2 Тогда
						ПеременныеДляПовтора.ТекСтоимОснЗарплата	= ИтогРаздела.Параметры.ИтогОЗ;	
						ПеременныеДляПовтора.ТекСтоимЭксплМашин     = ИтогРаздела.Параметры.ИтогЭМ;
						ПеременныеДляПовтора.ТекСтоимЗарплМашин 	= ИтогРаздела.Параметры.ИтогЭМ; 
						ПеременныеДляПовтора.ЗатратыТрудаРабочих 	= ИтогРаздела.Параметры.ИтогЗатрТрРаб;	
						ПеременныеДляПовтора.ЗатратыТрудаМашин 		= ИтогРаздела.Параметры.ИтогЗатрТрМех;
					КонецЕсли;
					
					Если ПараметрыПечати.Это14Граф ИЛИ ПараметрыПечати.ЭтоАктСНРиСП Тогда
						ПеременныеДляПовтора.ТекСтоимСтоимМатер	= ИтогРаздела.Параметры.ИтогМат;
					КонецЕсли;
				КонецЕсли;	
				
				Если Выборка.Итог.Расшифровка = Истина Тогда
					СтрокаРасшифровки = ПолучитьРасшифровкуЧП(Выборка.Итог,Раздел,ПараметрыПечати.АктСсылка);
					ИтогРаздела.Параметры.НаименованиеИтога = СтрокаРасшифровки;
				КонецЕсли;	
				Если Выборка.Итог.ВыводитьНаПечать = Истина Тогда
					ПоследняяОбласть = ТабличныйДокумент.Вывести(ИтогРаздела);
				КонецЕсли;
			КонецЦикла;
			
			// Печать локальной сметы.	
		Иначе	
			
			Пока Выборка.Следующий() Цикл
				Если ПараметрыПечати.ВБазисномУровне Тогда
