					КоэффициентыНаПечатьБазис =КоэффициентыНаПечатьБазис + "*"+строка(ПозицияСметы.КоэффициентКСПНаРемонтБазисный);
				КонецЕсли;
				
				Если ПозицияСметы.КоэффициентКСПУСНБазисный <> 0 Тогда
					КоэффициентыНаПечатьБазис =КоэффициентыНаПечатьБазис + "*"+строка(ПозицияСметы.КоэффициентКСПУСНБазисный);
				КонецЕсли;
				
			Иначе
				// Могут быть свои коэффициенты.
			КонецЕсли;
			Если СокрЛП(КоэффициентыНаПечатьБазис) = "0" Тогда
				КоэффициентыНаПечатьБазис = "";
			КонецЕсли;	
			СтрокаПозицияДопФОТ.Параметры.НаименованиеПозиции	= Наименование;
			СтрокаПозицияДопФОТ.Параметры.ОбъемРабот			= "";
			СтрокаПозицияДопФОТ.Параметры.Измеритель          	= "%";
			Если  НЕ ПараметрыПечати.ЭтоМетодикаТСН11а И НЕ ПараметрыПечати.ЭтоМетодикаТСН11б Тогда
				СтрокаПозицияДопФОТ.Параметры.ПопрКоэф            	= ПозицияСметы.ПоправочныйКоэффициентКСПБазисный;
				СтрокаПозицияДопФОТ.Параметры.СтоимБазис          	= Формат(Окр(СуммыНРиСП.СуммаСПБазисная,2),СтрокаФормата);
				СтрокаПозицияДопФОТ.параметры.ВидРабот 				= "";
				СтрокаПозицияДопФОТ.Параметры.ЕдСтоим             	= КоэффициентыНаПечатьБазис;
				Если ПараметрыПечати.ВБазисномУровне Тогда
					СтрокаПозицияДопФОТ.Параметры.СтоимТек          	= Формат(Окр(СуммыНРиСП.СуммаСПБазисная,2),СтрокаФормата);
					СтрокаПозицияДопФОТ.параметры.Коэфпересчета			= КоэффициентыНаПечатьБазис;
				Иначе
					СтрокаПозицияДопФОТ.параметры.Коэфпересчета 		= КоэффициентыНаПечать;
					СтрокаПозицияДопФОТ.Параметры.СтоимТек          	= Формат(Окр(СуммыНРиСП.СуммаСПТекущая,2),СтрокаФормата);
				КонецЕсли;	
			ИначеЕсли  ПараметрыПечати.ЭтоМетодикаТСН11а Тогда
				СтрокаПозицияДопФОТ.Параметры.ЕдСтоим             	= КоэффициентыНаПечать;
				СтрокаПозицияДопФОТ.Параметры.ПопрКоэф            	= "";
				СтрокаПозицияДопФОТ.Параметры.СтоимТек          	= Формат(Окр(СуммыНРиСП.СуммаСПТекущаяЗТР,2),СтрокаФормата);
				СтрокаПозиция.параметры.КоэффЗУ = "";
				СтрокаПозиция.Параметры.ЗТР	          		= "";
			ИначеЕсли  ПараметрыПечати.ЭтоМетодикаТСН11б Тогда
				СтрокаПозицияДопФОТ.Параметры.ПопрКоэф            	= КоэффициентыНаПечатьБазис;
				СтрокаПозицияДопФОТ.Параметры.СтоимБазис          	= Формат(Окр(СуммыНРиСП.СуммаСПБазиснаяЗТР,2),СтрокаФормата);
				СтрокаПозицияДопФОТ.Параметры.СтоимТек          	= Формат(Окр(СуммыНРиСП.СуммаСПТекущаяЗТР,2),СтрокаФормата);
				СтрокаПозицияДопФОТ.параметры.Коэфпересчета 		= КоэффициентыНаПечать;
				СтрокаПозиция.параметры.КоэффЗУ = "";
			КонецЕсли;
			ТабличныйДокумент.вывести(СтрокаПозицияДопФОТ);
		КонецЕсли;
		// Сметная Прибыль от ЗТМ (МетодикаТСН).	
		Если ПозицияСметы.Определитель.ВидРасценки <> Перечисления.СМ_ВидыРасценки.Материал
			И ПозицияСметы.Определитель.ВидРасценки <> Перечисления.СМ_ВидыРасценки.Оборудование Тогда
			
			Если ПараметрыПечати.ЭтоМетодикаТСН11а Или ПараметрыПечати.ЭтоМетодикаТСН11б Тогда
				НормативНРБазиснаяМашин = Константы.СМ_НРТСНБазис.Получить();
				НормативНРТекущаяМашин 	= Константы.СМ_НРТСНТекущие.Получить();
				НормативСПБазиснаяМашин	= Константы.СМ_СПТСНБазис.Получить();
				НормативСПТекущаяМашин 	= Константы.СМ_СПТСНТекущие.Получить();	
				Наименование =  НСтр("ru='НР и СП от ЗПМ'");
				КоэффициентыНаПечать = СокрЛП(Строка(НормативНРТекущаяМашин)) + " + " + СокрЛП(Строка(НормативСПТекущаяМашин));
				КоэффициентыНаПечатьБазис = СокрЛП(Строка(НормативНРБазиснаяМашин)) + " + " + СокрЛП(Строка(НормативСПБазиснаяМашин));
				СтрокаПозицияДопФОТ.Параметры.НаименованиеПозиции	= Наименование;
				СтрокаПозицияДопФОТ.Параметры.ОбъемРабот			= "";
				СтрокаПозицияДопФОТ.Параметры.Измеритель        	= "%";
				Если ПараметрыПечати.ЭтоМетодикаТСН11а  Тогда
					
					СтрокаПозицияДопФОТ.Параметры.ЗТР	          		= "";
					СтрокаПозицияДопФОТ.Параметры.ЕдСтоим             	= КоэффициентыНаПечать;
					СтрокаПозицияДопФОТ.Параметры.ПопрКоэф            	= "";
					СтрокаПозицияДопФОТ.Параметры.СтоимТек          	= Формат(Окр((СуммыНРиСП.СуммаСПТекущаяЗТМ + СуммыНРиСП.СуммаНРТекущаяЗТМ),2),СтрокаФормата);
				ИначеЕсли ПараметрыПечати.ЭтоМетодикаТСН11б  Тогда
					СтрокаПозицияДопФОТ.Параметры.ПопрКоэф            	= КоэффициентыНаПечатьБазис;
					СтрокаПозицияДопФОТ.параметры.Коэфпересчета 		= КоэффициентыНаПечать;
					СтрокаПозицияДопФОТ.Параметры.СтоимТек          	= Формат(Окр((СуммыНРиСП.СуммаСПТекущаяЗТМ + СуммыНРиСП.СуммаНРТекущаяЗТМ),2),СтрокаФормата);
					СтрокаПозицияДопФОТ.Параметры.СтоимБазис          	= Формат(Окр((СуммыНРиСП.СуммаСПБазиснаяЗТМ + СуммыНРиСП.СуммаНРБазиснаяЗТМ),2),СтрокаФормата);
					СтрокаПозицияДопФОТ.Параметры.ЕдСтоим	          		= "";
				КонецЕсли;
				ТабличныйДокумент.вывести(СтрокаПозицияДопФОТ);
				
				
			КонецЕсли;
		КонецЕсли;
		Если  ПозицияСметы.ЗатратыТрудаРабочих <> 0 Тогда
			СтрокаПозиция.Параметры.ПорНомер			= "";
			строкаПозиция.Параметры.ШифрРасценки		= "";
			Если ПараметрыПечати.ЭтоМетодикаТСН11а Или ПараметрыПечати.ЭтоМетодикаТСН11б Тогда
				строкаПозиция.Параметры.НаименованиеПозиции = "ЗТР";
			Иначе
				строкаПозиция.Параметры.НаименованиеПозиции = НСтр("ru='Затраты труда'");
			КонецЕсли;
			Если ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП = Истина  Тогда
				Если ПозицияСметы.ОбъемРабот <> 0 Тогда
					СтрокаПозиция.Параметры.ОбъемРабот = Окр(Стоимости.ОбщЗатрТрРаб / ПозицияСметы.ОбъемРабот,2)
				Иначе
					СтрокаПозиция.Параметры.ОбъемРабот = "";
				КонецЕсли;
			Иначе	
				СтрокаПозиция.Параметры.ОбъемРабот			= ПозицияСметы.ЗатратыТрудаРабочих;
			КонецЕсли;
			СтрокаПозиция.Параметры.Измеритель          = "чел./час";						
			СтрокаПозиция.Параметры.ЕдСтоим             = "";
			СтрокаПозиция.Параметры.ПопрКоэф            = ПосчитатьКоэффициенты("ПоправкиПозиции","КоэффТР",ПозицияСметы);
			
			Если  ПараметрыПечати.ЭтоМетодикаТСН11а Или ПараметрыПечати.ЭтоМетодикаТСН11б Тогда
				Если ПараметрыПечати.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
					КоэффЗУ = ПозицияСметы.ЗимнееУдорожРемонт;
				Иначе
					КоэффЗУ = ПозицияСметы.ЗимнееУдорож;
				КонецЕсли;
				
				Если ПараметрыПечати.СметаСсылка.ПрименитьЗУТрудРабочих Тогда
					СтрокаПозиция.параметры.КоэффЗУ = ?(КоэффЗУ = 0,"",КоэффЗУ);
				Иначе
					СтрокаПозиция.параметры.КоэффЗУ = "";
				КонецЕсли;	
			Иначе
				СтрокаПозиция.Параметры.СтоимБазис      = "";
				СтрокаПозиция.параметры.ВидРабот 		= "";
			КонецЕсли;
			СтрокаПозиция.параметры.Коэфпересчета 		= "";
			СтрокаПозиция.Параметры.СтоимТек          	= "";
			Если НЕ ПараметрыПечати.ЭтоМетодикаТСН11б Тогда
				СтрокаПозиция.Параметры.ЗТР	          	= Стоимости.ОбщЗатрТрРаб;
			КонецЕсли;
			
			
			ТабличныйДокумент.вывести(СтрокаПозиция);
		КонецЕсли;
		
		СтрокаПозиция.Параметры.ПорНомер			= "";
		строкаПозиция.Параметры.ШифрРасценки		= "";
		строкаПозиция.Параметры.НаименованиеПозиции = "";
		СтрокаПозиция.Параметры.ОбъемРабот			= "";
		СтрокаПозиция.Параметры.Измеритель          = "";						
		СтрокаПозиция.Параметры.ЕдСтоим             = "";
		СтрокаПозиция.Параметры.ПопрКоэф            = "";
		Если НЕ ПараметрыПечати.ЭтоМетодикаТСН11а И НЕ ПараметрыПечати.ЭтоМетодикаТСН11б Тогда
			
			СтрокаПозиция.Параметры.СтоимБазис          = "";
			СтрокаПозиция.параметры.ВидРабот 			= "";
		КонецЕсли;
		СтрокаПозиция.параметры.Коэфпересчета 		= "";
		СтрокаПозиция.Параметры.СтоимТек          	= "";
		Если НЕ ПараметрыПечати.ЭтоМетодикаТСН11б Тогда
			СтрокаПозиция.Параметры.ЗТР	          	= "";
		КонецЕсли;
		ЕдСтоимПоРасценке = 0;
		ИтогоПоРасценке.Параметры.НаименованиеПозиции = НСтр("ru='Итого по расценке'");
		ИтогоБазис = СтоимостиЕдиничные.СтоимПрямЗатраты+СуммыНРиСП.СуммаНРБазисная+СуммыНРиСП.СуммаСПБазисная;
		
		Если ПараметрыПечати.ОкруглятьДоРублей Тогда
			ИтогоБазис = Окр(ИтогоБазис,0,0);
		Иначе
			ИтогоБазис = Окр(ИтогоБазис,2,0);
		КонецЕсли;
		Если НЕ ПараметрыПечати.ЭтоМетодикаТСН11а Тогда
			ИтогоПоРасценке.Параметры.СтоимБазис          = ИтогоБазис;
		КонецЕсли;
		Если ПараметрыПечати.ВБазисномУровне Тогда
			ИтогоТек = СуммыНРиСП.СуммаСПБазисная + СуммыНРиСП.СуммаНРБазисная + СтоимостиВБазисномУровне.СтоимПрямЗатраты;
		Иначе
			ИтогоТек = СуммыНРиСП.СуммаСПТекущая+СуммыНРиСП.СуммаНРТекущая+Стоимости.СтоимПрямЗатраты;
		КонецЕсли;
		Если ПозицияСметы.ОбъемРабот <> 0 Тогда
			ЕдСтоимПоРасценке = Окр(ИтогоТек/ПозицияСметы.ОбъемРабот,2,0);
		Иначе
			ЕдСтоимПоРасценке = "";
		КонецЕсли;
		Если ПараметрыПечати.ОкруглятьДоРублей Тогда
			ИтогоТек = Формат(Окр(ИтогоТек,0,0),СтрокаФормата);
		Иначе	
			ИтогоТек = Формат(Окр(ИтогоТек,2,0),СтрокаФормата);
		КонецЕсли;
		ИтогоПоРасценке.Параметры.СтоимТек          	= ИтогоТек;
		
		Если ПараметрыПечати.ЭтоМетодикаТСН11а Тогда
			ИтогоПоРасценке.Параметры.ЕдСтоимПоРасценке = ЕдСтоимПоРасценке;
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ИтогоПоРасценке);
		
	КонецЕсли;
	
КонецПроцедуры	

// Процедура выводит в таблтичный документ строку позиции в 2-х уровнях цен.
//
Процедура ВывестиСтрокуПозиции2УровняЦен(Ссылка,ТабличныйДокумент,СтрокаПозиция,ПараметрыПечати, ИДСметы);
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	СтрокаФормата = ?(КолЗнаков = 0, "ЧДЦ=0","ЧДЦ=2");
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	Номера = СМ_СметаВызовСервера.ПолучитьНомерДокумента(Ссылка, "СМ_ПозицияЛокальнойСметы");
		
	// Печать акта выполненных работ.
	Если ПечатьАкта Тогда
		СуммыНРиСП = ПолучитьСуммыНРиСППоПозиции(Ссылка,ИдСметы);
		СтрокаПозиция.Параметры.ПорНомер			= Номера.ПорНомер;
		строкаПозиция.Параметры.ШифрРасценки		= СформироватьПолеОбоснование(Ссылка,ПараметрыПечати);
		строкаПозиция.Параметры.НаименованиеПозиции = СформироватьНаименованиеПозиции(Ссылка,ПараметрыПечати);
		ФактОбъем  	= ПолучитьОбъемПоПозицииАкта(ПараметрыПечати.АктСсылка,Ссылка);
		Если ФактОбъем = 0 Тогда
			Возврат;
		КонецЕсли;
		ПараметрыПечати.НомерПоПорядкуАкт = ПараметрыПечати.НомерПоПорядкуАкт + 1;	
		
		строкаПозиция.Параметры.ОбъемРабот = ФактОбъем;
		СтрокаПозиция.Параметры.Измеритель          = сокрлп(ССылка.Измеритель);	
		Если НЕ ПараметрыПечати.ЭтоРесурсная Тогда	
			СтоимостиЕдиничныеНаОбъем	=  ПолучитьЕдиничныеСтоимостиПозиции(ССылка,ПараметрыПечати,Истина,ФактОбъем);
			СтоимостиЕдиничные	=  ПолучитьЕдиничныеСтоимостиПозиции(ССылка,ПараметрыПечати,Ложь);
			СтоимостиНаОбъем	=  ПолучитьСтоимостиПозиции(Ссылка,ПараметрыПечати,Истина,,ФактОбъем);
			Стоимости			=  ПолучитьСтоимостиПозиции(Ссылка,ПараметрыПечати,Ложь);
			Если Ссылка.Определитель.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
				СтрокаПозиция.Параметры.ЕдСтоимБазис = Окр(СтоимостиЕдиничные.СтоимОборуд,2);
				СтрокаПозиция.Параметры.СтоимБазис = Формат(Окр(Стоимости.СтоимОборуд,2),СтрокаФормата);
				СтрокаПозиция.Параметры.ЕдСтоимТек = Окр(Стоимости.СтоимОборуд,2);
				СтрокаПозиция.Параметры.СтоимТек   = Формат(Окр(СтоимостиНаОбъем.СтоимОборуд,2),СтрокаФормата);
			Иначе	
				СтрокаПозиция.Параметры.ЕдСтоимБазис = Окр(СтоимостиЕдиничные.СтоимПрямЗатраты,2);
				СтрокаПозиция.Параметры.СтоимБазис = Формат(Окр(СтоимостиЕдиничныеНаОбъем.СтоимПрямЗатраты,2),СтрокаФормата);
				СтрокаПозиция.Параметры.СтоимТек = Формат(Окр(СтоимостиНаОбъем.СтоимПрямЗатраты,2),СтрокаФормата);
				СтрокаПозиция.Параметры.ЕдСтоимТек = Окр(Стоимости.СтоимПрямЗатраты,2);
			КонецЕсли;
		Иначе
			// Ресурсная смета.
			СтоимостиЕдиничные = ПолучитьЕдиничныеСтоимостиПозицииРесМет(Ссылка,ПараметрыПечати,Ложь);
			СтоимостиЕдиничныеНаОбъем = ПолучитьЕдиничныеСтоимостиПозицииРесМет(Ссылка,ПараметрыПечати,Истина,ФактОбъем);
			СтоимостиНаОбъем = ПолучитьСтоимостиПозиции(Ссылка,ПараметрыПечати,Истина,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП",ФактОбъем);
			Стоимости = ПолучитьСтоимостиПозиции(Ссылка,ПараметрыПечати,Ложь,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП");
			Если Ссылка.Определитель.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
				СтрокаПозиция.Параметры.ЕдСтоимБазис = Окр(СтоимостиЕдиничные.СтоимОборуд,2);
				СтрокаПозиция.Параметры.СтоимБазис = Формат(Окр(Стоимости.СтоимОборуд,2),СтрокаФормата);
				СтрокаПозиция.Параметры.ЕдСтоимТек = Окр(Стоимости.ТекСтоимОборуд,2);
				СтрокаПозиция.Параметры.СтоимТек   = Формат(Окр(СтоимостиНаОбъем.ТекСтоимОборуд,2),СтрокаФормата);
			Иначе	
				СтрокаПозиция.Параметры.ЕдСтоимБазис = Окр(СтоимостиЕдиничные.СтоимПрямЗатраты,2);
				СтрокаПозиция.Параметры.СтоимБазис = Формат(Окр(СтоимостиЕдиничныеНаОбъем.СтоимПрямЗатраты,2),СтрокаФормата);
				СтрокаПозиция.Параметры.СтоимТек = Формат(Окр(СтоимостиНаОбъем.ТекСтоимПрямЗатраты,2),СтрокаФормата);
				СтрокаПозиция.Параметры.ЕдСтоимТек = Окр(Стоимости.ТекСтоимПрямЗатраты,2);
			КонецЕсли;
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(СтрокаПозиция);
	Иначе	
		// Печать локальной сметы.
		СуммыНРиСП = ПолучитьСуммыНРиСППоПозиции(Ссылка,ИдСметы);
		
		СтрокаПозиция.Параметры.ПорНомер			= Номера.ПорНомер;
		строкаПозиция.Параметры.ШифрРасценки		= СформироватьПолеОбоснование(Ссылка,ПараметрыПечати);
		строкаПозиция.Параметры.НаименованиеПозиции = СформироватьНаименованиеПозиции(Ссылка,ПараметрыПечати);
		СтрокаПозиция.Параметры.ОбъемРабот			= Ссылка.ОбъемРабот;
		СтрокаПозиция.Параметры.Измеритель          = сокрлп(ССылка.Измеритель);	
		Если НЕ ПараметрыПечати.ЭтоРесурсная Тогда	
			СтоимостиЕдиничныеНаОбъем	=  ПолучитьЕдиничныеСтоимостиПозиции(ССылка,ПараметрыПечати,Истина);
			СтоимостиЕдиничные	=  ПолучитьЕдиничныеСтоимостиПозиции(ССылка,ПараметрыПечати,Ложь);
			СтоимостиНаОбъем	=  ПолучитьСтоимостиПозиции(Ссылка,ПараметрыПечати,Истина);
			Стоимости			=  ПолучитьСтоимостиПозиции(Ссылка,ПараметрыПечати,Ложь);
			Если Ссылка.Определитель.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
				СтрокаПозиция.Параметры.ЕдСтоимБазис = Окр(СтоимостиЕдиничные.СтоимОборуд,2);
				СтрокаПозиция.Параметры.СтоимБазис = Формат(Окр(Стоимости.СтоимОборуд,2),СтрокаФормата);
				СтрокаПозиция.Параметры.ЕдСтоимТек = Окр(Стоимости.СтоимОборуд,2);
				СтрокаПозиция.Параметры.СтоимТек   = Формат(Окр(СтоимостиНаОбъем.СтоимОборуд,2),СтрокаФормата);
			Иначе	
				СтрокаПозиция.Параметры.ЕдСтоимБазис = Окр(СтоимостиЕдиничные.СтоимПрямЗатраты,2);
				СтрокаПозиция.Параметры.СтоимБазис = Формат(Окр(СтоимостиЕдиничныеНаОбъем.СтоимПрямЗатраты,2),СтрокаФормата);
				СтрокаПозиция.Параметры.СтоимТек = Формат(Окр(СтоимостиНаОбъем.СтоимПрямЗатраты,2),СтрокаФормата);
				СтрокаПозиция.Параметры.ЕдСтоимТек = Окр(Стоимости.СтоимПрямЗатраты,2);
			КонецЕсли;
		Иначе
			// Ресурсная смета.
			СтоимостиЕдиничные = ПолучитьЕдиничныеСтоимостиПозицииРесМет(Ссылка,ПараметрыПечати,Ложь);
			СтоимостиЕдиничныеНаОбъем = ПолучитьЕдиничныеСтоимостиПозицииРесМет(Ссылка,ПараметрыПечати,Истина);
			СтоимостиНаОбъем = ПолучитьСтоимостиПозиции(Ссылка,ПараметрыПечати,Истина,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП");
			Стоимости = ПолучитьСтоимостиПозиции(Ссылка,ПараметрыПечати,Ложь,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП");
			Если Ссылка.Определитель.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
				СтрокаПозиция.Параметры.ЕдСтоимБазис = Окр(СтоимостиЕдиничные.СтоимОборуд,2);
				СтрокаПозиция.Параметры.СтоимБазис = Формат(Окр(Стоимости.СтоимОборуд,2),СтрокаФормата);
				СтрокаПозиция.Параметры.ЕдСтоимТек = Окр(Стоимости.ТекСтоимОборуд,2);
				СтрокаПозиция.Параметры.СтоимТек   = Формат(Окр(СтоимостиНаОбъем.ТекСтоимОборуд,2),СтрокаФормата);
			Иначе	
				СтрокаПозиция.Параметры.ЕдСтоимБазис = Окр(СтоимостиЕдиничные.СтоимПрямЗатраты,2);
				СтрокаПозиция.Параметры.СтоимБазис = Формат(Окр(СтоимостиЕдиничныеНаОбъем.СтоимПрямЗатраты,2),СтрокаФормата);
				СтрокаПозиция.Параметры.СтоимТек = Формат(Окр(СтоимостиНаОбъем.ТекСтоимПрямЗатраты,2),СтрокаФормата);
				СтрокаПозиция.Параметры.ЕдСтоимТек = Окр(Стоимости.ТекСтоимПрямЗатраты,2);
			КонецЕсли;
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(СтрокаПозиция);
	КонецЕсли;	
	
КонецПроцедуры

// Процедура выводит строку - позицию Локальной сметы с ресурсным методом счета в ТабличныйДокумент.
//
Процедура ВывестиСтрокуПозицииРесурснойСметы(ПозицияСметы,ТабличныйДокумент,СтрокаПозиция,ПараметрыПечати, Смета,ПодГруппа)
	
	ПечатьАкта = Ложь;
	Если ПараметрыПечати.Свойство("ПечатьАкта") Тогда
		ПечатьАкта = ПараметрыПечати.ПечатьАкта;
	КонецЕсли;
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	СтрокаФормата = ?(КолЗнаков = 0, "ЧДЦ=0","ЧДЦ=2");
	
	Номера = СМ_СметаВызовСервера.ПолучитьНомерДокумента(ПозицияСметы.Ссылка, "СМ_ПозицияЛокальнойСметы");
	
	// Печать по акту выполненных работ.
	Если ПечатьАкта Тогда
		ФактОбъем = ПолучитьОбъемПоПозицииАкта(ПараметрыПечати.АктСсылка,ПозицияСметы);
		Если ФактОбъем = 0 Тогда
			Возврат;
		КонецЕсли;
		ПараметрыПечати.НомерПоПорядкуАкт = ПараметрыПечати.НомерПоПорядкуАкт + 1;	
		
		СтрокаПозиция.Параметры.ПорНомер			= Номера.ПорНомер;
		СтрокаПозиция.Параметры.ШифрРасценки		= СформироватьПолеОбоснование(ПозицияСметы,ПараметрыПечати);
		СтрокаПозиция.Параметры.НаименованиеПозиции = СформироватьНаименованиеПозиции(ПозицияСметы,ПараметрыПечати);
		СтрокаПозиция.Параметры.Измеритель          = Сокрлп(ПозицияСметы.Измеритель);						
		
		Если ПараметрыПечати.ПечататьРасшифровку = Истина Тогда
			Стоимости = ПолучитьСтоимостиПозиции(ПозицияСметы,ПараметрыПечати,Ложь,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками",ФактОбъем);
		Иначе
			Стоимости = ПолучитьСтоимостиПозиции(ПозицияСметы,ПараметрыПечати,Ложь,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП",ФактОбъем);
		КонецЕсли;
		Если ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП Тогда
			ЕдиничныеСтоимости = ПолучитьЕдиничныеСтоимостиПозиции(ПозицияСметы,ПараметрыПечати,Ложь,ФактОбъем);
		Иначе
			ЕдиничныеСтоимости = ПолучитьЕдиничныеСтоимостиПозицииРесМет(ПозицияСметы,ПараметрыПечати,Ложь,ФактОбъем);
		КонецЕсли;	
		Если ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП
			Или ПараметрыПечати.ПечататьРасшифровку = Ложь Тогда
			ЗТР = ПолучитьЗТР(ПозицияСметы,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП",ПараметрыПечати);
		Иначе	
			ЗТР = ПолучитьЗТР(ПозицияСметы,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками",ПараметрыПечати);
		КонецЕсли;	                          
		
		Если ПараметрыПечати.ЭтоКС2Рес Тогда
			
			СтрокаПозиция.Параметры.ПорНомерАкт = ПараметрыПечати.НомерПоПорядкуАкт;
			СтрокаПозиция.Параметры.ОбъемРабот 	= ФактОбъем;
			
			Если ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП Тогда
				Если ПозицияСметы.Определитель.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
					СтрокаПозиция.Параметры.ЕдВсего = ЕдиничныеСтоимости.ТекСтоимОборуд;
				Иначе	
					СтрокаПозиция.Параметры.ЕдВсего	= ЕдиничныеСтоимости.ТекСтоимПрямЗатраты;
				КонецЕсли;
				СтрокаПозиция.Параметры.ЗаработнаяПлата = Формат(Окр(Стоимости.ТекСтоимОснзарплата * ФактОбъем,КолЗнаков),СтрокаФормата);
			Иначе
				Если ПозицияСметы.Определитель.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
					СтрокаПозиция.Параметры.ЕдВсего = ЕдиничныеСтоимости.ТекСтоимОборуд;
				Иначе	
					СтрокаПозиция.Параметры.ЕдВсего = ЕдиничныеСтоимости.ТекСтоимПрямЗатраты;
				КонецЕсли;
				СтрокаПозиция.Параметры.ЗаработнаяПлата = Формат(Окр(Стоимости.ТекСтоимОснзарплата * ФактОбъем,КолЗнаков),СтрокаФормата);
			КонецЕсли;
			
			СтрокаПозиция.Параметры.ОбщВсего = Формат(Окр((Стоимости.ТекСтоимПрямЗатраты + Стоимости.ТекСтоимОборуд) * ФактОбъем,КолЗнаков),СтрокаФормата);
			
			// Строка зарплаты машинистов.
			Если Не ПараметрыПечати.ПечататьСетку Тогда
				СтрокаПозиция.Параметры.ЗПМ	= "";
				СтрокаПозиция.Параметры.ЕдЗПМ = "";
			КонецЕсли;
			
		Иначе	
			
			СтрокаПозиция.Параметры.Количество 	= ФактОбъем;	
			СтрокаПозиция.Параметры.Норма 		= "";				
			
			Если ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП Тогда
				
				Если ПозицияСметы.Определитель.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
					СтрокаПозиция.Параметры.Цена			= Формат(Окр(ЕдиничныеСтоимости.ТекСтоимОборуд, 2),"ЧДЦ=2");
					СтрокаПозиция.Параметры.ПрямыеЗатраты	= Формат(Окр(ЕдиничныеСтоимости.ТекСтоимОборуд * ФактОбъем,КолЗнаков),СтрокаФормата);
				Иначе	
					СтрокаПозиция.Параметры.Цена			= Формат(Окр(ЕдиничныеСтоимости.ТекСтоимПрямЗатраты, 2),"ЧДЦ=2");
					СтрокаПозиция.Параметры.ПрямыеЗатраты	= Формат(Окр(ЕдиничныеСтоимости.ТекСтоимПрямЗатраты * ФактОбъем,КолЗнаков),СтрокаФормата);
				КонецЕсли;
				СтрокаПозиция.Параметры.ЗаработнаяПлата		= Формат(Окр(Стоимости.ТекСтоимОснЗарплата * ФактОбъем,КолЗнаков),СтрокаФормата);
				СтрокаПозиция.Параметры.МашиныИМеханизмы	= Формат(Окр(Стоимости.ТекСтоимЭксплМашин	* ФактОбъем,КолЗнаков),СтрокаФормата);
				СтрокаПозиция.Параметры.ЗарплатаМашинистов	= Формат(Окр(Стоимости.ТекСтоимЗарплМашин	* ФактОбъем,КолЗнаков),СтрокаФормата);
				СтрокаПозиция.Параметры.Материалы			= Формат(Окр(Стоимости.ТекСтоимСтоимМатер	* ФактОбъем,КолЗнаков),СтрокаФормата);
				СтрокаПозиция.Параметры.ЗТР					= Окр(ЗТР.ЗатратыТрудаРабочих * ФактОбъем,2);
				СтрокаПозиция.Параметры.ЗТМ					= Окр(ЗТР.ЗатратыТрудаМашинистов * ФактОбъем,2);
				
			Иначе
				
				Если ПозицияСметы.Определитель.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
					СтрокаПозиция.Параметры.Цена			= ЕдиничныеСтоимости.ТекСтоимОборуд;	
					СтрокаПозиция.Параметры.ПрямыеЗатраты	= Формат(Окр(Стоимости.ТекСтоимОборуд * ФактОбъем,КолЗнаков),СтрокаФормата);	
				Иначе
					СтрокаПозиция.Параметры.Цена			= ЕдиничныеСтоимости.ТекСтоимПрямЗатраты;
					СтрокаПозиция.Параметры.ПрямыеЗатраты	= Формат(Окр(Стоимости.ТекСтоимПрямЗатраты * ФактОбъем,КолЗнаков),СтрокаФормата);
				КонецЕсли;	
				
				СтрокаПозиция.Параметры.ЗаработнаяПлата		= Формат(Окр(Стоимости.ТекСтоимОснЗарплата * ФактОбъем,КолЗнаков),СтрокаФормата);
				СтрокаПозиция.Параметры.МашиныИМеханизмы	= Формат(Окр(Стоимости.ТекСтоимЭксплМашин * ФактОбъем,КолЗнаков),СтрокаФормата);
				СтрокаПозиция.Параметры.ЗарплатаМашинистов	= Формат(Окр(Стоимости.ТекСтоимЗарплМашин * ФактОбъем,КолЗнаков),СтрокаФормата);
				СтрокаПозиция.Параметры.Материалы			= Формат(Окр(Стоимости.ТекСтоимСтоимМатер * ФактОбъем,КолЗнаков),СтрокаФормата);
				СтрокаПозиция.Параметры.ЗТР					= Окр(ЗТР.ЗатратыТрудаРабочих * ФактОбъем,2);
				СтрокаПозиция.Параметры.ЗТМ					= Окр(ЗТР.ЗатратыТрудаМашинистов * ФактОбъем,2); 
				
			КонецЕсли;	
			
			
		КонецЕсли;	
		
		ТабличныйДокумент.Вывести(СтрокаПозиция);
		
		Если ПараметрыПечати.РазвернутыйОтчет Тогда
			ВывестиРесурсыПозиции(ПозицияСметы,ТабличныйДокумент,СтрокаПозиция,ПараметрыПечати,ПодГруппа,ФактОбъем);
		КонецЕсли;
		
		// Печать по локальной смете.
	Иначе
		
		СтрокаПозиция.Параметры.ПорНомер			= Номера.ПорНомер;
		СтрокаПозиция.Параметры.ШифрРасценки		= СформироватьПолеОбоснование(ПозицияСметы,ПараметрыПечати);
		СтрокаПозиция.Параметры.НаименованиеПозиции = СформироватьНаименованиеПозиции(ПозицияСметы,ПараметрыПечати);
		СтрокаПозиция.Параметры.Измеритель          = Сокрлп(ПозицияСметы.Измеритель);						
		СтрокаПозиция.Параметры.Количество          = Сокрлп(ПозицияСметы.ОбъемРабот);			
		
		Если ПараметрыПечати.ПечататьРасшифровку = Истина Тогда
			Стоимости = ПолучитьСтоимостиПозиции(ПозицияСметы,ПараметрыПечати,ложь,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками");
		Иначе
			Стоимости = ПолучитьСтоимостиПозиции(ПозицияСметы,ПараметрыПечати,ложь,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП");
		КонецЕсли;
		Если ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП Тогда
			ЕдиничныеСтоимости = ПолучитьЕдиничныеСтоимостиПозиции(ПозицияСметы,параметрыПечати,Ложь);
		Иначе
			ЕдиничныеСтоимости = ПолучитьЕдиничныеСтоимостиПозицииРесМет(ПозицияСметы,ПараметрыПечати,Ложь,ФактОбъем);
		КонецЕсли;	
		Если ПараметрыПечати.ВБазисномУровне Тогда
			ЕдиничныеСтоимости = ПолучитьЕдиничныеСтоимостиПозиции(ПозицияСметы,параметрыПечати,Ложь);
		КонецЕсли;	
		Если ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП
			Или ПараметрыПечати.ПечататьРасшифровку = Ложь Тогда
			ЗТР = ПолучитьЗТР(ПозицияСметы,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП",ПараметрыПечати);
		Иначе	
			ЗТР = ПолучитьЗТР(ПозицияСметы,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками",ПараметрыПечати);
		КонецЕсли;	
		Если ПараметрыПечати.ЭтоРесурсная12Граф Тогда
			СтрокаПозиция.Параметры.Норма = "";
			СтрокаПозиция.Параметры.ЗрплМаш = 0;
			СтрокаПозиция.Параметры.ЦенаМаш = 0;
			Если ПараметрыПечати.ПечататьЕдиничныеСтоимостиЧП Тогда
				Если ПараметрыПечати.ВБазисномУровне Тогда
					Если ПозицияСметы.Определитель.ВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
						СтрокаПозиция.Параметры.Цена			= Окр(ЕдиничныеСтоимости.СтоимОборуд,2);
