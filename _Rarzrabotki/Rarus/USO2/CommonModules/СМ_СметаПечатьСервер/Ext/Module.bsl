#Область ПрограммныйИнтерфейс

// Функция возвращает печатную форму документа.
//
// Параметры:
//     ИмяМакета             - Строка - имя макета.
//     ПредставлениеМакета   - Строка - представление макета.
//     ПолныйПутьКМакету     - Строка - путь к макету в дереве метаданных, например:
//                                      "Документ.СМ_ЛокальнаяСмета.ПФ_MXL_СчетЗаказ".
//                                      Если не указывать этот параметр, то редактирование макета пользователем будет
//                                      недоступно в форме ПечатьДокументов. 
//     МассивОбъектов 		 - Массив - массив объектов, для которых формируются печатные формы.
//     КоллекцияПечатныхФорм - ТаблицаЗначений - см. ПодготовитьКоллекциюПечатныхФорм().
//     ОбъектыПечати 		 - СписокЗначений - список объектов печати.
//     ПараметрыВывода       - Структура       - дополнительные параметры сформированных табличных документов
//                                              (выходной параметр).
//
Процедура ПодготовитьПечатнуюФорму(Знач ИмяМакета, ПредставлениеМакета, МассивОбъектов, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода, ПолныйПутьКМакету = "") Экспорт
	
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакета);
	
	Если НЕ НужноПечататьМакет Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(МассивОбъектов[0]) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		Наименование = "Акт №" + МассивОбъектов[0].НомерАкта + " к смете "+МассивОбъектов[0].ЛокальнаяСмета.Наименование;
	ИначеЕсли ТипЗнч(МассивОбъектов[0]) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета")
		ИЛИ ТипЗнч(МассивОбъектов[0]) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета")
		ИЛИ ТипЗнч(МассивОбъектов[0]) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		Наименование = МассивОбъектов[0].Наименование;
	Иначе
		Наименование = ПредставлениеМакета;
	КонецЕсли;
	СоответствиеИменФайлов = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(Наименование,"_");
	
	Если ИмяМакета = "ОтчетМ29" Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СоответствиеИменФайлов,
		СформироватьОтчетМ29(МассивОбъектов, ОбъектыПечати, ИмяМакета, Ложь),
		,
		ПолныйПутьКМакету);
	ИначеЕсли ИмяМакета = "ОтчетМ29Материалы" Тогда	
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СоответствиеИменФайлов,
		СформироватьОтчетМ29(МассивОбъектов, ОбъектыПечати, ИмяМакета, Истина),
		,
		ПолныйПутьКМакету);
	ИначеЕсли ИмяМакета = "ОтчетМ19" Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СоответствиеИменФайлов,
		СформироватьОтчетМ19(МассивОбъектов, ОбъектыПечати, ИмяМакета),
		,
		ПолныйПутьКМакету);
	ИначеЕсли ИмяМакета = "ОтчетВыполненныеРаботы" Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СоответствиеИменФайлов,
		СформироватьОтчетСправкаОВыполненныхРаботах(МассивОбъектов, ОбъектыПечати, ИмяМакета),
		,
		ПолныйПутьКМакету);
	ИначеЕсли ИмяМакета = "ОтчетКС3" Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СоответствиеИменФайлов,
		СформироватьПечатнуюФормуОтчетКС3(МассивОбъектов, ОбъектыПечати, ИмяМакета),
		,
		ПолныйПутьКМакету);
	ИначеЕсли ИмяМакета = "Приложение" Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СоответствиеИменФайлов,
		ПечатьПриложение(МассивОбъектов, ОбъектыПечати, ИмяМакета),
		,
		ПолныйПутьКМакету);
	ИначеЕсли (ИмяМакета = "ПФ_MXL_Акт_РасчетЗатратНаУплатуНДСприУСН")
		ИЛИ (ИмяМакета = "ПФ_MXL_ЛС_РасчетЗатратНаУплатуНДСприУСН") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СоответствиеИменФайлов,
		ПечатьФормаЗатраНаУплатуНДС(МассивОбъектов, ОбъектыПечати, ИмяМакета),
		,
		ПолныйПутьКМакету);
	ИначеЕсли (ИмяМакета = "ПФ_MXL_Акт_12_МОЭ")
		ИЛИ (ИмяМакета = "ПФ_MXL_Акт_12") ИЛИ (ИмяМакета = "ПФ_MXL_Акт_14") ИЛИ (ИмяМакета = "ПФ_MXL_Акт_НРиСП")
		ИЛИ (ИмяМакета = "ПФ_MXL_КС2") ИЛИ (ИмяМакета = "ПФ_MXL_КС2_8_Рес") ИЛИ (ИмяМакета = "ПФ_MXL_РМ12_Рес") 
		ИЛИ (ИмяМакета = "ПФ_MXL_Акт_ТСН11а" ) ИЛИ (ИмяМакета = "ПФ_MXL_Акт_ТСН11б") ИЛИ (ИмяМакета = "ПФ_MXL_Акт_ТСН9в") Тогда  		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СоответствиеИменФайлов,
		ПечатьАктаВыполненныхРабот(МассивОбъектов, ОбъектыПечати, ИмяМакета),
		,
		ПолныйПутьКМакету);
		
	ИначеЕсли (ИмяМакета = "ПФ_MXL_АКТ_2В" ) ИЛИ (ИмяМакета = "ПФ_MXL_АКТ_ВСМ") ИЛИ (ИмяМакета = "ПФ_MXL_АКТ_ОРМ") Тогда  		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СоответствиеИменФайлов,
		ПечатьАктаВыполненныхРабот_КЗ(МассивОбъектов, ОбъектыПечати, ИмяМакета),
		,
		ПолныйПутьКМакету);
	ИначеЕсли (ИмяМакета = "ПФ_MXL_ЛС_13")
		ИЛИ (ИмяМакета = "ПФ_MXL_ЛС_11") ИЛИ (ИмяМакета = "ПФ_MXL_ЛС_13_НРиСП") ИЛИ (ИмяМакета = "ПФ_MXL_ЛС_11_НРиСП") 
		ИЛИ (ИмяМакета = "ПФ_MXL_ЛС_12") ИЛИ (ИмяМакета = "ПФ_MXL_ЛС_9_Рес") ИЛИ (ИмяМакета = "ПФ_MXL_ЛС_12_Рес")
		ИЛИ (ИмяМакета = "ПФ_MXL_ЛС_7_Рес" ) ИЛИ (ИмяМакета = "ПФ_MXL_ЛС_11ТСН") ИЛИ (ИмяМакета = "ПФ_MXL_ЛС_12ТСН") ИЛИ (ИмяМакета = "ПФ_MXL_ЛС_13ТСН") Тогда  		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СоответствиеИменФайлов,
		ПечатьЛС(МассивОбъектов, ОбъектыПечати, ИмяМакета),
		,
		ПолныйПутьКМакету);
	ИначеЕсли (ИмяМакета = "ПФ_MXL_МакетОС")
		ИЛИ (ИмяМакета = "ПФ_MXL_СМ_КЗ_МакетОС") Тогда  		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СоответствиеИменФайлов,
		СМ_СметаПечатьОбъектнаяСводнаяВызовСервера.ПечатьОС(МассивОбъектов, ОбъектыПечати, ИмяМакета),
		,
		ПолныйПутьКМакету);
	ИначеЕсли (ИмяМакета = "ПФ_MXL_МакетСС")
		ИЛИ (ИмяМакета = "ПФ_MXL_СМ_КЗ_МакетСС")
		ИЛИ (ИмяМакета = "ПФ_MXL_СМ_КЗ_МакетСС_Сводный") Тогда  		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СоответствиеИменФайлов,
		СМ_СметаПечатьОбъектнаяСводнаяВызовСервера.ПечатьСС(МассивОбъектов, ОбъектыПечати, ИмяМакета),
		,
		ПолныйПутьКМакету);
	ИначеЕсли (ИмяМакета = "ПФ_MXL_СМ_КЗ_ЛС_1_Рес")
		ИЛИ (ИмяМакета = "ПФ_MXL_СМ_КЗ_ЛС_2_Рес") Тогда  		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СоответствиеИменФайлов,
		ПечатьЛС_КЗ(МассивОбъектов, ОбъектыПечати, ИмяМакета),
		,
		ПолныйПутьКМакету);
	ИначеЕсли ИмяМакета = "ПФ_MXL_Макет_Форма4" Тогда  		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СоответствиеИменФайлов,
		ПечатьФорма4(МассивОбъектов, ОбъектыПечати, ИмяМакета),
		,
		ПолныйПутьКМакету);
	КонецЕсли;
	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбщиеПроцедурыИФункцииПечати

Функция ПолучитьПараметрыПечати(Ссылка, ИмяМакета)
	Метод1984 = ПолучитьФункциональнуюОпцию("СМ_Методика84Года");
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ПечататьЕдиничныеСтоимостиЧП",Ссылка.ПечататьЕдиничныеСтоимостиЧП);
	ПараметрыПечати.Вставить("ПечататьЗаголовкиРазделов", 	Ссылка.ПечататьЗаголовкиРазделов);
	ПараметрыПечати.Вставить("ПечататьИндексы", 			Ссылка.ПечататьИндексы);
	ПараметрыПечати.Вставить("ПечататьИтогиПоВидамРабот", 	Ссылка.ПечататьИтогиПоВидамРабот);
	ПараметрыПечати.Вставить("ПечататьИтогиПоРазделам", 	Ссылка.ПечататьИтогиПоРазделам);
	ПараметрыПечати.Вставить("ПечататьКоэффициентыТЧ", 		Ссылка.ПечататьКоэффициентыТЧ);
	ПараметрыПечати.Вставить("ПечататьПовтор", 				Ссылка.ПечататьПовтор);
	ПараметрыПечати.Вставить("ПечататьПрефикс", 			Ссылка.ПечататьПрефикс);
	ПараметрыПечати.Вставить("ПечататьРасшифровку", 		Ссылка.ПечататьРасшифровку);
	ПараметрыПечати.Вставить("ПечататьРедакцию", 			Ссылка.ПечататьРедакцию);
	ПараметрыПечати.Вставить("ПечататьСетку", 				Ссылка.ПечататьСетку);
	ПараметрыПечати.Вставить("РасшифроватьСостав", 				Ссылка.РасшифроватьСостав);
	ПараметрыПечати.Вставить("ПечататьФормулыЛЗ", 			Ссылка.ПечататьФормулыЛЗ);
	ПараметрыПечати.Вставить("ПечататьФормулыОбъема", 		Ссылка.ПечататьФормулыОбъема);
	ПараметрыПечати.Вставить("ПечататьФормулыЦен", 			Ссылка.ПечататьФормулыЦен);
	ПараметрыПечати.Вставить("СпособРасчета", 				Ссылка.СпособРасчетаИндексов);
	ПараметрыПечати.Вставить("МетодРасчета", 				Ссылка.МетодРасчета);
	ПараметрыПечати.Вставить("УровеньЗаданияИндексов",		Ссылка.Уровень);
	ПараметрыПечати.Вставить("ОкруглятьДоРублей",			Ссылка.ОкруглятьДоРублей);
	ПараметрыПечати.Вставить("РазвернутыйОтчет",			Ссылка.РазвернутыйОтчет);
	ПараметрыПечати.Вставить("ПоГруппамРесурсов",			Ссылка.ПоГруппамРесурсов);
	ПараметрыПечати.Вставить("ЭтоПриложение", 				?(ИмяМакета = "Приложение",Истина,Ложь));
	ПараметрыПечати.Вставить("ИмяМакета", 				    ИмяМакета);
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		ПараметрыПечати.Вставить("ЭтоРесурсная",				?(Ссылка.ЛокальнаяСмета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный,Ложь,Истина));
		ПараметрыПечати.Вставить("АктСсылка",					Ссылка);
		ПараметрыПечати.Вставить("ПечатьАкта",					Истина);
		ПараметрыПечати.Вставить("НомерПоПорядкуАкт"			,0);
		ПараметрыПечати.Вставить("Это14Граф",                	?(ИмяМакета = "ПФ_MXL_Акт_14",Истина,Ложь));
		ПараметрыПечати.Вставить("Это12Граф",					?(ИмяМакета = "ПФ_MXL_Акт_12_МОЭ",Истина,Ложь));
		ПараметрыПечати.Вставить("ЭтоАктСНРиСП",				?(ИмяМакета = "ПФ_MXL_Акт_НРиСП",Истина,Ложь));		
		ПараметрыПечати.Вставить("ЭтоКС2",                		?(ИмяМакета = "ПФ_MXL_КС2",Истина,Ложь));
		ПараметрыПечати.Вставить("ЭтоКС2Рес",                	?(ИмяМакета = "ПФ_MXL_КС2_8_Рес",Истина,Ложь));
		ПараметрыПечати.Вставить("ЭтоМетодикаТСН11а",			?(ИмяМакета = "ПФ_MXL_Акт_ТСН11а",Истина,ложь));
		ПараметрыПечати.Вставить("ЭтоМетодикаТСН11б",			?(ИмяМакета = "ПФ_MXL_Акт_ТСН11б",Истина,ложь));
		ПараметрыПечати.Вставить("ЭтоМетодикаТСН9в",			?(ИмяМакета = "ПФ_MXL_Акт_ТСН9в",Истина,ложь));
		ПараметрыПечати.Вставить("ТипСтроительства", 			Ссылка.ЛокальнаяСмета.ТипСтроительства);
		ПараметрыПечати.Вставить("МетодикаТСН",					Ложь);
		ПараметрыПечати.Вставить("ВБазисномУровне",				Ложь);
		
		Если Ссылка.ЛокальнаяСмета.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква Тогда
			ПараметрыПечати.Вставить("МетодикаТСН",Истина);
		КонецЕсли;
		
		Если Метод1984 Тогда
			Если Ссылка.ЛокальнаяСмета.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_Методика84года Тогда
				ПараметрыПечати.Вставить("Методика1984",Истина);	
			Иначе	
				ПараметрыПечати.Вставить("Методика1984",Ложь);	
			КонецЕсли;
			ПараметрыПечати.Вставить("РасчетНРиСПотПЗ",				Ссылка.ЛокальнаяСмета.РасчетНРиСПотПЗ);
			ПараметрыПечати.Вставить("БезПримененияКоэффициентов",	Ссылка.ЛокальнаяСмета.БезПримененияКоэффициентов);
		Иначе
			ПараметрыПечати.Вставить("Методика1984",				Ложь);
			ПараметрыПечати.Вставить("РасчетНРиСПотПЗ",				Ложь);
			ПараметрыПечати.Вставить("БезПримененияКоэффициентов",	Ложь);
		КонецЕсли;
	Иначе
		ПараметрыПечати.Вставить("ЭтоРесурсная",					?(Ссылка.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный,ложь,истина));
		ПараметрыПечати.Вставить("ПечатьНРиСППозиции", 				Ссылка.ПечатьНРиСППозиции);
		ПараметрыПечати.Вставить("СметаСсылка",			   			Ссылка);
		ПараметрыПечати.Вставить("Это11Граф",						?(ИмяМакета = "ПФ_MXL_ЛС_11",истина,ложь));
		ПараметрыПечати.Вставить("Это13ГрафСНРиСП",					?(ИмяМакета = "ПФ_MXL_ЛС_13_НРиСП",истина,ложь));
		ПараметрыПечати.Вставить("Это11ГрафСНРиСП",					?(ИмяМакета = "ПФ_MXL_ЛС_11_НРиСП",истина,ложь));
		ПараметрыПечати.Вставить("Это12Граф",						?(ИмяМакета = "ПФ_MXL_ЛС_12",истина,ложь));
		ПараметрыПечати.Вставить("ЭтоРесурсная12Граф",				?(ИмяМакета = "ПФ_MXL_ЛС_12_Рес",истина,ложь));
		ПараметрыПечати.Вставить("ЭтоРесурсная7Граф",				?(ИмяМакета = "ПФ_MXL_ЛС_7_Рес",истина,ложь));
		ПараметрыПечати.Вставить("ЭтоМетодикаТСН11а",				?(ИмяМакета = "ПФ_MXL_ЛС_11ТСН",истина,ложь));
		ПараметрыПечати.Вставить("ЭтоМетодикаТСН11б",				?(ИмяМакета = "ПФ_MXL_ЛС_12ТСН",истина,ложь));
		ПараметрыПечати.Вставить("ЭтоМетодикаТСН9в",				?(ИмяМакета = "ПФ_MXL_ЛС_13ТСН",истина,ложь));
		ПараметрыПечати.Вставить("ТипСтроительства", 				Ссылка.ТипСтроительства);
		ПараметрыПечати.Вставить("ВБазисномУровне", 				Ссылка.БазисныеЦены);
		ПараметрыПечати.Вставить("МетодикаТСН",						Ложь);
		ПараметрыПечати.Вставить("Методика1984",					Ложь);	
		
		Если Ссылка.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква Тогда
			ПараметрыПечати.МетодикаТСН = Истина;	
		КонецЕсли;
	
		Если Метод1984 Тогда
			Если Ссылка.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_Методика84года Тогда
				ПараметрыПечати.Методика1984 = Истина;	
			КонецЕсли;
			ПараметрыПечати.Вставить("РасчетНРиСПотПЗ",				Ссылка.РасчетНРиСПотПЗ);
			ПараметрыПечати.Вставить("БезПримененияКоэффициентов",	Ссылка.БезПримененияКоэффициентов);
		Иначе
			ПараметрыПечати.Вставить("Методика1984",				Ложь);
			ПараметрыПечати.Вставить("РасчетНРиСПотПЗ",				Ложь);
			ПараметрыПечати.Вставить("БезПримененияКоэффициентов",	Ложь);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПараметрыПечати;
	
КонецФункции

// Общая функция печати массива документов "Акт выполненных работ".
//
Функция ПечатьПриложение(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_Приложение";
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	
	ПервыйДокумент = Истина;
	
	Макет = ПолучитьОбщийМакет("ПФ_MXL_СМ_ПриложениеКСметеАкту");
	
	Для Каждого Ссылка Из МассивОбъектов Цикл
		
		Если НЕ ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПараметрыПечати = ПолучитьПараметрыПечати(Ссылка, ИмяМакета);
		
		Если ПараметрыПечати.ПечататьСетку Тогда
			ДополнениеОбласти = "Сетка";
		Иначе
			ДополнениеОбласти = "";
		КонецЕсли;
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		ОбластьРаздел = Макет.ПолучитьОбласть("Раздел"+ДополнениеОбласти);
		ОбластьПозиция = Макет.ПолучитьОбласть("Позиция"+ДополнениеОбласти);
		ОбластьИтогРаздела = Макет.ПолучитьОбласть("ИтогРаздела"+ДополнениеОбласти);
		ОбластьИтого = Макет.ПолучитьОбласть("Итого"+ДополнениеОбласти);
		ОбластьЛимЗатрата = Макет.ПолучитьОбласть("ЛимЗатрата"+ДополнениеОбласти);
		ОбластьИтогоПоСмете = Макет.ПолучитьОбласть("ИтогоПоСмете"+ДополнениеОбласти);
		ОбластьПодпись = Макет.ПолучитьОбласть("Подпись");
		
		Договор = Ссылка.Договор;
		ОбластьШапка.Параметры.НомерДоговора = СокрЛП(Договор.Номер);
		ОбластьШапка.Параметры.ДатаДоговора = Формат(Договор.Дата, "ДФ=""дд.ММ.гггг""");
		Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
			ОбластьШапка.Параметры.Заголовок = НСтр("ru='АКТ ВЫПОЛНЕННЫХ РАБОТ'");
			ОбластьШапка.Параметры.Наименование = СокрЛП(Ссылка.ЛокальнаяСмета.Наименование);
		Иначе
			ОбластьШапка.Параметры.Заголовок = НСтр("ru='СМЕТА'");
			ОбластьШапка.Параметры.Наименование = СокрЛП(Ссылка.Наименование);
		КонецЕсли;
		ОбластьШапка.Параметры.Объект = СокрЛП(Ссылка.Стройка);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		Сумма = 0;
		ИДРодителя = ?(ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот"), Ссылка.ЛокальнаяСмета, Ссылка);
		ВывестиРазделыПриложения(Ссылка, ТабличныйДокумент, ИДРодителя,ОбластьРаздел,ОбластьИтогРаздела,ОбластьПозиция,ПараметрыПечати, Сумма, 0);
		
		ОбластьИтого.Параметры.Стоимость = Сумма;
		ТабличныйДокумент.Вывести(ОбластьИтого);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	СМ_ИтогиПоГлавам.Итог,
		|	СУММА(СМ_ИтогиПоГлавам.ТекПрямЗатраты) КАК Сумма
		|ИЗ
		|	РегистрСведений.СМ_ИтогиПоГлавам КАК СМ_ИтогиПоГлавам
		|ГДЕ
		|	СМ_ИтогиПоГлавам.Смета = &Смета
		|	И СМ_ИтогиПоГлавам.Итог В(&МассивЛимЗатрат)
		|
		|СГРУППИРОВАТЬ ПО
		|	СМ_ИтогиПоГлавам.Итог
		|
		|УПОРЯДОЧИТЬ ПО
		|	СМ_ИтогиПоГлавам.Итог.НомерПоПорядку";
		Запрос.УстановитьПараметр("Смета", Ссылка);
		Запрос.УстановитьПараметр("МассивЛимЗатрат", Ссылка.ЛимитированныеЗатраты.ВыгрузитьКолонку("ЛимитированнаяЗатрата"));
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ОбластьЛимЗатрата.Параметры.НаименованиеЛимЗатраты = СокрЛП(Выборка.Итог.Наименование);
			ОбластьЛимЗатрата.Параметры.Сумма = Выборка.Сумма;
			ТабличныйДокумент.Вывести(ОбластьЛимЗатрата);
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	СУММА(СМ_ИтогиПоСмете.ТекПрямЗатраты) КАК Сумма
		|ИЗ
		|	РегистрСведений.СМ_ИтогиПоСмете КАК СМ_ИтогиПоСмете
		|ГДЕ
		|	СМ_ИтогиПоСмете.Смета = &Смета
		|	И СМ_ИтогиПоСмете.Итог = &Итог";
		Запрос.УстановитьПараметр("Смета", Ссылка);
		Если Ссылка.ЛимитированныеЗатраты.Количество() > 0 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИтогиПоСмете", "ИтогиПоГлавам");
			Итог = Справочники.СМ_ИтогиПоГлавам.НайтиПоРеквизиту("Идентификатор", "ИП4");
		Иначе
			Итог = Справочники.СМ_ИтогиПоСмете.НайтиПоРеквизиту("Идентификатор", "ВсегоПоСмете");
		КонецЕсли;
		Запрос.УстановитьПараметр("Итог", Итог);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ОбластьИтогоПоСмете.Параметры.СметаАкт = ?(ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот"), "акту", "смете");
			ОбластьИтогоПоСмете.Параметры.Сумма = Выборка.Сумма;
			ТабличныйДокумент.Вывести(ОбластьИтогоПоСмете);
		КонецЕсли;
		
		ВывестиПодписи(ТабличныйДокумент, Ссылка, ОбластьПодпись, Ложь);
		
		ПервыйДокумент 		= Ложь;
		НомерСтрокиНачало 	= ТабличныйДокумент.ВысотаТаблицы + 1;
		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
	
КонецФункции	

// Общая функция печати массива документов "Акт выполненных работ".
//
Функция ПечатьАктаВыполненныхРабот(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_Акт";
	
	ПервыйДокумент = Истина;
	
	Для Каждого Ссылка Из МассивОбъектов Цикл
		
		Если НЕ ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПараметрыПечати = ПолучитьПараметрыПечати(Ссылка, ИмяМакета);
		
		Если НЕ ПроверкаНаСоответствиеПечатнойФормыДокументу(Ссылка,ИмяМакета) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбранная печатная форма не соответствует документу !'"));
			Возврат ТабличныйДокумент;
		КонецЕсли;	
		
		Если НЕ ПараметрыПечати.ЭтоРесурсная Тогда
			АктПечатьБазисноИндексная(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати);
		Иначе
			АктПечатьРесурсная(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати);
		КонецЕсли;	
		
		ПервыйДокумент 		= Ложь;
		НомерСтрокиНачало 	= ТабличныйДокумент.ВысотаТаблицы + 1;
		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
	
КонецФункции	

// Общая функция печати массива документов "Акт выполненных работ".
//
Функция ПечатьАктаВыполненныхРабот_КЗ(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_Акт";
	
	ПервыйДокумент = Истина;
	
	Для Каждого Ссылка Из МассивОбъектов Цикл
		
		Если НЕ ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПараметрыПечати = ПолучитьПараметрыПечати(Ссылка, ИмяМакета);
		
		Если ИмяМакета = "ПФ_MXL_АКТ_2В" Тогда
			АктПечатьРесурсная_КЗ(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати);
		ИначеЕсли  ИмяМакета = "ПФ_MXL_АКТ_ВСМ" Тогда
			Если Не ПараметрыПечати.ЭтоРесурсная Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбранная печатная форма не соответствует документу !'"));
				Возврат ТабличныйДокумент;
			КонецЕсли;	
			ВывестиПФ_MXL_АКТ_ВСМ(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати);
		ИначеЕсли  ИмяМакета = "ПФ_MXL_АКТ_ОРМ" Тогда
			Если Не ПараметрыПечати.ЭтоРесурсная Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбранная печатная форма не соответствует документу !'"));
				Возврат ТабличныйДокумент;
			КонецЕсли;	
			ВывестиПФ_MXL_АКТ_ОРМ(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати);
		КонецЕсли;
		
		ПервыйДокумент 		= Ложь;
		НомерСтрокиНачало 	= ТабличныйДокумент.ВысотаТаблицы + 1;
		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
	
КонецФункции	

// Вспомогательная процедура печати.
//
Процедура АктПечатьРесурсная_КЗ(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати)
	
	КолЗнаков = 2;
	Если Ссылка.ОкруглятьДоРублей = Истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	
	Макет               = УправлениеПечатью.МакетПечатнойФормы("Документ.СМ_АктВыполненныхРабот." + ИмяМакета);
//	Макет 				= Документы.СМ_АктВыполненныхРабот.ПолучитьМакет(ИмяМакета);
	Шапка				= Макет.ПолучитьОбласть("Шапка");
	ШапкаТаблицы		= Макет.ПолучитьОбласть("ШапкаТаблицы");
	ИтогоПрямыеЗатраты	= Макет.ПолучитьОбласть("ИтогоПрямыеЗатраты");
	ИтогСмета   		= Макет.ПолучитьОбласть("ИтогСмета");
	СтрокаПозиция   	= Макет.ПолучитьОбласть("СтрокаПозиция");
	Подписи				= Макет.ПолучитьОбласть("Подписи");
	
	Стоимости = ПолучитьСметныеСтоимости(Ссылка,ПараметрыПечати);
	
	Если Ссылка.ПечататьСогласованоУтверждаю Тогда
		Попытка
			ОбластьСогласованоУтверждаю = Макет.ПолучитьОбласть("СогласованоУтверждаю");
			ВывестиСогласованоУтверждаю(ТабличныйДокумент, Ссылка, ОбластьСогласованоУтверждаю, Стоимости);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Для этого макета еще нет области ""Согласовано/Утверждаю""'"));
		КонецПопытки;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ссылка.ЛокальнаяСмета.ДатаТекущихЦен) Тогда
		ДатаЦен			= Ссылка.ЛокальнаяСметаюДата;
	Иначе	
		ДатаЦен			= Ссылка.ЛокальнаяСмета.ДатаТекущихЦен;
	КонецЕсли;	

	Шапка.Параметры.Квартал = Формат(КонецКвартала(ДатаЦен),"ДФ=" "к");
	Шапка.Параметры.Год = Год(ДатаЦен);

		
	Шапка.Параметры.Заказчик	= СокрЛП(Ссылка.Заказчик.Наименование);
	Шапка.Параметры.Подрядчик	= Сокрлп(Ссылка.подрядчик.наименование);
	Шапка.Параметры.Объект 	= СокрЛП(Ссылка.Стройка.Наименование);
	Шапка.Параметры.НомерАкта	= СокрЛП(Ссылка.НомерАкта);
	Шапка.Параметры.НомерСметы	= СокрЛП(Ссылка.ЛокальнаяСмета.НомерСметы) + "  " +  СокрЛП(Ссылка.ЛокальнаяСмета.Наименование);
	Шапка.Параметры.Период 		= Формат(Ссылка.ПериодОт,"ДЛФ=Д")+" - "+Формат(Ссылка.ПериодДо,"ДЛФ=Д");
	
	ШапкаТаблицы.Параметры.Заполнить(ПолучитьСтруктуруОбозначенияВалюты(Ссылка));

	ТабличныйДокумент.Вывести(Шапка);
	ТабличныйДокумент.Вывести(ШапкаТаблицы);
	
	ВывестиПозиции_КЗ(ТабличныйДокумент,Ссылка.ЛокальнаяСмета,СтрокаПозиция,Неопределено,Неопределено,ПараметрыПечати,Неопределено);
	ВывестиИтогиПоСмете_КЗ(ТабличныйДокумент,Ссылка,ИтогСмета,ИтогоПрямыеЗатраты,ПараметрыПечати);
	ТабличныйДокумент.Вывести(Подписи);
	
	ТабличныйДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	
КонецПроцедуры	

// Вспомогательная процедура печати.
//
Процедура ВывестиПФ_MXL_АКТ_ВСМ(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати)
	
	КолЗнаков = 2;
	Если Ссылка.ОкруглятьДоРублей = Истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	
	Макет               = УправлениеПечатью.МакетПечатнойФормы("Документ.СМ_АктВыполненныхРабот." + ИмяМакета);
//	Макет 				= Документы.СМ_АктВыполненныхРабот.ПолучитьМакет(ИмяМакета);
	Шапка				= Макет.ПолучитьОбласть("Шапка");
	ШапкаТаблицы		= Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьНетДанных	= Макет.ПолучитьОбласть("НетДанных");
	ОбластьГруппа       = Макет.ПолучитьОбласть("Группа");
	ОбластьИтог       	= Макет.ПолучитьОбласть("Итоги");
	
	ТаблицаРесурсов = СМ_СметаРасчетВызовСервера.ПолучитьТаблицуСтоимостиРесурсовАкта(Ссылка,Истина,,,,Истина);
	ТаблицаРесурсов.Сортировать("НаименованиеРесурса");	
	Если Не ЗначениеЗаполнено(Ссылка.ЛокальнаяСмета.ДатаТекущихЦен) Тогда
		ДатаЦен			= Ссылка.ЛокальнаяСметаюДата;
	Иначе	
		ДатаЦен			= Ссылка.ЛокальнаяСмета.ДатаТекущихЦен;
	КонецЕсли;	

	Шапка.Параметры.Квартал = Формат(КонецКвартала(ДатаЦен),"ДФ=" "к");
	Шапка.Параметры.Год = Год(ДатаЦен);
	Шапка.Параметры.Стройка 	= СокрЛП(Ссылка.Стройка.Наименование);
	Шапка.Параметры.НомерАкта	= СокрЛП(Ссылка.НомерАкта);
	
	ШапкаТаблицы.Параметры.Заполнить(ПолучитьСтруктуруОбозначенияВалюты(Ссылка));

	ТабличныйДокумент.Вывести(Шапка);
	ТабличныйДокумент.Вывести(ШапкаТаблицы);
	
	Если ТаблицаРесурсов.Количество()=0 Тогда
		ТабличныйДокумент.Вывести(ОбластьНетДанных);
		Возврат;
	КонецЕсли;

	СписокГрупп = Новый СписокЗначений;
	СписокГрупп.Добавить(Перечисления.СМ_ВидыРесурсов.Материалы,НСтр("ru='Итого по материалам'"));
	
	Для Каждого Группа Из СписокГрупп Цикл
		
		МассивРесурсов = ТаблицаРесурсов.НайтиСтроки(Новый Структура("ВидРесурса",Группа.Значение));
		Если МассивРесурсов.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОбластьГруппа.Параметры.ГруппаРесурсов = Группа.Значение;
		ТабличныйДокумент.Вывести(ОбластьГруппа);
		Всего = 0;
		Для Каждого эл Из МассивРесурсов Цикл
			ОбластьСтрока       			= Макет.ПолучитьОбласть("Ресурсы");
			ОбластьСтрока.Параметры.Заполнить(эл);
			ОбластьСтрока.Параметры.Стоимость = эл.ЦенаТекущая;
			ОбластьСтрока.Параметры.Всего = эл.СтоимостьТекущая;
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			Всего = Всего + эл.СтоимостьТекущая;
		КонецЦикла;
		
		ОбластьИтог.Параметры.Итог = Группа.Представление;
		ОбластьИтог.Параметры.Всего = Всего;
		ТабличныйДокумент.Вывести(ОбластьИтог);

	КонецЦикла;
	
	ТабличныйДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	
КонецПроцедуры	

// Вспомогательная процедура печати.
//
Процедура ВывестиПФ_MXL_АКТ_ОРМ(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати)
	
	КолЗнаков = 2;
	Если Ссылка.ОкруглятьДоРублей = Истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	
	Макет               = УправлениеПечатью.МакетПечатнойФормы("Документ.СМ_АктВыполненныхРабот." + ИмяМакета);
//	Макет 				= Документы.СМ_АктВыполненныхРабот.ПолучитьМакет(ИмяМакета);
	Шапка				= Макет.ПолучитьОбласть("Шапка");
	ШапкаТаблицы		= Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьНетДанных	= Макет.ПолучитьОбласть("НетДанных");
	СтрокаПозиция       = Макет.ПолучитьОбласть("Группа");
	
	ТаблицаРесурсов = СМ_СметаРасчетВызовСервера.ПолучитьТаблицуСтоимостиРесурсовАкта(Ссылка,Истина,,,Истина,Истина);
	ТаблицаРесурсов.Сортировать("НаименованиеРесурса");
	Если Не ЗначениеЗаполнено(Ссылка.ЛокальнаяСмета.ДатаТекущихЦен) Тогда
		ДатаЦен			= Ссылка.ЛокальнаяСметаюДата;
	Иначе	
		ДатаЦен			= Ссылка.ЛокальнаяСмета.ДатаТекущихЦен;
	КонецЕсли;	

	Шапка.Параметры.Квартал = Формат(КонецКвартала(ДатаЦен),"ДФ=" "к");
	Шапка.Параметры.Год = Год(ДатаЦен);
	Шапка.Параметры.Стройка 	= СокрЛП(Ссылка.Стройка.Наименование);
	Шапка.Параметры.НомерАкта	= СокрЛП(Ссылка.НомерАкта);
	
	ШапкаТаблицы.Параметры.Заполнить(ПолучитьСтруктуруОбозначенияВалюты(Ссылка));

	ТабличныйДокумент.Вывести(Шапка);
	ТабличныйДокумент.Вывести(ШапкаТаблицы);
	
	Если ТаблицаРесурсов.Количество()=0 Тогда
		ТабличныйДокумент.Вывести(ОбластьНетДанных);
		Возврат;
	КонецЕсли;
	
	Текст = "ВЫБРАТЬ
	|	СМ_НумерацияПозицийЛокальныхСмет.Позиция КАК Позиция,
	|	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	|	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	|	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
	|ПОМЕСТИТЬ НомераРазделовСметы
	|ИЗ
	|	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	|ГДЕ
	|	СМ_НумерацияПозицийЛокальныхСмет.Смета = &ИДРодителя
	|	И НЕ СМ_НумерацияПозицийЛокальныхСмет.Позиция = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПозицияЛокальнойСметы.Ссылка КАК Ссылка,
	|	НомераРазделовСметы.НомерВДереве КАК ПорНомер,
	|	СУММА(ЕСТЬNULL(СМ_СредняяТекущаяСтоимостьПозиции.Стоимость, 0)) КАК Стоимость
	|ПОМЕСТИТЬ ИтоговаяТаблица
	|ИЗ
	|	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СредняяТекущаяСтоимостьПозиции КАК СМ_СредняяТекущаяСтоимостьПозиции
	|		ПО (СМ_СредняяТекущаяСтоимостьПозиции.Позиция = ПозицияЛокальнойСметы.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ НомераРазделовСметы КАК НомераРазделовСметы
	|		ПО ПозицияЛокальнойСметы.Ссылка = НомераРазделовСметы.Позиция
	|ГДЕ
	|	ПозицияЛокальнойСметы.ИДСметы = &ИДРодителя
	|
	|СГРУППИРОВАТЬ ПО
	|	ПозицияЛокальнойСметы.Ссылка,
	|	НомераРазделовСметы.НомерВДереве
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИтоговаяТаблица.Ссылка,
	|	ИтоговаяТаблица.ПорНомер КАК ПорНомер,
	|	ИтоговаяТаблица.Стоимость
	|ИЗ
	|	ИтоговаяТаблица КАК ИтоговаяТаблица
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорНомер";
	
	Запрос = Новый Запрос;
	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("ИДРодителя",Ссылка.ЛокальнаяСмета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ПозицияСметы = Выборка.Ссылка ;
		Если Выборка.Ссылка.ПометкаУдаления = Истина ИЛИ Выборка.Ссылка.Расчет = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		МассивРесурсов = ТаблицаРесурсов.НайтиСтроки(Новый Структура("Позиция",Выборка.Ссылка));
		Если МассивРесурсов.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Номера = СМ_СметаВызовСервера.ПолучитьНомерДокумента(Выборка.Ссылка, "СМ_ПозицияЛокальнойСметы");
		
		ФактОбъем = ПолучитьОбъемПоПозицииАкта(Ссылка,Выборка.Ссылка);
		Если ФактОбъем = 0 Тогда
			Продолжить;
		КонецЕсли;
		ПараметрыПечати.НомерПоПорядкуАкт = ПараметрыПечати.НомерПоПорядкуАкт + 1;	
		
		СтрокаПозиция.Параметры.ПорНомер			= Номера.ПорНомер;
		СтрокаПозиция.Параметры.ШифрРасценки		= СформироватьПолеОбоснование(ПозицияСметы,ПараметрыПечати);
		СтрокаПозиция.Параметры.НаименованиеПозиции = СформироватьНаименованиеПозиции(ПозицияСметы,ПараметрыПечати);
		СтрокаПозиция.Параметры.Измеритель          = Сокрлп(ПозицияСметы.Измеритель);						
		СтрокаПозиция.Параметры.Количество 	= ФактОбъем;
		
		ТабличныйДокумент.Вывести(СтрокаПозиция);
		Для Каждого эл Из МассивРесурсов Цикл
			ОбластьСтрока       			= Макет.ПолучитьОбласть("Ресурсы");
			ОбластьСтрока.Параметры.Заполнить(эл);
			ОбластьСтрока.Параметры.Стоимость = эл.ЦенаТекущая;
			ОбластьСтрока.Параметры.Всего = эл.СтоимостьТекущая;
			ТабличныйДокумент.Вывести(ОбластьСтрока);
		КонецЦикла;
		
	КонецЦикла;	

	
	ТабличныйДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	
КонецПроцедуры	

// Вспомогательная процедура печати.
//
Процедура АктПечатьРесурсная(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати)
	
	КолЗнаков = 2;
	Если Ссылка.ОкруглятьДоРублей = Истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	
	Если ПараметрыПечати.ПечататьСетку Тогда
		ДополнениеОбласти = "Сетка";
	Иначе
		ДополнениеОбласти = "";
	КонецЕсли;
	
	Макет               = УправлениеПечатью.МакетПечатнойФормы("Документ.СМ_АктВыполненныхРабот." + ИмяМакета);
	Шапка				= Макет.ПолучитьОбласть("Шапка");
	ШапкаТаблицы		= Макет.ПолучитьОбласть("ШапкаТаблицы");
	СтрокаРаздела   	= Макет.ПолучитьОбласть("СтрокаРаздел"+ДополнениеОбласти);
	ИтогРаздела   		= Макет.ПолучитьОбласть("ИтогРаздел"+ДополнениеОбласти);
	ИтогСмета   		= Макет.ПолучитьОбласть("ИтогСмета"+ДополнениеОбласти);
	ИтогГлава   		= Макет.ПолучитьОбласть("ИтогГлава"+ДополнениеОбласти);
	СтрокаПозиция   	= Макет.ПолучитьОбласть("СтрокаПозиция"+ДополнениеОбласти);
	
	Если ИмяМакета <> "ПФ_MXL_Акт_ТСН9в" И ИмяМакета <> "ПФ_MXL_Акт_ТСН11а" И ИмяМакета <> "ПФ_MXL_Акт_ТСН11б" Тогда
		ПодГруппа = Макет.ПолучитьОбласть("ПодГруппа"+ДополнениеОбласти);
	КонецЕсли;
	
	Если ИмяМакета = "ПФ_MXL_Акт_ТСН11а" ИЛИ ИмяМакета = "ПФ_MXL_Акт_ТСН11б"  Тогда
		СтрокаПозицияДоп   		= Макет.ПолучитьОбласть("СтрокаПозицияДоп"+ДополнениеОбласти);
		СтрокаПозицияДопФОТ		= Макет.ПолучитьОбласть("СтрокаПозицияДопФОТ"+ДополнениеОбласти);
		ИтогПозиция   			= Макет.ПолучитьОбласть("ИтогПозиция"+ДополнениеОбласти);
		ИтогоПоРасценке 		= Макет.ПолучитьОбласть("ИтогоПоРасценке"+ДополнениеОбласти);
		ИтогРаздел 				= Макет.ПолучитьОбласть("ИтогРаздел"+ДополнениеОбласти);
	КонецЕсли;
	
	Подписи				= Макет.ПолучитьОбласть("Подписи");
	КолонкиПовтора		= Макет.ПолучитьОбласть("ШапкаТаблицы|КолонкиПовтора");
	Стоимости 			= ПолучитьСметныеСтоимости(Ссылка,ПараметрыПечати);
	
	Если Ссылка.ПечататьСогласованоУтверждаю Тогда
		Попытка
			ОбластьСогласованоУтверждаю = Макет.ПолучитьОбласть("СогласованоУтверждаю");
			ВывестиСогласованоУтверждаю(ТабличныйДокумент, Ссылка, ОбластьСогласованоУтверждаю, Стоимости);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Для этого макета еще нет области ""Согласовано/Утверждаю""'"));
		КонецПопытки;
	КонецЕсли;
	
	ВывестиПодписи(ТабличныйДокумент,Ссылка,Подписи,истина);
	
	Шапка.Параметры.Заказчик	= СокрЛП(Ссылка.Заказчик.Наименование);
	Шапка.Параметры.Подрядчик	= Сокрлп(Ссылка.подрядчик.наименование);
	Шапка.Параметры.Стройка 	= СокрЛП(Ссылка.Стройка.Наименование);
	Шапка.Параметры.НомерАкта	= СокрЛП(Ссылка.НомерАкта);
	Шапка.Параметры.ДатаАкта	= Формат(Ссылка.Дата,"ДЛФ=Д");
	Если ИмяМакета <> "ПФ_MXL_Акт_ТСН9в" И ИмяМакета <> "ПФ_MXL_Акт_ТСН11а" И ИмяМакета <> "ПФ_MXL_Акт_ТСН11б" Тогда
		Шапка.Параметры.НомерСметы	= СокрЛП(Ссылка.ЛокальнаяСмета.НомерСметы) + "  " +  СокрЛП(Ссылка.ЛокальнаяСмета.Наименование);
		Шапка.Параметры.Период 		= Формат(Ссылка.ЛокальнаяСмета.Дата,"ДЛФ=Д");
	КонецЕсли;
	Шапка.Параметры.ДатаОт	= Формат(Ссылка.ПериодОт,"ДЛФ=Д");
	Шапка.Параметры.ДатаДо	= Формат(Ссылка.ПериодДо,"ДЛФ=Д");
	
	Если ЗначениеЗаполнено(Ссылка.Договор) Тогда
		Если ИмяМакета = "ПФ_MXL_Акт_12" ИЛИ ИмяМакета = "ПФ_MXL_Акт_14" ИЛИ ИмяМакета = "ПФ_MXL_Акт_НРиСП" ИЛИ ИмяМакета = "ПФ_MXL_Акт_ТСН11а" ИЛИ
			 ИмяМакета = "ПФ_MXL_Акт_ТСН11б" ИЛИ ИмяМакета = "ПФ_MXL_Акт_ТСН9в" ИЛИ ИмяМакета = "ПФ_MXL_КС2" ИЛИ ИмяМакета = "ПФ_MXL_КС2_8_Рес" ИЛИ ИмяМакета = "ПФ_MXL_РМ12_Рес" Тогда 
			Шапка.Параметры.НомерДог 	= Ссылка.Договор.Номер; 
			Шапка.Параметры.ДатаДог		= Ссылка.Договор.Дата;
		ИначеЕсли ИмяМакета = "ПФ_MXL_Акт_12_МОЭ" Тогда
			Шапка.Параметры.Договор = СокрЛП(Ссылка.Договор);
		КонецЕсли;
	КонецЕсли;
	
	// ***************************************
	// ++ AVV Вывод валюты в шапку таблицы
	Если ИмяМакета = "ПФ_MXL_Акт_12" ИЛИ ИмяМакета = "ПФ_MXL_Акт_12_МОЭ" ИЛИ ИмяМакета = "ПФ_MXL_Акт_14" ИЛИ ИмяМакета = "ПФ_MXL_Акт_НРиСП" 
	 ИЛИ ИмяМакета = "ПФ_MXL_Акт_РасчетЗатратНаУплатуНДСприУСН" ИЛИ ИмяМакета = "ПФ_MXL_Акт_ТСН11а" ИЛИ ИмяМакета = "ПФ_MXL_Акт_ТСН11б"
	 ИЛИ ИмяМакета = "ПФ_MXL_Акт_ТСН9в" Тогда
		ШапкаТаблицы.Параметры.Заполнить(ПолучитьСтруктуруОбозначенияВалюты(Ссылка));
	КонецЕсли;
	// -- AVV Вывод валюты в шапку таблицы

	ТабличныйДокумент.Вывести(Шапка);
	ТабличныйДокумент.Вывести(ШапкаТаблицы);
	
	Если ИмяМакета = "ПФ_MXL_Акт_ТСН11а" ИЛИ ИмяМакета = "ПФ_MXL_Акт_ТСН11б" Тогда
		ВывестиРазделы(ТабличныйДокумент,Ссылка.ЛокальнаяСмета,СтрокаРаздела,ИтогРаздел,СтрокаПозиция,"",ПараметрыПечати,"",ИтогоПоРасценке,СтрокаПозицияДопФОТ,ПодГруппа,0);
	Иначе
		ВывестиРазделы(ТабличныйДокумент,Ссылка.ЛокальнаяСмета,СтрокаРаздела,ИтогРаздела,СтрокаПозиция,"",ПараметрыПечати,"","","",Подгруппа,0);
	КонецЕсли;
	
	//ВывестиРазделы(ТабличныйДокумент,Ссылка.ЛокальнаяСмета,СтрокаРаздела,ИтогРаздела,СтрокаПозиция,"",ПараметрыПечати,"","","",Подгруппа,0);
	ВывестиИтогиПоСмете(ТабличныйДокумент,Ссылка,ИтогСмета,ПараметрыПечати);
	ВывестиИтогиПоГлавам(ТабличныйДокумент,Ссылка,ИтогГлава,ПараметрыПечати);
	ВывестиВозвраты(ТабличныйДокумент,Ссылка,ПараметрыПечати,ИтогСмета);
	ВывестиПодписи(ТабличныйДокумент,Ссылка,Подписи,Ложь);
	
	ТабличныйДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	ТабличныйДокумент.ПовторятьПриПечатиСтроки = ТабличныйДокумент.Области.КолонкиПовтора;
	
КонецПроцедуры	

// Вспомогательная процедура печати.
//
Процедура АктПечатьБазисноИндексная(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати)
	
	ИтогПозиция   	= "";
	ИтогГлава 		= "";
	ИтогоПоРасценке = "";	
	КолЗнаков 		= 2;
	
	Если Ссылка.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	
	Если ПараметрыПечати.ПечататьСетку Тогда
		ДополнениеОбласти = "Сетка";
	Иначе
		ДополнениеОбласти = "";
	КонецЕсли;
	
	Макет               = УправлениеПечатью.МакетПечатнойФормы("Документ.СМ_АктВыполненныхРабот." + ИмяМакета);
//	Макет 				= Документы.СМ_АктВыполненныхРабот.ПолучитьМакет(имяМакета);
	Шапка				= Макет.ПолучитьОбласть("Шапка");
	ШапкаТаблицы		= Макет.ПолучитьОбласть("ШапкаТаблицы");
	СтрокаРаздела   	= Макет.ПолучитьОбласть("СтрокаРаздел"+ДополнениеОбласти);
	ИтогРаздела   		= Макет.ПолучитьОбласть("ИтогРаздел"+ДополнениеОбласти);
	ИтогСмета			= Макет.ПолучитьОбласть("ИтогСмета"+ДополнениеОбласти);
	Подписи				= Макет.ПолучитьОбласть("Подписи");
	ИтогГлава		  	= Макет.ПолучитьОбласть("ИтогГлава"+ДополнениеОбласти);
	КолонкиПовтора		= Макет.ПолучитьОбласть("ШапкаТаблицы|КолонкиПовтора");
	
	Если ИмяМакета <> "ПФ_MXL_КС2" И ИмяМакета <> "ПФ_MXL_Акт_ТСН9в" Тогда
		ИтогоПоРасценке = Макет.ПолучитьОбласть("ИтогоПоРасценке"+ДополнениеОбласти);
	КонецЕсли;
	Если ИмяМакета = "ПФ_MXL_КС2" Или ИмяМакета = "ПФ_MXL_Акт_ТСН11а" Или ИмяМакета = "ПФ_MXL_Акт_ТСН11б" Или ИмяМакета = "ПФ_MXL_Акт_ТСН9в" Тогда
		Шапка.Параметры.НомерАкта	= СокрЛП(Ссылка.НомерАкта);
		Шапка.Параметры.ДатаАкта	= Формат(Ссылка.Дата,"ДЛФ=Д");
		Шапка.Параметры.ДатаОт	= Формат(Ссылка.ПериодОт,"ДЛФ=Д");
		Шапка.Параметры.ДатаДо	= Формат(Ссылка.ПериодДо,"ДЛФ=Д");
	КонецЕсли;
	
	СтрокаПозиция  = Макет.ПолучитьОбласть("СтрокаПозиция"+ДополнениеОбласти);
	Если ИмяМакета <> "ПФ_MXL_Акт_ТСН9в" Тогда 
		СтрокаПозицияДоп   	= Макет.ПолучитьОбласть("СтрокаПозицияДоп"+ДополнениеОбласти);
	КонецЕсли;
	
	Если ИмяМакета = "ПФ_MXL_Акт_12_МОЭ" Или  ИмяМакета = "ПФ_MXL_Акт_ТСН11а" Или ИмяМакета = "ПФ_MXL_Акт_ТСН11б" Тогда
		СтрокаПозицияДопФот	= Макет.ПолучитьОбласть("СтрокаПозицияДопФОТ"+ДополнениеОбласти);
	КонецЕсли;
	
	// Заполняем макет.
	Стоимости = ПолучитьСметныеСтоимости(Ссылка,ПараметрыПечати);
	
	Если Ссылка.ПечататьСогласованоУтверждаю Тогда
		Попытка
			ОбластьСогласованоУтверждаю = Макет.ПолучитьОбласть("СогласованоУтверждаю");
			ВывестиСогласованоУтверждаю(ТабличныйДокумент, Ссылка, ОбластьСогласованоУтверждаю, Стоимости);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Для этого макета еще нет области ""Согласовано/Утверждаю""'"));
		КонецПопытки;
	КонецЕсли;
	
	ВывестиПодписи(ТабличныйДокумент,Ссылка,Подписи,истина);
	
	Шапка.Параметры.Заказчик				= СокрЛП(Ссылка.Заказчик.Наименование);
	Шапка.Параметры.Подрядчик				= СокрЛП(Ссылка.Подрядчик.Наименование);
	Шапка.Параметры.НомерАкта				= СокрЛП(Ссылка.НомерАкта);
	Шапка.Параметры.Стройка					= СокрлП(Ссылка.Стройка.Наименование);
	
	Если НЕ ПараметрыПечати.ЭтоКС2 И НЕ ПараметрыПечати.ЭтоМетодикаТСН11а И НЕ ПараметрыПечати.ЭтоМетодикаТСН11б
		И НЕ ПараметрыПечати.ЭтоМетодикаТСН9в Тогда
		Шапка.Параметры.Период 		= Формат(Ссылка.ЛокальнаяСмета.Дата,"ДЛФ=Д");
		Шапка.Параметры.НомерСметы	= СокрЛП(Ссылка.ЛокальнаяСмета.НомерСметы);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка.Договор) Тогда
		Если ИмяМакета = "ПФ_MXL_Акт_12" ИЛИ ИмяМакета = "ПФ_MXL_Акт_14" ИЛИ ИмяМакета = "ПФ_MXL_Акт_НРиСП" ИЛИ ИмяМакета = "ПФ_MXL_Акт_ТСН11а"
			ИЛИ ИмяМакета = "ПФ_MXL_Акт_ТСН11б" ИЛИ ИмяМакета = "ПФ_MXL_Акт_ТСН9в" ИЛИ ИмяМакета = "ПФ_MXL_КС2" ИЛИ ИмяМакета = "ПФ_MXL_КС2_8_Рес" ИЛИ ИмяМакета = "ПФ_MXL_РМ12_Рес" Тогда 
			
			Шапка.Параметры.НомерДог 	= Ссылка.Договор.Номер; 
			Шапка.Параметры.ДатаДог		= Ссылка.Договор.Дата;
			
		ИначеЕсли ИмяМакета = "ПФ_MXL_Акт_12_МОЭ" Тогда
			Шапка.Параметры.Договор = СокрЛП(Ссылка.Договор);
		КонецЕсли;
	КонецЕсли;
	
	// ***************************************
	// ++ AVV Вывод валюты в шапку таблицы
	Если ИмяМакета = "ПФ_MXL_Акт_12" ИЛИ ИмяМакета = "ПФ_MXL_Акт_12_МОЭ" ИЛИ ИмяМакета = "ПФ_MXL_Акт_14" ИЛИ ИмяМакета = "ПФ_MXL_Акт_НРиСП" 
	 ИЛИ ИмяМакета = "ПФ_MXL_Акт_РасчетЗатратНаУплатуНДСприУСН" ИЛИ ИмяМакета = "ПФ_MXL_Акт_ТСН11а" ИЛИ ИмяМакета = "ПФ_MXL_Акт_ТСН11б"
	 ИЛИ ИмяМакета = "ПФ_MXL_Акт_ТСН9в" Тогда
		ШапкаТаблицы.Параметры.Заполнить(ПолучитьСтруктуруОбозначенияВалюты(Ссылка));
	КонецЕсли;
	// -- AVV Вывод валюты в шапку таблицы
	
	ТабличныйДокумент.Вывести(Шапка);
	ТабличныйДокумент.Вывести(ШапкаТаблицы);
	
	ВывестиРазделы(ТабличныйДокумент,Ссылка.ЛокальнаяСмета,СтрокаРаздела,ИтогРаздела,СтрокаПозиция,ИтогПозиция,ПараметрыПечати,СтрокаПозицияДоп,ИтогоПоРасценке,СтрокаПозицияДопФОТ,"",0);
	ВывестиИтогиПоСмете(ТабличныйДокумент,Ссылка,ИтогСмета,ПараметрыПечати);
	
	ВывестиИтогиПоГлавам(ТабличныйДокумент,Ссылка,ИтогГлава,ПараметрыПечати);
	ВывестиВозвраты(ТабличныйДокумент,Ссылка,ПараметрыПечати,ИтогСмета);
	
	ВывестиПодписи(ТабличныйДокумент,Ссылка,Подписи,Ложь);
	ТабличныйДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	ТабличныйДокумент.ПовторятьПриПечатиСтроки = ТабличныйДокумент.Области.КолонкиПовтора;
	
КонецПроцедуры

// Вспомогательная процедура печати.
//
Функция ПроверкаНаСоответствиеПечатнойФормыДокументу(Ссылка,ИмяМакета)
	
	Если ИмяМакета = "ПФ_MXL_ЛС_13ТСН" Или ИмяМакета = "ПФ_MXL_Акт_ТСН9в" Тогда
		Если Ссылка.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный  Тогда
			// Печатается  для базисного метода.
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;

	МетодикаТСН = Ложь;
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		//МетодикаТСН = Ссылка.ЛокальнаяСмета.МетодикаТСН;
		Если Ссылка.ЛокальнаяСмета.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква Тогда
			МетодикаТСН = Истина;	
		КонецЕсли;
	Иначе
		//МетодикаТСН = Ссылка.МетодикаТСН;
		Если Ссылка.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква Тогда
			МетодикаТСН = Истина;	
		КонецЕсли;
	КонецЕсли;
	
	Если МетодикаТСН = Ложь Тогда
		Если ИмяМакета = "ПФ_MXL_ЛС_11ТСН" Или ИмяМакета = "ПФ_MXL_ЛС_12ТСН" Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если Ссылка.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный И Найти(ИмяМакета,"Рес")<> 0  Тогда
			Возврат Ложь;
		КонецЕсли;	
		
		Если Ссылка.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный И Найти(ИмяМакета,"Рес")= 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	Иначе
		// Методика ТСН.
		Если Ссылка.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный И Найти(ИмяМакета,"Рес")<> 0  Тогда
			Возврат Ложь;
		КонецЕсли;	
	КонецЕсли;
	Возврат Истина;
	
КонецФункции	

// Общая функция печати массива документов "Локальная смета".
//
Функция ПечатьЛС(МассивОбъектов, ОбъектыПечати, ИмяМакета) 
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ЛС";
	ТабличныйДокумент.ИспользуемоеИмяФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(МассивОбъектов[0].Наименование,"_");;
	ПервыйДокумент = Истина;
	Для Каждого Ссылка Из МассивОбъектов Цикл
		
		Если НЕ ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПараметрыПечати = ПолучитьПараметрыПечати(Ссылка, ИмяМакета);
		
		Если НЕ ПроверкаНаСоответствиеПечатнойФормыДокументу(Ссылка,ИмяМакета) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбранная печатная форма не соответствует документу !'"));
			Возврат ТабличныйДокумент;
		КонецЕсли;	
		
		Если НЕ ПараметрыПечати.ЭтоРесурсная Тогда
			ПечатьБазисноИндексная(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати);
		Иначе
			ПечатьРесурсная(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати);
		КонецЕсли;	
		
		ПервыйДокумент 		= Ложь;
		НомерСтрокиНачало 	= ТабличныйДокумент.ВысотаТаблицы + 1;
		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
	
КонецФункции	

// Процедура печати документа "Локальная смета" с ресурсным методом расчета.
//	Производит печать конкретного документа в ТабличныйДокумент.
//
Процедура ПечатьРесурсная(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати)
	
	КолЗнаков = 2;
	Если Ссылка.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	
	Если ПараметрыПечати.ПечататьСетку Тогда
		ДополнениеОбласти = "Сетка";
	Иначе
		ДополнениеОбласти = "";
	КонецЕсли;
	
	Макет               = УправлениеПечатью.МакетПечатнойФормы("Документ.СМ_ЛокальнаяСмета."+имяМакета);
	Шапка				= Макет.ПолучитьОбласть("Шапка");
	ШапкаТаблицы		= Макет.ПолучитьОбласть("ШапкаТаблицы");
	СтрокаРаздела   	= Макет.ПолучитьОбласть("СтрокаРаздел"+ДополнениеОбласти);
	ИтогСмета   		= Макет.ПолучитьОбласть("ИтогСмета"+ДополнениеОбласти);
	ИтогГлава   		= Макет.ПолучитьОбласть("ИтогГлава"+ДополнениеОбласти);
	СтрокаПозиция   	= Макет.ПолучитьОбласть("СтрокаПозиция"+ДополнениеОбласти);
	Подписи				= Макет.ПолучитьОбласть("Подписи");
	КолонкиПовтора		= Макет.ПолучитьОбласть("ШапкаТаблицы|КолонкиПовтора");
	
	Если ИмяМакета <> "ПФ_MXL_ЛС_13ТСН" Тогда
		ИтогРаздела = Макет.ПолучитьОбласть("ИтогРаздел"+ДополнениеОбласти);
	Иначе
		ИтогРаздел = Макет.ПолучитьОбласть("ИтогРаздел"+ДополнениеОбласти);
	КонецЕсли;
	
	Если ИмяМакета = "ПФ_MXL_ЛС_11ТСН" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_12ТСН"  Тогда
		СтрокаПозицияДоп   		= Макет.ПолучитьОбласть("СтрокаПозицияДоп"+ДополнениеОбласти);
		СтрокаПозицияДопФОТ		= Макет.ПолучитьОбласть("СтрокаПозицияДопФОТ"+ДополнениеОбласти);
		ИтогПозиция   			= Макет.ПолучитьОбласть("ИтогПозиция"+ДополнениеОбласти);
		ИтогоПоРасценке 		= Макет.ПолучитьОбласть("ИтогоПоРасценке"+ДополнениеОбласти);
		ИтогРаздел 				= Макет.ПолучитьОбласть("ИтогРаздел"+ДополнениеОбласти);
	КонецЕсли;

	Если ИмяМакета <> "ПФ_MXL_ЛС_11ТСН" И ИмяМакета <> "ПФ_MXL_ЛС_12ТСН" И ИмяМакета <> "ПФ_MXL_ЛС_13ТСН" Тогда
		ПодГруппа = Макет.ПолучитьОбласть("ПодГруппа"+ДополнениеОбласти);
	КонецЕсли;
	
	Стоимости = ПолучитьСметныеСтоимости(Ссылка,ПараметрыПечати);
	
	Если Ссылка.ПечататьСогласованоУтверждаю Тогда
		Попытка
			ОбластьСогласованоУтверждаю = Макет.ПолучитьОбласть("СогласованоУтверждаю");
			ВывестиСогласованоУтверждаю(ТабличныйДокумент, Ссылка, ОбластьСогласованоУтверждаю, Стоимости);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Для этого макета еще нет области ""Согласовано/Утверждаю""'"));
		КонецПопытки;
	КонецЕсли;
	
	ВывестиПодписи(ТабличныйДокумент,Ссылка,Подписи,истина);
	
	ТекПодрядчик = Неопределено;
	
	Если ИмяМакета <> "ПФ_MXL_ЛС_11ТСН" И ИмяМакета <> "ПФ_MXL_ЛС_12ТСН" И ИмяМакета <> "ПФ_MXL_ЛС_13ТСН" Тогда
		
		Если ТипЗнч(Ссылка.подрядчик) = Тип("СправочникСсылка.Контрагенты") ИЛИ 
		 	 ТипЗнч(Ссылка.подрядчик) = Тип("СправочникСсылка.Организации") Тогда
			Шапка.Параметры.Подрядчик = Сокрлп(Ссылка.Подрядчик.наименование);
		Иначе 
			Шапка.Параметры.Подрядчик = "";	 
		КонецЕсли;
		
		Если ТипЗнч(Ссылка.Заказчик) = Тип("СправочникСсылка.Контрагенты") ИЛИ 
		 	 ТипЗнч(Ссылка.Заказчик) = Тип("СправочникСсылка.Организации") Тогда
			Шапка.Параметры.Заказчик = Сокрлп(Ссылка.Заказчик.наименование);
		Иначе 
			Шапка.Параметры.Заказчик = "";	 
		КонецЕсли;
		
		Если Ссылка.БазисныеЦены Тогда
			Шапка.Параметры.ДатаЦенСметы = "Составлена в базисном уровне цен.";
		Иначе
			Если ЗначениеЗаполнено(Ссылка.ДатаТекущихЦен) = Ложь Тогда
				Шапка.Параметры.ДатаЦенСметы = "Составлена в уровне текущих (прогнозных) цен по состоянию на " + Формат(Ссылка.Дата,"ДЛФ=Д");
			Иначе	
				Шапка.Параметры.ДатаЦенСметы = "Составлена в уровне текущих (прогнозных) цен по состоянию на " + Формат(Ссылка.ДатаТекущихЦен,"ДЛФ=Д");
			КонецЕсли;	
		КонецЕсли;
		
	Иначе
		Шапка.Параметры.ДатаЦенСметы			= " ";
		Шапка.Параметры.Стройка					= Сокрлп(Ссылка.Стройка.Наименование);
		Если ИмяМакета = "ПФ_MXL_ЛС_13ТСН" Тогда
        	Шапка.Параметры.СметнаяСтоимостьБазис = Окр(Стоимости.СметнаяСтоимостьБазис / 1000,3);
		КонецЕсли;
	КонецЕсли;
	
	Шапка.Параметры.НомерЛС					= СокрЛП(Ссылка.НомерСметы);
	Шапка.Параметры.НаименованиеЛС			= сокрлп(Ссылка.наименование);
	Шапка.Параметры.Основание				= СокрЛП(Ссылка.Основание);
	Шапка.Параметры.СметнаяСтоимость		= Окр(Стоимости.СметнаяСтоимость / 1000,	3);
	
	Если ИмяМакета = "ПФ_MXL_ЛС_7_Рес" ИЛИ  ИмяМакета = "ПФ_MXL_ЛС_9_Рес" Тогда
		Шапка.Параметры.НормативнаяТрудоемкость	= Стоимости.НормативнаяТрудоемкость;
		Шапка.Параметры.СметнаяЗарплата			= Окр(Стоимости.СметнаяЗарплата / 1000,	3);
	КонецЕсли;
	
	Если ИмяМакета = "ПФ_MXL_ЛС_11" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_11_НРиСП" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_12_Рес"
		ИЛИ ИмяМакета = "ПФ_MXL_ЛС_13" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_13_НРиСП" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_7_Рес" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_9_Рес" Тогда
		Шапка.Параметры.ПечДоговор = СокрЛП(Ссылка.Договор);															 
	КонецЕсли;
	
	// ***************************************
	// ++ AVV Вывод валюты в шапку таблицы
	Если ИмяМакета = "ПФ_MXL_ЛС_11" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_11_НРиСП" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_11ТСН" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_12" 
	 ИЛИ ИмяМакета = "ПФ_MXL_ЛС_13" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_13_НРиСП" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_13ТСН" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_7_Рес" 
	 ИЛИ ИмяМакета = "ПФ_MXL_ЛС_9_Рес" Тогда
		Шапка.Параметры.Заполнить(ПолучитьСтруктуруОбозначенияВалюты(Ссылка));
		ШапкаТаблицы.Параметры.Заполнить(ПолучитьСтруктуруОбозначенияВалюты(Ссылка));
	ИначеЕсли ИмяМакета = "ПФ_MXL_ЛС_12_Рес" Тогда 
		Шапка.Параметры.Заполнить(ПолучитьСтруктуруОбозначенияВалюты(Ссылка));
	КонецЕсли;
	// -- AVV Вывод валюты в шапку таблицы
	// ***************************************

	ТабличныйДокумент.Вывести(Шапка);
	ТабличныйДокумент.Вывести(ШапкаТаблицы);
	
	Если ИмяМакета = "ПФ_MXL_ЛС_13ТСН" Тогда
		ВывестиРазделы(ТабличныйДокумент,Ссылка,СтрокаРаздела,ИтогРаздел,СтрокаПозиция,"",ПараметрыПечати,"","","",ПодГруппа,0);	
	ИначеЕсли ИмяМакета = "ПФ_MXL_ЛС_11ТСН" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_12ТСН" Тогда
		ВывестиРазделы(ТабличныйДокумент,Ссылка,СтрокаРаздела,ИтогРаздел,СтрокаПозиция,"",ПараметрыПечати,"",ИтогоПоРасценке,СтрокаПозицияДопФОТ,ПодГруппа,0);
	Иначе
		ВывестиРазделы(ТабличныйДокумент,Ссылка,СтрокаРаздела,ИтогРаздела,СтрокаПозиция,"",ПараметрыПечати,"","","",ПодГруппа,0);	
	КонецЕсли;
	
	ВывестиИтогиПоСмете(ТабличныйДокумент,Ссылка,ИтогСмета,ПараметрыПечати);
	ВывестиИтогиПоГлавам(ТабличныйДокумент,Ссылка,ИтогГлава,ПараметрыПечати);
	ВывестиВозвраты(ТабличныйДокумент,Ссылка,ПараметрыПечати,ИтогСмета);
	
	ВывестиПодписи(ТабличныйДокумент,Ссылка,Подписи,ложь);
	ТабличныйДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	ТабличныйДокумент.ПовторятьПриПечатиСтроки = ТабличныйДокумент.Области.КолонкиПовтора;
	
	// *************************************** 
	// ++ AVV
	ТабличныйДокумент.ТолькоПросмотр = Истина;	
	// -- AVV
	// ***************************************

КонецПроцедуры	

// Процедура печати документа "Локальная смета" с базисно - индексным методом расчета.
//	Производит печать конкретного документа в ТабличныйДокумент.
//
Процедура ПечатьБазисноИндексная(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати)
	
	КолЗнаков = 2;
	Если Ссылка.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	
	// Заполняем макет.
	Если ПараметрыПечати.ПечататьСетку Тогда
		ДополнениеОбласти = "Сетка";
	Иначе
		ДополнениеОбласти = "";
	КонецЕсли;
	
	Макет 					= УправлениеПечатью.МакетПечатнойФормы("Документ.СМ_ЛокальнаяСмета."+имяМакета);
	Шапка					= Макет.ПолучитьОбласть("Шапка");
	ШапкаТаблицы			= Макет.ПолучитьОбласть("ШапкаТаблицы");
	СтрокаРаздела   		= Макет.ПолучитьОбласть("СтрокаРаздел"+ДополнениеОбласти);
	ИтогРаздела   			= Макет.ПолучитьОбласть("ИтогРаздел"+ДополнениеОбласти);
	СтрокаПозиция   		= Макет.ПолучитьОбласть("СтрокаПозиция"+ДополнениеОбласти);
	Если НЕ ИмяМакета = "ПФ_MXL_ЛС_13ТСН"  Тогда
		СтрокаПозицияДоп   		= Макет.ПолучитьОбласть("СтрокаПозицияДоп"+ДополнениеОбласти);
		СтрокаПозицияДопФОТ		= Макет.ПолучитьОбласть("СтрокаПозицияДопФОТ"+ДополнениеОбласти);
		ИтогПозиция   			= Макет.ПолучитьОбласть("ИтогПозиция"+ДополнениеОбласти);
	КонецЕсли;
	ИтогСмета				= Макет.ПолучитьОбласть("ИтогСмета"+ДополнениеОбласти);
	ИтогГлава				= Макет.ПолучитьОбласть("ИтогГлава"+ДополнениеОбласти);
	Подписи					= Макет.ПолучитьОбласть("Подписи");
	КолонкиПовтора			= Макет.ПолучитьОбласть("ШапкаТаблицы|КолонкиПовтора");
	
	Если (ИмяМакета = "ПФ_MXL_ЛС_12") Или (ИмяМакета = "ПФ_MXL_ЛС_11ТСН")  Или (ИмяМакета = "ПФ_MXL_ЛС_12ТСН") Тогда
		ИтогоПоРасценке = Макет.ПолучитьОбласть("ИтогоПоРасценке"+ДополнениеОбласти);
	Иначе
		ИтогоПоРасценке = "";
	КонецЕсли;	
	
	Стоимости = ПолучитьСметныеСтоимости(Ссылка,ПараметрыПечати);
	
	Если Ссылка.ПечататьСогласованоУтверждаю Тогда
		Попытка
			ОбластьСогласованоУтверждаю = Макет.ПолучитьОбласть("СогласованоУтверждаю");
			ВывестиСогласованоУтверждаю(ТабличныйДокумент, Ссылка, ОбластьСогласованоУтверждаю, Стоимости);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Для этого макета еще нет области ""Согласовано/Утверждаю""'"));
		КонецПопытки;
	КонецЕсли;
	
	ВывестиПодписи(ТабличныйДокумент,Ссылка,Подписи,истина);
	
	Если ИмяМакета <> "ПФ_MXL_ЛС_11ТСН" И ИмяМакета <> "ПФ_MXL_ЛС_12ТСН" И ИмяМакета <> "ПФ_MXL_ЛС_13ТСН" Тогда
		Если ТипЗнч(Ссылка.подрядчик) = Тип("СправочникСсылка.Контрагенты") ИЛИ 
		 	 ТипЗнч(Ссылка.подрядчик) = Тип("СправочникСсылка.Организации") Тогда
			Шапка.Параметры.Подрядчик = Сокрлп(Ссылка.Подрядчик.наименование);
		Иначе 
			Шапка.Параметры.Подрядчик = "";	 
		КонецЕсли;
		
		Если ТипЗнч(Ссылка.Заказчик) = Тип("СправочникСсылка.Контрагенты") ИЛИ 
		 	 ТипЗнч(Ссылка.Заказчик) = Тип("СправочникСсылка.Организации") Тогда
			Шапка.Параметры.Заказчик = Сокрлп(Ссылка.Заказчик.наименование);
		Иначе 
			Шапка.Параметры.Заказчик = "";	 
		КонецЕсли;
		
		Шапка.Параметры.НормативнаяТрудоемкость	= Стоимости.НормативнаяТрудоемкость;
	Иначе
		Шапка.Параметры.Стройка					= Сокрлп(ссылка.Стройка.Наименование);
	КонецЕсли;
	
	Шапка.Параметры.НомерЛС					= СокрЛП(Ссылка.НомерСметы);
	Шапка.Параметры.НаименованиеЛС			= сокрлп(Ссылка.наименование);
	Шапка.Параметры.Основание				= СокрЛП(Ссылка.Основание);
	Шапка.Параметры.СметнаяСтоимость		= Окр(Стоимости.СметнаяСтоимость / 1000,	3);
	Если Ссылка.БазисныеЦены Тогда
		Шапка.Параметры.ДатаЦенСметы			= "Составлена в базисном уровне цен.";
	Иначе
		Если ЗначениеЗаполнено(Ссылка.ДатаВыпускаИндексов) = Ложь Тогда
			Шапка.Параметры.ДатаЦенСметы			= "Составлена в ценах на " + Формат(Ссылка.Дата,"ДЛФ=Д");
		Иначе	
			Шапка.Параметры.ДатаЦенСметы			= "Составлена в ценах на " + Формат(Ссылка.ДатаВыпускаИндексов,"ДЛФ=Д");
		КонецЕсли;	
	КонецЕсли;
	Если ИмяМакета <> "ПФ_MXL_ЛС_13ТСН" Тогда
		Шапка.Параметры.СметнаяЗарплата			= Окр(Стоимости.СметнаяЗарплата / 1000,		3);
	ИначеЕсли ИмяМакета = "ПФ_MXL_ЛС_13ТСН" Тогда
		Шапка.Параметры.СметнаяСтоимостьБазис	= Окр(Стоимости.СметнаяСтоимостьБазис / 1000,	3);
		Шапка.Параметры.ДатаЦенСметы			= "";
	КонецЕсли;
	
	Если ИмяМакета = "ПФ_MXL_ЛС_11" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_11_НРиСП" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_12_Рес"
		ИЛИ ИмяМакета = "ПФ_MXL_ЛС_13" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_13_НРиСП" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_7_Рес" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_9_Рес" Тогда
		Шапка.Параметры.ПечДоговор = СокрЛП(Ссылка.Договор);															 
	КонецЕсли;
	
	// ***************************************
	// ++ AVV Вывод валюты в шапку таблицы
	Если ИмяМакета = "ПФ_MXL_ЛС_11" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_11_НРиСП" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_11ТСН" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_12" 
	 ИЛИ ИмяМакета = "ПФ_MXL_ЛС_13" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_13_НРиСП" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_13ТСН" ИЛИ ИмяМакета = "ПФ_MXL_ЛС_7_Рес" 
	 ИЛИ ИмяМакета = "ПФ_MXL_ЛС_9_Рес" Тогда
		СтруктураВалюты = ПолучитьСтруктуруОбозначенияВалюты(Ссылка);
		Шапка.Параметры.Заполнить(СтруктураВалюты);
		ШапкаТаблицы.Параметры.Заполнить(СтруктураВалюты);
	ИначеЕсли ИмяМакета = "ПФ_MXL_ЛС_12_Рес" Тогда 
		Шапка.Параметры.Заполнить(ПолучитьСтруктуруОбозначенияВалюты(Ссылка));
	КонецЕсли;
	// -- AVV Вывод валюты в шапку таблицы
	// ***************************************

	ТабличныйДокумент.Вывести(Шапка);
	ТабличныйДокумент.Вывести(ШапкаТаблицы);
	
	ВывестиРазделы(ТабличныйДокумент,Ссылка,СтрокаРаздела,ИтогРаздела,СтрокаПозиция,ИтогПозиция,ПараметрыПечати,СтрокаПозицияДоп,ИтогоПоРасценке,СтрокаПозицияДопФОТ,"",0);
	ВывестиИтогиПоСмете(ТабличныйДокумент,Ссылка,ИтогСмета,ПараметрыПечати);
	ВывестиИтогиПоГлавам(ТабличныйДокумент,Ссылка,ИтогГлава,ПараметрыПечати);
	ВывестиВозвраты(ТабличныйДокумент,Ссылка,ПараметрыПечати,ИтогСмета);
	ВывестиПодписи(ТабличныйДокумент,Ссылка,Подписи,ложь);
	ТабличныйДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	ТабличныйДокумент.ПовторятьПриПечатиСтроки = ТабличныйДокумент.Области.КолонкиПовтора;
	
	// *************************************** 
	// ++ AVV
	ТабличныйДокумент.ТолькоПросмотр = Истина;	
	// -- AVV
	// ***************************************
	
КонецПроцедуры	

// Формирует печатную форму по шаблону затрат на уплату НДС.
//
Функция ПечатьФормаЗатраНаУплатуНДС(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	ТабличныйДокумент 						= Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб 			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы 	= ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати 	= "ПараметрыПечати";
	
	НДСусн 			= Константы.СМ_НДСусн.Получить();
	УдВесМатерНР	= Константы.СМ_УдВесМатерНР.Получить();
	УдВесМатерНРКС 	= Константы.СМ_УдВесМатерНРКС.Получить();
	УдВесМатерСП 	= Константы.СМ_УдВесМатерСП.Получить();
	
	Для Каждого ТекДокумент Из МассивОбъектов Цикл
		
		ПечНаименование = "";
		Если ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			Макет 			= УправлениеПечатью.МакетПечатнойФормы("Документ.СМ_ЛокальнаяСмета."+имяМакета);
			ПечНаименование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Локальная смета %1 %2'"), ТекДокумент.НомерСметы, ТекДокумент.Наименование);
			ТипРайона       = ТекДокумент.ТипРайона;
		ИначеЕсли ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
			Макет       = УправлениеПечатью.МакетПечатнойФормы("Документ.СМ_АктВыполненныхРабот." + ИмяМакета);
		//	Макет 		= Документы.СМ_АктВыполненныхРабот.ПолучитьМакет(ИмяМакета);
			ТипРайона 	= ТекДокумент.ЛокальнаяСмета.ТипРайона;
			Если ЗначениеЗаполнено(ТекДокумент.ЛокальнаяСмета) Тогда
				ПечНаименование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Локальная смета %1 %2, Акт %3'"), ТекДокумент.ЛокальнаяСмета.НомерСметы, ТекДокумент.ЛокальнаяСмета.Наименование, ТекДокумент.НомерАкта); 
			Иначе	
				ПечНаименование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Акт %1'"), ТекДокумент.НомерАкта); 
			КонецЕсли;
		Иначе
			Возврат ТабличныйДокумент;		
		КонецЕсли;
		
		ОбластьШапка 	= Макет.ПолучитьОбласть("Шапка");
		ОбластьТабЧасть = Макет.ПолучитьОбласть("ТабЧасть");
		ОбластьШапка.Параметры.ПечНаименование = ПечНаименование;
		
		// ***************************************
		// ++ AVV Вывод валюты в шапку таблицы
		ОбластьШапка.Параметры.Заполнить(ПолучитьСтруктуруОбозначенияВалюты(ТекДокумент));
		// -- AVV Вывод валюты в шапку таблицы

		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		ТабНРиСП 		= ПолучитьСуммыНРиСППоЛС(ТекДокумент);
		ТабПоказателей 	= СМ_СметныйСоставВызовСервера.ПолучитьПоказателиПоСмете(ТекДокумент);
		
		Если ТабПоказателей.Количество() > 0 Тогда
			ТекСтрока 										= ТабПоказателей[0];
			ОбластьТабЧасть.Параметры.Материалы 			= ТекСтрока.ТекСтоимМатер;
			ОбластьТабЧасть.Параметры.ОплатаТрудаРабочих    = ТекСтрока.ТекОснЗарплата;
			ОбластьТабЧасть.Параметры.ЗатратыЭММ            = ТекСтрока.ТекЭксплМашин;
			ОбластьТабЧасть.Параметры.ЗарплатаМашинистов    = ТекСтрока.ТекЗарплМашин;
			ОбластьТабЧасть.Параметры.Итого                 = ТекСтрока.ТекПрямЗатраты;
			ОбластьТабЧасть.Параметры.Всего                 = ТекСтрока.ТекПрямЗатраты;
		Иначе
			ОбластьТабЧасть.Параметры.Материалы   			= 0;
			ОбластьТабЧасть.Параметры.ОплатаТрудаРабочих    = 0;
			ОбластьТабЧасть.Параметры.ЗатратыЭММ            = 0;
			ОбластьТабЧасть.Параметры.ЗарплатаМашинистов    = 0;
			ОбластьТабЧасть.Параметры.Итого                 = 0;
			ОбластьТабЧасть.Параметры.Всего                 = 0;
		КонецЕсли;
		
		Если ТабНРиСП.Количество() > 0 Тогда
			//ТекСтрока 									= ТабНРиСП[0];
			//ОбластьТабЧасть.Параметры.НакладныеРасходы    = ТекСтрока.ТекСуммаНРНаОбъем;
			//ОбластьТабЧасть.Параметры.СметнаяПрибыль      = ТекСтрока.ТекСуммаСПНаОбъем;
			//ОбластьТабЧасть.Параметры.ИтогоНРиСП          = ТекСтрока.ТекСуммаНРНаОбъем + ТекСтрока.ТекСуммаСПНаОбъем;
			//ОбластьТабЧасть.Параметры.Всего 				= ОбластьТабЧасть.Параметры.Всего + ТекСтрока.ТекСуммаНРНаОбъем + ТекСтрока.ТекСуммаСПНаОбъем;
			
			ТекСтрока 										= ТабНРиСП[0];
			ОбластьТабЧасть.Параметры.НакладныеРасходы      = ТекСтрока.НР;
			ОбластьТабЧасть.Параметры.СметнаяПрибыль        = ТекСтрока.СП;
			ОбластьТабЧасть.Параметры.ИтогоНРиСП            = ТекСтрока.НР + ТекСтрока.СП;
			ОбластьТабЧасть.Параметры.Всего 				= ОбластьТабЧасть.Параметры.Всего + ТекСтрока.НР + ТекСтрока.СП;
		Иначе
			ОбластьТабЧасть.Параметры.НакладныеРасходы      = 0;
			ОбластьТабЧасть.Параметры.СметнаяПрибыль        = 0;
			ОбластьТабЧасть.Параметры.ИтогоНРиСП            = 0;
		КонецЕсли;
		
		// Вывод НДС.
		НДСМатериалы	= ОКР(ОбластьТабЧасть.Параметры.Материалы * НДСусн / 100,2);
		ПечНДСМатериалы = "" + ОбластьТабЧасть.Параметры.Материалы + " х " + НДСусн + " / 100 = " + НДСМатериалы; 
		
		НДСЭмм			= ОКР((ОбластьТабЧасть.Параметры.ЗатратыЭММ - ОбластьТабЧасть.Параметры.ЗарплатаМашинистов)* НДСусн / 100,2);
		ПечНДСЭмм		= "(" + ОбластьТабЧасть.Параметры.ЗатратыЭММ + " - " + ОбластьТабЧасть.Параметры.ЗарплатаМашинистов + ") х " + НДСусн + " / 100 = " + НДСЭмм;  
		
		Если ТекДокумент.ОкруглятьДоРублей Тогда
			ИтогоНДС = Окр(НДСМатериалы + НДСЭмм,0,1);
		Иначе
			ИтогоНДС = НДСМатериалы + НДСЭмм;	
		КонецЕсли;	
		ПечИтогоНДС	= "" + НДСМатериалы + " + " + НДСЭмм + " = " + ИтогоНДС;
		
		ОбластьТабЧасть.Параметры.НДСМатериалы = ПечНДСМатериалы;
		ОбластьТабЧасть.Параметры.НДСЭмм       = ПечНДСЭмм;
		ОбластьТабЧасть.Параметры.ИтогоНДС     = ПечИтогоНДС;
		
		Если ТипРайона = Перечисления.СМ_ТипыРайонов.НеОтносится Тогда
			НДСпоНР 	= ОКР(ОбластьТабЧасть.Параметры.НакладныеРасходы * УдВесМатерНР * НДСусн / 100,2);
			ПечНДСпоНР  = "" + ОбластьТабЧасть.Параметры.НакладныеРасходы + " х " + УдВесМатерНР + " х " + НДСусн + " / 100 = " + НДСпоНР;
		Иначе
			НДСпоНР   	= ОКР(ОбластьТабЧасть.Параметры.НакладныеРасходы * УдВесМатерНРКС * НДСусн / 100,2);
			ПечНДСпоНР  = "" + ОбластьТабЧасть.Параметры.НакладныеРасходы + " х " + УдВесМатерНРКС + " х " + НДСусн + " / 100 = " + НДСпоНР;
		КонецЕсли;
		
		ОбластьТабЧасть.Параметры.НДСпоНР = ПечНДСпоНР; 
		
		НДСпоСП   	= ОКР(ОбластьТабЧасть.Параметры.СметнаяПрибыль * УдВесМатерСП * НДСусн / 100,2);
		ПечНДСпоСП  = "" + ОбластьТабЧасть.Параметры.СметнаяПрибыль + " х " + УдВесМатерСП + " х " + НДСусн + " / 100 = " + НДСпоСП;
		
		Если ТекДокумент.ОкруглятьДоРублей Тогда
			ИтогоНДСпоНРиСП = Окр(НДСпоНР + НДСпоСП,0,1);
		Иначе
			ИтогоНДСпоНРиСП = НДСпоНР + НДСпоСП;	
		КонецЕсли;
		ПечИтогоНДСпоНРиСП  = "" + НДСпоНР + " + " + НДСпоСП + " = " + ИтогоНДСпоНРиСП;
		
		ВсегоНДС 	= ИтогоНДС + ИтогоНДСпоНРиСП;
		ПечВсегоНДС = "" + ИтогоНДС + " + " + ИтогоНДСпоНРиСП + " = " + ВсегоНДС;
		
		ОбластьТабЧасть.Параметры.НДСпоСП               = ПечНДСпоСП;
		ОбластьТабЧасть.Параметры.ИтогоНДСпоНРиСП       = ПечИтогоНДСпоНРиСП;
		ОбластьТабЧасть.Параметры.ВсегоНДС 		        = ПечВсегоНДС;
		
		ПечИтогоНДСвПроц = 0;
		Если (ОбластьТабЧасть.Параметры.Итого + ОбластьТабЧасть.Параметры.НакладныеРасходы  + ОбластьТабЧасть.Параметры.СметнаяПрибыль) > 0 Тогда
			ПечИтогоНДСвПроц = (ВсегоНДС) / (ОбластьТабЧасть.Параметры.Итого + ОбластьТабЧасть.Параметры.НакладныеРасходы  + ОбластьТабЧасть.Параметры.СметнаяПрибыль) * 100;
		КонецЕсли;
		ОбластьТабЧасть.Параметры.ИтогоНДСвПроц = "" + Формат(ВсегоНДС,"ЧЦ=20; ЧДЦ=2") + " или " + Формат(ПечИтогоНДСвПроц,"ЧЦ=10; ЧДЦ=2") + "%"; 
		
		Если ТекДокумент.ОкруглятьДоРублей Тогда
			ОбластьТабЧасть.Параметры.Итого				= Окр(ОбластьТабЧасть.Параметры.Итого,0,1);	
			ОбластьТабЧасть.Параметры.ИтогоНРиСП	    = Окр(ОбластьТабЧасть.Параметры.ИтогоНРиСП,0,1);
			ОбластьТабЧасть.Параметры.Всего             = Окр(ОбластьТабЧасть.Параметры.Всего,0,1);
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьТабЧасть);
		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
	
КонецФункции	

// Общая функция печати массива документов "Локальная смета" для КЗ.
//
Функция ПечатьЛС_КЗ(МассивОбъектов, ОбъектыПечати, ИмяМакета) 
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ЛС";
	ТабличныйДокумент.ИспользуемоеИмяФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(МассивОбъектов[0].Наименование,"_");;
	
	// ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбранная печатная форма в разработке !'"));
	// Возврат ТабличныйДокумент;

	ПервыйДокумент = Истина;
	Для Каждого Ссылка Из МассивОбъектов Цикл
		
		Если НЕ ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПараметрыПечати = ПолучитьПараметрыПечати(Ссылка, ИмяМакета);
		
		Если ИмяМакета = "ПФ_MXL_СМ_КЗ_ЛС_2_Рес" Тогда
			ПараметрыПечати.РазвернутыйОтчет = Ложь;
		Иначе
			ПараметрыПечати.РазвернутыйОтчет = Истина;
		КонецЕсли;
		
		Если НЕ ПроверкаНаСоответствиеПечатнойФормыДокументу(Ссылка,ИмяМакета) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбранная печатная форма не соответствует документу !'"));
			Возврат ТабличныйДокумент;
		КонецЕсли;	
		
		Если Не ПараметрыПечати.ЭтоРесурсная Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбранная печатная форма не соответствует документу !'"));
			Возврат ТабличныйДокумент;
		КонецЕсли;	
		
		ПечатьРесурсная_КЗ(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати);
		
		ПервыйДокумент 		= Ложь;
		НомерСтрокиНачало 	= ТабличныйДокумент.ВысотаТаблицы + 1;
		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
	
КонецФункции	

// Процедура печати документа "Локальная смета" с ресурсным методом расчета для КЗ.
//	Производит печать конкретного документа в ТабличныйДокумент.
//
Процедура ПечатьРесурсная_КЗ(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати)
	
	КолЗнаков = 2;
	Если Ссылка.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	
	Если ПараметрыПечати.ПечататьСетку Тогда
		ДополнениеОбласти = "Сетка";
	Иначе
		ДополнениеОбласти = "";
	КонецЕсли;

	Макет               = УправлениеПечатью.МакетПечатнойФормы("Документ.СМ_ЛокальнаяСмета."+имяМакета);
	Шапка				= Макет.ПолучитьОбласть("Шапка");
	ШапкаТаблицы		= Макет.ПолучитьОбласть("ШапкаТаблицы");
	СтрокаРаздела   	= Макет.ПолучитьОбласть("СтрокаРаздел"+ДополнениеОбласти);
	СтрокаПозиция   	= Макет.ПолучитьОбласть("СтрокаПозиция"+ДополнениеОбласти);
	СтрокаРесурса       = Макет.ПолучитьОбласть("СтрокаРесурса"+ДополнениеОбласти);
	ИтогРаздела   	    = Макет.ПолучитьОбласть("ИтогРаздел"+ДополнениеОбласти);
	ИтогВидРесурса      = Макет.ПолучитьОбласть("ИтогВидРесурса"+ДополнениеОбласти);
	ИтогНРиСП           = Макет.ПолучитьОбласть("ИтогНРиСП"+ДополнениеОбласти);
	ИтогоПрямыеЗатраты  = Макет.ПолучитьОбласть("ИтогоПрямыеЗатраты");
	ИтогСмета   		= Макет.ПолучитьОбласть("ИтогСмета");
	Подписи             = Макет.ПолучитьОбласть("Подписи");
	ИтогГлава   		= Макет.ПолучитьОбласть("ИтогГлава"+ДополнениеОбласти);
	
	Стоимости = ПолучитьСметныеСтоимости(Ссылка,ПараметрыПечати);
	
	Если Ссылка.ПечататьСогласованоУтверждаю Тогда
		Попытка
			ОбластьСогласованоУтверждаю = Макет.ПолучитьОбласть("СогласованоУтверждаю");
			ВывестиСогласованоУтверждаю(ТабличныйДокумент, Ссылка, ОбластьСогласованоУтверждаю, Стоимости);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Для этого макета еще нет области ""Согласовано/Утверждаю""'"));
		КонецПопытки;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка.ДатаТекущихЦен) = Ложь Тогда
		Шапка.Параметры.ДатаЦенСметы			= Формат(Ссылка.Дата,"ДФ='к ""квартал"" гггг ""г.""'");
	Иначе	
		Шапка.Параметры.ДатаЦенСметы			= Формат(Ссылка.ДатаТекущихЦен,"ДФ='к ""квартал"" гггг ""г.""'");
	КонецЕсли;	
	Шапка.Параметры.Стройка					= Сокрлп(ссылка.Стройка.Наименование);
	Шапка.Параметры.НомерОбъекта	        = Сокрлп(ссылка.Стройка.НомерОбъекта);
	
	Шапка.Параметры.НомерЛС					= СокрЛП(Ссылка.НомерСметы);
	Шапка.Параметры.НаименованиеЛС			= сокрлп(Ссылка.наименование);
	Шапка.Параметры.Основание				= СокрЛП(Ссылка.Основание);
	Шапка.Параметры.СметнаяСтоимость		= Окр(Стоимости.СметнаяСтоимость / 1000,	3);
	Шапка.Параметры.НормативнаяТрудоемкость	= Окр(Стоимости.НормативнаяТрудоемкость / 1000,	3);
	Шапка.Параметры.СметнаяЗарплата			= Окр(Стоимости.СметнаяЗарплата / 1000,	3);
	
	Шапка.Параметры.Заполнить(ПолучитьСтруктуруОбозначенияВалюты(Ссылка));
	ШапкаТаблицы.Параметры.Заполнить(ПолучитьСтруктуруОбозначенияВалюты(Ссылка));

	ТабличныйДокумент.Вывести(Шапка);
	ТабличныйДокумент.Вывести(ШапкаТаблицы);
	
	ВывестиРазделы_КЗ(ТабличныйДокумент,Ссылка,СтрокаРаздела,ИтогРаздела,СтрокаПозиция,СтрокаРесурса,ПараметрыПечати,ИтогВидРесурса,0,ИтогНРиСП);
	ВывестиИтогиПоСмете_КЗ(ТабличныйДокумент,Ссылка,ИтогСмета,ИтогоПрямыеЗатраты,ПараметрыПечати);
	ВывестиИтогиПоГлавам_КЗ(ТабличныйДокумент,Ссылка,ИтогГлава,ПараметрыПечати);
	ТабличныйДокумент.Вывести(Подписи);

	ТабличныйДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	
КонецПроцедуры	

// Печать ОБЪЕКТНОЙ или ЛОКАЛЬНОЙ сметы.
//	Формирование параметров печати и табличного документа.
//
// Параметры:
//     МассивОбъектов 	- Массив - содержит документы СМ_ОбъектнаяСмета к печати.
//     ОбъектыПечати 	- Массив - список объектов печати (для стандартной подсистемы).
//     ИмяМакета 		- Строка - имя макета.
//
// Возвращаемое значение:
//     ТабличныйДокумент - ТабличныйДокумент - содержит печатную форму объектной сметы.
//
Функция ПечатьФорма4(МассивОбъектов, ОбъектыПечати, ИмяМакета) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ПервыйДокумент = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_Форма4";
	                  
	Для Каждого Ссылка Из МассивОбъектов Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПараметрыПечати = Новый Структура;
		ПараметрыПечати.Вставить("ОкруглятьДоРублей",			Ложь);
		ПараметрыПечати.Вставить("ВБазисныхЦенах",				Ссылка.БазисныеЦены);
		ПараметрыПечати.Вставить("СметаСсылка",			 		Ссылка);
		
		ВыводФорма4(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати);
		
		ПервыйДокумент 		= Ложь;
		НомерСтрокиНачало 	= ТабличныйДокумент.ВысотаТаблицы + 1;
		
	КонецЦикла;	    
	
	Возврат ТабличныйДокумент; 
	
КонецФункции

#КонецОбласти

#Область ВыводДанныхВТабличныйДокумент

// Формирование и вывод областей табличного документа.
Процедура ВыводФорма4(Ссылка,ТабличныйДокумент,ИмяМакета,ПараметрыПечати)
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		СписокСмет = Ссылка.ЛокальныеСметы.ВыгрузитьКолонку("ЛокальнаяСмета");
	Иначе
		СписокСмет = Новый Массив;		
		СписокСмет.Добавить(Ссылка);
	КонецЕсли;
	
	Если СписокСмет.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	

	
	КолЗнаков = 2;
	
	Если КолЗнаков = 1 Тогда
		СтрокаФормата = "ЧДЦ=1";
	ИначеЕсли КолЗнаков = 2 Тогда
		СтрокаФормата = "ЧДЦ=2";
	ИначеЕсли КолЗнаков = 3 Тогда
		СтрокаФормата = "ЧДЦ=3";
	Иначе
		СтрокаФормата = "ЧДЦ=0";
	КонецЕсли;
	
	// Заполняем макет.
	Макет 					= ПолучитьОбщийМакет("ПФ_MXL_Макет_Форма4");
	ОбластьЗаголовок		= Макет.ПолучитьОбласть("Заголовок");
	Шапка					= Макет.ПолучитьОбласть("Шапка");
	ПодШапка				= Макет.ПолучитьОбласть("ПодШапка");
	Итог					= Макет.ПолучитьОбласть("Итог");
	
	Подписи					= Макет.ПолучитьОбласть("Подписи");
	КолонкиПовтора			= Макет.ПолучитьОбласть("Шапка|КолонкиПовтора");
	
	ОбластьЗаголовок.Параметры.ТекстЗаголовка					= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Сметный расчет № %1'"), СокрЛП(Ссылка.НомерСметы));
	ОбластьЗаголовок.Параметры.Стройка					        = Сокрлп(Ссылка.Стройка.Наименование);
	//ОбластьЗаголовок.Параметры.Объект					        = Сокрлп(Ссылка.Стройка.НомерОбъекта);
	//ОбластьЗаголовок.Параметры.ШифрСтройка					    = Сокрлп(Ссылка.Стройка.Наименование);
	ОбластьЗаголовок.Параметры.ШифрОбъект					    = Сокрлп(Ссылка.Стройка.НомерОбъекта);
	ТабличныйДокумент.Вывести(ОбластьЗаголовок);
	
	Шапка.Параметры.Заполнить(СМ_СметаПечатьСервер.ПолучитьСтруктуруОбозначенияВалюты(Ссылка));
	ТабличныйДокумент.Вывести(Шапка);
	
	ТабличныйДокумент.Вывести(ПодШапка);

	ДанныеВывода = СобратьДанныеПоСметеФорма4(СписокСмет,ПараметрыПечати);
	
	сч = 1;
	
	Стоимость = 0;
	
	Для Каждого стр Из ДанныеВывода Цикл
		
		СтрокаЛС = Макет.ПолучитьОбласть("Строка");
		
		ЗаполнитьОбластьПозицииФорма4(стр,СтрокаЛС,ПараметрыПечати,КолЗнаков,СтрокаФормата,Стоимость);
		
		СтрокаЛС.Параметры.НомерПП = сч;
		
		ТабличныйДокумент.Вывести(СтрокаЛС);
		
		сч = сч + 1;
	КонецЦикла;
	
	Итог.Параметры.Стоимость =  Формат(Стоимость,СтрокаФормата);
	
	ТабличныйДокумент.Вывести(Итог);
	
	ВывестиПодписи(ТабличныйДокумент,Ссылка,Подписи,Ложь);
	ТабличныйДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	ТабличныйДокумент.ПовторятьПриПечатиСтроки = ТабличныйДокумент.Области.КолонкиПовтора;

КонецПроцедуры	

Процедура ЗаполнитьОбластьПозицииФорма4(Данные,ОбластьПозиции,ПараметрыПечати,КолЗнаков,СтрокаФормата,Стоимость)
	
	//Стоимости = ПолучитьЕдиничныеСтоимостиПозиции(Данные.Ссылка,ПараметрыПечати,Ложь);
	Стоимости = ПолучитьСтоимостиПозиции(Данные.Ссылка,ПараметрыПечати,Ложь,"СМ_БазиснаяЕдиничнаяСтоимостьПозицииСПоправками");
	
	ОбластьПозиции.Параметры.НомерСметы = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='№ %1,п.%2'"), СокрЛП(Данные.НомерСметы),СокрЛП(Данные.ПорНомер));
	ОбластьПозиции.Параметры.Обоснование = СокрЛП(Данные.Ссылка.ШифрРасценки);
	ОбластьПозиции.Параметры.Наименование = СокрЛП(Данные.Ссылка.Наименование);
	ОбластьПозиции.Параметры.Единица = СокрЛП(Данные.Ссылка.Измеритель);
	ОбластьПозиции.Параметры.Количество = Данные.Ссылка.ОбъемРабот;
	ОбластьПозиции.Параметры.СтоимостьЕд = Формат(Окр(Стоимости.ТекСтоимОборуд,	КолЗнаков),СтрокаФормата);
	ОбластьПозиции.Параметры.СтоимостьВсего = Формат(Окр(Стоимости.ТекСтоимОборуд	* Данные.Ссылка.ОбъемРабот,	КолЗнаков),СтрокаФормата);
	ОбластьПозиции.Параметры.Масса = Данные.Ссылка.МассаБрутто * Данные.Ссылка.ОбъемРабот;
	
	Стоимость = Стоимость + Окр(Стоимости.ТекСтоимОборуд	* Данные.Ссылка.ОбъемРабот,	КолЗнаков);
	
КонецПроцедуры	

Функция СобратьДанныеПоСметеФорма4(ИдРодителя,ПараметрыПечати)
	
	Определитель = Новый Массив;
	Определитель.Добавить(Справочники.СМ_Определители.НайтиПоКоду("39"));
	Определитель.Добавить(Справочники.СМ_Определители.НайтиПоКоду("40"));
	Определитель.Добавить(Справочники.СМ_Определители.НайтиПоКоду("41"));
	Определитель.Добавить(Справочники.СМ_Определители.НайтиПоКоду("42"));
	
	Текст = "ВЫБРАТЬ
	        |	СМ_НумерацияПозицийЛокальныхСмет.Позиция КАК Позиция,
	        |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве КАК НомерВДереве,
	        |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы КАК НомерВПределахСметы,
	        |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер КАК ПорНомер
	        |ПОМЕСТИТЬ НомераРазделовСметы
	        |ИЗ
	        |	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	        |ГДЕ
	        |	СМ_НумерацияПозицийЛокальныхСмет.Смета В(&ИДРодителя)
	        |	И НЕ СМ_НумерацияПозицийЛокальныхСмет.Позиция = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ПозицияЛокальнойСметы.Ссылка КАК Ссылка,
	        |	НомераРазделовСметы.ПорНомер КАК ПорНомер,
	        |	СУММА(ЕСТЬNULL(СМ_СредняяТекущаяСтоимостьПозиции.Стоимость, 0)) КАК Стоимость
	        |ПОМЕСТИТЬ ИтоговаяТаблица
	        |ИЗ
	        |	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СредняяТекущаяСтоимостьПозиции КАК СМ_СредняяТекущаяСтоимостьПозиции
	        |		ПО (СМ_СредняяТекущаяСтоимостьПозиции.Позиция = ПозицияЛокальнойСметы.Ссылка)
	        |		ЛЕВОЕ СОЕДИНЕНИЕ НомераРазделовСметы КАК НомераРазделовСметы
	        |		ПО ПозицияЛокальнойСметы.Ссылка = НомераРазделовСметы.Позиция
	        |ГДЕ
	        |	ПозицияЛокальнойСметы.ИДСметы В(&ИДРодителя)
	        |	И Не ПозицияЛокальнойСметы.ПометкаУдаления
	        |	И ПозицияЛокальнойСметы.Расчет
	        |	И ПозицияЛокальнойСметы.Определитель В(&Определитель)
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ПозицияЛокальнойСметы.Ссылка,
	        |	НомераРазделовСметы.Порномер
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ИтоговаяТаблица.Ссылка КАК Ссылка,
	        |	ИтоговаяТаблица.ПорНомер КАК ПорНомер,
	        |	ИтоговаяТаблица.Стоимость КАК Стоимость,
	        |	ИтоговаяТаблица.Ссылка.ИДСметы.НомерСметы КАК НомерСметы
	        |ИЗ
	        |	ИтоговаяТаблица КАК ИтоговаяТаблица
	        |
	        |УПОРЯДОЧИТЬ ПО
	        |	НомерСметы,
	        |	ПорНомер";
	
	Запрос = Новый Запрос;
	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("ИДРодителя",ИдРодителя);
	Запрос.УстановитьПараметр("Определитель",Определитель);
	
	Возврат Запрос.Выполнить().Выгрузить();	
	
КонецФункции

// Процедура выводит в ТабличныйДокумент разделы документа "Локальная смета".
//
Процедура ВывестиРазделы_КЗ(ТабличныйДокумент,ИдРодителя,СтрокаРаздела,ИтогРаздела,СтрокаПозиция,СтрокаРесурса,ПараметрыПечати,ИтогВидРесурса,НомерРаздела,ИтогНРиСП)
	
	ПечатьАкта = Ложь;
	
	Текст = "ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА СМ_НумерацияПозицийЛокальныхСмет.Позиция <> ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	               |			ТОГДА СМ_НумерацияПозицийЛокальныхСмет.Позиция
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел <> ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка)
	               |					ТОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел
	               |				ИНАЧЕ СМ_НумерацияПозицийЛокальныхСмет.Смета
	               |			КОНЕЦ
	               |	КОНЕЦ КАК Документ,
	               |	ВЫБОР
	               |		КОГДА СМ_НумерацияПозицийЛокальныхСмет.Позиция <> ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	               |			ТОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА СМ_НумерацияПозицийЛокальныхСмет.Раздел <> ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка)
	               |					ТОГДА СМ_НумерацияПозицийЛокальныхСмет.Смета
	               |				ИНАЧЕ НЕОПРЕДЕЛЕНО
	               |			КОНЕЦ
	               |	КОНЕЦ КАК Родитель,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
	               |ПОМЕСТИТЬ НомераРазделовСметы
	               |ИЗ
	               |	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |ГДЕ
	               |	#условие#
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РазделЛокальнойСметы.Ссылка КАК Ссылка,
	               |	НомераРазделовСметы.НомерВДереве КАК ПорНомер,
	               |	СУММА(ЕСТЬNULL(СМ_СредняяТекущаяСтоимостьПозиции.Стоимость, 0)) КАК Стоимость
	               |ПОМЕСТИТЬ ИтоговаяТаблица
	               |ИЗ
	               |	Документ.СМ_РазделЛокальнойСметы КАК РазделЛокальнойСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СредняяТекущаяСтоимостьПозиции КАК СМ_СредняяТекущаяСтоимостьПозиции
	               |		ПО (СМ_СредняяТекущаяСтоимостьПозиции.Раздел = РазделЛокальнойСметы.Ссылка)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ НомераРазделовСметы КАК НомераРазделовСметы
	               |		ПО (НомераРазделовСметы.Документ = РазделЛокальнойСметы.Ссылка)
	               |ГДЕ
	               |	РазделЛокальнойСметы.ИДРодителя = &ИДРодителя
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	НомераРазделовСметы.НомерВДереве,
	               |	РазделЛокальнойСметы.Ссылка
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	ПозицияЛокальнойСметы.Ссылка,
	               |	НомераРазделовСметы.НомерВДереве,
	               |	СУММА(ЕСТЬNULL(СМ_СредняяТекущаяСтоимостьПозиции.Стоимость, 0))
	               |ИЗ
	               |	НомераРазделовСметы КАК НомераРазделовСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_СредняяТекущаяСтоимостьПозиции КАК СМ_СредняяТекущаяСтоимостьПозиции
	               |			ПО (СМ_СредняяТекущаяСтоимостьПозиции.Позиция = ПозицияЛокальнойСметы.Ссылка)
	               |		ПО НомераРазделовСметы.Документ = ПозицияЛокальнойСметы.Ссылка
	               |			И НомераРазделовСметы.Родитель = ПозицияЛокальнойСметы.ИДРодителя
	               |ГДЕ
	               |	ПозицияЛокальнойСметы.ИДРодителя = &ИДРодителя
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПозицияЛокальнойСметы.Ссылка,
	               |	НомераРазделовСметы.НомерВДереве
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИтоговаяТаблица.Ссылка,
	               |	ИтоговаяТаблица.ПорНомер КАК ПорНомер,
	               |	ИтоговаяТаблица.Стоимость
	               |ИЗ
	               |	ИтоговаяТаблица КАК ИтоговаяТаблица
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПорНомер";
	
	Запрос = Новый Запрос;
	Если ТипЗнч(ИдРодителя) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		Текст = СтрЗаменить(Текст,"#условие#","СМ_НумерацияПозицийЛокальныхСмет.Смета = &ИДРодителя И СМ_НумерацияПозицийЛокальныхСмет.Позиция = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)");	
	Иначе
		Текст = СтрЗаменить(Текст,"#условие#","СМ_НумерацияПозицийЛокальныхСмет.Смета = &Смета");	
		Запрос.УстановитьПараметр("Смета",ИдРодителя.ИдСметы);
	КонецЕсли;

	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("ИДРодителя",ИдРодителя);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Ссылка.ПометкаУдаления = Истина ИЛИ Выборка.Ссылка.Расчет = Ложь Тогда
			Продолжить;
		КонецЕсли;	
		
		Если ТипЗнч(Выборка.Ссылка) = тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			
			Если ПараметрыПечати.ПечататьЗаголовкиРазделов Тогда
				ТекстПорНомера	= "";
				ТекРаздел = Выборка.Ссылка;
				Если ТипЗнч(ТекРаздел) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
					Если ТекРаздел.ИДРодителя = ТекРаздел.ИДСметы Тогда
						НомерРаздела = НомерРаздела + 1;
						ТекстПорНомера 	= Строка(НомерРаздела)+".";
						СтрокаРаздела.Параметры.НаименованиеРаздела = "Раздел "+ТекстПорНомера +" "+СокрЛП(выборка.ссылка.НаименованиеДляПечати);
					Иначе
						СтрокаРаздела.Параметры.НаименованиеРаздела = "Подраздел  " + СокрЛП(выборка.ссылка.НаименованиеДляПечати);
					КонецЕсли;
					
					ТабличныйДокумент.Вывести(СтрокаРаздела);
				КонецЕсли;
			КонецЕсли;
			
			ВывестиРазделы_КЗ(ТабличныйДокумент,Выборка.Ссылка,СтрокаРаздела,итогРаздела,СтрокаПозиция,СтрокаРесурса,ПараметрыПечати,ИтогВидРесурса,НомерРаздела,ИтогНРиСП);
			
			Если ПараметрыПечати.ПечататьЗаголовкиРазделов И ПараметрыПечати.ПечататьИтогиПоРазделам <> Перечисления.СМ_ПечатьИтоговРаздела.НеПечатать Тогда
				Если ПараметрыПечати.ПечататьИтогиПоРазделам = Перечисления.СМ_ПечатьИтоговРаздела.ПечататьПервые И ТипЗнч(ИдРодителя) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
					ВывестиИтогиРаздела_КЗ(ТабличныйДокумент,Выборка.Ссылка,ИтогРаздела,ПараметрыПечати,ИдРодителя,НомерРаздела);
					ВывестиИтогиВидРаздела_КЗ(ТабличныйДокумент,Выборка.Ссылка,ИтогРаздела,ПараметрыПечати,ИдРодителя,НомерРаздела);
					ВывестиИтогиВозвратРаздела_КЗ(ТабличныйДокумент,Выборка.Ссылка,ИтогРаздела,ПараметрыПечати,ИдРодителя,НомерРаздела);
				ИначеЕсли ПараметрыПечати.ПечататьИтогиПоРазделам = Перечисления.СМ_ПечатьИтоговРаздела.ПечататьВсе Тогда
					ВывестиИтогиРаздела_КЗ(ТабличныйДокумент,Выборка.Ссылка,ИтогРаздела,ПараметрыПечати,ИдРодителя,НомерРаздела);
					ВывестиИтогиВидРаздела_КЗ(ТабличныйДокумент,Выборка.Ссылка,ИтогРаздела,ПараметрыПечати,ИдРодителя,НомерРаздела);
					ВывестиИтогиВозвратРаздела_КЗ(ТабличныйДокумент,Выборка.Ссылка,ИтогРаздела,ПараметрыПечати,ИдРодителя,НомерРаздела);
				КонецЕсли;	
			КонецЕсли;
			
		Иначе
			
			ВывестиСтрокуПозицииРесурснойСметы_КЗ(Выборка.Ссылка,ТабличныйДокумент,СтрокаПозиция,СтрокаРесурса,ПараметрыПечати,ИтогНРиСП,ИтогВидРесурса,Выборка.Ссылка.ИДСметы);
			
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры	

// Выводим итоги раздела по ресурсному методу счета.
//
Процедура ВывестиИтогиРаздела_КЗ(ТабличныйДокумент,Раздел,ИтогРаздела,ПараметрыПечати,РодительРаздел,НомерРаздела)
	
	ПечатьАкта = Ложь;
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	СтрокаФормата = ?(КолЗнаков = 0, "ЧДЦ=0","ЧДЦ=2");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИтогиПоРазделу.Итог,
	               |	СУММА(ИтогиПоРазделу.ТекПрямЗатраты) КАК ТекПрямЗатраты,
	               |	СУММА(ИтогиПоРазделу.ПрямЗатраты) КАК ПрямЗатраты,
	               |	СУММА(ИтогиПоРазделу.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
	               |	СУММА(ИтогиПоРазделу.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
	               |	СУММА(ИтогиПоРазделу.ТекОснЗарплата) КАК ТекОснЗарплата,
	               |	СУММА(ИтогиПоРазделу.ТекЭксплМашин) КАК ТекЭксплМашин,
	               |	СУММА(ИтогиПоРазделу.ТекЗарплМашин) КАК ТекЗарплМашин,
	               |	СУММА(ИтогиПоРазделу.ТекСтоимМатер) КАК ТекСтоимМатер,
	               |	СУММА(ИтогиПоРазделу.ТекОборуд) КАК ТекОборуд,
	               |	СУММА(ИтогиПоРазделу.ТекВозвратМатер) КАК ТекВозвратМатер,
	               |	СУММА(ИтогиПоРазделу.ОснЗарплата) КАК ОснЗарплата,
	               |	СУММА(ИтогиПоРазделу.ЭксплМашин) КАК ЭксплМашин,
	               |	СУММА(ИтогиПоРазделу.ЗарплМашин) КАК ЗарплМашин,
	               |	СУММА(ИтогиПоРазделу.СтоимМатер) КАК СтоимМатер,
	               |	СУММА(ИтогиПоРазделу.Оборуд) КАК Оборуд,
	               |	СУММА(ИтогиПоРазделу.ВозвратМатер) КАК ВозвратМатер
	               |ИЗ
	               |	РегистрСведений.СМ_ИтогиПоРазделу КАК ИтогиПоРазделу
	               |ГДЕ
	               |	ИтогиПоРазделу.Раздел = &Раздел
	               |	И ИтогиПоРазделу.Смета = &Смета
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИтогиПоРазделу.Итог
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИтогиПоРазделу.Итог.ПорядковыйНомер";
	Запрос.УстановитьПараметр("Раздел",Раздел);	
	Запрос.УстановитьПараметр("Смета",ПараметрыПечати.СметаСсылка);
	
	ТекВозвратМатер = 0; 
	ВозвратМатер = 0; 
	
	ПеременныеДляПовтора = ИнициализироватьПеременныеДляПовтораИтогов();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Итог = Справочники.СМ_ИтогиПоРазделу.ИтогоСИндексКОборуд ИЛИ выборка.Итог = Справочники.СМ_ИтогиПоРазделу.ИтогоСИндексКЭлемЗатрат
			Или Выборка.Итог = Справочники.СМ_ИтогиПоРазделу.ОЗвНаклРасходах ИЛИ Выборка.Итог = Справочники.СМ_ИтогиПоРазделу.ТРвНаклРасходах 
			Или Выборка.Итог = Справочники.СМ_ИтогиПоРазделу.ИтогоСУчетомНаклРасх ИЛИ Выборка.Итог = Справочники.СМ_ИтогиПоРазделу.НаклРасх Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьНРСП = 0;
			
		Если Выборка.Итог = Справочники.СМ_ИтогиПоРазделу.ВсегоПоРазделу Тогда
			
			ВозвратныеМатериалы = Выборка.ВозвратМатер;
			ТекВозвратныеМатериалы = Выборка.ТекВозвратМатер;
			
			// НР и СП.
			Табл = ПолучитьНРПоВидамРабот_КЗ(Раздел, Раздел.ИдРодителя, ПараметрыПечати, );
			Табл.Свернуть("Смета, Раздел", "СуммаНРНаОбъем,СуммаНР2НаОбъем,СуммаСПНаОбъем,ТекСуммаНРНаОбъем,ТекСуммаНР2НаОбъем,ТекСуммаСПНаОбъем,ТекСуммаСП2НаОбъем,СуммаСП2НаОбъем");
			
			Если Табл.Количество() > 0 Тогда
				
				СтрокаТабл = Табл[0];
				
				Если ПараметрыПечати.ВБазисномУровне Тогда
					ВсегоНР				= СтрокаТабл.СуммаНРНаОбъем+СтрокаТабл.СуммаНР2НаОбъем+СтрокаТабл.СуммаСП2НаОбъем;
				Иначе
					ВсегоНР				= СтрокаТабл.ТекСуммаНРНаОбъем+СтрокаТабл.ТекСуммаНР2НаОбъем+СтрокаТабл.ТекСуммаСП2НаОбъем;
				КонецЕсли;
				
				Если (ПараметрыПечати.ВБазисномУровне И (СтрокаТабл.СуммаНРНаОбъем+СтрокаТабл.СуммаНР2НаОбъем<>0)) Или
					(Не ПараметрыПечати.ВБазисномУровне И (СтрокаТабл.ТекСуммаНРНаОбъем+СтрокаТабл.ТекСуммаНР2НаОбъем<>0)) Тогда
				
					ИтогРаздела.Параметры.НаименованиеИтога 	= НСтр("ru='     Накладные расходы'");
					ИтогРаздела.Параметры.Измеритель = ПолучитьСтруктуруОбозначенияВалюты(ПараметрыПечати.СметаСсылка).ПечВалюта;
					ИтогРаздела.Параметры.ЕдТек					= "";
					Если ПараметрыПечати.ВБазисномУровне Тогда
						ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(СтрокаТабл.СуммаНРНаОбъем+СтрокаТабл.СуммаНР2НаОбъем,	КолЗнаков),СтрокаФормата);
					Иначе
						ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(СтрокаТабл.ТекСуммаНРНаОбъем+СтрокаТабл.ТекСуммаНР2НаОбъем,	КолЗнаков),СтрокаФормата);
					КонецЕсли;
					ТабличныйДокумент.Вывести(ИтогРаздела);
				
					Если (ПараметрыПечати.ВБазисномУровне И (СтрокаТабл.СуммаНРНаОбъем<>0)) Или
					(Не ПараметрыПечати.ВБазисномУровне И (СтрокаТабл.ТекСуммаНРНаОбъем<>0)) Тогда
				
						ИтогРаздела.Параметры.НаименованиеИтога 	= НСтр("ru='         в т.ч. накладные расходы первого уровня'");
						ИтогРаздела.Параметры.Измеритель = ПолучитьСтруктуруОбозначенияВалюты(ПараметрыПечати.СметаСсылка).ПечВалюта;
						ИтогРаздела.Параметры.ЕдТек					= "";
						Если ПараметрыПечати.ВБазисномУровне Тогда
							ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(СтрокаТабл.СуммаНРНаОбъем,	КолЗнаков),СтрокаФормата);
						Иначе
							ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(СтрокаТабл.ТекСуммаНРНаОбъем,	КолЗнаков),СтрокаФормата);
						КонецЕсли;
						ТабличныйДокумент.Вывести(ИтогРаздела);
						
					КонецЕсли;
					
					Если (ПараметрыПечати.ВБазисномУровне И (СтрокаТабл.СуммаНР2НаОбъем<>0)) Или
					(Не ПараметрыПечати.ВБазисномУровне И (СтрокаТабл.ТекСуммаНР2НаОбъем<>0)) Тогда
				
						ИтогРаздела.Параметры.НаименованиеИтога 	= НСтр("ru='         в т.ч. накладные расходы второго уровня'");
						ИтогРаздела.Параметры.Измеритель = ПолучитьСтруктуруОбозначенияВалюты(ПараметрыПечати.СметаСсылка).ПечВалюта;
						ИтогРаздела.Параметры.ЕдТек					= "";
						Если ПараметрыПечати.ВБазисномУровне Тогда
							ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(СтрокаТабл.СуммаНР2НаОбъем,	КолЗнаков),СтрокаФормата);
						Иначе
							ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(СтрокаТабл.ТекСуммаНР2НаОбъем,	КолЗнаков),СтрокаФормата);
						КонецЕсли;
						ТабличныйДокумент.Вывести(ИтогРаздела);
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если (ПараметрыПечати.ВБазисномУровне И (СтрокаТабл.СуммаСП2НаОбъем<>0)) Или
					(Не ПараметрыПечати.ВБазисномУровне И (СтрокаТабл.ТекСуммаСП2НаОбъем<>0)) Тогда
				
					ИтогРаздела.Параметры.НаименованиеИтога 	= НСтр("ru='     Сметная прибыль'");
					ИтогРаздела.Параметры.Измеритель = ПолучитьСтруктуруОбозначенияВалюты(ПараметрыПечати.СметаСсылка).ПечВалюта;
					ИтогРаздела.Параметры.ЕдТек					= "";
					Если ПараметрыПечати.ВБазисномУровне Тогда
						ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(СтрокаТабл.СуммаСП2НаОбъем,	КолЗнаков),СтрокаФормата);
						ДобавитьНРСП = СтрокаТабл.СуммаНР2НаОбъем + СтрокаТабл.СуммаСП2НаОбъем;
					Иначе
						ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(СтрокаТабл.ТекСуммаСП2НаОбъем,	КолЗнаков),СтрокаФормата);
						ДобавитьНРСП = СтрокаТабл.ТекСуммаНР2НаОбъем + СтрокаТабл.ТекСуммаСП2НаОбъем;
					КонецЕсли;
					ТабличныйДокумент.Вывести(ИтогРаздела);
					
				КонецЕсли;
					
			Иначе
				
				//ИтогРаздела.Параметры.НаименованиеИтога 	= НСтр("ru='     Накладные расходы'");
				//ИтогРаздела.Параметры.Измеритель = ПолучитьСтруктуруОбозначенияВалюты(ПараметрыПечати.СметаСсылка).ПечВалюта;
				//ИтогРаздела.Параметры.ЕдТек					= "";
				//ИтогРаздела.Параметры.ОбщТек				= "";
				//ТабличныйДокумент.Вывести(ИтогРаздела);
				//
				//ИтогРаздела.Параметры.НаименованиеИтога 	= НСтр("ru='         в т.ч. накладные расходы первого уровня'");
				//ИтогРаздела.Параметры.Измеритель = ПолучитьСтруктуруОбозначенияВалюты(ПараметрыПечати.СметаСсылка).ПечВалюта;
				//ИтогРаздела.Параметры.ЕдТек					= "";
				//ИтогРаздела.Параметры.ОбщТек				= "";
				//ТабличныйДокумент.Вывести(ИтогРаздела);
				//
				//ИтогРаздела.Параметры.НаименованиеИтога 	= НСтр("ru='         в т.ч. накладные расходы второго уровня'");
				//ИтогРаздела.Параметры.Измеритель = ПолучитьСтруктуруОбозначенияВалюты(ПараметрыПечати.СметаСсылка).ПечВалюта;
				//ИтогРаздела.Параметры.ЕдТек					= "";
				//ИтогРаздела.Параметры.ОбщТек				= "";
				//ТабличныйДокумент.Вывести(ИтогРаздела);
				//
				//ИтогРаздела.Параметры.НаименованиеИтога 	= НСтр("ru='     Сметная прибыль'");
				//ИтогРаздела.Параметры.Измеритель = ПолучитьСтруктуруОбозначенияВалюты(ПараметрыПечати.СметаСсылка).ПечВалюта;
				//ИтогРаздела.Параметры.ЕдТек					= "";
				//ИтогРаздела.Параметры.ОбщТек				= "";
				//ТабличныйДокумент.Вывести(ИтогРаздела);
				
			КонецЕсли;

		КонецЕсли;	
		
		Если Выборка.Итог = Справочники.СМ_ИтогиПоРазделу.ИтогоПоРазделу Тогда
			ИтогРаздела.Параметры.НаименованиеИтога 	= СокрЛП(Выборка.Итог.Наименование)+ " " + НомерРаздела;
		Иначе
			ИтогРаздела.Параметры.НаименованиеИтога 	= СокрЛП(Выборка.Итог.Наименование);
		КонецЕсли;
		
		Если СтрНайти(Выборка.Итог.Наименование,"трудоемкость") = 0 Тогда
			ИтогРаздела.Параметры.Измеритель = ПолучитьСтруктуруОбозначенияВалюты(ПараметрыПечати.СметаСсылка).ПечВалюта;
		Иначе
			ИтогРаздела.Параметры.Измеритель = "чел-ч";
		КонецЕсли;

		// ИтогРаздела.Параметры.НаименованиеИтога 	= ИтогРаздела.Параметры.НаименованиеИтога + " "+ ВернутьСтрокуРасшифровки(Выборка.Итог,Раздел,ПараметрыПечати);
		
		Если Выборка.Итог = Справочники.СМ_ИтогиПоРазделу.ВсегоПоРазделу Тогда
			
			Если ПараметрыПечати.ВБазисномУровне Тогда
				ИтогРаздела.Параметры.ЕдТек					= "";
				ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(Выборка.ПрямЗатраты+Выборка.Оборуд+ДобавитьНРСП,	КолЗнаков),СтрокаФормата);
			Иначе	
				ИтогРаздела.Параметры.ЕдТек					= "";
				ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(Выборка.ТекПрямЗатраты+Выборка.ТекОборуд+ДобавитьНРСП,	КолЗнаков),СтрокаФормата);
			КонецЕсли;
		Иначе
			Если ПараметрыПечати.ВБазисномУровне Тогда
				ИтогРаздела.Параметры.ЕдТек					= "";
				ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(Выборка.ПрямЗатраты,	КолЗнаков),СтрокаФормата);
			Иначе	
				ИтогРаздела.Параметры.ЕдТек					= "";
				ИтогРаздела.Параметры.ОбщТек				= Формат(Окр(Выборка.ТекПрямЗатраты,	КолЗнаков),СтрокаФормата);
			КонецЕсли;
		КонецЕсли;
		ТабличныйДокумент.вывести(ИтогРаздела);
		
	КонецЦикла;
	
	
КонецПроцедуры	

Процедура ВывестиИтогиВидРаздела_КЗ(ТабличныйДокумент,Раздел,ИтогРаздела,ПараметрыПечати,РодительРаздел,НомерРаздела)
	
	ПечатьАкта = Ложь;
	
	КолЗнаков = 2;
	Если ПараметрыПечати.ОкруглятьДоРублей = истина Тогда
		КолЗнаков = 0;		
	КонецЕсли;
	СтрокаФормата = ?(КолЗнаков = 0, "ЧДЦ=0","ЧДЦ=2");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИтогиПоРазделу.Итог КАК Итог,
	               |	СУММА(ИтогиПоРазделу.ТекПрямЗатраты) КАК ТекПрямЗатраты,
	               |	СУММА(ИтогиПоРазделу.ПрямЗатраты) КАК ПрямЗатраты,
	               |	СУММА(ИтогиПоРазделу.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
	               |	СУММА(ИтогиПоРазделу.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
	               |	СУММА(ИтогиПоРазделу.ТекОснЗарплата) КАК ТекОснЗарплата,
	               |	СУММА(ИтогиПоРазделу.ТекЭксплМашин) КАК ТекЭксплМашин,
	               |	СУММА(ИтогиПоРазделу.ТекЗарплМашин) КАК ТекЗарплМашин,
	               |	СУММА(ИтогиПоРазделу.ТекСтоимМатер) КАК ТекСтоимМатер,
	               |	СУММА(ИтогиПоРазделу.ТекОборуд) КАК ТекОборуд,
	               |	СУММА(ИтогиПоРазделу.ТекВозвратМатер) КАК ТекВозвратМатер,
	               |	СУММА(ИтогиПоРазделу.ОснЗарплата) КАК ОснЗарплата,
	               |	СУММА(ИтогиПоРазделу.ЭксплМашин) КАК ЭксплМашин,
	               |	СУММА(ИтогиПоРазделу.ЗарплМашин) КАК ЗарплМашин,
	               |	СУММА(ИтогиПоРазделу.СтоимМатер) КАК СтоимМатер,
	               |	СУММА(ИтогиПоРазделу.Оборуд) КАК Оборуд,
	               |	СУММА(ИтогиПоРазделу.ВозвратМатер) КАК ВозвратМатер
	               |ИЗ
	               |	РегистрСведений.СМ_ИтогиПоРазделу КАК ИтогиПоРазделу
	               |ГДЕ
	               |	ИтогиПоРазделу.Раздел = &Раздел
	               |	И ИтогиПоРазделу.Смета = &Смета
	               |	И ИтогиПоРазделу.Итог = &Итог
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИтогиПоРазделу.Итог
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИтогиПоРазделу.Итог.ПорядковыйНомер";
	Запрос.УстановитьПараметр("Раздел",Раздел);	
	Запрос.УстановитьПараметр("Смета",ПараметрыПечати.СметаСсылка);
	Запрос.УстановитьПараметр("Итог",Справочники.СМ_ИтогиПоРазделу.ИтогоПоРазделу); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		//Если ПараметрыПечати.ПечататьИтогиПоВидамРабот = Истина Тогда
			// Вывод итогов по видам работ.
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	ИтогиПоВидамРабот.Итог КАК Итог,
			               |	СУММА(ИтогиПоВидамРабот.ТекПрямЗатраты) КАК ТекПрямЗатраты,
			               |	СУММА(ИтогиПоВидамРабот.ТекОснЗарплата) КАК ТекОснЗарплата,
			               |	СУММА(ИтогиПоВидамРабот.ТекЭксплМашин) КАК ТекЭксплМашин,
			               |	СУММА(ИтогиПоВидамРабот.ТекЗарплМашин) КАК ТекЗарплМашин,
			               |	СУММА(ИтогиПоВидамРабот.ТекСтоимМатер) КАК ТекСтоимМатер,
			               |	СУММА(ИтогиПоВидамРабот.ТекОборуд) КАК ТекОборуд,
			               |	СУММА(ИтогиПоВидамРабот.Оборуд) КАК Оборуд,
			               |	СУММА(ИтогиПоВидамРабот.ЗатратыТрудаРабочих) КАК ЗатратыТрудаРабочих,
			               |	СУММА(ИтогиПоВидамРабот.ЗатратыТрудаМашин) КАК ЗатратыТрудаМашин,
			               |	СУММА(ИтогиПоВидамРабот.ПрямЗатраты) КАК ПрямЗатраты,
			               |	СУММА(ИтогиПоВидамРабот.ОснЗарплата) КАК ОснЗарплата,
			               |	СУММА(ИтогиПоВидамРабот.ЭксплМашин) КАК ЭксплМашин,
			               |	СУММА(ИтогиПоВидамРабот.ЗарплМашин) КАК ЗарплМашин,
			               |	СУММА(ИтогиПоВидамРабот.СтоимМатер) КАК СтоимМатер
			               |ИЗ
			               |	РегистрСведений.СМ_ИтогиПоВидамРабот КАК ИтогиПоВидамРабот
			               |ГДЕ
			               |	ИтогиПоВидамРабот.Смета = &Смета
			               |	И ИтогиПоВидамРабот.Раздел = &Раздел
			               |
			               |СГРУППИРОВАТЬ ПО
			               |	ИтогиПоВидамРабот.Итог
			               |
			               |УПОРЯДОЧИТЬ ПО
			               |	ИтогиПоВидамРабот.Итог.Код";
			
			Запрос.УстановитьПараметр("Смета",ПараметрыПечати.СметаСсылка);
			Запрос.УстановитьПараметр("Раздел",Раздел);
			
			ВыборкаВид = Запрос.Выполнить().Выбрать();
			Пока ВыборкаВид.Следующий() Цикл
				
				Если ВыборкаВид.ТекПрямЗатраты = 0 И ВыборкаВид.ТекОборуд = 0 И ВыборкаВид.ТекОснЗарплата = 0 И ВыборкаВид.ТекЭксплМашин = 0 И ВыборкаВид.ТекСтоимМатер = 0  И ВыборкаВид.ТекЗарплМашин = 0 И ВыборкаВид.ЗатратыТрудаРабочих = 0 И ВыборкаВид.ЗатратыТрудаМашин = 0 Тогда
					Продолжить;
				КонецЕсли;	
				
				// НРиСП.
				
				Если ВыборкаВид.Итог = Справочники.СМ_ИтогиСметыПоВидамРабот.МонтажнРаб Тогда
					ВидРабот = Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы;
				ИначеЕсли ВыборкаВид.Итог = Справочники.СМ_ИтогиСметыПоВидамРабот.СтроитРаб Тогда
					ВидРабот = Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы;
