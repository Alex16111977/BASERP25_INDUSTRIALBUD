			Стоимости.Вставить("ТекСтоимОборуд", 		Окр(Выборка.ТекСтоимОборуд		* ЧУ,	КолЗнаков));
			Стоимости.Вставить("ТекСтоимПрямЗатраты", 	Окр(Выборка.ТекСтоимПрямЗатраты	* ЧУ,	КолЗнаков));
			Стоимости.Вставить("ТекСтоимОснЗарплата", 	Окр(Выборка.ТекСтоимОснЗарплата	* ЧУ,	КолЗнаков));
