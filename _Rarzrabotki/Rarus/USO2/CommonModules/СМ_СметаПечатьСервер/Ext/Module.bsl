			ТабличныйДокумент.Вывести(СтрокаПозицияДопФОТ);
			
			СПФОТБазис = ПозицияСметы.СметнаяПрибыльБазисные * ПозицияСметы.КоэффициентКСПНаРемонтБазисный * ПозицияСметы.КоэффициентКСПАЭСБазисный*ПозицияСметы.КоэффициентКСПУСНБазисный;
			СПФОТБазис = Окр(СПФОТБазис,2,0);
			
			// Вывод сметной прибыли от ФОТ.
			Если  ПараметрыПечати.ЭтоМетодикаТСН11а Или ПараметрыПечати.ЭтоМетодикаТСН11б  Тогда
				Наименование =  НСтр("ru='СП от ЗП'");
				ТекСтрока = ПараметрыПечати.АктСсылка.Позиции.Найти(ПозицияСметы);
				Если ПараметрыПечати.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
					КоэффициентыНаПечать = Строка(ТекСтрока.СПТСНТекущиеРемонт);
