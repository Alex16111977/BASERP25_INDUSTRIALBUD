				Если ПозицияСметы.КоэффициентКСПНаРемонтТекущий <> 0 Тогда
					КоэффициентыНаПечать = КоэффициентыНаПечать + "*"+строка(ПозицияСметы.КоэффициентКСПНаРемонтТекущий);
				КонецЕсли;
				
				Если ПозицияСметы.КоэффициентКСПУСНТекущий <> 0 Тогда
					КоэффициентыНаПечать = КоэффициентыНаПечать + "*"+строка(ПозицияСметы.КоэффициентКСПУСНТекущий);
				КонецЕсли;
				
			Иначе
			КонецЕсли;
			Если СокрЛП(КоэффициентыНаПечать) = "0" Тогда
				КоэффициентыНаПечать = "";
			КонецЕсли;	
			Если  ПараметрыПечати.ЭтоМетодикаТСН11а Или ПараметрыПечати.ЭтоМетодикаТСН11б  Тогда
				ТекСтрока = ПараметрыПечати.АктСсылка.Позиции.Найти(ПозицияСметы);
				Если ПараметрыПечати.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
					КоэффициентыНаПечатьБазис = Строка(ТекСтрока.СПТСНБазисРемонт);
				Иначе
