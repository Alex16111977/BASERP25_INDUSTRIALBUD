		// {УСО 2.0}:{Управление строительной организацией}{Мокшанов А.О.} {{ 
		Оповещение = Новый ОписаниеОповещения("ВыборПериодаНачалоВыбораЗавершение", ЭтотОбъект, Форма);
		ВыборПериодаКлиент.ПериодНачалоВыбора(Форма, Элемент, СтандартнаяОбработка, 
			Объект.АУН_ВидПериода, Объект.АУН_НачалоПериода, Оповещение);
		//ОбщегоНазначенияУТКлиент.ПериодНачалоВыбора(Форма, Элемент, СтандартнаяОбработка, 
		//	Объект.АУН_ВидПериода, Форма.АУН_Период, Объект.АУН_НачалоПериода, Объект.АУН_ОкончаниеПериода);
		// {УСО 2.0}:{Управление строительной организацией}{Мокшанов А.О.} }}
			
	КонецЕсли;
	
КонецПроцедуры

