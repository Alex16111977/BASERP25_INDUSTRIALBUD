// Процедура предназначена для обработки добавленных команд форм в рамках подсистемы АрендаНедвижимости.
Процедура ВыполнитьПереопределяемуюКоманду(Форма, Команда, ДополнительныеПараметры) Экспорт
	
	Если Команда.Имя = "АУН_РассчитатьПостояннуюЧасть" Тогда
		
		Если ДополнительныеПараметры = Неопределено Тогда
			ДополнительныеПараметры = Новый Структура;	
		КонецЕсли;
		
		ДополнительныеПараметры.Вставить("ЭтоПостояннаяЧасть", Истина);
		
		РассчитатьНачислениеАренды(Форма, ДополнительныеПараметры);
		
	ИначеЕсли Команда.Имя = "АУН_РассчитатьПеременнуюЧасть" Тогда
		
		Если ДополнительныеПараметры = Неопределено Тогда
			ДополнительныеПараметры = Новый Структура;	
		КонецЕсли;
		
		ДополнительныеПараметры.Вставить("ЭтоПостояннаяЧасть", Ложь);
		
		РассчитатьНачислениеАренды(Форма, ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура предназначена для обработки событий форм в рамках подсистемы АрендаНедвижимости.
Процедура ВыполнитьПереопределяемоеСобытиеПриИзменении(Форма, Элемент) Экспорт
	
	Если Элемент.Имя = "АУН_Период" ИЛИ Элемент.Имя = "АУН_ВидПериода" 
		 ИЛИ Элемент.Имя = "АУН_НачалоПериода"  ИЛИ Элемент.Имя = "АУН_ОкончаниеПериода"
		Тогда
		
		ВыборПериодаПриИзменении(Форма, Элемент);
		
	ИначеЕсли Форма.ИмяФормы = "Справочник.ДоговорыКонтрагентов.Форма.ФормаЭлемента" Тогда
		
		ПриИзмененииРеквизитовДоговора(Форма, Элемент);
		
	ИначеЕсли Форма.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаЭлемента" Тогда
		
		ПриИзмененииРеквизитовНоменклатуры(Форма, Элемент);
		
	ИначеЕсли Форма.ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента" Тогда
		
		ПриИзмененииРеквизитовРеализацияТоваровУслуг(Форма, Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

