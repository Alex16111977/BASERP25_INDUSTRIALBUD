Процедура ПриИзмененииРеквизитовДоговора(Форма, Элемент)
	
	Объект = Форма.Объект;
	
	Если Элемент.Имя = "АУН_АрендныйДоговор" Тогда
		
		АУН_МодификацияКонфигурацииКлиентСервер.УправлениеФормойДоговора(Форма);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриИзмененииРеквизитовНоменклатуры(Форма, Элемент)
	
	Объект = Форма.Объект;
	
	Если Элемент.Имя = "АУН_ПостояннаяЧастьОплаты" Тогда
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриИзмененииРеквизитовРеализацияТоваровУслуг(Форма, Элемент)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Если Элемент.Имя = "АУН_Аренда" Тогда
		
		Если Объект.АУН_Аренда Тогда
			Объект.АУН_ВидОперацииАренды = ПредопределенноеЗначение("Перечисление.АУН_ВидыОперацийРеализацияТоваровУслуг.НачислениеАренды");
		Иначе
			Объект.АУН_ВидОперацииАренды = ПредопределенноеЗначение("Перечисление.АУН_ВидыОперацийРеализацияТоваровУслуг.ПустаяСсылка");
		КонецЕсли;
		
		Если НЕ Объект.АУН_Аренда Тогда
			// очистим суммы взаиморасчетов, рассчитанные предыдущим алгоритмом
			Для Каждого СтрокаТаб Из Объект.Товары Цикл
				СтрокаТаб.СуммаВзаиморасчетов = 0;	
			КонецЦикла;
		КонецЕсли;
		
		АУН_МодификацияКонфигурацииКлиентСервер.УправлениеФормойРеализацияТоваровУслуг(Форма);
		
	КонецЕсли;
	
	ПриИзмененииОбщихРеквизитовРеализацияЗаказКлиента(Форма, Элемент);
	
КонецПроцедуры

Процедура ПриИзмененииОбщихРеквизитовРеализацияЗаказКлиента(Форма, Элемент)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Если Элемент.Имя = "ТоварыАУН_СпособНачисления" Тогда
		
		РеализацияЗаказКлиентаПересчитатьСтроку(Форма);
		
	ИначеЕсли Элемент.Имя = "ТоварыАУН_СтавкаСпособаНачисления" Тогда
		
		РеализацияЗаказКлиентаПересчитатьСтроку(Форма);
		
	ИначеЕсли Элемент.Имя = "ТоварыАУН_КоличествоДней" Тогда
		
		РеализацияЗаказКлиентаПересчитатьСтроку(Форма);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыборПериодаПриИзменении(Форма, Элемент)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Если Элемент.Имя = "АУН_Период" Тогда
		
	   ВыборПериодаКлиент.ПериодПриИзменении(Элемент, Форма.АУН_Период, Объект.АУН_НачалоПериода, Объект.АУН_ОкончаниеПериода);
	
		
	ИначеЕсли Элемент.Имя = "АУН_ВидПериода"
		ИЛИ Элемент.Имя = "АУН_НачалоПериода"  ИЛИ Элемент.Имя = "АУН_ОкончаниеПериода"

		Тогда
		
		Если Элемент.Имя = "АУН_ОкончаниеПериода" Тогда
			Объект.АУН_НачалоПериода = Мин(Объект.АУН_НачалоПериода,Объект.АУН_ОкончаниеПериода);
		КонецЕсли;
				
		ПараметрыСтраниц = Новый Структура;
		ПараметрыСтраниц.Вставить("ПроизвольныйПериод", "АУН_ГруппаПроизвольныйПериод");
		ПараметрыСтраниц.Вставить("ПериодПоВидам"     , "АУН_ГруппаПериодПоВидам");
		ПараметрыСтраниц.Вставить("День"              , "АУН_ГруппаДень");  		
		
		ВыборПериодаКлиент.ВидПериодаПриИзменении(Элемент, Объект.АУН_ВидПериода, Объект.АУН_НачалоПериода, Объект.АУН_ОкончаниеПериода, Форма.АУН_Период);
				
	КонецЕсли;
	
КонецПроцедуры

