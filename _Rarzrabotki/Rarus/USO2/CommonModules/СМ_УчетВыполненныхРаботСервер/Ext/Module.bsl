#Область ПрограммныйИнтерфейс

// Проверяет наличие актов у сметы.
//
// Параметры:
//     ЛокальнаяСмета 		- ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на локальную смету.
//     ТаблицаВыполнения 	- ТаблицаЗначений, Неопределено - если вызов осуществляется с формы сметы, 
//							  то можно передать таблицу выполнения,
//                         	  наличие актов будет определяться по заполненности этой таблицы.
//
// Возвращаемое значение:
//     Результат - Булево - Истина, если по смете есть акты, иначе Ложь.
//
Функция СуществуютАктыПоСмете(ЛокальнаяСмета = Неопределено, ТаблицаВыполнения = Неопределено) Экспорт
	
	Если ТаблицаВыполнения <> Неопределено Тогда
		Возврат (ТаблицаВыполнения.Количество() <> 0);
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	АктВыполненныхРабот.Ссылка
		               |ИЗ
		               |	Документ.СМ_АктВыполненныхРабот КАК АктВыполненныхРабот
		               |ГДЕ
		               |	АктВыполненныхРабот.ЛокальнаяСмета = &ЛокальнаяСмета
		               |	И АктВыполненныхРабот.ПометкаУдаления = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("ЛокальнаяСмета", СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(ЛокальнаяСмета, "СМ_ЛокальнаяСмета"));
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Возврат Выборка.Следующий();
		
	КонецЕсли;	
	
КонецФункции

// Заполняет движения ПРИХОД для Локальной Смете по регистру учета выполненных работ.
//	Для очистки движений - можно передать пустую таблицу во второй параметр.
//
// Параметры:
//     ТаблицаДвижений 		- РегистрНакопленияНаборЗаписей.СМ_ВыполнениеПоСмете - Набор записей регистра.
//     ТаблицаПозицийСметы 	- ТаблицаЗначений - с колонками ИД (Позиция) - со всеми позициями сметы.
//     ЛокальнаяСметаСсылка - ДокументСсылка.СМ_ЛокальнаяСмета - ссылка на локальную смету.
//
Процедура ЗаполнитьПлановыйПриход(ТаблицаДвижений, ТаблицаПозицийСметы, ЛокальнаяСметаСсылка = Неопределено) Экспорт
	
	ТаблицаДвижений.Очистить();
	
	Для Каждого ТекСтрока Из ТаблицаПозицийСметы Цикл
		Движение 				= ТаблицаДвижений.Добавить();
		Движение.Регистратор 	= ЛокальнаяСметаСсылка.Ссылка;
		Движение.ВидДвижения 	= ВидДвиженияНакопления.Приход;
		Движение.Период 		= ЛокальнаяСметаСсылка.Дата;
		Движение.ЛокальнаяСмета = ЛокальнаяСметаСсылка.Ссылка;
		Движение.Позиция 		= ТекСтрока.Ид;
		Движение.Объем 			= ТекСтрока.Ид.ОбъемРабот;
	КонецЦикла;
	
	ТаблицаДвижений.Записать(Истина);
	
КонецПроцедуры

// Заполняет движения РАСХОД для Локальной Смете по регистру учета выполненных работ.
//	Для очистки движений - можно передать пустую таблицу во второй параметр.
//
// Параметры:
//     ТаблицаДвижений 		- РегистрНакопленияНаборЗаписей.СМ_ВыполнениеПоСмете - Набор записей регистра.
//     ТаблицаПозицийСметы 	- ТаблицаЗначений - с колонками ИД (Позиция) - со всеми позициями сметы.
//     АктВыполненныхРаботСсылка - ДокументСсылка.СМ_АктВыполненныхРабот - ссылка на акт-регистратор.
//
Процедура ЗаполнитьФактическийРасход(ТаблицаДвижений, ТаблицаПозицийСметы, АктВыполненныхРаботСсылка = Неопределено) Экспорт
	
	ТаблицаДвижений.Очистить();
	
	Для Каждого ТекСтрока Из ТаблицаПозицийСметы Цикл
		Движение 				= ТаблицаДвижений.Добавить();
		Движение.ВидДвижения 	= ВидДвиженияНакопления.Расход;
		Движение.Регистратор 	= АктВыполненныхРаботСсылка.Ссылка;
		Движение.Период 		= АктВыполненныхРаботСсылка.Дата;
		Движение.ЛокальнаяСмета = АктВыполненныхРаботСсылка.ЛокальнаяСмета;
		Движение.Позиция 		= ТекСтрока.Позиция;
		Движение.Объем 			= ТекСтрока.ФактОбъем;
	КонецЦикла;
	
	ТаблицаДвижений.Записать(Истина);
	
КонецПроцедуры

#КонецОбласти
