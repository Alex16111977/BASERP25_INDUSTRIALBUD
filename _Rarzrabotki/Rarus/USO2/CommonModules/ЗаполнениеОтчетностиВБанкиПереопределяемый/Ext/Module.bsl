	ПрефиксМСЧ = "П00012";
	
	ИтогоСтоимость = 0;
	ИтогоПросрочено = 0;
	
	МСЧ = СтраницаРаздела.ДанныеМногострочныхЧастей[ПрефиксМСЧ + "М1"];
