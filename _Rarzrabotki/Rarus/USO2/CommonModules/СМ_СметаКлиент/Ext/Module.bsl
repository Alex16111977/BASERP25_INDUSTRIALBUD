#Область ГрупповаяОбработкаПозиций

// Производит обновление по нормативной базе позиций из списка.
//
// Параметры:
//     МассивОбъектов 				- Массив - содержит ссылки на обновляемые позиции.
//     СтруктураПараметровРасчетаЛС - Структура - содержит данные о смете, полученная вызовом
//                                    ПолучитьСтруктуруПараметровРасчетаЛС().
//	   Найдено						- Булево - признак того, что в нормативной базе найдены данные по позиции.
//
Процедура ОбновитьПоНормативнойБазе(МассивОбъектов, СтруктураПараметровРасчетаЛС = Неопределено, Найдено = Ложь) Экспорт
	
	МассивПозиций = СМ_СметаВызовСервера.ПодготовитьМассивОбъектов(МассивОбъектов);
	МассивДляВсех = Новый Массив;	
	
	Для каждого ОбъектПозиции Из МассивПозиций Цикл
		
		Если (СтруктураПараметровРасчетаЛС = Неопределено) Тогда
			СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(,ОбъектПозиции);
		КонецЕсли;
		
		Если ТипЗнч(ОбъектПозиции) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			
			СтруктураКодНомерШифр = СМ_СметаВызовСервера.ПолучитьПараметрыДляОбновления(ОбъектПозиции,СтруктураПараметровРасчетаЛС);
			Если Строка(СтруктураКодНомерШифр.КодБазы) = "" Тогда
				Продолжить;
			КонецЕсли;	
			Данные = СметнаяКомпонента.ОбновитьПоБазе(СтруктураКодНомерШифр.ШифрРасценки,Строка(СтруктураПараметровРасчетаЛС.КодРайона),Строка(СтруктураКодНомерШифр.КодБазы),СтруктураКодНомерШифр.ТипСборника,Строка(СтруктураКодНомерШифр.НомерСборника));
			Если ЗначениеЗаполнено(Данные) И СМ_СметаЗагрузкаВызовСервера.ЕстьДанные(Данные) = Ложь Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Нет данных в нормативной базе по позиции %1. Позиция не обновлена.'"), СтруктураКодНомерШифр.ШифрРасценки));
				Найдено = Ложь;	
			Иначе	
				Если ЗначениеЗаполнено(Данные) Тогда
					Найдено = Истина;
					ОбъектПозиция = ОбъектПозиции; 
					СтруктураПараметровФормыВыбораВНБ = СМ_СметаВызовСервера.ОбновитьДанныеВПозицииЛС(Данные, ОбъектПозиция, Истина, СтруктураПараметровФормыВыбораВНБ, СтруктураПараметровРасчетаЛС, СМ_ВерсияКомпоненты);
					// ДокторСофт
					// Вставка текущих цен если отмечено.
					Если СтруктураПараметровРасчетаЛС.АвтозагрузкаЦен И ЗначениеЗаполнено(СтруктураПараметровРасчетаЛС.ФайлСборникаТекущихЦен) И (ОбъектПозиции <> Неопределено) Тогда
						// Обновляем индексы.
						СтруктураДанных = Новый Структура("СборникТекущихЦен, КодРегиональнойБазы", СтруктураПараметровРасчетаЛС.ФайлСборникаТекущихЦен, СтруктураПараметровРасчетаЛС.КодРегионаФайлаТекущихЦен);
						ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОТекущихЦенах(ОбъектПозиции, , СтруктураДанных);
						СМ_СметаВызовСервера.ЗагрузитьТекущиеЦеныВПозиции(ОбъектПозиции, ДанныеИнд, Истина,  СтруктураПараметровРасчетаЛС.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.Ресурсный"));
					КонецЕсли;

					// Вставка индексов если БИ по позициям.
					Если (СтруктураПараметровРасчетаЛС.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И СтруктураПараметровРасчетаЛС.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Расценка")) Тогда
						Если СтруктураПараметровРасчетаЛС.АвтозагрузкаИндексов И ЗначениеЗаполнено(СтруктураПараметровРасчетаЛС.ФайлСборникаКоэффициентов) И (ОбъектПозиции <> Неопределено) Тогда
							// Обновляем индексы.
							СтруктураДанных = Новый Структура("СборникКоэффициентов", СтруктураПараметровРасчетаЛС.ФайлСборникаКоэффициентов);
							Если СтруктураПараметровРасчетаЛС.ПрименятьИндексыКоВсемБазам Тогда
								СтруктураДанных.Вставить("КодРегиональнойБазы", СтруктураПараметровРасчетаЛС.КодРегионаФайлаИндексовПересчета);
							КонецЕсли;
							ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОбИндексахПересчета(ОбъектПозиции, , СтруктураДанных);
							СМ_СметаВызовСервера.ЗагрузитьИндексыВПозиции(ОбъектПозиции, ДанныеИнд, СтруктураПараметровРасчетаЛС.ВариантПересчетаЭММ, Истина, Истина,);	
						КонецЕсли;
					КонецЕсли;
					// ДокторСофт
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;	
	
	СМ_СметаКлиент.ОткрытьФормуПодбораНеучтенныхРесурсов(СтруктураПараметровФормыВыбораВНБ);
	
КонецПроцедуры	

// Производит обновление позиции по норме
//
// Параметры:
//     ОбъектПозиции 	- ДокументОбъект.СМ_ПозицияЛокальнойСметы - объект позиции для обновления.
//     Данные 			- Структура - данные полученные из ВНБ. 
//
Процедура ОбновитьПозициюПоНорме(ОбъектПозиции,Данные) Экспорт
	
	СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(,ОбъектПозиции);
	
	ОбъектПозиция = ОбъектПозиции; 
	СтруктураПараметровФормыВыбораВНБ = СМ_СметаВызовСервера.ОбновитьДанныеВПозицииЛС(Данные, ОбъектПозиция, Истина, СтруктураПараметровФормыВыбораВНБ, СтруктураПараметровРасчетаЛС, СМ_ВерсияКомпоненты);
	// Вставка текущих цен если отмечено.
	Если СтруктураПараметровРасчетаЛС.АвтозагрузкаЦен И ЗначениеЗаполнено(СтруктураПараметровРасчетаЛС.ФайлСборникаТекущихЦен) И (ОбъектПозиции <> Неопределено) Тогда
		// Обновляем индексы.
		СтруктураДанных = Новый Структура("СборникТекущихЦен, КодРегиональнойБазы", СтруктураПараметровРасчетаЛС.ФайлСборникаТекущихЦен, СтруктураПараметровРасчетаЛС.КодРегионаФайлаТекущихЦен);
		ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОТекущихЦенах(ОбъектПозиции, , СтруктураДанных);
		СМ_СметаВызовСервера.ЗагрузитьТекущиеЦеныВПозиции(ОбъектПозиции, ДанныеИнд, Истина,  СтруктураПараметровРасчетаЛС.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.Ресурсный"));
	КонецЕсли;
	
	// Вставка индексов если БИ по позициям.
	Если (СтруктураПараметровРасчетаЛС.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И СтруктураПараметровРасчетаЛС.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Расценка")) Тогда
		Если СтруктураПараметровРасчетаЛС.АвтозагрузкаИндексов И ЗначениеЗаполнено(СтруктураПараметровРасчетаЛС.ФайлСборникаКоэффициентов) И (ОбъектПозиции <> Неопределено) Тогда
			// Обновляем индексы.
			СтруктураДанных = Новый Структура("СборникКоэффициентов", СтруктураПараметровРасчетаЛС.ФайлСборникаКоэффициентов);
			Если СтруктураПараметровРасчетаЛС.ПрименятьИндексыКоВсемБазам Тогда
				СтруктураДанных.Вставить("КодРегиональнойБазы", СтруктураПараметровРасчетаЛС.КодРегионаФайлаИндексовПересчета);
			КонецЕсли;
			ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОбИндексахПересчета(ОбъектПозиции, , СтруктураДанных);
			СМ_СметаВызовСервера.ЗагрузитьИндексыВПозиции(ОбъектПозиции, ДанныеИнд, СтруктураПараметровРасчетаЛС.ВариантПересчетаЭММ, Истина, Истина,);	
		КонецЕсли;
	КонецЕсли;
	
	СМ_СметаКлиент.ОткрытьФормуПодбораНеучтенныхРесурсов(СтруктураПараметровФормыВыбораВНБ);
	
КонецПроцедуры

// Производит обновление по нормативной базе позиций из списка.
//
// Параметры:
//     МассивОбъектов 				- Массив - содержит ссылки на обновляемые позиции.
//     СтруктураПараметровРасчетаЛС - Структура - содержит данные о смете, полученная вызовом
//                                    ПолучитьСтруктуруПараметровРасчетаЛС().
//	   Найдено						- Булево - признак того, что в нормативной базе найдены данные по позиции.
//
Процедура ОбновитьЗагружаемыеПозицииПоНормативнойБазе(МассивОбъектов, СтруктураПараметровРасчетаЛС = Неопределено, Найдено = Ложь) Экспорт
	
	
	МассивПозиций = СМ_СметаВызовСервера.ПодготовитьМассивОбъектов(МассивОбъектов);
	МассивДляВсех = Новый Массив;	
	
	Для каждого ОбъектПозиции Из МассивПозиций Цикл
		
		Если (СтруктураПараметровРасчетаЛС = Неопределено) Тогда
			СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(,ОбъектПозиции);
		КонецЕсли;
		
		Если ТипЗнч(ОбъектПозиции) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			
			СтруктураКодНомерШифр = СМ_СметаВызовСервера.ПолучитьПараметрыДляОбновления(ОбъектПозиции,СтруктураПараметровРасчетаЛС);
			Если Строка(СтруктураКодНомерШифр.КодБазы) = "" Тогда
				Продолжить;
			КонецЕсли;	
			Данные = СметнаяКомпонента.ОбновитьПоБазе(СтруктураКодНомерШифр.ШифрРасценки,Строка(СтруктураПараметровРасчетаЛС.КодРайона),Строка(СтруктураКодНомерШифр.КодБазы),СтруктураКодНомерШифр.ТипСборника,Строка(СтруктураКодНомерШифр.НомерСборника));
			Если ЗначениеЗаполнено(Данные) И СМ_СметаЗагрузкаВызовСервера.ЕстьДанные(Данные) = Ложь Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Нет данных в нормативной базе по позиции %1. Позиция не обновлена.'"), СтруктураКодНомерШифр.ШифрРасценки));
				Найдено = Ложь;	
			Иначе	
				Если ЗначениеЗаполнено(Данные) Тогда
					Найдено = Истина;
					ОбъектПозиция = ОбъектПозиции; 
					СтруктураПараметровФормыВыбораВНБ = СМ_СметаВызовСервера.ОбновитьДанныеВПозицииЛС(Данные, ОбъектПозиция,Ложь, СтруктураПараметровФормыВыбораВНБ, СтруктураПараметровРасчетаЛС, СМ_ВерсияКомпоненты);
					// ДокторСофт
					// Вставка текущих цен если отмечено.
					Если СтруктураПараметровРасчетаЛС.АвтозагрузкаЦен И ЗначениеЗаполнено(СтруктураПараметровРасчетаЛС.ФайлСборникаТекущихЦен) И (ОбъектПозиции <> Неопределено) Тогда
						// Обновляем индексы.
						СтруктураДанных = Новый Структура("СборникТекущихЦен, КодРегиональнойБазы", СтруктураПараметровРасчетаЛС.ФайлСборникаТекущихЦен, СтруктураПараметровРасчетаЛС.КодРегионаФайлаТекущихЦен);
						ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОТекущихЦенах(ОбъектПозиции, , СтруктураДанных);
						СМ_СметаВызовСервера.ЗагрузитьТекущиеЦеныВПозиции(ОбъектПозиции, ДанныеИнд, Истина,  СтруктураПараметровРасчетаЛС.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.Ресурсный"));
					КонецЕсли;

					// Вставка индексов если БИ по позициям.
					Если (СтруктураПараметровРасчетаЛС.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") И СтруктураПараметровРасчетаЛС.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Расценка")) Тогда
						Если СтруктураПараметровРасчетаЛС.АвтозагрузкаИндексов И ЗначениеЗаполнено(СтруктураПараметровРасчетаЛС.ФайлСборникаКоэффициентов) И (ОбъектПозиции <> Неопределено) Тогда
							// Обновляем индексы.
							СтруктураДанных = Новый Структура("СборникКоэффициентов", СтруктураПараметровРасчетаЛС.ФайлСборникаКоэффициентов);
							Если СтруктураПараметровРасчетаЛС.ПрименятьИндексыКоВсемБазам Тогда
								СтруктураДанных.Вставить("КодРегиональнойБазы", СтруктураПараметровРасчетаЛС.КодРегионаФайлаИндексовПересчета);
							КонецЕсли;
							ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОбИндексахПересчета(ОбъектПозиции, , СтруктураДанных);
							СМ_СметаВызовСервера.ЗагрузитьИндексыВПозиции(ОбъектПозиции, ДанныеИнд, СтруктураПараметровРасчетаЛС.ВариантПересчетаЭММ, Истина, Истина,);	
						КонецЕсли;
					КонецЕсли;
					// ДокторСофт
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;	
	
	
КонецПроцедуры	

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Найти аргументы в формуле.
Функция НайтиАргументы(Формула, ПозЗнака)
	
	Число1 = 0;
	Число1Начало = 0;
	Число2 = 0;
	Число2Конец = 0;
	
	Для Сч = 2 По ПозЗнака Цикл
		Если Сред(Формула, ПозЗнака - Сч,1) = " " Тогда
			Число1 = Сред(Формула,ПозЗнака - Сч + 1, Сч - 2);
			Число1Начало = ПозЗнака - Сч + 1;
			Прервать;
		КонецЕсли;
		Число1 = Лев(Формула, Сч - 2);
		Число1Начало = 1;
		
	КонецЦикла;
	Для Сч = 2 По СтрДлина(Формула) - ПозЗнака Цикл
		Если Сред(Формула, ПозЗнака + Сч,1) = " " Тогда
			Число2 = Сред(Формула,ПозЗнака + 2, Сч - 2);
			Число2Конец = ПозЗнака + Сч - 1;
			Прервать;
		КонецЕсли;
		Число2 = Прав(Формула, Сч - 1);
		Число2Конец = СтрДлина(Формула);
	КонецЦикла;
	
	Аргументы = Новый Структура("Число1,Число2,Число1Начало,Число2Конец",Число(Число1),Число(Число2),Число1Начало,Число2Конец);
	
	Возврат Аргументы;
	
	
КонецФункции

