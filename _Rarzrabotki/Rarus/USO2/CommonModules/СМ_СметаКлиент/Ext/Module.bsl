#Область Формулы

// Производит расчет формулы, исходя из заданных в ней аргументов.
//
// Параметры:
//     Формула - Строка - содержит строку с формулой.
//
// Возвращаемое значение:
//     Формула - Число - содержит результат расчета.
//
Функция РасчитатьФормулу(Знач Формула) Экспорт
	
	ЛевСкобка = Найти(Формула,"(");
	Если НЕ ЛевСкобка = 0 Тогда
		
		ПравСкобка = 0;
		Для Сч = 0 По СтрДлина(Формула)-1 Цикл
			Если Сред(Формула,СтрДлина(Формула)-Сч,1) = ")"	Тогда
				ПравСкобка = СтрДлина(Формула)-Сч;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Результат = РасчитатьФормулу(Сред(Формула,ЛевСкобка+2,ПравСкобка - ЛевСкобка - 3));
		Формула = Лев(Формула,ЛевСкобка-1) + Результат + Прав(Формула,СтрДлина(Формула) - ПравСкобка);
		
	КонецЕсли;
	
	Умножение = Найти(Формула,"* ");
	Пока НЕ Умножение = 0 Цикл;
		Аргументы = НайтиАргументы(Формула, Умножение);
		Результат = Аргументы.Число1 * Аргументы.Число2;
		Формула = Лев(Формула,Аргументы.Число1Начало - 1) + Строка(Результат) + Прав(Формула,СтрДлина(Формула) - Аргументы.Число2Конец);
		
		Умножение = Найти(Формула,"* ");
	КонецЦикла;
	
	Деление = Найти(Формула,"/ ");
	Пока НЕ Деление = 0 Цикл;
		Аргументы = НайтиАргументы(Формула, Деление);
		Результат = Аргументы.Число1 / Аргументы.Число2;
		Формула = Лев(Формула,Аргументы.Число1Начало - 1) + Строка(Результат) + Прав(Формула,СтрДлина(Формула) - Аргументы.Число2Конец);
		
		Деление = Найти(Формула,"/ ");
	КонецЦикла;
	
	Вычитание = Найти(Формула,"- ");
	Пока НЕ Вычитание = 0 Цикл;
		Аргументы = НайтиАргументы(Формула, Вычитание);
		Результат = Аргументы.Число1 - Аргументы.Число2;
		Формула = Лев(Формула,Аргументы.Число1Начало - 1) + Строка(Результат) + Прав(Формула,СтрДлина(Формула) - Аргументы.Число2Конец);
		
		Вычитание = Найти(Формула,"- ");
	КонецЦикла;
	
	Сложение = Найти(Формула,"+ ");
	Пока НЕ Сложение = 0 Цикл;
		Аргументы = НайтиАргументы(Формула, Сложение);
		Результат = Аргументы.Число1 + Аргументы.Число2;
		Формула = Лев(Формула,Аргументы.Число1Начало - 1) + Строка(Результат) + Прав(Формула,СтрДлина(Формула) - Аргументы.Число2Конец);
		
		Сложение = Найти(Формула,"+ ");
	КонецЦикла;
	
	Попытка 
		Формула = Число(Формула);
	Исключение
		Формула = 0;
	КонецПопытки;
	
	Возврат Формула;
	
КонецФункции

