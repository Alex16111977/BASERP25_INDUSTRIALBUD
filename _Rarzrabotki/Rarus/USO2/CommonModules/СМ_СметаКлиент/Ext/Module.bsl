//
// Параметры:
//     Значение - Строка - значение для установки выбранного каталога.
//
// Возвращаемое значение:
//     Истина - каталог выбран, Ложь - в противном случае.
//
Функция сфВыборКаталога(Значение) Экспорт

	ДиалогВыбораКаталога 							= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораКаталога.ПредварительныйПросмотр 	= Ложь;
	ДиалогВыбораКаталога.ИндексФильтра           	= 0;
	ДиалогВыбораКаталога.Каталог                 	= Значение;

	// Синхронный вызов
	//Если ДиалогВыбораКаталога.Выбрать() Тогда
	//	Значение = ?(Прав(ДиалогВыбораКаталога.Каталог,1)="\", ДиалогВыбораКаталога.Каталог, ДиалогВыбораКаталога.Каталог+"\");
	//	Возврат Истина;
	//Иначе
	//	Возврат Ложь;
	//КонецЕсли;
	
	// Замена на асинхронный вызов
	ОповещениеВыбора = Новый ОписаниеОповещения("ВыполнитьПослеВыбораКаталога", ЭтотОбъект,Значение);
	ДиалогВыбораКаталога.Показать(ОповещениеВыбора);

	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции 

// Выполняет действия после выбора каталога
//
// Параметры:
//    ВыбранныеФайлы 	- Массив - содержит выбранные имена каталогов или Неопределено, 
//								   если выбор не осуществлен. 
//	  Значение 			- Строка - значение для установки выбранного каталога.
//
Процедура ВыполнитьПослеВыбораКаталога(ВыбранныеФайлы,Значение) Экспорт
	
	Значение = "";
	Если ВыбранныеФайлы <> Неопределено Тогда
		Для Каждого ТекЭлемент Из ВыбранныеФайлы Цикл
			Значение = ?(Прав(ТекЭлемент,1)="\", ТекЭлемент, ТекЭлемент+"\");
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Открывает диалог сохранения файла и устанавлевает выбранное значение в переданный параметр.
//
// Параметры:
//     Значение 				- Строка - полный путь к файлу для установки выбранного файла и каталога.
//	   Расширение             	- Строка - расширение файла.
//	   НазваниеФайла            - Строка - название файла. 
//     ПроверятьСуществование 	- Булево - если Истина, то выбор отменяется, если файл не существует.
//     Сохранение             	- Булево - если Истина, то диалог сохранения файла, иначе диалог открытия файла.
//
Процедура сфВыборФайла(Значение, Расширение, НазваниеФайла = "Файл данных", ПроверятьСуществование = Ложь, Сохранение = Ложь) Экспорт

	ДиалогФыбораФайла                             = Новый ДиалогВыбораФайла(?(Сохранение, РежимДиалогаВыбораФайла.Сохранение, РежимДиалогаВыбораФайла.Открытие));
	ДиалогФыбораФайла.Фильтр                      = НазваниеФайла+" (*."+Расширение+")|*."+Расширение;
	ДиалогФыбораФайла.Заголовок                   = НСтр("ru='Выберите файл'");
	ДиалогФыбораФайла.ПредварительныйПросмотр     = Ложь;
	ДиалогФыбораФайла.Расширение                  = Расширение;
	ДиалогФыбораФайла.ИндексФильтра               = 0;
	ДиалогФыбораФайла.ПолноеИмяФайла              = Значение;
	ДиалогФыбораФайла.ПроверятьСуществованиеФайла = ПроверятьСуществование;

	// Синхронный вызов
	//Если ДиалогФыбораФайла.Выбрать() Тогда
	//	Значение = ДиалогФыбораФайла.ПолноеИмяФайла;
	//КонецЕсли;

	// Замена на асинхронный вызов
	ОповещениеВыбора = Новый ОписаниеОповещения("ВыполнитьПослеВыбораФайла", ЭтотОбъект, Значение);
	ДиалогФыбораФайла.Показать(ОповещениеВыбора);
	
КонецПроцедуры

// Выполняет действия после выбора файла
//
// Параметры:
//    ВыбранныеФайлы 			- Массив - содержит выбранные имена файлов или Неопределено, 
//										   если выбор не осуществлен. 
//	  ДополнительныеПараметры	- Произвольный - содержит дополнительные параметры.
//
Процедура ВыполнитьПослеВыбораФайла(ВыбранныеФайлы,ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		Для Каждого ТекЭлемент Из ВыбранныеФайлы Цикл
			Значение = ТекЭлемент;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Возвращает массив для дальнейших отборов.
// Если передан один объект, то просто добавляет его в массив.
//
// Параметры:
//     МассивОбъектов - ДокументСсылка, Массив - ссылка на документ или массив ссылок.
//
// Возвращаемое значение:
//     НовыйМассив - Массив - содержит нужные ссылки на элементы.
//
Функция ПодготовитьМассивОбъектов(МассивОбъектов) Экспорт
	
	НовыйМассив = Новый Массив; 
	
	Если ТипЗнч(МассивОбъектов) = тип("Массив") Тогда
		
		НовыйМассив = МассивОбъектов;
		
	ИначеЕсли типЗнч(МассивОбъектов) = тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		
		НовыйМассив.Добавить(МассивОбъектов);
			
	ИначеЕсли ТипЗнч(МассивОбъектов) = тип("ДокументОбъект.СМ_ПозицияЛокальнойСметы") Тогда
		
		НовыйМассив.Добавить(МассивОбъектов.Ссылка);
		
	Иначе
		Возврат неопределено; 
	КонецЕсли;

	Возврат  НовыйМассив;
	
КонецФункции

#КонецОбласти

#Область ВидимостьЭлементовМетодаРасчета

// Выводит строку с представлением метода расчета в форму.
//
// Параметры:
//     Форма - УправляемаяФорма - форма для которой выводится представление метода расчета.
//
Процедура ОтобразитьУровеньМетодРасчета(Форма) Экспорт
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Если Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный") Тогда
		Если Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Раздел") Тогда 
			
			Если Объект.СпособРасчетаИндексов = ПредопределенноеЗначение("Перечисление.СМ_СпособыРасчетаИндексов.КПолнойСтоимости") Тогда
				Элементы.ГруппаКомандПараметров.ПодчиненныеЭлементы.ВыбранВариант.Заголовок = НСтр("ru='Выбран базисно-индексный вариант по Разделам, по полной стоимости'");
			Иначе 	
				Элементы.ГруппаКомандПараметров.ПодчиненныеЭлементы.ВыбранВариант.Заголовок = НСтр("ru='Выбран базисно-индексный вариант по Разделам, по элементам затрат'");
			КонецЕсли;	
	
		ИначеЕсли Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Расценка") Тогда 
			
			Если Объект.СпособРасчетаИндексов = ПредопределенноеЗначение("Перечисление.СМ_СпособыРасчетаИндексов.КПолнойСтоимости") Тогда
				Элементы.ГруппаКомандПараметров.ПодчиненныеЭлементы.ВыбранВариант.Заголовок = НСтр("ru='Выбран Базисно-индексный вариант по Расценке по полной стоимости'");
			Иначе 	
				Элементы.ГруппаКомандПараметров.ПодчиненныеЭлементы.ВыбранВариант.Заголовок = НСтр("ru='Выбран Базисно-индексный вариант по Расценке по элементам затрат'");
			КонецЕсли;		
			
		ИначеЕсли Объект.Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Смета") Тогда 
			
			Если Объект.СпособРасчетаИндексов = ПредопределенноеЗначение("Перечисление.СМ_СпособыРасчетаИндексов.КПолнойСтоимости") Тогда
				Элементы.ГруппаКомандПараметров.ПодчиненныеЭлементы.ВыбранВариант.Заголовок = НСтр("ru='Выбран базисно-индексный вариант по Смете, по полной стоимости'");
			Иначе
				Элементы.ГруппаКомандПараметров.ПодчиненныеЭлементы.ВыбранВариант.Заголовок = НСтр("ru='Выбран базисно-индексный вариант по Смете, по элементам затрат'");
			КонецЕсли;
			
		Иначе
			
			Элементы.ГруппаКомандПараметров.ПодчиненныеЭлементы.ВыбранВариант.Заголовок = НСтр("ru='Выбран базисно-индексный вариант'");
					
		КонецЕсли;
	Иначе
		
		Элементы.ГруппаКомандПараметров.ПодчиненныеЭлементы.ВыбранВариант.Заголовок = НСтр("ru='Выбран Ресурсный вариант'");

	КонецЕсли;
	
	// Видимость элементов формы
	ЭтоРесурсныйМетод = Объект.МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.Ресурсный");
	ЭтоРасчетПоЭлементамЗатрат = Объект.СпособРасчетаИндексов = ПредопределенноеЗначение("Перечисление.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат");
	
	// в зависимости от метода счета
	Элементы.МетодРасчета.Видимость			= Истина;
	Элементы.Уровень.Видимость				= (Не ЭтоРесурсныйМетод) И ЗначениеЗаполнено(Объект.МетодРасчета);
	Элементы.СпособРасчетаИндексов.Видимость= (Не ЭтоРесурсныйМетод) И ЗначениеЗаполнено(Объект.Уровень);
	
	Элементы.ВариантПересчетаЭММ.Видимость	= (Не ЭтоРесурсныйМетод) И (ЭтоРасчетПоЭлементамЗатрат) И ЗначениеЗаполнено(Объект.Уровень);
	Элементы.ВариантРасчетаЗМ.Видимость     = ЭтоРесурсныйМетод;
	
	Элементы.ВариантРасчетаЗМ.АвтоОтметкаНезаполненного = (ЭтоРесурсныйМетод);
	Элементы.Уровень.АвтоОтметкаНезаполненного 			= (НЕ ЭтоРесурсныйМетод);
	Элементы.СпособРасчетаИндексов.АвтоОтметкаНезаполненного 			= (НЕ ЭтоРесурсныйМетод);
	
КонецПроцедуры

