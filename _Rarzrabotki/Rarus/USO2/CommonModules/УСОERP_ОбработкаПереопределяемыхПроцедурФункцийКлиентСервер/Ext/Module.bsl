
#Область ПрограммныйИнтерфейс

// Процедура, вызываемая из переопределяемого модуля.
//
// Параметры:
//  Форма					- УправляемаяФорма - форма, из обработчика события которой происходит вызов процедуры.
//
Процедура СоздатьКнопкуФормы(Форма) Экспорт	
	Если Форма.ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента" Тогда
		СоздатьКнопку(Форма, "ЗаполнитьУслугиГенподрядчика", "Заполнить услуги Генподрядчика")
	ИначеЕсли Форма.ИмяФормы = "Документ.ПриобретениеТоваровУслуг.Форма.ФормаДокумента" Тогда
		СоздатьКнопку(Форма, "ЗаполнитьУслугиЗаказчика", "Заполнить услуги Заказчика");
	КонецЕсли;	
КонецПроцедуры

// Процедура, вызываемая из одноименного обработчика события формы.
//
// Параметры:
//  Форма					- УправляемаяФорма - форма, из обработчика события которой происходит вызов процедуры.
//  ИмяКоманды				- Строка - имя команды формы.
//  Заголовок				- Строка - заголовок кнопки формы
//
Процедура СоздатьКнопку(Форма, ИмяКоманды, Заголовок)
	Команда          	= Форма.Команды.Добавить(ИмяКоманды);   
	Команда.Действие	= "Подключаемый_ВыполнитьПереопределяемуюКоманду";
	Кнопка              = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Форма.Элементы.ТоварыКоманднаяПанель);       
	Кнопка.Заголовок  	= Заголовок;   
	Кнопка.ИмяКоманды   = ИмяКоманды;      	
КонецПроцедуры	

#КонецОбласти