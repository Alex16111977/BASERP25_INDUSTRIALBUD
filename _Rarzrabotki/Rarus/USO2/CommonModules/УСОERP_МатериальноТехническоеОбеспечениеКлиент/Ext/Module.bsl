
#Область ПодключаемыеОбработчикиКомандФорм

// Обработка подключаемой команды "Показывать все заказы" для документа "Заказ на внутреннее потребление"
//
// Параметры:
// Форма - форма, из обработчика события которой происходит вызов команды.
// Команда - команда формы, которая вызвана.
// ДополнительныеПараметры - структура с дополнительными параметрами (по умолчанию = Неопределено).
//	
Процедура Подключаемый_УСОERP_ПоказатьВсеЗаказыВключаяПоУСО(Форма, Команда, ДополнительныеПараметры) Экспорт
	
	ИмяКоманды = Команда.Имя;
	КнопкаФормы = Форма.Элементы[ИмяКоманды];
	КнопкаФормы.Пометка = Не КнопкаФормы.Пометка;
	
	ИсключатьДокументыПоПлануПотребностиМатериалов =  Не КнопкаФормы.Пометка;
		
	МассивДокументов = УСОERP_МатериальноТехническоеОбеспечение.ПолучитьМассивЗаказовПоПланамПотребностейВМатериалах(); 
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.Список, "Ссылка", МассивДокументов,
	 				ВидСравненияКомпоновкиДанных.НеВСписке, , ИсключатьДокументыПоПлануПотребностиМатериалов);
					
КонецПроцедуры

// Обработка подключаемой команды "Затраты на доставку" для документа "Поступление услуг и прочих активов"
//
// Параметры:
// Форма - форма, из обработчика события которой происходит вызов команды.
// Команда - команда формы, которая вызвана.
// ДополнительныеПараметры - структура с дополнительными параметрами (по умолчанию = Неопределено).
//	
Процедура Подключаемый_УСОERP_ЗатратыНаДоставку(Форма, Команда, ДополнительныеПараметры) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.УСОERP_ИсполнителиДоставки.СтороннийПеревозчик"));
	
	ДопустимыеСтатусы = Новый Массив;
	ДопустимыеСтатусы.Добавить(ПредопределенноеЗначение("Перечисление.УСОERP_СтатусыЗаказаНаПеревозку.ВРаботе"));
	ДопустимыеСтатусы.Добавить(ПредопределенноеЗначение("Перечисление.УСОERP_СтатусыЗаказаНаПеревозку.Подготовлен"));
	ДопустимыеСтатусы.Добавить(ПредопределенноеЗначение("Перечисление.УСОERP_СтатусыЗаказаНаПеревозку.Согласован"));
	
	ДопустимыеИсполнители = Новый Массив;
	ДопустимыеИсполнители.Добавить(ПредопределенноеЗначение("Перечисление.УСОERP_ИсполнителиДоставки.СтороннийПеревозчик"));

	ПараметрыФормы.Вставить("ОтборПоСтатусу", ДопустимыеСтатусы);
	ПараметрыФормы.Вставить("ОтборПоВидуОперации", ДопустимыеИсполнители);
	
	мДополнительныеПараметры = Новый Структура();
	мДополнительныеПараметры.Вставить("Форма", Форма);
	ФормаВыбора = ОткрытьФорму("Документ.УСОERP_ЗаказНаПеревозку.ФормаВыбора",ПараметрыФормы, Форма,,,,Новый ОписаниеОповещения("Подключаемый_ОбработкаВыбораЗатратНаДоставку", УСОERP_МатериальноТехническоеОбеспечениеКлиент,мДополнительныеПараметры));
	
КонецПроцедуры

Процедура Подключаемый_ОбработкаВыбораЗатратНаДоставку(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(РезультатЗакрытия) Тогда
		Возврат;
	КонецЕсли;

	мДополнительныеПараметры = Новый Структура;
		
	мДополнительныеПараметры.Вставить("Объект", ДополнительныеПараметры.Форма.Объект);
	УСОERP_МатериальноТехническоеОбеспечение.Подключаемый_ОбработкаВыбораЗатратНаДоставкуНаСервере(РезультатЗакрытия, мДополнительныеПараметры);
	
	Если мДополнительныеПараметры.Свойство("СоответствиеТаблицыРасходов") Тогда
		
		СоответствиеТаблицыРасходов = мДополнительныеПараметры.СоответствиеТаблицыРасходов;
		РасходыДокумента = ДополнительныеПараметры.Форма.Объект.Расходы;
		РасходыДокумента.Очистить();
		Для Каждого мСтрокаРасход Из СоответствиеТаблицыРасходов Цикл
			НоваяСтрока = РасходыДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, мСтрокаРасход.Значение);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Подключаемый_ДоставкаПриИзменении(Форма, ЗначениеРеквизита) Экспорт
	
	Элемент_АдресОтправления = Форма.элементы.Найти("УСОERP_АдресОтправления");
	Если НЕ Элемент_АдресОтправления = Неопределено Тогда
		Элемент_АдресОтправления.Доступность = ЗначениеРеквизита;
		Если ЗначениеРеквизита = Ложь Тогда
			Форма.Объект.УСОERP_АдресОтправления = ПредопределенноеЗначение("Справочник.УСОERP_ШаблоныАдресов.ПустаяСсылка");
		КонецЕсли;
	КонецЕсли;
	
	Элемент_АдресДоставки = Форма.элементы.Найти("УСОERP_АдресДоставки");
	Если НЕ Элемент_АдресДоставки = Неопределено Тогда
		Элемент_АдресДоставки.Доступность = ЗначениеРеквизита;
		Если ЗначениеРеквизита = Ложь Тогда
			Форма.Объект.УСОERP_АдресДоставки = ПредопределенноеЗначение("Справочник.УСОERP_ШаблоныАдресов.ПустаяСсылка");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


#Область ПрограммныйИнтерфейс

// Обработка проверки перода
//
// Параметры:
// Форма 							- форма, из обработчика события которой происходит вызов команды.
// ИмяКроссТаблицы 					- наименование элемента формы.
// ОповещениеОбновленияИнтерфейса 	- текст оповещениния.
//	
Процедура ПриИзмененииПериодаПлана(Форма, Знач ИмяКроссТаблицы, ОповещениеОбновленияИнтерфейса) Экспорт 
	
	Объект = Форма.Объект;
	Объект.НачалоПериода = НачалоМесяца(Объект.НачалоПериода);
	Объект.ОкончаниеПериода = КонецМесяца(Объект.ОкончаниеПериода);
	
	//ПланированиеКлиентСервер.УстановитьНачалоОкончаниеПериодаПлана(Объект.Периодичность, Объект.НачалоПериода, Объект.ОкончаниеПериода);
	
	Если ПланированиеКлиентСервер.НеобходимоОбновитьИнтерфейс(Объект, Форма, "РеквизитыДоИзменения") Тогда
		
		КроссТаблица = Форма[ИмяКроссТаблицы];
		Если Объект.КроссТаблица
			И КроссТаблица.ПолучитьЭлементы().Количество() > 0
			И Форма.Периоды.НайтиСтроки(Новый Структура("Активная", Истина)).Количество() > 0 Тогда
			ЗадаватьВопрос = Ложь;
			
			Если Форма["РеквизитыДоИзменения"].НачалоПериода <> Объект.НачалоПериода Тогда
				//И Объект.НачалоПериода > Форма["РеквизитыДоИзменения"].НачалоПериода Тогда
				ЗадаватьВопрос = Истина;
			КонецЕсли; 
			
			Если Форма["РеквизитыДоИзменения"].ОкончаниеПериода <> Объект.ОкончаниеПериода Тогда
				//И Объект.ОкончаниеПериода < Форма["РеквизитыДоИзменения"].ОкончаниеПериода Тогда
				ЗадаватьВопрос = Истина;
			КонецЕсли;
			
			Если ЗадаватьВопрос Тогда
				Кнопки = Новый СписокЗначений;
				Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru='Очистить таблицу'"));
				Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru='Отменить изменение периода'"));
				ТекстВопроса = НСтр("ru='Изменение периода плана приведет к удалению данных в таблице потребностей. Очистить таблицу?'");
				
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("Форма", Форма);
				ДополнительныеПараметры.Вставить("ИмяКроссТаблицы", ИмяКроссТаблицы);
				ДополнительныеПараметры.Вставить("ОповещениеОбновленияИнтерфейса", ОповещениеОбновленияИнтерфейса);
				Оповещение = Новый ОписаниеОповещения("ПриИзмененииПериодаПланаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
				
				ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки);
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ВыполнитьОбработкуОповещения(ОповещениеОбновленияИнтерфейса);
		
	КонецЕсли;
	
КонецПроцедуры

// Обработка изменения периода плана на основе пользовательского выбора
//
// Параметры:
// Результат 				- выбранный пользователем вариант ответа.
// ДополнительныеПараметры 	- структура с дополнительными параметрами (по умолчанию = Неопределено).
//	
Процедура ПриИзмененииПериодаПланаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
 	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ДополнительныеПараметры.Форма[ДополнительныеПараметры.ИмяКроссТаблицы].ПолучитьЭлементы().Очистить();
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеОбновленияИнтерфейса);
	
	Иначе
	
		ПланированиеКлиентСервер.ВосстановитьЗначенияИзПроверяемыхРеквизитов(
			ДополнительныеПараметры.Форма.Объект, 
			ДополнительныеПараметры.Форма, 
			"РеквизитыДоИзменения", 
			"Периодичность, НачалоПериода, ОкончаниеПериода");
	
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти
