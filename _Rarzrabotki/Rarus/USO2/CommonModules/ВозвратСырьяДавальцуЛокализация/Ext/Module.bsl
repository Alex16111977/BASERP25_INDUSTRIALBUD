	|		И Строки.СтатьяРасходов = Стоимости.СтатьяРасходов
	|		И Строки.РазделУчета = Стоимости.РазделУчета
	|		И Строки.ГруппаПродукции = Стоимости.ГруппаПродукции
	|ГДЕ
	|	Строки.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ПроизводственныеЗатраты)
	|	И ЕСТЬNULL(Стоимости.Сумма, 0) < 0
	|";
#КонецОбласти

	ТекстыОтражения = Новый Массив;
	ТекстыОтражения.Добавить(ТекстВозвратМатериаловДавальцу);
	ТекстыОтражения.Добавить(ТекстВозвратМатериаловДавальцуСкладПроизводства);
	ТекстыОтражения.Добавить(ТекстВозвратнаяТара);
	ТекстыОтражения.Добавить(ТекстВозвратнаяТараСкладПроизводства);
	ТекстыОтражения.Добавить(ТекстРасходыВОтклоненииВСтоимости);
	ТекстыОтражения.Добавить(ТекстРасходыВОтклоненииВСтоимостиСкладПроизводства);
	ТекстыОтражения.Добавить(ТекстДоходыВОтклоненииВСтоимости);
	ТекстыОтражения.Добавить(ТекстДоходыВОтклоненииВСтоимостиСкладПроизводства);
	
	Возврат СтрСоединить(ТекстыОтражения, ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении());
	
	//-- Локализация
	Возврат "";
	
КонецФункции

