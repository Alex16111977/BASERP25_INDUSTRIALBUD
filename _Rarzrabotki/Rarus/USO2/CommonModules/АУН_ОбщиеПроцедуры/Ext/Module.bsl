
#Область ПрограммныйИнтерфейс

// Для задания обработчиков параметров сеанса следует использовать шаблон:
// Обработчики.Вставить("<ИмяПараметраСеанса>|<НачалоИмениПараметраСеанса*>", "Обработчик");
//
// Примечание. Символ '*'используется в конце имени параметра сеанса и обозначает,
//             что один обработчик будет вызван для инициализации всех параметров сеанса
//             с именем, начинающимся на слово НачалоИмениПараметраСеанса
//
Процедура ОбработчикиИнициализацииПараметровСеанса(Обработчики) Экспорт
	
	Обработчики.Вставить("АУН_ПравилаДобавленияЭлементовФорм", "АУН_ОбщиеПроцедуры.УстановитьПараметрСеансаПравилаДобавленияЭлементовФорм");
	
КонецПроцедуры

// Процедура устанавливает параметры сеанса в рамках подсистемы АрендаНедвижимости.
Процедура УстановитьПараметрСеансаПравилаДобавленияЭлементовФорм(ИмяПараметра = Неопределено, УстановленныеПараметры = Неопределено) Экспорт
	
	ПравилаДобавленияЭлементовФорм = АУН_МодификацияКонфигурации.ПолучитьПравилаДобавленияЭлементовФорм();
	ПараметрыСеанса.АУН_ПравилаДобавленияЭлементовФорм = Новый ФиксированноеСоответствие(ПравилаДобавленияЭлементовФорм);
	Если УстановленныеПараметры <> Неопределено Тогда 
		УстановленныеПараметры.Добавить("АУН_ПравилаДобавленияЭлементовФорм");
	КонецЕсли;
	
КонецПроцедуры

// Возвращает структуру параметров, необходимых для работы клиентского кода
// при запуске конфигурации, т.е. в обработчиках событий
// - ПередНачаломРаботыСистемы,
// - ПриНачалеРаботыСистемы
//
// Важно: при запуске недопустимо использовать команды сброса кэша
// повторно используемых модулей, иначе запуск может привести
// к непредсказуемым ошибкам и лишним серверным вызовам
//
// Параметры:
//   Параметры - Структура - (возвращаемое значение) структура параметров работы клиента при запуске.
//
// Пример реализации:
//   Для установки параметров работы клиента можно использовать шаблон:
//
//     Параметры.Вставить(<ИмяПараметра>, <код получения значения параметра>);
//
//
Процедура ПараметрыРаботыКлиентаПриЗапуске(Параметры) Экспорт
	
	Если ПользователиКлиентСервер.ЭтоСеансВнешнегоПользователя() Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Переопределяет список команд печати, получаемый функцией УправлениеПечатью.КомандыПечатиФормы.
Процедура ПередДобавлениемКомандПечати(ИмяФормы, КомандыПечати, СтандартнаяОбработка) Экспорт
	
	Если ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента"
		ИЛИ ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаСписка" Тогда
		
		Если Пользователи.РолиДоступны("БазовыеПраваУТ") Тогда
			 
			// Акт об оказании услуг
			КомандаПечати = КомандыПечати.Добавить();
			КомандаПечати.МенеджерПечати = "Обработка.АУН_ПечатьДополнительныхФорм";
			КомандаПечати.Идентификатор = "АктСводный";
			КомандаПечати.Представление = НСтр("ru = 'Акт об оказании услуг (сводный по услугам)'");
			КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
			КомандаПечати.Порядок = 14.5;
			
		КонецЕсли;
		
		Если Пользователи.РолиДоступны("БазовыеПраваУТ") Тогда
			// Счет-фактура
			КомандаПечати = КомандыПечати.Добавить();
			КомандаПечати.МенеджерПечати = "Обработка.АУН_ПечатьДополнительныхФорм";
			КомандаПечати.Идентификатор = "СчетФактураСводный";
			КомандаПечати.Представление = НСтр("ru = 'Счет-фактура (сводный по услугам)'");
			КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
			КомандаПечати.ДополнительныеПараметры.Вставить("ПечатьВВалюте", Ложь);
			КомандаПечати.Порядок = 20.5;
		КонецЕсли;
		
		Если Пользователи.РолиДоступны("БазовыеПраваУТ") Тогда
			// Счет-фактура (в валюте)
			КомандаПечати = КомандыПечати.Добавить();
			КомандаПечати.МенеджерПечати = "Обработка.АУН_ПечатьДополнительныхФорм";
			КомандаПечати.Идентификатор = "СчетФактураВВалютеСводный";
			КомандаПечати.Представление = НСтр("ru = 'Счет-фактура (сводный по услугам, в валюте)'");
			КомандаПечати.ФункциональныеОпции = "ИспользоватьНесколькоВалют";
			КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
			КомандаПечати.ДополнительныеПараметры.Вставить("ПечатьВВалюте", Истина);
			КомандаПечати.Порядок = 21.5;
		КонецЕсли;

	ИначеЕсли ИмяФормы = "Документ.КорректировкаРеализации.Форма.ФормаДокумента" Тогда	
		
		Если Пользователи.РолиДоступны("БазовыеПраваУТ") Тогда
			
			// Акт об оказании услуг
			КомандаПечати = КомандыПечати.Добавить();
			КомандаПечати.МенеджерПечати = "Обработка.АУН_ПечатьДополнительныхФорм";
			КомандаПечати.Идентификатор = "АктСводный";
			КомандаПечати.Представление = НСтр("ru = 'Акт об оказании услуг (сводный по услугам)'");
			КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
			КомандаПечати.Порядок = 1.5;
			
		КонецЕсли;
		
		Если Пользователи.РолиДоступны("БазовыеПраваУТ") Тогда
			// Счет-фактура
			КомандаПечати = КомандыПечати.Добавить();
			КомандаПечати.МенеджерПечати = "Обработка.АУН_ПечатьДополнительныхФорм";
			КомандаПечати.Идентификатор = "СчетФактураСводный";
			КомандаПечати.Представление = НСтр("ru = 'Счет-фактура (сводный по услугам)'");
			КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
			КомандаПечати.ДополнительныеПараметры.Вставить("ПечатьВВалюте", Ложь);
			КомандаПечати.Порядок = 5.5;	
		КонецЕсли;

		Если Пользователи.РолиДоступны("БазовыеПраваУТ") Тогда
			// Счет-фактура (в валюте)
			КомандаПечати = КомандыПечати.Добавить();
			КомандаПечати.МенеджерПечати = "Обработка.АУН_ПечатьДополнительныхФорм";
			КомандаПечати.Идентификатор = "СчетФактураВВалюте";
			КомандаПечати.Представление = НСтр("ru = 'Счет-фактура (сводный по услугам, в валюте)'");
			КомандаПечати.ФункциональныеОпции = "ИспользоватьНесколькоВалют";
			КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
			КомандаПечати.ДополнительныеПараметры.Вставить("ПечатьВВалюте", Истина);
			КомандаПечати.Порядок = 6.5;	
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

