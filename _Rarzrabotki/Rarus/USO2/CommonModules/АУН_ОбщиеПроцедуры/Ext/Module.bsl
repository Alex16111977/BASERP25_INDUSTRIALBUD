// Функция возвращает состав реквизитов ссылки
Функция ПрочитатьДанныеОбъекта(ДокументОбъект, ПривестиКСтандартнымИменам = Ложь) Экспорт
	
	МетаданныеДокумента = ДокументОбъект.Ссылка.Метаданные();
	
	ДанныеОбъекта  = Новый Структура;
	Для Каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
		ДанныеОбъекта.Вставить(Реквизит.Имя, ДокументОбъект[Реквизит.Имя]);
	КонецЦикла;
	Для Каждого Реквизит Из МетаданныеДокумента.СтандартныеРеквизиты Цикл
		ДанныеОбъекта.Вставить(Реквизит.Имя, ДокументОбъект[Реквизит.Имя]);
	КонецЦикла;
	
	Если ПривестиКСтандартнымИменам Тогда
		КоллекцияРеквизитов = АУН_ОбщиеПроцедурыКлиентСервер.ПолучитьКоллекциюРеквизитов(ДокументОбъект);
		АУН_ОбщиеПроцедурыКлиентСервер.ПривестиСтруктуруДанныхКСтандартнымИменам(ДанныеОбъекта, КоллекцияРеквизитов);
	КонецЕсли;
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Процедура РеализацияИнициализироватьДанныеДляПроведенияПродажиПоАренде(Ссылка, ДополнительныеСвойства)
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеШапки.Дата КАК Период,
	|	ДанныеШапки.Организация,
	|	ДанныеШапки.Договор,
	|	ДанныеШапки.Контрагент,
	|	ДанныеШапки.ВалютаВзаиморасчетов,
	|	ДанныеШапки.АУН_НачалоПериода,
	|	ДанныеШапки.АУН_ОкончаниеПериода
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК ДанныеШапки
	|ГДЕ
	|	ДанныеШапки.Ссылка = &Ссылка";
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	
	Запрос.УстановитьПараметр("Период",          	Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация",     	Реквизиты.Организация);
	Запрос.УстановитьПараметр("Договор",  			Реквизиты.Договор);
	Запрос.УстановитьПараметр("Контрагент",  		Реквизиты.Контрагент);
	Запрос.УстановитьПараметр("НачалоПериода", 		Реквизиты.АУН_НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода", 	Реквизиты.АУН_ОкончаниеПериода);
	
	СтруктураКурса = АУН_ПроцедурыНачисления.ПолучитьКурсВалюты(Реквизиты.ВалютаВзаиморасчетов, Реквизиты.Период, Реквизиты.Договор);
	Запрос.УстановитьПараметр("КурсДокумента",		СтруктураКурса.Курс);
	Запрос.УстановитьПараметр("КратностьДокумента",	СтруктураКурса.Кратность);
	
	ВалютаУпр = Константы.ВалютаУправленческогоУчета.Получить();
	СтруктураКурса = АУН_ПроцедурыНачисления.ПолучитьКурсВалюты(ВалютаУпр, Реквизиты.Период, Реквизиты.Договор);
	Запрос.УстановитьПараметр("КурсУпр", 			СтруктураКурса.Курс);
	Запрос.УстановитьПараметр("КратностьУпр", 		СтруктураКурса.Кратность);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ТаблицаДокумента.НомерСтроки,
	|	&Ссылка КАК Ссылка,
	|	&Организация КАК Организация,
	|	&Контрагент КАК Контрагент,
	|	&Договор КАК Договор,
	|	ТаблицаДокумента.Номенклатура КАК УслугаАренды,
	|	ТаблицаДокумента.АУН_ОбъектАренды КАК ОбъектАренды,
	|	&НачалоПериода КАК ПериодАренды,
	|	ТаблицаДокумента.СуммаВзаиморасчетов * &КурсДокумента * &КратностьУпр / (&КурсУпр * &КратностьДокумента) КАК Сумма
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК ТаблицаДокумента
	|ГДЕ
	|	ТаблицаДокумента.Ссылка = &Ссылка";
	
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета();
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ПродажиПоАренде");
	
	ПроведениеСерверУТ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений);
	
КонецПроцедуры

Процедура ЗаписатьНаборыЗаписей(СтруктураНаборыЗаписей)
	
	Для Каждого СтрокаСтруктуры Из СтруктураНаборыЗаписей Цикл
		
		НаборЗаписей = СтрокаСтруктуры.Значение;
		Если НаборЗаписей <> Неопределено И НаборЗаписей.Количество() > 0 Тогда
			НаборЗаписей.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Функция возвращает число, соответствуещее цвету переданному в формате "R,G,B"
Функция ПолучитьЦвет(знач ЦветСтрока) Экспорт
	
	Если Не ЗначениеЗаполнено(ЦветСтрока) Тогда
		Возврат 255 + 255*256;
	Иначе
		Ном = Найти(ЦветСтрока, ",");
		КрасныйСтрока = Лев(ЦветСтрока, Ном - 1);
		Строка = Сред(ЦветСтрока, Ном + 1);
		Красный = Число(КрасныйСтрока);
		Ном = Найти(Строка, ",");
		ЗеленыйСтрока = Лев(Строка, Ном - 1);
		Строка = Сред(Строка, Ном + 1);
		Зеленый = Число(ЗеленыйСтрока);
		Синий = Число(Строка);
		Возврат Синий * 256 * 256 + Зеленый * 256 + Красный;
	КонецЕсли;
	
КонецФункции

Процедура СвернутьТаблицуЗначений(Таблица, СписокРесурсов, ИсключаемыеПоля = "") Экспорт
	
	СтруктураРесурсов = Новый Структура(СписокРесурсов);
	СтруктураИсключаемыхПолей = Новый Структура(ИсключаемыеПоля);
	
	СписокИзмерений = "";
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если СтруктураРесурсов.Свойство(Колонка.Имя) ИЛИ СтруктураИсключаемыхПолей.Свойство(Колонка.Имя) Тогда
			Продолжить;
		КонецЕсли;
		СписокИзмерений = СписокИзмерений + ?(ЗначениеЗаполнено(СписокИзмерений), ",", "") + Колонка.Имя;
	КонецЦикла;
	
	Таблица.Свернуть(СписокИзмерений, СписокРесурсов);
	
КонецПроцедуры

