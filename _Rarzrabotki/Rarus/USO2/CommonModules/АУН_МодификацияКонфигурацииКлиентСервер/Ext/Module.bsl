	ПараметрыСтраниц.Вставить("День"              , "АУН_ГруппаДень");
	
	// {УСО 2.0}:{Управление строительной организацией}{Мокшанов А.О.} {{ 
	Форма.АУН_Период = ВыборПериодаКлиентСервер.ПолучитьПредставлениеПериодаОтчета(
	//Форма.АУН_Период = ОтчетыУТКлиентСервер.ПолучитьПредставлениеПериодаОтчета(
	// {УСО 2.0}:{Управление строительной организацией}{Мокшанов А.О.} }} 
		Объект.АУН_ВидПериода, Объект.АУН_НачалоПериода, Объект.АУН_ОкончаниеПериода);
		
