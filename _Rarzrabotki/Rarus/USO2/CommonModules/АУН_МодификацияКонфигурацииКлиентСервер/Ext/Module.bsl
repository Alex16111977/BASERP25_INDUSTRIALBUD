// Процедура управления видимостью элементов на форме, модифицированных в рамках подсистемы АрендаНедвижимости.
Процедура УправлениеФормойЗаказРеализацияОбщий(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоАренда = Объект.АУН_Аренда;
	
	Элементы.АУН_ГруппаПериод.Видимость = ЭтоАренда;
	
	КолонкаЦена = Элементы.Найти("ТоварыЦена");
	Если НЕ КолонкаЦена = Неопределено Тогда
		КолонкаЦена.Заголовок = ?(ЭтоАренда, "Ставка", "Цена");	
	КонецЕсли;
	
	СписокВидимыхЭлементов = "
	|ТоварыКоличествоУпаковок,
	|ТоварыЦена,
	|АУН_ТоварыПодменюРассчитать,
	|ТоварыАУН_КоличествоДней,
	|ТоварыАУН_СпособНачисления,
	|ТоварыАУН_СтавкаСпособаНачисления,
	|ТоварыАУН_ОбъектАренды";
	
	СписокСкрытыхЭлементовАренды = "";
	
	СписокИгнорируемыхКолонокТовары = "
	|ТоварыНомерСтроки,
	|ТоварыНоменклатура,
	|ТоварыНоменклатураКод,
	|ТоварыНоменклатураАртикул,
	|ТоварыСодержание,
	|ТоварыВариантОбеспечения,
	|ТоварыКоличествоУпаковок,
	|ТоварыЦена,
	|ТоварыСумма,
	|ТоварыСуммаНДС,
	|ТоварыСуммаСНДС,
	|ТоварыСтавкаНДС,
	|ТоварыСуммаВзаиморасчетов,
	|ТоварыПроцентАвтоматическойСкидки,
	|ТоварыСуммаАвтоматическойСкидки,
	|ТоварыПроцентРучнойСтавки,
	|ТоварыСуммаРучнойСтавки,
	|ТоварыОтмененоПричиныОтменыНеИспользуются,
	|ТоварыГруппаОтмена,
	|ТоварыГруппаЗаказКлиента,
	|ТоварыДатаОтгрузки";
	
	СписокСкрытыхЭлементов = "
	|ГруппаСклад,
	|СтраницаДоставка,
	|ГруппаТара,
	|ГруппаТребуетсяЗалогЗаТару";
	
	СписокИгнорируемыхКомандТовары = "
	|ГруппаТоварыЗаполнить,
	|ГруппаТоварыСписок,
	|ТоварыДобавить,
	|ТоварыСкопировать,
	|ТоварыИзменить,
	|ТоварыУдалить,
	|ТоварыЗакончитьРедактирование,
	|ТоварыНайти,
	|ТоварыОтменитьПоиск,
	|ТоварыПереместить,
	|ТоварыСортировка,
	|ТоварыСкопироватьСтроки,
	|ТоварыВставитьСтроки,
	|ТоварыРазбитьСтроку,
	|ГруппаТоварыСкидкиНаценки,
	|ГруппаТоварыОтменаСтрок,
	|ЗаполнитьДатуОтгрузки,
	|ТоварыВыделитьВсе";
	
	МассивИгнорируемыхКолонокТовары = ПолучитьМассивИзСписка(СписокИгнорируемыхКолонокТовары);
	МассивИгнорируемыхКомандТовары = ПолучитьМассивИзСписка(СписокИгнорируемыхКомандТовары);
	МассивСкрытыхЭлементов = ПолучитьМассивИзСписка(СписокСкрытыхЭлементов);
	МассивВидимыхЭлементов = ПолучитьМассивИзСписка(СписокВидимыхЭлементов);
	МассивСкрытыхЭлементовАренды = ПолучитьМассивИзСписка(СписокСкрытыхЭлементовАренды);
	
	Если ЭтоАренда Тогда
		ТаблицаТовары = Элементы.Найти("Товары");
		Если НЕ ТаблицаТовары = Неопределено Тогда 
			Для Каждого Элемент Из ТаблицаТовары.ПодчиненныеЭлементы Цикл
				Если МассивИгнорируемыхКолонокТовары.Найти(Элемент.Имя) = Неопределено Тогда
					ДобавитьПриНеобходимостиВТаблицуСкрытыхЭлементов(Форма.АУН_СкрытыеЭлементы, Элемент.Имя, Элемент.Видимость);
					Элемент.Видимость = Ложь;
				КонецЕсли;
			КонецЦикла;
			Для Каждого Элемент Из ТаблицаТовары.КоманднаяПанель.ПодчиненныеЭлементы Цикл
				Если МассивИгнорируемыхКомандТовары.Найти(Элемент.Имя) = Неопределено Тогда
					ДобавитьПриНеобходимостиВТаблицуСкрытыхЭлементов(Форма.АУН_СкрытыеЭлементы, Элемент.Имя, Элемент.Видимость);
					Элемент.Видимость = Ложь;
				КонецЕсли;
			КонецЦикла;
			УстановитьВидимостьЭлементовИзКоллекции(Форма, МассивСкрытыхЭлементов, Ложь, Форма.АУН_СкрытыеЭлементы);
			УстановитьВидимостьЭлементовИзКоллекции(Форма, МассивВидимыхЭлементов, Истина);
			УстановитьВидимостьЭлементовИзКоллекции(Форма, МассивСкрытыхЭлементовАренды, Ложь);
		КонецЕсли;
	Иначе 
		Для Каждого Элемент Из МассивИгнорируемыхКолонокТовары Цикл
			Если НЕ МассивВидимыхЭлементов.Найти(Элемент) = Неопределено Тогда 
				МассивВидимыхЭлементов.Удалить(МассивВидимыхЭлементов.Найти(Элемент));	
			КонецЕсли;
		КонецЦикла;
		УстановитьВидимостьЭлементовИзКоллекции(Форма, МассивСкрытыхЭлементовАренды, Истина);
		УстановитьВидимостьЭлементовИзКоллекции(Форма, МассивВидимыхЭлементов, Ложь);
		Для Каждого Стр Из Форма.АУН_СкрытыеЭлементы Цикл
			Если Стр.ВидимостьПоУмолчанию Тогда
				Элемент = Элементы.Найти(Стр.ИмяЭлемента);
				Если НЕ Элемент = Неопределено Тогда
					Элемент.Видимость = Истина;	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Форма.АУН_СкрытыеЭлементы.Очистить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьВидимостьЭлементовИзКоллекции(Форма, Коллекция, Видимость, ТаблицаСкрытыхЭлементов = Неопределено)
	
	Для Каждого ИмяЭлемента Из Коллекция Цикл
		УстановитьВидимостьЭлемента(Форма, ИмяЭлемента, Видимость, ТаблицаСкрытыхЭлементов);
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьВидимостьЭлемента(Форма, ИмяЭлемента, Видимость, ТаблицаСкрытыхЭлементов = Неопределено)
	
	Элемент = Форма.Элементы.Найти(ИмяЭлемента);
	Если НЕ Элемент = Неопределено И НЕ Элемент.Видимость = Видимость Тогда
		ДобавитьПриНеобходимостиВТаблицуСкрытыхЭлементов(ТаблицаСкрытыхЭлементов, Элемент.Имя, Элемент.Видимость);
		Элемент.Видимость = Видимость;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПриНеобходимостиВТаблицуСкрытыхЭлементов(ТаблицаСкрытыхЭлементов, ИмяЭлемента, Видимость)
	
	Если ТаблицаСкрытыхЭлементов = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Если ТаблицаСкрытыхЭлементов.НайтиСтроки(Новый Структура("ИмяЭлемента", ИмяЭлемента)).Количество() = 0 Тогда
		Стр = ТаблицаСкрытыхЭлементов.Добавить();	
		Стр.ИмяЭлемента = ИмяЭлемента;
		Стр.ВидимостьПоУмолчанию = Видимость;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьМассивИзСписка(Список)
	
	Возврат СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрЗаменить(Список, Символы.ПС, ""),, Истина, Истина);
	
КонецФункции

#КонецОбласти
