&НаКлиенте
Функция ПолучитьМассивПолейШаблонаНаименования()
	МассивПолей = Новый Массив;
	МассивПолей.Добавить("НомерКвартиры");
	МассивПолей.Добавить("Подъезд");
	МассивПолей.Добавить("Этаж");
	МассивПолей.Добавить("КоличествоЖилыхКомнат");
	Возврат МассивПолей;
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КопироватьДанныеФормы(ЭтаФорма.Параметры, ЭтаФорма.Объект);
	
	Если Параметры.Свойство("ОбъектЭксплуатации")  Тогда
		Объект.ОбъектЭксплуатации = Параметры.ОбъектЭксплуатации;
	КонецЕсли;
	
	Если Параметры.Свойство("ОбъектНедвижимостиРодитель") Тогда
		Объект.ОбъектНедвижимостиРодитель = Параметры.ОбъектНедвижимостиРодитель;
		ПринадлежитОбъекту = Объект.ОбъектНедвижимостиРодитель;
	КонецЕсли;
	
	Объект.ШаблонНаименования = Объект.ОбъектНедвижимостиРодитель.ШаблонНаименования;
	Элементы.ОбъектЭксплуатации.ТолькоПросмотр = ЗначениеЗаполнено(Объект.ОбъектЭксплуатации);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаКонструкторШаблонаНаименования(Команда)
	
	//ФормаРедактированияШаблона = ПолучитьФорму("Обработка.УСОERP_БыстрыйВводОбъектовНедвижимости.Форма.ФормаРедактированияШаблонаНаименования",Новый Структура ("ШаблонНаименования,ОбъектНедвижимостиРодитель",Объект.ШаблонНаименования,Объект.ОбъектНедвижимостиРодитель),ЭтаФорма);
	//ФормаРедактированияШаблона.Открыть();
	
	ОткрытьФорму("Обработка.УСОERP_БыстрыйВводОбъектовНедвижимости.Форма.ФормаРедактированияШаблонаНаименования", Новый Структура("ШаблонНаименования,ОбъектНедвижимостиРодитель", Объект.ШаблонНаименования, Объект.ОбъектНедвижимостиРодитель), ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Объект.ШаблонНаименования = ВыбранноеЗначение;
КонецПроцедуры

&НаКлиенте
Процедура СформироватьНаименованиеПоШаблону(ТекущиеДанные)
	ТекущиеДанные.Доля = Объект.ШаблонНаименования;
	МассивПолей = ПолучитьМассивПолейШаблонаНаименования();
	Для Каждого Поле Из МассивПолей Цикл
		ТекущиеДанные.Доля = СтрЗаменить(ТекущиеДанные.Доля,"["+Поле+"]",ТекущиеДанные[Поле]);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДолиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Элемент.ТекущиеДанные.Модифицирован = Истина;
	Если НоваяСтрока Тогда
		ЗаполнитьЗначенияСвойств(Элемент.ТекущиеДанные,Объект.ОбъектНедвижимостиРодитель);
		СформироватьНаименованиеПоШаблону(Элемент.ТекущиеДанные);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДолиНомерПриИзменении(Элемент)
	СформироватьНаименованиеПоШаблону(Элементы.Доли.ТекущиеДанные)
КонецПроцедуры

&НаКлиенте
Процедура ДолиПодъездПриИзменении(Элемент)
	СформироватьНаименованиеПоШаблону(Элементы.Доли.ТекущиеДанные)
КонецПроцедуры

&НаКлиенте
Процедура ДолиКоличествоЖилыхКомнатПриИзменении(Элемент)
	СформироватьНаименованиеПоШаблону(Элементы.Доли.ТекущиеДанные)
КонецПроцедуры

&НаКлиенте
Процедура ДолиЭтажПриИзменении(Элемент)
	СформироватьНаименованиеПоШаблону(Элементы.Доли.ТекущиеДанные)
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОбъектыНедвижимостиНаСервере()
	ИзмененныеСтроки = Объект.Доли.НайтиСтроки(Новый Структура("Модифицирован",Истина));
	Для Каждого ИзмененнаяСтрока Из ИзмененныеСтроки Цикл
		//запись нового или модификация уже записанного объекта недвижимости
		Если ЗначениеЗаполнено(ИзмененнаяСтрока.ДоляОбъект) Тогда
			ОбъектНедвижимости = ИзмененнаяСтрока.ДоляОбъект.ПолучитьОбъект();
		Иначе
			ОбъектНедвижимости = Справочники.АУН_ОбъектыНедвижимости.СоздатьЭлемент();
		КонецЕсли;
		ОбъектНедвижимости.Наименование = ИзмененнаяСтрока.Доля;
		ЗаполнитьЗначенияСвойств(ОбъектНедвижимости,Объект);
		ЗаполнитьЗначенияСвойств(ОбъектНедвижимости,ИзмененнаяСтрока);
		ОбъектНедвижимости.Родитель = Объект.ОбъектНедвижимостиРодитель;
		ОбъектНедвижимости.КатегорияОбъекта = КатегорияОбъекта;
		ОбъектНедвижимости.ТипНедвижимости = ТипНедвижимости;
		ОбъектНедвижимости.ПринадлежитОбъекту = ПринадлежитОбъекту;
		ОбъектНедвижимости.Записать();
		ИзмененнаяСтрока.ДоляОбъект = ОбъектНедвижимости.Ссылка;
		
		//запись нового или модификация существующего документа регистрации параметров
		Если ИзмененнаяСтрока.ОбщаяПлощадь+ИзмененнаяСтрока.ЖилаяПлощадь+ИзмененнаяСтрока.КоличествоЖилыхКомнат>0 ИЛИ ЗначениеЗаполнено(ИзмененнаяСтрока.ДокументРегистрацииПараметровОбъектаНедвижимости) Тогда
			Если ЗначениеЗаполнено(ИзмененнаяСтрока.ДокументРегистрацииПараметровОбъектаНедвижимости) Тогда
				ДокументРегистрацияПараметров = ИзмененнаяСтрока.ДокументРегистрацииПараметровОбъектаНедвижимости.ПолучитьОбъект();
			Иначе
				ДокументРегистрацияПараметров = Документы.УПН_РегистрацияПараметровОбъектовНедвижимости.СоздатьДокумент();
			КонецЕсли;
			
			ДокументРегистрацияПараметров.Организация = Объект.Организация;
			ДокументРегистрацияПараметров.ВидОперации = Перечисления.УПН_ВидыОперацийРегистрацияПараметровОбъектовНедвижимости.ИзменениеПлощадей;
			ДокументРегистрацияПараметров.Дата = ТекущаяДата();
			ДокументРегистрацияПараметров.Заполнить(Неопределено);
			
			ДокументРегистрацияПараметров.ПараметрыОбъектов.Очистить();
			НоваяСтрока = ДокументРегистрацияПараметров.ПараметрыОбъектов.Добавить();
			НоваяСтрока.ОбъектНедвижимости = ИзмененнаяСтрока.ДоляОбъект;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ИзмененнаяСтрока);
			
			ДокументРегистрацияПараметров.Записать(РежимЗаписиДокумента.Запись);
			
			Попытка
				ДокументРегистрацияПараметров.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
			Исключение
			КонецПопытки;
		КонецЕсли;
		ИзмененнаяСтрока.ДокументРегистрацииПараметровОбъектаНедвижимости = ДокументРегистрацияПараметров.Ссылка;
		
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Создан документ %1'"), ДокументРегистрацияПараметров.Ссылка));
		
		ИзмененнаяСтрока.Модифицирован = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьОбъектыНедвижимости(Команда)
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьОбъектыНедвижимостиНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументЦеныНаОбъектНедвижимостиНаСервере(ДанныеФормы)
	
	ДокументРегистрацияЦен = Документы.УПН_РегистрацияЦенОбъектовНедвижимости.СоздатьДокумент();
	ДокументРегистрацияЦен.ТипОперации 	= Перечисления.УПН_ТипыОперацийСНедвижимостью.Продажа;
	ДокументРегистрацияЦен.Дата 		= ТекущаяДата();
	ДокументРегистрацияЦен.Заполнить(Неопределено);
	
	Для Каждого ТекСтрока Из Объект.Доли Цикл
		НоваяСтрока = ДокументРегистрацияЦен.ЦеныОбъектовНедвижимости.Добавить();
		НоваяСтрока.ОбъектНедвижимости 		= ТекСтрока.ДоляОбъект;
		НоваяСтрока.ЦенаЗаЕдиницуПлощади 	= ТекСтрока.ЦенаЗаЕдиницуИзмерения;
		НоваяСтрока.Стоимость 				= ТекСтрока.ЦенаЗаЕдиницуИзмерения * ТекСтрока.ОбщаяПлощадь;
	КонецЦикла;
	
	ЗначениеВДанныеФормы(ДокументРегистрацияЦен, ДанныеФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьЦеныНаОбъектНедвижимости(Команда)
	
	Если Объект.Доли.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ТекСтрокаТЧ Из Объект.Доли Цикл
		Если Не ЗначениеЗаполнено(ТекСтрокаТЧ.ДоляОбъект) Тогда
			ПоказатьПредупреждение(,"Для регистрации цен новые объекты необходимо сначала записать!");
			Возврат;
		КонецЕсли;
	КонецЦикла;
		
	Форма = ПолучитьФорму("Документ.УПН_РегистрацияЦенОбъектовНедвижимости.Форма.ФормаДокумента",, ЭтаФорма);
	ДанныеФормы = Форма.Объект;
	СоздатьДокументЦеныНаОбъектНедвижимостиНаСервере(ДанныеФормы);
	КопироватьДанныеФормы(ДанныеФормы, Форма.Объект);
	Форма.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНовыеСтрокиКопированием(Команда)
	ТекущийНомерПомещения = НомерКопирования;
	Для Каждого СтрокаКопирования  Из Элементы.Доли.ВыделенныеСтроки Цикл
		НоваяСтрока = Объект.Доли.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Объект.Доли[СтрокаКопирования]);
		НоваяСтрока.Модифицирован = Истина;
		НоваяСтрока.ДоляОбъект = Неопределено;
		НоваяСтрока.ДокументРегистрацииПараметровОбъектаНедвижимости = Неопределено;
		НоваяСтрока.Подъезд = ПодъездКопирования;
		НоваяСтрока.Этаж = ЭтажКопирования;
		НоваяСтрока.НомерКвартиры = ТекущийНомерПомещения;
		СформироватьНаименованиеПоШаблону(НоваяСтрока);
		ТекущийНомерПомещения = ТекущийНомерПомещения + 1;
	КонецЦикла;
КонецПроцедуры





