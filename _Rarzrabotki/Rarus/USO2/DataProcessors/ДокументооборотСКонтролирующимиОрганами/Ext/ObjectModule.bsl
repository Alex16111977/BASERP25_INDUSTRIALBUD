		ЗапросHTTP = Новый HTTPЗапрос("/FtsDocumentsMvc/PartEdit/Validate/" + ИдентификаторРедактированияФормы, ЗаголовкиHTTP);
		
		ИмяФайлаОтвета = ПолучитьИмяВременногоФайла();
		
