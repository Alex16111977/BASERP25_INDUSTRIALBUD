Функция ЭтоПротокол2НДФЛ_КНД1110307(ТранспортноеСообщение) Экспорт
	
	// Приказ ФНС России от 02.10.2018 N ММВ-7-11/566@
	
	Результат = СведенияИзПротокола2НДФЛ_1110307(ТранспортноеСообщение);
	
	Возврат Результат.Представленные > 0
		ИЛИ Результат.ПринятыхНаОбработку > 0
		ИЛИ Результат.СправокСОшибками > 0
		ИЛИ Результат.Принятые > 0;
	
КонецФункции

Функция СведенияИзПротокола2НДФЛ_1110307(ТранспортноеСообщение)
	
	// Приказ ФНС России от 02.10.2018 N ММВ-7-11/566@
	
	Результат = Новый Структура();
	Результат.Вставить("Представленные", 0);
	Результат.Вставить("ПринятыхНаОбработку", 0);
	Результат.Вставить("СправокСОшибками", 0);
	Результат.Вставить("Принятые", 0);
	
	// ищем протокол 2-НДФЛ среди содержимого сообщения
	Попытка 
		Протоколы2НДФЛ = ПолучитьВложенияТранспортногоСообщения(
			ТранспортноеСообщение, 
			Истина, 
			Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Протокол2НДФЛ);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Обновление статуса 2-НДФЛ';
					|en = 'Electronic document workflow with controlling authorities. 2-TDI status update'"),
				УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		Возврат Результат;
	КонецПопытки;
		
	КоличествоПротоколов = Протоколы2НДФЛ.Количество();
	Если КоличествоПротоколов = 0 Тогда
		Возврат Результат;
	Иначе
		Протокол2НДФЛ = Протоколы2НДФЛ[0];
	КонецЕсли;
	
	// загружаем протокол из файла в строку
	ТекстОшибки = "";
	ТекстПротокола = ТекстИзФайлаВСтроку(Протокол2НДФЛ, ТекстОшибки);
	Если НЕ ЗначениеЗаполнено(ТекстПротокола) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстПротокола = ВРег(ТекстПротокола);
	
	Количество = КоличествоСведенийВПротоколе2НДФЛ(ТекстПротокола, "КОЛИЧЕСТВО СПРАВОК, ПРЕДСТАВЛЕННЫХ НАЛОГОВЫМ АГЕНТОМ");
	Результат.Вставить("Представленные", Количество);	
	
	Количество = КоличествоСведенийВПротоколе2НДФЛ(ТекстПротокола, "КОЛИЧЕСТВО ПРИНЯТЫХ НА ОБРАБОТКУ СПРАВОК");
	Результат.Вставить("ПринятыхНаОбработку", Количество);	
	
	Количество = КоличествоСведенийВПротоколе2НДФЛ(ТекстПротокола, "КОЛИЧЕСТВО СПРАВОК С ОШИБКАМИ");
	Результат.Вставить("СправокСОшибками", Количество);	
	
	Количество = КоличествоСведенийВПротоколе2НДФЛ(ТекстПротокола, "КОЛИЧЕСТВО ПРИНЯТЫХ СПРАВОК");
	Результат.Вставить("Принятые", Количество);
	
	Возврат Результат;
	
КонецФункции

