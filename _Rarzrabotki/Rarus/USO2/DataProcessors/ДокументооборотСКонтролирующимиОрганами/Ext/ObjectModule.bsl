				ЭлементПредупреждения = ТекстИзHTML(ЭлементПредупреждения);
				Если ЗначениеЗаполнено(ЭлементПредупреждения) Тогда
					ТекстПредупреждения = ЭлементПредупреждения + ": " + ТекстПредупреждения;
				КонецЕсли;
				
				ПолеПредупреждения = ТекстПослеПрефикса(ТекстУзлаПредупреждения, " path='", "'");
				ПолеПредупреждения = Строка(ПолеПредупреждения);
				ПолеПредупреждения = ТекстИзHTML(ПолеПредупреждения);
				Если ЗначениеЗаполнено(ПолеПредупреждения) Тогда
					ТекстПредупреждения = ТекстПредупреждения + " (" + ПолеПредупреждения + ")";
				КонецЕсли;
				
				ТекстыПредупреждений = ТекстыПредупреждений + ?(ЗначениеЗаполнено(ТекстыПредупреждений), "
					|", "") + ТекстПредупреждения;
			КонецЕсли;
			
			ТекстОтвета = Сред(ТекстОтвета, ПозицияПослеПостфикса);
		КонецЦикла;
		
		ПараметрыСоединения.ОписаниеОшибкиСервером = СтрШаблон(
			НСтр("ru = 'При проверке есть предупреждения, в том числе возможна недостоверность заявленных сведений о товарах"
					+ " по средним ценам, весу (в конце в скобках указано поле ошибки с индексом строки товара):
					   |%1
					   |
					   |В большинстве случаев, замечания при поверке достоверности сведений о товарах означают ошибки или опечатки"
