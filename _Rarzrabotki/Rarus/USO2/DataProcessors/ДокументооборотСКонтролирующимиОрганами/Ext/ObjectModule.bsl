Функция РазобратьВходящееПисьмоФНС(ФайлПисьма)
	
	Дерево = ЗагрузитьXMLВДеревоЗначений(ФайлПисьма);
	Если НЕ ЗначениеЗаполнено(Дерево) Тогда // значит письмо в формате txt - такое возможно, несмотря на формат
		ТекстПисьма = ПрочитатьТекстИзФайла(ФайлПисьма);
		Возврат Новый Структура("Дата, Текст", Неопределено, ТекстПисьма);
	Иначе
		
		УзелПисьмоОтв = Дерево.Строки.Найти("ПисьмоОтв", "Имя", Истина);
		Если УзелПисьмоОтв = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Результат = Новый Структура("Дата, Текст");
		
		УзелДатаПисьмо = УзелПисьмоОтв.Строки.Найти("ДатаПисьмо", "Имя");
		Если УзелДатаПисьмо <> Неопределено Тогда
			Результат.Дата = ДатаПоСтроке(УзелДатаПисьмо.Значение);
		КонецЕсли;
		
		УзелПисьмоТекст = УзелПисьмоОтв.Строки.Найти("ПисьмоТекст", "Имя");
		Если УзелДатаПисьмо <> Неопределено Тогда
			Результат.Текст = XMLЗначениеВнутр(Тип("Строка"), УзелПисьмоТекст.Значение);
		КонецЕсли;
		
		Возврат Результат;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСвойстваОписиВходящихДокументов(ФайлДокумент) Экспорт
	
	СтруктураСвойств = Новый Структура;
	
	ТаблицаДокументов = Новый Массив;
		
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений(ФайлДокумент);
	КодНО = ИзвлечьДанное(ДеревоXML, "КодНО");
	
	КНДТребования = ИзвлечьДанное(ДеревоXML, "КНД");
	ЭтоНовыйФорматОписи = КНДТребования = "1184002";
	
	СтруктураСвойств.Вставить("НалоговыйОрган", 		Справочники.НалоговыеОрганы.НайтиПоКоду(КодНО));
	СтруктураСвойств.Вставить("Идентификатор",			ИзвлечьДанное(ДеревоXML, "ИдФайл"));
	СтруктураСвойств.Вставить("ИдентификаторОснования",	ИзвлечьДанное(ДеревоXML, "ИдФайлЗаяв"));
	СтруктураСвойств.Вставить("ДатаФормирования",		ДатаИзСтроки(ИзвлечьДанное(ДеревоXML, "ДатаДок")));
	
	Если ЭтоНовыйФорматОписи Тогда
		Подписант = ПолучитьСвойстваПодписантаОписиВходящихДокументов(ДеревоXML);
		СтруктураСвойств.Вставить("Подписант", Подписант);
	КонецЕсли;
		
	УзлыИнфСообДок = ДеревоXML.Строки.НайтиСтроки(Новый Структура("Имя", "ИнфСообДок"), Истина);
	
	Для каждого УзелИнфСообДок Из УзлыИнфСообДок Цикл
		
		РеквизитыДокумента = Новый Структура;
		СписокИменФайловВложений = Новый СписокЗначений;
		
		Если ЭтоНовыйФорматОписи Тогда
			КНДДокумента = ИзвлечьДанное(УзелИнфСообДок, "КНД_Док");
		Иначе
			КНДДокумента = ИзвлечьДанное(УзелИнфСообДок, "ВидФайлДок");
		КонецЕсли;
		
		РеквизитыДокумента.Вставить("ВидДокумента", 	КНДДокумента);
		РеквизитыДокумента.Вставить("НомерДокумента", 	ИзвлечьДанное(УзелИнфСообДок, "НомФайлДок"));
		РеквизитыДокумента.Вставить("ДатаДокумента", 	ДатаИзСтроки(ИзвлечьДанное(УзелИнфСообДок, "ДатаФайлДок")));
		
		УзлыИмяФайл = УзелИнфСообДок.Строки.НайтиСтроки(Новый Структура("Имя", "ИмяФайл"), Истина);
		Для каждого УзелИмяФайл Из УзлыИмяФайл Цикл
			СписокИменФайловВложений.Добавить(УзелИмяФайл.Значение);
		КонецЦикла;	
		
		НовыйДокумент = Новый Структура();
		НовыйДокумент.Вставить("РеквизитыДокумента", 		РеквизитыДокумента);
		НовыйДокумент.Вставить("СписокИменФайловВложений", 	СписокИменФайловВложений);
		
		ТаблицаДокументов.Добавить(НовыйДокумент);
		
	КонецЦикла;
	
	СтруктураСвойств.Вставить("ТаблицаДокументов", ТаблицаДокументов);
	
	Возврат СтруктураСвойств;
	
КонецФункции

Функция ПолучитьСвойстваПодписантаОписиВходящихДокументов(ДеревоXML)
	
	Подписант = Неопределено;
	
	УзлыПодписант = ДеревоXML.Строки.НайтиСтроки(Новый Структура("Имя", "Подписант"), Истина);
	Для каждого УзелПодписант Из УзлыПодписант Цикл
		
		Подписант = Новый Структура;
		Подписант.Вставить("ПодписантДолжность", ИзвлечьДанное(УзелПодписант, "Должн"));
		Подписант.Вставить("ПодписантТелефон", 	 ИзвлечьДанное(УзелПодписант, "Тлф"));
		Подписант.Вставить("ПодписантПочта", 	 ИзвлечьДанное(УзелПодписант, "E-mail"));
		
		УзелыФИО = УзелПодписант.Строки.НайтиСтроки(Новый Структура("Имя", "ФИО"), Истина);
		Если УзелыФИО.Количество() > 0 Тогда
			
			УзелФИО = УзелыФИО[0];
		
			ПодписантФИО = Новый Массив;
			ПодписантФИО.Добавить(ИзвлечьДанное(УзелФИО, "Фамилия"));
			ПодписантФИО.Добавить(ИзвлечьДанное(УзелФИО, "Имя"));
			ПодписантФИО.Добавить(ИзвлечьДанное(УзелФИО, "Отчество"));
			
			ПодписантФИО = СтроковыеФункцииКлиентСервер.СтрокаИзМассиваПодстрок(ПодписантФИО, " ", Истина);
			Подписант.Вставить("ПодписантФИО", 	ПодписантФИО);
			
		Иначе
			Подписант.Вставить("ПодписантФИО", 	"");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Подписант;
	
КонецФункции

