	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеДатыОтправкиФСГС Тогда
		
		СообщениеДокументыКоторогоПодписываются = СообщениеОснование;
		
		ТипыДИВ = Новый Массив;
		ТипыДИВ.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеОператораФСГС);
		
	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПротоколВходногоКонтроляОтчетностиФСГС Тогда
		
		СообщениеДокументыКоторогоПодписываются = Сообщение;
		
		ТипыДИВ = Новый Массив;
		ТипыДИВ.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолученииДокументаФСГС);
		
	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееФСГС Тогда
		
		СообщениеДокументыКоторогоПодписываются = Сообщение;
		
		ТипыДИВ = Новый Массив;
		ТипыДИВ.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПисьмоФСГС);
		ТипыДИВ.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПриложениеПисьмаФСГС);
		
	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПисьмоВходящееФСГС Тогда
	
		СообщениеДокументыКоторогоПодписываются = Сообщение;
	
		ТипыДИВ = Новый Массив;
		ТипыДИВ.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолученииДокументаФСГС);
	Иначе 
	
		СообщениеДокументыКоторогоПодписываются = Сообщение;
	
	КонецЕсли;
	
	Возврат Новый Структура("СообщениеДокументыКоторогоПодписываются, ТипыДИВ", СообщениеДокументыКоторогоПодписываются, ТипыДИВ);
	
КонецФункции

Функция ПодготовитьПараметрыПодписатьСообщение(Знач КонтролирующийОрган, 
                                               ЭтоЭлектроннаяПодписьВМоделиСервиса,
                                               Знач Сообщение,
                                               Знач ТипСообщения,
                                               Знач СертификатПодписанта, 
                                               Знач УчетнаяЗапись,
                                               Знач СообщениеОснование) Экспорт

	Если КонтролирующийОрган = "ФНС" Тогда
		Результат = ПолучитьНаборДокументовНаПодписаниеФНС(Сообщение, ТипСообщения);
	ИначеЕсли КонтролирующийОрган = "ПФР" Тогда
		Результат = ПолучитьНаборДокументовНаПодписаниеПФР(Сообщение, ТипСообщения, СообщениеОснование);
	ИначеЕсли КонтролирующийОрган = "ФСГС" Тогда
		Результат = ПолучитьНаборДокументовНаПодписаниеФСГС(Сообщение, ТипСообщения, СообщениеОснование);		
	КонецЕсли;

	СообщениеДокументыКоторогоПодписываются = Результат.СообщениеДокументыКоторогоПодписываются;
	ТипыДИВ = Результат.ТипыДИВ;
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса = Неопределено Тогда		
		ЭтоЭлектроннаяПодписьВМоделиСервиса = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(УчетнаяЗапись).ЭлектроннаяПодписьВМоделиСервиса;
	КонецЕсли;

	// формируем массив сертификатов
	Если СертификатПодписанта = Неопределено Тогда
		СертификатыПодписантов = Новый Массив;
		СертификатыПодписантов.Добавить("Руководитель");
	ИначеЕсли ТипЗнч(СертификатПодписанта) = Тип("Строка") ИЛИ ТипЗнч(СертификатПодписанта) = Тип("Структура") Тогда
		СертификатыПодписантов = Новый Массив;
		СертификатыПодписантов.Добавить(СертификатПодписанта);
	Иначе
		СертификатыПодписантов = СертификатПодписанта;
	КонецЕсли;
	
	// получаем объекты сертификатов
	Для Инд = 0 По СертификатыПодписантов.Количество() - 1 Цикл
		Серт = СертификатыПодписантов[Инд];
		Если ТипЗнч(Серт) = Тип("Строка") Тогда
			Отпечаток = ПолучитьОтпечаток(УчетнаяЗапись, Серт,);
			СертификатыПодписантов[Инд] = Новый Структура("ЭтоЭлектроннаяПодписьВМоделиСервиса, Отпечаток", ЭтоЭлектроннаяПодписьВМоделиСервиса, Отпечаток);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФункции = Новый Структура;
	ПараметрыФункции.Вставить("СообщениеДокументыКоторогоПодписываются", СообщениеДокументыКоторогоПодписываются);
	ПараметрыФункции.Вставить("Сообщение", Сообщение);
	ПараметрыФункции.Вставить("СертификатыПодписантов", СертификатыПодписантов);
	ПараметрыФункции.Вставить("ТипыДИВ", ТипыДИВ);
	ПараметрыФункции.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	ПараметрыФункции.Вставить("ИспользоватьДлительныйМаркерБезопасности", МожноИспользоватьДлительныйМаркерБезопасностиДляСообщения(ТипСообщения));
	
	Возврат ПараметрыФункции;

КонецФункции

Функция МожноИспользоватьДлительныйМаркерБезопасностиДляСообщения(ТипСообщения) 

	// Считаем, что использовать на сервере длительный маркер безопасности можно для автоподписания тех служебных квитанций,
	// которые автоматически отправляются при интерактивном работе в клиентском сеансе пользователя.
	ТипыАвтоотправляемыхСообщений = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ТипыАвтоотправляемыхСообщений();
	
	Если ТипыАвтоотправляемыхСообщений.Найти(ТипСообщения) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	// ФНС
	Если ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПисьмоНП  // Извещение о получении письма налогового органа
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДокументНП Тогда // Результат приема документа налогоплательщиком
		
	 	// Квитанции на документы, связанные с письмам и требованиями ФНС, автоматически не отправляем.
		Возврат Ложь;
	 
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

Процедура ПодписатьСообщение(КонтролирующийОрган, КонтекстОтправки, Сообщение, ТипСообщения, СертификатПодписанта = Неопределено,
								УчетнаяЗапись = Неопределено, СообщениеОснование = Неопределено, СообщениеОбОшибке = "")

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	ЭтоЭлектроннаяПодписьВМоделиСервиса = Неопределено;
	КонтекстОтправки.Свойство("ЭПВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);

	ПараметрыФункции = ПодготовитьПараметрыПодписатьСообщение(
		КонтролирующийОрган,
		ЭтоЭлектроннаяПодписьВМоделиСервиса,
		Сообщение,
		ТипСообщения,
		СертификатПодписанта,
		УчетнаяЗапись,
		СообщениеОснование);

	КонтекстОтправки.Вставить("ЭПВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	ПараметрыФункции.Вставить("КонтекстОтправки", КонтекстОтправки);

	ДокументыДляПодписания = ПодготовитьДокументыДляПодписания(
		ПараметрыФункции.СообщениеДокументыКоторогоПодписываются,
		ПараметрыФункции.Сообщение,
		ПараметрыФункции.СертификатыПодписантов,
		ПараметрыФункции.ТипыДИВ,
		"");
	
	ПодписатьСообщенияПоследовательно(ПараметрыФункции, ДокументыДляПодписания, СообщениеОбОшибке);
			
КонецПроцедуры

Процедура ПодписатьСообщенияПоследовательно(ПараметрыФункции, ДокументыДляПодписания, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	// Подписание на стороне сервера возможно только в режиме "ЭлектроннаяПодписьВМоделиСервиса".
	ЭПВМоделиСервиса = ПараметрыФункции.КонтекстОтправки.ЭПВМоделиСервиса;
	Если НЕ ЭПВМоделиСервиса Тогда
		СообщениеОбОшибке = "ЭтоНеЭлектроннаяПодписьВМоделиСервиса";
		Возврат;
	КонецЕсли;

	// Для вызова методов криптосервиса вызывающий код должен заранее установить маркеры безопасности.
	ПараметрыПодписания = Новый Структура();
	ПараметрыПодписания.Вставить("ОтсоединеннаяПодпись", Истина);
	Если ПараметрыФункции.Свойство("ИспользоватьДлительныйМаркерБезопасности") Тогда
		ПараметрыПодписания.Вставить("ИспользоватьДлительныйМаркерБезопасности", ПараметрыФункции.ИспользоватьДлительныйМаркерБезопасности);
	КонецЕсли;
	
	Для ТекущийДокумент = 0 По ДокументыДляПодписания.ВГраница() Цикл
		
		ДокументДляПодписывания = ДокументыДляПодписания[ТекущийДокумент];
		Данные = ИзвлечьДвоичныеДанныеПриНеобходимости(ДокументДляПодписывания.Данные);

		// Предполагается, что текущие методы для отправки со стороны сервера 
		// вызываются внутри фонового задания, поэтому к сервису подписания обращаемся напрямую
		// (уже без дополнительного фонового задания).
		Попытка
			ДанныеПодписи = СервисКриптографии.Подписать(
				Данные,
				ДокументДляПодписывания.Сертификат,
				"CMS",
				ПараметрыПодписания);
		Исключение
			// Запись в журнал регистрации зарегистрирована исходным методом, повторно не регистрируем.
			СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат;
		КонецПопытки;
			
		// Если возникла ошибка при подписании, то прерываемся.
		Если ТипЗнч(ДанныеПодписи) = Тип("Структура") Тогда
			СообщениеОбОшибке = ДанныеПодписи.КодВозврата;
			Возврат;
		КонецЕсли;

		ИмяФайлаПодписи = СгенерироватьИмяФайлаДокументаВСоставеПакета();
		ДокументДляПодписывания.Вставить("ИмяФайлаПодписи", ИмяФайлаПодписи);	
		СтрокаBase64 = Base64Строка(ДанныеПодписи);

		// Cохраняем в регистр.
		ДобавитьСодержимоеТранспортногоКонтейнера(ПараметрыФункции.Сообщение,
			Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись,
			Новый Структура("Строка64", СтрокаBase64),
			ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДокументДляПодписывания.ИмяФайлаПодписи).Имя,
			,
			ДокументДляПодписывания.ИмяФайла,
			ДокументДляПодписывания.Сертификат.Отпечаток,
			Перечисления.СтатусыПроверкиЭЦП.Валидна,
			Истина);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПодготовитьДокументыДляПодписания(СообщениеДокументыКоторогоПодписываются, Сообщение, СертификатыПодписантов, ТипыДИВ, ВременныйКаталог = "") Экспорт
	
	// получаем список ДИВ для подписания и существующие подписи
	ВложенияИПодписи = ПолучитьФайлыСообщенияДляПодписи(СообщениеДокументыКоторогоПодписываются, Сообщение, СертификатыПодписантов, ТипыДИВ);
	ВложенияДИВ = ВложенияИПодписи.ВложенияДИВ;
	Подписи = ВложенияИПодписи.Подписи;
	
	
	ДокументыДляПодписания = Новый Массив;
	
	// перебираем сертификаты
	Для Каждого ОбъектСертификат Из СертификатыПодписантов Цикл
		
		// определяем какие сообщения без подписи текущего подписанта
		ТребующиеПодписания = Новый Массив;
		Для Каждого ВложениеДИВ Из ВложенияДИВ Цикл
			Если НЕ СуществуютПодписиСЗаданнымИменемФайлаИСертификатом(Подписи, ВложениеДИВ.ИмяФайла, ОбъектСертификат.Отпечаток) Тогда
				ТребующиеПодписания.Добавить(ВложениеДИВ);
			КонецЕсли;
		КонецЦикла;
		
		Если ТребующиеПодписания.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// создаем массив с именами документов, требующих подписания
		Для Каждого СтрДокументНаПодпись Из ТребующиеПодписания Цикл
			ДокументДляПодписывания = Новый Структура;
			ДокументДляПодписывания.Вставить("Данные", СтрДокументНаПодпись.Данные);
			ДокументДляПодписывания.Вставить("Сертификат", ОбъектСертификат);
			ДокументДляПодписывания.Вставить("ПолноеИмяФайла", ВременныйКаталог + СтрДокументНаПодпись.ИмяФайла);
			ДокументДляПодписывания.Вставить("ИмяФайла", СтрДокументНаПодпись.ИмяФайла);
			
			ДокументыДляПодписания.Добавить(ДокументДляПодписывания);
		КонецЦикла;
		
	КонецЦикла;

	Возврат ДокументыДляПодписания;
	
КонецФункции

Функция ПолучитьФайлыСообщенияДляПодписи(СообщениеДокументыКоторогоПодписываются, Сообщение, СертификатыПодписантов, ТипыДИВ)
	
	// получаем ДИВ
	ВложенияДИВ = ПолучитьВложенияТранспортногоСообщения(СообщениеДокументыКоторогоПодписываются, Истина, ТипыДИВ);
	ВложенияДИВ.Колонки.Добавить("Данные64", Новый ОписаниеТипов("Строка"));
	Для Каждого Стр Из ВложенияДИВ Цикл
		Стр.Данные64 = ПоместитьВоВременноеХранилище(Стр.Данные.Получить(), Новый УникальныйИдентификатор);
	КонецЦикла;
	
	// удаляем колонку с двоичными данными
	ВложенияДИВ.Колонки.Удалить(ВложенияДИВ.Колонки.Данные);
	
	// переименовываем колонку со строкой Данные64 в Данные
	ВложенияДИВ.Колонки.Данные64.Имя = "Данные";
	
	СтруктураДИВ = ТрансформироватьТЗвМассивСтруктур(ВложенияДИВ);
	
	// получаем подписи
	Подписи = ПолучитьВложенияТранспортногоСообщения(Сообщение, , Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись);
	СтруктураПодписи = ТрансформироватьТЗвМассивСтруктур(Подписи);

	Возврат Новый Структура("ВложенияДИВ, Подписи", СтруктураДИВ, СтруктураПодписи);
	
КонецФункции

Функция ТрансформироватьТЗвМассивСтруктур(ВложенияДИВ)
	
	МассивРезультат = Новый Массив;
	Для Каждого Стр Из ВложенияДИВ Цикл
		
		НовСтруктура = Новый Структура;
		Для Каждого КолонокаВлождениеДИВ Из ВложенияДИВ.Колонки Цикл
			НовСтруктура.Вставить(КолонокаВлождениеДИВ.Имя, Стр[КолонокаВлождениеДИВ.Имя]);
		КонецЦикла;
		
		МассивРезультат.Добавить(НовСтруктура);
		
	КонецЦикла;
	
	Возврат МассивРезультат;
	
КонецФункции

Функция СуществуютПодписиСЗаданнымИменемФайлаИСертификатом(Подписи, ИмяФайла, Отпечаток)
	
	Для Каждого Стр Из Подписи Цикл
		Если Стр.ЭЦПИмяПодписанногоФайла = ИмяФайла И Стр.ЭЦПСертификат = Отпечаток Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

Функция ИзвлечьДвоичныеДанныеПриНеобходимости(Параметр)
	
	ИзвлеченныеДанные = Новый Массив;
	Если ТипЗнч(Параметр) = Тип("Массив") ИЛИ ТипЗнч(Параметр) = Тип("ФиксированныйМассив") Тогда
		Для Индекс = 0 По Параметр.ВГраница() Цикл
			ИзвлеченныеДанные.Добавить(ИзвлечьДвоичныеДанныеИзВременногоХранилищаПриНеобходимости(Параметр[Индекс]));
		КонецЦикла;
	Иначе
		ИзвлеченныеДанные = ИзвлечьДвоичныеДанныеИзВременногоХранилищаПриНеобходимости(Параметр);
	КонецЕсли;
	
	Возврат ИзвлеченныеДанные;
	
КонецФункции

Функция ИзвлечьДвоичныеДанныеИзВременногоХранилищаПриНеобходимости(Параметр)
	
	Если ТипЗнч(Параметр) = Тип("Строка") И ЭтоАдресВременногоХранилища(Параметр) Тогда
		Возврат ПолучитьИзВременногоХранилища(Параметр);
	Иначе
		Возврат Параметр;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ОтправкаОтчетовНаСервереБезКлиентскогоВзаимодействия

// Отправляет временный пароль в виде sms лицу, которое должно подтвердить отправку отчета.
//
// Параметры:
//	ДокументСсылка - ДокументСсылка.РегламентированныйОтчет - Заполненный отчет,
//                 для отправки которого необходимо получить временный пароль.
//	СпособДоставкиПаролей - Строка - Одно из значений "phone" или "email".
//	ПовторнаяОтправка - Булево - Истина, если требуется повторная отправка.
//	СообщениеОбОшибке - Строка - Текст сообщения об ошибке, либо пустая строка, если ошибок не возникло.
//
// Возвращаемое значение:
//	Структура - см. СервисКриптографииСлужебный.ПолучитьВременныйПароль()
//
Функция ПолучитьВременныйПарольДляОбъектаОтправки(ДокументСсылка, СпособДоставкиПаролей, ПовторнаяОтправка, СообщениеОбОшибке) Экспорт

	СообщениеОбОшибке = "";
	Результат = Неопределено;
	
	МассивОбъектовСертификатов = ПолучитьСертификатыДляОбъектаОтправки(ДокументСсылка, СообщениеОбОшибке, Истина);

	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если МассивОбъектовСертификатов.Количество() = 0 Тогда
		СообщениеОбОшибке = НСтр("ru = 'Не найден сертификат лица, которое может подписать отчет';
								|en = 'Certificate of a person who can sign the report is not found'");
		Возврат Неопределено;
	КонецЕсли;
		 
	Попытка

		// Чтобы в конфигурациях со старыми версиями БТС не возникали ошибки компиляции,
		// обращаемся к общему модулю через функцию БСП.
		// Для возможности отправки отчетов на стороне сервера из таких конфигураций потребуется обновить БТС до 1.0.17.
		МодульСервисКриптографии = ОбщегоНазначения.ОбщийМодуль("СервисКриптографии");
	
		Результат = МодульСервисКриптографии.ПолучитьВременныйПароль(
			 МассивОбъектовСертификатов[0].Идентификатор,
			 ПовторнаяОтправка,
			 СпособДоставкиПаролей);
		
	Исключение
	
		СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, СообщениеОбОшибке, ДокументСсылка);
	
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Получает по переданному временному паролю сеансовый ключ для отправки декларации.
//
Процедура ПодтвердитьВременныйПарольДляОбъектаОтправки(ДокументСсылка, ВременныйПароль, СообщениеОбОшибке) Экспорт

	МассивОбъектовСертификатов = ПолучитьСертификатыДляОбъектаОтправки(ДокументСсылка, СообщениеОбОшибке, Истина);

	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
	
	Если МассивОбъектовСертификатов.Количество() = 0 Тогда
		СообщениеОбОшибке = НСтр("ru = 'Не найден сертификат лица, которое может подписать отчет';
								|en = 'Certificate of a person who can sign the report is not found'");
		Возврат;
	КонецЕсли;
	
	Попытка

		// Чтобы в конфигурациях со старыми версиями БТС не возникали ошибки компиляции,
		// обращаемся к общему модулю через функцию БСП.
		// Для возможности отправки отчетов на стороне сервера из таких конфигураций потребуется обновить БТС до 1.0.17.
	
		МодульСервисКриптографии = ОбщегоНазначения.ОбщийМодуль("СервисКриптографии");
	
		МодульСервисКриптографии.ПодтвердитьВременныйПароль(МассивОбъектовСертификатов[0].Идентификатор, ВременныйПароль);
	
	Исключение

		СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, СообщениеОбОшибке, ДокументСсылка);
	
	КонецПопытки;
	
КонецПроцедуры

// Возвращает структуру с дополнительными параметрами для ОтправитьРегламентированныйОтчет().
//
// Возвращаемое значение:
//	Структура - Содержит ключи:
//		* ТолькоПроверкаБезОтправки - Булево - Если Истина, то выполняются только проверки возможности отправки,
//          которые не требуют обращения к маркерам безопасности. Собственно отправка не выполняется.
//			По умолчанию Ложь.
//		* ТребуетсяАвтонастройкаУчетнойЗаписи - Булево - Если Истина, то будет произведена автонастройка учетной записи перед отправкой.
//			По умолчанию Истина.
//
Функция НовыеПараметрыОтправки() Экспорт

	Результат = Новый Структура();
	Результат.Вставить("ТолькоПроверкаБезОтправки",           Ложь);
	Результат.Вставить("ТребуетсяАвтонастройкаУчетнойЗаписи", Истина);
	
	Возврат Результат;

КонецФункции

// Выполняет отправку регламентированного отчета, поддерживающего отправку на стороне сервера без обращения к клиентскому контексту.
//
// Параметры:
//	СсылкаНаОтчет - ДокументСсылка.* - Документ, содержащий данные отчета для отправки.
//		Допустимы типы документов, которые содержатся в составе типов измерения Ссылка регистра сведений ЖурналОтчетовСтатусы.
//	СообщениеОбОшибке - Строка - Текст с сообщением о возникшей ошибке. Если пусто, то отправка прошла успешно.
//	ПараметрыОтправки - Структура, Неопределено - см. НовыеПараметрыОтправки().
//
Процедура ОтправитьРегламентированныйОтчет(СсылкаНаОтчет, СообщениеОбОшибке, ПараметрыОтправки = Неопределено) Экспорт

	// Внимание!
	// ---------
	// В модуле общей формы РегламентированнаяОтчетность есть аналогичные процедуры 
	//	- ОтправитьОтчетПодтверждениеОтправкиОтчетаЗавершение(),
	//	- ПроверкаВозможностиВыгрузкиРегламентированногоОтчетаПередОтправкой(),
	//	- ОтправитьОтчетЗавершение(),
	// а также в общих модулях:
	//  - ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПриНажатииНаКнопкуОтправкиВКонтролирующийОрган()
	//  - ДокументооборотСКОКлиент.ПриНажатииНаКнопкуОтправкиВКонтролирующийОрган(),
	//    ОтправкаВКонтролирующийОрганПослеПодтвержденияОтправки() 
	// и вызываемые из них, которые используется при отправке отчетов в интерактивном режиме пользователем.
	//
	// При изменениях необходимо синхронно менять такие процедуры.

	СообщениеОбОшибке = "";

	Если НЕ ЗначениеЗаполнено(СсылкаНаОтчет) Тогда
		СообщениеОбОшибке = НСтр("ru = 'Не указан отчет для отправки';
								|en = 'Report for sending is not specified'");
		Возврат;
	КонецЕсли;
	
	ВидКонтролирующегоОргана = ТипКонтролирующегоОрганаДляОбъектаОтправки(СсылкаНаОтчет);

	// Без взаимодействия с клиентским контекстом в настоящее время доступна только отправка в ФНС, ПФР и ФСС.
	Если ВидКонтролирующегоОргана <> Перечисления.ТипыКонтролирующихОрганов.ФНС
		И ВидКонтролирующегоОргана <> Перечисления.ТипыКонтролирующихОрганов.ПФР
		И ВидКонтролирующегоОргана <> Перечисления.ТипыКонтролирующихОрганов.ФСС Тогда
		СообщениеОбОшибке = СтрШаблон("Отправка отчетности в ""%1"" возможна только в интерактивном режиме работы", ВидКонтролирующегоОргана);
		Возврат;
	КонецЕсли;

	ТолькоПроверкаБезОтправки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		ПараметрыОтправки, "ТолькоПроверкаБезОтправки", Ложь);

	ТребуетсяАвтонастройкаУчетнойЗаписи = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		ПараметрыОтправки, "ТребуетсяАвтонастройкаУчетнойЗаписи", Истина);

	КонтролирующийОрган = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ИмяПеречисления(ВидКонтролирующегоОргана);

	// Определим организацию отправляемого отчета.
	Если НЕ ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", СсылкаНаОтчет.Метаданные()) Тогда
		СообщениеОбОшибке = СтрШаблон(НСтр("ru = 'Отсутствует реквизит ""Организация"" у объекта ""%1"", отправка невозможна';
											|en = '""Company"" attribute of the ""%1"" object is missing, cannot send'"), СсылкаНаОтчет);
		Возврат;
	КонецЕсли;
	ОрганизацияОтчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОтчет, "Организация");

	// Создадим структуру с данными отчета, используемыми при отправке
	// см. ДокументооборотСКОКлиент.ПриНажатииНаКнопкуОтправкиВКонтролирующийОрган()
	
	ПараметрыОтчета = Новый Структура;

	ПараметрыОтчета.Вставить("СсылкаНаОтчет",					СсылкаНаОтчет);
	ПараметрыОтчета.Вставить("КонтролирующийОрган",				КонтролирующийОрган);
	ПараметрыОтчета.Вставить("ЭтоОтправкаИзФормыОтчетность",	Ложь);
	ПараметрыОтчета.Вставить("ОрганизацияОтчета",				ОрганизацияОтчета);
	// В настоящее время перечисленные ниже типы сообщений не поддерживаются при работе на сервере без клиентского взаимодействия.
	ПараметрыОтчета.Вставить("ЭтоУведомлениеФНС",				Ложь);
	ПараметрыОтчета.Вставить("ЭтоЖурналСчетовФактурФНС",		Ложь);
	ПараметрыОтчета.Вставить("ЭтоРеестрНДС",					Ложь);
	ПараметрыОтчета.Вставить("ЭтоРеестрАкцизы",					Ложь);
	ПараметрыОтчета.Вставить("ТолькоПроверкаБезОтправки",           ТолькоПроверкаБезОтправки);
	ПараметрыОтчета.Вставить("ТребуетсяАвтонастройкаУчетнойЗаписи", ТребуетсяАвтонастройкаУчетнойЗаписи);
	
	Если ТипЗнч(СсылкаНаОтчет) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
		// Отдельные виды проверок доступны только для видов документов "РегламентированныйОтчет".
		ПредставлениеДокументаРеглОтч = Неопределено;

		ПараметрыРеглОтчета = РегламентированнаяОтчетностьВызовСервера.ПолучитьПараметрыФормыИзСохраненногоОтчета(
			СсылкаНаОтчет,
			ПредставлениеДокументаРеглОтч);

		// Допишем в общие параметры отчета.
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыОтчета, ПараметрыРеглОтчета, Истина);

		ПередОтправкойРегламентированногоОтчета(ПараметрыОтчета, СообщениеОбОшибке);
		Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
			Возврат;
		КонецЕсли;

		ПередВыгрузкойРегламентированногоОтчета(ПараметрыОтчета, СообщениеОбОшибке);
		Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
			Возврат;
		КонецЕсли;
		
		ПроверкаФорматаПоПериодуПрименения(ПараметрыОтчета, СообщениеОбОшибке);
		Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
			Возврат;
		КонецЕсли;

	КонецЕсли;

	// Проверку наличия необработанного заявления на изменения не выполняем,
	// как при интерактивной работе - см. КонтейнерКлиентскихМетодов.ЗавершитьНастройкуЗаявленияНаИзменение() - 
	// т.к. такое заявление может не влиять на текущую отправку и возвращать о нем ошибку в мобильное приложение не нужно.
	// Если же оно является критичным для текущей отправки (например, заявление на продление окончившегося сертификата),
	// то текущая отправка будет прервана по ошибке на более поздних шагах.

	Если КонтролирующийОрган = "ФСС" Тогда 
		ОтправкаРегламентированногоОтчетаВФСС(ПараметрыОтчета, СообщениеОбОшибке);	
	Иначе

		// Общие для всех остальных контролирующих органов предварительные процедуры перед отправкой.
		ПроверитьЧтоЭДОПодключен(ПараметрыОтчета, СообщениеОбОшибке);
		Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
			Возврат;
		КонецЕсли;
		
		Если КонтролирующийОрган = "ФНС" Тогда
			ОтправкаРегламентированногоОтчетаВФНС(ПараметрыОтчета, СообщениеОбОшибке);
		ИначеЕсли КонтролирующийОрган = "ПФР" Тогда
			ОтправкаРегламентированногоОтчетаВПФР(ПараметрыОтчета, СообщениеОбОшибке);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьСертификатыДляОбъектаОтправки(ДокументСсылка, СообщениеОбОшибке, ТребуетсяАвтонастройкаУчетнойЗаписи)

	СообщениеОбОшибке = "";
	
	УчетнаяЗапись = УчетнаяЗаписьПоОбъектуОтправки(ДокументСсылка);
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		СообщениеОбОшибке = "ПоказатьФормуПредложениеОформитьЗаявлениеНаПодключение";
		Возврат Неопределено;
	КонецЕсли;
	
	// Выполним автонастройку учетной записи, чтобы в дальнейшем работать с актуальными сертификатами.
	Если ТребуетсяАвтонастройкаУчетнойЗаписи Тогда
		АвтоматическаяНастройкаУчетнойЗаписи(УчетнаяЗапись, СообщениеОбОшибке);
		Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	// Получим сертификаты из учетной записи.
	НастройкиУчетнойЗаписи = ПолучитьНастройкиУчетнойЗаписиИзИБ(УчетнаяЗапись);
	
	Сертификаты = СформироватьПакетФНС_ПодготовитьСертификатыДляПоиска(
		УчетнаяЗапись,
		НастройкиУчетнойЗаписи.СертификатРуководителя,
		НастройкиУчетнойЗаписи.СертификатГлавногоБухгалтера,
		НастройкиУчетнойЗаписи.СертификатДляШифрования);

	Если Сертификаты = Неопределено Тогда
		СообщениеОбОшибке = ТекстСообщенийПользователю();
		Возврат Неопределено;
	КонецЕсли;
		
	// Проверку сертификатов не выполняем, т.к. для нее требуется обращение к сервису криптографии,
	// а мы сейчас только готовимся запросить у него временный пароль для дальнейшей работы.
	РезультатПоиска = НайтиСертификаты(Сертификаты, Ложь);
	
	ОбъектыСертификатов = СформироватьПакетФНС_ПроверкиСертификатовПослеПолученияСертификатовРазобратьНайденное(
		РезультатПоиска.Сертификаты,
		НастройкиУчетнойЗаписи.СертификатРуководителя,
		НастройкиУчетнойЗаписи.СертификатГлавногоБухгалтера,
		НастройкиУчетнойЗаписи.СертификатДляШифрования);

	МассивОбъектовСертификатов = СертификатыДляПодписанияПоТипуСообщения(
		 Перечисления.ТипыТранспортныхСообщений.ДекларацияНП,
		 ОбъектыСертификатов.ОбъектСертификатРуководителя,
		 ОбъектыСертификатов.ОбъектСертификатГлавногоБухгалтера,
		 ОбъектыСертификатов.ОбъектСертификатОтветственногоЗаШифрование);
		 
	Возврат МассивОбъектовСертификатов;

КонецФункции

Процедура ПередОтправкойРегламентированногоОтчета(ПараметрыОтчета, СообщениеОбОшибке)

	ПроверкаОнлайнБлокировки(ПараметрыОтчета, "О", СообщениеОбОшибке);

КонецПроцедуры

Процедура ПередВыгрузкойРегламентированногоОтчета(ПараметрыОтчета, СообщениеОбОшибке)
	
	ПроверкаОнлайнБлокировки(ПараметрыОтчета, "В", СообщениеОбОшибке);
	
КонецПроцедуры

Процедура ПроверкаФорматаПоПериодуПрименения(ПараметрыОтчета, СообщениеОбОшибке)
	
	// Если механизм выключен, то прервем проверку.
	Если НЕ ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.МеханизмОнлайнСервисовВключен() Тогда
		Возврат;
	КонецЕсли;
	
	// Имя отчета
	ИДОтчета = ПараметрыОтчета.ИсточникОтчета;
	
	// Получаем период отчета.
	ДатаКонцаПериодаОтчета = ПараметрыОтчета.мДатаКонцаПериодаОтчета;
	
	// Получаем имя формы.
	ИмяФормы = ВРЕГ(ПараметрыОтчета.мВыбраннаяФорма);
	
	СведенияПоБлокировке = ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.ПроверкаФорматаПоПериодуПримененияСервер(
		ПараметрыОтчета, ДатаКонцаПериодаОтчета, ИмяФормы, ИДОтчета);
		
	// Если проверка показала, что блокировать не нужно, то предупреждения не показываем.
	Если СведенияПоБлокировке.РезультатПроверки Тогда
		Возврат;
	КонецЕсли;
	
	Если СведенияПоБлокировке.Свойство("ТекстПодробнее") И СведенияПоБлокировке.Свойство("ТекстИспользуйте") Тогда
		ТекстКомментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1. Необходимо использовать %2.';
				|en = '%1. It is required to use %2.'"), СведенияПоБлокировке.ТекстПодробнее, СведенияПоБлокировке.ТекстИспользуйте);
	Иначе
		ТекстКомментарий = НСтр("ru = 'Формат выгрузки более не применяется. Попробуйте позже.';
								|en = 'Export format is not applied anymore. Try again later.'");
	КонецЕсли;

	СообщениеОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'В настоящее время отправить %1 нельзя по причине: %2';
			|en = 'You cannot send %1 now due to: %2'"),
		ПараметрыОтчета.мСохраненныйДок, ТекстКомментарий);
	
КонецПроцедуры

// Выполняет проверку того, что форма отчета не заблокирована для использования, отправки и т.п.
//
// Параметры:
//	ПараметрыОтчета - Структура - См. РегламентированнаяОтчетностьВызовСервера.ПолучитьПараметрыФормыИзСохраненногоОтчета().
//	БлокируемаяФункция - Строка - Допустимые значения: "И" - использование, "О" - отправка, "П" - печать, 
//		"ПВ" - внешняя печать, "В" - выгрузка, "ЗГ" - загрузка, "З" - заполнение.
//	СообщениеОбОшибке - Строка - Текст с сообщением о возникшей ошибке. Если пусто, то отправка прошла успешно.
//
Процедура ПроверкаОнлайнБлокировки(ПараметрыОтчета, БлокируемаяФункция = "И", СообщениеОбОшибке = "")

	Если НЕ ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.МеханизмОнлайнСервисовВключен() Тогда
		Возврат;
	КонецЕсли;
	
	ПолноеИмяФормы = РегламентированнаяОтчетностьВызовСервера.ПолныйПутьКФорме(
		ПараметрыОтчета.ИсточникОтчета, ПараметрыОтчета.мВыбраннаяФорма);
	
	ОбъектОтчета = РегламентированнаяОтчетностьВызовСервера.ОбъектОтчета(ПолноеИмяФормы);
	
	ВерсияОтчета = РегламентированнаяОтчетностьВызовСервера.ПолучитьВерсиюРегламентированногоОтчета(ОбъектОтчета);
	ВерсияВыпуска = ВРЕГ(?(ЗначениеЗаполнено(ВерсияОтчета),
		ВерсияОтчета,
		ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.ИнформацияОПрограмме().ВерсияКонфигурации));
	
	ИДОтчета = ПараметрыОтчета.ИсточникОтчета;
	ИДФормы  = ВРЕГ(ПараметрыОтчета.мВыбраннаяФорма);
	
	СведенияПоБлокировке = ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.ПроверкаОнлайнБлокировкиСервер(
		ВерсияВыпуска, ИДОтчета, ИДФормы, БлокируемаяФункция);
	
	// Если проверка показала, что блокировать не нужно
	// либо блокируется отправка, но модуль уже обновлен на тот, который содержит исправление ошибки,
	// то предупреждения не показываем.
	Если СведенияПоБлокировке.РезультатПроверки 
		ИЛИ (БлокируемаяФункция = "О" И ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.ВерсияМодуляВБазеСодержитИсправление(
				СведенияПоБлокировке.ВерсияМодуляДокументооборотаСИсправлениемОшибки) = Истина) Тогда
		Возврат;
	КонецЕсли;

	СообщениеОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'В настоящее время отправить %1 нельзя по причине: %2. Попробуйте позже.';
			|en = 'You cannot send %1 now due to: %2. Try again later.'"),
		ПараметрыОтчета.мСохраненныйДок, СведенияПоБлокировке.Комментарий);

КонецПроцедуры

Процедура ПроверитьЧтоЭДОПодключен(ПараметрыОтчета, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В общем модуле ДокументооборотСКОКлиент есть аналогичная процедура ПроверитьЧтоЭДОПодключенПослеДобавленияКонтекстаВПараметры(),
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	НастроенОбменВУниверсальномФормате = Ложь;
	УчетнаяЗаписьПредназначенаДляДокументооборотаСКО = Ложь;
	
	ДокументооборотСКОВызовСервера.ПриНажатииНаКнопкуОтправкиВКонтролирующийОрган(
		ПараметрыОтчета.ОрганизацияОтчета, 
		ПараметрыОтчета.КонтролирующийОрган, 
		НастроенОбменВУниверсальномФормате, 
		УчетнаяЗаписьПредназначенаДляДокументооборотаСКО);

	Если НЕ НастроенОбменВУниверсальномФормате Тогда
		
		ПроверитьСтатусПодключенияПередОтправкой(ПараметрыОтчета.СсылкаНаОтчет, СообщениеОбОшибке);

		Возврат;
		
	Иначе

		Если УчетнаяЗаписьПредназначенаДляДокументооборотаСКО = Ложь Тогда
			
			СообщитьОНеподключенномНаправлении(ПараметрыОтчета.СсылкаНаОтчет, СообщениеОбОшибке);
			Возврат;
			
		ИначеЕсли ДокументооборотСКОКлиентСервер.ЭтоФНС(ПараметрыОтчета.КонтролирующийОрган)
			И НЕ ДокументооборотСКОВызовСервера.ОрганизацияПодключенаКИнспекции(ПараметрыОтчета.СсылкаНаОтчет) Тогда
			
			СообщитьОНеподключенномНаправлении(ПараметрыОтчета.СсылкаНаОтчет, СообщениеОбОшибке);
			Возврат;
			
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

//Преобразует текст в ДвоичныеДанные, при необходимости предварительно кодирует в base64
//КодироватьВBase64 и ДекодироватьИзBase64 взаимоисключающие параметры
Процедура ОбработкаДанныхХранилищаНаСервере(Адрес, ПреобразоватьВДвоичныеДанные = Ложь, КодироватьВBase64 = Ложь, ДекодироватьИзBase64 = Ложь, ПолноеИмяФайлаНаСервере = Неопределено, ИгнорироватьКодировку = Ложь)
	
	Данные = ПолучитьИзВременногоХранилища(Адрес);
	
	РаботаемСДД = ТипЗнч(Данные) = Тип("ДвоичныеДанные");
	
	Если РаботаемСДД И ПреобразоватьВДвоичныеДанные И Не КодироватьВBase64 И Не ДекодироватьИзBase64 Тогда
		Возврат;
	КонецЕсли;
	
	Временный = ПолучитьИмяВременногоФайла("bin");
		
	Если ДекодироватьИзBase64 Тогда
						
		Если РаботаемСДД Тогда			
			Данные.Записать(Временный);
			
			ТД = Новый ТекстовыйДокумент();
			ТД.Прочитать(Временный);
			ДанныеBase64 = ТД.ПолучитьТекст();
			ДД = Base64Значение(ДанныеBase64);
		Иначе
			ДД = Base64Значение(Данные);
		КонецЕсли;
		
		Если Не ПреобразоватьВДвоичныеДанные Тогда
			ДД.Записать(Временный);
			
			ТД = Новый ТекстовыйДокумент();
			ТД.Прочитать(Временный);
			ДанныеBase64 = ТД.ПолучитьТекст();
			
			ДД = ДанныеBase64;
		КонецЕсли;
		
	ИначеЕсли КодироватьВBase64 Тогда
		
		Если РаботаемСДД Тогда
			Б64Данные = Base64Строка(Данные);
		Иначе			
			//<?xml version="1.0" encoding="utf-8"?>
			Кодировка = "windows-1251";
			Декларация = Лев(Данные, 50);
			Если (Найти(НРег(Декларация), "utf-8")>0) или (Найти(НРег(Декларация), "encoding=") = 0) Тогда //Нет указания кодировки или явно указано UTF-8
				Кодировка = КодировкаТекста.UTF8;
			КонецЕсли;
			ТД = Новый ТекстовыйДокумент();
			ТД.УстановитьТекст(Данные); 
			ТД.Записать(Временный, Кодировка, "");
	
			ДД = Новый ДвоичныеДанные(Временный);
			Б64Данные = Base64Строка(ДД);
		КонецЕсли;			

		ТД = Новый ТекстовыйДокумент();
		ТД.УстановитьТекст(Б64Данные); 
		ТД.Записать(Временный, "windows-1251", "");
		
		Если ПреобразоватьВДвоичныеДанные Тогда
			ДД = Новый ДвоичныеДанные(Временный);
		Иначе
			ДД = Б64Данные;
		КонецЕсли;
	ИначеЕсли ПреобразоватьВДвоичныеДанные И Не РаботаемСДД Тогда
		Кодировка = "windows-1251";
		
		Если НЕ ИгнорироватьКодировку Тогда
			Декларация = Лев(Данные, 50);
			Если (Найти(НРег(Декларация), "encoding=""utf-8")>0)  Тогда //Явно указано UTF-8
				Кодировка = КодировкаТекста.UTF8;
			КонецЕсли;
		КонецЕсли;
			
		ТД = Новый ТекстовыйДокумент();
		ТД.УстановитьТекст(Данные); 
		ТД.Записать(Временный, Кодировка, "");
	
		ДД = Новый ДвоичныеДанные(Временный);
	КонецЕсли;	
	
	ПоместитьВоВременноеХранилище(ДД, Адрес);
	
	Если ПолноеИмяФайлаНаСервере = Неопределено Тогда
		УдалитьФайлы(Временный);
	Иначе
		ПолноеИмяФайлаНаСервере = Временный;
	КонецЕсли;
	
КонецПроцедуры

Функция ЗагрузитьДанныеНаСервер(ТекстФайлаВыгрузки, УникальныйИдентификатор, ПолноеИмяФайлаНаСервере = Неопределено, ПреобразоватьВДвоичныеДанные = Ложь, КодироватьВBase64 = Ложь, ДекодироватьИзBase64 = Ложь, ИгнорироватьКодировку = Ложь) Экспорт
	
	Адрес = ПоместитьВоВременноеХранилище(ТекстФайлаВыгрузки, УникальныйИдентификатор);
	Если ПреобразоватьВДвоичныеДанные Или КодироватьВBase64 Или ДекодироватьИзBase64 Тогда
		ОбработкаДанныхХранилищаНаСервере(Адрес, ПреобразоватьВДвоичныеДанные, КодироватьВBase64, ДекодироватьИзBase64, ПолноеИмяФайлаНаСервере, ИгнорироватьКодировку);	
	КонецЕсли;
	Возврат Адрес;
	
КонецФункции

Функция КодПодчиненности(ХранилищеДанныхОтчета) Экспорт
	
	Код = "";
	ДанныеОтчета = ХранилищеДанныхОтчета.Получить();
	Если ДанныеОтчета.ПоказателиОтчета.Свойство("ПолеТабличногоДокументаТитульный") Тогда
		ТитульныйЛист = ДанныеОтчета.ПоказателиОтчета.ПолеТабличногоДокументаТитульный;
	Иначе
		ТитульныйЛист = ДанныеОтчета.ПоказателиОтчета.ПолеТабличногоДокументаПриложение1;
	КонецЕсли;
	Если ТитульныйЛист.Свойство("КодПодчиненности") Тогда
		Код = ТитульныйЛист.КодПодчиненности;
	ИначеЕсли ТитульныйЛист.Свойство("КодПодчиненности_1") Тогда
		Код = ТитульныйЛист.КодПодчиненности_1
			+ ТитульныйЛист.КодПодчиненности_2
			+ ТитульныйЛист.КодПодчиненности_3
			+ ТитульныйЛист.КодПодчиненности_4
			+ ТитульныйЛист.КодПодчиненности_5;
	КонецЕсли;
	
	Возврат Код;
	
КонецФункции

Функция ВидОтправляемогоДокументаПоСсылке(ОбъектСсылка) Экспорт
	
	ТипОбъекта = Тип(ОбъектСсылка);
	ТаблицаОписания = РегламентированнаяОтчетность.ТаблицаОписанияОбъектовРегламентированнойОтчетности();
	СтрокаТаблицыОписания = ТаблицаОписания.Найти(ТипОбъекта, "ТипОбъекта");
	
	Если СтрокаТаблицыОписания = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СтрокаТаблицыОписания.ВидЭлектронногоПредставления;
	
КонецФункции

Функция ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(Контекст) Экспорт
	
	// отправляем
	Если НЕ ОтправитьТранспортноеСообщение(Контекст.ТранспортноеСообщение) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось отправить транспортное сообщение!';
								|en = 'Cannot send a transport message.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// пишем статус отправки
	ЗаписатьСтатусОтправкиОбъекта(Контекст.Документ, Перечисления.СтатусыОтправки.Отправлен);
	
	Возврат Истина;
	
КонецФункции

// Возвращает текст файла выгрузки регламентированного отчета.
//
// Параметры:
// 	РезультатВыгрузки - Структура - результат выгрузки, см. РегламентированнаяОтчетность.НовыйРезультатВыгрузкиРеглОтчета().
//
// Возвращаемое значение:
//	Строка - Текст файла выгрузки или пустая строка, если выгрузка не выполнена.
//
Функция ТекстФайлаВыгрузки(РезультатВыгрузки)

	Если НЕ РезультатВыгрузки.РеглОтчетВыгружен Тогда
		Возврат "";
	КонецЕсли;

	ФайлВыгрузки = ПолучитьИзВременногоХранилища(РезультатВыгрузки.АдресФайлаВыгрузки);
	
	Если ФайлВыгрузки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	ФайлВыгрузки.Записать(ИмяВременногоФайла);

	ЧтениеТекста = Новый ЧтениеТекста(ИмяВременногоФайла, РезультатВыгрузки.КодировкаФайлаВыгрузки);

	ТекстВыгрузки = ЧтениеТекста.Прочитать();

	ЧтениеТекста.Закрыть();
	ЧтениеТекста = Неопределено;

	УдалитьФайлы(ИмяВременногоФайла);

	Возврат ТекстВыгрузки;

КонецФункции

// Возвращает тексты с описание ошибок выгрузки.
//
// Параметры:
// 	РезультатВыгрузки - Структура - результат выгрузки, см. РегламентированнаяОтчетность.НовыйРезультатВыгрузкиРеглОтчета().
//	СохраненныйОтчет - ДокументСсылка.РегламентированныйОтчет - Выгружаемый регламентированный отчет.
//
// Возвращаемое значение:
//	Строка - Текст ошибок или пустая строка, если ошибок не было.
//
Функция ОписаниеОшибокВыгрузки(РезультатВыгрузки, СохраненныйОтчет)

	Если РезультатВыгрузки.РеглОтчетВыгружен Тогда
		Возврат "";
	КонецЕсли;

	Если РезультатВыгрузки.Ошибки.Количество() > 0 Тогда
		СообщениеОбОшибке = СтрСоединить(РезультатВыгрузки.Ошибки);
	Иначе    
		СообщениеОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Невозможно выгрузить отчет ""%1""';
				|en = 'Cannot export the ""%1"" report'"), СохраненныйОтчет);
	КонецЕсли;
	
	Возврат СообщениеОбОшибке;

КонецФункции

#Область ОтправкаРегламентированногоОтчетаВФНС

Процедура ОтправкаРегламентированногоОтчетаВФНС(ПараметрыОтчета, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть аналогичная процедура ОтправкаРегламентированногоОтчетаВФНСПослеПодтвержденияПовторнойОтправки,
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	Док = ПараметрыОтчета.мСохраненныйДок;
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;
	
	Если НЕ ОтправкаРегламентированногоОтчетаВФНС_ПередВыгрузкойФайла(КонтекстОтправки, Док, Новый УникальныйИдентификатор, СообщениеОбОшибке) Тогда
		
		Если КонтекстОтправки.Свойство("ОтсутствуетУчетнаяЗапись") Тогда
			
			ПроверитьСтатусПодключенияПередОтправкой(Док, СообщениеОбОшибке);
			
		ИначеЕсли КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
			СообщитьОНеподключенномНаправлении(Док, СообщениеОбОшибке);
		Иначе
			
			Если НЕ ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
				СообщениеОбОшибке = "ОповеститьОНеудачнойОтправке";
			КонецЕсли;

		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	// выгружаем отчет и доверенность, при необходимости
	ВыгрузитьРегламентированныйОтчетИДоверенностьДляОтправки(КонтекстОтправки, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;

	Если ПараметрыОтчета.ТолькоПроверкаБезОтправки Тогда
		// Следующие процедуры выполняют либо сохранение в базе данных об отправке либо могут вызывать сервис криптографии,
		// поэтому в режиме "Только проверка без отправки" их уже не выполняем.
		// Считаем, что текущий отчет может быть отправлен.
		Возврат;
	КонецЕсли;

	ВыгрузитьРегламентированныйОтчетИДоверенностьДляОтправкиПослеВыгрузкиЗавершение(КонтекстОтправки, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;

	Если ПараметрыОтчета.ТребуетсяАвтонастройкаУчетнойЗаписи Тогда
		ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(Док, СообщениеОбОшибке);
		Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ОтправкаРегламентированногоОтчетаВФНСПослеАвтонастройкиУчетнойЗаписи(КонтекстОтправки, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;

	ОтправкаРегламентированногоОтчетаВФНСПослеПроверкиСертификатов(КонтекстОтправки, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
	
	ОтправкаРегламентированногоОтчетаВФНСПослеФормированияПакета(КонтекстОтправки, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры

Процедура ВыгрузитьРегламентированныйОтчетИДоверенностьДляОтправки(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	
	// Выгружаем отчет.
	ТипОтправляемогоДокумента = КонтекстОтправки.ТипОтправляемогоДокумента;
	РезультатВыгрузки = РегламентированнаяОтчетность.НовыйРезультатВыгрузкиРеглОтчета();

	Если ТипОтправляемогоДокумента = "РегламентированныйОтчет" Тогда
		
		РезультатВыгрузки = ИнтерфейсыВзаимодействияБРО.ВыгрузитьРегламентированныйОтчет(КонтекстОтправки.Документ);
		
	Иначе
		
		// Другие типы отправляемых документов пока не поддерживаются.
		СообщениеОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Отправка документов типа ""%1"" возможна только в интерактивном режиме';
				|en = 'Documents of the %1 type can be sent only in the interactive mode'"), ТипОтправляемогоДокумента);
		Возврат;
		
	КонецЕсли;
	
	Если НЕ РезультатВыгрузки.РеглОтчетВыгружен Тогда
		СообщениеОбОшибке = ОписаниеОшибокВыгрузки(РезультатВыгрузки, КонтекстОтправки.Документ);
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанныеФайлаВыгрузки = ПолучитьИзВременногоХранилища(РезультатВыгрузки.АдресФайлаВыгрузки);
	ТекстВыгрузки = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеФайлаВыгрузки, РезультатВыгрузки.КодировкаФайлаВыгрузки);
	
	КонтекстОтправки.Вставить("ТекстВыгрузки",    ТекстВыгрузки);
	КонтекстОтправки.Вставить("ИмяФайлаВыгрузки", РезультатВыгрузки.ИмяФайлаВыгрузки);

КонецПроцедуры

Процедура ВыгрузитьРегламентированныйОтчетИДоверенностьДляОтправкиПослеВыгрузкиЗавершение(КонтекстОтправки, СообщениеОбОшибке) Экспорт

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	
	// выгружаем доверенность
	Если НЕ ВыгрузитьДоверенностьИНараститьСчетчикФайловПриНеобходимости(КонтекстОтправки) Тогда
		СообщениеОбОшибке = ТекстСообщенийПользователю();
		Если НЕ ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
			СообщениеОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'При выгрузке ""%1"" возникла неизвестная ошибка';
					|en = 'An unknown error occurred when exporting ""%1""'"), КонтекстОтправки.Документ);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(ОбъектСсылка, СообщениеОбОшибке)

	// Внимание!
