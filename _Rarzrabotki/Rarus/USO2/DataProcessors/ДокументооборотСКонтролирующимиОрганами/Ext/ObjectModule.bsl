//Настройка программы по заявлению абонента

Процедура РегистрацияСобратьРасшифрованныйФайл(ДокументDOM, АдресВоВременномХранилище)
	
	ВременныйКаталогНаСервере = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	ИмяФайла = ВременныйКаталогНаСервере + "конфиденциальнаяинформация.txt";
	ДвФайл = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	ДвФайл.Записать(ИмяФайла);
	
	ОбъектЧтение = Новый ЧтениеТекста(ИмяФайла, "windows-1251");
	Текст = ОбъектЧтение.Прочитать();
	Текст= "<?xml version=""1.0"" encoding=""windows-1251""?>" + Символы.ПС +
	"<корневойЭлемент>" + Текст + "</корневойЭлемент>"; 
	ОбъектЧтение.Закрыть();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Текст);
	ПостроительDOM = Новый ПостроительDOM;
	НовыйДокументDOM  = ПостроительDOM.Прочитать(ЧтениеXML);
	
	УзелDOM = ДокументDOM.ПолучитьЭлементыПоИмени("КонфиденциальнаяИнформация")[0];
	УзелDOM.Текстовоесодержимое="";
	
	Для каждого Узел из НовыйДокументDOM.ПолучитьЭлементыПоИмени("корневойЭлемент")[0].ДочерниеУзлы Цикл
		УзелDOM.ДобавитьДочерний(ДокументDOM.ИмпортироватьУзел(Узел, Истина));
	КонецЦикла;
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВременныйКаталогНаСервере);
	
КонецПроцедуры

Функция РегистрацияПолучитьУчетнуюЗапись(ИдентификаторАбонента)
	
	УчетныеЗаписиДокументооборота = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетныеЗаписиДокументооборота.Ссылка
	|ИЗ
	|	Справочник.УчетныеЗаписиДокументооборота КАК УчетныеЗаписиДокументооборота
	|ГДЕ
	|	УчетныеЗаписиДокументооборота.ИдентификаторАбонента = &ИдентификаторАбонента
	|	И НЕ УчетныеЗаписиДокументооборота.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ИдентификаторАбонента", ИдентификаторАбонента);
	
	Попытка
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			УчетныеЗаписиДокументооборота = Выборка.Ссылка;
		КонецЦикла;
	Исключение	КонецПопытки;
	
	Если УчетныеЗаписиДокументооборота = Неопределено Тогда
		УстановитьПривилегированныйРежим(Истина);	
		УчетныеЗаписиДокументооборота = Справочники.УчетныеЗаписиДокументооборота.СоздатьЭлемент();
		УчетныеЗаписиДокументооборота.ДатаПодключения = ТекущаяДатаСеанса();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат УчетныеЗаписиДокументооборота;

КонецФункции

Функция РегистрацияПолучитьОрганизацию(УчетнаяЗапись)
	
	ОрганизацияСсылка = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.УчетнаяЗаписьОбмена = &УчетнаяЗаписьОбмена";
	
	Запрос.УстановитьПараметр("УчетнаяЗаписьОбмена", УчетнаяЗапись);
	
	Попытка
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если Выборка.Ссылка.ВидОбменаСКонтролирующимиОрганами = Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
				ОрганизацияСсылка = Выборка.Ссылка; 
			КонецЕсли;
		КонецЦикла;
	Исключение	КонецПопытки;
	
	Возврат ОрганизацияСсылка;
	
КонецФункции

Функция МассивОтпечатковСертификатовАбонентовФСРАР(ДокументDOM) Экспорт
	
	Результат = Новый Массив;
	Сертификаты = ДокументDOM.ПолучитьЭлементыПоИмени("Сертификат");
	
	Для Каждого Сертификат из Сертификаты Цикл
		
		АтрибутТипПолучателя = Сертификат.Атрибуты.ПолучитьИменованныйЭлемент("ТипПолучателя");
		АтрибутОтпечаток = Сертификат.Атрибуты.ПолучитьИменованныйЭлемент("Отпечаток");
		Если АтрибутТипПолучателя <> Неопределено И АтрибутТипПолучателя.ТекстовоеСодержимое = "ФСРАР"
			И АтрибутОтпечаток <> Неопределено И НЕ ПустаяСтрока(АтрибутОтпечаток.ТекстовоеСодержимое) Тогда
			Результат.Добавить(НРег(АтрибутОтпечаток.ТекстовоеСодержимое));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СравнитьМассивыБезУчетаПорядкаЭлементов(Массив1, Массив2) Экспорт
	
	Если (НЕ ЗначениеЗаполнено(Массив1) И ЗначениеЗаполнено(Массив2))
	ИЛИ (НЕ ЗначениеЗаполнено(Массив2) И ЗначениеЗаполнено(Массив1)) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// обходим элементы первого массива и ищем их во втором
	Для Каждого Эл Из Массив1 Цикл
		Если Массив2.Найти(Эл) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	// обходим элементы второго массива и ищем их в первом
	Для Каждого Эл Из Массив2 Цикл
		Если Массив1.Найти(Эл) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьАтрибутУзлаXML(УзелDOM, НазваниеАтрибута, ЗначениеПоУмолчанию = "") Экспорт
	
	Если УзелDOM = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат УзелDOM.Атрибуты.ПолучитьИменованныйЭлемент(НазваниеАтрибута).ТекстовоеСодержимое;
	
КонецФункции

Функция ПолучитьЭлементУзлаXML(ДокументDOM, НазваниеУзла, ИндексЭлемента = 0, ЗначениеПоУмолчанию = Неопределено)
	
	Если ДокументDOM = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	УзелDOM = ДокументDOM.ПолучитьЭлементыПоИмени(НазваниеУзла);
	
	Если ИндексЭлемента < УзелDOM.Количество() Тогда
		Возврат УзелDOM[ИндексЭлемента];
	Иначе
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
КонецФункции

Процедура РегистрацияРегистрФСРАР(ОтпечатокАбонента, ОтпечатокСубъектаРФ, ОтпечатокФСРАР, КодРегиона, Организация, ВыводитьСообщения)
	
	ФлагАвтозаполнения = Истина;
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиОбменаФСРАР.ИспользоватьАвтонастройку КАК ИспользоватьАвтонастройку,
	|	НастройкиОбменаФСРАР.ИспользоватьОбмен КАК ИспользоватьОбмен,
	|	НастройкиОбменаФСРАР.СертификатАбонентаОтпечаток КАК СертификатАбонентаОтпечаток,
	|	НастройкиОбменаФСРАР.СертификатСубъектаРФОтпечаток КАК СертификатСубъектаРФОтпечаток,
	|	НастройкиОбменаФСРАР.СертификатФСРАРОтпечаток КАК СертификатФСРАРОтпечаток,
	|	НастройкиОбменаФСРАР.КодРегиона КАК КодРегиона
	|ИЗ
	|	РегистрСведений.НастройкиОбменаФСРАР КАК НастройкиОбменаФСРАР
	|ГДЕ
	|	НастройкиОбменаФСРАР.Организация = &ОрганизацияСсылка";

	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ОрганизацияСсылка", Организация);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат;
	КонецПопытки;
	
	ОсновнойОтпечатокСубъектаРФ = "";
	Если ОтпечатокСубъектаРФ <> Неопределено И ОтпечатокСубъектаРФ.Количество() > 0 Тогда
		ОсновнойОтпечатокСубъектаРФ = ОтпечатокСубъектаРФ[0];
	КонецЕсли;
	ОсновнойОтпечатокФСРАР = "";
	Если ОтпечатокФСРАР <> Неопределено И ОтпечатокФСРАР.Количество() > 0 Тогда
		ОсновнойОтпечатокФСРАР = ОтпечатокФСРАР[0];
	КонецЕсли;
	
	ФлагСообщения = Ложь;
	Если НЕ Выборка.Следующий() Тогда
		ФлагСообщения = Истина;
	Иначе
		Если НЕ Выборка.ИспользоватьАвтонастройку Тогда
			ФлагСообщения = Истина;
		КонецЕсли;
		Если Выборка.ИспользоватьОбмен И Выборка.СертификатАбонентаОтпечаток = ОтпечатокАбонента
			И Выборка.СертификатСубъектаРФОтпечаток = ОсновнойОтпечатокСубъектаРФ И Выборка.СертификатФСРАРОтпечаток = ОсновнойОтпечатокФСРАР
			И (Выборка.КодРегиона = КодРегиона ИЛИ НЕ ЗначениеЗаполнено(КодРегиона)) Тогда
			ФлагСообщения = Ложь;
			ФлагАвтозаполнения = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ФлагАвтозаполнения Тогда
		Попытка
			ОбменФСРАР = РегистрыСведений.НастройкиОбменаФСРАР.СоздатьМенеджерЗаписи();
			ОбменФСРАР.Организация = Организация.Ссылка;
			ОбменФСРАР.ИспользоватьОбмен = Истина;
			ОбменФСРАР.СертификатАбонентаОтпечаток = НРег(ОтпечатокАбонента);
			ОбменФСРАР.СертификатСубъектаРФОтпечаток = НРег(ОсновнойОтпечатокСубъектаРФ);
			ОбменФСРАР.СертификатФСРАРОтпечаток = НРег(ОсновнойОтпечатокФСРАР);
			ОбменФСРАР.КодРегиона = КодРегиона;
			ОбменФСРАР.ИспользоватьАвтонастройку = Истина;
			ОбменФСРАР.Записать();
			Если ВыводитьСообщения Тогда
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Обновлены параметры отправки отчетности в Росалкогольрегулирование.';
																	|en = 'Parameters of sending reporting to Federal Service for Alcohol Market Regulation are updated.'"));
			КонецЕсли;
		Исключение
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось обновить параметры отправки отчетности в Росалкогольрегулирование, причина:" + Символы.ПС + """%1"".'"), ОписаниеОшибки()));
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура РегистрацияРегистрРПН(ОтпечатокАбонента, ОтпечатокРПН, Организация, ВыводитьСообщения, СтруктураАвтонастройкиРПН)
	
	ФлагАвтозаполнения = Истина;
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиОбменаРПН.ИспользоватьАвтонастройку КАК ИспользоватьАвтонастройку,
	|	НастройкиОбменаРПН.ИспользоватьОбмен КАК ИспользоватьОбмен,
	|	НастройкиОбменаРПН.СертификатАбонентаОтпечаток КАК СертификатАбонентаОтпечаток,
	|	НастройкиОбменаРПН.СертификатРПНОтпечаток КАК СертификатРПНОтпечаток,
	|	НастройкиОбменаРПН.EMail КАК EMail,
	|	НастройкиОбменаРПН.Пароль КАК Пароль
	|ИЗ
	|	РегистрСведений.НастройкиОбменаРПН КАК НастройкиОбменаРПН
	|ГДЕ
	|	НастройкиОбменаРПН.Организация = &ОрганизацияСсылка";

	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ОрганизацияСсылка", Организация);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат;
	КонецПопытки;
	
	ОсновнойОтпечатокРПН = "";
	Если ОтпечатокРПН <> Неопределено И ОтпечатокРПН.Количество() > 0 Тогда
		ОсновнойОтпечатокРПН = НРег(ОтпечатокРПН[0].ТекстовоеСодержимое);
	КонецЕсли;
	
	EMail = Неопределено;
	Пароль = Неопределено;
	ФлагСообщения = Ложь;
	Если НЕ Выборка.Следующий() Тогда
		ФлагСообщения = Истина;
	Иначе
		EMail = Выборка.EMail;
		Пароль = Выборка.Пароль;
		Если НЕ Выборка.ИспользоватьАвтонастройку Тогда
			ФлагСообщения = Истина;
		КонецЕсли;
		Если Выборка.ИспользоватьОбмен И Выборка.СертификатАбонентаОтпечаток = ОтпечатокАбонента
			И Выборка.СертификатРПНОтпечаток = ОсновнойОтпечатокРПН Тогда
			ФлагСообщения = Ложь;
			ФлагАвтозаполнения = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураАвтонастройкиРПН = Новый Структура("ОтпечатокСертификата, СертификатРПНОтпечаток, ФлагСообщения, ФлагАвтозаполнения, EMail, Пароль", НРег(ОтпечатокАбонента), НРег(ОсновнойОтпечатокРПН), ФлагСообщения, ФлагАвтозаполнения, EMail, Пароль);
	
КонецПроцедуры

