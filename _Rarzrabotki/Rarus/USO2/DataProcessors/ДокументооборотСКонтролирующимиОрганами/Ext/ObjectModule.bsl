			ТранспортныеСообщенияСПрисоединеннымиФайлами.Добавить(СтрокаТаблицыФайлов.ТранспортноеСообщение);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаПрисоединенныхФайлов = Неопределено;
	Если ТранспортныеСообщенияСПрисоединеннымиФайлами.Количество() > 0 Тогда
		ТаблицаПрисоединенныхФайлов = ОбщегоНазначенияЭДКО.ПрикрепленныеФайлыКОбъектуИзСправочника(
			ТранспортныеСообщенияСПрисоединеннымиФайлами,
			"ТранспортноеСообщениеПрисоединенныеФайлы",
			,
			"ВладелецФайла, ИсходноеИмяФайла");
		
		Для каждого СтрокаТаблицы Из ТаблицаПрисоединенныхФайлов Цикл
			СтрокаТаблицы.ИсходноеИмяФайла = ВРЕГ(СтрокаТаблицы.ИсходноеИмяФайла);
		КонецЦикла;
	КонецЕсли;
	
	Для каждого СтрокаТаблицыФайлов Из ТаблицаФайлов Цикл
		ДвоичныеДанныеФайла = СтрокаТаблицыФайлов.Данные.Получить();
		Если ДвоичныеДанныеФайла = Неопределено Тогда
			ИсходноеИмяФайла = ВРЕГ(СтрокаТаблицыФайлов.ИмяФайла);
			
			ПараметрыОтбора = Новый Структура("ВладелецФайла, ИсходноеИмяФайла",
				СтрокаТаблицыФайлов.ТранспортноеСообщение, ИсходноеИмяФайла);
			СтрокиТаблицы = ТаблицаПрисоединенныхФайлов.НайтиСтроки(ПараметрыОтбора);
			Если СтрокиТаблицы.Количество() > 0 Тогда
				ДвоичныеДанныеФайла = РаботаСФайлами.ДвоичныеДанныеФайла(СтрокиТаблицы[0].Ссылка);
			КонецЕсли;
		КонецЕсли;
		
		Если ДвоичныеДанныеФайла <> Неопределено Тогда
			СтрокаТаблицыФайлов.Данные = Новый ХранилищеЗначения(ДвоичныеДанныеФайла, Новый СжатиеДанных(0));
		КонецЕсли;
	КонецЦикла;
	
	Объектов = 0;
	ОбъектовВАрхиве = 0;
	Для Каждого ЦиклОбмена Из ЦиклыОбмена Цикл
		
		ЭтоЗапросНаСверку = ТипЗнч(ЦиклОбмена.Предмет) = Тип("ДокументСсылка.ЗапросНаИнформационноеОбслуживаниеНалогоплательщика");
		
		Если ЭтоЗапросНаСверку Тогда
			
			// ищем результат сверки
			РезультатПоиска = ТаблицаФайлов.НайтиСтроки(Новый Структура("ЦиклОбмена, ИдентификаторТипа", ЦиклОбмена, ИдентификаторРезультатаСверки));
			Если РезультатПоиска.Количество() = 0 Тогда
				СтрСообщение = "Выгрузка пакета по циклу обмена """ + ПредставлениеЦиклаОбмена(ЦиклОбмена) + """ прервана: отсутствует ответ на запрос сверки.";
				Результат.Вставить(ЦиклОбмена, СтрСообщение);
				Продолжить;
			КонецЕсли;		
			СтрРезультатСверки = РезультатПоиска[0];
					
			// определяем имя файла квитанции
			ИмяРезультатаСверки = СтрРезультатСверки.ИмяФайла;
			Объектов = Объектов + 1;
			Если СтрРезультатСверки.ВАрхиве > 0 Тогда
				ОбъектовВАрхиве = ОбъектовВАрхиве + 1;
			КонецЕсли;
			
			ИмяФайлаОтчетности = ИмяРезультатаСверки; // Для формирования архива
			
			// ищем ЭЦП налогового органа под результатом сверки
			РезультатПоиска = ТаблицаФайлов.НайтиСтроки(Новый Структура("ЦиклОбмена, ИдентификаторТипа, ЭЦПИмяПодписанногоФайла", ЦиклОбмена, ИдентификаторЭЦПНалоговогоОргана, ИмяРезультатаСверки));
			Если РезультатПоиска.Количество() = 0 Тогда
				СтрСообщение = "Выгрузка пакета по циклу обмена """ + ПредставлениеЦиклаОбмена(ЦиклОбмена) + """ прервана: отсутствует подпись налогового органа под ответом на запрос сверки.";
				Результат.Вставить(ЦиклОбмена, СтрСообщение);
				Продолжить;
			КонецЕсли;
			СтрЭЦПНалоговогоОрганаПодРезультатомСверки = РезультатПоиска[0];
			Объектов = Объектов + 1;
			Если СтрЭЦПНалоговогоОрганаПодРезультатомСверки.ВАрхиве > 0 Тогда
				ОбъектовВАрхиве = ОбъектовВАрхиве + 1;
			КонецЕсли;
			
			Если ТолькоОценка Тогда 
				Результат.Вставить(ЦиклОбмена, Новый Структура("Всего, ВАрхиве", Объектов, ОбъектовВАрхиве));
				Продолжить;
			КонецЕсли;
			
			// создаем временный каталог, куда выгружаем файлы
			ВременныйКаталог = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
			
			// выгружаем файлы
			Попытка
				СтрРезультатСверки.Данные.Получить().Записать(ВременныйКаталог + ИмяРезультатаСверки);
				СтрЭЦПНалоговогоОрганаПодРезультатомСверки.Данные.Получить().Записать(ВременныйКаталог + ИмяРезультатаСверки + ".FNS.p7s");
			Исключение
				СтрСообщение = "Выгрузка пакета по циклу обмена """ + ПредставлениеЦиклаОбмена(ЦиклОбмена) + """ прервана: не удалось сохранить файлы пакета во временный каталог (" + ИнформацияОбОшибке().Описание + ").";
				Результат.Вставить(ЦиклОбмена, СтрСообщение);
				Продолжить;
			КонецПопытки;
			
		Иначе
		
			// ищем файл отчетности
			РезультатПоиска = ТаблицаФайлов.НайтиСтроки(Новый Структура("ЦиклОбмена, ИдентификаторТипа", ЦиклОбмена, ИдентификаторОтчетность));
			Если РезультатПоиска.Количество() = 0 Тогда
				Если ЦиклОбмена.Тип <> Перечисления.ТипыЦикловОбмена.НалоговаяИлиБухгалтерскаяОтчетность Тогда
					СтрСообщение = "Выгрузка пакета по циклу обмена """ + ПредставлениеЦиклаОбмена(ЦиклОбмена) + """ прервана: функция поддерживается только для циклов обмена по бухгалтерской или налоговой отчетности (кроме форм 2-НДФЛ и ""Заявление о ввозе товаров"").";
					Результат.Вставить(ЦиклОбмена, СтрСообщение);
					Продолжить;
				Иначе
					СтрСообщение = "Выгрузка пакета по циклу обмена """ + ПредставлениеЦиклаОбмена(ЦиклОбмена) + """ прервана: отсутствует файл отчетности.";
					Результат.Вставить(ЦиклОбмена, СтрСообщение);
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			СтрОтчетность = РезультатПоиска[0];
			
			// определяем имя файла отчетности
			ИмяФайлаОтчетности = СтрОтчетность.ИмяФайла;
			Объектов = Объектов + 1;
			Если СтрОтчетность.ВАрхиве > 0 Тогда
				ОбъектовВАрхиве = ОбъектовВАрхиве + 1;
			КонецЕсли;
			
			// ищем подпись налогоплательщика под файлом отчетности
			РезультатПоиска = ТаблицаФайлов.НайтиСтроки(Новый Структура("ЦиклОбмена, ИдентификаторТипа, ЭЦПИмяПодписанногоФайла", ЦиклОбмена, ИдентификаторОтчетностьЭЦПНалогоплательщика, ИмяФайлаОтчетности));
			Если РезультатПоиска.Количество() = 0 Тогда
				СтрСообщение = "Выгрузка пакета по циклу обмена """ + ПредставлениеЦиклаОбмена(ЦиклОбмена) + """ прервана: отсутствует подпись налогоплательщика под файлом отчетности.";
				Результат.Вставить(ЦиклОбмена, СтрСообщение);
				Продолжить;
			КонецЕсли;
			СтрЭЦПНалогоплательщикаПодФайломОтчетности = РезультатПоиска[0];
			Объектов = Объектов + 1;
			Если СтрЭЦПНалогоплательщикаПодФайломОтчетности.ВАрхиве > 0 Тогда
				ОбъектовВАрхиве = ОбъектовВАрхиве + 1;
			КонецЕсли;
			
			// ищем подпись налогового органа под файлом отчетности
			РезультатПоиска = ТаблицаФайлов.НайтиСтроки(Новый Структура("ЦиклОбмена, ИдентификаторТипа, ЭЦПИмяПодписанногоФайла", ЦиклОбмена, ИдентификаторЭЦПНалоговогоОргана, ИмяФайлаОтчетности));
			Если РезультатПоиска.Количество() = 0 Тогда
				СтрСообщение = "Выгрузка пакета по циклу обмена """ + ПредставлениеЦиклаОбмена(ЦиклОбмена) + """ прервана: отсутствует подпись налогового органа под файлом отчетности.";
				Результат.Вставить(ЦиклОбмена, СтрСообщение);
				Продолжить;
			КонецЕсли;
			СтрЭЦПНалоговогоОрганаПодФайломОтчетности = РезультатПоиска[0];
			Объектов = Объектов + 1;
			Если СтрЭЦПНалоговогоОрганаПодФайломОтчетности.ВАрхиве > 0 Тогда
				ОбъектовВАрхиве = ОбъектовВАрхиве + 1;
			КонецЕсли;
			
			// ищем квитанцию о приеме
			РезультатПоиска = ТаблицаФайлов.НайтиСтроки(Новый Структура("ЦиклОбмена, ИдентификаторТипа", ЦиклОбмена, ИдентификаторКвитанцияОПриеме));
			Если РезультатПоиска.Количество() = 0 Тогда
				СтрСообщение = "Выгрузка пакета по циклу обмена """ + ПредставлениеЦиклаОбмена(ЦиклОбмена) + """ прервана: отсутствует квитанция о приеме.";
				Результат.Вставить(ЦиклОбмена, СтрСообщение);
				Продолжить;
			КонецЕсли;		
			СтрКвитанцияОПриеме = РезультатПоиска[0];
					
			// определяем имя файла квитанции
			ИмяФайлаКвитанции = СтрКвитанцияОПриеме.ИмяФайла;
			Объектов = Объектов + 1;
			Если СтрКвитанцияОПриеме.ВАрхиве > 0 Тогда
				ОбъектовВАрхиве = ОбъектовВАрхиве + 1;
			КонецЕсли;
			
			// ищем ЭЦП налогового органа под квитанцией о приеме
			РезультатПоиска = ТаблицаФайлов.НайтиСтроки(Новый Структура("ЦиклОбмена, ИдентификаторТипа, ЭЦПИмяПодписанногоФайла", ЦиклОбмена, ИдентификаторЭЦПНалоговогоОргана, ИмяФайлаКвитанции));
			Если РезультатПоиска.Количество() = 0 Тогда
				СтрСообщение = "Выгрузка пакета по циклу обмена """ + ПредставлениеЦиклаОбмена(ЦиклОбмена) + """ прервана: отсутствует подпись налогового органа под квитанцией о приеме.";
				Результат.Вставить(ЦиклОбмена, СтрСообщение);
				Продолжить;
			КонецЕсли;
			СтрЭЦПНалоговогоОрганаПодКвитанциейОПриеме = РезультатПоиска[0];
			Объектов = Объектов + 1;
			Если СтрЭЦПНалоговогоОрганаПодКвитанциейОПриеме.ВАрхиве > 0 Тогда
				ОбъектовВАрхиве = ОбъектовВАрхиве + 1;
			КонецЕсли;
			
			Если ТолькоОценка Тогда 
				Результат.Вставить(ЦиклОбмена, Новый Структура("Всего, ВАрхиве", Объектов, ОбъектовВАрхиве));
				Продолжить;
			КонецЕсли;
			
			// создаем временный каталог, куда выгружаем файлы
			ВременныйКаталог = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
			
			// выгружаем файлы
			Попытка
				СтрОтчетность.Данные.Получить().Записать(ВременныйКаталог + ИмяФайлаОтчетности);
				СтрЭЦПНалогоплательщикаПодФайломОтчетности.Данные.Получить().Записать(ВременныйКаталог + ИмяФайлаОтчетности + ".p7s");
				СтрЭЦПНалоговогоОрганаПодФайломОтчетности.Данные.Получить().Записать(ВременныйКаталог + ИмяФайлаОтчетности + ".FNS.p7s");
				СтрКвитанцияОПриеме.Данные.Получить().Записать(ВременныйКаталог + ИмяФайлаОтчетности + ".KV.xml");
				СтрЭЦПНалоговогоОрганаПодКвитанциейОПриеме.Данные.Получить().Записать(ВременныйКаталог + ИмяФайлаОтчетности + ".KV.p7s");
			Исключение
				СтрСообщение = "Выгрузка пакета по циклу обмена """ + ПредставлениеЦиклаОбмена(ЦиклОбмена) + """ прервана: не удалось сохранить файлы пакета во временный каталог (" + ИнформацияОбОшибке().Описание + ").";
				Результат.Вставить(ЦиклОбмена, СтрСообщение);
				Продолжить;
			КонецПопытки;
			
		КонецЕсли;
		
		// формируем zip-архив
		Попытка
			ИмяФайлаПакета = ИмяФайлаБезРасширения(ИмяФайлаОтчетности) + ".zip";
			ПолноеИмяФайлаПакета = ПолучитьКаталогВременныхФайлов() + ИмяФайлаПакета;
			ОбъектЗапись = Новый ЗаписьZipФайла(ПолноеИмяФайлаПакета);
			ОбъектЗапись.Добавить(ВременныйКаталог + "*.*");
			ОбъектЗапись.Записать();
		Исключение
			СтрСообщение = "Выгрузка пакета по циклу обмена """ + ПредставлениеЦиклаОбмена(ЦиклОбмена) + """ прервана: не удалось сохранить файл пакета во временный каталог (" + ИнформацияОбОшибке().Описание + ").";
			Результат.Вставить(ЦиклОбмена, СтрСообщение);
			Продолжить;
		КонецПопытки;
		
		// удаляем временный каталог
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВременныйКаталог);
		
		// сохраняем во временном хранилище
		АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайлаПакета), УникальныйИдентификатор);
		
		// фиксируем результат выгрузки пакета по циклу обмена
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ИмяФайла", ИмяФайлаПакета);
		ДополнительныеПараметры.Вставить("Адрес",    АдресВоВременномХранилище);
		ДополнительныеПараметры.Вставить("Всего",    Объектов);
		ДополнительныеПараметры.Вставить("ВАрхиве",  ОбъектовВАрхиве);
		
		Результат.Вставить(ЦиклОбмена, ДополнительныеПараметры);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ПолучитьИзображенияПрисоединенныхФайловИсточников(ФайлыИсточников, ИдентификаторФормыВладельца) Экспорт
	
	Для каждого ФайлыИсточника Из ФайлыИсточников Цикл
		ИсточникСсылка = ФайлыИсточника.Ключ;	
		
		МассивФайлов = Новый Массив;
		РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(ИсточникСсылка, МассивФайлов);
		
		СвойстваФайлов = Новый Массив;
		
		Для каждого ПрисоединенныйФайл Из МассивФайлов Цикл
			
			ДанныеФайла = РаботаСФайлами.ДанныеФайла(ПрисоединенныйФайл, ИдентификаторФормыВладельца);
			
			РасширениеФайла = нрег(ДанныеФайла.Расширение);
			Если РасширениеФайла = "tif"
			 ИЛИ РасширениеФайла = "jpg" 
			 ИЛИ РасширениеФайла = "jpeg" 
			 ИЛИ РасширениеФайла = "png" 
			 ИЛИ РасширениеФайла = "pdf" Тогда
			    СвойстваФайла = Новый Структура();
				СвойстваФайла.Вставить("Имя", 			ДанныеФайла.ИмяФайла);
				СвойстваФайла.Вставить("Размер", 		ДанныеФайла.Размер);
				СвойстваФайла.Вставить("АдресДанных", 	ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
				
				СвойстваФайлов.Добавить(СвойстваФайла);
			КонецЕсли;
			
		КонецЦикла;
		
		ФайлыИсточников.Вставить(ИсточникСсылка, СвойстваФайлов);
		
	КонецЦикла;
	
КонецПроцедуры

Функция СписокВыбораТиповПервичныйДокументВОтветеНаТребование(МножественныйВыбор) Экспорт
	
	МассивТипов = Метаданные.ОпределяемыеТипы.ИсточникДокументаПоТребованиюФНСБРО.Тип.Типы();
	
	ТаблицаТипов = Новый ТаблицаЗначений;
	ТаблицаТипов.Колонки.Добавить("Тип");
	ТаблицаТипов.Колонки.Добавить("НаименованиеТипа");
	
	Для каждого ТипДокумента Из МассивТипов Цикл
		
		НоваяСтрока = ТаблицаТипов.Добавить();
		НоваяСтрока.Тип = ТипДокумента;
		НоваяСтрока.НаименованиеТипа = Строка(ТипДокумента);
		
	КонецЦикла;
	
	ТаблицаТипов.Сортировать("НаименованиеТипа");
	
	СписокЗначений = Новый СписокЗначений;
	Для каждого СтрокаТаблицыТипов Из ТаблицаТипов Цикл
		СписокЗначений.Добавить(СтрокаТаблицыТипов.Тип, Строка(СтрокаТаблицыТипов.Тип));
	КонецЦикла;
	
	Если МножественныйВыбор Тогда
		
		СписокЗначений.Добавить(
			Тип("СправочникСсылка.СканированныеДокументыДляПередачиВЭлектронномВиде"), 
			НСтр("ru = 'Сканы из предыдущих ответов';
				|en = 'Scanned copies from the previous responses'"));
			
	КонецЕсли;
	
	Возврат СписокЗначений;
	
КонецФункции

Функция ЭлектронныеДокументыЭДО(ДокументИсточник) Экспорт
	
	ВидДокументаФНС         = Неопределено;
	ЕстьЭлектронныйДокумент = Ложь;
	
	Попытка
	
		ЭлектронныеДокументы = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьФайлыВыгрузкиЭД(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументИсточник), Новый УникальныйИдентификатор);
		
	Исключение
		
		// Не требует специальных обработок
		ЭлектронныеДокументы = Неопределено;
		
	КонецПопытки;
	
	Если ЭлектронныеДокументы <> Неопределено Тогда
		
		СписокДокументов = ЭлектронныеДокументы.Получить(ДокументИсточник);
		
		Если СписокДокументов <> Неопределено Тогда
			
			СвойстваВладельцевЭД = Новый Соответствие;
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиПереопределяемый.ОпределитьСвойстваВладельцевЭлектронныхДокументов(
				СвойстваВладельцевЭД, ДокументИсточник);
				
			СвойстваИсточника = СвойстваВладельцевЭД[ДокументИсточник];
			СоответствиеВидов = ЭлектронныйДокументооборотСКонтролирующимиОрганами.СоответствиеВидовДокументовФНС();
			ВидДокументаФНС   = СоответствиеВидов[СвойстваИсточника];
			
			Если ВидДокументаФНС <> Неопределено Тогда
				
				// Проверка на наличие двух необходимых подписей
				
				Если ВидДокументаФНС = Перечисления.ВидыПредставляемыхДокументов.АктПриемкиСдачиРабот
					ИЛИ ВидДокументаФНС = Перечисления.ВидыПредставляемыхДокументов.ТоварнаяНакладнаяТОРГ12
					ИЛИ ВидДокументаФНС = Перечисления.ВидыПредставляемыхДокументов.ПередачаТоваров
					ИЛИ ВидДокументаФНС = Перечисления.ВидыПредставляемыхДокументов.ПередачаУслуг Тогда
					
					// "ЭЦП", "ФайлВыгрузки", "ФайлПодтверждения", "ЭЦППодтверждения"
					Если ТипЗнч(СписокДокументов) = Тип("Массив") 
						И СписокДокументов.Количество() = 4 Тогда
						ЕстьЭлектронныйДокумент = Истина; 
					КонецЕсли;
					
				Иначе
					ЕстьЭлектронныйДокумент = Истина;
				КонецЕсли;
					
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидДокументаФНС",         ВидДокументаФНС);
	ДополнительныеПараметры.Вставить("ЕстьЭлектронныйДокумент", ЕстьЭлектронныйДокумент);
	
	Возврат ДополнительныеПараметры;
		
КонецФункции

Процедура ЗавершитьНастройкуЗаявлений() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявлениеАбонентаСпецоператораСвязи.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаявлениеАбонентаСпецоператораСвязи КАК ЗаявлениеАбонентаСпецоператораСвязи
		|ГДЕ
		|	ЗаявлениеАбонентаСпецоператораСвязи.НастройкаЗавершена = Ложь
		|	И ЗаявлениеАбонентаСпецоператораСвязи.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено), ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено))";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаявлениеОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		ЗаявлениеОбъект.НастройкаЗавершена = Истина;
		ЗаявлениеОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

#Область ПечатьПояснения

Функция ТаблицаКонтрагентовПояснения(Пояснение) Экспорт
	
	ТаблицаИНН = Пояснение.Контрагенты.Выгрузить(, "ИНН, КПП");

	// Дополняем таблицу с ИНН значениями, указанными в колонках табличных частей
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.КнигаПокупок, "ПосредникИНН");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.КнигаПокупок, "ПосредникИННРасхождение");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.КнигаПокупокДл, "ПосредникИНН");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.КнигаПокупокДл, "ПосредникИННРасхождение");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.КнигаПродаж, "ПосредникИНН");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.КнигаПродаж, "ПосредникИННРасхождение");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.КнигаПродажДл, "ПосредникИНН");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.КнигаПродажДл, "ПосредникИННРасхождение");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.ЖурналУчетаВыставленныхСчетовФактур, "ПокупательИНН");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.ЖурналУчетаВыставленныхСчетовФактур, "ПокупательИННРасхождение");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.ЖурналУчетаПолученныхСчетовФактур, "ПродавецИНН");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.ЖурналУчетаПолученныхСчетовФактур, "ПродавецИННРасхождение");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.ЖурналУчетаПолученныхСчетовФактур, "СубкомиссионерИНН");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.ЖурналУчетаПолученныхСчетовФактур, "СубкомиссионерИННРасхождение");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.ВыставленныеСчетаФактурыНеплательщиковНДС, "ПокупательИНН");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.ВыставленныеСчетаФактурыНеплательщиковНДС, "ПокупательИННРасхождение");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.НетКнигаПрод, "ПокупательИНН", "ПокупательКПП");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.НетКнигаПрод, "ПокупательИННРасхождение", "ПокупательКППРасхождение");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.НетКнигаПрод, "ПосредникИНН", "ПосредникКПП");
	ДобавитьКонтрагентов(ТаблицаИНН, Пояснение.НетКнигаПрод, "ПосредникИННРасхождение", "ПосредникКППРасхождение");
	
	ТаблицаКонтрагентов = Документы.ПоясненияКДекларацииПоНДС.КонтрагентыПоСпискуИНН(ТаблицаИНН);
	
	Возврат ТаблицаКонтрагентов;
	
КонецФункции
	
Функция СведенияОКонтрагентахПояснения(Пояснение, ТаблицаКонтрагентов) Экспорт	
	
	СведенияОКонтрагентах = Пояснение.Контрагенты.Выгрузить();
	СведенияОКонтрагентах.Индексы.Добавить("ИдентификаторЗначения");
	СведенияОКонтрагентах.Колонки.Добавить("Контрагенты", Новый ОписаниеТипов("СписокЗначений"));
	СведенияОКонтрагентах.Колонки.Добавить("ПредставлениеКонтрагента", Новый ОписаниеТипов("Строка"));
	
	Для Каждого СведениеОКонтрагенте ИЗ СведенияОКонтрагентах Цикл
		
		СведениеОКонтрагенте.Контрагенты = Новый СписокЗначений();
		
		ПредставленияКонтрагента = Новый Массив;
		Если ТаблицаКонтрагентов <> Неопределено Тогда
			
			Отбор = Новый Структура();
			Отбор.Вставить("ИНН", СведениеОКонтрагенте.ИНН);
			
			Если ЗначениеЗаполнено(СведениеОКонтрагенте.КПП) Тогда
				Отбор.Вставить("КПП", СведениеОКонтрагенте.КПП);
			КонецЕсли;
			
			СтрокиКонтрагента = ТаблицаКонтрагентов.НайтиСтроки(Отбор);
			
			Для Каждого СтрокаКонтрагента Из СтрокиКонтрагента Цикл
				СведениеОКонтрагенте.Контрагенты.Добавить(СтрокаКонтрагента.Контрагент);
				ПредставленияКонтрагента.Добавить(СтрокаКонтрагента.КонтрагентПредставление);
			КонецЦикла;
		КонецЕсли;
		
		СведениеОКонтрагенте.ПредставлениеКонтрагента = Документы.ПоясненияКДекларацииПоНДС.ПредставлениеКонтрагента(
					СведениеОКонтрагенте, СтрСоединить(ПредставленияКонтрагента, ";"));
	КонецЦикла;
				
	Возврат СведенияОКонтрагентах;
				
КонецФункции

Процедура ДобавитьКонтрагентов(Таблица, ТаблицаДанных, ПолеИНН, ПолеКПП = "")
	
	Для Каждого СтрокаТаблицыДанных Из ТаблицаДанных Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицыДанных[ПолеИНН]) Тогда
			
			СтрокаИНН = Таблица.Добавить();
			СтрокаИНН.ИНН = СтрокаТаблицыДанных[ПолеИНН];
			
			Если ЗначениеЗаполнено(ПолеКПП) Тогда
				СтрокаИНН.КПП = СтрокаТаблицыДанных[ПолеКПП];
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
				
Процедура ВывестиСтрокуЖурнала(Бланк, ИмяОбласти, СтрокаТЧ, СтрокаПосредническойДеятельности, ТабДокумент)
	
	СтрокаТабДока = Бланк.ПолучитьОбласть(ИмяОбласти);
	СтрокаТабДока.Параметры.Заполнить(СтрокаТЧ);
	СтрокаТабДока.Параметры.Заполнить(СтрокаПосредническойДеятельности);
	ТабДокумент.Вывести(СтрокаТабДока);
	
КонецПроцедуры

Процедура ВывестиСтрокуЖурналаРасхождение(Бланк, ИмяОбласти, СтрокаТЧ, СтрокиПосредническойДеятельностиРасхождение, НомерСтрокиРасхождение, СтрокиПосредническойДеятельности, ТабДокумент)
	
	СтрокаПосредническойДеятельностиРасхождение = СтрокиПосредническойДеятельностиРасхождение[НомерСтрокиРасхождение];
	
	СтрокаТабДока = Бланк.ПолучитьОбласть(ИмяОбласти);
	СтрокаТабДока.Параметры.Заполнить(СтрокаТЧ);
	СтрокаТабДока.Параметры.Заполнить(СтрокаПосредническойДеятельностиРасхождение);
	
	Колонки = Новый Массив;
	Колонки.Добавить("ДатаСчетаФактуры");
	Колонки.Добавить("КодВалюты");
	Колонки.Добавить("НомерСчетаФактуры");
	Колонки.Добавить("ПродавецИНН");
	Колонки.Добавить("РазницаСтоимостиУвеличение");
	Колонки.Добавить("РазницаСтоимостиУменьшение");
	Колонки.Добавить("РазницаСуммыНДСУвеличение");
	Колонки.Добавить("РазницаСуммыНДСУменьшение");
	Колонки.Добавить("Стоимость");
	Колонки.Добавить("СуммаНДС");
	
	ЕстьСовпадение = Ложь;
	Для НомерСтроки = 0 По СтрокиПосредническойДеятельности.Количество() - 1 Цикл
		
		ВсеКолонкиСовпадают = Истина;
		Для каждого Колонка Из Колонки Цикл
			Если СтрокаПосредническойДеятельностиРасхождение[Колонка] <> СтрокиПосредническойДеятельности[НомерСтроки][Колонка] Тогда 
				ВсеКолонкиСовпадают = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла; 
		
		Если ВсеКолонкиСовпадают И НомерСтрокиРасхождение = НомерСтроки Тогда
			ЕстьСовпадение = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ЕстьСовпадение Тогда
		СтрокаТабДока.Области[ИмяОбласти + "__ПосредническаяДеятельность"].Шрифт = Новый Шрифт(,,Истина);
	КонецЕсли;
	
	ВыделитьРасхождениеВСтрокеПояснения(СтрокаТабДока, СтрокаТЧ, ИмяОбласти);
	
	ТабДокумент.Вывести(СтрокаТабДока);
	
КонецПроцедуры

Процедура ВывестиСтрокиПосредническойДеятельностиРасхождение(СтрокиПосредническойДеятельности, СтрокиПосредническойДеятельностиРасхождение, СтрокаТЧ, ТабДокумент, Бланк)
	
	Если СтрокиПосредническойДеятельностиРасхождение.Количество() = 1 Тогда
		// Одна строка расхожений
		ВывестиСтрокуЖурналаРасхождение(Бланк, "СтрокаЖурналУчетаВыставленныхСчетовФактур_Расхождения_Один", СтрокаТЧ, СтрокиПосредническойДеятельностиРасхождение, 0, СтрокиПосредническойДеятельности, ТабДокумент);
	Иначе
		// Много строк расхожений
		Для Номер = 0 По СтрокиПосредническойДеятельностиРасхождение.Количество() - 1 Цикл
		
			Если Номер = 0 Тогда
				ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_Расхождения_Много_Начало";
			ИначеЕсли Номер = СтрокиПосредническойДеятельностиРасхождение.Количество() - 1 Тогда
				ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_Расхождения_Много_Конец";
			Иначе
				ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_Расхождения_Много_Середина";
			КонецЕсли;
			
			ВывестиСтрокуЖурналаРасхождение(Бланк, ИмяОбласти, СтрокаТЧ, СтрокиПосредническойДеятельностиРасхождение, Номер, СтрокиПосредническойДеятельности, ТабДокумент);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиСтрокиПосредническойДеятельности(СтрокиПосредническойДеятельности, СтрокиПосредническойДеятельностиРасхождение, СтрокаТЧ, ТабДокумент, Бланк)
	
	Если СтрокиПосредническойДеятельности.Количество() = 1 Тогда
		
		Если СтрокаТЧ.РезультатПроверки = Перечисления.РезультатПроверкиСтрокиДекларации.ВыявленыРасхождения Тогда
			ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_ФНС_Один_Расхождения_Начало";
		Иначе
			ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_ФНС_1_0";
		КонецЕсли;
		
		ВывестиСтрокуЖурнала(Бланк, ИмяОбласти, СтрокаТЧ, СтрокиПосредническойДеятельности[0], ТабДокумент);
		
	Иначе
		Для Номер = 0 По СтрокиПосредническойДеятельности.Количество() - 1 Цикл
			
			Если Номер = 0 Тогда
				ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_ФНС_Много_Начало";
			ИначеЕсли Номер = СтрокиПосредническойДеятельности.Количество() - 1 Тогда
				Если СтрокаТЧ.РезультатПроверки = Перечисления.РезультатПроверкиСтрокиДекларации.ВыявленыРасхождения Тогда
					ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_ФНС_Много_Расхождения_Конец";
				Иначе
					ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_ФНС_Много_Конец";
				КонецЕсли;
			Иначе
				ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_ФНС_Много_Середина";
			КонецЕсли;
			
			ВывестиСтрокуЖурнала(Бланк, ИмяОбласти, СтрокаТЧ, СтрокиПосредническойДеятельности[Номер], ТабДокумент);
			
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

Функция ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТаблицы, ПолеИНН, ТаблицаКонтрагентов, ПолеКПП = "")
	
	СведенияОКонтрагенте = Новый Структура("ИНН, КПП");
	СведенияОКонтрагенте.ИНН = СтрокаТаблицы[ПолеИНН];
	
	Если ЗначениеЗаполнено(ПолеКПП) Тогда
		
		СведенияОКонтрагенте.КПП = СтрокаТаблицы[ПолеКПП];
		
		Сведения = Документы.ПоясненияКДекларацииПоНДС.СведенияОКонтрагентеПоТаблицеКонтрагентов(
			СведенияОКонтрагенте.ИНН, 
			ТаблицаКонтрагентов, 
			СведенияОКонтрагенте.КПП);
		
		Контрагенты = Сведения.Контрагенты;
		
	Иначе
			
		Сведения = Документы.ПоясненияКДекларацииПоНДС.СведенияОКонтрагентеПоТаблицеКонтрагентов(
			СведенияОКонтрагенте.ИНН, 
			ТаблицаКонтрагентов);
			
		Контрагенты = Сведения.Контрагенты;
		
	КонецЕсли;
	
	Представление = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ПредставлениеПоСпискуСтрок(Контрагенты);
	Представление = Документы.ПоясненияКДекларацииПоНДС.ПредставлениеКонтрагента(СведенияОКонтрагенте, Представление);
	Возврат Представление;
	
КонецФункции

Процедура ДополнитьПояснениеПредставлениямиПолей(Пояснение, ВыбранныеСтроки)
	
	ВТребованииЕстьXMLФайл = ЕстьТребованияКРазделам8_12(Пояснение.Требование);
	ДанныеТребования       = Справочники.ДокументыРеализацииПолномочийНалоговыхОрганов.ДанныеТребованияОПредставленииПоясненийКДекларацииНДС(Пояснение.Требование);
	
	Если ВТребованииЕстьXMLФайл Тогда
		ВерсияФоматаТребования = ДанныеТребования.ВерсФорм;
	КонецЕсли;
	
	// Добавляем представление в документы оплаты
	ДокументыОплаты = Пояснение.ДокументыОплаты.Выгрузить();
	ДокументыОплаты.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	
	Для каждого ДокументОплаты Из ДокументыОплаты Цикл
		ДокументОплаты.Представление = Документы.ПоясненияКДекларацииПоНДС.ПредставлениеДокументаОплаты(ДокументОплаты);
	КонецЦикла; 
	
	// Добавляем представление в даты принятия на учет
	ДатыПринятияНаУчет = Пояснение.ДатыПринятияНаУчет.Выгрузить();
	ДатыПринятияНаУчет.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	
	Для каждого ДатаПринятияНаУчет Из ДатыПринятияНаУчет Цикл
		ДатаПринятияНаУчет.Представление = Документы.ПоясненияКДекларацииПоНДС.ПредставлениеДатыПринятияНаУчет(ДатаПринятияНаУчет);
	КонецЦикла;
	
	// СведенияОКонтрагентах
	ТаблицаКонтрагентов = ТаблицаКонтрагентовПояснения(Пояснение);
	СведенияОКонтрагентах = СведенияОКонтрагентахПояснения(Пояснение, ТаблицаКонтрагентов);
	СведенияОКонтрагентах.Колонки.ПредставлениеКонтрагента.Имя = "Представление";
		
	// Помещаем недостающие реквизиты в таблицу
	Для каждого ДанныеПоРазделу Из ВыбранныеСтроки Цикл
		
		Имя    = ДанныеПоРазделу.Ключ;
		Строки = ДанныеПоРазделу.Значение;
		
		Если Имя = "СведКС" ИЛИ Имя = "ПояснИнОсн" Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого СтрокаТЧ Из Строки Цикл
			
			
			Если Имя = "КнигаПокупок" ИЛИ Имя = "КнигаПокупокДл" Тогда
				
				СтрокаТЧ.Вставить("ОшибкаПредставление", Документы.ПоясненияКДекларацииПоНДС.ПредставлениеОшибкиРаздела8(СтрокаТЧ.КодОшибки, СтрокаТЧ.ГрафаОшибки));
				
				СтрокаТЧ.Вставить("ПродавецПредставление", ПредставлениеМножественногоЗначенияПояснения(СтрокаТЧ.Продавец, СведенияОКонтрагентах));
				СтрокаТЧ.Вставить("ПродавецРасхождениеПредставление", ПредставлениеМножественногоЗначенияПояснения(СтрокаТЧ.ПродавецРасхождение, СведенияОКонтрагентах));
				
				СтрокаТЧ.Вставить("ПосредникИННПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПосредникИНН", ТаблицаКонтрагентов));
				СтрокаТЧ.Вставить("ПосредникИННРасхождениеПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПосредникИННРасхождение", ТаблицаКонтрагентов));
				
			КонецЕсли;

			Если Имя = "КнигаПродаж" ИЛИ Имя = "КнигаПродажДл" Тогда
				
				СтрокаТЧ.Вставить("ОшибкаПредставление", Документы.ПоясненияКДекларацииПоНДС.ПредставлениеОшибкиРаздела9(СтрокаТЧ.КодОшибки, СтрокаТЧ.ГрафаОшибки, ВерсияФоматаТребования));
				
				СтрокаТЧ.Вставить("ПокупательПредставление", ПредставлениеМножественногоЗначенияПояснения(СтрокаТЧ.Покупатель, СведенияОКонтрагентах));
				СтрокаТЧ.Вставить("ПокупательРасхождениеПредставление", ПредставлениеМножественногоЗначенияПояснения(СтрокаТЧ.ПокупательРасхождение, СведенияОКонтрагентах));

				СтрокаТЧ.Вставить("ПосредникИННПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПосредникИНН", ТаблицаКонтрагентов));
				СтрокаТЧ.Вставить("ПосредникИННРасхождениеПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПосредникИННРасхождение", ТаблицаКонтрагентов));
				
			КонецЕсли;

			Если Имя = "ЖурналУчетаВыставленныхСчетовФактур" Тогда
				
				СтрокаТЧ.Вставить("ОшибкаПредставление", Документы.ПоясненияКДекларацииПоНДС.ПредставлениеОшибкиРаздела10(СтрокаТЧ.КодОшибки, СтрокаТЧ.ГрафаОшибки));
				
				СтрокаТЧ.Вставить("ПокупательИННПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПокупательИНН", ТаблицаКонтрагентов));
				СтрокаТЧ.Вставить("ПокупательИННРасхождениеПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПокупательИННРасхождение", ТаблицаКонтрагентов));

			КонецЕсли;

			Если Имя = "ЖурналУчетаПолученныхСчетовФактур" Тогда
				
				СтрокаТЧ.Вставить("ОшибкаПредставление", Документы.ПоясненияКДекларацииПоНДС.ПредставлениеОшибкиРаздела11(СтрокаТЧ.КодОшибки, СтрокаТЧ.ГрафаОшибки));
				
				СтрокаТЧ.Вставить("ПродавецИННПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПродавецИНН", ТаблицаКонтрагентов));
				СтрокаТЧ.Вставить("ПродавецИННРасхождениеПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПродавецИННРасхождение", ТаблицаКонтрагентов));
				
				СтрокаТЧ.Вставить("СубкомиссионерИННПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "СубкомиссионерИНН", ТаблицаКонтрагентов));
				СтрокаТЧ.Вставить("СубкомиссионерИННРасхождениеПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "СубкомиссионерИННРасхождение", ТаблицаКонтрагентов));
				
			КонецЕсли;

			Если Имя = "ВыставленныеСчетаФактурыНеплательщиковНДС" Тогда
				
				СтрокаТЧ.Вставить("ОшибкаПредставление", Документы.ПоясненияКДекларацииПоНДС.ПредставлениеОшибкиРаздела12(СтрокаТЧ.КодОшибки, СтрокаТЧ.ГрафаОшибки));
				
				СтрокаТЧ.Вставить("ПокупательИННПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПокупательИНН", ТаблицаКонтрагентов));
				СтрокаТЧ.Вставить("ПокупательИННРасхождениеПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПокупательИННРасхождение", ТаблицаКонтрагентов));
				
			КонецЕсли;

			Если Имя <> "НетКнигаПрод" Тогда
				СтрокаТЧ.Вставить("ПериодОтраженияЗаписиПредставление", Документы.ПоясненияКДекларацииПоНДС.ПредставлениеПериодаОтраженияЗаписи(СтрокаТЧ));
			КонецЕсли;
			
			// Представление СФ
			Если Имя <> "ВыставленныеСчетаФактурыНеплательщиковНДС" И Имя <> "НетКнигаПрод" Тогда
				
				РеквизитыСчетаФактуры = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ПредставлениеСчетаФактурыПояснения(СтрокаТЧ, "");
			    СтрокаТЧ.Вставить("РеквизитыСчетаФактуры", РеквизитыСчетаФактуры);
				
				РеквизитыСчетаФактурыРасхождение = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ПредставлениеСчетаФактурыПояснения(СтрокаТЧ, "Расхождение");
				СтрокаТЧ.Вставить("РеквизитыСчетаФактурыРасхождение", РеквизитыСчетаФактурыРасхождение);
				
			КонецЕсли;
			
			// Док. оплаты
			Если Имя = "КнигаПокупок" ИЛИ Имя = "КнигаПокупокДл" ИЛИ Имя = "КнигаПродаж" ИЛИ Имя = "КнигаПродажДл" Тогда
				
				ДокументОплатыПредставление = ПредставлениеМножественногоЗначенияПояснения(СтрокаТЧ.ДокументОплаты, ДокументыОплаты);
				ДокументОплатыРасхождениеПредставление = ПредставлениеМножественногоЗначенияПояснения(СтрокаТЧ.ДокументОплатыРасхождение, ДокументыОплаты);
				
				СтрокаТЧ.Вставить("ДокументОплатыПредставление", ДокументОплатыПредставление);
				СтрокаТЧ.Вставить("ДокументОплатыРасхождениеПредставление", ДокументОплатыРасхождениеПредставление);
				
			КонецЕсли;
			
			// ДатаПринятияНаУчет
			Если Имя = "КнигаПокупок" ИЛИ Имя = "КнигаПокупокДл" Тогда
				ДатаПринятияНаУчет = ПредставлениеМножественногоЗначенияПояснения(СтрокаТЧ.ДатаПринятияНаУчет, ДатыПринятияНаУчет);
				ДатаПринятияНаУчетРасхождение = ПредставлениеМножественногоЗначенияПояснения(СтрокаТЧ.ДатаПринятияНаУчетРасхождение, ДатыПринятияНаУчет);
				
				СтрокаТЧ.Вставить("ДатаПринятияНаУчетДата", ДатаПринятияНаУчет);
				СтрокаТЧ.Вставить("ДатаПринятияНаУчетРасхождениеДата", ДатаПринятияНаУчетРасхождение);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПредставлениеМножественногоЗначенияПояснения(ИдентификаторЗначения, Таблица)
	
	Отбор = Новый Структура();
	Отбор.Вставить("ИдентификаторЗначения", ИдентификаторЗначения);
	СписокСтрок = Таблица.НайтиСтроки(Отбор);
	Представление = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ПредставлениеПоСпискуСтрок(СписокСтрок);
	
	Возврат Представление;
	
КонецФункции	

Функция ТабличныйДокументПояснения(Пояснение, ВыбранныеСтроки, ЭтоПечатьИзОткрытогоПояснения) Экспорт
	
	Если НЕ ЭтоПечатьИзОткрытогоПояснения Тогда
		ДополнитьПояснениеПредставлениямиПолей(Пояснение, ВыбранныеСтроки);
	КонецЕсли;
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	ТабДокумент       = Новый ТабличныйДокумент;
	
	// Шапка
	Бланк = КонтекстЭДОСервер.ПолучитьМакет("ПояснениеПоНДС");
	Шапка = Бланк.ПолучитьОбласть("Шапка");
	Шапка.Параметры["Наименование"] = Строка(Пояснение);
	ТабДокумент.Вывести(Шапка);
	
	Для каждого ДанныеПоРазделу Из ВыбранныеСтроки Цикл
		
		Имя = ДанныеПоРазделу.Ключ;
		
		Если Имя = "ПояснИнОсн" Тогда
			
			Если ЗначениеЗаполнено(Пояснение.ПояснИнОсн) Тогда
				ОбластьПояснИнОсн = Бланк.ПолучитьОбласть("ПояснИнОсн");
				ОбластьПояснИнОсн.Параметры.ПояснИнОсн = Пояснение.ПояснИнОсн;
				ТабДокумент.Вывести(ОбластьПояснИнОсн);
			КонецЕсли;
			
		Иначе
		
			Строки = ДанныеПоРазделу.Значение;
			
			Если Строки.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если Прав(Имя, 2) = "Дл" Тогда
				ИмяБезДл = Сред(Имя, 0, СтрДлина(Имя) - 2);
			Иначе
				ИмяБезДл = Имя;
			КонецЕсли;
			
			// Шапка ТЧ
			ЗаголовокТЧ = Бланк.ПолучитьОбласть("Заголовок" + Имя);
			ТабДокумент.Вывести(ЗаголовокТЧ);

			ШапкаТЧ = Бланк.ПолучитьОбласть("Шапка" + ИмяБезДл);
			
			ТабДокумент.Вывести(ШапкаТЧ);
			
			// Строка ТЧ
			Для каждого СтрокаТЧ Из Строки Цикл
				
				Если ИмяБезДл = "ЖурналУчетаВыставленныхСчетовФактур" Тогда
					
					Отбор = Новый Структура();
					Отбор.Вставить("ИдентификаторЗначения", СтрокаТЧ.ПосредническаяДеятельность);
					СтрокиПосредническойДеятельности = Пояснение.ПосредническаяДеятельность.НайтиСтроки(Отбор);
					
					Отбор = Новый Структура();
					Отбор.Вставить("ИдентификаторЗначения", СтрокаТЧ.ПосредническаяДеятельностьРасхождение);
					СтрокиПосредническойДеятельностиРасхождение = Пояснение.ПосредническаяДеятельность.НайтиСтроки(Отбор);
					
					ВывестиСтрокиПосредническойДеятельности(СтрокиПосредническойДеятельности, СтрокиПосредническойДеятельностиРасхождение, СтрокаТЧ, ТабДокумент, Бланк);
					
					Если СтрокаТЧ.РезультатПроверки = Перечисления.РезультатПроверкиСтрокиДекларации.ВыявленыРасхождения Тогда
						ВывестиСтрокиПосредническойДеятельностиРасхождение(СтрокиПосредническойДеятельности, СтрокиПосредническойДеятельностиРасхождение, СтрокаТЧ, ТабДокумент, Бланк);
					КонецЕсли;
					
				Иначе
					
					
					Если ИмяБезДл <> "СведКС" И СтрокаТЧ.РезультатПроверки = Перечисления.РезультатПроверкиСтрокиДекларации.ВыявленыРасхождения Тогда
						ИмяОбласти = "Строка" + ИмяБезДл + "СРасхождением";
					Иначе
						ИмяОбласти = "Строка" + ИмяБезДл;
					КонецЕсли;
					СтрокаТабДока = Бланк.ПолучитьОбласть(ИмяОбласти);
					
					СтрокаТабДока.Параметры.Заполнить(СтрокаТЧ);
					
					ВыделитьРасхождениеВСтрокеПояснения(СтрокаТабДока, СтрокаТЧ, ИмяОбласти);
					
					ТабДокумент.Вывести(СтрокаТабДока);
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
	
	КонецЦикла;
	
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	ДобавитьШтампПодписиПодДокументом(Пояснение, Перечисления.ТипыТранспортныхСообщений.ПредставлениеНП, ТабДокумент, 3);
	
	Возврат ТабДокумент; 
	
КонецФункции

Процедура ВыделитьРасхождениеВСтрокеПояснения(СтрокаТабДока, СтрокаТЧ, ИмяОбласти)
	
	Для каждого ОбластьТабДока Из СтрокаТабДока.Области Цикл
		
		Имя = ОбластьТабДока.Имя;
		Позиция = СтрНайти(Имя, "__");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПараметраРасхождения = Сред(ОбластьТабДока.Имя, Позиция + 2);
		ИмяПараметра = СтрЗаменить(ИмяПараметраРасхождения, "Расхождение", "");
		
		Попытка
			Если СтрокаТЧ[ИмяПараметра] <> СтрокаТЧ[ИмяПараметраРасхождения] Тогда
				СтрокаТабДока.Области[ИмяОбласти + "__" + ИмяПараметраРасхождения].Шрифт = Новый Шрифт(,,Истина);
			КонецЕсли;
		Исключение
			// Не нужна специальная обработка - нет такого параметра или области
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры 

#КонецОбласти

#Область РазборИВыводАктаСверкиСФНСвФорматеXML

// Функция - разбирает акт сверки с ФНС в формате XML, по данным файла создает структуру данных.
//
// Параметры:
//  АдресХранилища	 - 	Строка - адрес хранилища XML файла.
// 
// Возвращаемое значение:
//  Структура - данные акта сверки с ФНС.
//
Функция РазборАктаСверкиВФорматеXML(АдресХранилища) Экспорт
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресХранилища);
	ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);
	ЧтениеXML.ПерейтиКСодержимому();
	
	Фабрика = ФабрикаXDTO;
	ОтветФНСXDTO = Фабрика.ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	ДокументXDTO = ОтветФНСXDTO.Документ;
	
	АктыСверок = НовыеАктыСверок();
	
	// В схеме АктСвер обязательный элемент, но иногда может отсутствовать
	СвойствоXDTOАктСвер = ДокументXDTO.Свойства().Получить("АктСвер"); 
	Если СвойствоXDTOАктСвер = Неопределено Тогда
		Возврат АктыСверок;
	КонецЕсли;
	
	Если ТипЗнч(ДокументXDTO.АктСвер) = Тип("СписокXDTO") Тогда
		
		Для Каждого АктСверXDTO Из ДокументXDTO.АктСвер Цикл
			
			ЗаполнитьАктСверки(АктСверXDTO, АктыСверок);
			
		КонецЦикла;
		
	Иначе
		
		ЗаполнитьАктСверки(ДокументXDTO.АктСвер, АктыСверок);
		
	КонецЕсли;
	
	Возврат АктыСверок;
	
КонецФункции

// Функция - получает табличное представление акта сверки
//
// Параметры:
//  ДанныеАктаСверки - 	ТаблицаЗначений - разобранные данные акта сверки.
//  ИндексСверки - 		Число - индекс cтроки cверки.
//
// Возвращаемое значение:
//  Табличный документ - табличный документ с данными акта сверки с ФНС.
//
Функция ПолучитьТабличноеПредставление(ЗапросИОН, ДанныеАктаСверки, ИндексСверки) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	
	АктСверки = Новый ТабличныйДокумент;
	МакетАкта = КонтекстЭДОСервер.ПолучитьМакет("АктСверкиСФНС");
	
	// ШАПКА -------------------------------------------------
	
	ДанныеАктаСверки.НаименованиеИФНС = НаименованиеИФНСПоКоду(ДанныеАктаСверки.КодИФНС);
	
	Шапка = МакетАкта.ПолучитьОбласть("Шапка");
	Шапка.Параметры.НомерАкта                = ДанныеАктаСверки.НомерАкта;
	Шапка.Параметры.ДатаАкта                 = Формат(ДанныеАктаСверки.ДатаАкта, "ДЛФ=D");
	Шапка.Параметры.НаименованиеИФНС         = ДанныеАктаСверки.НаименованиеИФНС;
	Шапка.Параметры.НаименованиеОрганизации  = ДанныеАктаСверки.НаименованиеОрганизации;
	Шапка.Параметры.ИННОрганизации           = ДанныеАктаСверки.ИНН;
	Если ДанныеАктаСверки.ЭтоЮрЛицо Тогда
		Шапка.Параметры.ЗаголовокИНН         = НСтр("ru = 'ИНН / КПП:';
													|en = 'TIN / CRTR:'");
		Шапка.Параметры.КППОрганизации       = " / " + ДанныеАктаСверки.КПП
	Иначе
		Шапка.Параметры.ЗаголовокИНН         = НСтр("ru = 'ИНН:';
													|en = 'TIN:'");
	КонецЕсли;
	
	АктСверки.Вывести(Шапка);
	
	// ШАПКА ТАБЛИЦЫ -----------------------------------------
	
	ШапкаТаблицы = МакетАкта.ПолучитьОбласть("ШапкаТаблицы");
	ШапкаТаблицы.Параметры.ДатаНачала = Формат(ДанныеАктаСверки.ДатаНачала, "ДЛФ=D");
	ШапкаТаблицы.Параметры.ДатаОкончания = Формат(ДанныеАктаСверки.ДатаОкончания, "ДЛФ=D");
	
	АктСверки.Вывести(ШапкаТаблицы);
	
	// ВЫВОД ДАННЫХ ПО НАЛОГАМ В ТАБЛИЧНЫЙ ДОКУМЕНТ ----------
	
	СодержаниеСверки = ДанныеАктаСверки.Раздел2;
	РасчетДополнительныхПолей(СодержаниеСверки); // контроль наличия данных, расчет доп. полей
	
	АктСверки.НачатьАвтогруппировкуСтрок();
	КолВидовНалогов = 0;
	МакетСтрокиПоВидамНалогов = МакетАкта.ПолучитьОбласть("ВидНалога");
	Для Каждого СтрокаВидаНалога Из СодержаниеСверки Цикл
		
		Если СтрокаВидаНалога.ВидНалогаКонтроль = 0 Тогда // если по виду налога все по нулям, не выводим его
			Продолжить;
		КонецЕсли;
		
		// Если имеется несколько строк налогов с одинаковым КБК, выводим ОКТМО
		МассивВидовНалогов = СодержаниеСверки.НайтиСтроки(Новый Структура("КБК", СтрокаВидаНалога.КБК));
		КолКБК = 0;
		Для Каждого ЭлементМассива Из МассивВидовНалогов Цикл
			
			Если ЭлементМассива.ВидНалогаКонтроль > 0 Тогда
				КолКБК = КолКБК + 1;
			КонецЕсли;
			
		КонецЦикла;
		Если КолКБК > 1 Тогда
			СтрокаВидаНалога.НаименованиеНалога = СтрокаВидаНалога.НаименованиеНалога
				+ " " + НСтр("ru = 'по ОКТМО';
							|en = 'by RNCMT'") + " " + СтрокаВидаНалога.ОКТМО;
		КонецЕсли;
		
		КолВидовНалогов = КолВидовНалогов + 1;
		НомерСтрокиСверки = СодержаниеСверки.Индекс(СтрокаВидаНалога);
		МакетСтрокиПоВидамНалогов.Параметры.Заполнить(СтрокаВидаНалога);
		МакетСтрокиПоВидамНалогов.Параметры.СтрокаДанных = Формат(ИндексСверки, "ЧН=0; ЧГ=0")
			+ ";" + Формат(НомерСтрокиСверки, "ЧН=0; ЧГ=0"); // данные для расшифровки
		
		АктСверки.Вывести(МакетСтрокиПоВидамНалогов, 1,, Истина);
		
		МассивПодвидовНалога = Новый Массив;
		Если СтрокаВидаНалога.НалогКонтроль > 0 Тогда
			МассивПодвидовНалога.Добавить("Налог");
		КонецЕсли;
		Если СтрокаВидаНалога.ПеняКонтроль > 0 Тогда
			МассивПодвидовНалога.Добавить("Пеня");
		КонецЕсли;
		Если СтрокаВидаНалога.ШтрафКонтроль > 0 Тогда
			МассивПодвидовНалога.Добавить("Штраф");
		КонецЕсли;
		Если СтрокаВидаНалога.ПрочееКонтроль > 0 Тогда
			МассивПодвидовНалога.Добавить("Прочее");
		КонецЕсли;
		
		Если Не (МассивПодвидовНалога.Количество() = 1 И МассивПодвидовНалога[0] = "Налог") Тогда
			
			Для Каждого ПодвидНалога Из МассивПодвидовНалога Цикл
				
				МакетСтрокиДетализацияРасчетов = МакетАкта.ПолучитьОбласть(ПодвидНалога);
				МакетСтрокиДетализацияРасчетов.Параметры.Заполнить(СтрокаВидаНалога);
				МакетСтрокиДетализацияРасчетов.Параметры.СтрокаДанных = Формат(ИндексСверки, "ЧН=0; ЧГ=0")
					+ ";" + Формат(НомерСтрокиСверки, "ЧН=0; ЧГ=0");
				
				АктСверки.Вывести(МакетСтрокиДетализацияРасчетов, 2,, Истина);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	АктСверки.ЗакончитьАвтогруппировкуСтрок();
	
	Если КолВидовНалогов > 1 Тогда // если только 1 вид налога, итоги не выводим
		
		// вывод итогов
		МакетИтого = МакетАкта.ПолучитьОбласть("Итого");
		ТаблицаИтого = СодержаниеСверки.Скопировать();
		ТаблицаИтого.Колонки.Добавить("Свертка", Новый ОписаниеТипов("Булево"));
		ТаблицаИтого.Свернуть("Свертка",
			"ЗадолженностьНаНачало, ПереплатаНаНачало, НачисленоЗаПериод, УплаченоЗаПериод, ЗадолженностьНаКонец, ПереплатаНаКонец");
			
		МакетИтого.Параметры.Заполнить(ТаблицаИтого[0]);
			
		АктСверки.Вывести(МакетИтого);
		
	КонецЕсли;
	
	// незачисленные средства, вывод
	Если СодержаниеСверки.Итог("НеЗачисленныеСредстваКонтроль") > 0 Тогда

		МакетШапки = МакетАкта.ПолучитьОбласть("НезачисленныеСредстваШапка");
		
		АктСверки.Вывести(МакетШапки);
		АктСверки.НачатьАвтогруппировкуСтрок();
		Для Каждого СтрокаСверки Из СодержаниеСверки Цикл
			
			Если СтрокаСверки.НеЗачисленныеСредстваКонтроль = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			МакетСтроки = МакетАкта.ПолучитьОбласть("НезачисленныеСредстваВидНалога");
			НомерСтрокиСверки = СодержаниеСверки.Индекс(СтрокаВидаНалога);
			МакетСтроки.Параметры.Заполнить(СтрокаСверки);
			МакетСтроки.Параметры.СтрокаДанных = Формат(ИндексСверки, "ЧН=0; ЧГ=0")
				+ ";" + Формат(НомерСтрокиСверки, "ЧН=0; ЧГ=0");
			
			АктСверки.Вывести(МакетСтроки, 1);
			
			МассивПодвидовНалога = Новый Массив;
			Если СтрокаСверки.НеЗачисленныеСредстваНалог <> 0 Тогда
				МассивПодвидовНалога.Добавить("НезачисленныеСредстваНалог");
			КонецЕсли;
			Если СтрокаСверки.НеЗачисленныеСредстваПени <> 0 Тогда
				МассивПодвидовНалога.Добавить("НеЗачисленныеСредстваПени");
			КонецЕсли;
			Если СтрокаСверки.НеЗачисленныеСредстваШтраф <> 0 Тогда
				МассивПодвидовНалога.Добавить("НеЗачисленныеСредстваШтраф");
			КонецЕсли;
			Если СтрокаСверки.НезачисленныеСредстваНеуплаченныеПроценты <> 0 Тогда
				МассивПодвидовНалога.Добавить("НезачисленныеСредстваНеуплаченныеПроценты");
			КонецЕсли;
			Если СтрокаСверки.НеЗачисленныеСредстваПроценты <> 0 Тогда
				МассивПодвидовНалога.Добавить("НеЗачисленныеСредстваПроценты");
			КонецЕсли;
			
			Если Не (МассивПодвидовНалога.Количество() = 1 И МассивПодвидовНалога[0] = "НезачисленныеСредстваНалог") Тогда
				
				Для Каждого ПодвидНалога Из МассивПодвидовНалога Цикл
					
					МакетСтроки = МакетАкта.ПолучитьОбласть(ПодвидНалога);
					МакетСтроки.Параметры.Заполнить(СтрокаСверки);
					МакетСтроки.Параметры.СтрокаДанных = "" + ИндексСверки + ";" + НомерСтрокиСверки;
					
					АктСверки.Вывести(МакетСтроки, 2,, Истина);
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		АктСверки.ЗакончитьАвтогруппировкуСтрок();
		
	КонецЕсли;
	
	ДобавитьШтампПодписиВРезультатЗапросаИОН(ЗапросИОН, АктСверки, 3, Ложь);
	
	Возврат АктСверки;
	
КонецФункции

// Функция - формирует табличный документ с расшифровкой поля акта сверки.
//
// Параметры:
//  ДанныеАктаСверки	 - 	Структура - данные акта сверки с ФНС.
//  НомерСтрокиСверки	 - 	Число - строка, по которой нужно сформировать расшифровку.
// 
// Возвращаемое значение:
//  ТабличныйДокумент - табличный документ с расшифровкой строки акта сверки.
//
Функция СформироватьРасшифровку(ДанныеАктаСверки, НомерСтрокиСверки) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	
	МакетРасшифровки      = КонтекстЭДОСервер.ПолучитьМакет("РасшифровкаАктаСверкиСФНС");
	СтрокаДанныхНалога    = ДанныеАктаСверки.Раздел2[НомерСтрокиСверки];
	РасшифровкаАктаСверки = Новый ТабличныйДокумент;
	
	// ШАПКА -------------------------------------------------
	Шапка = МакетРасшифровки.ПолучитьОбласть("Шапка");
	Шапка.Параметры.НаименованиеИФНС         = ДанныеАктаСверки.НаименованиеИФНС;
	Шапка.Параметры.НаименованиеОрганизации  = ДанныеАктаСверки.НаименованиеОрганизации;
	Шапка.Параметры.ИННОрганизации           = ДанныеАктаСверки.ИНН;
	Если ДанныеАктаСверки.ЭтоЮрЛицо Тогда
		Шапка.Параметры.ЗаголовокИНН         = НСтр("ru = 'ИНН / КПП:';
													|en = 'TIN / CRTR:'");
		Шапка.Параметры.КППОрганизации       = " / " + ДанныеАктаСверки.КПП;
	Иначе
		Шапка.Параметры.ЗаголовокИНН         = НСтр("ru = 'ИНН:';
													|en = 'TIN:'");
	КонецЕсли;
	
	Шапка.Параметры.НаименованиеНалога       = СтрокаДанныхНалога.НаименованиеНалога;
	Шапка.Параметры.НаименованиеПолное       = СтрокаДанныхНалога.НаименованиеПолное;
	Шапка.Параметры.КБК                      = СтрокаДанныхНалога.КБК;
	Шапка.Параметры.ОКТМО                    = СтрокаДанныхНалога.ОКТМО;
	
	РасшифровкаАктаСверки.Вывести(Шапка);
	
	// САЛЬДО НА НАЧАЛО --------------------------------------
	
	ДанныеРаздела = ПодготовкаДанныхРасшифровки(МакетРасшифровки, "СальдоНаНачалоТело", СтрокаДанныхНалога);
	Если ДанныеРаздела.ЕстьДанные Тогда
		
		МакетДанных = МакетРасшифровки.ПолучитьОбласть("СальдоНаНачалоШапка");
		МакетДанных.Параметры.ДатаНачала = Формат(ДанныеАктаСверки.ДатаНачала, "ДЛФ=D");
		
		РасшифровкаАктаСверки.Вывести(МакетДанных);
		
		РасшифровкаАктаСверки.Вывести(ДанныеРаздела.ТабДокумент);
		
	КонецЕсли;
	
	// ОБОРОТЫ ЗА ПЕРИОД --------------------------------------
	
	ДанныеРаздела = ПодготовкаДанныхРасшифровки(МакетРасшифровки, "ОборотыЗаПериодТело", СтрокаДанныхНалога);
	Если ДанныеРаздела.ЕстьДанные Тогда
		
		МакетДанных = МакетРасшифровки.ПолучитьОбласть("ОборотыЗаПериодШапка");
		МакетДанных.Параметры.ПериодСверки = ПредставлениеПериода(
			НачалоДня(ДанныеАктаСверки.ДатаНачала), КонецДня(ДанныеАктаСверки.ДатаОкончания), "ФП = Истина");
		
		РасшифровкаАктаСверки.Вывести(МакетДанных);
		
		РасшифровкаАктаСверки.Вывести(ДанныеРаздела.ТабДокумент);
		
	КонецЕсли;
	
	// САЛЬДО НА КОНЕЦ ---------------------------------------
	
	ДанныеРаздела = ПодготовкаДанныхРасшифровки(МакетРасшифровки, "СальдоНаКонецТело", СтрокаДанныхНалога);
	Если ДанныеРаздела.ЕстьДанные Тогда
	
		МакетДанных = МакетРасшифровки.ПолучитьОбласть("СальдоНаКонецШапка");
		МакетДанных.Параметры.ДатаОкончания = Формат(ДанныеАктаСверки.ДатаОкончания, "ДЛФ=D");
		
		РасшифровкаАктаСверки.Вывести(МакетДанных);
	
		РасшифровкаАктаСверки.Вывести(ДанныеРаздела.ТабДокумент);
		
	КонецЕсли;
	
	// НЕЗАЧИСЛЕННЫЕ ПЛАТЕЖИ ---------------------------------
	
	ДанныеРаздела = ПодготовкаДанныхРасшифровки(МакетРасшифровки, "НезачисленныеСредстваТело", СтрокаДанныхНалога);
	Если ДанныеРаздела.ЕстьДанные Тогда
		
		МакетДанных = МакетРасшифровки.ПолучитьОбласть("НезачисленныеСредстваШапка");
		
		РасшифровкаАктаСверки.Вывести(МакетДанных);
		
		РасшифровкаАктаСверки.Вывести(ДанныеРаздела.ТабДокумент);
		
	КонецЕсли;
	
	Возврат РасшифровкаАктаСверки;
	
КонецФункции

Процедура РасчетДополнительныхПолей(СодержаниеСверки)
	
	НалогиПоКБК = Обработки.ДокументооборотСКонтролирующимиОрганами.ПолучитьМакет("КБК");
	КолонкаКБК = НалогиПоКБК.Область("КБК"); // область таблицы с КБК
	ОписаниеКолонкиСТипомЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(17, 2);
	
	СодержаниеСверки.Колонки.Добавить("НаименованиеПолное",          Новый ОписаниеТипов("Строка"));
	
	СодержаниеСверки.Колонки.Добавить("ЗадолженностьНаНачало",       ОписаниеКолонкиСТипомЧисло);
	СодержаниеСверки.Колонки.Добавить("ПереплатаНаНачало",           ОписаниеКолонкиСТипомЧисло);
