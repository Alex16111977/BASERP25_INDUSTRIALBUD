		|	ЕСТЬNULL(УчетныеЗаписиДокументооборота.ИдентификаторАбонента, """") КАК ИдентификаторАбонента,
		|	ЕСТЬNULL(УчетныеЗаписиДокументооборота.СпецоператорСвязи,
