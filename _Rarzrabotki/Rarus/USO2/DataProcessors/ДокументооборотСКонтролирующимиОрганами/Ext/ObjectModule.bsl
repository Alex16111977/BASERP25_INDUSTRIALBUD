Процедура СформироватьПакетФНС_ПолучитьИПроверитьСертификатыПолучателя(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(КонтекстОтправки.УчетнаяЗапись).ЭлектроннаяПодписьВМоделиСервиса;
	
	Если ТипЗнч(КонтекстОтправки.СертификатПолучателя) <> Тип("Массив") Тогда
		Отпечатки = Новый Массив;
		Отпечатки.Добавить(КонтекстОтправки.СертификатПолучателя);
	Иначе
		Отпечатки = КонтекстОтправки.СертификатПолучателя;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КонтекстОтправки.СертификатСервераДокументооборота)
		И Отпечатки.Найти(КонтекстОтправки.СертификатСервераДокументооборота) = Неопределено Тогда
		
		Отпечатки = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(Отпечатки);
		Отпечатки.Добавить(КонтекстОтправки.СертификатСервераДокументооборота);
	КонецЕсли;
	
	СертификатыДляПоиска = Новый Массив;
	Для Каждого Отпечаток Из Отпечатки Цикл
		СертификатыДляПоиска.Добавить(Новый Структура("ЭтоЭлектроннаяПодписьВМоделиСервиса, Отпечаток", ЭтоЭлектроннаяПодписьВМоделиСервиса, Отпечаток));
	КонецЦикла;
	
	РезультатПоиска = НайтиСертификаты(СертификатыДляПоиска, Истина);
	
	СформироватьПакетФНС_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатов(КонтекстОтправки, СообщениеОбОшибке, РезультатПоиска)
	
КонецПроцедуры

Процедура СформироватьПакетФНС_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатов(КонтекстОтправки, СообщениеОбОшибке, РезультатПоиска)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	НайденныеСертификаты 				= ?(РезультатПоиска.Свойство("Сертификаты"), РезультатПоиска.Сертификаты, Неопределено);
	НенайденныеСертификаты 				= ?(РезультатПоиска.Свойство("НенайденныеСертификаты"), РезультатПоиска.НенайденныеСертификаты,
											Неопределено);
	СсылкаПолучатель 					= КонтекстОтправки.СсылкаПолучатель;
	СертификатПолучателя 				= КонтекстОтправки.СертификатПолучателя;
	СертификатСервераДокументооборота 	= КонтекстОтправки.СертификатСервераДокументооборота;
	СсылкаСерверДокументооборота 		= КонтекстОтправки.СсылкаСерверДокументооборота;
	
	ИнформацияОПолучателяхИСертификатах = Новый Структура;
	ИнформацияОПолучателяхИСертификатах.Вставить("СертификатСервераДокументооборота", 	СертификатСервераДокументооборота);
	ИнформацияОПолучателяхИСертификатах.Вставить("СсылкаСерверДокументооборота", 		СсылкаСерверДокументооборота);
	ИнформацияОПолучателяхИСертификатах.Вставить("СертификатПолучателя", 				СертификатПолучателя);
	РезультатПроверки = СформироватьПакетФНС_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатовРазобратьНайденное(
		РезультатПоиска.Выполнено,
		НайденныеСертификаты,
		НенайденныеСертификаты,
		СсылкаПолучатель,
		ИнформацияОПолучателяхИСертификатах);
	Если РезультатПроверки = Неопределено Тогда
		СообщениеОбОшибке = ТекстСообщенийПользователю();
		Возврат;
	КонецЕсли;
	
	КонтекстОтправки.Вставить("ОбъектСертификатПолучателя", РезультатПроверки.НайденныеСертификатыПолучателя);
	КонтекстОтправки.Вставить("ОбъектСертификатСервераДокументооборота",
		РезультатПроверки.НайденныйСертификатСервераДокументооборота);
	
КонецПроцедуры

Функция СформироватьПакетФНС_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатовРазобратьНайденное(
		Выполнено,
		НайденныеСертификаты,
		НенайденныеСертификаты,
		СсылкаПолучатель,
		ИнформацияОПолучателяхИСертификатах = Неопределено) Экспорт
	
	Если ИнформацияОПолучателяхИСертификатах = Неопределено Тогда
		СертификатСервераДокументооборота 	= Неопределено;
		СсылкаСерверДокументооборота 		= Неопределено;
		СертификатПолучателя 				= Неопределено;
	Иначе
		СертификатСервераДокументооборота 	= СокрЛП(ИнформацияОПолучателяхИСертификатах.СертификатСервераДокументооборота);
		СсылкаСерверДокументооборота 		= ИнформацияОПолучателяхИСертификатах.СсылкаСерверДокументооборота;
		СертификатПолучателя 				= ИнформацияОПолучателяхИСертификатах.СертификатПолучателя;
	КонецЕсли;
	
	Если Не Выполнено Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Не удалось определить цифровой сертификат получателя
                  |%1
                  |для шифрования сообщения!';
                  |en = 'Cannot determine a digital certificate of recipient 
                  |%1
                  |for encrypting the message.'"), СсылкаПолучатель);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СертификатСервераДокументооборота) Тогда
		Для каждого НенайденныйСертификат Из НенайденныеСертификаты Цикл
			Если СокрЛП(НенайденныйСертификат.Отпечаток) = СертификатСервераДокументооборота Тогда
				ТекстСообщения = СтрШаблон(
					НСтр("ru = 'Не удалось определить цифровой сертификат сервера документооборота %1.';
						|en = 'Cannot determine a digital certificate of data interchange server %1.'"),
					СсылкаСерверДокументооборота);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Неопределено;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НенайденныеСертификаты.Количество() > 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Не удалось определить цифровой сертификат получателя
                  |%1
                  |для шифрования сообщения!';
                  |en = 'Cannot determine a digital certificate of recipient 
                  |%1
                  |for encrypting the message.'"), СсылкаПолучатель);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	ИндексСертификатаСервераДокументооборота = -1;
	Если ТипЗнч(СсылкаПолучатель) = Тип("СправочникСсылка.НалоговыеОрганы") Тогда
		
		Для ИндексНайденногоСертификата = 0 По НайденныеСертификаты.Количество() - 1 Цикл
			ОбъектНайденныйСертификат = НайденныеСертификаты[ИндексНайденногоСертификата];
			
			Если ЗначениеЗаполнено(СертификатСервераДокументооборота)
				И СокрЛП(ОбъектНайденныйСертификат.Отпечаток) = СертификатСервераДокументооборота Тогда
				
				Если НЕ ОбъектНайденныйСертификат.Валиден Тогда
					ТекстСообщения = СтрШаблон(
						НСтр("ru = 'Ошибка проверки сертификата сервера документооборота %1.';
							|en = 'An error occurred while checking a certificate of data interchange server %1.'"),
						СсылкаСерверДокументооборота);
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
					Возврат Неопределено;
				КонецЕсли;
				ИндексСертификатаСервераДокументооборота = ИндексНайденногоСертификата;
				
			Иначе
				РезультатПроверкиСертификатаНалоговогоОргана = ПроверитьСертификатПоПериоду(ОбъектНайденныйСертификат);
				Если РезультатПроверкиСертификатаНалоговогоОргана <> Истина Тогда
					ТекстСообщения = СтрШаблон(
						НСтр("ru = 'Ошибка проверки сертификата налогового органа %1 с отпечатком %2.';
							|en = 'An error occurred while checking a certificate of tax authority %1 with thumbprint %2.'"), 
						СсылкаПолучатель,
						ОбъектНайденныйСертификат.Отпечаток);
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
					Возврат Неопределено;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(СертификатСервераДокументооборота) И ИндексСертификатаСервераДокументооборота = -1 Тогда
			ТекстСообщения = СтрШаблон(
				НСтр("ru = 'В свойствах сервера документооборота %1 не задан сертификат.';
					|en = 'Certificate is not specified in the properties of data interchange server %1.'"),
				СсылкаСерверДокументооборота);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		
		// Проверяем на наличие хотя бы одного сертификата.
		Если НайденныеСертификаты.Количество() <= ?(ЗначениеЗаполнено(СертификатСервераДокументооборота), 1, 0) Тогда
			ТекстСообщения = СтрШаблон(
				НСтр("ru = 'В свойствах налогового органа %1 не задан ни один сертификат.';
					|en = 'No certificates are specified in the properties of tax authority %1.'"), СсылкаПолучатель);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СсылкаПолучатель) = Тип("СправочникСсылка.СерверыДокументооборота") Тогда
		
		// Проверяем сертификат.
		Если Не НайденныеСертификаты[0].Валиден Тогда
			ТекстСообщения = СтрШаблон(
				НСтр("ru = 'Ошибка проверки сертификата сервера документооборота %1.';
					|en = 'An error occurred while checking a certificate of data interchange server %1.'"), СсылкаПолучатель);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("НайденныеСертификатыПолучателя", НайденныеСертификаты);
	Результат.Вставить("НайденныйСертификатСервераДокументооборота", Неопределено);
	
	Если ИндексСертификатаСервераДокументооборота <> -1 Тогда
		Если СертификатПолучателя <> СертификатСервераДокументооборота И (ТипЗнч(СертификатПолучателя) <> Тип("Массив")
			ИЛИ СертификатПолучателя.Найти(СертификатСервераДокументооборота) = Неопределено) Тогда
			
			Результат.НайденныеСертификатыПолучателя = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(НайденныеСертификаты);
			Результат.НайденныеСертификатыПолучателя.Удалить(ИндексСертификатаСервераДокументооборота);
		КонецЕсли;
		
		Результат.НайденныйСертификатСервераДокументооборота = НайденныеСертификаты[ИндексСертификатаСервераДокументооборота];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура СформироватьПакетФНСПослеПроверкиИПолученияСертификатовПолучателя(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если НЕ СформироватьПакетФНС_ПроверкиНаСервере(КонтекстОтправки) Тогда // универсальная
		СообщениеОбОшибке = ТекстСообщенийПользователю();
		Возврат;
	КонецЕсли;
	
	СформироватьПакетФНС_ПроверкиСертификатов(КонтекстОтправки, СообщениеОбОшибке);
	
КонецПроцедуры

Функция СформироватьПакетФНС_ПроверкиНаСервере(Контекст) Экспорт
	
	УчетнаяЗапись = Контекст.УчетнаяЗапись;
	СсылкаПолучатель = Контекст.СсылкаПолучатель;
	ЦиклОбмена = Контекст.ЦиклОбмена;
	
	// получаем и проверяем код отправителя
	КодОтправителя = СокрЛП(УчетнаяЗапись.ИдентификаторАбонента);
	Если ПустаяСтрока(КодОтправителя) Тогда
		ТекстСообщения = НСтр("ru = 'Не указан идентификатор абонента в свойствах учетной записи.';
								|en = 'Subscriber ID is not specified in the account properties.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// получаем код оператора электронного документооборота
	Если УчетнаяЗапись.ОбменНапрямую Тогда
		КодСпецоператора = Неопределено;
	Иначе
		КодСпецоператора = СокрЛП(УчетнаяЗапись.ИдентификаторСпецоператора);
		Если ПустаяСтрока(КодСпецоператора) Тогда
			ТекстСообщения = НСтр("ru = 'Не указан идентификатор оператор электронного документооборота в свойствах учетной записи.';
									|en = 'ID of the electronic data interchange provider is not specified in the account properties.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// получаем и проверяем код получателя
	Если Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеНП
		ИЛИ Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ЗапросНаВыпискуЕРГЮЛ_ЕГРИП Тогда
		Если УчетнаяЗапись.ОбменНапрямую Тогда
			КодПолучателя = ПолучитьИдентификаторОтправителяПодтвержденияДатыОтправки(Контекст.ТранспортноеСообщение.Основание);
			Если ПустаяСтрока(КодПолучателя) Тогда
				ТекстСообщения = НСтр("ru = 'При создании извещения на подтверждение даты отправки не удалось определить отправителя исходного подтверждения.';
										|en = 'Cannot determine a source confirmation sender while creating a notice of sending date confirmation.'");
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Ложь;
			КонецЕсли;
			ТипПолучателя = "налоговыйОрган";
		Иначе
			КодПолучателя = СокрЛП(УчетнаяЗапись.ИдентификаторСпецоператора);
			Если ПустаяСтрока(КодПолучателя) Тогда
				ТекстСообщения = НСтр("ru = 'Не указан идентификатор оператора электронного документооборота в свойствах учетной записи.';
										|en = 'ID of the electronic data interchange provider is not specified in the account properties.'");
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Ложь;
			КонецЕсли;
			ТипПолучателя = "спецоператор";
		КонецЕсли;
	Иначе
		КодПолучателя = СокрЛП(СсылкаПолучатель.Код);
		Если ПустаяСтрока(КодПолучателя) Тогда
			ТекстСообщения = НСтр("ru = 'Не задан код налогового органа.';
									|en = 'Tax authority code is not specified.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		ТипПолучателя = "налоговыйОрган";
	КонецЕсли;
	
	//
	UUIDПакета = СокрЛП(ЦиклОбмена.Идентификатор);
	
	Контекст.Вставить("КодОтправителя", КодОтправителя);
	Контекст.Вставить("КодСпецоператора", КодСпецоператора);
	Контекст.Вставить("КодПолучателя", КодПолучателя);
	Контекст.Вставить("ТипПолучателя", ТипПолучателя);
	Контекст.Вставить("UUIDПакета", UUIDПакета);
	
	Возврат Истина;
	
КонецФункции

Процедура СформироватьПакетФНСПослеПроверкиСертификатов(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если КонтекстОтправки.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ДекларацияНП
		ИЛИ КонтекстОтправки.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ЗаявлениеНП
		ИЛИ КонтекстОтправки.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.Форма2НДФЛНП
		ИЛИ КонтекстОтправки.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ОбращениеНП
		ИЛИ КонтекстОтправки.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПредставлениеНП
		ИЛИ КонтекстОтправки.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ЗапросНП Тогда
		РезультатФормирования = СформироватьОписаниеСведенийДляСообщенияФНС(КонтекстОтправки); // сервер
	Иначе	
		Если НЕ КонтекстОтправки.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДокументНП Тогда
			РезультатФормирования = СформироватьИзвещениеОПолученииДляСообщенияФНС(КонтекстОтправки); // сервер
			
			Если Не РезультатФормирования Тогда
				СообщениеОбОшибке = ТекстСообщенийПользователю();
				Возврат;
			КонецЕсли;

		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция СертификатыДляПодписанияПоТипуСообщения(ТипСообщения, ОбъектСертификатРуководителя, ОбъектСертификатГлавногоБухгалтера, ОбъектСертификатОтветственногоЗаШифрование)

	// формируем массив объектов-сертификатов, которыми будем подписывать
	МассивОбъектовСертификатов = Новый Массив;
	Если ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ДекларацияНП
		ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ЗаявлениеНП
		ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.Форма2НДФЛНП
		ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ОбращениеНП
		ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПредставлениеНП
		ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ЗапросНП
		ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ЗапросНаВыпискуЕРГЮЛ_ЕГРИП Тогда
		МассивОбъектовСертификатов.Добавить(ОбъектСертификатРуководителя);
		Если ЗначениеЗаполнено(ОбъектСертификатГлавногоБухгалтера)
			И ОбъектСертификатГлавногоБухгалтера.Отпечаток <> ОбъектСертификатРуководителя.Отпечаток Тогда
			МассивОбъектовСертификатов.Добавить(ОбъектСертификатГлавногоБухгалтера);
		КонецЕсли;
	Иначе
		МассивОбъектовСертификатов.Добавить(ОбъектСертификатОтветственногоЗаШифрование);
	КонецЕсли;

	Возврат МассивОбъектовСертификатов;

КонецФункции

Процедура СформироватьПакетФНС_Подписание(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	// формируем массив объектов-сертификатов, которыми будем подписывать
	МассивОбъектовСертификатов = СертификатыДляПодписанияПоТипуСообщения(
		 КонтекстОтправки.ТипСообщения,
		 КонтекстОтправки.ОбъектСертификатРуководителя,
		 КонтекстОтправки.ОбъектСертификатГлавногоБухгалтера,
		 КонтекстОтправки.ОбъектСертификатОтветственногоЗаШифрование);
		 
	// генерируем подписи руководителя
	ПодписатьСообщение("ФНС",
		КонтекстОтправки,
		КонтекстОтправки.ТранспортноеСообщение,
		КонтекстОтправки.ТипТранспортногоСообщения, 
		МассивОбъектовСертификатов,
		КонтекстОтправки.УчетнаяЗапись,
		КонтекстОтправки.СообщениеОснование,
		СообщениеОбОшибке);
	
КонецПроцедуры

Процедура СформироватьПакетФНСПослеПодписания(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	// Формируем дерево описания документов пакета.
	Если НЕ СформироватьПакетФНС_СформироватьДеревоОписанияДокументовПакета(КонтекстОтправки) Тогда // универсальная
		СообщениеОбОшибке = ТекстСообщенийПользователю();
		Возврат;
	КонецЕсли;
	
	// Отрабатываем отложенные команды (шифрование).
	СформироватьПакет_ОтработатьОтложенныеКоманды(КонтекстОтправки, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьПакетФНСПослеВыполненияОтложенныхКоманд(КонтекстОтправки, СообщениеОбОшибке);
	
КонецПроцедуры

Функция СформироватьПакетФНС_СформироватьДеревоОписанияДокументовПакета(Контекст) Экспорт
	
	// определяем структуру с отложенными командами
	ОтложенныеКоманды = Новый СписокЗначений;
	СвойстваОтложенныхКоманд = Новый Соответствие;
	
	// создаем вспомогательное дерево описания документов пакета
	ДеревоДокументов = СоздатьДеревоОписанияДокументовПакета();
	
	// выгружаем все файлы сообщения во временный каталог
	КаталогФайловОтчетности = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	
	// выгружаем все содержимое во временное хранилище
	ТипыСодержимого = Новый Массив;
	ТипыШифруемогоСодержимого = Новый Массив;
	
	Если Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ДекларацияНП Тогда
		
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетности);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Форма2НДФЛ);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведений);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведений2НДФЛ);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление);
		
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетности);
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Форма2НДФЛ);
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение);
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление);
		
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.Форма2НДФЛНП Тогда
		
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Форма2НДФЛ);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведений2НДФЛ);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление);
		
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Форма2НДФЛ);
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление);
		
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеНП Тогда
		
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолучении);
		
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатПриемаНП Тогда
		
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолучении);
		
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатОбработкиНП Тогда
		
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолучении);
		
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ОбращениеНП Тогда
		
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Обращение);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведенийОбращениеПисьмоРассылка);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление);
		
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Обращение);
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение);
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление);
		
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПредставлениеНП Тогда
		
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Представление);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПредставление);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление);
		
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Представление);
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение);
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление);
		
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ЗапросНП Тогда
		
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Запрос);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведенийЗапрос);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление);
		
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Запрос);
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление);
		
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПисьмоНП Тогда
		
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолучении);
		
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеРассылкаНП Тогда
		
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолучении);
		
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ЗаявлениеНП Тогда
		
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Заявление);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведенийЗаявление);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление);
		
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Заявление);
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление);
		
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатОбработкиРФНП Тогда
		
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолучении);
		
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеОбОтзывеЗаявлениеРФНП Тогда
		
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолучении);
		
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатОбработкиТСНП Тогда
		
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолучении);
		
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеДокументНП Тогда
		
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолучении);
		
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДокументНП Тогда
		
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.КвитанцияОПриемеДокумент);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказеДокумент);
		
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.КвитанцияОПриемеДокумент);
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказеДокумент);
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ЗапросНаВыпискуЕРГЮЛ_ЕГРИП Тогда
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЗапросНаВыпискуИзЕГРЮЛ_ЕГРИП);
	КонецЕсли;
	
	Если НЕ Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ЗапросНаВыпискуЕРГЮЛ_ЕГРИП Тогда
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись);
	КонецЕсли;
	
	ВложенияДИВ = ПолучитьВложенияТранспортногоСообщения(Контекст.ТранспортноеСообщение, Истина, ТипыСодержимого);
	ВложенияДИВ.Колонки.Добавить("Адрес");
	Для Каждого ВложениеДИВ Из ВложенияДИВ Цикл
		Попытка
			ВложениеДИВ.Адрес = ПоместитьВоВременноеХранилище(ВложениеДИВ.Данные.Получить(), Контекст.УникальныйИдентификатор);
		Исключение
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловОтчетности);
			ТекстСообщения = НСтр("ru = 'Ошибка формирования пакета: не удалось сохранить документ во временный каталог для подписания.';
									|en = 'An error occurred while generating the package: cannot save the document to the temporary directory for signing.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецПопытки;
	КонецЦикла;
	
	// заполняем дерево описания сначала ДИВ
	Для Каждого ВложениеДИВ Из ВложенияДИВ Цикл
		
		Если ВложениеДИВ.Тип = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись Тогда
			Продолжить;
		КонецЕсли;
		
		// пакуем файл
		КороткоеИмяФайлаАрхива = ЗаархивироватьФайлПакета(ВложениеДИВ, "file", Контекст.УникальныйИдентификатор);
		Если КороткоеИмяФайлаАрхива = Неопределено Тогда
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловОтчетности);
			Возврат Ложь;
		КонецЕсли;
		
		Если ТипыШифруемогоСодержимого.Найти(ВложениеДИВ.Тип) <> Неопределено Тогда
			ОтложеннаяКоманда = ОтложенныеКоманды.Добавить(ВложениеДИВ.Адрес, "Зашифровать");
			СтрДокумент = ОпределитьДокументВДеревеОписания(ДеревоДокументов, ВложениеДИВ.Тип, ТипСодержимогоПоОписаниюДИВ(ВложениеДИВ), ВложениеДИВ.Идентификатор, Истина, Истина, ВложениеДИВ.ИмяФайла, КороткоеИмяФайлаАрхива, ВложениеДИВ.Адрес);
			
			ПрефиксИмениФайла = СокрЛП(ВложениеДИВ.ИмяФайла);
			ПрефиксИмениФайла = Лев(ПрефиксИмениФайла, 7);
			Если ВРег(ПрефиксИмениФайла) = "NO_NDS_" Тогда
				ИдентификаторОтложеннойКоманды = ОтложеннаяКоманда.ПолучитьИдентификатор();
				СвойстваОтложенныхКоманд[ИдентификаторОтложеннойКоманды] = Новый Структура("ДляСервераДокументооборота", Истина);
			КонецЕсли;
			
		Иначе
			СтрДокумент = ОпределитьДокументВДеревеОписания(ДеревоДокументов, ВложениеДИВ.Тип, "xml", ВложениеДИВ.Идентификатор, Истина, Ложь, ВложениеДИВ.ИмяФайла, КороткоеИмяФайлаАрхива, ВложениеДИВ.Адрес);
		КонецЕсли;
		
	КонецЦикла;
	
	// дополняем дерево описания информацией об ЭЦП
	Для Каждого ВложениеДИВ Из ВложенияДИВ Цикл
		Если ВложениеДИВ.Тип = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись Тогда
			ПодписанныйДокумент = ДеревоДокументов.Строки.Найти(ВложениеДИВ.ЭЦПИмяПодписанногоФайла, "ИмяФайлаДокумента");
			Если ПодписанныйДокумент <> Неопределено Тогда
				ОпределитьДокументВДеревеОписания(ПодписанныйДокумент, , , , , , ВложениеДИВ.ИмяФайла, , ВложениеДИВ.Адрес);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// 
	Контекст.Вставить("ОтложенныеКоманды", ОтложенныеКоманды);
	Контекст.Вставить("СвойстваОтложенныхКоманд", СвойстваОтложенныхКоманд);
	Контекст.Вставить("ДеревоДокументов", ПоместитьВоВременноеХранилище(ДеревоДокументов, Контекст.УникальныйИдентификатор));
	
	Возврат Истина;
	
КонецФункции

Процедура СформироватьПакетФНСПослеВыполненияОтложенныхКоманд(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть аналогичная процедура СформироватьПакетФНСПослеВыполненияОтложенныхКомандНаКлиенте(),
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	// Формируем файл описания пакета, создаем архив и помещаем в ИБ.
	Если НЕ СформироватьПакетФНС_ЗаключительныеДействияНаСервере(КонтекстОтправки) Тогда // универсальная
		СообщениеОбОшибке = ТекстСообщенийПользователю();
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьПакетФНС_ЗаключительныеДействияНаСервере(Контекст) Экспорт
	
	ДеревоДокументов = ПолучитьИзВременногоХранилища(Контекст.ДеревоДокументов);
	
	//////////////////////////////////////////////////////////////////////////////
	// ФОРМИРОВАНИЕ ФАЙЛА ОПИСАНИЯ ПАКЕТА
	
	// формируем
	ФайлОписаниеПакета = СформироватьОписаниеПакетаФНС(ДеревоДокументов,
														Контекст.UUIDПакета,
														Контекст.КодТипаДокументооборота,
														Контекст.НаименованиеТипаДокументооборота,
														Контекст.КодТипаТранзакции,
														Контекст.НаименованиеТипаТранзакции,
														Контекст.КодОтправителя,
														Контекст.КодСпецоператора,
														Контекст.КодПолучателя,
														Контекст.ТипПолучателя,
														Контекст.УникальныйИдентификатор);
	Если ФайлОписаниеПакета = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////////////////////
	// СОЗДАНИЕ АРХИВА ПАКЕТА
	
	КаталогФайловОтчетности = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	
	КороткоеИмяФайлаАрхива = "FNS_" +
							Контекст.КодОтправителя + "_" +
							Контекст.КодПолучателя + "_" +
							СгенерироватьUUID() + "_" + 
							Контекст.КодТипаДокументооборота + "_" +
							Контекст.КодТипаТранзакции + "_" +
							Контекст.КодТипаОсновногоДокумента +
							".zip";
	ПолноеИмяФайлаАрхива = ПолучитьКаталогВременныхФайлов() + КороткоеИмяФайлаАрхива;
	
	ЗаписьZIP = Новый ЗаписьZipФайла(ПолноеИмяФайлаАрхива, , , МетодСжатияZIP.Копирование); // архив пакета создается без сжатия
	Для Каждого СтрДокумент Из ДеревоДокументов.Строки Цикл
		
		ПолноеИмяФайлаПакета = ВыгрузитьФайлПакетаИзВременногоХранилищаВКаталог(КаталогФайловОтчетности, СтрДокумент);
		ЗаписьZIP.Добавить(ПолноеИмяФайлаПакета);
		
		Для Каждого СтрДокумент2 Из СтрДокумент.Строки Цикл
			ПолноеИмяФайлаПакета = ВыгрузитьФайлПакетаИзВременногоХранилищаВКаталог(КаталогФайловОтчетности, СтрДокумент2);
			ЗаписьZIP.Добавить(ПолноеИмяФайлаПакета);
		КонецЦикла;
		
	КонецЦикла;
	
	// добавляем описание пакета
	ПолноеИмяФайлаОписанияПакета = КаталогФайловОтчетности + "packageDescription.xml";
	ПолучитьИзВременногоХранилища(ФайлОписаниеПакета).Записать(ПолноеИмяФайлаОписанияПакета);
	ЗаписьZIP.Добавить(ПолноеИмяФайлаОписанияПакета);
	
	ЗаписьZIP.Записать();
	
	//////////////////////////////////////////////////////////////////////////////
	// ДОБАВЛЕНИЕ ПАКЕТА В РЕГИСТР КОНТЕЙНЕРОВ
	
	ДобавитьТранспортныйКонтейнер(Контекст.ТранспортноеСообщение, ПолноеИмяФайлаАрхива, КороткоеИмяФайлаАрхива);
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловОтчетности);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ПолноеИмяФайлаАрхива);
	
	Для каждого Строка Из ДеревоДокументов.Строки Цикл
		УдалитьИзВременногоХранилища(Строка.Адрес);
	КонецЦикла; 
	
	Возврат Истина;
	
КонецФункции

Функция СформироватьОписаниеПакетаФНС(ОписаниеДокументов, UUIDПакета = Неопределено, КодТипаДокументоооборота = "01", ТипДокументооборота = "Декларация", КодТипаТранзакции = "01", ТипТранзакции = "ДекларацияНП", КодОтправителя = "", КодСОС = Неопределено, КодПолучателя = "", ТипПолучателя = "налоговыйОрган", ИдентификаторДляВременногоХранилища = Неопределено) Экспорт
	
	Если UUIDПакета = Неопределено Тогда
		UUIDПакета = СгенерироватьUUID();
	КонецЕсли;
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	// добавляем узел "ТрансИнф"
	УзелТрансИнф = ДобавитьУзелXML(Дерево, "ТрансИнф");
	ДобавитьУзелXML(УзелТрансИнф, "версияФормата",							Истина, "ФНС:1.0");
	ДобавитьУзелXML(УзелТрансИнф, "кодТипаДокументооборота",				Истина, КодТипаДокументоооборота);
	ДобавитьУзелXML(УзелТрансИнф, "типДокументооборота",					Истина, ТипДокументооборота);
	ДобавитьУзелXML(УзелТрансИнф, "кодТипаТранзакции",						Истина, КодТипаТранзакции);
	ДобавитьУзелXML(УзелТрансИнф, "типТранзакции",							Истина, ТипТранзакции);
	ДобавитьУзелXML(УзелТрансИнф, "идентификаторДокументооборота", 			Истина, UUIDПакета);
	ДобавитьУзелXML(УзелТрансИнф, "ВерсПрог", 								Истина, СокрЛП(Лев(РегламентированнаяОтчетность.НазваниеИВерсияПрограммы(), 40)));
	
	// добавляем узел "отправитель"
	УзелОтправитель = ДобавитьУзелXML(УзелТрансИнф, "отправитель");
	ДобавитьУзелXML(УзелОтправитель, "идентификаторСубъекта",				Истина, КодОтправителя);
	ДобавитьУзелXML(УзелОтправитель, "типСубъекта",							Истина, "абонент");
	
	// добавляем узел "спецоператор"
	Если КодСОС <> Неопределено Тогда
		УзелСпецоператор = ДобавитьУзелXML(УзелТрансИнф, "спецоператор");
		ДобавитьУзелXML(УзелСпецоператор, "идентификаторСубъекта",			Истина, КодСОС);
		ДобавитьУзелXML(УзелСпецоператор, "типСубъекта",					Истина, "спецоператор");
	КонецЕсли;
	
	// добавляем узел "получатель"
	УзелПолучатель = ДобавитьУзелXML(УзелТрансИнф, "получатель");
	ДобавитьУзелXML(УзелПолучатель, "идентификаторСубъекта",				Истина, КодПолучателя);
	ДобавитьУзелXML(УзелПолучатель, "типСубъекта",							Истина, ТипПолучателя);
	
	// добавляем узлы "Документ"
	Для Каждого СтрДокумент Из ОписаниеДокументов.Строки Цикл
		
		// добавляем очередной узел "Документ"
		УзелДокумент = ДобавитьУзелXML(УзелТрансИнф, "документ");
		ДобавитьУзелXML(УзелДокумент, "кодТипаДокумента",				Истина, КодПоТипуДокументаПакета(СтрДокумент.ТипДокумента, КодТипаДокументоооборота));
		ДобавитьУзелXML(УзелДокумент, "типДокумента",					Истина, ИдентификаторПоТипуДокументаПакета(СтрДокумент.ТипДокумента));
		ДобавитьУзелXML(УзелДокумент, "типСодержимого",					Истина, СтрДокумент.ТипСодержимого);
		ДобавитьУзелXML(УзелДокумент, "сжат",							Истина, XMLСтрока(СтрДокумент.Сжат = Истина));
		ДобавитьУзелXML(УзелДокумент, "зашифрован",						Истина, XMLСтрока(СтрДокумент.Зашифрован = Истина));
		ДобавитьУзелXML(УзелДокумент, "идентификаторДокумента",			Истина, СтрДокумент.ИдентификаторДокумента);
		ДобавитьУзелXML(УзелДокумент, "исходноеИмяФайла",				Истина, СтрДокумент.ИмяФайлаДокумента);
		
		// добавляем узел "Содержимое"
		Если ЗначениеЗаполнено(СтрДокумент.ИмяФайлаАрхива) Тогда
			УзелСодержимое = ДобавитьУзелXML(УзелДокумент, "содержимое");
			ДобавитьУзелXML(УзелСодержимое, "имяФайла",					Истина, СтрДокумент.ИмяФайлаАрхива);
		КонецЕсли;
		
		// добавляем подписи под документом
		Для Каждого СтрПодпись Из СтрДокумент.Строки Цикл
			
			// добавляем очередной узел "Подпись"
			УзелПодпись = ДобавитьУзелXML(УзелДокумент, "подпись");
			ДобавитьУзелXML(УзелПодпись, "имяФайла",					Истина, СтрПодпись.ИмяФайлаДокумента);
			ДобавитьУзелXML(УзелПодпись, "роль",						Истина, "абонент");
			
		КонецЦикла;
		
	КонецЦикла;
	
	// формируем строку XML на основе дерева
	СтрокаXML = ВыгрузитьДеревоВXML_ПФР(Дерево);
	
	// записываем дерево в файл
	ПолноеИмяФайла = ПолучитьИмяВременногоФайла();
	РезультатЗаписи = ЗаписатьXMLВФайл(СтрокаXML, ПолноеИмяФайла);
	Если РезультатЗаписи = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// записываем двоичные данные файла во временное хранилище
	АдресВХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайла), ИдентификаторДляВременногоХранилища);
	
	Возврат АдресВХранилище;
	
КонецФункции

#КонецОбласти 

#Область СформироватьПакетПФР

Процедура СформироватьПакетПФР(ТранспортноеСообщение, УникальныйИдентификатор, СообщениеОбОшибке) Экспорт

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	 
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("ТранспортноеСообщение", ТранспортноеСообщение);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	КонтекстОтправки.Вставить("Оповещать", Ложь);
	
	// общие проверки
	Если НЕ СформироватьПакетПФР_ОбщиеПроверкиПередФормированием(КонтекстОтправки) Тогда
		СообщениеОбОшибке = ТекстСообщенийПользователю();
		Возврат;
	КонецЕсли;
		
	// получение и проверки сертификатов
	СформироватьПакетПФР_ПолучитьИПроверитьСертификатыПолучателя(КонтекстОтправки, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьПакетПФРПослеПроверкиИПолученияСертификатовПолучателя(КонтекстОтправки, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьПакетПФРПослеПроверкиСертификатов(КонтекстОтправки, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьПакетПФР_Подписание(КонтекстОтправки, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьПакетПФРПослеПодписания(КонтекстОтправки, СообщениеОбОшибке);
	
КонецПроцедуры

Функция СформироватьПакетПФР_ОбщиеПроверкиПередФормированием(Контекст) Экспорт
	
	Сообщение = Контекст.ТранспортноеСообщение;
	
	// проверка на то, что сообщение исходящее
	СтатусТранспортногоСообщения = Сообщение.Статус;
	Если СтатусТранспортногоСообщения <> Перечисления.СтатусыПисем.Сохраненное
	И СтатусТранспортногоСообщения <> Перечисления.СтатусыПисем.Исходящее
	И СтатусТранспортногоСообщения <> Перечисления.СтатусыПисем.Отправленное Тогда
		ТекстСообщения = НСтр("ru = 'Невозможно формирование пакета по входящему сообщению!';
								|en = 'Cannot generate a package from the incoming message.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	ПризнакОшибки = Ложь;
	
	ТипСообщения = Сообщение.Тип;
	
	СсылкаОтправитель = Сообщение.Отправитель;
	СсылкаПолучатель = ОпределитьПолучателяТранспортногоКонтейнера(Сообщение);
	УчетнаяЗапись = Сообщение.УчетнаяЗапись;
	ЦиклОбмена = Сообщение.ЦиклОбмена;
	СообщениеОснование = Сообщение.Основание;
	
	Если НЕ ЗначениеЗаполнено(ТипСообщения) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: тип транспортного сообщения не определен!';
								|en = 'An error occurred while encrypting the transport message: the transport message type is not determined.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СсылкаОтправитель) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: не задан отправитель!';
								|en = 'An error occurred while encrypting the transport message: sender is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СсылкаПолучатель) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: не задан получатель!';
								|en = 'An error occurred while encrypting the transport message: recipient is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: не задана учетная запись!';
								|en = 'An error occurred while encrypting the transport message: account is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	ИначеЕсли НЕ УчетнаяЗапись.ПредназначенаДляДокументооборотаСПФР Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: учетная запись не предназначена для электронного документооборота с ПФР!';
								|en = 'An error occurred while encrypting a transport message: account is not designed for electronic data interchange with PF.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЦиклОбмена) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: цикл обмена не задан!';
								|en = 'An error occurred while encrypting the transport message: exchange cycle is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	// определяем сертификат получателя
	СертификатПолучателя = ПолучитьСертификатСубъекта(СсылкаПолучатель);
	Если СертификатПолучателя.Количество() = 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'В свойствах органа ПФР %1 не задан ни один сертификат.';
				|en = 'No certificates are specified in the properties of PF authority %1.'"), СсылкаПолучатель);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// определяем сертификаты отправителя
	СертификатРуководителя = СокрЛП(УчетнаяЗапись.СертификатРуководителя);
	СертификатОтветственногоЗаШифрование = СокрЛП(УчетнаяЗапись.СертификатДляШифрования);
	
	// получаем и проверяем код отправителя
	ПараметрыОтправкиВПФР = СформироватьПараметрыОтправкиВПФР(Сообщение.Отправитель);
	КодОтправителя = СокрЛП(ПараметрыОтправкиВПФР.РегНомПФР);
	Если ПустаяСтрока(КодОтправителя) Тогда
		ТекстСообщения = НСтр("ru = 'Не задан регистрационный номер ПФР организации-отправителя.';
								|en = 'PF registration number of the sender company is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли НЕ РегистрационныйНомерПФРСоответствуетТребованиям(КодОтправителя) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректно задан регистрационный номер ПФР организации-отправителя.';
								|en = 'PF registration number of the sender company is specified incorrectly.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// получаем и проверяем код получателя
	КодПолучателя = СокрЛП(СсылкаПолучатель.Код);
	Если ПустаяСтрока(КодПолучателя) Тогда
		ТекстСообщения = НСтр("ru = 'Не задан код органа ПФР.';
								|en = 'PF authority code is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли НЕ КодОрганаПФРСоответствуетТребованиям(КодПолучателя) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректно задан код органа ПФР.';
								|en = 'PF authority code is specified incorrectly.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьПФР Тогда
		ТипДокументооборота = "СведенияПФР";
		ТипТранзакции = "сведения";
	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПротоколКвитанцияПФР Тогда
		ТипДокументооборота = "СведенияПФР";
		ТипТранзакции = "протоколКвитанция";
	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееПФР Тогда
		ТипДокументооборота = "Письмо";
		ТипТранзакции = "письмо";
	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееКвитанцияПФР Тогда
		ТипДокументооборота = "Письмо";
		ТипТранзакции = "письмоКвитанция";
	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееЗапросПФР Тогда
		ТипДокументооборота = "УточнениеПлатежей";
		ТипТранзакции = "запрос";
	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ОтветНаЗапросКвитанцияПФР Тогда
		ТипДокументооборота = "УточнениеПлатежей";
		ТипТранзакции = "ответКвитанция";
	КонецЕсли;
	
	КодСистемыОтправителя = УчетнаяЗапись.ИдентификаторСистемыОтправителяПФР;
	
	UUIDПакета = СокрЛП(ЦиклОбмена.Идентификатор);
	
	// запоминаем в контексте
	Контекст.Вставить("ТипСообщения", ТипСообщения);
	Контекст.Вставить("СсылкаОтправитель", СсылкаОтправитель);
	Контекст.Вставить("СсылкаПолучатель", СсылкаПолучатель);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена);
	Контекст.Вставить("СертификатРуководителя", СертификатРуководителя);
	Контекст.Вставить("СертификатОтветственногоЗаШифрование", СертификатОтветственногоЗаШифрование);
	Контекст.Вставить("СертификатПолучателя", СертификатПолучателя);
	
	Контекст.Вставить("ТипДокументооборота", ТипДокументооборота);
	Контекст.Вставить("ТипТранзакции", ТипТранзакции);
	Контекст.Вставить("КодОтправителя", КодОтправителя);
	Контекст.Вставить("КодПолучателя", КодПолучателя);
	Контекст.Вставить("КодСистемыОтправителя", КодСистемыОтправителя);
	Контекст.Вставить("UUIDПакета", UUIDПакета);
	
	Контекст.Вставить("СообщениеОснование", СообщениеОснование);
	
	Возврат НЕ ПризнакОшибки;
	
КонецФункции

Функция СформироватьПараметрыОтправкиВПФР(Организация) Экспорт
	
	СведенияОбОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Организация, , "РегНомПФР, КодОрганаПФР, РегНомПФРЗаСебя");
	ЭтоИП = НЕ РегламентированнаяОтчетностьВызовСервера.ЭтоЮридическоеЛицо(Организация);
	Если ЭтоИП Тогда
		
		ИПИспользуетТрудНаемныхРаботников = РегламентированнаяОтчетность.ИПИспользуетТрудНаемныхРаботников(Организация);
		Если НЕ ИПИспользуетТрудНаемныхРаботников Тогда
			СведенияОбОрганизации.Вставить("РегНомПФР", СведенияОбОрганизации.РегНомПФРЗаСебя); 
		КонецЕсли;
		
	КонецЕсли;
	
	СведенияОбОрганизации.Удалить("РегНомПФРЗаСебя");
	
	Возврат СведенияОбОрганизации;
	
КонецФункции

Функция РегистрационныйНомерПФРСоответствуетТребованиям(РегистрационныйНомерПФР)
	
	Возврат СтрокаСоответствуетШаблону(СокрЛП(РегистрационныйНомерПФР), "№№№-№№№-№№№№№№");
	
КонецФункции

Функция КодОрганаПФРСоответствуетТребованиям(КодОрганаПФР)
	
	Возврат СтрокаСоответствуетШаблону(СокрЛП(КодОрганаПФР), "№№№-№№№");
	
КонецФункции

Процедура СформироватьПакетПФР_ПолучитьИПроверитьСертификатыПолучателя(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
		
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(КонтекстОтправки.УчетнаяЗапись).ЭлектроннаяПодписьВМоделиСервиса;
	
	Если ТипЗнч(КонтекстОтправки.СертификатПолучателя) <> Тип("Массив") Тогда
		Отпечатки = Новый Массив;
		Отпечатки.Добавить(КонтекстОтправки.СертификатПолучателя);
	Иначе
		Отпечатки = КонтекстОтправки.СертификатПолучателя;
	КонецЕсли;
	
 	СертификатыДляПоиска = Новый Массив;
	Для Каждого Отпечаток Из Отпечатки Цикл
		СертификатыДляПоиска.Добавить(Новый Структура("ЭтоЭлектроннаяПодписьВМоделиСервиса, Отпечаток", ЭтоЭлектроннаяПодписьВМоделиСервиса, Отпечаток));	
	КонецЦикла;
	
	РезультатПоиска = НайтиСертификаты(СертификатыДляПоиска, Истина);
	
	СформироватьПакетПФР_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатов(КонтекстОтправки, СообщениеОбОшибке, РезультатПоиска)
	
КонецПроцедуры

Процедура СформироватьПакетПФР_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатов(КонтекстОтправки, СообщениеОбОшибке, РезультатПоиска)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	НайденныеСертификаты   = ?(РезультатПоиска.Свойство("Сертификаты"), РезультатПоиска.Сертификаты, Неопределено);
	НенайденныеСертификаты = ?(РезультатПоиска.Свойство("НенайденныеСертификаты"), РезультатПоиска.НенайденныеСертификаты, Неопределено);
	СсылкаПолучатель       = КонтекстОтправки.СсылкаПолучатель;
	
	Если НЕ СформироватьПакетПФР_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатовРазобратьНайденное(РезультатПоиска.Выполнено, НайденныеСертификаты, НенайденныеСертификаты, СсылкаПолучатель) Тогда
		СообщениеОбОшибке = ТекстСообщенийПользователю();
		Возврат;
	КонецЕсли;
	
	КонтекстОтправки.Вставить("ОбъектСертификатПолучателя", НайденныеСертификаты);
	
КонецПроцедуры

Функция СформироватьПакетПФР_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатовРазобратьНайденное(Выполнено, НайденныеСертификаты, НенайденныеСертификаты, СсылкаПолучатель) Экспорт

	Если Не Выполнено Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось определить цифровой сертификат получателя
                  |%1
                  |для шифрования сообщения!';
                  |en = 'Cannot determine a digital certificate of recipient 
                  |%1
                  |for encrypting the message.'"), СсылкаПолучатель);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Если НенайденныеСертификаты.Количество() > 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось определить цифровой сертификат получателя
                  |%1
                  |для шифрования сообщения!';
                  |en = 'Cannot determine a digital certificate of recipient 
                  |%1
                  |for encrypting the message.'"), СсылкаПолучатель);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(СсылкаПолучатель) = Тип("СправочникСсылка.ОрганыПФР") Тогда
	
		Для Каждого ОбъектСертификатОрганаПФР Из НайденныеСертификаты Цикл				
			РезультатПроверкиСертификатаОрганаПФР = ПроверитьСертификатПоПериоду(ОбъектСертификатОрганаПФР);
			Если РезультатПроверкиСертификатаОрганаПФР <> Истина Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Ошибка проверки сертификата органа ПФР %1 с отпечатком %2.';
						|en = 'An error occurred while checking a certificate of PF body %1 with thumbprint %2.'"),
					СсылкаПолучатель, 
					ОбъектСертификатОрганаПФР.Отпечаток);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Ложь;
			КонецЕсли;			
		КонецЦикла;
			
			// проверяем на наличие хотя бы одного сертификата
		Если НайденныеСертификаты.Количество() = 0 Тогда 
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В свойствах органа ПФР %1 не задан ни один сертификат.';
					|en = 'No certificates are specified in the properties of PF authority %1.'"), СсылкаПолучатель);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура СформироватьПакетПФРПослеПроверкиИПолученияСертификатовПолучателя(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	СформироватьПакетПФР_ПроверкиСертификатов(КонтекстОтправки, СообщениеОбОшибке);
	
КонецПроцедуры

Функция СформироватьПакетПФР_ПодготовитьСертификатыДляПоиска(УчетнаяЗапись, СертификатРуководителя, СертификатОтветственногоЗаШифрование) Экспорт

	ЭтоЭлектроннаяПодписьВМоделиСервиса = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(УчетнаяЗапись).ЭлектроннаяПодписьВМоделиСервиса;
	
	СертификатыДляПоиска = Новый Массив;
	
	ОтпечатокСертификатРуководителя = СокрЛП(СертификатРуководителя);
	ОтпечатокСертификатОтветственногоЗаШифрование = СокрЛП(СертификатОтветственногоЗаШифрование);
	
	Если Не ЗначениеЗаполнено(ОтпечатокСертификатРуководителя) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'В настройках учетной записи %1 не задан сертификат руководителя.';
				|en = 'Manager certificate is not specified in settings of account %1.'"), УчетнаяЗапись);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	Иначе
		СертификатыДляПоиска.Добавить(
			Новый Структура("Отпечаток,ЭтоЭлектроннаяПодписьВМоделиСервиса", 
				ОтпечатокСертификатРуководителя, ЭтоЭлектроннаяПодписьВМоделиСервиса));
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОтпечатокСертификатОтветственногоЗаШифрование) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'В настройках учетной записи %1 не задан сертификат ответственного за шифрование.';
				|en = 'Certificate of the person responsible for encryption is not specified in account %1 settings.'"), УчетнаяЗапись);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	ИначеЕсли ОтпечатокСертификатОтветственногоЗаШифрование <> ОтпечатокСертификатРуководителя Тогда
		СертификатыДляПоиска.Добавить(
			Новый Структура("Отпечаток,ЭтоЭлектроннаяПодписьВМоделиСервиса", 
				ОтпечатокСертификатОтветственногоЗаШифрование, ЭтоЭлектроннаяПодписьВМоделиСервиса));
	КонецЕсли;
	
	Возврат СертификатыДляПоиска;
	
КонецФункции

Процедура СформироватьПакетПФР_ПроверкиСертификатов(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если КонтекстОтправки.Свойство("ОбъектСертификатОтветственногоЗаШифрование") Тогда // Возможна ситуация, когда сертификаты уже получены и проверены.
		Возврат;
	КонецЕсли;
	
	СертификатыДляПоиска = СформироватьПакетПФР_ПодготовитьСертификатыДляПоиска(
		КонтекстОтправки.УчетнаяЗапись,
		КонтекстОтправки.СертификатРуководителя,
		КонтекстОтправки.СертификатОтветственногоЗаШифрование);
	
	Если СертификатыДляПоиска = Неопределено Тогда
		СообщениеОбОшибке = ТекстСообщенийПользователю();
		Возврат;
	КонецЕсли;
	
	РезультатПоиска = НайтиСертификаты(СертификатыДляПоиска, Истина);
	
	СформироватьПакетПФР_ПроверкиСертификатовПослеПолученияСертификатов(КонтекстОтправки, СообщениеОбОшибке, РезультатПоиска);
	
КонецПроцедуры

Процедура СформироватьПакетПФР_ПроверкиСертификатовПослеПолученияСертификатов(КонтекстОтправки, СообщениеОбОшибке, РезультатПоиска)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ОбъектыСертификатов = СформироватьПакетПФР_ПроверкиСертификатовПослеПолученияСертификатовРазобратьНайденное(
		РезультатПоиска.Сертификаты,
		КонтекстОтправки.СертификатРуководителя,
		КонтекстОтправки.СертификатОтветственногоЗаШифрование);
	
	Если ОбъектыСертификатов = Неопределено Тогда
		СообщениеОбОшибке = ТекстСообщенийПользователю();
		Если НЕ ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
			СообщениеОбОшибке = НСтр("ru = 'Не удалось найти сертификаты ответственных лиц в системном хранилище сертификатов.';
									|en = 'Cannot find certificates of responsible persons in the system certificate storage.'");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////////
	Для каждого ОбъектСертификат Из ОбъектыСертификатов Цикл
		КонтекстОтправки.Вставить(ОбъектСертификат.Ключ, ОбъектСертификат.Значение);
	КонецЦикла;
	
КонецПроцедуры

Функция СформироватьПакетПФР_ПроверкиСертификатовПослеПолученияСертификатовРазобратьНайденное(Сертификаты, СертификатРуководителя, СертификатОтветственногоЗаШифрование) Экспорт

	ОтпечатокСертификатРуководителя = СокрЛП(СертификатРуководителя);
	ОтпечатокСертификатОтветственногоЗаШифрование = СокрЛП(СертификатОтветственногоЗаШифрование);
	
	ОбъектСертификатРуководителя = Неопределено;
	ОбъектСертификатОтветственногоЗаШифрование = Неопределено;
	
	Для Каждого НайденныйСертификат Из Сертификаты Цикл
		Если ОтпечатокСертификатРуководителя = НайденныйСертификат.Отпечаток Тогда
			ОбъектСертификатРуководителя = НайденныйСертификат;
		КонецЕсли;
		Если ОтпечатокСертификатОтветственногоЗаШифрование = НайденныйСертификат.Отпечаток Тогда
			ОбъектСертификатОтветственногоЗаШифрование = НайденныйСертификат;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбъектСертификатРуководителя = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось найти сертификат руководителя в системном хранилище сертификатов.';
								|en = 'Cannot find a manager certificate in the system certificate storage.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ОбъектСертификатРуководителя.Свойство("Валиден") И Не ОбъектСертификатРуководителя.Валиден Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ОтпечатокСертификатОтветственногоЗаШифрование = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось найти сертификат ответственного за шифрование в системном хранилище сертификатов.';
								|en = 'Cannot find a certificate of the person responsible for encryption in the system certificate storage.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ОбъектСертификатОтветственногоЗаШифрование.Свойство("Валиден") И Не ОбъектСертификатОтветственногоЗаШифрование.Валиден Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	///////////////////////////////////////////////////////////////////////////////
	Результат = Новый Структура();
	Результат.Вставить("ОбъектСертификатРуководителя", ОбъектСертификатРуководителя);
	Результат.Вставить("ОбъектСертификатОтветственногоЗаШифрование", ОбъектСертификатОтветственногоЗаШифрование);
	
	Возврат Результат;
	
КонецФункции

Процедура СформироватьПакетПФРПослеПроверкиСертификатов(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
			
	// формируем файл описания сведений, если это первичное сообщение с отчетностью
	Если КонтекстОтправки.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьПФР
		ИЛИ КонтекстОтправки.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееЗапросПФР Тогда
		
		Если НЕ СформироватьОписаниеСведенийДляСообщения(КонтекстОтправки) Тогда
			СообщениеОбОшибке = НСтр("ru = 'Формирование пакета прервано.';
									|en = 'Package generation is canceled.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(СообщениеОбОшибке);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ЭтоМакетПД = ЭтоМакетПД(КонтекстОтправки.ЦиклОбмена);
	ЭтоЗаявление = ЭтоЗаявлениеОНазначенииПенсии(КонтекстОтправки.ЦиклОбмена);
	Если ЭтоМакетПД ИЛИ ЭтоЗаявление Тогда
		
		Настройки = ПолучитьПараметрыОтправкиМакетовПенсионныхДелИЗаявления(КонтекстОтправки.ЦиклОбмена);
			
		Если Настройки = Неопределено Тогда
			СообщениеОбОшибке = ТекстСообщенийПользователю();
			Возврат;
		КонецЕсли;
		
		КонтекстОтправки.Вставить("Настройки", Настройки);
	КонецЕсли;
	
	КонтекстОтправки.Вставить("КонтекстОтправки", КонтекстОтправки);
	КонтекстОтправки.Вставить("ПервыйВызов", Истина);
	КонтекстОтправки.Вставить("СформироватьПакетМакетаПДИЗаявление", ЭтоМакетПД ИЛИ ЭтоЗаявление);
	
КонецПроцедуры

Функция СформироватьОписаниеСведенийДляСообщения(Контекст) Экспорт

	Сообщение = Контекст.ТранспортноеСообщение;
	
	Если Сообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееЗапросПФР Тогда
		
		ТипыВложений = Новый Массив;
		ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЗапросИОС);
		ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОписанияЗапросаПФР);
		
		Вложения = ПолучитьВложенияТранспортногоСообщения(Сообщение, , ТипыВложений);
		
		Если Вложения.Найти(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОписанияЗапросаПФР, "Тип") <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		
		// генерируем файл
		КороткоеИмяФайла = Неопределено;
		ФайлОписаниеСведений = СформироватьОписаниеЗапроса(Сообщение, Вложения, КороткоеИмяФайла);
		Если ФайлОписаниеСведений = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// загружаем файл в содержимое
		ДобавитьСодержимоеТранспортногоКонтейнера(Сообщение, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОписанияЗапросаПФР, ФайлОписаниеСведений, КороткоеИмяФайла, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml);
		
	Иначе
		
		ТипыВложений = Новый Массив;
		ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиПФР);
		ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СведенияПриложениеПФР);
		ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОписанияСведенийПФР);
		Вложения = ПолучитьВложенияТранспортногоСообщения(Сообщение, , ТипыВложений);
		
		Если Вложения.Найти(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОписанияСведенийПФР, "Тип") <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		
		// генерируем файл
		КороткоеИмяФайла = Неопределено;
		ФайлОписаниеСведений = СформироватьОписаниеСведений(Сообщение, Вложения, КороткоеИмяФайла);
		Если ФайлОписаниеСведений = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// загружаем файл в содержимое
		ДобавитьСодержимоеТранспортногоКонтейнера(Сообщение, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОписанияСведенийПФР, ФайлОписаниеСведений, КороткоеИмяФайла, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml);
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция СформироватьОписаниеПисьмаДляСообщения(Контекст) Экспорт
	
	Сообщение = Контекст.ТранспортноеСообщение;
	
	// сначала получаем строки вложений без данных
	ТипыВложений = Новый Массив;
	ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Письмо);
	ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПисьмоПриложение);
	ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПисьма);
	Вложения = ПолучитьВложенияТранспортногоСообщения(Сообщение, , ТипыВложений);
	
	// проверяем, не сформировано ли ранее описание письма
	Если Вложения.Найти(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПисьма, "Тип") <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	// получаем строки вложений ЭЦП с данными
	ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись);
	ВложенияЭЦП = ПолучитьВложенияТранспортногоСообщения(Сообщение, Истина, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись);
	
	// добавляем строки описания ЭЦП к ранее полученным строкам описаний
	Вложения.Колонки.Добавить("Данные");
	Для Каждого СтрВложениеЭЦП Из ВложенияЭЦП Цикл
		НовСтр = Вложения.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, СтрВложениеЭЦП);
	КонецЦикла;
	
	// генерируем файл
	КороткоеИмяФайла = Неопределено;
	ФайлОписаниеПисьма = СформироватьОписаниеПисьма(Сообщение, Вложения, КороткоеИмяФайла, Контекст);
	Если ФайлОписаниеПисьма = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// загружаем файл в содержимое
	ДобавитьСодержимоеТранспортногоКонтейнера(Сообщение, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПисьма, ФайлОписаниеПисьма, КороткоеИмяФайла, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml);
	
	Возврат Истина;
	
КонецФункции

Функция СформироватьОписаниеПисьма(Сообщение, Вложения, КороткоеИмяФайла = Неопределено, КонтекстОтправки = Неопределено)
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	// добавляем узел "тема"
	Если (ТипЗнч(Сообщение.ЦиклОбмена.Предмет) = Тип("СправочникСсылка.МакетыПенсионныхДел")
		ИЛИ ТипЗнч(Сообщение.ЦиклОбмена.Предмет) = Тип("СправочникСсылка.ЗаявлениеОНазначенииПенсии"))
		И ЗначениеЗаполнено(КонтекстОтправки) И ЗначениеЗаполнено(КонтекстОтправки.Настройки.Тема.Маска) Тогда
		Тема = КонтекстОтправки.Настройки.Тема.Маска;
		Для Каждого КлючЗначение Из КонтекстОтправки.Настройки.ПараметрыЗаполнения Цикл
			Тема = СтрЗаменить(Тема, СтрШаблон("{%1}", КлючЗначение.Ключ), КлючЗначение.Значение);
		КонецЦикла;
		УзелТема = ДобавитьУзелXML(Дерево, "тема", , XMLСтрока(СокрЛП(Тема)));
	Иначе
		УзелТема = ДобавитьУзелXML(Дерево, "тема", , XMLСтрока(СокрЛП(Сообщение.ЦиклОбмена.Предмет.Наименование)));
	КонецЕсли;
	
	// добавляем узел "датаВремяОтправки"
	УзелДатаВремяОтправки = ДобавитьУзелXML(Дерево, "датаВремяОтправки", , XMLСтрока(ТекущаяДатаСеанса()));
	
	// добавляем узел "идентификаторПисьма"
	УзелИдентификаторПисьма = ДобавитьУзелXML(Дерево, "идентификаторПисьма", , XMLСтрока(Сообщение.ЦиклОбмена.Предмет.Идентификатор));
	
	// добавляем узел "ответНаПисьмо"
	ИдентификаторОснования = Сообщение.ЦиклОбмена.Предмет.ИдентификаторОснования;
	Если ЗначениеЗаполнено(ИдентификаторОснования) Тогда
		УзелОтветНаПисьмо = ДобавитьУзелXML(Дерево, "ответНаПисьмо", , XMLСтрока(ИдентификаторОснования));
	КонецЕсли;
	
	// добавляем узел "категорияПисьма"
	Если ТипЗнч(Сообщение.ЦиклОбмена.Предмет) = Тип("СправочникСсылка.ПерепискаСКонтролирующимиОрганами") Тогда
		Если Сообщение.ЦиклОбмена.Предмет.Ретроконверсия Тогда
			УзелКатегорияПисьма = ДобавитьУзелXML(Дерево, "категорияПисьма", , XMLСтрока("Ретроконверсия"));
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(Сообщение.ЦиклОбмена.Предмет) = Тип("СправочникСсылка.МакетыПенсионныхДел") Тогда
		УзелКатегорияПисьма = ДобавитьУзелXML(Дерево, "категорияПисьма", , "МакетЭВД");
	КонецЕсли;
	Если ТипЗнч(Сообщение.ЦиклОбмена.Предмет) = Тип("СправочникСсылка.ЗаявлениеОНазначенииПенсии") Тогда
		УзелКатегорияПисьма = ДобавитьУзелXML(Дерево, "категорияПисьма", , "Заявление");
	КонецЕсли;
	
	// добавляем узел "телоПисьма"
	УзелТелоПисьма = ДобавитьУзелXML(Дерево, "телоПисьма");
	
	// добавляем подузел "ИдентификаторДокумента"
	СтрПисьмо = Вложения.Найти(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Письмо, "Тип");
	Если СтрПисьмо = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка формирования описания письма: не удалось обнаружить документ с телом письма.';
								|en = 'An error occurred while generating email description: cannot detect the document with email body. '");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	УзелИдентификаторДокумента = ДобавитьУзелXML(УзелТелоПисьма, "идентификаторДокумента", , СтрПисьмо.Идентификатор);
	
	// ищем подпись под телом письма
	СвойстваПодписиПодТеломПисьма = ОпределитьСвойстваПодписиПодТеломПисьма(Вложения);
	Если СвойстваПодписиПодТеломПисьма = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка определения свойств подписи под телом письма при формировании описания письма из состава пакета.';
								|en = 'An error occurred while determining signature property under email body while generating email description from the package.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// добавляем подузел "подписи"
	УзелПодписи = ДобавитьУзелXML(УзелТелоПисьма, "подписи");
	
	// добавляем узел "подпись"
	ДанныеПодписиПодТеломПисьма = ПолучитьДанныеСтрокой64(СвойстваПодписиПодТеломПисьма.Данные.Получить());
	УзелПодпись = ДобавитьУзелXML(УзелПодписи, "подпись", , ДанныеПодписиПодТеломПисьма);
	
	// добавляем атрибут "роль"
	УзелАтрибутРоль = ДобавитьУзелXML(УзелПодпись, "роль", Истина, "руководитель");
	
	// добавляем узел "списокПриложений"
	УзелСписокПриложений = ДобавитьУзелXML(Дерево, "списокПриложений");
	
	// выгружаем описание приложений
	ПриложенияКПисьму = Вложения.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПисьмоПриложение));
	Для Каждого ПриложениеКПисьму Из ПриложенияКПисьму Цикл
		
		// добавляем узел "приложение"
		УзелПриложение = ДобавитьУзелXML(УзелСписокПриложений, "приложение");
		
		// добавляем узел "идентификаторДокумента"
		УзелИдентификаторДокумента = ДобавитьУзелXML(УзелПриложение, "идентификаторДокумента", , ПриложениеКПисьму.Идентификатор);
		
		// добавляем узел "имяФайла"
		УзелИмяФайла = ДобавитьУзелXML(УзелПриложение, "имяФайла", , ПриложениеКПисьму.ИмяФайла);
		
		// добавляем узел "подписи"
		УзелПодписи = ДобавитьУзелXML(УзелПриложение, "подписи");
		
		// добавляем узлы "подпись"
		ПодписиПодДокументом = Вложения.НайтиСтроки(Новый Структура("ЭЦПИмяПодписанногоФайла", ПриложениеКПисьму.ИмяФайла));
		Для Каждого ПодписьПодДокументом Из ПодписиПодДокументом Цикл
			
			// добавляем узел "подпись"
			УзелПодпись = ДобавитьУзелXML(УзелПодписи, "подпись", , ПолучитьДанныеСтрокой64(ПодписьПодДокументом.Данные));
			
			// добавляем узел "роль"
			ДобавитьУзелXML(УзелПодпись, "роль", Истина, "руководитель");
			
		КонецЦикла;
		
	КонецЦикла;
	
	// формируем строку XML на основе дерева
	СтрокаXML = ВыгрузитьДеревоВXML_ПФР(Дерево, "описаниеПисьма");
	
	// записываем строку в файл
	КороткоеИмяФайла = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	ПолноеИмяФайлаДокументаВСоставеПакета = ПолучитьКаталогВременныхФайлов() + КороткоеИмяФайла;
	РезультатЗаписи = ЗаписатьXMLВФайл(СтрокаXML, ПолноеИмяФайлаДокументаВСоставеПакета);
	Если РезультатЗаписи = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолноеИмяФайлаДокументаВСоставеПакета;
	
КонецФункции

Функция СформироватьОписаниеЗапроса(Сообщение, Вложения, КороткоеИмяФайла = Неопределено)
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	// добавляем узел "датаВремяОтправки"
	УзелДатаВремяОтправки = ДобавитьУзелXML(Дерево, "датаВремяОтправки", , XMLСтрока(ТекущаяДатаСеанса()));
	
	// добавляем узел "регистрационныйНомерОрганизации"
	ПараметрыОтправкиВПФР = СформироватьПараметрыОтправкиВПФР(Сообщение.Отправитель);
	КодОтправителя = СокрЛП(ПараметрыОтправкиВПФР.РегНомПФР);
	УзелРегистрационныйНомерОрганизации = ДобавитьУзелXML(Дерево, "регистрационныйНомерОрганизации", , КодОтправителя);
	
	// добавляем узел "имяФайла"
	Для Каждого Стр Из Вложения Цикл
		ДобавитьУзелXML(Дерево, "имяФайла", , СокрЛП(Стр.ИмяФайла));
	КонецЦикла;
	
	// формируем строку XML на основе дерева
	СтрокаXML = ВыгрузитьДеревоВXML_ПФР(Дерево, "описаниеЗапроса");
	
	// записываем строку в файл
	КороткоеИмяФайла = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	ПолноеИмяФайлаДокументаВСоставеПакета = ПолучитьКаталогВременныхФайлов() + КороткоеИмяФайла;
	РезультатЗаписи = ЗаписатьXMLВФайл(СтрокаXML, ПолноеИмяФайлаДокументаВСоставеПакета);
	Если РезультатЗаписи = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолноеИмяФайлаДокументаВСоставеПакета;
	
КонецФункции

Функция СформироватьОписаниеСведений(Сообщение, Вложения, КороткоеИмяФайла = Неопределено)
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	// добавляем узел "датаВремяОтправки"
	УзелДатаВремяОтправки = ДобавитьУзелXML(Дерево, "датаВремяОтправки", , XMLСтрока(ТекущаяДатаСеанса()));
	
	// добавляем узел "регистрационныйНомерОрганизации"
	ПараметрыОтправкиВПФР = СформироватьПараметрыОтправкиВПФР(Сообщение.Отправитель);
	КодОтправителя = СокрЛП(ПараметрыОтправкиВПФР.РегНомПФР);
	УзелРегистрационныйНомерОрганизации = ДобавитьУзелXML(Дерево, "регистрационныйНомерОрганизации", , КодОтправителя);
	
	// добавляем узел "описаниеПачек"
	УзелОписаниеПачек = ДобавитьУзелXML(Дерево, "описаниеПачек");
	
	// добавляем информацию о документах пакета
	Для Каждого ДокументПакета Из Вложения Цикл
	
		// добавляем узел "пачка"
		УзелПачка = ДобавитьУзелXML(УзелОписаниеПачек, "пачка");
		
		// добавляем узел "идентификаторДокумента"
		УзелИдентификаторДокумента = ДобавитьУзелXML(УзелПачка, "идентификаторДокумента", , ДокументПакета.Идентификатор);
		
		// добавляем узел "имяФайла"
		УзелИмяФайла = ДобавитьУзелXML(УзелПачка, "имяФайла", , ДокументПакета.ИмяФайла);
		
	КонецЦикла;
	
	// формируем строку XML на основе дерева
	СтрокаXML = ВыгрузитьДеревоВXML_ПФР(Дерево, "описаниеСведений");
	
	// записываем строку в файл
	КороткоеИмяФайла = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	ПолноеИмяФайлаДокументаВСоставеПакета = ПолучитьКаталогВременныхФайлов() + КороткоеИмяФайла;
	РезультатЗаписи = ЗаписатьXMLВФайл(СтрокаXML, ПолноеИмяФайлаДокументаВСоставеПакета);
	Если РезультатЗаписи = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолноеИмяФайлаДокументаВСоставеПакета;
	
КонецФункции

Процедура СформироватьПакетПФР_Подписание(КонтекстОтправки, СообщениеОбОшибке)
	
	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
		
	// генерируем подписи
	ПодписатьСообщение(
		"ПФР", 
		КонтекстОтправки,
		КонтекстОтправки.ТранспортноеСообщение, 
		КонтекстОтправки.ТипСообщения,
		,
		КонтекстОтправки.УчетнаяЗапись, 
		КонтекстОтправки.СообщениеОснование,
		СообщениеОбОшибке);
	
КонецПроцедуры

Процедура СформироватьПакетПФРПослеПодписания(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
		
	Если КонтекстОтправки.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееПФР
		И КонтекстОтправки.ПервыйВызов Тогда
		
		Если КонтекстОтправки.СформироватьПакетМакетаПДИЗаявление Тогда
			
			Если КонтекстОтправки.Настройки.Вложение.ТребуетсяАрхивирование 
				И НЕ СформироватьПакетМакетаПенсионногоДелаИЗаявления(КонтекстОтправки) Тогда
				СообщениеОбОшибке = ТекстСообщенийПользователю();
				Возврат;
			КонецЕсли;
			
			СформироватьПакетПФР_Подписание(КонтекстОтправки, СообщениеОбОшибке);
			Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
				Возврат;
			КонецЕсли;

			КонтекстОтправки.Вставить("СформироватьПакетМакетаПДИЗаявление", Ложь);
			
			СформироватьПакетПФРПослеПодписания(КонтекстОтправки, СообщениеОбОшибке);
			Возврат;
		КонецЕсли;
		
		// формируем файл описания письма, если его нет
		Если НЕ СформироватьОписаниеПисьмаДляСообщения(КонтекстОтправки) Тогда
			СообщениеОбОшибке = ТекстСообщенийПользователю();
			Возврат;
		КонецЕсли;
		
		КонтекстОтправки.Вставить("ПервыйВызов", Ложь);
		
		// формируем файл с транспортной информацией, если его нет
		СформироватьТранспортнуюИнформациюДляСообщения(КонтекстОтправки, СообщениеОбОшибке);
		Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
			Возврат;
		КонецЕсли;

		СформироватьТранспортнуюИнформациюДляСообщенияПослеВыполнения(КонтекстОтправки, СообщениеОбОшибке);
		
		Возврат;
	КонецЕсли;
	
	Если КонтекстОтправки.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееКвитанцияПФР
		И КонтекстОтправки.ПервыйВызов Тогда
		// формируем подтверждение получения
		Если НЕ СформироватьПодтверждениеПолученияДляСообщения(КонтекстОтправки) Тогда
			СообщениеОбОшибке = ТекстСообщенийПользователю();
			Возврат;
		КонецЕсли;
		
		СформироватьПакетПФР_Подписание(КонтекстОтправки, СообщениеОбОшибке);
		Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
			Возврат;
		КонецЕсли;
		
		КонтекстОтправки.Вставить("ПервыйВызов", Ложь);
		СформироватьПакетПФРПослеПодписания(КонтекстОтправки, СообщениеОбОшибке);
		Возврат;
	КонецЕсли;
	
	Если КонтекстОтправки.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ОтветНаЗапросКвитанцияПФР
		И КонтекстОтправки.ПервыйВызов Тогда
		// формируем подтверждение получения
		Если НЕ СформироватьПодтверждениеПолученияЗапросаПФРДляСообщения(КонтекстОтправки.ТранспортноеСообщение) Тогда
			СообщениеОбОшибке = ТекстСообщенийПользователю();
			Возврат;
		КонецЕсли;
		
		СформироватьПакетПФР_Подписание(КонтекстОтправки, СообщениеОбОшибке);
		Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
			Возврат;
		КонецЕсли;
		
		КонтекстОтправки.Вставить("ПервыйВызов", Ложь);
		СформироватьПакетПФРПослеПодписания(КонтекстОтправки, СообщениеОбОшибке);
		Возврат;
	КонецЕсли;

	Результат = КриптографияЭДКОКлиентСервер.ПодготовитьРезультат(
		Истина, "СтрокаBase64", 
		КриптографияЭДКОСлужебныйВызовСервера.ЭкспортироватьСертификатВBase64(КонтекстОтправки.ОбъектСертификатРуководителя));

	Если Результат.Выполнено Тогда
		ДвДанныеСертификата = Base64Значение(Результат.СтрокаBase64);
		КонтекстОтправки.Вставить("ДвДанныеСертификатаРуководителя", ДвДанныеСертификата);
	КонецЕсли;
	
	// Формируем дерево описания документов пакета (сервер).
	Если НЕ СформироватьПакетПФР_СформироватьОписаниеДокументовПакета(КонтекстОтправки) Тогда
		СообщениеОбОшибке = ТекстСообщенийПользователю();
		Возврат;
	КонецЕсли;
	
	// Отрабатываем отложенные команды (шифрование).
	СформироватьПакет_ОтработатьОтложенныеКоманды(КонтекстОтправки, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
		
	СформироватьПакетПФРПослеВыполненияОтложенныхКоманд(КонтекстОтправки, СообщениеОбОшибке);
	
КонецПроцедуры

Процедура СформироватьТранспортнуюИнформациюДляСообщения(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если ТипЗнч(КонтекстОтправки.ОбъектСертификатПолучателя) = Тип("Массив") Тогда
		СвойстваСертификатаПолучателя = КонтекстОтправки.ОбъектСертификатПолучателя[0];
	Иначе
		СвойстваСертификатаПолучателя = КонтекстОтправки.ОбъектСертификатПолучателя;
	КонецЕсли;
	Если ТипЗнч(СвойстваСертификатаПолучателя) = Тип("ФиксированнаяСтруктура") Тогда
		СвойстваСертификатаПолучателя = Новый Структура(СвойстваСертификатаПолучателя);
	КонецЕсли;
		
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(КонтекстОтправки.УчетнаяЗапись).ЭлектроннаяПодписьВМоделиСервиса;
	
	СвойстваСертификатаПолучателя.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	
	// Отправка на стороне сервера без взаимодействия с клиентским контекстом поддерживается
	// только для электронной подписи в моделе сервиса.
	Если НЕ ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		СообщениеОбОшибке = НСтр("ru = 'СформироватьТранспортнуюИнформациюДляСообщения(): на стороне сервера поддерживается работа только с электронной подписью в моделе сервиса';
								|en = 'СформироватьТранспортнуюИнформациюДляСообщения(): on the server side, only digital signature in SaaS is supported'");
		Возврат;
	КонецЕсли;
	
	СтрокаBase64 = КриптографияЭДКОСлужебныйВызовСервера.ЭкспортироватьСертификатВBase64(СвойстваСертификатаПолучателя);
	
	СформироватьТранспортнуюИнформациюИСохранитьВИБ(КонтекстОтправки.ТранспортноеСообщение, СтрокаBase64);
		
КонецПроцедуры

Функция СформироватьТранспортнуюИнформациюИСохранитьВИБ(Сообщение, СертификатBase64) Экспорт
	
	// генерируем файл
	КороткоеИмяФайла = Неопределено;
	ФайлТранспортнаяИнформация = СформироватьТранспортнуюИнформацию(Сообщение, СертификатBase64, КороткоеИмяФайла);
	Если ФайлТранспортнаяИнформация = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// загружаем файл в содержимое
	ДобавитьСодержимоеТранспортногоКонтейнера(Сообщение,
												Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ТранспортнаяИнформация,
												ФайлТранспортнаяИнформация,
												КороткоеИмяФайла,
												,
												,
												,
												,
												,
												,
												СгенерироватьUUID(),
												Перечисления.ТипыСодержимогоФайлов.xml);
	
	Возврат Истина;
	
КонецФункции

Функция СформироватьТранспортнуюИнформацию(Сообщение, СертификатBase64, КороткоеИмяФайла = Неопределено)
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	// добавляем узел "датаВремяОтправки"
	УзелДатаВремяОтправки = ДобавитьУзелXML(Дерево, "датаВремяОтправки", , XMLСтрока(ТекущаяДатаСеанса()));
	
	// добавляем узел "сертификатПолучателя"
	УзелСертификатПолучателя = ДобавитьУзелXML(Дерево, "сертификатПолучателя", , XMLСтрока(СертификатBase64));
	
	// формируем строку XML на основе дерева
	СтрокаXML = ВыгрузитьДеревоВXML_ПФР(Дерево, "транспортнаяИнформация");
	
	// записываем строку в файл
	КороткоеИмяФайла = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	ПолноеИмяФайлаДокументаВСоставеПакета = ПолучитьКаталогВременныхФайлов() + КороткоеИмяФайла;
	РезультатЗаписи = ЗаписатьXMLВФайл(СтрокаXML, ПолноеИмяФайлаДокументаВСоставеПакета);
	Если РезультатЗаписи = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолноеИмяФайлаДокументаВСоставеПакета;
	
КонецФункции

Процедура СформироватьТранспортнуюИнформациюДляСообщенияПослеВыполнения(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	СформироватьПакетПФР_Подписание(КонтекстОтправки, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьПакетПФРПослеПодписания(КонтекстОтправки, СообщениеОбОшибке);
	
КонецПроцедуры

Функция СформироватьПодтверждениеПолученияДляСообщения(Контекст) Экспорт
	
	ТранспортноеСообщение = Контекст.ТранспортноеСообщение;

	ТипыВложений = Новый Массив;
	ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеПолученияПисьма);
	ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись);
	Вложения = ПолучитьВложенияТранспортногоСообщения(ТранспортноеСообщение, Истина, ТипыВложений);
	
	// проверяем, не сформировано ли ранее подтверждение получения письма
	Если Вложения.Найти(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеПолученияПисьма, "Тип") <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	// генерируем файл
	КороткоеИмяФайла = Неопределено;
	ФайлОписаниеПисьма = СформироватьПодтверждениеПолучения(ТранспортноеСообщение, Вложения, КороткоеИмяФайла);
	Если ФайлОписаниеПисьма = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// загружаем файл в содержимое
	ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеПолученияПисьма, ФайлОписаниеПисьма, КороткоеИмяФайла, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml);
	
	Возврат Истина;
	
КонецФункции

Функция СформироватьПодтверждениеПолучения(Сообщение, Вложения, КороткоеИмяФайла = Неопределено)
	
	///////////////////////////////////////////////////////////////////////////////
	// ЗАГРУЗКА ОПИСАНИЯ ПИСЬМА ИЗ ВХОДЯЩЕГО СООБЩЕНИЯ
	
	// получаем описание письма из входящего сообщения
	ОписанияПисьма = ПолучитьВложенияТранспортногоСообщения(Сообщение.Основание, Истина, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПисьма);
	Если ОписанияПисьма.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать подтверждение получения письма: среди содержимого исходного письма не обнаружено обязательное описание.';
								|en = 'Cannot generate email receipt confirmation: no mandatory description in the source message.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	ОписаниеПисьма = ОписанияПисьма[0];
	
	// выгружаем данные во временный файл
	ВремФайлОписаниеПисьма = ПолучитьИмяВременногоФайла();
	ОписаниеПисьма.Данные.Получить().Записать(ВремФайлОписаниеПисьма);
	
	// загружаем в дерево
	ДеревоОписаниеПисьма = ЗагрузитьXMLВДеревоЗначений(ВремФайлОписаниеПисьма);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВремФайлОписаниеПисьма);
	
	///////////////////////////////////////////////////////////////////////////////
	// АНАЛИЗ ОПИСАНИЯ ПИСЬМА ИЗ ВХОДЯЩЕГО СООБЩЕНИЯ
	
	// находим узел "описаниеПисьма"
	УзелОписаниеПисьма = ДеревоОписаниеПисьма.Строки.Найти("описаниеПисьма", "Имя");
	Если УзелОписаниеПисьма = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать подтверждение получения письма: некорректное описание письма в исходном сообщении.';
								|en = 'Cannot generate email receipt confirmation: incorrect email description in the source message.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// находим узел "идентификаторПисьма"
	УзелИдентификаторПисьма = УзелОписаниеПисьма.Строки.Найти("идентификаторПисьма", "Имя");
	Если УзелИдентификаторПисьма = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать подтверждение получения письма: некорректное описание письма в исходном сообщении.';
								|en = 'Cannot generate email receipt confirmation: incorrect email description in the source message.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	ИдентификаторПисьма = УзелИдентификаторПисьма.Значение;
	
	///////////////////////////////////////////////////////////////////////////////
	// СОЗДАНИЕ И ЗАПОЛНЕНИЕ ДЕРЕВА
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	// добавляем узел "датаВремяПолучения"
	ДобавитьУзелXML(Дерево, "датаВремяПолучения", , XMLСтрока(ТекущаяДатаСеанса()));
	
	// добавляем узел "идентификаторПисьма"
	ДобавитьУзелXML(Дерево, "идентификаторПисьма", , XMLСтрока(ИдентификаторПисьма));
	
	// добавляем узел "телоПисьма"
	УзелТелоПисьма = ДобавитьУзелXML(Дерево, "телоПисьма");
	
	ИсходныйУзелТелоПисьма = УзелОписаниеПисьма.Строки.Найти("телоПисьма", "Имя");
	Если ИсходныйУзелТелоПисьма = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать подтверждение получения письма: некорректное описание письма в исходном сообщении.';
								|en = 'Cannot generate email receipt confirmation: incorrect email description in the source message.'");

		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
		
	ИсходныйУзелИдентификаторДокумента = ИсходныйУзелТелоПисьма.Строки.Найти("идентификаторДокумента", "Имя");
	Если ИсходныйУзелИдентификаторДокумента <> Неопределено Тогда
		ДобавитьУзелXML(УзелТелоПисьма, "идентификаторДокумента",, ИсходныйУзелИдентификаторДокумента.Значение);
	КонецЕсли;
	ИсходныйУзелПодписи = ИсходныйУзелТелоПисьма.Строки.Найти("подписи", "Имя");
	Если ИсходныйУзелПодписи <> Неопределено Тогда
		УзелТелоПисьмаПодписи = ДобавитьУзелXML(УзелТелоПисьма, "подписи");
		Для Каждого ИсходныйУзелПодпись Из ИсходныйУзелПодписи.Строки Цикл
			УзелТелоПисьмаПодпись = ДобавитьУзелXML(УзелТелоПисьмаПодписи, "подпись",, ИсходныйУзелПодпись.Значение);
			Для Каждого ИсходныйАтрибут Из ИсходныйУзелПодпись.Строки Цикл
				ДобавитьУзелXML(УзелТелоПисьмаПодпись, "роль", Истина, ИсходныйАтрибут.Значение);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	// списокПриложений
	ИсходныйУзелСписокПриложений = УзелОписаниеПисьма.Строки.Найти("списокПриложений", "Имя");
	Если ИсходныйУзелСписокПриложений <> Неопределено Тогда
		УзелСписокПриложений = ДобавитьУзелXML(Дерево, "списокПриложений");
		Для Каждого ИсходныйУзелПриложение Из ИсходныйУзелСписокПриложений.Строки Цикл
			УзелПриложение = ДобавитьУзелXML(УзелСписокПриложений, "приложение");
			ИсходныйУзелИдентификаторДокумента = ИсходныйУзелПриложение.Строки.Найти("идентификаторДокумента", "Имя");
			Если ИсходныйУзелИдентификаторДокумента <> Неопределено Тогда
				ДобавитьУзелXML(УзелПриложение, "идентификаторДокумента",, ИсходныйУзелИдентификаторДокумента.Значение);
			КонецЕсли;
			ИсходныйУзелИмяФайла = ИсходныйУзелПриложение.Строки.Найти("имяФайла", "Имя");
			Если ИсходныйУзелИмяФайла <> Неопределено Тогда
				ДобавитьУзелXML(УзелПриложение, "имяФайла",, ИсходныйУзелИмяФайла.Значение);
			КонецЕсли;

			ИсходныйУзелПодписи = ИсходныйУзелПриложение.Строки.Найти("подписи", "Имя");
			Если ИсходныйУзелПодписи <> Неопределено Тогда
				УзелПриложениеПодписи = ДобавитьУзелXML(УзелПриложение, "подписи");
				Для Каждого ИсходныйУзелПодпись Из ИсходныйУзелПодписи.Строки Цикл
					УзелПриложениеПодпись = ДобавитьУзелXML(УзелПриложениеПодписи, "подпись",, ИсходныйУзелПодпись.Значение);
					Для Каждого ИсходныйАтрибут Из ИсходныйУзелПодпись.Строки Цикл
						ДобавитьУзелXML(УзелПриложениеПодпись, "роль", Истина, ИсходныйАтрибут.Значение);
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// формируем строку XML на основе дерева
	СтрокаXML = ВыгрузитьДеревоВXML_ПФР(Дерево, "подтверждениеПолучения");
	
	// записываем строку в файл
	КороткоеИмяФайла = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	ПолноеИмяФайлаДокументаВСоставеПакета = ПолучитьКаталогВременныхФайлов() + КороткоеИмяФайла;
	РезультатЗаписи = ЗаписатьXMLВФайл(СтрокаXML, ПолноеИмяФайлаДокументаВСоставеПакета);
	Если РезультатЗаписи = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолноеИмяФайлаДокументаВСоставеПакета;
	
КонецФункции

Функция ОпределитьТипСодержимогоПриложенияКПисьму(СтрВложение) Экспорт
	
	Если ЗначениеЗаполнено(СтрВложение.ТипСодержимогоФайла) Тогда
		Результат = СтрВложение.ТипСодержимогоФайла;
	Иначе
		ТипСодержимого = ТипСодержимогоПоИмениФайла(СтрВложение.ИмяФайла, Истина);
		Если НЕ ЗначениеЗаполнено(ТипСодержимого) Тогда
			Результат = Перечисления.ТипыСодержимогоФайлов.Неизвестный;
		Иначе
			Результат = ТипСодержимого;
		КонецЕсли;
	КонецЕсли;
	
	Если Результат = Перечисления.ТипыСодержимогоФайлов.Неизвестный ИЛИ НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат "unknown";
	Иначе
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

Функция ПредставлениеТипаСодержимогоФайла(ТипСодержимого)
	
	Если ТипСодержимого = Перечисления.ТипыСодержимогоФайлов.Текст866 Тогда
		Возврат "plain866";
	ИначеЕсли ТипСодержимого = Перечисления.ТипыСодержимогоФайлов.Текст1251 Тогда
		Возврат "plain1251";
	ИначеЕсли ТипСодержимого = Перечисления.ТипыСодержимогоФайлов.xml Тогда
		Возврат "xml";
	ИначеЕсли ТипСодержимого = Перечисления.ТипыСодержимогоФайлов.html Тогда
		Возврат "html";
	Иначе
		Возврат "unknown";
	КонецЕсли;
	
КонецФункции

Функция ОпределитьСвойстваПодписиПодТеломПисьма(Вложения)
	
	// находим тело письма
	СтрПисьмо = Вложения.Найти(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Письмо, "Тип");
	Если СтрПисьмо = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// находим подпись под телом письма
	СтрПодписьПодПисьмом = Вложения.Найти(СтрПисьмо.ИмяФайла, "ЭЦПИмяПодписанногоФайла");
	Если СтрПодписьПодПисьмом = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// возвращаем идентификатор документа подписи под телом письма
	Возврат СтрПодписьПодПисьмом;
	
КонецФункции

Функция СформироватьПодтверждениеПолученияЗапросаПФРДляСообщения(Сообщение) Экспорт
	
	// проверяем, не сформировано ли ранее подтверждение
	Вложения = ПолучитьВложенияТранспортногоСообщения(Сообщение.Основание, , Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеПолученияЗапросПФР);
	Если Вложения.Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	// формируем комбинированную таблицу с вложениями
	Вложения = ПолучитьВложенияТранспортногоСообщения(Сообщение.Основание, , Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОтветНаЗапросПФР);
	Если Вложения.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не обнаружен документ с ответом на запрос от ПФР в исходном сообщении.';
								|en = 'Document with a response to request from PF is not found in the original message.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	ВложениеОтветНаЗапросПФР = Вложения[0];
	
	// генерируем файл
	КороткоеИмяФайла = Неопределено;
	ФайлПодтвержденияПолучения = СформироватьПодтверждениеПолученияЗапросаПФР(Сообщение, ВложениеОтветНаЗапросПФР.Идентификатор, КороткоеИмяФайла);
	Если ФайлПодтвержденияПолучения = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// загружаем файл в содержимое
	ДобавитьСодержимоеТранспортногоКонтейнера(Сообщение, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеПолученияЗапросПФР, ФайлПодтвержденияПолучения, КороткоеИмяФайла, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml);
	
	Возврат Истина;
	
КонецФункции

Функция СформироватьПодтверждениеПолученияЗапросаПФР(Сообщение, ИдентификаторФайлаОтветаНаЗапрос, КороткоеИмяФайла = Неопределено)
	
	///////////////////////////////////////////////////////////////////////////////
	// СОЗДАНИЕ И ЗАПОЛНЕНИЕ ДЕРЕВА
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	// добавляем узел "датаВремяПолучения"
	ДобавитьУзелXML(Дерево, "датаВремяПолучения", , XMLСтрока(ТекущаяДатаСеанса()));
	
	// добавляем узел "идентификаторПисьма"
	ДобавитьУзелXML(Дерево, "идентификаторДокумента", , XMLСтрока(ИдентификаторФайлаОтветаНаЗапрос));
	
	// формируем строку XML на основе дерева
	СтрокаXML = ВыгрузитьДеревоВXML_ПФР(Дерево, "подтверждениеПолучения");
	
	// записываем строку в файл
	КороткоеИмяФайла = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	ПолноеИмяФайлаДокументаВСоставеПакета = ПолучитьКаталогВременныхФайлов() + КороткоеИмяФайла;
	РезультатЗаписи = ЗаписатьXMLВФайл(СтрокаXML, ПолноеИмяФайлаДокументаВСоставеПакета);
	Если РезультатЗаписи = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолноеИмяФайлаДокументаВСоставеПакета;
	
КонецФункции

Функция СформироватьПакетПФР_СформироватьОписаниеДокументовПакета(Контекст) Экспорт
	
	//
	Сообщение = Контекст.ТранспортноеСообщение;
	
	// определяем структуру с отложенными командами
	ОтложенныеКоманды = Новый СписокЗначений;
	
	// создаем вспомогательное дерево описания документов пакета
	ДеревоДокументов = СоздатьДеревоОписанияДокументовПакета();
	
	// создаем временный каталог для выгрузки файлов
	КаталогФайловОтчетности = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();

	//
	Если Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьПФР Тогда
		
		ТипыСодержимого = Новый Массив;
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиПФР);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СведенияПриложениеПФР);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОписанияСведенийПФР);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись);
		ВложенияДИВ = ПолучитьВложенияТранспортногоСообщения(Сообщение, Истина, ТипыСодержимого);
		ВложенияДИВ.Колонки.Добавить("Адрес");
		Для Каждого ВложениеДИВ Из ВложенияДИВ Цикл
			Попытка
				ВложениеДИВ.Адрес = ПоместитьВоВременноеХранилище(ВложениеДИВ.Данные.Получить(), Контекст.УникальныйИдентификатор);
			Исключение
				ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловОтчетности);
				ТекстСообщения = НСтр("ru = 'Ошибка формирования пакета: не удалось сохранить документ во временный каталог для подписания.';
										|en = 'An error occurred while generating the package: cannot save the document to the temporary directory for signing.'");
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Ложь;
			КонецПопытки;
		КонецЦикла;
		
		// заполняем дерево описания сначала отчетами, приложениями и описанием сведений
		Для Каждого ВложениеДИВ Из ВложенияДИВ Цикл
			
			Если ВложениеДИВ.Тип <> Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиПФР
			И ВложениеДИВ.Тип <> Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОписанияСведенийПФР 
			И ВложениеДИВ.Тип <> Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СведенияПриложениеПФР Тогда
				Продолжить;
			КонецЕсли;
			
			// пакуем файл
			КороткоеИмяФайлаАрхива = ЗаархивироватьФайлПакета(ВложениеДИВ, "file", Контекст.УникальныйИдентификатор);
			Если КороткоеИмяФайлаАрхива = Неопределено Тогда
				ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловОтчетности);
				Возврат Ложь;
			КонецЕсли;
			
			// шифруем файл
			ОтложенныеКоманды.Добавить(ВложениеДИВ.Адрес, "Зашифровать");
			
