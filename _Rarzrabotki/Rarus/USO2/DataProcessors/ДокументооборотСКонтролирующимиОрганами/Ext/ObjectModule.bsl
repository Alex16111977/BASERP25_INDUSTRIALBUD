				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка при распаковке пакета: не определен файл подписи под документом %1 .';
																								|en = 'An error occurred while unpacking the package: file of signature under document %1 is not determined.'"), Символ(34) + ИмяФайлаДокумента + Символ(34));
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловПакета);
				Возврат Ложь;
			КонецЕсли;
			
			ИмяФайлаПодписи = СокрЛП(ИмяФайлаПодписи);
			НайденныеСтроки = ТаблицаРаспакованныхФайлов.НайтиСтроки(Новый Структура("Имя", ИмяФайлаПодписи));
			Если НайденныеСтроки.Количество() <> 0 Тогда 
				АдресФайлаПодписи = НайденныеСтроки[0].Адрес;
			КонецЕсли;
			
			// находим подписанный документ в архиве
			ИмяФайлаДокумента = Неопределено;
			ИдентификаторПодписанногоДокумента = Неопределено;
			Если АтрибутыУзлаДокумент.Свойство("идентификаторДокумента", ИдентификаторПодписанногоДокумента) Тогда
				ИмяФайлаДокумента = ДокументПоИдентификатору(ИдентификаторПодписанногоДокумента, КаталогФайловПакета);
				Если ИмяФайлаДокумента = Неопределено Тогда
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'При распаковке пакета не удалось проверить подпись %1
												|в архиве документооборота не удалось найти исходный подписанный документ с идентификатором %2.';
												|en = 'Cannot check signature %1 while unpacking the package
												|cannot find a signed source document with ID %2 in the data interchange archive.'"), 
												ИмяФайлаПодписи, ИдентификаторПодписанногоДокумента);
					Если Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДекларацияНО Тогда
						//Временное отключение интерактивной ошибки до исправления комплекса ФНС
						ЗаписьЖурналаРегистрации(
							НСтр("ru = 'Электронный документооборот с контролирующими органами.ОбработатьСодержимоеТранспортногоКонтейнера()';
								|en = 'Electronic data interchange with regulatory authorities.ОбработатьСодержимоеТранспортногоКонтейнера()'"), 
							УровеньЖурналаРегистрации.Предупреждение,, Объект.Ссылка, ТекстСообщения);
					Иначе
						ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
					КонецЕсли;
				Иначе // помещаем найденный файл во временное хранилище
					ГУИД = Новый УникальныйИдентификатор;
					Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(КаталогФайловПакета + ИмяФайлаДокумента), ГУИД);
					АдресФайлаДокумента = Адрес;
				КонецЕсли;
			КонецЕсли;
			
			// определяем строку в таблице документов пакета
			ОпределитьСтрокуВТаблицеДокументовПакета(ДокументыПакета,
														ИмяФайлаДокумента,
														Неопределено,
														ТипСодержимого,
														ИмяФайлаПодписи,
														АдресФайлаПодписи,
														Неопределено, //РезультатПроверкиПодписи,
														ИдентификаторДокумента,
														ТипСодержимогоПоСтроке(ТипСодержимогоФайла),
														Неопределено, //ОтпечатокСертификатаПодписи);
														ДокументЗашифрован,
														ДокументСжат);

		КонецЕсли;

	КонецЦикла;

	// удаляем временные файлы
	УдалитьФайлы(ВремФайл);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловПакета);

	Возврат Результат;

КонецФункции

Функция ОпределитьТипСодержимогоПоТипуДокументаПакета(ТипДокумента, ТипСообщения)
	
	// типы ПФР
	Если ТипДокумента = "подтверждениеПолучения" Тогда
		Если ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееКвитанцияПФР Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеПолученияПисьма;
		ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПолученияЗапросаПФР Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеПолученияЗапросПФР;
		Иначе
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеПолученияОтчетностиПФР;
		КонецЕсли;
	ИначеЕсли ТипДокумента = "ответПриложение" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОтветПриложениеНаЗапросПФР;
	ИначеЕсли ТипДокумента = "протокол" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПротоколПФР;
	ИначеЕсли ТипДокумента = "протоколПриложение" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПротоколПриложениеПФР;
	ИначеЕсли ТипДокумента = "пачкаИС" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиПФР;
	ИначеЕсли ТипДокумента = "пачкаАДВ" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиПФР;
	ИначеЕсли ТипДокумента = "пачкаДСВ" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиПФР;
	ИначеЕсли ТипДокумента = "реестрДСВ" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиПФР;
	ИначеЕсли ТипДокумента = "пачкаРСВ" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиПФР;
	ИначеЕсли ТипДокумента = "пачкаСВВ" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиПФР;
	ИначеЕсли ТипДокумента = "описаниеСведений" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОписанияСведенийПФР;
	ИначеЕсли ТипДокумента = "описаниеОшибки" Тогда
		Если ТипСообщения = Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеПФР Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеОшибкиПФР;
		ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеФСГС Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеОшибкиФСГС;
		КонецЕсли;
	ИначеЕсли ТипДокумента = "описаниеОшибочногоПакета" Тогда
		Если ТипСообщения = Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеПФР Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеОшибочногоПакетаПФР;
		ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеФСГС Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеОшибочногоПакетаФСГС;
		Иначе
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеОшибочногоПакетаФНС;
		КонецЕсли;
	ИначеЕсли ТипДокумента = "письмоПриложение" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПисьмоПриложение;
	ИначеЕсли ТипДокумента = "письмо" Тогда
		Если ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееФСГС
		 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееФСГС Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПисьмоФСГС;
		Иначе
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Письмо;
		КонецЕсли; 
	ИначеЕсли ТипДокумента = "транспортнаяИнформация" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ТранспортнаяИнформация;
	ИначеЕсли ТипДокумента = "описаниеПисьма" Тогда
		Если ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееФСГС
		 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееФСГС
		 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РассылкаФСГС Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПисьмаФСГС;
		Иначе
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПисьма;
		КонецЕсли;
	ИначеЕсли ТипДокумента = "описаниеРассылкиШаблонов" Тогда
		Если ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РассылкаШаблоновФСГС Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеРассылкиШаблоновФСГС;
		Иначе
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПисьма;
		КонецЕсли;
	ИначеЕсли ТипДокумента = "сведенияПриложение" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СведенияПриложениеПФР;
	// типы ФСГС
	ИначеЕсли (ТипДокумента = "извещениеОПолучении")
			И (ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПисьмоВходящееФСГС
		   ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПисьмоИсходящееФСГС
		   ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПротоколВходногоКонтроляОтчетностиФСГС
		   ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеОПолученииОтчетностиФСГС) Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолученииДокументаФСГС;
	ИначеЕсли СтрНайти(ТипДокумента, "уведомлениеОПриеме") > 0 Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОПриемеВОбработкуОтчетаФСГС;
	ИначеЕсли СтрНайти(ТипДокумента, "уведомлениеОНесоответствии") > 0 Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОНесоответствииФорматуОтчетаФСГС;
	ИначеЕсли (СтрНайти(ТипДокумента, "уведомлениеОбОтказе") > 0)
			И (ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПротоколВходногоКонтроляОтчетностиФСГС) Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказеОтчетаФСГС;
	ИначеЕсли (СтрНайти(ТипДокумента, "уведомлениеОбОтклонении") > 0) // + "уведомлениеОбОтклоненииОтчета"
			И (ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПротоколВходногоКонтроляОтчетностиФСГС) Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтклоненииОтчетаФСГС;
	ИначеЕсли (СтрНайти(ТипДокумента, "уведомлениеОбУточнении") > 0)
			И (ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПротоколВходногоКонтроляОтчетностиФСГС) Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбУточненииОтчетаФСГС;
	ИначеЕсли ТипДокумента = "отчет" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиФСГС;
	ИначеЕсли ТипДокумента = "описаниеОтчета" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеФайлаОтчетностиФСГС;
	ИначеЕсли ТипДокумента = "подтверждениеОператора" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеОператораФСГС;
	ИначеЕсли ТипДокумента = "приложениеПисьма" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПриложениеПисьмаФСГС;
	ИначеЕсли ТипДокумента = "рассылка" И ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РассылкаФСГС Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.РассылкаФСГС;
	ИначеЕсли ТипДокумента = "шаблон" И ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РассылкаШаблоновФСГС Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ШаблонФСГС;
	// типы ФНС 534
	ИначеЕсли ТипДокумента = "декларация" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетности;
	ИначеЕсли ТипДокумента = "описание" Тогда
		Если ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоНО
		ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РассылкаНО Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведенийОбращениеПисьмоРассылка;
		ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ДокументНО Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеДокумент;
		ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПредставлениеНП Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПредставление;	
		ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ЗаявлениеНП Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведенийЗаявление;
		ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗапросаНаВыпискуЕРГЮЛ_ЕГРИП Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.РезультатОбработкиЗапросаНаВыпискуЕГРЮЛ_ЕГРИП;
		Иначе
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведений;
		КонецЕсли;
	ИначеЕсли ТипДокумента = "доверенность" Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление;		
	ИначеЕсли ТипДокумента = "подтверждениеДатыОтправки" Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеДатыОтправкиПредставление;
	ИначеЕсли ТипДокумента = "уведомлениеОбОтказе" Тогда
		Если ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаЗаявлениеНО 
		ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДокументНП 
		ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаПредставлениеНО Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказеДокумент;
		Иначе
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказе;
		КонецЕсли;
	ИначеЕсли ТипДокумента = "квитанцияОПриеме" Тогда
		Если ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаЗаявлениеНО Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.КвитанцияОПриемеЗаявления;
		ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДокументНП 
		ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаПредставлениеНО Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.КвитанцияОПриемеДокумент;
		Иначе
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.КвитанцияОПриеме;
		КонецЕсли;
	ИначеЕсли ТипДокумента = "уведомлениеОбУточнении" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбУточнении;
	ИначеЕсли ТипДокумента = "извещениеОВводе" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОВводе;
	ИначеЕсли ТипДокумента = "извещениеОПолучении" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолучении;
	ИначеЕсли ТипДокумента = "сообщениеОбОшибке" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеОшибкиФНС;
	ИначеЕсли ТипДокумента = "обращение" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Обращение;
	ИначеЕсли ТипДокумента = "представление" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Представление;
	ИначеЕсли ТипДокумента = "приложение" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение;
	ИначеЕсли ТипДокумента = "подтверждениеДатыПолучения" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеДатыПолучения;
	ИначеЕсли ТипДокумента = "письмо" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Письмо;
	ИначеЕсли ТипДокумента = "рассылка" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Рассылка;
	ИначеЕсли ТипДокумента = "документ" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Документ;
	//заявление
	ИначеЕсли ТипДокумента = "заявление" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Заявление;
	ИначеЕсли ТипДокумента = "сообщениеОПроверке" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СообщениеОПроверке;
	ИначеЕсли ТипДокумента = "сообщениеОбОтзывеЗаявления" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СообщениеОбОтзывеЗаявления;
	ИначеЕсли ТипДокумента = "сообщениеОНесоответствиях" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СообщениеОНесоответствиях;
		
	ИначеЕсли ТипДокумента = "сообщениеОПростОтметки" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СообщениеОПростОтметки;
	ИначеЕсли ТипДокумента = "уведомлениеОбОтказеОтметки" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказеОтметки;
		
	ИначеЕсли ТипДокумента = "запрос" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Запрос;
	ИначеЕсли ТипДокумента = "ответ" Тогда
		Если ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ОтветНаЗапросПФР Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОтветНаЗапросПФР;
		ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗапросаНаВыпискуЕРГЮЛ_ЕГРИП Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОтветНаЗапросВыпискиИзЕГРЮЛ_ЕГРИП;
		Иначе
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Ответ;
		КонецЕсли;
		
	// 2-НДФЛ
	ИначеЕсли ТипДокумента = "форма2НДФЛ" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Форма2НДФЛ;
	ИначеЕсли ТипДокумента = "протоколПриема2НДФЛ" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Протокол2НДФЛ;
	ИначеЕсли ТипДокумента = "реестрПринятыхДокументов" Тогда
		Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Реестр2НДФЛ;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ОпределитьСтрокуВТаблицеДокументовПакета(ДокументыПакета, ИмяФайлаДокумента, АдресФайлаДокумента, ТипДокумента, ИмяФайлаПодписи = Неопределено, АдресФайлаПодписи = Неопределено, РезультатПроверкиПодписи = Неопределено, Идентификатор = Неопределено, ТипСодержимого = Неопределено, ОтпечатокСертификатаПодписи = Неопределено, ДокументЗашифрован = Неопределено, ДокументСжат = Неопределено)
	
	НовСтр = ДокументыПакета.Добавить();
	НовСтр.ИмяФайла = ИмяФайлаДокумента;
	НовСтр.АдресФайла = АдресФайлаДокумента;
	НовСтр.ТипДокумента = ТипДокумента;
	НовСтр.ИмяФайлаПодписи = ИмяФайлаПодписи;
	НовСтр.АдресФайлаПодписи = АдресФайлаПодписи;
	НовСтр.Идентификатор = Идентификатор;
	НовСтр.ТипСодержимого = ТипСодержимого;
	НовСтр.ОтпечатокСертификатаПодписи = ОтпечатокСертификатаПодписи;
	НовСтр.ДокументЗашифрован = ДокументЗашифрован;
	НовСтр.ДокументСжат = ДокументСжат;
	// Для определения алгоритма можно использовать вызов:
	// ?(ДокументЗашифрован, КриптографияЭДКО.АлгоритмКриптосообщенияИлиСертификата(АдресФайлаДокумента), "")
	НовСтр.АлгоритмФайла = Неопределено;
	// Для определения алгоритма можно использовать вызов: КриптографияЭДКО.АлгоритмКриптосообщенияИлиСертификата(АдресФайлаПодписи)
	НовСтр.АлгоритмФайлаПодписи = Неопределено;
	
КонецПроцедуры

Функция ДокументПоИдентификатору(ИдентификаторПодписанногоДокумента, КаталогВыгрузки)
	
	Запрос =Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
						 |	СодержимоеТранспортныхКонтейнеров.ИмяФайла,
						 |	СодержимоеТранспортныхКонтейнеров.Данные,
						 |	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение
						 |	, ВЫБОР
						 |		КОГДА СостояниеОбъектов.Архивный ЕСТЬ NULL ТОГДА Ложь
						 |		КОГДА СостояниеОбъектов.Архивный = Ложь ТОГДА Ложь
						 |	ИНАЧЕ
						 |		Истина
						 |	КОНЕЦ ВАрхиве
						 |ИЗ
						 |	РегистрСведений.СодержимоеТранспортныхКонтейнеров КАК СодержимоеТранспортныхКонтейнеров
						 |
						 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
						 |			ПО 		(СостояниеОбъектов.Объект = СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение)
						 |				И	(СостояниеОбъектов.ИмяФайла = СодержимоеТранспортныхКонтейнеров.ИмяФайла)
						 |				И	(СостояниеОбъектов.Владелец = Значение(Перечисление.ВидыАрхивируемыхМетаданныхДО.СодержимоеТранспортныхКонтейнеров))
						 |
						 |ГДЕ
						 |	СодержимоеТранспортныхКонтейнеров.Идентификатор = &Идентификатор");
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторПодписанногоДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Если Выборка.ВАрхиве Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Попытка
			ДвоичныеДанныеФайла = Выборка.Данные.Получить();
			Если ДвоичныеДанныеФайла = Неопределено Тогда
				МассивФайлов = ОбщегоНазначенияЭДКО.ПрикрепленныеФайлыКОбъектуИзСправочника(
					Выборка.ТранспортноеСообщение,
					"ТранспортноеСообщениеПрисоединенныеФайлы",
					Выборка.ИмяФайла);
				Если МассивФайлов.Количество() > 0 Тогда
					ДвоичныеДанныеФайла = РаботаСФайлами.ДвоичныеДанныеФайла(МассивФайлов[0]);
				Иначе
					Возврат Неопределено;
				КонецЕсли;
			КонецЕсли;
			
			ДвоичныеДанныеФайла.Записать(КаталогВыгрузки + Выборка.ИмяФайла);
			Возврат Выборка.ИмяФайла;
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция РазархивироватьФайлИзВременногоХранилища(АдресВоВременномХранилище, ВыводитьОшибку = Истина) Экспорт
	
	// получаем двоичные данные
	ИмяФайлаАрхиваДокумента = ПолучитьИмяВременногоФайла();
	ДвФайлАрхива = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	ДвФайлАрхива.Записать(ИмяФайлаАрхиваДокумента);
	// Распаковываем
	ПолноеИмяФайлаДокумента = РазархивироватьФайл(ИмяФайлаАрхиваДокумента);
	
	Если ПолноеИмяФайлаДокумента <> Неопределено Тогда 
		ГУИД = Новый УникальныйИдентификатор;
		Попытка
			Возврат ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайлаДокумента), ГУИД);
		Исключение
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Чтение ZIP';
					|en = 'Electronic data interchange with regulatory authorities. Reading ZIP'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат Неопределено;			
		КонецПопытки;
	Иначе
		Если ВыводитьОшибку Тогда
			ТекстСообщения = НСтр("ru = 'Ошибка распаковки файла документа из состава пакета.';
									|en = 'An error occurred while unpacking the document file from the package.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		КонецЕсли;
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаАрхиваДокумента);
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция РазархивироватьФайл(ИмяФайлаАрхива, ИмяРаспакованногоФайла = Неопределено) Экспорт
	
	Попытка
		ОбъектЧтение = Новый ЧтениеZipФайла(ИмяФайлаАрхива);
		Если ОбъектЧтение.Элементы.Количество() = 0 Тогда
			ОбъектЧтение.Закрыть();
			Возврат Неопределено;
		КонецЕсли;
		
		КаталогРаспаковки = ПолучитьИмяВременногоФайла();
		КаталогРаспаковки = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогРаспаковки);
		
		СоздатьКаталог(КаталогРаспаковки);
		ИмяФайлаИзАрхива = ОбъектЧтение.Элементы[0].Имя;
		
		Если Не ЗначениеЗаполнено(ИмяФайлаИзАрхива) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ОбъектЧтение.Извлечь(ОбъектЧтение.Элементы[0], КаталогРаспаковки, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
		ОбъектЧтение.Закрыть();
		
		Если ИмяРаспакованногоФайла = Неопределено Тогда
			Возврат КаталогРаспаковки + ИмяФайлаИзАрхива;
		Иначе
			ПереместитьФайл(КаталогРаспаковки + ИмяФайлаИзАрхива, ИмяРаспакованногоФайла);
			Возврат ИмяРаспакованногоФайла;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами';
				|en = 'Electronic data interchange with regulatory authorities'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

#Область ОтправкаРегламентированногоОтчетаВФНС

Функция ОтправкаРегламентированногоОтчетаВФНС_ПередВыгрузкойФайла(Контекст, Док, УникальныйИдентификатор, ТекстСообщения) Экспорт

	Контекст = Новый Структура();
	Контекст.Вставить("Документ", Док);
	Контекст.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	
	Если НЕ ЗначениеЗаполнено(Док) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбран документ для отправки.';
								|en = 'Document for sending is not selected.'");
		Возврат Ложь;
	КонецЕсли;
	
	// проверяем, включен ли обмен по организации
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Док, "Организация");
	Если Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);

		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, предназначена ли эта учетная запись для документооборота с ФНС
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ПредназначенаДляДокументооборотаСФНС") <> Истина Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("НаправлениеНеПодключено", Истина);
		Возврат Ложь;
		
	КонецЕсли;
	
	ТипЗнчДок = ТипЗнч(Док);
	МетаданныеОтчета = Метаданные.НайтиПоТипу(ТипЗнчДок);
	Если МетаданныеОтчета = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Неизвестный тип отчета.';
								|en = 'Unknown report type.'");
		Возврат Ложь;
	КонецЕсли;
	
	// ВидОтправляемогоДокументаТипДокумента заполняется и анализиризуется лишь для внешних электронных представлений
	ВидОтправляемогоДокументаТипДокумента = Неопределено;
	
	ИмяМетаданныхОтчета = МетаданныеОтчета.Имя;
	Если ИмяМетаданныхОтчета = "РегламентированныйОтчет" Тогда
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Док, "КодНалоговогоОргана, ДатаНачала, ДатаОкончания, ИсточникОтчета");
		ДатаНачалаПериодаОтчета = ЗначенияРеквизитов.ДатаНачала;
		ДатаОкончанияПериодаОтчета = ЗначенияРеквизитов.ДатаОкончания;
		КодНалоговогоОргана = СокрЛП(ЗначенияРеквизитов.КодНалоговогоОргана);
		ВидОтправляемогоОтчета = ЗначенияРеквизитов.ИсточникОтчета;
		
		НеобходимоНараститьСчетчикФайлов = Ложь;
		
	ИначеЕсли ИмяМетаданныхОтчета = "УведомлениеОПолучателеДокументов" Тогда
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Док, "Получатель");
		ТекДата = ТекущаяДатаСеанса();
		ДатаНачалаПериодаОтчета = НачалоДня(ТекДата);
		ДатаОкончанияПериодаОтчета = ДатаНачалаПериодаОтчета;
		КодНалоговогоОргана = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗначенияРеквизитов.Получатель, "Код").Код;
		ВидОтправляемогоОтчета = "УведомлениеОПолучателеДокументов";
		
		НеобходимоНараститьСчетчикФайлов = Ложь;
		
	ИначеЕсли ИмяМетаданныхОтчета = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных("СправкиНДФЛДляПередачиВНалоговыйОрган") Тогда
		
		ДатыПериодаОтчета = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьДатыПериодаДокумента(Док);
		ДатаНачалаПериодаОтчета = ДатыПериодаОтчета.ДатаНачала;
		ДатаОкончанияПериодаОтчета = ДатыПериодаОтчета.ДатаОкончания;
		
		Если Метаданные.Документы[ИмяМетаданныхОтчета].Реквизиты.Найти("КодИФНС") <> Неопределено
		И ЗначениеЗаполнено(Док.КодИФНС) Тогда
			КодНалоговогоОргана = СокрЛП(Док.КодИФНС);
		Иначе
			КодНалоговогоОргана = СокрЛП(РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Организация, , "КодНО").КодНО);
		КонецЕсли;
		
		ВидОтправляемогоОтчета = "СправкиНДФЛДляПередачиВНалоговыйОрган";
		
		НеобходимоНараститьСчетчикФайлов = Ложь;
		
	ИначеЕсли ИмяМетаданныхОтчета = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных("ЗаявлениеОПодтвержденииПраваНаЗачетАвансовПоНДФЛ") Тогда
		
		ДатыПериодаОтчета = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьДатыПериодаДокумента(Док);
		ДатаНачалаПериодаОтчета = ДатыПериодаОтчета.ДатаНачала;
		ДатаОкончанияПериодаОтчета = ДатыПериодаОтчета.ДатаОкончания;
		
		Если Метаданные.Документы[ИмяМетаданныхОтчета].Реквизиты.Найти("КодИФНС") <> Неопределено
		И ЗначениеЗаполнено(Док.КодИФНС) Тогда
			КодНалоговогоОргана = СокрЛП(Док.КодИФНС);
		Иначе
			КодНалоговогоОргана = СокрЛП(РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Организация, , "КодНО").КодНО);
		КонецЕсли;
		
		ВидОтправляемогоОтчета = "ЗаявлениеОПодтвержденииПраваНаЗачетАвансовПоНДФЛ";
		
		НеобходимоНараститьСчетчикФайлов = Ложь;
		
	ИначеЕсли ИмяМетаданныхОтчета = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных("ЗаявлениеОВвозеТоваров") Тогда
		
		ДатыПериодаОтчета = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьДатыПериодаДокумента(Док);
		ДатаНачалаПериодаОтчета = ДатыПериодаОтчета.ДатаНачала;
		ДатаОкончанияПериодаОтчета = ДатыПериодаОтчета.ДатаОкончания;
		
		КодНалоговогоОргана = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьКодИФНСПолучателяПоСсылке(Док);
		
		ВидОтправляемогоОтчета = "ЗаявлениеОВвозеТоваров";
		
		НеобходимоНараститьСчетчикФайлов = Ложь;
		
	ИначеЕсли ИмяМетаданныхОтчета = "ЭлектронныеПредставленияРегламентированныхОтчетов" Тогда // внешнее электронное представление
		
		ДатаНачалаПериодаОтчета = Док.ДатаНачала;
		ДатаОкончанияПериодаОтчета = Док.ДатаОкончания;
		КодНалоговогоОргана = СокрЛП(Док.Получатель.Код);
		ВидОтправляемогоОтчета = Док.ВидОтчета.Источник;
		
		ВидОтправляемогоДокументаТипДокумента = Док.ВидОтчета.ТипДокумента;
		НеобходимоНараститьСчетчикФайлов = Истина;
		
	ИначеЕсли ИмяМетаданныхОтчета = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных("БухгалтерскийОтчетГосударственногоУчреждения") Тогда
		
		ДатыПериодаОтчета = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьДатыПериодаДокумента(Док);
		ДатаНачалаПериодаОтчета = ДатыПериодаОтчета.ДатаНачала;
		ДатаОкончанияПериодаОтчета = ДатыПериодаОтчета.ДатаОкончания;
		
		КодНалоговогоОргана = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьКодИФНСПолучателяПоСсылке(Док);
		ВидОтправляемогоОтчета = "";
		
		НеобходимоНараститьСчетчикФайлов = Ложь;
		
	Иначе
		
		ТекстСообщения = НСтр("ru = 'Неизвестный тип отчета.';
								|en = 'Unknown report type.'");
		Возврат Ложь;
		
	КонецЕсли;
	
	// инициализируем переменные, зависящие от типа отчета
	Если ВидОтправляемогоОтчета = "СправкиНДФЛДляПередачиВНалоговыйОрган" Тогда
		ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.Форма2НДФЛ;
		ТипТранспортногоСообщения = Перечисления.ТипыТранспортныхСообщений.Форма2НДФЛНП;
		ТипСодержимогоКонтейнера = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Форма2НДФЛ;
	ИначеЕсли ВидОтправляемогоОтчета = "РегламентированныйОтчетЗаявлениеОВвозеТоваров"
	ИЛИ ВидОтправляемогоОтчета = "ЗаявлениеОВвозеТоваров" Тогда
		ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.Заявление;
		ТипТранспортногоСообщения = Перечисления.ТипыТранспортныхСообщений.ЗаявлениеНП;
		ТипСодержимогоКонтейнера = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Заявление;
	ИначеЕсли ВидОтправляемогоОтчета = "РегламентированныйОтчетРозничныеЦеныНаТабак"
	ИЛИ ВидОтправляемогоОтчета = "РегламентированныйОтчетПереченьЗаявленийОВвозеТоваров"
	ИЛИ ВидОтправляемогоОтчета = "РегламентированныйОтчетСтрановойОтчет"
	ИЛИ ВидОтправляемогоОтчета = "РегламентированныйОтчетУчастиеВМеждународнойГруппеКомпаний"
	ИЛИ ВидОтправляемогоОтчета = "РегламентированныйОтчетРеестрНДСДокументыДляКомпенсацииНалога"
	ИЛИ ВидОтправляемогоОтчета = "УведомлениеОПолучателеДокументов"
	ИЛИ ВидОтправляемогоОтчета = "ЗаявлениеОПодтвержденииПраваНаЗачетАвансовПоНДФЛ"
	ИЛИ ВидОтправляемогоДокументаТипДокумента = Перечисления.ТипыОтправляемыхДокументов.УведомлениеОКонтролируемыхСделках
	ИЛИ ВидОтправляемогоДокументаТипДокумента = Перечисления.ТипыОтправляемыхДокументов.ИсходящееУведомлениеФНС
	ИЛИ ВидОтправляемогоДокументаТипДокумента = Перечисления.ТипыОтправляемыхДокументов.УведомлениеОРозничныхЦенахНаТабак Тогда
		ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.Представление;
		ТипТранспортногоСообщения = Перечисления.ТипыТранспортныхСообщений.ПредставлениеНП;
		ТипСодержимогоКонтейнера = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Представление;
	Иначе
		ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.НалоговаяИлиБухгалтерскаяОтчетность;
		ТипТранспортногоСообщения = Перечисления.ТипыТранспортныхСообщений.ДекларацияНП;
		ТипСодержимогоКонтейнера = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетности;
	КонецЕсли;
	
	// сертификаты подписи абонента
	СертификатРуководителя = УчетнаяЗапись.СертификатРуководителя;
	СертификатГлавногоБухгалтера = УчетнаяЗапись.СертификатГлавногоБухгалтера;
	СертификатДляШифрования = УчетнаяЗапись.СертификатДляШифрования;
	
	Контекст.Вставить("Организация",                          Организация);
	Контекст.Вставить("ДатаНачалаПериодаОтчета",              ДатаНачалаПериодаОтчета);
	Контекст.Вставить("ДатаОкончанияПериодаОтчета",           ДатаОкончанияПериодаОтчета);
	Контекст.Вставить("КодНалоговогоОргана",                  КодНалоговогоОргана);
	Контекст.Вставить("ВидОтправляемогоОтчета",               ВидОтправляемогоОтчета);
	Контекст.Вставить("ТипОтправляемогоДокумента",            ИмяМетаданныхОтчета);
	Контекст.Вставить("ТипЦиклаОбмена",                       ТипЦиклаОбмена);
	Контекст.Вставить("ТипТранспортногоСообщения",            ТипТранспортногоСообщения);
	Контекст.Вставить("ТипСодержимогоКонтейнера",             ТипСодержимогоКонтейнера);
	Контекст.Вставить("НеобходимоНараститьСчетчикФайлов",     НеобходимоНараститьСчетчикФайлов);
	Контекст.Вставить("УчетнаяЗапись",                        УчетнаяЗапись);
	Контекст.Вставить("СертификатРуководителя",               СертификатРуководителя);
	Контекст.Вставить("СертификатГлавногоБухгалтера",         СертификатГлавногоБухгалтера);
	Контекст.Вставить("СертификатОтветственногоЗаШифрование", СертификатДляШифрования);
	
	Возврат Истина;
	
КонецФункции

Функция ОтправкаРегламентированногоОтчетаВФНС_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст) Экспорт
	
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбменаСсылка = Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСФНС;
	ЦиклОбмена.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСФНС.Приказ534;
	ЦиклОбмена.Предмет = Контекст.Документ;
	ЦиклОбмена.Идентификатор = СгенерироватьUUID();
	
	ТипОтправляемогоДокумента = Контекст.ТипОтправляемогоДокумента;
	Если ТипОтправляемогоДокумента = "РегламентированныйОтчет" ИЛИ ТипОтправляемогоДокумента = "УведомлениеОПолучателеДокументов"
		ИЛИ ТипОтправляемогоДокумента = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных("СправкиНДФЛДляПередачиВНалоговыйОрган")
		ИЛИ ТипОтправляемогоДокумента = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных("ЗаявлениеОПодтвержденииПраваНаЗачетАвансовПоНДФЛ") Тогда
		
		РезультатПоиска = Справочники.ВидыОтправляемыхДокументов.НайтиПоРеквизиту("Источник", Контекст.ВидОтправляемогоОтчета);
		Если РезультатПоиска = Справочники.ВидыОтправляемыхДокументов.ПустаяСсылка() Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'В справочнике ""Виды отправляемых документов"" не найден элемент с именем объекта метаданных %1!';
									|en = 'The item with metadata object name %1 is not found in the ""Kinds of documents to be sent"" catalog.'"),
									Символ(34) + Контекст.ВидОтправляемогоОтчета + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		ЦиклОбмена.ВидОтчета = РезультатПоиска;
		ЦиклОбмена.Тип = Контекст.ТипЦиклаОбмена;
		Если ТипОтправляемогоДокумента = "РегламентированныйОтчет" Тогда
			ЦиклОбмена.ВидДокумента = Контекст.Документ.Вид;
		КонецЕсли;
		
	ИначеЕсли ТипОтправляемогоДокумента = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных("БухгалтерскийОтчетГосударственногоУчреждения") Тогда
		
		ЦиклОбмена.ВидОтчета = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьВидОтправляемогоДокументаПоСсылке(Контекст.Документ);
	    ЦиклОбмена.Тип = Контекст.ТипЦиклаОбмена;
		
	ИначеЕсли ТипОтправляемогоДокумента = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных("ЗаявлениеОВвозеТоваров") Тогда
		
		ЦиклОбмена.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.ЗаявлениеОВвозеТоваров;
	    ЦиклОбмена.Тип = Контекст.ТипЦиклаОбмена;
		
	Иначе
		
		ЦиклОбмена.ВидОтчета = Контекст.Документ.ВидОтчета;
		ЦиклОбмена.ВидДокумента = Контекст.Документ.Версия;
		ЦиклОбмена.Тип = Контекст.ТипЦиклаОбмена;
		
	КонецЕсли;
	
	ЦиклОбмена.ДатаНачалаПериода = Контекст.ДатаНачалаПериодаОтчета;
	ЦиклОбмена.ДатаОкончанияПериода = Контекст.ДатаОкончанияПериодаОтчета;
	ЦиклОбмена.Организация = Контекст.Организация;
	ЦиклОбмена.УчетнаяЗапись = Контекст.УчетнаяЗапись;
	
	// указываем ту инспекцию, в которую должен быть представлен отчет
	Если НЕ ЗначениеЗаполнено(Контекст.КодНалоговогоОргана) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось определить налоговый орган, в который представляется отчетность!';
								|en = 'Cannot determine a tax authority to which the reporting is submitted.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Контекст.КодНалоговогоОргана) = Тип("Строка") Тогда
		ИФНС = Справочники.НалоговыеОрганы.НайтиПоКоду(Контекст.КодНалоговогоОргана);
		Если ИФНС = Справочники.НалоговыеОрганы.ПустаяСсылка() Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не найден налоговый орган с кодом %1 в справочнике ""Налоговые органы""!';
					|en = 'Tax authority with code %1 is not found in the ""Tax authorities"" catalog.""'"), Контекст.КодНалоговогоОргана);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ИФНС = Контекст.КодНалоговогоОргана;
	КонецЕсли;
	
	ЦиклОбмена.ВнешняяОрганизация = ИФНС;
	
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена = ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип = Контекст.ТипТранспортногоСообщения;
	ТранспортноеСообщение.Отправитель = Контекст.Организация;
	ТранспортноеСообщение.Получатель = ?(НЕ Контекст.УчетнаяЗапись.ОбменНапрямую, Контекст.УчетнаяЗапись.СерверДокументооборота, Контекст.УчетнаяЗапись.НалоговыйОрган);
	ТранспортноеСообщение.УчетнаяЗапись = Контекст.УчетнаяЗапись;
	ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Исходящее;
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
								|en = 'Report sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	// ДОБАВЛЯЕМ ВЛОЖЕНИЯ
	
	// определяем кодировку и тип содержимого
	Если нрег(Прав(Контекст.ИмяФайлаВыгрузки, 4)) = ".xml" Тогда
		КодировкаФайла = "windows-1251";
		ТипСодержимого = Перечисления.ТипыСодержимогоФайлов.xml;
	Иначе
		КодировкаФайла = "cp866";
		ТипСодержимого = Перечисления.ТипыСодержимогоФайлов.Текст866;
	КонецЕсли;
	
	// сохраняем выгрузку во временный файл
	ИмяВремФайла = ПолучитьИмяВременногоФайла();
	Если ЭтоАдресВременногоХранилища(Контекст.ТекстВыгрузки) Тогда
		ДвоичныеДанныеФайлаВыгрузки = ПолучитьИзВременногоХранилища(Контекст.ТекстВыгрузки);
		ДвоичныеДанныеФайлаВыгрузки.Записать(ИмяВремФайла);
	Иначе
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(Контекст.ТекстВыгрузки);
		Текст.Записать(ИмяВремФайла, КодировкаФайла);
	КонецЕсли;
	
	// добавляем ДИВ
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Контекст.ТипСодержимогоКонтейнера, ИмяВремФайла, Контекст.ИмяФайлаВыгрузки, , , , , , , СгенерироватьUUID(), ТипСодержимого) Тогда
		ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
								|en = 'Report sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// добавляем приложения, если они есть
	Если Контекст.Свойство("ПриложенияКБО") Тогда
		Для Каждого СтрПриложениеКБО Из Контекст.ПриложенияКБО Цикл
			Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение, СтрПриложениеКБО.ПолноеИмяФайла, СтрПриложениеКБО.ИмяФайла, , , , , , , СгенерироватьUUID(), СтрПриложениеКБО.ТипСодержимого) Тогда
				ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
										|en = 'Report sending is canceled.'");
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
	// добавляем приложения, если они есть
	Если Контекст.Свойство("Приложения") Тогда
		Для Каждого СтрПриложение Из Контекст.Приложения Цикл
			ТипСодержимогоФайла = "xml";
			РасширениеПриложения = ".xml";
			ИмяФайлаПриведенное = ВРЕГ(СтрПриложение.ИмяФайлаВыгрузки);
			Если Лев(ИмяФайлаПриведенное, 3) = "PR_" Тогда // нетекстовые приложения есть у уведомления о невозможности предоставления документов в срок
				ТипСодержимогоФайла = ТипСодержимогоПоИмениФайла(СтрПриложение.ИмяФайлаВыгрузки);
				РасширениеПриложения = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(СтрПриложение.ИмяФайлаВыгрузки).Расширение;
			КонецЕсли;
			
			ПолноеИмяФайла = ПолучитьИмяВременногоФайла(РасширениеПриложения);
			ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(СтрПриложение.АдресФайлаВыгрузки);
			ДвоичныеДанныеФайла.Записать(ПолноеИмяФайла);
			УдалитьИзВременногоХранилища(СтрПриложение.АдресФайлаВыгрузки);
						
			РезультатДобавления = ДобавитьСодержимоеТранспортногоКонтейнера(
				ТранспортноеСообщение.Ссылка,
				Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение,
				ПолноеИмяФайла,
				СтрПриложение.ИмяФайлаВыгрузки,,,,,,,
				СгенерироватьUUID(),				
				ТипСодержимогоФайла);
				
			УдалитьФайлы(ПолноеИмяФайла);
			
			Если НЕ РезультатДобавления Тогда
				ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
										|en = 'Report sending is canceled.'");
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// добавляем доверенность, если она есть
	Если ЗначениеЗаполнено(Контекст.ФайлДоверенности) Тогда
		ДоверенностьТипСодержимого = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление;
		
		Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, ДоверенностьТипСодержимого, Контекст.ФайлДоверенности, Контекст.КороткоеИмяФайлаДоверенности, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml) Тогда
			ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
									|en = 'Report sending is canceled.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// пишем цикл обмена
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
								|en = 'Report sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	
	// формируем файл описания сведений, если его нет
	РезультатФормирования = СформироватьОписаниеСведенийДляСообщенияФНС(Контекст);
	Если НЕ РезультатФормирования Тогда
		ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
								|en = 'Report sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция СформироватьОписаниеСведенийДляСообщенияФНС(Контекст) Экспорт
	
	Сообщение = Контекст.ТранспортноеСообщение;
	
	Если Сообщение.Тип = Перечисления.ТипыТранспортныхСообщений.Форма2НДФЛНП Тогда
		
		// получаем список вложений сообщения
		ТипыВложений = Новый Массив;
		ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Форма2НДФЛ);
		ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление);
		ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведений2НДФЛ);
