Процедура СформироватьПакет(Сообщение, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	РеквизитыСообщения = Новый Структура();
	РеквизитыСообщения.Вставить("ВидЦиклаОбмена", "ЦиклОбмена.Вид");

	РеквизитыСообщения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Сообщение, РеквизитыСообщения, Истина);
	ВидЦиклаОбмена = РеквизитыСообщения.ВидЦиклаОбмена;
	
	// В настоящий момент отправка рег.отчетов с сервера без взаимодействия с клиентским контекстом
	// поддерживается только для ФНС и ПФР.

	Если ВидЦиклаОбмена = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСПФР Тогда
		СформироватьПакетПФР(Сообщение, Новый УникальныйИдентификатор, СообщениеОбОшибке);
	ИначеЕсли ВидЦиклаОбмена = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСФНС Тогда
		СформироватьПакетФНС(Сообщение, Новый УникальныйИдентификатор, СообщениеОбОшибке);
	Иначе
		СообщениеОбОшибке = СтрШаблон(НСтр("ru = 'СформироватьПакет(): Неподдерживаемый без взаимодействия с клиентским контекстом вид цикла обмена %1';
											|en = 'СформироватьПакет(): Not supported without interaction with client context exchange cycle kind %1'"), ВидЦиклаОбмена);
		ВызватьИсключение СообщениеОбОшибке;
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиСертификаты(Сертификаты, ВыполнятьПроверку)

	// Внимание!
	// ---------
	// В общем модуле КриптографияЭДКОСлужебныйКлиент есть одноименная процедура,
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	СертификатыВЗащищенномХранилищеНаСервере = Новый Массив;
	
	Для Каждого Сертификат Из Сертификаты Цикл
		Если КриптографияЭДКОКлиентСервер.СертификатВЗащищенномХранилищеНаСервере(Сертификат) Тогда
			СертификатыВЗащищенномХранилищеНаСервере.Добавить(Сертификат);
		КонецЕсли;
	КонецЦикла;
	
	РезультатПоиска = КриптографияЭДКОСлужебныйВызовСервера.НайтиСертификатыВЗащищенномХранилищеНаСервере(
		СертификатыВЗащищенномХранилищеНаСервере, ВыполнятьПроверку);

	Результат = КриптографияЭДКОКлиентСервер.ПодготовитьРезультат(Истина, "Сертификаты", РезультатПоиска.Сертификаты);
	Результат.Вставить("НенайденныеСертификаты", РезультатПоиска.НенайденныеСертификаты);
	
	Возврат Результат;
	
КонецФункции

Процедура СформироватьПакет_ОтработатьОтложенныеКоманды(КонтекстОтправки, СообщениеОбОшибке)
	
	// Внимание!
	// ---------
	// В Контейнере есть аналогичная процедура СформироватьПакет_ОтработатьОтложенныеКомандыНаКлиенте(),
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	Перем ЭтоЭлектроннаяПодписьВМоделиСервиса;
	
	КонтекстОтправки.Свойство("ЭПВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса = Неопределено Тогда
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(КонтекстОтправки.УчетнаяЗапись);
	ЭтоЭлектроннаяПодписьВМоделиСервиса = РеквизитыУчетнойЗаписи.ЭлектроннаяПодписьВМоделиСервиса;
		КонтекстОтправки.Вставить("ЭПВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	КонецЕсли;
	
	КонтекстОтправки.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	
	СформироватьПакет_ОтработатьОтложенныеКомандыПоследовательно(КонтекстОтправки, СообщениеОбОшибке);
	
КонецПроцедуры

Процедура СформироватьПакет_ОтработатьОтложенныеКомандыПоследовательно(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть аналогичная процедура СформироватьПакет_ОтработатьОтложенныеКомандыНаКлиентеПоследовательно(),
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ОтложенныеКоманды = КонтекстОтправки.ОтложенныеКоманды;

	Для ТекущаяКоманда = 0 По ОтложенныеКоманды.Количество() - 1 Цикл

		Данные = ИзвлечьДвоичныеДанныеПриНеобходимости(ОтложенныеКоманды[ТекущаяКоманда].Значение);
		
		Если ОтложенныеКоманды[ТекущаяКоманда].Представление = "Зашифровать" Тогда
			
			Если КонтекстОтправки.Свойство("ОбъектСертификатСервераДокументооборота")
				И ЗначениеЗаполнено(КонтекстОтправки.ОбъектСертификатСервераДокументооборота)
				И КонтекстОтправки.Свойство("СвойстваОтложенныхКоманд") Тогда
				
				ИдентификаторОтложеннойКоманды = ОтложенныеКоманды[ТекущаяКоманда].ПолучитьИдентификатор();
				СвойстваОтложеннойКоманды = КонтекстОтправки.СвойстваОтложенныхКоманд[ИдентификаторОтложеннойКоманды];
				Если СвойстваОтложеннойКоманды <> Неопределено И СвойстваОтложеннойКоманды.ДляСервераДокументооборота Тогда
					Попытка
						ЗашифрованныеДанные = СервисКриптографии.Зашифровать(
							Данные,
							КонтекстОтправки.ОбъектСертификатПолучателя);
						
						ЗашифрованныеДобавляемыеДанные = СервисКриптографии.Зашифровать(
							Данные,
							КонтекстОтправки.ОбъектСертификатСервераДокументооборота);
						
						МассивИменФайлов = Новый Массив;
						
						ФайлДанных = ПолучитьИмяВременногоФайла();
						ЗашифрованныеДанные.Записать(ФайлДанных);
						МассивИменФайлов.Добавить(ФайлДанных);
						
						ФайлРазделителя = ПолучитьИмяВременногоФайла();
						ДанныеРазделителя = Base64Значение("FD2WshXWT3yZW18vlRZXnA==");
						ДанныеРазделителя.Записать(ФайлРазделителя);
						МассивИменФайлов.Добавить(ФайлРазделителя);
						
						ФайлДобавляемыхДанных = ПолучитьИмяВременногоФайла();
						ЗашифрованныеДобавляемыеДанные.Записать(ФайлДобавляемыхДанных);
						МассивИменФайлов.Добавить(ФайлДобавляемыхДанных);
						
						ФайлРезультата = ПолучитьИмяВременногоФайла();
						ОбъединитьФайлы(МассивИменФайлов, ФайлРезультата);
						
						ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлДанных);
						ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлРазделителя);
						ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлДобавляемыхДанных);
						
						ДанныеРезультата = Новый ДвоичныеДанные(ФайлРезультата);
						ПоместитьВоВременноеХранилище(ДанныеРезультата, ОтложенныеКоманды[ТекущаяКоманда].Значение);
						
						ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлРезультата);
					Исключение
						// Запись в журнал регистрации зарегистрирована исходным методом, повторно не регистрируем.
						СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						Возврат;
					КонецПопытки;
					
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
			Попытка
				ЗашифрованныеДанные = СервисКриптографии.Зашифровать(
					Данные,
					КонтекстОтправки.ОбъектСертификатПолучателя);
				
				// Заменяем сами данные на их зашифрованное значение.
				ПоместитьВоВременноеХранилище(ЗашифрованныеДанные, ОтложенныеКоманды[ТекущаяКоманда].Значение);
			Исключение
				// Запись в журнал регистрации зарегистрирована исходным методом, повторно не регистрируем.
				СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				Возврат;
			КонецПопытки;

		ИначеЕсли ОтложенныеКоманды[ТекущаяКоманда].Представление = "ПодписатьФайлОписанияПакета" Тогда
			
			// Команда "ПодписатьФайлОписанияПакета" используется при подготовке отчетности в ПФР.
			Попытка

				ПараметрыПодписания = Новый Структура;
				ПараметрыПодписания.Вставить("ОтсоединеннаяПодпись", Истина);
				ПараметрыПодписания.Вставить("ИспользоватьДлительныйМаркерБезопасности", 
					МожноИспользоватьДлительныйМаркерБезопасностиДляСообщения(КонтекстОтправки.ТипСообщения));

				Подпись = СервисКриптографии.Подписать(
					Данные,
					КонтекстОтправки.ОбъектСертификатРуководителя,
					"CMS",
					ПараметрыПодписания);

				Если ТипЗнч(Подпись) = Тип("Структура") Тогда
					// Это структурированная ошибка при работе сервиса криптографии, передаем ее вызывающей процедуре.
					СообщениеОбОшибке = Подпись.КодВозврата;
					Возврат;
				КонецЕсли;

				// Запоминаем результат подписания.
				КонтекстОтправки.Вставить("ФайлПодписиПодФайломОписанияПакета", ПоместитьВоВременноеХранилище(Подпись, Новый УникальныйИдентификатор()));
			Исключение
				// Запись в журнал регистрации зарегистрирована исходным методом, повторно не регистрируем.
				СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				Возврат;
			КонецПопытки;
					
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция КодПоТипуДокументаПакета(ТипДокумента, КодТипаДокументоооборота) Экспорт
	
	// отчетность ФНС
	Если ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетности Тогда
		Возврат "01";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Документ Тогда
		Возврат "01";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведений Тогда
		Возврат "02";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеДокумент Тогда
		Возврат "02";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Доверенность Тогда
		Если КодТипаДокументоооборота = "02" Тогда
			Возврат "04";
		Иначе
			Возврат "03";
		КонецЕсли;
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеДатыОтправки Тогда
		Если КодТипаДокументоооборота = "02" Тогда
			Возврат "05";
		Иначе
			Возврат "04";
		КонецЕсли;
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказе Тогда
		Если КодТипаДокументоооборота = "02" Тогда
			Возврат "07";
		ИначеЕсли КодТипаДокументоооборота = "06" Тогда // запрос
			Возврат "06";
		Иначе
			Возврат "05";
		КонецЕсли;
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.КвитанцияОПриеме Тогда
		Если КодТипаДокументоооборота = "06" Тогда // запрос
			Возврат "05";
		Иначе
			Возврат "06";
		КонецЕсли;
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.КвитанцияОПриемеДокумент Тогда
		Возврат "06";
    ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказеДокумент Тогда
		Возврат "05";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбУточнении Тогда
		Возврат "07";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОВводе Тогда
		Возврат "08";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолучении Тогда
		Если КодТипаДокументоооборота = "08" Тогда // документооборот по 2-НДФЛ
			Возврат "07";
		ИначеЕсли КодТипаДокументоооборота = "02" Тогда
			Возврат "06";
		ИначеЕсли КодТипаДокументоооборота = "03" Тогда // письмоНО
			Возврат "05";
		ИначеЕсли КодТипаДокументоооборота = "05" Тогда // рассылка групповая
			Возврат "05";
		ИначеЕсли КодТипаДокументоооборота = "10" Тогда // документ
			Возврат "07";
		ИначеЕсли КодТипаДокументоооборота = "06" Тогда // запрос
			Возврат "08";
		ИначеЕсли КодТипаДокументоооборота = "09" Тогда // заявление
			Возврат "07";
		ИначеЕсли КодТипаДокументоооборота = "12" Тогда // представление
			Возврат "08";
		Иначе
			Возврат "09";
		КонецЕсли;
		
	//заявление
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Заявление Тогда
		Возврат "01";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведенийЗаявление Тогда
		Возврат "02";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.КвитанцияОПриемеЗаявления Тогда
		Возврат "06";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СообщениеОПроверке Тогда
		Возврат "07";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СообщениеОбОтзывеЗаявления Тогда
		Возврат "09";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СообщениеОНесоответствиях Тогда
		Возврат "10";
		
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СообщениеОПростОтметки Тогда
		Возврат "08";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказеОтметки Тогда
		Возврат "09";	
	
	// 2-НДФЛ
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Форма2НДФЛ Тогда
		Возврат "01";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведений2НДФЛ Тогда
		Возврат "02";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Протокол2НДФЛ Тогда
		Возврат "05";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Реестр2НДФЛ Тогда
		Возврат "06";
	
	// обращение
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Обращение Тогда
		Возврат "01";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведенийОбращениеПисьмоРассылка Тогда
		Возврат "02";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение Тогда
		Если КодТипаДокументоооборота = "01" Тогда // ФНС
			Возврат "10";
		Иначе
			Возврат "03";
		КонецЕсли;
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеДатыПолучения Тогда
		Если КодТипаДокументоооборота = "06" Тогда // запрос
			Возврат "09";
		Иначе
			Возврат "08";
		КонецЕсли;
		
	// представление
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Представление Тогда
		Возврат "01";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление Тогда
		Если КодТипаДокументоооборота = "01" ИЛИ КодТипаДокументоооборота = "06" ИЛИ КодТипаДокументоооборота = "08" ИЛИ КодТипаДокументоооборота = "09" Тогда
			Возврат "03";
		Иначе
			Возврат "04";
		КонецЕсли;
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПредставление Тогда
		Возврат "02";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеДатыОтправкиПредставление Тогда
		Если КодТипаДокументоооборота = "01" ИЛИ КодТипаДокументоооборота = "03" ИЛИ КодТипаДокументоооборота = "04" ИЛИ КодТипаДокументоооборота = "05"
			ИЛИ КодТипаДокументоооборота = "06" ИЛИ КодТипаДокументоооборота = "08" ИЛИ КодТипаДокументоооборота = "09" Тогда
			Возврат "04";
		Иначе
			Возврат "05";
		КонецЕсли;
		
	// запрос
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Запрос Тогда
		Возврат "01";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Ответ Тогда
		Возврат "07";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведенийЗапрос Тогда
		Возврат "02";
		
	// запрос на выписку ЕГРЮЛ/ЕГРИП
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЗапросНаВыпискуИзЕГРЮЛ_ЕГРИП Тогда
		Возврат "01";
	КонецЕсли;
	
КонецФункции

Функция ИдентификаторПоТипуДокументаПакета(ТипДокумента) Экспорт
	
	Если ТипЗнч(ТипДокумента) = Тип("Строка") Тогда
		Возврат СокрЛП(ТипДокумента);
		
