			ТекстПредупреждения = ТекстИзHTML(ТекстПредупреждения);
			
			Если ЗначениеЗаполнено(ТекстПредупреждения) Тогда
				ЭлементПредупреждения = ТекстПослеПрефикса(ТекстУзлаПредупреждения, " elname='", "'");
