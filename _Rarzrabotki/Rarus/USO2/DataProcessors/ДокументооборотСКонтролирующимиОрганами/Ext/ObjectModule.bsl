Функция СообщениеЗашифровано(Сообщение) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
						  |	ИСТИНА КАК Поле1
						  |ИЗ
						  |	РегистрСведений.ТранспортныеКонтейнеры КАК ТранспортныеКонтейнеры
						  |ГДЕ
						  |	ТранспортныеКонтейнеры.ТранспортноеСообщение = &ТранспортноеСообщение");
	Запрос.УстановитьПараметр("ТранспортноеСообщение", Сообщение);
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция СообщениеРасшифровано(Сообщение) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
						  |	ИСТИНА КАК Поле1
						  |ИЗ
						  |	РегистрСведений.СодержимоеТранспортныхКонтейнеров КАК СодержимоеТранспортныхКонтейнеров
						  |ГДЕ
						  |	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение = &ТранспортноеСообщение");
	Запрос.УстановитьПараметр("ТранспортноеСообщение", Сообщение);
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция РасшифроватьТранспортноеСообщение(Объект)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(Объект);
	ЭтоЭлектроннаяПодписьВМоделиСервиса = РеквизитыУчетнойЗаписи.ЭлектроннаяПодписьВМоделиСервиса;
	
	Если НЕ ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		// Расшифровка на стороне сервера возможна, только если используется электронная подпись в модели сервиса.
		Возврат Ложь;
	КонецЕсли;
	
	ТипСообщения = Неопределено;
	
	СсылкаНаОбъект = ?(ТипЗнч(Объект) = Тип("ДокументСсылка.ТранспортноеСообщение"), Объект, Объект.Ссылка);
	
	// Получаем Контейнер, распаковываем файлы, разбираем XML
	// возвращает "Булево" или "тип сообщения"
	ДокументыПакета = НовыеДокументыПакета();
	ТаблицаРаспакованныхФайлов = НоваяТаблицаРаспакованныхФайлов();
	Результат = ОбработатьСодержимоеТранспортногоКонтейнера(СсылкаНаОбъект, ДокументыПакета, ТаблицаРаспакованныхФайлов);
			
	Если ТипЗнч(Результат) = Тип("Булево") Тогда 
		Возврат Результат;
	ИначеЕсли ТипЗнч(Результат) = Тип("Структура") Тогда 
		Если НЕ Результат.Свойство("ТипСообщения", ТипСообщения) Тогда 
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ДокументыПакета.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ФайлОписанияСведений = ТаблицаРаспакованныхФайлов.НайтиСтроки(Новый Структура("Имя","packageDescription.xml"));
	Если ФайлОписанияСведений.Количество() = 0 Тогда 
		ТекстСообщения = НСтр("ru = 'Ошибка распаковки пакета: не найден файл описания пакета (packageDescription.xml).';
								|en = 'An error occurred while unpacking the package: package description file is not found (packageDescription.xml).'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
		
	// расшифровываем содержимое
	// из свойств транспортного сообщения получим учетную запись, оттуда получим отпечаток сертификата получателя, которым зашифрован пакет
	СертификатПолучателя = ПолучитьОтпечатокСертификатаПолучателя(СсылкаНаОбъект);
	
	КонтекстРасшифровки = Новый Структура;
	КонтекстРасшифровки.Вставить("СертификатПолучателя", СертификатПолучателя);
	КонтекстРасшифровки.Вставить("СсылкаНаОбъект", СсылкаНаОбъект);
	КонтекстРасшифровки.Вставить("ТипСообщения", ТипСообщения);
	КонтекстРасшифровки.Вставить("ТекущийДокумент", 0);
	КонтекстРасшифровки.Вставить("ДокументыПакета", ДокументыПакета);
		
	Если НЕ ВыполнитьРасшифровкуСообщенийПоследовательно(КонтекстРасшифровки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
   	ПодтвердитьРасшифровку(СсылкаНаОбъект);
	
	Возврат Истина;
	
КонецФункции

Функция ВыполнитьРасшифровкуСообщенийПоследовательно(ВходящийКонтекст)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ДокументыПакета = ВходящийКонтекст.ДокументыПакета;

	Для каждого ЭлементПакета Из ДокументыПакета Цикл

		Если ВходящийКонтекст.ТипСообщения = "ФНС_534" Тогда 
			АдресФайла = ?(ЗначениеЗаполнено(ЭлементПакета.АдресФайла), ЭлементПакета.АдресФайла, ЭлементПакета.АдресФайлаПодписи);
		Иначе
			АдресФайла = ЭлементПакета.АдресФайла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АдресФайла) Тогда
			Если ЭлементПакета.ДокументЗашифрован Тогда
				СообщениеОбОшибке = "";
				РасшифроватьPKCS7(АдресФайла, СообщениеОбОшибке);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					Возврат Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ВыполнитьРасшифровкуСообщенийПоследовательноПослеРасшифровки(Новый Структура("Выполнено", Истина), ВходящийКонтекст);
		
		ВходящийКонтекст.ТекущийДокумент = ВходящийКонтекст.ТекущийДокумент + 1;
	КонецЦикла;

	Если ВходящийКонтекст.ТипСообщения = "ПФР" Тогда
		// разбираем дополнительные описания с целью восстановить исходные имена файлов
		ВосстановитьИсходныеИменаФайлов(ВходящийКонтекст.СсылкаНаОбъект, ДокументыПакета);
	КонецЕсли;
	
	// помещаем файлы в регистр содержимого, повторно распознаем получателя после расшифровки содержимого
	Если НЕ ПоместитьФайлыВРегистрСодержимого(ВходящийКонтекст.СсылкаНаОбъект, ДокументыПакета) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// особая обработка в случае неформализованных документов налогового органа, документов реализации своих полномочий
	// уведомлений об уточнении и протоколов приема 2-НДФЛ
	Если НЕ ОбработатьНеформализованныеДокументы(ВходящийКонтекст.СсылкаНаОбъект) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СоздатьПодтверждениеПриНеобходимости(ВходящийКонтекст.СсылкаНаОбъект);
	
КонецФункции

Процедура ВыполнитьРасшифровкуСообщенийПоследовательноПослеРасшифровки(Результат, ВходящийКонтекст)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ДокументыПакета = ВходящийКонтекст.ДокументыПакета;

	Если Результат.Выполнено Тогда
		ЭлементПакета = ДокументыПакета[ВходящийКонтекст.ТекущийДокумент];
		Если ВходящийКонтекст.ТипСообщения = "ФНС_534" Тогда 
			АдресФайла = ?(ЗначениеЗаполнено(ЭлементПакета.АдресФайла), ЭлементПакета.АдресФайла, ЭлементПакета.АдресФайлаПодписи);
		Иначе
			АдресФайла = ЭлементПакета.АдресФайла;
		КонецЕсли;
		Если ЭлементПакета.ДокументСжат Тогда		
			Если Не ЗначениеЗаполнено(АдресФайла) Тогда
				Возврат;
			Иначе
				ЭтоФайлПодписи = ВходящийКонтекст.ТипСообщения = "ФНС_534" И НЕ ЗначениеЗаполнено(ЭлементПакета.АдресФайла);
				АдресФайла = РазархивироватьФайлИзВременногоХранилища(АдресФайла, НЕ ЭтоФайлПодписи);
				Если АдресФайла <> Неопределено ИЛИ НЕ ЭтоФайлПодписи Тогда
					ЭлементПакета.АдресФайла = АдресФайла;
					Если ВходящийКонтекст.ТипСообщения = "ФНС_534" Тогда
						Если ЗначениеЗаполнено(ЭлементПакета.АдресФайла) Тогда
							ЭлементПакета.АдресФайла = АдресФайла;
						Иначе
							ЭлементПакета.АдресФайлаПодписи = АдресФайла;
						КонецЕсли;
					Иначе
						ЭлементПакета.АдресФайла = АдресФайла;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ВходящийКонтекст.ТипСообщения = "ФСГС" Тогда 
			Если ЭлементПакета.ТипДокумента = ПредопределенноеЗначение("Перечисление.ТипыСодержимогоТранспортногоКонтейнера.ШаблонФСГС") Тогда
				Попытка
					ПараметрыШаблона = Новый Структура("АдресФайла, ИмяФайла", ЭлементПакета.АдресФайла, ЭлементПакета.ИмяФайла);
					ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ПриПолученииНовогоШаблонаФСГС(ПараметрыШаблона);
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭлементПакета.АдресФайлаПодписи) Тогда
			Если ЗначениеЗаполнено(ЭлементПакета.АдресФайла) Тогда
				Попытка
					Результат = КриптографияЭДКОКлиентСервер.ПроверитьПодписьPKCS7ВМоделиСервиса(
						ЭлементПакета.АдресФайлаПодписи, ЭлементПакета.АдресФайла);
				Исключение
					Результат = КриптографияЭДКОКлиентСервер.ПодготовитьРезультат(
						Ложь,
						"ОписаниеОшибки",
						КриптографияЭДКОКлиентСервер.ОписаниеОшибкиНеУдалосьПроверитьПодпись());
				КонецПопытки;
			Иначе
				Результат = Новый Структура("Выполнено, ПодписьВалидна, Подписанты", Истина, Неопределено, Неопределено);
			КонецЕсли;
			
			ВыполнитьРасшифровкуСообщенийПоследовательноПослеПроверкиПодписи(Результат, ВходящийКонтекст);
			
		КонецЕсли;
	Иначе
		ТекстСообщения = НСтр("ru = 'Ошибка расшифровки файла документа при распаковке пакета.';
								|en = 'An error occurred while decrypting a document file during package unpacking.'");
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьРасшифровкуСообщенийПоследовательноПослеПроверкиПодписи(Результат, ВходящийКонтекст)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	ДокументыПакета = ВходящийКонтекст.ДокументыПакета;
	
	Если НЕ Результат.Выполнено ИЛИ Результат.ПодписьВалидна = Ложь Тогда
		ИмяСобытия = НСтр("ru = 'Электронный документооборот с контролирующими органами. Проверка подписи';
							|en = 'Electronic data interchange with regulatory authorities. Signature check'");
		ТекстСообщения = НСтр("ru = 'Ошибка проверки подписи файла документа при распаковке пакета ""%1"" (тип сообщения: ""%2"", "
			+ "тип документа: ""%3"", имя файла: ""%4"", идентификатор: ""%5"", в модели сервиса: %6). %7'");
		
		Если Результат.Свойство("ОписаниеОшибки") Тогда
			ТекстОшибки = Результат.ОписаниеОшибки;
		Иначе
			ТекстОшибки = НСтр("ru = 'Подпись невалидна.';
								|en = 'Signature is invalid.'");
		КонецЕсли;
		
		Если Результат.Свойство("Подписанты") И Результат.Подписанты <> Неопределено И Результат.Подписанты.Количество() > 0 Тогда
			ТекстИнформацииОСертификате = НСтр("ru = 'Проверка сертификатом поставщика ""%1"" с серийным номером ""%2"".';
												|en = 'Check with the ""%1"" supplier certificate with the ""%2"" serial number.'");
			ТекстОшибки = ТекстОшибки + " " + СтрШаблон(
				ТекстИнформацииОСертификате,
				Результат.Подписанты[0].Поставщик,
				Результат.Подписанты[0].СерийныйНомер);
		КонецЕсли;
		
		ТекстСообщения = СтрШаблон(
			ТекстСообщения,
			Строка(ВходящийКонтекст.СсылкаНаОбъект),
			ВходящийКонтекст.ТипСообщения,
			Строка(ДокументыПакета[ВходящийКонтекст.ТекущийДокумент].ТипДокумента),
			ДокументыПакета[ВходящийКонтекст.ТекущийДокумент].ИмяФайла,
			ДокументыПакета[ВходящийКонтекст.ТекущийДокумент].Идентификатор,
			Строка(ВходящийКонтекст.СертификатПолучателя.ЭтоЭлектроннаяПодписьВМоделиСервиса),
			ТекстОшибки);
		
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Предупреждение, ТекстСообщения);
	КонецЕсли;
	
	ЭлементПакета = ДокументыПакета[ВходящийКонтекст.ТекущийДокумент];
	ЭлементПакета.СтатусПроверкиПодписи = ?(Результат.Выполнено И Результат.ПодписьВалидна = Неопределено,
		ПредопределенноеЗначение("Перечисление.СтатусыПроверкиЭЦП.ПустаяСсылка"),
		?(Результат.Выполнено И Результат.ПодписьВалидна,
		ПредопределенноеЗначение("Перечисление.СтатусыПроверкиЭЦП.Валидна"),
		ПредопределенноеЗначение("Перечисление.СтатусыПроверкиЭЦП.НеВалидна")));
	Если Результат.Свойство("Подписанты") И Результат.Подписанты <> Неопределено
		И Результат.Подписанты.Количество() > 0 И Результат.Подписанты[0].Свойство("Отпечаток") Тогда
		ЭлементПакета.ОтпечатокСертификатаПодписи = Результат.Подписанты[0].Отпечаток;
	Иначе
		ЭлементПакета.ОтпечатокСертификатаПодписи = "";
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодтвердитьРасшифровку(Сообщение) Экспорт
	
	НаборЗаписей = РегистрыСведений.СвойстваТранспортныхСообщений.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.УчетнаяЗапись.Установить(Сообщение.УчетнаяЗапись);
	НаборЗаписей.Отбор.ТранспортноеСообщение.Установить(Сообщение);
	
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл 
		
		// Изменение данных полей записи.
		Запись.ТребуетРасшифровки = Ложь;
		
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура ВосстановитьИсходныеИменаФайлов(Объект, ДокументыПакета) Экспорт

	ОбъектТип = Объект.Тип;
	
	// разбираем дополнительные описания с целью восстановить исходные имена файлов
	Если ОбъектТип = Перечисления.ТипыТранспортныхСообщений.ПротоколПФР Тогда
		
		// ищем протокол
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ТипДокумента", Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПротоколПФР);
		СтрПротоколПФР = ДокументыПакета.НайтиСтроки(СтруктураОтбора);
		Если СтрПротоколПФР <> Неопределено И СтрПротоколПФР.Количество() > 0 Тогда
			
			// загружаем протокол в дерево
			ТекстXML = Неопределено;
			ДеревоПротокола = ЗагрузитьXMLВДеревоЗначений(СтрПротоколПФР[0].АдресФайла, ТекстXML);
			Если ДеревоПротокола <> Неопределено Тогда
				
				// ищем узлы "приложение"
				УзлыПриложение = ДеревоПротокола.Строки.НайтиСтроки(Новый Структура("Имя, Тип", "приложение", "Э"), Истина);
				Для Каждого УзелПриложение Из УзлыПриложение Цикл
					
					// ищем подчиненный элемент "идентификаторДокумента"
					УзелИдентификаторДокумента = УзелПриложение.Строки.Найти("идентификаторДокумента", "Имя", Истина);
					
					// ищем подчиненный элемент "имяФайла"
					УзелИмяФайла = УзелПриложение.Строки.Найти("имяФайла", "Имя", Истина);
					
					Если УзелИдентификаторДокумента <> Неопределено И УзелИмяФайла <> Неопределено
						И ЗначениеЗаполнено(УзелИдентификаторДокумента.Значение) И ЗначениеЗаполнено(УзелИмяФайла.Значение) Тогда
						
						ИдентификаторДокумента = СокрЛП(УзелИдентификаторДокумента.Значение);
						ИмяФайлаПриложения = СокрЛП(УзелИмяФайла.Значение);
						
						СтруктураОтбора = Новый Структура;
						СтруктураОтбора.Вставить("идентификатор", ИдентификаторДокумента);
						СтрПриложение = ДокументыПакета.НайтиСтроки(СтруктураОтбора);
						Если СтрПриложение <> Неопределено И СтрПриложение.Количество() > 0 Тогда
							СтрПриложение[0].ИмяФайла = ИмяФайлаПриложения;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		// разбираем дополнительные описания с целью восстановить исходные имена файлов
	ИначеЕсли ОбъектТип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПолученияОтчетностиПФР Тогда
		
		// ищем протокол
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ТипДокумента", Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеПолученияОтчетностиПФР);
		СтрПротоколПФР = ДокументыПакета.НайтиСтроки(СтруктураОтбора);
		Если СтрПротоколПФР <> Неопределено И СтрПротоколПФР.Количество() > 0 Тогда
			
			// загружаем протокол в дерево
			ТекстXML = Неопределено;
			ДеревоПротокола = ЗагрузитьXMLВДеревоЗначений(СтрПротоколПФР[0].АдресФайла, ТекстXML);
			Если ДеревоПротокола <> Неопределено Тогда
				
				// ищем узлы "приложение"
				УзлыПриложение = ДеревоПротокола.Строки.НайтиСтроки(Новый Структура("Имя, Тип", "приложение", "Э"), Истина);
				Для Каждого УзелПриложение Из УзлыПриложение Цикл
					
					// ищем подчиненный элемент "идентификаторДокумента"
					УзелИдентификаторДокумента = УзелПриложение.Строки.Найти("идентификаторДокумента", "Имя", Истина);
					
					// ищем подчиненный элемент "имяФайла"
					УзелИмяФайла = УзелПриложение.Строки.Найти("имяФайла", "Имя", Истина);
					
					Если УзелИдентификаторДокумента <> Неопределено И УзелИмяФайла <> Неопределено
						И ЗначениеЗаполнено(УзелИдентификаторДокумента.Значение) И ЗначениеЗаполнено(УзелИмяФайла.Значение) Тогда
						
						ИдентификаторДокумента = СокрЛП(УзелИдентификаторДокумента.Значение);
						ИмяФайлаПриложения = СокрЛП(УзелИмяФайла.Значение);
						
						СтруктураОтбора = Новый Структура;
						СтруктураОтбора.Вставить("идентификатор", ИдентификаторДокумента);
						СтрПриложение = ДокументыПакета.НайтиСтроки(СтруктураОтбора);
						Если СтрПриложение <> Неопределено И СтрПриложение.Количество() > 0 Тогда
							СтрПриложение[0].ИмяФайла = ИмяФайлаПриложения;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ОбъектТип = Перечисления.ТипыТранспортныхСообщений.ОтветНаЗапросПФР Тогда
		
		// ищем протокол
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ТипДокумента", Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОтветНаЗапросПФР);
		СтрПротоколПФР = ДокументыПакета.НайтиСтроки(СтруктураОтбора);
		Если СтрПротоколПФР <> Неопределено И СтрПротоколПФР.Количество() > 0 Тогда
			
			// загружаем протокол в дерево
			ТекстXML = Неопределено;
			ДеревоПротокола = ЗагрузитьXMLВДеревоЗначений(СтрПротоколПФР[0].АдресФайла, ТекстXML);
			Если ДеревоПротокола <> Неопределено Тогда
				
				// ищем узлы "приложение"
				УзлыПриложение = ДеревоПротокола.Строки.НайтиСтроки(Новый Структура("Имя, Тип", "приложение", "Э"), Истина);
				Для Каждого УзелПриложение Из УзлыПриложение Цикл
					
					// ищем подчиненный элемент "идентификаторДокумента"
					УзелИдентификаторДокумента = УзелПриложение.Строки.Найти("идентификаторДокумента", "Имя", Истина);
					
					// ищем подчиненный элемент "имяФайла"
					УзелИмяФайла = УзелПриложение.Строки.Найти("имяФайла", "Имя", Истина);
					
					Если УзелИдентификаторДокумента <> Неопределено И УзелИмяФайла <> Неопределено
					И ЗначениеЗаполнено(УзелИдентификаторДокумента.Значение) И ЗначениеЗаполнено(УзелИмяФайла.Значение) Тогда
						
						ИдентификаторДокумента = СокрЛП(УзелИдентификаторДокумента.Значение);
						ИмяФайлаПриложения = СокрЛП(УзелИмяФайла.Значение);
						
						СтруктураОтбора = Новый Структура;
						СтруктураОтбора.Вставить("идентификатор", ИдентификаторДокумента);
						СтрПриложение = ДокументыПакета.НайтиСтроки(СтруктураОтбора);
						Если СтрПриложение <> Неопределено И СтрПриложение.Количество() > 0 Тогда
							СтрПриложение[0].ИмяФайла = ИмяФайлаПриложения;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ОбъектТип = Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееПФР Тогда
		
		// ищем протокол
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ТипДокумента", Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПисьма);
		СтрОписаниеПисьма = ДокументыПакета.НайтиСтроки(СтруктураОтбора);
		Если СтрОписаниеПисьма <> Неопределено И СтрОписаниеПисьма.Количество() > 0 Тогда
			
			// загружаем протокол в дерево
			ТекстXML = Неопределено;
			ДеревоОписания = ЗагрузитьXMLВДеревоЗначений(СтрОписаниеПисьма[0].АдресФайла, ТекстXML);
			Если ДеревоОписания <> Неопределено Тогда
				
				// ищем узлы "приложение"
				УзлыПриложение = ДеревоОписания.Строки.НайтиСтроки(Новый Структура("Имя, Тип", "приложение", "Э"), Истина);
				Для Каждого УзелПриложение Из УзлыПриложение Цикл
					
					// ищем подчиненный элемент "идентификаторДокумента"
					УзелИдентификаторДокумента = УзелПриложение.Строки.Найти("идентификаторДокумента", "Имя", Истина);
					
					// ищем подчиненный элемент "имяФайла"
					УзелИмяФайла = УзелПриложение.Строки.Найти("имяФайла", "Имя", Истина);
					
					Если УзелИдентификаторДокумента <> Неопределено И УзелИмяФайла <> Неопределено
						И ЗначениеЗаполнено(УзелИдентификаторДокумента.Значение) И ЗначениеЗаполнено(УзелИмяФайла.Значение) Тогда
						
						ИдентификаторДокумента = СокрЛП(УзелИдентификаторДокумента.Значение);
						ИмяФайлаПриложения = СокрЛП(УзелИмяФайла.Значение);
						
						СтруктураОтбора = Новый Структура;
						СтруктураОтбора.Вставить("идентификатор", ИдентификаторДокумента);
						СтрПриложение = ДокументыПакета.НайтиСтроки(СтруктураОтбора);
						Если СтрПриложение <> Неопределено И СтрПриложение.Количество() > 0 Тогда
							СтрПриложение[0].ИмяФайла = ИмяФайлаПриложения;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Функция ПоместитьФайлыВРегистрСодержимого(ОбъектСсылка, ДокументыПакета) Экспорт
	
	 // помещаем файлы в регистр содержимого
	Для Каждого СтрДокументПакета Из ДокументыПакета Цикл
		
		Если ЗначениеЗаполнено(СтрДокументПакета.АдресФайла) Тогда
			ДобавитьСодержимоеТранспортногоКонтейнера(ОбъектСсылка,
														СтрДокументПакета.ТипДокумента,
														СтрДокументПакета.АдресФайла,
														СтрДокументПакета.ИмяФайла,
														,
														,
														,
														,
														,
														,
														СтрДокументПакета.Идентификатор,
														СтрДокументПакета.ТипСодержимого);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрДокументПакета.ИмяФайлаПодписи) Тогда
			ДобавитьСодержимоеТранспортногоКонтейнера(ОбъектСсылка,
														Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись,
														СтрДокументПакета.АдресФайлаПодписи,
														СтрДокументПакета.ИмяФайлаПодписи,
														,
														СтрДокументПакета.ИмяФайла,
														СтрДокументПакета.ОтпечатокСертификатаПодписи,
														СтрДокументПакета.СтатусПроверкиПодписи,
														Ложь,
														,
														,
														СтрДокументПакета.ТипСодержимого);
		КонецЕсли;
		
	КонецЦикла;
	
	// повторно распознать получателя после расшифровки содержимого
	Возврат ИзменитьПолучателяВходящегоТранспортногоСообщенияПослеРасшифровки(ОбъектСсылка);
	
КонецФункции

Функция ИзменитьПолучателяВходящегоТранспортногоСообщенияПослеРасшифровки(ОбъектСсылка)
	
	Если ОбъектСсылка.Статус = Перечисления.СтатусыПисем.Полученное
		И ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.ДокументНО Тогда
		
		ПолучательТранспортногоСообщения = ОпределитьПолучателяВходящегоТранспортногоСообщения(ОбъектСсылка, Истина);
		Если ПолучательТранспортногоСообщения <> ОбъектСсылка.Получатель Тогда
			НачатьТранзакцию();
			
			Если ЗначениеЗаполнено(ОбъектСсылка.ЦиклОбмена) Тогда
				ОбъектЦиклОбмена = ОбъектСсылка.ЦиклОбмена.ПолучитьОбъект();
				ОбъектЦиклОбмена.Организация = ПолучательТранспортногоСообщения;
				Попытка
					ОбъектЦиклОбмена.Записать();
				Исключение
					ОтменитьТранзакцию();
					ТекстСообщения = НСтр("ru = 'Не удалось обновить свойства родительского цикла обмена ""%1""
												|%2';
												|en = 'Cannot update properties of the parent cycle of the ""%1"" exchange
												|%2'");
					ОписаниеОшибки = ИнформацияОбОшибке().Описание;
					ТекстСообщения = СтрШаблон(ТекстСообщения, ОбъектСсылка.ЦиклОбмена, ОписаниеОшибки);
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
					Возврат Ложь;
				КонецПопытки;
			КонецЕсли;
			
			ОбъектСообщение = ОбъектСсылка.ПолучитьОбъект();
			ОбъектСообщение.Получатель = ПолучательТранспортногоСообщения;
			Попытка
				ОбъектСообщение.Записать();
			Исключение
				ОтменитьТранзакцию();
				ТекстСообщения = НСтр("ru = 'Ошибка при записи расшифрованного сообщения %1: %2';
										|en = 'An error occurred while writing a decrypted message %1: %2'");
				ПредставлениеСообщения = ПредставлениеСообщения(ОбъектСсылка.Ссылка);
				ОписаниеОшибки = ИнформацияОбОшибке().Описание;
				ТекстСообщения = СтрШаблон(ТекстСообщения, ПредставлениеСообщения, ОписаниеОшибки);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Ложь;
			КонецПопытки;
			
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ОбработатьНеформализованныеДокументы(ОбъектСсылка) Экспорт

	ОбъектСообщение = ОбъектСсылка.ПолучитьОбъект();
	
	Если ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееПФР
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.ПисьмоНО
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.РассылкаНО 
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.РассылкаНО 
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.ДокументНО
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееФСГС
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.РассылкаФСГС
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.РассылкаШаблоновФСГС Тогда
		
		СоздатьПредметЦиклаОбмена(ОбъектСсылка);
		
	ИначеЕсли ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПолученияОтчетностиПФР
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.ОтветНаЗапросПФР
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.ПротоколПФР
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.ИзвещениеОПолученииОтчетностиФСГС
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.ПротоколВходногоКонтроляОтчетностиФСГС
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДекларацияНО
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаОбращениеНО
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаПредставлениеНО
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиДекларацияНО
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаФорма2НДФЛНО 
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаЗаявлениеНО
		ИЛИ ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗаявлениеРФНО Тогда
		
		ЯвляетсяОтрицательным = ЯвляетсяОтрицательнымПротоколом(ОбъектСсылка);
		Если ЯвляетсяОтрицательным Тогда
			// Чтобы не взводилась модифицированность в случае, если не является отрицательным.
			ОбъектСообщение.ПротоколСОшибкой = Истина;
		КонецЕсли;
		
	КонецЕсли;

	Если ОбъектСообщение.Модифицированность() Тогда
		Попытка
			ОбъектСообщение.Записать();
		Исключение
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Ошибка при записи расшифрованного сообщения %1: %2';
					|en = 'An error occurred while writing a decrypted message %1: %2'"),
				ПредставлениеСообщения(ОбъектСсылка.Ссылка), 
				Символы.ПС + ИнформацияОбОшибке().Описание);
				
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			
			Возврат Ложь;
			
		КонецПопытки;
	КонецЕсли;

	ОбновитьСтатусыСвязанногоОбъектаПриНеобходимости(ОбъектСсылка.Ссылка);

	// сохраняем ответ на запрос
	Если ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗапросНО Тогда
		ОбновитьОтветНаЗапросИОНВРегистреОтветовПриНеобходимости(ОбъектСсылка);
	КонецЕсли;
	
	// сохраняем ответ на запрос
	Если ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.ОтветНаЗапросПФР Тогда
		ОбновитьОтветНаЗапросИОСВРегистреОтветовПриНеобходимости(ОбъектСсылка);
	КонецЕсли;
	
	// сохраняем ответ на запрос выписки из ЕГРЮЛ/ЕГРИП
	Если ОбъектСсылка.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗапросаНаВыпискуЕРГЮЛ_ЕГРИП Тогда
		ОбновитьОтветНаЗапросВыпискиЕГРЮЛ_ЕГРИП_ПриНеобходимости(ОбъектСсылка);
	КонецЕсли;

	Возврат Истина;
	
КонецФункции

Функция УчетныеЗаписиПоОрганизациям(Организации) Экспорт
	
	СоответствиеУчетныхЗаписейОрганизациям = Новый Соответствие;
	УчетныеЗаписи = Новый Массив;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
						  |	Организации.Ссылка КАК Организация,
						  |	ВЫБОР
						  |		КОГДА Организации.ВидОбменаСКонтролирующимиОрганами = &ОбменВУниверсальномВФормате
						  |			ТОГДА Организации.УчетнаяЗаписьОбмена
						  |		ИНАЧЕ НЕОПРЕДЕЛЕНО
						  |	КОНЕЦ КАК УчетнаяЗапись
						  |ИЗ
						  |	Справочник.Организации КАК Организации
						  |ГДЕ
						  |	Организации.Ссылка В(&Ссылка)");
	Запрос.УстановитьПараметр("ОбменВУниверсальномВФормате", Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате);
	Запрос.УстановитьПараметр("Ссылка", Организации);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеУчетныхЗаписейОрганизациям.Вставить(Выборка.Организация, Выборка.УчетнаяЗапись);
	КонецЦикла;
	
	Для Инд = 1 По Организации.Количество() Цикл
		
		ТекОрганизация = Организации.Получить(Инд - 1);
		ТекУчетнаяЗапись = СоответствиеУчетныхЗаписейОрганизациям[ТекОрганизация];
		
		Если ЗначениеЗаполнено(ТекУчетнаяЗапись) И УчетныеЗаписи.Найти(ТекУчетнаяЗапись) = Неопределено Тогда
			УчетныеЗаписи.Добавить(ТекУчетнаяЗапись);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат УчетныеЗаписи;
	
КонецФункции

Функция ПолучитьВложения(СсылкаПисьмо, ИменаВложений = Неопределено) Экспорт
	
	Возврат ПолучитьВложенияНеформализованногоДокумента(СсылкаПисьмо, ИменаВложений, Истина);
	
КонецФункции

Функция ВыгрузитьТекстВФайл(Текст, ИмяФайла = Неопределено, КодировкаТекста = "windows-1251")
	
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		ИмяФайлаСохранения = ИмяФайла;
	Иначе
		ИмяФайлаСохранения = ПолучитьИмяВременногоФайла();
	КонецЕсли;
	
	ОбъектЗапись = Новый ЗаписьТекста(ИмяФайлаСохранения, КодировкаТекста);
	ОбъектЗапись.Записать(Текст);
	Попытка
		ОбъектЗапись.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат ИмяФайлаСохранения;
	
КонецФункции

Функция СформироватьИОП(ТранспортноеСообщение, ТекстВыгрузки = Неопределено, ИмяФайла = Неопределено) Экспорт
	
	ОрганизацияОтправитель = ТранспортноеСообщение.Отправитель;
	
	// в случае обмена через СОС налоговым органом-получателем считается конечный налоговый орган (указанный в титульном листе отчета),
	// а в случае обмена напрямую, НО-получателем считается налоговый орган, указанный в учетной записи
	НОПолучатель = ?(НЕ ТранспортноеСообщение.УчетнаяЗапись.ОбменНапрямую
					И (НЕ ТранспортноеСообщение.Отправитель.КрупнейшийНалогоплательщик ИЛИ НЕ ЗначениеЗаполнено(ТранспортноеСообщение.Отправитель.КодНалоговогоОрганаПолучателя)),
					ТранспортноеСообщение.ЦиклОбмена.ВнешняяОрганизация,
					ТранспортноеСообщение.УчетнаяЗапись.НалоговыйОрган);
	
	ИНН = СокрЛП(ОрганизацияОтправитель.ИНН);
	Если ПустаяСтрока(ИНН) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не задан ИНН для отправителя - организации %1!';
																						|en = 'TIN for sender company %1 is not specified.'"),
																					Символ(34) + ОрганизацияОтправитель + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Текст = Новый ТекстовыйДокумент;
	Текст.ДобавитьСтроку("ИдОтпр:" + СокрЛП(ИНН));
	
	Текст.ДобавитьСтроку("ВерсПрог:" + РегламентированнаяОтчетность.НазваниеИВерсияПрограммы());
	
	ИмяВремФайла = ПолучитьИмяВременногоФайла();
	Текст.Записать(ИмяВремФайла, "windows-1251");
	
	Возврат ИмяВремФайла;
	
КонецФункции

Функция ИзвлечьПоказатель(ТекстВыгрузки, КодПоказателя) Экспорт
	
	Если Лев(СокрЛ(ТекстВыгрузки), 1) = "<" Тогда // это XML
		ОбъектЧтениеXML = Новый ЧтениеXML;
		ОбъектЧтениеXML.УстановитьСтроку(ТекстВыгрузки);
		ОбъектЧтениеXML.ИгнорироватьПробелы = Ложь;
		Пока ОбъектЧтениеXML.Прочитать() Цикл
			Если ОбъектЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				Пока ОбъектЧтениеXML.ПрочитатьАтрибут() Цикл
					Если ОбъектЧтениеXML.Имя = КодПоказателя Тогда
						Возврат ОбъектЧтениеXML.Значение;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;	
	Иначе
		Для Инд = 1 По СтрЧислоСтрок(ТекстВыгрузки) Цикл
			ТекСтр = СтрПолучитьСтроку(ТекстВыгрузки, Инд);
			Если ВРЕГ(Лев(ТекСтр, СтрДлина(КодПоказателя) + 1)) = ВРЕГ(КодПоказателя + ":") Тогда
				Возврат Сред(ТекСтр, СтрДлина(КодПоказателя) + 2);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

Функция ВыборВТабличномПолеЦикловОбмена(ВыбраннаяСтрока, Колонка, СтандартнаяОбработка) Экспорт
	
	СоответствиеИменКолонок = Новый Соответствие();
	// ТаблицаЦиклыОбменаОтчетностьФНС 
	СоответствиеИменКолонок.Вставить("ПервичноеСообщение", "ПервичноеСообщение");
	СоответствиеИменКолонок.Вставить("ПодтверждениеОтправки", "ПодтверждениеОтправки");
	СоответствиеИменКолонок.Вставить("ОтветНаПодтверждениеОтправки", "ОтветНаПодтверждениеОтправки");
