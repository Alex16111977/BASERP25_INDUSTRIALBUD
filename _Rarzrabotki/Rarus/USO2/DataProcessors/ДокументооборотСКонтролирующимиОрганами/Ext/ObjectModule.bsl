	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаЗапроса = Неопределено;
	КонецЕсли;
	
	Возврат ТаблицаЗапроса; 
	
