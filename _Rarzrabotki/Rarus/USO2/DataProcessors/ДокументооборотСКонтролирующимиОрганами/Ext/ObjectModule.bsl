Процедура РегистрацияОбновитьСправочникПолучателейПФРиФНСФСГС(
		Тип, 
		Код, 
		Наименование, 
		Сертификаты, 
		УчетнаяЗапись, 
		СхемаОтправкиМПД, 
		СхемаОтправкиЗНПЗДП, 
		ВыводитьСообщения)
	
	Если Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ФНС) Тогда
		Справочник = Справочники.НалоговыеОрганы;
	ИначеЕсли Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ПФР) Тогда
		Справочник = Справочники.ОрганыПФР;
	ИначеЕсли Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ФСГС) Тогда
		Справочник = Справочники.ОрганыФСГС;
	КонецЕсли;
	НазваниеСправочника = Метаданные.НайтиПоТипу(ТипЗнч(Справочник)).Синоним;
	
	НайденнаяСсылка = Справочник.НайтиПоКоду(Код);
	
	Если НайденнаяСсылка = Справочник.ПустаяСсылка() Тогда
		Получатель = Справочник.СоздатьЭлемент();
		Получатель.Код = Код;
		
		Если ВыводитьСообщения Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Создан новый элемент справочника ""%1"" с кодом ""%2"".';
					|en = 'New item of catalog ""%1"" with code ""%2"" is created.'"), НазваниеСправочника, Код);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		КонецЕсли;
		
	Иначе 
		Получатель = НайденнаяСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	Если Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ФНС) Тогда
		Если ПустаяСтрока(Получатель.Наименование) Тогда
			Получатель.Наименование = "ИФНС " + Строка(Код);
		КонецЕсли;
		Получатель.ПриемНалоговойОтчетности = Истина;
	Иначе
		Получатель.Наименование = СокрЛП(Наименование);
	КонецЕсли;

	СертификатыОбновлены = Ложь;
	
	МассивСертификатов = Новый Массив;
	
	Для Каждого Сертификат из Получатель.Сертификаты Цикл
		МассивСертификатов.Добавить(НРег(Сертификат.Сертификат));
	КонецЦикла;
	
	Если НЕ СравнитьМассивыБезУчетаПорядкаЭлементов(МассивСертификатов, Сертификаты) Тогда
		
		Получатель.Сертификаты.Очистить();
		Для каждого Сертификат из Сертификаты Цикл
			НовыйСертификат = Получатель.Сертификаты.Добавить();
			НовыйСертификат.Сертификат = НРег(Сертификат);
		КонецЦикла;
		
		СертификатыОбновлены = Истина;
		
	КонецЕсли;
	
	Если СертификатыОбновлены Тогда
		
		Модицифированность = Истина;
		
		Если НЕ Получатель.ЭтоНовый() И ВыводитьСообщения Тогда
			Если Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ФНС) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Изменен сертификат налогового органа с кодом %1.';
						|en = 'Tax authority certificate with code %1 was changed.'"), Код);				
			ИначеЕсли Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ПФР) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Изменен сертификат органа ПФР с кодом %1.';
						|en = 'PF authority certificate with code %1 was changed.'"), Код);
			ИначеЕсли Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ФСГС) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Изменен сертификат органа Росстат с кодом %1.';
						|en = 'Certificate of the Russian Federal State Statistics Service body with code %1 was changed.'"), Код);
			КонецЕсли;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		КонецЕсли;
		
	КонецЕсли;
	
	ИзменилсяПризнакПолучения = Ложь;
	Если ТипЗнч(Получатель) = Тип("СправочникОбъект.ОрганыПФР") Тогда
		
		НастройкиМПД    = РазобратьНастройкиСхемыОтправкиОтчетностиПоФизЛицам(СхемаОтправкиМПД, Тип);
		НастройкиЗНПЗДП = РазобратьНастройкиСхемыОтправкиОтчетностиПоФизЛицам(СхемаОтправкиЗНПЗДП, Тип);

		ПринималМакетыПенсионныхДел = Получатель.ПринимаетМакетыПенсионныхДел;
		ПринималЗаявленияОНазначенииИДоставкеПенсии = Получатель.ПринимаетЗаявленияОНазначенииИДоставкеПенсии;
		
		Получатель.ПринимаетМакетыПенсионныхДел = ПолучательПринимаетОтчетностиПоФизЛицам(СхемаОтправкиМПД, Тип);
		Получатель.ПринимаетЗаявленияОНазначенииИДоставкеПенсии = ПолучательПринимаетОтчетностиПоФизЛицам(СхемаОтправкиЗНПЗДП, Тип);
		
		ИзменилсяПризнакПолучения = ПринималМакетыПенсионныхДел <> Получатель.ПринимаетМакетыПенсионныхДел
			ИЛИ ПринималЗаявленияОНазначенииИДоставкеПенсии <> Получатель.ПринимаетЗаявленияОНазначенииИДоставкеПенсии;
		
	КонецЕсли;
			
	Если СертификатыОбновлены ИЛИ Получатель.ЭтоНовый() ИЛИ ИзменилсяПризнакПолучения Тогда
		Получатель.Записать();
	КонецЕсли;
	
	Если ТипЗнч(Получатель) = Тип("СправочникОбъект.ОрганыПФР") Тогда
		
		ДобавитьЗаписьВРегистрПравилаОтправкиОтчетностиПоФизЛицам(
			НастройкиМПД,
			УчетнаяЗапись,
			Получатель,
			Перечисления.ВидыОтчетностиПоФизЛицам.МакетПенсионныхДел);
			
		ДобавитьЗаписьВРегистрПравилаОтправкиОтчетностиПоФизЛицам(
			НастройкиЗНПЗДП,
			УчетнаяЗапись,
			Получатель,
			Перечисления.ВидыОтчетностиПоФизЛицам.ЗаявлениеОНазначенииИДоставкеПенсии);
			
	КонецЕсли;
	
КонецПроцедуры

Функция РазобратьНастройкиСхемыОтправкиОтчетностиПоФизЛицам(СхемаОтправки, Тип)

	Настройки = Неопределено;
	
	Если Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ПФР)
		И СхемаОтправки.Количество() = 1 Тогда
		
		Настройки = Новый Структура;
		НастройкиВложение = Новый Структура;
		НастройкиТема = Новый Структура;
		
		// тема
		УзелТема = СхемаОтправки[0].ПолучитьЭлементыПоИмени("Тема")[0];
		НастройкиТема.Вставить("Маска", УзелТема.ПолучитьАтрибут("Маска"));
		
		// вложение
		УзелВложение = СхемаОтправки[0].ПолучитьЭлементыПоИмени("Вложение")[0];
		НастройкиВложение.Вставить("Маска", УзелВложение.ПолучитьАтрибут("Маска"));
		НастройкиВложение.Вставить("ДопустимыеТипы", УзелВложение.ПолучитьАтрибут("ДопустимыеТипы"));
		
		МаксимальныйРазмерФайла = УзелВложение.ПолучитьАтрибут("МаксимальныйРазмерФайла"); 
		НастройкиВложение.Вставить("МаксимальныйРазмерФайла", ?(ЗначениеЗаполнено(МаксимальныйРазмерФайла), Число(МаксимальныйРазмерФайла), 0));
		
		МаксимальныйРазмерВложения = УзелВложение.ПолучитьАтрибут("МаксимальныйРазмерВложения"); 
		НастройкиВложение.Вставить("МаксимальныйРазмерВложения", ?(ЗначениеЗаполнено(МаксимальныйРазмерВложения), Число(МаксимальныйРазмерВложения), 0));
		
		НастройкиВложение.Вставить("ТребуетсяАрхивирование", ?(УзелВложение.ПолучитьАтрибут("ТребуетсяАрхивирование")="true", Истина, Ложь));
		
		Настройки.Вставить("Тема", НастройкиТема);
		Настройки.Вставить("Вложение", НастройкиВложение);
		
	КонецЕсли;
	
	Возврат Настройки;
	
КонецФункции

Функция ПолучательПринимаетОтчетностиПоФизЛицам(СхемаОтправки, Тип)
	
	Возврат Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ПФР)
		И СхемаОтправки.Количество() = 1;
	
КонецФункции

Процедура ДобавитьЗаписьВРегистрПравилаОтправкиОтчетностиПоФизЛицам(Настройки, УчетнаяЗапись, Получатель, ВидОтчетности)
	
	Если ЗначениеЗаполнено(Настройки) Тогда
		МенеджерЗаписи = РегистрыСведений.ПравилаОтправкиОтчетностиПоФизЛицам.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.УчетнаяЗапись = УчетнаяЗапись;
		МенеджерЗаписи.ОрганПФР = Получатель.Ссылка;
		МенеджерЗаписи.ВидОтчетности = ВидОтчетности;
		МенеджерЗаписи.Данные = Новый ХранилищеЗначения(Настройки);
		МенеджерЗаписи.Записать(Истина);			
	КонецЕсли;
	
КонецПроцедуры

Процедура РегистрацияОбновитьСправочникПолучателей(ДокументDOM, Организация, ВыводитьСообщения, СтруктураАвтонастройкиФСС, СтруктураАвтонастройкиРПН, СтруктураАвтонастройкиФТС, УчетнаяЗапись)
	
	ОтпечаткиСертификатовАбонентовФСРАР = МассивОтпечатковСертификатовАбонентовФСРАР(ДокументDOM);
	
	Получатели = ДокументDOM.ПолучитьЭлементыПоИмени("Получатель");
	ДополнительныеПолучатели = ДокументDOM.ПолучитьЭлементыПоИмени("ДополнительныйПолучатель");
	МассивСписковПолучателей = Новый Массив;
	МассивСписковПолучателей.Добавить(Получатели);
	Если ДополнительныеПолучатели <> Неопределено Тогда
		МассивСписковПолучателей.Добавить(ДополнительныеПолучатели);
	КонецЕсли;
	
	МассивСертификатовФСС = Неопределено;
	МассивСертификатовЭЛН = Неопределено;
	МассивСертификатовФСРАР = Неопределено;
	МассивСертификатовСубъектаРФ = Неопределено;
	КодРегиона = Неопределено;
	
	СертификатыПФР = Новый Соответствие;
	Для Каждого ЭлементПолучатель Из ДокументDOM.ПолучитьЭлементыПоИмени("Получатель") Цикл
		Тип = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ЭлементПолучатель,"ТипПолучателя");
		Код = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ЭлементПолучатель,"КодПолучателя");
		Если Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ПФР) Тогда
			Если СертификатыПФР.Получить(Код) = Неопределено Тогда
				СертификатыПФР.Вставить(Код, Новый Массив);
			КонецЕсли;
			
			Сертификаты = ЭлементПолучатель.ПолучитьЭлементыПоИмени("Отпечаток");
			
			Для Каждого Сертификат из Сертификаты Цикл
				СертификатыПФР[Код].Добавить(НРег(Сертификат.текстовоесодержимое));
			КонецЦикла;	
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Получатели Из МассивСписковПолучателей Цикл
		Для Каждого Получатель из Получатели Цикл
			
			Тип = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Получатель,"ТипПолучателя");
			Код = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Получатель,"КодПолучателя");
			Наименование = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Получатель,"НаименованиеПолучателя");
			
			Если Тип <> XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ФТС) Тогда
				МассивСертификатов = Новый Массив;
				Сертификаты = Получатель.ПолучитьЭлементыПоИмени("Отпечаток");
				
				Для Каждого Сертификат из Сертификаты Цикл
					МассивСертификатов.Добавить(НРег(Сертификат.текстовоесодержимое));
				КонецЦикла;
			КонецЕсли;
			
			Если Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ФНС)
				Или Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ПФР)
				Или Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ФСГС) Тогда
				СхемаОтправкиМПД = Получатель.ПолучитьЭлементыПоИмени("СхемаОтправкиМПД");
				СхемаОтправкиЗНПЗДП = Получатель.ПолучитьЭлементыПоИмени("СхемаОтправкиЗНПЗДП");
				Если Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ПФР) Тогда
					МассивСертификатов = СертификатыПФР.Получить(Код);
				КонецЕсли;
				
				РегистрацияОбновитьСправочникПолучателейПФРиФНСФСГС(
					Тип, 
					Код, 
					Наименование, 
					МассивСертификатов, 
					УчетнаяЗапись, 
					СхемаОтправкиМПД, 
					СхемаОтправкиЗНПЗДП, 
					ВыводитьСообщения);
					
			ИначеЕсли Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ФСС) И Организация <> Неопределено Тогда 
				МассивСертификатовФСС = МассивСертификатов;
			ИначеЕсли Тип = "ЭЛН" И Организация <> Неопределено Тогда
				МассивСертификатовЭЛН = МассивСертификатов;
			ИначеЕсли Тип = "ФСРАР" И Организация <> Неопределено Тогда
				МассивСертификатовФСРАР = МассивСертификатов;
			ИначеЕсли Тип = "ОИВ" И Организация <> Неопределено Тогда
				МассивСертификатовСубъектаРФ = МассивСертификатов;
				КодРегиона = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Получатель, "КодПолучателя");
			ИначеЕсли Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.РПН) И Организация <> Неопределено Тогда
				Узел = ДокументDOM.ПолучитьЭлементыПоИмени("ВладелецЭЦП")[0];
				ОтпечатокСертификата = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "Отпечаток", , ОтпечаткиСертификатовАбонентовФСРАР, Истина);
				РегистрацияРегистрРПН(ОтпечатокСертификата, Сертификаты, Организация, ВыводитьСообщения, СтруктураАвтонастройкиРПН);
			ИначеЕсли Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ФТС) И Организация <> Неопределено Тогда
				Узел = ДокументDOM.ПолучитьЭлементыПоИмени("ВладелецЭЦП")[0];
				ОтпечатокСертификата = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "Отпечаток", , ОтпечаткиСертификатовАбонентовФСРАР, Истина);
				РегистрацияРегистрФТС(ОтпечатокСертификата, Организация, ВыводитьСообщения, СтруктураАвтонастройкиФТС);
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	Если Организация <> Неопределено Тогда
		
		Узел = ДокументDOM.ПолучитьЭлементыПоИмени("ВладелецЭЦП")[0];
		
		ОтпечатокСертификата = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "Отпечаток", , ОтпечаткиСертификатовАбонентовФСРАР, Истина);
		
		Если МассивСертификатовФСС <> Неопределено ИЛИ МассивСертификатовЭЛН <> Неопределено Тогда
			СтруктураАвтонастройкиФСС = НастроитьОбменФСС(
				МассивСертификатовФСС,
				МассивСертификатовЭЛН,
				ОтпечатокСертификата,
				Организация,
				ВыводитьСообщения);
		КонецЕсли;
		
		ОтпечатокСертификата = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "Отпечаток",, ОтпечаткиСертификатовАбонентовФСРАР, Ложь);
		
			Если (МассивСертификатовФСРАР <> Неопределено ИЛИ МассивСертификатовСубъектаРФ <> Неопределено) И НЕ(ЗначениеЗаполнено(ОтпечатокСертификата)) Тогда
				
				ОтпечатокСертификата = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "Отпечаток",, ОтпечаткиСертификатовАбонентовФСРАР, Истина);
				
			КонецЕсли;
			
		Если ЗначениеЗаполнено(ОтпечатокСертификата) ИЛИ МассивСертификатовФСРАР <> Неопределено ИЛИ МассивСертификатовСубъектаРФ <> Неопределено Тогда
			РегистрацияРегистрФСРАР(ОтпечатокСертификата, МассивСертификатовСубъектаРФ, МассивСертификатовФСРАР, КодРегиона, Организация, ВыводитьСообщения);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция НастроитьОбменФСС(Сертификаты, СертификатыЭЛН, ОтпечатокСертификата, Организация, ВыводитьСообщения) Экспорт
	
	СертификатФССОтпечаток = ?(Сертификаты <> Неопределено, нрег(Сертификаты[0]), "");
	СертификатФССЭЛНОтпечаток = ?(СертификатыЭЛН <> Неопределено, нрег(СертификатыЭЛН[0]), "");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиОбменаФСС.ИспользоватьАвтонастройку КАК ИспользоватьАвтонастройку,
	|	НастройкиОбменаФСС.ИспользоватьОбмен КАК ИспользоватьОбмен,
	|	НастройкиОбменаФСС.СертификатСтрахователяОтпечаток КАК СертификатСтрахователяОтпечаток,
	|	НастройкиОбменаФСС.СертификатФССОтпечаток КАК СертификатФССОтпечаток,
	|	НастройкиОбменаФСС.СертификатФССЭЛНОтпечаток КАК СертификатФССЭЛНОтпечаток
	|ИЗ
	|	РегистрСведений.НастройкиОбменаФСС КАК НастройкиОбменаФСС
	|ГДЕ
	|	НастройкиОбменаФСС.Организация = &ОрганизацияСсылка";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ОрганизацияСсылка", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ФлагСообщения = Ложь;
	ФлагАвтозаполнения = Истина;
	
	Если НЕ Выборка.Следующий() Тогда
		ФлагСообщения = Истина;
	Иначе
		Если НЕ Выборка.ИспользоватьАвтонастройку Тогда
			ФлагСообщения = Истина;
		КонецЕсли;
		Если Выборка.ИспользоватьОбмен И Выборка.СертификатСтрахователяОтпечаток = нрег(ОтпечатокСертификата)
			И Выборка.СертификатФССОтпечаток = СертификатФССОтпечаток
			И (НЕ ЗначениеЗаполнено(СертификатФССЭЛНОтпечаток) ИЛИ Выборка.СертификатФССЭЛНОтпечаток = СертификатФССЭЛНОтпечаток) Тогда
			ФлагСообщения = Ложь;
			ФлагАвтозаполнения = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураАвтонастройкиФСС = Новый Структура;
	СтруктураАвтонастройкиФСС.Вставить("ОтпечатокСертификата", 		нрег(ОтпечатокСертификата));
	СтруктураАвтонастройкиФСС.Вставить("СертификатФССОтпечаток", 	СертификатФССОтпечаток);
	СтруктураАвтонастройкиФСС.Вставить("СертификатФССЭЛНОтпечаток", СертификатФССЭЛНОтпечаток);
	СтруктураАвтонастройкиФСС.Вставить("ФлагСообщения", 			ФлагСообщения);
	СтруктураАвтонастройкиФСС.Вставить("ФлагАвтозаполнения", 		ФлагАвтозаполнения);
	
	Возврат СтруктураАвтонастройкиФСС;
	
КонецФункции

Функция ПараметрыРегистрацияОбновитьСправочники() Экспорт
	
	ПараметрыФункции = Новый Структура;
	ПараметрыФункции.Вставить("ИдентификаторАбонента");
	ПараметрыФункции.Вставить("СпецОператорСвязи");
	ПараметрыФункции.Вставить("ВременныйФайлОбновленийАдрес");
	ПараметрыФункции.Вставить("АдресВоВременномХранилище");
	ПараметрыФункции.Вставить("Организация");
	ПараметрыФункции.Вставить("ФайлИзКэша");
	ПараметрыФункции.Вставить("ТихийРежим");
	ПараметрыФункции.Вставить("РежимАвтонастройки");
	ПараметрыФункции.Вставить("ВызовИзМастераАвтонастройки");
	ПараметрыФункции.Вставить("СтруктураАвтонастройкиФСС");
	ПараметрыФункции.Вставить("СтруктураАвтонастройкиРПН");
	ПараметрыФункции.Вставить("СтруктураАвтонастройкиФТС");
	ПараметрыФункции.Вставить("ЭтоНоваяУчетнаяЗапись");
	ПараметрыФункции.Вставить("ВызовИзМастераПодключенияК1СОтчетности", Ложь);
	ПараметрыФункции.Вставить("ТекстОшибокДляМастераПодключенияК1СОтчетности", "");
	
	ПараметрыФункции.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса");
	ПараметрыФункции.Вставить("ТелефонМобильныйДляАвторизации");
	ПараметрыФункции.Вставить("ИдентификаторДокументооборота");
	
	ПараметрыФункции.Вставить("СохранениеВИБОтключено");
	ПараметрыФункции.Вставить("СтруктураДляИнформацииОСервереОнлайнПроверки");
	
	ПараметрыФункции.Вставить("НоваяУчетнаяЗапись");
	
	ПараметрыФункции.Вставить(
		"ОбязательныеПараметры",
		"ИдентификаторАбонента,СпецОператорСвязи,ВременныйФайлОбновленийАдрес,
		|АдресВоВременномХранилище,Организация,ФайлИзКэша,ТихийРежим,
		|РежимАвтонастройки,ВызовИзМастераАвтонастройки,СтруктураАвтонастройкиФСС,СтруктураАвтонастройкиРПН,СтруктураАвтонастройкиФТС,
		|ЭтоНоваяУчетнаяЗапись"); // обязательные параметры, которые нужно заполнять
	
	Возврат ПараметрыФункции;
	
КонецФункции

Функция РегистрацияОбновитьСправочники(ПараметрыФункции) Экспорт
	
	ВременныйКаталогНаСервере = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	ИмяВременногоФайлаОбновлений = ВременныйКаталогНаСервере + ПараметрыФункции.ИдентификаторАбонента + ".xml";
	ДвФайл = ПолучитьИзВременногоХранилища(ПараметрыФункции.ВременныйФайлОбновленийАдрес);
	ДвФайл.Записать(ИмяВременногоФайлаОбновлений);
	ДокументDOM = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ЗагрузитьФайлXML(ИмяВременногоФайлаОбновлений);
	
	Если НЕ ПараметрыФункции.ФайлИзКэша Тогда
		РегистрацияСобратьРасшифрованныйФайл(ДокументDOM, ПараметрыФункции.АдресВоВременномХранилище);
	КонецЕсли;
	
	ИдентификаторАбонента = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ДокументDOM,"ИдентификаторАбонента");
	ИдентификаторСпецоператора = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ДокументDOM,"ИдентификаторСпецоператора");
	ПараметрыФункции.ИдентификаторАбонента = Строка(ИдентификаторСпецоператора) + Строка(ИдентификаторАбонента);
	
	УчетнаяЗапись = РегистрацияПолучитьУчетнуюЗапись(ПараметрыФункции.ИдентификаторАбонента);
	ПараметрыФункции.ЭтоНоваяУчетнаяЗапись = НЕ ЗначениеЗаполнено(УчетнаяЗапись.Ссылка);
	
	Если ПараметрыФункции.Организация = Неопределено Тогда
		ПараметрыФункции.Организация = РегистрацияПолучитьОрганизацию(УчетнаяЗапись);
	КонецЕсли;
	
	Если ПараметрыФункции.ЭтоНоваяУчетнаяЗапись Тогда
		УчетнаяЗаписьСсылка = Справочники.УчетныеЗаписиДокументооборота.ПолучитьСсылку();
		УчетнаяЗапись.УстановитьСсылкуНового(УчетнаяЗаписьСсылка);
	Иначе
		УчетнаяЗаписьСсылка = УчетнаяЗапись.Ссылка;
	КонецЕсли;
		
	Если НЕ ПараметрыФункции.СохранениеВИБОтключено Тогда
		ВыводитьСообщения = НЕ (ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности или ПараметрыФункции.ТихийРежим ИЛИ ПараметрыФункции.РежимАвтонастройки);
		РегистрацияОбновитьСправочникПолучателей(ДокументDOM, ПараметрыФункции.Организация, ВыводитьСообщения, ПараметрыФункции.СтруктураАвтонастройкиФСС, ПараметрыФункции.СтруктураАвтонастройкиРПН, ПараметрыФункции.СтруктураАвтонастройкиФТС, УчетнаяЗаписьСсылка);
	КонецЕсли;
	
	Результат = РегистрацияОбновитьСправочникУчетныхЗаписей(
		УчетнаяЗапись, ДокументDOM, ПараметрыФункции.СпецОператорСвязи, 
		ПараметрыФункции.ЭтоНоваяУчетнаяЗапись, ПараметрыФункции.ТихийРежим, ПараметрыФункции.ВызовИзМастераАвтонастройки, 
		ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности, 
		ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности,
		ПараметрыФункции.ЭтоЭлектроннаяПодписьВМоделиСервиса,
		ПараметрыФункции.ТелефонМобильныйДляАвторизации,
		ПараметрыФункции.ИдентификаторДокументооборота,
		ПараметрыФункции.СохранениеВИБОтключено,
		ПараметрыФункции.СтруктураДляИнформацииОСервереОнлайнПроверки,
		ПараметрыФункции.Организация,
		ПараметрыФункции.НоваяУчетнаяЗапись);
		
	Если НЕ ПараметрыФункции.ФайлИзКэша Тогда
		ИмяФайла = ПолучитьИмяВременногоФайла();
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ИмяФайла);
		ЗаписьDOM = Новый ЗаписьDOM;
		ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
		ЗаписьXML.Закрыть();
		СохранитьВКэшеФайлНастроекСпецоператора(ПараметрыФункции.НоваяУчетнаяЗапись, ИмяФайла, XMLЗначение(Тип("Дата"),ДокументDOM.ПолучитьЭлементыПоИмени("РегистрационныйФайл")[0].Атрибуты.ПолучитьИменованныйЭлемент("ДатаВремяФормирования").Текстовоесодержимое));
		
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайла);
	КонецЕсли;
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВременныйКаталогНаСервере);
	
	Возврат Результат;
КонецФункции

Процедура СохранитьВКэшеФайлНастроекСпецоператора(УчетнаяЗапись, ИмяФайла, ДатаФайла)
	
	УчетнаяЗаписьСсылка = УчетнаяЗапись.Ссылка;
	Если НЕ ЗначениеЗаполнено(УчетнаяЗаписьСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ФайлыСведенийСпецоператоры.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УчетнаяЗапись = УчетнаяЗаписьСсылка;
	МенеджерЗаписи.ДатаФайла = ДатаФайла;
	
	Попытка
		МенеджерЗаписи.Размер = ОпределитьРазмер(ИмяФайла);
		МенеджерЗаписи.Данные = Новый ХранилищеЗначения(Новый ДвоичныеДанные(ИмяФайла), Новый СжатиеДанных);
		МенеджерЗаписи.Записать(Истина);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьСерверДокументооборотаПоСертификату(ОтпечатокСертификата)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СерверыДокументооборота.Ссылка
	|ИЗ
	|	Справочник.СерверыДокументооборота КАК СерверыДокументооборота
	|ГДЕ
	|	НЕ СерверыДокументооборота.ПометкаУдаления
	|	И СерверыДокументооборота.Сертификат = &Сертификат";
	Запрос.УстановитьПараметр("Сертификат", ОтпечатокСертификата);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции

Функция РегистрацияСоздатьСерверДокументооборота(Узел)
	
	ОтпечатокСертификата = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "Отпечаток");
	Если НЕ ЗначениеЗаполнено(ОтпечатокСертификата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СерверДокументооборотаСсылка = ПолучитьСерверДокументооборотаПоСертификату(ОтпечатокСертификата);
	Если ЗначениеЗаполнено(СерверДокументооборотаСсылка) Тогда
		НовыйОбъектСправочника = СерверДокументооборотаСсылка.ПолучитьОбъект();
	Иначе
		НовыйОбъектСправочника = Справочники.СерверыДокументооборота.СоздатьЭлемент();
		КонецЕсли;
	
	НовыйОбъектСправочника.Сертификат = ОтпечатокСертификата;
	НовыйОбъектСправочника.АдресЭлектроннойПочтыПФР  = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "АдресЭлектроннойПочтыПФР");
	НовыйОбъектСправочника.АдресЭлектроннойПочтыФНС  = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "АдресЭлектроннойПочтыФНС");
	НовыйОбъектСправочника.АдресЭлектроннойПочтыФСГС = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "АдресЭлектроннойПочтыФСГС");
	НовыйОбъектСправочника.ДлительностьОжиданияСервера = 100;
	НовыйОбъектСправочника.Наименование = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "Наименование");
	НовыйОбъектСправочника.Записать();
	
	Возврат НовыйОбъектСправочника.Ссылка;
	
КонецФункции

Функция РегистрацияПолучитьСерверОнлайнПроверки(Узел) Экспорт
	
	Если Узел = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОтпечатокСертификата = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "Отпечаток");
	Если НЕ ЗначениеЗаполнено(ОтпечатокСертификата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НаименованиеСервера = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "Наименование");
	
	ТипРеализацииСервера = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "ТипРеализации");
	
	УзелРесурса = ПолучитьЭлементУзлаXML(Узел, "Ресурс", 0);
	ПараметрыРесурса = Новый Структура("Определение, URIПространстваИменСервиса, ИмяСервиса, ИмяТочкиПодключения", "", "", "", "");
	ПараметрыРесурса.Определение = ПолучитьАтрибутУзлаXML(УзелРесурса, "Определение");
	ПараметрыРесурса.URIПространстваИменСервиса = ПолучитьАтрибутУзлаXML(УзелРесурса, "URIПространстваИменСервиса");
	ПараметрыРесурса.ИмяСервиса = ПолучитьАтрибутУзлаXML(УзелРесурса, "ИмяСервиса");
	ПараметрыРесурса.ИмяТочкиПодключения = ПолучитьАтрибутУзлаXML(УзелРесурса, "ИмяТочкиПодключения");
	
	Результат = Новый Структура("Наименование, ТипРеализации, Ресурс, Отпечаток", НаименованиеСервера, ТипРеализацииСервера, ПараметрыРесурса, ОтпечатокСертификата);
	
	Возврат Результат;
	
КонецФункции

Функция РегистрацияОбновитьСправочникУчетныхЗаписей(
		Запись, 
		ДокументDOM, 
		СпецОператорСвязи, 
		ЭтоНоваяУчетнаяЗапись, 
		ТихийРежим, 
		ВызовИзМастераАвтонастройки,
		ВызовИзМастераПодключенияК1СОтчетности = Ложь, 
		ТекстОшибокДляМастераПодключенияК1СОтчетности = "",
		ЭтоЭлектроннаяПодписьВМоделиСервиса = Ложь, 
		ТелефонМобильныйДляАвторизации = "", 
		ИдентификаторДокументооборота = "",
		СохранениеВИБОтключено = Ложь, 
		СтруктураДляИнформацииОСервереОнлайнПроверки = Неопределено, 
		Организация = Неопределено,
		НоваяУчетнаяЗапись = Неопределено) Экспорт
	
	Попытка
		
		Если НЕ ЭтоНоваяУчетнаяЗапись Тогда
			Запись = Запись.ПолучитьОбъект();
		КонецЕсли;
		
		Если Запись.ЭлектроннаяПодписьВМоделиСервиса <> ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
			Запись.ЭлектроннаяПодписьВМоделиСервиса = ЭтоЭлектроннаяПодписьВМоделиСервиса;
		КонецЕсли;
		Если СокрЛП(Запись.ТелефонМобильныйДляАвторизации) <> ТелефонМобильныйДляАвторизации Тогда
			Запись.ТелефонМобильныйДляАвторизации = ТелефонМобильныйДляАвторизации;
		КонецЕсли;
		Если СокрЛП(Запись.ИдентификаторДокументооборота) <> ИдентификаторДокументооборота Тогда
			Запись.ИдентификаторДокументооборота = ИдентификаторДокументооборота;
		КонецЕсли;
		
		Если Запись.СпецОператорСвязи <> СпецОператорСвязи Тогда
			Запись.СпецОператорСвязи = СпецОператорСвязи;
		КонецЕсли;
		
		ИдентификаторАбонента 		= ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ДокументDOM,"ИдентификаторАбонента");
		ИдентификаторСпецоператора  = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ДокументDOM,"ИдентификаторСпецоператора");
		ИдентификаторАбонента 		= Строка(ИдентификаторСпецоператора) + Строка(ИдентификаторАбонента);
		
		Если СокрЛП(Запись.ИдентификаторАбонента) <> ИдентификаторАбонента Тогда
			Запись.ИдентификаторАбонента = ИдентификаторАбонента;
		КонецЕсли;
		
		Если СокрЛП(Запись.ИдентификаторСпецоператора) <> ИдентификаторСпецоператора Тогда
			Запись.ИдентификаторСпецоператора = ИдентификаторСпецоператора;
		КонецЕсли;
		
		Если СокрЛП(Запись.АдресЭлектроннойПочты) <> ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ДокументDOM,"АдресЭлектроннойПочты") Тогда
			Запись.АдресЭлектроннойПочты = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ДокументDOM,"АдресЭлектроннойПочты");
		КонецЕсли;
		
		Значение = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ДокументDOM, "ПризнакУполномоченногоПредставителя", Ложь, , , Тип("Булево"));
		
		Если Запись.ЯвляетсяУчетнойЗаписьюУполномоченногоПредставителя <> Значение Тогда
			Запись.ЯвляетсяУчетнойЗаписьюУполномоченногоПредставителя = Значение;
		КонецЕсли;
		
		Если Запись.ЯвляетсяУчетнойЗаписьюУполномоченногоПредставителя Тогда
			
			Если СокрЛП(Запись.ПолноеНаименованиеУполномоченногоПредставителя) <> ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ДокументDOM,"ПолноеНаименование") Тогда
				Запись.ПолноеНаименованиеУполномоченногоПредставителя = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ДокументDOM,"ПолноеНаименование");
			КонецЕсли;
			
			Если СокрЛП(Запись.ИННУполномоченногоПредставителя) <> ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ДокументDOM,"ИНН") Тогда
				Запись.ИННУполномоченногоПредставителя  = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ДокументDOM,"ИНН");
			КонецЕсли;
			
			Если СокрЛП(Запись.КППУполномоченногоПредставителя) <> ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ДокументDOM,"КПП") Тогда
				Запись.КППУполномоченногоПредставителя  = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ДокументDOM,"КПП");
			КонецЕсли;
			
		КонецЕсли;
		
		ОтпечаткиСертификатовАбонентовФСРАР = МассивОтпечатковСертификатовАбонентовФСРАР(ДокументDOM);
		
		Узел = ДокументDOM.ПолучитьЭлементыПоИмени("ВладелецЭЦП")[0];
		ОтпечатокСертификата = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "Отпечаток", , ОтпечаткиСертификатовАбонентовФСРАР, Истина);
		
		Если СокрЛП(Запись.СертификатРуководителя) <> ОтпечатокСертификата Тогда
			Запись.СертификатРуководителя = ОтпечатокСертификата;
		КонецЕсли;
		
		Если СокрЛП(Запись.СертификатГлавногоБухгалтера) <> ОтпечатокСертификата Тогда
			Запись.СертификатГлавногоБухгалтера = ОтпечатокСертификата;
		КонецЕсли;
		
		Если СокрЛП(Запись.СертификатДляШифрования) <> ОтпечатокСертификата Тогда
			Запись.СертификатДляШифрования = ОтпечатокСертификата;
		КонецЕсли;
		
		Узел = ПолучитьЭлементУзлаXML(ДокументDOM, "СерверPOP3", 0);
		
		Если СокрЛП(Запись.СерверPOP3) <> ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел,"Адрес") Тогда
			Запись.СерверPOP3 = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел,"Адрес");
		КонецЕсли;
		
		ТекущийПортPOP3 = СокрЛП(Запись.ПортPOP3);
		
		Если ПустаяСтрока(ТекущийПортPOP3) ИЛИ ТекущийПортPOP3="0" Тогда
			
			Если ТекущийПортPOP3 <> ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел,"Порт",110) Тогда
				Запись.ПортPOP3 = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел,"Порт",110);
			КонецЕсли;
			
		КонецЕсли;
		
		Узел = ПолучитьЭлементУзлаXML(ДокументDOM, "POP3", 0);
		
		Если СокрЛП(Запись.ИмяПользователяPOP3) <> ПолучитьАтрибутУзлаXML(Узел, "ИмяПользователя") Тогда
			Запись.ИмяПользователяPOP3 = ПолучитьАтрибутУзлаXML(Узел, "ИмяПользователя");
		КонецЕсли;
		
		ПарольPOP3 = СокрЛП(ПолучитьАтрибутУзлаXML(Узел, "Пароль"));
		Если Запись.ПарольPOP3 <> ПарольPOP3 Тогда
			Запись.ПарольPOP3 = ПарольPOP3;
		КонецЕсли;
		
		Узел = ПолучитьЭлементУзлаXML(ДокументDOM, "СерверSMTP", 0);
		
		Если СокрЛП(Запись.СерверSMTP) <> ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел,"Адрес") Тогда
			Запись.СерверSMTP = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел,"Адрес");
		КонецЕсли;
		
		
		ТекущийПортSMTP = СокрЛП(Запись.ПортSMTP);
		
		Если ПустаяСтрока(ТекущийПортSMTP) ИЛИ ТекущийПортSMTP="0" Тогда
			
			Если ТекущийПортSMTP <> ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел,"Порт",25) Тогда
				Запись.ПортSMTP = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел,"Порт",25);
			КонецЕсли;
			
		КонецЕсли;
		
		Значение = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "ТребуетсяАвторизация", Ложь, , , Тип("Булево"));
		Если Запись.ТребуетсяSMTPАутентификация <> Значение Тогда
			Запись.ТребуетсяSMTPАутентификация = Значение;
		КонецЕсли;
		
		Если Запись.ТребуетсяSMTPАутентификация Тогда
			Узел = ПолучитьЭлементУзлаXML(ДокументDOM, "SMTP", 0);
			
			Если СокрЛП(Запись.ИмяПользователяSMTP) <> ПолучитьАтрибутУзлаXML(Узел, "ИмяПользователя") Тогда
				Запись.ИмяПользователяSMTP = ПолучитьАтрибутУзлаXML(Узел, "ИмяПользователя");
			КонецЕсли;
			
			Если СокрЛП(Запись.ПарольSMTP) <> ПолучитьАтрибутУзлаXML(Узел, "Пароль") Тогда
				Запись.ПарольSMTP = ПолучитьАтрибутУзлаXML(Узел, "Пароль");
			КонецЕсли;
			
		КонецЕсли;
		
		КодНалоговогоОрганаПолучателя = "";
		КодНалоговогоОргана = "";
		Если Организация <> Неопределено Тогда
			КодНалоговогоОрганаПолучателя = ?(Организация.КрупнейшийНалогоплательщик, Организация.КодНалоговогоОрганаПолучателя, "");
			КодНалоговогоОргана = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Организация, , "КодНО").КодНО;
		КонецЕсли;
		КодНалоговогоОрганаПолучателяНайденВОбновлении = Ложь;
		КодНалоговогоОрганаНайденВОбновлении = Ложь;
		ОсновнойКодНалоговогоОрганаВОбновлении = "";
		
		ФлагФНС  = Ложь;
		ФлагПФР  = Ложь;
		ФлагФСГС = Ложь;
		ОтпечатокФСС = "";
		
		Узлы = ДокументDOM.ПолучитьЭлементыПоИмени("Получатель");
		
		Для каждого Узел из Узлы Цикл
			Тип = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "ТипПолучателя");
			Если Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ФНС) Тогда
				Код = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "КодПолучателя");
				Если Не ФлагФНС Тогда
					ОсновнойКодНалоговогоОрганаВОбновлении = Код;
					
					ФлагФНС = Истина;
				КонецЕсли;
				Если НЕ КодНалоговогоОрганаПолучателяНайденВОбновлении И ЗначениеЗаполнено(КодНалоговогоОрганаПолучателя) И СокрЛП(Код) = СокрЛП(КодНалоговогоОрганаПолучателя) Тогда
					ОсновнойКодНалоговогоОрганаВОбновлении = Код;
					КодНалоговогоОрганаПолучателяНайденВОбновлении = Истина;
				ИначеЕсли НЕ КодНалоговогоОрганаПолучателяНайденВОбновлении И НЕ КодНалоговогоОрганаНайденВОбновлении И ЗначениеЗаполнено(КодНалоговогоОргана) И СокрЛП(Код) = СокрЛП(КодНалоговогоОргана) Тогда
					ОсновнойКодНалоговогоОрганаВОбновлении = Код;
					КодНалоговогоОрганаНайденВОбновлении = Истина;
				КонецЕсли;
			ИначеЕсли Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ПФР) Тогда
				ФлагПФР = Истина;
			ИначеЕсли Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ФСС) Тогда
				ОтпечатокФСС = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Узел, "Отпечаток");
			ИначеЕсли Тип = XMLСтрока(Перечисления.ТипыКонтролирующихОрганов.ФСГС) Тогда
				ФлагФСГС = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ОсновнойКодНалоговогоОрганаВОбновлении) Тогда
			Значение = Справочники.НалоговыеОрганы.НайтиПоКоду(ОсновнойКодНалоговогоОрганаВОбновлении);
			
			Если Запись.НалоговыйОрган <> Значение Тогда
				Запись.НалоговыйОрган = Значение;
			КонецЕсли;
		КонецЕсли;
		
		ИдентификаторСистемыОтправителяПФР = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ДокументDOM, "ИдентификаторСистемыОтправителяПФР");
		
		Если ФлагПФР И Не ПустаяСтрока(ИдентификаторСистемыОтправителяПФР) Тогда
			
			Если СокрЛП(Запись.ИдентификаторСистемыОтправителяПФР) <> ИдентификаторСистемыОтправителяПФР Тогда
				Запись.ИдентификаторСистемыОтправителяПФР = ИдентификаторСистемыОтправителяПФР;
			КонецЕсли;
			
		КонецЕсли;
		Если Запись.ПредназначенаДляДокументооборотаСФНС <> ФлагФНС Тогда
			Запись.ПредназначенаДляДокументооборотаСФНС = ФлагФНС;
		КонецЕсли;
		
		Если Запись.ПредназначенаДляДокументооборотаСПФР <> ФлагПФР Тогда
			Запись.ПредназначенаДляДокументооборотаСПФР = ФлагПФР;
		КонецЕсли;
		
		Если Запись.ПредназначенаДляДокументооборотаСФСГС <> ФлагФСГС Тогда
			Запись.ПредназначенаДляДокументооборотаСФСГС = ФлагФСГС;
		КонецЕсли;
		
		Значение = РегистрацияСоздатьСерверДокументооборота(ПолучитьЭлементУзлаXML(ДокументDOM, "СерверЭДО", 0));
		Если Запись.СерверДокументооборота <> Значение Тогда
			Запись.СерверДокументооборота = Значение;
		КонецЕсли;
		
		Если СтруктураДляИнформацииОСервереОнлайнПроверки <> Неопределено Тогда
			ПараметрыИнформацияОСервереОнлайнПроверки = РегистрацияПолучитьСерверОнлайнПроверки(ПолучитьЭлементУзлаXML(ДокументDOM, "СерверОнлайнПроверки", 0));
			Если ПараметрыИнформацияОСервереОнлайнПроверки <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(СтруктураДляИнформацииОСервереОнлайнПроверки, ПараметрыИнформацияОСервереОнлайнПроверки);
			КонецЕсли;
		КонецЕсли;
		
		//Выставляем только при первичном создании, если пользователь изменил значение то не меняем
		Если Запись.РежимАвтонастройки = Перечисления.РежимыАвтонастройкиУчетнойЗаписиНалогоплательщика.ПустаяСсылка() Тогда
			Запись.РежимАвтонастройки = Перечисления.РежимыАвтонастройкиУчетнойЗаписиНалогоплательщика.ВключенаВТихомРежиме;
		КонецЕсли;
		
		Если ЭтоНоваяУчетнаяЗапись Тогда
			ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьПараметрСпецоператора(Запись.СпецоператорСвязи, "ОнлайнПроверкаПризнак");
			Запись.ИспользоватьСервисОнлайнПроверкиОтчетов = (Запись.СпецоператорСвязи = Перечисления.СпецоператорыСвязи.Такском)
				ИЛИ (ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате <> Неопределено И Булево(ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате) = Истина);
		КонецЕсли;
		
		Если Запись.СтатусУчетнойЗаписи <> Перечисления.СтатусыУчетнойЗаписиДокументооборота.Активна Тогда
			Запись.СтатусУчетнойЗаписи = Перечисления.СтатусыУчетнойЗаписиДокументооборота.Активна;
		КонецЕсли;
		
		Если НЕ СохранениеВИБОтключено Тогда
			Если Запись.Модифицированность() Тогда
				УстановитьПривилегированныйРежим(Истина);
				Запись.Записать();
				МенеджерЗаписи = РегистрыСведений.ПользователиУчетныхЗаписейДокументооборота.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.УчетнаяЗапись = Запись.Ссылка;
				МенеджерЗаписи.Пользователь = Пользователи.ТекущийПользователь();
				МенеджерЗаписи.Записать();
				ДокументооборотСКОВызовСервера.УстановитьПараметрСеансаТекущиеУчетныеЗаписиНалогоплательщика();
				УстановитьПривилегированныйРежим(Ложь);
				НоваяУчетнаяЗапись = Запись.Ссылка;
				
				Если НЕ ТихийРежим Тогда
					Если ЭтоНоваяУчетнаяЗапись Тогда
							
						Если НЕ ВызовИзМастераПодключенияК1СОтчетности Тогда 
							Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'Создана новая учетная запись документооборота %1.
								|Ее можно посмотреть на вкладке ""Документооборот"" формы организации.';
								|en = 'New data interchange account %1 is created.
								|You can see it on the ""Data interchange"" tab of the company form.'"),
								НоваяУчетнаяЗапись);
							ДлительнаяОтправкаКлиентСервер.ВывестиПредупреждение(Сообщение);
						КонецЕсли;
						
					Иначе
							
						Если НЕ ВызовИзМастераПодключенияК1СОтчетности Тогда 
							Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обновлена учетная запись документооборота %1.';
																									|en = 'Account of data interchange %1 is updated.'"),НоваяУчетнаяЗапись);
							ДлительнаяОтправкаКлиентСервер.ВывестиПредупреждение(Сообщение);
						КонецЕсли;
						
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли ВызовИзМастераАвтонастройки Тогда
					
				Если НЕ ВызовИзМастераПодключенияК1СОтчетности Тогда 
					Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Найдена актуальная учетная запись документооборота %1.';
																							|en = 'Relevant account of the %1 data interchange is found.'"),НоваяУчетнаяЗапись);
					ДлительнаяОтправкаКлиентСервер.ВывестиПредупреждение(Сообщение);
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		НоваяУчетнаяЗапись = Запись.Ссылка;
		
		Возврат Истина;
		
	Исключение
		Если Не ТихийРежим Тогда
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка разбора файла с информацией о настройках учетной записи: %1.';
																			|en = 'An error occurred while parsing a file with information about account settings: %1.'"),ОписаниеОшибки()),
				ВызовИзМастераПодключенияК1СОтчетности,
				ТекстОшибокДляМастераПодключенияК1СОтчетности, 
				не ВызовИзМастераПодключенияК1СОтчетности);
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи() Экспорт
	
	ПараметрыФункции = Новый Структура;
	ПараметрыФункции.Вставить("УчетнаяЗаписьОрганизации");
	ПараметрыФункции.Вставить("ПараметрыСертификата", Неопределено);
	ПараметрыФункции.Вставить("ИдентификаторАбонента", "");
	ПараметрыФункции.Вставить("ВременныйФайлОбновленийАдрес", Неопределено);
	ПараметрыФункции.Вставить("ВызовИзМастераПодключенияК1СОтчетности", Ложь);
	ПараметрыФункции.Вставить("ТекстОшибокДляМастераПодключенияК1СОтчетности", "");
	
	Возврат ПараметрыФункции;
	
КонецФункции

Процедура СохранитьДополнительныеРеквизитыУчетнойЗаписи(ПараметрыФункции) Экспорт
	
	// ПараметрыФункции
	УчетнаяЗаписьОрганизации = ПараметрыФункции.УчетнаяЗаписьОрганизации;
	ИдентификаторАбонента = ПараметрыФункции.ИдентификаторАбонента;
	ВременныйФайлОбновленийАдрес = ПараметрыФункции.ВременныйФайлОбновленийАдрес;
	ВызовИзМастераПодключенияК1СОтчетности = ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности;
		
	Если НЕ ЗначениеЗаполнено(УчетнаяЗаписьОрганизации) Тогда
		Возврат;
	КонецЕсли;
		
	ДатаОбновления = ТекущаяДатаСеанса();
		
	ВременныйКаталогНаСервере = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	ИмяВременногоФайлаОбновлений = ВременныйКаталогНаСервере + ИдентификаторАбонента + ".xml";
	ДвФайл = ПолучитьИзВременногоХранилища(ВременныйФайлОбновленийАдрес);
	ДвФайл.Записать(ИмяВременногоФайлаОбновлений);
	ФайлАвтонастрокиВФорматеDOM = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ЗагрузитьФайлXML(ИмяВременногоФайлаОбновлений);
		
	Если ФайлАвтонастрокиВФорматеDOM = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВременныйКаталогНаСервере);
	
	// Если файл автонастройки в формате меньше, чем 1.3, то запись в регистр не выполняем
	РегистрационныйФайл = ФайлАвтонастрокиВФорматеDOM.ПолучитьЭлементыПоИмени("РегистрационныйФайл");
	Если ЗначениеЗаполнено(РегистрационныйФайл) Тогда
		АтрибутыУзлаРегистрационныйФайл = РегистрационныйФайл[0].Атрибуты;
		
		АтрибутВерсФорм = АтрибутыУзлаРегистрационныйФайл.ПолучитьИменованныйЭлемент("ВерсФорм");
		Если АтрибутВерсФорм <> Неопределено Тогда
			ВерсФорм = XMLЗначение(Тип("Число"), АтрибутВерсФорм.Значение);
			Если ВерсФорм < 1.3 Тогда
				ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(НСтр("ru = 'Файл автонастройки учетной записи имеет формат меньше 1.3';
																													|en = 'The format of automatic account setting file is less than 1.3 '"),
									ВызовИзМастераПодключенияК1СОтчетности,
									ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности,
									Ложь);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Прочитываем данные из регистра по учетной записи
	СсылкаНаУчетнуюЗапись =  УчетнаяЗаписьОрганизации.Ссылка;
	НаборЗаписейРегистра = РегистрыСведений.ДополнительныеРеквизитыУчетнойЗаписи.СоздатьНаборЗаписей();
	НаборЗаписейРегистра.Отбор.УчетнаяЗапись.Установить(СсылкаНаУчетнуюЗапись);
	НаборЗаписейРегистра.Прочитать();
	
	ОтпечатокСертификата = УчетнаяЗаписьОрганизации.СертификатРуководителя;
	ЗначенияСертификатаВзятыИзПрерыдущегоСостоянияРегистра = Ложь;
	
	НаборЗаписейРегистра.Очистить();
	
	НоваяЗаписьРегистра = НаборЗаписейРегистра.Добавить();
	НоваяЗаписьРегистра.УчетнаяЗапись = СсылкаНаУчетнуюЗапись;
	НоваяЗаписьРегистра.ОтпечатокСертификата = ОтпечатокСертификата;
	НоваяЗаписьРегистра.ДатаОбновления = ДатаОбновления;
	
	// ТипКриптопровайдера
	ИмяКриптопровайдера = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM, "ИмяКриптопровайдера");
	ТипКриптопровайдера = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM, "ТипКриптопровайдера");
	СвойстваКриптопровайдера = КриптографияЭДКОКлиентСервер.СвойстваКриптопровайдера(ИмяКриптопровайдера, ТипКриптопровайдера);
	Если СвойстваКриптопровайдера <> Неопределено Тогда
		НоваяЗаписьРегистра.ТипКриптопровайдера = СвойстваКриптопровайдера.ТипКриптопровайдера;
	КонецЕсли;
	
	// НомерОсновнойПоставки1с
	НоваяЗаписьРегистра.НомерОсновнойПоставки1с = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM,"НомерОсновнойПоставки1с");
	
	// КраткоеНаименование
	НоваяЗаписьРегистра.КраткоеНаименование = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM,"КраткоеНаименование");
	
	// ПолноеНаименование
	НоваяЗаписьРегистра.ПолноеНаименование = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM,"ПолноеНаименование");
	
	// ИНН
	НоваяЗаписьРегистра.ИНН = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM,"ИНН");
	
	// КПП
	НоваяЗаписьРегистра.КПП = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM,"КПП");
	
	// ОГРН
	НоваяЗаписьРегистра.ОГРН = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM,"ОГРН");
	
	// РегНомерПФР
	НоваяЗаписьРегистра.РегНомерПФР = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM,"РегНомерПФР");
	
	// Лицензия КриптоПро
	НоваяЗаписьРегистра.ЛицензияКриптоПроВключенаВСертификат = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM,"ЛицензияКриптоПроВключенаВСертификат");
	
	// ЭтоНотариусАдвокатИлиГКФХ
	НоваяЗаписьРегистра.ЭтоНотариусАдвокатИлиГКФХ = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM,"ПризнакФизическогоЛица");
	
	// ФИО владельца ЭЦП
	УзелФИО = ФайлАвтонастрокиВФорматеDOM.ПолучитьЭлементыПоИмени("ФИО");
	Если ЗначениеЗаполнено(УзелФИО) Тогда
		АтрибутыУзлаФИО = УзелФИО[0].Атрибуты;
		
		// ВладелецЭЦПФамилия
		ВладелецЭЦПФамилия = АтрибутыУзлаФИО.ПолучитьИменованныйЭлемент("Фамилия");
		Если ВладелецЭЦПФамилия <> Неопределено Тогда
			НоваяЗаписьРегистра.ВладелецЭЦПФамилия = ВладелецЭЦПФамилия.Значение;
		КонецЕсли;
		
		// ВладелецЭЦПИмя
		ВладелецЭЦПИмя = АтрибутыУзлаФИО.ПолучитьИменованныйЭлемент("Имя");
		Если ВладелецЭЦПИмя <> Неопределено Тогда
			НоваяЗаписьРегистра.ВладелецЭЦПИмя = ВладелецЭЦПИмя.Значение;
		КонецЕсли;
		
		// ВладелецЭЦПОтчество
		ВладелецЭЦПОтчество = АтрибутыУзлаФИО.ПолучитьИменованныйЭлемент("Отчество");
		Если ВладелецЭЦПОтчество <> Неопределено Тогда
			НоваяЗаписьРегистра.ВладелецЭЦПОтчество = ВладелецЭЦПОтчество.Значение;
		КонецЕсли;
			
	КонецЕсли;
	
	// ТелефонМобильный
	НоваяЗаписьРегистра.ТелефонМобильный = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM,"ТелефонМобильный");
	
	// ТелефонОсновной
	НоваяЗаписьРегистра.ТелефонОсновной = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM,"ТелефонОсновной");
	
	// ТелефонДополнительный
	НоваяЗаписьРегистра.ТелефонДополнительный = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM,"ТелефонДополнительный");
	
	// ЭлектроннаяПочта
	НоваяЗаписьРегистра.ЭлектроннаяПочта = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM, "ЭлектроннаяПочта");
	
	// ВладелецЭЦППодразделение
	НоваяЗаписьРегистра.ВладелецЭЦППодразделение = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM, "Подразделение");
		
	// ВладелецЭЦПСНИЛС
	НоваяЗаписьРегистра.ВладелецЭЦПСНИЛС = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM, "СНИЛС");
	
	// ВладелецЭЦПДолжность
	НоваяЗаписьРегистра.ВладелецЭЦПДолжность = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ФайлАвтонастрокиВФорматеDOM, "Должность");
	
	// обновляем информацию в регистре ДополнительныеРеквизитыУчетнойЗаписиПолучатели
	//
	НаборЗаписейНаправленийСдачи = РегистрыСведений.ДополнительныеРеквизитыУчетнойЗаписиПолучатели.СоздатьНаборЗаписей();
	НаборЗаписейНаправленийСдачи.Отбор.УчетнаяЗапись.Установить(СсылкаНаУчетнуюЗапись);
	НаборЗаписейНаправленийСдачи.Прочитать();
	НаборЗаписейНаправленийСдачи.Очистить();
	
	// Получатели - файл автонастроки
	Получатели = ФайлАвтонастрокиВФорматеDOM.ПолучитьЭлементыПоИмени("Получатель");
	
	ХарактеристикиНаправленийСдачи = Новый ТаблицаЗначений;
	
	ХарактеристикиНаправленийСдачи.Колонки.Добавить("УчетнаяЗапись");
	ХарактеристикиНаправленийСдачи.Колонки.Добавить("ТипПолучателя");
	ХарактеристикиНаправленийСдачи.Колонки.Добавить("КодПолучателя");
	ХарактеристикиНаправленийСдачи.Колонки.Добавить("КПП");
	ХарактеристикиНаправленийСдачи.Колонки.Добавить("ДатаОбновления");
	
	Для Каждого Получатель из Получатели Цикл
		
		Тип = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Получатель,"ТипПолучателя");
		Код = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(Получатель,"КодПолучателя");
		
		Если Тип = "ОИВ" Тогда
			НоваяЗаписьРегистра.КодРегионаФСРАР = Код;
		ИначеЕсли Тип = "ФНС" Тогда
			ПереченьКПП = Получатель.ПолучитьЭлементыПоИмени("КПП");
			
			Если ПереченьКПП.Количество() = 0 Тогда
				
				ТипПолучателя 	= Перечисления.ТипыКонтролирующихОрганов[Тип];
				КПППолучателя	= Неопределено;
				КодПолучателя 	= Код;
				
				СтруктураПоиска = Новый Структура;
				СтруктураПоиска.Вставить("ТипПолучателя", 	ТипПолучателя);
				СтруктураПоиска.Вставить("КПП", 			КПППолучателя);
				СтруктураПоиска.Вставить("КодПолучателя", 	КодПолучателя);
				
				Если ХарактеристикиНаправленийСдачи.НайтиСтроки(СтруктураПоиска).Количество() = 0 Тогда 
				
					НоваяСтрока = ХарактеристикиНаправленийСдачи.Добавить();
					
					НоваяСтрока.УчетнаяЗапись 	= СсылкаНаУчетнуюЗапись; 
					НоваяСтрока.ТипПолучателя 	= ТипПолучателя;
					НоваяСтрока.КПП 			= КПППолучателя;
					НоваяСтрока.КодПолучателя 	= Код;
					НоваяСтрока.ДатаОбновления 	= ДатаОбновления;
					
				КонецЕсли;
				
			Иначе
				
				Для каждого КПП Из ПереченьКПП Цикл
					
					ТипПолучателя 	= Перечисления.ТипыКонтролирующихОрганов[Тип];
					КПППолучателя	= XMLЗначение(Тип("Строка"), КПП.ТекстовоеСодержимое);
					КодПолучателя 	= Код;
					
					СтруктураПоиска = Новый Структура;
					СтруктураПоиска.Вставить("ТипПолучателя", 	ТипПолучателя);
					СтруктураПоиска.Вставить("КПП", 			КПППолучателя);
					СтруктураПоиска.Вставить("КодПолучателя", 	КодПолучателя);
					
					Если ХарактеристикиНаправленийСдачи.НайтиСтроки(СтруктураПоиска).Количество() = 0 Тогда 
					
						НоваяСтрока = ХарактеристикиНаправленийСдачи.Добавить();
						
						НоваяСтрока.УчетнаяЗапись 	= СсылкаНаУчетнуюЗапись; 
						НоваяСтрока.ТипПолучателя 	= ТипПолучателя;
						НоваяСтрока.КПП 			= КПППолучателя;
						НоваяСтрока.КодПолучателя 	= Код;
						НоваяСтрока.ДатаОбновления 	= ДатаОбновления;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		ИначеЕсли Тип <> "ЭЛН" Тогда
			
			Если Тип = "ПФР" И Получатель.ПолучитьЭлементыПоИмени("СхемаОтправкиМПД").Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ТипПолучателя 	= Перечисления.ТипыКонтролирующихОрганов[Тип];
			КПППолучателя	= Неопределено;
			КодПолучателя 	= Код;
			
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("ТипПолучателя", 	ТипПолучателя);
			СтруктураПоиска.Вставить("КПП", 			КПППолучателя);
			СтруктураПоиска.Вставить("КодПолучателя", 	КодПолучателя);
			
			Если ХарактеристикиНаправленийСдачи.НайтиСтроки(СтруктураПоиска).Количество() = 0 Тогда 
			
				НоваяСтрока = ХарактеристикиНаправленийСдачи.Добавить();
				
				НоваяСтрока.УчетнаяЗапись 	= СсылкаНаУчетнуюЗапись; 
				НоваяСтрока.ТипПолучателя 	= ТипПолучателя;
				НоваяСтрока.КПП 			= КПППолучателя;
				НоваяСтрока.КодПолучателя 	= Код;
				НоваяСтрока.ДатаОбновления 	= ДатаОбновления;
				
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;
	
	НаборЗаписейНаправленийСдачи.Загрузить(ХарактеристикиНаправленийСдачи);
	
	УчетнаяЗаписьОрганизацииОбъект = УчетнаяЗаписьОрганизации.ПолучитьОбъект();
	
	// Лицензия
	УзелЛицензия = ФайлАвтонастрокиВФорматеDOM.ПолучитьЭлементыПоИмени("Лицензия");
	Если ЗначениеЗаполнено(УзелЛицензия) Тогда
		АтрибутыУзлаЛицензия = УзелЛицензия[0].Атрибуты;
		
		// ЛицензияНаименование
		УчетнаяЗаписьОрганизацииОбъект.ЛицензияНаименование = АтрибутыУзлаЛицензия.ПолучитьИменованныйЭлемент("Наименование").Значение;
		
		// ЛицензияДатаНачала
		УчетнаяЗаписьОрганизацииОбъект.ЛицензияДатаНачала = XMLЗначение(Тип("Дата"), АтрибутыУзлаЛицензия.ПолучитьИменованныйЭлемент("ДатаНачала").Значение);
		
		// ЛицензияДатаОкончания
		УчетнаяЗаписьОрганизацииОбъект.ЛицензияДатаОкончания = XMLЗначение(Тип("Дата"), АтрибутыУзлаЛицензия.ПолучитьИменованныйЭлемент("ДатаОкончания").Значение);
		
		// ЛицензияТребуетсяНапоминаниеОбОкончанииСрокаДействия
		ИТС = АтрибутыУзлаЛицензия.ПолучитьИменованныйЭлемент("ИТС");
		Если ИТС <> Неопределено Тогда
			УчетнаяЗаписьОрганизацииОбъект.ЛицензияТребуетсяНапоминаниеОбОкончанииСрокаДействия = НЕ XMLЗначение(Тип("Булево"), ИТС.Значение);
		КонецЕсли;
	КонецЕсли;
	
	// Запись регистров и учетной записи
	НаборЗаписейРегистра.Записать();
	НаборЗаписейНаправленийСдачи.Записать();
	УчетнаяЗаписьОрганизацииОбъект.Записать();
			
КонецПроцедуры

//Методы веб сервиса для подачи заявления

Функция НачатьПроверкуТелефонаСМобильного(Ссылка, СообщениеОбОшибке) Экспорт
	
	ТелефонДляПаролей = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ТелефонМобильныйДляАвторизации");
	Если НЕ ЗначениеЗаполнено(ТелефонДляПаролей) Тогда
		СообщениеОбОшибке = НСтр("ru = 'Не указан номер телефона для авторизации.';
								|en = 'Phone number for authorization is not specified.'");
		Возврат "";
	КонецЕсли;
	
	//Подверждение номера телефона
	Результат = МенеджерСервисаКриптографии.ПолучитьКодПроверкиТелефона(ТелефонДляПаролей);
	Если Результат.Выполнено Тогда
		Возврат Результат.Идентификатор;
	Иначе
		СообщениеОбОшибке = Результат.ОписаниеОшибки;
		Возврат "";
	КонецЕсли;

КонецФункции

Функция ОтправитьЗаявлениеАбонентаСМобильного(Код, ИдентификаторПроверкиТелефона, Ссылка, СообщениеОбОшибке) Экспорт
	
	//Подверждение номера телефона
	Результат = МенеджерСервисаКриптографии.ПроверитьТелефонПоКоду(ИдентификаторПроверкиТелефона, Код);
	Если Результат.Выполнено Тогда
		
		//Получим регистрационный номер
		НомерОсновнойПоставки1с = "";
		АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор());
		ЭлектронныйДокументооборотСКонтролирующимиОрганами.КодРегистрацииПродуктаВМоделиСервиса(АдресХранилища);
		КодРегистрацииПродуктаСтруктура = ПолучитьИзВременногоХранилища(АдресХранилища);
		Если КодРегистрацииПродуктаСтруктура <> Неопределено И КодРегистрацииПродуктаСтруктура.Выполнено Тогда
			НомерОсновнойПоставки1с = КодРегистрацииПродуктаСтруктура.Результат;
		Иначе
			СообщениеОбОшибке = НСтр("ru = 'Не удалось получить регистрационный номер программы.';
									|en = 'Cannot receive registration number of the application.'");
			Возврат Ложь;
		КонецЕсли;
		
		//Запрос на подтверждение номера телефона
		ЗаявлениеОбъект = Ссылка.ПолучитьОбъект();
		ЗаявлениеОбъект.ИдентификаторПроверкиТелефонаДляПаролей = ИдентификаторПроверкиТелефона;
		ЗаявлениеОбъект.НомерОсновнойПоставки1с = НомерОсновнойПоставки1с;
		ЗаявлениеОбъект.Записать();
		
		//Отправка заявления спецоператору
		АлгоритмКонтейнераКлючей = ЗаявлениеОпределитьАлгоритмДляСозданияКонтейнераКлючей(Ссылка);
		Если АлгоритмКонтейнераКлючей = Неопределено Тогда
			СообщениеОбОшибке = ?(ЗначениеЗаполнено(Результат.ОписаниеОшибки), 
				Результат.ОписаниеОшибки, 
				НСтр("ru = 'Не удалось получить алгоритм генерации ключа, попробуйте позже.';
					|en = 'Cannot receive a key generation algorithm, please try later.'"));
			ЗаявлениеОбъект = Ссылка.ПолучитьОбъект();
			ЗаявлениеОбъект.ИдентификаторДокументооборота = СтрЗаменить(Новый УникальныйИдентификатор(), "-", "");
			ЗаявлениеОбъект.Записать();
			Возврат Ложь;
		КонецЕсли;
		Результат = ОбработкаЗаявленийАбонента.ВыгрузитьЗаявлениеАбонентаВМоделиСервиса(Ссылка, АлгоритмКонтейнераКлючей);
		Если Не Результат.Выполнено Тогда
			СообщениеОбОшибке = ?(ЗначениеЗаполнено(Результат.ОписаниеОшибки), 
				Результат.ОписаниеОшибки, 
				НСтр("ru = 'Не удалось передать заявление спецоператору, попробуйте позже.';
					|en = 'Cannot send the application to special provider. Try again later. '"));
			ЗаявлениеОбъект = Ссылка.ПолучитьОбъект();
			ЗаявлениеОбъект.ИдентификаторДокументооборота = СтрЗаменить(Новый УникальныйИдентификатор(), "-", "");
			ЗаявлениеОбъект.Записать();
		Иначе
			ЗаявлениеОбъект = Ссылка.ПолучитьОбъект();
			ЗаявлениеОбъект.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено;
			ЗаявлениеОбъект.Записать();
		КонецЕсли;
		Если Результат.Выполнено Тогда
			ОбработкаЗаявленийАбонентаВызовСервера.ВключитьОтслеживаниеИзмененияСтатусаЗаявления(Ссылка);
		КонецЕсли;
		Возврат Результат.Выполнено;
	Иначе
		СообщениеОбОшибке = Результат.ОписаниеОшибки;
		Возврат Ложь;
	КонецЕсли;

КонецФункции

Функция ЗаявлениеОпределитьАлгоритмДляСозданияКонтейнераКлючей(ДанныеОрганизации) Экспорт
	
	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Возврат КриптографияЭДКОКлиентСервер.АлгоритмПоУмолчанию();
	
КонецФункции

Функция ПроверитьСтатусЗаявленияСМобильного(Статус, СтатусКомментарий) Экспорт
	
	ЕстьОтправленныеЗаявления = ОбработкаЗаявленийАбонентаВызовСервера.ОтправленныеЗаявленияАбонентов().Количество() > 0;
	
	Если ЕстьОтправленныеЗаявления Тогда
		
		Заявление = ОбработкаЗаявленийАбонентаВызовСервера.СледующееЗаявлениеТребующееРеакцииПользователя();
		
		Если ЗначениеЗаполнено(Заявление) И ЗаявлениеАбонентаВМобильном(Заявление) Тогда
			
			РеквизитыДокумента = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(Заявление);
			Статус             = ОбщегоНазначения.ИмяЗначенияПеречисления(РеквизитыДокумента.Статус);
			СтатусКомментарий  = РеквизитыДокумента.СтатусКомментарий;
			
			Возврат Истина;
			
		КонецЕсли
		
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция НачатьНастройкуПодключенияСМобильного(ИдентификаторАбонента, ИдентификаторДокументооборота, ИдентификаторСертификата, СообщениеОбОшибке) Экспорт
	
	СообщениеОбОшибке = "";
	Заявление = ОбработкаЗаявленийАбонентаВызовСервера.СледующееЗаявлениеТребующееРеакцииПользователя();
	
	Если ЗначениеЗаполнено(Заявление) И ЗаявлениеАбонентаВМобильном(Заявление) Тогда
		
		РеквизитыДокумента     = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(Заявление);
		РезультатОтветаСервера = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьИРазобратьОтветНаЗаявление(Заявление, Истина);
		
		Если РеквизитыДокумента.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено
			И РезультатОтветаСервера.Выполнено И ЗначениеЗаполнено(РезультатОтветаСервера.ИдентификаторАбонента) Тогда
			
			ИдентификаторАбонента         = ВРег(РезультатОтветаСервера.ИдентификаторАбонента);
			ИдентификаторДокументооборота = РеквизитыДокумента.ИдентификаторДокументооборота;
			
			ПараметрыРегистрацияПолучитьДанныеССервера                                        = ПараметрыРегистрацияПолучитьДанныеССервера();
			ПараметрыРегистрацияПолучитьДанныеССервера.ИдентификаторАбонента                  = ИдентификаторАбонента;
			ПараметрыРегистрацияПолучитьДанныеССервера.СпецОператорСвязи                      = РеквизитыДокумента.СпецоператорСвязи;
			ПараметрыРегистрацияПолучитьДанныеССервера.ВызовИзМастераПодключенияК1СОтчетности = Истина;
			
			Сертификаты = Неопределено; // Будет инициализирована после загрузки сертификатов.
			Результат = РегистрацияПолучитьДанныеССервера(ПараметрыРегистрацияПолучитьДанныеССервера, Ложь, Сертификаты);
			Если НЕ Результат Тогда
				СообщениеОбОшибке = НСтр("ru = 'Не удалось получить настройки с сервиса спецоператора.';
										|en = 'Cannot receive settings from special provider service.'");
				Возврат Ложь;
			КонецЕсли;
			
			// Установка сертификатов
			ОтпечатокСертификата = Неопределено; // Будет загружен в процессе установки сертификатов.
			РезультатУстановкиСертификатов = РегистрацияУстановитьСертификаты(ОтпечатокСертификата, Сертификаты);
			Если НЕ РезультатУстановкиСертификатов Тогда
				СообщениеОбОшибке = НСтр("ru = 'Не удалось установить сертификат.';
										|en = 'Cannot install the certificate.'");
				Возврат Ложь;
			КонецЕсли;
			
			Сертификат = Новый Структура("Отпечаток", ОтпечатокСертификата);
			СвойстваСертификата = КриптографияЭДКО.НайтиСертификат(Сертификат);
			ИдентификаторСертификата = СвойстваСертификата.Идентификатор;
			
			//Запросить пароль
			
			// Чтобы в конфигурациях со старыми версиями БТС не возникали ошибки компиляции,
			// обращаемся к общему модулю через функцию БСП.
			// Для возможности отправки отчетов на стороне сервера из таких конфигураций потребуется обновить БТС до 1.0.17.
			МодульСервисКриптографии = ОбщегоНазначения.ОбщийМодуль("СервисКриптографии");
			МодульСервисКриптографии.ПолучитьВременныйПароль(ИдентификаторСертификата, Ложь, "phone");
			
			Возврат Истина;
			
		КонецЕсли;
	Иначе
		СообщениеОбОшибке = НСтр("ru = 'Заявление на подключение отклонено!';
								|en = 'Application for connection was rejected.'");
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ЗаявлениеДляЗавершенияНастройкиСМобильного(ИдентификаторДокументооборота)
	
	Если НЕ ПравоДоступа("Чтение", Метаданные.Документы.ЗаявлениеАбонентаСпецоператораСвязи) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ЗаявлениеАбонентаСпецоператораСвязи.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаявлениеАбонентаСпецоператораСвязи КАК ЗаявлениеАбонентаСпецоператораСвязи
	|ГДЕ
	|	ЗаявлениеАбонентаСпецоператораСвязи.Статус В (&Одобрено, &Отклонено)
	|	И ЗаявлениеАбонентаСпецоператораСвязи.ИдентификаторДокументооборота = &ИдентификаторДокументооборота
	|	И НЕ ЗаявлениеАбонентаСпецоператораСвязи.НастройкаЗавершена
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаявлениеАбонентаСпецоператораСвязи.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Одобрено", 		Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено);
	Запрос.УстановитьПараметр("Отклонено", 		Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено);
	Запрос.УстановитьПараметр("ИдентификаторДокументооборота", ИдентификаторДокументооборота);
	
	РезультатЗапроса 	= Запрос.Выполнить();
	Выборка 			= РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла;

	Возврат Неопределено;
	
КонецФункции

Функция ЗавершитьНастройкуПодключенияСМобильного(ИдентификаторАбонента, ИдентификаторДокументооборота, ИдентификаторСертификата, ВременныйПароль, СообщениеОбОшибке) Экспорт
	
	СообщениеОбОшибке = "";

	// Чтобы в конфигурациях со старыми версиями БТС не возникали ошибки компиляции,
	// обращаемся к общему модулю через функцию БСП.
	// Для возможности отправки отчетов на стороне сервера из таких конфигураций потребуется обновить БТС до 1.0.17.
	МодульСервисКриптографии = ОбщегоНазначения.ОбщийМодуль("СервисКриптографии");
	МодульСервисКриптографии.ПодтвердитьВременныйПароль(ИдентификаторСертификата, ВременныйПароль);
	
	Заявление = ЗаявлениеДляЗавершенияНастройкиСМобильного(ИдентификаторДокументооборота);
	Если ЗначениеЗаполнено(Заявление) И ЗаявлениеАбонентаВМобильном(Заявление) Тогда
		РеквизитыЗаявления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заявление, "Организация, ТелефонМобильныйДляАвторизации");
	Иначе
		РеквизитыЗаявления = Новый Структура("Организация, ТелефонМобильныйДляАвторизации", Неопределено, "");
	КонецЕсли;
	
	ПараметрыРегистрацияПолучитьДанныеССервера                                           = ПараметрыРегистрацияПолучитьДанныеССервера();
	ПараметрыРегистрацияПолучитьДанныеССервера.ИдентификаторАбонента                     = ИдентификаторАбонента;
	ПараметрыРегистрацияПолучитьДанныеССервера.СпецОператорСвязи                         = Перечисления.СпецоператорыСвязи.КалугаАстрал;
	ПараметрыРегистрацияПолучитьДанныеССервера.ВременныйФайлОбновленийАдрес              = Новый УникальныйИдентификатор;
	ПараметрыРегистрацияПолучитьДанныеССервера.ДанныеУзлаКонфиденциальнаяИнформацияАдрес = Новый УникальныйИдентификатор;
	ПараметрыРегистрацияПолучитьДанныеССервера.ВызовИзМастераПодключенияК1СОтчетности    = Истина;
	
	Сертификаты = Неопределено; // Будет инициализирована после загрузки сертификатов.
	Результат = РегистрацияПолучитьДанныеССервера(ПараметрыРегистрацияПолучитьДанныеССервера, Ложь, Сертификаты);
	Если НЕ Результат Тогда
		СообщениеОбОшибке = НСтр("ru = 'Не удалось получить настройки с сервиса спецоператора.';
								|en = 'Cannot receive settings from special provider service.'");
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ПараметрыРегистрацияПолучитьДанныеССервера.ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
	АдресВоВременномХранилище = ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
	
	// Расшифровка
	РасшифроватьPKCS7(ДанныеУзлаКонфиденциальнаяИнформацияАдрес, СообщениеОбОшибке);
	
	//Обновление справочников
	ПараметрыРегистрацияОбновитьСправочники = ПараметрыРегистрацияОбновитьСправочники();
	ЗаполнитьЗначенияСвойств(ПараметрыРегистрацияОбновитьСправочники, ПараметрыРегистрацияПолучитьДанныеССервера);
	ЗаполнитьЗначенияСвойств(ПараметрыРегистрацияОбновитьСправочники, РеквизитыЗаявления);
	
	ПараметрыРегистрацияОбновитьСправочники.ИдентификаторДокументооборота       = ИдентификаторДокументооборота;
	ПараметрыРегистрацияОбновитьСправочники.ЭтоЭлектроннаяПодписьВМоделиСервиса = Истина;
	ПараметрыРегистрацияОбновитьСправочники.ТихийРежим                          = Истина;
	ПараметрыРегистрацияОбновитьСправочники.РежимАвтонастройки                  = Истина;
	ПараметрыРегистрацияОбновитьСправочники.СохранениеВИБОтключено              = Ложь;
	
	ПараметрыРегистрацияОбновитьСправочники.АдресВоВременномХранилище           = АдресВоВременномХранилище;
	
	РезультатОбновленияСправочников = РегистрацияОбновитьСправочники(ПараметрыРегистрацияОбновитьСправочники);
	Если НЕ РезультатОбновленияСправочников Тогда
		СообщениеОбОшибке = НСтр("ru = 'Не удалось применить настройки.';
								|en = 'Cannot apply the settings.'");
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи = ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи();
	
	УчетнаяЗапись = РегистрацияПолучитьУчетнуюЗапись(ИдентификаторАбонента);
	ПараметрыУчетнойЗаписи = ?(НЕ ЗначениеЗаполнено(УчетнаяЗапись.Ссылка), ПараметрыРегистрацияОбновитьСправочники.НоваяУчетнаяЗапись, УчетнаяЗапись);
	//Получим свойства сертификата
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХранилищеСертификатов.Сертификат КАК Сертификат
	|ИЗ
	|	РегистрСведений.ХранилищеСертификатов КАК ХранилищеСертификатов
	|ГДЕ
	|	ХранилищеСертификатов.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторСертификата);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПараметрыСертификата = Выборка.Сертификат.Получить();
	Иначе
		СообщениеОбОшибке = НСтр("ru = 'Не найден установленный сертификат.';
								|en = 'The installed certificate is not found.'");
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи.УчетнаяЗаписьОрганизации 						= ПараметрыУчетнойЗаписи;
	ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи.ПараметрыСертификата 							= ПараметрыСертификата;
	ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи.ИдентификаторАбонента 							= ИдентификаторАбонента;
	ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи.ВременныйФайлОбновленийАдрес 					= ПараметрыРегистрацияОбновитьСправочники.ВременныйФайлОбновленийАдрес;
	ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи.ВызовИзМастераПодключенияК1СОтчетности 			= Истина;
	ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи.ТекстОшибокДляМастераПодключенияК1СОтчетности 	= "";
	
	СохранитьДополнительныеРеквизитыУчетнойЗаписи(ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи);
	
	СтруктураАвтонастройкиФСС = ПараметрыРегистрацияОбновитьСправочники.СтруктураАвтонастройкиФСС;
	Если СтруктураАвтонастройкиФСС <> Неопределено Тогда
		ОбновитьРегистрыСведенийНастройкиОбменаФСС(РеквизитыЗаявления.Организация,
						СтруктураАвтонастройкиФСС.ОтпечатокСертификата,
						СтруктураАвтонастройкиФСС.СертификатФССОтпечаток,
						СтруктураАвтонастройкиФСС.СертификатФССЭЛНОтпечаток,
						Ложь);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыУчетнойЗаписи) Тогда
		
		//Установим реквизиты заявления на подключение
		Если ЗначениеЗаполнено(Заявление) И ЗаявлениеАбонентаВМобильном(Заявление) Тогда
			РеквизитыДокументаДляЗаписи = Новый Структура;
			РеквизитыДокументаДляЗаписи.Вставить("УчетнаяЗапись", 		ПараметрыУчетнойЗаписи);
			РеквизитыДокументаДляЗаписи.Вставить("Статус",				Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено);
			РеквизитыДокументаДляЗаписи.Вставить("СтатусКомментарий",	"Создана учетная запись.");
			РеквизитыДокументаДляЗаписи.Вставить("НастройкаЗавершена", 	Истина);
			ОбработкаЗаявленийАбонентаВызовСервера.ОбновитьРеквизитыЗаявления(Заявление, РеквизитыДокументаДляЗаписи);
			
			//Запишем учетную запись в реквизиты организации
			Если ЗначениеЗаполнено(РеквизитыЗаявления.Организация) Тогда
				УстановитьПривилегированныйРежим(Истина);
				Объект = РеквизитыЗаявления.Организация.ПолучитьОбъект();
				Объект.УчетнаяЗаписьОбмена 				 = ПараметрыУчетнойЗаписи;
				Объект.ВидОбменаСКонтролирующимиОрганами = Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате;
				Объект.Записать();
				УстановитьПривилегированныйРежим(Ложь);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

Функция ЗаявлениеАбонентаВМобильном(Ссылка, Организация = Неопределено) Экспорт
	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить("Организация");
	МассивРеквизитов.Добавить("ПодписатьЭП");
	МассивРеквизитов.Добавить("ПризнакКрупнейшегоНалогоплательщика");
	МассивРеквизитов.Добавить("ПризнакОбособленногоПодразделения");
	МассивРеквизитов.Добавить("СпецоператорСвязи");
	МассивРеквизитов.Добавить("ТипЗаявления");
	МассивРеквизитов.Добавить("ЭлектроннаяПодписьВМоделиСервиса");
	
	РеквизитыЗаявления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, МассивРеквизитов);
	
	Если ЗначениеЗаполнено(Организация)
		И Организация <> РеквизитыЗаявления.Организация Тогда
		Возврат Ложь;
	ИначеЕсли РеквизитыЗаявления.ПодписатьЭП Тогда
		Возврат Ложь;
	ИначеЕсли РеквизитыЗаявления.ПризнакКрупнейшегоНалогоплательщика Тогда
		Возврат Ложь;
	ИначеЕсли РеквизитыЗаявления.ПризнакОбособленногоПодразделения Тогда
		Возврат Ложь;
	ИначеЕсли РеквизитыЗаявления.СпецоператорСвязи <> Перечисления.СпецоператорыСвязи.КалугаАстрал Тогда
		Возврат Ложь;
	ИначеЕсли РеквизитыЗаявления.ТипЗаявления <> Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Первичное Тогда
		Возврат Ложь;
	ИначеЕсли НЕ РеквизитыЗаявления.ЭлектроннаяПодписьВМоделиСервиса Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ОбновитьРегистрыСведенийНастройкиОбменаФСС(
		Организация,
		ОтпечатокСертификата,
		СертификатФССОтпечаток,
		СертификатФССЭЛНОтпечаток,
		ВыводитьСообщения) Экспорт
	
	Попытка
		ОбменФСС = РегистрыСведений.НастройкиОбменаФСС.СоздатьМенеджерЗаписи();
		ОбменФСС.Организация = Организация;
		ОбменФСС.Прочитать();
		ОбменФСС.Организация = Организация;
		ОбменФСС.ИспользоватьОбмен = Истина;
		ОбменФСС.СертификатСтрахователяОтпечаток = ОтпечатокСертификата;
		ОбменФСС.СертификатФССОтпечаток = СертификатФССОтпечаток;
		Если (ЗначениеЗаполнено(СертификатФССЭЛНОтпечаток) И НЕ ОбменФСС.ТестовыйСерверФССЭЛН)
			ИЛИ НЕ ЗначениеЗаполнено(ОбменФСС.СертификатФССЭЛНОтпечаток) Тогда
			ОбменФСС.СертификатФССЭЛНОтпечаток = СертификатФССЭЛНОтпечаток;
			ОбменФСС.ТестовыйСерверФССЭЛН = Ложь;
		КонецЕсли;
		ОбменФСС.ИспользоватьАвтонастройку = Истина;
		ОбменФСС.Записать();
		Если ВыводитьСообщения Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Обновлены параметры отправки отчетности в ФСС.';
																|en = 'Parameters of sending reporting to SSF are updated.'"));
		КонецЕсли;
		
	Исключение
		Если ВыводитьСообщения Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не удалось обновить параметры отправки отчетности в ФСС по причине:
				|%1';
				|en = 'Cannot update parameters of reporting sending to SSF due to:
				|%1'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьСтатусОтправкиЕдиничногоОбъекта(ДокументСсылка, Статус)
	
	МенеджерЗаписи = РегистрыСведений.СтатусыОтправки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = ДокументСсылка;
	МенеджерЗаписи.Статус = Статус;
	МенеджерЗаписи.Записать(Истина);
		
КонецПроцедуры

#КонецОбласти

#КонецОбласти

Функция ПорядковыйНомерСообщенияВЦиклеОбмена(ЦиклОбмена, Сообщение) Экспорт
	
	Если Сообщение = Неопределено Тогда
		Возврат 0;
	Иначе
		СоответствиеТипаСообщенияПорядку = СоответствиеТипаСообщенияПорядку(ЦиклОбмена);
		Возврат СоответствиеТипаСообщенияПорядку.Получить(Сообщение.Тип);
	КонецЕсли;
	
КонецФункции

Функция СоответствиеТипаСообщенияПорядку(ЦиклОбмена) Экспорт
	
	СоответствиеТипаСообщенияПорядку = Новый Соответствие;
	
	Если ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.НалоговаяИлиБухгалтерскаяОтчетность Тогда
		
		Если ЦиклОбмена.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСФНС.Приказ534 Тогда
			
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ДекларацияНП, 1);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ПодтверждениеДекларацияНО, 2);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеНП, 3);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеДекларацияНО, 4);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДекларацияНО, 5);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатПриемаНП, 6);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиДекларацияНО, 7);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатОбработкиНП, 8);
			
		КонецЕсли;
		
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Заявление Тогда
			
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ЗаявлениеНП, 						1);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ПодтверждениеЗаявлениеНО, 			2);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеНП, 			3);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеЗаявлениеНО, 				4);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.РезультатПриемаЗаявлениеНО, 		5);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатПриемаНП, 		6);
			
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗаявлениеНО, 	7);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатОбработкиНП, 	8);
			
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗаявлениеРФНО, 	7);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатОбработкиРФНП, 	8);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.СообщениеОбОтзывеЗаявлениеРФНО, 	9);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеОбОтзывеЗаявлениеРФНП, 	10);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗаявлениеТСНО, 	11);
			СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатОбработкиТСНП, 	12);
			
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Документ Тогда
		
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ДокументНО, 					1);
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеДокументНП, 			2);
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДокументНП, 	3);
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатПриемаНО, 	4);

	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Форма2НДФЛ Тогда
		
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.Форма2НДФЛНП, 1);
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ПодтверждениеФорма2НДФЛНО, 2);
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеНП, 3);
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеФорма2НДФЛНО, 4);
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.РезультатПриемаФорма2НДФЛНО, 5);
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатПриемаНП, 6);
		
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.НеформализованныеДокументыНалоговогоОргана Тогда
		
		//
		
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.НеформализованныеДокументыНалогоплательщика Тогда
		
		//
		
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.ЗапросыНаИнформационноеОбслуживание Тогда
		
		//
		
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.ОтчетностьПФР Тогда
		
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьПФР, 1);
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПолученияОтчетностиПФР, 2);
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ПротоколПФР, 3);
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ПротоколКвитанцияПФР, 4);
		
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.НеформализованнаяПерепискаПФРВходящие Тогда
		
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееПФР, 1);
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееКвитанцияПФР, 2);
		
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.РассылкаПФР Тогда		
		
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееПФР, 1);
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееКвитанцияПФР, 2);
		
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.НеформализованнаяПерепискаПФРИсходящие Тогда
		
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееПФР, 1);
		СоответствиеТипаСообщенияПорядку.Вставить(Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееКвитанцияПФР, 2);
		
