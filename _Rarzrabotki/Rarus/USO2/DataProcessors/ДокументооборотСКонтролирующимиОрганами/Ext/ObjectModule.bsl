	Контекст.Вставить("ОтложенныеКоманды", ОтложенныеКоманды);
	Контекст.Вставить("ДеревоДокументов", ПоместитьВоВременноеХранилище(ДеревоДокументов, Контекст.УникальныйИдентификатор));
	Контекст.Вставить("ФайлОписаниеПакета", ФайлОписаниеПакета);
	
	Возврат Истина;
	
КонецФункции

Процедура СформироватьПакетПФРПослеВыполненияОтложенныхКоманд(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть аналогичная процедура СформироватьПакетПФРПослеВыполненияОтложенныхКомандНаКлиенте(),
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если НЕ СформироватьПакетПФР_ЗаключительныеДействияНаСервере(КонтекстОтправки) Тогда // универсальная
		СообщениеОбОшибке = ТекстСообщенийПользователю();
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьОписаниеПакетаПФР(ОписаниеДокументов, UUIDПакета = Неопределено, ТипДокументооборота = "СведенияПФР", ТипТранзакции = "сведения", КодОтправителя = "", КодПолучателя = "", Знач КодСистемыОтправителя = Неопределено, типСКЗИ = Неопределено, ИдентификаторДляВременногоХранилища = Неопределено) Экспорт
	
	Если UUIDПакета = Неопределено Тогда
		UUIDПакета = СгенерироватьUUID();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КодСистемыОтправителя) Тогда
		КодСистемыОтправителя = "1С";
	КонецЕсли;
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	// добавляем узел "пакет"
	УзелПакет = ДобавитьУзелXML(Дерево, "пакет");
	ДобавитьУзелXML(УзелПакет, "версияФормата",							Истина, "1.2");
	ДобавитьУзелXML(УзелПакет, "типДокументооборота",					Истина, ТипДокументооборота);
	ДобавитьУзелXML(УзелПакет, "типТранзакции",							Истина, ТипТранзакции);
	ДобавитьУзелXML(УзелПакет, "идентификаторДокументооборота", 		Истина, UUIDПакета);
	
	// добавляем узел СКЗИ
	УзелСКЗИ = ДобавитьУзелXML(УзелПакет, "СКЗИ");
	ДобавитьУзелXML(УзелСКЗИ, "типСКЗИ",								Истина, ТипСКЗИ);
	
	// добавляем узел "отправитель"
	УзелОтправитель = ДобавитьУзелXML(УзелПакет, "отправитель");
	ДобавитьУзелXML(УзелОтправитель, "идентификаторСубъекта",			Истина, СокрЛП(КодОтправителя));
	ДобавитьУзелXML(УзелОтправитель, "типСубъекта",						Истина, "АбонентСЭД");
	
	// добавляем узел "системаОтправителя"
	УзелСистемаОтправителя = ДобавитьУзелXML(УзелПакет, "системаОтправителя");
	ДобавитьУзелXML(УзелСистемаОтправителя, "идентификаторСубъекта",	Истина, СокрЛП(КодСистемыОтправителя));
	ДобавитьУзелXML(УзелСистемаОтправителя, "типСубъекта",				Истина, "Провайдер");
	
	// добавляем узел "Получатель"
	УзелПолучатель = ДобавитьУзелXML(УзелПакет, "получатель");
	ДобавитьУзелXML(УзелПолучатель, "идентификаторСубъекта",			Истина, СокрЛП(КодПолучателя));
	ДобавитьУзелXML(УзелПолучатель, "типСубъекта",						Истина, "ОрганПФР");
	
	// Создадим контекст ЭДО один раз до начала цикла обхода, чтобы не тратить время на каждом шаге.
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	
	// добавляем узлы "Документ"
	Для Каждого СтрДокумент Из ОписаниеДокументов.Строки Цикл
		
		// добавляем очередной узел "Документ"
		УзелДокумент = ДобавитьУзелXML(УзелПакет, "документ");
		ДобавитьУзелXML(УзелДокумент, "типДокумента",					Истина, КонтекстЭДОСервер.ИдентификаторПоТипуДокументаПакета(СтрДокумент.ТипДокумента));
		ДобавитьУзелXML(УзелДокумент, "типСодержимого",					Истина, СтрДокумент.ТипСодержимого);
		ДобавитьУзелXML(УзелДокумент, "идентификаторДокумента",			Истина, СтрДокумент.ИдентификаторДокумента);
		ДобавитьУзелXML(УзелДокумент, "сжат",							Истина, XMLСтрока(СтрДокумент.Сжат = Истина));
		ДобавитьУзелXML(УзелДокумент, "зашифрован",						Истина, XMLСтрока(СтрДокумент.Зашифрован = Истина));
		
		// добавляем узел "Содержимое"
		Если ЗначениеЗаполнено(СтрДокумент.ИмяФайлаАрхива) Тогда
			УзелСодержимое = ДобавитьУзелXML(УзелДокумент, "содержимое");
			ДобавитьУзелXML(УзелСодержимое, "имяФайла",					Истина, СтрДокумент.ИмяФайлаАрхива);
		КонецЕсли;
		
		// добавляем подписи под документом
		Для Каждого СтрПодпись Из СтрДокумент.Строки Цикл
			
			// добавляем очередной узел "Подпись"
			УзелПодпись = ДобавитьУзелXML(УзелДокумент, "подпись");
			ДобавитьУзелXML(УзелПодпись, "имяФайла",					Истина, СтрПодпись.ИмяФайлаДокумента);
			ДобавитьУзелXML(УзелПодпись, "роль",						Истина, "руководитель");
			
		КонецЦикла;
		
	КонецЦикла;
	
	// формируем строку XML на основе дерева
	СтрокаXML = ВыгрузитьДеревоВXML_ПФР(Дерево);
	
	// записываем дерево в файл
	ПолноеИмяФайла = ПолучитьИмяВременногоФайла();
	РезультатЗаписи = ЗаписатьXMLВФайл(СтрокаXML, ПолноеИмяФайла);
	Если РезультатЗаписи = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// записываем двоичные данные файла во временное хранилище
	АдресВХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайла), ИдентификаторДляВременногоХранилища);
	
	Возврат АдресВХранилище;
	
КонецФункции

Функция СформироватьПакетПФР_ЗаключительныеДействияНаСервере(Контекст) Экспорт
	
	// получаем дерево документов
	ДеревоДокументов = ПолучитьИзВременногоХранилища(Контекст.ДеревоДокументов);
	
	// создаем каталог, в который будем помещать пакуемые файлы
	КаталогФайловОтчетности = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	
	// создаем файл пакета
	КороткоеИмяФайлаПакета = Контекст.КодОтправителя + "_" + Контекст.КодПолучателя + "_" + СгенерироватьUUID() + ".zip";
	ПолноеИмяФайлаПакета = ПолучитьКаталогВременныхФайлов() + КороткоеИмяФайлаПакета;
	
	// создаем архив
	ЗаписьZIP = Новый ЗаписьZipФайла(ПолноеИмяФайлаПакета); // для ПФР сжатие включено, для ФНС - нет

	// Создадим контекст ЭДО один раз до начала цикла обхода, чтобы не тратить время на каждом шаге.
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	
	// добавляем файла из дерева описания пакета
	Для Каждого СтрДокумент Из ДеревоДокументов.Строки Цикл
		ЗаписьZIP.Добавить(КонтекстЭДОСервер.ВыгрузитьФайлПакетаИзВременногоХранилищаВКаталог(КаталогФайловОтчетности, СтрДокумент));
		Для Каждого СтрДокумент2 Из СтрДокумент.Строки Цикл
			ЗаписьZIP.Добавить(КонтекстЭДОСервер.ВыгрузитьФайлПакетаИзВременногоХранилищаВКаталог(КаталогФайловОтчетности, СтрДокумент2));
		КонецЦикла;
	КонецЦикла;
	
	// добавляем само описание пакета
	ПолноеИмяФайлаОписанияПакета = КаталогФайловОтчетности + "packageDescription.xml";
	ПолучитьИзВременногоХранилища(Контекст.ФайлОписаниеПакета).Записать(ПолноеИмяФайлаОписанияПакета);
	ЗаписьZIP.Добавить(ПолноеИмяФайлаОписанияПакета);
	
	// добавляем подпись под описанием пакета
	ПолноеИмяФайлаПодписиПодФайломОписанияПакета = КаталогФайловОтчетности + "packageDescription.sign";
	ПолучитьИзВременногоХранилища(Контекст.ФайлПодписиПодФайломОписанияПакета).Записать(ПолноеИмяФайлаПодписиПодФайломОписанияПакета);
	ЗаписьZIP.Добавить(ПолноеИмяФайлаПодписиПодФайломОписанияПакета);
	
	// записываем архив
	ЗаписьZIP.Записать();
	
	// добавляем архив в регистр
	ДобавитьТранспортныйКонтейнер(Контекст.ТранспортноеСообщение, ПолноеИмяФайлаПакета, КороткоеИмяФайлаПакета);
	
	// удаляем временный каталог
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловОтчетности);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ПолноеИмяФайлаПакета);
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область ОтправкаМакетовПенсионныхДел

Функция СформироватьПакетМакетаПенсионногоДелаИЗаявления(КонтекстОтправки) Экспорт
	
	Если Не КонтекстОтправки.Настройки.Вложение.ТребуетсяАрхивирование Тогда
		Возврат Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение,
	|	СодержимоеТранспортныхКонтейнеров.ИмяФайла,
	|	СодержимоеТранспортныхКонтейнеров.Данные,
	|	СодержимоеТранспортныхКонтейнеров.ЭЦПИмяПодписанногоФайла КАК ИмяПодписанногоФайла,
	|	СодержимоеТранспортныхКонтейнеров.Тип
	|	, ВЫБОР
	|		КОГДА СостояниеОбъектов.Архивный ЕСТЬ NULL ТОГДА Ложь
	|		КОГДА СостояниеОбъектов.Архивный = Ложь ТОГДА Ложь
	|	ИНАЧЕ
	|		Истина
	|	КОНЕЦ ВАрхиве
	|ПОМЕСТИТЬ Приложения
	|ИЗ	
	|	РегистрСведений.СодержимоеТранспортныхКонтейнеров КАК СодержимоеТранспортныхКонтейнеров
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
	|			ПО 		(СостояниеОбъектов.Объект = СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение)
	|				И	(СостояниеОбъектов.ИмяФайла = СодержимоеТранспортныхКонтейнеров.ИмяФайла)
	|				И	(СостояниеОбъектов.Владелец = Значение(Перечисление.ВидыАрхивируемыхМетаданныхДО.СодержимоеТранспортныхКонтейнеров))
	|
	|ГДЕ
	|	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение = &ТранспортноеСообщение
	|	И СодержимоеТранспортныхКонтейнеров.Тип В (ЗНАЧЕНИЕ(Перечисление.ТипыСодержимогоТранспортногоКонтейнера.ПисьмоПриложение))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение,
	|	СодержимоеТранспортныхКонтейнеров.ИмяФайла,
	|	СодержимоеТранспортныхКонтейнеров.Данные,
	|	СодержимоеТранспортныхКонтейнеров.ЭЦПИмяПодписанногоФайла КАК ИмяПодписанногоФайла,
	|	СодержимоеТранспортныхКонтейнеров.Тип
	|	, ВЫБОР
	|		КОГДА СостояниеОбъектов.Архивный ЕСТЬ NULL ТОГДА Ложь
	|		КОГДА СостояниеОбъектов.Архивный = Ложь ТОГДА Ложь
	|	ИНАЧЕ
	|		Истина
	|	КОНЕЦ ВАрхиве
	|ПОМЕСТИТЬ Подписи
	|ИЗ
	|	РегистрСведений.СодержимоеТранспортныхКонтейнеров КАК СодержимоеТранспортныхКонтейнеров
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
	|			ПО 		(СостояниеОбъектов.Объект = СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение)
	|				И	(СостояниеОбъектов.ИмяФайла = СодержимоеТранспортныхКонтейнеров.ИмяФайла)
	|				И	(СостояниеОбъектов.Владелец = Значение(Перечисление.ВидыАрхивируемыхМетаданныхДО.СодержимоеТранспортныхКонтейнеров))
	|
	|ГДЕ
	|	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение = &ТранспортноеСообщение
	|	И СодержимоеТранспортныхКонтейнеров.Тип В (ЗНАЧЕНИЕ(Перечисление.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Подписи.ТранспортноеСообщение,
	|	Подписи.ИмяФайла КАК ИмяФайлаПодписи,
	|	Подписи.Данные КАК Подпись,
	|	Подписи.ИмяПодписанногоФайла КАК ИмяПодписанногоФайла,
	|	Приложения.ИмяФайла КАК ИмяФайлаПриложения,
	|	Приложения.Данные КАК Приложение
	|	, Приложения.ВАрхиве КАК ПриложениеВАрхиве
	|	, Подписи.ВАрхиве КАК ПодписьВАрхиве
	|ИЗ
	|	Приложения КАК Приложения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Подписи КАК Подписи
	|		ПО Приложения.ТранспортноеСообщение = Подписи.ТранспортноеСообщение
	|			И Приложения.ИмяФайла = Подписи.ИмяПодписанногоФайла";
	Запрос.УстановитьПараметр("ТранспортноеСообщение", КонтекстОтправки.ТранспортноеСообщение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ФайлыДляУдаления = Новый Массив;
	Файлы = Новый Массив;
	
	ВсегоВАрхиве = 0;
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПриложениеВАрхиве Или Выборка.ПодписьВАрхиве Тогда
			ВсегоВАрхиве = ВсегоВАрхиве + 1;
			Продолжить;
		КонецЕсли;
			
		ФайлыДляУдаления.Добавить(Выборка.ИмяФайлаПодписи);
		ФайлыДляУдаления.Добавить(Выборка.ИмяПодписанногоФайла);
				
		Файл = Новый Структура;
		Файл.Вставить("Имя", Выборка.ИмяПодписанногоФайла + ".sig");
		Файл.Вставить("ИмяФайла", Выборка.ИмяФайлаПодписи);
		Файл.Вставить("Данные", Выборка.Подпись.Получить());
		Файлы.Добавить(Файл);
		
		Файл = Новый Структура;
		Файл.Вставить("Имя", Выборка.ИмяПодписанногоФайла);
		Файл.Вставить("ИмяФайла", Выборка.ИмяФайлаПриложения);
		Файл.Вставить("Данные", Выборка.Приложение.Получить());
		Файлы.Добавить(Файл);
	КонецЦикла;
	
	Если ВсегоВАрхиве > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПрочитатьПрисоединенныеФайлы = Ложь;
	Для каждого Файл Из Файлы Цикл
		Если Файл.Данные = Неопределено Тогда
			ПрочитатьПрисоединенныеФайлы = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ПрочитатьПрисоединенныеФайлы Тогда
		ТаблицаФайлов = ОбщегоНазначенияЭДКО.ПрикрепленныеФайлыКОбъектуИзСправочника(
			КонтекстОтправки.ТранспортноеСообщение,
			"ТранспортноеСообщениеПрисоединенныеФайлы",
			,
			"ИсходноеИмяФайла");
		
		Для каждого СтрокаТаблицы Из ТаблицаФайлов Цикл
			СтрокаТаблицы.ИсходноеИмяФайла = ВРЕГ(СтрокаТаблицы.ИсходноеИмяФайла);
		КонецЦикла;
		
		Для каждого Файл Из Файлы Цикл
			Если Файл.Данные = Неопределено Тогда
				ИсходноеИмяФайла = ВРЕГ(Файл.ИмяФайла);
				
				СтрокаТаблицы = ТаблицаФайлов.Найти(ИсходноеИмяФайла, "ИсходноеИмяФайла");
				Если СтрокаТаблицы <> Неопределено Тогда
					Файл.Данные = РаботаСФайлами.ДвоичныеДанныеФайла(СтрокаТаблицы.Ссылка);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	НаборЗаписей = РегистрыСведений.СодержимоеТранспортныхКонтейнеров.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ТранспортноеСообщение.Установить(КонтекстОтправки.ТранспортноеСообщение);
	НаборЗаписей.Прочитать();
	
	ЗаписиДляУдаления = Новый Массив;
	ИменаПрисоединенныхФайловДляУдаления = Новый Массив;
	Для Каждого Запись Из НаборЗаписей Цикл
		Если ФайлыДляУдаления.Найти(Запись.ИмяФайла) <> Неопределено Тогда
			ЗаписиДляУдаления.Добавить(Запись);
			ИменаПрисоединенныхФайловДляУдаления.Добавить(Запись.ИмяФайла);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЗаписьДляУдаления Из ЗаписиДляУдаления Цикл
		НаборЗаписей.Удалить(ЗаписьДляУдаления);
	КонецЦикла;
	Если ПрочитатьПрисоединенныеФайлы Тогда
		Для каждого ИмяПрисоединенногоФайлаДляУдаления Из ИменаПрисоединенныхФайловДляУдаления Цикл
			ИсходноеИмяФайла = ВРЕГ(ИмяПрисоединенногоФайлаДляУдаления);
			
			СтрокаТаблицы = ТаблицаФайлов.Найти(ИсходноеИмяФайла, "ИсходноеИмяФайла");
			Если СтрокаТаблицы <> Неопределено Тогда
				ПрисоединенныйФайл = СтрокаТаблицы.Ссылка;
				ПрисоединенныйФайлОбъект = ПрисоединенныйФайл.ПолучитьОбъект();
				ПрисоединенныйФайлОбъект.УстановитьПометкуУдаления(Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	АдресПакета = ОперацииСФайламиЭДКОВызовСервера.УпаковатьФайлы(Файлы);
	
	ИмяПакета = КонтекстОтправки.Настройки.Вложение.Маска;
	Для Каждого КлючЗначение Из КонтекстОтправки.Настройки.ПараметрыЗаполнения Цикл
		ИмяПакета = СтрЗаменить(ИмяПакета, СтрШаблон("{%1}", КлючЗначение.Ключ), КлючЗначение.Значение);
	КонецЦикла;
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.ТранспортноеСообщение = КонтекстОтправки.ТранспортноеСообщение;
	НоваяЗапись.ИмяФайла = ИмяПакета;
	
	Пакет = ПолучитьИзВременногоХранилища(АдресПакета);
	НоваяЗапись.Тип = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПисьмоПриложение;
	НоваяЗапись.Размер = Пакет.Размер();
	Идентификатор = НРег(СтрЗаменить(Новый УникальныйИдентификатор, "-", ""));
	НоваяЗапись.Идентификатор = Идентификатор;
	НоваяЗапись.ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.Неизвестный;
	
	НаборЗаписей.Записать();
	
	КомпонентыИмениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ИмяПакета);
	УникальноеИмяФайлаБезРасширения = ОбщегоНазначенияЭДКОКлиентСервер.УникальнаяСтрока(КомпонентыИмениФайла.ИмяБезРасширения, 150);
	РасширениеФайлаБезТочки = Сред(КомпонентыИмениФайла.Расширение, 2);
	
	АдресФайла = ПоместитьВоВременноеХранилище(Пакет, Новый УникальныйИдентификатор);
	
	ИсходноеИмяФайла = ВРЕГ(ИмяПакета);
	
	СтрокаТаблицы = ТаблицаФайлов.Найти(ИсходноеИмяФайла, "ИсходноеИмяФайла");
	Если СтрокаТаблицы <> Неопределено Тогда
		ПрисоединенныйФайл = СтрокаТаблицы.Ссылка;
		ИнформацияОбОбновляемомФайле = Новый Структура;
		ИнформацияОбОбновляемомФайле.Вставить("АдресФайлаВоВременномХранилище", АдресФайла);
		ИнформацияОбОбновляемомФайле.Вставить("АдресВременногоХранилищаТекста", Неопределено);
		ИнформацияОбОбновляемомФайле.Вставить("ИмяБезРасширения", 				УникальноеИмяФайлаБезРасширения);
		ИнформацияОбОбновляемомФайле.Вставить("Расширение", 					РасширениеФайлаБезТочки);
		
		РаботаСФайлами.ОбновитьФайл(ПрисоединенныйФайл, ИнформацияОбОбновляемомФайле);
		
	Иначе
		ПараметрыФайла = Новый Структура;
		ПараметрыФайла.Вставить("Автор", 						Неопределено);
		ПараметрыФайла.Вставить("ВладелецФайлов", 				КонтекстОтправки.ТранспортноеСообщение);
		ПараметрыФайла.Вставить("ИмяБезРасширения", 			УникальноеИмяФайлаБезРасширения);
		ПараметрыФайла.Вставить("РасширениеБезТочки", 			РасширениеФайлаБезТочки);
		ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", 	Неопределено);
		
		НоваяСсылкаНаФайл = РаботаСФайлами.НоваяСсылкаНаФайл(КонтекстОтправки.ТранспортноеСообщение, "ТранспортноеСообщениеПрисоединенныеФайлы");
		ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресФайла,,, НоваяСсылкаНаФайл);
	КонецЕсли;
	
	ПрисоединенныйФайлОбъект = ПрисоединенныйФайл.ПолучитьОбъект();
	
	ПрисоединенныйФайлОбъект.Тип = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПисьмоПриложение;
	ПрисоединенныйФайлОбъект.Идентификатор = Идентификатор;
	ПрисоединенныйФайлОбъект.ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.Неизвестный;
	
	ПрисоединенныйФайлОбъект.ИсходноеИмяФайла = ИмяПакета;
	
	ПрисоединенныйФайлОбъект.Записать();
	
	ЗафиксироватьТранзакцию();
	УдалитьИзВременногоХранилища(АдресФайла);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьПараметрыОтправкиМакетовПенсионныхДелИЗаявления(ЦиклОбмена) Экспорт
	
	Документ = ЦиклОбмена.Предмет;
	
	ЭтоМакетПД   = ЭтоМакетПД(ЦиклОбмена);
	ЭтоЗаявление = ЭтоЗаявлениеОНазначенииПенсии(ЦиклОбмена);

	Если ЭтоМакетПД Тогда
		Настройки = РегистрыСведений.ПравилаОтправкиОтчетностиПоФизЛицам.ПолучитьНастройки(
			Документ.Отправитель,
			Документ.Получатель,
			Перечисления.ВидыОтчетностиПоФизЛицам.МакетПенсионныхДел);
	Иначе
		Настройки = РегистрыСведений.ПравилаОтправкиОтчетностиПоФизЛицам.ПолучитьНастройки(
			Документ.Отправитель, 
			Документ.Получатель,
			Перечисления.ВидыОтчетностиПоФизЛицам.ЗаявлениеОНазначенииИДоставкеПенсии);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Настройки) Тогда
		
		ТекстСообщения = НСтр("ru = 'Правила отправки документа для учетной записи ""%1"" и органа ПФР ""%2"" не заданы.
                               |Обратитесь в службу поддержки.';
                               |en = 'Rules of sending a document for the ""%1"" account and the ""%2"" PF authority are not specified.
                               |Contact technical support.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, Документ.Отправитель.УчетнаяЗаписьОбмена, Документ.Получатель);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("КодУПФР",                   СокрЛП(Документ.ОрганПФРПоМестуНазначенияПенсии));
	ПараметрыЗаполнения.Вставить("РегНомерПФР",               СокрЛП(Документ.Отправитель.РегистрационныйНомерПФР));
	
	Если ТипЗнч(Документ) = Тип("СправочникСсылка.МакетыПенсионныхДел") Тогда
		СНИЛС = Документ.СтраховойНомерПФР;
	Иначе
		СНИЛС = Документ.СНИЛС;
	КонецЕсли;
	
	ПараметрыЗаполнения.Вставить("СНИЛС",                     СокрЛП(СНИЛС));
	ПараметрыЗаполнения.Вставить("СНИЛСБезКонтрольногоЧисла", СокрЛП(Лев(СНИЛС, 11)));
	ПараметрыЗаполнения.Вставить("ДатаВыходаНаПенсию",        Формат(Документ.ДатаВыходаНаПенсию, "ДФ=yyyyMMdd"));
	ПараметрыЗаполнения.Вставить("Стаж",                      ?(Документ.Стаж = Перечисления.ВидыСтажаДляНазначенияПенсии.ЗаВыслугуЛет, "Л", "О"));
	ПараметрыЗаполнения.Вставить("КодРайона",                 Лев(Документ.ОрганПФРПоМестуНазначенияПенсии, 3));
	ПараметрыЗаполнения.Вставить("GUID",                      СтрЗаменить(Новый УникальныйИдентификатор, "-", ""));
	
	Настройки.Вставить("ПараметрыЗаполнения", ПараметрыЗаполнения);
	
	Возврат Настройки;
	
КонецФункции

Функция ЭтоМакетПД(ЦиклОбмена) Экспорт
	
	ЭтоМакет = Ложь;
	Если ЗначениеЗаполнено(ЦиклОбмена) И ТипЗнч(ЦиклОбмена.Предмет) = Тип("СправочникСсылка.МакетыПенсионныхДел") Тогда
		ЭтоМакет = Истина;
	КонецЕсли;
	
	Возврат ЭтоМакет;
		
КонецФункции

Функция ЭтоЗаявлениеОНазначенииПенсии(ЦиклОбмена) Экспорт
	
	ЭтоЗаявление = Ложь;
	Если ЗначениеЗаполнено(ЦиклОбмена) И ТипЗнч(ЦиклОбмена.Предмет) = Тип("СправочникСсылка.ЗаявлениеОНазначенииПенсии") Тогда
		ЭтоЗаявление = Истина;
	КонецЕсли;
	
	Возврат ЭтоЗаявление;
		
КонецФункции

#КонецОбласти

#Область ОтправкаИзвещений

Функция ПризнакАвтоматическогоФормированияПодтвержденийИТипСообщения(ОбъектСсылка, ПроанализироватьРассылкиПриАвтоподтверждении = Ложь) Экспорт
	
	ПоляОбъекта = Новый Структура();
	ПоляОбъекта.Вставить("УчетнаяЗапись", "УчетнаяЗапись");
	ПоляОбъекта.Вставить("Тип", "Тип");
	ПоляОбъекта.Вставить("НеФормироватьПодтвержденияАвтоматически", "УчетнаяЗапись.НеФормироватьПодтвержденияАвтоматически");
	
	РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектСсылка, ПоляОбъекта, Истина);

	Результат = Новый Структура();
	Результат.Вставить("ОписаниеОшибки", Неопределено);
	
	Если ТипЗнч(РеквизитыОбъекта.НеФормироватьПодтвержденияАвтоматически) = Тип("Булево") Тогда
		Результат.Вставить("УчетнаяЗапись",          РеквизитыОбъекта.УчетнаяЗапись);
		Результат.Вставить("Автоподтверждение",      НЕ РеквизитыОбъекта.НеФормироватьПодтвержденияАвтоматически);
		Результат.Вставить("Тип",                    РеквизитыОбъекта.Тип);
	Иначе
		Результат.ОписаниеОшибки = НСтр("ru = 'Текущий пользователь не имеет права использования учетной записи документооборота';
										|en = 'Current user is not authorized to use data interchange account'");
		Результат.Вставить("УчетнаяЗапись",          Неопределено);
		Результат.Вставить("Автоподтверждение",      Неопределено);
		Результат.Вставить("Тип",                    Неопределено);
	КонецЕсли;
	
	Результат.Вставить("ЭтоМассоваяРассылкаФНС", Ложь);
	Результат.Вставить("ЭтоРассылкаПФР",         Ложь);
	Результат.Вставить("ТребуетсяПодтверждение", Ложь);
	
	Если ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
		
		ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами.ПризнакАвтоматическогоФормированияПодтвержденийИТипСообщения()';
					|en = 'EDI with regulatory authorities.ПризнакАвтоматическогоФормированияПодтвержденийИТипСообщения()'"), 
				УровеньЖурналаРегистрации.Предупреждение,, ОбъектСсылка, Результат.ОписаниеОшибки);
				
		Возврат Результат;
	КонецЕсли;
	
	Если Результат.Автоподтверждение И ПроанализироватьРассылкиПриАвтоподтверждении Тогда
		Результат.ЭтоМассоваяРассылкаФНС = Результат.Тип = Перечисления.ТипыТранспортныхСообщений.РассылкаНО
			И ОбъектСсылка.ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Рассылка;
		
		Если Результат.Тип = Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееПФР Тогда
			Результат.ЭтоРассылкаПФР = ЭтоРассылкаПФР(ОбъектСсылка);
		КонецЕсли;
	КонецЕсли;
	
	Результат.ТребуетсяПодтверждение = СообщениеТребуетПодтверждения(
		Результат.Тип, Результат.ЭтоМассоваяРассылкаФНС, Результат.ЭтоРассылкаПФР);
	
	Возврат Результат;
	
КонецФункции

Функция СообщениеТребуетПодтверждения(ТипСообщения, ЭтоМассоваяРассылкаФНС, ЭтоРассылкаПФР)

	Если ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПротоколПФР
	 ИЛИ (ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееПФР И НЕ ЭтоРассылкаПФР)
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ОтветНаЗапросПФР
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеДекларацияНО
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДекларацияНО
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиДекларацияНО
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеФорма2НДФЛНО
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаФорма2НДФЛНО
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеОбращениеНО
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаОбращениеНО
	 
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПредставлениеНО
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаПредставлениеНО
	 
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоНО
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РассылкаНО И НЕ ЭтоМассоваяРассылкаФНС
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеЗапросНО
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаЗапросНО
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗапросНО 
	 //Заявление
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеЗаявлениеНО
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаЗаявлениеНО
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗаявлениеРФНО
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.СообщениеОбОтзывеЗаявлениеРФНО
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗаявлениеТСНО 
	 
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗаявлениеНО 
	 //Документ
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ДокументНО
	 //Росстат
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеДатыОтправкиФСГС
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПротоколВходногоКонтроляОтчетностиФСГС
	 ИЛИ ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееФСГС Тогда

		Возврат Истина;

	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция СоздатьПодтверждениеПриНеобходимости(СсылкаНаОбъект)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	СообщениеОбОшибке = "";
	
	Результат = ПризнакАвтоматическогоФормированияПодтвержденийИТипСообщения(СсылкаНаОбъект, Истина);
	Если НЕ Результат.Автоподтверждение Тогда
		Возврат Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
		Возврат Истина;
	КонецЕсли;
	
	// формируем подтверждение на расшифрованное сообщение при необходимости
	Если Результат.ТребуетсяПодтверждение Тогда
	 
		ОтветноеСообщение = СоздатьПодтверждение(СсылкаНаОбъект);
		
		// Создадим пакет для отправки подтвержения.
		Если ОтветноеСообщение <> Неопределено Тогда
			СформироватьПакет(ОтветноеСообщение.Ссылка, СообщениеОбОшибке);
		Иначе
			СообщениеОбОшибке = ТекстСообщенийПользователю();
		КонецЕсли;

	КонецЕсли;
	
	Возврат НЕ ЗначениеЗаполнено(СообщениеОбОшибке);
	
КонецФункции

Функция СоздатьПодтверждение(Основание)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	// создаем на сервере
	ОтветноеСообщение = СоздатьИЗаполнитьОтветноеСообщение(Основание);
	Если ОтветноеСообщение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КонтекстОтправки = Новый Структура("Подтверждение", ОтветноеСообщение.Ссылка);
	
	// различные действия на сервере в зависимости от типа сообщения
	ТипОснования = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЗначениеРеквизитаОбъекта(Основание, "Тип");
	Если ТипОснования = Перечисления.ТипыТранспортныхСообщений.ПротоколПФР Тогда
		
		ПодписатьСообщение("ПФР", КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Руководитель", ОтветноеСообщение.УчетнаяЗапись, Основание);
		
	ИначеЕсли ТипОснования = Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееПФР Тогда
		
		ПодписатьСообщение("ПФР", КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Руководитель", ОтветноеСообщение.УчетнаяЗапись, Основание);
		
	ИначеЕсли ТипОснования = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеДатыОтправкиФСГС Тогда
		
		ПодписатьСообщение("ФСГС", КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Руководитель", ОтветноеСообщение.УчетнаяЗапись, Основание);
	
	ИначеЕсли ТипОснования = Перечисления.ТипыТранспортныхСообщений.ПротоколВходногоКонтроляОтчетностиФСГС Тогда
		
		СформироватьИзвещениеОПолученииФСГС(ОтветноеСообщение.Ссылка);
