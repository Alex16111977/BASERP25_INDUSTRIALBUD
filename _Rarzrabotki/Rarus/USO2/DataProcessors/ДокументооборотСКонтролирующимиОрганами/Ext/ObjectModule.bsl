			ОтветHTTP = ПараметрыСоединения.СоединениеHTTP.ОтправитьДляОбработки(ИмяФайлаЗапроса, "/FtsStatFormEpExtWeb/Stat/List.aspx", ИмяФайлаОтвета, ЗаголовкиHTTP);
