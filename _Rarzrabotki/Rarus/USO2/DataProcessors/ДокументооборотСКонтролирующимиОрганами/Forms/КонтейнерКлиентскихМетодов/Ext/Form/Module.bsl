#Область ОтправкаЗапросаНаВыпискуИзЕГР

&НаКлиенте
Процедура ОтправкаЗапросаНаВыпискуИзЕГР(Док, Организация, ВыполняемоеОповещение) Экспорт
	
	Если НЕ ОбъектЗаполненКорректно(Док) Тогда
		Возврат;
	КонецЕсли;
	
	КонтекстДлительнойОперации = Новый Структура();
	КонтекстДлительнойОперации.Вставить("Док",                   Док);
	КонтекстДлительнойОперации.Вставить("Организация",           Организация);
	КонтекстДлительнойОперации.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаЗапросаНаВыпискуИзЕГР_ПослеНастройкиЗаявления", 
		ЭтотОбъект, 
		КонтекстДлительнойОперации);
		
	ЗавершитьНастройкуЗаявленияНаИзменение(Док, ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтправкаЗапросаНаВыпискуИзЕГР_ПослеНастройкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаЗапросаНаВыпискуИзЕГР_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ВходящийКонтекст.Док, ВходящийКонтекст.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЗапросаНаВыпискуИзЕГР_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		Возврат;
	КонецЕсли;
	
	Док = ВходящийКонтекст.Док;
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= Док;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 5;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= ВходящийКонтекст;

	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка выписки из ЕГРЮЛ
		Возврат;
	КонецЕсли;
		
	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаЗапросаНаВыпискуИзЕГР",  0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаЗапросаНаВыпискуИзЕГР() Экспорт
	
	КонтекстДлительнойОперации 	= ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	Док 	 = КонтекстДлительнойОперации.Док;
	Контекст = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(КонтекстДлительнойОперации);
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется настройка учетной записи...");

	ОписаниеОповещения = Новый ОписаниеОповещения("ОтправкаЗапросаНаВыпискуИзЕГРПослеАвтонастройкиУчетнойЗаписи", ЭтотОбъект, Контекст);
	ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(Док,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЗапросаНаВыпискуИзЕГР_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	Параметры_Док 					= ВходящийКонтекст.Док;
	Параметры_Организация 			= ВходящийКонтекст.Организация;
	Параметры_ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	ОтправкаЗапросаНаВыпискуИзЕГР(Параметры_Док, Параметры_Организация, Параметры_ВыполняемоеОповещение);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтправкаЗапросаНаВыпискуИзЕГРПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт
	
	Док = ВходящийКонтекст.Док;
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Запись данных...");
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("Документ", Док);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	
	// отражаем изменения в базе
	Если НЕ ОтправкаЗапросаНаВыпискуИзЕГР_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки) Тогда // сервер
		
		Если КонтекстОтправки.Свойство("ОтсутствуетУчетнаяЗапись") Тогда
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОтправкаЗапросаНаВыпискуИзЕГР_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ВходящийКонтекст);
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(Док, ОписаниеОповещения);
			Возврат;
			
		Иначе
		
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Док);
			
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ЕГРЮЛ
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Запись данных...");
	
	// формируем пакет
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ВыполняемоеОповещение);
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаЗапросаНаВыпискуИзЕГРПослеФормированияПакета", ЭтотОбъект, Контекст);
		
	Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "СОС");

КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЗапросаНаВыпискуИзЕГРПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("РезультатОтправки", 		КонтекстОтправки.Документ);
	
	Если Не Результат Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ЕГРЮЛ
		Возврат;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Отправка...");
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(КонтекстОтправки) Тогда // сервер
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ЕГРЮЛ
		Возврат;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ЕГРЮЛ
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправкаЗапросаНаВыпискуИзЕГР_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст)
	
	Док = Контекст.Документ;
	Если НЕ ЗначениеЗаполнено(Док) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбран документ для отправки';
								|en = 'Document for sending is not selected'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// проверяем, включен ли обмен по организации
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Док, "Организация");
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбрана организация-отправитель.';
								|en = 'The sender company is not selected.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);

		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем учетную запись документооборота
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);
		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем признак поддержки отправки запроса для оператора электронного документооборота
	СпецоператорСвязи = УчетнаяЗапись.СпецоператорСвязи;
	ПризнакПоддержкиЗапросаНаВыпискуЕГРЮЛ_ЕГРИП = Ложь;
	
	Если СпецоператорСвязи = Неопределено ИЛИ СпецоператорСвязи = Перечисления.СпецоператорыСвязи.ПустаяСсылка() Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Для учетной записи %1 не указан оператор электронного документооборота.
						|Отправка прервана!';
						|en = 'Electronic data interchange provider is not specified for account %1.
						|Sending is canceled.'"), Символ(34) + УчетнаяЗапись + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	Иначе
		ПризнакПоддержкиЗапросаНаВыпискуЕГРЮЛ_ЕГРИП = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьПараметрСпецоператора(СпецоператорСвязи, "ПризнакЗапросНаВыпискуИзЕГРЮЛ_ЕГРИП");
	КонецЕсли;
	
	Если ПризнакПоддержкиЗапросаНаВыпискуЕГРЮЛ_ЕГРИП = Неопределено ИЛИ НЕ ПризнакПоддержкиЗапросаНаВыпискуЕГРЮЛ_ЕГРИП Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Оператор электронного документооборота %1 не поддерживает отправку запроса на выписку из ЕГРЮЛ\ЕГРИП.
						|Отправка прервана!';
						|en = 'Electronic data interchange provider %1 does not support sending request for extract from USRLE/USRIE.
						|Sending aborted.'"), Символ(34) + СпецоператорСвязи + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// формируем файл с содержимым
	ДвоичныеДанныеФайлаЗапроса = Неопределено;
	РезультатФормированияФайлаЗапроса = СформироватьФайлЗапросаНаВыпискуИзЕдиногоГосударственногоРеестра(Док, ДвоичныеДанныеФайлаЗапроса, УчетнаяЗапись);
	Если НЕ РезультатФормированияФайлаЗапроса Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КороткоеИмяФайлаПисьма = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	
	НачатьТранзакцию();
	
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбмена.Наименование = "Запрос на выписку из ЕГРЮЛ/ЕГРИП по " + ПолучитьВидПараметраЗапроса(Док) + " " + Док.ПараметрЗапроса + " от " + Док.Организация + ".";
	ЦиклОбменаСсылка = Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаССОС;
	ЦиклОбмена.Предмет = Док;
	ЦиклОбмена.Идентификатор = СгенерироватьUUID();
	ЦиклОбмена.Организация = Организация;
	ЦиклОбмена.УчетнаяЗапись = УчетнаяЗапись;
	ЦиклОбмена.ВнешняяОрганизация = УчетнаяЗапись.СерверДокументооборота;
	ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.ЗапросНаВыпискуИзЕГРЮЛ_ЕГРИП;
	ЦиклОбмена.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСФНС.Приказ534;
	ЦиклОбмена.ДатаНачалаПериода = ТекущаяДатаСеанса();
	ЦиклОбмена.ДатаОкончанияПериода = ДобавитьМесяц(ЦиклОбмена.ДатаНачалаПериода, 1);
	ЦиклОбмена.ДатаЗакрытия = ПолучитьПустуюДатуЗавершенияЦиклаОбмена();
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена = ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ЗапросНаВыпискуЕРГЮЛ_ЕГРИП;
	ТранспортноеСообщение.Отправитель = Организация;
	ТранспортноеСообщение.Получатель = УчетнаяЗапись.СерверДокументооборота;
	ТранспортноеСообщение.УчетнаяЗапись = УчетнаяЗапись;
	ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Исходящее;
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Отправка прервана.';
															|en = 'Sending is canceled.'"));
			
		Возврат Ложь;
	КонецПопытки;

	// ДОБАВЛЯЕМ ВЛОЖЕНИЯ
	
	// добавляем запрос
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЗапросНаВыпискуИзЕГРЮЛ_ЕГРИП, ДвоичныеДанныеФайлаЗапроса, "Запрос.xml", , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml) Тогда
		ОтменитьТранзакцию();
		ТекстСообщения = НСтр("ru = 'Отправка запроса прервана.';
								|en = 'Request sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
		
	// записываем цикл обмена
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ОтменитьТранзакцию();
		ТекстСообщения = НСтр("ru = 'Отправка запроса прервана.';
								|en = 'Request sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	// изменяем статус отправки
	ЗаписатьСтатусОтправкиОбъекта(Док, Перечисления.СтатусыОтправки.ВКонверте);
	
	ЗафиксироватьТранзакцию();
	
	Контекст.Вставить("Организация", Организация);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

&НаСервереБезКонтекста
Функция СформироватьФайлЗапросаНаВыпискуИзЕдиногоГосударственногоРеестра(Запрос, ДвоичныеДанныеФайлаЗапроса, УчетнаяЗапись)
	
	ВремФайл = ПолучитьИмяВременногоФайла();
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ВремФайл,"windows-1251");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Запрос");
	ЗаписьXML.ЗаписатьАтрибут("ВерсФорм","1.0");
	ЗаписьXML.ЗаписатьАтрибут("ДатаВремяФормирования", XMLСтрока(ТекущаяДатаСеанса()));
	ЗаписьXML.ЗаписатьАтрибут("ВерсПрог", РегламентированнаяОтчетность.НазваниеИВерсияПрограммы());
	ЗаписатьУзелXML(ЗаписьXML,"ИдентификаторАбонента", XMLСтрока(УчетнаяЗапись.ИдентификаторАбонента));
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ЗапрашиваемаяИнформация");
	
	Если Запрос.ВидПараметраЗапроса = Перечисления.ВидыПараметровЗапросаНаВыпискуИзЕГРЮЛ_ЕГРИП.ОГРН Тогда
		ЗаписьXML.ЗаписатьАтрибут("ОГРН", XMLСтрока(Запрос.ПараметрЗапроса));
	ИначеЕсли Запрос.ВидПараметраЗапроса = Перечисления.ВидыПараметровЗапросаНаВыпискуИзЕГРЮЛ_ЕГРИП.ИНН Тогда
		ЗаписьXML.ЗаписатьАтрибут("ИНН", XMLСтрока(Запрос.ПараметрЗапроса));
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.Закрыть();
	
	// считываем двоичные данные файла запроса, после чего удаляем файл
	ДвоичныеДанныеФайлаЗапроса = Новый ДвоичныеДанные(ВремФайл);
	УдалитьФайлы(ВремФайл);
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьПакетСОС_ЗаключительныеДействияНаСервере(Контекст)
	
	ДеревоДокументов = ПолучитьИзВременногоХранилища(Контекст.ДеревоДокументов);
	
	//////////////////////////////////////////////////////////////////////////////
	// ФОРМИРОВАНИЕ ФАЙЛА ОПИСАНИЯ ПАКЕТА
	
	// формируем
	ФайлОписаниеПакета = СформироватьОписаниеПакетаСОС(ДеревоДокументов,
														Контекст.UUIDПакета,
														Контекст.КодТипаДокументооборота,
														Контекст.НаименованиеТипаДокументооборота,
														Контекст.КодТипаТранзакции,
														Контекст.НаименованиеТипаТранзакции,
														Контекст.КодОтправителя,
														Контекст.КодСпецоператора,
														Контекст.КодПолучателя,
														Контекст.ТипПолучателя,
														Контекст.УникальныйИдентификатор);
	Если ФайлОписаниеПакета = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////////////////////
	// СОЗДАНИЕ АРХИВА ПАКЕТА
	
	КаталогФайловОтчетности = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	
	КороткоеИмяФайлаАрхива = "SOS_" +
							Контекст.КодОтправителя + "_" +
							Контекст.КодПолучателя + "_" +
							СгенерироватьUUID() + "_" + 
							Контекст.КодТипаДокументооборота + "_" +
							Контекст.КодТипаТранзакции + "_" +
							Контекст.КодТипаОсновногоДокумента +
							".zip";
	ПолноеИмяФайлаАрхива = ПолучитьКаталогВременныхФайлов() + КороткоеИмяФайлаАрхива;
	
	ЗаписьZIP = Новый ЗаписьZipФайла(ПолноеИмяФайлаАрхива, , , МетодСжатияZIP.Копирование); // архив пакета создается без сжатия

	// Создадим контекст ЭДО один раз до начала цикла обхода, чтобы не тратить время на каждом шаге.
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	
	Для Каждого СтрДокумент Из ДеревоДокументов.Строки Цикл
		
		ПолноеИмяФайлаПакета = КонтекстЭДОСервер.ВыгрузитьФайлПакетаИзВременногоХранилищаВКаталог(КаталогФайловОтчетности, СтрДокумент);
		ЗаписьZIP.Добавить(ПолноеИмяФайлаПакета);
		
		Для Каждого СтрДокумент2 Из СтрДокумент.Строки Цикл
			ПолноеИмяФайлаПакета = КонтекстЭДОСервер.ВыгрузитьФайлПакетаИзВременногоХранилищаВКаталог(КаталогФайловОтчетности, СтрДокумент2);
			ЗаписьZIP.Добавить(ПолноеИмяФайлаПакета);
		КонецЦикла;
		
	КонецЦикла;
	
	// добавляем описание пакета
	ПолноеИмяФайлаОписанияПакета = КаталогФайловОтчетности + "packageDescription.xml";
	ПолучитьИзВременногоХранилища(ФайлОписаниеПакета).Записать(ПолноеИмяФайлаОписанияПакета);
	ЗаписьZIP.Добавить(ПолноеИмяФайлаОписанияПакета);
	
	ЗаписьZIP.Записать();
	
	//////////////////////////////////////////////////////////////////////////////
	// ДОБАВЛЕНИЕ ПАКЕТА В РЕГИСТР КОНТЕЙНЕРОВ
	
	ДобавитьТранспортныйКонтейнер(Контекст.ТранспортноеСообщение, ПолноеИмяФайлаАрхива, КороткоеИмяФайлаАрхива);
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловОтчетности);
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьОписаниеПакетаСОС(ОписаниеДокументов, UUIDПакета = Неопределено, КодТипаДокументоооборота = "01", ТипДокументооборота = "Декларация", КодТипаТранзакции = "01", ТипТранзакции = "ДекларацияНП", КодОтправителя = "", КодСОС = Неопределено, КодПолучателя = "", ТипПолучателя = "налоговыйОрган", ИдентификаторДляВременногоХранилища = Неопределено) Экспорт
	
	Если UUIDПакета = Неопределено Тогда
		UUIDПакета = СгенерироватьUUID();
	КонецЕсли;
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	// добавляем узел "ТрансИнф"
	УзелТрансИнф = ДобавитьУзелXML(Дерево, "ТрансИнф");
	ДобавитьУзелXML(УзелТрансИнф, "версияФормата",							Истина, "СОС:1.0");
	ДобавитьУзелXML(УзелТрансИнф, "кодТипаДокументооборота",				Истина, КодТипаДокументоооборота);
	ДобавитьУзелXML(УзелТрансИнф, "типДокументооборота",					Истина, ТипДокументооборота);
	ДобавитьУзелXML(УзелТрансИнф, "кодТипаТранзакции",						Истина, КодТипаТранзакции);
	ДобавитьУзелXML(УзелТрансИнф, "типТранзакции",							Истина, ТипТранзакции);
	ДобавитьУзелXML(УзелТрансИнф, "идентификаторДокументооборота", 			Истина, UUIDПакета);
	ДобавитьУзелXML(УзелТрансИнф, "ВерсПрог", 								Истина, СокрЛП(Лев(РегламентированнаяОтчетность.НазваниеИВерсияПрограммы(), 40)));
	
	// добавляем узел "отправитель"
	УзелОтправитель = ДобавитьУзелXML(УзелТрансИнф, "отправитель");
	ДобавитьУзелXML(УзелОтправитель, "идентификаторСубъекта",				Истина, КодОтправителя);
	ДобавитьУзелXML(УзелОтправитель, "типСубъекта",							Истина, "абонент");
	
	// добавляем узел "спецоператор"
	Если КодСОС <> Неопределено Тогда
		УзелСпецоператор = ДобавитьУзелXML(УзелТрансИнф, "спецоператор");
		ДобавитьУзелXML(УзелСпецоператор, "идентификаторСубъекта",			Истина, КодСОС);
		ДобавитьУзелXML(УзелСпецоператор, "типСубъекта",					Истина, "спецоператор");
	КонецЕсли;
	
	// добавляем узел "получатель"
	УзелПолучатель = ДобавитьУзелXML(УзелТрансИнф, "получатель");
	ДобавитьУзелXML(УзелПолучатель, "идентификаторСубъекта",				Истина, КодПолучателя);
	ДобавитьУзелXML(УзелПолучатель, "типСубъекта",							Истина, ТипПолучателя);

	// Создадим контекст ЭДО один раз до начала цикла обхода, чтобы не тратить время на каждом шаге.
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	
	// добавляем узлы "Документ"
	Для Каждого СтрДокумент Из ОписаниеДокументов.Строки Цикл
		
		// добавляем очередной узел "Документ"
		УзелДокумент = ДобавитьУзелXML(УзелТрансИнф, "документ");
		ДобавитьУзелXML(УзелДокумент, "кодТипаДокумента",				Истина, КонтекстЭДОСервер.КодПоТипуДокументаПакета(СтрДокумент.ТипДокумента, КодТипаДокументоооборота));
		ДобавитьУзелXML(УзелДокумент, "типДокумента",					Истина, КонтекстЭДОСервер.ИдентификаторПоТипуДокументаПакета(СтрДокумент.ТипДокумента));
		ДобавитьУзелXML(УзелДокумент, "типСодержимого",					Истина, СтрДокумент.ТипСодержимого);
		ДобавитьУзелXML(УзелДокумент, "сжат",							Истина, XMLСтрока(СтрДокумент.Сжат = Истина));
		ДобавитьУзелXML(УзелДокумент, "зашифрован",						Истина, XMLСтрока(СтрДокумент.Зашифрован = Истина));
		ДобавитьУзелXML(УзелДокумент, "идентификаторДокумента",			Истина, СтрДокумент.ИдентификаторДокумента);
		ДобавитьУзелXML(УзелДокумент, "исходноеИмяФайла",				Истина, СтрДокумент.ИмяФайлаДокумента);
		
		// добавляем узел "Содержимое"
		Если ЗначениеЗаполнено(СтрДокумент.ИмяФайлаАрхива) Тогда
			УзелСодержимое = ДобавитьУзелXML(УзелДокумент, "содержимое");
			ДобавитьУзелXML(УзелСодержимое, "имяФайла",					Истина, СтрДокумент.ИмяФайлаАрхива);
		КонецЕсли;
		
		// добавляем подписи под документом
		Для Каждого СтрПодпись Из СтрДокумент.Строки Цикл
			
			// добавляем очередной узел "Подпись"
			УзелПодпись = ДобавитьУзелXML(УзелДокумент, "подпись");
			ДобавитьУзелXML(УзелПодпись, "имяФайла",					Истина, СтрПодпись.ИмяФайлаДокумента);
			ДобавитьУзелXML(УзелПодпись, "роль",						Истина, "абонент");
			
		КонецЦикла;
		
	КонецЦикла;
	
	// формируем строку XML на основе дерева
	СтрокаXML = ВыгрузитьДеревоВXML_ПФР(Дерево);
	
	// записываем дерево в файл
	ПолноеИмяФайла = ПолучитьИмяВременногоФайла();
	РезультатЗаписи = ЗаписатьXMLВФайл(СтрокаXML, ПолноеИмяФайла);
	Если РезультатЗаписи = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// записываем двоичные данные файла во временное хранилище
	АдресВХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайла), ИдентификаторДляВременногоХранилища);
	
	Возврат АдресВХранилище;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьОтветНаЗапросВыпискиЕГРЮЛ_ЕГРИП(Запрос) Экспорт
	
	// получаем все документы к показу
	СформироватьТаблицуОтветовНаЗапросВыпискиЕГРЮЛ_ЕГРИП(Запрос);
	
	// определяем документ, который показываем
	КоличествоОтветов = ОтветыНаЗапросыВыпискиЕГРЮЛ_ЕГРИП.Количество();
	Если КоличествоОтветов = 0 Тогда
		Возврат;
	ИначеЕсли КоличествоОтветов > 1 Тогда
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ОтметитьКакПрочтенное(Запрос);
		
		СписокВыбора = Новый СписокЗначений;
		Для Каждого СтрокаОтвета Из ОтветыНаЗапросыВыпискиЕГРЮЛ_ЕГРИП Цикл 
			Если СтрокаОтвета.ВАрхиве Тогда
				ПредставлениеЗначения = СтрокаОтвета.ИмяФайла + " [перемещено в архив]";
			Иначе
				ПредставлениеЗначения = СтрокаОтвета.ИмяФайла;
			КонецЕсли;
			СписокВыбора.Добавить(СтрокаОтвета.ИмяФайла, ПредставлениеЗначения);
		КонецЦикла;
		
		ДополнительныеПараметры = Новый Структура("СписокВыбора", СписокВыбора);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПоказатьОтветНаЗапросВыпискиЕГРЮЛ_ЕГРИПЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		СписокВыбора.ПоказатьВыборЭлемента(ОписаниеОповещения);
		
	Иначе
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ОтметитьКакПрочтенное(Запрос);
		
		ПоказатьОтветНаЗапросВыпискиЕГРЮЛ_ЕГРИПНаКлиенте(0);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтветНаЗапросВыпискиЕГРЮЛ_ЕГРИПЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокВыбора = ДополнительныеПараметры.СписокВыбора;
	
	ИндексВыбора = СписокВыбора.Индекс(ВыбранныйЭлемент);
	
	ПоказатьОтветНаЗапросВыпискиЕГРЮЛ_ЕГРИПНаКлиенте(ИндексВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтветНаЗапросВыпискиЕГРЮЛ_ЕГРИПНаКлиенте(ИндексВыбора)
	
	ОтветНаЗапросЕГРЮЛ = ОтветыНаЗапросыВыпискиЕГРЮЛ_ЕГРИП[ИндексВыбора];
	
	Если ОтветНаЗапросЕГРЮЛ.ВАрхиве Тогда
		ПоказатьУведомлениеАрхивныхФайлов(, 0, 3, Истина);
		Возврат;
	КонецЕсли;
	
	ОперацииСФайламиЭДКОКлиент.ОткрытьФайл(ОтветНаЗапросЕГРЮЛ.Адрес, ОтветНаЗапросЕГРЮЛ.ИмяФайла);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьТаблицуОтветовНаЗапросВыпискиЕГРЮЛ_ЕГРИП(Запрос)
	
	ТаблицаОтветовНаЗапросЕГРЮЛ_ЕГРИП = ПолучитьОтветыНаЗапросыВыпискиИзЕГРЮЛ_ЕГРИП(Запрос, Истина);
	ТаблицаОтветовНаЗапросЕГРЮЛ_ЕГРИП.Колонки.Добавить("Адрес");
	Для Каждого СтрокаОтвета Из ТаблицаОтветовНаЗапросЕГРЮЛ_ЕГРИП Цикл
		Если ЗначениеЗаполнено(СтрокаОтвета.Данные) Тогда 
			ГУИД = Новый УникальныйИдентификатор;
			СтрокаОтвета.Адрес = ПоместитьВоВременноеХранилище(СтрокаОтвета.Данные.Получить(), ГУИД);
		КонецЕсли;
	КонецЦикла;
	
	ОтветыНаЗапросыВыпискиЕГРЮЛ_ЕГРИП.Загрузить(ТаблицаОтветовНаЗапросЕГРЮЛ_ЕГРИП);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВидПараметраЗапроса(Документ) Экспорт
	
	ВидПараметраЗапроса = "";
	
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		Возврат ВидПараметраЗапроса;
	КонецЕсли;
	
	Если Документ.ВидПараметраЗапроса = Перечисления.ВидыПараметровЗапросаНаВыпискуИзЕГРЮЛ_ЕГРИП.ИНН Тогда
		ВидПараметраЗапроса= "ИНН";
	ИначеЕсли Документ.ВидПараметраЗапроса = Перечисления.ВидыПараметровЗапросаНаВыпискуИзЕГРЮЛ_ЕГРИП.ОГРН Тогда
		ВидПараметраЗапроса = "ОГРН";
	КонецЕсли;
	
	Возврат ВидПараметраЗапроса;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ДополнитьРезультатыГрупповойОнлайнПроверки(Контекст, СвойстваРезультата)
	
	// извлекаем таблицы исходных файлов и результатов
	Если ТипЗнч(Контекст.АдресФайлаВыгрузки) = Тип("Массив") Тогда
		АдресаФайлаВыгрузки = Контекст.АдресФайлаВыгрузки;
	Иначе
		АдресаФайлаВыгрузки = Новый Массив;
		АдресаФайлаВыгрузки.Добавить(Контекст.АдресФайлаВыгрузки);
	КонецЕсли;
	
	Если ТипЗнч(Контекст.ИмяФайлаВыгрузки) = Тип("Массив") Тогда
		ИменаФайлаВыгрузки = Контекст.ИмяФайлаВыгрузки;
	Иначе
		ИменаФайлаВыгрузки = Новый Массив;
		ИменаФайлаВыгрузки.Добавить(Контекст.ИмяФайлаВыгрузки);
	КонецЕсли;
	
	Если Контекст.Свойство("ТипФайлаВыгрузки") И ТипЗнч(Контекст.ТипФайлаВыгрузки) = Тип("Массив") Тогда
		ТипФайлаВыгрузки = Контекст.ТипФайлаВыгрузки;
	Иначе
		ТипФайлаВыгрузки = Новый Массив;
		Если Контекст.Свойство("ТипФайлаВыгрузки") Тогда
			ТипФайлаВыгрузки.Добавить(Контекст.ТипФайлаВыгрузки);
		ИначеЕсли Контекст.Свойство("ТипОтправляемогоДокумента") Тогда
			ТипФайлаВыгрузки.Добавить(Контекст.ТипОтправляемогоДокумента);
		Иначе
			ТипФайлаВыгрузки.Добавить("");
		КонецЕсли;
	КонецЕсли;
	
	СсылкиНаДокументы = ?(Контекст.Свойство("Документы") И Контекст.Документы <> Неопределено, Контекст.Документы, Контекст.Документ);
	Если ТипЗнч(СсылкиНаДокументы) <> Тип("Массив") Тогда
		МассивСсылокНаДокументы = Новый Массив;
		МассивСсылокНаДокументы.Добавить(СсылкиНаДокументы);
		СсылкиНаДокументы = МассивСсылокНаДокументы;
	КонецЕсли;
	
	АдресТаблицыРезультата = СвойстваРезультата.РезультатыПоДокументам;
	ТаблицаРезультата = ПолучитьИзВременногоХранилища(АдресТаблицыРезультата);
	
	// определяем дополнительные колонки в таблице результатов
	ТаблицаРезультата.Колонки.Добавить("ТипФайлаОтчета");
	ТаблицаРезультата.Колонки.Добавить("Документ");
	ТаблицаРезультата.Колонки.Добавить("ПолноеИмяФайлаВыгрузки");
	
	// заполняем новые колонки таблицы результатов
	Для Каждого СтрРезультат Из ТаблицаРезультата Цикл
		ИмяФайлаОтчета = СтрРезультат.ИмяФайлаОтчета;
		ИндФайла = ИменаФайлаВыгрузки.Найти(ИмяФайлаОтчета);
		Если ИндФайла <> Неопределено Тогда
			СтрРезультат.ТипФайлаОтчета = ТипПоИдентификаторуТипаФайлаВыгрузки(ТипФайлаВыгрузки[ИндФайла]);
			СтрРезультат.Документ = СсылкиНаДокументы[ИндФайла];
			СтрРезультат.ПолноеИмяФайлаВыгрузки = АдресаФайлаВыгрузки[ИндФайла]; // СвойстваВыгрузки.КаталогВыгрузки + СтрФайлОтчета.Имя);
		КонецЕсли;
	КонецЦикла;
	
	СвойстваРезультата.Вставить("РезультатыПоДокументам", ПоместитьВоВременноеХранилище(ТаблицаРезультата, Контекст.УникальныйИдентификатор));
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРезультатыГрупповойОнлайнПроверки(
		ТаблицаРезультата,
		ПоддержкаВУниверсальномФормате,
		РежимПоказаДляОдиночногоДокументаРазрешен,
		ВыполняемоеОповещение)
		
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("АдресТаблицыРезультатов",                   ТаблицаРезультата);
	ДополнительныеПараметры.Вставить("ПоддержкаВУниверсальномФормате",            ПоддержкаВУниверсальномФормате);
	ДополнительныеПараметры.Вставить("РежимПоказаДляОдиночногоДокументаРазрешен", РежимПоказаДляОдиночногоДокументаРазрешен);
	 
		
	ОткрытьФорму(
		ПутьКОбъекту + ".Форма.РезультатГрупповойОнлайнПроверки", 
		ДополнительныеПараметры,
		,
		,
		,
		,
		ВыполняемоеОповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТипПоИдентификаторуТипаФайлаВыгрузки(ИдентификаторТипаФайлаВыгрузки)
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ТипПоИдентификаторуТипаФайлаВыгрузки(ИдентификаторТипаФайлаВыгрузки);
	
КонецФункции

#Область Автообмен

&НаСервереБезКонтекста
Функция ПолучитьИОбработатьВходящие(ИдентификаторФормы)
	
	// определяем наличие УЗДО для текущего пользователя ИБ
	Если ПараметрыСеанса.ТекущиеУчетныеЗаписиНалогоплательщика.Количество() = 0 Тогда 
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("ТребующиеВнимания",    Новый Массив);
	Результат.Вставить("ТребующиеРасшифровки", Новый Массив);
	Результат.Вставить("НовыеСообщения",       Новый Массив);
	Результат.Вставить("ТребуетсяПоказПользователюПослеАвторасшифровки", Ложь);
	Результат.Вставить("АдресДереваНовыхСобытий", "");
	
	ДатаТекущегоАвтообменаСКО = ТекущаяДатаСеанса();
	
	// получаем дату и время крайнего запроса
	ДатаПредыдущегоАвтообменаСКО = ХранилищеОбщихНастроек.Загрузить("АвтообменСКО_ДатаВремяКрайнегоЗапроса");
	Если ДатаПредыдущегоАвтообменаСКО = Неопределено Тогда
		ДатаПредыдущегоАвтообменаСКО = Дата(1,1,1);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СвойстваТранспортныхСообщений.ТранспортноеСообщение,
	               |	ВЫБОР
	               |		КОГДА СвойстваТранспортныхСообщений.ДатаПолучения > &ДатаПолучения
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК НовоеСообщение,
	               |	ЛОЖЬ КАК ТребуетВнимания,
	               |	ЛОЖЬ КАК ТребуетРасшифровки
	               |ИЗ
	               |	РегистрСведений.СвойстваТранспортныхСообщений КАК СвойстваТранспортныхСообщений
	               |ГДЕ
	               |	СвойстваТранспортныхСообщений.УчетнаяЗапись В(&УчетныеЗаписи)
	               |	И СвойстваТранспортныхСообщений.ДатаПолучения > &ДатаПолучения
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СвойстваТранспортныхСообщений.ТранспортноеСообщение,
	               |	ЛОЖЬ,
	               |	СвойстваТранспортныхСообщений.ТребуетВнимания,
	               |	ЛОЖЬ
	               |ИЗ
	               |	РегистрСведений.СвойстваТранспортныхСообщений КАК СвойстваТранспортныхСообщений
	               |ГДЕ
	               |	СвойстваТранспортныхСообщений.УчетнаяЗапись В(&УчетныеЗаписи)
	               |	И СвойстваТранспортныхСообщений.ДатаПолучения > &ДатаПолучения
	               |	И СвойстваТранспортныхСообщений.ТребуетВнимания
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СвойстваТранспортныхСообщений.ТранспортноеСообщение,
	               |	ЛОЖЬ,
	               |	ЛОЖЬ,
	               |	СвойстваТранспортныхСообщений.ТребуетРасшифровки
	               |ИЗ
	               |	РегистрСведений.СвойстваТранспортныхСообщений КАК СвойстваТранспортныхСообщений
	               |ГДЕ
	               |	СвойстваТранспортныхСообщений.ТребуетРасшифровки";
	Запрос.УстановитьПараметр("УчетныеЗаписи", ПараметрыСеанса.ТекущиеУчетныеЗаписиНалогоплательщика);
	Запрос.УстановитьПараметр("ДатаПолучения", ДатаПредыдущегоАвтообменаСКО);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		Если Выборка["ТребуетВнимания"] Тогда 
			Результат.ТребующиеВнимания.Добавить(Выборка.ТранспортноеСообщение);
		КонецЕсли;
		
		Если Выборка["ТребуетРасшифровки"] Тогда 
			Результат.ТребующиеРасшифровки.Добавить(Выборка.ТранспортноеСообщение);
		КонецЕсли;
		
		Если Выборка["НовоеСообщение"] Тогда 
			Результат.НовыеСообщения.Добавить(Выборка.ТранспортноеСообщение);
		КонецЕсли;
		
	КонецЦикла;
	
	ПроверитьВходящиеСообщенияПослеАвторасшифровки(Результат, ИдентификаторФормы);
	
	// получение и обработка прошли успешно, фиксируем дату.
	ХранилищеОбщихНастроек.Сохранить("АвтообменСКО_ДатаВремяКрайнегоЗапроса", , ДатаТекущегоАвтообменаСКО);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьВходящиеСообщенияПослеАвторасшифровки(ВходящиеСообщения, ИдентификаторФормы)

	АвторасшифровкаДоступна = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ДоступнаАвторасшифровкаТранспортныхСообщений(
		ПараметрыСеанса.ТекущиеУчетныеЗаписиНалогоплательщика);
		
	Если НЕ АвторасшифровкаДоступна Тогда
		Возврат;
	КонецЕсли;
	
	// Проверим, были ли ошибки в процессе авторасшифровки.
	СведенияОбОшибках = ДлительнаяОтправкаВызовСервера.ПолучитьОшибкиПоследнегоОбмена();
	Если ТипЗнч(СведенияОбОшибках) = Тип("Структура")
		И СведенияОбОшибках.Свойство("Ошибки")
		И СведенияОбОшибках.Ошибки.Количество() > 0 Тогда
		
		// Загрузим сведения об ошибках.
		Ошибки = ДлительнаяОтправкаКлиентСервер.ЗначениеПараметраДлительнойОтправки("Ошибки");
		
		ТекущаяОрганизация = Неопределено;
		
		Для каждого СохраненнаяОшибка Из СведенияОбОшибках.Ошибки Цикл
			Если ТекущаяОрганизация <> СохраненнаяОшибка.Организация Тогда
				ТекущаяОрганизация = СохраненнаяОшибка.Организация;
				ДлительнаяОтправкаКлиентСервер.ИзменитьПараметрыДлительнойОтправки("ТекущаяОрганизация", ТекущаяОрганизация);
			КонецЕсли;
		
			НоваяОшибка = ДлительнаяОтправкаКлиентСервер.НоваяОшибка(СохраненнаяОшибка.ОписаниеОшибки);
			ДлительнаяОтправкаКлиентСервер.ДобавитьОшибку(Ошибки, НоваяОшибка);
		КонецЦикла;
		
		// Если были ошибки авторасшифровки, то их точно требуется показать.
		ВходящиеСообщения.ТребуетсяПоказПользователюПослеАвторасшифровки = Истина;
	КонецЕсли;
	
	// Проверим, были ли новые сообщения, которые требуется показать.
	ДеревоНовыхСобытий = ЭлектронныйДокументооборотСКонтролирующимиОрганами.НовоеДеревоНовыхСобытий();
	ЭлектронныйДокументооборотСКонтролирующимиОрганами.ЗаполнитьДеревоНовое(
		ДеревоНовыхСобытий,
		Перечисления.ИнициаторыСеансовСвязиСКонтролирующимиОрганами.Автообмен,
		Истина);
	
	ВходящиеСообщения.ТребуетсяПоказПользователюПослеАвторасшифровки = ВходящиеСообщения.ТребуетсяПоказПользователюПослеАвторасшифровки
		ИЛИ ЭлектронныйДокументооборотСКонтролирующимиОрганами.ЕстьИзмененияВДеревеНовых(ДеревоНовыхСобытий);
		
	ВходящиеСообщения.АдресДереваНовыхСобытий = ПоместитьВоВременноеХранилище(ДеревоНовыхСобытий, ИдентификаторФормы);

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИОбработатьВходящиеКлиент() Экспорт 
	
	ВходящиеСообщения = ПолучитьИОбработатьВходящие(УникальныйИдентификатор);
	Если ВходящиеСообщения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// оповещаем открытые формы
	Если ВходящиеСообщения.НовыеСообщения.Количество() > 0 Тогда 
		Оповестить("Заполнение списка полученных сообщений", ВходящиеСообщения.НовыеСообщения);
	КонецЕсли;
	
	// выводим диалог
	Если ВходящиеСообщения.ТребующиеРасшифровки.Количество() > 0 Тогда 
		ВыполнитьРасшифровкуПриНеобходимости(ВходящиеСообщения.ТребующиеРасшифровки);
	ИначеЕсли ВходящиеСообщения.ТребуетсяПоказПользователюПослеАвторасшифровки Тогда
		ПоказатьСообщенияПослеАвторасшифровки(ВходящиеСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ФормаРасшифровкиСообщенийОткрыта()
	
	Окна = ПолучитьОкна();
	
	Если Окна = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяФормыСообщенийТребующихРасшифровки = ПутьКОбъекту + ".Форма.ПоказСообщенийТребующихРасшифровки";
	ИмяФормыОшибкиОтправки 		= ПутьКОбъекту + ".Форма.ОшибкиОтправки";
	ИмяФормыРезультатОбмена 	= ПутьКОбъекту + ".Форма.РезультатОбмена";
	ИмяФормыДлительноеДействие 	= ПутьКОбъекту + ".Форма.ДлительноеДействие";
	
	// Для формы, открытой в режиме "РежимОткрытияОкнаФормы.БлокироватьОкноВладельца",
	// не выполняется поиск по уникальному идентификатору, поэтому приходится искать самим.
	Для Каждого ОткрытоеОкно Из Окна Цикл
		Если ТипЗнч(ОткрытоеОкно) = Тип("ОкноКлиентскогоПриложения") 
			И ОткрытоеОкно.Содержимое.Количество() = 1
			И (ОткрытоеОкно.Содержимое[0].ИмяФормы  = ИмяФормыСообщенийТребующихРасшифровки
			ИЛИ ОткрытоеОкно.Содержимое[0].ИмяФормы = ИмяФормыОшибкиОтправки
			ИЛИ ОткрытоеОкно.Содержимое[0].ИмяФормы = ИмяФормыРезультатОбмена
			ИЛИ ОткрытоеОкно.Содержимое[0].ИмяФормы = ИмяФормыДлительноеДействие) Тогда
			
			Возврат ОткрытоеОкно.Содержимое[0].Открыта();
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьРасшифровкуПриНеобходимости(ТребующиеРасшифровки)
	
	Если НЕ ФормаРасшифровкиСообщенийОткрыта()
		И НЕ ДлительнаяОтправкаКлиентСервер.ФормаДлительнойОтправкиОткрыта() Тогда 
		
		ПараметрыОткрытияФормы = Новый Структура("Сообщения", ТребующиеРасшифровки);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"НачатьДлительнуюОперациюПоРасшифровкеСообщений", 
			ЭтотОбъект);
		
		ОткрытьФорму(
			ПутьКОбъекту + ".Форма.ПоказСообщенийТребующихРасшифровки", 
			ПараметрыОткрытияФормы,
			,
			,
			,
			,
			ОписаниеОповещения);
				
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура НачатьДлительнуюОперациюПоРасшифровкеСообщений(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Ложь Тогда
		// Сюда попадем, если форму расшифровки закрыли по "Больше не показывать".
		ДокументооборотСКОКлиент.ПодключениеОбработчикаОжиданияАвтообмена(Ложь);
		Возврат;
	ИначеЕсли Результат = Неопределено Тогда
		// Сюда попадем, если форму расшифровки закрыли по крестику.
		ДокументооборотСКОКлиент.ПодключениеОбработчикаОжиданияАвтообмена(Истина);
		Возврат;
	КонецЕсли;
		
	ПолучитьДопПараметрыДляРасшифровкиСообщений(Результат);
	
	// производим расшифровку
	КоличествоРасшифрованных   = 0;
	КоличествоНеРасшифрованных = 0;
	НомерОбъекта               = 0;
	Организация                = Неопределено;
	ВсегоСообщений             = СообщенияТребующиеРасшифровки.Количество();
	
	ПараметрыРасшифровки = Новый Структура;
	ПараметрыРасшифровки.Вставить("КоличествоРасшифрованных", 	КоличествоРасшифрованных);
	ПараметрыРасшифровки.Вставить("КоличествоНеРасшифрованных", КоличествоНеРасшифрованных);
	ПараметрыРасшифровки.Вставить("НомерОбъекта", 				НомерОбъекта);
	ПараметрыРасшифровки.Вставить("Организация", 				Организация);
	ПараметрыРасшифровки.Вставить("ВсегоСообщений", 			ВсегоСообщений);
	
	ПараметрыДлительногоОбмена = ДлительнаяОтправкаКлиент.ПараметрыДлительногоОбмена();
	ПараметрыДлительногоОбмена.ЭтоРасшифровка 			= Истина;
	ПараметрыДлительногоОбмена.Организации 				= СообщенияТребующиеРасшифровки[НомерОбъекта].Организация;
	ПараметрыДлительногоОбмена.ОбщееКоличествоЭтапов 	= ВсегоСообщений;
	
	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительногоОбмена(ПараметрыДлительногоОбмена) Тогда // Расшифровка.
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("Подключаемый_РасшифроватьТребующиеРасшифровку", 0.1, Истина);

КонецПроцедуры
	
&НаСервере
Процедура ПолучитьДопПараметрыДляРасшифровкиСообщений(Результат)
	
	СообщенияТребующиеРасшифровки.Загрузить(ПолучитьИзВременногоХранилища(Результат.АдресТребующиеРасшифровки));
	ТаблицаРасшифровкиПоОрганизациям.Загрузить(ПолучитьИзВременногоХранилища(Результат.АдресТаблицаРасшифровкиПоОрганизациям));
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПоказатьСообщенияПослеАвторасшифровки(ВходящиеСообщения)

	ПараметрыДлительногоОбмена = ДлительнаяОтправкаКлиент.ПараметрыДлительногоОбмена();
	ПараметрыДлительногоОбмена.ЭтоРасшифровка     = Истина;
	ПараметрыДлительногоОбмена.ЭтоАвторасшифровка = Истина;
	ПараметрыДлительногоОбмена.АдресДереваНовыхСобытий = ВходящиеСообщения.АдресДереваНовыхСобытий;
	
	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительногоОбмена(ПараметрыДлительногоОбмена) Тогда // Расшифровка.
		Возврат;
	КонецЕсли;
	
	ОтобразитьКонечныйРезультатРасшифровки(Неопределено, 0, 0, 0);

КонецПроцедуры

#КонецОбласти

#Область РасшифровкаПослеАвтоообмена

&НаКлиенте
Процедура Подключаемый_РасшифроватьТребующиеРасшифровку() Экспорт
	
	Организация 					= ПараметрыРасшифровки.Организация;
	ВсегоСообщений 					= ПараметрыРасшифровки.ВсегоСообщений;
	КоличествоНеРасшифрованных 		= ПараметрыРасшифровки.КоличествоНеРасшифрованных;
	КоличествоРасшифрованных 		= ПараметрыРасшифровки.КоличествоРасшифрованных;
	НомерОбъекта 					= ПараметрыРасшифровки.НомерОбъекта;
	
	Если НомерОбъекта + 1 > СообщенияТребующиеРасшифровки.Количество() Тогда
		
		ОтобразитьКонечныйРезультатРасшифровки(
			Организация,
			ВсегоСообщений,
			КоличествоНеРасшифрованных,
			КоличествоРасшифрованных);
		
	Иначе
		
		Сообщение = СообщенияТребующиеРасшифровки[НомерОбъекта];
		
		Организация = Сообщение.Организация;
		
		УчетнаяЗапись = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЗначениеРеквизитаОбъекта(Организация, "УчетнаяЗаписьОбмена");
		
		ЭтоЭлектроннаяПодписьВМоделиСервиса = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(УчетнаяЗапись).ЭлектроннаяПодписьВМоделиСервиса;
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("Организация",                Организация);
		ДополнительныеПараметры.Вставить("Сообщение",                  Сообщение);
		ДополнительныеПараметры.Вставить("ВсегоСообщений",             ВсегоСообщений);
		ДополнительныеПараметры.Вставить("КоличествоНеРасшифрованных", КоличествоНеРасшифрованных);
		ДополнительныеПараметры.Вставить("КоличествоРасшифрованных",   КоличествоРасшифрованных);
		ДополнительныеПараметры.Вставить("НомерОбъекта",               НомерОбъекта);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"РасшифроватьТребующиеРасшифровкуЗавершение",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		РасшифроватьТранспортноеСообщение(Сообщение.ТранспортноеСообщение, ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьТребующиеРасшифровкуЗавершение(Результат, ВходящийКонтекст) Экспорт
	
	ВсегоСообщений             = ВходящийКонтекст.ВсегоСообщений;
	КоличествоНеРасшифрованных = ВходящийКонтекст.КоличествоНеРасшифрованных;
	КоличествоРасшифрованных   = ВходящийКонтекст.КоличествоРасшифрованных;
	НомерОбъекта               = ВходящийКонтекст.НомерОбъекта;
	Сообщение                  = ВходящийКонтекст.Сообщение;
	Организация                = ВходящийКонтекст.Организация;
	
	Если Результат Тогда
		
		ПодтвердитьРасшифровку(Сообщение.ТранспортноеСообщение);
		КоличествоРасшифрованных = КоличествоРасшифрованных + 1;
		
		НараститьКоличествоРасшифрованныхИНерасшифрованных(Организация, Истина);

	Иначе
		КоличествоНеРасшифрованных = КоличествоНеРасшифрованных + 1;
		
		НараститьКоличествоРасшифрованныхИНерасшифрованных(Организация, , Истина);
		
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("КоличествоПройденныхЭтапов", 	КоличествоРасшифрованных + КоличествоНеРасшифрованных);
	ДополнительныеПараметры.Вставить("ОбщееКоличествоЭтапов", 		ВсегоСообщений);
	ДополнительныеПараметры.Вставить("ТекущаяОрганизация", 			Организация);
		
	ДлительнаяОтправкаКлиент.ОповеститьОСменеЭтапаРасшифровки(ДополнительныеПараметры);
	
	ПараметрыРасшифровки = Новый Структура;
	ПараметрыРасшифровки.Вставить("КоличествоРасшифрованных", 	КоличествоРасшифрованных);
	ПараметрыРасшифровки.Вставить("КоличествоНеРасшифрованных", КоличествоНеРасшифрованных);
	ПараметрыРасшифровки.Вставить("НомерОбъекта", 				НомерОбъекта + 1);
	ПараметрыРасшифровки.Вставить("Организация", 				Организация);
	ПараметрыРасшифровки.Вставить("ВсегоСообщений", 			ВсегоСообщений);
	
	ПодключитьОбработчикОжидания("Подключаемый_РасшифроватьТребующиеРасшифровку", 0.1, Истина);
	
КонецПроцедуры
	
&НаКлиенте
Процедура НараститьКоличествоРасшифрованныхИНерасшифрованных(
		Организация = Неопределено,
		НараститьКоличествоРасшифрованных = Ложь, 
		НараститьКоличествоНеРасшифрованных = Ложь)
	
	Отбор = Новый Структура("Организация", Организация);
	РезультатОтбора = ТаблицаРасшифровкиПоОрганизациям.НайтиСтроки(Отбор);
	Если РезультатОтбора.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Если НараститьКоличествоРасшифрованных Тогда
		РезультатОтбора[0].КоличествоРасшифрованных = РезультатОтбора[0].КоличествоРасшифрованных + 1;
	КонецЕсли;
	
	Если НараститьКоличествоНеРасшифрованных Тогда
		РезультатОтбора[0].КоличествоНеРасшифрованных = РезультатОтбора[0].КоличествоНеРасшифрованных + 1;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПодтвердитьРасшифровку(Сообщение)
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	КонтекстЭДОСервер.ПодтвердитьРасшифровку(Сообщение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьКонечныйРезультатРасшифровки(
	Организация,
	ВсегоСообщений,
	КоличествоНеРасшифрованных,
	КоличествоРасшифрованных)
	
	ДокументооборотСКОКлиент.ПодключениеОбработчикаОжиданияАвтообмена(Истина);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("КоличествоНеРасшифрованных", 	КоличествоНеРасшифрованных);
	ДополнительныеПараметры.Вставить("КоличествоРасшифрованных", 	КоличествоРасшифрованных);
	ДополнительныеПараметры.Вставить("ВсегоСообщений", 				ВсегоСообщений);
	
	ДлительнаяОтправкаКлиент.ОповеститьОЗавершенииРасшифровки(ДополнительныеПараметры);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ПоказатьВложениеФСГС(СтрВложение, ВыполняемоеОповещение = Неопределено) Экспорт
	
	Если СтрВложение.Свойство("ЭтоHTML") И СтрВложение.ЭтоHTML Тогда
		ПоказатьHTML(СтрВложение.ИмяФайла, СтрВложение.Данные);
	ИначеЕсли СтрВложение.Свойство("ЭтоXML") И СтрВложение.ЭтоXML И НЕ ЭтоВебКлиент() Тогда
		ПоказатьHTML(СтрВложение.ИмяФайла, СтрВложение.Данные, , Истина);
	ИначеЕсли СтрВложение.Свойство("ЭтоTXT") И СтрВложение.ЭтоTXT Тогда
		ПоказатьТекстИзСтроки(СтрВложение.ТекстВложения, СтрВложение.ИмяФайла);
	Иначе
		ОперацииСФайламиЭДКОКлиент.ОткрытьФайл(СтрВложение.Адрес, СтрВложение.ИмяФайла);
	КонецЕсли;
	
	Если ВыполняемоеОповещение <> Неопределено ТОгда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьОписаниеСведенийФСГС(Сообщение, Вложения, КороткоеИмяФайла = Неопределено)
	
	// извлекаем ключевые параметры
	КлючевыеПараметрыФайлаВыгрузки = ОпределитьКлючевыеПараметрыФайлаВыгрузкиФСГС(Сообщение, Вложения);
	Если НЕ ЗначениеЗаполнено(КлючевыеПараметрыФайлаВыгрузки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	// добавляем узел "форма" - описание формы
	УзелФорма = ДобавитьУзелXML(Дерево, "форма");
	// добавляем узел "название" - название формы
	УзелНазвание = ДобавитьУзелXML(УзелФорма, "название",, КлючевыеПараметрыФайлаВыгрузки["название"]);
	// добавляем узел "идентификатор" - идентификатор формы
	УзелИдентификатор = ДобавитьУзелXML(УзелФорма, "идентификатор",, КлючевыеПараметрыФайлаВыгрузки["идентификатор"]);
	
	// добавляем узел "год" - год периода, за который предоставляется отчет
	УзелГод = ДобавитьУзелXML(Дерево, "год",, КлючевыеПараметрыФайлаВыгрузки["год"]);
	
	// добавляем узел "типПериода" - тип периода, принимает значения "месяц", "квартал", "год"
	УзелТипПериода = ДобавитьУзелXML(Дерево, "типПериода",, КлючевыеПараметрыФайлаВыгрузки["типПериода"]);
	
	// добавляем узел "номерПериода" - порядковый номер периода в году
	УзелНомерПериода = ДобавитьУзелXML(Дерево, "номерПериода",, КлючевыеПараметрыФайлаВыгрузки["номерПериода"]);
	
	// добавляем узел "номерОтчета" - порядковый номер отчета в указанном периоде
	УзелНомерОтчета = ДобавитьУзелXML(Дерево, "номерОтчета",, КлючевыеПараметрыФайлаВыгрузки["номерОтчета"]);
	
	// добавляем узел "видОтчета" - вид отчета, принимает значения "статистический", "бухгалтерский"
	УзелВидОтчета = ДобавитьУзелXML(Дерево, "видОтчета",, КлючевыеПараметрыФайлаВыгрузки["видОтчета"]);
	
	// формируем строку XML на основе дерева
	СтрокаXML = ВыгрузитьДеревоВXML_ПФР(Дерево, "описаниеОтчета");
	
	// записываем строку в файл
	КороткоеИмяФайла = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	ПолноеИмяФайлаДокументаВСоставеПакета = ПолучитьКаталогВременныхФайлов() + КороткоеИмяФайла;
	РезультатЗаписи = ЗаписатьXMLВФайл(СтрокаXML, ПолноеИмяФайлаДокументаВСоставеПакета);
	Если РезультатЗаписи = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолноеИмяФайлаДокументаВСоставеПакета;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОпределитьКлючевыеПараметрыФайлаВыгрузкиФСГС(Сообщение, Вложения)
	
	// ищем файл выгрузки
	СтрФайлВыгрузки = Вложения.Найти(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиФСГС, "Тип");
	Если СтрФайлВыгрузки = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать описание сведений: не удалось обнаружить файл выгрузки среди вложений сообщения.';
								|en = 'Cannot generate information description: cannot detect an export file among message attachments.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	ФайлыВыгрузки = ПолучитьВложенияТранспортногоСообщения(Сообщение, Истина, , СтрФайлВыгрузки.ИмяФайла);
	
	// сохраняем файл выгрузки во временный файл
	ИмяВременногоФайлаВыгрузки = ПолучитьИмяВременногоФайла();
	Попытка
		ФайлыВыгрузки[0].Данные.Получить().Записать(ИмяВременногоФайлаВыгрузки);
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать описание сведений: не удалось сохранить файл выгрузки во временный каталог.';
								|en = 'Cannot generate information description: cannot save the export file to the temporary directory.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецПопытки;
	
	// разбираем содержимое файла выгрузки
	ПараметрыФайлаВыгрузки = СформироватьСтруктуруПараметровФайлаВыгрузкиДляОписанияСведенийФСГС(ИмяВременногоФайлаВыгрузки);
	Если НЕ ЗначениеЗаполнено(ПараметрыФайлаВыгрузки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЦиклОбмена = Сообщение.ЦиклОбмена;
	
	// определяем наименование отчета
	ВидОтчета = ЦиклОбмена.ВидОтчета;
	Если ВидОтчета = Справочники.ВидыОтправляемыхДокументов.СтатистикаПрочиеФормы
	   И ТипЗнч(ЦиклОбмена.Предмет) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
		НазваниеФормы = ЦиклОбмена.Предмет.НаименованиеОтчета;
	Иначе
		НазваниеФормы = ?(ПустаяСтрока(ВидОтчета.Описание), СокрЛП(ВидОтчета.Наименование), СокрЛП(ВидОтчета.Описание));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(НазваниеФормы) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать описание сведений: не удалось определить название представляемой формы.';
								|en = 'Cannot generate information description: cannot determine a represented form name.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	ЭтоБухгалтерскаяОтчетность = (ВидОтчета = Справочники.ВидыОтправляемыхДокументов.СтатистикаБухОтчетность);
	
	// ищем идентификатор формы
	Если ЭтоБухгалтерскаяОтчетность Тогда
		ИдентификаторФормы = ПараметрыФайлаВыгрузки["КНД"];
	Иначе
		ИдентификаторФормы = ПараметрыФайлаВыгрузки["code"];
	КонецЕсли;
	
	Если ИдентификаторФормы = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать описание сведений: не удалось определить идентификатор формы по файлу выгрузки.';
								|en = 'Cannot generate information description: cannot determine a form ID by the export file.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// определяем год
	Год = Формат(Год(ЦиклОбмена.ДатаНачалаПериода), "ЧГ=");
	Если НЕ ЗначениеЗаполнено(Год) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать описание сведений: не удалось определить отчетный год.';
								|en = 'Cannot generate information description: cannot determine a reporting year.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	Если ЭтоБухгалтерскаяОтчетность Тогда
		ГодИзПараметров = ПараметрыФайлаВыгрузки["ОтчетГод"];
	Иначе
		ГодИзПараметров = ПараметрыФайлаВыгрузки["year"];
	КонецЕсли;
	
	Если Год <> ГодИзПараметров Тогда
		ТекстСообщения = НСтр("ru = 'Год периода отчета не совпадает с годом в параметрах файла выгрузки.';
								|en = 'Report period year does not match the year of the export file parameters.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	КонецЕсли;
	
	// определяем тип периода - "месяц", "квартал", "год" и др..
	Если ЭтоБухгалтерскаяОтчетность Тогда
		ТипПериода = "год";
	Иначе
		ТипПериода = "месяц";
		КодТипаПериода = Прав(ИдентификаторФормы, 3);
		Если КодТипаПериода = "001" Тогда
			ТипПериода = "год";
		ИначеЕсли КодТипаПериода = "002" Тогда
			ТипПериода = "полугодие";
		ИначеЕсли КодТипаПериода = "004" Тогда
			ТипПериода = "квартал";
		КонецЕсли; 
	КонецЕсли;
	
	// определяем номер периода в году
	Если ЭтоБухгалтерскаяОтчетность Тогда
		НомерПериода = "1"; // годовая
	Иначе
		НомерПериода = ПараметрыФайлаВыгрузки["period"];
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НомерПериода) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать описание сведений: не удалось определить порядковый номер периода в году.';
								|en = 'Cannot generate information description: cannot determine a sequence number of the period in a year.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// определяем порядковый номер отчета в указанном периоде
	НомерОтчета = 1;
	Попытка
		НомерОтчета = 1 + ЦиклОбмена.Предмет.Вид;
	Исключение КонецПопытки;
	
	Если ЭтоБухгалтерскаяОтчетность Тогда
		ВидОтчетаСтр = "бухгалтерский";
	Иначе
		ВидОтчетаСтр = "статистический";
	КонецЕсли;
	
	// удаляем временный файл выгрузки
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайлаВыгрузки);
	
	Возврат Новый Структура("название,      идентификатор,      год, типПериода, номерПериода, номерОтчета, видОтчета",
							 НазваниеФормы, ИдентификаторФормы, Год, ТипПериода, НомерПериода, НомерОтчета, ВидОтчетаСтр);
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьСтруктуруПараметровФайлаВыгрузкиДляОписанияСведенийФСГС(ФайлВыгрузки)

	ПоказателиВыгрузки = Новый Соответствие;
	ОбъектЧтениеXML = Новый ЧтениеXML;
	Попытка
		ОбъектЧтениеXML.ОткрытьФайл(ФайлВыгрузки);
		ОбъектЧтениеXML.ИгнорироватьПробелы = Ложь;
		Пока ОбъектЧтениеXML.Прочитать() Цикл
			Если ОбъектЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				Пока ОбъектЧтениеXML.ПрочитатьАтрибут() Цикл
					Если ПоказателиВыгрузки[ОбъектЧтениеXML.Имя] = Неопределено Тогда
						ПоказателиВыгрузки.Вставить(СтрЗаменить(ОбъектЧтениеXML.Имя, "-", "_"), ОбъектЧтениеXML.Значение);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;	
		ОбъектЧтениеXML.Закрыть();
		ПоказателиВыгрузки.Вставить("ЭтоXML", Истина);
	Исключение
		Текст = Новый ЧтениеТекста;
		Текст.Открыть(ФайлВыгрузки, "cp866");
		ТекСтр = Текст.ПрочитатьСтроку();
		Пока ТекСтр <> Неопределено Цикл
			ТекСтр = СокрЛП(ТекСтр);
			ВхождениеДвоеточия = СтрНайти(ТекСтр, ":");
			ИмяПоказателя = СокрЛП(Лев(ТекСтр, ВхождениеДвоеточия - 1));
			ЗначениеПоказателя = СокрЛП(Сред(ТекСтр, ВхождениеДвоеточия + 1));
			Если ВхождениеДвоеточия <> 0 Тогда
				Если ПоказателиВыгрузки[ИмяПоказателя] = Неопределено Тогда
					ПоказателиВыгрузки.Вставить(ИмяПоказателя, ЗначениеПоказателя);
				КонецЕсли;
			КонецЕсли;
			ТекСтр = Текст.ПрочитатьСтроку();
		КонецЦикла;
		Текст.Закрыть();
		ПоказателиВыгрузки.Вставить("ЭтоXML", Ложь);
	КонецПопытки;
	Возврат ПоказателиВыгрузки;

КонецФункции

&НаСервереБезКонтекста
Функция СформироватьОписаниеСведенийДляСообщенияФСГС(Контекст)
	
	Сообщение = Контекст.ТранспортноеСообщение;

	ТипыВложений = Новый Массив;
	ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиФСГС);
	ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеФайлаОтчетностиФСГС);
	Вложения = ПолучитьВложенияТранспортногоСообщения(Сообщение, , ТипыВложений);
	
	Если Вложения.Найти(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеФайлаОтчетностиФСГС, "Тип") <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	// генерируем файл
	КороткоеИмяФайла = Неопределено;
	ФайлОписаниеСведений = СформироватьОписаниеСведенийФСГС(Сообщение, Вложения, КороткоеИмяФайла);
	Если ФайлОписаниеСведений = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// загружаем файл в содержимое
	ДобавитьСодержимоеТранспортногоКонтейнера(Сообщение, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеФайлаОтчетностиФСГС, ФайлОписаниеСведений, КороткоеИмяФайла, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml);
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьПакетФСГС_СформироватьОписаниеДокументовПакета(Контекст)
	
	//
	Сообщение = Контекст.ТранспортноеСообщение;
	
	// определяем структуру с отложенными командами
	ОтложенныеКоманды = Новый СписокЗначений;
	
	// создаем вспомогательное дерево описания документов пакета
	ДеревоДокументов = СоздатьДеревоОписанияДокументовПакета();
	
	// создаем временный каталог для выгрузки файлов
	КаталогФайловОтчетности = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();

	// Создадим контекст ЭДО один раз до начала цикла обхода, чтобы не тратить время на каждом шаге.
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	
	//
	Если Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьФСГС Тогда
		
		ТипыСодержимого = Новый Массив;
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиФСГС);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеФайлаОтчетностиФСГС);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись);
		ВложенияДИВ = ПолучитьВложенияТранспортногоСообщения(Сообщение, Истина, ТипыСодержимого);
		ВложенияДИВ.Колонки.Добавить("Адрес");
		Для Каждого ВложениеДИВ Из ВложенияДИВ Цикл
			Попытка
				ВложениеДИВ.Адрес = ПоместитьВоВременноеХранилище(ВложениеДИВ.Данные.Получить(), Контекст.УникальныйИдентификатор);
			Исключение
				ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловОтчетности);
				ТекстСообщения = НСтр("ru = 'Ошибка формирования пакета: не удалось сохранить документ во временный каталог для подписания.';
										|en = 'An error occurred while generating the package: cannot save the document to the temporary directory for signing.'");
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Ложь;
			КонецПопытки;
		КонецЦикла;
		
		// заполняем дерево описания сначала отчетами и описанием сведений
		Для Каждого ВложениеДИВ Из ВложенияДИВ Цикл
			
			Если ВложениеДИВ.Тип <> Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиФСГС
			И ВложениеДИВ.Тип <> Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеФайлаОтчетностиФСГС Тогда
				Продолжить;
			КонецЕсли;
			
			// пакуем файл
			КороткоеИмяФайлаАрхива = КонтекстЭДОСервер.ЗаархивироватьФайлПакета(ВложениеДИВ, "file", Контекст.УникальныйИдентификатор);
			Если КороткоеИмяФайлаАрхива = Неопределено Тогда
				ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловОтчетности);
				Возврат Ложь;
			КонецЕсли;
			
			ТипДокумента = ВложениеДИВ.Тип;
			
			Если ВложениеДИВ.Тип = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиФСГС Тогда
				// шифруем файл
				ОтложенныеКоманды.Добавить(ВложениеДИВ.Адрес, "Зашифровать");
				// определяем документ в дереве описания
				СтрДокумент = КонтекстЭДОСервер.ОпределитьДокументВДеревеОписания(ДеревоДокументов, ТипДокумента, "xml", ВложениеДИВ.Идентификатор, Истина, Истина, ВложениеДИВ.ИмяФайла, КороткоеИмяФайлаАрхива, ВложениеДИВ.Адрес);
			Иначе
				// определяем документ в дереве описания
