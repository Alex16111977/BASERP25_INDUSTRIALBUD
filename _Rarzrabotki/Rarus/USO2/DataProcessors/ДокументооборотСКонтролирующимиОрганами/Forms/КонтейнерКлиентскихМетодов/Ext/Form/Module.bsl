&НаКлиентеНаСервереБезКонтекста
Функция ВидыДокументовПоВходящемуКонтексту(ВходящийКонтекст) Экспорт
	
	ДокументЗаявление = ВходящийКонтекст.ДокументЗаявление;
	
	ЭтоЭлектронноеПодписание 	= ДокументЗаявление.ПодписатьЭП;
	ВладелецЭЦПТип 				= ДокументЗаявление.ВладелецЭЦПТип;
	ЭтоЮридическоеЛицо 			= ДокументЗаявление.ТипОрганизации;
	ЭтоПервичноеЗаявление 		= ВходящийКонтекст.ЭтоПервичноеЗаявление;
	ЭтоНулевка 					= ВходящийКонтекст.ЭтоНулевка;
	
	Возврат ДокументооборотСКОКлиентСервер.ВидыДокументовВЗаявлении(ЭтоЭлектронноеПодписание, ЭтоНулевка, ВладелецЭЦПТип, ЭтоЮридическоеЛицо, ЭтоПервичноеЗаявление);
	
КонецФункции

#Область РегНомерФСС

&НаСервере
Функция ПолучитьНомерФССИзСертификата(Сертификат) Экспорт
	
	НомерФСС = "";
	
	Маркер = ПолучитьБуферДвоичныхДанныхИзHexСтроки("06082A850303810D0101"); // OID 1.2.643.3.141.1.1
	ЧтениеДанных = Новый ЧтениеДанных(Сертификат);
	МаркерНайден = ЧтениеДанных.ПропуститьДо(Маркер);	
	Если МаркерНайден >= 0 Тогда
		Свойства = ПрочитатьСвойстваБлока(ЧтениеДанных, Сертификат.Размер());
		НомерФСС = ПрочитатьСтроку(ЧтениеДанных, Свойства);
		ЧтениеДанных.Закрыть();		
	КонецЕсли;
	
	Возврат НомерФСС;
	
КонецФункции

&НаСервере
Функция ПрочитатьСтроку(ЧтениеДанных, Свойства)
	
	Буфер = ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(Свойства.РазмерБлока);
	Поток = Новый ПотокВПамяти(Буфер);
	
	Если Свойства.Тег = 30 Тогда // BMPString
		Кодировка = "utf-16";	
	ИначеЕсли Свойства.Тег = 28 Тогда // UniversalString
		Кодировка = "utf-32";
	Иначе
		Кодировка = "utf-8";	
	КонецЕсли;
	
	ЧтениеТекста = Новый ЧтениеТекста(Поток, Кодировка);
	Строка = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	Поток.Закрыть();
	
	// Дополнительная защита от ошибок сериализации из-за нечитаемых символов
	Возврат ОбщегоНазначенияЭДКОКлиентСервер.ЗаменитьНечитаемыеСимволы(Строка);
	
КонецФункции

&НаСервере
Функция ПрочитатьСвойстваБлока(ЧтениеДанных, РазмерДанных)
	
	Свойства = Новый Структура;
	
	Буфер = ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(1);
	
	МаскаКлассБлока = 192;   // 1100 0000
	МаскаТег = 31;           // 0001 1111
	МаскаЗначащиеБиты = 127; // 0111 1111
	МаскаСтаршийБит = 128;   // 1000 0000
	
	Свойства.Вставить("Класс", ОперацияПобитовоеИ(Буфер[0], МаскаКлассБлока));
	Свойства.Вставить("Тег", ОперацияПобитовоеИ(Буфер[0], МаскаТег));
		
	// Прочитать размер блока
	Буфер = ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(1);
	Если Буфер[0] = 128 Тогда // Используется потоковый способ кодирования, т.е. размер блока не указан (окончание блока 00 00)
		РазмерБлока = -1;
	Иначе
		ДлинныйРазмер = Булево(ОперацияПобитовоеИ(Буфер[0], МаскаСтаршийБит));
		Если ДлинныйРазмер Тогда
			КоличествоБайтовПодРазмер = ОперацияПобитовоеИ(Буфер[0], МаскаЗначащиеБиты);
			Буфер = ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(КоличествоБайтовПодРазмер);
			РазмерБлока = 0;
			Для Каждого Байт Из Буфер Цикл
				РазмерБлока = РазмерБлока * 256 + Байт;
			КонецЦикла;
		Иначе
			РазмерБлока = ОперацияПобитовоеИ(Буфер[0], МаскаЗначащиеБиты);	
		КонецЕсли;
	КонецЕсли;
	
	Если РазмерБлока > РазмерДанных Тогда
		ВызватьИсключение("Размер блока превышает размер файла");
	КонецЕсли;
	
	Свойства.Вставить("РазмерБлока", РазмерБлока);
	
	Возврат Свойства;
	
КонецФункции

&НаСервере
Функция ОперацияПобитовоеИ(Байт1, Байт2)
	
	Буфер1 = БуферИзБайта(Байт1);
	Буфер2 = БуферИзБайта(Байт2);
	Буфер1.ЗаписатьПобитовоеИ(0, Буфер2);
	
	Возврат Буфер1[0];
	
КонецФункции

&НаСервере
Функция БуферИзБайта(Байт)
	
	Буфер = Новый БуферДвоичныхДанных(1);
	Буфер[0] = Байт;
	
	Возврат Буфер;
	
КонецФункции

#КонецОбласти

&НаКлиенте
Процедура ОткрытьЗаявлениеИлиСоглашениеСПФР(НавигационнаяСсылкаФорматированнойСтроки, ЗаявлениеПФР, КодРегиона) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "Заявление" Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ТабДок", ЗаявлениеПФР);
		
		ОткрытьФорму(ПутьКОбъекту + ".Форма.ЗаявлениеНаПодключениеКПФР", ДополнительныеПараметры);
		
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "Сайт" Тогда
		
		ПараметрыПодключенияКПФР = ПараметрыПодключенияКПФР(КодРегиона);
		ОбщегоНазначенияКлиент.ОткрытьНавигационнуюСсылку(ПараметрыПодключенияКПФР.Ссылка);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокДоверенностейИлиИнструкцию(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка, Организация) Экспорт
	
	СтандартнаяОбработка = Ложь;
	Если НавигационнаяСсылкаФорматированнойСтроки = "доверенность" Тогда
		
		ОткрытьФорму("Справочник.ДоверенностиНалогоплательщика.ФормаСписка",,Организация);
		
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "регистрации" Тогда
		
		ЗначениеОтбора = Новый Структура("Владелец", Организация);
		ПараметрыВыбора = Новый Структура("Отбор", ЗначениеОтбора);

		ОткрытьФорму("Справочник.РегистрацииВНалоговомОргане.ФормаСписка", ПараметрыВыбора);
		
	Иначе
		ОбщегоНазначенияКлиент.ПерейтиПоСсылке("https://its.1c.ru/bmk/elreps/authorised_representative_pers");
	КонецЕсли;
	
КонецПроцедуры

#Область ОповещениеОбОдобренииИлиОтклоненииЗаявления

#Область ОбвновлениеЗаявленийЧерезФормуОповещения

&НаКлиенте
Процедура СообщитьОбОдобренныхЗаявленияхАбонента_Контейнер(Результат, ВходящийКонтекст) Экспорт
	
	ЕстьОтправленныеЗаявления = ОбработкаЗаявленийАбонентаВызовСервера.ОтправленныеЗаявленияАбонентов().Количество() > 0;
	
	Если ЕстьОтправленныеЗаявления Тогда
		
		Заявление = ОбработкаЗаявленийАбонентаВызовСервера.СледующееЗаявлениеТребующееРеакцииПользователя();
		
		Если ЗначениеЗаполнено(Заявление) Тогда
			
			Если ФормаОповещенияИлиМастераУжеОткрыта() Тогда
				
				// Проверим позже
				ОбработкаЗаявленийАбонентаКлиент.ПодключитьОбработчикПроверкиЗаявлений();
				
			Иначе
				
				РеквизитыЗаявления = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(Заявление);
				ЭтоУпрощенноеЗаявление = РеквизитыЗаявления.ЭтоУпрощенноеЗаявление;
				
				ДополнительныеПараметры = Новый Структура();
				ДополнительныеПараметры.Вставить("Заявление", 				Заявление);
				ДополнительныеПараметры.Вставить("РеквизитыЗаявления",  	РеквизитыЗаявления);
				ДополнительныеПараметры.Вставить("ЭтоУпрощенноеЗаявление",  ЭтоУпрощенноеЗаявление);
				 
				ОписаниеОповещения = Новый ОписаниеОповещения(
					"СообщитьОбОдобренныхЗаявленияхАбонента_ПослеЗакрытияФормыОповещения", 
					ЭтотОбъект,
					ДополнительныеПараметры);
				
				Если ЭтоУпрощенноеЗаявление Тогда
					
					Ответ = ПолучитьОтветСервераНаЗаявлениеАбонента(Заявление);
	
					РеквизитыДокумента 		= Ответ.РеквизитыДокумента;
					РезультатОтветаСервера 	= Ответ.РезультатОтветаСервера;
					
					ВходящийКонтекст = Новый Структура;
					ВходящийКонтекст.Вставить("РеквизитыДокумента", РеквизитыДокумента);
					
					Если РезультатОтветаСервера.Свойство("СообщитьОбОтсутствииИнтернета") Тогда
						СообщитьОбОтсутствииИнтернета(ВходящийКонтекст);
						Возврат;
					КонецЕсли;
					
					ЗаявлениеТребуетНастройки = НЕ РеквизитыДокумента.НастройкаЗавершена
						И (РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено")
						ИЛИ РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено"));
						
					// Открываем форму настройки только если настройка требуется
					СтатусИзменился = РезультатОтветаСервера.СтатусИзменился ИЛИ ЗаявлениеТребуетНастройки;
						
					Если СтатусИзменился Тогда
						
						ВходящийКонтекст.Вставить("РезультатОтветаСервера", РезультатОтветаСервера);
						
						ОткрытьФормуЗавершенияНастройкиМастера(
							Заявление, 
							ВходящийКонтекст, 
							ОписаниеОповещения);
							
					КонецЕсли;
						
				Иначе
					
					ПараметрыФормы = Новый Структура("Заявление", Заявление);
					ОткрытьФорму("ОбщаяФорма.ОповещениеОбОдобренииЗаявленияАбонента", ПараметрыФормы,,,,, ОписаниеОповещения);
					
					// Обработчик ожидания подключается позже в процедуре СообщитьОбОдобренныхЗаявленияхАбонента_Завершение
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			// Отключения обработчика не делаем,
			// так как заявление может изменить статус, а обработчик будет отключен.
			// Отключим только если нет ни одного отправленного.
			
			// Проверим позже
			ОбработкаЗаявленийАбонентаКлиент.ПодключитьОбработчикПроверкиЗаявлений();
		
		КонецЕсли;
	
	Иначе
		
		// Отключаем только в случае, если нет отправленных.
		ОбработкаЗаявленийАбонентаКлиент.ОтключитьОбработчикПроверкиЗаявлений();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбОдобренныхЗаявленияхАбонента_ПослеЗакрытияФормыОповещения(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Неопределено Тогда
		
		// Проверим следующее заявление
		ОбработкаЗаявленийАбонентаКлиент.ПодключитьОбработчикПроверкиЗаявлений();
			
	Иначе
		
		// Обработчик ожидания подключается позже в процедуре СообщитьОбОдобренныхЗаявленияхАбонента_Завершение
		
		// После настройки проверяем следующее заявление (если есть)
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"СообщитьОбОдобренныхЗаявленияхАбонента_Завершение", 
			ЭтотОбъект);
		
		Если ТипЗнч(Результат) = Тип("Структура")
			И Результат.Свойство("СоздатьНовоеЗаявление") Тогда
			// Заявление было отклонено, поэтому вместо завершения настройки созданием новое копированием
			
			Результат.Вставить("ВыполняемоеОповещение", ОписаниеОповещения);
			ОткрытьФормуЗаявления(Результат);
			
		ИначеЕсли ВходящийКонтекст.ЭтоУпрощенноеЗаявление Тогда
			
			// Завершение настройки выполняется внутри той же формы, а не в отдельной
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		Иначе
			
			ОткрытьФормуЗавершенияНастройкиМастера(
				ВходящийКонтекст.Заявление, 
				Результат, 
				ОписаниеОповещения);
				
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбОдобренныхЗаявленияхАбонента_Завершение(Результат, ВходящийКонтекст) Экспорт
	
	ОбработкаЗаявленийАбонентаКлиент.ПодключитьОбработчикПроверкиЗаявлений();
	
КонецПроцедуры

#КонецОбласти

#Область ОбвновлениеЗаявленийИзФормыСпискаИДокумента

&НаКлиенте
Процедура ОбновитьСтатусЗаявленияАбонента_ИзПанелиОтправки(ОписаниеОповещения, Форма, ДокументЗаявление) Экспорт

	РеквизитыЗаявления = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(ДокументЗаявление);
	
	Если РеквизитыЗаявления.ПометкаУдаления Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Заявление помечено на удаление. Обновление состояния невозможно';
																|en = 'Application is marked for deletion. Cannot update the state'"));
	Иначе
		// Обновляем состояние заявление
		// Статус не проверяем, так как при ненужном статусе не будет кнопки "Обновить" статус.
		ОбновитьСтатусыЗаявленийАбонентов_ИзФормыСписка(ДокументЗаявление, Форма.УникальныйИдентификатор, ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусыЗаявленийАбонентов_ИзФормыСписка(
		ДокументЗаявление 			= Неопределено,
		ИдентификаторФормыВладельца = "", 
		ВыполняемоеОповещение 		= Неопределено,
		ОрганизацияЗаявлений 		= Неопределено) Экспорт
	
	ЗаявленияАбонентов = ОбработкаЗаявленийАбонентаВызовСервера.ОтправленныеЗаявленияАбонентов(
		ДокументЗаявление, ОрганизацияЗаявлений);
		
	Если ЗаявленияАбонентов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Отсутствуют отправленные заявления';
																|en = 'No sent applications'"));
	КонецЕсли;
	
	НомерЗаявления = 0;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("НомерЗаявления", 				НомерЗаявления);
	ДополнительныеПараметры.Вставить("ЗаявленияАбонентов", 			ЗаявленияАбонентов);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 		ВыполняемоеОповещение);
	// Для того, чтобы сообщение "Статус заявления не изменился" получила нужная форма, а не бублик
	ДополнительныеПараметры.Вставить("ИдентификаторФормыВладельца", ИдентификаторФормыВладельца);
	
	ОбновитьСтатусыЗаявленийАбонентов_ПолучитьОтветВЦикле(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусыЗаявленийАбонентов_ПолучитьОтветВЦикле(ДополнительныеПараметры)
	
	// Относятся к предыдущему заявлению
	ДополнительныеПараметры.Удалить("РезультатОтветаСервера");
	ДополнительныеПараметры.Удалить("РеквизитыДокумента");
	
	НомерЗаявления 			= ДополнительныеПараметры.НомерЗаявления;
	ЗаявленияАбонентов 		= ДополнительныеПараметры.ЗаявленияАбонентов;
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;

	Если НомерЗаявления + 1 > ЗаявленияАбонентов.Количество() Тогда
			
		Если ВыполняемоеОповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		КонецЕсли;
		
	Иначе
		
		ОбновитьСтатусыЗаявленийАбонентов_ПолучитьОтветНаСледующееЗаявление(Истина, ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусыЗаявленийАбонентов_ПолучитьОтветНаСледующееЗаявление(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	НомерЗаявления		= ВходящийКонтекст.НомерЗаявления;
	ЗаявленияАбонентов 	= ВходящийКонтекст.ЗаявленияАбонентов;
	ДокументЗаявление	= ЗаявленияАбонентов[НомерЗаявления];
	
	Ответ = ПолучитьОтветСервераНаЗаявлениеАбонента(ДокументЗаявление);
	
	РеквизитыДокумента 		= Ответ.РеквизитыДокумента;
	РезультатОтветаСервера 	= Ответ.РезультатОтветаСервера;
	
	ВходящийКонтекст.Вставить("РеквизитыДокумента", РеквизитыДокумента);
	
	Если РезультатОтветаСервера.Свойство("СообщитьОбОтсутствииИнтернета") Тогда
		СообщитьОбОтсутствииИнтернета(ВходящийКонтекст);
		Возврат;
	КонецЕсли;
	
	ЗаявлениеТребуетНастройки = НЕ РеквизитыДокумента.НастройкаЗавершена
		И (РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено")
		ИЛИ РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено"));
		
	// Открываем форму настройки только если настройка требуется
	СтатусИзменился = РезультатОтветаСервера.СтатусИзменился ИЛИ ЗаявлениеТребуетНастройки;
		
	Если СтатусИзменился Тогда
		
		ВходящийКонтекст.Вставить("РезультатОтветаСервера", РезультатОтветаСервера);
		
		ВыполняемоеОповещение = Новый ОписаниеОповещения(
			"ОбновитьСтатусыЗаявленийАбонентов_ПерейтиКСледующемуЗаявлению", 
			ЭтотОбъект, 
			ВходящийКонтекст);
			
		ОткрытьФормуЗавершенияНастройкиМастера(
			ДокументЗаявление, 
			ВходящийКонтекст, 
			ВыполняемоеОповещение);

	Иначе
			
		СообщитьОбОтсутствииИзмененияВСтатусе(ВходящийКонтекст);
		ОбновитьСтатусыЗаявленийАбонентов_ПерейтиКСледующемуЗаявлению(Результат, ВходящийКонтекст);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусыЗаявленийАбонентов_ПерейтиКСледующемуЗаявлению(Результат, ДополнительныеПараметры) Экспорт
	
	ПараметрыПодключаемогоОбработчикаЗаявления = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительныеПараметры);
	
	// Обход ошибок платформы, исправленных в 8.3.11
	// {#10172430#}: Дочерняя форма исчезает при переключении в другое окно, родительская форма остается заблокированной
	// {#10177195#}: Блокируется форма "1С:Отчетность"
	// Ошибка воспроизводится в случае, если форма открывается и быстро закрывается программно, 
	// хотя фактически не успела закрыться.
	ПодключитьОбработчикОжидания("Подключаемый_ПерейтиКСледующемуЗаявлению", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПерейтиКСледующемуЗаявлению()
	
	ДополнительныеПараметры = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ПараметрыПодключаемогоОбработчикаЗаявления);
	ПараметрыПодключаемогоОбработчикаЗаявления = Неопределено;
	
	ДополнительныеПараметры.НомерЗаявления = ДополнительныеПараметры.НомерЗаявления + 1;
	ОбновитьСтатусыЗаявленийАбонентов_ПолучитьОтветВЦикле(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбОтсутствииИзмененияВСтатусе(ДополнительныеПараметры)
	
	ИдентификаторФормыВладельца = ДополнительныеПараметры.ИдентификаторФормыВладельца;
	РеквизитыДокумента 			= ДополнительныеПараметры.РеквизитыДокумента;
	
	ШаблонСообщения = НСтр("ru = 'Статус заявления %1 от %2 не изменился';
							|en = 'Status of %1 application dated %2 has not changed'");
	НомерЗаявления  = РеквизитыДокумента.Номер;
	ДатаЗаявления   = Формат(РеквизитыДокумента.Дата,"ДФ=dd.MM.yyyy");
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСообщения,
		НомерЗаявления,
		ДатаЗаявления);
			
	ДокументооборотСКОКлиентСервер.СообщитьПользователю(ТекстСообщения, ИдентификаторФормыВладельца);

КонецПроцедуры

#КонецОбласти

#Область ОповещениеОбОдобренииИлиОтклоненииЗаявления_СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПодключитьсяК1СЭДО(Результат, ВыполняемоеОповещение)
	
	// Есть возвращаемый результат - требуется выполнить подключение ЭДО
	ПодключитьЭДО 					= Результат.ПодключитьЭДО; 
	Организация 					= Результат.Организация; 
	ПараметрыЗапускаПодключениеЭДО 	= Результат.ПараметрыЗапускаПодключениеЭДО; 
	
	Если ПодключитьЭДО Тогда
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентПереопределяемый.ОткрытьФормуПодключенияКСервисуЭлектронныхДокументов(
			Организация, ПараметрыЗапускаПодключениеЭДО, ВыполняемоеОповещение);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ИмяФормыНастройкиЗаявления(ДокументЗаявление)

	РеквизитыЗаявления = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(ДокументЗаявление);
	
	Если РеквизитыЗаявления.ЭтоУпрощенноеЗаявление 
		И РеквизитыЗаявления.ТипЗаявления = ПредопределенноеЗначение("Перечисление.ТипыЗаявленияАбонентаСпецоператораСвязи.Первичное") Тогда
		ТекущееИмяФормы = ПутьКОбъекту + ".Форма.МастерФормированияЗаявкиНаПодключениеНастройкаПрограммыУпрощенный";
	Иначе
		ТекущееИмяФормы = ПутьКОбъекту + ".Форма.МастерФормированияЗаявкиНаПодключениеНастройкаПрограммы";
	КонецЕсли;
	
	Возврат ТекущееИмяФормы;

КонецФункции

&НаКлиенте
Функция ФормаОповещенияИлиМастераУжеОткрыта()
	
	Окна = ПолучитьОкна();
	
	Если Окна = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Имена проверяемых форм
	ИменаФорм = Новый Массив;
	ИменаФорм.Добавить("ОбщаяФорма.ОповещениеОбОдобренииЗаявленияАбонента");
	ИменаФорм.Добавить("Документ_ЗаявлениеАбонентаСпецоператораСвязи_ФормаДокумента");
	ИменаФорм.Добавить("СообщениеОбОдобренномЗаявлении");
	ИменаФорм.Добавить("СообщениеОбОтклоненномЗаявлении");
	ИменаФорм.Добавить("СообщениеОНеподключенномНаправлении");
	ИменаФорм.Добавить("СообщениеОНеобработанномЗаявлении");
	ИменаФорм.Добавить("ДлительноеДействие");
	ИменаФорм.Добавить("Мастер");
	
	Для Каждого ОткрытоеОкно Из Окна Цикл
		Если ОткрытоеОкно <> Неопределено Тогда
			ТекущаяФорма = ОткрытоеОкно.ПолучитьСодержимое();
			Если ТипЗнч(ТекущаяФорма) = Тип("УправляемаяФорма") Тогда
				
				Для каждого ТекущееИмяФормы Из ИменаФорм Цикл
					Если СтрНайти(ТекущаяФорма.ИмяФормы, ТекущееИмяФормы) <> 0 Тогда 
						Возврат Истина;
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ПолучитьОтветСервераНаЗаявлениеАбонента(ДокументЗаявление) Экспорт
	
	РезультатОтветаСервера = Новый Структура;
	РезультатОтветаСервера.Вставить("СтатусИзменился", Ложь);
	
	РеквизитыДокумента	= ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(ДокументЗаявление);
	
	Ответ = Новый Структура;
	Ответ.Вставить("РезультатОтветаСервера", РезультатОтветаСервера);
	Ответ.Вставить("РеквизитыДокумента", 	 РеквизитыДокумента);
	
	// Для заявления с ЭП в модели сервиса обязательно нужно сначала получить идентификатор ключевого контейнера.
	Если РеквизитыДокумента.ЭлектроннаяПодписьВМоделиСервиса Тогда
		
		ЗаявлениеОбработано = ОбработкаЗаявленийАбонентаВызовСервера.ОбработатьИзменениеСтатусаЗаявленияАбонентаВМоделиСервиса(ДокументЗаявление);
		
		Если ЗаявлениеОбработано Тогда
			
			// Обновляем структуру реквизитов в доп. параметрах после обращения к серверу.
			РеквизитыДокумента	= ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(ДокументЗаявление);
			
		Иначе
			
			Возврат Ответ;
			
		КонецЕсли;
		
	КонецЕсли;
		
	// Получаем ответ от сервера.
	Если РеквизитыДокумента.ЭлектроннаяПодписьВМоделиСервиса 
		И РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено") Тогда
		
		РезультатОтветаСервера = Новый Структура;
		РезультатОтветаСервера.Вставить("ОтпечатокСертификатаИзОтвета", "");
		РезультатОтветаСервера.Вставить("ИдентификаторАбонента", 		"");
		РезультатОтветаСервера.Вставить("СтатусИзменился", 				Истина);
		РезультатОтветаСервера.Вставить("Статус", 						РеквизитыДокумента.Статус);
		РезультатОтветаСервера.Вставить("Выполнено", 					Истина);
		РезультатОтветаСервера.Вставить("ПовторятьСоединение", 			Ложь);
		
	Иначе
		
		РезультатОтветаСервера = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьИРазобратьОтветНаЗаявление(ДокументЗаявление,,Истина);
		
		ПолученОтветНаЗаявление = РезультатОтветаСервера.Выполнено;
		ПовторятьСоединение 	= РезультатОтветаСервера.ПовторятьСоединение;
		
		Если НЕ ПолученОтветНаЗаявление И ПовторятьСоединение Тогда
			РезультатОтветаСервера.Вставить("СообщитьОбОтсутствииИнтернета", Истина);
		Иначе
			// Обновляем структуру реквизитов в доп. параметрах после обращения к серверу.
			РеквизитыДокумента = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(ДокументЗаявление);
		КонецЕсли;
		
	КонецЕсли;
	
	Ответ.Вставить("РезультатОтветаСервера", РезультатОтветаСервера);
	Ответ.Вставить("РеквизитыДокумента", 	 РеквизитыДокумента);
	
	Возврат Ответ;
	
КонецФункции

&НаКлиенте
Процедура СообщитьОбОтсутствииИнтернета(ДополнительныеПараметры)
	
	ОписаниеОшибки 		= НСтр("ru = 'Не удалось обратиться к серверу обновлений';
									|en = 'Cannot contact the update server'");
	ОписаниеОповещения 	= Новый ОписаниеОповещения("ОбновитьСтатусыЗаявленийАбонентов_ПолучитьОтветНаСледующееЗаявление", ЭтотОбъект, ДополнительныеПараметры);
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(ОписаниеОшибки, ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗавершенияНастройкиМастера(
		ДокументЗаявление, 
		ВходящийКонтекст, 
		ВыполняемоеОповещение) Экспорт
	
	РезультатОтветаСервера 	= ВходящийКонтекст.РезультатОтветаСервера;
	
	Если НЕ РезультатОтветаСервера.Свойство("ИдентификаторАбонента")
		ИЛИ НЕ РезультатОтветаСервера.Свойство("Статус")
		ИЛИ НЕ РезультатОтветаСервера.Свойство("ОтпечатокСертификатаИзОтвета") Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("Ключ",							ДокументЗаявление);
	СтруктураПараметров.Вставить("СтруктураРеквизитовДокумента", 	ДокументЗаявление); 
	СтруктураПараметров.Вставить("ИдентификаторАбонента", 			РезультатОтветаСервера.ИдентификаторАбонента);
	СтруктураПараметров.Вставить("НовыйСтатусДокумента", 			РезультатОтветаСервера.Статус);
	СтруктураПараметров.Вставить("ОтпечатокСертификатаИзОтвета", 	РезультатОтветаСервера.ОтпечатокСертификатаИзОтвета);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОткрытьФормуЗавершенияНастройкиМастера_ПослеЗакрытияФормы", 
		ЭтотОбъект, 
		ВыполняемоеОповещение);
	
	ИмяФормыНастройки = ИмяФормыНастройкиЗаявления(ДокументЗаявление);
	
	ОткрытьФорму(
		ИмяФормыНастройки,
		СтруктураПараметров,,,,,
		ОписаниеОповещения, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗавершенияНастройкиМастера_ПослеЗакрытияФормы(Результат, ВыполняемоеОповещение) Экспорт
	
	Если ЗначениеЗаполнено(Результат) 
		И ТипЗнч(Результат) = Тип("Структура") Тогда
		
		Если Результат.Свойство("ПодключитьЭДО") Тогда
			// После закрытия мастера завершаем подключение к ЭДО
			ПодключитьсяК1СЭДО(Результат, ВыполняемоеОповещение);
		Иначе
			// После закрытия мастера требуется создать заявление копированием, так как на это получили отказ.
			Результат.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
			ОткрытьФормуЗаявления(Результат);
		КонецЕсли;
			
	Иначе
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
			
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

&НаКлиенте
Процедура ПолучитьМенеджерИСертификатКриптографии(СертификатДляПодписания, ВыполняемоеОповещение) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("СертификатДляПодписания", СертификатДляПодписания);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПолучитьМенеджерИСертификатКриптографии_ПослеПопыткиУстановкиРасширенияРаботыСКриптографией", 
		ЭтотОбъект,
		ДополнительныеПараметры,
		"ПолучитьМенеджерИСертификатКриптографии_ОбработчикОшибкиСертификата",
		ЭтотОбъект);
		
	ЭлектроннаяПодписьКлиент.УстановитьРасширение(Ложь, ОписаниеОповещения);
		
КонецПроцедуры
	
&НаКлиенте
Процедура ПолучитьМенеджерИСертификатКриптографии_ПослеПопыткиУстановкиРасширенияРаботыСКриптографией(РасширениеУстановлено, ВходящийКонтекст) Экспорт
	
	Если РасширениеУстановлено = Истина Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПолучитьМенеджерИСертификатКриптографии_ПослеИнициализацииМенеджераКриптографии", 
			ЭтотОбъект,
			ВходящийКонтекст,
			"ПолучитьМенеджерИСертификатКриптографии_ОбработчикОшибкиСертификата",
			ЭтотОбъект);
			
		// Извлекаем криптопровайдер из сертификата
		МассивИзОдного = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВходящийКонтекст.СертификатДляПодписания);
		ИнформацияОСертификате = КриптографияЭДКОСлужебныйВызовСервера.ИзвлечьИнформациюОКриптопровайдереПоСертификату(
			МассивИзОдного,
			Истина);
		Если ИнформацияОСертификате.Количество() > 0 Тогда
			СвойстваКриптопровайдера = ИнформацияОСертификате[0].Криптопровайдер;
		Иначе
			ПолучитьМенеджерИСертификатКриптографии_СообщитьОНеготовностиМенеджераКриптографии(Истина, ВходящийКонтекст);
		КонецЕсли;
		
		МенеджерКриптографии = Новый МенеджерКриптографии();
		МенеджерКриптографии.НачатьИнициализацию(
			ОписаниеОповещения, 
			СвойстваКриптопровайдера.Имя,
			СвойстваКриптопровайдера.Путь,
			СвойстваКриптопровайдера.Тип);
		
	Иначе
		
		ПолучитьМенеджерИСертификатКриптографии_СообщитьОНеготовностиМенеджераКриптографии(РасширениеУстановлено, ВходящийКонтекст);
			
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьМенеджерИСертификатКриптографии_ОбработчикОшибкиСертификата(ИнформацияОбОшибке, СтандартнаяОбработка, ВходящийКонтекст) Экспорт
	
	СтандартнаяОбработка = Ложь;
	ПолучитьМенеджерИСертификатКриптографии_СообщитьОНеготовностиМенеджераКриптографии(Ложь, ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьМенеджерИСертификатКриптографии_ПослеИнициализацииМенеджераКриптографии(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Неопределено Тогда
		
		ВходящийКонтекст.Вставить("МенеджерКриптографии", Неопределено);
		ПолучитьМенеджерИСертификатКриптографии_СообщитьОНеготовностиМенеджераКриптографии(Ложь, ВходящийКонтекст);
		
	Иначе
		
		ВходящийКонтекст.Вставить("МенеджерКриптографии", Результат);
			
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПолучитьМенеджерИСертификатКриптографии_ПослеЭкспортаСертификатаВФайл",
			ЭтотОбъект,
			ВходящийКонтекст);
			
		КриптографияЭДКОКлиент.ЭкспортироватьСертификатВФайл(
			ОписаниеОповещения, 
			ВходящийКонтекст.СертификатДляПодписания, 
			, 
			Ложь);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьМенеджерИСертификатКриптографии_ПослеЭкспортаСертификатаВФайл(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПолучитьМенеджерИСертификатКриптографии_ПослеИнициализацииСертификата", 
			ЭтотОбъект,
			ВходящийКонтекст,
			"ПолучитьМенеджерИСертификатКриптографии_ОбработчикОшибкиСертификата",
			ЭтотОбъект);
			
		СертификатКриптографии = Новый СертификатКриптографии;
		СертификатКриптографии.НачатьИнициализацию(ОписаниеОповещения, Результат.ИмяФайлаСертификата); 
		
	Иначе
		ПолучитьМенеджерИСертификатКриптографии_СообщитьОНеготовностиМенеджераКриптографии(Ложь, ВходящийКонтекст);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьМенеджерИСертификатКриптографии_ПослеИнициализацииСертификата(РезультатИнициализации, ВходящийКонтекст) Экспорт
	
	Если РезультатИнициализации <> Неопределено Тогда
		
		Результат = Новый Структура();
		Результат.Вставить("Выполнено", Истина);
		Результат.Вставить("СертификатКриптографии", 	РезультатИнициализации);
		Результат.Вставить("МенеджерКриптографии", 		ВходящийКонтекст.МенеджерКриптографии);
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, Результат);
		
	Иначе
		ПолучитьМенеджерИСертификатКриптографии_СообщитьОНеготовностиМенеджераКриптографии(Ложь, ВходящийКонтекст);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьМенеджерИСертификатКриптографии_СообщитьОНеготовностиМенеджераКриптографии(РасширениеУстановлено, ВходящийКонтекст)
	
	//   РасширениеУстановлено
	//       * Истина - Пользователь подтвердил установку, после установки расширение было успешно подключено.
	//       * Ложь   - Пользователь подтвердил установку, однако после установки расширение не удалось подключить.
	//       * Неопределено - Пользователь отказался от установки.

	Результат = Новый Структура();
	Результат.Вставить("Выполнено", РасширениеУстановлено);
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, Результат);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьАдрес(НовыйАдрес, ВидАдреса, ВыполняемоеОповещение, ЭтоЮридическоеЛицо) Экспорт
	
	Форма = ВыполняемоеОповещение.Модуль;
	СпроситьПроАвтозаполнениеАдреса = Ложь;
	
	Если НовыйАдрес.Модифицированность Тогда
		
		Если ВидАдреса = "АдресЮридический" Тогда
			ДругойАдрес = "АдресФактический";
		Иначе
			ДругойАдрес = "АдресЮридический";
		КонецЕсли;
		
		АдресЗначение       = ВидАдреса + "Значение";
		ДругойАдресЗначение = ДругойАдрес + "Значение";
			
		НовыйАдресЗаполнен    = ЗначениеЗаполнено(НовыйАдрес.АдресПредставление);
		АдресаРаньшеСовпадали = Форма[АдресЗначение] = Форма[ДругойАдресЗначение];
			
		АдресИзменился        = Форма[АдресЗначение] <> НовыйАдрес.Адрес;
		ДругойАдресПустой     = НЕ ЗначениеЗаполнено(Форма[ДругойАдресЗначение]);
		
		Форма[ВидАдреса + "Значение"] 		= НовыйАдрес.Адрес;
		Форма[ВидАдреса + "Представление"]  = НовыйАдрес.АдресПредставление;
		
		СпроситьПроАвтозаполнениеАдреса = НовыйАдресЗаполнен
			И АдресИзменился И (АдресаРаньшеСовпадали ИЛИ ДругойАдресПустой);
		
	КонецЕсли;
	
	Если СпроситьПроАвтозаполнениеАдреса Тогда
		ПредложитьАвтозаполнениеАдреса(ВидАдреса, ВыполняемоеОповещение, ЭтоЮридическоеЛицо);
	Иначе
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьАвтозаполнениеАдреса(ВидАдреса, ВыполняемоеОповещение, ЭтоЮридическоеЛицо)
	
	Если ЭтоЮридическоеЛицо Тогда
		Если ВидАдреса = "АдресЮридический" Тогда
			ТекстВопроса = НСтр("ru = 'Заполнить фактический адрес по юридическому?';
								|en = 'Fill in physical address by legal address?'");
		Иначе
			ТекстВопроса = НСтр("ru = 'Заполнить юридический адрес по фактическому?';
								|en = 'Fill in legal address by physical address?'");
		КонецЕсли;
	Иначе
		Если ВидАдреса = "АдресЮридический" Тогда
			ТекстВопроса = НСтр("ru = 'Заполнить фактический адрес проживания по адресу регистрации?
                                 |Адрес регистрации также отправляется в составе заявления и доступен для изменения в форме расширенных настроек.';
                                 |en = 'Fill in physical residential address according to the registered address?
                                 |The registered address is also sent in the application, you can change it in the form of advanced settings.'");
		Иначе
			ТекстВопроса = НСтр("ru = 'Заполнить адрес регистрации по фактическому адресу проживания?';
								|en = 'Fill in registration address with actual address?'");
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидАдреса", ВидАдреса);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОбновитьАдресПослеВопросаОКопированииАдреса", 
		ЭтотОбъект, 
		ДополнительныеПараметры); 
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет); 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьАдресПослеВопросаОКопированииАдреса(ОтветПользователя, ВходящийКонтекст) Экспорт
	
	Форма = ВходящийКонтекст.ВыполняемоеОповещение.Модуль;
	
	Если ОтветПользователя = КодВозвратаДиалога.Да Тогда
		Если ВходящийКонтекст.ВидАдреса = "АдресЮридический" Тогда
			Форма["АдресФактическийЗначение"]      = Форма["АдресЮридическийЗначение"];
			Форма["АдресФактическийПредставление"] = Форма["АдресЮридическийПредставление"];
		Иначе
			Форма["АдресЮридическийЗначение"]      = Форма["АдресФактическийЗначение"];
			Форма["АдресЮридическийПредставление"] = Форма["АдресФактическийПредставление"];
		КонецЕсли;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
	
КонецПроцедуры

#КонецОбласти

#Область НастройкиОбмена

// Выполняет поиск сертификатов в хранилище по их серийному номеру и издателю сертификата или по отпечатку.
//
// Параметры:
//  ОповещениеОЗавершении - ОписаниеОповещения - описание процедуры, принимающей результат.
//    Результат - Структура:
//      * ПоискСертификатовВыполнен                - Булево.
//      * ТекущаяДатаНаСервере                     - Дата.
//      * ПоддерживаемыеНаправленияДляОператоров   - Неопределено - при Настройки.ПолучатьПоддерживаемыеНаправленияДляОператоров = Ложь.
//                                                 - Соответствие:
//        ** Ключ                                  - ПеречислениеСсылка.СпецоператорыСвязи - операторы, поддерживающие регистрацию.
//        ** Значение                              - Структура:
//           *** ПризнакПоддержкиФСРАР             - Булево.
//           *** ПризнакПоддержкиРПН               - Булево.
//           *** ПризнакПоддержкиФТС               - Булево.
//      * ПоддерживаетсяСдачаОтчетностиВБанкРоссии - Булево.
//      * СписокПользователейБазы                  - СписокЗначений - все пользователи базы, для текущего указана
//                                                                    картинка БиблиотекаКартинок.Пользователь.
//      * НастройкиОбмена                          - Массив:
//        ** ИндексОрганизации                       - Число.
//        ** Организация                             - СправочникСсылка.Организации.
//        ** ТипОрганизации                          - Булево - Истина, если это юридическое лицо.
//        ** НаименованиеСокращенное                 - Строка - краткое наименование организации или ИП, может быть пустым.
//        ** НаименованиеОрганизации                 - Строка.
//        ** КодНО                                   - Строка - из организации, присутствует, если
//                                                              Настройки.ПолучитьРеквизитыКонтролирующихОргановОрганизации = Истина.
//        ** КодОрганаФСГС                           - Строка - из организации, присутствует, если
//                                                              Настройки.ПолучитьРеквизитыКонтролирующихОргановОрганизации = Истина.
//        ** КППЮЛ                                   - Строка - для ИП содержит пустую строку, присутствует, если
//                                                              Настройки.ПолучитьРеквизитыКонтролирующихОргановОрганизации = Истина.
//        ** РегНомПФР                               - Строка - при использовании ИП наемных работников сюда переносится
//                                                              регистрационный номер ПФР за себя, присутствует, если
//                                                              Настройки.ПолучитьРеквизитыКонтролирующихОргановОрганизации = Истина.
//        ** РегистрационныйНомерФСС                 - Строка - при использовании ИП наемных работников сюда переносится
//                                                              регистрационный номер ФСС добровольного страхования, присутствует, если
//                                                              Настройки.ПолучитьРеквизитыКонтролирующихОргановОрганизации = Истина.
//        ** ПометкаУдаления                         - Булево - из организации.
//        ** ВидОбменаСКонтролирующимиОрганами       - ПеречислениеСсылка.ВидыОбменаСКонтролирующимиОрганами.
//        ** УчетнаяЗаписьОбмена                     - СправочникСсылка.УчетныеЗаписиДокументооборота.
//        ** ПравоЧтенияУчетнойЗаписиОбмена          - Булево.
//        ** СпецоператорСвязи                       - ПеречислениеСсылка.СпецоператорыСвязи.
//        ** НаименованиеОператора                   - Строка - СпецоператорСвязи.
//        ** РежимАвтонастройки                      - ПеречислениеСсылка.РежимыАвтонастройкиУчетнойЗаписиНалогоплательщика.
//        ** ПредназначенаДляДокументооборотаСФНС    - Булево - из учетной записи документооборота.
//        ** ПредназначенаДляДокументооборотаСПФР    - Булево - из учетной записи документооборота.
//        ** ПредназначенаДляДокументооборотаСФСГС   - Булево - из учетной записи документооборота
//        ** СертификатРуководителя                  - Строка - отпечаток из учетной записи документооборота.
//        ** СвойстваСертификатаРуководителя         - Структура    - описание см. КриптографияЭДКОКлиент.НайтиСертификаты.
//                                                   - Неопределено - если ПоискСертификатовВыполнен = Ложь.
//        ** ЛицензияНаименование                    - Строка.
//        ** ЛицензияДатаОкончания                   - Дата.
//                                                   - Неопределено.
//        ** ЛицензияТребуетсяНапоминаниеОбОкончанииСрокаДействия - Булево.
//        ** ЭлектроннаяПодписьВМоделиСервиса        - Булево.
//        ** ДатаПодключения                         - Дата         - наиболее ранняя дата из учетной записи
//                                                                    документооборота или заявления на подключение, изменение.
//                                                   - Неопределено - до поддержки даты в учетной записи, нет заявлений.
//        ** СдаватьВФНС                             - Булево - информация по данным файла автонастройки.
//        ** СдаватьВПФР                             - Булево - информация по данным файла автонастройки.
//        ** СдаватьВФСГС                            - Булево - информация по данным файла автонастройки.
//        ** СдаватьВФСС                             - Булево - информация по данным файла автонастройки.
//        ** СдаватьВФСРАР                           - Булево - информация по данным файла автонастройки.
//        ** СдаватьВРПН                             - Булево - информация по данным файла автонастройки.
//        ** СдаватьВФТС                             - Булево - информация по данным файла автонастройки.
//        ** СдаватьВБанкРоссии                      - Булево - всегда Ложь.
//        ** СдаватьВМинобороны                      - Булево - всегда Ложь.
//        ** КодыФНС                                 - Массив - информация по данным файла автонастройки:
//           *** Код                                   - Строка.
//           *** КПП                                   - Строка.
//        ** КодПФР                                  - Строка.
//        ** КодыФСГС                                - Массив.
//        ** СписокПользователей                     - СписокЗначений - все пользователи, для пользователей учетной записи
//                                                                      документооборота установлена Пометка, для текущего указана
//                                                                      картинка БиблиотекаКартинок.Пользователь.
//        ** НастройкиОбменаФСС_ИспользоватьОбмен    - Булево.
//        ** НастройкиОбменаФСС_ИспользоватьАвтонастройку - Булево.
//        ** НастройкиОбменаФСС_СертификатСтрахователяОтпечаток - Строка.
//        ** НастройкиОбменаФСС_СвойстваСертификатаСтрахователя - Структура -    описание см. КриптографияЭДКОКлиент.НайтиСертификаты,
//                                                                               присутствует, если
//                                                                               Настройки.НайтиСертификатыПрочихКонтролирующихОрганов = Истина.
//                                                              - Неопределено - если ПоискСертификатовВыполнен = Ложь.
//        ** НастройкиОбменаФСРАР_ИспользоватьОбмен   - Булево.
//        ** НастройкиОбменаФСРАР_ИспользоватьАвтонастройку - Булево.
//        ** НастройкиОбменаФСРАР_СертификатАбонентаОтпечаток - Строка.
//        ** НастройкиОбменаФСРАР_СвойстваСертификатаАбонента - Структура    - описание см. КриптографияЭДКОКлиент.НайтиСертификаты,
//                                                                             присутствует, если
//                                                                             Настройки.НайтиСертификатыПрочихКонтролирующихОрганов = Истина.
//                                                            - Неопределено - если ПоискСертификатовВыполнен = Ложь.
//        ** НастройкиОбменаРПН_ИспользоватьОбмен     - Булево.
//        ** НастройкиОбменаРПН_ИспользоватьАвтонастройку - Булево.
//        ** НастройкиОбменаРПН_СертификатАбонентаОтпечаток - Строка.
//        ** НастройкиОбменаРПН_СвойстваСертификатаАбонента - Структура    - описание см. КриптографияЭДКОКлиент.НайтиСертификаты,
