&НаСервереБезКонтекста
Функция ПредставлениеТранспортногоСообщения(Сообщение) Экспорт
	
	Если ЗначениеЗаполнено(Сообщение.ЦиклОбмена) Тогда
		Возврат "" + Сообщение.Тип + ", связанное с циклом обмена " + Сообщение.ЦиклОбмена;
	Иначе
		Возврат Сообщение;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция СоздатьИЗаполнитьОтветноеСообщение(Основание)
	
	КонтекстЭДО = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДО.СоздатьИЗаполнитьОтветноеСообщение(Основание);
	
КонецФункции

&НаКлиенте
Процедура ВвестиПодтверждение(ОповещениеОЗавершении, ЦиклОбмена, Основание = Неопределено) Экспорт
	
	Если ТипЗнч(Основание) = Тип("ПеречислениеСсылка.ТипыТранспортныхСообщений") Тогда
		СообщениеОснование = ПолучитьСообщениеЦиклаОбмена(ЦиклОбмена, Основание);
	Иначе
		СообщениеОснование = Основание;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СообщениеОснование) Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	СоздатьПодтверждение(ОповещениеОЗавершении, СообщениеОснование);
	
КонецПроцедуры
 
&НаКлиенте
Процедура СоздатьПодтверждение(ОповещениеОЗавершении, Основание) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	// создаем на сервере
	ОтветноеСообщение = СоздатьИЗаполнитьОтветноеСообщение(Основание);
	Если ОтветноеСообщение = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	КонтекстОтправки = Новый Структура("Подтверждение", ОтветноеСообщение.Ссылка);
	
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	Контекст.Вставить("Подтверждение", ОтветноеСообщение.Ссылка);
	Оповещение = Новый ОписаниеОповещения(
		"СоздатьПодтверждениеПослеПодписанияСообщения", ЭтотОбъект, Контекст);
	
	// различные действия на сервере в зависимости от типа сообщения
	ТипОснования = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЗначениеРеквизитаОбъекта(Основание, "Тип");
	Если ТипОснования = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_ПротоколПФР Тогда
		
		ПодписатьСообщение("ПФР", Оповещение, КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Руководитель", , ОтветноеСообщение.УчетнаяЗапись, Основание);
		
	ИначеЕсли ТипОснования = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_ПисьмоВходящееПФР Тогда
		
		ПодписатьСообщение("ПФР", Оповещение, КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Руководитель", , ОтветноеСообщение.УчетнаяЗапись, Основание);
		
	ИначеЕсли ТипОснования = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_ПодтверждениеДатыОтправкиФСГС Тогда
		
		ПодписатьСообщение("ФСГС", Оповещение, КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Руководитель", , ОтветноеСообщение.УчетнаяЗапись, Основание);
	
	ИначеЕсли ТипОснования = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_ПротоколВходногоКонтроляОтчетностиФСГС Тогда
		
		СформироватьИзвещениеОПолученииФСГС(ОтветноеСообщение.Ссылка);
		ПодписатьСообщение("ФСГС", Оповещение, КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Руководитель", , ОтветноеСообщение.УчетнаяЗапись, Основание);
		
	ИначеЕсли ТипОснования = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_ПисьмоВходящееФСГС Тогда
		
		СформироватьИзвещениеОПолученииФСГС(ОтветноеСообщение.Ссылка);
		ПодписатьСообщение("ФСГС", Оповещение, КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Руководитель", , ОтветноеСообщение.УчетнаяЗапись, Основание);
		
	ИначеЕсли ТипОснования = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_ПодтверждениеДекларацияНО Тогда
		
		Если НЕ СформироватьИзвещениеОПолученииНаСервере(ОтветноеСообщение.Ссылка) Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
			Возврат;
		КонецЕсли;
		
		ПодписатьСообщение("ФНС", Оповещение, КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Шифрование", , ОтветноеСообщение.УчетнаяЗапись, Основание);
		
	ИначеЕсли ТипОснования = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_ПодтверждениеФорма2НДФЛНО Тогда
		
		Если НЕ СформироватьИзвещениеОПолученииНаСервере(ОтветноеСообщение.Ссылка) Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
			Возврат;
		КонецЕсли;
		
		ПодписатьСообщение("ФНС", Оповещение, КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Шифрование", , ОтветноеСообщение.УчетнаяЗапись, Основание);
		
	ИначеЕсли ТипОснования = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_ПодтверждениеОбращениеНО Тогда
		
		Если НЕ СформироватьИзвещениеОПолученииНаСервере(ОтветноеСообщение.Ссылка) Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
			Возврат;
		КонецЕсли;
		
		ПодписатьСообщение("ФНС", Оповещение, КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Шифрование", , ОтветноеСообщение.УчетнаяЗапись, Основание);
		
	ИначеЕсли ТипОснования = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_ПодтверждениеПредставлениеНО Тогда
		
		Если НЕ СформироватьИзвещениеОПолученииНаСервере(ОтветноеСообщение.Ссылка) Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
			Возврат;
		КонецЕсли;
		
		ПодписатьСообщение("ФНС", Оповещение, КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Шифрование", , ОтветноеСообщение.УчетнаяЗапись, Основание);
		
	ИначеЕсли ТипОснования = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_ПодтверждениеЗапросНО Тогда
		
		Если НЕ СформироватьИзвещениеОПолученииНаСервере(ОтветноеСообщение.Ссылка) Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
			Возврат;
		КонецЕсли;
		
		ПодписатьСообщение("ФНС", Оповещение, КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Шифрование", , ОтветноеСообщение.УчетнаяЗапись, Основание);
		
	ИначеЕсли ТипОснования = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_РезультатПриемаДекларацияНО Тогда
		
		Если НЕ СформироватьИзвещениеОПолученииНаСервере(ОтветноеСообщение.Ссылка) Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
			Возврат;
		КонецЕсли;
		
		ПодписатьСообщение("ФНС", Оповещение, КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Шифрование", , ОтветноеСообщение.УчетнаяЗапись, Основание);
		
	ИначеЕсли ТипОснования = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_РезультатПриемаФорма2НДФЛНО Тогда
		
		Если НЕ СформироватьИзвещениеОПолученииНаСервере(ОтветноеСообщение.Ссылка) Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
			Возврат;
		КонецЕсли;
		
		ПодписатьСообщение("ФНС", Оповещение, КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Шифрование", , ОтветноеСообщение.УчетнаяЗапись, Основание);
		
