	ПараметрыФормированияПакета         = ДополнительныеПараметры.ПараметрыФормированияПакета;
	ИнформацияОРегионе                  = ДополнительныеПараметры.ИнформацияОРегионе;
	СхемаСдачиОтчетности                = ДополнительныеПараметры.СхемаСдачиОтчетности;
	КороткоеИмяФайлаПакета              = ДополнительныеПараметры.КороткоеИмяФайлаПакета;
	Крипт                               = ДополнительныеПараметры.Крипт;
	СтрокаBase64ФайлаПакета             = ДополнительныеПараметры.СтрокаBase64ФайлаПакета;
	СтрокаBase64ФайлаОтправки           = ДополнительныеПараметры.СтрокаBase64ФайлаОтправки;
	КодИНаименованиеРегиона             = ДополнительныеПараметры.КодИНаименованиеРегиона;
	ФормаДлительнаяОперация             = ДополнительныеПараметры.ФормаДлительнаяОперация;
	ПараметрыОтправки                   = ДополнительныеПараметры.ПараметрыОтправки;
	ПодписанныйПакетДляАвторизации      = ДополнительныеПараметры.ПодписанныйПакетДляАвторизации;
	РезультатОтправки                   = ДополнительныеПараметры.РезультатОтправки;
	ПерваяПопыткаАвторизации            = ДополнительныеПараметры.ПерваяПопыткаАвторизации;
	ЗначениеCAPTCHA                     = ДополнительныеПараметры.ЗначениеCAPTCHA;
	КороткоеИмяФайлаПакета              = ДополнительныеПараметры.КороткоеИмяФайлаПакета;
	
	Если НЕ Результат.Выполнено Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСРАР.
		Возврат;
	КонецЕсли;
	
	СтрокаBase64ФайлаПакета = Результат.СтрокаBase64;
	
	СтрокаBase64ФайлаОтправки = СформироватьФайлОтправкиВФСРАРНаСервере(
		КороткоеИмяФайлаПакета,
		СхемаСдачиОтчетности,
		СтрокаBase64ФайлаПакета,
		ЭтоЭлектроннаяПодписьВМоделиСервиса,
		Форма.УникальныйИдентификатор,
		ЗначениеCAPTCHA);
	
	Данные64CAPTCHA = "";
	Крипт = СертификатыИПараметрыОбмена.Крипт;
	
	ПараметрыСоединения.ТребуетсяРегистрация          = Неопределено;
	ПараметрыСоединения.ТребуетсяПовторнаяАвторизация = Неопределено;
	
	РезультатОтправки = ОтправитьВФСРАРНаСервере(
		ЭтоЭлектроннаяПодписьВМоделиСервиса,
		СтрокаBase64ФайлаОтправки,
		СтрокаBase64ФайлаПакета,
		"",
		КороткоеИмяФайлаПакета,
		ОтчетСсылка,
		ПараметрыОтправки,
		ПараметрыСоединения,
		Данные64CAPTCHA);
	
	ДлительнаяОтправкаКлиент.ВывестиСообщенияССервераНаКлиенте(ПараметрыСоединения.СообщенияПользователю);

	ПерваяПопыткаАвторизации = Ложь;
	
	// Рекурсивный вызов по условию (замена цикла)
	Если РезультатОтправки = Неопределено И ЗначениеЗаполнено(Данные64CAPTCHA) Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОтчетСсылка",                         ОтчетСсылка);
		ДополнительныеПараметры.Вставить("УчетнаяЗапись",                       УчетнаяЗапись);
		ДополнительныеПараметры.Вставить("ФедеральныйПортал",                   ФедеральныйПортал);
		ДополнительныеПараметры.Вставить("Форма",                               Форма);
		ДополнительныеПараметры.Вставить("ЭтоРегламентированныйОтчет",          ЭтоРегламентированныйОтчет);
		ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
		ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена",         СертификатыИПараметрыОбмена);
		ДополнительныеПараметры.Вставить("ПараметрыСоединения",                 ПараметрыСоединения);
		ДополнительныеПараметры.Вставить("РезультатВыгрузки",                   РезультатВыгрузки);
		ДополнительныеПараметры.Вставить("ПараметрыФормированияПакета",         ПараметрыФормированияПакета);
		ДополнительныеПараметры.Вставить("ИнформацияОРегионе",                  ИнформацияОРегионе);
		ДополнительныеПараметры.Вставить("СхемаСдачиОтчетности",                СхемаСдачиОтчетности);
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаПакета",              КороткоеИмяФайлаПакета);
		ДополнительныеПараметры.Вставить("Крипт",                               Крипт);
		ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаПакета",             СтрокаBase64ФайлаПакета);
		ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаОтправки",           СтрокаBase64ФайлаОтправки);
		ДополнительныеПараметры.Вставить("КодИНаименованиеРегиона",             КодИНаименованиеРегиона);
		ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация",             ФормаДлительнаяОперация);
		ДополнительныеПараметры.Вставить("ПараметрыОтправки",                   ПараметрыОтправки);
		ДополнительныеПараметры.Вставить("ПодписанныйПакетДляАвторизации",      ПодписанныйПакетДляАвторизации);
		ДополнительныеПараметры.Вставить("РезультатОтправки",                   РезультатОтправки);
		ДополнительныеПараметры.Вставить("ПерваяПопыткаАвторизации",            ПерваяПопыткаАвторизации);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРОтправкаПослеВводаПароляЗавершение",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		ВызватьФормуВводаCAPTCHA(Данные64CAPTCHA, НСтр("ru = 'Для отправки отчета просим ввести защитный код.';
														|en = 'To send the report, enter the security code.'"), ОписаниеОповещения);
		
		Возврат;
		
	КонецЕсли;
	
	Если РезультатОтправки = Неопределено И ПараметрыСоединения.ПовторятьЗапросПароля Тогда
			
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРВводПароля(
			ОтчетСсылка,
			УчетнаяЗапись,
			ФедеральныйПортал,
			Форма,
			ЭтоРегламентированныйОтчет,
			ЭтоЭлектроннаяПодписьВМоделиСервиса,
			СертификатыИПараметрыОбмена,
			ПараметрыСоединения,
			РезультатВыгрузки,
			ПараметрыФормированияПакета,
			ИнформацияОРегионе,
			СхемаСдачиОтчетности,
			КороткоеИмяФайлаПакета,
			Крипт,
			СтрокаBase64ФайлаПакета,
			СтрокаBase64ФайлаОтправки,
			КодИНаименованиеРегиона,
			ФормаДлительнаяОперация,
			ПараметрыОтправки,
			ПодписанныйПакетДляАвторизации,
			РезультатОтправки,
			ПерваяПопыткаАвторизации);
					
		Возврат;
		
	КонецЕсли;

	ДлительнаяОтправкаКлиент.ВывестиСообщенияССервераНаКлиенте(ПараметрыСоединения.СообщенияПользователю);
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеОтправки(
		ОтчетСсылка,
		УчетнаяЗапись,
