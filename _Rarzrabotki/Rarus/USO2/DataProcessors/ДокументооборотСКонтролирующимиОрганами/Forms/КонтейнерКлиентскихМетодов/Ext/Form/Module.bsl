Функция ПолучитьИмяФайлаКартыРелизов(КлючевойФайл)
	
	// считываем содержимое ключевого файла
	ТекстКлючевогоФайла = ПрочитатьТекстИзФайла(КлючевойФайл);
	
	// выделяем имя файла-карты
	СтрРазделитель = "=";
	ВхождениеРазделителя = СтрНайти(ТекстКлючевогоФайла, СтрРазделитель);
	Если НЕ ЗначениеЗаполнено(ВхождениеРазделителя) Тогда
		Возврат Неопределено;
	Иначе
		Возврат СокрЛП(Сред(ТекстКлючевогоФайла, ВхождениеРазделителя + 1));
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция РаспаковатьФайл(ФайлАрхива, ОписаниеОшибки = Неопределено)
	
	// создаем временный каталог
	ВременныйКаталог = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ВременныйКаталог);
	
	// определяем временный файл
	ФайлРезультат = ПолучитьИмяВременногоФайла("xml");
	
	// распаковываем во временный каталог
	Попытка
		ЧтениеЗИП = Новый ЧтениеZipФайла(ФайлАрхива);
		ПервыйЭлементАрхива = ЧтениеЗИП.Элементы.Получить(0);
		ЧтениеЗИП.Извлечь(ПервыйЭлементАрхива, ВременныйКаталог, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
		ЧтениеЗИП.Закрыть();
	Исключение
		ОписаниеОшибки = ИнформацияОбОшибке().Описание;
		Возврат Неопределено;
	КонецПопытки;
	
	// ищем файл в каталоге распаковки
	РезультатПоиска = НайтиФайлы(ВременныйКаталог, "*.*");
	Если РезультатПоиска.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// переименовываем файл из архива
	ПервыйФайл = РезультатПоиска.Получить(0);
	ПереместитьФайл(ПервыйФайл.ПолноеИмя, ФайлРезультат);
	
	// удаляем каталог распаковки
	УдалитьФайлы(ВременныйКаталог);
	
	Возврат ФайлРезультат;
	
КонецФункции

&НаСервере
Функция РаспаковатьСохранитьСправочникВКэше(ФайлКартаРелизовАрхив, ИмяФайлаКартыРелизовБезРасширения, ШапкаОшибки, СвойстваМодуляДляТекущегоРелиза)
	
	// распаковываем
	ОписаниеОшибки = "";
	ФайлКартаРелизов = РаспаковатьФайл(ФайлКартаРелизовАрхив, ОписаниеОшибки);
	УдалитьФайлы(ФайлКартаРелизовАрхив);
	Если НЕ ЗначениеЗаполнено(ФайлКартаРелизов) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1%2.';
																						|en = '%1%2.'"),
		ШапкаОшибки + Символы.ПС + Символы.ПС,
		Символы.ПС + ОписаниеОшибки);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// загружаем справочник в дерево
	ТекстФайлаСправочника = "";
	ОписаниеОшибки = "";
	
	ДеревоКартыРелизов = ЗагрузитьXMLВДеревоЗначений(ФайлКартаРелизов, ТекстФайлаСправочника, ОписаниеОшибки);
	
	УдалитьФайлы(ФайлКартаРелизов);
	
	Если НЕ ЗначениеЗаполнено(ДеревоКартыРелизов) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1%2.';
																						|en = '%1%2.'"),
		ШапкаОшибки + Символы.ПС + Символы.ПС,
		Символы.ПС + ОписаниеОшибки);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// сохранение в кеше удалено
	
	// получаем справочник из кэша
	Если ДеревоКартыРелизов = Неопределено Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	// определяем последнюю доступную версию модуля документооборота для текущего релиза
	СвойстваМодуляДляТекущегоРелиза = ОпределитьСвойстваВнешнегоМодуляДляТекущегоРелиза(ДеревоКартыРелизов);
	Если НЕ ЗначениеЗаполнено(СвойстваМодуляДляТекущегоРелиза) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// сравниваем ее с той, которая хранится в ИБ
	ВерсияМодуляВИнтернете 	= СтрЗаменить(СвойстваМодуляДляТекущегоРелиза.Версия, Символы.НПП, "");
	ВерсияМодуляВБазе 		= СтрЗаменить(ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ВерсияВнешнегоМодуляДокументооборота(), Символы.НПП, "");
	
	Если ВерсияМодуляВИнтернете = ВерсияМодуляВБазе Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции //РаспаковатьСохранитьСправочникВКэше

&НаСервере
Функция ПолучитьСохранитьОбновление(ПараметрыСервераИнтернета, СвойстваМодуляДляТекущегоРелиза) Экспорт
	
	ШапкаОшибки = НСтр("ru = 'Ошибка обновления модуля защищенного документооборота:';
						|en = 'An error occurred while updating a protected data interchange module:'");
	
	// пытаемся установить соединение с сервером
	ОписаниеОшибки = "";
	Соединение = ДокументооборотСКО.УстановитьСоединениеССерверомИнтернета(ПараметрыСервераИнтернета.URLСервера, ОписаниеОшибки);
	Если Соединение = Неопределено Тогда
		
		ТекстСообщения = ШапкаОшибки + Символы.ПС + ОписаниеОшибки;
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		Возврат Ложь;
		
	КонецЕсли;
	
	// пытаемся получить ключевой файл с сервера
	КлючевойФайл = ПолучитьИмяВременногоФайла();
	Попытка
		Соединение.Получить(ПараметрыСервераИнтернета.КаталогФайловНаСервере
							+ ПараметрыСервераИнтернета.ИмяКлючевогоФайлаНаСервере,
							КлючевойФайл);
	Исключение
							
		ПодробнаяИнформацияОбОшибке = ОбщегоНазначенияЭДКОКлиентСервер.ПолучитьИнформациюОбОшибке(ИнформацияОбОшибке());
		ТекстСообщения = ШапкаОшибки + Символы.ПС + КраткоеПредставлениеОшибки(ПодробнаяИнформацияОбОшибке);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		Возврат Ложь;
	КонецПопытки;
	
	// извлекаем имя файла-карты релизов из ключевого файла
	ИмяФайлаКартыРелизовБезРасширения = ПолучитьИмяФайлаКартыРелизов(КлючевойФайл);
	УдалитьФайлы(КлючевойФайл);
	Если НЕ ЗначениеЗаполнено(ИмяФайлаКартыРелизовБезРасширения) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// получение версии справочника внешних модулей, закэшированного в ИБ - удалено
	
	ПолучитьФайлСправочникаВнешнихМодулей = Истина;
	
	// при необходимости получаем файл справочника внешних модулей с сервера и кэшируем его в ИБ
	ДеревоКартыРелизов = Неопределено;
	
	Если ПолучитьФайлСправочникаВнешнихМодулей Тогда
		
		ИмяФайлаКартыРелизовНаСервере = "/" + ИмяФайлаКартыРелизовБезРасширения + ".zip";
		ФайлКартаРелизовАрхив = ПолучитьИмяВременногоФайла("zip");
		СвойстваМодуляДляТекущегоРелиза = Неопределено;
		
		// получаем с сервера
		Попытка
			Соединение.Получить(ПараметрыСервераИнтернета.КаталогФайловНаСервере + ИмяФайлаКартыРелизовНаСервере, ФайлКартаРелизовАрхив);
		Исключение
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1Ошибка доступа к серверу обновлений модуля документооборота: %2.';
																							|en = '%1An error occurred when accessing the update server of data interchange module: %2.'"),
			ШапкаОшибки + Символы.ПС + Символы.ПС,
			Символы.ПС + ИнформацияОбОшибке().Описание);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецПопытки;
		
		УдалосьРаспаковать = РаспаковатьСохранитьСправочникВКэше(
			ФайлКартаРелизовАрхив, 
			ИмяФайлаКартыРелизовБезРасширения, 
			ШапкаОшибки, 
			СвойстваМодуляДляТекущегоРелиза);
			
		Если НЕ УдалосьРаспаковать Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьМодульДокументооборотаСФНСПриНеобходимости(ОбновитьСейчас = Ложь, ДополнительныеПараметры = Неопределено) Экспорт
	
	РазрешитьОнлайнОбновлениеМодуля = РазрешитьОбновлениеМодуля(ОбновитьСейчас);
	
	Если РазрешитьОнлайнОбновлениеМодуля = Ложь Тогда
		ПослеПолученияКонтекстаЭДО(ДополнительныеПараметры, Ложь);
	ИначеЕсли РазрешитьОнлайнОбновлениеМодуля = Неопределено Тогда
		// Если пользователь раньше не давал согласия на обновление модуля,
		// то спросим его асинхронно через одну минуту,
		// чтобы "надоедливые" окна не вылезали в момент открытия формы 1С-Отчетность или любого другого окна.
		ПослеПолученияКонтекстаЭДО(ДополнительныеПараметры, Ложь);
		ПодключитьОбработчикОжидания("Подключаемый_ОткрытьФормуПодтвержденияВыходаВИнтернетДляОбновленияМодуля", 60, Истина);
	Иначе
		ОбновитьМодульДокументооборотаСФНС(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОткрытьФормуПодтвержденияВыходаВИнтернетДляОбновленияМодуля()
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуПодтвержденияВыходаВИнтернетДляОбновленияМодуляЗавершение", ЭтотОбъект);
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ПодтверждениеВыходаВИнтернетДляЦелейОбновленияМодуля",,,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПодтвержденияВыходаВИнтернетДляОбновленияМодуляЗавершение(РезультатЗапросаРазрешения, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗапросаРазрешения = Истина Тогда
		ОбновитьМодульДокументооборотаСФНС();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПолученияКонтекстаЭДО(ДополнительныеПараметры, МодульОбновлен)
	
	Если ДополнительныеПараметры = Неопределено Тогда
		// Параметров не будет в том случае, если сюда пришли из формы
		// получения согласия на обновление модуля документооборота.
		// В этом случае даже при обновлении модуля, контекст не обновляем,
		// используем старый.
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("ВыполняемоеОповещение") Тогда
		ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Иначе
		ВыполняемоеОповещение = Неопределено;
	КонецЕсли;
	
	Если МодульОбновлен Тогда
		
		ДокументооборотСКОКлиент.ОбновитьИПолучитьКонтекстЭДО(ВыполняемоеОповещение);
		
	ИначеЕсли ВыполняемоеОповещение <> Неопределено Тогда
		
		ФормаРезультат = ДополнительныеПараметры.ФормаРезультат;
		
		СтруктураРезультата = Новый Структура;
		СтруктураРезультата.Вставить("ТекстОшибки", "");
		СтруктураРезультата.Вставить("КонтекстЭДО", ФормаРезультат);
		ПараметрыПриложения.Вставить("РегламентированнаяОтчетность.КонтекстЭДО", ФормаРезультат);
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, СтруктураРезультата);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьМодульДокументооборотаСФНС(ВходящийКонтекст = Неопределено) Экспорт

	ЭтоОбновлениеИзМастера = ТипЗнч(ВходящийКонтекст) = Тип("Структура")
		И ВходящийКонтекст.Свойство("ЭтоОбновлениеИзМастера")
		И ВходящийКонтекст.ЭтоОбновлениеИзМастера;
		
	МоментОткрытияФормыПодождите 	= ТекущаяДатаНаСервере();
	СвойстваМодуляДляТекущегоРелиза = Неопределено;
	КаталогФайловНаСервере 			= Неопределено;
	ПараметрыСервераИнтернета 		= ПолучитьПараметрыИнтернета();
	
	Если ПолучитьСохранитьОбновление(ПараметрыСервераИнтернета, СвойстваМодуляДляТекущегоРелиза) = Ложь Тогда 
		
		Если ВходящийКонтекст <> Неопределено Тогда
			ПослеПолученияКонтекстаЭДО(ВходящийКонтекст, Ложь);
		КонецЕсли;
		
	Иначе
		
		ПараметрыДлительногоОбмена = Новый Структура();
		ПараметрыДлительногоОбмена.Вставить("ЭтоОбновлениеИзМастера", ЭтоОбновлениеИзМастера);
		
		ДлительнаяОтправкаКлиент.ОткрытьФормуОжиданияЗагрузкиМодуля(ПараметрыДлительногоОбмена, ЭтотОбъект); // обновление модуля
		
		Если ВходящийКонтекст <> Неопределено Тогда
			ВходящийКонтекст.Вставить("Версия", СвойстваМодуляДляТекущегоРелиза.Версия);
		Иначе
			ВходящийКонтекст = Новый Структура("Версия", СвойстваМодуляДляТекущегоРелиза.Версия);
		КонецЕсли;
		
		АдресФайлаНаВебСервере = 
			"http://"
			+ ПараметрыСервераИнтернета.URLСервера
			+ ПараметрыСервераИнтернета.КаталогФайловНаСервере
			+ "/" 
			+ СвойстваМодуляДляТекущегоРелиза.Имя 
			+ ".zip";
		
		РезультатСкачивания = СкачатьФайлВоВременноеХранилище(АдресФайлаНаВебСервере);
		
		Если РезультатСкачивания.Статус Тогда
		
			Результат = ЗакачатьИВключитьПризнакИспользования(РезультатСкачивания.Путь, ВходящийКонтекст.Версия);
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуОжиданияЗагрузкиМодуля(ЭтоОбновлениеИзМастера);
			
			Если ВходящийКонтекст <> Неопределено Тогда
				ПослеПолученияКонтекстаЭДО(ВходящийКонтекст, Результат);
			КонецЕсли;
			
		Иначе
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуОжиданияЗагрузкиМодуля(ЭтоОбновлениеИзМастера);
			
			Если ВходящийКонтекст <> Неопределено Тогда
				ПослеПолученияКонтекстаЭДО(ВходящийКонтекст, Ложь);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗакачатьИВключитьПризнакИспользования(АдресФайла, ВерсияВнешнегоМодуля)
	
	ШапкаОшибки = НСтр("ru = 'Ошибка обновления модуля защищенного документооборота:';
						|en = 'An error occurred while updating a protected data interchange module:'");
	
	ДвДанныеАрхива 	= ПолучитьИзВременногоХранилища(АдресФайла);
	АрхивМодуля 	= ПолучитьИмяВременногоФайла();
	
	Попытка
		ДвДанныеАрхива.Записать(АрхивМодуля);
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1%2.';
																						|en = '%1%2.'"),
																				ШапкаОшибки + Символы.ПС + Символы.ПС,
																				ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	
	Если НЕ КонтекстЭДОСервер.ИзменениеСвойствМодуляДокументооборотаВозможно() Тогда
		ТекстСообщения = НСтр("ru = 'В Интернете доступно обновление модуля документооборота,
									|но у Вас недостаточно прав для регистрации обновленного модуля в информационной базе.
									|Обратитесь к администратору информационной базы.';
									|en = 'Update of the data interchange module is available online
									|but you have insufficient rights to register the updated module in the infobase.
									|Contact infobase administrator.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// распаковываем модуль
	ОписаниеОшибки = "";
	ФайлМодуля = РаспаковатьФайл(АрхивМодуля, ОписаниеОшибки);
	УдалитьФайлы(АрхивМодуля);
	Если НЕ ЗначениеЗаполнено(ФайлМодуля) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1%2.';
																						|en = '%1%2.'"),
																				ШапкаОшибки + Символы.ПС + Символы.ПС,
																				ОписаниеОшибки);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// регистрируем модуль в ИБ
	РезультатРегистрации = КонтекстЭДОСервер.ПрименитьСвойстваМодуляДокументооборота(Истина, ФайлМодуля, ОписаниеОшибки, ВерсияВнешнегоМодуля);
	
	УдалитьФайлы(ФайлМодуля);
	
	Если НЕ РезультатРегистрации Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1%2.';
																						|en = '%1%2.'"),
																				ШапкаОшибки + Символы.ПС + Символы.ПС,
																				ОписаниеОшибки);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ОпределитьСвойстваВнешнегоМодуляДляТекущегоРелиза(ДеревоКартыРелизов)
	
	ИнформацияОПрограмме = ИнформацияОПрограмме();
	
	Для Каждого Стр1 Из ДеревоКартыРелизов.Строки Цикл // уровень узла Файл
		Для Каждого Стр2 Из Стр1.Строки Цикл // уровень узла Платформа
			Если Стр2.Тип = "Э" И ТекущаяПлатформаСоответствуетУзлу(Стр2, ИнформацияОПрограмме.ВерсияПлатформы) Тогда
				Для Каждого Стр3 Из Стр2.Строки Цикл // уровень узла Конфигурация
					Если Стр3.Тип = "Э" И ТекущаяКонфигурацияСоответствуетУзлу(Стр3, ИнформацияОПрограмме) Тогда
						Для Каждого Стр4 Из Стр3.Строки Цикл // уровень узла Релиз
							Если Стр4.Тип = "Э" Тогда
								
								РезультатПоискаАтрибутаСВерсиейРелиза = Стр4.Строки.НайтиСтроки(Новый Структура("Имя, Тип", "Верс", "А"));
								Если РезультатПоискаАтрибутаСВерсиейРелиза.Количество() = 0 Тогда
									Продолжить;
								КонецЕсли;
								ВерсияРелиза = СокрЛП(РезультатПоискаАтрибутаСВерсиейРелиза[0].Значение);
								
								Если ВерсияРелиза <> ИнформацияОПрограмме.ВерсияКонфигурации Тогда
									Продолжить;
								КонецЕсли;
								
								Для Каждого Стр5 Из Стр4.Строки Цикл
									Если Стр5.Тип = "Э" И Стр5.Имя = "Мод" Тогда
										УзелВерсия = Стр5.Строки.Найти("Верс", "Имя");
										УзелИмя = Стр5.Строки.Найти("Имя", "Имя");
										УзелДата = Стр5.Строки.Найти("Дата", "Имя");
										Если УзелВерсия <> Неопределено И УзелИмя <> Неопределено Тогда
											Результат = Новый Структура("Версия, Имя", СокрЛП(УзелВерсия.Значение), СокрЛП(УзелИмя.Значение));
											Если ЗначениеЗаполнено(УзелДата) И ЗначениеЗаполнено(УзелДата.Значение) Тогда
												Результат.Вставить("Дата", УзелДата.Значение);
											КонецЕсли;
											Возврат Результат;
										КонецЕсли;
									КонецЕсли;
								КонецЦикла;
								
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ИнформацияОПрограмме()
	
	Результат = Новый Структура();
	Результат.Вставить("ВерсияПлатформы",			ПолучитьВерсиюТекущейПлатформы());
	Результат.Вставить("ИмяМетаданныхКонфигурации",	СокрЛП(Метаданные.Имя));
	Результат.Вставить("ИДКонфигурации",			РегламентированнаяОтчетностьПереопределяемый.ИДКонфигурации());
	Результат.Вставить("ВерсияКонфигурации",		СокрЛП(Метаданные.Версия));
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьВерсиюТекущейПлатформы()
	
	ОбъектСисИнфо = Новый СистемнаяИнформация;
	Возврат СокрЛП(ОбъектСисИнфо.ВерсияПриложения);
	
КонецФункции


//Документообороты Заявление и Документ

&НаСервереБезКонтекста
Функция ДатаИзСтроки(СтрДата) Экспорт
	Если СтрДата = "" Тогда
		ВозвращаемаяДата = Дата(1, 1, 1);
	Иначе
		МассивПодстрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрДата, ".");
		Если Число(МассивПодстрок[0]) = 0 Тогда
			МассивПодстрок[0] = "1";
		КонецЕсли;
		Если Число(МассивПодстрок[1]) = 0 Тогда
			МассивПодстрок[1] = "1";
		КонецЕсли;
		Если Число(МассивПодстрок[2]) = 0 Тогда
			МассивПодстрок[2] = "1";
		КонецЕсли;
		ВозвращаемаяДата = Дата(МассивПодстрок[2], МассивПодстрок[1], МассивПодстрок[0]);
	КонецЕсли;
	
	Возврат ВозвращаемаяДата;
	
КонецФункции

// Функция возвращает значение строки дерева значений из колонки "Имя"
&НаСервереБезКонтекста
Функция ИзвлечьДанное(СтрокаДерева, Имя) 
	СтрокаДанных = СтрокаДерева.Строки.Найти(Имя, "Имя", Истина);
	Если СтрокаДанных = Неопределено Тогда
		Возврат "";
	Иначе
		Возврат СтрокаДанных.Значение;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура СоздатьРезультатПриемаНаКлиентеСУчетомВопроса(ОповещениеОЗавершении, ОснованиеСсылка, ПоложительныйПрием = Истина, ТихийРежим = Ложь, УчитыватьПризнакАвтоподтверждения = Ложь) Экспорт
	
	Результат = ПризнакАвтоматическогоФормированияПодтвержденийИТипСообщения(ОснованиеСсылка);
	
	Если УчитыватьПризнакАвтоподтверждения И НЕ Результат.Автоподтверждение Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	ТипСообщения = Результат.Тип;
	
	Если ТипСообщения <> ПредопределенноеЗначение("Перечисление.ТипыТранспортныхСообщений.ДокументНО") Тогда
		// формируем пакет, если не сформирован
		Если ОповещениеОЗавершении.ДополнительныеПараметры.Свойство("Подтверждение")
			И ЗначениеЗаполнено(ОповещениеОЗавершении.ДополнительныеПараметры.Подтверждение)
			И НЕ СообщениеЗашифровано(ОповещениеОЗавершении.ДополнительныеПараметры.Подтверждение) Тогда
			СформироватьПакет(ОповещениеОЗавершении, ОповещениеОЗавершении.ДополнительныеПараметры.Подтверждение, Истина);
			Возврат;
		КонецЕсли;
		
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	// Сейчас реализовано ручное формирование квитанции о приеме для требований.
	// Если нужно при автоматическое формирование квитанции о приеме для требований, 
	// тогда нужно отменить проверку, содержит ли ОснованиеСсылка требования.
	Если УчитыватьПризнакАвтоподтверждения И ОписьСодержитТребования(ОснованиеСсылка) = Истина Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	//создаем результат приема
	СообщениеРезультатПриема = СоздатьРезультатПриемаНаСервереСУчетомПризнака(ОснованиеСсылка, ПоложительныйПрием, УчитыватьПризнакАвтоподтверждения);
	Если СообщениеРезультатПриема = Неопределено Тогда
		
		ТекстСообщения = 	СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось создать результат приема сообщения %1!';
																							|en = 'Cannot create %1 message receipt result.'"),
							Символ(34) + ПредставлениеТранспортногоСообщения(ОснованиеСсылка) + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		Возврат;		
	Иначе
		Контекст = Новый Структура;
		Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
		Контекст.Вставить("СообщениеРезультатПриема", СообщениеРезультатПриема);
		
		Оповещение = Новый ОписаниеОповещения(
			"СоздатьРезультатПриемаНаКлиентеСУчетомВопросаПослеПодписания", ЭтотОбъект, Контекст);
		КонтекстОтправки = Новый Структура;
		РеквизитыСообщения = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЗначенияРеквизитовОбъекта(СообщениеРезультатПриема, "Тип, УчетнаяЗапись");
		ПодписатьСообщение(
			"ФНС", Оповещение, КонтекстОтправки, СообщениеРезультатПриема, 
			РеквизитыСообщения.Тип, "Шифрование", , РеквизитыСообщения.УчетнаяЗапись, ОснованиеСсылка);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРезультатПриемаНаКлиентеСУчетомВопросаПослеПодписания(Результат, ВходящийКонтекст) Экспорт

	ВыполнитьОбработкуОповещения(
		ВходящийКонтекст.ОповещениеОЗавершении,
		?(Результат = Истина, ВходящийКонтекст.СообщениеРезультатПриема, Неопределено));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьРезультатПриемаНаСервереСУчетомПризнака(ОснованиеСсылка, ПоложительныйПрием = Истина, УчитыватьПризнакАвтоподтверждения = Истина)
	
	Если ОснованиеСсылка.Тип <> Перечисления.ТипыТранспортныхСообщений.ДокументНО Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если УчитыватьПризнакАвтоподтверждения Тогда
		Результат = ПризнакАвтоматическогоФормированияПодтвержденийИТипСообщения(ОснованиеСсылка);
		Если НЕ Результат.Автоподтверждение Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	НовоеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	
	Если ПоложительныйПрием = Истина Тогда
		//формируем квитанцию о приеме
		НовоеСообщение.Тема = "ФНС:1.0-квитанцияОПриеме-РезультатПриемаДокументНП";
		НовоеСообщение.ПротоколСОшибкой = Ложь;
	ИначеЕсли ПоложительныйПрием = Ложь Тогда
		//формируем уведомление об отказе
		НовоеСообщение.Тема = "ФНС:1.0-уведомлениеОбОтказе-РезультатПриемаДокументНП";
		НовоеСообщение.ПротоколСОшибкой = Истина;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		
		НовоеСообщение.Заполнить(ОснованиеСсылка);
		НовоеСообщение.Записать();
		
	Исключение
		
		КодОсновногоЯзыка = ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка();
		ПодробнаяИнформацияОбОшибке = КраткоеПредставлениеОшибки(ОбщегоНазначенияЭДКОКлиентСервер.ПолучитьИнформациюОбОшибке(ИнформацияОбОшибке()));
		
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ПодробнаяИнформацияОбОшибке);
		
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Запись результата приема';
				|en = 'EDI with regulatory authorities. Write receipt result'", КодОсновногоЯзыка),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробнаяИнформацияОбОшибке);
		
		Возврат Неопределено;
		
	КонецПопытки;
	
	Если НовоеСообщение.ОшибкаЗаполнения <> Истина Тогда
		Если СформироватьВложениеРезультатПриема(НовоеСообщение.Ссылка) Тогда
			Возврат НовоеСообщение.Ссылка;
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьВидНалоговогоДокументаПоКНД(КНД)
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПолучитьВидНалоговогоДокументаПоКНД(КНД); 

КонецФункции

&НаСервереБезКонтекста
Функция СформироватьВложениеРезультатПриема(ТранспортноеСообщение)
	
	ТемаСообщения = ТранспортноеСообщение.Тема;
	
	Если ТемаСообщения = "ФНС:1.0-квитанцияОПриеме-РезультатПриемаДокументНП" Тогда
		Возврат СформироватьВложениеКвитанцияОПриемеДокумент(ТранспортноеСообщение);
	ИначеЕсли ТемаСообщения = "ФНС:1.0-уведомлениеОбОтказе-РезультатПриемаДокументНП" Тогда
		Возврат СформироватьВложениеУведомлениеОбОтказеДокумент(ТранспортноеСообщение);
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьУзелОбщимиСведениямиОбУведомлении(Узел, ТранспортноеСообщение, ДИВы)
	
	КНД = КНДТребования(ТранспортноеСообщение.Основание.ЦиклОбмена);
	ДобавитьУзелXML(Узел, "КНД", Истина, КНД);
	ДобавитьУзелXML(Узел, "НаимВидДок", Истина, "Формат сообщений о документах направляемых налогоплательщику (представителю) или в налоговый орган в отношениях, регулируемых законодательством о налогах и сборах");
	
	ДатаНапр = Формат(ТранспортноеСообщение.Основание.Дата, "ДФ=dd.MM.yyyy");
	ДобавитьУзелXML(Узел, "ДатаНапр", Истина, ДатаНапр);
	
	ВремНапр = Формат(ТранспортноеСообщение.Основание.Дата, "ДФ=ЧЧ.мм.сс");
	ДобавитьУзелXML(Узел, "ВремНапр", Истина, ВремНапр);
	
	ДатаПост = Формат(ТранспортноеСообщение.Основание.ДатаТранспорта, "ДФ=dd.MM.yyyy");
	ДобавитьУзелXML(Узел, "ДатаПост", Истина, ДатаПост);

	Для Каждого СтрДИВ Из ДИВы Цикл
		ДобавитьУзелXML(Узел, "ИмяПринятФайла", Ложь, ИмяФайлаБезРасширения(СтрДИВ.ИмяФайла));
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьУзелСведениямиОбУчастникеЭДОДокумент(Узел, Сведения)
	
	ТипУчастникаЭДО = Сведения.ТипУчастника;
	Если ТипУчастникаЭДО = "Организация" Тогда
		
		Если Сведения.ЭтоФизЛицо Тогда
			
			УзелФЛ = ДобавитьУзелXML(Узел, "ОтпрФЛ");
			ДобавитьУзелXML(УзелФЛ, "ИННФЛ", Истина, Сведения.ИНН);
			
			УзелФИО = ДобавитьУзелXML(УзелФЛ, "ФИО");
			ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Сведения.Фамилия);
			ДобавитьУзелXML(УзелФИО, "Имя", Истина, Сведения.Имя);
			Если ЗначениеЗаполнено(Сведения.Отчество) Тогда
				ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Сведения.Отчество);
			КонецЕсли;
			
		Иначе
			
			УзелЮЛ = ДобавитьУзелXML(Узел, "ОтпрЮЛ");
			ДобавитьУзелXML(УзелЮЛ, "НаимОрг", Истина, Сведения.Наименование);
			ДобавитьУзелXML(УзелЮЛ, "ИННЮЛ", Истина, Сведения.ИНН);
			ДобавитьУзелXML(УзелЮЛ, "КПП", Истина, Сведения.КПП);
			
		КонецЕсли;
		
	ИначеЕсли ТипУчастникаЭДО = "НалоговыйОрган" Тогда
		
		УзелНО = ДобавитьУзелXML(Узел, "ОтпрНО");
		ДобавитьУзелXML(УзелНО, "КодНО", Истина, Сведения.Код);
		ДобавитьУзелXML(УзелНО, "НаимНО", Истина, Сведения.Наименование);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьУзелСведениямиОКвитанции(Узел, ТранспортноеСообщение, ДИВы)
	
	ДатаПрин = Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy");
	ДобавитьУзелXML(Узел, "ДатаПрин", Истина, ДатаПрин);
	
	КНД = КНДТребования(ТранспортноеСообщение.Основание.ЦиклОбмена);
	ДобавитьУзелXML(Узел, "КНД", Истина, КНД);
	ДобавитьУзелXML(Узел, "НаимВидДок", Истина, "Формат сообщений о документах направляемых налогоплательщику (представителю) или в налоговый орган в отношениях, регулируемых законодательством о налогах и сборах");

	ДатаНапр = Формат(ТранспортноеСообщение.Основание.Дата, "ДФ=dd.MM.yyyy");
	ДобавитьУзелXML(Узел, "ДатаНапр", Истина, ДатаНапр);
	
	ВремНапр = Формат(ТранспортноеСообщение.Основание.Дата, "ДФ=ЧЧ.мм.сс");
	ДобавитьУзелXML(Узел, "ВремНапр", Истина, ВремНапр);
	
	ДатаПост = Формат(ТранспортноеСообщение.Основание.ДатаТранспорта, "ДФ=dd.MM.yyyy");
	ДобавитьУзелXML(Узел, "ДатаПост", Истина, ДатаПост);

	Для Каждого СтрДИВ Из ДИВы Цикл
		ДобавитьУзелXML(Узел, "ИмяПринятФайла", Ложь, ИмяФайлаБезРасширения(СтрДИВ.ИмяФайла));
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КНДТребования(ЦиклОбмена)
	
	СообщенияЦикла = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,Ложь);
	// Получаем транспортное сообщение, содержащее требование.
	// Оно обязательно должно быть, иначе бы мы сейчас не подтверждали его получение.
	СтрДокументНО = СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ДокументНО));
	
	Если СтрДокументНО.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПервичноеТранспортноеСообщение = СтрДокументНО[0];
	
	// Ищем файл с описанием передаваемого документа TR_INFSOOB
	// см. ПРИКАЗ от 9 ноября 2010 г. N ММВ-7-6/535@
	ИмяФайла = "TR_INFSOOB.xml";
	ВложенияПервичногоСообщения = ПолучитьВложенияТранспортногоСообщения(ПервичноеТранспортноеСообщение, Истина, , ИмяФайла);
	ВложениеПервичногоСообщения = ВложенияПервичногоСообщения[0];

	// записываем вложение во временный файл
	ФайлВложение = ПолучитьИмяВременногоФайла("xml");
	Попытка
		ВложениеПервичногоСообщения.Данные.Получить().Записать(ФайлВложение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений(ФайлВложение);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлВложение);
	Если ДеревоXML = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	
	Узел = ДеревоXML.Строки.Найти("КНДДок", "Имя", Истина);
	Если Узел = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат Узел.Значение;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьXMLКвитанцииОПриемеДокумента(ТранспортноеСообщение, ДИВы, ИмяФайлаКвитанции)
	
	// выделяем имя файла без расширения из короткого имени файла квитанции
	РасширениеФайлаКвитанции = РасширениеФайла(ИмяФайлаКвитанции);
	ДлинаРасширенияИмениФайлаКвитанции = СтрДлина(РасширениеФайлаКвитанции);
	ИмяФайлаКвитанцииБезРасширения = Лев(ИмяФайлаКвитанции, СтрДлина(ИмяФайлаКвитанции) - ДлинаРасширенияИмениФайлаКвитанции - 1);
			  
	// определяем дату получения основания
	ДатаПолученияОснования = ТранспортноеСообщение.Основание.ДатаТранспорта;
	
	// получаем сведения о получателе из входящего требования
	РеквизитыПолучателя = ПолучитьРеквизитыПолучателяИзВходящегоТребования(ТранспортноеСообщение.Основание);
	Если РеквизитыПолучателя = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа';
								|en = 'Cannot extract beneficiary details from the incoming document of the tax authority'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	    Возврат Неопределено;
	КонецЕсли;
	
	// получаем сведения о налогоплательщике из входящего требования
	РеквизитыНалогоплательщика = ПолучитьРеквизитыНалогоплательщикаИзВходящегоТребования(ТранспортноеСообщение.Основание);
	Если РеквизитыНалогоплательщика = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось извлечь реквизиты налогоплательщика из входящего документа налогового органа';
								|en = 'Cannot extract taxpayer details from the incoming document of the tax authority'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// создаем XML-дерево квитанции
	ДеревоXML = СоздатьДеревоXML();
	
	// иниицализируем атрибуты корневого элемента
	ДобавитьУзелXML(ДеревоXML, "ИдФайл", Истина, ИмяФайлаКвитанцииБезРасширения);
	ДобавитьУзелXML(ДеревоXML, "ВерсПрог", Истина, Лев(РегламентированнаяОтчетность.НазваниеИВерсияПрограммы(), 40));
	ДобавитьУзелXML(ДеревоXML, "ВерсФорм", Истина, "5.03");
	
	// создаем узел Документ
	УзелДокумент = ДобавитьУзелXML(ДеревоXML, "Документ");
	ДобавитьУзелXML(УзелДокумент, "КНД", Истина, "1167001");
	
	// добавляем сведения о получателе
	УзелСвПолДок = ДобавитьУзелXML(УзелДокумент, "СвПолДок");
	Если РеквизитыПолучателя.НаимОрг <> ""
	И ЗначениеЗаполнено(РеквизитыПолучателя.ИННЮЛ) 
