&НаСервереБезКонтекста
Функция ПроверитьПередОтправкойВФТСНаСервере(Отчет)
	
	Результат = Новый Структура;
	Результат.Вставить("ОтправкаРазрешена", 						Истина);
	Результат.Вставить("ТекстВопроса", 								"");
	Результат.Вставить("КнопкиВопроса", 							Неопределено);
	Результат.Вставить("ИдентификаторНеПринятойОтправкиНаСервере", 	"");
	
	ИдентификаторОтправкиНаСервере = "";
	ТекущаяОтправка = ПолучитьПоследнююОтправкуОтчетаВФТС(Отчет, ИдентификаторОтправкиНаСервере);
	Если ЗначениеЗаполнено(ТекущаяОтправка) Тогда
		СтатусОтправки = ТекущаяОтправка.СтатусОтправки;
		Результат.ИдентификаторНеПринятойОтправкиНаСервере = ?(СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят
			ИЛИ СтатусОтправки = Перечисления.СтатусыОтправки.Сдан, ИдентификаторОтправкиНаСервере, "");
		
		Если СтатусОтправки = Перечисления.СтатусыОтправки.Отправлен Тогда
			Результат.ОтправкаРазрешена = Ложь;
			Результат.ТекстВопроса = НСтр("ru = 'Отчет уже отправлен, результат отправки не получен.
												|Вы действительно хотите отправить отчет повторно?
												|
												|Обратите внимание, для аннулирования отправленного ранее отчета и подачи исправленного вместо него,
												|нужно дождаться сдачи отчета и обновить состояние, затем воспользоваться кнопкой отправки.';
												|en = 'The report is already sent, the sending result is not received.
												|Are you sure you want to send the report again?
												|
												|To cancel the report you sent earlier and submit a corrected one,
												|wait until the report is submitted, update the status, and then use the sending button.'");
			Возврат Результат;
			
		ИначеЕсли СтатусОтправки = Перечисления.СтатусыОтправки.Сдан Тогда
			Результат.ОтправкаРазрешена = Ложь;
			Результат.ТекстВопроса = НСтр("ru = 'Отчет уже отправлен и успешно сдан.
												|
												|Для аннулирования сданного отчета и подачи исправленного вместо него, нажмите ""Аннулировать с отправкой нового"".
												|Если хотите отправить как новый отчет, нажмите ""Отправить повторно"".';
												|en = 'The report is already sent and successfully submitted.
												|
												|To cancel this report and submit a corrected one, click ""Cancel and send new report"".
												|If you want to send it as a new report, click ""Send again"".'");
			КнопкиВопроса = Новый СписокЗначений;
			КнопкиВопроса.Добавить("АннулироватьОтправитьНовый", 	НСтр("ru = 'Аннулировать с отправкой нового';
																			|en = 'Cancel and send new report'"));
			КнопкиВопроса.Добавить("Да", 							НСтр("ru = 'Отправить повторно';
																			|en = 'Send again'"));
			КнопкиВопроса.Добавить("Нет", 							НСтр("ru = 'Отмена';
																			|en = 'Cancel'"));
			Результат.КнопкиВопроса = КнопкиВопроса;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

