	ДополнительныеПараметры.Вставить("ИдентификаторДокументооборота", ИдентификаторДокументооборота);
	ДополнительныеПараметры.Вставить("ДанныеСертификатаОтправителя", ДанныеСертификатаОтправителя);
	ДополнительныеПараметры.Вставить("СвойстваСертификатаПолучателя", СвойстваСертификатаПолучателя);
