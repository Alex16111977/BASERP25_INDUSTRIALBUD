&НаКлиенте
Процедура ВыбратьПервичныйДокументВОтветеНаТребование(ВыполняемоеОповещение, Организация, Источник = Неопределено, МножественныйВыбор = Ложь) Экспорт
	
	ВыбираемыеТипов = СписокВыбораТиповПервичныйДокументВОтветеНаТребование(МножественныйВыбор);
	
	КоличествоТипов = ВыбираемыеТипов.Количество();
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("Источник",              Источник);
	ДополнительныеПараметры.Вставить("Организация",           Организация);
	ДополнительныеПараметры.Вставить("МножественныйВыбор",    МножественныйВыбор);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборИсточникаПослеВыбораТипа", ЭтотОбъект, ДополнительныеПараметры);
	
	Если КоличествоТипов = 1 Тогда
		// пропускаем выбор типа
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, ВыбираемыеТипов[0]);
	Иначе
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("МножественныйВыбор",    МножественныйВыбор);
		
		ОткрытьФорму(
			ПутьКОбъекту + ".Форма.ФормаВыбораТипаДокумента",
			ПараметрыФормы,
			,
			,
			,
			,
			ОписаниеОповещения);
			
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СписокВыбораТиповПервичныйДокументВОтветеНаТребование(МножественныйВыбор)
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.СписокВыбораТиповПервичныйДокументВОтветеНаТребование(МножественныйВыбор);
	
КонецФункции

&НаКлиенте
Процедура ВыборИсточникаПослеВыбораТипа(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	ПараметрИсточник      = ВходящийКонтекст.Источник;
	ПараметрОрганизация   = ВходящийКонтекст.Организация;
	МножественныйВыбор    = ВходящийКонтекст.МножественныйВыбор;
	
	Если ТипЗнч(Результат) = Тип("ЭлементСпискаЗначений") Тогда
		ВыбранныйТип = Результат.Значение;
	Иначе
		ВыбранныйТип = Результат.Типы()[0];
	КонецЕсли;
	
	ВходящийКонтекст.Вставить("Тип", ВыбранныйТип);
	
	Если ВыбранныйТип = Тип("СправочникСсылка.СканированныеДокументыДляПередачиВЭлектронномВиде") Тогда
		
		ПараметрыОткрытия = Новый Структура();
		ПараметрыОткрытия.Вставить("Организация", 			ВходящийКонтекст.Организация);
		ПараметрыОткрытия.Вставить("ОткрытьВРежимеВыбора", 	Истина);
		ПараметрыОткрытия.Вставить("МножественныйВыбор", 	МножественныйВыбор);
			
		ОткрытьФорму("Справочник.СканированныеДокументыДляПередачиВЭлектронномВиде.Форма.ФормаСписка", ПараметрыОткрытия,,,,,ВыполняемоеОповещение);
		
	Иначе
	
		СтандартнаяОбработка = Истина;
		
		// В процедуру, указанную в параметре ВыполняемоеОповещение, 
		// должен быть передан результат выбора, который имеет тип Структура со следующими полями:
		// * Ссылка, * Описание, * Основание
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ВыбратьДокументИсточникДляПередачиФНСЗавершение", 
			ЭтотОбъект, 
			ВходящийКонтекст);
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентПереопределяемый.ВыбратьДокументИсточникДляПередачиФНС(
			ВыбранныйТип,
			ПараметрИсточник,
			ПараметрОрганизация, 
			ОписаниеОповещения,
			СтандартнаяОбработка);
			
		Если СтандартнаяОбработка = Истина Тогда
			// Случай, когда переопределяемая не заполнена
			
			ВыбратьДокументИсточникДляПередачиФНС(ВыбранныйТип, ВходящийКонтекст);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьДокументИсточникДляПередачиФНС(ВыбранныйТип, ВходящийКонтекст) Экспорт
	
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	МножественныйВыбор    = ВходящийКонтекст.МножественныйВыбор;
	Организация           = ВходящийКонтекст.Организация;

	ИмяФормыИсточника = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьИмяФормыОбъктаДляПередачиФНС(ВыбранныйТип);
	
	Если ИмяФормыИсточника = Неопределено Тогда
		ТекстПредупреждения = НСтр("ru = 'Не удалось открыть форму выбора';
									|en = 'Cannot open selection form'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("Тип", 					ВыбранныйТип);
	ДополнительныеПараметры.Вставить("Организация",				Организация);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ВыбратьДокументИсточникДляПередачиФНСЗавершение", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("МножественныйВыбор", МножественныйВыбор);
	
	ОткрытьФорму(ИмяФормыИсточника, ПараметрыОткрытия, ЭтотОбъект, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьДокументИсточникДляПередачиФНСЗавершение(Результат, ВходящийКонтекст) Экспорт
	
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		Если ТипЗнч(Результат) = ВходящийКонтекст.Тип 
			ИЛИ ТипЗнч(Результат) = Тип("Структура")
			ИЛИ ТипЗнч(Результат) = Тип("Массив") И Результат.Количество() = 1 Тогда
	
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, Результат);
			
		ИначеЕсли ТипЗнч(Результат) = Тип("Массив") И Результат.Количество() > 0 Тогда
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ДокументыИсточники", Результат);
			ДополнительныеПараметры.Вставить("Организация",        ВходящийКонтекст.Организация);
			
			ОткрытьФорму(
				ПутьКОбъекту + ".Форма.ФормаГрупповогоВыбораДокументов",
				ДополнительныеПараметры,
				,
				,
				,
				,
				ВыполняемоеОповещение);
			
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСканСДискаВОтчетНаТребование(ВыполняемоеОповещение, УникальныйИдентификатор) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",   ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьИДобавитьВложенияРасширениеПредложено", ЭтотОбъект, ДополнительныеПараметры);
	ОбщегоНазначенияКлиент.ПоказатьВопросОбУстановкеРасширенияРаботыСФайлами(ОписаниеОповещения, , Истина)
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьИДобавитьВложенияРасширениеПредложено(Результат, ДополнительныеПараметры) Экспорт
	
	ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами = Результат;	
	
	Если ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами Тогда
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		Диалог.Фильтр = "PNG, TIFF, JPEG, PDF (*.png;*.tif;*.jpg;*.pdf)|*.png;*.tif;*.jpg;*.pdf";
		Диалог.МножественныйВыбор = Истина;
		Диалог.ПредварительныйПросмотр = Истина;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьВложенияПослеВыбораФайлов", ЭтотОбъект, ДополнительныеПараметры);
		Диалог.Показать(ОписаниеОповещения);
		
	Иначе
		ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьВложенияБезРасширенияРаботыСФайлами", ЭтотОбъект, ДополнительныеПараметры);
		НачатьПомещениеФайла(ОписаниеОповещения, "", , Истина, ДополнительныеПараметры.УникальныйИдентификатор);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВложенияПослеВыбораФайлов(МассивПолныхИменВыбранныхФайлов, ВходящийКонтекст) Экспорт
	
	Если МассивПолныхИменВыбранныхФайлов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВыбораФайлов = Новый Структура;
	РезультатВыбораФайлов.Вставить("ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами", Истина);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("МассивПолныхИменВыбранныхФайлов", МассивПолныхИменВыбранныхФайлов);
	
	РезультатВыбораФайлов.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, РезультатВыбораФайлов);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВложенияБезРасширенияРаботыСФайлами(ФайлыБылиВыбраны, АдресДанных, ВыбранноеИмяФайла, ВходящийКонтекст) Экспорт
	
	Если НЕ ФайлыБылиВыбраны Тогда
		Возврат;
	КонецЕсли;
	
	СвойстваФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ВыбранноеИмяФайла);
	
	Расширение = Нрег(СвойстваФайла.Расширение);
	
	Если Расширение <> ".jpg"
		И Расширение <> ".tif"
		И Расширение <> ".png"
		И Расширение <> ".pdf" Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ЭтоПредупреждениеОбОшибке", Истина);
		
		ОткрытьФорму("Справочник.СканированныеДокументыДляПередачиВЭлектронномВиде.Форма.ФормаТребованияКФайлам", ДополнительныеПараметры);
		
		Возврат;
		
	КонецЕсли;
	
	РезультатВыбораФайлов = Новый Структура;
	РезультатВыбораФайлов.Вставить("ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами", Ложь);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ФайлыБылиВыбраны", 	ФайлыБылиВыбраны);
	ДополнительныеПараметры.Вставить("АдресДанных", 		АдресДанных);
	ДополнительныеПараметры.Вставить("ВыбранноеИмяФайла", 	ВыбранноеИмяФайла);
	
	РезультатВыбораФайлов.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, РезультатВыбораФайлов);
	
КонецПроцедуры

// Получает список свойств файла или каталога. 
//
// Параметры:
//  ОповещениеОЗавершении - ОписаниеОповещения - описание процедуры, принимающей результат.
//    Результат - Структура:
//      * Выполнено      - Булево - если Истина, то процедура успешно выполнена и получен результат, иначе см. ОписаниеОшибки.
//      * СвойстваФайлов  - Массив структур. Структура - свойства файла.
//        ** Имя              - Строка - имя файла.
//        ** ИмяБезРасширения - Строка - имя файла (без расширения).
//        ** ПолноеИмя        - Строка - полное имя файла (включающее путь к файлу).
//        ** Путь             - Строка - путь к файлу.
//        ** Расширение       - Строка - расширение имени файла.
//        ** Размер           - Число  - размер файла (в байтах).
//        ** Существует       - Булево - определяет, существует ли файл.
//        ** ЭтоКаталог       - Булево - если Истина, то каталог, иначе - файл.
//
//  МассивПолныхИменФайлов - Массив - массив полных имен файлов.
//
&НаКлиенте
Процедура ПолучитьСвойстваФайлов(ОповещениеОЗавершении, МассивПолныхИменФайлов) Экспорт
	
	МассивСвойствФайлов = Новый Массив;
	
	ПолучитьСвойстваФайлаПоследовательно(ОповещениеОЗавершении, МассивСвойствФайлов, МассивПолныхИменФайлов, 0);
	
КонецПроцедуры

//вспомогательная к ПолучитьСвойстваФайлов
&НаКлиенте
Процедура ПолучитьСвойстваФайлаПоследовательно(ОповещениеОЗавершении, МассивСвойствФайлов, МассивПолныхИменФайлов, ПорядковыйНомерФайла)
	
	Если ПорядковыйНомерФайла <= МассивПолныхИменФайлов.ВГраница() Тогда
		
		ТекущийФайлПолноеИмя = МассивПолныхИменФайлов[ПорядковыйНомерФайла];
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ОповещениеОЗавершении",  ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("МассивСвойствФайлов",    МассивСвойствФайлов);
		ДополнительныеПараметры.Вставить("МассивПолныхИменФайлов", МассивПолныхИменФайлов);
		ДополнительныеПараметры.Вставить("ПорядковыйНомерФайла",   ПорядковыйНомерФайла);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПолучитьСвойстваФайловПослеПолученияСвойствОдногоФайла", ЭтотОбъект, ДополнительныеПараметры);
		ОперацииСФайламиЭДКОКлиент.ПолучитьСвойстваФайла(ОписаниеОповещения, ТекущийФайлПолноеИмя);
		Возврат;
		
	Иначе
		
		РезультатСтруктура = Новый Структура;
		РезультатСтруктура.Вставить("Выполнено", Истина);
		РезультатСтруктура.Вставить("СвойстваФайлов", МассивСвойствФайлов);
		
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, РезультатСтруктура);
		
	КонецЕсли;
	
КонецПроцедуры

//вспомогательная к ПолучитьСвойстваФайлов
&НаКлиенте
Процедура ПолучитьСвойстваФайловПослеПолученияСвойствОдногоФайла(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат.Выполнено Тогда
		
		РезультатСтруктура = Новый Структура;
		РезультатСтруктура.Вставить("Выполнено", Ложь);
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеОЗавершении, РезультатСтруктура);

		Возврат;	
		
	КонецЕсли;
	
	ДополнительныеПараметры.МассивСвойствФайлов.Добавить(Результат.СвойстваФайла);
	ПолучитьСвойстваФайлаПоследовательно(ДополнительныеПараметры.ОповещениеОЗавершении, ДополнительныеПараметры.МассивСвойствФайлов, ДополнительныеПараметры.МассивПолныхИменФайлов, ДополнительныеПараметры.ПорядковыйНомерФайла + 1)
	
КонецПроцедуры

#Область ПечатьПояснения

&НаКлиенте
Функция ПечатьПояснениеПоНДС(Пояснение) Экспорт
	
	ТабДок = ТабличныйДокументПоясненияСервер(Пояснение);
	НапечататьДокумент(ТабДок, Строка(Пояснение));
	
КонецФункции

&НаСервере
Функция ТабличныйДокументПоясненияСервер(Пояснение)
	
	ТЧ = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ТабличныеЧастиПояснения(Истина);
	
	ВыбранныеСтроки = Новый Структура;
	Для каждого Имя Из ТЧ Цикл
		
		Таблица = Пояснение[Имя];
		Таблица = Таблица.Выгрузить();
		Таблица = ОбщегоНазначения.ТаблицаЗначенийВМассив(Таблица);
		ВыбранныеСтроки.Вставить(Имя, Таблица);
	
	КонецЦикла;
	
	ВыбранныеСтроки.Вставить("ПояснИнОсн", Пояснение.ПояснИнОсн);
	
    КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	ТабДок = КонтекстЭДОСервер.ТабличныйДокументПояснения(Пояснение, ВыбранныеСтроки, Ложь);
	Возврат ТабДок;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьКонтрагентовИзТребования(КонтрагентыИзСтроки) Экспорт
	
	Если КонтрагентыИзСтроки.Количество() = 0 Тогда
		Возврат;
	ИначеЕсли КонтрагентыИзСтроки.Количество() = 1 Тогда
		ПоказатьЗначение(,КонтрагентыИзСтроки[0].Значение);
	ИначеЕсли КонтрагентыИзСтроки.Количество() > 1 Тогда 
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОткрытьКонтрагентовПослеВыбора", 
			ЭтотОбъект);
		
		КонтрагентыИзСтроки.ПоказатьВыборЭлемента(ОписаниеОповещения, НСтр("ru = 'Выберите контрагента для открытия';
																			|en = 'Select a counterparty for opening'"));
		 
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Невозможно открыть карточку контрагента по причине:
                                       |Контрагент не найден в справочнике контрагентов';
                                       |en = 'Unable to open counterparty card due to:
                                       | Counterparty is not found in the counterparty directory '"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКонтрагентовПослеВыбора(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат <> Неопределено Тогда
		 ПоказатьЗначение(,Результат.Значение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОтправкаЗаявленийНаПереход

&НаКлиенте
Процедура СформироватьИОтправитьЗаявлениеНаПереход(ВходящийКонтекст) Экспорт
	
	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправкиЗаявления(ВходящийКонтекст) Тогда
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_СформироватьИОтправитьЗаявлениеНаПереход", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СформироватьИОтправитьЗаявлениеНаПереход()
	
	ДополнительныеПараметры = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	Организация 			= ДополнительныеПараметры.Организация;
	
	СвойстваУчетнойЗаписи = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЗначенияРеквизитовОбъекта(
		Организация, "УчетнаяЗаписьОбмена.СертификатРуководителя, УчетнаяЗаписьОбмена.ЭлектроннаяПодписьВМоделиСервиса");
	ОтпечатокСертификатаРуководителя 	= СвойстваУчетнойЗаписи.УчетнаяЗаписьОбменаСертификатРуководителя;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = СвойстваУчетнойЗаписи.УчетнаяЗаписьОбменаЭлектроннаяПодписьВМоделиСервиса;
	
	Сертификат = Новый Структура;
	Сертификат.Вставить("Отпечаток", ОтпечатокСертификатаРуководителя);
		
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		
		СвойстваСертификата = СвойстваСертификатКриптографииИзХранилища(Сертификат);
		
		Если СвойстваСертификата = Неопределено Тогда
			
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Сертификат не найден';
																|en = 'Certificate is not found'"));
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправкеЗаявления();
			Возврат;
		Иначе
			
			Результат = Новый Структура();
			Результат.Вставить("Выполнено", Истина);
			Результат.Вставить("Субъект", 	СвойстваСертификата.Субъект);
			
			СформироватьИОтправитьЗаявлениеНаПереходПослеПолученияФайлаСертификата(Результат, ДополнительныеПараметры);
			Возврат;
			
		КонецЕсли;
		
	Иначе
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"СформироватьИОтправитьЗаявлениеНаПереходПослеПолученияФайлаСертификата", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
		
		КриптографияЭДКОКлиент.ЭкспортироватьСертификатВФайл(ОписаниеОповещения, Сертификат,,Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьЗаявлениеНаПереходПослеПолученияФайлаСертификата(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат.Выполнено Тогда
		
		Если ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Результат.ОписаниеОшибки);
		КонецЕсли;
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправкеЗаявления();
		
		Возврат;
	КонецЕсли;
	
	Организация = ВходящийКонтекст.Организация;
	
	Если НЕ Результат.Свойство("Субъект") Тогда
		СертификатКриптографии 	= Новый СертификатКриптографии(Результат.ИмяФайлаСертификата);
		Субъект 				= СертификатКриптографии.Субъект;
	Иначе
		Субъект					= Результат.Субъект;
	КонецЕсли;
	ПоляСертификата 		= Новый Структура(Субъект);
	
	ВходящийКонтекст.Вставить("ПоляСертификата", ПоляСертификата);
	
	УдалосьСоздать = СоздатьНовоеЗаявлениеНаПереход(ВходящийКонтекст);
	
	Если НЕ УдалосьСоздать Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось создать заявление';
															|en = 'Cannot create the application'"));
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправкеЗаявления();
		Возврат;
	КонецЕсли;
	 
	ИдентификаторАбонента = ИдентификаторАбонентаПоОрганизации(Организация);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"СформироватьИОтправитьЗаявлениеНаПереходЗавершение", 
		ЭтотОбъект,
		ВходящийКонтекст);
		
	Контекст = ПараметрыПроцедурыСформироватьИОтправитьЗаявление();
	Контекст.ДокументЗаявление 							= ЗаявлениеНаПереход;
	Контекст.ИдентификаторАбонента 						= ИдентификаторАбонента;
	Контекст.ВызовИзМастераПодключенияК1СОтчетности 	= Истина;
	Контекст.ВыполняемоеОповещение 						= ОписаниеОповещения;
	Контекст.ФормироватьЗакрытыйКлючИЗапросНаСертификат = Истина;
	
	СформироватьИОтправитьЗаявление(Контекст);
	
КонецПроцедуры
	
&НаСервере
Функция СоздатьНовоеЗаявлениеНаПереход(ВходящийКонтекст)
	
	Организация 		= ВходящийКонтекст.Организация;
	ЭтоПереходВКоробку 	= ВходящийКонтекст.ЭтоПереходВКоробку;
	ПоляСертификата 	= ВходящийКонтекст.ПоляСертификата;
	
	УчетнаяЗапись = Организация.УчетнаяЗаписьОбмена;
	Спецоператор  = УчетнаяЗапись.СпецоператорСвязи;
	
	РеквизитыУчетнойЗаписи = ДополнительныеРеквизитыУчетнойЗаписи(УчетнаяЗапись);
	
	НовыйДокументЗаявление = Документы.ЗаявлениеАбонентаСпецоператораСвязи.СоздатьДокумент();
	ЗначениеВРеквизитФормы(НовыйДокументЗаявление, "ЗаявлениеНаПереход");
	
	НовыйДокументЗаявление = РеквизитФормыВЗначение("ЗаявлениеНаПереход");
	НовыйДокументЗаявление.УстановитьНовыйНомер();
	
	НовыйДокументЗаявление.Дата								= ТекущаяДатаСеанса();
	НовыйДокументЗаявление.Организация						= Организация;
	НовыйДокументЗаявление.ТипЗаявления						= Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Изменение;
	НовыйДокументЗаявление.ИдентификаторДокументооборота	= нрег(СтрЗаменить(Строка(Новый("УникальныйИдентификатор")), "-", ""));
	НовыйДокументЗаявление.Статус							= Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Подготовлено;
	НовыйДокументЗаявление.СпецоператорСвязи				= Спецоператор;
	НовыйДокументЗаявление.УчетнаяЗапись 					= УчетнаяЗапись;
	НовыйДокументЗаявление.ТипОрганизации					= СтрДлина(НовыйДокументЗаявление.ИНН) = 10;
	НовыйДокументЗаявление.Ответственный					= Пользователи.ТекущийПользователь();
	НовыйДокументЗаявление.ДатаСозданияУчетнойЗаписи		= '00010101';
	НовыйДокументЗаявление.РеквизитыСертификата 			= Новый ХранилищеЗначения(ПоляСертификата);
	
	// Копирование свойств
	КопируемыеСвойстваОрганизации = "НомерОсновнойПоставки1с,ИНН,КПП,ПолноеНаименование,КраткоеНаименование,ОГРН,РегНомерПФР,РегНомерФСС,ТелефонОсновной,ТелефонДополнительный,ТелефонМобильный,ЭлектроннаяПочта,КодРегионаФСРАР";
	КопируемыеСвойстваВладельца   = "ВладелецЭЦПФамилия,ВладелецЭЦПИмя,ВладелецЭЦПОтчество,ВладелецЭЦПДолжность,ВладелецЭЦППодразделение,ВладелецЭЦПСНИЛС";
	КопируемыеСвойства 			  = КопируемыеСвойстваВладельца + "," + КопируемыеСвойстваОрганизации;
	
	ЗаполнитьЗначенияСвойств(НовыйДокументЗаявление, РеквизитыУчетнойЗаписи, КопируемыеСвойства);
	
	Если ЭтоПереходВКоробку Тогда
		НовыйДокументЗаявление.ЭлектроннаяПодписьВМоделиСервиса = Ложь;
		НовыйДокументЗаявление.ТипКриптопровайдера = ВходящийКонтекст.ТипКриптопровайдера;
	Иначе
		НовыйДокументЗаявление.ЭлектроннаяПодписьВМоделиСервиса = Истина;
		НовыйДокументЗаявление.ИдентификаторПроверкиТелефонаДляПаролей = ВходящийКонтекст.ИдентификаторПроверкиТелефонаДляПаролей;
		НовыйДокументЗаявление.ИдентификаторПроверкиЭлектроннойПочтыДляПаролей = ВходящийКонтекст.ИдентификаторПроверкиЭлектроннойПочтыДляПаролей;
	КонецЕсли;
	
	ЗаполнитьИзменившиесяРеквизитыЗаявленияНаПеренос(НовыйДокументЗаявление, ЭтоПереходВКоробку);
	
	Попытка
		НовыйДокументЗаявление.Записать();
	Исключение
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		ТекстСообщения = НСтр("ru = 'Отправка заявления прервана.';
								|en = 'Application sending aborted.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	ЗначениеВРеквизитФормы(НовыйДокументЗаявление, "ЗаявлениеНаПереход");
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДополнительныеРеквизитыУчетнойЗаписи(УчетнаяЗапись) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ДополнительныеРеквизитыУчетнойЗаписи(УчетнаяЗапись);
	
КонецФункции
	
&НаКлиенте
Процедура СформироватьИОтправитьЗаявлениеНаПереходЗавершение(Результат, ВходящийКонтекст) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("ТекстОшибки")
		И ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Результат.ТекстОшибки);
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправкеЗаявления();
		
	Иначе
		
		ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправкеЗаявления(ВходящийКонтекст.Организация);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзменившиесяРеквизитыЗаявленияНаПеренос(НовыйДокументЗаявление, ЭтоПереходВКоробку)
	
	// Записываем перечень изменившихся реквизитов
	НовыйДокументЗаявление.ИзменившиесяРеквизитыВторичногоЗаявления.Очистить();
	
	// При переходе переиздание сертификата добавляем всегда
	НоваяСтрока = НовыйДокументЗаявление.ИзменившиесяРеквизитыВторичногоЗаявления.Добавить();
	НоваяСтрока.ИзмененныйРеквизит = Перечисления.ПараметрыПодключенияК1СОтчетности.ПереизданиеСертификата;
		
	НоваяСтрока = НовыйДокументЗаявление.ИзменившиесяРеквизитыВторичногоЗаявления.Добавить();
	Если ЭтоПереходВКоробку Тогда
		НоваяСтрока.ИзмененныйРеквизит = Перечисления.ПараметрыПодключенияК1СОтчетности.ПереходВКоробку;
	Иначе
		НоваяСтрока.ИзмененныйРеквизит = Перечисления.ПараметрыПодключенияК1СОтчетности.ПереходВОблако;
	КонецЕсли;
	
	// При переходе изменение криптопровайдера добавляем всегда
	НоваяСтрока = НовыйДокументЗаявление.ИзменившиесяРеквизитыВторичногоЗаявления.Добавить();
	НоваяСтрока.ИзмененныйРеквизит = Перечисления.ПараметрыПодключенияК1СОтчетности.ИзменениеКриптопровайдера;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаличиеКриптопровайдера(ВыполняемоеОповещение, ПредлагатьУстановкуРасширения, КриптопровайдерПриКонфликте = Неопределено) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 		ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("КриптопровайдерПриКонфликте", КриптопровайдерПриКонфликте);
	
	Оповещение 	= Новый ОписаниеОповещения(
		"ЗаполнитьСписокКриптопровайдеровЗавершение", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	КриптографияЭДКОКлиент.ПолучитьКриптопровайдеры(Оповещение,,ПредлагатьУстановкуРасширения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокКриптопровайдеровЗавершение(Результат, ВходящийКонтекст) Экспорт
	
	РезультатПоиска = РезультатПоискаКриптопровайдеров(Результат, ВходящийКонтекст);
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, РезультатПоиска);
	
КонецПроцедуры

&НаКлиенте
Функция РезультатПоискаКриптопровайдеров(Результат, ВходящийКонтекст) Экспорт
	
	Если ВходящийКонтекст.Свойство("КриптопровайдерПриКонфликте") Тогда
		КриптопровайдерПриКонфликте = ВходящийКонтекст.КриптопровайдерПриКонфликте;
	Иначе
		КриптопровайдерПриКонфликте = Неопределено;
	КонецЕсли;
	
	CryptoProCSPУстановлен	= Ложь;
	ViPNetCSPУстановлен 	= Ложь;
	
	Выполнено = Результат.Выполнено;
	Если Выполнено Тогда
		ЭтоLinux = ОбщегоНазначенияКлиентСервер.ЭтоLinuxКлиент();
		ПоддерживаемыеКриптопровайдеры = КриптографияЭДКОКлиентСервер.ПоддерживаемыеКриптопровайдеры(, ЭтоLinux);
		ИндексКриптопровайдеров = Неопределено;
		
		Для каждого Криптопровайдер Из Результат.Криптопровайдеры Цикл
			СвойстваКриптопровайдера = КриптографияЭДКОКлиентСервер.СвойстваКриптопровайдера(
				Криптопровайдер.Имя,
				Криптопровайдер.Тип,
				ПоддерживаемыеКриптопровайдеры,
				ИндексКриптопровайдеров);
			Если СвойстваКриптопровайдера <> Неопределено Тогда
				Если СвойстваКриптопровайдера.ТипКриптопровайдера = ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.VipNet") Тогда
					ViPNetCSPУстановлен 	= Истина;
				ИначеЕсли СвойстваКриптопровайдера.ТипКриптопровайдера = ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.CryptoPro") Тогда
					CryptoProCSPУстановлен 	= Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	КриптопровайдерПриКонфликтеVipNet = НЕ ЗначениеЗаполнено(КриптопровайдерПриКонфликте)
		ИЛИ КриптопровайдерПриКонфликте = ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.VipNet");
		
	КриптопровайдерПриКонфликтеCryptoPro = НЕ ЗначениеЗаполнено(КриптопровайдерПриКонфликте)
		ИЛИ КриптопровайдерПриКонфликте = ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.CryptoPro");
	
	Результат = Новый Структура();
	Результат.Вставить("CryptoProCSPУстановлен", 	CryptoProCSPУстановлен И КриптопровайдерПриКонфликтеCryptoPro);
	Результат.Вставить("ViPNetCSPУстановлен", 		ViPNetCSPУстановлен И КриптопровайдерПриКонфликтеVipNet);
	Результат.Вставить("Выполнено", 				Выполнено);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция СвойстваСертификатКриптографииИзХранилища(Сертификат)
	
	СвойстваСертификата = КриптографияЭДКО.НайтиСертификат(Сертификат);
	Если СвойстваСертификата = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяФайлаСертификата = ПолучитьИмяВременногоФайла();
	СвойстваСертификата.Сертификат.Записать(ИмяФайлаСертификата);
	
	СертификатКриптографии = Новый СертификатКриптографии(ИмяФайлаСертификата);
	Результат = Новый Структура;
	Результат.Вставить("ДатаНачала", 	СертификатКриптографии.ДатаНачала);
	Результат.Вставить("ДатаОкончания", СертификатКриптографии.ДатаОкончания);
	Результат.Вставить("Издатель", 		СертификатКриптографии.Издатель);
	Результат.Вставить("Отпечаток", 	СертификатКриптографии.Отпечаток);
	Результат.Вставить("СерийныйНомер", СертификатКриптографии.СерийныйНомер);
	Результат.Вставить("Субъект", 		СертификатКриптографии.Субъект);
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаСертификата);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПроверкаСтатусаЗаявленияПередОтправкой

#Область ПроверкаПервичногоЗаявления

&НаКлиенте
Процедура ПроверитьСтатусПодключенияПередОтправкой(ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	СсылкаНаОбъект 		= ВходящийКонтекст.СсылкаНаОбъект;
	СведенияОбОбъекте 	= СведенияПоОтправляемымОбъектам(СсылкаНаОбъект);
	Организация 		= СведенияОбОбъекте.Организация;
	
	ВходящийКонтекст.Вставить("Организация", 			  Организация);
	ВходящийКонтекст.Вставить("ВидКонтролирующегоОргана", СведенияОбОбъекте.ВидКонтролирующегоОргана);
	ВходящийКонтекст.Вставить("КодКонтролирующегоОргана", СведенияОбОбъекте.КодКонтролирующегоОргана);
	
	ЗаявленияАбонента = ОтправленныеЗаявленияАбонентов(
		Организация,
		ПредопределенноеЗначение("Перечисление.ТипыЗаявленияАбонентаСпецоператораСвязи.Первичное"),
		СведенияОбОбъекте.ВидКонтролирующегоОргана);
		
	Если ЗаявленияАбонента.Количество() = 0 Тогда
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьФормуПредложениеОформитьЗаявлениеНаПодключение(Организация);
		
	Иначе
		
		ПоследнееЗаявлениеАбонента = ЗаявленияАбонента[0];
		
		Ответ = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьОтветСервераНаЗаявлениеАбонента(ПоследнееЗаявлениеАбонента);
		
		РезультатОтветаСервера 	= Ответ.РезультатОтветаСервера;
		РеквизитыДокумента 		= Ответ.РеквизитыДокумента;
		
		ЗаявлениеОтправлено = РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено");
		ЗаявлениеОтклонено  = РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено");
		ЗаявлениеОдобрено   = РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено");
		
		ВходящийКонтекст.Вставить("РеквизитыДокумента", 	РеквизитыДокумента);
		ВходящийКонтекст.Вставить("РезультатОтветаСервера", РезультатОтветаСервера);
		ВходящийКонтекст.Вставить("Заявление", 				ПоследнееЗаявлениеАбонента);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ВыполнитьДействиеВыбранноеВСообщенииОЗаявлении", 
			ЭтотОбъект, 
			ВходящийКонтекст);
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("СсылкаНаОбъект", 	СсылкаНаОбъект);
		ПараметрыФормы.Вставить("Заявление", 		ПоследнееЗаявлениеАбонента);
		
		ОтсутствуетИнтернет = РезультатОтветаСервера.Свойство("СообщитьОбОтсутствииИнтернета");
		
		Если ОтсутствуетИнтернет Тогда
			
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьФормуПредложениеОформитьЗаявлениеНаПодключение(Организация);
			
		ИначеЕсли ЗаявлениеОтправлено Тогда
			
			ОткрытьФорму(ПутьКОбъекту + ".Форма.СообщениеОНеобработанномЗаявлении", 
				ПараметрыФормы,,,,,
				ОписаниеОповещения, 
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				
		ИначеЕсли ЗаявлениеОдобрено И НЕ РеквизитыДокумента.НастройкаЗавершена Тогда
			
			ОткрытьФорму(ПутьКОбъекту + ".Форма.СообщениеОбОдобренномЗаявлении", 
				ПараметрыФормы,,,,,
				ОписаниеОповещения, 
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		ИначеЕсли ЗаявлениеОтклонено И НЕ РеквизитыДокумента.НастройкаЗавершена Тогда
			
			ОткрытьФорму(ПутьКОбъекту + ".Форма.СообщениеОбОтклоненномЗаявлении", 
				ПараметрыФормы,,,,,
				ОписаниеОповещения, 
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе
			
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьФормуПредложениеОформитьЗаявлениеНаПодключение(Организация);
			
		КонецЕсли;
		 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеВыбранноеВСообщенииОЗаявлении(Результат, ВходящийКонтекст) Экспорт
	
	ДокументЗаявление = ВходящийКонтекст.Заявление;
	
	Если Результат = "ЗавершитьНастройкуСейчас" Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПроверитьСтатусПодключенияПередОтправкой_ПослеЗавершенияНастрокиЗаявления", 
			ЭтотОбъект, 
			ВходящийКонтекст);
		
		ОткрытьФормуЗавершенияНастройкиМастера(
			ДокументЗаявление, 
			ВходящийКонтекст, 
			ОписаниеОповещения);
			
	ИначеЕсли Результат = "ПодготовитьНовоеЗаявление" Тогда
		
		// Если статус заявления - "Отклонено", тогда создаем новое заявление
		ДополнительныеПараметры = ДокументооборотСКОКлиентСервер.ПараметрыОткрытияМастера();
		ДополнительныеПараметры.Вставить("ЗначениеКопирования", ДокументЗаявление);
			
		ОткрытьФормуЗаявления(ДополнительныеПараметры);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСтатусПодключенияПередОтправкой_ПослеЗавершенияНастрокиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	ВыполняемоеОповещение 	= ВходящийКонтекст.ВыполняемоеОповещение;
	Заявление 				= ВходящийКонтекст.Заявление;
	
	РеквизитыЗаявления = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(Заявление);
	
	ЗаявлениеОдобрено  = РеквизитыЗаявления.НастройкаЗавершена
		И РеквизитыЗаявления.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено"); 
	
	Если ЗаявлениеОдобрено Тогда
	
		Если ВыполняемоеОповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПроверкаВторичногоЗаявления

&НаКлиенте
Процедура ЗавершитьНастройкуЗаявленияНаИзменение(СсылкаНаОбъект, ВыполняемоеОповещение) Экспорт
	
	СведенияОбОбъекте 			= СведенияПоОтправляемымОбъектам(СсылкаНаОбъект);
	Организация					= СведенияОбОбъекте.Организация;
	УчетнаяЗапись 				= УчетнаяЗаписьОрганизации(Организация);
	ВидКонтролирующегоОргана 	= СведенияОбОбъекте.ВидКонтролирующегоОргана;
	
	ВходящийКонтекст = Новый Структура;
	ВходящийКонтекст.Вставить("СсылкаНаОбъект", 			СсылкаНаОбъект);
	ВходящийКонтекст.Вставить("ВыполняемоеОповещение", 		ВыполняемоеОповещение);
	
	// Продолжение отправки при отсуствии учетной записи
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;
	
	ТипЗаявления 		= ПредопределенноеЗначение("Перечисление.ТипыЗаявленияАбонентаСпецоператораСвязи.Изменение");
	ЗаявленияАбонента 	= ОтправленныеЗаявленияАбонентов(Организация, ТипЗаявления, ВидКонтролирующегоОргана);
	
	Если ЗаявленияАбонента.Количество() = 0 Тогда
		
		// Продолжаем отправку
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
		
	Иначе
		
		ПоследнееЗаявлениеАбонента = ЗаявленияАбонента[0];
		
		// Продолжение отправки при отсуствии данного направления. О нем будет напомнено позже.
		Если ЭтоЗаявлениеНаПодключениеНаправления(ПоследнееЗаявлениеАбонента, ВидКонтролирующегоОргана) Тогда
			// Продолжаем отправку.
			// Предупредим пользователя об этом заявлении когда будет выполнена проверка наличия этого направления.
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
			Возврат;
		КонецЕсли;
		
		Ответ = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьОтветСервераНаЗаявлениеАбонента(ПоследнееЗаявлениеАбонента);
		
		РезультатОтветаСервера 	= Ответ.РезультатОтветаСервера;
		РеквизитыДокумента 		= Ответ.РеквизитыДокумента;
		
		ЗаявлениеОтправлено = РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено");
		ЗаявлениеОтклонено  = РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено");
		ЗаявлениеОдобрено   = РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено");
		
		ВходящийКонтекст.Вставить("РеквизитыДокумента", 	РеквизитыДокумента);
		ВходящийКонтекст.Вставить("РезультатОтветаСервера", РезультатОтветаСервера);
		ВходящийКонтекст.Вставить("Заявление", 				ПоследнееЗаявлениеАбонента);
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("СсылкаНаОбъект", 	СсылкаНаОбъект);
		ПараметрыФормы.Вставить("Заявление", 		ПоследнееЗаявлениеАбонента);
		
		Если ЭтоЗаявлениеНеТребующееНапоминанияПередОтправкой(ПоследнееЗаявлениеАбонента) Тогда
			
			// Продолжаем отправку
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
			
		ИначеЕсли ЗаявлениеОдобрено И НЕ РеквизитыДокумента.НастройкаЗавершена Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ЗавершитьНастройкуЗаявленияНаИзменение_СообщениеОбОдобренномЗаявлении_Завершение", 
				ЭтотОбъект, 
				ВходящийКонтекст);
				
			ОткрытьФорму(ПутьКОбъекту + ".Форма.СообщениеОбОдобренномЗаявлении", 
				ПараметрыФормы,,,,,
				ОписаниеОповещения, 
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		ИначеЕсли ЗаявлениеОтклонено И НЕ РеквизитыДокумента.НастройкаЗавершена Тогда
				
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ЗавершитьНастройкуЗаявленияНаИзменение_СообщениеОбОтклоненномЗаявлении_Завершение", 
				ЭтотОбъект, 
				ВходящийКонтекст);
				
			ОткрытьФорму(ПутьКОбъекту + ".Форма.СообщениеОбОтклоненномЗаявлении", 
				ПараметрыФормы,,,,,
				ОписаниеОповещения, 
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе
			// Продолжаем отправку
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
		КонецЕсли;
		 
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоЗаявлениеНаПодключениеНаправления(Знач ДокументЗаявление, Знач ВидКонтролирующегоОргана) Экспорт

	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ЭтоЗаявлениеНаПодключениеНаправления(ДокументЗаявление, ВидКонтролирующегоОргана);
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьНастройкуЗаявленияНаИзменение_СообщениеОбОдобренномЗаявлении_Завершение(Результат, ВходящийКонтекст) Экспорт
	
	ДокументЗаявление = ВходящийКонтекст.Заявление;
	
	Если Результат = "ЗавершитьНастройкуСейчас" Тогда
		
		// Для одобренного заявления
		ОткрытьФормуЗавершенияНастройкиМастера(
			ДокументЗаявление, 
			ВходящийКонтекст, 
			ВходящийКонтекст.ВыполняемоеОповещение);
			
	ИначеЕсли Результат = "БольшеНеПоказывать" Тогда
		
		ДобавитьЗаявлениеВНеТребующиеНапоминанияПередОтправкой(ДокументЗаявление);
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
		
	Иначе
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьНастройкуЗаявленияНаИзменение_СообщениеОбОтклоненномЗаявлении_Завершение(Результат, ВходящийКонтекст) Экспорт
	
	ДокументЗаявление = ВходящийКонтекст.Заявление;
	
	Если Результат = "ПодготовитьНовоеЗаявление" Тогда
		
		// Для отклоненного заявления
		ДополнительныеПараметры = ДокументооборотСКОКлиентСервер.ПараметрыОткрытияМастера();
		ДополнительныеПараметры.Вставить("ЗначениеКопирования", ДокументЗаявление);
			
		ОткрытьФормуЗаявления(ДополнительныеПараметры);

	Иначе
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция КлючЗаявленийНеТребующиеНапоминанияПередОтправкой() Экспорт
	
	Возврат "ДокументооборотСКонтролирующимиОрганами_ЗаявленияНеТребующиеНапоминанияПередОтправкой";
	
КонецФункции

&НаСервере
Функция ЭтоЗаявлениеНеТребующееНапоминанияПередОтправкой(ДокументЗаявление)
	
	// Список заявлений, по которым нажали "Больше не показывать" при отправке
	ЗаявленияПриОтправке = ХранилищеОбщихНастроек.Загрузить(КлючЗаявленийНеТребующиеНапоминанияПередОтправкой());
	
	// Список заявлений, по которым нажали "Больше не показывать" при в уведомлении по таймеру
	ЗаявленияПоТаймеру = ХранилищеОбщихНастроек.Загрузить(ОбработкаЗаявленийАбонента.КлючЗаявленийТребующихНапоминанияПозже());
	
	Если ЗаявленияПриОтправке = Неопределено Тогда
		ЕстьСредиЗаявленияПриОтправке = Ложь;
	Иначе
		ЕстьСредиЗаявленияПриОтправке = ЗаявленияПриОтправке.Найти(ДокументЗаявление) <> Неопределено;
	КонецЕсли;
	
	Если ЗаявленияПоТаймеру = Неопределено Тогда
		ЕстьСредиЗаявленийПоТаймеру = Ложь;
	Иначе
		
		ЗаявлениеВТаблицеЗаявленийПоТаймеру = ЗаявленияПоТаймеру.Найти(ДокументЗаявление, "Заявление");
		
		ЕстьСредиЗаявленийПоТаймеру = ЗаявлениеВТаблицеЗаявленийПоТаймеру <> Неопределено
			И ЗаявлениеВТаблицеЗаявленийПоТаймеру.Дата = Дата(3999, 12, 31, 23, 59, 59);
			
	КонецЕсли;
		
	Возврат ЕстьСредиЗаявленияПриОтправке ИЛИ ЕстьСредиЗаявленийПоТаймеру;
	
КонецФункции
	
&НаСервере
Процедура ДобавитьЗаявлениеВНеТребующиеНапоминанияПередОтправкой(ДокументЗаявление) Экспорт
	
	Заявления = ХранилищеОбщихНастроек.Загрузить(КлючЗаявленийНеТребующиеНапоминанияПередОтправкой());

	Если Заявления = Неопределено Тогда
		Заявления = Новый Массив;
	КонецЕсли;
	
	Заявления.Добавить(ДокументЗаявление);
	Заявления = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Заявления);

	ХранилищеОбщихНастроек.Сохранить(КлючЗаявленийНеТребующиеНапоминанияПередОтправкой(), , Заявления);
	
КонецПроцедуры

#КонецОбласти

#Область НеподключенноеНаправление

&НаКлиенте
Процедура СообщитьОНеподключенномНаправлении(ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
	
	СсылкаНаОбъект 				= ВходящийКонтекст.СсылкаНаОбъект;
	СведенияОбОбъекте 			= СведенияПоОтправляемымОбъектам(СсылкаНаОбъект);
	ВидКонтролирующегоОргана 	= СведенияОбОбъекте.ВидКонтролирующегоОргана;
	Организация					= СведенияОбОбъекте.Организация;
	
	// Если не подключено направление, то проверяем наличие отправленного заявления на изменение.
	// Если такого нет, то отправка невозможна и показывам предложение отправить заявление.
	// Если есть, то пытаемся завершить настройку ненастроенного заявления.
	
	ВходящийКонтекст.Вставить("Организация", 			  Организация);
	ВходящийКонтекст.Вставить("ВидКонтролирующегоОргана", СведенияОбОбъекте.ВидКонтролирующегоОргана);
	ВходящийКонтекст.Вставить("КодКонтролирующегоОргана", СведенияОбОбъекте.КодКонтролирующегоОргана);
	
	ЗаявленияАбонента = ОтправленныеЗаявленияАбонентов(
		Организация,
		ПредопределенноеЗначение("Перечисление.ТипыЗаявленияАбонентаСпецоператораСвязи.Изменение"),
		ВидКонтролирующегоОргана);
		
	Если ЗаявленияАбонента.Количество() = 0 Тогда
		
		ПоказатьОшибкуНеподключенногоНаправления(ВходящийКонтекст);
		
	Иначе
		
		ПоследнееЗаявлениеАбонента = ЗаявленияАбонента[0];
		
		Ответ = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьОтветСервераНаЗаявлениеАбонента(ПоследнееЗаявлениеАбонента);
		
		РезультатОтветаСервера 	= Ответ.РезультатОтветаСервера;
		РеквизитыДокумента 		= Ответ.РеквизитыДокумента;
		
		ЗаявлениеОтправлено = РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено");
		ЗаявлениеОтклонено  = РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено");
		ЗаявлениеОдобрено   = РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено");
		
		ВходящийКонтекст.Вставить("РеквизитыДокумента", 	РеквизитыДокумента);
		ВходящийКонтекст.Вставить("РезультатОтветаСервера", РезультатОтветаСервера);
		ВходящийКонтекст.Вставить("Заявление", 				ПоследнееЗаявлениеАбонента);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ВыполнитьДействиеВыбранноеВСообщенииОЗаявлении", 
			ЭтотОбъект, 
			ВходящийКонтекст);
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("СсылкаНаОбъект", 			СсылкаНаОбъект);
		ПараметрыФормы.Вставить("Заявление", 				ПоследнееЗаявлениеАбонента);
		ПараметрыФормы.Вставить("ЭтоПодключениеНаправления",Истина);
		
		ОтсутствуетИнтернет = РезультатОтветаСервера.Свойство("СообщитьОбОтсутствииИнтернета");
		
		Если ЗаявлениеОтправлено Тогда
			
			ОткрытьФорму(ПутьКОбъекту + ".Форма.СообщениеОНеобработанномЗаявлении", 
				ПараметрыФормы,,,,,
				ОписаниеОповещения, 
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				
		ИначеЕсли ЗаявлениеОдобрено И НЕ РеквизитыДокумента.НастройкаЗавершена Тогда
			
			ОткрытьФорму(ПутьКОбъекту + ".Форма.СообщениеОбОдобренномЗаявлении", 
				ПараметрыФормы,,,,,
				ОписаниеОповещения, 
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		ИначеЕсли ЗаявлениеОтклонено И НЕ РеквизитыДокумента.НастройкаЗавершена Тогда
			
			ОткрытьФорму(ПутьКОбъекту + ".Форма.СообщениеОбОтклоненномЗаявлении", 
				ПараметрыФормы,,,,,
				ОписаниеОповещения, 
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе
			
			ПоказатьОшибкуНеподключенногоНаправления(ВходящийКонтекст);
			
		КонецЕсли;
		 
	КонецЕсли;	
	 
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправленныеЗаявленияАбонентов(Знач Организация, Знач ТипЗаявления, Знач ВидКонтролирующегоОргана)

	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ОтправленныеЗаявленияАбонентов(
		Организация, ТипЗаявления, ВидКонтролирующегоОргана);

КонецФункции

&НаКлиенте
Процедура ПоказатьОшибкуНеподключенногоНаправления(ВходящийКонтекст)

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	// Перед показом предупреждения проверяем ли срок действия сертификата.
	// Если сертификат не найден или просрочен, не отправляем заявление в скрытом
	// режиме, а открываем мастер.
	
	Организация 					= ВходящийКонтекст.Организация;
	УчетнаяЗапись 					= УчетнаяЗаписьОрганизации(Организация);
	ОтпечатокСертификата 			= ПолучитьОтпечаток(УчетнаяЗапись, "Руководитель", Неопределено);
	ЭтоУчетнаяЗаписьВМоделиСервиса 	= ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.ЭтоЭлектроннаяПодписьВМоделиСервиса(УчетнаяЗапись);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПоказатьОшибкуНеподключенногоНаправления_ПослеПолученияДатыСертификата", 
		ЭтотОбъект, 
		ВходящийКонтекст);
		
	Если ЭтоУчетнаяЗаписьВМоделиСервиса Тогда
		
		СвойстваСертификата = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечатокСертификата, "MY");
		Результат = Новый Структура;
		Результат.Вставить("Выполнено", 			СвойстваСертификата <> Неопределено);
		Результат.Вставить("СвойстваСертификата", 	СвойстваСертификата);
		Результат.Вставить("СертификатНайден", 		Истина);
		
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Результат);
		
	Иначе
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(ОписаниеОповещения, ОтпечатокСертификата, "MY");
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПоказатьОшибкуНеподключенногоНаправления_ПослеПолученияДатыСертификата(Результат, ВходящийКонтекст) Экспорт
	
	СертификатДоступен 	= Ложь;
	СертификатИстек 	= Ложь;
	
	Если Результат.Выполнено <> Ложь И Результат.СертификатНайден Тогда
		
		СвойстваСертификата = Результат.СвойстваСертификата;
		СертификатДоступен  = Результат.СертификатНайден;
		Если СвойстваСертификата.ДействителенПо < ОбщегоНазначенияКлиент.ДатаСеанса() Тогда
			СертификатИстек = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПоказатьОшибкуНеподключенногоНаправления_ПослеЗакрытияСообщенияОНеподключенномНаправлении", 
		ЭтотОбъект, 
		ВходящийКонтекст);
		
	СертификатНеДоступенИлиИстек = НЕ СертификатДоступен ИЛИ СертификатИстек;
		
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("СсылкаНаОбъект", ВходящийКонтекст.СсылкаНаОбъект);
	ПараметрыФормы.Вставить("СертификатНеДоступенИлиИстек", СертификатНеДоступенИлиИстек);
	
	ПоддерживаетсяВторичноеЗаявление = ПоддерживаетсяВторичноеЗаявление(ВходящийКонтекст.Организация);
	Если ПоддерживаетсяВторичноеЗаявление Тогда
		
		ОткрыватьФормуПодключенияФНС = СообщитьОНеподключенномНаправлении_ОткрыватьФормуПодключенияФНС(ВходящийКонтекст);
		
		Если ОткрыватьФормуПодключенияФНС Тогда
			ПутьКФорме = ПутьКОбъекту + ".Форма.СообщениеОНеподключенномНаправленииФНС";
		Иначе
			ПутьКФорме = ПутьКОбъекту + ".Форма.СообщениеОНеподключенномНаправлении";
		КонецЕсли;
		
	Иначе
		ПутьКФорме = ПутьКОбъекту + ".Форма.СообщениеОНеподключенномНаправленииПрочиеОператоры";
	КонецЕсли;
	
	ОткрытьФорму(
		ПутьКФорме,
		ПараметрыФормы
		,
		,
		,
		,
		,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Функция СообщитьОНеподключенномНаправлении_ОткрыватьФормуПодключенияФНС(ВходящийКонтекст)
	
	// Если ФНС не подключен, открывать специальную сокращенную форму с мастером
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(ВходящийКонтекст.Организация);
		
	Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		РеквизитыУчетнойЗаписи = ПолучитьНастройкиУчетнойЗаписиИзИБ(УчетнаяЗапись);
		ПодключенФНС = РеквизитыУчетнойЗаписи.ПредназначенаДляДокументооборотаСФНС;
	Иначе
		ПодключенФНС = Ложь;
	КонецЕсли;
	
	ВидКонтролирующегоОргана = ВходящийКонтекст.ВидКонтролирующегоОргана;
	
	Возврат ВидКонтролирующегоОргана = ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФНС")
		И НЕ ПодключенФНС;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьОшибкуНеподключенногоНаправления_ПослеЗакрытияСообщенияОНеподключенномНаправлении(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Неопределено Тогда
		
		// Ошибку о неподключенном направлении закрыли без дальнейших действий.
		// Отправка прерывается.
		
	Иначе
		
		Организация = ВходящийКонтекст.Организация;
		
		ПараметрыОткрытияФормы = Новый Структура();
		ПараметрыОткрытияФормы.Вставить("Организация", Организация);
		
		ФлагиВМастер = Новый Структура();
		ФлагиВМастер.Вставить("ПодключаемоеНаправление", 					Результат);
		ФлагиВМастер.Вставить("ПродлитьСертификат", 						Ложь);
		ФлагиВМастер.Вставить("ИзменитьРеквизитыПодключенияК1СОтчетности", 	Ложь);
		ФлагиВМастер.Вставить("ПродлитьЛицензиюНа1СОтчетность", 			Ложь);
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ФлагиВМастер", ФлагиВМастер);
		
		ПараметрыОткрытияФормы.Вставить("АктивироватьФлагиМастера", ДополнительныеПараметры);
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ОткрытьФормуМастераЗаявленияНаПодключение(
			Организация, 
			ЭтотОбъект,
			,
			ПредопределенноеЗначение("Перечисление.ТипыЗаявленияАбонентаСпецоператораСвязи.Изменение"),
			ПараметрыОткрытияФормы);
			
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

