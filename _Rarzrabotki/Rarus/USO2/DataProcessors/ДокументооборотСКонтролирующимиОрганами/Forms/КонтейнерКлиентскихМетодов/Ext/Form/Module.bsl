	СообщениеВладелецФайла = ТранспортноеСообщение;
	
	Результат = ПолучитьАдресВложения(СообщениеВладелецФайла, ИмяФайлаДокумента);
	Если Результат.Свойство("Предупреждение") Тогда
		ПоказатьПредупреждение(,Результат.Предупреждение);
		Возврат;
	Иначе 
		Адрес = Результат.Адрес;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	Если ЗначениеЗаполнено(СообщениеВладелецФайла) Тогда
		СтруктураПараметров.Вставить("Сообщение", СообщениеВладелецФайла);
