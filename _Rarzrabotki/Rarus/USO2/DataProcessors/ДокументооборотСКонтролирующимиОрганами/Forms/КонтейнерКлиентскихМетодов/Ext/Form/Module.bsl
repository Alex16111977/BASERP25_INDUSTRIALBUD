	Если КомандаИзменитьСерверPOP3 <> Неопределено Тогда
		УчетнаяЗаписьОбъект.СерверPOP3 = КомандаИзменитьСерверPOP3.НовоеЗначение;
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Изменен адрес сервера POP3 в свойствах учетной записи.';
											|en = 'POP3 server address was changed in the account properties. '"), Ложь);
	КонецЕсли;
	
	// изменяем имя пользователя POP3
	Если КомандаИзменитьИмяПользователяPOP3 <> Неопределено Тогда
		УчетнаяЗаписьОбъект.ИмяПользователяPOP3 = КомандаИзменитьИмяПользователяPOP3.НовоеЗначение;
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Изменено имя пользователя POP3 в свойствах учетной записи.';
											|en = 'POP3 username is changed in the account properties.'"), Ложь);
	КонецЕсли;
	
	// изменяем пароль POP3
	Если КомандаИзменитьПарольPOP3 <> Неопределено Тогда
		УчетнаяЗаписьОбъект.ПарольPOP3 = КомандаИзменитьПарольPOP3.НовоеЗначение;
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Изменен пароль POP3 в свойствах учетной записи.';
											|en = 'POP3 password was changed in the account properties.'"), Ложь);
	КонецЕсли;
	
	// изменяем порт POP3
	Если КомандаИзменитьПортPOP3 <> Неопределено Тогда
		// Не обновляем порты, если они уже были заполнены раньше
		Если НЕ ЗначениеЗаполнено(КомандаИзменитьПортPOP3.СтароеЗначение) Тогда
			УчетнаяЗаписьОбъект.ПортPOP3 = КомандаИзменитьПортPOP3.НовоеЗначение;
			ДобавитьСообщение(Сообщения, НСтр("ru = 'Изменен порт POP3 в свойствах учетной записи.';
												|en = 'POP3 port was changed in the account properties.'"), Ложь);
		КонецЕсли;
	КонецЕсли;
	
	// изменяем адрес сервера SMTP
	Если КомандаИзменитьСерверSMTP <> Неопределено Тогда
		УчетнаяЗаписьОбъект.СерверSMTP = КомандаИзменитьСерверSMTP.НовоеЗначение;
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Изменен адрес сервера SMTP в свойствах учетной записи.';
											|en = 'SMTP server address was changed in the account properties.'"), Ложь);
	КонецЕсли;
	
	// изменяем порт SMTP
	Если КомандаИзменитьПортSMTP <> Неопределено Тогда
		// Не обновляем порты, если они уже были заполнены раньше
		Если НЕ ЗначениеЗаполнено(КомандаИзменитьПортSMTP.СтароеЗначение) Тогда
			УчетнаяЗаписьОбъект.ПортSMTP = КомандаИзменитьПортSMTP.НовоеЗначение;
			ДобавитьСообщение(Сообщения, НСтр("ru = 'Изменен порт SMTP в свойствах учетной записи.';
												|en = 'SMTP port was changed in the account properties.'"), Ложь);
		КонецЕсли;
	КонецЕсли;
	
	// изменяем признак необходимости авторизации на сервере SMTP
	Если КомандаИзменитьФлагТребуетсяSMTPАутентификация <> Неопределено Тогда
		УчетнаяЗаписьОбъект.ТребуетсяSMTPАутентификация = КомандаИзменитьФлагТребуетсяSMTPАутентификация.НовоеЗначение;
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Изменен признак необходимости авторизации на сервере SMTP в свойствах учетной записи.';
											|en = 'Sign indicating the need of authorization on the SMTP server is changed in the account properties.'"), Ложь);
	КонецЕсли;
	
	// изменяем сертификат руководителя
	Если КомандаИзменитьСертификатРуководителя <> Неопределено Тогда
		УчетнаяЗаписьОбъект.СертификатРуководителя = КомандаИзменитьСертификатРуководителя.НовоеЗначение.Отпечаток;
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Изменен сертификат руководителя в свойствах учетной записи.';
											|en = 'Manager certificate was changed in the account properties.'"), Ложь);
	КонецЕсли;
	
	// изменяем сертификат главного бухгалтера
	Если КомандаИзменитьСертификатГлавногоБухгалтера <> Неопределено Тогда
		УчетнаяЗаписьОбъект.СертификатГлавногоБухгалтера = КомандаИзменитьСертификатГлавногоБухгалтера.НовоеЗначение.Отпечаток;
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Изменен сертификат главного бухгалтера в свойствах учетной записи.';
											|en = 'Chief Accountant certificate was changed in the account properties.'"), Ложь);
	КонецЕсли;
	
	// изменяем сертификат для шифрования
	Если КомандаИзменитьСертификатДляШифрования <> Неопределено Тогда
		УчетнаяЗаписьОбъект.СертификатДляШифрования = КомандаИзменитьСертификатДляШифрования.НовоеЗначение.Отпечаток;
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Изменен сертификат для шифрования в свойствах учетной записи.';
											|en = 'Encryption certificate was changed in the account properties.'"), Ложь);
	КонецЕсли;
	
	// если учетная запись была изменена, то пишем
	Если УчетнаяЗаписьОбъект.Модифицированность() Тогда
		Попытка
			УчетнаяЗаписьОбъект.Записать();
			ТранзакцияПустая = Ложь;
		Исключение
			ОтменитьТранзакцию();
			ДобавитьСообщение(Сообщения, НСтр("ru = 'Ошибка обновления настроек учетной записи:';
												|en = 'An error occurred while updating account settings:'") + Символы.ПС + ИнформацияОбОшибке().Описание);
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	
	// Настройка учетной записи непосредственно
	///////////////////////////////////////////////////////////////////////////////
	
	
	///////////////////////////////////////////////////////////////////////////////
	// Фиксация изменений в ИБ
	
	// пытаемся зафиксировать изменения в ИБ
	Если НЕ ТранзакцияПустая Тогда
		Попытка
			ЗафиксироватьТранзакцию();
		Исключение
			ДобавитьСообщение(Сообщения, НСтр("ru = 'Ошибка обновления настроек учетной записи:';
												|en = 'An error occurred while updating account settings:'") + Символы.ПС + ИнформацияОбОшибке().Описание);
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецПопытки;
	Иначе
		ОтменитьТранзакцию();
	КонецЕсли;
	
	// Фиксация изменений в ИБ
	///////////////////////////////////////////////////////////////////////////////
	
	
	///////////////////////////////////////////////////////////////////////////////
	// Регистрация сертификатов в системе
	
	// регистрируем сертификаты
	СоответствиеКомандРегистрацииСертификатовХранилищам = Новый Соответствие;
	СоответствиеКомандРегистрацииСертификатовХранилищам.Вставить("ЗарегистрироватьСертификатКорневойГНИВЦ", "ROOT");
	СоответствиеКомандРегистрацииСертификатовХранилищам.Вставить("ЗарегистрироватьСертификатКорневойТакском", "ROOT");
	СоответствиеКомандРегистрацииСертификатовХранилищам.Вставить("ЗарегистрироватьСертификатКроссГНИВЦ", "CA");
	СоответствиеКомандРегистрацииСертификатовХранилищам.Вставить("ЗарегистрироватьСертификатНалоговогоОргана", "AddressBook");
	СоответствиеКомандРегистрацииСертификатовХранилищам.Вставить("ЗарегистрироватьСертификатСОС", "AddressBook");
	
	СоответствиеКомандРегистрацииСертификатовХранилищам.Вставить("ЗарегистрироватьСертификатОрганаПФР", "AddressBook");
	СоответствиеКомандРегистрацииСертификатовХранилищам.Вставить("ЗарегистрироватьСертификатКорневойПФР", "ROOT");
	СоответствиеКомандРегистрацииСертификатовХранилищам.Вставить("ЗарегистрироватьСертификатКРОССПФР", "CA");
	
	СоответствиеКомандРегистрацииСертификатовХранилищам.Вставить("ЗарегистрироватьСертификатОрганаФСГС", "AddressBook");
	СоответствиеКомандРегистрацииСертификатовХранилищам.Вставить("ЗарегистрироватьСертификатКорневойФСГС", "ROOT");
	СоответствиеКомандРегистрацииСертификатовХранилищам.Вставить("ЗарегистрироватьСертификатКРОССФСГС", "CA");

	СоответствиеКомандРегистрацииСертификатовПредставлениям = Новый Соответствие;
	СоответствиеКомандРегистрацииСертификатовПредставлениям.Вставить("ЗарегистрироватьСертификатКорневойГНИВЦ", "корневой сертиифкат УЦ ГНИВЦ ФНС РФ");
	СоответствиеКомандРегистрацииСертификатовПредставлениям.Вставить("ЗарегистрироватьСертификатКорневойТакском", "корневой сертификат УЦ ""Такском""");
	СоответствиеКомандРегистрацииСертификатовПредставлениям.Вставить("ЗарегистрироватьСертификатКроссГНИВЦ", "кросс-сертификат УЦ");
	СоответствиеКомандРегистрацииСертификатовПредставлениям.Вставить("ЗарегистрироватьСертификатНалоговогоОргана", "сертификат налогового органа");
	СоответствиеКомандРегистрацииСертификатовПредставлениям.Вставить("ЗарегистрироватьСертификатСОС", "сертификат спецоператора");
	
	СоответствиеКомандРегистрацииСертификатовПредставлениям.Вставить("ЗарегистрироватьСертификатОрганаПФР", "сертификат органа ПФР");
	СоответствиеКомандРегистрацииСертификатовПредставлениям.Вставить("ЗарегистрироватьСертификатКорневойПФР", "корневой сертификат, используемый при обмене с ПФР");
	СоответствиеКомандРегистрацииСертификатовПредставлениям.Вставить("ЗарегистрироватьСертификатКРОССПФР", "кросс-сертификат, используемый при обмене с ПФР");
	
	СоответствиеКомандРегистрацииСертификатовПредставлениям.Вставить("ЗарегистрироватьСертификатОрганаФСГС", "сертификат территориального органа ФСГС");
	СоответствиеКомандРегистрацииСертификатовПредставлениям.Вставить("ЗарегистрироватьСертификатКорневойФСГС", "корневой сертификат, используемый при обмене с Росстатом");
	СоответствиеКомандРегистрацииСертификатовПредставлениям.Вставить("ЗарегистрироватьСертификатКРОССФСГС", "кросс-сертификат, используемый при обмене с Росстатом");
	
	СоответствиеИдентификаторовХранилищПредставлениям = Новый Соответствие;
	СоответствиеИдентификаторовХранилищПредставлениям.Вставить("ROOT", "Доверенные корневые центры сертификации");
	СоответствиеИдентификаторовХранилищПредставлениям.Вставить("CA", "Промежуточные центры сертификации");
	СоответствиеИдентификаторовХранилищПредставлениям.Вставить("AddressBook", "Прочие пользователи");
	
	УчетнаяЗапись = УчетнаяЗаписьОбъект.Ссылка;
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура НастроитьПоРОКИ(ОповещениеОЗавершении, УчетнаяЗапись, ТаблицаНеобходимыхИзменений, Сообщения)
	
	СоответствиеКомандРегистрацииСертификатовХранилищам = Неопределено;
	СоответствиеКомандРегистрацииСертификатовПредставлениям = Неопределено;
	СоответствиеИдентификаторовХранилищПредставлениям = Неопределено;
	
	Если ВыполнитьНастройкиПоРОКИ(УчетнаяЗапись,
		ТаблицаНеобходимыхИзменений,
		Сообщения,
		СоответствиеКомандРегистрацииСертификатовХранилищам,
		СоответствиеКомандРегистрацииСертификатовПредставлениям,
		СоответствиеИдентификаторовХранилищПредставлениям) = Ложь Тогда
		
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Новый Структура("Выполнено, Сообщения, УчетнаяЗапись", Ложь, Сообщения, УчетнаяЗапись));
		Возврат;
		
	КонецЕсли;
	
	МассивСообщений = Новый Массив;
	
	ВходящийКонтекст = Новый Структура();
	ВходящийКонтекст.Вставить("СоответствиеКомандРегистрацииСертификатовХранилищам", СоответствиеКомандРегистрацииСертификатовХранилищам);
	ВходящийКонтекст.Вставить("СоответствиеКомандРегистрацииСертификатовПредставлениям", СоответствиеКомандРегистрацииСертификатовПредставлениям);
	ВходящийКонтекст.Вставить("СоответствиеИдентификаторовХранилищПредставлениям", СоответствиеИдентификаторовХранилищПредставлениям);
	ВходящийКонтекст.Вставить("ТаблицаНеобходимыхИзменений", ТаблицаНеобходимыхИзменений);
	ВходящийКонтекст.Вставить("Сообщения", Сообщения);
	ВходящийКонтекст.Вставить("МассивСообщений", МассивСообщений);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	ОписаниеОповещения = Новый ОписаниеОповещения("НастроитьПоРОКИПослеРегистрацииВсехСертификатов", ЭтотОбъект, ДополнительныеПараметры);
	
	МассивВидовКоманд = Новый Массив;
	// цикл по всем возможным командам регистрации сертификатов
	Для Каждого Эл Из СоответствиеКомандРегистрацииСертификатовХранилищам Цикл
		МассивВидовКоманд.Добавить(Эл.Ключ);
	КонецЦикла;
	
	ВходящийКонтекст.Вставить("МассивВидовКоманд", МассивВидовКоманд);
	ВходящийКонтекст.Вставить("НомерТекущегоВидаКоманд", 0);
	
	ЗарегистрироватьСертификатыПоследовательно(ОписаниеОповещения, ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьСертификатыПоследовательно(ОповещениеОЗавершении, ВходящийКонтекст)
		
		НомерТекущегоВидаКоманд = ВходящийКонтекст.НомерТекущегоВидаКоманд;
		МассивВидовКоманд 		= ВходящийКонтекст.МассивВидовКоманд;
		СоответствиеКомандРегистрацииСертификатовХранилищам = ВходящийКонтекст.СоответствиеКомандРегистрацииСертификатовХранилищам;
		ТаблицаНеобходимыхИзменений = ВходящийКонтекст.ТаблицаНеобходимыхИзменений;
		
		ВходящийКонтекст.Вставить("ОповещениеОЗавершенииЦиклаПоВидамКоманд", ОповещениеОЗавершении);

		Если НомерТекущегоВидаКоманд <= МассивВидовКоманд.ВГраница() Тогда
			
			ТекущийВидКоманд = МассивВидовКоманд[НомерТекущегоВидаКоманд];
			ИмяХранилища = СоответствиеКомандРегистрацииСертификатовХранилищам[ТекущийВидКоманд];
			
			// поиск команд текущего вида в таблице изменений
			МассивКоманд = НайтиСтрокиМассиваСтруктур(ТаблицаНеобходимыхИзменений, "Настройка", ТекущийВидКоманд);
			
			ВходящийКонтекст.Вставить("ТекущийВидКоманд", 		ТекущийВидКоманд);
			ВходящийКонтекст.Вставить("ИмяХранилища", 			ИмяХранилища);
			ВходящийКонтекст.Вставить("МассивКоманд", 			МассивКоманд);
			ВходящийКонтекст.Вставить("НомерТекущейКоманды", 	0);
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВходящийКонтекст", ВходящийКонтекст);
			ОписаниеОповещения = Новый ОписаниеОповещения("ЗарегистрироватьСертификатыПоследовательноПослеРегистрацииПоВсемКомандамОдногоВида", ЭтотОбъект, ДополнительныеПараметры);
			
			ЗарегистрироватьСертификатыПоВсемКомандамОдногоВидаПоследовательно(ОписаниеОповещения, ВходящийКонтекст);
			Возврат;
			
		Иначе
			РезультатСтруктура = Новый Структура;
			РезультатСтруктура.Вставить("Выполнено", Истина);
			РезультатСтруктура.Вставить("Сообщения", ВходящийКонтекст.Сообщения);
			РезультатСтруктура.Вставить("МассивСообщений", ВходящийКонтекст.МассивСообщений);
			
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершенииЦиклаПоВидамКоманд, РезультатСтруктура);
		КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьСертификатыПоВсемКомандамОдногоВидаПоследовательно(ОповещениеОЗавершении, ВходящийКонтекст)
		
		НомерТекущейКоманды = ВходящийКонтекст.НомерТекущейКоманды;
		МассивКоманд = ВходящийКонтекст.МассивКоманд;
		
		ВходящийКонтекст.Вставить("ОповещениеОЗавершенииЦиклаПоКомандам", ОповещениеОЗавершении);
		
		Если НомерТекущейКоманды <= МассивКоманд.ВГраница() Тогда
			
			ТекущаяКоманда = МассивКоманд[ВходящийКонтекст.НомерТекущейКоманды];
			
			Сертификат64 = ТекущаяКоманда.НовоеЗначение.Сертификат;

			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВходящийКонтекст", ВходящийКонтекст);
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
			"ЗарегистрироватьСертификатыПоВсемКомандамОдногоВидаПоследовательноПослеЗаписиСертификата64Вфайл", ЭтотОбъект, ДополнительныеПараметры);
			ОперацииСФайламиЭДКОКлиент.Base64ВФайл(ОписаниеОповещения, Сертификат64);
			Возврат;
			
		Иначе
			
			РезультатСтруктура = Новый Структура;
			РезультатСтруктура.Вставить("Сообщения", ВходящийКонтекст.Сообщения);
			РезультатСтруктура.Вставить("МассивСообщений", ВходящийКонтекст.МассивСообщений);
			
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершенииЦиклаПоКомандам, РезультатСтруктура);
			
		КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьСертификатыПоВсемКомандамОдногоВидаПоследовательноПослеЗаписиСертификата64Вфайл(Результат, ДополнительныеПараметры) Экспорт
	
	ВходящийКонтекст = ДополнительныеПараметры.ВходящийКонтекст;
	
	Если НЕ Результат.Выполнено Тогда
		ДобавитьСообщение(ВходящийКонтекст.Сообщения,
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось зарегистрировать %1 в системном хранилище ""%2""!';
																				|en = 'Cannot register %1 in the ""%2"" system storage.'"),
					ВходящийКонтекст.СоответствиеКомандРегистрацииСертификатовПредставлениям[ВходящийКонтекст.ТекущийВидКоманд],
					ВходящийКонтекст.СоответствиеИдентификаторовХранилищПредставлениям[ВходящийКонтекст.ИмяХранилища]));

		РезультатСтруктура = Новый Структура;
		РезультатСтруктура.Вставить("Выполнено", Ложь);
		РезультатСтруктура.Вставить("Сообщения", ВходящийКонтекст.Сообщения);
		РезультатСтруктура.Вставить("МассивСообщений", ВходящийКонтекст.МассивСообщений);
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершенииЦиклаПоВидамКоманд, РезультатСтруктура);
		Возврат;
	КонецЕсли;	
	
	ФайлСертификата = Результат.ИмяФайла;

	// импортируем сертификат
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВходящийКонтекст", ВходящийКонтекст);

	ОписаниеОповещения = Новый ОписаниеОповещения("ЗарегистрироватьСертификатыПоВсемКомандамОдногоВидаПоследовательноПослеИмпортированияСертификата", ЭтотОбъект, ДополнительныеПараметры);
	
	КриптографияЭДКОКлиент.ИмпортироватьСертификат(ОписаниеОповещения, ФайлСертификата, ВходящийКонтекст.ИмяХранилища);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьСертификатыПоВсемКомандамОдногоВидаПоследовательноПослеИмпортированияСертификата(Результат, ДополнительныеПараметры) Экспорт
	
	ВходящийКонтекст = ДополнительныеПараметры.ВходящийКонтекст;
	
	Если НЕ Результат.Выполнено Тогда
		
		ДобавитьСообщение(ВходящийКонтекст.Сообщения,
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось зарегистрировать %1 в системном хранилище ""%2""!';
																				|en = 'Cannot register %1 in the ""%2"" system storage.'"),
					ВходящийКонтекст.СоответствиеКомандРегистрацииСертификатовПредставлениям[ВходящийКонтекст.ТекущийВидКоманд],
					ВходящийКонтекст.СоответствиеИдентификаторовХранилищПредставлениям[ВходящийКонтекст.ИмяХранилища]));

		РезультатСтруктура = Новый Структура;
		РезультатСтруктура.Вставить("Выполнено", Ложь);
		РезультатСтруктура.Вставить("Сообщения", ВходящийКонтекст.Сообщения);
		РезультатСтруктура.Вставить("МассивСообщений", ВходящийКонтекст.МассивСообщений);
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершенииЦиклаПоВидамКоманд, РезультатСтруктура);
		Возврат;
	КонецЕсли;	
	
	ПредставлениеСертификата = ВходящийКонтекст.СоответствиеКомандРегистрацииСертификатовПредставлениям[ВходящийКонтекст.ТекущийВидКоманд];
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1%2 успешно зарегистрирован в системном хранилище ""%3"".';
																					|en = '%1%2 is successfully registered in the ""%3"" system storage.'"),
	ВРЕГ(Лев(ПредставлениеСертификата, 1)),
	Сред(ПредставлениеСертификата, 2),
	ВходящийКонтекст.СоответствиеИдентификаторовХранилищПредставлениям[ВходящийКонтекст.ИмяХранилища]);
	
	ДобавленноеСообщение = Новый Структура("Сообщение, Ошибка", ТекстСообщения, Ложь);
	ВходящийКонтекст.МассивСообщений.Добавить(ДобавленноеСообщение);
	
	ВходящийКонтекст.НомерТекущейКоманды = ВходящийКонтекст.НомерТекущейКоманды + 1;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВходящийКонтекст", ВходящийКонтекст);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗарегистрироватьСертификатыПоследовательноПослеРегистрацииПоВсемКомандамОдногоВида", ЭтотОбъект, ДополнительныеПараметры);

	ЗарегистрироватьСертификатыПоВсемКомандамОдногоВидаПоследовательно(ОписаниеОповещения, ВходящийКонтекст)
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьСертификатыПоследовательноПослеРегистрацииПоВсемКомандамОдногоВида(Результат, ДополнительныеПараметры) Экспорт
	
	ВходящийКонтекст 		= ДополнительныеПараметры.ВходящийКонтекст;
	
	ВходящийКонтекст.Вставить("Сообщения", Результат.Сообщения);
	ВходящийКонтекст.Вставить("МассивСообщений", Результат.МассивСообщений);
	
	ВходящийКонтекст.Вставить("НомерТекущегоВидаКоманд", ВходящийКонтекст.НомерТекущегоВидаКоманд + 1);
	
	ЗарегистрироватьСертификатыПоследовательно(ВходящийКонтекст.ОповещениеОЗавершенииЦиклаПоВидамКоманд, ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьПоРОКИПослеРегистрацииВсехСертификатов(Результат, ДополнительныеПараметры) Экспорт
	
	ОповещениеОЗавершении = ДополнительныеПараметры.ОповещениеОЗавершении;
	
	// перед возвратом дополним Сообщения
	ДополнитьСообщения(Результат.Сообщения, Результат.МассивСообщений);
	
	РезультатСтруктура = Новый Структура;
	РезультатСтруктура. Вставить("Выполнено", Результат.Выполнено);
	РезультатСтруктура. Вставить("Сообщения", Результат.Сообщения);
	РезультатСтруктура. Вставить("УчетнаяЗапись", ДополнительныеПараметры.УчетнаяЗапись);
	
	ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, РезультатСтруктура);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСтруктуруСсылочныхДанных();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СтрокаОС() Экспорт
	
	СисИнфо = Новый СистемнаяИнформация;
	Если СисИнфо.ТипПлатформы = ТипПлатформы.Linux_x86 Тогда
		Возврат "Linux32";
	ИначеЕсли СисИнфо.ТипПлатформы = ТипПлатформы.Linux_x86_64 Тогда
		Возврат "Linux64";
	ИначеЕсли СисИнфо.ТипПлатформы = ТипПлатформы.Windows_x86 Тогда
		Возврат "Windows32";
	Иначе
		Возврат "Windows64";
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьФайлНастроекУчетнойЗаписиССервераРОКИСУчетомКэша(Знач УчетнаяЗапись,
																Знач Организация = Неопределено,
																УведомлятьТолькоОбОшибках = Ложь,
																ИгнорироватьРежимАвтонастройки = Ложь,
																ТихийРежим = Ложь,
																ЗапрашиватьПараметрыОрганизацииПриНеобходимости = Ложь,
																УникальныйИдентификатор = Неопределено) Экспорт
	
	// учетной записью может оказаться организация
	Если ТипЗнч(УчетнаяЗапись) = Тип("СправочникСсылка.Организации") Тогда
		Если УчетнаяЗапись.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
			Возврат Неопределено;
		КонецЕсли;
		Организация = УчетнаяЗапись;
		УчетнаяЗапись = Организация.УчетнаяЗаписьОбмена;
	КонецЕсли;
	
	// получаем настройки учетной записи
	НастройкиУчетнойЗаписи = ПолучитьНастройкиУчетнойЗаписиИзИБ(УчетнаяЗапись);
	
	// если настройки недоступны или учетка для обмена напрямую, то прервемся
	Если НастройкиУчетнойЗаписи = Неопределено ИЛИ НастройкиУчетнойЗаписи.ОбменНапрямую Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// если включено принудительное игнорирование режима автонастройки
	// или отключена автонастройка в свойствах учетной записи, то прервемся
	Если НЕ ИгнорироватьРежимАвтонастройки
	И (НастройкиУчетнойЗаписи.РежимАвтонастройки = Перечисления.РежимыАвтонастройкиУчетнойЗаписиНалогоплательщика.Отключена
	ИЛИ НастройкиУчетнойЗаписи.РежимАвтонастройки = Перечисления.РежимыАвтонастройкиУчетнойЗаписиНалогоплательщика.ПустаяСсылка()) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// создаем вспомогательную таблицу сообщений
	Сообщения = СоздатьТаблицуСообщений();
	
	// инициализурем переменную, в которой будет храниться указатель на форму с информацией
	ФормаПрогресса = Неопределено;
	
	// соединяемся с сервером
	ПараметрыСоединенияССервером = СформироватьПараметрыСоединенияССервером(
		УчетнаяЗапись,
		Организация,
		ЗапрашиватьПараметрыОрганизацииПриНеобходимости,
		Сообщения);
		
	Если ПараметрыСоединенияССервером <> Неопределено Тогда
		
		ФайлНастроекРасшифрован = Ложь;
		ДатаОбновленияФайлаНастроекНаСервере = Неопределено;
	
		// устанавливаем соединение
		ОписаниеОшибкиУстановкиСоединения = "";
		Соединение = ДокументооборотСКО.УстановитьСоединениеССерверомИнтернета(ПараметрыСоединенияССервером.ИмяСервераРОКИ, ОписаниеОшибкиУстановкиСоединения);
		Если Соединение = Неопределено Тогда
			ДобавитьСообщение(
				Сообщения, 
				СтрШаблон(НСтр("ru = 'Не удалось установить соединение с сервером ""Такском"":
                                |%1';
                                |en = 'Cannot connect to the Taxcom server:
                                |%1'"), ОписаниеОшибкиУстановкиСоединения));
			Возврат Неопределено;
		КонецЕсли;
		
		// если соединение прошло успешно, то получаем дату обновления файла настроек
		Если Соединение <> Неопределено Тогда
			
			ДатаОбновленияФайлаНастроекНаСервере = ПолучитьДатуОбновленияФайлаНастроекНаСервере(Соединение, ПараметрыСоединенияССервером, Сообщения);
			Если НЕ ЗначениеЗаполнено(ДатаОбновленияФайлаНастроекНаСервере) Тогда
				ВывестиСообщения(УчетнаяЗапись, Сообщения, УведомлятьТолькоОбОшибках);
				Возврат Неопределено;
			КонецЕсли;
			
			ФайлНастроек = ПолучитьЗакэшированныйФайлНастроек(
				УчетнаяЗапись,
				ПараметрыСоединенияССервером,
				ДатаОбновленияФайлаНастроекНаСервере,
				ФайлНастроекРасшифрован,
				Сообщения);
			
			// если в кэше нет файла с такой датой, то получаем его с сервера
			Если ФайлНастроек = Неопределено Тогда
				
				ИнформацияОбОшибке = Неопределено;
				ФайлНастроек = ПолучитьФайлССервера(Соединение, ПараметрыСоединенияССервером.ИмяРесурсаСНастройками, ИнформацияОбОшибке, Истина);
				Соединение = Неопределено;
				
				Если ФайлНастроек = Неопределено Тогда
					ДобавитьСообщение(Сообщения, НСтр("ru = 'Ошибка получения с сервера файла с информацией о настройках учетной записи:';
														|en = 'An error occurred while receiving a file with information about account settings from the server:'") + Символы.ПС + ИнформацияОбОшибке.Описание);
					ВывестиСообщения(УчетнаяЗапись, Сообщения, УведомлятьТолькоОбОшибках);
					Возврат Неопределено;
				КонецЕсли;
				
				// сохраняем полученный файл в кэше
				СохранитьВКэшеФайлНастроек(УчетнаяЗапись, ПараметрыСоединенияССервером.ИмяРесурсаСНастройками, ФайлНастроек, Ложь, ДатаОбновленияФайлаНастроекНаСервере);
				ФайлНастроекРасшифрован = Ложь;
				
			КонецЕсли;
			
			// закрываем соединение
			Соединение = Неопределено;
			
		Иначе
			ФайлНастроек = ПолучитьЗакэшированныйФайлНастроек(
				УчетнаяЗапись,
				ПараметрыСоединенияССервером,
				ДатаОбновленияФайлаНастроекНаСервере,
				ФайлНастроекРасшифрован,
				Сообщения);
		КонецЕсли;
		
		// на клиента возвращаем файл
		ФайлНастроек = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ФайлНастроек), УникальныйИдентификатор);
		
		Возврат Новый Структура("Файл, Дата, Расшифрован, ИмяРесурса",
						ФайлНастроек, ДатаОбновленияФайлаНастроекНаСервере, ФайлНастроекРасшифрован, ПараметрыСоединенияССервером.ИмяРесурсаСНастройками);
		
	Иначе
		ВывестиСообщения(УчетнаяЗапись, Сообщения, УведомлятьТолькоОбОшибках);
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСтруктуруСсылочныхДанных()
	
	СтруктураСсылочныхДанных = Новый Структура;
	СтруктураСсылочныхДанных.Вставить("Перечисления_ФорматыДокументооборотаСФНС_Приказ534", Перечисления.ФорматыДокументооборотаСФНС.Приказ534);
	
	СтруктураСсылочныхДанных.Вставить("Перечисления_ТипыЦикловОбмена_НалоговаяИлиБухгалтерскаяОтчетность", Перечисления.ТипыЦикловОбмена.НалоговаяИлиБухгалтерскаяОтчетность);
	СтруктураСсылочныхДанных.Вставить("Перечисления_ТипыЦикловОбмена_ИОН", Перечисления.ТипыЦикловОбмена.ИОН);
	СтруктураСсылочныхДанных.Вставить("Перечисления_ТипыЦикловОбмена_ОтчетностьПФР", Перечисления.ТипыЦикловОбмена.ОтчетностьПФР);
	СтруктураСсылочныхДанных.Вставить("Перечисления_ТипыЦикловОбмена_ОтчетностьФСГС", Перечисления.ТипыЦикловОбмена.ОтчетностьФСГС);
	СтруктураСсылочныхДанных.Вставить("Перечисления_ТипыЦикловОбмена_ЗапросыНаИнформационноеОбслуживание", Перечисления.ТипыЦикловОбмена.ЗапросыНаИнформационноеОбслуживание);
	СтруктураСсылочныхДанных.Вставить("Перечисления_ТипыЦикловОбмена_НеформализованныеДокументыНалоговогоОргана", Перечисления.ТипыЦикловОбмена.НеформализованныеДокументыНалоговогоОргана);
	СтруктураСсылочныхДанных.Вставить("Перечисления_ТипыЦикловОбмена_ПисьмоНО", Перечисления.ТипыЦикловОбмена.ПисьмоНО);
	СтруктураСсылочныхДанных.Вставить("Перечисления_ТипыЦикловОбмена_НеформализованныеДокументыНалогоплательщика" , Перечисления.ТипыЦикловОбмена.НеформализованныеДокументыНалогоплательщика );
	СтруктураСсылочныхДанных.Вставить("Перечисления_ТипыЦикловОбмена_НеформализованнаяПерепискаПФРИсходящие", Перечисления.ТипыЦикловОбмена.НеформализованнаяПерепискаПФРИсходящие);
