			ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.БанкРоссии"), 
			Отправка);
		
		ДополнительныеПараметры = Новый Структура("Форма, Отправки, НомерОбъекта, ВыполняемоеОповещение", Форма, Отправки, НомерОбъекта, ВыполняемоеОповещение);
