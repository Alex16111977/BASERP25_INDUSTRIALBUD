&НаКлиенте
Процедура ОсуществитьОбменПоОрганизацииФТС(Результат, ДополнительныеПараметры) Экспорт
	
	Форма 						= ДополнительныеПараметры.Форма;
	Организация 				= ДополнительныеПараметры.Организация;
	ВыполняемоеОповещение 		= ДополнительныеПараметры.ВыполняемоеОповещение;
	КонтролирующийОрган 		= ДополнительныеПараметры.КонтролирующийОрган;
	СсылкаНаОтправляемыйОбъект 	= ДополнительныеПараметры.СсылкаНаОтправляемыйОбъект;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОсуществитьОбменПоОрганизацииФСРАР", ЭтотОбъект, ДополнительныеПараметры);
	
	// ФТС
	Если КонтролирующийОрган = Неопределено ИЛИ КонтролирующийОрган = "ФТС" Тогда
		Если СсылкаНаОтправляемыйОбъект = Неопределено Тогда
			// Выполняем отправку для нескольких ссылок
			Отправки = НезавершенныеПоследниеОтправкиФТСПоОрганизации(Организация);
		Иначе
			// Выполняем отправку только для одной ссылки 
			Отправки = Новый Массив;
			Отправка = ПолучитьПоследнююОтправкуОтчетаВФТС(СсылкаНаОтправляемыйОбъект);
			Если Отправка <> Неопределено Тогда 
				Отправки.Добавить(Отправка);
			КонецЕсли;
		КонецЕсли;
		
		Если Отправки = Неопределено Или Отправки.Количество() = 0 Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		Иначе
			ЭтоВызовИзСписка = (СсылкаНаОтправляемыйОбъект = Неопределено);
			ОбновитьРезультатНезавершенныхПоследнихОтправокФТСПоОрганизации(Форма, Отправки, 0, ЭтоВызовИзСписка, ОписаниеОповещения);
		КонецЕсли;
	Иначе
		// После ФТС выполняем обмен по ФСРАР
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатНезавершенныхПоследнихОтправокФТСПоОрганизации(Форма, Отправки, НомерОбъекта, ЭтоВызовИзСписка, ВыполняемоеОповещение)

	Если НомерОбъекта + 1 > Отправки.Количество() Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	Иначе
		Отправка = Отправки[НомерОбъекта];
		
		ДлительнаяОтправкаКлиент.ОповеститьОСменеЭтапаОбмена(
			"ОсуществитьОбменПоОрганизацииФТС", 
			ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФТС"),
			Отправка);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Форма", 					Форма);
		ДополнительныеПараметры.Вставить("Отправки", 				Отправки);
		ДополнительныеПараметры.Вставить("НомерОбъекта", 			НомерОбъекта);
		ДополнительныеПараметры.Вставить("ЭтоВызовИзСписка", 		ЭтоВызовИзСписка);
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьРезультатНезавершенныхПоследнихОтправокФТСПоОрганизацииЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		Если ЗначениеЗаполнено(Отправка) Тогда
			ОбновитьРезультатКонкретнойОтправкиФТС(Форма, Отправка, ОписаниеОповещения,, ЭтоВызовИзСписка);
		Иначе
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

