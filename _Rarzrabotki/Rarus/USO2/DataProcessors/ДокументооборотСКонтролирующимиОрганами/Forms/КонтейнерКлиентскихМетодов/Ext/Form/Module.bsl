КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьЗаполнениеЗапросаИОС(ДокЗапрос, Параметры)
	
	СтатусПроверки = Истина;
	
	Если НЕ ЗначениеЗаполнено(ДокЗапрос.Организация) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задана организация!';
															|en = 'Company is not set.'"));
		СтатусПроверки = Ложь;
	ИначеЕсли НЕ ЗначениеЗаполнено(ДокЗапрос.Получатель) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан получатель!';
															|en = 'Recipient is not specified.'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокЗапрос.Организация) И НЕ ЗначениеЗаполнено(Параметры.РегНомПФР) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан регистрационный номер организации в справочнике!';
															|en = 'Company registration number is not specified in the catalog.'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДокЗапрос.Организация) И НЕ ЗначениеЗаполнено(Параметры.КодОрганаПФР) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан код территориального органа ПФР в справочнике!';
															|en = 'Code of PF local authority is not specified in the catalog.'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если НЕ СтатусПроверки Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// проверяем на заполненность вид услуги
	ВидУслуги = ДокЗапрос.ВидУслуги;
	Если НЕ ЗначениеЗаполнено(ВидУслуги) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не выбран вид услуги!';
															|en = 'Service kind is not selected.'"));
		СтатусПроверки = Ложь;
		Возврат СтатусПроверки;
	ИначеЕсли ВидУслуги = Перечисления.ВидыУслугПриИОС.СверкаФИОиСНИЛС Тогда
		
		Если ДокЗапрос.ЗастрахованныеЛица.Количество() = 0 Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не заданы застрахованные лица, по которым производится запрос на сверку!';
																|en = 'Insured persons for whom reconciliation is requested are not specified.'"));
			СтатусПроверки = Ложь;
			Возврат СтатусПроверки;
		Иначе
			
			Для Каждого СтрЗастрахованноеЛицо Из ДокЗапрос.ЗастрахованныеЛица Цикл
				Если НЕ ЗначениеЗаполнено(СтрЗастрахованноеЛицо.Фамилия) Тогда
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В строке %1 не задана фамилия застрахованного лица.';
																																|en = 'The insured person''s last name is not specified in line %1.'"), СтрЗастрахованноеЛицо.НомерСтроки));
					СтатусПроверки = Ложь;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(СтрЗастрахованноеЛицо.Имя) Тогда
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В строке %1 не задано имя застрахованного лица.';
																																|en = 'The insured person''s name is not specified in line %1.'"), СтрЗастрахованноеЛицо.НомерСтроки));
					СтатусПроверки = Ложь;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ СтатусПроверки Тогда
				Возврат СтатусПроверки;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтатусПроверки;
	
КонецФункции

&НаСервереБезКонтекста
