&НаСервере
Процедура СформироватьТаблицуОтветовНаЗапросИОС(Запрос)
	
	ТаблицаОтветовНаЗапросИОC = ПолучитьОтветыНаЗапросИОС(Запрос, Истина);
	ТаблицаОтветовНаЗапросИОC.Колонки.Добавить("Адрес");
	Для Каждого СтрокаОтвета Из ТаблицаОтветовНаЗапросИОC Цикл
		Если ЗначениеЗаполнено(СтрокаОтвета.Данные) Тогда 
			ГУИД = Новый УникальныйИдентификатор;
			СтрокаОтвета.Адрес = ПоместитьВоВременноеХранилище(СтрокаОтвета.Данные.Получить(), ГУИД);
		КонецЕсли;
	КонецЦикла;
	
	ОтветыНаЗапросыИОС.Загрузить(ТаблицаОтветовНаЗапросИОC);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьФайлЗапросаИОС(Запрос, ДвоичныеДанныеФайлаЗапроса, ИмяФайлаЗапроса, УникальныйИдентификатор = Неопределено)
	
	// собираем параметры письма
	ПараметрыЗапроса = СформироватьПараметрыОтправкиВПФР(Запрос.Организация);
	Если НЕ ПроверитьЗаполнениеЗапросаИОС(Запрос, ПараметрыЗапроса) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось сформировать запрос на информационное обслуживание!';
															|en = 'Cannot generate a request for information support.'"));
		Возврат Ложь;
	КонецЕсли;
	
	// инициализируем служебные соответствия
	СоответствиеВидаУслугиКоду = Новый Соответствие;
	СоответствиеВидаУслугиКоду.Вставить(Перечисления.ВидыУслугПриИОС.СправкаОСостоянииРасчетов, "1");
	СоответствиеВидаУслугиКоду.Вставить(Перечисления.ВидыУслугПриИОС.СверкаФИОиСНИЛС, "2");
	
	ИмяФайлаБезРасширения = "PFR-REQ-ORG-" + СокрЛП(ПараметрыЗапроса.РегНомПФР) + "-" + СгенерироватьUUID();
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	УзелЗапрос = ДобавитьУзелXML(Дерево, "запрос");
	
	Если Запрос.ВидУслуги = Перечисления.ВидыУслугПриИОС.СправкаОСостоянииРасчетов Тогда
		
		ДобавитьУзелXML(УзелЗапрос, "версияФормата", Истина, XMLСтрока("01"));
		
		ДобавитьУзелXML(УзелЗапрос, "кодУПФР", , СокрЛП(ПараметрыЗапроса.КодОрганаПФР));
		ДобавитьУзелXML(УзелЗапрос, "регистрационныйНомерПлательщика", , СокрЛП(ПараметрыЗапроса.РегНомПФР));
		ДобавитьУзелXML(УзелЗапрос, "кодОтвета", , "1");
		ДобавитьУзелXML(УзелЗапрос, "наДату", , Формат(Запрос.НаДату, "ДФ=yyyy-MM-dd"));
		
	ИначеЕсли Запрос.ВидУслуги = Перечисления.ВидыУслугПриИОС.СверкаФИОиСНИЛС Тогда
		
		ДобавитьУзелXML(УзелЗапрос, "кодУПФР", , СокрЛП(ПараметрыЗапроса.КодОрганаПФР));
		ДобавитьУзелXML(УзелЗапрос, "регистрационныйНомерПлательщика", , СокрЛП(ПараметрыЗапроса.РегНомПФР));
		ДобавитьУзелXML(УзелЗапрос, "кодОтвета", , "2");
		
		УзелСписокЗастрахованныхЛиц = ДобавитьУзелXML(УзелЗапрос, "списокЗастрахованныхЛиц");
		
		Для Каждого Стр Из Запрос.ЗастрахованныеЛица Цикл
			
			УзелЗастрахованноеЛицо = ДобавитьУзелXML(УзелСписокЗастрахованныхЛиц, "застрахованноеЛицо");
			
			УзелФИО = ДобавитьУзелXML(УзелЗастрахованноеЛицо, "ФИО");
			ДобавитьУзелXML(УзелФИО, "Фамилия", , ВРЕГ(СокрЛП(Стр.Фамилия)));
			ДобавитьУзелXML(УзелФИО, "Имя", , ВРЕГ(СокрЛП(Стр.Имя)));
			ДобавитьУзелXML(УзелФИО, "Отчество", , ВРЕГ(СокрЛП(Стр.Отчество)));
			
			ДобавитьУзелXML(УзелЗастрахованноеЛицо, "страховойНомер", , СокрЛП(Стр.СтраховойНомер));
			
		КонецЦикла;
		
	КонецЕсли;
	
	// сохранение дерева XML в файл и двоичные данные
	ТекстВыгрузкиXML = ЗаписатьДеревоВXML(Дерево);
	
	// записываем XML запроса во временный файл
	ВремФайл = ПолучитьИмяВременногоФайла();
	Если НЕ ЗаписатьXMLВФайл(ТекстВыгрузкиXML, ВремФайл) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось записать текст запроса во временный файл!';
															|en = 'Cannot write the query text to the temporary file.'"));
		Возврат Ложь;
	КонецЕсли;
	
	// считываем двоичные данные файла запроса, после чего удаляем файл
	ДвоичныеДанныеФайлаЗапроса = Новый ДвоичныеДанные(ВремФайл);
	ДвоичныеДанныеФайлаЗапроса = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаЗапроса, УникальныйИдентификатор);
	УдалитьФайлы(ВремФайл);
	
	// формируем имя файла запроса
	ИмяФайлаЗапроса = ИмяФайлаБезРасширения + ".xml";
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОсновныеСвойстваИзПодтвержденияОПолученииПФР(СтрПодтверждение)
	
	Если НЕ ЗначениеЗаполнено(СтрПодтверждение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаИменФайлов = Новый ТаблицаЗначений;
	ТаблицаИменФайлов.Колонки.Добавить("ИмяФайла");
	
	// создаем дерево на основе строки XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений( , СтрПодтверждение, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка разбора XML подтверждения о получении:%1';
																						|en = 'An error occurred while parsing XML receipt confirmation:%1'"), Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем XML
	УзелФайл = ДеревоXML.Строки.Найти("подтверждениеПолучения", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку("Некорректная структура XML протокола: не обнаружен узел ""подтверждениеПолучения"".");
		Возврат Неопределено;
	КонецЕсли;
	
	ОбщиеСведения = Новый Структура;
	
	УзелРегНомер = УзелФайл.Строки.Найти("регистрационныйНомерОрганизации", "Имя");
	РегистрационныйНомер = ?(ЗначениеЗаполнено(УзелРегНомер), СокрЛП(УзелРегНомер.Значение), "");
	ОбщиеСведения.Вставить("РегистрационныйНомер", РегистрационныйНомер);
	
	УзелДатаПолучения = УзелФайл.Строки.Найти("датаВремяПолучения", "Имя");    	
	ДатаПолучения = ?(ЗначениеЗаполнено(УзелДатаПолучения), Формат(XMLЗначение(Тип("Дата"),УзелДатаПолучения.Значение), "ДЛФ=DDT"), "");
	ОбщиеСведения.Вставить("ДатаПолучения", ДатаПолучения);
	
	УзлыОписаниеПачек = УзелФайл.Строки.НайтиСтроки(Новый Структура("Имя", "описаниеПачек"));
	Для Каждого УзелОписаниеПачек Из УзлыОписаниеПачек Цикл
		УзлыИменФайлов = УзелОписаниеПачек.Строки.НайтиСтроки(Новый Структура("Имя", "пачка"));
		Для Каждого УзлыИмен Из УзлыИменФайлов Цикл
			
			УзелИмяФайла = УзлыИмен.Строки.Найти("имяФайла", "Имя");
			ИмяФайла = ?(ЗначениеЗаполнено(УзелИмяФайла), СокрЛП(УзелИмяФайла.Значение), "");
			НовСтр = ТаблицаИменФайлов.Добавить();
			НовСтр.ИмяФайла = ИмяФайла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Новый Структура("ИмяФайла, ОбщиеСведения", ТаблицаИменФайлов, ОбщиеСведения);
	
КонецФункции

&НаСервере
Функция ПолучитьОсновныеСвойстваИзПротоколаПФР(СтрПротокол)
	
	Если НЕ ЗначениеЗаполнено(СтрПротокол) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаИменФайлов = Новый ТаблицаЗначений;
	ТаблицаИменФайлов.Колонки.Добавить("ИмяФайла");
	
	ТаблицаИменВложений = Новый ТаблицаЗначений;
	ТаблицаИменВложений.Колонки.Добавить("ИмяВложения");
	
	// создаем дерево на основе строки XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений( , СтрПротокол, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка разбора XML подтверждения о получении:%1';
																						|en = 'An error occurred while parsing XML receipt confirmation:%1'"), Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем XML
	УзелФайл = ДеревоXML.Строки.Найти("протокол", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку("Некорректная структура XML протокола: не обнаружен узел ""протокол"".");
		Возврат Неопределено;
	КонецЕсли;
	
	ОбщиеСведения = Новый Структура;
	
	УзелЯвляетсяПоложительным = УзелФайл.Строки.Найти("являетсяПоложительным", "Имя");
	ЯвляетсяПоложительным = ?(ЗначениеЗаполнено(УзелЯвляетсяПоложительным), XMLЗначение(Тип("Булево"),УзелЯвляетсяПоложительным.Значение), "");
	ОбщиеСведения.Вставить("ЯвляетсяПоложительным", ЯвляетсяПоложительным);
	
	УзелДатаОтправки = УзелФайл.Строки.Найти("датаВремяОтправки", "Имя");
	ДатаОтправки = ?(ЗначениеЗаполнено(УзелДатаОтправки), Формат(XMLЗначение(Тип("Дата"),УзелДатаОтправки.Значение), "ДЛФ=DDT"), "");
	ОбщиеСведения.Вставить("ДатаОтправки", ДатаОтправки);
	
	УзелПодтверждение = УзелФайл.Строки.Найти("подтверждениеПолучения", "Имя");
	
	УзелРегНомер = УзелПодтверждение.Строки.Найти("регистрационныйНомерОрганизации", "Имя");
	РегистрационныйНомер = ?(ЗначениеЗаполнено(УзелРегНомер), СокрЛП(УзелРегНомер.Значение), "");
	ОбщиеСведения.Вставить("РегистрационныйНомер", РегистрационныйНомер);
	
	УзелДатаПолучения = УзелПодтверждение.Строки.Найти("датаВремяПолучения", "Имя");
	ДатаПолучения = ?(ЗначениеЗаполнено(УзелДатаПолучения), Формат(XMLЗначение(Тип("Дата"),УзелДатаПолучения.Значение), "ДЛФ=DDT"), "");
	ОбщиеСведения.Вставить("ДатаПолучения", ДатаПолучения);	
	
	УзлыОписаниеПачек = УзелПодтверждение.Строки.НайтиСтроки(Новый Структура("Имя", "описаниеПачек"));
	Для Каждого УзелОписаниеПачек Из УзлыОписаниеПачек Цикл
		УзлыИменФайлов = УзелОписаниеПачек.Строки.НайтиСтроки(Новый Структура("Имя", "пачка"));
		Для Каждого УзлыИмен Из УзлыИменФайлов Цикл
			
			УзелИмяФайла = УзлыИмен.Строки.Найти("имяФайла", "Имя");
			ИмяФайла = ?(ЗначениеЗаполнено(УзелИмяФайла), СокрЛП(УзелИмяФайла.Значение), "");
			НовСтр = ТаблицаИменФайлов.Добавить();
			НовСтр.ИмяФайла = ИмяФайла;
		КонецЦикла;
	КонецЦикла;
	
	УзлыОписаниеПриложений = УзелФайл.Строки.НайтиСтроки(Новый Структура("Имя", "описаниеПриложений"));
	Для Каждого УзелОписаниеПриложений Из УзлыОписаниеПриложений Цикл
		УзлыИменПриложений = УзелОписаниеПриложений.Строки.НайтиСтроки(Новый Структура("Имя", "приложение"));
		Для Каждого УзлыИмен Из УзлыИменПриложений Цикл
			УзелИмяФайла = УзлыИмен.Строки.Найти("имяФайла", "Имя");
			ИмяФайла = ?(ЗначениеЗаполнено(УзелИмяФайла), СокрЛП(УзелИмяФайла.Значение), "");
			НовСтр = ТаблицаИменВложений.Добавить();
			НовСтр.ИмяВложения = ИмяФайла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Новый Структура("ИмяФайла, ОбщиеСведения, Вложения", ТаблицаИменФайлов, ОбщиеСведения, ТаблицаИменВложений);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОсновныеСвойстваПФРИзЦиклаОбмена(ЦиклОбмена)
	
	ДатыСообщений = Новый Структура;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
						  |	ТранспортныеСообщения.Тип КАК Тип,
						  |	ТранспортныеСообщения.ДатаТранспорта,
						  |	ТранспортныеСообщения.Дата КАК Дата
						  |ИЗ
						  |	Документ.ТранспортноеСообщение КАК ТранспортныеСообщения
						  |ГДЕ
						  |	ТранспортныеСообщения.ЦиклОбмена = &ЦиклОбмена
						  |");
	Запрос.УстановитьПараметр("ЦиклОбмена", ЦиклОбмена);
	ТаблицаСообщений = Запрос.Выполнить().Выгрузить();
	
	СообщенияТекТипа = ТаблицаСообщений.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьПФР));
	ДатаОтправленоСтрахователем = "";
	Если СообщенияТекТипа.Количество() <> 0 Тогда
		Для Каждого СтрСообщение Из СообщенияТекТипа Цикл
			ДатаОтправленоСтрахователем = Формат(СтрСообщение.ДатаТранспорта, "ДЛФ=DDT");
		КонецЦикла;
	КонецЕсли;
	ДатыСообщений.Вставить("ДатаОтправленоСтрахователем", ДатаОтправленоСтрахователем);
	
	СообщенияТекТипа = ТаблицаСообщений.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПолученияОтчетностиПФР));
	ДатаПодтверждения = "";
	Если СообщенияТекТипа.Количество() <> 0 Тогда
		Для Каждого СтрСообщение Из СообщенияТекТипа Цикл
			ДатаПодтверждения = Формат(СтрСообщение.ДатаТранспорта, "ДЛФ=DDT");
		КонецЦикла;
	КонецЕсли;
	ДатыСообщений.Вставить("ДатаПодтверждения", ДатаПодтверждения);
	
	СообщенияТекТипа = ТаблицаСообщений.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПротоколПФР));
	ДатаПротокола = "";
	Если СообщенияТекТипа.Количество() <> 0 Тогда
		Для Каждого СтрСообщение Из СообщенияТекТипа Цикл
			ДатаПротокола = Формат(СтрСообщение.ДатаТранспорта, "ДЛФ=DDT");
		КонецЦикла;
	КонецЕсли;
	ДатыСообщений.Вставить("ДатаПротокола", ДатаПротокола);
	
	возврат ДатыСообщений;
КонецФункции

// - Формирование печатной формы протокола Росстат
&НаСервере
Функция СформироватьТабличныйДокументНаОсновеПротоколаФСГС(Заголовок, ИмяФайла, Тело, ЦиклОбмена)
	
	ТекстПротокола = Тело;
	
	// загружаем XML из строки в дерево
	ДеревоXML = ЗагрузитьСтрокуXMLВДеревоЗначений(Тело);
	
	Если ДеревоXML <> Неопределено Тогда
		
		УзелПротокол = ДеревоXML.Строки.Найти("protocol", "Имя");
		
		Если УзелПротокол <> Неопределено Тогда
			
			УзелСтатусПротокола = УзелПротокол.Строки.Найти("status", "Имя");
			СтатусПротокола = "";
			Если УзелСтатусПротокола <> Неопределено Тогда
				СтатусПротокола = XMLЗначение(Тип("Строка"), УзелСтатусПротокола.Значение);
			КонецЕсли;
			УзелСообщениеПротокола = УзелПротокол.Строки.Найти("msg", "Имя");
			СообщениеПротокола = "";
			Если УзелСообщениеПротокола <> Неопределено Тогда
				СообщениеПротокола = XMLЗначение(Тип("Строка"), УзелСообщениеПротокола.Значение);
			КонецЕсли;
			
			УзелТитульный = УзелПротокол.Строки.Найти("title", "Имя");
			Если УзелТитульный <> Неопределено Тогда
				
				ЗначенияЭлементов = Новый Соответствие;
				УзлыЭлементы = УзелТитульный.Строки.НайтиСтроки(Новый Структура("Имя, Тип", "item", "Э"));
				Для каждого УзелЭлемент Из УзлыЭлементы Цикл
					УзелИмяЭлемента = УзелЭлемент.Строки.Найти("name", "Имя");
					Если УзелИмяЭлемента <> Неопределено И ЗначениеЗаполнено(УзелИмяЭлемента.Значение) Тогда
						УзелЗначениеЭлемента = УзелЭлемент.Строки.Найти("value", "Имя");
						ЗначенияЭлементов.Вставить(УзелИмяЭлемента.Значение, ?(УзелЗначениеЭлемента <> Неопределено, XMLЗначение(Тип("Строка"), УзелЗначениеЭлемента.Значение), Неопределено));
					КонецЕсли;
				КонецЦикла;
				
				ЗначенияУведомлений = Новый Массив;
				УзелГруппа = УзелПротокол.Строки.Найти("group", "Имя");
				ЗаголовокГруппы = "";
				Если УзелГруппа <> Неопределено Тогда
					Для каждого УзелУведомление Из УзелГруппа.Строки Цикл
						СообщениеЭлемента = СокрЛП(XMLЗначение(Тип("Строка"), УзелУведомление.Значение));
						Если УзелУведомление.Тип <> "Э" Тогда
							Если УзелУведомление.Имя = "msg" Тогда
								ЗаголовокГруппы = СообщениеЭлемента;
							КонецЕсли;
							Продолжить;
						КонецЕсли;
						УзелСообщение = УзелУведомление.Строки.Найти("msg", "Имя");
						Если УзелСообщение <> Неопределено И ЗначениеЗаполнено(УзелСообщение.Значение) Тогда
							СообщениеЭлемента = " - " + СокрЛП(XMLЗначение(Тип("Строка"), УзелСообщение.Значение));
						КонецЕсли;
						ЗначенияУведомлений.Добавить(СообщениеЭлемента);
					КонецЦикла;
				КонецЕсли;
				
				КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
				ОтчетСдан = КонтекстЭДОСервер.ПротоколФСГСОтчетСданПоТексту(СтатусПротокола, СообщениеПротокола);
				
				// формируем текст протокола
				Если ОтчетСдан И НРег(СтатусПротокола) = "ok" Тогда
					ТекстПротокола = "ОТЧЕТ ПРИНЯТ УСПЕШНО." + Символы.ПС + Символы.ПС + "Уведомление о при~ме в обработку." + Символы.ПС + Символы.ПС;
				ИначеЕсли ОтчетСдан Тогда
					ТекстПротокола = "ОТЧЕТ ПРИНЯТ УСПЕШНО." + Символы.ПС + Символы.ПС + СообщениеПротокола + Символы.ПС + Символы.ПС;
				Иначе
					ТекстПротокола = СообщениеПротокола + Символы.ПС + Символы.ПС;
				КонецЕсли;
				
				Если ЗначенияЭлементов["dt_load"] <> Неопределено Тогда
					ТекстПротокола = ТекстПротокола + "Дата при~ма отч~та: " + СокрЛП(ЗначенияЭлементов["dt_load"]) + Символы.ПС;
				КонецЕсли;
				Если ЗначенияЭлементов["obj"] <> Неопределено Тогда
					Если СокрЛП(ЗначенияЭлементов["ko"]) = СокрЛП(ЗначенияЭлементов["obj"]) Тогда
						ИдентификаторРеспондента = СокрЛП(ЗначенияЭлементов["obj"]);
					Иначе
						ИдентификаторРеспондента = СокрЛП(Строка(ЗначенияЭлементов["ko"]) + " " + ЗначенияЭлементов["obj"]);
					КонецЕсли;
					ТекстПротокола = ТекстПротокола + "Идентификатор респондента: " + ИдентификаторРеспондента + Символы.ПС;
				КонецЕсли;
				Если ЗначенияЭлементов["file"] <> Неопределено Тогда
					ТекстПротокола = ТекстПротокола + "Имя файла с отч~том: " + СокрЛП(ЗначенияЭлементов["file"]) + Символы.ПС;
				КонецЕсли;
				Если ЗначенияЭлементов["dt_send"] <> Неопределено Тогда
					ТекстПротокола = ТекстПротокола + "Дата передачи файла: " + СокрЛП(ЗначенияЭлементов["dt_send"]) + Символы.ПС;
				КонецЕсли;
				
				ТекстПротокола = ТекстПротокола + Символы.ПС;
				
				Если ЗначенияЭлементов["form_name"] <> Неопределено Тогда
					ТекстПротокола = ТекстПротокола + "Форма отч~та: " + СокрЛП(ЗначенияЭлементов["form_name"]) + Символы.ПС;
				КонецЕсли;
				Если ЗначенияЭлементов["form_code"] <> Неопределено Тогда
					ТекстПротокола = ТекстПротокола + "Код формы отч~та: " + СокрЛП(ЗначенияЭлементов["form_code"]) + Символы.ПС;
				КонецЕсли;
				Если ЗначенияЭлементов["year"] <> Неопределено Тогда
					ТекстПротокола = ТекстПротокола + "Год отч~та: " + СокрЛП(ЗначенияЭлементов["year"]) + Символы.ПС;
				КонецЕсли;
				Если ЗначенияЭлементов["period"] <> Неопределено Тогда
					ТекстПротокола = ТекстПротокола + "Код периода отч~та: " + СокрЛП(ЗначенияЭлементов["period"]) + Символы.ПС;
				КонецЕсли;
				
				// выводим уведомления, для разъяснения причины отказа
				Если ЗначенияУведомлений.Количество() > 0 Тогда
					ТекстПротокола = ТекстПротокола + Символы.ПС + ЗаголовокГруппы + ":" + Символы.ПС;
					Для каждого Уведомление Из ЗначенияУведомлений Цикл
						ТекстПротокола = ТекстПротокола + Уведомление + Символы.ПС;
					КонецЦикла;
				КонецЕсли;
				
				ТекстПротокола = СтрЗаменить(СтрЗаменить(ТекстПротокола, "~", Символ(1105)), "&quot;", """");
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакетОбработки("ФСГСПротокол");
	
	ОбластьМакета = Макет.ПолучитьОбласть("ПротоколШапка");
	ТабДокумент.Вывести(ОбластьМакета); // ПротоколШапка
	
	Для Инд = 1 По СтрЧислоСтрок(ТекстПротокола) Цикл
		ОбластьМакета = Макет.ПолучитьОбласть("ТекстПротокола");
		ОбластьМакета.Параметры.ТекстПротокола = СтрПолучитьСтроку(ТекстПротокола, Инд);
		ТабДокумент.Вывести(ОбластьМакета);
	КонецЦикла;
	
	СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, ТаблицаПодписей);
	
	Возврат ТабДокумент;
	
КонецФункции

// - Формирование печатной формы ПФР подтверждения о получении
&НаСервере
Функция СформироватьТабличныйДокументПФРНаОсновеПодтвержденияОПолучении(Заголовок, ИмяФайла, Тело, ЦиклОбмена)
	
	СвойстваИзПодтверждения = ПолучитьОсновныеСвойстваИзПодтвержденияОПолученииПФР(Тело);
	ДатыСообщений = ПолучитьОсновныеСвойстваПФРИзЦиклаОбмена(ЦиклОбмена);
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	Если ЗначениеЗаполнено(СвойстваИзПодтверждения) Тогда
		
		Макет = ПолучитьМакетОбработки("ПФРКвитанция");
		
		ОбластьМакета = Макет.ПолучитьОбласть("ПодтверждениеШапка");
		ОбластьМакета.Параметры.РегистрационныйНомер = СвойстваИзПодтверждения.ОбщиеСведения.РегистрационныйНомер;
		ОбластьМакета.Параметры.Наименование = ЦиклОбмена.Организация;
		ОбластьМакета.Параметры.ДатаОтправки = ДатыСообщений.ДатаОтправленоСтрахователем;
		ОбластьМакета.Параметры.ДатаПолучения = СвойстваИзПодтверждения.ОбщиеСведения.ДатаПолучения;
		ОбластьМакета.Параметры.ДатаПодтверждения = ДатыСообщений.ДатаПодтверждения;
		ОбластьМакета.Параметры.ОрганПФР = ЦиклОбмена.ВнешняяОрганизация;
		
		ТабДокумент.Вывести(ОбластьМакета); // ПодтверждениеШапка
		
		Для Каждого СтрокаИмяФайла Из СвойстваИзПодтверждения.ИмяФайла Цикл
			
			ОбластьМакета = Макет.ПолучитьОбласть("ПодтверждениеИмяФайла");
			ОбластьМакета.Параметры.ИмяФайла = СтрокаИмяФайла.ИмяФайла;
			ТабДокумент.Вывести(ОбластьМакета); //ПодтверждениеИмяФайла  
			
		КонецЦикла;
		
		ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
		ТабДокумент.Вывести(ОбластьМакета); // ПодтверждениеПодвал
		
		СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, ТаблицаПодписей);
		
		ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		ТабДокумент.АвтоМасштаб = Истина;
		
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

// - Формирование печатной формы ПФР протокол

Функция СформироватьТабличныйДокументПФРНаОсновеПротокола(Заголовок, ИмяФайла, Тело, ЦиклОбмена)
	
	СвойстваИзПротокола = ПолучитьОсновныеСвойстваИзПротоколаПФР(Тело);
	ДатыСообщений = ПолучитьОсновныеСвойстваПФРИзЦиклаОбмена(ЦиклОбмена);
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	Если ЗначениеЗаполнено(СвойстваИзПротокола) Тогда
		
		Макет =ПолучитьМакетОбработки("ПФРПротокол");
		
		ОбластьМакета = Макет.ПолучитьОбласть("ПротоколШапка");
		ОбластьМакета.Параметры.РегистрационныйНомер = СвойстваИзПротокола.ОбщиеСведения.РегистрационныйНомер;
		ОбластьМакета.Параметры.Наименование = ЦиклОбмена.Организация;
		ОбластьМакета.Параметры.ДатаОтправки = ДатыСообщений.ДатаОтправленоСтрахователем;
		ОбластьМакета.Параметры.ДатаПолучения = СвойстваИзПротокола.ОбщиеСведения.ДатаПолучения;
		ОбластьМакета.Параметры.ДатаПодтверждения = ДатыСообщений.ДатаПодтверждения;
		ОбластьМакета.Параметры.ДатаПротокола = ДатыСообщений.ДатаПротокола;
		
		ОбластьМакета.Параметры.ОрганПФР = ЦиклОбмена.ВнешняяОрганизация;
		
		ТабДокумент.Вывести(ОбластьМакета); // ПротоколШапка
		
		ОбластьМакета = Макет.ПолучитьОбласть("ПротоколПачки");
		ТабДокумент.Вывести(ОбластьМакета); // ПротоколПачки
		
		Для Каждого СтрокаИмяФайла Из СвойстваИзПротокола.ИмяФайла Цикл
			
			ОбластьМакета = Макет.ПолучитьОбласть("ПротоколИмяПачек");
			ОбластьМакета.Параметры.ИмяФайла = СтрокаИмяФайла.ИмяФайла;
			ТабДокумент.Вывести(ОбластьМакета); //ПротоколИмяПачек
			
		КонецЦикла;
		
		ОбластьМакета = Макет.ПолучитьОбласть("ПротоколРезультат");
		Если СвойстваИзПротокола.ОбщиеСведения.ЯвляетсяПоложительным Тогда
			РешениеПФР = "ПРИНЯТО К ОБРАБОТКЕ";
		Иначе 
			РешениеПФР = "НЕ ПРИНЯТО К ОБРАБОТКЕ";
		КонецЕсли;
		ОбластьМакета.Параметры.РешениеПФР = РешениеПФР;
		ТабДокумент.Вывести(ОбластьМакета); // ПротоколРезультат
		
		Для Каждого СтрокаИмяФайла Из СвойстваИзПротокола.Вложения Цикл
			
			ОбластьМакета = Макет.ПолучитьОбласть("ПротоколПриложения");
			ОбластьМакета.Параметры.ИмяПриложения = СтрокаИмяФайла.ИмяВложения;
			ТабДокумент.Вывести(ОбластьМакета); //ПротоколПриложения
			
		КонецЦикла;
		
		ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
		ТабДокумент.Вывести(ОбластьМакета); // ПротоколПодвал
		
		СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, ТаблицаПодписей);
		
		ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		ТабДокумент.АвтоМасштаб = Истина;
		
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ДОКУМЕНТООБОРОТ С ФСС

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправки(Форма, ОтправкаСсылка, ВыполняемоеОповещение, ПараметрыОбновленияОтправки = Неопределено) Экспорт
	
	Если ТипЗнч(ОтправкаСсылка) = Тип("СправочникСсылка.ОтправкиФСС") Тогда
		ОбновитьРезультатКонкретнойОтправкиФСС(ОтправкаСсылка, Истина, ВыполняемоеОповещение);
		
	ИначеЕсли ТипЗнч(ОтправкаСсылка) = Тип("СправочникСсылка.ОтправкиФСРАР") Тогда
		ОбновитьРезультатКонкретнойОтправкиФСРАР(Форма, ОтправкаСсылка, ВыполняемоеОповещение, ПараметрыОбновленияОтправки);
		
	ИначеЕсли ТипЗнч(ОтправкаСсылка) = Тип("СправочникСсылка.ОтправкиРПН") Тогда
		ОбновитьРезультатКонкретнойОтправкиРПН(Форма, ОтправкаСсылка, ВыполняемоеОповещение, ПараметрыОбновленияОтправки);
		
	ИначеЕсли ТипЗнч(ОтправкаСсылка) = Тип("СправочникСсылка.ОтправкиФТС") Тогда
		ОбновитьРезультатКонкретнойОтправкиФТС(Форма, ОтправкаСсылка, ВыполняемоеОповещение, ПараметрыОбновленияОтправки);
		
	Иначе
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФСС(ОтправкаСсылка, ТихийРежим, ВыполняемоеОповещение) Экспорт
	
	Если НЕ ТихийРежим Тогда
		Если ДокументооборотСКОВызовСервера.ИспользуетсяРежимТестирования() Тогда
			ДополнительныеПараметры = Новый Структура("ОтправкаСсылка, ВыполняемоеОповещение", ОтправкаССылка, ВыполняемоеОповещение);
			ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьРезультатКонкретнойОтправкиФССЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ПродолжитьОтправкуНаТестовыйСерверФСС(ОписаниеОповещения)
		Иначе
			ОбновитьРезультатКонкретнойОтправкиФССНаКлиенте(ОтправкаСсылка, ВыполняемоеОповещение);
		КонецЕсли;
	Иначе
		ОбновитьРезультатКонкретнойОтправкиФССНаКлиенте(ОтправкаСсылка, ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФССЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ОтправкаСсылка = ДополнительныеПараметры.ОтправкаСсылка;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Если Результат Тогда
		ОбновитьРезультатКонкретнойОтправкиФССНаКлиенте(ОтправкаСсылка, ВыполняемоеОповещение);
	Иначе
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФССНаКлиенте(ОтправкаСсылка, ВыполняемоеОповещение)
	
	ПолученРезультатОтСервераФСС = Ложь;
	ПовторятьСоединение = Истина;
	
	ИнформацияПоОтправке = ИнформацияПоОтправкеФСС(ОтправкаСсылка);
	
	ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦикле(
		ПовторятьСоединение,
		ПолученРезультатОтСервераФСС,
		ОтправкаСсылка,
		ИнформацияПоОтправке,
		ВыполняемоеОповещение);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИнформацияПоОтправкеФСС(ОтправкаСсылка)
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторОтправкиНаСервере", 		Неопределено);
	Результат.Вставить("ОтчетСсылка", 							Неопределено);
	Результат.Вставить("ОрганизацияСсылка", 					Неопределено);
	Результат.Вставить("ВидОтчета", 							Неопределено);
	Результат.Вставить("ТипДокумента", 							Неопределено);
	Результат.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", 	Неопределено);
	
	РеквизитыОтправки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОтправкаСсылка,
		"ОтчетСсылка, ИдентификаторОтправкиНаСервере, Организация, ВидОтчета");
	Результат.ОтчетСсылка 						= РеквизитыОтправки.ОтчетСсылка;
	Результат.ИдентификаторОтправкиНаСервере 	= РеквизитыОтправки.ИдентификаторОтправкиНаСервере;
	Результат.ОрганизацияСсылка 				= РеквизитыОтправки.Организация;
	Результат.ВидОтчета 						= РеквизитыОтправки.ВидОтчета;
	
	Результат.ТипДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыОтправки.ВидОтчета, "ТипДокумента");
	
	ЭтоПодтверждениеВидаДеятельности =
		(Результат.ТипДокумента = Перечисления.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС
		И Результат.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности);
	ЭтоПодписьИШифрованиеSOAP = ЭтоПодтверждениеВидаДеятельности;
	
	Если ЭтоПодписьИШифрованиеSOAP Тогда
		РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(
			Результат.ОрганизацияСсылка);
		Результат.ЭтоЭлектроннаяПодписьВМоделиСервиса = РеквизитыУчетнойЗаписи.ЭлектроннаяПодписьВМоделиСервиса;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Процедура с рекурсивным вызовом заменяет цикл (+ завершение из настройки доступа к интернету)
&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦикле(
		ПовторятьСоединение,
		ПолученРезультатОтСервераФСС,
		ОтправкаСсылка,
		ИнформацияПоОтправке,
		ВыполняемоеОповещение,
		НомерПопытки = 1)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПовторятьСоединение", 			ПовторятьСоединение);
	ДополнительныеПараметры.Вставить("ПолученРезультатОтСервераФСС", 	ПолученРезультатОтСервераФСС);
	ДополнительныеПараметры.Вставить("ОтправкаСсылка", 					ОтправкаСсылка);
	ДополнительныеПараметры.Вставить("ИнформацияПоОтправке", 			ИнформацияПоОтправке);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 			ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("НомерПопытки", 					НомерПопытки);
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦиклеПослеПодписанияИЗашифрования",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	ЭтоПодтверждениеВидаДеятельности = (ИнформацияПоОтправке.ТипДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ИнформацияПоОтправке.ВидОтчета =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
	
	Если ПовторятьСоединение И ЭтоПодтверждениеВидаДеятельности Тогда
		// значение загружено только для подтверждения вида деятельности
		ЭтоЭлектроннаяПодписьВМоделиСервиса = ИнформацияПоОтправке.ЭтоЭлектроннаяПодписьВМоделиСервиса;
		
		ИнформацияДляЗапроса = ИнформацияДляЗапросаОперацииСОКВЭДВФСС(ИнформацияПоОтправке.ИдентификаторОтправкиНаСервере);
		ТекстЗапросаРезультатов = СтрШаблон(
			"<getResultByIdRequest xmlns=""http://ws.fss.ru/services/okvedconfirm"""
			+ " xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"">"
				+ "<systemInfo xmlns="""">"
					+ "<specVersion>1.0</specVersion>"
					+ "<software>%1</software>"
					+ "<softwareVersion>%2</softwareVersion>"
				+ "</systemInfo>"
				+ "<requestId xmlns="""">%3</requestId>"
			+ "</getResultByIdRequest>",
			ИнформацияДляЗапроса.НазваниеПрограммыВHTML,
			ИнформацияДляЗапроса.ВерсияПрограммыВHTML,
			ИнформацияДляЗапроса.ИдентификаторОтправкиВHTML);
		
		ВыгрузкаЗапросаОперации = Новый Структура;
		ВыгрузкаЗапросаОперации.Вставить("Организация", 			ИнформацияПоОтправке.ОрганизацияСсылка);
		ВыгрузкаЗапросаОперации.Вставить("РегистрационныйНомерФСС", Неопределено);
		ВыгрузкаЗапросаОперации.Вставить("ОГРН", 					Неопределено);
		ВыгрузкаЗапросаОперации.Вставить("ТекстЗапроса", 			ТекстЗапросаРезультатов);
		
		НастройкиОперации = Новый Структура;
		НастройкиОперации.Вставить("ПроверкиИАвтонастройкаВыполнены", 		Ложь);
		НастройкиОперации.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", 	ЭтоЭлектроннаяПодписьВМоделиСервиса);
		НастройкиОперации.Вставить("СертификатСтрахователя", 				Неопределено);
		НастройкиОперации.Вставить("СертификатФСС", 						Неопределено);
		
		АдресПодписанногоSOAPОперацииСОКВЭДВФСС(
			ОписаниеОповещения,
			ВыгрузкаЗапросаОперации,
			НастройкиОперации);
		
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦиклеПослеПодписанияИЗашифрования(
		АдресЗашифрованногоЗапросаSOAP,
		ДополнительныеПараметры) Экспорт
	
	ПовторятьСоединение 			= ДополнительныеПараметры.ПовторятьСоединение;
	ПолученРезультатОтСервераФСС 	= ДополнительныеПараметры.ПолученРезультатОтСервераФСС;
	ОтправкаСсылка 					= ДополнительныеПараметры.ОтправкаСсылка;
	ИнформацияПоОтправке 			= ДополнительныеПараметры.ИнформацияПоОтправке;
	ВыполняемоеОповещение 			= ДополнительныеПараметры.ВыполняемоеОповещение;
	НомерПопытки 					= ДополнительныеПараметры.НомерПопытки;
	
	ЭтоПодтверждениеВидаДеятельности = (ИнформацияПоОтправке.ТипДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ИнформацияПоОтправке.ВидОтчета =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
	Если ПовторятьСоединение И ЭтоПодтверждениеВидаДеятельности И АдресЗашифрованногоЗапросаSOAP = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось зашифровать запрос результатов';
															|en = 'Cannot not encrypt query result'"));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;
	
	НастройкиССервера = Неопределено;
	Если ПовторятьСоединение Тогда
		
		//при успешном обращении на сервер ФСС отправка обновится в ИБ
		АдресЗашифрованногоОтветаSOAP = Неопределено;
		ОбновитьРезультатКонкретнойОтправкиФСССНаСервере(
			ОтправкаСсылка,
			ПолученРезультатОтСервераФСС,
			НастройкиССервера,
			АдресЗашифрованногоЗапросаSOAP,
			АдресЗашифрованногоОтветаSOAP);
		
		Если НЕ ПолученРезультатОтСервераФСС И НастройкиССервера <> Неопределено Тогда
			// возможно, проблемы с доступом в интернет
			ДополнительныеПараметры.ПолученРезультатОтСервераФСС = ПолученРезультатОтСервераФСС;
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦиклеЗавершение",
				ЭтотОбъект,
				ДополнительныеПараметры);
			
			Если НастройкиССервера.РазделениеВключено Тогда
				ПовторитьПопытку = (НомерПопытки < 5);
				Если НЕ ПовторитьПопытку Тогда
					ТекстСообщения = СтрШаблон(
						НСтр("ru = 'Не удалось обратиться к серверу ФСС РФ (http://%1). Возможно, сервер перегружен. Попробуйте через некоторое время использовать кнопку ""Обновить"" в отчете %2.';
							|en = 'Cannot contact SSF RF server (http://%1). The server may be overloaded. Try to click Update in the %2 report after some time.'"),
						НастройкиССервера.АдресСервера,
						НастройкиССервера.ПредставлениеОтчетаОшибки);
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				КонецЕсли;
				ВыполнитьОбработкуОповещения(ОписаниеОповещения, ПовторитьПопытку);
				
			Иначе
				ТекстСообщения = СтрШаблон(
					НСтр("ru = 'Не удалось обратиться к серверу ФСС РФ (http://%1)';
						|en = 'Cannot contact SSF RF server (http://%1)'"),
					НастройкиССервера.АдресСервера);
					
				ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(
					ТекстСообщения,
					ОписаниеОповещения);
			КонецЕсли;
			Возврат;
			
		Иначе
			ПовторятьСоединение = Ложь;
			
			Если ЭтоПодтверждениеВидаДеятельности И АдресЗашифрованногоОтветаSOAP <> Неопределено Тогда
				ДополнительныеПараметры.Вставить("АдресЗашифрованногоОтветаSOAP", АдресЗашифрованногоОтветаSOAP);
				
				ОписаниеОповещения = Новый ОписаниеОповещения(
					"ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦиклеПослеРасшифрованияИПроверкиПодписи",
					ЭтотОбъект, ДополнительныеПараметры);
				
				ЭтоОперацияСОКВЭД = Истина;
				ПроверитьПодписьSOAPОтветаЭЛНВФСС(
					ОписаниеОповещения,
					ИнформацияПоОтправке.ОрганизацияСсылка,
					АдресЗашифрованногоОтветаSOAP,,
					ЭтоОперацияСОКВЭД);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦикле(
			ПовторятьСоединение,
			ПолученРезультатОтСервераФСС,
			ОтправкаСсылка,
			ИнформацияПоОтправке,
			ВыполняемоеОповещение);
		
	Иначе
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИнформацияДляЗапросаОперацииСОКВЭДВФСС(ИдентификаторОтправки)
	
	Результат = Новый Структура;
	Результат.Вставить("ВерсияПрограммыВHTML", 			"");
	Результат.Вставить("НазваниеПрограммыВHTML", 		"");
	Результат.Вставить("ИдентификаторОтправкиВHTML", 	"");
	
	КонтекстЭДО = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	
	Результат.ВерсияПрограммыВHTML 			= РегламентированнаяОтчетность.ВерсияПрограммы();
	Результат.ВерсияПрограммыВHTML 			= Лев(Результат.ВерсияПрограммыВHTML, 20);
	Результат.ВерсияПрограммыВHTML 			= КонтекстЭДО.ТекстВHTML(Результат.ВерсияПрограммыВHTML);
	Результат.НазваниеПрограммыВHTML 		= РегламентированнаяОтчетность.НазваниеПрограммы();
	Результат.НазваниеПрограммыВHTML 		= Лев(Результат.НазваниеПрограммыВHTML, 50);
	Результат.НазваниеПрограммыВHTML 		= КонтекстЭДО.ТекстВHTML(Результат.НазваниеПрограммыВHTML);
	Результат.ИдентификаторОтправкиВHTML 	= КонтекстЭДО.ТекстВHTML(ИдентификаторОтправки);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦиклеПослеРасшифрованияИПроверкиПодписи(Результат, ДополнительныеПараметры) Экспорт
	
	ОтправкаСсылка 					= ДополнительныеПараметры.ОтправкаСсылка;
	ИнформацияПоОтправке 			= ДополнительныеПараметры.ИнформацияПоОтправке;
	ВыполняемоеОповещение 			= ДополнительныеПараметры.ВыполняемоеОповещение;
	АдресЗашифрованногоОтветаSOAP 	= ДополнительныеПараметры.АдресЗашифрованногоОтветаSOAP;
	
	Если Результат = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Ошибка при расшифровке протокола ФСС.';
							|en = 'Error occurred while decrypting SSF protocol.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
		УдалитьИзВременногоХранилища(АдресЗашифрованногоОтветаSOAP);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;
	
	Если НЕ Результат.ПодписьВалидна Тогда
		// Записываем сообщение, но продолжаем обмен (данные-то мы получили).
		ТекстОшибки = НСтр("ru = 'Подпись протокола недействительна.';
							|en = 'Protocol signature is invalid.'");
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Подтверждение вида деятельности ФСС';
				|en = 'Electronic data interchange with regulatory authorities. SSF activity category confirmation'"),
			"Ошибка",
			ТекстОшибки,,
			Истина);
	КонецЕсли;
	
	ПараметрыПротокола = Новый Структура;
	ПараметрыПротокола.Вставить("АдресРасшифрованногоОтветаSOAP", 	Результат.АдресРасшифрованногоОтветаSOAP);
	ПараметрыПротокола.Вставить("АдресЗашифрованногоОтветаSOAP", 	АдресЗашифрованногоОтветаSOAP);
	ПараметрыПротокола.Вставить("ИдентификаторОтправкиНаСервере", 	ИнформацияПоОтправке.ИдентификаторОтправкиНаСервере);
	РезультатСохранения = СохранитьПротоколПриОперацииСОКВЭДНаСервере(
		ОтправкаСсылка,
		ИнформацияПоОтправке.ОтчетСсылка,
		ИнформацияПоОтправке.ОрганизацияСсылка,
		ПараметрыПротокола);
	
	Результат = Неопределено;
	Если РезультатСохранения.Рассматривается Тогда
		Результат = Новый Структура("Рассматривается", Истина);
	КонецЕсли;
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦиклеЗавершение(РезультатДиалогаОбОшибкеДоступа, ДополнительныеПараметры) Экспорт
	
	ПолученРезультатОтСервераФСС 	= ДополнительныеПараметры.ПолученРезультатОтСервераФСС;
	ОтправкаСсылка 					= ДополнительныеПараметры.ОтправкаСсылка;
	ИнформацияПоОтправке 			= ДополнительныеПараметры.ИнформацияПоОтправке;
	ВыполняемоеОповещение 			= ДополнительныеПараметры.ВыполняемоеОповещение;
	НомерПопытки 					= ДополнительныеПараметры.НомерПопытки;
	
	ПовторятьСоединение = (РезультатДиалогаОбОшибкеДоступа = Истина);
	
	Если ПовторятьСоединение Тогда
		ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦикле(
			ПовторятьСоединение,
			ПолученРезультатОтСервераФСС,
			ОтправкаСсылка,
			ИнформацияПоОтправке,
			ВыполняемоеОповещение,
			НомерПопытки + 1);
	Иначе
			
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("НетДоступаВИнтернет", Истина);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФСС. Нет доступа в Интернет.
		
	КонецЕсли;
			
КонецПроцедуры
// Процедура с рекурсивным вызовом заменяет цикл (+ завершение из настройки доступа к интернету)

&НаКлиенте
Процедура ОткрытьПротоколОтправкиФСС(Форма) Экспорт
	
	ОтчетСсылка = ДокументооборотСФССКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	
	Если ОтчетСсылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьПротоколОбработкиПоСсылкеИсточникаДляФСС(ОтчетСсылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСертификатыИзНастроекОрганизацииДляФСС(
		ЭтоЭлектроннаяПодписьВМоделиСервиса,
		ОрганизацияСсылка,
		ВыполняемоеОповещение,
		ПолучатьСертификатФССЭЛН = Ложь)
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура,
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ОтпечаткиСертификатов = ПолучитьОтпечаткиСертификатовИзНастроекОрганизацииДляФССНаСервере(ОрганизацияСсылка);
	
	Если ОтпечаткиСертификатов = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		СертификатСтрахователя = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток);
		СертификатФСС = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(?(ПолучатьСертификатФССЭЛН,
			ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток, ОтпечаткиСертификатов.СертификатФССОтпечаток));
		Результат = Новый Структура("СертификатСтрахователя, СертификатФСС", СертификатСтрахователя, СертификатФСС);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 		ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ОтпечаткиСертификатов", 		ОтпечаткиСертификатов);
	ДополнительныеПараметры.Вставить("ПолучатьСертификатФССЭЛН", 	ПолучатьСертификатФССЭЛН);
	Оповещение = Новый ОписаниеОповещения("ПолучитьСертификатыИзНастроекОрганизацииДляФССПослеПоискаСертификатаСтрахователяЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток, "MY", , Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСертификатыИзНастроекОрганизацииДляФССПослеПоискаСертификатаСтрахователяЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 		= ДополнительныеПараметры.ВыполняемоеОповещение;
	ОтпечаткиСертификатов 		= ДополнительныеПараметры.ОтпечаткиСертификатов;
	ПолучатьСертификатФССЭЛН 	= ДополнительныеПараметры.ПолучатьСертификатФССЭЛН;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатСтрахователя = ?(Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, СертификатСтрахователя", ВыполняемоеОповещение, СертификатСтрахователя);
	Оповещение = Новый ОписаниеОповещения("ПолучитьСертификатыИзНастроекОрганизацииДляФССПослеПоискаСертификатаФССЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(
		Оповещение,
		?(ПолучатьСертификатФССЭЛН, ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток, ОтпечаткиСертификатов.СертификатФССОтпечаток),
		"AddressBook",,
		Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСертификатыИзНастроекОрганизацииДляФССПослеПоискаСертификатаФССЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	СертификатСтрахователя = ДополнительныеПараметры.СертификатСтрахователя;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатФСС = ?(Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	Результат = Новый Структура("СертификатСтрахователя, СертификатФСС", СертификатСтрахователя, СертификатФСС);
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СертификатыГодятсяДляПодписанияОтчетностиФСС(Сертификаты)
	
	КонтекстЭДО = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДО.СертификатыГодятсяДляПодписанияОтчетностиФСС(Сертификаты);
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФССПослеПолученияСертификатовЗавершение(ПараметрыФормированияПакета, ДополнительныеПараметры) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура,
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	Форма 								= ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность 		= ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ОтчетСсылка 						= ДополнительныеПараметры.ОтчетСсылка;
	ОрганизацияОтчета 					= ДополнительныеПараметры.ОрганизацияОтчета;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	Идентификатор 						= ДополнительныеПараметры.Идентификатор;
	ТекстФайлаВыгрузки 					= ДополнительныеПараметры.ТекстФайлаВыгрузки;
	ИмяФайлаВыгрузки 					= ДополнительныеПараметры.ИмяФайлаВыгрузки;
	РасширениеСТочкой 					= ДополнительныеПараметры.РасширениеСТочкой;
	ТипОтправляемогоДокумента 			= ДополнительныеПараметры.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента 			= ДополнительныеПараметры.ВидОтправляемогоДокумента;
	
	Если ПараметрыФормированияПакета = Неопределено Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСС.
		Возврат;
	КонецЕсли;
	
	СертификатСтрахователя = ПараметрыФормированияПакета.СертификатСтрахователя;
	СертификатФСС = ПараметрыФормированияПакета.СертификатФСС;
	
	//проверяем сертификаты
	СертификатыОбмена = Новый СписокЗначений();
	СертификатыОбмена.Добавить(СертификатСтрахователя, "Сертификат страхователя");
	СертификатыОбмена.Добавить(СертификатФСС, "Сертификат ФСС");
	
	Если НЕ СертификатыГодятсяДляПодписанияОтчетностиФСС(СертификатыОбмена) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Сертификаты не подходят для подписания.';
				|en = 'Certificates are not suitable for signing.'"));
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСС.
		Возврат;
	КонецЕсли;
	
	Если СертификатСтрахователя = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось определить сертификат.';
				|en = 'Cannot determine a certificate.'"));
		Возврат;
	КонецЕсли;
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		СертификатСтрахователя.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 				ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки", 					ТекстФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки", 					ИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("РасширениеСТочкой", 					РасширениеСТочкой);
	ДополнительныеПараметры.Вставить("ТипОтправляемогоДокумента", 			ТипОтправляемогоДокумента);
	ДополнительныеПараметры.Вставить("ВидОтправляемогоДокумента", 			ВидОтправляемогоДокумента);
	ДополнительныеПараметры.Вставить("СертификатСтрахователя", 				СертификатСтрахователя);
	ДополнительныеПараметры.Вставить("СертификатФСС", 						СертификатФСС);
	ДополнительныеПараметры.Вставить("ОрганизацияОтчета", 					ОрганизацияОтчета);
	ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	ДополнительныеПараметры.Вставить("АдресДанныхВыгрузки", 				Неопределено);
	
	ЭтоПодтверждениеВидаДеятельности = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
	ЭтоПодписьИШифрованиеSOAP = ЭтоПодтверждениеВидаДеятельности;
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса ИЛИ ЭтоПодписьИШифрованиеSOAP Тогда
		ДополнительныеПараметры.Вставить("ВременныйКаталог", "");
		ДополнительныеПараметры.Вставить("ПолноеИмяФайлаВыгрузки", ИмяФайлаВыгрузки);
		
		Если НЕ ЭтоПодписьИШифрованиеSOAP Тогда
			Адрес = ЗагрузитьДанныеНаСервер(ТекстФайлаВыгрузки, Форма.УникальныйИдентификатор,, Истина);
			ДополнительныеПараметры.Вставить("АдресДанныхВыгрузки", Адрес);
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФССПослеЗаписиФайлаЗавершение",
			ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение, Новый Структура("Выполнено", Истина));
		Возврат;
	КонецЕсли;
	
	//Получим имя временного файла
	Оповещение = Новый ОписаниеОповещения(
		"ВыгрузитьПакетДляОтправкиВФССПослеПолученияВременногоКаталогаЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	ОперацииСФайламиЭДКОКлиент.КаталогВременныхФайловНаКлиенте(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФССПослеПолученияВременногоКаталогаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ТекстФайлаВыгрузки = ДополнительныеПараметры.ТекстФайлаВыгрузки;
	ИмяФайлаВыгрузки = ДополнительныеПараметры.ИмяФайлаВыгрузки;
	РасширениеСТочкой = ДополнительныеПараметры.РасширениеСТочкой;
	СертификатСтрахователя = ДополнительныеПараметры.СертификатСтрахователя;
	СертификатФСС = ДополнительныеПараметры.СертификатФСС;
	
	Если НЕ Результат.Выполнено Тогда
		Возврат;
	КонецЕсли;
	
	ВременныйКаталог = Результат.ИмяКаталога;
	
	ПолноеИмяФайлаВыгрузки = ВременныйКаталог + ИмяФайлаВыгрузки;
	
	ДополнительныеПараметры.Вставить("ВременныйКаталог", ВременныйКаталог);
	ДополнительныеПараметры.Вставить("ПолноеИмяФайлаВыгрузки", ПолноеИмяФайлаВыгрузки);
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФССПослеЗаписиФайлаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОперацииСФайламиЭДКОКлиент.ТекстВФайл(Оповещение, ТекстФайлаВыгрузки, ПолноеИмяФайлаВыгрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФССПослеЗаписиФайлаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	ТекстФайлаВыгрузки 					= ДополнительныеПараметры.ТекстФайлаВыгрузки;
	ВременныйКаталог 					= ДополнительныеПараметры.ВременныйКаталог;
	ПолноеИмяФайлаВыгрузки 				= ДополнительныеПараметры.ПолноеИмяФайлаВыгрузки;
	РасширениеСТочкой 					= ДополнительныеПараметры.РасширениеСТочкой;
	ТипОтправляемогоДокумента 			= ДополнительныеПараметры.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента 			= ДополнительныеПараметры.ВидОтправляемогоДокумента;
	СертификатСтрахователя 				= ДополнительныеПараметры.СертификатСтрахователя;
	СертификатФСС 						= ДополнительныеПараметры.СертификатФСС;
	ОрганизацияОтчета 					= ДополнительныеПараметры.ОрганизацияОтчета;
	АдресДанныхВыгрузки 				= ДополнительныеПараметры.АдресДанныхВыгрузки;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	
	Если НЕ Результат.Выполнено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоПодтверждениеВидаДеятельности = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
	
	// подписываем и шифруем
	ДлительнаяОтправкаКлиент.ВывестиСостояние(НСтр("ru = 'Подписание и шифрование файла выгрузки ...';
													|en = 'Signing and encrypting an export file ...'")); // ФСС
	КороткоеИмяЗашифрованногоПакета = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(
		ПолноеИмяФайлаВыгрузки).ИмяБезРасширения
		+ ?(ЭтоПодтверждениеВидаДеятельности И нрег(РасширениеСТочкой) = ".xml",
		"_" + Строка(Новый УникальныйИдентификатор), "") + РасширениеСТочкой;
	ЗашифрованныйПакет = ВременныйКаталог + КороткоеИмяЗашифрованногоПакета;
	
	СертификатыЗашифрования = Новый Массив;
	СертификатыЗашифрования.Добавить(СертификатФСС);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 				ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ТипОтправляемогоДокумента", 			ТипОтправляемогоДокумента);
	ДополнительныеПараметры.Вставить("ВидОтправляемогоДокумента", 			ВидОтправляемогоДокумента);
	ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	ДополнительныеПараметры.Вставить("ЗашифрованныйПакет", 					ЗашифрованныйПакет);
	ДополнительныеПараметры.Вставить("СертификатыЗашифрования", 			СертификатыЗашифрования);
	ДополнительныеПараметры.Вставить("ФайлПодписи", 						"");
	
	Если ЭтоПодтверждениеВидаДеятельности Тогда
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФССПослеПодписанияИЗашифрованияЗавершение",
			ЭтотОбъект, ДополнительныеПараметры);
		
		ВыгрузкаЗапросаОперации = Новый Структура;
		ВыгрузкаЗапросаОперации.Вставить("Организация", 			ОрганизацияОтчета);
		ВыгрузкаЗапросаОперации.Вставить("РегистрационныйНомерФСС", Неопределено);
		ВыгрузкаЗапросаОперации.Вставить("ОГРН", 					Неопределено);
		ВыгрузкаЗапросаОперации.Вставить("ТекстЗапроса", 			ТекстФайлаВыгрузки);
		
		НастройкиОперации = Новый Структура;
		НастройкиОперации.Вставить("ПроверкиИАвтонастройкаВыполнены", 		Истина);
		НастройкиОперации.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", 	ЭтоЭлектроннаяПодписьВМоделиСервиса);
		НастройкиОперации.Вставить("СертификатСтрахователя", 				СертификатСтрахователя);
		НастройкиОперации.Вставить("СертификатФСС", 						СертификатФСС);
		
		АдресПодписанногоSOAPОперацииСОКВЭДВФСС(
			Оповещение,
			ВыгрузкаЗапросаОперации,
			НастройкиОперации);
		
	Иначе
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФССПослеПодписанияЗавершение",
			ЭтотОбъект, ДополнительныеПараметры);
		КриптографияЭДКОКлиент.ПодписатьPKCS7(
			Оповещение,
			СертификатСтрахователя,
			?(ЭтоЭлектроннаяПодписьВМоделиСервиса, АдресДанныхВыгрузки, ПолноеИмяФайлаВыгрузки),
			Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФССПослеПодписанияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ЗашифрованныйПакет 		= ДополнительныеПараметры.ЗашифрованныйПакет;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	СертификатыЗашифрования = ДополнительныеПараметры.СертификатыЗашифрования;
	
	Если НЕ Результат.Выполнено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось подписать файл выгрузки!';
															|en = 'Cannot sign the export file.'"));
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСС.
		Возврат;
	КонецЕсли;
	
	ФайлПодписи = Результат.ФайлПодписи;
	
	ДополнительныеПараметры.Вставить("ФайлПодписи", ФайлПодписи);
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФССПослеПодписанияИЗашифрованияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.ЗашифроватьPKCS7(
		Оповещение,
		ФайлПодписи,
		СертификатыЗашифрования,
		?(ЭтоЭлектроннаяПодписьВМоделиСервиса, Неопределено, ЗашифрованныйПакет),,,,
		"*");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФССПослеПодписанияИЗашифрованияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	ТипОтправляемогоДокумента 			= ДополнительныеПараметры.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента 			= ДополнительныеПараметры.ВидОтправляемогоДокумента;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ЗашифрованныйПакет 					= ДополнительныеПараметры.ЗашифрованныйПакет;
	ФайлПодписи 						= ДополнительныеПараметры.ФайлПодписи;
	
	Если ЗначениеЗаполнено(ФайлПодписи) Тогда
		Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
			УдалитьИзВременногоХранилища(ФайлПодписи);
		Иначе
			ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ФайлПодписи);
		КонецЕсли;
	КонецЕсли;
	
	ЭтоПодтверждениеВидаДеятельности = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
	ЭтоПодписьИШифрованиеSOAP = ЭтоПодтверждениеВидаДеятельности;
	
	ОперацияВыполнена = ?(ЭтоПодписьИШифрованиеSOAP, ЗначениеЗаполнено(Результат), Результат.Выполнено);
	Если НЕ ОперацияВыполнена Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось зашифровать файл выгрузки!';
															|en = 'Cannot encrypt an export file.'"));
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСС.
		Возврат;
	КонецЕсли;
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса ИЛИ ЭтоПодписьИШифрованиеSOAP Тогда
		ЗашифрованныйПакет = Новый Структура("ИмяФайлаВыгрузки, ИмяФайлаЗашифрованногоПакета",
			ЗашифрованныйПакет, ?(ЭтоПодписьИШифрованиеSOAP, Результат, Результат.ЗашифрованныйФайл));
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, ЗашифрованныйПакет);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КодПодчиненности(ХранилищеДанныхОтчета)
	
	Код = "";
	ДанныеОтчета = ХранилищеДанныхОтчета.Получить();
	Если ДанныеОтчета.ПоказателиОтчета.Свойство("ПолеТабличногоДокументаТитульный") Тогда
		ТитульныйЛист = ДанныеОтчета.ПоказателиОтчета.ПолеТабличногоДокументаТитульный;
	Иначе
		ТитульныйЛист = ДанныеОтчета.ПоказателиОтчета.ПолеТабличногоДокументаПриложение1;
	КонецЕсли;
	Если ТитульныйЛист.Свойство("КодПодчиненности") Тогда
		Код = ТитульныйЛист.КодПодчиненности;
	ИначеЕсли ТитульныйЛист.Свойство("КодПодчиненности_1") Тогда
		Код = ТитульныйЛист.КодПодчиненности_1
			+ ТитульныйЛист.КодПодчиненности_2
			+ ТитульныйЛист.КодПодчиненности_3
			+ ТитульныйЛист.КодПодчиненности_4
			+ ТитульныйЛист.КодПодчиненности_5;
	КонецЕсли;
	
	Возврат Код;
	
КонецФункции

&НаСервереБезКонтекста
Функция КодРегионаВФорме(ХранилищеДанныхОтчета)
	
	Код = Неопределено;
	ДанныеОтчета = ХранилищеДанныхОтчета.ДанныеОтчета.Получить();
	ТитульныйЛист = ДанныеОтчета.ПоказателиОтчета.ПолеТабличногоДокументаТитульный;
	Если ТитульныйЛист.Свойство("КодРегионаВФорме") Тогда
		Код = ТитульныйЛист.КодРегионаВФорме;
	КонецЕсли;
	
	Возврат Код;
	
КонецФункции

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт

	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС(
		ВходящийКонтекст.Форма,
		ВходящийКонтекст.ЭтоОтправкаИзФормыОтчетность,
		ВходящийКонтекст.ОтчетСсылка,
		ВходящийКонтекст.ОрганизацияОтчета);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС(
		Форма,
		Знач ЭтоОтправкаИзФормыОтчетность = Ложь,
		Знач ОтчетСсылка = Неопределено,
		Знач ОрганизацияОтчета = Неопределено) Экспорт
		
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОрганизацияОтчета 	= ДокументооборотСФССКлиентСервер.ПолучитьОрганизациюПоФорме(Форма);
		ОтчетСсылка 		= ДокументооборотСФССКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
	РеквизитыУчетнойЗаписи              = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияОтчета);
	ЭтоЭлектроннаяПодписьВМоделиСервиса = РеквизитыУчетнойЗаписи.ЭлектроннаяПодписьВМоделиСервиса;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Форма", 								Форма);
	ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность", 		ЭтоОтправкаИзФормыОтчетность);
	ДополнительныеПараметры.Вставить("ОтчетСсылка", 						ОтчетСсылка);
	ДополнительныеПараметры.Вставить("ОрганизацияОтчета", 					ОрганизацияОтчета);
	ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);

	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	
	ЭтоРегламентированныйОтчет 	= (ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет") 
		ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено"));
	ЭтоРеестрСведений 			= ДокументооборотСФССКлиентСервер.ЭтоРеестрСведенийНаВыплатуПособийФСС(ОтчетСсылка);
	ЭтоЭлектронноеПредставление = (ТипЗнчСсылкаНаОтчет = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов"));
	
	Если ЭтоРегламентированныйОтчет Тогда
		
		// отправляем только из записанной формы
		Если НЕ ЭтоОтправкаИзФормыОтчетность И Форма.Модифицированность Тогда
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеСохраненияРегОтчета",
				ЭтотОбъект,
				ДополнительныеПараметры);
				
			Форма.СохранитьНаКлиенте(, ОписаниеОповещения);

		Иначе

			ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПолучениеСвойствРегОтчета(ДополнительныеПараметры);
			
		КонецЕсли;
		
	ИначеЕсли ЭтоРеестрСведений Тогда
		
		Если НЕ ЗначениеЗаполнено(ОтчетСсылка) Тогда
			ПоказатьПредупреждение(, "Перед отправкой реестр сведений требуется записать.");
			Возврат;
		КонецЕсли;
		
		КодОрганаФСС = Лев(ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьКодПодчиненностиРеестраСведенийНаВыплатуПособийФСС(ОтчетСсылка), 4);
		ДатыПериода = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьДатыПериодаДокумента(ОтчетСсылка);
		
		ПоляДляЗаписиОтправки = Новый Структура();
		ПоляДляЗаписиОтправки.Вставить("КодОрганаФСС",         КодОрганаФСС);
		ПоляДляЗаписиОтправки.Вставить("ДатаНачалаПериода",    ДатыПериода.ДатаНачала);
		ПоляДляЗаписиОтправки.Вставить("ДатаОкончанияПериода", ДатыПериода.ДатаОкончания);
		ПоляДляЗаписиОтправки.Вставить("Версия",               0);
		
		ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки", ПоляДляЗаписиОтправки);
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПроверкиПодключения(ДополнительныеПараметры);
		
	ИначеЕсли ЭтоЭлектронноеПредставление Тогда
		
		Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
			Если Форма.Модифицированность Тогда
				ПоказатьПредупреждение(, НСтр("ru = 'Необходимо записать отчет перед отправкой.';
												|en = 'Write the report before sending.'"));
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если ОтчетСсылка = Неопределено 
			ИЛИ ОтчетСсылка = ПредопределенноеЗначение("Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.ПустаяСсылка") Тогда
			Возврат;
		КонецЕсли;
		
		ПоляДляЗаписиОтправки = ПоляНаСервереДляЗаписиОтправкиВФССНаСервере(ОтчетСсылка);
		
		ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки", ПоляДляЗаписиОтправки);
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПроверкиПодключения(ДополнительныеПараметры);
		
	Иначе
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось определить тип документа.';
				|en = 'Cannot determine a document type.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПроверкиПодключения(ДополнительныеПараметры) Экспорт
	
	Форма                               = ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность        = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	ОрганизацияОтчета                   = ДополнительныеПараметры.ОрганизацияОтчета;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;	
	ПоляДляЗаписиОтправки 				= ДополнительныеПараметры.ПоляДляЗаписиОтправки;	
	
	ОрганизацияИспользуетОбменСФСС                    = Ложь;
	ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи = Ложь;
	НастроенОбменВУниверсальномФормате                = Ложь;	
	
	ПолучитьСвойстваОрганизацииДляФССНаСервере(
		ОрганизацияОтчета,
		НастроенОбменВУниверсальномФормате,
		ОрганизацияИспользуетОбменСФСС,
		ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи);
	
	Если НЕ ОрганизацияИспользуетОбменСФСС Тогда
		Если НЕ НастроенОбменВУниверсальномФормате Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(ОтчетСсылка, ОписаниеОповещения);
			
		Иначе
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ОтчетСсылка);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НастроенОбменВУниверсальномФормате И ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеАвтонастройки", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
		
		ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(ОтчетСсылка,ОписаниеОповещения);
		
	Иначе
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеАвтонастройки(Истина, ДополнительныеПараметры);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеАвтонастройки(Результат, ДополнительныеПараметры) Экспорт
	
	Если ДокументооборотСКОВызовСервера.ИспользуетсяРежимТестирования() Тогда

		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеВопросаОТестовомРежиме",
			ЭтотОбъект,
			ДополнительныеПараметры);
			
		ПродолжитьОтправкуНаТестовыйСерверФСС(ОписаниеОповещения);
		
	Иначе
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеСохраненияИПроверок(ДополнительныеПараметры);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеВопросаОТестовомРежиме(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат Тогда
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеСохраненияИПроверок(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеСохраненияРегОтчета(Результат, ДополнительныеПараметры) Экспорт
	
	Форма 		= ДополнительныеПараметры.Форма;
	ОтчетСсылка = ДополнительныеПараметры.ОтчетСсылка;
	
	// если отчет не был записан ранее, то получим ссылку на записанный отчет
	Если ОтчетСсылка = Неопределено Тогда
		
		ОтчетСсылка = ДокументооборотСФССКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
		ДополнительныеПараметры.ОтчетСсылка = ОтчетСсылка;
		
	КонецЕсли;
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПолучениеСвойствРегОтчета(ДополнительныеПараметры);

КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПолучениеСвойствРегОтчета(ДополнительныеПараметры)
	
	Форма                               = ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность        = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	
	Если ОтчетСсылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоОтправкаИзФормыОтчетность Тогда
		
		ЗначенияРеквизитов = ЗначенияРеквизитовОбъекта(ОтчетСсылка, "ДатаНачала, ДатаОкончания, Вид, ДанныеОтчета");
		
		КодПодчиненности = КодПодчиненности(ЗначенияРеквизитов.ДанныеОтчета);
		
		ПоляДляЗаписиОтправки = Новый Структура("КодОрганаФСС, ДатаНачалаПериода, ДатаОкончанияПериода, Версия",
			Лев(КодПодчиненности, 4),
			НачалоДня(ЗначенияРеквизитов.ДатаНачала),
			КонецДня(ЗначенияРеквизитов.ДатаОкончания),
			ЗначенияРеквизитов.Вид);
		
	Иначе

		СтруктураРеквизитовФормы = Форма.СтруктураРеквизитовФормы;
		
		Если РегламентированнаяОтчетностьКлиентСервер.СвойствоОпределено(СтруктураРеквизитовФормы, "мВариант") Тогда
			Версия = СтруктураРеквизитовФормы.мВариант;
		Иначе
			Версия = 0;
		КонецЕсли;
		
		Если РегламентированнаяОтчетностьКлиентСервер.СвойствоОпределено(Форма, "СтруктураДанныхТитульный") Тогда
			ДанныеТитульный = Форма.СтруктураДанныхТитульный;
		Иначе
			ДанныеТитульный = Форма.СтруктураДанныхПриложение1;
		КонецЕсли;
		
		Если РегламентированнаяОтчетностьКлиентСервер.СвойствоОпределено(ДанныеТитульный, "КодПодчиненности") Тогда
			КодОрганаФСС = Лев(ДанныеТитульный.КодПодчиненности, 4);
		ИначеЕсли РегламентированнаяОтчетностьКлиентСервер.СвойствоОпределено(ДанныеТитульный, "КодПодчиненности_1") 
				И РегламентированнаяОтчетностьКлиентСервер.СвойствоОпределено(ДанныеТитульный, "КодПодчиненности_2") 
				И РегламентированнаяОтчетностьКлиентСервер.СвойствоОпределено(ДанныеТитульный, "КодПодчиненности_3") 
				И РегламентированнаяОтчетностьКлиентСервер.СвойствоОпределено(ДанныеТитульный, "КодПодчиненности_4") Тогда
			
			КодОрганаФСС = ДанныеТитульный.КодПодчиненности_1  
				+ ДанныеТитульный.КодПодчиненности_2  
				+ ДанныеТитульный.КодПодчиненности_3  
				+ ДанныеТитульный.КодПодчиненности_4; 
		Иначе
			ПоказатьПредупреждение(, "Не удалось определить код органа ФСС при отправке!");
			Возврат;
		КонецЕсли;
		
		ПоляДляЗаписиОтправки = Новый Структура("КодОрганаФСС, ДатаНачалаПериода, ДатаОкончанияПериода, Версия",
			КодОрганаФСС,
			СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета,
			СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета,
			Версия);
		
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки", ПоляДляЗаписиОтправки);

	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПроверкиПодключения(ДополнительныеПараметры);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеСохраненияИПроверок(ДополнительныеПараметры)
	
	ОтчетСсылка = ДополнительныеПараметры.ОтчетСсылка;

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеНастройкиЗаявления", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	ЗавершитьНастройкуЗаявленияНаИзменение(ОтчетСсылка, ОписаниеОповещения);

КонецПроцедуры
	
&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеНастройкиЗаявления(Результат, ВходящийКонтекст) Экспорт	
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);

	ПроверитьСертификатИЛицензию(
		ОписаниеОповещения, 
		ВходящийКонтекст.ОтчетСсылка, 
		ВходящийКонтекст.ОрганизацияОтчета, 
		"ФСС");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		Возврат;
	КонецЕсли;	
	
	Форма 		= ВходящийКонтекст.Форма;
	ОтчетСсылка = ВходящийКонтекст.ОтчетСсылка;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПодтверждения", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	// при отправке из списка подтверждение запрашивается перед запуском отправки для предотвращения попадания сообщений в диалог подтверждения
	Если Форма = Неопределено ИЛИ Форма.ИмяФормы <> "ОбщаяФорма.РегламентированнаяОтчетность" Тогда

		// запрашиваем подтверждение
		ПараметрыФормы = Новый Структура("СсылкаНаОтчет, ИдентификаторОсновнойФормы", ОтчетСсылка);
	
		ОткрытьФорму(
			ПутьКОбъекту + ".Форма.ПодтверждениеОтправкиОтчета",
			ПараметрыФормы,
			,
			,
			,
			,
			ОписаниеОповещения,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.ОК);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПодтверждения(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПодтвержденияЗавершение", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	ОтчетСсылка = ДополнительныеПараметры.ОтчетСсылка;
	
	ПодтвердитьПовторнуюОтправку(ОтчетСсылка, "ФСС", ОписаниеОповещения);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПодтвержденияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть аналогичная процедура ОтправкаРегламентированногоОтчетаВФССПослеПодтвержденияЗавершение(),
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Форма 								= ДополнительныеПараметры.Форма;
	ОтчетСсылка 						= ДополнительныеПараметры.ОтчетСсылка;
	ЭтоОтправкаИзФормыОтчетность 		= ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОтчетСсылка = ДокументооборотСФССКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
	ИнформацияОбОтправляемомДокументе = ПолучитьТипВидаОтправляемогоДокументаПоСсылкеНаОбъектОтправкиДляФСС(
		ОтчетСсылка,
		Истина);
	ТипОтправляемогоДокумента = ИнформацияОбОтправляемомДокументе.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента = ИнформацияОбОтправляемомДокументе.ВидОтправляемогоДокумента;
	
	ДополнительныеПараметры.Вставить("ТипОтправляемогоДокумента", 	ТипОтправляемогоДокумента);
	ДополнительныеПараметры.Вставить("ВидОтправляемогоДокумента", 	ВидОтправляемогоДокумента);
	
	ЭтоПодтверждениеВидаДеятельности = ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности");
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПодтвержденияПриложений",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	Если ЭтоПодтверждениеВидаДеятельности
		И ТипЗнч(ОтчетСсылка) <> Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов") Тогда
		
		ТекстВопроса = НСтр("ru = 'Прием приложения 3 в электронном виде не поддерживается ФСС.
								  |Будут отправлены приложения 1 и 2.
								  |
								  |Продолжить?';
								  |en = 'Receiving application 3 electronically is not supported by SSF.
								  |Applications 1 and 2 will be sent.
								  |
								  | Continue?'");
		ПоказатьВопрос(
			ОписаниеОповещения,
			ТекстВопроса,
			РежимДиалогаВопрос.ДаНет,,
			КодВозвратаДиалога.Да);
		
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПодтвержденияПриложений(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Форма 								= ДополнительныеПараметры.Форма;
	ОтчетСсылка 						= ДополнительныеПараметры.ОтчетСсылка;
	ЭтоОтправкаИзФормыОтчетность 		= ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ОрганизацияОтчета 					= ДополнительныеПараметры.ОрганизацияОтчета;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ТипОтправляемогоДокумента 			= ДополнительныеПараметры.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента 			= ДополнительныеПараметры.ВидОтправляемогоДокумента;
	
	ДлительнаяОтправкаКлиент.ЗапретитьВыводСостояния();
	
	РезультатВыгрузки = ВыгрузитьОтчетДляОтправкиВФСС(
		ОтчетСсылка,
		Форма,
		ЭтоОтправкаИзФормыОтчетность,
		ТипОтправляемогоДокумента,
		ВидОтправляемогоДокумента);
	
	ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();
	
	Если РезультатВыгрузки = Неопределено Тогда
		
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось выгрузить отчет.';
				|en = 'Cannot export the report.'"));
		Возврат;
		
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки", 	РезультатВыгрузки.ТекстФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("РасширениеСТочкой", 	РезультатВыгрузки.РасширениеСТочкой);
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки", 	РезультатВыгрузки.ИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ТипЗнчСсылкаНаОтчет", ТипЗнч(ОтчетСсылка));
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеИнициализации", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
	
	КонтекстДлительнойОперации = Новый Структура;
	КонтекстДлительнойОперации.Вставить("ОписаниеОповещения", 	ОписаниеОповещения);
	КонтекстДлительнойОперации.Вставить("ОрганизацияОтчета", 	ОрганизацияОтчета);
	КонтекстДлительнойОперации.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= ОтчетСсылка;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 3;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;

	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка отчета в ФСС
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПодтвержденияЗавершение",  0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Функция ВыгрузитьОтчетДляОтправкиВФСС(
		ОтчетСсылка,
		Форма,
		ЭтоОтправкаИзФормыОтчетность,
		ТипОтправляемогоДокумента,
		ВидОтправляемогоДокумента)
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура,
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ТекстФайлаВыгрузки	= "";
	ИмяФайлаВыгрузки	= "";
	
	ЭтоПодтверждениеВидаДеятельности = ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности");
	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	
	ЭтоРегламентированныйОтчет = (ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет") ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено"));
	ЭтоРеестрСведений = ДокументооборотСФССКлиентСервер.ЭтоРеестрСведенийНаВыплатуПособийФСС(ОтчетСсылка);
	ЭтоЭлектронноеПредставление = (ТипЗнчСсылкаНаОтчет = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов"));
	
	Если ЭтоРегламентированныйОтчет  Тогда
		Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
			ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента", , Форма);
		Иначе
			ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента");
		КонецЕсли;

		Если НЕ ФормаВыгрузкиРеглОтчета.ВыгрузитьОтчет(ОтчетСсылка, Ложь, , ТекстФайлаВыгрузки, ИмяФайлаВыгрузки) Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				НСтр("ru = 'Не удалось выгрузить отчет.';
					|en = 'Cannot export the report.'"));
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли ЭтоЭлектронноеПредставление Тогда
		
		ИзвлечьЭлектронноеПредставлениеИзХранилищаИПерекодироватьНаСервере(
			ОтчетСсылка,
			ТекстФайлаВыгрузки,
			ИмяФайлаВыгрузки,,
			?(ЭтоПодтверждениеВидаДеятельности, "utf-8", Неопределено));
		
	ИначеЕсли ЭтоРеестрСведений Тогда
		
		ПолучитьСвойстваФайлаВыгрузкиНаСервере(ОтчетСсылка, ТекстФайлаВыгрузки, ИмяФайлаВыгрузки);
		
	Иначе
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось определить тип документа.';
				|en = 'Cannot determine a document type.'"));
		Возврат Неопределено;
		
	КонецЕсли;
	
	РасширениеФайла = ПолучитьРасширениеФайлаФССПоТипуОтправляемогоДокумента(
		ТипОтправляемогоДокумента,
		ВидОтправляемогоДокумента);
	
	Если ЭтоПодтверждениеВидаДеятельности Тогда
		ПозицияПрефикса = СтрНайти(ТекстФайлаВыгрузки, "<OKVEDConfirmationRequest ");
		Если ПозицияПрефикса > 0 Тогда
			ТекстФайлаВыгрузки = Сред(ТекстФайлаВыгрузки, ПозицияПрефикса);
			ТекстПостфикса = "</OKVEDConfirmationRequest>";
			ПозицияПостфикса = СтрНайти(ТекстФайлаВыгрузки, ТекстПостфикса);
			Если ПозицияПостфикса > 0 Тогда
				ДлинаПостфикса = СтрДлина(ТекстПостфикса);
				ТекстФайлаВыгрузки = Лев(ТекстФайлаВыгрузки, ПозицияПостфикса + ДлинаПостфикса - 1);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	РасширениеСТочкой = "";
	Если РасширениеФайла = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось определить тип документа.';
				|en = 'Cannot determine a document type.'"));
		Возврат Неопределено;
	Иначе
		РасширениеСТочкой = "." + РасширениеФайла;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекстФайлаВыгрузки) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось сформировать файл выгрузки.';
				|en = 'Cannot generate an export file.'"));
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИмяФайлаВыгрузки) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не определено имя файла выгрузки.';
				|en = 'Export file name is not determined.'"));
		Возврат Неопределено;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки", 	ТекстФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки", 	ИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("РасширениеСТочкой", 	РасширениеСТочкой);
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

&НаКлиенте
Функция ВыгрузитьОтчетДляОтправкиВРПН(ОтчетСсылка, Форма, ЭтоОтправкаИзФормыОтчетность) Экспорт

	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОтчетСсылка = ДокументооборотСРПНКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
	ТекстФайлаВыгрузки 	= "";
	ИмяФайлаВыгрузки 	= ""; 
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	Кодировка 			= "utf-8"; // кодировка, в которую нужно сконвертировать текст выгрузки перед подписью
	
	Если ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет")
		ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено") Тогда
		
		Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
			ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента", , Форма);
		Иначе
			ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента");
		КонецЕсли;
		
		Если НЕ ФормаВыгрузкиРеглОтчета.ВыгрузитьОтчет(ОтчетСсылка, Ложь, Ложь, ТекстФайлаВыгрузки, ИмяФайлаВыгрузки) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.УведомлениеОСпецрежимахНалогообложения") Тогда
		МассивВыгруженныхУведомлений = Неопределено;
		Если НЕ ВыгрузитьУведомлениеФНС(ОтчетСсылка, МассивВыгруженныхУведомлений) Тогда
			Возврат Неопределено;
		КонецЕсли;
		ТекстФайлаВыгрузки = ПрочитатьТекстИзФайла(МассивВыгруженныхУведомлений[0].АдресФайлаВыгрузки, "utf-8");
		ИмяФайлаВыгрузки = МассивВыгруженныхУведомлений[0].ИмяФайлаВыгрузки;
		
	Иначе // электронное представление
		Если ОтчетСсылка = ПредопределенноеЗначение("Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.ПустаяСсылка") Тогда
			Возврат Неопределено;
		КонецЕсли;
		ИзвлечьЭлектронноеПредставлениеИзХранилищаИПерекодироватьНаСервере(
			ОтчетСсылка,
			ТекстФайлаВыгрузки,
			ИмяФайлаВыгрузки,,
			"utf-8");
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки", 	ТекстФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки", 	ИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("Кодировка", 			Кодировка);
	
	Возврат ДополнительныеПараметры;

КонецФункции

&НаКлиенте
Функция ВыгрузитьОтчетДляОтправкиВФСРАР(
	ОтчетСсылка,
	Форма,
	ЭтоОтправкаИзФормыОтчетность,
	АдресГотовыхДанных = Неопределено,
	ИмяФайлаГотовыхДанных = Неопределено) Экспорт
	
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОтчетСсылка = ДокументооборотСФССКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
