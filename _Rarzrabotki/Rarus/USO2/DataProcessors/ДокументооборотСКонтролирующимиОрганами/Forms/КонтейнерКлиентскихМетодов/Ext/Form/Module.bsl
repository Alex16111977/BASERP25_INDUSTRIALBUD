&НаСервере
Функция ПолучитьАдресВложения(СообщениеВладелецФайла, ИмяФайлаДокумента)
	
	Результат = Новый Структура;
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Вложения = КонтекстЭДОСервер.ПолучитьВложенияТранспортногоСообщения(СообщениеВладелецФайла, Истина, , ИмяФайлаДокумента);
	
	Если Вложения.Количество() = 0 Тогда
		Результат.Вставить("Предупреждение", "Документ не найден в информационной базе.");
		Возврат Результат;
	КонецЕсли;
	
	ГУИД = Новый УникальныйИдентификатор;
	Адрес = ПоместитьВоВременноеХранилище(Вложения[0].Данные.Получить(), ГУИД);
	Результат.Вставить("Адрес", Адрес);
	Возврат Результат;

КонецФункции

