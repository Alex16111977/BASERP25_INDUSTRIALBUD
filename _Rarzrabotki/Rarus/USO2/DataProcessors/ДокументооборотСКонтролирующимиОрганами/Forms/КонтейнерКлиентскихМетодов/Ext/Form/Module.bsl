КонецПроцедуры


&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляБанкаРоссии(Результат, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	Если ДополнительныеПараметры.Свойство("ОтчетСсылка") Тогда
		ОтчетаСсылка = ДополнительныеПараметры.ОтчетСсылка;
	Иначе
		ОтчетСсылка = ДополнительныеПараметры.СсылкаНаОтчет;
	КонецЕсли;
	ОрганизацияОтчета = ДополнительныеПараметры.ОрганизацияОтчета;
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетаСсылка);
	
	ЭтоРегламентированныйОтчет = (ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет") ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено"));
	
	Если ЭтоРегламентированныйОтчет Тогда
		
		Если ЭтоОтправкаИзФормыОтчетность Тогда
			ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляБанкРоссииРегламентированныйОтчет(ОрганизацияОтчета, ОтчетСсылка, Форма, ЭтоОтправкаИзФормыОтчетность, ЭтоРегламентированныйОтчет);
		Иначе
			// отправляем только из записанной формы
			Если Форма.Модифицированность Тогда
				ДополнительныеПараметры = Новый Структура("ОрганизацияОтчета, ОтчетСсылка, Форма, ЭтоОтправкаИзФормыОтчетность, ЭтоРегламентированныйОтчет", ОрганизацияОтчета, ОтчетСсылка, Форма, ЭтоОтправкаИзФормыОтчетность, ЭтоРегламентированныйОтчет);
				ОписаниеОповещения = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляБанкаРоссии", ЭтотОбъект, ДополнительныеПараметры);
				Форма.СохранитьНаКлиенте(, ОписаниеОповещения);
			Иначе
				ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляБанкРоссииРегламентированныйОтчет(ОрганизацияОтчета, ОтчетСсылка, Форма, ЭтоОтправкаИзФормыОтчетность, ЭтоРегламентированныйОтчет);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляБанкРоссииРегламентированныйОтчет(ОрганизацияОтчета, ОтчетСсылка, Форма, ЭтоОтправкаИзФормыОтчетность, ЭтоРегламентированныйОтчет)
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("РегламентированнаяОтчетность.ЭлектронныйДокументооборотСКонтролирующимиОрганами.СдачаОтчетностиВБанкРоссии") Тогда
	МодульДокументооборотСБанкомРоссииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСБанкомРоссииКлиент");
	Если ЭтоОтправкаИзФормыОтчетность Тогда
		МодульДокументооборотСБанкомРоссииКлиент.ОтправитьОтчет(ОрганизацияОтчета, ОтчетСсылка, Форма);
	Иначе
		МодульДокументооборотСБанкомРоссииКлиент.ОтправитьОтчет(
			Форма.СтруктураРеквизитовФормы.Организация,
			Форма.СтруктураРеквизитовФормы.мСохраненныйДок, Форма);
	КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОбновитьРезультатНезавершенныхПоследнихОтправокРПНПоОрганизации(Форма, Отправки, НомерОбъекта, ЭтоВызовИзСписка, ВыполняемоеОповещение)
	
	Если НомерОбъекта + 1 > Отправки.Количество() Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	Иначе
		Отправка = Отправки[НомерОбъекта];
		
		ДлительнаяОтправкаКлиент.ОповеститьОСменеЭтапаОбмена(
			"ОсуществитьОбменПоОрганизацииРПН", 
			ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.РПН"), 
			Отправка);
			
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Форма", 					Форма);
		ДополнительныеПараметры.Вставить("Отправки", 				Отправки);
		ДополнительныеПараметры.Вставить("НомерОбъекта", 			НомерОбъекта);
		ДополнительныеПараметры.Вставить("ЭтоВызовИзСписка", 		ЭтоВызовИзСписка);
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьРезультатНезавершенныхПоследнихОтправокРПНПоОрганизацииЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		Если ЗначениеЗаполнено(Отправка) Тогда
			ОбновитьРезультатКонкретнойОтправкиРПН(Форма, Отправка, ОписаниеОповещения,, ЭтоВызовИзСписка);
		Иначе
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

