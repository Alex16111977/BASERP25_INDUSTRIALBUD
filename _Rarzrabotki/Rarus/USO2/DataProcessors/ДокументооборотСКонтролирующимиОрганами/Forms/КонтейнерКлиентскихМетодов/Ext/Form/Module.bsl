&НаКлиенте
Процедура ВыгрузитьЦиклыОбмена(ВыгружаемыеЦиклыОбмена, ВыгружатьКонтейнеры = Истина, ВыгружатьСодержимое = Ложь, Путь = Неопределено, ДополнятьПуть = Истина) Экспорт
	
	Если ТипЗнч(ВыгружаемыеЦиклыОбмена) <> Тип("Массив") Тогда
		ЦиклыОбмена = Новый Массив;
		ЦиклыОбмена.Добавить(ВыгружаемыеЦиклыОбмена);
	Иначе
		ЦиклыОбмена = ВыгружаемыеЦиклыОбмена;
	КонецЕсли;
	
	// заданы ли циклы обмена
	Если НЕ ЗначениеЗаполнено(ЦиклыОбмена) Тогда
		ПоказатьПредупреждение(, "Не выбраны циклы обмена для выгрузки!");
		Возврат;
	КонецЕсли;
			
	ВАрхиве = 0;
	ОбщееКоличествоФайлов = ПолучитьОбщееКоличествоВыгружаемыхФайлов(ЦиклыОбмена, ВыгружатьКонтейнеры, ВыгружатьСодержимое, ВАрхиве);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ЦиклыОбмена", 					ЦиклыОбмена);
	ДополнительныеПараметры.Вставить("ОбщееКоличествоФайлов", 			ОбщееКоличествоФайлов);
	ДополнительныеПараметры.Вставить("Путь", 							Путь);
	ДополнительныеПараметры.Вставить("ВыгружатьКонтейнеры", 			ВыгружатьКонтейнеры);
	ДополнительныеПараметры.Вставить("ВыгружатьСодержимое", 			ВыгружатьСодержимое);
	ДополнительныеПараметры.Вставить("ДополнятьПуть", 					ДополнятьПуть);
	
	Если ОбщееКоличествоФайлов = 0 Тогда
		ПоказатьПредупреждение(, "Нет информации для выгрузки!");
		Возврат;
	КонецЕсли;
	Если ВАрхиве >= ОбщееКоличествоФайлов Тогда
		ПоказатьПредупреждение(, "Все файлы были перемещены в архив. Выгрузка не возможна!");
		Возврат;
	ИначеЕсли ВАрхиве > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьЦиклыОбменаЗавершениеВыбора", ЭтотОбъект, ДополнительныеПараметры);		
		ПоказатьВопрос(ОписаниеОповещения, "Файлы частично были перемещены в архив. Продолжить выгрузку без них?", РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
		
	ВыгрузитьЦиклыОбменаПродолжение(ДополнительныеПараметры);
			
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЦиклыОбменаЗавершениеВыбора(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ВыгрузитьЦиклыОбменаПродолжение(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЦиклыОбменаПродолжение(ДополнительныеПараметры)
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ВыгрузитьЦиклыОбменаЗавершение", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	ТекстСообщения = ОперацииСФайламиЭДКОКлиент.ТекстСообщенияДляНеобязательнойУстановкиРасширенияРаботыСФайлами();
	ОбщегоНазначенияКлиент.ПоказатьВопросОбУстановкеРасширенияРаботыСФайлами(ОписаниеОповещения, ТекстСообщения, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЦиклыОбменаЗавершение(ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами, ДополнительныеПараметры) Экспорт
	
	Если ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами Тогда
		ВыгрузитьЦиклыОбменаСРасширениемРаботыСФайлами(ДополнительныеПараметры);
	Иначе
		ВыгрузитьЦиклыОбменаБезРасширенияРаботыСФайлами(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВыгружаемыеФайлы(ЦиклыОбмена, ВыгружатьКонтейнеры, ВыгружатьСодержимое)
	
	Запрос = Новый Запрос;
	Запросы = Новый Массив;
	
	// В запросе отсуствует ПометкаУдаления = Ложь так как в истории отправки
	// отображаются помеченные на уделение этапы. Для них выгрузка 
	// тоже должна работать.
	Если ВыгружатьСодержимое Тогда
		Запросы.Добавить("ВЫБРАТЬ //$Разрешенные
						|	СодержимоеТранспортныхКонтейнеров.ИмяФайла,
						|	СодержимоеТранспортныхКонтейнеров.Данные,
						|	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение,
						|	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение.Тип,
						|	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение.ЦиклОбмена,
						|	""Содержимое"" КАК ИДСодержимое
						|ИЗ
						|	РегистрСведений.СодержимоеТранспортныхКонтейнеров КАК СодержимоеТранспортныхКонтейнеров
						|
						|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
						|			ПО 		(СостояниеОбъектов.Объект = СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение)
						|				И	(СостояниеОбъектов.ИмяФайла = СодержимоеТранспортныхКонтейнеров.ИмяФайла)
						|				И	(СостояниеОбъектов.Владелец = Значение(Перечисление.ВидыАрхивируемыхМетаданныхДО.СодержимоеТранспортныхКонтейнеров))
						|
						|ГДЕ
						|	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение.ЦиклОбмена В(&ЦиклОбмена)
						|	И (СостояниеОбъектов.Архивный ЕСТЬ NULL Или СостояниеОбъектов.Архивный <> Истина)
						|	И СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение.Статус В (&Статусы)");
	КонецЕсли;
	
	Если ВыгружатьКонтейнеры Тогда
		Запросы.Добавить("ВЫБРАТЬ //$Разрешенные
						|	ТранспортныеКонтейнеры.ИмяФайла,
						|	ТранспортныеКонтейнеры.Данные,
						|	ТранспортныеКонтейнеры.ТранспортноеСообщение,
						|	ТранспортныеКонтейнеры.ТранспортноеСообщение.Тип,
						|	ТранспортныеКонтейнеры.ТранспортноеСообщение.ЦиклОбмена,
						|	""Контейнер"" КАК ИДКонтейнеры
						|ИЗ
						|	РегистрСведений.ТранспортныеКонтейнеры КАК ТранспортныеКонтейнеры
						|
						|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
						|			ПО 		(СостояниеОбъектов.Объект = ТранспортныеКонтейнеры.ТранспортноеСообщение)
						|				И	(СостояниеОбъектов.ИмяФайла = ТранспортныеКонтейнеры.ИмяФайла)
						|				И	(СостояниеОбъектов.Владелец = Значение(Перечисление.ВидыАрхивируемыхМетаданныхДО.ТранспортныеКонтейнеры))
						|
						|ГДЕ
						|	ТранспортныеКонтейнеры.ТранспортноеСообщение.ЦиклОбмена В(&ЦиклОбмена)
						|	И (СостояниеОбъектов.Архивный ЕСТЬ NULL Или СостояниеОбъектов.Архивный <> Истина)
						|	И ТранспортныеКонтейнеры.ТранспортноеСообщение.Статус В (&Статусы)");
	КонецЕсли;
	
	СтрОбъединитьВсе = "
						|
						|ОБЪЕДИНИТЬ ВСЕ
						|
						|";
	
	Для Инд = 1 По Запросы.Количество() Цикл
		ТекстЗапрос = СтрЗаменить(Запросы[Инд - 1], "//$Разрешенные", ?(Инд = 1, "РАЗРЕШЕННЫЕ", ""));
		Запрос.Текст = Запрос.Текст + ?(Инд = 1, "", СтрОбъединитьВсе) + ТекстЗапрос;
	КонецЦикла;
	
	Статусы = Новый Массив;
	Статусы.Добавить(Перечисления.СтатусыПисем.Отправленное);
	Статусы.Добавить(Перечисления.СтатусыПисем.Полученное);
	Запрос.УстановитьПараметр("Статусы", Статусы);
	Запрос.УстановитьПараметр("ЦиклОбмена", ЦиклыОбмена);
	Выборка = Запрос.Выполнить().Выгрузить();
	
	ТранспортныеСообщенияСПрисоединеннымиФайлами = Новый Массив;
	Для каждого ЭлементВыборки Из Выборка Цикл
		Если ТранспортныеСообщенияСПрисоединеннымиФайлами.Найти(ЭлементВыборки.ТранспортноеСообщение) = Неопределено
			И ЭлементВыборки.Данные.Получить() = Неопределено Тогда
			
			ТранспортныеСообщенияСПрисоединеннымиФайлами.Добавить(ЭлементВыборки.ТранспортноеСообщение);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаФайлов = Неопределено;
	Если ТранспортныеСообщенияСПрисоединеннымиФайлами.Количество() > 0 Тогда
		ИменаСправочников = ?(ВыгружатьСодержимое, "ТранспортноеСообщениеПрисоединенныеФайлы", "")
			+ ?(ВыгружатьСодержимое И ВыгружатьКонтейнеры, ", ", "")
			+ ?(ВыгружатьКонтейнеры, "ТранспортноеСообщениеКонтейнерыПрисоединенныеФайлы", "");
		ТаблицаФайлов = ОбщегоНазначенияЭДКО.ПрикрепленныеФайлыКОбъектуИзСправочника(
			ТранспортныеСообщенияСПрисоединеннымиФайлами,
			ИменаСправочников,
			,
			"ВладелецФайла, ИсходноеИмяФайла");
		
		Для каждого СтрокаТаблицы Из ТаблицаФайлов Цикл
			СтрокаТаблицы.ИсходноеИмяФайла = ВРЕГ(СтрокаТаблицы.ИсходноеИмяФайла);
		КонецЦикла;
	КонецЕсли;
	
	МассивВыборки = Новый Массив;
	Для Каждого ЭлементВыборки Из Выборка Цикл 
		ЭлементМассива = Новый Структура;
		
		ДанныеТранспортногоКонтейнера = ЭлементВыборки.Данные.Получить();
		Если ДанныеТранспортногоКонтейнера = Неопределено Тогда
			ИсходноеИмяФайла = ВРЕГ(ЭлементВыборки.ИмяФайла);
			
			ПараметрыОтбора = Новый Структура("ВладелецФайла, ИсходноеИмяФайла",
				ЭлементВыборки.ТранспортноеСообщение, ИсходноеИмяФайла);
			СтрокиТаблицы = ТаблицаФайлов.НайтиСтроки(ПараметрыОтбора);
			Если СтрокиТаблицы.Количество() > 0 Тогда
				ДанныеТранспортногоКонтейнера = РаботаСФайлами.ДвоичныеДанныеФайла(СтрокиТаблицы[0].Ссылка);
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ДанныеТранспортногоКонтейнера) Тогда
			// В "битом" регистре могут попадаться пустые данные. Такие данные не нужны.
			Продолжить;
		КонецЕсли;
		
		Для Каждого КолонкаВыборки Из Выборка.Колонки Цикл 
			
			ИмяКолонки = КолонкаВыборки.Имя;
			Если ИмяКолонки = "Данные" Тогда
				ЭлементМассива.Вставить("Адрес", ПоместитьВоВременноеХранилище(ДанныеТранспортногоКонтейнера, Новый УникальныйИдентификатор));
			Иначе
				ЗначениеЭлемента = ЭлементВыборки[ИмяКолонки];
				ЭлементМассива.Вставить(ИмяКолонки, ЗначениеЭлемента);
			КонецЕсли;
			
		КонецЦикла;
		МассивВыборки.Добавить(ЭлементМассива);
	КонецЦикла;
	
	Возврат МассивВыборки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОбщееКоличествоВыгружаемыхФайлов(ЦиклыОбмена, ВыгружатьКонтейнеры, ВыгружатьСодержимое, ИзНихВАрхиве = 0)
	
	Запрос = Новый Запрос;
	Запросы = Новый Массив;
	
	// В запросе отсуствует ПометкаУдаления = Ложь, 
	// так как в истории отправки показываем помеченные на удаление
	// этапы, для них выгрузка тоже долджна работать.
	Если ВыгружатьСодержимое Тогда
		Запросы.Добавить("ВЫБРАТЬ //$Разрешенные
						|	Количество(ИСТИНА)
						|	, ЕстьNULL(Сумма(
						|	ВЫБОР
						|		КОГДА СостояниеОбъектов.Архивный ЕСТЬ NULL ТОГДА 0
						|		КОГДА СостояниеОбъектов.Архивный = Ложь ТОГДА 0
						|	ИНАЧЕ
						|		1
						|	КОНЕЦ
						|	), 0) ВАрхиве
						|ИЗ
						|	РегистрСведений.СодержимоеТранспортныхКонтейнеров КАК СодержимоеТранспортныхКонтейнеров
						|
						|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
						|			ПО 		(СостояниеОбъектов.Объект = СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение)
						|				И	(СостояниеОбъектов.ИмяФайла = СодержимоеТранспортныхКонтейнеров.ИмяФайла)
						|				И	(СостояниеОбъектов.Владелец = Значение(Перечисление.ВидыАрхивируемыхМетаданныхДО.СодержимоеТранспортныхКонтейнеров))
						|
						|ГДЕ
						|	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение.ЦиклОбмена В(&ЦиклОбмена)
						|	И СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение.Статус В (&Статусы)");
	КонецЕсли;
	
	Если ВыгружатьКонтейнеры Тогда
		Запросы.Добавить("ВЫБРАТЬ //$Разрешенные
						|	Количество(ИСТИНА)
						|	, ЕстьNULL(Сумма(
						|	ВЫБОР
						|		КОГДА СостояниеОбъектов.Архивный ЕСТЬ NULL ТОГДА 0
						|		КОГДА СостояниеОбъектов.Архивный = Ложь ТОГДА 0
						|	ИНАЧЕ
						|		1
						|	КОНЕЦ
						|	), 0) ВАрхиве
						|ИЗ
						|	РегистрСведений.ТранспортныеКонтейнеры КАК ТранспортныеКонтейнеры
						|
						|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
						|			ПО 		(СостояниеОбъектов.Объект = ТранспортныеКонтейнеры.ТранспортноеСообщение)
						|				И	(СостояниеОбъектов.ИмяФайла = ТранспортныеКонтейнеры.ИмяФайла)
						|				И	(СостояниеОбъектов.Владелец = Значение(Перечисление.ВидыАрхивируемыхМетаданныхДО.ТранспортныеКонтейнеры))
						|
						|ГДЕ
						|	ТранспортныеКонтейнеры.ТранспортноеСообщение.ЦиклОбмена В(&ЦиклОбмена)
						|	И ТранспортныеКонтейнеры.ТранспортноеСообщение.Статус В (&Статусы)");
	КонецЕсли;
	
	СтрОбъединитьВсе = "
						|
						|ОБЪЕДИНИТЬ ВСЕ
						|
						|";
	
	Для Инд = 1 По Запросы.Количество() Цикл
		ТекстЗапрос = СтрЗаменить(Запросы[Инд - 1], "//$Разрешенные", ?(Инд = 1, "РАЗРЕШЕННЫЕ", ""));
		Запрос.Текст = Запрос.Текст + ?(Инд = 1, "", СтрОбъединитьВсе) + ТекстЗапрос;
	КонецЦикла;
	
	Статусы = Новый Массив;
	Статусы.Добавить(Перечисления.СтатусыПисем.Отправленное);
	Статусы.Добавить(Перечисления.СтатусыПисем.Полученное);
	Запрос.УстановитьПараметр("Статусы", Статусы);
	Запрос.УстановитьПараметр("ЦиклОбмена", ЦиклыОбмена);
	Запрос.УстановитьПараметр("ПометкаУдаления", Ложь);
	
	ИзНихВАрхиве = 0;
	Результат = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Результат + ?(ЗначениеЗаполнено(Выборка.Получить(0)), Выборка.Получить(0), 0);
		ИзНихВАрхиве = ИзНихВАрхиве + ?(ЗначениеЗаполнено(Выборка.ВАрхиве), Выборка.ВАрхиве, 0);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПредставленияЦикловОбмена(ЦиклыОбмена)
	
	ПредставленияЦикловОбмена = Новый Соответствие;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
						  |	ЦиклыОбмена.Ссылка,
						  |	ЦиклыОбмена.Организация,
						  |	ЦиклыОбмена.ВнешняяОрганизация,
						  |	ЦиклыОбмена.ДатаСоздания,
						  |	ЦиклыОбмена.Тип,
						  |	ЦиклыОбмена.ВидОтчета,
						  |	ЦиклыОбмена.ДатаНачалаПериода,
						  |	ЦиклыОбмена.ДатаОкончанияПериода,
						  |	ЦиклыОбмена.ВидДокумента,
						  |	ЦиклыОбмена.ВидУслуги,
						  |	ЦиклыОбмена.ФорматОтвета,
						  |	ЦиклыОбмена.Предмет
						  |ИЗ
						  |	Справочник.ЦиклыОбмена КАК ЦиклыОбмена
						  |ГДЕ
						  |	ЦиклыОбмена.Ссылка В(&Ссылка)");
	Запрос.УстановитьПараметр("Ссылка", ЦиклыОбмена);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ПредставленияЦикловОбмена.Вставить(Выборка.Ссылка, ПредставлениеЦиклаОбмена(Выборка));
		
	КонецЦикла;
	
	Возврат ПредставленияЦикловОбмена;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеЦиклаОбмена(ЦиклОбмена) Экспорт
	
	Если ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.НалоговаяИлиБухгалтерскаяОтчетность Тогда
		ПредставлениеЦиклаОбмена = "" + ЦиклОбмена.ВидОтчета + " за " + ПредставлениеПериода(ЦиклОбмена.ДатаНачалаПериода, КонецДня(ЦиклОбмена.ДатаОкончанияПериода), "ФП=Истина") + " (" + РегламентированнаяОтчетность.ПредставлениеВидаДокумента(ЦиклОбмена.ВидДокумента) + ") от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Заявление Тогда
		ПредставлениеЦиклаОбмена = "" + ЦиклОбмена.ВидОтчета + " за " + ПредставлениеПериода(ЦиклОбмена.ДатаНачалаПериода, КонецДня(ЦиклОбмена.ДатаОкончанияПериода), "ФП=Истина") + " от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Документ Тогда
		ПредставлениеЦиклаОбмена = "Опись вход. документов от НО " + ЦиклОбмена.ВнешняяОрганизация + " от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Форма2НДФЛ Тогда
		ПредставлениеЦиклаОбмена = "2-НДФЛ за " + ПредставлениеПериода(ЦиклОбмена.ДатаНачалаПериода, КонецДня(ЦиклОбмена.ДатаОкончанияПериода), "ФП=Истина") + " от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.НеформализованныеДокументыНалогоплательщика Тогда
		ПредставлениеЦиклаОбмена = "Исх. док. для НО " + ЦиклОбмена.ВнешняяОрганизация + " от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.НеформализованныеДокументыНалоговогоОргана Тогда
		ПредставлениеЦиклаОбмена = "Вход. док. от НО " + ЦиклОбмена.ВнешняяОрганизация + " от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.ПисьмоНО Тогда
		ПредставлениеЦиклаОбмена = "Вход. письмо от НО " + ЦиклОбмена.ВнешняяОрганизация + " от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Рассылка Тогда
		ПредставлениеЦиклаОбмена = "Вход. рассылка от НО " + ЦиклОбмена.ВнешняяОрганизация + " от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.РассылкаГрупповая Тогда
		ПредставлениеЦиклаОбмена = "Вход. групповая рассылка от НО " + ЦиклОбмена.ВнешняяОрганизация + " от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.ЗапросыНаИнформационноеОбслуживание Тогда
		ПредставлениеЦиклаОбмена = "Запрос """ + ЦиклОбмена.ВидУслуги + """ (" + ЦиклОбмена.ФорматОтвета + ") от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.ОтчетностьПФР Тогда
		
		Если ТипЗнч(ЦиклОбмена.ВидОтчета) = Тип("СправочникСсылка.РегламентированныеОтчеты") Тогда
			Источник = ЦиклОбмена.ВидОтчета.ИсточникОтчета;
		Иначе
			Источник = ЦиклОбмена.ВидОтчета.Источник;
		КонецЕсли;
		
		Если НачалоДня(ЦиклОбмена.ДатаНачалаПериода) = НачалоДня(ЦиклОбмена.ДатаОкончанияПериода) Тогда
			ПредставлениеЦиклаОбмена = "" + ЦиклОбмена.Предмет + ". Отправка от " + ЦиклОбмена.ДатаСоздания;
		ИначеЕсли Источник = "ПередачаСЗВ4вПФР" Тогда
			ПредставлениеЦиклаОбмена = "" + ЦиклОбмена.ВидОтчета + " и РСВ за " + ПредставлениеПериода(ЦиклОбмена.ДатаНачалаПериода, КонецДня(ЦиклОбмена.ДатаОкончанияПериода), "ФП=Истина") + " от " + ЦиклОбмена.ДатаСоздания;
		Иначе
			ПредставлениеЦиклаОбмена = "" + ЦиклОбмена.ВидОтчета + " за " + ПредставлениеПериода(ЦиклОбмена.ДатаНачалаПериода, КонецДня(ЦиклОбмена.ДатаОкончанияПериода), "ФП=Истина") + " от " + ЦиклОбмена.ДатаСоздания;
		КонецЕсли;
		
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.НеформализованнаяПерепискаПФРИсходящие Тогда
		ПредставлениеЦиклаОбмена = "Письмо для органа ПФР " + ЦиклОбмена.ВнешняяОрганизация + " от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.РассылкаПФР Тогда
		ПредставлениеЦиклаОбмена = "Рассылка органа ПФР " + ЦиклОбмена.ВнешняяОрганизация + " от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.НеформализованнаяПерепискаПФРВходящие Тогда
		ПредставлениеЦиклаОбмена = "Письмо от органа ПФР " + ЦиклОбмена.ВнешняяОрганизация + " от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.ИОС Тогда
		ПредставлениеЦиклаОбмена = "Запрос """ + ЦиклОбмена.ВидУслуги + """ от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.ИОН Тогда
		ПредставлениеЦиклаОбмена = "Запрос """ + ЦиклОбмена.ВидУслуги + """ (" + ЦиклОбмена.ФорматОтвета + ") от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.ОтчетностьФСГС Тогда
		Если НачалоДня(ЦиклОбмена.ДатаНачалаПериода) = НачалоДня(ЦиклОбмена.ДатаОкончанияПериода) Тогда
			ПредставлениеЦиклаОбмена = "" + ЦиклОбмена.Предмет + ". Отправка от " + ЦиклОбмена.ДатаСоздания;
		Иначе
			ПредставлениеЦиклаОбмена = "" + ЦиклОбмена.ВидОтчета + " за " + ПредставлениеПериода(ЦиклОбмена.ДатаНачалаПериода, КонецДня(ЦиклОбмена.ДатаОкончанияПериода), "ФП=Истина") + " от " + ЦиклОбмена.ДатаСоздания;
		КонецЕсли;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.ПисьменноеОбращениеВФСГС Тогда
		ПредставлениеЦиклаОбмена = "Письмо для Росстата " + ЦиклОбмена.ВнешняяОрганизация + " от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.ИндивидуальноеИнформированиеФСГС Тогда
		ПредставлениеЦиклаОбмена = "Письмо от Росстата " + ЦиклОбмена.ВнешняяОрганизация + " от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.РассылкаФСГС Тогда
		ПредставлениеЦиклаОбмена = "Рассылка от Росстата " + ЦиклОбмена.ВнешняяОрганизация + " от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.РассылкаШаблоновФСГС Тогда
		ПредставлениеЦиклаОбмена = "Рассылка шаблонов от Росстата " + ЦиклОбмена.ВнешняяОрганизация + " от " + ЦиклОбмена.ДатаСоздания;
	Иначе
		ПредставлениеЦиклаОбмена = ЦиклОбмена.Ссылка;
	КонецЕсли;
	
	Возврат ПредставлениеЦиклаОбмена;
	
КонецФункции

//
// ФУНКЦИИ ВЫГРУЗКИ АРХИВА ДОКУМЕНТООБОРОТА
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура СформироватьТаблицуОтветовНаЗапросИОН(Запрос)
	
	ТаблицаОтветовНаЗапросИОН = ПолучитьОтветыНаЗапросИОН(Запрос, Истина);
	ТаблицаОтветовНаЗапросИОН.Колонки.Добавить("Адрес");
	Для Каждого СтрокаОтвета Из ТаблицаОтветовНаЗапросИОН Цикл
		Если ЗначениеЗаполнено(СтрокаОтвета.Данные) Тогда 
			ГУИД = Новый УникальныйИдентификатор;
			СтрокаОтвета.Адрес = ПоместитьВоВременноеХранилище(СтрокаОтвета.Данные.Получить(), ГУИД);
		КонецЕсли;
	КонецЦикла;
	
	ОтветыНаЗапросыИОН.Загрузить(ТаблицаОтветовНаЗапросИОН);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтветНаЗапросИОН(Запрос) Экспорт
	
	// получаем все документы к показу
	СформироватьТаблицуОтветовНаЗапросИОН(Запрос);
	
	// определяем документ, который показываем
	КоличествоОтветов = ОтветыНаЗапросыИОН.Количество();
	Если КоличествоОтветов = 0 Тогда
		Возврат;
	ИначеЕсли КоличествоОтветов > 1 Тогда
		СписокВыбора = Новый СписокЗначений;
		Для Каждого СтрокаОтвета Из ОтветыНаЗапросыИОН Цикл 
			СписокВыбора.Добавить(СтрокаОтвета.ИмяФайла);
		КонецЦикла;
		СписокВыбора.ЗаполнитьПометки(Истина);
		ДополнительныеПараметры = Новый Структура("Запрос", Запрос);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПоказатьОтветНаЗапросИОНЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		СписокВыбора.ПоказатьОтметкуЭлементов(ОписаниеОповещения);
	Иначе
		ПоказатьОтветНаЗапросИОННаКлиенте(Запрос);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтветНаЗапросИОНЗавершение(СписокВыбора, ДополнительныеПараметры) Экспорт
	
	Запрос = ДополнительныеПараметры.Запрос;
	
	Если СписокВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// удаляем не помеченные строки из таблицы ответов
	Для Каждого СтрСписокВыбора Из СписокВыбора Цикл
		Если НЕ СтрСписокВыбора.Пометка Тогда
			СтрОтветНаЗапросИОН = ОтветыНаЗапросыИОН.НайтиСтроки(Новый Структура("ИмяФайла", СтрСписокВыбора.Значение));
			ОтветыНаЗапросыИОН.Удалить(СтрОтветНаЗапросИОН[0]);
		КонецЕсли;
	КонецЦикла;
	
	ПоказатьОтветНаЗапросИОННаКлиенте(Запрос);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтветНаЗапросИОННаКлиенте(Запрос)
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ОтметитьКакПрочтенное(Запрос);
	
	ОтветНаЗапросИОН = ОтветыНаЗапросыИОН[0];
	
	Если ОтветНаЗапросИОН.ВАрхиве Тогда
		
		ПоказатьУведомлениеАрхивныхФайлов(, 17, 3);

		Возврат;
	КонецЕсли;
	
	Если ОтветНаЗапросИОН.ТипСодержимого = СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоФайлов_xml
		И ТребуетсяОсобыйСпособОтображения(ОтветНаЗапросИОН.ИмяФайла, ОтветНаЗапросИОН.ТипСодержимого) Тогда
		
		ПоказатьКакТабличныйДокумент(Запрос, ОтветНаЗапросИОН.ИмяФайла, ОтветНаЗапросИОН.Адрес);
		
	ИначеЕсли ОтветНаЗапросИОН.ТипСодержимого = СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоФайлов_xml И НЕ ЭтоВебКлиент() Тогда
		ПоказатьHTML(ОтветНаЗапросИОН.ИмяФайла, ОтветНаЗапросИОН.Адрес, Ложь, Истина);
	Иначе
		ОперацииСФайламиЭДКОКлиент.ОткрытьФайл(ОтветНаЗапросИОН.Адрес, ОтветНаЗапросИОН.ИмяФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьФайлЗапросаИОН(Запрос, ДвоичныеДанныеФайлаЗапроса, ИмяФайлаЗапроса, УникальныйИдентификатор = Неопределено)
	
	// собираем параметры письма
	ПараметрыПисьма = СформироватьПараметрыЗапроса(Запрос);
	Если НЕ ПроверитьЗаполнениеЗапроса535(Запрос, ПараметрыПисьма) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось сформировать запрос на информационное обслуживание!';
															|en = 'Cannot generate a request for information support.'"));
		Возврат Ложь;
	КонецЕсли;
	
	// формируем идентификатор отправителя
	Если ПараметрыПисьма.ПрПодп = 2 Тогда
		СвПред = ПараметрыПисьма.Доверенность.СвУпПред.СвПред;
		Если СвПред.Свойство("СвОрг") Тогда
			ИННКПП = СокрЛП(СвПред.СвОрг.ИННЮЛ) + СокрЛП(СвПред.СвОрг.КПП);
		Иначе
			Если НЕ ПараметрыПисьма.Доверенность.СвУпПред.СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизации Тогда
				ИННКПП = СокрЛП(СвПред.СведФизЛ.ИННФЛ);
			Иначе
				ИННКПП = ?(ПараметрыПисьма.ЭтоПБОЮЛ, СокрЛП(ПараметрыПисьма.ИННФЛ), СокрЛП(ПараметрыПисьма.ИННЮЛ) + СокрЛП(ПараметрыПисьма.КППЮЛ));
			КонецЕсли;
		КонецЕсли;
	Иначе
		ИННКПП = ?(ПараметрыПисьма.ЭтоПБОЮЛ, СокрЛП(ПараметрыПисьма.ИННФЛ), СокрЛП(ПараметрыПисьма.ИННЮЛ) + СокрЛП(ПараметрыПисьма.КППЮЛ));
	КонецЕсли;
	
	// формируем код получателя
	Если (НЕ ЗначениеЗаполнено(Запрос.Получатель)) Тогда
		КодИФНСПолучателя = "0000";
		КодНалоговогоОргана = СокрЛП(РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Запрос.Организация, , "КодНО").КодНО);
	Иначе
		КодИФНСПолучателя = СокрЛП(Запрос.Получатель.Код);
		КодНалоговогоОргана = КодИФНСПолучателя;
	КонецЕсли;
	
	// инициализируем служебные соответствия
	СоответствиеВидаУслугиКоду = Новый Соответствие;
	СоответствиеВидаУслугиКоду.Вставить(Перечисления.ВидыУслугПриИОН.ПредставлениеСправкиОСостоянииРасчетовСБюджетом, "1");
	СоответствиеВидаУслугиКоду.Вставить(Перечисления.ВидыУслугПриИОН.ПредставлениеВыпискиОперацийИзКарточкиРасчетыСБюджетом, "2");
	СоответствиеВидаУслугиКоду.Вставить(Перечисления.ВидыУслугПриИОН.ПредставлениеПеречняБухгалтерскойИНалоговойОтчетности, "3");
	СоответствиеВидаУслугиКоду.Вставить(Перечисления.ВидыУслугПриИОН.ПредставлениеАктовСверкиРасчетов, "4");
	СоответствиеВидаУслугиКоду.Вставить(Перечисления.ВидыУслугПриИОН.ПредставлениеСправкиОбИсполненииОбязанностейПоУплате, "5");
	
	СоответствиеФорматовОтветовИдентификатору = Новый Соответствие;
	СоответствиеФорматовОтветовИдентификатору.Вставить(Перечисления.ФорматОтветаНаЗапросИОН.RTF, "1");
	СоответствиеФорматовОтветовИдентификатору.Вставить(Перечисления.ФорматОтветаНаЗапросИОН.XML, "2");
	СоответствиеФорматовОтветовИдентификатору.Вставить(Перечисления.ФорматОтветаНаЗапросИОН.XLS, "3");
	СоответствиеФорматовОтветовИдентификатору.Вставить(Перечисления.ФорматОтветаНаЗапросИОН.PDF, "4");
	
	ИмяФайлаБезРасширения = "IU_ZAPR_"
							 + ?(Запрос.Организация.КрупнейшийНалогоплательщик И ЗначениеЗаполнено(Запрос.Организация.КодНалоговогоОрганаПолучателя), СокрЛП(Запрос.Организация.КодНалоговогоОрганаПолучателя), СокрЛП(КодНалоговогоОргана))
							 + "_"
							 + СокрЛП(КодИФНСПолучателя)
							 + "_"
							 + ИННКПП
							 + "_"
							 + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd")
							 + "_"
							 + Строка(Новый УникальныйИдентификатор);
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	УзелФайл = ДобавитьУзелXML(Дерево, "Файл");
	ДобавитьУзелXML(УзелФайл, "ИдФайл", Истина, XMLСтрока(ИмяФайлаБезРасширения));
	ДобавитьУзелXML(УзелФайл, "ВерсПрог", Истина, Лев(XMLСтрока(РегламентированнаяОтчетность.НазваниеИВерсияПрограммы()), 40));
	ДобавитьУзелXML(УзелФайл, "ВерсФорм", Истина, XMLСтрока("5.04"));
	УзелДокумент = ДобавитьУзелXML(УзелФайл, "Документ");
	
		ДобавитьУзелXML(УзелДокумент, "КНД", Истина, XMLСтрока("1166101"));
		ДобавитьУзелXML(УзелДокумент, "ДатаДок", Истина, XMLСтрока(Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy")));
		УзелСвНП = ДобавитьУзелXML(УзелДокумент, "СвНП");
			
		Если НЕ ПараметрыПисьма.ЭтоПБОЮЛ Тогда
			
			УзелНПЮЛ = ДобавитьУзелXML(УзелСвНП, "НПЮЛ");
			
				ДобавитьУзелXML(УзелНПЮЛ, "НаимОрг", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.НаимЮЛПол)), 1000));
				ДобавитьУзелXML(УзелНПЮЛ, "ИННЮЛ", Истина, XMLСтрока(СокрЛП(ПараметрыПисьма.ИННЮЛ)));
				Если КодИФНСПолучателя <> "0000" Тогда
					ДобавитьУзелXML(УзелНПЮЛ, "КПП", Истина, XMLСтрока(СокрЛП(ПараметрыПисьма.КППЮЛ)));
				КонецЕсли;
				
			УзелАдрРФ = ДобавитьУзелXML(УзелСвНП, "АдрРФ");
			
				Если ЗначениеЗаполнено(ПараметрыПисьма.ОргРайон) ИЛИ ЗначениеЗаполнено(ПараметрыПисьма.ОргГород) ИЛИ ЗначениеЗаполнено(ПараметрыПисьма.ОргНПункт)
					ИЛИ ЗначениеЗаполнено(ПараметрыПисьма.ОргУлица) ИЛИ ЗначениеЗаполнено(ПараметрыПисьма.ОргДом) ИЛИ ЗначениеЗаполнено(ПараметрыПисьма.ОргКорпус)
					ИЛИ ЗначениеЗаполнено(ПараметрыПисьма.ОргКвартира) Тогда
					
					АдрНП = Новый Структура;
					АдрНП.Вставить("Индекс", 			ПараметрыПисьма.ОргИндекс);
					АдрНП.Вставить("КодРегион", 		ПараметрыПисьма.ОргКодСубъект);
					АдрНП.Вставить("Район", 			ПараметрыПисьма.ОргРайон);
					АдрНП.Вставить("Город", 			ПараметрыПисьма.ОргГород);
					АдрНП.Вставить("НаселенныйПункт", 	ПараметрыПисьма.ОргНПункт);
					АдрНП.Вставить("Улица", 			ПараметрыПисьма.ОргУлица);
					АдрНП.Вставить("Дом", 				ПараметрыПисьма.ОргДом);
					АдрНП.Вставить("Корпус", 			ПараметрыПисьма.ОргКорпус);
					АдрНП.Вставить("Квартира", 			ПараметрыПисьма.ОргКвартира);
					
					Если НЕ ЗначениеЗаполнено(АдрНП.КодРегион) Тогда
						АдрНПРазложением = РегламентированнаяОтчетностьКлиентСервер.РазложитьАдрес(ПараметрыПисьма.АдрЮР);
						АдрНП.КодРегион = КодРегионаИзАдреса(АдрНПРазложением);
					КонецЕсли;
					
				Иначе
					АдрНП = РегламентированнаяОтчетностьКлиентСервер.РазложитьАдрес(ПараметрыПисьма.АдрЮр);
					АдрНП.Вставить("КодРегион", КодРегионаИзАдреса(АдрНП));
				КонецЕсли;
				
				ДобавитьУзелXML(УзелАдрРФ, "Индекс", Истина, Лев(XMLСтрока(АдрНП.Индекс), 6), Истина);
				ДобавитьУзелXML(УзелАдрРФ, "КодРегион", Истина, Лев(XMLСтрока(АдрНП.КодРегион), 2));
				ДобавитьУзелXML(УзелАдрРФ, "Район", Истина, Лев(XMLСтрока(АдрНП.Район), 50), Истина);
				ДобавитьУзелXML(УзелАдрРФ, "Город", Истина, Лев(XMLСтрока(АдрНП.Город), 50), Истина);
				ДобавитьУзелXML(УзелАдрРФ, "НаселПункт", Истина, Лев(XMLСтрока(АдрНП.НаселенныйПункт), 50), Истина);
				ДобавитьУзелXML(УзелАдрРФ, "Улица", Истина, Лев(XMLСтрока(АдрНП.Улица), 50), Истина);
				ДобавитьУзелXML(УзелАдрРФ, "Дом", Истина, Лев(XMLСтрока(АдрНП.Дом), 8), Истина);
				ДобавитьУзелXML(УзелАдрРФ, "Корпус", Истина, Лев(XMLСтрока(АдрНП.Корпус), 8), Истина);
				ДобавитьУзелXML(УзелАдрРФ, "Кварт", Истина, Лев(XMLСтрока(АдрНП.Квартира), 8), Истина);
			
		Иначе
			
			УзелНПФЛ = ДобавитьУзелXML(УзелСвНП, "НПФЛ");
			
				ДобавитьУзелXML(УзелНПФЛ, "ИННФЛ", Истина, XMLСтрока(СокрЛП(ПараметрыПисьма.ИННФЛ)), Истина);
				УзелФИО = ДобавитьУзелXML(УзелНПФЛ, "ФИО");
				
					ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПФамилия)), 60));
					ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПИмя)), 60));
					ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПОтчество)), 60), Истина);
					
			УзелАдрРФ = ДобавитьУзелXML(УзелСвНП, "АдрРФ");
			
				Если ЗначениеЗаполнено(ПараметрыПисьма.РайонМЖ) ИЛИ ЗначениеЗаполнено(ПараметрыПисьма.ГородМЖ) ИЛИ ЗначениеЗаполнено(ПараметрыПисьма.НПунктМЖ)
					ИЛИ ЗначениеЗаполнено(ПараметрыПисьма.УлицаМЖ) ИЛИ ЗначениеЗаполнено(ПараметрыПисьма.ДомМЖ) ИЛИ ЗначениеЗаполнено(ПараметрыПисьма.КорпусМЖ)
					ИЛИ ЗначениеЗаполнено(ПараметрыПисьма.КвартираМЖ) Тогда
					
					АдрНП = Новый Структура;
					АдрНП.Вставить("Индекс", 			ПараметрыПисьма.ИндексМЖ);
					АдрНП.Вставить("КодРегион", 		ПараметрыПисьма.КодСубъектМЖ);
					АдрНП.Вставить("Район", 			ПараметрыПисьма.РайонМЖ);
					АдрНП.Вставить("Город", 			ПараметрыПисьма.ГородМЖ);
					АдрНП.Вставить("НаселенныйПункт", 	ПараметрыПисьма.НПунктМЖ);
					АдрНП.Вставить("Улица", 			ПараметрыПисьма.УлицаМЖ);
					АдрНП.Вставить("Дом", 				ПараметрыПисьма.ДомМЖ);
					АдрНП.Вставить("Корпус", 			ПараметрыПисьма.КорпусМЖ);
					АдрНП.Вставить("Квартира", 			ПараметрыПисьма.КвартираМЖ);
					
					Если НЕ ЗначениеЗаполнено(АдрНП.КодРегион) Тогда
						АдрНПРазложением = РегламентированнаяОтчетностьКлиентСервер.РазложитьАдрес(ПараметрыПисьма.АдрМЖ);
						АдрНП.КодРегион = КодРегионаИзАдреса(АдрНПРазложением);
					КонецЕсли;
					
				Иначе
					АдрНП = РегламентированнаяОтчетностьКлиентСервер.РазложитьАдрес(ПараметрыПисьма.АдрМЖ);
					АдрНП.Вставить("КодРегион", КодРегионаИзАдреса(АдрНП));
				КонецЕсли;
				
				ДобавитьУзелXML(УзелАдрРФ, "Индекс", Истина, Лев(XMLСтрока(АдрНП.Индекс), 6), Истина);
				ДобавитьУзелXML(УзелАдрРФ, "КодРегион", Истина, Лев(XMLСтрока(АдрНП.КодРегион), 2));
				ДобавитьУзелXML(УзелАдрРФ, "Район", Истина, Лев(XMLСтрока(АдрНП.Район), 50), Истина);
				ДобавитьУзелXML(УзелАдрРФ, "Город", Истина, Лев(XMLСтрока(АдрНП.Город), 50), Истина);
				ДобавитьУзелXML(УзелАдрРФ, "НаселПункт", Истина, Лев(XMLСтрока(АдрНП.НаселенныйПункт), 50), Истина);
				ДобавитьУзелXML(УзелАдрРФ, "Улица", Истина, Лев(XMLСтрока(АдрНП.Улица), 50), Истина);
				ДобавитьУзелXML(УзелАдрРФ, "Дом", Истина, Лев(XMLСтрока(АдрНП.Дом), 8), Истина);
				ДобавитьУзелXML(УзелАдрРФ, "Корпус", Истина, Лев(XMLСтрока(АдрНП.Корпус), 8), Истина);
				ДобавитьУзелXML(УзелАдрРФ, "Кварт", Истина, Лев(XMLСтрока(АдрНП.Квартира), 8), Истина);
			
		КонецЕсли;
		
		УзелСвНП = ДобавитьУзелXML(УзелДокумент, "СвОтпр");
		Если ПараметрыПисьма.ПрПодп = 1 Тогда // отправитель - налогоплательщик
			Если НЕ ПараметрыПисьма.ЭтоПБОЮЛ Тогда
				УзелНПЮЛ = ДобавитьУзелXML(УзелСвНП, "СвОтпрЮЛ");
					ДобавитьУзелXML(УзелНПЮЛ, "НаимОрг", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.НаимЮЛПол)), 1000));
					ДобавитьУзелXML(УзелНПЮЛ, "ИННЮЛ", Истина, XMLСтрока(СокрЛП(ПараметрыПисьма.ИННЮЛ)));
					ДобавитьУзелXML(УзелНПЮЛ, "КПП", Истина, XMLСтрока(СокрЛП(ПараметрыПисьма.КППЮЛ)));
			Иначе
				УзелНПФЛ = ДобавитьУзелXML(УзелСвНП, "СвОтпрФЛ");
					ДобавитьУзелXML(УзелНПФЛ, "ИННФЛ", Истина, XMLСтрока(СокрЛП(ПараметрыПисьма.ИННФЛ)), Истина);
					УзелФИО = ДобавитьУзелXML(УзелНПФЛ, "ФИО");
						ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПФамилия)), 60));
						ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПИмя)), 60));
						ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПОтчество)), 60), Истина);
			КонецЕсли;
		Иначе
			СвДоверенность = ПараметрыПисьма.Доверенность;
			СвПредст = СвДоверенность.СвУпПред.СвПред;
			Если СвПредст.Свойство("СвОрг") Тогда // представитель - ЮЛ
				УзелНПЮЛ = ДобавитьУзелXML(УзелСвНП, "СвОтпрЮЛ");
				ДобавитьУзелXML(УзелНПЮЛ, "НаимОрг", Истина, Лев(XMLСтрока(СокрЛП(СвПредст.СвОрг.НаимОрг)), 1000));
					ДобавитьУзелXML(УзелНПЮЛ, "ИННЮЛ", Истина, XMLСтрока(СокрЛП(СвПредст.СвОрг.ИННЮЛ)));
					ДобавитьУзелXML(УзелНПЮЛ, "КПП", Истина, XMLСтрока(СокрЛП(СвПредст.СвОрг.КПП)));
			Иначе
				Если СвПредст.СведФизЛ.ЯвляетсяСотрудникомОрганизации Тогда
					Если НЕ ПараметрыПисьма.ЭтоПБОЮЛ Тогда
						УзелНПЮЛ = ДобавитьУзелXML(УзелСвНП, "СвОтпрЮЛ");
						ДобавитьУзелXML(УзелНПЮЛ, "НаимОрг", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.НаимЮЛПол)), 1000));
						ДобавитьУзелXML(УзелНПЮЛ, "ИННЮЛ", Истина, XMLСтрока(СокрЛП(ПараметрыПисьма.ИННЮЛ)));
						ДобавитьУзелXML(УзелНПЮЛ, "КПП", Истина, XMLСтрока(СокрЛП(ПараметрыПисьма.КППЮЛ)));	
					Иначе
						УзелНПФЛ = ДобавитьУзелXML(УзелСвНП, "СвОтпрФЛ");
						ДобавитьУзелXML(УзелНПФЛ, "ИННФЛ", Истина, XMLСтрока(СокрЛП(ПараметрыПисьма.ИННФЛ)), Истина);
						УзелФИО = ДобавитьУзелXML(УзелНПФЛ, "ФИО");
						ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПФамилия)), 60));
						ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПИмя)), 60));
						ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПОтчество)), 60), Истина);
					КонецЕсли;
				Иначе	
					УзелНПФЛ = ДобавитьУзелXML(УзелСвНП, "СвОтпрФЛ");
					ДобавитьУзелXML(УзелНПФЛ, "ИННФЛ", Истина, XMLСтрока(СокрЛП(СвПредст.СведФизЛ.ИННФЛ)), Истина);
					ФИОПредставителя = СвПредст.СведФизЛ.ФИО;
					УзелФИО = ДобавитьУзелXML(УзелНПФЛ, "ФИО");
					ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ФИОПредставителя.Фамилия)), 60));
					ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ФИОПредставителя.Имя)), 60));
					ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ФИОПредставителя.Отчество)), 60), Истина);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		УзелПодписант = ДобавитьУзелXML(УзелДокумент, "Подписант");
		
			ДобавитьУзелXML(УзелПодписант, "ПрПодп", Истина, ПараметрыПисьма.ПрПодп);
			УзелФИО = ДобавитьУзелXML(УзелПодписант, "ФИО");
			Если ПараметрыПисьма.ПрПодп = 1 Тогда
				Если НЕ ПараметрыПисьма.ЭтоПБОЮЛ Тогда
					ФИОПодписанта = РегламентированнаяОтчетность.РазложитьФИО(ПараметрыПисьма.ФИОРук);
					ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Фамилия)), 60));
					ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Имя)), 60));
					ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Отчество)), 60), Истина);
				Иначе
					ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПФамилия)), 60));
					ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПИмя)), 60));
					ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПОтчество)), 60), Истина);
				КонецЕсли;
			Иначе
				ФИОПодписанта = ПараметрыПисьма.Доверенность.СвУпПред.СвПред.СведФизЛ.ФИО;
				ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Фамилия)), 60));
				ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Имя)), 60));
				ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Отчество)), 60), Истина);
			КонецЕсли;
		
		УзелЗапрИнфУсл = ДобавитьУзелXML(УзелДокумент, "ЗапрИнфУсл");
		
			ДобавитьУзелXML(УзелЗапрИнфУсл, "ИФНС", Истина, XMLСтрока(КодИФНСПолучателя));
			ДобавитьУзелXML(УзелЗапрИнфУсл, "КодЗапр", Истина, СоответствиеВидаУслугиКоду[Запрос.ВидУслуги]);
			ДобавитьУзелXML(УзелЗапрИнфУсл, "ФормОтв", Истина, СоответствиеФорматовОтветовИдентификатору[Запрос.ФорматОтвета]);
			Если Запрос.ВидУслуги = Перечисления.ВидыУслугПриИОН.ПредставлениеСправкиОСостоянииРасчетовСБюджетом Тогда
				УзелАктСвер = ДобавитьУзелXML(УзелЗапрИнфУсл, "СпрРасБюд");
					ДобавитьУзелXML(УзелАктСвер, "НаДату", Истина, XMLСтрока(Формат(Запрос.ДатаОкончанияПериода, "ДФ=dd.MM.yyyy")));
			ИначеЕсли Запрос.ВидУслуги = Перечисления.ВидыУслугПриИОН.ПредставлениеВыпискиОперацийИзКарточкиРасчетыСБюджетом Тогда
				УзелВыпОперРас = ДобавитьУзелXML(УзелЗапрИнфУсл, "ВыпОперРас");
					ДобавитьУзелXML(УзелВыпОперРас, "УслФорВып", Истина, XMLСтрока(?(Запрос.ДополнительныйПараметр = 0, 2, 1)));
					ДобавитьУзелXML(УзелВыпОперРас, "Год", Истина, XMLСтрока(Формат(Запрос.ДатаОкончанияПериода, "ДФ=yyyy")));
					Для Каждого Стр Из Запрос.ЗапрашиваемыеНалоги Цикл
						УзелСвНалог = ДобавитьУзелXML(УзелВыпОперРас, "СвНалог");
						ДобавитьУзелXML(УзелСвНалог, "КБК", Истина, XMLСтрока(Стр.КБК));
						Если СтрДлина(СокрЛП(Стр.ОКАТО)) = 8 Тогда
							ДобавитьУзелXML(УзелСвНалог, "ОКТМО", Ложь, XMLСтрока(СокрЛП(Стр.ОКАТО)));
						Иначе
							ДобавитьУзелXML(УзелСвНалог, "ОКАТО", Ложь, XMLСтрока(СокрЛП(Стр.ОКАТО)));
						КонецЕсли;
					КонецЦикла;
			ИначеЕсли Запрос.ВидУслуги = Перечисления.ВидыУслугПриИОН.ПредставлениеПеречняБухгалтерскойИНалоговойОтчетности Тогда
				УзелПеречНалДекл = ДобавитьУзелXML(УзелЗапрИнфУсл, "ПеречНалДекл");
					ДобавитьУзелXML(УзелПеречНалДекл, "ДатаНач", Истина, XMLСтрока(Формат(Запрос.ДатаНачалаПериода, "ДФ=dd.MM.yyyy")));
					ДобавитьУзелXML(УзелПеречНалДекл, "ДатаКон", Истина, XMLСтрока(Формат(Запрос.ДатаОкончанияПериода, "ДФ=dd.MM.yyyy")));
					ДобавитьУзелXML(УзелПеречНалДекл, "УслВыбОтч", Истина, XMLСтрока(Запрос.ДополнительныйПараметр));
			ИначеЕсли Запрос.ВидУслуги = Перечисления.ВидыУслугПриИОН.ПредставлениеАктовСверкиРасчетов Тогда
				УзелСпрРасБюд = ДобавитьУзелXML(УзелЗапрИнфУсл, "АктСвер");
					ДобавитьУзелXML(УзелСпрРасБюд, "Год", Истина, XMLСтрока(Формат(Запрос.ДатаНачалаПериода, "ДФ=yyyy")));
					ДобавитьУзелXML(УзелСпрРасБюд, "НаДату", Истина, XMLСтрока(Формат(Запрос.ДатаОкончанияПериода, "ДФ=dd.MM.yyyy")));
					Для Каждого Стр Из Запрос.ЗапрашиваемыеНалоги Цикл
						УзелСвНалог = ДобавитьУзелXML(УзелСпрРасБюд, "СвНалог");
						ДобавитьУзелXML(УзелСвНалог, "КБК", Истина, XMLСтрока(Стр.КБК));
						Если СтрДлина(СокрЛП(Стр.ОКАТО)) = 8 Тогда
							ДобавитьУзелXML(УзелСвНалог, "ОКТМО", Ложь, XMLСтрока(СокрЛП(Стр.ОКАТО)));
						Иначе
							ДобавитьУзелXML(УзелСвНалог, "ОКАТО", Ложь, XMLСтрока(СокрЛП(Стр.ОКАТО)));
						КонецЕсли;
					КонецЦикла;
			ИначеЕсли Запрос.ВидУслуги = Перечисления.ВидыУслугПриИОН.ПредставлениеСправкиОбИсполненииОбязанностейПоУплате Тогда
				УзелСпрИспОбяз = ДобавитьУзелXML(УзелЗапрИнфУсл, "СпрИспОбяз");
					ДобавитьУзелXML(УзелСпрИспОбяз, "НаДату", Истина, XMLСтрока(Формат(Запрос.ДатаОкончанияПериода, "ДФ=dd.MM.yyyy")));
			КонецЕсли;
		
	// сохранение дерева XML в файл и двоичные данные
	ТекстВыгрузкиXML = ЗаписатьДеревоВXML(Дерево);
	
	// записываем XML запроса во временный файл
	ВремФайл = ПолучитьИмяВременногоФайла();
	Если НЕ ЗаписатьXMLВФайл(ТекстВыгрузкиXML, ВремФайл) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось записать текст запроса во временный файл!';
															|en = 'Cannot write the query text to the temporary file.'"));
		Возврат Ложь;
	КонецЕсли;
	
	// считываем двоичные данные файла запроса, после чего удаляем файл
	ДвоичныеДанныеФайлаЗапроса = Новый ДвоичныеДанные(ВремФайл);
	ДвоичныеДанныеФайлаЗапроса = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаЗапроса, УникальныйИдентификатор);
	УдалитьФайлы(ВремФайл);
	
	// формируем имя файла запроса
	ИмяФайлаЗапроса = ИмяФайлаБезРасширения + ".xml";
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьЗаполнениеЗапроса535(ДокЗапрос, Параметры)
	
	СтатусПроверки = Истина;
	
	Если НЕ ЗначениеЗаполнено(ДокЗапрос.Организация) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задана организация!';
															|en = 'Company is not set.'"));
		СтатусПроверки = Ложь;
		Возврат СтатусПроверки;
	ИначеЕсли НЕ ЗначениеЗаполнено(ДокЗапрос.Получатель) И ДокЗапрос.ВидУслуги <> Перечисления.ВидыУслугПриИОН.ПредставлениеСправкиОбИсполненииОбязанностейПоУплате Тогда // в приказе предусмотрена возможность формирования запроса в условную инспекцию 0000
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан получатель!';
															|en = 'Recipient is not specified.'"));
		СтатусПроверки = Ложь;
		Возврат СтатусПроверки;
	КонецЕсли;
	
	// проверка сведений об отправителе
	Если Параметры.ПрПодп = 1 Тогда // отправитель - налогоплательщик
		Если Параметры.ЭтоПБОЮЛ Тогда
			Если НЕ ЗначениеЗаполнено(Параметры.ИННФЛ) Тогда
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан ИНН индивидуального предпринимателя!';
																	|en = 'TIN of individual entrepreneur is not specified.'"));
				СтатусПроверки = Ложь;
			КонецЕсли;
		КонецЕсли;
	Иначе
		СвПредст = Параметры.Доверенность.СвУпПред.СвПред;
		Если НЕ СвПредст.Свойство("СвОрг") Тогда
			Если НЕ СвПредст.СведФизЛ.ЯвляетсяСотрудникомОрганизации Тогда
				ИННФЛ = СвПредст.СведФизЛ.ИННФЛ;
			Иначе
				ИННФЛ = ?(Параметры.ЭтоПБОЮЛ, Параметры.ИННФЛ, Параметры.ИННЮЛ);
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ИННФЛ) Тогда
				Если НЕ СвПредст.СведФизЛ.ЯвляетсяСотрудникомОрганизации ИЛИ Параметры.ЭтоПБОЮЛ Тогда
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан ИНН физлица-представителя!';
																		|en = 'TIN of the individual''s representative is not specified.'"));
				Иначе
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан ИНН организации физлица-представителя!';
																		|en = 'TIN of individual''s representative company is not specified.'"));
				КонецЕсли;
				СтатусПроверки = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Параметры.ЭтоПБОЮЛ Тогда
	
		Если ПустаяСтрока(Параметры.АдрЮр) Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан адрес организации (индивидуального предпринимателя)!';
																|en = 'Company (individual entrepreneur) address is not specified.'"));
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Параметры.ОргРайон) И НЕ ЗначениеЗаполнено(Параметры.ОргГород) И НЕ ЗначениеЗаполнено(Параметры.ОргНПункт)
			И НЕ ЗначениеЗаполнено(Параметры.ОргУлица) И НЕ ЗначениеЗаполнено(Параметры.ОргДом) И НЕ ЗначениеЗаполнено(Параметры.ОргКорпус)
			И НЕ ЗначениеЗаполнено(Параметры.ОргКвартира) И СтрЧислоВхождений(Параметры.АдрЮР, ",") <> 9 И СтрЧислоВхождений(Параметры.АдрЮР, ",") <> 12 Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Адрес организации (индивидуального предпринимателя) должен содержать в себе 9 или 12 запятых!';
																|en = 'Company (individual entrepreneur) address should contain 9 or 12 commas. '"));
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если КодРегионаИзАдреса(Параметры.АдрЮр) = "" Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось определить код региона, указанного в адресе организации (индивидуального предпринимателя).
										|Проверьте правильность указания региона!';
										|en = 'Cannot determine a code of the region specified in the company (IE) address.
										|Check whether the region is specified correctly.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
	Иначе
		
		Если ПустаяСтрока(Параметры.АдрМЖ) Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан адрес места жительства индивидуального предпринимателя!';
																|en = 'Residential address of the individual entrepreneur is not specified.'"));
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Параметры.РайонМЖ) И НЕ ЗначениеЗаполнено(Параметры.ГородМЖ) И НЕ ЗначениеЗаполнено(Параметры.НПунктМЖ)
			И НЕ ЗначениеЗаполнено(Параметры.УлицаМЖ) И НЕ ЗначениеЗаполнено(Параметры.ДомМЖ) И НЕ ЗначениеЗаполнено(Параметры.КорпусМЖ)
			И НЕ ЗначениеЗаполнено(Параметры.КвартираМЖ) И СтрЧислоВхождений(Параметры.АдрМЖ, ",") <> 9 И СтрЧислоВхождений(Параметры.АдрМЖ, ",") <> 12 Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Адрес места жительства индивидуального предпринимателя должен содержать в себе 9 или 12 запятых!';
																|en = 'Residential address of an individual entrepreneur should contain 9 or 12 commas.'"));
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если КодРегионаИзАдреса(Параметры.АдрМЖ) = "" Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось определить код региона, указанного в адресе места жительства индивидуального предпринимателя.
										|Проверьте правильность указания региона!';
										|en = 'Cannot determine a code of the region specified in the IE residential address.
										|Check whether the region is specified correctly.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Параметры.КодНО) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан налоговый орган!';
															|en = 'Tax authority is not specified.'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если СтрДлина(Параметры.КодНО) <> 4 ИЛИ НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Параметры.КодНО) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Код налогового органа должен состоять из четырех цифр!';
															|en = 'Tax authority code should contain 4 digits.'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокЗапрос.ДатаНачалаПериода) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задана дата начала периода!';
															|en = 'Period start date is not specified.'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокЗапрос.ДатаОкончанияПериода) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задана дата окончания периода!';
															|en = 'Period end date is not specified.'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если ДокЗапрос.ДатаНачалаПериода > ДокЗапрос.ДатаОкончанияПериода Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Дата начала периода не может быть больше даты окончания!';
															|en = 'Period start date cannot be greater than end date.'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокЗапрос.ФорматОтвета) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Выберите один из типов файла ответа!';
															|en = 'Select one of the response file types.'"));
		СтатусПроверки = Ложь;
	ИначеЕсли ДокЗапрос.ФорматОтвета <> Перечисления.ФорматОтветаНаЗапросИОН.RTF
	И ДокЗапрос.ФорматОтвета <> Перечисления.ФорматОтветаНаЗапросИОН.XLS
	И ДокЗапрос.ФорматОтвета <> Перечисления.ФорматОтветаНаЗапросИОН.XML
	И ДокЗапрос.ФорматОтвета <> Перечисления.ФорматОтветаНаЗапросИОН.PDF Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Выбранный формат ответа на запрос не поддерживается актуальным форматом документооборота с ФНС!';
															|en = 'Selected format of query response is not supported by the relevant format of data interchange with FTS.'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если Параметры.ЭтоПБОЮЛ Тогда
		Если ПустаяСтрока(Параметры.ИПФамилия) Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось определить фамилию индивидуального предпринимателя!';
																|en = 'Cannot determine IE last name.'"));
			СтатусПроверки = Ложь;
		КонецЕсли;
		Если ПустаяСтрока(Параметры.ИПИмя) Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось определить имя индивидуального предпринимателя!';
																|en = 'Cannot determine IE name.'"));
			СтатусПроверки = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ДокЗапрос.ВидУслуги = Перечисления.ВидыУслугПриИОН.ПредставлениеПеречняБухгалтерскойИНалоговойОтчетности Тогда
		Если ДокЗапрос.ДополнительныйПараметр <> 1 И ДокЗапрос.ДополнительныйПараметр <> 2 И ДокЗапрос.ДополнительныйПараметр <> 3 Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан фильтр по виду документа!';
																|en = 'Filter by document kind is not specified.'"));
			СтатусПроверки = Ложь;
		КонецЕсли;
		Если Год(ДокЗапрос.ДатаНачалаПериода) <> Год(ДокЗапрос.ДатаОкончанияПериода) Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Год в дате начала периода запроса не соответствует в дате конца периода!';
																|en = 'Year of request period start date does not match year of request period end date.'"));
			СтатусПроверки = Ложь;
		КонецЕсли;
	ИначеЕсли ДокЗапрос.ВидУслуги = Перечисления.ВидыУслугПриИОН.ПредставлениеАктовСверкиРасчетов Тогда
		// проверки не требуются
	ИначеЕсли ДокЗапрос.ВидУслуги = Перечисления.ВидыУслугПриИОН.ПредставлениеВыпискиОперацийИзКарточкиРасчетыСБюджетом Тогда
		// проверки не требуются
	ИначеЕсли ДокЗапрос.ВидУслуги = Перечисления.ВидыУслугПриИОН.ПредставлениеСправкиОбИсполненииОбязанностейПоУплате Тогда
		Если ДокЗапрос.ФорматОтвета <> Перечисления.ФорматОтветаНаЗапросИОН.XML Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Для данного вида услуги формат ответа на запрос должен быть xml';
																|en = 'XML format of request response is required for this service kind '"));
			СтатусПроверки = Ложь;
		КонецЕсли;
		
	ИначеЕсли ДокЗапрос.ВидУслуги = Перечисления.ВидыУслугПриИОН.ПредставлениеСправкиОСостоянииРасчетовСБюджетом Тогда
		// проверки не требуются
	ИначеЕсли ДокЗапрос.ВидУслуги = Перечисления.ВидыУслугПриИОН.ПустаяСсылка() Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не указан вид услуги!';
															|en = 'Service kind is not specified.'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Возврат СтатусПроверки;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ СОХРАНЕНИЯ ЗАПРОСА В ФАЙЛ НА ДИСК

&НаКлиенте
Процедура ВыгрузитьЗапросИОНВФайл(ДокЗапрос, УникальныйИдентификатор = Неопределено) Экспорт
	Перем Запрос, ИмяФайлаЗапроса;
	
	Если СформироватьФайлЗапросаИОН(ДокЗапрос, Запрос, ИмяФайлаЗапроса, УникальныйИдентификатор) Тогда
		ОперацииСФайламиЭДКОКлиент.СохранитьФайлы(Новый Структура("Адрес, Имя", Запрос, ИмяФайлаЗапроса));
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ФОРМИРОВАНИЯ ЗАПРОСА НА ИНФОРМАЦИОННОЕ ОБСЛУЖИВАНИЕ

&НаСервереБезКонтекста
Функция СформироватьПараметрыЗапроса(Запрос)
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.СформироватьПараметрыЗапроса(Запрос);
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////

#Область ОтправкаЗапросаНаИнформационноеОбслуживание

&НаКлиенте
Процедура ОтправкаЗапросаНаИнформационноеОбслуживание(Док, Организация, ВыполняемоеОповещение) Экспорт
	
	Если НЕ ОбъектЗаполненКорректно(Док) Тогда
		Возврат;
	КонецЕсли;
	
	КонтекстДлительнойОперации = Новый Структура();
	КонтекстДлительнойОперации.Вставить("Док",                   Док);
	КонтекстДлительнойОперации.Вставить("Организация",           Организация);
	КонтекстДлительнойОперации.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаЗапросаНаИнформационноеОбслуживание_ПослеНастройкиЗаявления", 
		ЭтотОбъект, 
		КонтекстДлительнойОперации);
		
	ЗавершитьНастройкуЗаявленияНаИзменение(Док, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЗапросаНаИнформационноеОбслуживание_ПослеНастройкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаЗапросаНаИнформационноеОбслуживание_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ВходящийКонтекст.Док, ВходящийКонтекст.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЗапросаНаИнформационноеОбслуживание_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		Возврат;
	КонецЕсли;
	
	Док = ВходящийКонтекст.Док;
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= Док;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 5;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= ВходящийКонтекст;

	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка сверки в ФНС
		Возврат;
	КонецЕсли;
		
	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаЗапросаНаИнформационноеОбслуживание",  0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаЗапросаНаИнформационноеОбслуживание() Экспорт
	
	КонтекстДлительнойОперации 	= ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	Док 		= КонтекстДлительнойОперации.Док;
	Контекст 	= ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(КонтекстДлительнойОперации);
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется настройка учетной записи...");
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаЗапросаНаИнформационноеОбслуживаниеПослеАвтонастройкиУчетнойЗаписи",
		ЭтотОбъект,
		Контекст);
		
	ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(Док, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЗапросаНаИнформационноеОбслуживание_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	Параметры_Док 					= ВходящийКонтекст.Док;
	Параметры_Организация 			= ВходящийКонтекст.Организация;
	Параметры_ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	ОтправкаЗапросаНаИнформационноеОбслуживание(Параметры_Док, Параметры_Организация, Параметры_ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЗапросаНаИнформационноеОбслуживаниеПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт
	
	Док = ВходящийКонтекст.Док;
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("Документ", Док);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Запись данных...");

	// отражаем изменения в базе
	Если НЕ ОтправкаЗапросаНаИнформационноеОбслуживание_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки) Тогда // сервер
		
		Если КонтекстОтправки.Свойство("ОтсутствуетУчетнаяЗапись") Тогда
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОтправкаЗапросаНаИнформационноеОбслуживание_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ВходящийКонтекст);
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(Док, ОписаниеОповещения);
			
		ИначеЕсли КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ВыполняемоеОповещение, Док);
		Иначе
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Док);
			
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	ВидУслуги = ПолучитьРеквизит(Док, "ВидУслуги");
	
	Если ВидУслуги <> ПредопределенноеЗначение("Перечисление.ВидыУслугПриИОН.ПредставлениеСправкиОбИсполненииОбязанностейПоУплате") Тогда
		// У данного вида сверки указывается получатель 0000, поэтому по нему проверять не нужно.
		Если НЕ ДокументооборотСКОВызовСервера.ОрганизацияПодключенаКИнспекции(Док) Тогда
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ВыполняемоеОповещение, Док);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Запись данных...");
	
	// формируем пакет
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ВыполняемоеОповещение);
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаЗапросаНаИнформационноеОбслуживаниеПослеФормированияПакета", ЭтотОбъект, Контекст);
		
	Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "ФНС");
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЗапросаНаИнформационноеОбслуживаниеПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;

	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("РезультатОтправки", 		КонтекстОтправки.Документ);
	
	Если Не Результат Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		Возврат;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Отправка...");
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(КонтекстОтправки) Тогда // сервер
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		Возврат;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ФНС
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправкаЗапросаНаИнформационноеОбслуживание_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст)
	
	Док = Контекст.Документ;
	Если НЕ ЗначениеЗаполнено(Док) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбран документ для отправки';
								|en = 'Document for sending is not selected'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// проверяем, включен ли обмен по организации
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Док, "Организация");
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбрана организация-отправитель.';
								|en = 'The sender company is not selected.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);

		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, предназначена ли эта учетная запись для документооборота с ФНС
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);
		Возврат Ложь;
		
	ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ПредназначенаДляДокументооборотаСФНС") <> Истина Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("НаправлениеНеПодключено", Истина);
		Возврат Ложь;
		
	КонецЕсли;
	
	// находим налоговый орган по коду
	КодНалоговогоОрганаКонечногоПолучателяДокумента = СокрЛП(Док.Получатель.Код);
	КодНалоговогоОргана = КодНалоговогоОрганаКонечногоПолучателяДокумента;
	Если НЕ ЗначениеЗаполнено(КодНалоговогоОргана) И Док.ВидУслуги = Перечисления.ВидыУслугПриИОН.ПредставлениеСправкиОбИсполненииОбязанностейПоУплате Тогда
		КодНалоговогоОрганаКонечногоПолучателяДокумента = СокрЛП(РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Док.Организация, , "КодНО").КодНО);
		Если Док.Организация.КрупнейшийНалогоплательщик И ЗначениеЗаполнено(Док.Организация.КодНалоговогоОрганаПолучателя) Тогда
			КодНалоговогоОргана = СокрЛП(Док.Организация.КодНалоговогоОрганаПолучателя);
		Иначе
			КодНалоговогоОргана = КодНалоговогоОрганаКонечногоПолучателяДокумента;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КодНалоговогоОргана) Тогда
		ТекстСообщения = НСтр("ru = 'Не задан налоговый орган';
								|en = 'Tax authority is not specified'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	НалоговыйОрган = Справочники.НалоговыеОрганы.НайтиПоКоду(КодНалоговогоОргана);
	Если НЕ ЗначениеЗаполнено(НалоговыйОрган) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не найден налоговый орган с кодом %1 в справочнике ""Налоговые органы""!';
				|en = 'Tax authority with code %1 is not found in the ""Tax authorities"" catalog.""'"), КодНалоговогоОргана);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// проверяем, указан ли получатель
	ПолучательДокумента = Док.Получатель;
	Если НЕ ЗначениеЗаполнено(ПолучательДокумента) И Док.ВидУслуги <> Перечисления.ВидыУслугПриИОН.ПредставлениеСправкиОбИсполненииОбязанностейПоУплате Тогда
		ТекстСообщения = НСтр("ru = 'Не задан получатель письма.';
								|en = 'Email recipient is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// формируем файл с содержимым
	ДвоичныеДанныеФайлаЗапроса = Неопределено;
	ИмяФайлаЗапроса = Неопределено;
	РезультатФормированияФайлаЗапроса = СформироватьФайлЗапросаИОН(Док, ДвоичныеДанныеФайлаЗапроса, ИмяФайлаЗапроса);
	Если НЕ РезультатФормированияФайлаЗапроса Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КороткоеИмяФайлаПисьма = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	
	ФайлДоверенности = Неопределено;
	КороткоеИмяФайлаДоверенности = Неопределено;
	
	// ищем РегистрацияВИФНС по организации и коду налогового органа
	ЭлРегистрацияВИФНС = Док.Получатель;
	Если НЕ ЗначениеЗаполнено(ЭлРегистрацияВИФНС) И Док.ВидУслуги = Перечисления.ВидыУслугПриИОН.ПредставлениеСправкиОбИсполненииОбязанностейПоУплате Тогда
		ЭлРегистрацияВИФНС = РегистрацияВИФНСПоОрганизацииИКодуНО(Док.Организация, КодНалоговогоОрганаКонечногоПолучателяДокумента);
		КодНалоговогоОрганаКонечногоПолучателя = "0000"; // отправка в целом по организации
	Иначе
		КодНалоговогоОрганаКонечногоПолучателя = Неопределено; // определять по регистрации в ИФНС
	КонецЕсли;
	Если ЗначениеЗаполнено(ЭлРегистрацияВИФНС) И ЗначениеЗаполнено(ЭлРегистрацияВИФНС.Доверенность) Тогда
		
		// формируем файл доверенности
		ФайлДоверенности = ВыгрузитьДоверенностьПредставление(ЭлРегистрацияВИФНС, КороткоеИмяФайлаДоверенности, Организация, КодНалоговогоОрганаКонечногоПолучателя);
		Если НЕ ЗначениеЗаполнено(ФайлДоверенности) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		//подменять имя файла при отправке через уполномоченного представителя не требуется
		
	КонецЕсли;
	
	НачатьТранзакцию();
	
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбменаСсылка = Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСФНС;
	ЦиклОбмена.Предмет = Док;
	ЦиклОбмена.Идентификатор = СгенерироватьUUID();
	ЦиклОбмена.Организация = Организация;
	ЦиклОбмена.УчетнаяЗапись = УчетнаяЗапись;
	ЦиклОбмена.ВнешняяОрганизация = НалоговыйОрган;
	ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.ИОН;
	ЦиклОбмена.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСФНС.Приказ534;
	ЦиклОбмена.ДатаНачалаПериода = Док.ДатаНачалаПериода;
	ЦиклОбмена.ДатаОкончанияПериода = Док.ДатаОкончанияПериода;
	ЦиклОбмена.ВидУслуги = Док.ВидУслуги;
	ЦиклОбмена.ФорматОтвета = Док.ФорматОтвета;
	
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена = ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ЗапросНП;
	ТранспортноеСообщение.Отправитель = Организация;
	ТранспортноеСообщение.Получатель = НалоговыйОрган;
	ТранспортноеСообщение.УчетнаяЗапись = УчетнаяЗапись;
	ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Исходящее;
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		ТекстСообщения = НСтр("ru = 'Отправка запроса прервана.';
								|en = 'Request sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	// ДОБАВЛЯЕМ ВЛОЖЕНИЯ
	
	// добавляем запрос
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Запрос, ДвоичныеДанныеФайлаЗапроса, ИмяФайлаЗапроса, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml) Тогда
		ОтменитьТранзакцию();
		ТекстСообщения = НСтр("ru = 'Отправка запроса прервана.';
								|en = 'Request sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// добавляем доверенность, если она есть
	Если ЗначениеЗаполнено(ФайлДоверенности) Тогда
		Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление, ФайлДоверенности, КороткоеИмяФайлаДоверенности, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml) Тогда
			ОтменитьТранзакцию();
			ТекстСообщения = НСтр("ru = 'Отправка запроса прервана.';
									|en = 'Request sending is canceled.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// записываем цикл обмена
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ОтменитьТранзакцию();
		ТекстСообщения = НСтр("ru = 'Отправка запроса прервана.';
								|en = 'Request sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	// изменяем статус отправки
	ЗаписатьСтатусОтправкиОбъекта(Док, Перечисления.СтатусыОтправки.ВКонверте);
	
	ЗафиксироватьТранзакцию();
	
	Контекст.Вставить("Организация", Организация);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

&НаСервереБезКонтекста
Функция УдалитьУзлыКромеАвтонастройки(ДеревоНастроекАдрес, ВыбранныйАдрес);
	
	Если ЭтоАдресВременногоХранилища(ДеревоНастроекАдрес) Тогда 
		ДеревоНастроек = ПолучитьИзВременногоХранилища(ДеревоНастроекАдрес);
	КонецЕсли;
	
	СтрокиСАдресамиУчетныхЗаписей = ДеревоНастроек.Строки.НайтиСтроки(Новый Структура("Параметр", "emailabsos"), Истина);

	// Получаем ИскомыйУзелAbsos
	ИскомыйУзелAbsos = Неопределено;
	Для Каждого СтрокаСАдресомУчетнойЗаписи Из СтрокиСАдресамиУчетныхЗаписей Цикл
		Если СтрокаСАдресомУчетнойЗаписи.Значение = ВыбранныйАдрес Тогда 
			ИскомыйУзелAbsos = СтрокаСАдресомУчетнойЗаписи.Родитель;
		КонецЕсли;
	КонецЦикла;
	
	// Удаляем лишние строки
	Для Каждого СтрокаСАдресомУчетнойЗаписи Из СтрокиСАдресамиУчетныхЗаписей Цикл
		УзелAbsos = СтрокаСАдресомУчетнойЗаписи.Родитель;
		Если СтрокаСАдресомУчетнойЗаписи.Родитель <> ИскомыйУзелAbsos Тогда
			УзелAbsos.Родитель.Строки.Удалить(УзелAbsos);
		КонецЕсли;
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(ДеревоНастроек, ДеревоНастроекАдрес);
	
КонецФункции


&НаСервереБезКонтекста
Функция КоличествоСтрокСАдресамиУчетныхЗаписей(ДеревоНастроекАдрес)
	
	Если ЭтоАдресВременногоХранилища(ДеревоНастроекАдрес) Тогда 
		ДеревоНастроек = ПолучитьИзВременногоХранилища(ДеревоНастроекАдрес);
	КонецЕсли;
	// находим все узлы с адресами учетных записей абонента
	СтрокиСАдресамиУчетныхЗаписей = ДеревоНастроек.Строки.НайтиСтроки(Новый Структура("Параметр", "emailabsos"), Истина);
	Возврат СтрокиСАдресамиУчетныхЗаписей.Количество();
	
КонецФункции

// ищем среди узлов адрес настраиваемой учетной записи
&НаСервереБезКонтекста
Функция НайтиАдресНастраиваемойУчетнойЗаписи(ДеревоНастроекАдрес, АдресУчетнойЗаписи)
	
	Если ЭтоАдресВременногоХранилища(ДеревоНастроекАдрес) Тогда 
		ДеревоНастроек = ПолучитьИзВременногоХранилища(ДеревоНастроекАдрес);
	КонецЕсли;
	СтрокиСАдресамиУчетныхЗаписей = ДеревоНастроек.Строки.НайтиСтроки(Новый Структура("Параметр", "emailabsos"), Истина);
	ИскомыйУзелAbsos = Неопределено;
	Для Каждого СтрокаСАдресомУчетнойЗаписи Из СтрокиСАдресамиУчетныхЗаписей Цикл
		Если СтрокаСАдресомУчетнойЗаписи.Значение = АдресУчетнойЗаписи Тогда
			ИскомыйУзелAbsos = СтрокаСАдресомУчетнойЗаписи.Родитель;
		КонецЕсли;
	КонецЦикла;
	
	// если узел не найден, то предложим пользователю выбрать из нескольких узлов
	Если ИскомыйУзелAbsos = Неопределено Тогда
		// формируем список выбора
		СписокВыбора = Новый СписокЗначений;
		Для Каждого СтрокаСАдресомУчетнойЗаписи Из СтрокиСАдресамиУчетныхЗаписей Цикл
			СписокВыбора.Добавить(СтрокаСАдресомУчетнойЗаписи.Значение);
		КонецЦикла;
		Возврат СписокВыбора;
	Иначе
		УдалитьУзлыКромеАвтонастройки(ДеревоНастроекАдрес, АдресУчетнойЗаписи);
		Возврат АдресУчетнойЗаписи;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОтфильтроватьДеревоНастроекПоУчетнойЗаписи(ДеревоНастроекАдрес, АдресУчетнойЗаписи, ВыполняемоеОповещение)
	
	Если КоличествоСтрокСАдресамиУчетныхЗаписей(ДеревоНастроекАдрес) < 2 Тогда
		Результат = Новый Структура("ДеревоНастроекАдрес, РезультатФильтрации", ДеревоНастроекАдрес, Истина);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	// ищем среди узлов адрес настраиваемой учетной записи
	ИскомыйУзелAbsos = НайтиАдресНастраиваемойУчетнойЗаписи(ДеревоНастроекАдрес, АдресУчетнойЗаписи);
	
	// если узел не найден, то предложим пользователю выбрать из нескольких узлов
	Если ТипЗнч(ИскомыйУзелAbsos) = Тип("СписокЗначений") Тогда
		
		СписокВыбора = ИскомыйУзелAbsos;
		// предлагаем выбрать
		ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ДеревоНастроекАдрес", ВыполняемоеОповещение, ДеревоНастроекАдрес);
		ОписаниеОповещения = Новый ОписаниеОповещения("ОтфильтроватьДеревоНастроекПоУчетнойЗаписиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		СписокВыбора.ПоказатьВыборЭлемента(ОписаниеОповещения, "Выберите одну из учетных записей");
	Иначе
		Результат = Новый Структура("ДеревоНастроекАдрес, АдресУчетнойЗаписи, РезультатФильтрации", ДеревоНастроекАдрес, АдресУчетнойЗаписи, Истина);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтфильтроватьДеревоНастроекПоУчетнойЗаписиЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ДеревоНастроекАдрес = ДополнительныеПараметры.ДеревоНастроекАдрес;
	
	Если РезультатВыбора = Неопределено Тогда
		Результат = Новый Структура("ДеревоНастроекАдрес, РезультатФильтрации", ДеревоНастроекАдрес, Ложь);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	Иначе
		// удаляем все узлы absos, кроме того, по которому будем автонастраивать
		УдалитьУзлыКромеАвтонастройки(ДеревоНастроекАдрес, РезультатВыбора.Значение);
		
		Результат = Новый Структура("ДеревоНастроекАдрес, РезультатФильтрации", ДеревоНастроекАдрес, Истина);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьТаблицуИсправленийНаОсновеФайлаНастроек(
		ФайлНастроек,
		УведомлятьТолькоОбОшибках,
		ВыполняемоеОповещение,
		УчетнаяЗапись = Неопределено) Экспорт
	
	Сообщения = СоздатьТаблицуСообщений(Истина);
	ФормаПрогресса = Неопределено;
	
	Попытка
		АдресФайлаНастроек = ФайлНастроек;
		ДеревоНастроек = ВосстановитьXMLВДерево(АдресФайлаНастроек, Сообщения);
		РезультатЗаполнения = Истина;
	Исключение
		РезультатЗаполнения = Ложь;
	КонецПопытки;
	Если НЕ РезультатЗаполнения ИЛИ НЕ ЗначениеЗаполнено(ДеревоНастроек) ИЛИ ДеревоНастроек.КоличествоСтрок = 0 Тогда
		ВывестиСообщения(Неопределено, Сообщения, УведомлятьТолькоОбОшибках);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	// определяем адрес электронной почты настраиваемой учетной записи
	Если УчетнаяЗапись = Неопределено Тогда
		АдресУчетнойЗаписи = "";
	Иначе
		АдресУчетнойЗаписи = СокрЛП(ПолучитьРеквизитНаСервере(УчетнаяЗапись, "АдресЭлектроннойПочты"));
	КонецЕсли;
	
	// оставляем только тот узел дерева, который соответствует настраиваемой учетке
	// если настраиваемую учетку определить не удалось, то предлагаем пользователю выбрать
	ДеревоНастроек = ДеревоНастроек.АдресДереваЗначений;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, Сообщения, УведомлятьТолькоОбОшибках, УчетнаяЗапись", ВыполняемоеОповещение, Сообщения, УведомлятьТолькоОбОшибках, УчетнаяЗапись);
	ОписаниеОповещения = Новый ОписаниеОповещения("СформироватьТаблицуИсправленийНаОсновеФайлаНастроекПослеФильтрацииДереваНастроекПоУчетнойЗаписиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОтфильтроватьДеревоНастроекПоУчетнойЗаписи(ДеревоНастроек, АдресУчетнойЗаписи, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьТаблицуИсправленийНаОсновеФайлаНастроекПослеФильтрацииДереваНастроекПоУчетнойЗаписиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Сообщения = ДополнительныеПараметры.Сообщения;
	УведомлятьТолькоОбОшибках = ДополнительныеПараметры.УведомлятьТолькоОбОшибках;
	УчетнаяЗапись = ДополнительныеПараметры.УчетнаяЗапись;
	
	ДеревоНастроек = Результат.ДеревоНастроекАдрес;
	РезультатФильтрации = Результат.РезультатФильтрации;
	
	Если НЕ РезультатФильтрации Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	// формируем "плоский список" настроек
	НастройкиРОКИ = СформироватьСписокНастроекРОКИПоДеревуНастроекXML(ДеревоНастроек, Сообщения);
	Если НЕ ЗначениеЗаполнено(НастройкиРОКИ) Тогда
		ВывестиСообщения(Неопределено, Сообщения, УведомлятьТолькоОбОшибках);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	НастройкиРОКИ.Вставить("СертификатБезопасности", ПолучитьОтпечатокСертификатаБезопасностиРОКИ());
	
	// получаем настройки учетной записи
	НастройкиУчетнойЗаписи = ПолучитьНастройкиУчетнойЗаписиИзИБ(УчетнаяЗапись);
	
	// формируем таблицу исправлений
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, Сообщения, УведомлятьТолькоОбОшибках", ВыполняемоеОповещение, Сообщения, УведомлятьТолькоОбОшибках);
	Оповещение = Новый ОписаниеОповещения("СформироватьТаблицуИсправленийНаОсновеФайлаНастроекПослеПолученияТаблицыНеобходимыхИсправленийЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ПолучитьТаблицуНеобходимыхИсправлений(НастройкиУчетнойЗаписи, НастройкиРОКИ, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьТаблицуИсправленийНаОсновеФайлаНастроекПослеПолученияТаблицыНеобходимыхИсправленийЗавершение(ТаблицаИсправлений, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Сообщения = ДополнительныеПараметры.Сообщения;
	УведомлятьТолькоОбОшибках = ДополнительныеПараметры.УведомлятьТолькоОбОшибках;
	
	// выводим сообщения ,если они есть, и закрываем форму прогресса
	ВывестиСообщения(Неопределено, Сообщения, УведомлятьТолькоОбОшибках);
	
	// возвращаем таблицу с командами настройки
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, ТаблицаИсправлений);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКомментарийМакета()
	
	Возврат ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО().Метаданные().Макеты.СертификатБезопасностиРОКИ.Комментарий;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьОтпечатокСертификатаБезопасностиРОКИ()
	
	// получаем отпечаток сертификата безопасности
	КомментарийМакета = ПолучитьКомментарийМакета();
	ВхождениеДвоеточия = СтрНайти(КомментарийМакета, ":");
	Если ВхождениеДвоеточия = 0 Тогда
		ОтпечатокСертификатаБезопасностиРОКИ = СокрЛП(КомментарийМакета);
	Иначе
		ОтпечатокСертификатаБезопасностиРОКИ = СокрЛП(Сред(КомментарийМакета, ВхождениеДвоеточия + 1));
	КонецЕсли;
	Возврат ОтпечатокСертификатаБезопасностиРОКИ;
	
КонецФункции

&НаКлиенте
Функция СертификатЗарегистрированВХранилище(Отпечаток, Хранилище, МассивСертификатов) Экспорт
	
	Результат = Неопределено;
	Результат = МассивСертификатов.Найти(нрег(СокрЛП(Отпечаток)));
	Возврат Результат <> Неопределено;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ВывестиСообщения(УчетнаяЗапись, Знач Сообщения, УведомлятьТолькоОбОшибках)
	
	Если ЭтоАдресВременногоХранилища(Сообщения) Тогда
		Сообщения = ПолучитьИзВременногоХранилища(Сообщения);
	КонецЕсли;
	
	Если Сообщения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПредставлениеУчетнаяЗапись = ?(ТипЗнч(УчетнаяЗапись) = Тип("СправочникСсылка.УчетныеЗаписиДокументооборота"), " """ + УчетнаяЗапись + """", "");
	
	Если Сообщения.Найти(Истина, "Ошибка") <> Неопределено Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось произвести автоматическую настройку параметров учетной записи %1:';
																						|en = 'Cannot set up the %1 account parameters automatically:'"),
			ПредставлениеУчетнаяЗапись);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	Иначе
		Если НЕ УведомлятьТолькоОбОшибках Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Автоматическая настройка параметров учетной записи %1 успешно завершена:';
																							|en = 'Automatic setting of %1 account parameters completed successfully:'"),
				ПредставлениеУчетнаяЗапись);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		КонецЕсли;
	КонецЕсли;
	
	Для Инд = 1 По Сообщения.Количество() Цикл
		ТекСтр = Сообщения[Инд - 1];
		Если УведомлятьТолькоОбОшибках И НЕ ТекСтр.Ошибка Тогда
			Продолжить;
		КонецЕсли;
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекСтр.Сообщение);
	КонецЦикла;
	
КонецПроцедуры

