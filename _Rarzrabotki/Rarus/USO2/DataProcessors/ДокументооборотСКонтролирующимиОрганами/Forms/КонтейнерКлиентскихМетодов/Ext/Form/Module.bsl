	СтруктураСсылочныхДанных.Вставить("Перечисления_ТипыЗаявленияАбонентаСпецоператораСвязи_Пролонгация", Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Пролонгация);
	
	СтруктураСсылочныхДанных.Вставить("Перечисления_ТипыВладельцевЭЦП_Руководитель", Перечисления.ТипыВладельцевЭЦП.Руководитель);
	СтруктураСсылочныхДанных.Вставить("Перечисления_ТипыВладельцевЭЦП_ГлавныйБухгалтер", Перечисления.ТипыВладельцевЭЦП.ГлавныйБухгалтер);
	СтруктураСсылочныхДанных.Вставить("Перечисления_ТипыВладельцевЭЦП_ДругойСотрудник", Перечисления.ТипыВладельцевЭЦП.ДругойСотрудник);
	
	СтруктураСсылочныхДанных.Вставить("Перечисления_ТипыТранспортныхСообщений_ЗапросНаВыпискуИзЕГРЮЛ_ЕГРИП", Перечисления.ТипыТранспортныхСообщений.ЗапросНаВыпискуЕРГЮЛ_ЕГРИП);
	СтруктураСсылочныхДанных.Вставить("Перечисления_ТипыТранспортныхСообщений_РезультатОбработкиЗапросаНаВыпискуЕГРЮЛ_ЕГРИП", Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗапросаНаВыпискуЕРГЮЛ_ЕГРИП);
	СтруктураСсылочныхДанных.Вставить("Перечисления_ТипыЦикловОбмена_ЗапросНаВыпискуИзЕГРЮЛ_ЕГРИП", Перечисления.ТипыЦикловОбмена.ЗапросНаВыпискуИзЕГРЮЛ_ЕГРИП);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоФорматПриказ534(ЦиклОбмена) Экспорт
	
	Возврат ЦиклОбмена.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСФНС.Приказ534;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьДокументыЦикловОбмена(
		ПечатаемыеЦиклыОбмена, 
		ЭтоПечатьБезВыбораВидаПротоколов = Ложь, 
		ПечатаемыеТранспортныеСообщения = Неопределено, 
		РезультатНастройки = Неопределено) Экспорт
	
	Если ТипЗнч(ПечатаемыеЦиклыОбмена) <> Тип("Массив") Тогда
		ЦиклыОбмена = Новый Массив;
		ЦиклыОбмена.Добавить(ПечатаемыеЦиклыОбмена);
	Иначе
		ЦиклыОбмена = ПечатаемыеЦиклыОбмена;
	КонецЕсли;
	Если ЦиклыОбмена.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не выбраны циклы обмена для печати!");
		Возврат;
	КонецЕсли;
	
	Если ЭтоПечатьБезВыбораВидаПротоколов Тогда
		
		// Печатаем без выбора вида протоколов
		Если ТипЗнч(ПечатаемыеТранспортныеСообщения) <> Тип("Массив") И ПечатаемыеТранспортныеСообщения <> Неопределено Тогда
			ТранспортныеСообщения = Новый Массив;
			ТранспортныеСообщения.Добавить(ПечатаемыеТранспортныеСообщения);
		Иначе
			ТранспортныеСообщения = ПечатаемыеТранспортныеСообщения;
		КонецЕсли;
		
		Если РезультатНастройки = Неопределено Тогда 
			РезультатНастройки = ПротоколыДляПечати(ЦиклыОбмена, ТранспортныеСообщения);
		КонецЕсли;
		 
	 	// Определяем, есть ли протоколы для печати
		ЕстьПротоколыДляПечати = Ложь; 
		Для каждого ВыбранныйПротокол Из РезультатНастройки Цикл
			Если ВыбранныйПротокол.Значение = Истина Тогда
				ЕстьПротоколыДляПечати = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ЕстьПротоколыДляПечати Тогда
			ПредупредитьОбОтсутствииПротокола();
			Возврат;
		КонецЕсли;
		
		Если ТранспортныеСообщения <> Неопределено 
			И ТипЗнч(ТранспортныеСообщения) = Тип("Массив")
			И ТранспортныеСообщения.Количество() = 1 Тогда
			РезультатНастройки.Вставить("ТранспортноеСообщение", ТранспортныеСообщения[0]);
		КонецЕсли;

		СформироватьИПоказатьПротоколы(РезультатНастройки, ЦиклыОбмена);
		 
	Иначе
		// Печатаем с выбором вида протокола
		
		// анализируем формат документооборота
		// для ФНС 534 вызываем отдельную форму настройки
		Если ЭтоФорматПриказ534(ЦиклыОбмена[0]) Тогда 
			
			Оповещение = Новый ОписаниеОповещения("СформироватьИПоказатьПротоколы", ЭтотОбъект, ЦиклыОбмена);
			
			СтруктураПараметров = Новый Структура("ЦиклыОбмена", ЦиклыОбмена);
			ОткрытьФорму(ПутьКОбъекту + ".Форма.НастройкиГрупповойПечати534", СтруктураПараметров,  ,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе
				
			Оповещение = Новый ОписаниеОповещения("СформироватьИПоказатьПротоколы", ЭтотОбъект, ЦиклыОбмена);
			
			СтруктураПараметров = Новый Структура("ЦиклыОбмена", ЦиклыОбмена);
			ОткрытьФорму(ПутьКОбъекту + ".Форма.НастройкиГрупповойПечати", СтруктураПараметров, ,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредупредитьОбОтсутствииПротокола() Экспорт
	
	ТекстПредупреждения = НСтр("ru = 'Просмотр протоколов возможен только после отправки
					|и получения ответа от контролирующих органов';
					|en = 'Protocol can be viewed only after sending 
					|and receiving a response from the regulatory authorities'");
	ПоказатьПредупреждение(,ТекстПредупреждения);
	
КонецПроцедуры


&НаСервере
Функция ПротоколыДляПечати(ЦиклыОбмена = Неопределено, ТранспортныеСообщения = Неопределено) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПротоколыДляПечати(ЦиклыОбмена, ТранспортныеСообщения);

КонецФункции

&НаКлиенте
Процедура СформироватьИПоказатьПротоколы(РезультатНастройки, ЦиклыОбмена) Экспорт
	
	Если РезультатНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоФорматПриказ534(ЦиклыОбмена[0]) Тогда
		РезультатНастройки.Вставить("ФорматДокументооборота", СтруктураСсылочныхДанных["Перечисления_ФорматыДокументооборотаСФНС_Приказ534"]);
	КонецЕсли;
	
	Для Инд = 1 По ЦиклыОбмена.Количество() Цикл
		СформироватьИПоказатьПечатныеДокументы(ЦиклыОбмена[Инд - 1], РезультатНастройки);
		ОбработкаПрерыванияПользователя();
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтчетыОСостоянииЦикловОбмена(ПечатаемыеЦиклыОбмена) Экспорт
	
	Если ТипЗнч(ПечатаемыеЦиклыОбмена) <> Тип("Массив") Тогда
		ЦиклыОбмена = Новый Массив;
		ЦиклыОбмена.Добавить(ПечатаемыеЦиклыОбмена);
	Иначе
		ЦиклыОбмена = ПечатаемыеЦиклыОбмена;
	КонецЕсли;
	
	Для Инд = 1 По ЦиклыОбмена.Количество() Цикл
		СформироватьИПоказатьПечатныеДокументы(ЦиклыОбмена[Инд - 1], Новый Структура("ПечататьСостояние", Истина));
		ОбработкаПрерыванияПользователя();
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИПоказатьПечатныеДокументы(ЦиклОбмена, Настройки) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЦиклОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ЦиклОбмена", ЦиклОбмена);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"СформироватьИПоказатьПечатныеДокументыПослеПолученияПечатныхДокументов",
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	// Настройки дополняем недостающими свойствами
	ДополнитьНастройкиПечати(Настройки);
	
	СформироватьПечатныеДокументы(ЦиклОбмена, Настройки, ОписаниеОповещения);
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьНастройкиПечати(Настройки) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	КонтекстЭДОСервер.ДополнитьНастройкиПечати(Настройки);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИПоказатьПечатныеДокументыПослеПолученияПечатныхДокументов(ПечатныеДокументы, ВходящийКонтекст) Экспорт
	
	Если ПечатныеДокументы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	#Если ВебКлиент Тогда
		ЭтоВебКлиент = Истина;
	#Иначе
		ЭтоВебКлиент = Ложь;
	#КонецЕсли
	
	ЦиклОбмена = ВходящийКонтекст.ЦиклОбмена;
	
	НачальноеЗначениеВыбора = Новый Структура("ЦиклОбмена, ПечатныеДокументы, ЭтоВебКлиент", 
		ЦиклОбмена, ПечатныеДокументы, ЭтоВебКлиент);
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ПредварительныйПросмотрПечатныхФорм", НачальноеЗначениеВыбора,,Новый УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРеквизитНаСервере(ОбъектДляЧтения, ИмяРеквизита) Экспорт
	МетаданныеОбъекта = ОбъектДляЧтения.Метаданные();
	Если МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда 
		Возврат ОбъектДляЧтения[ИмяРеквизита];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

&НаСервере
Процедура ПоместитьПодписиВТаблицу()

	// помещаем подписи абонента в результирующую таблицу
	Если ЗначениеЗаполнено(ПодписиАбонента) Тогда
		Для Каждого ПодписьАбонента Из ПодписиАбонента Цикл
			
			Если ТаблицаПодписей.НайтиСтроки(Новый Структура("Файл", ПодписьАбонента.Файл)).Количество() = 0 Тогда
				
				НовСтр = ТаблицаПодписей.Добавить();
				НовСтр.ИмяФайла = ПодписьАбонента.ИмяФайла;
				НовСтр.Файл     = ПодписьАбонента.Файл;
				НовСтр.ТранспортноеСообщение = ПодписьАбонента.ТранспортноеСообщение;
				НовСтр.ЭЦПЭтоПодписьАбонента = Истина;
				
				Отправитель = ПолучитьРеквизит(ПодписьАбонента.ТранспортноеСообщение, "Отправитель");
				ОтправительЭтоАбонент = ТипЗнч(Отправитель) = Тип("СправочникСсылка.Организации");
				
				Если ОтправительЭтоАбонент Тогда
					НовСтр.Порядок = 1;
				Иначе
					НовСтр.Порядок = 2;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// помещаем подписи контрагента в результирующую таблицу
	Если ЗначениеЗаполнено(ПодписиКонтрагента) Тогда
			
		Для Каждого ПодписьКонтрагента Из ПодписиКонтрагента Цикл
			Если ТаблицаПодписей.НайтиСтроки(Новый Структура("Файл", ПодписьКонтрагента.Файл)).Количество() = 0 Тогда
				
				НовСтр = ТаблицаПодписей.Добавить();
				НовСтр.ИмяФайла = ПодписьКонтрагента.ИмяФайла;
				НовСтр.Файл     = ПодписьКонтрагента.Файл;
				НовСтр.ТранспортноеСообщение = ПодписьКонтрагента.ТранспортноеСообщение;
				НовСтр.ЭЦПЭтоПодписьАбонента = Ложь;
				
				Отправитель = ПолучитьРеквизит(ПодписьКонтрагента.ТранспортноеСообщение, "Отправитель");
				ОтправительЭтоНеАбонент = ТипЗнч(Отправитель) <> Тип("СправочникСсылка.Организации");
				
				Если ОтправительЭтоНеАбонент Тогда
					НовСтр.Порядок = 1;
				Иначе
					НовСтр.Порядок = 2;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаПодписей.Сортировать("ТранспортноеСообщение, Порядок");

КонецПроцедуры
               
&НаСервереБезКонтекста
Функция ПолучитьСведенияДоверенности(РегистрацияВИФНС, Организация = Неопределено)
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПолучитьСведенияДоверенности(РегистрацияВИФНС, Организация);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьФИОДоверенности(Доверенность, ТипСубъекта)
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПолучитьФИОДоверенности(Доверенность, ТипСубъекта);
	
КонецФункции

&НаСервереБезКонтекста
Функция УчетнаяЗаписьОрганизации(Организация) Экспорт
	
	Возврат ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.УчетнаяЗаписьОрганизации(Организация);
	
КонецФункции

&НаСервереБезКонтекста
Функция НастройкиУчетнойЗаписиОрганизации(Организация) Экспорт
	
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если УчетнаяЗапись = Неопределено ИЛИ УчетнаяЗапись = Справочники.УчетныеЗаписиДокументооборота.ПустаяСсылка() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолучитьНастройкиУчетнойЗаписиИзИБ(УчетнаяЗапись);
	
КонецФункции

&НаСервереБезКонтекста
Процедура ИзвлечьЭлектронноеПредставлениеИзХранилища(Владелец, ИмяФайла, Данные, ВозможныеТипыФайла = Неопределено) Экспорт
	
	ТипыПриложенийБО = Новый Массив;
	ТипыПриложенийБО.Добавить(Перечисления.ТипыФайловБухОтчетности.АудиторскоеЗаключение);
	ТипыПриложенийБО.Добавить(Перечисления.ТипыФайловБухОтчетности.ЗаявлениеСоюзаСельхозПроизводителей);
	ТипыПриложенийБО.Добавить(Перечисления.ТипыФайловБухОтчетности.ПояснительнаяЗаписка);
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                      |	ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ИмяФайла,
	                      |	ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.Данные
						  |	, ВЫБОР
						  |		КОГДА СостояниеОбъектов.Архивный ЕСТЬ NULL ТОГДА Ложь
						  |		КОГДА СостояниеОбъектов.Архивный = Ложь ТОГДА Ложь
						  |	ИНАЧЕ
						  |		Истина
						  |	КОНЕЦ ВАрхиве
	                      |ИЗ
	                      |	РегистрСведений.ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов КАК ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов
						  |
						  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
						  |			ПО 		(СостояниеОбъектов.Объект = ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ЭлектронноеПредставление)
						  |				И	(СостояниеОбъектов.ИмяФайла = ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ИмяФайла)
						  |				И	(СостояниеОбъектов.Владелец = Значение(Перечисление.ВидыАрхивируемыхМетаданныхДО.ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов))
						  |
	                      |ГДЕ
	                      |	ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ЭлектронноеПредставление = &ЭлектронноеПредставление
	                      |	И НЕ (ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ТипФайлаОтчетности В(&ТипыПриложенийБО))");
	Запрос.УстановитьПараметр("ТипыПриложенийБО", ТипыПриложенийБО);
	Если ЗначениеЗаполнено(ВозможныеТипыФайла) Тогда
		Запрос.Текст = Запрос.Текст + "
	                      |	И ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ТипФайлаОтчетности В (&ВозможныеТипыФайла)";
		Запрос.УстановитьПараметр("ВозможныеТипыФайла", ВозможныеТипыФайла);
	КонецЕсли;
	Запрос.УстановитьПараметр("ЭлектронноеПредставление", Владелец);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			ИмяФайла = СокрЛП(Выборка.ИмяФайла);
			Если Выборка.ВАрхиве Тогда
				Данные = Неопределено;
				Возврат;
			КонецЕсли;
			Данные = Выборка.Данные;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ИмяФайла = "";
	Данные = Неопределено;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИзвлечьЭлектронныеПредставленияИзХранилища(Владелец, Знач ЛимитЗаписей = 0) Экспорт
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("ИмяФайла");
	ТаблицаРезультат.Колонки.Добавить("Данные");
	ТаблицаРезультат.Колонки.Добавить("ТипФайлаОтчетности");
	ТаблицаРезультат.Колонки.Добавить("ВАрхиве");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ //$Ограничение
	                      |	ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ИмяФайла,
	                      |	ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ТипФайлаОтчетности
						  |	, ВЫБОР
						  |		КОГДА СостояниеОбъектов.Архивный ЕСТЬ NULL ТОГДА Ложь
						  |		КОГДА СостояниеОбъектов.Архивный = Ложь ТОГДА Ложь
						  |	ИНАЧЕ
						  |		Истина
						  |	КОНЕЦ ВАрхиве
	                      |ИЗ
	                      |	РегистрСведений.ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов КАК ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов
						  |
						  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
						  |			ПО 		(СостояниеОбъектов.Объект = ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ЭлектронноеПредставление)
						  |				И	(СостояниеОбъектов.ИмяФайла = ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ИмяФайла)
						  |				И	(СостояниеОбъектов.Владелец = Значение(Перечисление.ВидыАрхивируемыхМетаданныхДО.ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов))
						  |
	                      |ГДЕ
	                      |	ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ЭлектронноеПредставление = &ЭлектронноеПредставление";
	
	Если ЛимитЗаписей > 0 Тогда
		ТекстОграничения = "ПЕРВЫЕ " + СокрЛП(Формат(ЛимитЗаписей, "ЧДЦ=; ЧН=; ЧГ="));
	Иначе
		ТекстОграничения = "";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "//$Ограничение", ТекстОграничения);	 
	
	Запрос.УстановитьПараметр("ЭлектронноеПредставление", Владелец);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаРезультат.Добавить();
			НоваяСтрока.ИмяФайла 			= Выборка.ИмяФайла;
			НоваяСтрока.ТипФайлаОтчетности 	= Выборка.ТипФайлаОтчетности;
			НоваяСтрока.ВАрхиве 			= Выборка.ВАрхиве;
			Если Выборка.ВАрхиве Тогда
				НоваяСтрока.Данные 			= Base64Значение("");
			Иначе
				НоваяСтрока.Данные 			= ДанныеОдногоФайлаЭлектронногоПредставления(Владелец, Выборка.ИмяФайла);
			КонецЕсли;
		КонецЦикла;
		
		Возврат ТаблицаРезультат;
		
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура НараститьСчетчикВИмениФайлаВыгрузкиПриНеобходимости(ИмяФайла, Организация, ДатаОкончанияПериода, КодНО)

	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	КонтекстЭДОСервер.НараститьСчетчикВИмениФайлаВыгрузкиПриНеобходимости(ИмяФайла, Организация, ДатаОкончанияПериода, КодНО);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИзвлечьЭлектронноеПредставлениеИзХранилищаИНараститьСчетчикПриНеобходимости(Контекст, ТекстВыгрузки, ИмяФайлаВыгрузки)
	
	// готовим массив возможных типов файлов
	ВозможныеТипыФайлов = Новый Массив;
	ВозможныеТипыФайлов.Добавить(Неопределено);
	ВозможныеТипыФайлов.Добавить(Перечисления.ТипыФайловБухОтчетности.ОсновнойФайлОтчетности);
	ВозможныеТипыФайлов.Добавить(Перечисления.ТипыФайловБухОтчетности.ПустаяСсылка());
	
	// получаем электронное представление
	ХранилищеВыгрузки = "";
	ИмяФайлаВыгрузки = "";
	ИзвлечьЭлектронноеПредставлениеИзХранилища(Контекст.Документ, ИмяФайлаВыгрузки, ХранилищеВыгрузки, ВозможныеТипыФайлов);
	Если ИмяФайлаВыгрузки = "" ИЛИ ХранилищеВыгрузки = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не обнаружена информация для отправки!';
								|en = 'Information for sending is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// пишем электронное представление в файл
	ВремФайл = ПолучитьИмяВременногоФайла();
	ХранилищеВыгрузки.Получить().Записать(ВремФайл);
	ОбъектЧтениеТекста = Новый ЧтениеТекста(ВремФайл, ?(нрег(Прав(ИмяФайлаВыгрузки, 4)) = ".xml", "windows-1251", "cp866"));
	ТекстВыгрузки = ОбъектЧтениеТекста.Прочитать();
	ОбъектЧтениеТекста.Закрыть();
	УдалитьФайлы(ВремФайл);
	
	// наращиваем счетчики в имени файла выгрузки и в содержимом
	НараститьСчетчикДокументовПриНеобходимости(ТекстВыгрузки, ИмяФайлаВыгрузки, Контекст.Организация, Контекст.ДатаОкончанияПериодаОтчета);
	НараститьСчетчикВИмениФайлаВыгрузкиПриНеобходимости(ИмяФайлаВыгрузки, Контекст.Организация, Контекст.Документ.ДатаОкончания, Контекст.КодНалоговогоОргана);
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ИзвлечьЭлектронноеПредставлениеФСГСИзХранилища(Контекст, ТекстВыгрузки, ИмяФайлаВыгрузки, КодировкаФайла = Неопределено)
	
	// получаем электронное представление
	ХранилищеВыгрузки = "";
	ИмяФайлаВыгрузки = "";
	ИзвлечьЭлектронноеПредставлениеИзХранилища(Контекст.Документ, ИмяФайлаВыгрузки, ХранилищеВыгрузки);
	Если ИмяФайлаВыгрузки = "" ИЛИ ХранилищеВыгрузки = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не обнаружена информация для отправки!';
								|en = 'Information for sending is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// пишем электронное представление в файл
	ВремФайл = ПолучитьИмяВременногоФайла();
	ДанныеПредставления = ХранилищеВыгрузки.Получить();
	ДанныеПредставления.Записать(ВремФайл);
	
	Если СтрНайти(ИмяФайлаВыгрузки, "NO_BUH") = 1 ИЛИ СтрНайти(ИмяФайлаВыгрузки, "NO_BOUPR") = 1 ИЛИ СтрНайти(ИмяФайлаВыгрузки, "NO_BOUCH") = 1 Тогда
		КодировкаФайла = "windows-1251";
	Иначе
		КодировкаФайла = ОпределитьКодировку(ДанныеПредставления);
	КонецЕсли;
	ОбъектЧтениеТекста = Новый ЧтениеТекста(ВремФайл, КодировкаФайла);
	ТекстВыгрузки = ОбъектЧтениеТекста.Прочитать();
	ОбъектЧтениеТекста.Закрыть();
	УдалитьФайлы(ВремФайл);
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Процедура НараститьСчетчикДокументовПриНеобходимости(ТекстВыгрузки, ИмяФайла, Организация, ДатаОкончанияПериода)
	
	РасширениеСТочкой = нрег(Прав(ИмяФайла, 4));
	Если РасширениеСТочкой = ".xml" Тогда
		Возврат;
	КонецЕсли;
	
	КлючеваяФраза = Символы.ПС + "ИдДок:";
	Для Стр = 1 По СтрЧислоСтрок(ТекстВыгрузки) Цикл
		ТекСтр = СтрПолучитьСтроку(ТекстВыгрузки, Стр);
		Если Лев(ТекСтр, 6) <> "ИдДок:" Тогда
			Продолжить;
		КонецЕсли;
		СчетчикДокументов = РегламентированнаяОтчетность.ПолучитьСчетчикВыгруженныхДокументов(Организация, ДатаОкончанияПериода) + 1;
		ЭтоАлко = (СтрНайти(ТекстВыгрузки, Символы.ПС + "ТипИнф:11520") <> 0);
		Если ЭтоАлко Тогда
			НовСтр = Лев(ТекСтр,СтрДлина(ТекСтр) - 4) + Прав(Формат(СчетчикДокументов, "ЧДЦ=0; ЧВН=; ЧГ=0"), 2) + Прав(ТекСтр, 2);
		Иначе
			НовСтр = Лев(ТекСтр,СтрДлина(ТекСтр) - 8) + Формат(СчетчикДокументов, "ЧЦ=8; ЧВН=; ЧГ=0");
		КонецЕсли;
		ТекстВыгрузки = СтрЗаменить(ТекстВыгрузки, Символы.ПС + ТекСтр, Символы.ПС + НовСтр);
		РегламентированнаяОтчетность.УстановитьСчетчикВыгруженныхДокументов(Организация, СчетчикДокументов, ДатаОкончанияПериода);
		Прервать;
	КонецЦикла;
		
КонецПроцедуры

&НаСервереБезКонтекста
