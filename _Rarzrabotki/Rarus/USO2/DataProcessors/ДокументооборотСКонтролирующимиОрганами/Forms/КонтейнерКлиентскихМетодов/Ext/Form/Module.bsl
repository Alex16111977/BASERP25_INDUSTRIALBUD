		ДополнительныеПараметры.Вставить("ИдентификаторДокументооборота", ИдентификаторДокументооборота);
		ДополнительныеПараметры.Вставить("ДанныеСертификатаОтправителя", ДанныеСертификатаОтправителя);
		Оповещение = Новый ОписаниеОповещения("ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрованиеПослеПолученияИзИнтернетаСертификатаСервераОнлайнПроверкиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ПолучитьИзИнтернетЗарегистрироватьИПроверитьСертификатСервераОнлайнПроверки(Контекст, Оповещение);
		
