&НаКлиенте
Функция ТекущаяСтрокаВыбрана(Таблица,ТекСтрока,Действие) Экспорт
	СтрокаНЕВыбрана = Ложь;
	
	Если Таблица.Количество() > 0 И ТекСтрока <> Неопределено Тогда
		Возврат Истина;
	ИначеЕсли Таблица.Количество() > 0 И ТекСтрока = Неопределено Тогда
		СтрокаНЕВыбрана = Истина;
	ИначеЕсли Таблица.Количество() = 0 И ТекСтрока = Неопределено Тогда
		СтрокаНЕВыбрана = Истина;
	КонецЕсли;
	
	Если СтрокаНЕВыбрана Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не выбрана строка для %1';
																														|en = 'Line for %1 is not selected'"),Действие), ,"Таблица");
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции
        
&НаСервереБезКонтекста
Процедура ПодготовитьДанныеАдреса(СтруктураАдресаРегион,ПредставлениеАдрес)
	СтруктураАдресаРегион = РегламентированнаяОтчетностьВызовСервера.ПолучитьНазваниеРегионаПоКоду(СтруктураАдресаРегион);
	ПредставлениеАдрес = РегламентированнаяОтчетностьКлиентСервер.ПредставлениеАдресаВФормате9Запятых(ПредставлениеАдрес,Истина);
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьАдрес(ДополнительныеПараметры) Экспорт
	
	Адрес             = ДополнительныеПараметры.Адрес;
	АдресИмя          = ДополнительныеПараметры.АдресИмя;
	Элемент           = ДополнительныеПараметры.Элемент;
	Оповещение        = ДополнительныеПараметры.Оповещение;
	ПринудительноФИАС = ДополнительныеПараметры.ПринудительноФИАС;
	ТолькоПросмотр    = ДополнительныеПараметры.ТолькоПросмотр;

	ЭтоАдресПоФИАСу = УправлениеКонтактнойИнформациейКлиентСервер.ЭтоКонтактнаяИнформацияВXML(Адрес);
	
	АдресИмяПредставление = ?(АдресИмя = "АдресЮридический","Адрес юридический","Адрес фактический");
	
	ВидАдреса = ?(АдресИмя = "АдресЮридический", 
		ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ЮрАдресОрганизации"), 
		ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ФактАдресОрганизации"));
	
	Если ЭтоАдресПоФИАСу ИЛИ ПринудительноФИАС Тогда
		
		ПараметрыФормы = УправлениеКонтактнойИнформациейКлиент.ПараметрыФормыКонтактнойИнформации(ВидАдреса, Адрес);
		ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
		
		УправлениеКонтактнойИнформациейКлиент.ОткрытьФормуКонтактнойИнформации(ПараметрыФормы, , Оповещение);
			
	Иначе
		
		ЗначенияПолей   = Новый СписокЗначений;
		СтруктураАдреса = РегламентированнаяОтчетностьКлиентСервер.РазложитьАдрес(Адрес);
		
		ПредставлениеАдрес = Адрес;
		СтруктураАдресаРегион = СтруктураАдреса.Регион;
		ПодготовитьДанныеАдреса(СтруктураАдресаРегион, ПредставлениеАдрес);

		Если НЕ СтруктураАдреса = Неопределено Тогда
			
			КодСтраны = "";
			НазваниеСтраны = "";
			СтруктураАдреса.Свойство("Страна", КодСтраны);
			
			Если ЗначениеЗаполнено(КодСтраны) Тогда
				НазваниеСтраны = ОпределитьНазваниеСтраны(КодСтраны);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НазваниеСтраны) Тогда
				НазваниеСтраны = "РОССИЯ";
			КонецЕсли;
			
			ЗначенияПолей.Добавить(НазваниеСтраны,"Страна");
			ЗначенияПолей.Добавить(СтруктураАдреса.Индекс,"Индекс");
			ЗначенияПолей.Добавить(СтруктураАдресаРегион,"Регион");
			ЗначенияПолей.Добавить(СтруктураАдреса.Район,"Район");
			ЗначенияПолей.Добавить(СтруктураАдреса.Город,"Город");
			ЗначенияПолей.Добавить(СтруктураАдреса.НаселенныйПункт,"НаселенныйПункт");
			ЗначенияПолей.Добавить(СтруктураАдреса.Улица,"Улица");
			ЗначенияПолей.Добавить(СтруктураАдреса.Дом,"Дом");
			ЗначенияПолей.Добавить(СтруктураАдреса.Корпус,"Корпус");
			ЗначенияПолей.Добавить(СтруктураАдреса.Квартира,"Квартира");
			ЗначенияПолей.Добавить(СтруктураАдреса.ТипДома,"ТипДома");
			ЗначенияПолей.Добавить(СтруктураАдреса.ТипКвартиры,"ТипКвартиры");
			ЗначенияПолей.Добавить(СтруктураАдреса.ТипКорпуса,"ТипКорпуса");
			ЗначенияПолей.Добавить(АдресИмяПредставление,"НаименованиеВида");
			
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Заголовок",				АдресИмяПредставление);
		ПараметрыФормы.Вставить("ЗначенияПолей",			ЗначенияПолей);
		ПараметрыФормы.Вставить("Представление",			ПредставлениеАдрес);
		ПараметрыФормы.Вставить("ВидКонтактнойИнформации",	ВидАдреса);
		ПараметрыФормы.Вставить("ТолькоПросмотр", 			ТолькоПросмотр);
		
		УправлениеКонтактнойИнформациейКлиент.ОткрытьФормуКонтактнойИнформации(ПараметрыФормы, , Оповещение);

	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеАдресаИзДанныхОрганизации(Адрес) Экспорт

	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПредставлениеАдресаИзДанныхОрганизации(Адрес);

КонецФункции

&НаКлиенте
Функция РедактироватьАдресКонвертацияРезультата(Результат, ПринудительноФИАС = Ложь) Экспорт
	
	НовыйАдрес = Новый Структура();
	НовыйАдрес.Вставить("Модифицированность",Ложь);
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		ЭтоАдресПоФИАСу = УправлениеКонтактнойИнформациейКлиентСервер.ЭтоКонтактнаяИнформацияВXML(Результат.КонтактнаяИнформация);

		Если ЭтоАдресПоФИАСу ИЛИ ПринудительноФИАС Тогда
			
			Адрес = Результат.КонтактнаяИнформация;
			АдресПредставление = ПредставлениеАдресаИзДанныхОрганизации(Адрес);
			
			НовыйАдрес.Вставить("Модифицированность",	Истина);
			НовыйАдрес.Вставить("Адрес", 				Адрес);
			НовыйАдрес.Вставить("АдресПредставление",	АдресПредставление);
			
		Иначе
			
			РоссийскийАдрес = Новый Соответствие;
			
			РоссийскийАдрес.Вставить("Индекс","");
			РоссийскийАдрес.Вставить("Регион","");
			РоссийскийАдрес.Вставить("Район","");
			РоссийскийАдрес.Вставить("Город","");
			РоссийскийАдрес.Вставить("НаселенныйПункт","");
			РоссийскийАдрес.Вставить("Улица","");
			РоссийскийАдрес.Вставить("Дом","");
			РоссийскийАдрес.Вставить("Корпус","");
			РоссийскийАдрес.Вставить("Квартира","");
			РоссийскийАдрес.Вставить("ТипДома", "");
			РоссийскийАдрес.Вставить("ТипКорпуса", "");
			РоссийскийАдрес.Вставить("ТипКвартиры", "");
			
			РегламентированнаяОтчетностьВызовСервера.СформироватьАдрес(Результат.КонтактнаяИнформация, РоссийскийАдрес);
			
			Адрес = "643,"
			+ РоссийскийАдрес["Индекс"] + ","
			+ РоссийскийАдрес["Регион"] + ","
			+ РоссийскийАдрес["Район"] + ","
			+ РоссийскийАдрес["Город"] + ","
			+ РоссийскийАдрес["НаселенныйПункт"] + ","
			+ РоссийскийАдрес["Улица"] + ","
			+ РоссийскийАдрес["Дом"] + ","
			+ РоссийскийАдрес["Корпус"] + ","
			+ РоссийскийАдрес["Квартира"] + ","
			+ РоссийскийАдрес["ТипДома"] + ","
			+ РоссийскийАдрес["ТипКорпуса"] + ","
			+ РоссийскийАдрес["ТипКвартиры"];
			
			Если Адрес = "643,,,,,,,,," Тогда
				Адрес = "";
			КонецЕсли;
			
			АдресПредставление = РегламентированнаяОтчетностьКлиентСервер.ПредставлениеАдресаВФормате9Запятых(Адрес);
			Адрес = РегламентированнаяОтчетностьВызовСервера.ЗаменитьТекстРегионаНаКодРегиона(Адрес);
			
			НовыйАдрес.Вставить("Модифицированность",	Истина);
			НовыйАдрес.Вставить("Адрес", 				Адрес);
			НовыйАдрес.Вставить("АдресПредставление",	АдресПредставление);
			
		КонецЕсли;

	КонецЕсли;
	
	Возврат НовыйАдрес;
	
КонецФункции

&НаКлиенте
Функция ПолучитьВидИсполнителя(ДанныеОрганизации,Организация) Экспорт
	
	ВыборБухгалтера		= 0;
	ВыборДиректора		= 0;
	ВыборИсполнителя	= 0;
	
	ФИОБух = НЕ ПустаяСтрока(ДанныеОрганизации.ФИОБух);
	ФИОРук = НЕ ПустаяСтрока(ДанныеОрганизации.ФИОРук);
	
	Если ФИОБух Тогда
		ВыборБухгалтера		= 1;
		ВыборДиректора		= 0;
		ВыборИсполнителя	= 0;
	КонецЕсли;
	
	Если ФИОРук Тогда
		ВыборБухгалтера		= 0;
		ВыборДиректора		= 1;
		ВыборИсполнителя	= 0;
	КонецЕсли;
	
	Возврат Новый Структура("ВыборБухгалтера,ВыборДиректора,ВыборИсполнителя,ФИОБух,ФИОРук",ВыборБухгалтера,ВыборДиректора,ВыборИсполнителя,НЕ ФИОБух,НЕ ФИОРук);
	
КонецФункции

&НаСервереБезКонтекста 
Функция ПроверитьТребованиеУчетнойЗаписи(Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаявлениеАбонентаСпецоператораСвязи.УчетнаяЗапись КАК УчетнаяЗапись
	|ИЗ
	|	Документ.ЗаявлениеАбонентаСпецоператораСвязи КАК ЗаявлениеАбонентаСпецоператораСвязи
	|ГДЕ
	|	ЗаявлениеАбонентаСпецоператораСвязи.Организация = &Организация
	|	И ЗаявлениеАбонентаСпецоператораСвязи.УчетнаяЗапись <> ЗНАЧЕНИЕ(Справочник.УчетныеЗаписиДокументооборота.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Попытка
		
		Результат = Запрос.Выполнить().Выгрузить();
		
		Если Результат.Количество() = 0 Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	Исключение Возврат Истина; КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСпецоператорыСвязи(СпецоператорыСвязи = Неопределено,Макет = Неопределено) Экспорт
	
	Если СпецоператорыСвязи = Неопределено Тогда
		СпецоператорыСвязи = ПолучитьСпецоператоровСвязи();
	КонецЕсли;
	
	Массив = Новый Массив();
	
	Если СпецоператорыСвязи <> Неопределено Тогда
		
		Для Каждого СпецоператорСвязи Из СпецоператорыСвязи Цикл 
			
			СтруктураПараметра = Новый Структура("ВебСервисПризнак");
			
			Значение = ПолучитьПараметрСпецоператораКлиент(Спецоператорсвязи,СтруктураПараметра,Макет).ВебСервисПризнак;
			
			Если Значение <> Неопределено И Значение Тогда
				Массив.Добавить(Спецоператорсвязи.Ссылка);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Массив
	
КонецФункции

&НаКлиенте
Функция ПолучитьЗначенияСпецОператора(СтруктураДанныхСпецоператорыСвязи,Спецоператор)
	ЗначенияСпецОператора = Неопределено;
	Для Каждого СпецОператорСтрока Из СтруктураДанныхСпецоператорыСвязи.СпецоператорыСвязи Цикл
		Если СпецОператорСтрока.Ссылка = Спецоператор Тогда
			ЗначенияСпецОператора = СпецОператорСтрока;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ЗначенияСпецОператора;
КонецФункции

&НаКлиенте
Функция ЗаменитьЭлементыВСоглашении(СтруктураДанныхСпецоператорыСвязи,СпецОператор = Неопределено) Экспорт 
	
	СпецоператорСвязи = ПолучитьЗначенияСпецОператора(СтруктураДанныхСпецоператорыСвязи,СпецОператор);
	
	Если СпецоператорСвязи = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстДляЗамены = Строка(СтруктураДанныхСпецоператорыСвязи.ТекстМакетаСоглашение);
	
	СтруктураПараметра = Новый Структура("НаименованиеУЦ,АдресРегламентУЦ,СетьДоверенныхУЦ,СуммаОтветственностиУЦ,НаименованиеПОРаспространяемогоУЦ");
	
	ПараметрыСпецоператора = ПолучитьПараметрСпецоператораКлиент(СпецоператорСвязи,СтруктураПараметра,СтруктураДанныхСпецоператорыСвязи.Макет);
	
	ТекстДляЗамены = СтрЗаменить(ТекстДляЗамены,"#НаименованиеУЦ#",ПараметрыСпецоператора.НаименованиеУЦ);
	ТекстДляЗамены = СтрЗаменить(ТекстДляЗамены,"#АдресРегламентУЦ#",ПараметрыСпецоператора.АдресРегламентУЦ);
	ТекстДляЗамены = СтрЗаменить(ТекстДляЗамены,"#СетьДоверенныхУЦ#",ПараметрыСпецоператора.СетьДоверенныхУЦ);
	ТекстДляЗамены = СтрЗаменить(ТекстДляЗамены,"#СуммаОтветственностиУЦ#",ПараметрыСпецоператора.СуммаОтветственностиУЦ);
	ТекстДляЗамены = СтрЗаменить(ТекстДляЗамены,"#НаименованиеПОРаспространяемогоУЦ#",ПараметрыСпецоператора.НаименованиеПОРаспространяемогоУЦ);
	
	Возврат ТекстДляЗамены;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьСтраницуУЦНажатие(Спецоператор) Экспорт 
	Если НЕ ЗначениеЗаполнено(Спецоператор) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Сначала укажите удостоверяющий центр.';
																|en = 'Specify a certification authority first.'"));
	Иначе
		СтруктураПараметра = Новый Структура("АдресВебСтраницы");
		АдресСтраницы = ПолучитьПараметрСпецоператораКлиент(Спецоператор,СтруктураПараметра).АдресВебСтраницы;
		ОбщегоНазначенияКлиент.ОткрытьНавигационнуюСсылку(АдресСтраницы);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьТипИсполнителя(Тип) Экспорт
	
	Если Тип = СтруктураСсылочныхДанных.Перечисления_ТипыВладельцевЭЦП_Руководитель Тогда
		ТипИсполнителя = 1;
	ИначеЕсли Тип = СтруктураСсылочныхДанных.Перечисления_ТипыВладельцевЭЦП_ГлавныйБухгалтер Тогда
		ТипИсполнителя = 2;
	ИначеЕсли Тип = СтруктураСсылочныхДанных.Перечисления_ТипыВладельцевЭЦП_ДругойСотрудник Тогда
		ТипИсполнителя = 3;
	Иначе
		ТипИсполнителя = 0;
	КонецЕсли;
	
	Возврат ТипИсполнителя;
КонецФункции

&НаКлиенте
Функция ПолучитьТипВладельцаЭЦП(Тип) Экспорт
	
	Если Тип = 1 Тогда
		ТипИсполнителя = СтруктураСсылочныхДанных.Перечисления_ТипыВладельцевЭЦП_Руководитель;
	ИначеЕсли Тип = 2 Тогда
		ТипИсполнителя = СтруктураСсылочныхДанных.Перечисления_ТипыВладельцевЭЦП_ГлавныйБухгалтер;
	Иначе
		ТипИсполнителя =СтруктураСсылочныхДанных.Перечисления_ТипыВладельцевЭЦП_ДругойСотрудник;
	КонецЕсли;
	
	Возврат ТипИсполнителя;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ОбновитьРегистрыСведенийНастройкиОбменаФСС(
		Организация,
		ОтпечатокСертификата,
		СертификатФССОтпечаток,
		СертификатФССЭЛНОтпечаток,
		ВыводитьСообщения)
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	КонтекстЭДОСервер.ОбновитьРегистрыСведенийНастройкиОбменаФСС(
		Организация,
		ОтпечатокСертификата,
		СертификатФССОтпечаток,
		СертификатФССЭЛНОтпечаток,
		ВыводитьСообщения);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСпецоператоровСвязи()
	
	Запрос = Новый Запрос;
	Массив = Новый Массив();
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СпецоператорыСвязи.Ссылка
	|ИЗ
	|	Перечисление.СпецоператорыСвязи КАК СпецоператорыСвязи";
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			СпецоператорыСвязи = Выборка.Ссылка;
			ИмяСпецоператора = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьИмяЗначенияПеречисленияСпецоператорыСвязиПоСинониму(СпецоператорыСвязи);
			Массив.Добавить(Новый Структура("Ссылка,Имя", СпецоператорыСвязи, ИмяСпецоператора));
		КонецЦикла;
	Исключение
		Массив = Неопределено;
	КонецПопытки;
	
	Возврат Массив;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьДопКодФСС(ДопКодФСС,Реквизит,ДоступностьВидимость,КодФСС,ТолькоПросмотр = Ложь) Экспорт
	
	Реквизит.Видимость = ДоступностьВидимость;
	
	Реквизит.ТолькоПросмотр = ?(ТолькоПросмотр ИЛИ НЕ ПустаяСтрока(ДопКодФСС), Истина, Ложь);
	
	Если ДоступностьВидимость И ПустаяСтрока(ДопКодФСС) И НЕ ПустаяСтрока(КодФСС) Тогда
		ОтметкаНезаполненного = Истина;
	Иначе
		ОтметкаНезаполненного = Ложь;
	КонецЕсли;
	
	Реквизит.АвтоОтметкаНезаполненного = ОтметкаНезаполненного;
	Реквизит.ОтметкаНезаполненного = ОтметкаНезаполненного; 

КонецПроцедуры

