	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СертификатПолучателя.Сертификат) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка получения свойств сертификата сервера онлайн-проверки!
									|Вероятно, сертификат не зарегистрирован в системе.';
									|en = 'An error occurred while receiving properties of online check server certificate. 
									|The certificate may not be registered in the system.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	СертификатBase64 = ХранилищеЗначенияВВидеСтроки(СертификатПолучателя.Сертификат);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
