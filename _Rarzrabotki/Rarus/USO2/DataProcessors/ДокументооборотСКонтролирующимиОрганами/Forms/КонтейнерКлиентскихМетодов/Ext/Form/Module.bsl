&НаСервере
Функция ПоддерживаетсяВторичноеЗаявление(Организация) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	ПоддерживаетсяВторичноеЗаявление = КонтекстЭДОСервер.ПоддерживаетсяВторичноеЗаявление(Организация);
	
	Возврат ПоддерживаетсяВторичноеЗаявление;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьФормуПредупрежденияОбИзменившихсяНастройкахПодключения(Организация, ФормаВладельца) Экспорт
	
	// Проверка наличия учетной записи
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) ИЛИ НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	// Если форма мастера открыта, то не выводим предупреждения
	Если НЕ ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ФормаОткрыта("ФормаПредупрежденияОСменеЗначенияПараметраПодключения")
		И НЕ ФормаОповещенияИлиМастераУжеОткрыта() Тогда
		
		СтруктураПараметровОткрытияФормы = Новый Структура();
		СтруктураПараметровОткрытияФормы.Вставить("Организация", Организация);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПоказатьФормуПредупрежденияОбИзменившихсяНастройкахПодключенияЗавершение", ЭтотОбъект, СтруктураПараметровОткрытияФормы);
		
		ВладелецПредупреждения = Неопределено;
		Если ТипЗнч(ФормаВладельца) = Тип("УправляемаяФорма") Тогда
			ВладелецПредупреждения = ФормаВладельца.ВладелецФормы;
		КонецЕсли;
			
		// Вызов окна предупреждения
		ОткрытьФорму(ПутьКОбъекту + ".Форма.ФормаПредупрежденияОСменеЗначенияПараметраПодключения", СтруктураПараметровОткрытияФормы, ВладелецПредупреждения, Организация,,,ОписаниеОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьОбластьМакетаЗаявкаНаИзменениеРеквизитов(Объект, ТабДокумент, Макет, ПараметрыПечати) Экспорт
	
	// Область Шапка
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.параметры.Фирма = Объект.ПолноеНаименование;
	ОбластьМакета.параметры.ИНН   = Объект.ИНН;
	ОбластьМакета.параметры.ОГРН = Объект.ОГРН;
	ОбластьМакета.параметры.УчетнаяЗапись = Объект.УчетнаяЗапись;
	ОбластьМакета.параметры.ЗаявлениеПолучатель = ПараметрыПечати.ЗаявлениеПолучатель;
	
	Заявитель = Объект.ВладелецЭЦПФамилия + " " + Объект.ВладелецЭЦПИмя + " " + Объект.ВладелецЭЦПОтчество;
	
	Если СтрДлина(Объект.ИНН)=10 Тогда
		Заявитель = Строка(Объект.ВладелецЭЦПДолжность) + " " + Заявитель;
	КонецЕсли;
	
	ОбластьМакета.Параметры.Заявитель = Заявитель;
	ОбластьМакета.Параметры.КПП       = Объект.КПП;
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	АдресЮридический  = КонтекстЭДОСервер.ПредставлениеАдресаИзДанныхОрганизации(Объект.АдресЮридический);
	ОбластьМакета.Параметры.АдресЮР = АдресЮридический;
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	// Область Сертификат
	ПереиздатьСертификат = Ложь;
	ПараметрыПечати.Свойство("ПереиздатьСертификат", ПереиздатьСертификат);
	
	Если ПереиздатьСертификат Тогда
		
		ОбластьМакета = Макет.ПолучитьОбласть("Сертификат");
		ОбластьМакета.Параметры.Сотр      = Объект.ВладелецЭЦПФамилия + " " + Объект.ВладелецЭЦПИмя + " " + Объект.ВладелецЭЦПОтчество;
		ОбластьМакета.Параметры.Долж      = Объект.ВладелецЭЦПДолжность;
		ОбластьМакета.Параметры.Тел       = Объект.ТелефонОсновной;
		ОбластьМакета.параметры.СНИЛС 	  = Объект.ВладелецЭЦПСНИЛС;
		
		ТабДокумент.Вывести(ОбластьМакета);
	КонецЕсли;
	
	// Область Получатели
	ИзменитьСоставКонтролирующихОрганов = Ложь;
	ПараметрыПечати.Свойство("ИзменитьСоставКонтролирующихОрганов", ИзменитьСоставКонтролирующихОрганов);
	
	Если ИзменитьСоставКонтролирующихОрганов Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Получатели");
		
		ОбластьМакета.Параметры.ФНС       = "нет";
		ОбластьМакета.Параметры.ПФР       = "нет";
		ОбластьМакета.Параметры.ФСС       = "нет";
		ОбластьМакета.Параметры.ФСГС      = "нет";
		
		Для каждого получатель из Объект.Получатели Цикл
			Если Получатель.ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ФСС Тогда
				ОбластьМакета.Параметры.ФСС = "да";
			ИначеЕсли Получатель.ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ФНС Тогда
				ОбластьМакета.Параметры.ФНС = "да";
				Если СтрНайти(Строка(ОбластьМакета.Параметры.КодИФНС), Строка(Получатель.КодПолучателя))= 0 Тогда
					ОбластьМакета.Параметры.КодИФНС = Строка(ОбластьМакета.Параметры.КодИФНС) + Строка(Получатель.КодПолучателя) + "; " ;
				КонецЕсли;
				Если НЕ ПустаяСтрока(Строка(Получатель.КПП)) Тогда
					ОбластьМакета.Параметры.СписокКПП = Строка(ОбластьМакета.Параметры.СписокКПП) + Строка(Получатель.КПП) + "; ";
				КонецЕсли;
			ИначеЕсли Получатель.ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ПФР Тогда
				ОбластьМакета.Параметры.ПФР = "да";
				ОбластьМакета.Параметры.РегНомерПФР = Объект.РегНомерПФР;
			ИначеЕсли Получатель.ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ФСГС Тогда
				ОбластьМакета.Параметры.ФСГС = "да";
				ОбластьМакета.Параметры.НомерТОГС = Строка(ОбластьМакета.Параметры.НомерТОГС) + Строка(Получатель.КодПолучателя) + "; " ;
			КонецЕсли;
		КонецЦикла;
	
		Если Объект.ПодатьЗаявкуНаСертификатДляФСРАР Тогда
			ОбластьМакета.Параметры.ФСРАР = "да";
		Иначе
			ОбластьМакета.Параметры.ФСРАР = "нет";
		КонецЕсли;
		
		Если Объект.ПодатьЗаявкуНаПодключениеРПН Тогда
			ОбластьМакета.Параметры.РПН = "да";
		Иначе
			ОбластьМакета.Параметры.РПН = "нет";
		КонецЕсли;
		
		Если Объект.ПодатьЗаявкуНаПодключениеФТС Тогда
			ОбластьМакета.Параметры.ФТС = "да";
		Иначе
			ОбластьМакета.Параметры.ФТС = "нет";
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьМакета);
		
	КонецЕсли;
	
	// Область ПродлитьЛицензиюНа1СОтчетность
	ПродлитьЛицензиюНа1СОтчетность = Ложь;
	ПараметрыПечати.Свойство("ПродлитьЛицензиюНа1СОтчетность", ПродлитьЛицензиюНа1СОтчетность);
	
	ОбластьМакета = Макет.ПолучитьОбласть("ПродлениеЛицензии");
	Если ПродлитьЛицензиюНа1СОтчетность Тогда
		ОбластьМакета.Параметры.Требуется = "V";
	Иначе
		ОбластьМакета.Параметры.НеТребуется = "V";
	КонецЕсли;
	ТабДокумент.Вывести(ОбластьМакета);
	
	// Область ОказаниеУслугПоУстановке
	ОбластьМакета = Макет.ПолучитьОбласть("ОказаниеУслугПоУстановке");
	ЗаполнитьДанныеБанкаВЗаявлении(Объект.Организация, Объект.Дата, ОбластьМакета);
	ТабДокумент.Вывести(ОбластьМакета);
	
	// Область Подвал
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	ОбластьМакета.Параметры.ДатаЗаполнения = Лев(Объект.Дата,10);
	
	КонтекстЭДОСервер.РазместитьНаОдномЛисте(ТабДокумент);
	
	ТабДокумент.Вывести(ОбластьМакета);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТипВладельцаЭЦПСервер(Тип) Экспорт
	
	Если Тип = 1 Тогда
		ТипИсполнителя = СтруктураСсылочныхДанных.Перечисления_ТипыВладельцевЭЦП_Руководитель;
	ИначеЕсли Тип = 2 Тогда
		ТипИсполнителя = СтруктураСсылочныхДанных.Перечисления_ТипыВладельцевЭЦП_ГлавныйБухгалтер;
	Иначе
		ТипИсполнителя =СтруктураСсылочныхДанных.Перечисления_ТипыВладельцевЭЦП_ДругойСотрудник;
	КонецЕсли;
	
	Возврат ТипИсполнителя;
	
КонецФункции

&НаСервере
Процедура СохранитьДополнительныеРеквизитыУчетнойЗаписи(ПараметрыФункции)
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	КонтекстЭДОСервер.СохранитьДополнительныеРеквизитыУчетнойЗаписи(ПараметрыФункции);
			
КонецПроцедуры

&НаСервере
Функция ТекстЧерезСколькоЛетМесяцевНедельДней(ДатаОтсчета, ДатаЗавершения, ПрефиксЧисла, ПостфиксСуществительного) Экспорт
	
	КонтекстЭДО = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДО.ТекстЧерезСколькоЛетМесяцевНедельДней(ДатаОтсчета, ДатаЗавершения, ПрефиксЧисла, ПостфиксСуществительного);
	
КонецФункции

&НаКлиенте
Функция УстанавливатьСертификат(ОтпечатокСертификатаИзОтвета)

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.

	УстанавливатьСертификат = Истина;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Отпечаток", НРег(ОтпечатокСертификатаИзОтвета));
	Отбор.Вставить("Хранилище", "MY");
	
	НайденныеСертификаты = Сертификаты.НайтиСтроки(Отбор);
	
	Если НайденныеСертификаты.Количество() = 0 Тогда
		УстанавливатьСертификат = Ложь;
	КонецЕсли;
	
	Возврат УстанавливатьСертификат;
КонецФункции

&НаКлиенте
Функция ЭтоЗаявлениеНаИзменениеРеквизитовПодключения(Заявление)
	
	Возврат Заявление.ТипЗаявления = ПредопределенноеЗначение("Перечисление.ТипыЗаявленияАбонентаСпецоператораСвязи.Изменение");
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтотПараметрИзменился(ТабличнаяЧасть, НазваниеРеквизита)
	
	СтруктураПоиска = Новый Структура("ИзмененныйРеквизит", НазваниеРеквизита);
	Возврат ТабличнаяЧасть.НайтиСтроки(СтруктураПоиска).Количество() > 0 ;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоПервичныйОтчет(Отчет)
	
	Возврат Отчет.Вид = 0;
	
КонецФункции

&НаКлиенте
Функция ВыбранКорректныйФайл(Знач ПолныйПуть, Знач ПолноеИмяФайлаБезПути) Экспорт
	
	ПолныйПуть = Врег(ПолныйПуть);
	ПолноеИмяФайлаБезПути = Врег(ПолноеИмяФайлаБезПути);
	
	ДлинаПолногоИмениФайлаБезПути = СтрДлина(ПолноеИмяФайлаБезПути);
	Возврат Прав(ПолныйПуть,ДлинаПолногоИмениФайлаБезПути) = ПолноеИмяФайлаБезПути;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИзХранилищаЗначений(Хранилище) Экспорт
	
	Результат = Хранилище.Получить();
	Возврат Результат;
	
КонецФункции

// Используется в случае, если клиент не поддерживает расширение работы с файлами
&НаСервереБезКонтекста
Функция СвойстваФайла(Знач АдресДанных, Знач ПолноеИмя) Экспорт
	
	// Остальные свойства
	Файл = Новый Файл(ПолноеИмя);
	
	СтруктураСвойств = Новый Структура("АдресДанных, Имя, ИмяБезРасширения, ПолноеИмя, Путь, Размер, Расширение");
	ЗаполнитьЗначенияСвойств(СтруктураСвойств, Файл);
	СтруктураСвойств.АдресДанных = АдресДанных;
	СтруктураСвойств.Размер      = ПолучитьИзВременногоХранилища(АдресДанных).Размер();
	
	Возврат СтруктураСвойств;
	
КонецФункции


