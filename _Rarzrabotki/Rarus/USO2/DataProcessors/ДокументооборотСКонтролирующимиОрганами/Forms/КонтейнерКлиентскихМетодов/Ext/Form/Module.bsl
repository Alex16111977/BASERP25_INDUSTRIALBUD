// ДОКУМЕНТООБОРОТ С РПН

// ОтправкаСсылка ссылается на загруженный объект
&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиРПН(Форма, ОтправкаСсылка, ВыполняемоеОповещение, ПараметрыОбновленияОтправки = Неопределено, ЭтоВызовИзСписка = Ложь) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("Форма",                Форма);
	ДополнительныеПараметры.Вставить("ОтправкаСсылка",       ОтправкаСсылка);
	ДополнительныеПараметры.Вставить("ЗначениеCookie",       ?(ПараметрыОбновленияОтправки <> Неопределено, ПараметрыОбновленияОтправки.ЗначениеCookie, ""));
	ДополнительныеПараметры.Вставить("EMail",                ?(ПараметрыОбновленияОтправки <> Неопределено, ПараметрыОбновленияОтправки.EMail, ""));
	ДополнительныеПараметры.Вставить("Пароль",               ?(ПараметрыОбновленияОтправки <> Неопределено, ПараметрыОбновленияОтправки.Пароль, ""));
	ДополнительныеПараметры.Вставить("ЭтоВызовИзСписка",     ЭтоВызовИзСписка);
	
	Оповещение = Новый ОписаниеОповещения(
		"ОбновитьРезультатКонкретнойОтправкиРПНПослеПолученияСертификатовИПараметровОбмена",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	СертификатыИПараметрыОбменаОрганизацииДляРПН(
		Оповещение,
		Неопределено,
		Истина,
		ОтправкаСсылка,
		Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиРПНПослеПолученияСертификатовИПараметровОбмена(СертификатыИПараметрыОбмена, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = 	ДополнительныеПараметры.ВыполняемоеОповещение;
	Форма = 					ДополнительныеПараметры.Форма;
	ОтправкаСсылка = 			ДополнительныеПараметры.ОтправкаСсылка;
	ЗначениеCookie = 			ДополнительныеПараметры.ЗначениеCookie;
	EMail = 					ДополнительныеПараметры.EMail;
	Пароль = 					ДополнительныеПараметры.Пароль;
	ЭтоВызовИзСписка = 			ДополнительныеПараметры.ЭтоВызовИзСписка;
	
	Крипт = Неопределено;
	ОрганизацияСсылка = СертификатыИПараметрыОбмена.ОрганизацияИзОтправки;
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияСсылка);
	ЭтоЭлектроннаяПодписьВМоделиСервиса = РеквизитыУчетнойЗаписи.ЭлектроннаяПодписьВМоделиСервиса;
	ИдентификаторДокументооборота = РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота;
	ТелефонМобильныйДляАвторизации = РеквизитыУчетнойЗаписи.ТелефонМобильныйДляАвторизации;
	
	УчетнаяЗапись = Новый Структура("ТелефонМобильныйДляАвторизации, ИдентификаторДокументооборота", ТелефонМобильныйДляАвторизации, ИдентификаторДокументооборота);
	
	ПараметрыФормированияПакета = СертификатыИПараметрыОбмена.ПараметрыФормированияПакета;
	ЭтоРегламентированныйОтчет = СертификатыИПараметрыОбмена.ЭтоРегламентированныйОтчет;
	
	Если НЕ ПараметрыФормированияПакета.ИспользоватьОбмен Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Использование документооборота с Росприроднадзором не включено для организации!';
															|en = 'Use of data interchange with Federal Supervisory Natural Resources Management Service is not enabled for the company.'"));
		ДлительнаяОтправкаКлиент.ОповеститьОНевозможностиОбновитьСтатусОтчета();
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
		Возврат;
	КонецЕсли;
	
	ФормаДлительнаяОперация = Неопределено;
	
	ПараметрEMail = ?(ЗначениеЗаполнено(EMail), EMail, ПараметрыФормированияПакета.EMail);
	ПараметрПароль = ?(ЗначениеЗаполнено(Пароль), Пароль, ПараметрыФормированияПакета.Пароль);
	
	АвторизацияПроизведена = ЗначениеЗаполнено(ЗначениеCookie);
	ПараметрыОтправки = Новый Структура();
	ПараметрыОтправки.Вставить("Организация",             ОрганизацияСсылка);
	ПараметрыОтправки.Вставить("АдресСервера",            СерверПриемаОтчетностиРПН(Истина));
	ПараметрыОтправки.Вставить("ПоляДляЗаписиОтправки",   Неопределено);
	ПараметрыОтправки.Вставить("ЭтоНеподписываемыйОтчет", СертификатыИПараметрыОбмена.ЭтоНеподписываемыйОтчет);
	ПараметрыОтправки.Вставить("БумажнаяПодачаОтчета",    СертификатыИПараметрыОбмена.БумажнаяПодачаОтчета);
	
	ПараметрыСоединения = Новый Структура();
	ПараметрыСоединения.Вставить("EMail",                          ПараметрEMail);
	ПараметрыСоединения.Вставить("Пароль",                         ПараметрПароль);
	ПараметрыСоединения.Вставить("СохранитьПароль",                ЗначениеЗаполнено(ПараметрыФормированияПакета.Пароль));
	ПараметрыСоединения.Вставить("СохраненныйEmail",               ПараметрыФормированияПакета.EMail);
	ПараметрыСоединения.Вставить("СохраненныйПароль",              ПараметрыФормированияПакета.Пароль);
	ПараметрыСоединения.Вставить("СоединениеHTTP",                 Неопределено);
	ПараметрыСоединения.Вставить("ЗначениеCookie",                 ЗначениеCookie);
	ПараметрыСоединения.Вставить("ИдентификаторОтправкиНаСервере", "");
	ПараметрыСоединения.Вставить("ОписаниеОшибкиСервером",         "");
	ПараметрыСоединения.Вставить("ПовторятьСоединение",            Истина);
	ПараметрыСоединения.Вставить("ПовторятьЗапросПароля",          СертификатыИПараметрыОбмена.СвойстваОтправки.ИдентификаторОтправкиОператору = 0);
	ПараметрыСоединения.Вставить("СообщенияПользователю",          Новый Массив);
	ПараметрыСоединения.Вставить("ОбменНапрямую",                  ПараметрыФормированияПакета.ОбменНапрямую);
	ПараметрыСоединения.Вставить("ИдентификаторОтправкиОператору", Неопределено);
	
	ПерваяПопыткаАвторизации = Истина;
	ОперацияУспешна = Ложь;
	
	ОбновитьРезультатКонкретнойОтправкиРПНВводПароля(
		ВыполняемоеОповещение,
		ПараметрыСоединения,
		ПараметрыОтправки,
		ФормаДлительнаяОперация,
		АвторизацияПроизведена,
		ОтправкаСсылка,
		ПерваяПопыткаАвторизации,
		СертификатыИПараметрыОбмена,
		ЭтоВызовИзСписка);
	
КонецПроцедуры

// Цикла Пока ПараметрыСоединения.ПовторятьСоединение (Цикл)
&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиРПНВводПароля(
	ВыполняемоеОповещение,
	ПараметрыСоединения,
	ПараметрыОтправки,
	ФормаДлительнаяОперация,
	АвторизацияПроизведена,
	ОтправкаСсылка,
	ПерваяПопыткаАвторизации,
	СертификатыИПараметрыОбмена,
	ЭтоВызовИзСписка)
	
	Если СертификатыИПараметрыОбмена.СвойстваОтправки.ИдентификаторОтправкиОператору = 0 
		И (НЕ ЗначениеЗаполнено(ПараметрыСоединения.EMail) ИЛИ НЕ ЗначениеЗаполнено(ПараметрыСоединения.Пароль) ИЛИ НЕ ПерваяПопыткаАвторизации) Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 			ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("ПараметрыСоединения", 			ПараметрыСоединения);
		ДополнительныеПараметры.Вставить("ПараметрыОтправки", 				ПараметрыОтправки);
		ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация", 		ФормаДлительнаяОперация);
		ДополнительныеПараметры.Вставить("АвторизацияПроизведена", 			АвторизацияПроизведена);
		ДополнительныеПараметры.Вставить("ОтправкаСсылка", 					ОтправкаСсылка);
		ДополнительныеПараметры.Вставить("ПерваяПопыткаАвторизации", 		ПерваяПопыткаАвторизации);
		ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена", 	СертификатыИПараметрыОбмена);
		ДополнительныеПараметры.Вставить("ЭтоВызовИзСписка", 				ЭтоВызовИзСписка);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьРезультатКонкретнойОтправкиРПНВводПароляЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ВызватьФормуВводаПароляПорталаРПН(
			"https://" + ПараметрыОтправки.АдресСервера + "/",
			ПараметрыСоединения.EMail,
			ПараметрыСоединения.Пароль,
			ПараметрыСоединения.СохранитьПароль,
			ОписаниеОповещения);
		
		Возврат;
	КонецЕсли;
	
	// при успешном обращении на сервер РПН отправка обновится в ИБ
	ОперацияУспешна = ОбновитьРезультатКонкретнойОтправкиРПННаСервере(
		ОтправкаСсылка,
		Истина,
		ПараметрыОтправки,
		ПараметрыСоединения,
		ЭтоВызовИзСписка);
	
	ДлительнаяОтправкаКлиент.ВывестиСообщенияССервераНаКлиенте(ПараметрыСоединения.СообщенияПользователю);
	
	ПерваяПопыткаАвторизации = Ложь;
	
	// рекурсивный вызов - замена цикла
	Если НЕ ОперацияУспешна И ПараметрыСоединения.ПовторятьЗапросПароля Тогда
		
		ОбновитьРезультатКонкретнойОтправкиРПНВводПароля(
			ВыполняемоеОповещение,
			ПараметрыСоединения,
			ПараметрыОтправки,
			ФормаДлительнаяОперация,
			АвторизацияПроизведена,
			ОтправкаСсылка,
			ПерваяПопыткаАвторизации,
			СертификатыИПараметрыОбмена,
			ЭтоВызовИзСписка);
		
	Иначе
		
		ОбновитьРезультатКонкретнойОтправкиРПНПослеОтправки(
			ВыполняемоеОповещение,
			ПараметрыСоединения,
			ПараметрыОтправки,
			ФормаДлительнаяОперация,
			АвторизацияПроизведена,
			ОтправкаСсылка,
			ПерваяПопыткаАвторизации,
			СертификатыИПараметрыОбмена,
			ЭтоВызовИзСписка);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиРПНВводПароляЗавершение(РезультатВводаПароля, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение       = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПараметрыСоединения         = ДополнительныеПараметры.ПараметрыСоединения;
	ПараметрыОтправки           = ДополнительныеПараметры.ПараметрыОтправки;
	ФормаДлительнаяОперация     = ДополнительныеПараметры.ФормаДлительнаяОперация;
	АвторизацияПроизведена      = ДополнительныеПараметры.АвторизацияПроизведена;
	ОтправкаСсылка              = ДополнительныеПараметры.ОтправкаСсылка;
	ПерваяПопыткаАвторизации    = ДополнительныеПараметры.ПерваяПопыткаАвторизации;
	СертификатыИПараметрыОбмена = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ЭтоВызовИзСписка            = ДополнительныеПараметры.ЭтоВызовИзСписка;
	
	Если РезультатВводаПароля = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
		Возврат;
	Иначе
		
		ПараметрыСоединения.EMail           = РезультатВводаПароля.EMail;
		ПараметрыСоединения.Пароль          = РезультатВводаПароля.Пароль;
		ПараметрыСоединения.СохранитьПароль = РезультатВводаПароля.СохранитьПароль;
		
		// при успешном обращении на сервер РПН отправка обновится в ИБ
		ОперацияУспешна = ОбновитьРезультатКонкретнойОтправкиРПННаСервере(
			ОтправкаСсылка,
			Истина,
			ПараметрыОтправки,
			ПараметрыСоединения,
			ЭтоВызовИзСписка);
		
		ДлительнаяОтправкаКлиент.ВывестиСообщенияССервераНаКлиенте(ПараметрыСоединения.СообщенияПользователю);
		
		ПерваяПопыткаАвторизации = Ложь;
		
		// рекурсивный вызов - замена цикла
		Если НЕ ОперацияУспешна И ПараметрыСоединения.ПовторятьЗапросПароля Тогда
			
			ОбновитьРезультатКонкретнойОтправкиРПНВводПароля(
				ВыполняемоеОповещение,
				ПараметрыСоединения,
				ПараметрыОтправки,
				ФормаДлительнаяОперация,
				АвторизацияПроизведена,
				ОтправкаСсылка,
				ПерваяПопыткаАвторизации,
				СертификатыИПараметрыОбмена,
				ЭтоВызовИзСписка);
		Иначе
			
			ОбновитьРезультатКонкретнойОтправкиРПНПослеОтправки(
				ВыполняемоеОповещение,
				ПараметрыСоединения,
				ПараметрыОтправки,
				ФормаДлительнаяОперация,
				АвторизацияПроизведена,
				ОтправкаСсылка,
				ПерваяПопыткаАвторизации,
				СертификатыИПараметрыОбмена,
				ЭтоВызовИзСписка);
			
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиРПНПослеОтправки(
	ВыполняемоеОповещение,
	ПараметрыСоединения,
	ПараметрыОтправки,
	ФормаДлительнаяОперация,
	АвторизацияПроизведена,
	ОтправкаСсылка,
	ПерваяПопыткаАвторизации,
	СертификатыИПараметрыОбмена,
	ЭтоВызовИзСписка)
	
	Если ПараметрыСоединения.ПовторятьСоединение Тогда
		
		// возможно, проблемы с доступом в интернет
		Если НЕ АвторизацияПроизведена Тогда
			ПараметрыСоединения.ЗначениеCookie = "";
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",       ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("ПараметрыСоединения",         ПараметрыСоединения);
		ДополнительныеПараметры.Вставить("ПараметрыОтправки",           ПараметрыОтправки);
		ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация",     ФормаДлительнаяОперация);
		ДополнительныеПараметры.Вставить("АвторизацияПроизведена",      АвторизацияПроизведена);
		ДополнительныеПараметры.Вставить("ОтправкаСсылка",              ОтправкаСсылка);
		ДополнительныеПараметры.Вставить("ПерваяПопыткаАвторизации",    ПерваяПопыткаАвторизации);
		ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена", СертификатыИПараметрыОбмена);
		ДополнительныеПараметры.Вставить("ЭтоВызовИзСписка",            ЭтоВызовИзСписка);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОбновитьРезультатКонкретнойОтправкиРПНПослеОтправкиЗавершение",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(
			НСтр("ru = 'Не удалось обратиться к серверу Росприроднадзора';
				|en = 'Cannot contact the server of the Federal Supervisory Natural Resources Management Service'"),
			ОписаниеОповещения);
		
		Возврат;
		
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиРПНПослеОтправкиЗавершение(РезультатДиалогаОбОшибкеДоступа, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение                   = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПараметрыСоединения                     = ДополнительныеПараметры.ПараметрыСоединения;
	ПараметрыОтправки                       = ДополнительныеПараметры.ПараметрыОтправки;
	ФормаДлительнаяОперация                 = ДополнительныеПараметры.ФормаДлительнаяОперация;
	АвторизацияПроизведена                  = ДополнительныеПараметры.АвторизацияПроизведена;
	ОтправкаСсылка                          = ДополнительныеПараметры.ОтправкаСсылка;
	ПерваяПопыткаАвторизации                = ДополнительныеПараметры.ПерваяПопыткаАвторизации;
	СертификатыИПараметрыОбмена             = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ЭтоВызовИзСписка                        = ДополнительныеПараметры.ЭтоВызовИзСписка;
	ПараметрыСоединения.ПовторятьСоединение = (РезультатДиалогаОбОшибкеДоступа = Истина);
	
	// рекурсивный вызов - замена цикла
	Если ПараметрыСоединения.ПовторятьСоединение Тогда
		
		ОбновитьРезультатКонкретнойОтправкиРПНВводПароля(
			ВыполняемоеОповещение,
			ПараметрыСоединения,
			ПараметрыОтправки,
			ФормаДлительнаяОперация,
			АвторизацияПроизведена,
			ОтправкаСсылка,
			ПерваяПопыткаАвторизации,
			СертификатыИПараметрыОбмена,
			ЭтоВызовИзСписка);
		
	Иначе
		
		ДлительнаяОтправкаКлиент.ОповеститьОНевозможностиОбновитьСтатусОтчета();
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Истина);	
		
	КонецЕсли;	
	
КонецПроцедуры
// Цикла Пока ПараметрыСоединения.ПовторятьСоединение (КонецЦикла)

&НаКлиенте
Процедура ОткрытьПротоколОтправкиРПН(Форма) Экспорт
	
	ОтчетСсылка = ДокументооборотСРПНКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	
	Если ОтчетСсылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьПротоколОбработкиПоСсылкеИсточникаДляРПН(ОтчетСсылка);
	
КонецПроцедуры

&НаКлиенте
Процедура СертификатыИПараметрыОбменаОрганизацииДляРПН(
		ВыполняемоеОповещение,
		ОрганизацияСсылка,
		ПолучитьОсновныеСвойстваПоследнейОтправки,
		ОтправкаСсылка = Неопределено,
		ОтчетСсылка = Неопределено,
		ОпределитьНастроенностьОбменаВУниверсальномФормате = Ложь,
		СвойстваПоследнейОтправки = Неопределено)
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("ПараметрыФормированияПакета", 		Неопределено);
	РезультатВыполнения.Вставить("ОрганизацияИзОтправки", 				Неопределено);
	РезультатВыполнения.Вставить("СвойстваОтправки", 					Неопределено);
	РезультатВыполнения.Вставить("Крипт", 								Неопределено);
	РезультатВыполнения.Вставить("НастроенОбменВУниверсальномФормате", 	Неопределено);
	РезультатВыполнения.Вставить("ПравоИзмененияУчетнойЗаписи", 		Неопределено);
	РезультатВыполнения.Вставить("ЭтоРегламентированныйОтчет", 			Неопределено);
	РезультатВыполнения.Вставить("ЭтоРегламентированноеУведомление", 	Неопределено);
	РезультатВыполнения.Вставить("ЭтоНеподписываемыйОтчет", 			Неопределено);
	РезультатВыполнения.Вставить("БумажнаяПодачаОтчета", 				Неопределено);
	
	СвойстваОбмена = СвойстваОбменаОрганизацииДляРПННаСервере(ОрганизацияСсылка, ОпределитьНастроенностьОбменаВУниверсальномФормате, ПолучитьОсновныеСвойстваПоследнейОтправки, ОтправкаСсылка, ОтчетСсылка, , СвойстваПоследнейОтправки);
	
	РезультатВыполнения.ОрганизацияИзОтправки = СвойстваОбмена.ОрганизацияИзОтправки;
	
	РезультатВыполнения.СвойстваОтправки = СвойстваОбмена.СвойстваОтправки;
	
	РезультатВыполнения.НастроенОбменВУниверсальномФормате = СвойстваОбмена.НастроенОбменВУниверсальномФормате;
	РезультатВыполнения.ПравоИзмененияУчетнойЗаписи = СвойстваОбмена.ПравоИзмененияУчетнойЗаписи;
	РезультатВыполнения.ЭтоРегламентированныйОтчет = СвойстваОбмена.ЭтоРегламентированныйОтчет;
	РезультатВыполнения.ЭтоРегламентированноеУведомление = СвойстваОбмена.ЭтоРегламентированноеУведомление;
	РезультатВыполнения.ЭтоНеподписываемыйОтчет = СвойстваОбмена.ЭтоНеподписываемыйОтчет;
	РезультатВыполнения.БумажнаяПодачаОтчета = СвойстваОбмена.БумажнаяПодачаОтчета;
	
	РезультатВыполнения.ПараметрыФормированияПакета = Новый Структура("ИспользоватьОбмен, СертификатАбонента, СертификатРПН, EMail, Пароль, ИспользоватьАвтонастройку, ОбменНапрямую", Ложь, Неопределено, Неопределено, Неопределено, Неопределено, Ложь, Ложь);
	Если НЕ СвойстваОбмена.ЭтоНеподписываемыйОтчет И НЕ СвойстваОбмена.НастройкиОбмена.ИспользоватьОбмен Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения.ПараметрыФормированияПакета.ИспользоватьОбмен = СвойстваОбмена.НастройкиОбмена.ИспользоватьОбмен;
	РезультатВыполнения.ПараметрыФормированияПакета.EMail = СвойстваОбмена.НастройкиОбмена.EMail;
	РезультатВыполнения.ПараметрыФормированияПакета.Пароль = СвойстваОбмена.НастройкиОбмена.Пароль;
	РезультатВыполнения.ПараметрыФормированияПакета.ИспользоватьАвтонастройку = СвойстваОбмена.НастройкиОбмена.ИспользоватьАвтонастройку;
	РезультатВыполнения.ПараметрыФормированияПакета.ОбменНапрямую = СвойстваОбмена.НастройкиОбмена.ОбменНапрямую;
	
	Если СвойстваОбмена.ЭтоНеподписываемыйОтчет Тогда
		РезультатВыполнения.ПараметрыФормированияПакета.СертификатАбонента = Неопределено;
		РезультатВыполнения.ПараметрыФормированияПакета.СертификатРПН = Неопределено;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	Если СвойстваОбмена.ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		РезультатВыполнения.ПараметрыФормированияПакета.СертификатАбонента = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(СвойстваОбмена.НастройкиОбмена.СертификатАбонентаОтпечаток);
		РезультатВыполнения.ПараметрыФормированияПакета.СертификатРПН = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(СвойстваОбмена.НастройкиОбмена.СертификатРПНОтпечаток);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("СвойстваОбмена",        СвойстваОбмена);
	ДополнительныеПараметры.Вставить("РезультатВыполнения",   РезультатВыполнения);
	
	Оповещение = Новый ОписаниеОповещения(
		"СертификатыИПараметрыОбменаОрганизацииДляРПНПослеПолученияСвойствСертификатаАбонентаЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	Если ЗначениеЗаполнено(СвойстваОбмена.НастройкиОбмена.СертификатАбонентаОтпечаток) Тогда
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, СвойстваОбмена.НастройкиОбмена.СертификатАбонентаОтпечаток, "MY", , Ложь);
	Иначе
		РезультатПоиска = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден", Истина, Неопределено, Ложь);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатПоиска);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СертификатыИПараметрыОбменаОрганизацииДляРПНПослеПолученияСвойствСертификатаАбонентаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	СвойстваОбмена = ДополнительныеПараметры.СвойстваОбмена;
	РезультатВыполнения = ДополнительныеПараметры.РезультатВыполнения;
	
	РезультатВыполнения.ПараметрыФормированияПакета.СертификатАбонента = ?(Результат.Выполнено И Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, РезультатВыполнения", ВыполняемоеОповещение, РезультатВыполнения);
	Оповещение = Новый ОписаниеОповещения("СертификатыИПараметрыОбменаОрганизацииДляРПНПослеПолученияСвойствСертификатаРПНЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	Если ЗначениеЗаполнено(СвойстваОбмена.НастройкиОбмена.СертификатРПНОтпечаток) Тогда
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, СвойстваОбмена.НастройкиОбмена.СертификатРПНОтпечаток, "AddressBook", , Ложь);
	Иначе
		РезультатПоиска = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден", Истина, Неопределено, Ложь);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатПоиска);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СертификатыИПараметрыОбменаОрганизацииДляРПНПослеПолученияСвойствСертификатаРПНЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	РезультатВыполнения = ДополнительныеПараметры.РезультатВыполнения;
	
	РезультатВыполнения.ПараметрыФормированияПакета.СертификатРПН = ?(Результат.Выполнено И Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
	
КонецПроцедуры

&НаКлиенте
Функция СертификатыГодятсяДляПодписанияОтчетностиРПН(Сертификаты)
	
	ТекДата = ТекущаяДатаНаСервере();
	ПризнакОшибки = Ложь;
	
	Для Каждого Сертификат Из Сертификаты Цикл
		
		Серт	= Сертификат.Значение;
		Предст	= Сертификат.Представление;
		Если Серт = Неопределено Тогда
			ПризнакОшибки = Истина;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1: сертификат не выбран в настройках сдачи отчетности в Росприроднадзор!';
																														|en = '%1: certificate is not selected in settings of reporting submission to Federal Supervisory Natural Resources Management Service.'"), Предст));
			Продолжить;
		КонецЕсли;
		
		Если ТекДата < Серт.ДействителенС Тогда
			ПризнакОшибки = Истина;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1: период действия сертификата еще не наступил (%2)!';
																														|en = '%1: certificate is not within its validity period yet (%2).'"), Предст, Строка(Серт.ДействителенС)));
		КонецЕсли;
		
		Если ТекДата > Серт.ДействителенПо Тогда
			ПризнакОшибки = Истина;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1: период действия сертификата истек (%2)!';
																														|en = '%1: validity period of certificate is expired (%2).'"), Предст, Строка(Серт.ДействителенПо)));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат (НЕ ПризнакОшибки);
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВРПН(
		Форма,
		ВыполняемоеОповещение,
		ВыполнятьАвтонастройку = Истина,
		ТекстФайлаВыгрузки = Неопределено,
		ИмяФайлаВыгрузки = Неопределено,
		Кодировка = Неопределено,
		СертификатыИПараметрыОбмена = Неопределено,
		Знач ЭтоОтправкаИзФормыОтчетность = Ложь,
		Знач ОтчетСсылка = Неопределено,
		Знач ОрганизацияСсылка = Неопределено) Экспорт
		
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОтчетСсылка = ДокументооборотСРПНКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
	Если ОтчетСсылка = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОрганизацияСсылка = ДокументооборотСРПНКлиентСервер.ПолучитьОрганизациюПоФорме(Форма);
	КонецЕсли;
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияСсылка);
	ЭтоЭлектроннаяПодписьВМоделиСервиса = РеквизитыУчетнойЗаписи.ЭлектроннаяПодписьВМоделиСервиса;
	УчетнаяЗапись = РеквизитыУчетнойЗаписи.Ссылка;
	Идентификатор = РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение", ВыполняемоеОповещение);	
	
	ДополнительныеПараметры.Вставить("Форма", Форма);
	ДополнительныеПараметры.Вставить("ВыполнятьАвтонастройку", ВыполнятьАвтонастройку);
	ДополнительныеПараметры.Вставить("ОтчетСсылка", ОтчетСсылка);
	ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	ДополнительныеПараметры.Вставить("Идентификатор", Идентификатор);
	ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность", ЭтоОтправкаИзФормыОтчетность);
	ДополнительныеПараметры.Вставить("ОрганизацияСсылка", ОрганизацияСсылка);

	ВыгрузитьПакетДляОтправкиВРПНПослеИнициализации(Истина, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВРПНПослеИнициализации(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Неопределено);
	КонецЕсли;
	
	ОтчетСсылка = ДополнительныеПараметры.ОтчетСсылка;
	ОрганизацияСсылка = ДополнительныеПараметры.ОрганизацияСсылка;
	
	ОпределитьНастроенностьОбменаВУниверсальномФормате = ДополнительныеПараметры.ВыполнятьАвтонастройку;
	
	Оповещение = Новый ОписаниеОповещения(
		"ВыгрузитьПакетДляОтправкиВРПНПослеПолученияСертификатовИПараметровОбменаЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	СертификатыИПараметрыОбменаОрганизацииДляРПН(
		Оповещение,
		ОрганизацияСсылка,
		Ложь,
		Неопределено,
		ОтчетСсылка,
		ОпределитьНастроенностьОбменаВУниверсальномФормате);
		
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВРПНПослеПолученияСертификатовИПараметровОбменаЗавершение(СертификатыИПараметрыОбмена, ДополнительныеПараметры) Экспорт
	
	ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена", СертификатыИПараметрыОбмена);
	
	Если ДополнительныеПараметры.ВыполнятьАвтонастройку И 
			СертификатыИПараметрыОбмена.НастроенОбменВУниверсальномФормате И 
			СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.ИспользоватьАвтонастройку И 
			СертификатыИПараметрыОбмена.ПравоИзмененияУчетнойЗаписи Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВРПНЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(ДополнительныеПараметры.ОтчетСсылка, ОписаниеОповещения);
		Возврат;
		
	КонецЕсли;
	
	ВыгрузитьПакетДляОтправкиВРПНПослеАвтонастройкиУчетнойЗаписи(
		ДополнительныеПараметры.Форма, 
		ДополнительныеПараметры.ВыполняемоеОповещение, 
		ДополнительныеПараметры.СертификатыИПараметрыОбмена, 
		ДополнительныеПараметры.ОтчетСсылка, 
		ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса, 
		ДополнительныеПараметры.Идентификатор, 
		ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВРПНЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	СертификатыИПараметрыОбмена = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ОтчетСсылка = ДополнительныеПараметры.ОтчетСсылка;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	Идентификатор = ДополнительныеПараметры.Идентификатор;
	ЭтоОтправкаИзФормыОтчетность = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	
	ВыгрузитьПакетДляОтправкиВРПНПослеАвтонастройкиУчетнойЗаписи(Форма, ВыполняемоеОповещение, СертификатыИПараметрыОбмена, ОтчетСсылка, ЭтоЭлектроннаяПодписьВМоделиСервиса, Идентификатор, ЭтоОтправкаИзФормыОтчетность);	
		
КонецПроцедуры
		
&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВРПНПослеАвтонастройкиУчетнойЗаписи(Форма, ВыполняемоеОповещение, СертификатыИПараметрыОбмена, ОтчетСсылка, ЭтоЭлектроннаяПодписьВМоделиСервиса, 
		Идентификатор, Знач ЭтоОтправкаИзФормыОтчетность = Ложь)
	
	// запрашиваем параметры формирования пакета и параметры обмена при вызове из отправки
	Если НЕ СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.ИспользоватьОбмен И НЕ СертификатыИПараметрыОбмена.ЭтоНеподписываемыйОтчет Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Использование документооборота с Росприроднадзором не включено для организации!';
															|en = 'Use of data interchange with Federal Supervisory Natural Resources Management Service is not enabled for the company.'"));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатАбонента = СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.СертификатАбонента;
	Если СертификатАбонента <> Неопределено И ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		СертификатАбонента.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
		СертификатАбонента.Вставить("КлючевойКонтейнер", Идентификатор);
	КонецЕсли;
	СертификатРПН = СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.СертификатРПН;
	Если СертификатРПН <> Неопределено И ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		СертификатРПН.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	КонецЕсли;
	
	//проверяем сертификаты
	СертификатыОбмена = Новый СписокЗначений();
	СертификатыОбмена.Добавить(СертификатАбонента, НСтр("ru = 'Сертификат абонента';
														|en = 'Subscriber certificate '"));
	СертификатыОбмена.Добавить(СертификатРПН, НСтр("ru = 'Сертификат РПН';
													|en = 'RPN certificate'"));
	
	Если НЕ СертификатыИПараметрыОбмена.ЭтоНеподписываемыйОтчет 
		И НЕ СертификатыГодятсяДляПодписанияОтчетностиРПН(СертификатыОбмена) Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	// формируем файл выгрузки
	
	ТекстФайлаВыгрузки 	= "";
	ИмяФайлаВыгрузки 	= "";
	Кодировка 			= "utf-8"; // кодировка, в которую нужно сконвертировать текст выгрузки перед подписью
	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	
	Если ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет")
	ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено") Тогда
	
		Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
			ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента", , Форма);
		Иначе
			ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента");
		КонецЕсли;
	
		Если НЕ ФормаВыгрузкиРеглОтчета.ВыгрузитьОтчет(ОтчетСсылка, Ложь, Ложь, ТекстФайлаВыгрузки, ИмяФайлаВыгрузки) Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
			Возврат;
		КонецЕсли;
		
	ИначеЕсли ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.УведомлениеОСпецрежимахНалогообложения") Тогда
		МассивВыгруженныхУведомлений = Неопределено;
		Если НЕ ВыгрузитьУведомлениеФНС(ОтчетСсылка, МассивВыгруженныхУведомлений) Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
			Возврат;
		КонецЕсли;
		ТекстФайлаВыгрузки = ПрочитатьТекстИзФайла(МассивВыгруженныхУведомлений[0].АдресФайлаВыгрузки, "utf-8");
		ИмяФайлаВыгрузки = МассивВыгруженныхУведомлений[0].ИмяФайлаВыгрузки;
		
	Иначе // электронное представление
		Если ОтчетСсылка = ПредопределенноеЗначение("Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.ПустаяСсылка") Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
			Возврат;
		КонецЕсли;
		
		ОпределеннаяКодировка = Неопределено;
		
		ИзвлечьЭлектронноеПредставлениеИзХранилищаИПерекодироватьНаСервере(
			ОтчетСсылка,
			ТекстФайлаВыгрузки,
			ИмяФайлаВыгрузки,
			ОпределеннаяКодировка,
			"utf-8");
		
		Если ОпределеннаяКодировка <> Неопределено Тогда
			//Кодировка = ОпределеннаяКодировка;
		КонецЕсли;		
	КонецЕсли;
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		ПараметрыФункции = Новый Структура;
		ПараметрыФункции.Вставить("ТекстФайлаВыгрузки",      ТекстФайлаВыгрузки);
		ПараметрыФункции.Вставить("Сертификаты",             СертификатыОбмена);
		ПараметрыФункции.Вставить("Идентификатор",           Идентификатор);
		ПараметрыФункции.Вставить("Адрес",                   Форма.УникальныйИдентификатор);
		ПараметрыФункции.Вставить("ИмяФайлаВыгрузки",        ИмяФайлаВыгрузки);
		ПараметрыФункции.Вставить("Кодировка",               Кодировка);
		ПараметрыФункции.Вставить("ЭтоНеподписываемыйОтчет", СертификатыИПараметрыОбмена.ЭтоНеподписываемыйОтчет);
		
		// подготовка выгрузки пакета, без выполнения подписи для подписываемых отчетов
		АдресРезультатаВыгрузки = ЗагрузитьДанныеНаСервер(ТекстФайлаВыгрузки, Форма.УникальныйИдентификатор,, Истина);
	
		Кодировка = Неопределено;
		
		Если СертификатыИПараметрыОбмена.ЭтоНеподписываемыйОтчет ИЛИ АдресРезультатаВыгрузки = Неопределено Тогда
			Если АдресРезультатаВыгрузки <> Неопределено Тогда
				РезультатВыгрузки = Новый Структура("ИмяФайлаЗашифрованногоПакета, ИмяФайлаВыгрузки", АдресРезультатаВыгрузки, ИмяФайлаВыгрузки);
				СтруктураВозвратаЭтоЭлектроннаяПодпись = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", РезультатВыгрузки, СертификатыИПараметрыОбмена);
			Иначе
				СтруктураВозвратаЭтоЭлектроннаяПодпись = Неопределено;
			КонецЕсли;
			
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, СтруктураВозвратаЭтоЭлектроннаяПодпись);
			
		Иначе
			ФайлВыгрузки = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ИмяФайлаВыгрузки);
			ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ВременныйКаталог, ПолноеИмяПодписанногоФайла, ПолноеИмяФайлаВыгрузки, СертификатАбонента, СертификатРПН, СертификатыИПараметрыОбмена, ФайлВыгрузки, Кодировка, ЭтоЭлектроннаяПодписьВМоделиСервиса, Идентификатор",
				ВыполняемоеОповещение, Неопределено, Неопределено, АдресРезультатаВыгрузки, СертификатАбонента, СертификатРПН, СертификатыИПараметрыОбмена, ФайлВыгрузки, Кодировка, ЭтоЭлектроннаяПодписьВМоделиСервиса, Идентификатор);
			Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВРПНПослеЗаписиФайлаВыгрузки", ЭтотОбъект, ДополнительныеПараметры);
			РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, АдресРезультатаВыгрузки);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	// получим имя временного файла
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ИмяФайлаВыгрузки, ТекстФайлаВыгрузки, СертификатАбонента, СертификатРПН, СертификатыИПараметрыОбмена, Кодировка, ЭтоЭлектроннаяПодписьВМоделиСервиса, Идентификатор", ВыполняемоеОповещение, ИмяФайлаВыгрузки, ТекстФайлаВыгрузки, СертификатАбонента, СертификатРПН, СертификатыИПараметрыОбмена, Кодировка, ЭтоЭлектроннаяПодписьВМоделиСервиса, Идентификатор);
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВРПНПослеПолученияВременногоКаталога", ЭтотОбъект, ДополнительныеПараметры);
	ОперацииСФайламиЭДКОКлиент.КаталогВременныхФайловНаКлиенте(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВРПНПослеПолученияВременногоКаталога(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ИмяФайлаВыгрузки = ДополнительныеПараметры.ИмяФайлаВыгрузки;
	ТекстФайлаВыгрузки = ДополнительныеПараметры.ТекстФайлаВыгрузки;
	СертификатАбонента = ДополнительныеПараметры.СертификатАбонента;
	СертификатРПН = ДополнительныеПараметры.СертификатРПН;
	СертификатыИПараметрыОбмена = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	Кодировка = ДополнительныеПараметры.Кодировка;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	Идентификатор = ДополнительныеПараметры.Идентификатор;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ВременныйКаталог = Результат.ИмяКаталога;
	
	ПолноеИмяФайлаВыгрузки = ВременныйКаталог + ИмяФайлаВыгрузки;
	ФайлВыгрузки = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ИмяФайлаВыгрузки);
	ПолноеИмяПодписанногоФайла = ВременныйКаталог + ФайлВыгрузки.ИмяБезРасширения + ".sgn";
	
	// при необходимости конвертируем текст выгрузки в нужную кодировку
	ТекстФайлаВыгрузки64 = Неопределено;
	Если СертификатыИПараметрыОбмена.ЭтоНеподписываемыйОтчет И ЗначениеЗаполнено(Кодировка) Тогда
		ТекстФайлаВыгрузки64 = ТекстВКодировке64(ТекстФайлаВыгрузки, Кодировка);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ВременныйКаталог, ПолноеИмяПодписанногоФайла, ПолноеИмяФайлаВыгрузки, СертификатАбонента, СертификатРПН, СертификатыИПараметрыОбмена, ФайлВыгрузки, Кодировка, ЭтоЭлектроннаяПодписьВМоделиСервиса, Идентификатор", ВыполняемоеОповещение, ВременныйКаталог, ПолноеИмяПодписанногоФайла, ПолноеИмяФайлаВыгрузки, СертификатАбонента, СертификатРПН, СертификатыИПараметрыОбмена, ФайлВыгрузки, Кодировка, ЭтоЭлектроннаяПодписьВМоделиСервиса, Идентификатор);
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВРПНПослеЗаписиФайлаВыгрузки", ЭтотОбъект, ДополнительныеПараметры);
	Если ЗначениеЗаполнено(ТекстФайлаВыгрузки64) Тогда
		ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ТекстФайлаВыгрузки64, ПолноеИмяФайлаВыгрузки);
	Иначе
		ОперацииСФайламиЭДКОКлиент.ТекстВФайл(Оповещение, ТекстФайлаВыгрузки, ПолноеИмяФайлаВыгрузки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВРПНПослеЗаписиФайлаВыгрузки(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение               = ДополнительныеПараметры.ВыполняемоеОповещение;
	ВременныйКаталог                    = ДополнительныеПараметры.ВременныйКаталог;
	ПолноеИмяПодписанногоФайла          = ДополнительныеПараметры.ПолноеИмяПодписанногоФайла;
	ПолноеИмяФайлаВыгрузки              = ДополнительныеПараметры.ПолноеИмяФайлаВыгрузки;
	СертификатАбонента                  = ДополнительныеПараметры.СертификатАбонента;
	СертификатРПН                       = ДополнительныеПараметры.СертификатРПН;
	СертификатыИПараметрыОбмена         = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ФайлВыгрузки                        = ДополнительныеПараметры.ФайлВыгрузки;
	Кодировка                           = ДополнительныеПараметры.Кодировка;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	Идентификатор                       = ДополнительныеПараметры.Идентификатор;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Если СертификатыИПараметрыОбмена.ЭтоНеподписываемыйОтчет Тогда
		РезультатВыгрузки = ПолноеИмяФайлаВыгрузки;
		
		ВозвращаемаяСтруктура = Новый Структура;
		ВозвращаемаяСтруктура.Вставить("СертификатыИПараметрыОбмена", СертификатыИПараметрыОбмена);
		ВозвращаемаяСтруктура.Вставить("РезультатВыгрузки", РезультатВыгрузки);
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, ВозвращаемаяСтруктура);
		Возврат;
	КонецЕсли;
	
	// подписываем
	ДлительнаяОтправкаКлиент.ВывестиСостояние(НСтр("ru = 'Подписание файла выгрузки ...';
													|en = 'Signing an export file ...'")); // РПН
	
	Если СертификатАбонента = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось определить сертификат!';
															|en = 'Cannot determine a certificate.'"));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВременныйКаталог",                    ВременныйКаталог);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",               ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ПолноеИмяПодписанногоФайла",          ПолноеИмяПодписанногоФайла);
	ДополнительныеПараметры.Вставить("ПолноеИмяФайлаВыгрузки",              ПолноеИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("СертификатАбонента",                  СертификатАбонента);
	ДополнительныеПараметры.Вставить("СертификатРПН",                       СертификатРПН);
	ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена",         СертификатыИПараметрыОбмена);
	ДополнительныеПараметры.Вставить("ФайлВыгрузки",                        ФайлВыгрузки);
	ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	ДополнительныеПараметры.Вставить("Идентификатор",                       Идентификатор);
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВРПНПослеПодписанияФайлаXMLDSigЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ПодписатьФайлXMLDSig(СертификатАбонента, ПолноеИмяФайлаВыгрузки, Оповещение, ПолноеИмяПодписанногоФайла, Кодировка);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВРПНПослеПодписанияФайлаXMLDSigЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВременныйКаталог                    = ДополнительныеПараметры.ВременныйКаталог;
	ВыполняемоеОповещение               = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПолноеИмяПодписанногоФайла          = ДополнительныеПараметры.ПолноеИмяПодписанногоФайла;
	ПолноеИмяФайлаВыгрузки              = ДополнительныеПараметры.ПолноеИмяФайлаВыгрузки;
	СертификатАбонента                  = ДополнительныеПараметры.СертификатАбонента;
	СертификатРПН                       = ДополнительныеПараметры.СертификатРПН;
	СертификатыИПараметрыОбмена         = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ФайлВыгрузки                        = ДополнительныеПараметры.ФайлВыгрузки;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	Идентификатор                       = ДополнительныеПараметры.Идентификатор;
	
	Если Результат = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось подписать файл выгрузки!';
															|en = 'Cannot sign the export file.'"));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	// шифруем
	ДлительнаяОтправкаКлиент.ВывестиСостояние(НСтр("ru = 'Шифрование файла выгрузки ...';
													|en = 'Export file encryption ...'")); // РПН
	ИмяФайлаПакета = ФайлВыгрузки.ИмяБезРасширения + ".xms";
	Если ПолноеИмяПодписанногоФайла = Неопределено Тогда
		ПолноеИмяПодписанногоФайла = Результат;
		РезультатВыгрузки = Неопределено;
	Иначе
		РезультатВыгрузки = ВременныйКаталог + ИмяФайлаПакета;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВременныйКаталог",            ВременныйКаталог);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",       ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ПолноеИмяПодписанногоФайла",  ПолноеИмяПодписанногоФайла);
	ДополнительныеПараметры.Вставить("ПолноеИмяФайлаВыгрузки",      ПолноеИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена", СертификатыИПараметрыОбмена);
	ДополнительныеПараметры.Вставить("РезультатВыгрузки",           РезультатВыгрузки);
	ДополнительныеПараметры.Вставить("ИмяФайлаПакета",              ИмяФайлаПакета);
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВРПНПослеЗашифрованияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	СертификатыШифрования = Новый Массив;
	СертификатыШифрования.Добавить(СертификатРПН);
	
	КриптографияЭДКОКлиент.ЗашифроватьPKCS7(
		Оповещение,
		ПолноеИмяПодписанногоФайла,
		СертификатыШифрования,
		РезультатВыгрузки,
		Ложь,,
		?(ЭтоЭлектроннаяПодписьВМоделиСервиса, Идентификатор, Неопределено),
		"*");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВРПНПослеЗашифрованияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПолноеИмяПодписанногоФайла = ДополнительныеПараметры.ПолноеИмяПодписанногоФайла;
	ПолноеИмяФайлаВыгрузки = ДополнительныеПараметры.ПолноеИмяФайлаВыгрузки;
	СертификатыИПараметрыОбмена = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	РезультатВыгрузки = ДополнительныеПараметры.РезультатВыгрузки;
	ИмяФайлаПакета = ДополнительныеПараметры.ИмяФайлаПакета;
	
	Если НЕ Результат.Выполнено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось зашифровать файл выгрузки!';
															|en = 'Cannot encrypt an export file.'"));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Если РезультатВыгрузки = Неопределено Тогда // ЭП в облаке
		РезультатВыгрузки = Новый Структура("ИмяФайлаЗашифрованногоПакета, ИмяФайлаВыгрузки", Результат.ЗашифрованныйФайл, ИмяФайлаПакета);
	КонецЕсли;
	
	ВозвращаемаяСтруктура = Новый Структура;
	ВозвращаемаяСтруктура.Вставить("СертификатыИПараметрыОбмена", СертификатыИПараметрыОбмена);
	ВозвращаемаяСтруктура.Вставить("РезультатВыгрузки", РезультатВыгрузки);
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, ВозвращаемаяСтруктура);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПН_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
		
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПН(
		ВходящийКонтекст.Форма,
		ВходящийКонтекст.ЭтоОтправкаИзФормыОтчетность,
		ВходящийКонтекст.ОтчетСсылка,
		ВходящийКонтекст.ОрганизацияОтчета);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПН(
		Форма,
		Знач ЭтоОтправкаИзФормыОтчетность = Ложь,
		Знач ОтчетСсылка = Неопределено,
		Знач ОрганизацияОтчета = Неопределено) Экспорт
		
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОрганизацияОтчета 	= ДокументооборотСРПНКлиентСервер.ПолучитьОрганизациюПоФорме(Форма);
		ОтчетСсылка 		= ДокументооборотСРПНКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Форма", 							Форма);
	ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность", 	ЭтоОтправкаИзФормыОтчетность);
	ДополнительныеПараметры.Вставить("ОтчетСсылка", 					ОтчетСсылка);
	ДополнительныеПараметры.Вставить("ОрганизацияОтчета", 				ОрганизацияОтчета);
	ДополнительныеПараметры.Вставить("ТипЗнчСсылкаНаОтчет", 			ТипЗнчСсылкаНаОтчет);
	
	ЭтоРегламентированныйОтчет = (ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет") 
		ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено"));
	ЭтоРегламентированноеУведомление = (ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.УведомлениеОСпецрежимахНалогообложения"));
		
	Если ЭтоРегламентированныйОтчет ИЛИ ЭтоРегламентированноеУведомление Тогда
		
		// отправляем только из записанной формы
		Если Форма.Модифицированность Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПН_ПослеСохранения",
				ЭтотОбъект,
				ДополнительныеПараметры);
			
			Форма.СохранитьНаКлиенте(, ОписаниеОповещения);
			
		Иначе
			
			ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПН_ПослеСохранения(Истина, ДополнительныеПараметры);
			
		КонецЕсли;
		
	Иначе // электронное представление
		
		Если Форма.Модифицированность Тогда
			ПоказатьПредупреждение(,НСтр("ru = 'Необходимо записать отчет перед отправкой.';
										|en = 'Write the report before sending.'"));
		Иначе
			ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПН_ПослеСохранения(Истина, ДополнительныеПараметры);
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры
		
&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПН_ПослеСохранения(Результат, ДополнительныеПараметры) Экспорт
	
	Форма                        = ДополнительныеПараметры.Форма;
	ОтчетСсылка                  = ДополнительныеПараметры.ОтчетСсылка;
	ОрганизацияОтчета            = ДополнительныеПараметры.ОрганизацияОтчета;
	ЭтоОтправкаИзФормыОтчетность = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	
	Если НЕ ЗначениеЗаполнено(ОтчетСсылка) Тогда
		ОтчетСсылка = ДокументооборотСФСРАРКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
		ДополнительныеПараметры.ОтчетСсылка = ОтчетСсылка;
	КонецЕсли;
	
	ВидОтчетаФормыЭлектронногоПредставления = ?(
		Форма.ИмяФормы = "Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.Форма.ФормаЭлемента", 
		Форма.Объект.ВидОтчета, 
		Неопределено);
	
	ПараметрыПолученияИнформацииОбОтчете = Новый Структура();
	ПараметрыПолученияИнформацииОбОтчете.Вставить("ОтключитьОпределениеНеподписываемыхОтчетов", Ложь);
	ПараметрыПолученияИнформацииОбОтчете.Вставить("ИмяФормы",                                   Форма.ИмяФормы);
	ПараметрыПолученияИнформацииОбОтчете.Вставить("ВидОтчетаФормыЭлектронногоПредставления",    ВидОтчетаФормыЭлектронногоПредставления);

	
	СвойстваОбмена = СвойстваОбменаОрганизацииДляРПННаСервере(
		ОрганизацияОтчета,
		Истина,
		Ложь,
		,
		ОтчетСсылка,
		ПараметрыПолученияИнформацииОбОтчете);
	
	ЭтоЭлектроннаяПодписьВМоделиСервиса = СвойстваОбмена.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	УчетнаяЗапись = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияОтчета);

	ДополнительныеПараметры.Вставить("СвойстваОбмена",                      СвойстваОбмена);
	ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	
	Если НЕ СвойстваОбмена.НастройкиОбмена.ИспользоватьОбмен И НЕ СвойстваОбмена.ЭтоНеподписываемыйОтчет Тогда
		
		Если НЕ СвойстваОбмена.НастроенОбменВУниверсальномФормате Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПН_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(ОтчетСсылка, ОписаниеОповещения);
			
		Иначе
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ОтчетСсылка);
		КонецЕсли;
		
	Иначе	
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПроверкиПодключения(ДополнительныеПараметры);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПроверкиПодключения(ДополнительныеПараметры)
	
	Если ДокументооборотСКОВызовСервера.ИспользуетсяРежимТестирования() Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПроверкиПодключенияЗавершение",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		ПродолжитьОтправкуНаТестовыйСерверРПН(ОписаниеОповещения);
		
	Иначе
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПодтвержденияОтправкиНаТС(ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПроверкиПодключенияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат Тогда
		Возврат;
	КонецЕсли;
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПодтвержденияОтправкиНаТС(ДополнительныеПараметры);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПодтвержденияОтправкиНаТС(ДополнительныеПараметры)
	
	Форма 			= ДополнительныеПараметры.Форма;
	СвойстваОбмена 	= ДополнительныеПараметры.СвойстваОбмена;
	ЭтоОтправкаИзФормыОтчетность = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;

	ОтчетСсылка = ДополнительныеПараметры.ОтчетСсылка;
	
	ДополнительныеПараметры.Вставить("ТипЗнчСсылкаНаОтчет", ТипЗнч(ОтчетСсылка));
	
	Если СвойстваОбмена.НастроенОбменВУниверсальномФормате 
		И СвойстваОбмена.НастройкиОбмена.ИспользоватьАвтонастройку 
		И СвойстваОбмена.ПравоИзмененияУчетнойЗаписи Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНАвтонастройкаУчетнойЗаписиЗавершение",
			ЭтотОбъект,
			ДополнительныеПараметры);
			
		ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(ОтчетСсылка, ОписаниеОповещения);
		
	Иначе
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеАвтонастройкиУчетнойЗаписи(ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНАвтонастройкаУчетнойЗаписиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеАвтонастройкиУчетнойЗаписи(ДополнительныеПараметры);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеАвтонастройкиУчетнойЗаписи(ДополнительныеПараметры)
	
	ТипЗнчСсылкаНаОтчет          = ДополнительныеПараметры.ТипЗнчСсылкаНаОтчет;
	Форма                        = ДополнительныеПараметры.Форма;
	ОтчетСсылка                  = ДополнительныеПараметры.ОтчетСсылка;
	ЭтоОтправкаИзФормыОтчетность = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	
	ЭтоРегламентированныйОтчет = (ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет") ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено"));
	ЭтоРегламентированноеУведомление = (ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.УведомлениеОСпецрежимахНалогообложения"));
	
	Если ЭтоРегламентированныйОтчет ИЛИ ЭтоРегламентированноеУведомление Тогда
		
		// отправляем только из записанной формы
		Если Форма.Модифицированность Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеСохраненияОтчета",
				ЭтотОбъект,
				ДополнительныеПараметры);
			
			Форма.СохранитьНаКлиенте(, ОписаниеОповещения);
			
		Иначе
			
			Если ОтчетСсылка = Неопределено Тогда
				ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // РПН
				Возврат;
			КонецЕсли;
			
			ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеЗаписиОтчета(ДополнительныеПараметры);
			
		КонецЕсли;
		
	Иначе // электронное представление
		
		Если Форма.Модифицированность Тогда
			ПоказатьПредупреждение(,НСтр("ru = 'Необходимо записать отчет перед отправкой.';
										|en = 'Write the report before sending.'"));
		Иначе
			
			Если ОтчетСсылка = Неопределено ИЛИ ОтчетСсылка = ПредопределенноеЗначение("Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.ПустаяСсылка") Тогда
				ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // РПН
				Возврат;
			КонецЕсли;
			
			ПоляДляЗаписиОтправки = ПоляДляЗаписиОтправкиВРПННаСервере(ОтчетСсылка);
			
			ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки", ПоляДляЗаписиОтправки);
			ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПодготовкиДанныхДляЗаписиОтправки(ДополнительныеПараметры);

		КонецЕсли;
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеСохраненияОтчета(Результат, ДополнительныеПараметры) Экспорт
	
	Форма                               = ДополнительныеПараметры.Форма;
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ОрганизацияОтчета                   = ДополнительныеПараметры.ОрганизацияОтчета;
	ЭтоОтправкаИзФормыОтчетность        = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	
	// если не удалось сохранить - возврат
	Если Результат = Ложь Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // РПН
		Возврат;
	КонецЕсли;
	
	// если отчет не был записан ранее, то получим ссылку на записанный отчет
	Если НЕ ЗначениеЗаполнено(ОтчетСсылка) Тогда
		
		Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
			ОтчетСсылка = ДокументооборотСРПНКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
			ДополнительныеПараметры.ОтчетСсылка = ОтчетСсылка;
		КонецЕсли;
		
		Если ОтчетСсылка = Неопределено Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // РПН
			Возврат;
		КонецЕсли;
	
	КонецЕсли;
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеЗаписиОтчета(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеЗаписиОтчета(ДополнительныеПараметры)
	
	ТипЗнчСсылкаНаОтчет          = ДополнительныеПараметры.ТипЗнчСсылкаНаОтчет;
	Форма                        = ДополнительныеПараметры.Форма;
	ОтчетСсылка                  = ДополнительныеПараметры.ОтчетСсылка;
	ЭтоОтправкаИзФормыОтчетность = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	
	ЭтоРегламентированноеУведомление = (ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.УведомлениеОСпецрежимахНалогообложения"));
	
	ПоляДляЗаписиОтправки = Новый Структура();
	
	Если ЭтоОтправкаИзФормыОтчетность Тогда
		
		Если НЕ ЭтоРегламентированноеУведомление Тогда
			ЗначенияРеквизитов = ЗначенияРеквизитовОбъекта(ОтчетСсылка, "ДатаНачала, ДатаОкончания, Вид");
			
			ПоляДляЗаписиОтправки.Вставить("ДатаНачалаПериода",    НачалоДня(ЗначенияРеквизитов.ДатаНачала));
			ПоляДляЗаписиОтправки.Вставить("ДатаОкончанияПериода", КонецДня(ЗначенияРеквизитов.ДатаОкончания));
			ПоляДляЗаписиОтправки.Вставить("Версия",               ЗначенияРеквизитов.Вид);
			
		Иначе
			ЗначениеРеквизитаДата = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЗначениеРеквизитаОбъекта(ОтчетСсылка, "Дата");
			
			ПоляДляЗаписиОтправки.Вставить("ДатаНачалаПериода",    НачалоГода(ЗначениеРеквизитаДата));
			ПоляДляЗаписиОтправки.Вставить("ДатаОкончанияПериода", КонецГода(ЗначениеРеквизитаДата));
			ПоляДляЗаписиОтправки.Вставить("Версия",               0);
		КонецЕсли;
		
	Иначе
		
		Если НЕ ЭтоРегламентированноеУведомление Тогда
			ПоляДляЗаписиОтправки.Вставить("ДатаНачалаПериода",    Форма.СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета);
			ПоляДляЗаписиОтправки.Вставить("ДатаОкончанияПериода", Форма.СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
			ПоляДляЗаписиОтправки.Вставить("Версия",               Форма.СтруктураРеквизитовФормы.ВидДокумента * Форма.НомерКорректировки);
			
		Иначе
			ПоляДляЗаписиОтправки.Вставить("ДатаНачалаПериода",    НачалоГода(Форма.Объект.Дата));
			ПоляДляЗаписиОтправки.Вставить("ДатаОкончанияПериода", КонецГода(Форма.Объект.Дата));
			ПоляДляЗаписиОтправки.Вставить("Версия",               0);
		КонецЕсли;
		
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки", ПоляДляЗаписиОтправки);
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПодготовкиДанныхДляЗаписиОтправки(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПодготовкиДанныхДляЗаписиОтправки(ДополнительныеПараметры)
	
	ОтчетСсылка = ДополнительныеПараметры.ОтчетСсылка;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПодготовкиДанныхДляЗаписиОтправки_ПослеНастройкиЗаявления", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	ЗавершитьНастройкуЗаявленияНаИзменение(ОтчетСсылка, ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПодготовкиДанныхДляЗаписиОтправки_ПослеНастройкиЗаявления(Результат, ВходящийКонтекст) Экспорт	
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПодготовкиДанныхДляЗаписиОтправки_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ВходящийКонтекст.ОтчетСсылка, ВходящийКонтекст.ОрганизацияОтчета, "РПН");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПодготовкиДанныхДляЗаписиОтправки_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		Возврат;
	КонецЕсли;	
	
	Форма       = ВходящийКонтекст.Форма;
	ОтчетСсылка = ВходящийКонтекст.ОтчетСсылка;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПодготовкиДанныхДляЗаписиОтправкиЗавершение",
		ЭтотОбъект,
		ВходящийКонтекст);
		
	// при отправке из списка подтверждение запрашивается перед запуском отправки для предотвращения попадания сообщений в диалог подтверждения
	Если Форма = Неопределено ИЛИ Форма.ИмяФормы <> "ОбщаяФорма.РегламентированнаяОтчетность" Тогда
		
		// запрашиваем подтверждение
		ПараметрыФормы = Новый Структура("СсылкаНаОтчет", ОтчетСсылка);
	
		ОткрытьФорму(
			ПутьКОбъекту + ".Форма.ПодтверждениеОтправкиОтчета",
			ПараметрыФормы,
			,
			,
			,
			,
			ОписаниеОповещения,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.ОК);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПодготовкиДанныхДляЗаписиОтправкиЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ОтчетСсылка = ДополнительныеПараметры.ОтчетСсылка;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПодтвержденияЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	ПодтвердитьПовторнуюОтправку(ОтчетСсылка, "РПН", ОписаниеОповещения);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПодтвержденияЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	ОрганизацияОтчета                   = ДополнительныеПараметры.ОрганизацияОтчета;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ЭтоОтправкаИзФормыОтчетность 		= ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	Форма								= ДополнительныеПараметры.Форма;
	
	ДлительнаяОтправкаКлиент.ЗапретитьВыводСостояния();
	РезультатВыгрузки = ВыгрузитьОтчетДляОтправкиВРПН(
		ОтчетСсылка, 
		Форма, 
		ЭтоОтправкаИзФормыОтчетность);
		
	ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();

	Если РезультатВыгрузки = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось выгрузить отчет.';
															|en = 'Cannot export the report.'"));
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки", 	РезультатВыгрузки.ТекстФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки", 	РезультатВыгрузки.ИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("Кодировка", 			РезультатВыгрузки.Кодировка);
	ДополнительныеПараметры.Вставить("ТипЗнчСсылкаНаОтчет", ТипЗнч(ОтчетСсылка));
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеИнициализации",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	КонтекстДлительнойОперации = Новый Структура;
	КонтекстДлительнойОперации.Вставить("ОписаниеОповещения", 					ОписаниеОповещения);
	КонтекстДлительнойОперации.Вставить("ОрганизацияОтчета", 					ОрганизацияОтчета);
	КонтекстДлительнойОперации.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", 	ЭтоЭлектроннаяПодписьВМоделиСервиса);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= ОтчетСсылка;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 3;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;

	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка отчета в РПН
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПодтвержденияЗавершение",  0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеПодтвержденияЗавершение() Экспорт
	
	КонтекстДлительнойОперации = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	ОрганизацияОтчета 					= КонтекстДлительнойОперации.ОрганизацияОтчета;
	ОписаниеОповещения 					= КонтекстДлительнойОперации.ОписаниеОповещения;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = КонтекстДлительнойОперации.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	
	ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);

	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеИнициализации(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // РПН
		Возврат;
	КонецЕсли;
		
	СертификатыИПараметрыОбмена = Неопределено;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеВыгрузкиПакета",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	Форма                               = ДополнительныеПараметры.Форма;
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ОрганизацияОтчета                   = ДополнительныеПараметры.ОрганизацияОтчета;
	ЭтоОтправкаИзФормыОтчетность        = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ТекстФайлаВыгрузки                  = ДополнительныеПараметры.ТекстФайлаВыгрузки;
	ИмяФайлаВыгрузки                    = ДополнительныеПараметры.ИмяФайлаВыгрузки;
	Кодировка                           = ДополнительныеПараметры.Кодировка;

	ВыгрузитьПакетДляОтправкиВРПН(
		Форма,
		ОписаниеОповещения,
		Ложь,
		ТекстФайлаВыгрузки,
		ИмяФайлаВыгрузки,
		Кодировка,
		СертификатыИПараметрыОбмена,
		ЭтоОтправкаИзФормыОтчетность,
		ОтчетСсылка,
		ОрганизацияОтчета);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеВыгрузкиПакета(Результат, ДополнительныеПараметры) Экспорт	
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // РПН
		Возврат;
	КонецЕсли;
	
	СертификатыИПараметрыОбмена         = Результат.СертификатыИПараметрыОбмена;
	Форма                               = ДополнительныеПараметры.Форма;
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ПоляДляЗаписиОтправки               = ДополнительныеПараметры.ПоляДляЗаписиОтправки;
	ОрганизацияОтчета                   = ДополнительныеПараметры.ОрганизацияОтчета;
	ПараметрыФормированияПакета         = СертификатыИПараметрыОбмена.ПараметрыФормированияПакета;
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		
		СтрокаBase64ФайлаПакета = Результат.РезультатВыгрузки.ИмяФайлаЗашифрованногоПакета;
		КороткоеИмяФайлаПакета  = Результат.РезультатВыгрузки.ИмяФайлаВыгрузки;
		
		Результат = Новый Структура();
		Результат.Вставить("Выполнено",      Истина);
		Результат.Вставить("ДвоичныеДанные", Неопределено);
		Результат.Вставить("СтрокаBase64",   СтрокаBase64ФайлаПакета);
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ОрганизацияОтчета",                   ОрганизацияОтчета);
		ДополнительныеПараметры.Вставить("ОтчетСсылка",                         ОтчетСсылка);
		ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки",               ПоляДляЗаписиОтправки);
		ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена",         СертификатыИПараметрыОбмена);
		ДополнительныеПараметры.Вставить("ПараметрыФормированияПакета",         ПараметрыФормированияПакета);
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаПакета",              КороткоеИмяФайлаПакета);
		ДополнительныеПараметры.Вставить("Форма",                               Форма);
		ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);

		Оповещение = Новый ОписаниеОповещения(
			"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеЧтенияФайлаПакета",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		ВыполнитьОбработкуОповещения(Оповещение, Результат);
		
	Иначе
		
		Крипт = СертификатыИПараметрыОбмена.Крипт;
		
		КороткоеИмяФайлаПакета = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(Результат.РезультатВыгрузки).Имя;
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ОрганизацияОтчета",                   ОрганизацияОтчета);
		ДополнительныеПараметры.Вставить("ОтчетСсылка",                         ОтчетСсылка);
		ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки",               ПоляДляЗаписиОтправки);
		ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена",         СертификатыИПараметрыОбмена);
		ДополнительныеПараметры.Вставить("ПараметрыФормированияПакета",         ПараметрыФормированияПакета);
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаПакета",              КороткоеИмяФайлаПакета);
		ДополнительныеПараметры.Вставить("Форма",                               Форма);
		ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
		
		Оповещение = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеЧтенияФайлаПакета", ЭтотОбъект, ДополнительныеПараметры);
		
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, Результат.РезультатВыгрузки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеЧтенияФайлаПакета(Результат, ДополнительныеПараметры) Экспорт
	
	ОрганизацияОтчета                   = ДополнительныеПараметры.ОрганизацияОтчета;
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	ПоляДляЗаписиОтправки               = ДополнительныеПараметры.ПоляДляЗаписиОтправки;
	СертификатыИПараметрыОбмена         = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ПараметрыФормированияПакета         = ДополнительныеПараметры.ПараметрыФормированияПакета;
	КороткоеИмяФайлаПакета              = ДополнительныеПараметры.КороткоеИмяФайлаПакета;
	Форма                               = ДополнительныеПараметры.Форма;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	
	Если НЕ Результат.Выполнено Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // РПН
		Возврат;
	КонецЕсли;
	
	СтрокаBase64ФайлаПакета = Результат.СтрокаBase64;
	
	СтрокаBase64ФайлаОтправки = СформироватьФайлОтправкиВРПННаСервере(
		КороткоеИмяФайлаПакета,
		СтрокаBase64ФайлаПакета,
		ЭтоЭлектроннаяПодписьВМоделиСервиса,
		Форма.УникальныйИдентификатор);
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние(НСтр("ru = 'Отправка отчета ...';
													|en = 'Sending report...'")); // РПН
	
	ФормаДлительнаяОперация = Неопределено;
	
	ПараметрыОтправки = Новый Структура();
	ПараметрыОтправки.Вставить("Организация",             ОрганизацияОтчета);
	ПараметрыОтправки.Вставить("АдресСервера",            СерверПриемаОтчетностиРПН(Истина));
	ПараметрыОтправки.Вставить("ПоляДляЗаписиОтправки",   ПоляДляЗаписиОтправки);
	ПараметрыОтправки.Вставить("ЭтоНеподписываемыйОтчет", СертификатыИПараметрыОбмена.ЭтоНеподписываемыйОтчет);
	ПараметрыОтправки.Вставить("БумажнаяПодачаОтчета",    СертификатыИПараметрыОбмена.БумажнаяПодачаОтчета);
		
	ПараметрыСоединения = Новый Структура();
	ПараметрыСоединения.Вставить("EMail",                          ПараметрыФормированияПакета.EMail);
	ПараметрыСоединения.Вставить("Пароль",                         ПараметрыФормированияПакета.Пароль);
	ПараметрыСоединения.Вставить("СохранитьПароль",                ЗначениеЗаполнено(ПараметрыФормированияПакета.Пароль));
	ПараметрыСоединения.Вставить("СохраненныйEmail",               ПараметрыФормированияПакета.EMail);
	ПараметрыСоединения.Вставить("СохраненныйПароль",              ПараметрыФормированияПакета.Пароль);
	ПараметрыСоединения.Вставить("СоединениеHTTP",                 Неопределено);
	ПараметрыСоединения.Вставить("ЗначениеCookie",                 "");
	ПараметрыСоединения.Вставить("ИдентификаторОтправкиНаСервере", "");
	ПараметрыСоединения.Вставить("ОписаниеОшибкиСервером",         "");
	ПараметрыСоединения.Вставить("ПовторятьСоединение",            Истина);
	ПараметрыСоединения.Вставить("ПовторятьЗапросПароля",          ПараметрыФормированияПакета.ОбменНапрямую);
	ПараметрыСоединения.Вставить("СообщенияПользователю",          Новый Массив);
	ПараметрыСоединения.Вставить("ОбменНапрямую",                  ПараметрыФормированияПакета.ОбменНапрямую);
	ПараметрыСоединения.Вставить("ИдентификаторОтправкиОператору", Неопределено);
		
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНОтправкаВЦикле(
		ОтчетСсылка,
		ЭтоЭлектроннаяПодписьВМоделиСервиса,
		ПараметрыОтправки,
		ПараметрыСоединения,
		ФормаДлительнаяОперация,
		СтрокаBase64ФайлаОтправки,
		СтрокаBase64ФайлаПакета,
		КороткоеИмяФайлаПакета,
		Форма);
	
КонецПроцедуры

// Цикл Пока ПараметрыСоединения.ПовторятьСоединение (Цикл) 
&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНОтправкаВЦикле(
		ОтчетСсылка,
		ЭтоЭлектроннаяПодписьВМоделиСервиса,
		ПараметрыОтправки,
		ПараметрыСоединения,
		ФормаДлительнаяОперация,
		СтрокаBase64ФайлаОтправки,
		СтрокаBase64ФайлаПакета,
		КороткоеИмяФайлаПакета,
		Форма)
		
	РезультатОтправки = Неопределено;
	ПараметрыСоединения.ЗначениеCookie = "";
	
	ПерваяПопыткаАвторизации = Истина;
	Если ПараметрыСоединения.ОбменНапрямую Тогда
		ПараметрыСоединения.ПовторятьЗапросПароля = Истина;
	КонецЕсли;
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНВводПароля(
		ОтчетСсылка,
		ЭтоЭлектроннаяПодписьВМоделиСервиса,
		ПараметрыОтправки,
		ПараметрыСоединения,
		ФормаДлительнаяОперация,
		СтрокаBase64ФайлаОтправки,
		СтрокаBase64ФайлаПакета,
		КороткоеИмяФайлаПакета,
		РезультатОтправки,
		ПерваяПопыткаАвторизации,
		Форма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНВводПароля(
		ОтчетСсылка,
		ЭтоЭлектроннаяПодписьВМоделиСервиса,
		ПараметрыОтправки,
		ПараметрыСоединения,
		ФормаДлительнаяОперация,
		СтрокаBase64ФайлаОтправки,
		СтрокаBase64ФайлаПакета,
		КороткоеИмяФайлаПакета,
		РезультатОтправки,
		ПерваяПопыткаАвторизации,
		Форма)
	
	Если ПараметрыСоединения.ОбменНапрямую 
		И (НЕ ЗначениеЗаполнено(ПараметрыСоединения.EMail) ИЛИ НЕ ЗначениеЗаполнено(ПараметрыСоединения.Пароль) ИЛИ НЕ ПерваяПопыткаАвторизации) Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОтчетСсылка",                         ОтчетСсылка);
		ДополнительныеПараметры.Вставить("ПараметрыСоединения",                 ПараметрыСоединения);
		ДополнительныеПараметры.Вставить("ПараметрыОтправки",                   ПараметрыОтправки);
		ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация",             ФормаДлительнаяОперация);
		ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
		ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаОтправки",           СтрокаBase64ФайлаОтправки);
		ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаПакета",             СтрокаBase64ФайлаПакета);
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаПакета",              КороткоеИмяФайлаПакета);
		ДополнительныеПараметры.Вставить("РезультатОтправки",                   РезультатОтправки);
		ДополнительныеПараметры.Вставить("ПерваяПопыткаАвторизации",            ПерваяПопыткаАвторизации);
		ДополнительныеПараметры.Вставить("Форма",                               Форма);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНВводПароляЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ВызватьФормуВводаПароляПорталаРПН(
			"https://" + ПараметрыОтправки.АдресСервера + "/",
			ПараметрыСоединения.EMail,
			ПараметрыСоединения.Пароль,
			ПараметрыСоединения.СохранитьПароль,
			ОписаниеОповещения);
		
		Возврат;
	КонецЕсли;
	
	РезультатОтправки = ОтправитьВРПННаСервере(
		ЭтоЭлектроннаяПодписьВМоделиСервиса,
		СтрокаBase64ФайлаОтправки,
		СтрокаBase64ФайлаПакета,
		КороткоеИмяФайлаПакета,
		ОтчетСсылка,
		ПараметрыОтправки,
		ПараметрыСоединения);
	
	ДлительнаяОтправкаКлиент.ВывестиСообщенияССервераНаКлиенте(ПараметрыСоединения.СообщенияПользователю);
	
	ПерваяПопыткаАвторизации = Ложь;
	
	// рекурсивный вызов - замена цикла
	Если РезультатОтправки = Неопределено И ПараметрыСоединения.ПовторятьЗапросПароля Тогда
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНВводПароля(
			ОтчетСсылка,
			ЭтоЭлектроннаяПодписьВМоделиСервиса,
			ПараметрыОтправки,
			ПараметрыСоединения,
			ФормаДлительнаяОперация,
			СтрокаBase64ФайлаОтправки,
			СтрокаBase64ФайлаПакета,
			КороткоеИмяФайлаПакета,
			РезультатОтправки,
			ПерваяПопыткаАвторизации,
			Форма);
			
	Иначе
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеОтправки(
			ОтчетСсылка,
			ЭтоЭлектроннаяПодписьВМоделиСервиса,
			ПараметрыОтправки,
			ПараметрыСоединения,
			ФормаДлительнаяОперация,
			СтрокаBase64ФайлаОтправки,
			СтрокаBase64ФайлаПакета,
			КороткоеИмяФайлаПакета,
			РезультатОтправки,
			Форма);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНВводПароляЗавершение(РезультатВводаПароля, ДополнительныеПараметры) Экспорт
	
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	ПараметрыСоединения                 = ДополнительныеПараметры.ПараметрыСоединения;
	ПараметрыОтправки                   = ДополнительныеПараметры.ПараметрыОтправки;
	ФормаДлительнаяОперация             = ДополнительныеПараметры.ФормаДлительнаяОперация;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	СтрокаBase64ФайлаОтправки           = ДополнительныеПараметры.СтрокаBase64ФайлаОтправки;
	СтрокаBase64ФайлаПакета             = ДополнительныеПараметры.СтрокаBase64ФайлаПакета;
	КороткоеИмяФайлаПакета              = ДополнительныеПараметры.КороткоеИмяФайлаПакета;
	РезультатОтправки                   = ДополнительныеПараметры.РезультатОтправки;
	ПерваяПопыткаАвторизации            = ДополнительныеПараметры.ПерваяПопыткаАвторизации;
	Форма                               = ДополнительныеПараметры.Форма;
	
	Если РезультатВводаПароля = Неопределено Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // РПН
		Возврат;
	Иначе
		
		ПараметрыСоединения.EMail           = РезультатВводаПароля.EMail;
		ПараметрыСоединения.Пароль          = РезультатВводаПароля.Пароль;
		ПараметрыСоединения.СохранитьПароль = РезультатВводаПароля.СохранитьПароль;
		
		РезультатОтправки = ОтправитьВРПННаСервере(
			ЭтоЭлектроннаяПодписьВМоделиСервиса,
			СтрокаBase64ФайлаОтправки,
			СтрокаBase64ФайлаПакета,
			КороткоеИмяФайлаПакета,
			ОтчетСсылка,
			ПараметрыОтправки,
			ПараметрыСоединения);
		
		ДлительнаяОтправкаКлиент.ВывестиСообщенияССервераНаКлиенте(ПараметрыСоединения.СообщенияПользователю);
			
		ПерваяПопыткаАвторизации = Ложь;
		
		Если РезультатОтправки = Неопределено И ПараметрыСоединения.ПовторятьЗапросПароля Тогда
			
			ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНВводПароля(
				ОтчетСсылка,
				ЭтоЭлектроннаяПодписьВМоделиСервиса,
				ПараметрыОтправки,
				ПараметрыСоединения,
				ФормаДлительнаяОперация,
				СтрокаBase64ФайлаОтправки,
				СтрокаBase64ФайлаПакета,
				КороткоеИмяФайлаПакета,
				РезультатОтправки,
				ПерваяПопыткаАвторизации,
				Форма);
				
		Иначе
			
			ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеОтправки(
				ОтчетСсылка,
				ЭтоЭлектроннаяПодписьВМоделиСервиса,
				ПараметрыОтправки,
				ПараметрыСоединения,
				ФормаДлительнаяОперация,
				СтрокаBase64ФайлаОтправки,
				СтрокаBase64ФайлаПакета,
				КороткоеИмяФайлаПакета,
				РезультатОтправки,
				Форма);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНПослеОтправки(
		ОтчетСсылка,
		ЭтоЭлектроннаяПодписьВМоделиСервиса,
		ПараметрыОтправки,
		ПараметрыСоединения,
		ФормаДлительнаяОперация,
		СтрокаBase64ФайлаОтправки,
		СтрокаBase64ФайлаПакета,
		КороткоеИмяФайлаПакета,
		РезультатОтправки,
		Форма)
	
	Если РезультатОтправки <> Неопределено Тогда
		
		ПараметрыАвтозапроса = Новый Структура();
		ПараметрыАвтозапроса.Вставить("Ключ",           РезультатОтправки);
		ПараметрыАвтозапроса.Вставить("ЗначениеCookie", ПараметрыСоединения.ЗначениеCookie);
		ПараметрыАвтозапроса.Вставить("EMail",          ПараметрыСоединения.EMail);
		ПараметрыАвтозапроса.Вставить("Пароль",         ПараметрыСоединения.Пароль);

		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ПараметрыАвтозапроса", ПараметрыАвтозапроса);
			
		ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // РПН.
		
	ИначеЕсли ПараметрыСоединения.ПовторятьСоединение Тогда
		
		// не получено файла результата при отправке пакета. Возможно, проблемы с доступом в интернет
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОтчетСсылка",                         ОтчетСсылка);
		ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
		ДополнительныеПараметры.Вставить("ПараметрыОтправки",                   ПараметрыОтправки);
		ДополнительныеПараметры.Вставить("ПараметрыСоединения",                 ПараметрыСоединения);
		ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация",             ФормаДлительнаяОперация);
		ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаОтправки",           СтрокаBase64ФайлаОтправки);
		ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаПакета",             СтрокаBase64ФайлаПакета);
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаПакета",              КороткоеИмяФайлаПакета);
		ДополнительныеПараметры.Вставить("Форма",                               Форма);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПриНажатииНаКнопкуОтправкиВРПНПослеПоказаОшибкиДоступаВИнтернет", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(
			НСтр("ru = 'Не удалось обратиться к серверу Росприроднадзора';
				|en = 'Cannot contact the server of the Federal Supervisory Natural Resources Management Service'"), 
			ОписаниеОповещения);
			
	Иначе
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // РПН.
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВРПНПослеПоказаОшибкиДоступаВИнтернет(РезультатДиалогаОбОшибкеДоступа, ДополнительныеПараметры) Экспорт
	
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ПараметрыОтправки                   = ДополнительныеПараметры.ПараметрыОтправки;
	ПараметрыСоединения                 = ДополнительныеПараметры.ПараметрыСоединения;
	ФормаДлительнаяОперация             = ДополнительныеПараметры.ФормаДлительнаяОперация;
	СтрокаBase64ФайлаОтправки           = ДополнительныеПараметры.СтрокаBase64ФайлаОтправки;
	СтрокаBase64ФайлаПакета             = ДополнительныеПараметры.СтрокаBase64ФайлаПакета;
	КороткоеИмяФайлаПакета              = ДополнительныеПараметры.КороткоеИмяФайлаПакета;
	Форма                               = ДополнительныеПараметры.Форма;
	
	ПараметрыСоединения.ПовторятьСоединение = (РезультатДиалогаОбОшибкеДоступа = Истина);
	
	// рекурсивный вызов - замена цикла
	Если ПараметрыСоединения.ПовторятьСоединение Тогда
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляРПНОтправкаВЦикле(
			ОтчетСсылка,
			ЭтоЭлектроннаяПодписьВМоделиСервиса,
			ПараметрыОтправки,
			ПараметрыСоединения,
			ФормаДлительнаяОперация,
			СтрокаBase64ФайлаОтправки,
			СтрокаBase64ФайлаПакета,
			КороткоеИмяФайлаПакета,
			Форма);
			
	Иначе
			
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("НетДоступаВИнтернет", Истина);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // РПН. Нет доступа в Интернет.
		
	КонецЕсли;
	
КонецПроцедуры
// Цикл Пока ПараметрыСоединения.ПовторятьСоединение (КонецЦикла)

&НаКлиенте
Процедура ВызватьФормуВводаПароляПорталаРПН(Портал, EMail, Пароль, СохранитьПароль, ВыполняемоеОповещение = Неопределено)
	
	ПараметрыФормы = Новый Структура("Портал, EMail, Пароль, СохранитьПароль", Портал, EMail, Пароль, СохранитьПароль);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВызватьФормуВводаПароляПорталаРПНЗавершение", ЭтотОбъект, ВыполняемоеОповещение);
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ВводПароляРПН", ПараметрыФормы,,,,, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВызватьФормуВводаПароляПорталаРПНЗавершение(РезультатФормы, ВыполняемоеОповещение) Экспорт
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПротоколОбработкиПоСсылкеИсточникаДляРПН(ИсточникСсылка, ПечатьВозможна = Истина) Экспорт
	
	ВАрхиве = ОбъектВАрхиве(ИсточникСсылка, "Протокол");
	Если ВАрхиве Тогда 
		ПоказатьУведомлениеАрхивныхФайлов(, 16, 0, Истина);
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ИсточникСсылка",      ИсточникСсылка);
	ПараметрыФормы.Вставить("ПечатьВозможна",      ПечатьВозможна);
	ПараметрыФормы.Вставить("КонтролирующийОрган", ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.РПН"));
		
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ПротоколОбработкиHTML", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОтправкуНаТестовыйСерверРПН(ВыполняемоеОповещение) Экспорт
	
	ПродолжитьОтправкуНаТестовыйСерверРПН = Ложь;
	
	Если ДокументооборотСКОВызовСервера.ИспользуетсяРежимТестирования() Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьОтправкуНаТестовыйСерверРПНЗавершение", ЭтотОбъект, ВыполняемоеОповещение);
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Внимание! Включен режим тестирования!
			|
			|В режиме тестирования отчетность отправляется через тестовый портал Росприроднадзора.
			|Сдача отчетности засчитана не будет.
			|
			|Продолжить отправку?';
			|en = 'Warning! Test mode is enabled.
			|
			|In the test mode, reporting is sent via Federal Supervisory Natural Resources Management Service test portal.
			|Reporting will not be submitted.
			|
			|Continue sending?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, ПродолжитьОтправкуНаТестовыйСерверРПН);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОтправкуНаТестовыйСерверРПНЗавершение(Ответ, ВыполняемоеОповещение) Экспорт
	
	ПродолжитьОтправкуНаТестовыйСерверРПН = (Ответ = КодВозвратаДиалога.Да);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, ПродолжитьОтправкуНаТестовыйСерверРПН);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбновитьРегистрыСведенийНастройкиОбменаРПН(Организация, ОтпечатокСертификата, СертификатРПНОтпечаток, ВыводитьСообщения, EMail, Пароль)
	
	Попытка
		ОбменРПН = РегистрыСведений.НастройкиОбменаРПН.СоздатьМенеджерЗаписи();
		ОбменРПН.Организация = Организация;
		ОбменРПН.ИспользоватьОбмен = Истина;
		ОбменРПН.СертификатАбонентаОтпечаток = ОтпечатокСертификата;
		ОбменРПН.СертификатРПНОтпечаток = СертификатРПНОтпечаток;
		ОбменРПН.ИспользоватьАвтонастройку = Истина;
		ОбменРПН.EMail = EMail;
		ОбменРПН.Пароль = Пароль;
		ОбменРПН.Записать();
		Если ВыводитьСообщения Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				НСтр("ru = 'Обновлены параметры отправки отчетности в Росприроднадзор.';
					|en = 'Parameters of sending reporting to Federal Supervisory Natural Resources Management Service are updated.'"));
		КонецЕсли;
		
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось обновить параметры отправки отчетности в Росприроднадзор по причине:
                  |%1';
                  |en = 'Cannot update parameters of sending reporting to Federal Supervisory Natural Resources Management Service due to:
                  |%1'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьФайлОтправкиВРПННаСервере(КороткоеИмяФайлаВыгрузки, СтрокаBase64ФайлаВыгрузки, ЭтоАдреса = Истина, Адрес = Неопределено)
	
	КонтекстЭДО = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДО.СформироватьФайлОтправкиВРПНССервера(КороткоеИмяФайлаВыгрузки, СтрокаBase64ФайлаВыгрузки, ЭтоАдреса, Адрес);
	
КонецФункции

&НаСервереБезКонтекста
Функция ОбновитьРезультатКонкретнойОтправкиРПННаСервере(Знач ОтправкаСсылка, Знач ОтправкаОбъектЗагружен, Знач ПараметрыОтправки, ПараметрыСоединения, ЭтоВызовИзСписка)
	
	КонтекстЭДО = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
