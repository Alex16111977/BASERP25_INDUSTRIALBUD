///////////////////////////////////////////////////////////////////////////////
// Представление уведомлений в налоговые органы

#Область ОтправкаУведомлениеФНС

&НаСервереБезКонтекста
Функция ОтправкаУведомлениеФНС_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст, РезультатВыгрузкиУведомления, ПриложенияУведомления)
	
	УведомлениеСсылка = Контекст.Документ;
	
	ЭтоУведомлениеОКонтролируемыхСделках 	= Ложь;
	ЭтоИсходящееУведомлениеФНС 				= Ложь;
	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(УведомлениеСсылка);
	ИмяДокументаУведомлениеОКонтролируемыхСделках 	= ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных("УведомлениеОКонтролируемыхСделках");
	ИмяДокументаИсходящееУведомлениеФНС 			= "УведомлениеОСпецрежимахНалогообложения";
	
	Если ИмяДокументаУведомлениеОКонтролируемыхСделках <> Неопределено И ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка." + ИмяДокументаУведомлениеОКонтролируемыхСделках) Тогда
		ЭтоУведомлениеОКонтролируемыхСделках = Истина;
	ИначеЕсли ИмяДокументаИсходящееУведомлениеФНС <> Неопределено И ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка." + ИмяДокументаИсходящееУведомлениеФНС) Тогда
		ЭтоИсходящееУведомлениеФНС = Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УведомлениеСсылка, "Организация");
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбрана организация-отправитель.';
								|en = 'The sender company is not selected.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);
		Возврат Ложь;
		
	КонецЕсли;

	// проверяем, предназначена ли эта учетная запись для документооборота с ФНС
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);
		Возврат Ложь;
		
	ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ПредназначенаДляДокументооборотаСФНС") <> Истина Тогда
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("НаправлениеНеПодключено", Истина);
		Возврат Ложь;
	КонецЕсли;
		
	ФайлДоверенности = Неопределено;
	КороткоеИмяФайлаДоверенности = Неопределено;
	
	//Определяем Регистрацию ИФНС и Налоговый орган
	Если ЭтоУведомлениеОКонтролируемыхСделках Тогда
		// это уведомление о контролируемых сделках
		
		// ищем РегистрацияВИФНС по организации и коду налогового органа
		КодНалоговогоОргана = СокрЛП(РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Организация, , "КодНО").КодНО);
		Если НЕ ЗначениеЗаполнено(КодНалоговогоОргана) Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось определить налоговый орган, в который представляется отчетность!';
									|en = 'Cannot determine a tax authority to which the reporting is submitted.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		НалоговыйОрган = Справочники.НалоговыеОрганы.НайтиПоКоду(КодНалоговогоОргана);
		Если НЕ ЗначениеЗаполнено(НалоговыйОрган) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не найден налоговый орган с кодом %1  в справочнике налоговых органов""!.';
				|en = 'Tax authority with code %1 is not found in the tax authority catalog"".'"), Символ(34) + КодНалоговогоОргана + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		ЭлРегистрацияВИФНС = РегистрацияВИФНСПоОрганизацииИКодуНО(Организация, КодНалоговогоОргана);
		
	ИначеЕсли ЭтоИсходящееУведомлениеФНС Тогда
		// это исходящее уведомление ФНС
		
		Если ТипЗнч(УведомлениеСсылка) = Тип("ДокументСсылка.УведомлениеОСпецрежимахНалогообложения") Тогда
			ЭлРегистрацияВИФНС = УведомлениеСсылка.РегистрацияВИФНС;
		Иначе 
			ЭлРегистрацияВИФНС = Неопределено;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЭлРегистрацияВИФНС) Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось определить налоговый орган, в который представляется отчетность!';
									|en = 'Cannot determine a tax authority to which the reporting is submitted.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		КодНалоговогоОргана = ЭлРегистрацияВИФНС.Код;
		Если НЕ ЗначениеЗаполнено(КодНалоговогоОргана) Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось определить налоговый орган, в который представляется отчетность!';
									|en = 'Cannot determine a tax authority to which the reporting is submitted.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		НалоговыйОрган = Справочники.НалоговыеОрганы.НайтиПоКоду(КодНалоговогоОргана);
		Если НЕ ЗначениеЗаполнено(НалоговыйОрган) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не найден налоговый орган с кодом %1  в справочнике налоговых органов""!.';
				|en = 'Tax authority with code %1 is not found in the tax authority catalog"".'"), Символ(34) + КодНалоговогоОргана + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭлРегистрацияВИФНС) И ЗначениеЗаполнено(ЭлРегистрацияВИФНС.Доверенность) Тогда
		
		// формируем файл доверенности
		ФайлДоверенности = ВыгрузитьДоверенностьПредставление(ЭлРегистрацияВИФНС, КороткоеИмяФайлаДоверенности, Организация);
		Если НЕ ЗначениеЗаполнено(ФайлДоверенности) Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	НачатьТранзакцию();
		
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбменаСсылка = Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСФНС;
	ЦиклОбмена.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСФНС.Приказ534;
	ЦиклОбмена.Предмет = УведомлениеСсылка;
	ЦиклОбмена.Идентификатор = СгенерироватьUUID();
	ЦиклОбмена.Организация = Организация;
	ЦиклОбмена.УчетнаяЗапись = УчетнаяЗапись;
	ЦиклОбмена.ВнешняяОрганизация = НалоговыйОрган;
	ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Представление;
	
	//определяем вид отправляемого докумнта
	Если ЭтоУведомлениеОКонтролируемыхСделках Тогда
		ЦиклОбмена.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.УведомлениеОКонтролируемыхСделках;
	ИначеЕсли ЭтоИсходящееУведомлениеФНС Тогда 
		ЦиклОбмена.ВидОтчета = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьВидОтправляемогоДокументаПоСсылке(УведомлениеСсылка);
	КонецЕсли;
	
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена = ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ПредставлениеНП;
	ТранспортноеСообщение.Отправитель = Организация;
	ТранспортноеСообщение.Получатель = НалоговыйОрган;
	ТранспортноеСообщение.УчетнаяЗапись = УчетнаяЗапись;
	ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Исходящее;
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	// ДОБАВЛЯЕМ ВЛОЖЕНИЯ
	//добавляем файл Представление
	ДанныеФайлаПредставление = РезультатВыгрузкиУведомления;
	ИмяФайлаПредставления = ДанныеФайлаПредставление.ИмяФайлаВыгрузки;
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайлаПредставление.АдресФайлаВыгрузки);
	
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Представление, ДвоичныеДанныеФайла, ИмяФайлаПредставления, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml) Тогда
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	// добавляем приложения к уведомлению
	Для каждого ПриложениеУведомления Из ПриложенияУведомления Цикл
		ДвоичныеДанныеПриложения = ПолучитьИзВременногоХранилища(ПриложениеУведомления.АдресФайлаВыгрузки);
		РезультатДобавления = ДобавитьСодержимоеТранспортногоКонтейнера(
			ТранспортноеСообщение.Ссылка,
			Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение,
			ДвоичныеДанныеПриложения,
			ПриложениеУведомления.ИмяФайлаВыгрузки,
			ДвоичныеДанныеПриложения.Размер(),,,,,,
			СгенерироватьUUID(),
			ТипСодержимогоПоИмениФайла(ПриложениеУведомления.ИмяФайлаВыгрузки));
		
		Если НЕ РезультатДобавления Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	// добавляем доверенность, если она есть
	Если ЗначениеЗаполнено(ФайлДоверенности) Тогда
		Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление, ФайлДоверенности, КороткоеИмяФайлаДоверенности, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml) Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
		
	// записываем цикл обмена
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	// изменяем статус отправки
	ЗаписатьСтатусОтправкиОбъекта(УведомлениеСсылка, Перечисления.СтатусыОтправки.ВКонверте);
	
	ЗафиксироватьТранзакцию();
	
	Контекст.Вставить("Организация", Организация);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОтправкаУведомлениеФНС(УведомлениеСсылка, УникальныйИдентификаторФормы, ВыполняемоеОповещение) Экспорт
	
	ДлительнаяОтправкаКлиент.ЗапретитьВыводСостояния();
	
	МассивВыгруженныхУведомлений = Неопределено;
	Если НЕ ВыгрузитьУведомлениеФНС(УведомлениеСсылка, МассивВыгруженныхУведомлений) Тогда
		
		ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();
		
		ТекстСообщения = НСтр("ru = 'Отправка уведомления прервана. Не удалось выгрузить файл выгрузки уведомления';
								|en = 'Notification sending is aborted. Cannot export a notification export file'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Уведомления.
		
		Возврат;
	КонецЕсли;
	
	ПриложенияВыгруженныхУведомлений = Новый Массив;
	НомерУведомления = 0;
	ПриложенияРазрешены = Ложь;
	Пока НомерУведомления < МассивВыгруженныхУведомлений.Количество() Цикл
		ВыгруженноеУведомление = МассивВыгруженныхУведомлений[НомерУведомления];
		ИмяФайлаПриведенное = ВРЕГ(ВыгруженноеУведомление.ИмяФайлаВыгрузки);
		Если ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 3) = "PR_" Тогда
			ДвоичныеДанныеВыгрузки = ПолучитьИзВременногоХранилища(ВыгруженноеУведомление.АдресФайлаВыгрузки);
			ВыгруженноеУведомление.АдресФайлаВыгрузки = ПоместитьВоВременноеХранилище(ДвоичныеДанныеВыгрузки, Новый УникальныйИдентификатор);
			ПриложенияВыгруженныхУведомлений[НомерУведомления - 1].Добавить(ВыгруженноеУведомление);
			МассивВыгруженныхУведомлений.Удалить(НомерУведомления);
			
		Иначе
			ПриложенияРазрешены = (Лев(ИмяФайлаПриведенное, 11) = "ON_UVNPDUS_");
			ПриложенияВыгруженныхУведомлений.Добавить(Новый Массив);
			НомерУведомления = НомерУведомления + 1;
		КонецЕсли;
	КонецЦикла;
	
	ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("УведомлениеСсылка",					УведомлениеСсылка);
	ДополнительныеПараметры.Вставить("УникальныйИдентификаторФормы",		УникальныйИдентификаторФормы);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",				ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("МассивВыгруженныхУведомлений",		МассивВыгруженныхУведомлений);
	ДополнительныеПараметры.Вставить("ПриложенияВыгруженныхУведомлений",	ПриложенияВыгруженныхУведомлений);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОтправкаУведомлениеФНСПослеАвтонастройкиУчетнойЗаписи", ЭтотОбъект, ДополнительныеПараметры);
	
	КонтекстДлительнойОперации = Новый Структура;
	КонтекстДлительнойОперации.Вставить("УведомлениеСсылка", 	УведомлениеСсылка);
	КонтекстДлительнойОперации.Вставить("ОписаниеОповещения", 	ОписаниеОповещения);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= УведомлениеСсылка;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 4;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;

	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка уведомления в ФНС
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаУведомлениеФНС",  0.1, Истина);
		
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаУведомлениеФНС() Экспорт
	
	КонтекстДлительнойОперации = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	УведомлениеСсылка 	= КонтекстДлительнойОперации.УведомлениеСсылка;
	ОписаниеОповещения 	= КонтекстДлительнойОперации.ОписаниеОповещения;
	
	ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(УведомлениеСсылка,ОписаниеОповещения);
		
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаУведомлениеФНСПослеАвтонастройкиУчетнойЗаписи(Результат, ДополнительныеПараметры) Экспорт
	
	УведомлениеСсылка 					= ДополнительныеПараметры.УведомлениеСсылка;
	УникальныйИдентификаторФормы 		= ДополнительныеПараметры.УникальныйИдентификаторФормы;
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	МассивВыгруженныхУведомлений 		= ДополнительныеПараметры.МассивВыгруженныхУведомлений;
	ПриложенияВыгруженныхУведомлений 	= ДополнительныеПараметры.ПриложенияВыгруженныхУведомлений;
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("Документ", УведомлениеСсылка);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификаторФормы);
	
	
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", 				ВыполняемоеОповещение);
	Контекст.Вставить("КонтекстОтправки", 					КонтекстОтправки);
	Контекст.Вставить("МассивВыгруженныхУведомлений", 		МассивВыгруженныхУведомлений);
	Контекст.Вставить("ПриложенияВыгруженныхУведомлений", 	ПриложенияВыгруженныхУведомлений);
	Контекст.Вставить("ТекущееУведомление", 			0);
	
	ОтправкаУведомлениеФНСПоследовательнаяОтправка(Контекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаУведомлениеФНСПоследовательнаяОтправка(ВходящийКонтекст)
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если ВходящийКонтекст.ТекущееУведомление < ВходящийКонтекст.МассивВыгруженныхУведомлений.Количество() Тогда
		
		ВыгруженноеУведомление 	= ВходящийКонтекст.МассивВыгруженныхУведомлений[ВходящийКонтекст.ТекущееУведомление];
		ПриложенияУведомления 	= ВходящийКонтекст.ПриложенияВыгруженныхУведомлений[ВходящийКонтекст.ТекущееУведомление];
		
		// отражаем изменения в базе
		Если НЕ ОтправкаУведомлениеФНС_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки, ВыгруженноеУведомление, ПриложенияУведомления) Тогда // сервер
			
			Если КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
				ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
				ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(КонтекстОтправки.Документ, ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Иначе
				ДополнительныеПараметры = Новый Структура();
				ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
				ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
				
				ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Уведомления.
			КонецЕсли;
			
			Возврат;
		КонецЕсли;
		
		ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
		Оповещение = Новый ОписаниеОповещения(
			"ОтправкаУведомлениеФНСПослеФормированияПакета", ЭтотОбъект, ВходящийКонтекст);
		
		Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "ФНС");
	Иначе
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Истина);
		
		ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // Уведомления.
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаУведомлениеФНСПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если Не Результат Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Уведомления.
		
		Возврат;
	КонецЕсли;
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(КонтекстОтправки) Тогда // сервер
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Уведомления.
		
		Возврат;
	КонецЕсли;
	ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	ВходящийКонтекст.ТекущееУведомление = ВходящийКонтекст.ТекущееУведомление + 1;
	
	ОтправкаУведомлениеФНСПоследовательнаяОтправка(ВходящийКонтекст);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Функция ЭтоФайлВыгрузкиУведомленияОКонтролируемыхСделках(КороткоеИмяФайла) Экспорт
	Возврат ВРег(Лев(КороткоеИмяФайла, 10)) = "UT_UVKNRSD";
КонецФункции

&НаКлиенте
Функция МаксимальныйРазмерФайлаУведомленияОКонтролируемыхСделках() Экспорт
	Возврат 1024 * 1024 * 100;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьУчетнуюЗапись(Объект)
	
	Возврат Объект.УчетнаяЗапись;	
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(Отпечаток, ЛогическоеХранилище = Неопределено, ВыполнятьПроверку = Ложь)
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
