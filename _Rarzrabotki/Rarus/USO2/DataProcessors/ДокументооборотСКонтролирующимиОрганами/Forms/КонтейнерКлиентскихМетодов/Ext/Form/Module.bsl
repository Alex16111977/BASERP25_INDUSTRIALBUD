&НаСервереБезКонтекста
Функция ПолучитьОбщееКоличествоОтправляемыхФайловОписиИсходящихДокументов(ДанныеФайловВыгрузки)
	
	КоличествоФайлов = 0;
	
	ТаблицаДокСканов = ДанныеФайловВыгрузки.ТаблицаДокСканов;
	Для каждого СтрокаТаблицыДокСканов Из ТаблицаДокСканов Цикл
		
		КоличествоФайлов = КоличествоФайлов + СтрокаТаблицыДокСканов.МассивФайлов.Количество();
		
		ЕстьФайлЭПНотариуса = ЗначениеЗаполнено(СтрокаТаблицыДокСканов.ИдФайлЭП);
		Если ЕстьФайлЭПНотариуса Тогда
			КоличествоФайлов = КоличествоФайлов + 1;
		КонецЕсли;
		
	КонецЦикла; 
	
	ТаблицаДокФорм = ДанныеФайловВыгрузки.ТаблицаДокФорм;
	Для каждого СтрокаТаблицыДокФорм Из ТаблицаДокФорм Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицыДокФорм.ПодтверждениеИмяФайлаДанных) Тогда
			КоличествоФайлов = КоличествоФайлов + 4;
		Иначе
			КоличествоФайлов = КоличествоФайлов + 2;
		КонецЕсли;
	КонецЦикла;
	
	Возврат КоличествоФайлов;
	
КонецФункции

&НаСервереБезКонтекста
Функция ВыгрузитьОписьИсходящихДокументов(Контекст, ТранспортноеСообщение, ДанныеФайловВыгрузки)
	
	УникальныйИдентификаторФормы = Контекст.УникальныйИдентификатор;
	ОписьСсылка = Контекст.Документ;
	
	ИдентификаторОтправителяПолучателя = СформироватьИдентификаторОтправителяПолучателя(ТранспортноеСообщение);
	
	ДанныеФайловВыгрузки = ПолучитьДанныеПоФайламВыгрузкиОписиИсходящихДокументов(ОписьСсылка, ИдентификаторОтправителяПолучателя, УникальныйИдентификаторФормы);	
	Если ДанныеФайловВыгрузки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Организация 		= ОписьСсылка.Организация;
	КодНалоговогоОргана = СокрЛП(ОписьСсылка.НалоговыйОрган.Код);
	ЭлРегистрацияВИФНС 	= РегистрацияВИФНСПоОрганизацииИКодуНО(ОписьСсылка.Организация, КодНалоговогоОргана);
	
	ПараметрыОписи = СформироватьПараметрыОписиИсходящихДокументов(Организация, ЭлРегистрацияВИФНС, КодНалоговогоОргана);
	
	Если НЕ ПроверитьЗаполнениеПараметровПриОтправкеПредставления(ПараметрыОписи) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// определяем ИмяФайлТреб
	ВложенияСДанными = ПолучитьФайлыДокументовРеализацииПолномочийНалоговыхОрганов(ОписьСсылка.Требование);
	ПараметрыОписи.Вставить("ИмяФайлТреб", ИмяФайлаБезРасширения(ВложенияСДанными[0].ИмяФайла));
	
	ПараметрыОписи.Вставить("ЭтоОтветНаТребованиеДокументов", Истина);
	
	// формируем имя файла представления
	ИмяФайлаПредставления = Неопределено;
	
	//при подсчете количества вложений не учитываем 6 служебных файла и служебные подписи вложений (делим пополам)
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	КолФайл = ПолучитьОбщееКоличествоОтправляемыхФайловОписиИсходящихДокументов(ДанныеФайловВыгрузки); 
	
	// формируем XML представления
	ТекстПредставления = СформироватьXMLПредставления(Организация, ДанныеФайловВыгрузки, ПараметрыОписи, ИмяФайлаПредставления, КолФайл);
	Если НЕ ЗначениеЗаполнено(ТекстПредставления) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать XML файл описи исходящих документов.';
								|en = 'Cannot generate an XML file of list of outgoing documents.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// пишем XML во временный файл в кодировке windows-1251
	ФайлПредставления = ВыгрузитьТекстВФайл(ТекстПредставления, ПолучитьИмяВременногоФайла());
	Если НЕ ЗначениеЗаполнено(ФайлПредставления) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось записать содержимое описи исходящих документов в файл.';
								|en = 'Cannot write the list of outgoing documents to the file.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	                                                                             
	ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ФайлПредставления);
	СсылкаНаДвоичныеДанныеФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, УникальныйИдентификаторФормы);
	
	ДанныеФайлаПредставление = Новый Структура;
	ДанныеФайлаПредставление.Вставить("ИмяФайла", ИмяФайлаПредставления);
	ДанныеФайлаПредставление.Вставить("АдресВременногоХранилища", СсылкаНаДвоичныеДанныеФайла);
	
	ДанныеФайловВыгрузки.Вставить("ДанныеФайлаПредставление", ДанныеФайлаПредставление);
	
	Возврат Истина;

КонецФункции

