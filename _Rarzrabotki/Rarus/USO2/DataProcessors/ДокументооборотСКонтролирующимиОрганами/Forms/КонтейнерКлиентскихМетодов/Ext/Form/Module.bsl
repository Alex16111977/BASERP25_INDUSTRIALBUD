Процедура ОбработатьОбновлениеВЦикле(Результат, ДополнительныеПараметры) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть аналогичная процедура ОбработатьОбновление(), которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ПараметрыФункции                           = ДополнительныеПараметры.ПараметрыФункции;
	ВыполняемоеОповещение                      = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если Результат <> Истина Тогда
		
		РезультатОбновления = Новый Структура("ПараметрыФункции, РезультатОбновления", ПараметрыФункции, Ложь);
		РезультатОбновления.Вставить("ОшибкаПолученияДанныхССервера");
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОбновления);
		
		Возврат;
	КонецЕсли;
		
	ВыводитьСообщения                          = ДополнительныеПараметры.ВыводитьСообщения;
	ПараметрыРегистрацияПолучитьДанныеССервера = ДополнительныеПараметры.ПараметрыРегистрацияПолучитьДанныеССервера;
	ПовторятьСоединение                        = ДополнительныеПараметры.ПовторятьСоединение;
	
	ТихийРежим = Неопределено;
	ИнформацияОСервереОнлайнПроверки = Неопределено;
	ДополнительныеПараметры.ПараметрыФункции.Свойство("ТихийРежим", ТихийРежим);
	ДополнительныеПараметры.ПараметрыФункции.Свойство("СтруктураДляИнформацииОСервереОнлайнПроверки", ИнформацияОСервереОнлайнПроверки);
	
	ТихийРежим = ?(ТихийРежим = Неопределено, Ложь, ТихийРежим);
	
	Результат = РегистрацияПолучитьДанныеССервера(ПараметрыРегистрацияПолучитьДанныеССервера, ПовторятьСоединение);
	Если НЕ Результат И ТихийРежим И ИнформацияОСервереОнлайнПроверки = Неопределено Тогда //Не работать при отправке на онлайн проверку
		
		РезультатОбновления = Новый Структура("ПараметрыФункции, РезультатОбновления", ПараметрыФункции, Ложь);
		РезультатОбновления.Вставить("ОшибкаПолученияДанныхССервера");
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОбновления);
		
		Возврат;
		
	ИначеЕсли НЕ Результат И ПовторятьСоединение Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОбработатьОбновлениеВЦикле",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(
			НСтр("ru = 'Не удалось обратиться к серверу обновлений';
				|en = 'Cannot contact the update server'"),
			ОписаниеОповещения);
		
		Возврат;
	КонецЕсли;
	
	ПараметрыАвторизации = Новый Структура;
	Если ЗначениеЗаполнено(ПараметрыФункции.УчетнаяЗапись) Тогда
		ПараметрыАвторизации.Вставить("УчетнаяЗапись", ПараметрыФункции.УчетнаяЗапись);
	Иначе
		ПараметрыАвторизации.Вставить("ИдентификаторДокументооборота", ПараметрыФункции.ИдентификаторДокументооборота);
		ПараметрыАвторизации.Вставить("ТелефонМобильныйДляАвторизации", ПараметрыФункции.ТелефонМобильныйДляАвторизации);
	КонецЕсли;
	
	// служебные переменные
	ЭтоНоваяУчетнаяЗапись = Истина;
	
	СтруктураАвтонастройкиФСС = Неопределено;
	СтруктураАвтонастройкиРПН = Неопределено;
	СтруктураАвтонастройкиФТС = Неопределено;
	
	ЗаполнитьЗначенияСвойств(ПараметрыФункции, ПараметрыРегистрацияПолучитьДанныеССервера);
	ФайлИзКэша = ПараметрыРегистрацияПолучитьДанныеССервера.ФайлИзКэша;
	ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ПараметрыРегистрацияПолучитьДанныеССервера.ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
		
	// если не получилось, то прерываемся
	Если НЕ Результат Тогда
		РезультатОбновления = Новый Структура("ПараметрыФункции, РезультатОбновления", ПараметрыФункции, Ложь);
		РезультатОбновления.Вставить("ОшибкаПолученияДанныхССервера");
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОбновления);
		Возврат;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	СвойствоКриптосообщения = ЭтоСообщениеЗашифрованоНаОблачныйСертификат(ДанныеУзлаКонфиденциальнаяИнформацияАдрес);
	Если СвойствоКриптосообщения <> Неопределено Тогда 
		ПараметрыФункции.ЭтоЭлектроннаяПодписьВМоделиСервиса = СвойствоКриптосообщения;
	КонецЕсли;
		
	// создаем на клиенте временный каталог, который необходим для хранения промежуточных файлов
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",                      ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ДанныеУзлаКонфиденциальнаяИнформацияАдрес",  ДанныеУзлаКонфиденциальнаяИнформацияАдрес);
	ДополнительныеПараметры.Вставить("ВыводитьСообщения",                          ВыводитьСообщения);
	ДополнительныеПараметры.Вставить("ПараметрыРегистрацияПолучитьДанныеССервера", ПараметрыРегистрацияПолучитьДанныеССервера);
	ДополнительныеПараметры.Вставить("ПараметрыФункции",                           ПараметрыФункции);
	ДополнительныеПараметры.Вставить("Результат",                                  Результат);
	ДополнительныеПараметры.Вставить("ПараметрыАвторизации",                       ПараметрыАвторизации);
	ДополнительныеПараметры.Вставить("ФайлИзКэша",                                 ФайлИзКэша);
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьОбновлениеВЦиклеПослеПолученияВременногоКаталогаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	Если Не ПараметрыФункции.ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		ОперацииСФайламиЭДКОКлиент.СоздатьКаталогНаКлиенте(Оповещение);
	Иначе
		РезультатОперацииСФайлами = Новый Структура("Выполнено, ДвоичныеДанные, ИмяКаталога", Истина, Неопределено, Неопределено);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатОперацииСФайлами);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ИзвлечьОписаниеПричиныОшибки(Результат)
	
	Перем ОписаниеОшибки;
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Если Результат.Свойство("ОписаниеОшибки", ОписаниеОшибки) Тогда
			Возврат ОписаниеОшибки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьОбновлениеВЦиклеПослеПолученияВременногоКаталогаЗавершение(РезультатОперацииСФайлами, ДополнительныеПараметры) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть аналогичная процедура ОбработатьОбновление(), которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ДополнительныеПараметры.ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	ПараметрыРегистрацияПолучитьДанныеССервера = ДополнительныеПараметры.ПараметрыРегистрацияПолучитьДанныеССервера;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	Результат = ДополнительныеПараметры.Результат;
	ПараметрыАвторизации = ДополнительныеПараметры.ПараметрыАвторизации;
	ФайлИзКэша = ДополнительныеПараметры.ФайлИзКэша;
	
	Если НЕ РезультатОперацииСФайлами.Выполнено Тогда
		РезультатОбновления = Новый Структура("ПараметрыФункции, РезультатОбновления", ПараметрыФункции, Ложь);
		РезультатОбновления.Вставить("ОшибкаСозданияКаталога", ИзвлечьОписаниеПричиныОшибки(РезультатОперацииСФайлами));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОбновления);
		Возврат;
	КонецЕсли;
	
	ВременныйКаталог = РезультатОперацииСФайлами.ИмяКаталога;
	
	// Среди пришедших в рег файле отпечатков ищем тот, который пришел в ответе.
	// Если отпечатки совпадают, то устанавливаем сертификат, иначе пропускаем установку сертифката
	УстанавливатьСертификат = Истина;
	ЭтоВторичноеЗаявление = ПараметрыФункции.ЭтоВторичноеЗаявление;
	ОтпечатокСертификатаИзОтвета = ПараметрыФункции.ОтпечатокСертификатаИзОтвета;
	Если ЭтоВторичноеЗаявление Тогда
		УстанавливатьСертификат = УстанавливатьСертификат(ОтпечатокСертификатаИзОтвета);
	Иначе
		УстанавливатьСертификат = Истина;
	КонецЕсли;
	
	// Установка сертификатов
	Если УстанавливатьСертификат Тогда
		ПараметрыРегистрацияУстановитьСертификаты = ПараметрыРегистрацияУстановитьСертификаты();
		ЗаполнитьЗначенияСвойств(ПараметрыРегистрацияУстановитьСертификаты, ПараметрыФункции);
		ПараметрыРегистрацияУстановитьСертификаты.ВременныйКаталог = ВременныйКаталог;
		
	Иначе
		ОтпечатокСертификата = ОтпечатокСертификатаИзОтвета;
	КонецЕсли;
	
	// устанавливаем сертификаты
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ОтпечатокСертификата", ОтпечатокСертификата);
	ДополнительныеПараметры.Вставить("ДанныеУзлаКонфиденциальнаяИнформацияАдрес", ДанныеУзлаКонфиденциальнаяИнформацияАдрес);
	ДополнительныеПараметры.Вставить("ВременныйКаталог", ВременныйКаталог);
	ДополнительныеПараметры.Вставить("ВыводитьСообщения", ВыводитьСообщения);
	ДополнительныеПараметры.Вставить("ПараметрыРегистрацияПолучитьДанныеССервера", ПараметрыРегистрацияПолучитьДанныеССервера);
	ДополнительныеПараметры.Вставить("ПараметрыФункции", ПараметрыФункции);
	ДополнительныеПараметры.Вставить("Результат", Результат);
	ДополнительныеПараметры.Вставить("УстанавливатьСертификат", УстанавливатьСертификат);
	ДополнительныеПараметры.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);
	ДополнительныеПараметры.Вставить("ФайлИзКэша", ФайлИзКэша);
	Оповещение = Новый ОписаниеОповещения("ОбработатьОбновлениеВЦиклеПослеУстановкиСертификатовЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	Если УстанавливатьСертификат Тогда
		РегистрацияУстановитьСертификаты(ПараметрыРегистрацияУстановитьСертификаты, Оповещение);
	Иначе
		РезультатРегистрацияУстановитьСертификаты = Новый Структура("РезультатВыполнения, ПараметрыФункции", Истина, Неопределено);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатРегистрацияУстановитьСертификаты);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеВЦиклеПослеУстановкиСертификатовЗавершение(РезультатРегистрацияУстановитьСертификаты, ДополнительныеПараметры) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть аналогичная процедура ОбработатьОбновление(), которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.

	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ОтпечатокСертификата = ДополнительныеПараметры.ОтпечатокСертификата;
	ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ДополнительныеПараметры.ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	ПараметрыРегистрацияПолучитьДанныеССервера = ДополнительныеПараметры.ПараметрыРегистрацияПолучитьДанныеССервера;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	Результат = ДополнительныеПараметры.Результат;
	УстанавливатьСертификат = ДополнительныеПараметры.УстанавливатьСертификат;
	ПараметрыАвторизации = ДополнительныеПараметры.ПараметрыАвторизации;
	ФайлИзКэша = ДополнительныеПараметры.ФайлИзКэша;
	
	РезультатУстановкиСертификатов = РезультатРегистрацияУстановитьСертификаты.РезультатВыполнения;
	ПараметрыРегистрацияУстановитьСертификаты = РезультатРегистрацияУстановитьСертификаты.ПараметрыФункции;
	
	Если УстанавливатьСертификат Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыФункции, ПараметрыРегистрацияУстановитьСертификаты);
		ОтпечатокСертификата = ПараметрыРегистрацияУстановитьСертификаты.ОтпечатокСертификата;
	КонецЕсли;
	
	// Расшифровка данных, хранящихся в зашифрованной области рег. файла
	РезультатРасшифровки 		= Истина;
	АдресВоВременномХранилище 	= Неопределено;
	
	Если РезультатУстановкиСертификатов И Не ФайлИзКэша Тогда
		
		ВыполнятьРасшифровку = ПараметрыФункции.ВыполнятьРасшифровкуЗашифрованнойЧастиФайлаАвтонастроки;
		
		// Расшифровка
		ДополнительныеПараметры = Новый Структура("ОтпечатокСертификата, ДанныеУзлаКонфиденциальнаяИнформацияАдрес, АдресВоВременномХранилище, ВременныйКаталог, ВыводитьСообщения, ВыполняемоеОповещение, ПараметрыРегистрацияПолучитьДанныеССервера, ПараметрыФункции, Результат, РезультатРасшифровки, РезультатУстановкиСертификатов, УстанавливатьСертификат, ФайлИзКэша", ОтпечатокСертификата, ДанныеУзлаКонфиденциальнаяИнформацияАдрес, АдресВоВременномХранилище, ВременныйКаталог, ВыводитьСообщения, ВыполняемоеОповещение, ПараметрыРегистрацияПолучитьДанныеССервера, ПараметрыФункции, Результат, РезультатРасшифровки, РезультатУстановкиСертификатов, УстанавливатьСертификат, ФайлИзКэша);
		ДополнительныеПараметры.Вставить("ТрансляцияОшибокУстановкиСертификатов", РезультатРегистрацияУстановитьСертификаты);
		
		Оповещение = Новый ОписаниеОповещения("ОбработатьОбновлениеВЦиклеПослеРасшифрованияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		Если ВыполнятьРасшифровку Тогда
			РегистрацияРасшифроватьДанные(
				ПараметрыФункции.ЭтоЭлектроннаяПодписьВМоделиСервиса, ОтпечатокСертификата,
				ПараметрыФункции.ИдентификаторДокументооборота,
				ДанныеУзлаКонфиденциальнаяИнформацияАдрес,
				ВыводитьСообщения, Оповещение);
		Иначе
			РезультатВыполнения = Новый Структура("РезультатРасшифровки, АдресВоВременномХранилище", Ложь, АдресВоВременномХранилище);
			РезультатВыполнения.Вставить("ОшибкаПропущенаРасшифровка");
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		КонецЕсли;
		
	Иначе
		
		ОбработатьОбновлениеПослеКриптографииЗавершение(
			АдресВоВременномХранилище, 
			ВременныйКаталог, 
			ВыводитьСообщения, 
			ВыполняемоеОповещение, 
			ПараметрыРегистрацияПолучитьДанныеССервера, 
			ПараметрыФункции, 
			Результат, 
			РезультатРасшифровки, 
			РезультатУстановкиСертификатов, 
			УстанавливатьСертификат, 
			ФайлИзКэша,
			РезультатРегистрацияУстановитьСертификаты,
			Новый Структура
		);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеВЦиклеПослеРасшифрованияЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	ОтпечатокСертификата = ДополнительныеПараметры.ОтпечатокСертификата;
	ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ДополнительныеПараметры.ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПараметрыРегистрацияПолучитьДанныеССервера = ДополнительныеПараметры.ПараметрыРегистрацияПолучитьДанныеССервера;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	Результат = ДополнительныеПараметры.Результат;
	РезультатРасшифровки = ДополнительныеПараметры.РезультатРасшифровки;
	РезультатУстановкиСертификатов = ДополнительныеПараметры.РезультатУстановкиСертификатов;
	УстанавливатьСертификат = ДополнительныеПараметры.УстанавливатьСертификат;
	ФайлИзКэша = ДополнительныеПараметры.ФайлИзКэша;
	
	РезультатРасшифровки = РезультатВыполнения.РезультатРасшифровки;
	АдресВоВременномХранилище = РезультатВыполнения.АдресВоВременномХранилище;
	
	ТрансляцияОшибокУстановкиСертификатов = ДополнительныеПараметры.ТрансляцияОшибокУстановкиСертификатов;
	ТрансляцияОшибокРасшифровки = РезультатВыполнения;
				
	ОбработатьОбновлениеПослеКриптографииЗавершение(
		АдресВоВременномХранилище, 
		ВременныйКаталог, 
		ВыводитьСообщения, 
		ВыполняемоеОповещение, 
		ПараметрыРегистрацияПолучитьДанныеССервера, 
		ПараметрыФункции, 
		Результат, 
		РезультатРасшифровки, 
		РезультатУстановкиСертификатов, 
		УстанавливатьСертификат, 
		ФайлИзКэша,
		ТрансляцияОшибокУстановкиСертификатов,
		ТрансляцияОшибокРасшифровки
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеПослеКриптографииЗавершение(АдресВоВременномХранилище, ВременныйКаталог, ВыводитьСообщения, ВыполняемоеОповещение,  
	ПараметрыРегистрацияПолучитьДанныеССервера, ПараметрыФункции, Результат, РезультатРасшифровки, РезультатУстановкиСертификатов, УстанавливатьСертификат, ФайлИзКэша,
	ТрансляцияОшибокУстановкиСертификатов = Неопределено,
	ТрансляцияОшибокРасшифровки = Неопределено)

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	// Обновление информации в справочниках
	Если РезультатУстановкиСертификатов И РезультатРасшифровки Тогда
		
		ПараметрыРегистрацияОбновитьСправочники = ПараметрыРегистрацияОбновитьСправочники();
		ЗаполнитьЗначенияСвойств(ПараметрыРегистрацияОбновитьСправочники, ПараметрыФункции);
		
		ПараметрыРегистрацияОбновитьСправочники.ВременныйФайлОбновленийАдрес 	= ПараметрыРегистрацияПолучитьДанныеССервера.ВременныйФайлОбновленийАдрес;
		ПараметрыРегистрацияОбновитьСправочники.АдресВоВременномХранилище 		= АдресВоВременномХранилище;
		ПараметрыРегистрацияОбновитьСправочники.ФайлИзКэша 						= ФайлИзКэша;
		
		РезультатОбновленияСправочников = РегистрацияОбновитьСправочники(ПараметрыРегистрацияОбновитьСправочники);
		ЗаполнитьЗначенияСвойств(ПараметрыФункции, ПараметрыРегистрацияОбновитьСправочники);
		
		ЭтоНоваяУчетнаяЗапись = ПараметрыРегистрацияОбновитьСправочники.ЭтоНоваяУчетнаяЗапись;
		СтруктураАвтонастройкиФСС = ПараметрыРегистрацияОбновитьСправочники.СтруктураАвтонастройкиФСС;
		СтруктураАвтонастройкиРПН = ПараметрыРегистрацияОбновитьСправочники.СтруктураАвтонастройкиРПН;
		СтруктураАвтонастройкиФТС = ПараметрыРегистрацияОбновитьСправочники.СтруктураАвтонастройкиФТС;
		
	КонецЕсли;
	
	// Сохранение дополнительных сведений по учетной записи в регистр
	ПараметрыСертификата = Неопределено;
	Если (РезультатУстановкиСертификатов ИЛИ НЕ УстанавливатьСертификат) Тогда
		ПараметрыУчетнойЗаписи = ?(ПараметрыФункции.УчетнаяЗапись = Неопределено, НоваяУчетнаяЗапись, ПараметрыФункции.УчетнаяЗапись);
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("ВременныйКаталог", ВременныйКаталог);
		ДополнительныеПараметры.Вставить("ВыводитьСообщения", ВыводитьСообщения);
		ДополнительныеПараметры.Вставить("ПараметрыРегистрацияПолучитьДанныеССервера", ПараметрыРегистрацияПолучитьДанныеССервера);
		ДополнительныеПараметры.Вставить("ПараметрыФункции", ПараметрыФункции);
		ДополнительныеПараметры.Вставить("Результат", Результат);
		ДополнительныеПараметры.Вставить("РезультатРасшифровки", РезультатРасшифровки);
		ДополнительныеПараметры.Вставить("РезультатУстановкиСертификатов", РезультатУстановкиСертификатов);
		ДополнительныеПараметры.Вставить("УстанавливатьСертификат", УстанавливатьСертификат);
		ДополнительныеПараметры.Вставить("ПараметрыУчетнойЗаписи", ПараметрыУчетнойЗаписи);
		ДополнительныеПараметры.Вставить("РезультатОбновленияСправочников", РезультатОбновленияСправочников);
		ДополнительныеПараметры.Вставить("СтруктураАвтонастройкиФСС", СтруктураАвтонастройкиФСС);
		ДополнительныеПараметры.Вставить("СтруктураАвтонастройкиРПН", СтруктураАвтонастройкиРПН);
		ДополнительныеПараметры.Вставить("СтруктураАвтонастройкиФТС", СтруктураАвтонастройкиФТС);
		ДополнительныеПараметры.Вставить("ЭтоНоваяУчетнаяЗапись", ЭтоНоваяУчетнаяЗапись);
		
		Оповещение = Новый ОписаниеОповещения("ОбработатьОбновлениеПослеПоискаСертификатаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		Попытка
			ОтпечатокСертификатаУчетнойЗаписи = ПолучитьОтпечаток(ПараметрыУчетнойЗаписи, "Руководитель", Неопределено);
			Если ЗначениеЗаполнено(ОтпечатокСертификатаУчетнойЗаписи) Тогда
				Если ПараметрыФункции.ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
					ПараметрыСертификата = ПолучитьСвойстваСертификатаСубъектаНаСервере(ОтпечатокСертификатаУчетнойЗаписи);
				Иначе
					КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, ОтпечатокСертификатаУчетнойЗаписи, "MY", , Ложь);
					Возврат;
				КонецЕсли;
			КонецЕсли;
		Исключение
			ПараметрыСертификата = Неопределено;
		КонецПопытки;
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден, СвойстваСертификата", Истина, Неопределено, ПараметрыСертификата <> Неопределено, ПараметрыСертификата);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,ВременныйКаталог);
		
		РезультатОбновления = Новый Структура("ПараметрыФункции, РезультатОбновления", ПараметрыФункции, Результат);
		Если РезультатУстановкиСертификатов = Ложь И ТипЗнч(ТрансляцияОшибокУстановкиСертификатов) = Тип("Структура") Тогда
			Для Каждого Свойство Из ТрансляцияОшибокУстановкиСертификатов Цикл
				Если Лев(Свойство.Ключ, 6) = "Ошибка" Тогда
					РезультатОбновления.Вставить(Свойство.Ключ, Свойство.Значение);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если РезультатРасшифровки = Ложь И ТипЗнч(ТрансляцияОшибокРасшифровки) = Тип("Структура") Тогда
			Для Каждого Свойство Из ТрансляцияОшибокРасшифровки Цикл
				Если Лев(Свойство.Ключ, 6) = "Ошибка" Тогда
					РезультатОбновления.Вставить(Свойство.Ключ, Свойство.Значение);
				КонецЕсли;
			КонецЦикла;
			Если ТрансляцияОшибокРасшифровки.Количество() = 0 Тогда
				РезультатОбновления.Вставить("ОшибкаПропущенаРасшифровка");
			КонецЕсли;
		КонецЕсли;
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОбновления);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеПослеПоискаСертификатаЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	ПараметрыРегистрацияПолучитьДанныеССервера = ДополнительныеПараметры.ПараметрыРегистрацияПолучитьДанныеССервера;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	Результат = ДополнительныеПараметры.Результат;
	РезультатРасшифровки = ДополнительныеПараметры.РезультатРасшифровки;
	РезультатУстановкиСертификатов = ДополнительныеПараметры.РезультатУстановкиСертификатов;
	УстанавливатьСертификат = ДополнительныеПараметры.УстанавливатьСертификат;
	ПараметрыУчетнойЗаписи = ДополнительныеПараметры.ПараметрыУчетнойЗаписи;
	РезультатОбновленияСправочников = ДополнительныеПараметры.РезультатОбновленияСправочников;
	СтруктураАвтонастройкиФСС = ДополнительныеПараметры.СтруктураАвтонастройкиФСС;
	СтруктураАвтонастройкиРПН = ДополнительныеПараметры.СтруктураАвтонастройкиРПН;
	СтруктураАвтонастройкиФТС = ДополнительныеПараметры.СтруктураАвтонастройкиФТС;
	ЭтоНоваяУчетнаяЗапись = ДополнительныеПараметры.ЭтоНоваяУчетнаяЗапись;
	
	ПараметрыСертификата = ?(РезультатВыполнения.Выполнено И РезультатВыполнения.СертификатНайден, РезультатВыполнения.СвойстваСертификата, Неопределено);
	
	Если (РезультатУстановкиСертификатов ИЛИ НЕ УстанавливатьСертификат) Тогда
		ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи 													= ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи();
		ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи.УчетнаяЗаписьОрганизации 						= ПараметрыУчетнойЗаписи;
		ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи.ПараметрыСертификата 							= ПараметрыСертификата;
		ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи.ИдентификаторАбонента 							= ПараметрыФункции.ИдентификаторАбонента;
		ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи.ВременныйФайлОбновленийАдрес 					= ПараметрыРегистрацияПолучитьДанныеССервера.ВременныйФайлОбновленийАдрес;
		ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи.ВызовИзМастераПодключенияК1СОтчетности 			= ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности;
		ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи.ТекстОшибокДляМастераПодключенияК1СОтчетности 	= ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности;
		
		СохранитьДополнительныеРеквизитыУчетнойЗаписи(ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи);
		ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности = ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи.ТекстОшибокДляМастераПодключенияК1СОтчетности;
	КонецЕсли;
	
	Если (РезультатУстановкиСертификатов ИЛИ НЕ УстанавливатьСертификат) И РезультатРасшифровки И РезультатОбновленияСправочников Тогда
		
		// производим настройку параметров ФСС
		Если СтруктураАвтонастройкиФСС <> Неопределено И ПараметрыФункции.Организация <> Неопределено Тогда
			
			ФлагАвтозаполнения = СтруктураАвтонастройкиФСС.ФлагАвтозаполнения;
			Если СтруктураАвтонастройкиФСС.ФлагСообщения И ВыводитьСообщения Тогда
				Режим = РежимДиалогаВопрос.ДаНет;
				Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Произвести автоматическую настройку параметров отправки в ФСС для организации %1?';
																					|en = 'Set up parameters of sending to SSF for company %1 automatically?'"), ПараметрыФункции.Организация);
				ДополнительныеПараметры = Новый Структура("ВременныйКаталог, ВыводитьСообщения, ВыполняемоеОповещение, НоваяУчетнаяЗапись, ПараметрыФункции, СтруктураАвтонастройкиРПН, СтруктураАвтонастройкиФТС, СтруктураАвтонастройкиФСС, ЭтоНоваяУчетнаяЗапись", ВременныйКаталог, ВыводитьСообщения, ВыполняемоеОповещение, НоваяУчетнаяЗапись, ПараметрыФункции, СтруктураАвтонастройкиРПН, СтруктураАвтонастройкиФТС, СтруктураАвтонастройкиФСС, ЭтоНоваяУчетнаяЗапись);
				ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьОбновлениеНастройкаФССЗавершение", ЭтотОбъект, ДополнительныеПараметры);
				ПоказатьВопрос(ОписаниеОповещения, Текст, Режим, 0, КодВозвратаДиалога.Нет, "Предупреждение");
				
			Иначе
				
				Если ФлагАвтозаполнения Тогда
					ОбновитьРегистрыСведенийНастройкиОбменаФСС(
						ПараметрыФункции.Организация,
						СтруктураАвтонастройкиФСС.ОтпечатокСертификата,
						СтруктураАвтонастройкиФСС.СертификатФССОтпечаток,
						СтруктураАвтонастройкиФСС.СертификатФССЭЛНОтпечаток,
						ВыводитьСообщения);
				КонецЕсли;
				
				ОбработатьОбновлениеНастройкаРПН(СтруктураАвтонастройкиРПН, СтруктураАвтонастройкиФТС, ПараметрыФункции, ВыводитьСообщения, ЭтоНоваяУчетнаяЗапись, НоваяУчетнаяЗапись, ВременныйКаталог, ВыполняемоеОповещение);
				
			КонецЕсли;
			
		Иначе
			
			ОбработатьОбновлениеНастройкаРПН(СтруктураАвтонастройкиРПН, СтруктураАвтонастройкиФТС, ПараметрыФункции, ВыводитьСообщения, ЭтоНоваяУчетнаяЗапись, НоваяУчетнаяЗапись, ВременныйКаталог, ВыполняемоеОповещение);
			
		КонецЕсли;
		
	Иначе
		
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,ВременныйКаталог);
		
		РезультатОбновления = Новый Структура("ПараметрыФункции, РезультатОбновления", ПараметрыФункции, Результат);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОбновления);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеНастройкаФССЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	НоваяУчетнаяЗапись = ДополнительныеПараметры.НоваяУчетнаяЗапись;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	СтруктураАвтонастройкиРПН = ДополнительныеПараметры.СтруктураАвтонастройкиРПН;
	СтруктураАвтонастройкиФТС = ДополнительныеПараметры.СтруктураАвтонастройкиФТС;
	СтруктураАвтонастройкиФСС = ДополнительныеПараметры.СтруктураАвтонастройкиФСС;
	ЭтоНоваяУчетнаяЗапись = ДополнительныеПараметры.ЭтоНоваяУчетнаяЗапись;
	
	ФлагАвтозаполнения = СтруктураАвтонастройкиФСС.ФлагАвтозаполнения;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		ФлагАвтозаполнения = Ложь;
	КонецЕсли;
	
	Если ФлагАвтозаполнения Тогда
		ОбновитьРегистрыСведенийНастройкиОбменаФСС(
			ПараметрыФункции.Организация,
			СтруктураАвтонастройкиФСС.ОтпечатокСертификата,
			СтруктураАвтонастройкиФСС.СертификатФССОтпечаток,
			СтруктураАвтонастройкиФСС.СертификатФССЭЛНОтпечаток,
			ВыводитьСообщения);
	КонецЕсли;
	
	ОбработатьОбновлениеНастройкаРПН(СтруктураАвтонастройкиРПН, СтруктураАвтонастройкиФТС, ПараметрыФункции, ВыводитьСообщения, ЭтоНоваяУчетнаяЗапись, НоваяУчетнаяЗапись, ВременныйКаталог, ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеНастройкаРПН(
		СтруктураАвтонастройкиРПН, 
		СтруктураАвтонастройкиФТС, 
		ПараметрыФункции, 
		ВыводитьСообщения, 
		ЭтоНоваяУчетнаяЗапись, 
		НоваяУчетнаяЗапись, 
		ВременныйКаталог, 
		ВыполняемоеОповещение)
	
	// производим настройку параметров РПН
	Если СтруктураАвтонастройкиРПН <> Неопределено И ПараметрыФункции.Организация <> Неопределено Тогда
		
		ФлагАвтозаполнения = СтруктураАвтонастройкиРПН.ФлагАвтозаполнения;
		Если СтруктураАвтонастройкиРПН.ФлагСообщения И ВыводитьСообщения Тогда
			
			Режим = РежимДиалогаВопрос.ДаНет;
			Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Произвести автоматическую настройку параметров отправки в Росприроднадзора для организации %1?';
																				|en = 'Set up parameters of sending to the Federal Supervisory Natural Resources Management Service for company %1 automatically?'"), ПараметрыФункции.Организация);
			
			ДополнительныеПараметры = Новый Структура("ВременныйКаталог, ВыводитьСообщения, ВыполняемоеОповещение, НоваяУчетнаяЗапись, ПараметрыФункции, СтруктураАвтонастройкиРПН, СтруктураАвтонастройкиФТС, ЭтоНоваяУчетнаяЗапись", ВременныйКаталог, ВыводитьСообщения, ВыполняемоеОповещение, НоваяУчетнаяЗапись, ПараметрыФункции, СтруктураАвтонастройкиРПН, СтруктураАвтонастройкиФТС, ЭтоНоваяУчетнаяЗапись);
			ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьОбновлениеНастройкаРПНЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ПоказатьВопрос(ОписаниеОповещения, Текст, Режим, 0, КодВозвратаДиалога.Нет, "Предупреждение");
			
		Иначе
			
			Если ФлагАвтозаполнения Тогда
				ОбновитьРегистрыСведенийНастройкиОбменаРПН(
					ПараметрыФункции.Организация, 
					СтруктураАвтонастройкиРПН.ОтпечатокСертификата,
					СтруктураАвтонастройкиРПН.СертификатРПНОтпечаток, 
					ВыводитьСообщения, 
					СтруктураАвтонастройкиРПН.EMail, 
					СтруктураАвтонастройкиРПН.Пароль);
			КонецЕсли;
			
			ОбработатьОбновлениеНастройкаФТС(
				СтруктураАвтонастройкиФТС, 
				ПараметрыФункции, 
				ВыводитьСообщения, 
				ЭтоНоваяУчетнаяЗапись, 
				НоваяУчетнаяЗапись, 
				ВременныйКаталог, 
				ВыполняемоеОповещение);
			
		КонецЕсли;
		
	Иначе
		
		ОбработатьОбновлениеНастройкаФТС(
			СтруктураАвтонастройкиФТС, 
			ПараметрыФункции, 
			ВыводитьСообщения, 
			ЭтоНоваяУчетнаяЗапись, 
			НоваяУчетнаяЗапись, 
			ВременныйКаталог, 
			ВыполняемоеОповещение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеНастройкаРПНЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	НоваяУчетнаяЗапись = ДополнительныеПараметры.НоваяУчетнаяЗапись;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	СтруктураАвтонастройкиРПН = ДополнительныеПараметры.СтруктураАвтонастройкиРПН;
	СтруктураАвтонастройкиФТС = ДополнительныеПараметры.СтруктураАвтонастройкиФТС;
	ЭтоНоваяУчетнаяЗапись = ДополнительныеПараметры.ЭтоНоваяУчетнаяЗапись;
	
	ФлагАвтозаполнения = СтруктураАвтонастройкиРПН.ФлагАвтозаполнения;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		ФлагАвтозаполнения = Ложь;
	КонецЕсли;
	
	Если ФлагАвтозаполнения Тогда
		ОбновитьРегистрыСведенийНастройкиОбменаРПН(
			ПараметрыФункции.Организация, СтруктураАвтонастройкиРПН.ОтпечатокСертификата,
			СтруктураАвтонастройкиРПН.СертификатРПНОтпечаток, ВыводитьСообщения, СтруктураАвтонастройкиРПН.EMail, СтруктураАвтонастройкиРПН.Пароль);
	КонецЕсли;
	
	ОбработатьОбновлениеНастройкаФТС(
		СтруктураАвтонастройкиФТС, 
		ПараметрыФункции, 
		ВыводитьСообщения, 
		ЭтоНоваяУчетнаяЗапись, 
		НоваяУчетнаяЗапись, 
		ВременныйКаталог, 
		ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеНастройкаФТС(
		СтруктураАвтонастройкиФТС, 
		ПараметрыФункции, 
		ВыводитьСообщения, 
		ЭтоНоваяУчетнаяЗапись, 
		НоваяУчетнаяЗапись, 
		ВременныйКаталог, 
		ВыполняемоеОповещение)
	
	// производим настройку параметров ФТС
	Если СтруктураАвтонастройкиФТС <> Неопределено И ПараметрыФункции.Организация <> Неопределено Тогда
		
		ФлагАвтозаполнения = СтруктураАвтонастройкиФТС.ФлагАвтозаполнения;
		Если СтруктураАвтонастройкиФТС.ФлагСообщения И ВыводитьСообщения Тогда
			
			Режим = РежимДиалогаВопрос.ДаНет;
			Текст = СтрШаблон(НСтр("ru = 'Произвести автоматическую настройку параметров отправки в ФТС для организации %1?';
									|en = 'Set up parameters of sending to FCS for company %1 automatically?'"), ПараметрыФункции.Организация);
			
			ДополнительныеПараметры = Новый Структура("ВременныйКаталог, ВыводитьСообщения, ВыполняемоеОповещение, НоваяУчетнаяЗапись, ПараметрыФункции, СтруктураАвтонастройкиФТС, ЭтоНоваяУчетнаяЗапись", ВременныйКаталог, ВыводитьСообщения, ВыполняемоеОповещение, НоваяУчетнаяЗапись, ПараметрыФункции, СтруктураАвтонастройкиФТС, ЭтоНоваяУчетнаяЗапись);
			ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьОбновлениеНастройкаФТСЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ПоказатьВопрос(ОписаниеОповещения, Текст, Режим, 0, КодВозвратаДиалога.Нет, "Предупреждение");
			
		Иначе
			
			Если ФлагАвтозаполнения Тогда
				ОбновитьРегистрыСведенийНастройкиОбменаФТС(
					ПараметрыФункции.Организация, СтруктураАвтонастройкиФТС.ОтпечатокСертификата,
					ВыводитьСообщения, СтруктураАвтонастройкиФТС.Логин, СтруктураАвтонастройкиФТС.Пароль);
			КонецЕсли;
			
			ОбработатьОбновлениеВернутьРезультат(ЭтоНоваяУчетнаяЗапись, ПараметрыФункции, НоваяУчетнаяЗапись, ВременныйКаталог, ВыполняемоеОповещение);
			
		КонецЕсли;
		
	Иначе
		
		ОбработатьОбновлениеВернутьРезультат(ЭтоНоваяУчетнаяЗапись, ПараметрыФункции, НоваяУчетнаяЗапись, ВременныйКаталог, ВыполняемоеОповещение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеНастройкаФТСЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	НоваяУчетнаяЗапись = ДополнительныеПараметры.НоваяУчетнаяЗапись;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	СтруктураАвтонастройкиФТС = ДополнительныеПараметры.СтруктураАвтонастройкиФТС;
	ЭтоНоваяУчетнаяЗапись = ДополнительныеПараметры.ЭтоНоваяУчетнаяЗапись;
	
	ФлагАвтозаполнения = СтруктураАвтонастройкиФТС.ФлагАвтозаполнения;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		ФлагАвтозаполнения = Ложь;
	КонецЕсли;
	
	Если ФлагАвтозаполнения Тогда
		ОбновитьРегистрыСведенийНастройкиОбменаФТС(
			ПараметрыФункции.Организация, СтруктураАвтонастройкиФТС.ОтпечатокСертификата,
			ВыводитьСообщения, СтруктураАвтонастройкиФТС.Логин, СтруктураАвтонастройкиФТС.Пароль);
	КонецЕсли;
	
	ОбработатьОбновлениеВернутьРезультат(ЭтоНоваяУчетнаяЗапись, ПараметрыФункции, НоваяУчетнаяЗапись, ВременныйКаталог, ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеВернутьРезультат(ЭтоНоваяУчетнаяЗапись, ПараметрыФункции, НоваяУчетнаяЗапись, ВременныйКаталог, ВыполняемоеОповещение)
	
	// при необходимости, показываем форму установки прав доступа для учетной записи
	Если ЭтоНоваяУчетнаяЗапись 
		И (ПараметрыФункции.ПутьКонтейнерЗакрытогоКлюча <> Неопределено ИЛИ ПараметрыФункции.ВызовИзМастераАвтонастройки) 
		И НЕ ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности Тогда
		
		ПараметрыФормы = Новый Структура("НоваяУчетнаяЗапись, Организация");
		ПараметрыФормы.НоваяУчетнаяЗапись 	= НоваяУчетнаяЗапись;
		ПараметрыФормы.Организация 			= ПараметрыФункции.Организация;
		
		ДополнительныеПараметры = Новый Структура(
			"ВременныйКаталог, ПараметрыФункции, ВыполняемоеОповещение", 
			ВременныйКаталог, 
			ПараметрыФункции, 
			ВыполняемоеОповещение);
			
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОбработатьОбновлениеВернутьРезультатЗавершение", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
		
		ОткрытьФорму(
			ПутьКОбъекту + ".Форма.ФормаУстановкиПравДоступа", 
			ПараметрыФормы,
			,
			,
			,
			,
			ОписаниеОповещения,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	Иначе
		
		Результат = Истина;
		
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,ВременныйКаталог);
		
		РезультатОбновления = Новый Структура(
			"ПараметрыФункции, РезультатОбновления", 
			ПараметрыФункции, 
			Результат);
			
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОбновления);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеВернутьРезультатЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,ВременныйКаталог);
	
	РезультатОбновления = Новый Структура("ПараметрыФункции, РезультатОбновления", ПараметрыФункции, Истина);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОбновления);
	
КонецПроцедуры

&НаСервере
Функция РегистрацияПолучитьДанныеССервера(ПараметрыФункции, ПовторятьСоединение = Ложь)

	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.РегистрацияПолучитьДанныеССервера(ПараметрыФункции, ПовторятьСоединение, Сертификаты);
	
КонецФункции

&НаСервере
Функция РегистрацияОбновитьСправочники(ПараметрыФункции)
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	
	ПараметрыФункции.НоваяУчетнаяЗапись = НоваяУчетнаяЗапись;
	
	Результат = КонтекстЭДОСервер.РегистрацияОбновитьСправочники(ПараметрыФункции);
	
	Если ЗначениеЗаполнено(ПараметрыФункции.НоваяУчетнаяЗапись) Тогда
		НоваяУчетнаяЗапись = ПараметрыФункции.НоваяУчетнаяЗапись;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура РегистрацияУстановитьСертификаты(ПараметрыФункции, ВыполняемоеОповещение)
	
	Если ПараметрыФункции.ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		РезультатВыполнения = РегистрацияУстановитьСертификатыНаСервере(ПараметрыФункции.ОтпечатокСертификата);
		Результат = Новый Структура("РезультатВыполнения, ПараметрыФункции", РезультатВыполнения, ПараметрыФункции);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	РегистрируемыеСертификаты = Новый Массив;
	Для каждого Сертификат Из Сертификаты Цикл
		РегистрируемыйСертификат = Новый Структура("Отпечаток", Сертификат.Отпечаток);
		РегистрируемыеСертификаты.Добавить(РегистрируемыйСертификат);
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ПараметрыФункции", ВыполняемоеОповещение, ПараметрыФункции);
	Оповещение = Новый ОписаниеОповещения("РегистрацияУстановитьСертификатыПослеПоискаСертификатовЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.НайтиСертификаты(Оповещение, РегистрируемыеСертификаты, , Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияУстановитьСертификатыПослеПоискаСертификатовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	
	Если НЕ Результат.Выполнено Тогда
		Результат = Новый Структура("РезультатВыполнения, ПараметрыФункции", Ложь, ПараметрыФункции);
		Результат.Вставить("ОшибкаПоискаСертификатовПередУстановкой", ИзвлечьОписаниеПричиныОшибки(Результат));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	МассивСертификатов = Результат.Сертификаты;
	
	ВременныйКаталог = ПараметрыФункции.ВременныйКаталог;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, МассивСертификатов, НомерСертификата", ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, МассивСертификатов, 0);
	Оповещение = Новый ОписаниеОповещения("РегистрацияУстановитьСертификатыЗаписьСертификатовВЦиклеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	РезультатЗаписиСертификатаВФайл = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, Неопределено);
	ВыполнитьОбработкуОповещения(Оповещение, РезультатЗаписиСертификатаВФайл);
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияУстановитьСертификатыЗаписьСертификатовВЦиклеЗавершение(РезультатЗаписиСертификатаВФайл, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	МассивСертификатов = ДополнительныеПараметры.МассивСертификатов;
	НомерСертификата = ДополнительныеПараметры.НомерСертификата;
	
	Если НЕ РезультатЗаписиСертификатаВФайл.Выполнено Тогда
		Результат = Новый Структура("РезультатВыполнения, ПараметрыФункции", Ложь, ПараметрыФункции);
		Результат.Вставить("ОшибкаЗаписиСертификатаВФайл", ИзвлечьОписаниеПричиныОшибки(РезультатЗаписиСертификатаВФайл));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	Пока НомерСертификата < Сертификаты.Количество() Цикл
		Сертификат = Сертификаты[НомерСертификата];
		НомерСертификата = НомерСертификата + 1;
		
		СертификатНайден = Ложь;
		Для каждого НайденныйСертификат Из МассивСертификатов Цикл
			Если нрег(СокрЛП(НайденныйСертификат.Отпечаток)) = нрег(СокрЛП(Сертификат.Отпечаток)) Тогда
				СертификатНайден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ СертификатНайден Тогда
			Сертификат.ТребуетсяУстановить = Истина;
			ПутьКФайлуСерта = ВременныйКаталог + Сертификат.Отпечаток + ".cer";
			ТелоСертификата = Сертификат.Тело;
			Если СтрНайти(ТелоСертификата, "BEGIN CERTIFICATE") = 0 Тогда
				ТелоСертификата = "-----BEGIN CERTIFICATE-----" + символы.ПС
								+ ТелоСертификата + символы.ПС
								+ "-----END CERTIFICATE-----";
			КонецЕсли;
			
			ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, МассивСертификатов, НомерСертификата", ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, МассивСертификатов, НомерСертификата);
			Оповещение = Новый ОписаниеОповещения("РегистрацияУстановитьСертификатыЗаписьСертификатовВЦиклеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ОперацииСФайламиЭДКОКлиент.ТекстВФайл(Оповещение, ТелоСертификата, ПутьКФайлуСерта);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ВыводитьСообщения = ПараметрыФункции.РежимАвтонастройки И НЕ ПараметрыФункции.ТихийРежим;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, ВыводитьСообщения, НомерСертификата", ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, ВыводитьСообщения, 0);
	Оповещение = Новый ОписаниеОповещения("РегистрацияУстановитьСертификатыУстановкаСертификатовВЦиклеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	РезультатУстановкиСертификата = Новый Структура("Выполнено, МенеджерКриптографии", Истина, Неопределено);
	ВыполнитьОбработкуОповещения(Оповещение, РезультатУстановкиСертификата);
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияУстановитьСертификатыУстановкаСертификатовВЦиклеЗавершение(РезультатУстановкиСертификата, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПараметрыФункции      = ДополнительныеПараметры.ПараметрыФункции;
	ВременныйКаталог      = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения     = ДополнительныеПараметры.ВыводитьСообщения;
	НомерСертификата      = ДополнительныеПараметры.НомерСертификата;
	
	Если НЕ РезультатУстановкиСертификата.Выполнено Тогда
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
			НСтр("ru = 'Не удалось установить личный сертификат!';
				|en = 'Cannot install a personal certificate.'"),
			ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности,
			ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности,
			ВыводитьСообщения);
		
		Результат = Новый Структура();
		Результат.Вставить("РезультатВыполнения",               Ложь);
		Результат.Вставить("ПараметрыФункции",                  ПараметрыФункции);
		Результат.Вставить("ОшибкаУстановкиЛичногоСертификата", ИзвлечьОписаниеПричиныОшибки(РезультатУстановкиСертификата));
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
		
	КонецЕсли;
	
	Пока НомерСертификата < Сертификаты.Количество() Цикл
		
		Сертификат       = Сертификаты[НомерСертификата];
		НомерСертификата = НомерСертификата + 1;
		
		Если Сертификат.ТребуетсяУстановить Тогда
		
			Если Сертификат.Хранилище = "MY" Тогда
				Если ПараметрыФункции.ПутьКонтейнерЗакрытогоКлюча <> Неопределено И Сертификат.ТипПолучателя = "" Тогда
					
					Если ЗначениеЗаполнено(ПараметрыФункции.ПутьКонтейнерЗакрытогоКлюча) Тогда
						
						ДополнительныеПараметры = Новый Структура();
						ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
						ДополнительныеПараметры.Вставить("ПараметрыФункции",      ПараметрыФункции);
						ДополнительныеПараметры.Вставить("ВременныйКаталог",      ВременныйКаталог);
						ДополнительныеПараметры.Вставить("ВыводитьСообщения",     ВыводитьСообщения);
						ДополнительныеПараметры.Вставить("НомерСертификата",      НомерСертификата);
						ДополнительныеПараметры.Вставить("Сертификат",            Сертификат);

						УстановитьСертификатВКонтейнерИХранилище(ДополнительныеПараметры);
							
						Возврат;
						
					Иначе
						
						ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
							НСтр("ru = 'Не удалось определить путь к контейнеру закрытого ключа!';
								|en = 'Cannot determine a path to the private key container.'"),
							ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности,
							ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности,
							ВыводитьСообщения);
							
						Результат = Новый Структура();
						Результат.Вставить("РезультатВыполнения", Ложь);
						Результат.Вставить("ПараметрыФункции",   ПараметрыФункции);
						Результат.Вставить("ОшибкаОпределенияПутиКонтейнера");
						
						ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
						Возврат;
						
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				
				ДополнительныеПараметры = Новый Структура();
				ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
				ДополнительныеПараметры.Вставить("ПараметрыФункции",      ПараметрыФункции);
				ДополнительныеПараметры.Вставить("ВременныйКаталог",      ВременныйКаталог);
				ДополнительныеПараметры.Вставить("ВыводитьСообщения",     ВыводитьСообщения);
				ДополнительныеПараметры.Вставить("НомерСертификата",      НомерСертификата);
				ДополнительныеПараметры.Вставить("Сертификат",            Сертификат);
				ДополнительныеПараметры.Вставить("СчетчикСертификата",    1);

				Оповещение = Новый ОписаниеОповещения(
					"РегистрацияУстановитьСертификатыИмпортСертификатовВЦиклеЗавершение", 
					ЭтотОбъект, 
					ДополнительныеПараметры);
					
				РезультатИмпортаСертификата = Новый Структура("Выполнено, МенеджерКриптографии", Ложь, Неопределено);
				
				ВыполнитьОбработкуОповещения(Оповещение, РезультатИмпортаСертификата);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура("РезультатВыполнения, ПараметрыФункции", Истина, ПараметрыФункции);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияУстановитьСертификатыИмпортСертификатовВЦиклеЗавершение(РезультатИмпортаСертификата, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	НомерСертификата = ДополнительныеПараметры.НомерСертификата;
	Сертификат = ДополнительныеПараметры.Сертификат;
	СчетчикСертификата = ДополнительныеПараметры.СчетчикСертификата;
	
	РезультатВыполнения = РезультатИмпортаСертификата.Выполнено;
	Пока СчетчикСертификата < 10 Цикл
		Если РезультатВыполнения Тогда
			Сертификат.Отпечаток = РезультатИмпортаСертификата.СвойстваСертификата.Отпечаток;
			Прервать;
		КонецЕсли;
		
		СчетчикСертификата = СчетчикСертификата + 1;
		
		ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, ВыводитьСообщения, НомерСертификата, Сертификат, СчетчикСертификата", ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, ВыводитьСообщения, НомерСертификата, Сертификат, СчетчикСертификата);
		Оповещение = Новый ОписаниеОповещения("РегистрацияУстановитьСертификатыИмпортСертификатовВЦиклеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		КриптографияЭДКОКлиент.ИмпортироватьСертификат(Оповещение, ВременныйКаталог + Сертификат.Отпечаток + ".cer", Сертификат.Хранилище, Ложь);
		Возврат;
	КонецЦикла;
	
	Если ВыводитьСообщения Тогда
		Если НЕ РезультатВыполнения Тогда
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось установить сертификат с отпечатком %1 в хранилище %2';
																																										|en = 'Cannot install the certificate with thumbprint %1 to storage %2'"), Сертификат.Отпечаток, Сертификат.Хранилище),
					ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности,
					ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности,
					ВыводитьСообщения);
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ РезультатВыполнения Тогда
		Результат = Новый Структура("РезультатВыполнения, ПараметрыФункции", Ложь, ПараметрыФункции);
		Результат.Вставить("ОшибкаУстановкиСертификатаВХранилище", ИзвлечьОписаниеПричиныОшибки(РезультатИмпортаСертификата));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, ВыводитьСообщения, НомерСертификата", ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, ВыводитьСообщения, НомерСертификата);
	Оповещение = Новый ОписаниеОповещения("РегистрацияУстановитьСертификатыУстановкаСертификатовВЦиклеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	РезультатУстановкиСертификата = Новый Структура("Выполнено, МенеджерКриптографии", Истина, Неопределено);
	ВыполнитьОбработкуОповещения(Оповещение, РезультатУстановкиСертификата);
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияРасшифроватьДанные(
		ЭтоЭлектроннаяПодписьВМоделиСервиса,
		ОтпечатокСертификата,
		ИдентификаторДокументооборота,
		ДанныеУзлаКонфиденциальнаяИнформацияАдрес,
		ВыводитьСообщения,
		ВыполняемоеОповещение)
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",                     ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ДанныеУзлаКонфиденциальнаяИнформацияАдрес", ДанныеУзлаКонфиденциальнаяИнформацияАдрес);
	ДополнительныеПараметры.Вставить("ВыводитьСообщения",                         ВыводитьСообщения);

	Оповещение = Новый ОписаниеОповещения(
		"РегистрацияРасшифроватьДанныеПослеРасшифрования", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	Сертификат = Новый Структура("Отпечаток", ОтпечатокСертификата);
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		Сертификат.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
		Сертификат.Вставить("КлючевойКонтейнер", ИдентификаторДокументооборота);
	КонецЕсли;
	
	КриптографияЭДКОКлиент.РасшифроватьPKCS7(Оповещение, ДанныеУзлаКонфиденциальнаяИнформацияАдрес, , Сертификат);
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияРасшифроватьДанныеПослеРасшифрования(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ДополнительныеПараметры.ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	
	АдресВоВременномХранилище = ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
	Если Результат.Выполнено Тогда
		АдресВоВременномХранилище = Результат.РасшифрованныйФайл;
	Иначе
		Если ВыводитьСообщения Тогда
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Ошибка криптографии. Невозможно расшифровать файл обновлений:
                      |%1';
                      |en = 'Cryptography error. Cannot decrypt update file:
                      |%1'"), 
				Результат.ОписаниеОшибки);
					  
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		КонецЕсли;
		РезультатВыполнения = Новый Структура("РезультатРасшифровки, АдресВоВременномХранилище", Ложь, Неопределено);
		РезультатВыполнения.Вставить("ОписаниеОшибки", Результат.ОписаниеОшибки);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения = Новый Структура("РезультатРасшифровки, АдресВоВременномХранилище", Истина, АдресВоВременномХранилище);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПараметрСпецоператораКлиент(Знач Спецоператор, ПараметрыСтруктура, Макет = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(Спецоператор) Тогда
		
		Если ТипЗнч(Спецоператор) = Тип("ПеречислениеСсылка.СпецоператорыСвязи") Тогда
			Имя = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьИмяЗначенияПеречисленияСпецоператорыСвязиПоСинониму(Спецоператор);
		Иначе
			Имя = Спецоператор.Имя;
		КонецЕсли;
		
		Если Макет = Неопределено Тогда
			Макет = ПолучитьМакетОбработки("ПараметрыСпецоператоровСвязи");
		КонецЕсли;
		
		Для Каждого Параметр Из ПараметрыСтруктура Цикл
			
			НомерКолонки = Макет.Область(Параметр.Ключ).Лево;
			
			Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
				ТекРегион = Макет.Область(НомерСтроки, 1).Текст;
				
				Если нРег(ТекРегион) = нРег(Имя) Тогда
					ПараметрыСтруктура.Вставить(Параметр.Ключ,Макет.Область(НомерСтроки, НомерКолонки).Текст);
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	Возврат ПараметрыСтруктура;
	
КонецФункции

#Область ОтправкаЗаявлениеНаПодключение

&НаКлиенте
Процедура СформироватьИОтправитьЗаявлениеПоказатьСообщениеОНевозможностиБезбумажногоПродления(ОповещениеОЗавершении, ОписаниеОшибки) Экспорт
	
	Контекст = Новый Структура("ОписаниеОповещения", ОповещениеОЗавершении);
	Оповещение = Новый ОписаниеОповещения("СформироватьИОтправитьПослеОтветаНаВопросОНеобходимостиОбычногоПродления", ЭтотОбъект, Контекст);
	ТекстВопроса = НСтр("ru = 'Продление с использованием электронной подписи невозможно по причине:
                         |%1
                         |
                         |Отправить заявление без подписания?';
                         |en = 'Extension by using a digital signature is impossible due to:
                         |%1
                         |
                         |Send the application without signature?'");
	ТекстВопроса = СтрШаблон(ТекстВопроса, ОписаниеОшибки); 
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьПослеОтветаНаВопросОНеобходимостиОбычногоПродления(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ИзменитьПризнакБезбумажногоПродления(ВходящийКонтекст.ОписаниеОповещения.ДополнительныеПараметры.ДокументЗаявление.Ссылка);
		ВходящийКонтекст.ОписаниеОповещения.ДополнительныеПараметры.Вставить("ЭтоБезбумажноеПродление", Ложь);
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОписаниеОповещения, Истина);
	Иначе
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОписаниеОповещения, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьЗаявлениеПослеОтветаНаВопросЭПВОблаке(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Истина Тогда
		СформироватьИОтправитьЗаявлениеВМоделиСервисов(
			ВходящийКонтекст.ДокументЗаявление, ВходящийКонтекст.ВыполняемоеОповещение);
	Иначе
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВозможноБезбумажноеПродление(ОповещениеОЗавершении, ВладелецСертификата) Экспорт
	
	Отпечаток = НРег(СтрЗаменить(ВладелецСертификата.Сертификат.Отпечаток, " ", ""));
	Контекст = Новый Структура("ВладелецСертификата, ОповещениеОЗавершении", ВладелецСертификата, ОповещениеОЗавершении);
	Оповещение = Новый ОписаниеОповещения("ВозможноБезбумажноеПродлениеПослеПоискаСертификатовВОблачномХранилище", ЭтотОбъект, Контекст);
	КриптографияЭДКОКлиент.НайтиСертификат(Оповещение, Новый Структура("Отпечаток,ЭтоЭлектроннаяПодписьВМоделиСервиса", Отпечаток, Истина), Ложь, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВозможноБезбумажноеПродлениеПослеПоискаСертификатовВОблачномХранилище(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		Если Результат.СертификатНайден Тогда
			ВходящийКонтекст.Вставить("Сертификат", Результат.СвойстваСертификата.Сертификат);
			ВозможноБезбумажноеПродлениеПослеПолученияСертификата(ВходящийКонтекст);
			Возврат;	
		КонецЕсли;
	КонецЕсли;
	
	Отпечаток = НРег(СтрЗаменить(ВходящийКонтекст.ВладелецСертификата.Сертификат.Отпечаток, " ", ""));
	Оповещение = Новый ОписаниеОповещения("ВозможноБезбумажноеПродлениеПослеПоискаСертификатов", ЭтотОбъект, ВходящийКонтекст);
	КриптографияЭДКОКлиент.НайтиСертификат(Оповещение, Новый Структура("Отпечаток,ЭтоЭлектроннаяПодписьВМоделиСервиса", Отпечаток, Ложь), Ложь, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВозможноБезбумажноеПродлениеПослеПоискаСертификатов(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		Если Результат.СертификатНайден Тогда
			ВходящийКонтекст.Вставить("Сертификат", Результат.СвойстваСертификата);
			Оповещение = Новый ОписаниеОповещения("ВозможноБезбумажноеПродлениеПослеЭкспортаСертификата", ЭтотОбъект, ВходящийКонтекст);
			КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(Оповещение, ВходящийКонтекст.ВладелецСертификата.Сертификат);
		Иначе
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Новый Структура("Выполнено,ОписаниеОшибки", Ложь, "Сертификат не найден"));
		КонецЕсли;
	Иначе 
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Результат); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВозможноБезбумажноеПродлениеПослеЭкспортаСертификата(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		ВходящийКонтекст.Вставить("Сертификат", Base64Значение(Результат.СтрокаBase64));
		ВозможноБезбумажноеПродлениеПослеПолученияСертификата(ВходящийКонтекст);
	Иначе
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВозможноБезбумажноеПродлениеПослеПолученияСертификата(ВходящийКонтекст)
	
	БезбумажноеПродлениеВозможно = Истина;
	Причины = Новый Массив;
	СвойстваСертификата = ПолучитьСвойстваСертификатаДляПроверкиБезбумажногоПродленияНаСервере(ВходящийКонтекст.Сертификат);
	
	ТекущаяДата = ОбщегоНазначенияКлиент.ДатаСеанса();
	
	Если Не(СвойстваСертификата.ДатаНачала < ТекущаяДата И СвойстваСертификата.ДатаОкончания > ТекущаяДата) Тогда
		БезбумажноеПродлениеВозможно = Ложь;
		
		Причины.Добавить(НСтр("ru = 'Срок действия сертификата истек или еще не наступил';
								|en = 'Certificate validity period has expired or has not started yet'"));
	КонецЕсли;
	
	СНИЛС = СтрЗаменить(СтрЗаменить(ВходящийКонтекст.ВладелецСертификата.СНИЛС, " ", ""), "-", "");
	Если СНИЛС <> СвойстваСертификата.СНИЛС Тогда
		БезбумажноеПродлениеВозможно = Ложь;
		
		Причины.Добавить(НСтр("ru = 'СНИЛС владельца сертификата отличается от значения указанного в сертификате';
								|en = 'Certificate owner IIAN differs from the value specified in the certificate'"));
	КонецЕсли;
	
	Если ВходящийКонтекст.ВладелецСертификата.ИНН <> СвойстваСертификата.ИНН Тогда
		БезбумажноеПродлениеВозможно = Ложь;
		
		Причины.Добавить(НСтр("ru = 'ИНН отличается от значения указанного в сертификате';
								|en = 'TIN differs from the value specified in the certificate'"));
	КонецЕсли;
	
	ФИО = ВРег(СтрЗаменить(СтрЗаменить(СтрЗаменить(ВходящийКонтекст.ВладелецСертификата.ФИО, "-", ""), " ", ""), "_", ""));
	ФИОИсходный = ВРег(СтрЗаменить(СтрЗаменить(СтрЗаменить(СвойстваСертификата.ФИО, "-", ""), " ", ""), "_", ""));
	Если ФИО <> ФИОИсходный Тогда
		БезбумажноеПродлениеВозможно = Ложь;
		
		Причины.Добавить(НСтр("ru = 'ФИО владельца сертификата отличается от ФИО указанного в сертификате';
								|en = 'Certificate owner full name differs from the full name specified in the certificate'"));
	КонецЕсли;
	
	РезультатВыполнения = Новый Структура("Выполнено", Истина);
	РезультатВыполнения.Вставить("БезбумажноеПродлениеВозможно", БезбумажноеПродлениеВозможно);
	Если Не БезбумажноеПродлениеВозможно Тогда
		РезультатВыполнения.Вставить("Причина", СтрСоединить(Причины, Символы.ПС));	
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, РезультатВыполнения);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСвойстваСертификатаДляПроверкиБезбумажногоПродленияНаСервере(ФайлСертификата) Экспорт
	
	Сертификат = Новый СертификатКриптографии(ФайлСертификата);
	
	Свойства = Новый Структура;	
	Если НЕ Сертификат.Субъект.Свойство("OID2_5_4_4") // Фамилия
		ИЛИ НЕ Сертификат.Субъект.Свойство("OID2_5_4_42") // Имя[ Отчетство]
		ИЛИ НЕ Сертификат.Субъект.Свойство("OID1_2_643_100_3") // СНИЛС	
		ИЛИ НЕ Сертификат.Субъект.Свойство("OID1_2_643_3_131_1_1") Тогда // ИНН
		Возврат Свойства;	
	КонецЕсли;
	
	ФИО = СокрЛП(Сертификат.Субъект["OID2_5_4_4"]) + " " + СокрЛП(Сертификат.Субъект["OID2_5_4_42"]);
	ИНН = Сертификат.Субъект["OID1_2_643_3_131_1_1"];
	Если Лев(ИНН, 2) = "00" Тогда
		ИНН = Сред(ИНН, 3);
	КонецЕсли;
	
	Свойства.Вставить("ФИО", ФИО);
	Свойства.Вставить("СНИЛС", Сертификат.Субъект["OID1_2_643_100_3"]);
	Свойства.Вставить("ИНН", ИНН);
	Свойства.Вставить("ДатаНачала", Сертификат.ДатаНачала);
	Свойства.Вставить("ДатаОкончания", Сертификат.ДатаОкончания);
	Свойства.Вставить("Издатель", Сертификат.Издатель.O);
	
	Возврат Свойства;
	
КонецФункции

&НаКлиенте
Процедура СформироватьИОтправитьЗаявлениеПроверитьВозможностьБезбумажногоПродления(ОповещениеОЗавершении, ДокументЗаявление)
	
	Сертификат = ПолучитьСертификатИзЗаявленияНаСервере(ДокументЗаявление.Ссылка);
	
	ВладелецСертификата = Новый Структура;
	ВладелецСертификата.Вставить("ФИО",   ДокументЗаявление.ВладелецЭЦП);
	ВладелецСертификата.Вставить("СНИЛС", ДокументЗаявление.ВладелецЭЦПСНИЛС);
	ВладелецСертификата.Вставить("ИНН",   ДокументЗаявление.ИНН);
	ВладелецСертификата.Вставить("Сертификат", Сертификат);
	
	ВозможноБезбумажноеПродление(ОповещениеОЗавершении, ВладелецСертификата);	
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьЗаявлениеПослеПроверкиВозможностиБезбумажногоПродления(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		Если Не Результат.БезбумажноеПродлениеВозможно Тогда
			ВходящийКонтекст.БезбумажноеПродлениеОписаниеОшибки = Результат.Причина;
		КонецЕсли;
		ВходящийКонтекст.БезбумажноеПродлениеВозможно = Результат.БезбумажноеПродлениеВозможно;
	Иначе
		ВходящийКонтекст.БезбумажноеПродлениеВозможно = Ложь;
		ВходящийКонтекст.БезбумажноеПродлениеОписаниеОшибки = НСтр("ru = 'Не удалось выполнить проверку возможности безбумажного продления';
																	|en = 'Cannot check the possibility of paperless extension'");
	КонецЕсли;
	
	СформироватьИОтправитьЗаявление_ПослеПроверкиВозможностиБезбумажногоПродления(ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыПроцедурыСформироватьИОтправитьЗаявление() Экспорт
	
	Контекст = Новый Структура;
	Контекст.Вставить("ДокументЗаявление", 							Неопределено);
	Контекст.Вставить("ИдентификаторАбонента", 						"");
	Контекст.Вставить("ВызовИзМастераПодключенияК1СОтчетности", 	Ложь);
	Контекст.Вставить("ВыполняемоеОповещение", 						Неопределено);
	Контекст.Вставить("ФормироватьЗакрытыйКлючИЗапросНаСертификат", Истина);
	
	// Следующие параметры определяются внутри процедуры СформироватьИОтправитьЗаявление
	
	// Вторичное заявление. Безбумажное продление
	Контекст.Вставить("БезбумажноеПродлениеВозможно", 		Ложь);
	Контекст.Вставить("БезбумажноеПродлениеОписаниеОшибки", "");
	Контекст.Вставить("ЭтоБезбумажноеПродление", 			Ложь);
	Контекст.Вставить("ЭтоРучноеЗаявление", 				Ложь);
	
	// Первичное заявление. Электронное подписание упрощенного заявления
	Контекст.Вставить("СтороннийСертификат", 				Неопределено);
	Контекст.Вставить("СтороннийСертификатДляПлатформы", 	Неопределено);
	Контекст.Вставить("МенеджерКриптографии", 				Неопределено); // Платформенский
	Контекст.Вставить("ЭтоУпрощенноеЗаявление", 			Ложь);
	Контекст.Вставить("ПодписатьСтороннимСертификатом", 	Ложь);
	Контекст.Вставить("АдресТекстаОтправленногоЗаявления", 	Неопределено);
	Контекст.Вставить("ПрисоединенныйФайлЗаявления", 		Неопределено);
	Контекст.Вставить("ФормаВладелец", 						Неопределено);
	Контекст.Вставить("OIDЛицензииКриптоПро", 				"");
	
	// Будут вычеслены в ходе отправки
	Контекст.Вставить("АдресПодписиПодЗаявлением", 	Неопределено);
	Контекст.Вставить("СканыКЗаявлению", 			Новый Массив);
	Контекст.Вставить("ЭтоПервичноеЗаявление", 		Неопределено);
	Контекст.Вставить("ЭтоНулевка", 				Ложь);
	
	Возврат Контекст;
	
КонецФункции

// Описание параметров находится в процедуре ПараметрыПроцедурыСформироватьИОтправитьЗаявление
&НаКлиенте
Процедура СформироватьИОтправитьЗаявление(Контекст) Экспорт
	
	ДокументЗаявление 		= Контекст.ДокументЗаявление;
	ЭтоУпрощенноеЗаявление 	= ДокументЗаявление.ЭтоУпрощенноеЗаявление;
	
	// Безбумажное продление вторичного заявления
	Контекст.Вставить("БезбумажноеПродлениеВозможно", 		Ложь);
	Контекст.Вставить("БезбумажноеПродлениеОписаниеОшибки", "");
	Контекст.Вставить("ЭтоБезбумажноеПродление", 			ДокументЗаявление.ПодписатьЭП И НЕ ЭтоУпрощенноеЗаявление И НЕ Контекст.ЭтоРучноеЗаявление);
	Контекст.Вставить("АлгоритмКонтейнераКлючей", 			Неопределено);
	
	// Электронное подписание упрощенного заявления
	Контекст.Вставить("ЭтоУпрощенноеЗаявление", 			ЭтоУпрощенноеЗаявление);
	Контекст.Вставить("ПодписатьСтороннимСертификатом", 	ДокументЗаявление.ПодписатьЭП И ЭтоУпрощенноеЗаявление);
	
	Контекст.Вставить("ЭтоПервичноеЗаявление",
		ДокументЗаявление.ТипЗаявления = ПредопределенноеЗначение("Перечисление.ТипыЗаявленияАбонентаСпецоператораСвязи.Первичное"));
	
	Если Контекст.ЭтоБезбумажноеПродление Тогда // Безбумажное продление _вторичного_ заявления. Для первичного по-другой ветке
		Оповещение = Новый ОписаниеОповещения("СформироватьИОтправитьЗаявлениеПослеПроверкиВозможностиБезбумажногоПродления", ЭтотОбъект, Контекст);		
		СформироватьИОтправитьЗаявлениеПроверитьВозможностьБезбумажногоПродления(Оповещение, ДокументЗаявление);
	Иначе
		СформироватьИОтправитьЗаявление_ПослеПроверкиВозможностиБезбумажногоПродления(Контекст);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьЗаявление_ПослеПроверкиВозможностиБезбумажногоПродления(ВходящийКонтекст)
	
	ДокументЗаявление = ВходящийКонтекст.ДокументЗаявление; 
	
	ВходящийКонтекст.Вставить("ВыводитьСообщения", 				Ложь);
	ВходящийКонтекст.Вставить("Статус", 						ДокументЗаявление.Статус);
	ВходящийКонтекст.Вставить("ДатаОтправки", 					ДокументЗаявление.ДатаОтправкиЗаявления);
	ВходящийКонтекст.Вставить("СтатусКомментарий", 				ДокументЗаявление.СтатусКомментарий);
	ВходящийКонтекст.Вставить("ПутьКонтейнерЗакрытогоКлюча",	ДокументЗаявление.ПутьКонтейнерЗакрытогоКлюча);
	ВходящийКонтекст.Вставить("ТекстОшибокДляМастераПодключенияК1СОтчетности",  "");
	ВходящийКонтекст.Вставить("ТекстЗапросаНаСертификат", 		"");
	
	Если ВходящийКонтекст.ЭтоБезбумажноеПродление И НЕ ВходящийКонтекст.БезбумажноеПродлениеВозможно Тогда
		
		// Только для вторичного
		Оповещение = Новый ОписаниеОповещения(
			"СформироватьИОтправитьЗаявлениеПослеОтветаНаВопросПервичныйКонтроль", 
			ЭтотОбъект, 
			ВходящийКонтекст);
			
		СформироватьИОтправитьЗаявлениеПоказатьСообщениеОНевозможностиБезбумажногоПродления(
			Оповещение, 
			ВходящийКонтекст.БезбумажноеПродлениеОписаниеОшибки);
			
	ИначеЕсли ДокументЗаявление.ЭлектроннаяПодписьВМоделиСервиса Тогда
		
		СформироватьИОтправить_ПодписатьЗаявление(ВходящийКонтекст);
		
	Иначе
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"СформироватьИОтправитьЗаявление_ПослеПолученияВременногоКаталога", 
			ЭтотОбъект, 
			ВходящийКонтекст);
			
		ОперацииСФайламиЭДКОКлиент.СоздатьКаталогНаКлиенте(ОписаниеОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьЗаявлениеПослеОтветаНаВопросПервичныйКонтроль(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Истина Тогда
		ИзменитьПризнакБезбумажногоПродления(ВходящийКонтекст.ДокументЗаявление.Ссылка);
		ВходящийКонтекст.Вставить("ЭтоБезбумажноеПродление", Ложь);
		СформироватьИОтправитьЗаявление_ПослеПроверкиВозможностиБезбумажногоПродления(ВходящийКонтекст);
	Иначе
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьЗаявлениеВМоделиСервисов(ДокументЗаявление, ВыполняемоеОповещение)
	
	// Реквизиты формы, чтобы потом работать с ними в подключаемой процедуре
	ОписаниеОповещенияПослеОтправкиЗаявления = ВыполняемоеОповещение;
	ОтправляемоеЗаявление 					 = ДокументЗаявление.Ссылка;
	
	АлгоритмКонтейнераКлючей = ЗаявлениеОпределитьАлгоритмДляСозданияКонтейнераКлючей(ДокументЗаявление);
	Если АлгоритмКонтейнераКлючей = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'При получении алгоритма генерации ключей возникла ошибка. Сервис временно недоступен.';
							|en = 'The error occurred while receiving the key generation algorithm. The service is temporary unavailable.'");
		РезультатВыполнения = Новый Структура("ТекстОшибки", ТекстОшибки);
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияПослеОтправкиЗаявления, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	НачатьОтправкуОблачногоЗаявленияВБазуЗаявок(ДокументЗаявление.Ссылка, АлгоритмКонтейнераКлючей);
	ПодключитьОбработчикОжидания("Подключаемый_ПроверитьСостояниеОтправкиОблачногоЗаявленияВБазуЗаявок", 1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьЗаявление_ПослеПолученияВременногоКаталога(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Выполнено Тогда
	
		ВременныйКаталог = Результат.ИмяКаталога;
		ДополнительныеПараметры.Вставить("ВременныйКаталог", ВременныйКаталог);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("СформироватьИОтправитьЗаявление_ПослеФормированияКлюча", ЭтотОбъект, ДополнительныеПараметры);
		
		Если ДополнительныеПараметры.ФормироватьЗакрытыйКлючИЗапросНаСертификат Тогда
			
			// Подменяем оповещение, чтобы не сразу вернуться в заявление, а обработать результат
			ВходящийКонтекст = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительныеПараметры);
			ВходящийКонтекст.ВыполняемоеОповещение = ОписаниеОповещения;
			
			ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификат(ВходящийКонтекст);
				
		Иначе
			
			ДополнительныеПараметры.Вставить("ТекстЗапросаНаСертификат", 	"");
			ДополнительныеПараметры.Вставить("ПродолжитьОтправкуЗаявления", Истина);
			ДополнительныеПараметры.Вставить("ТекстОшибки", 				"");
			ДополнительныеПараметры.Вставить("ПутьКонтейнерЗакрытогоКлюча", ДополнительныеПараметры.ПутьКонтейнерЗакрытогоКлюча);
			
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, ДополнительныеПараметры);
		КонецЕсли;
	Иначе
		Результат = Новый Структура("ТекстОшибки", Результат.ОписаниеОшибки);
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьЗаявление_ПослеФормированияКлюча(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.ПродолжитьОтправкуЗаявления Тогда
		
		ДокументЗаявление 			= ДополнительныеПараметры.ДокументЗаявление;
		ИдентификаторАбонента 		= ДополнительныеПараметры.ИдентификаторАбонента;
		ТекстЗапросаНаСертификат 	= Результат.ТекстЗапросаНаСертификат;
		АлгоритмКонтейнераКлючей 	= Результат.АлгоритмКонтейнераКлючей;
		
		Если ЭтоЗаявлениеНаИзменениеРеквизитовПодключения(ДокументЗаявление) Тогда
			АдресЗаявления = ЗаявлениеСформироватьЗаявлениеНаИзменение(
				ДокументЗаявление, 
				ТекстЗапросаНаСертификат, 
				ИдентификаторАбонента,
				АлгоритмКонтейнераКлючей);
				
			ПрисоединенныйФайлЗаявления = ПрисоединитьФайлЗаявления(
				ДокументЗаявление, 
				АдресЗаявления, 
				"Заявление_на_изменение");
			
		Иначе
			АдресЗаявления = ЗаявлениеСформироватьЗаявлениеНаРегистрацию(
				ДокументЗаявление, 
				ТекстЗапросаНаСертификат, 
				ИдентификаторАбонента,
				АлгоритмКонтейнераКлючей);
				
			ПрисоединенныйФайлЗаявления = ПрисоединитьФайлЗаявления(
				ДокументЗаявление, 
				АдресЗаявления, 
				"Заявление_на_подключение");
				
		КонецЕсли;

		ДополнительныеПараметры.Вставить("ПрисоединенныйФайлЗаявления", ПрисоединенныйФайлЗаявления);
		
		УпакованныеФайлы = ОперацииСФайламиЭДКОВызовСервера.УпаковатьФайлы(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый Структура("Адрес,Имя", АдресЗаявления, "file")), 
			УникальныйИдентификатор);

		ДополнительныеПараметры.Вставить("АдресАрхивированногоЗаявленияНаРегистрацию", 	УпакованныеФайлы);
		ДополнительныеПараметры.Вставить("АдресТекстаОтправленногоЗаявления", 			АдресЗаявления);
		
		// Копируем из результата
		ДополнительныеПараметры.Вставить("ПродолжитьОтправкуЗаявления", 					Результат.ПродолжитьОтправкуЗаявления);
		ДополнительныеПараметры.Вставить("ПутьКонтейнерЗакрытогоКлюча", 					Результат.ПутьКонтейнерЗакрытогоКлюча);
		ДополнительныеПараметры.Вставить("ТекстОшибокДляМастераПодключенияК1СОтчетности", 	Результат.ТекстОшибки);
		
		СформироватьИОтправить_ПодписатьЗаявление(ДополнительныеПараметры);
		
	Иначе
		
		ДополнительныеПараметры.Вставить("ПродолжитьОтправкуЗаявления", 					Ложь);
		ДополнительныеПараметры.Вставить("АдресТекстаОтправленногоЗаявления", 				"");
		ДополнительныеПараметры.Вставить("ТекстОшибокДляМастераПодключенияК1СОтчетности", 	Результат.ТекстОшибки);
		
		Результат = Новый Структура("Выполнено", Истина);
		
		СформироватьИОтправитьФайлыЗаявления(Результат, ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаявлениеСформироватьИОтправитьПакет(ПараметрыФункции)
	
	ВременныйКаталог = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	
	ПараметрыФункции.Вставить("ИмяФайлаЗаявлениеНаРегистрацию", 	СгенерироватьИмяФайлаДокументаВСоставеПакета());
	ПараметрыФункции.Вставить("ИмяФайлаПодписьПодЗаявлением", 		СгенерироватьИмяФайлаДокументаВСоставеПакета());
	ПараметрыФункции.Вставить("ИмяФайлаОписаниеПакета", 			"packageDescription.xml");
	ПараметрыФункции.Вставить("ИдентификаторАбонента", 				Сред(ПараметрыФункции.ДокументЗаявление.УчетнаяЗапись.ИдентификаторАбонента, 4));
	ПараметрыФункции.Вставить("ВременныйКаталог", 					ВременныйКаталог);
	ПараметрыФункции.Вставить("ИдентификаторДокументооборота",  	ПараметрыФункции.ДокументЗаявление.ИдентификаторДокументооборота);
	ПараметрыФункции.Вставить("СпецОператорСвязиДокументооборота", 	ПараметрыФункции.ДокументЗаявление.СпецОператорСвязи);
	
	ЗаявлениеСформироватьОписаниеПакета(ПараметрыФункции);
	
	ФайлыПакета = Новый Массив;
	
	// Заявление
	ОписанияФайлаЗаявления = Новый Структура();
	ОписанияФайлаЗаявления.Вставить("Адрес", ПараметрыФункции.АдресАрхивированногоЗаявленияНаРегистрацию);
	ОписанияФайлаЗаявления.Вставить("Имя", 	 ПараметрыФункции.ИмяФайлаЗаявлениеНаРегистрацию);
	ФайлыПакета.Добавить(ОписанияФайлаЗаявления);
	
	Если ПараметрыФункции.Свойство("АдресПодписиПодЗаявлением") И ЭтоАдресВременногоХранилища(ПараметрыФункции.АдресПодписиПодЗаявлением) Тогда
		
		// Подпись заявления
		ОписанияФайлаПодписиЗаявления = Новый Структура();
		ОписанияФайлаПодписиЗаявления.Вставить("Адрес", ПараметрыФункции.АдресПодписиПодЗаявлением);
		ОписанияФайлаПодписиЗаявления.Вставить("Имя", 	ПараметрыФункции.ИмяФайлаПодписьПодЗаявлением);
		
		ФайлыПакета.Добавить(ОписанияФайлаПодписиЗаявления);
		
	КонецЕсли;
	
	Если ПараметрыФункции.Свойство("СканыКЗаявлению") Тогда
		
		СканыКЗаявлению = ПараметрыФункции.СканыКЗаявлению;
		Для каждого Скан Из СканыКЗаявлению Цикл
			
			// Скан
			ОписанияСкана = Новый Структура();
			ОписанияСкана.Вставить("Адрес", Скан.АдресДанных);
			ОписанияСкана.Вставить("Имя", 	Скан.ИмяФайлаДанных);
			
			ФайлыПакета.Добавить(ОписанияСкана);
			
			Если ЗначениеЗаполнено(Скан.АдресПодписи) И ЭтоАдресВременногоХранилища(Скан.АдресПодписи) Тогда
				
				// Подпись скана
				ОписанияПодписиСкана = Новый Структура();
				ОписанияПодписиСкана.Вставить("Адрес",  Скан.АдресПодписи);
				ОписанияПодписиСкана.Вставить("Имя", 	Скан.ИмяФайлаПодписи);

				ФайлыПакета.Добавить(ОписанияПодписиСкана);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ПутьКФайлуОписания 		= ПараметрыФункции.ВременныйКаталог + ПараметрыФункции.ИмяФайлаОписаниеПакета;
	ДвДанныеФайлаОписания 	= Новый ДвоичныеДанные(ПутьКФайлуОписания);
	АдресФайлаОписания 		= ПоместитьВоВременноеХранилище(ДвДанныеФайлаОписания);
	
	// Описание архива
	ОписанияФайлаОписания = Новый Структура();
	ОписанияФайлаОписания.Вставить("Адрес", АдресФайлаОписания);
	ОписанияФайлаОписания.Вставить("Имя", 	ПараметрыФункции.ИмяФайлаОписаниеПакета);
		
	ФайлыПакета.Добавить(ОписанияФайлаОписания);
	
	Пакет = ОперацииСФайламиЭДКОВызовСервера.УпаковатьФайлы(ФайлыПакета);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВременныйКаталог);
	
	ПрисоединитьФайлЗаявления(ПараметрыФункции.ДокументЗаявление, Пакет, "Пакет_с_заявлением", "zip");
	
	ОбменССерверомОтправитьЗаявление(
		Пакет, 
		ПараметрыФункции.ДокументЗаявление.СпецоператорСвязи, 
		ПараметрыФункции.Статус, 
		ПараметрыФункции.ДатаОтправки, 
		ПараметрыФункции.СтатусКомментарий,
		ПараметрыФункции.СостояниеОтправкиСообщения,
		ПараметрыФункции.ВызовИзМастераПодключения, 
		ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности, 
		ПараметрыФункции.ПовторятьСоединение);
		
КонецПроцедуры

&НаСервере
Функция ЗаявлениеСформироватьЗаявлениеНаРегистрацию(
		Знач ДокументЗаявление, 
		ТекстЗапросаНаСертификат, 
		Знач ИдентификаторАбонента = "",
		АлгоритмКонтейнераКлючей = Неопределено)
	//необходимо 
	//1. сформировать XML файл
	//2. вставить в него запрос
	//3. заархивировать
	//4. отдать на сторону клиента
	
	ЭтоУпрощенноеЗаявление = ДокументЗаявление.ЭтоУпрощенноеЗаявление;
	
	ВременныйКаталогНаСервере = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	
	ИмяВременногоФайлаЗаявления = ВременныйКаталогНаСервере + "file";
	ИмяВременногоФайлаАрхива = ВременныйКаталогНаСервере + "архив.zip";
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаЗаявления,"windows-1251");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Заявление");
	Если ЭтоУпрощенноеЗаявление Тогда
		ЗаписьXML.ЗаписатьАтрибут("ВерсФорм","2.1");
	Иначе
		ЗаписьXML.ЗаписатьАтрибут("ВерсФорм","1.7");
	КонецЕсли;
		
	ЗаписьXML.ЗаписатьАтрибут("ДатаВремяФормирования", XMLСтрока(ТекущаяДатаСеанса()));
	ЗаписьXML.ЗаписатьАтрибут("ВерсПрог", РегламентированнаяОтчетность.НазваниеИВерсияПрограммы());
	
	ЗаписатьУзелXML(ЗаписьXML,"ТипЗаявления", ПолучитьТипЗаявления(ДокументЗаявление.ТипЗаявления));
	
	Если НЕ ЭтоУпрощенноеЗаявление Тогда
		ЗаписатьУзелXML(ЗаписьXML,"УчетнаяЗапись", ИдентификаторАбонента);
	КонецЕсли;
	
	ЗаписатьУзелXML(ЗаписьXML,"ПризнакЮридическогоЛица", XMLСтрока(СтрДлина(ДокументЗаявление.ИНН)=10));
	ЗаписатьУзелXML(ЗаписьXML,"ПризнакУполномоченногоПредставителя",XMLСтрока(ДокументЗаявление.ПризнакУполномоченногоПредставителя));
	ЗаписатьУзелXML(ЗаписьXML,"ПризнакОбособленногоПодразделения",XMLСтрока(ДокументЗаявление.ПризнакОбособленногоПодразделения));
	
	ЗаписатьУзелXML(ЗаписьXML,"ИНН", ДокументЗаявление.ИНН);
	ЗаписатьУзелXML(ЗаписьXML,"КПП", ДокументЗаявление.КПП, Истина);
	ЗаписатьУзелXML(ЗаписьXML,"ОГРН", ДокументЗаявление.ОГРН, Истина);
	
	Если НЕ ЗначениеЗаполнено(ДокументЗаявление.ОГРН) И ДокументЗаявление.ЭтоНотариусАдвокатИлиГКФХ Тогда
		ЗаписатьУзелXML(ЗаписьXML,"ПризнакФизическогоЛица", XMLСтрока(Истина));
	КонецЕсли;
	
	ЗаписатьУзелXML(ЗаписьXML,"НомерОсновнойПоставки1с", ДокументЗаявление.НомерОсновнойПоставки1с);
	
	Если НЕ ЭтоУпрощенноеЗаявление Тогда
		ЗаписатьУзелXML(ЗаписьXML,"ПолноеНаименование", ДокументЗаявление.ПолноеНаименование);
	КонецЕсли;
		
	ЗаписатьУзелXML(ЗаписьXML,"КраткоеНаименование", ДокументЗаявление.КраткоеНаименование);
	ЗаписатьУзелXML(ЗаписьXML,"ТелефонОсновной", ДокументЗаявление.ТелефонОсновной);
	
	Если НЕ ЭтоУпрощенноеЗаявление Тогда
		ЗаписатьУзелXML(ЗаписьXML,"ТелефонДополнительный",ДокументЗаявление.ТелефонДополнительный, Истина);
	КонецЕсли;
		
	ТелефонМобильныйБезРазделителей = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ТелефонМобильныйБезРазделителей(ДокументЗаявление.ТелефонМобильный);
	ЗаписатьУзелXML(ЗаписьXML,"ТелефонМобильный", ТелефонМобильныйБезРазделителей, Истина);
	ЗаписатьУзелXML(ЗаписьXML,"ЭлектроннаяПочта", ДокументЗаявление.ЭлектроннаяПочта, Истина);
	
	ЗаписатьУзелXML(ЗаписьXML,"РегНомерПФР", ДокументЗаявление.РегНомерПФР, Истина);
	
	ЗаписатьУзелXML(ЗаписьXML,"Комментарий", ДокументЗаявление.Комментарий, Истина);
	
	ЗаписатьАдресXML(ЗаписьXML,"АдресЮридический", ДокументЗаявление);
	ЗаписатьАдресXML(ЗаписьXML,"АдресФактический", ДокументЗаявление);
	
	ДописатьВЗаявлениеСведенияОВладельцеЭП(
		ДокументЗаявление,
		ЗаписьXML,
		ТекстЗапросаНаСертификат,,,
		АлгоритмКонтейнераКлючей);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Получатели");
	
	ТаблицаПолучателей = ДокументЗаявление.Получатели.Выгрузить();
	ТаблицаПолучателей.Сортировать("ТипПолучателя, КодПолучателя, КПП");
		
	Для Счетчик = 0 По ТаблицаПолучателей.Количество()-1 Цикл
		Получатель = ТаблицаПолучателей[Счетчик];
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Получатель");
		ЗаписатьУзелXML(ЗаписьXML, "ТипПолучателя", XMLСтрока(Получатель.ТипПолучателя));
		
		// если получатель - ФСС, пишем только тип получателя, а код получателя не записываем, его у нас и нет
		Если Получатель.ТипПолучателя = СтруктураСсылочныхДанных.Перечисления_ТипыКонтролирующихОрганов_ФСС Тогда
			ЗаписатьУзелXML(ЗаписьXML, "КодПолучателя", Получатель.КодПолучателя, Истина);
		Иначе 
			ЗаписатьУзелXML(ЗаписьXML, "КодПолучателя", Получатель.КодПолучателя);
		КонецЕсли;
		
		Если Не ПустаяСтрока(Получатель.КПП) Тогда 
			ЗаписьXML.ЗаписатьНачалоЭлемента("ПереченьКПП");
			ЗаписатьУзелXML(ЗаписьXML, "КПП", Получатель.КПП);
			
			Для Счетчик1 =  Счетчик + 1 По ТаблицаПолучателей.Количество()-1 Цикл
				Получатель1= ТаблицаПолучателей[Счетчик1];
				
				Если Получатель1.ТипПолучателя = Получатель.ТипПолучателя И
					Получатель1.КодПолучателя = Получатель.КодПолучателя И
					Не ПустаяСтрока(Получатель1.КПП) Тогда
					
					ЗаписатьУзелXML(ЗаписьXML, "КПП", Получатель1.КПП);
					Счетчик = Счетчик1;
					
				Иначе
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // конец элемента Получатель
		
	КонецЦикла;
	
	Если ДокументЗаявление.ПодатьЗаявкуНаСертификатДляФСРАР Тогда
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Получатель");
		ЗаписатьУзелXML(ЗаписьXML, "ТипПолучателя", "ФСРАР");
		ЗаписатьУзелXML(ЗаписьXML, "КодПолучателя", XMLСтрока(ДокументЗаявление.КодРегионаФСРАР));
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
	КонецЕсли;
	
	Если ДокументЗаявление.ПодатьЗаявкуНаПодключениеРПН Тогда
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Получатель");
		ЗаписатьУзелXML(ЗаписьXML, "ТипПолучателя", "РПН");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
	КонецЕсли;
	
	Если ДокументЗаявление.ПодатьЗаявкуНаПодключениеФТС Тогда
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Получатель");
		ЗаписатьУзелXML(ЗаписьXML, "ТипПолучателя", "ФТС");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	Если ЭтоУпрощенноеЗаявление Тогда
		ЗаписатьУзелXML(ЗаписьXML,"Тариф", ДокументЗаявление.Тариф, Истина);
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.Закрыть();
	
	АдресТекстаОтправленногоЗаявления = ПоместитьВоВременноеХранилище(
		Новый ДвоичныеДанные(ИмяВременногоФайлаЗаявления), 
		Новый УникальныйИдентификатор);
		
	УдалитьФайлы(ВременныйКаталогНаСервере);
	
	Возврат АдресТекстаОтправленногоЗаявления;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗаявлениеСформироватьОписаниеПакета(ПараметрыФункции)
	
	ДокументОписания = Новый ЗаписьXML;
	ДокументОписания.ОткрытьФайл(ПараметрыФункции.ВременныйКаталог + ПараметрыФункции.ИмяФайлаОписаниеПакета, "windows-1251");
	ДокументОписания.ЗаписатьОбъявлениеXML();
	
	ДокументОписания.ЗаписатьНачалоЭлемента("пакет");
	
	Если ПараметрыФункции.ПодписатьСтороннимСертификатом Тогда
		ДокументОписания.ЗаписатьАтрибут("версияФормата", "1С:1.2");
	ИначеЕсли ПараметрыФункции.ЭтоБезбумажноеПродление Тогда
		ДокументОписания.ЗаписатьАтрибут("версияФормата", "1С:1.1");
	Иначе
		ДокументОписания.ЗаписатьАтрибут("версияФормата", "1С:1.0");
	КонецЕсли;
	
	ДокументОписания.ЗаписатьАтрибут("версПрог", РегламентированнаяОтчетность.ВерсияПрограммы());
	ДокументОписания.ЗаписатьАтрибут("типДокументооборота", "РегистрацияАбонента");
	ДокументОписания.ЗаписатьАтрибут("типТранзакции", "Регистрация");
	ДокументОписания.ЗаписатьАтрибут("идентификаторДокументооборота", ПараметрыФункции.ИдентификаторДокументооборота);
	
	ДокументОписания.ЗаписатьНачалоЭлемента("отправитель");
	ДокументОписания.ЗаписатьАтрибут("типСубъекта", "абонент");
	Если ПараметрыФункции.ЭтоБезбумажноеПродление Тогда
		ДокументОписания.ЗаписатьАтрибут("идентификаторСубъекта", ПараметрыФункции.ИдентификаторАбонента);
	КонецЕсли;
	ДокументОписания.ЗаписатьКонецЭлемента();
	
	ДокументОписания.ЗаписатьНачалоЭлемента("получатель");
	СпецОператорСвязи = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьПараметрСпецоператора(ПараметрыФункции.СпецОператорСвязиДокументооборота,"ВебСервисИдентификаторСубъекта");
	ДокументОписания.ЗаписатьАтрибут("идентификаторСубъекта", СпецОператорСвязи);
	ДокументОписания.ЗаписатьАтрибут("типСубъекта", "спецоператор");
	ДокументОписания.ЗаписатьКонецЭлемента();
	
	// документ-заявление
	ДокументОписания.ЗаписатьНачалоЭлемента("документ");
	ДокументОписания.ЗаписатьАтрибут("идентификаторДокумента", ОбщегоНазначенияЭДКОКлиентСервер.НовыйИдентификатор());
	ДокументОписания.ЗаписатьАтрибут("типДокумента", "Заявление");
	ДокументОписания.ЗаписатьАтрибут("типСодержимого", "xml");
	ДокументОписания.ЗаписатьАтрибут("сжат", "true");
	ДокументОписания.ЗаписатьАтрибут("зашифрован", "true");
	
	ДокументОписания.ЗаписатьНачалоЭлемента("содержимое");
	ДокументОписания.ЗаписатьАтрибут("имяФайла", ПараметрыФункции.ИмяФайлаЗаявлениеНаРегистрацию);
	ДокументОписания.ЗаписатьКонецЭлемента();
	
	Если ПараметрыФункции.ЭтоБезбумажноеПродление ИЛИ ПараметрыФункции.ПодписатьСтороннимСертификатом Тогда
		ДокументОписания.ЗаписатьНачалоЭлемента("подпись");
		ДокументОписания.ЗаписатьАтрибут("имяФайла", ПараметрыФункции.ИмяФайлаПодписьПодЗаявлением);
		ДокументОписания.ЗаписатьКонецЭлемента();	
	КонецЕсли;
	ДокументОписания.ЗаписатьКонецЭлемента();
	
	ЗаявлениеСформироватьОписаниеПакета_ДобавитьСканы(ДокументОписания, ПараметрыФункции);
	
	// пакет
	ДокументОписания.ЗаписатьКонецЭлемента();
	
	ДокументОписания.Закрыть();
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗаявлениеСформироватьОписаниеПакета_ДобавитьСканы(ДокументОписания, ПараметрыФункции)
	
	Если ПараметрыФункции.Свойство("СканыКЗаявлению") 
		И (ПараметрыФункции.ЭтоБезбумажноеПродление ИЛИ ПараметрыФункции.ЭтоУпрощенноеЗаявление) Тогда
		
		СканыКЗаявлению = ПараметрыФункции.СканыКЗаявлению;
		Для каждого Скан Из СканыКЗаявлению Цикл
			
			ДокументОписания.ЗаписатьНачалоЭлемента("документ");
			ДокументОписания.ЗаписатьАтрибут("идентификаторДокумента", ОбщегоНазначенияЭДКОКлиентСервер.НовыйИдентификатор());
			
			ДокументОписания.ЗаписатьАтрибут("типДокумента", Скан.ВидДокумента);
			
			Файл = Новый Файл(Скан.ИмяФайлаДанных);
			ДокументОписания.ЗаписатьАтрибут("типСодержимого", Нрег(Скан.Расширение));
			
			ДокументОписания.ЗаписатьАтрибут("сжат", "true");
			ДокументОписания.ЗаписатьАтрибут("зашифрован", "true");
			
			ДокументОписания.ЗаписатьНачалоЭлемента("содержимое");
			ДокументОписания.ЗаписатьАтрибут("имяФайла", Скан.ИмяФайлаДанных);
			ДокументОписания.ЗаписатьКонецЭлемента();
			
			Если ЗначениеЗаполнено(Скан.АдресПодписи) И ЭтоАдресВременногоХранилища(Скан.АдресПодписи) Тогда
				ДокументОписания.ЗаписатьНачалоЭлемента("подпись");
				ДокументОписания.ЗаписатьАтрибут("имяФайла", Скан.ИмяФайлаПодписи);
				ДокументОписания.ЗаписатьКонецЭлемента();
			КонецЕсли;
			
			ДокументОписания.ЗаписатьКонецЭлемента();
			
		КонецЦикла; 
		
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ОбменССерверомОтправитьЗаявление(
		Знач Файл, 
		СпецоператорСвязи, 
		Статус, 
		ДатаОтправки, 
		СтатусКомментарий,
		СостояниеОтправкиСообщения,
		ВызовИзМастераПодключенияК1СОтчетности, 
		ТекстОшибокДляМастераПодключенияК1СОтчетности, 
		ПовторятьСоединение = Ложь)
	
	Сервис = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОбменССерверомСоздатьСервис(
		СпецоператорСвязи, 
		ВызовИзМастераПодключенияК1СОтчетности, 
		ТекстОшибокДляМастераПодключенияК1СОтчетности, , 
		Ложь);
	
	Если Сервис = Неопределено Тогда
		СостояниеОтправкиСообщения = "Не удалось отправить сообщение";
		Возврат;
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(Файл) Тогда
		СтрокаBase64 = Base64Строка(ПолучитьИзВременногоХранилища(Файл));
	Иначе	
		СтрокаBase64 = Base64Строка(Новый ДвоичныеДанные(Файл));
	КонецЕсли;
	
	Попытка
		XDTOРезультат = Сервис.SendPacket(СтрокаBase64);
	Исключение
		
		СостояниеОтправкиСообщения = "Не удалось отправить сообщение";
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
			СостояниеОтправкиСообщения, 
			ВызовИзМастераПодключенияК1СОтчетности, 
			ТекстОшибокДляМастераПодключенияК1СОтчетности, 
			НЕ ВызовИзМастераПодключенияК1СОтчетности);
			
		Возврат;
	КонецПопытки;
	ПовторятьСоединение = Ложь;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(XDTOРезультат);
	ПостроительДОМ = Новый ПостроительDOM();
	ДОМ = ПостроительДОМ.Прочитать(ЧтениеXML);
	УзелDOM = ДОМ.ПолучитьЭлементыПоИмени("code");
	кодРезультата = УзелDOM[0].ТекстовоеСодержимое;
	ДатаОтправки = ТекущаяДатаСеанса();
	
	Если КодРезультата = "0" Тогда
		СостояниеОтправкиСообщения = "Заявление отправлено в обработку на сервер";
		Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено;
		СтатусКомментарий = "";
	ИначеЕсли КодРезультата = "1000" Тогда
		СостояниеОтправкиСообщения = "Заявление отправлено в автоматическую обработку";
		Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено;
		СтатусКомментарий = "";
	Иначе
		
		СообщениеОшибки = "";
		
		УзелDOM = ДОМ.ПолучитьЭлементыПоИмени("errorMessage");
		
		Если УзелDOM.Количество() > 0 Тогда
			СообщениеОшибки = УзелDOM[0].ТекстовоеСодержимое;
			СостояниеОтправкиСообщения = "При обработке заявления на сервере возникла ошибка:
			|"+ Символы.пс + сообщениеОшибки;
		КонецЕсли;
		
		СтатусКомментарий = сообщениеОшибки;
		Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено;
	КонецЕсли;
	ЧтениеXML.Закрыть();
	
КонецПроцедуры

&НаСервере
Функция ЗаявлениеСформироватьЗаявлениеНаИзменение(
		Знач ДокументЗаявление, 
		ТекстЗапросаНаСертификат,
		Знач ИдентификаторАбонента = "",
		АлгоритмКонтейнераКлючей = Неопределено)
	//необходимо 
	//1. сформировать XML файл
	//2. вставить в него запрос
	//3. заархивировать
	//4. отдать на сторону клиента
	
	СписокИзмененныхРеквизитов = ДокументЗаявление.ИзменившиесяРеквизитыВторичногоЗаявления;
	
	ВременныйКаталогНаСервере = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();

	ИмяВременногоФайлаЗаявления = ВременныйКаталогНаСервере + "file";
	ИмяВременногоФайлаАрхива = ВременныйКаталогНаСервере + "архив.zip";
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаЗаявления,"windows-1251");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Заявление");
	ЗаписьXML.ЗаписатьАтрибут("ВерсФорм","1.8");// новая версия
	ЗаписьXML.ЗаписатьАтрибут("ДатаВремяФормирования", XMLСтрока(ТекущаяДатаСеанса()));
	ЗаписьXML.ЗаписатьАтрибут("ВерсПрог", РегламентированнаяОтчетность.НазваниеИВерсияПрограммы());
	
	ЗаписатьУзелXML(ЗаписьXML,"ТипЗаявления", ПолучитьТипЗаявления(ДокументЗаявление.ТипЗаявления));
	ЗаписатьУзелXML(ЗаписьXML,"УчетнаяЗапись", ИдентификаторАбонента);
	
	// Продление лицензии
	Если ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.ПродлениеЛицензии) Тогда
		ЗаписатьУзелXML(ЗаписьXML, "ПродлениеЛицензии", XMLСтрока(Истина));
	КонецЕсли;
	
	Если ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.КПП) Тогда
 		ЗаписатьУзелXML(ЗаписьXML,"КПП", ДокументЗаявление.КПП);
	КонецЕсли;
	
	Если ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.ОГРН) Тогда
		ЗаписатьУзелXML(ЗаписьXML,"ОГРН", ДокументЗаявление.ОГРН);
	КонецЕсли;
	
	Если ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.НомерОсновнойПоставки1С) Тогда
		ЗаписатьУзелXML(ЗаписьXML,"НомерОсновнойПоставки1с", ДокументЗаявление.НомерОсновнойПоставки1с);
	КонецЕсли;
	
	Если ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.ПолноеНаименование) Тогда
		ЗаписатьУзелXML(ЗаписьXML,"ПолноеНаименование", ДокументЗаявление.ПолноеНаименование);
	КонецЕсли;
	
	Если ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.КраткоеНаименование) Тогда
		ЗаписатьУзелXML(ЗаписьXML,"КраткоеНаименование", ДокументЗаявление.КраткоеНаименование);
	КонецЕсли;
	
	Если ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.ТелефонОсновной) Тогда
		ЗаписатьУзелXML(ЗаписьXML,"ТелефонОсновной", ДокументЗаявление.ТелефонОсновной);
	КонецЕсли;
	
	Если ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.ТелефонДополнительный) Тогда
		ЗаписатьУзелXML(ЗаписьXML,"ТелефонДополнительный",ДокументЗаявление.ТелефонДополнительный);
	КонецЕсли;
	
	Если ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.ТелефонМобильный) Тогда
		ТелефонМобильныйБезРазделителей = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ТелефонМобильныйБезРазделителей(ДокументЗаявление.ТелефонМобильный);
		ЗаписатьУзелXML(ЗаписьXML,"ТелефонМобильный", ТелефонМобильныйБезРазделителей);
	КонецЕсли;
	
	Если ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.ЭлектроннаяПочта) Тогда
		ЗаписатьУзелXML(ЗаписьXML,"ЭлектроннаяПочта", ДокументЗаявление.ЭлектроннаяПочта);
	КонецЕсли;
	
	Если ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.РегНомерПФР) Тогда
		ЗаписатьУзелXML(ЗаписьXML,"РегНомерПФР", ДокументЗаявление.РегНомерПФР);
	КонецЕсли;
	
	// Узел ВладельцыЭЦП
	ТребуетсяПереизданиеСертификата = Ложь;
	Если ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.ПереизданиеСертификата) Тогда
		 ТребуетсяПереизданиеСертификата = Истина;
	 КонецЕсли;
	 
	ИзменилисьРеквизитыУзлаВладельцыЭЦП = Ложь;
	Если ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.ВладелецЭЦП)
		ИЛИ ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.ВладелецЭЦПДолжность)
		ИЛИ ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.ВладелецЭЦППодразделение) Тогда
		 ИзменилисьРеквизитыУзлаВладельцыЭЦП = Истина;
	КонецЕсли;
	
	// Если это переход в облако, заявление будет отправлено не этой функцией, а из базы заявок.
	// Если это переход в коробку, то данное изменение корректно
	ИзменилсяКриптопровайдер = ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.ИзменениеКриптопровайдера);
	
	Если ИзменилисьРеквизитыУзлаВладельцыЭЦП 
		ИЛИ ТребуетсяПереизданиеСертификата 
		ИЛИ ИзменилсяКриптопровайдер Тогда

		ДописатьВЗаявлениеСведенияОВладельцеЭП(
			ДокументЗаявление,
			ЗаписьXML,
			ТекстЗапросаНаСертификат,
			Ложь, 
			ТребуетсяПереизданиеСертификата,
			АлгоритмКонтейнераКлючей);

	КонецЕсли;
	
	// Узел Получатели
	КодРегионаФСРАРИзменился = ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.КодРегионаФСРАР);
	ИзменитьСоставКонтролирующихОрганов = ИзменилсяСоставКонтролирующихОрганов(СписокИзмененныхРеквизитов) ИЛИ КодРегионаФСРАРИзменился;
	
	Если ИзменитьСоставКонтролирующихОрганов Тогда
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Получатели");
		
		ТаблицаПолучателей = ДокументЗаявление.Получатели.Выгрузить();
		ТаблицаПолучателей.Сортировать("ТипПолучателя, КодПолучателя, КПП");
			
		Для Счетчик = 0 По ТаблицаПолучателей.Количество()-1 Цикл
			Получатель = ТаблицаПолучателей[Счетчик];
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("Получатель");
			ЗаписатьУзелXML(ЗаписьXML, "ТипПолучателя", XMLСтрока(Получатель.ТипПолучателя));
				ЗаписатьУзелXML(ЗаписьXML, "КодПолучателя", Получатель.КодПолучателя);
			
			Если Не ПустаяСтрока(Получатель.КПП) Тогда 
				ЗаписьXML.ЗаписатьНачалоЭлемента("ПереченьКПП");
				ЗаписатьУзелXML(ЗаписьXML, "КПП", Получатель.КПП);
				
				Для Счетчик1 =  Счетчик + 1 По ТаблицаПолучателей.Количество()-1 Цикл
					Получатель1= ТаблицаПолучателей[Счетчик1];
					
					Если Получатель1.ТипПолучателя = Получатель.ТипПолучателя И
						Получатель1.КодПолучателя = Получатель.КодПолучателя И
						Не ПустаяСтрока(Получатель1.КПП) Тогда
						
						ЗаписатьУзелXML(ЗаписьXML, "КПП", Получатель1.КПП);
						Счетчик = Счетчик1;
						
					Иначе
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла;
				
				ЗаписьXML.ЗаписатьКонецЭлемента();
			КонецЕсли;
			
			ЗаписьXML.ЗаписатьКонецЭлемента(); // конец элемента Получатель
			
		КонецЦикла;
		
		Если ДокументЗаявление.ПодатьЗаявкуНаСертификатДляФСРАР Тогда
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("Получатель");
			ЗаписатьУзелXML(ЗаписьXML, "ТипПолучателя", "ФСРАР");
			ЗаписатьУзелXML(ЗаписьXML, "КодПолучателя", XMLСтрока(ДокументЗаявление.КодРегионаФСРАР));
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
		КонецЕсли;
		
		Если ДокументЗаявление.ПодатьЗаявкуНаПодключениеРПН Тогда
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("Получатель");
			ЗаписатьУзелXML(ЗаписьXML, "ТипПолучателя", "РПН");
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
		КонецЕсли;
		
		Если ДокументЗаявление.ПодатьЗаявкуНаПодключениеФТС Тогда
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("Получатель");
			ЗаписатьУзелXML(ЗаписьXML, "ТипПолучателя", "ФТС");
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
		
	ЗаписьXML.Закрыть();
	
	АдресТекстаОтправленногоЗаявления = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайлаЗаявления), Новый УникальныйИдентификатор);
	
	Возврат АдресТекстаОтправленногоЗаявления;
	
КонецФункции

&НаКлиенте
Процедура СформироватьИОтправитьФайлыЗаявления(Результат, ДополнительныеПараметры) Экспорт
	
	ТекстОшибки 				= ДополнительныеПараметры.ТекстОшибокДляМастераПодключенияК1СОтчетности;
	СостояниеОтправкиСообщения 	= "";

	Если ТипЗнч(Результат) = Тип("Структура") И Результат.Выполнено = Истина Тогда
		
		ДокументЗаявление = ДополнительныеПараметры.ДокументЗаявление;
		
		Если ДополнительныеПараметры.ПродолжитьОтправкуЗаявления Тогда
			
			ПараметрыОтправки = ПараметрыЗаявлениеСформироватьИОтправитьПакет(ДополнительныеПараметры);
			ЗаявлениеСформироватьИОтправитьПакет(ПараметрыОтправки);
			
			КопируемыеСвойства = "Статус, ДатаОтправки, СтатусКомментарий";
			ЗаполнитьЗначенияСвойств(ДополнительныеПараметры, ПараметрыОтправки, КопируемыеСвойства);
			
			Если ПараметрыОтправки.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено") Тогда
				
				ПовторятьСоединение 		= ПараметрыОтправки.ПовторятьСоединение;
				СостояниеОтправкиСообщения 	= ПараметрыОтправки.СостояниеОтправкиСообщения;
				ТекстОшибки					= ПараметрыОтправки.ТекстОшибокДляМастераПодключенияК1СОтчетности;
				
				СообщитьОбОшибкеОтправкиЗаявления(
					СостояниеОтправкиСообщения, 
					ПовторятьСоединение,
					ТекстОшибки,
					ДополнительныеПараметры);
					
			КонецЕсли;
			
		КонецЕсли;
		
		ОбновитьДанныеЗаявленияПослеОтправки(ДополнительныеПараметры);
			
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,ДополнительныеПараметры.ВременныйКаталог);
		
		Если ДокументЗаявление.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено") Тогда
			ОбработкаЗаявленийАбонентаКлиент.ВключитьАвтоматическуюПроверкуСтатуса(ДокументЗаявление.Ссылка);
		ИначеЕсли ДокументЗаявление.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено") Тогда
			ОбработкаЗаявленийАбонентаВызовСервера.ОбновитьРеквизитыЗаявления(
				ДокументЗаявление.Ссылка, 
				Новый Структура("НастройкаЗавершена", Истина));
		КонецЕсли;
		
	КонецЕсли;
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если ВыполняемоеОповещение <> Неопределено Тогда
		
		СтруктураРезультата = Новый Структура();
		СтруктураРезультата.Вставить("ТекстОшибки", 		ТекстОшибки);
		СтруктураРезультата.Вставить("СостояниеОтправки", 	СостояниеОтправкиСообщения);
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, СтруктураРезультата);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыЗаявлениеСформироватьИОтправитьПакет(ДополнительныеПараметры)
	
	ПараметрыОтправки 	= ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительныеПараметры);
	ПараметрыОтправки.Вставить("ВызовИзМастераПодключения", ДополнительныеПараметры.ВызовИзМастераПодключенияК1СОтчетности);
	
	// Удаляем те свойства, которые нельзя передавать на сервер
	ПараметрыОтправки.Удалить("ВыполняемоеОповещение");
	ПараметрыОтправки.Удалить("СтороннийСертификатДляПлатформы");
	ПараметрыОтправки.Удалить("МенеджерКриптографии");
	ПараметрыОтправки.Удалить("ФормаВладелец");
	
	ПараметрыОтправки.Вставить("СостояниеОтправкиСообщения", 	"");
	ПараметрыОтправки.Вставить("ПовторятьСоединение", 			Истина);

	Возврат ПараметрыОтправки;
	
КонецФункции

&НаКлиенте
Процедура ЗаявлениеЗашифроватьПослеПолученияСвойствСертификатаОператораСвязи(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Выполнено Тогда
		
		ДополнительныеПараметры.Вставить("СвойстваСертификатаОператораСвязи", Результат.СвойстваСертификата);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаявлениеЗашифроватьПослеШифрованияФайлаЗаявления", ЭтотОбъект, ДополнительныеПараметры);
		
		КриптографияЭДКОКлиент.ЗашифроватьPKCS7(
			ОписаниеОповещения, 
			ДополнительныеПараметры.АдресАрхивированногоЗаявленияНаРегистрацию, 
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Результат.СвойстваСертификата),,
			ДополнительныеПараметры.ВыводитьСообщения);

	Иначе
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправить_ПодписатьЗаявление(ПараметрыФункции)
	
	ДокументЗаявление = ПараметрыФункции.ДокументЗаявление;
	
	Если ПараметрыФункции.ЭтоБезбумажноеПродление И ПараметрыФункции.БезбумажноеПродлениеВозможно Тогда
		
		// Вторичное заявление - локальное и облачное
		Если Не ПараметрыФункции.Свойство("Сертификат") Тогда
			
			Сертификат = ПолучитьСертификатИзЗаявленияНаСервере(ДокументЗаявление.Ссылка);
			
			ПараметрыФункции.Вставить("Сертификат", Сертификат);
			
		КонецЕсли;
		
		// Нельзя объединять оповещения, так как параметры оповещения различные
		Оповещение = Новый ОписаниеОповещения(
			"СформироватьИОтправить_ПослеПодписанияЗаявления", 
			ЭтотОбъект, 
			ПараметрыФункции);
			
		АдресЗаявления  = ПараметрыФункции.АдресТекстаОтправленногоЗаявления;
		АдресРезультата = ПоместитьВоВременноеХранилище(, Новый УникальныйИдентификатор);
		
		КриптографияЭДКОКлиент.ПодписатьPKCS7(Оповещение, ПараметрыФункции.Сертификат, АдресЗаявления, Ложь, АдресРезультата,,, Истина);
		
	ИначеЕсли ПараметрыФункции.ПодписатьСтороннимСертификатом Тогда
		
		Если ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ФормаОткрыта("Мастер_ОтправкаЗаявления") Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"СформироватьИОтправить_ПодписатьЗаявлениеСтороннимСертификатом", 
				ЭтотОбъект, 
				ПараметрыФункции);

			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("СертификатДляПодписания", ПараметрыФункции.СтороннийСертификат);
			
			ОткрытьФорму(ПутьКОбъекту + ".Форма.Мастер_ВводПароляЗакрытогоКлюча", 
				ДополнительныеПараметры,
				ПараметрыФункции.ФормаВладелец,
				,
				,
				,
				ОписаниеОповещения,
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				
		КонецЕсли;		
		
	Иначе
		
		// Подписания не будет, но сканы все равно надо приложить
		
		Если ПараметрыФункции.ЭтоУпрощенноеЗаявление Тогда
			СканыКЗаявлению = СформироватьИОтправить_ПолучитьПрисоединенныеФайлы(ПараметрыФункции);
			ПараметрыФункции.Вставить("СканыКЗаявлению", СканыКЗаявлению);
		КонецЕсли;
		
		Если ДокументЗаявление.ЭлектроннаяПодписьВМоделиСервиса Тогда
			СформироватьИОтправитьЗаявлениеВМоделиСервисов(ДокументЗаявление, ПараметрыФункции.ВыполняемоеОповещение);
		Иначе
			ЗаявлениеЗашифровать(ПараметрыФункции);
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправить_ПодписатьЗаявлениеСтороннимСертификатом(Пароль, ПараметрыФункции) Экспорт
	
	Если Пароль = Неопределено Тогда
		ТекстОшибки = "Отказ от ввода пароля";
		СформироватьИОтправитьЗаявление_СообщитьОНевозможностиЭлектронногоПодписания(ПараметрыФункции, ТекстОшибки);
		Возврат;
	Иначе
		ПараметрыФункции.МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = Пароль;
	КонецЕсли;
	
	// Первичное с электронным подписанием 
	Сертификат = Новый Структура("Отпечаток", ПараметрыФункции.СтороннийСертификат.Отпечаток);
	ПараметрыФункции.Вставить("Сертификат",   Сертификат);
	
	АдресЗаявления = ПараметрыФункции.АдресТекстаОтправленногоЗаявления;
	
	// Нельзя объединять оповещения, так как параметры оповещения различные
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьИОтправить_ПроверкаПодписи", 
		ЭтотОбъект, 
		ПараметрыФункции,
		"СформироватьИОтправить_ОбработчикОшибкиПодписания",
		ЭтотОбъект);
			
	АдресЗаявления  = ПараметрыФункции.АдресТекстаОтправленногоЗаявления;
	АдресРезультата = ПоместитьВоВременноеХранилище(, Новый УникальныйИдентификатор);
	
	ДвДанные 						= ПолучитьИзВременногоХранилища(АдресЗаявления);
	МенеджерКриптографии 			= ПараметрыФункции.МенеджерКриптографии;
	СтороннийСертификатДляПлатформы = ПараметрыФункции.СтороннийСертификатДляПлатформы;
	
	// Методом платформы, так как компонента не подписывает сертификатами сторонних УЦ
	МенеджерКриптографии.НачатьПодписывание(
		Оповещение, 
		ДвДанные, 
		СтороннийСертификатДляПлатформы);
		
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправить_ОбработчикОшибкиПодписания(ИнформацияОбОшибке, СтандартнаяОбработка, ВходящийКонтекст) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ТекстОшибки = КраткоеПредставлениеОшибки(ОбщегоНазначенияЭДКОКлиентСервер.ПолучитьИнформациюОбОшибке(ИнформацияОбОшибке));
	
	СформироватьИОтправитьЗаявление_СообщитьОНевозможностиЭлектронногоПодписания(ВходящийКонтекст, ТекстОшибки);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПодписьКФайлуЗаявления(АдресПодписи, ИмяФайлаИлиПрисоединенныйФайл, ДокументЗаявление)
	
	Если ТипЗнч(ИмяФайлаИлиПрисоединенныйФайл) = Тип("Строка") Тогда
		
		Для Каждого СтрокаТаблицы Из ДокументЗаявление.ЭлектронныеДокументы Цикл
			Если СтрокаТаблицы.Документ = ИмяФайлаИлиПрисоединенныйФайл Тогда
				ПрисоединенныйФайл = СтрокаТаблицы.Файл;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ПрисоединенныйФайл = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
	Иначе
		
		ПрисоединенныйФайл = ИмяФайлаИлиПрисоединенныйФайл;
		
	КонецЕсли;
	
	Если ДокументЗаявление.ТипЗаявления = Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Первичное Тогда
		ДанныеСертификата = ДокументЗаявление.РеквизитыСертификата.Получить();
	Иначе
		ДанныеСертификата = ДокументЗаявление.Сертификат.Получить();
	КонецЕсли;
	
	СвойстваПодписи = Новый Структура;
	СвойстваПодписи.Вставить("Подпись", 	 ПолучитьИзВременногоХранилища(АдресПодписи));
	СвойстваПодписи.Вставить("Сертификат", 	 ДанныеСертификата.Сертификат);
	СвойстваПодписи.Вставить("ПодписьВерна", Истина);
	СвойстваПодписи.Вставить("ДатаПроверкиПодписи", ТекущаяДата());
	СвойстваПодписи.Вставить("КомуВыданСертификат", "");
	
	РаботаСФайлами.ДобавитьПодписьКФайлу(ПрисоединенныйФайл, СвойстваПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправить_ПроверкаПодписи(ПодписанноеСообщение, ВходящийКонтекст) Экспорт
	
	ВходящийКонтекст.Вставить("ПодписанноеСообщение", ПодписанноеСообщение);
	
	ИсходныеДанные = ВходящийКонтекст.АдресТекстаОтправленногоЗаявления;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"СформироватьИОтправить_ПослеПроверкиПодписи", 
		ЭтотОбъект, 
		ВходящийКонтекст,
		"СформироватьИОтправить_ОбработчикОшибкиПодписания",
		ЭтотОбъект);
	
	ВходящийКонтекст.МенеджерКриптографии.НачатьПроверкуПодписи(
		ОписаниеОповещения,
		ПолучитьИзВременногоХранилища(ИсходныеДанные), 
		ПодписанноеСообщение);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправить_ПослеПроверкиПодписи(Результат, ВходящийКонтекст) Экспорт
	
	ПодписанноеСообщение = ВходящийКонтекст.ПодписанноеСообщение;
	ВходящийКонтекст.Удалить("ПодписанноеСообщение");
	
	СформироватьИОтправить_ПослеПодписанияЗаявления(ПодписанноеСообщение, ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправить_ПослеПодписанияЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	// Из-за того, что подписание выполняется методом компоненты или платформы, то результат возвращается разный
	Выполнено = ВходящийКонтекст.ЭтоБезбумажноеПродление И Результат.Выполнено ИЛИ ВходящийКонтекст.ПодписатьСтороннимСертификатом;
	
	Если Выполнено Тогда
		
		ДокументЗаявление = ВходящийКонтекст.ДокументЗаявление;
		
		// Из-за того, что подписание выполняется методом компоненты или платформы, то результат возвращается разный
		Если ВходящийКонтекст.ЭтоБезбумажноеПродление Тогда
			АдресПодписиПодЗаявлением = Результат.ФайлПодписи;
		Иначе
			АдресПодписиПодЗаявлением = ПоместитьВоВременноеХранилище(Результат, Новый УникальныйИдентификатор);
		КонецЕсли;
		
		ВходящийКонтекст.Вставить("АдресПодписиПодЗаявлением", АдресПодписиПодЗаявлением);
		
		ДобавитьПодписьКФайлуЗаявления(
			АдресПодписиПодЗаявлением, 
			ВходящийКонтекст.ПрисоединенныйФайлЗаявления, 
			ДокументЗаявление.Ссылка);
		
		СканыКЗаявлению = СформироватьИОтправить_ПолучитьПрисоединенныеФайлы(ВходящийКонтекст);
		ВходящийКонтекст.Вставить("СканыКЗаявлению", 		СканыКЗаявлению);
		ВходящийКонтекст.Вставить("ИндексТекущегоСкана",	0);
		
		СформироватьИОтправить_ПодписатьСканыКЗаявлениюВЦикле(ВходящийКонтекст);
		
	Иначе
		
		СообщитьОбОшибкеПриПодписанииЗаявления(ВходящийКонтекст, Результат.ОписаниеОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбОшибкеПриПодписанииЗаявления(ВходящийКонтекст, ОписаниеОшибки)
	
	// Вывод ошибки
	Если ВходящийКонтекст.ЭтоБезбумажноеПродление Тогда
		// Заявление на изменение
		Оповещение = Новый ОписаниеОповещения("СформироватьИОтправитьЗаявлениеПослеОтветаНаВопрос", ЭтотОбъект, ВходящийКонтекст);
		СформироватьИОтправитьЗаявлениеПоказатьСообщениеОНевозможностиБезбумажногоПродления(Оповещение, ОписаниеОшибки);
	Иначе
		// Первичное заявление
		СформироватьИОтправитьЗаявление_СообщитьОНевозможностиЭлектронногоПодписания(ВходящийКонтекст, ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьЗаявление_СообщитьОНевозможностиЭлектронногоПодписания(ВходящийКонтекст, ТекстОшибки = "") Экспорт
	
	ТекстОшибки = НСтр("ru = 'Не удалось выполнить подписание сертификатом';
						|en = 'Cannot sign with the certificate'") 
					+ Символы.ПС + ВходящийКонтекст.СтороннийСертификат.ПредставлениеСертификата
					+ НСтр("ru = ' по причине:';
							|en = ' for the reason:'")
					+ Символы.Таб + ТекстОшибки;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТекстОшибки", ТекстОшибки);
	 
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправить_ПодписатьСканыКЗаявлениюВЦикле(ВходящийКонтекст) Экспорт
	
	ИндексТекущегоСкана = ВходящийКонтекст.ИндексТекущегоСкана;
	СканыКЗаявлению 	= ВходящийКонтекст.СканыКЗаявлению;
	ДокументЗаявление	= ВходящийКонтекст.ДокументЗаявление;
	
	Если ИндексТекущегоСкана = СканыКЗаявлению.Количество() Тогда
		
		Если ДокументЗаявление.ЭлектроннаяПодписьВМоделиСервиса Тогда
			СформироватьИОтправитьЗаявлениеВМоделиСервисов(ДокументЗаявление, ВходящийКонтекст.ВыполняемоеОповещение);
		Иначе
			ЗаявлениеЗашифровать(ВходящийКонтекст);
		КонецЕсли;
	
	Иначе
		
		ТекущийСкан = СканыКЗаявлению[ИндексТекущегоСкана];
		
		Если ВходящийКонтекст.ЭтоБезбумажноеПродление Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"СформироватьИОтправить_ПослеПодписанияСледующегоСкана", 
				ЭтотОбъект, 
				ВходящийКонтекст); 
				
			АдресРезультата = ПоместитьВоВременноеХранилище(, Новый УникальныйИдентификатор);
				
			КриптографияЭДКОКлиент.ПодписатьPKCS7(
				ОписаниеОповещения, 
				ВходящийКонтекст.Сертификат, 
				ТекущийСкан.АдресДанных, 
				Ложь, 
				АдресРезультата,
				Ложь,
				,
				ВходящийКонтекст.ПодписатьСтороннимСертификатом);
				
		Иначе

			ОписаниеОповещения = Новый ОписаниеОповещения(
				"СформироватьИОтправить_ПослеПодписанияСледующегоСкана", 
				ЭтотОбъект, 
				ВходящийКонтекст,
				"СформироватьИОтправить_ОбработчикОшибкиПодписания",
				ЭтотОбъект);
				
			АдресЗаявления  = ВходящийКонтекст.АдресТекстаОтправленногоЗаявления;
			АдресРезультата = ПоместитьВоВременноеХранилище(, Новый УникальныйИдентификатор);
			
			ДвДанные 						= ПолучитьИзВременногоХранилища(ТекущийСкан.АдресДанных);
			МенеджерКриптографии 			= ВходящийКонтекст.МенеджерКриптографии;
			СтороннийСертификатДляПлатформы = ВходящийКонтекст.СтороннийСертификатДляПлатформы;
			
			МенеджерКриптографии.НачатьПодписывание(
				ОписаниеОповещения, 
				ДвДанные, 
				СтороннийСертификатДляПлатформы);
			
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправить_ПослеПодписанияСледующегоСкана(Результат, ВходящийКонтекст) Экспорт

	// Из-за того, что подписание выполняется методом компоненты или платформы, то результат возвращается разный
	Выполнено = ВходящийКонтекст.ЭтоБезбумажноеПродление И Результат.Выполнено ИЛИ ВходящийКонтекст.ПодписатьСтороннимСертификатом;
	
	Если Выполнено Тогда
		
		ИндексТекущегоСкана = ВходящийКонтекст.ИндексТекущегоСкана;
		СканыКЗаявлению 	= ВходящийКонтекст.СканыКЗаявлению;

		ТекущийСкан = СканыКЗаявлению[ИндексТекущегоСкана];
		
		Если ВходящийКонтекст.ЭтоБезбумажноеПродление Тогда
			ТекущийСкан.АдресПодписи = Результат.ФайлПодписи;
		Иначе
			ТекущийСкан.АдресПодписи = ПоместитьВоВременноеХранилище(Результат, Новый УникальныйИдентификатор);
		КонецЕсли;
		ДобавитьПодписьКФайлуЗаявления(ТекущийСкан.АдресПодписи, ТекущийСкан.ПрисоединенныйФайл, ВходящийКонтекст.ДокументЗаявление.Ссылка);
		
		ВходящийКонтекст.ИндексТекущегоСкана = ВходящийКонтекст.ИндексТекущегоСкана + 1;
		
		СформироватьИОтправить_ПодписатьСканыКЗаявлениюВЦикле(ВходящийКонтекст);
		
	Иначе
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, Результат);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьЗаявлениеПослеОтветаНаВопрос(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Истина Тогда
		
		ДокументЗаявление = ВходящийКонтекст.ДокументЗаявление;
		
		ИзменитьПризнакБезбумажногоПродления(ДокументЗаявление.Ссылка);
		
		Если ДокументЗаявление.ЭлектроннаяПодписьВМоделиСервиса Тогда
			СформироватьИОтправитьЗаявлениеВМоделиСервисов(ДокументЗаявление, ВходящийКонтекст.ВыполняемоеОповещение);
		Иначе
			ВходящийКонтекст.Вставить("ЭтоБезбумажноеПродление", Ложь);
			ЗаявлениеЗашифровать(ВходящийКонтекст);
		КонецЕсли;
		
	Иначе
		
		Если ВходящийКонтекст.Свойство("ВыполняемоеОповещение") Тогда
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("Выполнено",   Ложь);
			ДополнительныеПараметры.Вставить("ТекстОшибки", НСтр("ru = 'Пользователь отказался от продления без использования электронной подписи';
																|en = 'User rejected extension without using digital signature'"));
			 
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, ДополнительныеПараметры);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИзменитьПризнакБезбумажногоПродления(ДокументЗаявление)
	
	ДокументОбъект = ДокументЗаявление.ПолучитьОбъект();
	ДокументОбъект.ПодписатьЭП = Ложь;
	ДокументОбъект.Записать();
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьИОтправить_ПолучитьПрисоединенныеФайлы(ВходящийКонтекст)
	
	ДокументЗаявление 	= ВходящийКонтекст.ДокументЗаявление;
	Сканы 				= Новый Массив;
	ВидыДокументов 		= ВидыДокументовПоВходящемуКонтексту(ВходящийКонтекст);
	
	Для Каждого СтрокаТаблицы Из ДокументЗаявление.ЭлектронныеДокументы Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.Документ)
			И ВидыДокументов.Свойство(СтрокаТаблицы.Документ) Тогда
			
			СвойстваДокумента = ВидыДокументов[СтрокаТаблицы.Документ];
			Если СвойстваДокумента.ТолькоДляНулевки Тогда
				// Этот документ отправлять в Калугу не нужно, 
				// он нужен только для Нулевки для отправки партнеру через менеджер сервисов
				Продолжить;
			КонецЕсли;
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		ДанныеФайла = РаботаСФайламиКлиент.ДанныеФайла(СтрокаТаблицы.Файл, УникальныйИдентификатор, Истина);
			
		НовыйСкан = Новый Структура;
		НовыйСкан.Вставить("ВидДокумента", 		 СтрокаТаблицы.Документ);
		НовыйСкан.Вставить("Наименование", 		 ДанныеФайла.Наименование);
		НовыйСкан.Вставить("АдресДанных", 		 ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		НовыйСкан.Вставить("ИмяФайлаДанных", 	 СгенерироватьИмяФайлаДокументаВСоставеПакета());
		НовыйСкан.Вставить("Расширение", 		 ДанныеФайла.Расширение);
		НовыйСкан.Вставить("ПрисоединенныйФайл", СтрокаТаблицы.Файл);
		
		НовыйСкан.Вставить("АдресПодписи", 		 "");
		
		Если ДокументЗаявление.ПодписатьЭП Тогда
			НовыйСкан.Вставить("ИмяФайлаПодписи", СгенерироватьИмяФайлаДокументаВСоставеПакета());
		Иначе
			НовыйСкан.Вставить("ИмяФайлаПодписи", "");
		КонецЕсли;
		
		Сканы.Добавить(НовыйСкан);
		
	КонецЦикла;
	
	Возврат Сканы;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСертификатИзЗаявленияНаСервере(ДокументЗаявление)
	
