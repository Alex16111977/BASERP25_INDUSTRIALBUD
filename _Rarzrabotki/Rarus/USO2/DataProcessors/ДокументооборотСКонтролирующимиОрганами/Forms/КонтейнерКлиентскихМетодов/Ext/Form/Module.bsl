			ЭтотОбъект, ВходящийКонтекст);
		
		РезультатВыполнения = Новый Структура("Выполнено, ОписаниеОшибки", Ложь, "");
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

