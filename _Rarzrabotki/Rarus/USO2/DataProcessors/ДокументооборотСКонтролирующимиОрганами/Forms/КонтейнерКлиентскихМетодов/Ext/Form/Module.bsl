&НаСервереБезКонтекста
Функция СформироватьПакетФСГС_ЗаключительныеДействияНаСервере(Контекст)
	
	// получаем дерево документов
	ДеревоДокументов = ПолучитьИзВременногоХранилища(Контекст.ДеревоДокументов);
	
	// создаем каталог, в который будем помещать пакуемые файлы
	КаталогФайловОтчетности = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	
	// создаем файл пакета
	КодИлиРегионПолучателя = РазделитьКодФСГС(Контекст.КодПолучателя).идентификаторСубъекта;
	КороткоеИмяФайлаПакета = Контекст.ПрефиксИмениФайлаКонтейнера + ?(ПустаяСтрока(Контекст.ПрефиксИмениФайлаКонтейнера), "", ".") + "STAT_" +
							ВРег(Контекст.КодОтправителя) + "_" +
							ВРег(КодИлиРегионПолучателя) + "_" +
							СгенерироватьUUID() + "_" + 
							Контекст.КодТипаДокументооборота + "_" +
							Контекст.КодТипаТранзакции + 
							".zip";

	ПолноеИмяФайлаПакета = ПолучитьКаталогВременныхФайлов() + КороткоеИмяФайлаПакета;
	
	// создаем архив
	ЗаписьZIP = Новый ЗаписьZipФайла(ПолноеИмяФайлаПакета); // для ФСГС сжатие включено

	// Создадим контекст ЭДО один раз до начала цикла обхода, чтобы не тратить время на каждом шаге.
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	
	// добавляем файла из дерева описания пакета
	Для Каждого СтрДокумент Из ДеревоДокументов.Строки Цикл
		ЗаписьZIP.Добавить(КонтекстЭДОСервер.ВыгрузитьФайлПакетаИзВременногоХранилищаВКаталог(КаталогФайловОтчетности, СтрДокумент));
		Для Каждого СтрДокумент2 Из СтрДокумент.Строки Цикл
			ЗаписьZIP.Добавить(КонтекстЭДОСервер.ВыгрузитьФайлПакетаИзВременногоХранилищаВКаталог(КаталогФайловОтчетности, СтрДокумент2));
		КонецЦикла;
	КонецЦикла;
	
	// добавляем само описание пакета
	ПолноеИмяФайлаОписанияПакета = КаталогФайловОтчетности + "packageDescription.xml";
	ПолучитьИзВременногоХранилища(Контекст.ФайлОписаниеПакета).Записать(ПолноеИмяФайлаОписанияПакета);
	ЗаписьZIP.Добавить(ПолноеИмяФайлаОписанияПакета);
	
	// записываем архив
	ЗаписьZIP.Записать();
	
	// добавляем архив в регистр
	ДобавитьТранспортныйКонтейнер(Контекст.ТранспортноеСообщение, ПолноеИмяФайлаПакета, КороткоеИмяФайлаПакета);
	
	// удаляем временный каталог
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловОтчетности);
	
	Возврат Истина;
	
КонецФункции

