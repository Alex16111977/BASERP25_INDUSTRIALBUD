&НаСервере
Функция МакетВторичногоЗаявления(Знач Документ, ЗаявлениеПолучатель) Экспорт
	
	СтруктураПоиска = Новый Структура("ИзмененныйРеквизит", ПредопределенноеЗначение("Перечисление.ПараметрыПодключенияК1СОтчетности.ПродлениеЛицензии"));
	ПродлитьЛицензиюНа1СОтчетность = Документ.ИзменившиесяРеквизитыВторичногоЗаявления.НайтиСтроки(СтруктураПоиска).Количество() > 0;

	СдаватьВФНСИзменился 		= ЭтотПараметрИзменился(Документ.ИзменившиесяРеквизитыВторичногоЗаявления, Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВФНС);
	КодыФНСИзменились 			= ЭтотПараметрИзменился(Документ.ИзменившиесяРеквизитыВторичногоЗаявления, Перечисления.ПараметрыПодключенияК1СОтчетности.КодыФНС);
	СдаватьВПФРИзменился 		= ЭтотПараметрИзменился(Документ.ИзменившиесяРеквизитыВторичногоЗаявления, Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВПФР);
	КодПФРИзменился 			= ЭтотПараметрИзменился(Документ.ИзменившиесяРеквизитыВторичногоЗаявления, Перечисления.ПараметрыПодключенияК1СОтчетности.КодПФР); 
	СдаватьВФССИзменился 		= ЭтотПараметрИзменился(Документ.ИзменившиесяРеквизитыВторичногоЗаявления, Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВФСС);
	СдаватьВРосстатИзменился 	= ЭтотПараметрИзменился(Документ.ИзменившиесяРеквизитыВторичногоЗаявления, Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВРосстат);
	КодРосстатаИзменился 		= ЭтотПараметрИзменился(Документ.ИзменившиесяРеквизитыВторичногоЗаявления, Перечисления.ПараметрыПодключенияК1СОтчетности.КодРосстата); 
	СдаватьВФСРАРИзменился 		= ЭтотПараметрИзменился(Документ.ИзменившиесяРеквизитыВторичногоЗаявления, Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВФСРАР);
	СдаватьВРПНИзменился 		= ЭтотПараметрИзменился(Документ.ИзменившиесяРеквизитыВторичногоЗаявления, Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВРПН);
	СдаватьВФТСИзменился 		= ЭтотПараметрИзменился(Документ.ИзменившиесяРеквизитыВторичногоЗаявления, Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВФТС);
	
	ИзменитьСоставКонтролирующихОрганов = СдаватьВФНСИзменился ИЛИ КодыФНСИзменились ИЛИ СдаватьВПФРИзменился ИЛИ КодПФРИзменился
		ИЛИ СдаватьВФССИзменился ИЛИ СдаватьВРосстатИзменился ИЛИ КодРосстатаИзменился ИЛИ СдаватьВФСРАРИзменился ИЛИ СдаватьВРПНИзменился ИЛИ СдаватьВФТСИзменился;
		
	СтруктураПоиска = Новый Структура("ИзмененныйРеквизит", Перечисления.ПараметрыПодключенияК1СОтчетности.ПереизданиеСертификата);
	ПереиздатьСертификат = Документ.ИзменившиесяРеквизитыВторичногоЗаявления.НайтиСтроки(СтруктураПоиска).Количество() > 0;
		
	ПараметрыПечати = Новый Структура();
	ПараметрыПечати.Вставить("ЗаявлениеПолучатель", 				ЗаявлениеПолучатель);
	ПараметрыПечати.Вставить("ПереиздатьСертификат", 				ПереиздатьСертификат);
	ПараметрыПечати.Вставить("ИзменитьСоставКонтролирующихОрганов", ИзменитьСоставКонтролирующихОрганов);
	ПараметрыПечати.Вставить("ПродлитьЛицензиюНа1СОтчетность", 		ПродлитьЛицензиюНа1СОтчетность);

	Возврат ПодготовитьМакет(Документ, ПараметрыПечати, "ПАРАМЕТРЫ_ПЕЧАТИ_ПечатьЗаявкиНаИзменениеРеквизитов", 
		"ПечатьЗаявкаНаИзменениеРеквизитов");
	
КонецФункции	
		
&НаСервереБезКонтекста
Функция ОрганизацияФизЛицаИзДокументаЗаявления(ФизЛицо) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЗаявлениеАбонентаСпецоператораСвязи.Организация,
		|	МАКСИМУМ(ЗаявлениеАбонентаСпецоператораСвязи.Дата) КАК Дата
		|ИЗ
		|	Документ.ЗаявлениеАбонентаСпецоператораСвязи КАК ЗаявлениеАбонентаСпецоператораСвязи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УчетныеЗаписиДокументооборота КАК УчетныеЗаписиДокументооборота
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПользователиУчетныхЗаписейДокументооборота КАК ПользователиУчетныхЗаписейДокументооборота
		|			ПО УчетныеЗаписиДокументооборота.Ссылка = ПользователиУчетныхЗаписейДокументооборота.УчетнаяЗапись
		|		ПО ЗаявлениеАбонентаСпецоператораСвязи.УчетнаяЗапись = УчетныеЗаписиДокументооборота.Ссылка
		|ГДЕ
		|	НЕ УчетныеЗаписиДокументооборота.ПометкаУдаления
		|	И ПользователиУчетныхЗаписейДокументооборота.Пользователь = &Пользователь
		|	И ЗаявлениеАбонентаСпецоператораСвязи.Статус = &Статус
		|	И ЗаявлениеАбонентаСпецоператораСвязи.ВладелецЭЦП = &ВладелецЭЦП
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаявлениеАбонентаСпецоператораСвязи.Организация";

	Запрос.УстановитьПараметр("Пользователь", 	Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("Статус", 		Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено);
	Запрос.УстановитьПараметр("ВладелецЭЦП", 	ФизЛицо);

	Результат = Запрос.Выполнить().Выгрузить();
	МассивОрганизаций = Результат.ВыгрузитьКолонку("Организация"); 
	
	Возврат МассивОрганизаций;
	
КонецФункции

&НаСервереБезКонтекста
