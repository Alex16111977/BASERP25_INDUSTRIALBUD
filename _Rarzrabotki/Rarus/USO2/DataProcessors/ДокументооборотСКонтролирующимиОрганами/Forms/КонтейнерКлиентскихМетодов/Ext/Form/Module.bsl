&НаКлиенте
Процедура НапечататьДокумент(ПечДокумент, Заголовок = "", Редактирование = Ложь) Экспорт
	
	Если ПечДокумент = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	Если ПечДокумент.МасштабПечати = 100 Тогда
		ПечДокумент.АвтоМасштаб = Истина;
	КонецЕсли;
	ПечДокумент.ОтображатьЗаголовки = Ложь;
	ПечДокумент.ОтображатьСетку = Ложь;
	ПечДокумент.Защита = Ложь;
	ПечДокумент.ТолькоПросмотр = Истина;
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("Заголовок", Заголовок);
	СтруктураПараметров.Вставить("ТабДок",    ПечДокумент);
	
	Если Редактирование Тогда
		СтруктураПараметров.Вставить("Редактирование", Истина);
	КонецЕсли;

	ОткрытьФорму(ПутьКОбъекту + ".Форма.ФормаПростойПечати", СтруктураПараметров,, Новый УникальныйИдентификатор());
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьМакет(Знач Объект,Параметры,ИмяПараметраПечати,ИмяМакета,Пакет = 0) Экспорт
	
	Если Пакет <> 0 Тогда
		ТабДокументМассив = Новый Массив();
		КолВо = Пакет.Количество();
	Иначе
		КолВо = 1;
	КонецЕсли;
	
	Для ин = 1 По КолВо Цикл
		
		Если Пакет <> 0 Тогда
			Индекс = ин-1;
			Параметры = Пакет[Индекс].Параметры;
			ИмяПараметраПечати =  Пакет[ин-1].ИмяПараметраПечати;
			ИмяМакета = Пакет[Индекс].ИмяМакета;
		КонецЕсли;
		
		ТабДокумент = Новый ТабличныйДокумент;
		
		ТабДокумент.КлючПараметровПечати = ИмяПараметраПечати;
		
		Макет = ПолучитьМакетОбработки(ИмяМакета);
		
		Если СтрНайти(ИмяМакета,"ЗаявкаНаИзменениеРеквизитов") <> 0 Тогда
			ПолучитьОбластьМакетаЗаявкаНаИзменениеРеквизитов(Объект, ТабДокумент, Макет,Параметры);	
		ИначеЕсли СтрНайти(ИмяМакета,"Заявка") <> 0 Тогда
			ПолучитьОбластьМакетаЗаявка(Объект, ТабДокумент, Макет,Параметры);	
		ИначеЕсли СтрНайти(ИмяМакета,"Соглашение") <> 0 Тогда
			ПолучитьОбластьМакетаСоглашение(Объект,ТабДокумент,Макет,Параметры);
		ИначеЕсли СтрНайти(ИмяМакета,"Лицензия") <> 0 Тогда
			ПолучитьОбластьМакетаЛицензия(Объект, ТабДокумент,Макет,Параметры);
		ИначеЕсли СтрНайти(ИмяМакета,"Сертификат") <> 0 Тогда
			ПолучитьОбластьМакетаСертификат(Объект, ТабДокумент,Макет, Параметры.Сертификат, Параметры.ТекстСертификата, Параметры.Заголовок);
		КонецЕсли;
		
		Если Пакет <> 0 Тогда
			ТабДокументМассив.Добавить(Новый Структура("ТабДокумент,Заголовок",ТабДокумент,Пакет[Индекс].Заголовок));
		КонецЕсли;
		
	КонецЦикла;
	
	Если Пакет <> 0 Тогда
		ТабДокумент = ТабДокументМассив;
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеБанкаВЗаявлении(Организация, Дата, Область)
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыОрганизации = "БанкСчетНомер, БанкСчетНаимБанка, БанкСчетКоррСчетБанка, БанкСчетБИКБанка";
	ДанныеОрганизации    = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Организация, Дата, РеквизитыОрганизации);
	
	Область.Параметры["КорСчет"] 		= ДанныеОрганизации.БанкСчетКоррСчетБанка;
	Область.Параметры["РасчетныйСчет"] 	= ДанныеОрганизации.БанкСчетНомер;
	Область.Параметры["Банк"] 			= ДанныеОрганизации.БанкСчетНаимБанка;
	Область.Параметры["БИК"] 			= ДанныеОрганизации.БанкСчетБИКБанка;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьОбластьМакетаЗаявка(Объект, ТабДокумент, Макет, ЗаявлениеПолучатель) Экспорт
	
	ОбластьМакета = Макет.ПолучитьОбласть("Заявка");
	
	Если ЗначениеЗаполнено(Объект.ПолноеНаименование) Тогда
		ОбластьМакета.параметры.Фирма = Объект.ПолноеНаименование;
	Иначе
		ОбластьМакета.параметры.Фирма = Объект.КраткоеНаименование;
	КонецЕсли;
	
	ОбластьМакета.параметры.ИНН   = Объект.ИНН;
	ОбластьМакета.параметры.СНИЛС = Объект.ВладелецЭЦПСНИЛС;
	ОбластьМакета.параметры.ОГРН  = Объект.ОГРН;	
	ОбластьМакета.параметры.ЗаявлениеПолучатель = ЗаявлениеПолучатель;
	
	заявитель = Объект.ВладелецЭЦПФамилия + " " + Объект.ВладелецЭЦПИмя + " " + Объект.ВладелецЭЦПОтчество;
	
	Если СтрДлина(Объект.ИНН)=10 Тогда
		заявитель = Строка(Объект.ВладелецЭЦПДолжность) + " " + заявитель;
	КонецЕсли;
	
	ОбластьМакета.Параметры.Заявитель = Заявитель;
	ОбластьМакета.Параметры.Сотр      = Объект.ВладелецЭЦПФамилия + " " + Объект.ВладелецЭЦПИмя + " " + Объект.ВладелецЭЦПОтчество;
	ОбластьМакета.Параметры.Долж      = Объект.ВладелецЭЦПДолжность;
	ОбластьМакета.Параметры.Тел       = Объект.ТелефонОсновной;
	ОбластьМакета.Параметры.КПП       = Объект.КПП;
	ОбластьМакета.Параметры.ФНС       = "нет";
	ОбластьМакета.Параметры.ПФР       = "нет";
	ОбластьМакета.Параметры.ФСС       = "нет";
	ОбластьМакета.Параметры.ФСГС      = "нет";
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	АдресЮридический  = КонтекстЭДОСервер.ПредставлениеАдресаИзДанныхОрганизации(Объект.АдресЮридический);
	АдресФактический  = КонтекстЭДОСервер.ПредставлениеАдресаИзДанныхОрганизации(Объект.АдресФактический);
	
	ОбластьМакета.Параметры.АдресЮР   = АдресЮридический;
	ОбластьМакета.Параметры.АдресФакт = АдресФактический;
	
	Для каждого получатель из Объект.Получатели Цикл
		Если Получатель.ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ФСС Тогда
			ОбластьМакета.Параметры.ФСС = "да";
		ИначеЕсли Получатель.ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ФНС Тогда
			ОбластьМакета.Параметры.ФНС = "да";
			Если СтрНайти(Строка(ОбластьМакета.Параметры.КодИФНС), Строка(Получатель.КодПолучателя))= 0 Тогда
				ОбластьМакета.Параметры.КодИФНС = Строка(ОбластьМакета.Параметры.КодИФНС) + Строка(Получатель.КодПолучателя) + "; " ;
			КонецЕсли;
			Если НЕ ПустаяСтрока(Строка(Получатель.КПП)) Тогда
				ОбластьМакета.Параметры.СписокКПП = Строка(ОбластьМакета.Параметры.СписокКПП) + Строка(Получатель.КПП) + "; ";
			КонецЕсли;
		ИначеЕсли Получатель.ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ПФР Тогда
			ОбластьМакета.Параметры.ПФР = "да";
			ОбластьМакета.Параметры.РегНомерПФР = Объект.РегНомерПФР;
		ИначеЕсли Получатель.ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ФСГС Тогда
			ОбластьМакета.Параметры.ФСГС = "да";
			ОбластьМакета.Параметры.НомерТОГС = Строка(ОбластьМакета.Параметры.НомерТОГС) + Строка(Получатель.КодПолучателя) + "; " ;
		КонецЕсли;
	КонецЦикла;
	
	Если Объект.ПодатьЗаявкуНаСертификатДляФСРАР Тогда
		ОбластьМакета.Параметры.ФСРАР = "да";
	Иначе
		ОбластьМакета.Параметры.ФСРАР = "нет";
	КонецЕсли;
	
	Если Объект.ПодатьЗаявкуНаПодключениеРПН Тогда
		ОбластьМакета.Параметры.РПН = "да";
	Иначе
		ОбластьМакета.Параметры.РПН = "нет";
	КонецЕсли;
	
	Если Объект.ПодатьЗаявкуНаПодключениеФТС Тогда
		ОбластьМакета.Параметры.ФТС = "да";
	Иначе
		ОбластьМакета.Параметры.ФТС = "нет";
	КонецЕсли;
	
	ЗаполнитьДанныеБанкаВЗаявлении(Объект.Организация, Объект.Дата, ОбластьМакета);
	
	Руководитель = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.Руководитель(Объект.Организация);
	ОбластьМакета.Параметры.Руководитель   = Строка(Руководитель);
	
	ОбластьМакета.Параметры.ДатаЗаполнения = Лев(Объект.Дата,10);
	
	КонтекстЭДОСервер.РазместитьНаОдномЛисте(ТабДокумент);
	
	ТабДокумент.Вывести(ОбластьМакета);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьОбластьМакетаСоглашение(Объект, ТабДокумент, Макет,ПараметрыСпецОператора) Экспорт
	
	ОбластьМакета = Макет.ПолучитьОбласть("Соглашение");
	
	ОбластьМакета.Область(4,1).текст = "1. Данным Соглашением " + ПараметрыСпецОператора.НаименованиеУЦ +   " принимает на себя обязательства по оказанию  Пользователю услуг Удостоверяющего центра (далее - «УЦ») в соответствии с  Регламентом УЦ.";
	ОбластьМакета.Область(5,1).текст = "Регламент УЦ находится по адресу " + ПараметрыСпецОператора.АдресРегламентУЦ + ".";
	ОбластьМакета.Область(6,1).текст  = "УЦ является действующим удостоверяющим центром, прошедшим аккредитацию  в сети доверенных УЦ " + ПараметрыСпецОператора.СетьДоверенныхУЦ + ".";
	ОбластьМакета.Область(23,1).текст = "5. Услуги УЦ для обеспечения деятельности Пользователя по обмену электронными документами с применением ЭП с контролирующими органами при наличии у Пользователя Лицензии  на программный продукт " + ПараметрыСпецОператора.НаименованиеПОРаспространяемогоУЦ + " оказываются без дополнительной оплаты.";
	ОбластьМакета.Область(28,1).текст = "Ответственность УЦ перед Пользователем в соответствии с ГК РФ ограничена Соглашением сторон. При этом Сторонами согласован предельный размер ответственности УЦ - " + ПараметрыСпецОператора.СуммаОтветственностиУЦ + " по каждому случаю причинения вреда.";
	ТабДокумент.Вывести(ОбластьМакета);
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьОбластьМакетаЛицензия(Объект, ТабДокумент, Макет, НаименованиеПОРаспространяемогоУЦ) Экспорт
	
	ОбластьМакета = Макет.ПолучитьОбласть("Лицензия");
	
	Если Объект.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Подготовлено Тогда
		// По просьбе Калуги-Астрал
		ОбластьМакета.параметры.Фирма = "";
	Иначе
		ОбластьМакета.параметры.Фирма = Объект.КраткоеНаименование;
	КонецЕсли;
	
	ОбластьМакета.параметры.НаименованиеПОРаспространяемогоУЦ = НаименованиеПОРаспространяемогоУЦ;
	Строка = ОбластьМакета.Область(4,1).текст;
	Строка = СтрЗаменить (Строка, "<НаименованиеПОРаспространяемогоУЦ>",НаименованиеПОРаспространяемогоУЦ);
	ОбластьМакета.Область(4,1).текст = Строка;
	
	Если ЗначениеЗаполнено(Объект.УчетнаяЗапись) Тогда
		ОбластьМакета.Параметры.ДатаВыдачи = Формат(Объект.УчетнаяЗапись.ЛицензияДатаНачала, "ДЛФ=D");
	КонецЕсли;
		
	ТабДокумент.Вывести(ОбластьМакета);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьОбластьМакетаСертификат(Объект, ТабДокумент, Макет, Сертификат, ТекстСертификата, ЗаголовокОтчета)
	
