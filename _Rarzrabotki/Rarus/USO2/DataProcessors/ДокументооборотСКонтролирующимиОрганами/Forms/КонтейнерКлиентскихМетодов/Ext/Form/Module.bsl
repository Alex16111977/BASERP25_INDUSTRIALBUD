#Область ОтправкаУведомленияОПолучателеДокументов

&НаСервереБезКонтекста
Функция СформироватьФайлУведомленияОПолучателеДокументов(
	Уведомление,
	ФамилияИмяОтчествоИлиВладелецСертификатаШифрования = Неопределено,
	УникальныйИдентификатор = Неопределено,
	ПолучитьТекстФайлаУведомления = Ложь)
	
	// получаем свойства уведомления, при необходимости дозаполняем из организации
	СвойстваУведомления = Новый Структура;
	СвойстваУведомления.Вставить("Организация", 								Уведомление.Организация);
	СвойстваУведомления.Вставить("ДляВсехПодразделений", 						Уведомление.ДляВсехПодразделений);
	СвойстваУведомления.Вставить("Получатель", 									Уведомление.Получатель);
	СвойстваУведомления.Вставить("ЗаданиеЯвноРеквизитовПолучателяДокументов", 	Уведомление.ЗаданиеЯвноРеквизитовПолучателяДокументов);
	СвойстваУведомления.Вставить("ИдентификаторАбонента", 						Уведомление.ИдентификаторАбонента);
	СвойстваУведомления.Вставить("НаименованиеПолучателяДокументов", 			Уведомление.НаименованиеПолучателяДокументов);
	СвойстваУведомления.Вставить("ИННПолучателяДокументов", 					Уведомление.ИННПолучателяДокументов);
	СвойстваУведомления.Вставить("КПППолучателяДокументов", 					Уведомление.КПППолучателяДокументов);
	СвойстваУведомления.Вставить("ПолучательДокументовЯвляетсяФизическимЛицом", Уведомление.ПолучательДокументовЯвляетсяФизическимЛицом);
	СвойстваУведомления.Вставить("ФамилияПолучателяДокументов", 				Уведомление.ФамилияПолучателяДокументов);
	СвойстваУведомления.Вставить("ИмяПолучателяДокументов", 					Уведомление.ИмяПолучателяДокументов);
	СвойстваУведомления.Вставить("ОтчествоПолучателяДокументов", 				Уведомление.ОтчествоПолучателяДокументов);
	СвойстваУведомления.Вставить("ДолжностныеЛицаПолучателяДокументов", 		Новый Массив);
	СвойстваУведомления.Вставить("ВидУслуги", 									Неопределено);
	
	Для каждого ДолжностноеЛицоПолучателяДокументов Из Уведомление.ДолжностныеЛицаПолучателяДокументов Цикл
		СвойстваДолжностногоЛица = Новый Структура;
		СвойстваДолжностногоЛица.Вставить("НомерСтроки", 	ДолжностноеЛицоПолучателяДокументов.НомерСтроки);
		СвойстваДолжностногоЛица.Вставить("Фамилия", 		ДолжностноеЛицоПолучателяДокументов.Фамилия);
		СвойстваДолжностногоЛица.Вставить("Имя", 			ДолжностноеЛицоПолучателяДокументов.Имя);
		СвойстваДолжностногоЛица.Вставить("Отчество", 		ДолжностноеЛицоПолучателяДокументов.Отчество);
		СвойстваУведомления.ДолжностныеЛицаПолучателяДокументов.Добавить(СвойстваДолжностногоЛица);
	КонецЦикла;
	
	ПараметрыУведомления = СформироватьПараметрыЗапроса(СвойстваУведомления);
	
	Если НЕ СвойстваУведомления.ЗаданиеЯвноРеквизитовПолучателяДокументов Тогда
		СвойстваПолучателяДокументов = СвойстваПолучателяДокументовУведомления(Уведомление.Организация, ПараметрыУведомления);
		ЗаполнитьЗначенияСвойств(СвойстваУведомления, СвойстваПолучателяДокументов);
		СвойстваУведомления.ДолжностныеЛицаПолучателяДокументов = Новый Массив;
		
		Если НЕ СвойстваПолучателяДокументов.ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
			ФамилияИмяОтчествоДолжностногоЛица = ФамилияИмяОтчествоИлиВладелецСертификатаШифрования;
			Если ТипЗнч(ФамилияИмяОтчествоДолжностногоЛица) = Тип("Строка") Тогда
				ФамилияИмяОтчествоДолжностногоЛица = ФамилияИмяОтчествоИзСвойстваСертификата(ФамилияИмяОтчествоДолжностногоЛица);
			КонецЕсли;
			СвойстваПолучателяДокументов.ФамилияДолжностногоЛица =
				?(ФамилияИмяОтчествоДолжностногоЛица <> Неопределено, ФамилияИмяОтчествоДолжностногоЛица.Фамилия, "");
			СвойстваПолучателяДокументов.ИмяДолжностногоЛица =
				?(ФамилияИмяОтчествоДолжностногоЛица <> Неопределено, ФамилияИмяОтчествоДолжностногоЛица.Имя, "");
			СвойстваПолучателяДокументов.ОтчествоДолжностногоЛица =
				?(ФамилияИмяОтчествоДолжностногоЛица <> Неопределено, ФамилияИмяОтчествоДолжностногоЛица.Отчество, "");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СвойстваПолучателяДокументов.ФамилияДолжностногоЛица)
			ИЛИ ЗначениеЗаполнено(СвойстваПолучателяДокументов.ИмяДолжностногоЛица)
			ИЛИ ЗначениеЗаполнено(СвойстваПолучателяДокументов.ОтчествоДолжностногоЛица) Тогда
			
			СвойстваДолжностногоЛица = Новый Структура;
			СвойстваДолжностногоЛица.Вставить("НомерСтроки", 	1);
			СвойстваДолжностногоЛица.Вставить("Фамилия", 		СвойстваПолучателяДокументов.ФамилияДолжностногоЛица);
			СвойстваДолжностногоЛица.Вставить("Имя", 			СвойстваПолучателяДокументов.ИмяДолжностногоЛица);
			СвойстваДолжностногоЛица.Вставить("Отчество", 		СвойстваПолучателяДокументов.ОтчествоДолжностногоЛица);
			СвойстваУведомления.ДолжностныеЛицаПолучателяДокументов.Добавить(СвойстваДолжностногоЛица);
		КонецЕсли;
	КонецЕсли;
	
	// собираем параметры письма
	Если НЕ ПроверитьЗаполнениеУведомленияОПолучателеДокументов(СвойстваУведомления, ПараметрыУведомления) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось сформировать уведомление о получателе документов.';
															|en = 'Cannot generate the document recipient notification.'"));
		Возврат Неопределено;
	КонецЕсли;
	
	ТекДата = ТекущаяДатаСеанса();
	
	// формируем идентификатор отправителя
	Если ПараметрыУведомления.ПрПодп = 2 Тогда
		СвПред = ПараметрыУведомления.Доверенность.СвУпПред.СвПред;
		Если СвПред.Свойство("СвОрг") Тогда
			ИННКПП = СокрЛП(СвПред.СвОрг.ИННЮЛ) + СокрЛП(СвПред.СвОрг.КПП);
		Иначе
			Если НЕ ПараметрыУведомления.Доверенность.СвУпПред.СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизации Тогда
				ИННКПП = СокрЛП(СвПред.СведФизЛ.ИННФЛ);
			Иначе
				ИННКПП = ?(ПараметрыУведомления.ЭтоПБОЮЛ, СокрЛП(ПараметрыУведомления.ИННФЛ), СокрЛП(ПараметрыУведомления.ИННЮЛ) + СокрЛП(ПараметрыУведомления.КППЮЛ));
			КонецЕсли;
		КонецЕсли;
	Иначе
		ИННКПП = ?(ПараметрыУведомления.ЭтоПБОЮЛ, СокрЛП(ПараметрыУведомления.ИННФЛ), СокрЛП(ПараметрыУведомления.ИННЮЛ) + СокрЛП(ПараметрыУведомления.КППЮЛ));
	КонецЕсли;
	
	СвойстваОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СвойстваУведомления.Организация,
		"КрупнейшийНалогоплательщик, КодНалоговогоОрганаПолучателя");
	КодНалоговогоОргана = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СвойстваУведомления.Получатель, "Код");
	
	ИмяФайлаБезРасширения = "ON_UVPOLDOC_"
							 + ?(СвойстваОрганизации.КрупнейшийНалогоплательщик И ЗначениеЗаполнено(СвойстваОрганизации.КодНалоговогоОрганаПолучателя),
							 СокрЛП(СвойстваОрганизации.КодНалоговогоОрганаПолучателя), СокрЛП(КодНалоговогоОргана))
							 + "_"
							 + СокрЛП(КодНалоговогоОргана)
							 + "_"
							 + ИННКПП
							 + "_"
							 + Формат(ТекДата, "ДФ=yyyyMMdd")
							 + "_"
							 + Строка(Новый УникальныйИдентификатор);
	
	СтрокаБезОграниченияДлины = -1;
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	УзелФайл = ДобавитьУзелXML(Дерево, "Файл");
	ДобавитьУзелXML(УзелФайл, "ИдФайл", Истина, ИмяФайлаБезРасширения,,, СтрокаБезОграниченияДлины);
	НазваниеИВерсияПрограммы = РегламентированнаяОтчетность.НазваниеИВерсияПрограммы();
	ДобавитьУзелXML(УзелФайл, "ВерсПрог", Истина, НазваниеИВерсияПрограммы,,, 40);
	ДобавитьУзелXML(УзелФайл, "ВерсФорм", Истина, "5.01",,, СтрокаБезОграниченияДлины);
	УзелДокумент = ДобавитьУзелXML(УзелФайл, "Документ");
	
		ДобавитьУзелXML(УзелДокумент, "КНД", Истина, "1167008",,, СтрокаБезОграниченияДлины);
		ТекущиеДеньМесяцГод = Формат(ТекДата, "ДФ=dd.MM.yyyy");
		ДобавитьУзелXML(УзелДокумент, "ДатаДок", Истина, ТекущиеДеньМесяцГод,,, СтрокаБезОграниченияДлины);
		ДобавитьУзелXML(УзелДокумент, "КодНО", Истина, КодНалоговогоОргана,,, СтрокаБезОграниченияДлины);
		УзелСвНП = ДобавитьУзелXML(УзелДокумент, "СвНП");
		
		Если НЕ ПараметрыУведомления.ЭтоПБОЮЛ Тогда
			
			УзелНПЮЛ = ДобавитьУзелXML(УзелСвНП, "НПЮЛ");
			
				ДобавитьУзелXML(УзелНПЮЛ, "НаимОрг", Истина, ПараметрыУведомления.НаимЮЛПол,,, 1000);
				ДобавитьУзелXML(УзелНПЮЛ, "ИННЮЛ", Истина, ПараметрыУведомления.ИННЮЛ,,, СтрокаБезОграниченияДлины);
				Если НЕ СвойстваУведомления.ДляВсехПодразделений Тогда
					ДобавитьУзелXML(УзелНПЮЛ, "КПП", Истина, ПараметрыУведомления.КППЮЛ,,, СтрокаБезОграниченияДлины);
				КонецЕсли;
			
		Иначе
			
			УзелНПФЛ = ДобавитьУзелXML(УзелСвНП, "НПФЛ");
			
				ДобавитьУзелXML(УзелНПФЛ, "ИННФЛ", Истина, ПараметрыУведомления.ИННФЛ, Истина,, СтрокаБезОграниченияДлины);
				УзелФИО = ДобавитьУзелXML(УзелНПФЛ, "ФИО");
				
					ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, ПараметрыУведомления.ИПФамилия,,, 60);
					ДобавитьУзелXML(УзелФИО, "Имя", Истина, ПараметрыУведомления.ИПИмя,,, 60);
					ДобавитьУзелXML(УзелФИО, "Отчество", Истина, ПараметрыУведомления.ИПОтчество, Истина,, 60);
			
		КонецЕсли;
		
		УзелПодписант = ДобавитьУзелXML(УзелДокумент, "Подписант");
		
			ДобавитьУзелXML(УзелПодписант, "ПрПодп", Истина, ПараметрыУведомления.ПрПодп);
			УзелФИО = ДобавитьУзелXML(УзелПодписант, "ФИО");
			Если ПараметрыУведомления.ПрПодп = 1 Тогда
				Если НЕ ПараметрыУведомления.ЭтоПБОЮЛ Тогда
					ФИОПодписанта = РегламентированнаяОтчетность.РазложитьФИО(ПараметрыУведомления.ФИОРук);
					ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, ФИОПодписанта.Фамилия,,, 60);
					ДобавитьУзелXML(УзелФИО, "Имя", Истина, ФИОПодписанта.Имя,,, 60);
					ДобавитьУзелXML(УзелФИО, "Отчество", Истина, ФИОПодписанта.Отчество, Истина,, 60);
				Иначе
					ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, ПараметрыУведомления.ИПФамилия,,, 60);
					ДобавитьУзелXML(УзелФИО, "Имя", Истина, ПараметрыУведомления.ИПИмя,,, 60);
					ДобавитьУзелXML(УзелФИО, "Отчество", Истина, ПараметрыУведомления.ИПОтчество, Истина,, 60);
				КонецЕсли;
			Иначе
				СвДоверенность = ПараметрыУведомления.Доверенность;
				
				ФИОПодписанта = ПараметрыУведомления.Доверенность.СвУпПред.СвПред.СведФизЛ.ФИО;
				ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, ФИОПодписанта.Фамилия,,, 60);
				ДобавитьУзелXML(УзелФИО, "Имя", Истина, ФИОПодписанта.Имя,,, 60);
				ДобавитьУзелXML(УзелФИО, "Отчество", Истина, ФИОПодписанта.Отчество, Истина,, 60);
				
				УзелСвПред = ДобавитьУзелXML(УзелПодписант, "СвПред");
				
				УчСвДов = СвДоверенность.УчСвДов;
				НаимДок = "Доверенность №" + УчСвДов.Номер + " от " + УчСвДов.Дата;
				Если ЗначениеЗаполнено(УчСвДов.ДатаОкончания) Тогда
					НаимДок = НаимДок + " по " + УчСвДов.ДатаОкончания;
				КонецЕсли;
				
				ДобавитьУзелXML(УзелСвПред, "НаимДок", Истина, НаимДок,,, 120);
			КонецЕсли;
		
		УзелСвПолДок = ДобавитьУзелXML(УзелДокумент, "СвПолДок");
		
			ДобавитьУзелXML(УзелСвПолДок, "ИдАбонент", Истина, СвойстваУведомления.ИдентификаторАбонента,,, СтрокаБезОграниченияДлины);
			
			Если НЕ СвойстваУведомления.ПолучательДокументовЯвляетсяФизическимЛицом Тогда
				
				УзелСвЮЛ = ДобавитьУзелXML(УзелСвПолДок, "СвЮЛ");
				
					ДобавитьУзелXML(УзелСвЮЛ, "НаимОрг", Истина, СвойстваУведомления.НаименованиеПолучателяДокументов,,, 1000);
					ДобавитьУзелXML(УзелСвЮЛ, "ИННЮЛ", Истина, СвойстваУведомления.ИННПолучателяДокументов,,, СтрокаБезОграниченияДлины);
					ДобавитьУзелXML(УзелСвЮЛ, "КПП", Истина, СвойстваУведомления.КПППолучателяДокументов,,, СтрокаБезОграниченияДлины);
				
			Иначе
				
				УзелСвФЛ = ДобавитьУзелXML(УзелСвПолДок, "СвФЛ");
				
					ДобавитьУзелXML(УзелСвФЛ, "ИННФЛ", Истина, СвойстваУведомления.ИННПолучателяДокументов);
					УзелФИО = ДобавитьУзелXML(УзелСвФЛ, "ФИО");
					
						ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, СвойстваУведомления.ФамилияПолучателяДокументов,,, 60);
						ДобавитьУзелXML(УзелФИО, "Имя", Истина, СвойстваУведомления.ИмяПолучателяДокументов,,, 60);
						ДобавитьУзелXML(УзелФИО, "Отчество", Истина, СвойстваУведомления.ОтчествоПолучателяДокументов, Истина,, 60);
				
			КонецЕсли;
			
			Для каждого ДолжностноеЛицоПолучателяДокументов Из СвойстваУведомления.ДолжностныеЛицаПолучателяДокументов Цикл
				
				УзелФИО = ДобавитьУзелXML(УзелСвПолДок, "ФИО");
				
					ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, ДолжностноеЛицоПолучателяДокументов.Фамилия,,, 60);
					ДобавитьУзелXML(УзелФИО, "Имя", Истина, ДолжностноеЛицоПолучателяДокументов.Имя,,, 60);
					ДобавитьУзелXML(УзелФИО, "Отчество", Истина, ДолжностноеЛицоПолучателяДокументов.Отчество, Истина,, 60);
				
			КонецЦикла;
	
	// сохранение дерева XML в файл и двоичные данные
	ТекстВыгрузкиXML = ЗаписатьДеревоВXML(Дерево);
	
	// формируем имя файла запроса
	ИмяФайлаУведомления = ИмяФайлаБезРасширения + ".xml";
	
	Если ПолучитьТекстФайлаУведомления Тогда
		Результат = Новый Структура("ТекстФайлаУведомления, ИмяФайлаУведомления", ТекстВыгрузкиXML, ИмяФайлаУведомления);
		
	Иначе
		// записываем XML уведомления во временный файл
		ВремФайл = ПолучитьИмяВременногоФайла();
		Если НЕ ЗаписатьXMLВФайл(ТекстВыгрузкиXML, ВремФайл) Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось записать текст уведомления во временный файл.';
																|en = 'Cannot write the notification text to the temporary file.'"));
			Возврат Неопределено;
		КонецЕсли;
		
		// считываем двоичные данные файла уведомления, после чего удаляем файл
		ДвоичныеДанныеФайлаУведомления = Новый ДвоичныеДанные(ВремФайл);
		АдресФайлаУведомления = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаУведомления, УникальныйИдентификатор);
		УдалитьФайлы(ВремФайл);
		
		Результат = Новый Структура("АдресФайлаУведомления, ИмяФайлаУведомления", АдресФайлаУведомления, ИмяФайлаУведомления);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьЗаполнениеУведомленияОПолучателеДокументов(ДокУведомление, Параметры)
	
	СтатусПроверки = Истина;
	
	Если НЕ ЗначениеЗаполнено(ДокУведомление.Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Не задана организация.';
								|en = 'Company is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		СтатусПроверки = Ложь;
		Возврат СтатусПроверки;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(ДокУведомление.Получатель) Тогда
		ТекстСообщения = НСтр("ru = 'Не задан получатель.';
								|en = 'Recipient is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		СтатусПроверки = Ложь;
		Возврат СтатусПроверки;
	КонецЕсли;
	
	// проверка сведений об отправителе
	Если Параметры.ПрПодп = 1 Тогда // отправитель - налогоплательщик
		Если Параметры.ЭтоПБОЮЛ Тогда
			Если НЕ ЗначениеЗаполнено(Параметры.ИННФЛ) Тогда
				ТекстСообщения = НСтр("ru = 'Не задан ИНН индивидуального предпринимателя.';
										|en = 'TIN of individual entrepreneur is not specified.'");
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				СтатусПроверки = Ложь;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		СвПредст = Параметры.Доверенность.СвУпПред.СвПред;
		Если НЕ СвПредст.Свойство("СвОрг") Тогда
			Если НЕ СвПредст.СведФизЛ.ЯвляетсяСотрудникомОрганизации Тогда
				ИННФЛ = СвПредст.СведФизЛ.ИННФЛ;
				
			Иначе
				ИННФЛ = ?(Параметры.ЭтоПБОЮЛ, Параметры.ИННФЛ, Параметры.ИННЮЛ);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ИННФЛ) Тогда
				Если НЕ СвПредст.СведФизЛ.ЯвляетсяСотрудникомОрганизации ИЛИ Параметры.ЭтоПБОЮЛ Тогда
					ТекстСообщения = НСтр("ru = 'Не задан ИНН физлица-представителя.';
											|en = 'TIN of individual representative is not specified.'");
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
					
				Иначе
					ТекстСообщения = НСтр("ru = 'Не задан ИНН организации физлица-представителя.';
											|en = 'TIN of individual''s representative company is not specified.'");
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				КонецЕсли;
				
				СтатусПроверки = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// проверка сведений о налоговом органе
	Если НЕ ЗначениеЗаполнено(Параметры.КодНО) Тогда
		ТекстСообщения = НСтр("ru = 'Не задан налоговый орган.';
								|en = 'Tax authority not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если СтрДлина(Параметры.КодНО) <> 4 ИЛИ НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Параметры.КодНО) Тогда
		ТекстСообщения = НСтр("ru = 'Код налогового органа должен состоять из четырех цифр.';
								|en = 'The tax authority code must contain 4 digits.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	// проверка сведений о получателе документов для налогоплательщика
	Если НЕ ЗначениеЗаполнено(ДокУведомление.ИдентификаторАбонента) Тогда
		ТекстСообщения = НСтр("ru = 'Не задан идентификатор абонента получателя документов для налогоплательщика.';
								|en = 'ID of subscriber receiving documents for a taxpayer is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если НЕ ДокУведомление.ПолучательДокументовЯвляетсяФизическимЛицом Тогда
		Если НЕ ЗначениеЗаполнено(ДокУведомление.НаименованиеПолучателяДокументов) Тогда
			ТекстСообщения = НСтр("ru = 'Не задано наименование организации - получателя документов для налогоплательщика.';
									|en = 'Name of company receiving documents for a taxpayer is not specified.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ДокУведомление.ИННПолучателяДокументов) Тогда
			ТекстСообщения = НСтр("ru = 'Не задан ИНН организации - получателя документов для налогоплательщика.';
									|en = 'TIN of company receiving documents for a taxpayer is not specified.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
			
		ИначеЕсли НЕ РегламентированнаяОтчетностьВызовСервера.ИННСоответствуетТребованиямНаСервере(
			ДокУведомление.ИННПолучателяДокументов, Ложь) Тогда
			ТекстСообщения = НСтр("ru = 'Неверно задан ИНН организации - получателя документов для налогоплательщика.';
									|en = 'TIN of company receiving documents for a taxpayer is specified incorrectly.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ДокУведомление.КПППолучателяДокументов) Тогда
			ТекстСообщения = НСтр("ru = 'Не задан КПП организации - получателя документов для налогоплательщика.';
									|en = 'CRTR of company receiving documents for a taxpayer is not specified.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
			
		ИначеЕсли СтрДлина(ДокУведомление.КПППолучателяДокументов) <> 9 Тогда
			ТекстСообщения = НСтр("ru = 'Неверно задан КПП организации - получателя документов для налогоплательщика.';
									|en = 'Incorrect CRTR of a company that receives taxpayer''s documents.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
	Иначе
		Если НЕ ЗначениеЗаполнено(ДокУведомление.ИННПолучателяДокументов) Тогда
			ТекстСообщения = НСтр("ru = 'Не задан ИНН физического лица - получателя документов для налогоплательщика.';
									|en = 'TIN of individual receiving documents for a taxpayer is not specified.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
			
		ИначеЕсли НЕ РегламентированнаяОтчетностьВызовСервера.ИННСоответствуетТребованиямНаСервере(
			ДокУведомление.ИННПолучателяДокументов, Истина) Тогда
			ТекстСообщения = НСтр("ru = 'Неверно задан ИНН физического лица - получателя документов для налогоплательщика.';
									|en = 'TIN of individual receiving documents for a taxpayer is specified incorrectly.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ДокУведомление.ФамилияПолучателяДокументов) Тогда
			ТекстСообщения = НСтр("ru = 'Не задана фамилия физического лица - получателя документов для налогоплательщика.';
									|en = 'Last name of individual receiving documents for a taxpayer is not specified.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ДокУведомление.ИмяПолучателяДокументов) Тогда
			ТекстСообщения = НСтр("ru = 'Не задано имя физического лица - получателя документов для налогоплательщика.';
									|en = 'Name of individual receiving documents for a taxpayer is not specified.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокУведомление.ДолжностныеЛицаПолучателяДокументов) ИЛИ ДокУведомление.ДолжностныеЛицаПолучателяДокументов.Количество() = 0 Тогда
		Если НЕ ДокУведомление.ЗаданиеЯвноРеквизитовПолучателяДокументов Тогда
			ТекстСообщения = НСтр("ru = 'В учетной записи документооборота организации некорректно задан сертификат шифрования: не удается извлечь должностное лицо.';
									|en = 'Incorrect encryption certificate is specified in the company data interchange account: cannot extract the officer.'");
		Иначе
			ТекстСообщения = НСтр("ru = 'Не задано ни одного должностного лица получателя документов для налогоплательщика.';
									|en = 'No official receiving documents for a taxpayer is specified.'");
		КонецЕсли;
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		СтатусПроверки = Ложь;
		
	Иначе
		Для каждого ДолжностноеЛицоПолучателяДокументов Из ДокУведомление.ДолжностныеЛицаПолучателяДокументов Цикл
			Если НЕ ЗначениеЗаполнено(ДолжностноеЛицоПолучателяДокументов.Фамилия) Тогда
				Если НЕ ДокУведомление.ЗаданиеЯвноРеквизитовПолучателяДокументов И ДолжностноеЛицоПолучателяДокументов.НомерСтроки = 1 Тогда
					ТекстСообщения = НСтр("ru = 'В учетной записи документооборота организации задан некорректный сертификат шифрования: не удается извлечь фамилию должностного лица.';
											|en = 'Incorrect encryption certificate is specified in the company data interchange account: cannot extract the officer last name.'");
				Иначе
					ТекстСообщения = НСтр("ru = 'Не задана фамилия должностного лица получателя документов для налогоплательщика в строке %1.';
											|en = 'Last name of official receiving documents for a taxpayer in line %1 is not specified.'");
				КонецЕсли;
				ТекстСообщения = СтрШаблон(ТекстСообщения, ДолжностноеЛицоПолучателяДокументов.НомерСтроки);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				СтатусПроверки = Ложь;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ДолжностноеЛицоПолучателяДокументов.Имя) Тогда
				Если НЕ ДокУведомление.ЗаданиеЯвноРеквизитовПолучателяДокументов И ДолжностноеЛицоПолучателяДокументов.НомерСтроки = 1 Тогда
					ТекстСообщения = НСтр("ru = 'В учетной записи документооборота организации задан некорректный сертификат шифрования: не удается извлечь имя должностного лица.';
											|en = 'Incorrect encryption certificate is specified in the company data interchange account: cannot extract the officer name.'");
				Иначе
					ТекстСообщения = НСтр("ru = 'Не задано имя должностного лица получателя документов для налогоплательщика в строке %1.';
											|en = 'Name of official receiving documents for a taxpayer in line %1 is not specified.'");
				КонецЕсли;
				ТекстСообщения = СтрШаблон(ТекстСообщения, ДолжностноеЛицоПолучателяДокументов.НомерСтроки);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				СтатусПроверки = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтатусПроверки;
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьУведомлениеОПолучателеДокументовВФайл(ДокУведомление, УникальныйИдентификатор = Неопределено) Экспорт
	
	Если ТипЗнч(ДокУведомление) = Тип("ДокументСсылка.УведомлениеОПолучателеДокументов") Тогда
		ДокУведомлениеСсылка = ДокУведомление;
		СертификатыДолжностныхЛиц = СертификатыДолжностныхЛицПолучателяДокументов(ДокУведомление);
		
	Иначе
		ДокУведомлениеСсылка = ДокУведомление.Ссылка;
		Если НЕ ДокУведомление.ЗаданиеЯвноРеквизитовПолучателяДокументов Тогда
			СертификатыДолжностныхЛиц = СертификатыУчетнойЗаписиПриОбменеЧерезОператора(ДокУведомление.Организация);
		Иначе
			СертификатыДолжностныхЛиц = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ДокУведомление, УникальныйИдентификатор", ДокУведомлениеСсылка, УникальныйИдентификатор);
	Оповещение = Новый ОписаниеОповещения(
		"ВыгрузитьУведомлениеОПолучателеДокументовВФайлПослеПоискаСертификатаДляШифрования", ЭтотОбъект, ДополнительныеПараметры);
	
	Если СертификатыДолжностныхЛиц <> Неопределено И НЕ СертификатыДолжностныхЛиц.ЭтоЭлектроннаяПодписьВМоделиСервиса
	И ЗначениеЗаполнено(СертификатыДолжностныхЛиц.ОтпечатокСертификатаДляШифрования) Тогда
		СвойстваСертификатаДляШифроания = Новый Структура("Отпечаток", СертификатыДолжностныхЛиц.ОтпечатокСертификатаДляШифрования);
		КриптографияЭДКОКлиент.НайтиСертификат(Оповещение, СвойстваСертификатаДляШифроания,, Ложь);
		Возврат;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(Оповещение, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьУведомлениеОПолучателеДокументовВФайлПослеПоискаСертификатаДляШифрования(Результат, ДополнительныеПараметры) Экспорт
	
	ДокУведомление 									= ДополнительныеПараметры.ДокУведомление;
	УникальныйИдентификаторДляВыгрузкиУведомления 	= ДополнительныеПараметры.УникальныйИдентификатор;
	
	ВладелецСертификатаОтветственногоЗаШифрование = ?(Результат <> Неопределено И Результат.Выполнено И Результат.СертификатНайден,
		Результат.СвойстваСертификата.Владелец, Неопределено);
	
	ФайлУведомленияОПолучателеДокументов = СформироватьФайлУведомленияОПолучателеДокументов(
		ДокУведомление,
		ВладелецСертификатаОтветственногоЗаШифрование,
		УникальныйИдентификаторДляВыгрузкиУведомления);
	
	Если ФайлУведомленияОПолучателеДокументов <> Неопределено Тогда
		СохраняемыйФайл = Новый Структура;
		СохраняемыйФайл.Вставить("Адрес", ФайлУведомленияОПолучателеДокументов.АдресФайлаУведомления);
		СохраняемыйФайл.Вставить("Имя", ФайлУведомленияОПолучателеДокументов.ИмяФайлаУведомления);
		ОперацииСФайламиЭДКОКлиент.СохранитьФайлы(СохраняемыйФайл);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СвойстваПолучателяДокументовПоУведомлению(УведомлениеОПолучателеДокументов) Экспорт
	
	СвойстваУведомления = Новый Структура;
	СвойстваУведомления.Вставить("Организация", УведомлениеОПолучателеДокументов.Организация);
	СвойстваУведомления.Вставить("Получатель", 	УведомлениеОПолучателеДокументов.Получатель);
	СвойстваУведомления.Вставить("ВидУслуги", 	Неопределено);
	
	Возврат СвойстваПолучателяДокументовУведомления(УведомлениеОПолучателеДокументов.Организация,, СвойстваУведомления);
	
КонецФункции

&НаСервереБезКонтекста
Функция СвойстваПолучателяДокументовУведомления(ОрганизацияПолучательДокументов, ПараметрыУведомления = Неопределено, СвойстваУведомления = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("НаименованиеПолучателяДокументов", 				"");
	Результат.Вставить("ИННПолучателяДокументов", 						"");
	Результат.Вставить("КПППолучателяДокументов", 						"");
	Результат.Вставить("ПолучательДокументовЯвляетсяФизическимЛицом", 	Ложь);
	Результат.Вставить("ФамилияПолучателяДокументов", 					"");
	Результат.Вставить("ИмяПолучателяДокументов", 						"");
	Результат.Вставить("ОтчествоПолучателяДокументов", 					"");
	Результат.Вставить("ИдентификаторАбонента", 						"");
	Результат.Вставить("ОтпечатокСертификатаДляШифрования", 			"");
	Результат.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", 			Ложь);
	Результат.Вставить("ФамилияДолжностногоЛица", 						"");
	Результат.Вставить("ИмяДолжностногоЛица", 							"");
	Результат.Вставить("ОтчествоДолжностногоЛица", 						"");
	Результат.Вставить("ЭтоПолучательДокументовИзДоверенности", 		Ложь);
	Результат.Вставить("ВидУслуги", 									Неопределено);
	
	Если НЕ ЗначениеЗаполнено(ОрганизацияПолучательДокументов) Тогда
		Возврат Результат;
	КонецЕсли;
	
	// определяем реквизиты получателя документов из свойств организации или параметров доверенности
	
	СведенияОбОрганизации = ПараметрыУведомления;
	Если СведенияОбОрганизации = Неопределено Тогда
		СведенияОбОрганизации = СформироватьПараметрыЗапроса(СвойстваУведомления);
	КонецЕсли;
	
	ЭтоПолучательДокументовИзДоверенности = Ложь;
	
	Если СведенияОбОрганизации.ПрПодп = 2 Тогда
		СвПред = СведенияОбОрганизации.Доверенность.СвУпПред.СвПред;
		
		Если СвПред.Свойство("СвОрг") Тогда
			ЭтоПолучательДокументовИзДоверенности = Истина;
			
			Результат.ПолучательДокументовЯвляетсяФизическимЛицом 	= Ложь;
			Результат.НаименованиеПолучателяДокументов 				= СокрЛП(СвПред.СвОрг.НаимОрг);
			Результат.ИННПолучателяДокументов 						= СокрЛП(СвПред.СвОрг.ИННЮЛ);
			Результат.КПППолучателяДокументов 						= СокрЛП(СвПред.СвОрг.КПП);
			
		ИначеЕсли НЕ СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизации Тогда
			ЭтоПолучательДокументовИзДоверенности = Истина;
			
			Результат.ПолучательДокументовЯвляетсяФизическимЛицом 	= Истина;
			Результат.ИННПолучателяДокументов 						= СокрЛП(СвПред.СведФизЛ.ИННФЛ);
			Результат.ФамилияПолучателяДокументов 					= СвПред.СведФизЛ.ФИО.Фамилия;
			Результат.ИмяПолучателяДокументов 						= СвПред.СведФизЛ.ФИО.Имя;
			Результат.ОтчествоПолучателяДокументов 					= СвПред.СведФизЛ.ФИО.Отчество;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЭтоПолучательДокументовИзДоверенности Тогда
		Результат.ПолучательДокументовЯвляетсяФизическимЛицом = СведенияОбОрганизации.ЭтоПБОЮЛ;
		
		Если НЕ СведенияОбОрганизации.ЭтоПБОЮЛ Тогда
			Результат.НаименованиеПолучателяДокументов 	= СокрЛП(СведенияОбОрганизации.НаимЮЛПол);
			Результат.ИННПолучателяДокументов 			= СокрЛП(СведенияОбОрганизации.ИННЮЛ);
			Результат.КПППолучателяДокументов 			= СокрЛП(СведенияОбОрганизации.КППЮЛ);
			
		Иначе
			Результат.ИННПолучателяДокументов 		= СокрЛП(СведенияОбОрганизации.ИННФЛ);
			Результат.ФамилияПолучателяДокументов 	= СведенияОбОрганизации.ИПФамилия;
			Результат.ИмяПолучателяДокументов 		= СведенияОбОрганизации.ИПИмя;
			Результат.ОтчествоПолучателяДокументов 	= СведенияОбОрганизации.ИПОтчество;
		КонецЕсли;
	КонецЕсли;
	
	Результат.ЭтоПолучательДокументовИзДоверенности = ЭтоПолучательДокументовИзДоверенности;
	
	// определяем должностное лицо получателя документов из сертификата шифрования учетной записи
	
	СертификатыУчетнойЗаписи = СертификатыУчетнойЗаписиПриОбменеЧерезОператора(ОрганизацияПолучательДокументов);
	ЗаполнитьЗначенияСвойств(Результат, СертификатыУчетнойЗаписи);
	
	Если Результат.ЭтоЭлектроннаяПодписьВМоделиСервиса И ЗначениеЗаполнено(Результат.ОтпечатокСертификатаДляШифрования) Тогда
		СвойстваСертификатаДляШифрования = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(Результат.ОтпечатокСертификатаДляШифрования);
		Если СвойстваСертификатаДляШифрования <> Неопределено Тогда
			ФамилияИмяОтчествоДолжностногоЛица = ФамилияИмяОтчествоИзСвойстваСертификата(СвойстваСертификатаДляШифрования.Владелец);
			Результат.ФамилияДолжностногоЛица 	= ФамилияИмяОтчествоДолжностногоЛица.Фамилия;
			Результат.ИмяДолжностногоЛица 		= ФамилияИмяОтчествоДолжностногоЛица.Имя;
			Результат.ОтчествоДолжностногоЛица 	= ФамилияИмяОтчествоДолжностногоЛица.Отчество;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция СертификатыДолжностныхЛицПолучателяДокументов(УведомлениеОПолучателеДокументовСсылка)
	
	СертификатыУчетнойЗаписи = Неопределено;
	
	СвойстваУведомления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УведомлениеОПолучателеДокументовСсылка,
		"Организация, ЗаданиеЯвноРеквизитовПолучателяДокументов");
	
	Если СвойстваУведомления.ЗаданиеЯвноРеквизитовПолучателяДокументов <> Истина И ЗначениеЗаполнено(СвойстваУведомления.Организация) Тогда
		СертификатыУчетнойЗаписи = СертификатыУчетнойЗаписиПриОбменеЧерезОператора(СвойстваУведомления.Организация);
	КонецЕсли;
	
	Возврат СертификатыУчетнойЗаписи;
	
КонецФункции

&НаСервереБезКонтекста
Функция СертификатыУчетнойЗаписиПриОбменеЧерезОператора(Организация)
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторАбонента", 					"");
	Результат.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", 		Ложь);
	Результат.Вставить("ОтпечатокСертификатаРуководителя", 			"");
	Результат.Вставить("ОтпечатокСертификатаГлавногоБухгалтера", 	"");
	Результат.Вставить("ОтпечатокСертификатаДляШифрования", 		"");
	
	СвойстваОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "ВидОбменаСКонтролирующимиОрганами, УчетнаяЗаписьОбмена");
	
	Если СвойстваОрганизации.ВидОбменаСКонтролирующимиОрганами = Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате
		И ЗначениеЗаполнено(СвойстваОрганизации.УчетнаяЗаписьОбмена) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УчетныеЗаписиДокументооборота.ОбменНапрямую КАК ОбменНапрямую,
			|	УчетныеЗаписиДокументооборота.ЭлектроннаяПодписьВМоделиСервиса КАК ЭлектроннаяПодписьВМоделиСервиса,
			|	УчетныеЗаписиДокументооборота.ИдентификаторАбонента КАК ИдентификаторАбонента,
			|	УчетныеЗаписиДокументооборота.СертификатРуководителя КАК СертификатРуководителя,
			|	УчетныеЗаписиДокументооборота.СертификатГлавногоБухгалтера КАК СертификатГлавногоБухгалтера,
			|	УчетныеЗаписиДокументооборота.СертификатДляШифрования КАК СертификатДляШифрования
			|ИЗ
			|	Справочник.УчетныеЗаписиДокументооборота КАК УчетныеЗаписиДокументооборота
			|ГДЕ
			|	УчетныеЗаписиДокументооборота.Ссылка = &УчетнаяЗаписьДокументооборота";
		Запрос.УстановитьПараметр("УчетнаяЗаписьДокументооборота", СвойстваОрганизации.УчетнаяЗаписьОбмена);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И НЕ Выборка.ОбменНапрямую Тогда
			Результат.ИдентификаторАбонента 					= Строка(Выборка.ИдентификаторАбонента);
			Результат.ЭтоЭлектроннаяПодписьВМоделиСервиса 		= Выборка.ЭлектроннаяПодписьВМоделиСервиса;
			Результат.ОтпечатокСертификатаРуководителя 			= Строка(Выборка.СертификатРуководителя);
			Результат.ОтпечатокСертификатаГлавногоБухгалтера 	= Строка(Выборка.СертификатГлавногоБухгалтера);
			Результат.ОтпечатокСертификатаДляШифрования 		= Строка(Выборка.СертификатДляШифрования);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

