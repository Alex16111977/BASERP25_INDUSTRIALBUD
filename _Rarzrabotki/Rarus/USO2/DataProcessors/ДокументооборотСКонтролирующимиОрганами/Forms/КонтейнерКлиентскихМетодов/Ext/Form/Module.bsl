		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОткрытьИнструкциюИнструкциюПоСозданиюКлючаЭЦПЗавершение", 
			ЭтотОбъект);
			
		ОперацииСФайламиЭДКОКлиент.ДанныеССервераВФайл(ОписаниеОповещения, АдресВоВременномХранилище, ".pdf", Истина);
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗаявлениеУжеСформировано(Организация) Экспорт
	
	ПоЭтойОрганизацииУжеЕстьЗаявления = ложь;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаявлениеАбонентаСпецоператораСвязи.Ссылка
		|ИЗ
		|	Документ.ЗаявлениеАбонентаСпецоператораСвязи КАК ЗаявлениеАбонентаСпецоператораСвязи
		|ГДЕ
		|	ЗаявлениеАбонентаСпецоператораСвязи.ПометкаУдаления = ЛОЖЬ
		|	И ЗаявлениеАбонентаСпецоператораСвязи.Организация = &Организация
		|	И ЗаявлениеАбонентаСпецоператораСвязи.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено)";

	Запрос.УстановитьПараметр("Организация", Организация);

	РезультатЗапроса = Запрос.Выполнить();

	Если не РезультатЗапроса.Пустой() Тогда
		ПоЭтойОрганизацииУжеЕстьЗаявления = истина;
	КонецЕсли;
	
	Возврат ПоЭтойОрганизацииУжеЕстьЗаявления;
	
КонецФункции	

