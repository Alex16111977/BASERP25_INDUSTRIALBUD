		ВключатьХэшСертификата);
	
КонецФункции

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSig(
		СертификатАбонента,
		ПодписанныйФайл,
		ВыполняемоеОповещение,
		ЗаписыватьОшибкиВЖурналРегистрации = Ложь,
		УдалятьЛишниеАтрибуты = Ложь) Экспорт
	
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ЗначениеЗаполнено(СертификатАбонента)
		И (СертификатАбонента.Свойство("ЭтоЭлектроннаяПодписьВМоделиСервиса") И СертификатАбонента.ЭтоЭлектроннаяПодписьВМоделиСервиса = Истина
		ИЛИ СертификатАбонента.Свойство("ЭлектроннаяПодписьВМоделиСервиса") И СертификатАбонента.ЭлектроннаяПодписьВМоделиСервиса = Истина);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СертификатАбонента", 					СертификатАбонента);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 				ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ЗаписыватьОшибкиВЖурналРегистрации", 	ЗаписыватьОшибкиВЖурналРегистрации);
	ДополнительныеПараметры.Вставить("УдалятьЛишниеАтрибуты", 				УдалятьЛишниеАтрибуты);
	ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьФайлаXMLDSigПослеЧтенияПодписанногоФайла",
		ЭтотОбъект, ДополнительныеПараметры);
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, СтрокаBase64", Истина, Неопределено, ПодписанныйФайл);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ПодписанныйФайл);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSigПослеЧтенияПодписанногоФайла(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗаписыватьОшибкиВЖурналРегистрации 	= ДополнительныеПараметры.ЗаписыватьОшибкиВЖурналРегистрации;
	УдалятьЛишниеАтрибуты 				= ДополнительныеПараметры.УдалятьЛишниеАтрибуты;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	XMLDSigВBase64 = Результат.СтрокаBase64;
	
	// разобрать XMLDSig
	
	ИнформацияXMLDSig = РазобратьXMLDSigНаСервере(
		XMLDSigВBase64,
		ЗаписыватьОшибкиВЖурналРегистрации,
		УдалятьЛишниеАтрибуты);
	Если ИнформацияXMLDSig = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ИнформацияXMLDSig", ИнформацияXMLDSig);
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьФайлаXMLDSigПослеЗаписиФайлаКанонизированнойИнформацииОбОбъекте",
		ЭтотОбъект, ДополнительныеПараметры);
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
			Истина, Неопределено, ИнформацияXMLDSig.КанонизированныйУзелИнформацияОбОбъектеXMLВBase64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ИнформацияXMLDSig.КанонизированныйУзелИнформацияОбОбъектеXMLВBase64, ".xml");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSigПослеЗаписиФайлаКанонизированнойИнформацииОбОбъекте(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатАбонента = ДополнительныеПараметры.СертификатАбонента;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ИнформацияXMLDSig = ДополнительныеПараметры.ИнформацияXMLDSig;
	
	Если НЕ Результат.Выполнено Тогда
		Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
			УдалитьАдресаИзВременногоХранилища(
				ИнформацияXMLDSig.СертификатПодписантаВBase64,
				ИнформацияXMLDSig.ПодписьВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелИнформацияОбОбъектеXMLВBase64);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ИмяФайлаКанонизированнойИнформацииОбОбъекте = Результат.ИмяФайла;
	
	// проверить хеш
	
	ДополнительныеПараметры.Вставить("ИмяФайлаКанонизированнойИнформацииОбОбъекте", ИмяФайлаКанонизированнойИнформацииОбОбъекте);
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьФайлаXMLDSigПослеПодписанияКанонизированнойИнформацииОбОбъекте", ЭтотОбъект, ДополнительныеПараметры);
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		ИмяФайлаПодписиДляИзвлеченияХеша = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор());
		КриптографияЭДКОКлиент.ПодписатьPKCS7(
			Оповещение,
			СертификатАбонента,
			ИмяФайлаКанонизированнойИнформацииОбОбъекте,
			Ложь,
			ИмяФайлаПодписиДляИзвлеченияХеша,,,,
			"*");
		
	Иначе
		СертификатПодписанта = Новый Структура("Сертификат", ИнформацияXMLDSig.СертификатПодписантаВBase64);
		
		КриптографияЭДКОКлиент.ХешироватьДанные(
			Оповещение,
			Ложь,
			ИмяФайлаКанонизированнойИнформацииОбОбъекте,,
			Ложь,,
			СертификатПодписанта);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSigПослеПодписанияКанонизированнойИнформацииОбОбъекте(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ИнформацияXMLDSig = ДополнительныеПараметры.ИнформацияXMLDSig;
	ИмяФайлаКанонизированнойИнформацииОбОбъекте = ДополнительныеПараметры.ИмяФайлаКанонизированнойИнформацииОбОбъекте;
	
	Если НЕ ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ИмяФайлаКанонизированнойИнформацииОбОбъекте);
	КонецЕсли;
	
	Если НЕ Результат.Выполнено Тогда
		Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
			УдалитьАдресаИзВременногоХранилища(
				ИнформацияXMLDSig.СертификатПодписантаВBase64,
				ИнформацияXMLDSig.ПодписьВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелИнформацияОбОбъектеXMLВBase64);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Если Результат.Свойство("Алгоритм") И ЗначениеЗаполнено(Результат.Алгоритм) Тогда
		Алгоритм = Результат.Алгоритм;
		
	Иначе
		Алгоритм = АлгоритмСертификата(ИнформацияXMLDSig.СертификатПодписантаВBase64, ЭтоЭлектроннаяПодписьВМоделиСервиса,
			НЕ ЭтоЭлектроннаяПодписьВМоделиСервиса);
	КонецЕсли;
	ДополнительныеПараметры.Вставить("Алгоритм", Алгоритм);
	
	ЭтоШестнадцатеричноеПредставлениеХеша = НЕ ЭтоЭлектроннаяПодписьВМоделиСервиса;
	
	ПодписьДляИзвлеченияХешаВBase64 = ?(НЕ ЭтоШестнадцатеричноеПредставлениеХеша, Результат.ФайлПодписи, Результат.Хеш);
	
	Если НЕ ЭтоШестнадцатеричноеПредставлениеХеша Тогда
		ХешСтрокаВBase64 = ХешСтрокаВBase64КанонизированногоФайлаXMLИзПодписиНаСервере(
			Неопределено,
			ПодписьДляИзвлеченияХешаВBase64,
			ИнформацияXMLDSig,
			Истина,
			ДополнительныеПараметры.Алгоритм).ХешСтрокаВBase64;
		
	Иначе
		ХешСтрокаВBase64 = СтрокаВШестнадцатеричномПредставленииВBase64НаСервере(ПодписьДляИзвлеченияХешаВBase64);
	КонецЕсли;
	
	Если ХешСтрокаВBase64 <> ИнформацияXMLDSig.ХешВBase64 Тогда
		Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
			УдалитьАдресаИзВременногоХранилища(
				ИнформацияXMLDSig.СертификатПодписантаВBase64,
				ИнформацияXMLDSig.ПодписьВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьФайлаXMLDSigПослеЗаписиФайлаСертификатаПодписанта",
		ЭтотОбъект, ДополнительныеПараметры);
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
			Истина, Неопределено, ИнформацияXMLDSig.СертификатПодписантаВBase64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ИнформацияXMLDSig.СертификатПодписантаВBase64, ".cer");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSigПослеЗаписиФайлаСертификатаПодписанта(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ИнформацияXMLDSig = ДополнительныеПараметры.ИнформацияXMLDSig;
	
	Если НЕ Результат.Выполнено Тогда
		Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
			УдалитьАдресаИзВременногоХранилища(
				ИнформацияXMLDSig.СертификатПодписантаВBase64,
				ИнформацияXMLDSig.ПодписьВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ИмяФайлаСертификатаПодписанта = Результат.ИмяФайла;
	
	// зарегистрировать сертификат подписанта
	
	ДополнительныеПараметры.Вставить("ИмяФайлаСертификатаПодписанта", ИмяФайлаСертификатаПодписанта);
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьФайлаXMLDSigПослеИмпортаСертификатаПодписанта",
		ЭтотОбъект, ДополнительныеПараметры);
	ЗарегистрироватьСертификатВСистемеНачало(Оповещение, ЭтоЭлектроннаяПодписьВМоделиСервиса, ИмяФайлаСертификатаПодписанта, "AddressBook");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSigПослеИмпортаСертификатаПодписанта(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ИнформацияXMLDSig = ДополнительныеПараметры.ИнформацияXMLDSig;
	ИмяФайлаСертификатаПодписанта = ДополнительныеПараметры.ИмяФайлаСертификатаПодписанта;
	
	Если НЕ ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ИмяФайлаСертификатаПодписанта);
	КонецЕсли;
	
	Если НЕ Результат.Выполнено Тогда
		Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
			УдалитьАдресаИзВременногоХранилища(
				ИнформацияXMLDSig.СертификатПодписантаВBase64,
				ИнформацияXMLDSig.ПодписьВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ОтпечатокСертификатаПодписанта = Результат.Отпечаток;
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		УдалитьИзВременногоХранилища(ИнформацияXMLDSig.СертификатПодписантаВBase64);
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ОтпечатокСертификатаПодписанта", ОтпечатокСертификатаПодписанта);
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьФайлаXMLDSigПослеПоискаСертификатаПодписанта",
		ЭтотОбъект, ДополнительныеПараметры);
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		СвойстваСертификатаПодписанта = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечатокСертификатаПодписанта, "AddressBook");
		Если СвойстваСертификатаПодписанта <> Неопределено Тогда
			РезультатПроверки = ПроверитьСертификатНаСервере(СвойстваСертификатаПодписанта);
			СвойстваСертификатаПодписанта.Вставить("Валиден", РезультатПроверки = Истина);
		КонецЕсли;
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден, СвойстваСертификата",
			Истина, Неопределено, СвойстваСертификатаПодписанта <> Неопределено, СвойстваСертификатаПодписанта);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, ОтпечатокСертификатаПодписанта, "AddressBook", Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSigПослеПоискаСертификатаПодписанта(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗаписыватьОшибкиВЖурналРегистрации 	= ДополнительныеПараметры.ЗаписыватьОшибкиВЖурналРегистрации;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ИнформацияXMLDSig 					= ДополнительныеПараметры.ИнформацияXMLDSig;
	ОтпечатокСертификатаПодписанта 		= ДополнительныеПараметры.ОтпечатокСертификатаПодписанта;
	
	Если НЕ Результат.Выполнено ИЛИ НЕ Результат.СертификатНайден ИЛИ НЕ Результат.СвойстваСертификата.Валиден Тогда
		Если Результат.Выполнено И НЕ Результат.СертификатНайден Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось найти сертификат подписанта с отпечатком %1 для проверкии валидности электронной подписи.';
								|en = 'Cannot find a signer certificate with the %1 thumbprint to check whether the digital signature is valid.'");
			ТекстОшибки = СтрШаблон(ТекстОшибки, ОтпечатокСертификатаПодписанта);
			Если ЗаписыватьОшибкиВЖурналРегистрации Тогда
				ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
					НСтр("ru = 'Электронный документооборот с контролирующими органами. Проверка подписи XMLDSig';
						|en = 'Electronic data interchange with regulatory authorities. Signature check XMLDSig'"),
					"Ошибка",
					ТекстОшибки,,
					Истина);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
			
		ИначеЕсли Результат.Выполнено И НЕ Результат.СвойстваСертификата.Валиден Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось проверить подпись по причине невалидности сертификата ""%1"".';
								|en = 'Cannot check the signature as the ""%1"" certificate is invalid.'");
			ПредставлениеСертификатаПодписанта = ПредставлениеСертификатаПоСвойствам(Результат.СвойстваСертификата);
			ТекстОшибки = СтрШаблон(ТекстОшибки, ПредставлениеСертификатаПодписанта);
			Если ЗаписыватьОшибкиВЖурналРегистрации Тогда
				ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
					НСтр("ru = 'Электронный документооборот с контролирующими органами. Проверка подписи XMLDSig';
						|en = 'Electronic data interchange with regulatory authorities. Signature check XMLDSig'"),
					"Ошибка",
					ТекстОшибки,,
					Истина);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
			УдалитьАдресаИзВременногоХранилища(
				ИнформацияXMLDSig.ПодписьВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатПодписанта = Результат.СвойстваСертификата;
	
	ДополнительныеПараметры.Вставить("СертификатПодписанта", СертификатПодписанта);
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьФайлаXMLDSigПослеЗаписиФайлаКанонизированнойПодписываемойИнформации",
		ЭтотОбъект, ДополнительныеПараметры);
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
			Истина, Неопределено, ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSigПослеЗаписиФайлаКанонизированнойПодписываемойИнформации(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ИнформацияXMLDSig = ДополнительныеПараметры.ИнформацияXMLDSig;
	
