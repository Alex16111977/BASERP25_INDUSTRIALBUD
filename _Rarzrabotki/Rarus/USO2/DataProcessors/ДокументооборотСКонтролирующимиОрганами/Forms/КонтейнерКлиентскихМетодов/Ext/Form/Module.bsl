&НаСервере
Функция ПоказатьКритическиеОшибкиЦиклаОбмена(ЦиклОбмена) Экспорт
	
	ТипыОшибок = Новый Массив;
	ТипыОшибок.Добавить(Перечисления.ТипыТранспортныхСообщений.КритическаяОшибка);
	ТипыОшибок.Добавить(Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеПФР);
	ТипыОшибок.Добавить(Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеФНС);
	ТипыОшибок.Добавить(Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеФСГС);
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
						  |	ТранспортноеСообщение.Ссылка
						  |ИЗ
						  |	Документ.ТранспортноеСообщение КАК ТранспортноеСообщение
						  |ГДЕ
						  |	ТранспортноеСообщение.ЦиклОбмена = &ЦиклОбмена
						  |	И ТранспортноеСообщение.Тип В (&Тип)");
	Запрос.УстановитьПараметр("ЦиклОбмена", ЦиклОбмена);
	Запрос.УстановитьПараметр("Тип", ТипыОшибок);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Сообщение = Выборка.Ссылка;
		Если НЕ Выборка.Следующий() Тогда
			Возврат Сообщение;
		Иначе
			ТипыОшибок = Новый СписокЗначений;
			ТипыОшибок.Добавить(Перечисления.ТипыТранспортныхСообщений.КритическаяОшибка);
			ТипыОшибок.Добавить(Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеПФР);
			ТипыОшибок.Добавить(Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеФНС);
			ТипыОшибок.Добавить(Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеФСГС);
			
			Отбор = Новый Структура();
			Отбор.Вставить("ЦиклОбмена", ЦиклОбмена);
			Отбор.Вставить("Тип", ТипыОшибок);

			Возврат Отбор;
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВложенияТранспортногоСообщения(ТранспортноеСообщение, СДанными = Ложь, ФильтрПоТипу = Неопределено, ИмяФайла = Неопределено, САдресом = Ложь) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПолучитьВложенияТранспортногоСообщения(ТранспортноеСообщение, СДанными, ФильтрПоТипу, ИмяФайла, САдресом);
		
КонецФункции

&НаСервереБезКонтекста
Функция ТранспортноеСообщениеИмеетВложениеЗаданногоТипа(ТранспортноеСообщение, Тип) Экспорт
	
	ВложенияТранспортногоСообщения = ПолучитьВложенияТранспортногоСообщения(ТранспортноеСообщение, , Тип);
	Возврат ВложенияТранспортногоСообщения.Количество() > 0;
		
КонецФункции

&НаСервереБезКонтекста
Функция ИмяВложенияТранспортногоСообщения(ТранспортноеСообщение, Тип) Экспорт
	
	ВложенияТранспортногоСообщения = ПолучитьВложенияТранспортногоСообщения(ТранспортноеСообщение, , Тип);
	
	Если ВложенияТранспортногоСообщения.Количество() > 0 Тогда
		Возврат ВложенияТранспортногоСообщения[0].ИмяФайла;
	Иначе
		Возврат "";
	КонецЕсли;
		
КонецФункции

&НаСервереБезКонтекста
Функция СведенияПоОтправляемымОбъектам(Ссылка) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.СведенияПоОтправляемымОбъектам(Ссылка);
	
КонецФункции

&НаКлиенте
Процедура ПоказатьКритическиеОшибкиПоСсылке(Знач Ссылка, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		ЦиклОбмена = ДополнительныеПараметры.Отправка;
	Иначе
		ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(Ссылка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЦиклОбмена) Тогда
		Результат = ПоказатьКритическиеОшибкиЦиклаОбмена(ЦиклОбмена);
		
		Если ТипЗнч(Результат) = Тип("ДокументСсылка.ТранспортноеСообщение") Тогда 
			ПоказатьЗначение(, Результат);
		ИначеЕсли ТипЗнч(Результат) = Тип("Структура") Тогда
			ПараметрыФормы = Новый Структура("Отбор", Результат);
			ОткрытьФорму("Документ.ТранспортноеСообщение.ФормаСписка", ПараметрыФормы);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПредупреждение(ОсновнойТекст, ТекстПереключатель1, ТекстПереключатель2, ВыполняемоеОповещение = Неопределено) Экспорт
	
	ПараметрыФормы = Новый Структура("ОсновнойТекст, ТекстПереключатель1, ТекстПереключатель2", ОсновнойТекст, ТекстПереключатель1, ТекстПереключатель2);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВопросПредупреждениеЗавершение", ЭтотОбъект, ВыполняемоеОповещение);
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ВопросПредупреждение", ПараметрыФормы,,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПредупреждениеЗавершение(Результат, ВыполняемоеОповещение) Экспорт
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПустуюДатуЗавершенияЦиклаОбмена() Экспорт
	
	Возврат '39991231235959';
	
КонецФункции

