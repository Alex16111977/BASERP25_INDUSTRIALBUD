&НаСервере
Процедура ПеренестиСвойстваСертификатаВЗапрос(Ключ, ПараметрыНовогоСертификата, РеквизитыСертификата)
	
	Значение = Неопределено;
	Если РеквизитыСертификата.Свойство(Ключ, Значение) Тогда
		
		КлючСертификата = Ключ;
		КлючСертификата = СтрЗаменить(КлючСертификата, "OID", "");
		КлючСертификата = СтрЗаменить(КлючСертификата, "_", ".");
		
		ПараметрыНовогоСертификата.Добавить(КлючСертификата, Значение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаявлениеСформироватьАдресДляЗапросаНаСертификатКвалифицированный(ДокументЗаявление, ПараметрыНовогоСертификата)
	
	РеквизитыСертификата = ДокументЗаявление.РеквизитыСертификата.Получить();
	
	Если ЗначениеЗаполнено(РеквизитыСертификата)
		И ДокументЗаявление.ТипЗаявления = Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Изменение Тогда
		
		// Здесь тип сертификата - СертификатКриптографии
		
		ПеренестиСвойстваСертификатаВЗапрос("OID2_5_4_8", ПараметрыНовогоСертификата, РеквизитыСертификата);
		ПеренестиСвойстваСертификатаВЗапрос("OID2_5_4_7", ПараметрыНовогоСертификата, РеквизитыСертификата);
		ПеренестиСвойстваСертификатаВЗапрос("OID2_5_4_9", ПараметрыНовогоСертификата, РеквизитыСертификата);
		
	ИначеЕсли УправлениеКонтактнойИнформациейКлиентСервер.ЭтоКонтактнаяИнформацияВXML(ДокументЗаявление.АдресЮридический) Тогда
			
		localityName = ПолеСертификата_2_5_4_7(ДокументЗаявление.АдресЮридический);
		ПараметрыНовогоСертификата.Добавить("2.5.4.7", localityName); // поле L
		
		stateOrProvinceName = ПолеСертификата_2_5_4_8(ДокументЗаявление.АдресЮридический);
		ПараметрыНовогоСертификата.Добавить("2.5.4.8", stateOrProvinceName); // поле S
		
		streetAddress = ПолеСертификата_2_5_4_9(ДокументЗаявление.АдресЮридический);
		ПараметрыНовогоСертификата.Добавить("2.5.4.9", streetAddress);
		
	Иначе
		
		ЭтоЮридическоеЛицо = СтрДлина(ДокументЗаявление.ИНН) = 10;
	
		ДокументМассив = РазобратьСтроку(ДокументЗаявление.АдресЮридический, ",");
		
		ЭтоЮридическоеЛицо = СтрДлина(ДокументЗаявление.ИНН) = 10;
		Если ЭтоЮридическоеЛицо Тогда
			Квартира = ?(ДокументМассив.Количество() = 10,ДокументМассив[9],"");
			ПараметрыНовогоСертификата.Добавить("2.5.4.9", СокрЛП(ДокументМассив[6] +" " +ДокументМассив[7] +" " + ДокументМассив[8] +" " + Квартира));
		КонецЕсли;
			
		Если ПустаяСтрока(ДокументМассив[4]) Тогда
			номер = 5; // населенный пункт
		Иначе
			номер = 4; // город
		КонецЕсли;
		
		НаселенныйПункт = ДокументМассив[номер];
		ПараметрыНовогоСертификата.Добавить("2.5.4.7", НаселенныйПункт); // поле L
		
		Регион = КодИНазваниеРегионаДляСертификата(ДокументМассив[2]);
		ПараметрыНовогоСертификата.Добавить("2.5.4.8", Регион); // поле S
		
	КонецЕсли;
	
КонецПроцедуры

