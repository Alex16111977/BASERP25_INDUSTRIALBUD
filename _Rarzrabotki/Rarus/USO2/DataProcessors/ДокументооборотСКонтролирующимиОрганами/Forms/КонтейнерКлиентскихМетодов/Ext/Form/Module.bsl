&НаСервереБезКонтекста
Функция ПодключитьсяКПочтовомуСерверу(ПочтовыйПрофиль, ТихийРежим = Ложь) Экспорт
	
	Попытка
		Почта = Новый ИнтернетПочта;
		Почта.Подключиться(ПочтовыйПрофиль);
		Возврат Почта;
	Исключение
		Если НЕ ТихийРежим Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось подключиться к почтовому серверу!';
									|en = 'Cannot connect to the email server.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		КонецЕсли;
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтключитьсяОтПочтовогоСервера(Почта, ТихийРежим = Ложь) Экспорт
	
	Попытка
		Почта.Отключиться();
		Возврат Истина;
	Исключение
		Если НЕ ТихийРежим Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось отключиться от сервера документооборота!';
									|en = 'Cannot disconnect from the data interchange server.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки_НаСервере(Контекст)
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(Контекст);
	
КонецФункции

&НаКлиенте
Функция ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(Контекст)
	
	// отправляем и пишем статус отправки
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки_НаСервере(Контекст) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Оповестить("Изменение сообщения", Новый Структура("Сообщение, ЦиклОбмена, Предмет",
													Контекст.ТранспортноеСообщение,
													Контекст.ЦиклОбмена,
													Контекст.Документ));
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПодтвердитьПовторнуюОтправку(Документ, КонтролирующийОрган, ОписаниеОповещения)

	ДополнительныеПараметры = Новый Структура("ПолучатьДаты, ПолучатьОшибкиОтправки", Ложь, Ложь);
	СостояниеОтправки 		= ТекущееСостояниеОтправки(Документ, КонтролирующийОрган, ДополнительныеПараметры);
	
	Если СостояниеОтправки <> Неопределено И СостояниеОтправки.ТекущийЭтапОтправки <> Неопределено Тогда
		СостояниеСдачиОтчетности = СостояниеОтправки.ТекущийЭтапОтправки.СостояниеСдачиОтчетности;
	Иначе
		СостояниеСдачиОтчетности = Неопределено;
	КонецЕсли;

	Если СостояниеСдачиОтчетности = ПредопределенноеЗначение("Перечисление.СостояниеСдачиОтчетности.ДокументооборотНачат") Тогда
		ТекстВопроса = НСтр("ru = 'Отчет уже отправлен, результат отправки не получен.
								  |Вы действительно хотите отправить отчет повторно?';
								  |en = 'The report is already sent, check result is not received. 
								  |Are you sure you want to send the report again?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		
	ИначеЕсли СостояниеСдачиОтчетности = ПредопределенноеЗначение("Перечисление.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота") Тогда
		ТекстВопроса = НСтр("ru = 'Отчет уже отправлен и успешно сдан.
								  |Вы действительно хотите отправить отчет повторно?';
								  |en = 'The report is already sent and successfully submitted.
								  |Are you sure you want to send the report again?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.Да);
	КонецЕсли;

КонецПроцедуры


#Область ОтправкаРегламентированногоОтчетаВФНС

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФНС(Док, ВыполняемоеОповещение) Экспорт
	
	Контекст = Новый Структура();
	Контекст.Вставить("Док",                   Док);
	Контекст.Вставить("ОповещениеОЗавершении", ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВФНСПослеПодтвержденияПовторнойОтправки",
		ЭтотОбъект,
		Контекст);
	
	ПодтвердитьПовторнуюОтправку(Док, "ФНС", ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФНСПослеПодтвержденияПовторнойОтправки_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	Параметры_Результат = КодВозвратаДиалога.Да;
	Параметры_ВходящийКонтекст = ВходящийКонтекст;
	
	ОтправкаРегламентированногоОтчетаВФНСПослеПодтвержденияПовторнойОтправки(Параметры_Результат, Параметры_ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФНСПослеПодтвержденияПовторнойОтправки(Результат, ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть аналогиная процедура ОтправкаРегламентированногоОтчетаВФНС(),
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Док = ВходящийКонтекст.Док;
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;

	Если НЕ ОтправкаРегламентированногоОтчетаВФНС_ПередВыгрузкойФайла(КонтекстОтправки, Док, УникальныйИдентификатор) Тогда // сервер
		
		Если КонтекстОтправки.Свойство("ОтсутствуетУчетнаяЗапись") Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОтправкаРегламентированногоОтчетаВФНСПослеПодтвержденияПовторнойОтправки_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ВходящийКонтекст);
				
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(Док, ОписаниеОповещения);
			
		ИначеЕсли КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ОповещениеОЗавершении, Ложь);
		Иначе
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ОповещениеОЗавершении);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
			
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС

		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	// Выгрузка
	КоличествоФайловВКомплекте = КоличествоФайловВКомплекте(Док);
	
	Если КоличествоФайловВКомплекте > 1 
		И КонтекстОтправки.ВидОтправляемогоОтчета = "РегламентированныйОтчетУведомлениеОКонтролируемыхСделках" 
		И КонтекстОтправки.ТипОтправляемогоДокумента = "ЭлектронныеПредставленияРегламентированныхОтчетов" Тогда
		
		КонтекстДлительнойОперации = Новый Структура;
		КонтекстДлительнойОперации.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
		КонтекстДлительнойОперации.Вставить("КонтекстОтправки", 	 КонтекстОтправки);
		
		ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
		ПараметрыДлительнойОтправки.ОтчетСсылка 				= Док;
		ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 7;
		ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;
		
		Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка эл. предст. отчета в ФНС
			Возврат;
		КонецЕсли;
		
		ПодключитьОбработчикОжидания("Подключаемый_ОтправкаРегламентированногоОтчетаВФНСОтправкаФайловВКомплекте", 0.1, Истина);
	Иначе
		
		Оповещение = Новый ОписаниеОповещения("ОтправкаРегламентированногоОтчетаВФНСПослеВыгрузки", ЭтотОбъект, ВходящийКонтекст);
		
		ДлительнаяОтправкаКлиент.ЗапретитьВыводСостояния();
		// выгружаем отчет и доверенность, при необходимости
		ВыгрузитьРегламентированныйОтчетИДоверенностьДляОтправки(КонтекстОтправки, Оповещение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФНСПослеВыгрузки(Результат, ВходящийКонтекст) Экспорт
	
	Док = ВходящийКонтекст.Док;
	
	РезультатВыгрузки     = Результат.РезультатВыгрузки;
	КонтекстОтправки      = Результат.Контекст; // Обновленный по результатам выгрузки контекст.
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	
	ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();
	
	Если НЕ РезультатВыгрузки Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);

		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		Возврат;
		
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВФНСПослеАвтонастройкиУчетнойЗаписи",
		ЭтотОбъект,
		ВходящийКонтекст);
	
	КонтекстДлительнойОперации = Новый Структура();
	КонтекстДлительнойОперации.Вставить("Док", Док);
	КонтекстДлительнойОперации.Вставить("ОписаниеОповещения", ОписаниеОповещения);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= Док;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 7;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;
	
	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка отчета в ФНС
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаРегламентированногоОтчетаВФНСПослеВыгрузки", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаРегламентированногоОтчетаВФНСПослеВыгрузки() Экспорт
	
	КонтекстДлительнойОперации = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	Док 				= КонтекстДлительнойОперации.Док;
	ОписаниеОповещения 	= КонтекстДлительнойОперации.ОписаниеОповещения;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется настройка учетной записи..."); // ФНС рег. отчет
	
	ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(Док, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФНСПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
