&НаКлиенте
Процедура ЗашифроватьФайлXMLПослеЧтенияЗашифрованныхДанных(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатШифрованияОтвета 			= ДополнительныеПараметры.СертификатШифрованияОтвета;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	КаталогРезультатовШифрования 		= ДополнительныеПараметры.КаталогРезультатовШифрования;
	СимметричныйКлючВBase64 			= ДополнительныеПараметры.СимметричныйКлючВBase64;
	ПубличныйКлючВBase64 				= ДополнительныеПараметры.ПубличныйКлючВBase64;
	ИнициализационныйВекторВBase64 		= ДополнительныеПараметры.ИнициализационныйВекторВBase64;
	
	Если НЕ Результат.Выполнено Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,КаталогРезультатовШифрования);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ЗашифрованныеДанныеВBase64 = Результат.СтрокаBase64;
	
	Если НЕ ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,КаталогРезультатовШифрования);
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ЗашифрованныеДанныеВBase64", ЗашифрованныеДанныеВBase64);
	Оповещение = Новый ОписаниеОповещения("ЗашифроватьФайлXMLПослеЭкспортаСертификата",
		ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(Оповещение, СертификатШифрованияОтвета);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗашифроватьФайлXMLПослеЭкспортаСертификата(Результат, ДополнительныеПараметры) Экспорт
	
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗашифрованныйФайл 					= ДополнительныеПараметры.ЗашифрованныйФайл;
	ВозвращатьАдрес 					= ДополнительныеПараметры.ВозвращатьАдрес;
	НастройкиОперации 					= ДополнительныеПараметры.НастройкиОперации;
	СимметричныйКлючВBase64 			= ДополнительныеПараметры.СимметричныйКлючВBase64;
	ПубличныйКлючВBase64 				= ДополнительныеПараметры.ПубличныйКлючВBase64;
	ИнициализационныйВекторВBase64 		= ДополнительныеПараметры.ИнициализационныйВекторВBase64;
	ЗашифрованныеДанныеВBase64 			= ДополнительныеПараметры.ЗашифрованныеДанныеВBase64;
	Алгоритм 							= ДополнительныеПараметры.Алгоритм;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатШифрованияОтветаВBase64 = Результат.СтрокаBase64;
	
	Если НастройкиОперации <> Неопределено Тогда
		НастройкиОперации = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(НастройкиОперации);
	Иначе
		НастройкиОперации = Новый Структура;
	КонецЕсли;
	НастройкиОперации.Вставить("ШаблонРезультата", 	НастройкиОперации.ШаблонЗапросаSOAP);
	НастройкиОперации.Вставить("Алгоритм", 			Алгоритм);
	НастройкиОперации.Удалить("ШаблонЗапросаSOAP");
	ЗашифрованныйXML = АдресЗашифрованногоXMLПоДаннымНаСервере(
		СимметричныйКлючВBase64,
		ПубличныйКлючВBase64,
		ИнициализационныйВекторВBase64,
		ЗашифрованныеДанныеВBase64,
		СертификатШифрованияОтветаВBase64,
		НЕ ВозвращатьАдрес И НЕ ЭтоЭлектроннаяПодписьВМоделиСервиса,
		НастройкиОперации);
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		УдалитьАдресаИзВременногоХранилища(
			ЗашифрованныеДанныеВBase64,
			ПубличныйКлючВBase64,
			СимметричныйКлючВBase64,
			ИнициализационныйВекторВBase64);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	Оповещение = Новый ОписаниеОповещения("ЗашифроватьФайлXMLПослеЗаписиФайла",
		ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ВозвращатьАдрес И НЕ ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ЗашифрованныйXML, ЗашифрованныйФайл);
	Иначе
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
			Истина, Неопределено, ЗашифрованныйXML);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗашифроватьФайлXMLПослеЗаписиФайла(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ЗашифрованныйФайл = Результат.ИмяФайла;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, ЗашифрованныйФайл);
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьФайлXML(
		СертификатПолучателя,
		ЗашифрованныйФайл,
		ВыполняемоеОповещение,
		ЗаданАдрес = Ложь,
		РасшифрованныйФайл = Неопределено,
		МассивРодительскихУзловЗашифрованныхДанных = Неопределено) Экспорт
	
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ЗначениеЗаполнено(СертификатПолучателя)
		И (СертификатПолучателя.Свойство("ЭтоЭлектроннаяПодписьВМоделиСервиса") И СертификатПолучателя.ЭтоЭлектроннаяПодписьВМоделиСервиса = Истина
		ИЛИ СертификатПолучателя.Свойство("ЭлектроннаяПодписьВМоделиСервиса") И СертификатПолучателя.ЭлектроннаяПодписьВМоделиСервиса = Истина);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СертификатПолучателя", 						СертификатПолучателя);
	ДополнительныеПараметры.Вставить("ЗашифрованныйФайл", 							ЗашифрованныйФайл);
	ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", 		ЭтоЭлектроннаяПодписьВМоделиСервиса);
	ДополнительныеПараметры.Вставить("ЗашифрованныйФайл", 							ЗашифрованныйФайл);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 						ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ЗаданАдрес", 									ЗаданАдрес);
	ДополнительныеПараметры.Вставить("РасшифрованныйФайл", 							РасшифрованныйФайл);
	ДополнительныеПараметры.Вставить("МассивРодительскихУзловЗашифрованныхДанных", 	МассивРодительскихУзловЗашифрованныхДанных);
	
	Оповещение = Новый ОписаниеОповещения("РасшифроватьФайлXMLПослеЭкспортаСертификатаСтрахователя",
		ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(Оповещение, СертификатПолучателя, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьФайлXMLПослеЭкспортаСертификатаСтрахователя(Результат, ДополнительныеПараметры) Экспорт
	
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ЗашифрованныйФайл 					= ДополнительныеПараметры.ЗашифрованныйФайл;
	ЗаданАдрес 							= ДополнительныеПараметры.ЗаданАдрес;
	
	СертификатПолучателя64 = ?(Результат.Выполнено, Результат.СтрокаBase64, Неопределено);
	
	ДополнительныеПараметры.Вставить("СертификатПолучателя64", СертификатПолучателя64);
	
	Оповещение = Новый ОписаниеОповещения("РасшифроватьФайлXMLПослеЧтенияЗашифрованногоФайла", ЭтотОбъект, ДополнительныеПараметры);
	Если ЗаданАдрес ИЛИ ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, СтрокаBase64",
			Истина, Неопределено, ЗашифрованныйФайл);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ЗашифрованныйФайл);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьФайлXMLПослеЧтенияЗашифрованногоФайла(Результат, ДополнительныеПараметры) Экспорт
	
	ЭтоЭлектроннаяПодписьВМоделиСервиса 		= ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ВыполняемоеОповещение 						= ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗаданАдрес 									= ДополнительныеПараметры.ЗаданАдрес;
	МассивРодительскихУзловЗашифрованныхДанных 	= ДополнительныеПараметры.МассивРодительскихУзловЗашифрованныхДанных;
	СертификатПолучателя64 						= ДополнительныеПараметры.СертификатПолучателя64;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ЗашифрованныйФайлВBase64 = Результат.СтрокаBase64;
	
	ДанныеЗашифрованногоXML = ДанныеПоАдресуЗашифрованногоXMLНаСервере(
		ЗашифрованныйФайлВBase64,
		НЕ ЗаданАдрес И НЕ ЭтоЭлектроннаяПодписьВМоделиСервиса,
		МассивРодительскихУзловЗашифрованныхДанных,
		НЕ ЭтоЭлектроннаяПодписьВМоделиСервиса,
		СертификатПолучателя64);
	Если ДанныеЗашифрованногоXML = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		ДополнительныеПараметры.Вставить("КаталогРезультатовШифрования", 	Неопределено);
		ДополнительныеПараметры.Вставить("ФайлЗашифрованныхДанных", 		ДанныеЗашифрованногоXML.ЗашифрованныеДанныеВBase64);
		ДополнительныеПараметры.Вставить("ФайлСимметричногоКлюча", 			ДанныеЗашифрованногоXML.СимметричныйКлючВBase64);
		ДополнительныеПараметры.Вставить("ФайлПубличногоКлюча", 			ДанныеЗашифрованногоXML.ПубличныйКлючВBase64);
		Оповещение = Новый ОписаниеОповещения("РасшифроватьФайлXMLПослеЗаписиФайлаИнициализационногоВектора",
			ЭтотОбъект, ДополнительныеПараметры);
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
			Истина, Неопределено, ДанныеЗашифрованногоXML.ИнициализационныйВекторВBase64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		ДополнительныеПараметры.Вставить("ЗашифрованныеДанныеВBase64", 		ДанныеЗашифрованногоXML.ЗашифрованныеДанныеВBase64);
		ДополнительныеПараметры.Вставить("СимметричныйКлючВBase64", 		ДанныеЗашифрованногоXML.СимметричныйКлючВBase64);
		ДополнительныеПараметры.Вставить("ПубличныйКлючВBase64", 			ДанныеЗашифрованногоXML.ПубличныйКлючВBase64);
		ДополнительныеПараметры.Вставить("ИнициализационныйВекторВBase64", 	ДанныеЗашифрованногоXML.ИнициализационныйВекторВBase64);
		Оповещение = Новый ОписаниеОповещения("РасшифроватьФайлXMLПослеСозданияКаталога", ЭтотОбъект, ДополнительныеПараметры);
		ОперацииСФайламиЭДКОКлиент.СоздатьКаталогНаКлиенте(Оповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьФайлXMLПослеСозданияКаталога(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗашифрованныеДанныеВBase64 = ДополнительныеПараметры.ЗашифрованныеДанныеВBase64;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	КаталогРезультатовШифрования = Результат.ИмяКаталога;
	
	ДополнительныеПараметры.Вставить("КаталогРезультатовШифрования", КаталогРезультатовШифрования);
	Оповещение = Новый ОписаниеОповещения("РасшифроватьФайлXMLПослеЗаписиФайлаЗашифрованныхДанных",
		ЭтотОбъект, ДополнительныеПараметры);
	ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ЗашифрованныеДанныеВBase64, КаталогРезультатовШифрования + "_encrypt.bin");
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьФайлXMLПослеЗаписиФайлаЗашифрованныхДанных(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	СимметричныйКлючВBase64 = ДополнительныеПараметры.СимметричныйКлючВBase64;
	КаталогРезультатовШифрования = ДополнительныеПараметры.КаталогРезультатовШифрования;
	
	Если НЕ Результат.Выполнено Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,КаталогРезультатовШифрования);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлЗашифрованныхДанных = Результат.ИмяФайла;
	
	ДополнительныеПараметры.Вставить("ФайлЗашифрованныхДанных", ФайлЗашифрованныхДанных);
	Оповещение = Новый ОписаниеОповещения("РасшифроватьФайлXMLПослеЗаписиФайлаСимметричногоКлюча",
		ЭтотОбъект, ДополнительныеПараметры);
	ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, СимметричныйКлючВBase64, КаталогРезультатовШифрования + "_skey.bin");
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьФайлXMLПослеЗаписиФайлаСимметричногоКлюча(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПубличныйКлючВBase64 = ДополнительныеПараметры.ПубличныйКлючВBase64;
	КаталогРезультатовШифрования = ДополнительныеПараметры.КаталогРезультатовШифрования;
	
	Если НЕ Результат.Выполнено Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,КаталогРезультатовШифрования);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлСимметричногоКлюча = Результат.ИмяФайла;
	
	ДополнительныеПараметры.Вставить("ФайлСимметричногоКлюча", ФайлСимметричногоКлюча);
	Оповещение = Новый ОписаниеОповещения("РасшифроватьФайлXMLПослеЗаписиФайлаПубличногоКлюча",
		ЭтотОбъект, ДополнительныеПараметры);
	ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ПубличныйКлючВBase64, КаталогРезультатовШифрования + "_pubkey.bin");
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьФайлXMLПослеЗаписиФайлаПубличногоКлюча(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ИнициализационныйВекторВBase64 = ДополнительныеПараметры.ИнициализационныйВекторВBase64;
	КаталогРезультатовШифрования = ДополнительныеПараметры.КаталогРезультатовШифрования;
	
	Если НЕ Результат.Выполнено Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,КаталогРезультатовШифрования);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлПубличногоКлюча = Результат.ИмяФайла;
	
	ДополнительныеПараметры.Вставить("ФайлПубличногоКлюча", ФайлПубличногоКлюча);
	Оповещение = Новый ОписаниеОповещения("РасшифроватьФайлXMLПослеЗаписиФайлаИнициализационногоВектора",
		ЭтотОбъект, ДополнительныеПараметры);
	ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ИнициализационныйВекторВBase64, КаталогРезультатовШифрования + "_iv.bin");
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьФайлXMLПослеЗаписиФайлаИнициализационногоВектора(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатПолучателя 				= ДополнительныеПараметры.СертификатПолучателя;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	КаталогРезультатовШифрования 		= ДополнительныеПараметры.КаталогРезультатовШифрования;
	ФайлЗашифрованныхДанных 			= ДополнительныеПараметры.ФайлЗашифрованныхДанных;
	ФайлСимметричногоКлюча 				= ДополнительныеПараметры.ФайлСимметричногоКлюча;
	ФайлПубличногоКлюча 				= ДополнительныеПараметры.ФайлПубличногоКлюча;
	
	Если НЕ Результат.Выполнено Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,КаталогРезультатовШифрования);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлИнициализационногоВектора = Результат.ИмяФайла;
	
	ФайлРасшифрованныхДанных = ?(ЭтоЭлектроннаяПодписьВМоделиСервиса, Новый УникальныйИдентификатор, Неопределено);
	
	ДополнительныеПараметры.Вставить("ФайлИнициализационногоВектора", ФайлИнициализационногоВектора);
	Оповещение = Новый ОписаниеОповещения("РасшифроватьФайлXMLПослеРасшифрования",
		ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.РасшифроватьФайл(
		Оповещение,
		СертификатПолучателя,
		ФайлЗашифрованныхДанных,
		ФайлПубличногоКлюча,
		ФайлСимметричногоКлюча,
		ФайлИнициализационногоВектора,
		ФайлРасшифрованныхДанных);
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьФайлXMLПослеРасшифрования(Результат, ДополнительныеПараметры) Экспорт
	
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	КаталогРезультатовШифрования 		= ДополнительныеПараметры.КаталогРезультатовШифрования;
	ФайлЗашифрованныхДанных 			= ДополнительныеПараметры.ФайлЗашифрованныхДанных;
	ФайлСимметричногоКлюча 				= ДополнительныеПараметры.ФайлСимметричногоКлюча;
	ФайлПубличногоКлюча 				= ДополнительныеПараметры.ФайлПубличногоКлюча;
	ФайлИнициализационногоВектора 		= ДополнительныеПараметры.ФайлИнициализационногоВектора;
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		УдалитьАдресаИзВременногоХранилища(
			ФайлЗашифрованныхДанных,
			ФайлСимметричногоКлюча,
			ФайлПубличногоКлюча,
			ФайлИнициализационногоВектора);
	Иначе
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,КаталогРезультатовШифрования);
	КонецЕсли;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлРасшифрованныхДанных = Результат.РасшифрованныйФайл;
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		ФайлРасшифрованныхДанных = СкорректироватьXMLПослеРасшифровкиВоВременномХранилище(ФайлРасшифрованныхДанных);
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ФайлРасшифрованныхДанных", ФайлРасшифрованныхДанных);
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		Оповещение = Новый ОписаниеОповещения("РасшифроватьФайлXMLПослеЗаписиРасшифрованногоФайла",
			ЭтотОбъект, ДополнительныеПараметры);
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
			Истина, Неопределено, ФайлРасшифрованныхДанных);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		Оповещение = Новый ОписаниеОповещения("РасшифроватьФайлXMLПослеЧтенияРасшифрованногоФайла",
			ЭтотОбъект, ДополнительныеПараметры);
		ОперацииСФайламиЭДКОКлиент.ФайлВТекст(Оповещение, ФайлРасшифрованныхДанных, "windows-1251");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьФайлXMLПослеЧтенияРасшифрованногоФайла(Результат, ДополнительныеПараметры) Экспорт
	
	РасшифрованныйФайл = ДополнительныеПараметры.РасшифрованныйФайл;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ФайлРасшифрованныхДанных = ДополнительныеПараметры.ФайлРасшифрованныхДанных;
	
	ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,ФайлРасшифрованныхДанных);
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ТекстРасшифрованногоФайла = Результат.Текст;
	
	ТекстРасшифрованногоФайла = СкорректироватьXMLПослеРасшифровки(ТекстРасшифрованногоФайла);
	
	Оповещение = Новый ОписаниеОповещения("РасшифроватьФайлXMLПослеЗаписиРасшифрованногоФайла",
		ЭтотОбъект, ДополнительныеПараметры);
	ОперацииСФайламиЭДКОКлиент.ТекстВФайл(Оповещение, ТекстРасшифрованногоФайла, РасшифрованныйФайл);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СкорректироватьXMLПослеРасшифровки(ТекстРасшифрованногоXML)
	
	Результат = ТекстРасшифрованногоXML;
	
	ДлинаТекста = СтрДлина(Результат);
	ДлинаПоследнегоБлока = ДлинаТекста % 8;
	ДлинаПоследнегоБлока = ?(ДлинаПоследнегоБлока = 0 И ДлинаТекста > 8, 8, ДлинаПоследнегоБлока) + ?(ДлинаТекста > 8, 1, 0);
	
	ТекстЗавершенияРасшифрованногоФайла = Сред(Результат, ДлинаТекста - ДлинаПоследнегоБлока + 1);
	ПозицияЗакрытияУзла = СтрНайти(ТекстЗавершенияРасшифрованногоФайла, ">");
	Если ПозицияЗакрытияУзла > 0 Тогда
		Результат = Лев(Результат, ДлинаТекста - ДлинаПоследнегоБлока)
			+ Лев(ТекстЗавершенияРасшифрованногоФайла, ПозицияЗакрытияУзла);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция СкорректироватьXMLПослеРасшифровкиВоВременномХранилище(АдресРасшифрованногоXML)
	
	ВременныйФайлРасшифрованногоXML = ПолучитьИмяВременногоФайла();
	ДвоичныеДанныеРасшифрованногоXML = ПолучитьИзВременногоХранилища(АдресРасшифрованногоXML);
	ДвоичныеДанныеРасшифрованногоXML.Записать(ВременныйФайлРасшифрованногоXML);
	ЧтениеТекстаРасшифрованногоXML = Новый ЧтениеТекста(ВременныйФайлРасшифрованногоXML, "windows-1251");
	ТекстРасшифрованногоXML = ЧтениеТекстаРасшифрованногоXML.Прочитать();
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВременныйФайлРасшифрованногоXML);
	
	ТекстРасшифрованногоXML = СкорректироватьXMLПослеРасшифровки(ТекстРасшифрованногоXML);
	
	ВременныйФайлРасшифрованногоXML = ПолучитьИмяВременногоФайла();
	ЗаписьТекстаРасшифрованногоXML = Новый ЗаписьТекста(ВременныйФайлРасшифрованногоXML, "windows-1251");
	ЗаписьТекстаРасшифрованногоXML.Записать(ТекстРасшифрованногоXML);
	ЗаписьТекстаРасшифрованногоXML.Закрыть();
	ДвоичныеДанныеРасшифрованногоXML = Новый ДвоичныеДанные(ВременныйФайлРасшифрованногоXML);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВременныйФайлРасшифрованногоXML);
	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанныеРасшифрованногоXML, АдресРасшифрованногоXML);
	
КонецФункции

&НаКлиенте
Процедура РасшифроватьФайлXMLПослеЗаписиРасшифрованногоФайла(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	РасшифрованныйФайл = Результат.ИмяФайла;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РасшифрованныйФайл);
	
КонецПроцедуры

&НаСервереБезКонтекста
