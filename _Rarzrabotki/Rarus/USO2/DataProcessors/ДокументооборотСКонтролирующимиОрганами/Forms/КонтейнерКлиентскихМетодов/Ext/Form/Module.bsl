	СоответствиеТСКП.Вставить(Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗапросаНаВыпискуЕРГЮЛ_ЕГРИП,	"Результат обработки запроса");

	Возврат СоответствиеТСКП;

КонецФункции

&НаСервереБезКонтекста
Функция УчетнаяЗаписьНастроенаВерно(Знач УчетнаяЗапись, УпрощеннаяПроверкаСертификатов = Истина) Экспорт
	
	Если ТипЗнч(УчетнаяЗапись) = Тип("СправочникСсылка.Организации") Тогда
		УчетнаяЗапись = УчетнаяЗаписьОрганизации(УчетнаяЗапись);
	КонецЕсли;
	
	Если УчетнаяЗапись = Неопределено ИЛИ УчетнаяЗапись = Справочники.УчетныеЗаписиДокументооборота.ПустаяСсылка() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// определяем результирующую структуру
	СвойстваУчетнойЗаписи = Новый Структура("Наименование, АдресЭлектроннойПочты, ОбменНапрямую, ОбменНапрямуюСФСГС, " +
											"ИмяПользователяPOP3, ПарольPOP3, СерверPOP3, ИмяПользователяSMTP, ПарольSMTP, СерверSMTP, ТребуетсяSMTPАутентификация, " +
											"НалоговыйОрган, СерверДокументооборота, СертификатРуководителя, СертификатГлавногоБухгалтера, СертификатДляШифрования, " +
											"НалоговыйОрганАдресЭлектроннойПочтыДляЦелейДокументооборотаСНалогоплательщиками, НалоговыйОрганСертификат, НалоговыйОрганКод, НалоговыйОрганНаименование, НалоговыйОрганПредставление, " +
											"СерверДокументооборотаПредставление, СерверДокументооборотаСертификат, СерверДокументооборотаАдресЭлектроннойПочтыФНС, СерверДокументооборотаАдресЭлектроннойПочтыПФР, СерверДокументооборотаАдресЭлектроннойПочтыФСГС, " +
											"ПредназначенаДляДокументооборотаСФНС, ПредназначенаДляДокументооборотаСПФР, ПредназначенаДляДокументооборотаСФСГС, " +
											"ИдентификаторСпецоператора, ИдентификаторАбонента");
	
	Если ТипЗнч(УчетнаяЗапись) = Тип("СправочникОбъект.УчетныеЗаписиДокументооборота") Тогда
		
		// заполняем свойства из объекта
		ЗаполнитьЗначенияСвойств(СвойстваУчетнойЗаписи, УчетнаяЗапись);
		
		ЗапросРеквизитыПоСсылкам = Новый Запрос("ВЫБРАТЬ
		                                        |	"""" КАК ИД,
		                                        |	"""" КАК Код,
		                                        |	"""" КАК Наименование,
		                                        |	"""" КАК Представление,
		                                        |	"""" КАК Сертификат,
		                                        |	"""" КАК Адрес1,
		                                        |	"""" КАК Адрес2,
		                                        |	"""" КАК Адрес3");
		
		Если ЗначениеЗаполнено(УчетнаяЗапись.НалоговыйОрган) Тогда
			
			ЗапросРеквизитыПоСсылкам.Текст = ЗапросРеквизитыПоСсылкам.Текст + "
			                                        |
			                                        |ОБЪЕДИНИТЬ ВСЕ
			                                        |
			                                        |ВЫБРАТЬ
			                                        |	&ИДНалоговыйОрган,
			                                        |	НалоговыеОрганы.Код,
			                                        |	НалоговыеОрганы.Наименование,
			                                        |	НалоговыеОрганы.Представление,
			                                        |	"""",
			                                        |	НалоговыеОрганы.АдресЭлектроннойПочтыДляЦелейДокументооборотаСНалогоплательщиками,
			                                        |	"""",
			                                        |	""""
			                                        |ИЗ
			                                        |	Справочник.НалоговыеОрганы КАК НалоговыеОрганы
			                                        |ГДЕ
			                                        |	НалоговыеОрганы.Ссылка = &НалоговыйОрган";
			ЗапросРеквизитыПоСсылкам.УстановитьПараметр("ИДНалоговыйОрган", "НалоговыйОрган");
			ЗапросРеквизитыПоСсылкам.УстановитьПараметр("НалоговыйОрган", УчетнаяЗапись.НалоговыйОрган);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(УчетнаяЗапись.СерверДокументооборота) Тогда
			
			ЗапросРеквизитыПоСсылкам.Текст = ЗапросРеквизитыПоСсылкам.Текст + "
			                                        |
			                                        |ОБЪЕДИНИТЬ ВСЕ
			                                        |
			                                        |ВЫБРАТЬ
			                                        |	&ИДСерверДокументооборота,
			                                        |	"""",
			                                        |	"""",
			                                        |	СерверыДокументооборота.Представление,
			                                        |	СерверыДокументооборота.Сертификат,
			                                        |	СерверыДокументооборота.АдресЭлектроннойПочтыФНС,
			                                        |	СерверыДокументооборота.АдресЭлектроннойПочтыПФР,
			                                        |	СерверыДокументооборота.АдресЭлектроннойПочтыФСГС
			                                        |ИЗ
			                                        |	Справочник.СерверыДокументооборота КАК СерверыДокументооборота
			                                        |ГДЕ
			                                        |	СерверыДокументооборота.Ссылка = &СерверДокументооборота";
			ЗапросРеквизитыПоСсылкам.УстановитьПараметр("ИДСерверДокументооборота", "СерверДокументооборота");
			ЗапросРеквизитыПоСсылкам.УстановитьПараметр("СерверДокументооборота", УчетнаяЗапись.СерверДокументооборота);
			
		КонецЕсли;
		
		Выборка = ЗапросРеквизитыПоСсылкам.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ИД = Выборка.ИД;
			Если ИД = "НалоговыйОрган" Тогда
				СвойстваУчетнойЗаписи.НалоговыйОрганКод = Выборка.Код;
				СвойстваУчетнойЗаписи.НалоговыйОрганНаименование = Выборка.Наименование;
				СвойстваУчетнойЗаписи.НалоговыйОрганПредставление = Выборка.Представление;
				СвойстваУчетнойЗаписи.НалоговыйОрганАдресЭлектроннойПочтыДляЦелейДокументооборотаСНалогоплательщиками = Выборка.Адрес1;
			ИначеЕсли ИД = "СерверДокументооборота" Тогда
				СвойстваУчетнойЗаписи.СерверДокументооборотаПредставление = Выборка.Представление;
				СвойстваУчетнойЗаписи.СерверДокументооборотаСертификат = Выборка.Сертификат;
				СвойстваУчетнойЗаписи.СерверДокументооборотаАдресЭлектроннойПочтыФНС = Выборка.Адрес1;
				СвойстваУчетнойЗаписи.СерверДокументооборотаАдресЭлектроннойПочтыПФР = Выборка.Адрес2;
				СвойстваУчетнойЗаписи.СерверДокументооборотаАдресЭлектроннойПочтыФСГС = Выборка.Адрес3;
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
		                      |	УчетныеЗаписиДокументооборота.Наименование,
		                      |	УчетныеЗаписиДокументооборота.ОбменНапрямую,
		                      |	УчетныеЗаписиДокументооборота.ОбменНапрямуюСФСГС,
		                      |	УчетныеЗаписиДокументооборота.ИмяПользователяPOP3,
		                      |	УчетныеЗаписиДокументооборота.ПарольPOP3,
		                      |	УчетныеЗаписиДокументооборота.СерверPOP3,
		                      |	УчетныеЗаписиДокументооборота.ИмяПользователяSMTP,
		                      |	УчетныеЗаписиДокументооборота.ПарольSMTP,
		                      |	УчетныеЗаписиДокументооборота.СерверSMTP,
		                      |	УчетныеЗаписиДокументооборота.ТребуетсяSMTPАутентификация,
		                      |	УчетныеЗаписиДокументооборота.АдресЭлектроннойПочты,
		                      |	УчетныеЗаписиДокументооборота.НалоговыйОрган,
		                      |	УчетныеЗаписиДокументооборота.СерверДокументооборота,
		                      |	УчетныеЗаписиДокументооборота.СертификатРуководителя,
		                      |	УчетныеЗаписиДокументооборота.СертификатГлавногоБухгалтера,
		                      |	УчетныеЗаписиДокументооборота.СертификатДляШифрования,
		                      |	УчетныеЗаписиДокументооборота.ПредназначенаДляДокументооборотаСФНС,
		                      |	УчетныеЗаписиДокументооборота.ПредназначенаДляДокументооборотаСПФР,
		                      |	УчетныеЗаписиДокументооборота.ПредназначенаДляДокументооборотаСФСГС,
		                      |	УчетныеЗаписиДокументооборота.ИдентификаторАбонента,
		                      |	УчетныеЗаписиДокументооборота.ИдентификаторСпецоператора,
		                      |	УчетныеЗаписиДокументооборота.НалоговыйОрган.Представление,
		                      |	УчетныеЗаписиДокументооборота.НалоговыйОрган.АдресЭлектроннойПочтыДляЦелейДокументооборотаСНалогоплательщиками,
		                      |	УчетныеЗаписиДокументооборота.НалоговыйОрган.Код,
		                      |	УчетныеЗаписиДокументооборота.НалоговыйОрган.Наименование,
		                      |	УчетныеЗаписиДокументооборота.СерверДокументооборота.Представление КАК СерверДокументооборотаПредставление,
		                      |	УчетныеЗаписиДокументооборота.СерверДокументооборота.АдресЭлектроннойПочтыФНС КАК СерверДокументооборотаАдресЭлектроннойПочтыФНС,
		                      |	УчетныеЗаписиДокументооборота.СерверДокументооборота.АдресЭлектроннойПочтыПФР КАК СерверДокументооборотаАдресЭлектроннойПочтыПФР,
		                      |	УчетныеЗаписиДокументооборота.СерверДокументооборота.АдресЭлектроннойПочтыФСГС КАК СерверДокументооборотаАдресЭлектроннойПочтыФСГС,
		                      |	УчетныеЗаписиДокументооборота.СерверДокументооборота.Сертификат КАК СерверДокументооборотаСертификат
		                      |ИЗ
		                      |	Справочник.УчетныеЗаписиДокументооборота КАК УчетныеЗаписиДокументооборота
		                      |ГДЕ
		                      |	УчетныеЗаписиДокументооборота.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", УчетнаяЗапись);
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не удалось извлечь из информационной базы информацию об учетной записи %1!';
					|en = 'Cannot extract the %1 account information from the infobase.'"), Символ(34) + УчетнаяЗапись + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		ЗаполнитьЗначенияСвойств(СвойстваУчетнойЗаписи, Выборка);
		
	КонецЕсли;
	
	ПризнакОшибки = Ложь;
	
	// проверяем адрес электронной почты учетной записи
	Если ПустаяСтрока(СвойстваУчетнойЗаписи.АдресЭлектроннойПочты) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Для учетной записи %1 не задан адрес электронной почты!';
				|en = 'Email address is not specified for account %1.'"),
			Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	// проверяем параметры доступа к учетной записи на сервере документооборота
	Если ПустаяСтрока(СвойстваУчетнойЗаписи.ИмяПользователяPOP3) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Для учетной записи %1 не задано имя пользователя для доступа по протоколу POP3!';
				|en = 'Username for access using POP3 protocol is not specified for account %1.'"),
			Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	Если ПустаяСтрока(СвойстваУчетнойЗаписи.ПарольPOP3) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Для учетной записи %1 не задан пароль для доступа по протоколу POP3!';
				|en = 'Password for access using POP3 protocol is not specified for account %1.'"),
			Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	Если ПустаяСтрока(СвойстваУчетнойЗаписи.СерверPOP3) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Для учетной записи %1 не задан адрес сервера POP3!';
				|en = 'POP3 server address is not specified for account %1.'"),
			Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	Если СвойстваУчетнойЗаписи.ТребуетсяSMTPАутентификация Тогда
	
		Если ПустаяСтрока(СвойстваУчетнойЗаписи.ИмяПользователяSMTP) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для учетной записи %1 требуется SMTP-аутентификация, но не задано имя пользователя для доступа по протоколу SMTP!';
					|en = 'SMTP authentication is required for account %1, but username for access using SMTP protocol is not specified. '"),
				Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			ПризнакОшибки = Истина;
		КонецЕсли;
		
		Если ПустаяСтрока(СвойстваУчетнойЗаписи.ПарольSMTP) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для учетной записи %1 требуется SMTP-аутентификация, но не задан пароль для доступа по протоколу SMTP!';
					|en = 'SMTP authentication is required for account %1, but the password for access using SMTP protocol is not specified. '"),
				Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			ПризнакОшибки = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	// проверяем свойства налогового органа
	Если СвойстваУчетнойЗаписи.ПредназначенаДляДокументооборотаСФНС Тогда
		
		Если НЕ ЗначениеЗаполнено(СвойстваУчетнойЗаписи.ИдентификаторАбонента) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для учетной записи %1 не задан идентификатор абонента!';
					|en = 'Subscriber ID is not specified for account %1.'"),
				Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			ПризнакОшибки = Истина;
		КонецЕсли;
		
		Если СвойстваУчетнойЗаписи.НалоговыйОрган.Пустая() Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для учетной записи %1 не задан налоговый орган!';
					|en = 'Tax authority is not specified for account %1.'"),
				Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			ПризнакОшибки = Истина;
			
		Иначе
			
			Если ПустаяСтрока(СвойстваУчетнойЗаписи.НалоговыйОрганКод) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Для налогового органа %1, сопоставленного учетной записи %2, не задан код!';
						|en = 'Code is not specified for tax authority %1 which is mapped to account %2.'"),
					Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.НалоговыйОрганПредставление)+ Символ(34),
					Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				ПризнакОшибки = Истина;
			КонецЕсли;
			
			Если СвойстваУчетнойЗаписи.ОбменНапрямую И ПустаяСтрока(СвойстваУчетнойЗаписи.НалоговыйОрганАдресЭлектроннойПочтыДляЦелейДокументооборотаСНалогоплательщиками) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Для налогового органа %1, сопоставленного учетной записи %2, не задан адрес электронной почты для целей обмена!';
						|en = 'Email address for exchange is not specified for tax authority %1 which is mapped to account %2.'"),
					Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.НалоговыйОрганПредставление)+ Символ(34),
					Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				ПризнакОшибки = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// проверяем свойства сервера документооборота
	Если СвойстваУчетнойЗаписи.СерверДокументооборота.Пустая() Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Для учетной записи %1 не задан сервер документооборота!';
				|en = 'Data interchange server is not specified for account %1.'"),
			Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	Иначе
		
		Если СвойстваУчетнойЗаписи.ПредназначенаДляДокументооборотаСФНС И ПустаяСтрока(СвойстваУчетнойЗаписи.СерверДокументооборотаСертификат) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для сервера документооборота %1, сопоставленного учетной записи %2, не задан цифровой сертификат!';
					|en = 'Digital certificate is not specified for data interchange server %1 mapped to account %2.'"),
				Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.СерверДокументооборотаПредставление)+ Символ(34),
				Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			ПризнакОшибки = Истина;
		КонецЕсли;
		
		Если СвойстваУчетнойЗаписи.ПредназначенаДляДокументооборотаСФНС И ПустаяСтрока(СвойстваУчетнойЗаписи.СерверДокументооборотаАдресЭлектроннойПочтыФНС) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для сервера документооборота %1, сопоставленного учетной записи %2, не задан адрес электронной почты для целей обмена с ФНС!';
					|en = 'Email address for exchanging data with FTS is not specified for data interchange server %1 mapped to account %2.'"),
				Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.СерверДокументооборотаПредставление)+ Символ(34),
				Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			ПризнакОшибки = Истина;
		КонецЕсли;
		
		Если СвойстваУчетнойЗаписи.ПредназначенаДляДокументооборотаСПФР И ПустаяСтрока(СвойстваУчетнойЗаписи.СерверДокументооборотаАдресЭлектроннойПочтыПФР) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для сервера документооборота %1, сопоставленного учетной записи %2, не задан адрес электронной почты для целей обмена с ПФР!';
					|en = 'Email address for exchanging data with PF is not specified for data interchange server %1 mapped to account %2.'"),
				Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.СерверДокументооборотаПредставление)+ Символ(34),
				Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			ПризнакОшибки = Истина;
		КонецЕсли;
		
		Если СвойстваУчетнойЗаписи.ПредназначенаДляДокументооборотаСФСГС И ПустаяСтрока(СвойстваУчетнойЗаписи.СерверДокументооборотаАдресЭлектроннойПочтыФСГС) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для сервера документооборота %1, сопоставленного учетной записи %2, не задан адрес электронной почты для целей обмена с Росстатом!';
					|en = 'Email address for exchanging data with Federal State Statistics Service is not specified for data interchange server %1, which is mapped to account %2.'"),
				Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.СерверДокументооборотаПредставление)+ Символ(34),
				Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			ПризнакОшибки = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПустаяСтрока(СвойстваУчетнойЗаписи.СертификатРуководителя) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Для учетной записи %1 не задан сертификат руководителя!';
				|en = 'Manager certificate is not specified for account %1.'"),
			Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	Если ПустаяСтрока(СвойстваУчетнойЗаписи.СертификатДляШифрования) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Для учетной записи %1 не задан сертификат для целей шифрования!';
				|en = 'Encryption certificate is not specified for account %1.'"),
			Символ(34) + СокрЛП(СвойстваУчетнойЗаписи.Наименование) + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	Возврат (НЕ ПризнакОшибки);
	
КонецФункции

&НаСервереБезКонтекста
Процедура ОтправитьСообщенияПоУчетнойЗаписи(
	Знач УчетнаяЗапись,
	Знач ПочтовыйПрофиль = Неопределено,
	ТихийРежим = Ложь,
	ТребуетсяПроверкаУчетнойЗаписи = Ложь,
	ТребуетсяАвтонастройка = Истина) Экспорт
	
	Если УчетнаяЗапись = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не задана учетная запись для получения сообщений!';
								|en = 'Account for message receipt is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат;
	КонецЕсли;
		
	// ПФР
	Если ТипЗнч(УчетнаяЗапись) = Тип("СправочникСсылка.Организации") Тогда
		
		ссылкаУчетнаяЗапись = УчетнаяЗаписьОрганизации(УчетнаяЗапись);
		Если ссылкаУчетнаяЗапись.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для организации %1 не предусмотрена возможность использования встроенного механизма информационного взаимодействия с ФНС, ПФР и Росстатом по каналам связи.';
					|en = 'For company %1 possibility to use the integrated functionality of information interaction with FTS, PF and Russian Federal State Statistics Service via communication links is not available.'"),
				Символ(34) + ссылкаУчетнаяЗапись + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат;
		КонецЕсли;
		
		Организация = УчетнаяЗапись;
		УчетнаяЗапись = ссылкаУчетнаяЗапись;
		
	Иначе
		Организация = Неопределено;
	КонецЕсли;
		
	Если ТребуетсяПроверкаУчетнойЗаписи И НЕ УчетнаяЗаписьНастроенаВерно(УчетнаяЗапись) Тогда
		Возврат;
	КонецЕсли;
	
	КомпонентаПочтыСоздаетсяВПроцедуре = (ПочтовыйПрофиль = Неопределено);
	Если КомпонентаПочтыСоздаетсяВПроцедуре Тогда
		ПочтовыйПрофиль = ИнициализироватьСвойстваПочты(УчетнаяЗапись, , Истина);
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	                      |	ДокументТранспортноеСообщение.Ссылка
	                      |ИЗ
	                      |	Документ.ТранспортноеСообщение КАК ДокументТранспортноеСообщение
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ТранспортныеКонтейнеры КАК ТранспортныеКонтейнеры
	                      |		ПО (ТранспортныеКонтейнеры.ТранспортноеСообщение = ДокументТранспортноеСообщение.Ссылка)
	                      |ГДЕ
	                      |	ДокументТранспортноеСообщение.Статус = &Статус
	                      |	И ДокументТранспортноеСообщение.ПометкаУдаления = &ПометкаУдаления
	                      |	И ДокументТранспортноеСообщение.УчетнаяЗапись = &УчетнаяЗапись
	                      |	И ДокументТранспортноеСообщение.Тип В(&ТипыАвтоотправляемыхСообщений)
	                      |	И ДокументТранспортноеСообщение.ЦиклОбмена.ДатаЗакрытия = &ДатаЗакрытия
	                      |	И ДокументТранспортноеСообщение.ЦиклОбмена.ПометкаУдаления = &ПометкаУдаления
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ДокументТранспортноеСообщение.ЦиклОбмена.ДатаСоздания,
	                      |	ДокументТранспортноеСообщение.Тип.Порядок");
	
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыПисем.Исходящее);
	Запрос.УстановитьПараметр("ПометкаУдаления", Ложь);
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запрос.УстановитьПараметр("ДатаЗакрытия", ПолучитьПустуюДатуЗавершенияЦиклаОбмена());
	Запрос.УстановитьПараметр("ТипыАвтоотправляемыхСообщений", 
		ЭлектронныйДокументооборотСКонтролирующимиОрганами.ТипыАвтоотправляемыхСообщений());
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	КоличествоОтправленных = 0;
	КоличествоНеОтправленных = 0;

	// Создадим контекст ЭДО один раз до начала цикла обхода, чтобы не тратить время на каждом шаге.
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	
	Пока Выборка.Следующий() Цикл
		
		Если КонтекстЭДОСервер.ОтправитьТранспортноеСообщение(Выборка.Ссылка, ПочтовыйПрофиль, ТихийРежим) Тогда
			КоличествоОтправленных = КоличествоОтправленных + 1;
		Иначе
			КоличествоНеОтправленных = КоличествоНеОтправленных + 1;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВидЦиклаОбменаПоСообщению(Сообщение)
	
	Возврат Сообщение.ЦиклОбмена.Вид;
	
КонецФункции

&НаКлиенте
Процедура СформироватьПакет(ОповещениеОЗавершении, Сообщение, Оповещать = Ложь) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ВидЦиклаОбмена = ВидЦиклаОбменаПоСообщению(Сообщение);
	Если ВидЦиклаОбмена = СтруктураСсылочныхДанных.Перечисления_ВидыЦикловОбмена_ЦиклОбменаСПФР Тогда
		СформироватьПакетПФР(ОповещениеОЗавершении, Сообщение, Оповещать);
	ИначеЕсли ВидЦиклаОбмена = СтруктураСсылочныхДанных.Перечисления_ВидыЦикловОбмена_ЦиклОбменаСФСГС Тогда
		СформироватьПакетФСГС(ОповещениеОЗавершении, Сообщение, Оповещать);
	ИначеЕсли ВидЦиклаОбмена = СтруктураСсылочныхДанных.Перечисления_ВидыЦикловОбмена_ЦиклОбменаСФНС Тогда
		СформироватьПакетФНС(ОповещениеОЗавершении, Сообщение, Оповещать);
	ИначеЕсли ВидЦиклаОбмена = СтруктураСсылочныхДанных.Перечисления_ВидыЦикловОбмена_ЦиклОбменаССОС Тогда
		СформироватьПакетСОС(ОповещениеОЗавершении, Сообщение, Оповещать);
	Иначе
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСообщенияКШифрованию(УчетнаяЗапись)
	
	Результат = Новый Массив;
	
	Если ТипЗнч(УчетнаяЗапись) = Тип("СправочникСсылка.Организации") Тогда
		
		ссылкаУчетнаяЗапись = УчетнаяЗаписьОрганизации(УчетнаяЗапись);
		Если ссылкаУчетнаяЗапись.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для организации %1 не предусмотрена возможность использования встроенного механизма защищенного документооборота с ФНС, ПФР и Росстатом по каналам связи.';
					|en = 'For company %1 possibility to use the integrated functionality of protected data interchange with FTS, PF and Russian Federal State Statistics Service via communication links is not available.'"),
				Символ(34) + ссылкаУчетнаяЗапись + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		
		Организация = УчетнаяЗапись;
		УчетнаяЗапись = ссылкаУчетнаяЗапись;
		
	Иначе
		Организация = Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	                      |	ДокументТранспортноеСообщение.Ссылка,
	                      |	ДокументТранспортноеСообщение.Тип
	                      |ИЗ
	                      |	Документ.ТранспортноеСообщение КАК ДокументТранспортноеСообщение
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТранспортныеКонтейнеры КАК ТранспортныеКонтейнеры
	                      |		ПО (ТранспортныеКонтейнеры.ТранспортноеСообщение = ДокументТранспортноеСообщение.Ссылка)
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СодержимоеТранспортныхКонтейнеров КАК СодержимоеТранспортныхКонтейнеров
	                      |		ПО (СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение = ДокументТранспортноеСообщение.Ссылка)
	                      |ГДЕ
	                      |	ДокументТранспортноеСообщение.Статус = &Статус
	                      |	И ДокументТранспортноеСообщение.ПометкаУдаления = &ПометкаУдаления
	                      |	И ДокументТранспортноеСообщение.УчетнаяЗапись = &УчетнаяЗапись
	                      |	И ДокументТранспортноеСообщение.Тип В(&ТипыАвтоотправляемыхСообщений)
	                      |	И ДокументТранспортноеСообщение.ЦиклОбмена.ДатаЗакрытия = &ДатаЗакрытия
	                      |	И ДокументТранспортноеСообщение.ЦиклОбмена.ПометкаУдаления = &ПометкаУдаления
	                      |	И (ЕСТЬNULL(СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение, ИСТИНА) <> ИСТИНА ИЛИ ДокументТранспортноеСообщение.Тип В (&ТипыПринудительноОтправляемыеСообщения))
	                      |	И ЕСТЬNULL(ТранспортныеКонтейнеры.ТранспортноеСообщение, ИСТИНА) = ИСТИНА
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ДокументТранспортноеСообщение.ЦиклОбмена.ДатаСоздания,
	                      |	ДокументТранспортноеСообщение.Тип.Порядок");
	
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыПисем.Исходящее);
	Запрос.УстановитьПараметр("ПометкаУдаления", Ложь);
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запрос.УстановитьПараметр("ДатаЗакрытия", ПолучитьПустуюДатуЗавершенияЦиклаОбмена());
	Запрос.УстановитьПараметр("ТипыАвтоотправляемыхСообщений", 
		ЭлектронныйДокументооборотСКонтролирующимиОрганами.ТипыАвтоотправляемыхСообщений());
	
	// у протокола ПФР может не быть содержимого, но его все равно надо отправлять
	ПринудительноОтправляемыеСообщения = Новый Массив;
	ПринудительноОтправляемыеСообщения.Добавить(Перечисления.ТипыТранспортныхСообщений.ПротоколКвитанцияПФР);
	ПринудительноОтправляемыеСообщения.Добавить(Перечисления.ТипыТранспортныхСообщений.ОтветНаЗапросКвитанцияПФР);
	Запрос.УстановитьПараметр("ТипыПринудительноОтправляемыеСообщения", ПринудительноОтправляемыеСообщения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат ?(ЗначениеЗаполнено(Результат), Результат, Неопределено);
	
КонецФункции

&НаКлиенте
Процедура ЗашифроватьСообщенияПоУчетнойЗаписи(ВыполняемоеОповещение, Знач УчетнаяЗапись, ТихийРежим = Ложь) Экспорт
	
	Если УчетнаяЗапись = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не задана учетная запись для подготовки сообщений!';
								|en = 'Account for message preparation is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;
	
	СообщенияКШифрованию = ПолучитьСообщенияКШифрованию(УчетнаяЗапись);
	Если СообщенияКШифрованию = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;

	Контекст = Новый Структура;
	Контекст.Вставить("СообщенияКШифрованию", СообщенияКШифрованию);
	Контекст.Вставить("ТекущееСообщение", 0);
	Контекст.Вставить("КоличествоЗашифрованных", 0);
	Контекст.Вставить("КоличествоНеЗашифрованных", 0);
	Контекст.Вставить("ВыполняемоеОповещение", 		ВыполняемоеОповещение);
	
	ЗашифроватьСледующееСообщениеПоУчетнойЗаписи(Контекст);

КонецПроцедуры

&НаКлиенте
Процедура ЗашифроватьСледующееСообщениеПоУчетнойЗаписи(ВходящийКонтекст)
	
	Если ВходящийКонтекст.ТекущееСообщение < ВходящийКонтекст.СообщенияКШифрованию.Количество() Тогда
		
		СообщениеКШифрованию = ВходящийКонтекст.СообщенияКШифрованию[ВходящийКонтекст.ТекущееСообщение];
		
		Оповещение = Новый ОписаниеОповещения(
			"ЗашифроватьСледующееСообщениеПоУчетнойЗаписиПослеФормированияСообщения", 
			ЭтотОбъект, 
			ВходящийКонтекст);
			
		СформироватьПакет(Оповещение, СообщениеКШифрованию);
		
	Иначе
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗашифроватьСледующееСообщениеПоУчетнойЗаписиПослеФормированияСообщения(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Истина Тогда
		ВходящийКонтекст.КоличествоЗашифрованных = ВходящийКонтекст.КоличествоЗашифрованных + 1;
	Иначе
		ВходящийКонтекст.КоличествоНеЗашифрованных = ВходящийКонтекст.КоличествоНеЗашифрованных + 1;
	КонецЕсли;
	ВходящийКонтекст.ТекущееСообщение = ВходящийКонтекст.ТекущееСообщение + 1;
	ЗашифроватьСледующееСообщениеПоУчетнойЗаписи(ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсуществитьОбменПоУчетнойЗаписи(
		ВыполняемоеОповещение,
		парамУчетнаяЗапись,
		СписокПолученныхТС = Неопределено) Экспорт
		
	ТихийРежим = Ложь;
		
	// проверяем, включена ли возможность документооборота
	Если ТипЗнч(парамУчетнаяЗапись) = Тип("СправочникСсылка.Организации") Тогда
		ссылкаУчетнаяЗапись = УчетнаяЗаписьОрганизации(парамУчетнаяЗапись);
		Если НЕ ЗначениеЗаполнено(ссылкаУчетнаяЗапись) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для организации %1 не предусмотрена возможность информационного взаимодействия с ФНС, ПФР и Росстатом по каналам связи.';
					|en = 'For company %1 information interaction with FTS, PF, and Russian Federal State Statistics Service via communication links is not available.'"),
				Символ(34) + парамУчетнаяЗапись + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			ДлительнаяОтправкаКлиент.ОповеститьОНевозможностиОбновитьСтатусОтчета();
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
			Возврат;
		КонецЕсли;
		УчетнаяЗапись = ссылкаУчетнаяЗапись;
	Иначе
		УчетнаяЗапись = парамУчетнаяЗапись;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ОповеститьОСменеЭтапаОбмена(
		"АвтоматическаяНастройкаУчетнойЗаписи", 
		,
		, 
		УчетнаяЗапись);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("УчетнаяЗапись",         УчетнаяЗапись);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ТихийРежим",            ТихийРежим);
	ДополнительныеПараметры.Вставить("СписокПолученныхТС",    СписокПолученныхТС);

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОсуществитьОбменПоУчетнойЗаписиПослеАвтоматическойНастройкиЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);

	АвтоматическаяНастройкаУчетнойЗаписи(УчетнаяЗапись, ,ОписаниеОповещения, , , ТихийРежим);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсуществитьОбменПоУчетнойЗаписиПослеАвтоматическойНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	УчетнаяЗапись         = ДополнительныеПараметры.УчетнаяЗапись;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ТихийРежим            = ДополнительныеПараметры.ТихийРежим;
	СписокПолученныхТС    = ДополнительныеПараметры.СписокПолученныхТС;
	
	Если НЕ УчетнаяЗаписьНастроенаВерно(УчетнаяЗапись) Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНевозможностиОбновитьСтатусОтчета();
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	Иначе
		
		ДлительнаяОтправкаКлиент.ОповеститьОСменеЭтапаОбмена(
			"ПолучитьИРасшифроватьСообщенияПоУчетнойЗаписи", 
			,
			, 
			УчетнаяЗапись);
		
		// получаем сообщения
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ТихийРежим",            ТихийРежим);
		ДополнительныеПараметры.Вставить("УчетнаяЗапись",         УчетнаяЗапись);
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);

		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОсуществитьОбменПоУчетнойЗаписиЗавершение",
			ЭтотОбъект,
			ДополнительныеПараметры);
			
		ПолучитьИРасшифроватьСообщенияПоУчетнойЗаписи(
			ОписаниеОповещения,
			УчетнаяЗапись,
			,
			ТихийРежим,
			,
			Ложь,
			Ложь,
			СписокПолученныхТС);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсуществитьОбменПоУчетнойЗаписиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ТихийРежим = ДополнительныеПараметры.ТихийРежим;
	УчетнаяЗапись = ДополнительныеПараметры.УчетнаяЗапись;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОсуществитьОбменПоУчетнойЗаписиПослеШифрования", 
		ЭтотОбъект, 
		ДополнительныеПараметры); 
	
	// шифруем сообщения по учетной записи
	Если НЕ ТихийРежим Тогда
		
		ДлительнаяОтправкаКлиент.ОповеститьОСменеЭтапаОбмена(
			"ЗашифроватьСообщенияПоУчетнойЗаписи", 
			, 
			, 
			УчетнаяЗапись);
		
		ЗашифроватьСообщенияПоУчетнойЗаписи(ОписаниеОповещения, УчетнаяЗапись, ТихийРежим);
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсуществитьОбменПоУчетнойЗаписиПослеШифрования(Результат, ДополнительныеПараметры) Экспорт
	
	ТихийРежим 				= ДополнительныеПараметры.ТихийРежим;
	УчетнаяЗапись 			= ДополнительныеПараметры.УчетнаяЗапись;
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	
	ДлительнаяОтправкаКлиент.ОповеститьОСменеЭтапаОбмена(
		"ОтправитьСообщенияПоУчетнойЗаписи", 
		, 
		, 
		УчетнаяЗапись);
	
	// отправляем сообщения
	ОтправитьСообщенияПоУчетнойЗаписи(УчетнаяЗапись, , ТихийРежим, Ложь, Ложь);
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсуществитьОбменПоОрганизации(
		Форма,
		Организация,
		ВыполняемоеОповещение,
		КонтролирующийОрган = Неопределено,
		СсылкаНаОтправляемыйОбъект = Неопределено) Экспорт
	
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Организация",                Организация);
	ДополнительныеПараметры.Вставить("Форма",                      Форма);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",      ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("КонтролирующийОрган",        КонтролирующийОрган);
	ДополнительныеПараметры.Вставить("СсылкаНаОтправляемыйОбъект", СсылкаНаОтправляемыйОбъект);

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОсуществитьОбменПоОрганизацииФСС",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	Если ПользователюРазрешеноВыполнятьОбменПоУчетнойЗаписи(УчетнаяЗапись)
		И ЗначениеЗаполнено(УчетнаяЗапись) И 
		(КонтролирующийОрган = Неопределено 
		ИЛИ КонтролирующийОрган = "ФНС" 
		ИЛИ КонтролирующийОрган = "ПФР" 
		ИЛИ КонтролирующийОрган = "ФСГС") Тогда
		
		ОсуществитьОбменПоУчетнойЗаписи(
			ОписаниеОповещения,
			УчетнаяЗапись);
		
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсуществитьОбменПоОрганизацииФСС(Результат, ДополнительныеПараметры) Экспорт
	
	Организация 				= ДополнительныеПараметры.Организация;
	КонтролирующийОрган 		= ДополнительныеПараметры.КонтролирующийОрган;
	СсылкаНаОтправляемыйОбъект 	= ДополнительныеПараметры.СсылкаНаОтправляемыйОбъект;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОсуществитьОбменПоОрганизацииРПН", ЭтотОбъект, ДополнительныеПараметры);
	
	// ФСС
	Если КонтролирующийОрган = Неопределено ИЛИ КонтролирующийОрган = "ФСС" Тогда
		Если СсылкаНаОтправляемыйОбъект = Неопределено Тогда
			// Выполняем отправку для нескольких ссылок
			Отправки = НезавершенныеПоследниеОтправкиФССПоОрганизации(Организация);
		Иначе
			// Выполняем отправку только для одной ссылки 
			Отправки = Новый Массив;
			Отправка = ПолучитьПоследнююОтправкуОтчетаВФСС(СсылкаНаОтправляемыйОбъект);
			Если Отправка <> Неопределено Тогда 
				Отправки.Добавить(Отправка);
			КонецЕсли;
		КонецЕсли;
		
		Если Отправки = Неопределено Или Отправки.Количество() = 0 Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		Иначе
			ОбновитьРезультатНезавершенныхПоследнихОтправокФССПоОрганизации(Отправки, 0, ОписаниеОповещения);
		КонецЕсли;
	Иначе
		// После ФСС выполняем обмен по РПН
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатНезавершенныхПоследнихОтправокФССПоОрганизации(Отправки, НомерОбъекта, ВыполняемоеОповещение)

	Если НомерОбъекта + 1 > Отправки.Количество() Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	Иначе
		Отправка = Отправки[НомерОбъекта];
		
		ДлительнаяОтправкаКлиент.ОповеститьОСменеЭтапаОбмена(
			"ОсуществитьОбменПоОрганизацииФСС", 
			ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФСС"), 
			Отправка);
			
		ДополнительныеПараметры = Новый Структура("Отправки, НомерОбъекта, ВыполняемоеОповещение", Отправки, НомерОбъекта, ВыполняемоеОповещение);
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьРезультатНезавершенныхПоследнихОтправокФССПоОрганизацииЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		Если ЗначениеЗаполнено(Отправка) Тогда
			ОбновитьРезультатКонкретнойОтправкиФСС(Отправка, Истина, ОписаниеОповещения);
		Иначе
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатНезавершенныхПоследнихОтправокФССПоОрганизацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Отправки = ДополнительныеПараметры.Отправки;
	НомерОбъекта = ДополнительныеПараметры.НомерОбъекта;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	ОбновитьРезультатНезавершенныхПоследнихОтправокФССПоОрганизации(Отправки, НомерОбъекта + 1, ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсуществитьОбменПоОрганизацииФСРАР(Результат, ДополнительныеПараметры) Экспорт
	
	Форма 						= ДополнительныеПараметры.Форма;
	Организация 				= ДополнительныеПараметры.Организация;
	ВыполняемоеОповещение 		= ДополнительныеПараметры.ВыполняемоеОповещение;
	КонтролирующийОрган 		= ДополнительныеПараметры.КонтролирующийОрган;
	СсылкаНаОтправляемыйОбъект 	= ДополнительныеПараметры.СсылкаНаОтправляемыйОбъект;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОсуществитьОбменПоОрганизацииБанкРоссии", ЭтотОбъект, ДополнительныеПараметры);
	
	// ФСРАР
	Если КонтролирующийОрган = Неопределено ИЛИ КонтролирующийОрган = "ФСРАР" Тогда
		Если СсылкаНаОтправляемыйОбъект = Неопределено Тогда
			// Выполняем отправку для нескольких ссылок
			Отправки = НезавершенныеПоследниеОтправкиФСРАРПоОрганизации(Организация);
		Иначе
			// Выполняем отправку только для одной ссылки 
			Отправки = Новый Массив;
			Отправка = ПолучитьПоследнююОтправкуОтчетаВФСРАР(СсылкаНаОтправляемыйОбъект);
			Если Отправка <> Неопределено Тогда 
				Отправки.Добавить(Отправка);
			КонецЕсли;
		КонецЕсли;
		
		Если Отправки = Неопределено Или Отправки.Количество() = 0 Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		Иначе
			ЭтоВызовИзСписка = (СсылкаНаОтправляемыйОбъект = Неопределено);
			ОбновитьРезультатНезавершенныхПоследнихОтправокФСРАРПоОрганизации(Форма, Отправки, 0, ЭтоВызовИзСписка, ОписаниеОповещения);
		КонецЕсли;
	Иначе
		// После ФСРАР возвращаемся в самое первое место вызова функции отправки 
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;

КонецПроцедуры

