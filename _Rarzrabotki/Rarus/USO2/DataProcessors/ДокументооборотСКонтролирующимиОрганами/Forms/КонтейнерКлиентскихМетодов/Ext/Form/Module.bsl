&НаСервереБезКонтекста
Функция ПолучитьСвойстваОтделенийПФРИзИБ(КодыОтделенийПФР)
	
	// создаем массив-результат
	СведенияОбОтделениях = Новый Массив;
	
	// получаем из ИБ
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ОрганыПФР.Код,
	                      |	ОрганыПФР.Наименование,
	                      |	ОрганыПФР.Сертификаты.(
	                      |		Сертификат
	                      |	)
	                      |ИЗ
	                      |	Справочник.ОрганыПФР КАК ОрганыПФР
	                      |ГДЕ
	                      |	ОрганыПФР.Код В(&Код)");
	Запрос.УстановитьПараметр("Код", КодыОтделенийПФР);
	Выборка = Запрос.Выполнить().Выбрать();
	
	// формируем результат
	Пока Выборка.Следующий() Цикл
		
		СертификатыОрганаПФР = Новый Массив;
		ВыборкаСертификаты = Выборка.Сертификаты.Выбрать();
		Пока ВыборкаСертификаты.Следующий() Цикл
			СертификатыОрганаПФР.Добавить(СокрЛП(ВыборкаСертификаты.Сертификат));
		КонецЦикла;
		СведенияОбОтделениях.Добавить(Новый Структура("Код, Наименование, Сертификаты",
														СокрЛП(Выборка.Код), СокрЛП(Выборка.Наименование), СертификатыОрганаПФР));
	КонецЦикла;
	
	Возврат СведенияОбОтделениях;
	
КонецФункции

&НаКлиенте
Процедура ПолучитьТаблицуНеобходимыхИсправлений(НастройкиИБ, НастройкиРОКИ, ВыполняемоеОповещение)
	
	Исправления = Новый Массив;
	
	Если НастройкиИБ.ПредназначенаДляДокументооборотаСФНС <> НастройкиРОКИ.ПредназначенаДляДокументооборотаСФНС Тогда
		ОпределитьИзменение(Исправления, "ИзменитьПризнакДокументооборотаСФНС", НастройкиИБ.ПредназначенаДляДокументооборотаСФНС, НастройкиРОКИ.ПредназначенаДляДокументооборотаСФНС, "Изменен признак возможности документооборота с ФНС по учетной записи");
	КонецЕсли;
	
	Если НастройкиИБ.ПредназначенаДляДокументооборотаСПФР <> НастройкиРОКИ.ПредназначенаДляДокументооборотаСПФР Тогда
		ОпределитьИзменение(Исправления, "ИзменитьПризнакДокументооборотаСПФР", НастройкиИБ.ПредназначенаДляДокументооборотаСПФР, НастройкиРОКИ.ПредназначенаДляДокументооборотаСПФР, "Изменен признак возможности документооборота с ПФР по учетной записи");
	КонецЕсли;
	
	Если НастройкиИБ.ПредназначенаДляДокументооборотаСФСГС <> НастройкиРОКИ.ПредназначенаДляДокументооборотаСФСГС Тогда
		ОпределитьИзменение(Исправления, "ИзменитьПризнакДокументооборотаСФСГС", НастройкиИБ.ПредназначенаДляДокументооборотаСФСГС, НастройкиРОКИ.ПредназначенаДляДокументооборотаСФСГС, "Изменен признак возможности документооборота с Росстатом по учетной записи");
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("АдресЭлектроннойПочты") Тогда
		Если нрег(НастройкиИБ.АдресЭлектроннойПочты) <> нрег(НастройкиРОКИ.АдресЭлектроннойПочты) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьАдресЭлектроннойПочты", НастройкиИБ.АдресЭлектроннойПочты, НастройкиРОКИ.АдресЭлектроннойПочты, "В настройках учетной записи изменен адрес электронной почты");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ИдентификаторАбонента") Тогда
		Если СокрЛП(НастройкиИБ.ИдентификаторАбонента) <> СокрЛП(НастройкиРОКИ.ИдентификаторАбонента) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьИдентификаторАбонента", НастройкиИБ.ИдентификаторАбонента, НастройкиРОКИ.ИдентификаторАбонента, "В настройках учетной записи изменен идентификатор абонента");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ИдентификаторСпецоператора") Тогда
		Если СокрЛП(НастройкиИБ.ИдентификаторСпецоператора) <> СокрЛП(НастройкиРОКИ.ИдентификаторСпецоператора) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьИдентификаторСпецоператора", НастройкиИБ.ИдентификаторСпецоператора, НастройкиРОКИ.ИдентификаторСпецоператора, "В настройках учетной записи изменен идентификатор оператора электронного документооборота");
		КонецЕсли;
	КонецЕсли;
	
	// свойства сервера документооборота
	Если НастройкиРОКИ.Свойство("АдресСпецоператора") Тогда
		Если нрег(НастройкиИБ.АдресЭлектроннойПочтыПочтовогоСервера) <> нрег(НастройкиРОКИ.АдресСпецоператора) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьАдресПочтовогоСервера", НастройкиИБ.АдресЭлектроннойПочтыПочтовогоСервера, НастройкиРОКИ.АдресСпецоператора, "В настройках сервера документооборота изменен адрес электронной почты для документооборота с ФНС");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("АдресСпецоператораПФР") Тогда
		Если нрег(НастройкиИБ.АдресЭлектроннойПочтыПочтовогоСервераПФР) <> нрег(НастройкиРОКИ.АдресСпецоператораПФР) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьАдресПочтовогоСервераПФР", НастройкиИБ.АдресЭлектроннойПочтыПочтовогоСервераПФР, НастройкиРОКИ.АдресСпецоператораПФР, "В настройках сервера документооборота изменен адрес электронной почты для документооборота с ПФР");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("АдресСпецоператораФСГС") Тогда
		Если нрег(НастройкиИБ.АдресЭлектроннойПочтыПочтовогоСервераФСГС) <> нрег(НастройкиРОКИ.АдресСпецоператораФСГС) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьАдресПочтовогоСервераФСГС", НастройкиИБ.АдресЭлектроннойПочтыПочтовогоСервераФСГС, НастройкиРОКИ.АдресСпецоператораФСГС, "В настройках сервера документооборота изменен адрес электронной почты для документооборота с Росстатом");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("СертификатСОС") Тогда
		Если нрег(НастройкиИБ.СертификатПочтовогоСервера) <> нрег(НастройкиРОКИ.СертификатСОС.Отпечаток) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьСертификатПочтовогоСервера", нрег(НастройкиИБ.СертификатПочтовогоСервера), НастройкиРОКИ.СертификатСОС, "В настройках сервера документооборота изменен сертификат");
		КонецЕсли;
	КонецЕсли;
	
	// настройки доступа по POP3
	Если НастройкиРОКИ.Свойство("СерверPOP3") Тогда
		Если нрег(НастройкиИБ.СерверPOP3) <> нрег(НастройкиРОКИ.СерверPOP3) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьСерверPOP3", НастройкиИБ.СерверPOP3, НастройкиРОКИ.СерверPOP3, "В настройках учетной записи изменен адрес сервера POP3");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ПортPOP3") Тогда
		Если нрег(НастройкиИБ.ПортPOP3) <> нрег(НастройкиРОКИ.ПортPOP3) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьПортPOP3", НастройкиИБ.ПортPOP3, НастройкиРОКИ.ПортPOP3, "В настройках учетной записи изменен порт сервера POP3");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ИмяПользователяPOP3") Тогда
		Если нрег(НастройкиИБ.ИмяПользователяPOP3) <> нрег(НастройкиРОКИ.ИмяПользователяPOP3) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьИмяПользователяPOP3", НастройкиИБ.ИмяПользователяPOP3, НастройкиРОКИ.ИмяПользователяPOP3, "В настройках учетной записи изменено имя пользователя POP3");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ПарольPOP3") Тогда
		Если нрег(НастройкиИБ.ПарольPOP3) <> нрег(НастройкиРОКИ.ПарольPOP3) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьПарольPOP3", НастройкиИБ.ПарольPOP3, НастройкиРОКИ.ПарольPOP3, "В настройках учетной записи изменен пароль POP3");
		КонецЕсли;
	КонецЕсли;
	
	// настройки доступа по SMTP
	Если НастройкиРОКИ.Свойство("СерверSMTP") Тогда
		Если нрег(НастройкиИБ.СерверSMTP) <> нрег(НастройкиРОКИ.СерверSMTP) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьСерверSMTP", НастройкиИБ.СерверSMTP, НастройкиРОКИ.СерверSMTP, "В настройках учетной записи изменен адрес сервера SMTP");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ПортSMTP") Тогда
		Если нрег(НастройкиИБ.ПортSMTP) <> нрег(НастройкиРОКИ.ПортSMTP) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьПортSMTP", НастройкиИБ.ПортSMTP, НастройкиРОКИ.ПортSMTP, "В настройках учетной записи изменен порт сервера SMTP");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиИБ.ТребуетсяSMTPАутентификация Тогда // считается, что аутентификация на сервере SMTP не требуется никогда
		ОпределитьИзменение(Исправления, "ИзменитьФлагТребуетсяSMTPАутентификация", Истина, Ложь, "В настройках учетной записи изменен признак необходимости аутентификации на сервере SMTP");
	КонецЕсли;
	
	// проверяем необходимость обновления информации о сертификатах ответственных лиц организации
	Если НастройкиРОКИ.Свойство("Сертификаты") И ТипЗнч(НастройкиРОКИ.Сертификаты) = Тип("Массив") Тогда
		
		АбонентскиеСертификаты = НастройкиРОКИ.Сертификаты;
		
		// проверяем сертификат руководителя
		Если НЕ ЗначениеЗаполнено(НастройкиИБ.СертификатРуководителя) Тогда
			
			// сначала ищем сертификат руководителя
			СертификатыРуководителя = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 1);
			
			// если не найден - сертификат ответственного за шифрование
			Если СертификатыРуководителя.Количество() = 0 Тогда
				СертификатыРуководителя = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 3);
			КонецЕсли;
			
			// если сертификат ответственного не найден, то ищем сертификат главного бухгалтера
			Если СертификатыРуководителя.Количество() = 0 Тогда
				СертификатыРуководителя = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 2);
			КонецЕсли;
			
			// если и сертификат главного бухгалтера не найден, то берем первый в списке
			Если СертификатыРуководителя.Количество() = 0 Тогда
				Если АбонентскиеСертификаты.Количество() > 0 Тогда
					СертификатыРуководителя = Новый Массив;
					СертификатыРуководителя.Добавить(АбонентскиеСертификаты[0]);
				КонецЕсли;
			КонецЕсли;
			
			Если СертификатыРуководителя.Количество() > 0 Тогда
				ОпределитьИзменение(Исправления,
									"ИзменитьСертификатРуководителя",
									нрег(НастройкиИБ.СертификатРуководителя),
									СертификатыРуководителя[0], 
									"В настройках учетной записи изменен сертификат руководителя");
			КонецЕсли;
			
		Иначе
			СертификатИБВСписке = Ложь;
			
			// сначала ищем сертификат руководителя
			СертификатыРуководителя = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 1);
			
			// если не найден - сертификат ответственного за шифрование
			Если СертификатыРуководителя.Количество() = 0 Тогда
				СертификатыРуководителя = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 3);
			КонецЕсли;
			
			// если сертификат ответственного не найден, то ищем сертификат главного бухгалтера
			Если СертификатыРуководителя.Количество() = 0 Тогда
				СертификатыРуководителя = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 2);
			КонецЕсли;
			
			// если и сертификат главного бухгалтера не найден, то берем первый в списке
			Если СертификатыРуководителя.Количество() = 0 Тогда
				Если АбонентскиеСертификаты.Количество() > 0 Тогда
					СертификатыРуководителя = Новый Массив;
					СертификатыРуководителя.Добавить(АбонентскиеСертификаты[0]);
				КонецЕсли;
			КонецЕсли;
			
			Для Каждого СертификатРуководителя Из СертификатыРуководителя Цикл
				Если нрег(СертификатРуководителя.Отпечаток) = нрег(НастройкиИБ.СертификатРуководителя) Тогда
					СертификатИБВСписке = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ СертификатИБВСписке Тогда
				Если СертификатыРуководителя.Количество() = 0 Тогда
					НовоеЗначение = Новый Структура("Отпечаток");
				Иначе
					НовоеЗначение = СертификатыРуководителя[0];
				КонецЕсли;
				ОпределитьИзменение(Исправления, "ИзменитьСертификатРуководителя", нрег(НастройкиИБ.СертификатРуководителя), НовоеЗначение, "В настройках учетной записи изменен сертификат руководителя");
			КонецЕсли;
			
		КонецЕсли;
		
		// проверяем сертификат главного бухгалтера
		Если НЕ ЗначениеЗаполнено(НастройкиИБ.СертификатГлавногоБухгалтера) Тогда
			СертификатыБухгалтера = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 2);
			Если СертификатыБухгалтера.Количество() > 0 Тогда
				ОпределитьИзменение(Исправления,
									"ИзменитьСертификатГлавногоБухгалтера",
									нрег(НастройкиИБ.СертификатГлавногоБухгалтера),
									СертификатыБухгалтера[0],
									"В настройках учетной записи изменен сертификат главного бухгалтера");
			КонецЕсли;
		Иначе
			СертификатИБВСписке = Ложь;
			СертификатыБухгалтера = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 2);
			Для Каждого СертификатБухгалтера Из СертификатыБухгалтера Цикл
				Если нрег(СертификатБухгалтера.Отпечаток) = нрег(НастройкиИБ.СертификатГлавногоБухгалтера) Тогда
					СертификатИБВСписке = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ СертификатИБВСписке Тогда
				Если СертификатыБухгалтера.Количество() = 0 Тогда
					НовоеЗначение = Новый Структура("Отпечаток");
				Иначе
					НовоеЗначение = СертификатыБухгалтера[0];
				КонецЕсли;
				ОпределитьИзменение(Исправления, "ИзменитьСертификатГлавногоБухгалтера", нрег(НастройкиИБ.СертификатГлавногоБухгалтера), НовоеЗначение, "В настройках учетной записи изменен сертификат главного бухгалтера");
			КонецЕсли;
		КонецЕсли;
		
		// проверяем сертификат ответственного за шифрование
		Если НЕ ЗначениеЗаполнено(НастройкиИБ.СертификатДляШифрования) Тогда
			СертификатыДляШифрования = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ПризнакШифрования", Истина);
			Если СертификатыДляШифрования.Количество() = 0 Тогда
				СертификатыДляШифрования = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 3);
			КонецЕсли;
			Если СертификатыДляШифрования.Количество() > 0 Тогда
				ОпределитьИзменение(Исправления, "ИзменитьСертификатДляШифрования", нрег(НастройкиИБ.СертификатДляШифрования), СертификатыДляШифрования[0], "В настройках учетной записи изменен сертификат для шифрования");
			КонецЕсли;
		Иначе
			СертификатИБВСписке = Ложь;
			СертификатыДляШифрования = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ПризнакШифрования", Истина);
			Если СертификатыДляШифрования.Количество() = 0 Тогда
				СертификатыДляШифрования = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 3);
			КонецЕсли;
			Для Каждого СертификатДляШифрования Из СертификатыДляШифрования Цикл
				Если нрег(СертификатДляШифрования.Отпечаток) = нрег(НастройкиИБ.СертификатДляШифрования) Тогда
					СертификатИБВСписке = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ СертификатИБВСписке Тогда
				ОпределитьИзменение(Исправления, "ИзменитьСертификатДляШифрования", нрег(НастройкиИБ.СертификатДляШифрования), СертификатыДляШифрования[0], "В настройках учетной записи изменен сертификат для шифрования");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	// проверка ИФНС
	ПроверкаИФНС = НастройкиРОКИ.Свойство("ИФНСы") И ТипЗнч(НастройкиРОКИ.ИФНСы) = Тип("Массив");
	Если ПроверкаИФНС Тогда
		
		// проверка основной ИФНС
		ИФНСы = НастройкиРОКИ.ИФНСы;
		Если ИФНСы.Количество() = 1 Тогда
			ОсновнаяИФНС = ИФНСы[0];
		Иначе
			ОсновнаяИФНС = НайтиСтрокуВМассивеСтруктурКлиент(ИФНСы, Истина,"ИФНСПоУмолчанию");
		КонецЕсли;
		Если НастройкиИБ.КодНалоговогоОргана <> ОсновнаяИФНС.Код Тогда
			ОпределитьИзменение(Исправления, "ИзменитьОсновнуюИФНС", нрег(НастройкиИБ.КодНалоговогоОргана), ОсновнаяИФНС, "В настройках учетной записи изменен налоговый орган");
		КонецЕсли;
		
		// формируем массив кодов ИФНС, задействованных по данным РОКИ
		МассивКодовИФНС = ВыгрузитьКолонкуИзМассиваСтруктур(ИФНСы, "Код");
		
		// получаем из базы информацию об этих отделениях ПФР
		СведенияИзИБ = ПолучитьСвойстваИФНСИзИБ(МассивКодовИФНС);
		
		// создание кэша зарегистрированных в хранилище сертификатов
		
		ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, НастройкиИБ, НастройкиРОКИ, Исправления, ПроверкаИФНС, ИФНСы, ОсновнаяИФНС, СведенияИзИБ", ВыполняемоеОповещение, НастройкиИБ, НастройкиРОКИ, Исправления, ПроверкаИФНС, ИФНСы, ОсновнаяИФНС, СведенияИзИБ);
		Оповещение = Новый ОписаниеОповещения("ПолучитьТаблицуНеобходимыхИсправленийПослеПолученияСертификатовAddressBookЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ДополнительныеПараметрыМетода = Новый Структура;
		ДополнительныеПараметрыМетода.Вставить("ПредлагатьУстановкуВнешнейКомпоненты", Ложь);
		ДополнительныеПараметрыМетода.Вставить("ВыводитьСообщения", Ложь);
		
		КриптографияЭДКОКлиент.ПолучитьСертификаты(
			Оповещение, Новый Структура("Хранилище,ЭтоЛокальноеХранилище", "AddressBook", Истина), ДополнительныеПараметрыМетода);
		Возврат;
		
	КонецЕсли;
	
	Результат = Новый Структура("Выполнено, МенеджерКриптографии", Ложь, Неопределено);
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, НастройкиИБ, НастройкиРОКИ, Исправления, ПроверкаИФНС, ИФНСы, ОсновнаяИФНС, СведенияИзИБ, МассивСертификатовAddressBook, МассивСертификатовCA", ВыполняемоеОповещение, НастройкиИБ, НастройкиРОКИ, Исправления, ПроверкаИФНС, ИФНСы, ОсновнаяИФНС, СведенияИзИБ, Неопределено, Неопределено);
	Оповещение = Новый ОписаниеОповещения("ПолучитьТаблицуНеобходимыхИсправленийПослеПолученияСертификатовROOTЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ВыполнитьОбработкуОповещения(Оповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьТаблицуНеобходимыхИсправленийПослеПолученияСертификатовAddressBookЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	НастройкиИБ = ДополнительныеПараметры.НастройкиИБ;
	НастройкиРОКИ = ДополнительныеПараметры.НастройкиРОКИ;
	Исправления = ДополнительныеПараметры.Исправления;
	ПроверкаИФНС = ДополнительныеПараметры.ПроверкаИФНС;
	ИФНСы = ДополнительныеПараметры.ИФНСы;
	ОсновнаяИФНС = ДополнительныеПараметры.ОсновнаяИФНС;
	СведенияИзИБ = ДополнительныеПараметры.СведенияИзИБ;
	
	МассивСертификатовAddressBook = Новый Массив;
	Если Результат.Выполнено Тогда
		Для каждого СертификатХранилища Из Результат.Сертификаты Цикл
			МассивСертификатовAddressBook.Добавить(нрег(СокрЛП(СертификатХранилища.Отпечаток)));
		КонецЦикла;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, НастройкиИБ, НастройкиРОКИ, Исправления, ПроверкаИФНС, ИФНСы, ОсновнаяИФНС, СведенияИзИБ, МассивСертификатовAddressBook", ВыполняемоеОповещение, НастройкиИБ, НастройкиРОКИ, Исправления, ПроверкаИФНС, ИФНСы, ОсновнаяИФНС, СведенияИзИБ, МассивСертификатовAddressBook);
	Оповещение = Новый ОписаниеОповещения("ПолучитьТаблицуНеобходимыхИсправленийПослеПолученияСертификатовCAЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ДополнительныеПараметрыМетода = Новый Структура;
	ДополнительныеПараметрыМетода.Вставить("ПредлагатьУстановкуВнешнейКомпоненты", Ложь);
	ДополнительныеПараметрыМетода.Вставить("ВыводитьСообщения", Ложь);
	
	КриптографияЭДКОКлиент.ПолучитьСертификаты(
		Оповещение, Новый Структура("Хранилище,ЭтоЛокальноеХранилище", "CA", Истина), ДополнительныеПараметрыМетода);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьТаблицуНеобходимыхИсправленийПослеПолученияСертификатовCAЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	НастройкиИБ = ДополнительныеПараметры.НастройкиИБ;
	НастройкиРОКИ = ДополнительныеПараметры.НастройкиРОКИ;
	Исправления = ДополнительныеПараметры.Исправления;
	ПроверкаИФНС = ДополнительныеПараметры.ПроверкаИФНС;
	ИФНСы = ДополнительныеПараметры.ИФНСы;
	ОсновнаяИФНС = ДополнительныеПараметры.ОсновнаяИФНС;
	СведенияИзИБ = ДополнительныеПараметры.СведенияИзИБ;
	МассивСертификатовAddressBook = ДополнительныеПараметры.МассивСертификатовAddressBook;
	
	МассивСертификатовCA = Новый Массив;
	Если Результат.Выполнено Тогда
		Для каждого СертификатХранилища Из Результат.Сертификаты Цикл
			МассивСертификатовCA.Добавить(нрег(СокрЛП(СертификатХранилища.Отпечаток)));
		КонецЦикла;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, НастройкиИБ, НастройкиРОКИ, Исправления, ПроверкаИФНС, ИФНСы, ОсновнаяИФНС, СведенияИзИБ, МассивСертификатовAddressBook, МассивСертификатовCA", ВыполняемоеОповещение, НастройкиИБ, НастройкиРОКИ, Исправления, ПроверкаИФНС, ИФНСы, ОсновнаяИФНС, СведенияИзИБ, МассивСертификатовAddressBook, МассивСертификатовCA);
	Оповещение = Новый ОписаниеОповещения("ПолучитьТаблицуНеобходимыхИсправленийПослеПолученияСертификатовROOTЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ДополнительныеПараметрыМетода = Новый Структура;
	ДополнительныеПараметрыМетода.Вставить("ПредлагатьУстановкуВнешнейКомпоненты", Ложь);
	ДополнительныеПараметрыМетода.Вставить("ВыводитьСообщения", Ложь);
	
	КриптографияЭДКОКлиент.ПолучитьСертификаты(
		Оповещение, Новый Структура("Хранилище,ЭтоЛокальноеХранилище", "ROOT", Истина), ДополнительныеПараметрыМетода);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьТаблицуНеобходимыхИсправленийПослеПолученияСертификатовROOTЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	НастройкиИБ = ДополнительныеПараметры.НастройкиИБ;
	НастройкиРОКИ = ДополнительныеПараметры.НастройкиРОКИ;
	Исправления = ДополнительныеПараметры.Исправления;
	ПроверкаИФНС = ДополнительныеПараметры.ПроверкаИФНС;
	ИФНСы = ДополнительныеПараметры.ИФНСы;
	ОсновнаяИФНС = ДополнительныеПараметры.ОсновнаяИФНС;
	СведенияИзИБ = ДополнительныеПараметры.СведенияИзИБ;
	МассивСертификатовAddressBook = ДополнительныеПараметры.МассивСертификатовAddressBook;
	МассивСертификатовCA = ДополнительныеПараметры.МассивСертификатовCA;
	
	Если ПроверкаИФНС Тогда
		
		МассивСертификатовROOT = Новый Массив;
		Если Результат.Выполнено Тогда
			Для каждого СертификатХранилища Из Результат.Сертификаты Цикл
				МассивСертификатовROOT.Добавить(нрег(СокрЛП(СертификатХранилища.Отпечаток)));
			КонецЦикла;
		КонецЕсли;
		
		// проверка всех ИФНС
		Для Каждого СтрИФНС Из ИФНСы Цикл
		
			// ищем ИФНС по коду
			КодИФНС = СокрЛП(СтрИФНС.Код);
			ЗаписьИФНС = НайтиСтрокуВМассивеСтруктурКлиент(СведенияИзИБ, КодИФНС, "Код");
			Если ЗаписьИФНС = Неопределено Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьИФНС", , КодИФНС, "Налоговый орган с кодом " + КодИФНС + " не определен в информационной базе", СтрИФНС.Наименование);
			КонецЕсли;
			
			// проверяем на необходимость изменения списка сертификатов инспекции ФНС в ИБ
			СертификатыИФНСсРОКИ = ВыгрузитьКолонкуИзМассиваСтруктур(СтрИФНС.Сертификаты, "Отпечаток");
			СертификатыИФНСИзИБ = ?(ЗаписьИФНС = Неопределено, Неопределено, ЗаписьИФНС.Сертификаты);
			Если НЕ СравнитьМассивыБезУчетаПорядкаЭлементов(СертификатыИФНСсРОКИ, СертификатыИФНСИзИБ) Тогда
				ОпределитьИзменение(Исправления, "ИзменитьСертификатИФНС", СертификатыИФНСИзИБ, СтрИФНС.Сертификаты, "Сертификат налогового органа с кодом " + КодИФНС + " изменен", КодИФНС);
			КонецЕсли;
			
			// проверяем на необходимость добавления сертификатов ИФНС в список в ИБ и регистрации в системе
			Для Каждого СтрСертификатИФНС Из СтрИФНС.Сертификаты Цикл
				
				// проверяем на необходимость регистрации в системе
				Если НЕ СертификатЗарегистрированВХранилище(СтрСертификатИФНС.Отпечаток, "AddressBook", МассивСертификатовAddressBook) Тогда
					ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатНалоговогоОргана", , СтрСертификатИФНС, "Сертификат налогового органа с кодом " + КодИФНС + " не зарегистрирован в системе", КодИФНС);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	
	// проверка отделений ПФР
	ОтделенияПФР = Неопределено;
	Если НастройкиРОКИ.Свойство("ОтделенияПФР", ОтделенияПФР) Тогда
		
		// формируем массив кодов отделений ПФР, задействованных по данным РОКИ
		МассивКодовОтделенийПФР = ВыгрузитьКолонкуИзМассиваСтруктур(ОтделенияПФР, "Код");
		
		// получаем из базы информацию об этих отделениях ПФР
		СведенияИзИБ = ПолучитьСвойстваОтделенийПФРИзИБ(МассивКодовОтделенийПФР);
		
		// перебираем отделения ПФР с РОКИ и определяем необходимость создания записи в справочнике отделений ПФР,
		// обновления списка сертификатов и регистрации их в системе
		Для Каждого СтрОтделениеПФР Из ОтделенияПФР Цикл
			
			// ищем отделение ПФР по коду
			КодОрганаПФР = СокрЛП(СтрОтделениеПФР.Код);
			ЗаписьОрганПФР = НайтиСтрокуВМассивеСтруктурКлиент(СведенияИзИБ, КодОрганаПФР, "Код");
			Если ЗаписьОрганПФР = Неопределено Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьОрганПФР", , КодОрганаПФР, "Орган ПФР с кодом " + КодОрганаПФР + " не определен в информационной базе", СтрОтделениеПФР.Наименование);
			КонецЕсли;
			
			// проверяем на необходимость изменения списка сертификатов органа ПФР в ИБ
			СертификатыОрганаПФРсРОКИ = ВыгрузитьКолонкуИзМассиваСтруктур(СтрОтделениеПФР.Сертификаты, "Отпечаток");
			СертификатыОрганаПФРИзИБ = ?(ЗаписьОрганПФР = Неопределено, Неопределено, ЗаписьОрганПФР.Сертификаты);
			Если НЕ СравнитьМассивыБезУчетаПорядкаЭлементов(СертификатыОрганаПФРсРОКИ, СертификатыОрганаПФРИзИБ) Тогда
				ОпределитьИзменение(Исправления, "ИзменитьСертификатОрганаПФР", СертификатыОрганаПФРИзИБ, СтрОтделениеПФР.Сертификаты, "Сертификат органа ПФР с кодом " + КодОрганаПФР + " изменен", КодОрганаПФР);
			КонецЕсли;
			
			// проверяем на необходимость добавления сертификатов отделения ПФР в список в ИБ и регистрации в системе
			Для Каждого СтрСертификатОтделения Из СтрОтделениеПФР.Сертификаты Цикл
				
				// проверяем на необходимость регистрации в системе
				Если НЕ СертификатЗарегистрированВХранилище(СтрСертификатОтделения.Отпечаток, "AddressBook", МассивСертификатовAddressBook) Тогда
					ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатОрганаПФР", , СтрСертификатОтделения, "Сертификат органа ПФР с кодом " + КодОрганаПФР + " не зарегистрирован в системе", КодОрганаПФР);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// проверка отделений ФСГС
	ОтделенияФСГС = Неопределено;
	Если НастройкиРОКИ.Свойство("ОтделенияФСГС", ОтделенияФСГС) Тогда
		
		// формируем массив кодов отделений ФСГС, задействованных по данным РОКИ
		МассивКодовОтделенийФСГС = ВыгрузитьКолонкуИзМассиваСтруктур(ОтделенияФСГС, "Код");
		
		// получаем из базы информацию об этих отделениях ФСГС
		СведенияИзИБ = ПолучитьСвойстваОтделенийФСГСИзИБ(МассивКодовОтделенийФСГС);
		
		// перебираем отделения ФСГС с РОКИ и определяем необходимость создания записи в справочнике отделений ФСГС,
		// обновления списка сертификатов и регистрации их в системе
		Для Каждого СтрОтделениеФСГС Из ОтделенияФСГС Цикл
			
			// ищем отделение ФСГС по коду
			КодОрганаФСГС = СокрЛП(СтрОтделениеФСГС.Код);
			ЗаписьОрганФСГС = НайтиСтрокуВМассивеСтруктурКлиент(СведенияИзИБ, КодОрганаФСГС, "Код");
			Если ЗаписьОрганФСГС = Неопределено Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьОрганФСГС", , КодОрганаФСГС, "Орган ФСГС с кодом " + КодОрганаФСГС + " не определен в информационной базе", СтрОтделениеФСГС.Наименование);
			КонецЕсли;
			
			// проверяем на необходимость изменения списка сертификатов органа ФСГС в ИБ
			СертификатыОрганаФСГСсРОКИ = ВыгрузитьКолонкуИзМассиваСтруктур(СтрОтделениеФСГС.Сертификаты, "Отпечаток");
			СертификатыОрганаФСГСИзИБ = ?(ЗаписьОрганФСГС = Неопределено, Неопределено, ЗаписьОрганФСГС.Сертификаты);
			Если НЕ СравнитьМассивыБезУчетаПорядкаЭлементов(СертификатыОрганаФСГСсРОКИ, СертификатыОрганаФСГСИзИБ) Тогда
				ОпределитьИзменение(Исправления, "ИзменитьСертификатОрганаФСГС", СертификатыОрганаФСГСИзИБ, СтрОтделениеФСГС.Сертификаты, "Сертификат органа ФСГС с кодом " + КодОрганаФСГС + " изменен", КодОрганаФСГС);
			КонецЕсли;
			
			// проверяем на необходимость добавления сертификатов отделения ФСГС в список в ИБ и регистрации в системе
			Для Каждого СтрСертификатОтделения Из СтрОтделениеФСГС.Сертификаты Цикл
				
				// проверяем на необходимость регистрации в системе
				Если НЕ СертификатЗарегистрированВХранилище(СтрСертификатОтделения.Отпечаток, "AddressBook", МассивСертификатовAddressBook) Тогда
					ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатОрганаФСГС", , СтрСертификатОтделения, "Сертификат органа ФСГС с кодом " + КодОрганаФСГС + " не зарегистрирован в системе", КодОрганаФСГС);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// проверка на необходимость регистрации сертификата СОС
	Если НастройкиРОКИ.Свойство("СертификатСОС") И НЕ СертификатЗарегистрированВХранилище(НастройкиРОКИ.СертификатСОС.Отпечаток, "AddressBook", МассивСертификатовAddressBook) Тогда
		ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатСОС", , НастройкиРОКИ.СертификатСОС, "Сертификат оператора электронного документооборота не зарегистрирован в системе");
	КонецЕсли;
	
	// проверка на необходимость регистрации корневых сертификатов ГНИВЦ
	СертификатыКорневыеГНИВЦ = Неопределено;
	Если НастройкиРОКИ.Свойство("СертификатыКорневыеГНИВЦ", СертификатыКорневыеГНИВЦ) Тогда
		Для каждого СтрСертификатКорневойГНИВЦ Из СертификатыКорневыеГНИВЦ Цикл
			Если НЕ СертификатЗарегистрированВХранилище(СтрСертификатКорневойГНИВЦ.Отпечаток, "ROOT", МассивСертификатовROOT) Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатКорневойГНИВЦ", , СтрСертификатКорневойГНИВЦ, "Корневой сертификат ГНИВЦ не зарегистрирован в системе");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// проверка на необходимость регистрации корневых сертификатов Такском
	СертификатыКорневыеТакском = Неопределено;
	Если НастройкиРОКИ.Свойство("СертификатыКорневыеТакском", СертификатыКорневыеТакском) Тогда
		Для каждого СтрСертификатКорневойТакском Из СертификатыКорневыеТакском Цикл
			Если НЕ СертификатЗарегистрированВХранилище(СтрСертификатКорневойТакском.Отпечаток, "ROOT", МассивСертификатовROOT) Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатКорневойТакском", , СтрСертификатКорневойТакском, "Корневой сертификат оператора электронного документооборота не зарегистрирован в системе");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// проверка на необходимость регистрации кросс-сертификатов Такском
	СертификатыКРОСС = Неопределено;
	Если НастройкиРОКИ.Свойство("СертификатыКРОСС", СертификатыКРОСС) Тогда
		Для каждого СтрСертификатКРОСС Из СертификатыКРОСС Цикл
			Если НЕ СертификатЗарегистрированВХранилище(СтрСертификатКРОСС.Отпечаток, "CA", МассивСертификатовCA) Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатКроссГНИВЦ", , СтрСертификатКРОСС, "Кросс-сертификат электронного документооборота не зарегистрирован в системе");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	// проверка не необходимость регистрации корневых сертификатов ПФР
	СертификатыКорневыеПФР = Неопределено;
	Если НастройкиРОКИ.Свойство("СертификатыКорневыеПФР", СертификатыКорневыеПФР) Тогда
		Для Каждого СтрКорневойСертификатПФР Из СертификатыКорневыеПФР Цикл
			Если НЕ СертификатЗарегистрированВХранилище(СтрКорневойСертификатПФР.Отпечаток, "ROOT", МассивСертификатовROOT) Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатКорневойПФР", , СтрКорневойСертификатПФР, "Корневой сертификат, используемый при обмене с ПФР, не зарегистрирован в системе");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	// проверка не необходимость регистрации кросс-сертификатов ПФР
	СертификатыКроссПФР = Неопределено;
	Если НастройкиРОКИ.Свойство("СертификатыКРОССПФР", СертификатыКроссПФР) Тогда
		Для Каждого СтрКроссСертификатПФР Из СертификатыКроссПФР Цикл
			Если НЕ СертификатЗарегистрированВХранилище(СтрКроссСертификатПФР.Отпечаток, "CA", МассивСертификатовCA) Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатКРОССПФР", , СтрКроссСертификатПФР, "Кросс-сертификат, используемый при обмене с ПФР, не зарегистрирован в системе");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	// проверка не необходимость регистрации корневых сертификатов ФСГС
	СертификатыКорневыеФСГС = Неопределено;
	Если НастройкиРОКИ.Свойство("СертификатыКорневыеФСГС", СертификатыКорневыеФСГС) Тогда
		Для Каждого СтрКорневойСертификатФСГС Из СертификатыКорневыеФСГС Цикл
			Если НЕ СертификатЗарегистрированВХранилище(СтрКорневойСертификатФСГС.Отпечаток, "ROOT", МассивСертификатовROOT) Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатКорневойФСГС", , СтрКорневойСертификатФСГС, "Корневой сертификат, используемый при обмене с Росстатом, не зарегистрирован в системе");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// проверка не необходимость регистрации кросс-сертификатов ФСГС
	СертификатыКроссФСГС = Неопределено;
	Если НастройкиРОКИ.Свойство("СертификатыКРОССФСГС", СертификатыКроссФСГС) Тогда
		Для Каждого СтрКроссСертификатФСГС Из СертификатыКроссФСГС Цикл
			Если НЕ СертификатЗарегистрированВХранилище(СтрКроссСертификатФСГС.Отпечаток, "CA", МассивСертификатовCA) Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатКРОССФСГС", , СтрКроссСертификатФСГС, "Кросс-сертификат, используемый при обмене с Росстатом, не зарегистрирован в системе");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// возвращаем таблицу-результат
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Исправления);
	
КонецПроцедуры

&НаСервере
Функция СформироватьСписокНастроекРОКИПоДеревуНастроекXML(ДеревоНастроекАдрес, Сообщения)
	
	ДеревоНастроек = ПолучитьИзВременногоХранилища(ДеревоНастроекАдрес);
	Результат = Новый Структура;
	
	// позиционируемся на сведениях об абоненте
	УзелRegistrationFile = НайтиПодчиненныйУзел(ДеревоНастроек, "RegistrationFile");
	Если УзелRegistrationFile = Неопределено Тогда
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Некорректная структура файла настроек!';
											|en = 'Incorrect structure of setting file.'"));
		Возврат Результат;
	КонецЕсли;
	
	УзелRegistration = НайтиПодчиненныйУзел(УзелRegistrationFile, "Registration");
	Если УзелRegistration = Неопределено Тогда
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Некорректная структура файла настроек!';
											|en = 'Incorrect structure of setting file.'"));
		Возврат Результат;
	КонецЕсли;
	
	УзелAbonent = НайтиПодчиненныйУзел(УзелRegistration, "Abonent");
	Если УзелAbonent = Неопределено Тогда
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Некорректная структура файла настроек!';
											|en = 'Incorrect structure of setting file.'"));
		Возврат Результат;
	КонецЕсли;
	
	// заполняем пароль
	УзелIdentifier = НайтиПодчиненныйУзел(УзелAbonent, "Identifier");
	Если УзелIdentifier <> Неопределено Тогда
		ИдентификаторАбонента = СокрЛП(УзелIdentifier.Значение);
		Результат.Вставить("ИдентификаторАбонента", ИдентификаторАбонента);
		Результат.Вставить("ИдентификаторСпецоператора", Лев(ИдентификаторАбонента, 3));
	КонецЕсли;
	
	УзелAbsos = НайтиПодчиненныйУзел(УзелAbonent, "AbSos");
	Если УзелAbsos = Неопределено Тогда
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Некорректная структура файла настроек!';
											|en = 'Incorrect structure of setting file.'"));
		Возврат Результат;
	КонецЕсли;
	
	
	// заполняем параметры сервера POP3
	ПараметрыСервераPOP3 = РазложитьСтрокуАдресаСервера(НайтиПодчиненныйУзел(УзелAbsos, "AbSOS_POP3"));
	Если ПараметрыСервераPOP3 <> Неопределено Тогда
		Результат.Вставить("СерверPOP3", ПараметрыСервераPOP3.Сервер);
		Результат.Вставить("ПортPOP3", ПараметрыСервераPOP3.Порт);
	КонецЕсли;
	
	// заполняем параметры сервера SMTP
	ПараметрыСервераSMTP = РазложитьСтрокуАдресаСервера(НайтиПодчиненныйУзел(УзелAbsos, "AbSOS_SMTP"));
	Если ПараметрыСервераSMTP <> Неопределено Тогда
		Результат.Вставить("СерверSMTP", ПараметрыСервераSMTP.Сервер);
		Результат.Вставить("ПортSMTP", ПараметрыСервераSMTP.Порт);
	КонецЕсли;
	
	// заполняем адрес электронной почты и имя пользователя
	УзелEmailAbSOS = НайтиПодчиненныйУзел(УзелAbsos, "EmailAbSOS");
	Если УзелEmailAbSOS <> Неопределено Тогда
		Результат.Вставить("АдресЭлектроннойПочты", СокрЛП(УзелEmailAbSOS.Значение));
		ИмяПользователя = ВыделитьИмяПользователяИзEmail(УзелEmailAbSOS);
		Если ЗначениеЗаполнено(ИмяПользователя) Тогда
			Результат.Вставить("ИмяПользователяPOP3", СокрЛП(ИмяПользователя));
		КонецЕсли;
	КонецЕсли;
	
	// заполняем пароль
	УзелAbSOSPSW = НайтиПодчиненныйУзел(УзелAbsos, "AbSOSPSW");
	Если УзелAbSOSPSW <> Неопределено Тогда
		Результат.Вставить("ПарольPOP3", СокрЛП(УзелAbSOSPSW.Значение));
	КонецЕсли;
	
	УзелEmailSosSOS = НайтиПодчиненныйУзел(УзелAbsos, "EmailSosSOS");
	Если УзелEmailSosSOS <> Неопределено Тогда
		Результат.Вставить("АдресСпецоператора", СокрЛП(УзелEmailSosSOS.Значение));
	КонецЕсли;
	
	
	// заполняем признак сдачи напрямую
	УзелPR_GPR = НайтиПодчиненныйУзел(УзелAbsos, "PR_GPR");
	Если УзелPR_GPR <> Неопределено Тогда
		Результат.Вставить("ПризнакСдачиНапрямую", ПреобразоватьXMLКЗначению("Булево", УзелPR_GPR.Значение));
	КонецЕсли;
	
	
	// заполняем сведения о сертификатах абонента
	СертификатыАбонента = Новый Массив;
	УзелCertificates = НайтиПодчиненныйУзел(УзелAbsos, "Certificates");
	Если УзелCertificates <> Неопределено Тогда
		УзлыCertificate_Ab = НайтиПодчиненныеУзлы(УзелCertificates, "Certificate_Ab");
		Для Каждого УзелCertificate_Ab Из УзлыCertificate_Ab Цикл
			СертификатыАбонента.Добавить(СвойстваСертификатаПоУзлу(УзелCertificate_Ab));
		КонецЦикла;
	КонецЕсли;
	Результат.Вставить("Сертификаты", СертификатыАбонента);
	
	
	// заполняем сведения об ИФНС
	ДатаСеанса = ТекущаяДатаСеанса();
	ИФНСы = Новый Массив;
	УзлыIFNS = НайтиПодчиненныеУзлы(УзелAbsos, "IFNS");
	Для Каждого УзелIFNS Из УзлыIFNS Цикл
		
		СтрИФНС_Код = Неопределено;
		СтрИФНС_Наименование = Неопределено;
		СтрИФНС_Сертификаты = Неопределено;
		СтрИФНС_ИФНСПоУмолчанию = Неопределено;
		СтрИФНС_СерверДокументооборота = Неопределено;
		СтрИФНС_СертификатПочтовогоСервера = Неопределено;
		
		УзелIFNS_CODE = НайтиПодчиненныйУзел(УзелIFNS, "IFNS_CODE");
		Если УзелIFNS_CODE <> Неопределено Тогда
			СтрИФНС_Код = СокрЛП(УзелIFNS_CODE.Значение);
		КонецЕсли;
		
		УзелIFNS_name = НайтиПодчиненныйУзел(УзелIFNS, "IFNS_name");
		Если УзелIFNS_name <> Неопределено Тогда
			СтрИФНС_Наименование = СокрЛП(УзелIFNS_name.Значение);
		КонецЕсли;
		
		СертификатыИФНС = Новый Массив;
		УзлыCertificate_IFNS = НайтиПодчиненныеУзлы(УзелIFNS, "Certificate_IFNS");
		Для Каждого УзелCertificate_IFNS Из УзлыCertificate_IFNS Цикл
			СертификатыИФНС.Добавить(СвойстваСертификатаПоУзлу(УзелCertificate_IFNS));
		КонецЦикла;
		Для НомерСертификатаСКонца = 1 По УзлыCertificate_IFNS.Количество() Цикл
			ИндексСертификата = УзлыCertificate_IFNS.Количество() - НомерСертификатаСКонца;
			Если (ДатаСеанса < СертификатыИФНС[ИндексСертификата].ДействителенС
				ИЛИ ДатаСеанса > СертификатыИФНС[ИндексСертификата].ДействителенПо)
				И СертификатыИФНС.Количество() > 1 Тогда
				СертификатыИФНС.Удалить(ИндексСертификата);
			КонецЕсли;
		КонецЦикла;
		СтрИФНС_Сертификаты = СертификатыИФНС;
		
		УзелDuty_EMail = НайтиПодчиненныйУзел(УзелIFNS, "Duty_EMail");
		Если УзелDuty_EMail <> Неопределено Тогда
			СтрИФНС_ИФНСПоУмолчанию = ПреобразоватьXMLКЗначению("Булево", УзелDuty_EMail.Значение);
		КонецЕсли;
		
		УзелPostserver = НайтиПодчиненныйУзел(УзелIFNS, "Postserver");
		Если УзелPostserver <> Неопределено Тогда
			УзелEmailPOST = НайтиПодчиненныйУзел(УзелPostserver, "EmailPOST");
			Если УзелEmailPOST <> Неопределено Тогда
				СтрИФНС_СерверДокументооборота = СокрЛП(УзелEmailPOST.Значение);
			КонецЕсли;
			УзелCertificate_Post = НайтиПодчиненныйУзел(УзелPostserver, "Certificate_Post");
			Если УзелCertificate_Post <> Неопределено Тогда
				СтрИФНС_СертификатПочтовогоСервера = СвойстваСертификатаПоУзлу(УзелCertificate_Post);
			КонецЕсли;
		КонецЕсли;
		
		ИФНСы.Добавить(Новый Структура("Код, Наименование, Сертификаты, ИФНСПоУмолчанию, СерверДокументооборота, СертификатПочтовогоСервера", СтрИФНС_Код,
			СтрИФНС_Наименование,
			СтрИФНС_Сертификаты,
			СтрИФНС_ИФНСПоУмолчанию,
			СтрИФНС_СерверДокументооборота,
			СтрИФНС_СертификатПочтовогоСервера));
		
	КонецЦикла;
	Результат.Вставить("ИФНСы", ИФНСы);
	
	
	// заполняем сведения об отделениях ПФР
	УзелPFR = НайтиПодчиненныйУзел(УзелAbsos, "PFR");
	Если ЗначениеЗаполнено(УзелPFR) Тогда
		
		// заполняем адрес оператора электронного документооборота для ПФР
		УзелEmailSosPFR = НайтиПодчиненныйУзел(УзелPFR, "EmailSosPFR");
		Если УзелEmailSosPFR <> Неопределено Тогда
			Результат.Вставить("АдресСпецоператораПФР", СокрЛП(УзелEmailSosPFR.Значение));
		КонецЕсли;
		
		// заполняем таблицу отделений ПФР
		ОтделенияПФР = Новый Массив;
		
		УзелDirections = НайтиПодчиненныйУзел(УзелPFR, "Directions");
		Если ЗначениеЗаполнено(УзелDirections) Тогда
			
			УзлыDirection = НайтиПодчиненныеУзлы(УзелDirections, "Direction");
			Для Каждого УзелDirection Из УзлыDirection Цикл
				
				НовоеОтделениеПФР_Код = Неопределено;
				НовоеОтделениеПФР_Наименование = Неопределено;
				НовоеОтделениеПФР_Сертификаты = Неопределено;
				
				УзелPFRYprCode = НайтиПодчиненныйУзел(УзелDirection, "PFRYprCode");
				Если УзелPFRYprCode <> Неопределено Тогда
					НовоеОтделениеПФР_Код = СокрЛП(УзелPFRYprCode.Значение);
				КонецЕсли;
				
				УзелPFRYprName = НайтиПодчиненныйУзел(УзелDirection, "PFRYprName");
				Если УзелPFRYprName <> Неопределено Тогда
					НовоеОтделениеПФР_Наименование = СокрЛП(УзелPFRYprName.Значение);
				КонецЕсли;
				
				УзелPFRCerts = НайтиПодчиненныйУзел(УзелDirection, "PFRCerts");
				Если ЗначениеЗаполнено(УзелPFRCerts) Тогда
					
					СертификатыОтделенияПФР = Новый Массив;
					
					УзлыCertificate_PFR = НайтиПодчиненныеУзлы(УзелPFRCerts, "Certificate_PFR");
					Для Каждого УзелCertificate_PFR Из УзлыCertificate_PFR Цикл
						СертификатыОтделенияПФР.Добавить(СвойстваСертификатаПоУзлу(УзелCertificate_PFR));
					КонецЦикла;
					Для НомерСертификатаСКонца = 1 По УзлыCertificate_PFR.Количество() Цикл
						ИндексСертификата = УзлыCertificate_PFR.Количество() - НомерСертификатаСКонца;
						Если (ДатаСеанса < СертификатыОтделенияПФР[ИндексСертификата].ДействителенС
							ИЛИ ДатаСеанса > СертификатыОтделенияПФР[ИндексСертификата].ДействителенПо)
							И СертификатыОтделенияПФР.Количество() > 1 Тогда
							СертификатыОтделенияПФР.Удалить(ИндексСертификата);
						КонецЕсли;
					КонецЦикла;
					
					НовоеОтделениеПФР_Сертификаты = СертификатыОтделенияПФР;
					
				КонецЕсли;
				
				ОтделенияПФР.Добавить(Новый Структура("Код, Наименование, Сертификаты",
					НовоеОтделениеПФР_Код, НовоеОтделениеПФР_Наименование, НовоеОтделениеПФР_Сертификаты));
				
			КонецЦикла;
			
		КонецЕсли;
		
		Результат.Вставить("ОтделенияПФР", ОтделенияПФР);
		
	КонецЕсли;
	
	// заполняем сведения об отделениях ФСГС
	УзелFSGS = НайтиПодчиненныйУзел(УзелAbsos, "FSGS");
	Если ЗначениеЗаполнено(УзелFSGS) Тогда
		
		// заполняем адрес оператора электронного документооборота для ФСГС
		УзелEmailSosFSGS = НайтиПодчиненныйУзел(УзелFSGS, "EmailSosFSGS");
		Если УзелEmailSosFSGS <> Неопределено Тогда
			Результат.Вставить("АдресСпецоператораФСГС", СокрЛП(УзелEmailSosFSGS.Значение));
		КонецЕсли;
		
		// заполняем таблицу отделений ФСГС
		ОтделенияФСГС = Новый Массив;
		
		УзелDirections = НайтиПодчиненныйУзел(УзелFSGS, "Directions");
		Если ЗначениеЗаполнено(УзелDirections) Тогда
			
			УзлыDirection = НайтиПодчиненныеУзлы(УзелDirections, "Direction");
			Для Каждого УзелDirection Из УзлыDirection Цикл
				
				НовоеОтделениеФСГС_Код = Неопределено;
				НовоеОтделениеФСГС_Наименование = Неопределено;
				НовоеОтделениеФСГС_Сертификаты = Неопределено;
				
				УзелFSGSOrgCode = НайтиПодчиненныйУзел(УзелDirection, "FSGSOrgCode");
				Если УзелFSGSOrgCode <> Неопределено Тогда
					НовоеОтделениеФСГС_Код = СокрЛП(УзелFSGSOrgCode.Значение);
				КонецЕсли;
				
				УзелFSGSOrgName = НайтиПодчиненныйУзел(УзелDirection, "FSGSOrgName");
				Если УзелFSGSOrgName <> Неопределено Тогда
					НовоеОтделениеФСГС_Наименование = СокрЛП(УзелFSGSOrgName.Значение);
				КонецЕсли;
				
				УзелFSGSCerts = НайтиПодчиненныйУзел(УзелDirection, "FSGSCerts");
				Если ЗначениеЗаполнено(УзелFSGSCerts) Тогда
					
					СертификатыОтделенияФСГС = Новый Массив;
					
					УзлыCertificate_FSGS = НайтиПодчиненныеУзлы(УзелFSGSCerts, "Certificate_FSGS");
					Для Каждого УзелCertificate_FSGS Из УзлыCertificate_FSGS Цикл
						СертификатыОтделенияФСГС.Добавить(СвойстваСертификатаПоУзлу(УзелCertificate_FSGS));
					КонецЦикла;
					Для НомерСертификатаСКонца = 1 По УзлыCertificate_FSGS.Количество() Цикл
						ИндексСертификата = УзлыCertificate_FSGS.Количество() - НомерСертификатаСКонца;
						Если (ДатаСеанса < СертификатыОтделенияФСГС[ИндексСертификата].ДействителенС
							ИЛИ ДатаСеанса > СертификатыОтделенияФСГС[ИндексСертификата].ДействителенПо)
							И СертификатыОтделенияФСГС.Количество() > 1 Тогда
							СертификатыОтделенияФСГС.Удалить(ИндексСертификата);
						КонецЕсли;
					КонецЦикла;
					
					НовоеОтделениеФСГС_Сертификаты = СертификатыОтделенияФСГС;
					
				КонецЕсли;
				
				ОтделенияФСГС.Добавить(Новый Структура("Код, Наименование, Сертификаты",
					НовоеОтделениеФСГС_Код, НовоеОтделениеФСГС_Наименование, НовоеОтделениеФСГС_Сертификаты));
				
			КонецЦикла;
			
		КонецЕсли;
		
		Результат.Вставить("ОтделенияФСГС", ОтделенияФСГС);
		
	КонецЕсли;
	
	// заполняем родительские сертификаты
	УзелCert_CA = НайтиПодчиненныйУзел(УзелRegistration, "Cert_CA");
	Если УзелCert_CA <> Неопределено Тогда
		
		// узлы с корневыми сертификатами ГНИВЦ
		СертификатыКорневыеГНИВЦ = Новый Массив;
		УзлыCert_ROOT_GNIVC = НайтиПодчиненныеУзлы(УзелCert_CA, "Cert_ROOT_GNIVC");
		Для Каждого УзелCert_ROOT_GNIVC Из УзлыCert_ROOT_GNIVC Цикл
			НовыйСертификатКорневойГНИВЦ = СвойстваСертификатаПоУзлу(УзелCert_ROOT_GNIVC);
			СертификатыКорневыеГНИВЦ.Добавить(НовыйСертификатКорневойГНИВЦ);
		КонецЦикла;
		Результат.Вставить("СертификатыКорневыеГНИВЦ", СертификатыКорневыеГНИВЦ);
		
		// узлы с корневыми сертификатами СОС
		СертификатыКорневыеТакском = Новый Массив;
		УзлыCert_ROOT_SOS = НайтиПодчиненныеУзлы(УзелCert_CA, "Cert_ROOT_SOS");
		Для Каждого УзелCert_ROOT_SOS Из УзлыCert_ROOT_SOS Цикл
			НовыйСертификатКорневойТакском = СвойстваСертификатаПоУзлу(УзелCert_ROOT_SOS);
			СертификатыКорневыеТакском.Добавить(НовыйСертификатКорневойТакском);
		КонецЦикла;
		Результат.Вставить("СертификатыКорневыеТакском", СертификатыКорневыеТакском);
		
		// узлы с сертификатами СОС
		УзлыCert_SOS = НайтиПодчиненныеУзлы(УзелCert_CA, "Cert_SOS");
		Для Каждого УзелCert_SOS Из УзлыCert_SOS Цикл
			Результат.Вставить("СертификатСОС", СвойстваСертификатаПоУзлу(УзелCert_SOS));
		КонецЦикла;
		
		// узлы с кросс-сертификатами
		СертификатыКРОСС = Новый Массив;
		УзлыCert_CROSS = НайтиПодчиненныеУзлы(УзелCert_CA, "Cert_CROSS");
		Для Каждого УзелCert_CROSS Из УзлыCert_CROSS Цикл
			НовыйСертификатКРОСС = СвойстваСертификатаПоУзлу(УзелCert_CROSS);
			СертификатыКРОСС.Добавить(НовыйСертификатКРОСС);
		КонецЦикла;
		Результат.Вставить("СертификатыКРОСС", СертификатыКРОСС);
		
	КонецЕсли;
	
	
	// заполняем сертификаты ПФР (их может не быть, если обмен с ПФР не задействован по учетной записи)
	УзелCertPFR = НайтиПодчиненныйУзел(УзелRegistration, "Cert_PFR");
	Если УзелCertPFR <> Неопределено Тогда
		
		// заполняем таблицу корневых сертификатов ПФР
		КорневыеСертификатыПФР = Новый Массив;
		УзелRoot = НайтиПодчиненныйУзел(УзелCertPFR, "Root");
		Если УзелRoot <> Неопределено Тогда
			УзлыCertificate_PFR = НайтиПодчиненныеУзлы(УзелRoot, "Certificate_PFR");
			Для Каждого УзелCertificate_PFR Из УзлыCertificate_PFR Цикл
				КорневыеСертификатыПФР.Добавить(СвойстваСертификатаПоУзлу(УзелCertificate_PFR));
			КонецЦикла;
		КонецЕсли;
		Результат.Вставить("СертификатыКорневыеПФР", КорневыеСертификатыПФР);
		
		// заполняем таблицу кросс-сертификатов ПФР
		КроссСертификатыПФР = Новый Массив;
		УзелCROSS = НайтиПодчиненныйУзел(УзелCertPFR, "CROSS");
		Если УзелCROSS <> Неопределено Тогда
			УзлыCertificate_PFR = НайтиПодчиненныеУзлы(УзелCROSS, "Certificate_PFR");
			Для Каждого УзелCertificate_PFR Из УзлыCertificate_PFR Цикл
				КроссСертификатыПФР.Добавить(СвойстваСертификатаПоУзлу(УзелCertificate_PFR));
			КонецЦикла;
		КонецЕсли;
		Результат.Вставить("СертификатыКРОССПФР", КроссСертификатыПФР);
		
	КонецЕсли;
	
	// заполняем сертификаты ФСГС (их может не быть, если обмен с ФСГС не задействован по учетной записи)
	УзелCertFSGS = НайтиПодчиненныйУзел(УзелRegistration, "Cert_FSGS");
	Если УзелCertFSGS <> Неопределено Тогда
		
		// заполняем таблицу корневых сертификатов ФСГС
		КорневыеСертификатыФСГС = Новый Массив;
		УзелRoot = НайтиПодчиненныйУзел(УзелCertFSGS, "Root");
		Если УзелRoot <> Неопределено Тогда
			УзлыCertificate_FSGS = НайтиПодчиненныеУзлы(УзелRoot, "Certificate_FSGS");
			Для Каждого УзелCertificate_FSGS Из УзлыCertificate_FSGS Цикл
				КорневыеСертификатыФСГС.Добавить(СвойстваСертификатаПоУзлу(УзелCertificate_FSGS));
			КонецЦикла;
		КонецЕсли;
		Результат.Вставить("СертификатыКорневыеФСГС", КорневыеСертификатыФСГС);
		
		// заполняем таблицу кросс-сертификатов ФСГС
		КроссСертификатыФСГС = Новый Массив;
		УзелCROSS = НайтиПодчиненныйУзел(УзелCertFSGS, "CROSS");
		Если УзелCROSS <> Неопределено Тогда
			УзлыCertificate_FSGS = НайтиПодчиненныеУзлы(УзелCROSS, "Certificate_FSGS");
			Для Каждого УзелCertificate_FSGS Из УзлыCertificate_FSGS Цикл
				КроссСертификатыФСГС.Добавить(СвойстваСертификатаПоУзлу(УзелCertificate_FSGS));
			КонецЦикла;
		КонецЕсли;
		Результат.Вставить("СертификатыКРОССФСГС", КроссСертификатыФСГС);
		
	КонецЕсли;
	
	// инициализируем признаки обмена с ФНС, ПФР и Росстат
	Результат.Вставить("ПредназначенаДляДокументооборотаСФНС", УзлыIFNS.Количество() > 0);
	Результат.Вставить("ПредназначенаДляДокументооборотаСПФР", ЗначениеЗаполнено(УзелPFR));
	Результат.Вставить("ПредназначенаДляДокументооборотаСФСГС", ЗначениеЗаполнено(УзелFSGS));
	
	// возвращаем результат
	Возврат Результат;
	
КонецФункции

