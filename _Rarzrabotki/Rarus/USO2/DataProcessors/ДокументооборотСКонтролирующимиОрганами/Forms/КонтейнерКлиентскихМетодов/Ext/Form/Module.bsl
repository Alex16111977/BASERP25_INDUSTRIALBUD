&НаКлиенте
Функция СрокЛицензииКриптоПроКонечный() Экспорт
	
	ЛицензиюНельзяВычислить = 
		СтрНайти(ЭтотОбъект.ИмяФормы, "ВнешняяОбработка") > 0
		ИЛИ ОбщегоНазначенияКлиентСервер.ЭтоВебКлиент();
	
	Если ЛицензиюНельзяВычислить Тогда
		Возврат Истина;
	КонецЕсли;
	
	Попытка
		CPCSPLicense = Новый COMОбъект("CPCSPLicense.CPCSPLicense");
	Исключение
		Возврат Истина;
	КонецПопытки;
	
	Попытка
	
		ДатаИстеченияЛицензии = CPCSPLicense.GetExpireDate("{54A08450-B343-40B0-924E-68F031450996}");//3.6
		
	Исключение
		
		Попытка
		
			ДатаИстеченияЛицензии = CPCSPLicense.GetExpireDate("{39D25A86-A5E6-42FC-9C8F-EFA4C138B08C}");//3.9
		
		Исключение
			
			Попытка
			
				ДатаИстеченияЛицензии = CPCSPLicense.GetExpireDate("{407E5BA7-6406-40BF-A4DC-3654B8F584C1}");//4.0
			
			Исключение
				
				Попытка
			
					ДатаИстеченияЛицензии = CPCSPLicense.GetExpireDate("{50F91F80-D397-437C-B0C8-62128DE3B55E}");//5.0
			
				Исключение
				
				КонецПопытки;
				
			КонецПопытки; 
		
		КонецПопытки; 
	
	КонецПопытки;  
	
	ЭтоБесконечнаяЛицензия = ДатаИстеченияЛицензии = Дата(1899,12,30);
	
	Возврат НЕ ЭтоБесконечнаяЛицензия;
	
КонецФункции

&НаКлиенте
Функция ЗапретитьВыводОшибокКриптоПро(ДокументЗаявление, НовыйСтатусДокумента) Экспорт
	
	Если ОбщегоНазначенияКлиентСервер.ЭтоВебКлиент()
		ИЛИ НЕ ДокументЗаявление.ВключитьЛицензиюКриптоПро
		ИЛИ НовыйСтатусДокумента <> ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	#Если ВебКлиент Тогда 
		ИмяФайла = "";
		Возврат Ложь;
	#Иначе
		// В вебе нет этого метода
		ИмяФайла = ПолучитьИмяВременногоФайла(".q");
	#КонецЕсли
	
	Попытка
		WshShell = Новый COMОбъект("WScript.Shell");
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Попытка
		WshShell.Run("cmd.exe /c whoami /user >""" + ИмяФайла+"""", 0, true);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ИмяФайла, "cp866");
	ПоследняяСтрока = Текст.ПолучитьСтроку(Текст.КоличествоСтрок());
	УдалитьФайлы(ИмяФайла);

	Подстроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПоследняяСтрока, " ", Истина, Истина);
	
	SID = Подстроки[1];

	ПутьРазрядности = "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Environment\PROCESSOR_ARCHITECTURE";
	
	Попытка
		Значение = WshShell.RegRead(ПутьРазрядности);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Если Значение = "AMD64" Тогда 
		// 64х битная
		Путь = "HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Crypto Pro\Settings\USERS\" + SID +"\KeyDevices\LicErrorLevel";
	Иначе
		// 32х битная
		Путь = "HKEY_LOCAL_MACHINE\SOFTWARE\Crypto Pro\Settings\USERS\" + SID +"\KeyDevices\LicErrorLevel";
	КонецЕсли;
	
	Попытка
		WshShell.RegWrite(Путь, 2);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

