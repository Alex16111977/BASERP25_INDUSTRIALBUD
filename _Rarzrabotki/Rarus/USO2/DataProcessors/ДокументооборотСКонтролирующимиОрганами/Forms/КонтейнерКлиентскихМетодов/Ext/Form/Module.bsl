&НаСервере
Процедура ПолучитьЭЦП(ИсходныйФайлИД)
	
	ИсходныйФайл = Файлы.Получить(ИсходныйФайлИД);
	
	// инициализируем таблицу возможных подписей и их свойств
	КартаДокументовИПодписей = ИнициализироватьКартуДокументовИПодписей();
	
	ТаблицаПодписей.Очистить();
	ПодписиАбонента.Очистить();
	ПодписиКонтрагента.Очистить();
	
	// находим строку, соответствующую типу подписанного файла, во вспомогательной таблице
	СтрОпределениеТипа = КартаДокументовИПодписей.Найти(ИсходныйФайл.ИдТипа, "ИдТипа");
	Если СтрОпределениеТипа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// определяем подписи сначала абонента, а затем сторонней организации
	Если Файлы.НайтиСтроки(Новый Структура("ИмяПодписанногоФайла", "")).Количество() <> Файлы.Количество() Тогда 
		ПодписиАбонентаМассив = Файлы.НайтиСтроки(Новый Структура("ИдТипа, ИмяПодписанногоФайла", СтрОпределениеТипа.ИдПодписиНалогоплательщика, ИсходныйФайл.ИмяФайла));
		ПодписиКонтрагентаМассив = Файлы.НайтиСтроки(Новый Структура("ИдТипа, ИмяПодписанногоФайла", СтрОпределениеТипа.ИдПодписиКонтрагента, ИсходныйФайл.ИмяФайла));
	Иначе
		
		ПодписиАбонентаМассив = Файлы.НайтиСтроки(Новый Структура("ИдТипа", СтрОпределениеТипа.ИдПодписиНалогоплательщика));
		Если ПодписиАбонентаМассив.Количество() = 0 И ЗначениеЗаполнено(СтрОпределениеТипа.ИдПодписиНалогоплательщика2) Тогда
			ПодписиАбонентаМассив = Файлы.НайтиСтроки(Новый Структура("ИдТипа", СтрОпределениеТипа.ИдПодписиНалогоплательщика2));
		КонецЕсли;
		
		ПодписиКонтрагентаМассив = Файлы.НайтиСтроки(Новый Структура("ИдТипа", СтрОпределениеТипа.ИдПодписиКонтрагента));
		
	КонецЕсли;
	
	// "конвертируем" значение для передачи
	Для Каждого ПодписьАбонента Из ПодписиАбонентаМассив Цикл 
		НоваяСтрока = ПодписиАбонента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПодписьАбонента);
	КонецЦикла;
		
	Для Каждого ПодписьКонтрагента Из ПодписиКонтрагентаМассив Цикл
		НоваяСтрока = ПодписиКонтрагента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПодписьКонтрагента);
	КонецЦикла;
	
	ПоместитьПодписиВТаблицу();
	
КонецПроцедуры

&НаСервере
Функция СформироватьТабличныйДокументНаОсновеБланка(Заголовок, ИмяФайла, Тело, НижнийКолонтитул)
	
	Бланк = ПолучитьМакетОбработки("БланкПечатиДИВ");
	
	ТаблДок = Новый ТабличныйДокумент;
	ТаблДок.АвтоМасштаб = Истина;
	
	Секция_Заголовок = Бланк.ПолучитьОбласть("Секция_Заголовок");
	Секция_Заголовок.Области.Заголовок.Текст = Заголовок;
	Секция_Заголовок.Области.Файл.Текст = ИмяФайла;
	ТаблДок.Вывести(Секция_Заголовок);
	
	Секция_Разделитель = Бланк.ПолучитьОбласть("Секция_Разделитель");
	ТаблДок.Вывести(Секция_Разделитель);
	
	Секция_Тело = Бланк.ПолучитьОбласть("Секция_Тело");
	ВывестиТекстПострочно(ТаблДок, Секция_Тело, Тело);
	
	ТаблДок.Вывести(Секция_Разделитель);
	
	СформироватьТабличныйДокументСекцияПодписи(ТаблДок, Бланк, ТаблицаПодписей);
	
	ТаблДок.НижнийКолонтитул.ТекстСлева = НижнийКолонтитул;
	
	Возврат ТаблДок;
	
КонецФункции

&НаСервере
Функция СформироватьТабличныйДокументНаОсновеПодтвержденияДатыОтправки(Заголовок, ИмяФайла, Тело, НижнийКолонтитул)
	
	СвойстваИзПодтверждения = ПолучитьОсновныеСвойстваИзПодтвержденияДатыОтправки(Тело);
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	// если текст уведомления разобрать удалось, то выводим основную информацию из него
	Если ЗначениеЗаполнено(СвойстваИзПодтверждения) Тогда
		
		Макет = ПолучитьМакетОбработки("ПодтверждениеДатыОтправки");
		
		ОбластьМакета = Макет.ПолучитьОбласть("ПодтверждениеДатыОтправки");
		
		ОбластьМакета.Параметры.Отправитель = СвойстваИзПодтверждения.ДанныеФайлаОтправки.ПредставлениеОтпр;
		ОбластьМакета.Параметры.СОС = СвойстваИзПодтверждения.ПодтвердившаяОрганизация;
		ОбластьМакета.Параметры.Дата = СвойстваИзПодтверждения.ДанныеФайлаОтправки.ДатаОтправки;
		ОбластьМакета.Параметры.Время = СтрЗаменить(СвойстваИзПодтверждения.ДанныеФайлаОтправки.ВремяОтправки,".",":");
		ОбластьМакета.Параметры.НаименованиеФайла = ВРег(СвойстваИзПодтверждения.ИмяФайла);
		ОбластьМакета.Параметры.ЭлектронныйАдресОтправителя = СвойстваИзПодтверждения.ДанныеФайлаОтправки.EmailОтправитель;
		ОбластьМакета.Параметры.ЭлектронныйАдресПолучателя = СвойстваИзПодтверждения.ДанныеФайлаОтправки.EmailПолучатель;
		ОбластьМакета.Параметры.КодНалоговогоОргана = СвойстваИзПодтверждения.ДанныеФайлаОтправки.КодНО;
		
		ТабДокумент.Вывести(ОбластьМакета);//ПодтверждениеДатыОтправки
		
		// выводим информацию о подписях
		СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, ТаблицаПодписей);
	Иначе
		
		ТабДокумент = СформироватьТабличныйДокументНаОсновеБланка(Заголовок, ИмяФайла, Тело, НижнийКолонтитул);
		
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

