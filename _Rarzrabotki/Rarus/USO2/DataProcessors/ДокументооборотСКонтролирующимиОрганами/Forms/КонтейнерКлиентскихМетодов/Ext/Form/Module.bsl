		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого УзелОбщСвед Из УзелДокумент.Строки Цикл
		ОбщиеСведения.Вставить(УзелОбщСвед.Имя, СокрЛП(УзелОбщСвед.Значение));
	КонецЦикла;
	
	ПолучитьСведенияУзла(УзелДокумент, "ОтпрЮЛ",    ОбщиеСведения);
	ПолучитьСведенияУзла(УзелДокумент, "ОтпрФЛ",    ОбщиеСведения);
	ПолучитьСведенияУзла(УзелДокумент, "СвОтметка", ОбщиеСведения);
	ПолучитьСведенияУзла(УзелДокумент, "ОтпрНО",    ОбщиеСведения);
	ПолучитьСведенияУзла(УзелДокумент, "НОПром",    ОбщиеСведения);
