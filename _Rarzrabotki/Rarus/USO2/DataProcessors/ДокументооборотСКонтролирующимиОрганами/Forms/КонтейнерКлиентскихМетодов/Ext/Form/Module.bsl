// Представление уведомлений о котролируемых сделках в налоговые органы
&НаСервереБезКонтекста
Функция ВыгрузитьУведомлениеФНС(УведомлениеСсылка, ДанныеФайловВыгрузки)
	
	ДанныеФайловВыгрузки = Новый Структура("ДанныеФайлаПредставление");
	
	// выгружаем файлы уведомления
	
	// создаем объект
	УведомлениеОбъект = УведомлениеСсылка.ПолучитьОбъект();
	
	// формируем текст выгрузки
	Если ТипЗнч(УведомлениеОбъект) = Тип("ДокументОбъект.УведомлениеОСпецрежимахНалогообложения") Тогда
		ИдентификаторПолучателя = ДлительнаяОтправкаКлиентСервер.ЗначенияПараметровДлительнойОтправки()["ИдентификаторПолучателя"];
		МассивВыгруженныхУведомлений = УведомлениеОбъект.ВыгрузитьДокумент(ИдентификаторПолучателя);
	Иначе
		МассивВыгруженныхУведомлений = УведомлениеОбъект.ВыгрузитьДокументСРазделениемНаФайлы();
	КонецЕсли;
	
	Если МассивВыгруженныхУведомлений = Неопределено Тогда
		Возврат Ложь;
	Иначе
		ДанныеФайловВыгрузки = МассивВыгруженныхУведомлений;
	КонецЕсли;

	Возврат Истина;

КонецФункции

