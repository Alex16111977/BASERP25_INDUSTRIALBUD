&НаКлиенте
Процедура ВыгрузитьЗапросИОСВФайл(ДокЗапрос, УникальныйИдентификатор = Неопределено) Экспорт
	Перем Запрос, ИмяФайлаЗапроса;
	
	Если СформироватьФайлЗапросаИОС(ДокЗапрос, Запрос, ИмяФайлаЗапроса, УникальныйИдентификатор) Тогда
		ОперацииСФайламиЭДКОКлиент.СохранитьФайлы(Новый Структура("Адрес, Имя", Запрос, ИмяФайлаЗапроса));
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОпределитьТипПриложенияКОтветуНаЗапросПФР(Данные)
	
	ВремФайл = ПолучитьИмяВременногоФайла();
	
	Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
		Данные.Записать(ВремФайл);
	ИначеЕсли ЭтоАдресВременногоХранилища(Данные) Тогда
		ПолучитьИзВременногоХранилища(Данные).Записать(ВремФайл);
	Иначе
		Данные.Получить().Записать(ВремФайл);
	КонецЕсли;
	
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений(ВремФайл);
	Если ДеревоXML = Неопределено Тогда
		Возврат 0;
	ИначеЕсли ДеревоXML.Строки.Найти("справка", "Имя") <> Неопределено ИЛИ ДеревоXML.Строки.Найти("справкаОСостоянииРасчетов", "Имя") <> Неопределено Тогда
		Возврат 1;
	ИначеЕсли ДеревоXML.Строки.Найти("сверка", "Имя") <> Неопределено Тогда
		Возврат 2;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

#Область ОтправкаЗапросаИОС

&НаКлиенте
Процедура ОтправкаЗапросаИОС(Док, Организация, ВыполняемоеОповещение) Экспорт
	
	Если НЕ ОбъектЗаполненКорректно(Док) Тогда
		Возврат;
	КонецЕсли;
	
	ВидУслуги = ПолучитьРеквизитНаСервере(Док, "ВидУслуги");
	Если ВидУслуги = ПредопределенноеЗначение("Перечисление.ВидыУслугПриИОС.СправкаОСостоянииРасчетов") Тогда
		 ТекстОшибки = НСтр("ru = 'Отправка запроса на сверку невозможна по причине:
                            |ПФР более не поддерживает запрос справок о состоянии расчетов.';
                            |en = 'Sending the request for comparison is impossible for the reason:
                            |PFR no longer supports the request of certificates about condition of settlements.'");
		 ПоказатьПредупреждение(, ТекстОшибки);
		 Возврат;
	КонецЕсли;
	
	КонтекстДлительнойОперации = Новый Структура();
	КонтекстДлительнойОперации.Вставить("Док",                   Док);
	КонтекстДлительнойОперации.Вставить("Организация",           Организация);
	КонтекстДлительнойОперации.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаЗапросаИОС_ПослеНастройкиЗаявления", 
		ЭтотОбъект, 
		КонтекстДлительнойОперации);
		
	ЗавершитьНастройкуЗаявленияНаИзменение(Док, ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтправкаЗапросаИОС_ПослеНастройкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаЗапросаИОС_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ВходящийКонтекст.Док, ВходящийКонтекст.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЗапросаИОС_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		Возврат;
	КонецЕсли;

	Док = ВходящийКонтекст.Док;

	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= Док;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 5;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= ВходящийКонтекст;

	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка сверки в ПФР
		Возврат;
	КонецЕсли;
		
	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаЗапросаИОС", 0.1, Истина); 
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаЗапросаИОС() Экспорт
	
	КонтекстДлительнойОперации 	= ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	Док = КонтекстДлительнойОперации.Док;
	
	Контекст = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(КонтекстДлительнойОперации);
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется настройка учетной записи...");

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаЗапросаИОСПослеАвтонастройкиУчетнойЗаписи",
		ЭтотОбъект,
		Контекст);
		
	ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(Док, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЗапросаИОС_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	Параметры_Док 					= ВходящийКонтекст.Док;
	Параметры_Организация 			= ВходящийКонтекст.Организация;
	Параметры_ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	ОтправкаЗапросаИОС(Параметры_Док, Параметры_Организация, Параметры_ВыполняемоеОповещение);

КонецПроцедуры
	
&НаКлиенте
Процедура ОтправкаЗапросаИОСПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт
	
	Док = ВходящийКонтекст.Док;
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("Документ", Док);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Запись данных...");

	// отражаем изменения в базе
	Если НЕ ОтправкаЗапросаИОС_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки) Тогда // сервер
		
		Если КонтекстОтправки.Свойство("ОтсутствуетУчетнаяЗапись") Тогда
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОтправкаЗапросаИОС_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ВходящийКонтекст);
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(Док, ОписаниеОповещения);
			
		ИначеЕсли КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ВыполняемоеОповещение, Док);
		Иначе
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Док);
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ПФР, ИОС
			
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Запись данных...");
	
	// формируем пакет
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ВыполняемоеОповещение);
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаЗапросаИОСПослеФормированияПакета", ЭтотОбъект, Контекст);
		
	Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "ПФР");
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЗапросаИОСПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;

	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("РезультатОтправки", 		КонтекстОтправки.Документ);
	
	Если Не Результат Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ПФР, ИОС
		Возврат;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Отправка...");
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(КонтекстОтправки) Тогда // сервер
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ПФР, ИОС
		Возврат;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ПФР, ИОС
	
КонецПроцедуры

#КонецОбласти

&НаСервереБезКонтекста
Функция ОбъектЗаполненКорректно(Ссылка) Экспорт
	
	Возврат Ссылка.ПолучитьОбъект().ПроверитьЗаполнение();
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтправкаЗапросаИОС_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст)
	
	Док = Контекст.Документ;
	Если НЕ ЗначениеЗаполнено(Док) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбран документ для отправки';
								|en = 'Document for sending is not selected'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// проверяем, включен ли обмен по организации
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Док, "Организация");
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбрана организация-отправитель.';
								|en = 'The sender company is not selected.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);

		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, предназначена ли эта учетная запись для документооборота с ПФР
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);
		Возврат Ложь;
		
	ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ПредназначенаДляДокументооборотаСПФР") <> Истина Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("НаправлениеНеПодключено", Истина);
		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, указан ли получатель
	ПолучательДокумента = Док.Получатель;
	Если НЕ ЗначениеЗаполнено(ПолучательДокумента) Тогда
		ТекстСообщения = НСтр("ru = 'Не задан получатель запроса.';
								|en = 'Query recipient is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// формируем файл с содержимым
	ДвоичныеДанныеФайлаЗапроса = Неопределено;
	ИмяФайлаЗапроса = Неопределено;
	РезультатФормированияФайлаЗапроса = СформироватьФайлЗапросаИОС(Док, ДвоичныеДанныеФайлаЗапроса, ИмяФайлаЗапроса);
	Если НЕ РезультатФормированияФайлаЗапроса Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КороткоеИмяФайлаПисьма = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	
	НачатьТранзакцию();
	
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбменаСсылка = Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСПФР;
	ЦиклОбмена.Предмет = Док;
	ЦиклОбмена.Идентификатор = СгенерироватьUUID();
	ЦиклОбмена.Организация = Организация;
	ЦиклОбмена.УчетнаяЗапись = УчетнаяЗапись;
	ЦиклОбмена.ВнешняяОрганизация = ПолучательДокумента;
	ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.ИОС;
	ЦиклОбмена.ДатаНачалаПериода = Док.Дата;
	ЦиклОбмена.ДатаОкончанияПериода = Док.Дата;
	ЦиклОбмена.ВидУслуги = Док.ВидУслуги;
	
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена = ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееЗапросПФР;
	ТранспортноеСообщение.Отправитель = Организация;
	ТранспортноеСообщение.Получатель = ПолучательДокумента;
	ТранспортноеСообщение.УчетнаяЗапись = УчетнаяЗапись;
	ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Исходящее;
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		ТекстСообщения = НСтр("ru = 'Отправка запроса прервана.';
								|en = 'Request sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	// ДОБАВЛЯЕМ ВЛОЖЕНИЯ
	
	// добавляем запрос
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЗапросИОС, ДвоичныеДанныеФайлаЗапроса, ИмяФайлаЗапроса, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml) Тогда
		ОтменитьТранзакцию();
		ТекстСообщения = НСтр("ru = 'Отправка запроса прервана.';
								|en = 'Request sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// записываем цикл обмена
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ОтменитьТранзакцию();
		ТекстСообщения = НСтр("ru = 'Отправка запроса прервана.';
								|en = 'Request sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	// изменяем статус отправки
	ЗаписатьСтатусОтправкиОбъекта(Док, Перечисления.СтатусыОтправки.ВКонверте);
	
	ЗафиксироватьТранзакцию();
	
	Контекст.Вставить("Организация", Организация);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	
	Возврат Истина;
	
КонецФункции


&НаКлиенте
Процедура ПоказатьОтветНаЗапросИОС(Запрос, ВыполняемоеОповещение = Неопределено) Экспорт
		
	// получаем все документы к показу
	СформироватьТаблицуОтветовНаЗапросИОС(Запрос);
	
	// определяем документ, который показываем
	КоличествоОтветов = ОтветыНаЗапросыИОС.Количество();
	
	Если КоличествоОтветов = 0 Тогда
		
		ТекстПредупреждения = НСтр("ru = 'В пакете с ответом от ПФР отсутствует запрошенный документ.
                                    |Для получения корректного ответа попробуйте отправить запрос в виде письма.';
                                    |en = 'There is no requested document in the package with an answer from PF.
                                    |To receive a correct answer, try to send a request in the form of an email.'");
		ПоказатьПредупреждение(,ТекстПредупреждения);
		
		Если ВыполняемоеОповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь)
		КонецЕсли;
	ИначеЕсли КоличествоОтветов > 1 Тогда
		СписокВыбора = Новый СписокЗначений;
		Для Каждого СтрокаОтвета Из ОтветыНаЗапросыИОС Цикл
			СписокВыбора.Добавить(СтрокаОтвета.ИмяФайла);
		КонецЦикла;
		ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, СписокВыбора, Запрос", ВыполняемоеОповещение, СписокВыбора, Запрос);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПоказатьОтветНаЗапросИОСЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		СписокВыбора.ПоказатьВыборЭлемента(ОписаниеОповещения);
	Иначе
		ПоказатьОтветНаЗапросИОСНаКлиенте(Запрос, ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтветНаЗапросИОСНаКлиенте(Запрос, ВыполняемоеОповещение)
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ОтметитьКакПрочтенное(Запрос);
	
	ОтветНаЗапросИОС	= ОтветыНаЗапросыИОС[0];
	ЭтоВебКлиент 		= ЭтоВебКлиент();
	
	Если ОтветНаЗапросИОС.ВАрхиве Тогда
		
		ПоказатьУведомлениеАрхивныхФайлов(, 17, 3);

		Если ВыполняемоеОповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Истина)
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	// перебираем ответы
	ОтветОтрицательный = (ОтветыНаЗапросыИОС.НайтиСтроки(Новый Структура("ОтветОтрицательный", Истина)).Количество() > 0);
	Если ОтветОтрицательный Тогда
		Если ЭтоВебКлиент Тогда
			ОперацииСФайламиЭДКОКлиент.ОткрытьФайл(ОтветНаЗапросИОС.Адрес, ОтветНаЗапросИОС.ИмяФайла);
		Иначе			
			Если ОтветНаЗапросИОС.ТипСодержимогоФайла = СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоФайлов_Текст1251 Тогда
				
				ПоказатьТекстИзСтроки(ОтветНаЗапросИОС.Адрес, ОтветНаЗапросИОС.ИмяФайла, "windows-1251");
				
			ИначеЕсли ОтветНаЗапросИОС.ТипСодержимогоФайла = СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоФайлов_Текст866 Тогда
				
				ПоказатьТекстИзСтроки(ОтветНаЗапросИОС.Адрес, ОтветНаЗапросИОС.ИмяФайла, "cp866");
				
			Иначе
				
				ОперацииСФайламиЭДКОКлиент.ОткрытьФайл(ОтветНаЗапросИОС.Адрес, ОтветНаЗапросИОС.ИмяФайла);
				
			КонецЕсли;
		КонецЕсли;
	Иначе
		ТипОтветаНаЗапрос = ОпределитьТипПриложенияКОтветуНаЗапросПФР(ОтветНаЗапросИОС.Адрес);
		Если ТипОтветаНаЗапрос = 1 Тогда
			ПоказатьСправкуОСостоянииРасчетовИОС(Запрос);
		ИначеЕсли ТипОтветаНаЗапрос = 2 Тогда
			ПоказатьСверкуФИОиСНИЛС(Запрос);
		Иначе
			ОперацииСФайламиЭДКОКлиент.ОткрытьФайл(ОтветНаЗапросИОС.Адрес, ОтветНаЗапросИОС.ИмяФайла);
		КонецЕсли;
	КонецЕсли;
	
	Если ВыполняемоеОповещение <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Истина)
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтветНаЗапросИОСЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	СписокВыбора = ДополнительныеПараметры.СписокВыбора;
	Запрос = ДополнительныеПараметры.Запрос;
	
	Если РезультатВыбора = Неопределено Тогда
		
		Если ВыполняемоеОповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
		КонецЕсли;
		
	Иначе
		
		// удаляем не помеченные строки из таблицы ответов
		Для Каждого СтрСписокВыбора Из СписокВыбора Цикл
			Если СтрСписокВыбора.Значение <> РезультатВыбора.Значение Тогда
				СтрОтветНаЗапросИОС = ОтветыНаЗапросыИОС.НайтиСтроки(Новый Структура("ИмяФайла", СтрСписокВыбора.Значение));
				ОтветыНаЗапросыИОС.Удалить(СтрОтветНаЗапросИОС[0]);
			КонецЕсли;
		КонецЦикла;
		
		ПоказатьОтветНаЗапросИОСНаКлиенте(Запрос, ВыполняемоеОповещение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПриложениеКОтветуНаЗапросПФР(СтрВложение, ВыполняемоеОповещение = Неопределено) Экспорт
	
	Если СтрВложение.ТипСодержимогоФайла = СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоФайлов_xml Тогда
		ТипПриложения = ОпределитьТипПриложенияКОтветуНаЗапросПФР(СтрВложение.Данные);
		Если ТипПриложения = 1 Тогда // справка о состоянии расчетов
			ПоказатьСправкуОСостоянииРасчетовИОС(СтрВложение.ТранспортноеСообщение);
		ИначеЕсли ТипПриложения = 2 Тогда // сверка ФИО-СНИЛС
			ПоказатьСверкуФИОиСНИЛС(СтрВложение.ТранспортноеСообщение);
		Иначе
			ОперацииСФайламиЭДКОКлиент.ОткрытьФайл(СтрВложение.Адрес, СтрВложение.ИмяФайла);
		КонецЕсли;
	ИначеЕсли ЭтоВебКлиент() Тогда
		
		ОперацииСФайламиЭДКОКлиент.ОткрытьФайл(СтрВложение.Адрес, СтрВложение.ИмяФайла);
		
	ИначеЕсли СтрВложение.ТипСодержимогоФайла = СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоФайлов_html Тогда
		
		ПоказатьHTML(СтрВложение.ИмяФайла, СтрВложение.Данные, Ложь);
		
	ИначеЕсли СтрВложение.ТипСодержимогоФайла = СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоФайлов_Текст1251 Тогда
		
		ПоказатьТекстИзСтроки(СтрВложение.Данные, СтрВложение.ИмяФайла, "windows-1251");
		
	ИначеЕсли СтрВложение.ТипСодержимогоФайла = СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоФайлов_Текст866 Тогда
		
		ПоказатьТекстИзСтроки(СтрВложение.Данные, СтрВложение.ИмяФайла, "cp866");
		
	Иначе
		ОперацииСФайламиЭДКОКлиент.ОткрытьФайл(СтрВложение.Адрес, СтрВложение.ИмяФайла);
	КонецЕсли;
	
	Если ВыполняемоеОповещение <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЭтоВебКлиент() Экспорт
	
	ЭтоВебКлиент = Ложь;
	#Если ВебКлиент Тогда
		ЭтоВебКлиент = Истина; 
	#КонецЕсли
	
	Возврат ЭтоВебКлиент;
	
КонецФункции

