	Возврат КонтекстЭДОСервер.ПрисоединитьФайлЗаявления(Заявление, АдресФайлаВоВременномХранилище, ИмяДокумента, РасширениеБезТочки);

КонецФункции

&НаКлиенте
Процедура ЗаявлениеЗашифроватьПослеШифрованияФайлаЗаявления(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Выполнено Тогда
		
		Если ДополнительныеПараметры.Свойство("СканыКЗаявлению")
			И (ДополнительныеПараметры.БезбумажноеПродлениеВозможно ИЛИ ДополнительныеПараметры.ЭтоУпрощенноеЗаявление) Тогда
			
			ДополнительныеПараметры.Вставить("ИндексТекущегоСкана", 0);
			ЗаявлениеЗашифровать_ЗашифроватьСканыКЗаявлениюВЦикле(ДополнительныеПараметры);
				
		Иначе
			СформироватьИОтправитьФайлыЗаявления(Результат, ДополнительныеПараметры);
		КонецЕсли;
	Иначе
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеЗашифровать_ЗашифроватьСканыКЗаявлениюВЦикле(ВходящийКонтекст) Экспорт
	
	ИндексТекущегоСкана = ВходящийКонтекст.ИндексТекущегоСкана;
	СканыКЗаявлению 	= ВходящийКонтекст.СканыКЗаявлению;
	
	Если ИндексТекущегоСкана = СканыКЗаявлению.Количество() Тогда
		
		Результат = Новый Структура("Выполнено", Истина);
		СформироватьИОтправитьФайлыЗаявления(Результат, ВходящийКонтекст);
	
	Иначе
		
		ТекущийСкан = СканыКЗаявлению[ИндексТекущегоСкана];
		
		АдресРезультата = ПоместитьВоВременноеХранилище(, Новый УникальныйИдентификатор);
			
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаявлениеЗашифровать_ПослеШифрованияСледующегоСкана", ЭтотОбъект, ВходящийКонтекст);
		
		ОписаниеСкана    = Новый Структура("Адрес,Имя", ТекущийСкан.АдресДанных, "file");
		ЗначениеВМассиве = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОписаниеСкана);
		
		ТекущийСкан.АдресДанных = ОперацииСФайламиЭДКОВызовСервера.УпаковатьФайлы(
			ЗначениеВМассиве, 
			ТекущийСкан.АдресДанных);
			
		МассивСертификатов = Новый Массив;
		МассивСертификатов.Добавить(ВходящийКонтекст.СвойстваСертификатаОператораСвязи);

		// Шифруем файл заявления.
		КриптографияЭДКОКлиент.ЗашифроватьPKCS7(
			ОписаниеОповещения, 
			ТекущийСкан.АдресДанных, 
			МассивСертификатов,
			ТекущийСкан.АдресДанных,
			ВходящийКонтекст.ВыводитьСообщения);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеЗашифровать_ПослеШифрованияСледующегоСкана(Результат, ВходящийКонтекст) Экспорт

	Если Результат.Выполнено Тогда
		
		ВходящийКонтекст.ИндексТекущегоСкана = ВходящийКонтекст.ИндексТекущегоСкана + 1;
		ЗаявлениеЗашифровать_ЗашифроватьСканыКЗаявлениюВЦикле(ВходящийКонтекст);
		
	Иначе
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, Результат);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Функция СкачатьФайлВоВременноеХранилище(Знач URL, ПараметрыПолучения = Неопределено, Знач ЗаписыватьОшибку = Истина) Экспорт
	
	Возврат ПолучениеФайловИзИнтернета.СкачатьФайлВоВременноеХранилище(URL, ПараметрыПолучения, ЗаписыватьОшибку);
	
КонецФункции

&НаКлиенте
Процедура УстановитьСертификатВКонтейнерИХранилище(ДополнительныеПараметры)
	
	Сертификат            = ДополнительныеПараметры.Сертификат;
	ПараметрыФункции      = ДополнительныеПараметры.ПараметрыФункции;
	ВыводитьСообщения     = ДополнительныеПараметры.ВыводитьСообщения;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	ДанныеСертификата = Новый Структура("Сертификат", Base64Значение(Сертификат.Тело));
	МассивИзОдного = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеСертификата);
	ИнформацияОСертификате = КриптографияЭДКОСлужебныйВызовСервера.ИзвлечьИнформациюОКриптопровайдереПоСертификату(
		МассивИзОдного,
		Истина);
		
	Если ИнформацияОСертификате.Количество() > 0 Тогда
		СвойстваКриптопровайдера = ИнформацияОСертификате[0].Криптопровайдер;
		
	Иначе
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
			НСтр("ru = 'Не удалось установить личный сертификат!';
				|en = 'Cannot install a personal certificate.'"),
			ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности,
			ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности,
			ВыводитьСообщения);
		
		Результат = Новый Структура();
		Результат.Вставить("РезультатВыполнения",               Ложь);
		Результат.Вставить("ПараметрыФункции",                  ПараметрыФункции);
		Результат.Вставить("ОшибкаУстановкиЛичногоСертификата", НСтр("ru = 'Не удалось определить криптопровайдер по сертификату';
																	|en = 'Cannot define cryptographic service provider by certificate'"));
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"УстановитьСертификатВКонтейнерИХранилище_ПослеСозданияМенеджераКриптографии", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
	
	КриптографияЭДКОКлиент.СоздатьМенеджерКриптографии(ОписаниеОповещения, Ложь, СвойстваКриптопровайдера, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСертификатВКонтейнерИХранилище_ПослеСозданияМенеджераКриптографии(Результат, ВходящийКонтекст) Экспорт

	Сертификат            = ВходящийКонтекст.Сертификат;
	ПараметрыФункции      = ВходящийКонтекст.ПараметрыФункции;
	ВременныйКаталог      = ВходящийКонтекст.ВременныйКаталог;
	ВыводитьСообщения     = ВходящийКонтекст.ВыводитьСообщения;
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	Если Результат.Выполнено Тогда
		
		Оповещение = Новый ОписаниеОповещения(
			"РегистрацияУстановитьСертификатыУстановкаСертификатовВЦиклеЗавершение", 
			ЭтотОбъект, 
			ВходящийКонтекст);
			
		КриптографияЭДКОКлиент.УстановитьСертификатВКонтейнерИХранилище(
			Оповещение, 
			ВременныйКаталог + Сертификат.Отпечаток + ".cer", 
			ПараметрыФункции.ПутьКонтейнерЗакрытогоКлюча, 
			ВыводитьСообщения И НЕ ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности,
			Результат.МенеджерКриптографии);
			
	Иначе
	
		ОписаниеОшибки = Результат.ОписаниеОшибки;
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
			ОписаниеОшибки,
			ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности,
			ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности,
			ВыводитьСообщения);
		
		Результат = Новый Структура();
		Результат.Вставить("РезультатВыполнения",               Ложь);
		Результат.Вставить("ПараметрыФункции",                  ПараметрыФункции);
		Результат.Вставить("ОшибкаУстановкиЛичногоСертификата", ОписаниеОшибки);
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатныеДокументы_ПечататьДокумент_ПоЗаявлениям(Результат, НижнийКолонтитул)
	
	ФайлыОтчетности = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "ФайлОтчетности"));
	Для Каждого ФайлОтчетности Из ФайлыОтчетности Цикл 
		Кодировка = ?(нрег(Прав(ФайлОтчетности.ИмяФайла, 4)) = ".xml", "windows-1251", "cp866");
		Тело = ПрочитатьТекстИзФайлаСтрокойBase64Клиент(ФайлОтчетности.Файл, Кодировка);
		ПолучитьЭЦП(Файлы.Индекс(ФайлОтчетности));
		
		Представление = ПредставлениеТранспортногоСообщнияПоТипу(ФайлОтчетности.ТранспортноеСообщение);
		
		ПараметрыПечати = КонструкторПечатиПротокола();
		ПараметрыПечати.ТабДок   = СформироватьТабличныйДокументНаОсновеБланка(Представление, ФайлОтчетности.ИмяФайла, Тело, НижнийКолонтитул);
		ПараметрыПечати.Отправка = ФайлОтчетности.ТранспортноеСообщение;
		
		Результат.Добавить(ПараметрыПечати, Представление);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатныеДокументы_ПечататьПодтверждениеДатыОтправки_ПоЗаявлениям(Результат, НижнийКолонтитул)
	
	СтрПодтвержденияДатыОтправки = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "ПодтверждениеДатыОтправки"));
	Для Каждого СтрПодтверждениеДатыОтправки Из СтрПодтвержденияДатыОтправки Цикл 
		
		Тело = ПрочитатьТекстИзФайлаСтрокойBase64Клиент(СтрПодтверждениеДатыОтправки.Файл, "windows-1251");
		ПолучитьЭЦП(Файлы.Индекс(СтрПодтверждениеДатыОтправки));
		
		Представление = ПредставлениеТранспортногоСообщнияПоТипу(СтрПодтверждениеДатыОтправки.ТранспортноеСообщение);
		
		ПараметрыПечати = КонструкторПечатиПротокола();
		ПараметрыПечати.ТабДок   = СформироватьТабличныйДокументНаОсновеПодтвержденияДатыОтправки(Представление, СтрПодтверждениеДатыОтправки.ИмяФайла, Тело, НижнийКолонтитул);
		ПараметрыПечати.Отправка = СтрПодтверждениеДатыОтправки.ТранспортноеСообщение;
		
		Результат.Добавить(ПараметрыПечати, Представление);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатныеДокументы_ПечататьРезультатПриема_ПоЗаявлениям(Результат, НижнийКолонтитул)
	
	СтрРезультатыПриема = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "РезультатПриема"));
	Для Каждого СтрРезультатПриема Из СтрРезультатыПриема Цикл 
		Тело = ПрочитатьТекстИзФайлаСтрокойBase64Клиент(СтрРезультатПриема.Файл, "windows-1251");
		ПолучитьЭЦП(Файлы.Индекс(СтрРезультатПриема));
		
		Представление = ПредставлениеТранспортногоСообщнияПоТипу(СтрРезультатПриема.ТранспортноеСообщение);
		
		Если СтрРезультатПриема.Тип = СтруктураСсылочныхДанных["Перечисления_ТипыСодержимогоТранспортногоКонтейнера_УведомлениеОбОтказеДокумент"] Тогда 
			
			ТабДок = СформироватьТабличныйДокументНаОсновеУведомленияОбОтказеВПриемеНалоговойДекларацииЗаявление(Представление, СтрРезультатПриема.ИмяФайла, Тело, НижнийКолонтитул);
			
			ПараметрыПечати = КонструкторПечатиПротокола();
			ПараметрыПечати.ТабДок   = ТабДок;
			ПараметрыПечати.Отправка = СтрРезультатПриема.ТранспортноеСообщение;
			
			Результат.Добавить(ПараметрыПечати, Представление);
			
		Иначе
			
			ТаблДок = СформироватьТабличныйДокументНаОсновеКвитанцииОПриемеЗаявление(Представление, СтрРезультатПриема.ИмяФайла, Тело, НижнийКолонтитул);
			
			ПараметрыПечати = КонструкторПечатиПротокола();
			ПараметрыПечати.ТабДок   = ТаблДок;
			ПараметрыПечати.Отправка = СтрРезультатПриема.ТранспортноеСообщение;
			
			Результат.Добавить(ПараметрыПечати, Представление);
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатныеДокументы_ПечататьРезультатОбработки_ПоЗаявлениям(Результат, НижнийКолонтитул)
	
	СтрРезультатыОбработки = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "РезультатОбработки"));
	Для Каждого СтрРезультатОбработки Из СтрРезультатыОбработки Цикл
		Тело = ПрочитатьТекстИзФайлаСтрокойBase64Клиент(СтрРезультатОбработки.Файл, "windows-1251");
		ПолучитьЭЦП(Файлы.Индекс(СтрРезультатОбработки));
		
		Если СтрРезультатОбработки.Тип = СтруктураСсылочныхДанных["Перечисления_ТипыСодержимогоТранспортногоКонтейнера_СообщениеОПроверке"] Тогда 
			
			Представление = "Сообщение о проверке";
			
			ТаблДок = СформироватьТабличныйДокументнаОсновеСообщенияОПроверке(Представление, СтрРезультатОбработки.ИмяФайла, Тело, НижнийКолонтитул);
			
			ПараметрыПечати = КонструкторПечатиПротокола();
			ПараметрыПечати.ТабДок   = ТаблДок;
			ПараметрыПечати.Отправка = СтрРезультатОбработки.ТранспортноеСообщение;
			
			Результат.Добавить(ПараметрыПечати, Представление);
			
		ИначеЕсли СтрРезультатОбработки.Тип = СтруктураСсылочныхДанных["Перечисления_ТипыСодержимогоТранспортногоКонтейнера_СообщениеОПростОтметки"] Тогда 
			
			Представление = "Сообщение о проставлении отметки";
			
			ТаблДок = СформироватьТабличныйДокументНаОсновеСообщенияОПростОтметки(Представление, СтрРезультатОбработки.ИмяФайла, Тело, НижнийКолонтитул);
			
			ПараметрыПечати = КонструкторПечатиПротокола();
			ПараметрыПечати.ТабДок   = ТаблДок;
			ПараметрыПечати.Отправка = СтрРезультатОбработки.ТранспортноеСообщение;
			
			Результат.Добавить(ПараметрыПечати, Представление);
			
