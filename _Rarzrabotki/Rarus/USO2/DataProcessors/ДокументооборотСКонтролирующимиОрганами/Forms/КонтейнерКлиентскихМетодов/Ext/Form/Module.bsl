//        ** НастройкиОбменаМинобороны_ИспользоватьОбмен - Булево.
//        ** НастройкиОбменаМинобороны_СертификатАбонентаОтпечаток - Строка.
//        ** НастройкиОбменаМинобороны_СвойстваСертификатаАбонента - Структура    - описание см. КриптографияЭДКОКлиент.НайтиСертификаты,
//                                                                                  присутствует, если
//                                                                                  Настройки.НайтиСертификатыПрочихКонтролирующихОрганов = Истина.
//                                                                 - Неопределено - если ПоискСертификатовВыполнен = Ложь.
//                                                                 - отсутствует  - при ПоискТолькоСертификатовУчетныхЗаписей = Истина.
//        ** ЗаявлениеАбонентаСпецоператораСвязи_Ссылка - Документы.ЗаявлениеАбонентаСпецоператораСвязи - последнего заявления.
//        ** ЗаявлениеАбонентаСпецоператораСвязи_ТипЗаявления - ПеречислениеСсылка.ТипыЗаявленияАбонентаСпецоператораСвязи - последнего заявления.
//        ** ЗаявлениеАбонентаСпецоператораСвязи_Статус - ПеречислениеСсылка.СтатусыЗаявленияАбонентаСпецоператораСвязи - последнего заявления.
//        ** ЗаявлениеАбонентаСпецоператораСвязи_СтатусКомментарий - Строка - последнего заявления.
//        ** ЗаявлениеАбонентаСпецоператораСвязи_НастройкаЗавершена - Булево - последнего заявления.
//        ** ЗаявлениеАбонентаСпецоператораСвязи_Дата - Дата - последнего заявления.
//                                                      Неопределено.
//        ** ЗаявлениеАбонентаСпецоператораСвязи_ДатаПолученияОтвета - Дата - дата получения ответа первого одобоенного заявления,
//                                                                            настройка для которого завершена.
//                                                                     Неопределено.
//        ** ПризнакПоддержкиФНС                     - Булево - признак поддержки ФНС в конфигурации для организации, с учетом
//                                                              ПоддерживаемыеНаправленияДляОператоров, если запрошено их получение.
//        ** ПризнакПоддержкиПФР                     - Булево - признак поддержки ПФР в конфигурации для организации, с учетом
//                                                              ПоддерживаемыеНаправленияДляОператоров, если запрошено их получение.
//        ** ПризнакПоддержкиФСГС                    - Булево - признак поддержки Росстата в конфигурации для организации, с учетом
//                                                              ПоддерживаемыеНаправленияДляОператоров, если запрошено их получение.
//        ** ПризнакПоддержкиФСС                     - Булево - признак поддержки ФСС в конфигурации для организации, с учетом
//                                                              ПоддерживаемыеНаправленияДляОператоров, если запрошено их получение.
//        ** ПризнакПоддержкиФСРАР                   - Булево - признак поддержки ФСРАР в конфигурации для организации, с учетом
//                                                              ПоддерживаемыеНаправленияДляОператоров, если запрошено их получение.
//        ** ПризнакПоддержкиРПН                     - Булево - признак поддержки РПН в конфигурации для организации, с учетом
//                                                              ПоддерживаемыеНаправленияДляОператоров, если запрошено их получение.
//        ** ПризнакПоддержкиФТС                     - Булево - признак поддержки ФТС в конфигурации для организации, с учетом
//                                                              ПоддерживаемыеНаправленияДляОператоров, если запрошено их получение.
//
//  Ссылки - Массив - СправочникСсылка.Организации.
//         - СправочникСсылка.Организации.
//         - СправочникСсылка.УчетныеЗаписиДокументооборота.
//         - ДокументСсылка или СправочникСсылка объекта, содержащего реквизит "Организация", например,
//           ДокументСсылка.ЗаявлениеАбонентаСпецоператораСвязи.
//
//  Настройки - Неопределено.
//            - Структура:
//    * НайтиСертификатыПрочихКонтролирующихОрганов       - Булево - при Истина искать сертификаты ФСС, ФСРАР, РПН, ФТС, Банка России.
//    * ПолучитьРеквизитыКонтролирующихОргановОрганизации - Булево - при Истина получать реквизиты результата: КодНО,
//                                                                   КодОрганаФСГС, КППЮЛ, РегНомПФР, РегистрационныйНомерФСС.
//    * ПолучатьДляУдаленныхОрганизаций                   - Булево - по умолчанию Истина.
//    * ПолучатьПоддерживаемыеНаправленияДляОператоров    - Булево - по умолчанию Истина.
//
&НаКлиенте
Процедура НастройкиОбменаОрганизаций(
		ОповещениеОЗавершении,
		Ссылки = Неопределено,
		Настройки = Неопределено) Экспорт
	
	НастройкиВызова = Новый Структура;
	НастройкиВызова.Вставить("НайтиСертификатыПрочихКонтролирующихОрганов", Ложь);
	Если Настройки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НастройкиВызова, Настройки);
	КонецЕсли;
	
	НастройкиОбменаИПараметры = НастройкиОбменаОрганизацийНаСервере(Ссылки, Настройки);
	НастройкиОбмена = НастройкиОбменаИПараметры.НастройкиОбмена;
	
	УникальныеСертификаты = Новый Соответствие;
	
	КлючиОтпечатковСертификатов = Новый Массив;
	КлючиОтпечатковСертификатов.Добавить("СертификатРуководителя");
	Если НастройкиВызова.НайтиСертификатыПрочихКонтролирующихОрганов Тогда
		КлючиОтпечатковСертификатов.Добавить("НастройкиОбменаФСС_СертификатСтрахователяОтпечаток");
		КлючиОтпечатковСертификатов.Добавить("НастройкиОбменаФСРАР_СертификатАбонентаОтпечаток");
		КлючиОтпечатковСертификатов.Добавить("НастройкиОбменаРПН_СертификатАбонентаОтпечаток");
		КлючиОтпечатковСертификатов.Добавить("НастройкиОбменаФТС_СертификатАбонентаОтпечаток");
		КлючиОтпечатковСертификатов.Добавить("НастройкиОбменаБанкРоссии_СертификатАбонентаОтпечаток");
		КлючиОтпечатковСертификатов.Добавить("НастройкиОбменаМО_СертификатАбонентаОтпечаток");
	КонецЕсли;
	
	Для ИндексОрганизации = 0 По НастройкиОбмена.Количество() - 1 Цикл
		НастройкаОбмена = НастройкиОбмена[ИндексОрганизации];
		
		Для каждого КлючОтпечаткаСертификата Из КлючиОтпечатковСертификатов Цикл
			ОтпечатокСертификата = "";
			НастройкаОбмена.Свойство(КлючОтпечаткаСертификата, ОтпечатокСертификата);
			
			Если ЗначениеЗаполнено(ОтпечатокСертификата) Тогда
				ПредставлениеОтпечатка = ОтпечатокСертификата + "_" + ?(НастройкаОбмена.ЭлектроннаяПодписьВМоделиСервиса, "1", "0");
				СертификатыВНастройках = УникальныеСертификаты[ПредставлениеОтпечатка];
				Если СертификатыВНастройках = Неопределено Тогда
					СертификатыВНастройках = Новый Массив;
				КонецЕсли;
				
				СертификатВНастройках = Новый Структура("ИндексОрганизации, КлючОтпечаткаСертификата",
					ИндексОрганизации, КлючОтпечаткаСертификата);
				СертификатыВНастройках.Добавить(СертификатВНастройках);
				УникальныеСертификаты[ПредставлениеОтпечатка] = СертификатыВНастройках;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ЕстьЛокальнаяЭлектроннаяПодпись = Ложь;
	ЕстьЭлектроннаяПодписьВМоделиСервиса = Ложь;
	СертификатыДляПоиска = Новый Массив;
	Для каждого УникальныйСертификат Из УникальныеСертификаты Цикл
		СертификатВНастройках = УникальныйСертификат.Значение[0];
		НастройкаОбмена = НастройкиОбмена[СертификатВНастройках.ИндексОрганизации];
		ОтпечатокСертификата = "";
		НастройкаОбмена.Свойство(СертификатВНастройках.КлючОтпечаткаСертификата, ОтпечатокСертификата);
		
		СертификатДляПоиска = Новый Структура("Отпечаток, ЭтоЭлектроннаяПодписьВМоделиСервиса",
			ОтпечатокСертификата, НастройкаОбмена.ЭлектроннаяПодписьВМоделиСервиса);
		СертификатыДляПоиска.Добавить(СертификатДляПоиска);
		
		Если НастройкаОбмена.ЭлектроннаяПодписьВМоделиСервиса Тогда
			ЕстьЭлектроннаяПодписьВМоделиСервиса = Истина;
		Иначе
			ЕстьЛокальнаяЭлектроннаяПодпись = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("НайтиСертификатыПрочихКонтролирующихОрганов", 	НастройкиВызова.НайтиСертификатыПрочихКонтролирующихОрганов);
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", 							ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("НастройкиОбменаИПараметры", 						НастройкиОбменаИПараметры);
	ДополнительныеПараметры.Вставить("УникальныеСертификаты", 							УникальныеСертификаты);
	ДополнительныеПараметры.Вставить("КлючиОтпечатковСертификатов", 					КлючиОтпечатковСертификатов);
	ДополнительныеПараметры.Вставить("СертификатыДляПоиска", 							СертификатыДляПоиска);
	ДополнительныеПараметры.Вставить("ЕстьЛокальнаяЭлектроннаяПодпись", 				ЕстьЛокальнаяЭлектроннаяПодпись);
	ДополнительныеПараметры.Вставить("ЕстьЭлектроннаяПодписьВМоделиСервиса", 			ЕстьЭлектроннаяПодписьВМоделиСервиса);
	Оповещение = Новый ОписаниеОповещения(
		"НастройкиОбменаОрганизацийПослеСозданияМенеджераКриптографии", ЭтотОбъект, ДополнительныеПараметры);
	Если ЕстьЛокальнаяЭлектроннаяПодпись Тогда
		КриптографияЭДКОКлиент.СоздатьМенеджерКриптографии(Оповещение, Ложь,, Истина);
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОбменаОрганизацийПослеСозданияМенеджераКриптографии(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатыДляПоиска 					= ДополнительныеПараметры.СертификатыДляПоиска;
	ЕстьЛокальнаяЭлектроннаяПодпись 		= ДополнительныеПараметры.ЕстьЛокальнаяЭлектроннаяПодпись;
	ЕстьЭлектроннаяПодписьВМоделиСервиса 	= ДополнительныеПараметры.ЕстьЭлектроннаяПодписьВМоделиСервиса;
	
	Оповещение = Новый ОписаниеОповещения(
		"НастройкиОбменаОрганизацийПослеПоискаСертификатов", ЭтотОбъект, ДополнительныеПараметры);
	
	Если СертификатыДляПоиска.Количество() <= 3 Тогда
		КриптографияЭДКОКлиент.НайтиСертификаты(Оповещение, СертификатыДляПоиска,, Ложь);
		
	Иначе
		ХранилищаСертификатов = Новый Массив;
		Если ЕстьЛокальнаяЭлектроннаяПодпись Тогда
			Хранилище = Новый Структура("Хранилище, ЭтоЛокальноеХранилище", "MY", Истина);
			ХранилищаСертификатов.Добавить(Хранилище);
		КонецЕсли;
		Если ЕстьЭлектроннаяПодписьВМоделиСервиса Тогда
			Хранилище = Новый Структура("Хранилище, ЭтоЛокальноеХранилище", "MY", Ложь);
			ХранилищаСертификатов.Добавить(Хранилище);
		КонецЕсли;
		
		ДополнительныеПараметрыВызова = Новый Структура;
		ДополнительныеПараметрыВызова.Вставить("ПредлагатьУстановкуВнешнейКомпоненты", 	Истина);
		ДополнительныеПараметрыВызова.Вставить("ВыводитьСообщения", 					Ложь);
		
		КриптографияЭДКОКлиент.ПолучитьСертификаты(Оповещение, ХранилищаСертификатов, ДополнительныеПараметрыВызова);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОбменаОрганизацийПослеПоискаСертификатов(Результат, ДополнительныеПараметры) Экспорт
	
	НайтиСертификатыПрочихКонтролирующихОрганов 	= ДополнительныеПараметры.НайтиСертификатыПрочихКонтролирующихОрганов;
	ОповещениеОЗавершении 							= ДополнительныеПараметры.ОповещениеОЗавершении;
	НастройкиОбменаИПараметры 						= ДополнительныеПараметры.НастройкиОбменаИПараметры;
	УникальныеСертификаты 							= ДополнительныеПараметры.УникальныеСертификаты;
	КлючиОтпечатковСертификатов 					= ДополнительныеПараметры.КлючиОтпечатковСертификатов;
	
	НастройкиОбмена = НастройкиОбменаИПараметры.НастройкиОбмена;
	
	КлючиСвойствСертификатов = Новый Массив;
	КлючиСвойствСертификатов.Добавить("СвойстваСертификатаРуководителя");
	Если НайтиСертификатыПрочихКонтролирующихОрганов Тогда
		КлючиСвойствСертификатов.Добавить("НастройкиОбменаФСС_СвойстваСертификатаСтрахователя");
		КлючиСвойствСертификатов.Добавить("НастройкиОбменаФСРАР_СвойстваСертификатаАбонента");
		КлючиСвойствСертификатов.Добавить("НастройкиОбменаРПН_СвойстваСертификатаАбонента");
		КлючиСвойствСертификатов.Добавить("НастройкиОбменаФТС_СвойстваСертификатаАбонента");
		КлючиСвойствСертификатов.Добавить("НастройкиОбменаБанкРоссии_СвойстваСертификатаАбонента");
		КлючиСвойствСертификатов.Добавить("НастройкиОбменаМО_СвойстваСертификатаАбонента");
	КонецЕсли;
	КлючиСвойствПоКлючамОтпечатков = Новый Соответствие;
	Для ИндексКлюча = 0 По КлючиОтпечатковСертификатов.Количество() - 1 Цикл
		КлючОтпечаткаСертификата = КлючиОтпечатковСертификатов[ИндексКлюча];
		КлючиСвойствПоКлючамОтпечатков[КлючОтпечаткаСертификата] = КлючиСвойствСертификатов[ИндексКлюча];
	КонецЦикла;
	
	Для каждого НастройкаОбмена Из НастройкиОбмена Цикл
		Для каждого КлючСвойствСертификата Из КлючиСвойствСертификатов Цикл
			НастройкаОбмена.Вставить(КлючСвойствСертификата, Неопределено);
		КонецЦикла;
	КонецЦикла;
	
	Если НЕ Результат.Выполнено Тогда
		РезультатВыполнения = НастройкиОбменаИПараметры;
		РезультатВыполнения.Вставить("ПоискСертификатовВыполнен", Ложь);
		РезультатВыполнения.НастройкиОбмена = НастройкиОбмена;
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	Для каждого НайденныйСертификат Из Результат.Сертификаты Цикл
		Если НайденныйСертификат.Свойство("ЭтоЭлектроннаяПодписьВМоделиСервиса") Тогда
			ЭтоЭлектроннаяПодписьВМоделиСервиса = (НайденныйСертификат.ЭтоЭлектроннаяПодписьВМоделиСервиса = Истина);
		ИначеЕсли НайденныйСертификат.Свойство("ЭлектроннаяПодписьВМоделиСервиса") Тогда
			ЭтоЭлектроннаяПодписьВМоделиСервиса = (НайденныйСертификат.ЭлектроннаяПодписьВМоделиСервиса = Истина);
		Иначе
			ЭтоЭлектроннаяПодписьВМоделиСервиса = Неопределено;
		КонецЕсли;
		
		Если ЭтоЭлектроннаяПодписьВМоделиСервиса <> Неопределено Тогда
			ПредставлениеОтпечатка = НайденныйСертификат.Отпечаток + "_" + ?(ЭтоЭлектроннаяПодписьВМоделиСервиса, "1", "0");
			СертификатыВНастройках = УникальныеСертификаты[ПредставлениеОтпечатка];
		Иначе
			ПредставлениеОтпечатка = НайденныйСертификат.Отпечаток + "_0";
			СертификатыВНастройках = УникальныеСертификаты[ПредставлениеОтпечатка];
			Если СертификатыВНастройках = Неопределено Тогда
				ПредставлениеОтпечатка = НайденныйСертификат.Отпечаток + "_1";
				СертификатыВНастройках = УникальныеСертификаты[ПредставлениеОтпечатка];
			КонецЕсли;
		КонецЕсли;
		Если СертификатыВНастройках = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого СертификатВНастройках Из СертификатыВНастройках Цикл
			НастройкаОбмена = НастройкиОбмена[СертификатВНастройках.ИндексОрганизации];
			КлючСвойствСертификата = КлючиСвойствПоКлючамОтпечатков[СертификатВНастройках.КлючОтпечаткаСертификата];
			НастройкаОбмена[КлючСвойствСертификата] = НайденныйСертификат;
		КонецЦикла;
	КонецЦикла;
	
	РезультатВыполнения = НастройкиОбменаИПараметры;
	РезультатВыполнения.Вставить("ПоискСертификатовВыполнен", Истина);
	РезультатВыполнения.НастройкиОбмена = НастройкиОбмена;
	ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, РезультатВыполнения);
	
КонецПроцедуры

&НаКлиенте
Функция СтатусЗаявленияСтрокой(
		Статус,
		НастройкаЗавершена,
		ЦветУспеха = Неопределено,
		ЦветОшибки = Неопределено,
		ЦветНеактивного = Неопределено,
		ВерхнийРегистрПервойБуквы = Истина,
		КраткийСтатус = Ложь) Экспорт
	
	ЦветСтатуса = Неопределено;
	ВыделениеНезавершенного = Ложь;
	Если Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено") Тогда
		Если НастройкаЗавершена Тогда
			СтатусСтрокой 	= НСтр("ru = 'Отклонено';
									|en = 'Rejected'");
		Иначе
			Если КраткийСтатус Тогда
				СтатусСтрокой 	= НСтр("ru = 'Отклонено';
										|en = 'Rejected'");
			Иначе
				СтатусСтрокой 	= НСтр("ru = 'Отклонено, настройка не завершена';
										|en = 'Rejected, setting is not completed'");
			КонецЕсли;
			ВыделениеНезавершенного = Истина;
		КонецЕсли;
		ЦветСтатуса = ЦветОшибки;
		
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено") Тогда
		Если НастройкаЗавершена ИЛИ КраткийСтатус Тогда
			СтатусСтрокой 	= НСтр("ru = 'Одобрено';
									|en = 'Approved'");
			ЦветСтатуса 	= ЦветУспеха;
		Иначе
			Если КраткийСтатус Тогда
				СтатусСтрокой 	= НСтр("ru = 'Одобрено';
										|en = 'Approved'");
			Иначе
				СтатусСтрокой 	= НСтр("ru = 'Одобрено, настройка не завершена';
										|en = 'Approved, setting is not completed'");
			КонецЕсли;
			ВыделениеНезавершенного = Истина;
		КонецЕсли;
		
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено") Тогда
		СтатусСтрокой 		= НСтр("ru = 'Отправлено';
									|en = 'Sent'");
		
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Подготовлено") Тогда
		СтатусСтрокой 		= НСтр("ru = 'Не отправлено';
									|en = 'Not sent'");
		ЦветСтатуса 		= ЦветНеактивного;
		
	Иначе
		СтатусСтрокой = Строка(Статус);
	КонецЕсли;
	
	Если НЕ ВерхнийРегистрПервойБуквы И ЗначениеЗаполнено(СтатусСтрокой) Тогда
		ПерваяБукваСтатуса = Лев(СтатусСтрокой, 1);
		СтатусСтрокой = нрег(ПерваяБукваСтатуса) + Сред(СтатусСтрокой, 2);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("СтатусСтрокой", 			СтатусСтрокой);
	Результат.Вставить("ЦветСтатуса", 				ЦветСтатуса);
	Результат.Вставить("ВыделениеНезавершенного", 	ВыделениеНезавершенного);
	
	Возврат Результат;
	
КонецФункции

// Выводит список значений в формате "Вы, Администратор и еще 18" при КоличествоВыводимыхИмен = 3.
&НаКлиенте
Функция СписокПользователейСтрокой(СписокПользователей, УчетнаяЗаписьДоступна = Истина, КоличествоВыводимыхИмен = 2) Экспорт
	
	ТекущийПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	ТекущийПользовательВСписке = СписокПользователей.НайтиПоЗначению(ТекущийПользователь);
	
	Результат = "";
	ЭтоВсеПользователи = СписокПользователей.Количество() > 0;
	ЭтоТолькоВы = ТекущийПользовательВСписке <> Неопределено И ТекущийПользовательВСписке.Пометка;
	ПоследнийВыводимыйПользователь = ?(ЭтоТолькоВы, НСтр("ru = 'Вы';
														|en = 'You'"), Неопределено);
	КоличествоПользователей = ?(ЭтоТолькоВы, 1, 0);
	
	Для каждого ЭлементСпискаПользователей Из СписокПользователей Цикл
		Если ЭлементСпискаПользователей.Пометка И ЭлементСпискаПользователей.Значение <> ТекущийПользователь Тогда
			ЭтоТолькоВы = Ложь;
			Если КоличествоПользователей < КоличествоВыводимыхИмен Тогда
				Если ПоследнийВыводимыйПользователь <> Неопределено Тогда
					Результат = Результат + ?(КоличествоПользователей > 1, ", ", "") + ПоследнийВыводимыйПользователь;
					ПоследнийВыводимыйПользователь = Неопределено;
				КонецЕсли;
				ПоследнийВыводимыйПользователь = ЭлементСпискаПользователей.Представление;
			КонецЕсли;
			КоличествоПользователей = КоличествоПользователей + 1;
		КонецЕсли;
		Если НЕ ЭлементСпискаПользователей.Пометка Тогда
			ЭтоВсеПользователи = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если ЭтоВсеПользователи Тогда
		Результат = НСтр("ru = 'Все пользователи';
						|en = 'All users'");
		
	ИначеЕсли ЭтоТолькоВы Тогда
		Результат = НСтр("ru = 'Только Вы';
						|en = 'Only you'");
		
	Иначе
		Если ПоследнийВыводимыйПользователь <> Неопределено И КоличествоПользователей <= КоличествоВыводимыхИмен Тогда
			Результат = Результат + ?(КоличествоПользователей > 1, " "
				+ СтрШаблон(
					НСтр("ru = 'и %1';
						|en = 'and %1'"),
					ПоследнийВыводимыйПользователь),
				ПоследнийВыводимыйПользователь);
		КонецЕсли;
		
		Если КоличествоПользователей > КоличествоВыводимыхИмен Тогда
			Результат = Результат + " " + СтрШаблон(
				НСтр("ru = 'и еще %1';
					|en = 'and also %1'"),
				Строка(КоличествоПользователей - КоличествоВыводимыхИмен + 1));
		КонецЕсли;
		
		Если КоличествоПользователей = 0 И УчетнаяЗаписьДоступна Тогда
			Результат = НСтр("ru = '<не выбраны>';
							|en = '<not selected>'");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция НаправленияСтрокой(ЭлементНастроекОбмена,
	ПоддерживаетсяСдачаОтчетностиВБанкРоссии = Ложь,
	ПоддерживаетсяСдачаОтчетностиВМинобороны = Ложь) Экспорт
	
	ПредставленияОрганов = Новый Массив;
	ЭтоВсеНаправления = Истина;
	
	Если ЭлементНастроекОбмена.ПризнакПоддержкиФНС ИЛИ ЭлементНастроекОбмена.ПредназначенаДляДокументооборотаСФНС Тогда
		Если ЭлементНастроекОбмена.ПредназначенаДляДокументооборотаСФНС Тогда
			КоличествоОрганов = ЭлементНастроекОбмена.КодыФНС.Количество();
			Если КоличествоОрганов > 1 Тогда
				ПредставлениеОргана = СтрШаблон(
					НСтр("ru = 'ФНС(%1)';
						|en = 'FTS(%1)'"),
					КоличествоОрганов)
			Иначе
				ПредставлениеОргана = НСтр("ru = 'ФНС';
											|en = 'FTS'");
			КонецЕсли;
			ПредставленияОрганов.Добавить(ПредставлениеОргана);
		Иначе
			ЭтоВсеНаправления = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭлементНастроекОбмена.ПризнакПоддержкиПФР ИЛИ ЭлементНастроекОбмена.ПредназначенаДляДокументооборотаСПФР Тогда
		Если ЭлементНастроекОбмена.ПредназначенаДляДокументооборотаСПФР Тогда
			ПредставлениеОргана = НСтр("ru = 'ПФР';
										|en = 'PF'");
			ПредставленияОрганов.Добавить(ПредставлениеОргана);
		Иначе
			ЭтоВсеНаправления = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭлементНастроекОбмена.ПризнакПоддержкиФСГС ИЛИ ЭлементНастроекОбмена.ПредназначенаДляДокументооборотаСФСГС Тогда
		Если ЭлементНастроекОбмена.ПредназначенаДляДокументооборотаСФСГС Тогда
			КоличествоОрганов = ЭлементНастроекОбмена.КодыФСГС.Количество();
			Если КоличествоОрганов > 1 Тогда
				ПредставлениеОргана = СтрШаблон(
					НСтр("ru = 'Росстат(%1)';
						|en = 'Russian Federal State Statistics Service(%1)'"),
					КоличествоОрганов)
			Иначе
				ПредставлениеОргана = НСтр("ru = 'Росстат';
											|en = 'Russian Federal State Statistics Service'");
			КонецЕсли;
			ПредставленияОрганов.Добавить(ПредставлениеОргана);
		Иначе
			ЭтоВсеНаправления = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭлементНастроекОбмена.ПризнакПоддержкиФСС ИЛИ ЭлементНастроекОбмена.НастройкиОбменаФСС_ИспользоватьОбмен Тогда
		Если ЭлементНастроекОбмена.НастройкиОбменаФСС_ИспользоватьОбмен Тогда
			ПредставлениеОргана = НСтр("ru = 'ФСС';
										|en = 'SSF'");
			ПредставленияОрганов.Добавить(ПредставлениеОргана);
		Иначе
			ЭтоВсеНаправления = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭлементНастроекОбмена.ПризнакПоддержкиФСРАР ИЛИ ЭлементНастроекОбмена.НастройкиОбменаФСРАР_ИспользоватьОбмен Тогда
		Если ЭлементНастроекОбмена.НастройкиОбменаФСРАР_ИспользоватьОбмен Тогда
			ПредставлениеОргана = НСтр("ru = 'ФСРАР';
										|en = 'FSAMR'");
			ПредставленияОрганов.Добавить(ПредставлениеОргана);
		Иначе
			ЭтоВсеНаправления = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭлементНастроекОбмена.ПризнакПоддержкиРПН ИЛИ ЭлементНастроекОбмена.НастройкиОбменаРПН_ИспользоватьОбмен Тогда
		Если ЭлементНастроекОбмена.НастройкиОбменаРПН_ИспользоватьОбмен Тогда
			ПредставлениеОргана = НСтр("ru = 'РПН';
										|en = 'RPN'");
			ПредставленияОрганов.Добавить(ПредставлениеОргана);
		Иначе
			ЭтоВсеНаправления = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭлементНастроекОбмена.ПризнакПоддержкиФТС ИЛИ ЭлементНастроекОбмена.НастройкиОбменаФТС_ИспользоватьОбмен Тогда
		Если ЭлементНастроекОбмена.НастройкиОбменаФТС_ИспользоватьОбмен Тогда
			ПредставлениеОргана = НСтр("ru = 'ФТС';
										|en = 'FCS'");
			ПредставленияОрганов.Добавить(ПредставлениеОргана);
		Иначе
			ЭтоВсеНаправления = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ПоддерживаетсяСдачаОтчетностиВБанкРоссии ИЛИ ЭлементНастроекОбмена.НастройкиОбменаБанкРоссии_ИспользоватьОбмен Тогда
		Если ЭлементНастроекОбмена.НастройкиОбменаБанкРоссии_ИспользоватьОбмен Тогда
			ПредставлениеОргана = НСтр("ru = 'Банк России';
										|en = 'The Bank Of Russia'");
			ПредставленияОрганов.Добавить(ПредставлениеОргана);
		Иначе
			ЭтоВсеНаправления = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ПоддерживаетсяСдачаОтчетностиВМинобороны ИЛИ ЭлементНастроекОбмена.НастройкиОбменаМинобороны_ИспользоватьОбмен Тогда
		Если ЭлементНастроекОбмена.НастройкиОбменаМинобороны_ИспользоватьОбмен Тогда
			ПредставлениеОргана = НСтр("ru = 'Минобороны';
										|en = 'Ministry of Defense'");
			ПредставленияОрганов.Добавить(ПредставлениеОргана);
		Иначе
			ЭтоВсеНаправления = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Результат = "";
	
	КоличествоПредставленийОрганов = ПредставленияОрганов.Количество();
	Если КоличествоПредставленийОрганов > 0 Тогда
		Если ЭтоВсеНаправления Тогда
			Результат = НСтр("ru = 'Все направления';
							|en = 'All lines of business'");
			
		ИначеЕсли КоличествоПредставленийОрганов = 1 Тогда
			Результат = ПредставленияОрганов[0];
			
		Иначе
			ПоследнееПредставлениеОргана = ПредставленияОрганов[КоличествоПредставленийОрганов - 1];
			ПредставленияОрганов.Удалить(КоличествоПредставленийОрганов - 1);
			Результат = СтрСоединить(ПредставленияОрганов, ", ") + " "
				+ СтрШаблон(
					НСтр("ru = 'и %1';
						|en = 'and %1'"),
					ПоследнееПредставлениеОргана);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьФормуСтатусовОтправкиИлиОбновитьЗаявление(
		Заявление,
		Статус = Неопределено,
		НастройкаЗавершена = Истина,
		Организация = Неопределено,
		ПринудительноОбновить = Ложь) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Заявление) Тогда
		Возврат;
	КонецЕсли;
	
	// проверяем, было ли отправлено заявление
	Если Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Подготовлено")
		ИЛИ Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено")
		ИЛИ Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено") И НастройкаЗавершена Тогда
		
		ПоказатьЗначение(, Заявление);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) И (ПринудительноОбновить ИЛИ
		(Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено")
		ИЛИ Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено"))
		И НЕ НастройкаЗавершена) Тогда
		
		ДополнительныеПараметры = Новый Структура("Организация, Заявление", Организация, Заявление);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПоказатьФормуСтатусовОтправкиИлиОбновитьЗаявлениеПослеОбновленияСтатуса",
			ЭтотОбъект, ДополнительныеПараметры);
		
		ОбновитьСтатусЗаявленияАбонента_ИзПанелиОтправки(ОписаниеОповещения, ЭтотОбъект, Заявление);
		Возврат;
	КонецЕсли;
	
	ПоказатьФормуСтатусовОтправки(Заявление);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФормуСтатусовОтправкиИлиОбновитьЗаявлениеПослеОбновленияСтатуса(Результат, ДополнительныеПараметры) Экспорт
	
	Организация = ДополнительныеПараметры.Организация;
	Заявление 	= ДополнительныеПараметры.Заявление;
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("Организация", Организация);
	ПараметрыОповещения.Вставить("Заявление", 	Заявление);
	
	Оповестить("Завершение отправки", ПараметрыОповещения, Заявление);
	
КонецПроцедуры

&НаКлиенте
Функция СрокиПредупрежденийНастроекОбменов(ТекущаяДатаНаСервере) Экспорт
	
	СколькоДнейПоказыватьСтатусЗаявления 	= 60;
	ЗаСколькоДнейСчитатьИсткающим 			= 14;
	
	ТекущаяДатаОкончанияПоказаЗаявления = ТекущаяДатаНаСервере - СколькоДнейПоказыватьСтатусЗаявления * 24 * 60 * 60;
	ТекущаяДатаИстечения 				= ТекущаяДатаНаСервере + ЗаСколькоДнейСчитатьИсткающим * 24 * 60 * 60;
	
	Результат = Новый Структура;
	Результат.Вставить("ТекущаяДатаОкончанияПоказаЗаявления", 	ТекущаяДатаОкончанияПоказаЗаявления);
	Результат.Вставить("ТекущаяДатаИстечения", 					ТекущаяДатаИстечения);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СтатусДействительностиСтрокой(
		ДействителенПо,
		ТекущаяДатаНаСервере,
		ТекущаяДатаИстечения,
		ЭтоСертификат = Истина,
		ЦветОшибки = Неопределено,
		ВерхнийРегистрПервойБуквы = Ложь,
		НаименованиеОбъекта = "") Экспорт
	
	ЦветСтатуса = Неопределено;
	ТребуетПродления = Ложь;
	Если НЕ ЗначениеЗаполнено(ДействителенПо) Тогда
		СтатусСтрокой = НСтр("ru = 'с недоступным сроком действия';
							|en = 'with unavailable validity period'")
			+ ?(ЗначениеЗаполнено(НаименованиеОбъекта), " (" + НаименованиеОбъекта + ")", "");
		
	Иначе
		Если ДействителенПо < ТекущаяДатаНаСервере Тогда
			СтатусСтрокой 		= ?(ЭтоСертификат, НСтр("ru = 'истек %1';
															|en = 'expired %1'"), НСтр("ru = 'истекла %1';
																					|en = 'expired %1'"));
			ЦветСтатуса 		= ЦветОшибки;
			ТребуетПродления 	= Истина;
			
		ИначеЕсли ДействителенПо <= ТекущаяДатаИстечения Тогда
			СтатусСтрокой 		= НСтр("ru = 'истекает %1';
										|en = '%1 expires'");
			ЦветСтатуса 		= ЦветОшибки;
			ТребуетПродления 	= Истина;
			
		Иначе
			СтатусСтрокой = НСтр("ru = 'действует до %1';
								|en = 'valid until %1'");
		КонецЕсли;
		
		ДействителенПоСтрокой = ?(ЭтоСертификат, Формат(ДействителенПо, "ДЛФ=ДД"), Формат(ДействителенПо, "ДЛФ=ДД"));
		
		СтатусСтрокой = СтрШаблон(СтатусСтрокой, ДействителенПоСтрокой);
		СтатусСтрокой = СтатусСтрокой + ?(ЗначениеЗаполнено(НаименованиеОбъекта), " (" + НаименованиеОбъекта + ")", "");
	КонецЕсли;
	
	Если ВерхнийРегистрПервойБуквы И ЗначениеЗаполнено(СтатусСтрокой) Тогда
		ПерваяБукваСтатуса = Лев(СтатусСтрокой, 1);
		СтатусСтрокой = ВРег(ПерваяБукваСтатуса) + Сред(СтатусСтрокой, 2);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("СтатусСтрокой", 	СтатусСтрокой);
	Результат.Вставить("ЦветСтатуса", 		ЦветСтатуса);
	Результат.Вставить("ТребуетПродления", 	ТребуетПродления);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СохранитьПозициюВТаблице(
		Таблица,
		ДанныеТаблицы,
		КлючеваяКолонка,
		КлючевойЭлемент = Неопределено) Экспорт
	
	КлючТекущейСтроки = Неопределено;
	ТекущаяСтрокаТаблицы = Таблица.ТекущиеДанные;
	Если ТекущаяСтрокаТаблицы <> Неопределено Тогда
		ТекущаяСтрокаТаблицы.Свойство(КлючеваяКолонка, КлючТекущейСтроки);
		Если ЗначениеЗаполнено(КлючТекущейСтроки) И ЗначениеЗаполнено(КлючевойЭлемент) Тогда
			КлючТекущейСтроки.Свойство(КлючевойЭлемент, КлючТекущейСтроки);
		КонецЕсли;
	КонецЕсли;
	
	КлючиВыделенныхСтрок = Новый Массив;
	Для каждого ИдентификаторВыделеннойСтроки Из Таблица.ВыделенныеСтроки Цикл
		ВыделеннаяСтрокаТаблицы = ДанныеТаблицы[ИдентификаторВыделеннойСтроки];
		КлючВыделеннойСтроки = Неопределено;
		ВыделеннаяСтрокаТаблицы.Свойство(КлючеваяКолонка, КлючВыделеннойСтроки);
		Если ЗначениеЗаполнено(КлючВыделеннойСтроки) И ЗначениеЗаполнено(КлючевойЭлемент) Тогда
			КлючВыделеннойСтроки.Свойство(КлючевойЭлемент, КлючВыделеннойСтроки);
		КонецЕсли;
		Если ЗначениеЗаполнено(КлючВыделеннойСтроки) Тогда
			КлючиВыделенныхСтрок.Добавить(КлючВыделеннойСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("КлючТекущейСтроки", 	КлючТекущейСтроки);
	Результат.Вставить("КлючиВыделенныхСтрок", 	КлючиВыделенныхСтрок);
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВосстановитьПозициюВТаблице(
		ПозицияВТаблице,
		Таблица,
		ДанныеТаблицы,
		КлючеваяКолонка,
		КлючевойЭлемент = Неопределено) Экспорт
	
	КлючТекущейСтроки 		= ПозицияВТаблице.КлючТекущейСтроки;
	КлючиВыделенныхСтрок 	= ПозицияВТаблице.КлючиВыделенныхСтрок;
	
	Таблица.ВыделенныеСтроки.Очистить();
	
	ИдентификаторТекущейСтроки = Таблица.ТекущаяСтрока;
	Если КлючТекущейСтроки <> Неопределено Тогда
		Для ИдентификаторСтроки = 0 По ДанныеТаблицы.Количество() - 1 Цикл
			СтрокаТаблицы = ДанныеТаблицы[ИдентификаторСтроки];
			Если СтрокаТаблицы <> Неопределено Тогда
				КлючСтроки = Неопределено;
				СтрокаТаблицы.Свойство(КлючеваяКолонка, КлючСтроки);
				Если ЗначениеЗаполнено(КлючСтроки) И ЗначениеЗаполнено(КлючевойЭлемент) Тогда
					КлючСтроки.Свойство(КлючевойЭлемент, КлючСтроки);
				КонецЕсли;
				
				Если КлючСтроки = КлючТекущейСтроки Тогда
					ИдентификаторТекущейСтроки = ИдентификаторСтроки;
					Таблица.ТекущаяСтрока = ИдентификаторТекущейСтроки;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если КлючиВыделенныхСтрок.Количество() = 1 И КлючиВыделенныхСтрок[0] = КлючТекущейСтроки
		И ИдентификаторТекущейСтроки <> Неопределено Тогда
		
		Таблица.ВыделенныеСтроки.Добавить(ИдентификаторТекущейСтроки);
		
	ИначеЕсли КлючиВыделенныхСтрок.Количество() > 0 Тогда
		Для ИдентификаторСтроки = 0 По ДанныеТаблицы.Количество() - 1 Цикл
			СтрокаТаблицы = ДанныеТаблицы[ИдентификаторСтроки];
			Если СтрокаТаблицы <> Неопределено Тогда
				КлючСтроки = Неопределено;
				СтрокаТаблицы.Свойство(КлючеваяКолонка, КлючСтроки);
				Если ЗначениеЗаполнено(КлючСтроки) И ЗначениеЗаполнено(КлючевойЭлемент) Тогда
					КлючСтроки.Свойство(КлючевойЭлемент, КлючСтроки);
				КонецЕсли;
				
				Если КлючиВыделенныхСтрок.Найти(КлючСтроки) <> Неопределено Тогда
					ИдентификаторВыделеннойСтроки = ИдентификаторСтроки;
					Таблица.ВыделенныеСтроки.Добавить(ИдентификаторВыделеннойСтроки);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

