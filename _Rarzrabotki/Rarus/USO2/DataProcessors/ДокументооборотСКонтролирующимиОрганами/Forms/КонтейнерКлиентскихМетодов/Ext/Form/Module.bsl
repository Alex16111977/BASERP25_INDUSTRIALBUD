&НаКлиенте
Процедура ЕстьДанныеДляФормированияВторичногоЗаявления(
		ВыполняемоеОповещение,
		УчетнаяЗапись,
		ТекстОшибокДляМастераПодключенияК1СОтчетности = "") Экспорт
	
	// Вторичное заявление не может быть создано, если в регистре ДополнительныеРеквизитыУчетнойЗаписи нет ни одной записи
	// Если в регистре нет ни одной записи - пытаемся заполнить регистр из рег. файла, а потом повторно проверяем
	
	Если ЕстьЗаписьВРегистреДополнительныеРеквизитыУчетнойЗаписи(УчетнаяЗапись) Тогда
		Результат = Новый Структура("ЕстьДанные, ТекстОшибок", Истина, ТекстОшибокДляМастераПодключенияК1СОтчетности);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	// Принудительно выполняем автонастройку учетной записи
	ВызовИзМастераПодключенияК1СОтчетности 					= Истина; 
	ТекстОшибокДляМастераПодключенияК1СОтчетности 			= "";
	ВыполнятьРасшифровкуЗашифрованнойЧастиФайлаАвтонастроки = Ложь;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("УчетнаяЗапись",        УчетнаяЗапись);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ЕстьДанныеДляФормированияВторичногоЗаявленияЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	АвтоматическаяНастройкаУчетнойЗаписи(
		УчетнаяЗапись,
		,
		ОписаниеОповещения,
		,
		Истина,
		Ложь,
		,
		ВызовИзМастераПодключенияК1СОтчетности,
		ТекстОшибокДляМастераПодключенияК1СОтчетности,
		,
		ВыполнятьРасшифровкуЗашифрованнойЧастиФайлаАвтонастроки);
		
КонецПроцедуры

&НаКлиенте
Процедура ЕстьДанныеДляФормированияВторичногоЗаявленияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	УчетнаяЗапись = ДополнительныеПараметры.УчетнаяЗапись;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если Результат.Свойство("ТекстОшибок") Тогда
		ТекстОшибокДляМастераПодключенияК1СОтчетности = Результат.ТекстОшибок;
	Иначе
		ТекстОшибокДляМастераПодключенияК1СОтчетности = "";
	КонецЕсли;
	
	// Повторная проверка
	Если ЕстьЗаписьВРегистреДополнительныеРеквизитыУчетнойЗаписи(УчетнаяЗапись) Тогда
		РезультатПроверки = Новый Структура("ЕстьДанные, ТекстОшибок", Истина, ТекстОшибокДляМастераПодключенияК1СОтчетности);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатПроверки);
	Иначе
		РезультатПроверки = Новый Структура("ЕстьДанные, ТекстОшибок", Ложь, ТекстОшибокДляМастераПодключенияК1СОтчетности);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатПроверки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьЗаписьВРегистреДополнительныеРеквизитыУчетнойЗаписи(УчетнаяЗапись) Экспорт
	
	НаборЗаписейРегистра = РегистрыСведений.ДополнительныеРеквизитыУчетнойЗаписи.СоздатьНаборЗаписей();
	НаборЗаписейРегистра.Отбор.УчетнаяЗапись.Установить(УчетнаяЗапись);
	НаборЗаписейРегистра.Прочитать(); 
	
	Если НаборЗаписейРегистра.Количество() > 0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ИзменилсяСоставКонтролирующихОрганов(СписокИзмененныхРеквизитов) Экспорт

	СдаватьВФНСИзменился 		= ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВФНС);
	КодыФНСИзменились 			= ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.КодыФНС);
	СдаватьВПФРИзменился 		= ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВПФР);
	КодПФРИзменился 			= ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.КодПФР); 
	СдаватьВФССИзменился 		= ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВФСС);
	СдаватьВРосстатИзменился 	= ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВРосстат);
	КодРосстатаИзменился		= ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.КодРосстата); 
	СдаватьВФСРАРИзменился 		= ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВФСРАР);
	СдаватьВРПНИзменился 		= ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВРПН);
	СдаватьВФТСИзменился 		= ЭтотПараметрИзменился(СписокИзмененныхРеквизитов, Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВФТС);
	
	Возврат СдаватьВФНСИзменился ИЛИ КодыФНСИзменились ИЛИ СдаватьВПФРИзменился ИЛИ КодПФРИзменился
		ИЛИ СдаватьВФССИзменился ИЛИ СдаватьВРосстатИзменился ИЛИ КодРосстатаИзменился ИЛИ СдаватьВФСРАРИзменился
		ИЛИ СдаватьВРПНИзменился ИЛИ СдаватьВФТСИзменился;
	
КонецФункции
	
