&НаКлиенте
Процедура СоздатьЗапросНаСверку(Организация, ВидУслуги) Экспорт
	
	ЗначенияЗаполнения = Новый Структура();
	ЗначенияЗаполнения.Вставить("ВидУслуги", 	ВидУслуги);
	ЗначенияЗаполнения.Вставить("Организация", 	Организация);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	Если ТипЗнч(ВидУслуги) = Тип("ПеречислениеСсылка.ВидыУслугПриИОН") Тогда
		// Это запрос ИОН
		ОткрытьФорму("Документ.ЗапросНаИнформационноеОбслуживаниеНалогоплательщика.Форма.ФормаДокумента", ПараметрыФормы);
	Иначе
		// Это запрос ИОС
		ОткрытьФорму("Документ.ЗапросНаИнформационноеОбслуживаниеСтрахователя.Форма.ФормаДокумента", ПараметрыФормы);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКодОрганаТОГС(ДополнительныеПараметры) Экспорт
	
	ПутьКФорме = ПутьКОбъекту + ".Форма.СписокТОГС";
	
	Если ДополнительныеПараметры.Свойство("ОписаниеОповещения") Тогда
		ОписаниеОповещения = ДополнительныеПараметры.ОписаниеОповещения;
		// Нельзя сохранять оповещение иначе форма будет заблокирована.
		ДополнительныеПараметры.Удалить("ОписаниеОповещения");
	Иначе
		ОписаниеОповещения = Неопределено;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("Элемент") Тогда
		Элемент = ДополнительныеПараметры.Элемент;
		ДополнительныеПараметры.Удалить("Элемент");
	Иначе
		Элемент = Неопределено;
	КонецЕсли;
	
	ОткрытьФорму(
		ПутьКФорме,
		ДополнительныеПараметры,
		Элемент,
		,
		,
		,
		ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНаправления(
		Форма,
		Действие,
		ИмяТаблицыФормы,
		ДанныеОрганизации,
		ТолькоФНС,
		АдресПолучателей,
		ВыполняемоеОповещение = Неопределено) Экспорт
	
	ТаблицаФормы = Форма.Элементы[ИмяТаблицыФормы];
	Если ТаблицаФормы.ТекущиеДанные <> Неопределено
		И Действие = "Редактировать" Тогда
		ТипПолучателя 	= ТаблицаФормы.ТекущиеДанные.ТипПолучателя;
		КодПолучателя 	= ТаблицаФормы.ТекущиеДанные.КодПолучателя;
		КПП 			= ТаблицаФормы.ТекущиеДанные.КПП;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Действие, ДанныеОрганизации, ТипПолучателя, КодПолучателя, КПП");
	ПараметрыФормы.Вставить("Действие", 			Действие);
	ПараметрыФормы.Вставить("ДанныеОрганизации", 	ДанныеОрганизации);
	ПараметрыФормы.Вставить("ТолькоФНС", 			ТолькоФНС);
	ПараметрыФормы.Вставить("ТипПолучателя", 		ТипПолучателя);
	ПараметрыФормы.Вставить("КодПолучателя", 		КодПолучателя);
	ПараметрыФормы.Вставить("КПП", 					КПП);
	ПараметрыФормы.Вставить("АдресПолучателей", 	АдресПолучателей);
	ПараметрыФормы.Вставить("ИмяТаблицыФормы", 		ИмяТаблицыФормы);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Действие", 				Действие);
	ДополнительныеПараметры.Вставить("ИмяТаблицыФормы", 		ИмяТаблицыФормы);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОткрытьФормуНаправленияЗавершение", 
		Форма, 
		ДополнительныеПараметры);
	
	ОткрытьФормуВводаНаправления(
		Форма,
		ОписаниеОповещения,
		ПараметрыФормы);
		
КонецПроцедуры
	
&НаКлиенте
Процедура ОткрытьФормуНаправленияЗавершение(Форма, РедактируемаяТаблица, Результат, ВходящийКонтекст) Экспорт
	
	Действие 		= ВходящийКонтекст.Действие;
	ИмяТаблицыФормы = ВходящийКонтекст.ИмяТаблицыФормы;
	ТаблицаФормы 	= Форма.Элементы[ИмяТаблицыФормы];
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		Если Действие = "Добавить" Тогда
			
			НоваяСтрока = РедактируемаяТаблица.Добавить();
			НоваяСтрока.КодПолучателя 	= Результат.КодПолучателя;
			НоваяСтрока.КПП 			= Результат.КПП;
			НоваяСтрока.ТипПолучателя	= Результат.ТипПолучателя;
			
			ТаблицаФормы.Обновить();
			
		ИначеЕсли Действие = "Редактировать" Тогда
			
			ИдентификаторСтроки 		= ТаблицаФормы.ТекущаяСтрока;
			ТекущаяСтрока 				= РедактируемаяТаблица.НайтиПоИдентификатору(ИдентификаторСтроки);
			
			ТекущаяСтрока.КодПолучателя = Результат.КодПолучателя;
			ТекущаяСтрока.КПП 			= Результат.КПП;
			ТекущаяСтрока.ТипПолучателя	= Результат.ТипПолучателя;
			
			ТаблицаФормы.Обновить();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВходящийКонтекст.ВыполняемоеОповещение <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура УдалитьНаправление(
		Форма,
		РедактируемаяТаблица,
		ИмяТаблицыФормы,
		ИмяКнопки) Экспорт
	
	ТекущаяСтрока = Форма.Элементы[ИмяТаблицыФормы].ТекущаяСтрока;
	
	ТекущаяСтрокаВыбрана = ТекущаяСтрокаВыбрана(
		РедактируемаяТаблица,
		ТекущаяСтрока,
		"удаления");
	
	Если ТекущаяСтрокаВыбрана Тогда
			
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ТекущаяСтрока", 		ТекущаяСтрока);
		ДополнительныеПараметры.Вставить("ИмяТаблицыФормы", 	ИмяТаблицыФормы);
		ДополнительныеПараметры.Вставить("ИмяКнопки", 			ИмяКнопки);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"УдалитьНаправлениеЗавершение", 
			Форма, 
			ДополнительныеПараметры);
		
		ТекстВопроса = НСтр("ru = 'Удалить выбранное направление?';
							|en = 'Delete the selected direction?'");
		
		ПоказатьВопрос(
			ОписаниеОповещения, 
			ТекстВопроса, 
			РежимДиалогаВопрос.ДаНет,
			,
			КодВозвратаДиалога.Да);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьНаправлениеЗавершение(Форма, РедактируемаяТаблица, РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекущаяСтрока 		= ДополнительныеПараметры.ТекущаяСтрока;
	ИмяТаблицыФормы		= ДополнительныеПараметры.ИмяТаблицыФормы;
	ИмяКнопки 			= ДополнительныеПараметры.ИмяКнопки;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		ЭлементКоллекции 		= РедактируемаяТаблица.НайтиПоИдентификатору(ТекущаяСтрока);
		ИндексЭлементаКоллекции = РедактируемаяТаблица.Индекс(ЭлементКоллекции);
		РедактируемаяТаблица.Удалить(ИндексЭлементаКоллекции);
		
		Форма.Элементы[ИмяКнопки].Доступность = РедактируемаяТаблица.Количество() <> 0;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПечататьДокумент(Результат, НижнийКолонтитул)

	ФайлыОтчетности = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "ФайлОтчетности"));
	Для Каждого ФайлОтчетности Из ФайлыОтчетности Цикл 
		
		//	Кодировка = ?(нрег(Прав(ФайлОтчетности.ИмяФайла, 4)) = ".xml", "windows-1251", "cp866");
		Тело = ПрочитатьТекстИзФайлаСтрокойBase64Клиент(ФайлОтчетности.Файл,, Истина);	// Фиксированная Кодировка заменена на авто
		ПолучитьЭЦП(Файлы.Индекс(ФайлОтчетности));
		
		Представление   = ПредставлениеТранспортногоСообщнияПоТипу(ФайлОтчетности.ТранспортноеСообщение);
		
		ПараметрыПечати = КонструкторПечатиПротокола();
		ПараметрыПечати.ТабДок = СформироватьТабличныйДокументНаОсновеБланка(
			"Электронное представление отчета", 
			ФайлОтчетности.ИмяФайла, 
			Тело, 
			НижнийКолонтитул);
			
		ПараметрыПечати.Отправка = ФайлОтчетности.ТранспортноеСообщение;
		
		Результат.Добавить(ПараметрыПечати, Представление);
			
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция КонструкторПечатиПротокола()
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТабДок",   Новый ТабличныйДокумент);
	ДополнительныеПараметры.Вставить("Отправка", Неопределено);
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

&НаСервереБезКонтекста
Функция КНДФайла(XMLФайл)
	
	Если НЕ ЗначениеЗаполнено(XMLФайл) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// создаем дерево на основе строки XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений( , XMLФайл, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем XML
	УзелФайл = ДеревоXML.Строки.Найти("Файл", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УзелДокумент = УзелФайл.Строки.Найти("Документ", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелДокумент) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УзелКНД = УзелДокумент.Строки.Найти("КНД", "Имя");
	Если ЗначениеЗаполнено(УзелКНД) Тогда
		Возврат УзелКНД.Значение;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СформироватьТабличныйДокументНаОсновеУведомленияОбОтказеВПриемеНалоговойДекларации(Заголовок, ИмяФайла, Тело, НижнийКолонтитул) Экспорт
	
	СвойстваИзУведомления = ПолучитьОсновныеСвойстваИзУведомленияОбОтказеВПриемеНалоговойДекларации(Тело);
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб = Истина;
	
	// если текст уведомления разобрать удалось, то выводим основную инфорфмацию из него
	Если ЗначениеЗаполнено(СвойстваИзУведомления) Тогда
		Макет = ПолучитьМакетОбработки("УведомлениеОбОтказе");
		ОбластьМакета = Макет.ПолучитьОбласть("УведомлениеОбОтказеШапка");
		ОбластьМакета.Параметры.НалоговыйОрган = СвойстваИзУведомления.ОбщиеСведенияНалоговыйОрган.НаимНО +" (код "+СвойстваИзУведомления.ОбщиеСведенияНалоговыйОрган.КодНО+")" ;
		ОбластьМакета.Параметры.ИмяФайла = ВРег(СвойстваИзУведомления.ОбщиеСведения.ИмяОбрабФайла);
		ОбластьМакета.Параметры.Налогоплательщик = СвойстваИзУведомления.ПредставлениеНП;
		ОбластьМакета.Параметры.Отправитель = СвойстваИзУведомления.ПредставлениеОтпр;
		ОбластьМакета.Параметры.Дата = СвойстваИзУведомления.ОбщиеСведения.ДатаПредст;
		ОбластьМакета.Параметры.Время = СтрЗаменить(СвойстваИзУведомления.ОбщиеСведения.ВремПредст,".",":");
		ОбластьМакета.Параметры.ДатаПриема = СвойстваИзУведомления.ОбщиеСведения.ДатаПрием;
		ОбластьМакета.Параметры.НаименованиеДекларации = СформироватьТекстовуюИнформациюОДекларации(СвойстваИзУведомления.ОбщиеСведения);
		
		ТабДокумент.Вывести(ОбластьМакета); // УведомлениеОбОтказеШапка
		
		Для Каждого Ошибка Из СвойстваИзУведомления.ТаблицаОшибокОбщийПеречень Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("ОшибкиОбщие");
			ТекстОшибки = "Код: " + Ошибка.КодОшибки + " Описание:" + Ошибка.Описание;
			ОбластьМакета.Параметры.ОшибкаОбщая = ТекстОшибки;
			ТабДокумент.Вывести(ОбластьМакета);
		КонецЦикла;
		
		Если СвойстваИзУведомления.ТаблицаОшибокПоФайлам.Количество()>0 Тогда
			
			ОбластьМакета = Макет.ПолучитьОбласть("ОшибкиФайлШапка");
			ТабДокумент.Вывести(ОбластьМакета);
			
			ИмяФайла = "";
			ВыводимыйПоКаждомуФайлуТекст = "";
			
			Для Каждого Ошибка Из СвойстваИзУведомления.ТаблицаОшибокПоФайлам Цикл
				
				ТекстОшибки = 
					"Код: " + ?(ПустаяСтрока(Ошибка.КодОшибки),"-",Ошибка.КодОшибки) + Символы.ПС + 
					"Описание: " + ?(ПустаяСтрока(Ошибка.Описание),"-",Ошибка.Описание) + 
					?(ПустаяСтрока(Ошибка.ИдОш),"", Символы.ПС + "Доп. сведения: " + Строка(Ошибка.ИдОш)) + Символы.ПС;
								
				Если Ошибка.ИмяФайла = ИмяФайла Тогда
					
					ВыводимыйПоКаждомуФайлуТекст = ВыводимыйПоКаждомуФайлуТекст + Символы.ПС + ТекстОшибки;
					
				Иначе
					
					Если НЕ ПустаяСтрока(ВыводимыйПоКаждомуФайлуТекст) Тогда
						ОбластьМакета = Макет.ПолучитьОбласть("ОшибкиФайл");
						ОбластьМакета.Параметры.ОшибкаФайл = ВыводимыйПоКаждомуФайлуТекст;
						ТабДокумент.Вывести(ОбластьМакета);
					КонецЕсли;
					
					ИмяФайла = Ошибка.ИмяФайла;
					ВыводимыйПоКаждомуФайлуТекст = "В файле " + ИмяФайла + " обнаружены ошибки:" + Символы.ПС + Символы.ПС + ТекстОшибки;
				КонецЕсли;
				
			КонецЦикла;
			
			Если НЕ ПустаяСтрока(ВыводимыйПоКаждомуФайлуТекст) Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ОшибкиФайл");
				ОбластьМакета.Параметры.ОшибкаФайл = ВыводимыйПоКаждомуФайлуТекст;
				ТабДокумент.Вывести(ОбластьМакета); 
			КонецЕсли;
			
		КонецЕсли;
		
		ОбластьМакета = Макет.ПолучитьОбласть("ВторойБлокОшибок");
		Если СвойстваИзУведомления.ТаблицаОшибокОбщийПеречень.Количество() > 0
			ИЛИ СвойстваИзУведомления.ТаблицаОшибокПоФайлам.Количество() > 0 Тогда
			ОбластьМакета.Параметры.НеПринимается = "V";
		КонецЕсли;
		ТабДокумент.Вывести(ОбластьМакета);
		
		УказанПереченьСведений = СвойстваИзУведомления.ПереченьОснований.Количество() > 0;
		
		Если УказанПереченьСведений Тогда
			Для каждого Основание Из СвойстваИзУведомления.ПереченьОснований Цикл
				ОбластьМакета = Макет.ПолучитьОбласть("ПереченьОснований");
				ОбластьМакета.Параметры.ТекстОшибки = Основание;
				ТабДокумент.Вывести(ОбластьМакета);
			КонецЦикла;
		Иначе
			ОбластьМакета = Макет.ПолучитьОбласть("ПереченьОснований");
			ОбластьМакета.Параметры.ТекстОшибки = "-";
			ТабДокумент.Вывести(ОбластьМакета);
		КонецЕсли;
		
		ОбластьМакета = Макет.ПолучитьОбласть("УведомлениеОбОтказеПодвал");
		
		Если УказанПереченьСведений Тогда
			ОбластьМакета.Параметры.СчитаетсяНепредставленным = "V";
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьМакета);
		
		// Перечень сведений к уведомлению о том, что расчёт считается непредставленным
		НапечататьПереченьСведенийУведомления(ТабДокумент, Макет, СвойстваИзУведомления);
		
		// выводим информацию о подписях
		СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, ТаблицаПодписей);
		
	Иначе
		// если разобрать не удалось - выводим его в виде текста
		
		// получаем бланк отчета из макета
		ТабДокумент = СформироватьТабличныйДокументНаОсновеБланка(Заголовок, ИмяФайла, Тело, НижнийКолонтитул);
		
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
Процедура НапечататьПереченьСведенийУведомления(ТабДокумент, Макет, СвойстваИзУведомления)
	
	// Перечень сведений к уведомлению о том, что расчёт считается непредставленным
	Если СвойстваИзУведомления.ТаблицаПереченьСведений.Количество() > 0 Тогда
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаПеречняСведений");
		ТабДокумент.Вывести(ОбластьМакета);
		
		Для каждого СтрокаПеречня Из СвойстваИзУведомления.ТаблицаПереченьСведений Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаСведений");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, СтрокаПеречня); 
			ТабДокумент.Вывести(ОбластьМакета);
		КонецЦикла; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СформироватьТабличныйДокументНаОсновеУведомленияОбОтказеВПриеме(Заголовок, ИмяФайла, Тело, НижнийКолонтитул)
	
	СвойстваИзУведомления = ПолучитьОсновныеСвойстваИзУведомленияОбОтказеВПриеме(Тело);
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	// если текст уведомления разобрать удалось, то выводим основную инфорфмацию из него
	Если ЗначениеЗаполнено(СвойстваИзУведомления) Тогда
		
		Бланк 		= ПолучитьМакетОбработки("УведомлениеОбОтказеВПриеме");
		ТабДокумент.АвтоМасштаб = Истина;
		ОсновнаяЧастьБланка = Бланк.ПолучитьОбласть("Уведомление");
		ЗаполнитьЗначенияСвойств(ОсновнаяЧастьБланка.Параметры, СвойстваИзУведомления);
		ТабДокумент.Вывести(ОсновнаяЧастьБланка);
		СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Бланк, ТаблицаПодписей);
		
	Иначе
		// если разобрать не удалось - выводим его в виде текста
		ТабДокумент = СформироватьТабличныйДокументНаОсновеБланка(Заголовок, ИмяФайла, Тело, НижнийКолонтитул);
		
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
Функция СформироватьТабличныйДокументНаОсновеКвитанцииОПриемеНалоговойДекларации(Заголовок, ИмяФайла, Тело, НижнийКолонтитул)
	
	СвойстваИзУведомления = ПолучитьОсновныеСвойстваИзКвитанцииОПриемеНалоговойДекларации(Тело);
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	// если текст уведомления разобрать удалось, то выводим основную инфорфмацию из него
	Если ЗначениеЗаполнено(СвойстваИзУведомления) Тогда
		
		Макет = ПолучитьМакетОбработки("КвитанцияОПриемеДекларации");
		
		ОбластьМакета = Макет.ПолучитьОбласть("КвитанцияОПриемеДекларации");
		ОбластьМакета.Параметры.НалоговыйОрганПодтверждающий = СвойстваИзУведомления.НалоговыйОрганПодтверждающий;
		ОбластьМакета.Параметры.НалоговыйОрганПолучатель = СвойстваИзУведомления.НалоговыйОрганПолучатель;
		ОбластьМакета.Параметры.ИмяФайла = ВРег(СвойстваИзУведомления.ОбщиеСведения.ИмяОбрабФайла);
		ОбластьМакета.Параметры.Отправитель = СвойстваИзУведомления.ПредставлениеОтпр;
		ОбластьМакета.Параметры.Налогоплательщик = СвойстваИзУведомления.ПредставлениеНП;
		ОбластьМакета.Параметры.Дата = СвойстваИзУведомления.ОбщиеСведения.ДатаПредст;
		ОбластьМакета.Параметры.Время = СтрЗаменить(СвойстваИзУведомления.ОбщиеСведения.ВремПредст,".",":");
		ОбластьМакета.Параметры.ДатаПоступления = СвойстваИзУведомления.ОбщиеСведения.ДатаПост;
		ОбластьМакета.Параметры.ДатаПриема = СвойстваИзУведомления.ОбщиеСведения.ДатаПрин;
		
		ОбластьМакета.Параметры.НаименованиеДекларации = СформироватьТекстовуюИнформациюОДекларации(СвойстваИзУведомления.ОбщиеСведения);
		
		ОбластьМакета.Параметры.РегистрационныйНомер = СвойстваИзУведомления.ОбщиеСведения.РегНом+".";
		ТабДокумент.Вывести(ОбластьМакета); // КвитанцияОПриемеДекларации
		
		// выводим информацию о подписях
		СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, ТаблицаПодписей);
		
	Иначе
		
		// если разобрать не удалось - выводим его в виде текста
		ТабДокумент = СформироватьТабличныйДокументНаОсновеБланка(Заголовок, ИмяФайла, Тело, НижнийКолонтитул);
	
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСведенияИзТэгаСвКвитКвитанцииОПриеме(УзелДокумент)
	
	ДатаПрин       = "";
	НаимВидДок     = "";
	ДатаНапр       = "";
	ВремНапр       = "";
	ДатаПост       = "";
	РегНом         = ""; // необязательный.
	ИмяПринятФайла = ""; // множественный тэг.
	
	УзелСвКвит = ПолучитьУзел(УзелДокумент, "СвКвит");
	Если НЕ ЗначениеЗаполнено(УзелСвКвит) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УзелДатаПрин = ПолучитьУзел(УзелСвКвит, "ДатаПрин");
	Если НЕ ЗначениеЗаполнено(УзелДатаПрин) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаПрин = УзелДатаПрин.Значение;
	
	УзелНаимВидДок = ПолучитьУзел(УзелСвКвит, "НаимВидДок");
	Если НЕ ЗначениеЗаполнено(УзелНаимВидДок) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НаимВидДок = УзелНаимВидДок.Значение;
	
	УзелДатаНапр = ПолучитьУзел(УзелСвКвит, "ДатаНапр");
	Если НЕ ЗначениеЗаполнено(УзелДатаНапр) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаНапр = УзелДатаНапр.Значение;
	
	УзелВремНапр = ПолучитьУзел(УзелСвКвит, "ВремНапр");
	Если НЕ ЗначениеЗаполнено(УзелВремНапр) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВремНапр = УзелВремНапр.Значение;
	
	УзелДатаПост = ПолучитьУзел(УзелСвКвит, "ДатаПост");
	Если НЕ ЗначениеЗаполнено(УзелДатаПост) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаПост = УзелДатаПост.Значение;
	
	УзелРегНом = ПолучитьУзел(УзелСвКвит, "РегНом", Ложь); // Необязательный.
	Если ЗначениеЗаполнено(УзелРегНом) Тогда
		РегНом = УзелРегНом.Значение;
	КонецЕсли;
	
	ИменаПринятФайла = Новый Массив; // Множественный.
	СтрокиИмяПринятФайла = УзелСвКвит.Строки.НайтиСтроки(Новый Структура("Имя", "ИмяПринятФайла"));
	Для Каждого СтрокаИмяПринятФайла Из СтрокиИмяПринятФайла Цикл
		ИменаПринятФайла.Добавить(СтрокаИмяПринятФайла.Значение);
	КонецЦикла;
	ИмяПринятФайла = СтроковыеФункцииКлиентСервер.СтрокаИзМассиваПодстрок(ИменаПринятФайла, Символы.ПС);
	
	СвойстваКвитанции = Новый Структура();
	СвойстваКвитанции.Вставить("ДатаПрин",       ДатаПрин);
	СвойстваКвитанции.Вставить("НаимВидДок",     НаимВидДок);
	СвойстваКвитанции.Вставить("ДатаНапр",       ДатаНапр);
	СвойстваКвитанции.Вставить("ВремНапр",       ВремНапр);
	СвойстваКвитанции.Вставить("ДатаПост",       ДатаПост);
	СвойстваКвитанции.Вставить("РегНом",         РегНом);
	СвойстваКвитанции.Вставить("ИмяПринятФайла", ИмяПринятФайла);
	
	Возврат СвойстваКвитанции;
	
КонецФункции

&НаСервере
Функция ПолучитьОсновныеСвойстваИзКвитанцииОПриемеНалоговойДекларации(СтрКвитанция)
	
	Если НЕ ЗначениеЗаполнено(СтрКвитанция) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// создаем дерево на основе строки XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений( , СтрКвитанция, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка разбора XML квитанции о приеме:%1';
																						|en = 'An error occurred while parsing XML notice of acceptance:%1'"),
			Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем XML
	УзелФайл = ДеревоXML.Строки.Найти("Файл", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML квитанции о приеме: не обнаружен узел ""Файл"".';
								|en = 'Incorrect structure of XML notice of acceptance: the ""File"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелДокумент = УзелФайл.Строки.Найти("Документ", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелДокумент) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML квитанции о приеме: не обнаружен узел ""Документ"".';
								|en = 'Incorrect structure of XML notice of acceptance: the ""Document"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелСвКвит = УзелДокумент.Строки.Найти("СвКвит", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелСвКвит) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML квитанции о приеме: не обнаружен узел ""СвКвит"".';
								|en = 'Incorrect structure of XML notice of acceptance: the ""СвКвит"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// разбираем узел с общими сведениями
	ОбщиеСведения = Новый Структура;
	Для Каждого УзелОбщСвед Из УзелСвКвит.Строки Цикл
		ОбщиеСведения.Вставить(УзелОбщСвед.Имя, СокрЛП(УзелОбщСвед.Значение));
	КонецЦикла;
	
	Если ОбщиеСведения.Свойство("ДатаПредст") И ОбщиеСведения.Свойство("ВремПредст") Тогда
		ОбщиеСведения.Вставить("ДатаВремяПредст", ОбщиеСведения.ДатаПредст + " " + ОбщиеСведения.ВремПредст);
	КонецЕсли;
	Если ОбщиеСведения.Свойство("Период") И ОбщиеСведения.Свойство("ПериодНаим") Тогда
		ОбщиеСведения.Вставить("ОтчетПериод", ОбщиеСведения.Период + " (" + ОбщиеСведения.ПериодНаим + ")");
	КонецЕсли;
	
	// разбираем сведения о налоговом органе который подтвердил получение отчетности
	НалОргПодт = СокрЛП(УзелДокумент.Строки.Найти("НаимНОПодт", "Имя").Значение);
	КодНалОргПодт = СокрЛП(УзелДокумент.Строки.Найти("КодНОПодт", "Имя").Значение);
	
	Если НалОргПодт <> КодНалОргПодт Тогда
		НалОргПодт = КодНалОргПодт + " (" + НалОргПодт + ")";
	КонецЕсли;
	
	// разбираем сведения о налоговом органе в который поступила отчетность
	УзелСвНалОргПост = УзелДокумент.Строки.Найти("СвНалОргПост", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелСвНалОргПост) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML квитанции: не обнаружен узел ""СвНалОргПост"".';
								|en = 'Incorrect structure of XML receipt: the ""СвНалОргПост"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Отказ = Истина;
		Возврат Неопределено;
	КонецЕсли;
	
	НалоговыйОрганПост = "";
	
	УзелКодНО = УзелСвНалОргПост.Строки.Найти("КодНО", "Имя");
	Если ЗначениеЗаполнено(УзелКодНО) Тогда
		НалоговыйОрганПост = СокрЛП(УзелКодНО.Значение);
	КонецЕсли;
	
	УзелНаимНО = УзелСвНалОргПост.Строки.Найти("НаимНО", "Имя");
	Если ЗначениеЗаполнено(УзелНаимНО) Тогда
		Если ЗначениеЗаполнено(НалоговыйОрганПост) Тогда
			НаименованиеНО = СокрЛП(УзелНаимНО.Значение);
			Если НалоговыйОрганПост <> НаименованиеНО Тогда
				НалоговыйОрганПост = НалоговыйОрганПост + " (" + НаименованиеНО + ")";
			КонецЕсли;
		Иначе
			НалоговыйОрганПост = СокрЛП(УзелНаимНО.Значение);
		КонецЕсли;
	КонецЕсли;
	
	// Сведения об отправителе отчетности
	ПредставлениеОтпр = "";
	ДанныеОтправителя = УзелДокумент.Строки.Найти("СвОтпр", "Имя");
	ОтпрЮЛ = ДанныеОтправителя.Строки.Найти("ОтпрЮЛ", "Имя");
	ОтпрФЛ = ДанныеОтправителя.Строки.Найти("ОтпрФЛ", "Имя");
	
	Если ЗначениеЗаполнено(ОтпрФЛ) Тогда
		ПредставлениеОтпр = ПолучитьПредставлениеНП(Ложь,ОтпрФЛ);
	ИначеЕсли ЗначениеЗаполнено(ОтпрЮЛ) Тогда
		ПредставлениеОтпр = ПолучитьПредставлениеНП(Истина,ОтпрЮЛ);
	КонецЕсли;
	
	// Сведения о налогоплательщике
	ПредставлениеНП = ""; 	
	ДанныеОтправителя = УзелДокумент.Строки.Найти("СвНП", "Имя");
	ОтпрФЛ = ДанныеОтправителя.Строки.Найти("НПФЛ", "Имя");
	ОтпрЮЛ = ДанныеОтправителя.Строки.Найти("НПЮЛ", "Имя");
	
	Если ЗначениеЗаполнено(ОтпрФЛ) Тогда
		ПредставлениеНП = ПолучитьПредставлениеНП(Ложь,ОтпрФЛ);
	ИначеЕсли ЗначениеЗаполнено(ОтпрЮЛ) Тогда
		ПредставлениеНП = ПолучитьПредставлениеНП(Истина,ОтпрЮЛ);
	КонецЕсли;
	
	Возврат Новый Структура("НалоговыйОрганПодтверждающий, НалоговыйОрганПолучатель, ОбщиеСведения, ПредставлениеНП, ПредставлениеОтпр", НалОргПодт, НалоговыйОрганПост, ОбщиеСведения, ПредставлениеНП, ПредставлениеОтпр);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОсновныеСвойстваИзУведомленияОбОтказеВПриемеНалоговойДекларации(СтрУведомление)
	
	Если НЕ ЗначениеЗаполнено(СтрУведомление) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТаблицаОшибокОбщийПеречень = Новый ТаблицаЗначений;
	ТаблицаОшибокОбщийПеречень.Колонки.Добавить("КодОшибки");
	ТаблицаОшибокОбщийПеречень.Колонки.Добавить("Описание");
	
	ТаблицаОшибокПоФайлам = Новый ТаблицаЗначений;
	ТаблицаОшибокПоФайлам.Колонки.Добавить("ИмяФайла");
	ТаблицаОшибокПоФайлам.Колонки.Добавить("КодОшибки");
	ТаблицаОшибокПоФайлам.Колонки.Добавить("Описание");
	ТаблицаОшибокПоФайлам.Колонки.Добавить("ИдОш");
	
	ТаблицаПереченьСведений = Новый ТаблицаЗначений;
	ТаблицаПереченьСведений.Колонки.Добавить("СНИЛС");
	ТаблицаПереченьСведений.Колонки.Добавить("ИНН");
	ТаблицаПереченьСведений.Колонки.Добавить("ФИО");
	ТаблицаПереченьСведений.Колонки.Добавить("ТекстОшибки");
	
	ПереченьОснований = Новый Массив;
	
	// создаем дерево на основе строки XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений( , СтрУведомление, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка разбора XML уведомления об отказе:%1';
																						|en = 'An error occurred while parsing XML refusal notification:%1'"),
			Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем XML
	УзелФайл = ДеревоXML.Строки.Найти("Файл", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML уведомления: не обнаружен узел ""Файл"".';
								|en = 'Incorrect structure of XML notification: the ""File"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелДокумент = УзелФайл.Строки.Найти("Документ", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелДокумент) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML уведомления: не обнаружен узел ""Документ"".';
								|en = 'Incorrect structure of XML notification: the ""Document"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелСведУведУточ = УзелДокумент.Строки.Найти("СведУведУточ", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелСведУведУточ) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML уведомления: не обнаружен узел ""СведУведУточ"".';
								|en = 'Incorrect structure of XML notification: the ""СведУведУточ"" node was not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// разбираем узел с перечнем выявленных нарушений
	УзлыВыявлНарФайл = УзелСведУведУточ.Строки.НайтиСтроки(Новый Структура("Имя", "ВыявлНарФайл"));
	Для Каждого УзелВыявНарФайл Из УзлыВыявлНарФайл Цикл
		
		УзлыПеречВыявНар = УзелВыявНарФайл.Строки.НайтиСтроки(Новый Структура("Имя", "ПеречВыявНар"));
		ИмяФайла = УзелВыявНарФайл.Строки.Найти("ИмяОбрабФайла", "Имя").Значение;

		Для Каждого УзелПеречВыявНар Из УзлыПеречВыявНар Цикл
			
			УзелКодОш = УзелПеречВыявНар.Строки.Найти("КодОш", "Имя");
			УзелТекстОш = УзелПеречВыявНар.Строки.Найти("ТекстОш", "Имя");
			УзелИдОш = УзелПеречВыявНар.Строки.Найти("ИдОш", "Имя");
			
			Если ЗначениеЗаполнено(УзелКодОш) ИЛИ ЗначениеЗаполнено(УзелТекстОш) ИЛИ ЗначениеЗаполнено(УзелИдОш) Тогда
				
				КодОшибки = ?(ЗначениеЗаполнено(УзелКодОш), СокрЛП(УзелКодОш.Значение), "-");
				ТекстОшибки = ?(ЗначениеЗаполнено(УзелТекстОш), СокрЛП(УзелТекстОш.Значение), "-");
				ИдОш = ?(ЗначениеЗаполнено(УзелИдОш), СокрЛП(УзелИдОш.Значение), "-");
				
				НовСтр = ТаблицаОшибокПоФайлам.Добавить();
				НовСтр.КодОшибки = КодОшибки;
				НовСтр.Описание  = ТекстОшибки;
				НовСтр.ИмяФайла  = ИмяФайла;
				НовСтр.ИдОш 	 = ИдОш;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ПолучитьСвойстваУзлаСвИдФЛ(УзелВыявНарФайл, ТаблицаПереченьСведений);
		
	КонецЦикла;
	
	ТаблицаПереченьОснований = ТаблицаПереченьСведений.Скопировать();
	ТаблицаПереченьОснований.Свернуть("ТекстОшибки");
	ПереченьОснований = ТаблицаПереченьСведений.ВыгрузитьКолонку("ТекстОшибки");
	
	//ошибки
	УзлыПеречВыявНар = УзелСведУведУточ.Строки.НайтиСтроки(Новый Структура("Имя", "ПеречВыявНар"));
	Для Каждого УзелПеречВыявНар Из УзлыПеречВыявНар Цикл
		
		УзелКодОш = УзелПеречВыявНар.Строки.Найти("КодОш", "Имя");
		УзелТекстОш = УзелПеречВыявНар.Строки.Найти("ТекстОш", "Имя");
					
		Если ЗначениеЗаполнено(УзелКодОш) ИЛИ ЗначениеЗаполнено(УзелТекстОш)Тогда
			
			КодОшибки = ?(ЗначениеЗаполнено(УзелКодОш), СокрЛП(УзелКодОш.Значение), "-");
			ТекстОшибки = ?(ЗначениеЗаполнено(УзелТекстОш), СокрЛП(УзелТекстОш.Значение), "-");
			
			Если ТаблицаОшибокОбщийПеречень.Найти(ТекстОшибки,"Описание") = Неопределено Тогда
				
				НовСтр = ТаблицаОшибокОбщийПеречень.Добавить();
				НовСтр.КодОшибки = КодОшибки;
				НовСтр.Описание = ТекстОшибки;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	// Налоговый орган
	ОбщиеСведенияНалоговыйОрган = Новый Структура;
	Если УзелДокумент.Строки.Количество() > 0 Тогда
		Для Каждого УзелНО Из УзелДокумент.Строки Цикл
			ОбщиеСведенияНалоговыйОрган.Вставить(УзелНО.Имя, СокрЛП(УзелНО.Значение));
		КонецЦикла;
	КонецЕсли;
	
	// Сведения об отправителе отчетности
	ПредставлениеОтпр = "";
	ДанныеОтправителя = УзелДокумент.Строки.Найти("СвОтпр", "Имя");
	ОтпрЮЛ = ДанныеОтправителя.Строки.Найти("ОтпрЮЛ", "Имя");
	ОтпрФЛ = ДанныеОтправителя.Строки.Найти("ОтпрФЛ", "Имя");
	
	Если ЗначениеЗаполнено(ОтпрФЛ) Тогда
		ПредставлениеОтпр = ПолучитьПредставлениеНП(Ложь,ОтпрФЛ);
	ИначеЕсли ЗначениеЗаполнено(ОтпрЮЛ) Тогда
		ПредставлениеОтпр = ПолучитьПредставлениеНП(Истина,ОтпрЮЛ);
	КонецЕсли;
	
	// Сведения о налогоплательщике
	ПредставлениеНП = "";
	ДанныеОтправителя = УзелДокумент.Строки.Найти("СвНП", "Имя");
	ОтпрФЛ = ДанныеОтправителя.Строки.Найти("НПФЛ", "Имя");
	ОтпрЮЛ = ДанныеОтправителя.Строки.Найти("НПЮЛ", "Имя");
	
	Если ЗначениеЗаполнено(ОтпрФЛ) Тогда
		ПредставлениеНП = ПолучитьПредставлениеНП(Ложь,ОтпрФЛ);
	ИначеЕсли ЗначениеЗаполнено(ОтпрЮЛ) Тогда
		ПредставлениеНП = ПолучитьПредставлениеНП(Истина,ОтпрЮЛ);
	КонецЕсли;
	
	// разбираем узел с общими сведениями
	ОбщиеСведения = Новый Структура;
	УзлыОбщСвУвед = УзелСведУведУточ.Строки.НайтиСтроки(Новый Структура("Имя", "ОбщСвУвед"));
	Если УзлыОбщСвУвед.Количество() > 0 Тогда
		УзелОбщСвУвед = УзлыОбщСвУвед[0];
		Для Каждого УзелОбщСвед Из УзелОбщСвУвед.Строки Цикл
			
			Если ОбщиеСведения.Свойство(УзелОбщСвед.Имя) Тогда
				
				// Если несколько значений с одним ключем, объединяем их.
				// Может быть у узла ИмяОбрабФайла
				ПредыдущееЗначение 	= Строка(ОбщиеСведения[УзелОбщСвед.Имя]);
				НовоеЗначение 		= СокрЛП(Строка(УзелОбщСвед.Значение));
				
				ОбщиеСведения.Вставить(УзелОбщСвед.Имя, ПредыдущееЗначение + ", " + НовоеЗначение);
				
			Иначе
				
				ОбщиеСведения.Вставить(УзелОбщСвед.Имя, СокрЛП(УзелОбщСвед.Значение));
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	СвойстваУведомления = Новый Структура();
	СвойстваУведомления.Вставить("ТаблицаОшибокОбщийПеречень",  ТаблицаОшибокОбщийПеречень);
	СвойстваУведомления.Вставить("ТаблицаОшибокПоФайлам",       ТаблицаОшибокПоФайлам);
	СвойстваУведомления.Вставить("ТаблицаПереченьСведений",   	ТаблицаПереченьСведений);
	СвойстваУведомления.Вставить("ПереченьОснований",   		ПереченьОснований);
	СвойстваУведомления.Вставить("ОбщиеСведения",               ОбщиеСведения);
	СвойстваУведомления.Вставить("ОбщиеСведенияНалоговыйОрган", ОбщиеСведенияНалоговыйОрган);
	СвойстваУведомления.Вставить("ПредставлениеНП",             ПредставлениеНП);
	СвойстваУведомления.Вставить("ПредставлениеОтпр",           ПредставлениеОтпр);

	Возврат СвойстваУведомления;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПолучитьСвойстваУзлаСвИдФЛ(УзелВыявНарФайл, ТаблицаПереченьСведений)
	
	УзлыСвИдФЛ = УзелВыявНарФайл.Строки.НайтиСтроки(Новый Структура("Имя", "СвИдФЛ"));
	Для Каждого УзелСвИдФЛ Из УзлыСвИдФЛ Цикл
		УзелДанИдФЛ_НП = УзелСвИдФЛ.Строки[0].Строки;
		
		СНИЛС = УзелДанИдФЛ_НП.Найти("СНИЛС").Значение; // обязательный
		
		УзелИННФЛ = УзелДанИдФЛ_НП.Найти("ИННФЛ"); // необязательный
		Если УзелИННФЛ = Неопределено Тогда
			ИННФЛ = "";
		Иначе
			ИННФЛ = УзелИННФЛ.Значение;
		КонецЕсли;
		
		УзелФИО = УзелДанИдФЛ_НП.Найти("ФИО").Строки;
		
		Фамилия = УзелФИО.Найти("Фамилия").Значение;
		Имя 	= УзелФИО.Найти("Имя").Значение;
		
		УзелОтчество = УзелФИО.Найти("Отчество");
		Если УзелОтчество = Неопределено Тогда 
			Отчество = "";
		Иначе
			Отчество = УзелОтчество.Значение;
		КонецЕсли;
		
		УзлыЗначОшЭл = УзелДанИдФЛ_НП.НайтиСтроки(Новый Структура("Имя", "ЗначОшЭл"));
		Для каждого УзелЗначОшЭл Из УзлыЗначОшЭл Цикл
			НоваяСтрока = ТаблицаПереченьСведений.Добавить();
			НоваяСтрока.СНИЛС 		= СНИЛС;
			НоваяСтрока.ИНН 		= ИННФЛ;
			НоваяСтрока.ФИО 		= Фамилия + " " + Имя + " " + Отчество;
			НоваяСтрока.ТекстОшибки = УзелЗначОшЭл.Значение;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОсновныеСвойстваИзУведомленияОбОтказеВПриеме(СтрУведомление)
	
	Если НЕ ЗначениеЗаполнено(СтрУведомление) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Получатель    = "";
	Отправитель   = "";
	НОПром        = "";
	ДатаНапр      = "";
	ВремНапр      = "";
	ДатаПост      = "";
	ИмяОбрабФайла = "";
	ПричиныОтказа = "";
	ФИОДолж       = "";

	// создаем дерево на основе строки XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений( , СтрУведомление, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка разбора XML уведомления об отказе:%1';
																						|en = 'An error occurred while parsing XML refusal notification:%1'"),
			Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем XML
	УзелФайл = ПолучитьУзел(ДеревоXML, "Файл");
	Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УзелДокумент = ПолучитьУзел(УзелФайл, "Документ");
	Если НЕ ЗначениеЗаполнено(УзелДокумент) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПричиныОтказаИИмяФайла 	= ПолучитьПричинаОтказаИИмяФайлаИзУведомленияОбОтказеВПриеме(УзелДокумент);
	Если ЗначениеЗаполнено(ПричиныОтказаИИмяФайла) Тогда
		ПричиныОтказа 	= ПричиныОтказаИИмяФайла.ПричинаОтказа;
		ИмяОбрабФайла 	= ПричиныОтказаИИмяФайла.ИмяОбрабФайла;
	КонецЕсли;
	
	Получатель 		= ПолучитьОтправителяИзТэгаСвОтпрДокИлиСвАдр(УзелДокумент, "СвПолДок");
	Отправитель 	= ПолучитьОтправителяИзТэгаСвОтпрДокИлиСвАдр(УзелДокумент, "СвОтпрДок");
	НОПром 			= ПолучитьПромежуточныйНОИзУведомленияОбОтказеВПриеме(УзелДокумент);
	
	ДатаНапрИПост = ПолучитьДатуНапрИПостИзУведомленияОбОтказеВПриеме(УзелДокумент);
	Если ЗначениеЗаполнено(ДатаНапрИПост) Тогда
		ДатаНапр = ДатаНапрИПост.ДатаНапр;
		ВремНапр = ДатаНапрИПост.ВремНапр;
		ДатаПост = ДатаНапрИПост.ДатаПост;
	КонецЕсли;
	
	ФИОДолж = ПолучитьФИОДолжИзТэгаФИОДолж(УзелДокумент);
	
	СвойстваУведомления = Новый Структура();
	СвойстваУведомления.Вставить("Получатель",  	Получатель);
	СвойстваУведомления.Вставить("Отправитель", 	Отправитель);
	СвойстваУведомления.Вставить("НОПром", 			НОПром);
	СвойстваУведомления.Вставить("ДатаНапр", 		ДатаНапр);
	СвойстваУведомления.Вставить("ВремНапр", 		ВремНапр);
	СвойстваУведомления.Вставить("ДатаПост", 		ДатаПост);
	СвойстваУведомления.Вставить("ПричиныОтказа", 	ПричиныОтказа);
	СвойстваУведомления.Вставить("ИмяОбрабФайла", 	ИмяОбрабФайла);
	СвойстваУведомления.Вставить("ФИОДолж", 		ФИОДолж);
	
	Возврат СвойстваУведомления;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПромежуточныйНОИзУведомленияОбОтказеВПриеме(УзелДокумент)
	
	НОПром = "";
	
	УзелНОПром = ПолучитьУзел(УзелДокумент, "НОПром", Ложь);
	Если НЕ ЗначениеЗаполнено(УзелНОПром) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УзелПолНО = ПолучитьУзел(УзелНОПром, "ПолНО", Ложь);
	Если НЕ ЗначениеЗаполнено(УзелПолНО) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НОПром = ПолучитьПредставлениеНалоговогоОрганаИзXML(УзелПолНО);
	
	Возврат НОПром;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьФИОДолжИзТэгаФИОДолж(УзелДокумент)
	
	ФИОДолж = "";
	
	УзелФИОДолж = ПолучитьУзел(УзелДокумент, "ФИОДолж");
	Если НЕ ЗначениеЗаполнено(УзелФИОДолж) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УзелФамилия 	= ПолучитьУзел(УзелФИОДолж, "Фамилия");
	УзелИмя 		= ПолучитьУзел(УзелФИОДолж, "Имя");
	УзелОтчество	= ПолучитьУзел(УзелФИОДолж, "Отчество", Ложь);
	
	ФИО = Новый Структура();
	ФИО.Вставить("Фамилия", 	СокрЛП(УзелФамилия.Значение));
	ФИО.Вставить("Имя", 		СокрЛП(УзелИмя.Значение));
	
	Если ЗначениеЗаполнено(УзелОтчество) Тогда
		ФИО.Вставить("Отчество", СокрЛП(УзелОтчество.Значение));
	Иначе
		ФИО.Вставить("Отчество", "");
	КонецЕсли;
		
	ФИОДолж = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ФИО);
	
	Возврат ФИОДолж;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПричинаОтказаИИмяФайлаИзУведомленияОбОтказеВПриеме(УзелДокумент)
	
	ПричинаОтказа = "";
	ИмяОбрабФайла = "";
	
	УзелСведУведОтказ = ПолучитьУзел(УзелДокумент, "СведУведОтказ");
	Если НЕ ЗначениеЗаполнено(УзелСведУведОтказ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УзелОбщСвУвед = ПолучитьУзел(УзелСведУведОтказ, "ОбщСвУвед");
	Если НЕ ЗначениеЗаполнено(УзелОбщСвУвед) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Имя файла
	ИменаПринятФайла = Новый Массив;
	СтрокиИмяПринятФайла = УзелОбщСвУвед.Строки.НайтиСтроки(Новый Структура("Имя", "ИмяПринятФайла"));
	Для Каждого СтрокаИмяПринятФайла Из СтрокиИмяПринятФайла Цикл
		ИменаПринятФайла.Добавить(СтрокаИмяПринятФайла.Значение);
	КонецЦикла;
	ИмяОбрабФайла = СтроковыеФункцииКлиентСервер.СтрокаИзМассиваПодстрок(ИменаПринятФайла, Символы.ПС);
	
	// Причина отказа.
	ПричиныОтказа = Новый Массив;
	ПричинаОтказа = ПеречВыявНар(УзелСведУведОтказ);
	ПричиныОтказа.Добавить(ПричинаОтказа);
	
	СтрокиВыявлНарФайл = УзелСведУведОтказ.Строки.НайтиСтроки(Новый Структура("Имя", "ВыявлНарФайл"));
	Для каждого СтрокаВыявлНарФайл Из СтрокиВыявлНарФайл Цикл
		ПричинаОтказа = ПеречВыявНар(СтрокаВыявлНарФайл);
		ПричиныОтказа.Добавить(ПричинаОтказа);
	КонецЦикла;  
	ПричинаОтказа = СтроковыеФункцииКлиентСервер.СтрокаИзМассиваПодстрок(ПричиныОтказа, Символы.ПС);
		
	СвойстваУведомления = Новый Структура();
	СвойстваУведомления.Вставить("ИмяОбрабФайла",  	ИмяОбрабФайла);
	СвойстваУведомления.Вставить("ПричинаОтказа",  	ПричинаОтказа);
	
	Возврат СвойстваУведомления;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДатуНапрИПостИзУведомленияОбОтказеВПриеме(УзелДокумент)
	
	УзелСведУведОтказ = ПолучитьУзел(УзелДокумент, "СведУведОтказ");
	Если НЕ ЗначениеЗаполнено(УзелСведУведОтказ) Тогда
		Возврат Неопределено;
	КонецЕсли;

	УзелОбщСвУвед = ПолучитьУзел(УзелСведУведОтказ, "ОбщСвУвед");
	Если НЕ ЗначениеЗаполнено(УзелОбщСвУвед) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УзелДатаНапр = ПолучитьУзел(УзелОбщСвУвед, "ДатаНапр");
	Если НЕ ЗначениеЗаполнено(УзелДатаНапр) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаНапр = УзелДатаНапр.Значение;
	
	УзелВремНапр = ПолучитьУзел(УзелОбщСвУвед, "ВремНапр");
	Если НЕ ЗначениеЗаполнено(УзелВремНапр) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВремНапр = УзелВремНапр.Значение;
	
	УзелДатаПост = ПолучитьУзел(УзелОбщСвУвед, "ДатаПост");
	Если НЕ ЗначениеЗаполнено(УзелДатаПост) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаПост = УзелДатаПост.Значение;
	
	СвойстваУведомления = Новый Структура();
	СвойстваУведомления.Вставить("ДатаНапр",  	ДатаНапр);
	СвойстваУведомления.Вставить("ВремНапр",  	ВремНапр);
	СвойстваУведомления.Вставить("ДатаПост",  	ДатаПост);
	
	Возврат СвойстваУведомления;
	
КонецФункции
	
&НаСервереБезКонтекста
Функция ПеречВыявНар(РодительскийУзел)
	
	ПеречВыявНар 		= Новый Массив;
	СтрокиПеречВыявНар 	= РодительскийУзел.Строки.НайтиСтроки(Новый Структура("Имя", "ПеречВыявНар"));
	Для Каждого СтрокаПеречВыявНар Из СтрокиПеречВыявНар Цикл
		
		УзелКодОш 	= ПолучитьУзел(СтрокаПеречВыявНар, "КодОш");
		УзелТекстОш = ПолучитьУзел(СтрокаПеречВыявНар, "ТекстОш");
		
		ВыявНар = НСтр("ru = '%1 (код ошибки %2)';
						|en = '%1 (error code %2)'");
		ВыявНар = СтрШаблон(ВыявНар, УзелТекстОш.Значение, УзелКодОш.Значение);
		
		ПеречВыявНар.Добавить(ВыявНар);
		
	КонецЦикла;
	ПричинаОтказа = СтроковыеФункцииКлиентСервер.СтрокаИзМассиваПодстрок(ПеречВыявНар, Символы.ПС);
	
	Возврат ПричинаОтказа;
	
Конецфункции

&НаСервереБезКонтекста
Функция ПолучитьОтправителяИзТэгаСвОтпрДокИлиСвАдр(УзелДокумент, ИмяТэга)
	
	Отправитель = "";
	
	// Сведения об отправителе отчетности
	ДанныеОтправителя = УзелДокумент.Строки.Найти(ИмяТэга, "Имя");
	ОтпрЮЛ     = ДанныеОтправителя.Строки.Найти("ОтпрЮЛ", "Имя");
	ОтпрФЛ     = ДанныеОтправителя.Строки.Найти("ОтпрФЛ", "Имя");
	ОтпрНО     = ДанныеОтправителя.Строки.Найти("ОтпрНО", "Имя");
	ПолЮЛ      = ДанныеОтправителя.Строки.Найти("ПолЮЛ", "Имя");
	ПолФЛ      = ДанныеОтправителя.Строки.Найти("ПолФЛ", "Имя");
	ПолНО      = ДанныеОтправителя.Строки.Найти("ПолНО", "Имя");
	КодНО      = ДанныеОтправителя.Строки.Найти("КодНО", "Имя");
	ФЛ         = ДанныеОтправителя.Строки.Найти("ФЛ", "Имя");
	ЮЛ         = ДанныеОтправителя.Строки.Найти("ЮЛ", "Имя");
	СпецОперат = ДанныеОтправителя.Строки.Найти("СпецОперат", "Имя");
	
	Если ЗначениеЗаполнено(ОтпрФЛ) Тогда
		Отправитель = ПолучитьПредставлениеНП(Ложь,ОтпрФЛ);
	ИначеЕсли ЗначениеЗаполнено(ОтпрЮЛ) Тогда
		Отправитель = ПолучитьПредставлениеНП(Истина,ОтпрЮЛ);
	ИначеЕсли ЗначениеЗаполнено(ПолФЛ) Тогда
		Отправитель = ПолучитьПредставлениеНП(Ложь,ПолФЛ);
	ИначеЕсли ЗначениеЗаполнено(ПолЮЛ) Тогда
		Отправитель = ПолучитьПредставлениеНП(Истина,ПолЮЛ);
	ИначеЕсли ЗначениеЗаполнено(ФЛ) Тогда
		Отправитель = ПолучитьПредставлениеНП(Ложь,ФЛ);
	ИначеЕсли ЗначениеЗаполнено(ЮЛ) Тогда
		Отправитель = ПолучитьПредставлениеНП(Истина,ЮЛ);
	ИначеЕсли ЗначениеЗаполнено(ОтпрНО) Тогда
		Отправитель = ПолучитьПредставлениеНалоговогоОрганаИзXML(ОтпрНО);
	ИначеЕсли ЗначениеЗаполнено(ПолНО) Тогда
		Отправитель = ПолучитьПредставлениеНалоговогоОрганаИзXML(ПолНО);
	ИначеЕсли ЗначениеЗаполнено(СпецОперат) Тогда
		Отправитель = ПолучитьПредставлениеОператораСвязиИзXML(СпецОперат);
	ИначеЕсли ЗначениеЗаполнено(КодНО) Тогда
		Отправитель = НСтр("ru = 'ИФНС %1';
							|en = 'IFTS %1'");
		Отправитель = СтрШаблон(Отправитель, КодНО.Значение);
	КонецЕсли;
	
	Возврат Отправитель;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьУзел(РодительскийУзел, ИмяУзла, ЭтоОбязательныйУзел = Истина)
	
	УзелИскомый = РодительскийУзел.Строки.Найти(ИмяУзла, "Имя");
	Если ЗначениеЗаполнено(УзелИскомый) Тогда
		Возврат УзелИскомый;
	Иначе
		
		Если ЭтоОбязательныйУзел Тогда
			ТекстСообщения = НСтр("ru = 'Некорректная структура XML уведомления: не обнаружен узел ""%1"".';
									|en = 'Incorrect structure of XML notification: the ""%1"" node not found.'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, ИмяУзла); 
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		КонецЕсли;
		
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СформироватьТабличныйДокументНаОсновеУведомленияОбОтказеВПриемеНалоговойДекларацииОтметки(Заголовок, ИмяФайла, Тело, НижнийКолонтитул)
	
	// формируем таблицу с объявлениями полей узла с общими сведениями
	ПоляОбщихСведений = Новый ТаблицаЗначений;
	ПоляОбщихСведений.Колонки.Добавить("Код");
	ПоляОбщихСведений.Колонки.Добавить("Имя");
	
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ИдФайл", "Идентификатор файла");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "НомерДокНП", "Номер заявления");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ДатаДокНП", "Дата заявления");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "РегНомДок", "Рег. номер заявления в налоговом органе");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ДатаРегЭл", "Дата регистрации в НО в электронном виде");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ДатаРегБум", "Дата регистрации в НО на бумажном носителе");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "НомерУведОткз", "Номер уведомления об отказе в проставлении отметки");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ДатаУведОткз", "Дата уведомления об отказе в проставлении отметки");
	
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "НомерДокНП2", "Номер нового заявления");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ДатаДокНП2", "Дата нового заявления");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "РегНомДок2", "Рег. номер нового заявления в налоговом органе");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ДатаРегЭл2", "Дата регистрации нового заявления в НО в электронном виде");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ДатаРегБум2", "Дата регистрации нового заявления в НО на бумажном носителе");
	
	// получаем бланк отчета из макета
	Бланк = ПолучитьМакетОбработки("БланкПечатиДИВ");
	
	// инициализируем итоговый табличный документ
	ТаблДок = Новый ТабличныйДокумент;
	ТаблДок.АвтоМасштаб = Истина;
	
	// выводим секцию заголовка
	Секция_Заголовок = Бланк.ПолучитьОбласть("Секция_Заголовок");
	Секция_Заголовок.Области.Заголовок.Текст = Заголовок;
	Секция_Заголовок.Области.Файл.Текст = ИмяФайла;
	ТаблДок.Вывести(Секция_Заголовок);
	
	// выводим разделитель
	Секция_Разделитель = Бланк.ПолучитьОбласть("Секция_Разделитель");
	ТаблДок.Вывести(Секция_Разделитель);
	
	// пытаемся разобрать сообщение
	СвойстваСообщения = ПолучитьОсновныеСвойстваИзУведомленияОбОтказеВПриемеНалоговойДекларацииОтметки(Тело);
	
	// если разобрать не удалось - выводим его в виде текста
	Если НЕ ЗначениеЗаполнено(СвойстваСообщения) Тогда
		
		Секция_Тело = Бланк.ПолучитьОбласть("Секция_Тело");
		ВывестиТекстПострочно(ТаблДок, Секция_Тело, Тело);
		
		// если текст сообщения разобрать удалось, то выводим основную инфорфмацию из него
	Иначе
		
		Секция_Тело = Бланк.ПолучитьОбласть("Секция_Тело");
		
		Если СвойстваСообщения.Ошибки.Количество() > 0 Тогда
			
			// выводим "шапку" таблицы ошибок
			Секция_ЗаголовокГруппы = Бланк.ПолучитьОбласть("Секция_ЗаголовокГруппы");
			Секция_ЗаголовокГруппы.Области.ЗаголовокГруппы.Текст = "Ошибки:";
			ТаблДок.Вывести(Секция_ЗаголовокГруппы);
			
			// получаем область для вывода единицы информации сообщения
			Для Каждого Ошибка Из СвойстваСообщения.Ошибки Цикл
				ВывестиТекстПострочно(ТаблДок, Секция_Тело, "Ошибка: " + Ошибка.Описание);
			КонецЦикла;
			
			// выводим пустую строку - разделитель
			Секция_Тело.Области.Тело.Текст = "";
			ТаблДок.Вывести(Секция_Тело);
			
		КонецЕсли;
		
		// выводим "шапку" общих сведений
		Секция_ЗаголовокГруппы = Бланк.ПолучитьОбласть("Секция_ЗаголовокГруппы");
		Секция_ЗаголовокГруппы.Области.ЗаголовокГруппы.Текст = "Общие сведения:";
		ТаблДок.Вывести(Секция_ЗаголовокГруппы);
		
		// выводим общие сведения поэлементно
		ОбщиеСведенияСообщения = СвойстваСообщения.ОбщиеСведения;
		Для Каждого ПолеОбщихСведений Из ПоляОбщихСведений Цикл
			Если ОбщиеСведенияСообщения.Свойство(ПолеОбщихСведений.Код) Тогда
				ЗначениеПоля = ОбщиеСведенияСообщения[ПолеОбщихСведений.Код];
				Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
					Секция_Тело.Области.Тело.Текст = ПолеОбщихСведений.Имя + ": " + СокрЛП(ЗначениеПоля);
					ТаблДок.Вывести(Секция_Тело);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблДок.Вывести(Секция_Разделитель);
	СформироватьТабличныйДокументСекцияПодписи(ТаблДок, Бланк, ТаблицаПодписей);

	// инициализируем текст нижнего колонтитула
	ТаблДок.НижнийКолонтитул.ТекстСлева = НижнийКолонтитул;
	
	
	Возврат ТаблДок;
	
КонецФункции

&НаСервере
Функция СформироватьТабличныйДокументНаОсновеУведомленияОбОтказеВПриемеНалоговойДекларацииЗаявление(Заголовок, ИмяФайла, Тело, НижнийКолонтитул)
	
	// формируем таблицу с объявлениями полей узла с общими сведениями
	ПоляОбщихСведений = Новый ТаблицаЗначений;
	ПоляОбщихСведений.Колонки.Добавить("Код");
	ПоляОбщихСведений.Колонки.Добавить("Имя");
	
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ИмяПринятФайла", "Имя принятого файла");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ИдФайл", "Идентификатор файла");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ДатаВремяНапр", "Дата и время направления");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "КНД", "Код формы по КНД");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "НаимВидДок", "Наименование вида документа");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ДатаПост", "Дата поступления отчета");
	
	// получаем бланк отчета из макета
	Бланк = ПолучитьМакетОбработки("БланкПечатиДИВ");
	
	// инициализируем итоговый табличный документ
	ТаблДок = Новый ТабличныйДокумент;
	ТаблДок.АвтоМасштаб = Истина;
	
	// выводим секцию заголовка
	Секция_Заголовок = Бланк.ПолучитьОбласть("Секция_Заголовок");
	Секция_Заголовок.Области.Заголовок.Текст = Заголовок;
	Секция_Заголовок.Области.Файл.Текст = ИмяФайла;
	ТаблДок.Вывести(Секция_Заголовок);
	
	// выводим разделитель
	Секция_Разделитель = Бланк.ПолучитьОбласть("Секция_Разделитель");
	ТаблДок.Вывести(Секция_Разделитель);
	
	// пытаемся разобрать уведомление
	// получим структуру ("Ошибки, НарушенияФайлов, ОбщиеСведения")
	СвойстваИзУведомления = ПолучитьОсновныеСвойстваИзУведомленияОбОтказеВПриемеНалоговойДекларацииЗаявление(Тело);
	
	// если разобрать не удалось - выводим его в виде текста
	Если НЕ ЗначениеЗаполнено(СвойстваИзУведомления) Тогда
		
		Секция_Тело = Бланк.ПолучитьОбласть("Секция_Тело");
		ВывестиТекстПострочно(ТаблДок, Секция_Тело, Тело);
		
		// если текст уведомления разобрать удалось, то выводим основную инфорфмацию из него
	Иначе
		
		Секция_Тело = Бланк.ПолучитьОбласть("Секция_Тело");
		
		// выводим "шапку" таблицы ошибок
		Секция_ЗаголовокГруппы = Бланк.ПолучитьОбласть("Секция_ЗаголовокГруппы");
		Секция_ЗаголовокГруппы.Области.ЗаголовокГруппы.Текст = "Выявленные нарушения:";
		ТаблДок.Вывести(Секция_ЗаголовокГруппы);
		
		// получаем область для вывода единицы информации уведомления
		Для Каждого Ошибка Из СвойстваИзУведомления.Ошибки Цикл
			ВывестиТекстПострочно(ТаблДок, Секция_Тело, "Ошибка " + Ошибка.КодОшибки + ": " + Ошибка.Описание);
		КонецЦикла;
		
		// выводим пустую строку - разделитель
		Секция_Тело.Области.Тело.Текст = "";
		ТаблДок.Вывести(Секция_Тело);
		
		// выводим "шапку" общих сведений
		Секция_ЗаголовокГруппы = Бланк.ПолучитьОбласть("Секция_ЗаголовокГруппы");
		Секция_ЗаголовокГруппы.Области.ЗаголовокГруппы.Текст = "Общие сведения:";
		ТаблДок.Вывести(Секция_ЗаголовокГруппы);
		
		// выводим общие сведения поэлементно
		ОбщиеСведенияСообщения = СвойстваИзУведомления.ОбщиеСведения;
		Для Каждого ПолеОбщихСведений Из ПоляОбщихСведений Цикл
			Если ОбщиеСведенияСообщения.Свойство(ПолеОбщихСведений.Код) Тогда
				ЗначениеПоля = ОбщиеСведенияСообщения[ПолеОбщихСведений.Код];
				Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
					Секция_Тело.Области.Тело.Текст = ПолеОбщихСведений.Имя + ": " + СокрЛП(ЗначениеПоля);
					ТаблДок.Вывести(Секция_Тело);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблДок.Вывести(Секция_Разделитель);
	СформироватьТабличныйДокументСекцияПодписи(ТаблДок, Бланк, ТаблицаПодписей);
	
	// инициализируем текст нижнего колонтитула
	ТаблДок.НижнийКолонтитул.ТекстСлева = НижнийКолонтитул;
	
	
	Возврат ТаблДок;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОсновныеСвойстваИзУведомленияОбОтказеВПриемеНалоговойДекларацииОтметки(СтрСообщение)
	
	Если НЕ ЗначениеЗаполнено(СтрСообщение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаОшибок = Новый ТаблицаЗначений;
	ТаблицаОшибок.Колонки.Добавить("Описание");

	ОбщиеСведения = Новый Структура;
	
	// создаем дерево на основе строки XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений( , СтрСообщение, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка разбора XML файла:%1';
																						|en = 'An error occurred while parsing XML file:%1'"),
			Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем XML
	УзелФайл = ДеревоXML.Строки.Найти("Файл", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML файла: не обнаружен узел ""Файл"".';
								|en = 'Incorrect structure of XML file: the ""File"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого УзелСведений Из УзелФайл.Строки Цикл
		ИмяУзла = УзелСведений.Имя;
		Если ИмяУзла = "ИдФайл" ИЛИ ИмяУзла = "ВерсПрог" ИЛИ ИмяУзла = "ВерсФорм" Тогда
			ОбщиеСведения.Вставить(УзелСведений.Имя, СокрЛП(УзелСведений.Значение));
		КонецЕсли;
	КонецЦикла;
	
	УзелДокумент = УзелФайл.Строки.Найти("Документ", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелДокумент) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML файла: не обнаружен узел ""Документ"".';
								|en = 'Incorrect structure of XML file: the ""Document"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого УзелОбщСвед Из УзелДокумент.Строки Цикл
		ОбщиеСведения.Вставить(УзелОбщСвед.Имя, СокрЛП(УзелОбщСвед.Значение));
	КонецЦикла;

	УзелСвУведом = УзелДокумент.Строки.Найти("СвУведом", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелСвУведом) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML файла: не обнаружен узел ""СвУведом"".';
								|en = 'Incorrect structure of XML file: the ""СвУведом"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// разбираем узел с общими сведениями
	Для Каждого УзелОбщСвед Из УзелСвУведом.Строки Цикл
		ОбщиеСведения.Вставить(УзелОбщСвед.Имя, СокрЛП(УзелОбщСвед.Значение));
	КонецЦикла;
	
	// анализируем сведения о несоответствиях
	УзлыСвНесоотв = УзелСвУведом.Строки.НайтиСтроки(Новый Структура("Имя", "СвНесоотв"));
	Для Каждого УзелСвНесоотв Из УзлыСвНесоотв Цикл
		НовСтр = ТаблицаОшибок.Добавить();
		НовСтр.Описание = СокрЛП(УзелСвНесоотв.Значение);
	КонецЦикла;
	
	// анализируем сведения о непредставленных документах
	УзлыСвНепредст = УзелСвУведом.Строки.НайтиСтроки(Новый Структура("Имя", "СвНепредст"));
	Для Каждого УзелСвНепредст Из УзлыСвНепредст Цикл
		НовСтр = ТаблицаОшибок.Добавить();
		НовСтр.Описание = СокрЛП(УзелСвНепредст.Значение);
	КонецЦикла;
	
	// дополняем узел с общими сведениями
	УзелСвНовЗаяв = УзелСвУведом.Строки.Найти("СвНовЗаяв", "Имя");
	Если ЗначениеЗаполнено(УзелСвНовЗаяв) Тогда
		Для Каждого УзелОбщСвед Из УзелСвНовЗаяв.Строки Цикл
			ОбщиеСведения.Вставить(УзелОбщСвед.Имя, СокрЛП(УзелОбщСвед.Значение));
		КонецЦикла;
	КонецЕсли;
	
	Возврат Новый Структура("Ошибки, ОбщиеСведения", ТаблицаОшибок, ОбщиеСведения);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОсновныеСвойстваИзУведомленияОбОтказеВПриемеНалоговойДекларацииЗаявление(СтрУведомление)
	
	Если НЕ ЗначениеЗаполнено(СтрУведомление) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Ошибки = Новый ТаблицаЗначений;
	Ошибки.Колонки.Добавить("КодОшибки");
	Ошибки.Колонки.Добавить("Описание");
	
	// создаем дерево на основе строки XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений( , СтрУведомление, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка разбора XML файла:%1';
																						|en = 'An error occurred while parsing XML file:%1'"),
			Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем XML
	УзелФайл = ДеревоXML.Строки.Найти("Файл", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML файла: не обнаружен узел ""Файл"".';
								|en = 'Incorrect structure of XML file: the ""File"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелДокумент = УзелФайл.Строки.Найти("Документ", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелДокумент) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML файла: не обнаружен узел ""Документ"".';
								|en = 'Incorrect structure of XML file: the ""Document"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелСведУведОтказ = УзелДокумент.Строки.Найти("СведУведОтказ", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелСведУведОтказ) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML файла: не обнаружен узел ""СведУведОтказ"".';
								|en = 'Incorrect structure of XML file: the ""СведУведОтказ"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелОбщСвУвед = УзелСведУведОтказ.Строки.Найти("ОбщСвУвед", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелОбщСвУвед) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML файла: не обнаружен узел ""ОбщСвУвед"".';
								|en = 'Incorrect structure of XML file: the ""ОбщСвУвед"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем общий перечень нарушений
	УзлыПеречВыявНар = УзелСведУведОтказ.Строки.НайтиСтроки(Новый Структура("Имя", "ПеречВыявНар"));
	Для Каждого УзелПеречВыявНар Из УзлыПеречВыявНар Цикл
		УзелКодОш = УзелПеречВыявНар.Строки.Найти("КодОш", "Имя");
		УзелТекстОш = УзелПеречВыявНар.Строки.Найти("ТекстОш", "Имя");
		Если ЗначениеЗаполнено(УзелКодОш) ИЛИ ЗначениеЗаполнено(УзелТекстОш) Тогда
			
			КодОшибки = ?(ЗначениеЗаполнено(УзелКодОш), СокрЛП(УзелКодОш.Значение), "");
			ТекстОшибки = ?(ЗначениеЗаполнено(УзелТекстОш), СокрЛП(УзелТекстОш.Значение), "");
			
			НовСтр = Ошибки.Добавить();
			НовСтр.КодОшибки = КодОшибки;
			НовСтр.Описание = ТекстОшибки;
			
		КонецЕсли;
	КонецЦикла;
	
	// разбираем узел с перечнем выявленных нарушений
	Если УзлыПеречВыявНар.Количество() = 0 Тогда
		УзлыВыявлНарФайл = УзелСведУведОтказ.Строки.НайтиСтроки(Новый Структура("Имя", "ВыявлНарФайл"));
		Для Каждого УзелВыявНарФайл Из УзлыВыявлНарФайл Цикл
			УзлыПеречВыявНар = УзелВыявНарФайл.Строки.НайтиСтроки(Новый Структура("Имя", "ПеречВыявНар"));
			Для Каждого УзелПеречВыявНар Из УзлыПеречВыявНар Цикл
				УзелКодОш = УзелПеречВыявНар.Строки.Найти("КодОш", "Имя");
				УзелТекстОш = УзелПеречВыявНар.Строки.Найти("ТекстОш", "Имя");
				Если ЗначениеЗаполнено(УзелКодОш) ИЛИ ЗначениеЗаполнено(УзелТекстОш) Тогда
					
					КодОшибки = ?(ЗначениеЗаполнено(УзелКодОш), СокрЛП(УзелКодОш.Значение), "");
					ТекстОшибки = ?(ЗначениеЗаполнено(УзелТекстОш), СокрЛП(УзелТекстОш.Значение), "");
					
					НовСтр = Ошибки.Добавить();
					НовСтр.КодОшибки = КодОшибки;
					НовСтр.Описание = ТекстОшибки;
					
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	// разбираем узел с общими сведениями
	ОбщиеСведения = Новый Структура;
	УзелОбщСвУвед = УзелСведУведОтказ.Строки.Найти("ОбщСвУвед", "Имя");
	Для Каждого УзелСведение Из УзелОбщСвУвед.Строки Цикл
		ОбщиеСведения.Вставить(УзелСведение.Имя, СокрЛП(УзелСведение.Значение));
	КонецЦикла;
	
	Если ОбщиеСведения.Свойство("ДатаНапр") И ОбщиеСведения.Свойство("ВремНапр") Тогда
		ОбщиеСведения.Вставить("ДатаВремяНапр", ОбщиеСведения.ДатаНапр + " " + ОбщиеСведения.ВремНапр);
	КонецЕсли;
	
	Возврат Новый Структура("Ошибки, ОбщиеСведения", Ошибки, ОбщиеСведения);
	
КонецФункции

&НаСервере
Функция ЕстьВозможностьОбмена(Организации, ЭтоОбменИзЖурналаОбмена) Экспорт
	
	ОбменВозможен = Ложь;
	
	ЕстьПравоНаДокументооборот 	= Ложь;
	ЕстьХотяБыОднаУчетнаяЗапись = Ложь;
	ЕстьЭДОСПрочимиОрганами 	= Ложь;
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	
	Для каждого Организация Из Организации Цикл
		
		// Учетная запись.
		УчетнаяЗапись = КонтекстЭДОСервер.УчетнаяЗаписьОрганизации(Организация);
		
		Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда
			
			ЕстьХотяБыОднаУчетнаяЗапись = Истина;
			
			ОбменПоДаннойУчетнойЗаписиВозможен = КонтекстЭДОСервер.ПользователюРазрешеноВыполнятьОбменПоУчетнойЗаписи(УчетнаяЗапись);
		
			Если ОбменПоДаннойУчетнойЗаписиВозможен Тогда
				ЕстьПравоНаДокументооборот 	= Истина;
				ОбменВозможен 				= Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ ЭтоОбменИзЖурналаОбмена Тогда
		
			// ФСС.
			ЕстьОбменСФСС = КонтекстЭДОСервер.ОрганизацияИспользуетОбменСФСС(Организация);
				
			Если ЕстьОбменСФСС Тогда
				ЕстьЭДОСПрочимиОрганами = Истина;
				ОбменВозможен = Истина;
			КонецЕсли;
			
			// ФСРАР.
			ЕстьОбменСФСРАР = КонтекстЭДОСервер.ОрганизацияИспользуетОбменСФСРАР(Организация);
				
			Если ЕстьОбменСФСРАР Тогда
				ЕстьЭДОСПрочимиОрганами = Истина;
				ОбменВозможен = Истина;
			КонецЕсли;
			
			// РПН.
			ЕстьОбменСРПН = КонтекстЭДОСервер.ОрганизацияИспользуетОбменСРПН(Организация);
				
			Если ЕстьОбменСРПН Тогда
				ЕстьЭДОСПрочимиОрганами = Истина;
				ОбменВозможен = Истина;
			КонецЕсли;
			
			// ФТС.
			ЕстьОбменСФТС = КонтекстЭДОСервер.ОрганизацияИспользуетОбменСФТС(Организация);
				
			Если ЕстьОбменСФТС Тогда
				ЕстьЭДОСПрочимиОрганами = Истина;
				ОбменВозможен = Истина;
			КонецЕсли;
			
			// Банк России
			ЕстьОбменСБанкомРоссии = КонтекстЭДОСервер.ОрганизацияИспользуетОбменСБанкомРоссии(Организация);
				
			Если ЕстьОбменСБанкомРоссии Тогда
				ЕстьЭДОСПрочимиОрганами = Истина;
				ОбменВозможен = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ОбменВозможен Тогда
		
		ТекстНедостаточноПрав = НСтр("ru = 'Недостаточно прав для проведения обновления. 
			|Убедитесь, что ваш пользователь указан в списке пользователей учетной записи документооборота организации.';
			|en = 'Insufficient rights to update.
			|Make sure the user is specified in the account users list of company data interchange.'");
		
		Если ЭтоОбменИзЖурналаОбмена Тогда
			
			Если НЕ ЕстьХотяБыОднаУчетнаяЗапись Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					НСтр("ru = 'Для организации не настроена возможность отправки в контролирующие органы';
						|en = 'Sending to regulatory authorities is not configured for the company'"));
			ИначеЕсли НЕ ЕстьПравоНаДокументооборот Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстНедостаточноПрав);
			КонецЕсли;
				
		Иначе
			
			Если НЕ ЕстьПравоНаДокументооборот Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстНедостаточноПрав);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОбменВозможен;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИзВременногоХранилищаЕслиСтрока(Адрес, ПривестиКСтроке = Ложь)
	
	ДанныеВременногоХранилища = ПолучитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(ДанныеВременногоХранилища) = Тип("Строка") Тогда
		Возврат ДанныеВременногоХранилища;
		
	ИначеЕсли ПривестиКСтроке И ТипЗнч(ДанныеВременногоХранилища) = Тип("ДвоичныеДанные") Тогда
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		ДанныеВременногоХранилища.Записать(ИмяВременногоФайла);
		
		ОбъектЧтениеТекста = Новый ЧтениеТекста(ИмяВременногоФайла, "windows-1251");
		ТекстФайла = ОбъектЧтениеТекста.Прочитать();
		ОбъектЧтениеТекста.Закрыть();
		
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайла);
		
		Возврат ТекстФайла;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

