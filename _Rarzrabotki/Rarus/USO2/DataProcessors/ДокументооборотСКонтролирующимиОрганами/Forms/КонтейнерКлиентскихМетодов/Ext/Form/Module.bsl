	МодульДокументооборотСМинобороныСлужебныйКлиент.ПолучитьСвойстваПрограммыМенеджераКриптографии(ОписаниеОповещенияПродолжения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМОРФПослеПолученияСвойствПрограммыДляМенеджераКриптографии(РезультатПолученияСвойств, ДополнительныеПараметры) Экспорт
	
	Если РезультатПолученияСвойств.Свойства = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр(СтрШаблон("ru = 'Формирование пакета прервано по причине: %1'", РезультатПолученияСвойств.ОписаниеОшибки)));
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(Неопределено);
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	ОрганизацияСсылка = ДополнительныеПараметры.ОрганизацияСсылка;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Организация", ОрганизацияСсылка);
	
	Оповещение = Новый ОписаниеОповещения(
		"ВыгрузитьПакетДляОтправкиВМОРФПослеВводаПараметровВыгрузки",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ВыгрузкаПакетаДляМинобороны", 
		ПараметрыФормы,
		ДополнительныеПараметры.Форма,
		,
		,
		,
		Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМОРФПослеВводаПараметровВыгрузки(ПараметрыВыгрузки, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение        = ДополнительныеПараметры.ВыполняемоеОповещение;
	ИмяФайлаВыгрузки             = ДополнительныеПараметры.ИмяФайлаВыгрузки;
	АдресФайлаВыгрузки           = ДополнительныеПараметры.АдресФайлаВыгрузки;
	СертификатыИПараметрыОбмена  = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ОрганизацияСсылка            = ДополнительныеПараметры.ОрганизацияСсылка;
			
	Если ПараметрыВыгрузки = Неопределено Тогда
		// нажата кнопка Отмена
		Возврат;
	КонецЕсли;
		
	ДополнительныеПараметры.Вставить("КаталогВыгрузки", ПараметрыВыгрузки.КаталогВыгрузки);
	ДополнительныеПараметры.Вставить("Пароль", ПараметрыВыгрузки.Пароль);
	
	ВыполняемоеОповещение        = ДополнительныеПараметры.ВыполняемоеОповещение;
	СертификатыИПараметрыОбмена  = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ОрганизацияСсылка            = ДополнительныеПараметры.ОрганизацияСсылка;
	
	Оповещение = Новый ОписаниеОповещения(
		"ВыгрузитьПакетДляОтправкиВМОРФПослеПолученияСертификатовИПараметровОбмена",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	СертификатыИПараметрыОбменаОрганизацииДляМОРФ(
		Оповещение,
		ОрганизацияСсылка,
		Ложь,
		Неопределено,
		);

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМОРФПослеПолученияСертификатовИПараметровОбмена(СертификатыИПараметрыОбмена, ДополнительныеПараметры) Экспорт

	ВыполняемоеОповещение               = ДополнительныеПараметры.ВыполняемоеОповещение;
	Идентификатор                       = ДополнительныеПараметры.Идентификатор;
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	ТипЗнчСсылкаНаОтчет                 = ДополнительныеПараметры.ТипЗнчСсылкаНаОтчет;
	Форма                               = ДополнительныеПараметры.Форма;
	АдресФайлаВыгрузки                  = ДополнительныеПараметры.АдресФайлаВыгрузки;
	ИмяФайлаВыгрузки                    = ДополнительныеПараметры.ИмяФайлаВыгрузки;
	ПарольКонтейнера                    = ДополнительныеПараметры.Пароль;
	
	ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена", СертификатыИПараметрыОбмена);
	
	Если СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.СертификатАбонента = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Использование документооборота с министерством обороны РФ не включено для организации!';
															|en = 'Use of data interchange with the Ministry of Defence of the Russian Federation is not enabled for the company.'"));
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(Неопределено);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	// запрашиваем параметры формирования пакета и параметры обмена при вызове из отправки
	Если НЕ СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.ИспользоватьОбмен Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Использование документооборота с министерством обороны РФ не включено для организации!';
															|en = 'Use of data interchange with the Ministry of Defence of the Russian Federation is not enabled for the company.'"));
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(Неопределено);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
		
	СертификатАбонента = СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.СертификатАбонента;
	
	//проверяем сертификаты
	СертификатыОбмена = Новый СписокЗначений();
	СертификатыОбмена.Добавить(СертификатАбонента, НСтр("ru = 'Сертификат подписи';
														|en = 'Signature certificate'"));
	
	Если НЕ СертификатыГодятсяДляПодписанияОтчетностиМОРФ(СертификатыОбмена) Тогда
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(Неопределено);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки", ИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("АдресФайлаВыгрузки", АдресФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("СертификатАбонента", СертификатАбонента);
	ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена", СертификатыИПараметрыОбмена);
	
	ДвоичныеДанныеФайлаВыгрузки = ПолучитьИзВременногоХранилища(АдресФайлаВыгрузки);
	
	// подписываем
	ДлительнаяОтправкаКлиент.ВывестиСостояние(НСтр("ru = 'Подписание файла выгрузки ...';
													|en = 'Signing an export file ...'"));
	
	МодульДокументооборотСМинобороныКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиент");
	
	ПараметрыПодписи = Новый Структура;
	ПараметрыПодписи.Вставить("Сертификат", СертификатАбонента);
	ПараметрыПодписи.Вставить("Данные", ДвоичныеДанныеФайлаВыгрузки);
	ПараметрыПодписи.Вставить("Сертификат", СертификатАбонента);
	ПараметрыПодписи.Вставить("ПарольДоступаКЗакрытомуКлючу", Строка(ПарольКонтейнера));
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВМОРФПослеПодписания", 
							ЭтотОбъект, 
							ДополнительныеПараметры);
							
	МодульДокументооборотСМинобороныКлиент.ПодписатьCadesBes(
		Оповещение,
		ПараметрыПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМОРФПослеПодписания(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение        = ДополнительныеПараметры.ВыполняемоеОповещение;
	ИмяФайлаВыгрузки             = ДополнительныеПараметры.ИмяФайлаВыгрузки;
	АдресФайлаВыгрузки           = ДополнительныеПараметры.АдресФайлаВыгрузки;
	СертификатАбонента           = ДополнительныеПараметры.СертификатАбонента;
	СертификатыИПараметрыОбмена  = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	КаталогВыгрузки              = ДополнительныеПараметры.КаталогВыгрузки;
	ОтчетСсылка                  = ДополнительныеПараметры.ОтчетСсылка;
	Организация                  = ДополнительныеПараметры.ОрганизацияСсылка;
	ИНН                          = ДополнительныеПараметры.ИНН;
	
	Если НЕ Результат.ПодписьВыполнена Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось подписать файл данных. Описание ошибки: " + Результат.ОписаниеОшибки + "'"));
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(СертификатыИПараметрыОбмена);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	Если Результат.ПодписанныеДанные = Неопределено Тогда // такое может быть в веб-клиенте если пользователь не подтвердил действие расширения криптографии
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Подпись данных не создана.';
															|en = 'Data signature is not created.'"));
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(СертификатыИПараметрыОбмена);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли; 
	
	// создание архива
	ДлительнаяОтправкаКлиент.ВывестиСостояние(НСтр("ru = 'Создание архива с данными ...';
													|en = 'Creating an archive with data...'"));
	
	ПодписьСтрокой = Base64Строка(Результат.ПодписанныеДанные);
	
	ДополнительныеПараметры.Вставить("СтрокаДанныхПодписи", ПодписьСтрокой);
	ДополнительныеПараметры.Вставить("ИмяФайлаПодписи", "message.sign");
	
	ПараметрыАрхивации = Новый Структура("СтрокаДанныхПодписи,
											|ИмяФайлаПодписи,
											|АдресФайлаВыгрузки,
											|ИмяФайлаВыгрузки,
											|ОтчетСсылка");
	
	ЗаполнитьЗначенияСвойств(ПараметрыАрхивации, ДополнительныеПараметры);
	
	// создаем архрив пакета на сервере
	МодульДокументооборотСМинобороныВызовСервера = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныВызовСервера");
	РезультатФормированияАрхива = МодульДокументооборотСМинобороныВызовСервера.СформироватьАрхивПакета(ПараметрыАрхивации);
	
	Если НЕ РезультатФормированияАрхива.Выполнено Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось сформировать файл пакета по причине: " + Результат. ОписаниеОшибки + "'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(СертификатыИПараметрыОбмена);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	ДатаОтправки = ТекущаяДатаНаСервере();
	ДополнительныеПараметры.Вставить("АдресДанныхПакета", РезультатФормированияАрхива.АдресАрхива);
	ДополнительныеПараметры.Вставить("ДатаОтправки", ДатаОтправки);
	АдресДанныхПакета = РезультатФормированияАрхива.АдресАрхива;
	ДатаСоставления = РезультатФормированияАрхива.ДатаСоставления;
	
	КаталогВыгрузки = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогВыгрузки);
	
	КоличествоОтправок = МодульДокументооборотСМинобороныВызовСервера.ПолучитьКоличествоОтправокМинобороныНаДату(
		Организация,
		ДатаОтправки);
		
	// формируем имя файла пакета
	ДанныеДляФормированияИмениПакета = Новый Структура;
	ДанныеДляФормированияИмениПакета.Вставить("ИНН", ИНН);
	ДанныеДляФормированияИмениПакета.Вставить("ДатаОтправки", ДатаОтправки);
	ДанныеДляФормированияИмениПакета.Вставить("ДатаСоставления", ДатаСоставления);
	ДанныеДляФормированияИмениПакета.Вставить("НомерФайла", КоличествоОтправок + 1);
	МодульДокументооборотСМинобороныКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиентСервер");
	ИмяФайлаПакета = МодульДокументооборотСМинобороныКлиентСервер.СформироватьИмяФайлаПакета(ДанныеДляФормированияИмениПакета);
		
	ДополнительныеПараметры.Вставить("ИмяФайлаПакета", ИмяФайлаПакета);
	
	ОписаниеФайла = Новый ОписаниеПередаваемогоФайла;
	ОписаниеФайла.Имя = ИмяФайлаПакета;
	ОписаниеФайла.Хранение = АдресДанныхПакета;
	ПолучаемыеФайлы = Новый Массив;
	ПолучаемыеФайлы.Добавить(ОписаниеФайла);

	ДлительнаяОтправкаКлиент.ВывестиСостояние(НСтр("ru = 'Получение файла пакета...';
													|en = 'Receiving the package file...'"));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВМОРФПослеПолученияФайлов",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	НачатьПолучениеФайлов(ОписаниеОповещения, ПолучаемыеФайлы, КаталогВыгрузки, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМОРФПослеПолученияФайлов(ПолученныеФайлы, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение        = ДополнительныеПараметры.ВыполняемоеОповещение;
	СертификатыИПараметрыОбмена  = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	КаталогВыгрузки              = ДополнительныеПараметры.КаталогВыгрузки;
	АдресФайлаВыгрузки           = ДополнительныеПараметры.АдресФайлаВыгрузки;
	ОтчетСсылка                  = ДополнительныеПараметры.ОтчетСсылка;
	АдресДанныхПакета            = ДополнительныеПараметры.АдресДанныхПакета;
	
	Если ПолученныеФайлы = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Ошибка получения файлов!"));
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(СертификатыИПараметрыОбмена);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	ПолноеИмяФайлаАрхива = ПолученныеФайлы[0].Имя;
	ДополнительныеПараметры.Вставить("ПолноеИмяФайлаАрхива", ПолноеИмяФайлаАрхива);
	
	ПараметрыСохранения = Новый Структура("
		|ОтчетСсылка,
		|ИмяФайлаПакета,
		|ОрганизацияСсылка,
		|КаталогВыгрузки,
		|АдресДанныхПакета,
		|ДатаОтправки");
	ЗаполнитьЗначенияСвойств(ПараметрыСохранения, ДополнительныеПараметры);
	
	// сохраняем отправку
	МодульДокументооборотСМинобороныВызовСервера = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныВызовСервера");
	МодульДокументооборотСМинобороныВызовСервера.СохранитьПакет(ПараметрыСохранения);
	
	УдалитьИзВременногоХранилища(АдресДанныхПакета);
	УдалитьИзВременногоХранилища(АдресФайлаВыгрузки);
	
	МодульДокументооборотСМинобороныКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиент");
	МодульДокументооборотСМинобороныКлиент.ЗаписьОбъектовРегламентированнойОтчетности(ОтчетСсылка, Ложь);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВМОРФПослеВопросаОткрытьПапкуВыгрузкиЗавершение", 
		ЭтотОбъект,
		ДополнительныеПараметры);
	ПоказатьВопрос(ОписаниеОповещения, "Выгрузка завершена. Открыть каталог с выгруженным пакетом?",РежимДиалогаВопрос.ДаНет, 60);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМОРФПослеВопросаОткрытьПапкуВыгрузкиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение        = ДополнительныеПараметры.ВыполняемоеОповещение;
	СертификатыИПараметрыОбмена  = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	КаталогВыгрузки              = ДополнительныеПараметры.КаталогВыгрузки;
	АдресФайлаВыгрузки           = ДополнительныеПараметры.АдресФайлаВыгрузки;
	ПолноеИмяФайлаАрхива         = ДополнительныеПараметры.ПолноеИмяФайлаАрхива;

	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВМОРФПослеОткрытияКаталогаЗавершение", 
			ЭтотОбъект,
			ДополнительныеПараметры);

		НачатьЗапускПриложения(ОписаниеОповещения, КаталогВыгрузки);
		Возврат;
	КонецЕсли; 
	
	Результат = Новый Структура("РезультатВыгрузки,
		|СертификатыИПараметрыОбмена, 
		|КаталогВыгрузки",
		ПолноеИмяФайлаАрхива,
		СертификатыИПараметрыОбмена,
		КаталогВыгрузки);
									
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Функция ВыгрузитьПакетДляОтправкиВМОРФПослеОткрытияКаталогаЗавершение(КодВозврата, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение        = ДополнительныеПараметры.ВыполняемоеОповещение;
	СертификатыИПараметрыОбмена  = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	КаталогВыгрузки              = ДополнительныеПараметры.КаталогВыгрузки;
	АдресФайлаВыгрузки           = ДополнительныеПараметры.АдресФайлаВыгрузки;
	ПолноеИмяФайлаАрхива         = ДополнительныеПараметры.ПолноеИмяФайлаАрхива;

	
	Результат = Новый Структура("РезультатВыгрузки,
		|СертификатыИПараметрыОбмена, 
		|КаталогВыгрузки",
		ПолноеИмяФайлаАрхива,
		СертификатыИПараметрыОбмена,
		КаталогВыгрузки);
		
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);

КонецФункции

&НаКлиенте
Функция РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(СертификатыИПараметрыОбмена)
	
		Результат = Новый Структура("РезультатВыгрузки, 
									|РезультатПодписи, 
									|СертификатыИПараметрыОбмена", 
							Неопределено,
							Неопределено,
							СертификатыИПараметрыОбмена);	
		Возврат Результат;
		
КонецФункции

&НаКлиенте
Функция ВыгрузитьОтчетДляОтправкиВМОРФ(
	ОтчетСсылка,
	Форма
	) Экспорт
	
	ДанныеВыгрузки = "";
	РезультатВыгрузки = Форма.УниверсальнаяВыгрузка(ДанныеВыгрузки);
	Если НЕ РезультатВыгрузки Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	ДанныеВыгрузки = ДанныеВыгрузки[0];
	
	Если ДанныеВыгрузки.ТипФайлаВыгрузки <> "ИсполнениеКонтрактовГОЗ" Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	Результат = Новый Структура();
	Результат.Вставить("АдресФайлаВыгрузки", 	ДанныеВыгрузки.АдресФайлаВыгрузки);
	Результат.Вставить("ИмяФайлаВыгрузки", 	ДанныеВыгрузки.ИмяФайлаВыгрузки);
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура СертификатыИПараметрыОбменаОрганизацииДляМОРФ(
		ВыполняемоеОповещение,
		ОрганизацияСсылка,
		ПолучитьОсновныеСвойстваПоследнейОтправки,
		ОтправкаСсылка = Неопределено,
		ОтчетСсылка = Неопределено)
	
	РезультатВыполнения = Новый Структура();
	РезультатВыполнения.Вставить("ПараметрыФормированияПакета",        Неопределено);
	РезультатВыполнения.Вставить("Крипт",                              Неопределено);
	РезультатВыполнения.Вставить("НастроенОбменВУниверсальномФормате", Неопределено);
	РезультатВыполнения.Вставить("ПравоИзмененияУчетнойЗаписи",        Неопределено);
	РезультатВыполнения.Вставить("ЭтоРегламентированныйОтчет",         Неопределено);
	
	СвойстваОбмена = СвойстваОбменаОрганизацииСМОРФНаСервере(
		ОрганизацияСсылка,
		ОтчетСсылка);
		
	РезультатВыполнения.ПравоИзмененияУчетнойЗаписи        = СвойстваОбмена.ПравоИзмененияУчетнойЗаписи;
	РезультатВыполнения.ЭтоРегламентированныйОтчет         = СвойстваОбмена.ЭтоРегламентированныйОтчет;

	РезультатВыполнения.ПараметрыФормированияПакета = Новый Структура();
	РезультатВыполнения.ПараметрыФормированияПакета.Вставить("ИспользоватьОбмен",         Ложь);
	РезультатВыполнения.ПараметрыФормированияПакета.Вставить("СертификатАбонента",        Неопределено);
	
	Если СвойстваОбмена.НастройкиОбмена.ИспользоватьОбмен Тогда
		РезультатВыполнения.ПараметрыФормированияПакета.ИспользоватьОбмен = СвойстваОбмена.НастройкиОбмена.ИспользоватьОбмен;
	КонецЕсли;
		
	Если НЕ СвойстваОбмена.НастройкиОбмена.ИспользоватьОбмен Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
			
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("СвойстваОбмена",       СвойстваОбмена);
	ДополнительныеПараметры.Вставить("РезультатВыполнения",  РезультатВыполнения);
	
	Оповещение = Новый ОписаниеОповещения(
		"СертификатыИПараметрыОбменаОрганизацииДляМОРФПослеПолученияСвойствСертификатаАбонентаЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	МодульДокументооборотСМинобороныКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиент");
	МодульДокументооборотСМинобороныКлиент.НайтиСертификатПоОтпечатку(
		Оповещение,
		СвойстваОбмена.НастройкиОбмена.СертификатАбонентаОтпечаток
		);
	
КонецПроцедуры
 
&НаКлиенте
Процедура СертификатыИПараметрыОбменаОрганизацииДляМОРФПослеПолученияСвойствСертификатаАбонентаЗавершение(Результат, ДополнительныеПараметры) Экспорт
		
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	РезультатВыполнения = ДополнительныеПараметры.РезультатВыполнения;
	
	РезультатВыполнения.ПараметрыФормированияПакета.СертификатАбонента = ?(Результат.СертификатНайден, Результат.Сертификат, Неопределено);	
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
	
КонецПроцедуры

&НаКлиенте
Функция СертификатыГодятсяДляПодписанияОтчетностиМОРФ(Сертификаты)
	
	ТекДата = ТекущаяДатаНаСервере();
	ПризнакОшибки = Ложь;
	
	Для Каждого Сертификат Из Сертификаты Цикл
		
		СертификатКриптографии	= Сертификат.Значение;
		ПредставлениеСертификата	= Сертификат.Представление;
		Если СертификатКриптографии = Неопределено Тогда
			ПризнакОшибки = Истина;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					 НСтр("ru = '%1: сертификат не выбран в настройках сдачи отчетности в МО РФ.';
							|en = '%1: certificate is not selected in the settings of reporting submission to the Ministry of Defense of the Russian Federation.'"), ПредставлениеСертификата));
			Продолжить;
		КонецЕсли;
		
		Если ТекДата < СертификатКриптографии.ДатаНачала Тогда
			ПризнакОшибки = Истина;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1: период действия сертификата еще не наступил (%2).';
						|en = '%1: certificate is not within its validity period yet (%2).'"), 
						ПредставлениеСертификата, Строка(СертификатКриптографии.ДатаНачала)));
		КонецЕсли;
		
		Если ТекДата > СертификатКриптографии.ДатаОкончания Тогда
			ПризнакОшибки = Истина;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1: период действия сертификата истек (%2).';
						|en = '%1: validity period of certificate is expired (%2).'"), 
						ПредставлениеСертификата,
						Строка(СертификатКриптографии.ДатаОкончания)));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат (НЕ ПризнакОшибки);
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуНастройкиЭДОсМинобороны(Организация, ФормаВладелец = Неопределено, Окно = Неопределено) Экспорт 
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("РегламентированнаяОтчетность.ЭлектронныйДокументооборотСКонтролирующимиОрганами.СдачаОтчетностиВМинобороны") Тогда
		
		МодульДокументооборотСМинобороныКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиент");
		МодульДокументооборотСМинобороныКлиент.ОткрытьФормуНастройкиСМинобороны(Организация, ФормаВладелец, Окно);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СвойстваОбменаОрганизацииСМОРФНаСервере(Знач ОрганизацияСсылка, 
												ОтчетСсылка = Неопределено) Экспорт
												
	МодульМодульДокументооборотСМинобороны = ОбщегоНазначения.ОбщийМодуль("ДокументооборотСМинобороны");
	Возврат МодульМодульДокументооборотСМинобороны.СвойстваОбменаОрганизации(ОрганизацияСсылка, ОтчетСсылка);
	
КонецФункции

#КонецОбласти 

&НаКлиенте
Процедура ЗапроситьВыпискуОперацийПоРасчетуСБюджетом(ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ЗапроситьВыпискуОперацийПоРасчетуСБюджетом_ПослеОтправки", 
		ЭтотОбъект, 
		ВходящийКонтекст); 
	
	ЗапросИОН = СоздатьВыпискуОперацийПоРасчетуСБюджетом(
		ВходящийКонтекст.Организация, 
		ВходящийКонтекст.РегистрацияВНалоговомОргане, 
		ВходящийКонтекст.Год);
		
	ВходящийКонтекст.Вставить("ЗапросИОН", ЗапросИОН);
		
	ОтправкаЗапросаНаИнформационноеОбслуживание(ЗапросИОН, ВходящийКонтекст.Организация,  ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьВыпискуОперацийПоРасчетуСБюджетом_ПослеОтправки(Результат, ВходящийКонтекст) Экспорт
	
	ЗапросИОН = ВходящийКонтекст.ЗапросИОН;
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, ЗапросИОН);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьВыпискуОперацийПоРасчетуСБюджетом(Организация, РегистрацияВНалоговомОргане, Год)

	ЗапросИОН 						= Документы.ЗапросНаИнформационноеОбслуживаниеНалогоплательщика.СоздатьДокумент();
	ЗапросИОН.Дата 		 			= ТекущаяДатаСеанса();
	ЗапросИОН.Организация 			= Организация;
	ЗапросИОН.Получатель 			= РегистрацияВНалоговомОргане;
	ЗапросИОН.ДатаНачалаПериода 	= Дата(Год, 1, 1);
	ЗапросИОН.ДатаОкончанияПериода 	= НачалоДня(ТекущаяДатаСеанса());
	ЗапросИОН.ВидУслуги 			= Перечисления.ВидыУслугПриИОН.ПредставлениеВыпискиОперацийИзКарточкиРасчетыСБюджетом;
	ЗапросИОН.ФорматОтвета 			= Перечисления.ФорматОтветаНаЗапросИОН.XML;
	ЗапросИОН.ФорматЗапроса 		= Перечисления.ФорматыДокументооборотаСФНС.Приказ534;
	ЗапросИОН.КоличествоНалогов 	= Перечисления.КоличествоНалоговДляСверкиИОН.Все;
	
	ЗапросИОН.Записать();
	
	Возврат ЗапросИОН.Ссылка;

КонецФункции