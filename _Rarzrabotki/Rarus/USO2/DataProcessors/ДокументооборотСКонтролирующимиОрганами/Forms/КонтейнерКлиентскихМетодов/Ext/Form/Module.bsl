// Работа с криптографией

&НаСервереБезКонтекста
Функция ПолучитьДанныеСтрокой64(ДвДанные) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПолучитьДанныеСтрокой64(ДвДанные);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСтроку64ИзХранилища(ДанныеИзХранилища) Экспорт 
	
	Если ТипЗнч(ДанныеИзХранилища) = Тип("ХранилищеЗначения") Тогда 
		Возврат ПолучитьДанныеСтрокой64(ДанныеИзХранилища.Получить());
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьАдресСтрокой64(АдресДанных) Экспорт
	
	ДвДанные = ПолучитьИзВременногоХранилища(АдресДанных);
	Возврат ПолучитьДанныеСтрокой64(ДвДанные);
	
КонецФункции

&НаСервере
Функция ПолучитьЗакэшированныйФайлНастроек(
		УчетнаяЗапись,
		ПараметрыСоединения,
		ДатаОбновленияФайлаНаСервере,
		Расшифрован,
		Сообщения)
	
	Если ТипЗнч(УчетнаяЗапись) <> Тип("СправочникСсылка.УчетныеЗаписиДокументооборота") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                      |	ФайлыСведенийРОКИ.Данные,
	                      |	ФайлыСведенийРОКИ.Расшифрован,
	                      |	ФайлыСведенийРОКИ.ДатаФайла
	                      |ИЗ
	                      |	РегистрСведений.ФайлыСведенийРОКИ КАК ФайлыСведенийРОКИ
	                      |ГДЕ
	                      |	ФайлыСведенийРОКИ.УчетнаяЗапись = &УчетнаяЗапись
	                      |	И ФайлыСведенийРОКИ.ИмяРесурса = &ИмяРесурса");
	Если ЗначениеЗаполнено(ДатаОбновленияФайлаНаСервере) Тогда
		Запрос.Текст = Запрос.Текст + "
						  |	И ФайлыСведенийРОКИ.ДатаФайла = &ДатаФайла";
		Запрос.УстановитьПараметр("ДатаФайла", ДатаОбновленияФайлаНаСервере);
	Иначе
		Запрос.Текст = Запрос.Текст + "
						  |УПОРЯДОЧИТЬ ПО
						  |	ФайлыСведенийРОКИ.ДатаФайла УБЫВ";
	КонецЕсли;
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запрос.УстановитьПараметр("ИмяРесурса", ПараметрыСоединения.ИмяРесурсаСНастройками);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Данные = Выборка.Данные;
		Если ЗначениеЗаполнено(Данные) Тогда
			ДатаОбновленияФайлаНаСервере = Выборка.ДатаФайла;
			Расшифрован = Выборка.Расшифрован;
			ФайлНастроек = ПолучитьИмяВременногоФайла();
			Попытка
				Данные.Получить().Записать(ФайлНастроек);
				Возврат ФайлНастроек;
			Исключение
				ДобавитьСообщение(Сообщения, НСтр("ru = 'Ошибка разбора файла с информацией о настройках учетной записи:';
													|en = 'An error occurred while parsing a file with information about account settings:'") + Символы.ПС + ИнформацияОбОшибке().Описание);
				Соединение = Неопределено;
				Возврат Неопределено;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Работа с сервером

&НаСервере
Функция ПолучитьФайлССервера(Соединение, ИмяФайла, ИнформацияОбОшибке = Неопределено, ВызванаССервера = Ложь)
	
	ВремФайл = ПолучитьИмяВременногоФайла(РасширениеФайла(ИмяФайла));
	ВремФайл = СтрЗаменить(ВремФайл, "/", "\");
	
	Попытка
		Соединение.Получить(ИмяФайла, ВремФайл);
		Если ВызванаССервера Тогда 
			Возврат ВремФайл;
		Иначе
			Возврат ПрочитатьBase64ИзФайла(ВремФайл);
		КонецЕсли;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПолучитьДатуОбновленияФайлаНастроекНаСервере(Соединение, ПараметрыСоединения, Сообщения)
	
	// получаем ресурс dt
	ИнформацияОбОшибке = Неопределено;
	ИмяФайлаДТ = ПолучитьФайлССервера(Соединение, ПараметрыСоединения.ИмяРесурсаДТ, ИнформацияОбОшибке, Истина);
	Если ИмяФайлаДТ = Неопределено Тогда
		ДобавитьСообщение(Сообщения,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'На сервере ""Такском"" не найдена информация о настройках учетной записи (отсутствует файл %1)!%2';
																		|en = 'Information about account settings is not found on the Taxcom server (no file %1).%2'"),
			ПараметрыСоединения.ИмяРесурсаДТ,
			Символы.ПС + ИнформацияОбОшибке.Описание));
		Соединение = Неопределено;
		Возврат Неопределено;
	КонецЕсли;
	
	// получаем значение даты из файла dt
	ЗначениеИзФайлаДТ = ПолучитьДатуИзФайлаДТ(ИмяФайлаДТ);
	УдалитьФайлы(ИмяФайлаДТ);
	Если ЗначениеИзФайлаДТ = Неопределено Тогда
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Некорректный файл с информацией о дате обновления настроек на сервере ""Такском""!';
											|en = 'Incorrect file with information about date of setting update on the Taxcom server.'"));
		Соединение = Неопределено;
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ЗначениеИзФайлаДТ;
	
КонецФункции

&НаСервере
Функция ПолучитьДатуИзФайлаДТ(ФайлДТ)
	
	Попытка
		ЧтениеТекста = Новый ЧтениеТекста(ФайлДТ, "windows-1251");
		СтрокаДТ = СокрЛП(ЧтениеТекста.ПрочитатьСтроку());
		ЧтениеТекста.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	ВхождениеПробела = СтрНайти(СтрокаДТ, " ");
	Если ВхождениеПробела = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаДТ = СокрЛП(Лев(СтрокаДТ, ВхождениеПробела - 1));
	ВремяДТ = СокрЛП(Сред(СтрокаДТ, ВхождениеПробела + 1));
	
	ВхождениеДефиса = СтрНайти(ДатаДТ, "-");
	Если ВхождениеДефиса = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ГодДТ = СокрЛП(Лев(ДатаДТ, ВхождениеДефиса - 1));
	ДатаДТ = Сред(ДатаДТ, ВхождениеДефиса + 1);
	ВхождениеДефиса = СтрНайти(ДатаДТ, "-");
	Если ВхождениеДефиса = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	МесяцДТ = СокрЛП(Лев(ДатаДТ, ВхождениеДефиса - 1));
	ДеньМесяцаДТ = СокрЛП(Сред(ДатаДТ, ВхождениеДефиса + 1));
	
	ВхождениеДвоеточия = СтрНайти(ВремяДТ, ":");
	Если ВхождениеДвоеточия = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЧасДТ = СокрЛП(Лев(ВремяДТ, ВхождениеДвоеточия - 1));
	МинутаДТ = сокрЛП(Сред(ВремяДТ, ВхождениеДвоеточия + 1));
	
	Если ПустаяСтрока(ГодДТ)
	ИЛИ ПустаяСтрока(МесяцДТ)
	ИЛИ ПустаяСтрока(ДеньМесяцаДТ)
	ИЛИ ПустаяСтрока(ЧасДТ)
	ИЛИ ПустаяСтрока(МинутаДТ)
	ИЛИ НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ГодДТ)
	ИЛИ НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(МесяцДТ)
	ИЛИ НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ДеньМесяцаДТ)
	ИЛИ НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ЧасДТ)
	ИЛИ НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(МинутаДТ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат Дата(Число(ГодДТ), Число(МесяцДТ), Число(ДеньМесяцаДТ), Число(ЧасДТ), Число(МинутаДТ), 0);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

