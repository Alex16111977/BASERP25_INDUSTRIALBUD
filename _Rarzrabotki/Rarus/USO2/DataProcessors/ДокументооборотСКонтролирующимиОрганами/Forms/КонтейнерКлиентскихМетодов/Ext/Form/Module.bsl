Функция НаименованиеНОПОКоду(КодНО)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
		|	РегистрацииВНалоговомОргане.Наименование КАК Наименование
		|ИЗ
		|	Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
		|ГДЕ
		|	РегистрацииВНалоговомОргане.Код = &Код";

	Запрос.УстановитьПараметр("Код", КодНО);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Наименование = "";
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Наименование = ВыборкаДетальныеЗаписи.Наименование;
	КонецЦикла;
		
	Если Наименование = "" Тогда
		Наименование = НСтр("ru = 'ИФНС ';
							|en = 'IFTS'") + Строка(КодНО);
	КонецЕсли;

	Возврат Наименование;
	
КонецФункции

