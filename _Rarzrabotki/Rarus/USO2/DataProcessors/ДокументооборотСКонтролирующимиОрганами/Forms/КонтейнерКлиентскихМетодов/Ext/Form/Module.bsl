&НаСервере
Функция СформироватьТабличныйДокументПодтверждениеПолученияФСГС(Тело, ЦиклОбмена)
	
	СвойстваИзПодтверждения = ПолучитьОсновныеСвойстваИзПодтвержденияПолученияФСГС(Тело);
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	Если ЗначениеЗаполнено(СвойстваИзПодтверждения) Тогда
		
		Макет = ПолучитьМакетОбработки("ПодтвержденияПолученияФСГС");
		
		ОбластьМакета = Макет.ПолучитьОбласть("ФСГСПодтверждение");
		ОбластьМакета.Параметры.Заполнить(СвойстваИзПодтверждения);
		
		ТабДокумент.Вывести(ОбластьМакета);
		
		СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, ТаблицаПодписей);
		
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОсновныеСвойстваИзПодтвержденияПолученияФСГС(Тело)
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	
	// загружаем XML из строки в дерево
	ДеревоXML = КонтекстЭДОСервер.ЗагрузитьСтрокуXMLВДеревоЗначений(Тело);
	Если ДеревоXML = Неопределено Тогда
		Отказ = Истина;
		Возврат Неопределено;
	КонецЕсли;
	
	УзелИзвещение = ДеревоXML.Строки.Найти("извещение", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелИзвещение) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML извещения: не обнаружен узел ""Извещение"".';
								|en = 'Incorrect structure of XML notification: the ""Notification"" node is not found.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Отказ = Истина;
		Возврат  Неопределено;
	КонецЕсли;
	
	УзелОтправитель = УзелИзвещение.Строки.Найти("отправитель", "Имя", Истина);
	Если ЗначениеЗаполнено(УзелОтправитель) Тогда
		ИдентификаторОтправителя = ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелОтправитель, "идентификатор");
		НатуральныйИдентификаторОтправителя  = ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелОтправитель, "натуральныйИдентификатор");
		ТипОтправителя = ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелОтправитель, "тип");
		НазваниеОтправителя = ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелОтправитель, "название");
	Иначе
		ИдентификаторОтправителя = "";
		НатуральныйИдентификаторОтправителя  = "";
		ТипОтправителя = "";
		НазваниеОтправителя = "";
	КонецЕсли;
	
	УзелПолучатель = УзелИзвещение.Строки.Найти("получатель", "Имя", Истина);
	Если ЗначениеЗаполнено(УзелПолучатель) Тогда
		ИдентификаторПолучатель = ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелПолучатель, "идентификатор");
		НатуральныйИдентификаторПолучатель  = ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелПолучатель, "натуральныйИдентификатор");
		ТипПолучатель = ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелПолучатель, "тип");
		НазваниеПолучатель = ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелПолучатель, "название");
	Иначе
		ИдентификаторПолучатель = "";
		НатуральныйИдентификаторПолучатель  = "";
		ТипПолучатель = "";
		НазваниеПолучатель = "";
	КонецЕсли;	

	УзелДокументы = УзелИзвещение.Строки.Найти("документы", "Имя", Истина);
	Если НЕ ЗначениеЗаполнено(УзелДокументы) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML извещения: не обнаружен узел ""Документы"".';
								|en = 'Incorrect structure of XML notification: the ""Documents"" node is not found.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Отказ = Истина;
		Возврат Неопределено;
	КонецЕсли;
	
	// получаем идентификаторы поступивших файлов
	ИдентификаторыДокументов = "";
	Для каждого УзелДокумент Из УзелДокументы.Строки Цикл
		ИдентификаторДокумента = УзелДокумент.Строки.Найти("идентификаторДокумента", "Имя");
		Если ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
			ИдентификаторыДокументов = ИдентификаторыДокументов + ?(ПустаяСтрока(ИдентификаторыДокументов), "", ",") + СокрЛП(ИдентификаторДокумента.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИдентификаторыДокументов", 	ИдентификаторыДокументов);
	ДополнительныеПараметры.Вставить("ИдентификаторОтправителя", 	ИдентификаторОтправителя);
	ДополнительныеПараметры.Вставить("НатуральныйИдентификаторОтправителя", НатуральныйИдентификаторОтправителя);
	ДополнительныеПараметры.Вставить("ТипОтправителя", 				ТипОтправителя);
	ДополнительныеПараметры.Вставить("НазваниеОтправителя", 		НазваниеОтправителя);
	ДополнительныеПараметры.Вставить("ИдентификаторПолучатель", 	ИдентификаторПолучатель);
	ДополнительныеПараметры.Вставить("НатуральныйИдентификаторПолучатель", НатуральныйИдентификаторПолучатель);
	ДополнительныеПараметры.Вставить("ТипПолучатель", 				ТипПолучатель);
	ДополнительныеПараметры.Вставить("НазваниеПолучатель", 			НазваниеПолучатель);

	Возврат ДополнительныеПараметры;

КонецФункции

&НаСервереБезКонтекста
Функция ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелРодитель, ИмяДочернегоУзла)
	
	Строка = УзелРодитель.Строки.Найти(ИмяДочернегоУзла, "Имя");
	Если Строка = Неопределено Тогда
		Результат = "";
	Иначе
		Результат = Строка.Значение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПечатьВозможнаДляЦиклаОбмена(Тип) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПечатьВозможнаДляЦиклаОбмена(Тип); 
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСведенияУзла(УзелРодитель, ИмяУзла, ОбщиеСведения)
	
	УзелСвОтметка = УзелРодитель.Строки.Найти(ИмяУзла, "Имя", Истина);
	Если НЕ ЗначениеЗаполнено(УзелСвОтметка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// разбираем узел с общими сведениями
	ДополнительныеПараметры = Новый Структура();
	  
	Для Каждого УзелОбщСвед Из УзелСвОтметка.Строки Цикл
		ДополнительныеПараметры.Вставить(УзелОбщСвед.Имя, СокрЛП(УзелОбщСвед.Значение));
	КонецЦикла;
	
	ОбщиеСведения.Вставить(ИмяУзла, ДополнительныеПараметры);
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификат(ДополнительныеПараметры)
	
	Если ПустаяСтрока(ДополнительныеПараметры.ПутьКонтейнерЗакрытогоКлюча) Тогда
		
		Если НЕ ДополнительныеПараметры.ВызовИзМастераПодключенияК1СОтчетности Тогда 
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ЗаявлениеСформироватьЗакрытыйКлючПослеИнструкцииЗавершение", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
				
			ПоказатьИнструкциюСозданияКонтейнера(ДополнительныеПараметры.ДокументЗаявление, ОписаниеОповещения);
			
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПродолжение(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПродолжение(ДополнительныеПараметры)
	
	АлгоритмКонтейнераКлючей = ЗаявлениеОпределитьАлгоритмДляСозданияКонтейнераКлючей(ДополнительныеПараметры.ДокументЗаявление);
	Если АлгоритмКонтейнераКлючей = Неопределено Тогда
		ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера_ОшибкаСозданияКлюча(ДополнительныеПараметры,
			НСтр("ru = 'Не удалось получить алгоритм генерации ключа.';
				|en = 'Cannot receive a key generation algorithm.'"));
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("АлгоритмКонтейнераКлючей", АлгоритмКонтейнераКлючей);
	ДополнительныеПараметры.Вставить("НапомнитьОбновитьКриптопровайдер",
		АлгоритмКонтейнераКлючей = "GOST R 34.10-2012-256" ИЛИ АлгоритмКонтейнераКлючей = "GOST R 34.10-2012-512");
	
	Оповещение = Новый ОписаниеОповещения(
		"ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеПолученияКриптопровайдеров", ЭтотОбъект, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.НапомнитьОбновитьКриптопровайдер Тогда
		ДополнительныеПараметры.Вставить("НапомнитьОбновитьКриптопровайдер", Истина);
		
		КриптографияЭДКОКлиент.ПолучитьКриптопровайдеры(Оповещение, Ложь, Ложь);
		
	Иначе
		РезультатВыполнения = Новый Структура("Выполнено", Ложь);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеПолученияКриптопровайдеров(Результат, ДополнительныеПараметры) Экспорт
	
	Оповещение = Новый ОписаниеОповещения(
		"ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеПредупрежденияОбОбновленииКриптопровайдера",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если Результат.Выполнено И ДополнительныеПараметры.НапомнитьОбновитьКриптопровайдер Тогда
		ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", 	Оповещение);
		ДополнительныеПараметры.Вставить("Криптопровайдеры", 		Результат.Криптопровайдеры);
		ПоказатьПредупреждениеОбОбновленииКриптопровайдераПриНеобходимости(ДополнительныеПараметры);
		
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеПредупрежденияОбОбновленииКриптопровайдера(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат Тогда
		ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера_ОшибкаСозданияКлюча(ДополнительныеПараметры);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ВыводитьИнформациюОбОшибках", НЕ ДополнительныеПараметры.ВызовИзМастераПодключенияК1СОтчетности);
	ДополнительныеПараметры.Вставить("УникальноеИмяКонтейнера", 	ДополнительныеПараметры.ПутьКонтейнерЗакрытогоКлюча);
	ДополнительныеПараметры.Вставить("МенеджерКриптографииДляЗапросаНаСертификат", 	Неопределено);
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры.ПутьКонтейнерЗакрытогоКлюча) Тогда
		
		Результат = Новый Структура();
		Результат.Вставить("Выполнено", 				Истина);
		Результат.Вставить("Алгоритм", 					ДополнительныеПараметры.АлгоритмКонтейнераКлючей);
		Результат.Вставить("УникальноеИмяКонтейнера", 	ДополнительныеПараметры.ПутьКонтейнерЗакрытогоКлюча);
		
		ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера(Результат, ДополнительныеПараметры);
		
	Иначе
		
		ПутьКонтейнерЗакрытогоКлюча = КриптографияЭДКОКлиент.СгенерироватьИмяКонтейнера(ДополнительныеПараметры.ДокументЗаявление.КраткоеНаименование);
		
		Оповещение = Новый ОписаниеОповещения(
			"ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияМенеджера", 
			ЭтотОбъект, 
			ДополнительныеПараметры,
			"ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера_ОбработчикОшибки", 
			ЭтотОбъект);
		
		ЭтоLinux = ОбщегоНазначенияКлиентСервер.ЭтоLinuxКлиент();
		ПутьМодуляКриптографии = ?(ЭтоLinux,
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ПутьМодуляКриптографии(), "");
		ПоддерживаемыеКриптопровайдеры = КриптографияЭДКОКлиентСервер.ПоддерживаемыеКриптопровайдеры(
			ДополнительныеПараметры.АлгоритмКонтейнераКлючей,
			ЭтоLinux,
			ДополнительныеПараметры.ДокументЗаявление.ТипКриптопровайдера,
			ПутьМодуляКриптографии);
		ПараметрыМодуляКриптографии = ?(ПоддерживаемыеКриптопровайдеры.Количество() >= 1,
			ПоддерживаемыеКриптопровайдеры[0], Неопределено);
		
		КриптографияЭДКОКлиент.СоздатьМенеджерКриптографии(Оповещение, Ложь, ПараметрыМодуляКриптографии, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияМенеджера(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		
		ВходящийКонтекст.АлгоритмКонтейнераКлючей = Результат.Алгоритм;
		
		ПутьКонтейнерЗакрытогоКлюча = КриптографияЭДКОКлиент.СгенерироватьИмяКонтейнера(ВходящийКонтекст.ДокументЗаявление.КраткоеНаименование);
		ВходящийКонтекст.Вставить("МенеджерКриптографииДляЗапросаНаСертификат", Результат.МенеджерКриптографии);
		
		Если ВходящийКонтекст.ДокументЗаявление.ВключитьЛицензиюКриптоПро Тогда
			
			Оповещение = Новый ОписаниеОповещения("ЗаявлениеСоздатьКонтейнерИЗапросНаСертификатПослеЗавершения", ЭтотОбъект, ВходящийКонтекст);
			СтрокаПередачиДанных = ЗаявлениеСформироватьЗапросНаСертификатКвалифицированный(ВходящийКонтекст);
			
			КриптографияЭДКОКлиент.СоздатьКонтейнерИЗапросНаСертификат(
				Оповещение, 
				СтрокаПередачиДанных,
				ПутьКонтейнерЗакрытогоКлюча,
				ВходящийКонтекст.ВыводитьСообщения,
				Результат.МенеджерКриптографии,
				ВходящийКонтекст.АлгоритмКонтейнераКлючей);
				
		Иначе
				
			ВходящийКонтекст.Вставить("МенеджерКриптографииДляЗапросаНаСертификат",  Результат.МенеджерКриптографии);
			
			Оповещение = Новый ОписаниеОповещения(
				"ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера", 
				ЭтотОбъект, 
				ВходящийКонтекст,
				"ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера_ОбработчикОшибки", 
				ЭтотОбъект);
				
			КриптографияЭДКОКлиент.СоздатьКонтейнерКлючей(
				Оповещение, 
				ПутьКонтейнерЗакрытогоКлюча,
				НЕ ВходящийКонтекст.ВызовИзМастераПодключенияК1СОтчетности,
				Результат.МенеджерКриптографии,
				ВходящийКонтекст.АлгоритмКонтейнераКлючей);
		КонецЕсли;
			
	Иначе
		ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера_ОшибкаСозданияКлюча(ВходящийКонтекст);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСоздатьКонтейнерИЗапросНаСертификатПослеЗавершения(Результат, ВходящийКонтекст) Экспорт
	
	СтруктураРезультата = Новый Структура();
	СтруктураРезультата.Вставить("ПродолжитьОтправкуЗаявления", Результат.Выполнено);
	СтруктураРезультата.Вставить("ТекстОшибки",                 ВходящийКонтекст.ТекстОшибокДляМастераПодключенияК1СОтчетности);
	
	Если Результат.Выполнено Тогда
		
		СтруктураРезультата.Вставить("ТекстЗапросаНаСертификат", 	Результат.ЗапросНаСертификат);
		СтруктураРезультата.Вставить("ПутьКонтейнерЗакрытогоКлюча", Результат.УникальноеИмяКонтейнера);
		СтруктураРезультата.Вставить("АлгоритмКонтейнераКлючей", 	Результат.Алгоритм);
		
	Иначе
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
			НСтр("ru = 'Криптографическая ошибка: не удалось сформировать контейнер и запрос на сертификат для контролирующих органов.';
				|en = 'Cryptographic error: cannot generate container and request for certificate for regulatory authorities.'"), 
			ВходящийКонтекст.ВызовИзМастераПодключенияК1СОтчетности, 
			ВходящийКонтекст.ТекстОшибокДляМастераПодключенияК1СОтчетности);
			
		СтруктураРезультата.Вставить("ТекстЗапросаНаСертификат", "");
		СтруктураРезультата.Вставить("ТекстОшибки", Результат.ОписаниеОшибки);
				
	КонецЕсли;
		
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, СтруктураРезультата);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера_ОбработчикОшибки(ИнформацияОбОшибке, СтандартнаяОбработка, ВходящийКонтекст) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера_ОшибкаСозданияКлюча(ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера_ОшибкаСозданияКлюча(
		ВходящийКонтекст,
		ТекстОшибкиПриСозданииКлюча = Неопределено) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ТекстОшибки = ?(ТекстОшибкиПриСозданииКлюча = Неопределено,
		НСтр("ru = 'Криптографическая ошибка: не удалось создать контейнер закрытого ключа.';
			|en = 'Cryptographic error: cannot create a private key container.  '"), ТекстОшибкиПриСозданииКлюча);
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
		ТекстОшибки, 
		ВходящийКонтекст.ВызовИзМастераПодключенияК1СОтчетности, 
		ВходящийКонтекст.ТекстОшибокДляМастераПодключенияК1СОтчетности);
		
	Оповестить(НСтр("ru = 'Упрощенное заявление. Ошибка создание закрытого ключа';
					|en = 'Simplified application. Private key creation error'"), ТекстОшибки, ВходящийКонтекст.ДокументЗаявление);
		
	СтруктураРезультата = Новый Структура("ПродолжитьОтправкуЗаявления, ТекстОшибки, ПутьКонтейнерЗакрытогоКлюча", 
											Ложь, ВходящийКонтекст.ТекстОшибокДляМастераПодключенияК1СОтчетности, "");
											
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, СтруктураРезультата);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		
		АлгоритмКонтейнераКлючей = Результат.Алгоритм;
		
		ВходящийКонтекст.УникальноеИмяКонтейнера = Результат.УникальноеИмяКонтейнера;
		ВходящийКонтекст.АлгоритмКонтейнераКлючей = АлгоритмКонтейнераКлючей;
		
		ДлительнаяОтправкаКлиент.ЗапомнитьКонтекстДлительнойОперации(
			ВходящийКонтекст, 
			"БРО.КонтекстОтправкиЗаявления");
			
		Оповестить(НСтр("ru = 'Упрощенное заявление. Успешное создание закрытого ключа';
						|en = 'Simplified application. Successful creation of a private key'"), ,ВходящийКонтекст.ДокументЗаявление);
		
		// Чтобы в форме отправки крутился бублик
		ПодключитьОбработчикОжидания("Подключаемый_ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера", 0.1, Истина);
		
	Иначе
		
		ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера_ОшибкаСозданияКлюча(ВходящийКонтекст);
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера()
	
	ВходящийКонтекст     = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации("БРО.КонтекстОтправкиЗаявления");
	СтрокаПередачиДанных = ЗаявлениеСформироватьЗапросНаСертификатКвалифицированный(ВходящийКонтекст);
	
	Оповещение = Новый ОписаниеОповещения("ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияЗапросаНаСертификат", ЭтотОбъект, ВходящийКонтекст);
	
	КриптографияЭДКОКлиент.СоздатьЗапросНаСертификат(
		Оповещение, 
		СтрокаПередачиДанных,
		ВходящийКонтекст.УникальноеИмяКонтейнера,
		ВходящийКонтекст.ВыводитьСообщения,
		ВходящийКонтекст.МенеджерКриптографииДляЗапросаНаСертификат,
		ВходящийКонтекст.АлгоритмКонтейнераКлючей);
		
	ВходящийКонтекст.Удалить("МенеджерКриптографииДляЗапросаНаСертификат");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияЗапросаНаСертификат(Результат, ВходящийКонтекст) Экспорт
	
	СтруктураРезультата = Новый Структура();
	СтруктураРезультата.Вставить("ПродолжитьОтправкуЗаявления", Результат.Выполнено);
	СтруктураРезультата.Вставить("ТекстОшибки",                 ВходящийКонтекст.ТекстОшибокДляМастераПодключенияК1СОтчетности);
	СтруктураРезультата.Вставить("ПутьКонтейнерЗакрытогоКлюча", ВходящийКонтекст.УникальноеИмяКонтейнера);
	
	Если Результат.Выполнено Тогда
		
		СтруктураРезультата.Вставить("ТекстЗапросаНаСертификат", Результат.ЗапросНаСертификат);
		СтруктураРезультата.Вставить("АлгоритмКонтейнераКлючей", ВходящийКонтекст.АлгоритмКонтейнераКлючей);
		
	Иначе
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
			НСтр("ru = 'Криптографическая ошибка: не удалось сформировать запрос на сертификат для контролирующих органов.';
				|en = 'Cryptographic error: cannot generate a request for certificate for regulatory authorities.'"), 
			ВходящийКонтекст.ВызовИзМастераПодключенияК1СОтчетности, 
			ВходящийКонтекст.ТекстОшибокДляМастераПодключенияК1СОтчетности);
			
		СтруктураРезультата.Вставить("ТекстЗапросаНаСертификат", "");
		СтруктураРезультата.Вставить("ТекстОшибки", Результат.ОписаниеОшибки);
				
	КонецЕсли;
		
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, СтруктураРезультата);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючПослеИнструкцииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат Тогда
		
		ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПродолжение(ДополнительныеПараметры);
			
	Иначе
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
			НСтр("ru = 'Пользователь отказался от продолжения.';
				|en = 'The user refused to continue.'"), 
			ДополнительныеПараметры.ВызовИзМастераПодключенияК1СОтчетности, 
			ДополнительныеПараметры.ТекстОшибокДляМастераПодключенияК1СОтчетности);
		
		СтруктураРезультата = Новый Структура(
			"ПродолжитьОтправкуЗаявления, ТекстОшибки, ПутьКонтейнерЗакрытогоКлюча", 
			Ложь, ДополнительныеПараметры.ТекстОшибокДляМастераПодключенияК1СОтчетности, ДополнительныеПараметры.ПутьКонтейнерЗакрытогоКлюча);
			
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, СтруктураРезультата);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкциюСозданияКонтейнера(ДокументЗаявление, ВыполняемоеОповещение)
	
	Если ДокументЗаявление.ТипКриптопровайдера <> ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.VipNet") 
		И ДокументЗаявление.ТипКриптопровайдера <> ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.CryptoPro") Тогда
	
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
		
		Возврат;
	КонецЕсли;
	
	Если ДокументЗаявление.ТипКриптопровайдера = ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.VipNet") Тогда
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("МакетИнструкцииДляПоказа","ИнструкцияVipNetCSPСозданиеКонтейнера");
		ПараметрыФормы.Вставить("Заголовок", "Инструкция по созданию контейнера закрытого ключа для криптопровайдера ViPNet CSP");
		
	Иначе
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("МакетИнструкцииДляПоказа","ИнструкцияКриптоПроСозданиеКонтейнера");
		ПараметрыФормы.Вставить("Заголовок", "Инструкция по созданию контейнера закрытого ключа для криптопровайдера КриптоПро CSP");
		
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПоказатьИнструкциюСозданияКонтейнераЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	ОткрытьФорму(
		ПутьКОбъекту + ".Форма.ФормаОтображенияИнструкцииHTML",
		ПараметрыФормы, 
		, 
		, 
		, 
		, 
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкциюСозданияКонтейнераЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Ложь);
	Иначе
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеЗашифровать(ДополнительныеПараметры)
	
	ДокументЗаявление = ДополнительныеПараметры.ДокументЗаявление;	
	
	// Проверяем, устрановлени ли сертификат оператора электронного документооборота в хранилище сертификатов
	ХранилищеСертификата 	= "AddressBook";
	Отпечаток 				= ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьПараметрСпецоператора(ДокументЗаявление.СпецоператорСвязи, "СертификатБезопасности_Отпечаток");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаявлениеЗашифроватьПослеПроверкиРегистрацииСертификата", ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(ОписаниеОповещения, Отпечаток, ХранилищеСертификата);
	
КонецПроцедуры

&НаСервере
Процедура НачатьОтправкуОблачногоЗаявленияВБазуЗаявок(ДокументЗаявление, АлгоритмКонтейнераКлючей)

	АдресЗаданияПоОтправкеОблачногоЗаявления = ПоместитьВоВременноеХранилище("", Новый УникальныйИдентификатор);
	
	ДополнительныеПараметры = Новый Массив();
	ДополнительныеПараметры.Добавить(АдресЗаданияПоОтправкеОблачногоЗаявления);
	ДополнительныеПараметры.Добавить(ДокументЗаявление);
	ДополнительныеПараметры.Добавить(АлгоритмКонтейнераКлючей);
	
	ФоновыеЗадания.Выполнить("ЭлектронныйДокументооборотСКонтролирующимиОрганами.НачатьОтправкуОблачногоЗаявленияВБазуЗаявок", ДополнительныеПараметры);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПроверитьСостояниеОтправкиОблачногоЗаявленияВБазуЗаявок()
	
	Если ЭтоАдресВременногоХранилища(АдресЗаданияПоОтправкеОблачногоЗаявления) Тогда
		
		Результат = ПолучитьИзВременногоХранилища(АдресЗаданияПоОтправкеОблачногоЗаявления);
		
		Если ЗначениеЗаполнено(Результат) Тогда
			
			ОтключитьОбработчикОжидания("Подключаемый_ПроверитьСостояниеОтправкиОблачногоЗаявленияВБазуЗаявок");
			
			Если Результат.Выполнено Тогда
				
				ДанныеЗаявления = Результат.ДанныеЗаявления;
				
				// Копирование новых свойств в открытую форму заявления.
				ОбработкаЗаявленийАбонентаВызовСервера.ОбновитьРеквизитыЗаявления(ОтправляемоеЗаявление, ДанныеЗаявления);
				
				Если ДанныеЗаявления.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено") Тогда
					ОбработкаЗаявленийАбонентаКлиент.ВключитьАвтоматическуюПроверкуСтатуса(ОтправляемоеЗаявление);
					ТекстОшибки = "";
				Иначе
					ТекстОшибки = НСтр("ru = 'При обработке заявления на сервере возникла ошибка. Сервис временно недоступен.';
										|en = 'An error occurred while processing the application on the server. Service is temporarily unavailable.'");
				КонецЕсли;
				
				Результат = Новый Структура("ТекстОшибки", ТекстОшибки);
				ВыполнитьОбработкуОповещения(ОписаниеОповещенияПослеОтправкиЗаявления, Результат);
				
			Иначе
				
				ВыполнитьОбработкуОповещения(ОписаниеОповещенияПослеОтправкиЗаявления, Результат); // Результат содержит текст ошибки
				
			КонецЕсли;
			
		Иначе
			
			ПодключитьОбработчикОжидания("Подключаемый_ПроверитьСостояниеОтправкиОблачногоЗаявленияВБазуЗаявок", 1, Истина);
			
		КонецЕсли;
		
	Иначе
		
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьСостояниеОтправкиОблачногоЗаявленияВБазуЗаявок", 1, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКодВидаДокументаФизическогоЛица(Знач ДокументФизическогоЛица) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПолучитьКодВидаДокументаФизическогоЛица(ДокументФизическогоЛица);
	
КонецФункции 

&НаСервере
Процедура ДописатьВЗаявлениеСведенияОВладельцеЭП(
		ДокументЗаявление,
		ЗаписьXML,
		ТекстЗапросаНаСертификат = Неопределено,
		ЭтоПервичноеЗаявление = Истина, 
		ТребуетсяПереизданиеСертификата = Ложь,
		АлгоритмКонтейнераКлючей = Неопределено)
		
	ЭтоЮридическоеЛицо = ДокументЗаявление.ТипОрганизации;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ВладельцыЭЦП");
	ЗаписьXML.ЗаписатьНачалоЭлемента("ВладелецЭЦП");
	
	Если НЕ ЭтоЗаявлениеТолькоНаПереход(ДокументЗаявление) Тогда
		ЗаписьXML.ЗаписатьАтрибут("СНИЛС", ДокументЗаявление.ВладелецЭЦПСНИЛС);
		
		ЗаписатьФИОВладельцаЭП(ДокументЗаявление, ЗаписьXML);
		ЗаписатьПол(ДокументЗаявление, ЗаписьXML);
		ЗаписатьГражданство(ДокументЗаявление, ЗаписьXML);
		ЗаписатьУдЛичнВладельцаЭП(ДокументЗаявление, ЗаписьXML);
		
		Если ЭтоЮридическоеЛицо Тогда
			ЗаписатьУзелXML(ЗаписьXML,"Должность",ДокументЗаявление.ВладелецЭЦПДолжность);
		КонецЕсли;
			
		ЗаписатьУзелXML(ЗаписьXML,"Подразделение",ДокументЗаявление.ВладелецЭЦППодразделение, Истина);
	КонецЕсли;
	
	ЗаписатьКриптопровайдер(ДокументЗаявление, ЗаписьXML, АлгоритмКонтейнераКлючей);
	
	ЗаписатьЗапросНаСертификат(
		ДокументЗаявление,
		ЗаписьXML,
		ЭтоПервичноеЗаявление, 
		ТребуетсяПереизданиеСертификата,
		ТекстЗапросаНаСертификат);
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьФИОВладельцаЭП(ДокументЗаявление, ЗаписьXML)
		
	ЗаписьXML.ЗаписатьНачалоЭлемента("ФИО");
	ЗаписьXML.ЗаписатьАтрибут("Фамилия", ДокументЗаявление.ВладелецЭЦПФамилия);
	ЗаписьXML.ЗаписатьАтрибут("Имя", ДокументЗаявление.ВладелецЭЦПИмя);
	
	Если Не ПустаяСтрока(ДокументЗаявление.ВладелецЭЦПОтчество)Тогда
		ЗаписьXML.ЗаписатьАтрибут("Отчество", ДокументЗаявление.ВладелецЭЦПОтчество);
	КонецЕсли;
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьУдЛичнВладельцаЭП(ДокументЗаявление, ЗаписьXML)
		
	ЗаписьXML.ЗаписатьНачалоЭлемента("УдЛичн");
	
	КодВидДок = ПолучитьКодВидаДокументаФизическогоЛица(ДокументЗаявление.ВладелецЭЦПВидДокумента);
	ЗаписьXML.ЗаписатьАтрибут("КодВидДок", КодВидДок);
	
	СерНомДок = СокрЛП(Строка(ДокументЗаявление.ВладелецЭЦПСерияДокумента) + " "
		+ Строка(ДокументЗаявление.ВладелецЭЦПНомерДокумента));
	ЗаписьXML.ЗаписатьАтрибут("СерНомДок", СерНомДок);
	
	ДатаВыдачиДокумента = Формат(ДокументЗаявление.ВладелецЭЦПДатаВыдачиДокумента, "ДФ=dd.MM.yyyy");
	ЗаписьXML.ЗаписатьАтрибут("ДатаДок",   XMLСтрока(ДатаВыдачиДокумента));
	
	ЗаписьXML.ЗаписатьАтрибут("ВыдДок",    ДокументЗаявление.ВладелецЭЦПКемВыданДокумент);
	
	// Код подразделения заполняется только для Паспорта РФ.
	Если ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЭтоПаспортРФ(ДокументЗаявление.ВладелецЭЦПВидДокумента) Тогда
		ЗаписьXML.ЗаписатьАтрибут("КодВыдДок", ДокументЗаявление.ВладелецЭЦПКодПодразделения);
	КонецЕсли;
	
	ДатаРождения = Формат(ДокументЗаявление.ВладелецЭЦПДатаРождения, "ДФ=dd.MM.yyyy");
	ЗаписьXML.ЗаписатьАтрибут("ДатаРожд", XMLСтрока(ДатаРождения));
	
	ЗаписьXML.ЗаписатьАтрибут("МестоРожд", ДокументЗаявление.ВладелецЭЦПМестоРождения);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьКриптопровайдер(ДокументЗаявление, ЗаписьXML, АлгоритмКонтейнераКлючей = Неопределено)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Криптопровайдер");
	КриптоПровайдер = КриптографияЭДКОКлиентСервер.СвойстваКриптопровайдераПоУмолчанию(ДокументЗаявление.ТипКриптопровайдера,
		АлгоритмКонтейнераКлючей);
	ЗаписатьУзелXML(ЗаписьXML,"ТипКриптопровайдера", КриптоПровайдер.Тип);
	ЗаписатьУзелXML(ЗаписьXML,"ИмяКриптопровайдера", КриптоПровайдер.Имя);
	ЗаписьXML.ЗаписатьКонецЭлемента();
		
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЗапросНаСертификат(
		ДокументЗаявление,
		ЗаписьXML,
		ЭтоПервичноеЗаявление, 
		ТребуетсяПереизданиеСертификата,
		ТекстЗапросаНаСертификат)
	
	// Если требуется переиздание сертификата, включаем узел ЗапросНаСертификат
	Если ЭтоПервичноеЗаявление
		ИЛИ НЕ ЭтоПервичноеЗаявление И ТребуетсяПереизданиеСертификата Тогда
		
		УдостоверяющийЦентр = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьПараметрСпецоператора(
			ДокументЗаявление.СпецОператорСвязи, 
			"НаименованиеУЦ");
		
		Если ЗначениеЗаполнено(ТекстЗапросаНаСертификат) Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("ЗапросНаСертификат");
			ЗаписьXML.ЗаписатьАтрибут("УдостоверяющийЦентр", УдостоверяющийЦентр);
			ЗаписьXML.ЗаписатьТекст(Строка(ТекстЗапросаНаСертификат));
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПол(ДокументЗаявление, ЗаписьXML)
	
	Пол = ДокументЗаявление.ВладелецЭЦППол;
	
	Если Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
		Пол = "2";
	ИначеЕсли Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
		Пол = "1";
	Иначе
		Пол = "0";
	КонецЕсли;
	
	ЗаписатьУзелXML(ЗаписьXML,"Пол",Пол, Истина);
		
КонецПроцедуры

&НаСервере
Процедура ЗаписатьГражданство(ДокументЗаявление, ЗаписьXML)
	
	Гражданство = ДокументЗаявление.ВладелецЭЦПГражданство;
	
	Если ЗначениеЗаполнено(Гражданство) Тогда
		Если ЗначениеЗаполнено(Гражданство.КодАльфа2) Тогда
			ЗаписатьУзелXML(ЗаписьXML,"Гражданство", Гражданство.КодАльфа2, Истина);
		Иначе
			ЗаписатьУзелXML(ЗаписьXML,"Гражданство", "RU", Истина);
		КонецЕсли;
	Иначе
		ЗаписатьУзелXML(ЗаписьXML,"Гражданство", "RU", Истина);
	КонецЕсли;
		
КонецПроцедуры
	

&НаСервереБезКонтекста
Процедура ЗаписатьУзелXML(данныеXML, ИмяУзла, ЗначениеУзла, НеВыгружатьПустые = Ложь)
	
	Если НеВыгружатьПустые И ПустаяСтрока(ЗначениеУзла) Тогда 
		
	Иначе
		данныеXML.ЗаписатьНачалоЭлемента(ИмяУзла);
		данныеXML.ЗаписатьТекст(Строка(ЗначениеУзла));
		данныеXML.ЗаписатьКонецЭлемента();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьАдресXML(данныеXML, ИмяУзла, ДокументЗаявление)
	
	Адрес = ДокументЗаявление[ИмяУзла];
	
	данныеXML.ЗаписатьНачалоЭлемента(ИмяУзла);  
	
	ЭтоАдресПоФИАСу = УправлениеКонтактнойИнформациейКлиентСервер.ЭтоКонтактнаяИнформацияВXML(Адрес);

	Если ЭтоАдресПоФИАСу Тогда
		
		КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
		АдресДляЗаявления = КонтекстЭДОСервер.АдресФИАСДляТелаЗаявления(ДокументЗаявление, ИмяУзла);
		
		данныеXML.ЗаписатьБезОбработки(АдресДляЗаявления);
	
	Иначе

		АдресВСтруктуре = РегламентированнаяОтчетностьКлиентСервер.РазложитьАдрес(Адрес);
		
		Если СтрДлина(АдресВСтруктуре.Индекс) = 6 Тогда 
			данныеXML.ЗаписатьАтрибут("Индекс",АдресВСтруктуре.Индекс);
		КонецЕсли;
				
		Если СтрДлина(АдресВСтруктуре.Регион) = 2 Тогда 
			данныеXML.ЗаписатьАтрибут("КодРегион",АдресВСтруктуре.Регион);
		КонецЕсли;
		
		Если СтрДлина(АдресВСтруктуре.Район) > 0  И  СтрДлина(АдресВСтруктуре.Район) < 51 Тогда 
			данныеXML.ЗаписатьАтрибут("Район",АдресВСтруктуре.Район);
		КонецЕсли;
		
		Если СтрДлина(АдресВСтруктуре.Город) > 0  И  СтрДлина(АдресВСтруктуре.Город) < 51 Тогда
			данныеXML.ЗаписатьАтрибут("Город",АдресВСтруктуре.Город);
		КонецЕсли;
		
		Если СтрДлина(АдресВСтруктуре.НаселенныйПункт) > 0  И  СтрДлина(АдресВСтруктуре.НаселенныйПункт) < 51 Тогда 
			данныеXML.ЗаписатьАтрибут("НаселПункт",АдресВСтруктуре.НаселенныйПункт);
		КонецЕсли;
		
		Если СтрДлина(АдресВСтруктуре.Улица) > 0  И  СтрДлина(АдресВСтруктуре.Район) < 51  Тогда 
			данныеXML.ЗаписатьАтрибут("Улица",АдресВСтруктуре.Улица);
		КонецЕсли;
		
		Если СтрДлина(АдресВСтруктуре.Дом) > 0  И  СтрДлина(АдресВСтруктуре.Дом) < 9  Тогда 
			данныеXML.ЗаписатьАтрибут("Дом",АдресВСтруктуре.Дом);
		КонецЕсли;
		
		Если СтрДлина(АдресВСтруктуре.Корпус) > 0  И  СтрДлина(АдресВСтруктуре.Корпус) < 9  Тогда 
			данныеXML.ЗаписатьАтрибут("Корпус",АдресВСтруктуре.Корпус);
		КонецЕсли;
		
		Если СтрДлина(АдресВСтруктуре.Квартира) > 0  И  СтрДлина(АдресВСтруктуре.Квартира) < 9  Тогда 
			данныеXML.ЗаписатьАтрибут("Кварт",АдресВСтруктуре.Квартира);
		КонецЕсли;
		
	КонецЕсли;
	
	данныеXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КодИНазваниеРегионаДляСертификата (КодРегиона)
	Если ПустаяСтрока(КодРегиона) Тогда
		Возврат "0";
	КонецЕсли;
	
	МакетРегионы = ПолучитьМакетОбработки("КодыРегионов353приказ");
	
	Для Инд = 1 По МакетРегионы.ВысотаТаблицы Цикл
		ТекРегион = МакетРегионы.Область(Инд, 1, Инд, 1).Текст;
		
		Если ТекРегион = КодРегиона Тогда
			Возврат КодРегиона + " " + СокрЛП(МакетРегионы.Область(Инд, 2, Инд, 2).Текст);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "0";
КонецФункции

&НаСервереБезКонтекста
Функция РазобратьСтроку(Строка, СтрокаРазделитель) экспорт
	НоваяСтрока = СтрЗаменить(Строка, СтрокаРазделитель, Символы.ПС);
	МассивСтрок = новый Массив();
	Для НомерСтроки = 1 По СтрЧислоСтрок(НоваяСтрока) Цикл
		МассивСтрок.Добавить(СтрПолучитьСтроку(НоваяСтрока, НомерСтроки));
	КонецЦикла;
	возврат МассивСтрок;
КонецФункции

&НаКлиенте
Функция ЗаявлениеОпределитьАлгоритмДляСозданияКонтейнераКлючей(ДанныеОрганизации) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Возврат КриптографияЭДКОКлиентСервер.АлгоритмПоУмолчанию();
	
КонецФункции

&НаКлиенте
Функция ПараметрыНовогоСертификата(ДокументЗаявление) Экспорт
	
	ПараметрыНовогоСертификата = Новый СписокЗначений;
	
	ЭтоЮридическоеЛицо = СтрДлина(ДокументЗаявление.ИНН)=10;
	ИНН = ДокументЗаявление.ИНН;
	
	Если ЭтоЮридическоеЛицо Тогда
		
		ИНН = "00" + ИНН;
		
		ОГРН = ДокументЗаявление.ОГРН;
		ПараметрыНовогоСертификата.Добавить("1.2.643.100.1", СокрЛП(ОГРН));
		
		CN = ДокументЗаявление.КраткоеНаименование;
		
		Если ДокументЗаявление.ПризнакОбособленногоПодразделения Тогда
			ПараметрыНовогоСертификата.Добавить("2.5.4.11",ДокументЗаявление.ВладелецЭЦППодразделение); 
		КонецЕсли;
			
	Иначе
		ОГРН = ДокументЗаявление.ОГРН;
		Если ЗначениеЗаполнено(ОГРН) Тогда
			ПараметрыНовогоСертификата.Добавить("1.2.643.100.5", ОГРН);
		КонецЕсли;
		
		CN = СтрЗаменить(ДокументЗаявление.ВладелецЭЦПФамилия," ","_")
			+ " " 
			+ СтрЗаменить(ДокументЗаявление.ВладелецЭЦПИмя," ","_") 
			+ " " 
			+ СтрЗаменить(ДокументЗаявление.ВладелецЭЦПОтчество," ","_");
		
	КонецЕсли;
	
	Если ДокументЗаявление.ПризнакОбособленногоПодразделения И НЕ ПустаяСтрока(ДокументЗаявление.ДополнительныйКодФСС) Тогда
		ПараметрыНовогоСертификата.Добавить("РегНомерФСС", ДокументЗаявление.ДополнительныйКодФСС);
	Иначе
		ПараметрыНовогоСертификата.Добавить("РегНомерФСС", ДокументЗаявление.РегНомерФСС);
	КонецЕсли;
	
	Если Не ПустаяСтрока(ДокументЗаявление.ЭлектроннаяПочта) Тогда
		ПараметрыНовогоСертификата.Добавить("1.2.840.113549.1.9.1", ДокументЗаявление.ЭлектроннаяПочта);
	КонецЕсли;
	
	ПараметрыНовогоСертификата.Добавить("1.2.643.3.131.1.1",ИНН);
	ПараметрыНовогоСертификата.Добавить("2.5.4.6","RU"); 
	
	ЗаявлениеСформироватьАдресДляЗапросаНаСертификатКвалифицированный(ДокументЗаявление.Ссылка, ПараметрыНовогоСертификата);
	
	Если ЭтоЮридическоеЛицо Тогда
		ПараметрыНовогоСертификата.Добавить("2.5.4.10",ДокументЗаявление.КраткоеНаименование); // поле O
	КонецЕсли;
	
	ПараметрыНовогоСертификата.Добавить("2.5.4.3", СокрЛП(CN)); // поле CN
	
	ПараметрыНовогоСертификата.Добавить("2.5.4.4", СтрЗаменить(ДокументЗаявление.ВладелецЭЦПФамилия," ","_"));
	ПараметрыНовогоСертификата.Добавить("2.5.4.42", СтрЗаменить(ДокументЗаявление.ВладелецЭЦПИмя," ","_") +" " + СтрЗаменить(ДокументЗаявление.ВладелецЭЦПОтчество," ","_"));

	Если ЭтоЮридическоеЛицо Тогда
		ПараметрыНовогоСертификата.Добавить("2.5.4.12",ДокументЗаявление.ВладелецЭЦПДолжность); // поле T
	КонецЕсли;
	
	СНИЛС = ДокументЗаявление.ВладелецЭЦПСНИЛС;
	СНИЛС = СтрЗаменить(СНИЛС,"-","");
	СНИЛС = СтрЗаменить(СНИЛС," ","");
	ПараметрыНовогоСертификата.Добавить("1.2.643.100.3", СНИЛС);
	
	Возврат ПараметрыНовогоСертификата;
	
КонецФункции

&НаКлиенте
Функция ЗаявлениеСформироватьЗапросНаСертификатКвалифицированный(ВходящийКонтекст)
	
	ДокументЗаявление    = ВходящийКонтекст.ДокументЗаявление;
	OIDЛицензииКриптоПро = ВходящийКонтекст.OIDЛицензииКриптоПро;
	
	ПараметрыНовогоСертификата = ПараметрыНовогоСертификата(ДокументЗаявление);
	
	СтрокаCertAttrs = "";
	
	Для Счетчик = 0 По ПараметрыНовогоСертификата.Количество()-1 Цикл 
		
		Если ПараметрыНовогоСертификата[Счетчик].Значение = "РегНомерФСС" Тогда
			Продолжить;
		КонецЕсли;
		
		Значение = ПараметрыНовогоСертификата[Счетчик].Значение;
		Представление = СокрЛП(Строка(ПараметрыНовогоСертификата[Счетчик].Представление));
		
		Если ПустаяСтрока(Представление) Тогда
			Представление = "0";
		КонецЕсли;
		
		СтрокаCertAttrs = СтрокаCertAttrs+ ",<"+Значение+"="+Представление+">";
		
	КонецЦикла;	
	
	СтрокаCertAttrs = Сред(СтрокаCertAttrs,2);
	
	РасширенноеИспользованиеКлюча = "1.3.6.1.5.5.7.3.2,1.3.6.1.5.5.7.3.4"; // проверка подлинности клиента, защищенная электронная почта
	
	СвойстваКриптопровайдера = КриптографияЭДКОКлиентСервер.СвойстваКриптопровайдераПоУмолчанию(ДокументЗаявление.ТипКриптопровайдера);
	
	Если СвойстваКриптопровайдера.ТипКриптопровайдера = ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.VipNet") Тогда
		КриптоСредство = "СКЗИ ""ViPNet CSP"", версия 4.2";
	Иначе
		КриптоСредство = """КриптоПро CSP"" (версия 4.0)";
	КонецЕсли;
	
	Если ПараметрыНовогоСертификата.НайтиПоЗначению("РегНомерФСС") <> Неопределено Тогда
		РегНомерФСС = ПараметрыНовогоСертификата.НайтиПоЗначению("РегНомерФСС").Представление;
	Иначе
		РегНомерФСС = Неопределено;
	КонецЕсли;
		
	Если РегНомерФСС = Неопределено ИЛИ РегНомерФСС = "" Тогда
		СтрокаФСС = "";
	Иначе
		СтрокаФСС = "CertAltNames:{<5=1.2.643.3.141.1.1="+РегНомерФСС+">}"+Символы.ПС;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(OIDЛицензииКриптоПро) Тогда 
		OID = OIDЛицензииКриптоПро;
	Иначе
		OID = "1.2.643.2.2.46.0.8";
	КонецЕсли;
	
	СтрокаЗапроса = "pRequestInfo:{"+Символы.ПС+
	"CertAttrs:{"+СтрокаCertAttrs+"}"+Символы.ПС+
	"CertEnhKeyUsage:{" + РасширенноеИспользованиеКлюча + "}"+Символы.ПС+
	"CertPolicies:{<1.2.643.100.113.1=>}"+Символы.ПС+
	СтрокаФСС+
	"dwKeyUsage:{240}"+Символы.ПС+
	"SignTool:{"+ КриптоСредство + "}"+Символы.ПС+
	"CertTemplate:{" + OID + "}"+Символы.ПС+
	"}";
		
	Возврат СтрокаЗапроса;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТипЗаявления(ТипЗаявления)
	
	Если ТипЗаявления = Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Первичное Тогда
		ТипыЗаявленийНаРегистрациюЭДО = 1;
	ИначеЕсли ТипЗаявления = Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Изменение Тогда
		ТипыЗаявленийНаРегистрациюЭДО = 2;
	ИначеЕсли ТипЗаявления = Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Пролонгация Тогда
		ТипыЗаявленийНаРегистрациюЭДО = 3;	
	ИначеЕсли ТипЗаявления = Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Восстановление Тогда
		ТипыЗаявленийНаРегистрациюЭДО = 4;
	Иначе
		ТипыЗаявленийНаРегистрациюЭДО = 1;
	КонецЕсли;
	
	Возврат ТипыЗаявленийНаРегистрациюЭДО;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьСтраницуДляСкачивания(Версия) Экспорт
	
	Если Версия = СтруктураСсылочныхДанных.Перечисления_ТипыКриптоПровайдеров_VipNet Тогда
		
		АдресСтраницы = "http://infotecs.ru/downloads/product_full.php?id_product=2096";
		
	Иначе
		
		АдресСтраницы = "http://cryptopro.ru/";
		
	КонецЕсли;
	
	ПерейтиПоНавигационнойСсылке(АдресСтраницы);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПредставлениеКриптопровайдера(Элемент,ВыборКриптопровайдера)
	
	Возврат Элемент.СписокВыбора[ВыборКриптопровайдера-1].Представление;
	
КонецФункции

&НаКлиенте
Процедура ПолеВыбораКриптопровайдераПриИзменении(Элемент,ТаблицаЗначенийКС,КартинкаВидимость,ВыборКриптопровайдера,КриптопровайдерРекомендация, ВыполняемоеОповещение = Неопределено) Экспорт
	
	ПолеВыбораКриптопровайдера = ПолучитьПредставлениеКриптопровайдера(Элемент,ВыборКриптопровайдера);
	
	Режим = РежимДиалогаВопрос.ДаНет;
	
	ТекстВипнет = "Перейти на сайт разработчика с которого можно бесплатно скачать и установить криптопровайдер ?
	|
	|Внимание! Если будет произведено скачивание и установка, рекомендуется перезагрузить компьютер и запустить мастер заново.";
	
	ТекстКриптоПро = "Перейти на сайт разработчика на котором можно ознакомиться с информацией о способах приобретения криптопровайдера ?
	|
	|Внимание! Если будет произведено приобретение и установка, рекомендуется перезагрузить компьютер и запустить мастер заново.";
	
	Для каждого Строка из ТаблицаЗначенийКС Цикл
		
		Если Строка.ОтображаемыйТекст = ПолеВыбораКриптопровайдера Тогда
			Если Строка.УстановленОС Тогда
				
			ИначеЕсли  Строка.Статус = "(требуется установка)" Тогда
				
				ДополнительныеПараметры = Новый Структура("ТаблицаЗначенийКС, КриптопровайдерРекомендация, ВыборКриптопровайдера, КартинкаВидимость, ВыполняемоеОповещение", ТаблицаЗначенийКС, КриптопровайдерРекомендация, ВыборКриптопровайдера, КартинкаВидимость, ВыполняемоеОповещение);
				ОписаниеОповещения = Новый ОписаниеОповещения("ПолеВыбораКриптопровайдераПриИзмененииВопросВипнетЗавершение", ЭтотОбъект, ДополнительныеПараметры);
				ПоказатьВопрос(ОписаниеОповещения, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1';
																												|en = '%1'"),ТекстВипнет), Режим, 0, КодВозвратаДиалога.Нет);
				Возврат;				
			Иначе
				
				ДополнительныеПараметры = Новый Структура("ТаблицаЗначенийКС, КриптопровайдерРекомендация, ВыборКриптопровайдера, КартинкаВидимость, ВыполняемоеОповещение", ТаблицаЗначенийКС, КриптопровайдерРекомендация, ВыборКриптопровайдера, КартинкаВидимость, ВыполняемоеОповещение);
				ОписаниеОповещения = Новый ОписаниеОповещения("ПолеВыбораКриптопровайдераПриИзмененииВопросКриптоПроЗавершение", ЭтотОбъект, ДополнительныеПараметры);
				ПоказатьВопрос(ОписаниеОповещения, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1';
																												|en = '%1'"),ТекстКриптоПро), Режим, 0, КодВозвратаДиалога.Нет);
				Возврат;				
			КонецЕсли;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ВыработатьРекомендацииПоКриптопровайдеру(ТаблицаЗначенийКС,КриптопровайдерРекомендация,ВыборКриптопровайдера,КартинкаВидимость,ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеВыбораКриптопровайдераПриИзмененииВопросВипнетЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	ТаблицаЗначенийКС = ДополнительныеПараметры.ТаблицаЗначенийКС;
	КриптопровайдерРекомендация = ДополнительныеПараметры.КриптопровайдерРекомендация;
	ВыборКриптопровайдера = ДополнительныеПараметры.ВыборКриптопровайдера;
	КартинкаВидимость = ДополнительныеПараметры.КартинкаВидимость;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОткрытьСтраницуДляСкачивания(СтруктураСсылочныхДанных.Перечисления_ТипыКриптоПровайдеров_VipNet);
	КонецЕсли;
	
	ВыработатьРекомендацииПоКриптопровайдеру(ТаблицаЗначенийКС,КриптопровайдерРекомендация,ВыборКриптопровайдера,КартинкаВидимость,ВыполняемоеОповещение);
		
КонецПроцедуры

&НаКлиенте
