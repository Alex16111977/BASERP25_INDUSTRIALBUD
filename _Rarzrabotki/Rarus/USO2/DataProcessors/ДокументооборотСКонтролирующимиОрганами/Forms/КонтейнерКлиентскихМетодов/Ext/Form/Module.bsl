КонецПроцедуры

&НаКлиенте
Процедура ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрованиеПослеИмпортаСертификатаПолучателяЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	УчетнаяЗапись = ДополнительныеПараметры.УчетнаяЗапись;
	СертификатПолучателя = ДополнительныеПараметры.СертификатПолучателя;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ИдентификаторДокументооборота = ДополнительныеПараметры.ИдентификаторДокументооборота;
	ДанныеСертификатаОтправителя = ДополнительныеПараметры.ДанныеСертификатаОтправителя;
	СвойстваСертификатаПолучателя = ДополнительныеПараметры.СвойстваСертификатаПолучателя;
	ИмяФайлаСертификата = ДополнительныеПараметры.ИмяФайлаСертификата;
	
	Если НЕ Результат.Выполнено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось зарегистрировать сертификат сервера онлайн-проверки в системном хранилище сертификатов.';
								|en = 'Cannot register a certificate of online check server in the system certificate storage.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	СертификатПолучателя.Отпечаток = Результат.СвойстваСертификата.Отпечаток;
	СвойстваСертификатаПолучателя = Результат.СвойстваСертификата;

	Если НЕ ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,ИмяФайлаСертификата);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("Контекст", Контекст);
	ДополнительныеПараметры.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	ДополнительныеПараметры.Вставить("СертификатПолучателя", СертификатПолучателя);
	ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	ДополнительныеПараметры.Вставить("ИдентификаторДокументооборота", ИдентификаторДокументооборота);
	ДополнительныеПараметры.Вставить("ДанныеСертификатаОтправителя", ДанныеСертификатаОтправителя);
	ДополнительныеПараметры.Вставить("СвойстваСертификатаПолучателя", СвойстваСертификатаПолучателя);
	Оповещение = Новый ОписаниеОповещения("ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрованиеПослеПолученияСвойствСертификатаПолучателяИИмпортаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ВыполнитьОбработкуОповещения(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрованиеПослеПолученияИзИнтернетаСертификатаСервераОнлайнПроверкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	УчетнаяЗапись = ДополнительныеПараметры.УчетнаяЗапись;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ИдентификаторДокументооборота = ДополнительныеПараметры.ИдентификаторДокументооборота;
	ДанныеСертификатаОтправителя = ДополнительныеПараметры.ДанныеСертификатаОтправителя;
	
	СвойстваСертификатаПолучателя = Результат.СвойстваСертификатаПолучателя;
	Контекст = Результат.Контекст;
	
	Если НЕ ЗначениеЗаполнено(СвойстваСертификатаПолучателя) Тогда
		РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	СертификатПолучателя = Новый Структура("Отпечаток, Сертификат", СвойстваСертификатаПолучателя.Отпечаток, Неопределено);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("Контекст", Контекст);
	ДополнительныеПараметры.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	ДополнительныеПараметры.Вставить("СертификатПолучателя", СертификатПолучателя);
	ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	ДополнительныеПараметры.Вставить("ИдентификаторДокументооборота", ИдентификаторДокументооборота);
	ДополнительныеПараметры.Вставить("ДанныеСертификатаОтправителя", ДанныеСертификатаОтправителя);
	ДополнительныеПараметры.Вставить("СвойстваСертификатаПолучателя", СвойстваСертификатаПолучателя);
	Оповещение = Новый ОписаниеОповещения("ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрованиеПослеПолученияСвойствСертификатаПолучателяИИмпортаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ВыполнитьОбработкуОповещения(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрованиеПослеПолученияСвойствСертификатаПолучателяИИмпортаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	УчетнаяЗапись = ДополнительныеПараметры.УчетнаяЗапись;
	СертификатПолучателя = ДополнительныеПараметры.СертификатПолучателя;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ИдентификаторДокументооборота = ДополнительныеПараметры.ИдентификаторДокументооборота;
	ДанныеСертификатаОтправителя = ДополнительныеПараметры.ДанныеСертификатаОтправителя;
	СвойстваСертификатаПолучателя = ДополнительныеПараметры.СвойстваСертификатаПолучателя;
	
	///////////////////////////////////////////////////////////////////////////////
	// ШИФРОВАНИЕ АРХИВА С ФАЙЛОМ ВЫГРУЗКИ
	
	Если Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате <> Истина Тогда
		
		// формируем зашифрованный контейнер с файлом выгрузки
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("Контекст", Контекст);
		ДополнительныеПараметры.Вставить("УчетнаяЗапись", УчетнаяЗапись);
		ДополнительныеПараметры.Вставить("СертификатПолучателя", СертификатПолучателя);
		ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
		ДополнительныеПараметры.Вставить("ИдентификаторДокументооборота", ИдентификаторДокументооборота);
		ДополнительныеПараметры.Вставить("ДанныеСертификатаОтправителя", ДанныеСертификатаОтправителя);
		ДополнительныеПараметры.Вставить("СвойстваСертификатаПолучателя", СвойстваСертификатаПолучателя);
		Оповещение = Новый ОписаниеОповещения("ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрованиеПослеЗашифрованияВыгрузкиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		СертификатыЗашифрования = Новый Массив;
		СертификатыЗашифрования.Добавить(СвойстваСертификатаПолучателя);
		КриптографияЭДКОКлиент.ЗашифроватьPKCS7(Оповещение, Контекст.АдресАрхиваФайлаВыгрузки, СертификатыЗашифрования, , Ложь);
		Возврат;
		
	КонецЕсли;
	
	// при использовании универсального формата
	АдресаЗашифрованныхФайлов = Новый Массив();
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("Контекст", Контекст);
	ДополнительныеПараметры.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	ДополнительныеПараметры.Вставить("СертификатПолучателя", СертификатПолучателя);
	ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	ДополнительныеПараметры.Вставить("ИдентификаторДокументооборота", ИдентификаторДокументооборота);
	ДополнительныеПараметры.Вставить("ДанныеСертификатаОтправителя", ДанныеСертификатаОтправителя);
	ДополнительныеПараметры.Вставить("СвойстваСертификатаПолучателя", СвойстваСертификатаПолучателя);
	ДополнительныеПараметры.Вставить("АдресаЗашифрованныхФайлов", АдресаЗашифрованныхФайлов);
	ДополнительныеПараметры.Вставить("ИндексАрхива", 0);
	Оповещение = Новый ОписаниеОповещения("ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрованиеЗашифрованиеВУниверсальномФорматеВЦиклеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ВыполнитьОбработкуОповещения(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрованиеПослеЗашифрованияВыгрузкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	УчетнаяЗапись = ДополнительныеПараметры.УчетнаяЗапись;
	СертификатПолучателя = ДополнительныеПараметры.СертификатПолучателя;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ИдентификаторДокументооборота = ДополнительныеПараметры.ИдентификаторДокументооборота;
	ДанныеСертификатаОтправителя = ДополнительныеПараметры.ДанныеСертификатаОтправителя;
	СвойстваСертификатаПолучателя = ДополнительныеПараметры.СвойстваСертификатаПолучателя;
	
	Если НЕ Результат.Выполнено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать зашифрованный пакет для отправки на сервер онлайн-проверки.';
								|en = 'Cannot generate an encrypted package for sending to online check server.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	АдресЗашифрованногоФайла = Результат.ЗашифрованныйФайл;
	
	Контекст.Вставить("ДанныеСертификатаОтправителя", ДанныеСертификатаОтправителя);
	Контекст.Вставить("СертификатПолучателя", СертификатПолучателя.Отпечаток);
	Контекст.Вставить("АдресЗашифрованногоФайла", АдресЗашифрованногоФайла);
	
	РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Истина, Контекст);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрованиеЗашифрованиеВУниверсальномФорматеВЦиклеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	УчетнаяЗапись = ДополнительныеПараметры.УчетнаяЗапись;
	СертификатПолучателя = ДополнительныеПараметры.СертификатПолучателя;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ИдентификаторДокументооборота = ДополнительныеПараметры.ИдентификаторДокументооборота;
	ДанныеСертификатаОтправителя = ДополнительныеПараметры.ДанныеСертификатаОтправителя;
	СвойстваСертификатаПолучателя = ДополнительныеПараметры.СвойстваСертификатаПолучателя;
	АдресаЗашифрованныхФайлов = ДополнительныеПараметры.АдресаЗашифрованныхФайлов;
	ИндексАрхива = ДополнительныеПараметры.ИндексАрхива;
	
	Если ИндексАрхива > 0 Тогда
		Если НЕ Результат.Выполнено Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось сформировать зашифрованный пакет для отправки на сервер онлайн-проверки.';
									|en = 'Cannot generate an encrypted package for sending to online check server.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
			Возврат;
		КонецЕсли;
		
		АдресЗашифрованногоФайла = Результат.ЗашифрованныйФайл;
		АдресаЗашифрованныхФайлов.Добавить(АдресЗашифрованногоФайла);
	КонецЕсли;
	
	Если ИндексАрхива < Контекст.АдресАрхиваФайлаВыгрузки.Количество() Тогда
		АдресАрхива = Контекст.АдресАрхиваФайлаВыгрузки[ИндексАрхива];
		ИндексАрхива = ИндексАрхива + 1;
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("Контекст", Контекст);
		ДополнительныеПараметры.Вставить("УчетнаяЗапись", УчетнаяЗапись);
		ДополнительныеПараметры.Вставить("СертификатПолучателя", СертификатПолучателя);
		ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
		ДополнительныеПараметры.Вставить("ИдентификаторДокументооборота", ИдентификаторДокументооборота);
		ДополнительныеПараметры.Вставить("ДанныеСертификатаОтправителя", ДанныеСертификатаОтправителя);
		ДополнительныеПараметры.Вставить("СвойстваСертификатаПолучателя", СвойстваСертификатаПолучателя);
		ДополнительныеПараметры.Вставить("АдресаЗашифрованныхФайлов", АдресаЗашифрованныхФайлов);
		ДополнительныеПараметры.Вставить("ИндексАрхива", ИндексАрхива);
		Оповещение = Новый ОписаниеОповещения("ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрованиеЗашифрованиеВУниверсальномФорматеВЦиклеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		СертификатыЗашифрования = Новый Массив;
		СертификатыЗашифрования.Добавить(СвойстваСертификатаПолучателя);
		КриптографияЭДКОКлиент.ЗашифроватьPKCS7(Оповещение, АдресАрхива, СертификатыЗашифрования, , Ложь);
		Возврат;
	КонецЕсли;
	
	АдресЗашифрованногоФайла = АдресаЗашифрованныхФайлов;
	
	Контекст.Вставить("ДанныеСертификатаОтправителя", ДанныеСертификатаОтправителя);
	Контекст.Вставить("СертификатПолучателя", СертификатПолучателя.Отпечаток);
	Контекст.Вставить("АдресЗашифрованногоФайла", АдресЗашифрованногоФайла);
	
	РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Истина, Контекст);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОнлайнПроверкаОтчета_СформироватьИОтправитьЗапрос(Контекст, ПовторятьСоединение)
	
	// формируем запрос
	Если Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате <> Истина Тогда
		ИмяФайлаЗапроса = СформироватьЗапросКСерверуОнлайнПроверки(Контекст.УчетнаяЗапись, Контекст.ДанныеСертификатаОтправителя, Контекст.АдресЗашифрованногоФайла);
		
	Иначе
		Если ТипЗнч(Контекст.ИмяФайлаВыгрузки) = Тип("Строка") Тогда
			ИменаФайловВыгрузки = Новый Массив();
			ИменаФайловВыгрузки.Добавить(Контекст.ИмяФайлаВыгрузки);
		Иначе
			ИменаФайловВыгрузки = Контекст.ИмяФайлаВыгрузки;
		КонецЕсли;
		ИмяФайлаЗапроса = СформироватьЗапросКСерверуОнлайнПроверкиВУниверсальномФормате(Контекст.УчетнаяЗапись, Контекст.Документ, Контекст.КонтролирующийОрган, Контекст.ДанныеСертификатаОтправителя, ИменаФайловВыгрузки, Контекст.АдресЗашифрованногоФайла);
	КонецЕсли;
	
	Если ИмяФайлаЗапроса = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате <> Истина Тогда
		ФайлРезультатаПроверки = ОтправитьЗапросДляОбработкиНаСерверОнлайнПроверки(ИмяФайлаЗапроса);
		ПовторятьСоединение = Ложь;
	Иначе
		ФайлРезультатаПроверки = ОтправитьЗапросДляОбработкиНаСерверОнлайнПроверкиВУниверсальномФормате(ИмяФайлаЗапроса, Контекст.ИнформацияОСервереОнлайнПроверки.Ресурс, ПовторятьСоединение);
	КонецЕсли;
	Если ФайлРезультатаПроверки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// анализируем результат
	ОбъектФайл = Новый Файл(ФайлРезультатаПроверки);
	Если НЕ ОбъектФайл.Существует() Тогда
		ТекстСообщения = НСтр("ru = 'На запрос о проверке отчета не получен ответ от сервера.';
								|en = 'Server response to the report check request is not received.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// помещаем во временное хранилище
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ФайлРезультатаПроверки), Контекст.УникальныйИдентификатор);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлРезультатаПроверки);
	
	// запоминаем в контексте адрес во временном хранилище
	Контекст.Вставить("АдресФайлаРезультатаПроверки", АдресВоВременномХранилище);
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОнлайнПроверкаОтчета(Контекст, ВыполняемоеОповещение)
	
	// подготовительные действия и проверки на сервере
	Если НЕ ОнлайнПроверкаОтчета_ПодготовкаНаСервере(Контекст) Тогда // сервер
		Результат = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	// устанавливаем и проверяем сертификаты сервера онлайн-проверки
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	
	Оповещение = Новый ОписаниеОповещения(
		"ОнлайнПроверкаОтчетаПослеУстановкиИПроверкиСертификатов", ЭтотОбъект, ДополнительныеПараметры);
	ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрование(Контекст, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОнлайнПроверкаОтчетаПослеУстановкиИПроверкиСертификатов(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = Результат.Контекст;
	Если Не Результат.РезультатПроверки Тогда
		РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(Контекст.УчетнаяЗапись);
	ЭтоЭлектроннаяПодписьВМоделиСервиса = РеквизитыУчетнойЗаписи.ЭлектроннаяПодписьВМоделиСервиса;
	
	ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
		ДополнительныеПараметры = Новый Структура("Контекст, ВыполняемоеОповещение", Контекст, ВыполняемоеОповещение);
		ОписаниеОповещения = Новый ОписаниеОповещения("ОнлайнПроверкаОтчетаВЦикле", ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОнлайнПроверкаОтчетаВЦикле(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	Контекст = ДополнительныеПараметры.Контекст;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	// формируем запрос и отправляем
	ПовторятьСоединение = Истина;
	Если НЕ ОнлайнПроверкаОтчета_СформироватьИОтправитьЗапрос(Контекст, ПовторятьСоединение) Тогда // сервер
		Если ПовторятьСоединение Тогда
			ОписаниеОповещения = Новый ОписаниеОповещения("ОнлайнПроверкаОтчетаВЦикле", ЭтотОбъект, ДополнительныеПараметры);
			
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(
				НСтр("ru = 'Не удалось обратиться к серверу онлайн-проверки';
					|en = 'Cannot contact online check server'"), 
				ОписаниеОповещения);
				
			Возврат;
			
		Иначе
			Результат = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// разбираем результат
	ОнлайнПроверкаОтчета_РазобратьРезультатОтСервераОнлайнПроверки(Контекст, ВыполняемоеОповещение);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РазобратьРезультатОтСервераОнлайнПроверки_НаСервере(Контекст)
	
	СтекЭлементов = Новый Массив;
	
	// загружаем файл XML в дерево
	ОписаниеОшибки = "";
	ДеревоПроверки = ЗагрузитьXMLВДеревоЗначений(Контекст.АдресФайлаРезультатаПроверки, , ОписаниеОшибки);
	Если ДеревоПроверки = Неопределено Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Некорректный формат ответа сервера онлайн-проверки:%1';
				|en = 'Incorrect format of online check server response:%1'"), Символы.ПС + ОписаниеОшибки);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ДеревоПроверки.Строки.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Некорректный формат ответа сервера онлайн-проверки.';
								|en = 'Incorrect format of online check server response.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате <> Истина Тогда
		
		СоответствиеКодаВозвратаПредставлению = Новый Соответствие;
		СоответствиеКодаВозвратаПредставлению.Вставить(-1, НСтр("ru = 'Произошла неизвестная ошибка.';
																|en = 'An unknown error occurred.'"));
		СоответствиеКодаВозвратаПредставлению.Вставить(0, НСтр("ru = 'Проверка прошла успешно.';
																|en = 'Check was successful.'"));
		СоответствиеКодаВозвратаПредставлению.Вставить(1, НСтр("ru = 'Не удалось расшифровать полученные данные.';
																|en = 'Cannot decrypt the received data.'"));
		СоответствиеКодаВозвратаПредставлению.Вставить(2, НСтр("ru = 'Проверка файлов данного типа не поддерживается.';
																|en = 'Cannot check files of this type.'"));
		СоответствиеКодаВозвратаПредставлению.Вставить(3, НСтр("ru = 'Проверяемый файл поврежден или не соответствует требуемому формату.';
																|en = 'Checked file is damaged or does not conform to the required format.'"));
		СоответствиеКодаВозвратаПредставлению.Вставить(4, НСтр("ru = 'Проверка не прошла.';
																|en = 'Check failed.'"));
		СоответствиеКодаВозвратаПредставлению.Вставить(5, НСтр("ru = 'Проверка не была выполнена.';
																|en = 'Check failed.'"));
		СоответствиеКодаВозвратаПредставлению.Вставить(6, НСтр("ru = 'Один или несколько документов не прошли проверку.';
																|en = 'One or several documents failed validation.'"));
		
		// позиционируемся на элементе верхнего уровня
		УзелReport = ДеревоПроверки.Строки.Найти("Report", "Имя");
		Если УзелReport = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Некорректный формат ответа сервера онлайн-проверки.';
									|en = 'Incorrect format of online check server response.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		
		// позиционируемся на узле результата
		УзелResult = УзелReport.Строки.Найти("Result", "Имя");
		Если УзелResult = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Некорректный формат ответа сервера онлайн-проверки.';
									|en = 'Incorrect format of online check server response.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		
		// ищем узлы Successed и ExtCode
		УзелSucceeded = УзелResult.Строки.Найти("Succeeded", "Имя");
		УзелExtCode = УзелResult.Строки.Найти("ExtCode", "Имя");
		Если УзелSucceeded = Неопределено ИЛИ УзелExtCode = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Некорректный формат ответа сервера онлайн-проверки.';
									|en = 'Incorrect format of online check server response.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		
		ПризнакУспешнойПроверки = XMLЗначениеВнутр(Тип("Булево"), УзелSucceeded.Значение);
		Если ПризнакУспешнойПроверки = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Некорректный формат ответа сервера онлайн-проверки: некорректный признак успешного завершения проверки.';
									|en = 'Incorrect format of online check server response: incorrect flag of successful check end.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		
		КодЗавершения = XMLЗначениеВнутр(Тип("Число"), УзелExtCode.Значение);
		Если КодЗавершения = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Некорректный формат ответа сервера онлайн-проверки: некорректный код завершения проверки.';
									|en = 'Incorrect format of online check server response: incorrect check end code.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		
		Результат = Новый Структура;
		
		// загружаем из XML таблицу с детальной информацией о проверках каждого документа
		УзелDocuments = УзелReport.Строки.Найти("Documents", "Имя");
		Если УзелDocuments <> Неопределено Тогда
			
			ТаблицаРезультатовПоДокументам = Новый ТаблицаЗначений;
			ТаблицаРезультатовПоДокументам.Колонки.Добавить("ИмяФайлаОтчета");
			ТаблицаРезультатовПоДокументам.Колонки.Добавить("ИсходноеИмяФайлаПротокола");
			ТаблицаРезультатовПоДокументам.Колонки.Добавить("ИмяФайлаПротокола");
			ТаблицаРезультатовПоДокументам.Колонки.Добавить("ТипПротокола");
			ТаблицаРезультатовПоДокументам.Колонки.Добавить("РезультатПроверки");
			ТаблицаРезультатовПоДокументам.Колонки.Добавить("РезультатПроверкиСтр");
			
			УзлыDocument = УзелDocuments.Строки.НайтиСтроки(Новый Структура("Имя", "Document"));
			Для Каждого УзелDocument Из УзлыDocument Цикл
				АтрибутыУзлаDocument = ПолучитьАтрибутыУзла(УзелDocument);
				
				НовСтрТаблицыРезультатовПоДокументам = ТаблицаРезультатовПоДокументам.Добавить();
				НовСтрТаблицыРезультатовПоДокументам.ИмяФайлаОтчета = АтрибутыУзлаDocument.report;
				Если АтрибутыУзлаDocument.Свойство("protocol") Тогда
					НовСтрТаблицыРезультатовПоДокументам.ИсходноеИмяФайлаПротокола = АтрибутыУзлаDocument.protocol;
				КонецЕсли;
				Если АтрибутыУзлаDocument.Свойство("file") Тогда
					НовСтрТаблицыРезультатовПоДокументам.ИмяФайлаПротокола = АтрибутыУзлаDocument.file;
				КонецЕсли;
				Если АтрибутыУзлаDocument.Свойство("type") Тогда
					НовСтрТаблицыРезультатовПоДокументам.ТипПротокола = АтрибутыУзлаDocument.type;
				КонецЕсли;
				
				УзелResult = УзелDocument.Строки.Найти("Result", "Имя");
				Если УзелResult <> Неопределено Тогда
					АтрибутыУзлаResult = ПолучитьАтрибутыУзла(УзелResult);
					
					НовСтрТаблицыРезультатовПоДокументам.РезультатПроверки = XMLЗначениеВнутр(Тип("Булево"), АтрибутыУзлаResult.Succeeded);
					Если АтрибутыУзлаResult.Свойство("ExtCode") Тогда
						
						КодРезультатаПроверки = XMLЗначениеВнутр(Тип("Число"), АтрибутыУзлаResult.ExtCode);
						НовСтрТаблицыРезультатовПоДокументам.РезультатПроверки = КодРезультатаПроверки;
						
						ПредставлениеРезультата = СоответствиеКодаВозвратаПредставлению[КодРезультатаПроверки];
						НовСтрТаблицыРезультатовПоДокументам.РезультатПроверкиСтр = ПредставлениеРезультата;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
			РезультатыПоДокументам = ПоместитьВоВременноеХранилище(ТаблицаРезультатовПоДокументам, Контекст.УникальныйИдентификатор);
			
			Результат.Вставить("РезультатыПоДокументам", РезультатыПоДокументам);
			
		КонецЕсли;
		
		// добавляем сертификат в результат, если он есть
		УзелCertificate = УзелReport.Строки.Найти("Certificate", "Имя");
		Если УзелCertificate <> Неопределено Тогда
			Результат.Вставить("Certificate", XMLЗначениеВнутр(Тип("Строка"), УзелCertificate.Значение));
		КонецЕсли;
		
		// добавляем протокол в результат, если он есть
		УзелProtocol = УзелReport.Строки.Найти("Protocol", "Имя");
		Если УзелProtocol <> Неопределено Тогда
			Результат.Вставить("Protocol", XMLЗначениеВнутр(Тип("Строка"), УзелProtocol.Значение));
		КонецЕсли;
		
		ПредставлениеРезультата = СоответствиеКодаВозвратаПредставлению[КодЗавершения];
		
	Иначе
		
		// разбор результатов в универсальном формате
		
		СоответствиеКодаВозвратаПредставлению = Новый Соответствие;
		СоответствиеКодаВозвратаПредставлению.Вставить(-1, НСтр("ru = 'Произошла неизвестная ошибка.';
																|en = 'An unknown error occurred.'"));
		СоответствиеКодаВозвратаПредставлению.Вставить(0, НСтр("ru = 'Проверка прошла успешно.';
																|en = 'Check was successful.'"));
		СоответствиеКодаВозвратаПредставлению.Вставить(1, НСтр("ru = 'Не удалось расшифровать полученные данные.';
																|en = 'Cannot decrypt the received data.'"));
		СоответствиеКодаВозвратаПредставлению.Вставить(2, НСтр("ru = 'Проверяемый документ поврежден или не соответствует требуемому формату.';
																|en = 'Checked document is damaged or does not conform to the required format.'"));
		СоответствиеКодаВозвратаПредставлению.Вставить(3, НСтр("ru = 'Проверка не прошла.';
																|en = 'Check failed.'"));
		СоответствиеКодаВозвратаПредставлению.Вставить(4, НСтр("ru = 'Проверка прошла успешно, но есть предупреждения.';
																|en = 'Check was successful but there are warnings.'"));
		
		// позиционируемся на элементе верхнего уровня
		УзелОтвет = ДеревоПроверки.Строки.Найти("Ответ", "Имя");
		Если УзелОтвет = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Некорректный формат ответа сервера онлайн-проверки.';
									|en = 'Incorrect format of online check server response.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		ПредставлениеРезультата = УзелОтвет.Значение;
		
		// позиционируемся на узле результата
		УзелОбщийРезультатПроверки = УзелОтвет.Строки.Найти("ОбщийРезультатПроверки", "Имя");
		Если УзелОбщийРезультатПроверки = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Некорректный формат ответа сервера онлайн-проверки.';
									|en = 'Incorrect format of online check server response.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		АтрибутыУзлаОбщийРезультатПроверки = ПолучитьАтрибутыУзла(УзелОбщийРезультатПроверки);
		
		// проверяем наличие атрибута кода
		Если НЕ АтрибутыУзлаОбщийРезультатПроверки.Свойство("Код") Тогда
			ТекстСообщения = НСтр("ru = 'Некорректный формат ответа сервера онлайн-проверки.';
									|en = 'Incorrect format of online check server response.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		
		КодЗавершения = XMLЗначениеВнутр(Тип("Число"), АтрибутыУзлаОбщийРезультатПроверки.Код);
		Если КодЗавершения = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Некорректный формат ответа сервера онлайн-проверки: некорректный код завершения проверки.';
									|en = 'Incorrect format of online check server response: incorrect check end code.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		ПризнакУспешнойПроверки = (КодЗавершения = 0);
		Если НЕ ЗначениеЗаполнено(ПредставлениеРезультата) Тогда
			ПредставлениеРезультата = СоответствиеКодаВозвратаПредставлению[КодЗавершения];
		КонецЕсли;
		
		Результат = Новый Структура;
		
		// загружаем из XML таблицу с информацией о программах проверки
		ТаблицаПрограммПроверки = Неопределено;
		УзлыПрограммаПроверки = УзелОтвет.Строки.НайтиСтроки(Новый Структура("Имя", "ПрограммаПроверки"));
		Если УзлыПрограммаПроверки.Количество() > 0 Тогда
			
			ТаблицаПрограммПроверки = Новый ТаблицаЗначений;
			ТаблицаПрограммПроверки.Колонки.Добавить("КодПрограммыПроверки");
			ТаблицаПрограммПроверки.Колонки.Добавить("Наименование");
			ТаблицаПрограммПроверки.Колонки.Добавить("Версия");
			ТаблицаПрограммПроверки.Колонки.Добавить("ДатаВремяОбновления");
			ТаблицаПрограммПроверки.Колонки.Добавить("ПредставлениеНаименования");
			
			ПерваяПрограммаПроверки = "";
			Для Каждого УзелПрограммаПроверки Из УзлыПрограммаПроверки Цикл
				АтрибутыУзлаПрограммаПроверки = ПолучитьАтрибутыУзла(УзелПрограммаПроверки);
				
				НовСтрТаблицыПрограммПроверки = ТаблицаПрограммПроверки.Добавить();
				НовСтрТаблицыПрограммПроверки.КодПрограммыПроверки = АтрибутыУзлаПрограммаПроверки.Код;
				Если АтрибутыУзлаПрограммаПроверки.Свойство("Наименование") Тогда
					НовСтрТаблицыПрограммПроверки.Наименование = АтрибутыУзлаПрограммаПроверки.Наименование;
				КонецЕсли;
				Если АтрибутыУзлаПрограммаПроверки.Свойство("Версия") Тогда
					НовСтрТаблицыПрограммПроверки.Версия = АтрибутыУзлаПрограммаПроверки.Версия;
				КонецЕсли;
				Если АтрибутыУзлаПрограммаПроверки.Свойство("ДатаВремяОбновления") Тогда
					НовСтрТаблицыПрограммПроверки.ДатаВремяОбновления = XMLЗначениеВнутр(Тип("Дата"), АтрибутыУзлаПрограммаПроверки.ДатаВремяОбновления);
				КонецЕсли;
				НовСтрТаблицыПрограммПроверки.ПредставлениеНаименования = Строка(НовСтрТаблицыПрограммПроверки.Наименование)
					+ ?(ЗначениеЗаполнено(НовСтрТаблицыПрограммПроверки.Наименование) И ЗначениеЗаполнено(НовСтрТаблицыПрограммПроверки.Версия), " ", "")
					+ ?(ЗначениеЗаполнено(НовСтрТаблицыПрограммПроверки.Версия), НСтр("ru = 'версия';
																						|en = 'version'") + " " + НовСтрТаблицыПрограммПроверки.Версия, "")
					+ ?((ЗначениеЗаполнено(НовСтрТаблицыПрограммПроверки.Наименование) ИЛИ ЗначениеЗаполнено(НовСтрТаблицыПрограммПроверки.Версия)) И ЗначениеЗаполнено(НовСтрТаблицыПрограммПроверки.ДатаВремяОбновления), " ", "")
					+ ?(ЗначениеЗаполнено(НовСтрТаблицыПрограммПроверки.ДатаВремяОбновления), НСтр("ru = 'от';
																									|en = 'dated'") + " " + Формат(НовСтрТаблицыПрограммПроверки.ДатаВремяОбновления, "ДЛФ=Д"), "");
				Если НЕ ЗначениеЗаполнено(ПерваяПрограммаПроверки) Тогда
					ПерваяПрограммаПроверки = НовСтрТаблицыПрограммПроверки.ПредставлениеНаименования;
				КонецЕсли;
			КонецЦикла;
			
			ПрограммыПроверки = ПоместитьВоВременноеХранилище(ТаблицаПрограммПроверки, Контекст.УникальныйИдентификатор);
			
			Результат.Вставить("ПрограммыПроверки", ПрограммыПроверки);
			Результат.Вставить("ПерваяПрограммаПроверки", ПерваяПрограммаПроверки);
			
		КонецЕсли;
		
		// загружаем из XML таблицу с детальной информацией о проверках каждого документа
		ПризнакиУпаковкиПротоколов = Новый Соответствие;
		УзлыДокумент = УзелОтвет.Строки.НайтиСтроки(Новый Структура("Имя", "Документ"));
		Если УзлыДокумент.Количество() > 0 Тогда
			
			ТаблицаРезультатовПоДокументам = Новый ТаблицаЗначений;
			ТаблицаРезультатовПоДокументам.Колонки.Добавить("ИмяФайлаОтчета");
			ТаблицаРезультатовПоДокументам.Колонки.Добавить("ИсходноеИмяФайлаПротокола");
