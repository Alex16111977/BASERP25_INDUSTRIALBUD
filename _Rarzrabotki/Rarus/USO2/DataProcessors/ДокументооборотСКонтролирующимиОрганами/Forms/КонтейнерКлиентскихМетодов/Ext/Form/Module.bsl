&НаСервереБезКонтекста
Функция ПолучитьТаблицуПрисоединенныхФайловСканДокумента(СканированныйДокументСсылка)

	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	СканированныеДокументыДляПередачиВЭлектронномВидеПрисоединенныеФайлы.Ссылка,
						  |	СканированныеДокументыДляПередачиВЭлектронномВидеПрисоединенныеФайлы.ИмяФайла
	                      |ИЗ
	                      |	Справочник.СканированныеДокументыДляПередачиВЭлектронномВидеПрисоединенныеФайлы КАК СканированныеДокументыДляПередачиВЭлектронномВидеПрисоединенныеФайлы
	                      |ГДЕ
	                      |	СканированныеДокументыДляПередачиВЭлектронномВидеПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла");
	Запрос.УстановитьПараметр("ВладелецФайла", СканированныйДокументСсылка);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ТаблицаФайлов = Новый ТаблицаЗначений;
	ТаблицаФайлов.Колонки.Добавить("ИмяФайла");
	ТаблицаФайлов.Колонки.Добавить("Данные");
	ТаблицаФайлов.Колонки.Добавить("Ссылка");
	
	Пока Выборка.Следующий() Цикл
		
		Данные = РаботаСФайлами.ДвоичныеДанныеФайла(Выборка.Ссылка);
		
		НоваяСтрока = ТаблицаФайлов.Добавить();
		НоваяСтрока.ИмяФайла 	= Выборка.ИмяФайла;
		НоваяСтрока.Данные		= Данные;
		НоваяСтрока.Ссылка		= Выборка.Ссылка;

	КонецЦикла;

	Возврат ТаблицаФайлов;

КонецФункции

&НаКлиенте
Функция ТребуетсяОсобыйСпособОтображения(ИмяФайла, ТипСодержимого)
	
	Если СтрНайти(ИмяФайла, "IU_SPISOB") Тогда
		Возврат Истина;
	ИначеЕсли (СтрНайти(ИмяФайла, "IU_AKTSVP_") ИЛИ СтрНайти(ИмяФайла, "IU_VO_") 
		ИЛИ СтрНайти(ИмяФайла, "IU_SPKR_") ИЛИ СтрНайти(ИмяФайла, "IU_PN_"))
		И ТипСодержимого = СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоФайлов_xml Тогда
		
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьКакТабличныйДокумент(ЗапросИОН, ИмяФайла, АдресФайла) Экспорт
	
	Если ВРег(ОбщегоНазначенияКлиентСервер.ПолучитьРасширениеИмениФайла(ИмяФайла)) = "XML" Тогда
		Если СтрНайти(ИмяФайла, "IU_SPISOB") Тогда
			
			Результат = СформироватьСправкуОбИсполненииНалогоплательщикомОбязанностиПоУплатеНалогов(ЗапросИОН, АдресФайла);
			НапечататьДокумент(Результат, НСтр("ru = 'Справка об исполнении обязанностей по уплате налогов';
												|en = 'Certificate of fulfillment of obligation to pay taxes'"));
			
		ИначеЕсли СтрНайти(ИмяФайла, "IU_AKTSVP_") Тогда
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ИмяФайла",   ИмяФайла);
			ДополнительныеПараметры.Вставить("АдресФайла", АдресФайла);
			ДополнительныеПараметры.Вставить("ЗапросИОН",  ЗапросИОН);
			 
			ОткрытьФорму(ПутьКОбъекту + ".Форма.ФормаАктаСверкиСФНС", ДополнительныеПараметры);
			
		ИначеЕсли СтрНайти(ИмяФайла, "IU_VO_") Тогда
			
			Результат = СформироватьВыпискуОпераций(ЗапросИОН, АдресФайла);
			НапечататьДокумент(Результат, НСтр("ru = 'Выписка операций по расчетам с бюджетом';
												|en = 'Statement of transactions of budget settlements'"));
			
		ИначеЕсли СтрНайти(ИмяФайла, "IU_SPKR_") Тогда
			
			Результат = СформироватьСправкуОСостоянииРасчетовСФНС(ЗапросИОН, АдресФайла);
			НапечататьДокумент(Результат, НСтр("ru = 'Справка о состоянии расчетов с ФНС';
												|en = 'Statement of settlements with FTS'"));
			
		ИначеЕсли СтрНайти(ИмяФайла, "IU_PN_") Тогда
			
			Результат = СформироватьСписокПредставленнойОтчетности(ЗапросИОН, АдресФайла);
			НапечататьДокумент(Результат, НСтр("ru = 'Список представленной отчетности';
												|en = 'Submitted reporting list'"));
			
		КонецЕсли;
	Иначе
		// Обход ошибки платформы, когда указано, что файл xml, но приложен pdf файл
		ОперацииСФайламиЭДКОКлиент.ОткрытьФайл(АдресФайла, ИмяФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьСписокПредставленнойОтчетности(ЗапросИОН, АдресФайла)
	
	// Получаем файл xml
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ПолучитьИзВременногоХранилища(АдресФайла).Записать(ИмяФайла);
	
	// Дессериализуем в XDTO
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайла);
	Справка = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();
	
	Документ  = Справка.Документ;
	Подписант = Документ.Подписант;
	КодНО     = Подписант.КодНО;
	НаимНО    = Подписант.НаимНО;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	МакетСправки = ПолучитьМакетОбработки("СписокПредставленнойОтчетности");

	ПеречНБО = СписокИзXDTO(Документ, "ПеречНБО");
	
	Количество = ПеречНБО.Количество();
	Счетчик    = 0;
	Для каждого СтрокаПеречНБО Из ПеречНБО Цикл
		
		Счетчик = Счетчик + 1;
		
		ОбластьШапка = МакетСправки.ПолучитьОбласть("Шапка");
		ОбластьШапка.Параметры.Заполнить(СтрокаПеречНБО);
		ОбластьШапка.Параметры.НаимНО = НаимНО;
		СвНП = СтрокаПеречНБО.СвНП;
		
		ДобавитьВСверкуПолучателя(ОбластьШапка, СвНП, "НПЮЛ", "НПФЛ");
		
		ОбластьШапка.Параметры.Адрес = ПредставлениеАдрРФСтрокой(СвНП.АдрРФ);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		ДокумНБО = СписокИзXDTO(СтрокаПеречНБО, "ДокумНБО");
		
		Если ДокумНБО = Неопределено Тогда
			
			ОбластьТЧ = МакетСправки.ПолучитьОбласть("ТЧ");
			ТабличныйДокумент.Вывести(ОбластьТЧ);
			
		Иначе
			
			Для каждого СтрДокумНБО Из ДокумНБО Цикл
				ОбластьТЧ = МакетСправки.ПолучитьОбласть("ТЧ");
				ОбластьТЧ.Параметры.Заполнить(СтрДокумНБО);
				
				// Чтобы формат выводился корректно
				СумДеклар = СвойствоXDTO(СтрДокумНБО, "СумДеклар");
				Если СумДеклар <> "" Тогда
					ОбластьТЧ.Параметры.СумДеклар = Число(СумДеклар);
				КонецЕсли;
				
				СумКРБ = СвойствоXDTO(СтрДокумНБО, "СумКРБ");
				Если СумКРБ <> "" Тогда
					ОбластьТЧ.Параметры.СумКРБ = Число(СумКРБ);
				КонецЕсли;
				
				ОбластьТЧ.Параметры.Отчет = НазваниеОтчетаПоКНД(СтрДокумНБО.КНД);
				
				ДобавитьОКАТО_ОКТМО(ОбластьТЧ, СтрДокумНБО);
				
				ТабличныйДокумент.Вывести(ОбластьТЧ);
			КонецЦикла;
			
			ОбластьПодпись = МакетСправки.ПолучитьОбласть("Подвал");
			ОбластьПодпись.Параметры.НаименованиеКодФНС = НаимНО + ", " +КодНО;
			
			ОбластьПодпись.Параметры.ВсегоДок = СтрокаПеречНБО.ОбобщДок.ВсегоДок;
			
			Всего_1    = 0;
			Всего_1_ЭК = 0;
			Всего_1_1  = 0;
			Всего_1_2  = 0;
			Всего_2    = 0;
			Всего_2_1  = 0;
			Всего_2_2  = 0;
			
			ВидПредДок = СписокИзXDTO(СтрокаПеречНБО.ОбобщДок, "ВидПредДок");
			Если ВидПредДок <> Неопределено Тогда
				Для каждого СтрВидПредДок Из ВидПредДок Цикл
					Код = СтрВидПредДок.КодПредДок;
					
					Если Код = "03" ИЛИ Код = "08" Тогда
						Всего_1_ЭК = Всего_1_ЭК + Число(СтрВидПредДок.КолПредДок);
					КонецЕсли;
					
					Если Код = "02" ИЛИ Код = "03" ИЛИ Код = "09" Тогда
						Всего_1_1 = Всего_1_1 + Число(СтрВидПредДок.КолПредДок);
					КонецЕсли;
					
					Если Код = "01" ИЛИ Код = "08" ИЛИ Код = "10" Тогда
						Всего_1_2 = Всего_1_2 + Число(СтрВидПредДок.КолПредДок);
					КонецЕсли;
					
					Если Код = "04" Тогда
						Всего_2_1 = Всего_2_1 + Число(СтрВидПредДок.КолПредДок);
					КонецЕсли;
					
					Если Код = "06" ИЛИ Код = "07" Тогда
						Всего_2_2 = Всего_2_2 + Число(СтрВидПредДок.КолПредДок);
					КонецЕсли;
					
				КонецЦикла;
				
				Всего_1 = Всего_1_1 + Всего_1_2;
				Всего_2 = Всего_2_1 + Всего_2_2;
				
			КонецЕсли;
			
			ОбластьПодпись.Параметры.Всего_1    = Всего_1;
			ОбластьПодпись.Параметры.Всего_1_ЭК = Всего_1_ЭК;
			ОбластьПодпись.Параметры.Всего_1_1  = Всего_1_1;
			ОбластьПодпись.Параметры.Всего_1_2  = Всего_1_2;
			ОбластьПодпись.Параметры.Всего_2    = Всего_2;
			ОбластьПодпись.Параметры.Всего_2_1  = Всего_2_1;
			ОбластьПодпись.Параметры.Всего_2_2  = Всего_2_2;
			
			ТабличныйДокумент.Вывести(ОбластьПодпись);
			
		КонецЕсли;
		
		Если Счетчик <> Количество Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
	КонецЦикла;
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	КонтекстЭДОСервер.ДобавитьШтампПодписиВРезультатЗапросаИОН(ЗапросИОН, ТабличныйДокумент, 3, Ложь);
	
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.НижнийКолонтитул.ТекстВЦентре = "[&НомерСтраницы]";
	ТабличныйДокумент.НижнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаСервереБезКонтекста
Функция НазваниеОтчетаПоКНД(КНД) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	МакетКНД = КонтекстЭДОСервер.ПолучитьМакет("ОписаниеФормДляИмпорта");
	ИдентификаторОтчета = "";
	Для Инд = 1 По МакетКНД.ВысотаТаблицы Цикл
		_КНД = СокрЛП(МакетКНД.Область(Инд, 1, Инд, 1).Текст);
		
		Если _КНД = КНД Тогда
			ИдентификаторОтчета = СокрЛП(МакетКНД.Область(Инд, 2, Инд, 2).Текст);
		КонецЕсли;
			
	КонецЦикла;
	
	Если ИдентификаторОтчета = "" Тогда
		Возврат КНД;
	Иначе
		МакетСписокДокументов = Справочники.ВидыОтправляемыхДокументов.ПолучитьМакет("ОписаниеВидовОтправляемыхДокументов");
		Для Ном = 1 По МакетСписокДокументов.ВысотаТаблицы Цикл
			_ИдентификаторОтчета = СокрЛП(МакетСписокДокументов.Область(Ном, 1, Ном, 1).Текст);
			
			Если _ИдентификаторОтчета = ИдентификаторОтчета Тогда
				НаименованиеОтчета = СокрЛП(МакетСписокДокументов.Область(Ном, 2, Ном, 2).Текст);
				Возврат НаименованиеОтчета;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат КНД;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьСправкуОСостоянииРасчетовСФНС(ЗапросИОН, АдресФайла) Экспорт
	
	// Получаем файл xml
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ПолучитьИзВременногоХранилища(АдресФайла).Записать(ИмяФайла);
	
	// Дессериализуем в XDTO
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайла);
	Справка = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();
	
	Документ  = Справка.Документ;
	Подписант = Документ.Подписант;
	КодНО     = Подписант.КодНО;
	НаимНО    = Подписант.НаимНО;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	МакетСправки = ПолучитьМакетОбработки("СправкаОСостоянииРасчетов");
	
	СвРасч = СписокИзXDTO(Документ, "СвРасч");
	
	Количество = СвРасч.Количество();
	Счетчик    = 0;
	Для каждого СтрокаСвРасч Из СвРасч Цикл
		Счетчик = Счетчик + 1;
		
		ОбластьШапка = МакетСправки.ПолучитьОбласть("Шапка");
		ОбластьШапка.Параметры.Заполнить(СтрокаСвРасч);
		
		СвНП = СтрокаСвРасч.СвНП;
		
		ДобавитьВСверкуПолучателя(ОбластьШапка, СвНП, "НПЮЛ", "НПФЛ");
		
		ОбластьШапка.Параметры.Адрес = ПредставлениеАдрРФСтрокой(СвНП.АдрРФ);
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		СвРасчВид = СписокИзXDTO(СтрокаСвРасч, "СвРасчВид");
		
		Если СвРасчВид = Неопределено Тогда
			
			ОбластьТЧ = МакетСправки.ПолучитьОбласть("ТЧ");
			ТабличныйДокумент.Вывести(ОбластьТЧ);
			
		Иначе
			
			Для каждого СтрСвРасчВид Из СвРасчВид Цикл
				ОбластьТЧ = МакетСправки.ПолучитьОбласть("ТЧ");
				ОбластьТЧ.Параметры.Заполнить(СтрСвРасчВид);
				
				ДобавитьОКАТО_ОКТМО(ОбластьТЧ, СтрСвРасчВид.КодОбр);
				
				ОбластьТЧ.Параметры.Заполнить(СтрСвРасчВид.СостСум.СостРасч);
				
				ТабличныйДокумент.Вывести(ОбластьТЧ);
			КонецЦикла;
			
		КонецЕсли;
		
		ОбластьПодпись = МакетСправки.ПолучитьОбласть("Подвал");
		ОбластьПодпись.Параметры.НаименованиеКодФНС = НаимНО + ", " +КодНО;
		ОбластьПодпись.Параметры.ФИО = ФИОИзТега(Подписант);
		ТабличныйДокумент.Вывести(ОбластьПодпись);
		
		Если Счетчик <> Количество Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
	КонецЦикла;
	
	КонтекстЭДОСервер = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	КонтекстЭДОСервер.ДобавитьШтампПодписиВРезультатЗапросаИОН(ЗапросИОН, ТабличныйДокумент, 3, Ложь);
	
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.НижнийКолонтитул.ТекстВЦентре = "[&НомерСтраницы]";
	ТабличныйДокумент.НижнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

