Функция СформироватьXMLПредставления_СвОтпрДок(УзелДокумент, ПараметрыОписи)
	
	// добавляем сведения об отправителе
	УзелСвОтпр = ДобавитьУзелXML(УзелДокумент, "СвОтпрДок");

	Если ПараметрыОписи.ПрПодп = 1 Тогда // отправитель - налогоплательщик
		
		Если НЕ ПараметрыОписи.ЭтоПБОЮЛ Тогда
			УзелОтпрЮЛ = ДобавитьУзелXML(УзелСвОтпр, "ОтпрЮЛ");
			ДобавитьУзелXML(УзелОтпрЮЛ, "НаимОрг", Истина, Лев(XMLСтрока(ПараметрыОписи.НаимЮЛПол), 1000));
			ДобавитьУзелXML(УзелОтпрЮЛ, "ИННЮЛ", Истина, XMLСтрока(ПараметрыОписи.ИННЮЛ));
			ДобавитьУзелXML(УзелОтпрЮЛ, "КПП", Истина, XMLСтрока(ПараметрыОписи.КППЮЛ));
		Иначе
			УзелОтпрФЛ = ДобавитьУзелXML(УзелСвОтпр, "ОтпрФЛ");
			ДобавитьУзелXML(УзелОтпрФЛ, "ИННФЛ", Истина, XMLСтрока(СокрЛП(ПараметрыОписи.ИННФЛ)), Истина);
			УзелФИО = ДобавитьУзелXML(УзелОтпрФЛ, "ФИО");
			ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыОписи.ИПФамилия)), 60));
			ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыОписи.ИПИмя)), 60));
			ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыОписи.ИПОтчество)), 60), Истина);
		КонецЕсли;
		
	Иначе // отправитель - представитель
		
		СвДоверенность = ПараметрыОписи.Доверенность;
		СвПредст = СвДоверенность.СвУпПред.СвПред;
		
		Если СвПредст.СведФизЛ.ЯвляетсяСотрудникомОрганизации Тогда
			Если НЕ ПараметрыОписи.ЭтоПБОЮЛ Тогда
				УзелОтпрЮЛ = ДобавитьУзелXML(УзелСвОтпр, "ОтпрЮЛ");
				ДобавитьУзелXML(УзелОтпрЮЛ, "НаимОрг", Истина, Лев(XMLСтрока(ПараметрыОписи.НаимЮЛПол), 1000));
				ДобавитьУзелXML(УзелОтпрЮЛ, "ИННЮЛ", Истина, XMLСтрока(ПараметрыОписи.ИННЮЛ));
				ДобавитьУзелXML(УзелОтпрЮЛ, "КПП", Истина, XMLСтрока(ПараметрыОписи.КППЮЛ));
			Иначе
				УзелОтпрФЛ = ДобавитьУзелXML(УзелСвОтпр, "ОтпрФЛ");
				ДобавитьУзелXML(УзелОтпрФЛ, "ИННФЛ", Истина, XMLСтрока(СокрЛП(ПараметрыОписи.ИННФЛ)), Истина);
				УзелФИО = ДобавитьУзелXML(УзелОтпрФЛ, "ФИО");
				ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыОписи.ИПФамилия)), 60));
				ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыОписи.ИПИмя)), 60));
				ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыОписи.ИПОтчество)), 60), Истина);
			КонецЕсли;
		Иначе	
			Если СвПредст.Свойство("СвОрг") Тогда // представитель - ЮЛ
				УзелОтпрЮЛ = ДобавитьУзелXML(УзелСвОтпр, "ОтпрЮЛ");
				ДобавитьУзелXML(УзелОтпрЮЛ, "НаимОрг", Истина, Лев(XMLСтрока(СокрЛП(СвПредст.СвОрг.НаимОрг)), 1000));
				ДобавитьУзелXML(УзелОтпрЮЛ, "ИННЮЛ", Истина, XMLСтрока(СвПредст.СвОрг.ИННЮЛ));
				ДобавитьУзелXML(УзелОтпрЮЛ, "КПП", Истина, XMLСтрока(СвПредст.СвОрг.КПП));
			Иначе
				УзелОтпрФЛ = ДобавитьУзелXML(УзелСвОтпр, "ОтпрФЛ");
				ДобавитьУзелXML(УзелОтпрФЛ, "ИННФЛ", Истина, XMLСтрока(СокрЛП(СвПредст.СведФизЛ.ИННФЛ)), Истина);
				ФИОПредставителя = СвПредст.СведФизЛ.ФИО;
				УзелФИО = ДобавитьУзелXML(УзелОтпрФЛ, "ФИО");
				ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ФИОПредставителя.Фамилия)), 60));
				ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ФИОПредставителя.Имя)), 60));
				ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ФИОПредставителя.Отчество)), 60), Истина);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

