#Область ОбменЛисткамиНетрудоспособностиСФСС

&НаКлиенте
Процедура ПолучитьДанныеЭЛНИзФСС(ВыполняемоеОповещение, ЗапросДляПолученияЭЛН) Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ОрганизацияСсылка", 		ЗапросДляПолученияЭЛН.Организация);
	Оповещение = Новый ОписаниеОповещения("ПолучитьДанныеЭЛНИзФССПослеПодписиSOAP", ЭтотОбъект, ДополнительныеПараметры);
	
	ВыгрузкаЗапросаОперацииСЭЛН = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ЗапросДляПолученияЭЛН);
	ВыгрузкаЗапросаОперацииСЭЛН.Вставить("ТекстЗапроса", ВыгрузкаЗапросаОперацииСЭЛН.ТекстXML);
	ВыгрузкаЗапросаОперацииСЭЛН.Удалить("ТекстXML");
	
	// Подписание запроса.
	АдресПодписанногоSOAPОперацииСЭЛНВФСС(
		Оповещение,
		ВыгрузкаЗапросаОперацииСЭЛН);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДанныеЭЛНИзФССПослеПодписиSOAP(АдресЗашифрованногоЗапросаSOAP, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	ОрганизацияСсылка 		= ДополнительныеПараметры.ОрганизацияСсылка;
	
	Если НЕ ЗначениеЗаполнено(АдресЗашифрованногоЗапросаSOAP) Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Состояние(НСтр("ru = 'Получение данных ЭЛН из ФСС...';
					|en = 'Receive ESLR data from SSF...'"));
	
	// Отправка запроса.
	АдресЗашифрованногоОтветаSOAP = ОтправитьЗапросСервисуФССЭЛННаСервере(
		ОрганизацияСсылка,
		"getPrivateLNData",
		АдресЗашифрованногоЗапросаSOAP);
	Если АдресЗашифрованногоОтветаSOAP = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПолучитьДанныеЭЛНИзФССПослеПроверкиПодписиSOAP", ЭтотОбъект, ДополнительныеПараметры);
	ПроверитьПодписьSOAPОтветаЭЛНВФСС(
		Оповещение,
		ОрганизацияСсылка,
		АдресЗашифрованногоОтветаSOAP);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДанныеЭЛНИзФССПослеПроверкиПодписиSOAP(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если Результат = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Если НЕ Результат.ПодписьВалидна Тогда
		// Выводим сообщение, но продолжаем обмен (данные-то мы получили).
		ТекстОшибки = НСтр("ru = 'Подпись ЭЛН недействительна.';
							|en = 'ESLR signature is invalid.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	
	Состояние(НСтр("ru = 'Получение данных ЭЛН из ФСС...';
					|en = 'Receive ESLR data from SSF...'"));
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВыгрузкуРеестраДанныхЭЛНВСервисФСС(ВыполняемоеОповещение, ВыгрузкаРеестраДанныхЭЛН) Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ОрганизацияСсылка", 		ВыгрузкаРеестраДанныхЭЛН.Организация);
	Оповещение = Новый ОписаниеОповещения("ОтправитьВыгрузкуРеестраДанныхЭЛНВСервисФССПослеПодписиSOAP",
		ЭтотОбъект, ДополнительныеПараметры);
	
	// Подписание реестра.
	АдресПодписанногоSOAPЗагрузкиЭЛНВФСС(
		Оповещение,
		ВыгрузкаРеестраДанныхЭЛН.Организация,
		ВыгрузкаРеестраДанныхЭЛН.РегистрационныйНомерФСС,
		ВыгрузкаРеестраДанныхЭЛН.ТекстXML);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВыгрузкуРеестраДанныхЭЛНВСервисФССПослеПодписиSOAP(АдресЗашифрованногоЗапросаSOAP, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	ОрганизацияСсылка 		= ДополнительныеПараметры.ОрганизацияСсылка;
	
	Если НЕ ЗначениеЗаполнено(АдресЗашифрованногоЗапросаSOAP) Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Состояние(НСтр("ru = 'Отправка реестра ЭЛН в ФСС...';
					|en = 'Sending ESLR registry to SSF...'"));
	
	// Отправка реестра.
	АдресЗашифрованногоОтветаSOAP = ОтправитьЗапросСервисуФССЭЛННаСервере(
		ОрганизацияСсылка,
		"prParseReestrFile",
		АдресЗашифрованногоЗапросаSOAP);
	Если АдресЗашифрованногоОтветаSOAP = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ОтправитьВыгрузкуРеестраДанныхЭЛНВСервисФССПослеПроверкиПодписиSOAP",
		ЭтотОбъект, ДополнительныеПараметры);
	ПроверитьПодписьSOAPОтветаЭЛНВФСС(
		Оповещение,
		ОрганизацияСсылка,
		АдресЗашифрованногоОтветаSOAP);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВыгрузкуРеестраДанныхЭЛНВСервисФССПослеПроверкиПодписиSOAP(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если Результат = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Если НЕ Результат.ПодписьВалидна Тогда
		// Выводим сообщение, но продолжаем обмен (данные-то мы получили).
		ТекстОшибки = НСтр("ru = 'Подпись результатов отправки недействительна.';
							|en = 'Signature of sending results is invalid.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	
	Состояние(НСтр("ru = 'Отправка реестра ЭЛН в ФСС...';
					|en = 'Sending ESLR registry to SSF...'"));
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправитьЗапросСервисуФССЭЛННаСервере(
		ЗНАЧ Организация,
		ЗНАЧ Операция,
		ЗНАЧ АдресЗашифрованногоЗапросаSOAP)
	
	КонтекстЭДО = ДокументооборотСКОВызовСервера.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДО.ОтправитьЗапросСервисуФССЭЛН(
		Организация,
		Операция,
		АдресЗашифрованногоЗапросаSOAP);
	
КонецФункции

#КонецОбласти

#Область ОтправкаПодтвержденияВидаДеятельностиФСС

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСОКВЭДВФСС(
		ВыполняемоеОповещение,
		ВыгрузкаЗапросаОперации,
		НастройкиОперации = Неопределено) Экспорт
	
	НастройкиВызова = Новый Структура;
	НастройкиВызова.Вставить("ЗашифроватьSOAP", 					Истина);
	НастройкиВызова.Вставить("ЭтоИсключающаяКанонизация", 			Истина);
	НастройкиВызова.Вставить("ПроверкиИАвтонастройкаВыполнены", 	Ложь);
	НастройкиВызова.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", Неопределено);
	НастройкиВызова.Вставить("СертификатСтрахователя", 				Неопределено);
	НастройкиВызова.Вставить("СертификатФСС", 						Неопределено);
	НастройкиВызова.Вставить("ОтправкаСсылка", 						Неопределено);
	Если НастройкиОперации <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НастройкиВызова, НастройкиОперации);
	КонецЕсли;
	
	Если НЕ НастройкиВызова.ПроверкиИАвтонастройкаВыполнены Тогда
		ОбъектСсылка = ?(ЗначениеЗаполнено(ВыгрузкаЗапросаОперации.Организация),
			ВыгрузкаЗапросаОперации.Организация, НастройкиВызова.ОтправкаСсылка);
		Свойства = ПолучитьСвойстваОбъектаДляФСС(ОбъектСсылка);
		
		ВыгрузкаЗапросаОперации.Организация 				= Свойства.ОрганизацияСсылка;
		НастройкиВызова.ЭтоЭлектроннаяПодписьВМоделиСервиса = Свойства.ЭтоЭлектроннаяПодписьВМоделиСервиса;
		ОрганизацияИспользуетОбменСФСС 						= Свойства.ОрганизацияИспользуетОбменСФСС;
		ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи 	= Свойства.ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи;
		НастроенОбменВУниверсальномФормате 					= Свойства.НастроенОбменВУниверсальномФормате;
		УчетнаяЗаписьДокументооборота 						= Свойства.УчетнаяЗаписьДокументооборота;
		
		Если НЕ ОрганизацияИспользуетОбменСФСС Тогда
			Если НЕ НастроенОбменВУниверсальномФормате Тогда
				ТекстСообщения = НСтр("ru = 'Для организации не включена возможность отправки';
										|en = 'Sending option is not enabled for the company'");
			Иначе
				ТекстСообщения = НСтр("ru = 'Для организации не включена возможность отправки в ФСС';
										|en = 'Sending to SSF is not enabled for the company'");
			КонецЕсли;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ВыгрузкаЗапросаОперации", ВыгрузкаЗапросаОперации);
	ДополнительныеПараметры.Вставить("НастройкиВызова", 		НастройкиВызова);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеАвтонастройкиУчетнойЗаписи",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если НЕ НастройкиВызова.ПроверкиИАвтонастройкаВыполнены И НастроенОбменВУниверсальномФормате
		И ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи Тогда
		
		АвтоматическаяНастройкаУчетнойЗаписи(
			УчетнаяЗаписьДокументооборота,,
			Оповещение,,,
			Истина);
		
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСвойстваОбъектаДляФСС(ОбъектСсылка)
	
	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.ОтправкиФСС") Тогда
		ОрганизацияСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектСсылка, "Организация");
	Иначе
		ОрганизацияСсылка = ОбъектСсылка;
	КонецЕсли;
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияСсылка);
	ЭтоЭлектроннаяПодписьВМоделиСервиса = РеквизитыУчетнойЗаписи.ЭлектроннаяПодписьВМоделиСервиса;
	
	ОрганизацияИспользуетОбменСФСС 		= Ложь;
	ОрганизацияИспользуетАвтонастройку 	= Ложь;
	НастроенОбменВУниверсальномФормате 	= Ложь;
	УчетнаяЗаписьДокументооборота 		= Неопределено;
	
	ПолучитьСвойстваОрганизацииДляФССНаСервере(
		ОрганизацияСсылка,
		НастроенОбменВУниверсальномФормате,
		ОрганизацияИспользуетОбменСФСС,
		ОрганизацияИспользуетАвтонастройку,
		УчетнаяЗаписьДокументооборота);
	
	Результат = Новый Структура;
	Результат.Вставить("ОрганизацияСсылка", 								ОрганизацияСсылка);
	Результат.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", 				ЭтоЭлектроннаяПодписьВМоделиСервиса);
	Результат.Вставить("ОрганизацияИспользуетОбменСФСС", 					ОрганизацияИспользуетОбменСФСС);
	Результат.Вставить("ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи", ОрганизацияИспользуетАвтонастройку);
	Результат.Вставить("НастроенОбменВУниверсальномФормате", 				НастроенОбменВУниверсальномФормате);
	Результат.Вставить("УчетнаяЗаписьДокументооборота", 					УчетнаяЗаписьДокументооборота);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеАвтонастройкиУчетнойЗаписи(Результат, ДополнительныеПараметры) Экспорт
	
	ВыгрузкаЗапросаОперации = ДополнительныеПараметры.ВыгрузкаЗапросаОперации;
	НастройкиВызова 		= ДополнительныеПараметры.НастройкиВызова;
	
	ИнформацияОСертификатахФСС = ИнформацияОСертификатахФССНаСервере(
		НастройкиВызова.ЭтоЭлектроннаяПодписьВМоделиСервиса,
		Истина);
	
	ДополнительныеПараметры.Вставить("ИнформацияОСертификатахФСС", ИнформацияОСертификатахФСС);
	
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеУстановкиСертификатаФССЭЛН",
		ЭтотОбъект, ДополнительныеПараметры);
	
	УстанавливаемыеСертификаты = Новый Массив;
	
	СертификатКорневогоУЦ = Новый Структура;
	СертификатКорневогоУЦ.Вставить("Отпечаток", ИнформацияОСертификатахФСС.КорневойСертификатУЦГОСТ2012Отпечаток);
	СертификатКорневогоУЦ.Вставить("Данные", ИнформацияОСертификатахФСС.КорневойСертификатУЦГОСТ2012Данные);
	СертификатКорневогоУЦ.Вставить("Хранилище", "ROOT");
	УстанавливаемыеСертификаты.Добавить(СертификатКорневогоУЦ);
	
	СертификатУЦ = Новый Структура;
	СертификатУЦ.Вставить("Отпечаток", ИнформацияОСертификатахФСС.ФСССертификатУЦГОСТ2012Отпечаток);
	СертификатУЦ.Вставить("Данные", ИнформацияОСертификатахФСС.ФСССертификатУЦГОСТ2012Данные);
	СертификатУЦ.Вставить("Хранилище", "CA");
	УстанавливаемыеСертификаты.Добавить(СертификатУЦ);
	
	СертификатФССЭЛН = Новый Структура;
	СертификатФССЭЛН.Вставить("Отпечаток", ИнформацияОСертификатахФСС.ФССЭЛНСертификатГОСТ2012Отпечаток);
	СертификатФССЭЛН.Вставить("Данные", ИнформацияОСертификатахФСС.ФССЭЛНСертификатГОСТ2012Данные);
	СертификатФССЭЛН.Вставить("Хранилище", "AddressBook");
	УстанавливаемыеСертификаты.Добавить(СертификатФССЭЛН);
	
	УстановитьСертификаты(
		Оповещение,
		УстанавливаемыеСертификаты,
		НастройкиВызова.ЭтоЭлектроннаяПодписьВМоделиСервиса);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеУстановкиСертификатаФССЭЛН(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 		= ДополнительныеПараметры.ВыполняемоеОповещение;
	ВыгрузкаЗапросаОперации 	= ДополнительныеПараметры.ВыгрузкаЗапросаОперации;
	НастройкиВызова 			= ДополнительныеПараметры.НастройкиВызова;
	ИнформацияОСертификатахФСС 	= ДополнительныеПараметры.ИнформацияОСертификатахФСС;
	
	ПространствоИменЗапроса = "http://ru/fss/ws/gtw/openservice";
	ПространствоИменXMLDSig = "http://www.w3.org/2000/09/xmldsig#";
	ДобавляемыйАтрибутКонверта = "xmlns:s=""http://schemas.xmlsoap.org/soap/envelope/""";
	ДобавляемыйАтрибутXMLDSig = "xmlns:ds=""" + ПространствоИменXMLDSig + """";
	ДобавляемыйАтрибутOASIS =
		"xmlns:wsu=""http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd""";
	ДобавляемыйАтрибутБезопасностьOASIS =
		"xmlns:wsse=""http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd""";
	ДобавляемыеАтрибутыПодписи = "xmlns=""" + ПространствоИменXMLDSig + """";
	Если НастройкиВызова.ЭтоИсключающаяКанонизация Тогда
		ДобавляемыеАтрибутыЗапроса = ДобавляемыйАтрибутКонверта
			+ " " + ДобавляемыйАтрибутOASIS;
		ДобавляемыеАтрибутыКонверта = ДобавляемыйАтрибутКонверта
			+ " " + ДобавляемыйАтрибутXMLDSig
			+ " " + ДобавляемыйАтрибутБезопасностьOASIS
			+ " " + ДобавляемыйАтрибутOASIS;
		ДобавляемыеАтрибутыБезопасности = ДобавляемыйАтрибутБезопасностьOASIS;
		ДобавляемыеАтрибутыПодписиИЗаписи = ДобавляемыеАтрибутыПодписи;
	Иначе
		ДобавляемыеАтрибутыЗапроса = ДобавляемыйАтрибутXMLDSig
			+ " xmlns:fil=""" + ПространствоИменЗапроса + """"
			+ " " + ДобавляемыйАтрибутКонверта
			+ " " + ДобавляемыйАтрибутБезопасностьOASIS
			+ " " + ДобавляемыйАтрибутOASIS;
		ДобавляемыеАтрибутыКонверта = ДобавляемыеАтрибутыЗапроса;
		ДобавляемыеАтрибутыБезопасности = "";
		ДобавляемыеАтрибутыПодписиИЗаписи = ДобавляемыеАтрибутыПодписи
			+ ?(ДобавляемыеАтрибутыПодписи <> "" И ДобавляемыеАтрибутыЗапроса <> "", " ", "")
			+ ДобавляемыеАтрибутыЗапроса;
	КонецЕсли;
	
	Если Лев(ВыгрузкаЗапросаОперации.ТекстЗапроса, 39) = "<?xml version=""1.0"" encoding=""utf-8""?>" + Символы.ПС Тогда
		ВыгрузкаЗапросаОперации.ТекстЗапроса = Сред(ВыгрузкаЗапросаОперации.ТекстЗапроса, 40);
		ВыгрузкаЗапросаОперации.ТекстЗапроса = СокрЛ(ВыгрузкаЗапросаОперации.ТекстЗапроса);
	КонецЕсли;
	ВыгрузкаЗапросаОперации.ТекстЗапроса = УдалитьПустоеПространствоМеждуУзлами(ВыгрузкаЗапросаОперации.ТекстЗапроса);
	СкорректированнаяВыгрузкаЗапроса = СкорректироватьВыгрузкуЗапросаОперацииДляSOAP(
		ВыгрузкаЗапросаОперации.ТекстЗапроса,
		ПространствоИменЗапроса);
	СкорректированнаяВыгрузкаЗапросаОперации = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ВыгрузкаЗапросаОперации);
	СкорректированнаяВыгрузкаЗапросаОперации.ТекстЗапроса = СкорректированнаяВыгрузкаЗапроса;
	
	СертификатыИзвестны = НастройкиВызова.СертификатСтрахователя <> Неопределено
		ИЛИ НастройкиВызова.СертификатФСС <> Неопределено;
	
	РезультатИнициализации = АдресПодписанногоSOAPОперацииСОКВЭДВФССИнициализацияНаСервере(
		ВыгрузкаЗапросаОперации.Организация,
		СкорректированнаяВыгрузкаЗапросаОперации,
		ДобавляемыеАтрибутыЗапроса,
		НастройкиВызова.ЗашифроватьSOAP,
		НастройкиВызова.ЭтоЭлектроннаяПодписьВМоделиСервиса,
		НЕ СертификатыИзвестны,
		НастройкиВызова.ЭтоИсключающаяКанонизация);
	
	Если РезультатИнициализации = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ЗапросОперации64 = РезультатИнициализации.ЗапросОперации64;
	
	ЭтоЭлектроннаяПодписьВМоделиСервиса = РезультатИнициализации.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	
	Если СертификатыИзвестны Тогда
		СертификатСтрахователя 		= НастройкиВызова.СертификатСтрахователя;
		СертификатФССЭЛНОтпечаток 	= Неопределено;
		СертификатФССЭЛН 			= НастройкиВызова.СертификатФСС;
		
	Иначе
		СертификатСтрахователяОтпечаток = РезультатИнициализации.СертификатСтрахователяОтпечаток;
		СертификатСтрахователя 			= РезультатИнициализации.СертификатСтрахователя;
		СертификатФССЭЛНОтпечаток 		= РезультатИнициализации.СертификатФССЭЛНОтпечаток;
		СертификатФССЭЛН 				= РезультатИнициализации.СертификатФССЭЛН;
	КонецЕсли;
	
	ЗаменитьСертификатФССЭЛННаГОСТ2012(
		ИнформацияОСертификатахФСС,
		ЭтоЭлектроннаяПодписьВМоделиСервиса,
		СертификатФССЭЛНОтпечаток,
		СертификатФССЭЛН);
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		МассивАдресовДанныхСертификатов = Новый Массив;
		Для каждого ИнформацияОСертификатеФСС Из ИнформацияОСертификатахФСС Цикл
			Если Прав(ИнформацияОСертификатеФСС.Ключ, 6) = "Данные" И ИнформацияОСертификатеФСС.Значение <> Неопределено Тогда
				МассивАдресовДанныхСертификатов.Добавить(ИнформацияОСертификатеФСС.Значение);
			КонецЕсли;
		КонецЦикла;
		УдалитьАдресаИзВременногоХранилища(МассивАдресовДанныхСертификатов);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РегистрационныйНомерФСС", 			РезультатИнициализации.РегистрационныйНомерФСС);
	ДополнительныеПараметры.Вставить("ОГРН", 								РезультатИнициализации.ОГРН);
	ДополнительныеПараметры.Вставить("Организация", 						ВыгрузкаЗапросаОперации.Организация);
	ДополнительныеПараметры.Вставить("ВыгрузкаЗапроса", 					СкорректированнаяВыгрузкаЗапроса);
	ДополнительныеПараметры.Вставить("СертификатСтрахователя", 				СертификатСтрахователя);
	ДополнительныеПараметры.Вставить("СертификатФССЭЛНОтпечаток", 			СертификатФССЭЛНОтпечаток);
	ДополнительныеПараметры.Вставить("СертификатФССЭЛН", 					СертификатФССЭЛН);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 				ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("НастройкиВызова", 					НастройкиВызова);
	ДополнительныеПараметры.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыЗапроса", 			ДобавляемыеАтрибутыЗапроса);
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыКонверта", 		ДобавляемыеАтрибутыКонверта);
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыБезопасности", 	ДобавляемыеАтрибутыБезопасности);
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыПодписи", 			ДобавляемыеАтрибутыПодписи);
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыПодписиИЗаписи", 	ДобавляемыеАтрибутыПодписиИЗаписи);
	ДополнительныеПараметры.Вставить("ЗапросОперации64", 					ЗапросОперации64);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеПоискаСертификатаСтрахователя",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если СертификатыИзвестны ИЛИ ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден, СвойстваСертификата",
			Истина, Неопределено, Истина, СертификатСтрахователя);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, СертификатСтрахователяОтпечаток, "MY");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьСертификатФССЭЛННаГОСТ2012(
		ИнформацияОСертификатахФСС,
		ЭтоЭлектроннаяПодписьВМоделиСервиса,
		СертификатФССЭЛНОтпечаток,
		СертификатФССЭЛН)
	
	Если СертификатФССЭЛНОтпечаток = ИнформацияОСертификатахФСС.ФССЭЛНСертификатОтпечаток Тогда
		СертификатФССЭЛНОтпечаток = ИнформацияОСертификатахФСС.ФССЭЛНСертификатГОСТ2012Отпечаток;
		
	ИначеЕсли СертификатФССЭЛНОтпечаток = ИнформацияОСертификатахФСС.ФССЭЛНТестовыйСертификатОтпечаток Тогда
		СертификатФССЭЛНОтпечаток = ИнформацияОСертификатахФСС.ФССЭЛНТестовыйСертификатГОСТ2012Отпечаток;
	КонецЕсли;
	
	Если СертификатФССЭЛН <> Неопределено
		И СертификатФССЭЛН.Отпечаток = ИнформацияОСертификатахФСС.ФССЭЛНСертификатОтпечаток Тогда
		
		СертификатФССЭЛН = Новый Структура;
		СертификатФССЭЛН.Вставить("Отпечаток", ИнформацияОСертификатахФСС.ФССЭЛНСертификатГОСТ2012Отпечаток);
		СертификатФССЭЛН.Вставить("ДействителенС", '20181008120728');
		СертификатФССЭЛН.Вставить("ДействителенПо", '20191008121728');
		СертификатФССЭЛН.Вставить("СерийныйНомер", "00 c4 75 0d 5b 11 e4 db 80 e8 11 f4 ca b7 4f a0 1e");
		СертификатФССЭЛН.Вставить("Поставщик", "C=RU,CN=ФГБУ НИИ «Восход»,E=uc@voskhod.ru,L=г. Москва,O=ФГБУ НИИ «Восход»,"
			+ "OID1_2_643_100_1=1167746289248,OID1_2_643_3_131_1_1=007729498813,OID1_2_840_113549_1_9_1=uc@voskhod.ru,"
			+ "OID2_5_4_10=ФГБУ НИИ «Восход»,OID2_5_4_3=ФГБУ НИИ «Восход»,OID2_5_4_6=RU,OID2_5_4_7=г. Москва,"
			+ "OID2_5_4_8=77 Москва,OID2_5_4_9=улица Удальцова, дом 85,ST=77 Москва,Street=улица Удальцова, дом 85");
		Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
			ДанныеСертификата = ПолучитьИзВременногоХранилища(ИнформацияОСертификатахФСС.ФССЭЛНСертификатГОСТ2012Данные);
			СертификатФССЭЛН.Вставить("Сертификат", ДанныеСертификата);
			СертификатФССЭЛН.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", Истина);
		Иначе
			СертификатФССЭЛН.Вставить("Хранилище", "ADDRESSBOOK");
		КонецЕсли;
		
	ИначеЕсли СертификатФССЭЛН <> Неопределено
		И СертификатФССЭЛН.Отпечаток = ИнформацияОСертификатахФСС.ФССЭЛНТестовыйСертификатОтпечаток Тогда
		
		СертификатФССЭЛН = Новый Структура;
		СертификатФССЭЛН.Вставить("Отпечаток", ИнформацияОСертификатахФСС.ФССЭЛНТестовыйСертификатГОСТ2012Отпечаток);
		СертификатФССЭЛН.Вставить("ДействителенС", '20181008120558');
		СертификатФССЭЛН.Вставить("ДействителенПо", '20191008121558');
		СертификатФССЭЛН.Вставить("СерийныйНомер", "00 c4 75 0d 5b 11 e4 db 80 e8 11 f3 ca e9 fc 45 e5");
		СертификатФССЭЛН.Вставить("Поставщик", "C=RU,CN=ФГБУ НИИ «Восход»,E=uc@voskhod.ru,L=г. Москва,"
			+ "O=ФГБУ НИИ «Восход»,OID1_2_643_100_1=1167746289248,OID1_2_643_3_131_1_1=007729498813,"
			+ "OID1_2_840_113549_1_9_1=uc@voskhod.ru,OID2_5_4_10=ФГБУ НИИ «Восход»,OID2_5_4_3=ФГБУ НИИ «Восход»,"
			+ "OID2_5_4_6=RU,OID2_5_4_7=г. Москва,OID2_5_4_8=77 Москва,OID2_5_4_9=улица Удальцова, дом 85,ST=77 Москва,"
			+ "Street=улица Удальцова, дом 85");
		Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
			ДанныеСертификата = ПолучитьИзВременногоХранилища(ИнформацияОСертификатахФСС.ФССЭЛНТестовыйСертификатГОСТ2012Данные);
			СертификатФССЭЛН.Вставить("Сертификат", ДанныеСертификата);
			СертификатФССЭЛН.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", Истина);
		Иначе
			СертификатФССЭЛН.Вставить("Хранилище", "ADDRESSBOOK");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УдалитьПустоеПространствоМеждуУзлами(ТекстXML)
	
	МассивРезультатов = Новый Массив;
	
	ПозицияНачала = 1;
	ДлинаТекстаXML = СтрДлина(ТекстXML);
	Для ПозицияСимвола = 1 По ДлинаТекстаXML Цикл
		СимволXML = Сред(ТекстXML, ПозицияСимвола, 1);
		Если СимволXML = "<" Тогда
			ТекстМеждуУзлами = Сред(ТекстXML, ПозицияНачала, ПозицияСимвола - ПозицияНачала);
			ТекстМеждуУзлами = СокрЛП(ТекстМеждуУзлами);
			МассивРезультатов.Добавить(ТекстМеждуУзлами);
			ПозицияНачала = ПозицияСимвола;
			
		ИначеЕсли СимволXML = ">" Тогда
			ТекстУзла = Сред(ТекстXML, ПозицияНачала, ПозицияСимвола - ПозицияНачала + 1);
			МассивРезультатов.Добавить(ТекстУзла);
			ПозицияНачала = ПозицияСимвола + 1;
		КонецЕсли;
	КонецЦикла;
	
	ТекстМеждуУзлами = Сред(ТекстXML, ПозицияНачала, ДлинаТекстаXML - ПозицияНачала + 1);
	ТекстМеждуУзлами = СокрЛП(ТекстМеждуУзлами);
	МассивРезультатов.Добавить(ТекстМеждуУзлами);
	
	Результат = СтрСоединить(МассивРезультатов);
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция АдресПодписанногоSOAPОперацииСОКВЭДВФССИнициализацияНаСервере(
		Знач ОрганизацияСсылка,
		Знач ВыгрузкаЗапросаОперации,
		Знач ДобавляемыеАтрибутыЗапроса,
		Знач ПолучитьСертификатФССЭЛН = Ложь,
		Знач ЭтоЭлектроннаяПодписьВМоделиСервиса = Неопределено,
		Знач ВозвращатьСертификаты = Истина,
		Знач ЭтоИсключающаяКанонизация = Ложь)
	
	СвойстваОрганизации = СвойстваОрганизацииДляОбмена(
		ОрганизацияСсылка,
		Ложь,
		НЕ ЗначениеЗаполнено(ВыгрузкаЗапросаОперации.ОГРН));
	
	Результат = Новый Структура;
	Результат.Вставить("РегистрационныйНомерФСС", 	Неопределено);
	Результат.Вставить("ОГРН", 						Неопределено);
	
	Результат.РегистрационныйНомерФСС = ?(СвойстваОрганизации.Свойство("РегистрационныйНомерФСС"),
		СвойстваОрганизации.РегистрационныйНомерФСС, ВыгрузкаЗапросаОперации.РегистрационныйНомерФСС);
	Результат.ОГРН = ?(СвойстваОрганизации.Свойство("ОГРН"),
		СвойстваОрганизации.ОГРН, ВыгрузкаЗапросаОперации.ОГРН);
	
	ЗапросОперации64 = ЗапросОперацииСОКВЭДВФССДляПодписиSOAP64НаСервере(
		ВыгрузкаЗапросаОперации.ТекстЗапроса,
		ДобавляемыеАтрибутыЗапроса,
		Результат,
		ЭтоИсключающаяКанонизация);
	Если ЗапросОперации64 = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Подтверждение вида деятельности не заполнено';
															|en = 'Activity category confirmation is not filled in'"));
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса = Неопределено ИЛИ ВозвращатьСертификаты Тогда
		РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияСсылка);
		ЭтоЭлектроннаяПодписьВМоделиСервиса = РеквизитыУчетнойЗаписи.ЭлектроннаяПодписьВМоделиСервиса;
	КонецЕсли;
	Если ВозвращатьСертификаты Тогда
		УчетнаяЗапись = РеквизитыУчетнойЗаписи.Ссылка;
		ИдентификаторДокументооборота = РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота;
	КонецЕсли;
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		ДвоичныеДанныеЗапросаОперации = Base64Значение(ЗапросОперации64);
		ЗапросОперации64 = ПоместитьВоВременноеХранилище(ДвоичныеДанныеЗапросаОперации, Новый УникальныйИдентификатор);
	КонецЕсли;
	
	Если ВозвращатьСертификаты Тогда
		ОтпечаткиСертификатов = ПолучитьОтпечаткиСертификатовИзНастроекОрганизацииДляФССНаСервере(ОрганизацияСсылка);
		Если ОтпечаткиСертификатов = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток) Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				НСтр("ru = 'Не выбран сертификат страхователя в настройках обмена с ФСС для 1С-Отчетности';
					|en = 'Insurant certificate is not selected in the exchange with SSF settings for 1C Reporting'"));
			Возврат Неопределено;
		КонецЕсли;
		Если ПолучитьСертификатФССЭЛН И НЕ ЗначениеЗаполнено(ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток) Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				НСтр("ru = 'Не выбран сертификат ФСС ЭЛН в настройках обмена с ФСС для 1С-Отчетности';
					|en = 'ESLR SSF certificate is not selected in the exchange with SSF settings for 1C Reporting'"));
			Возврат Неопределено;
		КонецЕсли;
		
		СертификатСтрахователя = Неопределено;
		СертификатФССЭЛН = Неопределено;
		Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
			СертификатСтрахователя = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток);
			Если СертификатСтрахователя = Неопределено Тогда
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не найден сертификат страхователя';
																	|en = 'Insurant certificate not found'"));
				Возврат Неопределено;
			КонецЕсли;
			
			СертификатСтрахователя.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", ЭтоЭлектроннаяПодписьВМоделиСервиса);
			СертификатСтрахователя.Вставить("КлючевойКонтейнер", ИдентификаторДокументооборота);
			
			Если ПолучитьСертификатФССЭЛН Тогда
				СертификатФССЭЛН = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток);
				Если СертификатФССЭЛН = Неопределено Тогда
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не найден сертификат ФСС ЭЛН';
																		|en = 'ESLR SSF certificate is not found'"));
					Возврат Неопределено;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Результат.Вставить("ЗапросОперации64", 						ЗапросОперации64);
	Результат.Вставить("ЭтоЭлектроннаяПодписьВМоделиСервиса", 	ЭтоЭлектроннаяПодписьВМоделиСервиса);
	Если ВозвращатьСертификаты Тогда
		Результат.Вставить("СертификатСтрахователяОтпечаток", 	ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток);
		Результат.Вставить("СертификатСтрахователя", 			СертификатСтрахователя);
		Результат.Вставить("СертификатФССЭЛНОтпечаток", 		ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток);
		Результат.Вставить("СертификатФССЭЛН", 					СертификатФССЭЛН);
		Результат.Вставить("ТестовыйСерверФССЭЛН", 				ОтпечаткиСертификатов.ТестовыйСерверФССЭЛН);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция СвойстваОрганизацииДляОбмена(
		ОрганизацияСсылка,
		ПолучитьРегистрационныйНомерФСС = Истина,
		ПолучитьОГРН = Ложь)
	
	Результат = Новый Структура;
	
	РегистрационныйНомерФСС = Неопределено;
	Если ПолучитьРегистрационныйНомерФСС
		И Метаданные.Справочники.Организации.Реквизиты.Найти("ДополнительныйКодФСС") <> Неопределено Тогда
		
		РегистрационныйНомерФСС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОрганизацияСсылка, "ДополнительныйКодФСС");
	КонецЕсли;
	
	ДанныеОрганизации = Неопределено;
	Если ПолучитьРегистрационныйНомерФСС И НЕ ЗначениеЗаполнено(РегистрационныйНомерФСС) ИЛИ ПолучитьОГРН Тогда
		СписокПоказателей = ?(ПолучитьОГРН, "ОГРН", "")
			+ ?(ПолучитьОГРН И ПолучитьРегистрационныйНомерФСС И НЕ ЗначениеЗаполнено(РегистрационныйНомерФСС), ", ", "")
			+ ?(ПолучитьРегистрационныйНомерФСС И НЕ ЗначениеЗаполнено(РегистрационныйНомерФСС),
			"РегистрационныйНомерФСС, РегистрационныйНомерФССДобрСтрах", "");
		ДанныеОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(
			ОрганизацияСсылка,,
			СписокПоказателей);
		
		Если ПолучитьРегистрационныйНомерФСС И НЕ ЗначениеЗаполнено(РегистрационныйНомерФСС) Тогда
			РегистрационныйНомерФСС = ?(ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЭтоЮрЛицо(
				ОрганизацияСсылка) ИЛИ РегламентированнаяОтчетность.ИПИспользуетТрудНаемныхРаботников(ОрганизацияСсылка),
				ДанныеОрганизации.РегистрационныйНомерФСС,
				ДанныеОрганизации.РегистрационныйНомерФССДобрСтрах);
		КонецЕсли;
	КонецЕсли;
	
	Если ПолучитьРегистрационныйНомерФСС Тогда
		Результат.Вставить("РегистрационныйНомерФСС", РегистрационныйНомерФСС);
	КонецЕсли;
	
	Если ПолучитьОГРН Тогда
		Результат.Вставить("ОГРН", ДанныеОрганизации.ОГРН);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеПоискаСертификатаСтрахователя(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатФССЭЛНОтпечаток 			= ДополнительныеПараметры.СертификатФССЭЛНОтпечаток;
	СертификатФССЭЛН 					= ДополнительныеПараметры.СертификатФССЭЛН;
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	НастройкиВызова 					= ДополнительныеПараметры.НастройкиВызова;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатыИзвестны = НастройкиВызова.СертификатСтрахователя <> Неопределено
		ИЛИ НастройкиВызова.СертификатФСС <> Неопределено;
	
	СертификатСтрахователя = ?(Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	ДополнительныеПараметры.Вставить("СертификатСтрахователя", СертификатСтрахователя);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеПоискаСертификатаФССЭЛН",
		ЭтотОбъект, ДополнительныеПараметры);
	Если СертификатыИзвестны ИЛИ ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден, СвойстваСертификата",
			Истина, Неопределено, НастройкиВызова.ЗашифроватьSOAP, СертификатФССЭЛН);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, СертификатФССЭЛНОтпечаток, "AddressBook");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеПоискаСертификатаФССЭЛН(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатСтрахователя 				= ДополнительныеПараметры.СертификатСтрахователя;
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	НастройкиВызова 					= ДополнительныеПараметры.НастройкиВызова;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатыИзвестны = НастройкиВызова.СертификатСтрахователя <> Неопределено
		ИЛИ НастройкиВызова.СертификатФСС <> Неопределено;
	
	СертификатФССЭЛН = ?(Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	СертификатыОбмена = Новый СписокЗначений();
	СертификатыОбмена.Добавить(СертификатСтрахователя, НСтр("ru = 'Сертификат страхователя';
															|en = 'Insurant certificate'"));
	Если НастройкиВызова.ЗашифроватьSOAP Тогда
		СертификатыОбмена.Добавить(СертификатФССЭЛН, НСтр("ru = 'Сертификат ФСС ЭЛН';
															|en = 'ESLR SSF certificate'"));
	КонецЕсли;
	
	Если НЕ СертификатыИзвестны И НЕ СертификатыГодятсяДляПодписанияОтчетностиФСС(СертификатыОбмена) Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("СертификатФССЭЛН", СертификатФССЭЛН);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеЭкспортаСертификата",
		ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(Оповещение, СертификатСтрахователя);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеЭкспортаСертификата(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ЗапросОперации64 					= ДополнительныеПараметры.ЗапросОперации64;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатПолучателя64 = Результат.СтрокаBase64;
	
	ДополнительныеПараметры.Вставить("СертификатПолучателя64", СертификатПолучателя64);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеЗаписиФайла",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
			Истина, Неопределено, ЗапросОперации64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ЗапросОперации64);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеЗаписиФайла(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатСтрахователя 				= ДополнительныеПараметры.СертификатСтрахователя;
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	НастройкиВызова 					= ДополнительныеПараметры.НастройкиВызова;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ДобавляемыеАтрибутыЗапроса 			= ДополнительныеПараметры.ДобавляемыеАтрибутыЗапроса;
	ДобавляемыеАтрибутыПодписи 			= ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	ДобавляемыеАтрибутыПодписиИЗаписи 	= ДополнительныеПараметры.ДобавляемыеАтрибутыПодписиИЗаписи;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлЗапросаОперации = Результат.ИмяФайла;
	
	ДополнительныеПараметры.Вставить("ФайлЗапросаОперации", ФайлЗапросаОперации);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеПодписания", ЭтотОбъект, ДополнительныеПараметры);
	
	ИдентификаторПодписываемыхДанных = ?(ЗначениеЗаполнено(ДополнительныеПараметры.ОГРН),
		"OGRN_" + ДополнительныеПараметры.ОГРН, "body");
	
	НастройкиПодписи = Новый Структура;
	НастройкиПодписи.Вставить("Трансформация1_1", 						Истина);
	НастройкиПодписи.Вставить("ВключатьХэшСертификата", 				Ложь);
	НастройкиПодписи.Вставить("НеВключатьЗаголовокXML", 				Истина);
	НастройкиПодписи.Вставить("ЗаменаУзлаОбъекта", 						Неопределено);
	НастройкиПодписи.Вставить("НормализацияОтключена", 					Истина);
	НастройкиПодписи.Вставить("ДанныеВнутриПодписи", 					Истина);
	НастройкиПодписи.Вставить("ИдентификаторПодписываемыхДанных", 		ИдентификаторПодписываемыхДанных);
	НастройкиПодписи.Вставить("ДобавляемыеАтрибуты", 					ДобавляемыеАтрибутыПодписиИЗаписи);
	НастройкиПодписи.Вставить("НеВключатьИнформациюОСертификате", 		Истина);
	НастройкиПодписи.Вставить("НеВключатьИнформациюОбОбъекте", 			Истина);
	НастройкиПодписи.Вставить("ДополнительныеТрансформации", 			Неопределено);
	НастройкиПодписи.Вставить("ДополнительныеОбратныеТрансформации", 	Неопределено);
	НастройкиПодписи.Вставить("ИспользуетсяУзелТрансформации", 			Истина);
	НастройкиПодписи.Вставить("ЭтоИсключающаяКанонизация", 				НастройкиВызова.ЭтоИсключающаяКанонизация);
	ПодписатьФайлXMLDSig(
		СертификатСтрахователя,
		ФайлЗапросаОперации,
		Оповещение,,,
		НастройкиПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеПодписания(ПолноеИмяПодписанногоФайла, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ФайлЗапросаОперации 				= ДополнительныеПараметры.ФайлЗапросаОперации;
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		УдалитьИзВременногоХранилища(ФайлЗапросаОперации);
	Иначе
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ФайлЗапросаОперации);
	КонецЕсли;
	
	Если ПолноеИмяПодписанногоФайла = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось подписать подтверждение вида деятельности';
															|en = 'Cannot sign the activity category confirmation'"));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ФайлПодписиЗапросаОперации", ПолноеИмяПодписанногоФайла);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеЧтенияФайла",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, СтрокаBase64",
			Истина, Неопределено, ПолноеИмяПодписанногоФайла);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ПолноеИмяПодписанногоФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеЧтенияФайла(Результат, ДополнительныеПараметры) Экспорт
	
	Организация 						= ДополнительныеПараметры.Организация;
	ВыгрузкаЗапроса 					= ДополнительныеПараметры.ВыгрузкаЗапроса;
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	НастройкиВызова 					= ДополнительныеПараметры.НастройкиВызова;
	ЭтоЭлектроннаяПодписьВМоделиСервиса = ДополнительныеПараметры.ЭтоЭлектроннаяПодписьВМоделиСервиса;
	ДобавляемыеАтрибутыКонверта 		= ДополнительныеПараметры.ДобавляемыеАтрибутыКонверта;
	ДобавляемыеАтрибутыБезопасности 	= ДополнительныеПараметры.ДобавляемыеАтрибутыБезопасности;
	ДобавляемыеАтрибутыПодписи 			= ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	СертификатПолучателя64 				= ДополнительныеПараметры.СертификатПолучателя64;
	ФайлПодписиЗапросаОперации 			= ДополнительныеПараметры.ФайлПодписиЗапросаОперации;
	
	Если НЕ ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ФайлПодписиЗапросаОперации);
	КонецЕсли;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлПодписиЗапросаОперации64 = Результат.СтрокаBase64;
	
	НастройкиОперации = Новый Структура;
	НастройкиОперации.Вставить("РегистрационныйНомерФСС", 		ДополнительныеПараметры.РегистрационныйНомерФСС);
	НастройкиОперации.Вставить("ОГРН", 							ДополнительныеПараметры.ОГРН);
	НастройкиОперации.Вставить("Организация", 					Организация);
	НастройкиОперации.Вставить("ВозвращатьТекстВBase64", 		НастройкиВызова.ЗашифроватьSOAP);
	НастройкиОперации.Вставить("ЭтоИсключающаяКанонизация", 	НастройкиВызова.ЭтоИсключающаяКанонизация);
	РезультатОперации = АдресSOAPЗапросОперацииСОКВЭДВФССПоПодписиНаСервере(
		ВыгрузкаЗапроса,
		ФайлПодписиЗапросаОперации64,
		СертификатПолучателя64,
		ДобавляемыеАтрибутыКонверта,
		ДобавляемыеАтрибутыБезопасности,
		ДобавляемыеАтрибутыПодписи,
		НастройкиОперации);
	
	Если НЕ НастройкиВызова.ЗашифроватьSOAP Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОперации);
		
	Иначе
		Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеЗаписиФайлаПодписанногоSOAP",
			ЭтотОбъект, ДополнительныеПараметры);
		
		Если ЭтоЭлектроннаяПодписьВМоделиСервиса Тогда
			РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, РезультатОперации);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
			
		Иначе
			ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, РезультатОперации);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСОКВЭДВФССПослеЗаписиФайлаПодписанногоSOAP(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатСтрахователя 	= ДополнительныеПараметры.СертификатСтрахователя;
	СертификатФССЭЛН 		= ДополнительныеПараметры.СертификатФССЭЛН;
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлПодписанногоSOAP = Результат.ИмяФайла;
	
	ШаблонЗапросаSOAP =
		"<SOAP-ENV:Envelope xmlns:SOAP-ENV=""http://schemas.xmlsoap.org/soap/envelope/"">
		|	<SOAP-ENV:Header/>
		|	<SOAP-ENV:Body>
		|%1
		|	</SOAP-ENV:Body>
		|</SOAP-ENV:Envelope>";
	НастройкиОперации = Новый Структура;
	НастройкиОперации.Вставить("ШаблонЗапросаSOAP", 	ШаблонЗапросаSOAP);
	НастройкиОперации.Вставить("ЭтоСодержимоеOASIS", 	Истина);
	ЗашифроватьФайлXML(
		СертификатФССЭЛН,
		СертификатСтрахователя,
		ФайлПодписанногоSOAP,
		ВыполняемоеОповещение,,
		Истина,
		НастройкиОперации);
	
КонецПроцедуры

