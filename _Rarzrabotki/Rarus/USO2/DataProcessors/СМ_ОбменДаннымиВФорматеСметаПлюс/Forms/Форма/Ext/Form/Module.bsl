&НаКлиенте
Процедура ВыполнитьПослеПроверкиСуществованияФайлаСигнатур(Существует,ДополнительныеПараметры) Экспорт
	
	Если Существует Тогда
		Текст 	= Новый ЧтениеТекста(ВременныйКаталог+"/SMETA75.SIG", КодировкаТекста.ANSI);
		Стр 	= Текст.ПрочитатьСтроку();
		// Строки читаются до символа перевода строки
		Если Сред(Стр,1,20) = НСтр("ru='Архив для Смета Плюс'") Тогда
			НовыйАрхив = Ложь;
			Пока Стр <> Неопределено Цикл 
				Стр = Текст.ПрочитатьСтроку();
				Если Стр = НСтр("ru='Архив для Смета 1C, Версия 3'") Тогда
					НовыйАрхив = Истина;
				КонецЕсли;
			КонецЦикла;
			ЭтаФорма.НовыйАрхив = НовыйАрхив;
		КонецЕсли;
		
		// Замена на асинхронный вызов
		ФайлСметы = Новый Файл(ВременныйКаталог+"/SMETA.DBF");
		ОповещениеПроверкиФайлСметы = Новый ОписаниеОповещения("ВыполнитьПослеПроверкиСуществованияФайлаСметы", ЭтаФорма);
		ФайлСметы.НачатьПроверкуСуществования(ОповещениеПроверкиФайлСметы); 
	Иначе	
		Сообщение 		= Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru='Нет файла SMETA75.SIG!'");
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеПроверкиСуществованияФайлаСметы(Существует,ДополнительныеПараметры) Экспорт

	Если НЕ Существует Тогда
		Сообщение 		= Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru='Нет файла SMETA.DBF!'");
		Сообщение.Сообщить();
	КонецЕсли;
		
КонецПроцедуры

// Загрузка одного или нескольких выбранных файлов из каталога архивов смет.
&НаКлиенте
Процедура ЗагрузитьАрхив(Команда)
	МассивХранилищ.Очистить();
	АнализФайла = ПроверитьСоответствиеЛЗ();
	Если  АнализФайла = Истина Тогда
		Для Каждого ТекФайлАрхива Из СписокСметКаталога Цикл 
			Если ТекФайлАрхива.Загружать Тогда
				Если Распаковка(ТекФайлАрхива.АрхивСметы) Тогда
					СобратьФайлыВоВременноеХранилище(ТекФайлАрхива.АрхивСметы);
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;	
		ПодключитьОбработчикОжидания("Подключаемый_ЗапуститьВыполнениеЗадания",1,Истина);

	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Требуется заполнить соответствия лимитированных затрат'"));
	КонецЕсли;
	Если этаформа.ВладелецФормы <> Неопределено Тогда
		Если этаформа.ВладелецФормы.ИмяФормы = "Обработка.СМ_ДеревоСмет.Форма.ФормаУпр" Тогда
			этаформа.ВладелецФормы.Элементы.СписокОбъектыСтроительства.обновить()
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗапуститьВыполнениеЗадания()
	
	Результат 				= ЗапуститьЗадание();
	ИдентификаторЗадания 	= Результат.ИдентификаторЗадания;
	АдресХранилища 		 	= Результат.АдресХранилища;
	
	Если Результат.ЗаданиеВыполнено Тогда
		ОбработкаРезультата();
		Оповестить("ОбновитьДеревоСмет");
	Иначе
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
		ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, Результат.ИдентификаторЗадания);
	КонецЕсли;  		
		
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	Попытка
		Если ФормаДлительнойОперации.Открыта() И ФормаДлительнойОперации.ИдентификаторЗадания = ИдентификаторЗадания Тогда
			Если ЗаданиеВыполнено(ИдентификаторЗадания) Тогда 
				ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
				ОбработкаРезультата();
				Оповестить("ОбновитьДеревоСмет");
			Иначе
				ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
				ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания",ПараметрыОбработчикаОжидания.ТекущийИнтервал,Истина);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ЗаписатьИсключениеНаСервере(ПредставлениеОшибки);
		ПоказатьПредупреждение(,НСтр("ru='Произошла ошибка. Подробности в журнале регистрации.'"));
	КонецПопытки;
		
КонецПроцедуры

&НаСервере
Функция ЗапуститьЗадание()
	СтруктураПараметров = Новый Структура;

	Возврат Обработки.СМ_ОбменДаннымиВФорматеСметаПлюс.ЗапуститьЗагрузкаАрхива(ЭтаФорма,СтруктураПараметров);
	
КонецФункции

&НаСервере
Процедура ОбработкаРезультата()
	
	РезультатВыполнения = ПолучитьИзВременногоХранилища(АдресХранилища);
	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаИмен Из МассивХранилищ Цикл 
		ИмяФайла = СтрокаИмен.ИмяФайла;
		ИмяФайлаИнд = СтрокаИмен.ИмяФайла + "Инд";
		Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла",ИмяФайла)); 
		Если Запись.Следующий() Тогда
			Запись.ПолучитьМенеджерЗаписи().Удалить();
		КонецЕсли;
		Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла",ИмяФайлаИнд)); 
		Если Запись.Следующий() Тогда
			Запись.ПолучитьМенеджерЗаписи().Удалить();
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из РезультатВыполнения.ТабСообщения Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("" + ТекСтрока.ТекстСообщения);		
	КонецЦикла;

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Загрузка завершена!'"));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(ИдентификаторЗадания)

	Возврат ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	
КонецФункции

&НаСервере
Процедура ЗаписатьИсключениеНаСервере(Знач ПредставлениеОшибки)
	
	Событие = НСтр("ru = 'Ошибка в задании'");
	ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ПредставлениеОшибки);
	
КонецПроцедуры

&НаКлиенте
Процедура СобратьФайлыВоВременноеХранилище(АрхивСметы)
	
	// **********************************************************************
	// Проверка файлов ДБФ 
	Если НЕ ЗначениеЗаполнено(ВременныйКаталог) Тогда
		Сообщение 		= Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru='Каталог / файл загрузки не указан!'");
