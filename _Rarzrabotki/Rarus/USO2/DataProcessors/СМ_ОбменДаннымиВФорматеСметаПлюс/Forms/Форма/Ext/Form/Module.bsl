// Заполнение Стройки и Организации из настроек пользователя.
&НаСервере
Процедура ПриОткрытииНаСервере()
	Объект.Стройка = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнаяСтройка");	
	Объект.Организация = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнаяОрганизация");	
КонецПроцедуры

// Проверка возможности работать с 1984 годом.
&НаСервере
Функция ПолучитьВидимостьМетодика1984()
	
	Возврат(ПолучитьФункциональнуюОпцию("СМ_Методика84Года"));
	
КонецФункции	

// Установка значений реквизитов формы по умолчанию.
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЭтаФорма.ИзФайла = Истина;
	ЭтаФорма.Элементы.ЗагрузитьАрхив.Доступность = Ложь;
	#Если ВебКлиент Тогда
		Элементы.ЗагрузкаКаталогАрхивов.Видимость = Ложь;
	#КонецЕсли
	ЭтаФорма.Методика1984 = Ложь;
    ЭтаФорма.Элементы.Методика1984.Видимость = ПолучитьВидимостьМетодика1984();
	ПриОткрытииНаСервере();
	Если ЗначениеЗаполнено(Параметры.ИмяФайла) Тогда
		ИзФайла = Истина;
		КаталогАрхивов = Параметры.ИмяФайла; 
	КонецЕсли;
КонецПроцедуры

// Чистка временного каталога для загрузки архивов.
