		#Если ВебКлиент Тогда
			Чтение.ИзвлечьВсе(ВременныйКаталог);
		#Иначе
			Чтение.ИзвлечьВсе(ВременныйКаталог, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
		#КонецЕсли
		Чтение.Закрыть();
		
		//// Синхронный вызов
