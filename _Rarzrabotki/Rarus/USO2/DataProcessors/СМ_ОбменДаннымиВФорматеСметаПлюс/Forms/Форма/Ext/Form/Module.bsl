		//Иначе	
		//	Текст 	= Новый ЧтениеТекста(ВременныйКаталог+"/SMETA75.SIG", КодировкаТекста.ANSI);
		//	Стр 	= Текст.ПрочитатьСтроку();
		//	Если Сред(Стр,1,20) = НСтр("ru='Архив для Смета Плюс'") Тогда
		//		НовыйАрхив = Ложь;
		//		// Строки читаются до символа перевода строки
		//		Пока Стр <> Неопределено Цикл 
		//			Стр = Текст.ПрочитатьСтроку();
		//			Если Стр = НСтр("ru='Архив для Смета 1C, Версия 3'") Тогда
		//				НовыйАрхив = Истина;
		//			КонецЕсли;
		//		КонецЦикла;
		//		ЭтаФорма.НовыйАрхив = НовыйАрхив;
		//	КонецЕсли;
		//КонецЕсли;

		//ФайлСметы = Новый Файл(ВременныйКаталог+"/SMETA.DBF");
		//Если ФайлСметы.Существует()= Ложь Тогда
