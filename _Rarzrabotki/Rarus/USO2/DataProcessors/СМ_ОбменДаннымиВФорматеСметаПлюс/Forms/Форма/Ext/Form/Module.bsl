&НаКлиенте
Процедура ПослеПроверкиСуществованияКаталога(Существует,ИмяКаталогаВременныхФайлов) Экспорт
	
	Если НЕ Существует Тогда
		ПрефиксВремени  			= СтрЗаменить(ТекущаяУниверсальнаяДатаВМиллисекундах(),":",".");
		ТекПапкаТемп 				= ИмяКаталогаВременныхФайлов+"arh_sm_"+ИмяПользователя()+"_" + ПрефиксВремени;
		ВременныйКаталог 			= ТекПапкаТемп;
		СоздатьКаталог(ВременныйКаталог);
	КонецЕсли;
	
	Если ИзФайла = Истина Тогда
		//  Загрузить ЛЗ в таблицу соответствий.
		Если Распаковка(КаталогАрхивов)  Тогда
			НеНайдено = 0;
			ДобавитьЛЗДляСоответствий(НеНайдено);
			НоваяСтрока 			= СписокСметКаталога.Добавить();
			НоваяСтрока.АрхивСметы 	= КаталогАрхивов;
			НоваяСтрока.Загружать 	= Истина;
			НоваяСтрока.Наименование = НайтиНаименованиеАрхива();
			
			Если Ненайдено = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Все лимитированные затраты найдены!'"));
			Иначе
				Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.ТаблицыДанных;
			КонецЕсли;
			ЭтаФорма.Элементы.ЗагрузитьАрхив.Доступность = Истина;
		КонецЕсли;	
	Иначе
		НеНайдено = 0;
		Если ЗначениеЗаполнено(Этаформа.КаталогАрхивов) Тогда
			ОповещениеПоиска = Новый ОписаниеОповещения("ВыполнитьПослеПоискаФайлов", ЭтотОбъект);
			НачатьПоискФайлов(ОповещениеПоиска,Этаформа.КаталогАрхивов,"*.SMA");
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не заполнен каталог архивов!'"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеПоискаФайлов(НайденныеФайлы,ДополнительныеПараметры) Экспорт
	
	НеНайдено = 0;
	Для Каждого ТекФайл Из НайденныеФайлы Цикл
		Если Распаковка(ТекФайл)  Тогда
			НоваяСтрока 			= СписокСметКаталога.Добавить();
			НоваяСтрока.АрхивСметы 	= ТекФайл.ПолноеИмя;
			НоваяСтрока.Загружать 	= Истина;
			НоваяСтрока.Наименование = НайтиНаименованиеАрхива();
			ДобавитьЛЗДляСоответствий(НеНайдено);
		КонецЕсли;	
	КонецЦикла;
	
	Если Ненайдено = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Все лимитированные затраты найдены!'"));
	Иначе
		Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.ТаблицыДанных;
	КонецЕсли;
	ЭтаФорма.Элементы.ЗагрузитьАрхив.Доступность = Истина;	
	
КонецПроцедуры

// Проверка, есть ли строки в таблице СоответствияЛЗ строк с признаком "загружать" истина.
// Не найденных в справочнике.
&НаКлиенте
Функция ПроверитьСоответствиеЛЗ()
	Результат = Истина;
	Для каждого Стр Из СоответствияЛЗ Цикл
		Если Стр.СсылкаВБазе.Пустая() И Стр.Загружать = Истина Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат(Результат);
КонецФункции

// Определение наименования главной сметы в принимаемом архиве.
Функция НайтиНаименованиеАрхива()
	Наименование = "";
	ФайлСметы = Новый Файл(Этаформа.ВременныйКаталог+"/SMETA.DBF");
	ФайлНаименованияСметы = Новый XBase;
	ФайлНаименованияСметы.ОткрытьФайл(ФайлСметы.ПолноеИмя,,Истина); 
	Если НЕ ФайлНаименованияСметы.Открыта() Тогда
		Возврат Наименование;
	КонецЕсли;
	ФайлНаименованияСметы.Первая();
	Наименование = СокрЛП(ФайлНаименованияСметы.ПолучитьЗначениеПоля("NAME"));
	ФайлНаименованияСметы.ЗакрытьФайл();
	Возврат Наименование;
КонецФункции

#КонецОбласти

#Область СозданиеДокументов

// Определение соответствия ЛЗ из файла LIMZTR.DBF в справочнике Лимитированные затраты. 
// Занесение в таблицу СоответствияЛЗ не найденных ЛЗ.
Процедура ДобавитьЛЗДляСоответствий(НеНайдено)
	ФайлЛЗ = Новый Файл(Этаформа.ВременныйКаталог+"/LIMZTR.DBF");
	Если ФайлЛЗ.Существует()= Ложь Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru='Нет файла LIMZTR.DBF!'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	ФайлЛимЗатр = Новый XBase;
	ФайлЛимЗатр.ОткрытьФайл(ФайлЛЗ.ПолноеИмя,,Истина); 
	Если НЕ ФайлЛимЗатр.Открыта() Тогда
		Возврат;
	КонецЕсли;
	ФайлЛимЗатр.Первая();
	Пока Не ФайлЛимЗатр.ВКонце() Цикл
		Наименование = СокрЛП(ФайлЛимЗатр.ПолучитьЗначениеПоля("NAME"));
		ТекЛимЗатрата = Справочники.СМ_ЛимитированныеЗатраты.НайтиПоНаименованию(Наименование);
		Если ТекЛимЗатрата = Справочники.СМ_ЛимитированныеЗатраты.ПустаяСсылка() Тогда
			Отбор = Новый Структура();
			Отбор.Вставить("НаименованиеЛЗ",Наименование);
			Строки =  СоответствияЛЗ.НайтиСтроки(Отбор);
			Если Строки.Количество() = 0 Тогда 
				НоваяСтрока 				= СоответствияЛЗ.Добавить();
				НоваяСтрока.НаименованиеЛЗ 	= Наименование;
				НоваяСтрока.Загружать 	= Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Лимитированная затрата: %1 не найдена в справочнике.'"), Наименование));
				НеНайдено = 1;
			КонецЕсли;
		КонецЕсли;
	    ФайлЛимЗатр.Следующая();
	КонецЦикла;	
	ФайлЛимЗатр.ЗакрытьФайл();
КонецПроцедуры

&НаКлиенте
