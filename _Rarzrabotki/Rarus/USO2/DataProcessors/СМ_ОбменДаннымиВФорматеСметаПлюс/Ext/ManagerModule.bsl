	СтруктураГлобальныхПеременных.Вставить("ТекущаяОбъектнаяСмета",Неопределено);
	СтруктураГлобальныхПеременных.Вставить("ТекущаяСмета",Неопределено);
	СтруктураГлобальныхПеременных.Вставить("ТекущийРаздел",Неопределено);
	СтруктураГлобальныхПеременных.Вставить("ТекущийПодраздел",Неопределено);
	СтруктураГлобальныхПеременных.Вставить("НовыйАрхив",Форма.НовыйАрхив);
	СтруктураГлобальныхПеременных.Вставить("ПересчетЗагруженныхСмет",Форма.ПересчетЗагруженныхСмет);
	СтруктураГлобальныхПеременных.Вставить("Методика1984",Форма.Методика1984);
	СтруктураГлобальныхПеременных.Вставить("Стройка",Форма.Стройка);
	СтруктураГлобальныхПеременных.Вставить("Организация",Форма.Организация);
	СтруктураГлобальныхПеременных.Вставить("СоответствияЛЗ",Форма.СоответствияЛЗ);
