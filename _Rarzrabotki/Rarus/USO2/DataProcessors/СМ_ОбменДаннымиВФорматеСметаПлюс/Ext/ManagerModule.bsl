				К3 = 0;
				К4 = 0;
				РазобратьСтрокуКоэффициентов(К1,К2,К3,К4,СтрокаКоэфф);	
				ПрименитьКоэфф(К1,НовДок,"СПБазисный");
				ПрименитьКоэфф(К2,НовДок,"СПБазисный");
