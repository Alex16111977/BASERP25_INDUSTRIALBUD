	ТабДокументов = Новый ТаблицаЗначений;
	СоздатьТаблицуДокументов(ТабДокументов);
	//  Таблица актов.
	ТабАктов = Новый ТаблицаЗначений;
	СоздатьТаблицуАктов(ТабАктов);
	//  Таблица выполнения.	
