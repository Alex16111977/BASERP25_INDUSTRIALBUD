	Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла","РасходИнд")); 
	Если Запись.Следующий() Тогда
		ДвоичныеДанные = Запись.Файл.Получить();
		ИмяВременногоФайлаИнд = ПолучитьИмяФайла("CDX");
		ДвоичныеДанные.Записать(ИмяВременногоФайлаИнд);
		ДобавитьВСписок(СписокИменВременныхФайлов, ИмяВременногоФайла,ИмяВременногоФайлаИнд);
		
		Расход = Новый XBase;
		Расход.ОткрытьФайл(ИмяВременногоФайла,ИмяВременногоФайлаИнд,Истина); 
		Если НЕ Расход.Открыта() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	//
	Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла","Выполнение")); 
	Если Запись.Следующий() Тогда
		ДвоичныеДанные = Запись.Файл.Получить();
		ИмяВременногоФайла = ПолучитьИмяФайла("DBF");
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
	КонецЕсли;
	
	Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла","ВыполнениеИнд")); 
	Если Запись.Следующий() Тогда
		ДвоичныеДанные = Запись.Файл.Получить();
		ИмяВременногоФайлаИнд = ПолучитьИмяФайла("CDX");
		ДвоичныеДанные.Записать(ИмяВременногоФайлаИнд);
		ДобавитьВСписок(СписокИменВременныхФайлов, ИмяВременногоФайла,ИмяВременногоФайлаИнд);
		
		Выполнение = Новый XBase;
		Выполнение.ОткрытьФайл(ИмяВременногоФайла,ИмяВременногоФайлаИнд,Истина); 
		Если НЕ Выполнение.Открыта() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	//
	
	Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла","Подписи")); 
	Если Запись.Следующий() Тогда
		ДвоичныеДанные = Запись.Файл.Получить();
		ИмяВременногоФайла = ПолучитьИмяФайла("DBF");
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
		ДобавитьВСписок(СписокИменВременныхФайлов,ИмяВременногоФайла);
		Подписи = Новый XBase;
		Подписи.ОткрытьФайл(ИмяВременногоФайла,,Истина); 
		Если НЕ Подписи.Открыта() Тогда
			Возврат;
		КонецЕсли;
		//
		ТабПодписи = Новый ТаблицаЗначений();
		СоздатьТаблицуПодписей(ТабПодписи);
		ЗаполнениеТаблицыПодписей(ТабПодписи,Подписи);
	КонецЕсли;
	Если Не ФайлСмета = Неопределено Тогда 
	ФайлСмета.Первая();

	СозданиеТаблицыИндексов(ТабИндексов,ФайлСмета);	
	
	ТипДокументаСмета = "Локальная";
	КодГлавнойСметы = "";
	НомерРаздела = 0;
	НомерПодраздела = 0;
	НомерПозиции = 0;
	ФайлСмета.Первая();
	ТекстОшибки = "";
	НачатьТранзакцию();
	Для Каждого СтрИндекса  Из ТабИндексов Цикл	
		НомерВПределахСметы = СтрИндекса.НомерВПределахСметы;
		
		ФайлСмета.Первая();
		Пока Не ФайлСмета.ВКонце() Цикл
			ID = ФайлСмета.ПолучитьЗначениеПоля("ID");
			NOMER = ФайлСмета.ПолучитьЗначениеПоля("NOMER");
			ОпределитьТип(ФайлСмета,ТипДокументаСмета,КодГлавнойСметы);
			CODE = ФайлСмета.ПолучитьЗначениеПоля("CODE");
			Если (СтрИндекса.CODE = CODE) И  (ID = СтрИндекса.ID) Тогда 
				Если ТипДокументаСмета = "Локальная" Или ТипДокументаСмета = "Объектная"
					Или ТипДокументаСмета = "Сводная" Тогда
					НомерРаздела = 0;
					НомерПодраздела = 0;
					НомерПозиции = 0;
					Если ФайлСмета.ПолучитьЗначениеПоля("UDAL") = 1	Тогда 
						Продолжить;
					КонецЕсли;
					КодГлавнойСметы = CODE;
					КодСметы = CODE;
					ИндексСтрокиТаблицы = "";
					ЗаполнениеТаблицыСметы(ФайлСмета,ТабДокументов,ТипДокументаСмета,КодГлавнойСметы,ИндексСтрокиТаблицы,СтруктураГлобальныхПеременных);	
					Если НЕ ИндексСтрокиТаблицы = Неопределено Тогда
						СоздатьДокументЛС(ИндексСтрокиТаблицы,ТипДокументаСмета,ТабПодписи,СтруктураГлобальныхПеременных);
						ССылкаНаДокумент = ИндексСтрокиТаблицы.СсылкаНаДокумент;
						ИндексДокумента = СокрЛП(СокрЛП(ID) + "+" + CODE); 
						ЗаполнениеТаблицыЛимЗатрат(ФайлЛимЗатр,ТабЛимЗатраты,ИндексДокумента,СтруктураГлобальныхПеременных);
						Если ТабЛимЗатраты.Количество() <> 0 Тогда
							ЗаполнениеЛимитированныхЗатрат(ТабЛимЗатраты,ССылкаНаДокумент,СтруктураГлобальныхПеременных);
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
				Если ТипДокументаСмета = "Раздел" Тогда
					НомерРаздела = НомерРаздела + 1;
					ИндексРаздела = "";
					НомерПодраздела = 0;
					ЗаполнениеТаблицыРаздел(ФайлСмета,ТабРазделов,КодГлавнойСметы,ИндексРаздела,КодСметы,ИндексыРаздела,НомерВПределахСметы,НомерРаздела,СтруктураГлобальныхПеременных);	
					Если НЕ ИндексРаздела = Неопределено Тогда
						ТекущийРаздел = СоздатьДокументРаздел(ТабРазделов.Получить(ИндексРаздела),СтруктураГлобальныхПеременных);
					КонецЕсли;
				КонецЕсли;
				Если ТипДокументаСмета = "Позиция" Тогда
					Если ФайлСмета.ПолучитьЗначениеПоля("UDAL") <> 1	Тогда 
						ИндексПозиции = "";
						ИзмененТип = Ложь;
						ЗаполнениеТаблицыПозиций(КодСметы,ФайлСмета,ФайлПоз, ТабПозиций,ИндексПозиции,CODE,ТабЧП,ФайлЧП,ИзмененТип,ТабРазделов,НомерВПределахСметы,НомерПодраздела,СтруктураГлобальныхПеременных);	
						Если ИзмененТип = Ложь И НЕ ПустаяСтрока(ИндексПозиции) Тогда
							ЗаполнениеТаблицыРесурсов(ФайлРес,ТабРесурсов,ФайлИндексовРесурсов,ТабПозиций.Получить(ИндексПозиции),ТабВыполнение,Выполнение,СтруктураГлобальныхПеременных);
							НомерПозиции = НомерПозиции + 1;
							ТекущаяПозицияЛС = СоздатьДокументПозиция(ТабПозиций.Получить(ИндексПозиции),ТабПозиций,ТабРесурсов,ТабЧП,НомерВПределахСметы,НомерПозиции,СтруктураГлобальныхПеременных,ТекстОшибки);
						КонецЕсли;		
					КонецЕсли;		
				КонецЕсли;
			КонецЕсли;	
			ФайлСмета.Следующая();
		КонецЦикла;
	КонецЦикла;
	
	ЗаполнениеТаблицыАкта(Акт,ТабАктов,Выполнение,ТабВыполнение,ТабПозиций,ФайлИндексовРесурсов,ТабРасхода,Расход,СтруктураГлобальныхПеременных);
	
	// Смету по которой есть акт необходимо пересчитать до его создания.
	Если СтруктураГлобальныхПеременных.ПересчетЗагруженныхСмет Тогда
		Отбор = Новый Структура();
		Отбор.Вставить("ТипДокументаСмета","Локальная");
		МассивСтрок = ТабДокументов.НайтиСтроки(Отбор);
		Если МассивСтрок.Количество() > 0 Тогда 
			Для Каждого ТекДокум Из  МассивСтрок Цикл
				ДокументОбъект = ТекДокум.СсылкаНаДокумент.ПолучитьОбъект();
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;
	
	
	Если ТабДокументов.Количество() <> 0 Тогда
		Отбор = Новый Структура();
		Отбор.Вставить("ТипДокументаСмета","Локальная");
		МассивСтрок = ТабДокументов.НайтиСтроки(Отбор);
		Если МассивСтрок.Количество() > 0 Тогда
			ЕстьАкт = Ложь;
			
			Для каждого Стр Из МассивСтрок Цикл
				СоздатьДокументАкт(Стр.ССылкаНаДокумент,Стр.НомерДокумента,ТабАктов,ТабПозиций,ТабВыполнение,ТабРасхода,ТабРазделов,ФайлЛимЗатр,ТабЛимЗатраты,СтруктураГлобальныхПеременных,ТекстОшибки,ЕстьАкт);
			КонецЦикла;
			
			Если СМ_СметаВызовСервера.ЗначениеОпции("СМ_ИспользоватьСтатусыДокументов") И ЕстьАкт Тогда
				Смета = Стр.ССылкаНаДокумент.ПолучитьОбъект();
				Смета.Статус = Перечисления.СМ_СтатусыСметныхДокументов.Согласован;
				Смета.Записать();
			КонецЕсли;
			
			СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(Стр.ССылкаНаДокумент);
		КонецЕсли;
	КонецЕсли;
	
	Если СтруктураГлобальныхПеременных.ПересчетЗагруженныхСмет Тогда
		ПересчетЗагруженныхСмет(ТабДокументов,ТабАктов);
	КонецЕсли;
	
	Если ТекстОшибки = "" Тогда
		ЗафиксироватьТранзакцию();
	Иначе
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		
		// Запись сообщений в журнал регистрации
		СтруктураСообщения 	= Новый Структура;
		СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате Смета Плюс'"));
		СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
		СтруктураСообщения.Вставить("Комментарий",ТекстОшибки);
		СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
		
		СообщенияДляЖурнала	= Новый СписокЗначений();
		СообщенияДляЖурнала.Добавить(СтруктураСообщения);
		ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
		
		ОтменитьТранзакцию();
	КонецЕсли;
	
	// Закрытие файлов.
	Если ФайлСмета.Открыта() Тогда
		ФайлСмета.ЗакрытьФайл();
	КонецЕсли;
	Если ИндексыРаздела.Открыта() Тогда
		ИндексыРаздела.ЗакрытьФайл();
	КонецЕсли;
	Если ФайлПоз.Открыта() Тогда
		ФайлПоз.ЗакрытьФайл();
	КонецЕсли;
	Если ФайлЧП.Открыта() Тогда
		ФайлЧП.ЗакрытьФайл();
	КонецЕсли;
	Если ФайлРес.Открыта() Тогда
		ФайлРес.ЗакрытьФайл();
	КонецЕсли;
	Если ФайлИндексовРесурсов.Открыта() Тогда
		ФайлИндексовРесурсов.ЗакрытьФайл();
	КонецЕсли;
	Если ФайлЛимЗатр.Открыта() Тогда
		ФайлЛимЗатр.ЗакрытьФайл();
	КонецЕсли;
	Если Акт.Открыта() Тогда
		Акт.ЗакрытьФайл();
	КонецЕсли;
	Если Расход.Открыта() Тогда
		Расход.ЗакрытьФайл();
	КонецЕсли;
	Если Выполнение.Открыта() Тогда
		Выполнение.ЗакрытьФайл();
	КонецЕсли;
	Если Подписи.Открыта() Тогда
		Подписи.ЗакрытьФайл();
	КонецЕсли;

	УдалениеФайлов(СписокИменВременныхФайлов);
	ПоместитьВоВременноеХранилище(СтруктураПараметров, АдресХранилища); 
КонецЕсли;
КонецПроцедуры

// Процедура пересчета смет и актов
Процедура ПересчетЗагруженныхСмет(ТабДокументов,ТабАктов)
	
	Отбор = Новый Структура();
	Отбор.Вставить("ТипДокументаСмета","Объектная");
	МассивСтрок = ТабДокументов.НайтиСтроки(Отбор);
	Если МассивСтрок.Количество() > 0 Тогда 
		Для Каждого ТекДокум Из  МассивСтрок Цикл
			ДокументОбъект = ТекДокум.СсылкаНаДокумент.ПолучитьОбъект();
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Документы.СМ_ОбъектнаяСмета.Перерасчет(ДокументОбъект.Ссылка);
		КонецЦикла;	
	КонецЕсли;
	Отбор = Новый Структура();
	Отбор.Вставить("ТипДокументаСмета","Сводная");
	МассивСтрок = ТабДокументов.НайтиСтроки(Отбор);
	Если МассивСтрок.Количество() > 0 Тогда 
		Для Каждого ТекДокум Из  МассивСтрок Цикл 
			ДокументОбъект = ТекДокум.СсылкаНаДокумент.ПолучитьОбъект();
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Документы.СМ_СводнаяСмета.Перерасчет(ДокументОбъект.Ссылка);
		КонецЦикла;	
	КонецЕсли;
	Если  ТабАктов.Количество() <> 0 Тогда
		Для каждого Акта Из ТабАктов Цикл
			ДокументОбъект = Акта.СсылкаНаДокумент.ПолучитьОбъект();
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#Область СозданиеЭлементов
// Создание нового документа Акт с ТЧ Позиции, РесурсыПозицииАкта, Разделы.
Процедура СоздатьДокументАкт(ССылкаНаДокумент,КодСметы,ТабАктов,ТабПозиций,ТабВыполнение,ТабРасхода,ТабРазделов,ФайлЛимЗатр,ТабЛимЗатраты,СтруктураГлобальныхПеременных,ТекстОшибки,ЕстьАкт)
	
	Отбор = Новый Структура;
	Отбор.Вставить("КодСметы",СокрЛП(КодСметы));
	МассивСтрок = ТабАктов.НайтиСтроки(Отбор);
	Если МассивСтрок.Количество() > 0 Тогда 
		Для каждого Стр Из МассивСтрок Цикл
			НовДок	= СМ_СметаВызовСервера.СоздатьНовыйАкт();
			НовДок.ЛокальнаяСмета = ССылкаНаДокумент;
			НовДок.НомерАкта  	  = Стр.НомерДокумента;
			НовДок.Дата   		  = Стр.ДатаДокумента;
			НовДок.Организация	  = СтруктураГлобальныхПеременных.Организация;
			НовДок.Стройка		  = СтруктураГлобальныхПеременных.Стройка;
			НовДок.Заказчик		  = ССылкаНаДокумент.Заказчик;
			Если Стр.Подрядчик <> Неопределено Тогда
				ТекПодрядчик 	= СоздатьЭлементКонтрагент(Стр.Подрядчик,2);
				НовДок.Подрядчик	  = ТекПодрядчик;
			КонецЕсли;
			НовДок.МетодРасчета   = ССылкаНаДокумент.МетодРасчета;
			НовДок.ПериодОт = НачалоМесяца(Стр.ДатаДокумента);
			НовДок.ПериодДо = КонецМесяца(Стр.ДатаДокумента);
			НовДок.Уровень = ССылкаНаДокумент.Уровень;
			НовДок.СпособРасчетаИндексов = ССылкаНаДокумент.СпособРасчетаИндексов;
			НовДок.ДатаТекущихЦен  = Стр.ДатаТекущихЦен;
			НовДок.ВариантПересчетаЭММ = ССылкаНаДокумент.ВариантПересчетаЭММ;
			НовДок.ВариантРасчетаЗМ = ССылкаНаДокумент.ВариантРасчетаЗМ;
			НовДок.КоэффСМР = ССылкаНаДокумент.КоэффСМР;
			НовДок.КоэффФОТ = ССылкаНаДокумент.КоэффФОТ;
			НовДок.КоэффОборуд = ССылкаНаДокумент.КоэффОборуд;
			НовДок.КоэффПрочРаб = ССылкаНаДокумент.КоэффПрочРаб;
			Если НовДок.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
				И НовДок.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета Тогда
				Если НовДок.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости Тогда
					НовДок.КоэффСМР = Стр.КоэффСМР;
					НовДок.КоэффФОТ = Стр.КоэффФОТ;
					НовДок.КоэффОборуд = Стр.КоэффОборуд;
					НовДок.КоэффПрочРаб = Стр.КоэффПрочРаб;
				ИначеЕсли НовДок.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат Тогда
					НовДок.КоэффСтоимЭксплМашин = Стр.КоэффСтоимЭксплМашин;
					НовДок.КоэффФОТ = Стр.КоэффФОТ;
					НовДок.КоэффОборуд = Стр.КоэффОборуд;
					НовДок.КоэффСтоимМатериалов = Стр.КоэффСтоимМатериалов;
				КонецЕсли;
			КонецЕсли;
			 // Создаем новую строку ресурса в ТЧ.
			Для каждого СтрокиВыполнения Из ТабВыполнение Цикл 
				Если СтрокиВыполнения.Акт = Число(НовДок.НомерАкта) Тогда
					ТекПозиция = СтрокиВыполнения.CODE;
					Отбор1 = Новый Структура;
					Отбор1.Вставить("CODE",ТекПозиция);
					Строки =  ТабПозиций.НайтиСтроки(Отбор1);
					Если Строки.Количество() <> 0 Тогда
						СсылкаНаДокументПоз = Строки[0].СсылкаНаДокумент;
						МассивСтрокДляПозиции = ТабВыполнение.НайтиСтроки(Отбор1);
						Если МассивСтрокДляПозиции.Количество() > 0 Тогда
							Строки =  МассивСтрокДляПозиции[0];
							СтрокаПозАкта = НовДок.Позиции.Добавить();	
							СтрокаПозАкта.Позиция = СсылкаНаДокументПоз;
							СтрокаПозАкта.ФактОбъем = Строки.ФактОбъем;
							СтрокаПозАкта.ТекущаяЦена = Строки.ТекущаяЦена;
							СтрокаПозАкта.ТекущаяЗарплатаМашинистов = Строки.ТекущаяЗПМ;
							СтрокаПозАкта.ВариантПересчетаЭММ  = СсылкаНаДокументПоз.ИДСметы.ВариантПересчетаЭММ;
							СтрокаПозАкта.КоэффОснЗарплаты = Строки.КоэффОснЗарплаты;
							СтрокаПозАкта.КоэффСтоимЭксплМашин = Строки.КоэффСтоимЭксплМашин;
							СтрокаПозАкта.КоэффСтоимЗарплатеМашин = Строки.КоэффСтоимЗарплатеМашин;
							СтрокаПозАкта.КоэффСтоимМатериалов = Строки.КоэффСтоимМатериалов;
							СтрокаПозАкта.КоэффОборуд = Строки.КоэффОборуд;
							СтрокаПозАкта.КоэффПолнСтоимРабот = Строки.КоэффПолнСтоимРабот;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;	
			КонецЦикла;
	
			Для каждого СтрПозиции Из ТабВыполнение Цикл
				Если  СтрПозиции.Акт = Число(НовДок.НомерАкта) Тогда
				Отбор1 = Новый Структура;
				Отбор1.Вставить("Акт",Число(НовДок.НомерАкта));
				Отбор1.Вставить("CODE",СтрПозиции.CODE);
				МассивСтрокРасх = ТабРасхода.НайтиСтроки(Отбор1);
				Если МассивСтрокРасх.Количество() > 0 Тогда
					
					Для каждого СтрокиРасхода Из МассивСтрокРасх Цикл 
						ТекПозиция = СтрокиРасхода.CODE;
						СсылкаНаДокументПоз = СтрокиРасхода.СсылкаНаДокумент;
						СтрокаПозАкта = НовДок.РесурсыПозицийАкта.Добавить();
						СтрокаПозАкта.Позиция = СсылкаНаДокументПоз;
						СтрокаПозАкта.СметныйКодРесурса = СокрЛП(СтрокиРасхода.КодРесурса);
						ВидРесурса = ТипРесурсаСметаПлюс(СокрЛП(СтрокиРасхода.КодРесурса),СтруктураГлобальныхПеременных);
						ГруппаРесурсов = СтрокаПозАкта.Позиция.РегиональнаяБаза.ГруппаРесурсов;

						ТекРесурс = НайтиСоздатьРесурсВСправочнике(СокрЛП(СтрокиРасхода.КодРесурса),СокрЛП(СтрокиРасхода.Наименование),ВидРесурса,ГруппаРесурсов,,,Истина,ТекстОшибки);
						СтрокаПозАкта.Ресурс = ТекРесурс;
						СтрокаПозАкта.НаименованиеРесурса = СтрокиРасхода.Наименование;

						ТЧПозиции = СтрокаПозАкта.Позиция.РесурсыПозицииЛокальнойСметы.Выгрузить();
						Отбор2 =  Новый Структура;
						Отбор2.Вставить("СметныйКодРесурса",СокрЛП(СтрокиРасхода.КодРесурса));
						РесРасхода = ТЧПозиции.НайтиСтроки(Отбор2);
						Если РесРасхода.Количество() > 0 Тогда
							СтрРес = РесРасхода[0];
							СтрокаПозАкта.ВидРесурса = СтрРес.ВидРесурса;	
							СтрокаПозАкта.ТипМатериала = СтрРес.ТипМатериала;
							СтрокаПозАкта.БазиснаяЦена = СтрРес.БазиснаяЦена;
							СтрокаПозАкта.БазиснаяЗарплатаМашинистов = СтрРес.БазиснаяЗарплатаМашинистов;
						КонецЕсли; 
						СтрокаПозАкта.НормаРасходаОбъем  = СтрокиРасхода.НормРасход;
						СтрокаПозАкта.ФактРасходаОбъем = СтрокиРасхода.ФактРасход;
						СтрокаПозАкта.ТекущаяЦена = СтрокиРасхода.ТекущаяЦена;
						СтрокаПозАкта.ТекущаяЗарплатаМашинистов = СтрокиРасхода.ТекущаяЦенаЗПМ;
					КонецЦикла;
				КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			//  Заполнение разделов.
			Отбор = Новый Структура();
			Отбор.Вставить("НомерСметы",СокрЛП(КодСметы));
			МассивСтрокРаздел = ТабРазделов.НайтиСтроки(Отбор);
			Если МассивСтрокРаздел.Количество() > 0 Тогда
				Для каждого СтрокиРаздела Из МассивСтрокРаздел Цикл
					РазделыАкта = НовДок.Разделы.Добавить();
					РазделыАкта.Раздел = СтрокиРаздела.СсылкаНаДокумент;
					Если СтрокиРаздела.УровеньЗаголовка = 1 Тогда						
						КоэффОЗ = 0;
						КоэффПС = 0;
						КоэффЭМ = 0;
						КоэффСМ = 0;
						НайтиИндексыРаздела(Стр,СокрЛП(СтрокиРаздела.НаименованиеРаздела),КоэффОЗ,КоэффПС,КоэффЭМ,КоэффСМ);
					КонецЕсли;
					РазделыАкта.КоэффОснЗарплаты = КоэффОЗ;
					РазделыАкта.КоэффОборуд = КоэффПС;
					РазделыАкта.КоэффСтоимЗарплатеМашин = КоэффЭМ;
					РазделыАкта.КоэффСтоимМатериалов = КоэффСМ;
					РазделыАкта.КоэффСтоимЭксплМашин = КоэффЭМ;
				КонецЦикла;
			КонецЕсли;	
			ЗагрузкаЛимЗатратПоАкту(НовДок,ФайлЛимЗатр,ТабЛимЗатраты,КодСметы,СтруктураГлобальныхПеременных);
			ЗаполнитьПараметрыПечатиПоУмолчанию(НовДок);

			НовДок.Записать();
			ЕстьАкт = Истина;
			Стр.СсылкаНаДокумент = НовДок.Ссылка;
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

// Создать нового документа ПозицияЛокальнойСметы.
Функция СоздатьДокументПозиция(ТекСтрока,ТабПозиций,ТабРесурсов,ТабЧП,НомерВПределахСметы,НомерПозиции,СтруктураГлобальныхПеременных,ТекстОшибки)
	
	ТекНаименование = ТекСтрока.НаименованиеПозиции;
	Если НЕ ЗначениеЗаполнено(ТекНаименование) Тогда
		ТекНаименование = НСтр("ru='Позиция ЛС'");		
	КонецЕсли;

	//  Создание нового документа "ПозицияЛС".
	НовДок					= СМ_СметаВызовСервера.СоздатьНовуюПозицию();
	НовДок.Наименование 	= ТекНаименование;
	НовДок.Дата				= ТекущаяДатаСеанса();
	НовДок.СпособСоздания	= Перечисления.СМ_ИсточникиДобавленияПозиций.Загружена;
	НовДок.ИсточникСоздания	= "Смета плюс#SMA"; 
	
	Если ЗначениеЗаполнено(СтруктураГлобальныхПеременных.ТекущийПодраздел) Тогда
		НовДок.ИДРодителя = СтруктураГлобальныхПеременных.ТекущийПодраздел;	
	Иначе                    			
		НовДок.ИДРодителя = СтруктураГлобальныхПеременных.ТекущийРаздел;
	КонецЕсли;
	НовДок.ИДСметы 			= СтруктураГлобальныхПеременных.ТекущаяСмета;
	НовДок.ШифрРасценки 	= ТекСтрока.ШифрПозиции;
	НовДок.Расчет 			= ТекСтрока.Расчет;
	ПрежнийНомер = НомерПозиции;
	Если ТекСтрока.Расчет = Ложь Тогда
		НомерПозиции = 0;
	КонецЕсли;
	НовДок.ПорНомер =  НомерПозиции;
	НовДок.НомерВПределахСметы = НомерВПределахСметы;
	Если ТекСтрока.Расчет = Ложь Тогда
		НомерПозиции = ПрежнийНомер - 1;
	КонецЕсли;
	//  Поиск / создание единицы измерения.
	ТекЕдИзм = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоНаименованию(ТекСтрока.ЕдиницаИзмерения);
	НовДок.ЕдиницаИзмерения			= ТекЕдИзм;
	Если  ТекСтрока.Измеритель = "" Тогда
		НовДок.Измеритель				= ТекСтрока.ЕдиницаИзмерения;
	Иначе
		НовДок.Измеритель				= ТекСтрока.Измеритель;
	КонецЕсли;
	ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(ТекСтрока.Определитель);
	НовДок.Определитель  = ТекОпределитель;
	// Загрузка единичных значений.
	
	НовДок.Оборудование = ТекСтрока.Оборудование;
	НовДок.ПрямЗатраты = ТекСтрока.ПрямыеЗатраты;	
	НовДок.ОснЗарплата              = ТекСтрока.ОсновнаяЗП;
	НовДок.ЭксплМашин               = ТекСтрока.СтоимостьЭМиМех;
	НовДок.ЗарплМашинистов          = ТекСтрока.ЗарплатаМашинистов;
	НовДок.СтоимМатериалов          = ТекСтрока.СтоимостьМатериалов;
	НовДок.ВозвратМатер             = ТекСтрока.ВозвратМатериалов;
	НовДок.ЗатратыТрудаМашинистов   = ТекСтрока.ТрудозатратыМашинистов;
	НовДок.ЗатратыТрудаРабочих      = ТекСтрока.ТрудозатратыРабочих;
	НовДок.ОбъемРабот				= ТекСтрока.ОбъемРабот;
	НовДок.НеПрименятьИндексы		= ТекСтрока.НеИндексировать;
	НовДок.Демонтаж 				= ТекСтрока.Демонтаж;
	НовДок.Примечание 				= ТекСтрока.Примечание;
	НовДок.Применительно 			= ТекСтрока.Применительно;
	// Загрузка формул единичных значений.
	НовДок.ФормулаОбъема 			= ПолучитьФормулу(ТекСтрока.Формулы,"ОР","");
		//  Загрузка Текущей цены.
	 НовДок.ТекущаяЦена				= ТекСтрока.ТекущаяЦена;
	 НовДок.ТекущаяЗарплатаМашинистов = ТекСтрока.ТекущаяЗарплатаМашинистов;
	 
	// Загрузка коэффициентов.
	//  Определение сметно-нормативной базы.
	Если ЗначениеЗаполнено(ТекСтрока.Регион) Тогда
		НайденныйЭлемент = Справочники.СМ_СметноНормативныеБазы.НайтиПоКоду(ТекСтрока.Регион);
		Если НайденныйЭлемент = Справочники.СМ_СметноНормативныеБазы.ПустаяСсылка() Тогда
			НайденныйЭлемент = Справочники.СМ_СметноНормативныеБазы.СоздатьЭлемент();
			НайденныйЭлемент.Код = ТекСтрока.Регион; 
			НайденныйЭлемент.Наименование = ТекСтрока.РегионНаим; 
			ГруппаРесурсов = Справочники.СМ_ГруппыРесурсов.ПустаяСсылка();
			Если Найти(ТекСтрока.РегионНаим,"2001") <> 0 Тогда
				ГруппаРесурсов = Справочники.СМ_ГруппыРесурсов.Каталог2001;
			КонецЕсли;
			Если Найти(ТекСтрока.РегионНаим,"1984")<> 0 Тогда
				ГруппаРесурсов = Справочники.СМ_ГруппыРесурсов.Каталог1984;
			КонецЕсли;
			НайденныйЭлемент.ГруппаРесурсов = ГруппаРесурсов;
			НайденныйЭлемент.ОбменДанными.Загрузка = Истина;
			НайденныйЭлемент.Записать();
			НовДок.РегиональнаяБаза = НайденныйЭлемент.Ссылка;
		Иначе
			НовДок.РегиональнаяБаза = НайденныйЭлемент;
		КонецЕсли;
		
	КонецЕсли;
	НовДок.ТипНормативныхСборников = ОпределитьТипСборника(ТекСтрока.ТипПозиции);
	
	Если ЗначениеЗаполнено(ТекСтрока.ПризнакПодчиненности) Тогда
		НайденнаяСтрока = ТабПозиций.Найти(ТекСтрока.ПризнакПодчиненности, "CODE");
		Если Не НайденнаяСтрока = Неопределено Тогда
			НовДок.ИДПозицииВладельца = НайденнаяСтрока.СсылкаНаДокумент;
		КонецЕсли;
	КонецЕсли;
	ЗаполнениеПоправочныхКоэффициентов(ТекСтрока,НовДок);
	ЗаполнениеКоэффициентовПозиции(ТекСтрока,НовДок,СтруктураГлобальныхПеременных);
	ЗаполнитьНормативНРиСП(ТабЧП,НовДок,СтруктураГлобальныхПеременных);
	Если ТабРесурсов.Количество() <> 0 Тогда 
		ЗаполнениеРесурсовПозиции(ТабРесурсов,новДок,ТекстОшибки);
	КонецЕсли;
	
	Если НовДок.ИДСметы.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_Методика84года Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	СМ_СоответствияОпределителяиНРдляМетодики1984.ПравилоНачисленияНР КАК ПравилоНачисленияНР,
		|	СМ_СоответствияОпределителяиНРдляМетодики1984.ЗначениеНРБазисноИндексное КАК ЗначениеНРБазисноИндексное,
		|	СМ_СоответствияОпределителяиНРдляМетодики1984.ПравилоНачисленияСП КАК ПравилоНачисленияСП
		|ИЗ
		|	РегистрСведений.СМ_СоответствияОпределителяиНРдляМетодики1984 КАК СМ_СоответствияОпределителяиНРдляМетодики1984
		|ГДЕ
		|	СМ_СоответствияОпределителяиНРдляМетодики1984.Определитель = &Определитель";
		
		Запрос.УстановитьПараметр("Определитель", ТекОпределитель);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
		
			НовДок.ПравилаРасчетаНРПоМетодике1984  = Выборка.ПравилоНачисленияНР;
			НовДок.ПравилаРасчетаСППоМетодике1984  = Выборка.ПравилоНачисленияСП;
			//НовДок.НакладныерасходыТекущие         = Выборка.ЗначениеНРБазисноИндексное;
			//НовДок.НакладныерасходыБазисные         = Выборка.ЗначениеНРБазисноИндексное;
		
		Иначе
			
			НовДок.ПравилаРасчетаНРПоМетодике1984  = Перечисления.СМ_ПравилаРасчетаНРпоМетодике1984.Неначислять;
			НовДок.ПравилаРасчетаСППоМетодике1984  = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;


	НовДок.Записать();
	ТекПозиция = НовДок.Ссылка;
	ТекСтрока.ССылкаНаДокумент = НовДок.ССылка;
		
	Возврат ТекПозиция;
	
КонецФункции

// Создание нового документа РазделЛокальной сметы.
Функция СоздатьДокументРаздел(ТекСтрока,СтруктураГлобальныхПеременных)
		
	Если НЕ ЗначениеЗаполнено(ТекСтрока.НаименованиеРаздела) Тогда
		НаименованиеРаздела = НСтр("ru='Основной раздел'");	
	Иначе
		НаименованиеРаздела	= ТекСтрока.НаименованиеРаздела;
	КонецЕсли;
	
	// Создание нового документа "Раздел ЛС".
	НовДок							= СМ_СметаВызовСервера.СоздатьНовыйРаздел();
	НовДок.НаименованиеДляПечати 	= ТекСтрока.НаименованиеРазделаДляПечати;
	НовДок.Дата						= ТекущаяДатаСеанса();
	Если ТекСтрока.УровеньЗаголовка = 1 Тогда
		НовДок.ИДРодителя   		= СтруктураГлобальныхПеременных.ТекущаяСмета.Ссылка;
		НовДок.ИДСметы      		= СтруктураГлобальныхПеременных.ТекущаяСмета.Ссылка;
	КонецЕсли;
	НовДок.КоэффОборуд 				= ТекСтрока.КоэффОборуд;
	НовДок.КоэффОснЗарплаты 		= ТекСтрока.КоэффОснЗарплаты;
	НовДок.КоэффПолнСтоимРабот 		= ТекСтрока.КоэффПолнСтоимРабот;
	НовДок.КоэффСтоимЭксплМашин		= ТекСтрока.КоэффСтоимЭксплМашин;
	НовДок.КоэффСтоимМатериалов		= ТекСтрока.КоэффСтоимМатериалов;
	НовДок.КоэффСтоимЗарплатеМашин	= ТекСтрока.КоэффСтоимЗарплатеМашин;
	НовДок.НомерВПределахСметы = ТекСтрока.НомерВПределахСметы;
	НовДок.Расчет					= Истина;
	
	НовДок.НомерВПределахСметы = ТекСтрока.НомерВПределахСметы;
	НовДок.ПорНомер = ТекСтрока.НомерРаздела;

	НовДок.Записать();
	ТекРаздел = НовДок.Ссылка;
	ТекСтрока.СсылкаНаДокумент = НовДок.Ссылка;
	СтруктураГлобальныхПеременных.ТекущийРаздел = НовДок.Ссылка;
	СтруктураГлобальныхПеременных.ТекущийПодраздел = "";

	Возврат ТекРаздел;
	
КонецФункции	

// Создание новых документов ЛокальнаяСмета, ОбъектнаяСмета, СводнаяСмета.
Процедура СоздатьДокументЛС(ТекСтрока,ТипДокументаСмета,ТабПодписи,СтруктураГлобальныхПеременных)
	Если ТекСтрока.Заказчик <> Неопределено Тогда
		ТекЗаказчик 	= СоздатьЭлементКонтрагент(ТекСтрока.Заказчик,1);
	КонецЕсли;
	
	Если ТекСтрока.Подрядчик <> Неопределено Тогда
		ТекПодрядчик 	= СоздатьЭлементКонтрагент(ТекСтрока.Подрядчик,2);
	КонецЕсли;
	
	Если  ТекСтрока.КодРайона <> Неопределено Тогда
		ТекРайон 	 	= СоздатьЭлементРайон(ТекСтрока.КодРайона,ТекСтрока.НаименованиеРайона);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекЗаказчик) И ТекЗаказчик <> Справочники.Контрагенты.ПустаяСсылка() Тогда
		ТекДоговор = СоздатьЭлементДоговор(ТекЗаказчик, ТекСтрока.НаименованиеДоговора, ТекСтрока.НомерДоговора, ТекСтрока.ДатаДоговора);	
	КонецЕсли;
	
	Если ТипДокументаСмета = "Локальная"  Тогда
		//  Создание нового документа "Локальная смета".
		НовДок 					= Документы.СМ_ЛокальнаяСмета.СоздатьДокумент();
		НовДок.Автор 			= ПользователиКлиентСервер.АвторизованныйПользователь();
		НовДок.Наименование 	= ТекСтрока.Наименование;
		НовДок.ДатаТекущихЦен	= ТекСтрока.ДатаТекущихЦен;
		НовДок.Основание		= ТекСтрока.Основание;
		НовДок.НомерСметы		= ТекСтрока.НомерСметы;
		НовДок.Договор			= ТекДоговор;
		НовДок.Заказчик 		= ТекЗаказчик;
		НовДок.Подрядчик    	= ТекПодрядчик;
		НовДок.Дата				= ТекСтрока.ДатаДокумента;
		НовДок.Организация		= СтруктураГлобальныхПеременных.Организация;
		НовДок.Стройка		    = СтруктураГлобальныхПеременных.Стройка;
		НовДок.Район			= ТекРайон;
		НовДок.ТипРайона		= ТекСтрока.ТипРайона;
		НовДок.МетодРасчета 	= ТекСтрока.МетодРасчета;
		НовДок.Уровень		 	= ТекСтрока.УровеньИндексов;
		НовДок.ТипСтроительства = ТекСтрока.ТипСтроительства;
		НовДок.ДатаТекущихЦен	= ТекСтрока.ДатаТекущихЦен;
		НовДок.ВариантРасчетаЗМ = ТекСтрока.ВариантРасчетаЗМ;
		НовДок.СпособРасчетаИндексов 		= ТекСтрока.СпособРасчетаИндексов;
		НовДок.ВариантПересчетаЭММ   		= ТекСтрока.ВариантПересчетаЭММ;
		НовДок.ДатаВыпускаИндексов   		= ТекСтрока.ДатаВыпускаИндексов;
		НовДок.ПрименятьКоэффициентыНРСП 	= ТекСтрока.ПрименятьКоэффициентыНРСП;
		НовДок.РасчетНРиСПотПЗ 				= ТекСтрока.РасчетНРиСПотПЗ;
		//НовДок.Методика1984 				= ТекСтрока.Методика1984;
		Если ТекСтрока.Методика1984 Тогда
			НовДок.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_Методика84года;	
		Иначе
			НовДок.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаМДС35;		
		КонецЕсли;
		НовДок.БезПримененияКоэффициентов 	= ТекСтрока.БезПримененияКоэффициентов;
		НовДок.УпрощеннаяСН 				= ТекСтрока.УпрощеннаяСН;
		НовДок.РеконструкцияАЭС 			= ТекСтрока.РеконструкцияАЭС;
		НовДок.ГлаваССРС 					= НайтиГлаву(ТекСтрока.ТипСтроительства,ТекСтрока.Глава);
		НовДок.ОкруглятьДоРублей 			= ТекСтрока.Округлять;
		Если НовДок.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный И
			НовДок.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета Тогда
			Если НовДок.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости Тогда
				НовДок.КоэффСМР	 	= ТекСтрока.КоэффСМР;
				НовДок.КоэффФОТ	 	= ТекСтрока.КоэффФОТ;
				НовДок.КоэффОборуд 	= ТекСтрока.КоэффОборуд;
				НовДок.КоэффПрочРаб = ТекСтрока.КоэффПрочРаб;
			ИначеЕсли НовДок.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат Тогда
				НовДок.КоэффСтоимЭксплМашин = ТекСтрока.КоэффСтоимЭксплМашин;
				НовДок.КоэффФОТ 			= ТекСтрока.КоэффФОТ;
				НовДок.КоэффОборуд 			= ТекСтрока.КоэффОборуд;
				НовДок.КоэффСтоимМатериалов = ТекСтрока.КоэффСтоимМатериалов;
			КонецЕсли;
		КонецЕсли;
		ДобавитьПодписи(ТекСтрока.НомерДокумента,0,НовДок,ТабПодписи);

		Если ЗначениеЗаполнено(СтруктураГлобальныхПеременных.ТекущаяОбъектнаяСмета) Тогда
			НовДок.ИДРодителя = СтруктураГлобальныхПеременных.ТекущаяОбъектнаяСмета.ИД;
		КонецЕсли;	
		ЗаполнитьПараметрыПечатиПоУмолчанию(НовДок);
		Если ЗначениеЗаполнено(СтруктураГлобальныхПеременных.ТекущаяОбъектнаяСмета) Тогда
			НовДок.ИДРодителя = СтруктураГлобальныхПеременных.ТекущаяОбъектнаяСмета.Ссылка;
		КонецЕсли;
		НовДок.Записать();
		СтруктураГлобальныхПеременных.ТекущаяСмета = НовДок.Ссылка;
		ТекСтрока.ССылкаНаДокумент = НовДок.ССылка;

		Если ЗначениеЗаполнено(СтруктураГлобальныхПеременных.ТекущаяОбъектнаяСмета) Тогда
			ТекОбъект = СтруктураГлобальныхПеременных.ТекущаяОбъектнаяСмета.ПолучитьОбъект();
			НоваяСтрока 			= ТекОбъект.ЛокальныеСметы.Добавить();	
			НоваяСтрока.ЛокальнаяСмета = СтруктураГлобальныхПеременных.ТекущаяСмета;
			НоваяСтрока.КоличествоОбъектов = 1;
			НоваяСтрока.НомерПП = ТекСтрока.ИДНомерДокумента;
			НоваяСтрока.Расчет = Истина;
			ТекОбъект.Записать();
		КонецЕсли;
	ИначеЕсли ТипДокументаСмета = "Объектная"  Тогда
		НовДок 					= Документы.СМ_ОбъектнаяСмета.СоздатьДокумент();
		НовДок.Автор 			= Пользователи.ТекущийПользователь();
		НовДок.Наименование 	= ТекСтрока.Наименование;
		НовДок.НомерСметы		= ТекСтрока.НомерСметы;
		НовДок.Заказчик 		= ТекЗаказчик;
		НовДок.Договор			= ТекДоговор;
		НовДок.Подрядчик    	= ТекПодрядчик;
		НовДок.Дата				= ТекСтрока.ДатаДокумента;
		НовДок.Организация		= СтруктураГлобальныхПеременных.Организация;
		НовДок.Стройка		    = СтруктураГлобальныхПеременных.Стройка;
		НовДок.ТипСтроительства = ТекСтрока.ТипСтроительства;
		НовДок.ГлаваССРС 		= НайтиГлаву(ТекСтрока.ТипСтроительства,ТекСтрока.Глава);
		НовДок.ПроводитьОкругление = ТекСтрока.Округлять;
		НовДок.ФорматОкругления = ТекСтрока.ФорматОкругл;
		ДобавитьПодписи(ТекСтрока.НомерДокумента,4,НовДок,ТабПодписи);
	 	Если ЗначениеЗаполнено(СтруктураГлобальныхПеременных.ТекущаяСводнаяСмета) Тогда
			НовДок.ИДРодителя = СтруктураГлобальныхПеременных.ТекущаяСводнаяСмета.Ссылка;
		КонецЕсли;

		НовДок.Записать();
		СтруктураГлобальныхПеременных.ТекущаяОбъектнаяСмета = НовДок.Ссылка;
		ТекСтрока.ССылкаНаДокумент = НовДок.ССылка;
		Если ЗначениеЗаполнено(СтруктураГлобальныхПеременных.ТекущаяСводнаяСмета) Тогда
			ТекОбъект = СтруктураГлобальныхПеременных.ТекущаяСводнаяСмета.ПолучитьОбъект();
			НоваяСтрока 			= ТекОбъект.Сметы.Добавить();	
			НоваяСтрока.Смета = СтруктураГлобальныхПеременных.ТекущаяОбъектнаяСмета;
			НоваяСтрока.НомерПП = ТекСтрока.ИДНомерДокумента;
			НоваяСтрока.Расчет = Истина;
			НоваяСтрока.ГлаваССРС = СтруктураГлобальныхПеременных.ТекущаяОбъектнаяСмета.ГлаваССРС; 
			НоваяСтрока.КоличествоОбъектов = ТекСтрока.КоличествоОбъектов;
			ТекОбъект.Записать();
		КонецЕсли ;
		ИначеЕсли ТипДокументаСмета = "Сводная"  Тогда
		НовДок 					= Документы.СМ_СводнаяСмета.СоздатьДокумент();
		НовДок.Автор 			= ПользователиКлиентСервер.АвторизованныйПользователь();
		НовДок.Наименование 	= ТекСтрока.Наименование;
		НовДок.НомерСметы		= ТекСтрока.НомерСметы;
		НовДок.Заказчик 		= ТекЗаказчик;
		НовДок.Договор			= ТекДоговор;
		НовДок.Подрядчик    	= ТекПодрядчик;
		НовДок.Дата				= ТекСтрока.ДатаДокумента;
		НовДок.Организация		= СтруктураГлобальныхПеременных.Организация;
		НовДок.Стройка		    = СтруктураГлобальныхПеременных.Стройка;
		НовДок.ТипСтроительства = ТекСтрока.ТипСтроительства;
		НовДок.ПроводитьОкругление = ТекСтрока.Округлять;
		НовДок.ФорматОкругления = ТекСтрока.ФорматОкругл;
		ДобавитьПодписи(ТекСтрока.НомерДокумента,5,НовДок,ТабПодписи);

		НовДок.Записать();
		СтруктураГлобальныхПеременных.ТекущаяСводнаяСмета = НовДок.Ссылка;
		ТекСтрока.ССылкаНаДокумент = НовДок.ССылка;
	
	КонецЕсли;
	СтрокаСообщения = СтруктураГлобальныхПеременных.ТабСообщения.Добавить();
	ТекстСообщения = НСтр("ru='Создан документ смета : %1%, %2%'");
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1%", НовДок.НомерСметы);
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "%2%", НовДок.Наименование);
	СтрокаСообщения.ТекстСообщения = ТекстСообщения;		
	
КонецПроцедуры

// Создание нового элемента в справочнике ФизическиеЛица.
Функция СоздатьФизЛицо(ФИО)
	Если Не ЗначениеЗаполнено(ФИО) Тогда Возврат("");
	КонецЕсли;	
	ТекФизЛицо = Справочники.ФизическиеЛица.НайтиПоНаименованию(ФИО,Истина);
	Если ТекФизЛицо = Справочники.ФизическиеЛица.ПустаяСсылка() Тогда
		НовыйОбъект 				= Справочники.ФизическиеЛица.СоздатьЭлемент();
		НовыйОбъект.Наименование 	= ФИО;
		НовыйОбъект.Записать();
		Возврат НовыйОбъект.Ссылка;
	Иначе
		Возврат ТекФизЛицо;
	КонецЕсли;
	
КонецФункции

// Создане нового элемента в справочнике Контрагенты.
Функция СоздатьЭлементКонтрагент(НаименованиеКонтрагента,ТипКонтрагента);
	
	НаименованиеКонтрагента = СокрЛП(НаименованиеКонтрагента);
	Если НЕ ЗначениеЗаполнено(НаименованиеКонтрагента) Тогда
		Если ТипКонтрагента = 1 Тогда
			НаименованиеКонтрагента	= НСтр("ru='Основной заказчик'");			
		ИначеЕсли ТипКонтрагента = 2 Тогда
			НаименованиеКонтрагента	= НСтр("ru='Основной подрядчик'");
		КонецЕсли;
	КонецЕсли;
	
	ТекКонтрагент = Справочники.Контрагенты.НайтиПоНаименованию(НаименованиеКонтрагента,Истина);
	Если ТекКонтрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
		НовыйОбъект 				= Справочники.Контрагенты.СоздатьЭлемент();
		НовыйОбъект.Наименование 	= НаименованиеКонтрагента;
		НовыйОбъект.Записать();
		Возврат НовыйОбъект.Ссылка;
	Иначе
		Возврат ТекКонтрагент;
	КонецЕсли;
	
КонецФункции

// Создане нового элемента в справочнике ДоговорыКонтрагентов.
Функция СоздатьЭлементДоговор(Контрагент,НаименованиеДоговора,НомерДоговора,ДатаДоговора);
	
	НаименованиеДоговора = СокрЛП(НаименованиеДоговора);
	Если НЕ ЗначениеЗаполнено(НаименованиеДоговора) Тогда
		НаименованиеДоговора = НСтр("ru='Основной договор'");			
	КонецЕсли;
	
	ТекДоговор = Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию(НаименованиеДоговора,Истина,Контрагент);
	Если ТекДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка() Тогда
		НовыйОбъект 				= Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		НовыйОбъект.Наименование 	= НаименованиеДоговора;
		НовыйОбъект.Контрагент		= Контрагент;
		НовыйОбъект.Записать();
		Возврат НовыйОбъект.Ссылка;
	Иначе          
		Возврат ТекДоговор;
	КонецЕсли;
	
КонецФункции

// Создане нового элемента в справочнике ТерриториальныеРайоны.
Функция СоздатьЭлементРайон(КодРайона,НаименованиеРайона);	

	Если НЕ ЗначениеЗаполнено(КодРайона) Тогда
		ТекРайон = ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнойРайон");	
	КонецЕсли;
	
	ТекРайон = Справочники.СМ_ТерриториальныеРайоны.НайтиПоКоду(КодРайона,Истина);
	Если ТекРайон = Справочники.СМ_ТерриториальныеРайоны.ПустаяСсылка() Тогда
		НовыйОбъект 				= Справочники.СМ_ТерриториальныеРайоны.СоздатьЭлемент();
		НовыйОбъект.Наименование 	= НаименованиеРайона;
		НовыйОбъект.Код 		 	= КодРайона;
		Если ПустаяСтрока(НовыйОбъект.Код) Тогда
			НовыйОбъект.УстановитьНовыйКод();
		КонецЕсли;
		НовыйОбъект.Записать();
		Возврат НовыйОбъект.Ссылка;
	Иначе
		Возврат ТекРайон;
	КонецЕсли;
	
КонецФункции

// Создать нового документа раздел, как подраздел в разделе.
Процедура СоздатьДокументРазделПодраздел(ТекСтрока,КодСметы,ТабРазделов,НомерСтроки,НомерВПределахСметы,НомерПодраздела,СтруктураГлобальныхПеременных)
	
	НаименованиеРаздела = НСтр("ru='Основной подраздел'");	
	// Добавление в таблицу разделов по смете.
	НоваяСтрока 			= ТабРазделов.Добавить();
	НоваяСтрока.НомерСметы	= СокрЛП(КодСметы);
	ИндексРаздела 			= ТабРазделов.Индекс(НоваяСтрока);	
	НоваяСтрока.УровеньЗаголовка = 2;
	НоваяСтрока.НомерРаздела 		= НомерСтроки;
	НоваяСтрока.НаименованиеРаздела = ТекСтрока;
	НоваяСтрока.КоэффОборуд 		= СтруктураГлобальныхПеременных.ТекущийРаздел.КоэффОборуд;
	НоваяСтрока.КоэффОснЗарплаты 	= СтруктураГлобальныхПеременных.ТекущийРаздел.КоэффОснЗарплаты;
	НоваяСтрока.КоэффПолнСтоимРабот = СтруктураГлобальныхПеременных.ТекущийРаздел.КоэффПолнСтоимРабот;
	НоваяСтрока.КоэффСтоимЭксплМашин	 = СтруктураГлобальныхПеременных.ТекущийРаздел.КоэффСтоимЭксплМашин;
	НоваяСтрока.КоэффСтоимЗарплатеМашин	 = СтруктураГлобальныхПеременных.ТекущийРаздел.КоэффСтоимЗарплатеМашин;

	// Создание нового документа "Раздел ЛС". 
	НовДок							= СМ_СметаВызовСервера.СоздатьНовыйРаздел();
	НовДок.НаименованиеДляПечати 	= ТекСтрока;
	НовДок.Дата						= ТекущаяДатаСеанса();
	
	// В смета Плюс все подзаголовки 2 уровня и подчиняются разделу.
	НовДок.ИДРодителя   			= СтруктураГлобальныхПеременных.ТекущийРаздел.Ссылка;
	НовДок.ИДСметы      			= СтруктураГлобальныхПеременных.ТекущаяСмета.Ссылка;
	НовДок.КоэффОборуд 				= СтруктураГлобальныхПеременных.ТекущийРаздел.КоэффОборуд;
	НовДок.КоэффОснЗарплаты 		= СтруктураГлобальныхПеременных.ТекущийРаздел.КоэффОснЗарплаты;
	НовДок.КоэффПолнСтоимРабот 		= СтруктураГлобальныхПеременных.ТекущийРаздел.КоэффПолнСтоимРабот;
	НовДок.КоэффСтоимЭксплМашин		= СтруктураГлобальныхПеременных.ТекущийРаздел.КоэффСтоимЭксплМашин;
	НовДок.КоэффСтоимЗарплатеМашин	= СтруктураГлобальныхПеременных.ТекущийРаздел.КоэффСтоимЗарплатеМашин;
	НовДок.НомерВПределахСметы 		= НомерВПределахСметы;
	НовДок.ПорНомер 				= НомерСтроки;
	НовДок.Расчет					= Истина;
	НовДок.Записать();
	
	СтруктураГлобальныхПеременных.ТекущийПодраздел = НовДок.Ссылка;
	НоваяСтрока.СсылкаНаДокумент = НовДок.Ссылка;

КонецПроцедуры	

