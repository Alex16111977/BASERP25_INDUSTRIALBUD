Процедура ЗаполнитьНРиСП1984(НовДок,ЧП, Соответствие1984)
	
	КодЧП 			= ЧП.Код;
	ЗначениеЧП 		= Число(ЧП.Значение);
	ФормулаЧП 		= СокрЛП(ЧП.Формула);
	Определитель 	= НовДок.Определитель.Код;
	БезКоэфф 		= НовДок.ИДСметы.БезПримененияКоэффициентов;
	РасчетНРиСПотПЗ = НовДок.ИДСметы.РасчетНРиСПотПЗ;
	МетодСчета 		= НовДок.ИДСметы.МетодРасчета;
	//Мет1984 		= НовДок.ИДСметы.Методика1984; 
	Мет1984 		= Ложь;
	Если НовДок.ИДСметы.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_Методика84года Тогда
		
		Мет1984 = Истина;	
				
	КонецЕсли;
	
	Если Мет1984 И МетодСчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный И РасчетНРиСПотПЗ Тогда 
		Если КодЧП = "53" Тогда
			НовДок.НакладныеРасходыБазисные = ЗначениеЧП;
			НовДок.НакладныеРасходыТекущие = ЗначениеЧП;
		ИначеЕсли КодЧП = "44" Тогда
			НовДок.СметнаяПрибыльБазисные = ЗначениеЧП;
			НовДок.СметнаяПрибыльТекущие = ЗначениеЧП;
		КонецЕсли;	
	КонецЕсли;	
	
	Если Мет1984 И МетодСчета <> Перечисления.СМ_МетодыРасчетаЛС.Ресурсный И РасчетНРиСПотПЗ Тогда 
		Если КодЧП = "30" Тогда
			НовДок.СметнаяПрибыльБазисные = ЗначениеЧП;
			НовДок.СметнаяПрибыльТекущие = ЗначениеЧП;
		КонецЕсли;
	КонецЕсли;	
	
	Если Мет1984 И МетодСчета <> Перечисления.СМ_МетодыРасчетаЛС.Ресурсный И РасчетНРиСПотПЗ И БезКоэфф Тогда 
		Отбор = Новый Структура();
		Отбор.Вставить("КодОпределителя",Определитель);
		Отбор.Вставить("ЧП",КодЧП);
		Строки = Соответствие1984.НайтиСтроки(Отбор);
		Если Строки.Количество() > 0 Тогда
			НовДок.НакладныеРасходыБазисные = ЗначениеЧП;
			НовДок.НакладныеРасходыТекущие = ЗначениеЧП;
		КонецЕсли;	
	КонецЕсли;	
	
	Если Мет1984 И МетодСчета <> Перечисления.СМ_МетодыРасчетаЛС.Ресурсный И РасчетНРиСПотПЗ Тогда 
		Если КодЧП = "35" Тогда
			НовДок.КоэффициентТРвНР = ЗначениеЧП;
		КонецЕсли;
		Если КодЧП = "36" Тогда
			НовДок.КоэффициентОЗвНР = ЗначениеЧП;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры
					
// Заполнение параметров печати документов АктВыполненныхРабот и ЛокальнаяСмета по умолчанию.
Процедура ЗаполнитьПараметрыПечатиПоУмолчанию(НовДок)
	НовДок.ПечататьЗаголовкиРазделов = Истина;
	НовДок.ПечататьИтогиПоРазделам = Перечисления.СМ_ПечатьИтоговРаздела.ПечататьПервые;
	НовДок.ПечататьИтогиПоВидамРабот = Истина;
	НовДок.ПечататьКоэффициентыТЧ  = Истина;
КонецПроцедуры

// Заполнение ТЧ  РесурсыПозицииЛокальнойСметы докумета ПозицияЛокальнойСметы.
Процедура ЗаполнениеРесурсовПозиции(ТабРесурсов,НовДок,ТекстОшибки)
	ГруппаРесурсов = НовДок.РегиональнаяБаза.ГруппаРесурсов;
	Для каждого СтрРесурса Из ТабРесурсов Цикл 
		ТекРесурс = НайтиСоздатьРесурсВСправочнике(СтрРесурса.КодРесурса,СтрРесурса.Наименование,СтрРесурса.ВидРесурса,ГруппаРесурсов,СтрРесурса.ЕдиницаИзмерения,СтрРесурса.Уровень,,ТекстОшибки);
		
		//  Создаем новую строку ресурса в ТЧ.
		НоваяСтрока 					= НовДок.РесурсыПозицииЛокальнойСметы.Добавить();
		НоваяСтрока.СметныйКодРесурса	= СтрРесурса.Кодресурса;

		Если Не ТекРесурс = Справочники.СМ_Ресурсы.ПустаяСсылка() Тогда
			НоваяСтрока.Ресурс              = ТекРесурс.Ссылка;
			НоваяСтрока.ВидРесурса = ТекРесурс.ВидРесурса;
		Иначе
			НоваяСтрока.ВидРесурса = СтрРесурса.ВидРесурса;
		КонецЕсли;
		НоваяСтрока.ТипМатериала = СтрРесурса.ПризнакТипа;
		НоваяСтрока.НаименованиеРесурса = СтрРесурса.Наименование;
		НоваяСтрока.ЕдиницаИзмеренияРесурса = СтрРесурса.ЕдиницаИзмерения;
		
		
		НоваяСтрока.НормаРасхода                    = СтрРесурса.НормаРасхода;
		НоваяСтрока.БазиснаяЦена                    = СтрРесурса.ЦенаЕдиницыБазовая;
		НоваяСтрока.БазиснаяЗарплатаМашинистов	  	= СтрРесурса.ЗПМашинистовБазовая;
		НоваяСтрока.ТекущаяЦена                     = СтрРесурса.ЦенаЕдиницыТекущая;
		НоваяСтрока.ТекущаяЗарплатаМашинистов       = СтрРесурса.ЗПМашинистовТекущая;
		НоваяСтрока.КоэффициентКРасходуРесурсов   = СтрРесурса.КоэффициентКРасходуРесурсов;
		
	КонецЦикла;

КонецПроцедуры

// Заполнение таблиц для создания докунта АктВыполненных работ. 
//  Из файлов   POSTOOLS.DBF, EXECUTE.DBF.
Процедура ЗаполнениеТаблицыВыполнения(СтрокаАкта,ТабВыполнение,Выполнение,ФайлИндексовРесурсов,ТабПозиций)
	// Выбрать Позиции сметы.
	ФайлИндексовРесурсов.ТекущийИндекс = ФайлИндексовРесурсов.Индексы.IDXPOS;
	Отбор = Новый Структура();
	Отбор.Вставить("НомерСметы",СтрокаАкта.КодСметы);
	МассивСтрок = ТабПозиций.НайтиСтроки(Отбор);
	Если МассивСтрок.Количество() > 0 Тогда 
		Для каждого СтрокаПозиции Из МассивСтрок Цикл
			CODE = СтрокаПозиции.CODE;
			ФайлИндексовРесурсов.Ключ.POSCODE =  CODE;
			Если ФайлИндексовРесурсов.НайтиПоКлючу("=")= Истина Тогда
				Пока Не ФайлИндексовРесурсов.ВКонце() Цикл
					Если (ФайлИндексовРесурсов.ID = 1) И ФайлИндексовРесурсов.POSCODE = СтрокаПозиции.CODE Тогда
						// Выполнение Позиции.
						КлючПоиска = ФайлИндексовРесурсов.ПолучитьЗначениеПоля("CODE");
						Выполнение.ТекущийИндекс = Выполнение.Индексы.IDXCODE;
						КодПозиции = ФайлИндексовРесурсов.ПолучитьЗначениеПоля("POSCODE");
						Выполнение.Ключ.CODE = КлючПоиска;
						Выполнение.Первая();
						Если Выполнение.НайтиПоКлючу("=")= Истина Тогда
							Пока Не Выполнение.ВКонце() Цикл
								КодАкта = Выполнение.ПолучитьЗначениеПоля("AKTCODE");
								Если КодАкта = СтрокаАкта.НомерДокумента Тогда
									НоваяСтрока = ТабВыполнение.Добавить();
									НоваяСтрока.CODE = КодПозиции;
									НоваяСтрока.Акт = СтрокаАкта.НомерДокумента;
									НоваяСтрока.НормОбъем = Выполнение.ПолучитьЗначениеПоля("NORM");
									НоваяСтрока.ФактОбъем = Выполнение.ПолучитьЗначениеПоля("FACT");
									НоваяСтрока.ТекущаяЦена = Выполнение.ПолучитьЗначениеПоля("TEKCENA");
									НоваяСтрока.ТекущаяЗПМ = Выполнение.ПолучитьЗначениеПоля("TEKZPM");
									НоваяСтрока.КоэффОснЗарплаты = Выполнение.ПолучитьЗначениеПоля("INDZP");
									НоваяСтрока.КоэффСтоимЭксплМашин = Выполнение.ПолучитьЗначениеПоля("INDMM");
									НоваяСтрока.КоэффСтоимЗарплатеМашин = Выполнение.ПолучитьЗначениеПоля("INDMM");
									НоваяСтрока.КоэффСтоимМатериалов = Выполнение.ПолучитьЗначениеПоля("INDSM");
									НоваяСтрока.КоэффОборуд = Выполнение.ПолучитьЗначениеПоля("INDPS");
									НоваяСтрока.КоэффПолнСтоимРабот = Выполнение.ПолучитьЗначениеПоля("INDPS");
									Прервать;
								КонецЕсли;
								Выполнение.Следующая();
							КонецЦикла;
						КонецЕсли;
					КонецЕсли;
					ФайлИндексовРесурсов.Следующая();
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры	

// Заполнение таблиц для создания докунта АктВыполненных работ. 
//  Из файла   POSTOOLS.DBF, RASTBL.DBF.
Процедура ЗаполнениеТаблицыРасхода(СтрокаАкта,ТабРасхода,Расход,ФайлИндексовРесурсов,ТабПозиций)
	// Выбрать Позиции сметы
	ФайлИндексовРесурсов.ТекущийИндекс = ФайлИндексовРесурсов.Индексы.IDXPOS;
	Отбор = Новый Структура();
	Отбор.Вставить("НомерСметы",СтрокаАкта.КодСметы);
	МассивСтрок = ТабПозиций.НайтиСтроки(Отбор);
	Если МассивСтрок.Количество() > 0 Тогда 
		Для каждого СтрокаПозиции Из МассивСтрок Цикл
			CODE = СтрокаПозиции.CODE;
			ФайлИндексовРесурсов.Ключ.POSCODE =  CODE;
			Если ФайлИндексовРесурсов.НайтиПоКлючу("=")= Истина Тогда
				Пока Не ФайлИндексовРесурсов.ВКонце() Цикл
					Если (ФайлИндексовРесурсов.ID = 2) И ФайлИндексовРесурсов.POSCODE = СтрокаПозиции.CODE Тогда
						// Расход ресурсов Позиции.
						КлючПоиска = ФайлИндексовРесурсов.ПолучитьЗначениеПоля("CODE");
						Расход.ТекущийИндекс = Расход.Индексы.IDXCODE;
						КодПозиции = ФайлИндексовРесурсов.ПолучитьЗначениеПоля("POSCODE");
						Расход.Ключ.CODE = КлючПоиска;
						Расход.Первая();
						Пока Не Расход.ВКонце() Цикл
							КодАкта = Расход.ПолучитьЗначениеПоля("AKTCODE"); 
							КодРасхода = Расход.ПолучитьЗначениеПоля("CODE"); 
							Если КодАкта = СтрокаАкта.НомерДокумента
								И КодРасхода = КлючПоиска Тогда
								НоваяСтрока = ТабРасхода.Добавить();
								НоваяСтрока.CODE = СтрокаПозиции.CODE;
								НоваяСтрока.СсылкаНаДокумент = СтрокаПозиции.СсылкаНаДокумент;
								НоваяСтрока.Акт = КодАкта;
								НоваяСтрока.КодРесурса = Расход.ПолучитьЗначениеПоля("RES");
								НоваяСтрока.Наименование = Расход.ПолучитьЗначениеПоля("RESNAME");
								НоваяСтрока.НормРасход = Расход.ПолучитьЗначениеПоля("NORM");
								НоваяСтрока.ФактРасход = Расход.ПолучитьЗначениеПоля("FACT");
								НоваяСтрока.ТекущаяЦена = Расход.ПолучитьЗначениеПоля("PRICE");
								НоваяСтрока.ТекущаяЦенаЗПМ = Расход.ПолучитьЗначениеПоля("PRICMASH");
								НоваяСтрока.ПризнакТипа = Расход.ПолучитьЗначениеПоля("MESTN");
							КонецЕсли;
							Расход.Следующая();
						КонецЦикла;
					КонецЕсли;
					ФайлИндексовРесурсов.Следующая();
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры	

Функция ПроверитьФормулуПоправки(ФормулаПоправки)
	ФормулаПоправки = СокрЛП(ФормулаПоправки);	
	ПоследнийЗнак = Прав(ФормулаПоправки,1);
	Если ПоследнийЗнак = "*" Или ПоследнийЗнак = "+" Или ПоследнийЗнак = "/"  Или ПоследнийЗнак = "-" Тогда
		ФормулаПоправки = Лев(ФормулаПоправки,СтрДлина(ФормулаПоправки) - 1);
	КонецЕсли;
	Возврат(ФормулаПоправки);
КонецФункции

// Заполнение поправочных коэффициентов в ТЧ ПоправкиПозиции документа ПозицияЛокальнойСметы.
Процедура ЗаполнениеПоправочныхКоэффициентов(ТекСтрока,НовДок)

	ПоправкаОЗ = ПроверитьФормулуПоправки(ПолучитьФормулу(ТекСтрока.Формулы,"ОЗ",""));
	ПоправкаПЗ = ПроверитьФормулуПоправки(ПолучитьФормулу(ТекСтрока.Формулы,"ПЗ",""));
	ПоправкаЭМ = ПроверитьФормулуПоправки(ПолучитьФормулу(ТекСтрока.Формулы,"ЭМ",""));
	ПоправкаЗМ = ПроверитьФормулуПоправки(ПолучитьФормулу(ТекСтрока.Формулы,"ЗМ",""));
	ПоправкаСМ = ПроверитьФормулуПоправки(ПолучитьФормулу(ТекСтрока.Формулы,"СМ",""));
	ПоправкаВМ = ПроверитьФормулуПоправки(ПолучитьФормулу(ТекСтрока.Формулы,"ВМ",""));
	ПоправкаТР = ПроверитьФормулуПоправки(ПолучитьФормулу(ТекСтрока.Формулы,"ТР",""));
	ПоправкаТМ = ПроверитьФормулуПоправки(ПолучитьФормулу(ТекСтрока.Формулы,"ТМ",""));
	ЗаполненоПЗ = Истина;
	ВариантРасчетаЭММ = ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ВариантРасчетаЭксплуатацииМашин");	

	Если ЗначениеЗаполнено(ПоправкаПЗ) Тогда
		НоваяСтрока 			= НовДок.ПоправкиПозиции.Добавить();	
		НоваяСтрока.Применить 	= Истина;
		НоваяСтрока.Обоснование = "";
		НоваяСтрока.Справка		= "";
		ТекПЗ = 0;
		Формула = "ТекПЗ = " + ПоправкаПЗ;
		Попытка
			Выполнить(Формула);
		Исключение
		КонецПопытки ;
		НоваяСтрока.КоэффПЗ 		= ТекПЗ;
		НоваяСтрока.ВариантРасчета 	= ВариантРасчетаЭММ;
		НоваяСтрока.ТипПоправки 	= Перечисления.СМ_ТипыПоправок.ТехчастиСборников;
		ЗаполненоПЗ = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПоправкаОЗ) Или ЗначениеЗаполнено(ПоправкаЭМ)
		Или ЗначениеЗаполнено(ПоправкаЗМ) Или ЗначениеЗаполнено(ПоправкаСМ)
		Или ЗначениеЗаполнено(ПоправкаТР) Или ЗначениеЗаполнено(ПоправкаТМ) Тогда
		НоваяСтрока 				= НовДок.ПоправкиПозиции.Добавить();	
		НоваяСтрока.Применить 		= ЗаполненоПЗ;
		НоваяСтрока.ВариантРасчета 	= ВариантРасчетаЭММ;
		НоваяСтрока.ТипПоправки 	= Перечисления.СМ_ТипыПоправок.ТехчастиСборников;

		Если ЗначениеЗаполнено(ТекСтрока.Поправки) Тогда
			НоваяСтрока.Справка = СобратьШифры(ТекСтрока.Поправки);
		Иначе
			НоваяСтрока.Справка = "";
		КонецЕсли;	
		НоваяСтрока.Обоснование		= "";
		
		Если ЗначениеЗаполнено(ПоправкаОЗ) Тогда
			ТекОЗ = 0;
			Формула = "ТекОЗ = " + ПоправкаОЗ;
			Попытка
				Выполнить(Формула);
			Исключение
			КонецПопытки ;
			НоваяСтрока.КоэффОЗ = ТекОЗ;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПоправкаЭМ) Тогда
			ТекЭМ = 0;
			Формула = "ТекЭМ = " + ПоправкаЭМ;
			Попытка
				Выполнить(Формула);
			Исключение
			КонецПопытки ;
			НоваяСтрока.КоэффЭМ = ТекЭМ;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПоправкаЗМ) Тогда
			ТекЗМ = 0;
			Формула = "ТекЗМ = " + ПоправкаЗМ;
			Попытка
				Выполнить(Формула);
			Исключение
			КонецПопытки ;
			НоваяСтрока.КоэффЗМ = ТекЗМ;
		Иначе
			Если ЗначениеЗаполнено(ПоправкаЭМ) Тогда
				ТекЗМ = 0;
				Формула = "ТекЗМ = " + ПоправкаЭМ;
				Попытка
					Выполнить(Формула);
				Исключение
				КонецПопытки ;
				НоваяСтрока.КоэффЗМ = ТекЗМ;
			КонецЕсли;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПоправкаСМ) Тогда
			ТекСМ = 0;
			Формула = "ТекСМ = " + ПоправкаСМ;
			Попытка
				Выполнить(Формула);
			Исключение
			КонецПопытки ;
			НоваяСтрока.КоэффСМ = ТекСМ;
		КонецЕсли;
		
		//Если ЗначениеЗаполнено(ПоправкаВМ) Тогда
		//	ТекВМ = 0;
		//	Формула = "ТекВМ = " + ПоправкаВМ;
		//	Попытка
		//		Выполнить(Формула);
		//	Исключение
		//	КонецПопытки ;
		//	НоваяСтрока.КоэффВМ = ТекВМ;
		//КонецЕсли;
		
		Если ЗначениеЗаполнено(ПоправкаТР) Тогда
			ТекТР = 0;
			Формула = "ТекТР = " + ПоправкаТР;
			Попытка
				Выполнить(Формула);
			Исключение
			КонецПопытки ;
			НоваяСтрока.КоэффТР = ТекТР;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПоправкаТМ) Тогда
			ТекТМ = 0;
			Формула = "ТекТМ = " + ПоправкаТМ;
			Попытка
				Выполнить(Формула);
			Исключение
			КонецПопытки ;
			НоваяСтрока.КоэффТМ = ТекТМ;
		Иначе
			Если ЗначениеЗаполнено(ПоправкаЭМ) Тогда
				ТекТМ = 0;
				Формула = "ТекТМ = " + ПоправкаЭМ;
				Попытка
					Выполнить(Формула);
				Исключение
				КонецПопытки ;
				НоваяСтрока.КоэффТМ = ТекТМ;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;	
	Если ЗначениеЗаполнено(ТекСтрока.БазисКОЗ)
		Или ЗначениеЗаполнено(ТекСтрока.БазисКЭМ)
		Или ЗначениеЗаполнено(ТекСтрока.БазисКЗМ)
		Или ЗначениеЗаполнено(ТекСтрока.БазисКСМ)  Тогда
		НоваяСтрока 			= НовДок.ПоправкиПозиции.Добавить();	
		НоваяСтрока.Применить 	= Истина;
		НоваяСтрока.ВариантРасчета = Перечисления.СМ_ВариантыРасчетаЭММ.Разные;
		НоваяСтрока.Справка = НСтр("ru='Базисные коэффициенты перехода от ФЕР к ТЕР'");
		НоваяСтрока.Обоснование		= "";
		НоваяСтрока.ТипПоправки 	= Перечисления.СМ_ТипыПоправок.ТехчастиСборников;
		НоваяСтрока.КоэффОЗ  = ТекСтрока.БазисКОЗ;
		НоваяСтрока.КоэффЭМ  = ТекСтрока.БазисКЭМ;
		НоваяСтрока.КоэффЗМ  = ТекСтрока.БазисКЗМ;
		НоваяСтрока.КоэффСМ  = ТекСтрока.БазисКСМ;
	КонецЕсли;	
	
КонецПроцедуры

// Заполнение коэффициентов в ТЧ  КоэффициентыПересчета документа ПозицияЛокальнойСметы.
Процедура ЗаполнениеКоэффициентовПозиции(ТекСтрока,новДок,СтруктураГлобальныхПеременных)
	Если ЗначениеЗаполнено(ТекСтрока.КоэффОснЗарплаты)
		Или ЗначениеЗаполнено(ТекСтрока.КоэффСтоимЭксплМашин)
		Или ЗначениеЗаполнено(ТекСтрока.КоэффСтоимЗарплатеМашин)
		Или ЗначениеЗаполнено(ТекСтрока.КоэффСтоимМатериалов)
		Или ЗначениеЗаполнено(ТекСтрока.КоэффПолнСтоимРабот) Тогда
		НоваяСтрока 			= НовДок.КоэффициентыПересчета.Добавить();	
		НоваяСтрока.ВариантПересчетаЭММ = СтруктураГлобальныхПеременных.ТекущаяСмета.ВариантПересчетаЭММ;
		Если НоваяСтрока.ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Одинаковые Тогда
			НоваяСтрока.КоэффСтоимЗарплатеМашин = ТекСтрока.КоэффСтоимЗарплатеМашин;
		Иначе
			НоваяСтрока.КоэффСтоимЗарплатеМашин = ТекСтрока.КоэффОснЗарплаты;
		КонецЕсли;
		НоваяСтрока.КоэффОснЗарплаты = ТекСтрока.КоэффОснЗарплаты;
		НоваяСтрока.КоэффСтоимЭксплМашин = ТекСтрока.КоэффСтоимЭксплМашин;
		НоваяСтрока.КоэффСтоимМатериалов  = ТекСтрока.КоэффСтоимМатериалов;
		Если НовДок.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование Тогда
			НоваяСтрока.КоэффОборуд  = ТекСтрока.КоэффПолнСтоимРабот;
		Иначе
			НоваяСтрока.КоэффПолнСтоимРабот  = ТекСтрока.КоэффПолнСтоимРабот;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедуыИФункции

// Получение имени файла для ДБФ файлов, имя не должно быть более 8 символов.
Функция ПолучитьИмяФайла(Расширение)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	ИмяВременногоФайла = СтрЗаменить(ИмяВременногоФайла,"_","");
	КаталогФайла = "";
	ИмяБезРасширения = "";
	Файл = Новый Файл(ИмяВременногоФайла);
	КаталогФайла = Файл.Путь;
	ИмяБезРасширения = Файл.ИмяБезРасширения;
	ДлинаИмени = СтрДлина(ИмяБезРасширения);
	Если ДлинаИмени > 8 Тогда
		ИмяБезРасширения = Прав(ИмяБезРасширения,8);
		ИмяВременногоФайла = КаталогФайла + ИмяБезРасширения + "." + Расширение;
	КонецЕсли;	
	Возврат ИмяВременногоФайла;
КонецФункции	

// Удаление временных файлов
Процедура УдалениеФайлов(СписокИменВременныхФайлов)
	
	СообщенияДляЖурнала	= Новый СписокЗначений();
	
	Для Каждого СтрокаФайла из СписокИменВременныхФайлов Цикл
		СтрокаИмениФайла = СтрокаФайла.СтрокаИмениФайла;
		СтрокаИмениФайлаИндекса = СтрокаФайла.СтрокаИмениФайлаИндекса;
		ВыбФайл = Новый Файл(СтрокаИмениФайла);
		Если ВыбФайл.Существует() Тогда
			Попытка
				УдалитьФайлы(СтрокаИмениФайла);  
			Исключение
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
				
				СтруктураСообщения 	= Новый Структура;
				СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате Смета Плюс'"));
				СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
				СтруктураСообщения.Вставить("Комментарий",ОписаниеОшибки());
				СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
				СообщенияДляЖурнала.Добавить(СтруктураСообщения);
			КонецПопытки;
		КонецЕсли;
		Если СтрокаИмениФайлаИндекса <> Неопределено Тогда
			ВыбФайл = Новый Файл(СтрокаИмениФайлаИндекса);
			Если ВыбФайл.Существует() Тогда
				Попытка
					УдалитьФайлы(СтрокаИмениФайлаИндекса);  
				Исключение
					//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
					
					СтруктураСообщения 	= Новый Структура;
					СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате Смета Плюс'"));
					СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
					СтруктураСообщения.Вставить("Комментарий",ОписаниеОшибки());
					СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
					СообщенияДляЖурнала.Добавить(СтруктураСообщения);
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Запись сообщений в журнал регистрации
	ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
	
КонецПроцедуры
	
// Добавление в список созданных временных файлов
Процедура ДобавитьВСписок(СписокИменВременныхФайлов, ИмяВременногоФайла, ИмяВременногоФайлаИнд = Неопределено);

		СтрокаСписка = СписокИменВременныхФайлов.Добавить();
		СтрокаСписка.СтрокаИмениФайла = ИмяВременногоФайла;
		СтрокаСписка.СтрокаИмениФайлаИндекса = ИмяВременногоФайлаИнд;
КонецПроцедуры
	
// Определенме типа записи в файле SMETA.DBF.
Процедура ОпределитьТип(ФайлСмета,ТипДокументаСмета,КодГлавнойСметы)
	Тип = ФайлСмета.ПолучитьЗначениеПоля("ID");
	Если Тип = 6 Тогда ТипДокументаСмета = "Папка";   
	ИначеЕсли Тип = 5 Тогда ТипДокументаСмета = "Сводная"; 
	ИначеЕсли Тип = 4 Тогда ТипДокументаСмета = "Объектная"; 
	ИначеЕсли Тип = 0 Тогда ТипДокументаСмета = "Локальная"; 
	ИначеЕсли Тип = 2 Тогда ТипДокументаСмета = "Раздел"; 
	ИначеЕсли Тип = 3 Тогда ТипДокументаСмета = "Позиция"; 
	КонецЕсли; 
	Попытка
		КодГлавнойСметы = ФайлСмета.ПолучитьЗначениеПоля("PRINCODE");
	Исключение
		КодГлавнойСметы = "";
	КонецПопытки;	
КонецПроцедуры

// Определение Метода счета в передаваемых архивах.
Функция ОпределитьМетод(ТекМетод)
	Результат = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный;
	Если ТекМетод = 4 Тогда
		Результат = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный;
	КонецЕсли;
	Возврат(Результат);
КонецФункции	

// Определение Уровня задания индексов для БазисноИндексного метода. 
Функция ОпределитьУровень(ТекМетод)
	Результат = Перечисления.СМ_УровеньЗаданияИндексов.Расценка;
	Если ТекМетод = 5 Тогда
		Результат = Перечисления.СМ_УровеньЗаданияИндексов.Раздел;
	КонецЕсли;
	Если ТекМетод = 7 Или ТекМетод = 6 Тогда
		Результат = Перечисления.СМ_УровеньЗаданияИндексов.Смета;
	КонецЕсли;	
	Возврат(Результат);
КонецФункции

// Определение способа расчета индексов для БазисноИндексный метода. 
Функция ОпределитьСпособРасчетаИндексов(ТекМетод)
	Результат = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат;
	Если ТекМетод = 1 Или ТекМетод = 6 Тогда
		Результат = Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости;
	КонецЕсли;
	Возврат(Результат);
КонецФункции	

// Заполнение ТЧ Подписи в документах ЛокальнаяСмета, ОбъектнаяСмета, СводнаяСмета.
Процедура ДобавитьПодписи(CODE,ID,НовДок,ТабПодписи)
	Отбор = Новый Структура();
	Отбор.Вставить("CODE",СокрЛП(CODE));
	Отбор.Вставить("ID",ID);
	СтрокиПодписей = ТабПодписи.НайтиСтроки(Отбор);
	Если СтрокиПодписей.Количество() > 0 Тогда 
		Для каждого СтрокаПодписи Из СтрокиПодписей Цикл
			ТчПодписи = НовДок.Подписи.Добавить();
			ТЧПодписи.ВыводитьВШапку = СтрокаПодписи.ДляШапки;
			Если ЗначениеЗаполнено(СтрокаПодписи.СогасованоУтверждаю) Тогда
				ТЧПодписи.Статус = СтрокаПодписи.СогасованоУтверждаю;
			Иначе
				ТЧПодписи.Статус = СтрокаПодписи.Должность;
			КонецЕсли;	
			ТекФизЛицо = СоздатьФизЛицо(СтрокаПодписи.ФИО);
			ТЧПодписи.ФИО = ТекФизЛицо;
			ТЧПодписи.Должность =СтрокаПодписи.Должность; 
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
	
// Разбор Строки с индексами для раздела документа АктВыполненныхРабот.
Процедура НайтиИндексыРаздела(Стр,Наименование,КоэффОЗ,КоэффПС,КоэффЭМ,КоэффСМ)
	ИндексыРазделов = Стр.ОписаниеИндексовРазделов;	
	Разделитель = "#";
	Поз = Найти(ИндексыРазделов,Наименование);
	Если Поз <> 0 Тогда
		СтрокаИндексов = Сред(ИндексыРазделов,Поз + СтрДлина(Наименование));
		Для сч = 1 По 6 Цикл
			Врем = Найти(СтрокаИндексов,Разделитель); 
			Если Врем = 0 Тогда
				СтрокаИндексов = "";
				Прервать;
			КонецЕсли;
			Если Врем > 0 Тогда  
				Если Сч = 1 Тогда
					
					СтрокаИндексов = Сред(СтрокаИндексов,Врем + 1); 
				ИначеЕсли Сч = 2 Тогда
					СтрокаИндексов = Сред(СтрокаИндексов,Врем + 1); 
				ИначеЕсли Сч = 3 Тогда
					КоэффОЗ = Число(Сред(СтрокаИндексов,1,Врем - 1));
					СтрокаИндексов = Сред(СтрокаИндексов,Врем + 1); 
				ИначеЕсли Сч = 4 Тогда
					КоэффЭМ = Сред(СтрокаИндексов,1,Врем - 1);
					СтрокаИндексов = Сред(СтрокаИндексов,Врем + 1); 
				ИначеЕсли Сч = 5 Тогда
					КоэффСМ = Сред(СтрокаИндексов,1,Врем - 1);
					СтрокаИндексов = Сред(СтрокаИндексов,Врем + 1); 
				ИначеЕсли Сч = 6 Тогда
					КоэффПС = Сред(СтрокаИндексов,1,Врем - 1);
					СтрокаИндексов = Сред(СтрокаИндексов,Врем + 1); 
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры	
	         
// Загрузка ТЧ ЛимитированныеЗатраты в документе АктВыполненныхРабот.
Процедура ЗагрузкаЛимЗатратПоАкту(НовДок,ФайлЛимЗатр,ТабЛимЗатраты,КодСметы,СтруктураГлобальныхПеременных)
	
	Пробелы 			= "     ";
	СтрокаНомераАкта 	= СокрЛП(НовДок.НомерАкта);
	Дл 					= СтрДлина(СтрокаНомераАкта);
	СтрокаНомера 		= Прав(Пробелы,5-ДЛ) + СтрокаНомераАкта;
	ИндексДокумента 	= "6" + "+" + СокрП(КодСметы) + "+" + СтрокаНомера; 
	ЗаполнениеТаблицыЛимЗатрат(ФайлЛимЗатр,ТабЛимЗатраты,ИндексДокумента,СтруктураГлобальныхПеременных);
	Если ТабЛимЗатраты.Количество() <> 0 Тогда
		
		Для Каждого СтрТабл Из ТабЛимЗатраты Цикл
			ТекЛимЗатрата = Справочники.СМ_ЛимитированныеЗатраты.НайтиПоНаименованию(СтрТабл.Наименование);
			Если ТекЛимЗатрата = Справочники.СМ_ЛимитированныеЗатраты.ПустаяСсылка() Тогда
				СтруктураОтбора = Новый Структура;
				СтруктураОтбора.Вставить("НаименованиеЛЗ",СокрЛП(СтрТабл.Наименование));
				СтруктураОтбора.Вставить("Загружать",Истина);
				СоответствиеЛимЗатрат = Новый ТаблицаЗначений;
				СоответствиеЛимЗатрат =  СтруктураГлобальныхПеременных.СоответствияЛЗ;
				МассивСтрок = СоответствиеЛимЗатрат.НайтиСтроки(СтруктураОтбора);
				Если МассивСтрок.Количество() > 0 Тогда
					ТекЛимЗатрата = МассивСтрок[0].СсылкаВБазе;			
				КонецЕсли;
			КонецЕсли;
			
			Если ТекЛимЗатрата = Справочники.СМ_ЛимитированныеЗатраты.ПустаяСсылка() Тогда
				Продолжить;
			КонецЕсли;

			СтрЛЗ = НовДок.ЛимитированныеЗатраты.Добавить();
			СтрЛЗ.ЛимитированнаяЗатрата               = ТекЛимЗатрата;
			СтрЛЗ.КоэффициентСметнойЗарплаты 	    	= СтрТабл.КоэффициентСметнойЗарплаты;
			СтрЛЗ.КоэффициентТрудоемкости     		= СтрТабл.КоэффициентТрудоемкости;
			СтрЛЗ.Примечание                          = СтрТабл.Примечание;
			СтрЛЗ.Расчет 								= ?(СтрТабл.Расчет = 1,Истина,Ложь);
			СтрЛЗ.ЗначениеЛимЗатраты 					= СтрТабл.ЗначениеЛимЗатраты;
			СтрЛЗ.ФормулаЛимЗатраты  					= СтрТабл.ФормулаЛимЗатраты;
			СтрЛЗ.БазисноеЗначениеЛимЗатраты 			= СтрТабл.БазисноеЗначениеЛимЗатраты;
			СтрЛЗ.ФормулаБазисногоЗначениеЛимЗатраты	= СтрТабл.ФормулаБазисногоЗначениеЛимЗатраты;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
	
// Нахождение ссылки на элемент справочника ГлавыССРС по типу строительства.
Функция  НайтиГлаву(ТипСтроительства,Глава)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГлавыССРС.Ссылка
		|ИЗ
		|	Справочник.СМ_ГлавыССРС КАК ГлавыССРС
		|ГДЕ
		|	ГлавыССРС.ТипСтроительства = &ТипСтроительства
		|	И ГлавыССРС.НомерГлавы = &Код";

	Запрос.УстановитьПараметр("Код", Глава - 1);
	Запрос.УстановитьПараметр("ТипСтроительства", ТипСтроительства);

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество()>0 Тогда
		ТекГлава  = РезультатЗапроса[0].Ссылка;
	Иначе
		ТекГлава = Справочники.СМ_ГлавыССРС.ПустаяСсылка();
	КонецЕсли;
	Возврат ТекГлава;
КонецФункции	

// Определение типа сборника.
Функция ОпределитьТипСборника(ТекТип)
	ТипСборника = "";
	ТипСборника = СМ_СметаЗагрузкаВызовСервера.ОпределитьТипНормСборникаПоКоду(ТекТип);
	Возврат(ТипСборника);
КонецФункции

// Разбор строки коэффициентов на составляющие ее коэффициенты.
Процедура РазобратьСтрокуКоэффициентов(К1,К2,К3,К4,СтрокаКоэфф)	
	К1 = 0;
	К2 = 0;
	К3 = 0;
	К4 = 0;
	ТекСтрокаКоэфф  =  СтрокаКоэфф;
	Поз = Найти(ТекСтрокаКоэфф,"*");
	Если Поз = 0 Тогда
		К1 = ПреобразоватьВЧисло(ТекСтрокаКоэфф);
	Иначе
		К1 = ПреобразоватьВЧисло(Сред(ТекСтрокаКоэфф,1,Поз - 1));
		ТекСтрокаКоэфф = Сред(ТекСтрокаКоэфф,Поз + 1);
		Поз = Найти(ТекСтрокаКоэфф,"*");
		Если Поз <> 0 Тогда
			К2 = ПреобразоватьВЧисло(Сред(ТекСтрокаКоэфф,1,Поз - 1));
			ТекСтрокаКоэфф = Сред(ТекСтрокаКоэфф,Поз + 1);
			Поз = Найти(ТекСтрокаКоэфф,"*");
			Если Поз <> 0 Тогда
				К3 = ПреобразоватьВЧисло(Сред(ТекСтрокаКоэфф,1,Поз - 1));
				ТекСтрокаКоэфф = Сред(ТекСтрокаКоэфф,Поз + 1);
				Если СтрДлина(ТекСтрокаКоэфф) <> 0 Тогда
					К4 = ПреобразоватьВЧисло(ТекСтрокаКоэфф);
				КонецЕсли;
			Иначе
				К3 = ПреобразоватьВЧисло(ТекСтрокаКоэфф);
			КонецЕсли;
		Иначе
			К2 = ПреобразоватьВЧисло(ТекСтрокаКоэфф);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры			

// Применение полученных коэффициентов к Нр и СП от типа строительства сметы.
//  УСН и АЭС.
Процедура ПрименитьКоэфф(ТекКоэфф,ТекОбъект,ТипЧП)
	
	КоэффНРРемонтТек  		= Константы.СМ_КоэффициентНРтекущийРемонт.Получить();
	КоэффНРРемонтБаз  		= Константы.СМ_КоэффициентНРбазисныйРемонт.Получить();
	КоэффНРАЭСБаз  			= Константы.СМ_КоэффициентНРбазисныйАЭС.Получить();
	КоэффНРАЭСТек  			= Константы.СМ_КоэффициентНРтекущийАЭС.Получить();
	КоэффНРУСНТек  			= Константы.СМ_КоэффициентНРтекущийУСН.Получить();
	КоэффНРУСНБаз  			= Константы.СМ_КоэффициентНРбазисныйУСН.Получить();
	КоэффНРПопрТек  		= Константы.СМ_ПоправочныйКоэффициентНРТекущий.Получить();
	КоэффНРПопрБаз  		= Константы.СМ_ПоправочныйКоэффициентНРБазисный.Получить();
	
	КоэффСПРемонтТек  		= Константы.СМ_КоэффициентСПтекущийРемонт.Получить();
	КоэффСПРемонтБаз  		= Константы.СМ_КоэффициентСПбазисныйРемонт.Получить();
	КоэффСПАЭСБаз  			= Константы.СМ_КоэффициентСПбазисныйАЭС.Получить();
	КоэффСПАЭСТек  			= Константы.СМ_КоэффициентСПтекущийАЭС.Получить();
	КоэффСПУСНТек  			= Константы.СМ_КоэффициентСПтекущийУСН.Получить();
	КоэффСПУСНБаз  			= Константы.СМ_КоэффициентСПбазисныйУСН.Получить();
	КоэффСППопрТек  		= Константы.СМ_ПоправочныйКоэффициентСПТекущий.Получить();
	КоэффСППопрБаз  		= Константы.СМ_ПоправочныйКоэффициентСПБазисный.Получить();
	КНайден = Ложь;
	
	Если ТипЧП = "НРТекущий" Тогда
		Если ТекКоэфф <> 0 И ТекКоэфф = КоэффНРПопрТек Тогда
			ТекОбъект.ПоправочныйКоэффициентКНРТекущий = ТекКоэфф;
			КНайден = Истина;
		КонецЕсли;	
		Если ТекКоэфф <> 0 И ТекКоэфф = КоэффНРРемонтТек Тогда
			ТекОбъект.КоэффициентКНРНаРемонтТекущий = ТекКоэфф;
			КНайден = Истина;
		КонецЕсли;	
		Если ТекКоэфф <> 0 И ТекКоэфф = КоэффНРАЭСТек Тогда
			ТекОбъект.КоэффициентКНРАЭСТекущий = ТекКоэфф;
			КНайден = Истина;
		КонецЕсли;	
		Если ТекКоэфф <> 0 И ТекКоэфф = КоэффНРУСНТек Тогда
			ТекОбъект.КоэффициентКНРУСНТекущий = ТекКоэфф;
			КНайден = Истина;
		КонецЕсли;
		Если ТекКоэфф <> 0 И КНайден = Ложь Тогда
			ТекОбъект.ПоправочныйКоэффициентКНРТекущий = ТекКоэфф * ?(ТекОбъект.ПоправочныйКоэффициентКНРТекущий = 0,1,ТекОбъект.ПоправочныйКоэффициентКНРТекущий);	
		КонецЕсли;
	ИначеЕсли ТипЧП = "НРБазисный" Тогда
		Если ТекКоэфф <> 0 И ТекКоэфф = КоэффНРПопрБаз Тогда
			ТекОбъект.ПоправочныйКоэффициентКНРБазисный = ТекКоэфф;
			КНайден = Истина;
		КонецЕсли;	
		Если ТекКоэфф <> 0 И ТекКоэфф = КоэффНРРемонтБаз Тогда
			ТекОбъект.КоэффициентКНРНаРемонтБазисный = ТекКоэфф;
			КНайден = Истина;
		КонецЕсли;	
		Если ТекКоэфф <> 0 И ТекКоэфф = КоэффНРАЭСБаз Тогда
			ТекОбъект.КоэффициентКНРАЭСБазисный = ТекКоэфф;
			КНайден = Истина;
		КонецЕсли;	
		Если ТекКоэфф <> 0 И ТекКоэфф = КоэффНРУСНБаз Тогда
			ТекОбъект.КоэффициентКНРУСНБазисный = ТекКоэфф;
			КНайден = Истина;
		КонецЕсли;
		Если ТекКоэфф <> 0 И  КНайден = Ложь Тогда
			ТекОбъект.ПоправочныйКоэффициентКНРБазисный = ТекКоэфф * ?(ТекОбъект.ПоправочныйКоэффициентКНРБазисный = 0,1,ТекОбъект.ПоправочныйКоэффициентКНРБазисный);	
		КонецЕсли;
	ИначеЕсли ТипЧП = "СПТекущий" Тогда
		Если ТекКоэфф <> 0 И ТекКоэфф = КоэффСППопрТек Тогда
			ТекОбъект.ПоправочныйКоэффициентКСПТекущий = ТекКоэфф;
			КНайден = Истина;
		КонецЕсли;	
		Если ТекКоэфф <> 0 И ТекКоэфф = КоэффСПРемонтТек Тогда
			ТекОбъект.КоэффициентКСПНаРемонтТекущий = ТекКоэфф;
			КНайден = Истина;
		КонецЕсли;	
		Если ТекКоэфф <> 0 И ТекКоэфф = КоэффСПАЭСТек Тогда
			ТекОбъект.КоэффициентКСПАЭСТекущий = ТекКоэфф;
			КНайден = Истина;
		КонецЕсли;	
		Если ТекКоэфф <> 0 И ТекКоэфф = КоэффСПУСНТек Тогда
			ТекОбъект.КоэффициентКСПУСНТекущий = ТекКоэфф;
			КНайден = Истина;
		КонецЕсли;
		Если ТекКоэфф <> 0 И  КНайден = Ложь Тогда
			ТекОбъект.ПоправочныйКоэффициентКСПТекущий = ТекКоэфф * ?(ТекОбъект.ПоправочныйКоэффициентКСПТекущий = 0,1,ТекОбъект.ПоправочныйКоэффициентКСПТекущий);	
		КонецЕсли;
	ИначеЕсли ТипЧП = "СПБазисный" Тогда
		Если ТекКоэфф <> 0 И ТекКоэфф = КоэффСППопрБаз Тогда
			ТекОбъект.ПоправочныйКоэффициентКСПБазисный = ТекКоэфф;
			КНайден = Истина;
		КонецЕсли;	
		Если ТекКоэфф <> 0 И ТекКоэфф = КоэффСПРемонтБаз Тогда
			ТекОбъект.КоэффициентКСПНаРемонтБазисный = ТекКоэфф;
			КНайден = Истина;
		КонецЕсли;	
		Если ТекКоэфф <> 0 И ТекКоэфф = КоэффСПАЭСБаз Тогда
			ТекОбъект.КоэффициентКСПАЭСБазисный = ТекКоэфф;
			КНайден = Истина;
		КонецЕсли;	
		Если ТекКоэфф <> 0 И ТекКоэфф = КоэффСПУСНБаз Тогда
			ТекОбъект.КоэффициентКСПУСНБазисный = ТекКоэфф;
			КНайден = Истина;
		КонецЕсли;
		Если ТекКоэфф <> 0 И  КНайден = Ложь Тогда
			ТекОбъект.ПоправочныйКоэффициентКСПБазисный = ТекКоэфф * ?(ТекОбъект.ПоправочныйКоэффициентКСПБазисный = 0,1,ТекОбъект.ПоправочныйКоэффициентКСПБазисный);	
		КонецЕсли;
	КонецЕсли;			
	
КонецПроцедуры

// Разбор строки шифров поправок.
Функция СобратьШифры(Поправки)
	СтрокаШифров = "";
	ТекПоправки = Поправки;
	Поз =  Найти(ТекПоправки,"~");
	Если Поз <> 0 Тогда
		СтрокаШифров = Сред(ТекПоправки,1,Поз-1);
	Иначе
		СтрокаШифров = ТекПоправки;
	КонецЕсли;
	Если Лев(СтрокаШифров,1) = "#" Тогда
		СтрокаШифров = Сред(СтрокаШифров,2);
	КонецЕсли;	
	СтрокаШифров = СтрЗаменить(СтрокаШифров,"#","; ");
	Возврат СтрокаШифров;		

КонецФункции

// Создание нового элемента в справочнике Ресурсы.
Функция НайтиСоздатьРесурсВСправочнике(КодРесурса,Наименование,ВидРесурса,ГруппаРесурсов,ЕдИзм = "",Уровень="",Несоздавать = Ложь,ТекстОшибки)
	ТекПапка = Справочники.СМ_Ресурсы.ПустаяСсылка();	
	Если Не ГруппаРесурсов.Пустая()  Тогда
		ТекПапка = Справочники.СМ_Ресурсы.НайтиПоКоду(ГруппаРесурсов.ИмяПредопределенныхДанных);
		Если  ТекПапка = Справочники.СМ_Ресурсы.ПустаяСсылка() Тогда
			НовыйОбъект = Справочники.СМ_Ресурсы.СоздатьГруппу();
			НовыйОбъект.Наименование 	= Сред(ГруппаРесурсов.Наименование,1,120);
			НовыйОбъект.Код 		 	= ГруппаРесурсов.ИмяПредопределенныхДанных;
			НовыйОбъект.ОбменДанными.Загрузка = Истина;
			НовыйОбъект.Записать();
			ТекПапка =  НовыйОбъект.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Группа = ТекПапка;	
	
	// Найти группу.
	НаимВида = "";
	Если ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда
		НаимВида = НСтр("ru='Затраты труда машинистов'");
	ИначеЕсли ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
		НаимВида = НСтр("ru='Затраты труда рабочих'");
	ИначеЕсли ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
		НаимВида = НСтр("ru='Материалы'");
	ИначеЕсли ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
		НаимВида = НСтр("ru='Машины и механизмы'");
	КонецЕсли;	
	
	// НайтиПапку 
	Если Несоздавать = Истина  Тогда
		ТекРесурс = Справочники.СМ_Ресурсы.НайтиПоКоду(КодРесурса);
	Иначе
		Если НаимВида <> "" Тогда
			Группа = Справочники.СМ_Ресурсы.НайтиПоНаименованию(НаимВида,Истина,ТекПапка);
			Если Группа = Справочники.СМ_Ресурсы.ПустаяСсылка() Тогда 
				НовыйОбъект 			= Справочники.СМ_Ресурсы.СоздатьГруппу();
				НовыйОбъект.Наименование = НаимВида;
				НовыйОбъект.УстановитьНовыйКод("ГР");
				НовыйОбъект.Родитель = ТекПапка;
				НовыйОбъект.ОбменДанными.Загрузка = Истина;
				НовыйОбъект.Записать();
				Группа = НовыйОбъект.Ссылка;
			КонецЕсли;
			ТекРесурс = Справочники.СМ_Ресурсы.НайтиПоКоду(КодРесурса,,Группа);
		Иначе
			ТекРесурс = Справочники.СМ_Ресурсы.НайтиПоКоду(КодРесурса);
		КонецЕсли;	
	КонецЕсли;	
	
	Если ТекРесурс = Справочники.СМ_Ресурсы.ПустаяСсылка() Тогда
		Если СМ_СметаВызовСервера.НедоступнаРаботаСПрайсами() Тогда
			Возврат Справочники.СМ_Ресурсы.ПустаяСсылка();
		КонецЕсли;
		
		НовыйОбъект 					= Справочники.СМ_Ресурсы.СоздатьЭлемент();
		НовыйОбъект.Наименование 		= Сред(Наименование,1,120);
		НовыйОбъект.ДлинноеНаименование = СокрП(Сред(Наименование,121));
		НовыйОбъект.Код 		 		= КодРесурса;
		НовыйОбъект.ВидРесурса 			= ВидРесурса;
		Если ЗначениеЗаполнено(Уровень) Тогда
			НовыйОбъект.ГодВыпуска = Уровень;
		КонецЕсли;
		Если ЗначениеЗаполнено(ЕдИзм) Тогда
			ЕдиницаИзмерения = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоНаименованию(ЕдИзм);
			НовыйОбъект.ЕдиницаИзмерения = ЕдиницаИзмерения;
		КонецЕсли;
		НовыйОбъект.Родитель 				= Группа;
		НовыйОбъект.ОбменДанными.Загрузка 	= Истина;
		НовыйОбъект.ВводитьСтоимостьНаОбъем = Ложь;
		НовыйОбъект.Записать();
		ТекРесурс = НовыйОбъект.Ссылка;
	КонецЕсли;
	
	Возврат(ТекРесурс);
	
КонецФункции
	                                     	
// Преобразование строки в число.
Функция ПреобразоватьВЧисло(ТекСтрока)
	
	Если ЗначениеЗаполнено(ТекСтрока) Тогда
		ТекЧисло = Число(ТекСтрока);
	Иначе
		ТекЧисло = 0;
	КонецЕсли;
	
	Возврат ТекЧисло;
	
КонецФункции

// Разбор строки формул.
Функция ПолучитьФормулу(СписокФормул,НаимРеквизита,ПоУмолч) 
	ПоискСтр="~"+СокрЛП(НаимРеквизита)+"~";
	Поз=Найти(СписокФормул,ПоискСтр);
	Если Поз=0 Тогда Возврат Строка(ПоУмолч);
	Иначе 
		ВремСтр=Сред(СписокФормул,Поз+СтрДлина(ПоискСтр),500);
		Поз=Найти(ВремСтр,"~");
		Если Поз=0 Тогда Возврат ВремСтр;
		Иначе Возврат Сред(ВремСтр,1,Поз-1);
		КонецЕсли;
	КонецЕсли;
КонецФункции

// Определение типа ресурса по коду ресурса.
//  В архиве тип не определен (старый архив).
Функция  ТипРесурсаСметаПлюс(КодРесурса,СтруктураГлобальныхПеременных)
	Результат = "";
	Если СтруктураГлобальныхПеременных.Методика1984 = Ложь Тогда
		Если СтрДлина(КодРесурса) = 1 И (КодРесурса = "2" Или КодРесурса = "3") Тогда
			Результат = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов;
		ИначеЕсли Сред(КодРесурса,2,1) = "-" Тогда
			Результат = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих;
		ИначеЕсли СтрДлина(КодРесурса) >= 6 Тогда 	
			Если Найти(Сред(КодРесурса,1,6),"-") = 0 Тогда
				Результат = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы;
			Иначе
				Результат = Перечисления.СМ_ВидыРесурсов.Материалы;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	Возврат(Результат);
КонецФункции	

