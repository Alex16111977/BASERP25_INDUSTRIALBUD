// Функция вызывается из формы обработки. 
Функция ЗапуститьЗагрузкаАрхива(ТекФорма,СтруктураПараметров) Экспорт

	СтруктураТекФорма = Новый Структура();
	СтруктураТекФорма.Вставить("СоответствияЛЗ",ТекФорма.СоответствияЛЗ.Выгрузить());
	СтруктураТекФорма.Вставить("СписокСметКаталога",ТекФорма.СписокСметКаталога.Выгрузить());
	СтруктураТекФорма.Вставить("Организация",ТекФорма.Объект.Организация);
	СтруктураТекФорма.Вставить("Стройка",ТекФорма.Объект.Стройка);
	СтруктураТекФорма.Вставить("НовыйАрхив",ТекФорма.НовыйАрхив);
	СтруктураТекФорма.Вставить("Методика1984",ТекФорма.Методика1984);
	СтруктураТекФорма.Вставить("ПересчетЗагруженныхСмет",ТекФорма.ПересчетзагруженныхСмет);
	ТабСообщения = Новый ТаблицаЗначений;
	ТабСообщения.Колонки.Добавить("ТекстСообщения");
	
	СтруктураПараметров.Вставить("ТабСообщения",ТабСообщения);
	СтруктураПараметров.Вставить("СтруктураФормы",СтруктураТекФорма);
	
	Для каждого СтрАрхива Из СтруктураТекФорма.СписокСметКаталога Цикл
		УдалитьФайлыИзРегистра(ТекФорма.МассивХранилищ);
		Если СтрАрхива.Загружать = Истина Тогда
			АрхивСметы = СтрАрхива.АрхивСметы;
			Хранилища = ТекФорма.МассивХранилищ;
			СоздатьЗаписиВРегистреСведений(ТекФорма.МассивХранилищ,АрхивСметы); 
			Результат = "";	
			Попытка
				Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(Новый УникальныйИдентификатор,"Обработки.СМ_ОбменДаннымиВФорматеСметаПлюс.ЗагрузитьАрхивСметы",СтруктураПараметров,НСтр("ru = 'Загрузка архива Смета Плюс'"));
			Исключение
				ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				Событие = НСтр("ru = 'Загрузка архива Смета Плюс'");
				ЗаписьЖурналаРегистрации(Событие,УровеньЖурналаРегистрации.Ошибка,,,ПредставлениеОшибки);
				ВызватьИсключение;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;	

	Возврат Результат;

КонецФункции

// Процедура чистки регистра при переходе к другой смете из каталога.
Процедура УдалитьФайлыИзРегистра(ТекМассивХранилищ)
	
	Для Каждого СтрокаИмен Из ТекМассивХранилищ Цикл 
		ИмяФайла = СтрокаИмен.ИмяФайла;
		ИмяФайлаИнд = СтрокаИмен.ИмяФайла + "Инд";
		Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла",ИмяФайла)); 
		Если Запись.Следующий() Тогда
			Запись.ПолучитьМенеджерЗаписи().Удалить();
		КонецЕсли;
		Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла",ИмяФайлаИнд)); 
		Если Запись.Следующий() Тогда
			Запись.ПолучитьМенеджерЗаписи().Удалить();
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

// Перенос таблицы массива хранилищ двоичных данных файлов в регистр сведений СМ_Файлы.
Процедура СоздатьЗаписиВРегистреСведений(МассивХранилищ,АрхивСметы)
	Для каждого ЗаписьМассива Из МассивХранилищ Цикл
		Если АрхивСметы = ЗаписьМассива.ИмяАрхива Тогда
			ИмяФайла = ЗаписьМассива.ИмяФайла;
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ЗаписьМассива.АдресФайла);
			Запись = РегистрыСведений.СМ_Файлы.СоздатьМенеджерЗаписи();
			Запись.ИмяФайла = ИмяФайла;
			Запись.Файл = Новый ХранилищеЗначения(ДвоичныеДанные);
			Запись.Записать();
			Если  ЗаписьМассива.ИндексныйФайл <> "" Тогда
				ДвоичныеДанныеИнд = ПолучитьИзВременногоХранилища(ЗаписьМассива.ИндексныйФайл);
				Запись = РегистрыСведений.СМ_Файлы.СоздатьМенеджерЗаписи();
				Запись.ИмяФайла = ИмяФайла + "Инд";
				Запись.Файл = Новый ХранилищеЗначения(ДвоичныеДанныеИнд);
				Запись.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры	
	
// Основная процедура загрузки одного архива, файла с типом "SMA".
Процедура ЗагрузитьАрхивСметы(СтруктураПараметров,АдресХранилища) Экспорт
	
	СписокИменВременныхФайлов = Новый ТаблицаЗначений();
