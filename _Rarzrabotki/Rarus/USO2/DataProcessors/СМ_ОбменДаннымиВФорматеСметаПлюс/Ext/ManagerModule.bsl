Процедура ЗаполнитьНРиСПСтандартные(НовДок,ЧП)
	КодЧП = ЧП.Код;
	ЗначениеЧП = ЧП.Значение;
	ФормулаЧП = СокрЛП(ЧП.Формула);
	
	Если КодЧП = "43" Тогда
		Если НовДок.Определитель.ВидРасценки  = Перечисления.СМ_ВидыРасценки.Работа
			Или	(НовДок.ЗарплМашинистов + НовДок.ОснЗарплата) <> 0 Тогда
			
			//  Процент накладных расходов текущий.
			НовДок.НакладныеРасходыТекущие = ЗначениеЧП;
			СтрокаКоэфф = ФормулаЧП;
			Если СтрДлина(СтрокаКоэфф) <> 0 Тогда
				К1 = 0;
				К2 = 0;
				К3 = 0;
				К4 = 0;
				РазобратьСтрокуКоэффициентов(К1,К2,К3,К4,СтрокаКоэфф);	
				ПрименитьКоэфф(К1,НовДок,"НРТекущий");
				ПрименитьКоэфф(К2,НовДок,"НРТекущий");
				ПрименитьКоэфф(К3,НовДок,"НРТекущий");
				ПрименитьКоэфф(К4,НовДок,"НРТекущий");
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли КодЧП = "60" Тогда
		// Процент накладных расходов базис.
		Если НовДок.Определитель.ВидРасценки  = Перечисления.СМ_ВидыРасценки.Работа
			Или (НовДок.ЗарплМашинистов + НовДок.ОснЗарплата) <> 0 Тогда
			НовДок.НакладныеРасходыБазисные = ЗначениеЧП;
			СтрокаКоэфф = ФормулаЧП;
			Если СтрДлина(СтрокаКоэфф) <> 0 Тогда
				К1 = 0;
				К2 = 0;
				К3 = 0;
				К4 = 0;
				РазобратьСтрокуКоэффициентов(К1,К2,К3,К4,СтрокаКоэфф);	
				ПрименитьКоэфф(К1,НовДок,"НРБазисный");
				ПрименитьКоэфф(К2,НовДок,"НРБазисный");
				ПрименитьКоэфф(К3,НовДок,"НРБазисный");
				ПрименитьКоэфф(К4,НовДок,"НРБазисный");
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли КодЧП = "49" Тогда
		// Сметная прибыль Текущая.
		Если НовДок.Определитель.ВидРасценки  = Перечисления.СМ_ВидыРасценки.Работа
			Или (НовДок.ЗарплМашинистов + НовДок.ОснЗарплата) <> 0 Тогда
			НовДок.СметнаяПрибыльТекущие = ЗначениеЧП;
			СтрокаКоэфф = ФормулаЧП;
			Если СтрДлина(СтрокаКоэфф) <> 0 Тогда
				К1 = 0;
				К2 = 0;
				К3 = 0;
				К4 = 0;
				РазобратьСтрокуКоэффициентов(К1,К2,К3,К4,СтрокаКоэфф);	
				ПрименитьКоэфф(К1,НовДок,"СПТекущий");
				ПрименитьКоэфф(К2,НовДок,"СПТекущий");
				ПрименитьКоэфф(К3,НовДок,"СПТекущий");
				ПрименитьКоэфф(К4,НовДок,"СПТекущий");
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли КодЧП = "61" Тогда
		// Сметная прибыль базисная.
		Если НовДок.Определитель.ВидРасценки  = Перечисления.СМ_ВидыРасценки.Работа
			Или (НовДок.ЗарплМашинистов + НовДок.ОснЗарплата) <> 0 Тогда
			
			НовДок.СметнаяПрибыльБазисные = ЗначениеЧП;
			СтрокаКоэфф = ФормулаЧП;
			Если СтрДлина(СтрокаКоэфф) <> 0 Тогда
				К1 = 0;
