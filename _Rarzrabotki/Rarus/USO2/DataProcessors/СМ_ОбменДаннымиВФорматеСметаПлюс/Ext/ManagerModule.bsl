// Создание таблицы индесов для файла SMETA.DBF, необходимо при загрузке 
//  документов в порядке номеров по смете.
Процедура СозданиеТаблицыИндексов(ТабИндексов,ФайлСмета)
	ИндексСметы = 0;
	ИндексОбъектнойСметы = 0;
	ИндексСводнойСметы = 0;
	ИндексРаздела = 0;
	ИндексПозиции = 0;
	Сч = 0;
	СчОб = 0;
	СчСв = 0;
	СчЛС = 0;
	НомерРаздела = 0;
	Пока Не ФайлСмета.ВКонце() Цикл
		НоваяСтрока = ТабИндексов.Добавить();
		НоваяСтрока.ID = ФайлСмета.ПолучитьЗначениеПоля("ID");	
		НоваяСтрока.NOMER = ФайлСмета.ПолучитьЗначениеПоля("NOMER");
		Если  НоваяСтрока.ID = 5 Тогда
			ИндексСводнойСметы = 	ФайлСмета.ПолучитьЗначениеПоля("NOMER");
			ИндексОбъектнойСметы = 0;
			ИндексСметы = 0;
			СчСв = СчСв + 1;
			Счоб = 0;
			СчЛС = 0;
		ИначеЕсли  НоваяСтрока.ID = 4 Тогда
			ИндексОбъектнойСметы = 	ФайлСмета.ПолучитьЗначениеПоля("NOMER");
			ИндексСметы = 0;
			ИндексРаздела = 0;
			ИндексПозиции = 0;
			НомерРаздела = 0;
			Счоб = Счоб + 1;
			СчЛС = 0;
		ИначеЕсли  НоваяСтрока.ID = 0 Тогда
			ИндексСметы = ФайлСмета.ПолучитьЗначениеПоля("NOMER");
			ИндексРаздела = 0;
			ИндексПозиции = 0;
			НомерРаздела = 0;
			СчЛС = СчЛС + 1;
			Сч = 0;
		ИначеЕсли НоваяСтрока.ID = 2 Тогда
			ИндексРаздела = ФайлСмета.ПолучитьЗначениеПоля("NOMER");
			НомерРаздела = НомерРаздела + 1;
			ИндексПозиции = 0;
		ИначеЕсли НоваяСтрока.ID = 3 Тогда
			ИндексПозиции = ФайлСмета.ПолучитьЗначениеПоля("NOMER");
		КонецЕсли;	
		НоваяСтрока.Сортировка = СчСв * 10000000 + Счоб * 100000000 + ИндексСметы * 10000000 + ИндексРаздела * 10000 + НомерРаздела * 1000 + ИндексПозиции;
		НоваяСтрока.CODE = ФайлСмета.ПолучитьЗначениеПоля("CODE");
		Сч = Сч + 1;
		Если НоваяСтрока.ID = 3 Или НоваяСтрока.ID = 2 Тогда
			НоваяСтрока.НомерВПределахСметы = Сч;
		КонецЕсли;
		ФайлСмета.Следующая();
	КонецЦикла;
	ТабИндексов.Сортировать("Сортировка");
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеЭлементов
// Заполнение таблиц для создания докунта АктВыполненных работ.
Процедура ЗаполнениеТаблицыАкта(Акт,ТабАктов,Выполнение,ТабВыполнение,ТабПозиций,ФайлИндексовРесурсов,ТабРасхода,Расход,СтруктураГлобальныхПеременных)
	Акт.Первая();
	ТекПоля = Акт.Поля;
	Пока Не Акт.ВКонце() Цикл
		НоваяСтрока = ТабАктов.Добавить();
		ИндексСтрокиАкта = НоваяСтрока;

		НоваяСтрока.КодСметы = СокрЛП(Акт.ПолучитьЗначениеПоля("ID"));	
		НоваяСтрока.НомерДокумента = Акт.ПолучитьЗначениеПоля("CODE");	
		НоваяСтрока.ДатаДокумента  = Акт.ПолучитьЗначениеПоля("DATE");	
		//  Подрядчик
		Рез = ТекПоля.Найти("PODRJAD");
		Если Рез <> Неопределено Тогда
			НоваяСтрока.Подрядчик = Акт.ПолучитьЗначениеПоля("PODRJAD");
		КонецЕсли;
		НоваяСтрока.Ответственный = Акт.ПолучитьЗначениеПоля("ISPOLN");
		НоваяСтрока.КоэффСМР  = Акт.ПолучитьЗначениеПоля("KCMP");
		НоваяСтрока.КоэффФОТ = Акт.ПолучитьЗначениеПоля("KFOT");
		НоваяСтрока.КоэффПрочРаб = Акт.ПолучитьЗначениеПоля("KPR");
		НоваяСтрока.КоэффСтоимЭксплМашин = Акт.ПолучитьЗначениеПоля("KCMP");
		НоваяСтрока.КоэффОборуд = Акт.ПолучитьЗначениеПоля("KOB");
		НоваяСтрока.КоэффСтоимМатериалов = Акт.ПолучитьЗначениеПоля("KPR");
		Рез = ТекПоля.Найти("VYPUSKCE");
		Если Рез <> Неопределено Тогда
			НоваяСтрока.ДатаТекущихЦен = Акт.ПолучитьЗначениеПоля("VYPUSKCE");
		КонецЕсли;
		НоваяСтрока.ОписаниеИндексовРазделов = СокрЛП(Акт.ПолучитьЗначениеПоля("STRIND")) + СокрЛП(Акт.ПолучитьЗначениеПоля("STRIND1")) + СокрЛП(Акт.ПолучитьЗначениеПоля("STRIND2"))+СокрЛП(Акт.ПолучитьЗначениеПоля("STRIND3")) + СокрЛП(Акт.ПолучитьЗначениеПоля("STRIND4"))+СокрЛП(Акт.ПолучитьЗначениеПоля("STRIND5")) + СокрЛП(Акт.ПолучитьЗначениеПоля("STRIND6"));
		ЗаполнениеТаблицыВыполнения(ИндексСтрокиАкта,ТабВыполнение,Выполнение,ФайлИндексовРесурсов,ТабПозиций);
		ЗаполнениеТаблицыРасхода(ИндексСтрокиАкта,ТабРасхода,Расход,ФайлИндексовРесурсов,ТабПозиций);

		Акт.Следующая();
	КонецЦикла;

КонецПроцедуры

// Заполнение таблицы для  ТЧ Ресурсы документа ПозицияЛокальнойСметы из файла RESTBL.DBF.
Процедура ЗаполнениеТаблицыРесурсов(ФайлРес,ТабРесурсов,ФайлИндексовРесурсов,ТекСтрокаПозиции,ТабВыполнение,Выполнение,СтруктураГлобальныхПеременных)
	ТабРесурсов.Очистить();
	ФайлИндексовРесурсов.Первая();
	CODE = ТекСтрокаПозиции.CODE;
	ФайлИндексовРесурсов.ТекущийИндекс = ФайлИндексовРесурсов.Индексы.IDXPOS;
	ФайлИндексовРесурсов.Ключ.POSCODE =  CODE;
	Если ФайлИндексовРесурсов.НайтиПоКлючу("=")= Истина Тогда
		Пока Не ФайлИндексовРесурсов.ВКонце() Цикл
			Если ФайлИндексовРесурсов.ID = 0 И ФайлИндексовРесурсов.POSCODE = CODE Тогда
				// РесурсыПозиции.
				КлючПоиска = ФайлИндексовРесурсов.ПолучитьЗначениеПоля("CODE");
				ФайлРес.ТекущийИндекс = ФайлРес.Индексы.IDXCODE;
				ФайлРес.Ключ.CODE = КлючПоиска;
				Если ФайлРес.НайтиПоКлючу("=")= Истина Тогда
					Пока Не ФайлРес.ВКонце() Цикл 
						Если ФайлРес.CODE <> КлючПоиска Тогда
							Прервать;
						КонецЕсли;	
						НоваяСтрока = ТабРесурсов.Добавить();
						НоваяСтрока.КодРесурса = СокрЛП(ФайлРес.ПолучитьЗначениеПоля("RES"));
						НоваяСтрока.Наименование = СокрЛП(ФайлРес.ПолучитьЗначениеПоля("RESNAME"));
						ТипМатериала = ФайлРес.ПолучитьЗначениеПоля("MESTN");
						Если ТипМатериала = 0 Тогда
							НоваяСтрока.ПризнакТипа = Перечисления.СМ_ТипыМатериалов.Учтенный;
						ИначеЕсли ТипМатериала = 1 Тогда
							НоваяСтрока.ПризнакТипа = Перечисления.СМ_ТипыМатериалов.МестныйМатериал;
						ИначеЕсли ТипМатериала = 2 Тогда
							НоваяСтрока.ПризнакТипа = Перечисления.СМ_ТипыМатериалов.ПоПроекту;
						КонецЕсли;
						НоваяСтрока.НормаРасхода = ФайлРес.ПолучитьЗначениеПоля("NORMRAS");
						НоваяСтрока.ЦенаЕдиницыТекущая = ФайлРес.ПолучитьЗначениеПоля("PRICERES");
						Попытка
						НоваяСтрока.ЗПМашинистовТекущая = ФайлРес.ПолучитьЗначениеПоля("PRICMASH");
						Исключение	
							НоваяСтрока.ЗПМашинистовТекущая = 0;
						КонецПопытки;	
						Если СтруктураГлобальныхПеременных.НовыйАрхив = Ложь Тогда
							ТипПоСметеПлюс = ТипРесурсаСметаПлюс(НоваяСтрока.КодРесурса,СтруктураГлобальныхПеременных);
							НоваяСтрока.ВидРесурса = ТипПоСметеПлюс;
						Иначе
							ТипПоСмете = Число(ФайлРес.ПолучитьЗначениеПоля("RESGRUP"));
							Если ТипПоСмете = 1 Тогда
								НоваяСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих;
							ИначеЕсли ТипПоСмете = 2 Тогда
								НоваяСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов;
							ИначеЕсли ТипПоСмете = 3 Тогда
								НоваяСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы;
							ИначеЕсли ТипПоСмете = 4 Тогда
								НоваяСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы;
							КонецЕсли;	
						КонецЕсли;	
						Если НоваяСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы
							Или НоваяСтрока.ВидРесурса  = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
							НоваяСтрока.КоэффициентКРасходуРесурсов = ФайлРес.ПолучитьЗначениеПоля("KOEFF");
						КонецЕсли;
						Если СтруктураГлобальныхПеременных.НовыйАрхив = Истина Тогда
							НоваяСтрока.ЦенаЕдиницыБазовая = ФайлРес.ПолучитьЗначениеПоля("CENA");
							НоваяСтрока.ЗПМашинистовБазовая = ФайлРес.ПолучитьЗначениеПоля("CENAZPM");
							Уровень = ФайлРес.ПолучитьЗначениеПоля("SPRRES");
							Если Уровень = 9 Тогда
								НоваяСтрока.Уровень = Перечисления.СМ_ГодыВыпускаБазы.г2009;
							ИначеЕсли Уровень = 3 Тогда
								НоваяСтрока.Уровень = Перечисления.СМ_ГодыВыпускаБазы.г2001;
							ИначеЕсли Уровень = 1 Тогда
								НоваяСтрока.Уровень = Перечисления.СМ_ГодыВыпускаБазы.г1984;
							КонецЕсли;
							НоваяСтрока.ЕдиницаИзмерения = СокрЛП(ФайлРес.ПолучитьЗначениеПоля("RESEJ"));
						КонецЕсли;
						ФайлРес.Следующая();
					КонецЦикла;	
				КонецЕсли;
				КонецЕсли;
			ФайлИндексовРесурсов.Следующая();
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Заполнение таблицы данными для загрузки документа Позиция Локальной сметы.
// Осуществляется из файлов Smeta.dbf и POSEXT.DBF и PARAMS.DBF.
Процедура ЗаполнениеТаблицыПозиций(КодСметы,ФайлСмета, ФайлПоз, ТабПозиций, ИндексПозиции,CODE,ТабЧП, ФайлЧП,ИзмененТип,ТабРазделов,НомерВПределахСметы,НомерПодраздела,СтруктураГлобальныхПеременных)
	ТабЧП.Очистить();
	НомерСтроки = ФайлСмета.ПолучитьЗначениеПоля("NOMER");
	НаименованиеПозиции = СокрЛП(ФайлСмета.ПолучитьЗначениеПоля("NAME"));
	ФайлПоз.ТекущийИндекс = ФайлПоз.Индексы.IDXCODE;
	ФайлПоз.Ключ.CODE = CODE;
	Если ФайлПоз.НайтиПоКлючу("=")= Истина Тогда
		ТекПоля = ФайлПоз.Поля;
		Рез = ТекПоля.Найти("PODZAG");
		Если Рез <> Неопределено Тогда
			
			Подраздел = ФайлПоз.ПолучитьЗначениеПоля("PODZAG");
			Если Подраздел = 1 Тогда
				НомерПодраздела = НомерПодраздела + 1;
				СоздатьДокументРазделПодраздел(НаименованиеПозиции,КодСметы,ТабРазделов,НомерСтроки,НомерВПределахСметы,НомерПодраздела,СтруктураГлобальныхПеременных);
				ИзмененТип = Истина;
				Возврат;
			КонецЕсли;	
		КонецЕсли;	
		НоваяСтрока = ТабПозиций.Добавить();
		НоваяСтрока.CODE = ФайлПоз.ПолучитьЗначениеПоля("CODE");
		ИндексПозиции = ТабПозиций.Индекс(НоваяСтрока);	
		НоваяСтрока.НомерСметы  = СокрЛП(КодСметы);
		НоваяСтрока.НомерСтроки  = НомерСтроки;
		НоваяСтрока.Расчет = ?(ФайлПоз.ПолучитьЗначениеПоля("MARK")= 1,Истина,Ложь);
		НоваяСтрока.Определитель = ФайлПоз.ПолучитьЗначениеПоля("OPRED");
		НоваяСтрока.ШифрПозиции  = СокрЛП(ФайлПоз.ПолучитьЗначениеПоля("CODERASC"));
		НоваяСтрока.НаименованиеПозиции = СокрЛП(НаименованиеПозиции);
		НоваяСтрока.ЕдиницаИзмерения    = СокрЛП(ФайлПоз.ПолучитьЗначениеПоля("EJ"));
		Рез = ТекПоля.Найти("IZM");
		Если Рез <> Неопределено Тогда
			НоваяСтрока.Измеритель    = СокрЛП(ФайлПоз.ПолучитьЗначениеПоля("IZM"));
		Иначе
			НоваяСтрока.Измеритель    = СокрЛП(ФайлПоз.ПолучитьЗначениеПоля("EJ"));
		КонецЕсли;
		НоваяСтрока.ТипПозиции   = СокрЛП(ФайлПоз.ПолучитьЗначениеПоля("TYPESBOR"));
		Рез = ТекПоля.Найти("MARKIN");
		Если Рез <> Неопределено Тогда
			НоваяСтрока.НеИндексировать     = ?(ФайлПоз.ПолучитьЗначениеПоля("MARKIN") = 1,Истина,Ложь);
		Иначе
			НоваяСтрока.НеИндексировать     = Ложь;
		КонецЕсли;	
		Рез = ТекПоля.Найти("DEMONT");
		Если Рез <> Неопределено Тогда
			НоваяСтрока.Демонтаж            = ?(ФайлПоз.ПолучитьЗначениеПоля("DEMONT") = 1,Истина,Ложь);
		Иначе
			НоваяСтрока.Демонтаж            = Ложь;
		КонецЕсли;
		НоваяСтрока.Регион       = СокрЛП(ФайлПоз.ПолучитьЗначениеПоля("REGION"));
		НоваяСтрока.РегионНаим   = СокрЛП(ФайлПоз.ПолучитьЗначениеПоля("REGIONN"));
		НоваяСтрока.ОбъемРабот = ФайлПоз.ПолучитьЗначениеПоля("Q");
		НоваяСтрока.ПрямыеЗатраты = ФайлПоз.ПолучитьЗначениеПоля("PZ");
		НоваяСтрока.ОсновнаяЗП =  ФайлПоз.ПолучитьЗначениеПоля("ZP");
		НоваяСтрока.СтоимостьЭМиМех = ФайлПоз.ПолучитьЗначениеПоля("EM");
		НоваяСтрока.ЗарплатаМашинистов = ФайлПоз.ПолучитьЗначениеПоля("ZM");
		НоваяСтрока.СтоимостьМатериалов = ФайлПоз.ПолучитьЗначениеПоля("SM");
		НоваяСтрока.Оборудование = ФайлПоз.ПолучитьЗначениеПоля("OB");
		НоваяСтрока.ВозвратМатериалов = ФайлПоз.ПолучитьЗначениеПоля("VM");
		НоваяСтрока.ТрудозатратыРабочих = ФайлПоз.ПолучитьЗначениеПоля("ZTR");
		НоваяСтрока.ТрудозатратыМашинистов = ФайлПоз.ПолучитьЗначениеПоля("ZTM");
		НоваяСтрока.Формулы = СокрЛП(ФайлПоз.ПолучитьЗначениеПоля("FORMULY"));
		Рез = ТекПоля.Найти("CURCENA");
		Если Рез <> Неопределено Тогда
			НоваяСтрока.ТекущаяЦена = ФайлПоз.ПолучитьЗначениеПоля("CURCENA");
		КонецЕсли;
		Рез = ТекПоля.Найти("CURZPM");
		Если Рез <> Неопределено Тогда
			НоваяСтрока.ТекущаяЗарплатаМашинистов = ФайлПоз.ПолучитьЗначениеПоля("CURZPM");
		КонецЕсли;
		НоваяСтрока.Поправки = СокрЛП(ФайлПоз.ПолучитьЗначениеПоля("POPR"));
		НоваяСтрока.КоэффОснЗарплаты = ФайлПоз.ПолучитьЗначениеПоля("INDZP");
		НоваяСтрока.КоэффСтоимЭксплМашин = ФайлПоз.ПолучитьЗначениеПоля("INDMM");
		НоваяСтрока.КоэффСтоимЗарплатеМашин = ФайлПоз.ПолучитьЗначениеПоля("INDMM");
		НоваяСтрока.КоэффСтоимМатериалов  = ФайлПоз.ПолучитьЗначениеПоля("INDSM");
		НоваяСтрока.КоэффПолнСтоимРабот  = ФайлПоз.ПолучитьЗначениеПоля("INDPS");
		Рез = ТекПоля.Найти("BAZKOZ");
		Если Рез <> Неопределено Тогда
			НоваяСтрока.БазисКОЗ  = ФайлПоз.ПолучитьЗначениеПоля("BAZKOZ");
			НоваяСтрока.БазисКЭМ  = ФайлПоз.ПолучитьЗначениеПоля("BAZKEM");
			НоваяСтрока.БазисКЗМ  = ФайлПоз.ПолучитьЗначениеПоля("BAZKZM");
			НоваяСтрока.БазисКСМ  = ФайлПоз.ПолучитьЗначениеПоля("BAZKCM");
		КонецЕсли;
		Рез = ТекПоля.Найти("POZVLAD");
		Если Рез <> Неопределено Тогда
			НоваяСтрока.ПризнакПодчиненности = ФайлПоз.ПолучитьЗначениеПоля("POZVLAD");
		КонецЕсли;
		ПримечаниеПрим = ФайлПоз.ПолучитьЗначениеПоля("PRIM");
		НоваяСтрока.Примечание = Сред(ПримечаниеПрим,3);
		НоваяСтрока.Применительно =	?(Число(Сред(ПримечаниеПрим,1,1))=1,Истина,Ложь); 

	КонецЕсли;	
	//  Числовые параметры.
	ФайлЧП.ТекущийИндекс = ФайлЧП.Индексы.IDXID;
	Тип_Код = "3+" + СокрП(CODE);
	ФайлЧП.Ключ.ID = Тип_Код;
	ТекПоляЧП = ФайлЧП.Поля; 
	
	Если ФайлЧП.НайтиПоКлючу("=")= Истина Тогда
		
		Пока Не ФайлЧП.ВКонце() Цикл
			Если СокрЛП(ФайлЧП.ID) <> Тип_Код Тогда
				Прервать;
			КонецЕсли;	
			НоваяСтрока = ТабЧП.Добавить();
			Рез = ТекПоляЧП.Найти("FORMULA");
			Если Рез <> Неопределено Тогда
				НоваяСтрока.Формула = СокрЛП(ФайлЧП.ПолучитьЗначениеПоля("FORMULA"));
			КонецЕсли;
			НоваяСтрока.Код = СокрЛП(ФайлЧП.ПолучитьЗначениеПоля("CODE"));
			НоваяСтрока.Значение = СокрЛП(ФайлЧП.ПолучитьЗначениеПоля("PARAM"));
			ФайлЧП.Следующая();
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Заполнение таблицы данными из файла Smeta.dbf  для загрузки документа Раздел Локальной сметы.
Процедура ЗаполнениеТаблицыРаздел(ФайлСмета,ТабРазделов,КодГлавнойСметы,ИндексРаздела,КодСметы,ИндексыРаздела,НомерВПределахСметы,НомерРаздела,СтруктураГлобальныхПеременных)
	НоваяСтрока 			= ТабРазделов.Добавить();
	НоваяСтрока.НомерСметы	= СокрЛП(КодСметы);
	ИндексРаздела 			= ТабРазделов.Индекс(НоваяСтрока);	
	НоваяСтрока.УровеньЗаголовка = 1;
	НоваяСтрока.НомерРаздела 		= НомерРаздела;
	НоваяСтрока.НомерВПределахСметы = НомерВПределахСметы;
	НоваяСтрока.НаименованиеРаздела = СокрЛП(ФайлСмета.ПолучитьЗначениеПоля("NAME"));
	НоваяСтрока.НаименованиеРазделаДляПечати = СокрЛП(ФайлСмета.ПолучитьЗначениеПоля("NAME1"));
	ИндексыРаздела.ТекущийИндекс = ИндексыРаздела.Индексы.IDXCODE;
	ИндексыРаздела.Ключ.CODE = ФайлСмета.ПолучитьЗначениеПоля("CODE");
	Если ИндексыРаздела.НайтиПоКлючу("=")= Истина Тогда
		НоваяСтрока.КоэффОборуд 		= ИндексыРаздела.ПолучитьЗначениеПоля("INDPS");
		НоваяСтрока.КоэффОснЗарплаты 	= ИндексыРаздела.ПолучитьЗначениеПоля("INDZP");
		НоваяСтрока.КоэффПолнСтоимРабот = ИндексыРаздела.ПолучитьЗначениеПоля("INDPS");
		НоваяСтрока.КоэффСтоимМатериалов = ИндексыРаздела.ПолучитьЗначениеПоля("INDSM");
		НоваяСтрока.КоэффСтоимЭксплМашин	 = ИндексыРаздела.ПолучитьЗначениеПоля("INDMM");
		НоваяСтрока.КоэффСтоимЗарплатеМашин	 = ИндексыРаздела.ПолучитьЗначениеПоля("INDZP");
	КонецЕсли;
КонецПроцедуры

// Заполнение ТЧ ЛимитированныеЗатраты в документах.
Процедура ЗаполнениеЛимитированныхЗатрат(ТабЛимЗатраты,ССылкаНаДокумент,СтруктураГлобальныхПеременных)
	
	ТекОбъект 	= ССылкаНаДокумент.ПолучитьОбъект();
	Для каждого ТекСтрока Из ТабЛимЗатраты Цикл
		
		ТекЛимЗатрата = Справочники.СМ_ЛимитированныеЗатраты.НайтиПоНаименованию(ТекСтрока.Наименование);
			Если ТекЛимЗатрата = Справочники.СМ_ЛимитированныеЗатраты.ПустаяСсылка() Тогда
				СписокЛЗ = Новый ТаблицаЗначений;
				СписокЛЗ = СтруктураГлобальныхПеременных.СоответствияЛЗ;
				СтруктураОтбора = Новый Структура;
				СтруктураОтбора.Вставить("НаименованиеЛЗ",СокрЛП(ТекСтрока.Наименование));
				СтруктураОтбора.Вставить("Загружать",Истина);
				МассивСтрок = СписокЛЗ.НайтиСтроки(СтруктураОтбора);
				Если МассивСтрок.Количество() > 0 Тогда
					ТекЛимЗатрата = МассивСтрок[0].СсылкаВБазе;			
				КонецЕсли;
			КонецЕсли;
			
			Если ТекЛимЗатрата = Справочники.СМ_ЛимитированныеЗатраты.ПустаяСсылка() Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока 									= ТекОбъект.ЛимитированныеЗатраты.Добавить();
			НоваяСтрока.ЛимитированнаяЗатрата               = ТекЛимЗатрата;
			НоваяСтрока.КоэффициентСметнойЗарплаты 	    	= ТекСтрока.КоэффициентСметнойЗарплаты;
			НоваяСтрока.КоэффициентТрудоемкости     		= ТекСтрока.КоэффициентТрудоемкости;
			НоваяСтрока.Примечание                          = ТекСтрока.Примечание;
			НоваяСтрока.Расчет 								= ?(ТекСтрока.Расчет = 1,Истина,Ложь);
			НоваяСтрока.ЗначениеЛимЗатраты 					= ТекСтрока.ЗначениеЛимЗатраты;
			НоваяСтрока.ФормулаЛимЗатраты  					= ТекСтрока.ФормулаЛимЗатраты;
			НоваяСтрока.БазисноеЗначениеЛимЗатраты 			= ТекСтрока.БазисноеЗначениеЛимЗатраты;
			НоваяСтрока.ФормулаБазисногоЗначениеЛимЗатраты	= ТекСтрока.ФормулаБазисногоЗначениеЛимЗатраты;
			ТекОбъект.Записать();
			
	КонецЦикла;	

КонецПроцедуры

// Заполнение таблицы данными из файла LIMZTR.DBF для загрузки ТЧ документов.
// Документы Локальная смета, Объектная Смета, Сводная Смета. 
Процедура ЗаполнениеТаблицыЛимЗатрат(ФайлЛимЗатр,ТабЛимЗатраты,ИндексДокумента,СтруктураГлобальныхПеременных)
	ТабЛимЗатраты.Очистить();
	ФайлЛимЗатр.Первая();
	Пока Не ФайлЛимЗатр.ВКонце() Цикл
		Если СокрЛП(ФайлЛимЗатр.ID) = ИндексДокумента Тогда
			
			НоваяСтрока = ТабЛимЗатраты.Добавить();
			НоваяСтрока.Наименование = СокрЛП(ФайлЛимЗатр.ПолучитьЗначениеПоля("NAME"));
			
			НоваяСтрока.Расчет = ФайлЛимЗатр.ПолучитьЗначениеПоля("MARK");
			НоваяСтрока.ЗначениеЛимЗатраты = ФайлЛимЗатр.ПолучитьЗначениеПоля("ZATR");
			ТекПоля = ФайлЛимЗатр.Поля;
			Рез = ТекПоля.Найти("FZATR");
			Если Рез <> Неопределено Тогда
				НоваяСтрока.ФормулаЛимЗатраты = СокрЛП(ФайлЛимЗатр.ПолучитьЗначениеПоля("FZATR"));
			КонецЕсли;
			Рез = ТекПоля.Найти("ZATRB");
			Если Рез <> Неопределено Тогда
				НоваяСтрока.БазисноеЗначениеЛимЗатраты= ФайлЛимЗатр.ПолучитьЗначениеПоля("ZATRB");
			КонецЕсли;
			Рез = ТекПоля.Найти("FZATRB");
			Если Рез <> Неопределено Тогда
				НоваяСтрока.ФормулаБазисногоЗначениеЛимЗатраты = СокрЛП(ФайлЛимЗатр.ПолучитьЗначениеПоля("FZATRB"));
			КонецЕсли;
			НоваяСтрока.КоэффициентСметнойЗарплаты = ФайлЛимЗатр.ПолучитьЗначениеПоля("KZRPL");
			
			НоваяСтрока.КоэффициентТрудоемкости = ФайлЛимЗатр.ПолучитьЗначениеПоля("KTR");
			НоваяСтрока.Примечание = СокрЛП(Сред(ФайлЛимЗатр.ПолучитьЗначениеПоля("PRIM"),3));
		КонецЕсли;
		ФайлЛимЗатр.Следующая();
	КонецЦикла;
КонецПроцедуры

// Заполнение таблицы данными из файла Smeta.dbf  для загрузки документа Локальная смета.
//  Документов Объектная Смета, Сводная Смета. 
Процедура ЗаполнениеТаблицыСметы(ФайлСмета,ТабДокументов,ТипДокументаСмета,КодГлавнойСметы,ИндексСтрокиТаблицы,СтруктураГлобальныхПеременных)

	НоваяСтрока = ТабДокументов.Добавить();
	ИндексСтрокиТаблицы = НоваяСтрока;
	НоваяСтрока.ИДНомерДокумента = ФайлСмета.ПолучитьЗначениеПоля("NOMER");

	НоваяСтрока.ТипДокументаСмета = ТипДокументаСмета;	
	НоваяСтрока.КодГлавнойСметы = КодГлавнойСметы;
	// Общие Реквизиты.
	НоваяСтрока.НомерДокумента = ФайлСмета.ПолучитьЗначениеПоля("CODE");	
	НоваяСтрока.ДатаДокумента  = ФайлСмета.ПолучитьЗначениеПоля("DATE");	
	НоваяСтрока.Наименование   = СокрЛП(ФайлСмета.ПолучитьЗначениеПоля("NAME"));	
	Попытка
		НоваяСтрока.НомерСметы     = СокрЛП(ФайлСмета.ПолучитьЗначениеПоля("PRINCODE"));
	Исключение
		НоваяСтрока.НомерСметы     = "1";
	КонецПопытки;
	НоваяСтрока.Заказчик       = СокрЛП(ФайлСмета.ПолучитьЗначениеПоля("ZAK"));
	НоваяСтрока.Подрядчик      = СокрЛП(ФайлСмета.ПолучитьЗначениеПоля("POD"));
	НоваяСтрока.НаименованиеДоговора   = СокрЛП(ФайлСмета.ПолучитьЗначениеПоля("DOGOV"));
	ТекПоля = ФайлСмета.Поля;
	Рез = ТекПоля.Найти("DOGOVNOM");
	Если Рез <> Неопределено Тогда
		НоваяСтрока.НомерДоговора = ФайлСмета.ПолучитьЗначениеПоля("DOGOVNOM"); 
		НоваяСтрока.ДатаДоговора  = ФайлСмета.ПолучитьЗначениеПоля("DOGOVDAT");
	КонецЕсли;
	НоваяСтрока.Основание  = ФайлСмета.ПолучитьЗначениеПоля("OSNOV");
	Попытка
		ТипСтроительства = ФайлСмета.ПолучитьЗначениеПоля("REMONT");
		НоваяСтрока.ТипСтроительства = ?(ТипСтроительства = 0,Перечисления.СМ_ТипыСтроительства.НовоеСтроительство,Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт);
	Исключение
		НоваяСтрока.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.НовоеСтроительство;
	КонецПопытки;
	РайонСметы = СокрЛП(ФайлСмета.ПолучитьЗначениеПоля("RAJ"));
	ПозРазд = Найти(РайонСметы,";");
	КодРайона = Сред(РайонСметы,1,ПозРазд-1);
	НаименованиеРайона = СокрЛП(Сред(РайонСметы,ПозРазд+1));
	НоваяСтрока.КодРайона = КодРайона;
	НоваяСтрока.НаименованиеРайона = НаименованиеРайона;
	Округлять = ?(ФайлСмета.ПолучитьЗначениеПоля("OKR")= 1,Истина,Ложь);
	ФорматОкругл = ФайлСмета.ПолучитьЗначениеПоля("FOKR");
	Если ТипДокументаСмета = "Локальная" Тогда
		НоваяСтрока.МетодРасчета  = ОпределитьМетод(ФайлСмета.ПолучитьЗначениеПоля("METOD"));
		Если НоваяСтрока.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный Тогда
			НоваяСтрока.УровеньИндексов = ОпределитьУровень(ФайлСмета.ПолучитьЗначениеПоля("METOD"));
			НоваяСтрока.СпособРасчетаИндексов = ОпределитьСпособРасчетаИндексов(ФайлСмета.ПолучитьЗначениеПоля("METOD"));
			НоваяСтрока.БезПримененияКоэффициентов = Ложь;
			НоваяСтрока.РасчетНРиСПотПЗ = Ложь;
			НоваяСтрока.Методика1984 = Ложь;
			
			Если СтруктураГлобальныхПеременных.Методика1984 = Истина Тогда
				Если СтруктураГлобальныхПеременных.НовыйАрхив = Ложь Тогда
					// Для старого архива 2.2 Всегда 
					Если ФайлСмета.ПолучитьЗначениеПоля("METOD") = 0 Тогда
						НоваяСтрока.БезПримененияКоэффициентов = Истина;
						НоваяСтрока.РасчетНРиСПотПЗ = Истина;
						НоваяСтрока.Методика1984 = СтруктураГлобальныхПеременных.Методика1984;
					Иначе
						НоваяСтрока.БезПримененияКоэффициентов = Ложь;
						НоваяСтрока.РасчетНРиСПотПЗ = Истина;
						НоваяСтрока.Методика1984 = СтруктураГлобальныхПеременных.Методика1984;
					КонецЕсли;	
				Иначе
					НоваяСтрока.РасчетНРиСПотПЗ = ?(ФайлСмета.ПолучитьЗначениеПоля("PRIZNR") = 1,Ложь,Истина);
					НоваяСтрока.Методика1984 = СтруктураГлобальныхПеременных.Методика1984;
				    НоваяСтрока.БезПримененияКоэффициентов = ?(ФайлСмета.ПолучитьЗначениеПоля("METOD") = 0, Истина, Ложь); 
				КонецЕсли;
			КонецЕсли;
		Иначе	
		Рез = ТекПоля.Найти("POMASH");
		Если Рез <> Неопределено Тогда
			ТекВариант = ФайлСмета.ПолучитьЗначениеПоля("POMASH");
			Если НоваяСтрока.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
				НоваяСтрока.ВариантРасчетаЗМ = ?(ТекВариант <> 0,Перечисления.СМ_ВариантыРасчетаЗМ.Расчетный, Перечисления.СМ_ВариантыРасчетаЗМ.Усредненный);
			Иначе
				НоваяСтрока.ВариантРасчетаЗМ = Перечисления.СМ_ВариантыРасчетаЗМ.Расчетный;
			КонецЕсли;
		Иначе
			НоваяСтрока.ВариантРасчетаЗМ = Перечисления.СМ_ВариантыРасчетаЗМ.Расчетный;
		КонецЕсли;
	КонецЕсли;
	Рез = ТекПоля.Найти("UCH");
	
	Если Рез <> Неопределено Тогда
		УпрощеннаяСН = ФайлСмета.ПолучитьЗначениеПоля("UCH");
	Иначе
		УпрощеннаяСН = 0;
	КонецЕсли;;
	НоваяСтрока.Глава = ФайлСмета.ПолучитьЗначениеПоля("GLAVA");
	НоваяСтрока.УпрощеннаяСН = ?(УпрощеннаяСН = 0,Ложь,Истина);
	Рез = ТекПоля.Найти("AEC");
	
	Если Рез <> Неопределено Тогда
		НоваяСтрока.РеконструкцияАЭС = ?(ФайлСмета.ПолучитьЗначениеПоля("AEC") = 1, Истина, Ложь);
	Иначе
		НоваяСтрока.РеконструкцияАЭС = Ложь;
	КонецЕсли;
	ПозРазд = Найти(РайонСметы,";");
	КодРайона = Сред(РайонСметы,1,ПозРазд-1);
	НаименованиеРайона = СокрЛП(Сред(РайонСметы,ПозРазд+1));
	НоваяСтрока.КодРайона = КодРайона;
	НоваяСтрока.НаименованиеРайона = НаименованиеРайона;
	Рез = ТекПоля.Найти("TYPRAION");
	
	Если Рез <> Неопределено Тогда
		ТипРайона = ФайлСмета.ПолучитьЗначениеПоля("TYPRAION");
	Иначе
		ТипРайона = 1;
	КонецЕсли;
	Если ТипРайона = 1 Тогда
		НоваяСтрока.ТипРайона = Перечисления.СМ_ТипыРайонов.НеОтносится;    
		ИначеЕсли ТипРайона = 2 Тогда
			НоваяСтрока.ТипРайона = Перечисления.СМ_ТипыРайонов.Приравнен;    
		ИначеЕсли ТипРайона = 3 Тогда
			НоваяСтрока.ТипРайона = Перечисления.СМ_ТипыРайонов.Относится; 
		Иначе
			НоваяСтрока.ТипРайона =  ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ТипРайона");	    
		КонецЕсли;
		
		Рез = ТекПоля.Найти("INDEMM");
	
		Если Рез <> Неопределено Тогда
			ВариантПересчетаЭММ = ФайлСмета.ПолучитьЗначениеПоля("INDEMM");
			Если ВариантПересчетаЭММ = 1 Тогда
				НоваяСтрока.ВариантПересчетаЭММ  = Перечисления.СМ_ВариантыПересчетаЭММ.Разные;
			ИначеЕсли ВариантПересчетаЭММ = 2 Тогда
				НоваяСтрока.ВариантПересчетаЭММ  = Перечисления.СМ_ВариантыПересчетаЭММ.РазныеКРазности;
			Иначе
				НоваяСтрока.ВариантПересчетаЭММ  = Перечисления.СМ_ВариантыПересчетаЭММ.Одинаковые;
			КонецЕсли;	
		Иначе
			НоваяСтрока.ВариантПересчетаЭММ  = Перечисления.СМ_ВариантыПересчетаЭММ.Одинаковые;
		КонецЕсли;
		Рез = ТекПоля.Найти("KCMP");
	
		Если Рез <> Неопределено Тогда
			// Если не определен КСМР то и остальных нет
		НоваяСтрока.КоэффСМР = ФайлСмета.ПолучитьЗначениеПоля("KCMP");
		НоваяСтрока.КоэффФОТ = ФайлСмета.ПолучитьЗначениеПоля("KFOT");
		НоваяСтрока.КоэффОборуд = ФайлСмета.ПолучитьЗначениеПоля("KOB");
		НоваяСтрока.КоэффПрочРаб = ФайлСмета.ПолучитьЗначениеПоля("KPR");
		НоваяСтрока.КоэффСтоимЭксплМашин = ФайлСмета.ПолучитьЗначениеПоля("KCMP");
		НоваяСтрока.КоэффФОТ = ФайлСмета.ПолучитьЗначениеПоля("KFOT");
		НоваяСтрока.КоэффОборуд = ФайлСмета.ПолучитьЗначениеПоля("KOB");
		НоваяСтрока.КоэффСтоимМатериалов = ФайлСмета.ПолучитьЗначениеПоля("KPR");
		КонецЕсли;
		Если Округлять И ФорматОкругл = 0 Тогда
			НоваяСтрока.Округлять = Истина;
		Иначе	
			НоваяСтрока.Округлять = Ложь;
		КонецЕсли;	
		Рез = ТекПоля.Найти("VYPUSKCE");
		Если Рез <> Неопределено Тогда
			НоваяСтрока.ДатаТекущихЦен = ФайлСмета.ПолучитьЗначениеПоля("VYPUSKCE");
		КонецЕсли;
		// ДатаКоэффициентов.
		НоваяСтрока.ДатаВыпускаИндексов = ФайлСмета.ПолучитьЗначениеПоля("VYPUSK");
		Рез = ТекПоля.Найти("NRSP");
		Если Рез <> Неопределено Тогда
			ЗначПеречНРиСП = ФайлСмета.ПолучитьЗначениеПоля("NRSP");
			Если ЗначПеречНРиСП = 1 Тогда
				НоваяСтрока.ПрименятьКоэффициентыНРСП =Перечисления.СМ_НРИСПДляСметыНаРемонт.ТолькоНР;	
			ИначеЕсли ЗначПеречНРиСП = 2 Тогда
				НоваяСтрока.ПрименятьКоэффициентыНРСП =Перечисления.СМ_НРИСПДляСметыНаРемонт.ТолькоСП;
			ИначеЕсли ЗначПеречНРиСП = 3 Тогда
				НоваяСтрока.ПрименятьКоэффициентыНРСП =Перечисления.СМ_НРИСПДляСметыНаРемонт.ПрименятьНРиСП;
			КонецЕсли;
		КонецЕсли;

	 
	ИначеЕсли ТипДокументаСмета = "Объектная" Тогда
		НоваяСтрока.КоличествоОбъектов = ФайлСмета.ПолучитьЗначениеПоля("KOLOB");
		НоваяСтрока.Глава = ФайлСмета.ПолучитьЗначениеПоля("GLAVA");
		НоваяСтрока.Округлять = Округлять;
		НоваяСтрока.ФорматОкругл = ФорматОкругл;

	ИначеЕсли ТипДокументаСмета = "Сводная" Тогда
		НоваяСтрока.КоличествоОбъектов = ФайлСмета.ПолучитьЗначениеПоля("KOLOB");
		НоваяСтрока.Округлять = Округлять;
		НоваяСтрока.ФорматОкругл = ФорматОкругл;
	
	ИначеЕсли ТипДокументаСмета = "Папка" Тогда
	КонецЕсли;	
КонецПроцедуры

// Заполнение таблицы подписей из файла SIGNS.DBF.
Процедура ЗаполнениеТаблицыПодписей(ТабПодписи,Подписи)
	Пока Не Подписи.ВКонце() Цикл
		НоваяСтрока = ТабПодписи.Добавить();
		НоваяСтрока.CODE = СокрЛП(Подписи.ПолучитьЗначениеПоля("CODE"));
		НоваяСтрока.ID = Подписи.ПолучитьЗначениеПоля("ID");
		НоваяСтрока.Должность = СокрЛП(Подписи.ПолучитьЗначениеПоля("DOLN"));
		НоваяСтрока.Фио = СокрЛП(Подписи.ПолучитьЗначениеПоля("FIO"));
		ТекПоля = Подписи.Поля;
		Рез = ТекПоля.Найти("SHAPKA");
		Если Рез <> Неопределено Тогда
			НоваяСтрока.ДляШапки = ?(Подписи.ПолучитьЗначениеПоля("SHAPKA")= 1,Истина,Ложь);
		КонецЕсли;
		Рез = ТекПоля.Найти("TIPSHAP");
		Если Рез <> Неопределено Тогда
			НоваяСтрока.СогасованоУтверждаю = СокрЛП(Подписи.ПолучитьЗначениеПоля("TIPSHAP"));
		КонецЕсли;
		Подписи.Следующая();
	КонецЦикла;
КонецПроцедуры	

