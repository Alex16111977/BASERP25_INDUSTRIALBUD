		Стр = ДокОст.Наработки.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Выборка);
	КонецЦикла;
	ДокОст.Записать(РежимЗаписиДокумента.Запись);
	ВывестиСообщениеСформированыДокументы("УстановкаЗначенийНаработки");

КонецПроцедуры
