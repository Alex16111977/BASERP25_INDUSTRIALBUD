	Запрос.Текст = "ВЫБРАТЬ 
	|ОрганизацияЕГАИС,
	|АлкогольнаяПродукция,
	|Справка2,
	|КоличествоОстаток КАК Количество
	|ИЗ РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(&ГраницаОст)
	|ИТОГИ ПО ОрганизацияЕГАИС";
