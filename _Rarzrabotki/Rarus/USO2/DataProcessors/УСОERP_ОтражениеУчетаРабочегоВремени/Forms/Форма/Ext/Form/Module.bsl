	КонецЕсли;
	Если ДанныеДляДерева.Колонки.Найти("КодСДР") = Неопределено Тогда
		ДанныеДляДерева.Колонки.Добавить("КодСДР",     Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Для каждого ПолеТаблицы Из мДеревоРесурсов.Колонки Цикл
		Если ДанныеДляДерева.Колонки.Найти(ПолеТаблицы.Имя) = Неопределено Тогда
			ДанныеДляДерева.Колонки.Добавить(ПолеТаблицы.Имя, ПолеТаблицы.ТипЗначения);
		КонецЕсли; 
	КонецЦикла; 		
	
	Работы.Очистить();
	Ид = 0;
	Для Каждого СтрокаРабота Из ТаблицаРабот Цикл
		
		СтрокаДерева_Работа = ДанныеДляДерева.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева_Работа, СтрокаРабота);
		СтрокаДерева_Работа.Работа 		       = СтрокаРабота.Работа;
		СтрокаДерева_Работа.РаботаРесурс       = СтрокаРабота.Работа;
		СтрокаДерева_Работа.ЭтоРабота	       = Истина;
		СтрокаДерева_Работа.РаботаРодитель     = СтрокаРабота.Работа.Родитель;
		СтрокаДерева_Работа.КодСДР             = СтрокаРабота.Работа.КодСДР ;
		СтрокаДерева_Работа.НомерРаботыВУровне = СтрокаРабота.Работа.НомерРаботыВУровне;
		
		МассивРесурсов = ТаблицаРаботИРесурсов.НайтиСтроки(Новый Структура("Работа", СтрокаРабота.Работа));
		//Если НовыйВариант Тогда
		//	МассивРесурсов = ТаблицаРаботИРесурсов
		Ид = Ид + 1;
		
		Для Каждого СтрокаРесурс Из  МассивРесурсов Цикл
			
			МассивСтрокДерева = Новый Массив;

			Для к = 1 по СтрокаРесурс.Количество Цикл
				
				Ид = Ид + 1;
				СтрокаДерева_Ресурс = СтрокаДерева_Работа.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДерева_Ресурс,  СтрокаРесурс);
				СтрокаДерева_Ресурс.РаботаРесурс =  СтрокаРесурс.Ресурс;
				СтрокаДерева_Ресурс.Ид_Строки = Ид;
				
				МассивСтрокДерева.Добавить(СтрокаДерева_Ресурс);
				
				//СтрокаДерева_Ресурс.Работа             = СтрокаРесурс.Ресурс;
				СтрокаДерева_Ресурс.РаботаРодитель     = СтрокаДерева_Работа.Работа;
				СтрокаДерева_Ресурс.КодСДР             = Неопределено;
				СтрокаДерева_Ресурс.НомерРаботыВУровне = Неопределено;
				
			КонецЦикла;
			
			МассивСоставов = ТаблицаСоставов.НайтиСтроки(Новый Структура("Работа, Ресурс", СтрокаРабота.Работа, СтрокаРесурс.Ресурс));
			
			Если НовыйВариант Тогда
				МассивСоставов = ТаблицаСоставов.НайтиСтроки(Новый Структура("Работа, Ресурс", СтрокаРабота.Работа.РаботаИсточник, СтрокаРесурс.Ресурс));
			КонецЕсли;
						
			Для к = 0 по МассивСоставов.ВГраница() Цикл
				
				Если МассивСтрокДерева.Количество() >= к + 1 тогда
					МассивСтрокДерева[к].СоставРесурса = МассивСоставов[к].СоставРесурса;
				иначе
					Ид = Ид + 1;
					СтрокаДерева_Ресурс = СтрокаДерева_Работа.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаДерева_Ресурс,  СтрокаРесурс);
					СтрокаДерева_Ресурс.РаботаРесурс =  СтрокаРесурс.Ресурс;
					СтрокаДерева_Ресурс.СоставРесурса =  МассивСоставов[к].СоставРесурса;
					СтрокаДерева_Ресурс.Ид_Строки = Ид; 
					
					СтрокаДерева_Ресурс.Работа             = СтрокаРесурс.Ресурс;
					СтрокаДерева_Ресурс.РаботаРодитель     = СтрокаДерева_Работа.Работа;
					СтрокаДерева_Ресурс.КодСДР             = Неопределено;
					СтрокаДерева_Ресурс.НомерРаботыВУровне = Неопределено;
					
				КонецЕсли;	
			КонецЦикла; 
		КонецЦикла;
		
		НоваяСтрокаРабота = Работы.Добавить();
		НоваяСтрокаРабота.Работа = СтрокаРабота.Работа;
	КонецЦикла;
	
	//ВыражениеИсточник = "Работа";
	//ВыражениеПриемник = "РаботаРодитель" ;
	//Справочник        = Справочники.УСОERP_СтроительныеРаботы;
	//ДеревоРезультат   = УСОERP_ОбработкаТабличныхЧастей.УСОERP_ПодготовитьДанныеИСформироватьДеревоСВосстановлениемСтруктуры(ДанныеДляДерева,ВыражениеИсточник, ВыражениеПриемник, "РаботаРесурс", Справочник);	
	//
	//ВремРодноеДерево = РеквизитФормыВЗначение("ДеревоРабот"); // берется родная структура с родной типизацией
	//ВремРодноеДерево.Строки.Очистить();
	//УСОERP_ОбработкаТабличныхЧастей.УСОERP_ЗаполнитьРоднуюСтруктуруДереваИзВнешнего(ВремРодноеДерево.Строки, ДеревоРезультат.Строки); // и рекурсивно заполняется из дерева, где, возможн, типиация создаст проблемы
	//ЗначениеВРеквизитФормы(ВремРодноеДерево, "ДеревоРабот");
	//ВремРодноеДерево.Строки.Очистить(); // уборка за собой
	
	ЗначениеВРеквизитФормы(ДанныеДляДерева, "ДеревоРабот");
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьНаКлиенте()
	
	КоллекцияЭлементовДерева = ДеревоРабот.ПолучитьЭлементы();
	
		
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл
		ИдентификаторСтроки	= Строка.ПолучитьИдентификатор();
		Элементы.ДеревоРабот.Свернуть(ИдентификаторСтроки);
	КонецЦикла;
	

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьНаКлиенте(СтрокаДерева)
	
	КоллекцияЭлементовДерева = СтрокаДерева.ПолучитьЭлементы();
		
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл
		ИдентификаторСтроки	= Строка.ПолучитьИдентификатор();
		Элементы.ДеревоРабот.Развернуть(ИдентификаторСтроки);
		
		Если Строка.ПолучитьЭлементы().количество()>0 Тогда
			РазвернутьНаКлиенте(Строка);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСотрудниковИзСоставов(ИдентификаторСтроки = Неопределено)
	
	Если ИдентификаторСтроки = Неопределено Тогда
		Сотрудники.Очистить();
		
		РаботыОбъекта  = ДеревоРабот.ПолучитьЭлементы();
		Для Каждого СтрокаРабота Из РаботыОбъекта Цикл
			РесурсыРабот = СтрокаРабота.ПолучитьЭлементы();
			Для Каждого СтрокаСостава Из РесурсыРабот Цикл
				Если ЗначениеЗаполнено(СтрокаСостава.СоставРесурса) Тогда
					ТаблицаСотрудников = ПолучитьИсполнителейРабот(СтрокаСостава.СоставРесурса);
					
					Для Каждого СтрокаСотрудник из ТаблицаСотрудников Цикл
						НоваяСтрока = Сотрудники.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСотрудник);
						НоваяСтрока.Работа 			= СтрокаСостава.Работа;
						НоваяСтрока.Ресурс 			= СтрокаСостава.Ресурс;
						НоваяСтрока.СоставРесурса 	= СтрокаСостава.СоставРесурса;
						НоваяСтрока.Ид_Строки 		= СтрокаСостава.Ид_Строки;
						КадровыеДанныеСотрудника = КадровыйУчет.КадровыеДанныеСотрудников(Истина, НоваяСтрока.Сотрудник, "Организация,ГрафикРаботы", ТекущаяДатаСеанса());
						Если КадровыеДанныеСотрудника.Количество() > 0 Тогда
							НоваяСтрока.ГрафикРаботы = КадровыеДанныеСотрудника[0].ГрафикРаботы;
						КонецЕсли; 

					КонецЦикла;
					
				КонецЕсли;			
			КонецЦикла; 		
		КонецЦикла;
		
	Иначе
		ТекущиеДанные = ДеревоРабот.НайтиПоИдентификатору( ИдентификаторСтроки);
		
		СтрокиКУдалению = Сотрудники.НайтиСтроки(Новый Структура("Работа, Ресурс, Ид_Строки", ТекущиеДанные.Работа, ТекущиеДанные.Ресурс, ТекущиеДанные.Ид_Строки));
		Для Каждого СтрокаУдаление Из СтрокиКУдалению Цикл
			Сотрудники.Удалить(СтрокаУдаление);
		КонецЦикла;
		
		СтрокиКУдалению = Зарезервировано.НайтиСтроки(Новый Структура("Работа, Ресурс, Ид_Строки", ТекущиеДанные.Работа, ТекущиеДанные.Ресурс, ТекущиеДанные.Ид_Строки));
		Для Каждого СтрокаУдаление Из СтрокиКУдалению Цикл
			Зарезервировано.Удалить(СтрокаУдаление);
		КонецЦикла;

		ТаблицаСотрудников = ПолучитьИсполнителейРабот(ТекущиеДанные.СоставРесурса);
		
		Для Каждого СтрокаСотрудник из ТаблицаСотрудников Цикл
			НоваяСтрока = Сотрудники.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСотрудник);
			НоваяСтрока.Работа 			= ТекущиеДанные.Работа;
			НоваяСтрока.Ресурс 			= ТекущиеДанные.Ресурс;
			НоваяСтрока.СоставРесурса 	= ТекущиеДанные.СоставРесурса;
			НоваяСтрока.Ид_Строки       = ТекущиеДанные.Ид_Строки;
			
			КадровыеДанныеСотрудника = КадровыйУчет.КадровыеДанныеСотрудников(Истина, НоваяСтрока.Сотрудник, "Организация,ГрафикРаботы", ТекущаяДатаСеанса());
			Если КадровыеДанныеСотрудника.Количество() > 0 Тогда
				НоваяСтрока.ГрафикРаботы = КадровыеДанныеСотрудника[0].ГрафикРаботы;
			КонецЕсли; 
						
		КонецЦикла;   
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьИсполнителейРабот(СоставРесурса)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_СоставРесурсовРабочие.Сотрудник,
	|	УСОERP_СоставРесурсовРабочие.Должность
	|ИЗ
	|	Справочник.УСОERP_СоставРесурсов.Рабочие КАК УСОERP_СоставРесурсовРабочие
	|ГДЕ
	|	УСОERP_СоставРесурсовРабочие.Ссылка = &СоставРесурса
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_СоставРесурсовРабочие.НомерСтроки";
	Запрос.УстановитьПараметр("СоставРесурса", СоставРесурса);
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Выгрузить();
	
КонецФункции

&НаКлиенте
Функция ВернутьКоординатыВыделеннойОбласти()  	
	
	Если ТабличноеПоле.ВыделенныеОбласти.Количество() > 1 Тогда 
		ПоказатьПредупреждение(,"Выделено более одной области!!!",,"...Ошибка...");
		Возврат Неопределено;
	КонецЕсли;
	Если ТабличноеПоле.ВыделенныеОбласти.Количество() = 0 Тогда 
		ПоказатьПредупреждение(,"Не выделено ни одной области!!!",,"...Ошибка...");
		Возврат Неопределено;
	КонецЕсли;
	
	ВыделеннаяОбласть = ТабличноеПоле.ВыделенныеОбласти.Получить(0);

	Если ВыделеннаяОбласть.Верх <> ВыделеннаяОбласть.Низ Тогда 
	    ПоказатьПредупреждение(,"Ошибка выделения области!!! Выделено более одной строки",,"...Ошибка...");
		Возврат Неопределено;
	КонецЕсли;
	
	КоординатыВыделеннойОбласти = Новый Структура;
	КоординатыВыделеннойОбласти.Вставить("СтрокаВерх",ВыделеннаяОбласть.Верх);
	КоординатыВыделеннойОбласти.Вставить("КолонкаЛево",ВыделеннаяОбласть.Лево);
	КоординатыВыделеннойОбласти.Вставить("КолонкаПраво",ВыделеннаяОбласть.Право);
	
	Возврат КоординатыВыделеннойОбласти;
	
КонецФункции

&НаСервере
Процедура ЗадействоватьРесурсНаСервере(КоординатыВыделеннойОбласти)
	
	Если Объект.ОбщееЧислоЧасовРезервирования = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	КЧ_12_2 = Новый КвалификаторыЧисла(12,2);
    Массив = Новый Массив;
    Массив.Добавить(Тип("Число"));
    ОписаниеТиповЧисло_12_2 = Новый ОписаниеТипов(Массив, , ,КЧ_12_2);
		
	ТЗЗарезервировано = Новый ТаблицаЗначений;
	ТЗЗарезервировано.Колонки.Добавить("Сотрудник");
	ТЗЗарезервировано.Колонки.Добавить("Должность");
	ТЗЗарезервировано.Колонки.Добавить("Работа");
	ТЗЗарезервировано.Колонки.Добавить("Ресурс");
	ТЗЗарезервировано.Колонки.Добавить("СоставРесурса");
	ТЗЗарезервировано.Колонки.Добавить("Дата");
	ТЗЗарезервировано.Колонки.Добавить("НомерКолонки");
	ТЗЗарезервировано.Колонки.Добавить("НомерСтрокиРезерв");
	ТЗЗарезервировано.Колонки.Добавить("КоличествоЧасов",ОписаниеТиповЧисло_12_2);
	ТЗЗарезервировано.Колонки.Добавить("ВремяНачала");
	ТЗЗарезервировано.Колонки.Добавить("ВремяОкончания");
	ТЗЗарезервировано.Колонки.Добавить("Ид_Строки");
	
	СтруктураПараметров = ОпределитьСотрудникаПоСтроке(КоординатыВыделеннойОбласти.СтрокаВерх);
	
	Если Не ЗначениеЗаполнено(СтруктураПараметров) Тогда
		Возврат;
	КонецЕсли;
	
	РесурсСотрудник = СтруктураПараметров.Сотрудник;
	 
	Если РесурсСотрудник = Неопределено Тогда 
		Сообщить("Неверно выделена область! выделите область ""К отражению"" напротив сотрудника...",СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;
	
	// Возможность "размазывать" руками указанное количество часов при резервировании
	КоличествоДней = (КоординатыВыделеннойОбласти.КолонкаПраво - КоординатыВыделеннойОбласти.КолонкаЛево)+1;
	ОстатокЧасовНаПервыйДень = 0;
	//ОсновноеКоличествоЧасов = Цел(Объект.ОбщееЧислоЧасовРезервирования/КоличествоДней);
	//ОстатокЧасовНаПервыйДень = Объект.ОбщееЧислоЧасовРезервирования - ОсновноеКоличествоЧасов * КоличествоДней;
	
	ОсновноеКоличествоЧасов = Объект.ОбщееЧислоЧасовРезервирования/КоличествоДней;  

	КоличествоДнейДляЕжей  = 0; //rarus_BeDm_2014_05_28 -->
	Ид_Строки = мТекущийИд_Строки;
	Для НомерКолонки = КоординатыВыделеннойОбласти.КолонкаЛево по КоординатыВыделеннойОбласти.КолонкаПраво Цикл 
		
		ДатаКолонки = ОпределитьДатуПоКолонке(НомерКолонки);
		
		Если ДатаКолонки = Неопределено Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неверно выделена область! область выходит за рамки разметки...");
			Возврат;
		КонецЕсли;
		
		Если ОстатокЧасовНаПервыйДень > 0 Тогда
						
			Если (КоличествоДней - КоличествоДнейДляЕжей) = ОстатокЧасовНаПервыйДень Тогда
				КоличествоЧасовДляСписания	= ОсновноеКоличествоЧасов + 1;
				ОстатокЧасовНаПервыйДень 	= ОстатокЧасовНаПервыйДень - 1;
			Иначе
				КоличествоЧасовДляСписания = ОсновноеКоличествоЧасов;
			КонецЕсли;
			КоличествоДнейДляЕжей = КоличествоДнейДляЕжей + 1;
			
		Иначе 
			КоличествоЧасовДляСписания = ОсновноеКоличествоЧасов;
		КонецЕсли;
		
			
		МассивСтрокПоСотруднику = ГрафикРаботыСотрудников.НайтиСтроки(Новый Структура("Сотрудник, Дата", РесурсСотрудник, ДатаКолонки));
		
		Если МассивСтрокПоСотруднику.Количество() >0 Тогда
			СтрутктураГрафик = МассивСтрокПоСотруднику[0];
			Если СтрутктураГрафик.ВидУчетаВремени = Справочники.ВидыИспользованияРабочегоВремени.ВыходныеДни
				ИЛИ СтрутктураГрафик.ВидУчетаВремени = Справочники.ВидыИспользованияРабочегоВремени.Праздники Тогда 
				// Выходной (без обедов и начинается с 1:00 до 23:00)
				НоваяСтрока = ТЗЗарезервировано.Добавить();
				НоваяСтрока.Сотрудник = РесурсСотрудник;
				НоваяСтрока.Должность = СтруктураПараметров.Должность;;
				НоваяСтрока.Работа = СтруктураПараметров.Работа;
				НоваяСтрока.Ресурс = СтруктураПараметров.Ресурс;
