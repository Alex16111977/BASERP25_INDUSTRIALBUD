	|				И (Дата МЕЖДУ &НачалоПериода И &КонецПериода)
	|				И Исполнитель В (&Сотрудники)
	|				И (Работа = &Работа ИЛИ Работа.РаботаИсточник = &РаботаИсточник)
	|				И Ресурс = &Ресурс) КАК ТабельИсполнителейРаботОстаткиИОбороты
	|ГДЕ
	|	ТабельИсполнителейРаботОстаткиИОбороты.Регистратор ССЫЛКА Документ.УСОERP_УчетРаботыСотрудниковТехники
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабельИсполнителейРаботОстаткиИОбороты.Исполнитель,
	|	ТабельИсполнителейРаботОстаткиИОбороты.Дата
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УСОERP_НазначенияИсполнителейРаботОбороты.Сотрудник,
	|	УСОERP_НазначенияИсполнителейРаботОбороты.Период,
	|	СУММА(0),
	|	0,
	|	СУММА(0),
	|	СУММА(ЕСТЬNULL(УСОERP_НазначенияИсполнителейРаботОбороты.КоличествоОборот, 0))
	|ИЗ
	|	РегистрНакопления.УСОERP_НазначенияИсполнителейРабот.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			Организация = &Организация
	|				И Сотрудник В (&Сотрудники)
	|				И (Работа = &Работа    ИЛИ Работа.РаботаИсточник = &РаботаИсточник)
	|				И Ресурс = &Ресурс
	|				И СоставРесурса = &СоставРесурса) КАК УСОERP_НазначенияИсполнителейРаботОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_НазначенияИсполнителейРаботОбороты.Сотрудник,
	|	УСОERP_НазначенияИсполнителейРаботОбороты.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_КоличествоЧасов.Сотрудник КАК Сотрудник,
	|	ВТ_КоличествоЧасов.Дата КАК ПериодДень,
	|	СУММА(ВТ_КоличествоЧасов.ЧасовПоГрафику) КАК КоличествоЧасовПоГрафику,
	|	ВЫБОР
	|		КОГДА СУММА(ВТ_КоличествоЧасов.ЧасовНазначеноВсего) < 0
	|			ТОГДА 0
	|		ИНАЧЕ СУММА(ВТ_КоличествоЧасов.ЧасовНазначеноВсего)
	|	КОНЕЦ КАК КоличествоЧасовНазначеноВсего,
	|	ВЫБОР
	|		КОГДА СУММА(ВТ_КоличествоЧасов.ЧасовНазначено) < 0
	|			ТОГДА 0
	|		ИНАЧЕ СУММА(ВТ_КоличествоЧасов.ЧасовНазначено)
	|	КОНЕЦ КАК КоличествоЧасовНазначено,
	|	СУММА(ВТ_КоличествоЧасов.ЧасовОтраженоВУчете) КАК КоличествоЧасовОтраженоВУчете,
	|	СУММА(0) КАК КоличествоЧасовКОтражению,
	|	СУММА(0) КАК КоличествоЧасовКОтражениюВсего
	|ИЗ
	|	ВТ_КоличествоЧасов КАК ВТ_КоличествоЧасов
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_КоличествоЧасов.Сотрудник,
	|	ВТ_КоличествоЧасов.Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудник,
	|	ВТ_КоличествоЧасов.Дата";
	Запрос.УстановитьПараметр("ДанныеПоСотрудникам", 	ТаблицаСотрудников);
	Запрос.УстановитьПараметр("Сотрудники", 			ТаблицаСотрудников.ВыгрузитьКолонку("Сотрудник"));
	Запрос.УстановитьПараметр("НачалоПериода", 			НачалоДня(мДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода", 			КонецДня(мДатаОкончания));
	Запрос.УстановитьПараметр("Организация", 			Организация);
	Запрос.УстановитьПараметр("Подразделение", 			Подразделение);
	Запрос.УстановитьПараметр("ОбъектСтроительства", 	ОбъектСтроительства);
	Запрос.УстановитьПараметр("Работа", 				ТекущиеДанные.Работа);
	Запрос.УстановитьПараметр("РаботаИсточник",         ТекущиеДанные.Работа.РаботаИсточник);
	Запрос.УстановитьПараметр("Ресурс", 				ТекущиеДанные.Ресурс);
	Запрос.УстановитьПараметр("СоставРесурса", 			ТекущиеДанные.СоставРесурса);
	
	Возврат Запрос.Выполнить();
			
КонецФункции

&НаСервере
Функция ВыходнойДень(Сотрудник, АнализируемаяДата)
	
	МассивСтрок = ГрафикРаботыСотрудников.НайтиСтроки(Новый Структура("Сотрудник, Дата", Сотрудник , АнализируемаяДата));
	Если МассивСтрок.Количество() > 0 Тогда
		СтрокаГрафика = МассивСтрок[0];
		Если СтрокаГрафика.ВидУчетаВремени = Справочники.ВидыИспользованияРабочегоВремени.ВыходныеДни
			ИЛИ СтрокаГрафика.ВидУчетаВремени = Справочники.ВидыИспользованияРабочегоВремени.Праздники Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	Иначе		
		Если ДеньНедели(АнализируемаяДата) = 6 ИЛИ ДеньНедели(АнализируемаяДата) = 7 Тогда 
			Возврат Истина;
		Иначе 
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;	

КонецФункции

&НаКлиенте
Процедура ОткрытьУказаниеЧасовНаРезервированиеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ЗначениеВозврата = Результат;
	
	Если ЗначениеВозврата = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ОбщееЧислоЧасовРезервирования = ЗначениеВозврата;
	ЗадействоватьРесурсНаСервере(ДополнительныеПараметры.КоординатыВыделеннойОбласти);
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Элементы.Зарезервировано.ОтборСтрок = Новый ФиксированнаяСтруктура("Работа, Ресурс, СоставРесурса, Ид_Строки", ТекущиеДанные.Работа, ТекущиеДанные.Ресурс, ТекущиеДанные.СоставРесурса, ТекущиеДанные.Ид_Строки);
	Элементы.Зарезервировано.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДокументыУчетаРабот()
	
	Если Зарезервировано.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ДатаНачала) Тогда
		мДатаНачала = ДатаНачала;
	Иначе		
		Зарезервировано.Сортировать("Дата Возр");
		мДатаНачала = Зарезервировано[0].Дата;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаОкончания) Тогда
		мДатаОкончания = НачалоДня(КонецНедели(ДатаОкончания));
	Иначе		
		Зарезервировано.Сортировать("Дата Убыв");
		мДатаОкончания = Зарезервировано[0].Дата;
	КонецЕсли;
		
	НачалоНедели = НачалоНедели(мДатаНачала);
	ТЗ_РаспределенныеРаботы 		= Зарезервировано.Выгрузить(, "Дата, Работа, Ресурс, СоставРесурса, Должность, Сотрудник, КоличествоЧасов");
	ТЗ_РаспределенныеРаботы.Свернуть("Дата, Работа, Ресурс, СоставРесурса, Должность, Сотрудник", "КоличествоЧасов");
	ТЗ_РаспределенныеРаботыНеделя 	= ТЗ_РаспределенныеРаботы.СкопироватьКолонки();
	
	Пока мДатаНачала <= мДатаОкончания Цикл
		
		Если НачалоНедели <> НачалоНедели(мДатаНачала) ИЛИ мДатаНачала = мДатаОкончания Тогда
			
			Если ТЗ_РаспределенныеРаботыНеделя.Количество() > 0 Тогда
								
				НовыйДокументУчетаРабот 					= Документы.УСОERP_УчетРаботыСотрудниковТехники.СоздатьДокумент();
				НовыйДокументУчетаРабот.Дата 				= ТекущаяДата();
				НовыйДокументУчетаРабот.Дата 				= КонецНедели(НачалоНедели);
				НовыйДокументУчетаРабот.НачалоПериода 		= НачалоНедели;
				НовыйДокументУчетаРабот.ОкончаниеПериода	= КонецНедели(НачалоНедели);
				
				НовыйДокументУчетаРабот.Организация 		= Организация;
				НовыйДокументУчетаРабот.Подразделение 		= Подразделение;
				НовыйДокументУчетаРабот.ОбъектСтроительства = ОбъектСтроительства;
				НовыйДокументУчетаРабот.Ответственный 		= ПараметрыСеанса.ТекущийПользователь;
				
				НовыйДокументУчетаРабот.ДокументУтверждения = ДокументУтверждения;
				
				ТЗ_Работы = ТЗ_РаспределенныеРаботыНеделя.Скопировать(, "Работа, Ресурс, СоставРесурса, Должность, Сотрудник");
				ТЗ_Работы.Свернуть("Работа, Ресурс, СоставРесурса, Должность, Сотрудник");
				
				Для Каждого ТекСтрока Из ТЗ_Работы Цикл
					
					НоваяСтрокаРабота = НовыйДокументУчетаРабот.Табель.Добавить();
					НоваяСтрокаРабота.Работа 						= ТекСтрока.Работа;
					НоваяСтрокаРабота.Ресурс 						= ТекСтрока.Ресурс;
					НоваяСтрокаРабота.СоставРесурса 				= ТекСтрока.СоставРесурса;
					НоваяСтрокаРабота.ДолжностьТипМашинМеханизмов 	= ТекСтрока.Должность;
					НоваяСтрокаРабота.СотрудникОсновноеСредство 	= ТекСтрока.Сотрудник;
					
					ТЗ_РаспределенныеРаботыНеделя.Сортировать("Дата ВОЗР");
					НачалоЗанятости = ТЗ_РаспределенныеРаботыНеделя[0].Дата;
					ТЗ_РаспределенныеРаботыНеделя.Сортировать("Дата УБЫВ");
					КонецЗанятости 	= КонецДня(ТЗ_РаспределенныеРаботыНеделя[0].Дата);
					
					ДанныеРаботы = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьДанныеРаботы(ТекСтрока.Работа, НовыйДокументУчетаРабот.ОкончаниеПериода);

					ДанныеРаботы.НачалоПлан 	= НачалоДня(ДанныеРаботы.НачалоПлан);
					ДанныеРаботы.ОкончаниеПлан 	= КонецДня(ДанныеРаботы.ОкончаниеПлан);
					
					Если НовыйВариант Тогда
						ДанныеРаботы.НачалоПлан    = НачалоДня(ТекСтрока.Работа.ДатаНачала);
						ДанныеРаботы.ОкончаниеПлан = КонецДня(ТекСтрока.Работа.ДатаОкончания);
					КонецЕсли;
					
					
					Если НачалоЗанятости > ДанныеРаботы.ОкончаниеПлан ИЛИ КонецЗанятости < ДанныеРаботы.НачалоПлан Тогда
						НачалоЗанятости = Дата(1,1,1);
						КонецЗанятости	= Дата(1,1,1);
					ИначеЕсли КонецЗанятости < ДанныеРаботы.ОкончаниеПлан Тогда
						Если НачалоЗанятости < ДанныеРаботы.НачалоПлан Тогда
							НачалоЗанятости = ДанныеРаботы.НачалоПлан;
						КонецЕсли;
					Иначе
						КонецЗанятости = ДанныеРаботы.ОкончаниеПлан;
						Если НачалоЗанятости < ДанныеРаботы.НачалоПлан Тогда
							НачалоЗанятости = ДанныеРаботы.НачалоПлан;
						КонецЕсли;
					КонецЕсли;
					
					Длительность = Окр((КонецЗанятости - НачалоЗанятости) / 86400);

					Если  ЗначениеЗаполнено(ДанныеРаботы.ДлительностьПлан) Тогда 
						НоваяСтрокаРабота.ОбъемРабот = (Длительность / ДанныеРаботы.ДлительностьПлан) * ДанныеРаботы.ОбъемОбщий;
					КонецЕсли;
																											
					МассивКоличествоЧасов = ТЗ_РаспределенныеРаботыНеделя.НайтиСтроки(
					Новый Структура("Работа, 			Ресурс, 			СоставРесурса, 				Должность, 				Сотрудник", 
									ТекСтрока.Работа, 	ТекСтрока.Ресурс, 	ТекСтрока.СоставРесурса, 	ТекСтрока.Должность, 	ТекСтрока.Сотрудник));
																										
					Для Каждого СтрокаКоличествоЧасов Из МассивКоличествоЧасов Цикл
						НоваяСтрокаРабота["КоличествоЧасов" + Окр(1 + (СтрокаКоличествоЧасов.Дата - НачалоНедели) / 86400)] = СтрокаКоличествоЧасов.КоличествоЧасов;
					КонецЦикла;
																										
				КонецЦикла;
								
				НовыйДокументУчетаРабот.Комментарий = "#Создан программно пользователем " + НовыйДокументУчетаРабот.Ответственный + " " + Формат(ТекущаяДата(), "ДЛФ=DDT") + ".";
				ДокументЗаписан = Ложь;
				
				Попытка
					НовыйДокументУчетаРабот.Записать(РежимЗаписиДокумента.Проведение);
					ДокументЗаписан = Истина;
				Исключение
					ТекстСообщения = НСтр("ru = 'Не удалось сформировать документ ""Учет работы сотрудников и техники"" по причине: %Причина%'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", 	ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					
					ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Предупреждение,
					Метаданные.Документы.УСОERP_УчетРаботыСотрудниковТехники,, ТекстСообщения);
				КонецПопытки;
				
				Если ДокументЗаписан Тогда
					НовыйУчетРабот 								= Объект.ДокументыУчетаРабот.Добавить();
					НовыйУчетРабот.УчетРаботыСотрудниковТехники = НовыйДокументУчетаРабот.Ссылка;
				КонецЕсли;
				
			КонецЕсли;
						
			НачалоНедели = НачалоНедели(мДатаНачала);
			ТЗ_РаспределенныеРаботыНеделя = ТЗ_РаспределенныеРаботы.СкопироватьКолонки();
			
		КонецЕсли;
		
		СтрокиПоДате = ТЗ_РаспределенныеРаботы.НайтиСтроки(Новый Структура("Дата", мДатаНачала));
		Для Каждого ТекСтрока Из СтрокиПоДате Цикл
			НоваяСтрокаНеделя = ТЗ_РаспределенныеРаботыНеделя.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаНеделя, ТекСтрока);
		КонецЦикла;
		
		мДатаНачала = мДатаНачала + 86400;
		
	КонецЦикла;
	
	Зарезервировано.Очистить();
	
КонецПроцедуры

// Функция Преобразует КодСДР в число 
//    Параметр - КодСДР
//    Возврат в формате: Первый уровень = целая часть, остальное дробная
//    Пример 1.1.2 ==> 1,12  
// 	
Функция КодСДРвЧисло(КодСДР) Экспорт
	пКодСДР = КодСДР;
	Если СтрЧислоВхождений(пКодСДР,".") >=1 Тогда
		Пока НЕ СтрЧислоВхождений(пКодСДР,".") = 1 Цикл
			НачальнаяПозиция = Найти(пКодСДР, ".");
			ВременнаяСтрока = Прав(пКодСДР, СтрДлина(пКодСДР) - НачальнаяПозиция);
			КоличествоСимволов = СтрДлина(ВременнаяСтрока);
			НоваяСтрока = СтрЗаменить(ВременнаяСтрока, ".", "");
			пКодСДР = Лев(пКодСДР, СтрДлина(пКодСДР) - КоличествоСимволов) +  НоваяСтрока;
		КонецЦикла;
		КодСДРЧисло = Число(?(СОКРЛП(пКодСДР)="", 0, СтрЗаменить(СтрЗаменить(пКодСДР, ".", ",")," ","")));	
	Иначе
		КодСДРЧисло = Число(?(СОКРЛП(пКодСДР)="", 0, пКодСДР))
	КонецЕсли;
	      
	Возврат КодСДРЧисло;

КонецФункции // КодСДРвЧисло()

&НаСервере
Процедура ДокументУтвержденияПриИзмененииНаСервере()
	
	СценарийПланирования = ДокументУтверждения.СценарийПланирования;
	НовыйВариант = ДокументУтверждения.СценарийПланирования.НовыйВариант = Истина; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументУтвержденияПриИзменении(Элемент)
	
	ДокументУтвержденияПриИзмененииНаСервере();
	ЗаполнитьДеревоРаботИРесурсов();
	РазвернутьНаКлиенте(ДеревоРабот);
	
	ЗаполнитьСотрудниковИзСоставов();
	
	Если ДеревоРабот.ПолучитьЭлементы().Количество() > 0 Тогда
		ПервыйЭлемент = ДеревоРабот.ПолучитьЭлементы()[0];
		Если ПервыйЭлемент.ПолучитьЭлементы().Количество() > 0 Тогда
			Элементы.ДеревоРабот.ТекущаяСтрока = ПервыйЭлемент.ПолучитьЭлементы()[0].ПолучитьИдентификатор();
		КонецЕсли;
		
	КонецЕсли;
	
	СформироватьОтчетНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДокументУтвержденияОчистка(Элемент, СтандартнаяОбработка)
	ДокументУтвержденияПриИзменении(Элемент);
КонецПроцедуры

#КонецОбласти
