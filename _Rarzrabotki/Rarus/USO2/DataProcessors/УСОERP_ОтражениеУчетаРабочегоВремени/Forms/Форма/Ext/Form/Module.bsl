

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	РазвернутьНаКлиенте(ДеревоРабот);

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	Если Настройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,Настройки);
	
	Если ЗначениеЗаполнено(Организация)
		И ЗначениеЗаполнено(ОбъектСтроительства)
		И ЗначениеЗаполнено(СценарийПланирования) Тогда
		
		ЗаполнитьДеревоРаботИРесурсов();
		ЗаполнитьСотрудниковИзСоставов();
				
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОбъектСтроительстваПриИзменении(Элемент)  	
	
	СценарийПланирования = УСОERP_УправлениеСтроительнымПроизводством.ПолучитьРабочийСценарий(ОбъектСтроительства, Организация);
	СценарийПланированияПриИзмененииНаСервере();
	ЗаполнитьДеревоРаботИРесурсов();
	РазвернутьНаКлиенте(ДеревоРабот);
	
	ЗаполнитьСотрудниковИзСоставов();
	
	Если ДеревоРабот.ПолучитьЭлементы().Количество() > 0 Тогда
		ПервыйЭлемент = ДеревоРабот.ПолучитьЭлементы()[0];
		Если ПервыйЭлемент.ПолучитьЭлементы().Количество() > 0 Тогда
			Элементы.ДеревоРабот.ТекущаяСтрока = ПервыйЭлемент.ПолучитьЭлементы()[0].ПолучитьИдентификатор();
		КонецЕсли;
		
	КонецЕсли;
	
	СформироватьОтчетНаСервере();

КонецПроцедуры

&НаСервере
Процедура СценарийПланированияПриИзмененииНаСервере()
	
	НовыйВариант = СценарийПланирования.НовыйВариант;
	
	Если НовыйВариант Тогда
		
		ДокументУтверждения = УСОERP_ЗащищенныеФункцииСервер.ПолучитьПоследнийДокументУтверждения(ОбъектСтроительства,Организация,СценарийПланирования,ТекущаяДата());
		
	КонецЕсли;

КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийДереваРабот

&НаКлиенте
Процедура ДеревоРаботСоставРесурсаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	ЗаполнитьСотрудниковИзСоставов(ТекущиеДанные.ПолучитьИдентификатор());

	мТекущийСоставРесурса = ТекущиеДанные.СоставРесурса;
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("Работа", ТекущиеДанные.Работа);
	СтруктураПараметров.Вставить("Ресурс", ТекущиеДанные.Ресурс);
	СтруктураПараметров.Вставить("СоставРесурса", ТекущиеДанные.СоставРесурса);
	СтруктураПараметров.Вставить("ДатаНачала", ТекущиеДанные.ДатаНачала);
	СтруктураПараметров.Вставить("ДатаОкончания", ТекущиеДанные.ДатаОкончания);
	СформироватьОтчетНаСервере(СтруктураПараметров);
	
	Элементы.Сотрудники.ОтборСтрок = Новый ФиксированнаяСтруктура("Работа, Ресурс, СоставРесурса", ТекущиеДанные.Работа, ТекущиеДанные.Ресурс, ТекущиеДанные.СоставРесурса);
    СтрокаОтбора = КодСДР(ТекущиеДанные.Работа) +  " " + СокрЛП(ТекущиеДанные.Работа) + ", ресурс - " + СокрЛП(ТекущиеДанные.Ресурс) + ", состав - " + СокрЛП(ТекущиеДанные.СоставРесурса);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботПриАктивизацииСтроки(Элемент)
	
	Если мЗапретитьВызовПриАктивизации Тогда 
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
		
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	мТекущаяРабота 			= ТекущиеДанные.Работа;
	мТекущийРесурс 			= ТекущиеДанные.Ресурс;
	мТекущийСоставРесурса	= ТекущиеДанные.СоставРесурса;
	мТекущийИд_Строки		= ТекущиеДанные.Ид_Строки;
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("Работа", ТекущиеДанные.Работа);
	СтруктураПараметров.Вставить("Ресурс", ТекущиеДанные.Ресурс);
	СтруктураПараметров.Вставить("СоставРесурса", ТекущиеДанные.СоставРесурса);
	СтруктураПараметров.Вставить("Ид_Строки", ТекущиеДанные.Ид_Строки);
	СтруктураПараметров.Вставить("ДатаНачала", ТекущиеДанные.ДатаНачала);
	СтруктураПараметров.Вставить("ДатаОкончания", ТекущиеДанные.ДатаОкончания);
	СформироватьОтчетНаСервере(СтруктураПараметров);
	
	Элементы.Сотрудники.ОтборСтрок = Новый ФиксированнаяСтруктура("Работа, Ресурс, СоставРесурса, Ид_Строки", ТекущиеДанные.Работа, ТекущиеДанные.Ресурс, ТекущиеДанные.СоставРесурса, ТекущиеДанные.Ид_Строки);
    СтрокаОтбора = "работе - " + СокрЛП(ТекущиеДанные.Работа) +  " (код СДР: " + КодСДР(ТекущиеДанные.Работа) + "), ресурс - " + СокрЛП(ТекущиеДанные.Ресурс) + ", состав - " + СокрЛП(ТекущиеДанные.СоставРесурса);
	
	Элементы.Зарезервировано.ОтборСтрок = Новый ФиксированнаяСтруктура("Работа, Ресурс, СоставРесурса, Ид_Строки", ТекущиеДанные.Работа, ТекущиеДанные.Ресурс, ТекущиеДанные.СоставРесурса, ТекущиеДанные.Ид_Строки);
    СтрокаОтбораЗарезервировано = "работе - " + СокрЛП(ТекущиеДанные.Работа) +  " (код СДР: " + КодСДР(ТекущиеДанные.Работа) + "), ресурс - " + СокрЛП(ТекущиеДанные.Ресурс) + ", состав - " + СокрЛП(ТекущиеДанные.СоставРесурса);
		
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРаботПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	Конецесли;
	
	Если ТекущиеДанные.ЭтоРабота Тогда
		РесурсыРаботы = ТекущиеДанные.ПолучитьЭлементы();
		Для Каждого СтрРесурс Из РесурсыРаботы Цикл
			СтрокиКУдалению = Сотрудники.НайтиСтроки(Новый Структура("Работа, Ресурс, Ид_Строки", СтрРесурс.Работа, СтрРесурс.Ресурс, СтрРесурс.Ид_Строки));
			Для Каждого СтрокаУдаление Из СтрокиКУдалению Цикл
				Сотрудники.Удалить(СтрокаУдаление);
			КонецЦикла;
			
			СтрокиКУдалению = Зарезервировано.НайтиСтроки(Новый Структура("Работа, Ресурс, Ид_Строки", СтрРесурс.Работа, СтрРесурс.Ресурс, СтрРесурс.Ид_Строки));
			Для Каждого СтрокаУдаление Из СтрокиКУдалению Цикл
				Зарезервировано.Удалить(СтрокаУдаление);
			КонецЦикла;
			
		КонецЦикла;
		
	Иначе
		СтрРесурс = ТекущиеДанные;
		
		СтрокиКУдалению = Сотрудники.НайтиСтроки(Новый Структура("Работа, Ресурс, Ид_Строки", СтрРесурс.Работа, СтрРесурс.Ресурс, СтрРесурс.Ид_Строки));
		Для Каждого СтрокаУдаление Из СтрокиКУдалению Цикл
			Сотрудники.Удалить(СтрокаУдаление);
		КонецЦикла;
		
		СтрокиКУдалению = Зарезервировано.НайтиСтроки(Новый Структура("Работа, Ресурс, Ид_Строки", СтрРесурс.Работа, СтрРесурс.Ресурс, СтрРесурс.Ид_Строки));
		Для Каждого СтрокаУдаление Из СтрокиКУдалению Цикл
			Зарезервировано.Удалить(СтрокаУдаление);
		КонецЦикла;
		
	Конецесли;

КонецПроцедуры
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьРаботыОбъекта(Команда)
	
	ЗаполнитьДеревоРаботИРесурсов();
	РазвернутьНаКлиенте(ДеревоРабот);
	
	ЗаполнитьСотрудниковИзСоставов();
	
	Если ДеревоРабот.ПолучитьЭлементы().Количество() > 0 Тогда
		ПервыйЭлемент = ДеревоРабот.ПолучитьЭлементы()[0];
		Если ПервыйЭлемент.ПолучитьЭлементы().Количество() > 0 Тогда
			Элементы.ДеревоРабот.ТекущаяСтрока = ПервыйЭлемент.ПолучитьЭлементы()[0].ПолучитьИдентификатор();
		КонецЕсли;
		
	КонецЕсли;
	
	СформироватьОтчетНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсе(Команда)
	
	РазвернутьНаКлиенте(ДеревоРабот);
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсе(Команда)
	
	СвернутьНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьУчетРабот(Команда)
	
	СформироватьДокументыУчетаРабот();
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
		
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	мТекущаяРабота 			= ТекущиеДанные.Работа;
	мТекущийРесурс 			= ТекущиеДанные.Ресурс;
	мТекущийСоставРесурса	= ТекущиеДанные.СоставРесурса;
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("Работа", 			ТекущиеДанные.Работа);
	СтруктураПараметров.Вставить("Ресурс", 			ТекущиеДанные.Ресурс);
	СтруктураПараметров.Вставить("СоставРесурса", 	ТекущиеДанные.СоставРесурса);
	СтруктураПараметров.Вставить("ДатаНачала", 		ТекущиеДанные.ДатаНачала);
	СтруктураПараметров.Вставить("ДатаОкончания", 	ТекущиеДанные.ДатаОкончания);
	СформироватьОтчетНаСервере(СтруктураПараметров);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадействоватьРесурс(Команда)
	
	КоординатыВыделеннойОбласти = ВернутьКоординатыВыделеннойОбласти();

	Если КоординатыВыделеннойОбласти <> Неопределено Тогда 
		
		ПараметрыФормы = Новый Структура("ПараметрыЗаполнения", Новый Структура("Объект",Объект));
		
		ОткрытьФорму("Обработка.УСОERP_ОтражениеУчетаРабочегоВремени.Форма.ФормаВводаЧислаЧасовРезервирования",ПараметрыФормы,ЭтаФорма,,,,Новый ОписаниеОповещения("ОткрытьУказаниеЧасовНаРезервированиеЗавершение", ЭтотОбъект, Новый Структура("КоличествоЧасовРезервирование, КоординатыВыделеннойОбласти", 0, КоординатыВыделеннойОбласти)),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОсвободитьРесурс(Команда)
	
	КоординатыВыделеннойОбласти = ВернутьКоординатыВыделеннойОбласти();
	
	Если КоординатыВыделеннойОбласти <> Неопределено Тогда 
		ОсвободитьРесурсНаСервере(КоординатыВыделеннойОбласти);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериод(Команда)
	
	ПараметрыОткрытия 	= Новый Структура("НачалоПериода, КонецПериода", ДатаНачала, ДатаОкончания);
	ОписаниеОповещения 	= Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериода", ПараметрыОткрытия, Элементы.ВыбратьПериод, , , , ОписаниеОповещения);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДатаНачала = РезультатВыбора.НачалоПериода;
	ДатаОкончания = КонецДня(РезультатВыбора.КонецПериода);
	
	
КонецПроцедуры

&НаСервере
Функция КодСДР(Работа)
	
	Возврат СокрЛП(Работа.КодСДР);
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	//
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоРабот.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоРабот.ЭтоРабота");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(WindowsШрифты.ШрифтДиалоговИМеню,,,Истина));
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаГруппировкиОтчета2);
	
	//
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоРаботСоставРесурса.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоРабот.ЭтоРабота");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "-");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);

	//
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоРаботДатаНачала.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоРаботДатаОкончания.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоРаботДлительность.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоРаботЕдиницаДлительности.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоРабот.ЭтоРабота");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;

	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "-");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	
	//

    Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоРаботРаботаКодСДР.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоРабот.ЭтоРабота");
