Функция ОпределитьСотрудникаПоСтроке(СтрокаВерх)
	
	Отбор = Новый Структура;
	Отбор.Вставить("НомерСтрокиРезерв", СтрокаВерх);
	Отбор.Вставить("Работа", 			мТекущаяРабота);
	Отбор.Вставить("Ресурс", 			мТекущийРесурс);
	Отбор.Вставить("СоставРесурса", 	мТекущийСоставРесурса);
	Отбор.Вставить("Ид_Строки", 		мТекущийИд_Строки);
	
	МассивСотрудников = Сотрудники.НайтиСтроки(Отбор);
	
