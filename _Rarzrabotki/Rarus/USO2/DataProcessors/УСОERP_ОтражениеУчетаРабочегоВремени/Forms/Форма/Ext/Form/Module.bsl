&НаСервере
Процедура СформироватьОтчетНаСервере(СтруктураПараметров = Неопределено)
	
	мЗапретитьВызовПриАктивизации = Истина;
	
	Если СтруктураПараметров = Неопределено Тогда
		Если ДеревоРабот.ПолучитьЭлементы().Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ТекущиеДанные = ДеревоРабот.ПолучитьЭлементы()[0];
		Если ТекущиеДанные.ПолучитьЭлементы().Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		ТекущиеДанные = ТекущиеДанные.ПолучитьЭлементы()[0];
	Иначе
		ТекущиеДанные = СтруктураПараметров;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаНачала) Тогда 
		мДатаНачала = ДатаНачала;
	Иначе 
		мДатаНачала = ТекущиеДанные.ДатаНачала;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаОкончания) Тогда 
		мДатаОкончания = ДатаОкончания;
	Иначе 
		мДатаОкончания = ТекущиеДанные.ДатаОкончания;
	КонецЕсли;

	МассивСотрудников = Новый Массив;
	МассивСтрок = Сотрудники.НайтиСтроки(Новый Структура("Работа, Ресурс, СоставРесурса", ТекущиеДанные.Работа, ТекущиеДанные.Ресурс, ТекущиеДанные.СоставРесурса));
	Для Каждого мСтрокаСотрудник Из МассивСтрок Цикл
		МассивСотрудников.Добавить(мСтрокаСотрудник.Сотрудник);
	КонецЦикла;
	
	// Получим данные графика работы из работы для заполнения плана и графика
	ТаблицаГрафик = ПолучитьДанныеГрафикаЗаПериод(МассивСотрудников, НачалоДня(мДатаНачала),НачалоДня(мДатаОкончания));
	
	РезультатЗапросаПоРаботе = ПолучитьДанныеПоРаботе(ТекущиеДанные,ТаблицаГрафик, мДатаНачала, мДатаОкончания );
	
	ТабличноеПоле.Очистить();
		
	ТабДок 	= ТабличноеПоле;
	мОбъект = РеквизитФормыВЗначение("Объект");
    Макет 	= мОбъект.ПолучитьМакет("Отчет"); 
	
	ОбластьШапкаЛевыйУгол 		= Макет.ПолучитьОбласть("ДеньШапка|ОсновныеДанныеШапка");
	ОбластьШапкаЛево 			= Макет.ПолучитьОбласть("ОсновныеДанные|ОсновныеДанныеШапка");
	ОбластьШапкаВерх 			= Макет.ПолучитьОбласть("ДеньШапка|ДеньКолонка");
	ОбластьДетальныхЗаписей 	= Макет.ПолучитьОбласть("ОсновныеДанные|ДеньКолонка");
	ОбластьШапкаИтог 			= Макет.ПолучитьОбласть("ДеньШапка|Итог");
	ОбластьДетальныхЗаписейИтог = Макет.ПолучитьОбласть("ОсновныеДанные|Итог");
	
	ОбщаяТаблицаПоРаботе = РезультатЗапросаПоРаботе.Выгрузить();	
	
	ТаблицаПоРаботе = ОбщаяТаблицаПоРаботе.Скопировать();  			// Для верхнего цикла с перебором сотрудников
	ТаблицаПоРаботе.Свернуть("Сотрудник", "КоличествоЧасовПоГрафику, КоличествоЧасовНазначеноВсего, КоличествоЧасовНазначено, КоличествоЧасовОтраженоВУчете, КоличествоЧасовКОтражению, КоличествоЧасовКОтражениюВсего");
	
	СвернутаяТаблицаРаботы = ОбщаяТаблицаПоРаботе.Скопировать(); 	// Для вывода данных за день
	СвернутаяТаблицаРаботы.Свернуть("Сотрудник, ПериодДень", "КоличествоЧасовПоГрафику, КоличествоЧасовНазначеноВсего, КоличествоЧасовНазначено, КоличествоЧасовОтраженоВУчете, КоличествоЧасовКОтражению, КоличествоЧасовКОтражениюВсего");
				
	СчетчикСтрокМесяца = 1;  
	ЗаполнитьмТЗКолонкиДат = Истина; 								// Признак одноразового заполнения ТЗ датами и номерами колонок
	мТЗКолонкиДат.Очистить(); 										// Очистим перед переопределением

	Для Каждого  ТекСтрокаРабота Из ТаблицаПоРаботе Цикл  
		
		ОтборСотрудник = Новый Структура;
		ОтборСотрудник.Вставить("Сотрудник",		ТекСтрокаРабота.Сотрудник);
		ОтборСотрудник.Вставить("Работа", 			мТекущаяРабота);
		ОтборСотрудник.Вставить("Ресурс", 			мТекущийРесурс);
		ОтборСотрудник.Вставить("СоставРесурса", 	мТекущийСоставРесурса);
		НайденныйСотрудник = Сотрудники.НайтиСтроки(ОтборСотрудник);
		
		ОтборСотрудник.Удалить("Работа");
		ОтборСотрудник.Удалить("Ресурс");
		ОтборСотрудник.Удалить("СоставРесурса");
		
		Если НайденныйСотрудник.Количество() < 1 Тогда 
			// не нашли в списке сотрудников "Отбора" ТЧ сотрудники (ограничивает список выводимых в ТабДок сотрудников)
			Продолжить;
		КонецЕсли;
		
		НайденныйСотрудник = НайденныйСотрудник[0];// Строка из ТЧ "Сотрудники" для фиксации координат (номеров строк начала и окончания)
				
		ИндексКолонки = 17;
		ТекущийДень = НачалоДня(мДатаНачала);
		ТекущийМесяц = 0;
		КолонкаНачалаМесяца = 17;
		
		ТабДок.Вывести(ОбластьШапкаЛевыйУгол);
		
		Пока ТекущийДень < КонецДня(мДатаОкончания) Цикл
			
			Если ЗаполнитьмТЗКолонкиДат Тогда 
				НоваяСтрока = мТЗКолонкиДат.Добавить();
				НоваяСтрока.Дата = ТекущийДень;
				НоваяСтрока.НомерКолонки = ИндексКолонки;
			КонецЕсли;
			
			Если ИндексКолонки = 17 Тогда 
				ТекущийМесяц = Месяц(ТекущийДень);	
			КонецЕсли;
			
			ОбластьШапкаВерх.Параметры.День = День(ТекущийДень);
			ТабДок.Присоединить(ОбластьШапкаВерх);
						
			Если ВыходнойДень(ТекСтрокаРабота.Сотрудник, ТекущийДень) Тогда
				ТабДок.Область(СчетчикСтрокМесяца + 1,ИндексКолонки,СчетчикСтрокМесяца + 1,ИндексКолонки).ЦветФона = ЦветаСтиля.ПолеСОшибкойФон;
			КонецЕсли;
						
			ТекущийДень 	= ТекущийДень + 60*60*24;
			ИндексКолонки 	= ИндексКолонки + 1;
			Если ТекущийМесяц <> Месяц(ТекущийДень) ИЛИ КонецДня(ТекущийДень) = КонецДня(мДатаОкончания) Тогда 
				Если КонецДня(ТекущийДень) = КонецДня(мДатаОкончания) Тогда 
					
					ТабДок.Область(СчетчикСтрокМесяца,КолонкаНачалаМесяца,СчетчикСтрокМесяца,ИндексКолонки).Объединить();
					ТабДок.Область(СчетчикСтрокМесяца,КолонкаНачалаМесяца,СчетчикСтрокМесяца,ИндексКолонки).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
					ТабДок.Область(СчетчикСтрокМесяца,КолонкаНачалаМесяца,СчетчикСтрокМесяца,ИндексКолонки).Текст = Формат((ТекущийДень-1), "ДФ=""ММММ гггг""");
					
				Иначе 
					
					ТабДок.Область(СчетчикСтрокМесяца,КолонкаНачалаМесяца,СчетчикСтрокМесяца,ИндексКолонки-1).Объединить();
					ТабДок.Область(СчетчикСтрокМесяца,КолонкаНачалаМесяца,СчетчикСтрокМесяца,ИндексКолонки-1).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
					ТабДок.Область(СчетчикСтрокМесяца,КолонкаНачалаМесяца,СчетчикСтрокМесяца,ИндексКолонки-1).Текст = Формат((ТекущийДень-1), "ДФ=""ММММ гггг""");
					КолонкаНачалаМесяца = ИндексКолонки;
					ТекущийМесяц = Месяц(ТекущийДень);
					
				КонецЕсли;
			КонецЕсли;

		КонецЦикла;
		ТабДок.Присоединить(ОбластьШапкаИтог);
		
		//// Область левой шапки Заполнение и вывод
		ОбластьШапкаЛево.Параметры.РаботаСотрудник = ТекСтрокаРабота.Сотрудник;
	    
		ТабДок.Вывести(ОбластьШапкаЛево);
		
		ИндексКолонки = 17;
		ТекущийДень = НачалоДня(мДатаНачала);
		ЗаполнитьмТЗКолонкиДат = Ложь; // Признак одноразового заполнения ТЗ датами и номерами колонок
		мТЗКолонкиДат.Сортировать("НомерКолонки");

		// ИТОГИ
		ИтогКоличествоЧасовПоГрафику			= 0;
		ИтогКоличествоЧасовНазначеноВсего		= 0;
		ИтогКоличествоЧасовНазначено			= 0;
		ИтогКоличествоЧасовОтраженоВУчете		= 0;
		ИтогКоличествоЧасовКОтражению			= 0;
		ИтогКоличествоЧасовКОтражениюВсего		= 0;
		
		Пока ТекущийДень < КонецДня(мДатаОкончания) Цикл	
						
			Если ИндексКолонки = 17 Тогда 
				ТекущийМесяц = Месяц(ТекущийДень);	
			КонецЕсли;
			
			// ВЫВОд данных//////////
			ОтборСотрудник.Вставить("ПериодДень",ТекущийДень);				
			НайденныеСтрокиПоДню = СвернутаяТаблицаРаботы.НайтиСтроки(ОтборСотрудник);
			
			// Показатели инициализация
			КоличествоЧасовПоГрафику			= 0;
			КоличествоЧасовНазначеноВсего		= 0;
			КоличествоЧасовНазначено			= 0;
			КоличествоЧасовОтраженоВУчете		= 0;
			КоличествоЧасовКОтражению			= 0;
			КоличествоЧасовКОтражениюВсего		= 0;
			Если НайденныеСтрокиПоДню.Количество()>0 Тогда 
				
				Для Каждого Стр Из НайденныеСтрокиПоДню Цикл 
					
					// Показатели
					КоличествоЧасовНазначеноВсего		= КоличествоЧасовНазначеноВсего		+ Стр.КоличествоЧасовНазначеноВсего;
					КоличествоЧасовНазначено 			= КоличествоЧасовНазначено 			+ Стр.КоличествоЧасовНазначено;
					КоличествоЧасовОтраженоВУчете 		= КоличествоЧасовОтраженоВУчете 	+ Стр.КоличествоЧасовОтраженоВУчете;
					КоличествоЧасовКОтражению 			= КоличествоЧасовКОтражению 		+ Стр.КоличествоЧасовКОтражению;
					КоличествоЧасовКОтражениюВсего 		= КоличествоЧасовКОтражениюВсего 	+ Стр.КоличествоЧасовКОтражениюВсего;
						
					// ИТОГИ
					ИтогКоличествоЧасовНазначеноВсего		= ИтогКоличествоЧасовНазначеноВсего		+ Стр.КоличествоЧасовНазначеноВсего;
					ИтогКоличествоЧасовНазначено 			= ИтогКоличествоЧасовНазначено 			+ Стр.КоличествоЧасовНазначено;
					ИтогКоличествоЧасовОтраженоВУчете		= ИтогКоличествоЧасовОтраженоВУчете		+ Стр.КоличествоЧасовОтраженоВУчете;
					ИтогКоличествоЧасовКОтражению 			= ИтогКоличествоЧасовКОтражению 		+ Стр.КоличествоЧасовКОтражению;
					ИтогКоличествоЧасовКОтражениюВсего 		= ИтогКоличествоЧасовКОтражениюВсего 	+ Стр.КоличествоЧасовКОтражениюВсего;
					
				КонецЦикла;
				
				ОтборВсего = Новый Структура;
				ОтборВсего.Вставить("Дата", 		ТекущийДень);
				ОтборВсего.Вставить("Сотрудник",	ТекСтрокаРабота.Сотрудник);
				ЧасовПоСотруднику 		= Зарезервировано.НайтиСтроки(ОтборВсего);
				ТЗ_ЧасовПоСотруднику 	= Зарезервировано.Выгрузить(ЧасовПоСотруднику, "КоличествоЧасов");
				КоличествоЧасовКОтражениюВсего = ТЗ_ЧасовПоСотруднику.Итог("КоличествоЧасов");
				
				// Показатели вывод	
				ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовНазначеноВсего	 		= ?(КоличествоЧасовНазначеноВсего	= 0, "0", КоличествоЧасовНазначеноВсего);
				ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовНазначено 		 		= ?(КоличествоЧасовНазначено		= 0, "0", КоличествоЧасовНазначено);
				ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовОтраженоВУчете 		= ?(КоличествоЧасовОтраженоВУчете	= 0, "0", КоличествоЧасовОтраженоВУчете);
				ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовКОтражению 			= ?(КоличествоЧасовКОтражению		= 0, "0", КоличествоЧасовКОтражению);
				ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовКОтражениюВсего 		= ?(КоличествоЧасовКОтражениюВсего	= 0, "0", КоличествоЧасовКОтражениюВсего);
				
			Иначе
				// Пустые показатели вывод
				ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовНазначеноВсего	 		= "0";
				ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовНазначено		 		= "0";
				ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовОтраженоВУчете		 	= "0";
				ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовКОтражению 			= "0";
				ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовКОтражениюВсего 		= "0";
				
				ОбластьДетальныхЗаписей.Область(1,1).Расшифровка = "0";
				ОбластьДетальныхЗаписей.Область(2,1).Расшифровка = "0";
				ОбластьДетальныхЗаписей.Область(3,1).Расшифровка = "0";
				ОбластьДетальныхЗаписей.Область(4,1).Расшифровка = "0";
				
			КонецЕсли;
			
			// ОтдельноВыведем План/График
			Если ТекСтрокаРабота.Сотрудник = 0 Тогда
				
				Если ТекущийДень >= НачалоДня(ТекущиеДанные.ДатаНачала) И ТекущийДень <= НачалоДня(ТекущиеДанные.ДатаОкончания) Тогда 
					
					//СтрокаГрафика = ТаблицаГрафик.Найти(ТекущийДень,"Дата");
					//Если СтрокаГрафика <> Неопределено Тогда 
					//
					//	КоличествоЧасовПоПлану 		= КоличествоЧасовПоПлану + СтрокаГрафика.ЧасовВсего;
					//	ИтогКоличествоЧасовПоПлану 	= ИтогКоличествоЧасовПоПлану + СтрокаГрафика.ЧасовВсего;
					//КонецЕсли;
					
				КонецЕсли;
				
				//ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовПоПлану	= ?(КоличествоЧасовПоПлану=0,"0",КоличествоЧасовПоПлану);
				ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовПоГрафику 	= "0";
				
			Иначе 
				
				СтрокаГрафика = ТаблицаГрафик.Найти(ТекущийДень,"Дата");
				Если СтрокаГрафика <> Неопределено Тогда 
					КоличествоЧасовПоГрафику 		= КоличествоЧасовПоГрафику + СтрокаГрафика.ЧасовВсего;
					ИтогКоличествоЧасовПоГрафику 	= ИтогКоличествоЧасовПоГрафику + СтрокаГрафика.ЧасовВсего;
				КонецЕсли;

				ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовПоГрафику 	= ?(КоличествоЧасовПоГрафику=0,"0",КоличествоЧасовПоГрафику);
				
			КонецЕсли;
		
			// Для поддержки навигации по работам с сохранением и адекватным выводом данных ТЧ Зарезервировано при смене работ
			ОтборРезерв = Новый Структура;
			ОтборРезерв.Вставить("Сотрудник",		ТекСтрокаРабота.Сотрудник);
			ОтборРезерв.Вставить("Работа",			ТекущиеДанные.Работа);
			ОтборРезерв.Вставить("Ресурс",			ТекущиеДанные.Ресурс);
			ОтборРезерв.Вставить("СоставРесурса",	ТекущиеДанные.СоставРесурса);
			ОтборРезерв.Вставить("Дата",			ТекущийДень);
			
			НайденныеСтрокиЗарезервировано = Зарезервировано.НайтиСтроки(ОтборРезерв);  
			Для Каждого ТекСтр Из НайденныеСтрокиЗарезервировано Цикл 
				
				КоличествоЧасовКОтражению 			= КоличествоЧасовКОтражению			+ ТекСтр.КоличествоЧасов;
				ИтогКоличествоЧасовКОтражению 		= ИтогКоличествоЧасовКОтражению		+ ТекСтр.КоличествоЧасов;
				ТекСтр.НомерКолонки = ИндексКолонки;
				ТекСтр.НомерСтрокиРезерв = СчетчикСтрокМесяца + 6;
				
				ОтборВсего = Новый Структура;
				ОтборВсего.Вставить("Дата", 		ТекСтр.Дата);
				ОтборВсего.Вставить("Сотрудник",	ТекСтр.Сотрудник);
				ЧасовПоСотруднику 		= Зарезервировано.НайтиСтроки(ОтборВсего);
				ТЗ_ЧасовПоСотруднику 	= Зарезервировано.Выгрузить(ЧасовПоСотруднику, "КоличествоЧасов");
				КоличествоЧасовВсего = ТЗ_ЧасовПоСотруднику.Итог("КоличествоЧасов");
				КоличествоЧасовВсего = ?(КоличествоЧасовВсего <> Неопределено, КоличествоЧасовВсего, 0);
				
				ИтогКоличествоЧасовКОтражениюВсего = ИтогКоличествоЧасовКОтражениюВсего + КоличествоЧасовВсего;
				
			КонецЦикла;
			
			ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовКОтражению 		= ?(КоличествоЧасовКОтражению		= 0, "0", КоличествоЧасовКОтражению);
			ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовКОтражениюВсего	= ?(КоличествоЧасовКОтражениюВсего	= 0, "0", КоличествоЧасовКОтражениюВсего);
		
			Если КоличествоЧасовКОтражению > 0 Тогда 
				Если КоличествоЧасовКОтражению > 8 ИЛИ ВыходнойДень(ТекСтрокаРабота.Сотрудник, ТекущийДень) Тогда 
					ОбластьДетальныхЗаписей.Область(5,1).ЦветФона = WebЦвета.ОранжевоКрасный;
				Иначе 
					ОбластьДетальныхЗаписей.Область(5,1).ЦветФона = WebЦвета.Голубой;
				КонецЕсли;
			Иначе
				ОбластьДетальныхЗаписей.Область(5,1).ЦветФона = WebЦвета.Белоснежный;
			КонецЕсли;
			
			Если КоличествоЧасовКОтражениюВсего > 0 Тогда 
				Если КоличествоЧасовКОтражениюВсего > 8 ИЛИ ВыходнойДень(ТекСтрокаРабота.Сотрудник, ТекущийДень) Тогда 
					ОбластьДетальныхЗаписей.Область(6,1).ЦветФона = WebЦвета.ОранжевоКрасный;
				Иначе 
					ОбластьДетальныхЗаписей.Область(6,1).ЦветФона = WebЦвета.Голубой;
				КонецЕсли;
			Иначе
				ОбластьДетальныхЗаписей.Область(6,1).ЦветФона = WebЦвета.Белоснежный;
			КонецЕсли;
			
			Если ВыходнойДень(ТекСтрокаРабота.Сотрудник, ТекущийДень)  Тогда  				
				ТабДок.Область(СчетчикСтрокМесяца + 4,ИндексКолонки,СчетчикСтрокМесяца + 4,ИндексКолонки).ЦветФона = ЦветаСтиля.ПолеСОшибкойФон;
				ТабДок.Область(СчетчикСтрокМесяца + 5,ИндексКолонки,СчетчикСтрокМесяца + 5,ИндексКолонки).ЦветФона = ЦветаСтиля.ПолеСОшибкойФон;
				Если КоличествоЧасовКОтражению <> 0 Тогда
					ТабДок.Область(СчетчикСтрокМесяца + 6, ИндексКолонки, СчетчикСтрокМесяца + 6, ИндексКолонки).ЦветФона = ЦветаСтиля.ПолеСОшибкойФон;
				КонецЕсли;
			КонецЕсли;
			
			ТабДок.Присоединить(ОбластьДетальныхЗаписей);
			
			ТекущийДень = ТекущийДень + 60*60*24;
			ИндексКолонки = ИндексКолонки +1;
			Если ТекущийМесяц <> Месяц(ТекущийДень) ИЛИ КонецДня(ТекущийДень) = КонецДня(мДатаОкончания) Тогда 
				Если КонецДня(ТекущийДень) = КонецДня(мДатаОкончания) Тогда 
					
					ТабДок.Область(СчетчикСтрокМесяца+1,ИндексКолонки,СчетчикСтрокМесяца+4,ИндексКолонки).ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,);
					
				Иначе 
					
					ТабДок.Область(СчетчикСтрокМесяца+1,ИндексКолонки-1,СчетчикСтрокМесяца+4,ИндексКолонки-1).ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,);
					КолонкаНачалаМесяца = ИндексКолонки;
					ТекущийМесяц = Месяц(ТекущийДень);
					
				КонецЕсли;
			КонецЕсли;
			
			ОтборСотрудник.Удалить("ПериодДень");
			
		КонецЦикла;
		
		//Вывод ИТОГОВ
		ОбластьДетальныхЗаписейИтог.Параметры.КоличествоЧасовПоГрафику      		= ?(ИтогКоличествоЧасовПоГрафику 			= 0, "0", ИтогКоличествоЧасовПоГрафику);
		ОбластьДетальныхЗаписейИтог.Параметры.КоличествоЧасовНазначеноВсего			= ?(ИтогКоличествоЧасовНазначеноВсего		= 0, "0", ИтогКоличествоЧасовНазначеноВсего);
		ОбластьДетальныхЗаписейИтог.Параметры.КоличествоЧасовНазначено 				= ?(ИтогКоличествоЧасовНазначено 			= 0, "0", ИтогКоличествоЧасовНазначено);
		ОбластьДетальныхЗаписейИтог.Параметры.КоличествоЧасовОтраженоВУчете 		= ?(ИтогКоличествоЧасовОтраженоВУчете		= 0, "0", ИтогКоличествоЧасовОтраженоВУчете);
		ОбластьДетальныхЗаписейИтог.Параметры.КоличествоЧасовКОтражению 			= ?(ИтогКоличествоЧасовКОтражению	 		= 0, "0", ИтогКоличествоЧасовКОтражению);
		ОбластьДетальныхЗаписейИтог.Параметры.КоличествоЧасовКОтражениюВсего 		= ?(ИтогКоличествоЧасовКОтражениюВсего		= 0, "0", ИтогКоличествоЧасовКОтражениюВсего);
		
		ТабДок.Присоединить(ОбластьДетальныхЗаписейИтог);
		СчетчикСтрокМесяца = СчетчикСтрокМесяца + 8;
		Если ТекСтрокаРабота.Сотрудник <> 0 Тогда  
			НайденныйСотрудник.НомерСтрокиРезерв = СчетчикСтрокМесяца - 2; //Пока решил ограничиться номером строки резерва и все
			//НайденныйСотрудник.НомерСтрокиОкончания = СчетчикСтрокМесяца -1;
		КонецЕсли;

	КонецЦикла;

	мЗапретитьВызовПриАктивизации = Ложь;
	
КонецПроцедуры

&НаСервере
Функция ОпределитьДатуПоКолонке(НомерКолонки)
	
	Отбор = Новый Структура;
	Отбор.Вставить("НомерКолонки",НомерКолонки);
	
	НайденнаяСтрокаДаты = мТЗКолонкиДат.НайтиСтроки(Отбор);
	Если НайденнаяСтрокаДаты.Количество() > 0 Тогда 
		Возврат НайденнаяСтрокаДаты[0].Дата;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции 

Функция ПолучитьДанныеГрафикаЗаПериод(СписокСотрудников,мДатаНачала,мДатаОкончания)
		
	ВыборкаДанныхОВремени = ДанныеОВремениСотрудников(СписокСотрудников, мДатаНачала,мДатаОкончания);
	
	ТаблицаДанныхПоГрафику = Новый ТаблицаЗначений;
	ТаблицаДанныхПоГрафику.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	ТаблицаДанныхПоГрафику.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТаблицаДанныхПоГрафику.Колонки.Добавить("ЧасовВсего", Новый ОписаниеТипов("Число"));
	
	ГрафикРаботыСотрудников.Очистить();
	
	Пока ВыборкаДанныхОВремени.СледующийПоЗначениюПоля("Сотрудник") Цикл
		Пока ВыборкаДанныхОВремени.СледующийПоЗначениюПоля("Дата") Цикл 								
			НоваяСтрока = ТаблицаДанныхПоГрафику.Добавить();
			НоваяСтрока.Сотрудник 	= ВыборкаДанныхОВремени.Сотрудник;
			НоваяСтрока.Дата 		= ВыборкаДанныхОВремени.Дата;
			//НоваяСтрока.ЧасовВсего 	= ВыборкаДанныхОВремени.НормаЧасов; 
			
			НоваяСтрокаГрафика = ГрафикРаботыСотрудников.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаГрафика, ВыборкаДанныхОВремени);
			//НоваяСтрокаГрафика.КоличествоЧасов = ВыборкаДанныхОВремени.НормаЧасов;
			Если ВыборкаДанныхОВремени.НайтиСледующий(Новый Структура("Дата, Сотрудник, ВидУчетаВремени", ВыборкаДанныхОВремени.Дата, ВыборкаДанныхОВремени.Сотрудник, ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.РабочееВремя"))) Тогда
				НоваяСтрока.ЧасовВсего 				= ВыборкаДанныхОВремени.НормаЧасов; 
				НоваяСтрокаГрафика.КоличествоЧасов 	= ВыборкаДанныхОВремени.НормаЧасов;
			КонецЕсли;
		КонецЦикла;	   							
	КонецЦикла;	
	
	Возврат ТаблицаДанныхПоГрафику;
	
КонецФункции

&НаСервере
Функция ДанныеОВремениСотрудников(СписокСотрудников = Неопределено, мДатаНачала,мДатаОкончания) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ПараметрыЗаполнения = УчетРабочегоВремениРасширенный.ПараметрыДляЗапросВТДанныеУчетаВремениИСостоянийСотрудников();
	
	ПараметрыЗаполнения.ИмяВТСотрудники = "ВТСотрудники";
	ПараметрыЗаполнения.ИмяВТРезультат = "ВТДанныеУчетаВремениИСостоянийСотрудников";
	ПараметрыЗаполнения.РассчитыватьПлановоеВремя 		= Ложь;
	ПараметрыЗаполнения.Организация  					= Организация;
	ПараметрыЗаполнения.ДатаАктуальности  				= НачалоМесяца(мДатаНачала);
	ПараметрыЗаполнения.ДатаНачала 						= мДатаНачала;
	ПараметрыЗаполнения.ДатаОкончания 					= мДатаОкончания;
	
	ПараметрыЗаполнения.МесяцДатаНачала 				= НачалоМесяца(мДатаНачала);
	ПараметрыЗаполнения.МесяцДатаОкончания 				= КонецМесяца(мДатаОкончания);
	ПараметрыЗаполнения.ПолучатьУжеРассчитанныеДанные 	= Ложь;
	ПараметрыЗаполнения.ПересчитыватьФактическоеВремя 	= Истина;
	

	Запрос.УстановитьПараметр("ДатаНачала", ПараметрыЗаполнения.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ПараметрыЗаполнения.ДатаОкончания);
	
	Если СписокСотрудников = Неопределено Тогда
		ПараметрыПолученияСотрудников 					= КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоВременнойТаблице();
		ПараметрыПолученияСотрудников.Организация  		= Организация;
		ПараметрыПолученияСотрудников.НачалоПериода 	= мДатаНачала;
		ПараметрыПолученияСотрудников.ОкончаниеПериода 	= мДатаОкончания;
		ПараметрыПолученияСотрудников.ИмяВТФизическиеЛица = Неопределено;
		// Подработки
		Если ПолучитьФункциональнуюОпцию("ИспользоватьПодработки") Тогда
			
			ПараметрыПолученияСотрудников.ПодработкиРаботниковПоТрудовымДоговорам = Истина;
			
		КонецЕсли;	
		// Подработки конец
		
		КадровыйУчет.СоздатьВТСотрудникиОрганизации(Запрос.МенеджерВременныхТаблиц, Истина, ПараметрыПолученияСотрудников, "ВТСотрудникиОрганизации");
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СотрудникиОрганизации.Сотрудник,
		|	&ДатаНачала,
		|	&ДатаОкончания
		|ПОМЕСТИТЬ ВТСотрудники
		|ИЗ
		|	ВТСотрудникиОрганизации КАК СотрудникиОрганизации";
		
		Запрос.Выполнить();
		
	Иначе
		ТаблицаСотрудников = Новый ТаблицаЗначений;
		ТаблицаСотрудников.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
		ТаблицаСотрудников.Колонки.Добавить("ДатаНачала", Новый ОписаниеТипов("Дата"));
		ТаблицаСотрудников.Колонки.Добавить("ДатаОкончания", Новый ОписаниеТипов("Дата"));
		
		Для каждого Сотрудник Из СписокСотрудников Цикл
			СтрокаТаблицы = ТаблицаСотрудников.Добавить();
			СтрокаТаблицы.Сотрудник = Сотрудник;
			СтрокаТаблицы.ДатаНачала = мДатаНачала;
			СтрокаТаблицы.ДатаОкончания = мДатаОкончания;
		КонецЦикла;
		
		Запрос.УстановитьПараметр("ТаблицаСотрудников", ТаблицаСотрудников);
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаСотрудников.Сотрудник,
		|	ТаблицаСотрудников.ДатаНачала,
		|	ТаблицаСотрудников.ДатаОкончания
		|ПОМЕСТИТЬ ВТСотрудники
		|ИЗ
		|	&ТаблицаСотрудников КАК ТаблицаСотрудников";
		
		Запрос.Выполнить();

	КонецЕсли;	
	
	УчетРабочегоВремениРасширенный.СоздатьВТДанныеУчетаВремениИСостоянийСотрудников(Запрос.МенеджерВременныхТаблиц, Истина, ПараметрыЗаполнения);	
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеУчетаВремениИСостоянийСотрудников.Сотрудник КАК Сотрудник,
	|	ДанныеУчетаВремениИСостоянийСотрудников.Дата КАК Дата,
	|	ДанныеУчетаВремениИСостоянийСотрудников.ВидУчетаВремени КАК ВидУчетаВремени,
	|	ДанныеУчетаВремениИСостоянийСотрудников.Дни КАК Дни,
	|	ДанныеУчетаВремениИСостоянийСотрудников.Часы КАК Часы,
	|	ДанныеУчетаВремениИСостоянийСотрудников.НормаЧасов,
	|	ВЫБОР
	|		КОГДА ОписаниеВидовВремени.Ссылка = &Явка
	|			ТОГДА 1
	|		КОГДА ОписаниеВидовВремени.ОсновноеВремя = &Явка
	|			ТОГДА 2
	|		КОГДА ОписаниеВидовВремени.Ссылка = &ВечерниеЧасы
	|			ТОГДА 3
	|		КОГДА ОписаниеВидовВремени.ОсновноеВремя = &ВечерниеЧасы
	|			ТОГДА 3
	|		КОГДА ОписаниеВидовВремени.Ссылка = &НочныеЧасы
	|			ТОГДА 5
	|		КОГДА ОписаниеВидовВремени.ОсновноеВремя = &НочныеЧасы
	|			ТОГДА 6
	|		КОГДА ОписаниеВидовВремени.Ссылка = &Сверхурочно
	|			ТОГДА 7
	|		КОГДА ОписаниеВидовВремени.ОсновноеВремя = &Сверхурочно
	|			ТОГДА 8
	|		ИНАЧЕ 9
	|	КОНЕЦ КАК ПриоритетВидаВремени
	|ИЗ
	|	ВТДанныеУчетаВремениИСостоянийСотрудников КАК ДанныеУчетаВремениИСостоянийСотрудников
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	|		ПО ДанныеУчетаВремениИСостоянийСотрудников.Сотрудник = Сотрудники.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыИспользованияРабочегоВремени КАК ОписаниеВидовВремени
	|		ПО ДанныеУчетаВремениИСостоянийСотрудников.ВидУчетаВремени = ОписаниеВидовВремени.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудники.Наименование,
	|	Сотрудник,
	|	Дата,
	|	ПриоритетВидаВремени,
	|	ОписаниеВидовВремени.Наименование,
	|	ВидУчетаВремени";
	
	Запрос.УстановитьПараметр("Явка", ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.Явка"));
	Запрос.УстановитьПараметр("ВечерниеЧасы", ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.РаботаВечерниеЧасы"));
	Запрос.УстановитьПараметр("НочныеЧасы", ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.РаботаНочныеЧасы"));
	Запрос.УстановитьПараметр("Сверхурочно", ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.Сверхурочные"));
	
	Возврат Запрос.Выполнить().Выбрать();
КонецФункции

&НаСервере
Функция ДоступныеДляВводаВидыВремени() Экспорт
	ДоступныеДляВводаВидыВремени = Новый Соответствие;
	
	ВидВремениРабочееВремя = ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.РабочееВремя");	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РабочееВремя", ВидВремениРабочееВремя);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВидыИспользованияРабочегоВремени.ОсновноеВремя
	|ИЗ
	|	Справочник.ВидыИспользованияРабочегоВремени КАК ВидыИспользованияРабочегоВремени
	|ГДЕ
	|	ВидыИспользованияРабочегоВремени.Ссылка <> &РабочееВремя";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДоступныеДляВводаВидыВремени.Вставить(Выборка.ОсновноеВремя, Истина);
	КонецЦикла;
	
	Возврат ДоступныеДляВводаВидыВремени;
КонецФункции	

&НаСервере
Функция  ПолучитьДанныеПоРаботе(ТекущиеДанные, ТаблицаСотрудников, мДатаНачала, мДатаОкончания)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеПоСотрудникам.Сотрудник,
