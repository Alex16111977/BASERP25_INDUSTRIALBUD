				//НоваяСтрока.ВремяОкончания = СтрутктураГрафик.ВремяНачала + КоличествоЧасовДляСписания*3600;
				НоваяСтрока.КоличествоЧасов = КоличествоЧасовДляСписания;
				НоваяСтрока.Ид_Строки = Ид_Строки;
			ИначеЕсли СтрутктураГрафик.КоличествоЧасов < КоличествоЧасовДляСписания Тогда
				// не поместились в первую, переходим на вторую списав всю первую
				НоваяСтрока = ТЗЗарезервировано.Добавить();
				НоваяСтрока.Сотрудник = РесурсСотрудник;
				НоваяСтрока.Должность = СтруктураПараметров.Должность;;
				НоваяСтрока.Работа = СтруктураПараметров.Работа;
				НоваяСтрока.Ресурс = СтруктураПараметров.Ресурс;
				НоваяСтрока.СоставРесурса = СтруктураПараметров.СоставРесурса;
				НоваяСтрока.Дата = ДатаКолонки;
				НоваяСтрока.НомерКолонки = НомерКолонки;
				НоваяСтрока.НомерСтрокиРезерв = КоординатыВыделеннойОбласти.СтрокаВерх;
