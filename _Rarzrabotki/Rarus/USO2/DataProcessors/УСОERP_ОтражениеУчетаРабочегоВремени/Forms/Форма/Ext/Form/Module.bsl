				//НоваяСтрока.ВремяОкончания = СтрутктураГрафик.ВремяОкончания;
				НоваяСтрока.КоличествоЧасов = СтрутктураГрафик.КоличествоЧасов; 
				НоваяСтрока.Ид_Строки = Ид_Строки;
				
				КоличествоЧасовДляСписания = КоличествоЧасовДляСписания - СтрутктураГрафик.КоличествоЧасов; 
				
				НоваяСтрока = ТЗЗарезервировано.Добавить();
				НоваяСтрока.Сотрудник = РесурсСотрудник;
				НоваяСтрока.Должность = СтруктураПараметров.Должность;;
				НоваяСтрока.Работа = СтруктураПараметров.Работа;
				НоваяСтрока.Ресурс = СтруктураПараметров.Ресурс;
				НоваяСтрока.СоставРесурса = СтруктураПараметров.СоставРесурса;
				НоваяСтрока.Дата = ДатаКолонки;
				НоваяСтрока.НомерКолонки = НомерКолонки;
				НоваяСтрока.НомерСтрокиРезерв = КоординатыВыделеннойОбласти.СтрокаВерх;
				//НоваяСтрока.ВремяНачала = СтрутктураГрафик.ВремяНачала;
				//НоваяСтрока.ВремяОкончания =  ?(КоличествоЧасовДляСписания>СтрутктураГрафик.ЧасовВпериоде,СтрутктураГрафик.ВремяОкончания,СтрутктураГрафик.ВремяНачала + КоличествоЧасовДляСписания*3600);
				НоваяСтрока.КоличествоЧасов = КоличествоЧасовДляСписания;
				НоваяСтрока.Ид_Строки = Ид_Строки;
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	ИтогПоЧасам = ТЗЗарезервировано.Скопировать(Новый Структура("Сотрудник,Работа",РесурсСотрудник,СтруктураПараметров.Работа)).Итог("КоличествоЧасов");
	
	Разница =   Объект.ОбщееЧислоЧасовРезервирования - ИтогПоЧасам;
	
	Если Разница <> 0 Тогда
		
		Строка = ТЗЗарезервировано.НайтиСтроки(Новый Структура("Сотрудник,Работа",РесурсСотрудник,СтруктураПараметров.Работа)).Получить(0);
		Строка.КоличествоЧасов = Строка.КоличествоЧасов+Разница;
		
	КонецЕсли;

	
	// Найдем строку работ для обновления итогов по Резерву
	ОтборРабота = Новый Структура;
	ОтборРабота.Вставить("Работа", СтруктураПараметров.Работа);
	
	МассивСтрок = Работы.НайтиСтроки(ОтборРабота);
	Если МассивСтрок.Количество()>0 Тогда 
		НайденнаяСтрокаРабот = МассивСтрок[0];
	Иначе
		Сообщить("Не найдена работа!!! при обновлении итогов...",СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из ТЗЗарезервировано Цикл 
		
		Отбор = Новый Структура;
		Отбор.Вставить("НомерСтрокиРезерв",	ТекСтрока.НомерСтрокиРезерв);
		Отбор.Вставить("НомерКолонки",		ТекСтрока.НомерКолонки);
		Отбор.Вставить("Сотрудник",			ТекСтрока.Сотрудник);
		Отбор.Вставить("Работа",			ТекСтрока.Работа);
		Отбор.Вставить("Ресурс",			ТекСтрока.Ресурс);
		Отбор.Вставить("СоставРесурса",		ТекСтрока.СоставРесурса);
		Отбор.Вставить("Дата",				ТекСтрока.Дата);
		Отбор.Вставить("ВремяНачала",		ТекСтрока.ВремяНачала);
		Отбор.Вставить("Ид_Строки", Ид_Строки);
		
		НайденныеСтрокиРезерв = Зарезервировано.НайтиСтроки(Отбор);
		Если НайденныеСтрокиРезерв.Количество() > 0 Тогда
			// если есть такая строка добавлять не будем
			// а для изменения колличества, пока очищаем и заново ставим
			Продолжить;
		КонецЕсли;
				
		НоваяСтрока = Зарезервировано.Добавить();
		НайденнаяСтрокаРабот.КоличествоЧасовКОтражению 		= НайденнаяСтрокаРабот.КоличествоЧасовКОтражению + ТекСтрока.КоличествоЧасов; 
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрока);
		
		ОтборВсего = Новый Структура;
		ОтборВсего.Вставить("Дата", 		ТекСтрока.Дата);
		ОтборВсего.Вставить("Сотрудник",	ТекСтрока.Сотрудник);
		ЧасовПоСотруднику 		= Зарезервировано.НайтиСтроки(ОтборВсего);
		ТЗ_ЧасовПоСотруднику 	= Зарезервировано.Выгрузить(ЧасовПоСотруднику, "КоличествоЧасов");
		ЧасовВсего = ТЗ_ЧасовПоСотруднику.Итог("КоличествоЧасов");
		НайденнаяСтрокаРабот.КоличествоЧасовКОтражениюВсего 	= НайденнаяСтрокаРабот.КоличествоЧасовКОтражениюВсего + ?(ЧасовВсего <> Неопределено, ЧасовВсего, 0); 
		
		ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв, ТекСтрока.НомерКолонки).Текст = Число(ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв, ТекСтрока.НомерКолонки).Текст) 
																						 + ТекСтрока.КоличествоЧасов;
		ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв + 1, ТекСтрока.НомерКолонки).Текст = Число(ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв + 1, ТекСтрока.НомерКолонки).Текст) 
																						 + ТекСтрока.КоличествоЧасов;
		Если  Число(ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв , ТекСтрока.НомерКолонки).Текст) > 8 ИЛИ ВыходнойДень(ТекСтрока.Сотрудник, ТекСтрока.Дата) Тогда 
			ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв, ТекСтрока.НомерКолонки).ЦветФона = WebЦвета.ОранжевоКрасный;
		Иначе 
			
			ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв, ТекСтрока.НомерКолонки).ЦветФона = WebЦвета.Голубой;
		КонецЕсли;
		Если  Число(ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв + 1, ТекСтрока.НомерКолонки).Текст) > 8 ИЛИ ВыходнойДень(ТекСтрока.Сотрудник, ТекСтрока.Дата) Тогда 
			ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв + 1, ТекСтрока.НомерКолонки).ЦветФона = WebЦвета.ОранжевоКрасный;
		Иначе 
			
			ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв + 1, ТекСтрока.НомерКолонки).ЦветФона = WebЦвета.Голубой;
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ОсвободитьРесурсНаСервере(КоординатыВыделеннойОбласти)
	
	СтруктураПараметров = ОпределитьСотрудникаПоСтроке(КоординатыВыделеннойОбласти.СтрокаВерх);
	
	Если НЕ ЗначениеЗаполнено(СтруктураПараметров) Тогда
		Возврат;
	КонецЕсли;
	
	РесурсСотрудник = СтруктураПараметров.Сотрудник;
	
	Если РесурсСотрудник = Неопределено Тогда 
		Сообщить("Неверно выделена область! выделите область напротив сотрудника...",СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Сотрудник",РесурсСотрудник);
	Отбор.Вставить("Работа",СтруктураПараметров.Работа);
	
	// Найдем строку работ для обновления итогов по Резерву
	ОтборРабота = Новый Структура;
	ОтборРабота.Вставить("Работа",СтруктураПараметров.Работа);
	МассивСтрок = Работы.НайтиСтроки(ОтборРабота);
	Если МассивСтрок.Количество()>0 Тогда 
		НайденнаяСтрокаРабот = МассивСтрок[0];
	Иначе
		Сообщить("Не найдена работа!!! при обновлении итогов...",СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;

	
	Для НомерКолонки = КоординатыВыделеннойОбласти.КолонкаЛево по КоординатыВыделеннойОбласти.КолонкаПраво Цикл 
		
		Отбор.Вставить("НомерКолонки",		НомерКолонки);
		Отбор.Вставить("НомерСтрокиРезерв",	КоординатыВыделеннойОбласти.СтрокаВерх);
		
		НайденныеСтрокиРезерв = Зарезервировано.НайтиСтроки(Отбор);
		
		ТЗ_Дата = Зарезервировано.Выгрузить(НайденныеСтрокиРезерв, "Дата");
		ТЗ_Дата.Свернуть("Дата");
		Если ТЗ_Дата.Количество() > 0 Тогда
			ДатаКолонки = ТЗ_Дата[0].Дата;
		Иначе 
			ДатаКолонки = Дата(1, 1, 1);
		КонецЕсли;
		
		Для Каждого ТекСтрока Из НайденныеСтрокиРезерв Цикл 
						
			НайденнаяСтрокаРабот.КоличествоЧасовКОтражению 		= НайденнаяСтрокаРабот.КоличествоЧасовКОтражению - ТекСтрока.КоличествоЧасов;
			Зарезервировано.Удалить(ТекСтрока);
						
		КонецЦикла;
		
		ОтборВсего = Новый Структура;
		ОтборВсего.Вставить("НомерКолонки", НомерКолонки);
		ОтборВсего.Вставить("Сотрудник",	РесурсСотрудник);
		ЧасовПоСотруднику 		= Зарезервировано.НайтиСтроки(ОтборВсего);
		ТЗ_ЧасовПоСотруднику 	= Зарезервировано.Выгрузить(ЧасовПоСотруднику, "КоличествоЧасов");
		КоличествоЧасовКОтражениюВсего = ТЗ_ЧасовПоСотруднику.Итог("КоличествоЧасов");
		НайденнаяСтрокаРабот.КоличествоЧасовКОтражениюВсего = ?(КоличествоЧасовКОтражениюВсего <> Неопределено, КоличествоЧасовКОтражениюВсего, 0); 
		
		ТабличноеПоле.Область(КоординатыВыделеннойОбласти.СтрокаВерх, НомерКолонки).Текст = "0";
		ТабличноеПоле.Область(КоординатыВыделеннойОбласти.СтрокаВерх, НомерКолонки).ЦветФона = WebЦвета.Белоснежный;
		ТабличноеПоле.Область(КоординатыВыделеннойОбласти.СтрокаВерх + 1, НомерКолонки).Текст = Строка(НайденнаяСтрокаРабот.КоличествоЧасовКОтражениюВсего);
		Если Число(ТабличноеПоле.Область(КоординатыВыделеннойОбласти.СтрокаВерх + 1, НомерКолонки).Текст) = 0 Тогда 
			ТабличноеПоле.Область(КоординатыВыделеннойОбласти.СтрокаВерх + 1, НомерКолонки).ЦветФона = WebЦвета.Белоснежный;
		ИначеЕсли  Число(ТабличноеПоле.Область(КоординатыВыделеннойОбласти.СтрокаВерх + 1, НомерКолонки).Текст) > 8 ИЛИ ВыходнойДень(РесурсСотрудник, ДатаКолонки) Тогда 
			ТабличноеПоле.Область(КоординатыВыделеннойОбласти.СтрокаВерх + 1, НомерКолонки).ЦветФона = WebЦвета.ОранжевоКрасный;
		Иначе 
			ТабличноеПоле.Область(КоординатыВыделеннойОбласти.СтрокаВерх + 1, НомерКолонки).ЦветФона = WebЦвета.Голубой;
		КонецЕсли;
			
		Отбор.Удалить("НомерКолонки");
		Отбор.Удалить("НомерСтрокиРезерв");

	КонецЦикла;
	
КонецПроцедуры

