#Область ОбработчикиСобытий

&НаКлиенте
Процедура ВидОтбораПриИзменении(Элемент)
	
	ОбновитьВидимостьПолей();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьПолей()
	
	Элементы.ВидРасценки.Видимость 				= Ложь;
	Элементы.НомерСборника.Видимость          	= Ложь;
	Элементы.Определитель.Видимость           	= Ложь;
	Элементы.ТипНормативногоСборника.Видимость	= Ложь;
	Элементы.КромеНомераСборника.Видимость	= Ложь;
	Элементы.ОбработкаДемонтажа.Видимость	= Ложь;

	Если ЭтаФорма.ВидОтбора = 1 Тогда
		Элементы.Определитель.Видимость = Истина;	
		Элементы.КромеНомераСборника.Видимость	= Истина;
		Элементы.ОбработкаДемонтажа.Видимость	= Истина;
	ИначеЕсли ЭтаФорма.ВидОтбора = 2 Тогда
		Элементы.ВидРасценки.Видимость = Истина;
	ИначеЕсли ЭтаФорма.ВидОтбора = 3 Тогда
		Элементы.ТипНормативногоСборника.Видимость = Истина;
	ИначеЕсли ЭтаФорма.ВидОтбора = 4 Тогда
		Элементы.НомерСборника.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.ВидОтбора			= 1;
	ЭтаФорма.ОбработкаДемонтажа = "НеИспользовать";
	
	Если НЕ ЗначениеЗаполнено(ВидСравненияОпределитель) Тогда
		ВидСравненияОпределитель			= "Равно";	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВидСравненияВидРасценки) Тогда
		ВидСравненияВидРасценки				= "Равно";	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВидСравненияТипНормативныхСборников) Тогда
		ВидСравненияТипНормативныхСборников	= "Равно";	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВидСравненияНомерСборника) Тогда
		ВидСравненияНомерСборника			= "Равно";	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполненияСтруктуры(СтруктураПараметров)
		
	Если ИспользованиеОпределитель Тогда
		СтруктураПараметров.Вставить("Определитель"				, Новый Структура("ВидСравнения, Значение", ВидСравненияОпределитель, Определитель));
	КонецЕсли;
	
	Если ИспользованиеВидРасценки Тогда
		СтруктураПараметров.Вставить("ВидРасценки"				, Новый Структура("ВидСравнения, Значение", ВидСравненияВидРасценки, ВидРасценки));
	КонецЕсли;
	
	Если ИспользованиеТипНормативныхСборников Тогда
		СтруктураПараметров.Вставить("ТипНормативныхСборников"	, Новый Структура("ВидСравнения, Значение", ВидСравненияТипНормативныхСборников, ТипНормативныхСборников));
	КонецЕсли;
	
	Если ИспользованиеНомерСборника Тогда
		СтруктураПараметров.Вставить("НомерСборника"			, Новый Структура("ВидСравнения, Значение", ВидСравненияНомерСборника, НомерСборника));
	КонецЕсли;
	
	Если НЕ ОбработкаДемонтажа = "НеИспользовать" Тогда
		СтруктураПараметров.Вставить("ОбработкаДемонтажа"		, Новый Структура("ВидСравнения, Значение", ОбработкаДемонтажа, Истина));
	КонецЕсли;
	
	Если ТолькоЗакрытыеСметы Тогда
		СтруктураПараметров.Вставить("СтатусРедактирования"		, Новый Структура("ВидСравнения, Значение", "Равно", 2));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОк()
	
	СтруктураПараметров = Новый Структура();
	ЗаполненияСтруктуры(СтруктураПараметров);
	Оповестить("ОбновлениеНастроекОтбора",СтруктураПараметров,Ложь);
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтказОтВыбора(Команда)
		ЭтаФорма.Закрыть();
КонецПроцедуры
	
&НаКлиенте
Процедура ПродолжитьССохранением(Команда)
	
	СтруктураПараметров = Новый Структура();
	ЗаполненияСтруктуры(СтруктураПараметров);	
	Оповестить("ОбновлениеНастроекОтбора",СтруктураПараметров,Истина);
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

