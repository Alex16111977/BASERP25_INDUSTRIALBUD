#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура Задать(Команда)
	
	Ответ = Новый  Структура;
	ответ.Вставить("Вид",Вид);
	ответ.Вставить("НР",НормативНР);
	ответ.Вставить("СП",НормативСП);
	
	Закрыть(Ответ);
	
	// Вставить содержимое обработчика.
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	Вид = параметры.Вид;
	Если Вид = "Текущие" Тогда
		ЭтаФорма.Заголовок = НСтр("ru='Задайте текущие нормативы НР и СП'");
	Иначе
		ЭтаФорма.Заголовок = НСтр("ru='Задайте базисные нормативы НР и СП'");
	КонецЕсли;		
	
КонецПроцедуры

#КонецОбласти