#Область Заменить

//	Оповещение, после выбора нового ресурса.
//
//	Параметры:
//	Результат			- СправочникСсылка.СМ_Ресурсы - выбранный ресурс, на замену.
//	ПараметрыОповещения	- Структура	- 	
//
&НаКлиенте
Процедура КомандаРесурсыЗаменитьОповещениеНаКлиенте(Результат, ПараметрыОповещения) Экспорт
		
	РесурсВыб	= СМ_СметаКлиент.ПолучитьОдинРесурсИзМассива(Результат);
	
	Если Не ЗначениеЗаполнено(РесурсВыб) Тогда
		Возврат;
	КонецЕсли; 
	
	Если ПараметрыОповещения.МестоЗамены = "Ресурсы" Тогда
		
		ПараметрыОткрытия	= РесурсыЗаменитьПолучитьПараметрыВводаРасходаНаКлиенте(РесурсВыб, ПараметрыОповещения);
		ОписаниеОповещения 	= Новый ОписаниеОповещения("КомандаРесурсыЗаменитьВводЗначенияОповещениеНаКлиенте", ЭтотОбъект, ПараметрыОповещения);
		
		ОткрытьФорму(	"ОбщаяФорма.СМ_ВводРасходаРесурса",
						ПараметрыОткрытия,
						,
						,
						,
						,
						ОписаниеОповещения,
						РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
	ИначеЕсли ПараметрыОповещения.МестоЗамены = "НС" Тогда
		
		ОбрабатываемаяЛокальнаяСмета	= ПолучитьОбрабатываемуюЛокальнуюСметуНаКлиенте();
		
		ПараметрыОповещения.Вставить("Ресурс"			, РесурсВыб);
		ПараметрыОповещения.Вставить("ПозицияРесурса"	, ОбрабатываемаяЛокальнаяСмета);
		
		ПараметрыОткрытия		= РесурсыЗаменитьПолучитьПараметрыВводаРасходаНаКлиенте(РесурсВыб, ПараметрыОповещения);
		
		Определитель			= СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(РесурсВыб, "Определитель");
		ВидРасценки				= СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(Определитель, "ВидРасценки");
		
		ПараметрыОповещения2	= ОбъединитьПараметрыНаКлиенте(ПараметрыОткрытия, ПараметрыОповещения);
		
		Если ВидРасценки = ПредопределенноеЗначение("Перечисление.СМ_ВидыРасценки.Транспортировка")
			ИЛИ ВидРасценки = ПредопределенноеЗначение("Перечисление.СМ_ВидыРасценки.Работа") Тогда
			
			Оповещение = Новый ОписаниеОповещения("КомандаРесурсыЗаменитьПродолжитьОповещениеНаКлиенте", ЭтотОбъект, ПараметрыОповещения2);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Выбран не материал. Продолжить?';"
											+ " en = 'Do you want to continue?'"), РежимДиалогаВопрос.ДаНет, 0);
		Иначе
			КомандаРесурсыЗаменитьПродолжитьОповещениеНаКлиенте(КодВозвратаДиалога.Да, ПараметрыОповещения2);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры //Процедура КомандаРесурсыЗаменитьОповещениеНаКлиенте(Результат, ПараметрыОповещения) Экспорт

