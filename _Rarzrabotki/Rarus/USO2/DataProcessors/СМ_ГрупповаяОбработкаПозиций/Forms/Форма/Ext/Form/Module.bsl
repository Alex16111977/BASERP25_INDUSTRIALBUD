&НаСервере
Функция ПолучитьЛокальныеСметыНаСервере(ВыбранноеЗначение)
	
	//
	Массив	= Новый Массив();
	
	//
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") тогда
		Массив.Добавить(ВыбранноеЗначение.ЛокальнаяСмета);	
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.СМ_СводнаяСмета") тогда
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета КАК ЛокальнаяСмета
		|ПОМЕСТИТЬ ВТсмет
		|ИЗ
		|	Документ.СМ_ОбъектнаяСмета.ЛокальныеСметы КАК СМ_ОбъектнаяСметаЛокальныеСметы
		|ГДЕ
		|	СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СМ_ЛокальнаяСмета.Ссылка КАК ЛокальнаяСмета
		|ИЗ
		|	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
		|ГДЕ
		|	СМ_ЛокальнаяСмета.Ссылка В
		|			(ВЫБРАТЬ
		|				ВТсмет.ЛокальнаяСмета
		|			ИЗ
		|				ВТсмет КАК ВТсмет)";
		Запрос.УстановитьПараметр("Ссылка",ВыбранноеЗначение);
		ТабЛС 		= Запрос.Выполнить().Выгрузить();
		Массив	= ТабЛС.ВыгрузитьКолонку("ЛокальнаяСмета");	
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") тогда
		Массив.Добавить(ВыбранноеЗначение);	
	КонецЕсли;
	
	//
	Возврат Массив;
		
КонецФункции //Функция ПолучитьЛокальныеСметыНаСервере(ВыбранноеЗначение)

