Процедура РАСЦЕНКИ_ОС_УстановитьОбъем(Команда, ВыполнитьКоманду = Ложь)
	
	//	устанавливаем и проверяем возможность установки, "действие" - реквизит на форме
	Если НЕ ВыполнитьКоманду Тогда
		ДоступнаСменаКомандыВопросНаКлиенте(Команда);
		Возврат;
	КонецЕсли;
	
	//	проверка
	Если НЕ СМ_ДоступнаОбработкаОбъектнаяСметаНаКлиенте(Команда) тогда
		Возврат;
	КонецЕсли;
	
	//
	ОписаниеОповещения		= Новый ОписаниеОповещения("КомандаУстановитьОбъемОповещениеНаКлиенте", ЭтотОбъект, Новый Структура("ТипОбъекта, КомандаИмя", "ОбъектнаяСмета", Команда.Имя));
	ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	
	//	Отобразим текущий объем, если обрабатывается одна позиция.
	Если ОбрабатываемыеПозиции.Количество() = 1 Тогда
		СтрокаДерева	= ЭлементыДеревоЗначений.НайтиПоИдентификатору(ОбрабатываемыеПозиции[0].Идентификатор);	
		Объем			= СтрокаДерева.Объем;	
	Иначе
		Объем			= 0;	
	КонецЕсли;
	
	ПоказатьВводЧисла(ОписаниеОповещения, Объем, НСтр("ru='Введите объем'"), 12, 5);
	
