#Область ЭлементыДеревоЗначений

&НаКлиенте
Процедура ПеребратьДеревоЗначений(СтрокиДерева, ИсполняемаяПроцедура, ПараметрПроцедуры = Неопределено)
	
	//
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		//	Выполнить процедуру обработки строки, дерева значений.
		Выполнить(ИсполняемаяПроцедура + "(СтрокаДерева, ПараметрПроцедуры)");
		
		//	рекурсия
		ПеребратьДеревоЗначений(СтрокаДерева.ПолучитьЭлементы(), ИсполняемаяПроцедура, ПараметрПроцедуры);
		
	КонецЦикла;
	
КонецПроцедуры //Процедура ПеребратьДеревоЗначений(СтрокиДерева, ИсполняемаяПроцедура, ПараметрПроцедуры = Неопределено)

//	ФОРМИРОВАНИЕ ДЕРЕВА

//	Обновляем дерево, используем типовую процедуру модуля СМ_СметныйСостав.
//
&НаКлиенте
Процедура ДеревоЗначенийОбновитьНаКлиенте(ПараметрыОбновления = Неопределено)
	
	ТекущиеДанные			= Элементы.ЭлементыДеревоЗначений.ТекущиеДанные;
	ТекущееСостояниеДерева	= Неопределено;
	КомандаИмя				= ПолучитьКомандаИмяНаКлиенте(Действие);
	ПараметрыКоманды		= ПолучитьПараметрыКомандыНаКлиенте(Команды[КомандаИмя]);
	ПараметрыОбработки		= СформироватьПараметрыОбработкиНаКлиенте();
	
	//	Запомнить текущую активную строку.
	СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(ТекущееСостояниеДерева, ТекущиеДанные, Элементы.ЭлементыДеревоЗначений, ЭлементыДеревоЗначений.ПолучитьЭлементы());
		
	//	Заполнить дерево значений.
	ДеревоЗначенийОбновитьНаСервере(ПараметрыОбновления);
	
	//	Развернуть дерево (всегда первый уровень - минимум).
	Если ТекущееСостояниеДерева.ТекущийЭлемент = Неопределено тогда
		ТекущееСостояниеДерева.ТекущийЭлемент = ПараметрыОбновления["Документ"];
	КонецЕсли;
	
	//	Активировать последнию строку.
	СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.ЭлементыДеревоЗначений, ЭлементыДеревоЗначений.ПолучитьЭлементы(), ЭлементыДеревоЗначений, ТекущееСостояниеДерева);
	
	//	Оставить отметки строк, дерева значений.
	ПеребратьДеревоЗначений(ЭлементыДеревоЗначений.ПолучитьЭлементы(), "УстановитьПометкаНаКлиенте", ТекущееСостояниеДерева);
	
	//	Сформировать обрабатываемые элементы.
	ОбрабатываемыеЭлементыСформироватьНаСервере(, ПараметрыОбработки);
	
	//	Выбираем отмеченные элементы и создаем структуру параметров, для операции.
	ОтобратьОтмеченныеЭлементыНаКлиенте(ПараметрыОбработки);
	
	//	Видимость элементов.
	Элементы.ЭлементыДеревоЗначенийОбъемПоАкту.Видимость	= ТипЗнч(ПараметрыОбновления["Документ"]) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот");
	
КонецПроцедуры //Процедура ДеревоЗначенийОбновитьНаСервере(ПараметрыОбновления = Неопределено)	

//	Обновляем дерево, используем типовую процедуру модуля СМ_СметныйСостав.
//
&НаСервере
Процедура ДеревоЗначенийОбновитьНаСервере(ПараметрыОбновления = Неопределено)
	
	//	сформируем структуру параметров, если они не заданы
	ДеревоЗначенийПараметрыОбновленияСформировать(ПараметрыОбновления);

	
	//	получить дерево значений, для обработки
	ДеревоЗначений = РеквизитФормыВЗначение("ЭлементыДеревоЗначений", Тип("ДеревоЗначений"));
	
	//	делаем запрос и строим дерево значений
	ДеревоЗначенийПостроитьНаСервере(ДеревоЗначений, ПараметрыОбновления);
	
	//	установить дерево значений
	ЗначениеВРеквизитФормы(ДеревоЗначений, "ЭлементыДеревоЗначений");
		
КонецПроцедуры //Процедура ДеревоЗначенийОбновитьНаСервере(ПараметрыОбновления = Неопределено)	

&НаСервереБезКонтекста
Процедура ДеревоЗначенийПеренумероватьНаСервереБезКонтекста(СтрокиДерева, Номер = 1, ПорядковыйНомерРаздела = 1, ПорядковыйНомерПозиции = 1)
	
	//
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		//
		Если ТипЗнч(СтрокаДерева.Элемент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
			ИЛИ ТипЗнч(СтрокаДерева.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			
			//
			Если СтрокаДерева.Элемент.Расчет Тогда 
				ПорядковыйНомер = ?(ТипЗнч(СтрокаДерева.Элемент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы"), ПорядковыйНомерРаздела, ПорядковыйНомерПозиции);
			Иначе
				ПорядковыйНомер	= 0;
			КонецЕсли;
			
			//
			ДокументОбъект	= СтрокаДерева.Элемент.ПолучитьОбъект();
			ДокументОбъект.ПорНомер				= ПорядковыйНомер;
			ДокументОбъект.НомерВДереве			= Номер;
			ДокументОбъект.НомерВПределахСметы	= Номер;
			ДокументОбъект.Записать(?(ДокументОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
			
			//	номер в дереве, номер в пределах сметы
			Номер	= Номер + 1;
			
			//	порядковый номер
			Если СтрокаДерева.Элемент.Расчет Тогда
				ПорядковыйНомерРаздела	= ?(ТипЗнч(СтрокаДерева.Элемент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы"), ПорядковыйНомерРаздела + 1, ПорядковыйНомерРаздела);
				ПорядковыйНомерПозиции	= ?(ТипЗнч(СтрокаДерева.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"), ПорядковыйНомерПозиции + 1, ПорядковыйНомерПозиции);
			КонецЕсли;
			
		КонецЕсли;
		
		//
		ДеревоЗначенийПеренумероватьНаСервереБезКонтекста(СтрокаДерева.Строки, Номер, ПорядковыйНомерРаздела, ПорядковыйНомерПозиции);	
	
	КонецЦикла;
	
КонецПроцедуры //Процедура ДеревоЗначенийПеренумероватьНаСервереБезКонтекста(СтрокиДерева, Номер = 1, ПорядковыйНомерРаздела = 1, ПорядковыйНомерПозиции = 1)

#Область ДеревоЗначенийСформировать

&НаСервере
Процедура ДеревоЗначенийПараметрыОбновленияСформировать(ПараметрыОбновления = Неопределено)
	
	//
	Если ПараметрыОбновления = НЕОПРЕДЕЛЕНО тогда
		ПараметрыОбновления	= Новый Структура();
	Иначе
		Если НЕ ТипЗнч(ПараметрыОбновления) = Тип("Структура") тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
		
	//	Документ
	Если НЕ ПараметрыОбновления.Свойство("Документ") тогда
		ПараметрыОбновления.Вставить("Документ"					, Документ);
	КонецЕсли;
	
	//	НеОбновлятьОбъект
	Если НЕ ПараметрыОбновления.Свойство("НеОбновлятьОбъект") тогда
		ПараметрыОбновления.Вставить("НеОбновлятьОбъект"		, ЛОЖЬ);
	КонецЕсли;
	
	//	Перенумеровать
	Если НЕ ПараметрыОбновления.Свойство("Перенумеровать") тогда
		ПараметрыОбновления.Вставить("Перенумеровать"			, ЛОЖЬ);
	КонецЕсли;
	
	//	Действие
	Если НЕ ПараметрыОбновления.Свойство("Действие") тогда
		ПараметрыОбновления.Вставить("Действие"					, "Обновить");	
	КонецЕсли;
	
	//	Процент
	Если НЕ ПараметрыОбновления.Свойство("Процент") тогда
		ПараметрыОбновления.Вставить("Процент"					, ЛОЖЬ);
	КонецЕсли;	
	
	//	КопироватьИндексы
	Если НЕ ПараметрыОбновления.Свойство("КопироватьИндексы") тогда
		ПараметрыОбновления.Вставить("КопироватьИндексы"		, ЛОЖЬ);
	КонецЕсли;	
	
	//	Временное
	Если НЕ ПараметрыОбновления.Свойство("Временное") тогда
		ПараметрыОбновления.Вставить("Временное"				, ЛОЖЬ);
	КонецЕсли;
	
	//	СчетчикНомер
	Если НЕ ПараметрыОбновления.Свойство("СчетчикНомер") тогда
		ПараметрыОбновления.Вставить("СчетчикНомер"				, 1);
	КонецЕсли;
	
	//	СчетчикПорНомерРазделы
	Если НЕ ПараметрыОбновления.Свойство("СчетчикПорНомерРазделы") тогда
		ПараметрыОбновления.Вставить("СчетчикПорНомерРазделы"	, 1);
	КонецЕсли;
	
	//	СчетчикПорНомерПозиции
	Если НЕ ПараметрыОбновления.Свойство("СчетчикПорНомерПозиции") тогда
		ПараметрыОбновления.Вставить("СчетчикПорНомерПозиции"	, 1);
	КонецЕсли;
	
	//	Вид
	Если НЕ ПараметрыОбновления.Свойство("Вид") тогда
		ПараметрыОбновления.Вставить("Вид"						, "");
	КонецЕсли;
	
	//	Преобразовать текст в БУЛЕВО.
	СтруктураБулево	= Новый Структура("Перенумеровать, ");
	СтруктураБулево.Вставить("Перенумеровать"				, Булево(Найти(ПараметрыОбновления["Действие"], "Перенумеровать")));
	СтруктураБулево.Вставить("НеОбновлятьОбъект"			, Булево(Найти(ПараметрыОбновления["Действие"], "ОбновитьБезТаблицАкта")));
	СтруктураБулево.Вставить("ПроцентоватьАкт"				, Булево(Найти(ПараметрыОбновления["Действие"], "Процентовать")));
	СтруктураБулево.Вставить("ЗаполнитьПоОстаткам"			, Булево(Найти(ПараметрыОбновления["Действие"], "ЗаполнитьПоОстаткам") ИЛИ Найти(ПараметрыОбновления["Действие"], "СметаНаОстаток")));
	СтруктураБулево.Вставить("ОбновлениеДерева"				, Булево(НЕ Найти(ПараметрыОбновления["Действие"], "БезОбновления")));
	СтруктураБулево.Вставить("НеИзменятьАкт"				, Булево(НЕ Найти(ПараметрыОбновления["Действие"], "БезТаблицАкта") ИЛИ Найти(ПараметрыОбновления["Действие"], "СметаНаОстаток")));
	СтруктураБулево.Вставить("ЭтоГрупповаяОбработкаПозиций"	, Булево(Найти(ПараметрыОбновления["Вид"], "ГрупповаяОбработкаПозиций")));
		
	ПараметрыОбновления.Вставить("_", СтруктураБулево);
		
КонецПроцедуры //Процедура ОбработатьПараметрыОбновления()

//	Новая версия универсальных процедур вывода дерева.
//	Основная процедура работы с деревом.
//
&НаСервере
Процедура ДеревоЗначенийПостроитьНаСервере(ДеревоЗначений, ПараметрыОбновления = Неопределено)
	
	Ссылка			= ?(ТипЗнч(ПараметрыОбновления["Документ"]) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот"), ПараметрыОбновления["Документ"].ЛокальнаяСмета, ПараметрыОбновления["Документ"]);
	ЭлементКорня	= СМ_СметаВызовСервера.ПолучитьСсылкуНаДокумент(Ссылка); 
	ИтогПоСмете		= ПолучитьИтогПоСмете();
	ТекстЗапроса	= ПолучитьТекстЗапросаНаДеревоСмет(ПараметрыОбновления["Документ"]);
	
	//	ДеревоЗначений
	ДеревоЗначений.Строки.Очистить();

	//	СтруктураПараметров
	СформироватьПараметрыОбновленияНаСервере(ПараметрыОбновления);
	
	//	Запрос
	Если ЗначениеЗаполнено(ТекстЗапроса) тогда
		
		//	
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;	
		ДокСсылка = ПараметрыОбновления["Документ"];
		Запрос.УстановитьПараметр("Ссылка"					, ДокСсылка);
		Если ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
			Запрос.УстановитьПараметр("ЛокальнаяСмета"			, ДокСсылка.ЛокальнаяСмета);
		КонецЕсли;
		Запрос.УстановитьПараметр("ИтогРаздела"				, Справочники.СМ_ИтогиПоРазделу.ИтогоПоРазделу);
		Запрос.УстановитьПараметр("ИтогСметы"				, ИтогПоСмете);
		Запрос.УстановитьПараметр("ВидРасценкиОборудование"	, Перечисления.СМ_ВидыРасценки.Оборудование);
		Запрос.УстановитьПараметр("ВидРасценкиМатериал"		, Перечисления.СМ_ВидыРасценки.Материал);
		Запрос.УстановитьПараметр("РазрешитьРедактирование"	, ПолучитьФункциональнуюОпцию("СМ_РазрешитьРедактированиеЗакрытыхСмет"));
		
		ТаблицаЗначений = Запрос.Выполнить().Выгрузить();
		
		//	ДеревоЗначений.Добавить()
		ДеревоЗначенийЗаполнитьПоТаблицеЗначенийНаСервере(
			ДеревоЗначений,
			ТаблицаЗначений,
			ПараметрыОбновления,
			Новый Структура("ЭлементРодитель", Неопределено));
		
	КонецЕсли;
	
КонецПроцедуры //Процедура ДеревоЗначенийПостроитьНаСервере()

