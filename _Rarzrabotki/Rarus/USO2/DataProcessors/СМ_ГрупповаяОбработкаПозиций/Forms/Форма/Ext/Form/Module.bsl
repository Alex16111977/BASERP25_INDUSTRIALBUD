	СуммируемыеКолонки.Вставить("СтоимостьБазисная"		, Новый Структура("Функция, ЗначениеНеравенства", "СРАВНЕНИЕ", "разн. знч."));
	СуммируемыеКолонки.Вставить("СтоимостьЗМБазисная"	, Новый Структура("Функция, ЗначениеНеравенства", "СРАВНЕНИЕ", "разн. знч."));
	СуммируемыеКолонки.Вставить("СтоимостьТекущая"		, Новый Структура("Функция, ЗначениеНеравенства", "СРАВНЕНИЕ", "разн. знч."));
	СуммируемыеКолонки.Вставить("СтоимостьТекущаяЗМ"	, Новый Структура("Функция, ЗначениеНеравенства", "СРАВНЕНИЕ", "разн. знч."));
	
	//
	СформироватьСводнуюТаблицуНаКлиенте(ОбрабатываемыеПозиции, "Ресурсы", ГруппируемыеКолонки, СуммируемыеКолонки);
		
КонецФункции //Функция РесурсыЗаполнитьНаКлиенте(ОбрабатываемыеПозиции = Неопределено) Экспорт

