#Область СВОЙСТВА

&НаСервере
Функция КомандаСвойстваРедактироватьНаСервере()
	
	//
	ОтмеченныеЭлементы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("УчастиеПометка", Истина));
	ОтмеченныеСвойства	= ТабличнаяЧастьСвойства.НайтиСтроки(Новый Структура("Пометка", Истина));
	
	//
	Для Каждого ЭлементыСтрока Из ОтмеченныеЭлементы Цикл
		
		ОбрабатываемыйОбъект	= ЭлементыСтрока["СсылкаНаОбъект"].ПолучитьОбъект();	
		
		Для Каждого СвойстваСтрока Из ОтмеченныеСвойства Цикл
			
			НайденноеСвойство	= ОбрабатываемыйОбъект.ДополнительныеРеквизиты.Найти(СвойстваСтрока["Свойство"], "Свойство");
			
			Если НайденноеСвойство = Неопределено Тогда
				Строка	= ОбрабатываемыйОбъект.ДополнительныеРеквизиты.Добавить();	
				Строка.Свойство			= СвойстваСтрока["Свойство"];
				Строка.Значение			= СвойстваСтрока["Значение"];
				//Строка.ТекстоваяСтрока	= "";
			Иначе	
				НайденноеСвойство.Значение	= СвойстваСтрока["Значение"];	
			КонецЕсли;
			
		КонецЦикла;
		
		ОбрабатываемыйОбъект.Записать();
		
	КонецЦикла;
	
	//
	Возврат Истина;

КонецФункции //Функция КомандаСвойстваРедактироватьНаСервере()

