#Область Перенести

//	Процедура, обрабатывающая перенос позиции, раздела в другой раздел
// срабатывает после вызова обработки "СМ_ДеревоСметПростое" в процедуре "ПереместитьВРаздел"
// ПАРАМЕТРЫ:
//// Результат - ответ пользователя на вопрос (продолжать или нет)
//// Параметры - дополнительные параметры переданные при формировании вопроса пользовтелю.
&НаКлиенте
Процедура КомандаРасценкиПеренестиОповещениеНаКлиенте(ЭлементПриемник, ПараметрыОповещения) Экспорт
	
	//
	ДоступнаОбработкаКоманды	= Истина;
	ТекстПредупреждения			= "Ошибка! Обработка команды [перенести]- прекращена!";
	
	//	если отказались от переноса
	Если ЭлементПриемник = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	//	проверить выбранный элемент приемник
	Если НЕ СМ_ДоступнаОбработкаПеренестиКопироватьНаКлиенте(ЭлементПриемник, ТекстПредупреждения) Тогда
		//	(!) ошибка, сообщить пользователю
		ПоказатьПредупреждение(, ТекстПредупреждения);		
		Возврат;
	КонецЕсли;
	
	//	Добавить локальную смету приемника, в обрабатываемые.
	ОбрабатываемыеЭлементыДобавитьПриемникНаСервере(ЭлементПриемник);
	
	//	(!) ВЫПОЛНИТЬ
	Если ДоступнаОбработкаКоманды
		И КомандаРасценкиПеренестиНаСервере(ЭлементПриемник, ТекстПредупреждения) Тогда
	
		//	обновить дерево значений
		ДеревоЗначенийОбновитьНаКлиенте();
	
		//	выполнено успешно, сообщить пользователю
		СообщитьПользователюУспешноеВыполнениеКомандыНаСервере(ПараметрыОповещения.КомандаИмя);
		
	Иначе
		//	(!) ошибка, сообщить пользователю
		ПоказатьПредупреждение(, ТекстПредупреждения);		
	КонецЕсли;

КонецПроцедуры //Процедура КомандаРасценкиПеренестиОповещениеНаКлиенте()   

&НаСервере
Функция КомандаРасценкиПеренестиНаСервере(ЭлементПриемник, ТекстПредупреждения = "")
	
	//
	Если Параметры["Операция"] = "ОбработкаПозиции"
		И ТипЗнч(ЭлементПриемник) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		ТекстПредупреждения	= НСтр("ru = 'Позиции, возможно переносить, только в разделы!';");
		Возврат Ложь;
	КонецЕсли;
	
	//
	ОбрабатываемыеОбъектныеСметы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка, УчастиеПриемник", Строка(Тип("ДокументСсылка.СМ_ОбъектнаяСмета")), Истина, Ложь));
	ОбрабатываемыеЛокальныеСметы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеРодитель", Строка(Тип("ДокументСсылка.СМ_ЛокальнаяСмета")), Истина));
	ОбрабатываемыеРазделы			= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")), Истина));
	ОбрабатываемыеПозиции			= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	ДеревоЗначений					= РеквизитФормыВЗначение("ЭлементыДеревоЗначений", Тип("ДеревоЗначений"));
	ОбработкаЗавершенаСОшибкой		= Ложь;
	
	//
	НачатьТранзакцию();
	
	//
	Если Параметры["Операция"] = "ОбработкаОбъектнойСметы" Тогда
		
		//
		Для Каждого Строка Из ОбрабатываемыеОбъектныеСметы Цикл
			
			//	сводная смета
			
		КонецЦикла;
			
	ИначеЕсли Параметры["Операция"] = "ОбработкаЛокальнойСметы" Тогда
		
		//
		Для Каждого Строка Из ОбрабатываемыеЛокальныеСметы Цикл
			
			//
			УстановитьРодительЛокальнойСметыНаСервереБезКонтекста(Строка["СсылкаНаОбъект"], ЭлементПриемник);	
			
		КонецЦикла;
			
	ИначеЕсли Параметры["Операция"] = "ОбработкаРаздела" Тогда
		
		//	разделы
		Для Каждого Строка Из ОбрабатываемыеРазделы Цикл
			
			//
			Если Строка["СсылкаНаОбъект"] = ЭлементПриемник Тогда
				ОбработкаЗавершена = Ложь;
				ТекстСообщенияПользователю	= НСтр("ru='Выберите другой раздел. Перенос в этот же раздел невозможен!'");	
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщенияПользователю);
			Иначе
				ОбработкаЗавершена = УстановитьРодительРазделаПозицииНаСервере(Строка["СсылкаНаОбъект"], ЭлементПриемник);	
			КонецЕсли;
			//
			Если НЕ ОбработкаЗавершена Тогда
				ОбработкаЗавершенаСОшибкой = Истина;
				Прервать;
				// Перейти ~ОбработкаЗавершенаСОшибкой;	
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ОбработкаЗавершенаСОшибкой Тогда
			// позиции
			Для Каждого Строка Из ОбрабатываемыеПозиции Цикл
				УстановитьРодительРазделаПозицииНаСервере(Строка["СсылкаНаОбъект"], ЭлементПриемник);	
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли Параметры["Операция"] = "ОбработкаПозиции" Тогда
		
		//	позиции
		Для Каждого Строка Из ОбрабатываемыеПозиции Цикл
			Если Строка.СтатусРедактирования = 1 Тогда
				Продолжить;
			КонецЕсли;

			УстановитьРодительРазделаПозицииНаСервере(Строка["СсылкаНаОбъект"], ЭлементПриемник);	
		КонецЦикла;
			
	КонецЕсли;
	
	// ~ОбработкаЗавершенаСОшибкой:
	
	//	Перенумеровать документы.
	ДеревоЗначенийПеренумероватьНаСервереБезКонтекста(ДеревоЗначений.Строки);
	
	//	Перенумеровать документы.
	Для Каждого Строка Из ОбрабатываемыеЛокальныеСметы Цикл
		СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(Строка["СсылкаНаОбъект"]);
	КонецЦикла;

	СметаПриемник = СМ_СметаВызовСервера.НайтиЛС(ЭлементПриемник);
	СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(СметаПриемник);
	
	ЗафиксироватьТранзакцию();  //СУДАРИКОВ - блокировки
	
	//	Перерасчет документов.
	ДокументПерерасчетНаСервере(Документ,Истина);
	ДокументПерерасчетНаСервере(СметаПриемник,Истина);
	
	// ЗафиксироватьТранзакцию(); СУДАРИКОВ - блокировки.
	
	Возврат Истина;

КонецФункции //Функция КомандаРасценкиПеренестиНаСервере()

&НаСервереБезКонтекста
Функция УстановитьРодительЛокальнойСметыНаСервереБезКонтекста(СсылкаНаОбъект, ЭлементПриемник)
	
	//
	ДокументОбъект = СсылкаНаОбъект.ПолучитьОбъект();
	
	ДокументОбъект.ПорНомер		= 0;
	ДокументОбъект.ИДРодителя	= ЭлементПриемник;
		
	ДокументОбъект.Записать();
	
	Возврат Истина;
	
КонецФункции //Функция УстановитьРодительЛокальнойСметыНаСервереБезКонтекста(СсылкаНаОбъект, ЭлементПриемник)

&НаСервере
Функция УстановитьРодительРазделаПозицииНаСервере(СсылкаНаОбъект, ЭлементПриемник)
	
	//	получим значения, для подставновки "ИДСметы", "ИДРодителя"
	ПараметрыСменыРодителя	= ПолучитьПараметрыСменыРодителяНаСервере(СсылкаНаОбъект, ЭлементПриемник);
	
	// *********************************************
	// ++ AVV Роли в системе
	// Если пользователь не обладает ролью "Управление стройками",
	// то он не может копировать или перемещать сущности (позиции, разделы) в сметы других строек.
	//Если НЕ РольДоступна("СМ_УправлениеСтройками") Тогда 
	//	Если СсылкаНаОбъект.ИДСметы.Стройка <> ЭлементПриемник.ИДСметы.Стройка Тогда
	//		ТекстСообщенияПользователю	= НСтр("ru='Перенос объекта " + СсылкаНаОбъект + " невозможен! Отличаются объекты строительства.'");	
	//		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщенияПользователю);
	//		Возврат Ложь;
	//	КонецЕсли;
	//КонецЕсли;
	// -- AVV Роли в системе
	// *********************************************	
	
	ДокументОбъект 				= СсылкаНаОбъект.ПолучитьОбъект();
	ДокументОбъект.ПорНомер		= 0;
	ДокументОбъект.ИДСметы		= ПараметрыСменыРодителя.ЛокальнаяСмета;
	ДокументОбъект.ИДРодителя	= ПараметрыСменыРодителя.Родитель;
	ДокументОбъект.Записать();
	
	Возврат Истина;
	
КонецФункции //Функция УстановитьРодительРазделаПозицииНаСервере(СсылкаНаОбъект, ЭлементПриемник)

#КонецОбласти //#Область Перенести/#Область РАСЦЕНКИ

#Область Копировать

// Процедура, обрабатывающая копирование позиции, раздела в другой раздел
// срабатывает после вызова обработки "СМ_ДеревоСметПростое" в процедуре "ПереместитьВРаздел"
// ПАРАМЕТРЫ:
//// Результат - ответ пользователя на вопрос (продолжать или нет)
//// Параметры - дополнительные параметры переданные при формировании вопроса пользовтелю.
&НаКлиенте
Процедура КомандаКопироватьОповещениеНаКлиенте(ЭлементПриемник, ПараметрыОповещения) Экспорт
	
	//
	ДоступнаОбработкаКоманды	= Истина;
	ТекстПредупреждения			= "Ошибка! Обработка команды [перенести]- прекращена!";
	
	Если ЭлементПриемник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//	проверить выбранный элемент приемник
	Если НЕ СМ_ДоступнаОбработкаПеренестиКопироватьНаКлиенте(ЭлементПриемник, ТекстПредупреждения) Тогда
		//	(!) ошибка, сообщить пользователю
		ПоказатьПредупреждение(, ТекстПредупреждения);		
		Возврат;
	КонецЕсли;
	
	//	Добавить выбранный элемент-приемник, в обрабатываемые.
	ОбрабатываемыеЭлементыДобавитьПриемникНаСервере(ЭлементПриемник);
	
	//
	Если КомандаКопироватьНаСервере(ЭлементПриемник, ПараметрыОповещения) Тогда
	
		//
		ДеревоЗначенийОбновитьНаКлиенте();
		
		//
		Если ЗначениеЗаполнено(ЭтаФорма.Параметры.ТекущийЭлемент) Тогда
			
			//
			Оповестить("ОбновитьПослеКопирования", Новый Структура("Смета", ЭтаФорма.Параметры.ТекущийДокумент));
			
		КонецЕсли;
		
		//	сообщить пользователю
		СообщитьПользователюУспешноеВыполнениеКомандыНаСервере(ПараметрыОповещения.КомандаИмя);
		
	КонецЕсли;	
	
КонецПроцедуры //Процедура КомандаКопироватьОповещениеНаКлиенте(Результат, Параметры) Экспорт

// Непосредственно копирование объектов.
//
&НаСервере
Функция КомандаКопироватьНаСервере(ЭлементПриемник, ПараметрыОповещения)
	
	//
	ОбрабатываемыеЛокальныеСметы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ЛокальнаяСмета")), Истина));
	ОбрабатываемыеПозиции			= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	ДеревоЗначений					= РеквизитФормыВЗначение("ЭлементыДеревоЗначений", Тип("ДеревоЗначений"));
	
	//
	НачатьТранзакцию();
	
	Если Параметры["Операция"] = "ОбработкаЛокальнойСметы" Тогда
		
		//
		КомандаКопироватьОбработкаЛокальнойСметыНаСервере(ЭлементПриемник, ПараметрыОповещения);
		
	ИначеЕсли Параметры["Операция"] = "ОбработкаРаздела" Тогда
		
		//
		СтартововаяСтрокаДерева	= ОбрабатываемыеЭлементыМаксимальноПоУровнюОтмеченныйНаСервере();
		
		//	рекурсивно создаем документы "разделы"
		КомандаКопироватьОбработкаРазделаНаСервере(ЭлементПриемник, Новый Структура("Тип, УчастиеПометка, Родитель", Строка(Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")), Истина, СтартововаяСтрокаДерева["ЭлементРодитель"]), ПараметрыОповещения);
		
		//	позиции
		Для Каждого Строка Из ОбрабатываемыеПозиции Цикл
			
			//
			КомандаКопироватьПозицияНаСервере(Строка["СсылкаНаОбъект"], ЭлементПриемник);	
			
		КонецЦикла;
		
	ИначеЕсли Параметры["Операция"] = "ОбработкаПозиции" Тогда
		
		//
		КомандаКопироватьОбработкаПозицииНаСервере(ЭлементПриемник, ПараметрыОповещения);
			
	КонецЕсли;
	
	// Перенумеровать документы.
	Для Каждого Строка Из ОбрабатываемыеЛокальныеСметы Цикл
		СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(Строка["СсылкаНаОбъект"]);
	КонецЦикла;

	СметаПриемник = СМ_СметаВызовСервера.НайтиЛС(ЭлементПриемник);
	СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(СметаПриемник);

	ЗафиксироватьТранзакцию(); // СУДАРИКОВ - блокировки
	
	// Перерасчет документов.
	ДокументПерерасчетНаСервере(Документ);
	
	// ЗафиксироватьТранзакцию(); // СУДАРИКОВ - блокировки.
	
	Возврат Истина;
	
КонецФункции //Функция КомандаКопироватьНаСервере(ЭлементПриемник, ПараметрыОповещения)


//	Процедура перебора объектов для копирования
//
&НаСервере
Процедура КомандаКопироватьОбработкаЛокальнойСметыНаСервере(ЭлементПриемник, ПараметрыОповещения)

	//
	ОбрабатываемыеЛокальныеСметы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ЛокальнаяСмета")), Истина));
	
	//	локальные сметы
	Для Каждого СтрокаЛокальнаяСмета Из ОбрабатываемыеЛокальныеСметы Цикл
		
		//	скопировать "ЛокальнаяСмета", запомним скопированную "ЛокальнаяСмета"
		СтрокаЛокальнаяСмета.Копия	= КомандаКопироватьЛокальнаяСметаНаСервереБезКонтекста(СтрокаЛокальнаяСмета["СсылкаНаОбъект"], ЭлементПриемник);	
		
		//	отобрать разделы, принадлежащие данной смете
		ЛокальнаяСметаОбрабатываемыеРазделы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, ЛокальнаяСмета", Строка(Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")), СтрокаЛокальнаяСмета["СсылкаНаОбъект"]));
		
		//	разделы УникальныйИдентификатор
		Для Каждого СтрокаРаздел Из ЛокальнаяСметаОбрабатываемыеРазделы Цикл
			
			//	запомнить копию документа
			СтрокаРаздел.Копия	= КомандаКопироватьРазделНаСервереБезКонтекста(СтрокаРаздел["СсылкаНаОбъект"], ЭлементПриемник);	
				
			//	отобрать позиции, вложенные в данный раздел
			ЛокальнаяСметаОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка, ЛокальнаяСмета, Родитель", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина, СтрокаЛокальнаяСмета["СсылкаНаОбъект"], СтрокаРаздел["СсылкаНаОбъект"]));
			
			//	позиции
			Для Каждого СтрокаПозиция Из ЛокальнаяСметаОбрабатываемыеПозиции Цикл
				
				//
				КомандаКопироватьПозицияНаСервере(СтрокаПозиция["СсылкаНаОбъект"], ЭлементПриемник);	
				
			КонецЦикла;
			
		КонецЦикла;
			
	КонецЦикла;
			
КонецПроцедуры //Процедура КомандаКопироватьОбработкаЛокальнойСметыНаСервере(ЭлементПриемник, ПараметрыОповещения)

//	Процедура перебора объектов для копирования
//
&НаСервере
Процедура КомандаКопироватьОбработкаРазделаНаСервере(ЭлементПриемник, ПараметрыОтбора, ПараметрыОповещения)
	
	//
	ОбрабатываемыеРазделыУровня	= ОбрабатываемыеЭлементы.НайтиСтроки(ПараметрыОтбора);
	
	//	разделы
	Для Каждого ОбрабатываемыйЭлемент Из ОбрабатываемыеРазделыУровня Цикл
		
		//	Создаем копию документа и вносим ссылку в таблицу.
		Если ОбрабатываемыйЭлемент["УчастиеПометка"] Тогда
			ОбрабатываемыйЭлемент.Копия	= КомандаКопироватьРазделНаСервереБезКонтекста(ОбрабатываемыйЭлемент["СсылкаНаОбъект"], ЭлементПриемник);	
		КонецЕсли;
		
		//
		ПараметрыОтбора	= Новый Структура("Тип, УчастиеПометка, Родитель", Строка(Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")), Истина, ОбрабатываемыйЭлемент["СсылкаНаОбъект"]);
		
		//
		КомандаКопироватьОбработкаРазделаНаСервере(ЭлементПриемник, ПараметрыОтбора, ПараметрыОповещения);
		
	КонецЦикла;
		
КонецПроцедуры //Процедура КомандаКопироватьОбработкаРазделаНаСервере(ЭлементПриемник, ПараметрыОповещения)

//	Процедура перебора объектов для копирования
//
&НаСервере
Процедура КомандаКопироватьОбработкаПозицииНаСервере(ЭлементПриемник, ПараметрыОповещения)

	//
	ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	
	//	позиции
	Для Каждого Строка Из ОбрабатываемыеПозиции Цикл
		
		//	создаем копию документа и вносим ссылку в таблицу
		Строка.Копия	= КомандаКопироватьПозицияНаСервере(Строка["СсылкаНаОбъект"], ЭлементПриемник);	
		
	КонецЦикла;
			
КонецПроцедуры //Процедура КомандаКопироватьОбработкаПозицииНаСервере(ЭлементПриемник, ПараметрыОповещения)


&НаСервереБезКонтекста
Функция КомандаКопироватьЛокальнаяСметаНаСервереБезКонтекста(СсылкаНаОбъект, ЭлементПриемник = Неопределено)
	
	//
	Если ЭлементПриемник = Неопределено Тогда
		ЭлементПриемник	= Документы.СМ_ОбъектнаяСмета.ПустаяСсылка();	
	КонецЕсли;
	
	//
	ПараметрыСменыРодителя	= Новый Структура("ЛокальнаяСмета, Родитель", СсылкаНаОбъект, ЭлементПриемник);
	
	//
	ДокументОбъект = СсылкаНаОбъект.Скопировать();
	ДокументОбъект.Дата 				= ТекущаяДатаСеанса(); 
	ДокументОбъект.КорректируетСмету	= Документы.СМ_РазделЛокальнойСметы.ПустаяСсылка();
	ДокументОбъект.Наименование			= СсылкаНаОбъект.Наименование; //СледующееНаименованиеКопииНаСервереБезКонтекста(СсылкаНаОбъект, СсылкаНаОбъект.Наименование, ПараметрыСменыРодителя); 
	ДокументОбъект.Комментарий			= "Создан копированием объекта [" + Строка(СсылкаНаОбъект) + "]."; 
	
	ДокументОбъект.ИДРодителя			= ЭлементПриемник;
	
	ДокументОбъект.Записать();
	
	// Добавим, только что скопированную "ЛокальнаяСмета", в табличную часть "ОбъектнаяСмета.ЛокальныеСметы".
	ОбъектнаяСметаОбъект	= ЭлементПриемник.ПолучитьОбъект();
	
	//
	НомерПП	= ОбъектнаяСметаОбъект.ЛокальныеСметы.Количество() + 1;
	
	//
	Строка	= ОбъектнаяСметаОбъект.ЛокальныеСметы.Добавить();	
	Строка.ЛокальнаяСмета		= ДокументОбъект.Ссылка;
	Строка.НомерПП				= НомерПП;
	Строка.КоличествоОбъектов	= 1;
	Строка.Расчет				= Истина;
	
	ОбъектнаяСметаОбъект.Записать();
	
	//
	Возврат ДокументОбъект.Ссылка;

КонецФункции //Функция КомандаКопироватьЛокальнаяСметаНаСервереБезКонтекста(СсылкаНаОбъект, ЭлементПриемник = Неопределено)

&НаСервере
Функция КомандаКопироватьРазделНаСервереБезКонтекста(СсылкаНаОбъект, ЭлементПриемник = Неопределено)
	
	//	получим значения, для подставновки "ИДСметы", "ИДРодителя"
	ПараметрыСменыРодителя	= ПолучитьПараметрыСменыРодителяНаСервере(СсылкаНаОбъект, ЭлементПриемник, Истина);
	
	//
	ДокументОбъект = СсылкаНаОбъект.Скопировать();
	ДокументОбъект.Дата 					= ТекущаяДатаСеанса(); 
	ДокументОбъект.КорректируетРаздел		= Документы.СМ_РазделЛокальнойСметы.ПустаяСсылка();
	ДокументОбъект.НаименованиеДляПечати	= ДокументОбъект.НаименованиеДляПечати; //СледующееНаименованиеКопииНаСервереБезКонтекста(СсылкаНаОбъект, ДокументОбъект.НаименованиеДляПечати, ПараметрыСменыРодителя); 
	ДокументОбъект.Комментарий				= "Создан копированием объекта [" + Строка(СсылкаНаОбъект) + "]."; 
	
	ДокументОбъект.ИДРодителя				= ПараметрыСменыРодителя.Родитель;
	ДокументОбъект.ИДСметы					= ПараметрыСменыРодителя.ЛокальнаяСмета;
	
	ДокументОбъект.Записать();
	
	Возврат ДокументОбъект.Ссылка;

КонецФункции //Функция КомандаКопироватьРазделНаСервере(СсылкаНаОбъект, ЭлементПриемник = Неопределено, ЛокальнаяСметаКопия = Неопределено)

&НаСервере
Функция КомандаКопироватьПозицияНаСервере(СсылкаНаОбъект, ЭлементПриемник = Неопределено)
	
	//	получим значения, для подставновки "ИДСметы", "ИДРодителя"
	ПараметрыСменыРодителя	= ПолучитьПараметрыСменыРодителяНаСервере(СсылкаНаОбъект, ЭлементПриемник, Истина);
	
	//
	ДокументОбъект = СсылкаНаОбъект.Скопировать();
	ДокументОбъект.Дата 				= ТекущаяДатаСеанса(); 
	ДокументОбъект.КорректируетПозицию	= Документы.СМ_ПозицияЛокальнойСметы.ПустаяСсылка();
	ДокументОбъект.Наименование			= ДокументОбъект.Наименование; //СледующееНаименованиеКопииНаСервереБезКонтекста(СсылкаНаОбъект, ДокументОбъект.Наименование, ПараметрыСменыРодителя); 
	ДокументОбъект.Комментарий			= "Создан копированием объекта [" + Строка(СсылкаНаОбъект) + "].";
	
	ДокументОбъект.ИДПозицииВладельца	= ПараметрыСменыРодителя.Владелец;
	ДокументОбъект.КорректируетПозицию	= Документы.СМ_ПозицияЛокальнойСметы.ПустаяСсылка();
	
	ДокументОбъект.ИДРодителя			= ПараметрыСменыРодителя.Родитель;
	ДокументОбъект.ИДСметы				= ПараметрыСменыРодителя.ЛокальнаяСмета;
	
	ДокументОбъект.Записать();
	
	Возврат ДокументОбъект.Ссылка;

КонецФункции //Функция КомандаКопироватьПозицияНаСервере(СсылкаНаОбъект, ЭлементПриемник = Неопределено)

#КонецОбласти //#Область Копировать/#Область РАСЦЕНКИ

#Область Удалить
	
// Процедура непорседственного удаления документа - позиции, на входе - ссылка.
//
&НаСервере
Функция КомандаУдалитьНаСервере(Операция = "")
	
	//
	ОбрабатываемыеЛокальныеСметы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ЛокальнаяСмета")), Истина));
	ОбрабатываемыеРазделы			= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")), Истина));
	ОбрабатываемыеПозиции			= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	
	//
	НачатьТранзакцию();
	
	//	цикл
	Если Операция = "ОбработкаЛокальнойСметы" Тогда
			
		//	локальные сметы
		Для Каждого Строка Из ОбрабатываемыеЛокальныеСметы Цикл
			
			//
			СМ_СметаВызовСервера.УдалитьЛС(Строка["СсылкаНаОбъект"]);
			
			//	Удалить из дерева значений, на форме.
			СтрокаДерева	= ЭлементыДеревоЗначений.НайтиПоИдентификатору(Строка["Идентификатор"]);
			
			Если НЕ СтрокаДерева = Неопределено Тогда
				СтрокаДерева.ПолучитьРодителя().ПолучитьЭлементы().Удалить(СтрокаДерева);
			КонецЕсли;
			
		КонецЦикла;

	ИначеЕсли Операция = "ОбработкаРаздела" Тогда
			
		//	разделы
		Для Каждого Строка Из ОбрабатываемыеРазделы Цикл
			
			//
			СМ_СметаВызовСервера.УдалитьПозициюЛС(Строка["СсылкаНаОбъект"], Истина);
			
			//	Удалить из дерева значений, на форме.
			СтрокаДерева	= ЭлементыДеревоЗначений.НайтиПоИдентификатору(Строка["Идентификатор"]);
			
			Если НЕ СтрокаДерева = Неопределено Тогда
				СтрокаДерева.ПолучитьРодителя().ПолучитьЭлементы().Удалить(СтрокаДерева);
			КонецЕсли;
			
		КонецЦикла;

	ИначеЕсли Операция = "ОбработкаПозиции" Тогда
		
		//	позиции
		Для Каждого Строка Из ОбрабатываемыеПозиции Цикл
			
			Если Строка.СтатусРедактирования = 1 Тогда
				Продолжить;
			КонецЕсли;

			//
			СМ_СметаВызовСервера.УдалитьПозициюЛС(Строка["СсылкаНаОбъект"], Истина);
			
			//	Удалить из дерева значений, на форме.
			СтрокаДерева	= ЭлементыДеревоЗначений.НайтиПоИдентификатору(Строка["Идентификатор"]);
			
			Если НЕ СтрокаДерева = Неопределено Тогда
				СтрокаДерева.ПолучитьРодителя().ПолучитьЭлементы().Удалить(СтрокаДерева);
			КонецЕсли;
			
		КонецЦикла;
			
	КонецЕсли;
	
	ДеревоЗначений	= РеквизитФормыВЗначение("ЭлементыДеревоЗначений", Тип("ДеревоЗначений"));
	
	// Перенумеровать документов.
	Для Каждого Строка Из ОбрабатываемыеЛокальныеСметы Цикл
		СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(Строка["СсылкаНаОбъект"]);
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();// СУДАРИКОВ - блокировки

	// Перерасчет документов.
	ДокументПерерасчетНаСервере(Документ);
	// ЗафиксироватьТранзакцию();// СУДАРИКОВ - блокировки
		
	Возврат Истина;
	
КонецФункции //Функция КомандаУдалитьНаСервере(Операция = "")

#КонецОбласти //#Область Удалить/#Область РАСЦЕНКИ


#Область Поправка115

//  Добавление поправки 1.15 - 1.25, если такой в ТЧ позиции нет.
//
&НаСервере
Функция КомандаПоправка115НаСервере()

	ТекПоправка115			= Справочники.СМ_ПоправкиПоТехническимЧастям.Поправка115;
	ВариантРасчетаЭММ		= ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета", "ВариантРасчетаЭксплуатацииМашин");	
	ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	СтруктураОтбора			= Новый Структура;
	СтруктураОтбора.Вставить("УсловияПрименения", ТекПоправка115.УсловияПрименения);
	СтруктураОтбора.Вставить("Обоснование"		, ТекПоправка115.Обоснование);
	
	НачатьТранзакцию();
	
	Для каждого Строка Из ОбрабатываемыеПозиции Цикл
		Если Строка.СтатусРедактирования = 1 Тогда
			Продолжить;
		КонецЕсли;
		ОбъектПозиции = Строка["СсылкаНаОбъект"].ПолучитьОбъект();
		// Проверка, что такая была поправка.
		ВремТабл	= ОбъектПозиции.ПоправкиПозиции.Выгрузить();
		МассивСтрок = ВремТабл.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ОбъектПозиции.ПоправкиПозиции.Добавить();
		НоваяСтрока.УсловияПрименения	= ТекПоправка115.УсловияПрименения; 
		НоваяСтрока.Обоснование			= ТекПоправка115.Обоснование;
		НоваяСтрока.Применить			= Истина;
		НоваяСтрока.ВариантРасчета		= ВариантРасчетаЭММ;
		НоваяСтрока.КоэффОЗ 			= ТекПоправка115.КоэффициентКОсновнойЗарплате;		  
		НоваяСтрока.КоэффЭМ 			= ТекПоправка115.КоэффициентКЭксплуатацииМашин;
		НоваяСтрока.КоэффЗМ 			= ТекПоправка115.КоэффициентКЗарплатеМашинистов;
		НоваяСтрока.КоэффТР 			= ТекПоправка115.КоэффициентКТрудозатратамРабочих;
		НоваяСтрока.КоэффТМ 			= ТекПоправка115.КоэффициентКТрудозатратамМашинистов;
		НоваяСтрока.ТипПоправки 		= ТекПоправка115.ТипПоправки;

		ОбъектПозиции.Записать();

	КонецЦикла;	
	
	//	Перерасчет документов.
	ДокументПерерасчетНаСервере(Документ);
	
	ЗафиксироватьТранзакцию();
	
	//
	Возврат Истина;
	
КонецФункции //Функция КомандаПоправка115НаСервере()

#КонецОбласти //#Область Поправка115

#Область УстановитьНеИндексировать 

// Непосредственно установка флага Не индексировать в выбранных документах.
//
&НаСервере
Функция КомандаУстановитьНеИндексироватьНаСервере()
	
	//
	ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	
	//	Транзакция
	НачатьТранзакцию();
	
	//
	Для Каждого Строка Из ОбрабатываемыеПозиции Цикл
		Если Строка.СтатусРедактирования = 1 Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоРаботаНаСервереБезКонтекста(Строка["СсылкаНаОбъект"].Определитель, Строка["СсылкаНаОбъект"].ТипНормативныхСборников)
			ИЛИ ЭтоБазисноИндексныйУровеньСметаНаСервереБезКонтекста(Строка["СсылкаНаОбъект"].ИДСметы) Тогда
			Продолжить;
		КонецЕсли;
		
		ОбъектПозиции = Строка["СсылкаНаОбъект"].ПолучитьОбъект();
		ОбъектПозиции.НеПрименятьИндексы = Истина;
		ОбъектПозиции.Записать();
		
	КонецЦикла;
	
	//	Перерасчет документов.
	ДокументПерерасчетНаСервере(Документ);
	
	ЗафиксироватьТранзакцию();
	
	//
	Возврат Истина;
	
КонецФункции //Функция КомандаУстановитьНеИндексироватьНаСервере()

&НаСервере
Функция КомандаУстановитьНеИзменятьЦены(НеИзменятьЦены = Истина)
	
	//
	ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	
	//	Транзакция
	НачатьТранзакцию();
	
	//
	Для Каждого Строка Из ОбрабатываемыеПозиции Цикл
		
		ОбъектПозиции = Строка["СсылкаНаОбъект"].ПолучитьОбъект();
		ОбъектПозиции.НеИзменятьЦены = НеИзменятьЦены;
		ОбъектПозиции.Записать();
		
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	//
	Возврат Истина;
	
КонецФункции //Функция КомандаУстановитьНеИндексироватьНаСервере()

&НаСервереБезКонтекста
Функция ЭтоРаботаНаСервереБезКонтекста(Определитель, ТипНормативныхСборников)
	
	Если  Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Работа
		И (Не ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин
		И Не ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.Транспортировка) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции //Функция ЭтоРаботаНаСервереБезКонтекста(Определитель, ТипНормативныхСборников)

&НаСервереБезКонтекста
Функция ЭтоБазисноИндексныйУровеньСметаНаСервереБезКонтекста(Смета)

	Возврат (Смета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный И Смета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета);

КонецФункции //Функция ЭтоБазисноИндексныйУровеньСметаНаСервереБезКонтекста(Смета)

