	СуммируемыеКолонки.Вставить("КоэффСтоимМатериалов"		, Новый Структура("Функция, ЗначениеНеравенства", "СРАВНЕНИЕ", 0));

	//
	СформироватьСводнуюТаблицуНаКлиенте(ОбрабатываемыеПозиции, "Индексы", ГруппируемыеКолонки, СуммируемыеКолонки);
	
КонецФункции //Функция ИндексыЗаполнитьНаКлиенте(ОбрабатываемыеПозиции) Экспорт

//
//
&НаКлиенте
Функция СвойстваЗаполнитьНаКлиенте(ОбрабатываемыеДокументы) Экспорт
	
	//
	Если ОбрабатываемыеДокументы = Неопределено Тогда
		ОбрабатываемыеДокументы	= ОбрабатываемыеЭлементы.НайтиСтроки();
	КонецЕсли;
	
	//	Группируемые колонки.
	ГруппируемыеКолонки	= Новый Массив;
	ГруппируемыеКолонки.Добавить("Свойство");
			
	//	Суммируемые колонки.
	СуммируемыеКолонки	= Новый Структура;
	СуммируемыеКолонки.Вставить("Значение", Новый Структура("Функция, ЗначениеНеравенства", "СРАВНЕНИЕ", "разн. знч."));
	
	//
	СформироватьТаблицуДополнительныеРеквизитыНаКлиенте("ДополнительныеРеквизиты");

	//
	СформироватьСводнуюТаблицуНаКлиенте(ОбрабатываемыеДокументы, "Свойства", ГруппируемыеКолонки, СуммируемыеКолонки);
	
КонецФункции //Функция СвойстваЗаполнитьНаКлиенте(ОбрабатываемыеДокументы) Экспорт


&НаКлиенте
Процедура СформироватьСводнуюТаблицуНаКлиенте(ОбрабатываемыеДокументы, НаименованиеТаблицы, ГруппируемыеКолонки, СуммируемыеКолонки)
	
	//
	НаименованиеВременнойТаблицы	= "ВТ_" + НаименованиеТаблицы;
	ПолноеНаименованиеТаблицы		= "ТабличнаяЧасть" + НаименованиеТаблицы;
	
	//
	СведениеТабличнойЧасти.Очистить();
	
	//	Собираем сводную таблицу. Для каждой позиции.
	Для Каждого СтрокаОписаниеДокумента Из ОбрабатываемыеДокументы Цикл
		Если СтрокаОписаниеДокумента.СтатусРедактирования = 2 Тогда
			Продолжить;
		КонецЕсли;
		НайденныеЗначенияТаблицы	= ЭтаФорма[НаименованиеВременнойТаблицы].НайтиСтроки(Новый Структура("Позиция", СтрокаОписаниеДокумента["СсылкаНаОбъект"]));
		
		//	Значения табличной части. Для конкретной позиции.
		Для Каждого Строка Из НайденныеЗначенияТаблицы Цикл
			
			//	Группируемые колонки.
			ПараметрыПоиска	= Новый Структура();
			Для Каждого Значение Из ГруппируемыеКолонки Цикл
				ПараметрыПоиска.Вставить(Значение, Строка[Значение]);
			КонецЦикла;
			
			//	Получим ранее добавленную строку или убедимся, что таких строк еще нет.
			НайденныеСтроки	= ЭтаФорма[ПолноеНаименованиеТаблицы].НайтиСтроки(ПараметрыПоиска);
			
			//	Свести.
			Если НайденныеСтроки.Количество() Тогда
				
				Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					
					//	Суммируемые колонки. Сложить значения.
					Для Каждого КлючИЗначение Из СуммируемыеКолонки Цикл
						
						//	Описание обработки колонки.
						ОписаниеКолонки	= ПолучитьОписаниеКолонкиНаКлиенте(КлючИЗначение.Значение);
						
						//	Обработка функции.
						Если ОписаниеКолонки["Функция"] = "СУММА" Тогда
							НайденнаяСтрока[КлючИЗначение.Ключ]	= СводнаяТаблицаФункцияСуммаНаКлиенте(ОписаниеКолонки, НайденнаяСтрока[КлючИЗначение.Ключ], Строка[КлючИЗначение.Ключ]);	
						ИначеЕсли ОписаниеКолонки["Функция"] = "СРАВНЕНИЕ" Тогда
							НайденнаяСтрока[КлючИЗначение.Ключ]	= СводнаяТаблицаФункцияСравнениеНаКлиенте(ОписаниеКолонки, НайденнаяСтрока[КлючИЗначение.Ключ], Строка[КлючИЗначение.Ключ]);	
						ИначеЕсли ОписаниеКолонки["Функция"] = "СРЕДНЕЕ" Тогда
							НайденнаяСтрока[КлючИЗначение.Ключ]	= СводнаяТаблицаФункцияСреднееНаКлиенте(ОписаниеКолонки, НайденнаяСтрока[КлючИЗначение.Ключ], Строка[КлючИЗначение.Ключ]);
						КонецЕсли;
						
					КонецЦикла;
					
					//	Количество сложенных значений. Имитация функции запроса (СРЕДНЕЕ).
					ВспомогательнаяТаблицаЗначенийВставить(НайденнаяСтрока);
				
				КонецЦикла;
				
			Иначе
				
				//	Добавить строку.
				ТабличнаяЧастьСтрока	= ЭтаФорма[ПолноеНаименованиеТаблицы].Добавить();
				ЗаполнитьЗначенияСвойств(ТабличнаяЧастьСтрока, Строка);
				
				//	Количество сложенных значений. Имитация функции запроса (СРЕДНЕЕ).
				ВспомогательнаяТаблицаЗначенийВставить(ТабличнаяЧастьСтрока);
			
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	//	Вычисление формул, имитировавших функции группировки запроса.
	Для Каждого Строка Из СведениеТабличнойЧасти Цикл
		Для Каждого КлючИЗначение Из СуммируемыеКолонки Цикл
			Если КлючИЗначение.Значение = "СРЕДНЕЕ" Тогда
				
				ТабличнаяЧастьСтрока	= ЭтаФорма[ПолноеНаименованиеТаблицы].НайтиПоИдентификатору(Строка.Строка);
				
				ТабличнаяЧастьСтрока[КлючИЗначение.Ключ]	= ТабличнаяЧастьСтрока[КлючИЗначение.Ключ] / Строка.Количество;
				
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	
КонецПроцедуры //Процедура СформироватьСводнуюТаблицуНаКлиенте(ОбрабатываемыеДокументы, НаименованиеТаблицы, ГруппируемыеКолонки, СуммируемыеКолонки)

&НаКлиенте
Функция СводнаяТаблицаФункцияСуммаНаКлиенте(ОписаниеКолонки, Значение1, Значение2)
	
	//	Проверка на правильность типа значения.
	Если НЕ ТипЗнч(Значение1) = Тип("Число") Тогда
		Возврат "Ошибка! Значение1";		
	КонецЕсли;
	Если НЕ ТипЗнч(Значение2) = Тип("Число") Тогда
		Возврат "Ошибка! Значение2";		
	КонецЕсли;
	
	//
	Возврат Значение1 + Значение2;
	

КонецФункции //Функция СводнаяТаблицаФункцияСуммаНаКлиенте(ОписаниеКолонки, Значение1, Значение2)

&НаКлиенте
Функция СводнаяТаблицаФункцияСравнениеНаКлиенте(ОписаниеКолонки, Значение1, Значение2)
	
	//
	Если Значение1 = Значение2 Тогда
		Возврат Значение1;
	Иначе
		Возврат ОписаниеКолонки["ЗначениеНеравенства"];
	КонецЕсли;
	
КонецФункции //Функция СводнаяТаблицаФункцияСравнениеНаКлиенте(ОписаниеКолонки, Значение1, Значение2)

&НаКлиенте
Функция СводнаяТаблицаФункцияСреднееНаКлиенте(ОписаниеКолонки, Значение1, Значение2)
	
	//	Проверка на правильность типа значения.
	Если НЕ ТипЗнч(Значение1) = Тип("Число") Тогда
		Возврат "Ошибка! Значение1";		
	КонецЕсли;
	Если НЕ ТипЗнч(Значение2) = Тип("Число") Тогда
		Возврат "Ошибка! Значение2";		
	КонецЕсли;
	
	//
	Возврат Значение1 + Значение2;
	
КонецФункции //Функция СводнаяТаблицаФункцияСреднееНаКлиенте(ОписаниеКолонки, Значение1, Значение2)

&НаКлиенте
Функция ПолучитьОписаниеКолонкиНаКлиенте(ОписаниеКолонки)
	
	//
	Если ТипЗнч(ОписаниеКолонки) = Тип("Структура") Тогда
		Структура	= ОписаниеКолонки;
	Иначе
		Структура	= Новый Структура;
	КонецЕсли;
	
	//	Функция
	Если НЕ Структура.Свойство("Функция") Тогда
		Структура.Вставить("Функция", "СУММА");
	КонецЕсли;
	
	//	Значение неравенства
	Если НЕ Структура.Свойство("ЗначениеНеравенства") Тогда
		Структура.Вставить("ЗначениеНеравенства", "разн. знч.");
	КонецЕсли;
	
	//
	Возврат Структура;
	
КонецФункции //Функция ПолучитьОписаниеКолонкиНаКлиенте(ОписаниеКолонки)

&НаКлиенте
Функция ВспомогательнаяТаблицаЗначенийВставить(ТабличнаяЧастьСтрока)
	
	//
	ИдентификаторСтроки	= ТабличнаяЧастьСтрока.ПолучитьИдентификатор();
	НайденныеСтроки		= СведениеТабличнойЧасти.НайтиСтроки(Новый Структура("Строка", ИдентификаторСтроки));
	
	Если НЕ НайденныеСтроки.Количество() Тогда
		
		Строка	= СведениеТабличнойЧасти.Добавить();
		Строка.Строка		= ИдентификаторСтроки;
		Строка.Количество	= 1;
		
	Иначе
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.Количество	= НайденнаяСтрока.Количество + 1;	
		КонецЦикла;
		
	КонецЕсли;
	
	//	Обрабатываемая строка.
	Если НайденнаяСтрока = Неопределено Тогда
		ВозвращаемоеЗначение	= Строка;
	Иначе
		ВозвращаемоеЗначение	= НайденнаяСтрока;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

&НаКлиенте
Процедура СформироватьТаблицуДополнительныеРеквизитыНаКлиенте(НаименованиеТаблицы)
	
	//
	ПолноеНаименованиеТаблицы		= "ВТ_" + НаименованиеТаблицы;
	ОбрабатываемыеЛокальныеСметы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ЛокальнаяСмета")), Истина));
	ОбрабатываемыеРазделы			= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")), Истина));
	ОбрабатываемыеПозиции			= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	
	//
	Для Каждого Строка Из ЭтаФорма[ПолноеНаименованиеТаблицы] Цикл
		
		//
		Если ОбрабатываемыеЛокальныеСметы.Количество()
			И Строка.ИмяПредопределенныхДанных = "Документ_СМ_ЛокальнаяСмета"
			ИЛИ ОбрабатываемыеРазделы.Количество()
			И Строка.ИмяПредопределенныхДанных = "Документ_СМ_РазделЛокальнойСметы"
			ИЛИ ОбрабатываемыеПозиции.Количество()
			И Строка.ИмяПредопределенныхДанных = "Документ_СМ_ПозицияЛокальнойСметы" Тогда
			
			//
			ТабличнаяЧастьСтрока	= ТабличнаяЧастьСвойства.Добавить();
			ЗаполнитьЗначенияСвойств(ТабличнаяЧастьСтрока, Строка);
		
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти //#Область ВспомогательныеФункции/#Область ТаблицыЗначений

#КонецОбласти //#Область ТаблицыЗначений

//	Формируем списки отмеченных элементов.
#Область ОбрабатываемыеЭлементы

//	Drug & Drop. Выделенные элементы (при переносе, копировании и т.д.).

// Получаем все отмеченные элементы дерева - ссылки на документы - и помещаем в массив.
//
&НаСервере
Функция ПеребратьИдентификаторыНаСервереБезКонтекста(Идентификаторы, ПараметрыОбработки)
	
	//	Раскидываем дерево значений, на списки, по типам документов КоллекцияСтрокДереваЗначений.
	Для Каждого ИдентификаторСтроки Из Идентификаторы Цикл
		
		//
		СтрокаДерева	= ЭлементыДеревоЗначений.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		// Нужно, для проверки доступности обработки команды.
		// ПараметрыОбработкиДобавитьВладелецНаСервере(СтрокаДерева, ПараметрыОбработки);
			
		// Запоминаем выбранные элементы (исключаем дубли).
		ОбрабатываемыеЭлементыДобавитьНаСервере(СтрокаДерева, ПараметрыОбработки);
		
		// Получить связанные позиции (здесь предполагаем, что у позиции всегда есть родитель - "раздел").
		Если СтрокаДерева.Связанная Тогда
			ОбрабатываемыеЭлементыДобавитьСвязанныеНаСервере(СтрокаДерева.Родитель.Строки, Ложь, ПараметрыОбработки);
		КонецЕсли;
		
		// Получить все вложенные узлы.
		// ОбрабатываемыеЭлементыДобавитьНаСервере(СтрокаДерева);
		
	КонецЦикла;	
		
	//
	Возврат Истина;
	
КонецФункции //Функция ПеребратьИдентификаторыНаСервереБезКонтекста(СтрокиДерева, Идентификаторы, ПараметрыОбработки = Неопределено)	

//	Отмеченные элементы (Пометка = Истина).

// Вычисляет отмеченные элементы дерева значений и устанавливает параметры формы.
//
&НаКлиенте
Процедура ОтобратьОтмеченныеЭлементыНаКлиенте(ПараметрыОбработки = Неопределено, ПараметрыКоманды = Неопределено)
	
	//
	СформироватьПараметрыОбработкиНаКлиенте(ПараметрыОбработки);
	
	//	Отметить элементы дерева (находяться в отдельной таблице).
	ОбрабатываемыеЭлементыОтобратьНаКлиенте(ЭлементыДеревоЗначений, ПараметрыОбработки, ПараметрыКоманды);
	
	//	УчастиеВладелец. Отметить элементы дерева.
	Для Каждого ЭлементМассива Из ПараметрыОбработки["ВладельцыСводныеСметы"] Цикл
		
		ОбрабатываемыйЭлемент	= ОбрабатываемыеЭлементы.НайтиПоИдентификатору(ЭлементМассива["СтрокаДерева"].Идентификатор);
		
		Если НЕ ОбрабатываемыйЭлемент = Неопределено Тогда
			ОбрабатываемыйЭлемент.УчастиеВладелец	= Истина;
		КонецЕсли;
	
	КонецЦикла;
	
	Для Каждого ЭлементМассива Из ПараметрыОбработки["ВладельцыОбъектныеСметы"] Цикл
		
		ОбрабатываемыйЭлемент	= ОбрабатываемыеЭлементы.НайтиПоИдентификатору(ЭлементМассива["СтрокаДерева"].Идентификатор);
		
		Если НЕ ОбрабатываемыйЭлемент = Неопределено Тогда
			ОбрабатываемыйЭлемент.УчастиеВладелец	= Истина;
		КонецЕсли;
	
	КонецЦикла;
	
	Для Каждого ЭлементМассива Из ПараметрыОбработки["ВладельцыЛокальныеСметы"] Цикл
		
		ОбрабатываемыйЭлемент	= ОбрабатываемыеЭлементы.НайтиПоИдентификатору(ЭлементМассива["СтрокаДерева"].Идентификатор);
		
		Если НЕ ОбрабатываемыйЭлемент = Неопределено Тогда
			ОбрабатываемыйЭлемент.УчастиеВладелец	= Истина;
		КонецЕсли;
	
	КонецЦикла;
	
	Для Каждого ЭлементМассива Из ПараметрыОбработки["ВладельцыРазделы"] Цикл
		
		ОбрабатываемыйЭлемент	= ОбрабатываемыеЭлементы.НайтиПоИдентификатору(ЭлементМассива["СтрокаДерева"].Идентификатор);
		
		Если НЕ ОбрабатываемыйЭлемент = Неопределено Тогда
			ОбрабатываемыйЭлемент.УчастиеВладелец	= Истина;
		КонецЕсли;
	
	КонецЦикла;

	//	ПАРАМЕТРЫ
	УстановитьПараметрыОбрабатываемыеЭлементыНаКлиенте(ПараметрыОбработки);
	
КонецПроцедуры //Процедура ОтобратьОтмеченныеЭлементыНаКлиенте(ПараметрыОбработки = Неопределено)

// Раскидываем дерево значений, на списки, по типам документов.
//
&НаКлиенте
Функция ОбрабатываемыеЭлементыОтобратьНаКлиенте(ЭлементДерева, ПараметрыОбработки = Неопределено, ПараметрыКоманды = Неопределено)
	
	//	1. Пометка
	//	2. Родитель
	//	3. Владелец
	
	//
	Для Каждого СтрокаДерева Из ЭлементДерева.ПолучитьЭлементы() Цикл
		
		//
		ОбрабатываемыйЭлемент	= ОбрабатываемыеЭлементы.НайтиПоИдентификатору(СтрокаДерева.Идентификатор);	
		
		Если ОбрабатываемыйЭлемент = Неопределено Тогда
			//	рекурсия
			ОбрабатываемыеЭлементыОтобратьНаКлиенте(СтрокаДерева,,ПараметрыКоманды);
			Продолжить;	
		КонецЕсли;
		
		//	УчастиеПометка
		Если СтрНайти(ВРег(Действие),"РАСЧЕТ")>0 Тогда
			ОбрабатываемыйЭлемент.УчастиеПометка		= (СтрокаДерева.Пометка = 1);	
		Иначе
			ОбрабатываемыйЭлемент.УчастиеПометка		= (СтрокаДерева.Пометка = 1 И (Не ОбрабатываемыйЭлемент.СтатусРедактирования = 2 ИЛИ Действие = "Копировать"));	
		КонецЕсли;
		
		Перенос = Ложь;
		Если Не ПараметрыКоманды = Неопределено Тогда
			Если ВРег(ПараметрыКоманды.Действие) = "ПЕРЕНЕСТИ" Тогда
				Перенос = Истина;
			КонецЕсли;
			Если Перенос
				И Не ТипЗнч(ОбрабатываемыйЭлемент.СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")
				И Не ТипЗнч(ОбрабатываемыйЭлемент.СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
				ОбрабатываемыйЭлемент.УчастиеПометка = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		//	УчастиеРодитель. Нужно, для перерасчета.
		Если ЕстьОтмеченныеНаКлиенте(СтрокаДерева.ПолучитьЭлементы()) Тогда
			ОбрабатываемыйЭлемент.УчастиеРодитель	= Истина;	
		КонецЕсли;
				
		//	УчастиеВладелец. Нужно, для проверки доступности обработки команды.
		Если ОбрабатываемыйЭлемент.УчастиеПометка И НЕ Перенос Тогда
			ПараметрыОбработкиДобавитьВладелецНаКлиенте(СтрокаДерева, ПараметрыОбработки);
		КонецЕсли;
		
		//	рекурсия
		ОбрабатываемыеЭлементыОтобратьНаКлиенте(СтрокаДерева, ПараметрыОбработки,ПараметрыКоманды);
		
	КонецЦикла;
	
КонецФункции //Функция ОбрабатываемыеЭлементыОтобратьНаКлиенте(ЭлементДерева, ПараметрыОбработки = Неопределено)	


&НаСервере
Процедура ОбрабатываемыеЭлементыСформироватьНаСервере(Идентификаторы = Неопределено, ПараметрыОбработки = Неопределено)
	
	//	Очистить. Очистить таблицы значений "Обрабатываемые...".
	ОбрабатываемыеЭлементы.Очистить();
	
	//	ОбрабатываемыеЭлементы (сформировать таблицы значений, либо отмеченные, либо выделенные).
	Если НЕ Идентификаторы = Неопределено Тогда
		ПеребратьИдентификаторыНаСервереБезКонтекста(Идентификаторы, ПараметрыОбработки);
	Иначе
		ОбрабатываемыеЭлементыДобавитьНаСервере(ЭлементыДеревоЗначений, ПараметрыОбработки);
	КонецЕсли;
	
КонецПроцедуры //Процедура ОбрабатываемыеЭлементыСформироватьНаСервере(Идентификаторы = Неопределено, ПараметрыОбработки = Неопределено)

// Получаем все элементы дерева - ссылки на документы - и помещаем в таблицу значений.
//
&НаСервере
Функция ОбрабатываемыеЭлементыДобавитьНаСервере(СтрокаДерева1, ПараметрыОбработки = Неопределено)
	
	// Раскидываем дерево значений, на списки, по типам документов.
	// Заполним структуру параметров, выбранными элементами.
	Для Каждого СтрокаДерева2 Из СтрокаДерева1.ПолучитьЭлементы() Цикл
		
		//	Запоминаем элементы (исключаем дубли).
		ОбрабатываемыеЭлементыВставитьНаСервере(СтрокаДерева2);
			
		//	рекурсия
		ОбрабатываемыеЭлементыДобавитьНаСервере(СтрокаДерева2, ПараметрыОбработки);
		
	КонецЦикла;	
		
	//
	Возврат Истина;
	
КонецФункции //Функция ОбрабатываемыеЭлементыДобавитьНаСервере(СтрокаДерева1, ПараметрыОбработки = Неопределено)	


//	Сформировать параметры обработки.

&НаКлиенте
Функция ПараметрыОбработкиДобавитьВладелецНаКлиенте(СтрокаДерева, ПараметрыОбработки)
	
	Если НЕ СтрокаДерева.ПринадлежитСводнойСмете = ПредопределенноеЗначение("Документ.СМ_СводнаяСмета.ПустаяСсылка")
		И ПараметрыОбработкиВладельцыНайтиНаКлиенте(ПараметрыОбработки["ВладельцыСводныеСметы"], СтруктураВладельцыНаКлиенте(СтрокаДерева.ПринадлежитСводнойСмете, СтрокаДерева)) = Неопределено Тогда
		ПараметрыОбработки["ВладельцыСводныеСметы"].Добавить(СтруктураВладельцыНаКлиенте(СтрокаДерева.ПринадлежитСводнойСмете, СтрокаДерева));
	КонецЕсли;
	
	Если НЕ СтрокаДерева.ПринадлежитОбъектнойСмете = ПредопределенноеЗначение("Документ.СМ_ОбъектнаяСмета.ПустаяСсылка")
		И ПараметрыОбработкиВладельцыНайтиНаКлиенте(ПараметрыОбработки["ВладельцыОбъектныеСметы"], СтруктураВладельцыНаКлиенте(СтрокаДерева.ПринадлежитОбъектнойСмете, СтрокаДерева)) = Неопределено Тогда
		ПараметрыОбработки["ВладельцыОбъектныеСметы"].Добавить(СтруктураВладельцыНаКлиенте(СтрокаДерева.ПринадлежитОбъектнойСмете, СтрокаДерева));
	КонецЕсли;

	Если НЕ СтрокаДерева.ПринадлежитЛокальнойСмете = ПредопределенноеЗначение("Документ.СМ_ЛокальнаяСмета.ПустаяСсылка")
		И ПараметрыОбработкиВладельцыНайтиНаКлиенте(ПараметрыОбработки["ВладельцыЛокальныеСметы"], СтруктураВладельцыНаКлиенте(СтрокаДерева.ПринадлежитЛокальнойСмете, СтрокаДерева)) = Неопределено Тогда
		ПараметрыОбработки["ВладельцыЛокальныеСметы"].Добавить(СтруктураВладельцыНаКлиенте(СтрокаДерева.ПринадлежитЛокальнойСмете, СтрокаДерева));
	КонецЕсли;

	Если НЕ СтрокаДерева.ПринадлежитРазделу = ПредопределенноеЗначение("Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка")
		И ПараметрыОбработкиВладельцыНайтиНаКлиенте(ПараметрыОбработки["ВладельцыРазделы"], СтруктураВладельцыНаКлиенте(СтрокаДерева.ПринадлежитРазделу, СтрокаДерева)) = Неопределено Тогда
		ПараметрыОбработки["ВладельцыРазделы"].Добавить(СтруктураВладельцыНаКлиенте(СтрокаДерева.ПринадлежитРазделу, СтрокаДерева));
	КонецЕсли;
		
КонецФункции //Функция ПараметрыОбработкиДобавитьВладелецНаКлиенте(СтрокаДерева, ПараметрыОбработки)

&НаКлиенте
Функция ПараметрыОбработкиВладельцыНайтиНаКлиенте(Массив, Значение)
		
	//
	Для Каждого ЭлементМассива Из Массив Цикл
		
		//
		Если ЭлементМассива["СсылкаНаОбъект"] = Значение["СсылкаНаОбъект"] Тогда
			Возврат ЭлементМассива;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции //Функция ПараметрыОбработкиВладельцыНайтиНаКлиенте(Массив)

&НаКлиенте
Функция ЕстьОтмеченныеНаКлиенте(СтрокиДерева)
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		Если Булево(СтрокаДерева.Пометка = 1) Тогда
			Возврат Истина;
			Прервать;
		КонецЕсли;
		
		Если ЕстьОтмеченныеНаКлиенте(СтрокаДерева.ПолучитьЭлементы()) Тогда
			Возврат Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции //Функция ЕстьОтмеченныеНаКлиенте(СтрокиДерева)

// Обработать таблицы значений "Обрабатываемые...".

//
//
&НаСервере
Функция ОбрабатываемыеЭлементыДобавитьСвязанныеНаСервере(СтрокиДерева, ТолькоОтмеченные = Истина, ПараметрыОбработки = Неопределено)
	
	// Заполним структуру "ОбъектыДляОперации"
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		// Раскидываем дерево значений, на списки, по типам документов
		Если НЕ ТолькоОтмеченные
			ИЛИ ТолькоОтмеченные И Булево(СтрокаДерева.Пометка = 1) Тогда
			
			// Нужно, для проверки доступности обработки команды.
			// ПараметрыОбработкиДобавитьВладелецНаСервере(СтрокаДерева, ПараметрыОбработки);
			
			// Предполагаем, что связанные бывают, только позиции, остальные игнорируем.
			Если СтрокаДерева.Связанная Тогда
				Если ОбрабатываемыеЭлементы.Найти(СтрокаДерева.Элемент) = Неопределено Тогда
					ОбрабатываемыеЭлементыДобавитьСтрокуНаСервереБезКонтекста(ОбрабатываемыеЭлементы, СтрокаДерева.Элемент);
				КонецЕсли;		
			КонецЕсли;

		КонецЕсли;		
		
	КонецЦикла;	
		
	//
	Возврат Истина;
	
КонецФункции //Функция ОбрабатываемыеЭлементыДобавитьСвязанныеНаСервере(СтрокиДерева, ТолькоОтмеченные = Истина, ПараметрыОбработки = Неопределено)	

&НаСервере
Функция ОбрабатываемыеЭлементыВставитьНаСервере(СтрокаДерева, Участие = "УчастиеПометка")
	
	// Нужно, что бы назначить первому элементу родитель = "Неопределено",
	// для возможности, рекурсивного обхода элементов, при копировании.
	Если ОбрабатываемРодительскийЭлементНаСервере(СтрокаДерева["Элемент"]) Тогда
		ЭтоПервыйЭлементВетки	= Истина;	
	Иначе
		ЭтоПервыйЭлементВетки	= Ложь;	
	КонецЕсли;
	
	//
	НайденныеСтроки	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("СсылкаНаОбъект", СтрокаДерева.Элемент));
	
	Если НайденныеСтроки.Количество() Тогда
		Для Каждого Строка Из НайденныеСтроки Цикл
			
			ЗначенияЗаполнения = Новый Структура(Участие, Истина);	
			
			ОбрабатываемыеЭлементыЗаполнитьСтрокуНаСервереБезКонтекста(ОбрабатываемыеЭлементы, Строка, ЗначенияЗаполнения);
			
		КонецЦикла;
	Иначе
		
		//
		ЭлементКоллекции	= ОбрабатываемыеЭлементыДобавитьСтрокуНаСервереБезКонтекста(ОбрабатываемыеЭлементы, СтрокаДерева, ЭтоПервыйЭлементВетки, Участие = "УчастиеРодитель", Участие = "УчастиеПометка", Участие = "УчастиеВладелец", Участие = "УчастиеПриемник");
		
		//
		СтрокаДерева.Идентификатор	= ЭлементКоллекции.ПолучитьИдентификатор();
			
	КонецЕсли;
	
	//	Сортировать НайтиПоИдентификатору
	ОбрабатываемыеЭлементы.Сортировать("Уровень Убыв");
		
КонецФункции //Функция ОбрабатываемыеЭлементыВставитьНаСервере(СтрокаДерева, Участие = "УчастиеПометка")

&НаСервереБезКонтекста
Функция ОбрабатываемыеЭлементыДобавитьСтрокуНаСервереБезКонтекста(ТаблицаЗначений, СтрокаДерева, ЭтоПервыйЭлементВетки = Ложь, УчастиеРодитель = Ложь, УчастиеПометка = Ложь, УчастиеВладелец = Ложь, УчастиеПриемник = Ложь)
	
	//
	Если ТипЗнч(СтрокаДерева.Элемент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
		ИЛИ ТипЗнч(СтрокаДерева.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		ЛокальнаяСмета	= СтрокаДерева.Элемент.ИДСметы;	
	Иначе
		ЛокальнаяСмета	= Неопределено;	
	КонецЕсли;
	
	//
	Если ЭтоПервыйЭлементВетки Тогда
		Родитель	= Неопределено;
	Иначе
		Родитель	= СтрокаДерева.Элемент.ИДРодителя;
	КонецЕсли;
	
	//
	Строка	= ТаблицаЗначений.Добавить();
	Строка["Тип"]				= Строка(ТипЗнч(СтрокаДерева["Элемент"]));
	Строка["ЛокальнаяСмета"]	= ЛокальнаяСмета;
	Строка["Родитель"]			= Родитель;
	Строка["СсылкаНаОбъект"]	= СтрокаДерева.Элемент;
	Строка["Копия"]				= Неопределено;
	Строка["Идентификатор"]		= ?(ТипЗнч(СтрокаДерева)=Тип("СтрокаДереваЗначений"),СтрокаДерева.Идентификатор,СтрокаДерева.ПолучитьИдентификатор());
	Строка["Уровень"]			= СтрокаДерева.Уровень;
	Строка["Параметры"]			= СтрокаДерева.Параметры;
	Строка["УчастиеРодитель"]	= УчастиеРодитель;
	Строка["УчастиеПометка"]	= УчастиеПометка;
	Строка["УчастиеВладелец"]	= УчастиеВладелец;
	Строка["УчастиеПриемник"]	= УчастиеПриемник;
	Строка["ОбъемВсего"]	    = СтрокаДерева.ОбъемВсего;
	Строка["СтатусРедактирования"]  = СтрокаДерева.СтатусРедактирования;
	Возврат Строка;
	
КонецФункции //Функция ОбрабатываемыеЭлементыДобавитьСтрокуНаСервереБезКонтекста(ТаблицаЗначений, СтрокаДерева, ЭтоПервыйЭлементВетки = Ложь, УчастиеРодитель = Ложь, УчастиеПометка = Ложь, УчастиеВладелец = Ложь)

&НаСервереБезКонтекста
Функция ОбрабатываемыеЭлементыЗаполнитьСтрокуНаСервереБезКонтекста(ТаблицаЗначений, Строка, ЗначенияЗаполнения)
	
	//
	Для Каждого КлючИЗначение Из ЗначенияЗаполнения Цикл
		
		Если Строка.Свойство(КлючИЗначение.Ключ) Тогда
			Строка[КлючИЗначение.Ключ]	= КлючИЗначение.Значение;	
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Строка;

КонецФункции //Функция ОбрабатываемыеЭлементыЗаполнитьСтрокуНаСервереБезКонтекста(ТаблицаЗначений, Строка, ЗначенияЗаполнения)


&НаСервере
Функция ОбрабатываемыеЭлементыДобавитьПриемникНаСервере(ЭлементПриемник)
	
	//	рекурсия
	ПараметрыОбработки	= Новый Структура("Функция, Прервать, ЭлементПриемник", "ЭлементыДеревоЗначенийНайтиНаСервере", Ложь, ЭлементПриемник);
	СтрокаДерева		= ЭлементыДеревоЗначенийРекурсияНаСервере(ЭлементыДеревоЗначений, ПараметрыОбработки);
	
	//	рекурсия
	ПараметрыОбработки	= Новый Структура("Функция, Прервать, ЭлементПриемник", "ОбрабатываемыеЭлементыДобавитьПриемникВставитьНаСервере", Ложь, ЭлементПриемник);
	ЭлементыДеревоЗначенийРекурсияНаСервере(СтрокаДерева, ПараметрыОбработки);
	
	//	рекурсия
	ПараметрыОбработки	= Новый Структура("Функция, ЭлементПриемник", "ОбрабатываемыеЭлементыДобавитьПриемникВставитьНаСервере", ЭлементПриемник);
	ЭлементыДеревоЗначенийПоднятьсяНаСервере(СтрокаДерева, ПараметрыОбработки);
	
КонецФункции //Функция ОбрабатываемыеЭлементыДобавитьПриемникНаСервере(ЭлементПриемник)

&НаСервере
Функция ОбрабатываемыеЭлементыДобавитьПриемникВставитьНаСервере(СтрокаДерева, ПараметрыОбработки)
	
	//
	ОбрабатываемыеЭлементыВставитьНаСервере(СтрокаДерева, "УчастиеПриемник");
	
	Возврат СтрокаДерева;
	
КонецФункции //Функция ОбрабатываемыеЭлементыДобавитьПриемникВставитьНаСервере(СтрокаДерева, ПараметрыОбработки)

&НаСервере
Функция ЭлементыДеревоЗначенийНайтиНаСервере(СтрокаДерева, ПараметрыОбработки)
	
	//
	Если СтрокаДерева["Элемент"] = ПараметрыОбработки["ЭлементПриемник"] Тогда
		ПараметрыОбработки["Прервать"]	= Истина;	
