Процедура РАСЦЕНКИ_ЛС_Перенести(Команда, ВыполнитьКоманду = Ложь)
	
	//	устанавливаем и проверяем возможность установки, "действие" - реквизит на форме
	Если НЕ ВыполнитьКоманду Тогда
		ДоступнаСменаКомандыВопросНаКлиенте(Команда);
		Возврат;
	КонецЕсли;
	
	//
	Если НЕ СМ_ДоступнаОбработкаЛокальнаяСметаНаКлиенте(Команда) Тогда
		Возврат;
	КонецЕсли;
	
	//
	ОписаниеОповещения	= Новый ОписаниеОповещения("КомандаРасценкиПеренестиОповещениеНаКлиенте", ЭтаФорма, Новый Структура("ТекущаяСмета, КомандаИмя", Документ, Команда.Имя));
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ВключатьРазделы",Истина);
//	СтруктураОтбора.Вставить("АктивныйЭлемент",Документ); 
	СтруктураОтбора.Вставить("БезАктов", Истина);
	СтруктураОтбора.Вставить("ОтборСтройка",Истина);
	СтруктураОтбора.Вставить("ВключатьОС",Истина);
	СтруктураОтбора.Вставить("ВключатьСС",Истина);
	
	Если ЗначениеЗаполнено(ЭтаФорма.Стройка) Тогда
		СтруктураОтбора.Вставить("Стройка",ЭтаФорма.Стройка);
	КонецЕсли;
	
	ОткрытьФорму("Обработка.СМ_ДеревоСметПростое.Форма",СтруктураОтбора,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

