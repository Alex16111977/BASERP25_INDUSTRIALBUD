	Если НайденнаяКоманда = Неопределено Тогда
		Возврат "";
	Иначе
		Возврат НайденнаяКоманда[0][Свойство];
	КонецЕсли;
		
КонецФункции //Функция ПолучитьСвойствоКомандыДействиеНаКлиенте(КомандаИмя, Свойство)

