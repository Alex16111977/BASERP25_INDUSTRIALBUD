	//
	ОбрабатываемыеЛокальныеСметы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип,УчастиеРодитель", Строка(Тип("ДокументСсылка.СМ_ЛокальнаяСмета")),Истина));
	ОбрабатываемыеРазделы			= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип,УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")),Истина));
	ОбрабатываемыеПозиции			= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип,УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")),Истина));
		
	//
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		СМ_СметаВызовСервера.УдалитьДвижения(СсылкаНаОбъект);
		Документы.СМ_АктВыполненныхРабот.Перерасчет(СсылкаНаОбъект, Ложь);
		Возврат;
	КонецЕсли;
	
	//	Перерасчет позиций.
	Для Каждого Строка Из ОбрабатываемыеПозиции Цикл
		
		Если Перенос И Строка.УчастиеПометка Тогда
			СМ_СметаВызовСервера.УдалитьДвижения(Строка["СсылкаНаОбъект"]);
		КонецЕсли;
		
		Документы.СМ_ПозицияЛокальнойСметы.Перерасчет(Строка["СсылкаНаОбъект"], Истина);
		
	КонецЦикла;
	
	//	Перерасчет разделов, иерархически.
	Для Каждого Строка Из ОбрабатываемыеРазделы Цикл
		
		Если Перенос Тогда
			СМ_СметаВызовСервера.УдалитьДвижения(Строка["СсылкаНаОбъект"]);
		КонецЕсли;
		
		Документы.СМ_РазделЛокальнойСметы.Перерасчет(Строка["СсылкаНаОбъект"], Истина, Истина);
		
	КонецЦикла;
	
	//	Перерасчет локальных смет.
	Для Каждого Строка Из ОбрабатываемыеЛокальныеСметы Цикл
		
		Если Перенос Тогда
			СМ_СметаВызовСервера.УдалитьДвижения(Строка["СсылкаНаОбъект"]);
		КонецЕсли;   
		
		Документы.СМ_ЛокальнаяСмета.Перерасчет(Строка["СсылкаНаОбъект"], Истина);	
		
	КонецЦикла;	
	
КонецПроцедуры //Процедура ДокументПерерасчетНаСервере(СсылкаНаОбъект = Неопределено)

// Присваивает порядковый номер объекту текущей строки.
//
Процедура ПрисвоитьНомерОбъекту(Объект, счетчикНомер, счетчикПорНомер)

	Если НЕ Объект = Неопределено
		И (	ТипЗнч(Объект) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
			ИЛИ ТипЗнч(Объект) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")) Тогда
		
		ПрисваиваемыйПорНомер	= ?(Объект.Расчет,счетчикПорНомер,0);
		ПрисваиваемыйНомер		= счетчикНомер;
		
		Если НЕ Объект.ПорНомер = ПрисваиваемыйПорНомер
			ИЛИ НЕ Объект.НомерВПределахСметы = ПрисваиваемыйНомер
			ИЛИ НЕ Объект.НомерВДереве = ПрисваиваемыйНомер Тогда
			
			Объект.НомерВПределахСметы	= ПрисваиваемыйНомер;
			Объект.ПорНомер				= ПрисваиваемыйПорНомер;
			Объект.НомерВДереве			= ПрисваиваемыйНомер;
			Объект.Записать(?(Объект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
			
		КонецЕсли;
		
		счетчикНомер = счетчикНомер + 1; 
		Если Объект.Расчет Тогда 
			счетчикПорНомер = счетчикПорНомер + 1;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти //#Область ДокументМенеджерФункциии

#Область УстановитьПометка

// Устанавливаем либо снимаем пометки у всех строк СтрокиДерева.
//
&НаКлиенте
Процедура УстановитьСнятьПометкаНаКлиенте(СтрокаДерева, Знач Пометка)
	
	// Свойство "Связанная" - может иметь, как владелец, так и подчиненная позиция.
	// Если отмечаем владельца, значит отмечаем все связанные.
	Если СтрокаДерева.Связанная
		И НЕ ЗначениеЗаполнено(СтрокаДерева.СвязаннаяВладелец) Тогда
		УстановитьСнятьПометкаСвязанныеНаКлиенте(СтрокаДерева, Пометка);
	КонецЕсли;
	
	// Устанавливаем отметку детей
	УстановитьСнятьПометкаРебенокНаКлиенте(СтрокаДерева.ПолучитьЭлементы(), Пометка);
	
	// Устанавливаем отметку родителей
	УстановитьСнятьПометкаРодительНаКлиенте(СтрокаДерева, Пометка);
	
	// Отмечаем 
	УстановитьСнятьПометкаКорневойЭлементНаКлиенте(ЭлементыДеревоЗначений.ПолучитьЭлементы());
	
КонецПроцедуры //Процедура УстановитьСнятьПометкаНаКлиенте(СтрокаДерева, Пометка)	

// Устанавливаем либо снимаем пометки у всех родителей строки СтрокиДерева.
//
&НаКлиенте
Процедура УстановитьСнятьПометкаРебенокНаКлиенте(СтрокиДерева, Пометка)
	
	Для Каждого Строка Из СтрокиДерева Цикл
		
		// Если НЕ Строка.Доступность тогда
		//	Продолжить;
		// КонецЕсли;
			
		//
		Строка.Пометка = Пометка;
	
		//	рекурсия
		УстановитьСнятьПометкаРебенокНаКлиенте(Строка.ПолучитьЭлементы(), Пометка);
		
	КонецЦикла;	
	
КонецПроцедуры //Процедура УстановитьСнятьПометкаРебенокНаКлиенте(СтрокаДерева, Пометка)

// Устанавливаем либо снимаем пометки у всех родителей строки СтрокиДерева.
//
&НаКлиенте
Процедура УстановитьСнятьПометкаРодительНаКлиенте(СтрокаДерева, Пометка)
	
	//
	Родитель	= СтрокаДерева.ПолучитьРодителя();
	
	//
	Пока НЕ Родитель = Неопределено Цикл
		
		Отмеченные	= Новый Массив();
		
		//	(!) только для отмеченных родителей
		Если НЕ Родитель.Пометка Тогда
			Родитель	= Родитель.ПолучитьРодителя();
			Продолжить;
		КонецЕсли;
		
		//
		СтрокиДерева	= Родитель.ПолучитьЭлементы();
	
		//
		Для Каждого Строка Из СтрокиДерева Цикл
			Если Строка.Пометка = 1 Тогда
				Отмеченные.Добавить(Строка);	
			КонецЕсли;
		КонецЦикла;
		
		//	если нет отмеченных, тогда "стандартная" = 1
		Если НЕ Отмеченные.Количество() Тогда
			Родитель.Пометка	= 0;
		ИначеЕсли Отмеченные.Количество() = СтрокиДерева.Количество() Тогда
			Родитель.Пометка	= 1;
		ИначеЕсли НЕ Отмеченные.Количество() = СтрокиДерева.Количество() Тогда
			Родитель.Пометка	= 2;
		КонецЕсли;
		
		//
		Родитель		= Родитель.ПолучитьРодителя();
		
	КонецЦикла;
	
КонецПроцедуры //Процедура УстановитьСнятьПометкаРодительНаКлиенте(СтрокаДерева, Пометка)

//
//
&НаКлиенте
Процедура УстановитьСнятьПометкаКорневойЭлементНаКлиенте(СтрокиДерева, ЕстьОтмеченные = Ложь, ЕстьНеОтмеченные = Ложь)
	
	//
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		//
		Если СтрокаДерева.Пометка = 0 Тогда
			ЕстьНеОтмеченные	= Истина;
		Иначе
			ЕстьОтмеченные		= Истина;
		КонецЕсли;
		
		//
		Если ЕстьОтмеченные И ЕстьНеОтмеченные Тогда
			Прервать;
		КонецЕсли;

		//
		УстановитьСнятьПометкаКорневойЭлементНаКлиенте(СтрокаДерева.ПолучитьЭлементы(), ЕстьОтмеченные, ЕстьНеОтмеченные);
		
	КонецЦикла;
	
	//
	КорневыеСтрокиДерева	= ЭлементыДеревоЗначений.ПолучитьЭлементы();
	
	//
	Для Каждого СтрокаДерева Из КорневыеСтрокиДерева Цикл
		
		Если НЕ ЕстьОтмеченные И ЕстьНеОтмеченные Тогда
			СтрокаДерева.Пометка	= 0;
		ИначеЕсли ЕстьОтмеченные И НЕ ЕстьНеОтмеченные Тогда
			СтрокаДерева.Пометка	= 1;
		ИначеЕсли ЕстьОтмеченные И ЕстьНеОтмеченные Тогда
			СтрокаДерева.Пометка	= 2;
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры //Процедура УстановитьСнятьПометкаКорневойЭлементНаКлиенте(СтрокаДерева, ЕстьОтмеченные = Ложь, ЕстьНеОтмеченные = Ложь)


// Устанавливаем либо снимаем пометки у всех строк СтрокиДерева
// согласно переданного отбора.
&НаКлиенте
Процедура УстановитьСнятьПометкаОтборНаКлиенте(СтрокаДерева, Пометка, Отбор)
	
	Для Каждого ЭлСтроки Из СтрокаДерева Цикл
		
		Если НЕ Пометка Тогда
			ЭлСтроки.Пометка = Пометка;
		КонецЕсли;
		
		Если ТипЗнч(ЭлСтроки.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			
			Если Отбор.Количество() = 0 Тогда
				Если НЕ Пометка Тогда
					ПопадаетВОтбор = Пометка;	
				КонецЕсли;
			Иначе	
				ПопадаетВОтбор = ПроверитьУсловияОтбора(ЭлСтроки.Элемент, Отбор, ЭлСтроки.Шифр, ЭлСтроки.СтатусРедактирования);
			КонецЕсли;
			
			Если Пометка Тогда
				Если НЕ ЭлСтроки.Пометка Тогда
					ЭлСтроки.Пометка = ПопадаетВОтбор;	
				КонецЕсли;
			Иначе
				ЭлСтроки.Пометка = ПопадаетВОтбор;
			КонецЕсли;
			
			УстановитьСнятьПометкаРодительНаКлиенте(ЭлСтроки, Пометка);
			

		КонецЕсли;	
			
		УстановитьСнятьПометкаОтборНаКлиенте(ЭлСтроки.ПолучитьЭлементы(), Пометка, Отбор);

	КонецЦикла;
	
КонецПроцедуры //Процедура УстановитьСнятьПометкаОтборНаКлиенте(СтрокаДерева, Пометка, Отбор)	

// В случае, если отмечают привязанную позицию, либо позицию - владельца, отмечаем все связанные позиции, и владельца.
//
&НаКлиенте
Процедура УстановитьСнятьПометкаСвязанныеНаКлиенте(СтрокаДерева, Пометка)
	
	//	связанные - всегда размещены на том же уровне
	УровеньРазмещенияПривязанных	= СтрокаДерева.ПолучитьРодителя().ПолучитьЭлементы();
	
	//
	Если ЗначениеЗаполнено(СтрокаДерева.СвязаннаяВладелец) Тогда
		ЗначениеСравнения	= СтрокаДерева.СвязаннаяВладелец;
	Иначе
		ЗначениеСравнения	= СтрокаДерева.Элемент;
	КонецЕсли;
	
	//
	Для Каждого Строка Из УровеньРазмещенияПривязанных Цикл
		
		//
		Если НЕ Строка.Элемент = ЗначениеСравнения
			И НЕ Строка.СвязаннаяВладелец = ЗначениеСравнения Тогда
			Продолжить;
		КонецЕсли;
		
		//	если владелец связанной
		Если Строка.Связанная И НЕ ЗначениеЗаполнено(Строка.СвязаннаяВладелец) Тогда
			Строка.Пометка	= Пометка;
		КонецЕсли;
		
		//	если связанная
		Если Строка.Связанная И ЗначениеЗаполнено(Строка.СвязаннаяВладелец) Тогда
			Строка.Пометка	= Пометка;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //Процедура УстановитьСнятьПометкаСвязанныеНаКлиенте(СтрокаДерева, Пометка)	


&НаКлиенте
Процедура УстановитьСнятьПометкаТаблицаНаКлиенте(Таблица, ОтборСтрок = Неопределено, Пометка = Ложь)
	
	//
	Для Каждого Строка Из Таблица Цикл
		
		ВходитВОтбор	= Истина;
			
		//	Отбор строк.
		Если НЕ ОтборСтрок = Неопределено Тогда
			Для Каждого КлючИЗначение Из ОтборСтрок Цикл
				Если НЕ Строка[КлючИЗначение.Ключ] = КлючИЗначение.Значение Тогда
					ВходитВОтбор	= Ложь;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		//
		Строка.Пометка = Пометка И ВходитВОтбор;
		
	КонецЦикла;
	
КонецПроцедуры //Процедура УстановитьСнятьПометкаТаблицаНаКлиенте(Таблица, Пометка = Ложь)

#КонецОбласти //#Область УстановитьПометка

// вычисляем номер копии, и устанавливаем его в наименование
#Область СледующееНаименование

&НаСервереБезКонтекста
Функция СледующийИндексЗапросВыбратьНаСервереБезКонтекста(ЧастьСтрокиВключить, ЧастьСтрокиИсключить, Родитель, ЛокальнаяСмета, СсылкаНаОбъект)
	
	//
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		ТекстЗапроса	= ПолучитьТекстЗапросаСледующийИндексОбъектнаяСметаНаСервереБезКонтекста();	
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		ТекстЗапроса	= ПолучитьТекстЗапросаСледующийИндексЛокальнаяСметаНаСервереБезКонтекста();	
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
		ТекстЗапроса	= ПолучитьТекстЗапросаСледующийИндексРазделНаСервереБезКонтекста();	
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		ТекстЗапроса	= ПолучитьТекстЗапросаСледующийИндексПозицияНаСервереБезКонтекста();	
	КонецЕсли;
	
	//
	Запрос	= Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Родитель"			, Родитель);
	Запрос.УстановитьПараметр("ЧастьСтрокиВключить"	, ЧастьСтрокиВключить);
	Запрос.УстановитьПараметр("ЧастьСтрокиИсключить", ЧастьСтрокиИсключить); //	иначе, всегда будет попадать в выборку
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		Запрос.УстановитьПараметр("ЛокальнаяСмета"	, ЛокальнаяСмета);					   
	КонецЕсли;
	
	//
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции //Функция СледующийИндексЗапросВыбратьНаСервереБезКонтекста()

&НаСервереБезКонтекста
Функция СледующийИндексЗапросВыбратьПерваяКопияНаСервереБезКонтекста(ЧастьСтрокиВключить, Родитель, ЛокальнаяСмета, СсылкаНаОбъект)
	
	//
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		ТекстЗапроса	= ПолучитьТекстЗапросаСледующийИндексОбъектнаяСметаНаСервереБезКонтекста(Ложь);	
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		ТекстЗапроса	= ПолучитьТекстЗапросаСледующийИндексЛокальнаяСметаНаСервереБезКонтекста(Ложь);	
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
		ТекстЗапроса	= ПолучитьТекстЗапросаСледующийИндексРазделНаСервереБезКонтекста(Ложь);	
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		ТекстЗапроса	= ПолучитьТекстЗапросаСледующийИндексПозицияНаСервереБезКонтекста(Ложь);	
	КонецЕсли;
	
	//
	Запрос	= Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Родитель"			, Родитель);
	Запрос.УстановитьПараметр("ЧастьСтрокиВключить"	, ЧастьСтрокиВключить);
		
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		Запрос.УстановитьПараметр("ЛокальнаяСмета"	, ЛокальнаяСмета);					   
	КонецЕсли;
	
	//
	Возврат Запрос.Выполнить().Выбрать();
	
