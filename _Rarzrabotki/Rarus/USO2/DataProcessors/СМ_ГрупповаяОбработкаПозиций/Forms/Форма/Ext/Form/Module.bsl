//	ЛокальнаяСмета, ОбъектнаяСмета. Непосредственное изменение объема в выбранных документах.
//
&НаСервере
Процедура КомандаУстановитьОбъемСметаНаСервере(Объем)
	
	//
	ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	
	//
	Для Каждого Строка Из ОбрабатываемыеПозиции Цикл
		Если Объем < Строка.ОбъемВсего И Строка.СтатусРедактирования = 1 Тогда
			Продолжить;
		КонецЕсли;
		ОбъектПозиции = Строка["СсылкаНаОбъект"].ПолучитьОбъект();
		ОбъектПозиции.ОбъемРабот	= Объем;
		ОбъектПозиции.формулаОбъема	= "";
		
		// Судариков - расчет в базовых единицах
		ВводОбъемовВБазовыхЕдИзм = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета", "ВводОбъемовВБазовыхЕдИзм",Ложь);
		Если ВводОбъемовВБазовыхЕдИзм Тогда
			
			ОбъектПозиции.ОбъемРабот = СМ_СметаВызовСервера.ПересчитатьВбазовыхЕдиницахИзмерения(ОбъектПозиции, ОбъектПозиции.ОбъемРабот);
					
		КонецЕсли;
		
		ОбъектПозиции.Записать();

	КонецЦикла;
	
КонецПроцедуры //Процедура КомандаУстановитьОбъемСметаНаСервере(Объем)	

#КонецОбласти //#Область УстановитьОбъем/#Область РАСЦЕНКИ/#Область ВспомогательныеФункции/#Область КомандыФормы

#Область СохранитьВФрагменте

