&НаКлиенте
Процедура ОтобразитьТабличныеЧастиНаКлиенте()
	
	Если Параметры["АвтоматическиОбновлятьТабличнуюЧасть"] Тогда
	
		//	Добавить строки в отобранные "Ресурсы", "Поправки", "Начисления", "Индексы", "Свойства".
		ЗаполнитьТабличныеЧастиНаКлиенте();
		
	Иначе
		ОтобразитьИнформационноеСообщениеНаКлиенте(Истина);	
	КонецЕсли;
	
КонецПроцедуры //Процедура ОтобразитьТабличныеЧастиНаКлиенте()

&НаСервере
Процедура ЗаполнитьТаблицыЗначенийНаСервере()
	
	//	РЕСУРСЫ
	ЗаполнитьТаблицаЗначенийРесурсыНаСервере();
	
	//	ПОПРАВКИ
	ЗаполнитьТаблицаЗначенийПоправкиНаСервере();
	
	//	НАЧИСЛЕНИЯ
	ЗаполнитьТаблицаЗначенийНачисленияНаСервере();
	
	//	ИНДЕКСЫ
	ЗаполнитьТаблицаЗначенийИндексыНаСервере();
	
	//	СВОЙСТВА
	ЗаполнитьТаблицаЗначенийСвойстваНаСервере();
	
КонецПроцедуры //Процедура ЗаполнитьТаблицыЗначенийНаСервере()

//
//
&НаКлиенте
Процедура ЗаполнитьТабличныеЧастиНаКлиенте(ПараметрыКоманды = Неопределено)
	
	//
	ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	ОбрабатываемыеДокументы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("УчастиеПометка", Истина));
	
	//	РЕСУРСЫ
	Если НЕ ОбластьОбработки = "РАСЦЕНКИ"
		И Элементы.СтраницыТабличныеЧасти.ТекущаяСтраница = Элементы.СтраницаРесурсы Тогда
		ЗаполнитьТабличнаяЧастьРесурсыНаКлиенте(ОбрабатываемыеПозиции);
	КонецЕсли;
	
	//	ПОПРАВКИ	
	Если НЕ ОбластьОбработки = "РАСЦЕНКИ"
		И Элементы.СтраницыТабличныеЧасти.ТекущаяСтраница = Элементы.СтраницаПоправки Тогда
		ЗаполнитьТабличнаяЧастьПоправкиНаКлиенте(ОбрабатываемыеПозиции);
	КонецЕсли;
	
	//	НАЧИСЛЕНИЯ
	Если НЕ ОбластьОбработки = "РАСЦЕНКИ"
		И Элементы.СтраницыТабличныеЧасти.ТекущаяСтраница = Элементы.СтраницаНачисления Тогда
		ЗаполнитьТабличнаяЧастьНачисленияНаКлиенте(ОбрабатываемыеПозиции);
	КонецЕсли;
	
	//	ИНДЕКСЫ
	Если НЕ ОбластьОбработки = "РАСЦЕНКИ"
		И Элементы.СтраницыТабличныеЧасти.ТекущаяСтраница = Элементы.СтраницаИндексы Тогда
		ЗаполнитьТабличнаяЧастьИндексыНаКлиенте(ОбрабатываемыеПозиции);
	КонецЕсли;
	
	//	СВОЙСТВА
	Если НЕ ОбластьОбработки = "РАСЦЕНКИ"
		И Элементы.СтраницыТабличныеЧасти.ТекущаяСтраница = Элементы.СтраницаСвойства Тогда
		ЗаполнитьТабличнаяЧастьСвойстваНаКлиенте(ОбрабатываемыеДокументы);
	КонецЕсли;
	
КонецПроцедуры //Процедура ЗаполнитьТабличныеЧастиНаКлиенте(ПараметрыКоманды = Неопределено)	

&НаКлиенте
Процедура ЗаполнитьТабличнаяЧастьРесурсыНаКлиенте(ОбрабатываемыеПозиции = Неопределено)
	
	//
	Если ОбрабатываемыеПозиции = Неопределено Тогда
		ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"))));
	КонецЕсли;
	
	//	Очистить табличную часть.
	ТабличнаяЧастьРесурсы.Очистить();
	
	//	Заполнить табличную часть.	
	РесурсыЗаполнитьНаКлиенте(ОбрабатываемыеПозиции);
		
	//	Вывести/скрыть сообщение о пустой табличной части.
	РесурсыОтобразитьПустуюТаблицуНаКлиенте();	
	
	//	Сортировка ДанныеФормыКоллекция
	ТабличнаяЧастьРесурсы.Сортировать("Сортировка1 Убыв, КодРесурса Возр");	
	
КонецПроцедуры //Процедура ЗаполнитьТабличнаяЧастьРесурсыНаКлиенте(СписокПозиций = Неопределено)

&НаКлиенте
Процедура ЗаполнитьТабличнаяЧастьПоправкиНаКлиенте(ОбрабатываемыеПозиции = Неопределено)
	
	//
	Если ОбрабатываемыеПозиции = Неопределено Тогда
		ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"))));
	КонецЕсли;
	
	//	Очистить табличную часть.
	ТабличнаяЧастьПоправки.Очистить();
	
	//	Заполнить табличную часть.	
	ПоправкиЗаполнитьНаКлиенте(ОбрабатываемыеПозиции);
	
	//	Вывести/скрыть сообщение о пустой табличной части.
	ПоправкиОтобразитьПустуюТаблицуНаКлиенте();
		
	//	сортировка
	ТабличнаяЧастьПоправки.Сортировать("УсловияПрименения");	
	
	//	Запомнить текущие значения в табличной части, перед изменением.
	Для Каждого Строка Из ТабличнаяЧастьПоправки Цикл
		Строка.ПрименитьСтарая 		= Строка.Применить;
		Строка.ДобавПЗСтарая 		= Строка.ДобавПЗ;
		Строка.ДобавОЗСтарая 		= Строка.ДобавОЗ;
		Строка.ДобавЭМСтарая 		= Строка.ДобавЭМ;
		Строка.ДобавЗМСтарая 		= Строка.ДобавЗМ;
		Строка.ДобавСМСтарая 		= Строка.ДобавСМ;
		Строка.ДобавТРСтарая 		= Строка.ДобавТР;
		Строка.ДобавТМСтарая 		= Строка.ДобавТ;
//		Строка.ДобавТМСтарая 		= Строка.ДобавТМ;
		Строка.КоэффПЗСтарая 		= Строка.КоэффПЗ;
		Строка.КоэффОЗСтарая 		= Строка.КоэффОЗ;
		Строка.КоэффЭМСтарая 		= Строка.КоэффЭМ;
		Строка.КоэффЗМСтарая 		= Строка.КоэффЗМ;
		Строка.КоэффСМСтарая 		= Строка.КоэффСМ;
		Строка.КоэффТРСтарая 		= Строка.КоэффТР;
		Строка.КоэффТМСтарая 		= Строка.КоэффТМ;
		Строка.ВариантРасчетаСтарая	= Строка.ВариантРасчета;
	КонецЦикла;		
	
КонецПроцедуры //Процедура ЗаполнитьТабличнаяЧастьПоправкиНаКлиенте(СписокПозиций = Неопределено)

&НаКлиенте
Процедура ЗаполнитьТабличнаяЧастьНачисленияНаКлиенте(ОбрабатываемыеПозиции = Неопределено)
	
	//
	Если ОбрабатываемыеПозиции = Неопределено Тогда
		ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"))));
	КонецЕсли;
	
	//	Очистить табличную часть.
	ТабличнаяЧастьНачисления.Очистить();
	
	//	Заполнить табличную часть.	
	НачисленияЗаполнитьНаКлиенте(ОбрабатываемыеПозиции);
	
	//	Вывести/скрыть сообщение о пустой табличной части.
	НачисленияОтобразитьПустуюТаблицуНаКлиенте();
	
	//	Запомнить текущие значения в табличной части, перед изменением.
	Для Каждого Строка Из ТабличнаяЧастьНачисления Цикл
		Строка.ЗначениеСтарая	= Строка.Значение;
		Строка.ФормулаСтарая	= Строка.Формула;
	КонецЦикла;		
	
КонецПроцедуры //Процедура ЗаполнитьТабличнаяЧастьНачисленияНаКлиенте(СписокПозиций = Неопределено)

&НаКлиенте
Процедура ЗаполнитьТабличнаяЧастьИндексыНаКлиенте(ОбрабатываемыеПозиции = Неопределено)
	
	//
	Если ОбрабатываемыеПозиции = Неопределено Тогда
		ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"))));
	КонецЕсли;
	
	//	Очистить табличную часть.
