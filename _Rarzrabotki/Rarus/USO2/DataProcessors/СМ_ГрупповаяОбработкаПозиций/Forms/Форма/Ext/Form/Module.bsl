	               |					ТОГДА ЕСТЬNULL(СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимЭксплМашин, 0)
	               |				ИНАЧЕ ЕСТЬNULL(СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимЭксплМашин, 0)
	               |			КОНЕЦ
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПозицияЛокальнойСметы.НеПрименятьИндексы
	               |			ТОГДА ВТ_ПозицияЛокальнойСметы.ТекущаяЗарплатаМашинистов
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ВТ_ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	               |					ТОГДА ЕСТЬNULL(СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимЗарплМашин, 0)
	               |				ИНАЧЕ ЕСТЬNULL(СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимЗарплМашин, 0)
	               |			КОНЕЦ
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПозицияЛокальнойСметы.НеПрименятьИндексы
	               |			ТОГДА ВЫБОР
	               |					КОГДА ВТ_ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	               |						ТОГДА ЕСТЬNULL(СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимСтоимМатер, 0)
	               |					ИНАЧЕ ЕСТЬNULL(СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимСтоимМатер, 0)
	               |				КОНЕЦ
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ВТ_ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	               |					ТОГДА ЕСТЬNULL(СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ТекСтоимСтоимМатер, 0)
	               |				ИНАЧЕ ЕСТЬNULL(СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.СтоимСтоимМатер, 0)
	               |			КОНЕЦ
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	               |			ТОГДА ЕСТЬNULL(СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ЗатратыТрудаРабочих, 0)
	               |		ИНАЧЕ ЕСТЬNULL(СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.ЗатратыТрудаРабочих, 0)
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	               |			ТОГДА ЕСТЬNULL(СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.ЗатратыТрудаМашин, 0)
	               |		ИНАЧЕ ЕСТЬNULL(СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.ЗатратыТрудаМашин, 0)
	               |	КОНЕЦ,
	               |	ВТ_ПозицияЛокальнойСметы.ПрямЗатраты,
	               |	ВТ_ПозицияЛокальнойСметы.ОснЗарплата,
	               |	ВТ_ПозицияЛокальнойСметы.ЭксплМашин,
	               |	ВТ_ПозицияЛокальнойСметы.ЗарплМашинистов,
	               |	ВТ_ПозицияЛокальнойСметы.СтоимМатериалов,
	               |	ВТ_ПозицияЛокальнойСметы.ЗатратыТрудаРабочих,
	               |	ВТ_ПозицияЛокальнойСметы.ЗатратыТрудаМашинистов,
	               |	ВТ_ПозицияЛокальнойСметы.ОтмеченаВДереве,
	               |	ВТ_ПозицияЛокальнойСметы.Доступность,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПозицияЛокальнойСметыТабличныеЧастиКоличество.РесурсыКоличество > 0
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ВТ_ПозицияЛокальнойСметы.Определитель.ВидРасценки = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыРасценки.Материал)
	               |				ИЛИ ВТ_ПозицияЛокальнойСметы.Определитель.ВидРасценки = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыРасценки.Оборудование)
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПозицияЛокальнойСметыТабличныеЧастиКоличество.ПоправкиКоличество > 0
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПозицияЛокальнойСметыТабличныеЧастиКоличество.НачисленияКоличество > 0
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПозицияЛокальнойСметыТабличныеЧастиКоличество.ИндексыКоличество > 0
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПозицияЛокальнойСметыСвязанныеПозицииКоличество.Количество > 0
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ВТ_ПозицияЛокальнойСметы.ИДПозицииВладельца = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	               |					ТОГДА ЛОЖЬ
	               |				ИНАЧЕ ИСТИНА
	               |			КОНЕЦ
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПозицияЛокальнойСметыСвязанныеПозицииКоличество.Количество > 0
	               |			ТОГДА NULL
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ВТ_ПозицияЛокальнойСметы.ИДПозицииВладельца = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка)
	               |					ТОГДА NULL
	               |				ИНАЧЕ ВЫБОР
	               |						КОГДА ВТ_ПозицияЛокальнойСметыСвязанныеПозицииСсылкаПоследней.Владелец ЕСТЬ NULL 
	               |							ТОГДА 0
	               |						ИНАЧЕ 1
	               |					КОНЕЦ
	               |			КОНЕЦ
	               |	КОНЕЦ,
	               |	ВТ_ПозицияЛокальнойСметы.ИДПозицииВладельца,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПозицияЛокальнойСметы.ОбъемВсего = 0
	               |			ТОГДА 0
	               |		КОГДА ВТ_ПозицияЛокальнойСметы.ОбъемВсего < ВТ_ПозицияЛокальнойСметы.ОбъемРабот
	               |			ТОГДА ВЫБОР
	               |					КОГДА &РазрешитьРедактирование
	               |						ТОГДА 1
	               |					ИНАЧЕ 2
	               |				КОНЕЦ
	               |		КОГДА ВТ_ПозицияЛокальнойСметы.ОбъемВсего >= ВТ_ПозицияЛокальнойСметы.ОбъемРабот
	               |			ТОГДА 2
	               |		ИНАЧЕ 0
	               |	КОНЕЦ,
	               |	ВТ_ПозицияЛокальнойСметы.ОбъемВсего
	               |ИЗ
	               |	ВТ_ПозицияЛокальнойСметы КАК ВТ_ПозицияЛокальнойСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета КАК СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета
	               |		ПО ВТ_ПозицияЛокальнойСметы.Ссылка = СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Позиция
	               |			И ВТ_ПозицияЛокальнойСметы.ИДСметы = СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Смета
	               |			И ВТ_ПозицияЛокальнойСметы.ИДРодителя = СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета.Раздел
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП КАК СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП
	               |		ПО ВТ_ПозицияЛокальнойСметы.Ссылка = СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Позиция
	               |			И ВТ_ПозицияЛокальнойСметы.ИДСметы = СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Смета
	               |			И ВТ_ПозицияЛокальнойСметы.ИДРодителя = СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП.Раздел
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПозицияЛокальнойСметыТабличныеЧастиКоличество КАК ВТ_ПозицияЛокальнойСметыТабличныеЧастиКоличество
	               |		ПО ВТ_ПозицияЛокальнойСметы.Ссылка = ВТ_ПозицияЛокальнойСметыТабличныеЧастиКоличество.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПозицияЛокальнойСметыСвязанныеПозицииКоличество КАК ВТ_ПозицияЛокальнойСметыСвязанныеПозицииКоличество
	               |		ПО ВТ_ПозицияЛокальнойСметы.Ссылка = ВТ_ПозицияЛокальнойСметыСвязанныеПозицииКоличество.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПозицияЛокальнойСметыСвязанныеПозицииСсылкаПоследней КАК ВТ_ПозицияЛокальнойСметыСвязанныеПозицииСсылкаПоследней
	               |		ПО ВТ_ПозицияЛокальнойСметы.Ссылка = ВТ_ПозицияЛокальнойСметыСвязанныеПозицииСсылкаПоследней.Ссылка
	               |			И ВТ_ПозицияЛокальнойСметы.ИДПозицииВладельца = ВТ_ПозицияЛокальнойСметыСвязанныеПозицииСсылкаПоследней.Владелец
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерВДереве,
	               |	НомерПорядковый";
		
	Возврат ТекстЗапроса;

КонецФункции

