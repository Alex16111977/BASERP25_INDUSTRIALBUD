// Сохранение группы расценок, как фрагмент в справочнике Фрагменты.
&НаСервере
Функция КомандаСохранитьВФрагментеНаСервере(ГруппаФрагментов, ПараметрыОповещения)
	
	ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	
	СправочникОбъект				= Справочники.СМ_Фрагменты.СоздатьЭлемент();
	СправочникОбъект.Родитель		= ГруппаФрагментов;
	СправочникОбъект.Наименование	= ПараметрыОповещения.Фрагмент; 
	
	НачатьТранзакцию();
	
	//
	Для Каждого Строка Из ОбрабатываемыеПозиции Цикл
		
		СтрокаРасценкиФрагмента = СправочникОбъект.РасценкиФрагмента.Добавить();
		СтрокаРасценкиФрагмента.ШифрРасценки			= Строка["СсылкаНаОбъект"].ШифрРасценки;
		СтрокаРасценкиФрагмента.НаименованиеРасценки	= Строка["СсылкаНаОбъект"].Наименование;
		СтрокаРасценкиФрагмента.ТипНормативныхСборников	= Строка["СсылкаНаОбъект"].ТипНормативныхСборников;
		СтрокаРасценкиФрагмента.ЕдиницаИзмерения		= Строка["СсылкаНаОбъект"].ЕдиницаИзмерения;		
		СтрокаРасценкиФрагмента.Измеритель				= Строка["СсылкаНаОбъект"].Измеритель;	
		СтрокаРасценкиФрагмента.Определитель			= Строка["СсылкаНаОбъект"].Определитель;	
		СтрокаРасценкиФрагмента.ФормулаОбъема			= ?(Строка["СсылкаНаОбъект"].ФормулаОбъема = "", СокрЛП(Строка(Строка["СсылкаНаОбъект"].ОбъемРабот)), Строка["СсылкаНаОбъект"].ФормулаОбъема);		
		СтрокаРасценкиФрагмента.Привязка				= ?(Строка["СсылкаНаОбъект"].ИДПозицииВладельца.Пустая(), Ложь, Истина);

	КонецЦикла;	
	
	Попытка
		СправочникОбъект.Записать();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не удалось сохранить расценки в справочнике Фрагменты'"));
		Возврат Ложь;
	КонецПопытки;
	
	ЗафиксироватьТранзакцию();
	
	//
	Возврат Истина;

КонецФункции //Функция КомандаСохранитьВФрагментеНаСервере()

