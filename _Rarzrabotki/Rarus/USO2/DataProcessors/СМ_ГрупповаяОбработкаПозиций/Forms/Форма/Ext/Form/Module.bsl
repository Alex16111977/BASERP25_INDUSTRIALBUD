	ГруппируемыеКолонки.Добавить("ЦенаТекущаяЗМ");
		
	//	Суммируемые колонки.
	СуммируемыеКолонки	= Новый Структура;
	СуммируемыеКолонки.Вставить("Количество"			, Новый Структура("Функция, ЗначениеНеравенства", "СУММА", "разн. знч."));
