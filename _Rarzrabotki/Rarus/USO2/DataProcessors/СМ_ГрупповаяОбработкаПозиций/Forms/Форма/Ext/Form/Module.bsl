&НаКлиенте
Процедура РАСЦЕНКИ_ОС_Перенести(Команда, ВыполнитьКоманду = Ложь)
	
	// Устанавливаем и проверяем возможность установки, "действие" - реквизит на форме
	Если НЕ ВыполнитьКоманду Тогда
		ДоступнаСменаКомандыВопросНаКлиенте(Команда);
		Возврат;
	КонецЕсли;
	
	// Проверка
	Если НЕ СМ_ДоступнаОбработкаОбъектнаяСметаНаКлиенте(Команда) тогда
		Возврат;
	КонецЕсли;
	
	// Переменные процедуры
	ОписаниеОповещения	= Новый ОписаниеОповещения("КомандаРасценкиПеренестиОповещениеНаКлиенте", ЭтаФорма, Новый Структура("ТекущаяСмета, КомандаИмя", Документ, Команда.Имя));
	
	//
	СписокИсключений		= Новый СписокЗначений;
	ОбрабатываемыеДокументы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("УчастиеПометка", Истина));
	Для Каждого Строка Из ОбрабатываемыеДокументы Цикл
		СписокИсключений.Добавить(Строка["СсылкаНаОбъект"]);	
	КонецЦикла;
	
	//
	ПараметрыКоманды	= Новый Структура("ВключатьСС, ВключатьОС, ВключатьЛС, ВключатьРазделы, АктивныйЭлемент, БезАктов, ОтборСтройка");
	ПараметрыКоманды.Вставить("ВключатьСС"		, ПолучитьВключатьСС());
	ПараметрыКоманды.Вставить("ВключатьОС"		, ПолучитьВключатьОС());
	ПараметрыКоманды.Вставить("ВключатьЛС"		, ПолучитьВключатьЛС());
	ПараметрыКоманды.Вставить("ВключатьРазделы"	, ПолучитьВключатьРазделы());
	ПараметрыКоманды.Вставить("БезАктов"		, Истина);
	ПараметрыКоманды.Вставить("ОтборСтройка"	, Истина);
	ПараметрыКоманды.Вставить("СписокИсключений", СписокИсключений);
		
	//	открыть форму для выбора
	ОткрытьФорму(	"Обработка.СМ_ДеревоСметПростое.Форма",
					ПараметрыКоманды,
					ЭтаФорма,
					,
					,
					,
					ОписаниеОповещения,
					РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры //Процедура РАСЦЕНКИ_ОС_Перенести(Команда)

