	Элементы.тзНачисленияЗначение.ТолькоПросмотр 	= НЕ ПараметрыКоманды["Операция"]["Редактировать"];
	Элементы.тзНачисленияФормула.ТолькоПросмотр 	= НЕ ПараметрыКоманды["Операция"]["Редактировать"];

