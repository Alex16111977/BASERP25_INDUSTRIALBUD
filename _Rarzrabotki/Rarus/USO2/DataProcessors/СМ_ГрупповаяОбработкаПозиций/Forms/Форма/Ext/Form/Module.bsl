//	АктВыполненныхРабот. Непосредственное изменение объема в выбранных документах.
//
&НаСервере
Функция КомандаУстановитьОбъемАктВыполненныхРаботНаСервере(Ссылка, Объем)
	
	//
	ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	ФактОбъем				= Объем;
	ДокументОбъект			= Ссылка.ПолучитьОбъект();
	
	Для Каждого Строка Из ОбрабатываемыеПозиции Цикл
		Если Строка.СтатусРедактирования = 1 Тогда
			Продолжить;
		КонецЕсли;

		ФактОбъем = СМ_СметаВызовСервера.ИзменитьФактОбъемПозицииАкта(ДокументОбъект, Строка.СсылкаНаОбъект, ФактОбъем);
	КонецЦикла;
	
	ДокументОбъект.Записать();
	
	Возврат Истина;
	
КонецФункции //Функция КомандаУстановитьОбъемАктВыполненныхРаботНаСервере(Ссылка, Объем)

