Процедура КомандаРесурсыЗаменитьПлюсМинусВводЗначенияОповещениеНаКлиенте(ПараметрыЗамены, ПараметрыОповещения) Экспорт
	
	//
	Если Не ЗначениеЗаполнено(ПараметрыЗамены) Тогда
		Возврат;
	КонецЕсли;
	
	//
	ОбрабатываемаяЛокальнаяСмета	= ПолучитьОбрабатываемуюЛокальнуюСметуНаКлиенте();
	ПараметрыРасчета				= СМ_ПолучитьПараметрыРасчетаНаКлиенте(ОбрабатываемаяЛокальнаяСмета);
	
	//
	Если КомандаРесурсыЗаменитьПлюсМинусНаСервере(ОбъединитьПараметрыНаКлиенте(ПараметрыЗамены, ПараметрыОповещения), ПараметрыРасчета) Тогда
		
		//	Заполнить дерево значений.
		ДеревоЗначенийОбновитьНаКлиенте(Новый Структура("Документ", Документ));
		
		//	Добавить строки в отобранные "Ресурсы", "Поправки", "Начисления", "Индексы", "Свойства".
		ЗаполнитьТабличныеЧастиНаКлиенте();
		
		//	Сообщить пользователю.
		СообщитьПользователюУспешноеВыполнениеКомандыНаСервере(ПараметрыОповещения.КомандаИмя);
		
	КонецЕсли;	
	
КонецПроцедуры //Процедура КомандаРесурсыЗаменитьПлюсМинусВводЗначенияОповещениеНаКлиенте(Результат, ПараметрыОповещения) Экспорт

//	Выполнение необходимых действий, выбранной команды.
//
&НаСервере
Функция КомандаРесурсыЗаменитьНаСервере(ПараметрыЗамены)
	
	//
	тзОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	ОбрабатываемыеПозиции	= тзОбрабатываемыеПозиции.ВыгрузитьКолонку("СсылкаНаОбъект");
	
	//
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		
		// 1. Замена ресурса в табличной части ресурсов акта
		СМ_СметаВызовСервера.ЗаменитьРесурсВТЧРесурсыАкта(Документ, ПараметрыЗамены, ОбрабатываемыеПозиции); 
		
	Иначе
		
		// 1. Замена ресурса в табличной части ресурсов документов позиций
		СМ_СметаВызовСервера.ЗаменитьРесурсВТЧРесурсыСметы(ПараметрыЗамены,, ОбрабатываемыеПозиции); 
		
		// 2. Пересчитываем
		ДокументПерерасчетНаСервере(Документ);
	
	КонецЕсли;
	
	//
	Возврат Истина;
	
КонецФункции //Функция КомандаРесурсыЗаменитьНаСервере(ПараметрыДополнительные)

&НаСервере
Функция КомандаРесурсыЗаменитьАктВыполненныхРаботНаСервере(Результат)
	
	ОтборПозиций	= Новый Массив();
	
	// 1. Замена ресурса в табличной части ресурсов акта
	СМ_СметаВызовСервера.ЗаменитьРесурсВТЧРесурсыАкта(Документ, Результат, ОтборПозиций); 
	
	//
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция КомандаРесурсыЗаменитьПлюсМинусНаСервере(ПараметрыЗамены, ПараметрыРасчета)
	
	НачатьТранзакцию();
	
	//
	тзОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	Позиции					= тзОбрабатываемыеПозиции.ВыгрузитьКолонку("СсылкаНаОбъект");
	ОтборПоПозициямСЗ		= Новый СписокЗначений();
	ОтборПоПозициямСЗ.ЗагрузитьЗначения(Позиции);
	
	// Не учтенные - не меняем.
	ТаблицаРесурсовПозиций = СМ_СметаВызовСервера.ПолучитьСписокВсехРесурсовПозиций(ОтборПоПозициямСЗ, ПараметрыЗамены.ЗаменяемыйРесурс, Истина); 
	СписокРесурсов 	= Новый СписокЗначений();
	СписокРесурсов.ЗагрузитьЗначения(ТаблицаРесурсовПозиций.ВыгрузитьКолонку("Ресурс"));
	
	//
	Для Каждого Строка Из ТаблицаРесурсовПозиций Цикл
		
		Если НЕ ТипЗнч(Строка.Позиция) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			Продолжить;
		КонецЕсли;
		//
		//Предупреждение = НСтр("ru='Разные единицы измерения ресурсов, проверьте объем в позиции-ресурсе замены'");
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Предупреждение);
		
		ПозицияОбъект = Строка.Позиция.ПолучитьОбъект();
		
		//	Старый ресурс вставляется за расценку со знаком Минус.
		ПараметрыПоиска	= РесурсыЗаменитьПлюсМинусПолучитьПараметрыПоискаНаСервере(Строка, ПозицияОбъект, ПараметрыЗамены);
		СМ_СметаВызовСервера.СоздатьПозициюНеучтенныйРесурс(ПозицияОбъект, ПараметрыПоиска, ПараметрыРасчета);
		
		//	Новый ресурс. Норма расхода = Норма расхода заменяемого ресурса * КоэффициентКНорме.
		//	Временно от этого отказываемся.
		ПараметрыПоиска	= РесурсыЗаменитьПлюсМинусЗаменяемыйРесурсПолучитьПараметрыПоискаНаСервере(Строка, ПозицияОбъект, ПараметрыЗамены);
		СМ_СметаВызовСервера.СоздатьПозициюНеучтенныйРесурс(ПозицияОбъект, ПараметрыПоиска, ПараметрыРасчета);
		
	КонецЦикла;
	 
	//	Перерасчет документов.
	ДокументПерерасчетНаСервере(Документ);
	
	ЗафиксироватьТранзакцию();
	
	Возврат Истина;

КонецФункции


// Процедура продолжает обработку выбранного значения замены. 
//
// Параметры:
//     КодВозврата			- код возврата диалога.
//     ПараметрыОповещения	- набор необходимых параметров.
//
&НаКлиенте
Процедура КомандаРесурсыЗаменитьПродолжитьОповещениеНаКлиенте(КодВозврата, ПараметрыОповещения) Экспорт
	
	Если КодВозврата = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
	
	//	ресурс - в данном случае, нормативный сборник
	СМ_СметаВызовСервера.ЗаполнитьДанныеРесурса(ПараметрыОповещения.Ресурс, ПараметрыОповещения);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("КомандаРесурсыЗаменитьВводЗначенияОповещениеНаКлиенте", ЭтотОбъект, ПараметрыОповещения);
	
	ОткрытьФорму(	"ОбщаяФорма.СМ_ВводРасходаРесурса",
					ПараметрыОповещения,
					,
					,
					,
					,
					ОписаниеОповещения,
					РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры //Процедура КомандаРесурсыЗаменитьПродолжитьОповещениеНаКлиенте(КодВозврата, ПараметрыОповещения) Экспорт


#Область ВспомогательныеФункции

//	ПАРАМЕТРЫ

&НаКлиенте
Функция РесурсыЗаменитьПолучитьПараметрыВводаРасходаНаКлиенте(Элемент, ПараметрыОповещения)
	
	//
	Структура				= Новый Структура();
	Цены					= Новый Структура("БазиснаяЦена, БазиснаяЗарплатаМашинистов, ТекущаяЦена, ТекущаяЗарплатаМашинистов", 0, 0, 0, 0);
	ДополнительныеПараметры = РесурсыЗаменитьПолучитьПараметрыДополнительныеНаКлиенте(ПараметрыОповещения);
	БезЦены					= Ложь;
	
	Если ПараметрыОповещения.МестоЗамены = "НС" Тогда
		БезЦены = Истина;
		// Перейти ~БезЦены;	
	КонецЕсли;
	
	Если НЕ БезЦены Тогда
	
		// Получить цены
		Если НЕ СметнаяКомпонента = Неопределено И ДополнительныеПараметры.АвтоЗагрузкаЦен И
			ЗначениеЗаполнено(ДополнительныеПараметры.ФайлТекущихЦен) Тогда
			// Проверка подтягивания цен из ВБ.
			СМ_СметаКлиент.ПолучитьЦеныНовогоРесурса(	Элемент,
														ДополнительныеПараметры.Район,
														ДополнительныеПараметры.ИмяФайлаСборникаТекущихЦен,
														ДополнительныеПараметры.КодРегиональнойБазы,
														Цены);
		Иначе
			//
			СМ_СметаВызовСервера.ПолучитьЦеныНовогоРесурса(	Элемент,
															ДополнительныеПараметры.Район,
															ДополнительныеПараметры.РегиональнаяБаза,
															ДополнительныеПараметры.ДатаТекущихЦен,
															Цены,
															ДополнительныеПараметры.ВыбиратьТекущиеЦены);
		КонецЕсли;
														
	КонецЕсли;

	// ~БезЦены:
	
	Структура.Вставить("ЗаменяемыйРесурс"	, ПараметрыОповещения.ЗаменяемыйРесурс);
	Структура.Вставить("Ресурс"				, Элемент);
	Структура.Вставить("БазисЦена"			, Цены.БазиснаяЦена);
	Структура.Вставить("БазисЗарплМаш"		, Цены.БазиснаяЗарплатаМашинистов);
	Структура.Вставить("ТекЦена"			, Цены.ТекущаяЦена);
	Структура.Вставить("ТекЗарплМаш"		, Цены.ТекущаяЗарплатаМашинистов);
	Структура.Вставить("РасходПоНорме"		, ПараметрыОповещения.РасходПоНорме);
	Структура.Вставить("РасходПоФакту"		, ПараметрыОповещения.РасходПоФакту);
	
	//	
	Возврат Структура;
		
КонецФункции //Функция РесурсыЗаменитьПолучитьПараметрыВводаРасходаНаКлиенте(Элемент, ПараметрыОповещения)

&НаКлиенте
Функция РесурсыЗаменитьПолучитьПараметрыОповещенияНаКлиенте(Команда, ОбрабатываемыеРесурсы, ОбрабатываемаяЛокальнаяСмета, МестоЗамены = "", ЗаменаПлюсМинусВБ = Ложь)
	
	//
	Структура = Новый Структура();
	
	//
	Если ОбрабатываемыеРесурсы.Количество() Тогда
		
		Структура.Вставить("КомандаИмя"			, Команда.Имя);
		Структура.Вставить("Документ"			, ОбрабатываемаяЛокальнаяСмета);
		Структура.Вставить("ЗаменяемыйРесурс"	, ОбрабатываемыеРесурсы[0].Ресурс);
		Структура.Вставить("РасходПоНорме"		, ОбрабатываемыеРесурсы[0].РасходПоНорме);
		Структура.Вставить("РасходПоФакту"		, ОбрабатываемыеРесурсы[0].РасходПоФакту);
		Структура.Вставить("РасходПоНормеСтарый", ОбрабатываемыеРесурсы[0].РасходПоНорме);
		Структура.Вставить("ЗаменаПлюсМинусВБ"	, ЗаменаПлюсМинусВБ);
		Структура.Вставить("ТолькоНорма"		, Истина);
	    Структура.Вставить("МестоЗамены"		, МестоЗамены);
		
		//
		Возврат Структура;
		
	Иначе
		Возврат Структура;
	КонецЕсли;
	
КонецФункции //Функция РесурсыЗаменитьПолучитьПараметрыОповещенияНаКлиенте(Команда, ОбрабатываемыеРесурсы, МестоЗамены = "")

&НаКлиенте
Функция РесурсыЗаменитьПолучитьПараметрыДополнительныеНаКлиенте(ПараметрыОповещения)
	
	//
	Структура						= Новый Структура("АвтоЗагрузкаЦен, Район, ДатаТекущихЦен, ФайлТекущихЦен, КодРегионаФайлаТекущихЦен");
	ОбрабатываемаяЛокальнаяСмета	= ЛокальнаяСметаНаСервере(Документ);
	ПараметрыРасчета				= СМ_ПолучитьПараметрыРасчетаНаКлиенте(ОбрабатываемаяЛокальнаяСмета);
	
	// получим цены
	ВыбиратьТекущиеЦены = 	НЕ ЗначениеЗаполнено(ПараметрыРасчета.ФайлСборникаТекущихЦен)
							И НЕ ПараметрыРасчета.РегионДляВыбораЦен.Пустая()
							И ПараметрыРасчета.АвтозагрузкаЦен;	
							
	//
	Структура.Вставить("АвтоЗагрузкаЦен"			, ПараметрыРасчета.АвтозагрузкаЦен);
	Структура.Вставить("Район"						, ПараметрыРасчета.Район);
	Структура.Вставить("ДатаТекущихЦен"				, ПараметрыРасчета.ДатаТекущихЦен);
	Структура.Вставить("ФайлТекущихЦен"				, ПараметрыРасчета.ФайлСборникаТекущихЦен);
	Структура.Вставить("КодРегионаФайлаТекущихЦен"	, ПараметрыРасчета.КодРегионаФайлаТекущихЦен);
	Структура.Вставить("РегиональнаяБаза"			, ПараметрыРасчета.РегионДляВыбораЦен);
	Структура.Вставить("КодРегиональнойБазы"		, ПараметрыРасчета.КодРегионаФайлаТекущихЦен);
	Структура.Вставить("ИмяФайлаСборникаТекущихЦен"	, ПараметрыРасчета.ФайлСборникаТекущихЦен);
	Структура.Вставить("ВыбиратьТекущиеЦены"		, ВыбиратьТекущиеЦены);
	
	//
	Возврат Структура;
	
КонецФункции //Функция РесурсыЗаменитьПолучитьПараметрыДополнительныеНаКлиенте(ПараметрыОповещения)

&НаКлиенте
Функция РесурсыЗаменитьПолучитьПараметрыПоискаНаКлиенте(ОбрабатываемыеРесурсы, ОбрабатываемаяЛокальнаяСмета)
	
	//
	Структура = Новый Структура("РегиональнаяБаза, Район, ДатаТекущихЦен, ТекРесурс");
	
	//	либо одна строка, либо нет выделенных
	Если ОбрабатываемыеРесурсы.Количество() Тогда
		
		//
		ПараметрыРасчета	= СМ_ПолучитьПараметрыРасчетаНаКлиенте(ОбрабатываемаяЛокальнаяСмета);
		
		//	
		Структура.Вставить("РегиональнаяБаза"	, ПараметрыРасчета.РегионДляВыбораЦен);
		Структура.Вставить("Район"				, ПараметрыРасчета.Район);
		Структура.Вставить("ДатаТекущихЦен"		, ПараметрыРасчета.ДатаТекущихЦен);
		Структура.Вставить("ТекРесурс"			, ОбрабатываемыеРесурсы[0].Ресурс);
		
		//
		Возврат Структура;
	
	Иначе
		Возврат Структура;	
	КонецЕсли;
		
КонецФункции //Функция РесурсыЗаменитьПолучитьПараметрыПоискаНаКлиенте(ОбрабатываемыеРесурсы, ОбрабатываемаяЛокальнаяСмета)

&НаСервере
Функция РесурсыЗаменитьПлюсМинусПолучитьПараметрыПоискаНаСервере(Строка, ПозицияОбъект, ПараметрыЗамены)
	
	Структура = Новый Структура;
	
	НормаРасхода	= СтрЗаменить(Строка.НормаРасхода,",",".");
	
	Структура.Вставить("Ресурс"						, ПараметрыЗамены.ЗаменяемыйРесурс);
	Структура.Вставить("РегиональнаяБаза"			, ПозицияОбъект.РегиональнаяБаза);
	Структура.Вставить("Район");
	Структура.Вставить("ДатаТекущихЦен");
	Структура.Вставить("ЗагружатьТекущиеЦены");
	Структура.Вставить("ФайлСборникаТекущихЦен");
	Структура.Вставить("КодРегионаФайлаТекущихЦен");
	Структура.Вставить("НеИндексировать"			, Истина);
	Структура.Вставить("БазиснаяЦена"				, Строка.Базиснаяцена);
	Структура.Вставить("ТекущаяЦена"				, Строка.ТекущаяЦена);
	Структура.Вставить("БазиснаяЗарплМаш"			, Строка.БазиснаяЗарплатаМашинистов);
	Структура.Вставить("ТекущаяЗарплМаш"			, Строка.ТекущаяЗарплатаМашинистов);
	Структура.Вставить("Код"						, Строка.СметныйКодРесурса);
	Структура.Вставить("ВидРесурса"					, Строка.ВидРесурса);
	Структура.Вставить("ТипМатериала"				, Строка.ТипМатериала);
	Структура.Вставить("ЕдИзм"						, Строка.Ресурс.ЕдиницаИзмерения);
	Структура.Вставить("Норма"						, -1 * НормаРасхода);
	Структура.Вставить("Раздел"						, ПозицияОбъект.ИДРодителя); 
	Структура.Вставить("Владелец"					, ПозицияОбъект);
	
	//
	Возврат Структура;
	
КонецФункции

&НаСервере
Функция РесурсыЗаменитьПлюсМинусЗаменяемыйРесурсПолучитьПараметрыПоискаНаСервере(Строка, ПозицияОбъект, ПараметрыЗамены)
	
	Структура = Новый Структура;
	
	// Коэффициент к расходу ресурса.
	// Определение коэффициента к норме расхода, исходя из заданного пользователем.
	Если ПараметрыЗамены.ЗаменаПлюсМинусВБ Тогда
		// Определение коэффициента к норме расхода, исходя только из соответствия. 
		// Единиц измерения, т к норму расхода при выборе из ВБ задать нельзя. 
		Если НЕ ПараметрыЗамены.ЗаменяемыйРесурс.ЕдиницаИзмерения = ПараметрыЗамены.Ресурс.ЕдиницаИзмерения Тогда
			КоэффициентКНорме = ОпределитьКоэффициентКНорме(ПараметрыЗамены.ЗаменяемыйРесурс.ЕдиницаИзмерения, ПараметрыЗамены.Ресурс.ЕдиницаИзмерения);	
		КонецЕсли;	
	Иначе
		Если НЕ ПараметрыЗамены.РасходПоНормеСтарый = 0 Тогда
			КоэффициентКНорме = ПараметрыЗамены.РасходПоНорме/ПараметрыЗамены.РасходПоНормеСтарый;
		Иначе
			КоэффициентКНорме = 1;
		КонецЕсли;
	КонецЕсли;	
	
	Структура.Вставить("Ресурс"						, ПараметрыЗамены.Ресурс);
	Структура.Вставить("РегиональнаяБаза"			, ПозицияОбъект.РегиональнаяБаза);
	Структура.Вставить("Район");
	Структура.Вставить("ДатаТекущихЦен");
	Структура.Вставить("ЗагружатьТекущиеЦены");
	Структура.Вставить("ФайлСборникаТекущихЦен");
	Структура.Вставить("КодРегионаФайлаТекущихЦен");
	Структура.Вставить("НеИндексировать"			, Истина);
	Структура.Вставить("БазиснаяЦена"				, ПараметрыЗамены.БазисЦена);
	Структура.Вставить("ТекущаяЦена"				, ПараметрыЗамены.ТекЦена);
	Структура.Вставить("БазиснаяЗарплМаш"			, ПараметрыЗамены.БазисЗарплМаш);
	Структура.Вставить("ТекущаяЗарплМаш"			, ПараметрыЗамены.ТекЗарплМаш);
	Структура.Вставить("Код"						, ПараметрыЗамены.Ресурс.Код);
	Структура.Вставить("ВидРесурса"					, ПараметрыЗамены.Ресурс.ВидРесурса);
	Структура.Вставить("ЕдИзм"						, ПараметрыЗамены.Ресурс.ЕдиницаИзмерения);
	Структура.Вставить("Норма"						, Строка.НормаРасхода * КоэффициентКНорме);
	Структура.Вставить("Раздел"						, ПозицияОбъект.ИДРодителя); 
	Структура.Вставить("Владелец"					, ПозицияОбъект);
		
	//
	Возврат Структура;
	
КонецФункции


&НаСервере
Функция ЛокальнаяСметаНаСервере(ВыбранноеЗначение)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		Возврат ВыбранноеЗначение.ЛокальнаяСмета;
	Иначе
		Возврат ПолучитьОбрабатываемуюЛокальнуюСметуНаСервере();
	КонецЕсли;
		
КонецФункции

//

&НаКлиенте
Функция ПолучитьТекущуюКомандуНаКлиенте()
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		Возврат Новый Структура("Имя", "РЕСУРСЫ_ОС_0_3_ЗаменитьПлюсМинусИзВБ");
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		Возврат Новый Структура("Имя", "РЕСУРСЫ_ЛС_0_3_ЗаменитьПлюсМинусИзВБ");
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции


&НаКлиенте
Функция ПолучитьОбрабатываемыеРесурсыНаКлиенте()
	
	//
	Массив	= Новый Массив();
	
	//
	Для Каждого Идентификатор Из Элементы.тзРесурсы.ВыделенныеСтроки Цикл
